1
00:00:14,680 --> 00:00:15,720
.(تاشا)

2
00:00:16,850 --> 00:00:18,100
ما الَّذي تفعلينه؟

3
00:00:18,180 --> 00:00:20,350
.ماذا؟ أنا أنظِّف

4
00:00:20,520 --> 00:00:24,140
ألست مسؤولة عن تنظيف حجرة النَّوم الرَّئيسة اليوم؟

5
00:00:33,530 --> 00:00:36,110
.سيستقطع هذا من راتبك

6
00:00:37,120 --> 00:00:39,740
.سأُنذر السَّيِّدة (ويك) بهذا الأمر

7
00:00:41,870 --> 00:00:46,080
.(إيما)، أرجو أن تتولِّي أمر حجرة النَّوم الرَّئيسة نيابة عن (تاشا)

8
00:00:47,830 --> 00:00:49,040
.سمعًا

9
00:00:56,890 --> 00:00:57,800
!(إيما)

10
00:00:57,890 --> 00:01:02,470
.كان ينبغي أن تنظِّفي حجرة النَّوم الرَّئيسة إبَّان تناول السَّيِّد والسَّيِّدة للإفطار

11
00:01:02,560 --> 00:01:04,060
.أنا آسفة

12
00:01:05,730 --> 00:01:09,860
.لا أكترث إن كنت قد لفتتِ نظر سيِّدتي، فلا تحسبي نفسك مميِّزة

13
00:01:12,190 --> 00:01:16,950
.انقضى ما يقارب الشَّهر مذ غادرت لندن ووصلت إلى هنا في هاوورث

14
00:01:19,780 --> 00:01:23,290
...استصعبت التَّأقلم مع الحياة في القصر، ولكن

15
00:01:23,580 --> 00:01:30,540
.مع ذلك، فأنا غزيرة الامتنان لكوني قادرة على العمل من جديد

16
00:01:35,260 --> 00:01:39,640
الفصل الأول

17
00:01:35,260 --> 00:01:39,640
منزل جديد

18
00:01:50,690 --> 00:01:53,190
.ها قد جاء شخص ما ظفرته أعيننا منذ فترة

19
00:01:53,280 --> 00:01:55,240
ما الَّذي أحضرك إلى هنا يا (ويليام)؟

20
00:01:55,320 --> 00:01:57,740
ماذا تعني بسؤالك هذا يا (ليونيل)؟

21
00:01:57,740 --> 00:01:59,740
.فأنت مَن دعاني إلى هنا

22
00:01:59,870 --> 00:02:04,120
.تناهى إلى مسامعي أنَّك تواريت عن الأنظار وتقوقعت في منزلك للأبد

23
00:02:04,200 --> 00:02:08,580
.سمعت أنَّك اصطفيت أن تكون رجل دين بعد الانقهلال في معترك اليأس

24
00:02:08,830 --> 00:02:10,880
.كفاكما مضايقتي

25
00:02:10,960 --> 00:02:15,510
.على كلٍّ، يبدو أنَّك قد دوايت فؤادك المنفطر أخيرًا

26
00:02:15,590 --> 00:02:17,630
!(نخب بداية منعشة لـ(ويليام

27
00:02:17,630 --> 00:02:18,760
!بصحَّتك

28
00:02:23,560 --> 00:02:25,810
.هذا الفستان ليس بجذَّاب نوعًا ما

29
00:02:26,350 --> 00:02:28,890
.إنَّه خطأ الورود لكونها شديدة البهاء

30
00:02:29,810 --> 00:02:31,940
.كنت تتصرَّفين بغرابة مؤخَّرًا

31
00:02:31,940 --> 00:02:36,530
.أولى لك أن تولي مظهرك مزيدًا من الاهتمام كونك أضحيت آنسة الآن

32
00:02:37,440 --> 00:02:41,870
.لا مَهمَّة لي بالتَّبرُّج، فهو لن يحضر هنا البتَّة

33
00:02:43,490 --> 00:02:46,450
.اشرب! هذا فقط كأسك الخامس

34
00:02:48,000 --> 00:02:49,620
.يا له من يوم مسلٍّ

35
00:02:49,750 --> 00:02:51,630
.كان يجدر بي الإضراب في المنزل

36
00:02:54,290 --> 00:02:55,500
ما الَّذي يجري؟

37
00:02:55,590 --> 00:02:58,510
.يبدو أنَّهم يقدِّمون عرضًا ممتعًا

38
00:02:58,760 --> 00:02:59,720
عرض؟

39
00:03:04,970 --> 00:03:07,020
حكيم)! ما الَّذي تفعله؟)

40
00:03:07,140 --> 00:03:10,020
ما هذا؟ أحضرت هنا أيضًا يا (ويليام)؟

41
00:03:10,020 --> 00:03:13,940
.لو علمت بقدومك اليوم، لأوصلتك على هذا الرَّفيق

42
00:03:15,480 --> 00:03:17,820
.كان يجدر بي الاعتكاف في بيتي بحقٍّ

43
00:03:17,940 --> 00:03:20,740
.(شكرًا على الدَّعوة يا (ليونيل

44
00:03:21,030 --> 00:03:23,780
.ارتأيت أن أضفي الحيويَّة على الحفلة

45
00:03:27,160 --> 00:03:31,580
.رائع! اليوم لهو يوم مسلٍّ فعلاً

46
00:03:31,670 --> 00:03:33,500
.بحقِّ السَّماء

47
00:03:38,840 --> 00:03:40,670
ويليام)؟)

48
00:03:41,050 --> 00:03:42,760
.(إليانور)

49
00:03:49,980 --> 00:03:51,390
.هذا مذهل

50
00:03:51,480 --> 00:03:54,690
.ينجح (حكيم) دائمًا في خطف الأضواء

51
00:03:54,770 --> 00:03:57,520
.تجذلني رؤيتك بحال أفضل

52
00:03:58,320 --> 00:04:01,530
...كانت هناك عدَّة شائعات تتداول حولك، لذلك

53
00:04:03,110 --> 00:04:04,280
.أجل

54
00:04:05,320 --> 00:04:08,790
.آسفة، ما كان ينبغي لي ذكر هذا الموضوع

55
00:04:08,870 --> 00:04:10,080
.لا بأس

56
00:04:13,250 --> 00:04:14,710
.سأكون بانتظارك

57
00:04:14,790 --> 00:04:15,750
ماذا؟

58
00:04:16,170 --> 00:04:20,170
.ليس من الضَّروريِّ أن يكون اليوم أو الغد

59
00:04:21,340 --> 00:04:23,720
.ما عندي مانع في الأمر

60
00:04:25,050 --> 00:04:25,970
.المعذرة

61
00:04:27,350 --> 00:04:31,680
.لم تتغيَّر مشاعري نحوك

62
00:04:32,310 --> 00:04:35,730
.إليانور)، دعينا لا نعاود الحديث في هذا الموضوع ثانية)

63
00:04:37,940 --> 00:04:39,190
من يكون ذاك الرَّجل؟

64
00:04:39,270 --> 00:04:43,490
أنسيت فعلاً كيف يبدو شكل خطيب ابنتك؟

65
00:04:43,570 --> 00:04:46,110
أذاك هو الابن البكر لعائلة (جونز)؟

66
00:04:46,240 --> 00:04:49,120
.لم يُحسم القرار بعد

67
00:04:49,200 --> 00:04:54,960
.لكنِّي أخرص أنَّه عرض جيِّد، فوالده متلهِّف لحدوثه

68
00:04:57,500 --> 00:04:59,880
.ويلٌ للنُّبلاء

69
00:05:12,060 --> 00:05:14,480
!ما الَّذي تفعلينه؟ لا تضعي أشياءك هنا

70
00:05:14,560 --> 00:05:15,940
.أعتذر

71
00:05:16,020 --> 00:05:19,650
إنَّها أنت، أوَلست الخادمة المؤقَّتة الجديدة؟

72
00:05:19,730 --> 00:05:20,610
.أجل

73
00:05:20,820 --> 00:05:23,940
.لدينا بالفعل ما يكفي من العمل هنا

74
00:05:23,940 --> 00:05:26,860
.ولا تجعلي حياتنا أكثر مشقَّة

75
00:05:26,950 --> 00:05:30,280
!أنت تعيقين الطريق بوقوفك هنا، انقلعي من هنا

76
00:05:41,130 --> 00:05:43,340
.كلُّ شيء مختلف تمام الاختلاف عن لندن

77
00:05:44,170 --> 00:05:46,260
.تعال، انظر إلى هذا

78
00:05:46,440 --> 00:05:49,390
.بوسعي بيع هذا بسعر مرتفع

79
00:05:49,640 --> 00:05:53,520
.إن استمررتُ بفعل هذا، فستكتشف سيِّدتي الأمر عاجلاً أم آجلاً

80
00:05:53,640 --> 00:05:56,020
.ولن أقدر على العمل ثانية إن قُبض عليَّ متلبِّسة

81
00:05:56,180 --> 00:05:58,020
.قلت إنِّي سأعتني بك

82
00:05:58,980 --> 00:06:01,480
أحقًّا تحسبني أصدِّق كلامك؟

83
00:06:01,570 --> 00:06:03,360
.لا تكوني متبلِّدة هكذا

84
00:06:03,360 --> 00:06:06,150
.فأنت الوحيدة الَّتي أثق بها لفعل شيء كهذا

85
00:06:06,570 --> 00:06:09,490
.سنكون معًا فور إكمال سداد ديوني

86
00:06:14,240 --> 00:06:15,450
.أراك فيما بعد

87
00:06:23,630 --> 00:06:24,710
!(إيما)

88
00:06:25,130 --> 00:06:26,720
منذ متى وأنت واقفة هنا؟

89
00:06:29,800 --> 00:06:31,930
كيف تجرَّأت على التَّنصُّت علينا؟

90
00:06:32,010 --> 00:06:33,810
.لم تكن تلك نيَّتي

91
00:06:33,930 --> 00:06:37,060
.عديني بصون هذا السِّرِّ عن أحد

92
00:06:37,350 --> 00:06:41,060
.لا أملك مكانًا ألجأ إليه فور فصلي عن العمل

93
00:06:46,900 --> 00:06:51,820
.لا جرم أنَّك ترينني امرأة حمقاء لا تعرف مقامها

94
00:06:51,910 --> 00:06:53,780
.هذا ليس صحيحًا

95
00:06:53,870 --> 00:06:58,660
.أدرك تمام الإدراك أنَّه يستغلُّني فقط

96
00:06:59,580 --> 00:07:02,960
.إلاَّ أنَّه طيِّب العريكة أيضًا

97
00:07:04,590 --> 00:07:09,260
.عملتُ بكدٍّ أكثر من غيري لأبلغ ما بلغته الآن

98
00:07:09,340 --> 00:07:12,590
.وأشعر بالفخر العارم لكوني خادمة السَّيِّدة

99
00:07:12,970 --> 00:07:17,470
.لكنَّه لا يراني إلاَّ محض خادمة

100
00:07:17,680 --> 00:07:20,600
.أعي أنَّ هذا الحبَّ أسمى من مكانتي

101
00:07:24,150 --> 00:07:28,650
.لكن ماذا عساي أفعل غير ذلك؟ لقد شغفني حبًّا

102
00:07:29,190 --> 00:07:33,990
.سيهجرني إن لم أنفِّذ أوامره، وليس لي في الأمر حيلة

103
00:07:43,630 --> 00:07:47,460
أحدث لك أمرٌ مبشِّر يا آنستي؟

104
00:07:48,630 --> 00:07:52,800
آني)، هل الإشاعات حول (ويليام) صحيحة؟)

105
00:07:53,260 --> 00:07:57,600
.أجل، سمعت أنَّ الخادمة الَّتي دارت حولها الشَّائعات قد هجرت لندن

106
00:07:57,810 --> 00:07:58,970
.فهمت

107
00:07:59,100 --> 00:08:03,100
.لا جرم أنَّ (ويليام) يعتريه الوحدة الشَّديدة حاليًّا

108
00:08:04,230 --> 00:08:07,480
.لن يأتي الحبُّ ما لم تتصرَّفي يا آنستي

109
00:08:13,530 --> 00:08:16,200
ما رأيك في (إيما) إذن؟

110
00:08:16,320 --> 00:08:20,370
.تمتاز بطلاقة اللِّسان دون لكنة على نحو مدهش كشخص من لندن

111
00:08:20,370 --> 00:08:24,080
،مع أنَّها اعتادت أن تكون خادمة لشتَّى الأعمال
.إلاَّ أنَّ شخصيَّتها لا غبار عليها لحدِّ الآن

112
00:08:25,460 --> 00:08:29,630
.لكن حقيق علينا ألاَّ نوظِّف أحدًا بمنتهى السُّرعة دون خطاب توصية

113
00:08:29,800 --> 00:08:32,340
.أقترح أن ننتظر قليلاً ونرى

114
00:08:32,470 --> 00:08:36,760
.لكن مرَّ ما يقارب الشَّهر على قدومها إلى هنا

115
00:08:36,850 --> 00:08:41,140
.أستميحك عذرًا يا سيِّدتي، لكنَّها خادمة نُقلت من خارج البلدة

116
00:08:42,350 --> 00:08:46,560
.التقتها (تاشا) على متن القطار، وبينهما انسجام على ما يبدو

117
00:08:46,650 --> 00:08:48,940
.ذلك ما يقلقني بالضَّبط

118
00:08:49,020 --> 00:08:51,740
سمعت قصصًا عن الخادمات اللَّواتي أَذِنَّ للصوص باقتحام المنزل

119
00:08:51,740 --> 00:08:56,160
.لأخذ أفضليَّة حقيقة أنَّ خلفيَّتهنَّ لم يجرَ التَّحقُّق منها

120
00:08:56,240 --> 00:08:57,910
.تبالغين بالتَّفكير بالأمر فحسب

121
00:08:57,990 --> 00:08:59,370
.بعد إذنك يا سيِّدتي

122
00:08:59,370 --> 00:09:04,410
.أعرب عن قلقي لأجل مصلحة هذا المنزل بصفتي مدبِّرة للمنزل

123
00:09:04,540 --> 00:09:08,290
.(طيِّب، إن أصررت على الأمر يا سيِّدة (ويك

124
00:09:08,460 --> 00:09:12,710
فهلاَّ أحضرت لي مروحتي الزَّرقاء المزيَّنة بالرِّيش؟

125
00:09:13,840 --> 00:09:18,850
.لكن سيِّدتي، أذكر قولك إنَّ اللَّون الأزرق لا يتناسب مع لون بشرتك

126
00:09:18,930 --> 00:09:22,770
.اللُّورد (بريمديل) وزوجته قادمان لمأدبة اللَّيلة

127
00:09:22,970 --> 00:09:25,520
.وكانت المروحة هديَّة منهما

128
00:09:26,900 --> 00:09:28,610
.سمعًا وطاعةً

129
00:09:31,900 --> 00:09:34,320
.التُّروس تتفتَّت لأجزاء

130
00:09:34,400 --> 00:09:38,570
ويلتاه، أبوسعك إصلاحها قبل مأدبة العشاء؟

131
00:09:38,660 --> 00:09:40,490
.طبعًا إذا حصلتُ على الأجزاء

132
00:09:40,580 --> 00:09:42,830
.سأطلب من (إيما) جلبها لك إذن

133
00:09:46,540 --> 00:09:49,170
.سأكون أسرع لو ذهبت بنفسي

134
00:09:51,630 --> 00:09:54,380
.السَّيِّدة (ويك) تطلب حضورنا إلى غرفة طعام الخدم

135
00:09:54,460 --> 00:09:56,340
.(وذلك يشملك أنت أيضًا يا (هانز

136
00:09:56,420 --> 00:09:57,510
ما الَّذي يجري؟

137
00:09:57,590 --> 00:10:00,260
.يبدو أنَّ أحدًا ما سرق مروحة سيِّدتي

138
00:10:02,600 --> 00:10:04,680
هل فتَّشتم عنها في كلِّ مكان فعلاً؟

139
00:10:04,680 --> 00:10:08,850
.نحتاج إلى كلِّ ثانية كي نتحضَّر الأطباق لمأدبة اللَّيلة

140
00:10:08,940 --> 00:10:14,940
كانت سيِّدتنا تنوي استخدام تلك المروحة في المأدبة
.وهذا سبب وجودكم جميعًا هنا

141
00:10:15,110 --> 00:10:19,360
،بادئ ذي بدء، علقنا في المطبخ طوال اليوم

142
00:10:19,360 --> 00:10:23,240
وكيف بحقِّ السَّماء يتسنَّى لنا سرقة شيء كهذا من حجرة السَّيِّدة؟

143
00:10:23,330 --> 00:10:26,160
.أجل، أصبت كبد الحقيقة

144
00:10:26,290 --> 00:10:30,630
.لا جرم أن يكون الجاني شخصًا يملك صلاحيَّة لدخول حجرة السَّيِّدة

145
00:10:30,710 --> 00:10:35,760
أتلمِّحين بأنَّ إحدى الخادمات أو أنا الفاعلة بسبب كوني خادمة للسَّيِّدة؟

146
00:10:36,670 --> 00:10:40,010
مَن الَّتي نظَّفت حجرة نوم سيِّدتي اليوم؟

147
00:10:42,140 --> 00:10:43,300
.(كانت (إيما

148
00:10:50,270 --> 00:10:55,110
هل أذنتِ لمن لم يُوظَّف رسميًّا بدخول حجرة النَّوم الرَّئيسة؟

149
00:10:55,190 --> 00:10:56,650
.أعتذر

150
00:10:56,780 --> 00:10:58,400
.يا لإهمالك الصَّارخ

151
00:10:58,490 --> 00:11:01,200
.الآنسة (إيما) ليست ممَّن يفعل شيئًا كهذا

152
00:11:01,280 --> 00:11:05,540
.طيِّب، لو أدَّيت عملك أساسًا لما حدث هذا

153
00:11:05,620 --> 00:11:07,160
...لكن

154
00:11:07,660 --> 00:11:11,330
.لا يسعنا الجزم بأنَّ المروحة قد سُرقت اليوم

155
00:11:11,420 --> 00:11:15,590
.لكن كلِّي يقين أنَّ المروحة كانت قائمة في الجارور البارحة

156
00:11:21,130 --> 00:11:26,180
...أخرص أنَّ عاملة مجتهدة كشاكلة (إيما) قد تُقدم على فعل كهذا، ولكن

157
00:11:29,020 --> 00:11:32,930
أمرٌ لا يُصدَّق! مَن كان ليتوقَّع أنَّنا نعمل مع سارقة تحت سقف واحد؟

158
00:11:32,930 --> 00:11:33,560
!(بولي)

159
00:11:36,440 --> 00:11:38,400
إذن يا (إيما)؟

160
00:11:38,570 --> 00:11:43,240
.سيتعيَّن علينا تفتيش غرفتك ما لم تطلقي لسانك

161
00:11:43,780 --> 00:11:45,280
.أتفهَّم الأمر

162
00:11:53,000 --> 00:11:54,250
.اخلعي ثيابك

163
00:11:55,920 --> 00:11:57,000
.حاضر

164
00:11:58,880 --> 00:12:03,640
.فالغلطة غلطتي لثقتي بك لو كنت الجانية

165
00:12:03,800 --> 00:12:05,260
.أعتذر

166
00:12:05,430 --> 00:12:07,140
لمَ تعتذرين؟

167
00:12:07,220 --> 00:12:08,510
.لا شيء

168
00:12:11,270 --> 00:12:14,100
.تبدو بغاية البراءة أيضًا، يا لها من نساء مخيفات

169
00:12:14,350 --> 00:12:18,570
.لكنَّك عجزت عن معرفة ما يجول بخلدها منذ وصولها إلى هنا

170
00:12:18,690 --> 00:12:21,650
.لم يخِل إليَّ قطُّ أنَّها السَّارقة

171
00:12:21,740 --> 00:12:24,530
.لن ترتكب الآنسة (إيما) فعلاً كهذا

172
00:12:24,610 --> 00:12:27,120
!سمعناك منذ أوَّل مرَّة

173
00:12:27,120 --> 00:12:30,040
إذن، ما الَّذي تفقينه عن (إيما)؟

174
00:12:30,120 --> 00:12:30,910
...حسنٌ

175
00:12:30,950 --> 00:12:33,710
أيُّ نوع من المنازل عملت في لندن؟

176
00:12:33,790 --> 00:12:34,790
...حسنٌ، هذا

177
00:12:34,870 --> 00:12:36,500
وما سبب استقالتها؟

178
00:12:38,130 --> 00:12:41,800
.أرأيت أمرًا؟ لا تعرفين عنها مثقال ذرَّة

179
00:12:43,840 --> 00:12:47,390
.فلتُحضرها للإصلاح إن لم ينفع الأمر

180
00:12:47,510 --> 00:12:49,260
.هذا ليس بالأمر الجلل

181
00:12:49,350 --> 00:12:52,270
.ما فتئ عملي كاسدًا إلى حدِّ ما بسببك

182
00:12:52,350 --> 00:12:53,730
.أعتذر بشأن ذلك

183
00:13:00,440 --> 00:13:02,990
.ارتأيت أنَّ الزُّرقة ستليق بك

184
00:13:03,240 --> 00:13:06,570
.لقد تذكَّرتَ قولي القديم

185
00:13:06,660 --> 00:13:07,700
ماذا؟

186
00:13:07,800 --> 00:13:09,330
.بالطَّبع، تذكَّرته

187
00:13:09,530 --> 00:13:12,120
.لن تصدِّقي ما مررتُ به كي أجد هذه

188
00:13:18,750 --> 00:13:22,550
لا بدَّ أنَّها غالية الثَّمن، أواثقٌ أنَّه يمكنني الاحتفاظ بها؟

189
00:13:23,050 --> 00:13:27,220
.سأنفق كلَّ بنس أجنيه لأجلك يا حبيبتي

190
00:13:30,470 --> 00:13:36,310
.كلامك المعسول المنحوس يشبه همسات (روميو) الرُّومانسيَّة بهذه المروحة

191
00:13:36,390 --> 00:13:38,560
...مقارنةً بي، (روميو) هو

192
00:13:41,770 --> 00:13:43,280
ما مرادك؟

193
00:13:48,870 --> 00:13:50,070
!(راندي)

194
00:13:50,410 --> 00:13:51,910
.سأستعيد هذه

195
00:13:52,700 --> 00:13:54,250
.المروحة

196
00:13:55,870 --> 00:13:58,210
.ما لي ناقة ولا جمل

197
00:13:58,290 --> 00:13:59,920
من أنت بحقِّ الجحيم؟

198
00:14:00,210 --> 00:14:04,300
أتحسب نفسك قادرًا على التَّملُّص من عقوبة الاعتداء على ضابط عسكريٍّ؟

199
00:14:04,380 --> 00:14:08,180
.(إن لم يرُق لك هذا الأمر، فتعال إلى قصر آل (مولدرز

200
00:14:08,430 --> 00:14:10,550
مولدرز)؟)

201
00:14:10,760 --> 00:14:13,010
.(ويلٌ لتلك الفتاة (نانيت

202
00:14:24,280 --> 00:14:26,610
.(هذه اللَّكمة لأجل (نانيت

203
00:14:31,700 --> 00:14:33,410
!ذلك الحقير

204
00:14:33,740 --> 00:14:35,410
من تكون (نانيت)؟

205
00:14:45,760 --> 00:14:47,920
.عُثر على الجانية

206
00:14:50,760 --> 00:14:53,260
.سنتعامل معك فيما بعد

207
00:14:53,350 --> 00:14:57,100
.تنقصنا العِمالة، لذا أريدك أن تعودي للعمل على الأثر

208
00:14:57,600 --> 00:14:58,940
.حمدًا للرَّبِّ

209
00:14:59,190 --> 00:15:03,020
.وجد (هانز) المروحة في البلدة وأعادها

210
00:15:03,270 --> 00:15:04,730
هانز)؟)

211
00:15:04,820 --> 00:15:05,270
.أجل

212
00:15:05,270 --> 00:15:07,570
!الوقت يداهمنا، عجِّلا

213
00:15:18,040 --> 00:15:23,630
.ألواح البلوط والمنحوتات كانتا في الأصل من دير في ألمانيا

214
00:15:24,880 --> 00:15:28,760
.صادفتُهما بمزاد في لندن، وابتعتهما على الأثر

215
00:15:28,840 --> 00:15:33,340
.صنع هذه الغرفة لأجل عرضهما وحسب

216
00:15:33,470 --> 00:15:38,350
.أنا موقن أنَّهما تذكِّرانه بألمانيا. امتلاك المرء شيئًا من وطنه يريح النَّفس

217
00:15:38,430 --> 00:15:41,230
.جلُّ ما في الأمر أنَّ الفراغ يعمُّ هذا المكان

218
00:15:41,390 --> 00:15:44,900
.تجذلني رؤيتك تستخدمين المروحة الَّتي أهديتك إيَّاها

219
00:15:44,900 --> 00:15:46,770
.تليق بك كثيرًا

220
00:15:47,190 --> 00:15:51,570
.تراءى لي أنَّها قد تضيف بعض اللَّمسات على الغرفة

221
00:15:54,780 --> 00:15:56,700
!(السَّارقة كانت (نانيت

222
00:15:56,780 --> 00:15:59,750
.تجازف بحياتها من أجل مروحة

223
00:15:59,830 --> 00:16:03,420
!وليس هذا فحسب، بل من يعرف ما الَّذي تسرقه غير هذه؟

224
00:16:03,620 --> 00:16:09,010
.لكن ما الَّذي تنوي فعله بعدئذٍ يا ترى؟ فلن يوظِّفها أيُّ أحد الآن

225
00:16:09,090 --> 00:16:14,390
.أجل، لا أحد سيوظِّف خادمة بدون توصية إلاَّ سيِّدتنا

226
00:16:14,390 --> 00:16:15,010
!(بولي)

227
00:16:15,050 --> 00:16:16,550
.آسفة

228
00:16:33,030 --> 00:16:34,280
.(آنسة (نانيت

229
00:16:43,290 --> 00:16:46,710
.(قرَّرت أن أطلق سراح (نانيت

230
00:17:10,860 --> 00:17:11,900
!(آنسة (نانيت

231
00:17:13,440 --> 00:17:14,570
!دعيني أموت

232
00:17:14,650 --> 00:17:16,610
!(لا يجدر بك ذلك يا آنسة (نانيت

233
00:17:17,780 --> 00:17:21,790
.أترجَّاك! أرجوك ذريني أموت فحسب

234
00:17:34,090 --> 00:17:36,800
لمَ لا تدعينني أموت فحسب؟

235
00:17:36,880 --> 00:17:39,470
.أتفهَّم شعورك جيِّدًا

236
00:17:39,550 --> 00:17:43,180
.كفى! أعلم أنَّك تخالينني أستأهل هذا

237
00:17:46,350 --> 00:17:49,560
.حاولت إلقاء اللوم عليك

238
00:18:09,210 --> 00:18:11,790
لمَ لم تبلغيني بهذا الأمر عاجلاً؟

239
00:18:11,920 --> 00:18:17,130
.أرجو المعذرة، ولكنِّي لم أشأ إزعاجك لأجل أمر تافه

240
00:18:17,470 --> 00:18:22,050
.أخشى أنَّنا لا نملك خيارًا سوى إكراه (نانيت) على ترك المنزل

241
00:18:22,810 --> 00:18:23,850
.(إيما)

242
00:18:24,140 --> 00:18:27,480
سمعت أنَّك تحمَّلت اللَّوم عالمةً بفعلة (نانيت) طوال الوقت؟

243
00:18:27,600 --> 00:18:32,770
.هذه إحدى القضايا الَّتي تزيد الطِّين بلَّة

244
00:18:32,860 --> 00:18:34,570
.(أنا أسأل (إيما

245
00:18:37,070 --> 00:18:39,410
لمَ تحمَّلت اللَّوم وأنت تعلمين الحقيقة؟

246
00:18:39,820 --> 00:18:41,450
.أعتذر

247
00:18:41,570 --> 00:18:43,830
لن تميطي اللِّثام عن السَّبب أيضًا؟

248
00:18:43,910 --> 00:18:49,750
.أرجو المعذرة، فلا يسعني إلاَّ القول إنِّي جذلانة لكون الآنسة (نانيت) سالمة معافاة

249
00:18:54,170 --> 00:18:55,170
.أستميحك عذرًا

250
00:18:56,300 --> 00:19:00,300
ألك بالصَّفح عن الآنسة (نانيت)؟

251
00:19:04,430 --> 00:19:05,430
!اعرفي مقامك

252
00:19:05,510 --> 00:19:10,730
...إنِّي على إدراك تامٍّ أنِّي لست في موضع يخوِّلني لطرح أسئلة كهذه، ولكن

253
00:19:10,810 --> 00:19:13,480
!(هذا يكفي يا (إيما

254
00:19:20,780 --> 00:19:22,870
.(جيِّد يا (إيما

255
00:19:23,030 --> 00:19:26,870
.بوسع (نانيت) البقاء، وحقيقٌ عليها شكرك

256
00:19:27,790 --> 00:19:28,830
!سيِّدتي

257
00:19:28,910 --> 00:19:33,540
.لكن ليس كخادمة لي، وإنَّما ستتمُّ إعادة تعيينك في وظيفة أخرى

258
00:19:33,540 --> 00:19:35,460
وهكذا يُسوَّى الأمر، أليس كذلك؟

259
00:19:35,540 --> 00:19:36,590
...لكن

260
00:19:37,000 --> 00:19:42,090
.لو تحتَّم على أحد إثارة هذه المسألة مرَّة أخرى، سيُفصل بلا هوادة

261
00:19:54,770 --> 00:19:58,780
.وأيضًا يا (إيما)، إنَّك موظَّفة رسميًّا اعتبارًا من اليوم

262
00:19:58,940 --> 00:20:02,030
!سيِّدتي! هذا طائشٌ جدًّا

263
00:20:02,150 --> 00:20:06,530
.تعجبني الفتيات الَّتي يستطعن نفض ما يضيق به صدرهنَّ وينكِّد خاطرهنَّ

264
00:20:06,830 --> 00:20:11,410
.سيِّدة (ويك)، هذا بالضَّبط سبب إبقائك بجواري أيضًا

265
00:20:19,710 --> 00:20:22,590
.تغمرني سعادة غارمة بانتقالك إلى هذه الحجرة

266
00:20:22,590 --> 00:20:25,550
.والآن أحظى أخيرًا بشخص أفضفض إليه

267
00:20:30,100 --> 00:20:31,730
!منديل الدَّانتيل

268
00:20:32,640 --> 00:20:36,400
فهمت، أهذه هديَّة من حبيبك؟

269
00:20:38,190 --> 00:20:39,900
.أعتذر

270
00:20:39,980 --> 00:20:43,280
.لا عليك، ما فات قد مات

271
00:20:43,360 --> 00:20:47,870
.لكنِّي أغبطك أيَّما غبطة، فلا جرم أنَّها كانت رومانسيَّة رائعة

272
00:20:55,080 --> 00:20:59,500
.انقضى ما يقارب الشَّهر مذ غادرت لندن ووصلت إلى هنا في هاوورث

273
00:20:59,750 --> 00:21:03,420
...استصعبت التَّأقلم مع الحياة في القصر، ولكن

274
00:21:03,510 --> 00:21:10,060
.مع ذلك، فأنا غزيرة الامتنان لكوني قادرة على العمل من جديد

275
00:21:14,310 --> 00:21:17,440
...منزل جديد... حياة جديدة

276
00:21:17,440 --> 00:21:22,400
.اتَّخذت قراري ببدء حياة جديدة

277
00:21:25,450 --> 00:21:27,620
من الَّذي يشغل بالك؟

278
00:21:27,820 --> 00:21:30,030
إيما) أمْ (إليانور)؟)

279
00:21:30,120 --> 00:21:34,080
.ما الَّذي تهذي به؟ فلا علاقة لـ(إليانور) بالأمر

280
00:21:34,160 --> 00:21:36,120
.أخرص أنَّها تفكِّر في هذا الأمر

281
00:21:36,210 --> 00:21:37,630
أكنت تراقبنا؟

282
00:21:37,750 --> 00:21:41,960
.يقال إنَّ حبًّا جديدًا أفضل علاجٍ لانفطار الفؤاد

283
00:21:42,130 --> 00:21:46,180
.لا أريد جرح مشاعرها مجدَّدًا لأسباب أنانيَّة كهذه

284
00:21:46,460 --> 00:21:50,550
يبدو وكأنَّك مهتمٌّ بها رغم ذلك، صحيح؟

285
00:21:50,640 --> 00:21:52,720
.كفاك عبثًا معي

286
00:21:52,930 --> 00:21:56,850
.النِّساء قويَّات، والرِّجال أوزاغ

287
00:21:57,480 --> 00:22:01,770
.في كلتا الحالتين، لن أذرك تغدو ضعيفًا جبانًا بهذا الشَّكل أبدًا

288
00:22:11,870 --> 00:22:15,370
.عليك أن ترتاحي قليلاً يا آنستي

289
00:22:16,250 --> 00:22:20,170
.آني)، أرجو أن توصلي هذه إلى منزل آل (جونز) غدًا)

290
00:22:21,420 --> 00:22:24,880
لن يأتي الحبُّ ما لم أتصرَّف، صحيح؟

291
00:23:55,140 --> 00:23:57,720
في الحلقة القادمة

292
00:24:06,440 --> 00:24:11,070
الفصل الثاني

293
00:24:06,440 --> 00:24:11,070
قمراء