1
00:00:06,970 --> 00:00:12,310
تغمرني سعادة كبيرة بالعمل
.إلى جانبك ثانية يا صاحب السّموّ

2
00:00:12,700 --> 00:00:15,000
جيّد. كيف حال جرحك؟

3
00:00:15,820 --> 00:00:18,670
.حتّى النّدبة منه بالكاد موجدة

4
00:00:18,670 --> 00:00:21,340
.كلّ هذا بفضل اللّيدي كلورنس

5
00:00:26,360 --> 00:00:29,690
أستطيع الآن العودة لأكون حارسك
،يا صاحب السّموّ

6
00:00:29,690 --> 00:00:32,040
.لكنّ العمل داخل القلعة لن يكون مشكلة

7
00:00:33,180 --> 00:00:35,510
.هكذا إذًا. سرّني سماع هذا

8
00:00:35,890 --> 00:00:37,640
،الأهمّ من ذلك يا صاحب السّموّ

9
00:00:37,640 --> 00:00:41,390
سمعتُ أنّك ذهبت إلى البلدة
.مرّات عدّة للتّفتيش

10
00:00:42,250 --> 00:00:43,820
.ذلك صحيح

11
00:00:43,820 --> 00:00:45,640
هل جذب شيء ما انتباهك؟

12
00:00:46,060 --> 00:00:48,300
.لا، الأمر ليس كذلك

13
00:00:48,770 --> 00:00:50,890
.مهلاً، ربّما هو كذلك بالفعل

14
00:00:51,330 --> 00:00:52,900
ما الّذي تقصده...؟

15
00:00:53,740 --> 00:00:58,410
.كلّ شيء بخير
.إنّه ليس شيئًا يدعو لإقلاق أيّ منكم

16
00:00:58,940 --> 00:01:03,050
لكن إن استعملت قدرتك
،على التّنكّر مرّات كثيرة

17
00:01:03,050 --> 00:01:06,340
.فسيضع ذلك ضغطًا على جسدك وعلى الأداة

18
00:01:12,380 --> 00:01:15,430
أنت محقّ، فإن واصلتُ استعمالها
،كما كنت أفعل

19
00:01:15,430 --> 00:01:17,400
.فسأفقد القدرة على التّحوّل يومًا ما

20
00:01:18,460 --> 00:01:19,570
.أنا رين

21
00:01:19,570 --> 00:01:20,370
.تفضّل

22
00:01:21,550 --> 00:01:22,860
.عذرًا على التّطفّل

23
00:01:22,860 --> 00:01:24,880
!السّيّد راندال

24
00:01:24,880 --> 00:01:28,560
.أرى أنّك عدت. تهانيّ لك

25
00:01:29,000 --> 00:01:32,670
.شكرًا لك. كلّ هذا بفضل أختك الصّغيرة

26
00:01:32,670 --> 00:01:33,770
.أنا ممتنّ لها

27
00:01:34,590 --> 00:01:36,960
.لطالما كانت أختي مهتمّة بنفسها فقط

28
00:01:36,960 --> 00:01:39,650
لكنّها وصلت أخيرًا لمستوى متوسّط من
.الإنسانيّة عن طريق مساعدتها للآخرين

29
00:01:40,080 --> 00:01:43,840
حتّى إن مُنحتْ مكافأة وسام
،الوردة الإمبراطوريّة

30
00:01:43,840 --> 00:01:46,280
.فسيظلّ رأي أخيها الأكبر فيها لاذعًا

31
00:01:47,060 --> 00:01:49,450
كيف حال اللّيدي كلورنس؟

32
00:01:49,870 --> 00:01:53,760
،بما أنّنا بصدد هذا الموضوع
.فإنّها ليست على ما يرام مؤخّرًا

33
00:01:54,080 --> 00:01:54,800
ماذا؟

34
00:01:54,800 --> 00:01:56,390
وهل هي بخير الآن؟

35
00:01:57,720 --> 00:01:59,190
.ليس بالأمر الخطير

36
00:03:49,890 --> 00:03:52,740
!ليزي

37
00:03:54,650 --> 00:03:57,300
ما الّذي تفعلينه؟

38
00:03:58,560 --> 00:04:00,570
...أخي كريس

39
00:04:02,100 --> 00:04:04,260
!ماذا؟ أعدها لي رجاءً

40
00:04:04,480 --> 00:04:06,010
!كلاّ

41
00:04:06,010 --> 00:04:09,020
.أنت تدرسين كثيرًا يا ليزي
كم مرّة أخبرتك بذلك؟

42
00:04:09,510 --> 00:04:10,760
...لكن

43
00:04:11,160 --> 00:04:14,560
،إن أراد المرء العمل بكلّ جهده
.فعليه أيضًا اللّعب بكلّ جهده

44
00:04:14,560 --> 00:04:16,670
.نعم، نعم. هذا مهمّ للغاية

45
00:04:16,670 --> 00:04:19,640
وإن كنتِ تتساءلين، فسأذهب
.إلى البلدة اليوم للاستمتاع بوقتي

46
00:04:20,070 --> 00:04:22,030
.لذلك عليك أن تحذين حذوي

47
00:04:23,540 --> 00:04:24,630
...حسنًا

48
00:04:25,500 --> 00:04:28,850
.مهما كانت الظّروف، فإنّ تغيير الوتيرة مهمّ

49
00:04:28,850 --> 00:04:29,540
...على الأقلّ

50
00:04:29,910 --> 00:04:32,060
.تجوّلي تحت أشعة الشّمس

51
00:04:35,020 --> 00:04:38,470
صحيح أنّ أشعة الشّمس تعزّز
...النّظام المناعيّ، ولكن

52
00:04:39,720 --> 00:04:41,360
.أريد الدّراسة

53
00:04:41,360 --> 00:04:43,240
...إن فشلت في امتحان الأطبّاء

54
00:04:44,090 --> 00:04:46,150
.فلن أتمكّن من خوضه ثانية أبدًا

55
00:04:47,540 --> 00:04:52,520
.لا. قرّرتُ أن أعيش هذه الحياة كطبيبة أيضًا

56
00:04:52,520 --> 00:04:54,790
.لن أتخلّى عن هذه الرّغبة

57
00:05:01,540 --> 00:05:03,250
ماذا؟ روز؟

58
00:05:03,820 --> 00:05:07,070
لديك إجازة اليوم، صحيح؟
هل من خطب ما؟

59
00:05:07,460 --> 00:05:10,200
.صحيح. معك حقّ

60
00:05:10,200 --> 00:05:13,460
.انتهى بي المطاف هنا دون أن أدرك ذلك

61
00:05:14,650 --> 00:05:17,070
.أعتقد أنّك ربّما تعملين أكثر من اللاّزم يا روز

62
00:05:17,070 --> 00:05:20,120
عليك نسيان العمل في أيّام
.الإجازة والاسترخاء قليلاً

63
00:05:27,640 --> 00:05:29,650
.كم هذا محرج

64
00:05:29,650 --> 00:05:32,680
.صحيح! سأحرص على تغيير وتيرتي اليوم

65
00:05:33,140 --> 00:05:35,390
في أيّام مثل هذه، عليّ تناول
—شيء حلو و

66
00:05:42,590 --> 00:05:43,880
السّيّد رون؟

67
00:05:44,670 --> 00:05:47,810
.سمعتُ أنّك كنت مريضة
هل تحسّن حالك الآن؟

68
00:05:47,810 --> 00:05:50,700
ماذا؟ كيف عرفت بذلك؟

69
00:05:50,700 --> 00:05:52,530
.سمعت أحدًا ما يذكر ذلك

70
00:05:52,530 --> 00:05:54,160
.هكذا إذًا

71
00:05:54,600 --> 00:05:58,760
.شكرًا لقلقك عليّ. أنا في أفضل حال الآن

72
00:06:00,920 --> 00:06:02,530
هل ما زال لديك عمل اليوم؟

73
00:06:02,840 --> 00:06:04,420
.كلاّ

74
00:06:04,420 --> 00:06:07,050
.إنّه يوم إجازتي في الحقيقة

75
00:06:07,490 --> 00:06:08,540
يوم إجازتك؟

76
00:06:09,070 --> 00:06:13,050
هل يعقل أنّ حالتك ساءت ثانية؟

77
00:06:13,050 --> 00:06:15,070
.لا، الأمر ليس كذلك

78
00:06:15,070 --> 00:06:15,920
...ولكن ما الّذي

79
00:06:16,440 --> 00:06:18,470
.أتيتُ اليوم لأراك

80
00:06:21,090 --> 00:06:23,430
.كنت آمل تسديد ديوني

81
00:06:24,340 --> 00:06:25,350
ديونك؟

82
00:06:26,210 --> 00:06:29,520
لكنّي لن أرتاح حتّى أردّ لك
.المعروف الّذي أدين لك به

83
00:06:32,620 --> 00:06:33,630
.تعالي معي

84
00:06:35,890 --> 00:06:36,910
...لكن

85
00:06:38,930 --> 00:06:41,520
.أذكر أنّك قلتِ أنّ كعكة فراولة ستكون كافية

86
00:06:42,000 --> 00:06:47,210
أو ربّما تريدين بودينغ المانغو وتارت
.الموز. سأدعوك لأيّ شيء تحبّين

87
00:06:51,460 --> 00:06:52,510
.سنغادر

88
00:06:52,510 --> 00:06:53,630
...حاضر يا صاحب

89
00:06:54,760 --> 00:06:56,230
معك ضيفة؟

90
00:06:56,230 --> 00:06:57,370
.نعم

91
00:06:57,370 --> 00:07:00,590
.نودّ الذّهاب إلى أشهر مقهى في لوريج

92
00:07:01,360 --> 00:07:05,480
.في تلك الحالة، سأخذكما إلى مقهى لي

93
00:07:05,950 --> 00:07:06,790
.جيّد

94
00:07:07,300 --> 00:07:09,480
ماذا؟ مقهى لي؟

95
00:07:17,410 --> 00:07:20,290
إنّ السّيّد رون ليس من النّوع
،الّذي يتحدّث كثيرًا

96
00:07:20,290 --> 00:07:22,910
وليس لديّ أيّ موضوع لأحدّثه به
،على وجه الخصوص

97
00:07:22,910 --> 00:07:25,240
لذلك عرفتُ أنّ الأمور ستنتهي
...هكذا، ومع ذلك

98
00:07:32,270 --> 00:07:35,470
تبدو ملامحه أكثر جمالاً
.من هذه المسافة القريبة

99
00:07:35,470 --> 00:07:38,310
.لكن من الفظاظة التّحديق في الآخرين

100
00:07:39,840 --> 00:07:42,580
.هذا الجوّ غريب للغاية

101
00:07:45,450 --> 00:07:47,930
.إنّه يبدو مألوفًا لي

102
00:07:54,020 --> 00:07:55,540
.شكرًا على الانتظار

103
00:08:00,530 --> 00:08:04,090
.هذا شاي الظّهيرة الخاصّ بمقهى لي

104
00:08:04,880 --> 00:08:07,130
.خذا وقتكما واستمتعا به رجاءً

105
00:08:09,160 --> 00:08:11,580
.كانت كعكة واحدة لتفي بالغرض

106
00:08:12,020 --> 00:08:14,610
.رغم مظهري، فإنّي ميسور الحال

107
00:08:14,610 --> 00:08:16,230
.كلي ما تشائين دون أيّ قيود رجاءً

108
00:08:19,110 --> 00:08:20,180
!آهٍ منك يا سيّد رون

109
00:08:21,430 --> 00:08:22,440
ماذا هنالك؟

110
00:08:22,440 --> 00:08:25,170
.لا شيء

111
00:08:25,980 --> 00:08:28,830
قال السّيّد رون ذلك كمزحة، صحيح؟

112
00:08:29,860 --> 00:08:34,110
.هذا الكعك... لطالما أردت تجربته ولو لمرّة

113
00:08:43,340 --> 00:08:45,890
.إنّها تستمتع بالكعك كثيرًا

114
00:08:46,850 --> 00:08:50,400
.لكن لا يجب لهذه أن تكون هديّتي الوحيدة لها

115
00:08:50,930 --> 00:08:53,910
.عليّ اكتشاف ما الّذي تحبّه أيضًا

116
00:08:55,400 --> 00:08:57,370
من عليّ أن أسأل يا ترى؟

117
00:08:58,230 --> 00:09:01,330
.إنّ رين... لن يكون ذا عون

118
00:09:01,800 --> 00:09:04,300
!صحيح! يمكنني سؤال كريس

119
00:09:04,300 --> 00:09:06,730
.سمعت أنّه موظّف رسميّ في المكتب الإداريّ

120
00:09:07,350 --> 00:09:10,930
لكن ما المجال الّذي قد أستعمل لاستدعائه؟

121
00:09:10,930 --> 00:09:13,540
.لا يجمعني به أيّ شأن مشترك

122
00:09:13,540 --> 00:09:17,230
صحيح. ربّما يمكننا خوض نقاش
.عن الإدارة الوطنيّة

123
00:09:18,160 --> 00:09:20,860
.يبدو غارقًا في أفكاره

124
00:09:23,210 --> 00:09:27,250
!كان ذلك لذيذًا
!شكرًا على الدّعوة يا سيّد رون

125
00:09:27,440 --> 00:09:28,640
فعلاً؟

126
00:09:28,640 --> 00:09:30,890
...تارت الفراولة في مقهى لي

127
00:09:30,890 --> 00:09:34,030
!إنّها الألذّ بين كلّ التّارت الّتي أكلتها

128
00:09:34,030 --> 00:09:36,330
.كانت حلاوة الفراولة مثاليّة

129
00:09:36,790 --> 00:09:38,430
إنّك تحبّينها بالفعل، صحيح؟

130
00:09:39,100 --> 00:09:43,760
،نعم! إن أكلتها يا سيّد رون
.فأنا واثقة أنّها ستُرضي ذوقك

131
00:09:44,590 --> 00:09:48,280
.إنّ رؤية وجهك هذا يُرضيني بما فيه الكفاية

132
00:09:48,600 --> 00:09:49,260
ماذا؟

133
00:09:51,400 --> 00:09:52,260
ماذا هنالك؟

134
00:09:52,640 --> 00:09:54,510
.لا شيء

135
00:09:54,990 --> 00:09:58,070
.هذا امتنان. لقد دعاني من باب الامتنان

136
00:09:58,070 --> 00:09:59,630
.لا يوجد أيّ سبب أعمق من ذلك

137
00:10:04,300 --> 00:10:07,540
.أذكر هذه المسرحيّة لأنّها صارت حديث البلدة

138
00:10:11,020 --> 00:10:12,890
أتريدين مشاهدة هذه المسرحيّة؟

139
00:10:13,540 --> 00:10:15,790
.كلاّ، لا حاجة لذلك

140
00:10:16,510 --> 00:10:18,390
.لنشاهدها إذًا

141
00:10:18,390 --> 00:10:19,350
ماذا؟

142
00:10:19,350 --> 00:10:21,630
!لا حاجة لذلك بالفعل

143
00:10:22,010 --> 00:10:25,140
.ليس عليك إجبار نفسك على مشاهدتها من أجلي

144
00:10:25,920 --> 00:10:30,170
إنّ مشاهدة مسرحيّة رومانسيّة
...رفقة رجل قد تكون

145
00:10:31,000 --> 00:10:33,190
.أريد مشاهدة هذه المسرحيّة أيضًا

146
00:10:33,740 --> 00:10:35,580
فعلاً؟

147
00:10:36,020 --> 00:10:39,060
.لأكون دقيقًا أكثر، أريد مشاهدتها معك

148
00:10:39,540 --> 00:10:40,460
ماذا؟

149
00:10:42,170 --> 00:10:44,200
.تذكرتان رجاءً –
معي؟ –

150
00:10:44,200 --> 00:10:45,570
لكن لماذا؟

151
00:10:46,650 --> 00:10:50,820
.لم نرَ أنا والسّيّد رون بعضنا إلاّ في المستشفى

152
00:10:53,170 --> 00:10:55,930
.لحسن الحظّ أنّه ما زالت لديهم مقاعد شاغرة

153
00:10:57,470 --> 00:11:00,750
هل من الممكن أنّك لا تحبّين
فكرة مشاهدة مسرحيّة معي؟

154
00:11:01,160 --> 00:11:03,640
!لا، على الإطلاق

155
00:11:04,010 --> 00:11:05,280
.سرّني سماع هذا

156
00:11:06,350 --> 00:11:08,510
.حسنًا، لندخل إذًا

157
00:11:09,910 --> 00:11:11,360
.ها هو ذا ثانية

158
00:11:11,360 --> 00:11:13,390
ما هذا الشّعور؟

159
00:11:14,020 --> 00:11:17,930
هلاّ رقصت معي أيّتها اللّيدي إليز؟

160
00:11:19,800 --> 00:11:21,440
هل يذكّرانني ببعضهما؟

161
00:11:40,780 --> 00:11:43,070
...أفضّل ألاّ أترك يدك أبدًا

162
00:11:43,500 --> 00:11:46,020
.لا يجب عليك قول المزيد

163
00:11:46,420 --> 00:11:48,810
.لدينا هذه اللّحظة على الأقلّ

164
00:12:03,600 --> 00:12:05,370
!هيّا معًا

165
00:12:06,970 --> 00:12:09,770
.تتغيّر تعابيرها بسرعة

166
00:12:09,770 --> 00:12:10,920
.كم هذا غريب

167
00:12:11,670 --> 00:12:14,980
.يرتاح قلبي كثيرًا بمجرّد تواجدي قرب إليز

168
00:12:15,950 --> 00:12:19,540
.لم أشعر هكذا مذّاك اليوم

169
00:12:36,880 --> 00:12:39,450
!لا تجعلها تعاني أكثر

170
00:12:39,450 --> 00:12:40,610
!اخرس

171
00:12:55,530 --> 00:12:58,230
!مذهل! كم هذا مبتكر

172
00:12:58,230 --> 00:13:00,280
!إنّ لهذا الأداء تأثير قويّ بالفعل

173
00:13:00,840 --> 00:13:02,710
.تمادى هذا كثيرًا ليكون مجرّد جزء من المسرحيّة

174
00:13:02,710 --> 00:13:04,890
!صحيح، هناك خطب ما

175
00:13:07,750 --> 00:13:08,710
!اهربوا

176
00:13:12,450 --> 00:13:13,320
...هذا

177
00:13:14,320 --> 00:13:15,310
!سيّد رون

178
00:13:15,650 --> 00:13:19,410
لا تستنشق الدّخان، قد تصاب
.بتسمّم أحادي أكسيد الكربون

179
00:13:19,410 --> 00:13:23,100
استعمل هذا لتغطّي فمك
.وابق منخفضًا قدر الإمكان

180
00:13:23,650 --> 00:13:25,000
.حسنًا

181
00:13:25,000 --> 00:13:27,040
.استعملي أنت هذا

182
00:13:27,040 --> 00:13:28,390
.لديّ منديل خاصّ بي

183
00:13:30,010 --> 00:13:32,060
ما الّذي يحدث هنا؟

184
00:13:32,490 --> 00:13:35,580
!حاولوا ألاّ تستنشقوا الدّخان
!وابقوا منخفضين قدر الإمكان

185
00:13:37,150 --> 00:13:38,830
!ليشرح لي أحد ما يحدث

186
00:13:39,170 --> 00:13:40,750
!جميعنا في خطر

187
00:13:40,750 --> 00:13:44,080
غطّوا أفواهكم بمناديل رجاءً
!وابقوا منخفضين واتبعوني

188
00:13:44,080 --> 00:13:48,430
من تكونين لإملاء الأوامر عليّ؟

189
00:13:48,430 --> 00:13:51,540
!وتطلبين منّا التّصرّف بهذه الطّريقة البشعة

190
00:13:52,500 --> 00:13:57,340
!يحتوي هذا الدّخان على موادّ مؤذية
—لذلك أطلب منكم رجاءً

191
00:13:57,340 --> 00:13:58,530
!اخرسي

192
00:13:58,530 --> 00:14:00,650
!لن آخذ الأوامر من أمثالك

193
00:14:00,650 --> 00:14:03,770
،إن كانت النّار قد بدأت في الأسفل
.فليس من المحتمل أن تصل إلى هنا

194
00:14:03,770 --> 00:14:05,870
!علينا انتظار الإنقاذ فحسب

195
00:14:05,870 --> 00:14:08,640
!لا يمكن! علينا الهرب في أسرع وقت ممكن

196
00:14:08,640 --> 00:14:11,330
مهلاً! أين ذهب خادمي؟

197
00:14:11,330 --> 00:14:13,330
!إنّه يتجاهل واجباته بالكامل

198
00:14:19,310 --> 00:14:22,090
!هذا خطير يا سيّد رون
!أبق رأسك منخفضًا رجاءً

199
00:14:22,090 --> 00:14:23,920
ومن تكون يا هذا؟

200
00:14:23,920 --> 00:14:25,830
ألا تعرف من نكون؟

201
00:14:26,750 --> 00:14:30,340
أهكذا يتصرّف نبلاء الإمبراطوريّة الشّرفاء؟

202
00:14:37,870 --> 00:14:40,600
.لا يسعني سوى الشّعور بالاندهاش

203
00:14:40,600 --> 00:14:43,320
.إنّ لديه هيبة العائلة الإمبراطوريّة

204
00:14:43,830 --> 00:14:46,990
.بُني هذا المسرح خلال حُكم الإمبراطور السّابق

205
00:14:47,730 --> 00:14:49,640
،وبموادّ البناء الجافّة هذه

206
00:14:49,640 --> 00:14:53,310
فإنّ ألسنة لهب بهذه الحدّة
.ستصل إلى هنا في وقت وجيز

207
00:14:53,310 --> 00:14:55,440
ماذا نفعل إذًا؟

208
00:14:55,440 --> 00:14:58,680
،إن كنتم تريدون المغادرة أحياء
.فلا تتنفّسوا الدّخان

209
00:14:59,490 --> 00:15:00,590
...أليس كذلك

210
00:15:00,590 --> 00:15:01,530
يا روز؟

211
00:15:01,530 --> 00:15:02,820
!نعم

212
00:15:02,820 --> 00:15:07,190
،بصفتكم نبلاء الإمبراطوريّة
...يجب أن تُكرّسَ حياتكم لأجل البلاد

213
00:15:07,190 --> 00:15:09,070
.أو واجب النّبالة

214
00:15:10,060 --> 00:15:12,720
.لكن لتكن الأولويّة الآن للنّجاة

215
00:15:13,140 --> 00:15:14,240
!حاضر

216
00:15:14,240 --> 00:15:15,730
.كما تأمر

217
00:15:16,930 --> 00:15:19,230
.تندلع النّيران قرب المسرح

218
00:15:19,530 --> 00:15:23,170
ذلك الدّرج أمامنا يقودنا
.إلى الاتّجاه المعاكس للمسرح

219
00:15:23,900 --> 00:15:25,470
.يجدر بنا أن نخلي المكان من هناك

220
00:15:28,770 --> 00:15:31,720
!اتبعوني! احرصوا ألاّ تنفصلوا عن بعض

221
00:15:31,720 --> 00:15:32,740
.هيّا بنا

222
00:15:37,340 --> 00:15:40,260
.لا داعي للقلق. أقسم أنّي سأحميكم جميعًا

223
00:15:40,910 --> 00:15:41,940
!نعم

224
00:15:46,490 --> 00:15:48,190
!كلّ واحدة على حدة! لا تتسارعوا

225
00:15:54,820 --> 00:15:56,520
.إنّه مجرّد علاج مؤقّت

226
00:15:56,520 --> 00:15:58,270
.شكرًا لك

227
00:15:58,270 --> 00:16:00,090
.بقي القليل فحسب. لنذهب

228
00:16:02,020 --> 00:16:03,680
.لم يبق سوانا

229
00:16:03,680 --> 00:16:04,920
.اسبقيني أوّلاً يا روز

230
00:16:05,450 --> 00:16:06,460
.حسنًا

231
00:16:10,810 --> 00:16:11,770
!روز

232
00:16:19,950 --> 00:16:21,810
روز، هل أنت بخير؟

233
00:16:22,300 --> 00:16:24,830
...نعم، لكنّ الدّرج

234
00:16:25,200 --> 00:16:26,850
.لنبحث عن طريق آخر

235
00:16:35,690 --> 00:16:36,850
أطفال؟

236
00:16:37,290 --> 00:16:40,230
—سأذهب لإلقاء نظرة. عليك أن

237
00:16:40,540 --> 00:16:41,470
!روز

238
00:16:47,120 --> 00:16:48,490
!هيّا بنا

239
00:16:51,200 --> 00:16:54,050
.يبدو أنّ التّهوّر يسري في عروقك

240
00:16:58,040 --> 00:16:59,220
.لننطلق

241
00:17:03,820 --> 00:17:05,860
يوجد ممرّ كهذا في القبو؟

242
00:17:08,230 --> 00:17:11,530
.يبدو أنّ الدّخان لم يصل إلى هنا بعد

243
00:17:14,020 --> 00:17:15,330
!أخي

244
00:17:15,330 --> 00:17:17,000
!لا تبكي! غادري بسرعة

245
00:17:17,340 --> 00:17:19,570
!هل أنت بخير؟ سنساعدك على الخروج

246
00:17:20,940 --> 00:17:24,170
!أنا بخير. أنقذ أختي رجاءً

247
00:17:24,170 --> 00:17:27,440
.يوجد مدخل تخزين هناك
!عليك أن تسرع

248
00:17:27,440 --> 00:17:30,730
!كلاّ! سأبقى هنا معك يا أخي

249
00:17:30,730 --> 00:17:32,980
!روز، خذي الفتاة واذهبا

250
00:17:33,350 --> 00:17:34,610
ماذا عنك؟

251
00:17:34,610 --> 00:17:37,270
.سأساعد هذا الفتى وأتبعكما

252
00:17:37,270 --> 00:17:38,110
!بسرعة

253
00:17:38,110 --> 00:17:39,360
...لكن

254
00:17:39,730 --> 00:17:41,920
...إنقاذ ولو حياة واحدة

255
00:17:42,380 --> 00:17:44,520
أليس هذا ما تؤمنين به؟

256
00:17:47,130 --> 00:17:49,600
،بصفتي شخصًا أعلى منزلة عن البقيّة

257
00:17:49,600 --> 00:17:52,130
.فمن واجبي حماية أرواح النّاس

258
00:17:52,610 --> 00:17:56,150
،وإن وُجدت حياة بإمكاني إنقاذها
.فسأفعل كلّ ما بوسعي

259
00:17:56,150 --> 00:17:58,000
...تعلّمتُ هذا

260
00:17:58,000 --> 00:17:59,110
.منك أنت

261
00:18:03,790 --> 00:18:08,270
!أرجوك... احرص على أن تتبعنا بكلّ تأكيد

262
00:18:08,590 --> 00:18:11,780
أكيد. جهّزي كلّ شيء رجاءً
.لعلاج الفتى وانتظري خروجنا

263
00:18:17,280 --> 00:18:19,030
!أخي

264
00:18:19,330 --> 00:18:22,390
!لا بأس! واثقة أنّ السّيّد رون سينقذه

265
00:18:36,010 --> 00:18:37,050
!شعرك

266
00:18:38,230 --> 00:18:40,810
.إذًا فقد بلغتُ حدود قدرتي على التّنكّر

267
00:18:42,070 --> 00:18:45,670
.لا تشغل بال بذلك
.لنركّز على إنقاذك فحسب الآن

268
00:19:01,740 --> 00:19:05,350
.استطعنا النّجاة من موت وشيك بفضلك

269
00:19:05,350 --> 00:19:07,820
كيف لنا أن نشكرك؟

270
00:19:08,540 --> 00:19:13,280
لا عليك، ما أنقذ حياتكم هو قدرتكم
.على اتّخاذ القرارات الحاسمة

271
00:19:13,670 --> 00:19:15,090
!المكان ينهار

272
00:19:15,730 --> 00:19:18,080
!هذا خطير! تراجعوا

273
00:19:18,360 --> 00:19:19,440
...سيّد رون

274
00:19:19,910 --> 00:19:22,600
!ليستدعِ أحد ما طبيبًا على الفور

275
00:19:22,600 --> 00:19:25,120
!هنالك من خرج عبر القبو

276
00:19:26,340 --> 00:19:27,660
!سيّد رون

277
00:19:28,390 --> 00:19:29,380
!روز

278
00:19:35,710 --> 00:19:38,690
!كنتُ قلقة بشدّة عليك

279
00:19:51,570 --> 00:19:53,880
!هل تأذّيت؟ سأعالجك في الحال

280
00:19:54,260 --> 00:19:56,960
.أنا بخير. وكذلك الفتى

281
00:19:58,890 --> 00:20:00,200
!أخي

282
00:20:00,200 --> 00:20:01,800
!لا داعي للبكاء الآن

283
00:20:02,860 --> 00:20:06,640
.كم سرّني هذا. يبدو أنّ الجميع خرجوا سالمين

284
00:20:07,540 --> 00:20:08,690
.هكذا إذًا

285
00:20:11,370 --> 00:20:13,000
أخي كريس؟

286
00:20:15,980 --> 00:20:18,900
،إن كان فرد من عائلتك هنا
.فعليك الذّهاب للمنزل معه

287
00:20:20,910 --> 00:20:21,910
سيّد رون؟

288
00:20:26,260 --> 00:20:27,110
ماذا؟

289
00:20:31,010 --> 00:20:32,420
!ليزي

290
00:20:38,170 --> 00:20:39,170
!آسف يا ليزي

291
00:20:39,600 --> 00:20:44,930
ضغطتُ عليك للخروج، وثمّ
!تورّطتِ في هذه الحادثة الفظيعة

292
00:20:46,060 --> 00:20:49,160
.لا داعي للاعتذار يا أخي كريس

293
00:20:49,160 --> 00:20:52,340
.كانت حادثة. لم يسعنا فعل أيّ شيء

294
00:20:52,340 --> 00:20:54,190
...صحيح، ولكن

295
00:20:54,920 --> 00:20:57,830
!كان يومك المميّز يا ليزي

296
00:20:58,630 --> 00:21:00,540
...أخي كريس

297
00:21:06,070 --> 00:21:08,220
.كان ما واجهناه فظيعًا

298
00:21:09,480 --> 00:21:11,940
.أنا مسرورة لأنّ الجميع بخير

299
00:21:12,450 --> 00:21:13,810
.والسّيّد رون أيضًا

300
00:21:30,490 --> 00:21:33,430
.لن أستطيع استعمال هذه لمدّة طويلة

301
00:21:34,550 --> 00:21:36,170
.لكنّي مسرور

302
00:21:37,790 --> 00:21:39,980
.المظهر الّذي تمنحه لي مجرّد كذبة

303
00:21:41,080 --> 00:21:44,550
.لا أستطيع لمسها بتنكّري الزّائف ذلك

304
00:21:47,940 --> 00:21:52,790
.كبرت إليز وصار لها حضور مهمّ جدًّا داخلي

305
00:21:54,630 --> 00:21:55,790
...لكن

306
00:21:56,700 --> 00:22:00,510
.لن تبتسم لي أبدًا

307
00:22:06,840 --> 00:22:09,930
لمهلة وجيزة