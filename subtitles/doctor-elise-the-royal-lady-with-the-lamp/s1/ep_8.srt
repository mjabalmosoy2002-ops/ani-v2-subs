1
00:00:05,280 --> 00:00:07,190
!لا أطيق الانتظار

2
00:00:07,190 --> 00:00:11,780
من كان يتخيّل أنّ اللّيدي إليز
!كانت تخفي قدرات مذهلة كهذه

3
00:00:11,780 --> 00:00:15,460
!أتطلّع قدمًا لرؤيتها
ألا توافقني أيّها الأستاذ غراهام؟

4
00:00:15,460 --> 00:00:16,490
.نعم

5
00:00:17,100 --> 00:00:22,000
إن كانت اللّيدي كلورنس
،قد قامت بذلك الإجراء فعلاً

6
00:00:22,790 --> 00:00:25,990
.فقد تمتلك قدرات مساوية لروز

7
00:00:31,070 --> 00:00:32,990
.لا بدّ أنّ النّعاس غلبني

8
00:00:33,950 --> 00:00:36,560
.أتساءل إن حملني ميل للفراش

9
00:00:39,400 --> 00:00:42,550
.أيّتها اللّيدي، هناك زائران أتيا لرؤيتك

10
00:00:43,750 --> 00:00:45,630
أهما أخواي؟

11
00:00:46,190 --> 00:00:47,350
!تفضّلا

12
00:00:51,310 --> 00:00:52,350
ماذا؟

13
00:00:53,130 --> 00:00:55,900
لماذا أنت هنا يا روز؟

14
00:00:56,790 --> 00:00:59,610
الطّبيب غراهام؟

15
00:01:02,170 --> 00:01:04,850
!لم أتخيّل أبدًا أن يُكشف أمري هكذا

16
00:01:04,850 --> 00:01:07,340
!لا يمكنني الخروج من هذا الوضع بأيّ تفسير

17
00:01:09,760 --> 00:01:13,630
أقدّم لكما أصدق اعتذاراتي
!بسبب إخفائي لهويّتي

18
00:01:14,450 --> 00:01:18,380
.أنا ابنة عائلة كلورنس واسمي إليز

19
00:01:18,940 --> 00:01:21,130
.إذًا فقد كانت أنت

20
00:01:21,500 --> 00:01:24,130
...شبّهتك بها في أوّل لقاء لنا بالفعل

21
00:01:24,130 --> 00:01:26,910
!لكنّي لم أتخيّل أبدًا أنّك هي في الحقيقة

22
00:01:31,980 --> 00:01:34,760
.لدينا أخبار جيّدة لك اليوم

23
00:01:36,380 --> 00:01:39,670
.أتينا إلى هنا بعد حّل سوء الفهم عند جلالته

24
00:01:39,670 --> 00:01:43,950
أخبرناه أنّ عمليّة ثقب القصبة الهوائيّة لم تكن
.تصرّفًا للتّقليل من احترام العائلة الإمبراطوريّة

25
00:01:43,950 --> 00:01:46,660
!بل إنّها إنجاز مذهل

26
00:01:49,010 --> 00:01:52,530
لماذا هذه التّعابير الحزينة؟

27
00:01:52,530 --> 00:01:56,880
تمّ الإعلان عن براءتك أيّتها اللّيدي
!وصار بإمكانك مغادرة هذا المكان

28
00:01:57,280 --> 00:01:59,660
.شكرًا لك

29
00:02:03,770 --> 00:02:05,720
...الطّبيب غراهام

30
00:02:05,720 --> 00:02:07,820
.لا بدّ أنّه مصدوم من هذا

31
00:03:45,990 --> 00:03:48,590
.لا توجد أيّ مشاكل في نبض قلبه

32
00:03:48,590 --> 00:03:51,490
.سنراقب تقدّمه ونقدّم له الأدوية

33
00:03:52,790 --> 00:03:57,250
أيّتها اللّيدي كلورنس، هل يوجد أيّ
شيء تجدينه مقلقًا في هذه الحالة؟

34
00:03:57,720 --> 00:04:00,120
!يحدّثني بشكل رسميّ؟

35
00:04:03,410 --> 00:04:06,300
.إليك تقرير المريض السّابق

36
00:04:06,300 --> 00:04:07,660
.شكرًا لك

37
00:04:08,370 --> 00:04:12,510
يمكنك الحديث معي بحرّيّة
.أكثر كما كنت تفعل في السّابق

38
00:04:12,830 --> 00:04:17,260
.لا. إنّ مكانتينا مختلفتين أيّتها اللّيدي

39
00:04:21,700 --> 00:04:26,040
هل يُعقل أنّه غاضب منّي
بسبب إخفائي لهويّتي؟

40
00:04:39,800 --> 00:04:42,310
...أودّ شرح وضعي له، لكن

41
00:04:43,670 --> 00:04:46,400
.نعم! هذا مفهوم. شكرًا لك

42
00:04:46,400 --> 00:04:49,330
جيّد. مواصلة العلاج في الوقت
.الحاليّ هي أهمّ شيء الآن

43
00:04:49,330 --> 00:04:52,370
هذا مفهوم. سأقوم بذلك
.إلى جانب مراقبته أيضًا

44
00:04:50,370 --> 00:04:56,320
إنّ الطّبيب غراهام هو الوحيد هنا
.الّذي يعرف أنّي من عائلة كلورنس

45
00:04:52,370 --> 00:04:55,210
أنا مسرور لأنّي استشرتك في هذه
!الحالة أيّها الطّبيب غراهام

46
00:05:01,600 --> 00:05:02,500
!روز

47
00:05:03,370 --> 00:05:05,070
!أتطلّع قدمًا للعمل معك

48
00:05:05,070 --> 00:05:05,960
ماذا؟

49
00:05:05,960 --> 00:05:07,900
ماذا؟ ألم تسمعي؟

50
00:05:07,900 --> 00:05:10,670
،غادر الطّبيب غراهام العمل هذا الصّباح

51
00:05:10,670 --> 00:05:13,220
.لذلك سترافقينني في فحوصات هذه الظّهيرة

52
00:05:13,220 --> 00:05:14,840
.فهمت

53
00:05:14,840 --> 00:05:16,370
!حسنًا، إلى اللّقاء

54
00:05:19,940 --> 00:05:23,460
.أعتقد أنّي سأتحدّث مع الطّبيب غراهام غدًا إذًا

55
00:05:24,870 --> 00:05:26,180
.المعذرة

56
00:05:26,180 --> 00:05:29,380
هل رأيت الطّبيب غراهام؟

57
00:05:29,380 --> 00:05:32,230
.بما أنّك ذكرت هذا، فلا أظنّني رأيته إطلاقًا

58
00:05:32,550 --> 00:05:34,200
.ربّما لم يحضر اليوم

59
00:05:47,170 --> 00:05:49,850
.إنّه لم يحضر اليوم أيضًا

60
00:05:52,090 --> 00:05:54,920
...عفوًا، هل الطّبيب غراهام

61
00:05:57,050 --> 00:06:00,020
.سمعتُ أنّه قدّم طلب إجازة

62
00:06:00,020 --> 00:06:02,210
.يُقال أنّه سيغيب عن العمل لمدّة

63
00:06:02,880 --> 00:06:04,700
.فهمت

64
00:06:05,050 --> 00:06:07,910
.لكنّ هذا غير عاديّ

65
00:06:07,910 --> 00:06:11,190
إنّه لم يقم بذلك لحضور مؤتمر
.أكاديميّ أو ما شابه

66
00:06:11,190 --> 00:06:14,720
،وفي صباح اليوم الّذي ترك فيه العمل

67
00:06:14,720 --> 00:06:17,110
.كان يتصرّف بغرابة بعض الشّيء

68
00:06:17,110 --> 00:06:18,100
ماذا؟

69
00:06:18,420 --> 00:06:21,980
تعلّمت الكثير من القيام
،بالفحوصات معك يا روز

70
00:06:21,980 --> 00:06:25,910
ولكن عندما تمرّ كلّ هذه الأيّام بدون
...توبيخٍ من الطّبيب غراهام

71
00:06:25,910 --> 00:06:29,620
.أفقد الدّافع نوعًا ما

72
00:06:30,100 --> 00:06:32,210
.أتساءل ما الّذي يحدث معه

73
00:06:32,620 --> 00:06:34,870
هل تعتقدين أنّه حدث شيء ما؟

74
00:06:35,330 --> 00:06:37,760
!واثقة أنّها غلطتي أنا

75
00:06:44,680 --> 00:06:45,950
.شكرًا لك

76
00:06:58,960 --> 00:07:00,310
نعم؟

77
00:07:00,310 --> 00:07:03,890
.أنا تلميذة للطّبيب غراهام
.اسمي روز

78
00:07:03,890 --> 00:07:06,360
.أتيت لأنّي أرغب في مقابلته

79
00:07:06,360 --> 00:07:08,290
!حسنًا. مرحبًا بك

80
00:07:08,580 --> 00:07:11,140
.أنا المربّية يودِل

81
00:07:11,140 --> 00:07:13,250
.تفضّلي بالدّخول رجاءً

82
00:07:13,250 --> 00:07:15,770
.حسنًا. شكرًا جزيلاً لك

83
00:07:21,430 --> 00:07:23,780
!لديه العديد من الكتب الطّبّيّة

84
00:07:24,510 --> 00:07:26,800
.وقُرأت جميعها مرّات عدّة

85
00:07:27,120 --> 00:07:31,000
واضح لي من كلّ واحد منها
.كم عمِل الطّبيب غراهام بجدّ

86
00:07:31,000 --> 00:07:33,690
،آنسة روز

87
00:07:33,690 --> 00:07:35,810
.تفضّلي بعض الشّاي رجاءً

88
00:07:35,810 --> 00:07:37,310
!شكرًا لك

89
00:07:42,800 --> 00:07:45,800
،حاولت استدعاء السّيّد الصّغير للنّزول

90
00:07:45,800 --> 00:07:48,490
.لكنّه يأبى مغادرة غرفته

91
00:07:48,490 --> 00:07:49,680
.فهمت

92
00:07:50,050 --> 00:07:52,520
.لقد أغلق على نفسه هناك لأيّام الآن

93
00:07:54,470 --> 00:07:57,120
.يحدث هذا الأمر من وقت لآخر

94
00:07:57,960 --> 00:08:00,890
لقد تغيّب عن المستشفى لعدّة
.أيّام على التّوالي الآن

95
00:08:00,890 --> 00:08:04,080
لا يسبّب ذلك أيّ مشاكل للآخرين، صحيح؟

96
00:08:04,080 --> 00:08:07,720
.لقد سبق وقدّم إذنًا بهذا
.لذلك فكلّ شيء بخير

97
00:08:08,020 --> 00:08:09,920
.لا بأس بهذا إذًا

98
00:08:09,920 --> 00:08:14,380
صحيح! كم أودّ معرفة كيف
!هو السّيّد الصّغير في المستشفى

99
00:08:14,380 --> 00:08:16,210
هلاّ أخبرتني رجاءً؟

100
00:08:16,690 --> 00:08:20,820
كيف يقضي وقته؟
وما الأشياء الّتي تحدث له هناك؟

101
00:08:20,820 --> 00:08:24,220
.إنّه لا يخبرني بأيّ شيء

102
00:08:24,580 --> 00:08:27,470
.يقدّر الجميعُ الطّبيبَ غراهام

103
00:08:27,470 --> 00:08:28,740
فعلاً؟

104
00:08:29,180 --> 00:08:32,190
،نعم. تكون توجيهاته مضبوطة دائمًا

105
00:08:32,190 --> 00:08:34,230
لذلك عندما يواجه الأطبّاء
،المتدرّبون أيّ مشاكل

106
00:08:34,230 --> 00:08:38,390
يلجؤون دائمًا لطلب النّصيحة
!من الطّبيب غراهام أوّلاً

107
00:08:40,510 --> 00:08:43,000
.يعتمد عليه الجميع بشكل كبير

108
00:08:43,000 --> 00:08:46,240
.سرّني سماع هذا

109
00:08:47,700 --> 00:08:49,390
...في الماضي

110
00:08:52,010 --> 00:08:55,240
.كان يبكي دون توقّف كلّ ليلة

111
00:08:55,240 --> 00:08:57,930
.كان من الصّعب مساعدته على النّوم

112
00:08:58,450 --> 00:09:00,690
أكان الطّبيب غراهام هكذا؟

113
00:09:00,690 --> 00:09:03,890
.لا يمكنني تخيّل ذلك أبدًا بالنّظر إليه الآن

114
00:09:05,040 --> 00:09:10,240
وها قد صار نفس ذلك السيّد
.الصّغير شخصًا يعتمد عليه الجميع

115
00:09:10,240 --> 00:09:13,270
يا إلهي! نسيت إحضار وجبات
.خفيفة لتناولها مع الشّاي

116
00:09:13,850 --> 00:09:15,400
.سأذهب لإحضار بعضها

117
00:09:15,400 --> 00:09:16,180
.هذا مؤلم

118
00:09:16,180 --> 00:09:17,280
هل أنت بخير؟

119
00:09:17,880 --> 00:09:21,580
نعم. تقدّم بي العمر، لذلك أشعر
.بآلام في أجزاء من جسمي

120
00:09:32,460 --> 00:09:34,200
ما الخطب؟

121
00:09:34,200 --> 00:09:35,800
.هذا لا شيء

122
00:09:38,350 --> 00:09:39,670
!أيّها الطّبيب غراهام

123
00:09:40,240 --> 00:09:43,160
!أيّها الطّبيب! أيّها الطّبيب غراهام

124
00:09:45,530 --> 00:09:47,180
ما هذه الجلبة؟

125
00:09:50,910 --> 00:09:52,680
...أيّها الطّبيب غراهام

126
00:09:53,760 --> 00:09:54,970
!يودِل

127
00:10:00,410 --> 00:10:02,050
ما الّذي حدث لها؟

128
00:10:02,050 --> 00:10:04,470
!كنّا نتكلّم، ثمّ انهارت فجأة

129
00:10:05,660 --> 00:10:07,020
هل تشعرين بألم ما؟

130
00:10:10,650 --> 00:10:13,200
.أظهرت علامات على آلام باطنيّة

131
00:10:23,990 --> 00:10:25,040
ما الأمر؟

132
00:10:25,040 --> 00:10:26,880
.هناك انتفاخ في المغبن

133
00:10:28,980 --> 00:10:30,120
فتق داخليّ؟

134
00:10:31,220 --> 00:10:33,100
.إنّه صلب ويصعب دفعه للدّاخل

135
00:10:34,010 --> 00:10:36,320
.فتق مغبنيّ محاصر

136
00:10:37,530 --> 00:10:41,320
نظرًا للأعراض، ربما يكون نخر
.الأمعاء قد بدأ بالفعل

137
00:10:42,430 --> 00:10:44,630
،إن لم نعالجها في الحال

138
00:10:44,630 --> 00:10:47,330
فسيسبّب ذلك انثقاب الأمعاء
.والتهاب بطانة البطن

139
00:10:47,330 --> 00:10:49,150
!قد يضع ذلك حياتها في خطر

140
00:10:49,620 --> 00:10:52,110
!سيّدي... الصّغير

141
00:10:55,640 --> 00:10:57,140
.أنا آسف

142
00:10:57,140 --> 00:10:58,950
.حدث كلّ هذا لأنّي كنت غائبًا

143
00:10:59,630 --> 00:11:00,620
.روز

144
00:11:00,620 --> 00:11:01,380
نعم؟

145
00:11:01,380 --> 00:11:03,910
سأجري العمليّة في الحال
.بمجرّد وصولنا للمستشفى

146
00:11:03,910 --> 00:11:04,850
.ساعديني رجاءً

147
00:11:04,850 --> 00:11:05,500
!حاضرة

148
00:11:07,110 --> 00:11:09,020
!استدر عند الشّارع التّالي

149
00:11:09,020 --> 00:11:10,440
!سنصل أسرع هكذا

150
00:11:10,440 --> 00:11:11,170
!حاضر

151
00:11:18,770 --> 00:11:23,070
.سنبدأ الآن الجراحة لإصلاح الفتق المغبنيّ

152
00:11:23,070 --> 00:11:23,870
.مشرط

153
00:11:23,870 --> 00:11:24,400
.تفضّل

154
00:11:32,890 --> 00:11:33,950
.ملقط

155
00:11:36,900 --> 00:11:37,780
.تفضّل

156
00:11:48,090 --> 00:11:49,250
.شاش

157
00:11:50,970 --> 00:11:51,730
.تفضّل

158
00:11:53,630 --> 00:11:55,000
.سأنقذك

159
00:11:56,120 --> 00:11:57,360
!بقي القليل فحسب

160
00:12:02,650 --> 00:12:04,100
.أنهيت خياطة الجرح

161
00:12:11,130 --> 00:12:13,770
.انتهيتُ بدون أيّ مشاكل. شكرًا لك

162
00:12:13,770 --> 00:12:14,240
.العفو

163
00:12:15,660 --> 00:12:18,520
.أنا متعب. علينا أن نرتاح قليلاً

164
00:12:18,520 --> 00:12:22,520
.حسنًا، سأتكفّل بكتابة تقرير العمليّة

165
00:12:25,660 --> 00:12:29,130
بعد القيام بشقّ في القسم
،العلويّ من الفتق

166
00:12:29,130 --> 00:12:33,500
بحثنا عن تغيّر في لون الأمعاء
.وراقبنا تدفّق الدّم

167
00:12:41,610 --> 00:12:42,940
.سأكتبه أنا

168
00:12:42,940 --> 00:12:43,620
ماذا؟

169
00:12:53,020 --> 00:12:56,390
بالمناسبة، ما الّذي أتى بك إلى منزلي اليوم؟

170
00:12:56,870 --> 00:12:58,780
.ذهبتُ للاعتذار منك

171
00:12:59,130 --> 00:13:02,480
.غضبتَ لأنّي أخفيت عنك هويّتي

172
00:13:02,480 --> 00:13:05,300
ولذلك السّبب طلبت المغادرة
من العمل لبعضة أيّام، صحيح؟

173
00:13:06,520 --> 00:13:07,560
غضبت؟

174
00:13:07,910 --> 00:13:09,100
.نعم

175
00:13:09,100 --> 00:13:11,460
...في مكتبك، كانت

176
00:13:11,460 --> 00:13:15,550
حواجبك هكذا وتنهّدت كثيرًا، أليس كذلك؟

177
00:13:15,550 --> 00:13:16,900
تنهّدت؟

178
00:13:17,420 --> 00:13:18,810
.صحيح

179
00:13:19,220 --> 00:13:20,560
...ذلك لأنّي

180
00:13:21,100 --> 00:13:23,460
.كنتُ متفاجئًا من خطّ يدك فحسب

181
00:13:23,790 --> 00:13:27,060
إنّه سيّئ جدًّا لدرجة أنّه يأخذ
.وقتًا طويلاً لقراءته

182
00:13:28,450 --> 00:13:30,980
.هكذا هو الأمر إذًا

183
00:13:30,980 --> 00:13:33,360
أيّ نوع من سوء الفهم هذا؟

184
00:13:33,360 --> 00:13:36,470
أردتُ التّركيز على بحثي، لذلك
.أخذت إجازة من العمل لا غير

185
00:13:37,940 --> 00:13:39,970
.أنت من دفعني للقيام بهذا

186
00:13:40,710 --> 00:13:41,840
أنا؟

187
00:13:41,840 --> 00:13:42,680
.نعم

188
00:13:43,200 --> 00:13:45,400
أنت تعملين بجدّ دائمًا، صحيح؟

189
00:13:46,650 --> 00:13:49,520
أتذكرين جناح المستشفى
الّذي أخذتك إليه أوّل مرّة؟

190
00:13:50,320 --> 00:13:54,470
يُقال أنّه من أقسى الأماكن
.حتّى هنا داخل المستشفى

191
00:13:55,190 --> 00:13:59,220
ظننتُ أنّك ستهربين في الحال
،عندما ترين الحالة القذرة للمكان

192
00:14:00,010 --> 00:14:01,640
.لكنّك لم تفعلي

193
00:14:03,210 --> 00:14:05,860
أخفيت هويّتك بينما هدفتِ
...لتصيري طبيبة

194
00:14:06,150 --> 00:14:08,500
...درستِ وحدك لتعلّم العلوم الطّبّيّة

195
00:14:08,500 --> 00:14:10,320
.كلاهما طريقان ليسا سهلين أبدًا

196
00:14:10,750 --> 00:14:13,240
.أريد تعلّم قوّة الإرادة تلك منك

197
00:14:13,690 --> 00:14:15,770
.لستُ كذلك على الإطلاق

198
00:14:15,770 --> 00:14:17,370
.كما أنّ مهاراتك ممتازة أيضًا

199
00:14:17,370 --> 00:14:18,320
ماذا؟

200
00:14:19,280 --> 00:14:21,870
...علاجك لمريض استرواح الصّدر الضّاغط

201
00:14:22,930 --> 00:14:24,420
...وعمليّة استئصال الطّحال

202
00:14:26,650 --> 00:14:28,950
حتّى ثقب القصبة الهوائيّة الّتي
...أجريتِها ذلك اليوم

203
00:14:28,950 --> 00:14:30,830
.كانت كلّها ممكنة لأنّك من أجراها

204
00:14:31,690 --> 00:14:33,330
.لستُ قادرًا على ذلك

205
00:14:33,330 --> 00:14:35,500
،درستُ كثيرًا في الأكاديميّة

206
00:14:35,500 --> 00:14:38,110
،قرأت كلّ النّصوص الطّبّيّة مرارًا وتكرارًا
.ولكن ما زلت أعجز عن ذلك

207
00:14:38,760 --> 00:14:41,370
،يقول النّاس من حولي أنّ لديّ موهبة

208
00:14:41,980 --> 00:14:44,870
لكنّي لا أختلف عن أيّ شخص
.آخر عاديّ يعمل بكلّ جهده

209
00:14:45,650 --> 00:14:48,620
.لكنّك تملكين موهبة وُلدتِ بها

210
00:14:49,520 --> 00:14:51,590
.بصراحة، أنا أشعر بالغيرة

211
00:14:52,200 --> 00:14:55,120
...أظنّ أنّ المشاعر الّتي أشعر بها تجاهك

212
00:14:55,760 --> 00:14:57,860
.هي الحسد والاحترام

213
00:14:59,780 --> 00:15:01,520
.أنا واثق أنّي أشعر بكليهما

214
00:15:05,690 --> 00:15:09,130
لماذا قرّرت أن تصير طبيبًا؟

215
00:15:12,170 --> 00:15:14,160
.لأنّي فقدت عائلتي

216
00:15:14,900 --> 00:15:15,650
ماذا؟

217
00:15:16,730 --> 00:15:18,160
.قبل عشرين سنة

218
00:15:20,320 --> 00:15:25,240
.كان لديّ والدان، وأخ وأخت أكبر منّي

219
00:15:25,240 --> 00:15:29,390
.إضافة إلى أخ أصغر ظريف للغاية

220
00:15:30,560 --> 00:15:32,660
!انظري يا أمّي

221
00:15:34,420 --> 00:15:36,480
.إنّها ورقة نفل السّعادة

222
00:15:45,270 --> 00:15:47,850
!أبي! هناك الكثير من الدّلافين

223
00:15:54,530 --> 00:15:57,800
.كان كلّ يوم مرّ علينا يومًا سعيدًا

224
00:16:05,040 --> 00:16:06,110
...لكن

225
00:16:06,950 --> 00:16:09,320
!لا تأخذوهم بعيدًا

226
00:16:09,320 --> 00:16:10,940
!توقّف يا سيّدي الصّغير

227
00:16:11,340 --> 00:16:15,990
مائة وخمسون ألف شخص
.ماتوا في جائحة لوريج

228
00:16:15,990 --> 00:16:17,930
.أصيبت عائلتي بالعدوى أيضًا

229
00:16:23,620 --> 00:16:24,960
...وعندما كانوا على شفير الموت

230
00:16:26,080 --> 00:16:28,470
.لم أستطع حتّى التّواجد إلى جانبهم

231
00:16:38,480 --> 00:16:40,500
ما الّذي سيفعله السّيّد الصّغير؟

232
00:16:40,500 --> 00:16:45,220
لا يوجد علاج للمرض، وعلينا نحن
.أن نفكّر كيف سنجني قوت يومنا

233
00:16:48,390 --> 00:16:52,600
.سرق المرض كلّ شيء عزيز عليّ

234
00:16:59,300 --> 00:17:01,230
.كنتُ نبيلاً مُدمَّرًا

235
00:17:01,740 --> 00:17:04,280
...الشّخص الوحيد الّذي ظلّ إلى جانبي

236
00:17:04,950 --> 00:17:06,260
.كانت يودِل

237
00:17:07,760 --> 00:17:11,870
.كانت كفرد من عائلتي

238
00:17:14,310 --> 00:17:18,750
.مرضت يودِل في إحدى المرّات

239
00:17:24,660 --> 00:17:26,290
...وحينها راودتني الفكرة

240
00:17:27,420 --> 00:17:31,790
لم أكن سأسمح للمرض بأن يسلبني
.شخصًا آخر عزيزًا عليّ ثانية

241
00:17:32,550 --> 00:17:36,310
موت عائلتي، ووجود شخص
...ما مهمّ عندي

242
00:17:37,240 --> 00:17:40,030
.هما ما منحاني العزيمة لأصير طبيبًا

243
00:17:44,260 --> 00:17:45,560
.أيّها الطّبيب

244
00:17:45,560 --> 00:17:46,290
ماذا؟

245
00:17:47,140 --> 00:17:50,180
.إنّني أقدّر عملك الدّؤوب تقديرًا كبيرًا

246
00:17:53,130 --> 00:17:54,270
.شكرًا لك

247
00:18:00,820 --> 00:18:02,310
!كم هذا جميل

248
00:18:21,920 --> 00:18:24,190
...صحيح! أيّها الطّبيب غراهام

249
00:18:25,470 --> 00:18:29,720
.نادني روز وليس اللّيدي كلورنس لو سمحت

250
00:18:29,720 --> 00:18:32,490
!أنا تلميذتك قبل كلّ شيء

251
00:18:32,490 --> 00:18:34,330
.حسنًا

252
00:18:46,010 --> 00:18:47,920
لماذا أشعر بالإحراج؟

253
00:19:01,080 --> 00:19:04,190
!ليزي

254
00:19:04,190 --> 00:19:08,200
تهانيّ! ستتمّ مكافأتك بوسام
!الوردة الإمبراطوريّة

255
00:19:08,200 --> 00:19:09,230
ماذا؟

256
00:19:10,030 --> 00:19:12,280
وسام الوردة الإمبراطوريّة؟

257
00:19:13,220 --> 00:19:15,740
!هذا ليس وقتًا مناسبًا للوقوف مذهولة

258
00:19:15,740 --> 00:19:18,470
تمّ القبول بعمليّة ثقب الحنجرة
!والاعتراف بها أيضًا

259
00:19:18,470 --> 00:19:21,620
!لا أصدّق أنّك ستُكافئين بلقب مرموق كهذا

260
00:19:21,620 --> 00:19:23,390
.لا أستطيع التّنفّس

261
00:19:31,570 --> 00:19:32,770
سيّدي الصّغير؟

262
00:19:33,210 --> 00:19:34,780
هل تشعرين بأيّ ألم؟

263
00:19:35,220 --> 00:19:40,490
.لا. أنا جدّ آسفة لأنّني أقلقتك

264
00:19:41,440 --> 00:19:43,810
.إنّه خطئي لأنّني لم ألاحظ

265
00:19:44,370 --> 00:19:47,230
.لكن عليك إخباري عندما تشعرين بتوعّك

266
00:19:47,740 --> 00:19:48,510
.حسنًا

267
00:19:49,590 --> 00:19:51,370
.نحن عائلة

268
00:19:53,040 --> 00:19:54,120
!نعم

269
00:19:58,480 --> 00:20:00,070
ما الّذي تفعله؟

270
00:20:04,350 --> 00:20:07,230
.أنا مسرور بعودتي للرّوتين المعتاد

271
00:20:07,230 --> 00:20:08,130
ماذا؟

272
00:20:08,470 --> 00:20:11,140
،لم أتلقّ أيّ توبيخ منك لبضعة أيّام

273
00:20:11,140 --> 00:20:13,140
.لذلك لم يبدُ أيّ شيء على حاله لي

274
00:20:13,440 --> 00:20:14,890
ما الّذي يفترض أن يعنيه هذا؟

275
00:20:15,440 --> 00:20:16,380
!ها أنت

276
00:20:17,900 --> 00:20:19,080
!تعالوا

277
00:20:19,750 --> 00:20:22,460
أيّها الطّبيب، هناك أمر أردت
.استشارتك بخصوصه

278
00:20:22,460 --> 00:20:24,290
هلاّ أتيت للمكتب معنا؟

279
00:20:24,690 --> 00:20:25,480
.حسنًا

280
00:20:26,020 --> 00:20:27,750
.سأمرّ عليك لاحقًا

281
00:20:27,750 --> 00:20:29,150
.حاضرة يا سيّدي الصّغير

282
00:20:29,150 --> 00:20:31,060
!أسرع أيّها الطّبيب

283
00:20:31,060 --> 00:20:32,170
.أنا قادم

284
00:20:33,920 --> 00:20:35,030
أليس هذا رائعًا؟

285
00:20:35,030 --> 00:20:37,560
نعم. أردتُ نصيحة الطّبيب غراهام
.بشأن هذا بشدّة

286
00:22:06,920 --> 00:22:09,970
أيّام مضت