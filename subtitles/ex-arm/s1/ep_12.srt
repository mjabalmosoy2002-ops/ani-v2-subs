!هيّا بنا

193
00:12:37,020 --> 00:12:40,700
هذا أقصى ارتفاع لمسار الصواريخ
الباليستيّة العابرة للقارّات

194
00:12:40,700 --> 00:12:42,220
هناك يا أكيرا-سان

195
00:12:42,220 --> 00:12:43,740
ها هي

196
00:12:43,740 --> 00:12:45,360
أيوجد شيءٌ يمكننا استعماله؟

197
00:12:51,620 --> 00:12:53,660
!وجدتُه! ها هو

198
00:12:53,660 --> 00:12:56,120
قمر الليزر الاصطناعيّ للجيش اليابانيّ؟

199
00:12:56,120 --> 00:12:57,620
!سأستعمله

200
00:12:59,170 --> 00:13:01,130
!الصواريخ تقترب

201
00:13:01,130 --> 00:13:03,050
!إطلاق

202
00:13:07,760 --> 00:13:09,120
!نجحت

203
00:13:10,440 --> 00:13:12,670
كلا، ليس بعد

204
00:13:12,670 --> 00:13:14,810
...الأسلحة في أرجاء العالم

205
00:13:15,180 --> 00:13:17,400
!تخرج عن السيطرة

206
00:13:19,900 --> 00:13:24,970
كلّ الأسلحة ذاتيّة العمل حول العالم
تتحرّك من تلقاء نفسها

207
00:13:24,970 --> 00:13:28,910
الدبّابات وقاذفات القنابل وحتّى الصواريخ الباليستيّة

208
00:13:29,380 --> 00:13:32,250
كلّها تحت سيطرة تلك الوحوش

209
00:13:32,250 --> 00:13:35,410
تبّاً! ما تلك الأشياء بالضبط؟

210
00:13:36,000 --> 00:13:38,330
رأيتُ أعيناً كتلك قبلاً

211
00:13:40,240 --> 00:13:42,920
كانت لدى كلّ المجرمين وضحاياهم الذين
التقيناهم حتّى الآن

212
00:13:43,530 --> 00:13:47,320
النظرة الجوفاء التي ترتسم عليك عندما
تسقط في أعماق الكراهية واليأس

213
00:13:49,720 --> 00:13:52,640
...لذا إذا كنتُ سأسمّيها

214
00:13:53,090 --> 00:13:55,480
الشرّ البشريّ؟

215
00:13:56,050 --> 00:13:57,360
صحيح

216
00:13:57,360 --> 00:14:02,380
تلك الوحوش مصنوعة من البرامج التكتيكيّة
المثبّتة على الخادم الرئيسيّ

217
00:14:02,380 --> 00:14:04,080
متضمّنةً تاريخ الحروب

218
00:14:04,080 --> 00:14:07,020
وذكريات لخوف البشر وكراهيّتهم

219
00:14:07,020 --> 00:14:09,640
أخذت هيئة فصيلة تزدهر

220
00:14:09,640 --> 00:14:13,800
بقتل الطبيعة والحيوانات، وحتّى البشر

221
00:14:13,800 --> 00:14:17,040
يمكنك اعتبارها البشرية عينها

222
00:14:17,040 --> 00:14:22,650
يمكن للـ "إكس-آرم" بحوزة ناتسومي أكيرا
تضخيم الرغبات البشريّة

223
00:14:22,650 --> 00:14:26,260
فبالتالي يمكنها تضخيم الشرّ أيضاً

224
00:14:26,260 --> 00:14:30,120
كلا، نسيتِ شيئاً هاماً

225
00:14:31,750 --> 00:14:34,780
،إذا كان بمقدور الـ "إكس-آرم" تضخيم الرغبات البشريّة

226
00:14:34,780 --> 00:14:39,100
فستستطيع أيضاً تضخيم خير البشر
!وحسّهم بالعدالة، وحتّى حبّهم

227
00:14:40,760 --> 00:14:42,220
ربما ذلك

228
00:14:42,220 --> 00:14:46,440
لكن شرّ الناس ليس شيئاً
يمكن هزيمته بسهولة

229
00:14:53,030 --> 00:14:54,340
أوني-ساما؟

230
00:14:54,880 --> 00:14:59,370
عليكما الانفصال من الشبكة، سأتولّى الباقي

231
00:14:59,370 --> 00:15:00,920
أوني-ساما؟

232
00:15:00,920 --> 00:15:02,880
ألديك خطّة ما؟

233
00:15:02,880 --> 00:15:04,350
كلا

234
00:15:04,350 --> 00:15:11,950
عليّ التوجّه لكلّ خادم وسلاح سيطرت عليه وأقوم بتدميرها

235
00:15:11,950 --> 00:15:15,440
لا يمكنني أن أعرّض نفسي لخطر التأخّر الشبكيّ
الذي سينتج من مشاركة المعلومات معكما

236
00:15:15,440 --> 00:15:17,400
عليّ فعلها بمفردي

237
00:15:17,400 --> 00:15:22,620
فهمنا، سأغلق واجهتي الشخصيّة إذاً

238
00:15:22,620 --> 00:15:27,780
اتّصل بجسدي مباشرةً واستعمله كمصدرٍ إضافيّ

239
00:15:28,210 --> 00:15:30,330
سيتخلّص ذلك من التأخّر الشبكيّ

240
00:15:30,330 --> 00:15:31,450
آلما؟

241
00:15:32,740 --> 00:15:36,280
سأعطيك كلّ شيءٍ لديّ

242
00:15:37,920 --> 00:15:40,800
استعملني أيضاً يا أوني-ساما

243
00:15:40,800 --> 00:15:44,250
سأعطيك كل مصادر إغدراسيل

244
00:15:45,170 --> 00:15:47,670
...انتظرا! إذا فعلتما ذلك

245
00:15:48,140 --> 00:15:52,920
أمّي، صُنعنا لخدمة البشر

246
00:15:53,470 --> 00:15:57,470
أظنّ الوقت قد حان
للوفاء بدورنا الآن

247
00:15:57,960 --> 00:16:00,090
اسمحي لهما رجاءً

248
00:16:01,600 --> 00:16:03,050
...أنتم

249
00:16:03,050 --> 00:16:05,440
تمكّنا من إخلاء الجميع

250
00:16:06,150 --> 00:16:09,530
لم يعد بإمكاننا فعل شيءٍ على الأرجح

251
00:16:09,530 --> 00:16:12,440
سأترك المستقبل على عاتقيّ أكيرا وعاتقيهما

252
00:16:12,860 --> 00:16:17,280
العالم في أيديكم يا أكيرا، آلما، إغ

253
00:16:18,310 --> 00:16:19,340
حسناً

254
00:16:23,160 --> 00:16:25,710
لم أستطع إنجاب الأطفال

255
00:16:25,710 --> 00:16:29,210
لكن أهكذا شعور تزويج الابنة يا ترى؟

256
00:16:29,960 --> 00:16:31,450
حسناً

257
00:16:31,450 --> 00:16:38,540
!أكيرا-كن، سأترك ابنتاي ومستقبل البشريّة لك

258
00:16:39,760 --> 00:16:41,050
شكراً لك

259
00:16:43,490 --> 00:16:44,760
يا لجماله

260
00:16:45,770 --> 00:16:46,980
!هيّا بنا

261
00:16:51,570 --> 00:16:55,860
كانت الساعة التالية وما قاربها
وقتاً بمنتهى الغرابة

262
00:16:56,470 --> 00:17:00,870
كانت المعركة الأخيرة لتحديد مصير العالم على الأرجح

263
00:17:01,760 --> 00:17:06,620
شيءٌ مشابه لأرماغيدون أو راغناروك

264
00:17:07,540 --> 00:17:10,880
لكن كان الصمت مخيماً

265
00:17:16,160 --> 00:17:22,460
كلّ ما كان بمقدور الجميع هو المراقبة
بلا حيلة بينما مصير العالم على المحكّ

266
00:17:32,190 --> 00:17:34,700
!توقّفت الهجمات في نيويورك

267
00:17:34,700 --> 00:17:36,750
...لندن، هونغ كونغ، ميلان

268
00:17:36,750 --> 00:17:40,140
!كلّ الهجمات الذاتيّة حول العالم قيد الإلغاء

269
00:17:40,140 --> 00:17:41,700
!تبقّت بلادنا فحسب

270
00:17:41,700 --> 00:17:44,960
!حرارة دماغ الغول ترتفع أكثر فأكثر

271
00:17:44,960 --> 00:17:46,150
...أكيرا-كن

272
00:17:50,080 --> 00:17:53,370
...تبّاً، أنا قريب

273
00:17:54,770 --> 00:17:57,740
حسناً، ما بطاقتك الرابحة؟

274
00:17:57,740 --> 00:18:03,050
لا يمكن محي الشرّ البشريّ
بتلك السهولة أيّها البطل

275
00:18:06,880 --> 00:18:09,810
!وصل هذا المبنى حدّه! لنهرب

276
00:18:10,190 --> 00:18:15,150
يقلّص أكيرا حدود العدوّ لليابان الآن فحسب

277
00:18:15,150 --> 00:18:17,700
لا يمكننا الهرب وتركه

278
00:18:18,580 --> 00:18:21,080
كلا، اهربوا يا مينامي

279
00:18:21,080 --> 00:18:22,160
!أكيرا

280
00:18:22,160 --> 00:18:27,370
اسمعيني، بذلتُ قصارى جهدي
لكنّي لا أستطيع تقليصهم أكثر

281
00:18:27,760 --> 00:18:32,470
يبدو أنّ دماغي وصل حدّه فعليّاً أيضاً

282
00:18:34,610 --> 00:18:40,470
لذا قرّرتُ إرسال مجموعة من الصواريخ
النووية للسماء فوق طوكيو

283
00:18:41,270 --> 00:18:47,390
...ثمّ أفجّرها فوق طبقة الغلاف الجويّ العليا
على ارتفاع يفوق 100 كيلومتر

284
00:18:47,390 --> 00:18:49,350
...أتقصد

285
00:18:49,350 --> 00:18:53,480
هجوم نبضات كهرومغناطيسية باستعمال
الانفجارات النووية عالية الارتفاع؟

286
00:18:53,480 --> 00:18:57,670
...الانفجارات النووية على ارتفاع 30 إلى 400 كيلومتر

287
00:18:57,670 --> 00:19:00,080
ستجعل أشعّة غاما تتصادم مع جزيئات الهواء

288
00:19:00,080 --> 00:19:05,370
فتطلق إلكتروناتها، وتسبب إرسال نبضات كهرومغناطيسية
على مدى نصف قطر 100 كم

289
00:19:05,370 --> 00:19:11,080
ستتدمّر كلّ أجهزة اليابان الإلكترونيّة، وتُفقد كلّ البيانات

290
00:19:11,080 --> 00:19:12,830
بالإضافة للعدوّ

291
00:19:12,830 --> 00:19:18,260
لكنّ فعل ذلك قد يلحق ضرراً باليابان
!أكبر من هجوم طوكيو الإرهابيّ

292
00:19:18,260 --> 00:19:20,470
أجل، أعرف

293
00:19:20,880 --> 00:19:24,390
الـ "إكس-آرم" ليست إلّا وباءً في النهاية

294
00:19:25,060 --> 00:19:25,810
...لكن

295
00:19:25,810 --> 00:19:29,130
...تلك الشياطين المتجسّدة من خطايا الشرّ

296
00:19:29,130 --> 00:19:32,980
!لا يمكن أن يُسمح بنجاة بايت واحد من شفرتهم

297
00:19:34,720 --> 00:19:36,890
!لذا فلتهربوا جميعاً

298
00:19:37,800 --> 00:19:39,860
!أكيرا محقّ! لنذهب

299
00:19:40,680 --> 00:19:43,040
!كلا! لا أريد يا أكيرا

300
00:19:43,040 --> 00:19:44,590
!سأبقى هنا

301
00:19:44,590 --> 00:19:46,200
لا يمكنك يا مينامي

302
00:19:46,980 --> 00:19:48,860
!لطالما كنّا معاً

303
00:19:48,860 --> 00:19:51,580
!دعني أصاحبك حتّى النهاية

304
00:19:52,310 --> 00:19:56,520
لا يمكنك، أرجوكِ يا مينامي-سان، فلتذهبي

305
00:19:56,520 --> 00:19:57,550
...آلما

306
00:19:57,550 --> 00:20:00,060
لتعيشي يا مينامي

307
00:20:01,400 --> 00:20:05,100
سندمّر للإنقاذ

308
00:20:05,100 --> 00:20:08,400
سنستعمل كلّ ذرّة في كياننا لذلك

309
00:20:08,400 --> 00:20:12,790
فلتستعملي حياتك في مساعدة
الناس بعد ذاك الدمار

310
00:20:14,410 --> 00:20:18,280
قد يحصل ذلك في أوقات مختلفة، لكنّ هدفنا واحد

311
00:20:18,690 --> 00:20:22,360
"على القويّ تسخير قوّته لمساعدة الضعفاء"

312
00:20:22,750 --> 00:20:24,360
صحيح يا مينامي-سان

313
00:20:24,980 --> 00:20:28,090
ذلك ما علّمتِنا إيّاه

314
00:20:29,360 --> 00:20:31,530
لا تنسي يا مينامي

315
00:20:32,930 --> 00:20:34,700
نحن فريق

316
00:20:38,290 --> 00:20:39,250
...أكيرا

317
00:20:39,250 --> 00:20:41,980
أُطلقت المزيد من الصواريخ
الباليستيّة العابرة للقارّات

318
00:20:41,980 --> 00:20:44,000
!فلتذهبي يا مينامي

319
00:20:44,000 --> 00:20:44,870
!حسناً

320
00:20:49,760 --> 00:20:53,110
لم يخطر لي أن أصبح بطلاً قطّ

321
00:20:53,890 --> 00:20:58,150
كنتُ مجرّد بشريّ عاجز لا يستطيع
فعل شيءٍ من تلقاء نفسه

322
00:20:59,080 --> 00:21:02,150
لكن غيّر القدر ذلك

323
00:21:21,460 --> 00:21:25,090
!أكيرا

324
00:21:41,030 --> 00:21:45,080
لقد عشتُ حياتي بأكمل ما أستطيع

325
00:21:46,150 --> 00:21:47,350
يا أخي