1
00:00:45,370 --> 00:00:48,500
زميلتي إيشيكاوا-سان هي مصّاصة دماء

2
00:00:49,980 --> 00:00:54,350
...إنّها رائعة وغامضة وتُحيط بها هالة

3
00:00:59,410 --> 00:01:00,990
!أوتوري

4
00:01:01,290 --> 00:01:03,390
هذا خرقٌ جادّ

5
00:01:04,290 --> 00:01:05,620
أنا آسفة

6
00:01:05,980 --> 00:01:07,160
هل أنتِ جائعة؟

7
00:01:07,330 --> 00:01:10,770
أجل، جعلَتْني الدّراسة جائعة قليلاً

8
00:01:10,940 --> 00:01:12,050
دراسة؟

9
00:01:23,170 --> 00:01:24,260
دراسة هذا؟

10
00:01:24,430 --> 00:01:26,990
...فـ-في الواقع

11
00:01:27,890 --> 00:01:32,300
كمرجِع لشخصيّتي على ما أعتقد؟

12
00:01:54,190 --> 00:01:59,010
الآنسة الصّغيرة مصّاصة الدّماء لا تُحسِن الامتصاص

13
00:03:05,130 --> 00:03:06,780
مرجِع لشخصيّتك؟

14
00:03:06,950 --> 00:03:11,410
أجل! مصّاصة الدّماء البطلة
!فيه رائعة للغاية

15
00:03:11,580 --> 00:03:15,080
!أتمنّى أن أكون مثلها فحسب

16
00:03:15,250 --> 00:03:18,590
ماذا؟ لكنّها لا تشبهكِ أبداً

17
00:03:21,730 --> 00:03:23,840
...أ-أعلم ذلك

18
00:03:24,010 --> 00:03:26,100
هذا ليس ما قصدت

19
00:03:26,570 --> 00:03:28,050
أقصد هذا المشهد

20
00:03:28,220 --> 00:03:30,100
عندما تمتصّ الدّم؟

21
00:03:30,610 --> 00:03:33,620
دائماً ما تمتصّين الدّم من ذراعي، أليس كذلك؟

22
00:03:35,490 --> 00:03:41,240
رغم ذلك، سيكون الامتصاص من العنق
أكثر طبيعيّة من حيث الصّورة العامّة

23
00:03:41,410 --> 00:03:43,030
...توقّعت

24
00:03:43,290 --> 00:03:47,930
كنتُ أتمرّن، لكن فكرة عضّ
...شخص من العنق

25
00:03:48,100 --> 00:03:49,750
لستُ مُستعدّة لذلك بعد

26
00:03:50,140 --> 00:03:51,140
هكذا إذاً

27
00:03:52,670 --> 00:03:56,180
مُجرّد التّفكير في الأمر جوّعني ثانية

28
00:03:58,260 --> 00:03:59,910
بلا تحذير اليوم؟

29
00:04:10,410 --> 00:04:12,140
هل قلتُ شيئاً ما كان ينبغي أن أقوله؟

30
00:04:12,310 --> 00:04:14,550
ماذا؟

31
00:04:14,870 --> 00:04:16,440
بشأن كيفيّة امتصاصك الدّم

32
00:04:17,310 --> 00:04:19,940
...اقترحتُ امتصاص الدّم من العنق، لكن أقصد

33
00:04:20,610 --> 00:04:21,610
انظري

34
00:04:24,700 --> 00:04:27,730
!آ-آسفة لكوني قصيرة جدّاً

35
00:04:27,900 --> 00:04:29,480
مـ-مهلاً

36
00:04:29,650 --> 00:04:32,870
قصدتُ بأنّكِ مُناسبة كما أنتِ الآن

37
00:04:34,860 --> 00:04:36,010
...فضلاً عن ذلك

38
00:04:36,550 --> 00:04:39,090
بهذا الشّكل، يمكنني النّظر إليكِ طوال الوقت

39
00:04:40,220 --> 00:04:43,050
!هذا مُحرج للغاية في الواقع

40
00:04:43,220 --> 00:04:44,550
أتعتقدين ذلك؟

41
00:04:45,220 --> 00:04:49,180
أقصد بأنّ سوءكِ في امتصاص الدّم
ظريف بعض الشّيء

42
00:04:49,350 --> 00:04:52,680
بـ-بجدّية؟ حقّاً؟

43
00:04:52,850 --> 00:04:55,430
أجل، أعتقد بأنّ هذا ظريف

44
00:04:55,600 --> 00:04:57,130
كما القطّة تماماً

45
00:04:59,910 --> 00:05:02,980
...بجدّية؟ إذاً تعتقد بأنّني

46
00:05:04,310 --> 00:05:05,310
...أنا

47
00:05:06,710 --> 00:05:08,030
إيشيكاوا-سان؟

48
00:05:08,520 --> 00:05:10,230
ساكوما-سان

49
00:05:11,450 --> 00:05:16,460
الآنسة الصّغيرة مصّاصة الدّماء وساكوما-سان

50
00:05:18,110 --> 00:05:21,910
آسفة، لم أقصد التجسُّس عليكما

51
00:05:22,080 --> 00:05:25,670
كأمينة مكتبة، أتيتُ إلى هنا لإعادة الكُتُب

52
00:05:25,970 --> 00:05:27,990
هل لي أن أسأل منذ متى؟

53
00:05:28,160 --> 00:05:32,920
في الواقع، قبل بدء إيشيكاوا-سان
بعضّ ذراعك بقليل

54
00:05:33,090 --> 00:05:35,560
هذا مُبكِّر جدّاً

55
00:05:35,730 --> 00:05:38,230
هل كنتِ تمتصّين دمه؟

56
00:05:39,050 --> 00:05:40,650
!شـ-شيء من هذا القبيل

57
00:05:41,290 --> 00:05:42,440
!توقّعت

58
00:05:42,610 --> 00:05:45,140
،لم أركِ تمتصّين دماً من قبل
!لذا راودني فضول

59
00:05:45,310 --> 00:05:50,570
،هـ-هذا ليس شيئاً أكشفه في العادة
نظراً إلى أنّني مصّاصة دماء نبيلة

60
00:05:50,740 --> 00:05:53,160
!هذا هو السّبب إذاً! هذا غاية في الرّوعة

61
00:05:53,380 --> 00:05:55,410
...شخصيّتها المُزعجة تلك من جديد

62
00:05:55,580 --> 00:05:59,690
...لكن كهديّة خاصّة، سأدعكِ تلقين نظرة

63
00:05:59,860 --> 00:06:01,480
...إلى... العلامات

64
00:06:04,970 --> 00:06:06,220
...نبيلة

65
00:06:08,690 --> 00:06:10,980
ساكوما-سان، امنحينا دقيقة

66
00:06:12,930 --> 00:06:14,050
أكيد

67
00:06:18,690 --> 00:06:21,080
رقائق بطاطس... ومانغا؟

68
00:06:21,250 --> 00:06:23,650
!نسينا إخفاءها

69
00:06:23,820 --> 00:06:26,840
هل كنتُما تأكلان هذه هنا؟

70
00:06:27,010 --> 00:06:29,770
لا يجدر بكِ أن تفعلي ذلك يا إيشيكاوا-سان

71
00:06:30,220 --> 00:06:32,160
...ماذا؟ هذه الشّخصيّة

72
00:06:33,190 --> 00:06:36,970
!كان هذا... وهنا

73
00:06:38,170 --> 00:06:40,250
!إنّها تتصرّف كما كنتِ تتصرّفين

74
00:06:42,170 --> 00:06:45,420
!أتذكّر قولكِ لهذه العبارة

75
00:06:45,740 --> 00:06:47,620
"ستدفع الثّمن بدمك"

76
00:06:47,790 --> 00:06:49,640
...لـ-لا أكثر

77
00:06:49,810 --> 00:06:52,140
!إيشيكاوا-سان، أنتِ تتركين انطباعاً كبيراً

78
00:06:55,130 --> 00:06:57,600
لـ-لا أستطيع تحمُّل رؤية هذا

79
00:06:57,770 --> 00:07:00,570
!لم أكن أعلم بأنّكِ تقرئين هذا النّوع من المانغا

80
00:07:00,740 --> 00:07:03,020
أنا مُتفاجئة بعض الشّيء

81
00:07:03,940 --> 00:07:06,830
خاب أملكِ، أليس كذلك؟

82
00:07:09,180 --> 00:07:13,400
...بما أنّني سلوكيّاتي ليست كمصّاصي الدّماء

83
00:07:13,570 --> 00:07:16,220
!لا، أعتقد بأنّ هذا رائع

84
00:07:16,830 --> 00:07:20,410
...لم أعرف سوى جانبكِ الرّائع من قبل

85
00:07:20,580 --> 00:07:23,950
!لكن جانبكِ هذا ظريف حقّاً

86
00:07:25,300 --> 00:07:26,650
لم تكن تُمانع ذلك

87
00:07:26,820 --> 00:07:27,940
أوتوري

88
00:07:28,110 --> 00:07:29,230
...بالمناسبة

89
00:07:30,210 --> 00:07:33,890
...لا أُمانع امتصاص دمي، إن فهمت مقصدي

90
00:07:36,780 --> 00:07:41,170
...سيزيح هذا بعضاً من العبء عن أوتوري، لكن

91
00:07:41,750 --> 00:07:42,850
...لكن

92
00:07:43,500 --> 00:07:47,310
أعضّ بشكل عشوائيّ، وهذا مؤلم كثيراً

93
00:07:47,480 --> 00:07:48,610
!لا تقلقي

94
00:07:49,110 --> 00:07:51,700
أنا معتادة على الألم نتيجة
!التمرّن على كُرة الطّائرة

95
00:07:51,870 --> 00:07:53,050
!يمكنني تحمُّل ذلك

96
00:07:53,220 --> 00:07:54,990
ر-رائع للغاية

97
00:07:55,610 --> 00:07:58,280
...إذاً لنقم بتجربة

98
00:07:58,450 --> 00:08:01,480
إيشيكاوا-سان أكثر توتُّراً منّي

99
00:08:01,650 --> 00:08:04,250
بما أنّها احتفظتْ بذلك سرّاً
عنّي طوال هذا الوقت

100
00:08:12,950 --> 00:08:14,260
!هذا رقيق جدّاً

101
00:08:14,980 --> 00:08:16,620
!هذا يُدغدغ

102
00:08:16,790 --> 00:08:18,260
!آ-آسفة

103
00:08:18,600 --> 00:08:20,570
!هـ-ها أنا ذي

104
00:08:23,190 --> 00:08:25,950
!سوف أعضّ! سأفعل ذلك بجدّية

105
00:08:26,420 --> 00:08:28,270
...جاهزة أم لا

106
00:08:41,490 --> 00:08:42,530
...لذا

107
00:08:42,700 --> 00:08:45,740
!ظريفة للغاية

108
00:08:46,970 --> 00:08:49,050
!لم أمتصّ أي دم بعد

109
00:08:50,400 --> 00:08:52,920
اليوم التّالي

110
00:08:53,090 --> 00:08:56,340
!لونا-تشان! لونا-تشان

111
00:08:56,510 --> 00:08:58,690
!جذّابة للغاية

112
00:09:04,020 --> 00:09:06,230
!صباح الخير يا لونا-تشان

113
00:09:11,010 --> 00:09:12,900
أجل، صباح الخير

114
00:09:15,820 --> 00:09:19,320
المكتبة

115
00:09:28,660 --> 00:09:31,090
هل كان ذلك حلماً؟

116
00:09:31,410 --> 00:09:33,550
!ها أنتِ ذي يا ساكوما

117
00:09:38,210 --> 00:09:41,160
شكراً على مُساعدتي

118
00:09:41,330 --> 00:09:45,100
لا مُشكلة. أردتُ الاعتذار عن هذا الصّباح

119
00:09:46,370 --> 00:09:51,960
،لم يُنادِني أحدٌ بذلك من قبل
لذا لم أكن أعرف كيف أستجيب

120
00:09:52,130 --> 00:09:53,230
يُناديكِ بذلك؟

121
00:09:53,930 --> 00:09:56,980
لونا-تشان، باستخدام اسمي الأوّل

122
00:09:57,150 --> 00:09:59,760
!إنّه اسم ظريف بالفعل

123
00:09:59,930 --> 00:10:01,070
!لونا-تشان

124
00:10:01,850 --> 00:10:03,370
...شكراً

125
00:10:03,540 --> 00:10:07,000
أنا واثقة بأنّ هناك آخرين في صفّنا
!يحبّون مُناداتكِ بلونا-تشان

126
00:10:07,170 --> 00:10:09,290
...ماذا؟ في الواقع

127
00:10:09,460 --> 00:10:13,330
لـ-لا أعلم ما إن كان ذلك سيُلائم
مصّاصة دماء نبيلة مثلي

128
00:10:13,500 --> 00:10:16,210
نـ-ناهيك عن أنّه أمر مُحرج

129
00:10:16,640 --> 00:10:20,890
هذا صحيح، دائماً ما تظهرين بمظهر رهيب

130
00:10:26,220 --> 00:10:31,150
يتوقّع النّاس أن يكون مصّاصو الدّماء
رائعين ونبيلين، أليس كذلك؟

131
00:10:31,530 --> 00:10:36,030
إذا لم أرتقِ لتلك التوقُّعات، فقد أخذلهم

132
00:10:38,530 --> 00:10:44,470
أريد أن أنسجم بشكل جيّد مع الآخرين جميعهم

133
00:10:45,160 --> 00:10:47,040
ماذا؟

134
00:10:53,670 --> 00:10:54,890
كوني حذرة

135
00:10:55,300 --> 00:10:58,300
!شكراً يا أوتوري

136
00:10:59,860 --> 00:11:02,720
!ظـ-ظريفة للغاية

137
00:11:03,630 --> 00:11:05,220
!ساكوما

138
00:11:06,740 --> 00:11:10,260
أحبّ جانبكِ الظّريف أيضاً

139
00:11:10,430 --> 00:11:13,520
،هذا يجعل نبضات قلبي تتسارع
ومن الأسهل التكلُّم معكِ

140
00:11:13,690 --> 00:11:16,060
!لحظة، هل التصرُّف بنُبل ارتدَّ عليّ؟

141
00:11:16,230 --> 00:11:18,280
...ليس إلى هذه الدّرجة

142
00:11:18,450 --> 00:11:20,110
!أُحبّ كليهما

143
00:11:38,750 --> 00:11:40,350
!أُحبّ كليهما

144
00:11:54,530 --> 00:11:55,530
حسناً

145
00:11:56,980 --> 00:12:01,990
الآنسة الصّغيرة مصّاصة الدّماء وساكوما-سان

146
00:12:19,130 --> 00:12:21,170
!إنّها إيشيكاوا-سان

147
00:12:21,340 --> 00:12:23,130
!تبدو رائعة كعادتها

148
00:12:27,690 --> 00:12:28,890
صباح الخير

149
00:12:30,180 --> 00:12:32,090
!صـ-صباح الخير"؟"

150
00:12:32,260 --> 00:12:34,610
!ألقتْ إيشيكاوا-سان التّحيّة علينا

151
00:12:34,780 --> 00:12:37,230
ظريفة للغاية! رغم أنّ نسختها
!الرّهيبة رائعة أيضاً

152
00:12:37,400 --> 00:12:38,560
!هل تعرفين من أكون؟

153
00:12:38,730 --> 00:12:40,190
!لنصبح صديقين

154
00:12:40,650 --> 00:12:43,140
!لونا-تشان! صباح الخير

155
00:12:43,310 --> 00:12:44,400
صباح الخير

156
00:12:44,570 --> 00:12:47,470
!أنتِ ظريفة للغاية

157
00:12:48,310 --> 00:12:50,960
!ساكوما، لا أستطيع التنفُّس

158
00:12:51,130 --> 00:12:52,410
مهلاً يا إيكو

159
00:12:52,580 --> 00:12:53,850
دعيها تتنفّس قليلاً

160
00:12:55,500 --> 00:12:57,330
!هي السّبب كونها ظريفة جدّاً

161
00:12:57,700 --> 00:12:59,590
...بئس الأمر

162
00:12:59,760 --> 00:13:02,090
متى أصبحتُما رفيقتين؟

163
00:13:02,260 --> 00:13:06,180
في الواقع، كانت تُساعدني في واجباتي
المكتبيّة في الأمس

164
00:13:06,610 --> 00:13:08,390
!هذا يُثير غيرتي

165
00:13:08,770 --> 00:13:11,560
حسناً، هل يمكنكِ إعادته؟

166
00:13:11,930 --> 00:13:13,430
!اعتمدي عليّ

167
00:13:14,670 --> 00:13:18,380
!استمتعتُ كثيراً بفضل لونا-تشان

168
00:13:27,070 --> 00:13:28,990
!أوتوري! صباح الخير

169
00:13:30,240 --> 00:13:31,350
ماذا؟ هو كذلك؟

170
00:13:31,520 --> 00:13:32,530
!أجل

171
00:13:32,700 --> 00:13:33,930
لماذا أوتوري؟

172
00:13:34,100 --> 00:13:37,370
ساعدني أوتوري عندما كنتُ في ورطة

173
00:13:37,540 --> 00:13:38,960
ماذا؟

174
00:13:46,130 --> 00:13:48,250
...أوتوري، المعذرة

175
00:13:52,390 --> 00:13:53,610
إلى اللّقاء

176
00:13:58,930 --> 00:14:00,230
أوتوري؟

177
00:14:00,400 --> 00:14:01,600
دورة المياه؟

178
00:14:01,770 --> 00:14:04,240
أردتُ أن أتكلّم معه كأُمّ زميلة

179
00:14:04,410 --> 00:14:05,660
أُمّ زميلة؟

180
00:14:07,060 --> 00:14:09,780
غادرتُ الصّفّ بحكم الفطرة

181
00:14:10,770 --> 00:14:11,990
ماذا الآن؟

182
00:14:12,550 --> 00:14:16,820
أوتوري-سان، نحن على وشك
البدء بحصّة النّشاط

183
00:14:16,990 --> 00:14:17,990
أجل

184
00:14:19,670 --> 00:14:20,960
صباح الخير

185
00:14:21,130 --> 00:14:23,590
!صباح الخير

186
00:14:23,940 --> 00:14:27,920
الأسبوع المقبل هو بداية للفترة التّجريبيّة
لنادي المدرسة للتّلاميذ القادمين

187
00:14:28,090 --> 00:14:29,930
...بالنّسبة لأولئك الّذين يريدون الانضمام

188
00:14:30,460 --> 00:14:33,380
المعذرة، هل تسمعون جميعاً؟

189
00:14:33,550 --> 00:14:36,100
سأحزن إذا تجاهلتموني

190
00:14:39,950 --> 00:14:42,080
...أوتوري، بالنّسبة للغداء اليوم

191
00:14:42,250 --> 00:14:43,940
!إيشيكاوا-سان

192
00:14:44,110 --> 00:14:46,460
!لونا-تشان، لنتناول الغداء

193
00:14:46,630 --> 00:14:48,900
إيشيكاوا-سان، ما رأيك بالانضمام لي؟

194
00:14:49,210 --> 00:14:50,420
!استخدميني ككرسيّ

195
00:14:51,410 --> 00:14:52,480
!حسناً، شكراً

196
00:14:52,650 --> 00:14:55,740
!اجلسي عليّ بسرعة-
!لحظة! كلّ واحد على حِده-

197
00:14:57,490 --> 00:14:59,200
!أجل، لنأكل معاً

198
00:14:59,370 --> 00:15:02,440
رائع! فوّتُّ فُرصتي في المرّة السّابقة

199
00:15:02,610 --> 00:15:04,220
ماذا؟ حقّاً؟

200
00:15:05,060 --> 00:15:06,880
لونا-تشان، أين علبة غدائك؟

201
00:15:07,050 --> 00:15:08,600
أنا أتناول حلويّات على الغداء

202
00:15:08,770 --> 00:15:13,870
ليتني أكون كرسيّاً، لكن لا أمانع أن أكون
لُفافة حلويّات لإيشيكاوا-سان أيضاً

203
00:15:14,390 --> 00:15:16,370
!أو حتّى بطاقة السّعر الخاصّة بالحلويّات

204
00:15:16,540 --> 00:15:18,370
اهدأ يا ديغوتشي

205
00:15:20,390 --> 00:15:25,070
إذاً ابتداء من الغد، سأجري نحو متجر المدرسة
!لشراء خبز لذيذ

206
00:15:25,240 --> 00:15:27,450
!مئة متر في خمس ثوانٍ

207
00:15:27,620 --> 00:15:30,230
تحقيق رقم قياسيّ عالميّ جديد
في شراء الخبز؟

208
00:15:30,400 --> 00:15:33,190
أرغب في إعداد بعض الخبز لأجلك

209
00:15:33,360 --> 00:15:34,370
ماذا؟

210
00:15:34,540 --> 00:15:36,450
!أريد تجربة خبزكِ المنزليّ

211
00:15:36,620 --> 00:15:41,580
الخبز الّذي أعدّتْه إيكو في حصّة الاقتصاد
المنزليّ بدا كما الوحل

212
00:15:41,750 --> 00:15:44,130
!مذاقه أطيب ممّا يبدو غالباً

213
00:15:48,340 --> 00:15:50,840
لا بُدّ أنّكِ كنتِ جائعة يا إيشيكاوا-سان

214
00:15:51,010 --> 00:15:53,440
...لم يكن بيدي حيلة

215
00:15:53,610 --> 00:15:57,580
أجل، يجب عليّ أن أسأل

216
00:15:57,750 --> 00:16:00,360
دائماً ما أراكِ تأكلين أكلات خفيفة

217
00:16:00,530 --> 00:16:02,140
ألا تشربين الدّم أبداً؟

218
00:16:10,930 --> 00:16:15,600
في الحقيقة، أنا سيّئة جدّاً
في امتصاص الدّم

219
00:16:15,770 --> 00:16:18,250
لذا آكل أكلات خفيفة بدلاً من ذلك

220
00:16:18,810 --> 00:16:21,360
ما زلتُ أتمرّن على شرب الدّم

221
00:16:21,530 --> 00:16:22,800
حقّاً؟

222
00:16:22,970 --> 00:16:24,340
مُذهل

223
00:16:25,790 --> 00:16:28,600
!إذا احتجتِ دماً منّي يوماً، اسألي فحسب

224
00:16:28,770 --> 00:16:30,490
!أنا مُستعدّ للتخلّي عن ثلاثة ألتار في أيّ يوم

225
00:16:30,660 --> 00:16:31,800
لن يحدث هذا

226
00:16:31,970 --> 00:16:34,130
!ابذلي قصارى جهدكِ يا لونا-تشان

227
00:16:34,300 --> 00:16:35,620
!نحن نُشجّعكِ

228
00:16:37,490 --> 00:16:38,720
شكراً

229
00:16:39,710 --> 00:16:41,510
...أوتوري

230
00:16:43,590 --> 00:16:44,660
أوتوري؟

231
00:17:01,190 --> 00:17:02,350
أوتوري؟

232
00:17:16,610 --> 00:17:18,780
!أوتوري

233
00:17:23,190 --> 00:17:24,850
!أنتِ

234
00:17:26,130 --> 00:17:28,930
هل أنتِ لونا إيشيكاوا-سان من الصّفّ أ-2؟

235
00:17:29,310 --> 00:17:30,900
أجل

236
00:17:32,500 --> 00:17:34,760
!أنتِ باهرة الجمال عن كثب

237
00:17:34,930 --> 00:17:38,440
اسمي كاناي ياماتا، من الصّفّ ب

238
00:17:38,610 --> 00:17:39,740
!سُررت بلقائكِ

239
00:17:40,050 --> 00:17:42,410
روري أوميشيما-تشان هنا

240
00:17:42,770 --> 00:17:48,000
أردتُ أن ألتقي بكِ منذ سمعتُ بأنّ مصّاصة
!دماء انضمّت للصفّ أ

241
00:17:48,170 --> 00:17:50,140
!أشعر برهبة

242
00:17:50,310 --> 00:17:51,920
سـ-سررتُ بلقائك

243
00:17:52,090 --> 00:17:54,030
!ظريفة للغاية

244
00:17:57,890 --> 00:17:59,150
هل من مُشكلة؟

245
00:18:00,970 --> 00:18:03,500
أكاد أقسم بأنّ شخصاً كان يُراقبني

246
00:18:03,670 --> 00:18:06,260
!لا بُدّ أنّه أحد مُعجبيكِ المُتشدّدين

247
00:18:06,430 --> 00:18:09,570
!أنت! اكشف عن نفسك

248
00:18:09,740 --> 00:18:11,110
هيّا بنا نذهب

249
00:18:11,430 --> 00:18:12,460
!مهلاً

250
00:18:12,930 --> 00:18:14,710
!ألقاكِ لاحقاً يا إيشيكاوا-سان

251
00:18:16,580 --> 00:18:18,820
أ-أخافني ذلك

252
00:18:36,710 --> 00:18:38,800
...أ

253
00:18:38,970 --> 00:18:41,590
!أعصابي مشدودة

254
00:18:43,410 --> 00:18:47,310
لم أتوقّع أن أتجنّب نظرات النّاس طوال اليوم

255
00:18:47,480 --> 00:18:52,770
أعتقد بأنّ النّبأ بأنّ لا يوجد أحدٌ على علاقة
...جيّدة مع إيشيكاوا-سان مثلي قد انتشر

256
00:18:52,940 --> 00:18:54,230
لا عجب

257
00:18:57,110 --> 00:19:01,100
!أوتوري! وجدتُك

258
00:19:02,170 --> 00:19:03,740
!إيشيكاوا-سان

259
00:19:04,180 --> 00:19:06,130
ماذا أصابك اليوم؟

260
00:19:06,300 --> 00:19:08,330
،تظلّ تهرب بينما أحاول التكلُّم معك

261
00:19:08,500 --> 00:19:10,540
!ولم أستطع إيجادك إطلاقاً أثناء فترات استراحتنا

262
00:19:10,710 --> 00:19:12,710
آ-آسف

263
00:19:15,510 --> 00:19:18,460
...وفي الوقت الّذي كان الجميع

264
00:19:38,630 --> 00:19:39,630
...أنا

265
00:19:41,140 --> 00:19:43,300
غير جيّد في التكلّم مع النّاس

266
00:19:44,490 --> 00:19:47,890
لكنّك تكلّمت معي ومع ساكوما بشكل جيّد

267
00:19:48,300 --> 00:19:51,930
بصراحة، أتحمّس في بعض الأوقات

268
00:19:59,170 --> 00:20:01,130
...طوال هذا الوقت

269
00:20:01,390 --> 00:20:03,610
لطالما فكّرتُ فيما يعتقده الآخرون

270
00:20:04,130 --> 00:20:07,980
عشتُ حياتي أحاول ألّا ألفت الأنظار

271
00:20:11,820 --> 00:20:12,890
أنا أيضاً

272
00:20:14,030 --> 00:20:16,980
كان اليوم أوّل مرّة أتكلّم فيها مع الجميع

273
00:20:17,150 --> 00:20:22,790
،أخبرتُهم عن مدى سوئي في امتصاص الدّم
وقد تقبّلوني جميعهم فحسب

274
00:20:23,930 --> 00:20:25,930
...كانت تلك الجزئيّة جيّدة، لكن

275
00:20:27,950 --> 00:20:32,040
التّفكير بالشّخصيّة الّتي كوّنتُها
...جعلَتْني أشعر بالإحراج

276
00:20:32,210 --> 00:20:33,960
ومُتوتّرة أيضاً

277
00:20:34,590 --> 00:20:35,590
...لهذا السّبب

278
00:20:42,820 --> 00:20:48,140
...أحتاجك هنا لتتمرّن معي هكذا يا أوتوري

279
00:20:52,250 --> 00:20:54,020
كنتِ غاضبة جدّاً لدرجة طعني؟

280
00:20:54,670 --> 00:20:56,510
!لم أطعنك

281
00:20:57,030 --> 00:20:58,740
!بئساً

282
00:21:06,750 --> 00:21:10,910
التكلّم معكِ يجعلني أشعر
وكأنّني أستطيع فعلها

283
00:21:12,060 --> 00:21:13,060
حسناً

284
00:21:13,330 --> 00:21:15,250
سأجرّب ذلك غداً

285
00:21:16,050 --> 00:21:18,250
لنبذل قصارى جهدنا معاً يا إيشيكاوا-سان

286
00:21:20,670 --> 00:21:21,670
!أجل

287
00:21:23,800 --> 00:21:26,870
!لكن أنا جائعة حقّاً

288
00:21:28,030 --> 00:21:29,340
!من الخطير فعل هذا هنا

289
00:21:29,510 --> 00:21:33,600
،أنا أفضل قليلاً في العضّ الآن
!لذا ينبغي أن تكون الأمور بخير

290
00:21:33,770 --> 00:21:36,710
!مهلاً! إيشيكاوا-سان

291
00:23:09,380 --> 00:23:10,410
حسناً

292
00:23:11,540 --> 00:23:12,610
انتهيت

293
00:23:12,780 --> 00:23:13,810
!هيّا يا أوتوري

294
00:23:13,980 --> 00:23:15,130
يمكنك فعلها يا أوتوري

295
00:23:16,980 --> 00:23:18,030
...والآن أستطيع

296
00:23:18,200 --> 00:23:21,330
،إذا لم تستطيعي سدّ جوعكِ
فيجب أن تمتصّي دماء

297
00:23:24,870 --> 00:23:27,810
أعتقد سأشجّعه بصورة طبيعيّة فحسب

298
00:23:30,800 --> 00:23:33,470
الحلقة القادمة من
:الآنسة الصّغيرة مصّاصة الدّماء لا تُحسِن الامتصاص

299
00:23:33,980 --> 00:23:35,890
الآنسة الصّغيرة مصّاصة الدّماء وبطولة الرّياضة

300
00:23:36,060 --> 00:23:38,740
الآنسة الصّغيرة مصّاصة الدّماء والبحث عن نادٍ