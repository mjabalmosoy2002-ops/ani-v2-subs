1
00:00:01,630 --> 00:00:02,520
الشّاطئ؟

2
00:00:02,770 --> 00:00:06,270
كنتُ أتحدّث مع إيشيكاوا-سان
حول الذّهاب لأجل نادينا

3
00:00:06,750 --> 00:00:09,460
كنتُ أتساءل ما إن كنتُما تريدان الانضمام

4
00:00:09,460 --> 00:00:11,500
!فكرة سديدة

5
00:00:11,500 --> 00:00:12,590
تروقني

6
00:00:13,070 --> 00:00:15,900
!الماء الأزرق! وأشعّة الشّمس الضّاربة

7
00:00:15,900 --> 00:00:17,560
!والقرش ينقضّ علينا

8
00:00:17,560 --> 00:00:19,810
!لحظة، القروش ليست شيئاً جيّداً

9
00:00:22,210 --> 00:00:25,340
!صباح الخير

10
00:00:25,660 --> 00:00:27,120
ماذا تقرؤون؟

11
00:00:27,120 --> 00:00:28,730
!لونا-تشان

12
00:00:28,730 --> 00:00:30,380
!لا أطيق انتظار الذّهاب إلى الشّاطئ

13
00:00:30,620 --> 00:00:32,500
هل لديك زيّ سباحة؟

14
00:00:32,500 --> 00:00:33,700
!لنشترِ لكِ واحداً

15
00:00:33,700 --> 00:00:35,180
!ز-زيّ سباحة؟

16
00:00:35,180 --> 00:00:36,410
!مهلاً

17
00:00:36,410 --> 00:00:38,550
!هناك أمور أهمّ بمتناول اليد

18
00:00:41,330 --> 00:00:43,460
!بعد أن نفرغ من امتحاناتنا

19
00:00:43,460 --> 00:00:45,310
...حسناً

20
00:02:24,420 --> 00:02:27,120
...نضع هذه القيمة هنا

21
00:02:27,460 --> 00:02:30,810
...والآن نحسب باستخدام هذه الصّيغة

22
00:02:30,810 --> 00:02:32,540
فهمت

23
00:02:32,900 --> 00:02:35,870
مُذهل يا إيشيكاوا-سان، شرحتِها بووضح

24
00:02:37,150 --> 00:02:38,650
!اعتمد عليّ فحسب

25
00:02:40,430 --> 00:02:41,980
هل يمكنك شرح هذا؟

26
00:02:41,980 --> 00:02:43,230
!حسناً

27
00:02:47,610 --> 00:02:49,110
يمكنكِ فعلها أثناء امتصاص الدّم

28
00:02:49,110 --> 00:02:50,900
!مرحى

29
00:02:56,180 --> 00:02:57,470
ماذا؟

30
00:03:01,660 --> 00:03:02,900
ما السّبب يا ترى؟

31
00:03:02,900 --> 00:03:05,540
لا أشعر بإشباع أكبر

32
00:03:06,210 --> 00:03:08,540
تمرّ بي مثل هذه الأيّام أيضاً

33
00:03:08,540 --> 00:03:12,420
ربّما لأنّني أستخدم قوّة عقلي لتعليمك

34
00:03:12,420 --> 00:03:14,290
آسفة يا أوتوري

35
00:03:14,290 --> 00:03:16,430
لا، أنا بخير

36
00:03:16,750 --> 00:03:20,970
...تعلّمتُ الكثير هنا أيضاً

37
00:03:22,500 --> 00:03:24,550
!لستَ بخير إطلاقاً

38
00:03:24,550 --> 00:03:26,210
...رغم ذلك

39
00:03:26,210 --> 00:03:27,890
!سأتحمّل الأمر

40
00:03:27,890 --> 00:03:28,890
!أنا آسفة جدّاً

41
00:03:28,890 --> 00:03:31,130
!هذا صحيح، تذكّري فحسب

42
00:03:31,130 --> 00:03:35,010
!تحمّلتُ هذا الجوع طوال الوقت من قبل

43
00:03:35,570 --> 00:03:36,710
لونا-تشان

44
00:03:39,190 --> 00:03:40,240
!لونا-تشان

45
00:03:42,140 --> 00:03:44,740
!كم أنتِ لطيفة يا لونا-تشان

46
00:03:45,570 --> 00:03:48,700
إيشيكاوا-سان، تحمُّل الجوع مُضرّ لصحّتك

47
00:03:48,990 --> 00:03:51,190
إيشيكاوا-سان، يمكنكِ فعلها

48
00:03:51,500 --> 00:03:53,580
أتريدين عضّة يا إيشيكاوا-سان؟

49
00:03:55,730 --> 00:03:59,360
ما رأيكِ بالتمرُّن عليّ؟

50
00:03:59,360 --> 00:04:01,820
لم يتوقّف النّزيف هنا

51
00:04:02,180 --> 00:04:04,760
إيشيكاوا-سان، ألم تكوني جائعة؟

52
00:04:04,760 --> 00:04:06,100
يمكنكِ امتصاص دمي هكذا

53
00:04:08,780 --> 00:04:11,640
!كُفّ عن مُعاملتي بلطف ولو حاليّاً

54
00:04:11,640 --> 00:04:14,230
ما الشّياطين الّذين تُقاتلهم؟

55
00:04:14,230 --> 00:04:16,390
ليس عليكِ التحمُّل

56
00:04:16,390 --> 00:04:18,980
!بئساً، أنت هكذا دوماً

57
00:04:18,980 --> 00:04:24,230
...دمك لذيذ، وأريد شرب الكثير منه

58
00:04:24,590 --> 00:04:25,240
...لكن

59
00:04:27,060 --> 00:04:30,240
ليس على حساب صحّتك

60
00:04:36,550 --> 00:04:39,340
!أوتوري، استيقظ

61
00:04:45,610 --> 00:04:47,150
أين أنا؟

62
00:04:48,990 --> 00:04:50,410
الجنّة؟

63
00:04:50,850 --> 00:04:54,440
!دون دون دون! دونبوري

64
00:04:54,440 --> 00:05:01,070
!كلّ ما يُقدَّم بطبق دونبوري لذيذ

65
00:05:01,070 --> 00:05:05,340
!أودون، سوبا، دجاج، تونكاتسو

66
00:05:02,340 --> 00:05:04,350
إ-إيشيكاوا-سان؟

67
00:05:05,340 --> 00:05:08,090
...نخلط بعض البيض و

68
00:05:10,070 --> 00:05:11,450
!أنا جائعة للغاية

69
00:05:11,450 --> 00:05:13,870
!إ-إيشيكاوا-سان

70
00:05:18,450 --> 00:05:22,030
ماذا؟ هل نمت؟

71
00:05:27,510 --> 00:05:29,430
!كـ-كنتُ أصبّر نفسي

72
00:05:29,430 --> 00:05:31,740
!لم أشرب أي دم! صدّقني

73
00:05:31,740 --> 00:05:33,130
أجل. أتريدين بعضاً؟

74
00:05:35,220 --> 00:05:39,810
نخلط بعض البيض فيصبح أشهى

75
00:05:41,170 --> 00:05:43,330
ما رأيكِ بالمجيء إلى منزلي للدّراسة اليوم؟

76
00:05:43,330 --> 00:05:45,070
!أجل، فكرة سديدة

77
00:05:45,500 --> 00:05:47,780
!رائع جدّاً ولطيف

78
00:05:50,850 --> 00:05:53,370
هل يمكننا استخدام غرفة الرّسم هكذا حقّاً؟

79
00:05:53,370 --> 00:05:55,060
!لا مُشكلة إطلاقاً

80
00:05:55,060 --> 00:05:58,040
غادر أوتوري اليوم للاهتمام بالمتجر

81
00:05:58,570 --> 00:05:59,580
...وفضلاً عن ذلك

82
00:05:59,580 --> 00:06:02,020
!أنا عضوة في نادي الرّسم

83
00:06:04,180 --> 00:06:06,300
!هذا مُذهل يا لونا-تشان

84
00:06:06,300 --> 00:06:08,190
...المعذرة

85
00:06:08,190 --> 00:06:10,840
!حسناً، حان وقت الدّراسة

86
00:06:30,750 --> 00:06:32,080
...إيكو

87
00:06:32,080 --> 00:06:34,160
!المكان هادئ جدّاً هنا

88
00:06:34,160 --> 00:06:36,720
!كنتُ أحاول ألّا أضحك

89
00:06:36,720 --> 00:06:39,300
!أنتما، ركّزا

90
00:06:39,300 --> 00:06:40,450
...بئساً

91
00:06:58,460 --> 00:07:00,550
!ميسا، ركّزي

92
00:07:06,820 --> 00:07:11,860
...وبما أنّ هذه الكلمة تُعدّل العبارة الفعليّة السّابقة

93
00:07:11,860 --> 00:07:14,200
هل أنتِ بخير يا إيشيكاوا؟

94
00:07:14,200 --> 00:07:17,200
أعتقد نحن بحاجة أوتوري-كن هنا في نهاية المطاف

95
00:07:17,200 --> 00:07:20,960
...آكل باستمرار لكن لا يخفّ جوعي

96
00:07:22,900 --> 00:07:23,920
!وجدتُها

97
00:07:23,920 --> 00:07:33,760
تفضّلي يا إيشيكاوا-سان

98
00:07:24,320 --> 00:07:26,540
!ما رأيكِ بأوتوري، على طريقة وانكو سوبا؟

99
00:07:33,760 --> 00:07:36,250
...ماذا؟ لا أعلم

100
00:07:36,250 --> 00:07:37,970
!أريد الانضمام أيضاً

101
00:07:37,970 --> 00:07:45,620
تفضّلي يا إيشيكاوا-سان

102
00:07:39,650 --> 00:07:40,790
!لونا-تشان

103
00:07:42,600 --> 00:07:44,060
!لونا-تشان

104
00:07:45,620 --> 00:07:46,970
!لونا-تشان

105
00:08:26,150 --> 00:08:28,940
!انتهينا

106
00:08:29,200 --> 00:08:30,970
!لونا-تشان

107
00:08:31,950 --> 00:08:33,490
!لنذهب ونشترِ ملابس سباحة

108
00:08:41,090 --> 00:08:42,770
!حـ-حسناً

109
00:08:46,120 --> 00:08:48,880
كانت تلك الامتحانات النّهائيّة صعبة

110
00:08:49,110 --> 00:08:52,220
لم أتذكّر شيئاً من التّاريخ اليابانيّ

111
00:08:52,220 --> 00:08:54,210
...بعد كلّ تلك الدّراسة

112
00:08:56,860 --> 00:08:58,190
استمتعن

113
00:08:58,190 --> 00:09:00,930
كان ينبغي لأوتوري-كن أن يأتي معنا

114
00:09:00,930 --> 00:09:03,140
!ماذا؟ أ-أوتوري؟

115
00:09:03,140 --> 00:09:05,060
من الطّبيعيّ ألّا يأتي

116
00:09:09,050 --> 00:09:10,530
ماذا؟ ما الأمر؟

117
00:09:10,530 --> 00:09:11,690
ما المُشكلة؟

118
00:09:14,250 --> 00:09:15,410
هل تعلمان؟

119
00:09:15,410 --> 00:09:17,990
!أنّ هذه الفاتورة يتغيّر لونها

120
00:09:20,990 --> 00:09:22,300
!ما أجملها

121
00:09:22,300 --> 00:09:24,300
!معلوماتكِ غزيرة يا لونا-تشان

122
00:09:25,350 --> 00:09:26,430
!بالتّأكيد

123
00:09:27,190 --> 00:09:28,750
!نحن هنا لأجل ملابس السّباحة

124
00:09:30,770 --> 00:09:33,800
!الأودون هنا لذيذ حقّاً

125
00:09:33,800 --> 00:09:35,180
هل ينبغي أن نأكل منه؟

126
00:09:35,180 --> 00:09:38,760
!لديهم أودون محشوّ بسوداتشي لفترة محدودة

127
00:09:38,760 --> 00:09:40,060
!ملابس سباحة

128
00:09:42,100 --> 00:09:43,910
!انعطفي هنا

129
00:09:47,930 --> 00:09:49,570
!لماذا أنا من يلعب؟

130
00:10:02,350 --> 00:10:04,240
...وصلنا أخيراً

131
00:10:06,210 --> 00:10:08,950
لونا-تشان، ما رأيكِ بشيء كهذا؟

132
00:10:08,950 --> 00:10:10,750
!أبعدي صدركِ الكبير هذا

133
00:10:10,750 --> 00:10:12,230
ماذا؟

134
00:10:13,620 --> 00:10:15,920
...أعتقد بأنّه ضيّق قليلاً

135
00:10:17,460 --> 00:10:18,770
المعذرة

136
00:10:26,540 --> 00:10:29,310
هـ-هل يليق بي هذا؟

137
00:10:30,340 --> 00:10:31,980
!ظريفة للغاية

138
00:10:32,360 --> 00:10:33,980
!ألا تعتقدين بأنّها تبدو مُدهشة؟

139
00:10:38,820 --> 00:10:44,120
حتّى مع الواقي الشّمسيّ، أنا قلقة
من أشعّة الشّمس

140
00:10:44,340 --> 00:10:46,620
!لونا-تشان، جرّبي هذا كذلك

141
00:10:50,210 --> 00:10:52,390
!هذا جيّد أيضاً

142
00:10:52,390 --> 00:10:54,150
ستحتاجين هذا إذا كنتِ لا تستطيعين
التّعامل مع الأمواج

143
00:10:54,150 --> 00:10:55,100
ماذا؟

144
00:10:55,100 --> 00:10:57,380
وكذلك هذا وهذا

145
00:10:57,380 --> 00:11:00,260
...هذا وذاك وهذا

146
00:11:00,260 --> 00:11:02,430
...ميسا، مهلاً

147
00:11:02,820 --> 00:11:03,680
!ها هي ذي

148
00:11:06,930 --> 00:11:08,870
والآن لا شيء يدعو للقلق

149
00:11:09,970 --> 00:11:12,810
هذا مُبالغ به قليلاً يا ميسا

150
00:11:12,810 --> 00:11:13,890
ماذا؟

151
00:11:13,890 --> 00:11:17,350
ألستِ قلقة بشأن المرّة الأولى
لها في الشّاطئ؟

152
00:11:17,350 --> 00:11:18,770
!سأخلعه

153
00:11:18,770 --> 00:11:19,820
!مهلاً

154
00:11:19,820 --> 00:11:21,510
!لا أريد

155
00:11:22,030 --> 00:11:23,290
مـ-ماذا؟

156
00:11:23,290 --> 00:11:25,020
...في أوقات كهذه

157
00:11:25,490 --> 00:11:27,730
!عليكِ أن تتباهي بلباسك

158
00:11:27,730 --> 00:11:29,160
!لماذا تعرّيتِ؟

159
00:11:29,160 --> 00:11:33,070
!لماذا لا تسمحين لي بالتعرّي؟

160
00:11:30,990 --> 00:11:33,070
...أخيراً خلعتُها

161
00:11:33,660 --> 00:11:35,790
!لا داعي لتتعرّي أكثر من ذلك

162
00:11:35,790 --> 00:11:37,760
!لا تكشفي هذا الصّدر

163
00:11:37,760 --> 00:11:39,990
!لا يمكنني إخفاءهما للأبد

164
00:11:39,990 --> 00:11:41,560
!نحن ذاهبات إلى الشّاطئ كما تعلمين

165
00:11:41,560 --> 00:11:43,260
!أين المُشكلة في الكشف عن بعض الجسد؟

166
00:11:43,260 --> 00:11:45,120
!يا لكِ من فتاة نكِدة

167
00:11:45,120 --> 00:11:47,010
!وأنتِ بحاجة لبعض القيود

168
00:11:47,010 --> 00:11:49,950
!ماذا؟ هذا طبيعيّ للغاية

169
00:11:47,010 --> 00:11:49,950
!يوجد المزيد من ملابس السّباحة هناك

170
00:11:53,130 --> 00:11:55,270
!لونا-تشان، جرّبي هذه أيضاً

171
00:11:55,270 --> 00:11:56,540
!هذا خيطٌ حرفيّاً

172
00:11:56,540 --> 00:11:58,320
...إيشيكاوا ليست جاهزة لـ

173
00:11:58,320 --> 00:11:59,860
!لحظة، اختفت

174
00:11:59,860 --> 00:12:02,020
ربّما ذهبتْ إلى متجر آخر؟

175
00:12:04,870 --> 00:12:06,990
...تركَتْ كلّ أغراضها هنا

176
00:12:06,990 --> 00:12:08,700
!لنذهب ونبحث عنها

177
00:12:09,550 --> 00:12:10,500
!انظري

178
00:12:10,500 --> 00:12:12,960
!إيشيكاوا ظريفة للغاية

179
00:12:14,290 --> 00:12:15,540
أمسكتُ بكِ

180
00:12:15,540 --> 00:12:18,530
!ماذا لو خطفها شخصٌ شرّير؟

181
00:12:22,340 --> 00:12:23,580
!معكِ حقّ

182
00:12:23,580 --> 00:12:24,510
!أليس كذلك؟

183
00:12:25,140 --> 00:12:26,970
!إيشيكاوا

184
00:12:26,970 --> 00:12:29,780
!لونا-تشان، أين أنتِ؟

185
00:12:30,870 --> 00:12:34,390
!إنّها بمثل هذا الطّول وظريفة وناعمة جدّاً

186
00:12:34,390 --> 00:12:37,610
!تجعلكِ تبتسمين بمُجرّد النّظر إليها
هل لديك فكرة عن مكانها؟

187
00:12:37,980 --> 00:12:39,820
أين أنتِ؟

188
00:12:41,010 --> 00:12:42,350
!إيشيكاوا

189
00:12:45,320 --> 00:12:48,190
!بـ-بحثنا في كلّ مكان

190
00:12:48,190 --> 00:12:50,410
...لنجرّب مكتب الاستعلامات ثانية

191
00:12:52,230 --> 00:12:53,310
!وجدتُها

192
00:12:54,080 --> 00:12:55,620
!هل أنتِ بخير؟

193
00:12:56,870 --> 00:12:59,290
كوسونوكي. ساكوما

194
00:12:59,290 --> 00:13:00,710
لم تتأذّي؟

195
00:13:01,010 --> 00:13:01,860
لا

196
00:13:02,220 --> 00:13:05,180
في الواقع، وجدتُ زيّ سباحة ظريفاً

197
00:13:05,540 --> 00:13:08,790
...لكن لم أستطع إيجادكما

198
00:13:09,980 --> 00:13:12,970
...لذا قرّرتُ الانتظار هنا

199
00:13:12,970 --> 00:13:15,520
...لكن... لكن

200
00:13:15,520 --> 00:13:20,260
...كنتُ قلقة أن تُغادرا من دوني

201
00:13:21,690 --> 00:13:23,440
!أيّتها الحمقاء

202
00:13:24,020 --> 00:13:26,570
!مُحال أن نترككِ ونرحل

203
00:13:28,190 --> 00:13:30,100
!كم هذا مُطمئن

204
00:13:34,690 --> 00:13:38,240
تكبّدنا الكثير من العناء، لكن
!حصلتِ على واحد على الأقلّ

205
00:13:38,240 --> 00:13:40,210
أجل، شكراً

206
00:13:40,630 --> 00:13:41,960
...بالمناسبة

207
00:13:42,550 --> 00:13:45,100
كوسونوكي، هل يمكنكِ إفلاتي فحسب؟

208
00:13:45,100 --> 00:13:46,720
!لا! توقّفي عن التذمُّر

209
00:13:46,720 --> 00:13:48,570
!هذا مُحرج

210
00:13:48,570 --> 00:13:50,850
يا لها من جرأة من الفتاة الّتي تاهت للتو

211
00:13:51,420 --> 00:13:52,550
ها أنتنّ هنا

212
00:13:52,550 --> 00:13:53,690
!مرحباً يا فتيات

213
00:13:56,350 --> 00:13:57,480
أوتوري؟

214
00:13:56,350 --> 00:13:57,480
أوتوري-كن؟

215
00:13:57,730 --> 00:13:59,110
لماذا أنت هنا؟

216
00:13:59,630 --> 00:14:03,230
في الواقع، لا شيء مهمّ

217
00:14:03,820 --> 00:14:07,940
كنتُ قلقاً من أن تكون إيشيكاوا-سان
جائعة فحسب

218
00:14:12,650 --> 00:14:14,670
!اذهب أنت يا أوتوري-كن

219
00:14:15,030 --> 00:14:16,950
آسف للمُقاطعة

220
00:14:16,950 --> 00:14:18,100
!لا عليك

221
00:14:19,730 --> 00:14:20,780
أوتوري

222
00:14:26,060 --> 00:14:27,380
ماذا؟

223
00:14:27,380 --> 00:14:29,930
حلف رسميّ للأمّهات الزّميلات

224
00:14:30,350 --> 00:14:31,970
ماذا؟ ماذا؟

225
00:14:50,620 --> 00:14:53,670
!يا له من منظر

226
00:14:56,340 --> 00:14:59,610
اشتريتُ كلّ شيء لفت نظري

227
00:14:59,610 --> 00:15:02,500
!لحسن الحظّ، لدينا حمّام كبير

228
00:15:05,490 --> 00:15:08,390
...ستكون المرّة الأولى لي في الشّاطئ

229
00:15:08,390 --> 00:15:10,810
!لا شيء يتفوّق على الإجراء التّجريبيّ

230
00:15:26,710 --> 00:15:29,170
!مُذهل! إنّه لا يغرق

231
00:15:29,170 --> 00:15:31,450
!وهو مُريح جدّاً عند الاستلقاء عليه

232
00:15:32,850 --> 00:15:35,900
...بوسعي قراءة المانغا عليه

233
00:15:35,900 --> 00:15:37,620
...أو لعب ألعاب الفيديو

234
00:15:38,010 --> 00:15:41,790
أنا واثقة بأنّه سيكون مثاليّاً لأخذ قيلولة

235
00:15:42,110 --> 00:15:44,550
لحظة، يظلّ عقلي يتّجه نحو
!أنشطة في أماكن مُغلَقة

236
00:15:47,070 --> 00:15:50,410
إنّ تجهيز كلّ هذا استهلكَ كثيراً من الطّاقة

237
00:15:50,730 --> 00:15:51,740
!وجدتُها

238
00:15:51,740 --> 00:15:54,140
أنا واثقة بأنّه يمكن أن يتّسع شخصان هنا

239
00:16:04,490 --> 00:16:06,650
يبدو أنّه حان الوقت للغداء

240
00:16:15,170 --> 00:16:16,350
بصحّتك

241
00:16:21,510 --> 00:16:22,820
حياة المشاهير

242
00:16:25,090 --> 00:16:26,170
!يمكن لهذا أن يفلح

243
00:16:26,170 --> 00:16:28,040
!أجواء شاطئيّة بامتياز

244
00:16:59,050 --> 00:17:02,070
ينبغي أن أبدأ بالتّخطيط قريباً

245
00:17:02,070 --> 00:17:04,040
من هذا؟ صديق؟

246
00:17:04,040 --> 00:17:05,520
أ-أجل

247
00:17:05,520 --> 00:17:07,450
كنّا نفكّر في الذّهاب إلى الشّاطئ

248
00:17:09,330 --> 00:17:11,990
ألا يُدير عمّي مقهى شاطئيّاً؟

249
00:17:13,050 --> 00:17:14,620
أما من مُشكلة إذا مررتُ به؟

250
00:17:15,220 --> 00:17:17,340
لم نره منذ مدّة طويلة

251
00:17:17,340 --> 00:17:18,650
أتريدني أن أتّصل به سلفاً؟

252
00:17:20,260 --> 00:17:21,440
شكراً

253
00:17:21,440 --> 00:17:25,770
وكم مضى من وقت منذ ذهبتَ
إلى الشّاطئ مع أصدقاء؟

254
00:17:25,770 --> 00:17:26,910
حدّثني عنهم

255
00:17:27,260 --> 00:17:30,520
...في الواقع، إنّها مُجرّد فتاة في صفّي

256
00:17:32,400 --> 00:17:34,050
لحظة، ماذا؟

257
00:17:34,050 --> 00:17:35,740
ستكون أنت وفتاة فقط؟

258
00:17:35,740 --> 00:17:36,860
هذا جديد بالنّسبة لي

259
00:17:37,570 --> 00:17:38,710
!لا، لا

260
00:17:38,710 --> 00:17:40,500
!الأمر ليس كما تعتقدين

261
00:17:42,430 --> 00:17:44,120
...هذا صحيح

262
00:17:44,590 --> 00:17:45,660
!هيّا بنا

263
00:17:46,970 --> 00:17:51,040
سواء كانت شواطئ أو جبالاً، أيّ مكان تشائين

264
00:17:51,430 --> 00:17:53,840
بدلاً من مُجرّد النّظر، يمكننا الذّهاب معاً

265
00:17:53,840 --> 00:17:54,690
ماذا؟

266
00:17:54,690 --> 00:17:56,970
...هـ-هل تقصد

267
00:17:57,340 --> 00:18:00,220
...لم أقصد شيئاً عندما دعيتُها

268
00:18:02,340 --> 00:18:05,980
لكنّها إيشيكاوا-سان، ذات الشّعبيّة الكبيرة

269
00:18:10,980 --> 00:18:13,260
...أعلم بأنّه فات الأوان على ذلك

270
00:18:13,260 --> 00:18:15,220
!لكن أنا مُتوتّر

271
00:18:24,940 --> 00:18:28,670
...ظننتُ بأنّنا كنّا على وفاق جيّد مؤخّراً

272
00:18:29,020 --> 00:18:31,760
لا، كان ذلك أوّل خطأ ارتكبتُه

273
00:18:31,760 --> 00:18:33,630
أسأتُ في تقدير مستوى الصّداقة بيننا

274
00:18:33,630 --> 00:18:35,590
!يا لعادتي السّيّئة تلك

275
00:18:36,970 --> 00:18:38,590
!صباح الخير يا أوتوري

276
00:18:39,060 --> 00:18:40,530
—صبـ

277
00:18:41,060 --> 00:18:43,270
!ما هذا العتاد؟

278
00:18:45,630 --> 00:18:47,140
لِمَ تحملين هذه الأمتعة؟

279
00:18:47,140 --> 00:18:50,220
لم أكن متأكّدة ممّا يجب
إحضاره إلى الشّاطئ

280
00:18:50,220 --> 00:18:52,300
كنتُ آمل أن تُساعدني في الاختيار

281
00:18:54,250 --> 00:18:56,540
!يا إلهي، كان ذلك ثقيلاً

282
00:18:56,540 --> 00:18:57,860
لهذا السّبب أحضرتِ كلّ هذا؟

283
00:18:58,410 --> 00:19:01,200
!أنا مُتحمّسة للغاية بالفعل

284
00:19:01,200 --> 00:19:03,060
!متى سنذهب؟ لنُحدّد تاريخاً

285
00:19:05,700 --> 00:19:10,420
إيشيكاوا-سان، هل أنتِ مُتحمّسة
للذّهاب إلى الشّاطئ؟

286
00:19:12,530 --> 00:19:14,540
!بالطّبع أنا كذلك

287
00:19:14,540 --> 00:19:15,690
ماذا؟

288
00:19:15,690 --> 00:19:18,550
!أعني، انظر! إنّها المرّة الأولى لي

289
00:19:18,550 --> 00:19:20,690
!بالمناسبة! انظر إلى هذه

290
00:19:20,690 --> 00:19:22,980
!طلبتُها عبر الإنترنت بنزوة منّي

291
00:19:22,980 --> 00:19:26,430
علبة هاتف كي تتمكّن من التقاط
!صور في الماء

292
00:19:26,730 --> 00:19:28,740
!يمكنك استخدام هاتفك بهذا الشّكل

293
00:19:28,740 --> 00:19:32,290
...إذا ملأتها بالهواء هنا، فسوف تعوم في الماء

294
00:19:32,290 --> 00:19:33,940
هكذا إذاً

295
00:19:33,940 --> 00:19:36,390
!وهذه شريطة عائمة للكاميرات الرّقميّة

296
00:19:36,390 --> 00:19:38,320
!إنّها بمثابة دولاب سباحة لكاميرتك

297
00:19:40,420 --> 00:19:41,820
هكذا إذاً

298
00:19:41,820 --> 00:19:42,630
...أيضاً

299
00:19:42,630 --> 00:19:45,110
هل تسمعني يا أوتوري؟

300
00:19:45,110 --> 00:19:46,240
أجل

301
00:19:46,580 --> 00:19:48,230
!صباح الخير

302
00:19:48,230 --> 00:19:50,750
عمّاذا تتكلّمان؟

303
00:19:50,750 --> 00:19:52,270
!الشّاطئ

304
00:19:52,270 --> 00:19:53,500
!هذا صحيح

305
00:19:53,810 --> 00:19:55,780
علينا أن نُخطّط له

306
00:19:56,210 --> 00:19:57,250
!هذه

307
00:19:57,250 --> 00:19:58,760
توقّفي عن ذلك

308
00:20:00,330 --> 00:20:01,760
إيشيكاوا

309
00:20:02,260 --> 00:20:04,500
هل ستحضرين كلّ هذا؟

310
00:20:04,500 --> 00:20:05,510
!أجل

311
00:20:05,860 --> 00:20:08,560
على الأقلّ قلّصيها إلى غرض واحد أو اثنين

312
00:20:08,560 --> 00:20:09,700
ماذا؟

313
00:20:09,700 --> 00:20:11,950
!دولاب السّباحة هذا ظريف

314
00:20:11,950 --> 00:20:13,010
أليس كذلك؟ أليس كذلك؟

315
00:20:13,010 --> 00:20:15,030
...ا-المعذرة

316
00:20:15,450 --> 00:20:16,770
ما الأمر؟

317
00:20:16,770 --> 00:20:19,470
...سمعنا مُحادثتكم بالخطأ

318
00:20:19,470 --> 00:20:21,280
ستذهبون إلى الشّاطئ؟

319
00:20:21,820 --> 00:20:23,500
...هل تُمانعون أن

320
00:20:24,070 --> 00:20:26,800
!نُرافقكم كذلك؟

321
00:20:26,800 --> 00:20:28,160
...تحوُّل الأحداث هذا

322
00:20:28,470 --> 00:20:29,740
لِمَ لا؟

323
00:20:29,740 --> 00:20:31,300
!لنذهب جميعنا معاً

324
00:20:31,300 --> 00:20:33,410
!لِمَ أنتِ من يُقرّر؟

325
00:20:35,550 --> 00:20:36,960
!رائع

326
00:20:36,960 --> 00:20:38,420
!فعلناها

327
00:20:38,420 --> 00:20:40,550
!لنلعب ونستمتع بلا حدود

328
00:20:40,550 --> 00:20:42,360
!في الشّاطئ مع إيشيكاوا-سان

329
00:20:42,360 --> 00:20:44,840
هل أنا في حلم؟

330
00:20:44,840 --> 00:20:47,110
!لا أطيق الانتظار يا أوتوري

331
00:20:48,430 --> 00:20:49,370
أجل

332
00:20:51,420 --> 00:20:53,870
!مرحى

333
00:22:31,870 --> 00:22:34,310
لن تأخذي كلّ هذا

334
00:22:35,500 --> 00:22:37,520
ستحتاجين لدولاب سباحة، صحيح؟

335
00:22:37,520 --> 00:22:39,120
!وأريد تجربة صيد السّمك

336
00:22:41,550 --> 00:22:42,930
!سنحتاج مُسدّس ماء

337
00:22:42,930 --> 00:22:44,060
بوجود أسماك قرش وما شابه

338
00:22:44,060 --> 00:22:45,630
!كفى حديثاً عن أسماك القرش

339
00:22:46,010 --> 00:22:47,570
!ناهيك عن ذِكر هذا

340
00:22:48,810 --> 00:22:50,410
!هنا

341
00:22:57,340 --> 00:22:58,850
ما هذا؟

342
00:22:58,850 --> 00:23:02,300
!حسناً، انظروا إليّ

343
00:23:17,650 --> 00:23:20,140
!مُفاجأة! يخت

344
00:23:20,140 --> 00:23:21,890
!يخت؟

345
00:23:23,380 --> 00:23:24,580
!اذهبي وأعيديه

346
00:23:24,580 --> 00:23:26,640
...ماذا؟ لبعض الوقت فقط

347
00:23:26,640 --> 00:23:27,930
!مستحيل

348
00:23:32,150 --> 00:23:35,350
الحلقة القادمة من
:الآنسة الصّغيرة مصّاصة الدّماء لا تُحسِن الامتصاص

349
00:23:35,990 --> 00:23:37,780
الآنسة الصّغيرة مصّاصة الدّماء والشّاطئ