00:14:02,380 --> 00:14:03,430
!مرحى

211
00:14:03,600 --> 00:14:04,690
!ماذا؟

212
00:14:04,860 --> 00:14:05,960
هينمي-سان؟

213
00:14:06,130 --> 00:14:07,160
!أنتِ هنا كذلك؟

214
00:14:07,330 --> 00:14:08,930
!أنا مُنتسبة لعدّة نوادٍ

215
00:14:25,400 --> 00:14:26,470
الكلمات العامّية الشّائعة؟

216
00:14:26,640 --> 00:14:30,300
أتعتقدين بأنّ هناك أيّ تلميذ
حديث العهد سينضمّ لنا؟

217
00:14:30,470 --> 00:14:33,090
!علينا أن نسترخي ونتربّص مكاننا

218
00:14:33,260 --> 00:14:36,180
لديّ مُخطّطات، لذا سأهمّ
بالخروج من هنا

219
00:14:36,350 --> 00:14:37,420
عفواً؟

220
00:14:39,350 --> 00:14:44,360
!لدى مدرستنا الكثير من النّوادي المُمتعة

221
00:14:47,380 --> 00:14:49,310
يبدو أنّ فرق كُرة الطّائرة
في الصّالة الرّياضيّة

222
00:14:49,950 --> 00:14:51,030
!يا جماعة

223
00:14:51,490 --> 00:14:53,950
!مئة إرسال! ها نحن أولاء

224
00:14:54,120 --> 00:14:55,620
!أجل

225
00:14:57,370 --> 00:14:59,570
!كم هذا شاقّ

226
00:14:59,740 --> 00:15:02,210
ساكوما-سان مُفعمة بالطّاقة

227
00:15:02,380 --> 00:15:04,290
!التّالية

228
00:15:10,630 --> 00:15:12,040
!لا

229
00:15:12,210 --> 00:15:13,520
...إذا كسرنا أيّ شيء آخر

230
00:15:13,690 --> 00:15:14,720
!سنهلك

231
00:15:14,890 --> 00:15:18,060
!لونا-تشان، ساعدينا

232
00:15:20,380 --> 00:15:24,440
في الواقع، فريق كُرة الطّائرة الخاص
بنا مُني بسلسلة هزائم

233
00:15:24,610 --> 00:15:29,820
كنّا نعمل بجدّ لضمان فوزنا
،في البطولة الإقليميّة التّالية

234
00:15:30,080 --> 00:15:35,000
لكن تحمّسنا زيادة عن اللّزوم
...وكسرنا الأشياء

235
00:15:35,170 --> 00:15:38,590
!على هذا المُعدّل، سيحلّون فريقنا

236
00:15:39,050 --> 00:15:41,290
!صبر بوذا لا يدوم إلّا ثلاث مرّات

237
00:15:41,460 --> 00:15:42,880
!هذا خطير حقّاً

238
00:15:43,050 --> 00:15:44,960
...كانت المرّة الثّانية قبل قليل

239
00:15:45,130 --> 00:15:46,630
!هل هذه حيوات لعبة فيديو؟

240
00:15:48,280 --> 00:15:50,420
لا أعتقد بأنّ هذا هو معنى المقولة

241
00:15:50,590 --> 00:15:51,690
!النّجدة أرجوكِ

242
00:15:51,860 --> 00:15:54,760
!أنتِ رياضيّة ومؤتمنة

243
00:15:54,930 --> 00:15:59,430
هل يمكنكِ الانضمام لفريقنا
!ولو ليوم واحد فقط؟

244
00:15:59,720 --> 00:16:02,230
...إ-إن كان كذلك

245
00:16:04,530 --> 00:16:05,820
!مخزون شراب

246
00:16:10,010 --> 00:16:12,050
!حان الوقت لاجتماع تخطيطيّ

247
00:16:12,220 --> 00:16:13,420
...حسناً

248
00:16:13,590 --> 00:16:15,970
هل من اقتراحات يا قائدة؟

249
00:16:16,380 --> 00:16:17,890
دعوني أفكّر

250
00:16:18,060 --> 00:16:20,540
...الآن بوجود لونا-تشان هنا

251
00:16:21,060 --> 00:16:22,620
البرج المغناطيسيّ

252
00:16:22,790 --> 00:16:26,210
!نفعل هذا، ثمّ هذا وهذا

253
00:16:26,380 --> 00:16:28,770
!مستحيل! هذه هي خطّتكِ؟

254
00:16:28,940 --> 00:16:30,420
...هذا صحيح

255
00:16:30,640 --> 00:16:33,700
لطالما كان فريقنا هكذا

256
00:16:33,870 --> 00:16:37,050
كلّ اجتماعاتنا التّخطيطيّة تنتهي هكذا

257
00:16:37,990 --> 00:16:39,170
إيشيكاوا-سان

258
00:16:39,340 --> 00:16:40,390
لا مُشكلة

259
00:16:40,560 --> 00:16:42,800
،وعدتُ أن أُقدّم المُساعدة
!لذا سأبذل قصارى جهدي

260
00:16:42,970 --> 00:16:45,290
!أقسم بكبريائي كمصّاصة دماء نبيلة

261
00:16:45,460 --> 00:16:46,810
العبقريّة إيشيكاوا-سان

262
00:17:21,030 --> 00:17:23,020
!فعلناها

263
00:17:23,810 --> 00:17:26,020
!ضربة صاروخيّة مُوفّقة

264
00:17:29,660 --> 00:17:31,350
!شكراً جزيلاً

265
00:17:31,520 --> 00:17:34,980
!لم نكسر شيئاً، بفضلك

266
00:17:35,150 --> 00:17:37,650
هذا لأنّكِ بذلتُم مجهوداً جميعاً

267
00:17:37,820 --> 00:17:40,380
!أنتِ مُذهلة حقّاً

268
00:17:40,550 --> 00:17:43,410
!أنتِ ذكيّة ورياضيّة

269
00:17:43,580 --> 00:17:45,350
ليس إلى هذه الدّرجة

270
00:17:58,750 --> 00:18:03,750
أنا فاشلة كمصّاصة دماء

271
00:18:05,620 --> 00:18:09,980
كلّ ما فعلتُه كان الدّراسة
للانسجام مع الجميع

272
00:18:10,750 --> 00:18:12,080
...لونا-تشان

273
00:18:12,250 --> 00:18:13,560
!فتاة طيّبة

274
00:18:13,730 --> 00:18:16,420
!لا بُدّ أنّكِ عملتِ بجدّ

275
00:18:16,590 --> 00:18:18,910
أنتِ تُبالغين

276
00:18:19,080 --> 00:18:20,080
!حسناً

277
00:18:20,250 --> 00:18:22,740
سنبذل قصارى جهدنا بأنفسنا
!تحضيراً للبطولة الإقليميّة

278
00:18:23,090 --> 00:18:26,090
لا يمكننا الاعتماد عليكِ للأبد

279
00:18:28,410 --> 00:18:29,410
!أجل

280
00:18:30,350 --> 00:18:33,090
قرقرة

281
00:18:35,630 --> 00:18:37,450
...ا-المعذرة

282
00:18:37,620 --> 00:18:38,620
ماذا؟

283
00:18:38,840 --> 00:18:43,180
،كعربون شكر على اليوم
ما رأيكِ بدمي؟

284
00:18:48,180 --> 00:18:52,000
!يمكن أن تكون مُكافأتك للعمل بجدّ

285
00:18:52,170 --> 00:18:56,210
أنا سعيدة على أيّ حال، لكن
!عليكِ أن تعملي بجدّ أيضاً

286
00:18:57,240 --> 00:18:59,710
!بالتّوفيق في البطولة

287
00:19:00,910 --> 00:19:01,990
...لذا

288
00:19:02,160 --> 00:19:04,490
ظريفة للغاية

289
00:19:04,660 --> 00:19:09,250
!ساكوما! إلى أين أنتِ ذاهبة؟

290
00:19:11,670 --> 00:19:14,500
بما أنّكِ عملتِ بجدّ، ستحصلين
!على عدّة فُرص للاستئناف

291
00:19:19,670 --> 00:19:20,740
!أوتوري

292
00:19:22,400 --> 00:19:23,470
آسفة بشأن ذلك

293
00:19:23,640 --> 00:19:27,410
أقحمتُك معي طوال هذا الوقت
كي أطّلع على النّوادي

294
00:19:28,050 --> 00:19:32,060
نادراً ما أحظى بفُرصة لتفقّد نوادٍ
جديدة، لذا استمتعت

295
00:19:34,140 --> 00:19:35,630
هل ستنضمّين لفريق كُرة الطّائرة؟

296
00:19:36,390 --> 00:19:37,550
لا

297
00:19:37,990 --> 00:19:41,740
كان ذلك مُمتعاً، لكن قالت ساكوما
بأنّهن سيعملن بجدّ بمفردهن

298
00:19:42,900 --> 00:19:43,990
هكذا إذاً

299
00:19:44,410 --> 00:19:48,180
فضلاً عن ذلك، هذا ليس ما أريده
خارج نطاق النّادي

300
00:19:48,350 --> 00:19:50,220
تقصدين القدرة على امتصاص الدّماء؟

301
00:19:50,390 --> 00:19:52,250
...هذا أيضاً، لكن

302
00:19:52,820 --> 00:19:54,850
،أوّلاً، يجب أن تكون الإضاءة خفيفة

303
00:19:55,020 --> 00:19:56,990
بوجود عدد قليل جدّاً من النّاس

304
00:19:57,270 --> 00:19:58,310
هكذا إذاً

305
00:19:58,480 --> 00:20:02,760
،جهتي للشّمال، في الطّابق الثّاني أو أعلى
مع مُكيّف وتدفئة، في غرفة زاوية

306
00:20:02,930 --> 00:20:04,340
هل ستنتقلين؟

307
00:20:04,830 --> 00:20:10,730
،قد يكون لدى هذه المدرسة الكثير من النّوادي
...لكن لا أعتقد بأنّكِ ستجدين

308
00:20:13,980 --> 00:20:16,810
غرفة الرّسم

309
00:20:16,980 --> 00:20:18,340
نادي الرّسم؟

310
00:20:18,510 --> 00:20:19,510
أجل

311
00:20:20,790 --> 00:20:23,610
...تخرّج كافّة أعضاء السّنة الأخيرة

312
00:20:24,220 --> 00:20:26,280
لذا الآن، لا يوجد سوايّ

313
00:20:26,550 --> 00:20:28,620
رئيس النّادي

314
00:20:28,790 --> 00:20:29,830
!وجدتُها

315
00:20:30,000 --> 00:20:31,080
ماذا؟

316
00:20:31,250 --> 00:20:32,660
!كان ينبغي أن تخبرني قبلاً

317
00:20:32,830 --> 00:20:34,160
!سأنضمّ

318
00:20:34,330 --> 00:20:35,330
ماذا؟

319
00:20:35,700 --> 00:20:38,800
،إضاءة خفيفة، عدد قليل من النّاس
،جهة الشّمال

320
00:20:38,970 --> 00:20:42,210
الطّابق الثّاني، مُكيّف وتدفئة، وفي غرفة زاوية

321
00:20:42,380 --> 00:20:44,590
!علامة صحّ عند كلّ خانة

322
00:20:44,820 --> 00:20:49,090
ناهيك عن أنّك هنا، لذا يمكنني
!التمرّن كما أشاء

323
00:20:49,260 --> 00:20:50,850
...اختطاف النّادي

324
00:20:51,490 --> 00:20:54,320
سأقوم بكافّة أعمال أعضاء
!نادي الرّسم أيضاً

325
00:20:54,490 --> 00:20:57,980
حسناً، ليس وكأنّني أفعل
الكثير هنا على أيّ حال

326
00:20:58,830 --> 00:21:00,030
لكن هل أنتِ متأكّدة؟

327
00:21:00,200 --> 00:21:01,220
ماذا تقصد؟

328
00:21:01,900 --> 00:21:06,820
،أعلم بأنّكِ تريدين طريقة مضمونة
لكن هناك الكثير من النّوادي الأُخرى

329
00:21:07,050 --> 00:21:10,050
وعلى أيّ حال، أنا الوحيد هنا

330
00:21:10,620 --> 00:21:11,830
ألن تكون الأجواء مُملّة؟

331
00:21:14,630 --> 00:21:17,150
...في الواقع، حتّى لو كانت كذلك

332
00:21:19,140 --> 00:21:23,130
...هذا ما يُعجبني في الأمر

333
00:21:23,300 --> 00:21:24,300
ماذا؟

334
00:21:24,870 --> 00:21:26,920
...في الواقع

335
00:21:27,090 --> 00:21:30,470
أيضاً، إذا كنتُ سأتمرّن، فقد
!أشرب دماً لذيذاً كذلك

336
00:21:30,640 --> 00:21:32,250
هـ-هكذا إذاً

337
00:21:34,620 --> 00:21:38,090
إذا أردتِ الانضمام، فهذا يُسعدني

338
00:21:38,260 --> 00:21:39,970
يمكنكِ الخروج والتنزّه معي متى أردتِ

339
00:21:40,820 --> 00:21:41,860
!أجل

340
00:21:49,120 --> 00:21:52,270
!حان الوقت ليوم شاقّ آخر من التّدريب

341
00:21:55,550 --> 00:21:58,510
إنّها كقطّة تعترض طريقي أثناء العمل

342
00:23:31,050 --> 00:23:33,750
الحلقة القادمة من
:الآنسة الصّغيرة مصّاصة الدّماء لا تُحسِن الامتصاص

343
00:23:34,310 --> 00:23:35,400
الآنسة الصّغيرة مصّاصة الدّماء ودرس الطّبخ

344
00:23:35,570 --> 00:23:36,580
الآنسة الصّغيرة مصّاصة الدّماء ودرس الطّبخ
إجازة الآنسة الصّغيرة مصّاصة الدّماء
- الآنسة الصّغيرة مصّاصة الدّماء ودرس الطّبخ

345
