1
00:00:20,030 --> 00:00:25,870
يومٌ حارّ آخر، فرصة مثالية للمرور
بمنزل الأرانب لقهوة مثلّجة

2
00:00:45,200 --> 00:00:45,870
ماذا؟

3
00:00:47,120 --> 00:00:49,620
قهوة مبرّدة"؟"

4
00:00:50,990 --> 00:00:52,830
!مساء الخير

5
00:00:54,030 --> 00:00:55,450
!مرحباً

6
00:00:55,450 --> 00:00:57,740
!لدينا قهوة لذيذة مُبرّدة

7
00:00:58,160 --> 00:01:01,160
!ذهبتُ لـ "أما أوسا" عن طريق الخطأ

8
00:01:01,160 --> 00:01:03,410
!كلا، لم تخطئي

9
00:01:16,080 --> 00:01:19,240
هذا الزيّ الذي يُشعرني بأكبر ارتياح

10
00:01:19,580 --> 00:01:23,240
ظننتُ أنّ اليوكاتا كان فكرةً حسنة
بما أنّه بارد المظهر والملبس

11
00:01:23,620 --> 00:01:25,030
!أجل، هذا أفضل جزء

12
00:01:25,330 --> 00:01:29,410
يسألني الزبائن دوماً ما إن كنت
أشعر بحرارة في هذا الزيّ

13
00:01:29,580 --> 00:01:31,450
كم مرّةً سألوك يا ريزي-تشان؟

14
00:01:31,450 --> 00:01:33,160
مرّتان فحسب حتّى الآن هذا العام

15
00:01:33,160 --> 00:01:34,530
!أنا أربع مرّات

16
00:01:34,990 --> 00:01:36,740
أنا 23 مرّة

17
00:01:36,990 --> 00:01:38,740
!تيبّي هو الفائز

18
00:01:38,740 --> 00:01:41,410
ربما نزع السترة والشريط سيساعد قليلاً

19
00:01:43,330 --> 00:01:45,080
قهوة مبرّدة"؟"

20
00:01:45,080 --> 00:01:48,330
ما الفرق بينها والقهوة المثلّجة يا ترى؟

21
00:01:49,410 --> 00:01:51,530
!كأسا قهوة مبرّدتان من فضلكم

22
00:01:51,530 --> 00:01:53,660
إنّها باردة بحيث تكاد تكون مُجمّدة

23
00:01:53,870 --> 00:01:56,410
ماذا؟ أأنتن الموظّفات الجديدات؟

24
00:01:56,410 --> 00:01:58,080
أين كوكوا والبقيّة؟

25
00:01:58,080 --> 00:02:01,530
لا أرى أيّ ورديّ أو بنفسجيّ أو أزرق

26
00:02:01,990 --> 00:02:04,080
...تعرّفان علينا باللون فحسب

27
00:02:08,370 --> 00:02:11,080
هذا باردٌ كالثلج حقّاً

28
00:02:12,280 --> 00:02:14,780
يبدو أنّنا بحاجة لستراتنا في النهاية

29
00:02:14,780 --> 00:02:17,080
!من المهم الالتزام بلونك المميّز

30
00:02:17,160 --> 00:02:22,580
من العوامل الجذّابة في منزل الأرانب
هو تنوّع ألوان الأزياء

31
00:02:22,740 --> 00:02:24,160
...تنوّع الألوان

32
00:02:24,280 --> 00:02:26,700
...سنبقى على هذه الأزياء إذاً كالمعتاد

33
00:02:26,700 --> 00:02:27,780
!وجدتُها

34
00:02:28,030 --> 00:02:30,030
!يمكننا صنعها فحسب

35
00:02:30,030 --> 00:02:30,660
ماذا؟

36
00:02:32,780 --> 00:02:35,160
نصنعها بأنفسنا؟

37
00:02:35,450 --> 00:02:39,200
!هذا وقت توحيد قوانا نحن الثلاثة

38
00:02:39,200 --> 00:02:40,450
!حسناً

39
00:02:40,740 --> 00:02:42,490
!سننشر البرود

40
00:02:42,660 --> 00:02:45,780
!لنجتهد ونصنع أزياء صيفية

41
00:02:45,780 --> 00:02:47,490
!أجل

42
00:02:47,830 --> 00:02:49,990
...هذا المقهى

43
00:02:49,990 --> 00:02:51,910
!يصبح مختنقاً نوعاً ما

44
00:02:52,580 --> 00:02:54,530
...زيّ صيفي

45
00:03:00,620 --> 00:03:02,780
تعاني كوكوا من إجهاد حرارة بالفعل

46
00:03:02,780 --> 00:03:05,240
اشتعلت سريعاً

47
00:03:05,410 --> 00:03:07,780
لم نصل المتجر بعد حتّى

48
00:03:11,030 --> 00:03:11,830
!خذي

49
00:03:11,830 --> 00:03:12,990
شكراً

50
00:03:14,200 --> 00:03:17,410
لنبدأ بالعثور على قمصان قصيرة الأكمام وتنوّرات اعتيادية

51
00:03:17,410 --> 00:03:18,870
يمكننا شراء تلك فحسب

52
00:03:19,120 --> 00:03:22,460
...بعدها سنشتري قماشاً لصنع السترات بأنفسنا

53
00:03:23,490 --> 00:03:25,660
!كنتِ تتظاهرين فحسب

54
00:03:25,660 --> 00:03:27,830
...ليس صحيحاً

55
00:03:30,200 --> 00:03:33,450
!إذا كنتِ تشعرين بتوعّك حقّاً سأحملك، اصعدي

56
00:03:33,450 --> 00:03:36,410
!كلا! ليس أمام تشينو-تشان

57
00:03:36,990 --> 00:03:41,080
يبدو خاطئاً... إنّه محرج

58
00:03:41,280 --> 00:03:44,030
كلماتك وأفعالك متناقضان

59
00:03:44,450 --> 00:03:47,280
يا إلهي، لا أمل فيك

60
00:03:48,370 --> 00:03:50,080
!ثـ-ثقيل جدّاً

61
00:03:50,280 --> 00:03:52,740
!لا يمكنني حملكما معاً

62
00:03:58,660 --> 00:04:00,530
أُنهكت ريزي-سان

63
00:04:00,530 --> 00:04:03,740
هذا لأنّها حملتنا إلى هنا

64
00:04:08,490 --> 00:04:11,780
لن نتمكن من إدخالها عبر ذلك

65
00:04:12,410 --> 00:04:13,530
كلا

66
00:04:14,580 --> 00:04:18,030
...لا أزال أملك اللياقة

67
00:04:30,200 --> 00:04:31,330
!ريزي-سان

68
00:04:32,410 --> 00:04:37,280
!لم أنته بعد، لا أنسحب أمام أيّ عدو

69
00:04:39,580 --> 00:04:40,700
شارو؟

70
00:04:41,030 --> 00:04:43,370
تراجعي فحسب يا ريزي-سينباي

71
00:04:43,950 --> 00:04:45,910
!هذه ساحة معركتي

72
00:04:46,870 --> 00:04:50,030
نحتاج قمصان قصيرة الأكمام... وتنوّرات رجاءً

73
00:04:50,870 --> 00:04:51,780
!حسناً

74
00:04:59,120 --> 00:05:01,120
...أهلٌ للمسؤولية

75
00:05:04,030 --> 00:05:07,160
عجباً، أتيتنّ هنا أيضاً؟

76
00:05:07,160 --> 00:05:08,330
!تشيا-تشان

77
00:05:09,700 --> 00:05:10,870
فهمت

78
00:05:11,080 --> 00:05:15,080
أتيتنّ لشراء تجهيزات لصنع
أزياء صيفية لمنزل الأرانب

79
00:05:15,080 --> 00:05:17,370
!تمكّنتُ من الحصول على القمصان والتنورات

80
00:05:17,370 --> 00:05:18,530
!شارو-تشان

81
00:05:18,530 --> 00:05:20,200
!كنتِ قويّة جدّاً

82
00:05:20,200 --> 00:05:21,780
!كان قتالاً مذهلاً

83
00:05:21,990 --> 00:05:26,240
أرى تعاونكنّ لصنع أزيائكن
الصيفية الخاصّة أمراً رائعاً

84
00:05:26,490 --> 00:05:29,120
يبدو حميمياً، أشعر بالغيرة

85
00:05:29,450 --> 00:05:32,530
!عليكما صنع أزيائكما المتطابقة الخاصة إذاً

86
00:05:32,530 --> 00:05:35,240
"لكنّي لستُ مهتمة بالعمل في "أما أوسا آن

87
00:05:35,240 --> 00:05:35,950
!ماذا؟

88
00:05:38,490 --> 00:05:40,450
!تمهلي! ما المشكلة؟

89
00:05:40,450 --> 00:05:41,740
!شارو-تشان، كيف لك؟

90
00:05:42,620 --> 00:05:44,530
إنّهما منهمكتان دوماً

91
00:05:54,910 --> 00:05:58,160
تروقني هذه الدرجة من الأزرق، تشبه لوني الحاليّ

92
00:05:58,370 --> 00:06:00,280
!وجدتُ بنفسجياً جميلاً بدوري

93
00:06:01,990 --> 00:06:03,200
...لا قماش ورديّ

94
00:06:04,160 --> 00:06:05,200
هل نفد؟

95
00:06:05,200 --> 00:06:06,200
!محال

96
00:06:06,200 --> 00:06:07,280
!لا يمكن

97
00:06:07,280 --> 00:06:09,490
...لا يمكن تخيّل كوكوا-سان بلا ورديّ

98
00:06:10,280 --> 00:06:12,030
!هذا ورديّ فاقع

99
00:06:12,450 --> 00:06:14,490
!وهذا منقّط

100
00:06:18,620 --> 00:06:21,240
ما رأيكما بقماش لامع خفيف؟

101
00:06:22,450 --> 00:06:24,330
تتوقين لجذب الانتباه حقّاً

102
00:06:27,080 --> 00:06:29,580
!كوكوا-سان، لا يمكنك الاستسلام

103
00:06:29,870 --> 00:06:31,830
!لنبحث في بقيّة المتاجر

104
00:06:32,620 --> 00:06:33,910
...تشينو-تشان

105
00:06:35,830 --> 00:06:36,990
!أنتِ محقّة

106
00:06:43,740 --> 00:06:45,620
أأنتِ بخير يا تشينو-تشان؟

107
00:06:45,620 --> 00:06:48,450
أ-أشعر ببعض الإرهاق فحسب

108
00:06:48,870 --> 00:06:50,660
لنذهب للمحلّ التالي بسرعة

109
00:06:50,660 --> 00:06:52,530
لا تضغطي على نفسك

110
00:06:52,780 --> 00:06:57,330
يا للمشكلة، زرنا محلّات عديدة لكن
لم نجد اللون الورديّ المثاليّ

111
00:06:57,330 --> 00:07:00,580
وسينتهي الصيف عند وصوله للسوق

112
00:07:02,870 --> 00:07:04,620
ما هذا يا تشينو-تشان؟

113
00:07:05,910 --> 00:07:07,740
...إنّه

114
00:07:11,990 --> 00:07:14,120
أحتاج وقتاً لاستيعاب هذا

115
00:07:14,950 --> 00:07:17,240
!هذا ظريفٌ جدّاً

116
00:07:17,620 --> 00:07:19,700
هل سهرتِ لرسمه؟

117
00:07:23,700 --> 00:07:25,910
هذا يفسّر إرهاقك

118
00:07:26,870 --> 00:07:29,740
!حسنٌ، دعي الأمر لأختك الكبيرة فحسب

119
00:07:32,080 --> 00:07:34,660
!لا تكوني خجولة! مرحباً هيّا

120
00:07:34,660 --> 00:07:36,370
!ما قصدك أصلاً؟

121
00:07:37,580 --> 00:07:39,330
حصلتُ على ما كنت أسعى وراءه

122
00:07:39,660 --> 00:07:42,160
!عطلتك الصيفية أصبحت لي الآن

123
00:07:42,620 --> 00:07:44,780
!انتظر أيّها اللصّ الشبح لوبان

124
00:07:44,780 --> 00:07:47,370
!أعد عطلتي الصيفية

125
00:07:47,450 --> 00:07:49,660
!لا شيء لا أستطيع سرقته

126
00:07:51,450 --> 00:07:53,410
غيّرتُ رأيي، فلتنزليني

127
00:07:53,410 --> 00:07:54,580
كلا

128
00:07:55,120 --> 00:07:59,240
لكن علينا الإسراع وإيجاد القماش الورديّ المثالي

129
00:08:00,280 --> 00:08:02,240
لا تروقني فكرة اللمعان مع ذلك

130
00:08:02,740 --> 00:08:04,700
لا داعي للعجلة

131
00:08:05,160 --> 00:08:08,080
!سنتدبّر الأمر، سنجده في مكان حتماً

132
00:08:08,370 --> 00:08:09,740
...في مكان

133
00:08:09,950 --> 00:08:11,870
!أجل! في مكان

134
00:08:12,160 --> 00:08:12,870
ماذا؟

135
00:08:13,080 --> 00:08:14,280
ما الخطب؟

136
00:08:20,830 --> 00:08:22,780
ماذا تفعلين في المخزن؟

137
00:08:23,080 --> 00:08:27,370
حسناً... أشعر أنّي رأيته هنا قبلاً

138
00:08:27,780 --> 00:08:28,530
رأيتِ ماذا؟

139
00:08:29,830 --> 00:08:31,490
!عدّة سحر

140
00:08:31,700 --> 00:08:33,030
...كلا

141
00:08:33,530 --> 00:08:35,280
لمَ توجد عدّة سحر هنا؟

142
00:08:35,490 --> 00:08:36,870
إنّها هواية أمّي

143
00:08:37,030 --> 00:08:38,490
!لعبة أرنب

144
00:08:39,780 --> 00:08:42,410
لعبة قديمة كنتُ ألعب فيها مع أمّي

145
00:08:42,530 --> 00:08:43,910
أنا من اشتراها

146
00:08:44,200 --> 00:08:47,780
لكن يبدو أنّ هذه الغرفة
بحاجة لبعض التنظيم

147
00:08:47,780 --> 00:08:49,160
الفوضى عارمة

148
00:08:49,160 --> 00:08:50,200
...أجل

149
00:08:50,990 --> 00:08:52,030
!وجدتُه

150
00:08:53,030 --> 00:08:54,410
!انظرا! هذا

151
00:08:54,740 --> 00:08:57,620
كنتُ أعرف أنّه في
!مكانٍ ما في المخزن

152
00:08:58,030 --> 00:09:00,450
!إ-إنّه الورديّ المثالي

153
00:09:00,870 --> 00:09:03,450
لا بدّ أنّ أمّك تركت هذا القماش

154
00:09:03,580 --> 00:09:06,410
يمكننا صنع سترة لكوكوا-سان الآن

155
00:09:09,030 --> 00:09:13,490
!أمّي! شكراً لك

156
00:09:13,490 --> 00:09:15,580
كانت أمّي

157
00:09:15,910 --> 00:09:18,490
!كـ-كوكوا... انظري للجانب الخلفيّ

158
00:09:21,030 --> 00:09:22,330
ما هذا؟

159
00:09:22,490 --> 00:09:25,080
ليست مشكلة، إنّه قماش قابل للقلب

160
00:09:26,530 --> 00:09:28,830
حسناً، وقت أخذ القياسات

161
00:09:29,120 --> 00:09:30,240
!حاضر سيّدي

162
00:09:31,450 --> 00:09:35,580
،أنوي امتلاك انحناءات جذّابة بعد 10 سنين
!لذا لتعطيني مساحة إضافية

163
00:09:35,580 --> 00:09:37,120
!سترتدينه لعشرة أعوام؟

164
00:09:37,780 --> 00:09:40,990
أيعني هذا أنّك تنوين العمل هنا لعشرة أعوام؟

165
00:09:42,450 --> 00:09:43,620
كنتُ أتصرّف بسخافة فحسب

166
00:09:43,620 --> 00:09:46,580
حسناً، أنا آخذ مستقبلي على
محمل الجدّ بخلافك

167
00:10:16,660 --> 00:10:18,370
...بعد 10 أعوام

168
00:10:20,030 --> 00:10:22,830
ما الذي سنصبح عليه يا ترى؟

169
00:10:24,410 --> 00:10:25,830
...حسناً، لنرَ

170
00:10:26,370 --> 00:10:32,330
المخزن مليءٌ بالأغراض، لذا أظنّ أنّنا سنبيع بعضها
لمتجر توفير في بروكانت لهذا العام

171
00:10:32,580 --> 00:10:34,240
في سوق البضائع المستعملة؟

172
00:10:34,620 --> 00:10:35,780
إنّها فكرة حسنة

173
00:10:36,080 --> 00:10:40,910
من الأفضل جمع الأشياء بأشخاص يهتمون بها
بدل تركها تجمع الغبار

174
00:10:41,240 --> 00:10:43,080
معك حق

175
00:10:43,080 --> 00:10:46,700
سيكون من الرائع لو اشترى أحدهم الأرنب الشيطان

176
00:10:46,700 --> 00:10:49,240
...حسناً، أتساءل لو سيحصل ذلك

177
00:10:49,370 --> 00:10:50,830
كنتُ أقصدك يا أبي

178
00:10:50,830 --> 00:10:52,700
!ماذا؟

179
00:10:54,330 --> 00:10:56,950
لا تقلق، سأطلب مبلغاً كبيراً

180
00:11:00,410 --> 00:11:03,740
!منزل الأرانب لليوم مختلف عن المعتاد

181
00:11:04,240 --> 00:11:06,450
!أهلاً وسهلاً

182
00:11:07,200 --> 00:11:08,990
!أنهيتُ ترتيب البضائع

183
00:11:09,450 --> 00:11:11,580
!نشرتُ قوّاتي

184
00:11:11,990 --> 00:11:14,120
كما وضعتُ ثيابي القديمة

185
00:11:14,120 --> 00:11:18,030
تركنا مجال القهوة وحوّلنا منزل
!الأرانب لمتجر سلع زهيدة

186
00:11:18,120 --> 00:11:19,910
!لم نترك القهوة

187
00:11:28,160 --> 00:11:31,080
بدأت بقيّة المتاجر تكتظ

188
00:11:32,530 --> 00:11:34,030
ما خطب هذا العبوس؟

189
00:11:34,740 --> 00:11:37,530
هل... سيريد أحد شراء هذا حقّاً

190
00:11:38,120 --> 00:11:41,450
جلبتُ مختلف الأشياء، لكن ربما بلا معنى

191
00:11:41,660 --> 00:11:44,030
!أظهرا الابتسامة أنتما

192
00:11:47,120 --> 00:11:50,660
!أهذا منزليّ الصنع؟ يا لموهبتكن

193
00:11:50,660 --> 00:11:52,740
سأشتريه لحفيدتي

194
00:11:52,740 --> 00:11:55,120
شـ-شكراً جزيلاً

195
00:11:55,450 --> 00:11:56,240
!رائع

196
00:11:56,580 --> 00:11:57,950
!هذه الابتسامات الجميلة

197
00:12:00,240 --> 00:12:02,030
!بـ-بعنا

198
00:12:02,580 --> 00:12:03,950
فعلنا

199
00:12:05,580 --> 00:12:11,450
يمكننا تولّي زمام الأمور هنا، اذهبي في جولة
حول بقيّة المتاجر بينما لديكِ الفرصة

200
00:12:11,450 --> 00:12:12,450
أيمكنني؟

201
00:12:12,580 --> 00:12:16,030
بالطبع! هذه أوّل مرة لك في بروكانت، صحيح؟

202
00:12:16,280 --> 00:12:17,830
!مرحى

203
00:12:21,740 --> 00:12:24,330
!أشياء كثيرة تجذب اهتمامي

204
00:12:24,330 --> 00:12:26,990
!يمكنني التسوّق هنا لأيام

205
00:12:28,830 --> 00:12:30,410
!ماذا؟ تشيا-تشان

206
00:12:30,870 --> 00:12:31,950
!كوكوا-تشان؟

207
00:12:32,660 --> 00:12:34,580
يبدو أنّك تحظين بوقتٍ ممتع

208
00:12:34,580 --> 00:12:36,330
...حسناً، هذه

209
00:12:37,700 --> 00:12:40,950
!تشيا! وجدتُ صفقة أخرى

210
00:12:40,950 --> 00:12:42,080
شارو-تشان؟

211
00:12:42,370 --> 00:12:43,280
كوكوا؟

212
00:12:44,740 --> 00:12:45,950
...تحمّستُ بشكل مبالغ به قليلاً

213
00:12:47,080 --> 00:12:50,990
يغلب الحماس هذه الأميرة الصغيرة
عندما تكون في بروكانت

214
00:12:52,530 --> 00:12:54,740
اليوم هو يومٌ ألتقي فيه الكثير
!من الخزفيات الرائعة

215
00:12:54,740 --> 00:12:56,950
!لذا عليّ التزيّن قليلاً لملائمتها

216
00:12:57,530 --> 00:13:00,080
!أستشعر هالةً ملكيّة منك حقّاً

217
00:13:00,080 --> 00:13:02,200
حسناً يا تشيا، لننتقل للمتجر التالي

218
00:13:03,370 --> 00:13:05,580
أيمكني الاستراحة قليلاً؟

219
00:13:05,910 --> 00:13:06,530
!تشيا؟

220
00:13:06,740 --> 00:13:09,120
!كأس شاي الأرنب الملكيّ

221
00:13:09,490 --> 00:13:10,580
!يا للتفاني

222
00:13:13,030 --> 00:13:14,200
...شارو-تشان

223
00:13:14,450 --> 00:13:17,910
هذا الكأس أكثر أهمية عندك منّي، صحيح؟

224
00:13:17,910 --> 00:13:19,950
!يا إلهي، يا لإزعاجك

225
00:13:20,120 --> 00:13:23,080
!حسناً، هلمّوا! لدينا أفضل الأسعار

226
00:13:23,080 --> 00:13:25,370
ذاك المتجر مليء بالزبائن

227
00:13:25,370 --> 00:13:26,530
إنّه متجر خصومات

228
00:13:26,830 --> 00:13:30,200
يحفّزون الناس لشراء بضائعهم
بالكلام المُنمّق والمساومات

229
00:13:30,200 --> 00:13:32,030
هذه إحدى طرق التجارة

230
00:13:32,030 --> 00:13:33,330
!رائع جدّاً

231
00:13:33,330 --> 00:13:34,870
أتظنّان بإمكاني فعل ذلك؟

232
00:13:34,870 --> 00:13:37,410
...حسناً، البائع المروّج يكون عادةً

233
00:13:38,330 --> 00:13:41,160
!هلمّوا وانظروا

234
00:13:41,410 --> 00:13:44,080
!كان عليّ جلب مروحتي الورقية

235
00:13:44,080 --> 00:13:45,490
لديك مروحة ورقيّة؟

236
00:13:46,370 --> 00:13:49,410
!ماذا؟ لا تملكين مروحة ورقيّة؟

237
00:13:49,410 --> 00:13:50,120
!ماذا؟

238
00:13:50,660 --> 00:13:52,950
إنّها ضرورية لأيّ ثنائي طريف مثلنا

239
00:13:52,950 --> 00:13:53,700
!مستحيل

240
00:13:54,410 --> 00:13:57,160
عليّ العودة لتشينو-تشان وريزي

241
00:13:57,160 --> 00:13:59,240
ماذا؟ أتيتا أيضاً؟

242
00:13:59,240 --> 00:14:01,330
أين تقومان بالبيع؟

243
00:14:01,330 --> 00:14:02,620
اتبعاني

244
00:14:02,620 --> 00:14:05,700
لا بدّ أنّ تشينو-تشان وريزي-تشان تبيعان
والابتسامة تعلو وجهيهما

245
00:14:08,990 --> 00:14:10,910
!عبوس شديد

246
00:14:10,910 --> 00:14:12,120
...عجباً

247
00:14:12,280 --> 00:14:15,080
يظنّ الجميع أنّنا نبيع خرداً فحسب بالتأكيد

248
00:14:15,080 --> 00:14:16,990
!لكنّها رائعة جدّاً

249
00:14:16,990 --> 00:14:18,200
رائعة؟

250
00:14:18,200 --> 00:14:20,240
عليكما امتلاك جاذبيّة أكبر

251
00:14:22,030 --> 00:14:25,740
!لنريهما! هكذا نقوم بالبيع

252
00:14:25,740 --> 00:14:28,410
!أجل

253
00:14:27,160 --> 00:14:28,410
!أشبه بنمط كوميديّ

254
00:14:29,660 --> 00:14:31,280
!أهلاً وسهلاً

255
00:14:32,490 --> 00:14:36,120
للعبة الأرنب هذه تعابير رائعة، ألا تتفقين؟

256
00:14:36,330 --> 00:14:38,580
يمكنك استشعار شغف الحرفيّ منها

257
00:14:39,160 --> 00:14:40,950
...بقولكِ ذلك

258
00:14:40,950 --> 00:14:42,580
حسناً، سآخذ واحدة

259
00:14:42,830 --> 00:14:44,160
!شكراً جزيلاً

260
00:14:44,410 --> 00:14:48,910
مئة فحسب؟ سآكل براع فاصولياء مقليّة
!على العشاء بهذا السعر

261
00:14:49,160 --> 00:14:50,580
مئتين إذاً

262
00:14:50,580 --> 00:14:51,870
!حسناً، بِيعت

263
00:14:52,370 --> 00:14:55,700
لا يمكنكم تنفيذ هجومهما القاضي إلّا
!إذا اشتريتم المجموعة

264
00:14:55,700 --> 00:14:57,660
!سأشتري! سأشتري

265
00:14:57,660 --> 00:14:58,740
!شكراً

266
00:14:59,240 --> 00:15:01,660
تلمعن ثلاثتهنّ تماماً

267
00:15:01,950 --> 00:15:04,280
يصعب تصديق أنّ عملهنّ هو
نادلات في مقهى

268
00:15:04,660 --> 00:15:06,200
عمل دوام جزئيّ مع ذلك

269
00:15:06,700 --> 00:15:09,370
حسنٌ، سأبذل قصارى جهدي
!لجذب زبائن أكثر أيضاً

270
00:15:10,370 --> 00:15:12,530
ما-ما الذي يُفترض بي فعله؟

271
00:15:13,330 --> 00:15:14,370
!تشينو

272
00:15:15,580 --> 00:15:18,240
!مشكلة! انفصلت هذه الصغيرة عن أمّها

273
00:15:18,240 --> 00:15:18,740
ماذا؟

274
00:15:19,030 --> 00:15:22,620
!سأبحث عن أمّها، احرسيها مكاني يا تشينو

275
00:15:22,620 --> 00:15:24,870
!ماذا؟ انتظري، ريزي-سان

276
00:15:41,450 --> 00:15:43,780
...لا-لا تبكي رجاءً

277
00:15:47,280 --> 00:15:48,740
...حسناً، لنرَ

278
00:15:49,160 --> 00:15:50,450
!حسنٌ

279
00:15:51,990 --> 00:15:53,530
!انظري

280
00:15:53,990 --> 00:15:56,450
!يمكن لهذه العصا السحرية التمدد

281
00:15:57,080 --> 00:15:57,990
!أتمنّى

282
00:16:03,950 --> 00:16:05,950
...إ-إذاً

283
00:16:06,370 --> 00:16:10,700
إذا واصلتِ البكاء هكذا، ستصبح عيناك
مثل عينيّ الأرنب

284
00:16:11,450 --> 00:16:12,950
الأرنب؟

285
00:16:13,160 --> 00:16:14,780
صـ-صحيح

286
00:16:15,240 --> 00:16:16,200
...إذاً

287
00:16:16,870 --> 00:16:18,280
هكذا

288
00:16:19,240 --> 00:16:21,700
لكنّ عيّناه ليستا مُحمرتان

289
00:16:21,870 --> 00:16:23,830
صـ-صحيح

290
00:16:24,240 --> 00:16:27,410
فـ-في الواقع، يمكن لهذا الأرنب
الضحك من تلقاء نفسه

291
00:16:36,330 --> 00:16:37,580
!إنّه غريب

292
00:16:39,990 --> 00:16:41,410
بالفعل

293
00:16:42,200 --> 00:16:44,240
هاك، يمكنك أخذه

294
00:16:44,700 --> 00:16:45,950
حقّاً؟

295
00:16:48,580 --> 00:16:50,410
!تشينو

296
00:16:50,870 --> 00:16:51,910
!ريزي-سان

297
00:16:52,160 --> 00:16:53,700
!وجدتُها

298
00:16:54,830 --> 00:16:56,660
!أمّي

299
00:17:06,370 --> 00:17:08,490
!شكراً لك يا أختي الكبيرة

300
00:17:10,330 --> 00:17:11,740
..."أختي الكبيرة"

301
00:17:12,490 --> 00:17:14,330
من الرائع أنّها أخذت الأرنب يا تشينو

302
00:17:14,330 --> 00:17:16,780
أجل، بدا أنّه أعجبها

303
00:17:19,660 --> 00:17:22,990
أظنّها ستُحسن الاعتناء به

304
00:17:24,530 --> 00:17:25,410
أجل

305
00:17:31,200 --> 00:17:32,950
!عمل موفق جميعاً

306
00:17:33,240 --> 00:17:35,080
!عمل موفق

307
00:17:37,160 --> 00:17:38,780
...بالمناسبة

308
00:17:38,780 --> 00:17:42,870
لديّ هدايا لتشينو-تشان وريزي-تشان
بما أنّهما حرستا المحلّ

309
00:17:43,240 --> 00:17:44,830
!شكراً لك

310
00:17:46,490 --> 00:17:49,370
!اشتريتُ الكثير لأنّها بدت جميلة جدّاً

311
00:17:49,990 --> 00:17:51,410
!مقابض أبواب؟

312
00:17:52,080 --> 00:17:56,620
إذا فكّرت بعقلانية، لا يصعب معرفة لمَ
يوجد الكثير من الخرد هنا

313
00:17:56,870 --> 00:17:58,030
هكذا هي الأمور

314
00:17:58,740 --> 00:18:00,700
...لحظة، أهذا

315
00:18:01,910 --> 00:18:04,200
!اشتريتُ إحدى قمصان ريزي-تشان القديمة

316
00:18:04,280 --> 00:18:05,370
!ماذا؟

317
00:18:05,370 --> 00:18:07,530
لكنّي أشعر أنّها جديدة

318
00:18:07,740 --> 00:18:09,080
...أ-أريد واحداً

319
00:18:09,410 --> 00:18:11,450
هل كنتِ ستشترين البعض منّي
أيضاً يا شارو؟

320
00:18:11,450 --> 00:18:13,030
!كلا

321
00:18:13,330 --> 00:18:17,830
لا تلائم ثيابك... مقاسي

322
00:18:18,160 --> 00:18:21,370
تبقّت لديّ بعض الثياب صغيرة المقاس
في الواقع، أأنتِ مهتمة؟

323
00:18:24,810 --> 00:18:28,080
تفوح من هذا القميص رائحة سينباي

324
00:18:28,080 --> 00:18:29,580
!شارو

325
00:18:30,080 --> 00:18:33,080
سأعطي تشينو-تشان الثياب التي
!لم تعد تلائمني إذاً

326
00:18:33,080 --> 00:18:34,910
لـ-لن تبدو جيّدةً عليّ

327
00:18:34,910 --> 00:18:36,990
!الورديّ سيلائمك حتماً

328
00:18:36,990 --> 00:18:38,580
لا

329
00:18:48,660 --> 00:18:50,330
رأيتِ؟ يبدو جميلاً

330
00:18:51,450 --> 00:18:53,870
أعطني بعضاً من ثيابك الآن

331
00:18:53,870 --> 00:18:56,080
!ستكون مجرّد مقايضة في هذه الحالة

332
00:18:57,780 --> 00:19:00,740
تشينو، أجريتُ حسابات أرباحنا اليوم

333
00:19:01,200 --> 00:19:03,030
شكراً جزيلاً

334
00:19:04,370 --> 00:19:05,910
هذا هو الناتج

335
00:19:06,240 --> 00:19:09,200
هذا ربحٌ أعلى من ربح
منزل الأرانب بالعادة

336
00:19:09,450 --> 00:19:12,280
سيتوجب علينا إيجاد طريقة
لجذب زبائن أكثر للمقهى

337
00:19:14,120 --> 00:19:15,740
لا تنفعلي كثيراً

338
00:19:15,740 --> 00:19:17,330
اتركن الأمر لي

339
00:19:18,160 --> 00:19:20,160
!سأستعمل هذه لجعل المقهى حماسياً

340
00:19:20,370 --> 00:19:23,740
عدّة السحر؟ لم يشترها أحد؟

341
00:19:23,910 --> 00:19:27,370
كلا، اشتريتُها أنا لأنّها نالت إعجابي

342
00:19:28,620 --> 00:19:31,660
تعلّمتُ اليوم أنّ لكلّ شيءٍ تاريخه الخاص

343
00:19:32,120 --> 00:19:36,410
لذا أريد صنع تاريخ جديد لكلّ
الأدوات في هذه العدّة السحرية

344
00:19:37,330 --> 00:19:38,780
...تاريخ

345
00:19:39,280 --> 00:19:42,280
حسناً، استمتعي بذلك

346
00:19:42,740 --> 00:19:46,240
!أعطانا تيبّي موافقته! لذا وقت بدء العرض

347
00:19:47,200 --> 00:19:48,240
...إذاً

348
00:19:48,660 --> 00:19:52,160
!مرحباً بكنّ لوقت عرض سحر كوكوا

349
00:19:52,700 --> 00:19:55,830
!بدايةً، وجّهن انتباهكنّ لهذه العصا

350
00:19:55,830 --> 00:19:58,780
سيبدأ تاريخٌ جديد

351
00:19:58,910 --> 00:20:00,950
حمامة؟ أتظنّين حمامةً ستخرج؟

352
00:20:01,160 --> 00:20:02,660
أفضّل رؤية أسد شخصياً

353
00:20:02,660 --> 00:20:03,990
!سيأكلنا

354
00:20:04,410 --> 00:20:07,080
...ستمتدّ هذه العصا سحرياً

355
00:20:13,660 --> 00:20:16,370
حرصتُ على قراءة التعليمات

356
00:20:16,910 --> 00:20:19,200
!حسناً، سأقوم بواحدة أخرى

357
00:20:19,700 --> 00:20:21,410
!حمّستِني للتالية

358
00:20:21,580 --> 00:20:24,830
أنا متأكدة أنّ كوكوا-تشان ستفي بتطلّعاتنا

359
00:20:24,830 --> 00:20:26,740
...تطلّعات الفشل

360
00:20:27,910 --> 00:20:30,870
صفّقن رجاءً إذا استطعتُ إخراج
!أزهار من قبّعتي

361
00:20:32,530 --> 00:20:34,160
!هيّا

362
00:22:19,530 --> 00:22:21,080
!أسلوب الصيف

363
00:22:22,490 --> 00:22:25,580
!كيف يبدو؟ إنّه زيّي الصيفي الجديد

364
00:22:25,910 --> 00:22:27,780
جميل، يلائمك

365
00:22:27,950 --> 00:22:29,700
أجل، ليس سيّئاً

366
00:22:29,910 --> 00:22:33,280
هذه نفس ردّة فعلكما عندما ارتديتُ
!الزيّ لأوّل مرة هنا

367
00:22:35,080 --> 00:22:36,030
حقّاً؟

368
00:22:36,740 --> 00:22:38,910
!تبدوان رائعتان

369
00:22:40,080 --> 00:22:43,450
لكن... أ-ألا يبدو هذا التصميم غريباً قليلاً؟

370
00:22:43,450 --> 00:22:45,280
لا أشعر بثقة عالية فيه

371
00:22:45,450 --> 00:22:47,530
!يبدو جميلاً بما يكفي لترتديه لعشرة أعوام

372
00:22:47,530 --> 00:22:51,200
سنطلب من تشينو-تشان تصميم واحدًا آخر
بعد مضيّ 10 أعوام إذاً

373
00:22:52,120 --> 00:22:54,080
حسناً، وقت التجهّز لفتح المقهى

374
00:22:54,080 --> 00:22:56,490
!سأنشر الحماس في المكان بالسحر مُجدداً اليوم

375
00:22:58,700 --> 00:23:01,700
!لـ-لحظة، كوكوا-سان! ريزي-سان

376
00:23:03,160 --> 00:23:04,700
ماذا يا تشينو-تشان؟

377
00:23:05,490 --> 00:23:09,530
أتطلّع... للعمل معكما

378
00:23:10,280 --> 00:23:11,700
!نحن كذلك

379
00:23:11,700 --> 00:23:12,830
!نتطلّع للعمل معك

380
00:23:18,620 --> 00:23:21,990
لنواصل بذل قصارى جهدنا معاً يا تشينو-تشان

381
00:23:22,990 --> 00:23:24,160
أجل

382
00:23:25,580 --> 00:23:27,530
أشعر أنّ وقتاً طويلاً قد مضى
مذ آخر مرة قمنا بهذا

383
00:23:27,530 --> 00:23:29,240
سئمت من الانتظار

384
00:23:29,240 --> 00:23:32,620
كنتُ أفكّر، أهناك أشخاص يريدون
رؤيتنا نحن الاثنان حقّاً؟

385
00:23:32,700 --> 00:23:35,120
!هناك الكثيرون يريدون رؤيتي