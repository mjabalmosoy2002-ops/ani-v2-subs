214
00:11:48,580 --> 00:11:50,750
!فقدت السيطرة

215
00:11:53,330 --> 00:11:55,420
يمكن أن تكون مامي-تشان لئيمة أحياناً

216
00:11:55,630 --> 00:11:59,420
"لكن لا تقلقي، فسترمز "تشي
في "تشيمامي" لتشينو دوماً

217
00:11:59,630 --> 00:12:02,130
حسناً، شكراً لك يا أختي الكبيرة تشيا

218
00:12:04,540 --> 00:12:06,500
كان ذلك فعّالاً

219
00:12:06,500 --> 00:12:09,000
علينا فعل شيء لتهدئتها

220
00:12:09,500 --> 00:12:12,710
!كوكوا-تشان، تعالي

221
00:12:13,540 --> 00:12:17,920
!يا إلهي! أحكم عليكما بالموت عناقاً

222
00:12:19,920 --> 00:12:21,580
...يا إلهي

223
00:12:54,670 --> 00:12:58,540
،كنتُ متحمّسةً لارتداء زيّ اللصّة الشبحة لابان
لكن أرجو ألّا يبدو مظهري غريباً

224
00:12:58,880 --> 00:13:00,290
مكانك أيّتها اللصّة الشبحة

225
00:13:01,040 --> 00:13:02,380
!أنتِ رهن الاعتقال

226
00:13:02,380 --> 00:13:04,000
!المفتّشة ريزي-سان؟

227
00:13:04,250 --> 00:13:05,830
الزيّ يلائمك

228
00:13:06,170 --> 00:13:08,420
شـ-شكراً لك

229
00:13:08,420 --> 00:13:10,210
!أعتذر على الإطالة

230
00:13:10,210 --> 00:13:10,960
!تشيا-سان

231
00:13:12,960 --> 00:13:14,750
ترتديّ تشيا زيّ لابان أيضاً؟

232
00:13:14,880 --> 00:13:16,210
...قلّدنا بعضنا

233
00:13:16,330 --> 00:13:17,710
!سينباي

234
00:13:17,710 --> 00:13:19,920
!آسفة على التأخير

235
00:13:19,920 --> 00:13:20,500
!شارو

236
00:13:20,960 --> 00:13:23,080
!لم الجميع يرتدين زيّ لابان؟

237
00:13:23,250 --> 00:13:25,130
أدخّر مالاً بعدم شراء زيّ جديد

238
00:13:25,130 --> 00:13:28,210
أردنا تجربة ارتدائه لمرّة، أليس كذلك؟

239
00:13:28,460 --> 00:13:29,170
بلى

240
00:13:29,460 --> 00:13:33,960
حسناً، ترتديّ شارو هذا الزيّ للعمل دوماً
فتمنّيت أن أراها بزيٍّ آخر

241
00:13:35,540 --> 00:13:38,830
لا-لا، أرى أنّ عليكِ أن تكوني لابان
!بدلاً منّي يا سينباي

242
00:13:38,830 --> 00:13:40,790
لـ-لمَ تريدين منّي ذلك؟

243
00:13:40,790 --> 00:13:45,380
يُفترض أن يكون الهالوين يوماً خاصاً
ترجع فيه أرواح الموتى هنا، أليس كذلك؟

244
00:13:45,380 --> 00:13:49,170
أجل، يرتدي الناس أزياء شياطين
وأشباح للاختلاط معها

245
00:13:49,290 --> 00:13:51,380
لكن أيّ شيء ينطبق هذه الأيام

246
00:13:51,750 --> 00:13:57,290
إذاً، أظنّ كوكوا-سان قد تمتلك
أكثر زيّ ملائم لذاك التقليد

247
00:13:57,540 --> 00:13:59,630
ما الذي ارتدت كوكوا-تشان زيّه؟

248
00:14:01,580 --> 00:14:03,130
ساحرة

249
00:14:11,920 --> 00:14:13,170
أضعت الطريق

250
00:14:14,250 --> 00:14:17,790
إنّها نفس البلدة، لكن تبدو مختلفة
بشكلٍ ما اليوم

251
00:14:17,790 --> 00:14:19,330
كأنّي في عالم آخر

252
00:14:20,250 --> 00:14:23,130
!بأيّ حال، عليّ إيجاد تشينو-تشان وتيبّي سريعاً

253
00:14:27,500 --> 00:14:29,040
أ-أنت بخير؟

254
00:14:29,040 --> 00:14:31,630
حسناً... أأضعت الطريق؟

255
00:14:38,670 --> 00:14:40,670
أنا أبحث عن فتيات تائهات بدوري

256
00:14:41,040 --> 00:14:42,330
!أربعة منهنّ

257
00:14:44,080 --> 00:14:46,460
!دع كلّ شيءٍ لي

258
00:14:49,500 --> 00:14:51,960
أمعن النظر في هذه العصا السحريّة

259
00:14:52,290 --> 00:14:52,950
...الأزهار سـ

260
00:14:57,330 --> 00:15:00,210
!إ-إذاً، دعني أجرّب تعويذة أخرى لاستدعاء الحلوى

261
00:15:06,210 --> 00:15:08,000
!ها أنت! تعال هنا

262
00:15:08,380 --> 00:15:10,500
!أمّي

263
00:15:11,880 --> 00:15:14,920
!أيّ سحرٍ كان ذلك؟ أنتِ فاشلة

264
00:15:37,580 --> 00:15:40,460
من أنت؟ ساحرة؟

265
00:15:43,330 --> 00:15:45,040
...عصاي

266
00:15:53,880 --> 00:15:55,250
!وجدتُ تيبّي

267
00:15:55,880 --> 00:15:56,540
ماذا؟

268
00:15:57,040 --> 00:15:59,790
...لكن العينين مختلفتين لسببٍ ما

269
00:15:59,790 --> 00:16:02,290
تشبه عينا فتاة شابة في العادة

270
00:16:03,330 --> 00:16:05,040
لا بدّ أنّه الأرنب الخطأ

271
00:16:06,960 --> 00:16:10,420
أوهمتني بأنّه لن تخرج المزيد
من الحلوى، لكنّها كانت خدعة

272
00:16:10,710 --> 00:16:11,750
!يمكنني فعل ذلك

273
00:16:12,920 --> 00:16:15,920
المعذرة! هلّا علمتِني كيف أنفّذ تلك الحيلة؟

274
00:16:15,920 --> 00:16:18,210
!أريد إبهار أخواتي الصغار

275
00:16:22,000 --> 00:16:23,500
ماذا؟ تريدين منّي أن أدفع؟

276
00:16:24,830 --> 00:16:26,420
ماذا؟ "حسناً"؟

277
00:16:26,420 --> 00:16:28,920
!يا إلهي، أخطأتِ بالإشارة

278
00:16:33,170 --> 00:16:35,130
كوكوا-تشان لا تردّ

279
00:16:35,130 --> 00:16:36,710
ما الذي حصل يا ترى؟

280
00:16:37,080 --> 00:16:38,250
لنذهب للبحث عنها

281
00:16:38,830 --> 00:16:41,130
!كوكوا هي الكنز الذي نسعى له الليلة

282
00:16:41,130 --> 00:16:43,170
بدّلتما ثيابكما إذاً

283
00:16:43,750 --> 00:16:44,540
كلا

284
00:16:44,960 --> 00:16:47,790
سيكون ذاك الكنز من نصيبي

285
00:16:47,920 --> 00:16:51,040
!من تمسك بكوكوا هي لابان الحقيقيّة

286
00:16:51,040 --> 00:16:54,580
أتنافس معكما؟ ليكن ذلك

287
00:16:54,790 --> 00:16:58,080
!أنتنّ! لا تقول لابان أشياء كهذه

288
00:16:58,080 --> 00:16:59,380
!أتت المفتّشة

289
00:16:59,960 --> 00:17:02,580
!هيّا! سنبحث عن كوكوا معاً

290
00:17:02,830 --> 00:17:05,170
!وعندما نجدها، ستكون رهن الاعتقال أيضاً

291
00:17:07,710 --> 00:17:11,420
لكن سيكون إيجادها صعباً بما أنّ
الجميع يرتدون أزياءً

292
00:17:14,290 --> 00:17:17,000
!أ-أختي الكبيرة كوكوا

293
00:17:17,960 --> 00:17:20,920
ظننتُ أنّ كوكوا-تشان قد تستجيب
بسماع شيءٍ كهذا

294
00:17:20,920 --> 00:17:21,750
!فكرة حسنة

295
00:17:21,920 --> 00:17:23,500
!لننفصل

296
00:17:23,830 --> 00:17:26,210
أ-أختي الكبيرة؟

297
00:17:26,330 --> 00:17:28,040
!أختاه

298
00:17:28,130 --> 00:17:29,920
!أختي الحبيبة

299
00:17:30,250 --> 00:17:32,960
...إذا كان هذا كافياً لجذب كوكوا-سان حقّاً

300
00:17:33,830 --> 00:17:35,210
هيّا، أنتِ أيضاً يا تشينو

301
00:17:35,210 --> 00:17:36,710
حـ-حسناً

302
00:17:36,880 --> 00:17:39,790
...أختي الكبيرة كوكوا

303
00:17:39,790 --> 00:17:41,420
!صوتك منخفض

304
00:17:41,420 --> 00:17:43,330
!تذكّري التمرين الذي خضناه لإلقائك

305
00:17:46,420 --> 00:17:49,040
!أختي الكبيرة كوكوا

306
00:17:51,000 --> 00:17:52,580
!أسمع شيئاً

307
00:17:54,130 --> 00:17:55,830
!أختي! أختاه

308
00:17:55,830 --> 00:17:58,130
أين أنت؟

309
00:17:56,500 --> 00:17:58,130
!أختي

310
00:17:58,290 --> 00:18:00,920
أختي الكبيرة كوكوا

311
00:18:11,710 --> 00:18:12,750
ما الخطب؟

312
00:18:13,880 --> 00:18:15,080
لا شيء

313
00:18:21,130 --> 00:18:21,710
هكذا

314
00:18:22,130 --> 00:18:24,040
!فعلتُها

315
00:18:33,630 --> 00:18:34,790
مع السلامة"؟"

316
00:18:40,190 --> 00:18:42,330
!سحر اختفاء! مذهل

317
00:18:42,580 --> 00:18:44,460
!كوكوا

318
00:18:47,130 --> 00:18:48,460
!تيبّي

319
00:18:50,040 --> 00:18:54,000
أعرف هذه الزغبيّة وملامح الوجه
!المصقولة! إنّه تيبّي بلا شك

320
00:18:54,710 --> 00:18:56,380
!وهذا الصوت الغريب

321
00:18:56,500 --> 00:18:57,920
...لـ-لكن

322
00:18:58,460 --> 00:19:00,420
من نادى باسمي الآن؟

323
00:19:02,330 --> 00:19:04,080
!أيمكن أنّه كان شبحاً؟

324
00:19:04,170 --> 00:19:06,210
!ها هي! الكنز

325
00:19:06,790 --> 00:19:08,080
!لن تهربي

326
00:19:08,080 --> 00:19:10,040
!اللصّة الشبحة لابان هنا

327
00:19:10,040 --> 00:19:11,750
!جماعة لابان

328
00:19:14,000 --> 00:19:15,960
!لمستُها أوّلاً

329
00:19:15,960 --> 00:19:17,920
!أنا من رأتها أوّلاً

330
00:19:17,920 --> 00:19:20,580
لابان الحقيقيّة تنتظر حتّى النهاية
!لتخطف الغنيمة

331
00:19:20,790 --> 00:19:24,630
يا إلهي، لا تحرجنني هكذا بمناداتي كنزاً

332
00:19:24,630 --> 00:19:26,460
لا تتشاجرا عليّ

333
00:19:27,460 --> 00:19:28,130
ماذا؟

334
00:19:28,130 --> 00:19:30,080
أنتِ رهن الاعتقال للتسبّب بالقلق

335
00:19:30,290 --> 00:19:35,250
.يا إلهي، لا أصدّق أنّكِ ضللتِ الطريق
أنتِ لا تتغيّرين أبداً يا كوكوا-سان

336
00:19:35,250 --> 00:19:36,880
سيكون عليك دعوتنا جميعاً للتعويض عن ذلك

337
00:19:37,460 --> 00:19:39,960
!آسفة

338
00:19:44,130 --> 00:19:45,630
ما الخطب؟

339
00:19:45,750 --> 00:19:48,460
...كنتُ أفكّر بأنّه لم تسنح لي فرصة لشكرها

340
00:19:49,170 --> 00:19:50,540
شكر من؟

341
00:19:51,750 --> 00:19:52,790
...لستُ واثقة

342
00:19:53,670 --> 00:19:54,960
من؟

343
00:19:58,130 --> 00:19:59,830
!كان ذلك مسليّاً

344
00:19:59,830 --> 00:20:02,170
انتهى هالوين عام آخر

345
00:20:02,330 --> 00:20:05,080
لا بدّ أنّ أرواح أجدادنا عائدة للسماء

346
00:20:16,500 --> 00:20:18,170
لا تقلقي

347
00:20:19,170 --> 00:20:22,960
لم تُفتح أبواب اللآلئ لي بعد

348
00:20:30,540 --> 00:20:31,710
!تشينو-تشان

349
00:20:32,500 --> 00:20:35,500
!دعيني أريكِ السحر الجديد الذي تعلّمتُه

350
00:20:35,750 --> 00:20:37,210
ماذا؟ سحر؟

351
00:20:40,330 --> 00:20:43,580
هاك! ماذا؟ هل أدهشتُكِ بحيث لم تنطقي؟

352
00:20:43,580 --> 00:20:44,750
!مرحى

353
00:20:46,460 --> 00:20:47,460
...لا

354
00:20:51,920 --> 00:20:52,830
تشينو

355
00:20:53,380 --> 00:20:55,500
حسناً، انظري بإمعان الآن

356
00:20:59,040 --> 00:20:59,830
هاك

357
00:21:04,170 --> 00:21:06,580
هذه الحيلة تبهجك دوماً، صحيح؟

358
00:21:19,330 --> 00:21:22,750
كانت أمّي بارعةً في تنفيذ تلك الحيلة فقط

359
00:21:26,750 --> 00:21:28,790
!أنتما! سنترككما

360
00:21:29,790 --> 00:21:30,500
!هيّا بنا

361
00:21:37,130 --> 00:21:39,960
!إذاً، أخبريني المزيد عن أمّك

362
00:21:39,960 --> 00:21:40,920
ماذا؟

363
00:21:40,920 --> 00:21:43,290
أيّ حيل سحر أخرى كانت تجيدها؟

364
00:21:43,420 --> 00:21:44,670
أيّ شخصٍ كانت؟

365
00:21:44,670 --> 00:21:45,960
أتحب الأشياء الزغبيّة؟

366
00:21:45,960 --> 00:21:49,830
!إمّا اسألي أو اركضي! ليس الاثنين معاً

367
00:23:26,040 --> 00:23:28,960
ربما سأعزف جازاً هذا المساء على سبيل التغيير

368
00:23:29,880 --> 00:23:32,170
آمل أنّكِ تستمعين

369
00:23:33,240 --> 00:23:35,010
صحيح يا ساكي؟