1
00:00:16,080 --> 00:00:19,370
.آمل أن تكون بخيرٍ يا ماكسيميليان-ساما

2
00:00:19,920 --> 00:00:22,450
.لم أتوقّع مجيئكَ إلى هنا في وقتٍ كهذا

3
00:00:22,620 --> 00:00:25,800
...أهذا بسبب المفتاح؟ أو ربّما

4
00:00:26,560 --> 00:00:28,050
.كفاكَ مُزاحًا

5
00:00:28,230 --> 00:00:32,970
.إذا كُسِر ختم المفتاح، فقد يفقد الكثيرون حياتهم

6
00:00:33,040 --> 00:00:35,470
.أنتَ مدركٌ لهذا أيضًا

7
00:00:40,280 --> 00:00:42,900
هل تخاف المفتاح لتلك الدرجة؟

8
00:00:43,550 --> 00:00:48,380
إذا كان الأمر كذلك، فعلينا أن نجعل
.المفتاح مِلكًا لنا قبل انعقاد الاجتماع

9
00:00:48,920 --> 00:00:50,390
.حسنًا إذًا

10
00:02:44,070 --> 00:02:47,400
.مفتاح بوّابات عالمنا، نيميسيس

11
00:02:47,760 --> 00:02:49,640
.الآنسة كاتسومي ليكيور

12
00:02:49,910 --> 00:02:52,760
.أُصرّ الليلة على أن ترافِقيني

13
00:02:53,040 --> 00:02:54,160
.هيّا

14
00:03:02,630 --> 00:03:04,800
."أمامي رافايل"

15
00:03:04,990 --> 00:03:06,970
."خلفي غابريل"

16
00:03:07,290 --> 00:03:09,120
."على يميني ميكايل"

17
00:03:09,330 --> 00:03:11,160
."على يساري يوريل"

18
00:03:13,230 --> 00:03:14,450
ما حال الحاجز يا نامي؟

19
00:03:16,430 --> 00:03:18,660
!لن يصمد لوقتٍ طويل. أسرِعن رجاءً

20
00:03:18,970 --> 00:03:21,870
!أتير ماركت في غيبرا

21
00:03:23,040 --> 00:03:25,730
.في ديدرا، آمين

22
00:03:32,920 --> 00:03:33,950
!لقد فعلتها

23
00:03:34,750 --> 00:03:35,960
!ليس بعد

24
00:03:54,570 --> 00:03:56,260
...سحر كاتسومي

25
00:03:56,440 --> 00:03:57,680
لم يكن له أثر؟

26
00:03:59,690 --> 00:04:03,370
.حذّرتُكِ من أنّي لن أُظهِر أيّ رحمةٍ في المرّة التالية التي سنلتقي فيها

27
00:04:04,090 --> 00:04:08,540
.تأقلمتُ بالفعل مع خططكِ القتاليّة

28
00:04:10,320 --> 00:04:13,290
.لن ينفع سحركِ بعد الآن

29
00:04:18,230 --> 00:04:19,320
!انهار الحاجز

30
00:04:19,400 --> 00:04:20,830
...ذلك الوغد

31
00:04:28,370 --> 00:04:29,100
لا فائدة؟

32
00:04:29,200 --> 00:04:30,100
!كاتسومي-سان

33
00:04:34,040 --> 00:04:34,610
!كاتسومي

34
00:04:34,710 --> 00:04:35,520
!كاتسومي-سان

35
00:04:35,840 --> 00:04:38,400
هلّا توقّفنا عن اللعب الآن؟

36
00:04:40,650 --> 00:04:43,350
.ما أطلبه منكِ ليس مستحيلًا

37
00:04:44,370 --> 00:04:47,120
...نحن النيميسيس موجودون في هذا العالم

38
00:04:47,320 --> 00:04:50,280
.لأنّ والدكِ تمنّى ذلك

39
00:04:51,290 --> 00:04:55,570
.وأنتِ بصفتكِ ابنته، لديكِ واجبٌ لفتح البوّابات بدلًا عنه

40
00:04:56,160 --> 00:04:57,800
.هذا كلّ ما في الأمر

41
00:04:59,870 --> 00:05:00,730
ماذا؟

42
00:05:02,370 --> 00:05:03,240
ما هذا؟

43
00:05:03,310 --> 00:05:06,500
!إنّه الخنجر! الخنجر يحمي كاتسومي

44
00:05:06,580 --> 00:05:08,280
!لا أعتقد ذلك

45
00:05:08,480 --> 00:05:09,520
!كاتسومي-سان

46
00:05:32,300 --> 00:05:32,850
!كاتسومي

47
00:05:32,860 --> 00:05:33,870
!كاتسومي-سان

48
00:05:36,770 --> 00:05:37,880
ما هي حالة كاتسومي؟

49
00:05:38,160 --> 00:05:40,320
.ما زلنا لا نعرف بعد

50
00:05:40,740 --> 00:05:42,810
أصحيحٌ أنّ الخنجر خرج عن السيطرة؟

51
00:05:43,550 --> 00:05:45,610
.شهدت كيدي والأخريات على ذلك

52
00:05:46,050 --> 00:05:48,980
...حتّى تقرير المستشفى

53
00:05:49,120 --> 00:05:52,260
.يؤكّد أنّ جهازها العصبي هو أكثر من تضرّر

54
00:05:52,860 --> 00:05:55,290
يُفترض أن يحمي هذا الخنجر كاتسومي. لماذا؟

55
00:05:59,360 --> 00:05:59,840
.إيسوزاكي

56
00:05:59,950 --> 00:06:00,490
.حاضر

57
00:06:00,930 --> 00:06:04,560
.نظّمي فريق بحثٍ باستخدام معدّاتنا وعلمائنا

58
00:06:04,630 --> 00:06:08,230
...فليعثروا على السبب بسرعة. وبالنسبة لكاتسومي

59
00:06:08,900 --> 00:06:11,320
.يسعى العدوّ خلف كاتسومي بالذات

60
00:06:11,720 --> 00:06:16,980
،إلى جانب حمايتها لأربعٍ وعشرين ساعة
.أريد منكن وضع حاجزٍ مزدوج

61
00:06:17,100 --> 00:06:18,380
حاجزٌ مزدوج؟

62
00:06:18,580 --> 00:06:20,780
.الأوّل هو الحاجز الواقي المُعتاد

63
00:06:21,350 --> 00:06:23,650
...والثاني يخفي حضور كاتسومي

64
00:06:23,890 --> 00:06:27,150
.ممّا يجعلها غير مرئيّةٍ للأعداء

65
00:06:27,220 --> 00:06:28,490
...بالإضافة لذلك

66
00:06:30,230 --> 00:06:31,640
أهذا يكفي؟

67
00:06:31,980 --> 00:06:33,490
أجل، لمَ لا؟

68
00:06:33,560 --> 00:06:34,820
.نحن جاهزات أيضًا

69
00:06:34,900 --> 00:06:38,830
.طالما بقيت هنا، لن يستطيعوا العثور عليها

70
00:06:39,700 --> 00:06:41,680
ما هذا يا يوكي؟

71
00:06:42,140 --> 00:06:43,760
هذا؟

72
00:06:45,410 --> 00:06:49,120
.أحضرتُه على أمل أن تتحسّن قريبًا

73
00:06:53,170 --> 00:06:54,270
!كاتسومي-كن

74
00:06:56,090 --> 00:06:58,240
.آ-آسف

75
00:07:04,060 --> 00:07:05,640
...أبي

76
00:07:06,400 --> 00:07:08,190
.أخبرني يا أبي

77
00:07:09,030 --> 00:07:13,280
لماذا جلبتَ لوشفار هوك إلى هذا العالم يا أبي؟

78
00:07:13,600 --> 00:07:14,690
لماذا؟

79
00:07:15,840 --> 00:07:17,810
!أبي

80
00:07:22,410 --> 00:07:23,640
...كاتسومي

81
00:07:27,120 --> 00:07:29,300
هل ستكون كاتسومي-سان بخير؟

82
00:07:29,620 --> 00:07:30,610
.أجل

83
00:07:30,690 --> 00:07:32,590
.هيّا. لنعد إلى مواقعنا

84
00:07:33,160 --> 00:07:34,620
.نعم

85
00:07:55,910 --> 00:07:58,230
هل أتيتَ لتسخر منّي؟

86
00:07:58,990 --> 00:08:01,140
.إذا كان كذلك، فأنتَ مُخطئٌ للغاية

87
00:08:02,130 --> 00:08:04,190
...صحيحٌ أنّي أُصبت

88
00:08:04,750 --> 00:08:07,280
.لكن هذا ينطبق على المفتاح أيضًا

89
00:08:08,020 --> 00:08:10,440
.سنقبض عليها بحلول الصباح

90
00:08:13,530 --> 00:08:15,120
.إيسوزاكي

91
00:08:15,520 --> 00:08:17,290
.رصدنا حركةً للوشفار هوك

92
00:08:18,130 --> 00:08:21,260
.أعتقد أنّه نفس الفئة الأولى الذي ظهر في مركز شرطة 65 من قبل

93
00:08:22,070 --> 00:08:23,600
.عزّزن الحراسة

94
00:08:24,110 --> 00:08:25,910
.إنّهم يتحرّكون وفقًا للخطّة

95
00:08:27,680 --> 00:08:30,140
.أراهن أنّه غاضبٌ للغاية الآن

96
00:08:30,750 --> 00:08:32,500
...اللعنة عليكن

97
00:08:33,320 --> 00:08:35,040
تعتقدن أنّكن ذكيّاتٍ جدًّا؟

98
00:08:41,110 --> 00:08:41,930
هل نِلنا منه؟

99
00:08:45,060 --> 00:08:46,090
!لا تدعوه يهرب

100
00:08:54,030 --> 00:08:56,270
.سيّدتي

101
00:08:57,190 --> 00:09:00,540
.صيري سيّدتي

102
00:09:00,610 --> 00:09:03,680
.بعقدٍ من الدم

103
00:09:06,480 --> 00:09:07,140
!كاتسومي

104
00:09:07,370 --> 00:09:08,750
هل استيقظتِ؟

105
00:09:12,120 --> 00:09:13,720
كـ-كاتسومي؟

106
00:09:14,280 --> 00:09:15,450
!لا تذهبي

107
00:09:17,830 --> 00:09:19,120
...نامي-سان، أهذه

108
00:09:19,190 --> 00:09:21,290
كاتسومي-سان! إلى أين تذهبين؟

109
00:09:21,860 --> 00:09:23,110
!لا تفعلي ذلك يا نامي-سان

110
00:09:28,500 --> 00:09:30,130
هل أنتِ بخيرٍ يا نامي-سان؟

111
00:09:31,570 --> 00:09:33,400
.لـ-لا تهتمّي بي

112
00:09:35,640 --> 00:09:38,140
!توقّفي! ستتعرّضين للخطر إذا خرجتِ

113
00:09:41,450 --> 00:09:42,460
!آنسة كاتسومي

114
00:09:46,790 --> 00:09:48,360
!فقدنا التحكّم! استعدّوا للاصطدام

115
00:09:50,830 --> 00:09:53,490
.وجدتُكِ يا آنسة كاتسومي

116
00:09:56,230 --> 00:09:58,200
.سيّدتي

117
00:09:59,640 --> 00:10:02,500
.صيري سيّدتي

118
00:10:03,570 --> 00:10:05,940
.بعقدٍ من الدم

119
00:10:18,120 --> 00:10:20,110
.هذا أسوأ وضعٍ ممكن

120
00:10:20,280 --> 00:10:22,870
...لا نعرف ما دفع كاتسومي للخروج من المستشفى

121
00:10:23,250 --> 00:10:26,320
.لكنّنا لا نستبعد تحكّمًا بالعقل من قبل الفئة الأولى

122
00:10:27,100 --> 00:10:27,740
...لذلك

123
00:10:28,100 --> 00:10:29,870
.كيدي ونامي اذهبا خلف كاتسومي

124
00:10:30,170 --> 00:10:31,640
.يوكي وليبيا انتظرا في المستشفى

125
00:10:32,010 --> 00:10:34,080
.بمجرّد أن أصل، سأتبع كاتسومي

126
00:10:34,640 --> 00:10:36,740
.إذا استدعى الأمر، سأقاتل أنا أيضًا

127
00:10:37,140 --> 00:10:38,200
أنتِ أيّتها الرئيسة؟

128
00:10:38,270 --> 00:10:39,150
.انتهى

129
00:10:51,890 --> 00:10:53,980
.وجدتُكِ يا آنسة كاتسومي

130
00:11:08,340 --> 00:11:09,640
.سنهزمه هنا

131
00:11:09,940 --> 00:11:10,770
.عُلِم

132
00:11:19,320 --> 00:11:20,170
!تقرير

133
00:11:21,820 --> 00:11:23,480
قوّةٌ عكسيّة؟

134
00:11:23,550 --> 00:11:24,350
.أجل

135
00:11:24,460 --> 00:11:26,530
.لم يخرج الخنجر عن السيطرة

136
00:11:26,860 --> 00:11:29,190
.وإنّما قوّة كاتسومي قد عُكِست

137
00:11:29,830 --> 00:11:36,800
منذ أن استيقظت قواها، اختبرت كاتسومي الكثير من المعارك
.ضدّ لوشفار هوك، ممّا زاد من قواها السحريّة بشكلٍ تدريجي

138
00:11:37,160 --> 00:11:40,100
.في الواقع، لقد تجاوزت القوّة التي يسمح بها الخنجر

139
00:11:40,530 --> 00:11:42,710
.وهذا ما أدّى إلى وضعنا الحالي

140
00:11:43,270 --> 00:11:45,400
.هذا هو رأي فريق التحليل

141
00:11:47,610 --> 00:11:50,040
تجاوزت قوّتها قوّة الخنجر؟

142
00:11:50,810 --> 00:11:52,180
!فهمت

143
00:11:52,250 --> 00:11:53,360
.أيّتها الرئيسة

144
00:11:53,650 --> 00:11:56,070
.يتمّ إرشاد كاتسومي

145
00:11:56,600 --> 00:11:59,520
.من قبل شخصٍ قاتل إلى جانبنا من قبل

146
00:12:05,020 --> 00:12:07,620
ماذا حدث لي؟

147
00:12:08,860 --> 00:12:10,990
وأين أنا؟

148
00:12:11,570 --> 00:12:14,690
.كنتُ بانتظاركِ يا كاتسومي ليكيور

149
00:12:15,470 --> 00:12:18,860
.صيري سيّدتي بعقدٍ من الدم

150
00:12:19,600 --> 00:12:22,140
!أنا كينو غروسبولينر

151
00:12:22,840 --> 00:12:25,810
كينو غروسبولينر؟

152
00:12:26,610 --> 00:12:27,600
.صحيح

153
00:12:28,010 --> 00:12:32,300
على الأرجح أنّه كان مختومًا، في انتظار الوقت
...الذي تصبح فيه كاتسومي قويّةً كفايةً لاستخدامه

154
00:12:32,310 --> 00:12:36,110
.حتّى يتجنّب اكتشافه من قبل نيميسيس

155
00:12:36,530 --> 00:12:38,920
...اللحظة التي توقّف فيها الخنجر عن دعم كاتسومي

156
00:12:39,080 --> 00:12:41,220
.كانت المفتاح لصحوته

157
00:12:41,380 --> 00:12:42,790
...أيّتها الرئيسة! كيدي ونامي

158
00:12:45,870 --> 00:12:47,020
!كيدي! نامي

159
00:12:47,680 --> 00:12:50,160
.لا أستطيع تضييع الوقت هنا

160
00:12:58,110 --> 00:12:59,640
!اللعنة

161
00:13:01,080 --> 00:13:02,410
بدمّي؟

162
00:13:02,600 --> 00:13:07,350
.أجل. اعقدي معي بدمّكِ، وسوف أتحرّر

163
00:13:07,890 --> 00:13:08,880
ما هو دليلك؟

164
00:13:08,960 --> 00:13:09,890
دليل؟

165
00:13:10,360 --> 00:13:13,920
هل لديكَ أيّ دليلٍ يُثبتَ أنّكَ لستَ من نيميسيس؟

166
00:13:14,270 --> 00:13:16,130
!قد تكون واحدًا منهم

167
00:13:19,130 --> 00:13:20,610
ما المضحك في هذا؟

168
00:13:21,160 --> 00:13:24,900
.اعذريني. لا بدّ أنّه أمرٌ يجري في الدم

169
00:13:25,670 --> 00:13:29,540
...قال سيّدي السابق نفس الشيء تمامًا

170
00:13:29,610 --> 00:13:33,480
.عندما ألزم نفسه بعقدٍ من الدم

171
00:13:33,550 --> 00:13:34,950
...سيّدكَ السابق

172
00:13:35,440 --> 00:13:36,750
هل تقصد...؟

173
00:13:36,990 --> 00:13:39,460
.أجل. غيغلف ليكيور

174
00:13:39,760 --> 00:13:41,050
.والدُكِ

175
00:13:43,040 --> 00:13:47,330
!أخبرني! أخبرني عن أبي. أريد أن أعرف

176
00:13:48,160 --> 00:13:48,690
!أرجوك

177
00:13:49,230 --> 00:13:52,830
!رحل أبي قبل أن أولد

178
00:13:53,690 --> 00:13:56,070
!سمعتُ عنه من أمّي فقط

179
00:13:56,840 --> 00:13:58,160
!رأيتُه في الصور فقط

180
00:13:59,110 --> 00:14:03,510
.وكلّ ما سمعتُه هو أنّه جلب لوشفار هوك إلى هذا العالم

181
00:14:03,580 --> 00:14:05,550
...هذا فقط. هذا فقط

182
00:14:05,610 --> 00:14:09,070
!...هذا فقط ما سمعتُه! لهذا... لهذا

183
00:14:12,810 --> 00:14:16,020
.هذا صحيحٌ بالفعل يا كاتسومي

184
00:14:16,140 --> 00:14:18,790
.ولكن، لقد قاتلهم سيّدي

185
00:14:20,070 --> 00:14:23,090
.بما أنّي قاتلتُ إلى جانبه، أؤكّد لكِ ذلك

186
00:14:23,240 --> 00:14:27,000
.من المحال أن ينحاز السيّد غيغلف إلى جانب نيميسيس

187
00:14:31,710 --> 00:14:33,400
...هذا جيّد

188
00:14:35,140 --> 00:14:36,640
.هذا جيّد

189
00:14:40,920 --> 00:14:43,710
.كنتُ بانتظاركِ يا كاتسومي

190
00:14:44,120 --> 00:14:48,220
!كنتُ بانتظار أن ترثيني باسم والدكِ

191
00:14:48,320 --> 00:14:51,420
أنا... باسم أبي...؟

192
00:14:51,490 --> 00:14:54,760
.صحيح. حان الوقت الآن

193
00:14:54,870 --> 00:14:57,590
.حان الوقت لتصبحي سيّدتي الجديدة

194
00:14:57,900 --> 00:14:59,870
!كاتسومي ليكيور

195
00:15:07,080 --> 00:15:09,040
إلى متى تريد مقاطعتنا؟

196
00:15:14,050 --> 00:15:15,040
!غيّري الاتّجاه بسرعة

197
00:15:15,110 --> 00:15:15,480
!حاضر

198
00:15:16,750 --> 00:15:18,650
!والآن دوركما

199
00:15:42,540 --> 00:15:44,540
!تراجعي يا كاتسومي

200
00:16:06,740 --> 00:16:08,330
...سيف

201
00:16:17,520 --> 00:16:18,920
أهذا...؟

202
00:16:24,520 --> 00:16:27,080
أهذا هو غروسبولينر؟

203
00:16:28,920 --> 00:16:29,600
.انتظري

204
00:16:30,760 --> 00:16:34,020
.بما أنّي أخذتُ من دمّكِ، أصبحتُ جزءًا منكِ

205
00:16:34,100 --> 00:16:37,530
...ولكن، من أجل أن نتّحد بشكلٍ كامل

206
00:16:37,600 --> 00:16:40,400
.سيتسبّب الاتصّال الأوّل بألمٍ عظيم

207
00:16:41,100 --> 00:16:43,570
هل أنتِ جاهزةٌ يا كاتسومي؟

208
00:17:03,530 --> 00:17:04,890
!مستحيل

209
00:17:04,990 --> 00:17:06,290
بُعِثَ مُجدّدًا؟

210
00:17:07,460 --> 00:17:09,190
!تحمّلي يا كاتسومي

211
00:17:09,260 --> 00:17:12,060
...يجب أن تتحمّلي الألم لكي ترثيني

212
00:17:12,670 --> 00:17:16,470
...لا، بل لترثي إرادة سيّدي السابق

213
00:17:16,540 --> 00:17:18,630
!غيغلف ليكيور

214
00:17:18,710 --> 00:17:19,970
لأكون خليفة والدي؟

215
00:17:21,410 --> 00:17:23,660
...أجل. سأكون

216
00:17:24,810 --> 00:17:27,010
...سأكون خليفة والدي

217
00:17:27,080 --> 00:17:29,570
!لأقاتل نيميسيس

218
00:17:38,130 --> 00:17:41,120
...لقد بُعِثتَ مُجدّدًا إذًا يا غروسبولينر

219
00:17:42,000 --> 00:17:44,440
...من المؤسف أنّني لم أستطع منع ذلك

220
00:17:44,900 --> 00:17:46,270
...ولكن حدث ما حدث

221
00:17:46,920 --> 00:17:51,070
!سأستخدم قوّةً مساويةً لقوّة غيغلف-ساما لأتأكّد من ألا تقوم لكَ قائمة

222
00:17:51,940 --> 00:17:54,070
!لننطلق يا غروسبولينر

223
00:17:54,210 --> 00:17:55,730
!نعم يا سيّدتي

224
00:17:56,440 --> 00:17:59,380
!استعيري قوّة روح العالم يا كاتسومي

225
00:18:00,120 --> 00:18:02,050
...يا روحا الشمس والمرّيخ

226
00:18:02,200 --> 00:18:04,390
!أطلعاني على اسميّ سورال وبالثازيل

227
00:18:05,840 --> 00:18:06,850
...تلك التعويذة

228
00:18:07,200 --> 00:18:09,920
!امنحا نصلي قوّة الذهب والحديد

229
00:18:10,490 --> 00:18:12,720
!أنا أقف عند قدميّ غايا

230
00:18:22,870 --> 00:18:24,440
!مستحيل

231
00:18:24,490 --> 00:18:27,610
!وكأنّها تملك قوّةً أكبر من غيغلف ليكيور

232
00:18:28,110 --> 00:18:29,510
.تمامًا

233
00:18:31,280 --> 00:18:33,980
...موهبة سيّدتي الجديدة في فنون السحر

234
00:18:34,050 --> 00:18:36,910
!تفوق سيّدي غيغلف بكثير

235
00:18:37,190 --> 00:18:39,410
.اسمها هو كاتسومي ليكيور

236
00:18:39,720 --> 00:18:41,380
!اللعنة عليك

237
00:18:42,390 --> 00:18:45,380
!يا روح الكوكب بين أرواح السموات

238
00:18:45,930 --> 00:18:48,440
!ظلّ القمر، بالشوماس-ها

239
00:18:49,200 --> 00:18:50,540
!انظري أيّتها الرئيسة

240
00:18:51,000 --> 00:18:53,620
!لقد أيقظت كينو غروسبولينر

241
00:18:54,370 --> 00:18:55,690
...يا سيفي من الفضّة

242
00:18:56,130 --> 00:18:58,070
!اعكس ضوء كثولو

243
00:18:58,560 --> 00:19:00,070
!لن أسمح لكِ

244
00:19:00,710 --> 00:19:02,730
!أوفِ بعقدكَ مع سيرينا

245
00:19:16,830 --> 00:19:18,720
...مـ-مستحيل

246
00:19:18,790 --> 00:19:22,350
...قوّتها... قوّة فتاة المفتاح

247
00:19:22,510 --> 00:19:24,990
أكبر من قوّة غيغلف؟

248
00:19:44,590 --> 00:19:47,320
هذه... قوّتي...؟

249
00:19:48,420 --> 00:19:49,320
!كاتسومي

250
00:19:48,810 --> 00:19:50,080
!كاتسومي-سان

251
00:19:54,760 --> 00:19:58,660
!أبي

252
00:20:09,240 --> 00:20:10,160
.هذا جيّد

253
00:20:11,710 --> 00:20:13,650
روي-سان؟

254
00:20:14,020 --> 00:20:16,960
.لقد استيقظتِ حقًّا. هذا جيّد

255
00:20:17,430 --> 00:20:18,220
أجل

256
00:20:24,730 --> 00:20:26,130
!توقّفي! لا يمكنكِ الدخول الآن

257
00:20:26,250 --> 00:20:28,460
ماذا؟ لماذا؟

258
00:20:28,820 --> 00:20:30,260
!لا يمكنكِ فحسب

259
00:20:30,490 --> 00:20:31,700
وما المانع؟

260
00:20:31,900 --> 00:20:33,550
!قلتُ لكِ لا يمكنكِ

261
00:20:34,190 --> 00:20:37,270
.لقد نضجتِ حقًّا يا آنسة رالي

262
00:20:38,030 --> 00:20:41,640
.توقّف عن قول آنسةٍ رجاءً. نادِني رالي فقط

263
00:20:42,760 --> 00:20:45,460
.تمضي السنوات بسرعةٍ حقًّا

264
00:20:46,810 --> 00:20:47,960
ما الخطب؟

265
00:20:48,820 --> 00:20:50,680
.لـ-لا، لا شيء

266
00:20:51,800 --> 00:20:53,040
...الحضور الذي شعرتُ به

267
00:20:53,800 --> 00:20:55,150
.مستحيل

268
00:22:39,230 --> 00:22:43,600
.يبني الناس المدن، وعندما تنمو المدن، تنسى أولئك الناس

269
00:22:43,670 --> 00:22:47,530
...فيبني الناس مُدنًا جديدة

270
00:22:47,830 --> 00:22:50,800
.وينسون مُدنهم القديمة

271
00:22:50,870 --> 00:22:53,210
...أخرج ساعيةً وأتجوّل

272
00:22:54,010 --> 00:22:57,380
.بحثًا عن ذكريات أبي وأمّي

273
00:22:57,970 --> 00:23:02,500
:موبيوس الصامت، الحلقة 9
"زاوية شارعٍ عرفت الحب"

274
00:23:03,750 --> 00:23:06,720
.أخبرني يا غروسبولينر