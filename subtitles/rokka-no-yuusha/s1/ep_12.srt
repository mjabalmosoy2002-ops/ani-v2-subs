1
00:00:01,140 --> 00:00:04,270
من يكون السّابع إذًا؟

2
00:00:08,610 --> 00:00:10,400
...السّابع هو

3
00:00:25,250 --> 00:00:28,420
شجعان الزّهرة السّتّة

4
00:01:58,630 --> 00:02:01,680
مورا-سان، أتفهمين الوضع الّذي أنتِ فيه الآن؟

5
00:02:03,140 --> 00:02:06,520
.فلايمي-سان، ابقي قريبة من أدليت-سان رجاءً

6
00:02:06,520 --> 00:02:09,440
.غولدوف، لا تسمح لمورا-سان بالهرب

7
00:02:09,440 --> 00:02:10,400
.حاضر

8
00:02:10,730 --> 00:02:13,610
!مهلاً أيّتها الأميرة! إنّه ليس أنا

9
00:02:13,610 --> 00:02:15,610
ما دليلكِ على ذلك؟

10
00:02:16,070 --> 00:02:18,030
.صحيح، ليس لديّ دليل

11
00:02:18,030 --> 00:02:20,610
لكن من سيكون غيركِ؟

12
00:02:21,120 --> 00:02:24,620
لن تقولي أنّ فلايمي-سان هي المزيّفة، صحيح؟

13
00:02:28,750 --> 00:02:29,670
...أدليت

14
00:02:30,330 --> 00:02:33,590
.هذا صحيح، ليس لدينا دليل

15
00:02:34,380 --> 00:02:37,710
لكن من قد يكون غير مورا؟

16
00:02:38,130 --> 00:02:42,090
.أنا واثق أنّ فلايمي وناشيتانيا ليستا الشّجاع المزيّف

17
00:02:42,090 --> 00:02:46,220
...ساعدني هانز على اكتشاف خطّة السّابع

18
00:02:46,520 --> 00:02:51,230
.ولا أستطيع أن أتصوّر أنّ رجلاً بمثل ولاء غولدوف قد يخوننا

19
00:02:51,230 --> 00:02:53,360
.كما لم أشكّ أبدًا بتشامو

20
00:02:53,360 --> 00:02:54,940
!الشّجاع المزيّف ليس أوبا-تشان

21
00:02:56,320 --> 00:02:59,190
.إنّه ليس مورا أوبا-تشان

22
00:02:59,190 --> 00:03:02,570
.انظروا ما الّذي عثرت عليه تشامو

23
00:03:04,070 --> 00:03:05,120
ألواح حجريّة؟

24
00:03:05,580 --> 00:03:09,500
.قبل برهة، حطّمتُ أرضيّة المعبد وأخرجتُ هذه من تحته

25
00:03:09,500 --> 00:03:11,960
!كان هنالك صندوق كبير

26
00:03:11,960 --> 00:03:15,630
.كان هنالك سيف إضافة لهذين اللّوحين بداخله

27
00:03:16,000 --> 00:03:17,090
لوحين؟

28
00:03:17,750 --> 00:03:21,510
.واحد يشبه اللّوح الّذي في المعبد

29
00:03:21,930 --> 00:03:25,140
.والسّيف أيضًا يشبه الّذي رأيناه في المعبد

30
00:03:25,140 --> 00:03:29,220
.الأشخاص الّذين أنشؤوا هذا الحاجز كانوا حذرين للغاية

31
00:03:29,220 --> 00:03:33,150
.لقد صنعوا أدوات إضافية لتشغيله

32
00:03:34,230 --> 00:03:36,190
!كانت تشامو من عثرت عليها

33
00:03:36,190 --> 00:03:39,900
حسنًا، كنتُ أنا من تساءل عن إمكانية
.وجود شيء ما تحت الأرض

34
00:03:39,900 --> 00:03:41,990
!لكنّ من عثرت عليها كانت تشامو

35
00:03:41,990 --> 00:03:44,620
!لكنّها كانت فكرتي أنا

36
00:03:44,620 --> 00:03:46,910
.يمكنكما التّشاجر بشأن هذا لاحقًا

37
00:03:48,160 --> 00:03:50,290
لماذا هنالك لوحان؟

38
00:03:52,210 --> 00:03:54,790
...أجل، اللّوح الثّاني هو الأهمّ

39
00:03:54,790 --> 00:03:58,090
.الأول يشبه الّذي في المنصّة

40
00:03:58,090 --> 00:04:02,630
ويحتوي اللّوح الآخر على تعليمات
،عن كيفية إبطال تشغيل الحاجز

41
00:04:02,630 --> 00:04:06,850
.وكيفية تشغيله ثانية

42
00:04:07,300 --> 00:04:11,480
.لكنّ ما فاجأني هي طريقة تشغيل الحاجز

43
00:04:12,230 --> 00:04:18,570
،بهدف تشغيل الحاجز، علينا إزالة السّيف وتحطيم اللّوحة

44
00:04:18,570 --> 00:04:21,030
.وتكرار العمليّة

45
00:04:21,030 --> 00:04:24,240
بعبارات أخرى، تمسك بالسّيف وتترك
،دماءك تنزف على المنصّة

46
00:04:24,780 --> 00:04:28,490
.وتقول الكلمات ثمّ تحطّم اللّوح

47
00:04:29,790 --> 00:04:31,580
هل ذلك الشّيء حقيقي؟

48
00:04:31,580 --> 00:04:36,040
.السّيف واللّوح الآخر يشبهان ما يوجد في المنصّة

49
00:04:36,040 --> 00:04:40,090
.أجل، يصعب تصديق أنّ هذا قد يكون مزيّفًا

50
00:04:40,090 --> 00:04:44,050
من حطّم اللّوح؟ ،والآن

51
00:04:44,050 --> 00:04:45,630
.لستُ أدري

52
00:04:45,630 --> 00:04:49,350
...كان محطّمًا عندما وصلت تشامو

53
00:04:50,140 --> 00:04:52,350
من حطّمه؟

54
00:04:52,350 --> 00:04:55,600
أتتذكّر يا أدليت؟

55
00:04:56,980 --> 00:04:59,440
.أجل، أتذكّر

56
00:05:00,070 --> 00:05:02,110
.أتذكّر كلّ شيء

57
00:05:03,490 --> 00:05:05,860
...في البداية، قام غولدوف

58
00:05:18,630 --> 00:05:21,920
أدليت، من حطّم اللّوح؟

59
00:05:21,920 --> 00:05:24,010
!كلاّ، لا يمكن

60
00:05:24,970 --> 00:05:26,510
.كانت ناشيتانيا

61
00:05:33,970 --> 00:05:36,730
كانت الأميرة إذًا؟

62
00:05:36,730 --> 00:05:39,400
.يا لها من مفاجأة. ظننتُ أنّه كان غولدوف

63
00:05:40,900 --> 00:05:41,860
الأميرة؟

64
00:05:43,940 --> 00:05:46,820
!لا تقلقي! سوف أحميك أيّتها الأميرة

65
00:05:46,820 --> 00:05:50,570
.صـ-صحيح... لقد حطّمتُ اللّوح

66
00:05:50,820 --> 00:05:54,790
...لكنّي لم أقصد تشغيل الحاجز

67
00:05:54,790 --> 00:05:57,290
!أدليت-سان، قل شيئًا

68
00:05:57,290 --> 00:05:59,460
!أنا لستُ السّابع

69
00:06:01,130 --> 00:06:02,750
!أدليت-سان

70
00:06:03,210 --> 00:06:04,590
.صافحني رجاءً

71
00:06:04,590 --> 00:06:07,470
!تم اختياري كأحد شجعان الزّهرة السّتّة

72
00:06:07,470 --> 00:06:09,470
.هذا جديد عليّ

73
00:06:09,470 --> 00:06:10,840
أوليس جميلاً؟

74
00:06:10,840 --> 00:06:12,850
.إنّه مطمْئن وهادئ

75
00:06:12,850 --> 00:06:15,600
.تلك الفتاة هي قاتلة الشّجعان

76
00:06:15,600 --> 00:06:21,730
.يحبّ الرّجال الفتيات من أمثالها
.إنّهنّ يدفعونكم لحمايتهنّ

77
00:06:23,270 --> 00:06:25,030
!أخبرهم أنّي لستُ الشّجاع المزيّف

78
00:06:27,490 --> 00:06:28,610
.هذا صحيح

79
00:06:28,610 --> 00:06:31,570
.لكي ينجح هذا الفخّ، يجب القيام بخطوة مهمّة

80
00:06:31,570 --> 00:06:35,990
وهي أنّ أوّل شجاع يصل إلى المعبد

81
00:06:35,990 --> 00:06:38,830
...سيكون ضحيّة ذلك الفخّ

82
00:06:39,620 --> 00:06:42,420
لذلك فمن دفعني لأقع ضحيّة لذلك الفخّ

83
00:06:42,420 --> 00:06:44,840
.هو من أرسلني إلى المعبد

84
00:06:44,840 --> 00:06:47,590
!أدليت-سان! اتّجه للمعبد

85
00:06:47,590 --> 00:06:49,590
!سنهتمّ بأمرها

86
00:06:50,180 --> 00:06:52,840
كلاّ... أهذا صحيح؟

87
00:06:53,510 --> 00:06:55,100
!ناشيتانيا

88
00:07:00,770 --> 00:07:01,850
...أدليت-سان

89
00:07:05,860 --> 00:07:09,280
.أستقيل

90
00:07:09,740 --> 00:07:11,780
.أعني أنّي أستسلم

91
00:07:11,780 --> 00:07:14,450
!أيّتها الأميرة، ما الّذي تقولينه؟

92
00:07:14,450 --> 00:07:16,030
...ما قلتُه يا غولدوف

93
00:07:16,870 --> 00:07:19,450
.هو أنّي السّابع

94
00:07:27,460 --> 00:07:29,300
...أنا آسفة

95
00:07:34,180 --> 00:07:36,890
.ربّما كان بمقدوري الاستمرار بهذا لوقت أطول

96
00:07:36,890 --> 00:07:42,600
لكن ما كان لشيء قد أقوله أن ينفع بالنّظر
.للطّريقة الّتي يتصرّف بها أدليت-سان

97
00:07:43,020 --> 00:07:44,520
.كان ذلك خطئي

98
00:07:44,520 --> 00:07:47,520
،عرفتُ بوجود أدوات إضافية للقيام بالطقوس

99
00:07:47,520 --> 00:07:50,940
.لكنّي لم أعرف أنّها أيضًا جزء من طريقة تشغيل الحاجز

100
00:07:50,940 --> 00:07:53,160
.كان عليّ أن أتحرّى أكثر عن الأمر

101
00:07:54,030 --> 00:07:56,910
.لكنّي لم أصدّق أنّي لم أهزم ولا واحد بينكم

102
00:07:57,490 --> 00:08:00,830
.توقّعتُ أنّي على الأقل سأقضي على اثنين منكم

103
00:08:01,200 --> 00:08:04,620
.ربّما السّبب هو لأنّي لم أكن عنيفة كفاية

104
00:08:04,620 --> 00:08:09,250
كان بمقدوري أن أتقرّب أكثر لأدليت-سان
.وأقتله، أو أدفع غولدوف لقتله

105
00:08:09,250 --> 00:08:11,720
...كانت هنالك طرق عدّة

106
00:08:12,380 --> 00:08:17,010
.لكنّ الأمر لم يسر كما يجب، لم أستعمل أيّة واحدة منها

107
00:08:17,850 --> 00:08:21,730
.ظننتُ أنّ أدليت-سان غبيّ يسهل خداعه

108
00:08:21,730 --> 00:08:26,480
وأنّه يمكن قتله بسهولة، وهذا ما كنتُ
.أريده أن يوجد في ضحيّتي الأولى

109
00:08:26,810 --> 00:08:31,230
.لم أعتقد أبدًا أنّه قد يكتشف أمري أوّلاً

110
00:08:31,230 --> 00:08:32,610
...وهانز-سان

111
00:08:33,110 --> 00:08:37,160
.ظننتُ أنّك ستكون خصمي الأكثر صعوبة

112
00:08:37,160 --> 00:08:39,280
!كنتُ على حقّ

113
00:08:39,280 --> 00:08:42,620
.ما كنت لأخسر لولاك

114
00:08:45,000 --> 00:08:47,040
لماذا حاولتِ قتلنا؟

115
00:08:48,170 --> 00:08:51,380
كلاّ... هل حاولتِ فعلاً قتلنا؟

116
00:08:51,800 --> 00:08:55,970
الانضمام لإله الشّر وتدمير العالم؟

117
00:08:55,970 --> 00:08:58,930
.بصراحة، ما كان عليّ فعل هذا

118
00:08:58,930 --> 00:09:02,720
.كان عليّ إخباركم بكلّ شيء وطلب مساعدتكم

119
00:09:03,270 --> 00:09:05,690
.ذلك لا يهمّ الآن

120
00:09:05,690 --> 00:09:08,190
!أيّتها الأميرة! أخبريني رجاءً

121
00:09:08,190 --> 00:09:10,570
ما الّذي تحاولين فعله؟

122
00:09:10,570 --> 00:09:12,530
!سوف أتبعك أينما ذهبتِ

123
00:09:13,400 --> 00:09:20,160
في الواقع يا غولدوف، إذا كنتَ قد فعلتَ
،ما طلبتُه منك وحسب دون أسئلة

124
00:09:20,160 --> 00:09:22,540
.كنتُ لأخبرك بالحقيقة

125
00:09:23,290 --> 00:09:24,410
...ولكن

126
00:09:25,120 --> 00:09:27,540
!لم أتوقّع أبدًا أن تقول لي هذا

127
00:09:30,670 --> 00:09:33,760
.أيّتها الأميرة، تريد تشامو أن تعرف

128
00:09:33,760 --> 00:09:36,170
لماذا أردتِ قتلنا؟

129
00:09:38,010 --> 00:09:41,300
.أريد سلامًا حقيقيًّا

130
00:09:41,300 --> 00:09:47,020
أريد عالمًا يستطيع فيه إله الشّر والكيوما
.والبشر أن يعيشوا دون قتال

131
00:09:48,060 --> 00:09:50,190
.ليس لي أيّ شيء ضدّكم

132
00:09:50,560 --> 00:09:54,780
.لكنّي كنتُ بحاجة لإعادة إحياء إله الشّر

133
00:09:55,320 --> 00:09:59,820
.كنتُ بحاجة لقتل الشّجعان السّتّة

134
00:09:59,820 --> 00:10:01,410
!لستُ أفهم

135
00:10:01,410 --> 00:10:03,410
!ما الّذي تقولينه أيّتها الأميرة؟

136
00:10:03,410 --> 00:10:05,700
.لديّ طلب لكم جميعًا

137
00:10:06,500 --> 00:10:08,710
هلا انسحبتم؟

138
00:10:09,710 --> 00:10:12,340
.سأهتم بأمر إعادة إحياء إله الشّر

139
00:10:12,590 --> 00:10:15,340
!لن أسمح له بتدمير عالم البشر

140
00:10:15,340 --> 00:10:20,470
.لأنّي أحبّ البشر والكيوما بشكل متساوٍ

141
00:10:21,010 --> 00:10:23,010
...أيّتها الأميرة، رجاءً

142
00:10:23,010 --> 00:10:25,100
!أخبرينا بالأمر بطريقة يمكننا فهمها

143
00:10:25,100 --> 00:10:31,350
هدفي هو جعل الكيوما تغيّر من عاداتها
.وتحقّق السّلام مع البشر

144
00:10:31,350 --> 00:10:32,480
السّلام؟

145
00:10:32,480 --> 00:10:34,020
ما-ماذا؟

146
00:10:34,020 --> 00:10:36,610
إن قامت بذلك، فهل سيحلّ السّلام على العالم؟

147
00:10:36,860 --> 00:10:38,610
.أجل، بالطّبع

148
00:10:38,610 --> 00:10:41,450
.لكنّي لن أكذب وأقول أنّ الأمر لا يخلو من الخطر

149
00:10:41,450 --> 00:10:44,280
.سيكون هنالك عدد صغير من الضّحايا

150
00:10:44,280 --> 00:10:46,620
.لكنّه عدد قليل للغاية فحسب

151
00:10:47,500 --> 00:10:48,960
كم؟

152
00:10:48,960 --> 00:10:53,460
.إنّه حوالي خمسمائة ألف حسب تقديري

153
00:10:54,960 --> 00:10:56,090
خمسمائة ألف؟

154
00:11:00,930 --> 00:11:03,970
.نعم، فقط خمسمائة ألف

155
00:11:08,020 --> 00:11:09,230
...هانز

156
00:11:09,230 --> 00:11:13,230
...فلايمي... مورا... تشامو

157
00:11:14,270 --> 00:11:15,230
!اقتلوها

158
00:11:32,080 --> 00:11:33,710
ما هذا؟

159
00:11:39,460 --> 00:11:40,760
.هذا مؤسف

160
00:11:42,470 --> 00:11:44,970
.كان إقناعكم مستحيلاً قبل كلّ شيء

161
00:11:44,970 --> 00:11:46,350
ما هذه الرّائحة؟

162
00:11:49,180 --> 00:11:50,310
.إنّها حلوة

163
00:11:50,310 --> 00:11:53,440
كأنّها رائحة تفّاح؟

164
00:12:01,820 --> 00:12:03,150
الأميرة؟

165
00:12:03,150 --> 00:12:07,160
.غولدوف، آسفة لأنّك لا تستطيع مرافقتي

166
00:12:08,240 --> 00:12:09,200
.الوداع

167
00:12:09,200 --> 00:12:12,250
.هذه إحدى تقنيات الكيوما. تقنية من مستوى عالٍ

168
00:12:12,620 --> 00:12:14,250
...فلايمي-سان

169
00:12:14,960 --> 00:12:18,420
.أظنّ أنّنا قد نصل إلى اتّفاق ما

170
00:12:19,170 --> 00:12:20,710
.لا تزال قريبة

171
00:12:22,920 --> 00:12:24,630
.لنتقابل ثانية

172
00:12:25,300 --> 00:12:26,340
!إنّها هناك

173
00:12:27,220 --> 00:12:30,100
!فلايمي، اهتمّي بأدليت

174
00:12:38,270 --> 00:12:39,270
...أدليت

175
00:12:39,730 --> 00:12:40,900
.تماسك

176
00:12:41,740 --> 00:12:44,700
...لا أصدّق أنّها ناشيتانيا

177
00:12:44,700 --> 00:12:46,110
.لا أصدّق هذا

178
00:12:46,450 --> 00:12:47,740
.لا تتكلّم

179
00:12:47,740 --> 00:12:49,660
.أنت تضغط على نفسك كثيرًا

180
00:12:49,660 --> 00:12:51,410
.لقد نزفت الكثير من الدّماء

181
00:12:51,410 --> 00:12:52,910
.انتظر للحظة فحسب

182
00:12:52,910 --> 00:12:55,290
.لديّ مُنشّط معي وإن كان ليس بالكثير

183
00:12:59,290 --> 00:13:01,960
...أصبحتِ أكثر لطفًا

184
00:13:02,590 --> 00:13:04,880
.كان عليك أن تتصرّفي هكذا منذ البداية

185
00:13:04,880 --> 00:13:07,260
.أخبرتك ألاّ تتكلّم

186
00:13:08,970 --> 00:13:11,010
.هذا هو الوجه الّذي رأيته أوّل مرة التقيتُكِ

187
00:13:15,140 --> 00:13:16,810
...أخبريني يا فلايمي

188
00:13:17,350 --> 00:13:18,230
—هل تُـ

189
00:13:18,230 --> 00:13:19,480
.أنا أكرهك

190
00:13:20,400 --> 00:13:22,150
،عندما أكون برفقتك

191
00:13:22,780 --> 00:13:23,860
.أرغب بالعيش

192
00:13:28,360 --> 00:13:30,870
...لن أسمح بموتكِ

193
00:13:32,040 --> 00:13:33,240
...أبدًا

194
00:13:34,700 --> 00:13:35,500
!أدليت

195
00:13:35,960 --> 00:13:38,500
!كلاّ! لا تمت

196
00:14:11,870 --> 00:14:13,280
هل استيقظت؟

197
00:14:13,950 --> 00:14:15,750
.آسفة لأنّي لستُ فلايمي

198
00:14:18,710 --> 00:14:21,250
.تحتوي هذه الأعشاب على طاقة حياة الجبال

199
00:14:22,170 --> 00:14:23,130
.أنا آسفة

200
00:14:23,550 --> 00:14:25,920
.لم أكن قادرة على اكتشاف أنّك لستَ المزيّف

201
00:14:25,920 --> 00:14:27,920
.كانت أكبر غلطة اقترفتُها على الإطلاق

202
00:14:27,920 --> 00:14:30,340
.لا فائدة من التّشبّث بالماضي

203
00:14:30,340 --> 00:14:32,600
.اعتذري للآخرين

204
00:14:32,600 --> 00:14:34,760
.اعتذرت بالفعل

205
00:14:35,430 --> 00:14:36,600
!هانز

206
00:14:36,890 --> 00:14:38,430
ماذا حدث للحاجز؟

207
00:14:38,430 --> 00:14:39,770
.لقد اختفى

208
00:14:39,770 --> 00:14:42,230
.كسرَتهُ ناشيتانيا

209
00:14:42,230 --> 00:14:44,820
.وبعدها هربتْ

210
00:14:44,820 --> 00:14:45,980
.آسف

211
00:14:45,980 --> 00:14:47,240
.فهمت

212
00:14:47,240 --> 00:14:48,360
هل الجميع بخير؟

213
00:14:48,360 --> 00:14:50,860
.نعم، إنّهم بالخارج

214
00:14:52,570 --> 00:14:54,700
.هذه الأشياء رائعة

215
00:14:54,700 --> 00:14:58,200
،لولاك يا أدليت

216
00:14:58,200 --> 00:15:00,960
من كان يعرف كمّ واحدًا منّا كان ليموت؟

217
00:15:01,370 --> 00:15:03,710
!يمكنكِ الاستمرار بالاعتماد عليّ

218
00:15:04,130 --> 00:15:05,960
لأنّك الرّجل الأقوى في العالم؟

219
00:15:05,960 --> 00:15:08,130
،كنتُ لأضحك على هذا في العادة

220
00:15:08,130 --> 00:15:09,670
.لكنّك مختلف

221
00:15:09,670 --> 00:15:11,680
.أبليتَ حسنًا بالفعل

222
00:15:13,180 --> 00:15:15,470
ألا توجد كلمات ثناءٍ لي؟

223
00:15:15,470 --> 00:15:17,720
.بالفعل. أبليتَ حسنًا

224
00:15:17,720 --> 00:15:20,890
لماذا يُعامل هو بشكل مختلف؟

225
00:15:20,890 --> 00:15:27,070
هانز، اللّوح الّذي عثرتَ عليه كان ما
.كشف خطّة ناشيتانيا في النّهاية

226
00:15:27,070 --> 00:15:28,650
.هذا مؤكّد على ما أظنّ

227
00:15:28,650 --> 00:15:32,780
.لكنّي لم أكن قادرًا على معرفة مكان إخفاء الجثّة مثلك أنت

228
00:15:32,780 --> 00:15:35,280
.أنت رائع بكلّ صراحة

229
00:15:35,280 --> 00:15:38,410
.لم ألتقِ من قبل بأحد أستطيع الاعتماد عليه

230
00:15:38,750 --> 00:15:41,000
!ماذا؟ صحيح

231
00:15:41,000 --> 00:15:43,420
!أنت تجعلني أحمرّ خجلاً

232
00:15:43,420 --> 00:15:45,920
ما خطبه؟

233
00:15:51,760 --> 00:15:52,970
أين غولدوف؟

234
00:15:54,260 --> 00:15:55,930
.لا فائدة

235
00:15:55,930 --> 00:15:58,720
.إنّه لا يجيب مهما كان ما أقوله له

236
00:15:59,560 --> 00:16:01,390
.ليس بمقدورنا فعل شيء الآن

237
00:16:03,940 --> 00:16:04,900
...هذا صحيح

238
00:16:04,900 --> 00:16:06,900
.لقد اختفى الحاجز

239
00:16:17,330 --> 00:16:18,370
استيقظت؟

240
00:16:18,370 --> 00:16:19,490
.نعم

241
00:16:19,990 --> 00:16:24,540
.آسفة لأنّ فتاتك المفضّلة كانت السّابع

242
00:16:24,960 --> 00:16:27,040
عمّاذا تتحدّثين؟

243
00:16:27,040 --> 00:16:29,800
.المعذرة. لا تتحدّث معي

244
00:16:32,090 --> 00:16:33,800
لا أدري فعلاً

245
00:16:33,800 --> 00:16:36,590
كيف أتحدّث إليك

246
00:16:36,590 --> 00:16:39,100
.أو كيف أواجه نفسي

247
00:16:39,970 --> 00:16:42,810
...لذلك أريد القليل من الوقت

248
00:16:46,310 --> 00:16:47,940
.أريد معرفة شيئين

249
00:16:48,820 --> 00:16:52,490
ستأتين معنا بدل القتال بمفردك، صحيح؟

250
00:16:53,280 --> 00:16:55,570
.نعم، لقد استسلمت

251
00:16:56,030 --> 00:16:57,950
...الشّيء الآخر هو

252
00:16:58,320 --> 00:17:02,000
أصحيح فعلاً أنّك عندما تكونين برفقتي، ترغبين بالعيش؟

253
00:17:05,370 --> 00:17:07,290
!حسنًا! لنبذل قصارى جهدنا

254
00:17:07,920 --> 00:17:10,500
!لنهزم إله الشّر وننجوا بحياتنا

255
00:17:29,810 --> 00:17:31,650
!المعذرة

256
00:17:34,320 --> 00:17:36,780
!أنا... آسفة لتأخّري

257
00:17:36,780 --> 00:17:38,820
.أنا جِدُّ جِدُّ آسفة

258
00:17:38,070 --> 00:17:39,870
هل أنتِ رولونيا؟

259
00:17:40,280 --> 00:17:42,370
!أد-كُن! لم أرك منذ زمن

260
00:17:42,660 --> 00:17:44,870
!عرفتُ أنّه سيتمّ اختيارك

261
00:17:45,750 --> 00:17:48,080
...مرّ زمن طويل، ولكن

262
00:17:48,080 --> 00:17:49,540
من هذه الفتاة؟

263
00:17:50,170 --> 00:17:50,880
...عفوًا

264
00:17:50,880 --> 00:17:53,960
!آ-آسفة! لم أعرفكم بنفسي

265
00:17:53,960 --> 00:17:57,630
.أنا قدّيسة الدّماء رولونيا مانتشيتا

266
00:17:57,630 --> 00:17:59,590
.آسفة لتأخّري

267
00:17:59,590 --> 00:18:01,550
رولونيا، ماذا تفعلينه هنا؟

268
00:18:01,550 --> 00:18:03,560
.آسفة يا مورا-سان

269
00:18:03,560 --> 00:18:07,020
حاولتُ لقاءكم لكنّ الضّباب قد حلّ
.ولم أستطع الاقتراب أكثر

270
00:18:07,020 --> 00:18:08,770
!أنا جدُّ آسفة

271
00:18:08,770 --> 00:18:10,650
.هذا ليس ما كنتُ أقصده

272
00:18:10,650 --> 00:18:14,900
،أعرف أنّي لستُ قويّة كفاية لأكون واحدة من الشّجعان السّتّة

273
00:18:14,900 --> 00:18:16,900
!لكنّي سأبذل جهدي

274
00:18:16,900 --> 00:18:18,400
...رولونيا، أنتِ

275
00:18:18,740 --> 00:18:20,450
!أرني علاتمكِ يا رولونيا

276
00:18:20,450 --> 00:18:21,240
.حاضرة

277
00:18:25,580 --> 00:18:26,790
.مستحيل

278
00:18:28,080 --> 00:18:31,790
...لقد كنتُ أتساءل

279
00:18:32,540 --> 00:18:35,000
لماذا هنالك سبعة شجعان؟

280
00:18:37,630 --> 00:18:39,010
...يا إلهي

281
00:18:39,300 --> 00:18:42,220
.يبدو أنّ دوري قد حان أخيرًا

282
00:18:55,360 --> 00:18:58,990
،أنا دولتوم الثّالث، ملكُ غوينباير
.وهؤلاء هم حرسي الملكيّ

283
00:18:58,990 --> 00:19:02,240
.سمعتُ بخبر تشغيل حاجز الخيال فأتيتُ مسرعًا

284
00:19:02,240 --> 00:19:04,910
.أنا سعيد لأنّ الشّجعان السّتّة بخير

285
00:19:05,330 --> 00:19:08,660
منحني جنودي تقريرًا للتّو

286
00:19:08,660 --> 00:19:14,670
يفيد أنّ جميع الكيوما المنتشرة عبر القارّة
.متّجهة الآن إلى هذه الغابة

287
00:19:14,670 --> 00:19:17,590
.من المحتمل أن تصل إلى هنا في غضون ساعات

288
00:19:17,590 --> 00:19:20,260
!هنالك ما يقارب ألفين منها

289
00:19:20,680 --> 00:19:21,930
ألفين؟

290
00:19:23,010 --> 00:19:25,470
.ربّما علينا التّراجع

291
00:19:25,470 --> 00:19:27,430
!لا أريد التّراجع

292
00:19:27,430 --> 00:19:30,020
.لكنّنا لا نعرف من هو العدوّ

293
00:19:30,020 --> 00:19:32,650
.رولونيا، تشامو على حقّ

294
00:19:32,650 --> 00:19:35,230
.كلّما زاد الخطر، زاد المرح

295
00:19:35,230 --> 00:19:38,730
...إن جهّزت رولونيا فخًّا من البداية

296
00:19:39,740 --> 00:19:45,280
...فربّما تكون قد وضعت واحدًا مفترضة أنّنا سنتراجع

297
00:19:45,530 --> 00:19:48,160
!رولونيا ليست عدوّتنا بكلّ تأكيد

298
00:19:48,490 --> 00:19:49,580
.آسفة يا مورا

299
00:19:49,580 --> 00:19:51,120
.لكنّي لا أستطيع أن أثق بكِ أيضًا

300
00:19:51,120 --> 00:19:52,210
!مهلاً

301
00:19:52,210 --> 00:19:54,380
!تشامو لا تثق بك أيضًا

302
00:19:54,380 --> 00:19:57,130
...أيّها الشّجعان السّتّة... كلاّ

303
00:19:57,420 --> 00:19:59,260
لماذا أنتم سبعة؟

304
00:20:01,380 --> 00:20:03,340
.لا فائدة من الحديث

305
00:20:03,890 --> 00:20:05,600
،يا ملكَ غوينباير

306
00:20:05,600 --> 00:20:11,100
،أنا واثق أنّك مرتبك، لكنّي الرّجل الأقوى في العالم
.لذلك أريدك أن تقوم بما أمليه عليك

307
00:20:11,100 --> 00:20:14,190
هل تستطيع إعادة تشغيل حاجز الخيال؟

308
00:20:14,520 --> 00:20:17,820
.لقد جهّزت مياهًا ومؤنًا كافية للبقاء هنا

309
00:20:17,820 --> 00:20:20,030
.أستطيع القيام بذلك في الحال

310
00:20:20,030 --> 00:20:24,200
.إذًا شغّل الحاجز بعد ثلاثين دقيقة

311
00:20:24,200 --> 00:20:27,660
.واحمهِ إلى أن يُهزم إله الشّر

312
00:20:27,660 --> 00:20:29,410
.مفهوم

313
00:20:29,830 --> 00:20:34,620
.في الوقت الحالي، أنا الوحيد الّذي تأكّدنا أنّه ليس السّابع

314
00:20:35,000 --> 00:20:37,590
لذلك يبدو اتّباعي منطقيًّا، صحيح؟

315
00:20:37,590 --> 00:20:39,880
.أنا قلق بشأن ذلك

316
00:20:39,880 --> 00:20:42,670
.لكن في الوقت الحالي، هذا كلّ ما بإمكاننا فعله

317
00:20:42,670 --> 00:20:43,930
.معك حق

318
00:20:43,930 --> 00:20:46,140
.سوف نتبعك في الوقت الحاليّ

319
00:20:46,140 --> 00:20:47,930
...إن كان هذا رأيكِ يا أوبا-تشان

320
00:20:47,930 --> 00:20:49,930
.إن كان هذا قرارك يا أد-كُن

321
00:20:50,970 --> 00:20:52,060
.لا بأس

322
00:20:59,570 --> 00:21:01,190
أأنتَ واثق من هذا يا أدليت؟

323
00:21:01,190 --> 00:21:03,780
.لا نعرف من هو السّابع

324
00:21:03,780 --> 00:21:05,660
،إن انتظرنا حتّى نكتشف ذلك

325
00:21:05,660 --> 00:21:07,910
.فقد لا نكون قادرين على هزيمة السّابع

326
00:21:07,910 --> 00:21:09,910
هل أنتِ موافقة على هذا؟

327
00:21:09,910 --> 00:21:11,200
.لا بأس

328
00:21:11,580 --> 00:21:15,580
.أد-كُن، لا زلتَ لم تُشفى بعد، لذلك أمسك بكتفي

329
00:21:15,580 --> 00:21:18,080
—لا بأس. يمكنني الرّكض على الأقلّ

330
00:21:19,040 --> 00:21:20,920
.أنا قدّيسة الدّماء

331
00:21:20,920 --> 00:21:22,550
.أنا جيّدة في العلاج

332
00:21:24,510 --> 00:21:25,420
!فلايمي

333
00:21:42,440 --> 00:21:43,690
...هذه هي

334
00:21:46,360 --> 00:21:47,990
.أرض الشّياطين العاوية

335
00:21:50,410 --> 00:21:52,290
.لقد سُدّت طريق فرارنا

336
00:21:52,290 --> 00:21:56,870
.لا يمكننا المغادرة إلى أن نهزم إله الشّر

337
00:21:56,870 --> 00:21:59,960
.وهذا ينطبق على السّابع أيضًا

338
00:22:01,670 --> 00:22:02,710
.لننطلق