1
00:00:01,850 --> 00:00:04,270
.ليُظهر الجميع علامة بتلات الزّهرة السّتّة

2
00:00:04,270 --> 00:00:06,230
...هنالك سبعة منّا

3
00:00:06,230 --> 00:00:08,440
قبل زمن طويل، قسّمت قدّيسة الزّهرة الواحدة

4
00:00:08,440 --> 00:00:11,900
.قوّتها إلى ستّة أجزاء من أجل الأجيال القادمة

5
00:00:12,270 --> 00:00:15,780
.يحمل كلّ شجاع قطعة واحدة منها

6
00:00:17,320 --> 00:00:21,040
.بعبارات أخرى، هنالك واحد مزيّف بيننا

7
00:00:21,040 --> 00:00:23,660
لكن لِمَ هنالك واحد مزيّف بيننا؟

8
00:00:24,330 --> 00:00:27,210
!واحد منّا هو العدوّ

9
00:00:44,060 --> 00:00:47,230
شجعان الزّهرة السّتّة

10
00:01:58,760 --> 00:02:01,260
.لقد هوجمنا هنا في السّابق

11
00:02:01,640 --> 00:02:03,760
.وبعدها ذهبتُ إلى المعبد

12
00:02:06,980 --> 00:02:08,520
!أدليت

13
00:02:11,020 --> 00:02:12,020
.لنذهب

14
00:02:16,030 --> 00:02:17,030
،هانز

15
00:02:17,440 --> 00:02:19,820
.لم أسمع باسمك من قبل

16
00:02:19,820 --> 00:02:21,950
أين كنتَ تعيش؟ وماذا كنتَ تفعل؟

17
00:02:21,950 --> 00:02:24,120
.حسنًا، إن سمعتَ به، فلن يكون ذلك جيّدًا بالنّسبة لي

18
00:02:24,120 --> 00:02:25,660
ما الّذي تعنيه بذلك؟

19
00:02:59,820 --> 00:03:02,160
الحاجز مشغّل إذًا؟

20
00:03:14,840 --> 00:03:15,920
.أهلا بعودتكما

21
00:03:16,420 --> 00:03:17,550
كيف سار الأمر؟

22
00:03:17,920 --> 00:03:19,920
.سنضطرّ إلى إبطال الحاجز

23
00:03:19,920 --> 00:03:21,470
...فهمت

24
00:03:24,220 --> 00:03:25,390
...فلايمي

25
00:03:30,770 --> 00:03:32,390
.لا حاجة لتعاطفك

26
00:03:34,650 --> 00:03:36,820
مورا، كيف هي الأمور معكِ؟

27
00:03:36,820 --> 00:03:40,650
.لا يوجد شيء عن إبطال الحاجز في كتاب الكلمات المقدّسة

28
00:03:40,650 --> 00:03:42,990
حسنًا، هذا سيّئ، أليس كذلك؟

29
00:03:43,320 --> 00:03:45,530
.لكن هنالك طريقتان

30
00:03:45,530 --> 00:03:49,660
.الأولى، وحده الشّخص الّذي فعّله يمكنه أن يبطله

31
00:03:49,660 --> 00:03:54,040
.والثّانية هي أنّه يمكن إبطال الحاجز بقتل من شغّله

32
00:03:56,000 --> 00:03:59,760
.لا يستطيع بشر أو كيوما اختراق الحاجز

33
00:03:59,760 --> 00:04:02,050
هل يمكن تشغيل الحاجز من الخارج؟

34
00:04:02,050 --> 00:04:03,260
.مستحيل

35
00:04:03,260 --> 00:04:06,260
هل يمكن للبشر فقط تفعيل الحاجز؟

36
00:04:06,260 --> 00:04:07,890
.وحدهم البشر يمكنهم ذلك

37
00:04:08,180 --> 00:04:13,890
بعبارات أخرى، واحد منّا هو البشريّ
.الّذي يقف إلى جانب إله الشّر

38
00:04:15,150 --> 00:04:17,690
!لذلك أخبرتكم أنّها فلايمي

39
00:04:17,690 --> 00:04:21,440
!إذا قتلناها، سيختفي الحاجز وسيكون كلّ شيء على ما يرام

40
00:04:21,440 --> 00:04:22,360
.مهلاً

41
00:04:22,360 --> 00:04:24,950
!أنا أصدّق أنّ فلايمي واحدة منّا

42
00:04:25,860 --> 00:04:27,280
...أنت مزعج

43
00:04:27,280 --> 00:04:28,830
.انتظري يا تشامو

44
00:04:28,830 --> 00:04:31,370
.لنقدّم أنفسنا أوّلاً

45
00:04:31,660 --> 00:04:34,790
.لا زالت هنالك أسماء لا أعرف من أصحابها

46
00:04:36,250 --> 00:04:38,380
...أنت سيّئة في تذكّر الأشياء

47
00:04:39,170 --> 00:04:40,800
.حسنًا

48
00:04:45,430 --> 00:04:47,800
.أخبرونا ما الّذي كنتم تفعلونه قبل أن نتقابل

49
00:04:48,140 --> 00:04:49,050
لِمَ؟

50
00:04:49,720 --> 00:04:52,770
،قد يساعدنا ذلك على معرفة من هو المزيّف

51
00:04:52,770 --> 00:04:55,230
.الشّجاع السّابع

52
00:04:56,310 --> 00:04:57,350
أدليت-سان؟

53
00:04:57,350 --> 00:04:58,980
!سأبدأ أنا

54
00:04:59,940 --> 00:05:02,030
.اسمي أدليت ماير

55
00:05:02,730 --> 00:05:04,740
!أنا الرّجل الأقوى في العالم

56
00:05:05,900 --> 00:05:07,320
.أنا في الثامنة عشر

57
00:05:07,320 --> 00:05:09,410
.وُلدتُ في بلاد البحيرات البيضاء وُورو

58
00:05:09,410 --> 00:05:11,580
.فقدتُ عائلتي وأنا صغير

59
00:05:12,830 --> 00:05:16,540
.اتّجهتُ أنا، الرّجل الأقوى في العالم، بمفردي إلى المعبد

60
00:05:16,540 --> 00:05:19,040
...الأقوى في العالم، الأقوى في العالم

61
00:05:19,040 --> 00:05:21,590
كم مرّة ستردّد ذلك؟

62
00:05:21,590 --> 00:05:25,050
ما الّذي تعنيه "الأقوى في العالم" على أيّ حال؟

63
00:05:25,050 --> 00:05:28,640
.يبدو أنّه يظنّ نفسه أقوى من تشامو

64
00:05:32,180 --> 00:05:34,560
...الأ-الأقوى في العالم

65
00:05:35,270 --> 00:05:37,140
...الأقوى في العالم

66
00:05:38,150 --> 00:05:39,730
!بعبارة أخرى، إنّه أنا

67
00:05:41,020 --> 00:05:43,320
!غبيّ! إنّه مجرّد غبيّ

68
00:05:43,320 --> 00:05:46,190
...إذًا فقد اُخْتير شخص غريب الأطوار كأحد الشّجعان السّتّة

69
00:05:46,190 --> 00:05:48,820
هل عليّ إخباركم عمّا حدث عندما تمّ تشغيل الحاجز؟

70
00:05:48,820 --> 00:05:50,570
.لا، يمكنك إخبارنا لاحقًا

71
00:05:50,570 --> 00:05:51,830
من التّالي؟

72
00:05:53,080 --> 00:05:54,700
.أنا التّالية

73
00:05:55,000 --> 00:05:58,370
.سآخذ كلّ وقتي في الاستماع للفتاة الأرنبة

74
00:05:58,370 --> 00:05:59,710
اسمك هانز، صحيح؟

75
00:05:59,710 --> 00:06:02,590
.ذاك هو تاج أميرةِ بيينا

76
00:06:02,590 --> 00:06:05,460
.ما كان أحد من أمثالك ليُسمح له حتّى بذكر اسمها في العادة

77
00:06:06,340 --> 00:06:08,340
...أنا مهتمّ أكثر الآن

78
00:06:09,050 --> 00:06:10,840
.ناشيتانيا، ابدئي

79
00:06:11,350 --> 00:06:12,300
.حسنًا

80
00:06:12,300 --> 00:06:15,220
،اسمي هو تاشيتانيا لويْ بيينا أَوُغوسترا

81
00:06:15,220 --> 00:06:17,140
،وليّة عهد بيينا

82
00:06:17,140 --> 00:06:19,100
.وقدّيسة الأنصال

83
00:06:19,390 --> 00:06:22,150
.كانت ناشيتانيا أوّل من قابلتُ من الشّجعان

84
00:06:23,650 --> 00:06:25,860
.بالتّفكير بالأمر، فلقد كان لقاءً غريبًا

85
00:06:26,490 --> 00:06:29,740
وبذلك هزمنا أنا وغولدوف وفلايمي-سان

86
00:06:29,740 --> 00:06:32,740
.الكيوما واتّجهنا إلى هذا المعبد

87
00:06:32,990 --> 00:06:36,240
،عندما وصلنا، كان الحاجز قد شُغّل بالفعل

88
00:06:36,240 --> 00:06:38,620
.غطّى الضّباب المنطقة بأكملها

89
00:06:40,170 --> 00:06:41,500
.أنت التّالي يا غولدوف

90
00:06:42,080 --> 00:06:43,500
غولدوف إذًا؟

91
00:06:45,000 --> 00:06:49,090
...لا أصدّق أنّ رجلاً مخلصًا للأميرة هكذا قد يخونها، لكن

92
00:06:50,840 --> 00:06:54,850
.غولدوف أوُرا، قائد فرسان القرن الأسود لبيينا

93
00:06:55,350 --> 00:06:58,060
.كنتُ في مهمّة للعثور على قاتلة الشّجعان

94
00:06:59,310 --> 00:07:03,730
.كنتُ في بلاد الأنهار المقدّسة عندما حصلتُ على العلامة

95
00:07:04,060 --> 00:07:06,150
،بعد أن اجتمعتُ مع الأميرة

96
00:07:06,150 --> 00:07:08,860
،كنّا في طريقنا لمقابلة بقيّة الشّجعان

97
00:07:08,860 --> 00:07:11,110
.عندما سمعنا عن الحاجز في الحصن

98
00:07:11,490 --> 00:07:13,280
،وبعد مغادرتنا للحصن

99
00:07:13,280 --> 00:07:15,620
.قابلنا أدليت وفلايمي

100
00:07:15,620 --> 00:07:18,660
.والبقية هي كما رواها أدليت والأميرة

101
00:07:19,750 --> 00:07:23,380
.لا أصدّق أنّ الشّجعان كانوا يقاتلون بعضهم

102
00:07:24,130 --> 00:07:26,630
.حسنًا، سأكون أنا التّالية

103
00:07:26,880 --> 00:07:29,010
.اسمي هو مورا تشيستر

104
00:07:29,010 --> 00:07:32,130
.أنا قدّيسة الجبال وكبيرة معبد كلّ السّماوات

105
00:07:32,130 --> 00:07:34,800
المعبد الّذي يشرف على القدّيسات؟

106
00:07:34,800 --> 00:07:38,520
،واجبنا هو أكثر من مجرّد مراقبة القدّيسات
.بل والحرص على ألاّ يُسئنَ استعمال قواهنّ

107
00:07:38,850 --> 00:07:43,940
إضافة لذلك، أنا أذكر أسماء ووجوه
.وقدرات كلّ القدّيسات الثّمانية والسّبعين

108
00:07:43,940 --> 00:07:46,980
،عندما نحصل على قدراتنا كقدّيسات

109
00:07:46,980 --> 00:07:49,900
.فهمن الواجب علينا الذّهاب للقاء مورا أوبا-تشان

110
00:07:50,150 --> 00:07:51,740
هل كنتِ تعرفين فلايمي؟

111
00:07:51,740 --> 00:07:53,820
.لا، لم أكن أعرفها

112
00:07:53,820 --> 00:07:56,870
.إنّها قدّيسة حديثة العهد على الأرجح

113
00:07:56,870 --> 00:07:59,290
.لكنّ ذلك لم يحدث منذ قرن أو ما شابه

114
00:07:59,790 --> 00:08:01,080
...لنعد لصلب الموضوع

115
00:08:01,830 --> 00:08:05,170
،قبل عشر سنوات، أخذتُ مكان القائدة السابقة
.قدّيسة الشّمس ريورا-ساما

116
00:08:05,460 --> 00:08:08,000
.ومذّاك الحين، أعتقد أنّه لم تكن هنالك أيّة مشاكل كبيرة

117
00:08:08,300 --> 00:08:11,420
.رغم أنّ إبقاء تشامو تحت السّيطرة كان أمرًا صعبًا

118
00:08:12,130 --> 00:08:15,430
.عندا استيقظ إله الشّر، كنتُ في بلاد القمم الحمراء

119
00:08:16,090 --> 00:08:20,020
.غادرتها في الحال، وسمعتُ بأمر حاجز الخيال في الحصن

120
00:08:20,020 --> 00:08:22,310
.أتيتُ بخطّة منذ يومين

121
00:08:22,810 --> 00:08:25,270
،انتظرتُ وأنا مختبئة في نقطة اللّقاء

122
00:08:25,270 --> 00:08:27,560
.حتّى ظهر هانز البارحة

123
00:08:27,560 --> 00:08:31,320
.وبعدها، عندما رأيتُ الانفجارات البارحة، أتيتُ مسرعة

124
00:08:31,780 --> 00:08:35,070
شخص بمثل قوّتك لم يكن يعرف بشأن الحاجز؟

125
00:08:35,320 --> 00:08:38,200
.سمعتُ بأمره، لكنّي لم أعرف التّفاصيل

126
00:08:38,700 --> 00:08:40,290
،إذا عرفتُ أنّ هذا ما كان سيحدث

127
00:08:40,290 --> 00:08:43,620
...كنتُ لأتحدّث مع الشّجعان المتورّطين بحذر أكثر

128
00:08:44,710 --> 00:08:46,420
.أنتِ التّالية يا تشامو

129
00:08:46,830 --> 00:08:48,960
.أنا تشامو

130
00:08:48,960 --> 00:08:51,420
.قدّيسة المستنقعات، وأنا في الرابعة عشر

131
00:08:51,420 --> 00:08:53,920
.أظنّني أصبحتُ قدّيسة وأنا في السابعة

132
00:08:53,920 --> 00:08:56,260
،تشامو قويّة للغاية

133
00:08:56,260 --> 00:08:59,680
.لذلك كلّما استعملتُ قواي، تغضب منّي مورا أوبا-تشان

134
00:09:02,020 --> 00:09:04,980
دخلتُ في منافسة فنون قتالية في بلاد
.الفاكهة الصّفراء في إحدى المرّات

135
00:09:04,980 --> 00:09:07,900
!أخفقتُ في الجولة الأولى وقتلتُ خصمي

136
00:09:07,900 --> 00:09:11,690
.وبعدها انسحب الجميع للأسف

137
00:09:08,150 --> 00:09:10,940
.هذه هي القصّة المشهورة الّتي تُظهر قوّة تشامو

138
00:09:10,940 --> 00:09:14,650
.إن كانت هي الشّجاع السابع، فسنكون في ورطة

139
00:09:12,150 --> 00:09:14,650
.عندما استيقظ إله الشّر، كنتُ في المنزل

140
00:09:14,650 --> 00:09:17,860
.جهّزني أبي وأمّي لهذه الرّحلة

141
00:09:17,860 --> 00:09:20,330
،فأخذتُ خريطة واتّجهتُ إلى بلاد الشّياطين العاوية

142
00:09:20,330 --> 00:09:22,990
،هزمتُ بعض الكيوما في طريق إلى هنا

143
00:09:22,990 --> 00:09:25,460
،وأتيتُ إلى هنا عندما سمعتُ كلّ هذه الجلبة

144
00:09:25,460 --> 00:09:27,540
.فظهر هذا الضّباب من حيث لا أدري

145
00:09:27,540 --> 00:09:29,540
.وعندما دخلتُ المعبد، وجدتُ فلايمي داخله

146
00:09:29,540 --> 00:09:30,750
!كنتُ متفاجئة

147
00:09:31,040 --> 00:09:32,550
قابلتِ فلايمي من قبل؟

148
00:09:32,550 --> 00:09:33,210
.نعم

149
00:09:33,210 --> 00:09:34,090
.لقد تقابلنا

150
00:09:34,970 --> 00:09:37,180
.فشلتُ في هزيمة تشامو

151
00:09:38,220 --> 00:09:40,510
!تقصدين أنّ تشامو كادت تقتلكِ

152
00:09:40,510 --> 00:09:42,890
هل تلك الفتاة هي قاتلة الشّجعان؟

153
00:09:43,180 --> 00:09:44,810
.يصعب تصديق ذلك

154
00:09:44,810 --> 00:09:45,520
...هانز

155
00:09:45,850 --> 00:09:47,140
.حان دورك

156
00:09:47,140 --> 00:09:48,310
!حسنًا

157
00:09:48,940 --> 00:09:52,190
.اسمي هانز هامبتي

158
00:09:51,190 --> 00:09:54,900
.هانز... إنّه الشّخص الّذي تدور حوله الشّبهات أكثر من غيره

159
00:09:52,190 --> 00:09:54,900
.أنا من... حسنًا، لا يهمّ

160
00:09:55,740 --> 00:09:57,530
.أنا قاتل مأجور

161
00:09:57,530 --> 00:09:58,660
قاتل مأجور؟

162
00:09:58,660 --> 00:10:00,740
تمّ اختيار شخص كهذا كأحد الشّجعان؟

163
00:10:01,280 --> 00:10:04,370
.إنّ من باستطاعتهم هزيمة إله الشّر هم من يُختارون كشجعان

164
00:10:04,700 --> 00:10:05,620
هل أنا مخطئ؟

165
00:10:05,620 --> 00:10:07,000
...لـ-لكن

166
00:10:07,000 --> 00:10:11,130
.العالم ليس مكانًا شريفًا كما تعتقدين

167
00:10:11,460 --> 00:10:13,380
الكثير من أصحاب المراكز العليا

168
00:10:13,380 --> 00:10:16,090
.في حكومتكم قد طلبوا منّي قتل أحد ما

169
00:10:16,090 --> 00:10:17,220
!مستحيل

170
00:10:17,220 --> 00:10:18,840
...سأكمل كلامي

171
00:10:19,880 --> 00:10:24,350
كنتُ قريبًا من أرض الشّياطين العاوية
.عندما تمّ اختياري كأحد الشّجعان

172
00:10:24,640 --> 00:10:26,850
،كانت مقابلة ملك هذه البلاد هي أوّل شيء قمتُ به

173
00:10:26,850 --> 00:10:29,810
وتفاوضتُ معه على السّعر الّذي
.سيدفعه إذا ما هزمتُ إله الشّر

174
00:10:30,310 --> 00:10:32,360
!ينفق الملوك الكثير

175
00:10:32,360 --> 00:10:34,570
.كانت لي أفضليّة ممتازة

176
00:10:34,570 --> 00:10:37,110
،فخبّأت المال وأتيتُ إلى أرض الشّياطين العاوية

177
00:10:37,110 --> 00:10:38,530
.حيث قابلتُ مورا

178
00:10:39,110 --> 00:10:40,410
تفاوضتَ على المال؟

179
00:10:40,410 --> 00:10:43,490
.أحد قواعدي هي ألاّ أقتل دون مقابل

180
00:10:43,780 --> 00:10:46,290
مستحيل. هل تقومون بهذا مجّانًا؟

181
00:10:46,290 --> 00:10:49,160
لم يخبرك الملك بشأن الحاجز؟

182
00:10:49,160 --> 00:10:52,540
.أتى على ذكر شيء كالذّهاب إلى الحصن

183
00:10:52,830 --> 00:10:55,300
.لكنّي تجاهلتُه ظنًّا منّي أنّه ليس بالأمر المهمّ

184
00:10:55,300 --> 00:10:57,170
.سمعتُ عنه من مورا

185
00:10:57,670 --> 00:11:00,340
.لا يوجد ما أضيفه

186
00:10:57,670 --> 00:11:01,340
قابل مورا دون أن يسمع بأمر حاجز الخيال؟

187
00:11:01,340 --> 00:11:04,550
ولماذا لم يخبره الملك؟

188
00:11:04,550 --> 00:11:07,220
أخبرني، لماذا تقوم بالمواء وأنت تتحدّث؟

189
00:11:08,140 --> 00:11:09,560
!هذا سؤال وجيه

190
00:11:09,930 --> 00:11:11,940
.أسلوبي في المبارزة مستوحى من القطط

191
00:11:11,940 --> 00:11:15,190
.لقد أنشأتُه عن طريق تقليد حركات القطط

192
00:11:15,190 --> 00:11:17,940
.يمكنكِ القول أنّ القطط هي من علّمتني

193
00:11:18,990 --> 00:11:22,990
!لذلك أتحدّث مثلها كوسيلة لإظهار احترامي

194
00:11:23,910 --> 00:11:26,910
.كلّ من في مجموعة الشّجعان هذه غريب أطوار

195
00:11:27,240 --> 00:11:28,450
.معك حقّ

196
00:11:28,450 --> 00:11:31,210
.لا يحقّ لك أنّ تتحدّث يا أقوى غبيّ في العالم

197
00:11:31,210 --> 00:11:32,580
!لستَ بحاجة لمناداتي بالغبيّ

198
00:11:32,580 --> 00:11:33,880
.فلايمي أو مهما كان اسمك

199
00:11:35,710 --> 00:11:37,000
.حان دورك

200
00:11:47,060 --> 00:11:49,520
.لا يهمّ إذا كنتِ لا ترغبين بالحديث

201
00:11:49,520 --> 00:11:52,850
.إنّ صمتكِ سيزيد سوء الوضع الّذي أنتِ فيه

202
00:11:54,560 --> 00:11:57,150
أسوأ ممّا هو عليه الآن؟ كيف؟

203
00:11:57,360 --> 00:11:58,480
...فلايمي

204
00:11:59,650 --> 00:12:02,700
.أزيلي غطاء عيني وعصابة رأسي

205
00:12:18,000 --> 00:12:19,130
...هذا

206
00:12:20,460 --> 00:12:21,380
قرن؟

207
00:12:22,420 --> 00:12:26,140
.لقد ولدتُ من كيوما وبشريّ

208
00:12:32,060 --> 00:12:33,770
،قبل عشرين عامًا

209
00:12:33,770 --> 00:12:36,900
.تسلّلت بعض الكيوما لعالم البشر

210
00:12:37,190 --> 00:12:42,490
كان هدفها هو إنشاء بيدقٍ بحيث إذا ما عاد
.إله الشّرّ للحياة، تستطيع قتال الشّجعان به

211
00:12:42,490 --> 00:12:44,030
.كنتُ أنا ذلك البيدق

212
00:12:44,400 --> 00:12:46,070
.كان أبي بشريًّا

213
00:12:46,070 --> 00:12:49,330
.لا أدري ما هو شكله أو لماذا فعل هذا

214
00:12:49,830 --> 00:12:52,540
.لقد قُتل بعد أن تمّ إخصاب أمّي

215
00:12:52,950 --> 00:12:56,790
.وُلدتُ من أمّ من الكيوما، وتربّيتُ بين الكيوما

216
00:12:57,630 --> 00:13:01,130
اختطفت أمّي وجماعتها العديد وأخذوهم
،إلى أرض الشّياطين العاوية

217
00:13:01,130 --> 00:13:03,970
.وقد أُجبروا على بناء معبد لإله البارود

218
00:13:04,630 --> 00:13:07,680
.وهناك حصلتُ على قوّة قدّيسة البارود

219
00:13:07,970 --> 00:13:11,060
.أصبحتُ قويّة كما كانت تأمل أمّي

220
00:13:11,060 --> 00:13:14,680
،غادرتُ أرض الشّياطين العاوية امتثالاً لأوامرها

221
00:13:14,980 --> 00:13:17,690
.لأعجّل عودة إله الشّر للحياة

222
00:13:17,690 --> 00:13:19,730
.لم أشكّ بالأمر أبدًا

223
00:13:20,690 --> 00:13:24,690
.كنتُ نصف بشريّة، ومع ذلك اعتبرتُ نفسي من الكيوما

224
00:13:24,690 --> 00:13:27,950
،صدّقتُ أنّ إله الشّر هو كيان رائع

225
00:13:27,950 --> 00:13:30,280
.سيحمينا ويرشدنا

226
00:13:30,280 --> 00:13:32,160
لماذا أنتِ هنا؟

227
00:13:32,490 --> 00:13:34,950
لماذا قرّرتِ هزيمة إله الشّر؟

228
00:13:35,790 --> 00:13:38,710
.لا أظنّكم ستصدّقونني حتّى لو أخبرتُكم

229
00:13:38,710 --> 00:13:42,460
.لكن قد لا نحظى بفرصة تصديقك أم لا إذا لم تتحدّثي

230
00:13:42,880 --> 00:13:45,420
!أنت أكثر شخص تدور حوله الشّكوك

231
00:13:45,420 --> 00:13:46,630
.مهلاً يا مورا

232
00:13:46,630 --> 00:13:49,840
ألم تقولي أنّ البشر وحدهم من يمكنهم تشغيل الحاجز؟

233
00:13:50,140 --> 00:13:51,600
.صحيح

234
00:13:52,060 --> 00:13:56,600
ألن يكون من المستحيل إذًا لشخص نصفه
كيوما مثل فلايمي أن يشغّله؟

235
00:13:56,600 --> 00:13:59,980
.نعم، أظنّ أنّها تستطيع تشغيله

236
00:14:01,610 --> 00:14:02,520
لِمَ؟

237
00:14:02,860 --> 00:14:06,990
هل تعرف أنّ هنالك أشياء في هذا
المعبد تمنع دخول الكيوما إليه؟

238
00:14:06,990 --> 00:14:09,240
أعمدة قدّيسة الملح؟

239
00:14:09,910 --> 00:14:12,330
.لكنّ فلايمي قد دخلت

240
00:14:12,580 --> 00:14:13,450
...هذا

241
00:14:13,450 --> 00:14:16,370
،هذا يعني أنّها تستطيع القيام بأمور مستحيلة على البشر

242
00:14:16,370 --> 00:14:19,210
.وأمور مستحيلة على الكيوما

243
00:14:19,830 --> 00:14:22,670
هذه هي حقيقتك، صحيح؟

244
00:14:24,800 --> 00:14:26,210
.نعم، هذا صحيح

245
00:14:26,210 --> 00:14:27,380
!فلايمي

246
00:14:27,380 --> 00:14:29,220
.لا داعي للكذب

247
00:14:29,760 --> 00:14:32,390
.أنا لم أشغّل الحاجز بالطّبع

248
00:14:32,760 --> 00:14:35,720
لكنّ هل ما قالته مورا حقيقيّ بالفعل؟

249
00:14:35,720 --> 00:14:37,230
.كلّه حقيقة

250
00:14:37,520 --> 00:14:41,230
.من وجهة نظري، أنت مشتبه بكِ كغيرك

251
00:14:41,690 --> 00:14:44,610
.لا يوجد ما يضمن أنّك تقولين الحقيقة

252
00:14:46,530 --> 00:14:47,690
.هذا صحيح

253
00:14:48,070 --> 00:14:51,280
...نحن نعرف من تكون مورا، لذلك لم أشكّ بها، لكن

254
00:14:51,570 --> 00:14:54,530
.سمعتُ بأمر الحاجز أيضًا

255
00:14:54,530 --> 00:14:57,410
.أنا أيضًا أخبرتني عنه أوبا-تشان

256
00:14:58,160 --> 00:15:02,670
.لكن لا تنسوا أن هنالك من يكذب بيننا

257
00:15:02,670 --> 00:15:05,880
إذًا يمكن للشّجاع السّابع أن يكون أيّ أحد منّا؟

258
00:15:03,330 --> 00:15:06,920
!أنت من تحوم حولها الشّكوك الآن

259
00:15:06,500 --> 00:15:09,340
.إذا لم أكن حذرًا، فسيبدؤون بالتّشكيك بأمري أيضًا

260
00:15:09,670 --> 00:15:13,680
لكن الآن، الشّيء الأكثر أهميّة هو تخليص
.فلايمي من الشّكوك الّتي تحوم حولها

261
00:15:13,680 --> 00:15:15,720
.أنا لستُ الشّجاع السّابع

262
00:15:16,010 --> 00:15:18,180
.هذا كلّ ما لديّ لأقوله الآن

263
00:15:18,180 --> 00:15:20,440
.تشامو تشعر بالملل

264
00:15:20,690 --> 00:15:22,480
،فلايمي هي الشّجاع السّابع

265
00:15:22,480 --> 00:15:25,320
.كما أنّها قامت بتشغيل الحاجز أيضًا

266
00:15:25,320 --> 00:15:27,730
.كلّ ما علينا فعله هو قتل فلايمي

267
00:15:27,730 --> 00:15:28,690
هذا مجدّدًا؟

268
00:15:29,070 --> 00:15:31,490
أتفضّل تعذيبها إذًا؟

269
00:15:31,910 --> 00:15:33,070
تـ-تعذيب؟

270
00:15:33,360 --> 00:15:34,870
!مهلاً! توقّفي

271
00:15:36,950 --> 00:15:40,330
.لم تعذّب تشامو أحدًا من قبل، لكن سأبذل جهدي

272
00:15:40,330 --> 00:15:42,000
.لا تضيّعي وقتكِ

273
00:15:42,000 --> 00:15:45,000
.لا أظنّ أنّ فلايمي هي الشّجاع السّابع

274
00:15:45,880 --> 00:15:48,670
ما الّذي تقوله أيّها القطّ-سان؟

275
00:15:48,670 --> 00:15:52,090
إن كانت الشّجاع السّابع، فلماذا أدليت على قيد الحياة؟

276
00:15:52,090 --> 00:15:52,880
أنا؟

277
00:15:52,880 --> 00:15:56,600
.اتّضح أنّ هنالك مزيّفًا بيننا بمجرّد أن اجتمعنا

278
00:15:56,600 --> 00:15:59,810
.وذلك هو أسوأ ما يمكن أن يحدث بالنّسبة للشّجاع السابع

279
00:15:59,810 --> 00:16:04,190
.الجميع يعرف اسم ووجه فلايمي لأنها قاتلة الشجعان

280
00:16:04,190 --> 00:16:06,360
.لذلك سيكون من الطّبيعيّ أن تكون من ستُقتل

281
00:16:07,190 --> 00:16:08,360
.هذا صحيح

282
00:16:08,360 --> 00:16:12,610
كان الشّجاع السّابع ليحاول إيقاف الشّجعان
.من الاجتماع مهما كان الثّمن

283
00:16:12,610 --> 00:16:17,660
.لكن حسبما سمعت، فقد كان لديها أكثر من فرصة لقتل أدليت

284
00:16:17,660 --> 00:16:19,200
رغم أنّي الرّجل الأقوى في العالم؟

285
00:16:19,700 --> 00:16:21,290
.فرص كثيرة

286
00:16:21,290 --> 00:16:22,370
!فلايمي

287
00:16:22,370 --> 00:16:26,790
.عندما كنّا معًا، كان أدليت يتقدّمني المسير لوقت طويل

288
00:16:26,790 --> 00:16:27,920
أدليت-سان؟

289
00:16:27,920 --> 00:16:30,130
سرتَ أمام قاتلة الشّجعان؟

290
00:16:31,210 --> 00:16:33,510
!أنا أثق بها

291
00:16:33,510 --> 00:16:34,880
.اتّضح الأمر إذًا

292
00:16:34,880 --> 00:16:38,140
.لقد أتت كلّ هذه المسافة دون أن تقتل أدليت

293
00:16:38,550 --> 00:16:41,770
إن كانت السابع، فما الّذي تحاول تحقيقه بذلك؟

294
00:16:42,890 --> 00:16:43,980
.هذا منطقيّ

295
00:16:44,350 --> 00:16:47,230
.إن كانت عودّتنا، فإنّ الكثير من أفعالها ستكون بلا معنى

296
00:16:47,520 --> 00:16:50,110
...ربّما

297
00:16:50,110 --> 00:16:51,360
.فهمت

298
00:16:51,360 --> 00:16:54,780
.لم أتوقّع أبدًا أن تكون تصرّفاتي سببًا في تبرئتها

299
00:16:55,110 --> 00:16:57,660
أخبريني، هل يمكنني تعذيبها الآن؟

300
00:16:58,370 --> 00:16:59,740
.ليس بعد

301
00:17:00,700 --> 00:17:04,870
.لم أحظى أبدًا بالكثير من الأشخاص يردّون الكلام عليّ

302
00:17:06,580 --> 00:17:09,170
ما العمل الآن؟

303
00:17:12,960 --> 00:17:13,760
!أيّتها الأميرة

304
00:17:14,300 --> 00:17:17,430
...أنا بخير. أصابني دوار خفيف

305
00:17:18,180 --> 00:17:20,300
.اجلسي. لا تضغطي على نفسك

306
00:17:20,300 --> 00:17:21,510
.حاضرة

307
00:17:28,310 --> 00:17:29,360
،أدليت

308
00:17:29,860 --> 00:17:32,110
هل بإمكانك منحنا أكبر قدر من التّفاصيل

309
00:17:32,110 --> 00:17:34,440
عمّا حدث عند تشيغل الحاجز؟

310
00:17:34,440 --> 00:17:35,570
.حسنًا

311
00:17:36,740 --> 00:17:39,120
.كان هنالك امرأة ملقاة على الأرض

312
00:17:39,120 --> 00:17:42,160
.لكّنها كانت كيوما شبيهة بالقرد

313
00:17:42,160 --> 00:17:45,620
...كيوما متحوّلة! لو أمكنني العثور عليها لجعلتُها تتحدّث

314
00:17:45,620 --> 00:17:47,170
!قتلتُها سلفًا

315
00:17:47,710 --> 00:17:49,920
!لقد قابلتها في طريقي

316
00:17:51,040 --> 00:17:53,760
!خسرنا فرصتنا للحصول على المعلومات

317
00:17:54,590 --> 00:17:56,920
.الكيوما كائنات مخلصة

318
00:17:56,920 --> 00:17:59,090
.ما كانت لتتكلّم حتّى ولو قتلتها

319
00:18:02,180 --> 00:18:04,810
.ذهبتُ إلى الباب كما طلبت منّي

320
00:18:06,180 --> 00:18:10,190
.كان الباب مغلقًا ففجّرتُه

321
00:18:10,610 --> 00:18:12,570
.كان المفتاح معي

322
00:18:12,820 --> 00:18:17,070
...أنا واثقة أنّ المجنّد لورين لم يتوقّع هذا

323
00:18:17,650 --> 00:18:21,070
.فهاجمني هذا الشّيء من الدّاخل

324
00:18:21,740 --> 00:18:23,990
.حرّاس صنعتهم قدّيسة الأختام

325
00:18:24,330 --> 00:18:28,870
.سيهاجمون أيّ أحد يفتح الباب دون اتّباع الطّرق الصّحيحة

326
00:18:29,210 --> 00:18:31,830
لهذا السّبب هاجموني؟

327
00:18:32,710 --> 00:18:35,420
كان المكان محروسًا جيّدًا، صحيح؟

328
00:18:36,880 --> 00:18:39,630
.ملك التّلال الحديديّة رجل كتوم للغاية

329
00:18:40,380 --> 00:18:42,720
.أنا واثقة أن هدفه كان تفادي أيّ سوء استخدام

330
00:18:42,720 --> 00:18:45,430
...لقد أُسيئ استخدامه في كلّ الأحوال الآن

331
00:18:45,430 --> 00:18:47,020
ماذا حدث بعد ذلك؟

332
00:18:47,600 --> 00:18:51,600
.عندما فتحتُ الباب، كان الحاجز قد شُغّل بالفعل

333
00:18:52,650 --> 00:18:56,190
.أظنّ أنّه قد شُغّل بمجرّد أن فجّرتُ الباب

334
00:18:57,400 --> 00:19:01,160
.وعندما دخلت، كان السّيف مغروسًا في المنصّة

335
00:19:01,780 --> 00:19:06,040
ممّا يعني أنّ الحاجز قد شُغّل قبل فتحك للباب بقليل؟

336
00:19:06,370 --> 00:19:07,370
.ربّما

337
00:19:07,790 --> 00:19:12,210
.ولم يكن هنالك ما يدلّ على وجود أحد داخل المعبد

338
00:19:15,040 --> 00:19:16,380
هل أنتِ بخير الآن؟

339
00:19:16,380 --> 00:19:19,260
.أجل. آسفة لأني جعلتُك تقلق

340
00:19:21,220 --> 00:19:24,600
.رجاءً لا تعتقد أنّه لا يمكن الاعتماد عليّ

341
00:19:25,760 --> 00:19:28,430
.لقد انزعجتُ قليلاً فحسب

342
00:19:32,150 --> 00:19:33,480
.فهمت

343
00:19:33,810 --> 00:19:37,860
.سيكون قيامك بخدعة من شيمك أكثر من كونك يائسة

344
00:19:37,860 --> 00:19:41,360
يا إلهي... ماذا تظنّني؟

345
00:19:42,570 --> 00:19:43,610
!أدليت

346
00:19:43,610 --> 00:19:45,910
أواثق أنّك لم تتذكّر شيئًا بشكل خاطئ؟

347
00:19:45,910 --> 00:19:47,830
.ماذا هنالك؟ فلا أعتقد هذا

348
00:19:47,830 --> 00:19:49,870
.إذا كنتَ تريد تغيير أيّ شيء، فهذه فرصتك

349
00:19:50,200 --> 00:19:54,130
.بعد هذا، لن نسمح لك بسحب أيّ كلمة ممّا قلت

350
00:19:54,130 --> 00:19:54,960
...لا

351
00:19:56,340 --> 00:20:00,340
.عندما دخلتَ، وجدتَ السّيف داخل المنصّة بالفعل

352
00:20:00,340 --> 00:20:01,840
أنت واثق بشأن ذلك؟

353
00:20:02,300 --> 00:20:05,260
!اخرس وحسب! قلتُ لك أنا واثق

354
00:20:06,050 --> 00:20:07,680
.أنا قاتل مأجور

355
00:20:08,180 --> 00:20:12,560
.لذلك فإنّ الدّخول والخروج متسلّلاً هو اختصاصي

356
00:20:13,480 --> 00:20:15,020
.جيّد أنّنا عرفنا

357
00:20:15,020 --> 00:20:19,570
.أكثر ما يخشاه الأشخاص من أمثالي هو قدّيسة الأختام

358
00:20:19,820 --> 00:20:21,690
.فالقدّيسة تصنع أبوابًا غريبة في كلّ مكان

359
00:20:21,690 --> 00:20:24,070
،فإمّا أنّها تأبى أن تُفتح

360
00:20:24,320 --> 00:20:27,580
.أو أنّه لا يمكننا الخروج إذا ما أُغلقت

361
00:20:27,580 --> 00:20:30,080
.أو أنّ هنالك قضبانًا حديديّة تظهر إذا ما فتحناها

362
00:20:30,080 --> 00:20:32,080
.لقد سبّبت لي الكثير من المتاعب

363
00:20:32,620 --> 00:20:35,580
.أعرف الكثير من أبواب قدّيسة الأختام

364
00:20:38,380 --> 00:20:39,380
وبعد؟

365
00:20:39,880 --> 00:20:41,840
ماذا؟ بماذا يفكّر؟

366
00:20:42,220 --> 00:20:44,840
...هذا الباب مثير للاهتمام

367
00:20:44,840 --> 00:20:49,850
.إنّه قويّ للغاية، لكنّه يأبى أن يُغلق بعد أن يُفتح

368
00:20:50,180 --> 00:20:51,720
ما الّذي تقصده؟

369
00:20:51,720 --> 00:20:54,940
.أنا من يسأل هذا السّؤال يا أدليت

370
00:20:54,940 --> 00:20:56,560
.إنّها قصّة غريبة

371
00:20:56,560 --> 00:20:59,730
.كان الباب مغلقًا عندما أتيتَ إلى هنا

372
00:20:59,730 --> 00:21:03,610
.وقد شُغّل الحاجز في نفس الوقت الّذي كسرتَ فيه الباب

373
00:21:04,360 --> 00:21:08,160
فكيف دخل من قام بتشغيل الحاجز؟

374
00:21:08,160 --> 00:21:09,450
ما الّذي تعنيه؟

375
00:21:09,450 --> 00:21:11,700
—هنالك الكثير من الطّرق لكي

376
00:21:11,700 --> 00:21:12,870
!أدليت

377
00:21:14,210 --> 00:21:18,000
.كان الدّخول للمعبد مستحيلاً قبل أن تدمّر الباب

378
00:21:18,000 --> 00:21:20,340
...كان دخول أيّ أحد، إطلاقًا

379
00:21:20,340 --> 00:21:21,880
.مستحيلاً

380
00:21:23,880 --> 00:21:25,970
أدليت-سان؟

381
00:21:27,260 --> 00:21:29,510
!مهلاً! هذا غير ممكن

382
00:21:29,890 --> 00:21:32,270
كيف؟ كيف دخل؟

383
00:21:32,270 --> 00:21:36,020
.أدليت، من الأفضل أن تفكّر مليًّا وإلاّ ستموت

384
00:21:36,810 --> 00:21:39,270
.الباب لا يُغلق بمجرّد أن يُفتح

385
00:21:39,980 --> 00:21:42,070
.لا توجد أيّة مداخل آخرى

386
00:21:43,320 --> 00:21:45,150
،قد تستعمل قوّة الكيوما

387
00:21:45,150 --> 00:21:48,570
.لكنّها لا تستطيع الاقتراب من المعبد بفضل أعمدة قدّيسة الملح

388
00:21:49,030 --> 00:21:52,290
نسمّي هذا الوضع، الّذي لا يمكن فيه

389
00:21:52,290 --> 00:21:54,580
."الدّخول أو الخروج، "الغرفة الموصدة

390
00:21:56,290 --> 00:21:59,750
في هذه اللّحظة، هل يمكن لأيّ أحد دخول المعبد؟

391
00:22:00,380 --> 00:22:03,340
فيما عداك أنت يا أدليت؟

392
00:23:36,470 --> 00:23:38,930
.في الحلقة القادمة: فخّ وهزيمة نكراء