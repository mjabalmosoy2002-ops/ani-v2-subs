1
00:00:00,600 --> 00:00:01,600
...أدليت

2
00:00:03,060 --> 00:00:05,310
.لا توجّه طبيتك نحوي

3
00:00:06,440 --> 00:00:07,730
.إنّها تجعلني أرغب بقتلك

4
00:00:08,320 --> 00:00:09,730
—ما الّذي

5
00:00:12,820 --> 00:00:14,030
!أدليت-سان

6
00:00:14,320 --> 00:00:16,120
!ابتعد عنها

7
00:00:17,280 --> 00:00:18,030
!توقّف

8
00:00:19,370 --> 00:00:20,870
!لا تهاجميهما يا فلايمي

9
00:00:21,200 --> 00:00:22,120
!توقّفي

10
00:00:23,120 --> 00:00:24,870
لماذا أنت متفاجئ؟

11
00:00:25,960 --> 00:00:27,130
...سبق وأخبرتُك

12
00:00:28,250 --> 00:00:30,840
.إن تقابلنا، فسنحاول قتل بعضنا بعضًا

13
00:00:47,310 --> 00:00:50,520
شجعان الزّهرة السّتّة

14
00:02:07,180 --> 00:02:08,770
!ما الّذي يحدث؟

15
00:02:09,600 --> 00:02:11,560
.أنت تعترض طريقنا يا أدليت

16
00:02:18,360 --> 00:02:19,450
!توقّفوا

17
00:02:20,860 --> 00:02:21,620
...ما الّذي

18
00:02:26,410 --> 00:02:27,540
!توقّفوا جميعًا

19
00:02:28,870 --> 00:02:30,290
!إنّها ليست عدوّتكما

20
00:02:30,540 --> 00:02:32,500
!إنّها واحدة من الشّجعان السّتّة

21
00:02:34,290 --> 00:02:35,670
ماذا قلت؟

22
00:02:41,590 --> 00:02:42,680
!انظرا لهذه

23
00:02:43,220 --> 00:02:45,060
.إنّها واحدة من الشّجعان السّتّة

24
00:02:45,060 --> 00:02:46,180
.إنّها ليست عدوّتنا

25
00:02:46,180 --> 00:02:47,520
...علامة

26
00:02:47,850 --> 00:02:49,020
الشّجعان؟

27
00:02:49,270 --> 00:02:51,350
لماذا تهاجمانها؟

28
00:02:51,350 --> 00:02:52,980
!إنّ فلايمي واحدة منّا

29
00:02:53,360 --> 00:02:57,190
.أدليت-سان، تلك الفتاة هي قاتلة الشّجعان

30
00:02:59,650 --> 00:03:02,490
.هذه معلومة صحيحة اكتشفها غولدوف

31
00:03:06,700 --> 00:03:08,040
.معها حقّ

32
00:03:10,250 --> 00:03:11,620
،ماتورا ويتشيا

33
00:03:11,920 --> 00:03:13,330
،فوديلكا هوري

34
00:03:13,710 --> 00:03:15,040
.أسوري يارا

35
00:03:16,000 --> 00:03:17,920
،لقد قتلتُهم

36
00:03:17,920 --> 00:03:21,010
إضافة للعديد من المحاربين الآخرين بمؤهّلات
.قد تجعلهم الشّجعان المحتملين

37
00:03:21,550 --> 00:03:25,550
.غولدوف وناشيتانيا كانا هدفين محتملين أيضًا

38
00:03:26,140 --> 00:03:28,520
.لكنّك لم تكن ضمن لائحتي

39
00:03:28,810 --> 00:03:29,890
ماذا عن ريورا؟

40
00:03:29,890 --> 00:03:32,270
هل قتلتِ قدّيسة الشّمس أيضًا؟

41
00:03:32,600 --> 00:03:33,520
ريورا؟

42
00:03:33,520 --> 00:03:35,060
.لا فكرة لي بشأن ذلك

43
00:03:35,520 --> 00:03:37,770
.لكنّها كانت أحد الأهداف المحتملين

44
00:03:37,770 --> 00:03:40,280
.أدليت-سان، تعال إلى هنا

45
00:03:41,650 --> 00:03:43,950
لماذا قتلتِ الشّجعان المحتملين؟

46
00:03:44,240 --> 00:03:46,450
.لأعيد إله الشّر

47
00:03:46,740 --> 00:03:49,290
،إذا قتلتُ كلّ المحاربين الأقوياء

48
00:03:49,290 --> 00:03:52,080
.فسيتمّ اختيار الضّعفاء فحسب

49
00:03:53,920 --> 00:03:55,210
فهمتَ الآن؟

50
00:03:55,210 --> 00:03:56,170
،تلك الفتاة

51
00:03:56,790 --> 00:03:58,170
.فلايمي هي عدوّتنا

52
00:04:13,310 --> 00:04:14,100
لِمَ؟

53
00:04:14,440 --> 00:04:16,100
،بغض النّظر عن قوّته

54
00:04:16,100 --> 00:04:18,730
فإن من يحاول إعادة إحياء إله الشّر

55
00:04:18,730 --> 00:04:21,190
.ما كان ليتمّ اختياره كواحد من الشّجعان السّتّة

56
00:04:21,400 --> 00:04:22,860
...لكنّها

57
00:04:22,860 --> 00:04:24,200
.صحيح، قد تكون قد قتلتهم

58
00:04:24,200 --> 00:04:25,570
...لكن يا فلايمي

59
00:04:25,570 --> 00:04:29,330
.أنتِ لا تخطّطين لمساعدة إله الشّر للعودة للحياة الآن

60
00:04:29,740 --> 00:04:30,740
صحيح؟

61
00:04:31,910 --> 00:04:33,830
لديك سبب ما، أليس كذلك؟

62
00:04:34,330 --> 00:04:37,500
.سبب يجعلك تقاتلين إله الشّر الّذي كنتِ تحاولين إعادة إحيائه

63
00:04:39,250 --> 00:04:40,340
.صحيح

64
00:04:40,340 --> 00:04:42,090
سوف تصدّق ذلك؟

65
00:04:42,090 --> 00:04:43,130
!سأصدّقه

66
00:04:46,300 --> 00:04:47,590
.أنا واثق

67
00:04:47,930 --> 00:04:51,100
.رغبتها في هزيمة إله الشّرّ حقيقيّة

68
00:04:51,520 --> 00:04:53,730
،حتّى لو كانت عدوّة للشّجعان في السابق

69
00:04:53,730 --> 00:04:55,640
.إلاّ أنّها إلى جانبنا الآن

70
00:04:55,640 --> 00:04:56,650
...لكن

71
00:04:56,650 --> 00:04:58,400
،إن واصلتما إصراركما على هذا الموقف

72
00:04:58,690 --> 00:05:00,400
.فسأقف إلى جانب فلايمي

73
00:05:14,250 --> 00:05:16,330
.حسنًا يا أدليت-سان

74
00:05:16,620 --> 00:05:17,460
!أيّتها الأميرة

75
00:05:18,290 --> 00:05:20,540
.لا خيار آخر لي إن كنتَ مُصرًّا لهذه الدّرجة

76
00:05:20,920 --> 00:05:24,720
.غولدوف، سنفعل ما يمليه علينا أدليت-سان

77
00:05:30,890 --> 00:05:33,020
.لكن كن حذرًا

78
00:05:33,600 --> 00:05:36,100
.أنت رجل يسهل خداعه

79
00:05:36,100 --> 00:05:37,440
!لا تقلقي

80
00:05:37,440 --> 00:05:39,730
.أنا الرّجل الأقوى في العالم

81
00:05:40,400 --> 00:05:42,020
.أخفضي بندقيّتكِ أيضًا

82
00:05:42,020 --> 00:05:43,900
.لن يقتلك أحد

83
00:05:44,280 --> 00:05:46,110
...في الوقت الحاليّ

84
00:05:46,490 --> 00:05:48,740
،فلايمي-سان، ولنكون واضحين

85
00:05:48,740 --> 00:05:50,740
.فأنا لم أقرّر أن أثق بكِ

86
00:05:51,870 --> 00:05:53,910
.قرّرتُ أن أثق بأدليت-سان

87
00:05:54,540 --> 00:05:56,750
تثقين برجل كهذا؟

88
00:05:57,620 --> 00:05:59,000
.يا لك من فتاة صغيرة ساذجة

89
00:06:10,390 --> 00:06:13,100
لديك خريطة لغوينباير أيضًا؟

90
00:06:13,600 --> 00:06:16,890
.سافرتُ إلى كلّ أرجاء القارّة بحثًا عن قاتلة الشّجعان

91
00:06:17,350 --> 00:06:18,520
ماذا حدث للجوادين؟

92
00:06:18,890 --> 00:06:21,310
.لقد فقدناهما خلال قتالاتنا العديدة ضدّ الكيوما

93
00:06:22,190 --> 00:06:23,860
هل تحدّثتما إلى لورين؟

94
00:06:23,860 --> 00:06:25,070
.منذ برهة فحسب

95
00:06:25,070 --> 00:06:27,570
.ربّما بعدكما بقليل

96
00:06:28,030 --> 00:06:29,200
.حسنًا إذًا

97
00:06:30,070 --> 00:06:33,950
يجب أن تكون قدّيسة الجبال مورا
.في انتظارنا في نقطة الالتقاء

98
00:06:35,080 --> 00:06:36,410
.لنتّجه إلى هناك أوّلاً

99
00:06:36,870 --> 00:06:38,040
.أوافقك الرّأي

100
00:06:38,330 --> 00:06:39,410
.وأنا أيضًا

101
00:06:40,210 --> 00:06:41,290
فلايمي؟

102
00:06:43,380 --> 00:06:44,420
.لا بأس

103
00:06:50,090 --> 00:06:52,050
...لقد أنقذتُ حياتكِ

104
00:06:52,800 --> 00:06:54,930
ألا يمكنكِ أن تشكريني على الأقلّ؟

105
00:06:55,260 --> 00:06:57,220
.لا سبب يدفعني لأكون ممتنّة

106
00:06:58,520 --> 00:07:02,350
يبدو أنّك أصبحتَ مقرّبًا لها كثير
...في اثنتَيْ عشرة ساعة فحسب

107
00:07:02,690 --> 00:07:06,940
فلايمي-سان جميلة للغاية، صحيح؟

108
00:07:07,320 --> 00:07:08,860
.فهمت

109
00:07:08,860 --> 00:07:10,450
.يحبّ الرّجال الفتيات من أمثالها

110
00:07:10,450 --> 00:07:14,450
.إنّهنّ يدفعونكنّ لحمايتهنّ

111
00:07:22,080 --> 00:07:22,830
.أهلاً

112
00:07:23,170 --> 00:07:26,590
.أنا أدليت ماير، الرّجل الأقوى في العالم

113
00:07:27,590 --> 00:07:30,130
كنتَ تسعى خلف قاتلة الشّجعان، صحيح؟

114
00:07:30,420 --> 00:07:32,550
،أفهم أنّك قد لا تجد هذا الأمر صائبًا

115
00:07:32,550 --> 00:07:34,090
.لكن احتفظ بذلك لنفسك في الوقت الحاليّ

116
00:07:36,050 --> 00:07:37,350
،أدليت

117
00:07:37,350 --> 00:07:39,350
كيف حصلتَ على إعجاب الأميرة؟

118
00:07:39,850 --> 00:07:40,930
ماذا؟

119
00:07:40,930 --> 00:07:43,100
أنت قلق بشأن كوننا أنا والأميرة على توافق؟

120
00:07:43,100 --> 00:07:44,770
...لـ-لستُ قلقًا

121
00:07:44,770 --> 00:07:45,980
.لا تقلق

122
00:07:46,610 --> 00:07:49,360
.الأمر ليس كما يدور في بالك

123
00:07:49,990 --> 00:07:52,200
.تحدّثنا عن أمور كثيرة في طريقنا إلى هنا

124
00:07:52,200 --> 00:07:55,240
.الأميرة تعتمد عليك كثيرًا

125
00:07:55,570 --> 00:07:57,160
—احرص على حمايتها

126
00:07:57,160 --> 00:07:58,240
.طبعًا

127
00:07:58,240 --> 00:08:00,500
.أنا الوحيد القادر على ذلك

128
00:08:03,080 --> 00:08:04,540
...يا إلهي

129
00:08:36,110 --> 00:08:36,950
.طيور

130
00:08:42,200 --> 00:08:43,540
!كيوما طائرة

131
00:08:59,720 --> 00:09:00,760
...قنابل

132
00:09:01,260 --> 00:09:02,270
!هذا سيّئ

133
00:09:02,680 --> 00:09:06,560
!معبد حاجز الخيال موجود هناك

134
00:09:16,570 --> 00:09:18,700
أنتِ قدّيسة البارود، صحيح؟

135
00:09:19,030 --> 00:09:21,330
أليس هذا من صنيعك؟

136
00:09:21,330 --> 00:09:22,790
.لا أدري شيئًا عن هذا

137
00:09:32,210 --> 00:09:34,630
.إنّها تحاول تأخيرنا

138
00:09:35,050 --> 00:09:36,590
!سوف نتجاوزها. غولدوف

139
00:09:36,840 --> 00:09:37,550
!أجل

140
00:09:52,940 --> 00:09:54,480
...لقد وصلوا

141
00:09:54,480 --> 00:09:56,190
.حاصروهم

142
00:10:24,060 --> 00:10:25,560
!أعدادها كثيرة

143
00:10:28,270 --> 00:10:29,310
!أدليت-سان

144
00:10:30,190 --> 00:10:32,020
!اتّجه للمعبد

145
00:10:32,020 --> 00:10:33,860
!سنهتمّ بأمرها

146
00:10:35,570 --> 00:10:36,440
!حاضر

147
00:10:38,610 --> 00:10:41,280
،إذًا بصفتي الرّجل الأقوى في العالم

148
00:10:41,280 --> 00:10:44,330
فإنّه من واجبي أن أنقذ الجميع عندما تسوء الأمور، صحيح؟

149
00:10:46,330 --> 00:10:48,660
!دعك من تلك الأشياء

150
00:11:21,240 --> 00:11:22,320
أهذا هو؟

151
00:11:27,080 --> 00:11:29,910
...بالكاد لحقت به أضرار بعد تلك الانفجارات

152
00:11:34,040 --> 00:11:35,000
ما الخطب؟

153
00:11:36,840 --> 00:11:38,840
!تماسكي! سوف أساعدكِ

154
00:11:38,840 --> 00:11:40,630
...بـ-بسرعة

155
00:11:42,630 --> 00:11:45,220
.أسرع إلى المعبد

156
00:11:46,680 --> 00:11:48,100
.ليس هنالك وقت

157
00:11:48,520 --> 00:11:50,180
...أنا بخير

158
00:11:50,730 --> 00:11:51,600
...لذا

159
00:11:53,850 --> 00:11:55,310
.حسنًا. انتظري

160
00:12:02,860 --> 00:12:03,660
.سُحقًا

161
00:12:04,160 --> 00:12:05,280
هل المفتاح معكِ؟

162
00:12:13,210 --> 00:12:15,630
!لم يقل أحد أنّه سيكون مغلقًا

163
00:12:58,080 --> 00:12:59,630
ما هذه الأشياء؟

164
00:13:12,930 --> 00:13:13,890
!كيوما

165
00:13:15,390 --> 00:13:16,770
كان متحوّلاً؟

166
00:13:34,700 --> 00:13:35,790
.مستحيل

167
00:14:26,880 --> 00:14:27,880
من فعلها؟

168
00:14:29,380 --> 00:14:32,680
من شغّل الحاجز؟

169
00:14:40,440 --> 00:14:41,690
!أدليت-سان

170
00:14:43,820 --> 00:14:45,280
ماذا حدث؟

171
00:14:45,280 --> 00:14:47,280
لماذا شغّلتَ الحاجز؟

172
00:14:47,570 --> 00:14:48,700
!ليس أنا من شغّله

173
00:14:48,700 --> 00:14:52,280
!هنالك من شغّل الحاجز ثمّ اختفى فجأة

174
00:14:52,280 --> 00:14:53,740
...إذًا فنحن

175
00:14:53,740 --> 00:14:55,080
محبوسون هنا؟

176
00:15:00,000 --> 00:15:01,670
.بالفعل، لقد وُضع السّيف في المنصّة

177
00:15:02,380 --> 00:15:05,920
.لقد تمّ تشغيل الحاجز كما شرح لنا المجنّد لورين بالضّبط

178
00:15:06,420 --> 00:15:07,760
.لا أصدّق هذا

179
00:15:07,760 --> 00:15:08,630
من فعلها؟

180
00:15:09,010 --> 00:15:11,840
.آسف، لكن لا فكرة لي عمّا حدث

181
00:15:11,840 --> 00:15:14,390
.على أيّ حال، سوف ألغي الحاجز

182
00:15:14,390 --> 00:15:15,140
.معذرة

183
00:15:21,900 --> 00:15:23,350
.الضّباب لا ينقشع

184
00:15:23,730 --> 00:15:25,150
.دعني ألقي نظرة

185
00:15:25,820 --> 00:15:27,900
،صنعت قدّيسة الملح الأخيرة

186
00:15:27,900 --> 00:15:30,320
.التّي كانت أحد الشّجعان حاجزًا مماثلاً

187
00:15:30,320 --> 00:15:31,320
الأخيرة؟

188
00:15:31,650 --> 00:15:32,530
.أجل

189
00:15:32,530 --> 00:15:35,830
،رأت مانياكام أنّ العدوّ قد دُمّر

190
00:15:36,160 --> 00:15:40,120
.فسحبت السّيف واستعملته لتجرح يدها

191
00:15:41,790 --> 00:15:44,830
،وقد قالت بينما تسيل الدّماء على الأرض

192
00:15:45,920 --> 00:15:47,210
."تحرير الحاجز"

193
00:15:53,470 --> 00:15:55,010
.الضّباب لا ينقشع

194
00:15:55,350 --> 00:15:56,390
!سُحقًا

195
00:15:56,390 --> 00:15:57,430
...كلاّ

196
00:15:57,430 --> 00:16:00,140
لا يمكننا المغادرة؟

197
00:16:05,940 --> 00:16:07,360
!تحرير الحاجز

198
00:16:07,650 --> 00:16:08,980
!تحرير الحاجز الآن

199
00:16:08,980 --> 00:16:10,490
!توقّف

200
00:16:14,490 --> 00:16:16,320
.لا يحدث شيء

201
00:16:21,620 --> 00:16:22,120
!أيّتها الأميرة

202
00:16:28,800 --> 00:16:31,210
!سأصبح سيّدة الحاجز

203
00:16:33,550 --> 00:16:34,800
.اهدئي

204
00:16:35,130 --> 00:16:37,220
.لا فائدة من ضرب كلّ شيء بعشوائية هكذا

205
00:16:42,230 --> 00:16:43,940
...معك حقّ

206
00:16:45,810 --> 00:16:46,980
.أنا آسفة

207
00:16:57,200 --> 00:17:00,080
أخبروني، لِمَ هذه الجلبة؟

208
00:17:06,620 --> 00:17:08,750
!إنّه الرّجل الضّخم الّذي قابلتُه سابقًا

209
00:17:10,550 --> 00:17:12,960
وأنتِ أميرةُ بيينا، صحيح؟

210
00:17:12,960 --> 00:17:14,590
تم اختيارك كواحدة من السّتّة إذًا؟

211
00:17:16,220 --> 00:17:17,890
...وأنت

212
00:17:18,680 --> 00:17:20,300
رجل بحزام غريب؟

213
00:17:20,300 --> 00:17:21,390
من أنتِ؟

214
00:17:21,390 --> 00:17:24,980
!سررتُ بلقائك
.أنا قدّيسة المستنقع تشامو روسّو

215
00:17:25,810 --> 00:17:28,600
!تم اختيار تشامو كواحدة من الشّجعان السّتّة

216
00:17:28,600 --> 00:17:31,480
تشامو روسّو مجرّد طفلة؟

217
00:17:31,480 --> 00:17:32,820
من تكون؟

218
00:17:32,820 --> 00:17:36,490
.أنا أدليت ماير، الرّجل الأقوى في العالم

219
00:17:36,740 --> 00:17:40,490
.تمّ اختياري كواحد من الشّجعان السّتّة مثلكِ تمامًا

220
00:17:40,740 --> 00:17:42,200
الأقوى في العالم؟

221
00:17:42,200 --> 00:17:44,250
أليست تشامو هي الأقوى؟

222
00:17:44,950 --> 00:17:46,910
...صحيح أنّي سمعتُ عن قوّتك

223
00:17:47,830 --> 00:17:49,210
!الأقوى في هذا الجيل

224
00:17:49,580 --> 00:17:53,460
.يقال أنّك الأقوى عبر التّاريخ، بعد قدّيسة الزّهرة الواحدة

225
00:17:53,460 --> 00:17:55,260
.لكنّ ذلك ليس صحيحًا

226
00:17:55,260 --> 00:17:58,260
!فأنا هو الأقوى في العالم في حقيقة الأمر

227
00:17:59,050 --> 00:18:01,390
.لقد فهمت

228
00:18:02,010 --> 00:18:03,770
إنّه غبيّ، صحيح؟

229
00:18:04,180 --> 00:18:05,390
.لا بأس إذًا

230
00:18:05,390 --> 00:18:07,600
.لنبدأ بقتل فلايمي

231
00:18:10,400 --> 00:18:11,520
!انتظري يا فلايمي

232
00:18:17,530 --> 00:18:19,070
.مهلاً يا تشامو-سان

233
00:18:20,320 --> 00:18:22,160
.أتساءل لماذا تقفين في طريقي

234
00:18:22,490 --> 00:18:24,870
ما الّذي يدور في بالك؟

235
00:18:24,870 --> 00:18:26,410
!إنّ فلايمي واحدة منّا

236
00:18:26,700 --> 00:18:28,750
.يا لغرابة ما تقوله

237
00:18:28,750 --> 00:18:30,960
.فلايمي هي قاتلة الشّجعان

238
00:18:32,460 --> 00:18:34,460
.يبدو أنّكم تتجادلون بشأن أمر ما

239
00:18:35,420 --> 00:18:36,460
!أوبا-تشان

240
00:18:37,050 --> 00:18:38,880
.لم أركِ منذ وقت طويل يا تشامو

241
00:18:39,380 --> 00:18:40,800
.وأنتِ أيّضًا أيّتها الأميرة ناشيتانيا

242
00:18:41,260 --> 00:18:44,390
.أفترض أنّ ذاك هو غولدوف

243
00:18:44,390 --> 00:18:45,140
هل أنا على صواب؟

244
00:18:45,600 --> 00:18:46,890
...معذرة

245
00:18:48,060 --> 00:18:50,940
.أنا مورا تشيستر، قدّيسة الجبال

246
00:18:51,310 --> 00:18:53,730
.أنا أيضًا كبيرة معبد كلّ السّماوات

247
00:18:54,020 --> 00:18:55,110
.سررتُ بلقائك

248
00:18:57,030 --> 00:18:58,360
...تشامو

249
00:18:58,900 --> 00:19:01,990
.لا يجب أن تكوني أنانيّة

250
00:19:01,990 --> 00:19:03,780
—إنّها ليست غلطة تشامو

251
00:19:03,780 --> 00:19:06,120
.سأستمع لِما لديك لتقولينه لاحقًا

252
00:19:07,580 --> 00:19:09,120
.ابقي صامتة في الوقت الحاليّ

253
00:19:11,580 --> 00:19:12,630
.حاضرة

254
00:19:16,550 --> 00:19:20,380
.بالمناسبة، يبدو أنّ هنالك دخيل بيننا

255
00:19:21,380 --> 00:19:22,890
ما الّذي تقصدينه؟

256
00:19:22,890 --> 00:19:25,510
.يبدو أنّ هنالك أشخاصًا كُثرًا هنا

257
00:19:26,810 --> 00:19:29,810
هل الجميع هنا؟

258
00:19:32,650 --> 00:19:35,520
!هذه المرّة، هنالك فتيات جميلات كثيرات ضمن الشّجعان

259
00:19:35,520 --> 00:19:37,650
.يجعلني ذلك أبذل جهدي

260
00:19:38,070 --> 00:19:40,490
.قابلتُه البارحة فحسب

261
00:19:41,070 --> 00:19:42,450
،هان هامبتي

262
00:19:42,450 --> 00:19:44,740
.واحد من الشّجعان السّتّة

263
00:19:53,620 --> 00:19:54,540
فما الأمر؟

264
00:19:55,040 --> 00:19:56,500
من هو الدّخيل؟

265
00:19:59,840 --> 00:20:02,010
.ليُظهر الجميع علامة بتلات الزّهرة السّتّة

266
00:20:28,120 --> 00:20:29,910
...هنالك سبعة منّا

267
00:20:31,750 --> 00:20:34,960
قبل زمن طويل، قسّمت قدّيسة الزّهرة الواحدة

268
00:20:34,960 --> 00:20:37,840
.قوّتها إلى ستّة أجزاء من أجل الأجيال القادمة

269
00:20:38,460 --> 00:20:42,170
.يحمل كلّ شجاع قطعة واحدة منها

270
00:20:44,380 --> 00:20:46,550
.وبالتّالي، هنالك ستّة شجعان

271
00:20:46,550 --> 00:20:48,800
.لم يكن هنالك خمسة أو أقلّ أبدًا

272
00:20:48,800 --> 00:20:51,390
!ولم يكن هنالك سبعة أبدًا

273
00:20:51,720 --> 00:20:55,520
هل يُعقل أن يتمّ اختيار سبعة شجعان؟

274
00:20:55,520 --> 00:20:56,560
!هذا مستحيل

275
00:20:56,560 --> 00:20:59,150
سبعة شجعان لزهرة البتلات السّتة؟

276
00:20:59,150 --> 00:21:04,360
هل يُعقل أنّ إلهة القدَر قد قرّرت أنّ السّتّة
غير كافيين فأضافت واحدًا؟

277
00:21:04,360 --> 00:21:05,450
.كلاّ

278
00:21:05,700 --> 00:21:07,740
.ومع ذلك، هنالك سبعة منّا

279
00:21:09,950 --> 00:21:11,410
ما المضحك في الأمر؟

280
00:21:12,750 --> 00:21:15,000
.لا داعي للتّفكير بالأمر مليًّا

281
00:21:15,000 --> 00:21:18,790
.بعبارات أخرى، هنالك واحد مزيّف بيننا

282
00:21:18,790 --> 00:21:22,050
لكن لِمَ هنالك واحد مزيّف بيننا؟

283
00:21:22,050 --> 00:21:24,760
.هنالك واحد مزيّف ويأبى أن يعترف بذلك

284
00:21:24,760 --> 00:21:27,430
إذا لم يكن عدوًّا لنا، فلماذا لم يعترف بالأمر؟

285
00:21:27,430 --> 00:21:29,470
.وأيّ شيء آخر مستحيلُ الحدوث

286
00:21:38,230 --> 00:21:39,270
...صحيح

287
00:21:39,270 --> 00:21:42,020
.هذا هو التّفسير المنطقيّ الوحيد

288
00:21:56,580 --> 00:21:59,710
!واحد منّا هو العدوّ

289
00:23:36,100 --> 00:23:38,640
في الحلقة القادمة: الشّجاع السّابع