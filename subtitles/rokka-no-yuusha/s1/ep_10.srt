1
00:00:01,060 --> 00:00:04,900
.لا أفهم أيّ شيء ممّا تفكّر به

2
00:00:05,650 --> 00:00:07,650
.لكن ابقَ هنا لبعض الوقت

3
00:00:09,110 --> 00:00:10,400
...ربّما لأنّي

4
00:00:10,690 --> 00:00:12,950
.قد أكون قادرة على أن أثق بك

5
00:00:13,950 --> 00:00:14,860
.جيّد

6
00:00:15,200 --> 00:00:17,450
.إنّه يعمل بجدّ

7
00:00:18,410 --> 00:00:19,910
.سأعمل بجدّ أيضًا

8
00:00:38,050 --> 00:00:41,220
شجعان الزّهرة السّتّة

9
00:01:53,590 --> 00:01:56,130
قالت أنّها قد تكون قادرة على أن تثق بي؟

10
00:01:56,920 --> 00:01:59,840
...قالت فلايمي ذلك للتّو

11
00:02:01,720 --> 00:02:03,510
لطالما تساءلتُ

12
00:02:03,810 --> 00:02:06,770
.لماذا تصرّ على حمايتي

13
00:02:07,600 --> 00:02:09,390
.لماذا لم تشكّ بأمري

14
00:02:09,390 --> 00:02:11,020
!لماذا تصوّبين سلاحكِ نحوي؟

15
00:02:11,860 --> 00:02:14,110
.إن حاولتَ الكذب عليّ، سأطلق النّار

16
00:02:14,690 --> 00:02:16,400
...مـ-مهلاً

17
00:02:22,660 --> 00:02:24,540
.ظننتُ أنّكِ لستِ عدوّتنا

18
00:02:25,080 --> 00:02:26,790
.ظننتُ أنّي أردتُ حمايتكِ

19
00:02:27,370 --> 00:02:29,080
.لا سبب لي أستطيع إخباركِ به

20
00:02:30,330 --> 00:02:31,250
!فلايمي

21
00:02:31,250 --> 00:02:33,960
.ألم تسمعني؟ لا تحاول الكذب عليّ

22
00:02:35,880 --> 00:02:36,960
...السّبب هو

23
00:02:37,460 --> 00:02:39,840
.لأنّكِ تشبهينني

24
00:02:40,090 --> 00:02:44,350
لقد جرّبتِ ألم الخيانة من قِبل من
...وثقتِ بهم وألم خسارتك موطنك

25
00:02:44,350 --> 00:02:46,600
لماذا كنتُ قادرًا على أن أثق بكِ؟

26
00:02:47,770 --> 00:02:49,230
...لأنّي

27
00:02:52,980 --> 00:02:54,230
...حسنًا

28
00:02:54,820 --> 00:02:56,730
!سأقولها وحسب

29
00:02:59,950 --> 00:03:01,200
،قبل مدّة مضت

30
00:03:01,490 --> 00:03:04,370
.حاولتُ أن أصبح مجرّد أداة حرب

31
00:03:05,030 --> 00:03:07,120
.حاولتُ أن أتخلّى عن قلبي البشريّ

32
00:03:07,830 --> 00:03:12,500
حاولتُ أن أصبح شخصًا لا يقوم بأيّ شيء سوى
.قتل الكيوما الّتي أخذت منه كلّ شيء

33
00:03:13,670 --> 00:03:16,630
.أنا باحث عن الثّأر كما قلتِ وقال معلّمي

34
00:03:17,250 --> 00:03:21,050
ظننتُ أنّها الطّريقة الوحيدة التّي قد أصبح
.بها الرّجل الأقوى في العالم

35
00:03:21,630 --> 00:03:22,760
...ولكن رغم ذلك

36
00:03:23,680 --> 00:03:25,140
.لم ينجح الأمر

37
00:03:26,310 --> 00:03:29,770
.القلب ليس شيئًا يمكن التّخلّص منه

38
00:03:30,930 --> 00:03:32,600
.ليس صحيحًا يا أدليت

39
00:03:32,900 --> 00:03:35,020
.أنا تمكّنتُ من ذلك

40
00:03:35,440 --> 00:03:38,940
،نجوتُ لأّني نجحتُ في التّخلّص من قلبي

41
00:03:38,940 --> 00:03:41,780
.بغرض الثّأر من والدتي وإله الشّر

42
00:03:42,030 --> 00:03:43,490
.هذا ليس صحيحًا يا فلايمي

43
00:03:43,490 --> 00:03:47,030
،إن كنتِ تحاولين التّخلّص من قلبك
.فقلبُك هو ما يدفعك لذلك

44
00:03:47,700 --> 00:03:50,830
.لا يمكن أبدًا التّخلّي عن كلّ شيء لنصبح أقوى

45
00:03:51,790 --> 00:03:54,670
الشّيء الوحيد الّذي لا يمكن إيقافه
!هو الوقوع في حبّ أحدهم

46
00:03:56,040 --> 00:03:57,210
...منذ فترة طويلة

47
00:03:57,210 --> 00:03:59,420
...حسنًا، أظنّني ومنذ أن التقيتُك

48
00:04:01,220 --> 00:04:02,930
.أحببتُك

49
00:04:03,880 --> 00:04:06,430
...أدركتُ الأمر الآن فحسب

50
00:04:07,100 --> 00:04:10,810
.لكنّ مشاعري لم تتغيّر منذ اليوم الّذي التقيتُ فيه بكِ

51
00:04:11,810 --> 00:04:14,730
.فلايمي، أنا أحبّك

52
00:04:15,690 --> 00:04:19,650
عندما التقيتُ بناشيتانيا، عرفتُ
.أنّكِ قاتلة الشّجعان

53
00:04:20,230 --> 00:04:22,820
،لكنّي عندما رأيتُهما يشكّان بكِ

54
00:04:22,820 --> 00:04:24,740
.ظننتُ أنّ ذلك ليس صوابًا

55
00:04:25,410 --> 00:04:27,620
،إن لم يصدّقكِ حتّى زملاؤك

56
00:04:27,620 --> 00:04:29,870
.ظننتُ أنّ عليّ أن أصدّقكِ أنا

57
00:04:30,700 --> 00:04:32,540
،إن لم يرغب أحد في العالم أن يحميكِ

58
00:04:32,960 --> 00:04:34,790
.ظننتُ أنّ عليّ أن أحميكِ أنا

59
00:04:36,790 --> 00:04:40,300
،عندما أدركتُ أنّ أحدنا هو السّابع
.راودني نفس الإحساس

60
00:04:41,000 --> 00:04:44,720
.ظننتُ أنّ عليّ حمايتكِ أكثر من العثور على السّابع

61
00:04:45,720 --> 00:04:48,550
.لم يخطر ببالي أبدًا أن أشكّ بأمرك

62
00:04:50,760 --> 00:04:53,310
ما الّذي تحبّه فيّ؟

63
00:04:53,600 --> 00:04:55,020
...لا أدري

64
00:04:55,020 --> 00:04:58,690
.لكنّي أشعر بالألم في كلّ مرة أراكِ تتألّمين

65
00:04:58,980 --> 00:05:02,650
.حتّى الرّجل الأقوى في العالم لا يستطيع تحمّل الألم

66
00:05:04,860 --> 00:05:06,740
،أين يمكنني أن أعيش

67
00:05:06,740 --> 00:05:08,910
بمجرّد أن يموت إله الشّر؟

68
00:05:10,370 --> 00:05:12,160
.لا أستطيع العودة للكيوما

69
00:05:12,790 --> 00:05:15,160
.وليس لي مكان لأعود إليه في عالم البشر

70
00:05:15,660 --> 00:05:18,710
.خير ما يمكنني التّفكير به هو الموت بعد قتل إله الشّر

71
00:05:19,130 --> 00:05:21,590
.قد يبدو لكِ أنّ الثّأر هو كلّ شيء الآن

72
00:05:22,630 --> 00:05:26,050
،لكن بمجرّد أن ينهي ثأرك
.عليكِ أن تبدئي حياتكِ التّالية

73
00:05:26,050 --> 00:05:28,180
.لن أحظى بحياة

74
00:05:28,510 --> 00:05:30,600
.لن يتقبّلي البشر أبدًا

75
00:05:30,890 --> 00:05:33,520
.أنا ابنةُ كيوما، أنا قاتلةُ الشّجعان

76
00:05:33,520 --> 00:05:35,060
.لا يمكنهم ذلك

77
00:05:35,930 --> 00:05:37,560
!سأهتمّ بالأمر بطريقة ما

78
00:05:37,560 --> 00:05:39,230
.لا تكن غبيًّا

79
00:05:39,560 --> 00:05:40,690
...ما مِن وسيلة

80
00:05:40,690 --> 00:05:42,940
!أنتِ من تتصرّفين بغباء

81
00:05:43,150 --> 00:05:44,860
من تعتقدينني؟

82
00:05:45,570 --> 00:05:48,320
!أنا أدليت، الرّجل الأقوى في العالم

83
00:05:48,660 --> 00:05:51,240
تعتقدين أنّه لا يمكنني حتّى أن أنشئ موطنًا لكِ؟

84
00:05:51,240 --> 00:05:52,950
!مستحيل

85
00:05:54,450 --> 00:05:55,750
...أدليت

86
00:05:56,790 --> 00:05:59,620
.أخبرتُك بكلّ شيء أشعر به

87
00:06:02,460 --> 00:06:04,880
.صدّقيني رجاءً يا فلايمي

88
00:06:05,630 --> 00:06:07,920
.تعيش فلايمي في الظّلام

89
00:06:08,590 --> 00:06:11,300
.إنّها لا تحبّ أحدًا، ولا تثق بأحد

90
00:06:12,300 --> 00:06:16,850
،بثقتك وصداقتك ورغبتك بحماية زملائك

91
00:06:17,180 --> 00:06:19,770
.فأنت كائن من نوع مختلف تمامًا عنها

92
00:06:21,520 --> 00:06:22,650
...أنا أفهمك

93
00:06:23,690 --> 00:06:24,860
.الآن

94
00:06:25,730 --> 00:06:26,900
...فلايمي

95
00:06:37,750 --> 00:06:38,500
!فلايمي

96
00:06:40,710 --> 00:06:44,090
.أنا واثقة الآن أنّك عدوّي

97
00:06:46,050 --> 00:06:47,090
إطلاق نار؟

98
00:06:47,090 --> 00:06:48,340
!لنسرع أيّتها الأميرة

99
00:06:48,340 --> 00:06:49,090
!أجل

100
00:06:52,720 --> 00:06:54,010
!تلك فلايمي

101
00:06:54,300 --> 00:06:55,720
...أدليت

102
00:06:56,010 --> 00:06:57,890
لم ينجح الأمر إذًا؟

103
00:07:00,140 --> 00:07:01,400
...اسمعي يا تشامو

104
00:07:01,730 --> 00:07:03,020
.راقبيه

105
00:07:03,360 --> 00:07:04,820
ما الّذي تفعلينه؟

106
00:07:04,820 --> 00:07:07,530
!هل لديكِ فكرة عن مدى خطورتها؟

107
00:07:07,940 --> 00:07:10,820
.أكيد، دعي الأمر لي

108
00:07:12,280 --> 00:07:13,740
.راقبيه فحسب

109
00:07:13,740 --> 00:07:16,660
.هاجميه فقط إن حاول القيام بشيء ما

110
00:07:16,660 --> 00:07:19,540
.أحسني التّصرّف، ولن أغضب أكثر من هذا

111
00:07:21,080 --> 00:07:23,250
.إذًا فأنتِ غاضبة

112
00:07:24,210 --> 00:07:27,880
إن قمتِ بشيء كهذا ثانيةً، فسيكون عقابك
.أسوأ من مجرّد صفعٍ على مؤخّرتك

113
00:07:29,380 --> 00:07:30,840
.حاضرة

114
00:07:31,220 --> 00:07:32,430
...حسنًا

115
00:07:32,430 --> 00:07:35,640
.تشامو تراقبك، لذلك لا تتحرّك يأيّها القطّ-سان

116
00:07:37,760 --> 00:07:40,230
إذًا فمورا قويّة لدرجة أنّها تخيفك؟

117
00:07:40,680 --> 00:07:43,310
...تشامو قويّة للغاية، لكن

118
00:07:44,190 --> 00:07:46,480
.مورا أوبا-تشان مخيفة

119
00:07:49,940 --> 00:07:51,190
،يا إله الجبال

120
00:07:53,660 --> 00:07:55,240
!أعرني قوّتك

121
00:08:09,880 --> 00:08:11,970
!أيّتها الأميرة! غولدوف

122
00:08:12,420 --> 00:08:13,470
!فلايمي

123
00:08:14,510 --> 00:08:15,470
ما هذا؟

124
00:08:15,470 --> 00:08:17,470
!قوّة صدى الجبل

125
00:08:17,470 --> 00:08:19,510
!مورا أوبا-تشان هي قدّيسة الجبال

126
00:08:19,510 --> 00:08:21,350
!يمكنها القيام بأشياء كثيرة

127
00:08:21,730 --> 00:08:23,190
.لقد هُزم هانز

128
00:08:23,890 --> 00:08:26,650
.لقد نجى، لكنّ حالته حرجة

129
00:08:27,270 --> 00:08:28,980
.كان هذا من صنيع أدليت

130
00:08:29,400 --> 00:08:31,740
.إنّه السّابع قبل كلّ شيء

131
00:08:32,860 --> 00:08:34,990
.اقتلوه في الحال

132
00:08:35,410 --> 00:08:36,740
.دون تردّد

133
00:08:37,820 --> 00:08:39,490
ما الّذي تفكّرين به؟

134
00:08:39,870 --> 00:08:42,290
.سيحفّز هذا الأميرة للقيام بأمر ما

135
00:08:42,580 --> 00:08:46,580
.ولن تسمح له فلايمي بالهرب

136
00:08:46,580 --> 00:08:48,250
—لا يمكنك

137
00:08:54,050 --> 00:08:57,840
أخبرني! حاولتَ القيام بشيء ما للتّو، صحيح؟

138
00:08:58,090 --> 00:09:01,470
هل عليّ أن أرسلك إلى حتفك؟

139
00:09:01,680 --> 00:09:03,270
.لا تكوني غبيّة

140
00:09:03,600 --> 00:09:06,190
.طلبتُ منكِ إبقاءه هناك فحسب

141
00:09:06,520 --> 00:09:07,770
!كلاّ

142
00:09:08,980 --> 00:09:10,110
!مستحيل

143
00:09:10,730 --> 00:09:13,650
!هل أنتِ هي السّابع؟

144
00:09:17,610 --> 00:09:18,570
مورا؟

145
00:09:18,780 --> 00:09:20,490
.هذا ما يبدو

146
00:09:21,370 --> 00:09:22,910
ما الّذي تفعله؟

147
00:09:25,460 --> 00:09:26,960
!هانز بخير

148
00:09:27,210 --> 00:09:28,880
!هذا فخّ من مورا

149
00:09:29,460 --> 00:09:32,170
.قالت أنّه قيد الحياة

150
00:09:34,210 --> 00:09:37,630
.ولن أصدّقك بعد الآن

151
00:09:44,850 --> 00:09:45,930
...أيّتها الأميرة

152
00:09:47,850 --> 00:09:49,560
.أنا آسفة يا هانز-سان

153
00:09:50,310 --> 00:09:53,150
لم تقترف أيّ خطأ، صحيح؟

154
00:09:54,070 --> 00:09:54,860
...أيّتها الأميرة

155
00:09:56,110 --> 00:09:59,160
ما الّذي كنتُ أفعله هنا؟

156
00:10:05,790 --> 00:10:06,660
.تعاليْ

157
00:10:07,250 --> 00:10:08,290
.لنذهب

158
00:10:12,460 --> 00:10:14,550
أيّتها الأميرة؟ ما الخطب؟

159
00:10:23,930 --> 00:10:25,970
!أيّتها الأميرة، هدّئي من روعك

160
00:10:33,980 --> 00:10:37,440
...كان هنالك خطب ما بي اليوم

161
00:10:38,070 --> 00:10:40,160
،حدث الكثير

162
00:10:40,160 --> 00:10:42,990
لم أفهم الكثير ممّا حدث، صحيح؟

163
00:10:43,990 --> 00:10:45,790
.لكنّي هدأت الآن

164
00:10:46,410 --> 00:10:49,250
.هدأتُ أخيرًا يا غولدوف

165
00:10:50,420 --> 00:10:52,540
.هذا جيّد إذًا

166
00:10:53,920 --> 00:10:55,300
أهذا هو إذًا؟

167
00:10:55,300 --> 00:10:57,090
،لأوّل مرة

168
00:10:57,090 --> 00:10:59,880
.أدرك ما هو شعور الغضب الشّديد

169
00:11:00,260 --> 00:11:01,930
!فهمته أخيرًا

170
00:11:03,090 --> 00:11:03,890
...أيّتها الأميرة

171
00:11:04,550 --> 00:11:07,850
...أدليت-سان، لقد وثقت بك

172
00:11:08,350 --> 00:11:09,770
!وثقت بك

173
00:11:12,350 --> 00:11:14,110
أليس هذا رائعًا يا غولدوف؟

174
00:11:14,520 --> 00:11:17,900
!خضتُ الكثير من التّجارب الجديدة منذ أن بدأت رحلتي

175
00:11:18,230 --> 00:11:19,440
وسوف أخوض

176
00:11:19,440 --> 00:11:22,450
الكثيرَ الكثير منها، أليس كذلك؟

177
00:11:30,500 --> 00:11:32,000
...أريد أن أعرف

178
00:11:32,290 --> 00:11:35,460
،إذا ما استسلمتُ لغضبي ومزّقتُ عدوّي لأشلاء

179
00:11:40,880 --> 00:11:43,390
فما هو الشّعور الّذي سيراودني؟

180
00:11:56,360 --> 00:11:57,400
!فلايمي

181
00:12:11,250 --> 00:12:13,290
!أحسنتِ يا فلايمي

182
00:12:13,710 --> 00:12:14,670
.تلك فلايمي

183
00:12:16,960 --> 00:12:20,340
أجل. أدليت-سان هناك، صحيح؟

184
00:12:25,430 --> 00:12:28,050
!فلايمي! عودي للمعبد

185
00:12:28,050 --> 00:12:30,560
!ستعرفين أنّ مورا تكذب إن عدتِ

186
00:12:31,220 --> 00:12:32,270
وماذا في ذلك؟

187
00:12:32,810 --> 00:12:35,650
.لن يغيّر ذلك حقيقة أنّك المزيّف

188
00:12:35,650 --> 00:12:37,150
لماذا تعتقدين ذلك؟

189
00:12:37,150 --> 00:12:38,060
—أنا

190
00:12:43,950 --> 00:12:46,070
...أنا أسرع منها

191
00:12:46,360 --> 00:12:47,950
.سأضطرّ للهرب الآن

192
00:12:49,870 --> 00:12:50,870
!سُحقًا

193
00:12:59,630 --> 00:13:01,420
لا رحمة إذًا؟

194
00:13:20,110 --> 00:13:20,730
!فلايمي

195
00:13:21,730 --> 00:13:23,740
لماذا تعتقدين أنّي المزيّف؟

196
00:13:30,830 --> 00:13:32,450
لماذا لا تهرب؟

197
00:13:33,040 --> 00:13:35,330
.أريدكِ أن تصدّقيني

198
00:13:36,040 --> 00:13:38,830
.لا تفتح فمك القذر ذاك

199
00:13:38,830 --> 00:13:41,290
!أجيبي عن السّؤال يا فلايمي

200
00:13:42,500 --> 00:13:44,340
لأنّي أستطيع رؤية

201
00:13:44,630 --> 00:13:47,840
،الحقيقة البشعة خلف كلماتك

202
00:13:48,130 --> 00:13:50,390
خططك لخداعي

203
00:13:50,390 --> 00:13:52,350
.بكلامك المعسول

204
00:13:52,680 --> 00:13:54,350
!كنتُ أقول الحقيقة

205
00:13:54,930 --> 00:13:56,730
!أنتِ لا ترينَ شيئًا

206
00:13:57,350 --> 00:14:00,270
.يستعمل الكاذبون نفس الكلمات دائمًا

207
00:14:00,270 --> 00:14:02,770
".أنا أثق بك. سأحميك"

208
00:14:02,770 --> 00:14:04,530
".أهتمّ لأمرك"

209
00:14:05,320 --> 00:14:06,950
...لن أصدّق ذلك أبدًا ثانية

210
00:14:07,450 --> 00:14:11,450
.لن يحميني أحد أبدًا
.لن أفكّر حتّى بذلك

211
00:14:12,410 --> 00:14:14,990
،سأقاتل وحيدة، سأعيش وحيدة

212
00:14:15,290 --> 00:14:16,870
.وسأموت وحيدة

213
00:14:17,660 --> 00:14:18,750
...فلايمي

214
00:14:20,330 --> 00:14:22,130
...أعرف

215
00:14:22,130 --> 00:14:25,210
...شعرتُ بالأمر يسري في عروقي وجسدي

216
00:14:25,840 --> 00:14:28,300
أعرف أنّ عدم الثّقة بأحد أفضل

217
00:14:28,300 --> 00:14:31,140
!من الثّقة بهم والتّعرّض للخيانة

218
00:14:31,140 --> 00:14:32,300
!فلايمي

219
00:14:41,150 --> 00:14:43,480
.الأمر ليس أنّ فلايمي لا تثق بالنّاس

220
00:14:43,900 --> 00:14:45,610
.بل هو أنّها قرّرت ألاّ تثق بهم

221
00:14:50,740 --> 00:14:51,820
...إنّها

222
00:14:52,660 --> 00:14:54,910
.إنّها ترغب بالفعل أن تثق بأحد

223
00:14:56,700 --> 00:14:57,620
...فلايمي

224
00:14:57,910 --> 00:14:59,500
لم تكوني قادرة على القضاء عليه؟

225
00:15:00,710 --> 00:15:01,580
مورا؟

226
00:15:05,300 --> 00:15:06,170
.مورا

227
00:15:06,550 --> 00:15:09,300
!ساعديني... سأقتله

228
00:15:09,300 --> 00:15:10,090
.مفهوم

229
00:15:22,440 --> 00:15:23,730
أهذه هي؟

230
00:15:30,450 --> 00:15:33,160
...لا يمكنني فعل شيء لمشاعرك بعد الآن

231
00:15:49,760 --> 00:15:50,300
!ستار دخان

232
00:15:56,430 --> 00:15:57,680
.لقد هرب

233
00:16:02,980 --> 00:16:04,060
أدليت؟

234
00:16:05,270 --> 00:16:06,400
إنّه هناك؟

235
00:16:10,070 --> 00:16:11,440
لِمَ؟

236
00:16:25,920 --> 00:16:27,130
!فلايمي

237
00:16:29,380 --> 00:16:33,130
...لقد استسلم سلفًا

238
00:16:50,400 --> 00:16:51,360
.فهمت

239
00:16:51,780 --> 00:16:53,860
.لكن لا تعتقد أنّك ستنجو من هذا

240
00:16:54,990 --> 00:16:57,490
.ينقصنا واحد أيضًا

241
00:16:58,780 --> 00:17:00,080
هل هانز بخير؟

242
00:17:00,950 --> 00:17:03,160
.أنت من ألحق به الأذى

243
00:17:04,660 --> 00:17:06,250
.كلّ ما يهمّني أن يكون بخير

244
00:17:07,290 --> 00:17:08,710
سوف تخبرنا

245
00:17:09,000 --> 00:17:11,840
.بأمر خططك ومن تعمل معهم

246
00:17:12,670 --> 00:17:15,260
.لا أستطيع للأسف

247
00:17:15,880 --> 00:17:16,930
...إذًا

248
00:17:17,220 --> 00:17:18,300
لكن سوف

249
00:17:19,390 --> 00:17:21,430
!أثبت براءة فلايمي

250
00:17:22,600 --> 00:17:23,640
ماذا؟

251
00:17:23,640 --> 00:17:25,480
هلا أصغيتُما؟

252
00:17:25,850 --> 00:17:27,980
.حتّى وإن رفضتُما، فسأخبركما

253
00:17:28,650 --> 00:17:29,900
ما الّذي تعنيه؟

254
00:17:30,980 --> 00:17:33,070
.يجب على شيء ما أن يتحقّق لينجح هذا

255
00:17:33,070 --> 00:17:35,070
،واحد من السّبعة

256
00:17:35,070 --> 00:17:38,820
.الّذين يحملون علامة الشّجعان هو من شغّل الحاجز

257
00:17:39,450 --> 00:17:41,990
.لا يوجد وقت، لذلك سأنتقل للدّليل

258
00:17:41,990 --> 00:17:45,120
!أنت المزيّف! هذا يكفي

259
00:17:45,660 --> 00:17:47,750
لن أقوم بإخراج سلاح ما، مفهوم؟

260
00:17:50,040 --> 00:17:53,250
.هذا عقار صنعه معلّمي

261
00:17:54,210 --> 00:17:56,550
معلّمك... أيعقل أنّه...؟

262
00:17:57,590 --> 00:18:00,180
.فلايمي، أعيريني أحد رصاصاتك

263
00:18:01,010 --> 00:18:04,770
.يُستعمل هذا العقار للعثور على آثار للكيوما

264
00:18:19,740 --> 00:18:22,870
،عندما يتفاعل مع السّائل الخاص الّذي تُفرزه الكيوما

265
00:18:22,870 --> 00:18:25,500
.يصبح لونه أحمرًا

266
00:18:26,790 --> 00:18:28,290
رأيتِ هذا للتّو، صحيح؟

267
00:18:29,040 --> 00:18:31,830
.فلايمي هي كيوما هجينة، وقد نجح الأمر معها

268
00:18:32,380 --> 00:18:33,630
سبق ورششتُ هذا

269
00:18:33,630 --> 00:18:37,420
.على المنصّة الّتي تشغّل الحاجز

270
00:18:38,930 --> 00:18:41,180
.لم يكن هنالك تفاعل

271
00:18:41,720 --> 00:18:43,140
.هانز رآه أيضًا

272
00:18:46,220 --> 00:18:48,640
.لم تلمس فلايمي المنصّة

273
00:18:48,940 --> 00:18:51,980
.هذا هو دليل براءتها

274
00:18:52,980 --> 00:18:55,900
!الدليل على أنّها لم تشغّل الحاجز

275
00:18:57,820 --> 00:18:59,200
...أدليت

276
00:19:00,450 --> 00:19:01,660
...أيّها الوغد

277
00:19:03,120 --> 00:19:06,080
.إن كنتِ المزيّفة، فأظنّ أنّ خططكِ قد فشلت

278
00:19:06,490 --> 00:19:09,160
.أفسدتُ خططكِ للتّو

279
00:19:09,750 --> 00:19:14,670
!تخطّطين للوم فلايمي بعدي ثمّ قتلها

280
00:19:16,170 --> 00:19:20,170
.إن قُتلتُ، فسيستهدفك السّابع بعدي

281
00:19:21,800 --> 00:19:23,550
.لقد أحببتُك

282
00:19:23,930 --> 00:19:27,060
.فلايمي، أنا أحبّك

283
00:19:31,690 --> 00:19:32,900
،أدليت

284
00:19:33,310 --> 00:19:35,820
.يا لك من رجل

285
00:19:36,110 --> 00:19:38,150
،للحظة

286
00:19:38,150 --> 00:19:40,820
.حتّى أنا اعتقدتُ أنّك قد تكون صادقًا

287
00:19:41,280 --> 00:19:45,070
.لستُ المزيّف، سوف تندمين على هذا

288
00:19:45,370 --> 00:19:47,450
!لهذا السّبب أنت تخيفني

289
00:19:47,740 --> 00:19:51,710
!إن لم أقتلك الآن، سيصدّقك الجميع

290
00:19:54,290 --> 00:19:57,550
.فلايمي، اذهبي لمساعدة هانز بعد أن أموت

291
00:19:57,840 --> 00:19:59,590
.يمكنكِ أن تثقي به

292
00:20:18,900 --> 00:20:20,150
!بلهاء

293
00:20:20,940 --> 00:20:24,780
.أدليت، أنا أكرهك

294
00:20:25,570 --> 00:20:29,540
...كرهتُ حقيقة أنّي كنتُ قد بدأتُ أثق بك

295
00:20:29,540 --> 00:20:31,790
!كفى يا فلايمي! لا تسمحي له بخداعك

296
00:20:32,620 --> 00:20:33,920
.لا زلتُ أكرهك

297
00:20:36,000 --> 00:20:38,290
.كلّما تحدّثتُ إليك، زاد كرهي لك

298
00:20:39,000 --> 00:20:42,010
...أنا أصدّقك

299
00:20:42,800 --> 00:20:46,260
...رغم أنّي قرّرتُ ألاّ أصدّق أحدًا ثانية

300
00:20:46,550 --> 00:20:47,890
...فلايمي

301
00:20:57,100 --> 00:20:58,560
!اهرب يا أدليت

302
00:20:58,560 --> 00:20:59,690
!أنتِ أيضًا

303
00:21:02,650 --> 00:21:04,200
!يا إله الجبال

304
00:21:14,580 --> 00:21:16,620
.سأؤخّر مورا

305
00:21:16,620 --> 00:21:19,130
.كلاّ، ستأتين أيضًا

306
00:21:19,420 --> 00:21:20,290
إلى أين؟

307
00:21:21,460 --> 00:21:22,960
!أنا أفكّر بالأمر

308
00:21:31,600 --> 00:21:33,020
!تأخّرتِ أيّتها الأميرة

309
00:21:33,770 --> 00:21:34,730
...لا يُعقل

310
00:21:39,400 --> 00:21:40,900
.ناشيتانيا

311
00:21:41,980 --> 00:21:43,110
...أدليت

312
00:21:46,490 --> 00:21:47,990
.إنّها عدوّة

313
00:21:50,410 --> 00:21:53,580
.كان هذا ممتعًا يا أدليت-سان

314
00:21:56,790 --> 00:21:59,920
سوف أقتلك الآن، موافق؟

315
00:23:36,220 --> 00:23:38,310
في الحلقة القادمة: هجوم مضاد