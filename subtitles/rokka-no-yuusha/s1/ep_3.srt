1
00:00:01,020 --> 00:00:02,600
...تروي الأسطورة

2
00:00:03,440 --> 00:00:05,850
،أنّه عند استيقاظ الشّياطين من أعماق الظُّلمة

3
00:00:05,850 --> 00:00:08,690
،محوّلة الحياة على الأرض إلى جحيم

4
00:00:09,360 --> 00:00:13,240
ستختار إلهة القدَر ستّة أبطال

5
00:00:13,240 --> 00:00:16,200
.وتمنحهم القوّة لإنقاذ العالم

6
00:00:18,280 --> 00:00:21,620
.دائمًا ما يتمّ اختيار ستّة أبطال

7
00:00:22,250 --> 00:00:26,170
.ولهذا السّبب، أصبحوا يُعرفون بشجعان الزّهرة السّتّة

8
00:00:41,350 --> 00:00:44,560
شجعان الزّهرة السّتّة

9
00:01:58,550 --> 00:02:01,390
بالمناسبة يا غولدوف، هل من تطوّرات؟

10
00:02:01,390 --> 00:02:03,760
.اكتشفتُ دليلاً حاسمًا

11
00:02:03,760 --> 00:02:04,930
...قاتلة الشّجعان

12
00:02:04,930 --> 00:02:07,560
.فتاة بشعر أبيض تحمل بندقيّة

13
00:02:07,560 --> 00:02:09,520
.اسمها فلايمي

14
00:02:15,860 --> 00:02:17,530
...أدليت ماير

15
00:02:17,950 --> 00:02:20,660
.سمعتُ اسمك من قبل

16
00:02:20,660 --> 00:02:23,700
.محارب منافسة بيينا الجبان

17
00:02:24,740 --> 00:02:27,540
.معروف عنه أنّه حثالة

18
00:02:27,540 --> 00:02:28,830
...مـ-مهلاً

19
00:02:28,830 --> 00:02:30,790
.أنا أقوى رجل في العالم

20
00:02:30,790 --> 00:02:34,250
.استعمال كلّ الطرق في متناولي للفوز ليس جبنًا

21
00:02:34,250 --> 00:02:36,050
.وأنا لستُ محاربًا جبانًا بكلّ تأكيد

22
00:02:36,510 --> 00:02:38,970
.ما كان رجل جبان أن يدعو نفسه بالرّجل الأقوى في العالم

23
00:02:38,970 --> 00:02:40,840
.لذلك لا تصوّبي بندقيتكِ نحوي

24
00:02:40,840 --> 00:02:42,430
أين مرافقوك؟

25
00:02:42,430 --> 00:02:44,560
.ناشيتانيا قريبة من هنا

26
00:02:45,060 --> 00:02:47,640
.إنّها أميرة بيينا وقدّيسة الأنصال

27
00:02:47,640 --> 00:02:48,520
.فهمت

28
00:02:48,850 --> 00:02:52,230
أخبر ناشيتانيا والبقية ممّن ستقابلهم

29
00:02:52,520 --> 00:02:54,610
،أنّي أنا فلايمي سبيدرور

30
00:02:54,610 --> 00:02:56,610
.قدّيسة البارود

31
00:02:56,610 --> 00:02:58,030
قدّيسة البارود؟

32
00:02:58,570 --> 00:03:00,240
.لن أرافقكم

33
00:03:00,530 --> 00:03:03,160
.سأحارب إله الشّر بمفردي

34
00:03:03,950 --> 00:03:06,080
،لن أقف في طريقكم

35
00:03:06,450 --> 00:03:08,250
.لذلك دعوني وشأني

36
00:03:09,620 --> 00:03:11,330
.أخبرهم بهذه الكلمات بالتّحديد

37
00:03:11,830 --> 00:03:14,130
أنت قادر على ذلك، صحيح؟

38
00:03:17,380 --> 00:03:18,260
—ما الّذي

39
00:03:22,630 --> 00:03:23,550
!أنتِ

40
00:03:26,050 --> 00:03:27,060
!مهلاً

41
00:03:28,100 --> 00:03:28,970
!سُحقًا

42
00:03:44,070 --> 00:03:46,160
أين ذهبتِ يا فلايمي؟

43
00:03:46,870 --> 00:03:47,740
...العشب

44
00:03:48,160 --> 00:03:49,120
مِن هنا؟

45
00:03:53,370 --> 00:03:54,580
أين أنتِ؟

46
00:04:00,880 --> 00:04:02,090
هناك؟

47
00:04:06,600 --> 00:04:07,600
!سُحقًا

48
00:04:07,600 --> 00:04:09,350
.إنّها معتادة على الفرار

49
00:04:10,850 --> 00:04:12,810
ما مشكلتها؟

50
00:04:22,240 --> 00:04:23,360
.وجدتُها

51
00:04:26,160 --> 00:04:27,660
.إنّه يقترب

52
00:04:27,660 --> 00:04:29,530
كيف استطاع أن يجدني من تلك المسافة البعيدة؟

53
00:04:38,090 --> 00:04:39,710
!كفى

54
00:04:42,840 --> 00:04:45,630
...لا أصدّق أنّك أدركتني

55
00:04:47,800 --> 00:04:49,850
لماذا أتيتَ إلى هنا؟

56
00:04:53,560 --> 00:04:54,640
.لستُ أدري

57
00:04:56,770 --> 00:04:59,770
.إن تبعتني بعد الآن، فسأطلق عليك النّار

58
00:04:59,770 --> 00:05:01,150
!اخرسي أيّتها الغبيّة

59
00:05:01,360 --> 00:05:03,940
!تعرفين أنّه من المستحيل أن تقتلي إله الشّر بمفردك

60
00:05:04,900 --> 00:05:07,450
،إذا لم نعمل نحن السّتّة معًا

61
00:05:07,450 --> 00:05:09,410
!فسنُهزم لا محالة

62
00:05:09,990 --> 00:05:13,200
،إذا كنتَ تريد دليلاً على أنّي أستطيع الفوز بمفردي

63
00:05:13,200 --> 00:05:14,660
.سأعطيك إيّاه

64
00:05:14,660 --> 00:05:16,330
لماذا أنتِ ذاهبة بمفردك؟

65
00:05:16,830 --> 00:05:18,290
لماذا لا تريدين مقابلة بقيّة الشّجعان؟

66
00:05:19,460 --> 00:05:23,300
.إن التقيتُ بهم، فمن المؤكّد أنّي سأُقتل

67
00:05:23,300 --> 00:05:25,720
!جميعنا شجعان الزّهرة السّتّة

68
00:05:26,010 --> 00:05:28,050
لماذا قد نقتل واحدًا منّا؟

69
00:05:29,050 --> 00:05:30,300
.قرّر

70
00:05:30,680 --> 00:05:33,020
.أصغِ للسّبب، وسنحاول قتل بعضنا بعضًا

71
00:05:33,020 --> 00:05:35,310
.أو لا تُصغِ للسّبب، وسنحاول قتل بعضنا بعضًا

72
00:05:35,310 --> 00:05:37,810
.أو دُر وعد أدراجك

73
00:05:43,820 --> 00:05:47,400
.إذا أخبرتُك بالسّبب، ستحاول قتلي أيضًا

74
00:05:47,780 --> 00:05:50,200
.سأقاتل إله الشّر بمفردي

75
00:05:50,200 --> 00:05:52,410
.افعل ما يحلو لك

76
00:05:52,990 --> 00:05:54,870
.وإن أمكن، فلا أريد أن أراك ثانية

77
00:06:17,640 --> 00:06:18,690
ما الّذي تفعله؟

78
00:06:19,520 --> 00:06:21,400
.أفعل ما يحلو لي

79
00:06:21,400 --> 00:06:22,520
هل تسخر منّي؟

80
00:06:22,520 --> 00:06:24,190
أم أنّك مجرّد أحمق؟

81
00:06:24,190 --> 00:06:26,230
!سوف أذهب معكِ

82
00:06:26,860 --> 00:06:28,360
.من الأفضل أن تقتليني بطلقة واحدة

83
00:06:28,700 --> 00:06:31,910
.وإلاّ هربتُ ومعي أغراضك

84
00:06:33,700 --> 00:06:35,370
.أعد أغراضي

85
00:06:35,950 --> 00:06:39,000
.تعلّمتُ كلّ شيء عن الأسلحة النّارية من معلّمي

86
00:06:39,620 --> 00:06:43,130
نقطة ضعف السلاح النّاري هي
.أنّه لا يمكن القتال به دون رصاص

87
00:06:43,420 --> 00:06:44,290
صحيح؟

88
00:06:47,050 --> 00:06:49,760
.يمكنكِ أن تستعيديها منّي، لكنّني سأطاردك ثانية

89
00:06:50,180 --> 00:06:52,140
تعرفين أنّه لا يمكنك الهرب، صحيح؟

90
00:06:57,600 --> 00:06:59,270
،لستُ أعرف وضعكِ

91
00:06:59,270 --> 00:07:03,150
،لكنّك ذاهبة لأرض الشياطين العاوية
.حيث ينتظر إله الشّر والكيوما التابعة له

92
00:07:03,400 --> 00:07:06,530
.وتقولين أنّه إذا رآكِ الشّجعان الآخرون، فسيقتلونكِ

93
00:07:06,730 --> 00:07:07,900
وبعد؟

94
00:07:08,320 --> 00:07:12,820
الرّجل الأقوى في العالم ليس من الأشخاص الّذين
.يتخلّون عن زملائهم عندما يكونون في ورطة

95
00:07:12,820 --> 00:07:15,160
!لذلك قرّرتُ أن أنقذكِ

96
00:07:15,410 --> 00:07:16,620
...هذا يكفي

97
00:07:16,620 --> 00:07:17,990
!كفّي عن الشّكوى

98
00:07:20,710 --> 00:07:21,960
.لنذهب

99
00:07:44,270 --> 00:07:45,940
...لا أصدّق هذا

100
00:07:46,520 --> 00:07:48,730
ما بال هذا الرّجل؟

101
00:07:49,530 --> 00:07:51,610
ما حقيقته؟

102
00:08:12,300 --> 00:08:13,260
!غولدوف

103
00:08:15,180 --> 00:08:16,390
!سأنهي أمرها

104
00:09:05,560 --> 00:09:07,650
هل أنت بخير أيّتها الأميرة؟

105
00:09:08,440 --> 00:09:09,440
...نعم

106
00:09:16,860 --> 00:09:18,870
.تمهّل، تمهّل،تمهّل

107
00:09:19,200 --> 00:09:20,280
.أحسنت

108
00:09:21,280 --> 00:09:22,410
غولدوف؟

109
00:09:26,500 --> 00:09:27,500
ما هذه؟

110
00:09:29,130 --> 00:09:30,710
“.عزيزتي ناشيتانيا”

111
00:09:30,710 --> 00:09:33,840
“.قابلتُ واحدة من الشّجعان السّتّة وسوف ألحق بها”

112
00:09:33,840 --> 00:09:36,550
“.انسَيْ أمري وسيري إلى وجهتنا”

113
00:09:36,550 --> 00:09:38,550
ممّن هذه الرّسالة؟

114
00:09:38,840 --> 00:09:40,470
.مِن أدليت ماير-سان

115
00:09:40,760 --> 00:09:41,680
أدليت؟

116
00:09:43,010 --> 00:09:45,390
سمعتَ بشأن المنافسات، صحيح؟

117
00:09:46,230 --> 00:09:47,690
.لا تنظر إليّ بتلك النّظرة

118
00:09:47,690 --> 00:09:49,400
.إنّه شخص يمكن الاعتماد عليه

119
00:09:49,400 --> 00:09:52,730
على الرّغم من أنّه تخلّى عنك ورحل؟

120
00:09:52,730 --> 00:09:54,900
إلى أين ذهب؟

121
00:09:54,900 --> 00:09:57,700
.أنا قلقة... آمُل أن يكون بخير

122
00:09:59,360 --> 00:10:01,450
...أخبرني رِيْنهوك-دونو

123
00:10:02,160 --> 00:10:05,580
،أنّه لم يتصرّف بطريقة جبانة في المنافسات فحسب

124
00:10:05,580 --> 00:10:07,710
!بل خدعكِ واختطفكِ

125
00:10:07,710 --> 00:10:09,870
.أدليت-سان شخص طيّب

126
00:10:09,870 --> 00:10:12,210
.أظنّ أنّك ستتّفق معه أيضًا

127
00:10:12,540 --> 00:10:15,090
.أنا سعيدة لأنّي خرجتُ في رحلتي

128
00:10:15,300 --> 00:10:19,970
.ما كنتُ لأقابل شخصًا غامضًا مثله في القصر

129
00:10:20,680 --> 00:10:21,800
.فهمت

130
00:10:21,800 --> 00:10:23,970
.وهنالك أمر آخر

131
00:10:23,970 --> 00:10:26,270
!أستمتع كثيرًا عندما أغيظه

132
00:10:26,600 --> 00:10:28,140
...أنا آسف أيّتها الأميرة، لكن

133
00:10:28,140 --> 00:10:28,980
ماذا؟

134
00:10:28,980 --> 00:10:31,860
...هل أنتِ و... أدليت

135
00:10:31,860 --> 00:10:34,730
.ما الخطب؟ أنت تتلعثم في الكلام

136
00:10:34,730 --> 00:10:38,240
هل تغيّرتَ بطريقة ما عن آخر مرّة رأينا فيها بعضنا؟

137
00:10:39,490 --> 00:10:42,740
.أنا آسف. انسَيْ الأمر رجاءً

138
00:10:43,580 --> 00:10:45,370
،لا أعرف ما الّذي يحدث

139
00:10:45,370 --> 00:10:48,250
.لكنّي جادّ في مسألة حمايتي لكِ

140
00:10:49,250 --> 00:10:53,250
.أنتِ واحدة منّا نحن السّتّة

141
00:10:53,250 --> 00:10:56,130
.اخرس وتابع المسير. أنت تغضبني

142
00:11:01,640 --> 00:11:03,510
كيف حدث هذا؟

143
00:11:10,140 --> 00:11:12,190
...قال لي معلّمي

144
00:11:12,190 --> 00:11:16,650
أنّ الأسلحة النّارية قد وُجدت قبل ثلاثين
.سنة، عن طريق تصغير المدافع

145
00:11:16,940 --> 00:11:20,400
.لكنّها ليست بنفس فعالية المدافع وتحتاج للوقت لإطلاقها

146
00:11:20,860 --> 00:11:23,910
.لم يكن من الممكن استعمالها ضدّ الكيوما

147
00:11:24,490 --> 00:11:27,870
.لكنّ سلاحك هزم العديد من الكيوما

148
00:11:29,040 --> 00:11:32,170
،فإمّا أنّ هنالك من استطاع صناعة سلاح ناريّ يهزم الكيوما

149
00:11:32,170 --> 00:11:35,590
.أو أنّ ذلك هو ما يجعلكِ قدّيسة البارود

150
00:11:36,170 --> 00:11:39,130
.كما لم أسمع بقدّيسة البارود من قبل

151
00:11:39,130 --> 00:11:40,920
أين يقع معبدكِ؟

152
00:11:41,470 --> 00:11:44,680
.قد أستفيد من بعض المتفجّرات إن كان معك المزيد

153
00:11:47,010 --> 00:11:48,930
.أجيبي عن أسئلتي

154
00:11:49,770 --> 00:11:51,810
ما الّذي تظنّينه فيّ؟

155
00:11:51,810 --> 00:11:54,310
.متسرّع ولحوح

156
00:11:54,310 --> 00:11:56,860
.وغبي خارج عن السّيطرة

157
00:12:14,210 --> 00:12:16,670
إذا كنتَ قلقًا بشأن ناشيتانيا، فلماذا لا تعود؟

158
00:12:19,090 --> 00:12:22,420
.كلاّ! لستُ قلقًا لتلك الدّرجة عليها

159
00:12:22,840 --> 00:12:25,470
.على الأقل ليس بقدر قلقي عليكِ

160
00:12:27,510 --> 00:12:30,520
.لم أعتقد أنّه سيتمّ اختيار ناشيتانيا

161
00:12:31,100 --> 00:12:33,600
...أنت... وتلك الفتاة

162
00:12:33,600 --> 00:12:36,100
لا أستطيع توقّع الكثير من هذا الجيل من الشّجعان، صحيح؟

163
00:12:36,100 --> 00:12:37,810
!هذا ليس صحيحًا

164
00:12:37,810 --> 00:12:41,400
،قد تكون ناشيتانيا غرّة وبلا تجربة
.لكنّها محاربة حقيقيّة

165
00:12:41,400 --> 00:12:42,490
.أنت متعجرف للغاية

166
00:12:42,490 --> 00:12:44,900
."غِرّة" و"بلا تجربة"

167
00:12:44,900 --> 00:12:48,740
!ذلك هو حال الجميع مقارنة بي أنا الرّجل الأقوى في العالم

168
00:12:49,080 --> 00:12:52,410
أتعرفين أنّه يمكنك دائمًا أن تعتمدي على
الرّجل الأقوى في العالم أيضًا؟

169
00:12:54,000 --> 00:12:55,290
.يا للغباء

170
00:13:08,600 --> 00:13:10,680
.لديّ طلبٌ واحد فقط

171
00:13:12,640 --> 00:13:13,310
ما هو؟

172
00:13:18,100 --> 00:13:20,730
.سوف نحاول قتل بعضنا أنا وأنت في النّهاية

173
00:13:22,230 --> 00:13:24,280
.عندما يحين ذلك، ترفّق بي

174
00:13:25,240 --> 00:13:27,360
،يمكنك أن تطعنني

175
00:13:27,360 --> 00:13:29,450
.لكن لا تُنهِ أمري

176
00:13:29,950 --> 00:13:31,790
أيّ نوع من الطّلبات هو هذا؟

177
00:13:32,160 --> 00:13:33,790
...ما أريد سماعه

178
00:13:34,450 --> 00:13:37,170
.هو طلب القتال معًا

179
00:13:39,040 --> 00:13:42,750
...ظننتُ أنّك ستُصغي لطلب صغير كهذا

180
00:13:45,220 --> 00:13:49,180
.لا يمكنني أن أموت حتّى أهزم إله الشّر بيديّ

181
00:13:51,720 --> 00:13:53,930
تلك هي أرض الشّياطين العاوية، صحيح؟

182
00:13:54,560 --> 00:13:57,020
حيث تتّصل شبه الجزيرة بالقارة؟

183
00:13:57,020 --> 00:13:59,350
.سنلتقي هناك جميعًا

184
00:13:59,690 --> 00:14:01,860
.أنت والآخرون، نعم

185
00:14:01,860 --> 00:14:03,730
!انظري لذلك اللّون

186
00:14:03,730 --> 00:14:05,740
.ذاك هو سمّ إله الشّرّ

187
00:14:06,400 --> 00:14:09,200
.إنّ كلّ بشريّ يلمسه سيموت في غضون يوم

188
00:14:09,200 --> 00:14:12,580
،الشّجعان السّتّة محميّون بفضل بَرَكة القدَر

189
00:14:12,580 --> 00:14:15,200
.لذلك هم قادرون على إبطال تأثيره

190
00:14:15,200 --> 00:14:16,200
.صحيح

191
00:14:16,200 --> 00:14:19,670
.لولا ذلك، لكنّا قادرين على غزو المكان باستعمال جيش

192
00:14:25,210 --> 00:14:27,880
.أنا قلق بشأن ذلك الحصن

193
00:14:28,510 --> 00:14:29,550
!فلنذهب

194
00:14:31,680 --> 00:14:33,760
!أنتِ، أسرعي

195
00:14:45,190 --> 00:14:47,650
...بدأ الجوّ يزداد حرارة

196
00:14:48,110 --> 00:14:50,660
هل الحرارة أمر مألوف في هذه المنطقة؟

197
00:14:51,160 --> 00:14:52,990
هل تعرفين أيّ شيء يا فلايمي؟

198
00:14:53,870 --> 00:14:56,450
إن كان هنالك أيّ أحد من الشّجعان
.السّتّة في الدّاخل، فسأهرب

199
00:14:59,540 --> 00:15:00,790
.مفهوم

200
00:15:11,680 --> 00:15:12,590
!المعذرة

201
00:15:13,510 --> 00:15:15,850
هل هنالك أحد من الشّجعان السّتّة في الدّاخل؟

202
00:15:17,850 --> 00:15:19,430
من أنتما؟

203
00:15:19,850 --> 00:15:21,480
!أنا أدليت ماير

204
00:15:21,810 --> 00:15:23,440
!واحد من الشّجعان السّتّة

205
00:15:23,730 --> 00:15:25,060
!أحد الشّجعان

206
00:15:25,060 --> 00:15:29,820
.وصل الشّجعان الآخرون قبل يومين لكنّهم غادروا سلفًا

207
00:15:30,280 --> 00:15:31,360
.سمعتِ ما قاله

208
00:15:42,250 --> 00:15:45,670
.مرحبًا بأحد شجعان الزّهرة السّتّة

209
00:15:46,090 --> 00:15:47,960
من هذه الّتي برفقتك؟

210
00:15:47,960 --> 00:15:50,970
.إنّها إحدى الشّجعان أيضًا

211
00:15:50,970 --> 00:15:52,510
...فهمت

212
00:15:52,800 --> 00:15:56,720
.أُدعي لورين، مجنّد من الدّرجة الأولى في جيش غوينباير

213
00:15:56,720 --> 00:15:58,640
.أنا الآمر في هذا الحصن

214
00:15:58,640 --> 00:15:59,970
أنت؟

215
00:15:59,970 --> 00:16:00,810
.نعم

216
00:16:02,520 --> 00:16:04,600
.لقد مات الجميع

217
00:16:04,900 --> 00:16:06,940
.الجنرال. القادة

218
00:16:06,940 --> 00:16:10,230
.لم ينجُ إلاّ أنا وبضعة جنود آخرين

219
00:16:11,070 --> 00:16:16,490
،لكن لدينا شيء يجب أن نحميه
.حتّى آخر رمق

220
00:16:16,700 --> 00:16:18,200
شيء يجب أن تحموه؟

221
00:16:18,200 --> 00:16:19,040
.نعم

222
00:16:20,620 --> 00:16:24,290
،لقد أعدّ ملكُ غوينباير شيئًا لمساعدة الشّجعان السّتّة

223
00:16:24,290 --> 00:16:27,210
.في حالة عودة إله الشّر للحياة

224
00:16:28,130 --> 00:16:32,300
إنّ معظم الكيوما أتت للقارة

225
00:16:32,300 --> 00:16:34,470
.بهدف قتال الشّجعان السّتّة

226
00:16:34,930 --> 00:16:37,680
.وقد تكونان قد قاتلتُماها في طريقكما بالفعل

227
00:16:39,430 --> 00:16:42,680
...فهدفها قبل كلّ شيء

228
00:16:42,680 --> 00:16:44,690
.هو إبادتكم

229
00:16:44,980 --> 00:16:46,400
.صحيح

230
00:16:48,150 --> 00:16:50,020
.تعالا. من هنا

231
00:16:51,280 --> 00:16:54,900
طوّر الملك طريقة سرّيّة لختم المدخل

232
00:16:54,900 --> 00:16:57,280
إلى شبه الجزيرة، بمجرّد أن يدخل الشّجعان

233
00:16:57,280 --> 00:16:59,330
.إلى أرض الشّياطين العاوية

234
00:17:00,120 --> 00:17:02,540
،باستعمال قوّة قدّيسة الضّباب وقدّيسة الوهم

235
00:17:03,080 --> 00:17:06,540
وكذلك قدّيسة الملح، شيّد الملك حاجزًا قويًّا

236
00:17:06,830 --> 00:17:10,840
.ليختم الكيوما في الغابة

237
00:17:11,630 --> 00:17:13,800
.إنّه يدعى حاجز الخيال

238
00:17:14,220 --> 00:17:15,760
حاجز الخيال؟

239
00:17:16,970 --> 00:17:18,850
.سأشرح المزيد من التّفاصيل عنه

240
00:17:19,720 --> 00:17:21,640
.لا تستطيع الكيوما عبور الماء

241
00:17:21,970 --> 00:17:24,020
إن استطعنا ختم المنقطة

242
00:17:24,020 --> 00:17:26,730
،التّي داخل الدّائرة،  فسيُترك العديد من الكيوما هنا

243
00:17:26,730 --> 00:17:29,270
.غير قادرة على قتالكم

244
00:17:30,190 --> 00:17:33,530
عند تشغيل الحاجز، سوف تُحاط
.المنطقة داخل الحاجز بالضّباب

245
00:17:33,940 --> 00:17:37,780
.سيكون من المستحيل دخول أو مغادرة الضّباب

246
00:17:38,360 --> 00:17:41,780
.يوجد معبد هنا يمكن تشغيل الحاجز من خلاله

247
00:17:42,290 --> 00:17:45,620
.إنّه محاط بجدران دفاعية وضعتها قدّيسة الملح

248
00:17:45,620 --> 00:17:48,000
.لن تستطيع الكيوما تدميرها

249
00:17:48,790 --> 00:17:52,250
،قدّيسة الجبل مورا الّتي هي واحدة من الشّجعان السّتّة

250
00:17:52,250 --> 00:17:54,170
.موجودة هناك

251
00:17:54,170 --> 00:17:55,130
مورا؟

252
00:17:55,630 --> 00:17:58,630
تمّ اختيار كبيرة معبد كلّ السّموات كأحد الشّجعان؟

253
00:17:59,140 --> 00:17:59,800
.نعم

254
00:17:59,800 --> 00:18:03,310
.زارت مورا-ساما هذا الحصن قبل يومين

255
00:18:03,890 --> 00:18:05,480
،بمجرّد أن يجتمع الجميع

256
00:18:05,480 --> 00:18:08,230
.سترسل لنا مورا-ساما إشارة

257
00:18:08,770 --> 00:18:10,440
،وعند التّأكّد من الإشارة

258
00:18:10,440 --> 00:18:13,690
.سنتّجه إلى المعبد ونشغّل الحاجز

259
00:18:14,610 --> 00:18:16,820
،إذا هُزمنا هنا

260
00:18:16,820 --> 00:18:19,070
،قبل أن يجتمع الشّجعان

261
00:18:19,070 --> 00:18:21,200
.فسنُرسل نحن الإشارة

262
00:18:21,570 --> 00:18:23,830
على أحدكم حينها أن يذهب للمعبد

263
00:18:23,830 --> 00:18:25,830
.ويشغّل الحاجز

264
00:18:25,830 --> 00:18:27,000
،عند حدوث ذلك

265
00:18:27,000 --> 00:18:30,080
لن يستطيع أحد الشّجعان السّتّة
.دخول أرض الشّياطين العاوية

266
00:18:30,290 --> 00:18:33,960
.لكنّ مورا قرّرت أنّ الأمر يستحقّ ذلك

267
00:18:33,960 --> 00:18:36,130
.أجل. انظرا لهذا رجاءً

268
00:18:37,670 --> 00:18:39,470
،هذه مجرّد نسخة

269
00:18:39,470 --> 00:18:42,470
.لكن يوجد مذبح مشابه لهذا في المعبد

270
00:18:46,100 --> 00:18:48,060
،وبغرض تشغيل الحاجز

271
00:18:48,060 --> 00:18:51,350
،يجب أن يوضع السّيف في هذه المنصّة ووضع اليد على اللّوحة

272
00:18:51,350 --> 00:18:54,320
."وترديد العبارة التالية، "ارتفع أيّها الضّباب

273
00:18:54,610 --> 00:18:57,440
.إنّه لأمر بسيط مقارنة بهول الوضع الّذي نحن فيه

274
00:19:01,360 --> 00:19:03,530
قلتَ "ارتفع أيّها الضّباب"؟

275
00:19:03,950 --> 00:19:05,490
.فهمت

276
00:19:05,790 --> 00:19:09,790
.لكن تشغيل الحاجز هو واجبك أنت

277
00:19:09,790 --> 00:19:10,870
!نعم

278
00:19:11,580 --> 00:19:15,250
.أنا جاهز لأنفّذ مهمّي ولو كلّفني ذلك حياتي

279
00:19:23,680 --> 00:19:25,010
،إن واصلتُما المسير

280
00:19:25,010 --> 00:19:28,180
.فستبلغان نقطة اللّقاء بعد ثلاث ساعات

281
00:19:31,020 --> 00:19:33,190
...هذه مشكلة

282
00:19:33,940 --> 00:19:36,570
.تنتظرنا مورا في مدخل أرض الشّياطين العاوية

283
00:19:36,940 --> 00:19:39,690
.لكن ناشيتانيا قد تكون هناك أيضًا الآن

284
00:19:39,990 --> 00:19:43,490
.سيكون تجاوزهما دون أن يلاحظانا أمرًا صعبًا

285
00:19:43,990 --> 00:19:45,530
.لا تتحدّث معي

286
00:19:45,910 --> 00:19:47,030
.أنا أفكّر

287
00:19:53,830 --> 00:19:54,960
...أخبريني

288
00:19:54,960 --> 00:19:57,380
هل تريدين أن تلتقيهم فحسب حتّى الآن؟

289
00:19:57,380 --> 00:19:59,460
.إن كانت هذه مزحة، فهي ليست مضحكة

290
00:19:59,460 --> 00:20:02,840
.إن قابلتُ أيّ واحد منهم، فسنحاول قتل بعضنا بعضًا

291
00:20:02,840 --> 00:20:04,720
.لم يحدث ذلك معنا

292
00:20:05,510 --> 00:20:07,470
.أنت غريب الأطوار فحسب

293
00:20:08,140 --> 00:20:10,730
.لستُ واثقًا إن كانت هذه مجاملة أم إهانة

294
00:20:11,930 --> 00:20:15,350
.نحن الأبطال السّتّة المختارون

295
00:20:15,900 --> 00:20:18,940
.يجب أن نكون قادرين على العمل معًا لهزيمة إله الشّر

296
00:20:19,320 --> 00:20:21,490
.أضمن لكِ أنّ ذلك لن يحدث

297
00:20:21,490 --> 00:20:23,150
.لا تقلقي

298
00:20:23,150 --> 00:20:26,030
.إن بدأنا نتقاتل، فسأحميكِ

299
00:20:26,410 --> 00:20:27,530
...أدليت

300
00:20:33,370 --> 00:20:34,460
...أنتَ

301
00:20:37,340 --> 00:20:40,380
أنتَ شخص طيّب، صحيح؟

302
00:20:41,880 --> 00:20:43,340
...كلاّ

303
00:20:43,340 --> 00:20:45,640
.لا توجّه طبيتك نحوي

304
00:20:47,390 --> 00:20:48,970
.إنّها تجعلني أرغب بقتلك

305
00:21:01,610 --> 00:21:02,820
—ما الّذي

306
00:21:24,880 --> 00:21:25,970
!ناشيتانيا

307
00:21:26,880 --> 00:21:28,180
!أدليت-سان

308
00:21:28,550 --> 00:21:30,300
!ابتعد عنها

309
00:21:33,100 --> 00:21:33,850
!توقّف

310
00:21:45,440 --> 00:21:47,660
!مهلاً... لا تهاجميهما يا فلايمي

311
00:21:48,110 --> 00:21:50,280
!توقّفي يا ناشيتانيا

312
00:21:53,040 --> 00:21:54,790
لماذا أنت متفاجئ؟

313
00:21:55,910 --> 00:21:57,210
...سبق وأخبرتُك

314
00:21:58,170 --> 00:22:00,960
.إن تقابلنا، فسنحاول قتل بعضنا بعضًا

315
00:23:36,180 --> 00:23:38,930
في الحلقة القادمة: ويجتمع الأبطال