1
00:00:01,690 --> 00:00:03,820
كيف يمكن تشغيل الحاجز؟

2
00:00:05,480 --> 00:00:08,110
...الوحيدان اللّذان لا يعرفان هما هانز و

3
00:00:08,770 --> 00:00:11,280
.أنا واثقة أنّي سأكتشف العدوّ إن قتلتُ الجميع

4
00:00:11,280 --> 00:00:14,860
!تستطيع تشامو الاهتمام بأمر إله الشّرّ بمفردها

5
00:00:16,570 --> 00:00:18,450
!كلاّ! كلاّ، كلاّ

6
00:00:19,950 --> 00:00:22,580
.هنالك مستنقع داخل معدة تشامو

7
00:00:22,870 --> 00:00:24,920
كلّ الأشياء الّتي أكلتها تشامو في السّابق

8
00:00:24,920 --> 00:00:27,580
!تعيش بسعادة هناك

9
00:00:29,550 --> 00:00:30,460
،هانز

10
00:00:31,260 --> 00:00:33,920
.إن دنت نهايتنا، اهرب وانجُ بحياتك

11
00:00:33,920 --> 00:00:37,300
.اخرس. لا تُملِ عليّ ما أفعله

12
00:00:54,030 --> 00:00:57,200
شجعان الزّهرة السّتّة

13
00:02:33,430 --> 00:02:36,260
!لا توجد نهاية لهذه الأشياء

14
00:02:36,800 --> 00:02:39,260
...إذًا، إن استهدفنا تشامو

15
00:02:44,010 --> 00:02:45,320
.سنعمل معًا

16
00:02:45,320 --> 00:02:47,390
.أعلم .أجل

17
00:02:52,090 --> 00:02:53,240
.لا فائدة

18
00:02:53,240 --> 00:02:57,710
إنّ الكيوما تتوقّع ما هي أنسب وسيلة
...لحماية تشامو بنفسها

19
00:02:59,820 --> 00:03:02,420
.هذا ما يقوم به الجميع

20
00:03:02,420 --> 00:03:04,780
العمل معًا للنّيل من تشامو؟

21
00:03:04,780 --> 00:03:08,540
.لم يستطع أحد أن ينجح في ذلك

22
00:03:09,160 --> 00:03:11,360
أليست لديك أفكار يا أدليت؟

23
00:03:18,480 --> 00:03:20,550
...الكيوما لا تتعب

24
00:03:21,410 --> 00:03:23,270
.لن تكون الأمور في صالحنا إن استمرّ هذا الوضع

25
00:03:24,120 --> 00:03:24,890
!هانز

26
00:03:25,370 --> 00:03:26,430
!احمني

27
00:03:26,430 --> 00:03:29,030
!أنا مشغول كما ترى

28
00:03:29,030 --> 00:03:30,890
!لا تكن كسولاً

29
00:03:31,160 --> 00:03:33,520
!سأفكّر بشيء ما بينما تحميني

30
00:03:42,930 --> 00:03:44,250
إلى متى تستطيع الاستمرار؟

31
00:03:44,250 --> 00:03:45,490
.ستّون ثانية

32
00:03:46,940 --> 00:03:50,750
،عندما تنتهي الثّواني السّتون، اركض نحو تشامو
.لا تفكّر في أيّ شيء آخر

33
00:03:50,990 --> 00:03:52,250
.سوف أوفّر لك الدّعم

34
00:04:01,220 --> 00:04:02,630
.بسرعة. فكّر

35
00:04:03,230 --> 00:04:05,510
.لن تنفع إبر النّوم والتّخدير ضدّ الكيوما

36
00:04:06,350 --> 00:04:08,760
.لكنّ ألم الإبر السّامّة قد يُجدي نفعًا

37
00:04:09,160 --> 00:04:10,200
...وأيضًا

38
00:04:16,080 --> 00:04:17,480
!لقد أخافني ذلك

39
00:04:17,480 --> 00:04:20,480
!يمكنك أن تنفث النّار! ذلك ليس تصرّفًا بشريًّا

40
00:04:20,780 --> 00:04:22,490
...النّاي الّذي يستدرج الكيوما

41
00:04:22,870 --> 00:04:24,490
.ذلك ليس كافيًا

42
00:04:24,720 --> 00:04:25,720
...كلّ ما بقي

43
00:04:25,720 --> 00:04:27,240
!انتهت الثّواني السّتّون

44
00:04:27,240 --> 00:04:29,010
!هانز، انطلق

45
00:04:37,630 --> 00:04:40,670
.سأعيق الكيوما لوهلة، وسأصوّب نحو تشامو

46
00:04:42,710 --> 00:04:45,760
.كلاّ، لا بدّ أنّ الجميع قد حاول فعل ذلك

47
00:04:46,840 --> 00:04:48,930
!استعدّي للموت

48
00:04:50,760 --> 00:04:51,850
.غبيّ

49
00:04:54,980 --> 00:04:56,730
!لا تتفاداه! تصدّى له

50
00:05:01,760 --> 00:05:03,780
!أَنْهِ أمرها يا هانز

51
00:05:04,280 --> 00:05:06,560
!خذي هذه

52
00:05:23,460 --> 00:05:24,520
هل نلنا منها؟

53
00:05:29,220 --> 00:05:31,110
!أدليت، ثبّتها

54
00:05:31,110 --> 00:05:31,950
.حسنًا

55
00:05:33,990 --> 00:05:35,740
.لا تتحرّكي

56
00:05:47,350 --> 00:05:49,240
...ظهري يؤلمني

57
00:05:54,040 --> 00:05:56,370
.لا أظنّ أنّ تشامو هي السّابع

58
00:05:56,370 --> 00:05:58,140
.ولا أنا

59
00:05:58,500 --> 00:06:01,380
ما هو سؤالك لتشامو إذًا؟

60
00:06:01,860 --> 00:06:04,880
.رغم أنّي لا أظنّ أنّ بمقدورها الإجابة

61
00:06:04,880 --> 00:06:06,040
.لا بأس

62
00:06:07,880 --> 00:06:10,890
.أجيبيني بتحريك رأسك فقط

63
00:06:11,540 --> 00:06:12,390
.رجاءً

64
00:06:15,210 --> 00:06:17,980
،قبل أن تقابلينا في هذا المعبد

65
00:06:17,980 --> 00:06:19,790
هل كنتِ تعرفين بأمر الحاجز؟

66
00:06:23,970 --> 00:06:24,950
.فهمت

67
00:06:26,720 --> 00:06:27,650
أدليت؟

68
00:06:31,170 --> 00:06:32,410
.أنا واثقة

69
00:06:32,820 --> 00:06:34,790
.كانت تلك أصواتًا لقتال تشامو

70
00:06:35,060 --> 00:06:37,160
.لكنّي ما عدتُ أسمعها الآن

71
00:06:37,630 --> 00:06:39,840
.لا يعقل أنّ تشامو قد هُزمت

72
00:06:40,460 --> 00:06:41,670
.هانز هناك أيضًا

73
00:06:45,100 --> 00:06:46,090
...فهمت

74
00:06:46,090 --> 00:06:48,910
إذًا فقد تركتكَ فلايمي تذهب عن قصد؟

75
00:06:48,910 --> 00:06:50,050
أدركتَ ذلك؟

76
00:06:50,510 --> 00:06:52,970
.توقّعتُ أنّ ذلك ممكن

77
00:06:54,640 --> 00:06:56,600
.أريد أن أتحدّث مع فلايمي بشأن أمر ما

78
00:06:57,350 --> 00:06:59,680
...تلك الفتاة خطيرة

79
00:06:59,940 --> 00:07:01,900
،بما أنّك لستَ السّابع

80
00:07:01,900 --> 00:07:05,520
.فإنّ الشّبهات تدور حولها الآن أكثر من غيرها

81
00:07:07,160 --> 00:07:09,040
.فلايمي ليست الشّجاع المزيّف

82
00:07:09,440 --> 00:07:11,010
.أنا واثق من ذلك

83
00:07:12,510 --> 00:07:15,830
.لكنّي لا أعتقد أنّ علينا لقاءها

84
00:07:16,140 --> 00:07:17,880
.لقد سمحت لي بالذّهاب

85
00:07:17,880 --> 00:07:20,030
.في الوقت الحاليّ فحسب

86
00:07:20,030 --> 00:07:21,330
لماذا تعتقد ذلك؟

87
00:07:24,760 --> 00:07:27,020
.تعيش فلايمي في الظّلام

88
00:07:27,690 --> 00:07:30,460
.إنّها لا تحبّ أحدًا، ولا تثق بأحد

89
00:07:30,840 --> 00:07:34,790
.كلّ من حولها أعداء لها أو قد يصبحون أعداءً قريبًا

90
00:07:35,410 --> 00:07:37,590
.ذلك هو العالم الّذي تعيش فيه

91
00:07:40,670 --> 00:07:43,370
.أنا أعيش في الظّلام أيضًا

92
00:07:43,690 --> 00:07:46,840
لكنّ الظّلام الّذي تعيش فيه فلايمي

93
00:07:46,840 --> 00:07:49,570
.أعمق بكثير من ظلامي

94
00:07:49,990 --> 00:07:54,570
،بثقتك وصداقتك ورغبتك بحماية زملائك

95
00:07:54,850 --> 00:07:57,580
.فهي كائن من نوع مختلف تمامًا

96
00:07:58,070 --> 00:08:00,910
...أعتقد أنّ ما تقوله صحيح

97
00:08:01,260 --> 00:08:04,360
.لكنّي أريد أن أقابلها وأتحدّث إليها في كلّ الأحوال

98
00:08:06,070 --> 00:08:07,170
.اهتمّ بتشامو

99
00:08:07,900 --> 00:08:11,340
.وفكّر بما قلتُه

100
00:08:15,080 --> 00:08:17,390
...سواء كان سينجح ذلك أم لا

101
00:08:17,760 --> 00:08:20,240
.أنا أعتمد عليك إن وجدتَ دليلاً

102
00:08:20,920 --> 00:08:22,050
!أدليت

103
00:08:22,620 --> 00:08:24,860
.فلايمي لا تحبّك

104
00:08:25,160 --> 00:08:28,770
.ولا أقول ذلك لأنّها قد تكون معجبة بك

105
00:08:29,470 --> 00:08:31,920
.إنّها لا تطيقك من أعماق قلبها

106
00:08:31,920 --> 00:08:34,270
.كلاّ، بل إنّها تكرهك

107
00:08:35,690 --> 00:08:37,380
.ذلك ما يبدو لي

108
00:08:51,630 --> 00:08:54,290
...استمرّ لبعض الوقت فحسب

109
00:09:12,090 --> 00:09:13,150
ماذا هنالك؟

110
00:09:20,300 --> 00:09:22,390
فلايمي تكرهني؟

111
00:09:23,980 --> 00:09:25,510
راودني شعورٌ

112
00:09:25,510 --> 00:09:28,710
...أنّنا قد بدأنا نفهم بعضنا بعضًا قليلاً

113
00:09:29,220 --> 00:09:30,760
هل كانت تلك مجرّد هلوسة؟

114
00:09:32,340 --> 00:09:34,270
.أنت تختلف عنّي

115
00:09:35,510 --> 00:09:37,510
...لديك شيء تؤمن به

116
00:09:57,900 --> 00:10:00,200
.أنا مندهشة لأنّك قيد الحياة

117
00:10:01,480 --> 00:10:03,670
.ظننتُ أنّي ميت مرّات عدّة

118
00:10:07,470 --> 00:10:09,140
!غبيّان

119
00:10:09,140 --> 00:10:10,000
!كـ-كلاّ

120
00:10:10,000 --> 00:10:12,130
!لا داعي لتغضبي هكذا

121
00:10:12,420 --> 00:10:14,880
!كان تصرّف تشامو سيّئًا
... لكن أنت يا هانز

122
00:10:15,320 --> 00:10:17,230
،ظننتُ أنّك غبيّ

123
00:10:17,230 --> 00:10:19,640
!لكنّي لم أظنّ أنّك بهذا الغباء

124
00:10:19,640 --> 00:10:21,760
...هذا لئيم للغاية

125
00:10:21,970 --> 00:10:25,060
!لماذا سمحتَ لأدليت بالهرب؟
...كانت تلك أفضل

126
00:10:25,060 --> 00:10:28,520
!كلاّ، بل فرصتنا الوحيدة

127
00:10:28,520 --> 00:10:30,900
...حسنًا، اسمعي يا مورا

128
00:10:30,900 --> 00:10:33,650
.أظنّ أنّ بإمكاني إثبات براءته

129
00:10:33,980 --> 00:10:35,530
ما الّذي تقوله؟

130
00:10:35,530 --> 00:10:38,090
.أدليت رجل رائع

131
00:10:38,090 --> 00:10:40,530
.لقد اكتشف خطّة السّابع

132
00:10:42,070 --> 00:10:45,600
.اكتشفتُ جزءًا من فخّ الشّجاع السّابع

133
00:10:47,680 --> 00:10:49,040
.أنا أصغي

134
00:10:49,380 --> 00:10:51,490
.كنّا على خطأ

135
00:10:51,490 --> 00:10:55,170
.كلاّ، لقد خدعنا السّابع لنكون على خطأ

136
00:10:56,420 --> 00:10:59,040
لم يكن هنالك من شغّل الحاجز

137
00:10:59,330 --> 00:11:01,930
.بعد أن فتحتُ الباب

138
00:11:02,240 --> 00:11:04,340
،عندما فتحتُ الباب ودخلت

139
00:11:04,340 --> 00:11:06,760
.كان الحاجز غير مشغّل بعد

140
00:11:07,670 --> 00:11:10,940
.لا أظنّ أنّ ذلك معقول

141
00:11:10,940 --> 00:11:12,210
.اسمعيني فحسب

142
00:11:12,660 --> 00:11:15,570
.نحن نعرف كيف نشغّل الحاجز

143
00:11:16,140 --> 00:11:17,940
،نضع السّيف على المنصّة

144
00:11:18,260 --> 00:11:20,530
،ثمّ نضع أيدينا على اللّوحة الحجريّة
.ونصدر الأمر

145
00:11:20,530 --> 00:11:22,090
.ثمّ يُشغّل الحاجز

146
00:11:22,970 --> 00:11:25,130
لكن من أخبرنا بذلك؟

147
00:11:25,770 --> 00:11:28,080
.الجنديّ من الحصن، لورين

148
00:11:28,770 --> 00:11:32,470
لكن ماذا إن كان يعمل مع السّابع؟

149
00:11:35,340 --> 00:11:40,050
لم نكن نعرف أنا وأنت حتّى بأمر
.الحاجز إلى أن أخبرنا لورين

150
00:11:40,920 --> 00:11:42,800
ناشيتانيا وغولدوف قالا

151
00:11:42,800 --> 00:11:45,550
.أنّهما لم يعرفا بأمره حتّى البارحة أيضًا

152
00:11:46,410 --> 00:11:48,660
،كانت مورا تعرف بأمره

153
00:11:48,660 --> 00:11:51,370
.لكنّها قالت أنّها عرفت كيف تشغّله من لورين

154
00:11:52,550 --> 00:11:55,070
.لم يقابل هانز لورين، لذلك لم يكن يعرف

155
00:11:55,400 --> 00:11:58,800
.وقالت تشامو أنّها سمعت بأمره بعد أن التقتنا

156
00:12:00,230 --> 00:12:01,140
،بعبارات أخرى

157
00:12:01,440 --> 00:12:04,790
...عرفنا جميعًا كيف نشغّل الحاجز من لورين

158
00:12:05,690 --> 00:12:09,480
.وما كنّا لنعرف حتّى إن كان يكذب علينا

159
00:12:10,130 --> 00:12:11,050
.استمرّ

160
00:12:12,250 --> 00:12:13,630
أوّلاً، استعلم السّابع لورين

161
00:12:13,630 --> 00:12:17,500
.ليكذب علينا بشأن كيفية تشغيل الحاجز

162
00:12:18,000 --> 00:12:21,820
.وبعدها استعمل الكيوما ليستدرجنا داخله

163
00:12:23,430 --> 00:12:26,010
،انتظر حتّى فتحتُ الباب

164
00:12:26,260 --> 00:12:29,260
.ثمّ غطّى الغابة بأكملها بالضّباب بطريقة ما

165
00:12:30,260 --> 00:12:31,770
لذلك اعتقدنا

166
00:12:31,770 --> 00:12:35,170
.أنّ هنالك من شغّل الحاجز وهرب

167
00:12:37,900 --> 00:12:41,130
.لكن في الواقع، لم يكن الحاجز قد شُغِّل بعد

168
00:12:41,430 --> 00:12:43,320
.كان ذلك مجرّد ضباب

169
00:12:44,390 --> 00:12:46,790
.كان السّيف في المنصّة من الأساس

170
00:12:47,370 --> 00:12:52,380
،قمنا جميعًا بمحاولات باستخدام السّيف
.لاكتشاف طريقة للإبطال الحاجز

171
00:12:53,030 --> 00:12:56,420
.وأثناء ذلك الوقت، شغّل السّابع الحاجز

172
00:12:58,320 --> 00:13:03,320
وبعدها، كان عليه أن يثبت أنّ المعبد
،كان غرفة موصدة إلى أن وصلتُ أنا

173
00:13:03,320 --> 00:13:06,930
.وبعد تلفيق الأمر لي، سيكتمل الفخّ

174
00:13:07,740 --> 00:13:10,810
.كان هانز هو من وضع اللّوم عليك

175
00:13:11,170 --> 00:13:12,600
هل هو السّابع؟

176
00:13:13,970 --> 00:13:15,600
هل تتذكّر؟

177
00:13:15,850 --> 00:13:18,860
،أقصد اللّحظة الّتي قدّمنا فيها أنفسنا
...قال هانز حينها

178
00:13:19,110 --> 00:13:22,530
.سآخذ كلّ وقتي في الاستماع للفتاة الأرنبة

179
00:13:22,530 --> 00:13:23,860
اسمك هانز، صحيح؟

180
00:13:23,860 --> 00:13:26,740
.ذاك هو تاج أميرةِ بيينا

181
00:13:27,020 --> 00:13:28,880
.بالطّبع أتذكّر

182
00:13:29,400 --> 00:13:31,160
.لكنّ ذلك لا يبدو منطقيًّا

183
00:13:31,850 --> 00:13:35,290
،عندما دخل هانز-سان ومورا-سان للمعبد

184
00:13:35,560 --> 00:13:39,170
.ناداني بـ"الأميرة" مرّة

185
00:13:40,120 --> 00:13:42,020
هل أنتِ واثقة؟

186
00:13:42,000 --> 00:13:46,170
.كان يعرف أنّي أميرة منذ البداية

187
00:13:46,580 --> 00:13:48,890
.لكن بعد ذلك، تظاهر أنّه لا يعرف

188
00:13:49,190 --> 00:13:50,360
لماذا؟

189
00:13:52,810 --> 00:13:56,810
،ولذلك، بعد أن كشف أنّ المعبد غرفة موصدة

190
00:13:56,810 --> 00:14:00,460
.ضمِن السّابع أنّ الشّبهات ستحوم حول أدليت

191
00:14:01,060 --> 00:14:03,460
.إنّه ماكر للغاية

192
00:14:05,570 --> 00:14:09,570
.كنتَ أنت من ذكر أنّ المعبد غرفة موصدة

193
00:14:09,810 --> 00:14:12,630
سيجعل ذلك منك السّابع، صحيح؟

194
00:14:12,950 --> 00:14:16,020
.أجل، قد يكون ذلك صحيحًا

195
00:14:18,350 --> 00:14:19,580
أظنّ أنّ السّابع

196
00:14:19,900 --> 00:14:22,970
.سيأتي على ذكر الغرفة الموصدة

197
00:14:23,850 --> 00:14:26,740
،لكنّ هانز كان يعرف الكثير عن الأبواب المختومة

198
00:14:26,740 --> 00:14:29,320
.لذلك ترك السّابع تلك المهمّة له

199
00:14:29,940 --> 00:14:31,720
أنت تثق بهانز؟

200
00:14:32,470 --> 00:14:33,250
لِمَ؟

201
00:14:33,560 --> 00:14:36,600
.لقد قاتلتُ هانز منذ برهة

202
00:14:37,510 --> 00:14:39,660
...وقبل أن يقتلني

203
00:14:39,640 --> 00:14:42,060
...كلاّ، أقصد أنّه كان باستطاعته قتلي

204
00:14:42,960 --> 00:14:46,030
.لكنّه وثق بي في تلك اللّحظة

205
00:14:46,770 --> 00:14:48,530
.وتوقّف

206
00:14:49,120 --> 00:14:52,240
ووثقتَ أنت به؟

207
00:14:52,620 --> 00:14:59,500
ما يهمّ هو أنّ هنالك من انتظر دخولي
.للمعبد وقام بعدها باستدعاء الضّباب

208
00:15:00,070 --> 00:15:03,900
.إن أمسكتُ به، فسأثبت براءتي

209
00:15:06,210 --> 00:15:07,260
.معك حقّ

210
00:15:07,260 --> 00:15:10,270
.فكرة ممتازة. لقد أبهرتني

211
00:15:10,270 --> 00:15:11,350
!حسنًا

212
00:15:11,670 --> 00:15:14,520
.لكن هنالك خطأ. خطأ قاتل

213
00:15:15,570 --> 00:15:18,470
.لديك فكرة خاطئة عن القدّيسات

214
00:15:18,860 --> 00:15:21,790
،حتّى وإن كنّ تستعملنَ قوّة الآلهة

215
00:15:21,790 --> 00:15:23,620
.فإنّها محدودة

216
00:15:24,190 --> 00:15:28,530
.وما تستطعن استعماله يختلف من قدّيسة لأخرى

217
00:15:29,530 --> 00:15:31,990
.لكن لا بدّ من وجود قدّيسة تستعمل الضّباب

218
00:15:31,990 --> 00:15:33,160
.هنالك بالفعل

219
00:15:33,160 --> 00:15:35,580
،القدّيسة الّتي صنعت هذا الحاجز

220
00:15:35,580 --> 00:15:37,330
.قدّيسة الضّباب أوسبا

221
00:15:38,660 --> 00:15:40,620
،لكن نظرًا لقدراتها

222
00:15:40,620 --> 00:15:43,120
فسيتطلّب منها الأمر خمسة عشر
.دقيقة لتغطية الغابة بأكملها

223
00:15:43,120 --> 00:15:46,170
.لكنّ الضّباب غطّى الغابة في لحظة

224
00:15:46,170 --> 00:15:49,260
.لأنّهن أخذن الكثير من الوقت لإعداد الحاجز

225
00:15:49,760 --> 00:15:52,800
ربّما احتاج الأمر منها

226
00:15:53,220 --> 00:15:58,770
.قضاء سنوات في استجماع قوّة إله الضّباب هنا

227
00:15:59,720 --> 00:16:01,230
.تعرفين الكثير عن هذا

228
00:16:01,230 --> 00:16:02,730
.كانت الكيوما يائسة

229
00:16:03,270 --> 00:16:07,150
،إن كانت لأوسبا القوّة لتغطّي الغابة بأكملها بالضّباب

230
00:16:07,720 --> 00:16:09,980
.لكانت الأولى على قائمة أهدافي

231
00:16:14,280 --> 00:16:15,220
.انظر

232
00:16:21,380 --> 00:16:22,120
!سُحقًا

233
00:16:32,440 --> 00:16:36,090
.تحتوي تلك الدّعامات على قوّة حاجز الخيال

234
00:16:36,550 --> 00:16:39,760
.هنالك أعداد لا تحصى منها مدفونة تحت الغابة بأكملها

235
00:16:40,060 --> 00:16:42,980
.لذلك تمّ تغطية الغابة بالضّباب في لحظة

236
00:16:44,020 --> 00:16:47,310
...إن صنعنَ حاجزًا آخر عدى حاجز الخيال

237
00:16:47,600 --> 00:16:49,730
.لاستطعنَ أيضًا بناء حاجز لتشيكل الضّباب فقط

238
00:16:49,950 --> 00:16:53,330
.يمكن إنشاء حاجز واحد فقط في نفس المكان

239
00:16:53,830 --> 00:16:57,800
.إن تمّ وضع اثنين، فسيلغي أحدهما الآخر

240
00:16:58,400 --> 00:16:59,420
...لكن

241
00:17:00,320 --> 00:17:02,700
استدعاء الضّباب في الحال سيكون مستحيلاً

242
00:17:02,700 --> 00:17:05,130
.دون قوّة حاجز ما

243
00:17:05,640 --> 00:17:09,410
،وهنالك حاجز بالفعل في هذه الغابة
.والّذي يستدعي الضّباب

244
00:17:10,210 --> 00:17:10,880
،بعبارات أخرى

245
00:17:11,240 --> 00:17:13,930
.نظريتك مستحيلة

246
00:17:14,510 --> 00:17:18,650
.لكنّها محتملة أكثر من اختراق الغرفة الموصدة في المعبد

247
00:17:19,010 --> 00:17:21,010
.فكّر بما ترغب به

248
00:17:21,010 --> 00:17:23,270
.أمّا أنا فسأبحث عن أدليت

249
00:17:24,920 --> 00:17:25,890
.مهلاً

250
00:17:26,770 --> 00:17:29,120
أنا واثق

251
00:17:29,120 --> 00:17:31,400
.أنّ أدليت ليس السّابع

252
00:17:31,630 --> 00:17:33,990
،وإن كان

253
00:17:33,990 --> 00:17:36,290
فلماذا لم يقتلني؟

254
00:17:36,290 --> 00:17:38,320
لماذا يحمي فلايمي؟

255
00:17:38,320 --> 00:17:40,700
لماذا لم يُجهز على تشامو؟

256
00:17:41,030 --> 00:17:42,620
أليس ذلك واضحًا؟

257
00:17:42,620 --> 00:17:44,540
.يمكنني أن أشرح لك ذلك بسهولة

258
00:17:44,760 --> 00:17:48,420
لماذا ظهر أمامنا من الأساس؟

259
00:17:48,860 --> 00:17:51,120
،إن كان مسعاه هو حجزنا هنا وحسب

260
00:17:51,120 --> 00:17:53,300
.لكان قد شغّل الحاجز مختبئًا وثمّ هرب

261
00:17:54,100 --> 00:17:55,300
...حسنًا

262
00:17:55,300 --> 00:17:58,300
.إنّه فخّ. إنّه يهاجم قلوبنا

263
00:17:58,680 --> 00:18:01,510
.أدليت قد يكون السّابع بالفعل

264
00:18:01,510 --> 00:18:03,690
.أو قد يكون شخصًا آخر

265
00:18:03,990 --> 00:18:07,810
!أراد أن يجعلنا نعتقد ذلك لنتشاجر فيما بيننا، صحيح؟

266
00:18:08,780 --> 00:18:11,370
.لقد خدعك

267
00:18:11,980 --> 00:18:15,690
.ويبدو أنّ الأميرة لا تعتقد أنّه السّابع أيضًا

268
00:18:16,360 --> 00:18:20,320
!لقد وقع اثنان من الشّجعان السّتّة ضحية لخدعته سلفًا

269
00:18:20,320 --> 00:18:21,870
!لكنّي رأيتُه

270
00:18:22,180 --> 00:18:24,350
لا يمكن لوجه يوشك على الموت أن يكذب؟

271
00:18:24,350 --> 00:18:26,620
!هذا رأيك الشّخصيّ فحسب

272
00:18:26,620 --> 00:18:28,620
...كـ-كلاّ

273
00:18:28,860 --> 00:18:31,430
.سأضطرّ الآن للقيام بما يجب أن أفعل

274
00:18:34,470 --> 00:18:36,510
.أنت محاصر

275
00:18:37,010 --> 00:18:40,550
،كانت نظريتك خاطئة بالكامل
.ونفدت منك الطّرق للهرب

276
00:18:41,030 --> 00:18:42,910
،حتّى لو لم تكن المزيّف

277
00:18:42,910 --> 00:18:44,820
.فمن المستحيل لك أن تنجو

278
00:18:45,870 --> 00:18:48,820
هل من المستحيل الحصول على مساعدة فلايمي؟

279
00:18:49,880 --> 00:18:52,480
هل من الأفضل أن أعثر على شخص آخر؟

280
00:18:53,760 --> 00:18:56,290
...شخص قد يقدّم لي يد العون

281
00:18:56,820 --> 00:18:59,200
تفكّر الآن بالبحث عن ناشيتانيا؟

282
00:19:01,350 --> 00:19:03,910
.تعتمد عليّ. تعتمد على هانز

283
00:19:03,910 --> 00:19:05,690
هل الشّخص التّالي هي ناشيتانيا؟

284
00:19:09,220 --> 00:19:13,010
أنت الأقوى في العالم، صحيح يا أدليت ماير؟

285
00:19:22,760 --> 00:19:25,400
أجل، لا تزال تبتسم، صحيح؟

286
00:19:25,720 --> 00:19:29,720
.اعتدتُ على الإهانة وأن أكون محلّ سخرية

287
00:19:30,550 --> 00:19:32,560
.لن أسمح بموتي

288
00:19:32,910 --> 00:19:34,410
.لهذا السّبب أضحك

289
00:19:34,990 --> 00:19:38,590
سبق وأخبرتك، إذا ما أصبحنا غير قادرين
.على الضّحك، فسينتهي الأمر

290
00:19:39,240 --> 00:19:41,360
!لن أستسلم

291
00:19:41,630 --> 00:19:44,990
...مبادئ معلّمك ومشاعرك تُجاه أختك وصديقك

292
00:19:45,290 --> 00:19:49,240
،لذلك السّبب ستضحك وتعاني
حتّى وإن كنتَ على مشارف الموت؟

293
00:19:49,790 --> 00:19:50,640
...فلايمي

294
00:19:51,590 --> 00:19:55,590
.إن قُتلتُ، فسيستهدفك السّابع بعدي

295
00:19:56,710 --> 00:19:58,300
...أدليت

296
00:19:58,760 --> 00:20:02,310
إن متُّ، فسيُلقى اللّوم عليكِ

297
00:20:02,300 --> 00:20:04,390
.وستُقتلين بنفس الطّريقة

298
00:20:05,250 --> 00:20:06,750
،وطالما أنا على قيد الحياة

299
00:20:07,050 --> 00:20:09,400
.لن يشكّ أحد فيكِ

300
00:20:10,100 --> 00:20:12,230
!ثقي بي يا فلايمي

301
00:20:23,760 --> 00:20:25,330
.سأذهب الآن إذًا

302
00:20:25,860 --> 00:20:27,380
...إن غيّرتِ رأيكِ

303
00:20:28,160 --> 00:20:30,080
.من المستحيل أن أثق بك

304
00:20:31,200 --> 00:20:35,020
.لا أفهم أيّ شيء ممّا تفكّر به

305
00:20:35,620 --> 00:20:38,960
كيف لا زلت تستطيع الابتسام؟
لماذا لا تستسلم؟

306
00:20:39,210 --> 00:20:41,630
لماذا تحميني؟

307
00:20:42,570 --> 00:20:44,890
.لا بدّ أن مورا قد وصلت للمعبد منذ مدّة طويلة

308
00:20:45,450 --> 00:20:47,230
،لا بدّ أنّها أقنعت هانز الآن

309
00:20:47,230 --> 00:20:49,760
.وهما يطاردانك رفقة تشامو

310
00:20:50,030 --> 00:20:52,490
.قد يظهرون في أيّة لحظة الآن

311
00:20:52,790 --> 00:20:53,890
...فلايمي

312
00:20:54,820 --> 00:20:56,820
.لكن ابقَ هنا لبعض الوقت

313
00:21:00,120 --> 00:21:02,330
.أريد أن أعرفك

314
00:21:03,130 --> 00:21:04,280
...ربّما لأنّي

315
00:21:05,780 --> 00:21:08,040
.قد أكون قادرة على أن أثق بك

316
00:21:09,420 --> 00:21:12,340
،عندما كنتُ أسافر مع أدليت-سان

317
00:21:12,340 --> 00:21:13,620
...كنتُ أفكّر مطوّلاً

318
00:21:14,530 --> 00:21:18,790
،أفكّر في أنّ هنالك شيئًا ما مختلفًا فيه

319
00:21:18,790 --> 00:21:20,960
.مقارنة بباقي الشّجعان المحتملين

320
00:21:22,120 --> 00:21:22,980
...أجل

321
00:21:23,520 --> 00:21:25,300
.لا أعرف السّبب بالفعل

322
00:21:26,380 --> 00:21:28,220
.هنالك ما هو مختلف فيه

323
00:21:29,030 --> 00:21:32,180
.لا بدّ أنّي الوحيدة الّتي ترى ذلك

324
00:21:36,240 --> 00:21:38,340
.انظر إلى علامتي يا غولدوف

325
00:21:42,180 --> 00:21:44,500
هل أدليت-سان لا زال حيًّا؟

326
00:21:46,310 --> 00:21:47,540
.اعذريني

327
00:21:49,310 --> 00:21:51,350
.لم يُقتل أحد بعد

328
00:21:51,750 --> 00:21:54,170
.لا أدليت ولا أيّ أحد من الزّملاء الآخرين

329
00:21:54,170 --> 00:21:55,790
.جميعهم على قيد الحياة

330
00:21:56,110 --> 00:21:57,000
.جيّد

331
00:21:57,300 --> 00:21:59,660
.إنّه يعمل بجدّ

332
00:22:00,580 --> 00:22:02,060
.سأعمل بجدّ أيضًا

333
00:23:36,010 --> 00:23:38,470
.في الحلقة القادمة: وضع يائس