1
00:00:01,080 --> 00:00:02,560
...تروي الأسطورة

2
00:00:03,480 --> 00:00:05,730
،أنّه عند استيقاظ الشّياطين من أعماق الظُّلمة

3
00:00:05,730 --> 00:00:08,730
،محوّلة الحياة على الأرض إلى جحيم

4
00:00:09,360 --> 00:00:13,360
ستختار إلهة القدَر ستّة أبطال

5
00:00:13,360 --> 00:00:16,160
.وتمنحهم القوّة لإنقاذ العالم

6
00:00:18,240 --> 00:00:21,580
.دائمًا ما يتمّ اختيار ستّة أبطال

7
00:00:22,250 --> 00:00:26,170
.ولهذا السّبب، أصبحوا يُعرفون بشجعان الزّهرة السّتّة

8
00:00:41,350 --> 00:00:44,560
شجعان الزّهرة السّتّة

9
00:02:15,360 --> 00:02:16,190
.لنذهب

10
00:02:22,570 --> 00:02:24,700
لقد توقّفوا عن اللّحاق بنا، صحيح؟

11
00:02:24,700 --> 00:02:26,540
...على الأرجح أنّهم استسلموا

12
00:02:26,910 --> 00:02:29,290
.سنغادر بيينا قريبًا وسندخل فانداين

13
00:02:40,840 --> 00:02:42,340
هذا جميل، صحيح؟

14
00:02:42,340 --> 00:02:43,600
.نعم

15
00:02:43,850 --> 00:02:45,680
هل هذه أوّل مرّة ترَين فيها بُستانًا؟

16
00:02:45,680 --> 00:02:46,470
.نعم

17
00:02:47,850 --> 00:02:49,230
سآخذ واحدة، موافق؟

18
00:02:52,480 --> 00:02:53,690
.على مهلك

19
00:02:53,690 --> 00:02:54,770
!إنّها رائعة

20
00:02:54,770 --> 00:02:56,320
!شكرًا لك

21
00:02:56,650 --> 00:02:57,940
...على مهل

22
00:02:59,030 --> 00:03:00,820
هل تجدين هذا ممتعًا لذلك الحدّ؟

23
00:03:00,820 --> 00:03:01,820
.نعم

24
00:03:01,820 --> 00:03:06,790
.كنتُ أظنّ أنّ الفاكهة تنمو في الصّحون عندما كنتُ طفلة

25
00:03:09,250 --> 00:03:11,250
.هذا مُتوقّع من أميرة بيينا

26
00:03:13,130 --> 00:03:14,630
!جَزر

27
00:03:15,710 --> 00:03:17,500
تأكلين الجَزر دون طهي أيضًا؟

28
00:03:20,380 --> 00:03:21,800
...يا إلهي

29
00:03:46,370 --> 00:03:47,780
هذا مذهل، صحيح؟

30
00:03:49,660 --> 00:03:51,500
.يمكنني القيام بأشياء كهذه أيضًا

31
00:04:03,840 --> 00:04:05,930
إذًا هذا ما تستطيع قدّيسة أنصال أن تفعله؟

32
00:04:06,930 --> 00:04:10,470
ألم تقابل قدّيسةً من قبل يا أدليت-سان؟

33
00:04:10,810 --> 00:04:11,730
.بل قابلت

34
00:04:12,890 --> 00:04:14,190
.كنتُ أعرف واحدة

35
00:04:14,980 --> 00:04:18,980
لقد كانت غريبة أطوار لم تكن سعيدة
...لأنّها أصبحت قدّيسة

36
00:04:19,400 --> 00:04:22,570
رغم أنّها اُختيرتْ لترث قوّةَ إله؟

37
00:04:23,200 --> 00:04:26,740
.وهنالك الكثيرون ممّن رغبوا بها ولم يحصلوا عليها

38
00:04:26,740 --> 00:04:28,280
هل أنت أيضًا واحدٌ منهم يا أدليت-سان؟

39
00:04:28,910 --> 00:04:29,950
أنا؟

40
00:04:29,950 --> 00:04:33,750
.أنا أقوى رجل في العالم

41
00:04:34,040 --> 00:04:37,710
لماذا قد أغار من قدّيسة؟ على أيّ
...حال، القدّيسات من النّساء فحسب

42
00:04:37,710 --> 00:04:40,630
.ربّما الإله يحبّ النّساء

43
00:04:41,800 --> 00:04:46,050
بالتّالي، سأستعمل هذه القوّة الّتي
.منحنيها إلهٌ مُحبّ للنساء أحسن استعمال

44
00:04:46,760 --> 00:04:48,260
.هكذا

45
00:04:51,850 --> 00:04:53,680
ما الّذي تفعلينه يا غبيّة؟

46
00:04:54,350 --> 00:04:56,270
يجب أن يكون تفادي هذا سهلاً، صحيح؟

47
00:04:58,310 --> 00:05:00,070
!يكفي

48
00:05:00,860 --> 00:05:03,400
!أنا آسفة! لقد تحمّستُ قليلاً

49
00:05:04,030 --> 00:05:05,400
.بالطّبع تحمّستِ

50
00:05:06,320 --> 00:05:07,660
هل أنت غاضب؟

51
00:05:08,410 --> 00:05:09,660
.أنا غاضب

52
00:05:09,660 --> 00:05:10,990
.وكثيرًا

53
00:05:11,910 --> 00:05:13,000
!أنا آسفة

54
00:05:14,160 --> 00:05:17,040
.أنا فتاة غريبة نوعًا ما

55
00:05:17,290 --> 00:05:19,540
.تغضب منّي الخادمات طوال الوقت

56
00:05:19,540 --> 00:05:21,550
.ووالدي يتجاهلني أيضًا

57
00:05:22,670 --> 00:05:26,550
هل أنا فتاة مزعجة أينما حللتُ وارتحلت؟

58
00:05:28,840 --> 00:05:31,640
...كلاّ، الأمر ليس هكذا

59
00:05:36,730 --> 00:05:39,310
هل ظننتَ فعلاً أنّي كنتُ حزينة؟

60
00:05:40,980 --> 00:05:43,570
!أنت شخص ممتع بالفعل يا أدليت-سان

61
00:05:43,570 --> 00:05:47,150
.ما كنتُ لأُحبَط بسهولة. لا تقلق

62
00:05:53,330 --> 00:05:55,830
!لا تغضب رجاءً

63
00:05:55,830 --> 00:05:57,660
.تحمستُ للغاية

64
00:05:57,660 --> 00:05:59,120
.بالطّبع تحمّستِ

65
00:05:59,420 --> 00:06:01,710
.أنا أكثر هدوءًا في العادة

66
00:06:02,090 --> 00:06:04,590
.أتصرّف بسخافة لأنّ هذا ممتع للغاية

67
00:06:06,010 --> 00:06:08,470
.نحن في طريقنا لمقاتلة إله الشّر

68
00:06:08,930 --> 00:06:10,470
هل تدركين ذلك؟

69
00:06:10,470 --> 00:06:11,890
.بالطّبع أنا مدركة لذلك

70
00:06:12,600 --> 00:06:14,180
.هذه هي المرّة الوحيدة الّتي سأتصرّف بها هكذا

71
00:06:15,930 --> 00:06:17,850
.هذا جديد عليّ

72
00:06:18,350 --> 00:06:20,940
.فهمت، لكنّي لا أستطيع كبح نفسي

73
00:06:20,940 --> 00:06:23,230
جديد؟ ماذا تقصدين؟

74
00:06:24,780 --> 00:06:27,240
.أقصد التّواجد رفقة شخص مثلك يا أدليت-سان

75
00:06:38,210 --> 00:06:39,250
،قبل ستِّ سنوات

76
00:06:40,150 --> 00:06:42,590
.اندلعت حرب أهليّة في بيينا

77
00:06:42,990 --> 00:06:44,000
هل كنتَ تعرف ذلك؟

78
00:06:45,720 --> 00:06:48,350
.كنتُ أقضي كلّ وقتي أتدرّب في الجبال

79
00:06:49,380 --> 00:06:53,510
،أُلقيَ اللّوم على أبي بسبب الحرب الأهلية

80
00:06:53,520 --> 00:06:56,400
.وأمسى الآن مجرّد دمية، مجرّدًا من سلطاته

81
00:06:56,400 --> 00:06:58,710
يملك رئيس الوزراء كلّ السّلطات؟

82
00:06:58,710 --> 00:06:59,640
.نعم

83
00:07:00,340 --> 00:07:02,640
،ما عادت أمّي وأخي معنا بعد الآن

84
00:07:03,170 --> 00:07:05,520
.أنا الوحيدة المتبقّية من العائلة المالكة

85
00:07:06,440 --> 00:07:10,230
حسنًا، هنالك بضعة أقارب من بعيد
...في بلدان أخرى، لكن

86
00:07:10,900 --> 00:07:14,490
لا يريدون ضمّ أيّ أحد لهم قد يشعل
فتيل حرب أهلية أخرى، صحيح؟

87
00:07:15,830 --> 00:07:18,200
.بل أحدٌ أستطيع التّحدّث إليه على قدم المساواة

88
00:07:19,500 --> 00:07:22,960
.شخصٌ أستطيع إخباره بصراحةٍ ما أفكّر وأشعر به

89
00:07:23,260 --> 00:07:25,140
.أنت الشّخص الأوّل يا أدليت-سان

90
00:07:25,450 --> 00:07:26,670
...أنا فقط

91
00:07:27,460 --> 00:07:30,420
أعاملك على قدم المساواة لأنّك زميلة
.من الشّجعان السّتّة مثلي

92
00:07:30,990 --> 00:07:32,410
.وهذا يكفي

93
00:07:32,970 --> 00:07:34,090
...هذا كلّ ما أحتاجه

94
00:07:37,520 --> 00:07:40,560
.الجوّ بارد في اللّيل. خذيها واخلدي للنّوم

95
00:07:40,870 --> 00:07:41,680
.حسنًا

96
00:07:42,280 --> 00:07:44,460
.سننام في العراء لبعض الوقت

97
00:07:45,300 --> 00:07:48,450
...قد يكون النّوم على الأرض صعبًا على أميرة، لكن

98
00:07:48,450 --> 00:07:50,750
.لا بأس. أنا معتادة على هذا

99
00:07:52,140 --> 00:07:55,920
.أمَر أبي أن يتمّ إعدامي خلال الحرب الأهليّة

100
00:07:56,990 --> 00:08:00,370
.كان هذا قبل أن أصبح قدّيسة الأنصال

101
00:08:01,740 --> 00:08:04,460
.هربتُ واختبأتُ لوقت طويل

102
00:08:05,500 --> 00:08:06,830
،حينها

103
00:08:06,830 --> 00:08:09,710
كلّ ما كنتُ أتمنّاه هو ليلة أستطيع فيها النّوم

104
00:08:10,990 --> 00:08:13,540
.دون أن أخشى الموت

105
00:08:15,460 --> 00:08:19,720
،لو تمكّنتُ من تأمين ذلك للعالم بأسره

106
00:08:21,300 --> 00:08:25,770
!فلن يزعجني أبدًا إلى متى سأضطر للنّوم على الأرض

107
00:08:31,110 --> 00:08:32,560
.غدًا، سنرحل باكرًا

108
00:08:33,070 --> 00:08:34,630
.اخلدي للنّوم

109
00:08:35,770 --> 00:08:36,450
.حسنًا

110
00:08:57,310 --> 00:08:58,510
استيقظتِ باكرًا؟

111
00:08:58,510 --> 00:08:59,620
.نعم، منذ مدّة

112
00:09:00,840 --> 00:09:02,010
!انظر إلى هذا

113
00:09:04,650 --> 00:09:06,160
أوليس جميلاً؟

114
00:09:07,350 --> 00:09:08,130
.نعم

115
00:09:09,800 --> 00:09:12,310
.إنّه مطمْئن وهادئ

116
00:09:13,490 --> 00:09:15,990
...رغم أنّ إله الشّر قد استيقظ

117
00:09:16,780 --> 00:09:20,160
.لن يعود مطمْئنًا إذا خسرنا

118
00:09:21,950 --> 00:09:23,120
.معك حقّ

119
00:09:25,710 --> 00:09:26,870
.لنبذل قصارى جهدنا

120
00:09:28,540 --> 00:09:29,330
.نعم

121
00:09:34,920 --> 00:09:36,300
،منذ ستّة أشهر

122
00:09:36,300 --> 00:09:39,090
.ذهب غولدوف في رحلة للعثور على قاتل الشّجعان

123
00:09:39,390 --> 00:09:41,300
...غولدوف أَوُرا

124
00:09:42,010 --> 00:09:44,430
قائد فرسان القرن الأسوَد لبيينا؟

125
00:09:45,100 --> 00:09:48,600
،كانت الرّسالة الّتي تلقّيناها منه تقول "لا أدلّة" فقط

126
00:09:48,620 --> 00:09:51,320
.لم تصلنا أيّ أخبار عنه خلال الأسابيع السّتّة الماضية

127
00:09:52,390 --> 00:09:54,190
...لا بدّ أنّ القاتل قد نال منه

128
00:09:54,190 --> 00:09:57,480
!ذلك مستحيل! غولدوف قويّ

129
00:09:58,210 --> 00:10:01,780
.وصل غولدوف إلى النّهائي في منافسات العام الماضي

130
00:10:03,890 --> 00:10:05,820
كنتِ أنتِ المنتصرة، صحيح؟

131
00:10:06,650 --> 00:10:09,320
.لقد تساهل معي في آخر لحظات القتال

132
00:10:10,410 --> 00:10:12,710
!لم أشعر بالإحباط كذلك الوقت أبدًا في حياتي

133
00:10:13,310 --> 00:10:15,480
جعلتُه يعدني

134
00:10:15,480 --> 00:10:18,300
.أنّه لن يموت إلى أن يكفّر عن تلك المهانة

135
00:10:19,840 --> 00:10:21,510
.غولدوف لن يموت

136
00:10:22,180 --> 00:10:23,510
!لا يمكن أن يموت

137
00:10:24,470 --> 00:10:25,430
.ربّما

138
00:10:25,430 --> 00:10:27,890
هل تثقين به أم لا؟

139
00:10:27,890 --> 00:10:31,190
!أثق به! إنّه قويّ جدًّا

140
00:10:31,190 --> 00:10:34,530
.لكنّه لا زال يافعًا... إنّه في السّادسة عشر

141
00:10:34,980 --> 00:10:38,360
.نحن في الثّامنة عشر. لا يحقّ لنا أن نتحدّث

142
00:10:40,570 --> 00:10:42,570
هل هنالك ضحايا آخرون؟

143
00:10:42,570 --> 00:10:43,910
.كلاّ

144
00:10:44,620 --> 00:10:45,660
.ربّما

145
00:10:45,660 --> 00:10:47,200
ربّما" أخرى؟"

146
00:10:52,920 --> 00:10:55,130
،إنّ قدّيسة الشّمس ريورا-ساما

147
00:10:55,550 --> 00:10:57,630
.مفقودة منذ الشهر السابق

148
00:10:57,880 --> 00:11:00,380
ريورا؟ ريورا لا غير؟

149
00:11:00,880 --> 00:11:05,560
سمعتُ أنّه خلال شبابها، دمّرت ريورا
.قلعةَ عدوٍّ بأشعة شمس من السّماء

150
00:11:05,560 --> 00:11:06,560
.نعم

151
00:11:06,560 --> 00:11:10,190
...ريورا قويّة بكلّ تأكيد، لكن

152
00:11:10,850 --> 00:11:14,730
.لكنّها الآن طاعنة في السّنّ لتكون أحد الشّجعان المحتملين

153
00:11:14,730 --> 00:11:17,030
.ما كان قاتل الشّجعان ليسعى خلفها

154
00:11:17,030 --> 00:11:21,280
.لذلك لستُ واثقة إن كان عليّ الإبلاغ بهذا

155
00:11:21,280 --> 00:11:22,410
.لا يهمّ ذلك

156
00:11:22,410 --> 00:11:24,580
.سنعثر على قاتل الشّجعان في نهاية المطاف

157
00:11:24,580 --> 00:11:25,530
في نهاية المطاف؟

158
00:11:26,330 --> 00:11:28,040
.سنضطرّ لمقاتلته

159
00:11:28,370 --> 00:11:29,750
.أنا واثق من ذلك

160
00:11:34,750 --> 00:11:38,420
بمجرّد أن نعبر هذا الجسر، سنكون
.في بلاد الهضاب الحديديّة غوينباير

161
00:11:39,420 --> 00:11:41,130
...وتقع خلفها

162
00:11:41,930 --> 00:11:42,970
.أرض الشّياطين العاوية

163
00:11:44,180 --> 00:11:45,140
.لنسرع

164
00:11:45,140 --> 00:11:46,970
.أخذ الأمر منّا عشرة أيّام لنصل إلى هنا

165
00:11:46,970 --> 00:11:47,770
.أجل

166
00:12:01,320 --> 00:12:02,740
.ستُهاجمنا قريبًا

167
00:12:03,860 --> 00:12:07,240
.سيرغب العدوّ بالقضاء علينا قبل أن نجتمع

168
00:12:07,530 --> 00:12:10,410
.هكذا قُتل واحد من آخر الشّجعان السّتّة

169
00:12:10,410 --> 00:12:12,250
.تعرف الكثير عن هذا

170
00:12:12,580 --> 00:12:15,630
نقش معلّمي كلّ شيء يجب
.أن أعرفه عن الكيوما في عقلي

171
00:12:15,630 --> 00:12:19,760
.أنواعها ودورات حياتها ونقاط ضعفها وحتّى تحرّكاتها الممكنة

172
00:12:29,350 --> 00:12:30,520
...ناشيتانيا

173
00:12:33,310 --> 00:12:34,520
!ناشيتانيا

174
00:12:34,520 --> 00:12:36,110
نـ-نعم؟

175
00:12:36,440 --> 00:12:38,150
هل أنتِ متوتّرة؟

176
00:12:38,820 --> 00:12:39,730
...كلاّ

177
00:12:44,490 --> 00:12:45,700
.اهدئي

178
00:12:46,030 --> 00:12:48,370
.لم تبدأ المعركة بعد

179
00:12:48,870 --> 00:12:50,540
.هـ-هذا صحيح

180
00:12:51,200 --> 00:12:53,500
.لم نقابل ولا واحدًا من الكيوما بعد

181
00:12:53,910 --> 00:12:54,830
...لا يجب

182
00:12:55,710 --> 00:12:59,040
.اضحكي

183
00:12:59,040 --> 00:13:00,800
.ذلك أوّل شيء يجب أن تفعليه

184
00:13:00,800 --> 00:13:02,630
...هذا مستحيل

185
00:13:02,630 --> 00:13:04,930
.لن تكفّ يداي عن الارتعاش

186
00:13:05,510 --> 00:13:07,640
...ما كنتُ لأتمكّن من الضّحك

187
00:13:18,360 --> 00:13:19,650
هل هدأتِ؟

188
00:13:20,190 --> 00:13:21,280
.نعم

189
00:13:21,690 --> 00:13:24,360
.كان ذلك أوّل شيء علّمنيه معلّمي

190
00:13:25,280 --> 00:13:26,860
.الضّحك

191
00:13:28,620 --> 00:13:30,950
تتلمذتَ على يد معلّم ممتاز، صحيح؟

192
00:13:30,950 --> 00:13:32,620
...لا أدري بشأن ذلك

193
00:13:43,210 --> 00:13:44,210
ما الخطب؟

194
00:13:44,210 --> 00:13:45,470
...حاولنا الهرب

195
00:13:45,470 --> 00:13:47,470
!حاولنا الهرب قبل أن تحضر الكيوما

196
00:13:48,840 --> 00:13:51,310
.هاجمتنا الكيوما بينما نحن نهرب

197
00:13:51,640 --> 00:13:53,930
...لقد تركنا أصدقاءنا وابننا الصّغير

198
00:13:53,930 --> 00:13:55,930
!ناشيتانيا، اتبعيني

199
00:13:55,930 --> 00:13:56,600
!حسنًا

200
00:13:58,810 --> 00:13:59,810
فخّ؟

201
00:14:00,360 --> 00:14:02,520
.ذلك متحمل

202
00:14:03,150 --> 00:14:05,530
.ونحن هدفها

203
00:14:09,990 --> 00:14:13,870
!لن يسمح أقوى رجلٍ في العالم أن يلقى قرويّون حتفهم

204
00:14:14,120 --> 00:14:15,410
!لنذهب يا ناشيتانيا

205
00:14:15,410 --> 00:14:16,080
!أجل

206
00:14:18,620 --> 00:14:19,750
!سأبطئ من حركتها

207
00:14:20,170 --> 00:14:21,790
!وأنتِ أنهي أمرها

208
00:14:32,680 --> 00:14:33,760
.نجحتِ

209
00:14:35,310 --> 00:14:37,230
.كلاّ... أنا منبهرة

210
00:14:54,490 --> 00:14:56,790
ناي يتردّد صداه في آذان الكيوما؟

211
00:15:23,230 --> 00:15:24,900
!كان ذلك مثاليًّا

212
00:15:27,110 --> 00:15:28,940
.يصعب التّصديق أنّ هذا هو قتالك الأوّل

213
00:15:30,530 --> 00:15:33,410
...كلاّ، كان الفضل لك يا أدليت-سان

214
00:15:33,700 --> 00:15:37,200
أرسلتني لأقاتل في الخلف لأنّها أوّل مرّة لي، صحيح؟

215
00:15:37,490 --> 00:15:39,580
.أرسلتُك للنّقطة المناسبة بكلّ بساطة

216
00:15:40,290 --> 00:15:41,170
.أجل

217
00:15:44,340 --> 00:15:47,130
.أظنّني سأكون مفيدة من الآن فصاعدًا أيضًا

218
00:15:49,170 --> 00:15:50,630
.أعتمد عليكِ

219
00:15:50,630 --> 00:15:51,430
!أجل

220
00:15:59,680 --> 00:16:01,770
هل هنالك من لم يستطع الهرب؟

221
00:16:03,480 --> 00:16:05,190
هل بقي أحد في القرية؟

222
00:16:05,190 --> 00:16:08,650
...إ-إنّها فتاة مسافِرة بقيت في القرية وحدها

223
00:16:10,900 --> 00:16:11,990
إلى أين تذهب؟

224
00:16:11,990 --> 00:16:14,490
.لا تزال هنالك فتاة في القرية

225
00:16:14,990 --> 00:16:16,780
.ابقَيْ هنا

226
00:16:21,210 --> 00:16:23,420
...لن ننجح

227
00:16:24,420 --> 00:16:26,590
.هنالك اثنان منّا فحسب

228
00:16:27,000 --> 00:16:30,260
.لا يمكننا إنقاذ الجميع

229
00:16:33,010 --> 00:16:36,390
.أنا آسفة، لكن لنُكمل طريقنا

230
00:16:37,760 --> 00:16:41,390
.إمّا أن نهزم إله الشّر أو ننقذ النّاس

231
00:16:42,350 --> 00:16:44,770
...من الصّعب القيام بالأمرين معًا

232
00:16:46,150 --> 00:16:47,770
.هذا يؤلمني أيضًا

233
00:16:48,650 --> 00:16:54,410
لكن الآن، واجبنا هو أن نقابل الشّجعان
!الآخرين في أقرب وقت ممكن

234
00:16:57,200 --> 00:16:58,410
.فهمت

235
00:17:02,910 --> 00:17:04,120
!سأذهب

236
00:17:04,710 --> 00:17:06,750
!أنا الرّجل الأقوى في العالم

237
00:17:07,080 --> 00:17:10,250
!ما-ما الّذي تقصده بذلك؟

238
00:17:13,630 --> 00:17:16,720
.هزيمة إله الشّر وإنقاذ النّاس

239
00:17:16,720 --> 00:17:19,810
.القيام بالأمرين هو ما يجعلني أقوى رجل في العالم

240
00:17:28,310 --> 00:17:29,980
ما زال هنالك المزيد منها؟

241
00:17:51,590 --> 00:17:52,880
...إنّه ضخم

242
00:17:56,550 --> 00:17:57,340
ما هذا؟

243
00:18:02,600 --> 00:18:03,810
كرة حديديّة؟

244
00:18:04,560 --> 00:18:05,730
رصاصة قوس؟

245
00:18:10,650 --> 00:18:11,730
.بارود

246
00:18:12,070 --> 00:18:13,280
.مستحيل

247
00:18:16,450 --> 00:18:19,280
.الفتاة المسافِرة بقيت في القرية عن قصد

248
00:18:52,270 --> 00:18:53,650
.وجدتُه

249
00:19:06,830 --> 00:19:09,000
.تهاجم الكيوما البشر فقط

250
00:19:09,540 --> 00:19:11,210
.عيشي بسلام

251
00:19:19,970 --> 00:19:20,880
من تكون؟

252
00:19:22,180 --> 00:19:23,510
...معذرة

253
00:19:24,140 --> 00:19:26,560
أتحبّين الكلاب؟

254
00:19:28,390 --> 00:19:29,810
.أحب الكلاب

255
00:19:30,440 --> 00:19:32,190
.لكن لا أحبّ البشر

256
00:19:33,440 --> 00:19:35,110
.أنا أحبّ الكلاب والبشر

257
00:19:38,190 --> 00:19:39,150
من تكون؟

258
00:19:41,160 --> 00:19:43,570
هل أتيتَ لتقتلني؟

259
00:19:43,950 --> 00:19:46,870
!لا تطلقي! أنا أدليت ماير

260
00:19:47,200 --> 00:19:49,500
!أنا واحد من الشّجعان السّتّة مثلكِ أنتِ

261
00:19:50,830 --> 00:19:51,830
.هذا صحيح

262
00:19:53,170 --> 00:19:56,300
.اسمي هو فريمي سبيدراو

263
00:19:56,710 --> 00:20:00,090
فريمي، هل يمكنكِ أن تضعي ذلك جانبًا؟

264
00:20:00,340 --> 00:20:00,970
.كلاّ

265
00:20:04,430 --> 00:20:05,430
!مهلاً

266
00:20:09,270 --> 00:20:10,480
...اسمعي

267
00:20:14,100 --> 00:20:15,310
.أجبني

268
00:20:16,570 --> 00:20:19,360
هل أتيتَ لتقتلني؟

269
00:20:19,360 --> 00:20:22,070
!كلانا من الشّجعان

270
00:20:22,860 --> 00:20:25,030
.لذلك السّبب سألتُك

271
00:20:36,460 --> 00:20:37,710
أدليت-سان؟

272
00:20:50,020 --> 00:20:55,440
.أنا غولدوف أَوُرا، جئتُ لأساعد الأميرة رغم تأخّري

273
00:20:56,110 --> 00:20:57,270
...هذا ما يبدو

274
00:20:57,730 --> 00:21:01,490
.بما أنّه تمّ اختياري، فمن المستحيل ألاّ يتمّ اختيارك

275
00:21:04,360 --> 00:21:06,160
.هذا لشرف عظيم لي

276
00:21:07,870 --> 00:21:11,620
سوف أحميكِ. سأضحّي بحياتي
.من أجلك لو اقتضى الأمر ذلك

277
00:21:14,750 --> 00:21:15,750
...غولدوف

278
00:21:16,080 --> 00:21:16,920
.نعم

279
00:21:17,130 --> 00:21:19,460
.كلانا من شجعان الزّهرة السّتّة

280
00:21:19,460 --> 00:21:20,920
.نحن صديقان على قدم المساواة

281
00:21:21,260 --> 00:21:24,010
.سوف نحمي بعضنا بعضًا من الآن فصاعدًا

282
00:21:24,260 --> 00:21:27,590
.لكن أيّتها الأميرة، أنت مميّزة

283
00:21:27,590 --> 00:21:30,010
.لا يجب أن يُسمح بأن يمسّك أيّ خطر ولو طفيف

284
00:21:31,640 --> 00:21:33,890
.حسنًا... فهمت

285
00:21:34,180 --> 00:21:35,060
.معك حقّ

286
00:21:37,900 --> 00:21:41,230
بالمناسبة يا غولدوف، هل من تطوّرات؟

287
00:21:41,780 --> 00:21:43,780
،لم أجدها بعد

288
00:21:44,190 --> 00:21:46,450
.لكنّي اكتشفتُ دليلاً حاسمًا

289
00:21:47,240 --> 00:21:50,030
.اسم وشكل قاتلة الشّجعان

290
00:21:50,030 --> 00:21:52,540
هذا مذهل! أهي من البشر؟

291
00:21:55,830 --> 00:21:57,170
...قاتلة الشّجعان

292
00:21:58,000 --> 00:22:00,500
.فتاة بشعر أبيض تحمل بندقيّة

293
00:22:01,210 --> 00:22:03,420
.اسمها فريمي

294
00:23:36,270 --> 00:23:39,100
.في الحلقة القادمة: الفتاة الّتي تقتل الشّجعان