1
00:00:00,600 --> 00:00:02,210
.أنت رجل غريب

2
00:00:02,560 --> 00:00:05,560
وضعك حرج، فلماذا تبتسم؟

3
00:00:06,270 --> 00:00:07,730
.بالطّبع سأبتسم

4
00:00:07,730 --> 00:00:10,780
.لا أزال الرّجل الأقوى في العالم

5
00:00:11,780 --> 00:00:13,150
...أدليت

6
00:00:13,150 --> 00:00:16,070
لِمَ أردتَ أن تصبح أحد الشّجعان السّتّة؟

7
00:00:33,010 --> 00:00:36,140
شجعان الزّهرة السّتّة

8
00:01:58,550 --> 00:02:00,010
...أهذه هي المرّة الأولى

9
00:02:00,010 --> 00:02:02,850
الّتي تُظهر فيها فلايمي اهتمامها بي؟

10
00:02:04,180 --> 00:02:05,680
لِمَ تسألين؟

11
00:02:06,390 --> 00:02:08,230
.لأنّك عاديّ

12
00:02:09,310 --> 00:02:14,530
.أنت رجل عاديّ فقط، مع الكثير من الأسلحة الغريبة

13
00:02:15,190 --> 00:02:16,900
أتقولين أنّي ضعيف؟

14
00:02:17,570 --> 00:02:20,450
...أنا الرّجل الأقوى في العالم

15
00:02:20,860 --> 00:02:22,370
.أنا لم أقل ذلك

16
00:02:23,080 --> 00:02:26,910
يساورني الشّك فحسب حيال
،إمكانية أن يصبح رجل عاديّ مثلك

17
00:02:26,910 --> 00:02:28,580
.بهذه القوّة

18
00:02:29,790 --> 00:02:31,630
.يعود الفضل في ذلك لمعلّمي

19
00:02:32,040 --> 00:02:35,630
.ربّما لا يجدر بي قول هذا، لكن معلّمي كان مجنونًا نوعًا ما

20
00:02:36,090 --> 00:02:38,300
.كان مهووسًا بهزيمة الكيوما

21
00:02:38,630 --> 00:02:41,680
لذلك اتّخذ من الجبال معقلاً له وابتكر العديد من الأسلحة

22
00:02:41,680 --> 00:02:43,890
.واستعمالات جديدة لها

23
00:02:44,140 --> 00:02:46,060
.كان من الصّعب تصديق أنّه من البشر

24
00:02:46,640 --> 00:02:49,890
.لقد علّمني كيف أقاتل وكان صارمًا في ذلك

25
00:02:50,190 --> 00:02:53,190
.كنّا نتدرّب كلّ يوم حتّى لا أعود قادرًا على الحركة

26
00:02:54,440 --> 00:02:57,320
.وكنتُ أدرس وكأنّي مغلول إلى مكتبي

27
00:02:58,570 --> 00:03:02,870
.تعلّمتُ كيف أصنع الأسلحة السرّيّة والسّموم والبارود

28
00:03:03,320 --> 00:03:05,830
.وأحدث ما هنالك من المعرفة العلميّة

29
00:03:05,830 --> 00:03:08,200
العلميّة؟ درستَ العلوم أيضًا؟

30
00:03:08,750 --> 00:03:10,830
.أنا ممتنّ لمعلّمي

31
00:03:11,080 --> 00:03:13,460
.أصبحتُ أقوى بفضله

32
00:03:13,830 --> 00:03:16,210
.أظنّني سمعتُ عن رجل كهذا

33
00:03:16,210 --> 00:03:19,090
.نعم، كان اسمه أترو سبايكر

34
00:03:19,380 --> 00:03:21,550
.لقد كان ضمن قائمتي

35
00:03:21,550 --> 00:03:24,720
.لكن لم أمنحه الأولويّة بسبب كبر سنّه

36
00:03:25,350 --> 00:03:28,350
سمعتُ أنّ لا أحد من تلاميذه استطاع
،تحمّل أساليب تدريبه الصارمة

37
00:03:28,350 --> 00:03:30,270
.وهربوا جميعًا

38
00:03:30,600 --> 00:03:32,690
...معلوماتك خاطئة

39
00:03:32,690 --> 00:03:34,100
.أنا لم أهرب

40
00:03:34,440 --> 00:03:36,610
كيف استطعتَ تحمّل ذلك؟

41
00:03:37,980 --> 00:03:39,280
حدث شيء ما، صحيح؟

42
00:03:39,940 --> 00:03:43,030
.السّبب الّذي جعلت ترغب بأن تصبح أحد الشّجعان السّتّة

43
00:03:47,780 --> 00:03:49,370
،عندما كنتُ صغيرًا

44
00:03:49,370 --> 00:03:52,120
.أتى أحد الكيوما إلى قريتنا

45
00:03:57,210 --> 00:03:59,340
!تمهّل يا أدليت

46
00:04:00,420 --> 00:04:01,920
!مستحيل

47
00:04:02,220 --> 00:04:03,180
!مهلاً

48
00:04:06,220 --> 00:04:07,300
ماذا هنالك؟

49
00:04:24,990 --> 00:04:26,110
...إنّه من الكيوما

50
00:04:26,110 --> 00:04:27,700
!سأقاتله

51
00:04:27,700 --> 00:04:29,120
!توقّف يا راينر

52
00:04:29,530 --> 00:04:30,450
!أفلتني

53
00:04:30,450 --> 00:04:31,200
!إيّاك

54
00:04:31,200 --> 00:04:32,370
!كلاّ

55
00:04:33,910 --> 00:04:35,120
...توقّف

56
00:04:35,120 --> 00:04:36,580
!توقّف

57
00:04:46,130 --> 00:04:48,350
.أهلاً، سررت بلقائكما

58
00:04:53,230 --> 00:04:55,140
ألا يمكنكما حتّى ردّ التّحيّة؟

59
00:04:56,650 --> 00:04:58,110
.ما باليد حيلة إذًا

60
00:04:59,610 --> 00:05:04,030
.أتيتُ لأتحدّث إلى كبار هذه القرية

61
00:05:14,120 --> 00:05:16,500
.لم يغمض لي جفن في تلك اللّيلة

62
00:05:18,000 --> 00:05:21,300
.كان الكيوما قد غادر عندما حلّ الصّباح

63
00:05:21,880 --> 00:05:24,340
...لكنّ كبير القرية قال

64
00:05:24,920 --> 00:05:28,550
.ستنتقل هذه القرية إلى أرض الشّياطين العاوية

65
00:05:28,840 --> 00:05:32,600
.سيحكمنا إله الشّر

66
00:05:32,930 --> 00:05:36,020
.من المستحيل أن ينتصر الشّجعان السّتّة

67
00:05:36,020 --> 00:05:38,350
!لقد انتهى أمر عالم البشر

68
00:05:39,480 --> 00:05:43,480
،لكن إذا ما انضممنا إلى إله الشّر الآن
.فسننجو بحياتنا على الأقل

69
00:05:43,480 --> 00:05:45,360
...راينر... أختي

70
00:05:43,900 --> 00:05:45,820
!لا خيار آخر أمامنا

71
00:05:45,820 --> 00:05:49,490
لكنّ ذلك الكيوما قال شيئًا قبل أن يغادر، صحيح؟

72
00:05:49,490 --> 00:05:53,290
،نعم، قال أن نقتلع قلوب كلّ من عارض هذا الأمر

73
00:05:53,290 --> 00:05:56,750
.وأن نحضرها له كإشارة على ولائهم لإله الشّر

74
00:05:57,160 --> 00:05:58,460
.أنا متفاجئ من معرفتك لهذا

75
00:05:58,750 --> 00:06:01,250
.أخبرني ما هو شكل ذلك الكيوما

76
00:06:01,590 --> 00:06:04,590
...حسنًا، بدى ضخمًا حينها

77
00:06:04,590 --> 00:06:06,970
.لكنّي أعتقد أنّه بنفس حجم غولدوف

78
00:06:06,970 --> 00:06:10,760
.كانت له بعض سمات البشر وعليه بقع خضراء وورديّة

79
00:06:11,140 --> 00:06:13,930
كانت لديه ثلاث أجنحة، صحيح؟

80
00:06:14,510 --> 00:06:17,520
ثلاث أجنحة شبيهة بأجنحة الغربان على ظهره؟

81
00:06:17,520 --> 00:06:18,810
هل تعرفينه؟

82
00:06:19,390 --> 00:06:23,270
.إنّه واحد من الثّلاثة الّذين يحكمون الكيوما

83
00:06:23,860 --> 00:06:27,400
،كان هو من اقترح فكرة إنشاء هجين من الكيوما

84
00:06:27,820 --> 00:06:31,160
.وأمر أمّي أن تلدني

85
00:06:32,280 --> 00:06:33,620
.تابع

86
00:06:35,870 --> 00:06:38,330
.مات صديقي المقرّب وهو يحميني

87
00:06:39,210 --> 00:06:41,750
.وماتت أختي لأتمكّن من الهرب

88
00:06:42,630 --> 00:06:44,420
...كنتُ الوحيد الّذي نجى

89
00:06:46,090 --> 00:06:48,720
.ذلك ما أراد أن يحدث

90
00:06:49,220 --> 00:06:52,050
.لم يكرها القرويّين ولا حتّى في النّهاية

91
00:06:53,140 --> 00:06:56,390
.كانت غلطة الكيوما وليست غلطة القرويّين

92
00:06:57,270 --> 00:07:00,190
.قال صديقي المقرّب أنّه ليس علينا أن نكرههم

93
00:07:00,980 --> 00:07:02,980
،وقالت أختي أنّهم سيعودون يومًا ما

94
00:07:03,440 --> 00:07:07,230
...وسنعيش معهم في سلام

95
00:07:09,440 --> 00:07:10,900
...أخبرني معلّمي

96
00:07:11,700 --> 00:07:15,740
.أنّي أصبحت أقوى بفضل صديقي المقرّب وأختي

97
00:07:16,620 --> 00:07:19,750
.وأني أصبحتُ أقوى لأنّي لا زلت أؤمن بتلك الكلمات

98
00:07:20,910 --> 00:07:23,880
.وأنّ الرّجل لا يمكن أن يغدو أقوى من أجل الثّأر

99
00:07:24,460 --> 00:07:27,800
.وأنّه يمكن أن يغدو أقوى إذا ما آمن بشيء ما

100
00:07:30,130 --> 00:07:31,720
.أنا أحسدك

101
00:07:32,180 --> 00:07:33,590
ماذا قلتِ؟

102
00:07:33,970 --> 00:07:36,010
.قلتُ أنّي أحسدك

103
00:07:36,890 --> 00:07:40,350
هل قلتِ للتّو أنّك تحسدينني؟

104
00:07:40,640 --> 00:07:42,020
.أنا أحسدك

105
00:07:43,690 --> 00:07:46,690
.فلا أملك حتّى ما أؤمن به

106
00:07:47,110 --> 00:07:48,650
ما الّذي تقصدينه؟

107
00:07:49,690 --> 00:07:52,360
...الكيوما الّتي ولدتني وربّتني

108
00:07:52,650 --> 00:07:54,450
.أعطتني بندقيّة

109
00:07:54,740 --> 00:07:57,080
.أعطتني قوّة قدّيسة البارود

110
00:07:57,580 --> 00:07:59,910
.وكانت الكيوما الّتي منحتني السّعادة

111
00:07:59,910 --> 00:08:02,370
.ثمّ تخلّت عنّي

112
00:08:03,370 --> 00:08:08,300
.أحببتُ الجميع، وظننتُ أنّ الجميع يحبّونني

113
00:08:08,960 --> 00:08:12,840
،عندما كبرتُ وحصلت على قوّة قدّيسة البارود

114
00:08:12,840 --> 00:08:16,050
.قتلتُ الكثير من الأشخاص امتثالاً لأوامر أمّي

115
00:08:16,390 --> 00:08:18,390
.لم أشكّ أبدًا

116
00:08:19,260 --> 00:08:23,140
.كنتُ كيوما هجينة تجري في عروقي دماء بشريّة

117
00:08:23,440 --> 00:08:27,610
لذلك وجب عليّ أن أعمل بجهد أكبر
.من الآخر في سبيل إله الشّر

118
00:08:28,150 --> 00:08:29,570
.ذلك ما كنتُ اعتقده

119
00:08:30,860 --> 00:08:32,320
،ثمّ سعيتُ خلف تشامو

120
00:08:32,320 --> 00:08:36,030
.محاولة هزيمة واحدة من أقوى محاربي العالم

121
00:08:36,490 --> 00:08:39,120
.اضطررتُ للهرب دون أن ألحق بها خدشًا واحدًا

122
00:08:39,410 --> 00:08:43,540
.حتّى أنّي وقعتُ ضحية لاستفزازاتها وأخبرتها باسمي

123
00:08:43,960 --> 00:08:48,250
،بالكاد نجوت بحياتي، وعندما عدت
.حاولت أمّي أن تقتلني

124
00:08:48,670 --> 00:08:51,460
بقية الكيوما الّذين ظننتُ أنّهم أصدقائي

125
00:08:52,010 --> 00:08:54,220
.لم يكن لديهم أيّ فائدة منّي

126
00:08:55,260 --> 00:08:57,970
.ربّما وجب عليّ الموت حينها

127
00:08:58,390 --> 00:09:00,510
.لكنّي هربت

128
00:09:01,220 --> 00:09:04,560
.ما لا أستطيع أن أغفره لها ليس محاولتها قتلي

129
00:09:05,230 --> 00:09:07,270
،إن كنتُ مجرّد دمية

130
00:09:07,270 --> 00:09:10,520
.ما كنتُ لأشعر بأيّ ألم ولا حتّى ألم الخيانة

131
00:09:11,230 --> 00:09:13,110
،إن كانت تنوي أن تخونني منذ البداية

132
00:09:13,400 --> 00:09:17,280
.كان عليها أن تربّيني كعبدة في سبيل قتال البشريّة

133
00:09:17,280 --> 00:09:18,490
...لكنّ أمّي

134
00:09:20,280 --> 00:09:24,250
.لكنّ أمّي... تظاهرت بأنّها تحبّني

135
00:09:24,500 --> 00:09:25,710
الثّأر؟

136
00:09:25,710 --> 00:09:28,000
.ما كان قتلها ليكون كافيًا

137
00:09:28,750 --> 00:09:32,670
.كان عليّ أن أدمّر ما قضت حياتها سعيًا في تحقيقه

138
00:09:33,260 --> 00:09:36,090
،عندما سأهزم إله الشّر

139
00:09:37,180 --> 00:09:38,340
...سأخبر أمّي

140
00:09:40,720 --> 00:09:43,930
.أن تندم على ما فعلتْ، فهذه هي النّتيجة

141
00:09:44,720 --> 00:09:46,940
.كانت حياتي سعيدة للغاية حينها

142
00:09:47,390 --> 00:09:49,650
.كانت لي أمّ وأصدقاء

143
00:09:50,190 --> 00:09:52,940
.لعبنا جميعًا معًا وقاتلنا معًا

144
00:09:53,690 --> 00:09:56,950
كان لي كلب. أتساءل ما حلّ به الآن؟

145
00:09:57,400 --> 00:09:59,490
.أتساءل إن كانوا لا يزالون يطعمونه

146
00:10:00,530 --> 00:10:02,950
...أو ربّما قاموا بالتّخلّص منه

147
00:10:03,290 --> 00:10:05,750
.تشجّعي... في كلّ الأحوال

148
00:10:06,120 --> 00:10:07,660
لماذا لا تشكّ فيّ؟

149
00:10:08,790 --> 00:10:11,710
لماذا تصدّق ما أخبرتُك به للتّو؟

150
00:10:12,170 --> 00:10:14,250
ألا تظنّ أنّي كذبت عليك؟

151
00:10:14,590 --> 00:10:17,470
،إذا كنتَ بالفعل من تقول أنّك هو
،وأنّك لست السّابع

152
00:10:17,470 --> 00:10:19,630
.فعليك أن تشكّ بأمري أكثر من الآخرين

153
00:10:20,140 --> 00:10:23,100
.لكنّك لا تشكّ بأمري على الإطلاق

154
00:10:23,850 --> 00:10:27,350
.وهذا أكثر من سبب كافٍ لأشكّ بك

155
00:10:27,850 --> 00:10:29,850
...فهمتُ أخيرًا

156
00:10:30,150 --> 00:10:33,860
.لماذا لا أستطيع أن أتركك وحدك يا فلايمي

157
00:10:34,650 --> 00:10:37,400
،ولماذا قرّرتُ أن أخبرك عن ماضيّ

158
00:10:37,400 --> 00:10:39,740
.الّذي لم أطلعه حتّى لناشيتانيا

159
00:10:40,860 --> 00:10:42,660
.لأنّكِ تشبهينني

160
00:10:43,370 --> 00:10:47,620
.ألم الخيانة من أولئك الّذين وثقنا بهم، وفقداننا لموطننا

161
00:10:48,160 --> 00:10:50,420
.ألم استعمال الثّأر للاستمرار قُدُمًا

162
00:10:51,500 --> 00:10:54,290
.لا يمكنك فعل شيء عدا الأخذ بالثّأر

163
00:10:54,840 --> 00:10:57,130
...إنّ سبب تصديقي لكِ

164
00:10:58,010 --> 00:11:01,130
.هو لأنّي لا أريد أن أعتبرك عدوّة لي

165
00:11:02,090 --> 00:11:03,550
!لا تفهمي الأمر بشكل خاطئ

166
00:11:03,550 --> 00:11:06,640
!فلستُ معجبًا بك أو ما شابه

167
00:11:06,850 --> 00:11:08,890
.ما كنتُ أتحدّث عن ذلك على الإطلاق

168
00:11:08,890 --> 00:11:10,770
.لا ترعبني هكذا

169
00:11:11,850 --> 00:11:13,810
.أنت تختلف عنّي

170
00:11:14,980 --> 00:11:17,190
...لديك شيء تأمن به

171
00:11:19,360 --> 00:11:20,740
.سوف أعود للمعبد

172
00:11:21,150 --> 00:11:22,700
ألن تأتين معي؟

173
00:11:23,490 --> 00:11:24,950
،لقد ناقشنا الكثير من الأشياء

174
00:11:24,950 --> 00:11:28,540
.لكنّ ذلك لا يغيّر حقيقة أنّك لا تزال أكثر المشتبه بهم

175
00:11:28,870 --> 00:11:29,950
...صحيح

176
00:11:31,160 --> 00:11:32,250
بارود؟

177
00:11:32,750 --> 00:11:34,750
.ارمها على شيء ما وستنفجر

178
00:11:34,750 --> 00:11:36,210
.لن تصدر صوتًا أو ضوءًا

179
00:11:36,210 --> 00:11:40,800
.لكنّي أنا وحدي من ستعرف أين اشتعلت

180
00:11:44,590 --> 00:11:46,510
إذًا فأستطيع أن أناديك؟

181
00:11:47,310 --> 00:11:51,140
.قد أقتلك في المرّة القادمة الّتي نلتقي فيها

182
00:11:52,270 --> 00:11:54,900
.أنت حرّ في استعمالها أم لا

183
00:11:55,190 --> 00:11:56,110
!فلايمي

184
00:11:56,110 --> 00:11:58,020
!سأحميكِ

185
00:11:58,020 --> 00:11:59,780
!ليس أنتِ فقط

186
00:11:59,780 --> 00:12:02,030
!سأحمي ناشيتانيا والآخرين أيضًا

187
00:12:02,320 --> 00:12:04,780
!سأحمي الجميع

188
00:12:18,750 --> 00:12:19,550
.لا بأس

189
00:12:27,100 --> 00:12:28,890
.عرفتُ أنّك لا تزالين حيّة

190
00:12:29,560 --> 00:12:30,890
أين أدليت؟

191
00:12:31,220 --> 00:12:32,390
.لقد هرب

192
00:12:32,730 --> 00:12:35,600
.كان مصابًا وكنتُ آمُل أن أمسك به

193
00:12:35,600 --> 00:12:37,020
.لكن لم تكن بندقيّتي معي

194
00:12:37,020 --> 00:12:38,150
...فهمت

195
00:12:38,150 --> 00:12:39,770
.عليكِ أن تحظي ببعض النّوم أيضًا

196
00:12:39,770 --> 00:12:42,190
.سنتكلّم عن الأمر بالتّفصيل غدًا صباحًا

197
00:12:51,950 --> 00:12:54,120
.لا يمكننا استعادة ما خسرناه

198
00:13:03,720 --> 00:13:06,680
...لم أغدُ قويًّا لأجل الثّأر

199
00:13:08,050 --> 00:13:10,260
.ولا أقاتل بدافع الكراهية

200
00:13:11,600 --> 00:13:13,680
...لقد غدوتُ أقوى

201
00:13:14,600 --> 00:13:18,350
.لكي لا أخسر شيئًا ما ثانية

202
00:13:20,570 --> 00:13:22,690
،إن حاولتَ حماية الجميع

203
00:13:23,780 --> 00:13:25,400
...فأنت من سيلقى حتفه

204
00:13:26,650 --> 00:13:27,740
...يا أدليت

205
00:13:50,640 --> 00:13:56,020
.كانت تلك هي القصّة الكاملة الّتي رويتُها لأدليت عن نفسي

206
00:13:56,430 --> 00:13:59,440
.الكيوما مخلوقات قاسية

207
00:13:59,440 --> 00:14:01,150
...هذا فظيع

208
00:14:01,150 --> 00:14:02,900
.إن كان حقيقة

209
00:14:03,190 --> 00:14:05,900
لا زلتِ تشكّين بفلايمي؟

210
00:14:06,280 --> 00:14:07,860
.اتّضح الأمر سلفًا

211
00:14:08,570 --> 00:14:10,620
.فلايمي واحدة منّا

212
00:14:10,870 --> 00:14:12,370
...حسنًا

213
00:14:14,240 --> 00:14:17,210
.يساورني القلق بعض الشّيء

214
00:14:17,210 --> 00:14:19,370
هل من الصّواب بالفعل أن نعتبرها واحدة منّا؟

215
00:14:19,620 --> 00:14:20,540
!هانز

216
00:14:20,540 --> 00:14:23,130
هل قاتلتْ أدليت بالفعل؟

217
00:14:23,380 --> 00:14:26,210
.لقد أصابه سكّيني إصابة بليغة

218
00:14:26,260 --> 00:14:28,380
.لم تُصب أعضاءه الحيويّة

219
00:14:28,380 --> 00:14:31,260
.لستَ بالقوّة الّتي تصف نفسك بها

220
00:14:32,260 --> 00:14:35,640
...واضح تمامًا أن أدليت معجب بك

221
00:14:36,020 --> 00:14:38,180
.لقد دافع عنكِ عندما شككنا بأمرك

222
00:14:38,180 --> 00:14:41,060
.كما أنّه غضب وأوقفنا عندما قلنا أنّنا سنعذّبكِ

223
00:14:41,060 --> 00:14:44,190
!سيكون من المنطقيّ تمامًا لو وقعتِ في غرامه

224
00:14:44,730 --> 00:14:47,030
.أنت مزعج لدرجة كبيرة

225
00:14:47,940 --> 00:14:50,240
.قلب المرأة لغز أبديّ

226
00:14:50,570 --> 00:14:52,320
—أفكارها لا تتوافق مع كلماتها

227
00:14:52,320 --> 00:14:53,990
!هانز! اخرس لوهلة

228
00:14:56,620 --> 00:14:59,000
.لكنّ الشكوك تساورني أنا أيضًا

229
00:14:59,540 --> 00:15:02,290
كيف شعرتِ عندما أدركتِ أنّه السّابع؟

230
00:15:02,790 --> 00:15:04,920
.لم أتفاجأ على الإطلاق

231
00:15:04,920 --> 00:15:06,380
لم تتفاجئي؟

232
00:15:06,920 --> 00:15:09,880
.لقد كان يحاول أن يستدرجني لصالحه

233
00:15:09,880 --> 00:15:12,430
.أصبح الأمر واضحًا عندما اكتشفتُ الأمر

234
00:15:12,430 --> 00:15:13,340
.فهمت

235
00:15:15,100 --> 00:15:17,140
!يا لك من فتاة مخيفة

236
00:15:17,140 --> 00:15:19,230
.إنّ أدليت رجل مسكين

237
00:15:19,230 --> 00:15:22,190
هانز-سان! لماذا لا تخرس قليلاً؟

238
00:15:23,650 --> 00:15:25,190
.قيل لي أن أخرس مجدّدًا

239
00:15:25,570 --> 00:15:27,530
.المهمّ هنا هو أدليت

240
00:15:27,530 --> 00:15:28,940
كيف نمسك به؟

241
00:15:28,940 --> 00:15:32,070
!معظم أسلحته موجودة هنا

242
00:15:32,070 --> 00:15:34,450
.لا يمكنه القتال بدونها

243
00:15:34,820 --> 00:15:37,790
.أعتقد أنّه سيأتي إن انتظرنا هنا

244
00:15:37,790 --> 00:15:41,710
.لكنّي لا أظنّ أنّ الانتظار دون خطّة عمل حكيم

245
00:15:42,000 --> 00:15:43,710
.يجب أن نكون نحن من يبادر بالهجوم

246
00:15:44,380 --> 00:15:49,550
يستطيع أدليت حبسنا هنا ببساطة
.عن طريق الاختباء داخل الحاجز

247
00:15:50,050 --> 00:15:51,800
.سننقسم إلى ثنائيّات

248
00:15:52,340 --> 00:15:55,800
.ستبحثين عن أدليت معي يا فلايمي

249
00:15:57,010 --> 00:15:59,100
.ستذهب الأميرة مع غولدوف

250
00:15:59,430 --> 00:16:01,730
.لا تظهروا له الرّحمة أبدًا

251
00:16:02,100 --> 00:16:04,270
.غولدوف، اهتمّ بالأميرة

252
00:16:04,270 --> 00:16:05,230
.مفهوم

253
00:16:05,440 --> 00:16:07,480
،ستبقى تشامو هنا مع هانز

254
00:16:07,480 --> 00:16:09,610
.وستقاتلان أدليت إن ظهر

255
00:16:09,610 --> 00:16:11,110
!ابقيا مستعدّين

256
00:16:12,610 --> 00:16:16,280
...لن أقوم بالعمل كما يجب دون وجود فتاة جميلة برفقتي

257
00:16:16,280 --> 00:16:18,580
هل بإمكاني تبادل الأماكن مع غولدوف؟

258
00:16:19,370 --> 00:16:21,250
لا توجد اعتراضات، صحيح؟

259
00:16:21,540 --> 00:16:22,620
!لنذهب إذًا

260
00:16:22,620 --> 00:16:26,380
!هذا لا يمكن! لا تحبّ تشامو الانتظار

261
00:16:26,380 --> 00:16:27,290
.حسنًا

262
00:16:27,880 --> 00:16:30,880
.إذًا ستبقى فلايمي هنا، وستأتي تشامو معي

263
00:16:30,880 --> 00:16:33,010
!لا أريد أن أتجوّل هنا وهناك أيضًا

264
00:16:33,300 --> 00:16:36,510
!سوف أخرج وألعب حتّى يتمّ إبطال الحاجز

265
00:16:37,180 --> 00:16:38,510
!تشامو

266
00:16:40,520 --> 00:16:41,850
.لا تقلقي

267
00:16:41,850 --> 00:16:44,770
.يمكنني أن أتولّى أمر أدليت بمفردي

268
00:16:44,770 --> 00:16:47,150
.حسنًا... سعيدة لسماع هذا

269
00:16:47,440 --> 00:16:48,610
.سأدع الأمر لك إذًا

270
00:16:48,900 --> 00:16:49,770
!تشامو

271
00:16:49,770 --> 00:16:52,440
!احرصي على ألاّ تضيعي

272
00:16:52,440 --> 00:16:53,650
!حسنًا

273
00:16:54,610 --> 00:16:57,160
فلايمي، في أيّ اتّجاه هرب أدليت؟

274
00:16:57,450 --> 00:16:58,450
.من هنا

275
00:16:59,870 --> 00:17:02,080
.سنتّجه أنا وفلايمي شرقًا

276
00:17:02,080 --> 00:17:04,540
.اذهبا أنتما غربًا

277
00:17:04,830 --> 00:17:05,960
.مفهوم

278
00:17:06,620 --> 00:17:08,170
.لنذهب يا غولدوف

279
00:17:12,380 --> 00:17:13,090
ماذا؟

280
00:17:13,760 --> 00:17:17,090
هل يمكنك فعلاً مقاتلة الكيوما؟

281
00:17:17,090 --> 00:17:18,510
ما الّذي تقصده؟

282
00:17:18,800 --> 00:17:21,390
"!آسفة... سامحيني"

283
00:17:21,390 --> 00:17:23,310
"!أنا أندم على أفعالي دائمًا"

284
00:17:23,310 --> 00:17:25,560
"!لنعد كما كنّا في الماضي"

285
00:17:25,560 --> 00:17:28,350
إن قالت أمّك هذا، فهل تستطيعين قتلها؟

286
00:17:28,600 --> 00:17:31,400
.أستطيع. سأعرف أنّها تكذب

287
00:17:31,400 --> 00:17:32,860
!كلاّ

288
00:17:32,860 --> 00:17:34,490
.أنا قاتل مأجور

289
00:17:34,490 --> 00:17:36,610
.لقد نفّذت الكثير من المهمّات

290
00:17:36,610 --> 00:17:38,870
.زوج خانته زوجته

291
00:17:38,870 --> 00:17:40,870
.أطفال تخلّى عنهم آباؤهم

292
00:17:40,870 --> 00:17:44,330
.يأتون إليّ ويطلبون منّي أن أقتل

293
00:17:44,330 --> 00:17:45,370
...ولكن

294
00:17:45,750 --> 00:17:48,290
.لا يكونون سعداء أبدًا عند إنجازي للأمر

295
00:17:48,290 --> 00:17:52,750
.يطلب منّي أغلبيتهم ألاّ أكمل مهمّتي في اللّحظات الأخيرة

296
00:17:52,750 --> 00:17:54,130
وماذا في ذلك؟

297
00:17:55,550 --> 00:17:57,380
.حسنًا، هذا لا يهمّ

298
00:17:58,380 --> 00:18:00,050
.لنذهب يا فلايمي

299
00:18:06,680 --> 00:18:07,980
ماذا هنالك؟

300
00:18:08,390 --> 00:18:11,520
غولدوف، هل تثق بي؟

301
00:18:11,900 --> 00:18:13,020
.بالطّبع

302
00:18:13,020 --> 00:18:15,610
بمن قد أثق فيما عداكِ؟

303
00:18:15,940 --> 00:18:17,740
...ما أقصده هو

304
00:18:17,740 --> 00:18:21,490
.هل ستوافق على أفكاري دون أن تقول كلمة واحدة

305
00:18:21,780 --> 00:18:24,620
أيّتها الأميرة، بماذا تفكّرين؟

306
00:18:25,500 --> 00:18:27,790
.أدليت-سان ليس هو السّابع

307
00:18:28,120 --> 00:18:30,830
.سوف أعمل على إثبات ذلك

308
00:18:30,830 --> 00:18:31,710
...أيّتها الأميرة

309
00:18:31,710 --> 00:18:33,380
!في الوقت الحاليّ فحسب

310
00:18:33,380 --> 00:18:34,880
!وافقني الرّأي دون أن تقول شيئًا

311
00:18:35,420 --> 00:18:36,840
...أعرف أنّ

312
00:18:37,300 --> 00:18:41,180
!أدليت-سان قد وقع في فخّ وهو بانتظاري

313
00:18:41,430 --> 00:18:43,430
.لا يمكنني فعل ذلك

314
00:18:43,430 --> 00:18:45,640
.هذا شيء لا يمكنني فعله ولو كان من أجلك

315
00:18:45,640 --> 00:18:48,430
.أنا لا أقول هذا دون امتلاك ما يدعم كلامي

316
00:18:49,350 --> 00:18:51,190
.ليس هنالك دليل

317
00:18:51,600 --> 00:18:53,730
.قد يكون مجرّد خطأ

318
00:18:54,070 --> 00:18:58,110
.لكن قد يكون المفتاحَ الّذي سيقودنا للحقيقة

319
00:18:58,690 --> 00:19:00,700
بمن تشكّين؟

320
00:19:03,870 --> 00:19:05,080
.هانز-سان

321
00:19:34,060 --> 00:19:36,690
،إذا كانت مورا برفقة فلايمي

322
00:19:37,400 --> 00:19:40,280
.فلا بدّ أنّ الأربعة الآخرين قد شكّلوا ثنائيّاتِ أيضًا

323
00:19:40,610 --> 00:19:41,780
.هذا سيّئ

324
00:19:42,200 --> 00:19:45,700
.هذا يعني أنّ هنالك من هو بمفرده مع السّابع

325
00:19:46,530 --> 00:19:48,240
،إن واتته الفرصة

326
00:19:48,240 --> 00:19:51,330
...فقد يقتل الشّخص الّذي برفقته ويلقي باللّوم عليّ

327
00:19:51,330 --> 00:19:52,040
!يجب أن أسرع

328
00:19:53,120 --> 00:19:55,210
.عليّ أن أتحرّى أمر المعبد

329
00:19:55,880 --> 00:19:59,260
.سوف أكشف خطّة السّابع وأثبت وجود الثّامن

330
00:19:59,550 --> 00:20:01,840
.كما أرغب باستعادة سلاحي السّرّيّ أيضًا إن أمكن

331
00:20:02,550 --> 00:20:05,140
،إن كانت ناشيتانيا لا زالت في المعبد

332
00:20:05,140 --> 00:20:07,180
...قد أكون قادرًا على التّفاوض

333
00:20:18,190 --> 00:20:19,440
!أهلاً

334
00:20:19,860 --> 00:20:22,200
.توقّعتُ مجيئك يا أدليت

335
00:20:22,490 --> 00:20:23,990
هذا أنت يا هانز؟

336
00:20:24,360 --> 00:20:27,330
بالتّفكير بالأمر، أنت قاتل مأجور، صحيح؟

337
00:20:27,330 --> 00:20:29,990
.لذلك فالهجمات المفاجئة والأفخاخ هي اختصاصك

338
00:20:30,330 --> 00:20:33,000
...ظننتُ أنّ تلك الخدع الرّخيصة هي كلّ ما في جعبتك

339
00:20:33,870 --> 00:20:36,630
.أنت أفضل ممّا توقّعت

340
00:20:38,380 --> 00:20:40,130
...التقيتُ بواحد منهم

341
00:20:40,130 --> 00:20:41,920
لا مهرب من القتال، صحيح؟

342
00:20:44,090 --> 00:20:45,510
.عليّ أن أهرب لوهلة

343
00:20:45,510 --> 00:20:46,640
!يجب أن أهرب

344
00:20:47,350 --> 00:20:50,010
،من الأفضل لك أن تقاتلني بنيّة القتل

345
00:20:50,010 --> 00:20:52,930
.وإلاّ انتهى هذا في ظرف لحظات

346
00:20:52,930 --> 00:20:54,390
لماذا لا تنزل إلى هنا؟

347
00:20:54,390 --> 00:20:56,150
!يمكننا أن نمرح كثيرًا

348
00:21:08,700 --> 00:21:10,990
...لن تنفع نفس الخدعة معي

349
00:21:28,590 --> 00:21:29,600
ماذا هنالك؟

350
00:21:29,600 --> 00:21:32,390
هل سمعتِ شيئًا صادرًا من المعبد؟

351
00:21:33,850 --> 00:21:34,890
...كلاّ

352
00:21:34,890 --> 00:21:37,600
لنسرع، علينا العثور على دليل

353
00:21:37,850 --> 00:21:40,440
.يثبت أنّ هانز-سان هو الشّجاع السّابع

354
00:21:58,830 --> 00:22:02,090
...هذا مؤسف للغاية يا أدليت

355
00:23:36,010 --> 00:23:38,560
.في الحلقة القادمة: الرّجل العاديّ والعبقري