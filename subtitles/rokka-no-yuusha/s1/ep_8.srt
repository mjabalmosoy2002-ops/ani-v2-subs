1
00:00:00,720 --> 00:00:02,730
بمن تشكّين؟

2
00:00:03,890 --> 00:00:05,230
.هانز-سان

3
00:00:16,660 --> 00:00:19,580
...هذا مؤسف للغاية يا أدليت

4
00:00:38,050 --> 00:00:41,220
شجعان الزّهرة السّتّة

5
00:01:54,550 --> 00:01:56,800
،لم تكن خطّة سيّئة

6
00:01:56,800 --> 00:01:59,640
.أقصد تظاهرك بأنّك واحد من الشّجعان السّتّة

7
00:02:00,010 --> 00:02:03,890
.كانت خطّتك لتنجح لو لم أكن هنا

8
00:02:04,560 --> 00:02:06,600
...هانز، أنا

9
00:02:06,600 --> 00:02:09,850
هل ستخبرني أنّك لست المزيّف؟

10
00:02:09,850 --> 00:02:11,900
...لن ينفع ذلك

11
00:02:11,900 --> 00:02:15,780
.لقد تفاجأتُ عندما أخذتَ رهينة

12
00:02:16,240 --> 00:02:19,660
.ظننتُ أنّك أكثر ذكاءً من ذلك

13
00:02:20,860 --> 00:02:24,160
.أخبرني الآن لحساب مَن تعمل

14
00:02:24,160 --> 00:02:27,290
.لا يمكنني القول لأنّي لستُ المزيّف

15
00:02:27,290 --> 00:02:30,500
هل أمّك المريضة بحاجة لدواء؟

16
00:02:30,500 --> 00:02:33,840
هل أخذوا محبوبتك الجميلة كرهينة؟

17
00:02:34,460 --> 00:02:36,670
.لا عائلة لي ولا محبوبة

18
00:02:37,260 --> 00:02:40,090
!سبق وقلتُ هذا، أنا لست المزيّف

19
00:02:41,340 --> 00:02:44,760
.إذًا لن يحزن أحدٌ لموتك

20
00:02:48,020 --> 00:02:50,980
!لقد أرغمتني على استعمالها أيّها الوغد

21
00:02:53,810 --> 00:02:54,980
أنت هناك؟

22
00:03:07,540 --> 00:03:08,540
!سُحقًا

23
00:03:08,540 --> 00:03:11,170
كيف لا يزال يطاردني بهذه الدّقّة
حتّى بعد أن تعرض لذلك الهجوم؟

24
00:03:16,250 --> 00:03:17,300
.عبقريّ لعين

25
00:03:37,150 --> 00:03:39,860
.لا يمكن للرّجل العاديّ أن يتغلّب على عبقريّ

26
00:03:52,000 --> 00:03:54,000
...لم ينفع ذلك أبدًا

27
00:04:01,670 --> 00:04:02,760
ماذا؟

28
00:04:08,260 --> 00:04:09,720
ما الّذي تفعله؟

29
00:04:11,230 --> 00:04:12,600
.تعال ونل منّي

30
00:04:15,440 --> 00:04:17,650
.لستُ بحاجة لأيّ أسلحة سرّيّة أخرى

31
00:04:18,610 --> 00:04:20,440
.سأهزمك بقوّتي الخاصّة فحسب

32
00:04:21,820 --> 00:04:23,950
أنت تخطّط لشيء ما، صحيح؟

33
00:04:25,990 --> 00:04:27,280
.هذا صحيح

34
00:04:30,580 --> 00:04:32,040
ما الأمر يا هانز؟

35
00:04:32,330 --> 00:04:33,580
أأنت خائف؟

36
00:04:33,580 --> 00:04:36,250
.نعم، أنا خائف

37
00:04:37,250 --> 00:04:38,540
.أنت صريح

38
00:04:39,250 --> 00:04:42,670
.أنا أقتل، لكن لا أكذب

39
00:04:43,170 --> 00:04:45,470
.الكذب سيّئ

40
00:04:46,720 --> 00:04:50,640
.النّصر لا يعني أن أهزم هانز في هذه الحالة

41
00:04:51,140 --> 00:04:55,140
.بل تبرئة اسمي والعثور على الشّجاع السّابع

42
00:04:56,060 --> 00:04:57,520
...وخطّتي لتحقيق ذلك هي

43
00:05:00,730 --> 00:05:03,070
.هذا صحيح. تصرّف بحذر

44
00:05:03,070 --> 00:05:04,400
.راقب

45
00:05:05,200 --> 00:05:07,740
أين هي ورقتي الرّابحة؟

46
00:05:08,700 --> 00:05:10,160
أهي بين ثيابي؟

47
00:05:11,030 --> 00:05:12,540
أهي في فمي؟

48
00:05:13,950 --> 00:05:15,710
أم في قدميّ؟

49
00:05:18,920 --> 00:05:21,210
ماذا عن المسافة بين الحزام الّذي رميتُه وبيني؟

50
00:05:22,050 --> 00:05:25,590
.لكن هنالك شيء واحد لا تراقبه

51
00:05:27,050 --> 00:05:30,350
.أنت عبقريّ، لذلك فهو الشّيء الّذي لا تحتاج لمراقبته

52
00:05:31,010 --> 00:05:32,100
!فات الأوان

53
00:05:39,690 --> 00:05:40,860
.هذا صحيح يا هانز

54
00:05:41,150 --> 00:05:42,940
!أعرف أنّك فهمت الأمر

55
00:05:43,530 --> 00:05:46,360
!لقد تعمّدتُ عدم إصابتك

56
00:05:51,120 --> 00:05:52,660
لماذا لم تصبني؟

57
00:05:53,830 --> 00:05:55,410
...فكّر يا هانز

58
00:05:57,040 --> 00:05:58,920
،إن كنتُ السّابع

59
00:06:00,790 --> 00:06:03,340
فهل كان هنالك من دافع لي لكي لا أصيبك؟

60
00:06:04,340 --> 00:06:06,010
...ذلك الهجوم الأخير

61
00:06:06,010 --> 00:06:09,300
.كان فرصتي الوحيدة لهزيمتك

62
00:06:10,640 --> 00:06:13,310
لماذا تخلّيتُ عن تلك الفرصة؟

63
00:06:14,930 --> 00:06:17,560
.لا يمكنك أن تخدعني

64
00:06:18,230 --> 00:06:20,150
،إن كنتُ السّابع

65
00:06:20,150 --> 00:06:22,810
.ستكون محاولة قتلك أأمن من خداعك

66
00:06:23,320 --> 00:06:26,150
.لم تكن تراقب سيفي على الإطلاق

67
00:06:26,490 --> 00:06:27,190
صحيح؟

68
00:06:28,700 --> 00:06:30,110
.لستُ المزيّف

69
00:06:30,910 --> 00:06:34,950
.لذلك لم أستطع قتلك يا زميلي

70
00:06:34,950 --> 00:06:36,450
.هذه إجابتي

71
00:06:36,750 --> 00:06:39,080
!لهذا السّبب لم أصبك

72
00:06:39,540 --> 00:06:41,250
!اقبل هذا يا هانز

73
00:06:42,710 --> 00:06:44,210
.هذا رهان

74
00:06:44,670 --> 00:06:48,220
.أنا هالك إن كان هانز هو السّابع

75
00:06:50,970 --> 00:06:51,970
...حسنًا

76
00:06:52,260 --> 00:06:53,890
.أنا أقبله

77
00:06:54,180 --> 00:06:56,470
.أنت شجاعٌ حقيقيّ

78
00:06:56,470 --> 00:06:57,520
...هانز

79
00:06:58,350 --> 00:07:01,100
.أنا سعيد لأني بقيتُ هنا

80
00:07:01,650 --> 00:07:04,610
.كنتَ لتنجح بإقناع الآخرين

81
00:07:06,020 --> 00:07:07,780
...كان ذلك وشيكًا

82
00:07:07,780 --> 00:07:09,900
.لقد كنتَ وشيكًا بالفعل

83
00:07:10,820 --> 00:07:13,990
.هذا مؤسف يا أدليت

84
00:07:14,370 --> 00:07:15,240
!هانز

85
00:07:15,240 --> 00:07:17,490
!أنا هو الشّجاع السّابع

86
00:07:17,490 --> 00:07:17,990
!سُحقًا

87
00:07:19,330 --> 00:07:22,670
خسرتُ الرّهان؟

88
00:07:44,730 --> 00:07:45,860
...أنا على قيد الحياة

89
00:07:47,020 --> 00:07:48,940
لم يَشُقَّ حلقي؟

90
00:07:49,990 --> 00:07:52,700
.لقد جرحتُك لتراودك هلوَسة بما رأيت

91
00:07:52,990 --> 00:07:54,280
هلوَسة؟

92
00:07:54,280 --> 00:07:56,240
كانت تلك هلوَسة؟

93
00:07:56,240 --> 00:07:57,160
.نعم

94
00:07:57,740 --> 00:08:00,370
.يمكن للبشر أن يكذبوا بالكلمات

95
00:08:00,370 --> 00:08:02,290
.ويمكنهم أن يخدعوا بالأفعال

96
00:08:02,580 --> 00:08:05,580
.لا يمكن الوثوق بأعينهم ولا أصواتهم ولا تعابيرهم

97
00:08:05,920 --> 00:08:11,170
لكنّ وجوههم تظهر الحقيقة عندما
.يوشكون على الموت مهما كان

98
00:08:11,420 --> 00:08:13,050
،إن كنتَ المزيّف

99
00:08:13,050 --> 00:08:15,470
لَراودك الارتباك

100
00:08:15,470 --> 00:08:17,970
.عندما قلتُ أنّي الشّجاع السّابع

101
00:08:17,970 --> 00:08:21,180
.لكنّك بدوتَ وكأنّ الأمر قد انتهى بالنّسبة لك

102
00:08:21,600 --> 00:08:25,100
.أظنّ أنّك لستَ السّابع

103
00:08:26,560 --> 00:08:29,610
لا يمكن لوجه يوشك على الموت أن يكذب؟

104
00:08:30,690 --> 00:08:32,030
...لم أسمع بذلك من قبل

105
00:08:32,030 --> 00:08:33,490
.أنا واثق من ذلك

106
00:08:34,360 --> 00:08:39,240
كنتَ لتعرف ذلك لو كنتَ قد رأيتَ وجوه
.الكثير من الأشخاص الأموات كما رأيتُ أنا

107
00:08:39,580 --> 00:08:41,370
.يا لها من قصّة قصيرة بغيضة

108
00:08:42,830 --> 00:08:44,830
إلى متى ستظلّ واقفًا هناك؟

109
00:08:46,250 --> 00:08:49,380
.فأنا لا أهوى النّظر للرّجال العراة

110
00:09:00,310 --> 00:09:03,060
.نحن زملاء من الآن فصاعدًا

111
00:09:03,680 --> 00:09:06,940
.لقد فكّرتُ بأنّ الأمر غريب في البداية، لأكون صريحًا

112
00:09:07,440 --> 00:09:11,270
ما من سبب كان ليدفعك لحماية
...فلايمي لو كنتَ السّابع

113
00:09:12,320 --> 00:09:14,190
.كان حريًّا بك قول ذلك بما أنّه خطر ببالك

114
00:09:15,900 --> 00:09:17,570
.آسف بشأن هذا

115
00:09:19,870 --> 00:09:22,290
.عدنا لنقطة البداية إذًا

116
00:09:24,000 --> 00:09:26,580
من هو الشّجاع السّابع؟

117
00:09:29,080 --> 00:09:31,170
.كنتِ تقولين الحقيقة

118
00:09:31,630 --> 00:09:34,550
.واضح أنه قضى اللّيلة هنا

119
00:09:37,470 --> 00:09:38,390
...فلايمي

120
00:09:39,430 --> 00:09:41,430
هل تعرفين في أيّ طريق ذهب؟

121
00:09:42,260 --> 00:09:44,680
.كلاّ، كما لا توجد أيّة آثارٍ للدّماء

122
00:09:45,020 --> 00:09:47,440
.توقّفت أثار الأقدام في منتصف الطّريق

123
00:09:47,770 --> 00:09:49,150
ربّما تسلّق الشّجرة؟

124
00:09:50,980 --> 00:09:52,190
هل من خطب ما؟

125
00:09:52,610 --> 00:09:53,730
...لستُ أفهم

126
00:09:53,730 --> 00:09:55,860
ما الّذي يحاول أدليت أن يفعله؟

127
00:09:56,150 --> 00:09:58,700
ربّما نفذت منه الخيارات وقرر الهرب؟

128
00:09:58,700 --> 00:09:59,570
.كلاّ

129
00:09:59,570 --> 00:10:02,080
.لقد خطّط لهذا بكلّ حذر

130
00:10:02,580 --> 00:10:04,700
.لا يمكن أن ينتهي الأمر هكذا

131
00:10:05,160 --> 00:10:07,910
.علينا أن نبحث في كلّ مكان فحسب

132
00:10:07,910 --> 00:10:08,960
.لا تتعجّلي

133
00:10:09,670 --> 00:10:10,960
.لنتحدّث قليلاً

134
00:10:10,960 --> 00:10:13,500
.يمكننا أن نبدأ بمجرّد أن نستجمع أفكارنا

135
00:10:14,170 --> 00:10:15,460
.حسنًا

136
00:10:16,170 --> 00:10:17,970
.سؤالي الأوّل هو هذا

137
00:10:18,260 --> 00:10:21,850
لا تعرفين شيئًا عن فخّ الشّجاع السّابع؟

138
00:10:22,390 --> 00:10:23,470
هل هذا استجواب؟

139
00:10:23,470 --> 00:10:25,350
.لا تأخذي الأمر من هذه النّاحية

140
00:10:25,850 --> 00:10:28,690
أنا واثقة أنّ لا خيار أمامكِ سوى أن تكوني
.حذرة بعد ما حدث البارحة

141
00:10:29,020 --> 00:10:33,020
.لكنّنا لا نشك في أمرك بعد الآن

142
00:10:33,400 --> 00:10:34,730
.لا أدري بشان ذلك

143
00:10:35,190 --> 00:10:37,240
ماذا عن هانز-سان وتشامو؟

144
00:10:39,400 --> 00:10:40,910
.سأعيد صياغة كلامي

145
00:10:41,200 --> 00:10:43,330
.أنا لا أشكّ بكِ

146
00:10:43,950 --> 00:10:45,990
.أصدّق أنّكِ واحدة منّا

147
00:10:47,290 --> 00:10:48,200
.فهمت

148
00:10:49,000 --> 00:10:50,710
.آسفة، لكنّي لا أدري

149
00:10:51,580 --> 00:10:54,500
الكيوما منقسمة لعدّة مجموعات

150
00:10:54,500 --> 00:10:56,840
.قد لا تتواصل مع بعضها أبدًا

151
00:10:57,170 --> 00:11:00,510
.ظننتُ أنّها متّحدة أكثر من هذا

152
00:11:00,880 --> 00:11:03,140
.الكيوما معقّدة داخليًّا

153
00:11:03,140 --> 00:11:05,680
.وأكثر ممّا قد تتصوّرين

154
00:11:06,850 --> 00:11:08,560
ماذا عنكِ أنت؟

155
00:11:09,560 --> 00:11:12,270
هل هنالك أيّ بشر تحالفوا مع الكيوما؟

156
00:11:13,060 --> 00:11:15,070
لم تقابلي أحدًا منهم أبدًا؟

157
00:11:15,070 --> 00:11:17,530
.وصلتني إشاعات ومعلومات

158
00:11:17,940 --> 00:11:22,410
.وسمعتُ بأمر قريةٍ أخذتْ الكيوما سكّانها بأكملهم

159
00:11:22,820 --> 00:11:27,620
،لكن عندما وصلتني المعلومات
.لم يكن هنالك أيّ دليل

160
00:11:27,620 --> 00:11:30,210
...لم يستطع معبد كلّ السّماوات القيام بشيء

161
00:11:30,960 --> 00:11:33,330
،لو أنّي كنتُ حذرة أكثر

162
00:11:33,330 --> 00:11:35,790
.كنتُ لأتجنّب هذا على الأرجح

163
00:11:36,170 --> 00:11:37,670
.لا داعيَ لتقلقي بشأن هذا

164
00:11:38,090 --> 00:11:40,170
.هذه ليست مسؤوليتك الخاصّة

165
00:11:41,680 --> 00:11:45,180
.ماذا؟ أظنّ أنّ بإمكانك التّصرّف بلطف أيضًا

166
00:11:47,890 --> 00:11:50,640
.فعل أدليت شيئًا واحدًا جيّدًا

167
00:11:51,430 --> 00:11:54,060
.لقد أحضركِ إلينا

168
00:11:54,350 --> 00:11:56,940
،حتّى وإن كان ذلك جزءًا من خطّته

169
00:11:57,360 --> 00:11:59,230
.فقد كان شيئًا جيّدًا

170
00:11:59,480 --> 00:12:01,280
.لا تعامليني كطفلة

171
00:12:02,320 --> 00:12:04,860
.أنتِ طفلة من وجهة نظري

172
00:12:05,200 --> 00:12:07,490
.لا وقت أمامنا لنضيّعه

173
00:12:07,910 --> 00:12:09,540
.لنطارد أدليت

174
00:12:10,500 --> 00:12:13,460
هل أزعجك الأمر عندما أتيتُ على ذكره؟

175
00:12:15,420 --> 00:12:18,250
.أعلم أنّك تفكّرين به

176
00:12:18,800 --> 00:12:20,670
،عندما ساءت الأمور بالنّسبة لكِ

177
00:12:20,670 --> 00:12:23,800
.كان الوحيد الّذي حاول إنقاذك

178
00:12:25,090 --> 00:12:28,010
.لكن لا تشعري بالشّفقة نحوه

179
00:12:28,220 --> 00:12:29,680
.إنّه عدوّ

180
00:12:29,680 --> 00:12:32,270
.بل عدوّ منحطّ وجبان

181
00:12:34,440 --> 00:12:35,770
.لا تقلقي

182
00:12:36,310 --> 00:12:39,070
.أنا أحتقره كلّ الاحتقار

183
00:12:39,650 --> 00:12:41,070
.هذا صحيح

184
00:12:41,570 --> 00:12:43,190
.بمجرّد أن تعثري عليه، اقتليه

185
00:12:43,700 --> 00:12:46,820
.اقتليه مهما كان يا فلايمي

186
00:12:50,410 --> 00:12:53,830
.هذه هي نهاية الطّريق المؤدّية لأرض الشّياطين العاوية

187
00:12:54,250 --> 00:12:55,830
.إنّها بعدها مباشرة

188
00:12:56,370 --> 00:13:00,130
...هنا كان من المفترض أن يتقابل الشّجعان

189
00:13:01,210 --> 00:13:02,380
.لا فائدة

190
00:13:02,840 --> 00:13:06,130
.كان هانز-سان برفقة مورا-سانا هنا بكلّ تأكيد

191
00:13:06,130 --> 00:13:08,140
.هذا كلّ ما عرفناه

192
00:13:09,140 --> 00:13:13,220
كنتُ واثقة أنّ هانز-سان كان ليتلقّى
.معلومات من الكيوما هنا

193
00:13:13,730 --> 00:13:14,390
.أيّتها الأميرة

194
00:13:14,850 --> 00:13:16,310
ما العمل؟

195
00:13:16,600 --> 00:13:19,940
!قد يُقتل في أيّة لحظة

196
00:13:20,270 --> 00:13:21,900
.أدليت هو عدوّنا

197
00:13:22,190 --> 00:13:24,990
!لن يتغيّر ذلك مهما قلتِ

198
00:13:24,990 --> 00:13:26,280
!توقّف

199
00:13:26,650 --> 00:13:28,450
،إن كنتَ لا تثق بي

200
00:13:28,450 --> 00:13:30,780
!اذهب لمطاردته بمفردك

201
00:13:33,200 --> 00:13:35,960
.أنا آسفة. كان ذلك مبالغًا فيه

202
00:13:37,580 --> 00:13:38,920
.لا أصدّق هذا

203
00:13:39,330 --> 00:13:42,340
.لم أفكّر يومًا أنّنا قد نصرخ في وجه بعضينا

204
00:13:42,340 --> 00:13:43,130
...أيّتها الأميرة

205
00:13:44,010 --> 00:13:47,930
،لماذا تصدّقين أدليت بدلاً عنّي
وأنا الّذي خدمتُك لفترة طويلة؟

206
00:13:48,180 --> 00:13:49,300
ما الّذي تعنيه؟

207
00:13:49,590 --> 00:13:53,180
!لطالما كنتِ مستقلّة بنفسك وأكثر هدوءًا من هذا

208
00:13:53,720 --> 00:13:56,100
ما الّذي يعنيه لكِ؟

209
00:13:56,600 --> 00:13:58,690
.لقد سافرتِ معه لبضعة أيّام فحسب

210
00:13:59,480 --> 00:14:01,440
!لماذا تهتمّين لأمره لهذا الحدّ؟

211
00:14:02,190 --> 00:14:04,440
وما الّذي حدث لك؟

212
00:14:05,900 --> 00:14:06,950
...أنا

213
00:14:07,570 --> 00:14:10,820
،بدأت معركة لإنقاذ العالم

214
00:14:10,820 --> 00:14:13,490
.وحياة زميل لنا في خطر

215
00:14:13,870 --> 00:14:16,580
.بالطّبع لا أستطيع التّصرّف كما أتصرّف في العادة

216
00:14:16,910 --> 00:14:17,460
...لكن

217
00:14:17,750 --> 00:14:19,670
.أدليت سان هو زميل لنا

218
00:14:19,670 --> 00:14:21,710
ماذا أيضًا قد يكون في رأيك؟

219
00:14:23,590 --> 00:14:27,840
.غولدوف، عرفتُ لوقت طويل حقيقة شعورك

220
00:14:28,300 --> 00:14:30,470
.لكنّ هذا ليس الوقت المناسب

221
00:14:31,340 --> 00:14:34,100
.لا وقت لي لأتعامل مع غيرتك

222
00:14:34,970 --> 00:14:37,980
.معك حقّ... لم يكن تفكيري صائبًا

223
00:14:38,520 --> 00:14:41,020
.سأنسى ما حدث هنا الآن

224
00:14:43,270 --> 00:14:44,480
.تحت أمرك

225
00:14:44,730 --> 00:14:48,070
.أنت في السّادسة عشر. لا تزال صغيرًا

226
00:14:48,400 --> 00:14:51,490
...أنت شخص يمكن الاعتماد عليه، لقد نسيت

227
00:14:52,200 --> 00:14:53,280
أظنّ أنّنا

228
00:14:53,620 --> 00:14:56,410
.لم نفهم بعضنا بعضًا كما كنّا نظنّ

229
00:15:09,670 --> 00:15:12,050
.عرفتُ ذلك. لا طريقة للدّخول

230
00:15:12,930 --> 00:15:14,640
.لديك الكثير من الأغراض هناك

231
00:15:14,640 --> 00:15:17,140
هل يمكن لإحداها أن تكتشف كذب أحدهم؟

232
00:15:17,520 --> 00:15:20,100
.إنّها جمعيها بغرض مقاتلة الكيوما

233
00:15:21,350 --> 00:15:23,730
،إن لم تكن السّابع

234
00:15:23,730 --> 00:15:27,150
.فذلك يعني أنّ هنالك من دخل المعبد قبلك

235
00:15:27,610 --> 00:15:30,950
.لكنّ الختم مثاليّ. لا يوجد مدخل آخر

236
00:15:30,950 --> 00:15:32,660
لذلك ما الّذي حدث؟

237
00:15:32,660 --> 00:15:34,570
.كان هذا من صنيع قدّيسة ما

238
00:15:35,280 --> 00:15:38,160
قالت مورا أنّ ذلك غير وارد، صحيح؟

239
00:15:38,620 --> 00:15:41,410
.قد لا تكون مورا على علم بتلك القدرة

240
00:15:41,750 --> 00:15:44,210
.من المحتمل أنّ الجاني قد أخفى بعضًا من قدراته أيضًا

241
00:15:44,540 --> 00:15:48,250
...صحيح. ممّا يعني أنّنا عالقون

242
00:15:48,840 --> 00:15:51,930
،أخبرني، إذا ما قُتلتُ

243
00:15:52,430 --> 00:15:54,720
من في رأيك سيكون المشتبه به التّالي؟

244
00:15:55,260 --> 00:15:57,510
.فلايمي بكلّ تأكيد

245
00:15:58,470 --> 00:16:00,430
.أجل، أنا واثق من ذلك

246
00:16:07,900 --> 00:16:09,230
ما الّذي تفعله؟

247
00:16:09,730 --> 00:16:10,650
.لا شيء

248
00:16:14,530 --> 00:16:16,160
أعاد أحدهم؟

249
00:16:23,960 --> 00:16:25,420
هل تخيّلتُ ذلك فحسب؟

250
00:16:25,420 --> 00:16:26,330
.نعم

251
00:16:26,670 --> 00:16:29,960
...لكن قد يعود أحدهم قريبًا

252
00:16:30,630 --> 00:16:33,970
أجل، هل نتوقّف عن هذا ونبحث عن الثّامن؟

253
00:16:33,970 --> 00:16:35,300
...بالمناسبة

254
00:16:36,180 --> 00:16:39,310
كيف يتمّ تشغيل الحاجز بالضّبط؟

255
00:16:39,600 --> 00:16:42,730
.لم أذهب إلى الحصن، لذلك لا أعرف كيف

256
00:16:43,060 --> 00:16:46,150
لم تخبرك مورا بالطّريقة؟
...الحاجز

257
00:16:48,060 --> 00:16:49,400
هل من خطب؟

258
00:16:50,940 --> 00:16:53,150
كيف يمكن تشغيل الحاجز؟

259
00:16:54,990 --> 00:16:55,990
.هذا صحيح

260
00:16:55,990 --> 00:16:58,570
،أولئك الّذين يعرفون الطّريقة هم أنا وفلايمي

261
00:16:58,570 --> 00:17:01,620
.وغولدوف وناشيتانيا ومورا

262
00:17:01,910 --> 00:17:04,500
...الوحيدان اللّذان لا يعرفان هما أنت يا هانز

263
00:17:05,830 --> 00:17:06,750
!وتشامو

264
00:17:06,960 --> 00:17:08,130
هل هي السّابع؟

265
00:17:08,130 --> 00:17:08,960
...كلاّ

266
00:17:08,960 --> 00:17:10,880
.أريد أن أطرح عليها سؤالاً

267
00:17:11,210 --> 00:17:12,510
أين هي؟

268
00:17:12,510 --> 00:17:15,510
.عليها أن تكون في مكان ما  تلعب

269
00:17:15,760 --> 00:17:17,470
.لن يكون من المناسب أن أذهب أنا

270
00:17:17,470 --> 00:17:18,640
.اذهب أنت

271
00:17:18,640 --> 00:17:20,970
وما السّؤال الّذي تريد طرحه عليها؟

272
00:17:21,510 --> 00:17:22,350
...حسنًا

273
00:17:26,100 --> 00:17:27,400
ماذا هنالك؟

274
00:17:32,230 --> 00:17:34,240
...لا يوجد هنا ما قد يساعد

275
00:17:35,740 --> 00:17:36,900
قد يكون من الأفضل

276
00:17:36,900 --> 00:17:40,200
.أن نعثر على أدليت-سان ونحميه

277
00:17:40,490 --> 00:17:41,160
.أيّتها الأميرة

278
00:17:41,950 --> 00:17:44,500
لماذا شككتِ بأمر هانز؟

279
00:17:45,960 --> 00:17:48,500
.لم يكن تفكير صائبًا حينها أيضًا

280
00:17:49,290 --> 00:17:52,000
.لم أخبرك بالجزء الأهم

281
00:17:52,800 --> 00:17:55,920
.هنالك شيء واحد لا أستطيع إخراجه من تفكيري

282
00:18:01,050 --> 00:18:02,720
.تشامو موجودة هنا

283
00:18:03,600 --> 00:18:06,810
أيّها القطّ-سان، أليس هو المزيّف؟

284
00:18:07,770 --> 00:18:09,810
لماذا تتحدّث إليه؟

285
00:18:09,810 --> 00:18:12,190
!لا تهاجميه يا تشامو !كلاّ

286
00:18:12,190 --> 00:18:14,320
...اكتشفتُ أنّه ليس العدوّ

287
00:18:14,320 --> 00:18:16,570
غريب. كيف؟

288
00:18:17,030 --> 00:18:18,150
...حسنًا

289
00:18:18,150 --> 00:18:19,660
.لستَ بحاجة لتخبرني

290
00:18:19,660 --> 00:18:21,620
.فذلك لا يهمّ

291
00:18:21,950 --> 00:18:24,330
.أصاب الملل تشامو من بقائها هنا

292
00:18:24,870 --> 00:18:27,910
.البقاء وحيدة مملّة، ولا يوجد ما ألعب به

293
00:18:28,210 --> 00:18:30,580
.أريد الذّهاب لهزيمة إله الشّر بسرعة

294
00:18:32,380 --> 00:18:34,710
.فهمت. وأنا أيضًا

295
00:18:34,710 --> 00:18:36,340
.لذلك هنالك ما أريد أن أسألكِ إيّاه

296
00:18:37,130 --> 00:18:39,550
شيء مهمّ للغاية

297
00:18:39,550 --> 00:18:41,590
.سيساعدنا على معرفة هويّة السّابع

298
00:18:41,590 --> 00:18:44,350
...ما عدتُ أريد التّحدّث عن ذلك

299
00:18:44,350 --> 00:18:46,850
من يأبه من هو المزيّف ومن هو الحقيقيّ؟

300
00:18:48,680 --> 00:18:52,110
...أنت أوّلاً يا أدليت

301
00:18:53,860 --> 00:18:55,860
.إن لم يكن أنت، فستكون فلايمي

302
00:18:56,110 --> 00:18:58,110
.وإن لم تكن هي، فسيكون القطّ-سان

303
00:18:58,110 --> 00:19:01,110
.وإن لم يكن هو، فستكون الأميرة ومن ثمّ الرجل الضّخم

304
00:19:01,910 --> 00:19:04,830
،لا يمكن أن يكون المزيّف هو مورا أوبا-تشان بالطّبع

305
00:19:04,830 --> 00:19:06,950
.لذلك لن أقتلها

306
00:19:06,950 --> 00:19:09,250
مهلاً يا تشامو. ما الّذي تقولينه؟

307
00:19:09,540 --> 00:19:12,130
.أنا واثقة أنّي سأكتشف العدوّ إن قتلتُ الجميع

308
00:19:12,130 --> 00:19:15,420
!تستطيع تشامو الاهتمام بأمر إله الشّرّ بمفردها

309
00:19:28,220 --> 00:19:30,140
!كلاّ! كلاّ، كلاّ

310
00:19:32,520 --> 00:19:33,980
ما هذا؟

311
00:19:50,450 --> 00:19:51,710
.مستحيل

312
00:19:52,500 --> 00:19:53,580
إنّها كيوما؟

313
00:19:56,420 --> 00:19:57,920
.سأخبركما بما يجري

314
00:19:59,380 --> 00:20:02,260
.هنالك مستنقع داخل معدة تشامو

315
00:20:02,630 --> 00:20:06,260
كلّ الأشياء الّتي أكلتها تشامو في السّابق

316
00:20:06,260 --> 00:20:08,680
!تعيش بسعادة هناك

317
00:20:09,680 --> 00:20:10,680
!نالي منهما

318
00:20:14,650 --> 00:20:15,900
!اهرب

319
00:20:16,190 --> 00:20:17,320
!موافق

320
00:20:22,150 --> 00:20:23,530
!لا مهرب عبر الغابة أيضًا

321
00:20:26,490 --> 00:20:28,240
!لنحتمي بين أعمد الملح

322
00:20:35,290 --> 00:20:36,710
!الحاجز لا يجدي نفعًا معها

323
00:20:37,210 --> 00:20:38,000
!سُحقًا

324
00:20:38,000 --> 00:20:41,920
،لقد أمضت الكثير من الوقت داخل معدة قدّيسة
لذلك تعاملها الأعمدة على أنّها قدّيسات؟

325
00:20:43,630 --> 00:20:46,840
!سوف أشتكي لقدّيسة الملح في وقت لاحق

326
00:20:55,190 --> 00:20:56,810
ما هذا؟

327
00:20:58,060 --> 00:21:00,270
إنّها تعيد تجديد نفسها في الحال؟

328
00:21:02,780 --> 00:21:05,280
!سُحقًا! لا عجب أنّ فلايمي هربت

329
00:21:10,410 --> 00:21:11,790
!كلاّ

330
00:21:12,580 --> 00:21:14,040
ما الّذي تفعلينه يا تشامو؟

331
00:21:14,040 --> 00:21:15,670
!لماذا تهاجمين هانز أيضًا؟

332
00:21:15,670 --> 00:21:17,710
ذلك لا يهمّ، صحيح؟

333
00:21:18,880 --> 00:21:22,000
.لا يوجد دليل يثبت أنّ القطّ-سان ليس مزيّفًا أيضًا

334
00:21:22,920 --> 00:21:24,550
بماذا تفكّرين؟

335
00:21:24,880 --> 00:21:27,930
!لدى تشامو فكرة ممتازة
...أيّها القطّ-سان

336
00:21:28,340 --> 00:21:30,140
.اقتل أدليت

337
00:21:30,140 --> 00:21:33,680
.إن تمّ إبطال الحاجز، فلن أقتلك

338
00:21:35,180 --> 00:21:37,850
.لا تقلق. لن أفعل ذلك

339
00:21:43,820 --> 00:21:44,570
،هانز

340
00:21:44,900 --> 00:21:47,780
.إن دنت نهايتنا، اهرب وانجُ بحياتك

341
00:21:47,780 --> 00:21:50,780
.اخرس. لا تُملِ عليّ ما أفعله

342
00:22:00,710 --> 00:22:01,590
!لننطلق

343
00:22:02,040 --> 00:22:03,050
!هيّا

344
00:23:36,010 --> 00:23:38,390
.في الحلقة القادمة: براعم الشّك