1
00:00:05,430 --> 00:00:08,620
حسناً، هل الشّرائط الورقيّة معكم جميعاً؟

2
00:00:08,620 --> 00:00:10,250
!أجل

3
00:00:10,250 --> 00:00:14,620
سوف يُقدّمونها للآلهة في مهرجان تاناباتا

4
00:00:14,620 --> 00:00:17,280
في 7 يوليو من مزار أماغامي

5
00:00:17,280 --> 00:00:21,120
!جميعكم، دوّنوا أمنياتكم وأعطوها لأماغامي

6
00:00:21,810 --> 00:00:26,120
!سوف ننتظر أمنياتكم

7
00:02:00,750 --> 00:02:02,760
هل دوّنت أُمنيتك؟

8
00:02:02,760 --> 00:02:05,400
غزو العالم"؟ هذا سخيف جدّاً"

9
00:02:05,400 --> 00:02:06,760
!أنت كطفل

10
00:02:06,760 --> 00:02:10,620
"اصمت! كتبتَ للتو "أن أصبح ثريّاً بسرعة
!لذا لذا أفضل حالاً منّي

11
00:02:11,120 --> 00:02:14,770
ميكي-تشان، لديك شخص تحبّينه؟ من؟

12
00:02:14,770 --> 00:02:16,650
!مهلاً، لا تنظري

13
00:02:17,690 --> 00:02:20,090
...أتساءل ما الّذي ينبغي أن أدوّنه

14
00:02:20,090 --> 00:02:22,290
ما الّذي تتمنّينه يا أساهي-تشان؟

15
00:02:23,740 --> 00:02:29,030
أنا عذراء مزار. أمنيتي هي
!أن تتحقّق كافّة أمنياتكم

16
00:02:29,920 --> 00:02:34,290
أليست لديكِ مشاكل أكبر لتقلقي
بشأنها يا أساهي أماغامي؟

17
00:02:39,990 --> 00:02:45,500
يجب عليكِ أن تتوسّلي الآلهة لمساعدتكِ في الفوز
بالماراثون التّالي كما تفعلين دوماً

18
00:02:45,500 --> 00:02:48,540
!وإلّا ستخسرين أمامي

19
00:02:48,540 --> 00:02:53,110
تتمتّعين بروح تنافسيّة... هل تحبّينني
إلى هذه الدّرجة؟

20
00:02:53,110 --> 00:02:54,200
!لستُ كذلك

21
00:02:54,200 --> 00:02:56,470
لديكِ جانب ظريف

22
00:02:55,610 --> 00:02:57,850
...ها هما من جديد

23
00:02:56,470 --> 00:03:00,440
!لماذا تضحكين؟ ستندمين على ذلك قريباً

24
00:02:57,850 --> 00:03:01,450
حسناً، إنّهما الرّياضيّتان النّجمتان لفريق
السّباق ومُنافستان أيضاً

25
00:03:00,440 --> 00:03:03,320
!تعلمين بأنّكِ تحبّينني

26
00:03:02,070 --> 00:03:05,660
ماذا دوّنتِ في أمنيتكِ يا كارين-تشان؟

27
00:03:05,660 --> 00:03:06,760
أنا؟

28
00:03:07,150 --> 00:03:08,660
!يراودني فضول أيضاً

29
00:03:08,950 --> 00:03:11,440
،تدير عائلتك مجموعة ماتسوغازاكي

30
00:03:11,440 --> 00:03:14,660
!وأمّكِ عارضة أزياء سابقة جميلة جدّاً

31
00:03:14,660 --> 00:03:17,500
!وأنتِ نجمة رياضيّة ذات علامات جيّدة أيضاً

32
00:03:17,500 --> 00:03:19,820
ما الّذي بقي لكِ لتتمنّيه؟

33
00:03:20,730 --> 00:03:24,550
!حُبّ الآلهة لي مُخيف حقّاً

34
00:03:25,770 --> 00:03:26,590
!تمنّيتُ هذا

35
00:03:28,560 --> 00:03:31,810
حسناً، هذه أمنية واضحة

36
00:03:31,810 --> 00:03:34,300
!ليست أمنية! هذا تصريح

37
00:03:34,300 --> 00:03:38,660
هذه المرّة، سأحرص على أن
تتجرّعي طعم الهزيمة

38
00:03:38,860 --> 00:03:41,630
الماراثون بعد يومين، صحيح؟

39
00:03:41,630 --> 00:03:45,600
هل لديك الوقت للذّهاب يا أساهي-تشان
مع اقتراب مهرجان تاناباتا؟

40
00:03:46,300 --> 00:03:48,240
!ستكون الأمور على ما يُرام

41
00:03:48,240 --> 00:03:52,170
،سيكون من السّهل بالنّسبة لي أنا
!مُديرة التّسويق، أن أتكفّل بهما معاً

42
00:03:52,740 --> 00:03:56,360
—والأهمّ من أيّ شيء، لا يمكنني الخسارة

43
00:03:56,360 --> 00:03:59,220
لأجل عائلتي الّتي تدعمني

44
00:04:04,890 --> 00:04:06,940
!سأكون أنا من يربح

45
00:04:07,140 --> 00:04:11,060
ماذا؟ هل نسيتِ الوقت الّذي أحرزتِه
في مُشاركتكِ السّابقة بالفعل؟

46
00:04:11,240 --> 00:04:15,160
!كنتُ... أمرّ بيوم سيّئ فحسب

47
00:04:15,160 --> 00:04:17,470
سأحرص على أن أكون جاهزة
!فعليّاً هذه المرّة

48
00:04:18,420 --> 00:04:20,680
!سأكون في الانتظار

49
00:04:30,930 --> 00:04:33,960
!يبدو وكأنّه اقترب فعلاً

50
00:04:35,550 --> 00:04:37,460
ها أنا ذا

51
00:04:37,730 --> 00:04:41,260
آسفة لأنّني طلبتُ منك المساعدة أيضاً

52
00:04:41,260 --> 00:04:42,750
لا عليكِ

53
00:04:43,950 --> 00:04:46,440
،تاناباتا هو حدث ليوم واحد فقط

54
00:04:46,440 --> 00:04:49,900
لكن التّجهيز له شاقّ جدّاً

55
00:04:49,900 --> 00:04:52,190
!هذا لأنّه يوم واحد فقط

56
00:04:52,610 --> 00:04:56,400
في تاناباتا، جميعنا نتذكّر أسطورة
!أوريهيمي وهيكوبوشي

57
00:04:56,400 --> 00:05:00,440
ونتمنّى من الآلهة أمنية نريد
تحقيقها مهما كلّف الأمر

58
00:05:01,240 --> 00:05:05,030
في هذا العام، سوف أذكر أمنيتي

59
00:05:05,030 --> 00:05:09,480
وهي أن يلتمّ شمل كافّة الأحبّة
...الّذين تفرّقوا

60
00:05:09,480 --> 00:05:10,920
ماذا أصابها؟

61
00:05:10,920 --> 00:05:15,160
كانت يو-تشان تشاهد الكثير من البرامج
التّلفزيونيّة عن العلاقات طويلة المدى

62
00:05:15,460 --> 00:05:16,810
هكذا إذاً

63
00:05:17,780 --> 00:05:19,770
ما هي أمنيتكِ؟

64
00:05:19,770 --> 00:05:21,040
أنا؟

65
00:05:23,650 --> 00:05:24,920
!هذا سرّ

66
00:05:30,470 --> 00:05:33,430
أنتما رومانسيّان فعلاً، أليس كذلك؟

67
00:05:33,430 --> 00:05:35,900
!أساهي! عدتِ

68
00:05:35,900 --> 00:05:38,320
هل دوّنتِ أمنيتكِ حقّاً يا آسا-تشان؟

69
00:05:38,320 --> 00:05:39,570
!بالطّبع

70
00:05:39,810 --> 00:05:41,860
!دوّنتُها كلّها هنا

71
00:05:41,860 --> 00:05:43,660
أصبحتِ جشعة

72
00:05:44,170 --> 00:05:47,400
،إذا كنتِ جشعة إلى هذا الحدّ
فلن تتحقّق أي أمنية من أمنياتكِ

73
00:05:47,400 --> 00:05:49,870
أولئك الّذين يُطاردون أرنبين"
لن يصطادوا كليهما" حسبما يُقال

74
00:05:49,870 --> 00:05:53,460
وأنت واقعيّ زيادة عن اللّزوم

75
00:05:53,460 --> 00:05:54,880
بالمناسبة

76
00:05:54,880 --> 00:05:57,490
...أساهي، بخصوص الماراثون بعد يومين

77
00:05:57,490 --> 00:05:58,460
ماذا؟

78
00:05:58,740 --> 00:06:01,650
!سوف نحضر من أجل تشجيعكِ

79
00:06:01,650 --> 00:06:03,740
!سيُقام في ناغانو

80
00:06:03,740 --> 00:06:05,170
!ليس عليكما قطع كلّ هذه المسافة

81
00:06:05,170 --> 00:06:07,820
!لا مُشكلة إطلاقاً

82
00:06:07,820 --> 00:06:12,810
!نريد أن نراكِ تعملين بجدّ عن كثب

83
00:06:12,810 --> 00:06:16,310
!ويقول أوريو-كن بأنّه سيأتي أيضاً

84
00:06:16,600 --> 00:06:18,160
...أوريو-سان

85
00:06:19,110 --> 00:06:23,460
تريد رؤيتي بزيّ السّباق وبطني مكشوف؟

86
00:06:23,460 --> 00:06:26,420
!أنت حقّاً مُنحرف بالسرّ

87
00:06:26,420 --> 00:06:28,330
!كفاكِ عبثاً وإلّا بقيتُ في المنزل

88
00:06:28,850 --> 00:06:31,140
!أمزح فحسب

89
00:06:31,140 --> 00:06:33,940
!لكن شكراً لك من القلب حقّاً

90
00:06:33,940 --> 00:06:35,930
!حظّاً سعيداً يا آسا-تشان

91
00:06:35,930 --> 00:06:37,230
!سنشجّعكِ

92
00:06:37,230 --> 00:06:38,040
!حسناً

93
00:06:41,680 --> 00:06:44,580
!فهمت... أوريو-سان قادم أيضاً

94
00:06:49,010 --> 00:06:51,210
تمّ تأجيله؟

95
00:06:51,210 --> 00:06:54,940
أجل. يؤسفني قول هذا بعد
تمرينكن بجدّ للتّحضير

96
00:06:54,940 --> 00:07:00,570
لكن ثمّة عاصفة قادمة، لذا سوف يُؤجّل
حتّى 7 يوليو، الأسبوع بعد القادم

97
00:07:02,610 --> 00:07:05,820
من النّاحية الأخرى، يمنحنا هذا
!وقتاً أطول للتّمرين

98
00:07:06,080 --> 00:07:07,910
!لنستفد من هذا الأسبوع الإضافيّ

99
00:07:08,120 --> 00:07:09,080
!حاضر

100
00:07:09,080 --> 00:07:09,780
انصراف

101
00:07:11,830 --> 00:07:15,190
ماذا؟ 7 يوليو؟

102
00:07:15,190 --> 00:07:18,580
أليس هذا يوم مهرجان تاناباتا؟

103
00:07:19,620 --> 00:07:21,820
لكن هذا جيّد لأجلكِ، صحيح؟

104
00:07:21,820 --> 00:07:23,790
،إذا ركّزتِ على التّحضير للمهرجان

105
00:07:23,790 --> 00:07:26,820
فسيكون لديكِ عذر لخسارتكِ أمامي

106
00:07:28,510 --> 00:07:32,210
مُحال أن أقصّر في بذل قصارى
!جهدي في هذا الأمر

107
00:07:35,710 --> 00:07:39,550
...كارين-تشان، ليس عليكِ أن تكوني لئيمة هكذا

108
00:07:41,340 --> 00:07:45,470
لن أدعكِ تهدرين الوقت على أيّ شيء
!آخر يا أساهي أماغامي

109
00:07:48,320 --> 00:07:52,030
هكذا إذاً... تمّ تأجيله؟

110
00:07:52,030 --> 00:07:56,770
آسفة... أعلم بأنّكما كنتُما تستعدّان للذّهاب

111
00:07:56,770 --> 00:08:00,980
لا، أنا الآسفة. أردنا أن نكون
...بجانبكِ من أجل دعمكِ، لكن

112
00:08:00,980 --> 00:08:06,290
لكن لا يمكننا الاستمرار إذا كان
في يوم تاناباتا

113
00:08:08,030 --> 00:08:12,580
سينتهي الماراثون مع نهاية وقت
المهرجان، أليس كذلك؟

114
00:08:12,580 --> 00:08:14,830
أجل... أنا آسفة

115
00:08:14,830 --> 00:08:19,440
هذا مؤسف بعض الشّيء. أردتُ أن نكون
نحن الثّلاثة هنا لإنجاح المهرجان

116
00:08:21,020 --> 00:08:23,350
!أنتما لا تتّخذان هذا الأمر بجدّية

117
00:08:23,690 --> 00:08:25,810
!كلّ ما تفكّران فيه هو أنا

118
00:08:25,810 --> 00:08:28,310
!يجب عليكما التّفكير في مهرجان تاناباتا

119
00:08:28,850 --> 00:08:34,830
نحن عذراوات المزار يجب علينا تقديم
!صلواتنا وذلك كي تتحقّق أُمنيات الجميع

120
00:08:35,080 --> 00:08:38,760
!إن لم تعملا، فلن تبلغ الصّلوات الآلهة

121
00:08:39,360 --> 00:08:40,850
...لـ-لكن

122
00:08:40,850 --> 00:08:44,960
!لا تقلقا! سأعود منتصرة

123
00:08:45,190 --> 00:08:48,710
،احرصا على نجاح مهرجان تاناباتا
!لأجلي أيضاً

124
00:08:52,190 --> 00:08:54,660
!هذه هي أمنيتي في نهاية المطاف

125
00:08:56,250 --> 00:08:58,740
!حسناً، سأذهب للجري أكثر قليلاً

126
00:09:03,830 --> 00:09:07,250
...أختنا الصّغيرة قوية حقّاً

127
00:09:07,250 --> 00:09:10,740
لكن هل ستكون آسا-تشان بخير؟

128
00:09:11,170 --> 00:09:15,700
إن كان لديكما الوقت للقلق، ألا يجدر
بكما أن تقضياه على فعل ما قالته؟

129
00:09:15,700 --> 00:09:17,050
...لكن

130
00:09:17,050 --> 00:09:17,980
لا تقلقا

131
00:09:21,450 --> 00:09:23,100
!دعا الأمر لي

132
00:09:25,060 --> 00:09:27,180
!سيحين يوم غد أخيراً

133
00:09:27,620 --> 00:09:32,890
!كلتاكما، استمتعا في مهرجان تاناباتا لأجلي

134
00:09:32,890 --> 00:09:35,090
!أجل! دعي الأمر لي

135
00:09:35,410 --> 00:09:37,830
لكن أغار منكِ يا آسا-تشان

136
00:09:37,830 --> 00:09:38,340
ماذا؟

137
00:09:38,970 --> 00:09:41,850
سيبقى أوريو-كن معكِ لوحدكِ

138
00:09:43,010 --> 00:09:44,890
أحسنتِ صنعاً اليوم

139
00:09:44,890 --> 00:09:50,030
حـ-حسناً، مع ذلك من المؤسف
!أنّه الوحيد الّذي سيذهب

140
00:09:50,030 --> 00:09:52,370
لكن تبدين سعيدة جدّاً بشأن ذلك

141
00:09:52,890 --> 00:09:54,890
أين هو على أيّ حال؟

142
00:09:54,890 --> 00:09:58,740
غادر بالفعل. قال بأنّ هناك
مكاناً يريد زيارته

143
00:10:02,620 --> 00:10:04,310
ما الأمر يا آسا-تشان؟

144
00:10:04,310 --> 00:10:06,400
!لـ-لا شيء

145
00:10:06,400 --> 00:10:08,690
!حسناً، سأغادر

146
00:10:08,690 --> 00:10:10,600
!وداعاً

147
00:10:13,630 --> 00:10:16,590
!حسناً، حان وقت الاستعداد للمهرجان

148
00:10:16,590 --> 00:10:18,480
!أجل

149
00:10:18,480 --> 00:10:19,600
!لنبذل قصارى جهدنا

150
00:10:19,600 --> 00:10:20,580
سوف نبدأ من هناك

151
00:10:20,580 --> 00:10:21,260
أجل

152
00:10:29,360 --> 00:10:30,830
!هيّا! هيّا

153
00:10:30,030 --> 00:10:33,000
!يمكنك فعلها

154
00:10:34,650 --> 00:10:37,930
نحن هنا في سباق الماراثون مسافة 10
كيلومتر الوطنيّ للنّساء

155
00:10:38,350 --> 00:10:42,230
قبل لحظات، كانت أماغامي في المُقدِّمة

156
00:10:42,230 --> 00:10:44,100
ما الّذي يجري هنا؟

157
00:10:47,840 --> 00:10:49,150
!اهدئي

158
00:10:49,150 --> 00:10:50,660
!يجب أن تستعيدي وتيرتكِ

159
00:10:50,920 --> 00:10:54,330
!لا يمكنكِ الخسارة هنا

160
00:10:55,030 --> 00:10:57,410
قرّرتِ بأن تتركي المهرجان لهما

161
00:10:57,410 --> 00:11:00,250
وتركّزي على الماراثون، صحيح؟

162
00:11:00,830 --> 00:11:03,560
!كلّ ما عليكِ التّفكير فيه هو النّصر

163
00:11:07,100 --> 00:11:09,810
ماذا تفعلين يا أساهي أماغامي؟

164
00:11:10,030 --> 00:11:12,510
ماذا حدث لثقتكِ المعتادة؟

165
00:11:12,510 --> 00:11:15,830
!على هذا المُعدّل، سأفوز فعلاً

166
00:11:16,320 --> 00:11:19,860
!الشّارع مليء بالمُتفرّجين المُشجّعين

167
00:11:20,320 --> 00:11:22,400
!يمكنكِ فعلها يا كارين-تشان

168
00:11:22,400 --> 00:11:23,570
!مولاتي

169
00:11:23,970 --> 00:11:26,610
هل هذه من عائلة ماتسوغازاكي؟

170
00:11:26,610 --> 00:11:29,490
!إنّهم يهتفون لها بصوتٍ عالٍ

171
00:11:38,050 --> 00:11:39,640
...أوريو-سان

172
00:11:40,600 --> 00:11:42,400
!أساهي-سان

173
00:11:45,090 --> 00:11:48,730
!أساهي-سان، يمكنكِ فعلها

174
00:11:49,030 --> 00:11:50,860
!يـ-يوميكو-سان

175
00:11:51,830 --> 00:11:53,140
هذا صحيح

176
00:11:53,140 --> 00:11:56,230
يتزامن الماراثون مع مهرجان تاناباتا

177
00:11:56,750 --> 00:12:00,360
إذا كان لديك الوقت، هلّا أتيتِ لتشجيعها؟

178
00:12:01,640 --> 00:12:04,100
ما الّذي تقوله حتّى يا أوريو-سان؟

179
00:12:05,000 --> 00:12:07,870
!سأذهب بالطّبع

180
00:12:08,530 --> 00:12:11,890
!هيّا! هيّا يا أساهي-سان

181
00:12:10,640 --> 00:12:13,560
هذا مُبهر! هل هذه عذراء مزار؟

182
00:12:13,560 --> 00:12:15,880
!وكأنّ الآلهة بحدّ ذاتهم يشجّعونها

183
00:12:16,040 --> 00:12:18,790
!أوريو-سان، شجّعها أيضاً

184
00:12:18,790 --> 00:12:20,250
...لا، أنا

185
00:12:23,550 --> 00:12:25,010
!هيّا! بسرعة

186
00:12:28,120 --> 00:12:29,820
!أساهي

187
00:12:32,930 --> 00:12:34,260
!أوريو-سان

188
00:12:34,520 --> 00:12:38,190
!آسف! هذا أقصى ما يمكنني فعله

189
00:12:39,360 --> 00:12:41,960
!يمكنكِ فعلها يا أساهي

190
00:12:43,880 --> 00:12:47,700
!الجميع يصلّي كي تتحقّق أمنيتكِ

191
00:12:50,690 --> 00:12:53,300
...بئساً... أنتم

192
00:12:54,360 --> 00:12:57,460
!تحبّونني حبّاً جمّاً

193
00:13:00,710 --> 00:13:02,960
!هيّا! هيّا

194
00:13:20,060 --> 00:13:22,420
أُغمَى عليها

195
00:13:23,370 --> 00:13:28,250
ربحتْ في الماراثون، ويسرّني بأنّنا
تمكّنّا من اللّقاء بعد نهايه

196
00:13:29,240 --> 00:13:32,120
شكراً على القدوم اليوم

197
00:13:32,120 --> 00:13:34,460
أعلم بأنّكِ مشغولة بتاناباتا

198
00:13:34,700 --> 00:13:36,070
إطلاقاً

199
00:13:36,070 --> 00:13:40,310
يُقام تاناباتا الخاصّ بمزار تسوكيغامي
وفقاً للتّقويم القديم

200
00:13:40,310 --> 00:13:42,940
لذا لسنا مشغولين الآن

201
00:13:42,940 --> 00:13:44,200
التّقويم القديم؟

202
00:13:44,590 --> 00:13:47,070
في الأصل، أكان تاناباتا يُقام

203
00:13:47,070 --> 00:13:50,830
وفقاً للتّقويم اليابانيّ القديم، لذا
كان في منتصف أغسطس

204
00:13:51,130 --> 00:13:55,200
بعض الأماكن ما زالت تُقيمه في ذلك الوقت

205
00:13:58,130 --> 00:14:03,240
يبدو أنّك قصدت ما قلته لي

206
00:14:04,030 --> 00:14:06,190
...ما دمنا عائلة، أنا سوف

207
00:14:06,190 --> 00:14:08,540
أدعم أحلامك...

208
00:14:08,890 --> 00:14:11,500
لا تُقلّدي صوتي من فضلكِ

209
00:14:12,020 --> 00:14:15,200
أنت تُعين هؤلاء الفتيات حقّاً

210
00:14:15,200 --> 00:14:16,860
يسرّني أن أرى ذلك

211
00:14:17,570 --> 00:14:21,500
أنا لا أفعل شيئاً مُميّزاً

212
00:14:26,880 --> 00:14:32,250
كنتُ قلقاً لبُرهة، لكن يبدو أنّ
مهرجان تاناباتا قد نجح

213
00:14:32,250 --> 00:14:34,630
وتحقّق حلمها. أنا سعيد

214
00:14:36,470 --> 00:14:38,590
هل أنت متأكّد من ذلك حقّاً؟

215
00:14:53,300 --> 00:14:57,330
أوريو-سان، شكراً جزيلاً على المجيء اليوم

216
00:14:58,850 --> 00:15:03,050
!بفضلك، تحقّق حلمي

217
00:15:04,150 --> 00:15:05,840
ماذا تقولين؟

218
00:15:06,370 --> 00:15:09,340
أنتِ من حقّق أمنيتكِ بنفسكِ

219
00:15:10,940 --> 00:15:16,730
،وهكذا نجح مهرجان تاناباتا نجاحاً باهراً
وربحت أساهي في الماراثون

220
00:15:16,730 --> 00:15:18,660
...سار كلّ شيء على ما يُرام

221
00:15:22,560 --> 00:15:24,470
أو على الأقلّ، هذا ما اعتقدتُه

222
00:15:32,140 --> 00:15:34,990
الثّامن والعشرون من يونيو؟

223
00:15:39,730 --> 00:15:41,260
...وهذا أيضاً

224
00:15:41,890 --> 00:15:43,090
وهذا أيضاً؟

225
00:15:43,090 --> 00:15:45,810
إنّه 28 يونيو فعلاً؟

226
00:15:45,810 --> 00:15:48,750
ما المشكلة؟ ما الّذي يجري؟

227
00:15:51,490 --> 00:15:52,930
اهدأ

228
00:15:52,930 --> 00:15:55,490
ابقَ هادئاً وفكّر في الأمر مليّاً

229
00:15:56,210 --> 00:15:58,400
كان 7 يوليو في الأمس

230
00:15:58,400 --> 00:16:00,670
ما يعني بأنّه ينبغي أن يكون 8 يوليو اليوم

231
00:16:01,110 --> 00:16:02,670
فلماذا إذاً؟

232
00:16:05,200 --> 00:16:10,660
هل مررتُ بظاهرة خارقة ما ثانية؟

233
00:16:11,020 --> 00:16:13,620
هل كانت كلّ ذكرياتي حتّى الأمس محض حلم؟

234
00:16:13,940 --> 00:16:15,320
...أم

235
00:16:20,610 --> 00:16:24,250
آسفة لأنّني طلبتُ منك المساعدة أيضاً

236
00:16:24,250 --> 00:16:26,460
...لـ-لا عليكِ

237
00:16:26,930 --> 00:16:31,580
يبدو أنّهن لا يُدرِكن ما حدث

238
00:16:31,950 --> 00:16:35,380
هل أنا الوحيد الّذي عاد إلى 8 يونيو؟

239
00:16:36,410 --> 00:16:38,430
لا، أنا أبالغ في التّفكير

240
00:16:37,320 --> 00:16:40,090
ما حدث لأوريهيمي وهيكوبوشي
...كان مُحزناً جدّاً

241
00:16:38,430 --> 00:16:41,720
أنا أمرّ بحالة ديجافو قويّة جدّاً فحسب

242
00:16:40,090 --> 00:16:41,680
بالفعل

243
00:16:41,680 --> 00:16:43,890
!عـ-عدت

244
00:16:44,310 --> 00:16:45,050
ماذا؟

245
00:16:45,050 --> 00:16:46,210
!أهلاً بعودتكِ

246
00:16:46,210 --> 00:16:47,660
أتيتِ باكراً اليوم

247
00:16:47,660 --> 00:16:49,300
ماذا عن التّمرين؟

248
00:16:51,560 --> 00:16:55,610
!شـ-شعرتُ بدُوار بسيط، لذا غادرتُ باكراً

249
00:16:55,880 --> 00:16:57,680
هل أنتِ بخير؟

250
00:16:57,680 --> 00:17:00,320
!اقترب الماراثون، لذا اعتني بنفسكِ

251
00:16:58,600 --> 00:17:00,320
!هناك أحد آخر يتذكّر

252
00:17:03,170 --> 00:17:07,110
إذاً احتفظتِ بذاكرتكِ عمّا حدث
حتّى 7 يوليو أيضاً؟

253
00:17:07,110 --> 00:17:08,630
أنت أيضاً، صحيح؟

254
00:17:08,630 --> 00:17:10,360
تتذكّر، صحيح؟

255
00:17:14,020 --> 00:17:15,650
!يسرّني هذا

256
00:17:15,650 --> 00:17:18,280
!ظننتُ نفسي قد جُننت

257
00:17:18,280 --> 00:17:19,430
!أ-أنتِ

258
00:17:19,430 --> 00:17:21,430
!أ-أنا آسفة

259
00:17:23,420 --> 00:17:27,510
لـ-لكن ما الّذي يجري هنا؟

260
00:17:27,790 --> 00:17:29,780
لا أملك فكرة

261
00:17:29,780 --> 00:17:31,520
ماذا بخصوص الماراثون على أيّ حال؟

262
00:17:31,520 --> 00:17:36,170
الآن ما زال من المُفترَض أن يُقام
في غضون يومين، في 30 يونيو

263
00:17:36,170 --> 00:17:40,030
لكن إذا كرّر التّاريخ نفسه، سوف
يُؤجَّل ثانية، صحيح؟

264
00:17:41,160 --> 00:17:43,880
مذكور هنا أنّ عاصفة مطريّة شديدة
ستهبُّ في ناغانو غداً

265
00:17:44,310 --> 00:17:47,450
لعلّنا عدنا في الوقت أسبوعاً فعلاً

266
00:17:47,450 --> 00:17:48,850
...لا

267
00:17:48,850 --> 00:17:51,540
...وربحتُ الماراثون أيضاً

268
00:17:52,490 --> 00:17:55,060
أعتقد سيترتّب علينا فعل كلّ شيء من جديد

269
00:17:55,060 --> 00:17:56,840
فعل كلّ شيء من جديد"؟"

270
00:17:57,310 --> 00:18:00,680
لنبذل قصارى جهدنا حتّى 7 يوليو

271
00:18:01,070 --> 00:18:04,920
بالنّسبة لكِ، سيكون من السّهل
الفوز ثانية، أليس كذلك؟

272
00:18:06,050 --> 00:18:09,360
إن كان هذا ما تقوله، فأعتقد
يترتّب عليّ ذلك، صحيح؟

273
00:18:34,080 --> 00:18:35,250
...هذا سيّئ

274
00:18:35,250 --> 00:18:38,020
!عدنا إلى 28 يونيو من جديد

275
00:18:38,020 --> 00:18:40,600
لـ-لا! لماذا؟

276
00:18:41,970 --> 00:18:45,840
حتّى الآن، أنا الوحيد الّذي كان يتعرّض
لهذه الأشياء الخارقة

277
00:18:46,230 --> 00:18:47,810
...لكن هذه المرّة

278
00:18:49,020 --> 00:18:53,100
من الممكن أن تكوني أنتِ
يا أساهي مفتاح العقدة

279
00:18:53,100 --> 00:18:54,860
أ-أنا؟

280
00:18:55,090 --> 00:18:59,140
ما إن نصل إلى 7 يوليو حتّى
نعود إلى 28 يونيو

281
00:18:59,670 --> 00:19:01,820
والأشياء الوحيدة الّتي تحدث
...خلال تلك الفترة هي

282
00:19:01,820 --> 00:19:05,490
الماراثون وتاناباتا

283
00:19:06,410 --> 00:19:09,780
هذان الحدثان يتمحوران حولكِ بشكل كبير

284
00:19:10,100 --> 00:19:13,180
من المحتمل أن يكون هناك تصرّفاً
يمكنك القيام به

285
00:19:13,180 --> 00:19:15,500
قبل وقوع هذين الحدثين سيحرّرنا من العقدة

286
00:19:17,170 --> 00:19:21,700
ألا يعني هذا أنّني إذا لم أستطع
،معرفة الإجابة الصّحيحة

287
00:19:21,700 --> 00:19:25,150
فلا يمكننا تجاوز 7 يوليو أبداً؟

288
00:19:25,520 --> 00:19:26,900
...آ-آسف

289
00:19:26,900 --> 00:19:29,390
أعلم بأنّ هذا يثقل كاهلكِ، أليس كذلك؟

290
00:19:30,430 --> 00:19:33,330
لا تقلقي! سأفكّر معكِ

291
00:19:33,330 --> 00:19:35,070
...لذا لا تحزني

292
00:19:35,880 --> 00:19:41,000
هذا يعني بأنّ لديّ الفُرصة لتحقيق
!الكثير من الأمنيات

293
00:19:41,000 --> 00:19:43,040
!شكراً لكِ أيّتها الآلهة

294
00:19:43,040 --> 00:19:44,520
!أحسنتِ في رؤية الجانب المشرق

295
00:19:45,420 --> 00:19:49,790
حسناً، حاليّاً، كلّ ما يمكننا فعله هو
تجربة أكبر عدد مُمكن من الطُّرُق

296
00:19:52,270 --> 00:19:59,670
...والآن، شهيق... زفير
ابقي هكذا لـ 30 ثانية

297
00:19:55,830 --> 00:19:57,340
ماذا تفعلين؟

298
00:19:57,340 --> 00:19:59,680
!تمارين لتكبير صدري

299
00:19:59,990 --> 00:20:02,180
لن تنجح بهذه البساطة فحسب

300
00:20:02,180 --> 00:20:05,170
من المهمّ مُمارسة هذه التّمارين بشكل روتينيّ

301
00:20:05,420 --> 00:20:07,130
...لكن

302
00:20:08,190 --> 00:20:13,110
!إذا دلّكتهما لأجلي، فقد يكبران بصورة أسرع

303
00:20:14,550 --> 00:20:16,080
!كفاكِ غباء

304
00:20:24,690 --> 00:20:26,780
تحتاجين للكثير كي تتعلّمي

305
00:20:27,010 --> 00:20:32,780
أريد تعلّم هذا كي أتمكّن من التّحديث في مواقع
التّواصل بشكل أسرع للإعلان عن المزار

306
00:20:37,450 --> 00:20:40,350
هذه أمنية يتمنّاها قدّيس

307
00:20:40,350 --> 00:20:42,790
إنّها مستحيلة غالباً، صحيح؟

308
00:20:42,790 --> 00:20:44,800
ليست كذلك

309
00:20:46,140 --> 00:20:49,400
إذا صلّينا نحن عذراوات المزار بخشوع

310
00:20:49,400 --> 00:20:53,160
،وحرصنا على إيصال الأُمنيات للآلهة
...فأنا متأكّدة

311
00:20:55,890 --> 00:20:57,440
أساهي

312
00:20:57,750 --> 00:21:01,520
ألا تريدين أن تكوني في مهرجان
تاناباتا في الواقع؟

313
00:21:03,430 --> 00:21:04,880
...كيف

314
00:21:04,880 --> 00:21:06,620
يمكنني أن أعرف بمجرّد النّظر إليكِ

315
00:21:06,620 --> 00:21:10,960
أنتِ متحمّسة جدّاً له، لكن ينتهي
الأمر بعدم مشاركتكِ فيه

316
00:21:13,210 --> 00:21:17,630
بما أنّ الفُرصة سنحت لكِ، فما رأيكِ
أن تركّزي على المهرجان هذه المرّة؟

317
00:21:18,070 --> 00:21:20,540
...لكن الماراثون

318
00:21:20,540 --> 00:21:23,210
تُقام سِباقات كثيرة في كلّ عام، صحيح؟

319
00:21:26,890 --> 00:21:28,420
...أريد فعلها

320
00:21:28,730 --> 00:21:32,660
!أريد المُشاركة في مهرجان تاناباتا مع الجميع

321
00:21:34,010 --> 00:21:35,030
هكذا إذاً

322
00:21:35,630 --> 00:21:40,210
حسناً، الأُمنيات الأخرى ستتطلّب
مئات العقد على أيّ حال

323
00:21:41,480 --> 00:21:43,740
هذا قاسٍ

324
00:21:43,740 --> 00:21:48,120
لكن لا أمانع البقاء هكذا فترة أطول

325
00:21:49,090 --> 00:21:53,370
لأنّني الآن أحتكرك لنفسي بالكامل

326
00:21:53,990 --> 00:21:56,320
كفاكِ غباء

327
00:21:56,320 --> 00:21:58,960
أرفض البقاء هكذا للأبد

328
00:21:59,780 --> 00:22:01,800
بالطّبع. أعلم ذلك