00:14:23,670 --> 00:14:27,400
وأنتِ لا تنوين القيام بأيّ عمل شقيّ
في غفلة منّي، أليس كذلك يا أساهي؟

187
00:14:28,200 --> 00:14:32,670
...بـ-بالطّبع... لا

188
00:14:34,120 --> 00:14:37,130
!أنتما، اجلسا هناك

189
00:14:38,120 --> 00:14:42,850
أنتما تتودّدان الجنس الآخر بشكل
!غير ملائم رغم أنّكما عذراء مزار

190
00:14:42,850 --> 00:14:46,050
!يجب أن تبقيا بعيدة عنه عندما تتفاعلان معه

191
00:14:46,050 --> 00:14:47,810
!حسناً

192
00:14:48,030 --> 00:14:53,090
لكن لا أعلم ما إن كان من المناسب
!أن أكون جافّة معه كما أنتِ

193
00:14:53,090 --> 00:14:57,550
!يجب علينا أن نكون ممتنّات له على ما فعله لأجلنا

194
00:14:59,140 --> 00:15:01,250
مُمتنّات؟

195
00:15:03,500 --> 00:15:04,490
تفضّل

196
00:15:06,360 --> 00:15:07,500
ما هذا؟

197
00:15:07,500 --> 00:15:10,330
زيّ رسميّ لمدرستك الجديدة

198
00:15:10,640 --> 00:15:13,440
أُرسِلَ إلى هنا بسبب خطأ
في المُعاملات الورقيّة

199
00:15:13,440 --> 00:15:15,750
تبدأ الاثنين، صحيح؟

200
00:15:15,750 --> 00:15:18,630
...صحيح، ما زلنا في استراحة الرّبيع

201
00:15:18,630 --> 00:15:20,850
أشعر وكأنّني كنتُ هناك فترة أطول بكثير

202
00:15:21,340 --> 00:15:25,360
.لكن لم يكن عليكِ دعوتي للمجيء
كان بوسعكِ إرسالها فحسب

203
00:15:25,630 --> 00:15:30,240
حسناً، أردتُ رؤية وجهك فحسب

204
00:15:30,240 --> 00:15:32,490
أ-أهذا كلّ شيء؟

205
00:15:32,490 --> 00:15:36,520
كالعادة، أنت مُملّ

206
00:15:36,520 --> 00:15:39,660
أم أنّك لم تُرِد رؤية وجهي؟

207
00:15:39,660 --> 00:15:41,620
...ليس هذا ما قصدت

208
00:15:41,970 --> 00:15:46,260
حسناً، كيف هي الحياة مع عذراوات
المزار الظّريفات؟

209
00:15:46,260 --> 00:15:48,520
إنّها صعبة

210
00:15:48,960 --> 00:15:55,240
الكبرى غبيّة كسولة، لذا يترتّب عليّ
إيقاظها وتنظيف غرفتها

211
00:15:55,960 --> 00:15:58,850
والثّانية مُجِدّة في العمل، لكنّها عنيدة وبطيئة

212
00:15:58,850 --> 00:16:02,560
،إذا تركتُها تفعل شيئاً، فلا تنتهي أبداً
لذا أضطرّ للقيام به بنفسي

213
00:16:03,020 --> 00:16:06,290
والصّغرى خرقاء ولا تُجيد فعل شيء بيديها

214
00:16:06,290 --> 00:16:08,960
لا أتحمّل رؤيتها، لذا أضطرّ لفعلها أنا

215
00:16:09,960 --> 00:16:13,650
أولئك الأخوات الثّلاثة شقيّات

216
00:16:15,860 --> 00:16:18,020
أوريو

217
00:16:18,020 --> 00:16:19,980
...هل أنت

218
00:16:20,280 --> 00:16:24,500
تغترّ بنفسك وتعتقد بأنّهن لا يستطعن
العيش من دون مساعدتك؟

219
00:16:25,250 --> 00:16:28,070
،ربّما تعتقد بأنّك رهيب لأنّك أنقذت المزار

220
00:16:28,070 --> 00:16:30,660
لكن ألم يخطر في ذهنك من قبل
بأنّه لا شأن لك

221
00:16:30,660 --> 00:16:32,430
بمشاكل عائلة أخرى؟

222
00:16:32,430 --> 00:16:36,260
الرّغبة في المساعدة لطيفة، لكن ألم تكن
تفعلها لأجل إرضاء أنانيّتك؟

223
00:16:39,380 --> 00:16:41,380
!أوريو

224
00:16:40,530 --> 00:16:41,380
!مؤلم

225
00:16:41,380 --> 00:16:43,390
عاملهن بتكافؤ

226
00:16:43,390 --> 00:16:45,650
...هذا ما هو سيّئ فيك

227
00:16:47,270 --> 00:16:49,050
وما هو جيّد فيك

228
00:16:49,830 --> 00:16:52,930
ستتخرّج من جامعة كيوتو وتصبح طبيباً، صحيح؟

229
00:16:52,930 --> 00:16:56,440
لذا عليك أن تبقى مُركِّزاً

230
00:16:59,100 --> 00:17:02,410
أجِّل التدخُّل لأجل شخص تريد مساعدته حقّاً

231
00:17:02,410 --> 00:17:05,020
شخص تهتمّ له

232
00:17:07,490 --> 00:17:08,950
أجل

233
00:17:08,950 --> 00:17:11,590
لديّ أمور أحتاج لفعلها أيضاً

234
00:17:12,220 --> 00:17:14,790
يجب أن أبقيهن مُشتّتات عن مشروع الزّواج هذا

235
00:17:14,790 --> 00:17:18,660
وأترك مسافة أطول بيني وبين ثلاثتهن

236
00:17:21,150 --> 00:17:22,670
!سوف أفعلها

237
00:17:22,670 --> 00:17:25,050
ذات يوم سوف أصبح طبيباً وأعين المنزل

238
00:17:25,050 --> 00:17:27,050
!وأردّ الجميل كلّه لماهيرو-سان

239
00:17:28,190 --> 00:17:30,560
عدت أخيراً؟

240
00:17:33,260 --> 00:17:34,670
أهلاً بعودتك

241
00:17:36,710 --> 00:17:38,080
عُدتُ إلى الدّيار

242
00:17:39,450 --> 00:17:40,700
ما الأمر؟

243
00:17:40,700 --> 00:17:42,280
لماذا تنتظرينني؟

244
00:17:42,570 --> 00:17:47,070
كلّ ما في الأمر هو أنّني أردتُ التكلّم معك

245
00:17:47,330 --> 00:17:48,640
التكلّم معي؟

246
00:17:49,890 --> 00:17:51,840
لنبدأ بالمشي

247
00:18:01,510 --> 00:18:04,090
لحظة، لماذا لا تقول شيئاً؟

248
00:18:04,650 --> 00:18:07,230
أعرني كتفيك قليلاً

249
00:18:22,120 --> 00:18:24,820
ما رأيك؟ ألا تشعر براحة؟

250
00:18:25,110 --> 00:18:28,940
...بـ-بلى، لكن

251
00:18:29,590 --> 00:18:31,440
ما الّذي يجري هنا؟

252
00:18:33,070 --> 00:18:37,640
ربطة حذائك مفكوكة! اثبت فحسب

253
00:18:37,640 --> 00:18:40,390
مهلاً، لماذا تفعلين كلّ هذا؟

254
00:18:46,720 --> 00:18:47,940
!أنتِ

255
00:18:47,940 --> 00:18:49,600
!يمكنني فعلها بنفسي، لذا دعيني وشأني

256
00:18:49,600 --> 00:18:51,360
...لـ-لكن

257
00:18:51,360 --> 00:18:54,150
لا تفعلي شيئاً، مفهوم؟

258
00:18:54,150 --> 00:18:55,860
ماذا أصابكِ؟

259
00:18:56,230 --> 00:18:58,540
...أ-أنا

260
00:18:59,500 --> 00:19:03,250
أريد التّعبير عن امتناني فحسب

261
00:19:04,290 --> 00:19:07,240
...ماذا؟ سمعتُ عن ذلك في مكان ما

262
00:19:07,710 --> 00:19:09,910
...ورأيتُ ذلك الشقّ

263
00:19:09,910 --> 00:19:11,100
...وهذا اللّباس

264
00:19:11,780 --> 00:19:13,100
هذا صحيح

265
00:19:13,100 --> 00:19:15,230
!إنّه كالحلم الّذي رأيتُه

266
00:19:16,370 --> 00:19:19,880
،ساهمتَ في الأعمال المنزليّة والمهرجان

267
00:19:19,880 --> 00:19:23,150
وأختايّ تعتمدان عليك حقّاً

268
00:19:23,150 --> 00:19:24,770
هل يُعقَل أن تكون صدفة؟

269
00:19:29,630 --> 00:19:33,520
لكنّنا نعتمد عليك زيادة عن اللّزوم

270
00:19:34,640 --> 00:19:38,390
!هل كان ذلك الحلم رؤية للمستقبل؟

271
00:19:38,390 --> 00:19:43,370
،أعي بأنّنا كنّا نفعل هذا بشكل خاطئ
وبأنّنا سوف نتغيّر

272
00:19:44,240 --> 00:19:47,530
...سيحصل كلّ شيء كما في الحلم

273
00:19:47,970 --> 00:19:50,030
...ثمّ نحن سوف

274
00:19:50,030 --> 00:19:54,000
...لذا... المعذرة

275
00:19:56,410 --> 00:19:57,800
شكراً لك

276
00:20:09,080 --> 00:20:11,550
ماذا؟ أهذا كلّ شيء؟

277
00:20:11,550 --> 00:20:13,670
ماذا تقصد؟

278
00:20:13,670 --> 00:20:15,040
لا شيء إطلاقاً

279
00:20:15,040 --> 00:20:16,320
لنذهب إلى المنزل

280
00:20:16,320 --> 00:20:18,060
!أمّي

281
00:20:34,230 --> 00:20:36,450
أنا آسف! هل أنتِ بخير؟

282
00:20:37,110 --> 00:20:38,880
...بئساً

283
00:20:38,880 --> 00:20:40,980
يسرّني أنّني تمكّنتُ من صدّها
!في اللّحظة الأخيرة

284
00:20:42,560 --> 00:20:46,040
حدث كلّ شيء في النّهاية كما في الحلم إذاً؟

285
00:20:46,040 --> 00:20:48,170
ما الّذي يجري هنا؟

286
00:20:50,850 --> 00:20:53,460
!لا! إنّها تُخرِج الملح

287
00:20:53,460 --> 00:20:54,820
!سوف تنثره عليّ

288
00:21:03,040 --> 00:21:04,980
إلى متى ستجلس مكانك؟

289
00:21:04,980 --> 00:21:06,440
لنعُد إلى المنزل

290
00:21:07,180 --> 00:21:08,570
لستِ غاضبة؟

291
00:21:08,840 --> 00:21:10,580
ولِمَ أغضب؟

292
00:21:10,580 --> 00:21:13,080
تعثّرتُ وسقطتُ فوقك فحسب

293
00:21:13,560 --> 00:21:15,720
ماذا أصاب عقلك يا تُرى؟

294
00:21:18,760 --> 00:21:20,820
!لا شيء

295
00:21:20,820 --> 00:21:22,750
لنذهب إلى المنزل

296
00:21:36,490 --> 00:21:38,280
لم يكن ذلك كافياً إذاً

297
00:21:45,050 --> 00:21:47,000
...يجب أن أطرد الشّوائب