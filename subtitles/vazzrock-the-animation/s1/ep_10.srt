1
00:00:09,650 --> 00:00:12,110
!تبدو بمظهر جيد

2
00:00:12,390 --> 00:00:14,240
!بدأت أشعر بأجواء المهرجان

3
00:00:14,240 --> 00:00:15,980
!بدأت أتحمس

4
00:00:15,980 --> 00:00:17,540
،أجل، لكن

5
00:00:17,540 --> 00:00:20,950
.كلما زاد عدد الوافدين، وادت المشاكل التي علينا التعامل معها

6
00:00:20,950 --> 00:00:24,330
!أخي روكا! شكرًا على عملك الجاد

7
00:00:24,330 --> 00:00:26,540
.أجل، الشكر لكما أيضًا

8
00:00:26,540 --> 00:00:30,830
سيد غاكو، هل كنت تتحاشاني؟

9
00:00:30,830 --> 00:00:33,970
.آسف، أنا مشغول بالعمل. مرة أخرى

10
00:00:34,990 --> 00:00:37,680
.أنت قاسي القلب

11
00:00:37,680 --> 00:00:40,890
.لكن هذا ما يجعل منك فاتنًا

12
00:00:40,890 --> 00:00:44,100
تنبايا

13
00:00:41,400 --> 00:00:42,930
.سأخرج

14
00:00:42,930 --> 00:00:44,100
.اعتن بالمكان في غيابي

15
00:00:51,790 --> 00:00:54,830
.أرى لمَ أنت الراقص الأول في بوتان يا أيومو-كن

16
00:00:54,830 --> 00:00:56,750
.أنت تستغل وقتك حقًا

17
00:00:57,990 --> 00:01:00,660
.بالطبع. المهرجان على الأبواب

18
00:01:00,890 --> 00:01:04,370
.وستلهو طوال الوقت ثانيةً؟ بربك

19
00:01:04,370 --> 00:01:07,280
.اللهو هو عملي، لذا لا بأس

20
00:01:07,280 --> 00:01:10,120
لا تجهد نفسك حتى لا يغشى عليك، اتفقنا؟

21
00:01:11,390 --> 00:01:13,170
.اهتم بشؤونك

22
00:01:15,800 --> 00:01:18,050
مرحبًا. كيف الحال أنتما؟

23
00:01:18,050 --> 00:01:21,150
ريجي؟ هل طلب منك شو المجيء أيضًا؟

24
00:01:21,150 --> 00:01:24,350
أجل. هل طلب منكما ذلك أيضًا؟

25
00:01:24,350 --> 00:01:25,520
.أهلًا

26
00:01:26,020 --> 00:01:30,460
.مرحبًا يا شرطة دورية بوتان، أكبر منطقة متعة في الغرب

27
00:01:30,460 --> 00:01:32,480
هل تسير تحضيرات المهرجان جيدًا؟

28
00:01:32,480 --> 00:01:34,270
!أجل! على قدم وساق

29
00:01:34,270 --> 00:01:36,310
.كل النزل محجوزة

30
00:01:36,310 --> 00:01:37,950
.لا شك من نجاحه

31
00:01:38,210 --> 00:01:39,830
.يسعدني سماع ذلك

32
00:01:39,830 --> 00:01:41,230
هل حدث شيء؟

33
00:01:41,230 --> 00:01:45,580
لنرَ... هل حدث، أم سيحدث؟

34
00:01:46,540 --> 00:01:49,060
!ها هي ذي! حاسة شو-كن السادسة

35
00:01:49,060 --> 00:01:50,140
...شو

36
00:01:50,140 --> 00:01:52,040
!أقصد يا زعيم! حدث شيء

37
00:01:52,580 --> 00:01:53,650
أترى ما أقصد؟

38
00:03:31,790 --> 00:03:33,980
لوسيدا • الجزء الثاني

39
00:03:34,710 --> 00:03:38,390
.يا له من رجل يافع وسيم. من الواضح أنه ليس من المدينة

40
00:03:40,780 --> 00:03:42,910
ماذا؟

41
00:03:43,960 --> 00:03:44,590
!يوما

42
00:03:44,590 --> 00:03:45,480
.لا تتحرك

43
00:03:46,340 --> 00:03:49,830
.أقصد، إن كنت تريد، لن أوقفك، لكن سيكون ذلك مؤلمًا

44
00:03:50,370 --> 00:03:52,870
.إن كنت تحب الألم فبادر

45
00:03:54,730 --> 00:03:57,590
.معه حق. لا ينبغي أن تجهد نفسك

46
00:03:57,590 --> 00:04:00,870
لمَ لا تسترخي فحسب وتخبرنا بما حدث؟

47
00:04:00,870 --> 00:04:03,120
.حـ-حسنًا

48
00:04:03,630 --> 00:04:06,620
من أين أبدأ؟

49
00:04:06,620 --> 00:04:07,850
.خذ وقتك

50
00:04:07,850 --> 00:04:11,020
في تلك الحالة يا شو، هل ألغي خطط العشاء؟

51
00:04:11,020 --> 00:04:13,310
.صحيح. افعل رجاءً

52
00:04:13,310 --> 00:04:14,520
...شو

53
00:04:15,860 --> 00:04:19,480
هل يعقل أنك... شو أونودا من بيت بوتان؟

54
00:04:19,750 --> 00:04:21,070
كيف تعرف اسمه؟

55
00:04:21,070 --> 00:04:23,950
مهلًا، هل يعني ذلك أن هذه بوتان؟

56
00:04:25,250 --> 00:04:28,280
...ما العمل؟ ما زال يوما

57
00:04:28,280 --> 00:04:30,190
صحيح! أين البقية؟

58
00:04:30,190 --> 00:04:31,670
...لنرَ

59
00:04:31,670 --> 00:04:35,000
يبدو أنك تعرف من أكون، لكن من أنت؟

60
00:04:35,000 --> 00:04:38,310
.شكرًا جزيلًا على إنقاذي

61
00:04:38,730 --> 00:04:43,110
.اسمي ناوسكي أوياما. أتيت من كيكيو

62
00:04:43,110 --> 00:04:46,970
.تاكاكي-سان طلب مني نقل وثيقة لك

63
00:04:46,970 --> 00:04:48,430
تاكاكي؟

64
00:04:48,430 --> 00:04:51,220
!صحيح، تاكا-تشان العراف

65
00:04:51,220 --> 00:04:52,510
تاكا-تشان"؟"

66
00:04:52,510 --> 00:04:53,910
أهو بخير؟

67
00:04:53,910 --> 00:04:54,690
!أجل

68
00:04:54,690 --> 00:04:56,400
من كيكيو إذًا؟

69
00:04:56,400 --> 00:04:59,600
...رئيس المقاطعة هناك اسمه أوياما

70
00:04:59,600 --> 00:05:02,760
.لذا لا يكذب

71
00:05:02,760 --> 00:05:04,140
أين الوثيقة إذًا؟

72
00:05:04,140 --> 00:05:08,370
...أنا ورفيقي افترقنا

73
00:05:10,530 --> 00:05:11,720
.فهمت

74
00:05:12,170 --> 00:05:15,830
إذًا رفيقك هذا المدعو يوما، هو من يملك الوثيقة؟

75
00:05:15,830 --> 00:05:19,290
.أجل! علي أن أذهب للبحث عنه في أقرب وقت

76
00:05:19,290 --> 00:05:23,010
.هوجمت من قبل مرتزقة. لا عجب أنك قلق جدًا

77
00:05:23,820 --> 00:05:28,390
لا تقلق. إيجاد الناس هو اختصاصنا، صحيح يا رفاق؟

78
00:05:28,390 --> 00:05:32,210
.أجل. دع الأمر لنا شرطة الدورية

79
00:05:32,210 --> 00:05:33,350
.أجل

80
00:05:37,410 --> 00:05:41,070
.أين ناو-ساما؟ آمل أنه بخير

81
00:05:41,070 --> 00:05:43,010
.اهدأ فحسب

82
00:05:43,010 --> 00:05:45,680
.حيث يوجد الناس، توجد المعلومات

83
00:05:45,680 --> 00:05:49,060
.قدومنا إلى البلدة هنا خيارنا الأفضل

84
00:05:49,060 --> 00:05:53,160
.باعتبار جهة النهر، لا بد أنه استراح هنا

85
00:05:53,160 --> 00:05:54,830
.آمل ذلك حقًا

86
00:05:54,830 --> 00:05:55,350
تنبايا

87
00:05:54,830 --> 00:05:56,760
!أهلًا ومرحبًا

88
00:05:56,760 --> 00:05:58,790
...ماذا؟ أنتم

89
00:05:59,030 --> 00:06:01,560
هل يمكننا مساعدتك...؟

90
00:06:01,560 --> 00:06:06,190
،صبي أشقر جميل وعملاق لطيف بمظهر ودود

91
00:06:06,190 --> 00:06:08,410
!ووسيم شرير أسود الشعر بعلامة جميلة

92
00:06:08,410 --> 00:06:10,430
ماذا؟ هل تستفزنا؟

93
00:06:11,930 --> 00:06:16,530
!مرحبًا بكم في منطقة المتعة المشهورة في الغرب، بوتان

94
00:06:11,930 --> 00:06:20,580
تنبايا

95
00:06:16,530 --> 00:06:18,710
!أنا واثق أن لدينا ما تبحثون عنه

96
00:06:28,140 --> 00:06:29,980
...شو. بشأن تلك المسألة

97
00:06:31,170 --> 00:06:33,330
.يبدو أنهم وجدوا رفيقك

98
00:06:33,330 --> 00:06:34,240
أليس ذلك عظيم؟

99
00:06:34,240 --> 00:06:35,790
!ماذا؟ بهذه السرعة؟

100
00:06:35,790 --> 00:06:38,010
—مذهل. شكرًا جزيـ

101
00:06:38,010 --> 00:06:38,570
!مؤلم

102
00:06:38,570 --> 00:06:42,390
.لا داعي للعجلة. ريجي-سان سيحضره معه الآن

103
00:06:44,420 --> 00:06:47,380
حقًا؟! أهو ناو-ساما حقًا؟

104
00:06:47,380 --> 00:06:51,010
.يكفي. تعال وره بنفسك

105
00:06:51,230 --> 00:06:54,660
.اعذره رجاءً. الصبي مكرس لمولاه

106
00:06:54,660 --> 00:06:57,560
.صحيح، سمعت أنكم هوجمتم من قبل مرتزقة

107
00:06:57,560 --> 00:06:59,530
هل استطعتم الإمساك بهم؟

108
00:06:59,530 --> 00:07:03,330
...في الواقع، بسبب اضطراب وقوع ناو-كن في النهر

109
00:07:03,330 --> 00:07:04,650
.هربوا

110
00:07:06,610 --> 00:07:11,730
إن كان الأمر كذلك، هناك احتمال كبير
.أنهم وصلوا إلى المدينة أيضًا

111
00:07:11,730 --> 00:07:14,060
.أجل، مع الأسف

112
00:07:14,060 --> 00:07:17,710
.توخوا الحذر. هذا المكان يجذب كل شاكلة الناس

113
00:07:17,710 --> 00:07:20,040
.يدعون أي أحد يدخل

114
00:07:21,420 --> 00:07:23,750
!أنا قلق على ناو-ساما. لنسرع

115
00:07:23,750 --> 00:07:27,620
حسنًا، حسنًا. هل تريدون أخذ طريق مختصر إذًا؟

116
00:07:31,760 --> 00:07:34,970
.يا إلهي. يبدو أنني تحدثت مبكرًا

117
00:07:37,080 --> 00:07:38,740
...بالطبع هم يسعون خلف

118
00:07:38,740 --> 00:07:40,770
يوما-كن، صحيح؟

119
00:07:44,980 --> 00:07:46,820
سحقًا. ألا تستلمون أبدًا؟

120
00:07:46,820 --> 00:07:48,440
!لن أتساهل معكم

121
00:07:50,070 --> 00:07:51,780
!احترس يا صاح

122
00:07:52,860 --> 00:07:54,320
.هـ-هذا سيئ

123
00:07:56,650 --> 00:07:57,870
.فعلًا

124
00:08:00,070 --> 00:08:03,220
...شكرًا على هذا

125
00:08:03,220 --> 00:08:04,040
.أيومو

126
00:08:04,480 --> 00:08:08,130
.دائمًا من المهم أن تكون في أبهى حلة عندما تلتقي بشخص عزيز

127
00:08:08,850 --> 00:08:10,520
.حسنًا. هذا أفضل

128
00:08:12,600 --> 00:08:13,710
روك؟

129
00:08:19,890 --> 00:08:22,460
!قبل أن نُحاصر، خذ يوما واهرب

130
00:08:22,460 --> 00:08:23,530
.حسنًا

131
00:08:26,060 --> 00:08:27,020
!يوما

132
00:08:28,260 --> 00:08:29,130
!ناو-ساما

133
00:08:29,130 --> 00:08:30,810
أنت مجددًا؟

134
00:08:31,720 --> 00:08:32,900
.تنح عن طريقي

135
00:08:34,290 --> 00:08:34,860
!ناو-ساما

136
00:08:38,740 --> 00:08:39,870
!ناو-ساما

137
00:08:43,790 --> 00:08:45,480
ناو-ساما، هل أنت بخير؟

138
00:08:45,480 --> 00:08:46,490
...يوما

139
00:08:46,820 --> 00:08:49,130
.أجل، أنا بخير

140
00:08:52,260 --> 00:08:53,530
.ويحي

141
00:08:53,530 --> 00:08:56,220
أيومو؟ أنت... ما الذي تفعله هنا؟

142
00:08:58,580 --> 00:09:00,790
!حان وقت دخول روكا-ساما المجيد

143
00:09:00,790 --> 00:09:01,720
!آسف على التأخر

144
00:09:02,020 --> 00:09:04,430
!يتبعه هاروتو-كن

145
00:09:06,350 --> 00:09:11,820
لم تشركونا نحن شرطة الدورية في
.الأمر، وانظروا إلى الفوضى التي افتعلتم

146
00:09:12,050 --> 00:09:14,030
.سحقًا... علينا الانسحاب

147
00:09:15,030 --> 00:09:16,760
حقًا؟ إلى أين؟

148
00:09:16,760 --> 00:09:17,900
!من أنت؟

149
00:09:17,900 --> 00:09:19,490
.لن تذهب لأي مكان

150
00:09:20,190 --> 00:09:22,450
!أحسنتم العمل جميعًا

151
00:09:22,450 --> 00:09:23,370
!يوما

152
00:09:23,370 --> 00:09:24,300
!ناو-ساما

153
00:09:40,610 --> 00:09:42,810
!مذهل

154
00:09:42,810 --> 00:09:45,770
.يبدو أيومو-سان جميلًا

155
00:09:52,910 --> 00:09:54,210
.فهمت الآن

156
00:09:57,480 --> 00:10:02,440
.يوما، تحتوي هذه الوثيقة على معلومات من ماضيك

157
00:10:03,010 --> 00:10:04,580
.قرأها في النجوم

158
00:10:05,770 --> 00:10:08,730
تاكاكي-ساما فعل ذلك؟ قرأ نجومي؟

159
00:10:09,060 --> 00:10:09,920
هل أقرأها لك؟

160
00:10:10,460 --> 00:10:13,100
.دعني أفكر في الأمر أولًا رجاءً

161
00:10:13,100 --> 00:10:16,110
.حسنًا. لنتحدث عن الأمر غدًا

162
00:10:18,930 --> 00:10:24,470
قبل وقت طويل، عشت في عربة
.مع مجموعة من الممثلين المسافرين

163
00:10:24,470 --> 00:10:25,340
ماذا؟

164
00:10:25,670 --> 00:10:32,550
.مات أبواي في جائحة عندما كنت صغيرًا، وأوتني الفرقة

165
00:10:32,550 --> 00:10:35,940
.كانوا أناسًا أخيارًا جميعًا. كانت الحياة ممتعة

166
00:10:36,630 --> 00:10:38,110
...إلى أن حان ذلك اليوم

167
00:10:41,050 --> 00:10:42,810
!جدوا الشقي الأشقر

168
00:10:46,290 --> 00:10:47,730
.ها أنت ذا

169
00:10:51,850 --> 00:10:53,210
!أيها الشقي

170
00:10:56,260 --> 00:10:57,260
!نهاية السلالة

171
00:11:00,290 --> 00:11:02,260
.لا تقلق. أنت بأمان الآن

172
00:11:08,350 --> 00:11:09,670
!نجوت

173
00:11:10,170 --> 00:11:13,860
...كن إن بقيت، الجميع سوف

174
00:11:15,690 --> 00:11:20,070
.وجدتني وأنقذتني بعد ما حدث

175
00:11:21,940 --> 00:11:24,570
هل كانوا يلاحقونك طوال هذا الوقت؟

176
00:11:24,570 --> 00:11:27,580
.لا بد أن ذلك كان فظيعًا يا يوما

177
00:11:28,350 --> 00:11:29,470
...ناو-ساما

178
00:11:29,940 --> 00:11:33,770
.لكن أخشى الآن أن أعرف الحقيقة

179
00:11:33,770 --> 00:11:38,630
.هناك احتمال أن سأكتشف أنني لست مناسبًا لأكون إلى جانبك

180
00:11:38,630 --> 00:11:40,300
!لن يحدث ذلك أبدًا

181
00:11:40,300 --> 00:11:43,980
.لكن... قالت قراءة إيسا-سان أنني أجلب سوء الحظ

182
00:11:43,980 --> 00:11:45,830
!العرافة ليست معصومة من الخطأ

183
00:11:45,830 --> 00:11:48,530
!أينما كنت تنحدر، تظل أنت

184
00:11:48,530 --> 00:11:50,420
!أنت صديقي المقرب وأخي

185
00:11:51,340 --> 00:11:55,950
.وقفت إلى جانبك، يوما شيراسي، طوال هذا الوقت

186
00:11:55,950 --> 00:12:01,240
!أعد أنني لن أتخلى عنك أبدًا، مهما كانت قراءة النجوم

187
00:12:01,630 --> 00:12:05,700
.ناو-ساما... شكرًا جزيلًا

188
00:12:08,470 --> 00:12:11,160
بالمناسبة. هل نمت جيدًا ليلة أمس؟

189
00:12:11,160 --> 00:12:15,130
.أجل. أظنني مستعد الآن

190
00:12:15,130 --> 00:12:16,990
.سأخبرك إذًا

191
00:12:16,990 --> 00:12:19,850
،عندما قرأ تاكاكي نجومك

192
00:12:19,850 --> 00:12:22,340
.رأى صورة لزهرة مع حصان أبيض

193
00:12:22,780 --> 00:12:24,970
زهرة وحصان أبيض؟

194
00:12:26,970 --> 00:12:29,170
...يوما، هل يمكن أن ذلك

195
00:12:29,480 --> 00:12:32,350
حصان وزهرة... بضاعة الحصان الأبيض؟

196
00:12:32,350 --> 00:12:34,600
مثلًا، عشيرة الحصان الأبيض المشهورة؟

197
00:12:34,600 --> 00:12:36,770
عشيرة الحصان الأبيض من غيباكو إذًا؟

198
00:12:36,770 --> 00:12:40,670
.أصلًا، كانوا باعة متجولين ارتحلوا من بلاد إلى أخرى

199
00:12:40,670 --> 00:12:43,730
صحيح. لكنهم أصبحوا الآن بيتًا بارزًا

200
00:12:43,730 --> 00:12:46,490
.مع قصر في عاصمة غيباكو

201
00:12:46,490 --> 00:12:50,340
لكن أي علاقة قد أمتلكها مع بضاعة الحصان الأبيض

202
00:12:52,570 --> 00:12:54,370
،بالتفكير في الأمر

203
00:12:54,370 --> 00:12:57,190
هل يمكن أن لهذا علاقة بما حدث سابقًا؟

204
00:12:57,190 --> 00:12:58,250
ماذا حدث سابقًا؟

205
00:12:58,250 --> 00:13:00,340
...أجل. في الواقع

206
00:13:01,270 --> 00:13:04,090
...فهمت. في كيكيو

207
00:13:04,490 --> 00:13:08,800
.ربما حينها أدركوا من تكون يا يوما

208
00:13:08,800 --> 00:13:09,960
ماذا؟

209
00:13:09,960 --> 00:13:12,950
.تحصل بوتان على المعلومات من جميع أنحاء القارة

210
00:13:14,550 --> 00:13:17,730
،في الحقيقة، سمعنا قبل وقت طويل أن زعيم عشيرة البيض الأبيض

211
00:13:18,090 --> 00:13:21,570
.رو هاكوبا، كان يبحث عن حفيده الذي اختفى منذ وقت طويل

212
00:13:21,570 --> 00:13:24,290
...ماذا؟ هل تقصد أن حفيده

213
00:13:24,290 --> 00:13:26,140
.أجل. إنه يوما على الأغلب

214
00:13:26,140 --> 00:13:28,950
أنا؟ لكن كيف يمكن أن أكون حفيده؟

215
00:13:28,950 --> 00:13:31,960
.لدينا سبب آخر يدعونا للتفكير كذلك

216
00:13:31,960 --> 00:13:35,640
—دفعنا المرتزقة للحديث، وأخبرونا بشيء حاسم

217
00:13:36,200 --> 00:13:38,710
.المدبر وراء محاولات اغتيالك

218
00:13:38,710 --> 00:13:40,670
ماذا؟ من يكون؟

219
00:13:41,180 --> 00:13:45,130
.شومي هاكوبا، الأخ الأصغر لأبيك

220
00:13:45,130 --> 00:13:48,360
...أخ أبي؟ إذًا

221
00:13:48,360 --> 00:13:51,640
.ذلك يجعل منه عمك

222
00:13:52,260 --> 00:13:57,780
.يبدو أنه كان قادرًا على تحديد هويتك وإرسال المرتزقة خلفك

223
00:13:57,780 --> 00:14:00,110
.كانت عينك المصابة هي الدليل الذي كانوا بحاجته

224
00:14:00,390 --> 00:14:02,410
عيني المصابة؟

225
00:14:02,410 --> 00:14:04,950
...لا تقل أنهم من هاجموني آنذاك

226
00:14:06,620 --> 00:14:09,070
.لدينا ثأر إذًا

227
00:14:09,070 --> 00:14:12,580
.لا بد أنه يسعى خلف ثروة عشيرة الحصان الأبيض

228
00:14:12,580 --> 00:14:16,180
أهذا ما في الأمر؟ أكان كل شيء من أجل ذلك؟

229
00:14:16,660 --> 00:14:20,090
.وليس أنا فقط... سعوا خلف الناس الذين من حولي أيضًا

230
00:14:20,750 --> 00:14:22,290
كيف تجرؤوا؟

231
00:14:22,290 --> 00:14:25,780
إذًا يا يوما، ماذا ستفعل الآن؟

232
00:14:26,330 --> 00:14:30,860
.أريد مواجهة عملي وأن أسأله بشكل مباشر

233
00:14:30,860 --> 00:14:32,510
.أحتاج لمعرفة الحقيقة

234
00:14:32,510 --> 00:14:35,350
.وإلا لن أستطيع المضي قدمًا أبدًا

235
00:14:36,530 --> 00:14:40,200
.حسنًا. لكن أولًا، لدي شيء واحد أسأل عنه

236
00:14:40,700 --> 00:14:43,570
هل أنت مستعد لاعتلاء المسرح؟

237
00:14:45,780 --> 00:14:46,630
.ناو-ساما

238
00:14:47,470 --> 00:14:50,860
.حسنًا، سأعتلي المسرح

239
00:14:51,310 --> 00:14:52,120
.جيد

240
00:14:52,120 --> 00:14:54,580
.في تلك الحالة، لنبذل كل ما لدينا

241
00:14:54,580 --> 00:14:56,750
،من أجل شرف بوتان، زهرة الغرب

242
00:15:03,910 --> 00:15:06,890
.لا تقلق. دع كل شيء لنا فحسب

243
00:15:06,890 --> 00:15:09,030
هاروتو، هلا تقضي لي مأمورية؟

244
00:15:09,030 --> 00:15:09,910
!حاضر

245
00:15:55,750 --> 00:15:58,370
لمَ قرر أبي القدوم إلى بوتان فجأة؟

246
00:15:58,740 --> 00:16:04,110
...هل يعرف شيئًا؟ لا، يستحيل أن يملك دليلًا

247
00:16:05,090 --> 00:16:07,520
مرحبًا جميعًا! هلي بانتباهكم؟

248
00:16:07,760 --> 00:16:08,840
!شكرًا على الانتظار

249
00:16:08,840 --> 00:16:12,030
!الحدث الرئيسي لمهرجان بوتان هذه السنة على وشك أن يبدأ

250
00:16:12,460 --> 00:16:16,040
!لـ-لم تقل أي شيء عن وجود جمهور

251
00:16:16,040 --> 00:16:19,490
.عزيزي. الجمهور هو ما ينجح كل شيء

252
00:16:19,490 --> 00:16:23,290
إن كان الناس يشاهدون، لا يمكن
.لعدوك أن يقدم على أي حركة طائشة

253
00:16:23,550 --> 00:16:26,600
...لكن تحويله إلى أداء مهرجاني

254
00:16:26,600 --> 00:16:27,950
ألا بأس بهذا حقًا؟

255
00:16:27,950 --> 00:16:29,000
.بالطبع

256
00:16:29,350 --> 00:16:32,460
،بوتان مدينة المرح والتسلية

257
00:16:32,460 --> 00:16:35,870
.حيث يتم تحويل كل شيء إلى إغواء أو عرض

258
00:16:36,270 --> 00:16:38,010
.الجميع هنا معتادون عليه

259
00:16:38,010 --> 00:16:41,910
.أعلم كيف تشعر، لكن هكذا هي الأمور هنا

260
00:16:41,910 --> 00:16:43,060
ماذا...؟

261
00:16:43,060 --> 00:16:45,190
!يوما، ابذل جهدك

262
00:16:45,530 --> 00:16:46,970
...ناو-ساما

263
00:16:46,970 --> 00:16:50,650
!حـ-حسنًا. ها نحن ذا

264
00:16:51,170 --> 00:16:54,220
!أول ضيف لنا لهذا المساء هو هذا الشهم

265
00:16:55,820 --> 00:16:57,800
.أنا يوما شيراسي

266
00:16:57,800 --> 00:17:00,850
.وأتيت إلى هنا اليوم للقاء جدي

267
00:17:01,180 --> 00:17:04,990
،يوما-كن هنا هو حفيد رو هاكوبا الذي تاه منذ وقت طويل

268
00:17:04,990 --> 00:17:08,430
!رئيس تجارة الحصان الأبيض الوحيد

269
00:17:08,810 --> 00:17:11,300
!بعد غياب سنين، سيتم الجمع بينهم أخيرًا

270
00:17:11,300 --> 00:17:15,180
!لكن أولًا، اسمحوا لي بتقديم ضيف مفاجئ

271
00:17:15,890 --> 00:17:17,140
ماذا؟

272
00:17:17,140 --> 00:17:19,510
!مرحبًا يا عم يوما-كن

273
00:17:20,060 --> 00:17:23,160
كيف شعورك لترى ابن أخيك الذي تاه منذ وقت طويل؟

274
00:17:23,860 --> 00:17:27,440
أنت عملي، أليس كذلك؟

275
00:17:27,440 --> 00:17:29,730
!أجل، أنا كذلك

276
00:17:29,730 --> 00:17:32,450
!أردت رؤيتك يا ابن أخي العزيز

277
00:17:32,450 --> 00:17:34,200
!يا له من تمثيل مبتذل

278
00:17:34,200 --> 00:17:35,400
!انزل من المسرح أيها الأضحوكة

279
00:17:35,680 --> 00:17:37,530
!كيف تجرؤ؟

280
00:17:38,210 --> 00:17:41,690
.أردت رؤيتك ثانيةً أيضًا

281
00:17:42,250 --> 00:17:43,500
.أخبرني بهذا رجاءً

282
00:17:43,910 --> 00:17:48,330
هل أنت من كان يحاول قتلي مرارًا وتكرارًا؟

283
00:17:48,330 --> 00:17:50,410
!مـ-ماذا؟ هذا سخيف

284
00:17:50,410 --> 00:17:53,050
!أ-أين دليلك؟ أرني الدليل

285
00:17:56,170 --> 00:17:58,310
!إليك الدليل الذي طلبت

286
00:18:00,050 --> 00:18:02,930
!لـ-لا يعقل أنهم... لا

287
00:18:03,490 --> 00:18:05,850
كيف تجرؤ؟

288
00:18:06,630 --> 00:18:08,130
!اخرس، اخرس

289
00:18:08,130 --> 00:18:10,560
!الجميع يسخرون مني دائمًا

290
00:18:11,080 --> 00:18:13,830
!"أخوك أفضل!" "كن مثل أخيك أكثر"

291
00:18:13,830 --> 00:18:16,200
!لطالما قارنوني به

292
00:18:16,620 --> 00:18:20,870
!وفي أحد الأيام هرب مع ممثلة رحالة فاسقة

293
00:18:20,870 --> 00:18:23,190
،كان يفترض بالعالم أن يكون محارة لي

294
00:18:23,190 --> 00:18:26,000
!"لكن واصل أبي ترديد اسم "شوي

295
00:18:26,000 --> 00:18:27,870
!كان يفترض أن يكون هذا وقتي

296
00:18:28,120 --> 00:18:30,770
.أيها الرجل المثير للشفقة المسكين

297
00:18:31,340 --> 00:18:35,780
،أنعم عليك بالكثير في الحياة، لكن بدلًا من أن تكون ممتنًا

298
00:18:35,780 --> 00:18:37,880
،بدلًا من أن تكون أفضل شخص تستطيع أن تكون

299
00:18:38,360 --> 00:18:42,260
"!لا تفعل أي شيء سوى النحيب كالأطفال، "أعطني هذه! أعطني هذا

300
00:18:42,260 --> 00:18:44,260
!أيها الشقي الصغير الدنيء

301
00:18:44,260 --> 00:18:45,220
!معتوه

302
00:18:46,680 --> 00:18:48,890
!أ-أبي؟

303
00:18:48,890 --> 00:18:51,270
ماذا فعلت؟

304
00:18:51,270 --> 00:18:53,990
.لـ-لا، مهلًا! لم أفعل أي شيء

305
00:18:53,990 --> 00:18:55,650
!نصبوا لي فخًا

306
00:18:55,950 --> 00:18:58,610
!فات الأوان على ذلك. أنت عار

307
00:19:06,770 --> 00:19:09,040
هل أنت... جدي؟

308
00:19:09,040 --> 00:19:13,670
.ولا بد أنك يوما. تبدو مثل أبيك يا شوي

309
00:19:13,900 --> 00:19:16,090
.حمدًا لأنك نجوت

310
00:19:16,090 --> 00:19:19,670
.يوما، لا أستطيع أن أعتذر بما فيه الكفاية بشأن شومي

311
00:19:20,280 --> 00:19:21,250
.سامحني رجاءً

312
00:19:21,250 --> 00:19:23,800
!رجاءً! لست بحاجة لتنحني لي

313
00:19:24,350 --> 00:19:28,270
.إنه خطئي أساسًا لأنه آل هكذا

314
00:19:28,830 --> 00:19:34,530
،لكن، لو أنني سمحت لأبيك وأمك أن يتزوجا

315
00:19:34,530 --> 00:19:37,900
.لما حدث هذا لك أبدًا على الأغلب

316
00:19:38,110 --> 00:19:42,750
.جدي، لم أكن منكوبًا في حياتي

317
00:19:43,430 --> 00:19:47,500
.أبي وأمي وكل الممثلين في الفرقة كانوا طيبين معي

318
00:19:47,910 --> 00:19:50,090
،خسرت كل شيء ذات مرة بالفعل

319
00:19:50,510 --> 00:19:54,630
لكن بفضل ذلك، قابلت ناو-ساما
.والناس المذهلون من عشيرة أوياما

320
00:19:54,630 --> 00:19:57,240
.صحيح! يوما أشبه بأخ لي

321
00:19:57,240 --> 00:19:59,380
.حتى أن والدي يعاملاه كابن لهما

322
00:19:59,380 --> 00:20:04,430
كيف لي أن أوفيك وعائلة أوياما حقكم بما يكفي أيها الشاب؟

323
00:20:04,430 --> 00:20:08,110
.لست بحاجة لذلك! لطالما كان يوما ذا عون عظيم

324
00:20:08,110 --> 00:20:10,350
.صحيح، إنه أخي وصديقي المقرب

325
00:20:10,350 --> 00:20:12,210
هكذا إذًا؟

326
00:20:12,850 --> 00:20:17,850
.لكن، بصفتي جده، يا ليته يدعني أعتني به أيضًا

327
00:20:17,850 --> 00:20:22,170
.أريد أن أعوض عن كل شيء لم أستطع أن أفعله من أجله في الماضي

328
00:20:22,170 --> 00:20:23,670
...في الواقع، بشأن ذلك

329
00:20:24,170 --> 00:20:28,590
هل يفترض بي أن أكون رئيس العائلة حقًا؟

330
00:20:28,590 --> 00:20:29,830
ماذا؟

331
00:20:29,830 --> 00:20:31,940
.ما زلتُ غرًّا

332
00:20:32,250 --> 00:20:34,410
.لا أدري شيئًا بشأن العالم

333
00:20:34,870 --> 00:20:37,490
.لا أعرف حتى ما أريد أن أفعل في الحياة

334
00:20:38,260 --> 00:20:40,300
...لهذا السبب

335
00:20:41,100 --> 00:20:44,760
.من أجل توسيع آفاقي، أريد أن أرتحل عبر القارة

336
00:20:44,760 --> 00:20:47,380
.إلى جانب ناو

337
00:20:48,020 --> 00:20:52,630
.وأثناء رحلاتي، سأفكر جيدًا في مستقبلي

338
00:20:54,040 --> 00:20:56,690
.حسنًا. نعم

339
00:20:56,690 --> 00:20:59,730
.من الجيد أن يوسع المرء آفاقه

340
00:20:59,970 --> 00:21:04,390
.لكني سأعود يومًا ما يا جدي

341
00:21:09,810 --> 00:21:12,370
!حسنًا، لنذهب في رحلة

342
00:21:12,650 --> 00:21:15,120
.كانت بوتان دولة مثيرة للاهتمام حقًا

343
00:21:15,120 --> 00:21:18,330
.حتى أنني متشوق أكثر لرؤية بقية العالم الآن

344
00:21:18,540 --> 00:21:22,050
.لكني لم أتوقع قط أنكم ستنضمون لنا

345
00:21:22,050 --> 00:21:25,990
.في الواقع، أردت أن أري أوكا-تشان العالم الخارجي

346
00:21:25,990 --> 00:21:28,180
.أردت تفويت العمل فحسب

347
00:21:30,040 --> 00:21:32,720
.وقبلت عملًا دبلوماسيًا من أجلك

348
00:21:32,720 --> 00:21:37,020
ماذا؟! أوكا-سان، لمَ عليك أن تكون عفيفًا هكذا؟

349
00:21:37,020 --> 00:21:39,820
.حظ صعب! يجب العمل والعمل والعمل

350
00:21:39,820 --> 00:21:44,340
لكن يا تاكاكي، سنحصل هذه المرة على الطعام والمسكن، صحيح؟

351
00:21:45,290 --> 00:21:46,530
.أشك في ذلك نوعًا ما

352
00:21:46,530 --> 00:21:48,500
مجددًا، صدقًا؟

353
00:21:48,500 --> 00:21:50,360
.سئمت التخييم حقًا

354
00:21:50,360 --> 00:21:53,110
حسنًا، إلى أين نذهب أولًا؟

355
00:21:53,110 --> 00:21:55,900
!سأذهب إلى أي مكان، ما دمت معك يا ناو

356
00:23:31,110 --> 00:23:34,890
منافس • الجزء الأول

357
00:23:34,890 --> 00:23:40,250
رسم: توهيرو شيجيما