1
00:00:31,970 --> 00:00:35,100
!أسمح لك بالزّواج من ابنتي؟

2
00:00:35,100 --> 00:00:36,440
!لا تكن أنانيًّا

3
00:00:36,440 --> 00:00:38,420
كيف سيذرّ ذلك بالمال عليّ؟

4
00:00:38,420 --> 00:00:40,260
تفتح موضوع المال الآن؟

5
00:00:40,260 --> 00:00:41,720
!بل هذا أنسب سبب لفتح موضوع المال الآن

6
00:00:42,340 --> 00:00:43,950
ما الّذي لا تحبّه في الأمر؟

7
00:00:43,950 --> 00:00:46,080
.ابني، ابنتك

8
00:00:46,080 --> 00:00:48,370
لماذا لا تأخذ هذه الفرصة

9
00:00:48,370 --> 00:00:50,960
لبناء علاقة جيّدة بين قريتينا؟

10
00:00:50,960 --> 00:00:51,890
لِم لا؟

11
00:00:51,890 --> 00:00:55,430
إن رفضت، سأخوض حربًا
.ضدّك وأسرق أرضك

12
00:00:55,430 --> 00:00:56,300
!لقد جُننت

13
00:00:56,300 --> 00:00:58,750
!لن تحصل على ابنتي أو قريتي بالمجّان

14
00:00:58,750 --> 00:01:02,080
رغم أنّ الأمر ما يزال ممكنًا
.مقابل الثّمن المناسبة

15
00:01:02,080 --> 00:01:02,570
!مهلاً

16
00:01:02,570 --> 00:01:04,210
!انتظر لحظة

17
00:01:05,090 --> 00:01:06,380
ماذا تريد؟

18
00:01:06,380 --> 00:01:08,650
!لا شيء! المعذرة

19
00:01:08,650 --> 00:01:09,910
!ديميتريوس

20
00:01:10,370 --> 00:01:11,550
.إنّها جميلة

21
00:01:11,550 --> 00:01:14,250
أحتاج لاستغلال هذه الفرصة
.لأتباهى أمامها

22
00:01:16,750 --> 00:01:19,090
،في الحقيقة، أودّ خوض حرب

23
00:01:19,090 --> 00:01:21,120
.لكنّني تلقّيتُ رسالة بشأن الأولمبيّات

24
00:01:20,010 --> 00:01:25,660
طلب وقف الأعمال العدائيّة
خلال الأولمبيّات

25
00:01:21,120 --> 00:01:24,350
.علينا احترام هدنة الشّهور الثّلاثة

26
00:01:24,350 --> 00:01:25,630
!علينا ذلك

27
00:01:25,630 --> 00:01:28,330
!هذا صحيح! لا حرب! عودوا لمنازلكم

28
00:01:28,330 --> 00:01:29,680
.لديّ اقتراح

29
00:01:29,680 --> 00:01:33,340
كما في الأولمبيّات، لماذا لا نبتّ
في هذا الأمر بمنافسة رياضيّة؟

30
00:01:33,340 --> 00:01:34,370
لِم لا؟

31
00:01:34,650 --> 00:01:38,730
منافسة رياضيّة؟ لا يوجد
.أيّ رياضيّ في قريتنا

32
00:01:38,730 --> 00:01:42,380
لا تضمّ قريتنا سوى الشّيوخ
.الطّمّاعين والشّباب الجبناء

33
00:01:42,380 --> 00:01:43,000
!هذا صحيح

34
00:01:43,000 --> 00:01:44,940
.بإمكانك إذًا اختيار المنافسة

35
00:01:44,940 --> 00:01:46,270
.قد تكون ملاكمة أو أي شيء آخر

36
00:01:46,270 --> 00:01:47,490
.الأمر بين يديك

37
00:01:47,490 --> 00:01:49,720
!مهما كان ما تريد
!سيواجه أبي أيًّا كان

38
00:01:50,920 --> 00:01:55,830
،جيّد جدًّا. لكن إن فزنا
فسيتمّ مكافأتنا بسخاء، صحيح؟

39
00:01:55,830 --> 00:01:58,050
.أنا أراهن بابنتي وأرضي على هذا

40
00:01:58,050 --> 00:01:59,360
أبي، عمّ تتحدّث؟

41
00:01:59,360 --> 00:02:01,060
.جيّد جدًّا. لديّ مال

42
00:02:01,060 --> 00:02:02,640
.لديّ مال والديّ

43
00:02:02,640 --> 00:02:04,950
.سنتقابل بعد ثلاثة أيّام من أجل منافستنا

44
00:02:04,950 --> 00:02:06,170
!تأهّبوا

45
00:02:06,600 --> 00:02:09,270
أيّها العمدة، ما الّذي ستفعله؟

46
00:02:09,720 --> 00:02:10,780
!بريق

47
00:02:10,780 --> 00:02:12,270
!ماذا؟

48
00:02:13,410 --> 00:02:15,050
...لا يمكنني فعل هذا

49
00:02:15,050 --> 00:02:18,740
أدرك أنّك قلق للغاية
.على مستقبل هذه القرية

50
00:02:18,740 --> 00:02:20,650
،إن كنتَ تهتمّ لتلك الدّرجة
!فما باليد حيلة

51
00:02:20,650 --> 00:02:23,050
!ستمثّل هذه القرية يا ديميتريوس

52
00:02:23,050 --> 00:02:26,480
.قل تقل أيّ شيء آخر
.أدرك كم أنت متحفّز

53
00:02:26,480 --> 00:02:28,910
!لديّ طلب واحد: لا تخسر

54
00:02:28,910 --> 00:02:30,500
!إيّاك أن تخسر مهما حدث
!هذا كلّ شيء

55
00:02:30,500 --> 00:02:32,500
!هذا غير معقول

56
00:02:33,370 --> 00:02:36,830
أظنّ فحسب أنّه ليس من العدل
.أن تتزوّج أبولونيا هكذا

57
00:02:37,440 --> 00:02:39,020
...طوكيوبوليس

58
00:02:41,380 --> 00:02:44,140
صحيح. أسلتني الآلهة لتلك القرية

59
00:02:44,140 --> 00:02:45,940
.لأنّها عرفت أنّ هذا سيحدث

60
00:02:47,650 --> 00:02:51,780
المنافسة الّتي اُختيرت لتشريف
.زوس هي سباق البيض

61
00:02:51,780 --> 00:02:54,520
سباق البيض؟ ما هذا؟؟

62
00:02:54,520 --> 00:02:56,880
.حسنًا. لكن في المقابل، وإن فزت

63
00:02:56,880 --> 00:03:00,330
،فلن آخذ أرضك وابنتك فقط
.بل سآخذ ذلك البابيروس أيضًا

64
00:03:00,730 --> 00:03:02,830
.حاول أن تقدّم قتالاً جيّدًا

65
00:03:03,060 --> 00:03:04,940
!استعداد، أبيتي

66
00:03:04,940 --> 00:03:06,330
!هيّا! هيّا، هيّا، هيّا

67
00:03:06,330 --> 00:03:09,450
.التّركيز عامل مهمّة في هذه المنافسة

68
00:03:18,410 --> 00:03:21,690
.فرحة تحريد الجسد بينما نصبو للنصر

69
00:03:21,690 --> 00:03:23,570
حتّى الجماهير يمتلئون
.بالفرحة عندما يروا ذلك

70
00:03:24,100 --> 00:03:25,600
!أوقعها

71
00:03:24,450 --> 00:03:28,190
ذلك النّوع من المسابقات الرّياضيّة
.يجب أن يوجد في تورتونيا أيضًا

72
00:03:31,230 --> 00:03:33,450
.لا أصدّق أنّني خسرت

73
00:03:34,880 --> 00:03:36,160
.أعرض عليك هذا

74
00:03:36,460 --> 00:03:39,050
.لكن في المقابل، دع قريتنا وشأنها

75
00:03:39,050 --> 00:03:43,000
أنت الرّجل الوحيد الجدير
.بارتدائه حول عنقك

76
00:03:43,000 --> 00:03:44,790
!أحسنت يا ديميتريوس

77
00:03:44,790 --> 00:03:46,630
.على أيّ حال، احترم جانبك من الصّفقة

78
00:03:46,630 --> 00:03:48,070
.أعلم

79
00:03:48,070 --> 00:03:49,320
!ديميتريوس

80
00:03:49,830 --> 00:03:51,850
.أنت بطل القرية

81
00:03:52,830 --> 00:03:53,840
ما الخطب؟

82
00:03:53,840 --> 00:03:57,020
هـ-هذه أوّل مرّة أتحدّث
!فيها مع أبولونيا

83
00:03:57,020 --> 00:03:58,650
!مذهل! أنا مذهل

84
00:03:58,650 --> 00:04:01,660
!الرّياضة هي الأفضل! تحيى الرّياضة

85
00:04:10,890 --> 00:04:12,110
.العمدة

86
00:04:13,020 --> 00:04:14,520
هل لديك بعض الوقت؟

87
00:04:14,960 --> 00:04:16,660
كلمات: فوجي ريو
ألحان: هاياشي أكيتو

88
00:04:36,610 --> 00:04:39,250
رجولة  خدمة  شهرة  فضيلة  شجاعة  قوّة

89
00:04:36,780 --> 00:04:39,250
!الكلّ في واحد

90
00:04:56,330 --> 00:04:58,970
رجولة  خدمة  شهرة  فضيلة  شجاعة  قوّة

91
00:04:56,500 --> 00:04:58,970
!الكلّ في واحد