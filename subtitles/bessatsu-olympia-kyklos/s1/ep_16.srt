1
00:00:31,810 --> 00:00:33,140
توليمبيّات؟

2
00:00:33,440 --> 00:00:34,780
!هـ-هذا صحيح

3
00:00:34,780 --> 00:00:37,980
!أوليمبيّات تورتونيا مجرّد اسم مؤقّت

4
00:00:37,980 --> 00:00:40,230
!الاسم الرّسميّ هو توليمبيّات

5
00:00:40,230 --> 00:00:44,960
إنّها مختلفة تمامًا عن أوليمبيّاتكم
!القديمة والنّبيلة

6
00:00:44,960 --> 00:00:48,230
!هذا صحيح! إنّها عبارة عن قمامة فحسب

7
00:00:47,510 --> 00:00:48,230
!ما...؟

8
00:00:49,750 --> 00:00:51,280
.لا بأس إذًا

9
00:00:51,280 --> 00:00:53,050
لكنّكم استعملتم الاسم

10
00:00:53,050 --> 00:00:56,170
.بدون إذن من لجنة أوليمبيّات إليس

11
00:00:56,170 --> 00:01:00,440
الاستعمال غير المصرّح به لرسومات
.المزهريّات ممنوع منعًا باتًّا

12
00:01:00,440 --> 00:01:02,020
!نعم، هذا مفهوم

13
00:01:02,020 --> 00:01:03,980
.مع السّلامة إذًا

14
00:01:06,220 --> 00:01:07,910
.كان ذلك وشيكًا

15
00:01:07,910 --> 00:01:10,830
.ظننتُ أنّ إليس ستطلب غرامة منّا

16
00:01:10,830 --> 00:01:13,510
.لا أتحمّل فقدان المزيد من المال

17
00:01:13,510 --> 00:01:14,790
المزيد؟

18
00:01:14,790 --> 00:01:18,020
.أنفقت الكثير من المال للإشهار للتّوليمبيّات

19
00:01:18,020 --> 00:01:21,030
،على هذا الحال، حتّى إن عقدناها
.فسأخسر المال

20
00:01:21,030 --> 00:01:24,000
ألا يوجد ما قد نفعله يا ديميتريوس؟

21
00:01:24,000 --> 00:01:26,700
.لا أعرف الكثير عن المال

22
00:01:26,700 --> 00:01:31,360
أيّها المتوحّش! ألا تهتمّ للتّوليمبيّات
الّتي أسميتها بنفسك؟

23
00:01:31,360 --> 00:01:34,710
!عليك التّفكير بطرق مبتكرة ستدرّ بالمال عليّ

24
00:01:34,710 --> 00:01:37,280
!اعثر على شجرة التّفّاح الذّهبيّ

25
00:01:37,280 --> 00:01:41,250
،إن كنت أعرف كيف أجني المال
!لجنيته لنفسي

26
00:01:41,250 --> 00:01:42,780
...السّفر عبر الزّمن

27
00:01:45,860 --> 00:01:46,770
أين أنا؟

28
00:01:48,120 --> 00:01:49,960
هل أنت رومانيّ؟

29
00:01:50,490 --> 00:01:52,620
.بل هذا الرّجل إغريقيّ

30
00:01:52,620 --> 00:01:54,590
ما هذا المكان يا سيّدي؟

31
00:01:55,000 --> 00:01:56,350
.إنّه حمّام عامّ

32
00:01:56,350 --> 00:02:01,140
يبدو أنّهم كانوا يمتلكونها في قاعات
.الرّياضات في اليونان القديمة

33
00:02:01,140 --> 00:02:04,250
أعتقد أنّ الرّومان القدماء كانوا أوّل
.من استعمل المياه السّاخنة

34
00:02:06,640 --> 00:02:10,490
...رسمة لجبل أوليمبوس. هذا مذهل

35
00:02:11,040 --> 00:02:13,220
ما هذه الرّسومات والكتابات الّتي حولها؟

36
00:02:13,220 --> 00:02:15,710
.إنّها إعلانات

37
00:02:15,710 --> 00:02:19,310
رعاة بعبارة أخرى، يدفع أصحاب الإعلانات

38
00:02:19,310 --> 00:02:21,260
.المال للتّرويج لمنتجاتهم

39
00:02:21,260 --> 00:02:23,420
.فقبل كلّ شيء، يجتمع النّاس في الحمّامات

40
00:02:23,720 --> 00:02:27,030
.مفهوم. وسينظر النّاس إليها

41
00:02:27,030 --> 00:02:29,460
.ثمّة أنواع كثيرة من الإعلانات

42
00:02:30,340 --> 00:02:32,560
!إعلان تاجر السّمك ذاك يتحرّك

43
00:02:32,560 --> 00:02:34,730
.ذلك وشم

44
00:02:34,730 --> 00:02:36,330
إنّه وشم إذًا؟

45
00:02:36,680 --> 00:02:40,570
إنّه يملك ألوانًا جميلة تفوق
.أوشام البرابرة في تراقيا

46
00:02:41,860 --> 00:02:44,940
.ظننت أنّه رسم إعلانًا على جسده

47
00:02:48,540 --> 00:02:51,010
!وجدتُها! وجدتُها

48
00:02:51,960 --> 00:02:54,190
هل اكتشفت كيف تحسب حجم الأجسام؟

49
00:02:54,190 --> 00:02:55,780
!هذه هي

50
00:02:56,430 --> 00:02:57,850
من أنت؟

51
00:03:00,800 --> 00:03:02,160
...السّفر عبر الزّمن

52
00:03:06,230 --> 00:03:07,030
!أيّها العمدة

53
00:03:07,370 --> 00:03:08,560
ماذا؟

54
00:03:08,560 --> 00:03:09,900
!الرّعاة

55
00:03:09,900 --> 00:03:12,520
!سيأتي الكثير من النّاس للتّوليمبيّات

56
00:03:12,520 --> 00:03:15,170
!سيشاهد الجميع الألعاب

57
00:03:15,170 --> 00:03:18,750
لذلك سنبيع حقوق وضع
إعلانات على أجساد

58
00:03:18,750 --> 00:03:22,310
،الرّياضيّين في الحلبات
!كرعاة رسميّين للتّوليمبيّات

59
00:03:22,570 --> 00:03:27,580
النّبيذ والخبز واللّحم والسّمك
!والجبن والفاكهة وزيت الزّيتون

60
00:03:27,580 --> 00:03:31,520
ستصبح أجساد الرّياضيّين بالكامل
!وسائط للإعلانات

61
00:03:28,210 --> 00:03:31,520
أسماك ميليتون الطّازجة

62
00:03:31,520 --> 00:03:33,890
!فهمت! سيجني ذلك مالاً كثيرًا

63
00:03:36,610 --> 00:03:37,950
.المعذرة

64
00:03:37,950 --> 00:03:40,000
.لدينا ضيوف يا ديميتريوس

65
00:03:40,000 --> 00:03:42,530
كيف لي أن أساعدكم أيّها الرّعاة؟

66
00:03:42,530 --> 00:03:44,280
.هذا بشأن التّوليمبيّات

67
00:03:44,280 --> 00:03:48,410
هل بإمكانكم تأجيلها حتّى نهاية
موسم جني الزّيتون؟

68
00:03:48,410 --> 00:03:52,240
هل بإمكانكم الصّراخ باسم منتجي
عندما يقطع الرّياضيّ خطّ النّهاية؟

69
00:03:52,240 --> 00:03:53,920
أخبر الرّياضيّين أن يتحرّكوا

70
00:03:53,920 --> 00:03:57,580
ليستطيع الجمهور رؤية
.اسم منتجي طوال الوقت

71
00:03:58,210 --> 00:04:00,520
.إنّها رياضات تنافسيّة
...لا يمكننا تلبية هذه الطّلبات

72
00:04:00,520 --> 00:04:02,850
!إنّنا ندفع المال لقاء هذا

73
00:04:03,900 --> 00:04:06,160
...لديّ مشاكل أكثر الآن

74
00:04:06,410 --> 00:04:07,550
!لن أعيد مالهم

75
00:04:08,320 --> 00:04:10,250
كلمات: فوجي ريو
ألحان: هاياشي أكيتو