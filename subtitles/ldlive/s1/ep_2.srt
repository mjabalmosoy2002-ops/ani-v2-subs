1
00:01:42,660 --> 00:01:44,580
!واو

2
00:01:45,410 --> 00:01:46,820
!حسناً، تبديل

3
00:01:49,390 --> 00:01:51,670
.مهاراتكِ في التّنس تظهر بقوّة، ميسوزو

4
00:01:51,670 --> 00:01:54,740
.طالبةٌ عاديّةٌ في المُتوَسّطة لَن تتمكّن من ضربها

5
00:01:54,740 --> 00:01:58,420
.كانت ضربةً عاديّةً بالنّسبة لشخصٍ لعِب التّنس لـ12 شهراً

6
00:01:58,420 --> 00:02:01,960
.ماذا بحقّ الله؟ هذا مُضحك، ميسوزو

7
00:02:05,330 --> 00:02:10,680
.هؤلاء الفتيان يستمرّون بالتّحديق بميسوزو. أولئكَ المُنحرفين

8
00:02:15,100 --> 00:02:18,010
هل تعرفين كوكونوسي كن، ميسوزو؟

9
00:02:18,010 --> 00:02:19,110
لماذا تسألين؟

10
00:02:19,110 --> 00:02:21,360
.تقابلَت عيناكما للتّوّ

11
00:02:21,720 --> 00:02:23,410
،كنتُ أنظر إليه فقط

12
00:02:23,410 --> 00:02:25,990
.على أمل أن يختفي دون أثر

13
00:02:27,110 --> 00:02:28,370
ماذا بحقّ الله؟

14
00:02:31,150 --> 00:02:33,470
هل تضحك عليّ؟

15
00:02:34,010 --> 00:02:36,300
...هذا مُزعجٌ جدّاً

16
00:02:38,670 --> 00:02:42,370
...ميسوزو سونوكاتا؟ لماذا

17
00:02:42,630 --> 00:02:44,920
.هي مُوَظّفةٌ هُنا أيضاً

18
00:02:44,920 --> 00:02:47,310
.جعلتُها تُراقبكَ لفترة

19
00:02:47,310 --> 00:02:50,170
هي... كانت تُراقبني؟

20
00:02:50,170 --> 00:02:52,720
.أيّها الرّئيس، مازلتُ ضدّ هذا

21
00:02:54,070 --> 00:02:58,210
.كما ذكرتُ مُسبقاً، هو لَيس مُؤهّلاً ليكون ضابط شُرطة

22
00:02:58,210 --> 00:02:59,750
...نعم، حسناً

23
00:02:59,750 --> 00:03:02,800
.ظهرَ بأنّ السّبب بتحدّثه مع نفسه هو المونيتاليان

24
00:03:02,800 --> 00:03:04,450
.لَم يكن يُعاني من الأوهام بعد كلّ شيء

25
00:03:04,450 --> 00:03:07,610
.كلّا. تُوجد مشاكلٌ أكثر إلحاحاً بكثيرٍ بين أيدينا

26
00:03:07,610 --> 00:03:08,560
...فوق كلّ شيء

27
00:03:09,140 --> 00:03:11,220
.تشوتا كوكونوسي مُنحرف

28
00:03:11,830 --> 00:03:13,630
.إنّه شديد الإنحراف

29
00:03:13,630 --> 00:03:16,190
.أشكّ في أنّ حياته اليوميّة مليئةٌ بالإنحراف

30
00:03:16,170 --> 00:03:19,050
...و لَيس بشكلٍ بسيطٍ سينتهي حالَما يصل إلى سنّ البُلوغ

31
00:03:19,050 --> 00:03:24,960
.حسناً، على أيّة حال، إبذل جهدك، مثل ميسوزو و تشيبس في القِسم 2

32
00:03:25,490 --> 00:03:26,470
...حسناً

33
00:03:27,740 --> 00:03:30,670
...بالتّفكير بأنّ سونوكاتا هي أيضاً عُضوةٌ في الشّرطة الفضائيّة

34
00:03:30,670 --> 00:03:34,700
.ألَيس هذا رائعاً؟ تنس الفتيات

35
00:03:34,700 --> 00:03:35,620
تاتيان؟

36
00:03:35,620 --> 00:03:38,180
.أُريد الذّهاب إلى هناك أيضاً

37
00:03:38,970 --> 00:03:42,120
...لا يذكر ما حصل وَقتها

38
00:03:44,710 --> 00:03:48,880
.بالتّفكير بالأمر، كلّ ما حصل البارحة كان لا يُصدّق

39
00:03:49,980 --> 00:03:53,800
...إنتظر، أظنّني أنسى أمر أكثر شيءٍ لا يُصدّق

40
00:03:53,800 --> 00:03:56,160
.ميسوزو تكرهك، تشوتا

41
00:03:57,130 --> 00:03:58,460
!ها هو! ذلك الشّيء الغريب

42
00:03:58,460 --> 00:04:00,970
ما الخطب، تشوتا؟
هل تتحدّث مع نفسكَ ثانيةً؟

43
00:04:00,970 --> 00:04:01,560
هاه؟

44
00:04:01,560 --> 00:04:04,000
!أوه، نـ-نـ-نـ-نعم

45
00:04:04,000 --> 00:04:05,710
.هذا لا شيء، لذا لا تقلَق بشأنه

46
00:04:05,710 --> 00:04:06,510
!تتّجه نحوك

47
00:04:13,040 --> 00:04:15,750
هاي، هل أنتَ بخير، تشوتا؟

48
00:04:17,860 --> 00:04:19,980
،سأخرج لبعض الوَقت

49
00:04:19,980 --> 00:04:21,990
.لكن تأكّد من الحُصول على بعض الرّاحة

50
00:04:21,990 --> 00:04:23,070
...نعم، سيّدتي

51
00:04:26,810 --> 00:04:27,760
.لَقد غادرَت

52
00:04:27,760 --> 00:04:28,730
.نعم، بالفِعل

53
00:04:29,630 --> 00:04:32,670
أمازلتَ عالِقاً بي؟

54
00:04:32,670 --> 00:04:34,890
.على ما يبدو، شعرتُ بالإرهاق و نِمت

55
00:04:34,890 --> 00:04:39,040
.التّجسّد بهذا الشّكل يستهلك مِقداراً لا يُمكن تخيّله من الطّاقة

56
00:04:39,370 --> 00:04:40,980
!عن ماذا تتحدّث؟

57
00:04:40,980 --> 00:04:43,620
!بالتّفكير بأنّ ذلك الصّوت كان ينتمي إلى شيءٍ بغرابتك

58
00:04:43,620 --> 00:04:45,500
ماذا أنتَ بحقّ الله على أيّة حال؟

59
00:04:45,500 --> 00:04:47,540
.مونيتاليان من الجّيل الرّابع

60
00:04:47,540 --> 00:04:51,290
.نوعٌ داعمٌ لكوكبٍ مائيٍّ، نوع دولوبريت 390

61
00:04:51,290 --> 00:04:54,590
!إسمكَ طويلٌ جدّاً
.يُفترض أن يكون دولو كافياً

62
00:04:56,760 --> 00:04:58,470
!دولو؟

63
00:04:58,470 --> 00:05:01,350
!دولو! دول-دول-دول-دولو

64
00:05:01,350 --> 00:05:03,680
!دولو

65
00:05:04,820 --> 00:05:06,080
.إنّه يُعجبني

66
00:05:07,130 --> 00:05:09,160
...بالتّفكير بالأمر

67
00:05:09,160 --> 00:05:11,330
...ذلك الفشل المُحرج وَقتها

68
00:05:11,330 --> 00:05:13,450
...تلك التّجربة المُحرجة في ذلك الوَقت

69
00:05:13,450 --> 00:05:16,660
!هذا خطأُك! أعِد لي شبابي

70
00:05:16,970 --> 00:05:19,900
.بالنّسبة للعُمر، شبابكَ في بدايته فقط

71
00:05:19,900 --> 00:05:23,140
!لا تُحاضرني بشأن هذا! أُخرج فقط

72
00:05:23,140 --> 00:05:25,320
.لَن أفعل هذا لَو كنتُ مكانك، تشوتا

73
00:05:25,930 --> 00:05:27,510
...لا يُمكنني التّنفّس

74
00:05:27,510 --> 00:05:32,880
.أنتَ و أنا شخصٌ وَاحد. إن كنتُ أُعاني، ستُعاني أيضاً

75
00:05:32,880 --> 00:05:35,020
!إذاً كيف يُفترض بي أن أسحبكَ للخارج؟

76
00:05:35,020 --> 00:05:37,860
.لا يُمكنكَ أن تسحبني للخارج إلّا إن مِتّ

77
00:05:37,860 --> 00:05:39,550
!كلّا

78
00:05:39,550 --> 00:05:41,760
إذاً عليّ العيش هكذا إلى الأبد؟

79
00:05:41,760 --> 00:05:45,070
!هناك جُزءٌ حسّاسٌ ينمو منّي؟
.هذا كلّ ما أحتاجه

80
00:05:48,990 --> 00:05:52,070
هل سمِعَتني؟ أم هل أنا بأمان؟

81
00:05:52,420 --> 00:05:55,150
.ياله من كلامٍ سُوقيّ
.أنتَ مُنحرفٌ حقّاً

82
00:05:55,150 --> 00:05:57,370
!لَقد سمِعَتني

83
00:05:57,790 --> 00:05:59,100
.نحتاج للذّهاب إلى مُناوبتنا المَسائيّة

84
00:05:59,100 --> 00:06:01,120
هاه؟ هل تعنين لإلدلايف؟

85
00:06:01,120 --> 00:06:05,000
ماذا غير هذا؟ أم هل تُفضّل الإستقالة؟

86
00:06:05,000 --> 00:06:07,970
هاه؟ هل... يُمكنني الإستقالة؟

87
00:06:08,390 --> 00:06:12,330
.بالتّأكيد. يُمكنكَ أن تهرب و ذيلكَ بين قدميكَ دون أن تتركَ أثراً

88
00:06:12,330 --> 00:06:16,470
.في الوَاقع، عليكَ أن تبني شجاعةً لتختفي بالكامل

89
00:06:17,330 --> 00:06:19,430
!لا تُخبريني بهذا

90
00:06:19,430 --> 00:06:22,440
.د-دون ذِكر أنّ لَدينا حِصصٌ الآن

91
00:06:22,440 --> 00:06:25,360
حتّى لو كنتُ المُديرة، سآتي من

92
00:06:25,360 --> 00:06:28,990
.أجل مُناوبتي في إلدلايف، حتى لَو عنى هذا تفويت اجتماع قِمّة

93
00:06:29,330 --> 00:06:30,490
.لَيس من السّهل كثيراً فهم هذا

94
00:06:30,780 --> 00:06:32,350
.تفتقد لمهارات الإدراك

95
00:06:34,130 --> 00:06:37,810
.حسناً. سأُخبر الرّئيس بأنّه لا يُمكنكَ القُدوم بسبب الحِصص

96
00:06:37,810 --> 00:06:38,580
...ماذا

97
00:06:41,260 --> 00:06:43,550
.هي مُزعجةٌ جدّاً

98
00:06:44,080 --> 00:06:46,290
ألَن تتبع ميسوزو؟

99
00:06:46,290 --> 00:06:48,220
!هواه! لا تقفز للخارج فجأةً هكذا

100
00:06:48,220 --> 00:06:51,390
!سنتأخّر على إلدلايف
.سنتأخّر في يومنا الأوّل

101
00:06:51,390 --> 00:06:54,930
إنتظر، دولو. لماذا ترغب بالذّهاب بهذه الشدّة؟

102
00:06:55,340 --> 00:06:56,190
.أشعر بالفُضول

103
00:06:56,190 --> 00:06:57,050
هاه؟

104
00:06:57,050 --> 00:07:00,200
.تمّت صِناعة المونيتاليان لجمع المعلومات

105
00:07:00,200 --> 00:07:01,940
.صُنِعنا بحِسٍّ قويٍّ من الفُضول

106
00:07:01,940 --> 00:07:03,680
ما شأني بهذا؟

107
00:07:04,090 --> 00:07:05,950
ألَن تذهب، تشوتا؟

108
00:07:08,520 --> 00:07:11,190
،لا أفهم شُرطة الفضاء حقّاً

109
00:07:11,940 --> 00:07:15,760
.لكن لا يُعجبني أن تستهزئ بي سونوكاتا هكذا

110
00:07:19,170 --> 00:07:22,070
دون ذِكر، لماذا مُناوبةٌ مَسائيّة؟

111
00:07:22,070 --> 00:07:23,810
.مازلنا في مُنتصف اليوم

112
00:07:24,200 --> 00:07:26,750
.البارحة، كان المكان مُعتماً في الخارج في الفضاء

113
00:07:27,030 --> 00:07:30,490
.رُبّما يوم و مَساء الفضاء عكس الأرض

114
00:07:30,840 --> 00:07:32,300
...صحيح

115
00:07:33,140 --> 00:07:37,740
هاه؟ إلى أين ذهبَت سونوكاتا؟
...ظننتُها كانت حول هذا المكان

116
00:07:39,180 --> 00:07:40,550
.إلى هُنا، تشو

117
00:07:42,950 --> 00:07:46,930
!أما المُفتّش تشيبس، تشو
!أسرِع و ادخل، تشو

118
00:07:48,370 --> 00:07:49,670
أين نحن؟

119
00:07:49,670 --> 00:07:51,940
.أحد أفرُع إلدلايف الأرضيّة

120
00:07:53,080 --> 00:07:55,370
.لا يُوجد شيءٌ هُنا

121
00:07:55,870 --> 00:07:59,680
.إنّه هُنا فقط لنتمكّن من الإنتقال إلى المَحطّة دون أن نُكشف

122
00:07:59,680 --> 00:08:02,370
الأهمّ، هل ستأتي إلى مُناوبتكَ حقّاً؟

123
00:08:02,370 --> 00:08:04,780
!حسناً، نـ-نعم

124
00:08:05,280 --> 00:08:07,120
!حسناً، ها نحن ذا، تشو

125
00:08:08,010 --> 00:08:11,220
.تمّ تأكيد التّغيّرات في جُزيئات الهدف

126
00:08:11,220 --> 00:08:12,860
!أرجوكَ قُم بالنّقل، تشو

127
00:08:12,860 --> 00:08:14,040
.أُترك الأمر لي، شيرو

128
00:08:18,170 --> 00:08:20,460
.كنّا مَقلوبين ثانيةً، تشو

129
00:08:20,460 --> 00:08:23,590
.هيّا الآن، يا ضابط إدارة النّقل، شيرونيمو

130
00:08:25,000 --> 00:08:27,750
.هاه؟ الوَضع هادئٌ جدّاً اليوم

131
00:08:28,630 --> 00:08:31,390
.غادر مُوَظّفوا المُناوبة الصّباحيّة الآن، تشو

132
00:08:31,390 --> 00:08:34,190
...فهمت. إذاً لهذا هي المُناوبة المَسائيّة

133
00:08:36,980 --> 00:08:38,340
...كنتُ بالإنتظار

134
00:08:38,340 --> 00:08:39,290
.أنتُما

135
00:08:39,710 --> 00:08:41,910
هاه؟ الرّئيس لاين؟

136
00:08:42,570 --> 00:08:43,450
.نعم

137
00:08:44,740 --> 00:08:47,500
...تشوتا كوكونوسي و المونيتاليان

138
00:08:56,660 --> 00:08:58,340
...أمم... أوه

139
00:08:58,640 --> 00:09:00,340
!أيّها الرّئيس، كلّا

140
00:09:00,340 --> 00:09:02,260
!لا يُمكنكَ أن تنام هُنا، تشو

141
00:09:02,260 --> 00:09:03,680
متى نام؟

142
00:09:05,300 --> 00:09:07,480
.تشيبس، كُن مُتأهّبً عند مِنصّة القيادة

143
00:09:07,480 --> 00:09:10,510
.ميسوزو، خُذي تشوتا بجولةٍ في المكتب

144
00:09:11,160 --> 00:09:12,770
!يويوسا

145
00:09:11,160 --> 00:09:12,770
...يويوسا

146
00:09:13,550 --> 00:09:15,670
.شُرطة فضاء إلدلايف

147
00:09:15,670 --> 00:09:19,880
.مكتبهم في هذا النّظام الشّمسيّ هو هذه السّفينة الفضائيّة، جيانيرنو-آر

148
00:09:20,740 --> 00:09:23,720
،هذه السّفينة مُجهّزةٌ بتكنولوجيا مُتطوّرةً من تقديم حضارة إل

149
00:09:23,720 --> 00:09:25,990
.و التي سنتوَصّل لها نحن على الأرض في النّهاية

150
00:09:25,990 --> 00:09:27,740
...فـ... فهمت

151
00:09:27,740 --> 00:09:31,480
هناك رُقاقاتٌ شبيهةٌ بالفيروس تعمل على متن السّفينة

152
00:09:31,480 --> 00:09:35,080
.و حالما تتنفّسها، ستتمكّن من الحديث مع جميع الفضائيّين هُنا

153
00:09:36,110 --> 00:09:39,670
.هذه غُرفة المَرضى
.الطّبيب إسحاق هو المَسؤول هُنا

154
00:09:40,590 --> 00:09:41,380
...مرحباً

155
00:09:42,260 --> 00:09:46,550
.هذه غُرفة عمليّات النّقل
.هذا هو الضّابط شيرونيمو من الرّتبة الثّانية

156
00:09:46,550 --> 00:09:48,020
.سعيدٌ بمُقابلتك، شيرو

157
00:09:48,020 --> 00:09:49,880
...إذاً هذا هو رجل النّقل

158
00:09:50,390 --> 00:09:52,110
.هذه غُرفة الإستجواب

159
00:09:52,660 --> 00:09:55,110
.و هذا مكتب أبحاث الإس بي إتش

160
00:09:55,110 --> 00:09:57,400
إس بي... ماذا؟

161
00:09:59,030 --> 00:10:01,620
...و تمّ تعييننا هُنا

162
00:10:02,950 --> 00:10:04,290
.دائرة التّحقيق

163
00:10:05,160 --> 00:10:07,390
.تُوجد ستّة أقسامٍ في دائرة التّحقيق

164
00:10:07,390 --> 00:10:11,750
.أنتَ و أنا و المُفتّش تشيبس مُعيّنون في القِسم 2

165
00:10:12,400 --> 00:10:16,070
ممّا يعني أنّه يُوجد المزيد أكثر من الأشخاص عداكِ أنتِ و تشيبس؟

166
00:10:16,490 --> 00:10:18,940
.يعمل 20 شخصاً في دائرة التّحقيق

167
00:10:18,940 --> 00:10:19,880
هذا العدد الكبير؟

168
00:10:20,370 --> 00:10:23,140
.مُديرنا في القِسم 2 هو رئيس القِسم ماديغان

169
00:10:23,140 --> 00:10:24,880
،من النّادر أن يُظهِر وَجهه

170
00:10:25,380 --> 00:10:27,860
.لكن عندما يفعل، من الأفضل لكَ أن تهرب

171
00:10:27,860 --> 00:10:29,100
!ماذا بحقّ الله؟

172
00:10:29,860 --> 00:10:32,270
.و هذا هو مركز الإحتجاز

173
00:10:32,270 --> 00:10:33,100
إذاً هو كالسّجن؟

174
00:10:33,470 --> 00:10:38,450
.بشكلٍ مُؤقّت. الكابروليان الذي قبضتّ عليه هُنا

175
00:10:38,450 --> 00:10:39,130
هاه؟

176
00:10:40,250 --> 00:10:45,280
.أوه، أنتِ مُحقّة
...إنّه ساوتومي سينساي السّابقة

177
00:10:45,890 --> 00:10:49,950
إذاً، هل يحصل المُجرمون على حُكم الإعدام؟

178
00:10:49,950 --> 00:10:52,740
.القانون بين المجرّات يُعطي الأولويّة لإعادة التّأهيل

179
00:10:52,740 --> 00:10:55,540
.في مُعظم الحالات، يُرسَل المُجرمون إلى مركز إعادة التّأهيل

180
00:10:55,890 --> 00:10:58,800
.واو، إذاً حتّى المُجرمون يحصلون على فُرصةٍ ثانية

181
00:10:58,800 --> 00:11:00,040
.هذا نظامٌ جيّد

182
00:11:01,610 --> 00:11:03,430
ماذا قد تعرف؟

183
00:11:03,710 --> 00:11:04,460
هاه؟

184
00:11:09,650 --> 00:11:11,370
...أمم

185
00:11:14,240 --> 00:11:15,680
...أمم

186
00:11:15,680 --> 00:11:17,600
.لَقد غضبَت ميسوزو

187
00:11:17,600 --> 00:11:22,610
أمم... هل تُمانعين إن تجوّلتُ في المكتب لوَحدي قليلاً؟

188
00:11:29,620 --> 00:11:31,620
.هذا المكان ضخمٌ بالفِعل

189
00:11:31,620 --> 00:11:33,820
.كانت ميسوزو بمزاجٍ سيّء

190
00:11:34,630 --> 00:11:38,550
.حسناً، تبدو سونوكاتا كما لَو أنّها غاضبةٌ منّي طوال الوَقت

191
00:11:38,550 --> 00:11:41,330
.و يبدو بأنّكَ تغضب بسهولةٍ عندما يتعلّق الأمر بميسوزو

192
00:11:41,680 --> 00:11:46,700
.لا أعلَم لماذا، لكن كلّما تحدّثتُ إلى سونوكاتا، أنزعج كثيراً

193
00:11:46,700 --> 00:11:52,970
رُبّما... هذا لأنّني ظننتُ بأنّ سونوكاتا كانت ظريفةً في
...البداية، لذا عندما تقول أُموراً لئيمة

194
00:11:52,970 --> 00:11:54,000
.تشوتا

195
00:11:55,080 --> 00:11:56,540
أين نحن؟

196
00:11:56,540 --> 00:11:59,100
...أين؟ نحن في

197
00:11:59,810 --> 00:12:00,770
...إنتظر

198
00:12:00,770 --> 00:12:03,440
هل ضِعنا؟

199
00:12:21,480 --> 00:12:23,290
...هاه؟ هذا لَيس جيّداً

200
00:12:23,290 --> 00:12:25,460
.هذا فقط سيجعل سونوكاتا تتذمّر ثانيةً

201
00:12:26,580 --> 00:12:30,210
!هذا الرّمز 7! هذا الرّمز 7

202
00:12:30,050 --> 00:12:32,260
هل انتهى بي الأمر في مكانٍ غريب؟

203
00:12:30,630 --> 00:12:32,890
!هرب مُشتبهٌ به من مركز الإحتجاز

204
00:12:32,990 --> 00:12:34,010
!هرب؟

205
00:12:38,430 --> 00:12:39,550
!توَقّف

206
00:12:45,980 --> 00:12:47,910
هاه؟ ماذا؟ ماذا يجب أن أفعل؟

207
00:12:46,550 --> 00:12:50,490
!أُعيد، مُشتبهٌ به يتّجه نحو بي43

208
00:12:48,890 --> 00:12:50,490
!سونوكاتا

209
00:12:50,490 --> 00:12:52,490
.هناك تُوجد غُرفة النّقل 2

210
00:12:54,710 --> 00:12:56,160
.ضابط الرّتبة الثّانية، شيرونيمو

211
00:12:56,900 --> 00:13:01,450
.أعتذر... الذي هرب هو المُجرم الشّرس، دراغلاين

212
00:13:01,450 --> 00:13:05,290
.لَقد نقل نفسه، شيرو
.كان يتّجه إلى الأرض، شيرو

213
00:13:05,990 --> 00:13:07,020
إلى الأرض؟

214
00:13:07,020 --> 00:13:07,920
.سأتبعه

215
00:13:07,920 --> 00:13:09,300
سـ-ستتبعينه؟

216
00:13:09,580 --> 00:13:11,960
.أنا الوَحيدة المُتاحة حاليّاً

217
00:13:13,030 --> 00:13:14,810
أمازالت وِحدة النّقل فاعِلة؟

218
00:13:15,140 --> 00:13:16,560
.سأُجرّبها، شيرو

219
00:13:17,760 --> 00:13:19,500
ألَن تذهب، تشوتا؟

220
00:13:19,500 --> 00:13:21,520
حسناً، إنّه مُجرمٌ شرس، صحيح؟

221
00:13:21,520 --> 00:13:23,770
ستذهب ميسوزو، لكنّكَ لَن تذهب؟

222
00:13:24,760 --> 00:13:27,830
...حسناً... أظنّ أنّه يُمكنني إيجاد مُجرمٍ على الأقلّ

223
00:13:27,830 --> 00:13:31,650
.وَاثقٌ من أنّ الضّبّاط الآخرين سيأتون لإنقاذنا بعد بعض الوَقت

224
00:13:31,650 --> 00:13:34,400
.أرجوكَ لا تأتي إن كنتَ ستكون بهذه السّذاجة

225
00:13:34,400 --> 00:13:36,040
.كما لَو أنّكَ طالبٌ في المُتوَسّطة

226
00:13:36,380 --> 00:13:39,710
!ماذا... بالتّأكيد! أنا بالفِعل طالبٌ في المُتوَسّطة

227
00:13:40,000 --> 00:13:42,580
.لَو سمحت، يا ضابط الرّتبة الثّانية، شيرونيمو

228
00:13:42,580 --> 00:13:43,340
.أُتركي الأمر لي، شيرو

229
00:13:43,930 --> 00:13:45,000
!هاي إنتظري لَحظة

230
00:13:45,000 --> 00:13:46,010
!نقل

231
00:13:46,860 --> 00:13:47,960
!أوو

232
00:13:48,680 --> 00:13:52,480
!نحن مَقلوبون ثانيةً
..."يال هُراء "أُتركي الأمر لي، شيرو

233
00:13:52,910 --> 00:13:54,090
أمم، أين نحن؟

234
00:13:54,090 --> 00:13:56,150
.بالقُرب من الفِرع المَحلّيّ

235
00:13:56,150 --> 00:13:59,430
.على ما يبدو، لَم يُغيّر الإحداثيّات منذ أن توَجّهنا إلى المكتب

236
00:13:59,940 --> 00:14:01,640
...أتسائل إلى أين ذهب

237
00:14:01,640 --> 00:14:04,280
،الفضائيّ من روسينبير، دراغلاين

238
00:14:04,280 --> 00:14:08,100
.تمّ القبض عليه بعد ارتكابه لثلاث هجمات قتلٍ عشوائيّْ للمُتعة

239
00:14:08,110 --> 00:14:10,160
!قتلٌ عشوائيّ؟

240
00:14:10,160 --> 00:14:12,450
إذاً يتّجه نحو منطقة التّسوّق المُزدحمة؟

241
00:14:12,450 --> 00:14:13,240
.كلّا

242
00:14:13,870 --> 00:14:18,370
...بالنّظر إلى وَضعه، أوّل ما سيُفكّر به على الأرجح هو

243
00:14:20,690 --> 00:14:22,280
!هواه، الفِرع المَحلّيّ

244
00:14:22,810 --> 00:14:25,750
.هو بالإعتناء بأمر أيّ ضُبّاطٍ يتبعونه

245
00:14:33,650 --> 00:14:35,130
.يبدو كسلطعون، تشوتا

246
00:14:35,860 --> 00:14:37,260
!مُقرفٌ جدّاً

247
00:14:39,290 --> 00:14:43,900
.نحن إلدلايف. لا تُحاول المُقاومة، و تعال بهُدوء

248
00:14:46,150 --> 00:14:47,750
!لا أظنّه سيستمع لكِ

249
00:14:47,750 --> 00:14:49,280
.لنَقبض عليه، تشوتا

250
00:14:49,280 --> 00:14:51,070
!لا يُمكننا القبض على ذلك الشّيء

251
00:14:53,270 --> 00:14:54,320
!سونوكاتا

252
00:14:54,640 --> 00:14:58,200
!لَديكَ الحقّ بالتزام الصّمت و الحقّ بالحُصول على مُحامٍ

253
00:15:03,150 --> 00:15:04,250
...و

254
00:15:04,670 --> 00:15:08,660
.كلّ ما تقوله يُمكن و سيُستخدم ضدّكَ في مَحكمة القانون الكونيّة

255
00:15:12,990 --> 00:15:17,710
!تبّاً لمَحكمة قانونكم
!سأقتل كما أُريد

256
00:15:18,250 --> 00:15:20,470
هل تنوي المُقاومة؟

257
00:15:21,150 --> 00:15:22,980
!إس بي إتش

258
00:15:25,900 --> 00:15:26,960
هل هرب؟

259
00:15:26,960 --> 00:15:29,140
.إنّه يختبئ فقط

260
00:15:29,450 --> 00:15:33,230
.سـ-سأُقتَل عند قتال وَحشٍ كهذا دون سِلاح

261
00:15:33,230 --> 00:15:37,280
أنا هُنا! قبضنا على ذلك السّائل-السّائل البارحة معاً، صحيح؟

262
00:15:37,280 --> 00:15:40,400
.كانت البارحة مُصادفةً فقط
.لا يُمكنني فِعل هذا

263
00:15:40,790 --> 00:15:43,640
إذاً ستعود ببساطةٍ كونكَ مُتشائماً، تشوتا؟

264
00:15:43,640 --> 00:15:47,980
.البارحة، عزّزتَ من ثقتكَ بنفسكَ و أيقظتَ قِواي

265
00:15:47,980 --> 00:15:51,420
.ظننتكَ استعدتّ ثِقتكَ بنفسكَ و تقبّلتَ ماضيك

266
00:15:55,020 --> 00:15:58,140
.من المُستحيل أن أتمكّن من التّغيّر بهذه السّهولة

267
00:15:58,140 --> 00:16:01,890
!دون ذِكر بأنّه خطأُكَ جُزئيّاً انتهاء الأمر بي هكذا

268
00:16:02,280 --> 00:16:05,140
.بسببكَ انتهى بي الأمر بقول "جُزءٍ حسّاسّ" أمام سونوكاتا اليوم

269
00:16:05,570 --> 00:16:07,700
.أرجوكَ توَقّف عن قول مثل هذه الأشياء السّوقيّة

270
00:16:07,700 --> 00:16:11,900
.أوه، صحيح... لا يُمكن لسونوكاتا أن تسمع صوت دولو

271
00:16:12,830 --> 00:16:14,520
.لكنّكَ جعلتَ الأمر وَاضحاً جدّاً

272
00:16:14,520 --> 00:16:15,440
هاه؟

273
00:16:17,350 --> 00:16:21,540
.إن لَم يكن بإمكانكَ قتال هذا المُجرم الشّرس، فأنتَ لا تستحقّ بأن تكون في إلدلايف

274
00:16:21,540 --> 00:16:23,710
.أرجوكَ استقل دون ترك أثر

275
00:16:36,740 --> 00:16:39,470
.تشوتا! مُسنّةٌ و بعض الكلاب يقتربون

276
00:16:41,520 --> 00:16:43,010
هاي، ما الخطب؟

277
00:16:46,090 --> 00:16:47,770
...أوّلاً، سأقضي على تلك المُسنّة

278
00:16:48,640 --> 00:16:50,390
!وَ-وَ-وَحش

279
00:16:55,540 --> 00:16:57,150
!أحسنت، تشوتا

280
00:16:57,150 --> 00:16:59,030
...أنا... فعلتُ هذا دون تفكير

281
00:17:00,040 --> 00:17:01,330
!إنّه قادم، تشوتا

282
00:17:02,490 --> 00:17:04,160
!دولو، لنقُم بخياطته

283
00:17:04,820 --> 00:17:06,070
!التّقمّص

284
00:17:09,930 --> 00:17:12,420
...لَقد صدّها؟ مُستحيل

285
00:17:12,950 --> 00:17:16,530
هل تعبث؟

286
00:17:21,140 --> 00:17:22,000
!دولو

287
00:17:33,260 --> 00:17:37,200
...الهرب، و المُقاومة المُستمرّة، و

288
00:17:39,140 --> 00:17:41,110
.مُهاجمة المَدنيّين...

289
00:17:42,660 --> 00:17:46,950
.تأكيد بأنّ القبض على المُجرم أمرٌ صعب

290
00:17:47,510 --> 00:17:49,160
.سأقوم بوَاجبي حسب التّعليمات

291
00:17:49,160 --> 00:17:51,460
هاه؟ سـ-سونوكاتا؟

292
00:17:53,320 --> 00:17:56,210
.هذه الرّائحة... إنّها رائحةٌ جميلةٌ من الصّفّ

293
00:18:20,140 --> 00:18:20,980
.ها أنا ذا

294
00:18:22,180 --> 00:18:24,820
!مُوتي، إلدلايف

295
00:18:33,040 --> 00:18:35,360
.أرجوكَ اختفي دون أثر

296
00:18:57,150 --> 00:18:58,520
...كنتُ مَذهولاً

297
00:19:00,050 --> 00:19:03,190
لكن... هل يعني هذا بأنَكِ قتلتِ المُجرم؟

298
00:19:03,190 --> 00:19:04,360
.بالتّأكيد

299
00:19:04,790 --> 00:19:07,650
.تجاهلَ تحذيراتي و هاجم

300
00:19:09,650 --> 00:19:12,580
.تبدو ميسوزو شائكة

301
00:19:12,830 --> 00:19:15,240
.بل بالأحرى شائكةٌ جدّاً

302
00:19:15,730 --> 00:19:18,050
...كِلانا طالِبان في المُتوَسّطة، لكن

303
00:19:18,050 --> 00:19:20,060
...كما لَو أنّ ميسوزو سونوكاتا...

304
00:19:22,200 --> 00:19:24,620
.هي فتاة فضاءٍ رائعةٌ جدّاً...

305
00:19:31,510 --> 00:19:33,770
هل أنتِ بخير، ميسوزو؟

306
00:19:34,050 --> 00:19:35,060
.نعم

307
00:19:35,060 --> 00:19:38,900
...القضاء على المُجرم الهارب
لَم تكبحي نفسكِ بالتّأكيد، صحيح؟

308
00:19:38,900 --> 00:19:40,340
.شُكراً على عملكم الجادّ

309
00:19:40,340 --> 00:19:44,570
.هناك أرضيّون قد شاهدوا المعركة، أرجوكم اتّخذوا الإجراءات الضّروريّة

310
00:19:45,030 --> 00:19:46,460
!يويوسا

311
00:19:46,460 --> 00:19:49,780
.أوه، إذاً لابدّ من أنّكَ الأرضيّ المُبتدئ

312
00:19:49,780 --> 00:19:51,110
هاه؟ أنا؟

313
00:19:51,460 --> 00:19:54,250
.لَم يعُد مُبتدئاً معنا

314
00:19:54,250 --> 00:19:56,590
.على ما يبدو، لا يُريد أن تكون له علاقةٌ بإلدلايف

315
00:19:56,590 --> 00:19:57,840
هاه؟

316
00:19:57,840 --> 00:20:04,140
.شُكراً جزيلاً لك. لا أعلَم ماذا كانا ليفعلا لَو مِتّ

317
00:20:04,140 --> 00:20:05,510
...أنتِ المُسنّة منذ السّابق

318
00:20:05,510 --> 00:20:08,930
.كلّ هذا لأنّكَ حمَيتَني

319
00:20:08,930 --> 00:20:10,510
هاه؟ أنا؟

320
00:20:10,510 --> 00:20:13,380
.نعم. لَقد أنقذتَ حياتي

321
00:20:14,420 --> 00:20:16,770
.شُكراً جزيلاً لك

322
00:20:17,550 --> 00:20:19,760
...هـ-هذا لَم يكن شيئاً يُذكر

323
00:20:22,930 --> 00:20:25,900
.لابدّ من أنّها كانت مِحنة، سيّدتي

324
00:20:25,900 --> 00:20:28,460
.أرجوكِ تعالي من هُنا

325
00:20:34,020 --> 00:20:36,230
.يبدو بأنّكَ تقبّلتَ نفسكَ أكثر قليلاً

326
00:20:36,230 --> 00:20:37,120
هاه؟

327
00:20:37,550 --> 00:20:42,600
.بنفس الوَقت، أنتَ تتقبّل وُجودي، لذا يُمكنني أن أعرف

328
00:20:42,600 --> 00:20:44,920
.أنتَ بالفِعل مُختلِفٌ بالكامل عن منذ يومين، تشوتا

329
00:20:45,280 --> 00:20:49,100
.لا أنوي تقبّلك، دولو

330
00:20:56,890 --> 00:20:57,890
...لكن

331
00:20:59,030 --> 00:21:02,250
...مرّت فترةٌ طويلةٌ منذ شُعوري هكذا

332
00:21:05,000 --> 00:21:08,460
.عليّ إكمال تقريري، لذا سأعود إلى المكتب

333
00:21:08,460 --> 00:21:10,850
.يُمكنكَ العودة إلى المدرسة إن أردتّ

334
00:21:12,110 --> 00:21:13,750
.ستستقيل على أيّة حال

335
00:21:14,160 --> 00:21:17,210
!إنتظري لَحظة! لَم أقل أبداً بأنّني سأستقيل

336
00:21:19,880 --> 00:21:21,130
...و

337
00:21:21,620 --> 00:21:25,120
!إن كنتُ سأستقيل، سأُخبر الرّئيس بنفسي

338
00:21:33,270 --> 00:21:36,920
.إنتهى بكَ الأمر بالتّأكيد بمَشهدٍ مُقرفٍ جدّاً منذ البداية

339
00:21:36,920 --> 00:21:39,100
.أرجوكَ استخدم هذه لمَسح الدّم من على وَجهك

340
00:21:39,100 --> 00:21:40,090
دَم؟

341
00:21:42,830 --> 00:21:44,210
أخضر؟

342
00:21:45,260 --> 00:21:46,820
....د-د-د-د-د

343
00:21:46,820 --> 00:21:48,950
!دمّ

344
00:21:50,160 --> 00:21:54,490
...أظنّني سأُضطرّ لاستبعاد السّلطعون من أطعِمتي المُفضّلة لفترةٍ طويلة

345
00:23:25,870 --> 00:23:27,770
.هاي، يا فتاة الفضاء الرّائعة جدّاً

346
00:23:27,770 --> 00:23:30,130
.أحسنتِ، يا فتاة الفضاء الرّائعة جدّاً

347
00:23:30,130 --> 00:23:34,460
