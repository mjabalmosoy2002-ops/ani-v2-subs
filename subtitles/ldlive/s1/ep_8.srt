1
00:00:05,240 --> 00:00:07,940
.هذه المرّة، سأجعلكما تختفيان إلى الأبد

2
00:00:08,190 --> 00:00:09,270
.تفاداها، تشوتا

3
00:00:13,200 --> 00:00:14,140
هل اختفيا؟

4
00:00:15,420 --> 00:00:16,270
ماذا؟

5
00:00:16,270 --> 00:00:18,020
.تشوتا، كتِفاك

6
00:00:18,020 --> 00:00:18,780
هاه؟

7
00:00:20,280 --> 00:00:21,300
جناحان؟

8
00:00:28,000 --> 00:00:29,180
!واو

9
00:00:29,180 --> 00:00:30,910
!يُمكننا التّحرّك بسرعةٍ أكبر من السّابق

10
00:00:31,290 --> 00:00:36,050
،القُدرات المُتطوّرة للمونيتاليان يُعاد تشغيلها في العادة عندما يُغيّر المُضيف

11
00:00:36,050 --> 00:00:39,340
.لكن عندما يعود إلى مُضيفه، تبقى

12
00:00:39,750 --> 00:00:44,050
.هذه ظاهرةٌ تُدعى بتحديث المونيتاليان

13
00:00:44,050 --> 00:00:46,930
.مع أنّني من بدأ بدَعوَتها بهذا

14
00:00:47,300 --> 00:00:50,010
...هذا هو التّحديث

15
00:00:54,580 --> 00:00:55,850
.يُمكننا فِعل هذا

16
00:00:58,930 --> 00:01:00,340
.رَئيس لايني

17
00:01:00,770 --> 00:01:01,850
ما الخطب؟

18
00:01:01,850 --> 00:01:04,620
كيف المُستجدّ من القِسم 2؟

19
00:01:04,620 --> 00:01:05,840
تشوتا؟

20
00:01:05,840 --> 00:01:08,460
لماذا لا تكتشفين بنفسكِ خلال خُطّة التّعاون هذه؟

21
00:01:08,460 --> 00:01:10,450
.أُريد سماع رأيك، أيّها الرّئيس

22
00:01:10,860 --> 00:01:15,630
،حسناً... إن تمكّن من تأمين الدّكتور لوف دون مشاكل

23
00:01:15,630 --> 00:01:19,050
.لَن يحصل على رِضاكِ على الأرجح

24
00:01:19,610 --> 00:01:21,960
.لَيس كضابط شُرطةٍ أو كرَجل

25
00:01:21,960 --> 00:01:24,440
.هذا يبدو قاتماً جدّاً

26
00:01:24,440 --> 00:01:25,420
...لكن

27
00:01:26,180 --> 00:01:31,220
.إن تعرّضتّم لوَرطةٍ خطيرة، سيُمكن الإعتماد على جوهره حقّاً

28
00:01:31,940 --> 00:01:33,060
جوهر؟

29
00:01:34,960 --> 00:01:40,980
...أظنّني رُبّما أفهم الآن ما كان يُحاول الرّئيس قوله

30
00:03:17,730 --> 00:03:22,220
.نتمكّن من التّحرّك بسرعةٍ كبيرةٍ حتّى أنّ هجماتها تبدو كما لَو أنّها بالكاد تتحرّك

31
00:03:23,190 --> 00:03:25,510
إذاً، هل ستستمرّان بالهرب فقط؟

32
00:03:27,910 --> 00:03:29,790
.لا يُمكننا الإستمرار بالهرب فقط

33
00:03:29,790 --> 00:03:30,890
.على ما يبدو

34
00:03:32,810 --> 00:03:35,130
.التّخييط لَن ينفع، تشوتا

35
00:03:35,390 --> 00:03:38,670
.أعلَم هذا. لكن لابدّ من وُجود طريقة

36
00:03:38,670 --> 00:03:43,310
كنتُ خائفاً جدّاً من الإس بي إتش خاصّتها قبل قليل، لكنّني
!لَستُ خائفاً على الإطلاق الآن

37
00:03:43,310 --> 00:03:44,980
.أتّفق معك

38
00:03:46,450 --> 00:03:50,330
هيا، تشوتا. بالنّظر إليها الآن، ألا تبدو هجمات نينوتشكا

39
00:03:50,330 --> 00:03:52,320
شبيهةً بنوعٍ من الخُضرة؟

40
00:03:52,320 --> 00:03:53,280
نوعٌ من الخُضرة؟

41
00:03:54,530 --> 00:03:59,500
!رُبّما أصبحتُما أسرع قليلاً الآن، لكنّكما مازلتُما بنفس الضّعف

42
00:04:01,700 --> 00:04:04,750
.كما قُلتَ قبل قليل، تبدو كخُضرةٍ بالفِعل

43
00:04:05,150 --> 00:04:07,260
!تبدو تقريباً شبيهةً بـ... البصل الأخضر

44
00:04:07,840 --> 00:04:09,060
!تقمّص

45
00:04:10,690 --> 00:04:11,680
!تقطيعٌ دائريّ

46
00:04:15,980 --> 00:04:17,310
...كلّا

47
00:04:25,790 --> 00:04:29,700
...هذا مُستحيل! بالتّفكير بأنّه سيتمكّن من إيقاف خُطّتي

48
00:04:30,630 --> 00:04:33,220
.هذا يعني بأنّني لَستُ بحاجةٍ لهذه الفتاة بعد الآن

49
00:04:33,220 --> 00:04:34,740
!سأجعلها تعضّ لسانها و تقطعه

50
00:04:34,740 --> 00:04:35,710
هاه؟

51
00:04:35,710 --> 00:04:37,290
.هذا لَن يحصل

52
00:04:45,320 --> 00:04:46,660
ضابطة نينوتشكا؟

53
00:04:50,090 --> 00:04:55,530
.أزلتُ إس بي إتش التّحكّم عن بُعدٍ بشُعاع إزالة الإس بي إتش المُصلّح هذا

54
00:04:55,920 --> 00:04:57,980
.لا تُعاني من أيّ إصاباتٍ خطِرة، لذا فهي بخير

55
00:04:59,980 --> 00:05:01,900
...لَقد عادت لطبيعتها

56
00:05:02,220 --> 00:05:03,420
.حمداً لله

57
00:05:04,970 --> 00:05:07,150
أوه، نعم. ماذا بشأن الآخرين جميعاً؟

58
00:05:07,400 --> 00:05:12,270
.عالَجتُ القُرَيدس الأزرق و فتاة الكوشوتونيان، لذا فهُما بخير

59
00:05:12,270 --> 00:05:13,530
...متى فعلت

60
00:05:13,910 --> 00:05:18,650
.تُوجد مُستلزماتٌ طبّيّةٌ خلف جُدران و أرضيّة هذه المُنشأة

61
00:05:19,200 --> 00:05:21,850
.لَو لَم نكن هُنا، لما نجَت

62
00:05:22,860 --> 00:05:24,550
...المُفتّشة المُساعدة فيرونيكا

63
00:05:24,550 --> 00:05:26,520
.لَم أخلَع ملابسها

64
00:05:26,520 --> 00:05:28,160
!أعلَم هذا

65
00:05:28,160 --> 00:05:31,850
.أوه، أحتاج لأن أُعالِج صاحبة الشّعر الطّويل أيضاً

66
00:05:31,850 --> 00:05:37,130
.لَو لَم يكن الدّكتور لوف هُنا، لماتت فيرونيكا. لوف رجلٌ جيّد

67
00:05:37,130 --> 00:05:39,780
.نعم، ندين له بحياتنا

68
00:05:39,780 --> 00:05:42,740
.لكنّه غريبٌ نوعاً ما

69
00:05:43,390 --> 00:05:44,830
...بالمُناسبة

70
00:05:45,740 --> 00:05:49,870
،عندما قِستُ إس بي إتش التّحكّم عن بُعد

71
00:05:49,870 --> 00:05:53,620
.الوَقتُ المُقدّر لامتصاصها له كان قبل ساعتين فقط

72
00:05:53,620 --> 00:05:54,820
ألَديكَ أيّة أفكارٍ بشأن هذا؟

73
00:05:54,820 --> 00:05:59,580
.هاه؟ قبل ساعتين، كنّا ما نزال في الجيانيرنو-آر

74
00:06:00,560 --> 00:06:03,580
هل يعني هذا بأنّ الجّاني كان داخل المكتب؟

75
00:06:03,590 --> 00:06:06,670
،لاستخدام إس بي إتش التّحكّم عن بُعدٍ على أحد

76
00:06:06,670 --> 00:06:10,180
.يجب أن يتوَاصل مع الشّخص و يُركّز عليه أيضاً

77
00:06:10,180 --> 00:06:11,810
...لكن كيف

78
00:06:11,800 --> 00:06:13,760
،مع هذا، هناك أيضاً مسألة التّوَافق

79
00:06:13,760 --> 00:06:16,560
.لَيس كلّ شخصٍ يُستخدَم عليه سيتمّ التّحكّم به

80
00:06:17,260 --> 00:06:20,940
.هناك إمكانيّة أن يكون قد استُخدِم عليكَ أيضاً، لكن لَم يكن له تأثير

81
00:06:20,940 --> 00:06:22,450
حقّاً؟

82
00:06:22,450 --> 00:06:24,740
.يُمكنني التّفكير بمُختلف الطّرق التي كان من المُمكن فِعل هذا بها

83
00:06:24,740 --> 00:06:28,570
.على سبيل المِثال، النّظر إلى عينا شخصٍ من مسافةٍ قريبة

84
00:06:28,570 --> 00:06:30,980
النّظر إلى شخصٍ في عينيه؟

85
00:06:32,620 --> 00:06:33,780
...هل يُمكن هذا

86
00:06:34,180 --> 00:06:36,570
!تابِع المُحقّق بيلالوغو

87
00:06:36,570 --> 00:06:40,410
إذاً كان هذا عندما تمّ استجواب الضّابطة نينوتشكا؟

88
00:06:40,410 --> 00:06:43,210
من كان ليظنّ بأنّ المُستجوب كان الجّاني؟

89
00:06:43,210 --> 00:06:45,010
!يجب أن نُخبر الرّئيس لايني

90
00:06:46,580 --> 00:06:47,450
.عُلِم

91
00:06:47,870 --> 00:06:51,420
.أحسنت، تشوتا.  سأُرسل فريق الإنقاذ في الحال

92
00:06:51,420 --> 00:06:52,760
.إعتني بالجّميع

93
00:06:56,420 --> 00:06:59,680
.نائب الرّئيس ريغس. هذه حالة الرّمز 9

94
00:06:59,680 --> 00:07:00,910
!الرّمز 9؟

95
00:07:00,910 --> 00:07:03,640
!رمز القبض على شخصٍ خطِرٍ داخل المكتب؟

96
00:07:03,650 --> 00:07:06,820
،سنُلقي القبض في الحال على تابِع المُحقّق بيلالوغو

97
00:07:06,820 --> 00:07:09,360
.دالي ليمي، بتُهمة الإشتباه به بالقتل و التّجسّس

98
00:07:09,730 --> 00:07:11,920
كان ذلك الشّخص هو الجّاني؟

99
00:07:11,920 --> 00:07:14,900
.يويوسا! سأُرسل فريقاً للقبض عليه

100
00:07:20,580 --> 00:07:21,570
.تفضّل

101
00:07:22,180 --> 00:07:26,160
.مُحقّق بيلالوغو، هناك رسالةٌ طارئةٌ من الرّئيس لايني

102
00:07:26,160 --> 00:07:27,910
ماذا يُريد؟

103
00:07:29,990 --> 00:07:31,630
ما-ماذا؟

104
00:07:33,630 --> 00:07:35,800
...دالي، ماذا أنتَ

105
00:07:35,800 --> 00:07:38,800
.سآخذ سُلطتكَ بصفتكَ مُحقّقاً

106
00:07:43,800 --> 00:07:46,180
.تمّ نقل السّلطة كمُحقّق

107
00:07:47,240 --> 00:07:51,770
.يا إلهي... كنتَ مُديراً غبيّاً حتّى النّهاية، بيلالوغو

108
00:07:52,620 --> 00:07:56,320
.خطّ الطّوارئ إلى غُرفة المُحقّق قد تم قطعه بالإكراه

109
00:07:56,730 --> 00:07:59,320
هل أيٌّ من الفِرق تتّجه إلى غُرفة المُحقّق؟

110
00:07:59,320 --> 00:08:01,820
.يُفترض أن يصل الفريق 4 إلى هناك قريباً

111
00:08:01,820 --> 00:08:04,090
!هذا الفريق 4. حصلَت حادثة

112
00:08:04,090 --> 00:08:06,250
.يُهاجمنا الضّابط لاندو

113
00:08:10,030 --> 00:08:13,340
!هذا الفريق 1! الضّابط تارو قد أُصيب بالإهتياج

114
00:08:14,480 --> 00:08:16,380
ماذا يحصل بحقّ الله؟

115
00:08:16,380 --> 00:08:19,700
!يتمّ السّيطرة عليهما بإس بي إتش التّحكّم عن بُعدٍ فقط

116
00:08:19,700 --> 00:08:21,390
!إن اضطّررتُم لقِتالهما، لا تُؤذوهما

117
00:08:21,390 --> 00:08:22,390
...لكن

118
00:08:22,390 --> 00:08:24,260
!أعلَم بأنّ هذا صعب

119
00:08:24,260 --> 00:08:28,650
هل أنتَ وَاثقٌ من أنّ هذا النّوع من الإجراءات المُضادّة المُتروّية سينجح، سيّد رَئيس؟

120
00:08:29,720 --> 00:08:33,570
.بهذا المُعدّل، سيتبع الجّميع بيلالوغو إلى الجّحيم

121
00:08:33,570 --> 00:08:34,640
ماكلان؟

122
00:08:35,610 --> 00:08:38,870
أُخبركَ بأنّ دالي ساما سيُسيطر على الأفراد العاملين

123
00:08:38,870 --> 00:08:41,620
!وَاحداً تلوى الآخر و سيقتل الجّميع

124
00:08:42,560 --> 00:08:43,370
!أوو

125
00:08:43,740 --> 00:08:45,640
.كنتَ الوَحيد المَقلوب، تشوتا

126
00:08:45,640 --> 00:08:46,750
لماذا؟

127
00:08:46,750 --> 00:08:51,950
.عدّلتُ بيانات النّقل قبل مُغادرتنا، لكن يبدو بأنّني نسيت تصحيح بياناتك

128
00:08:52,380 --> 00:08:53,510
!هناك متاعب، شيرو

129
00:08:53,510 --> 00:08:56,640
!بعض الأفراد العاملين مُسيطرٌ عليهم و يُهاجمون الآخرين، شيرو

130
00:08:56,640 --> 00:08:57,460
!ماذا؟

131
00:08:57,460 --> 00:08:59,960
!يقولون بأنّهم سيقتلون الجّميع، شيرو

132
00:08:59,960 --> 00:09:01,980
.إنّهم يخدعون

133
00:09:01,980 --> 00:09:02,860
هاه؟

134
00:09:02,860 --> 00:09:08,540
.فقط 5% من الذين وُضِعوا تحت تأثير إس بي إتش التّحكّم يُمكن السّيطرة عليهم

135
00:09:08,540 --> 00:09:11,440
.من المُستحيل أن يتمكّنوا من قتل الجّميع بهذا العدد

136
00:09:12,300 --> 00:09:13,190
...إذاً

137
00:09:13,190 --> 00:09:15,990
.لَدى الجّاني دافعٌ مُختلف

138
00:09:15,990 --> 00:09:17,240
مُختلف؟

139
00:09:17,630 --> 00:09:22,010
قال الجّاني بأنّه سيفتح البوّابة إلى كنزٍ ما بدِماغي، صحيح؟

140
00:09:22,010 --> 00:09:25,390
.حاليّاً، يُحاول الوُصول إلى تلك البوّابة

141
00:09:25,390 --> 00:09:30,120
بوّابة؟ دكتور لوف، ما هي البوّابة؟

142
00:09:30,800 --> 00:09:34,260
هل سمعتَ سابقاً بمَشروع تاكلاماكان؟

143
00:09:35,490 --> 00:09:38,890
.يجب أن نُسرِع. إنّها في خطَر

144
00:09:39,250 --> 00:09:41,420
.أيّها الرّئيس! يتمّ التّحكّم بالمزيد من الأفراد العاملين

145
00:09:41,890 --> 00:09:45,430
.تتعامل جميع الفِرق الآن مع أفرادٍ عاملين يتمّ التّحكّم بهم

146
00:09:45,750 --> 00:09:48,870
...هذا لَيس جيّداً، يتحكّم دالي بالأشخاص بعشوائيّة

147
00:09:48,870 --> 00:09:51,140
ما دافعه؟

148
00:09:52,340 --> 00:09:56,210
.أيّها الرّئيس... تمّ فتح بابٍ بسُلطة المُحقّق

149
00:09:56,210 --> 00:09:57,300
!مركز الإحتجاز

150
00:09:57,300 --> 00:09:58,150
مركز الإحتجاز؟

151
00:09:59,220 --> 00:10:03,520
.ممّا تمّ قوله مُسبقاً، لَقد قتل دالي بيلالوغو بالفِعل

152
00:10:03,520 --> 00:10:06,410
.لابدّ من أنّه سرقَ سُلطة المُحقّق وَقتها

153
00:10:07,060 --> 00:10:09,690
...هل يُمكن أن يكون دافع دالي الحقيقيّ

154
00:10:13,220 --> 00:10:15,400
أيّ فريقٍ أقرب إلى مركز الإحتجاز؟

155
00:10:15,400 --> 00:10:18,500
.الفريق 3. يُقاتلون حاليّاً في المَمرّ 72

156
00:10:18,500 --> 00:10:22,170
.حتّى لَو غيّروا اتّجاههم، الطّريق الأقصر سيحتاج 10 دقائق

157
00:10:22,170 --> 00:10:25,090
.تبّاً! لَقد خدعَنا تماماً

158
00:10:26,080 --> 00:10:27,100
!أيّها الرّئيس

159
00:10:28,910 --> 00:10:33,060
.حان وَقت الذّهاب، يا بوّابة الكنز العظيمة

160
00:10:33,060 --> 00:10:35,850
.يُمكننا أن نكون لوَحدنا أخيراً

161
00:10:37,940 --> 00:10:43,350
،كنتُ سأُجبر الدّكتور لوف على فتح البوّابة بتقنيّاته الطبّيّة

162
00:10:43,350 --> 00:10:45,990
.لكن ذلك الشّقيّ وَقف في طريقي

163
00:10:45,990 --> 00:10:50,100
...لكنّني سأفتح هذه البوّابة مهما كلّف الأمر

164
00:10:50,100 --> 00:10:51,330
أعني بهذا

165
00:10:51,330 --> 00:10:55,840
.ذِكرياتكِ التي تمّ ختمُها

166
00:10:56,200 --> 00:11:00,470
.لا تقلَقي. الدّكتور لوف لَيس العالِم الوَحيد في الأرجاء

167
00:11:00,470 --> 00:11:04,590
،حتّى لَو اضطّررتُ لإعطائكِ الكثير من العقاقير أو لتقطيع دِماغك

168
00:11:04,590 --> 00:11:06,730
...سأحصل عليه

169
00:11:07,310 --> 00:11:08,090
...ماذا

170
00:11:10,460 --> 00:11:12,320
!إبتعد عن سونوكاتا

171
00:11:25,280 --> 00:11:27,030
...هذا أنتَ ثانيةً

172
00:11:27,030 --> 00:11:29,190
!دولو! سنقوم بحظر السّجن

173
00:11:29,190 --> 00:11:30,660
إذاً سنفعل ذلك الشّيء، صحيح؟

174
00:11:30,660 --> 00:11:33,290
!لَن أستسلِم بعد أن وَصلتُ إلى هذا المَدى

175
00:11:33,290 --> 00:11:34,920
!حَبك

176
00:11:38,590 --> 00:11:39,470
!إنّه حارّ

177
00:11:39,960 --> 00:11:43,840
!سُحقاً، لَن أتمكّن من الفوز عليه بالإس بي إتش خاصّتي

178
00:11:44,560 --> 00:11:45,840
!إنّه يهرب، تشوتا

179
00:11:45,840 --> 00:11:46,550
!إنتظر

180
00:11:50,310 --> 00:11:51,850
!رَئيس لايني؟

181
00:11:51,850 --> 00:11:53,850
هل تُوجد بذلة فضاءٍ يُمكنني استخدامها بالحال؟

182
00:11:53,850 --> 00:11:56,640
أوه، إلى أين ستذهب؟

183
00:11:57,160 --> 00:11:59,230
.سأتمشّى قليلاً

184
00:11:59,230 --> 00:12:01,420
!لَن تقبض عليّ

185
00:12:02,060 --> 00:12:03,150
!لَن تهرب

186
00:12:04,460 --> 00:12:05,880
.تمّ التّعرّف

187
00:12:08,700 --> 00:12:13,750
.شخصٌ يُرجّح بأنّه دالي و آخر قد مرّا للتّوّ عبر مَخرج الطّوارئ

188
00:12:13,770 --> 00:12:16,670
.التّعرّف على الشّارة
!إنّه الضّابط كوكونوسي

189
00:12:16,670 --> 00:12:17,750
...تشوتا

190
00:12:17,750 --> 00:12:19,120
...ذلك الطّفل

191
00:12:19,120 --> 00:12:22,700
.إنّه يُسرِع عبر المَمرّ 46 لمُلاحقة دالي

192
00:12:22,700 --> 00:12:26,010
.سُحقاً على دالي ذاك... يُخطّط لاستخدام حُجيرة الهرب ليهرب

193
00:12:32,600 --> 00:12:34,470
!هذا جِدار حِماية

194
00:12:34,470 --> 00:12:35,180
!إنتظر

195
00:12:35,180 --> 00:12:36,740
.تمّ التّعرّف

196
00:12:37,630 --> 00:12:39,150
!جِدار حِماية

197
00:12:40,390 --> 00:12:41,400
...ماذا

198
00:12:41,400 --> 00:12:44,270
!الخارج؟

199
00:12:44,270 --> 00:12:46,190
!هواه، الفضاء الخارجيّ

200
00:12:46,190 --> 00:12:46,990
!الشّفط

201
00:12:46,990 --> 00:12:50,940
...هذا لَيس جيّداً... الهواء

202
00:12:56,050 --> 00:12:57,830
!يُمكنكَ فِعلها، دولو

203
00:13:07,050 --> 00:13:12,720
.تمّ إطلاق المُشتبه به دالي إلى الفضاء من الفُتحة 46

204
00:13:12,720 --> 00:13:15,720
.تمّ تأكيد موته. لَقد اختنق

205
00:13:15,720 --> 00:13:16,950
ماذا عن تشوتا؟

206
00:13:17,500 --> 00:13:18,980
.تشوتا بخير

207
00:13:18,980 --> 00:13:20,270
...ذلك الصّوت

208
00:13:20,270 --> 00:13:21,980
!رَئيس لايني

209
00:13:21,980 --> 00:13:26,810
أيّها الرّئيس، ذلك اللّباس... هل خرَجتَ لإحضار تشوتا؟

210
00:13:26,810 --> 00:13:32,440
فهمت. سيكون من الأسرع الوُصول إلى هناك من الخارج بينما
.كان كلّ ذلك الذّعر يحصل في الدّاخل

211
00:13:33,030 --> 00:13:34,450
!لَقد نجحنا

212
00:13:38,060 --> 00:13:40,030
...أمم... أيّها الرّئيس

213
00:13:40,030 --> 00:13:41,910
...تُهَم تجسّس سونوكاتا

214
00:13:41,910 --> 00:13:47,440
.أعدتّ الدّكتور لوف بأمان
.سيتمّ مَسح كلّ ذلك

215
00:13:48,240 --> 00:13:49,420
...حمداً لله

216
00:13:49,420 --> 00:13:52,360
.يا إلهي. لَقد أرهقتَ نفسك

217
00:13:54,150 --> 00:13:58,690
.أحسنتُم بالتّخلّص من الجّاسوس و تأمين الدّكتور لوف

218
00:13:58,690 --> 00:14:01,070
،لتمكّنكم من إيجاد الجّاني الحقيقيّ

219
00:14:01,070 --> 00:14:03,900
.تمّ إسقاطُ التّهم ضدّ الضّابطة سونوكاتا

220
00:14:03,900 --> 00:14:06,010
.سأسمح لها بالعودة إلى المَيدان

221
00:14:06,010 --> 00:14:07,480
...لكن مُساعد المُفوّض

222
00:14:07,480 --> 00:14:11,060
.كان هذا قراراً من الجّهات العُليا
.لا يُوجد ما يُقال بشأنه

223
00:14:11,510 --> 00:14:12,530
...و

224
00:14:12,530 --> 00:14:14,280
.دكتور لوف

225
00:14:14,740 --> 00:14:16,490
.أشعر كما لَو أنّني في حُلم

226
00:14:16,890 --> 00:14:20,370
.مرّ الكثير من الوَقت. لَقد تغيّرت، كيشي

227
00:14:20,370 --> 00:14:22,210
.لَيس بمِقدار تغيّرك

228
00:14:22,210 --> 00:14:25,060
.كلّا، لَقد تغيّرتَ أكثر بالتّأكيد

229
00:14:25,050 --> 00:14:29,720
في الماضي، كنتَ ضابطاً مُتجهّماً لَم يكن يخشى من عضّ
.أيّ شخصٍ إن لَم تشعر بالرّضى

230
00:14:30,500 --> 00:14:32,870
الآن أنتَ تتلفّظ بالهُراء فقط

231
00:14:32,850 --> 00:14:37,270
.و الذي هو أقرب للمياه القذرة التي تخرج إن انتزعتها من خِرقة إلدلايف الضّخمة

232
00:14:37,270 --> 00:14:38,970
هل يُمكنكَ الوُصول إلى هذا المَدى؟

233
00:14:39,540 --> 00:14:40,690
،يا صديقي

234
00:14:40,690 --> 00:14:45,320
.أنا أقلَق عليك
...يجب أن تختبئ في مُنشأةٍ آمنةٍ

235
00:14:45,320 --> 00:14:48,980
هل تُحاول إجبار هذا المُسنّ على الذّهاب إلى مكانٍ مُملٍّ ما ثانيةً؟

236
00:14:49,510 --> 00:14:51,480
.إذاً أُفضّل البقاء هُنا

237
00:14:52,420 --> 00:14:55,180
.تُوجد العديد من الأُمور التي تُثير الفُضول بشأن هذا المكتب

238
00:14:55,960 --> 00:15:01,530
.على سبيل المِثال، المونيتاليان الشّبيه بالكائنات الحيّة و أحد مواضيع اختباري هُنا

239
00:15:01,540 --> 00:15:03,670
.هذا خطِرٌ جدّاً

240
00:15:03,670 --> 00:15:10,760
من يدري متى سيظهر شخصٌ آخر لمُحاولة الوُصول إلى ذِكريات ميسوزو سونوكاتا؟

241
00:15:10,760 --> 00:15:13,720
حتّى متى ستستمرّ بمُواكبة تلك المَهزلة؟

242
00:15:14,970 --> 00:15:19,230
أخبرتكَ أكثر من مرّةٍ بأنّه يُمكنني إعادة صِحّة ميسوزو سونوكاتا لسلامتها

243
00:15:19,230 --> 00:15:21,850
.و أُعيد لها ذِكرياتها

244
00:15:21,850 --> 00:15:26,310
.من يستمرّ بجعلها مريضةً بالمُستوى 50 هُم أنتُم

245
00:15:27,520 --> 00:15:30,540
.هذا لَيس قرارنا. هذا قرار موذرز

246
00:15:30,540 --> 00:15:33,400
.لا أنوي مُعارضة موذرز

247
00:15:33,400 --> 00:15:37,530
.أقول فقط بأنّ بقائي إلى جانبها سيكون أءمن

248
00:15:37,530 --> 00:15:41,120
.لأنّني أعرف عن جسد ميسوزو سونوكاتا أكثر من غيري

249
00:15:41,670 --> 00:15:45,670
على سبيل المِثال، أنتَ لا تعرف على الأرجح بأنّ تشوتا كوكونوسي

250
00:15:45,670 --> 00:15:48,460
يُؤثّر على حالتها قليلاً، صحيح؟

251
00:15:49,440 --> 00:15:50,630
تشوتا؟

252
00:15:51,010 --> 00:15:54,540
.على الرّغم من مَظهره، كوكونوسي مُثيرٌ للإهتمام حقّاً

253
00:15:54,540 --> 00:15:58,130
.وَاثقٌ من أنّ دولو بحاجةٍ إلى كوكونوسي لسببٍ ما

254
00:15:58,740 --> 00:16:03,390
.حسناً. لايني كن، أرجوكَ اعتني بدكتور لوف

255
00:16:03,720 --> 00:16:04,830
.يويوسا

256
00:16:05,490 --> 00:16:07,770
.لكن وَفّر له حرَساً شخصيّين

257
00:16:07,770 --> 00:16:10,190
تعني أشخاصاً لمُراقبتي، لَيس حرَساً شخصيّين، صحيح؟

258
00:16:11,970 --> 00:16:13,520
!إبتعدوا

259
00:16:13,520 --> 00:16:15,530
.لَقد تأذّى الكثيرون

260
00:16:15,530 --> 00:16:20,540
أُريد سؤال الدّكتور إسحاق عن حالة المُفتّشة المُساعدة
...فيرونيكا و الضّابطة نينوتشكا، لكن

261
00:16:20,540 --> 00:16:22,520
.يبدو بأنّهم مُنشغِلون الآن

262
00:16:22,520 --> 00:16:25,420
.سمعتُ بأنّهما قد استعادتا وَعيهما

263
00:16:25,960 --> 00:16:27,150
...سونوكاتا

264
00:16:27,710 --> 00:16:29,910
.على ما يبدو، هذا بفضل عِلاج الدّكتور لوف

265
00:16:30,520 --> 00:16:32,130
.كِلتاهما نائمتان الآن

266
00:16:32,130 --> 00:16:34,300
.فهمت. حمداَ لله

267
00:16:34,300 --> 00:16:38,220
تشوتا، إحذر. لا تعلَم ميسوزو بأنّها موضوع

268
00:16:38,220 --> 00:16:42,060
.اختبارٍ لمَشروع تاكلاماكان، أو أنّها كانت مُستهدفة

269
00:16:44,950 --> 00:16:52,350
كان دالي ليمي يُخطّط لاستخدام الدّكتور لوف للوُصول إلى ذِكريات
.ميسوزو المَختومة منذ البداية

270
00:16:52,650 --> 00:16:57,200
و خلال ذلك الوَقت، ساعدَت ميسوزو سجيناً على الهرب

271
00:16:57,200 --> 00:16:58,910
.بسبب الأعراض الجّانبيّة لدوائها

272
00:16:59,470 --> 00:17:02,530
.إكتشف دالي هذا الأمر و بدأ بتنفيذ خُطّته

273
00:17:02,530 --> 00:17:07,950
.بشكلٍ رسميّ، تمّ الإعتناء بهذا الأمر على أنّه مُحاولة أخذ فِديةٍ و تجسّس

274
00:17:07,950 --> 00:17:11,760
.أنتَ و أنا الوَحيدان اللّذان يعرفان الحقيقة في المكتب

275
00:17:11,760 --> 00:17:15,040
.هذا سِرٌّ عن فيرونيكا، نينوتشكا و بالتّأكيد ميسوزو

276
00:17:15,480 --> 00:17:19,800
...أيّها الرّئيس، ما ذِكريات سونوكاتا تلك التي كان يسعى خلفها دالي

277
00:17:20,000 --> 00:17:23,210
.أعتذر، هذا سِرّيٌّ للغاية

278
00:17:24,810 --> 00:17:28,640
...في النّهاية، مازلتُ لا أعرف الكثير من الأُمور المُهمّة

279
00:17:29,340 --> 00:17:30,270
...لكن

280
00:17:30,810 --> 00:17:34,830
.سونوكاتا هُنا
.هذا جيّدٌ بما يكفي للآن

281
00:17:36,150 --> 00:17:40,810
.أمم... أحسنتَ عملاً بتأمين الدّكتور لوف

282
00:17:40,810 --> 00:17:41,850
.نعم

283
00:17:41,850 --> 00:17:44,860
.أعتذر بشأن كلّ المتاعب التي سبّبتُها لكَ بسبب الإشتباه بي بالجّاسوسيّة

284
00:17:44,860 --> 00:17:46,330
!لا مُشكلة على الإطلاق

285
00:17:48,280 --> 00:17:51,200
.سمعتُ بأنّه قد تمّ تحديث المونيتاليان

286
00:17:51,200 --> 00:17:54,960
.نعم، يبدو مُختلِفاً قليلاً الآن أيضاً

287
00:17:56,000 --> 00:17:57,460
.أمم... أنتَ قريبٌ جدّاً

288
00:17:57,460 --> 00:17:59,720
أُنظري هُنا! هل ترين؟ هل ترين؟

289
00:18:00,220 --> 00:18:05,270
.آمل أن تتمكّن من أن يتمّ تحديثكَ قريباً، و لَيس المونيتاليان فقط

290
00:18:06,510 --> 00:18:10,600
...أرغه! بعد أن خاطرتُ بحياتي في القِتال

291
00:18:10,980 --> 00:18:11,770
!إنتظري

292
00:18:11,770 --> 00:18:13,080
!ماذا؟

293
00:18:13,080 --> 00:18:17,020
تـ-تصرّفك! لماذا أنتِ غاضبةٌ منّي؟

294
00:18:17,020 --> 00:18:20,010
.سأكون أكثر حذراً في المُستقبل
هل سيكفي هذا؟

295
00:18:20,010 --> 00:18:23,150
!كلّا، لَيس كذلك! إن أردتّ قول شيء، قوليه فقط

296
00:18:24,100 --> 00:18:26,660
.إذاً سأُخبركَ بصِدق

297
00:18:35,550 --> 00:18:37,790
...الإس بي إتش خاصّتك

298
00:18:38,660 --> 00:18:39,790
...مُقارنةً بالسّابق

299
00:18:42,400 --> 00:18:43,420
.رائحته أكثر نتانة

300
00:18:43,420 --> 00:18:46,840
...نَتِن... نَتِن... نَتِن

301
00:18:48,660 --> 00:18:49,520
.عُذراً

302
00:18:51,020 --> 00:18:53,850
...مُستحيل... أنا

303
00:18:54,290 --> 00:18:56,640
!رائحتي نتنة؟...

304
00:18:58,600 --> 00:19:00,230
!أتمنّى أن يكون يومكَ جيّداً

305
00:19:00,230 --> 00:19:02,060
.أراكِ لاحقاً

306
00:19:02,060 --> 00:19:06,360
.أُحبّك، تشوتا! إحذر من السيّارات

307
00:19:07,070 --> 00:19:09,530
.أتسائل عمّا يحصل مع تشوتا

308
00:19:10,160 --> 00:19:12,920
...إستحمّ لأكثر من ساعةٍ البارحة

309
00:19:13,440 --> 00:19:16,170
.بعدها استخدم عِطري دون إخباري

310
00:19:16,540 --> 00:19:19,920
.أتسائل إن كان جميع الصّبيان هكذا عندما يمرّون بمَرحلة المُراهقة

311
00:19:20,950 --> 00:19:22,170
!صباح الخير، تشو

312
00:19:22,620 --> 00:19:24,180
.صباح الخير

313
00:19:24,180 --> 00:19:30,550
صـ-صباح الخير... أمم... لماذا نلتقي عند فِرع الأرض المَحلّيّ اليوم؟

314
00:19:30,550 --> 00:19:32,520
.يجب أن نفعل شيئاً هناك، تشو

315
00:19:33,090 --> 00:19:34,170
.يشمّ، يشمّ

316
00:19:34,170 --> 00:19:37,640
.أشمّ رائحةً قويّةً من الضّابط كوكونوسي، تشو

317
00:19:37,640 --> 00:19:41,320
.إنّه عِطرٌ يستخدمه الأرضيّون... لأجل الآنسات

318
00:19:42,110 --> 00:19:43,440
.إكتشفَت أمرك

319
00:19:43,860 --> 00:19:49,640
أمم، أيّها المُفتّش المُساعد تشيبس، هل تغيّرَت رائحة الإس بي إتش خاصّتي؟

320
00:19:49,640 --> 00:19:53,450
.همم؟ رائحة الإس بي إتش خاصّتكَ كعادتها، تشو

321
00:19:55,050 --> 00:19:59,520
.أخطأتُ ذلك اليوم
.أرجوكَ لا تدَع هذا يُزعجك

322
00:19:59,520 --> 00:20:00,580
.أعتذر

323
00:20:00,580 --> 00:20:04,630
كنتِ مُخطئة؟ إذاً... رائحتي لَيست نتنة؟

324
00:20:05,080 --> 00:20:06,030
.كلّا

325
00:20:07,090 --> 00:20:09,500
!لكنّكِ تضعينَ سدّادة أنف

326
00:20:09,850 --> 00:20:14,230
.هذا لَيس سدّادة أنف. إنّه إكسسوار أنفٍ يستخدمه التيكويريان في الطّقوس

327
00:20:14,230 --> 00:20:15,890
.لكنّكِ سددتّ أنفكِ

328
00:20:16,270 --> 00:20:17,720
!تشوتا، أُنظر

329
00:20:17,720 --> 00:20:19,600
.أوه، يبدو بأنّهم قد وَصلوا، تشو

330
00:20:20,420 --> 00:20:21,860
...ما-ماذا

331
00:20:22,380 --> 00:20:23,080
.هاي

332
00:20:23,080 --> 00:20:26,430
.يُمكنني أن أشكركَ أخيراً، تشوتا كوكونوسي

333
00:20:26,430 --> 00:20:29,240
.شُكراً جزيلاً لكَ على ذلك اليوم

334
00:20:29,240 --> 00:20:32,890
لماذا ثلاثتكم ترتدون زيّ مَدرستي؟

335
00:20:32,890 --> 00:20:36,700
.لأنّنا جميعاً في الفريق الذي سيعمل من نفس الفِرع الأرضيّ المَحلّيّ، تشو

336
00:20:36,700 --> 00:20:37,880
!فريق؟

337
00:20:37,880 --> 00:20:43,740
.سيكون الدّكتور لوف داعِمنا للبُحوث العِلميّة و سيُحافظ على سلامتنا أيضاً، تشو

338
00:20:43,740 --> 00:20:47,880
.فريق التّحقيق 5 مَسؤولٌ عن حِراسة الدّكتور لوف

339
00:20:47,880 --> 00:20:49,010
حِراسة؟

340
00:20:49,010 --> 00:20:50,870
.في الأساس، سنُراقبة

341
00:20:50,870 --> 00:20:54,010
.الدّكتور لوف عالِمٌ مُهمٌّ جدّاً

342
00:20:54,470 --> 00:20:57,780
.حسناً، لَقد سمِعتُماها
.أتطلّع للعمل معكما

343
00:20:58,290 --> 00:20:59,870
...أظنّه لِقاؤنا الأوّل

344
00:21:00,870 --> 00:21:02,520
.أيّتها الضّابطة سونوكاتا

345
00:21:02,520 --> 00:21:04,860
...سـ-سعيدةٌ لمُقابلتك

346
00:21:04,860 --> 00:21:05,440
هاه؟

347
00:21:05,950 --> 00:21:10,370
،أوه، نعم. سونوكاتا لا تذكر شيئاً عن مَشروع تاكلاماكان

348
00:21:10,370 --> 00:21:12,540
.لذا يُفترض أن يكون هذا لِقاءهما الأوّل

349
00:21:13,770 --> 00:21:17,290
...إن كانت سونوكاتا و الدّكتور لوف بنفس المدرسة

350
00:21:17,830 --> 00:21:20,410
.لَقد غادر جميع الطّلّاب إلى المنزل

351
00:21:20,410 --> 00:21:22,290
.نعم، دكتور لوف

352
00:21:22,290 --> 00:21:26,010
.حان الوَقت لمَشروع تاكلاماكان لليوم

353
00:21:26,010 --> 00:21:28,260
.نعم، دكتور لوف

354
00:21:28,260 --> 00:21:30,650
.الآن، إخلَعي ملابسك

355
00:21:30,650 --> 00:21:33,230
.نعم، دكتور لوف

356
00:21:33,640 --> 00:21:35,780
!سُحقاً

357
00:21:35,780 --> 00:21:38,510
.وَاثقٌ من أنّ الأمر لَيس كما تُفكّر، تشوتا

358
00:21:38,850 --> 00:21:39,960
هل من خطب؟

359
00:21:39,960 --> 00:21:41,180
هل هو بخير؟

360
00:21:41,180 --> 00:21:43,190
.يبدو مُرهقاً

361
00:21:43,190 --> 00:21:44,650
.هذا طبيعيّ

362
00:21:45,070 --> 00:21:47,410
...جميعنا في نفس المدرسة

363
00:21:47,410 --> 00:21:52,510
ماذا سيحصل؟

364
00:23:25,860 --> 00:23:27,900
.أنتَ رائعٌ جدّاً، دكتور لوف

365
00:23:27,900 --> 00:23:31,310
.لكن لا أهتمّ سوى بالبُنية الجّسديّة و الأعضاء

366
00:23:31,980 --> 00:23:33,360
.أُريد لَمس لَحمهم مُباشرةً

367
00:23:33,360 --> 00:23:34,550
نينوتشكا، هلّا خلعتِ ملابسكِ لأجلي؟

368
00:23:35,140 --> 00:23:36,810
،في الحلقة القادمة من إلدلايف

369
00:23:36,810 --> 00:23:37,820
".كِذبة ميسوزو"

370
00:23:37,820 --> 00:23:39,650
!هـ-هذا مُباشرٌ جدّاً