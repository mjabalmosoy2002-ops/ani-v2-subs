1
00:00:08,890 --> 00:00:10,130
!إنتظر مكانك

2
00:00:10,130 --> 00:00:14,020
!لَديكَ الحقّ بالتزام الصّمت و الحقّ بالحُصول على مُحامٍ

3
00:00:21,340 --> 00:00:22,250
!فيرونيكا

4
00:00:22,250 --> 00:00:24,490
!إذاً فقد أظهرتَ شكلكَ الحقيقيّ

5
00:00:26,720 --> 00:00:27,780
!نينوتشكا

6
00:00:27,780 --> 00:00:28,580
!حسناً

7
00:00:36,510 --> 00:00:39,820
!هاي! لَم نطلُب دعماً

8
00:00:39,820 --> 00:00:41,850
.حصل أنّني كنتُ مارّةً من هُنا

9
00:00:43,440 --> 00:00:45,520
!لَن تقبضنَ عليّ

10
00:00:47,210 --> 00:00:52,480
.إستسلِم. أنتَ مُحاصرٌ بالكامل

11
00:00:52,480 --> 00:00:53,890
أنتَ هُنا أيضاً، أيّها المُدير؟

12
00:00:54,270 --> 00:00:57,400
.أوه، نعم. حصل أنّني كنتُ مارّاً من هُنا

13
00:00:57,820 --> 00:00:59,770
...سُحقاً

14
00:01:05,670 --> 00:01:07,530
صوتٌ عالٍ؟

15
00:01:08,730 --> 00:01:09,920
.الرّبيع

16
00:01:09,920 --> 00:01:13,520
،تمكّنتُ أخيراً من الإندماج في صفّي الجّديد

17
00:01:10,330 --> 00:01:12,730
.لابدّ من أنّها قِطّة الجّيران

18
00:01:13,520 --> 00:01:15,680
.لذا أظنّ بأنّني سأتمكّن من العيش بسلام

19
00:01:18,760 --> 00:01:20,600
،أو هذا ما ظننتُه

20
00:01:21,640 --> 00:01:23,190
...وَقتها

21
00:02:56,410 --> 00:02:58,940
هاه؟ هناك رائحةٌ جميلة؟

22
00:02:59,400 --> 00:03:01,070
...حسناً، إنّه الرّبيع

23
00:03:03,790 --> 00:03:06,660
كوكونوسي؟ إلى من تتحدّث؟

24
00:03:05,430 --> 00:03:09,950
.أُحبّ رائحة الغسيل المغسول حديثاً بعد جفافه

25
00:03:09,950 --> 00:03:11,160
!هاي، كوكونوسي

26
00:03:11,160 --> 00:03:11,910
!نعم، سيّدي

27
00:03:11,910 --> 00:03:13,830
إلى متى تنوي التّحدّث مع نفسك؟

28
00:03:12,750 --> 00:03:13,830
.ها هو ذا

29
00:03:13,830 --> 00:03:15,030
!أعتذر

30
00:03:13,830 --> 00:03:15,490
.تشوتا المُتمتم

31
00:03:19,230 --> 00:03:21,730
.بدأ العام المدرسيّ للتّوّ، و أنتَ بطلٌ بالفِعل

32
00:03:21,730 --> 00:03:24,250
...لا يُمكنني تصديق تجاهلكَ لتاكيغاوا في حِصّة الدّراسات الإجتماعيّة

33
00:03:24,520 --> 00:03:26,500
.لنتوَقّف عن الحديث بهذا الأمر

34
00:03:26,500 --> 00:03:29,090
.أعني، لا يتمكّن الآخرون من فِعل هذا بالعادة

35
00:03:29,090 --> 00:03:29,600
.بالفِعل

36
00:03:29,600 --> 00:03:33,360
ميسوزو، ألَيس كوكونوسي كن مُثيرٌ للإهتمام و مُضحك؟

37
00:03:43,500 --> 00:03:45,360
.ميسوزو سونوكاتا

38
00:03:46,210 --> 00:03:51,890
.لَم أتحدّث إليها بعد، لكن أُراهن على أنّ شخصيّتها ظريفةٌ جدّاً أيضاً

39
00:03:52,440 --> 00:03:54,080
.هواه، أنتَ كمُحترف

40
00:03:54,080 --> 00:03:57,670
.لا شيء أقلّ من شيطان حِصّة الأعمال المنزليّة المُدرّب على فنّ العمل المنزليّ

41
00:03:57,910 --> 00:03:59,430
.أنتُما تُبالِغان

42
00:03:59,980 --> 00:04:01,900
...أمم، كوكونوسي كن

43
00:04:02,500 --> 00:04:07,500
لَدى نادي الطّهي مُسابقة طَهيٍ قريباً. هلّا فكّرتَ بالإنضمام إلينا؟

44
00:04:07,500 --> 00:04:09,210
هاه؟ أنا؟

45
00:04:09,520 --> 00:04:13,510
.لاحظنا مدى براعتك، لذا أردنا أن نسألكَ هذا

46
00:04:15,960 --> 00:04:19,360
.أ-أعتذر، لكنّني سأرفض

47
00:04:24,640 --> 00:04:27,160
.أوو، لَقد رفض

48
00:04:27,160 --> 00:04:30,870
.سمعتُ بأنّه لهذا السّبب بالضّبط لا يملك أيّ أصدقاء

49
00:04:30,870 --> 00:04:31,940
!هذا لَيس صحيحاً

50
00:04:33,320 --> 00:04:35,810
!لا أكبح نفسي أو ما شابه

51
00:04:35,810 --> 00:04:39,550
!لا أُريد فِعل هذا حقّاً فقط
!عليّ مُساعدة خالَتي على أيّة حال

52
00:04:39,550 --> 00:04:41,410
ماذا؟ هل يتحدّث مع نفسه؟

53
00:04:42,490 --> 00:04:43,710
...تبّاً

54
00:04:49,810 --> 00:04:52,990
.لَيس الأمر كما لَو أنّني أرغب بالحديث مع نفسي

55
00:04:53,700 --> 00:04:58,900
.هناك سببٌ لكوني أبدو في حالة ذُهولٍ أو لعدم سماعي لما يقوله الآخرون

56
00:04:59,230 --> 00:05:01,280
.هذه عادةٌ سيّئةٌ لَديك، تشوتا

57
00:05:01,660 --> 00:05:04,090
.أسمع هذا الصّوت

58
00:05:04,090 --> 00:05:05,870
.أنتَ سلبيٌّ و مُتشائم

59
00:05:05,870 --> 00:05:08,230
ألَيس لَديكَ أيّ ثِقةٍ بنفسك، تشوتا؟

60
00:05:08,230 --> 00:05:09,520
!إهتمّ بأُموركَ الخاصّة

61
00:05:10,560 --> 00:05:14,400
،كنتُ أسمع هذا الصّوت منذ أمكنني أن أتذكّر

62
00:05:14,400 --> 00:05:16,790
.و يتردّد صداه في رأسي فقط

63
00:05:17,750 --> 00:05:21,370
،عندما كنتُ طِفلاً، ظننتُ أنّ الوَضع كان هكذا مع الجّميع

64
00:05:21,370 --> 00:05:23,290
.لكن على ما يبدو، فهذا معي أنا فقط

65
00:05:23,880 --> 00:05:28,240
.المُحادثات التي نقوم بها غبيّةٌ في العادة، لذا لَم أُخبر أحداً آخر عن الأمر

66
00:05:28,700 --> 00:05:31,860
،لكن بسبب هذا، تفوتُني أُمورٌ مُهمّةٌ تمّ قولها

67
00:05:31,860 --> 00:05:35,360
.أو أنّني أتجادل مع الصّوت و أُعامل كغريب أطوار

68
00:05:37,360 --> 00:05:39,700
.أنا في الأساس مُعقّدٌ هكذا

69
00:05:39,700 --> 00:05:41,920
.لهذا السّبب بالضّبط لا تملك أيّ أصدقاء

70
00:05:41,920 --> 00:05:43,150
!"قُلت، "إخرس

71
00:05:44,950 --> 00:05:47,070
...لَو كان هذا الأمر هو حُدود مَشاكلي، لَن يكون الوَضع سيّئاً جدّاً، لكن

72
00:05:51,200 --> 00:05:55,430
.لكن لهذا السّبب قرّرتُ بأنّني لَن أتسبّب لأحدٍ بأيّ متاعب

73
00:05:56,360 --> 00:05:58,550
.تشوتا، أشمّ رائحة زيت

74
00:05:58,550 --> 00:06:01,390
.حسناً، نحن في صفّ الطّهي، لذا لا يجب أن يكون هذا مُفاجئاً

75
00:06:01,390 --> 00:06:02,790
...أوو

76
00:06:03,830 --> 00:06:05,440
...ساوتومي سينساي

77
00:06:05,900 --> 00:06:12,980
.تملكان بعض الجّرأة، بالتّصارع معاً في الرّواق بينما لم أكن هناك، تاتيان، أوتشيدا

78
00:06:13,760 --> 00:06:15,100
.نعتذر

79
00:06:15,390 --> 00:06:17,640
.تعالا لرُؤيتي في غُرفة المُدرّسين بعد المدرسة

80
00:06:17,640 --> 00:06:18,960
.حسناً

81
00:06:18,540 --> 00:06:20,430
!إنّه السّائل، تشوتا

82
00:06:18,960 --> 00:06:20,020
.بسُرور

83
00:06:20,740 --> 00:06:23,470
.تعال. تحتاج للعودة إلى الحِصّة أيضاً

84
00:06:23,470 --> 00:06:24,560
.نـ-نعم، سيّدتي

85
00:06:25,840 --> 00:06:28,340
!إنّه السّائل! إنّه السّائل

86
00:06:28,340 --> 00:06:30,250
!إخرس

87
00:06:30,250 --> 00:06:31,830
إنّه السّائل، صحيح؟

88
00:06:31,830 --> 00:06:34,530
ألا تعني الصّدر؟

89
00:06:36,970 --> 00:06:38,730
هل سمِعَتني...؟

90
00:06:45,410 --> 00:06:47,910
.أنتَ أسوأ نوعٍ من المُنحرفين

91
00:06:47,910 --> 00:06:49,920
.أرجوكَ متّ، حتّى لا يبقى منكَ شيء

92
00:06:50,270 --> 00:06:53,500
ماذا... أموت؟ هاه؟

93
00:06:54,150 --> 00:06:56,920
!الكلمات التي تتفوّه بها و وَجهها لا يتناسبان على الإطلاق

94
00:06:56,920 --> 00:06:59,560
الأهمّ، هل تمّ رفضي للتّوّ؟

95
00:06:59,560 --> 00:07:01,330
.بالتّأكيد، تشوتا

96
00:07:02,110 --> 00:07:04,900
ألَم يكن بإمكانه البقاء كإعجابٍ من جانبٍ وَاحدٍ فقط؟

97
00:07:08,270 --> 00:07:09,240
!هاي

98
00:07:10,390 --> 00:07:12,060
هل أنتَ حُرٌّ اليوم؟

99
00:07:12,060 --> 00:07:15,050
.ستأخذنا ساوتومي تشان إلى الكاريوكي

100
00:07:15,050 --> 00:07:16,880
ستذهبون مع ساوتومي سينساي؟

101
00:07:16,880 --> 00:07:18,120
هل تُريد القدوم؟

102
00:07:18,120 --> 00:07:21,830
...هاه؟ أعتذر، لكنّني

103
00:07:21,830 --> 00:07:23,080
.فهمت

104
00:07:23,080 --> 00:07:23,870
.أعتذر

105
00:07:23,870 --> 00:07:26,110
تشوتا كوكونوسي، صحيح؟

106
00:07:26,110 --> 00:07:28,260
.أنتَ مُثيرٌ للإهتمام بالفِعل

107
00:07:29,110 --> 00:07:31,280
.حسناً، تعال إن غيّرتَ رأيك

108
00:07:31,280 --> 00:07:32,610
.إسمي تاتيان

109
00:07:34,510 --> 00:07:36,800
.شُكراً، تاتيان

110
00:07:37,390 --> 00:07:38,500
!أراكَ لاحقاً

111
00:07:39,990 --> 00:07:42,320
.تالياً، لَدينا بعض الأخبار من الخارج

112
00:07:42,760 --> 00:07:49,020
.إكتشفنا للتّوّ بأنّ زعيم المافيا الإيطاليّة التّالي قد يكون يابانيّاً

113
00:07:50,110 --> 00:07:51,980
.أعيش في مَتجرٍ للكعك

114
00:07:56,080 --> 00:07:57,890
.لَقد عُدتّ، خالَتي

115
00:07:57,890 --> 00:07:59,940
!مرحباً بعودتك، تشوتا

116
00:08:00,500 --> 00:08:02,330
.تبدو ميمي بمزاجٍ جيّد

117
00:08:02,330 --> 00:08:04,350
.هذه خالَتي، ميمي

118
00:08:04,350 --> 00:08:07,850
،إنّها عبقريّةٌ عندما يتعلّق الأمر بصُنع الكعك

119
00:08:07,850 --> 00:08:10,620
.لكنّها لَيست بارعةً عندما يتعلّق الأمر بالأُمور الأُخرى

120
00:08:11,140 --> 00:08:12,840
.هاي، تشوتا

121
00:08:13,790 --> 00:08:16,100
...من الصّعب عليّ قول هذا

122
00:08:16,100 --> 00:08:21,460
.كنتُ أستخدمها بحذر، لكن خِرَق غُبار المَتجر قد احترَقت

123
00:08:21,710 --> 00:08:24,470
.حسناً. سأخيط بعض خِرَق الغُبار لأجلك

124
00:08:24,820 --> 00:08:26,600
!شُكراً، تشوتا

125
00:08:27,160 --> 00:08:28,580
.أحسنت، تشوتا

126
00:08:27,690 --> 00:08:29,070
!أُحبّك

127
00:08:28,580 --> 00:08:30,120
.هذا لَيس أمراً مُهمّاً

128
00:08:30,120 --> 00:08:30,860
هاه؟

129
00:08:30,860 --> 00:08:32,410
...أوه، هذا لا شيء

130
00:08:32,410 --> 00:08:36,490
أوه، معي الطّبق الذي طهوته في حِصّة الأعمال المنزليّة، لكن هل ترغبين ببعضٍ منه؟

131
00:08:36,490 --> 00:08:38,630
!هواااهووو! شُكراً

132
00:08:38,630 --> 00:08:41,500
.كنتُ مَشغولةً جدّاً حتّى أنّني لَم أتناول الغداء بعد

133
00:08:43,170 --> 00:08:44,620
!لَذيذٌ جدّاً

134
00:08:48,300 --> 00:08:50,150
هل حصل شيءٌ في المدرسة؟

135
00:08:50,150 --> 00:08:50,930
هاه؟

136
00:08:50,930 --> 00:08:53,590
هل أفسدتّ الأمر ثانيةً؟

137
00:08:53,590 --> 00:08:56,000
!لَـ-لَم يحصل شيء. أوو

138
00:08:56,780 --> 00:08:57,990
هل أنتَ بخير؟

139
00:08:57,990 --> 00:08:59,740
.نعم، أنا بخير

140
00:09:00,530 --> 00:09:05,560
.ربّتني خالَتي لوَحدها، بعد أن فقدتّ وَالِداي

141
00:09:05,560 --> 00:09:08,330
.لذا لا يُمكنني حقّاً إخفاء أيّ شيءٍ عنها

142
00:09:10,500 --> 00:09:11,830
.أحدهم هُنا

143
00:09:14,820 --> 00:09:17,080
.أرجوكَ متّ، حتّى لا يبقى منكَ شيء

144
00:09:17,630 --> 00:09:20,020
...لَم يكن عليها قولها هكذا

145
00:09:20,540 --> 00:09:22,650
...تلك الشّيطانة بوَجهٍ ملائكيّ

146
00:09:22,650 --> 00:09:24,320
.تشوتا، أحدهم هُنا

147
00:09:24,320 --> 00:09:27,290
.لكن يا رجل... إنّها ظريفةٌ جدّاً

148
00:09:27,290 --> 00:09:30,190
.تمّ تأكيد التّغيّرات في جُزيئات الهدف

149
00:09:30,190 --> 00:09:32,000
!أرجوكَ قُم بالنّقل، تشو

150
00:09:32,820 --> 00:09:34,160
!ساطعٌ جدّاً

151
00:09:34,160 --> 00:09:35,960
!ساطع! ساطع

152
00:09:35,960 --> 00:09:36,630
...ما-ماذا بحقّ

153
00:09:36,630 --> 00:09:38,450
تشوتا، ما هذا؟

154
00:09:38,450 --> 00:09:40,700
!لا أعلَم أيضاً

155
00:09:42,430 --> 00:09:44,280
...أوو

156
00:09:44,280 --> 00:09:45,640
.هذه غُرفةٌ غريبة

157
00:09:46,380 --> 00:09:49,070
!هذه الغُرفة! إنّها غُرفةٌ غريبة، تشوتا

158
00:09:54,830 --> 00:09:56,310
ماذا يحصل؟

159
00:09:56,950 --> 00:09:58,810
أين نحن؟

160
00:09:59,140 --> 00:10:03,090
.يُوجد شيءٌ هناك
.تشوتا، يُوجد شيءٌ هناك

161
00:10:03,090 --> 00:10:05,730
.فهمت، لذا أُسكت

162
00:10:04,520 --> 00:10:09,700
.يستمرّ ذلك الطّفل بالحديث مع نفسه
هل ضرب رأسه؟

163
00:10:09,970 --> 00:10:13,870
.على ما يبدو، لا علاقة بحديثه مع نفسه بكونه أرضيّاً

164
00:10:14,270 --> 00:10:18,050
.الأرضيّون الذين نعرفهم لا يتحدّثون مع أنفسهم أيضاً

165
00:10:21,400 --> 00:10:23,470
!حسناً، لنَذهب، تشوتا

166
00:10:35,850 --> 00:10:36,830
هاه؟

167
00:10:38,340 --> 00:10:39,340
ماذا؟

168
00:10:39,340 --> 00:10:41,230
!إنّهم قِطط! و وُجوههم مُثلّثة

169
00:10:41,230 --> 00:10:42,740
!هاه؟

170
00:10:42,740 --> 00:10:44,810
.إنّهم مُريبون، تشوتا

171
00:10:44,810 --> 00:10:47,800
هل أتينا إلى مُسابقة أزياءٍ من نوعٍ ما؟

172
00:10:47,800 --> 00:10:50,660
.أوه، مرحباً بك، تشوتا كوكونوسي

173
00:10:51,640 --> 00:10:54,280
.نحن شُرطة الفضاء إلدلايف

174
00:10:54,960 --> 00:10:56,500
!يويوسا

175
00:10:56,800 --> 00:10:59,730
شُـ-شُرطة الفضاء...؟

176
00:11:00,000 --> 00:11:02,580
.إسمي هو لاين بريك

177
00:11:02,580 --> 00:11:06,380
.أنا مُدير مكتب إلدلايف لهذا النّظام الشّمسيّ

178
00:11:07,550 --> 00:11:12,920
إذاً لماذا تمّ اختيار هذا الفتى لإلدلايف؟

179
00:11:12,920 --> 00:11:18,340
.بالحُكم على هذه البيانات، لا أرى أيّ شيءٍ مُميّزٍ بشأن هذا الأرضيّ

180
00:11:18,340 --> 00:11:20,030
.أرجوكم اهدأوا

181
00:11:21,510 --> 00:11:24,120
.كان هذا إجماعاً من مذرز

182
00:11:24,810 --> 00:11:27,280
تمّ اختياري؟

183
00:11:27,280 --> 00:11:28,440
.هذا صحيح

184
00:11:28,890 --> 00:11:31,160
،نحن، مُوَظّفوا إلدلايف

185
00:11:31,160 --> 00:11:34,570
نقوم بتجنيد من يملكون الإمكانيّة ليكونوا ضبّاط شُرطةٍ رائعين

186
00:11:34,570 --> 00:11:39,410
.بإجماعٍ من حواسيب مذرز التي تمّ توزيعها عبر الكون

187
00:11:39,410 --> 00:11:43,060
.و تمّ اختياركَ من قِبل حاسوب مذرز

188
00:11:43,060 --> 00:11:44,600
.إنتظر لَحظة

189
00:11:44,600 --> 00:11:46,480
.هذا مُفاجئٌ جدّاً

190
00:11:46,480 --> 00:11:49,160
أين نحن على أيّة حال؟

191
00:11:49,160 --> 00:11:53,830
.هذا هو جيانيرنو-آر، مكتب إلدلايف لهذا النّظام الشّمسيّ

192
00:11:53,830 --> 00:11:55,180
جيانيرنو...؟

193
00:11:55,180 --> 00:12:00,130
.همم... قد يكون من الأسرع أن أُريكَ بدلاً من الشّرح

194
00:12:00,130 --> 00:12:01,440
.تونتو، ريغس

195
00:12:01,800 --> 00:12:03,250
!يويوسا

196
00:12:05,330 --> 00:12:06,230
هاه؟

197
00:12:06,880 --> 00:12:09,910
.النّقل إلى حُجرة القذف قد تمّ تأكيده

198
00:12:09,910 --> 00:12:12,030
أمم، ما هذا؟

199
00:12:12,030 --> 00:12:14,070
.حسناً. إرمي به في الخارج هناك

200
00:12:14,070 --> 00:12:15,280
!يويوسا

201
00:12:15,620 --> 00:12:18,630
!الباب يفتح. إنّه يفتح! إنّه يفتح

202
00:12:16,750 --> 00:12:18,630
هاه؟ إنّه يفتح؟

203
00:12:21,160 --> 00:12:23,170
!هناك شيءٌ مُدوّرٌ خلفنا

204
00:12:23,470 --> 00:12:25,650
!إنّه كوكب! إنّها الأرض، تشوتا

205
00:12:27,870 --> 00:12:30,250
!أنتَ تمزح

206
00:12:43,510 --> 00:12:44,700
!هذا مُدهش

207
00:12:44,700 --> 00:12:48,190
.إلتفّ! يُمكنكَ رُؤية مكتبنا الذي يبدو رائعاً

208
00:12:48,810 --> 00:12:50,710
!هواه، سفينةٌ فضائيّة؟

209
00:12:50,710 --> 00:12:53,110
إنّه نموذجٌ بلاستيكيّ. ألا يبدو كنموذجٍ بلاستيكيّ، تشوتا؟

210
00:12:55,550 --> 00:12:57,830
.للأرضيّين شكلٌ قذرٌ بالفِعل

211
00:12:57,830 --> 00:12:59,630
!هواه، وَجه

212
00:12:59,630 --> 00:13:01,120
.يبدو كقمرٍ هِلاليّ

213
00:13:01,120 --> 00:13:03,130
.لا تُخفه، ميليس

214
00:13:03,130 --> 00:13:05,190
.إن كنتَ خائفاً، تمسّك بي

215
00:13:05,190 --> 00:13:06,550
!ثمانية مِجسّات؟

216
00:13:06,550 --> 00:13:07,260
.إنّها عشرة

217
00:13:07,730 --> 00:13:11,570
.تُوجد العديد من أشكال الحياة التي تعيش في هذا الكون الشّاسع

218
00:13:11,570 --> 00:13:17,680
...حماية مُواطنيه و النّظام العامّ للكون

219
00:13:17,680 --> 00:13:22,070
.هذه مُهمّتنا كشُرطة الفضاء إلدلايف

220
00:13:22,070 --> 00:13:23,350
.لَقد نجح المُدير

221
00:13:23,910 --> 00:13:26,360
...يُمكنه قول مثل هذه الكلمات بجُرأةٍ كبيرة

222
00:13:26,700 --> 00:13:30,950
،على أيّة حال! مادُمتَ ستنجح في اختبار التّأهيل الذي أنا على وَشك إعطاءه لك

223
00:13:30,950 --> 00:13:33,250
.ستُصبح عُضواً رسميّاً لإلدلايف، أيّها الطّفل

224
00:13:33,250 --> 00:13:34,890
هاه؟! "طِفل"؟

225
00:13:34,890 --> 00:13:37,750
!إنتظر لَحظة! لَم أُوافق على هذا

226
00:13:37,750 --> 00:13:40,620
.لا تقلَق بشأن هذا! في الوَاقع، إفعلها فقط

227
00:13:41,010 --> 00:13:42,150
هل هذا أمر؟

228
00:13:42,150 --> 00:13:43,050
.خُذ الإختبار، تشوتا

229
00:13:43,050 --> 00:13:43,560
هاه؟

230
00:13:43,560 --> 00:13:47,180
.حاول الإنضمام إلى إلدلايف
!يبدو هذا مُمتعاً! إفعلها بالتّأكيد

231
00:13:47,180 --> 00:13:49,630
!إخرس! أغلِق فمك

232
00:13:50,150 --> 00:13:52,770
.أنتَ بالفِعل تتحدّث مع نفسكَ كثيراً

233
00:13:52,770 --> 00:13:53,850
...أمم

234
00:13:55,430 --> 00:13:56,840
.لا يُمكنني

235
00:13:56,840 --> 00:14:00,480
!أوو، هيّا

236
00:14:00,480 --> 00:14:01,960
.لا يُمكنني

237
00:14:01,960 --> 00:14:04,340
.فهمت. حسناً، هذا لَيس جيّداً

238
00:14:04,340 --> 00:14:06,460
ماذا علينا إخبار المَسؤولين؟

239
00:14:06,460 --> 00:14:11,970
...أيّها المُدير، ماذا لَو حصلَت صُدفةٌ جُنونيّةٌ ما، و حصل عُطلٌ ميكانيكيّ

240
00:14:11,970 --> 00:14:13,850
.أوهو، فهمت

241
00:14:13,850 --> 00:14:16,520
،إن حصل صُدفةً أن تمّ استنفاذ الأُوكسجين في بذلته الفضائيّة

242
00:14:16,520 --> 00:14:17,850
.نعم، نعم

243
00:14:16,520 --> 00:14:21,640
.و لَم يتمكّن من أخذ اختبار التّأهيل، لَن نتعرّض للمتاعب مع المَسؤولين

244
00:14:21,640 --> 00:14:23,750
!أمم، يُمكنني سماع كلّ ما تقولونه

245
00:14:23,750 --> 00:14:25,500
.لا يُمكنني المُوافقة على هذا

246
00:14:25,940 --> 00:14:28,050
،كما يُمكن أن تروا من عادته بالحديث مع نفسه

247
00:14:28,050 --> 00:14:29,600
.هو يُعاني من الأوهام

248
00:14:29,600 --> 00:14:31,090
.أعرف هذا الصّوت

249
00:14:29,600 --> 00:14:33,650
.و يبدو بأنّه لا يتردّد بالتّعبير عن هذه الأوهام

250
00:14:33,640 --> 00:14:35,930
مُستوى الإحراج الذي يتسبّب به أعلى من المُتوَسّط بعشرة أضعافٍ

251
00:14:35,930 --> 00:14:38,140
.بالنّسبة لطُلّاب المدارس المُتوسّطة عبر البلاد

252
00:14:38,140 --> 00:14:40,930
أعتقد بأنّها مسألة وَقتٍ فقط قبل أن يكون وُجوده نفسه

253
00:14:40,930 --> 00:14:43,740
.خاضعاً لقانون المُحافظات لحماية المُراهقين

254
00:14:43,740 --> 00:14:46,850
!لا أعرف من أنتِ، لكن توَقّفي عن التّفوّه بالهُراء عنّي

255
00:14:47,340 --> 00:14:48,400
التّفوّه بالهُراء؟

256
00:14:48,780 --> 00:14:51,290
.لا تعرفين شيئاً عنّي

257
00:14:51,290 --> 00:14:54,570
!لَن نعلَم إن لَم يكن بإمكاني فِعلها إن لم أُحاول حتّى

258
00:14:54,840 --> 00:14:57,060
!فهمت! إذاً ستفعلها

259
00:14:57,060 --> 00:14:58,620
!أُرحّب بالشّباب الشّغوفين من أمثالك

260
00:15:01,500 --> 00:15:03,410
.و ها أنتَ ذا

261
00:15:03,410 --> 00:15:07,370
...سِرتُ مع التيّار نوعاً ما فقط و قلتُ بأنّني سأفعلها، لكن

262
00:15:07,370 --> 00:15:10,030
!يبدو اختبار التّأهيل مُمتعاً

263
00:15:11,240 --> 00:15:14,170
ستُلقي القبض على مُجرمٍ فضائيٍّ من المُستوى سي من

264
00:15:14,170 --> 00:15:17,230
.كوكب تشابرول يختبئ في الأرض بهذه

265
00:15:17,230 --> 00:15:19,350
.إن فعلت، ستنجح في الإختبار

266
00:15:19,350 --> 00:15:22,310
أصفاد؟ هل سيتسبّب بجَلَبة؟

267
00:15:22,310 --> 00:15:27,610
.همم... إنّه فضائيٌّ مُفترس، لذا قد يتمّ التهامكَ إن لَم تكن حذراً

268
00:15:27,610 --> 00:15:28,600
!ماذا؟

269
00:15:28,600 --> 00:15:29,390
.شيرونيمو

270
00:15:29,640 --> 00:15:30,970
.أُترك الأمر لي، شيرو

271
00:15:30,970 --> 00:15:32,910
.شُعاع إسفي

272
00:15:32,910 --> 00:15:36,210
.تمّ تأكيد التّغيّرات في جُزيئات الهدف

273
00:15:33,440 --> 00:15:35,620
.بالمُناسبة، لَم أسأل أبداً عن أين سأذهب

274
00:15:35,620 --> 00:15:39,030
!ساطع

275
00:15:36,550 --> 00:15:38,090
.بدء النّقل

276
00:15:36,590 --> 00:15:37,840
إلى أين سأذهب؟

277
00:15:42,390 --> 00:15:43,960
!أوو

278
00:15:45,900 --> 00:15:47,000
أين أنا؟

279
00:15:47,750 --> 00:15:49,680
.هذه المنطقة الثّالثة لبلدة كيكي

280
00:15:49,680 --> 00:15:50,920
.أوه، نعم

281
00:15:50,920 --> 00:15:54,380
.هذا بالقُرب من منزلي
هل يُمكن أن يكون المُجرم هُنا؟

282
00:15:54,680 --> 00:15:58,820
ألَيس من المُضحك أنّه كان يُوجد فضائيٌّ بهذا القُرب، تشوتا؟

283
00:15:58,820 --> 00:16:00,210
.كلّا، على الإطلاق

284
00:16:00,210 --> 00:16:02,660
.لنُسرِع و نجد الفضائيّ، تشوتا

285
00:16:02,660 --> 00:16:04,100
،تقول هذا

286
00:16:04,720 --> 00:16:05,940
لكن كيف؟

287
00:16:08,820 --> 00:16:13,760
.الجّميع قد بدأ يبدو كفضائيٍّ الآن

288
00:16:15,170 --> 00:16:16,010
...همم

289
00:16:18,490 --> 00:16:21,510
لماذا تمّ اختياره من قِبل مذرز؟

290
00:16:21,960 --> 00:16:22,970
أوه؟

291
00:16:22,970 --> 00:16:24,700
ما الأمر، هاري؟

292
00:16:24,700 --> 00:16:26,540
...إنّه بشأن تشوتا كوكونوسي

293
00:16:26,540 --> 00:16:31,460
...قِراءاته الحيويّة غريبةٌ بعض الشّيء بالنّسبة لأرضيّ

294
00:16:31,460 --> 00:16:32,460
غريبة؟

295
00:16:32,460 --> 00:16:35,630
...هذا الجّزء هُنا الأعلى قليلاً عن الباقين

296
00:16:35,630 --> 00:16:37,800
.يتحرّك عبر سطح جسده

297
00:16:43,130 --> 00:16:46,260
هل يُوجد فضائيّون حقّاً؟

298
00:16:46,260 --> 00:16:49,390
!زيت! أشمّ زيتاً، تشوتا

299
00:16:50,950 --> 00:16:52,770
.لا أشمّه

300
00:16:52,770 --> 00:16:54,860
...أوه، إن لَم يكن كوكونوسي كن

301
00:16:54,860 --> 00:16:57,250
.أوه، تشوتا

302
00:16:57,250 --> 00:16:58,710
.أوه، مرحباً

303
00:16:58,710 --> 00:16:59,900
.السّائل

304
00:17:00,490 --> 00:17:03,170
أمم... هل أنتُما عائدان من الكاريوكي؟

305
00:17:03,170 --> 00:17:07,230
.تأخّر الوَقت كثيراً، لذا أتأكّد من أنّ تاتيان سيعود لمنزله بأمان

306
00:17:07,230 --> 00:17:08,580
ألَيس هذا رائعاً؟

307
00:17:08,870 --> 00:17:11,140
...فهمت

308
00:17:11,140 --> 00:17:13,420
!رائحة السّائل كالزّيت

309
00:17:13,420 --> 00:17:16,220
.أخبرتُك، لا أشمّ أيّ زيت

310
00:17:17,600 --> 00:17:20,360
هل يُمكن أنّكَ تتحدّث عنّي؟

311
00:17:20,360 --> 00:17:21,850
...كلّا، على الإطلاق

312
00:17:21,850 --> 00:17:26,300
.حسناً، نعم. رائحة ساوتومي تشان أفضل من هذا بكثير

313
00:17:26,780 --> 00:17:30,590
رائحة؟ هل يتحدّث عن إسفي؟

314
00:17:30,590 --> 00:17:36,020
.هذا لا يُصدّق. لا يملك الأرضيّون قُدرة الشّعور بالإسفي

315
00:17:36,300 --> 00:17:40,770
.تشوتا، أشمّ رائحة زيتٍ من السّائل
.رائحة السّائل كالزّيت

316
00:17:41,110 --> 00:17:45,050
!إخرس! أُخبرك، لا شيء له رائحةٌ كالزّيت

317
00:17:45,050 --> 00:17:48,590
...أيضاً، لَيس سائلاً

318
00:17:49,040 --> 00:17:53,590
من... من تدعو بالسّائل؟

319
00:17:53,960 --> 00:17:55,210
ساوتومي تشان؟

320
00:17:55,530 --> 00:17:56,840
سينساي؟

321
00:17:57,260 --> 00:18:06,430
."لا يُمكنني احتمال أن أُدعى بـ"السّائل
!إنّه أسوأ من تفويت وَجبةٍ حتّى

322
00:18:12,310 --> 00:18:14,150
!إنّه التشابروليان

323
00:18:14,150 --> 00:18:16,110
!لَقد وَجد المُجرم

324
00:18:16,430 --> 00:18:17,430
أوه؟

325
00:18:17,860 --> 00:18:21,280
أرغه، كيف اكتشفتَ أمري؟

326
00:18:21,680 --> 00:18:24,470
كان بالفِعل سائلاً، هاه، تشوتا؟

327
00:18:24,470 --> 00:18:26,660
.في الوَاقع، سأقول أنّه أشبه بكونه سميناً

328
00:18:26,660 --> 00:18:29,500
!لا تكن وَقحاً جدّاً

329
00:18:29,500 --> 00:18:33,170
!هذه شارة إلدلايف

330
00:18:33,780 --> 00:18:35,980
!لَن تقبض عليّ

331
00:18:35,980 --> 00:18:39,120
!إقترب أكثر، و سأقتل هذا الشّقيّ

332
00:18:39,970 --> 00:18:40,840
!تاتيان

333
00:18:40,840 --> 00:18:44,050
.سـ-ساعدني، تشوتا

334
00:18:45,300 --> 00:18:48,780
!ساعدني، تشوتا

335
00:18:49,960 --> 00:18:52,330
!ساعدني

336
00:18:52,330 --> 00:18:53,810
!سأُنقذك

337
00:18:53,810 --> 00:18:55,440
...تشوتا، الحجَر على يمينك

338
00:18:55,440 --> 00:18:56,720
!اليمين؟ حسناً

339
00:18:56,720 --> 00:18:58,870
!كلّا، هذا خطِر

340
00:19:02,060 --> 00:19:03,670
...سيحصل شيءٌ سيّءٌ ثانيةً

341
00:19:03,670 --> 00:19:05,650
.تقول هذا دائماً، تشوتا

342
00:19:05,650 --> 00:19:07,520
!هل ترى! لهذا السّبب بالضّبط

343
00:19:07,520 --> 00:19:11,570
!شخصٌ مِثلي، يستمرّ بسماع صوتٍ غريبٍ يكون بِلا فائدةٍ على الإطلاق

344
00:19:11,570 --> 00:19:13,740
!لَن أتمكّن من أن أُصبح ضابط شُرطةٍ أبداً

345
00:19:13,740 --> 00:19:17,230
!إن فهمت، أُغرب عن هُنا، إلدلايف

346
00:19:17,230 --> 00:19:20,400
!إنتظر، تشوتا! أنتَ الوَحيد

347
00:19:20,400 --> 00:19:24,360
!أرجوك! ساعدني، تشوتا

348
00:19:24,360 --> 00:19:27,760
أنا الوَحيد الذي يُمكنني إنقاذه؟

349
00:19:27,760 --> 00:19:29,140
!إخرس

350
00:19:32,350 --> 00:19:33,430
...تاتيان

351
00:19:33,430 --> 00:19:34,890
.هذا سيّء

352
00:19:34,890 --> 00:19:37,380
.بهذا المُعدّل، سيقضي علينا، تشوتا

353
00:19:39,430 --> 00:19:40,810
...أظنّها النّهاية

354
00:19:44,380 --> 00:19:47,470
.إن فعلتُ شيئاً، سيحصل شيءٌ سيّء

355
00:19:47,890 --> 00:19:52,080
.لهذا السّبب، على قدر استطاعتي، حاولتُ ألّا أتعامل مع الأشخاص من حولي

356
00:19:52,830 --> 00:19:53,780
...لكن

357
00:19:54,230 --> 00:19:56,080
.حسناً، تعال إن غيّرتَ رأيك

358
00:19:56,080 --> 00:19:56,870
.أنا تاتيان

359
00:19:58,080 --> 00:20:02,540
.تاتيان، الذي تحدّث إليّ على الرّغم من شخصيّتي، يطلُب مُساعدتي

360
00:20:03,360 --> 00:20:05,750
.علينا الإنسحاب للآن

361
00:20:06,430 --> 00:20:09,180
ألا يُمكنني إنقاذه بطريقةٍ ما؟

362
00:20:09,180 --> 00:20:10,350
تشوتا؟

363
00:20:11,090 --> 00:20:13,030
،أنتَ جُزءٌ منّي

364
00:20:13,030 --> 00:20:15,300
!لذا ساعدني بالتّفكير بطريقةٍ لإنقاذ تاتيان

365
00:20:15,610 --> 00:20:17,460
ماذا قُلتَ للتّوّ، تشوتا؟

366
00:20:17,460 --> 00:20:20,480
!إخرس، و فكّر معي

367
00:20:20,480 --> 00:20:24,280
!أنا الوَحيد هُنا
!سأُنقذ تاتيان

368
00:20:26,000 --> 00:20:27,290
معك؟

369
00:20:27,740 --> 00:20:31,280
.هذا غريب، تشوتا. إنّه شُعورٌ جديد

370
00:20:31,940 --> 00:20:35,240
.مستوى الإسفي لَدى تشوتا كوكونوسي يرتفع

371
00:20:36,250 --> 00:20:38,240
!توَقّف! أفلِت تاتيان

372
00:20:38,590 --> 00:20:40,790
.هيّا. سيُقسم إلى نِصفين

373
00:20:40,790 --> 00:20:45,470
!توَقّف

374
00:20:42,000 --> 00:20:43,210
...هيّا

375
00:20:46,300 --> 00:20:47,630
!التّقمّص

376
00:20:56,020 --> 00:20:59,480
.مرّ زمنٌ طويلٌ منذ تفعيل تقنيّة تقمّصي

377
00:20:59,820 --> 00:21:00,470
هاه؟

378
00:21:04,190 --> 00:21:05,890
ما-ما هذا؟

379
00:21:06,570 --> 00:21:10,640
.الرّمز على جبينه ينتمي إلى غريفيث المَفقودة

380
00:21:11,350 --> 00:21:15,160
...هناك طريقةٌ وَاحدةٌ لنتمكّن من رُؤية شيءٍ كهذا على الأرض

381
00:21:15,910 --> 00:21:16,850
!مونيتاليان

382
00:21:17,320 --> 00:21:22,950
المونيتاليان هُم كائناتٌ حيّةٌ تمّ إرسالها إلى مُختلف الكواكب لمُراقبتها

383
00:21:22,950 --> 00:21:27,340
.من قِبَل شعب غريفيث، الذين ازدهروا قبل أكثر من 4 بلايين عام

384
00:21:30,470 --> 00:21:32,180
.تعلو وَجهكَ نظرةٌ غبيّةٌ الآن، تشوتا

385
00:21:32,590 --> 00:21:33,600
!مُستحيل

386
00:21:33,600 --> 00:21:34,680
يُمكنكَ رُؤيتي؟

387
00:21:34,680 --> 00:21:37,180
...نعم، يُمكنني رُؤيتك! إذاً الصّوت الذي كان يتحدّث معي طوال هذا الوَقت

388
00:21:37,180 --> 00:21:38,430
.سنتحدّث لاحقاً، تشوتا

389
00:21:38,760 --> 00:21:40,480
.السّائل سيستيقظ

390
00:21:41,350 --> 00:21:45,640
!لا أعرف ماذا فعلتَ للتّوّ، لكنّكَ لن تفلتَ بهذا

391
00:21:51,940 --> 00:21:53,740
!لَن تفلت

392
00:21:53,740 --> 00:21:55,320
!تبّاً! تبّاً

393
00:21:55,840 --> 00:21:57,600
.تخيّل هذا، تشوتا

394
00:21:57,600 --> 00:22:00,950
.أيّ فِعلٍ مُشتركٍ سنفعله سيبدأ لَحظة تخيّلكَ له

395
00:22:01,460 --> 00:22:02,460
تخيّل؟

396
00:22:03,040 --> 00:22:04,700
!سأقضي عليكَ هذه المرّة

397
00:22:07,150 --> 00:22:08,140
!إنّه قادم

398
00:22:08,140 --> 00:22:11,210
.أُنظر إلى جسد ذلك الشّيء، و تخيّل كيف تهزمه

399
00:22:11,210 --> 00:22:12,040
هاه؟

400
00:22:13,530 --> 00:22:17,030
...جسد ذلك الشّيء رَخوٌ و فضفاض

401
00:22:17,630 --> 00:22:21,060
ماذا لَو خيّطنا جسده كخِرقة؟

402
00:22:21,470 --> 00:22:22,780
!التّقمّص

403
00:22:33,400 --> 00:22:35,700
!لا يُمكنني التنفّس

404
00:22:39,670 --> 00:22:41,200
!الأصفاد، تشوتا

405
00:22:41,200 --> 00:22:42,150
...ما-ماذا

406
00:22:44,940 --> 00:22:49,230
ماذا أنت؟

407
00:22:51,090 --> 00:22:56,260
...مونيتاليان بهذا التّطوّر و أرضيٌّ مُميّزٌ يُمكنه إخراج قوّته

408
00:22:57,580 --> 00:22:59,130
...هذا مُثيرٌ للإهتمام

409
00:22:59,980 --> 00:23:00,820
!أوو

410
00:23:01,760 --> 00:23:03,310
!تشوتا كوكونوسي

411
00:23:03,680 --> 00:23:06,570
!نجحتَ في اختبار تأهيل إلدلايف

412
00:23:07,520 --> 00:23:09,480
نجحت؟

413
00:23:10,320 --> 00:23:12,070
.أنا ضدّ هذا

414
00:23:18,360 --> 00:23:19,990
...ما-ماذا

415
00:23:19,990 --> 00:23:22,440
!تفعل ميسوزو سونوكاتا هُنا؟

416
00:23:26,000 --> 00:23:27,910
.التّخييط نجح بالفِعل، تشوتا

417
00:23:27,910 --> 00:23:28,460
.نعم

418
00:23:28,460 --> 00:23:31,140
لكن ألم يكن بإمكانكَ الخُروج بإسم هجمةٍ أروع؟

419
00:23:31,140 --> 00:23:33,210
هاه؟ التّخييط لَم يكن رائعاً؟

420
00:23:33,210 --> 00:23:34,150
هاه؟

421
00:23:34,150 --> 00:23:35,670
،في الحلقة القادمة من إلدلايف

422
00:23:35,670 --> 00:23:37,870
".فتاة الفضاء الرّائعة جدّاً"

423
00:23:37,870 --> 00:23:40,170
.أعتذر، سأتظاهر بأنّني لَم أسمع هذا