1
00:00:03,710 --> 00:00:05,340
!أوه، لا، تشو

2
00:00:05,340 --> 00:00:09,260
!كان هناك أكثر من شخصٍ خلف الدّكتور لوف، تشو

3
00:00:10,140 --> 00:00:11,820
من أنتَ بحقّ الله؟

4
00:00:11,820 --> 00:00:13,980
.يُمكنني أن أطرَح عليكَ نفس السّؤال

5
00:00:14,660 --> 00:00:16,230
من أنتُم؟

6
00:00:16,230 --> 00:00:18,600
.نحن من إلدلايف

7
00:00:18,600 --> 00:00:21,540
.مَقبوضٌ عليكَ للإشتباه بارتكابكَ جريمة قتل

8
00:00:22,070 --> 00:00:23,310
.فهمت

9
00:00:23,310 --> 00:00:24,620
شُرطة الفضاء، هاه؟

10
00:00:25,270 --> 00:00:27,790
هل الرّجل بالبذلة الذي هناك مُجرمٌ إذاً؟

11
00:00:27,790 --> 00:00:31,160
!سُحقاً! لَقد أفسدتّ خُطّتي

12
00:00:31,640 --> 00:00:33,550
.أخبرني شيئاً

13
00:00:33,550 --> 00:00:38,010
هل يُمكن لخُطّةٍ احتاجت مُسنّاً كهذا أن تنجح حقّاً؟

14
00:00:38,010 --> 00:00:39,420
!بالتّأكيد

15
00:00:39,420 --> 00:00:42,000
!دِماغ الدّكتور لوف كان يحوي مِفتاح البوّابة

16
00:00:42,000 --> 00:00:45,430
!لَو حصلتُ عليه، لأمكنني الحُصول على كنزٍ رائع

17
00:00:46,020 --> 00:00:47,200
كنز؟

18
00:00:47,200 --> 00:00:48,420
ماذا يعني؟

19
00:00:48,420 --> 00:00:54,200
.يبدو بأنّه احتاج الدّكتور لوف لإيجاد ما كان يبحث عنه

20
00:00:54,660 --> 00:00:55,900
...أوه

21
00:00:55,900 --> 00:00:59,530
،كان كِلا شُرطة الفضاء و المُجرمون يُلاحقونك

22
00:01:00,000 --> 00:01:02,240
،كنتَ مُحتجزاً في هذه الغُرفة الصّغيرة

23
00:01:02,240 --> 00:01:05,280
و عندما ظننتَ بأنّكَ قد وَجدتّ طريقاً للخُروج، كان لاصطياد كنز؟

24
00:01:06,030 --> 00:01:09,250
.كان حظّكَ سيّئاً بشكلٍ بائس، دكتور لوف

25
00:01:09,250 --> 00:01:11,630
!إخرس، أيّها الشّقيّ

26
00:01:11,630 --> 00:01:13,010
!مُتّ

27
00:01:15,460 --> 00:01:16,460
!هل صدّها؟

28
00:01:16,460 --> 00:01:17,250
دِرع؟

29
00:01:17,250 --> 00:01:19,170
.أُجيد صُنع الأشياء

30
00:01:19,460 --> 00:01:20,590
...لماذا، أيّها الحقير

31
00:01:27,420 --> 00:01:31,450
.لَون حدقتكَ مُثيرٌ للإهتمام

32
00:01:31,450 --> 00:01:34,310
.لونها كالعنبر، و فيها خطٌّ مُميّزٌ جدّاً في النّصف السّفليّ

33
00:01:34,310 --> 00:01:36,490
.لَم أتوَقّع أن أراها هُنا أبداً

34
00:01:37,160 --> 00:01:39,980
.أتمنّى لَو أمكنني دِراستها أكثر

35
00:01:39,980 --> 00:01:41,800
.هذ سيّءٌ جدّاً

36
00:01:43,210 --> 00:01:44,020
ماذا؟

37
00:03:25,960 --> 00:03:27,730
!أنتَ هناك

38
00:03:29,530 --> 00:03:31,400
.لَن نتردّد باستخدام القوّة إن قاوَمت

39
00:03:32,660 --> 00:03:34,490
.إبقى هُنا، ضابط كوكونوسي

40
00:03:34,490 --> 00:03:35,570
.يويوسا

41
00:03:35,570 --> 00:03:37,680
.تشيبس،  نينوتشكا، سننزل إلى هناك

42
00:03:39,520 --> 00:03:42,020
.أنتَ مَقبوضٌ عليكَ بتُهمة القتل

43
00:03:42,020 --> 00:03:44,110
قتل؟ أنا؟

44
00:03:44,110 --> 00:03:44,910
.إخرس

45
00:03:47,490 --> 00:03:49,610
.لَقد قبضوا عليه بسهولة

46
00:03:49,610 --> 00:03:51,990
...نعم، لكن

47
00:03:52,450 --> 00:03:56,730
.كان علينا إعادة الدّكتور لوف معنا لتبرئة سونوكاتا من الشّبهة

48
00:03:57,180 --> 00:04:00,200
.لا يُمكننا إنقاذها الآن

49
00:04:00,630 --> 00:04:02,420
!هواه! أنا مُرتفعٌ جدّاً

50
00:04:02,420 --> 00:04:04,380
!لماذا تمّ تعليقي في الأعلى لأجفّ؟

51
00:04:05,550 --> 00:04:06,850
ماذا يحصل؟

52
00:04:06,850 --> 00:04:07,880
أين أنا؟

53
00:04:08,340 --> 00:04:09,970
...إ-إنّه على قيد الحياة

54
00:04:09,970 --> 00:04:12,090
!هاي! أيّها الأشقياء

55
00:04:12,090 --> 00:04:15,430
!من أنتُم؟ لا تقِفوا و تُشاهِدوا فقط! أنقِذوني

56
00:04:17,680 --> 00:04:18,970
!لَقد مات أحدهم

57
00:04:22,180 --> 00:04:23,950
.هل ترون؟ لَم أقتُله

58
00:04:23,950 --> 00:04:26,250
!كبّليه بالأصفاد أيضاً، نينو

59
00:04:26,250 --> 00:04:27,400
!يـ-يويوسا

60
00:04:28,270 --> 00:04:31,970
ما مَعنى هذا؟
ماذا فعلتَ له؟

61
00:04:31,970 --> 00:04:33,300
هل سألتِ ماذا؟

62
00:04:33,300 --> 00:04:40,020
إستخدمتُ شُعاع إزالة الإس بي إتش لتنظيف جسده من إس
.بي إتش التّحكّم عن بُعدٍ الذي امتصّه

63
00:04:40,020 --> 00:04:42,420
إس بي إتش التّحكّم عن بُعد؟

64
00:04:42,920 --> 00:04:44,470
،كما يُشير الإسم

65
00:04:44,470 --> 00:04:46,890
إنّه إس بي إتش يسمح للمُستخدِم الذي ينبعث منه

66
00:04:46,890 --> 00:04:50,900
.بالسّيطرة على أيّ شخصٍ يمتصّه عن بُعد

67
00:04:51,270 --> 00:04:56,020
.الغِشاء المُتميّز ذا لَون العنبر يتشكّل في عينيّ المُتلَقّي

68
00:04:56,560 --> 00:05:00,260
.إنّها موجودةٌ فقط بشكلٍ تجريبيٍّ حتّى الآن مع هذا

69
00:05:00,990 --> 00:05:05,850
.ذلك الرّجل كان على الأرجح أرضيّاً عاديّاً تحت السّيطرة

70
00:05:05,850 --> 00:05:08,000
إذاً العقل المُدبّر هو شخصٌ آخر؟

71
00:05:08,000 --> 00:05:08,830
.نعم

72
00:05:09,320 --> 00:05:13,230
.دكتور لوف المِسكين، هناك شخصٌ غريبٌ يسعى خلفه

73
00:05:13,990 --> 00:05:15,430
!أُنظر من يتحدّث

74
00:05:15,430 --> 00:05:18,460
ألَستَ من صنعَ منه فوضىً عارمة؟

75
00:05:18,920 --> 00:05:19,950
.نعم

76
00:05:20,610 --> 00:05:22,430
.لكن هذه لَيست جُثّة

77
00:05:22,990 --> 00:05:26,360
.لَيست سوى مُخلّفاتٍ من إعادة بِناء جسد

78
00:05:27,080 --> 00:05:28,820
،خِلال إعادة البِناء

79
00:05:28,820 --> 00:05:33,890
.حصل انفصالٌ غير مُتوَقّعٍ بين الخلايا القديمة و الجّديدة

80
00:05:33,890 --> 00:05:35,600
.يُمكن القول بأنّ هذا يُشبه التّخلّص من الجّلد القديم

81
00:05:35,600 --> 00:05:37,730
ماذا تعني؟

82
00:05:37,730 --> 00:05:38,910
،أعني

83
00:05:39,820 --> 00:05:42,810
.يقِف الدّكتور لوف أمامكم

84
00:05:45,440 --> 00:05:47,890
.تعتمدون كثيراً على أعيُنكم

85
00:05:47,890 --> 00:05:51,450
!تشيبس! قارن الإس بي إتش خاصّته بالتي تخصّ الدّكتور لوف

86
00:05:51,450 --> 00:05:52,700
!يويوسا

87
00:05:56,410 --> 00:05:57,920
!إنّها تتطابق، تشو

88
00:05:57,920 --> 00:06:00,420
!إنّه الدّكتور لوف حقّاً، تشو

89
00:06:00,420 --> 00:06:01,260
!مُستحيل

90
00:06:01,260 --> 00:06:03,120
!لا يُشبه الصّورة على الإطلاق

91
00:06:03,680 --> 00:06:07,890
هل أنتَ حقّاً الدّكتور تاكلاماكان ستراينجلوف؟

92
00:06:07,890 --> 00:06:08,630
.نعم

93
00:06:08,630 --> 00:06:11,170
لماذا  عُدتّ شابّاً ثانيةً؟

94
00:06:11,500 --> 00:06:12,760
ألَيس هذا وَاضحاً؟

95
00:06:12,760 --> 00:06:14,990
.كلّما كنتُ أصغر، أكون بصِحّةٍ أفضل

96
00:06:15,810 --> 00:06:19,530
الإس بي إتش خاصّتكِ تملك رائحة... دولتاليان؟

97
00:06:19,530 --> 00:06:20,640
.كلّا

98
00:06:21,120 --> 00:06:23,860
هل يُمكن أن تكوني من نَسل الكورزيان؟

99
00:06:23,860 --> 00:06:25,270
...نـ-نعم

100
00:06:25,270 --> 00:06:26,850
!عرفتُ هذا

101
00:06:26,850 --> 00:06:28,940
.لابدّ من أنّكِ تُطلِقين ركلاتٍ قويّةً جدّاً إذاً

102
00:06:28,940 --> 00:06:30,850
.حـ-حسناً، نعم

103
00:06:31,380 --> 00:06:32,460
.هذه هي

104
00:06:32,460 --> 00:06:34,400
.عضلاتكِ الفخذيّة مَرِنةٍ بشكلٍ مُدهش

105
00:06:35,990 --> 00:06:37,900
.تُشبه شارِب الفقمة السّنبليّة

106
00:06:38,480 --> 00:06:41,500
،أكثر ما يُميّز الكورزيان لَيس القرن في جبينهم

107
00:06:41,500 --> 00:06:45,620
.بل عضلات المَعِدة و عضلات الفَخذ التي تلتقي في مُنتصف الجّسد

108
00:06:43,740 --> 00:06:44,750
...أمم

109
00:06:46,220 --> 00:06:46,960
.هُنا

110
00:06:47,760 --> 00:06:49,350
.نعم، هذا هو الشّعور

111
00:06:50,830 --> 00:06:53,750
.إخلَعي ملابسك
.أُريد لَمسها مُباشرةً

112
00:06:55,980 --> 00:06:58,220
!إييك

113
00:07:03,540 --> 00:07:05,100
.أوه، صحيح

114
00:07:05,100 --> 00:07:06,540
.أعتذر

115
00:07:06,540 --> 00:07:10,670
.نسيتُ بأنّ الكثير من أشكال الحياة الشّبيهة بالبَشر يَكرهون الكشف عن أنفسهم

116
00:07:10,670 --> 00:07:12,480
.أميل إلى نِسيان هذا عندما أكون مُستغرِقاً بهم

117
00:07:12,870 --> 00:07:14,230
.سأركلكَ في المرّة القادمة

118
00:07:14,750 --> 00:07:16,230
...هل الدّكتور لوف

119
00:07:16,230 --> 00:07:18,190
.ياله من رجلٍ مُدهش

120
00:07:18,190 --> 00:07:19,270
غريب أطوار؟...

121
00:07:19,270 --> 00:07:21,490
!كلّا، إنّه أشبه بمُنحرف

122
00:07:22,510 --> 00:07:24,600
...لا تُخبرني، سونوكاتا أيضاً

123
00:07:25,710 --> 00:07:27,910
هل أنتِ مُستعدّة، ميسوزو؟

124
00:07:28,260 --> 00:07:29,880
.نعم، دكتور لوف

125
00:07:29,880 --> 00:07:31,760
...حسناً، لنَبدأ

126
00:07:31,760 --> 00:07:34,370
.لنَبدأ مَشروع تاكلاماكان خاصّتنا

127
00:07:34,770 --> 00:07:37,260
.نعم، دكتور لوف

128
00:07:39,330 --> 00:07:41,820
هل ستخلَعين ملابسكِ لأجلي إذاً؟

129
00:07:42,510 --> 00:07:45,070
.نعم... دكتور لوف

130
00:07:48,970 --> 00:07:55,030
.لنَبدأ بمَشروع تاكلاماكان

131
00:07:55,960 --> 00:07:56,910
،أم هل عليّ القول

132
00:07:59,410 --> 00:08:01,030
.مَشروع طرزان و جاين

133
00:08:02,470 --> 00:08:05,780
!هل هذا ما كان يدور مَشروع تاكلاماكان حوله؟

134
00:08:05,780 --> 00:08:07,470
.لا أظنّ هذا

135
00:08:07,470 --> 00:08:11,130
.إضافةً إلى هذا، الدّكتور لوف كان مُسنّاً وَقتها، تشوتا

136
00:08:13,000 --> 00:08:15,720
!سُحقاً لك، دكتور لوف

137
00:08:15,720 --> 00:08:17,010
هل أنتَ بخيرٍ هناك، أيّها المُستجدّ؟

138
00:08:20,110 --> 00:08:22,240
.هـ-هذا لا شيء

139
00:08:22,240 --> 00:08:26,510
حسناً، قُمنا بتأمين الدّكتور لوف، إذاً ما رأيكَ بأن نعود؟

140
00:08:26,510 --> 00:08:28,390
.كان يُفترض بنا تأمينه

141
00:08:28,920 --> 00:08:31,480
هل تُمانعين خلع هذه أوّلاً؟

142
00:08:31,850 --> 00:08:34,140
.أعتذر، لَقد نسيت

143
00:08:40,960 --> 00:08:41,990
المُفتّشة المُساعدة فيرونيكا؟

144
00:08:41,990 --> 00:08:43,240
!المُفتّش المُساعد تشيبس

145
00:08:45,250 --> 00:08:48,490
.سعيدةٌ لرُؤيتكَ بصحّةٍ جيّدة، دكتور لوف

146
00:08:48,490 --> 00:08:50,830
،بدِماغك

147
00:08:50,830 --> 00:08:53,380
.يُمكنني فتح الباب إلى الكنز

148
00:08:53,380 --> 00:08:55,680
ا-الضّابطة نينوتشكا؟

149
00:08:56,260 --> 00:08:57,660
...حدَقتُها

150
00:08:58,170 --> 00:09:01,370
.سيطَر عليها إس بي إتش التّحكّم عن بُعدٍ أيضاً

151
00:09:01,880 --> 00:09:04,430
لا يُمكن أن نكون شديدي الحذر، هاه؟

152
00:09:04,430 --> 00:09:06,840
...مُـ-مُستحيل

153
00:09:07,260 --> 00:09:09,020
.لكن هذا غريب

154
00:09:09,020 --> 00:09:14,120
.يُشترط بالإس بي إتش ذا التّحكّم عن بُعدٍ تقارباً بين وَعي الطّرَفين

155
00:09:14,770 --> 00:09:17,290
كيف سيطرتَ على فردٍ من إلدلايف؟

156
00:09:17,710 --> 00:09:20,060
.لا أُمانع بإخبارك، دكتور لوف

157
00:09:31,030 --> 00:09:33,650
.أعني إن رافقتَني

158
00:09:34,210 --> 00:09:35,990
.سأرفض

159
00:09:35,990 --> 00:09:39,380
.العُلَماء عُرضةٌ لأن يُقتَلوا حالَما يُعتبرون عديمي الفائدة

160
00:09:39,380 --> 00:09:42,090
.لا تملك الحقّ للرّفض

161
00:09:46,240 --> 00:09:47,490
.الآن، رافِقني

162
00:09:51,510 --> 00:09:53,060
.هذا سيّءٌ جدّاً

163
00:09:53,060 --> 00:09:54,350
!إنتظري

164
00:09:59,050 --> 00:10:01,070
!لَن أسمح لكِ بأخذ الدّكتور لوف

165
00:10:01,820 --> 00:10:04,280
.أوه، نسيتُ بأنّكَ موجود

166
00:10:04,280 --> 00:10:07,070
هل تتمنّى الموت، ضابط كوكونوسي؟

167
00:10:07,700 --> 00:10:11,190
...الضّابطة الملائكيّة نينوتشكا

168
00:10:11,940 --> 00:10:13,120
.دكتور لوف

169
00:10:14,190 --> 00:10:18,830
هل من سبيلٍ لتحرير الضّابطة نينوتشكا من إس بي إتش التّحكّم عن بُعد؟

170
00:10:18,830 --> 00:10:21,700
هل يُمكنكَ إفقادها وَعيها؟

171
00:10:21,700 --> 00:10:25,300
.خلال ذلك الوَقت، سأُصلِح شُعاع إزالة الإس بي إتش و أُطلِقه

172
00:10:25,790 --> 00:10:28,810
.إذاً لا نملك خياراً سوى بالقِتال و الإنتصار، تشوتا

173
00:10:28,810 --> 00:10:29,560
.نعم

174
00:10:32,180 --> 00:10:33,510
.يجب علينا فِعل هذا

175
00:10:48,020 --> 00:10:50,220
،أعلَم بأنّه من غير المُناسب قول هذا الآن

176
00:10:50,220 --> 00:10:52,570
.لكن قلبي يتسارع بسبب الإثارة

177
00:10:52,570 --> 00:10:54,830
...برؤيتكَ تنمو على تشوتا كوكونوسي

178
00:10:56,390 --> 00:10:59,550
.المونيتاليان هُم أحد مواضيع أبحاثي

179
00:10:59,550 --> 00:11:01,530
...حـ-حسناً

180
00:11:01,530 --> 00:11:05,610
.أعتذر على سحق آمالك، لكن يُفترض بكَ أن تستسلِم على الأرجح

181
00:11:05,920 --> 00:11:07,290
،أعني

182
00:11:07,670 --> 00:11:09,550
!أنا قويّةٌ جدّاً

183
00:11:13,850 --> 00:11:15,520
!خيّطها، دولو

184
00:11:15,980 --> 00:11:17,250
!تقمّص

185
00:11:27,240 --> 00:11:30,570
.لَم يتطوّر المونيتاليان

186
00:11:30,570 --> 00:11:32,030
.سيكون هذا صعباً

187
00:11:33,680 --> 00:11:35,040
هل أنتَ بخير، تشوتا؟

188
00:11:35,500 --> 00:11:37,040
ما الخطب؟

189
00:11:37,040 --> 00:11:39,870
ماذا حصل لأمر إفقادي وَعيي؟

190
00:11:39,870 --> 00:11:41,190
.لا يُمكنني فِعل هذا

191
00:11:41,190 --> 00:11:42,970
.إنّها بمُستوىً مُختلفٍ تماماً

192
00:11:43,460 --> 00:11:46,010
.تشوتا، أنا أتلاشى

193
00:11:46,010 --> 00:11:47,880
.لا يُمكنكَ أن تنتصر إن فقدتّ ثِقتكَ بنفسك

194
00:11:48,310 --> 00:11:50,560
...أعلَم هذا. أعلَم هذا، لكن

195
00:11:50,870 --> 00:11:54,850
!لا يُمكنني فِعل شيءٍ بشأن خوفي

196
00:11:54,850 --> 00:11:56,220
...تشوتا

197
00:11:56,690 --> 00:11:57,610
...أُهرب

198
00:11:58,380 --> 00:12:00,560
...أُهرب بعيداً

199
00:12:01,050 --> 00:12:02,310
المُفتّشة المُساعدة فيرونيكا؟

200
00:12:02,740 --> 00:12:04,980
...لا يُمكنكَ التّعامل معها

201
00:12:05,600 --> 00:12:08,910
...كلّ هذا خطأي... أعتذر

202
00:12:08,910 --> 00:12:10,580
!ماذا تقولين؟

203
00:12:10,580 --> 00:12:12,120
...أُهرب بعيداً

204
00:12:12,680 --> 00:12:14,240
...أسرِع

205
00:12:14,240 --> 00:12:15,870
!يجب على الأقلّ أن تخرُج من هذا على قيد الحياة

206
00:12:16,310 --> 00:12:17,840
أهرب لوَحدي؟

207
00:12:18,880 --> 00:12:21,040
،حتّى لَو نجوتُ بحياتي

208
00:12:21,040 --> 00:12:25,880
...فيرونيكا، تشيبس، الدّكتور لوف، و نينوتشكا هُنا

209
00:12:26,350 --> 00:12:27,180
...و...

210
00:12:28,600 --> 00:12:30,560
.سونوكاتا، لَن يتمّ إنقاذُهم...

211
00:12:31,140 --> 00:12:35,160
.أنا الوَحيد الذي بإمكانه إنقاذهم الآن

212
00:12:35,870 --> 00:12:38,680
!من المُستحيل أن أتمكّن من الهرب

213
00:12:41,340 --> 00:12:42,480
...تماسكي

214
00:12:43,170 --> 00:12:44,730
.تماسكي لوَقتٍ أطول قليلاً فقط

215
00:12:44,730 --> 00:12:47,570
.أعِد بأنّني سآخذكِ إلى المُستوصف

216
00:12:48,940 --> 00:12:51,000
.لَقد عُدتّ

217
00:12:51,000 --> 00:12:54,590
.ثِقتكَ المُتلاشية بنفسكَ قد عادت

218
00:12:54,590 --> 00:12:55,830
كيف؟

219
00:12:55,830 --> 00:12:57,480
.لا أعرف السّبب أنا نفسي

220
00:12:57,480 --> 00:13:01,090
.مع هذا، يجب أن أُؤمِن بنفسي الآن

221
00:13:01,520 --> 00:13:04,100
!أعني، أُريد أن أُنقِذ الجّميع

222
00:13:04,730 --> 00:13:08,090
تُريد أن تُنقِذ الجّميع، لذا تُؤمِن بنفسك؟

223
00:13:08,550 --> 00:13:11,150
.لَقد عادت ثِقتكَ بنفسكَ بقوّة

224
00:13:11,150 --> 00:13:13,080
.حسناً، لنَفعلها، دولو

225
00:13:13,080 --> 00:13:14,430
!نعم، تشوتا

226
00:13:14,430 --> 00:13:16,680
أوه، تُريد الإستمرار؟

227
00:13:21,440 --> 00:13:23,390
.لا يُمكنكَ الإنتصار بالهرب

228
00:13:23,390 --> 00:13:25,400
.إذهب خلفها

229
00:13:25,400 --> 00:13:27,980
.لا يُمكنني. لا تُشيح بناظريها عنّا

230
00:13:27,980 --> 00:13:29,180
.معكَ حقّ

231
00:13:29,620 --> 00:13:31,240
.تشوتا، أُنظر للأعلى

232
00:13:32,230 --> 00:13:34,000
.أتتني فِكرةٌ رائعةٌ للتّوّ

233
00:13:34,700 --> 00:13:36,780
هل تُحبّ الغُمّيضة؟

234
00:13:36,780 --> 00:13:38,110
.هذا لَن ينجح

235
00:13:38,110 --> 00:13:39,920
...إن لَم تخرج، سوف

236
00:13:48,590 --> 00:13:50,260
تمويهٌ مصنوعٌ من الكيبلات؟

237
00:13:51,520 --> 00:13:52,430
.الآن

238
00:13:52,430 --> 00:13:53,460
!خُذي هذا

239
00:13:53,460 --> 00:13:55,220
.أمزح فقط. يُمكنني مَعرفة ما تُخطّط له بسهولة

240
00:14:00,940 --> 00:14:02,020
!دولو

241
00:14:10,390 --> 00:14:12,230
!هذا لَيس جيّداً. إبتعد عن الطّريق، دولو

242
00:14:14,190 --> 00:14:15,630
هل تسمعني؟

243
00:14:16,470 --> 00:14:17,780
!دولو

244
00:14:42,280 --> 00:14:44,770
...رائحة إس بي إتش مُحترقة

245
00:14:44,770 --> 00:14:46,470
.إنّها نوعٌ لرائحة ما بعد الموت

246
00:14:54,450 --> 00:14:55,850
...هذا حارّ

247
00:14:55,850 --> 00:14:57,260
ماذا يحصل؟

248
00:14:57,260 --> 00:14:58,490
.وَجهي يحترق

249
00:15:01,380 --> 00:15:03,240
...هاه؟ لا يُمكنني أن أتحدّث

250
00:15:03,240 --> 00:15:04,740
ماذا يحصل؟

251
00:15:04,740 --> 00:15:05,500
...دولو

252
00:15:08,400 --> 00:15:09,500
دولو؟

253
00:15:17,250 --> 00:15:18,600
!دولو؟

254
00:15:19,730 --> 00:15:23,360
.المونيتاليان ومُضيفوهم يتعرّضون لنَفس الضّرر

255
00:15:23,360 --> 00:15:26,280
...نَظراً إلى حالة المونيتاليان، لابدّ من أنّ مُضيفه

256
00:15:31,530 --> 00:15:32,570
.لا يُمكنني أن أتنفّس

257
00:15:32,570 --> 00:15:36,070
.المونيتاليان لَيسوا سوى آثارٍ قديمة

258
00:15:36,070 --> 00:15:40,330
.الموت بألَمٍ مع مُضيفه هي نهايةٌ مُلائمةٌ لأحدهم

259
00:15:43,140 --> 00:15:44,410
الموت...؟

260
00:15:44,810 --> 00:15:47,210
هل سأموت؟

261
00:15:48,210 --> 00:15:53,660
دون إنقاذ سونوكاتا، فيرونيكا، نينوتشكا، أو تشيبس؟

262
00:15:54,480 --> 00:15:55,450
...سُحقاً

263
00:15:58,790 --> 00:16:00,010
.تشوتا

264
00:16:01,090 --> 00:16:02,840
هل هذا أنت، دولو؟

265
00:16:04,460 --> 00:16:06,520
كنتُ أُفكّر

266
00:16:06,520 --> 00:16:10,850
.بشأن سبب إشاحة ناظِرَيكَ عن الوَقائع و ثِقتكَ بميسوزو

267
00:16:11,200 --> 00:16:12,920
هل تمزح معي؟

268
00:16:12,920 --> 00:16:15,610
هل تتحدّث عن هذا الآن؟

269
00:16:15,610 --> 00:16:20,260
.لا أظنّكَ كنتَ لتفعل هذا قبل فترةٍ قصيرة

270
00:16:20,260 --> 00:16:23,260
.تغيّرتَ منذ انضمامكَ إلى إلدلايف

271
00:16:23,260 --> 00:16:27,360
.أُريد معرفة أسباب أيّ تغييراتٍ بك

272
00:16:27,360 --> 00:16:30,630
.و أظنّني اكتشفتُها الآن

273
00:16:31,810 --> 00:16:35,380
.كنتَ تأمل أن تكون ميسوزو بريئة

274
00:16:35,380 --> 00:16:38,680
.لهذا آمنتَ بها و قُلتَ بأنّها بريئة

275
00:16:39,430 --> 00:16:43,770
.أمِل الدّكتور إسحاق أن تحمي ميسوزو

276
00:16:43,770 --> 00:16:47,690
.لهذا وَثِق بكَ و أخبركَ بسرّها

277
00:16:48,610 --> 00:16:51,270
...و بهذا القِتال

278
00:16:51,270 --> 00:16:53,060
.لا أعرف السّبب أنا نفسي

279
00:16:53,060 --> 00:16:56,850
.مع هذا، يجب أن أُؤمِن بنفسي الآن

280
00:16:56,850 --> 00:16:59,650
!أعني، أُريد أن أُنقِذ الجّميع

281
00:17:00,420 --> 00:17:03,390
.تمنّيتَ إنقاذ الجّميع...

282
00:17:04,050 --> 00:17:08,720
.بهذه الطّريقة، تمكّنتَ من الإيمان بنفسكَ حقّاً

283
00:17:09,410 --> 00:17:12,830
...نعم، لَقد أدركتُ أخيراً

284
00:17:13,670 --> 00:17:16,920
.بأنّ الإيمان بأحدهم هو تعبيرٌ عن الأمَل...

285
00:17:17,560 --> 00:17:18,670
أمَل؟

286
00:17:18,670 --> 00:17:21,680
.لذا سأُؤمن بكَ أيضاً

287
00:17:22,290 --> 00:17:23,430
دولو؟

288
00:17:23,430 --> 00:17:28,160
.لأنّني آمل أن أبقى في علاقةٍ تكافليّةٍ معك، و لَيس مع أحدٍ غيرك

289
00:17:29,600 --> 00:17:32,390
.قتل عمليّة دَعم حياة المُضيف

290
00:17:32,390 --> 00:17:34,190
.تفعيل برنامج النّجاة

291
00:17:38,280 --> 00:17:39,570
.إنّه يبدأ

292
00:17:39,570 --> 00:17:40,450
ما هذا؟

293
00:17:40,450 --> 00:17:43,240
،عندما يكون مُضيفهم على حافّة الموت

294
00:17:43,240 --> 00:17:49,200
،يستخدم المونيتاليان كامل طاقتهم للتّطوّر ليهربوا من الخَطر

295
00:17:49,200 --> 00:17:51,000
.بمُحاولةٍ للنّجاة

296
00:17:51,000 --> 00:17:53,500
إذاً مازلتَ تُحاول أن تعيش؟

297
00:17:53,500 --> 00:17:56,580
!سأُمزّقكما حتّى الموت يا غريبا الأطوار

298
00:17:59,850 --> 00:18:00,840
إنحرف؟

299
00:18:01,370 --> 00:18:05,880
.الهدف من تطوّر المونيتاليان لَيس للهرب من المأزق الحاليّ

300
00:18:06,350 --> 00:18:09,540
.بل للبحث عن مُضيفٍ جديدٍ و الإنتقال إليه

301
00:18:09,930 --> 00:18:12,030
.تمّ الكشف عن المُضيف التّالي

302
00:18:12,030 --> 00:18:15,680
.حِساب التّطوّر اللّازم و التّحوّل

303
00:18:18,450 --> 00:18:19,860
.هُجوم

304
00:18:21,550 --> 00:18:23,780
ما-ما كان ذلك؟

305
00:18:24,280 --> 00:18:26,770
.يبدو بأنّه قد وَجد الحلّ الأمثل

306
00:18:31,810 --> 00:18:33,420
.تمّ تأكيد التّحوّل

307
00:18:47,890 --> 00:18:49,220
.هُجوم

308
00:18:51,350 --> 00:18:57,420
.هذا التّطوّر المُخيف تقريباً هو أعلى تطوّرٍ لتكنولوجيا غريفيث

309
00:18:57,890 --> 00:19:01,530
.الآن، سيتلاعب بفريسته فقط حتّى تتوَقّف عن المُقاومة

310
00:19:01,530 --> 00:19:02,530
.هُجوم

311
00:19:03,770 --> 00:19:04,990
!هذا لَن يحصل

312
00:19:04,990 --> 00:19:06,700
!لَن أخسر هذا الجّسد

313
00:19:06,700 --> 00:19:07,540
.هُجوم

314
00:19:11,490 --> 00:19:12,500
.هُجوم

315
00:19:14,060 --> 00:19:16,670
ماذا تفعل، دولو؟

316
00:19:16,670 --> 00:19:18,550
.تمّ تأمين مُضيف

317
00:19:18,550 --> 00:19:19,750
.هُجوم

318
00:19:20,970 --> 00:19:23,170
.توَقّف، دولو

319
00:19:23,510 --> 00:19:24,660
.توَقّف

320
00:19:25,170 --> 00:19:26,100
.هُجوم

321
00:19:28,950 --> 00:19:30,680
.ضبط الإستهداف

322
00:19:31,030 --> 00:19:31,820
...تـ

323
00:19:33,080 --> 00:19:34,330
...لا يُمكنني أن أتحدّث

324
00:19:33,490 --> 00:19:35,100
.تمّ تأمين مُضيف

325
00:19:34,330 --> 00:19:35,100
.دولو

326
00:19:36,450 --> 00:19:38,650
.عُد لوَعيك، دولو

327
00:19:39,000 --> 00:19:39,940
.هُجوم

328
00:19:39,940 --> 00:19:41,320
!دولو

329
00:19:42,810 --> 00:19:48,280
!تعلَم بأنّكَ أفضل من هذا

330
00:19:49,230 --> 00:19:50,450
!تقمّص

331
00:20:10,230 --> 00:20:10,970
!دولو؟

332
00:20:10,970 --> 00:20:11,970
!تشوتا

333
00:20:11,970 --> 00:20:13,200
هل هذا أنتَ حقّاً؟

334
00:20:13,200 --> 00:20:15,430
.نعم، هذا أنا، تشوتا

335
00:20:16,040 --> 00:20:17,220
.حمداً لله

336
00:20:17,220 --> 00:20:19,220
.لَقد عُدتّ لطبيعتك

337
00:20:19,220 --> 00:20:22,070
.فقدتّ نفسي بالفِعل للحظةٍ هناك

338
00:20:22,980 --> 00:20:27,110
.لَقد نجحتَ للتّوّ بالقيام بإعادة اتّصالٍ مع مونيتاليان

339
00:20:27,570 --> 00:20:29,400
إعادة إتّصال؟

340
00:20:29,400 --> 00:20:31,620
،حاولتُ أن أتركك

341
00:20:31,620 --> 00:20:33,890
.بعدها أعدتُّ الإتّصال بكَ ثانيةً

342
00:20:33,890 --> 00:20:35,710
حقّاً؟

343
00:20:35,710 --> 00:20:38,160
.هذا لَيس فِعلاً هيّناً

344
00:20:38,160 --> 00:20:41,850
،حالَما يستعدّ المونيتاليان لمُغادرة مُضيفه

345
00:20:41,850 --> 00:20:45,060
فُرصة إعادته باستجابة تقمّصٍ قويّةٍ

346
00:20:45,060 --> 00:20:47,420
.%لا تتجاوز الـ0.02

347
00:20:47,420 --> 00:20:50,100
إستجابة تقمّصٍ قويّة؟

348
00:20:50,590 --> 00:20:52,820
ماذا لَو لَم ينجح هذا؟

349
00:20:52,820 --> 00:20:54,030
.لمِتّ، تشوتا

350
00:20:54,030 --> 00:20:55,850
!ما-ماذا بحقّ الله؟

351
00:20:55,850 --> 00:20:58,450
،حتّى لَو كانت فُرَصُنا ضعيفة

352
00:20:58,450 --> 00:21:01,610
.إضطّررنا لفِعل هذا لإنقاذ الجّميع

353
00:21:02,850 --> 00:21:05,740
...إنتظر، ما قلتَه وَقتها هناك

354
00:21:06,090 --> 00:21:08,680
.الإيمان بأحدهم هو تعبيرٌ عن الأمَل

355
00:21:08,680 --> 00:21:11,860
.لذا سأُؤمن بكَ أيضاً

356
00:21:11,860 --> 00:21:16,410
.لأنّني آمل أن أبقى في علاقةٍ تكافليّةٍ معك، و لَيس مع أحدٍ غيرك

357
00:21:17,290 --> 00:21:19,170
هل كنتَ تُشير إلى هذا؟

358
00:21:19,490 --> 00:21:23,960
.آمنتُ بأنّكَ ستُعيد الإتّصال بي بالتّأكيد

359
00:21:23,960 --> 00:21:26,270
.أنتَ آمنتَ بي أيضاً

360
00:21:26,270 --> 00:21:29,430
.و ذلك التّقمّص أعاد اتّصالنا ببعضنا

361
00:21:32,660 --> 00:21:36,660
.عُدتّما لتُصبِحا الثّنائيّ الضّعيف؟ كم هذا مُلائم

362
00:21:37,650 --> 00:21:38,640
.كلّا

363
00:21:38,640 --> 00:21:40,430
.لَن أكون بهذه الثّقة لَو كنتُ مكانك

364
00:21:41,090 --> 00:21:43,920
.يُمكنني أن أشعر بهذا. نحن مُختلِفان الآن

365
00:21:43,920 --> 00:21:45,280
صحيح، دولو؟

366
00:21:45,280 --> 00:21:47,280
.نعم، تشوتا

367
00:23:25,910 --> 00:23:29,320
.ها هو طبق كعكات الأرزّ في الحساء الذي كنتَ بانتظار تجربته، أيّها الرّئيس

368
00:23:29,320 --> 00:23:30,370
.يُدعى، زوني

369
00:23:30,370 --> 00:23:34,330
.لكن في الطّبق الذي أحببتُه، كان الحساء أدكن و أكثر حلاوة

370
00:23:34,330 --> 00:23:36,130
،في الحلقة القادمة من إلدلايف

371
00:23:36,140 --> 00:23:37,980
".شيءٌ للإيمان به: الجّزء 3"

372
00:23:37,970 --> 00:23:40,020
.ذلك حساء الفاصولياء الحمراء