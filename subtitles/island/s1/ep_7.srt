1
00:00:16,280 --> 00:00:18,580
سيتسونا يراقبني

2
00:00:22,780 --> 00:00:24,790
ما زلتُ نعسانة

3
00:02:42,800 --> 00:02:47,490
نعم، نمنا بينما نتكلّم على الشاطئ

4
00:02:48,020 --> 00:02:50,060
!لا، لم نفعل

5
00:02:52,900 --> 00:02:54,740
نعم، يؤسفني قول ذلك

6
00:02:55,610 --> 00:02:57,360
!الأمر ليس كذلك

7
00:02:59,070 --> 00:03:01,880
أي أمّ تسأل هذه الأسئلة؟

8
00:03:04,080 --> 00:03:05,740
لا أعلم أيضاً

9
00:03:06,210 --> 00:03:11,190
لكن أشعر أنّ هذا ليس الوقت المناسب

10
00:03:11,190 --> 00:03:14,750
عليّ أن أكون لطيفاً معها

11
00:03:16,360 --> 00:03:17,310
شكراً لك

12
00:03:21,370 --> 00:03:25,350
رأيتهما منذ فترة وكانا حميمين جداً معاً

13
00:03:26,500 --> 00:03:27,850
هكذا إذاً

14
00:03:28,100 --> 00:03:30,040
هذا مُقلِق

15
00:03:30,040 --> 00:03:32,850
ممّا أنتِ قلقة؟

16
00:03:33,110 --> 00:03:34,730
!لا تتكلّمي وفمكِ ممتلئ

17
00:03:37,220 --> 00:03:38,630
خذي، اشربي الشاي

18
00:03:42,420 --> 00:03:45,070
ممّا أنتِ قلقة؟

19
00:03:45,480 --> 00:03:50,770
حتّى لو كان يستمتع الآن، قد لا تكون
هذه ذاته الحقيقيّة

20
00:03:51,680 --> 00:03:54,960
إذاً عندما يستعيد ذاكرته، السّعادة التي
يشعر بها ستزول؟

21
00:03:58,540 --> 00:04:00,890
كمنزل بُنيَ على رمل

22
00:04:09,620 --> 00:04:10,210
خذي

23
00:04:13,650 --> 00:04:14,300
خذ

24
00:04:21,710 --> 00:04:23,260
هل ستأكل هذه؟

25
00:04:23,260 --> 00:04:24,240
ماذا؟

26
00:04:25,760 --> 00:04:28,920
!كنتُ أدّخرها

27
00:04:30,450 --> 00:04:32,120
سنقسمها إذاً

28
00:04:32,760 --> 00:04:33,790
نقسمها؟

29
00:04:34,080 --> 00:04:35,580
نعم

30
00:04:36,240 --> 00:04:38,630
لا، يمكنكِ أكلها

31
00:04:38,630 --> 00:04:40,220
لستُ مُلِحّاً عليها

32
00:04:40,220 --> 00:04:41,530
ضعيف

33
00:04:41,530 --> 00:04:44,930
!هذا يُدغدغ

34
00:04:49,400 --> 00:04:52,820
أريد الاستمرار في المضيّ للأمام

35
00:04:53,930 --> 00:04:58,990
ألّا أنظر سوى للأمام وأستمرّ في التقدّم

36
00:04:58,990 --> 00:05:00,920
ألا تريد ذلك يا سيتسونا؟

37
00:05:00,920 --> 00:05:02,320
ليس تماماً

38
00:05:02,720 --> 00:05:04,690
هل أنا طفوليّة جداً؟

39
00:05:07,990 --> 00:05:11,410
لستُ طفلة

40
00:05:11,810 --> 00:05:12,880
أعلم ذلك

41
00:05:13,480 --> 00:05:17,370
لكن أريد أن أكون لطيفاً معكِ

42
00:05:22,460 --> 00:05:24,860
هذا ما يقوله الشخص الضعيف فحسب

43
00:05:24,860 --> 00:05:26,470
ماذا قلتِ؟

44
00:05:28,300 --> 00:05:29,670
ماذا يعني هذا؟

45
00:05:30,290 --> 00:05:33,790
!ها هو ذا، قرن استشعار الشيطان

46
00:05:33,790 --> 00:05:36,440
عاصفة أخرى قادمة

47
00:05:36,720 --> 00:05:37,950
عمّاذا تتكلّم؟

48
00:05:37,950 --> 00:05:40,750
عندما يقف شعر مي، فهذا يعني أنّ
عاصفة ما قادمة

49
00:05:40,750 --> 00:05:44,300
يبدو لي الجوّ رطباً جداً

50
00:05:45,360 --> 00:05:47,510
إنها عاصفة من نوع مُختلِف

51
00:05:52,700 --> 00:05:54,460
!لا، توقّف

52
00:05:57,180 --> 00:05:59,330
حسناً، انزلي

53
00:06:00,480 --> 00:06:01,500
!توقّف

54
00:06:02,800 --> 00:06:05,960
ماذا تظنّين نفسكِ فاعلة؟

55
00:06:05,960 --> 00:06:08,830
!لماذا تتداعبان في منتصف النّهار؟

56
00:06:08,830 --> 00:06:10,300
!هذا ليس من شأنكِ

57
00:06:11,240 --> 00:06:13,140
!إن استمررت في العبث، ستهبّ عاصفة

58
00:06:13,340 --> 00:06:14,440
عاصفة؟

59
00:06:14,440 --> 00:06:16,070
!لا تؤخذ على حين غرة

60
00:06:19,190 --> 00:06:22,200
لا يمكن أن تهبّ عاصفةٌ في هذا الطقس الجميل

61
00:06:22,200 --> 00:06:23,720
أشكّ في ذلك

62
00:06:24,790 --> 00:06:27,750
أتذكّر هذه الرّائحة في الرّياح

63
00:06:27,750 --> 00:06:29,990
إنها نديّة جداً

64
00:06:31,150 --> 00:06:32,100
...لذا

65
00:06:33,730 --> 00:06:35,460
لنذهب ونأكل بعضاً من الثلج المقشور

66
00:06:36,790 --> 00:06:38,660
ماذا؟ ستُغلقين من الآن؟

67
00:06:38,660 --> 00:06:41,650
أنا آسفة. لقد نفد الدّواء لديّ

68
00:06:41,650 --> 00:06:42,670
دواء؟

69
00:06:45,260 --> 00:06:48,250
سأذهب وأحضر لكِ منه

70
00:06:48,850 --> 00:06:50,080
ستفعل؟

71
00:06:50,080 --> 00:06:50,840
أجل

72
00:06:51,060 --> 00:06:54,040
ما دمتِ ستعدّين ثلجاً مقشوراً لها
في هذه الأثناء

73
00:07:00,170 --> 00:07:02,190
مضى وقت طويل

74
00:07:02,190 --> 00:07:03,370
وقت طويل؟

75
00:07:03,370 --> 00:07:05,230
منذ مجيئكما إلى هنا معاً آخر مرّة

76
00:07:05,640 --> 00:07:08,680
وهذه هي المرّة الأولى التي تكونان فيها
هنا أثناء النهار

77
00:07:09,190 --> 00:07:12,880
كنتما صديقين جيّدين معاً آنذاك أيضاً

78
00:07:12,880 --> 00:07:14,240
آنذاك؟

79
00:07:14,240 --> 00:07:16,990
،كان سيتسونا-تشان يقول دوماً

80
00:07:16,990 --> 00:07:20,450
"كلي ما تشائين. لا أمانع"

81
00:07:21,550 --> 00:07:23,380
لا أمانع"؟"

82
00:07:23,380 --> 00:07:33,380
...هذا صحيح... كان سيتسونا

83
00:07:37,800 --> 00:07:39,140
نعم، من فضلك

84
00:07:39,400 --> 00:07:41,540
للسيّدة التي في محلِّ الحلويّات، صحيح؟

85
00:07:41,540 --> 00:07:44,070
سيستغرق ذلك وقتاً، لكن كن صبوراً من فضلك

86
00:07:44,070 --> 00:07:45,740
طاب يومك

87
00:07:45,740 --> 00:07:46,650
مرحباً

88
00:07:46,650 --> 00:07:49,260
أنت مندفع نحو الأمور حقّاً

89
00:07:49,260 --> 00:07:50,940
أهذا إطراء؟

90
00:07:50,940 --> 00:07:52,490
بالطبع

91
00:07:53,560 --> 00:07:55,820
الأمر ليس جيّداً كما تعتقد أنت

92
00:07:55,820 --> 00:07:58,120
حالما أفكّر في فعل شيء، لا أستطيع
حتّى إيقاف نفسي

93
00:07:58,610 --> 00:08:02,500
لكن لم أتمكّن من إطلاق سراحها

94
00:08:02,500 --> 00:08:03,750
تقصد كارين؟

95
00:08:05,120 --> 00:08:06,670
كانت تلك مجرّد صدفة

96
00:08:08,990 --> 00:08:11,480
لقد أصبحت ابتسامة سارة-تشان أكثر بريقاً أيضاً

97
00:08:11,480 --> 00:08:13,840
لكن ما زالَتْ تفتعل المشاكل من العدم

98
00:08:14,370 --> 00:08:15,970
وبهذا تبقى رينّي-تشان فقط

99
00:08:15,970 --> 00:08:17,960
سيستغرق ذلك وقتاً

100
00:08:17,960 --> 00:08:20,880
لقد تخطّت مُشكلة الاعتقاد بأنّها مُصابة
،بمُتلازمة لفحة السُّخام

101
00:08:20,880 --> 00:08:23,350
لكن ما زال جسدها خائفاً من أشعّة الشمس

102
00:08:24,760 --> 00:08:26,310
لم أكن أعلم ذلك

103
00:08:26,500 --> 00:08:29,520
ماذا؟ إذاً عمّاذا كنتَ تتكلّم؟

104
00:08:29,520 --> 00:08:32,000
السّنوات الخمس ونصف التي لا تستطيع تذكّرها

105
00:08:32,000 --> 00:08:34,010
السّنوات الخمس ونصف التي لا تستطيع تذكّرها"؟"

106
00:08:37,790 --> 00:08:41,920
تنشر هذه الصّحيفة تقاريرَ عن الجزُر المُحيطة
هنا حوالي ثلاث مرّات في الشهر

107
00:08:41,920 --> 00:08:42,870
ها هي ذي

108
00:08:43,880 --> 00:08:44,840
ما هذا؟

109
00:08:45,970 --> 00:08:46,990
إنّها في الثالثة والعشرين؟

110
00:08:46,990 --> 00:08:48,210
لا تبدو كذلك، صحيح؟

111
00:08:48,210 --> 00:08:50,860
،لكن قبل خمس سنوات، عندما كانت في السّابعة عشر

112
00:08:50,860 --> 00:08:54,850
اختفَتْ في البحرِ ولم يُعثَر عليها
سوى في الشّهر الفائت

113
00:08:54,850 --> 00:08:56,580
إنها في الثّالثة والعشرين من عمرها

114
00:08:57,530 --> 00:08:58,720
هذا مستحيل

115
00:08:59,180 --> 00:09:02,180
تبدو تماماً كما هي قبل أن تُفقَد

116
00:09:02,810 --> 00:09:06,000
انتشرت إشاعات بأنّها كانت أخت صغرى

117
00:09:06,000 --> 00:09:08,170
كانت قد أخبأتها عائلة أوهارا

118
00:09:08,170 --> 00:09:11,320
إذاً هل هي رينّي حقّاً؟

119
00:09:11,890 --> 00:09:16,020
استخلصَ تحقيقٌ جرى إلى أنّها هي
بشكل شبه مُؤكَّد

120
00:09:16,020 --> 00:09:18,070
لكن ما زال السّؤال الأهم بلا إجابة

121
00:09:19,490 --> 00:09:20,330
أي سؤال؟

122
00:09:20,560 --> 00:09:25,070
كانت ترتدي نفس الملابس التي كانت
ترتديها عندما فُقِدت

123
00:09:25,070 --> 00:09:27,140
وبدت الملابس وكأنّها قد استُعملت
،لبضعة أيّام فقط

124
00:09:27,140 --> 00:09:30,130
وحتماً ليس لخمس سنوات

125
00:09:30,580 --> 00:09:33,020
ينبغي أن يكون ذلك مستحيلاً

126
00:09:33,020 --> 00:09:33,920
...هل هذا يعني أنها

127
00:09:34,590 --> 00:09:35,830
سافرت عبر الزمن؟

128
00:09:38,220 --> 00:09:39,930
...إذاً هذا يعني أنني

129
00:09:40,350 --> 00:09:42,560
!أنني فعلاً سافرت عبر الزمن

130
00:09:46,960 --> 00:09:49,040
!ما الذي يجري؟

131
00:09:49,040 --> 00:09:51,460
!هل كنتُ أقترب أم أبتعد؟

132
00:09:51,460 --> 00:09:54,940
ما... ما أنا بالنسبة إليها؟

133
00:09:54,940 --> 00:09:57,030
لقد أتت من الماضي

134
00:09:57,030 --> 00:09:59,990
لكن ذكرياتي القليلة هي العكس

135
00:09:59,990 --> 00:10:02,160
أتيتُ من المستقبل لتغيير الماضي

136
00:10:02,160 --> 00:10:04,450
لكن كنتُ أعرف اسمها

137
00:10:04,450 --> 00:10:07,250
وهي كانت تعرف اسمي

138
00:10:07,700 --> 00:10:11,100
!ما الذي يجري بالضبط؟

139
00:10:14,000 --> 00:10:14,850
!رينّي

140
00:10:15,590 --> 00:10:17,050
سيتسونا-تشان

141
00:10:17,050 --> 00:10:18,100
شكراً لك

142
00:10:18,100 --> 00:10:19,380
أين رينّي؟

143
00:10:19,380 --> 00:10:20,900
ألم ترها؟

144
00:10:20,900 --> 00:10:23,180
غادرت للتو

145
00:10:23,180 --> 00:10:24,050
غادرت؟

146
00:10:24,050 --> 00:10:25,680
شَحُبَ وجهها فجأة

147
00:10:25,680 --> 00:10:26,260
ماذا؟

148
00:10:26,260 --> 00:10:28,390
بعد أن تحدّثنا عنك مباشرة

149
00:10:28,390 --> 00:10:29,470
عنّي؟

150
00:10:29,470 --> 00:10:33,900
أجل، عن كيف كنتَ تأتي إلى هنا منذ سنوات

151
00:10:34,880 --> 00:10:36,490
!ذاك لست أنا

152
00:10:49,240 --> 00:10:50,160
...رينّي

153
00:10:56,040 --> 00:10:58,560
ما هذا؟

154
00:10:58,560 --> 00:11:02,890
أهذه ذكرى أم هاجس؟

155
00:11:05,360 --> 00:11:06,520
!رينّي

156
00:11:22,480 --> 00:11:25,780
رينّي، لا تذهبي إلى أي مكان

157
00:11:33,680 --> 00:11:34,710
...رينّي

158
00:11:34,960 --> 00:11:36,040
!رينّي

159
00:11:37,000 --> 00:11:37,800
!انتظري

160
00:11:42,400 --> 00:11:43,320
رينّي

161
00:11:47,470 --> 00:11:48,640
لم أستطع الوصول إلى هناك

162
00:11:50,160 --> 00:11:54,500
أردتُ العودة إلى سيتسونا الحقيقي

163
00:11:56,220 --> 00:11:58,620
هل تذكّرتِ شيئاً؟

164
00:12:07,760 --> 00:12:12,020
...أنا وسيتسونا سقطنا في البحر ومن ثمّ

165
00:12:13,730 --> 00:12:17,720
،عندما استيقظت، كنّا في بوريوجيما

166
00:12:18,430 --> 00:12:21,920
الجزيرة المهجورة الغامضة التي لا تظهر إلّا عقب عاصفة

167
00:12:24,000 --> 00:12:26,240
رينّي. رينّي

168
00:12:27,900 --> 00:12:29,100
سيتسونا؟

169
00:12:29,860 --> 00:12:30,810
هذا مُطمئن

170
00:12:37,010 --> 00:12:38,990
!سيتسونا! رأسك

171
00:12:38,990 --> 00:12:40,480
أنا بخير

172
00:12:40,480 --> 00:12:41,610
...لكن

173
00:12:41,900 --> 00:12:43,710
أحتاج لقسط من الرّاحة فقط

174
00:13:43,710 --> 00:13:44,980
هذا شهيّ

175
00:13:44,980 --> 00:13:45,670
نعم

176
00:13:46,900 --> 00:13:49,090
لنعِش هنا

177
00:13:49,090 --> 00:13:50,680
هذا غير مُمكن

178
00:13:50,680 --> 00:13:53,350
!لا عليك. سأعمل بجدّ

179
00:14:27,160 --> 00:14:29,070
!رينّي. رينّي

180
00:14:32,210 --> 00:14:36,140
سيتسونا، اصطدتُ قليلاً من السمك

181
00:14:39,490 --> 00:14:40,740
...سيتسونا

182
00:14:42,600 --> 00:14:45,180
سيتسونا

183
00:14:49,720 --> 00:14:50,910
!سيتسونا

184
00:14:51,870 --> 00:14:53,960
سيتسونا، عليك أن ترتاح

185
00:14:53,960 --> 00:14:56,260
...نحتاج لقارب. قارب

186
00:14:56,840 --> 00:14:58,660
عليّ أن آخذك للديار

187
00:15:01,440 --> 00:15:04,230
سيتسونا؟

188
00:15:06,480 --> 00:15:07,420
سيتسونا

189
00:15:09,200 --> 00:15:11,840
!سيتسونا

190
00:15:13,630 --> 00:15:14,630
!سيتسونا

191
00:15:18,480 --> 00:15:19,730
...سيتسونا

192
00:15:19,730 --> 00:15:22,400
تذكّرت. ذاك قارب

193
00:15:22,400 --> 00:15:23,250
ماذا؟

194
00:15:23,250 --> 00:15:25,640
لا، لا يمكن أن يكون هذا صحيحاً

195
00:15:25,640 --> 00:15:26,820
عمّاذا تتكلّم؟

196
00:15:27,180 --> 00:15:29,070
ما الأمر يا سيتسونا؟

197
00:15:36,650 --> 00:15:37,690
ماذا؟

198
00:15:38,270 --> 00:15:40,080
أعددتُ بعضاً من الحساء

199
00:15:44,590 --> 00:15:45,710
إنه شهيّ

200
00:15:48,350 --> 00:15:50,340
وجدتُ قارباً

201
00:15:50,340 --> 00:15:51,360
ماذا؟

202
00:15:51,360 --> 00:15:53,390
لكنّ لا يتّسع سوى لواحد منّا

203
00:15:53,390 --> 00:15:57,310
أريدكِ أن تذهبي. لا أمانع من ناحيتي

204
00:16:01,200 --> 00:16:02,420
لا أمانع

205
00:16:08,050 --> 00:16:10,910
لا أعلم ماذا حدث بعد ذلك

206
00:16:10,910 --> 00:16:13,370
،عندما استفقت، وجدتُ نفسي قد عدتُ إلى أوراشيما

207
00:16:13,370 --> 00:16:15,360
وخمس سنوات كانت قد مضت

208
00:16:15,360 --> 00:16:17,360
...إذاً سيتسونا الحقيقيّ

209
00:16:18,920 --> 00:16:20,000
...تقصدين

210
00:16:20,000 --> 00:16:24,080
!أجل، تركتُه يموت

211
00:16:28,120 --> 00:16:30,810
أنا آسفة! علينا أن نودّع بعضنا

212
00:16:31,390 --> 00:16:32,740
ما كلّ هذا فجأة؟

213
00:16:33,640 --> 00:16:37,850
لا أستطيع مُسامحة نفسي على
ترك سيتسونا يموت

214
00:16:37,850 --> 00:16:42,490
لذا حتّى لو كنّا معاً، لن أكون سعيدة

215
00:16:42,490 --> 00:16:44,630
أهذا ما تريدينه حقّاً؟

216
00:16:47,400 --> 00:16:50,200
لا أستطيع الهرب من ماضيّي أيضاً

217
00:16:51,100 --> 00:16:53,680
أتيتُ من المستقبل. عليّ أن أقتل شخصاً

218
00:16:53,680 --> 00:16:55,980
وعليّ أن أنقذ فتاة

219
00:16:55,980 --> 00:16:58,860
،لقد حاولتُ التصرّف بناء على تلك الذكريات فقط

220
00:16:58,860 --> 00:17:00,870
!لكن لا أعرف ما هو الصّواب

221
00:17:00,870 --> 00:17:02,170
من المُستحيل أن تعرف

222
00:17:02,880 --> 00:17:07,020
لعلّ ماضيّي لا يريدني أن أشعر بهذه السّعادة

223
00:17:10,890 --> 00:17:12,130
هذا مُخيف، صحيح؟

224
00:17:13,280 --> 00:17:13,890
نعم

225
00:17:14,950 --> 00:17:15,910
...إذاً
...لكن

226
00:17:19,770 --> 00:17:23,180
لا يصحّ أن نعيش خائفين من ذلك

227
00:17:23,420 --> 00:17:28,320
ألا تعتقدين أنّ علينا مواجهة ماضينا
والاستمرار في التقدّم للأمام؟

228
00:17:39,960 --> 00:17:41,840
كيف لك أن تقول ذلك؟

229
00:17:42,820 --> 00:17:45,430
!ما الفائدة من مواجهته؟

230
00:17:46,970 --> 00:17:50,090
!لا يسعني فعل شيء لتغييره

231
00:17:50,340 --> 00:17:54,030
!دعني وشأني! أنت مطرود

232
00:17:54,030 --> 00:17:55,970
!دعني وشأني فحسب

233
00:17:57,590 --> 00:17:59,310
!سمكة الشّمس حادّة الذيل

234
00:18:00,220 --> 00:18:03,430
أعطاني إيّاها صيّاد سمك

235
00:18:03,670 --> 00:18:05,170
!لم يسألكِ أحد

236
00:18:05,170 --> 00:18:07,250
إذاً أنا سأسأل

237
00:18:07,250 --> 00:18:09,840
لماذا أنتما هنا تتبلّلان معاً؟

238
00:18:09,840 --> 00:18:11,910
!لا تسألي بطريقة إيحائيّة

239
00:18:14,520 --> 00:18:15,500
!رينّي؟

240
00:18:26,120 --> 00:18:27,930
لا بدّ وأنها كانت مُنهَكة

241
00:18:29,970 --> 00:18:35,550
سيتسونا-سان، قلت أنّك تتذكّر رؤيتي
بصدر كبير، صحيح؟

242
00:18:35,550 --> 00:18:37,260
لمَ الحديث عن ذلك؟

243
00:18:37,260 --> 00:18:41,480
وقد شاهدتَ ذكريات أخرى كذلك

244
00:18:41,480 --> 00:18:42,310
أجل

245
00:18:43,020 --> 00:18:45,170
،لستُ أدري فيما إذا كانت أوهام أو حقيقة

246
00:18:45,170 --> 00:18:48,880
سواء أرأيتها حقّاً أم لا

247
00:18:48,880 --> 00:18:51,410
،هناك طرُق كثيرة في الحياة

248
00:18:51,410 --> 00:18:54,020
وأحياناً يجب أن نثق بخياراتنا

249
00:18:54,240 --> 00:18:56,810
إذا سلكنا حتّى ميلّيمتراً واحداً من
،طريق مختلف

250
00:18:56,810 --> 00:18:58,530
فإنّ تاريخاً مختلفاً ينتظرنا

251
00:18:59,560 --> 00:19:04,160
ماذا لو اخترتَ الخيار مراراً وتكراراً لتصل
للمستقبل الذي ترغبه؟

252
00:19:04,160 --> 00:19:09,910
الشّعور بتكرار المشهد ناجم عن ذكريات
عودتي إلى الماضي مراراً وتكراراً؟

253
00:19:10,170 --> 00:19:13,910
،أجل. وكتأثير جانبي

254
00:19:13,910 --> 00:19:17,880
تقاطعت المعلومات

255
00:19:18,360 --> 00:19:19,920
ماذا تقصدين؟

256
00:19:20,520 --> 00:19:26,430
شيء ما يُسبّب وقوع شذوذ بين هذه
الجزيرة وبوريوجيما

257
00:19:26,430 --> 00:19:30,940
أعتقد أنّ ذلك هو المفتاح الذي يسمح بالتنقّل
بين الماضي والحاضر

258
00:19:31,730 --> 00:19:33,020
شذوذ؟

259
00:19:33,290 --> 00:19:39,070
هبّت عاصفة مصطحبة معها لغزاً
مع تلك الجزيرة

260
00:19:39,070 --> 00:19:40,300
!هذه هي

261
00:19:41,630 --> 00:19:43,430
،عندما تهبّ عاصفة

262
00:19:43,430 --> 00:19:48,040
فإنّها تشكّل صلة وصل بين الحاضر والماضي
قبل خمس سنوات عبر زمكان

263
00:19:48,440 --> 00:19:53,710
لا بدّ وأن رينّي-سان قد مرّت عبر ذلك
الثقب الدودي للوصول إلى الحاضر

264
00:19:53,710 --> 00:19:56,250
لهذا لم تكبر

265
00:19:57,450 --> 00:19:59,590
!هذا مستحيل

266
00:19:59,790 --> 00:20:03,890
كانت ترتدي نفس الملابس التي كانت
ترتديها عندما فُقِدت

267
00:20:04,950 --> 00:20:06,420
أهذا معقول؟

268
00:20:07,420 --> 00:20:08,620
سيتسونا-سان

269
00:20:10,300 --> 00:20:15,190
إن كنت تتنقّل بين الماضي والحاضر
،لِلّحاق برينّي-سان

270
00:20:16,320 --> 00:20:19,600
فقد تكون هذه فرصتك لتفهم كلّ شيء

271
00:20:22,020 --> 00:20:23,950
عاصفة أخرى قادمة

272
00:20:29,550 --> 00:20:30,450
رينّي؟

273
00:20:33,800 --> 00:20:34,760
أهذا صحيح؟

274
00:20:34,760 --> 00:20:36,080
هل كان ما قلتِه صحيحاً؟

275
00:20:36,080 --> 00:20:37,670
أنتِ تؤلمينني

276
00:20:37,670 --> 00:20:38,720
!أجيبيني

277
00:20:38,720 --> 00:20:39,920
هل هو صحيح؟

278
00:20:39,920 --> 00:20:43,340
إ-إنها مجرّد فرضيّة لي

279
00:20:43,640 --> 00:20:44,720
!مـ-مهلاً

280
00:20:47,480 --> 00:20:49,050
يمكنني رؤية سيتسونا

281
00:20:49,720 --> 00:20:51,640
يمكنني العودة إلى ذلك اليوم

282
00:20:51,940 --> 00:20:54,020
—لسنا متأكّدين من ذلك

283
00:20:54,710 --> 00:20:55,650
رينّي؟

284
00:21:12,160 --> 00:21:13,480
رينّي، أين أنتِ؟

285
00:21:13,480 --> 00:21:14,910
!سيتسونا-سان

286
00:21:14,910 --> 00:21:16,310
!من هنا

287
00:21:36,450 --> 00:21:38,040
!تبّاً

288
00:21:38,040 --> 00:21:39,130
!سيتسونا-سان

289
00:21:40,060 --> 00:21:41,980
!هناك قارب مفقود

290
00:23:36,430 --> 00:23:38,730
"أحببني عندما نلتقي ثانية"