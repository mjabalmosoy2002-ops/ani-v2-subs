1
00:00:10,740 --> 00:00:13,410
.لقد اقترب وقت دوريّات الشّرطة يا ترونكو

2
00:00:13,410 --> 00:00:16,370
أَلا يمكننا أن نرشوهم قليلًا وحسب؟

3
00:00:16,370 --> 00:00:19,120
.السيّد سكوزا لا يرضى بالقليل

4
00:00:19,120 --> 00:00:20,450
سكوزا؟

5
00:00:20,450 --> 00:00:22,790
.إنّه مُدير مكتب الحظر الفدرالي الجديد

6
00:00:23,080 --> 00:00:25,920
.سمعتُ أنّه أخذ ثروةً صغيرة من عائلة أوركو

7
00:00:32,840 --> 00:00:35,430
ويحك، أَهكذا تقود؟

8
00:00:35,430 --> 00:00:38,220
.حسبتكَ كنتَ تقود سيّارة أجرة حتّى الآن

9
00:00:38,220 --> 00:00:41,140
.إنّ كلّ ما نحمله من كحول بالخلف يُخلّ بتوازننا

10
00:00:42,100 --> 00:00:44,810
.لكنّه يُكسبك مالًا وفيرًا أيضًا

11
00:00:44,810 --> 00:00:48,110
.سوف أشتري سيّارةً ما إن أدّخر ما يكفي من المال أيّها السيّد ڤانو

12
00:00:48,110 --> 00:00:49,270
.من طراز فانتوم

13
00:00:49,270 --> 00:00:50,230
.أكيد

14
00:00:50,230 --> 00:00:53,610
.سأُهديك واحدة بعد مئة عمليّة توصيلٍ للكحول

15
00:00:53,610 --> 00:00:56,160
!أَحقًّا هذا؟ سوف أُلزمك بهذا الوعد

16
00:00:57,160 --> 00:00:59,370
.هذا على افتراض أنّ كلانا سنظلّ أحياءً

17
00:01:02,830 --> 00:01:04,620
!ها هُم ذي. أسرع

18
00:01:25,850 --> 00:01:26,900
!اختبئ

19
00:01:55,010 --> 00:01:56,260
.لقد ذهبوا

20
00:01:57,470 --> 00:01:58,760
.ترونكو

21
00:01:58,970 --> 00:02:00,260
.نحن في مأمنٍ الآن

22
00:02:01,180 --> 00:02:02,100
أينك؟

23
00:02:09,150 --> 00:02:10,440
.هيّا لنرجع

24
00:02:55,530 --> 00:02:57,530
.ما زال هنالك واحد

25
00:02:58,400 --> 00:02:59,740
.تخلّصوا منه

26
00:05:20,590 --> 00:05:23,340
.يتوجّب علينا دخول حربٍ ضدّ آل أوركو

27
00:05:26,220 --> 00:05:28,890
إذن فقد تشبّثتَ بالجانب السّفلي للسيّارة كي تهرب؟

28
00:05:28,890 --> 00:05:30,640
.لم أعهدك قادرًا على التّفكير بهذا الذّكاء

29
00:05:31,680 --> 00:05:32,520
.مرحبًا

30
00:05:32,850 --> 00:05:35,060
.أهلًا، لقد تأخّرتما

31
00:05:40,230 --> 00:05:41,980
.هذا سيُعجب والدي

32
00:05:44,320 --> 00:05:45,900
.كلّا، هذا هديّة

33
00:05:45,900 --> 00:05:46,990
.اشربوه

34
00:05:47,950 --> 00:05:51,200
.رغم أنّي أُدرك أنّه لا يُساوي شيئًا مقارنةً بتلك

35
00:05:51,540 --> 00:05:52,910
فانتوم؟

36
00:05:52,910 --> 00:05:54,500
.إنّها من آل غالاسيا

37
00:05:54,500 --> 00:05:55,500
آل غالاسيا؟

38
00:05:58,000 --> 00:06:00,000
!ما عساي أقول، إنّه لشرابٌ لذيذ

39
00:06:01,960 --> 00:06:04,510
،العريس هو ابن أخ الدون غالاسيا

40
00:06:04,510 --> 00:06:06,300
.الرّجل المُسيطر على شيكاغو

41
00:06:07,470 --> 00:06:09,890
.إنّ آل ڤانيتي يحكمون هذه البلدة

42
00:06:10,300 --> 00:06:12,600
.نحن لسنا بحاجة لعون آل غالاسيا

43
00:06:12,600 --> 00:06:16,940
هذا طريف، فقد سمعتُ أنّ عائلة أوركو
.قد استولت على بعضٍ من أراضيكم بوسط البلدة

44
00:06:17,230 --> 00:06:18,770
!حريٌّ بك أن تزنَ كلامك

45
00:06:20,190 --> 00:06:20,940
.نيرو

46
00:06:23,070 --> 00:06:24,730
.إنّ والدك يُناديك

47
00:06:24,730 --> 00:06:25,780
.حسنًا

48
00:06:26,440 --> 00:06:27,610
.باربيرو

49
00:06:27,780 --> 00:06:29,160
.إنّه العقل المدبّر لعمليّاتي

50
00:06:29,490 --> 00:06:31,700
.هذان أڤيليو وكورتيو

51
00:06:32,240 --> 00:06:34,830
.تشرّفتُ بلقائكما
.لقد سمعتُ بشأن كلّ ما يتعلّق بكما

52
00:06:35,500 --> 00:06:37,660
.حسنٌ، استمتعا بوقتكما

53
00:06:41,500 --> 00:06:43,090
ما الذي تفكّر فيه؟

54
00:06:43,090 --> 00:06:45,760
!لقد أتينا إلى هنا لأنّنا بحاجةٍ للمال

55
00:06:51,140 --> 00:06:53,850
.يتوجّب علينا مغادرة المكان

56
00:06:53,850 --> 00:06:56,810
.إنّها حفلة
.لنستمتع بوقتنا

57
00:07:00,850 --> 00:07:02,810
كيف يجري بناء المسرح؟

58
00:07:03,320 --> 00:07:04,690
.كلّ شيءٍ يجري بسلاسة

59
00:07:04,690 --> 00:07:06,900
.يجدر به أن يجهز عند نهاية حزيران

60
00:07:06,900 --> 00:07:11,410
.أخي، لقد قرّر الدون غالاسيا أن يحضر الافتتاح العظيم

61
00:07:12,820 --> 00:07:14,530
.أمامنا ثلاثة أشهر

62
00:07:14,700 --> 00:07:17,870
...عندها فآل ڤانيتي، أوركو وغالاسيا

63
00:07:18,290 --> 00:07:21,170
.كلّ العائلات الثّلاث ستجتمع تحت سقفٍ واحد

64
00:07:21,920 --> 00:07:23,340
وإن يكُن؟

65
00:07:23,880 --> 00:07:26,670
،أعلم أنّ آل أوركو صاروا يتعدّون حدودهم بالآونة الأخيرة

66
00:07:26,670 --> 00:07:30,800
.لكنّهم مضطرّون لإطاعة آل غالاسيا أيضًا

67
00:07:30,800 --> 00:07:32,590
.نفس الأمر ينطبق علينا

68
00:07:38,310 --> 00:07:40,520
،أنا لن أصمد لوقتٍ طويل

69
00:07:40,520 --> 00:07:45,270
.لكنّي أعتزم ترك العائلة على أساسٍ متين

70
00:07:45,610 --> 00:07:48,860
.لهذا السّبب أختي ستتزوّج ابن أخ غالاسيا

71
00:07:49,150 --> 00:07:51,990
.إنّ رونالدو رجلٌ نزيه
.يمكننا وضع ثقتنا به

72
00:07:51,990 --> 00:07:53,160
...ما من شيءٍ يدعو للقلـ

73
00:07:53,160 --> 00:07:54,570
.لقد قتلوا رجلًا آخر من رجالنا

74
00:07:56,160 --> 00:07:58,330
.هذا لأنّكم سرقتم كحول آل أوركو

75
00:07:58,330 --> 00:08:01,540
.ذاك الطّريق كان ملكًا لنا قبل ثلاثة أشهر

76
00:08:01,920 --> 00:08:05,670
.إنّ عائلة لا تقوى على حماية أراضيها ما لها مِن مستقبل

77
00:08:09,340 --> 00:08:10,760
ما رأيك أن تدخّن سيجارًا؟

78
00:08:12,720 --> 00:08:16,760
.عند تدخين السيجار، أنت لا تستنشق الدخّان

79
00:08:17,100 --> 00:08:18,720
.بل تستنشق الوقت

80
00:08:20,140 --> 00:08:21,690
،فكّر مليًّا

81
00:08:22,020 --> 00:08:24,190
.وبعدها امضِ قدمًا بهمّة

82
00:08:24,560 --> 00:08:29,070
.كلّما سارعتَ خطاك، كلّما زاد احتمال تعثُّرك وسقوطك

83
00:08:32,900 --> 00:08:38,660
البعض يقولون أيضًا: "إنّ اللّه لا يُغيّر
".ما بقومٍ حتّى يغيّروا ما بأنفسهم

84
00:08:52,590 --> 00:08:54,340
.ذاك الحقير

85
00:08:56,300 --> 00:09:00,270
.سوف أوسعه ضربًا إن أبكى فيو

86
00:09:00,470 --> 00:09:02,310
.يتّضح لي أنّك في مزاجٍ سيّئ

87
00:09:09,360 --> 00:09:11,690
.أظنّ أنّ السيّد رونالدو سيقوم بزيارتنا

88
00:09:13,860 --> 00:09:15,030
.تهانيَّ لك

89
00:09:25,170 --> 00:09:28,540
.أنا الآن أحد أفراد عائلتكم بصفةٍ رسميّة

90
00:09:30,250 --> 00:09:31,420
أين هو نيرو؟

91
00:09:31,420 --> 00:09:33,920
.الدون ڤانيتي قد استدعاه

92
00:09:35,510 --> 00:09:39,260
أَسيظلّ حبيس غرفته ولن يأتي حتّى لحضور زفاف ابنته؟

93
00:09:39,760 --> 00:09:42,850
.إنّ الإفراط في الحذر قد يتحوّل إلى جبانة

94
00:09:45,810 --> 00:09:48,150
،نحن متكتّمون على هذه المسألة عن العامّة

95
00:09:48,150 --> 00:09:51,020
.لكنّه يظلّ في البيت اتّباعًا لتوصيات الطّبيب

96
00:09:51,270 --> 00:09:55,200
.حسنٌ، سأسوّي لكم قضيّتكم الصّغيرة مع أوركو

97
00:09:55,860 --> 00:10:00,700
رغم أنّي لا أستوعب المغزى
.من قتالكم على مخلّفات هذه البلدة البائسة

98
00:10:00,950 --> 00:10:04,950
.ما هي إلّا منفذ يعبر منه الكحول القادم من وراء الحدود

99
00:10:06,620 --> 00:10:07,580
.إيّاك

100
00:10:08,420 --> 00:10:09,880
.هذا طريف

101
00:10:13,170 --> 00:10:14,380
ماذا؟

102
00:10:14,760 --> 00:10:18,300
.من الطّريف دومًا رؤية هرٍّ يتظاهر بأنّه نمر

103
00:10:29,850 --> 00:10:31,820
...مَن عساك تحسب نفسك يا

104
00:10:32,570 --> 00:10:33,900
!أوقف هذا على الفور

105
00:10:33,900 --> 00:10:34,980
ما الخطب؟

106
00:10:44,410 --> 00:10:46,250
أَتُراك سوف تنضج يومًا؟

107
00:10:57,800 --> 00:10:59,180
.إنّهما مناسبان لبعضهما

108
00:11:00,970 --> 00:11:02,600
.الممتنعون عن الشّرب معيشتهم قاسية

109
00:11:04,140 --> 00:11:05,010
أَتريد تجربته؟

110
00:11:06,770 --> 00:11:08,690
هذا هو كحولكما الشّهير؟

111
00:11:16,610 --> 00:11:18,530
.إنّه يمتاز بقوّة طعمه

112
00:11:18,530 --> 00:11:19,780
أين تقومان بتحضيره؟

113
00:11:21,360 --> 00:11:23,950
.في المطبخ... بشقّتي

114
00:11:25,700 --> 00:11:27,160
أَليس كذلك؟

115
00:11:27,160 --> 00:11:30,000
!أنا لم أرَ هذه النّظرة على وجهك منذ زمن

116
00:11:30,000 --> 00:11:31,370
هلّا تحدّثنا على انفراد؟

117
00:11:40,090 --> 00:11:42,300
هرٌّ يتظاهر بأنّه نمر إذن؟

118
00:11:43,260 --> 00:11:44,850
.أنت تُجيد حِبك الكلام

119
00:11:46,810 --> 00:11:48,520
.أظن أنّنا لم نتعرّف على بعضنا بعد

120
00:11:48,930 --> 00:11:50,560
.اسمي ڤانو كليمينتي

121
00:11:52,900 --> 00:11:54,480
.أنا أڤيليو برونو

122
00:11:57,360 --> 00:12:00,360
.أظنّ أنّنا سنعمل بانسجامٍ معًا

123
00:12:02,360 --> 00:12:03,990
.تذوّقوا هذا

124
00:12:04,160 --> 00:12:07,910
.هذا طبق التشوبينو الخاصّ بالأستاذ ڤانو على طريقة لوليس

125
00:12:08,870 --> 00:12:10,200
!يبدو لذيذًا

126
00:12:10,500 --> 00:12:11,080
!تمهّل

127
00:12:18,130 --> 00:12:23,800
.أبانا في السّماء، نشكرك على هذه الوجبة التي سنتناولها الآن

128
00:12:24,220 --> 00:12:28,060
.ندعو أن تُغذّي كلًّا من أجسادنا وأرواحنا

129
00:12:36,360 --> 00:12:37,610
!تبًّا

130
00:12:38,150 --> 00:12:39,650
أَما زالت تؤلمك؟

131
00:12:40,570 --> 00:12:42,490
.أجل، لن أستطيع الأكل لمدّة

132
00:12:44,910 --> 00:12:48,830
.بالمناسبة، ذاك المدعوّ أڤيليو مُثيرٌ للاهتمام حقًّا

133
00:12:49,080 --> 00:12:52,960
.والكحول الذي يُحضّره زميله كورتيو ليس سيّئًا على الإطلاق

134
00:12:52,960 --> 00:12:56,710
.بالفعل. أظنّ أنّ هذا سيوفّر علينا مواجهة آل أوركو

135
00:12:56,880 --> 00:12:59,420
أَقمتَ بمناقشة الأمر مع الدون؟

136
00:13:01,130 --> 00:13:03,970
أجبني يا نيرو، سنقوم بالتخلّص من فانغو، أَليس كذلك؟

137
00:13:07,010 --> 00:13:07,890
.كلّا

138
00:13:08,970 --> 00:13:10,260
!ولمَ لا؟

139
00:13:10,260 --> 00:13:15,060
.غالاسيا يُريد منّا أن نُهادن آل أوركو

140
00:13:16,900 --> 00:13:18,230
!لا تعبث معي

141
00:13:18,230 --> 00:13:20,440
أنّى لترونكو أن يرقد بسلامٍ في هذه الحالة؟

142
00:13:20,440 --> 00:13:21,860
!سأُنجز الأمر بنفسي إن اضطررتُ لذلك

143
00:13:22,240 --> 00:13:24,200
أَأنت ثملٌ يا ڤانو؟

144
00:13:24,200 --> 00:13:26,660
...حتّى إن تمكّنتَ من التغلّب على آل أوركو، فإنّ آل غالاسيا

145
00:13:26,660 --> 00:13:30,030
!لا يمكننا الجزم بفوزنا أو خسارتنا ما لم نحاول

146
00:13:30,030 --> 00:13:32,580
.نحن بحاجة للمال
...لو استحوذنا على ذاك الكحول

147
00:13:32,580 --> 00:13:33,790
.حسنٌ، سنقتله

148
00:13:37,040 --> 00:13:38,170
...لكن

149
00:13:38,670 --> 00:13:41,840
.نحن لن نكون من سيسحب الزّناد

150
00:13:44,130 --> 00:13:45,220
.سأفعلها

151
00:13:45,800 --> 00:13:47,220
أَتعني ما تقوله؟

152
00:13:47,220 --> 00:13:49,930
إن قضيتُ على فانغو سيتسنّى لي الانضمام للعائلة، صحيح؟

153
00:13:52,100 --> 00:13:54,390
،أعلم أنّي من قد فتح الموضوع

154
00:13:54,850 --> 00:13:56,940
.لكنّ هذه المهمّة بالغة الخطورة

155
00:13:56,940 --> 00:13:59,190
.لقد قتلوا مؤخّرًا أحد شبّاننا

156
00:13:59,190 --> 00:14:00,480
.اسمحوا لي بالمحاولة

157
00:14:04,940 --> 00:14:06,280
.ليلة الأربعاء

158
00:14:06,280 --> 00:14:08,910
.سوف يُمضي بعض الوقت عند لاكريما

159
00:14:08,910 --> 00:14:09,950
لاكريما؟

160
00:14:10,160 --> 00:14:11,740
.إنّها عشيقة فانغو

161
00:14:12,040 --> 00:14:14,830
.هي تعيش بشقّة مقابلة لمبنى تاريخ لوليس

162
00:14:15,830 --> 00:14:17,210
ما عساي أن أفعل بشأنها؟

163
00:14:19,000 --> 00:14:21,090
.لا يُهم، يمكنك قتلها أيضًا

164
00:14:22,670 --> 00:14:24,340
أَسبق لك أن قتلتَ من قبل؟

165
00:14:25,590 --> 00:14:26,510
.كلّا

166
00:14:26,510 --> 00:14:27,680
.هكذا إذن

167
00:14:27,680 --> 00:14:30,640
.إنّ بدايتك متأخّرة إذن نظرًا لسنّك

168
00:14:30,850 --> 00:14:32,510
...أوّل مرّة قتلتُ فيها كانت

169
00:14:36,060 --> 00:14:37,310
.سأتّصلك بك لاحقًا

170
00:14:47,360 --> 00:14:50,620
!أَفقدتَ عقلك حتّى تختلط بأمثال هؤلاء؟

171
00:14:50,620 --> 00:14:51,530
.صحيح

172
00:14:52,330 --> 00:14:54,490
.العالم بأسره قد جُنّ جنونه

173
00:15:05,460 --> 00:15:07,260
،إنّه يدّعي أنّه أعزّ صديقٍ لوالدي

174
00:15:07,720 --> 00:15:10,010
.وهو يودّ مساعدتي على الانتقام

175
00:15:15,470 --> 00:15:17,270
أَليس هذا عجيبًا؟

176
00:15:17,890 --> 00:15:19,020
،كلّ شيءٍ مُدوّنٌ هناك

177
00:15:19,310 --> 00:15:22,480
.بما في ذلك أسماء أولئك الذين سلبوا منّي أحبّائي

178
00:15:32,240 --> 00:15:35,080
.ستحصل على النّصف الباقي إن جرى كلّ شيءٍ على ما يرام

179
00:15:35,080 --> 00:15:36,330
.لا مشكلة

180
00:15:38,790 --> 00:15:41,580
.لا داعي للقلق
.كلّ شيء سيجري على خير

181
00:16:06,110 --> 00:16:06,980
!أنت

182
00:16:08,400 --> 00:16:11,400
.لكم رائحتك نتنة
كم من زجاجة قد شربت؟

183
00:16:11,780 --> 00:16:14,030
!انهض يا هذا! لا يمكنك النّوم هنا

184
00:16:14,620 --> 00:16:16,660
.إنّ أحد أصدقائي يعيش هنا

185
00:16:17,290 --> 00:16:18,580
أَتظنّني أكترث لذلك؟

186
00:16:20,500 --> 00:16:22,330
!هيّا تحرّك، انصرف من هنا

187
00:16:22,710 --> 00:16:23,960
!أيّها السيّد سيرپينتي

188
00:16:25,460 --> 00:16:26,710
.وجدتك بالوقت المناسب

189
00:16:26,710 --> 00:16:27,670
ماذا هناك؟

190
00:16:27,880 --> 00:16:30,340
.لقد حصلتُ على شرابٍ من الطّراز الرّفيع

191
00:16:31,470 --> 00:16:34,260
.نحن على مرأى الجميع هنا
.لندخل السيّارة

192
00:17:09,380 --> 00:17:12,340
!أجل، هكذا تمامًا. اضربي بقوّة أكثر

193
00:17:15,010 --> 00:17:17,640
!بقوّة أكثر! بقوّة أكثر هيّا

194
00:17:32,070 --> 00:17:35,360
!لا تتوقّفي، واصلي الضّرب

195
00:17:36,490 --> 00:17:38,120
.أيّها الخنزير القذر

196
00:17:38,490 --> 00:17:41,660
!خنزير! خنزير

197
00:17:54,550 --> 00:18:00,140
أَلم تلقّنك أُمّك أنّه عليك قرع الباب أوّلًا قبل الدّخول يا ولد؟

198
00:18:00,140 --> 00:18:02,600
!أرجوك... لا تفعلها

199
00:18:07,100 --> 00:18:09,110
.يُعجبني هذا

200
00:18:09,110 --> 00:18:11,730
.إنّي أرتعش من الحماسة

201
00:18:12,440 --> 00:18:16,780
!هذا صار ممتعًا
أَتريد الانضمام إلينا؟

202
00:18:16,780 --> 00:18:18,820
!هيّا افعلها! أطلق النّار

203
00:18:18,990 --> 00:18:22,410
...لا تُطلق النّار... أرجوك

204
00:18:25,960 --> 00:18:29,170
...هيّا أطلق رصاصةً بسرعة

205
00:18:29,170 --> 00:18:31,590
...بمُسدّسك الكبير ذاك

206
00:19:01,410 --> 00:19:02,620
أنت مجدّدًا؟

207
00:19:07,750 --> 00:19:08,790
أين هو فانغو؟

208
00:19:10,460 --> 00:19:12,000
تمكّن من الفرار إذن؟

209
00:19:12,710 --> 00:19:13,590
.أجل

210
00:19:14,840 --> 00:19:16,010
.آسف

211
00:19:16,760 --> 00:19:18,510
.كنّا نعلم أنّه ليس بالخصم اليسير

212
00:19:18,510 --> 00:19:19,760
.ما باليد حيلة

213
00:19:25,720 --> 00:19:26,970
...إنّه هو

214
00:19:27,980 --> 00:19:32,360
أَلن يثير الأمر المتاعب إن قام أحد آل ڤانيتي بقتل أحد آل أوركو؟

215
00:19:32,650 --> 00:19:34,900
.سنذهب للمقبرة التي بالقرية القديمة

216
00:19:37,360 --> 00:19:39,900
.إنّهم الشّرطة
.سأوافيك لاحقًا

217
00:19:56,340 --> 00:20:00,300
يا ربّاه، إنّي أقرع سنّي ندمًا على إثارة سخطك

218
00:20:00,720 --> 00:20:04,930
،وأنا لمُبغضُ لكلّ الآثام التي جعلتني أستحقّ عقوبتك العادلة

219
00:20:05,930 --> 00:20:10,640
،وبالأخصّ لأنّها قد أثارت سخطك عليّ يا ربّاه

220
00:20:10,980 --> 00:20:13,230
.أنت يا ذا الخير الوسيع الجدير بحبّ الجميع

221
00:20:13,520 --> 00:20:17,360
،لقد قرّرتُ بحزم، وبعون بركاتك عليّ

222
00:20:17,690 --> 00:20:24,240
ألّا أرتكب أيّ إثمٍ بعد الآن وأتجنّب أيّ شيءٍ
.يدعو لارتكابه مع التّكفير عن ذنوبي

223
00:20:25,160 --> 00:20:26,280
.آمين

224
00:20:29,620 --> 00:20:32,040
.إنّ ترونكو يرقد تحت هذا الحجر

225
00:20:32,870 --> 00:20:34,790
.لقد كان شابًّا طيّبًا

226
00:20:34,790 --> 00:20:36,340
.كان يهوى السيّارات

227
00:20:38,460 --> 00:20:39,460
...سحقًا

228
00:20:45,680 --> 00:20:47,680
.سيرپينتي، اتلُ صلواتك

229
00:20:48,600 --> 00:20:49,560
...أرجوك

230
00:20:49,930 --> 00:20:52,640
!لا أريد أن أموت! أتوسّل إليك

231
00:20:53,480 --> 00:20:55,400
.أنا لن أقتل أحدًا بعد الآن

232
00:20:55,400 --> 00:20:57,690
.سأقطع علاقتي مع كلٍّ من أوركو وفانغو

233
00:20:58,230 --> 00:21:00,820
أَسوف تقتلني أمام ترونكو؟

234
00:21:00,820 --> 00:21:02,570
أَستلّطخ قبره بالدّم؟

235
00:21:02,570 --> 00:21:03,860
أَلن تُصلّي؟

236
00:21:03,860 --> 00:21:06,490
!لا تفعل هذا! لا أريد أن أموت

237
00:21:07,700 --> 00:21:08,330
.حسنٌ إذن

238
00:21:08,620 --> 00:21:10,120
!كلّا

239
00:21:16,630 --> 00:21:19,750
.عسى أن يرحم الرّب روحك الآثمة

240
00:21:25,340 --> 00:21:26,680
...بتلك اللّيلة

241
00:21:27,390 --> 00:21:29,390
الأشخاص الذين اغتالوا عائلتي كانوا

242
00:21:29,720 --> 00:21:31,350
،ڤينسينت ڤانيتي

243
00:21:31,810 --> 00:21:32,890
...وابنه نيرو

244
00:21:33,730 --> 00:21:34,770
...بالإضافة إلى

245
00:21:35,140 --> 00:21:36,810
.ڤانو كليمينتي

246
00:21:55,750 --> 00:21:57,500
مَن... تكون؟

247
00:21:57,830 --> 00:21:59,880
.اسمي هو أنجيلو

248
00:21:59,880 --> 00:22:01,460
...أنا ابن الرّجل الذي قتلتموه

249
00:22:01,800 --> 00:22:04,090
.ابن تيستا لاغوسا

250
00:23:38,820 --> 00:23:40,170
!هدّئ من روعك

251
00:23:40,370 --> 00:23:42,270
.لنسمع ما لديه ليقول أوّلًا

252
00:23:43,310 --> 00:23:45,520
.لقد أخذ مسدّس ڤانو

253
00:23:45,820 --> 00:23:49,030
.تمكّنتُ من إرداء سيرپينتي، لكنّ الأوان كان قد فات

254
00:23:49,780 --> 00:23:51,660
أَلم تُكبّلا يديه؟

255
00:23:51,660 --> 00:23:54,160
.قال أنّه يريد أن يتلو صلواته

256
00:23:54,660 --> 00:23:56,700
...لذا قام ڤانو بفكّ وثاقه

257
00:23:56,990 --> 00:23:58,200
.خُذني إلى هناك

258
00:23:58,500 --> 00:23:59,580
.إلى مكان الحدث

259
00:24:03,670 --> 00:24:04,960
...هُناك

260
00:24:05,960 --> 00:24:07,130
...هُنا حيث قد