1
00:00:02,600 --> 00:00:07,640
أَكان ردّ فعل آل غالاسيا حسنًا حين أتيتَ لهم بالكحول؟

2
00:00:07,640 --> 00:00:11,380
.أجل. قالوا أنّ ما جرى مع رونالدو بات في طيّ النّسيان

3
00:00:11,770 --> 00:00:16,160
.أذكرُ رجلًا يُدعى ستريغا قد حضر الجنازة

4
00:00:17,440 --> 00:00:20,780
.إنّه ابن أخ الدّون غالاسيا
.وابن عمّ رونالدو

5
00:00:21,340 --> 00:00:23,310
أَلتقيتَه في شيكاغو؟

6
00:00:25,680 --> 00:00:26,610
.أڤيليو

7
00:00:27,840 --> 00:00:28,510
.أجل

8
00:00:28,860 --> 00:00:30,230
أَأخذت أيّ قسطٍ من النّوم؟

9
00:00:31,390 --> 00:00:34,500
.في كلّ الأحوال، حريٌّ بنا أن نعمل بحذر

10
00:00:34,740 --> 00:00:38,300
ما مِن شيءٍ يدعونا للشّعور بالتوتّر. أَليس كذلك يا عمّي؟

11
00:00:38,300 --> 00:00:42,350
.حسنًا، إنّها العائلة المهيبة المُسيطرة على شيكاغو

12
00:00:42,350 --> 00:00:44,690
.يجدر بنا ألّا نقوم بشيءٍ قد يُشعرهم بالاستياء

13
00:00:48,860 --> 00:00:50,580
.وها قد وصلوا

14
00:02:31,540 --> 00:02:34,870
.لكم يشرّفني حقًّا لقاؤك أيّها الدّون غالاسيا

15
00:02:35,980 --> 00:02:38,550
أنت ابن ڤينس إذن؟

16
00:02:38,550 --> 00:02:40,590
.أنت تبدو تمامًا مثلما كان يبدو عليه في صِباه

17
00:02:41,500 --> 00:02:42,810
..فيما يتعلّق برونالدو

18
00:02:42,810 --> 00:02:46,950
.لا تشغل بالك. لقد قمتَ بتحمّل مسؤوليّة ذلك بنفسك

19
00:02:47,520 --> 00:02:52,350
.لنمضِ قدمًا ونبني علاقةً وطيدة معًا

20
00:02:52,720 --> 00:02:54,520
.أنا مُمتنٌّ لك على هذا

21
00:02:55,620 --> 00:02:58,310
.هذا ابن أخي ستريغا
.إنّه رجلٌ كُفؤ

22
00:02:58,510 --> 00:03:01,290
.أتمنّى أن تنسجموا معًا أنتم الشبّان

23
00:03:03,420 --> 00:03:06,030
.تسعدني رؤيتك أيّها الدّون غالاسيا

24
00:03:07,340 --> 00:03:09,150
!الدّون ڤانيتي

25
00:03:10,700 --> 00:03:14,220
كلّا، لقد سلّمتَ منصب الدّون لنيرو، أَليس كذلك؟

26
00:03:14,220 --> 00:03:20,380
.صحيح، لقد رميتُ عليه بكلّ المهام حتّى يستنّى لي أن أستريح

27
00:03:20,940 --> 00:03:22,610
!كم أحسدك على هذا

28
00:03:22,610 --> 00:03:23,750
أَتريدون كأسًا؟

29
00:03:24,730 --> 00:03:27,060
هذا الشّراب الذي أحضره إلينا أڤيليو، صحيح؟

30
00:03:27,060 --> 00:03:30,030
.أنا واثقٌ أنّه سيكون ذائع الصّيت في  شيكاغو أيضًا

31
00:03:33,660 --> 00:03:34,920
أَأنت على ما يرام؟

32
00:03:36,340 --> 00:03:37,700
...أستميحك عذرًا

33
00:03:44,280 --> 00:03:46,460
أَأنت مُستعدٌّ للقدوم إلى شيكاغو؟

34
00:03:47,440 --> 00:03:49,450
.من المُحال أن أهجر هذا المكان

35
00:03:49,640 --> 00:03:51,250
.نيرو ڤانيتي

36
00:03:51,250 --> 00:03:53,430
،إنّه يبدو رجلًا مثيرًا للاهتمام

37
00:03:53,430 --> 00:03:58,220
.لكنّ صبيًّا بمثل سذاجته سيهوي عاجلًا أم آجلًا

38
00:03:59,630 --> 00:04:03,170
.انظر للأمام يا أڤيليو، نحو المستقبل

39
00:04:03,840 --> 00:04:06,750
.إنّ هذه البلدة صغيرةٌ عليك

40
00:04:17,370 --> 00:04:19,230
.حالتك تبدو مزرية

41
00:04:20,120 --> 00:04:21,980
أَطرأ أيّ تغيير في خطّة الغد؟

42
00:04:22,720 --> 00:04:26,950
.كلّا. إنّ غرفتهما بآخر الرّدهة على الطّابق الثّاني

43
00:04:28,640 --> 00:04:33,970
الباب مضادٌّ للرّصاص، لذا سيتوجّب عليك
.الدّخول حتّى تتمكّن من قتل ڤينسينت

44
00:04:34,810 --> 00:04:37,450
.كما أنّ الباب الوحيد الذي ليس له مقبضٌ خارجي

45
00:04:38,200 --> 00:04:42,220
لقد تمّ إعداده بحيث ألّا يكون بوسع أحدٍ
.الدّخول من الخارج دون مفتاح

46
00:04:43,030 --> 00:04:46,230
.هذان سيُجهزان على ديل تورو الذي سيكون أمام الباب

47
00:04:46,880 --> 00:04:50,090
.وحينها سيظهر مُنقذهما، أڤيليو العظيم

48
00:04:50,090 --> 00:04:53,970
.إن لم يجرِ الأمر كما هو مخطّط له، فإنّ نيرو سيفتح ىالباب

49
00:04:53,970 --> 00:04:58,680
،سأسمح لغالاسيا بالهروب أوّلًا
.بعدها سأقتل ڤينسينت العاجز عن الفرار، ومن ثمّ نيرو

50
00:05:00,520 --> 00:05:03,120
.أضف اسمك هنا

51
00:05:04,440 --> 00:05:07,610
.إن كان اسمك عليها، فذلك سيعني أنّك عدوّي

52
00:05:08,500 --> 00:05:09,740
فهمت قصدي، أَليس كذلك؟

53
00:05:11,180 --> 00:05:12,900
.إنّ خُدعك لا حصر لها حقًّا

54
00:05:14,880 --> 00:05:17,370
لقد كنتَ حاضرًا هناك يومها، أَليس كذلك؟

55
00:05:20,800 --> 00:05:22,850
كنت تعلم؟

56
00:05:23,100 --> 00:05:27,090
.أجل. لكنّي أعلم أيضًا أنّك لم تُطلق أيّ رصاصة

57
00:05:28,650 --> 00:05:32,930
.لقد كان ڤينسينت متآمرًا معا آل غالاسيا آنذاك

58
00:05:33,250 --> 00:05:38,150
.والدك اكتشف أمر ذلك، لذا اغتاله هو وعائلتك

59
00:05:39,330 --> 00:05:42,120
.يجب أن يكون مقتل ڤينسينت ونيرو على يدك أنت

60
00:05:42,120 --> 00:05:44,150
.عدا هذا، فلن يكون لأيّ شيءٍ من هذا أيّ معنى

61
00:05:45,830 --> 00:05:48,900
.لا تستعجلني
.كلّ شيءٍ في أوانه

62
00:05:53,410 --> 00:05:55,010
عمَّ تتحدّث؟

63
00:05:55,010 --> 00:05:56,050
.لاى شيء

64
00:06:12,390 --> 00:06:14,480
أواثقٌ أنّه بإمكاننا الاعتماد عليه؟

65
00:06:14,480 --> 00:06:16,240
...إن أصاب الدّون أيّ مكروه

66
00:06:16,240 --> 00:06:17,430
.إنّه أهلٌ لها

67
00:06:18,400 --> 00:06:20,500
...وما إن يموت ڤينسينت

68
00:06:22,150 --> 00:06:26,030
.خلال يومين، ستكون أنت مَن سيوحّد العائلة

69
00:06:26,030 --> 00:06:27,600
.لا تُفسد الأمر

70
00:06:27,600 --> 00:06:28,550
.أكيد

71
00:06:29,100 --> 00:06:33,030
.على عكس نيرو، فأنا أمتثل بالأوامر

72
00:06:37,490 --> 00:06:39,530
أَيعلم الدّون غالاسيا بشأن هذا؟

73
00:06:40,070 --> 00:06:45,020
.لا حاجة له بذلك
.عمّي أمسى رقيق القلب هو الآخر

74
00:06:47,880 --> 00:06:49,970
نيرو، هل لي بلحظة من وقتك؟

75
00:06:50,540 --> 00:06:51,970
أَلأمر يتعلّق بأڤيليو؟

76
00:06:52,250 --> 00:06:56,490
.أجل. أظنّ أنّه سيكون من الأفضل أن نُقيله من طاقم أمن المسرح

77
00:06:57,120 --> 00:06:58,000
ولماذا؟

78
00:06:58,380 --> 00:07:01,460
.أظنّ أنّه مُغتاظٌ منّا جرّاء ما حلّ بكورتيو

79
00:07:01,840 --> 00:07:03,300
.وخاصّةً منك أنت

80
00:07:03,300 --> 00:07:04,980
...اعمل بنصيحتي و

81
00:07:04,330 --> 00:07:07,260
.لقد برّأ نفسه من كلّ الشّبهات بالأمس

82
00:07:07,610 --> 00:07:11,130
بأيّ نفعٍ قد يعود عليه الاغتياظ منّا الآن؟

83
00:07:11,840 --> 00:07:15,060
.إنّه أشبه بقوقعة فارغة

84
00:07:18,800 --> 00:07:21,750
.سأمنح أڤيليو شيئًا يمكنه أن يعيش لأجله

85
00:07:27,090 --> 00:07:28,370
كيف تشعر؟

86
00:07:29,670 --> 00:07:31,230
.أنا بحالة جيّدة اليوم

87
00:07:31,620 --> 00:07:33,470
أَكلّمتَ الطّبيب؟

88
00:07:33,470 --> 00:07:35,280
.لقد قال أنّك ستكون بصحّة جيّدة عمّا قريب

89
00:07:35,280 --> 00:07:36,770
.لا تُخفِ الأمر

90
00:07:37,130 --> 00:07:39,510
.أعلم أنّ أجلي دنا قريبًا

91
00:07:52,620 --> 00:07:57,240
.في الماضي، قمتُ باغتيال أعزّ صديقٍ لي وعائلته بيداي

92
00:07:58,880 --> 00:08:01,410
،لو أنّي لم أقتل تيستا حينها

93
00:08:02,190 --> 00:08:05,630
.لكان آل غالاسيا قد استحوذوا على العائلة

94
00:08:08,060 --> 00:08:09,770
،طيلة السّنوات السّبع التي مضت منذها

95
00:08:10,190 --> 00:08:12,500
.ما فتئتُ أُقنع نفسي بهذا الكلام

96
00:08:12,960 --> 00:08:19,270
لكن حين أتفكّر في الأمر الآن، أتساءل
.لو كانت هنالك وسيلة أخرى لتفادي وقوع ذلك

97
00:08:20,150 --> 00:08:23,250
.في تلك الحالة، فلربّما لم أكُن مضطرًّا لقتله

98
00:08:24,180 --> 00:08:26,270
.هذا كلّ ما يشغل بالي

99
00:08:27,820 --> 00:08:28,760
.أبي

100
00:08:30,420 --> 00:08:33,420
.إنّ اسم عائلة ڤانيتي أهمّ من أيّ شيءٍ آخر

101
00:08:33,990 --> 00:08:37,030
.أهمّ من الأصدقاء، الأهل والأشقّاء

102
00:08:38,070 --> 00:08:39,650
.يتحتّم علينا أن نمضي بعزم

103
00:09:05,880 --> 00:09:07,140
.لقد عُدت

104
00:09:13,000 --> 00:09:15,250
.لقد كنتُ بانتظار هذا اليوم منذ زمنٍ طويل

105
00:09:17,860 --> 00:09:21,410
في الواقع... أَكنتُ حقًّا أثوق إليه؟

106
00:09:22,310 --> 00:09:23,750
.ما عاد بوسعي الجزم بذلك

107
00:09:25,150 --> 00:09:27,870
ما الذي عدتُ إلى هنا لأجله؟

108
00:09:28,620 --> 00:09:31,010
ما الذي كنتُ أقتل لأجله؟

109
00:09:31,760 --> 00:09:34,660
.أخبرني يا كورتيو

110
00:09:44,400 --> 00:09:46,980
.كلّ شيءٍ سينتهي بالغد

111
00:09:58,040 --> 00:09:59,670
!روديكم! لا تتدافعوا

112
00:10:02,550 --> 00:10:03,660
!الدّون ڤانيتي

113
00:10:03,660 --> 00:10:06,600
.لقد مضت ثلاث سنواتٍ على آخر مرّة شُهدتَ فيها بالعلن

114
00:10:06,600 --> 00:10:07,930
هلّا تكرّمتَ بقول كلمة؟

115
00:10:09,220 --> 00:10:10,760
.إنّه بديع الجمال

116
00:10:11,860 --> 00:10:12,570
.أجل

117
00:10:21,700 --> 00:10:22,600
!إنّه غالاسيا

118
00:10:22,600 --> 00:10:23,610
!لقد وصل

119
00:10:29,140 --> 00:10:31,280
ما رأيك بالمسرح؟

120
00:10:31,800 --> 00:10:34,500
.لقد صمّمتُه على شكل مسرح لا سكالا الذي في ميلان

121
00:10:34,500 --> 00:10:38,280
وقد استدعيتَ مهندسًا إيطاليًّا ليبنيه، صحيح؟

122
00:10:38,580 --> 00:10:40,810
.لقد أخبرتني بهذا خمسين مرّة من قبل

123
00:10:40,810 --> 00:10:44,810
.هذا المسرح كان حلمي

124
00:10:47,080 --> 00:10:51,840
.أجل. يتوجّب عليّ قول أنّي أحسدك

125
00:10:51,840 --> 00:10:54,200
.لقد نلتَ كلّ ما ابتغيتَه

126
00:10:55,270 --> 00:11:02,690
،وما إن نسوّي الأمور على خيرٍ مع غالاسيا
.فلن يكون هنالك شيء نخشاه

127
00:11:05,460 --> 00:11:08,250
.أنا واثقٌ أنّ تيستا لاغوزا كان ليتفهّم

128
00:11:15,030 --> 00:11:18,330
.بئسًا، انظروا إليهم كيف يتبخترون بتلك البنادق

129
00:11:18,590 --> 00:11:20,330
.إنّهم لا يتحلّون بشيءٍ من الرُّقي

130
00:11:20,330 --> 00:11:21,960
وهل لهم من خيارٍ آخر؟

131
00:11:21,960 --> 00:11:24,280
.لا يسعهم المخاطرة بالسّماح بوقوع شيءٍ اللّيلة

132
00:11:26,800 --> 00:11:28,550
أحان موعد البدء؟

133
00:11:32,800 --> 00:11:34,300
.سأذهب لألقي نظرة على الضّواحي

134
00:11:38,240 --> 00:11:44,060
لم يسبق لي أن كنتُ فخورًا
.بكوني عمدة لوليس كما أنا فخورٌ اليوم

135
00:11:45,800 --> 00:11:47,560
،والآن، ومرّة أخرى

136
00:11:47,560 --> 00:11:51,060
.أرجو منكم أن تصفّقوا بحرارة للسيّد ڤينسينت ڤانيتي

137
00:12:01,190 --> 00:12:02,990
.هذا مثيرٌ للإعجاب حقًّا

138
00:12:03,360 --> 00:12:06,380
.نحن لا نملك حتّى مسرحًا بهذه الرّوعة في شيكاغو

139
00:12:06,380 --> 00:12:07,610
.يشرّفني هذا

140
00:12:10,260 --> 00:12:13,770
.نخب بدايةٍ جديدة مع عائلة ڤانيتي

141
00:12:29,730 --> 00:12:31,750
.حسنًا، شكرًا لك

142
00:12:31,750 --> 00:12:34,280
.أجل. سنتبادل الأدوار عند التّاسعة

143
00:12:36,040 --> 00:12:38,850
.أنا مسرورٌ أنّهم متفهّمون

144
00:12:38,850 --> 00:12:41,830
.كان ليُجنّ جنوني بعد ثلاث ساعات من الوقوف

145
00:12:42,400 --> 00:12:43,240
.تمهّل عندك

146
00:12:43,840 --> 00:12:45,290
!اذهب ودخّن هناك

147
00:12:45,290 --> 00:12:46,760
.كما تريد

148
00:12:53,240 --> 00:12:57,120
أيّها السيّد ديل تورو، هلّا أعطيتني عود ثقابٍ من فضلك؟

149
00:12:59,610 --> 00:13:02,380
.هيّا، لا داعي لأن تتجاهلني

150
00:13:14,330 --> 00:13:16,110
.الزم الصّمت أبدًا

151
00:14:02,300 --> 00:14:03,060
.كما توقّعت

152
00:14:13,580 --> 00:14:16,370
لقد أردتَ الانتقام لكورتيو، أَليس كذلك؟

153
00:14:26,420 --> 00:14:30,960
.إنّ رفاقي في إثر النّيل من نيرو بهذه الأثناء

154
00:14:30,960 --> 00:14:32,790
.لا تغيّر الموضوع

155
00:14:33,140 --> 00:14:34,250
...لكن

156
00:14:34,720 --> 00:14:37,870
.لم يكن هنالك أثرٌ لحرّاس غالاسيا هناك

157
00:14:38,700 --> 00:14:40,220
.هذا يثير قلقي

158
00:14:41,240 --> 00:14:43,670
.هنالك رسالةٌ في جيب سترتي

159
00:14:44,700 --> 00:14:46,990
.إنّها من الرّجل الذي استدعاني إلى هذه البلدة

160
00:14:49,130 --> 00:14:50,980
أنجيلو لاغوزا؟

161
00:14:51,360 --> 00:14:52,730
ما الذي تقوله الرّسالة؟

162
00:14:53,390 --> 00:14:56,740
،الذين قد اغتلوا والدك، أُمّك وأخاك الأصغر

163
00:14:56,740 --> 00:14:59,580
...يعيشون الآن في أمنٍ وسلام بلوليس

164
00:14:59,900 --> 00:15:03,080
...وهُم ڤينسينت ڤانيتي، ابنه نيرو

165
00:15:03,310 --> 00:15:07,260
".ڤانو كليمينتي وغانزو ألاري

166
00:15:09,320 --> 00:15:10,560
مَن بعث لك بهذا؟

167
00:15:11,240 --> 00:15:14,210
مَن يكون أعزّ صديقٍ لتيستا لاغوزا هذا؟

168
00:15:22,750 --> 00:15:25,040
!سأُنادي نيرو والعمّ غانزو

169
00:15:25,040 --> 00:15:25,720
.انتظر

170
00:15:27,470 --> 00:15:28,950
.لا تنادِ نيرو

171
00:15:49,030 --> 00:15:51,360
لا يسعني تصديق هذا. أڤيليو فعل هذا؟

172
00:15:51,360 --> 00:15:53,630
.باربيرو أخبرني ألّا أُنادي نيرو

173
00:15:54,820 --> 00:15:57,180
.كلّا، بل عليك مناداته

174
00:15:57,760 --> 00:15:58,550
...لكن

175
00:15:59,050 --> 00:16:02,180
.نيرو هو الدّون، لا باربيرو

176
00:16:08,880 --> 00:16:11,000
.ما الذي جرى؟ فسّر لي

177
00:16:11,000 --> 00:16:13,200
.لقد كان يسعى وراء نيرو كما ظننت

178
00:16:13,200 --> 00:16:15,030
.والدّون ڤينسينت وأنت كذلك

179
00:16:16,050 --> 00:16:19,040
.أيًّا كان مَن قد بعث بهذه الرّسالة هو السّبب في كلّ هذا

180
00:16:19,500 --> 00:16:20,660
أَتعلم مَن قد يكون؟

181
00:16:21,180 --> 00:16:22,120
.لا فكرة لديّ

182
00:16:23,240 --> 00:16:24,220
أين تيغري؟

183
00:16:24,530 --> 00:16:26,170
.لقد ذهب لإحضار نيرو

184
00:16:26,780 --> 00:16:27,470
!لماذا؟

185
00:16:27,710 --> 00:16:30,130
.على نيرو أن يقرّر ما يجب فعله

186
00:16:30,540 --> 00:16:32,420
.فهذا الفتى كان يده اليمنى في نهاية المطاف

187
00:16:32,690 --> 00:16:35,510
!كلّا! نيرو لن يقتله

188
00:16:35,510 --> 00:16:37,830
.رويدك، هوّن عليك يا باربيرو

189
00:16:38,860 --> 00:16:42,880
...ڤانو، ديل تورو ووفيات من غيرهم الكثير

190
00:16:43,320 --> 00:16:45,910
!لقد كان هو المسؤول عن جميعها

191
00:16:46,290 --> 00:16:50,740
.نيرو قال أنّك أشبه بقوقعة فارغة

192
00:16:51,290 --> 00:16:53,730
.لقد قال أنّه سيمنحك شيئًا يمكنك العيش لأجله

193
00:16:54,530 --> 00:16:56,240
!لقد أفقدتَ نيرو صوابه

194
00:16:56,760 --> 00:16:58,530
...لو أنّك لم تأتِ إلى هنا

195
00:16:59,760 --> 00:17:01,500
.لكم أنت مثيرٌ للشّفقة

196
00:17:05,520 --> 00:17:09,590
...أيّها الشيّطان الذي تملّك العائلة ولوّث عقل نيرو

197
00:17:09,590 --> 00:17:10,830
...سوف أحمي نيرو بنفسـ

198
00:17:15,800 --> 00:17:17,470
.يبدو أنّ الأمر قد انتهى

199
00:17:17,890 --> 00:17:19,640
أين تُراك قد زللتَ؟

200
00:17:20,300 --> 00:17:24,820
.في الواقع... كلّ شيءٍ يجري على خير ما يرام بنظري

201
00:17:26,830 --> 00:17:27,650
.نيرو

202
00:17:28,220 --> 00:17:29,100
.أستأذنكما

203
00:17:32,110 --> 00:17:33,080
ما الأمر؟

204
00:17:33,080 --> 00:17:35,060
...باربيرو قبض على أڤيليو

205
00:17:44,860 --> 00:17:45,730
عمّي؟

206
00:17:46,560 --> 00:17:49,300
.لقد لاذ بالفرار
.أنت فوّته للتّو

207
00:17:55,550 --> 00:17:56,760
!و- ويلاه

208
00:17:58,060 --> 00:18:02,320
!ما هذا بحقّ السّماء؟ هذا فظيع! تبًّا

209
00:18:04,320 --> 00:18:05,550
...أڤيليو

210
00:18:06,880 --> 00:18:11,790
.إنّه يسعى وراءك أنت وأنا وڤينسينت

211
00:18:11,790 --> 00:18:14,050
إذن فقد ذهب للدّون؟

212
00:18:14,450 --> 00:18:18,000
.لكنّه لا يستطيع الدّخول دون المفتاح

213
00:18:18,630 --> 00:18:20,330
.لنرسل أحدهم تحسّبًا فقط

214
00:18:20,330 --> 00:18:22,700
!سوف أجده وأقتله

215
00:18:22,700 --> 00:18:24,380
.تمهّلوا عندكم

216
00:18:24,760 --> 00:18:26,840
ما الذي يجري هنا؟

217
00:18:26,840 --> 00:18:29,240
أَتلك الجثّة جزءٌ من العرض المسرحي؟

218
00:18:30,490 --> 00:18:34,990
...إن أصاب الدّون أيّ مكروه
أنتم تعلمون ما سيحدث عندها، صحيح؟

219
00:18:35,520 --> 00:18:37,640
.لو كنتُ بمحلّه لذهبتُ ببندقيّة

220
00:18:37,990 --> 00:18:41,080
.هكذا سيكون بإمكاني قنصه بكلّ سهولة من الشّرفة المقابلة له

221
00:18:42,390 --> 00:18:43,270
!نيرو

222
00:18:44,260 --> 00:18:46,290
.من الأفضل أن نبدأ في البحث أيضًا

223
00:18:50,940 --> 00:18:53,000
!تفقّد الطّابق الرّابع يا تيغري

224
00:18:53,000 --> 00:18:53,480
!حسنٌ

225
00:19:08,220 --> 00:19:09,590
.المعذرة

226
00:19:09,910 --> 00:19:13,300
.لقد أُمرتُ بأن أقودكما للخارج من خلال الباب الخلفي

227
00:19:13,300 --> 00:19:14,560
أين هو ديل تورو؟

228
00:19:14,870 --> 00:19:17,350
.لا أدري. إنّه ليس هنا

229
00:19:17,640 --> 00:19:18,750
مَن أنت؟

230
00:19:19,510 --> 00:19:20,760
.أڤيليو

231
00:19:21,160 --> 00:19:22,750
.أحضر نيرو إلى هنا

232
00:19:23,540 --> 00:19:25,970
.من فضلك أيّها الدّون غالاسيا

233
00:19:26,180 --> 00:19:27,470
.إنّ الوقت يداهمنا

234
00:19:27,860 --> 00:19:29,210
!انتبه لما تتفوّه به

235
00:19:29,620 --> 00:19:32,560
.على هونك، لا داعي لأن تغضب

236
00:19:32,980 --> 00:19:35,250
.أنا أعرف هذا الرّجل جيّدًا بحدّ ذاتي

237
00:19:35,660 --> 00:19:38,020
.كما أنّه اليد اليمنى لابنك وفقًا لما سمعت

238
00:19:51,930 --> 00:19:54,180
،يبدو أنّنا وصلنا ذروة الأحداث

239
00:19:54,180 --> 00:19:56,120
.رغم أنّ الأمر لم يجري وفقًا للسّيناريو

240
00:19:56,680 --> 00:19:58,300
ما الذي يجري هنا؟

241
00:19:58,300 --> 00:20:01,520
.هذا الرّجل قام باغتيال عائلتي

242
00:20:01,820 --> 00:20:03,400
.أنا لا أعرفك

243
00:20:03,400 --> 00:20:05,800
.اسم أبي هو تيستا لاغوزا

244
00:20:07,910 --> 00:20:11,410
كم هذا عظيم! أَهذا جزءٌ من العرض أيضًا؟

245
00:20:11,410 --> 00:20:13,690
!هذا الفتى مثيرٌ للاهتمام بحقّ

246
00:20:14,100 --> 00:20:18,660
.لقد عُدتُ إلى هذه البلدة لأجل هذا اليوم

247
00:20:19,670 --> 00:20:23,200
.هذه المرّة، أنا مَن سيسلب كلّ شيء

248
00:20:56,900 --> 00:20:59,480
!ليستدعِ أحدكم طبيبًا

249
00:21:00,210 --> 00:21:01,570
!ويلٌ لك

250
00:21:01,770 --> 00:21:03,280
...تمهّل! هذا لم يكُن

251
00:21:08,020 --> 00:21:10,400
ما الذي يجري هنا بالضّبط؟

252
00:21:10,850 --> 00:21:13,520
.حسنًا، هذا ليس بتطوّرٍ سيّئ في الأحداث

253
00:21:14,460 --> 00:21:16,350
.اقضوا على آل ڤانيتي

254
00:21:39,080 --> 00:21:41,540
!نيرو... نيرو

255
00:21:42,940 --> 00:21:43,980
!أبي

256
00:21:47,760 --> 00:21:49,320
!تماسك

257
00:21:52,470 --> 00:21:53,550
...نيرو

258
00:21:55,910 --> 00:21:57,220
.لقد انتهى الأمر

259
00:21:58,700 --> 00:21:59,670
...أبي

260
00:22:01,820 --> 00:22:04,340
.كلّ شيءٍ كان دون جدوى

261
00:23:57,500 --> 00:23:58,700
...كورتيو

262
00:24:01,470 --> 00:24:02,710
.لقد فعلتُها