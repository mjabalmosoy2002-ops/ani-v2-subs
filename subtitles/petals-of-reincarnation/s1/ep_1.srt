1
00:00:00,830 --> 00:00:04,080
‫أريدُ مَوْهِبَة.

2
00:00:08,050 --> 00:00:11,170
‫يتحتَّمُ عليَّ أنْ أغدو شخصاً ذا شأن.

3
00:00:11,800 --> 00:00:13,130
‫أيُّ شيءٍ سيفي بالغرض...

4
00:00:18,100 --> 00:00:19,770
.‫واحدةٌ ستكفيني

5
00:00:22,850 --> 00:00:24,390
‫لابُدَّ لي أنْ أضعَ يدي عليها!

6
00:00:48,380 --> 00:00:50,380
رأيتِ بتلةً؟

7
00:00:50,460 --> 00:00:51,840
‫أجل.

8
00:00:51,920 --> 00:00:54,130
.‫قبلَ يومين، بالقربِ من البقالة

9
00:00:54,220 --> 00:00:55,050
‫وأنا أيضاً.

10
00:00:55,130 --> 00:00:56,720
‫لقد رأيتُ شخصاً كهذا أيضاً.

11
00:00:56,800 --> 00:00:59,350
‫لابُدَّ أنكم تختلقونَ هذا الهراء.

12
00:01:00,220 --> 00:01:01,350
...لكن

13
00:01:01,430 --> 00:01:03,310
‫...أليست الشائعاتُ حولَ البتلاتِ

14
00:01:01,900 --> 00:01:03,310
لو تسنَّى لك أنْ تكونَ شخصيَّةً عظيمَةً

15
00:01:03,390 --> 00:01:04,390
كثيرةً جداً على وسائلِ التواصلِ مؤخرا؟

16
00:01:03,390 --> 00:01:04,390
من الماضي، مَنْ ستختار؟

17
00:01:04,480 --> 00:01:05,980
.معكِ حق

18
00:01:04,480 --> 00:01:05,980
.أظنُّ أنني سأختارُ هيديوشي

19
00:01:06,060 --> 00:01:08,060
‫لقدرتِه على تدفئةِ أيِّ شيء.

20
00:01:07,320 --> 00:01:08,060
أمنَ الممكنِ أنْ يكونَ

21
00:01:08,150 --> 00:01:09,270
.إنهُ الأقوى

22
00:01:08,150 --> 00:01:10,690
أحد القتلةِ المتسلسلين؟

23
00:01:09,360 --> 00:01:12,110
.أنا سأختارُ حتماً كين هوشياما

24
00:01:10,770 --> 00:01:12,110
.من المستحيل أن يكون كذلك

25
00:01:12,190 --> 00:01:14,360
.هذا قولٌ ينمُّ عن طَيْشٍ شديد

26
00:01:12,190 --> 00:01:14,360
.حينها سأغدو زوجَ زيكي

27
00:01:14,440 --> 00:01:16,280
‫كلا، كين لا يزالُ على قيدِ الحياة.

28
00:01:14,440 --> 00:01:16,280
.ركز

29
00:01:16,360 --> 00:01:17,620
...إذا استمرَّ الأمرُ هكذا

30
00:01:16,360 --> 00:01:18,660
‫حسنًا، عودوا إلى مقاعدكم.

31
00:01:19,030 --> 00:01:19,990
‫حسناً...

32
00:01:20,080 --> 00:01:23,910
‫قبلَ أنْ نبدأَ حصتنا لليوم،
‫‫اسمحوا لي أنْ أُقدِّمَ طالبةً منتقلةً حديثاً.

33
00:01:24,580 --> 00:01:25,750
‫الزموا الهدوء.

34
00:01:25,830 --> 00:01:26,920
‫تفضَّلي بالدخول.

35
00:01:28,130 --> 00:01:29,000
‫حسناً إذاً...

36
00:01:30,460 --> 00:01:31,710
‫مهلاً، أنتِ.

37
00:01:38,220 --> 00:01:40,050
‫هايتو لو بافيت.

38
00:01:40,430 --> 00:01:41,600
.‫تشرَّفنا

39
00:01:44,020 --> 00:01:44,850
.حسنًا

40
00:01:47,480 --> 00:01:48,560
.أيًا يكُن

41
00:01:48,650 --> 00:01:50,440
‫يمكنكِ الجلوسُ بجانبه.

42
00:01:50,940 --> 00:01:53,070
.‫سأقومُ بتسجيل حضوركم

43
00:02:00,820 --> 00:02:02,450
!يا هذا توقف مكانك

44
00:02:04,240 --> 00:02:05,500
‫تويا سينجي.

45
00:02:12,250 --> 00:02:13,920
‫كيف عرفتِ اسمي...

46
00:02:15,960 --> 00:02:18,840
.لا يبدو عليكَ أنكَ من النوعِ المُجتهد

47
00:02:18,930 --> 00:02:20,140
‫هالاتٌ سوداءُ حادَّة.

48
00:02:20,220 --> 00:02:21,970
‫وحاجبانِ مقطَّبانِ دوماً.

49
00:02:22,600 --> 00:02:24,100
‫إلامَ تنظر بالضبط؟

50
00:02:25,930 --> 00:02:27,230
.أعذريني

51
00:02:27,310 --> 00:02:29,190
...لأن لدي دروس خصوصية لألحقها

52
00:02:32,730 --> 00:02:34,820
‫الأمرُ تماماً كما قُلتِ.

53
00:02:34,900 --> 00:02:37,320
‫لديهِ عينانِ ثاقبتان، يا نيومان.

54
00:02:38,200 --> 00:02:39,450
‫أجل.

55
00:02:39,530 --> 00:02:40,950
.‫إنهما متشابهان تمامًا

56
00:02:42,120 --> 00:02:43,910
.النجدة

57
00:02:43,990 --> 00:02:45,080
.رجاءً

58
00:02:45,700 --> 00:02:49,040
.لا داعي للخوف هكذا

59
00:02:49,120 --> 00:02:53,710
‫فسأعدُّ لكِ وجبةً شهيَّةً في لمحِ البصر.

60
00:02:53,790 --> 00:02:55,670
!‫أرجوك، توقف

61
00:02:55,750 --> 00:02:57,010
‫النَّجدة! كلا!

62
00:03:06,810 --> 00:03:08,480
‫هذا لن يجدي نفعاً...

63
00:03:09,850 --> 00:03:12,310
‫لابُدَّ من وجودِ مَوْهِبَةٍ واحدةٍ على الأقل.

64
00:03:12,980 --> 00:03:14,650
‫مَوْهِبَةٌ تخصُّني أنا وحدي.

65
00:03:15,940 --> 00:03:17,110
‫وإلا...

66
00:03:19,860 --> 00:03:21,860
‫أريدُ مَوْهِبَة...

67
00:03:21,950 --> 00:03:23,620
‫أيُّ شيءٍ سيفي بالغرض.

68
00:03:23,700 --> 00:03:25,700
.‫واحدةٌ ستكفيني

69
00:03:26,700 --> 00:03:28,790
...إن وضعتُ يدي عليها

70
00:03:29,960 --> 00:03:32,120
‫سأفعلُ أيَّ شيء.

71
00:03:33,420 --> 00:03:34,250
‫هل وجدته؟

72
00:03:34,330 --> 00:03:36,000
‫كلا، ولا حتى أثرٌ له.

73
00:03:36,800 --> 00:03:38,170
‫أيعقلُ أنْ يكونَ بلاغاً كاذباً؟

74
00:03:38,840 --> 00:03:41,470
‫أحدهم أفادَ بسماعِ صرخةٍ في الجوار...

75
00:03:42,760 --> 00:03:43,680
‫هاه؟

76
00:03:45,680 --> 00:03:47,180
‫لعلَّه سكيرٌ فحسب؟

77
00:03:47,850 --> 00:03:48,970
.يا إلهي

78
00:03:49,980 --> 00:03:51,310
هل أنتَ بخير؟

79
00:03:52,480 --> 00:03:53,650
.لا تكترث لأمري

80
00:03:53,730 --> 00:03:55,440
‫لا يسعني فِعْلُ ذلك...

81
00:03:55,520 --> 00:03:57,230
‫لأنها...

82
00:03:57,320 --> 00:04:00,820
‫وصفتني بالعاجزِ واستهزأتْ بي

83
00:04:00,900 --> 00:04:03,990
‫رغمَ مَوْهِبَتي العظيمة!

84
00:04:04,070 --> 00:04:05,160
...هـ-هذا

85
00:04:07,830 --> 00:04:09,750
‫ما هذهِ الرائحةُ الغريبة؟

86
00:04:19,960 --> 00:04:22,470
.لا يسعني التوقف

87
00:04:22,550 --> 00:04:25,010
‫أشعرُ حقاً أنني مُبارَك.

88
00:04:26,850 --> 00:04:28,100
‫لماذا...

89
00:04:28,180 --> 00:04:29,260
لماذا؟

90
00:04:29,720 --> 00:04:31,180
‫أتشعرُ بالغيرة؟

91
00:04:32,480 --> 00:04:36,480
‫حينَ يصادفُ المرءُ مَوْهِبَةً ما،
‫‫يعتصرُه ثلاثةُ أنواعٍ من المشاعر.

92
00:04:36,810 --> 00:04:37,980
‫الإعجاب.

93
00:04:38,070 --> 00:04:39,270
.الخوف

94
00:04:39,360 --> 00:04:40,860
‫والضغينة.

95
00:04:41,440 --> 00:04:43,150
‫أولئك القادرونَ على اقتناصِ مَوْهِبَةٍ

96
00:04:43,780 --> 00:04:45,950
‫يميلونَ للسقوطِ في دركٍ أعمقَ من الثالثة.

97
00:04:46,450 --> 00:04:47,780
‫أنتِ...

98
00:04:48,910 --> 00:04:51,040
...مهلًا، مهلًا، هذا

99
00:04:52,000 --> 00:04:54,540
،يبدو أنكَ تستمتع بوقتكَ وأنتَ تعيث فساداً

100
00:04:54,620 --> 00:04:55,580
.يا فيش

101
00:04:56,170 --> 00:04:57,790
‫الفضلُ كلُّه يعودُ إليك.

102
00:04:58,290 --> 00:05:04,050
‫ممتنٌ لكِ
‫‫لأنكِ أرشدتني إلى هذهِ المَوْهِبَةِ الرائعة.

103
00:05:04,130 --> 00:05:06,260
‫وكعربونِ امتنانٍ مني،

104
00:05:06,340 --> 00:05:09,640
‫سأقومُ بطهيكِ.

105
00:05:16,310 --> 00:05:17,150
هاه؟

106
00:05:17,860 --> 00:05:20,520
‫إلى أينَ ذهبا؟

107
00:05:20,610 --> 00:05:22,190
.تقدير المستقبل

108
00:05:22,280 --> 00:05:23,940
.‫كما هو مُتوقَّعٌ من نيومان

109
00:05:25,950 --> 00:05:27,030
.‫تشرَّفنا

110
00:05:28,870 --> 00:05:30,530
‫نيومان؟

111
00:05:30,620 --> 00:05:31,450
‫هايتو.

112
00:05:31,540 --> 00:05:33,250
‫أعلمُ ذلك.

113
00:05:36,000 --> 00:05:38,420
‫مهما كنتَ عاجزاً
‫‫في هذهِ الحياة،

114
00:05:38,500 --> 00:05:40,170
‫إنْ كنتَ تملكُ مَوْهِبَةً في حياتكَ السابقة،

115
00:05:40,250 --> 00:05:42,250
‫فبإمكانكَ أنْ تجعلها ملكاً لك.

116
00:05:42,800 --> 00:05:44,800
‫لو وُجدَ شيءٌ كهذا،

117
00:05:44,880 --> 00:05:45,720
‫يا تويا،

118
00:05:46,340 --> 00:05:48,010
‫ماذا كنتَ ستفعل؟

119
00:05:52,640 --> 00:05:54,020
.ذلك يُسمى غصن التجسيد

120
00:05:55,890 --> 00:05:57,270
.‫افتح عينيكَ وكن شاهداً على هذا

121
00:05:58,810 --> 00:06:00,060
!لـ-لحظة

122
00:06:04,780 --> 00:06:06,700
كُنتم هُناك إذًا؟

123
00:06:19,500 --> 00:06:20,460
‫هاراشوغي.

124
00:06:21,130 --> 00:06:22,420
‫كوبيكاري.

125
00:06:25,130 --> 00:06:26,300
!‫تعالوا

126
00:06:36,640 --> 00:06:38,100
‫بتلات؟

127
00:06:51,280 --> 00:06:53,120
‫مياموتو موساشي
‫‫(هارونوبو).

128
00:06:55,870 --> 00:06:57,330
‫ها هنا.

129
00:07:00,960 --> 00:07:02,330
‫أمزحُ فحسب.

130
00:07:03,340 --> 00:07:04,460
.‫العودةُ عبر إعادة التجسيد

131
00:07:05,420 --> 00:07:07,760
‫من خلالِ غصنِ التجسيد،
‫‫نتتبعُ حيواتِنا السابقة

132
00:07:07,840 --> 00:07:09,260
‫ونستحضرُ مواهبَنا.

133
00:07:09,340 --> 00:07:12,680
‫خذ هذه!

134
00:07:14,810 --> 00:07:17,140
‫أولئك الذين يخضعونَ بنجاحٍ
‫‫للعودةِ عبر إعادة التجسيد

135
00:07:17,220 --> 00:07:18,640
.‫يُطلقُ عليهم العائدون

136
00:07:31,860 --> 00:07:32,990
‫تلك البتلات...

137
00:07:33,530 --> 00:07:34,370
‫البتلاتُ

138
00:07:35,080 --> 00:07:38,120
‫هي الدليلُ على أولئك الذين استخرجوا
‫‫مواهبَهم من حيواتِهم السابقة.

139
00:07:38,790 --> 00:07:42,290
‫سواءً كانوا أبطالَ عصورِهم
‫‫أو عباقرةً فذِّين،

140
00:07:42,370 --> 00:07:44,420
‫فالموتُ حقٌّ على كلِّ البشر.

141
00:07:45,170 --> 00:07:47,170
‫بيدَ أنه، ومن سخريةِ القدر،

142
00:07:47,250 --> 00:07:49,720
‫وحدَهُ الموتُ
‫‫هو السبيلُ لدخولِ حلقة إعادة التجسيد،

143
00:07:49,800 --> 00:07:52,630
‫كي تستيقظَ مواهبُ العظماء
‫‫في عالمِ الأحياء.

144
00:07:53,340 --> 00:07:54,760
‫تماماً مِثلها.

145
00:08:00,180 --> 00:08:02,940
‫غصنُ إعادة التجسيد
‫‫يمكنُه استحضارُ المواهبِ من الحيواتِ السابقة.

146
00:08:07,480 --> 00:08:09,360
‫لكن، لا يمكنُ للمرءِ أنْ يختارَ
‫‫الموهبةَ التي يتلقاها.

147
00:08:10,360 --> 00:08:11,860
‫عظماءُ أو أبطال.

148
00:08:11,950 --> 00:08:16,330
‫تماماً كما توجدُ مواهبُ للعظماء
‫‫يمكنُها المضيُّ بالبشريَّةِ قُدُماً...

149
00:08:19,120 --> 00:08:20,330
.ذلك صحيح

150
00:08:21,750 --> 00:08:23,040
‫فيش.

151
00:08:23,120 --> 00:08:26,040
‫أشخاصٌ مِثلُه،
‫‫مجرمونَ عُتاة، وقتلة،

152
00:08:26,130 --> 00:08:27,500
‫وطغاة،

153
00:08:27,590 --> 00:08:30,170
‫يمتلكونَ مواهبَ يمكنُها إيذاءُ البشريَّة.

154
00:08:30,260 --> 00:08:33,090
.فحتى مواهب أولئك الآثمين يمكن أن تستيقظ

155
00:08:33,930 --> 00:08:34,970
‫وبطبيعةِ الحال،

156
00:08:35,050 --> 00:08:36,970
‫من الممكنِ أيضاً
‫‫ألا توقظَ أيَّ مَوْهِبَة

157
00:08:37,050 --> 00:08:39,260
‫وتموتَ هكذا فحسب.

158
00:08:40,390 --> 00:08:41,980
‫رغمَ ذلك، ألا تزالُ تبتغيها؟

159
00:08:43,020 --> 00:08:44,230
،‫على الأرجحِ لا تقوى على فِعْلِها

160
00:08:44,310 --> 00:08:45,940
‫لكن لا ضيرَ في ذلك ولا خجل.

161
00:08:46,730 --> 00:08:48,230
‫فالأمرُ يتجاوزُ المألوفَ بمراحل...

162
00:08:49,940 --> 00:08:50,980
‫تويا؟

163
00:08:52,280 --> 00:08:54,280
‫أليس هذا رائعاً؟

164
00:08:54,910 --> 00:08:58,870
‫لقد عقدتُ آمالي حينَ سمعتُ
‫‫أنها مَوْهِبَةُ ذلك السيَّافِ المغوار.

165
00:08:58,950 --> 00:09:01,250
.‫لكن بصراحة، خابَ أملي

166
00:09:01,700 --> 00:09:03,330
تقولها لي هكذا؟

167
00:09:04,370 --> 00:09:06,290
‫إيبيتسو نيتين ريهو.

168
00:09:06,920 --> 00:09:08,670
‫الجُثَّةُ ذاتُ الألوانِ الثمانية!

169
00:09:13,510 --> 00:09:15,880
!‫يا لهُ من سيفٍ كليل

170
00:09:16,180 --> 00:09:18,260
‫أتراقبُ سيفاً واحداً فقط؟

171
00:09:18,350 --> 00:09:19,390
.يا لك من أحمق

172
00:09:33,900 --> 00:09:35,820
.انتهى الأمر، يا نيومان

173
00:09:37,870 --> 00:09:38,910
‫أين تويا؟

174
00:09:39,580 --> 00:09:40,740
‫لقد غادر.

175
00:09:44,870 --> 00:09:46,040
.هكذا إذاً

176
00:09:51,170 --> 00:09:52,800
‫إنْ كانَ تويا، فأنا واثقةٌ أنهُ يستطيع.

177
00:09:54,010 --> 00:09:54,840
.اظهار البتلاتِ

178
00:10:05,180 --> 00:10:06,770
‫أنا هنا، يا تويا.

179
00:10:07,190 --> 00:10:08,230
...انتظر

180
00:10:08,310 --> 00:10:09,270
‫انتظرني!

181
00:10:09,730 --> 00:10:10,770
‫ما الخطب؟

182
00:10:10,860 --> 00:10:11,770
‫أسرع.

183
00:10:12,320 --> 00:10:13,400
‫تويا.

184
00:10:13,480 --> 00:10:14,570
‫أخي!

185
00:10:15,990 --> 00:10:18,610
‫تويا.

186
00:10:19,910 --> 00:10:20,910
.صباح الخير

187
00:10:23,120 --> 00:10:24,330
لمَ؟

188
00:10:26,250 --> 00:10:28,960
‫يبدو أنكَ أتممتَ بنجاحٍ
‫‫عودتَكَ عبر إعادة التجسيد.

189
00:10:29,040 --> 00:10:32,880
‫لكنكَ كنتَ تئنُّ طوالَ الوقت.

190
00:10:35,550 --> 00:10:38,380
‫كانَ لي أخٌ أكبر.

191
00:10:38,470 --> 00:10:41,140
‫في الدراسة، والفنونِ القتالية، والفن.

192
00:10:41,220 --> 00:10:42,760
‫كانَ بارعاً في كلِّ شيء.

193
00:10:43,470 --> 00:10:45,390
‫حتى إنهم لقبوهُ بالنابغَة.

194
00:10:45,470 --> 00:10:47,430
‫مقارنةً بأخي،
‫‫الذي كدَّسَ الثروةَ في سنٍّ مبكرة

195
00:10:47,520 --> 00:10:49,850
‫وعُلِّقتْ عليه آمالٌ عريضة...

196
00:10:50,600 --> 00:10:52,610
‫المركزُ الرابعُ بالترتيب؟

197
00:10:52,690 --> 00:10:55,110
‫سيا كانَ يحلُّ في المركزِ الأولِ دوماً.

198
00:10:55,940 --> 00:10:57,740
‫سيا كانَ يفوزُ دوماً.

199
00:10:57,820 --> 00:11:00,990
.أنت، في العائلة، فاشل لا يُعلى عليه

200
00:11:01,530 --> 00:11:03,660
‫أيها الأحمقُ العاجز!

201
00:11:04,620 --> 00:11:07,330
‫كنتُ أحاولُ يائساً دوماً
‫‫اللحاقَ به.

202
00:11:08,370 --> 00:11:10,920
.لكن، يبدو أن العباقرة لا يطيل لهم العمر

203
00:11:11,750 --> 00:11:13,420
...لأن أخي مرضَ و

204
00:11:14,380 --> 00:11:16,000
‫لا تخبرني...

205
00:11:16,090 --> 00:11:18,260
.أُلقيَ بِلَومِ وفاتِه عليَّ

206
00:11:18,920 --> 00:11:20,090
‫الآنَ وبتفكيري في الأمر،

207
00:11:20,180 --> 00:11:23,760
‫ربما كانَ ذلك لحمايةِ
‫‫اسمِ العائلةِ الذي بنوهُ أخيراً.

208
00:11:25,100 --> 00:11:26,850
‫أياً كانَ السبب،

209
00:11:26,930 --> 00:11:29,270
‫فقد طُردتُ من العائلة.

210
00:11:30,810 --> 00:11:31,770
‫وأنا...

211
00:11:32,400 --> 00:11:35,020
‫أريدُ نَيْلَ مَوْهِبَةٍ لأردَّ لهم الصاعَ صاعين.

212
00:11:35,610 --> 00:11:37,320
‫أريدُ الانتقام.

213
00:11:37,940 --> 00:11:40,200
‫ممن استصغروني وازدروني.

214
00:11:41,860 --> 00:11:43,120
‫وقبلَ كلِّ شيء...

215
00:11:43,200 --> 00:11:45,700
‫من نفسي،

216
00:11:45,780 --> 00:11:47,200
‫لعجزي عن تحقيقِ أيِّ شيء.

217
00:11:48,080 --> 00:11:49,580
.فهمتُك

218
00:11:49,660 --> 00:11:52,210
‫لهذا السببِ كنتَ تبحث.

219
00:11:52,290 --> 00:11:53,380
‫الكمان،

220
00:11:54,250 --> 00:11:56,250
‫البيانو، الناي، الرسمُ الزيتي، الرقص،

221
00:11:56,340 --> 00:11:58,710
‫السباحة، ألعابُ القوى،
‫‫كرةُ السلة، كرةُ القدم،

222
00:11:58,800 --> 00:12:02,180
‫الجمباز، "الغو"، الشطرنج،
‫‫بالإضافةِ للأيكيدو، الكاراتيه، والكيندو.

223
00:12:03,050 --> 00:12:05,390
‫هذا كلُّ ما تعلمتُه في حياتي.

224
00:12:05,470 --> 00:12:06,430
‫مُحال!

225
00:12:06,510 --> 00:12:08,930
.فأنا لم أمتلك أيًا من تلك المواهب

226
00:12:10,020 --> 00:12:11,690
‫إذاً نحنُ...

227
00:12:12,560 --> 00:12:14,230
‫نتشابهُ كثيراً.

228
00:12:14,310 --> 00:12:16,020
‫ماذا تقصدين؟

229
00:12:22,780 --> 00:12:25,160
.إذًا، حضرْتَ يا تويا سينجي

230
00:12:25,700 --> 00:12:26,910
‫كنتُ بانتظارك.

231
00:12:30,540 --> 00:12:31,750
‫أأنتِ...

232
00:12:32,330 --> 00:12:33,670
‫نيومان؟

233
00:12:35,040 --> 00:12:36,210
‫أين الآخرون؟

234
00:12:36,290 --> 00:12:37,790
.‫لقد خرجوا

235
00:12:37,880 --> 00:12:39,960
‫لإبادةِ العائدينَ الأشرار.

236
00:12:40,880 --> 00:12:44,470
‫هذا هو المبدأُ التوجيهيُّ
‫‫لِغابَتِنا، "غابة العُظماء".

237
00:12:45,140 --> 00:12:46,680
‫غابةُ العُظماء؟

238
00:12:46,760 --> 00:12:49,470
‫غصنُ إعادة التجسيد
‫‫لا يمكنُه اختيارُ المواهبِ التي يستحضرُها.

239
00:12:49,560 --> 00:12:52,560
‫إنْ كانت مواهبَ للعظماءِ
‫‫تنفعُ البشريَّة، فهذا شأنٌ آخر.

240
00:12:53,310 --> 00:12:54,850
‫ولكن إنْ

241
00:12:54,940 --> 00:12:58,730
‫استحضرَتْ مَوْهِبَةً من حياةٍ سابقة
‫‫مِثلَ مَوْهِبَةِ  فيش التي تؤذي البشريَّة،

242
00:12:58,820 --> 00:13:00,820
‫فيجبُ إبادتُهم على الفور.

243
00:13:01,690 --> 00:13:06,370
‫وهذهِ هي مهمتُنا، نحنُ
‫‫من نحملُ مواهبَ من فئةِ العُظماء.

244
00:13:06,950 --> 00:13:08,160
‫لا تنسَ.

245
00:13:08,240 --> 00:13:11,450
‫المَوْهِبَةُ المكتسبةُ عبرَ
‫‫العودةِ عبر إعادة التجسيد هي هبة.

246
00:13:11,540 --> 00:13:13,370
‫لا تغترَّ بموهبتِك.

247
00:13:13,460 --> 00:13:15,920
‫سخِّرْها لخدمةِ البشريَّة.

248
00:13:16,580 --> 00:13:17,710
‫هذا كلُّ شيء.

249
00:13:18,500 --> 00:13:20,000
‫بناءً على ذلك،

250
00:13:20,090 --> 00:13:23,550
‫سأطلبُ منكَ تنفيذَ مهمةٍ
‫‫مع هايتو على الفور.

251
00:13:25,470 --> 00:13:27,680
‫الهدفُ هو أحدُ الآثمين...

252
00:13:28,680 --> 00:13:30,180
‫فلاد الثالث.

253
00:13:31,060 --> 00:13:33,640
‫لا تقتلاهُ،
‫‫ولكن لا تتركاهُ حياً أيضاً.

254
00:13:33,730 --> 00:13:35,480
‫لا نتركُه حياً، ولكن لا نقتله؟

255
00:13:35,560 --> 00:13:36,900
‫ألسنا بصددِ إبادتِه؟

256
00:13:36,980 --> 00:13:39,190
‫ثمةَ أمرٌ
‫‫يؤرقني ويشغلُ بالي.

257
00:13:39,860 --> 00:13:41,820
‫هايتو، قومي بتشتيتِ العدو.

258
00:13:41,900 --> 00:13:44,320
‫واصلي المعركة
‫‫لأطولِ فترةٍ ممكنة،

259
00:13:44,990 --> 00:13:47,240
‫ولكن أجهزِي عليهِ بعدَ عشرِ دقائق.

260
00:13:47,320 --> 00:13:49,870
‫إنْ تأخرنا أكثر،
‫‫فسيكتشفونَ أمرَ مواهبِنا.

261
00:13:49,950 --> 00:13:50,950
‫حسناً.

262
00:13:51,490 --> 00:13:55,160
‫تويا، أرسلْ لي حالةَ الهدفِ
‫‫والظروفَ المحيطة.

263
00:13:55,830 --> 00:13:57,250
‫سنتحرَّكُ بعدَ يومين.

264
00:13:57,830 --> 00:13:58,960
بعد يومين؟

265
00:13:59,040 --> 00:14:01,380
‫هناك شيء أريد القيام به أولاً.

266
00:14:02,420 --> 00:14:04,420
‫غابة العظماء، هاه؟

267
00:14:04,510 --> 00:14:06,470
!سارق

268
00:14:07,800 --> 00:14:10,050
!أنتَ الذي هُناك، أمسك به

269
00:14:11,850 --> 00:14:14,020
.‫الضوء خافت، لذا يصعب الرؤية

270
00:14:14,520 --> 00:14:17,140
.‫هناك رياح، لذا ستتطاير البتلات بسهولة

271
00:14:17,810 --> 00:14:18,900
‫هل ستتخذ إجراءً؟

272
00:14:19,440 --> 00:14:20,270
‫أجل.

273
00:14:20,360 --> 00:14:21,900
‫لا تضغط على نفسك كثيراً

274
00:14:21,980 --> 00:14:25,360
‫لأنك خضعت للتو
‫‫لإعادة التجسيد.

275
00:14:30,410 --> 00:14:31,450
‫موهبة.

276
00:14:34,040 --> 00:14:35,870
.ذراعُ النهب اليُمنى

277
00:14:37,580 --> 00:14:39,830
!أيها الصعلوك، سأقتُلك

278
00:14:47,720 --> 00:14:48,930
‫شكراً لك.

279
00:14:49,720 --> 00:14:52,970
‫مهلاً، لمَ لم تمسكه؟

280
00:14:53,060 --> 00:14:55,680
.أ-أهدئي رجاءً، لا داعي للقلق

281
00:14:56,140 --> 00:14:57,940
.فلقد استعدتُ كل شيء بالفعل

282
00:14:58,020 --> 00:14:59,350
...ما كان في الداخل

283
00:14:59,440 --> 00:15:00,520
‫شكراً لك...

284
00:15:00,600 --> 00:15:01,980
‫ليس هذا يا أحمق!

285
00:15:02,060 --> 00:15:03,980
‫الحقيبة أهم
‫‫مما بداخلها.

286
00:15:04,070 --> 00:15:05,440
‫إنها حقيبة من ماركة عالمية!

287
00:15:05,530 --> 00:15:07,530
!‫توقف مكانك يا هذا

288
00:15:09,360 --> 00:15:10,950
.المدى 70 سم

289
00:15:11,490 --> 00:15:13,280
‫لا تملك أي قدرات هجومية،

290
00:15:13,700 --> 00:15:16,370
‫واستخدامها غير عملي بتاتاً.

291
00:15:16,450 --> 00:15:18,870
‫لكن طالما أن الهدف داخل المدى،

292
00:15:19,290 --> 00:15:22,920
‫يمكنك تجاهل كل المواد
‫‫وسرقة كل ما بداخلها.

293
00:15:24,290 --> 00:15:26,550
لـ-لحظة، ما الذي يحدث؟

294
00:15:27,130 --> 00:15:30,010
‫عن طريق سرقة الدم،
‫‫تسببت في فقر دم قسري.

295
00:15:30,090 --> 00:15:31,050
‫أحسنت صنعاً.

296
00:15:31,550 --> 00:15:35,350
‫تبديد الأعمال الشريرة،
‫‫‫‫هذا ما يجب أن تُستخدم الموهبة لأجله.

297
00:15:35,430 --> 00:15:37,770
‫المهم ليست الموهبة بحد ذاتها،

298
00:15:38,230 --> 00:15:40,270
‫بل كيفية استخدامك لها، أليس كذلك؟

299
00:15:40,850 --> 00:15:41,850
.أجل

300
00:15:43,310 --> 00:15:44,360
‫ما الوضع؟

301
00:15:44,980 --> 00:15:46,570
‫لم نجد أي أثر للعدو...

302
00:15:49,780 --> 00:15:51,860
‫غابة العظماء؟

303
00:15:52,530 --> 00:15:53,740
‫الأرشيدوق فلاد.

304
00:15:54,200 --> 00:15:55,410
‫بالضبط.

305
00:15:56,620 --> 00:15:59,660
‫لكنهم أرسلوا شخصاً
‫‫واحداً فقط للتعامل معي.

306
00:16:02,210 --> 00:16:03,880
يبدو أنهم

307
00:16:04,630 --> 00:16:07,170
.استهانوا بي حقًا

308
00:16:14,850 --> 00:16:16,560
‫إيبيتسو نيتين ريهو.

309
00:16:20,140 --> 00:16:21,640
‫الجثة ذات الألوان الأربعة!

310
00:16:22,270 --> 00:16:23,850
‫لا فائدة من ذلك.

311
00:16:30,820 --> 00:16:34,280
.‫أود أن أرى كم من الوقت يمكنكِ الصمود

312
00:16:38,910 --> 00:16:40,080
.يا إلهي

313
00:16:40,160 --> 00:16:42,080
‫ناهيك عن عدم تركه حياً
‫‫أو قتله،

314
00:16:42,160 --> 00:16:43,790
‫لا يمكنني حتى الاقتراب منه.

315
00:16:44,370 --> 00:16:45,500
.لا تستعجلي

316
00:16:45,960 --> 00:16:48,090
‫نحن نحلل الأمر الآن.

317
00:16:48,170 --> 00:16:50,130
.لا بأس طالما نحقق هدفنا

318
00:16:51,840 --> 00:16:54,550
.كان ينتظرك هناك طوال الوقت

319
00:16:55,010 --> 00:16:58,850
‫إذا تحركنا الآن،
‫‫فقد نفتح على أنفسنا عش الدبابير.

320
00:16:58,930 --> 00:17:00,560
‫من الأفضل انتظار اللحظة المناسبة.

321
00:17:01,560 --> 00:17:03,770
.تجعلينَ الأمر يبدو سهلًا

322
00:17:04,350 --> 00:17:07,730
‫مراوغة تلك الإبر القادمة
‫‫من كل الاتجاهات باستمرار

323
00:17:07,810 --> 00:17:09,530
‫أمر مرهق

324
00:17:09,610 --> 00:17:11,360
.كما تعلمين

325
00:17:12,110 --> 00:17:13,450
‫ما الذي يحدث؟

326
00:17:13,530 --> 00:17:15,570
‫إنها لا تهاجم على الإطلاق.

327
00:17:18,660 --> 00:17:19,950
‫أسرع يا تويا.

328
00:17:20,540 --> 00:17:22,330
.ربما بسبب طبيعة السيافين

329
00:17:22,960 --> 00:17:25,370
‫هايتو تميل إلى الاستمتاع بالقتال.

330
00:17:25,960 --> 00:17:27,840
‫وبهذا المعدل، فإن هايتو ستـ...

331
00:17:31,090 --> 00:17:33,010
‫إيبيتسو نيتين ريهو.

332
00:17:33,720 --> 00:17:35,510
‫الجثة ذات الألوان الثمانية!

333
00:17:41,100 --> 00:17:43,350
‫هذا النوع من القتال يجعلني عديم الصبر.

334
00:17:44,430 --> 00:17:46,520
.لكنها معركة حول من يمكنهُ الحفاظ على هدوئه

335
00:17:50,070 --> 00:17:52,440
.الاكتفاء بالدفاع دون الهجوم لا يناسب شخصيتي

336
00:17:52,530 --> 00:17:53,780
‫أنا...

337
00:17:53,860 --> 00:17:54,700
!‫توقفي

338
00:17:58,950 --> 00:18:00,660
!كنتُ بانتظارِ هذه اللحظة

339
00:18:07,420 --> 00:18:09,040
.فشلت العملية

340
00:18:10,500 --> 00:18:11,340
‫ما الخطب؟

341
00:18:12,000 --> 00:18:13,210
‫انسحبوا بسرعة!

342
00:18:17,380 --> 00:18:19,550
هل أصابكِ الغرور بموهبتكِ؟

343
00:18:20,850 --> 00:18:22,600
.يا لكِ من حمقاء

344
00:18:25,430 --> 00:18:27,350
‫لقد انتصرتُ.

345
00:18:31,400 --> 00:18:32,570
‫مُحال!

346
00:18:32,650 --> 00:18:34,230
‫ثمةَ جدارٌ خلفي...

347
00:18:34,820 --> 00:18:36,030
‫تلك اليد...

348
00:18:39,660 --> 00:18:42,080
‫انتهت الدقائقُ العشر، لذا فعلتُها.

349
00:18:45,910 --> 00:18:47,040
‫أأجهزَ عليه؟

350
00:18:50,580 --> 00:18:51,710
،يا هذا

351
00:18:51,790 --> 00:18:53,840
‫لم يمضِ على كونِكَ عائداً

352
00:18:53,920 --> 00:18:55,670
‫وقتٌ طويل، أليس كذلك؟

353
00:18:56,760 --> 00:18:59,050
‫لا تزالُ غيرَ معتادٍ على
‫‫استخدامِ مَوْهِبَتِك.

354
00:18:59,720 --> 00:19:02,680
‫إنَّ إهدارَ فرصةٍ ذهبيةٍ كهذهِ
‫‫لإلحاقِ الهزيمةِ بي

355
00:19:02,760 --> 00:19:04,350
.هي قمة الحماقة

356
00:19:04,970 --> 00:19:08,100
‫أحكمُ عليكما بالخَوزَقَة!

357
00:19:08,190 --> 00:19:09,480
‫انسحب.

358
00:19:15,530 --> 00:19:17,280
‫ابقَ ساكناً.

359
00:19:17,360 --> 00:19:19,490
‫إنْ لزمتَ الهدوء، فلن أقتلك.

360
00:19:20,410 --> 00:19:21,700
‫هذا الصوت...

361
00:19:22,660 --> 00:19:23,780
‫انسحب يا فلاد.

362
00:19:23,870 --> 00:19:25,540
...ولـ-لكن

363
00:19:25,620 --> 00:19:27,250
‫كنتُ على وشكِ النيلِ منهم...

364
00:19:27,330 --> 00:19:29,160
‫ألم تسمعْ ما قلتُه؟

365
00:19:30,710 --> 00:19:31,960
‫عُلِم.

366
00:19:32,880 --> 00:19:34,000
.هكذا إذاً

367
00:19:34,500 --> 00:19:35,800
.‫إنهما متشابهان حقًا

368
00:19:39,760 --> 00:19:41,430
‫لقد تحققَ هدفُنا.

369
00:19:42,090 --> 00:19:43,390
‫انسحبوا.

370
00:19:54,400 --> 00:19:55,480
!‫أيها السارق

371
00:19:56,360 --> 00:19:57,530
‫وجدتُك!

372
00:19:58,610 --> 00:19:59,900
‫أعدها إليَّ...

373
00:19:59,990 --> 00:20:01,240
‫أعدها إليَّ حالاً!

374
00:20:01,700 --> 00:20:03,030
‫الأرشيدوق فلاد.

375
00:20:03,490 --> 00:20:04,660
‫ما الأمر؟

376
00:20:05,330 --> 00:20:06,620
‫لا تتظاهر بالغباء!

377
00:20:06,700 --> 00:20:08,750
!أيها السارق الصفيق

378
00:20:08,830 --> 00:20:10,830
‫لقد سرقتَها حينذاك، أليس كذلك؟

379
00:20:10,910 --> 00:20:12,920
‫مَوْهِبَتي!

380
00:20:14,210 --> 00:20:17,500
‫هل أخبرتَ أحداً بهذا؟

381
00:20:17,590 --> 00:20:18,550
‫بالطبعِ لا!

382
00:20:18,630 --> 00:20:21,300
‫كيف لي أنْ أدعَ أحداً يعلمُ
‫‫بأمرِ خزيٍ كهذا؟

383
00:20:21,590 --> 00:20:23,180
‫هذا جيد.

384
00:20:23,890 --> 00:20:24,760
،حسنًا إذاً

385
00:20:25,050 --> 00:20:26,850
‫سأجعلكَ...

386
00:20:38,320 --> 00:20:40,320
‫تختفي.

387
00:20:42,360 --> 00:20:44,160
‫يدُ الاستخدامِ اليُسرى.

388
00:20:51,540 --> 00:20:52,790
،أيها ‫الأرشيدوق فلاد

389
00:20:52,870 --> 00:20:54,750
‫أنا ممتنٌ لك.

390
00:20:56,000 --> 00:20:57,630
‫لا تقلق.

391
00:20:58,250 --> 00:20:59,590
‫سأستخدمُ هذه المَوْهِبَة،

392
00:20:59,670 --> 00:21:02,720
.بشكلٍ أفضلَ منك

393
00:21:03,340 --> 00:21:05,390
‫خدمةُ البشريَّة...

394
00:21:05,470 --> 00:21:07,850
‫لا اهتمامَ لي بذلك.

395
00:21:08,220 --> 00:21:10,520
.فلا علاقة للأمر بي

396
00:21:10,600 --> 00:21:12,980
‫إنْ كانت هناك مَوْهِبَةٌ أبتغيها، فسأسرقُها فحسب.

397
00:21:13,060 --> 00:21:14,900
‫أريدُ مَوْهِبَة.

398
00:21:15,440 --> 00:21:17,650
‫سواءً كانت لعظيمٍ أو لآثم،

399
00:21:17,730 --> 00:21:21,280
‫سأسرقُ وأسرق،

400
00:21:21,360 --> 00:21:22,990
!جميعها

401
00:21:23,070 --> 00:21:25,780
،‫حينما أستولي على كلِّ المواهب

402
00:21:25,860 --> 00:21:30,990
‫سأصبحُ الشخصَ الأكثرَ موهبةً
‫‫على مرِّ التاريخ.

403
00:21:31,330 --> 00:21:34,080
‫سيكونُ ذلك بلا شكٍ دليلاً
‫‫على أنني لحقتُ بأخي...

404
00:21:34,160 --> 00:21:37,920
‫بل إنني قد تفوقتُ عليه.

405
00:21:41,840 --> 00:21:43,170
‫لا يسعني الانتظار.

406
00:21:43,920 --> 00:21:45,630
.لا يسعني الانتظار أبدًا

407
00:21:46,680 --> 00:21:48,510
‫إنَّ مَنْ سيضحكُ أخيراً

408
00:21:48,890 --> 00:21:51,100
‫ليس "عظيماً" ولا "آثماً".

409
00:21:52,660 --> 00:21:54,940
‫بل هو أنا!!

410
00:23:27,360 --> 00:23:28,990
‫تماماً كما توقعت.

411
00:23:30,160 --> 00:23:31,370
‫أتشاهدُ هذا،

412
00:23:33,030 --> 00:23:34,280
‫يا سيا؟

413
00:23:36,080 --> 00:23:38,080
.‫ماهيةُ أنْ تكونَ مالكًا