!ونجعل العالم كلّه ملعبنا

212
00:16:17,390 --> 00:16:21,810
!ذلك سيعني نهاية كلّ البشريّة

213
00:16:21,980 --> 00:16:23,640
وماذا يعني؟

214
00:16:23,810 --> 00:16:25,940
كلّ ما يهمّ هو أن أستمتع

215
00:16:26,110 --> 00:16:28,570
!انتهى أمرك وأمر ذلك البشريّ

216
00:16:49,840 --> 00:16:50,840
عزيزي

217
00:16:51,300 --> 00:16:53,050
تيتيسمون-ساما

218
00:16:53,760 --> 00:16:55,090
هل تتذكّر؟

219
00:16:55,590 --> 00:16:59,810
كيف استمتعتُ باستخدام الطلسم خاصّتك

220
00:17:00,600 --> 00:17:03,810
كانت كارثة

221
00:17:04,270 --> 00:17:06,810
لم تكن المرّة الوحيدة

222
00:17:07,270 --> 00:17:11,980
لا تنسي غِمار أزهار الكرز الّذي قمتِ به

223
00:17:13,530 --> 00:17:15,200
كان تحدّياً حقيقيّاً

224
00:17:15,660 --> 00:17:18,450
!على ذكر التحدّيات

225
00:17:19,080 --> 00:17:20,450
نهر ستيكس

226
00:17:20,620 --> 00:17:24,410
خيال البشر إبداعيّ للغاية

227
00:17:24,580 --> 00:17:28,670
أنقذتنا في اللّحظة الأخيرة

228
00:17:30,920 --> 00:17:32,300
كان ذلك مُخيفاً

229
00:17:33,380 --> 00:17:35,090
وخطيراً

230
00:17:37,260 --> 00:17:41,680
لكن ممتعاً أيضاً

231
00:17:42,310 --> 00:17:46,060
،أنت وجميع البشر

232
00:17:46,230 --> 00:17:48,190
تجعلون هذا العالم ممتعاً

233
00:17:48,650 --> 00:17:52,360
أظنّني أحبّ البشر

234
00:17:53,150 --> 00:17:54,650
أمانوكاوا-كن

235
00:17:54,820 --> 00:17:56,110
تسوكيونو-سان

236
00:17:56,280 --> 00:17:57,660
مُقيمو مسكني الدّراسي

237
00:17:58,240 --> 00:18:02,160
هل أحبّ النّاس أيضاً

238
00:18:02,330 --> 00:18:04,660
...كلّ النّاس الّذين نحبّهم

239
00:18:05,120 --> 00:18:06,660
!سوف نحميهم

240
00:18:12,420 --> 00:18:15,630
!تطوّر تيتيسمون الهائل

241
00:18:35,030 --> 00:18:36,490
!أمفيمون

242
00:18:38,610 --> 00:18:40,660
!آمبري-ديفيندر

243
00:18:59,260 --> 00:19:01,550
!مرحباً يا كتيلامون

244
00:19:01,720 --> 00:19:03,470
!كلّ شيء يتوقّف هنا

245
00:19:04,640 --> 00:19:06,470
!جحيم المُحيط

246
00:19:06,640 --> 00:19:08,480
!زامبر المائي

247
00:19:15,270 --> 00:19:16,730
!فورة باكّال

248
00:19:18,030 --> 00:19:21,860
!البشر هم من يجعلون هذا العالم مُمتعاً

249
00:19:25,030 --> 00:19:26,990
!المِطحنة المائيّة

250
00:19:28,120 --> 00:19:31,000
!يحتاج هذا العالم للبشر

251
00:19:31,170 --> 00:19:34,840
!رايبانغ الكاسر

252
00:19:50,230 --> 00:19:52,770
هل تعلّمت درسك؟

253
00:19:54,020 --> 00:19:55,610
أنتم فظيعون

254
00:19:55,770 --> 00:20:00,110
!أردتُ فقط أن أجعل هذا العالم ملعبي

255
00:20:01,490 --> 00:20:03,780
لا تبكي

256
00:20:03,950 --> 00:20:07,740
!ستستمتع كثيراً إذا تعلّمت أن تحبّ البشر

257
00:20:07,910 --> 00:20:10,370
نعم، لنفعل ذلك! اتّفقنا؟

258
00:20:10,540 --> 00:20:11,960
حـ-حسناً

259
00:20:12,420 --> 00:20:16,710
!حسناً، لنُعد الجميع والمدينة أيضاً

260
00:20:26,430 --> 00:20:28,470
إلى اللّقاء، سأذهب للّعب

261
00:20:28,640 --> 00:20:30,810
اعتمدوا عليّ وعلى عزيزي

262
00:20:30,980 --> 00:20:33,140
!سنأكل بطلي

263
00:20:33,310 --> 00:20:38,360
هل تعرفون أيّ شيء عن الشّخص
الّذي أرسلكم إلى هذا العالم؟

264
00:20:38,520 --> 00:20:40,650
لا، لا أعرف

265
00:20:40,820 --> 00:20:42,240
ماذا يقصد؟

266
00:20:42,400 --> 00:20:43,530
هكذا إذاً

267
00:20:43,990 --> 00:20:46,780
!لا تتجفّف ثانية

268
00:20:48,200 --> 00:20:49,410
فعلتُها

269
00:20:49,580 --> 00:20:52,080
أنقذت العالم يا سينباي

270
00:20:52,250 --> 00:20:53,580
ماذا تفعل؟

271
00:20:53,750 --> 00:20:55,920
!ستفوتنا جلسة التّصوير إذا لم نسرع

272
00:20:56,080 --> 00:20:59,170
!مهلكِ يا جيليمون-ساما

273
00:21:00,170 --> 00:21:04,130
هنا عند البحر، الأحمر والأبيض
يتألّقان تحت أشعّة الشّمس

274
00:21:09,310 --> 00:21:12,810
الاثنتان حسناوتان معاً

275
00:22:17,250 --> 00:22:19,540
!ملفّ دراسة هيرو

276
00:22:20,420 --> 00:22:21,170
كتيلامون

277
00:22:20,420 --> 00:22:25,880
المستوى: هائل

278
00:22:21,340 --> 00:22:27,220
يُدعى أحياناً بشبح المُحيط بسبب
الجمجمة الّتي في صدره

279
00:22:26,090 --> 00:22:31,510
الحركة الخاصّة: فورة باكّال
جحيم المُحيط \ المِطحنة المائيّة

280
00:22:27,380 --> 00:22:29,090
،في ليلة الأوبون

281
00:22:29,260 --> 00:22:31,510
تمتدّ أيادٍ كثيرة من الأمواج

282
00:22:31,680 --> 00:22:34,520
"!لتصرخ، "أعطني مِجرفة

283
00:22:31,680 --> 00:22:38,350
النّوع: جنّي

284
00:22:34,680 --> 00:22:40,310
إذا أعطيت يداً مِجرفة، فإنّها تغرف الماء
!إلى قاربك حتّى يفيض ويغرق

285
00:22:38,520 --> 00:22:45,230
الخاصّية: فيروس

286
00:22:40,480 --> 00:22:45,230
!المُحيط الوحيد الّذي أقترب منه هو على الإنترنت

287
00:22:46,900 --> 00:22:51,620
كنت تعلم أنّ هذا مُحرّم

288
00:22:51,780 --> 00:22:54,080
لكن تريد أن تكونوا معاً مرّة أخرى

289
00:22:54,240 --> 00:22:56,450
تريدهم أن يتلفّظوا باسمك

290
00:22:56,950 --> 00:23:00,460
لهذا تتعلّق بهم

291
00:23:01,130 --> 00:23:03,630
حتّى لو عاديتَ العالم كلّه

292
00:23:03,790 --> 00:23:10,050
لا أستطيع تخيّل اليأس الّذي ينتظرك

293
00:23:10,220 --> 00:23:13,890
الحلقة القادمة من الدّيجيمون لعبة الشّبح
"انبعاث"