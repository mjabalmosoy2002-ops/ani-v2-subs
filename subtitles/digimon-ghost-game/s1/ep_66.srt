1
00:01:43,270 --> 00:01:46,440
منطقة الموت السّوداء

2
00:01:49,400 --> 00:01:50,810
!لا جدوى

3
00:01:50,980 --> 00:01:54,190
!لا ينجح أيّ اختراق معي

4
00:01:55,570 --> 00:02:00,740
،قطعنا كلّ هذه المسافة إلى عالم البشر
!لكنّه مُظلم جدّاً فلا يمكن الرّؤية

5
00:02:00,910 --> 00:02:02,870
بئساً، كدتُ أنسى

6
00:02:05,910 --> 00:02:07,330
...المعذرة

7
00:02:07,500 --> 00:02:09,710
تيريرمون، صحيح؟

8
00:02:09,880 --> 00:02:11,630
!أنا مساعد هوكتو

9
00:02:11,790 --> 00:02:14,050
...لكن لم أسأل أبداً

10
00:02:14,710 --> 00:02:15,960
كلّ شيء طبيعي

11
00:02:16,130 --> 00:02:18,970
أنتم أنواع بشريّة سليمة صحّياً

12
00:02:19,550 --> 00:02:21,350
!هوكتو سليم صحّياً

13
00:02:22,010 --> 00:02:23,640
ما زلت ترتدي هذا؟

14
00:02:24,350 --> 00:02:26,430
انظر، هذا كمّي

15
00:02:26,600 --> 00:02:28,190
كمّ

16
00:02:29,230 --> 00:02:30,400
أبي

17
00:02:31,810 --> 00:02:34,150
لديّ أسئلة كثيرة

18
00:02:35,280 --> 00:02:41,410
لطخة سوداء كشيء كان ينتشر
في الأيّام القليلة الماضية

19
00:02:42,030 --> 00:02:44,790
تزداد الأشياء سواداً أكثر فأكثر

20
00:02:44,950 --> 00:02:49,540
ثمّ عندما يذوب الشّيء الأسود اللّاصق
،عليك، تنتشر اللّطخة

21
00:02:49,710 --> 00:02:52,420
سواء كنت ديجيموناً أم نباتاً

22
00:02:53,170 --> 00:02:57,050
!رأيتُ المحيط والأنهار تتحوّل إلى لون أسود أيضاً

23
00:02:57,210 --> 00:03:03,800
وعندما يصبح الدّيجيمون أسود، فإنّه
!يهاجم الدّيجيمونات الأخرى هكذا

24
00:03:03,970 --> 00:03:07,720
مثل داغومون ذاك تماماً

25
00:03:08,980 --> 00:03:11,270
...لهذا أتت الدّيجيمونات إلى هنا إذاً

26
00:03:11,440 --> 00:03:14,150
يبدو أنّني أُرسِلتُ إلى الدّيار أيضاً

27
00:03:15,730 --> 00:03:19,650
لا أستطيع الشّعور بالعالم الرّقمي

28
00:03:20,240 --> 00:03:24,530
هل فقدنا منزلنا؟

29
00:03:26,080 --> 00:03:29,120
مُحال أن نعرف فوراً

30
00:03:29,620 --> 00:03:34,540
كنّا لنتمكّن من إيجاد بوّابة إذا
أخلى مزيد من الدّيجيمون إلى هنا

31
00:03:34,710 --> 00:03:38,800
لنفترض أنّكم استطعتم العودة، ماذا لو
أصِبتُم بالصدأ الأسود؟

32
00:03:39,880 --> 00:03:41,510
الصدأ

33
00:04:13,210 --> 00:04:14,960
لا تستطيع النّوم؟

34
00:04:16,540 --> 00:04:17,880
ليس تماماً

35
00:04:18,040 --> 00:04:20,960
لا ألومك بعد كلّ ما جرى

36
00:04:28,260 --> 00:04:29,720
أجل

37
00:04:33,270 --> 00:04:35,850
تمّ استعادة الطاقة الكهربائيّة بشكل مؤقّت

38
00:04:36,020 --> 00:04:40,650
بإعادة إقلاع نظام قديم بعد انقطاع تيّار
وقع في اللّيلة الماضية

39
00:04:38,230 --> 00:04:41,360
إلغاء رحلة القطار

40
00:04:40,820 --> 00:04:46,570
في هذه الأثناء، نظُم الاتّصالات الرّقميّة  العالميّة
بما في ذلك الإنترنت بقيت مُعطّلة

41
00:04:46,740 --> 00:04:52,250
وتستمرّ الكمبيوترات والهواتف الذكيّة
وأجهزة الإنترنت غير قابلة للاستخدام

42
00:04:52,410 --> 00:04:53,580
!إيما

43
00:04:53,750 --> 00:04:57,460
لا أعلم ما إن كنتِ تمزحين
!لأنّني لا أرى وجهكِ

44
00:04:57,630 --> 00:04:58,750
!أنا جادّة

45
00:04:58,920 --> 00:05:01,630
!هناك أشباح هولوغراميّة في كلّ مكان

46
00:05:01,800 --> 00:05:03,260
!لا نستطيع أن نخبئها بعد الآن

47
00:05:06,550 --> 00:05:13,560
تمّ تسجيل مُشاهدات لمخلوقات غامضة
أيضاً في كلّ أنحاء العالم

48
00:05:14,180 --> 00:05:19,650
نبثّ حاليّاً بشكل تناظريّ باعتبار أنّ
الاتّصالات الرّقميّة ما زالت مُعطّلة

49
00:05:20,360 --> 00:05:22,360
لماذا لديك هذا إلى الآن؟

50
00:05:22,530 --> 00:05:24,650
صنعتُه لأجل نادي الالكترونيّات الخاص بنا

51
00:05:24,820 --> 00:05:27,160
ممنوع الاقتراب

52
00:05:27,320 --> 00:05:29,910
هل هذه ليرورون حقّاً؟

53
00:05:30,080 --> 00:05:33,910
لماذا تتواجد فتاة ظريفة مثلها مع هيرو
وقائد المسكن الدّراسي؟

54
00:05:34,080 --> 00:05:36,920
طريقة لِلقاء بلاكتيلمون؟

55
00:05:37,080 --> 00:05:38,790
لديّ أسئلة

56
00:05:39,420 --> 00:05:41,550
ماذا حلّ بالعالم الرّقميّ؟

57
00:05:41,710 --> 00:05:44,420
هل من شيء يمكننا فعله؟

58
00:05:44,590 --> 00:05:47,430
هل يمكننا فتح بوّابة الآن؟

59
00:05:48,550 --> 00:05:50,100
هكذا إذاً

60
00:05:50,550 --> 00:05:53,430
يمكننا في الواقع فتح البوّابة بأنفسنا

61
00:05:54,640 --> 00:05:56,890
،أخبرني بلاكتيلمون

62
00:05:57,060 --> 00:06:01,440
تمتلك الأجهزة الرقميّة وظيفة فتح البوّابات

63
00:06:02,110 --> 00:06:03,690
حسناً، هذا يحلُّ المُشكلة

64
00:06:03,860 --> 00:06:04,570
--حسناً، كيف

65
00:06:04,730 --> 00:06:05,740
!مهلاً

66
00:06:05,900 --> 00:06:07,950
!تذكّروا ما قاله البروفسور بوكومون

67
00:06:08,450 --> 00:06:15,120
البشر الّذين يعبرون البوّابة قد يحترقون
عندما تترقمن أجسامهم

68
00:06:16,330 --> 00:06:19,290
هذا صحيح. كيف ما زلت بخير؟

69
00:06:19,460 --> 00:06:23,670
في حالتي، تعطّلَ جهازي الرّقمي
ونقلَ الفضاء حولي آنيّاً

70
00:06:23,840 --> 00:06:26,920
يمكنك العبور إذا كنت رفقة ديجيمون

71
00:06:27,090 --> 00:06:30,800
كان البروفسور بوكومون يكذب بشأن الاحتراق

72
00:06:30,970 --> 00:06:33,560
أخبرني البروفسور ألّا أروي الحقيقة لأحد

73
00:06:34,640 --> 00:06:37,100
هذا مُبكّر جدّاً

74
00:06:37,270 --> 00:06:42,690
سيحين الوقت حالما يدركون المزيد عن الدّيجيمون

75
00:06:42,860 --> 00:06:44,900
سيترتّب علينا الانتظار إلى ذلك الحين

76
00:06:48,150 --> 00:06:49,900
هكذا إذاً

77
00:06:53,950 --> 00:06:58,710
أنا متأكد بأنّ الوقت الّذي كان يشير
إليه البروفسور بوكومون قد حان

78
00:06:59,870 --> 00:07:01,080
أتّفق

79
00:07:02,750 --> 00:07:06,300
قد أجد ما كنتُ أبحث عنه في العالم الرّقمي

80
00:07:07,050 --> 00:07:09,550
أعِدُ أن أحميكِ

81
00:07:10,130 --> 00:07:12,180
!أنا قادم أيضاً

82
00:07:13,800 --> 00:07:18,850
لا يمكنني العيش في عالم تناظريّ

83
00:07:19,020 --> 00:07:22,060
بلا ألعاب فيديو أو أنمي

84
00:07:22,230 --> 00:07:24,690
تماماً يا عزيزي

85
00:07:27,820 --> 00:07:28,860
...لكن

86
00:07:29,360 --> 00:07:31,990
من دون القدرة على استخدام أجهزة رقميّة

87
00:07:32,160 --> 00:07:35,740
،أو حتّى الإحساس بالعالم الرّقمي

88
00:07:35,910 --> 00:07:37,740
هل يمكننا حقّاً فتح بوّابة؟

89
00:07:37,910 --> 00:07:39,500
دعوا الأمر لي

90
00:07:40,910 --> 00:07:42,500
!كوزوهامون

91
00:07:48,420 --> 00:07:52,880
،سأفتح فتحة نحو العالم الرّقمي بسحري

92
00:07:53,050 --> 00:07:55,050
حينئذ يمكنكم فتح بوّابة

93
00:07:55,220 --> 00:07:56,760
!سيتطلّب هذا جهداً

94
00:07:56,930 --> 00:08:03,020
عندما نصل إلى هناك، أودّ أن ألتقي
بالصّوت الّذي يرسل الدّيجيمونات إلى هنا

95
00:08:03,520 --> 00:08:05,770
مع الأسف، لا أعرف مصدره

96
00:08:05,940 --> 00:08:08,780
هل تقصد غابة المُجمِّع؟

97
00:08:09,480 --> 00:08:11,740
أعرف الإحداثيّات

98
00:08:12,490 --> 00:08:14,030
حسناً إذاً يا رولي-تشان

99
00:08:14,200 --> 00:08:17,240
ستشعرين بحرّ شديد وأنتِ ترتدين هذا هناك

100
00:08:22,000 --> 00:08:22,910
حسناً

101
00:08:23,080 --> 00:08:24,870
هل أنتم جاهزون؟

102
00:08:25,040 --> 00:08:26,790
!جاهزون في أيّ وقت

103
00:08:26,960 --> 00:08:28,670
!من فضلك يا كازوهامون

104
00:08:29,670 --> 00:08:30,420
!هيّا بنا

105
00:08:47,610 --> 00:08:49,940
!افعلوا ما أمليه عليكم جميعاً

106
00:09:02,870 --> 00:09:03,710
!فُتِحت

107
00:09:05,170 --> 00:09:06,920
!لا أستطيع تثبيتها فترة طويلة، بسرعة

108
00:09:07,080 --> 00:09:08,210
!أجل

109
00:09:12,380 --> 00:09:13,840
!دورنا

110
00:09:14,010 --> 00:09:14,720
!أجل

111
00:09:20,720 --> 00:09:23,220
!أعتذر، هذه هي حدودي

112
00:09:26,100 --> 00:09:27,230
هيرو

113
00:09:31,190 --> 00:09:32,230
حسناً

114
00:09:32,780 --> 00:09:35,320
جميعكم، من يريد بعض العصير؟

115
00:09:35,860 --> 00:09:39,030
!ذلك الماء الحلو البارد؟ مرحى

116
00:09:42,290 --> 00:09:43,750
مرحباً

117
00:09:52,250 --> 00:09:54,340
ماذا؟ أين أبي؟

118
00:09:54,510 --> 00:09:56,670
ألم يصل في الوقت؟

119
00:09:57,300 --> 00:09:58,930
!لا

120
00:10:00,510 --> 00:10:04,600
...غابة المُجمّع الجميلة في الماضي

121
00:10:09,400 --> 00:10:13,150
هذا هو العالم الرقمي إذاً

122
00:10:24,330 --> 00:10:27,330
أجل، يبدو وكأنّ هذا هو العالم الرّقمي

123
00:10:30,830 --> 00:10:32,380
!طعامنا

124
00:10:32,540 --> 00:10:34,420
!علينا الهرب

125
00:10:38,170 --> 00:10:38,880
!رائحة كريهة

126
00:10:39,050 --> 00:10:40,430
!عزيزي، بسرعة

127
00:10:47,100 --> 00:10:52,060
!براكيمون الكسول في العادة عنيف جدّاً

128
00:10:52,230 --> 00:10:57,190
من غير المعقول أيضاً رؤية كواغامون
متدنّي الرّتبة يهاجم براكيمون

129
00:10:58,400 --> 00:11:01,160
هذا هو الصدأ الأسود إذاً

130
00:11:02,370 --> 00:11:06,660
قد يكون العالم الرّقمي في خطر أكبر ممّا توقّعنا

131
00:11:07,160 --> 00:11:08,200
أجل

132
00:11:21,550 --> 00:11:25,140
...إذاً هناك قرية أمامنا؟ حيث يمكننا اللّقاء

133
00:11:25,560 --> 00:11:27,180
كوكابوتيريمون

134
00:11:27,850 --> 00:11:30,440
هل تعتقد بأنّهم بخير؟

135
00:11:31,350 --> 00:11:32,730
لا أعلم

136
00:11:33,150 --> 00:11:37,400
لكن هذا هو المكان الوحيد الّذي
سنجد فيه أيّ أدلّة

137
00:11:38,480 --> 00:11:39,900
ما الخطب يا عزيزي؟

138
00:11:40,860 --> 00:11:43,910
هل لدينا ماء؟

139
00:11:44,820 --> 00:11:46,910
أعتذر، سُحِقَ قبل قليل

140
00:11:47,490 --> 00:11:50,540
هل يمكننا البحث عن نبع إذاً؟

141
00:11:50,710 --> 00:11:53,120
ما زالت القرية بعيدة

142
00:11:53,290 --> 00:11:54,130
هيرو

143
00:11:55,290 --> 00:11:56,630
سنحتاج ماء

144
00:11:56,790 --> 00:11:57,920
لنذهب ونبحث

145
00:11:59,460 --> 00:12:00,800
تيسلاجيليمون-ساما

146
00:12:02,050 --> 00:12:05,970
ألم يبدُ وكأنّه كان يوجد ماء هنا؟

147
00:12:06,140 --> 00:12:07,310
حقّاً؟

148
00:12:08,140 --> 00:12:09,390
من هنا؟

149
00:12:10,270 --> 00:12:11,810
هذا ما أظنّه

150
00:12:12,600 --> 00:12:14,150
رائحة غريبة

151
00:12:14,310 --> 00:12:15,810
لا أشتمّ أيّ شيء

152
00:12:16,610 --> 00:12:18,690
فقط بين تلك الأجمة

153
00:12:24,030 --> 00:12:25,280
هل من شيء؟

154
00:12:26,410 --> 00:12:28,700
لا أشعر بأيّ ماء

155
00:12:29,240 --> 00:12:30,660
ها أنتما

156
00:12:30,830 --> 00:12:32,250
هيغاتشي

157
00:12:32,410 --> 00:12:34,460
هل تعافيت بما يكفي للمشي؟

158
00:12:34,620 --> 00:12:35,710
أجل

159
00:12:36,670 --> 00:12:38,710
أشعر بحالٍ أفضل

160
00:12:39,500 --> 00:12:40,460
هل وجدت بعضاً؟

161
00:12:40,630 --> 00:12:41,460
أين؟

162
00:12:41,630 --> 00:12:44,760
!من هنا، تعالوا معي

163
00:12:44,930 --> 00:12:47,470
ما خطب يدك؟

164
00:12:51,140 --> 00:12:52,980
لا شيء إطلاقاً

165
00:12:53,430 --> 00:12:57,440
أنا مندهش من قدرتك على إيجاده
بينما لم تكن على ما يُرام

166
00:12:57,610 --> 00:12:58,980
هذا بسيط

167
00:12:59,150 --> 00:13:01,480
إنّه بين تلك الأجمة

168
00:13:01,650 --> 00:13:03,240
انتظري هنا يا ارولي

169
00:13:05,570 --> 00:13:07,120
!عودي يا رولي

170
00:13:13,200 --> 00:13:13,960
هل كانت رولي؟

171
00:13:14,120 --> 00:13:15,000
!من هنا

172
00:13:15,160 --> 00:13:17,000
!مهلاً

173
00:13:18,330 --> 00:13:19,500
!رولي

174
00:13:20,460 --> 00:13:21,800
!سينباي؟

175
00:13:28,300 --> 00:13:29,260
!معقول؟

176
00:13:30,180 --> 00:13:32,310
!هيّا جميعاً

177
00:13:32,680 --> 00:13:37,520
!لنصبح واحداً ونكتسب حياة خالدة معاً

178
00:13:43,110 --> 00:13:44,150
...هذا

179
00:13:46,320 --> 00:13:47,860
!تيسلاجيليمون أيضاً

180
00:13:48,660 --> 00:13:50,240
هناك رائحة قويّة

181
00:13:53,040 --> 00:13:54,910
،خدَمي

182
00:13:55,080 --> 00:13:59,670
أبليتم بلاء حسناً بإحضار القربان الجديد لي

183
00:14:01,630 --> 00:14:03,920
رافليشيمون-ساما

184
00:14:04,090 --> 00:14:06,220
كنتُ أخشى هذا

185
00:14:06,380 --> 00:14:12,180
كان النّبيل رافليشيمون سرعان ما يذبل بعد التفتّح

186
00:14:12,350 --> 00:14:15,520
هل الصدأ الأسود هو سبب هذا كذلك؟

187
00:14:18,100 --> 00:14:20,560
!وُلِدتُ من جديد

188
00:14:20,730 --> 00:14:21,900
!ويسيلين

189
00:14:29,820 --> 00:14:31,700
...رولي

190
00:14:50,640 --> 00:14:54,890
!متّعوا أنظاركم بقوّة الظّلام هذه

191
00:14:55,310 --> 00:14:58,020
أنا قادرة على تمديد وقت المجد الخاص بي للأبد

192
00:14:58,180 --> 00:15:02,560
!وذلك بتحويل الحياة إلى زهور والتهامها

193
00:15:02,980 --> 00:15:08,740
ينبغي أن ينالكم الشّرف لأنّكم تصبحون واحداً معي

194
00:15:09,200 --> 00:15:11,070
!لن أدعكِ

195
00:15:11,700 --> 00:15:14,990
!تطوّر بيتيلغامّامون الخارق

196
00:15:21,670 --> 00:15:23,880
!كانويسمون

197
00:15:26,130 --> 00:15:29,380
!تطوّر كانويسمون الهائل

198
00:15:48,820 --> 00:15:50,240
!سيريوسمون

199
00:15:53,700 --> 00:15:55,530
!والآن، ابصقي الجميع

200
00:15:55,700 --> 00:15:57,620
كم هذا قبيح

201
00:15:57,790 --> 00:16:01,080
مع من تعتقد نفسك تتكلّم؟

202
00:16:01,250 --> 00:16:02,540
!مُسدّس الباليه

203
00:16:09,920 --> 00:16:10,800
!هذا سيّئ

204
00:16:10,970 --> 00:16:11,840
!إنّه لا يتوقّف

205
00:16:12,010 --> 00:16:13,050
!هيرو

206
00:16:20,850 --> 00:16:21,560
!يا للهول

207
00:16:21,730 --> 00:16:22,440
!هيرو

208
00:16:24,480 --> 00:16:30,740
هل أنت من يرسل الدّيجيمون إلى عالم البشر؟

209
00:16:31,490 --> 00:16:33,450
عمّاذا تتكلّم؟

210
00:16:35,620 --> 00:16:36,950
!هيرو

211
00:16:51,460 --> 00:16:55,970
سوف تصبح واحداً معي كذلك

212
00:16:57,350 --> 00:16:59,350
عليّ إنقاذ الجميع

213
00:16:59,510 --> 00:17:01,220
لكن كيف؟

214
00:17:10,780 --> 00:17:11,860
أنت

215
00:17:12,990 --> 00:17:13,860
من قال ذلك؟

216
00:17:14,030 --> 00:17:16,320
،لو كنتُ أنا

217
00:17:16,490 --> 00:17:20,870
لتمكّنتُ من إنقاذ الجميع بمن في ذلك أنت

218
00:17:21,040 --> 00:17:21,870
!ماذا؟

219
00:17:24,290 --> 00:17:25,870
أنت أخوه، صحيح؟

220
00:17:26,370 --> 00:17:30,170
عليك أن تكون قادراً على حمايته

221
00:17:32,670 --> 00:17:34,420
مسكين

222
00:17:34,590 --> 00:17:38,140
هل الخوف دفعك إلى الهلوسة

223
00:17:39,970 --> 00:17:41,640
معك حقّ

224
00:17:43,140 --> 00:17:44,520
انتهى الأمر

225
00:17:59,820 --> 00:18:04,620
!لم أشعر بمثل هذه القوّة تنبع من ديجيمون من قبل

226
00:18:04,790 --> 00:18:10,130
!سالتهم بقيّة الدّيجيمون وأعيش للأبد

227
00:18:12,920 --> 00:18:14,130
ما هذا؟

228
00:18:14,300 --> 00:18:18,260
!لا يستطيع جسدي تحمّل ذلك

229
00:18:40,530 --> 00:18:43,240
لم أتوقّع أن يفلح ذلك

230
00:18:45,120 --> 00:18:46,870
ما أنت؟

231
00:18:47,540 --> 00:18:48,960
!ما هذا؟

232
00:18:52,250 --> 00:18:53,340
...مستحيل

233
00:18:55,340 --> 00:19:01,590
!أردتُ فقط العيش للأبد! أن أكون آخر المُتبقّيين

234
00:19:11,850 --> 00:19:13,480
ماذا؟

235
00:19:15,900 --> 00:19:16,980
لماذا؟

236
00:19:17,150 --> 00:19:18,900
لماذا أشعر نفسي دبِقاً؟

237
00:19:19,240 --> 00:19:21,990
!إنّه كوكابوتيريمون

238
00:19:22,990 --> 00:19:26,200
يسرّني أنّكم بخير جميعاً

239
00:19:28,870 --> 00:19:32,170
ماذا كان ذلك الصّوت؟

240
00:19:34,130 --> 00:19:37,380
لا أعلم ما إن كان الصّوت الّذي تبحثون عنه

241
00:19:37,550 --> 00:19:40,630
،لكن بعد هذه الغابة بكثير

242
00:19:40,800 --> 00:19:44,720
هناك غيمة لا تتحرّك مهما كانت شدّة الرّياح

243
00:19:44,890 --> 00:19:49,640
يُقال أنّه عندما تقترب، يمكنك سماع
صوت جميل داخل رأسك

244
00:19:50,230 --> 00:19:51,850
ها قد التقينا من جديد إذاً

245
00:19:52,020 --> 00:19:53,810
أين داركليزامون؟

246
00:19:54,310 --> 00:19:56,650
أُسقِطَ بواسطة الشيء الأسود

247
00:19:58,070 --> 00:19:59,860
هل أنت جادّ؟

248
00:20:04,820 --> 00:20:07,660
...لا أصدّق بأنّ ذلك المكان قد بقي

249
00:20:07,830 --> 00:20:08,950
!هيّا بنا

250
00:20:09,120 --> 00:20:10,160
!أجل

251
00:20:32,980 --> 00:20:34,400
مُذهل

252
00:20:34,980 --> 00:20:36,150
!هيّا بنا

253
00:20:44,610 --> 00:20:50,450
الصّوت الّذي كان يرسل الدّيجيمون إلى عالمنا هنا؟

254
00:21:10,310 --> 00:21:14,730
لا أحد يمكنه عبور هذه النقطة

255
00:22:17,290 --> 00:22:19,460
!ملفّات دراسة هيرو

256
00:22:20,080 --> 00:22:20,920
رافليشيمون

257
00:22:20,080 --> 00:22:26,800
المستوى: هائل

258
00:22:21,090 --> 00:22:24,670
تعيش لأيّام قليلة فقط، تُعرَف هذا
"الدّيجيمون باسم "الزّهرة المعجزة

259
00:22:24,840 --> 00:22:26,800
لها رائحة لاذعة أيضاً

260
00:22:26,970 --> 00:22:29,130
هناك زهرة تُدعى رافليشيا

261
00:22:26,970 --> 00:22:34,560
الحركة الخاصّة: مُسدّس باليت \ ويسيلين

262
00:22:29,300 --> 00:22:30,800
إنّه نبات طُفيليّ

263
00:22:30,970 --> 00:22:34,560
،سيتجذّر داخل جسد حيّ

264
00:22:34,720 --> 00:22:38,520
وأحياناً يسيطر على المُضيف لمساعدة نفسه على النموّ

265
00:22:34,720 --> 00:22:41,110
النّوع: جنّية

266
00:22:39,230 --> 00:22:41,110
!هيغاتشي، يوجد بتلة في عنقك

267
00:22:41,270 --> 00:22:42,480
!ليس ثانية

268
00:22:41,270 --> 00:22:45,110
الخاصّية: بيانات

269
00:22:42,650 --> 00:22:45,110
!النّجدة يا سيريوسمون

270
00:22:46,610 --> 00:22:48,280
،ينشر جذوره حولك

271
00:22:48,450 --> 00:22:51,030
يقيّدك ويفرّغك من مكوّناتك الغذائيّة

272
00:22:51,530 --> 00:22:53,740
كم هذا مُرعب

273
00:22:53,910 --> 00:22:56,040
،من دون وجود خيارات أخرى أمامك

274
00:22:56,200 --> 00:22:59,040
قد تعبر خطّاً لا يجب عليك عبوره

275
00:22:59,210 --> 00:23:01,500
من أجل النّجاة

276
00:23:02,130 --> 00:23:04,170
يا للسخرية

277
00:23:04,340 --> 00:23:08,760
الخوف يجلب خوفاً أعظم

278
00:23:08,920 --> 00:23:14,260
الحلقة القادمة من الدّيجيمون لعبة الشّبح
"تنّين الدّمار الأسود"