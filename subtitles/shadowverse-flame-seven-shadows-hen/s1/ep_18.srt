1
00:00:04,930 --> 00:00:06,910
ميكادو شيروغاني

2
00:00:06,910 --> 00:00:13,230
أنت رئيس كلّية شادوفارس باتل ولاعبها الأقوى

3
00:00:13,230 --> 00:00:16,980
ولستُ مهتمّاً بك إطلاقاً

4
00:00:16,980 --> 00:00:18,500
لماذا برأيك؟

5
00:00:18,500 --> 00:00:19,970
لا أعلم

6
00:00:19,970 --> 00:00:22,500
إذاً سوف أخبرك في هذه المعركة

7
00:00:23,730 --> 00:00:25,980
!قِتال! شادوفارس

8
00:00:27,020 --> 00:00:27,810
سيّدتي

9
00:00:28,210 --> 00:00:29,530
تقريرك

10
00:00:29,530 --> 00:00:30,550
عُلِم

11
00:00:30,550 --> 00:00:32,700
يستمرّ الآرك في التّناغم

12
00:00:38,440 --> 00:00:39,730
هكذا إذاً

13
00:00:39,730 --> 00:00:40,680
هل هناك مُشكلة؟

14
00:00:42,240 --> 00:00:45,190
الظّلال السّبعة قد حقّقوا أربعة انتصارات بالفعل

15
00:00:45,620 --> 00:00:50,020
من المُحتمَل أن تكون هذه المعركة هي الأخيرة

16
00:00:53,060 --> 00:00:55,600
!عاد الاتّصال إلى نِظام مُراقبة منطِقة الظلّ

17
00:00:59,100 --> 00:01:01,870
استمرّوا في مُراقبة الوضع

18
00:01:01,870 --> 00:01:02,680
حاضر

19
00:02:34,900 --> 00:02:38,000
"وداعاً يا ميكادو شيروغاني"

20
00:02:39,750 --> 00:02:42,050
!دوري. سحب

21
00:02:44,130 --> 00:02:47,120
!ألعب ببطاقة التّميمة، نبع الملائكة

22
00:02:49,520 --> 00:02:52,030
تميمة عدّ تنازلي من فئة مُحايد؟

23
00:02:52,640 --> 00:02:57,370
تُستخدَم البطاقات المُحايدة عادةً بالاقتراب
مع فئة أخرى، أليس كذلك؟

24
00:02:57,790 --> 00:03:02,110
لكن مجموعة بطاقاتك مؤلّفة بالكامل
من بِطاقات فئة المُحايد

25
00:03:02,500 --> 00:03:05,520
في البداية، شوّشَني هذا كثيراً

26
00:03:05,750 --> 00:03:09,950
إمّا أنّك لا تُبالي لشادوفارس أو أنّك
"ظننتَ أنّ هذا يُبقي الأمور "مُنصِفة

27
00:03:11,290 --> 00:03:12,860
طرحتُ نظريّات عديدة مختلفة

28
00:03:23,260 --> 00:03:25,890
لكن بعد رؤيتك تُقاتله، كشفتُ الأمر

29
00:03:26,290 --> 00:03:30,770
هذا لأنّك ناقص. ويمنعك ذلك من أن تصبح ذا قيمة

30
00:03:32,260 --> 00:03:33,360
!سحب

31
00:03:36,180 --> 00:03:39,680
!بطاقة التّميمة: الدّرج إلى الجنّة

32
00:03:42,840 --> 00:03:44,280
أُنهي دوري

33
00:03:44,280 --> 00:03:46,450
هل سيكون بخير؟

34
00:03:46,450 --> 00:03:51,020
إنَّ لعِب بطاقتَي تميمة على التّوالي
سوف يؤدّي إلى تخلُّفِه

35
00:03:51,020 --> 00:03:52,570
...أجل، لكن

36
00:03:53,130 --> 00:03:55,300
لا يبدو أنّه يُبلي حسناً

37
00:03:55,560 --> 00:04:00,750
تعتقدون أنّه لم ينسَ الخسارة أمام الظلّ
السّابع ذاك ذي مجموعة بطاقات التنّين بعد؟

38
00:04:01,120 --> 00:04:06,220
بعد كلّ الأشياء الفظيعة الّتي فعلَها للنّاس
الّذين هزمَهم، هكذا يتصرّف عندما يخسر؟

39
00:04:06,220 --> 00:04:07,220
يا له من جبان

40
00:04:07,220 --> 00:04:09,350
كلامُكِ قاسٍ

41
00:04:09,350 --> 00:04:10,960
آسفة، لكن لستُ فتاة لطيفة

42
00:04:11,300 --> 00:04:15,580
ميكادو شيروغاني، لماذا تلعب شادوفارس؟

43
00:04:16,190 --> 00:04:18,310
ما الّذي كنتَ تسعى له حتّى أتيت إلى هنا؟

44
00:04:22,600 --> 00:04:24,730
لماذا تقف أمامي؟

45
00:04:25,380 --> 00:04:26,650
بافوميت

46
00:04:28,390 --> 00:04:32,400
أنقل بطاقةَ مصنوعة دماء عشوائيّة
من مجموعة بطاقاتي إلى يدي

47
00:04:32,820 --> 00:04:35,040
الطّيف المُتبختِر يهاجم قائدَك

48
00:04:36,370 --> 00:04:40,250
أنت طفل. صغير جدّاً في السنّ

49
00:04:40,570 --> 00:04:45,120
كيف... كيف لك أن تكون واثقاً هكذا؟

50
00:04:45,120 --> 00:04:47,000
ما الّذي تعرفه عنّي؟

51
00:04:47,690 --> 00:04:51,050
لا أحد يفهمني

52
00:04:56,020 --> 00:04:59,060
أعرف شخصاً مثلك

53
00:04:59,630 --> 00:05:04,660
ناقص. سخيف. عاجز عن الاعتراف
بشيء بسيط كهزيمته

54
00:05:05,120 --> 00:05:08,620
ومقتنع بأنّ لا أحد يفهمه

55
00:05:09,100 --> 00:05:10,750
أعرف شخصاً كهذا

56
00:05:12,820 --> 00:05:15,600
!لا تُقارنّي بشخصٍ لم ألتقِ به حتّى

57
00:05:15,600 --> 00:05:17,530
...أنا... أنا

58
00:05:17,800 --> 00:05:20,040
!أنا ميكادو شيروغاني

59
00:05:20,490 --> 00:05:23,890
كلا العدّين التّنازليّين يتقدّمان بمقدار 1
في بداية دوري

60
00:05:23,890 --> 00:05:28,530
يصل العدُّ التّنازليّ لنبع الملائكة إلى صفر ويُدمَّر

61
00:05:29,310 --> 00:05:31,720
تجعلني كلماته الأخيرة أسحب بطاقة

62
00:05:32,000 --> 00:05:35,990
!لا تملك الحقّ في قول أيّ شيء عنّي

63
00:05:39,110 --> 00:05:42,020
...لا أحد... لا أحد يستطيع

64
00:05:47,780 --> 00:05:50,040
لا أحد يستطيع الاقتراب منّي حتّى

65
00:05:50,040 --> 00:05:53,020
وهكذا أبعدتَ النّاس عنك طوال حياتك، صحيح؟

66
00:05:54,380 --> 00:05:58,500
لكن حتّى أنت سنحَتْ لك فُرصة للتغيُّر في الماضي

67
00:05:58,500 --> 00:06:00,280
بل فُرص عديدة في الواقع

68
00:06:00,280 --> 00:06:04,370
ومع ذلك، ما زلتَ مرتاباً

69
00:06:04,370 --> 00:06:08,920
ورغم ارتيابك، تجرؤ على الوقوف أمامي

70
00:06:12,220 --> 00:06:16,810
هل فكّرتَ أصلاً في السّبب الّذي جعلَ
إتسكي يدعك تلعب هذه المُباراة؟

71
00:06:20,360 --> 00:06:23,170
سألتُك فيما إذا فكّرتَ في هذا

72
00:06:23,740 --> 00:06:26,480
إذا خسرتَ هنا، ينتهي الأمر

73
00:06:27,060 --> 00:06:30,370
لا تملك وقتاً تهدره على الارتجاف

74
00:06:31,950 --> 00:06:34,850
خصمه قاسٍ جدّاً أيضاً

75
00:06:34,850 --> 00:06:39,030
لـ-لكن ميكادو قويٌّ جدّاً! سيكون بخير

76
00:06:39,030 --> 00:06:40,140
لستُ واثقاً

77
00:06:41,060 --> 00:06:46,540
أتتذكّرين لاعب مصنوعة التنّين في الظّلال
السّبعة الّذي خسرَ أمامه؟

78
00:06:46,540 --> 00:06:49,490
!أجل! الشّخص الهادئ ذو القناع

79
00:06:49,490 --> 00:06:52,030
لوكا يونازوكي هزمَ ذلك الشّخص

80
00:06:52,030 --> 00:06:55,880
ما يعني بأنّه أقوى بكثير من ميكادو شيروغاني

81
00:06:55,880 --> 00:06:56,980
بجدّية؟

82
00:06:56,980 --> 00:07:03,660
أجل. لكن قال لوكا بأنّ هيرو ريوغاساكي
كان أقوى بكثير منه

83
00:07:03,660 --> 00:07:06,360
هذه ليست مُشكلة. سيكون ميكادو بخير

84
00:07:06,360 --> 00:07:10,350
وها هو زعيمنا ذو الثِّقة الّتي لا أساس لها

85
00:07:10,610 --> 00:07:12,380
أنا واثقٌ بسبب

86
00:07:12,380 --> 00:07:15,220
يحاول ميكادو المضيّ قُدماً

87
00:07:15,220 --> 00:07:21,380
،وأنا متأكّدٌ بأنّ مصيراً رائعاً ينتظره
مثلما حدث معي

88
00:07:21,380 --> 00:07:23,530
أنا متأكّدٌ بأنّ الأمر ذاته سيحصل معه

89
00:07:23,530 --> 00:07:25,950
!دوري! سحب

90
00:07:27,410 --> 00:07:31,080
أوّلاً، يتقدّم العدُّ التّنازليّ للدّرج
إلى الجنّة بمقدار 1

91
00:07:31,080 --> 00:07:33,160
!ألعب بأوكيانوس

92
00:07:36,830 --> 00:07:39,050
،يتفعّل تأثير أوكيانوس

93
00:07:39,050 --> 00:07:43,540
ليتيح لي ذلك اختيار إحدى بطاقتَي
التّعويذة لإضافتها إلى يدي

94
00:07:47,810 --> 00:07:48,820
لا يمكنك الاختيار؟

95
00:07:49,330 --> 00:07:50,770
اصمت

96
00:07:50,770 --> 00:07:52,410
هل أنت خائفٌ من الاختيار؟

97
00:07:52,410 --> 00:07:53,930
!قلتُ اصمت

98
00:07:57,150 --> 00:07:59,610
!لستُ أفهم أيضاً

99
00:08:00,040 --> 00:08:03,830
،لكن... لكن بدا لي أنّ بشادوفارس ربّما

100
00:08:04,530 --> 00:08:07,070
أستطيع التغيُّر بطريقة ما

101
00:08:07,880 --> 00:08:10,690
لستُ أفهم. هذا مُعقّدٌ جدّاً

102
00:08:10,690 --> 00:08:12,730
لم يحدث هذا أبداً من قبل

103
00:08:13,580 --> 00:08:17,760
ومُحال أن تفهم شيئاً لا أفهمه

104
00:08:17,760 --> 00:08:21,560
...مُحال أن تتمكّن من فهمي. لذا

105
00:08:22,050 --> 00:08:24,610
هلّا أغلقت فمك من فضلك؟

106
00:08:25,590 --> 00:08:29,730
توقّعتُ أن ألقى ردّةَ فعل إذا حاولتُ استفزازك

107
00:08:31,400 --> 00:08:33,650
حسناً

108
00:08:33,650 --> 00:08:38,840
لا يعنيني ما يحدث لك. أو ما يحدث
لكم جميعاً في الواقع

109
00:08:39,290 --> 00:08:42,000
إذا خسرتَ هنا، ينتهي الأمر كُلُّه

110
00:08:49,270 --> 00:08:50,670
!بيلفيغور

111
00:08:50,670 --> 00:08:53,310
بطاقة مصنوعة دماء قويّة

112
00:08:53,610 --> 00:08:59,050
يضبط تأثيرُ بيلفيغور دفاعي على 10
وأسحب بطاقتَين

113
00:09:09,610 --> 00:09:13,910
النّظر إليك الآن يجعلني أشعر
بالإحراج والغضب قليلاً

114
00:09:15,580 --> 00:09:17,350
بيلفيغور، تطوّري

115
00:09:26,680 --> 00:09:28,200
هاجمي أوكيانوس

116
00:09:31,530 --> 00:09:34,350
يتفعّل تأثير الدّرج إلى الجنّة

117
00:09:34,350 --> 00:09:38,690
،في كلّ مرّة يُدمَّر فيها تابعٌ من أتباعي
يتقدّم عدُّه التّنازليّ بمقدار 1

118
00:09:38,690 --> 00:09:39,640
لن يخدمك هذا

119
00:09:42,640 --> 00:09:43,930
...هذا

120
00:09:44,190 --> 00:09:49,440
يحظى شيطانُ الثّأر بالقدرة على الهجوم
عندما يكون اللّاعب في حالة ثأر

121
00:09:49,440 --> 00:09:51,690
إنّه مُقبِلٌ على بعض الألم إذاً؟

122
00:09:52,060 --> 00:09:53,670
!أُهاجم قائدَك

123
00:10:02,240 --> 00:10:05,290
كما توقّعتُ تماماً. أنت ضعيف

124
00:10:11,810 --> 00:10:14,510
اللّعنة. لماذا؟

125
00:10:14,510 --> 00:10:16,560
...لماذا أنا كثيراً

126
00:10:17,360 --> 00:10:18,160
!ميكادو

127
00:10:19,600 --> 00:10:21,810
!لم تنتهِ المعركة بعد

128
00:10:22,120 --> 00:10:23,690
أعلم ذلك

129
00:10:23,690 --> 00:10:25,520
!لستَ وحدك

130
00:10:25,520 --> 00:10:26,900
اصمت

131
00:10:26,900 --> 00:10:29,890
!أنا... نحن هنا معك

132
00:10:30,670 --> 00:10:33,160
...لذا إذا اعتمدتَ علينا

133
00:10:34,370 --> 00:10:36,660
!قلتُ اصمت

134
00:10:40,560 --> 00:10:45,150
جميعكم تتصرّفون وكأنّكم أفضل منّي بكثير

135
00:11:00,540 --> 00:11:03,880
هكذا عشتُ دوماً

136
00:11:04,340 --> 00:11:05,500
وحيداً

137
00:11:05,500 --> 00:11:07,020
...حياتي كلّها

138
00:11:07,020 --> 00:11:09,740
كيف أغيِّر ذلك الآن؟

139
00:11:12,400 --> 00:11:14,930
!ألعب ببطاقة التّعويذة، الطلقة السّاقطة

140
00:11:17,290 --> 00:11:19,650
!تُلحِق 3 ضرراً بتابع عدوّ

141
00:11:22,160 --> 00:11:24,470
وهذا بالتّحديد ما يجعلك طفلاً

142
00:11:24,470 --> 00:11:26,460
!لا يمكن أن أكون طفلاً

143
00:11:26,460 --> 00:11:29,120
!لطالما كنتُ الرّقم واحد في كلِّ شيء

144
00:11:29,120 --> 00:11:35,950
التّأثير الثّاني للطلقة السّاقطة تحوّل أحد
!الأتباع في يدي إلى تابع مُنزَّل

145
00:11:36,750 --> 00:11:42,140
ذرّة الكبرباء تلك الّتي ما زالت لديك
هي بُرهان على ضعفِك

146
00:11:42,140 --> 00:11:45,040
...لستُ ضعيفاً... أنا

147
00:11:45,810 --> 00:11:48,060
!لستُ ضعيفاً إطلاقاً

148
00:11:48,060 --> 00:11:49,760
...لـ-لا أعتقد بأنّني

149
00:11:49,760 --> 00:11:51,310
!ملاك درع الظّلام

150
00:11:57,790 --> 00:12:00,970
!تُلحِق 5 ضرراً بتابع عدوّ عشوائيّ

151
00:12:03,330 --> 00:12:06,020
!بالإضافة إلى 5 ضرر بقائدك

152
00:12:07,660 --> 00:12:11,720
...هذه مضيعة للوقت. ما تفتقره واضح جدّاً، لكن

153
00:12:13,020 --> 00:12:16,800
سأكون صريحاً، خاب أملي. وكثيراً أيضاً

154
00:12:16,800 --> 00:12:20,340
...بأن تنتهي معركتنا معكم جميعاً بهذا الشّكل

155
00:12:22,440 --> 00:12:24,100
الاستنزاف الشّيطانيّ

156
00:12:25,710 --> 00:12:28,260
...بأن لا يستطيع أي منكم

157
00:12:30,280 --> 00:12:32,030
...الوصول إلى حقيقته

158
00:12:36,690 --> 00:12:41,700
يمكن للاستنزاف الشّيطانيّ أن يُلعَب
بكلفة 1 إذا كنتُ في حالة ثأر

159
00:12:41,700 --> 00:12:46,840
يُلحِق 4 ضرراً بتابع عدوّ ويستعيد 2
دفاع إلى قائدي

160
00:12:48,910 --> 00:12:50,990
حسناً، أفترض أنّ هذا هو القدر

161
00:12:50,990 --> 00:12:55,910
لماذا أنت مغرورٌ جدّاً؟
لم يبقَ لديك إلّا 7 دفاع

162
00:12:55,910 --> 00:12:59,790
بوسعي إنهاء اللّعبة في الدّور المُقبِل

163
00:12:59,790 --> 00:13:01,260
لستَ قادراً على ذلك

164
00:13:01,260 --> 00:13:02,670
—كـ-كيف لك أن تكون واثقاً

165
00:13:02,670 --> 00:13:04,920
الآن، أنت غير قادر على ذلك

166
00:13:04,920 --> 00:13:06,950
شادوفارس ليست بتلك السُّهولة

167
00:13:06,950 --> 00:13:09,580
شادوفارس لا تبتسم لأولئك الّذين
يفتقرون للعزيمة

168
00:13:10,510 --> 00:13:12,350
القوّةُ وحدها لا معنى لها

169
00:13:12,900 --> 00:13:15,890
من دون غاية، البطاقات لا تلبِّيك

170
00:13:22,380 --> 00:13:27,090
!يصلُ العدُّ التّنازليّ للدّرج إلى الجنّة إلى صفر

171
00:13:27,760 --> 00:13:29,370
تتفعّل كلماته الأخيرة

172
00:13:29,370 --> 00:13:31,500
،في بداية دوري المُقبِل

173
00:13:31,500 --> 00:13:34,620
أنقل ثلاثة تابعين عشوائيّين من مجموعة
بطاقاتي إلى يدي

174
00:13:34,900 --> 00:13:36,900
ألعب بالخائن ذي الجناح الواحد

175
00:13:40,620 --> 00:13:45,340
يستعيد 2 نقطة لعِب ويضيف
مُجنّحاً معكوساً إلى يدي

176
00:13:46,310 --> 00:13:49,420
ألعب ببطاقة التّعويذة، المُجنَّح المعكوس

177
00:13:49,420 --> 00:13:53,210
يحوّل أحد أتباعي إلى تابع مُنزَّل

178
00:13:53,210 --> 00:13:55,640
!تعال أيُّها الفارس الملائكيّ الظّلاميّ

179
00:13:57,130 --> 00:14:02,290
يُعزِّزُ تأثيرُه هجومَ ودفاعَ أتباعي
المُحايدين بمقدار 1

180
00:14:02,290 --> 00:14:05,830
ثمّ يتحفّز التّأثيرُ الثّاني للخائن ذي الجناح الواحد

181
00:14:06,830 --> 00:14:09,210
،عندما يدخلُ تابعٌ مُنزَّل وضعَ اللّعب

182
00:14:09,210 --> 00:14:12,490
يُطوِّرُ كُلّاً من ذلك التّابع والخائن ذي الجناح الواحد

183
00:14:12,490 --> 00:14:15,120
!الخائنُ ذو الجناح الواحد يُهاجم فلاوروس

184
00:14:18,070 --> 00:14:22,040
تسترجع كلماتُه الأخيرة دفاعي بمقدار 3

185
00:14:23,670 --> 00:14:26,030
لديك 10 دفاع

186
00:14:26,030 --> 00:14:28,980
ذكّرني من سيخسر هنا؟

187
00:14:30,210 --> 00:14:31,550
ينبغي أن يكون هذا واضحاً

188
00:14:32,440 --> 00:14:34,350
ألعب بـ هِبة لنسيب الدّم

189
00:14:46,230 --> 00:14:48,950
،يُلحِق 1 ضرراً بقائدينا

190
00:14:48,950 --> 00:14:51,840
ويضع خفّاشَ غابة في وضع اللّعب
في كلا الطّرفين

191
00:14:53,870 --> 00:14:55,210
!ارقص بالدِّماء

192
00:14:55,910 --> 00:14:58,040
!مصّاص الدِّماء القرمزيّ

193
00:14:59,940 --> 00:15:03,980
يتحفّز تأثيره، ليُلحِق 2 ضرراً
!بكافّة أتباع العدوّ

194
00:15:12,390 --> 00:15:15,180
!يتحفّز التّأثير الثّاني لمصّاص الدِّماء القرمزيّ

195
00:15:15,450 --> 00:15:19,180
،إذا تلقّى قائدي ضرراً في هذا الدّور

196
00:15:19,180 --> 00:15:22,220
،يُلحِق 3 ضرراً بتابع عدوّ واحد
،بالإضافة إلى قائد العدوّ

197
00:15:22,220 --> 00:15:25,150
و 2 ضرر بقائدي

198
00:15:26,880 --> 00:15:28,570
...فقط 10 دفاع

199
00:15:29,020 --> 00:15:32,580
...لم يبقَ إلّا نصف دفاعي فقط

200
00:15:43,510 --> 00:15:45,470
...لـ-لا، هذا مستحيل

201
00:15:46,120 --> 00:15:47,440
ما الأمر؟

202
00:15:47,440 --> 00:15:50,120
هنا تبدأ شادوفارس

203
00:15:50,120 --> 00:15:52,250
هذه هي البداية

204
00:15:53,130 --> 00:15:55,390
...لـ-لا أكثر

205
00:15:55,390 --> 00:15:58,010
!لن أسمح بهذا ثانية

206
00:15:59,820 --> 00:16:03,640
يتفعّل تأثيرُ الدّرج إلى الجنّة
بعد تحفيز الدّور الأخير

207
00:16:03,910 --> 00:16:06,280
أضيف ثلاثة أتباع إلى يدي

208
00:16:10,400 --> 00:16:11,860
ساهاكويل

209
00:16:15,340 --> 00:16:19,500
ينقل تأثيرُه تابعاً مُحايداً من يدي
إلى وضع اللّعب

210
00:16:22,050 --> 00:16:27,000
يكتسب ذلك التّابع فورةً ويعود إلى
يدي في نهاية دوري

211
00:16:32,440 --> 00:16:35,850
!لوسيفر يهاجم مصّاصَ الدِّماء القرمزيّ

212
00:16:43,990 --> 00:16:47,210
لوسيفر؟ لَعِبَ بتابعٍ جيّد أخيراً

213
00:16:47,210 --> 00:16:49,540
ما قبل التطوُّر، لديه تأثيرٌ شفائيّ

214
00:16:49,540 --> 00:16:54,950
لكن إذا تطوّر، يمكنه إلحاق 4 ضرر
بقائد العدوّ في نهاية الدّور، صحيح؟

215
00:16:54,950 --> 00:17:01,250
أجل. سيتحفّز تأثيرُ لوسيفر قبل أن يعود
إلى يده، لذا سيكون هذا نافعاً

216
00:17:01,250 --> 00:17:02,290
أنهي دوري

217
00:17:04,170 --> 00:17:10,680
يتفعّل تأثير لوسيفر، ويسترجع 4 دفاع
إلى قائدي في نهاية دوري

218
00:17:19,940 --> 00:17:21,250
...إنّه

219
00:17:26,980 --> 00:17:29,280
أهذه إجابتك؟

220
00:17:37,610 --> 00:17:41,490
يمكن لشادوفارس أحياناً أن تطعن
أعمق من أيّ كلمة

221
00:17:41,750 --> 00:17:44,380
ألعب ببطاقة التّعويذة، القُبلة الماصّة للدِّماء

222
00:17:51,310 --> 00:17:54,570
هذا يكفي بالنّسبة لك

223
00:17:55,110 --> 00:17:58,600
أكثر من هذا سيؤدّي إلى مُعاناتك

224
00:17:59,330 --> 00:18:01,010
ألعب بحاملة السّيف العربيّ القرمزيّ

225
00:18:05,550 --> 00:18:10,730
،يتحفّز تأثيرُها لإلحاق 2 ضرر بتابعٍ عدوّ

226
00:18:12,710 --> 00:18:15,090
ويسترجع 2 إلى دفاعي

227
00:18:19,790 --> 00:18:21,120
آفة؟

228
00:18:21,560 --> 00:18:23,380
لا شيء يدعو للخجل

229
00:18:23,380 --> 00:18:25,700
أعرف شعورك تماماً

230
00:18:25,700 --> 00:18:27,370
لذا سأضع حدّاً لمُعاناتك

231
00:18:32,980 --> 00:18:36,200
الوداع يا ميكادو شيروغاني

232
00:18:36,200 --> 00:18:39,310
ولكم أيضاً، أيُّها المُنتصِرون في التّصنيف العالميّ

233
00:18:39,310 --> 00:18:41,880
لا مكان لكم هنا بعد الآن

234
00:19:02,000 --> 00:19:03,220
!ميكادو

235
00:19:06,620 --> 00:19:07,680
!ميكادو

236
00:19:08,250 --> 00:19:10,210
!هذه المعركة قد بدأت للتو

237
00:19:10,210 --> 00:19:12,040
!أعلم بأنّك تستطيع فعلها

238
00:19:12,040 --> 00:19:13,570
دعني

239
00:19:14,920 --> 00:19:16,050
لا أستطيع

240
00:19:16,830 --> 00:19:20,170
لا... لا أريد أن أخسر

241
00:19:21,010 --> 00:19:27,170
لا أريد أن أعاني هكذا بعد الآن

242
00:19:27,700 --> 00:19:29,740
الجميع يراودهم نفس الشُّعور

243
00:19:30,720 --> 00:19:33,020
...كلّ مَن خسِر أمامك

244
00:19:33,020 --> 00:19:34,910
...حتّى هاروما وأنا

245
00:19:35,510 --> 00:19:37,660
جميعنا كنّا خائفين من الخسارة

246
00:19:40,280 --> 00:19:41,730
ما خطبك؟

247
00:19:41,730 --> 00:19:46,270
لا تنفك تقتحم عقلي مراراً وتكراراً

248
00:19:46,270 --> 00:19:48,090
من تعتقد نفسك؟

249
00:19:48,900 --> 00:19:52,050
!من تعتقد نفسك بالضّبط؟

250
00:19:53,170 --> 00:19:54,970
!أنا مُنافِسُك

251
00:19:55,840 --> 00:19:58,010
أنا مُنافِسُك

252
00:19:58,010 --> 00:20:00,900
فكّرتُ مراراً، وتوصّلتُ إلى هذه النّتيجة

253
00:20:01,390 --> 00:20:03,290
أفهمك جيّداً

254
00:20:03,870 --> 00:20:08,820
وأعلم بأنّ شادوفارس خاصّتك لن تنتهي هنا

255
00:20:09,710 --> 00:20:13,570
لا ضير من الخسارة. لن يلومك أحد

256
00:20:14,310 --> 00:20:18,480
لذا قاتِل بأقصى قدراتك فحسب

257
00:20:18,480 --> 00:20:20,620
أنا متأكّدٌ بأنّ الجميع يراودهم نفس الشُّعور

258
00:20:21,180 --> 00:20:24,230
الجميع"؟ لا تُقرِّر ذلك من عندك فحسب"

259
00:20:24,230 --> 00:20:26,220
معكِ حقّ. بئساً

260
00:20:26,220 --> 00:20:28,140
لا مُشكلة، صحيح؟

261
00:20:28,140 --> 00:20:31,910
فنحن بحاجة لفوز الرّئيس في نهاية المطاف

262
00:20:31,910 --> 00:20:34,380
!أجل. أُشجِّعه من أعماق قلبي

263
00:20:34,580 --> 00:20:38,910
،حتّى لو كنتَ مرتاباً، حتّى لو آلمَك ذلك
...اخترتَ الوقوف هناك يا حضرة الرّئيس شيروغاني

264
00:20:38,910 --> 00:20:41,570
لا، أقصد يا ميكادو

265
00:20:41,570 --> 00:20:44,380
كان بوسعك رفض عرضي

266
00:20:44,380 --> 00:20:47,250
لكنّك قرّرتَ الوقوف هناك

267
00:20:47,250 --> 00:20:49,510
أعتقد هذا مذهل

268
00:20:49,510 --> 00:20:53,930
،لذا إذا آمنتَ بنفسك وقبلتَ نفسك

269
00:20:53,930 --> 00:20:55,980
!يمكنك الاستمرار في الوقوف

270
00:21:05,960 --> 00:21:07,910
أنت تُقاطِع معركتي

271
00:21:07,910 --> 00:21:09,330
عُد إلى هناك وراقب

272
00:21:09,760 --> 00:21:10,650
حسناً

273
00:21:13,010 --> 00:21:16,100
لماذا ما زلتَ تلعب شادوفارس؟

274
00:21:16,100 --> 00:21:17,480
لا أعلم

275
00:21:17,480 --> 00:21:19,960
ما الّذي تسعى له وأنت تقف مكانك؟

276
00:21:22,470 --> 00:21:23,460
لا أعلم

277
00:21:23,460 --> 00:21:24,840
لماذا إذاً؟

278
00:21:24,840 --> 00:21:31,710
لأنّني... لم أشعر هذا الشُّعور من قبل
...بعد أن قال لي أحدٌ شيئاً

279
00:21:31,710 --> 00:21:35,210
لم أشعر بهذا الدّفء من قبل

280
00:21:35,600 --> 00:21:40,560
لهذا السّبب... لهذا السّبب سوف أتابع معركتي

281
00:21:45,640 --> 00:21:48,170
حاليّاً، هذا كلّ ما في الأمر

282
00:23:24,040 --> 00:23:25,890
!استعراض بطاقة شادوفارس

283
00:23:26,460 --> 00:23:29,050
بطاقة اليوم هي ساهاكويل

284
00:23:29,050 --> 00:23:32,040
ربّما تفضّل إسرافيل؟

285
00:23:32,040 --> 00:23:33,550
لديها كمان

286
00:23:33,550 --> 00:23:34,790
اصمت

287
00:23:34,790 --> 00:23:38,650
أفضّل اللّعب بمهام الألغاز على التكلُّم معك

288
00:23:38,970 --> 00:23:43,680
لماذا الجميع في اللّهب السّابع لا يصمتون أبداً؟

289
00:23:43,680 --> 00:23:46,110
لكن أعتقد هذا سبب من الأسباب
الّتي تجعل الأمر رائعاً

290
00:23:46,110 --> 00:23:48,400
هذا... حسناً، قد تكون على حقّ

291
00:23:48,400 --> 00:23:48,970
!أجل

292
00:23:48,970 --> 00:23:51,860
"الحلقة القادمة: "ستتعلّم معنى شادوفارس خاصّتك

293
00:23:51,860 --> 00:23:53,780
!قِتال! شادوفارس