1
00:00:14,200 --> 00:00:15,280
...هل

2
00:00:16,490 --> 00:00:18,370
هل ستغادر حقّاً؟

3
00:00:19,820 --> 00:00:23,820
رئيس العائلة قد اتّخذ قراره. لا رأي لي

4
00:00:24,260 --> 00:00:28,680
ستحظى العائلة بوريث جديد وسيرحل الفاشل

5
00:00:29,150 --> 00:00:34,680
.أنا متأكّد أنّ العيش وحيداً لن يكون بذلك السّوء
قالوا بأنّهم لن يدفعوا الإيجار ورسوم تعليمي

6
00:00:36,700 --> 00:00:38,090
حسناً، وداعاً

7
00:00:39,000 --> 00:00:40,060
...متى

8
00:00:42,330 --> 00:00:44,860
متى ستصبح جادّاً؟

9
00:00:46,400 --> 00:00:48,860
أنا جادّ

10
00:00:49,540 --> 00:00:51,080
وهذا لا يُفيد

11
00:00:51,460 --> 00:00:53,860
لذلك أنا خائف

12
00:00:54,230 --> 00:00:55,930
من الخسارة أمامك

13
00:00:57,240 --> 00:01:02,210
لا تقلق. لن تضطرّ لرؤية أخيك خاسراً بعد الآن

14
00:01:02,900 --> 00:01:03,860
وداعاً

15
00:01:07,990 --> 00:01:10,560
ستتركني إذاً؟

16
00:01:14,460 --> 00:01:17,680
"!عدتُ من المقبرة"

17
00:01:18,240 --> 00:01:21,990
.لا أكترث لأمرك. لستُ بحاجتك
لا أبالي البتّة لك

18
00:01:21,990 --> 00:01:23,430
لذا سوف أنهي هذا

19
00:01:23,870 --> 00:01:26,850
!سأمسح كلّ أثر منك عن قلبي

20
00:01:27,380 --> 00:01:29,280
!دوري! سحب

21
00:01:30,810 --> 00:01:35,060
!ألعب بتميمة العدّ التّنازليّ الطقوس المُحرّمة

22
00:01:36,640 --> 00:01:41,160
لن أدعك تعود إلى حياتي وتتظاهر بأنّك أخي

23
00:01:41,160 --> 00:01:43,030
!الأمر ليس بتلك السّهولة

24
00:01:43,640 --> 00:01:46,860
أجل. معك حقّ

25
00:01:48,780 --> 00:01:52,410
ما كنتُ لأستطيع فعل شيء بمفردي

26
00:01:53,050 --> 00:01:56,040
كان الجميع خلفي لدفعي للأمام

27
00:01:56,040 --> 00:01:58,050
—لهذا أنت عديم القيمة! لهذا أنا غاضب

28
00:01:58,050 --> 00:01:59,050
...لذا دعني

29
00:01:59,980 --> 00:02:02,990
دعني أقول نفس الكلام لك

30
00:02:03,440 --> 00:02:05,410
لستَ وحدك

31
00:02:05,640 --> 00:02:07,800
!لديك أنا

32
00:02:12,560 --> 00:02:13,810
!التّحويل الرُّوحي

33
00:02:16,560 --> 00:02:19,790
أدمِّر هيكلي العظميّ وأسحب بطاقتين

34
00:02:21,070 --> 00:02:23,260
ثمّ حاصد الأرواح المُسلّي

35
00:02:24,020 --> 00:02:26,730
،يتفعّل تأثير حاصد الأرواح المُسلّي

36
00:02:26,730 --> 00:02:30,240
ليحوّل التّابع ذي الهجوم الأدنى إلى شبح

37
00:02:31,540 --> 00:02:33,870
!الشّبح لديه عاصفة ويهاجمك

38
00:02:36,650 --> 00:02:38,830
كفاك مُزاحاً. فات الأوان على ذلك

39
00:02:39,710 --> 00:02:43,970
آسف. هذه المرّة، أنا لا أمزح

40
00:02:49,940 --> 00:02:52,090
هربت منّي

41
00:02:52,400 --> 00:02:55,080
تركتني وغادرت لتستمتع

42
00:02:55,450 --> 00:02:57,810
!لا يحقّ لك أن تقول شيئاً لي

43
00:02:57,810 --> 00:03:00,380
لستُ من كنتُ عليه آنذاك

44
00:03:00,380 --> 00:03:03,480
لم أكن ذلك الشّخص لمدّة طويلة جدّاً

45
00:03:04,280 --> 00:03:07,810
يصل العدّ التّنازليّ للطقوس المُحرَّمة للصّفر

46
00:03:07,810 --> 00:03:11,660
تتفعّل كلماته الأخيرة لنفي كلّ التّابعين
ذوي الدّفاع 2 أو أقلّ

47
00:03:11,660 --> 00:03:15,420
لكن لا أملك أيّ تابعين بـ 2 دفاع أو أقلّ

48
00:03:15,420 --> 00:03:17,000
أجل، هذا صحيح

49
00:03:17,000 --> 00:03:19,790
تجنّبت ذلك. أهنّئك على ذلك

50
00:03:20,110 --> 00:03:23,060
لكن ظلامي أعمق من ذلك

51
00:03:23,570 --> 00:03:26,620
سأريك الظّلام الّذي لا تعرفه داخلي

52
00:03:28,720 --> 00:03:29,520
ماذا؟

53
00:03:29,920 --> 00:03:32,820
لوّث حتّى المُحيطات الزّرقاء النقيّة

54
00:03:32,820 --> 00:03:34,180
!مزار الشرّ

55
00:03:38,420 --> 00:03:41,290
تغيّر المزار المُطلَق؟

56
00:03:41,880 --> 00:03:46,730
،عندما تدخل بطاقة التّميمة هذه وضع اللّعب
،إذا كان المزار المُطلَق في وضع اللّعب

57
00:03:46,730 --> 00:03:52,040
فإنّه يتدمّر وأستعيد نقطة لعِب واحدة ثمّ أسحب بطاقة

58
00:03:52,950 --> 00:03:57,720
أنا الّذي تعرفه هو مجرّد وهم. إنّه ليس هنا

59
00:04:00,240 --> 00:04:02,850
،الشّخص الّذي يقف أمامك هو كاغويا ماكابي

60
00:04:02,850 --> 00:04:06,390
خليفة عشيرة ماكابي وعضو في الظِّلال السّبعة

61
00:04:06,680 --> 00:04:08,980
!وعدوُّك

62
00:04:10,140 --> 00:04:11,590
الرّصاصة المضمونة؟

63
00:04:11,590 --> 00:04:14,280
تُلحق 3 ضرراً بتابع للعدوّ

64
00:04:14,280 --> 00:04:16,590
وينتهي دوري

65
00:04:17,100 --> 00:04:18,550
!الصّقر البرّاق

66
00:04:19,120 --> 00:04:21,920
لدى الصّقر البرّاق تطوُّر خاصّ

67
00:04:21,920 --> 00:04:25,870
إنّها القدرة الّتي تعني بأنّها لا تتطوّر
من خلال نقاط التطوُّر، صحيح؟

68
00:04:25,870 --> 00:04:28,480
لكن هذا التأثير على وشك التغيُّر

69
00:04:28,480 --> 00:04:30,360
!يتفعّل تأثير مزار الشرّ

70
00:04:30,650 --> 00:04:33,900
كلّ التّابعين في وضع اللّعب قد تغيّر تطوُّرهم الخاص

71
00:04:33,900 --> 00:04:37,350
لتتطوّر تلقائيّاً من دون استخدام أيّ نقطة تطوُّر

72
00:04:37,350 --> 00:04:39,870
!لذا أُطوِّر الصّقر البرّاق

73
00:04:40,920 --> 00:04:45,570
أنهي دوري. ويتفعّل تأثير الصّقر البرّاق الخاص بي

74
00:04:45,570 --> 00:04:48,850
،إذا كان لديّ 2 نقطة تطوُّر أو أكثر
،فإنّني أسحب بطاقتين

75
00:04:48,850 --> 00:04:52,140
وأرسل بطاقة عشوائيّة من يدك إلى المقبرة

76
00:04:54,240 --> 00:04:58,370
الأيّام الّتي قضيتُها معك منذ مدّة
طويلة لم تعُد تهمّني

77
00:04:58,800 --> 00:05:00,560
لا أعرفك

78
00:05:00,870 --> 00:05:02,800
وأنت لا تعرفني

79
00:05:06,330 --> 00:05:07,580
قاسٍ

80
00:05:08,310 --> 00:05:10,860
أُذنايّ تؤلمانني كثيراً لدرجة أنّهما ستسقطان

81
00:05:10,860 --> 00:05:13,020
!اخرج يا شبح الحفلة التنكُّريّة

82
00:05:18,990 --> 00:05:23,620
البطاقة المثاليّة المخصّصة لك، الفتى ذو
الابتسامة الغبيّة في وجهه

83
00:05:24,010 --> 00:05:27,940
أجل، حسّ دعابتنا متشابه في الواقع

84
00:05:28,640 --> 00:05:30,890
يتفعّل تأثير شبح الحفلة التنكُّريّة

85
00:05:31,350 --> 00:05:34,810
!يستدعي شبحاً ويعزّز هجومه بمقدار 1

86
00:05:35,840 --> 00:05:38,460
!شبح الحفلة التنكُّريّة، تطوّر

87
00:05:50,030 --> 00:05:52,220
!يُهاجم الصّقر البرّاق

88
00:05:55,530 --> 00:05:59,340
!ثمّ لدى الشّبح عاصفة، لذا يهاجمك قائدك

89
00:06:01,090 --> 00:06:02,070
أنهي دوري

90
00:06:02,700 --> 00:06:04,100
الشّبح يُنفَى

91
00:06:04,960 --> 00:06:07,270
،نظراً لتأثير شبح الحفلة التنكُّريّة

92
00:06:07,270 --> 00:06:10,930
كلّما نُفي شبح، يستدعي الشّبح العملاق

93
00:06:13,470 --> 00:06:18,270
،دائماً ما أضحك على الأشياء
وأعتقد بأنّ ذلك لن يتغيّر

94
00:06:18,270 --> 00:06:20,680
لكن اليوم، أنا جادّ

95
00:06:20,680 --> 00:06:23,170
كلّ شيء هو مزحة بالنسبة لك، أليس كذلك؟

96
00:06:25,200 --> 00:06:29,200
فات الأوان على كلّ هذا. لِمَ لا تستطيع فهم ذلك؟

97
00:06:31,160 --> 00:06:33,860
حماقتك خطيئة

98
00:06:36,410 --> 00:06:38,580
هذا تأثير بيغاسوس العقوبة

99
00:06:39,000 --> 00:06:43,630
يُلحق 2 ضرراً بقائد العدوّ و يسترجع 2 دفاعاً لي

100
00:06:44,410 --> 00:06:47,220
لدى بيغاسوس العقوبة تطوُّر خاصّ

101
00:06:47,480 --> 00:06:53,590
بالتّالي، يتفعّل تأثير مزار الشرّ ويتطوّر
من دون استخدام نقطة تطوُّر

102
00:06:57,770 --> 00:06:59,890
!يُهاجم الشّبح العملاق الخاص بك

103
00:07:03,960 --> 00:07:09,030
أنهي دوري، ويتفعّل تأثير بيغاسوس العقوبة

104
00:07:09,730 --> 00:07:14,530
في نهاية دوري، ينفي تابع العدوّ
ذي الهجوم الأعلى

105
00:07:16,620 --> 00:07:18,530
يستدعي بيغاسوس

106
00:07:18,850 --> 00:07:26,480
لعلّك تعتقد بأنّ قضاء الوقت مع أصدقائك
الأغبياء قد غيّرك، لكن لم يحدث ذلك

107
00:07:27,880 --> 00:07:29,200
ربّما

108
00:07:29,670 --> 00:07:33,220
صحيح أنّني ما كنتُ لأصل إلى هنا من تلقاء نفسي

109
00:07:33,220 --> 00:07:36,010
هذا صحيح. أنت ضعيف

110
00:07:36,010 --> 00:07:36,680
أجل

111
00:07:36,900 --> 00:07:38,980
أنت جبان

112
00:07:38,980 --> 00:07:40,100
معك حقّ

113
00:07:40,100 --> 00:07:41,870
لقد هربت

114
00:07:41,870 --> 00:07:42,900
أجل

115
00:07:42,900 --> 00:07:46,650
!لست أخي

116
00:07:46,950 --> 00:07:48,020
هذه هي

117
00:07:48,930 --> 00:07:51,110
هذه هي المشكلة

118
00:07:51,930 --> 00:07:55,340
أنا ضعيف. أنا جبان. هربت

119
00:07:55,790 --> 00:07:57,860
لكن أتعلم؟

120
00:07:58,420 --> 00:08:00,920
!أبقى أخيك

121
00:08:01,290 --> 00:08:04,560
...مهما كنتُ ضعيفاً... مهما كنتُ جباناً

122
00:08:04,560 --> 00:08:06,720
!لا مهرب من تلك الحقيقة

123
00:08:07,960 --> 00:08:12,060
لقد تغيّرتُ. وأنتَ قد تغيّرت. هذه هي الحقيقة

124
00:08:12,060 --> 00:08:13,420
لكن أتعلم؟

125
00:08:13,420 --> 00:08:17,260
!حقيقة أنّنا أخوان لن تتغيّر أبداً

126
00:08:18,210 --> 00:08:20,470
!لدى شبح المهرجان فورة

127
00:08:21,880 --> 00:08:25,170
!يستدعي شبحاً عندما يدخل وضع اللّعب

128
00:08:27,040 --> 00:08:28,900
!ثمّ الزّومبي الشّقيّ

129
00:08:29,160 --> 00:08:32,100
تأثيره يمنح آفة للشّبح

130
00:08:33,810 --> 00:08:34,840
!هجوم

131
00:08:35,290 --> 00:08:36,410
!ردّ

132
00:08:39,200 --> 00:08:40,310
!آفة

133
00:08:42,230 --> 00:08:44,190
!لم أنتهِ يا كاغويا

134
00:08:46,040 --> 00:08:47,100
...لا

135
00:08:47,640 --> 00:08:49,330
!لا تلفظ اسمي حتّى

136
00:08:51,920 --> 00:08:54,200
!الكلمات الأخيرة لشبح المهرجان

137
00:08:54,200 --> 00:08:58,760
،إذا تمّ نفي تابع في هذا الدّور
!يُستدعى شبح عملاق

138
00:08:59,260 --> 00:09:02,470
هيّا يا كاغويا. إنّه دورك

139
00:09:03,300 --> 00:09:04,640
اصمت

140
00:09:06,350 --> 00:09:10,020
تركتني. بمفردي

141
00:09:10,020 --> 00:09:12,360
كذبت عليّ

142
00:09:12,940 --> 00:09:15,990
!لا الربّ ولا أنا سنسامحك

143
00:09:23,650 --> 00:09:26,120
!ردّ الهجوم، الشّبح العملاق

144
00:09:33,410 --> 00:09:37,540
تطوير مُخلِص العقوبة الإلهيّة منحَه تأثيراً هجوميّاً

145
00:09:37,540 --> 00:09:42,190
إذا كان لديّ 2 نقطة تطوُّر أو أكثر، فإنّ
الضّرر التّالي الّذي أتلقّاه ينقص إلى صفر

146
00:09:42,190 --> 00:09:47,510
ولا يتلقّى ضرراً من التّأثيرات ولا يمكن تدميره

147
00:09:48,190 --> 00:09:49,780
!سئمتُ منك

148
00:09:49,780 --> 00:09:53,780
!سوف أنكرك. أرفضك. أبيدك

149
00:09:54,910 --> 00:10:00,740
حسناً، عدم الاستسلام هو أكثر
ما يبرع فيه لاعبو شادوفارس

150
00:10:01,390 --> 00:10:06,560
!عدتُ من المقبرة لوضع حدّ نهائي لكلِّ هذا

151
00:10:12,730 --> 00:10:15,150
!ألعب بغُراب الموكب مع فورة

152
00:10:20,220 --> 00:10:24,870
يدمِّر تأثيره أحد أتباعي ويؤدّي إنشاز 5

153
00:10:28,060 --> 00:10:31,310
ألعب بهذه البطاقة والّتي لديها فورة

154
00:10:31,640 --> 00:10:33,700
!يتفعّل تأثير شبح المهرجان

155
00:10:34,020 --> 00:10:36,940
عندما يدخل وضع اللّعب، يستدعي شبحاً

156
00:10:38,000 --> 00:10:40,700
والآن لنشرع في هذه الحفلة

157
00:10:40,700 --> 00:10:43,350
!سئمتُ منك. اختفِ

158
00:10:47,380 --> 00:10:49,460
لا شيء تقوله يصلني

159
00:10:49,460 --> 00:10:52,040
مُخلِص العقوبة الإلهيّة لديه 5 دفاع

160
00:10:52,040 --> 00:10:56,500
!لدى شبح المهرجان 3 هجوم. لا يمكنك هزيمتها

161
00:10:56,500 --> 00:10:58,230
بل يمكنني

162
00:10:59,230 --> 00:11:01,480
يتفعّل التّأثير الهجومي لشبح المهرجان

163
00:11:01,850 --> 00:11:06,350
إذا كان لديّ تابع بهجوم 4 أو أكثر في وضع
اللّعب، فيزداد هجومها بمقدار 2

164
00:11:06,650 --> 00:11:08,350
!اللّعنة عليك

165
00:11:11,300 --> 00:11:12,520
!الكلمات الأخيرة

166
00:11:12,520 --> 00:11:16,970
!نُفي شبح في هذا الدّور، لذا يتمُّ استدعاء شبح عملاق

167
00:11:20,800 --> 00:11:21,820
...مثلما

168
00:11:22,690 --> 00:11:25,790
،مثلما أخفي ما في قلبي داخل هذه الابتسامة

169
00:11:26,520 --> 00:11:30,480
أنت تخفي ما تشعر به فعليّاً، أليس كذلك؟

170
00:11:43,760 --> 00:11:46,180
أخفي ما أشعر به فعليّاً؟

171
00:11:46,450 --> 00:11:47,600
لا

172
00:11:47,600 --> 00:11:49,780
!كلّ ما تقوله خاطئ

173
00:11:50,250 --> 00:11:52,450
!أنت المبعوث السّابع

174
00:11:52,450 --> 00:11:56,420
!أرشدنا إلى القسَم المُقدّس الّذي صنعتَه مع العظيم

175
00:11:57,120 --> 00:11:59,360
!المُتعاقد الإلهي

176
00:12:09,390 --> 00:12:10,870
إنّه هنا الآن إذاً؟

177
00:12:10,870 --> 00:12:13,870
يتفعّل تأثير المُتعاقد الإلهي

178
00:12:13,870 --> 00:12:18,170
،إذا كان لديّ 2 أو أكثر من نقاط التطوُّر
يُنفى كافّة أتباع العدوّ

179
00:12:24,960 --> 00:12:27,140
هذا يعزّز من عدّاد المنفيّين

180
00:12:27,140 --> 00:12:30,310
