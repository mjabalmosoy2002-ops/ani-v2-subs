1
00:00:06,910 --> 00:00:13,380
،إذا كنت لا تستطيع أن تخبرني عن سبب قتالك
فلست بحاجة للحظّ السّعيد

2
00:00:13,710 --> 00:00:14,620
...ما يعني

3
00:00:16,040 --> 00:00:18,530
لِمَ يجب أن يعني ذلك؟

4
00:00:18,530 --> 00:00:20,050
!أنت تستفزّني

5
00:00:20,400 --> 00:00:23,190
!هذا الهُراء ليس سوى مجرّد ضجيج

6
00:00:25,410 --> 00:00:28,500
يتفعّل التّأثير الّذي اكتسبتُه بالمايسترو الشّيطان

7
00:00:28,500 --> 00:00:32,440
،في بداية دوري، يُلحِق 1 ضرراً بقائدي

8
00:00:32,440 --> 00:00:35,880
وإذا كان لديّ أربع بطاقات أو أقلّ
في يدي، أسحب بطاقة

9
00:00:36,110 --> 00:00:39,510
إنّه ليس هُراء. بل هو المهمّ بعينه

10
00:00:39,510 --> 00:00:41,170
اِخرس فحسب

11
00:00:42,760 --> 00:00:43,860
...أنا

12
00:00:44,690 --> 00:00:46,550
هل سمعتم الإشاعة؟

13
00:00:46,550 --> 00:00:49,760
تمّ إغلاق سيكاند بلود، صحيح؟

14
00:00:49,760 --> 00:00:51,530
إنّه مُخيف، أليس كذلك؟

15
00:00:52,360 --> 00:00:56,650
لا أبالي البتّة لضجيجك

16
00:00:57,320 --> 00:01:00,100
ألعب بالزمّار الشّيطانيّ مع تعزيز

17
00:01:00,100 --> 00:01:02,450
،تأثيره التّعزيزي يتحفّز

18
00:01:02,810 --> 00:01:06,520
ليجعلني أطرح بِطاقة وألحق 2 ضرراً بقائد العدوّ

19
00:01:09,790 --> 00:01:14,030
التّالي، هجومه ودفاعه يتعزّز بمقدار 2
ويحصل على تصفية

20
00:01:15,020 --> 00:01:16,700
ثمّ أطوِّره

21
00:01:22,380 --> 00:01:24,940
أهاجم الفارس النّجمي ضوء النّجم

22
00:01:27,470 --> 00:01:33,200
يسبّب تأثير التّصفية لقائدي استعادة
دفاع مكافئ للضرر المُلحَق

23
00:01:33,470 --> 00:01:37,900
—اسمع. سأردُّ الاعتبار منك. هذا كلُّ

24
00:01:37,900 --> 00:01:38,830
...شادوفارس

25
00:01:39,810 --> 00:01:42,890
تتطلّب شادوفارس إيماناً راسخاً

26
00:01:44,840 --> 00:01:48,240
شادوفارس من دون إيمان لا معنى لها

27
00:01:55,620 --> 00:01:59,540
يستدعي تأثيره دائم التطوُّر الفارسان الثّقيلان

28
00:02:01,030 --> 00:02:06,730
وفي كلّ مرّة يدخل فيها تابعٌ جنديٌّ
وضع اللّعب، يكسب قائدي دفاعاً بمقدار 1

29
00:02:07,450 --> 00:02:11,830
كويك بليدر مع عاصفة، ومُعارِك القمر المُتزايِد يُهاجِم

30
00:02:17,590 --> 00:02:22,600
...ريوغا جاسي. آمالي تجاهك
...الفُرص الّتي منحتُها لك

31
00:02:22,600 --> 00:02:25,480
كلّ هذا ينتهي هنا

32
00:03:57,910 --> 00:04:00,420
"سوف آخذك معي إلى حفرة الجحيم"

33
00:04:01,480 --> 00:04:04,930
!لن تكون أنت من ينهي ذلك

34
00:04:10,930 --> 00:04:13,380
...أنا الوحيد

35
00:04:24,440 --> 00:04:26,820
!الّذي يستطيع عزف النوتة الأخيرة

36
00:04:27,640 --> 00:04:30,210
!ألعب بغول لوحة المفاتيح

37
00:04:32,450 --> 00:04:37,850
يتفعّل تأثيره. إذا كنتُ في وضع الغضب، يتطوّر

38
00:04:45,010 --> 00:04:48,010
ويستعيد دفاع قائدي بمقدار 5

39
00:04:48,790 --> 00:04:51,840
غول لوحة المفاتيح يهاجم خيّال خطّ الجبهة

40
00:04:52,160 --> 00:04:56,060
ويتفعّل التأثير الهجومي الّذي
،حصلَ عليه من التطوُّر

41
00:04:56,340 --> 00:04:59,840
!ليُلحِق 2 ضرراً بقائد العدوّ وكلّ أتباعه

42
00:05:07,940 --> 00:05:09,630
!والآن دعني أسمع مرثاتك

43
00:05:09,860 --> 00:05:14,120
مرثاة أو نُواح. حزن على حالة العالم

44
00:05:14,470 --> 00:05:16,980
أعتقد هذا مثاليٌّ بالنسبة لي

45
00:05:17,630 --> 00:05:18,790
...لكن بالنسبة لك

46
00:05:20,710 --> 00:05:25,230
عزاء يشتعل بالشّغف أفضل بكثير

47
00:05:33,090 --> 00:05:34,840
بئساً. ما هذا؟

48
00:05:34,840 --> 00:05:37,610
بطاقة تعويذة: شحنة ضوء الشّمس

49
00:05:37,980 --> 00:05:42,280
أكشف بطاقة من يدي وأستعيد 1 نقطة لعب

50
00:05:43,130 --> 00:05:49,300
.يتفعّل تأثير الفارس الشّمسي ضوء الشّمس
عندما يُكشَف، أسحب بطاقة

51
00:05:50,070 --> 00:05:54,040
ويتفعّل التّأثير الثّاني لشحنة ضوء الشّمس

52
00:05:54,040 --> 00:05:58,330
إذا كشفتُ عن ضوء الشّمس ولديّ
،ستّ نقاط لعِب أو أكثر

53
00:05:58,830 --> 00:06:01,500
،يُنفى الفارس الشّمسي ضوء الشّمس

54
00:06:01,980 --> 00:06:04,390
وأضيف بطاقةً جديدةً إلى يدي

55
00:06:06,450 --> 00:06:08,920
ألعب بـ غاواين من الطاولة المُستديرة مع تعزيز

56
00:06:12,180 --> 00:06:17,360
تأثير تعزيزه يحسّن هجومه ودفاعه
بمقدار 1 ويمنحه فورة

57
00:06:17,360 --> 00:06:19,930
ثمّ يهاجم بـ مُعارِك القمر المُتزايد

58
00:06:22,060 --> 00:06:24,350
تأثير غاواين الهجوميّ؟

59
00:06:24,350 --> 00:06:28,230
خفّضَ تكلفة كلّ التّابعين القادة
العسكريّين في يدي بمقدار 1

60
00:06:34,650 --> 00:06:40,220
إذا كان ينقصك كلّ من الإدراك الذّاتي والصّواب
المطلوبين، ستحترق بالنّار القرمزيّة

61
00:06:40,220 --> 00:06:41,770
!اِخرس

62
00:06:43,870 --> 00:06:47,130
اِخرس وجارِ إيقاعي فحسب

63
00:06:48,920 --> 00:06:52,370
سأكون المغنِّي الرّئيسي ويمكنك
!أن تؤدّي الغناء الخلفي

64
00:06:52,370 --> 00:06:53,720
!الطبّال الشّيطانيّ

65
00:06:55,250 --> 00:06:57,260
!يتفعّل تأثير الغضب الخاص به

66
00:07:00,430 --> 00:07:02,950
يستدعي أربعة من الطبّال الشّيطانيّ

67
00:07:03,940 --> 00:07:07,500
يتطوّر ويهاجم مُعارِك القمر المُتزايد

68
00:07:23,180 --> 00:07:24,710
مِخلب الشّفرة

69
00:07:25,210 --> 00:07:30,590
يُلحِق 2 ضرراً بقائدي و3 ضرراً بقائد
العدوّ أو تابع له

70
00:07:30,880 --> 00:07:32,680
!لا تتكاسل

71
00:07:32,680 --> 00:07:37,510
!ما زال هناك لحن كي تعزفه بكامل قلبك وروحك

72
00:07:37,510 --> 00:07:40,510
...لن ينتهي الأمر حتّى تعتصر آخر ذرّة

73
00:07:43,530 --> 00:07:44,720
!ماذا؟

74
00:07:45,760 --> 00:07:48,100
الفارس القمريّ ضوء القمر؟

75
00:07:48,410 --> 00:07:50,570
،يكشف تأثيره عن بطاقة في يدي

76
00:07:51,110 --> 00:07:53,980
ويُلحِق ضرراً بمقدار 7 لكافّة أتباع العدوّ

77
00:07:54,390 --> 00:07:55,400
...ثمّ

78
00:07:56,810 --> 00:07:58,080
...هذا

79
00:07:58,080 --> 00:08:04,160
أجل. البطاقة الّتي أضفتُها إلى يدي بشحنة
ضوء الشّمس: ضوء الشّمس، سيف السّماء القرمزيّ

80
00:08:04,750 --> 00:08:08,080
الكشف عنه يفعِّل تأثيره

81
00:08:08,450 --> 00:08:11,030
أسحب بطاقة وأستعيد 1 نقطة لعِب

82
00:08:11,030 --> 00:08:14,190
ويُلحِق ضرراً بمقدار 3 لقائد العدوّ

83
00:08:22,000 --> 00:08:26,850
بتخفيض كلفته بواسطة غاواين، ألعب
بالمرّيخ، جنرال اللّهب الصَّامت

84
00:08:33,740 --> 00:08:39,480
الكلمات الأخيرة للخمسة الطبّالين الشّيطانيّين
المُدمَّرين الخمسة تستعيد دفاعي بمقدار 5

85
00:08:41,410 --> 00:08:42,440
لا جدوى من ذلك

86
00:08:43,650 --> 00:08:45,290
هذا كلّه مجرّد ضجيج

87
00:08:45,590 --> 00:08:47,670
—سوف أربح! هذه

88
00:08:47,670 --> 00:08:49,560
هذه "حقيقتك"؟

89
00:08:50,490 --> 00:08:53,960
لن تتمكّن من هزيمة الظِّلال السّبعة هكذا

90
00:08:54,400 --> 00:08:56,590
أنا متأكّدٌ بأنّك تعلم ذلك

91
00:08:57,250 --> 00:08:59,670
لكنّك تتظاهر بعدم رؤية ذلك

92
00:09:00,070 --> 00:09:01,510
!هذا إهمال لواجبك

93
00:09:11,600 --> 00:09:13,350
!تـ-توقّف

94
00:09:13,680 --> 00:09:16,080
!يمكنك الحصول على سيكاند بلود

95
00:09:16,080 --> 00:09:18,100
!لذا أرجوك، هذا يكفي

96
00:09:18,470 --> 00:09:21,360
لم نتقاتل سوى ثلاث مرّات

97
00:09:21,360 --> 00:09:22,810
هذا يكفي

98
00:09:23,310 --> 00:09:25,120
...أعلم

99
00:09:25,120 --> 00:09:27,740
أعلم بأنّني لا أستطيع هزيمتك أبداً

100
00:09:31,880 --> 00:09:34,250
جميعكم مُثيرون للشّفقة

101
00:09:34,250 --> 00:09:37,420
هذا ليس اللّحن الّذي أريده

102
00:09:39,850 --> 00:09:43,340
وحدك من تستطيع فتح الباب إلى تطوّرك

103
00:09:43,690 --> 00:09:47,680
!والآن ساعة الحكم قد اقتربت يا ريوغا جاسي

104
00:09:59,240 --> 00:10:00,360
...أنا

105
00:10:03,810 --> 00:10:05,000
...أنا

106
00:10:23,180 --> 00:10:25,070
لا أبالي

107
00:10:30,520 --> 00:10:32,640
!لا أبالي

108
00:10:40,620 --> 00:10:45,100
ما الّذي تعرفه عنّي بالضبط؟

109
00:10:50,030 --> 00:10:51,330
خاب أملي

110
00:10:51,850 --> 00:10:54,600
يسبّب تأثيره تطوُّر الشّيطان المُزمجِر

111
00:11:05,050 --> 00:11:07,550
!ثمّ ألعب بعازف البيس الدّمويّ

112
00:11:11,380 --> 00:11:14,050
يتفعّل تأثير عازف البيس الدّمويّ

113
00:11:14,050 --> 00:11:16,380
الضّرر التّالي الّذي أتلقّاه ينقص إلى صفر

114
00:11:16,750 --> 00:11:20,670
وإذا كنتُ في وضع الغضب، يحصل
على فورة وتصفية

115
00:11:22,580 --> 00:11:25,830
!عازف البيس الدّمويّ يهاجم ضوء القمر

116
00:11:29,080 --> 00:11:30,130
!تصفية

117
00:11:31,130 --> 00:11:34,630
وحصلَ الشّيطانُ المُزمجِر على عاصفة عندما تطوَّر

118
00:11:34,630 --> 00:11:36,460
!يُهاجم قائدك

119
00:11:39,660 --> 00:11:42,100
خاب أملي حقّاً

120
00:11:47,810 --> 00:11:50,780
،الشّيطان المُزمجِر يؤدِّي التّصفية

121
00:11:50,780 --> 00:11:54,870
وفي نهاية دوري، يتفعّل تأثير
،عازف البيس الدّمويّ

122
00:11:54,870 --> 00:11:59,070
ليجعلني أطرح البطاقة الأدنى كلفة
في يدي. اللّعنة

123
00:12:02,080 --> 00:12:04,850
أبحث عن النَّزاهة والإنصاف

124
00:12:05,290 --> 00:12:08,360
أمنح فُرصة لأولئك الّذين يتمتّعون بقيمة

125
00:12:10,120 --> 00:12:14,930
لكن سواء ينتهزون تلك الفُرص أم لا
فهذا أمر يعود لهم

126
00:12:15,440 --> 00:12:17,160
وقد خسرتَ فُرصتك

127
00:12:24,070 --> 00:12:30,020
يكشف تأثيرُ المُحارب الباحث عن الشّمس
عن بِطاقة في يدي ويكسب عاصفة

128
00:12:30,310 --> 00:12:34,810
وتأثير البطاقة الّتي كشفتُها، ضوء
الشّمس، سيف السّماء القرمزيّ، يتفعّل

129
00:12:35,730 --> 00:12:39,570
،أسحب بطاقة وأستعيد 1 نقطة للعِب

130
00:12:39,570 --> 00:12:41,730
ثمّ ألحِق 3 ضرراً بقائد العدوّ

131
00:12:53,250 --> 00:12:54,900
لا أعلِّق مزيداً من الآمال عليك

132
00:12:56,110 --> 00:12:58,700
سوف يسقط نجمٌ بلا قدر هنا

133
00:12:59,140 --> 00:13:01,240
الوداع يا ريوغا جاسي

134
00:13:01,760 --> 00:13:04,010
يلمع الضّوء الرّابع

135
00:13:04,010 --> 00:13:06,440
احكم على البشريّة جمعاء بلهيبك بالتّساوي

136
00:13:17,570 --> 00:13:19,940
!ضوء الشّمس، سيف السّماء القرمزيّ

137
00:13:25,400 --> 00:13:28,280
يتطوّر ضوء الشّمس، سيف السّماء القرمزيّ

138
00:13:37,200 --> 00:13:40,700
يمتلك ضوء الشّمس عاصفة ويهاجم قائدك

139
00:13:41,150 --> 00:13:43,700
يتحفّز تأثيره الهجوميّ

140
00:13:43,700 --> 00:13:49,220
،إذا حصلتُ على 3 نقاط لعِب أو أكثر
،أنفِق 3 نقاط لعِب لمنحه هجمة إضافيّة

141
00:13:49,220 --> 00:13:51,380
وإلحاق 3 ضرر بكافّة أتباع العدوّ

142
00:13:51,800 --> 00:13:53,090
!قطِّعهم إرباً

143
00:14:03,790 --> 00:14:06,450
!هاجِم مرّة أخرى يا ضوء الشّمس

144
00:14:21,950 --> 00:14:24,500
،ما زال لديك بعض الدّفاع

145
00:14:25,040 --> 00:14:26,900
لكن لا تملك إرادة لمواصلة القتال

146
00:14:33,650 --> 00:14:36,110
هل ترين هذا يا مارغريت؟

147
00:14:36,800 --> 00:14:38,940
لا جدوى من متابعة هذه المعركة

148
00:14:45,310 --> 00:14:46,860
حسناً إذاً

149
00:15:13,840 --> 00:15:16,130
سئمتُ منك

150
00:15:18,180 --> 00:15:22,260
أنت وهذه المعركة ستلقيان حتفكما هنا

151
00:15:41,780 --> 00:15:43,620
...اِخرس

152
00:15:48,460 --> 00:15:52,050
أنت مجرّد بيانات، اللّعنة. لماذا إذاً؟

153
00:15:57,840 --> 00:15:59,460
...أنت

154
00:16:11,510 --> 00:16:14,430
...هذه النّظرة الغبيّة في وجهك

155
00:16:14,820 --> 00:16:17,160
لا يسعني سوى السّخرية منها

156
00:16:18,540 --> 00:16:19,750
لا جدوى من ذلك

157
00:16:20,840 --> 00:16:25,300
خسارتك مضمونة. لا يستطيع قلب هذه اللّعبة

158
00:16:25,300 --> 00:16:29,530
اِخرس. أقول بأنّه سيطرأ تغيير للمقام

159
00:16:29,530 --> 00:16:32,050
ليس عليك أن تقول خِلاف ذلك

160
00:16:32,440 --> 00:16:35,980
ما أنت على وشك أن تسمعه هو
ارتجال أصيل حقيقيّ

161
00:16:35,980 --> 00:16:38,130
لذا افتح أذنيك

162
00:16:39,830 --> 00:16:41,140
اللّعنة

163
00:16:41,720 --> 00:16:46,020
سأعطيك جوابي. تريد أن تعرف
سبب لعِبي شادوفارس؟

164
00:16:46,440 --> 00:16:48,790
لماذا أقاتل؟

165
00:16:50,070 --> 00:16:53,530
!لمُقاتلة القويّ. هذا كلُّ ما في الأمر

166
00:16:53,530 --> 00:16:58,020
!هذا صحيح. إيقاعي لا يُبالي للفوز أو الخسارة

167
00:16:58,020 --> 00:16:59,520
فات الأوان

168
00:16:59,520 --> 00:17:03,950
لو أدركت ذلك قبل دور واحد فقط، لتمكّنتَ
—ربّما من تجنُّب الحكم

169
00:17:03,950 --> 00:17:06,030
!لا أبالي لما تعتقده

170
00:17:08,420 --> 00:17:12,910
أخبرتُك سلفاً. لستَ من سيعزف
النّوتة الأخيرة في هذه المعركة

171
00:17:12,910 --> 00:17:13,970
!سأكون أنا

172
00:17:14,340 --> 00:17:16,220
...سواء فزتُ أم خسرتُ

173
00:17:16,670 --> 00:17:19,130
!سوف أنهي هذه المعركة ببسمة في وجهي

174
00:17:21,440 --> 00:17:22,380
أنت

175
00:17:23,450 --> 00:17:26,900
سخرتَ منّي. أنت مستعدٌّ لدفع الثّمن، صحيح؟

176
00:17:27,360 --> 00:17:29,610
سوف آخذك معي إلى حفرة الجحيم

177
00:17:35,200 --> 00:17:36,110
فلنبدأ

178
00:17:36,540 --> 00:17:40,280
أوّلاً، تأثير المايسترو الشّيطان يجعلني أسحب بطاقة

179
00:17:40,600 --> 00:17:42,260
!شيطان ترومبون

180
00:17:46,360 --> 00:17:51,920
يتفعّل تأثيره ليُلحِق 1 ضرر بقائدي

181
00:17:52,970 --> 00:17:59,410
،وفي كلّ مرّة يتلقّى فيها قائدي ضرراً
!يُلحِق 1 ضرر بكافّة أتباع العدوّ

182
00:18:04,540 --> 00:18:08,870
عندما يميل الميزان، لا يمكن استعادة التّوازن

183
00:18:09,390 --> 00:18:11,890
والميزان يقول بأنّه سيُحكَم عليك

184
00:18:12,750 --> 00:18:13,940
وماذا يعني؟

185
00:18:14,280 --> 00:18:15,980
هذا يعني خسارتك

186
00:18:16,220 --> 00:18:19,560
سأكرّرها من جديد. ماذا يعني؟

187
00:18:19,560 --> 00:18:25,920
إنّ ضجيجاً مُمتعاً مجنوناً مثلك ومثله
يُشعِل لهيب إيقاعي بالفعل

188
00:18:26,160 --> 00:18:27,640
...وذلك اللّهيب

189
00:18:29,160 --> 00:18:32,290
!ذلك اللّهيب وحده هو كلّ ما أبالي له

190
00:18:32,290 --> 00:18:34,660
أليس كذلك يا ديمونيوم؟

191
00:18:40,990 --> 00:18:42,100
...هذا

192
00:18:42,740 --> 00:18:45,300
صديقه الرّقمي يبدو مُختلِفاً الآن؟

193
00:18:48,970 --> 00:18:54,340
لعلّك مجرّد بيانات، لكنّ إيقاعك ممتاز جدّاً

194
00:18:54,340 --> 00:18:55,020
!هيّا بنا

195
00:18:55,440 --> 00:18:57,870
ديمونيوم، يتفعّل تأثير الشّيطان السّاحق

196
00:18:57,870 --> 00:19:00,060
!وإذا كنتُ في وضع الغضب، يتطوّر

197
00:19:00,820 --> 00:19:04,020
!التطوّر يمنحه وارد وتصفية

198
00:19:04,330 --> 00:19:06,070
!غنِّ أغنيتك يا ديمونيوم

199
00:19:06,070 --> 00:19:08,490
!هاجم المُحارب الباحث عن الشّمس

200
00:19:18,640 --> 00:19:21,800
!ويستطيع ديمونيوم أن يهاجم مرّتين

201
00:19:22,440 --> 00:19:24,710
!هاجم ضوء الشّمس، سيف السّماء القرمزيّ

202
00:19:25,100 --> 00:19:26,820
!رُدّ يا ضوء الشّمس

203
00:19:31,920 --> 00:19:34,090
ديمونيوم لديه آفة

204
00:19:34,090 --> 00:19:35,720
!أدمِّر ضوء الشّمس

205
00:19:35,720 --> 00:19:38,000
لكن سيُدمَّر ديمونيوم أيضاً

206
00:19:41,820 --> 00:19:43,350
مُبهر

207
00:19:43,680 --> 00:19:47,280
أخيراً ارتقيتَ لآمالي

208
00:19:47,280 --> 00:19:52,310
ولهذا الأمر مُؤسف حقّاً. لا يمكنك هزيمتي الآن

209
00:19:52,310 --> 00:19:53,400
لا

210
00:19:53,970 --> 00:19:56,620
إيقاعي هو نبضة قلب شيطان

211
00:19:56,620 --> 00:19:58,850
يمكنك أن تسدَّ أُذنيك، لكن هذا لا يعني
ألّا تستطيع سماعها

212
00:19:59,060 --> 00:20:02,420
...لديه آفة ووارد وتصفية وهجمة مُزدوجة

213
00:20:02,420 --> 00:20:05,220
لكن هذا ليس كلّ ما لدى ديمونيوم

214
00:20:05,570 --> 00:20:08,080
،عندما يُهاجم تابعَ عدوّ

215
00:20:08,080 --> 00:20:12,140
يستطيع إلحاق نفس مقدار الضّرر
!بقائد العدوّ

216
00:20:18,830 --> 00:20:24,120
أنت... تتفوّق عليّ يا ريوغا جاسي؟

217
00:20:24,120 --> 00:20:26,220
كانت مجرّد ضربة حظّ، هذا كلُّ ما في الأمر

218
00:20:26,220 --> 00:20:30,290
!لكن الإيقاع الّذي أعزفه حقيقيّ

219
00:20:30,690 --> 00:20:35,290
!يُلحِق تأثير ديمونيوم 6 ضرراً بقائد العدوّ

220
00:20:35,830 --> 00:20:37,550
...هذا

221
00:20:37,550 --> 00:20:42,550
!هذا هو إيقاعي

222
00:20:45,460 --> 00:20:46,550
مُدهش

223
00:20:57,650 --> 00:20:59,100
أحمق

224
00:20:59,100 --> 00:21:01,300
أنت تضحك حتّى النّهاية

225
00:21:05,660 --> 00:21:06,860
هزمتَني

226
00:21:08,800 --> 00:21:11,450
لم تكن جلسة سيّئة

227
00:21:11,950 --> 00:21:16,660
وعلّمتَني بأنّني لستُ مثاليّاً

228
00:21:17,330 --> 00:21:19,010
هذا كلُّ شيء لليوم

229
00:21:19,630 --> 00:21:22,420
أتمنّى لكم جميعاً أنتم المُتحدّيون حظّاً طيّباً

230
00:21:32,130 --> 00:21:32,880
أنت

231
00:21:33,920 --> 00:21:37,180
لماذا تنظر إليّ هكذا؟

232
00:21:39,060 --> 00:21:40,520
لا يهمّ

233
00:21:40,950 --> 00:21:46,520
لا أقول هذا لأنّ ذلك الفتى الثريّ
أخبرني بذلك. أنا ممتنٌّ لك

234
00:21:48,330 --> 00:21:49,800
...و

235
00:21:50,250 --> 00:21:54,490
أعتذر على عدم تقدير إيقاعك إلى الآن

236
00:21:57,830 --> 00:22:02,010
في المرّة المُقبِلة، اعزف لي إيقاعاً
يفجّر عقلي. مفهوم؟

237
00:22:08,660 --> 00:22:12,290
ضحِكُك ينمُّ عن ضعف شديد

238
00:23:24,040 --> 00:23:25,720
!استعراض بطاقة شادوفارس

239
00:23:25,920 --> 00:23:26,550
—بطاقة اليـ

240
00:23:26,550 --> 00:23:29,860
بطاقة اليوم هي ديمونيوم، الشّيطان السّاحق

241
00:23:29,860 --> 00:23:33,460
إنّها بطاقتي، وإيقاعي ليس سيّئاً. هذا كلّ شيء

242
00:23:34,070 --> 00:23:35,460
لِمَ الضّحك؟

243
00:23:35,460 --> 00:23:37,090
لا شيء

244
00:23:37,090 --> 00:23:38,990
بئساً. أنت مجرّد ضجيج

245
00:23:39,260 --> 00:23:41,600
أتريد أن تكون بطلاً؟ تبدو كطفل

246
00:23:41,600 --> 00:23:44,230
!هذا لئيم! أنتِ أصغر منّي يا هينا

247
00:23:44,230 --> 00:23:45,730
لا تتكلّم معي هكذا

248
00:23:45,730 --> 00:23:48,480
حسناً إذاً... كيف يُفترَض بي أن أتكلّم معك؟

249
00:23:48,480 --> 00:23:51,840
،الحلقة القادمة: "إذا كان حُلواً جدّاً
"فسوف يُصيبك بحرقة معدة

250
00:23:51,840 --> 00:23:53,490
قِتال. شادوفارس