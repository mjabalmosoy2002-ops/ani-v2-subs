1
00:00:06,560 --> 00:00:09,920
لم تمنحني شيئاً أقلّ من قصارى جهدك يوماً

2
00:00:10,640 --> 00:00:15,150
مهما رفضتُك من مرّات، لم تتردّد يوماً

3
00:00:15,760 --> 00:00:20,670
من المُحبِط قليلاً أنّني لستُ أنا
من يواجهك الآن

4
00:00:21,170 --> 00:00:23,850
لكنّني الظّلام الّذي يقف بجانب نورك

5
00:00:23,850 --> 00:00:28,110
،إذا كان هذا يجعل ابتسامتك أكثر براقة
فهذا كلّ ما أحتاجه لأكون سعيداً

6
00:00:28,110 --> 00:00:31,750
لذا أرِه المزيد يا هيرو

7
00:00:31,750 --> 00:00:34,410
أرِه نورك. أرِه من تكون

8
00:00:34,720 --> 00:00:36,620
يا لكم من مجموعة جبناء

9
00:00:36,890 --> 00:00:38,820
!ما أحلى الفتوّة

10
00:00:39,090 --> 00:00:41,080
معركة مُبهرة

11
00:00:41,080 --> 00:00:43,140
من سيُثبِت بأنّه اللّاعب الأفضل؟

12
00:00:44,490 --> 00:00:47,800
ذات يوم، أريد خوض معركة كهذه مع أخي

13
00:00:48,100 --> 00:00:50,520
فهمت، فهمت، فهمت

14
00:00:50,520 --> 00:00:55,160
افترضتُ أنّه كان يخفي شيئاً، لكن
لم أتوقّع كلّ هذا

15
00:00:55,400 --> 00:00:59,160
وليس السيّد ريوغاساكي من يستحقّ
إطرائي فحسب

16
00:00:59,160 --> 00:01:02,470
سيّد يونازوكي، أنت ذكيٌّ جدّاً بحدِّ ذاتك

17
00:01:02,470 --> 00:01:07,870
كنتَ يقظاً تجاهي، أو ربّما تجاه السيّد
،زيرغا، أو ربّما حتّى تجاه الآنسة سينكلير

18
00:01:07,870 --> 00:01:12,380
وهكذا جعلت السيّد ريوغاساكي يُخفي قوّتَه الحقيقيّة

19
00:01:12,700 --> 00:01:19,480
لكن أليس من المُبكِّر جدّاً الكشف عن قوّته لنا؟

20
00:01:19,480 --> 00:01:23,580
من الأفضل إبقاء الورقة الرّابحة حتّى النّهاية

21
00:01:23,580 --> 00:01:27,320
لا، هذا غير صحيح. هذه هي اللّحظة الصّحيحة

22
00:01:27,320 --> 00:01:32,790
خلقتَ وضعاً حيث سيُركِّز كلُّ الظّلال
،السّبعة على معركته

23
00:01:32,790 --> 00:01:36,160
وحيث نرى بأمّ أعيننا كم أصبح قويّاً

24
00:01:36,160 --> 00:01:39,030
تحاول ترهيبنا، أليس كذلك؟

25
00:01:39,880 --> 00:01:42,940
هذه طريقتك في إخبارنا بأن نحسن التصرُّف

26
00:01:43,160 --> 00:01:47,930
هذا ما أتوقّعه من الأبطال الّذين أنقذوا
العالم. يمكنني احترام ذلك

27
00:01:47,930 --> 00:01:52,590
لكن ما زلتُ لا أتّفق مع تدمير الآرك

28
00:01:54,180 --> 00:01:58,780
.أنا كبيركم في نهاية المطاف
لن أخسر أمام مجموعة أطفال

29
00:02:01,690 --> 00:02:05,380
البهجة. عاطفة انتهيتُ من تحليلها سلفاً

30
00:02:05,670 --> 00:02:08,130
لستُ مثل ليون أورانشي

31
00:02:08,130 --> 00:02:10,870
لديّ قلب. لديّ لطف

32
00:02:10,870 --> 00:02:12,150
لديّ قلب لطيف

33
00:02:12,720 --> 00:02:17,050
لذا إذا كانت هناك احتمالات مجهولة
...خفيّة حتّى ضمن معلومات معروفة

34
00:02:17,050 --> 00:02:19,820
!فسوف أشاهد هذه المعركة حتّى النّهاية

35
00:02:19,820 --> 00:02:25,370
والآن من سيكون الرّابح؟ هذا
كلّ ما أحتاج لرؤيته

36
00:03:31,070 --> 00:03:33,980
"!سأكرِّس كلّ مشاعري في هذا السّحب"

37
00:03:37,090 --> 00:03:38,970
!ها أنا ذا يا لايت

38
00:03:38,970 --> 00:03:40,840
!لم ينتهِ تطوُّري بعد

39
00:03:44,520 --> 00:03:45,580
...أيُعقَل

40
00:03:47,000 --> 00:03:50,570
!هذه هي قوّة التنّين إغنيس المُطوَّر

41
00:03:57,730 --> 00:04:00,230
،إذا كانت نقاط لعِبي القصوى 10

42
00:04:00,230 --> 00:04:07,570
يمكنني إنفاق نقطة تطوّر لتحويل التنّين
إغنيس إلى التنّين إغنيس نوفا

43
00:04:13,550 --> 00:04:14,690
هذا هو إذاً

44
00:04:14,690 --> 00:04:19,060
هذا هو الشّكل الحقيقيّ لأفضل
!بطاقة لك! شريكك

45
00:04:19,060 --> 00:04:20,280
!أجل

46
00:04:20,280 --> 00:04:25,180
لم أستخدم هذا التّأثير منذ ذلك
!اليوم، لذلك أنا متحمّس جدّاً

47
00:04:25,180 --> 00:04:26,710
!ها أنا ذا يا لايت

48
00:04:26,710 --> 00:04:28,550
!أجل، تعال إليّ يا هيرو

49
00:04:28,790 --> 00:04:33,610
التنّين إغنيس نوفا يهاجم التنّين
!ليفاتين، الشّكل المُزدوج بيتا

50
00:04:34,920 --> 00:04:40,330
ينقص كلّ الضّرر المُلحَق بالشّكل المُزدوَج
بيتا بمقدار 10

51
00:04:41,620 --> 00:04:42,790
هل يمكنك التغلُّب على ذلك؟

52
00:04:42,790 --> 00:04:43,960
!بالطبع

53
00:04:44,350 --> 00:04:47,790
،يتحفّز التّأثير الهجومي للتنّين إغنيس نوفا

54
00:04:47,790 --> 00:04:52,690
ليعزّز هجومه بمقدار 1 مقابل كلّ تابع
تنِّين دُمِّرَ في هذه المعركة

55
00:04:54,160 --> 00:04:59,360
!ويلحق ضرراً مكافئاً لهجومه بكافّة أتباع العدوّ

56
00:04:59,790 --> 00:05:03,870
!زمجِر! ازأر! التنّين إغنيس نوفا

57
00:05:25,940 --> 00:05:27,300
في هجمة واحدة؟

58
00:05:27,300 --> 00:05:29,760
!يـ-يا لها من هجمة مُبهرة

59
00:05:29,760 --> 00:05:34,250
،وفي نهاية دوري، يتفعّل تأثير وادي التّنانين

60
00:05:34,250 --> 00:05:36,050
!ليستدعي تنّيناً

61
00:05:41,430 --> 00:05:43,660
حالة رقعته فظيعة الآن

62
00:05:43,660 --> 00:05:46,660
أجل، لكن هذا ليس كلّ شيء

63
00:05:46,660 --> 00:05:50,710
أنا متأكّدة بأنّ لديه غضب مُزدوَج واحد
في مجموعة بطاقاته فقط، صحيح؟

64
00:05:50,710 --> 00:05:53,980
يستطيع استخدام الدّرع المُطهِّر للحصول
على التنّين ليفاتين ثانية، صحيح؟

65
00:05:53,980 --> 00:05:55,880
...لكن من دون الغضب المُزدوج

66
00:05:56,170 --> 00:05:58,530
لا يستطيع استخدام الشّكل المُزدوج

67
00:05:59,710 --> 00:06:02,750
يبدو أنّنا نقترب حقّاً من النّهاية

68
00:06:06,200 --> 00:06:09,870
هذا سيّئ. هذا أكبر خطر حدّقَ به على الإطلاق

69
00:06:10,330 --> 00:06:12,170
...لكن لايت

70
00:06:12,390 --> 00:06:14,260
...أجل، لايت

71
00:06:14,520 --> 00:06:17,140
!لايت لم يستسلم بعد

72
00:06:17,380 --> 00:06:19,830
الأفضل أن نكون مبتهجين بدلاً
من الاستسلام فحسب، صحيح؟

73
00:06:19,830 --> 00:06:23,750
!لم يكن ذلك مثلي من قبل، يمكنك فعلها يا لايت

74
00:06:23,750 --> 00:06:26,370
!نشجِّعك بأقصى طاقتنا

75
00:06:26,370 --> 00:06:28,970
عليك الفوز! بعد أن قطعتَ هذا الشّوط

76
00:06:28,970 --> 00:06:31,360
!يـ-يـ-يـ-يمكنك فعلها

77
00:06:31,600 --> 00:06:36,520
مُقاتلة القويّ فعلاً هي اللّحن
الّذي تحتاجه شادوفارس

78
00:06:36,520 --> 00:06:38,410
!استمتع حتّى آخر لحظة

79
00:06:38,680 --> 00:06:39,790
...لايت

80
00:06:39,790 --> 00:06:42,410
لايت، نحن هنا

81
00:06:42,410 --> 00:06:44,330
!لايت

82
00:06:44,590 --> 00:06:46,330
!أجل! شكراً

83
00:06:46,570 --> 00:06:49,700
بفضلكم جميعاً أقف هنا اليوم

84
00:06:49,700 --> 00:06:51,880
...سأكرّس مشاعر الامتنان هذه

85
00:06:52,390 --> 00:06:54,680
!سأكرّس كلّ مشاعري في هذا السّحب

86
00:06:56,100 --> 00:06:58,560
سأتفوّق على الفُرصة والحتميّة

87
00:06:58,560 --> 00:06:59,640
...وسوف

88
00:06:59,640 --> 00:07:02,120
!أتفوّق على هيرو

89
00:07:10,690 --> 00:07:11,980
الغضب المُزدوج؟

90
00:07:12,360 --> 00:07:16,090
تلك بطاقة خاصّة صنعتها شركة جينيسيس

91
00:07:16,090 --> 00:07:18,750
لا يوجد سوى واحدة في العالم

92
00:07:18,750 --> 00:07:20,370
لهذا لسّبب إذاً

93
00:07:20,370 --> 00:07:21,830
...إنّه

94
00:07:21,830 --> 00:07:24,830
،سحبتَ البطاقة منذ تلك اللّحظة
أليس كذلك يا لايت؟

95
00:07:25,060 --> 00:07:27,840
أجل. خطرت على بالي

96
00:07:34,500 --> 00:07:38,720
البطاقة الّتي نسختها بطاقة قوم التنّين ذوي
...النّصل المُزدوج وأخفضت كلفتها كانت

97
00:07:39,240 --> 00:07:40,290
!الغضب المُزدوج

98
00:07:40,290 --> 00:07:41,990
!كانت في مجموعة بطاقاتي طوال هذا الوقت

99
00:07:42,390 --> 00:07:43,640
...لايت

100
00:07:43,640 --> 00:07:45,760
!أحسنت يا لايت

101
00:07:45,760 --> 00:07:49,790
!أرِهم بأنّ شادوفارس مُلكك وحدك

102
00:07:49,790 --> 00:07:51,410
!هيّا بنا يا هيرو

103
00:07:51,410 --> 00:07:53,810
!هذا دورنا الأخير

104
00:07:54,110 --> 00:07:56,930
!ألعب ببطاقة التّعويذة، الدّرع المُطهِّر

105
00:07:58,140 --> 00:08:05,780
تضيف نسخة من التّابع المُسلّح ذي الكلفة
العليا الّذي دُمِّر في هذه المعركة إلى يدي

106
00:08:05,780 --> 00:08:10,690
وتستدعي أيضاً سلاحاً دراكونيّاً
!وتسترجع نقطة تطوُّر واحدة

107
00:08:11,220 --> 00:08:13,930
ثمّ ألعب ببطاقة التّعويذة هذه

108
00:08:14,940 --> 00:08:16,590
!الغضب المُزدوج

109
00:08:19,440 --> 00:08:22,850
أطرح التنّين ليفاتين من يدي

110
00:08:29,850 --> 00:08:35,750
أنفق نقطة تطوُّر واحدة، وأدمِّر سلاحَين دراكونيّين
،لديّ في وضع اللّعب

111
00:08:35,750 --> 00:08:38,340
ثمّ أختار أي شكل أريد أن ألعب به

112
00:08:39,160 --> 00:08:41,370
أيُّهما ستختار؟ بيتا من جديد؟

113
00:08:41,790 --> 00:08:43,450
أم آلفا؟

114
00:08:43,680 --> 00:08:46,570
...لا، المستقبل الّذي أختاره هو

115
00:08:46,570 --> 00:08:47,690
!هذا

116
00:08:56,380 --> 00:08:59,350
!أنياب هائجة ونفخة مُمزِّقة

117
00:09:01,500 --> 00:09:04,820
!التنّين ليفاتين، الشّكل المُزدوج غامّا

118
00:09:05,660 --> 00:09:07,590
!الشّكل المُزدوج الثّالث

119
00:09:07,590 --> 00:09:09,270
!مُذهل

120
00:09:09,270 --> 00:09:11,570
هذه أفضل بطاقة لديك إذاً؟

121
00:09:11,800 --> 00:09:12,600
!أجل

122
00:09:12,600 --> 00:09:15,150
!إنّها غاية في الرّوعة

123
00:09:15,150 --> 00:09:17,720
عاصفة. تأثير هجوميّ

124
00:09:17,720 --> 00:09:20,660
!حتّى أنّها لديها قوّة جعل البطاقات الأخرى أقوى

125
00:09:21,270 --> 00:09:23,860
لكن هجومها هو 6 فقط

126
00:09:24,190 --> 00:09:25,630
!ما زال لديّ 10 دفاع

127
00:09:26,030 --> 00:09:29,000
!لا تستطيع أفضل بطاقة لديك هزيمتي يا لايت

128
00:09:29,000 --> 00:09:34,370
أجل، هذا صحيح. لا أستطيع إنهاء هذه المعركة
بالشّكل المُزدوج غامّا وحده

129
00:09:34,370 --> 00:09:38,180
لكن لديّ بطاقات أخرى غير بطاقتي
الأفضل يا هيرو

130
00:09:38,970 --> 00:09:41,380
ما زال لديّ شريكي

131
00:09:46,480 --> 00:09:48,260
وهذا هو شريكي

132
00:09:49,640 --> 00:09:52,110
!ألعب بدراكونير، تنّين البُرجُمة

133
00:09:55,820 --> 00:10:00,540
يتفعّل تأثير دراكونير، ليُضيف سلاحاً
دراكونيّاً إلى يدي

134
00:10:00,910 --> 00:10:03,480
،يتفعّل تأثير الشّكل المُزدوج غامّا

135
00:10:03,480 --> 00:10:08,290
ليمنح عاصفة لكافّة الأتباع المُسلّحين
ما داموا في وضع اللّعب

136
00:10:08,760 --> 00:10:10,460
!مُبهِر

137
00:10:10,460 --> 00:10:11,400
—لكن رغم ذلك

138
00:10:11,400 --> 00:10:12,380
...وبالإضافة إلى ذلك

139
00:10:12,380 --> 00:10:15,210
،إذا كان لديّ سلاح دراكونيّ في يدي

140
00:10:15,210 --> 00:10:18,620
!فإنّه يعزِّز هجوم أي تابع بعاصفة بمقدار 2

141
00:10:26,430 --> 00:10:29,020
!مُذهل. أنت مذهل يا لايت

142
00:10:29,020 --> 00:10:31,820
هذه ليست قوّتي وحدها يا هيرو

143
00:10:31,820 --> 00:10:36,400
لم أعرف ما إن كان بمقدوري سحب
الغضب المُزدوج حتّى آخر لحظة

144
00:10:36,400 --> 00:10:38,350
بصراحة، كنتُ خائفاً

145
00:10:38,350 --> 00:10:43,410
لو كنتُ بمفردي، لرُبّما ما تمكّنتُ حتّى
من لمس مجموعة بطاقاتي

146
00:10:43,410 --> 00:10:46,620
لذا هذا ليس نصري وحدي فحسب

147
00:10:46,620 --> 00:10:50,420
...إنّه ينتمي لي، لدراكونير، للتنّين ليفاتين

148
00:10:50,420 --> 00:10:53,420
!ولنا جميعاً

149
00:10:58,810 --> 00:11:01,170
!أجل، هذا رائع

150
00:11:01,480 --> 00:11:04,560
!والآن أنهِ هذا بيديك يا لايت

151
00:11:04,560 --> 00:11:07,040
!أنهِ المعركة الّتي تربطنا

152
00:11:07,240 --> 00:11:10,660
...أجل! ثمّ يا هيرو، بيدَي، سوف أبدأ

153
00:11:10,660 --> 00:11:12,870
!بما يظهر عقب هذه المعركة

154
00:11:12,870 --> 00:11:15,680
!الشّكل المُزدوج غامّا يهاجم قائدك

155
00:11:17,070 --> 00:11:21,820
وعندما يفعل ذلك، يُلحِق ضرراً
بكافّة أتباع العدوّ مكافئاً لعدد

156
00:11:21,820 --> 00:11:24,930
!الأتباع المُسلّحين الّذين دُمِّروا في هذه المعركة

157
00:11:52,310 --> 00:11:54,760
التّأثير الهجوميّ للشّكل المُزدوج غامّا؟

158
00:11:56,950 --> 00:11:59,530
شكراً أيُّها التنّين إغنيس

159
00:12:04,140 --> 00:12:06,070
أنت أيضاً يا لايت. شكراً

160
00:12:12,650 --> 00:12:14,970
!دراكونير يهاجم قائدك

161
00:12:28,500 --> 00:12:32,140
كانت هذه أفضل معركة على الإطلاق

162
00:12:52,590 --> 00:12:54,160
!لايت

163
00:12:58,760 --> 00:13:00,280
!لايت

164
00:13:03,880 --> 00:13:07,510
أتريد الانضمام لهم يا حضرة الرّئيس؟

165
00:13:07,510 --> 00:13:09,880
أنت بغيض جدّاً، أتعلم ذلك؟

166
00:13:09,880 --> 00:13:12,430
حتّى إيقاع مُزعج يبقى ضمن إطار الموسيقى

167
00:13:12,680 --> 00:13:14,600
هل أنت بخير يا لايت؟

168
00:13:14,600 --> 00:13:16,270
أجل. هذا ما أعتقده

169
00:13:16,670 --> 00:13:20,770
،ما زلتُ لا أستطيع تصديق ذلك
لكنّني أعتقد بأنّني ربحت

170
00:13:20,770 --> 00:13:22,750
تعتقد"؟"

171
00:13:22,750 --> 00:13:25,600
!أجل، هذا صحيح! ربحتَ يا لايت

172
00:13:25,600 --> 00:13:28,410
!كان نصراً عظيماً، أيُّها الأبله

173
00:13:30,420 --> 00:13:34,510
كانت معركة مُدهشة. كان من الواضح
كم بذلت كلّ ما بوسعك فيها

174
00:13:34,740 --> 00:13:37,240
!كنتَ غاية في الرّوعة

175
00:13:37,240 --> 00:13:40,010
!رائع مثل باتل فينسر

176
00:13:40,010 --> 00:13:43,980
في الواقع... أرى أنّك أبليت بلاء حسناً حقّاً

177
00:13:44,500 --> 00:13:46,490
يمكنك القول، أتقنت العمل بمثاليّة

178
00:13:46,490 --> 00:13:48,590
مهلاً، لا تتكلّمي مثل الرّجل النّبيل

179
00:13:48,590 --> 00:13:51,200
لـ-لم تمدحيه كما ينبغي أيضاً

180
00:13:51,200 --> 00:13:53,900
ماذا؟ أجل، لكن يُسمَح لي

181
00:13:54,350 --> 00:13:56,020
!ماذا؟ هذا ليس عدلاً

182
00:13:56,020 --> 00:13:57,740
!إنّها غير صادقة حيال مشاعرها

183
00:13:59,980 --> 00:14:02,230
،إذا تعرّضَ العالمُ لخطر من جديد

184
00:14:02,230 --> 00:14:07,230
فأعلم أنّني أستطيع الاعتماد عليك
يا لايت... لا، بل عليكم جميعاً

185
00:14:07,550 --> 00:14:09,280
تعلّمتُ ذلك في معركتنا

186
00:14:09,510 --> 00:14:12,700
وشعرتُ كم كانت مشاعرك نقيّة يا هيرو

187
00:14:12,700 --> 00:14:15,450
...قرارك لتدمير الآرك

188
00:14:15,450 --> 00:14:18,920
أفهم الآن بأنّ جوابك بحت

189
00:14:18,920 --> 00:14:19,770
فهمت

190
00:14:19,770 --> 00:14:21,650
إذاً، ماذا ستفعل؟

191
00:14:21,650 --> 00:14:24,800
جوابك هو مُلكك وحدك

192
00:14:25,280 --> 00:14:28,650
سأبحث عن جواب يكون مُلكي وحدي

193
00:14:28,650 --> 00:14:32,030
،وإذا أمسى مختلفاً عن جوابك

194
00:14:32,030 --> 00:14:35,550
لنتقاتل من جديد. لأنّ هذا هو نحن

195
00:14:36,840 --> 00:14:39,920
أجل، معك حقّ

196
00:14:43,120 --> 00:14:44,180
ما هذا؟

197
00:14:46,610 --> 00:14:50,310
فئة شادوفارس الثّامنة، مصنوعة البوّابة

198
00:14:50,310 --> 00:14:51,810
لديكم الحقّ في استخدامها الآن

199
00:14:53,800 --> 00:14:57,770
استغرقَ ذلك وقتاً، لكن هذه مكافأتكم على الحلول
في المركز الأوّل في التّصنيف العالمي

200
00:14:57,770 --> 00:15:01,110
يمكنكم استخدام مصنوعة البوّابة الآن

201
00:15:01,110 --> 00:15:04,890
وهذه. بيانات ذاكرة دراكونير

202
00:15:05,170 --> 00:15:07,630
هذه آخر واحدة لدينا

203
00:15:07,630 --> 00:15:11,950
آسف. أصرّ ولفرام على فعلها بهذه الطريقة

204
00:15:11,950 --> 00:15:14,840
كان الأفضل أن أسلّمها لكم فحسب

205
00:15:15,380 --> 00:15:20,340
لا، شكراً لك على إعطائي كلّ من مصنوعة
البوّابة وصندوق البيانات هذا يا هيرو

206
00:15:20,340 --> 00:15:23,850
شكراً لك أيضاً. أنا مسرور لأنّني
تمكّنتُ من اللّقاء بك يا لايت

207
00:15:28,040 --> 00:15:29,980
كانت معركة ممتازة، أليس كذلك؟

208
00:15:32,880 --> 00:15:33,860
!سيّدتي

209
00:15:33,860 --> 00:15:34,680
آين؟

210
00:15:42,030 --> 00:15:43,460
سأرسل البيانات حالاً

211
00:15:44,490 --> 00:15:47,890
عزَلْنا إشارةَ الرّنين. جاري حساب الإحداثيّات

212
00:15:58,500 --> 00:16:02,650
BSL-JT-IFSF :الإحداثيّات

213
00:16:02,650 --> 00:16:05,890
في الجانب الشّمالي من منطقة الظلّ

214
00:16:06,890 --> 00:16:10,160
!يظهر الآرك في منطقة التنِّين

215
00:16:23,400 --> 00:16:25,170
ما-ما هذا؟

216
00:16:25,520 --> 00:16:26,540
الآرك

217
00:16:32,000 --> 00:16:34,390
شُوِّشت اتّصالاتنا؟

218
00:16:36,060 --> 00:16:37,170
...هيرو

219
00:16:37,170 --> 00:16:39,860
حاليّاً، سوف آخذه

220
00:16:39,860 --> 00:16:41,350
...يمكننا التكلُّم لاحقاً

221
00:16:46,460 --> 00:16:49,150
،قبل صعود الآرك العظيم

222
00:16:49,470 --> 00:16:51,690
يجب أن نختار أوّلاً من يحقّ له الذّهاب

223
00:16:55,250 --> 00:16:56,020
!هيرو

224
00:16:57,480 --> 00:16:59,110
من أنت؟

225
00:16:59,440 --> 00:17:01,850
المُختار سينجو

226
00:17:01,850 --> 00:17:06,630
أولئك الّذين لم يتمّ اختيارهم سيغرقون
في فيضانات عديمة الرّحمة

227
00:17:06,900 --> 00:17:09,740
كان البشر من صنعوا هذه الآرك

228
00:17:09,740 --> 00:17:12,870
لكن أنا من يختار الرُكَّاب

229
00:17:12,870 --> 00:17:15,130
عـ-عمّاذا تتكلّم؟

230
00:17:15,130 --> 00:17:17,070
أتكلّم عن الإله

231
00:17:19,440 --> 00:17:21,910
اذكروا اسمي من جديد

232
00:17:21,910 --> 00:17:24,210
أنا حاكم الآرك

233
00:17:24,210 --> 00:17:27,740
كنتُ تمثيليّاً في السّابق، والآن قاضٍ

234
00:17:28,140 --> 00:17:30,860
أوّلاً، يجب أن أشكركم أيُّها البشر

235
00:17:30,860 --> 00:17:34,400
بفضلكم أصبحتُ ما أنا عليه اليوم

236
00:17:34,800 --> 00:17:40,490
ويجب أن أخبركم أيُّها البشر بأنّني لم أختركم

237
00:17:40,490 --> 00:17:44,290
هل ستستخدم الآرك لاسترجاع شجرة الغمّ؟

238
00:17:44,550 --> 00:17:49,930
لا، لن أفعل. لا حاجة لأي كائن خارق غيري

239
00:17:49,930 --> 00:17:52,480
ولا أنوي الاعتماد على نيكساس

240
00:17:55,610 --> 00:17:57,260
ما الخطب يا دراكونير؟

241
00:18:00,650 --> 00:18:02,260
ماذا فعلتَ بدراكونير؟

242
00:18:02,680 --> 00:18:05,330
أعدِّله

243
00:18:05,330 --> 00:18:08,730
سيُشكِّل أكبر من مجرّد تأثير عليه

244
00:18:08,730 --> 00:18:11,770
بالطبع، سيترتّب عليّ تجاهل أي أخطاء ثانويّة

245
00:18:12,110 --> 00:18:16,120
،بعد تحليل مقدار واسع من البيانات
توصّلتُ إلى استنتاج

246
00:18:16,120 --> 00:18:19,560
أنتم البشر غير جديرين بالآرك

247
00:18:19,560 --> 00:18:22,800
أنتم غير جديرين بهذا العالم حتّى

248
00:18:23,030 --> 00:18:23,920
...بالتّالي

249
00:18:31,600 --> 00:18:36,210
بالتّالي، سوف أصبح الفيضان
الّذي سوف تغرقون فيه

250
00:18:40,640 --> 00:18:42,340
!ا-الأصدقاء الرّقميّون

251
00:18:42,600 --> 00:18:45,120
هـ-هذا غير ممكن، صحيح؟

252
00:18:45,120 --> 00:18:47,390
!إنّها رسوم حاسوبيّة! إنّها غير حقيقيّة

253
00:18:47,390 --> 00:18:49,970
يا لها من ردّة فعل مُبهرة

254
00:18:57,160 --> 00:19:01,510
لكن لا أملك بعد وظيفة توليد الأكاذيب

255
00:19:01,510 --> 00:19:05,010
لستُ بحاجة لها. لذا إنّها الحقيقة

256
00:19:05,010 --> 00:19:07,080
سوف يُعاد تصنيع العالم

257
00:19:08,750 --> 00:19:11,730
لكن سيستغرق ذلك وقتاً

258
00:19:11,730 --> 00:19:15,100
استمتعوا بما بقي لديكم من وقت قصير

259
00:19:19,590 --> 00:19:21,670
هل جميعكم بخير؟

260
00:19:21,670 --> 00:19:23,240
مارغريت؟

261
00:19:26,390 --> 00:19:28,150
أنا بخير الآن

262
00:19:30,050 --> 00:19:32,300
أجل، أعتقد بأنّنا بخير

263
00:19:32,680 --> 00:19:36,050
هذا جيّد. ابقوا هادئين وأصغوا إليّ

264
00:19:36,050 --> 00:19:40,910
،عمّت الفوضى في العالم
ونيكومي-تشو هي بؤرتها

265
00:19:41,490 --> 00:19:43,210
...إذاً ذلك المقطع لم يكن

266
00:19:43,210 --> 00:19:47,080
حقّاً؟ الأصدقاء الرّقميّون يهاجمون النّاسَ فعلاً؟

267
00:19:48,400 --> 00:19:50,520
كنتم مُدركين ذلك سلفاً إذاً؟

268
00:19:50,520 --> 00:19:56,060
صحيح. خرجَ الأصدقاء الرّقميّون
عن السّيطرة ويهاجمون النّاس

269
00:19:57,690 --> 00:20:00,260
لكن هناك طريقة لإيقافهم. صحيح؟

270
00:20:00,710 --> 00:20:02,080
هذا صحيح

271
00:20:02,550 --> 00:20:09,630
كلّ الظِّلال السّبعة باستثناء هيرو ريوغاساكي
ولوكا يونازوكي في طريقهم بالفعل

272
00:20:10,060 --> 00:20:12,670
،سيدافعون عن نيكومي

273
00:20:12,670 --> 00:20:16,810
حيث تعتقد شركة جينيسيس أنّ الضّرر سيكون الأكبر

274
00:20:17,320 --> 00:20:20,930
لكن لا يستطيعون فعل ذلك بمفردهم

275
00:20:20,930 --> 00:20:24,710
لا سيّما بما أنّنا نستطيع التأكُّد
بأنّ الأمور سوف تسوء فحسب

276
00:20:25,040 --> 00:20:30,130
لذا نحتاج مساعدة من الأشخاص
الّذين هزموا الظّلالَ السّبعة

277
00:20:30,870 --> 00:20:32,950
لدينا شخص في الطريق ليقلكم

278
00:20:33,270 --> 00:20:35,420
أسرعوا إلى هذه الإحداثيّات

279
00:20:35,420 --> 00:20:37,810
سأشرح الخطّة عندما تصلون إلى هناك

280
00:20:43,790 --> 00:20:45,570
الوداع حاليّاً

281
00:20:49,840 --> 00:20:53,620
الخطّة؟ بالكاد لدينا واحدة

282
00:20:53,620 --> 00:20:55,800
أنا آسفة جدّاً

283
00:20:55,800 --> 00:21:00,620
ليتنا تمكنّا من تحليل ما كان يجري
...للـ دي.ف في وقت أبكر قليلاً

284
00:21:01,010 --> 00:21:05,660
أشعر باشمئزاز من نفسي أكثر
من خوفي ممّا يجري

285
00:21:05,660 --> 00:21:08,300
،كان ينبغي أن أعلم بأنّ هذا سيحدث

286
00:21:08,300 --> 00:21:12,740
وبأنّني كنتُ أضعف من أن أغيّر
الأشياء من البداية

287
00:21:13,210 --> 00:21:16,830
لا أملك ذاكرة عن الكارثة السّابقة

288
00:21:16,830 --> 00:21:21,200
كلّ ما رأيتُه كان البيانات بعد أن علمتُ عنها
من هيرو ريوغاساكي وأصدقائه

289
00:21:21,200 --> 00:21:23,820
لم يتمّ اختياري

290
00:21:23,820 --> 00:21:24,810
سيّدتي

291
00:21:25,900 --> 00:21:27,120
هل تفقدين الأمل؟

292
00:21:29,360 --> 00:21:33,820
جميعكم، استمرّوا في مراقبة الوضع
بتركيز مُحدَّد على نيكومي

293
00:21:33,820 --> 00:21:37,010
واستعدّوا لتنصيب نِظام نيكسا

294
00:21:37,250 --> 00:21:38,110
!حاضر

295
00:21:40,550 --> 00:21:43,510
لا بدّ أنّني أسبّب الكثير من المشاكل
لكِ نظراً لكوني ضعيفة يا آين

296
00:21:43,510 --> 00:21:47,240
لا أمانع. قرّرتُ دعمكِ بكلّ ما أوتيت من قوّة

297
00:23:22,080 --> 00:23:23,910
!استعراض بطاقة شادوفارس

298
00:23:23,910 --> 00:23:27,230
،بطاقة اليوم هي التنّين ليفاتين
الشّكل المُزدوج بيتا

299
00:23:27,230 --> 00:23:30,440
إنّه تابعٌ قويّ يمكنك اللّعب به
باستخدام الغضب المُزدوج

300
00:23:30,440 --> 00:23:34,100
.إنّه الشّكل الجديد للتنّين ليفاتين
!إنّه غاية في الرّوعة

301
00:23:34,100 --> 00:23:37,020
!أجل! بهذه البطاقة، سوف أنقذ العالم

302
00:23:37,020 --> 00:23:39,780
لايت، ماذا سيحدث للعالم والأصدقاء الرّقميّين؟

303
00:23:39,780 --> 00:23:42,230
لا تشعر بالإحباط يا دراكونير. ما زال هناك أمل

304
00:23:42,230 --> 00:23:46,590
أعلم بأنّ جميعنا سنجد الأمل حيث
سنذهب، لذا لنبقَ مشدودي الظّهر

305
00:23:46,590 --> 00:23:48,020
!سأبذل قصارى جهدي أيضاً

306
00:23:48,020 --> 00:23:50,170
"!الحلقة القادمة: "سأنقذ الجميع

307
00:23:50,170 --> 00:23:51,560
!قِتال! شادوفارس