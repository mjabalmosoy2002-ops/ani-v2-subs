1
00:00:06,140 --> 00:00:10,410
تسوباسا! كان الظّلال السّبعة رائعين، أليس كذلك؟

2
00:00:10,410 --> 00:00:11,620
أجل، معكِ حقّ

3
00:00:11,620 --> 00:00:15,980
كازاماتسوري، قاتلتِ هينا من الظّلال السّبعة، صحيح؟

4
00:00:16,250 --> 00:00:20,250
!أجل، فعلت! هينا قويّة جدّاً

5
00:00:20,250 --> 00:00:22,630
!وظريفة للغاية

6
00:00:22,980 --> 00:00:26,130
ماذا؟ بدَتْ كطفلة شقيّة، لكنّها ظريفة في الواقع؟

7
00:00:26,130 --> 00:00:30,010
أجل! أنا متأكّدة بأنّكِ ستُشكّلين
صداقة جيّدة معها

8
00:00:30,010 --> 00:00:33,500
لكن يا صاح، هذا المكان عجيب، أليس كذلك؟

9
00:00:33,500 --> 00:00:34,180
أجل

10
00:00:34,420 --> 00:00:37,040
استخدموا "آرك" ذاك لصنعه، صحيح؟

11
00:00:37,040 --> 00:00:38,190
لا أعلم

12
00:00:38,190 --> 00:00:40,890
...بدا وكأنّ شيون تعرف شيئاً، لكن

13
00:00:44,740 --> 00:00:46,650
لا أعتقد بأنّها ستخبرنا الآن

14
00:00:46,650 --> 00:00:48,930
حسناً، تدور أمور في ذهنها

15
00:00:48,930 --> 00:00:51,460
إذا كان هناك ما يضايقها، أريد تقديم المساعدة

16
00:00:51,460 --> 00:00:53,410
أنت تأخذ كلّ شيء بجدّية

17
00:00:53,870 --> 00:00:56,740
أنا واثق بأنّك قلق بشأن ميكادو أيضاً

18
00:00:57,350 --> 00:00:59,150
أنت ذكيّ يا سوبارو

19
00:01:01,970 --> 00:01:05,840
أيّ شخص يستطيع أن يميّز من الطريقة
الّتي تُمسك فيها هاتفك

20
00:01:05,840 --> 00:01:06,850
أجل

21
00:01:06,850 --> 00:01:09,240
أنت قلق بشأن ميكادو؟

22
00:01:09,240 --> 00:01:10,320
أجل

23
00:01:10,960 --> 00:01:12,660
أظنّني كذلك

24
00:01:12,660 --> 00:01:15,870
أليس هذا لطفاً زيادة عن اللّزوم يا سيّد قائد؟

25
00:01:23,240 --> 00:01:25,970
"!سأجعلها هزيمة ذات معنى"

26
00:01:26,350 --> 00:01:28,950
يتفعّل تأثير التّابع الأبيض النقيّ

27
00:01:28,950 --> 00:01:32,530
في كلّ مرّة ألعب فيها بـ عودة إلى
،السّماء أو المُجنّح المعكوس

28
00:01:32,530 --> 00:01:34,950
يُلحِق 3 ضرراً بتابع عشوائيّ للعدوّ

29
00:01:35,660 --> 00:01:36,750
...و

30
00:01:36,750 --> 00:01:38,860
!اخشوا الملائكة المُنّزلين خاصّتي

31
00:01:46,180 --> 00:01:48,540
الكلمات الأخيرة لآرتيفاكت التَّحليل

32
00:01:48,540 --> 00:01:49,880
سحبتُ بطاقة

33
00:01:50,770 --> 00:01:55,000
خسرتَ كلّ أتباعك الّذين كنتَ قد وضعتَهم
في وضع اللّعب واكتسبتَ بطاقة واحدة

34
00:01:55,250 --> 00:01:56,580
هذا كافٍ

35
00:01:56,580 --> 00:02:00,600
،أم أنّك لا تؤمن بإمكانيّات البطاقات
يا ميكادو شيروغاني؟

36
00:02:04,600 --> 00:02:06,100
بلى

37
00:02:11,180 --> 00:02:15,070
!أؤمن بالإمكانيّات اللّانهائيّة لبطاقة واحدة

38
00:02:20,530 --> 00:02:23,450
تابِع أسطوري بمصنوعة بوّابة؟

39
00:02:23,450 --> 00:02:26,670
ألعب بسبيناريا، حارس الغوامض

40
00:02:26,670 --> 00:02:28,880
تدخل آرتيفاكت سبيناريا وضع اللّعب

41
00:02:29,320 --> 00:02:33,540
التّسارعيّة تمنح فورة لآرتيفاكت سبيناريا

42
00:02:34,090 --> 00:02:35,840
أطوِّر سبيناريا

43
00:02:41,910 --> 00:02:44,110
أهاجم ملاك الكلمة الظّلاميّ

44
00:02:47,970 --> 00:02:52,200
ثمّ ألعب بآرتيفاكت تحليل وسيّاف الجناح الميكانيكيّ

45
00:02:54,720 --> 00:02:55,930
أنهي دوري

46
00:02:56,540 --> 00:03:01,000
أتباع الآرتيفاكت خاصّتي يحفّزون التأثير
الّذي أعطاهم إيّاه سبيناريا

47
00:03:02,930 --> 00:03:07,080
في نهاية دوري، يُلحقون 1 ضرراً
بتابع عدوّ عشوائيّ

48
00:03:10,630 --> 00:03:13,370
لن ينفع هذا معي

49
00:03:13,800 --> 00:03:15,080
حامي الفساد

50
00:03:19,740 --> 00:03:23,520
يستعيد تأثيره دِفاع القائد خاصّتي بمقدار 2

51
00:03:23,940 --> 00:03:25,260
العودة إلى السّماء

52
00:03:25,790 --> 00:03:28,900
تدمّر هذه البطاقة تابعاً مُحايداً
،وضعتُه في وضع اللّعب

53
00:03:28,900 --> 00:03:31,390
وأضيف نسخة منها إلى يدي

54
00:03:31,390 --> 00:03:37,590
وحيث يمكن تطبيق ذلك، تتغيّر
تلك البطاقة إلى شكلها الملائكيّ

55
00:03:37,590 --> 00:03:40,970
وبما أنّ الكلمات الأخيرة لحارس
،الفساد قد تحفّزت

56
00:03:40,970 --> 00:03:43,900
أضفتُ المُجنّح المعكوس إلى يدي

57
00:03:44,300 --> 00:03:46,430
تعال يا حارس التّطهير

58
00:03:49,880 --> 00:03:50,990
بكلفة صفر

59
00:03:51,280 --> 00:03:52,530
هذا هو تأثيره

60
00:03:52,530 --> 00:03:56,440
عندما لعبتُ بأربعة أو أكثر من بطاقات
،العودة إلى السّماء في المعركة

61
00:03:56,440 --> 00:03:58,860
كلفة حارس التّطهير تنقص إلى الصّفر

62
00:03:58,860 --> 00:04:00,280
وهذا ليس كلّ شيء

63
00:04:01,040 --> 00:04:04,200
الضّرر الّذي يتلقّاه القائد الخاصّ بي
تالياً ينقص إلى صفر أيضاً

64
00:04:08,340 --> 00:04:10,180
وما زلتُ لم أنتهِ بعد

65
00:04:10,970 --> 00:04:13,590
المُجنَّح المعكوس: هيئة المُنزَّل

66
00:04:16,020 --> 00:04:17,330
ليريال الظّلامي

67
00:04:22,940 --> 00:04:24,730
اركع أمامي

68
00:04:24,730 --> 00:04:25,830
تطوّر

69
00:04:34,630 --> 00:04:35,720
تابع أكثر

70
00:04:39,130 --> 00:04:40,370
ومن جديد

71
00:04:45,290 --> 00:04:47,470
أنت ضعيف جدّاً

72
00:04:47,740 --> 00:04:53,850
لا يمكنك الوصول إليّ. جميعكم
واهنون وضُعفاء وصاغرون

73
00:04:53,850 --> 00:04:57,780
تفترض بأنّنا واهنون وضُعفاء وصاغرون

74
00:05:01,210 --> 00:05:03,960
أنت تتجنّب الآخرين وتختم على قلبك

75
00:05:09,650 --> 00:05:11,910
لا يمكنك قبول الآخرين

76
00:05:11,910 --> 00:05:14,160
ما يعني بأنّك لا يمكنك قبول الهزيمة

77
00:05:15,110 --> 00:05:17,570
لدى آرتيفاكت القديم فورة

78
00:05:19,490 --> 00:05:22,210
تظلُّ تتكلّم وكأنّك تعرفني

79
00:05:24,860 --> 00:05:26,640
حان الوقت كي تصغي

80
00:05:28,710 --> 00:05:30,820
لن أصغي لكلمات عديم الموهبة

81
00:05:33,480 --> 00:05:35,840
هل الموهبة هي كلّ ما يهمُّ في شادوفارس؟

82
00:05:35,840 --> 00:05:39,140
ليس في شادوفارس فحسب. ينطبِق
الأمر على كلّ شيء

83
00:05:39,470 --> 00:05:43,510
في كلِّ شيء، الموهِبة هي كلُّ ما يهمّ

84
00:05:43,970 --> 00:05:45,730
هناك إمكانيّات

85
00:05:46,420 --> 00:05:48,440
لدى النّاس إمكانيّات

86
00:05:49,200 --> 00:05:53,610
الإيمان بتلك الإمكانيّات هو ما يسمح
لنا بتعلّم التّحليق

87
00:05:55,070 --> 00:05:59,670
أنت لا تؤمن بالإمكانيّات، لذا فالسّماء
لن تكشف عن نفسها لك

88
00:06:03,790 --> 00:06:08,170
تأثير حارس التّطهير سوف يُبطِل الضّرر

89
00:06:08,430 --> 00:06:10,720
...كلّ هذا الهُراء حول "السّماء" وما شابه

90
00:06:10,720 --> 00:06:13,740
أنت حزين ووحيد ومغرور

91
00:06:19,850 --> 00:06:21,640
هذه مزحة، صحيح؟

92
00:06:21,640 --> 00:06:25,780
أنا من يشفق على الآخرين. أنا
من يستخفّ بالنّاس

93
00:06:26,650 --> 00:06:28,890
...أوّلاً تأثير المعبد السّماوي

94
00:06:30,580 --> 00:06:33,250
يضيف "عودة إلى السّماء" إلى يدي

95
00:06:33,250 --> 00:06:35,650
ثمّ ألعب بالخائن ذي الجناح الواحد

96
00:06:35,650 --> 00:06:40,750
يستعيد تأثيرُه نقطتَي لعِب
ويمنحني مُجنّحاً معكوساً

97
00:06:41,170 --> 00:06:44,960
العودة إلى السّماء. فلتولدي الآن

98
00:06:52,000 --> 00:06:54,190
ألعب بالمُنفِّذ ذي الجناح الواحد

99
00:06:56,760 --> 00:06:59,860
يستعيد تأثيره 3 نقاط لعِب

100
00:07:00,450 --> 00:07:05,140
التّالي، أستخدم المُجنّح المعكوس لجعل
أحد أتباعي في يدي ينزل

101
00:07:05,880 --> 00:07:07,860
ثمّ ألعب بتلك البطاقة المُنزَّلة

102
00:07:11,290 --> 00:07:13,660
...تأثير الفارس الملائكيّ الظّلاميّ

103
00:07:13,660 --> 00:07:17,370
يعزّز هجوم ودفاع كلّ الأتباع
المُحايدين بمقدار 1

104
00:07:17,790 --> 00:07:21,400
ثمّ يتفعّل تأثير المُنفِّذ ذي الجناح الواحد

105
00:07:21,690 --> 00:07:26,930
،عندما يدخل تابعٌ مُحايدٌ وضع اللّعِب في طرفي
فإنّ هجماته ودفاعه تتعزّز بمقدار 1

106
00:07:26,930 --> 00:07:29,800
وكلٌّ من التّابع وهو يتطوّران

107
00:07:30,120 --> 00:07:31,190
!اغرب عن وجهي

108
00:07:38,590 --> 00:07:42,680
أعرف شخصاً يتكلّم مثلك

109
00:07:44,730 --> 00:07:48,320
وحيد"؟ بمُفردي"؟ هذا سخيف جدّاً"

110
00:07:48,320 --> 00:07:52,690
وخسرتَ أمام الفتى الّذي قال بأنّ
تلك الأشياء سخيفة، أليس كذلك؟

111
00:07:53,040 --> 00:07:55,940
!كانت مرّة واحدة فقط! كانت ضربة حظّ

112
00:07:55,940 --> 00:07:58,700
شادوفارس غير موجودة حتّى ترفض الآخرين

113
00:08:01,030 --> 00:08:05,060
.يجب أن تقبلوا وتتحدّوا بعضكم الآخر
وأن تفهموا بعضكم. هذه هي شادوفارس

114
00:08:05,790 --> 00:08:07,710
لا علاقة لهذا الأمر بي

115
00:08:10,070 --> 00:08:11,260
لا، بل له علاقة

116
00:08:11,260 --> 00:08:14,630
!لأنّنا الآن، مُتّصلون بواسطة شادوفارس

117
00:08:18,010 --> 00:08:23,490
كلماته الأخيرة تحرّك بطاقة آرتيفاكت
عشوائيّة من مجموعة بطاقاتي إلى يدي

118
00:08:23,490 --> 00:08:26,310
ألعب ميريام، الكائن التّركيبيّ

119
00:08:26,310 --> 00:08:29,640
أنا متناغم، لذا أستطيع اختيار بأيّ نسخة ألعب

120
00:08:29,640 --> 00:08:32,410
أختار لا ديابلوتين ميريام

121
00:08:32,850 --> 00:08:38,010
تأثيرها ينقل بطاقة آرتيفاكت عشوائيّة
من مجموعة أوراقي إلى يدي

122
00:08:38,010 --> 00:08:40,310
ثمّ ألعب بالتّصنيع الحيويّ

123
00:08:40,310 --> 00:08:43,940
يخفّض كلفة تابع في يدي بمقدار 1

124
00:08:43,940 --> 00:08:46,950
ثمّ أضيف ثلاث نسخ من نفس البطاقة
إلى مجموعة أوراقي

125
00:08:47,360 --> 00:08:49,590
ألعب باثنتين من آرتيفاكت التّحليل

126
00:08:52,420 --> 00:08:54,600
التّسارعيّة تمنحهم فورة

127
00:08:54,600 --> 00:08:55,580
أهاجم

128
00:08:57,110 --> 00:09:00,380
كلماتهم الأخيرة تجعلني أسحب بطاقتين

129
00:09:00,750 --> 00:09:03,590
ألعب بآرتيفاكت القديم وإيكاروس

130
00:09:04,710 --> 00:09:09,120
تأثير إيكاروس يضيف تابِعَي آرتيفاكت
إلى مجموعة أوراقي

131
00:09:09,710 --> 00:09:10,970
...و

132
00:09:11,310 --> 00:09:12,970
!آرتيفاكت المُضيء

133
00:09:15,150 --> 00:09:17,990
لدى آرتيفاكت المُضيء عاصفة

134
00:09:17,990 --> 00:09:19,400
يهاجم القائد الخاصّ بك

135
00:09:23,950 --> 00:09:25,540
أنهي دوري

136
00:09:25,540 --> 00:09:29,480
بعد ذلك، يتحفّز التأثير الّذي اكتسبتُه
من الإله من الآلة

137
00:09:29,480 --> 00:09:34,430
إذا كنتُ مُتناغماً، أطرح كلّ أوراق يدي
وأسحب ستّ بطاقات جدُد

138
00:09:34,660 --> 00:09:40,090
.ميكادو شيروغاني، أنت تتشبّث بشادوفارس
تتوسّل إليها. أليس كذلك؟

139
00:09:41,230 --> 00:09:46,020
لكنّك ترفض مواجهته. تتهرّب منه

140
00:09:46,460 --> 00:09:49,650
...اصمت. لا أبالي

141
00:09:50,200 --> 00:09:51,770
!لأيّ كلمة تتفوّه بها

142
00:09:57,240 --> 00:10:01,680
أتشبّث به"؟ "أواجهه"؟ لستُ بحاجة لأيّ من ذلك

143
00:10:02,370 --> 00:10:04,570
تكلّمنا بما يكفي

144
00:10:04,570 --> 00:10:05,950
سوف أنهي هذا

145
00:10:16,200 --> 00:10:19,030
أجنحة الفوضى الجارحة في السّماء

146
00:10:19,720 --> 00:10:22,680
حلّق يا ملاك الفوضى

147
00:10:35,610 --> 00:10:38,780
يُلعَب ملاك الفوضى بتعزيز

148
00:10:38,780 --> 00:10:41,910
أوّلاً، أضيف اثنين من المُجنّح المعكوس إلى يدي

149
00:10:42,350 --> 00:10:46,080
تأثير التّعزيز يسترجع 5 نقاط لعِب

150
00:10:46,350 --> 00:10:49,620
،ينقص الضّرر المُلحَق بملاك الفوضى إلى الصّفر

151
00:10:49,620 --> 00:10:54,640
والتأثيرات لا أيّ شيء لها، عدا عن أولئك
الّذين يغيّرون الهجوم والدّفاع

152
00:10:55,530 --> 00:10:56,840
المُجنّح المعكوس

153
00:10:59,000 --> 00:11:00,490
هيئة المُنزَّل

154
00:11:02,230 --> 00:11:04,250
ملاك الظّلام آلتايا

155
00:11:06,280 --> 00:11:11,960
يتفعّل تأثيره، ليحوّل كلّ أتباع العدوّ
إلى أتباع مُحايدين

156
00:11:13,990 --> 00:11:16,620
بالنسبة لي، شادوفارس هي أداة

157
00:11:16,620 --> 00:11:19,520
مجرّد أداة لتخفيف ضجري

158
00:11:19,520 --> 00:11:20,410
هيئة الملاك

159
00:11:26,900 --> 00:11:28,920
أُطوِّر ملاك الفوضى

160
00:11:35,110 --> 00:11:37,390
!ويُهاجم إلى جانب آلتايا

161
00:11:41,410 --> 00:11:42,800
لا يمكنك الوصول إليّ

162
00:11:46,790 --> 00:11:48,330
تأثير الهجوم الخاصّ به

163
00:11:50,760 --> 00:11:53,990
سأمسح هذه الابتسامة الماكرة عن محياك قريباً

164
00:11:54,420 --> 00:11:55,390
أنهي دوري

165
00:11:56,270 --> 00:11:59,100
يتفعّل تأثير ملاك الفوضى

166
00:11:59,100 --> 00:12:03,780
،لكلّ تابع مُنزَّل فريد لعبتُ به أثناء هذا الدّور

167
00:12:03,780 --> 00:12:08,020
يُلحِق ذلك المقدار من الضّرر بتابِع
عدوّ عشوائيّ وقائد العدوّ

168
00:12:17,980 --> 00:12:19,140
الكلمات الأخيرة

169
00:12:21,240 --> 00:12:24,090
التأثير الثّاني للمعبد السّماويّ يتفعّل

170
00:12:24,090 --> 00:12:29,740
إذا كان لديّ ملاك الفوضى في وضع
اللّعب، يستعيد دفاع قائدي إلى 15

171
00:12:31,460 --> 00:12:36,220
تكلّمتَ كثيراً، لكن هذه هي الحقيقة

172
00:12:36,910 --> 00:12:38,520
أنا قويّ

173
00:12:42,190 --> 00:12:44,130
نحن نقترب من نهاية معركتنا

174
00:12:46,000 --> 00:12:49,700
معك حقّ. لا حاجة لمزيد من الكلام

175
00:12:51,290 --> 00:12:54,370
بالنسبة للقلب، شادوفارس يعني أكثر من مجرّد كلمات

176
00:12:57,260 --> 00:13:01,290
الآن سأشارك ما في قلبي من خلال
الطريقة الّتي ألعب بها

177
00:13:01,990 --> 00:13:03,040
!هاميلين

178
00:13:03,520 --> 00:13:09,410
يدعني تأثيره أختار تابعاً من يدي بكلفة
ثلاثة أو أقلّ وأضيف نسخة أخرى

179
00:13:09,410 --> 00:13:13,820
ألعب باثنتين من آرتيفاكت قديم وآرتيفاكت مُضيء

180
00:13:14,920 --> 00:13:15,980
لا جدوى

181
00:13:15,980 --> 00:13:19,790
لدى آرتيفاكت المُضيء عاصفة ويهاجم قائدك

182
00:13:27,930 --> 00:13:29,410
أنت تهدر وقتك

183
00:13:29,410 --> 00:13:31,880
بِطاقة التّميمة: الكيان المُتلاشي

184
00:13:31,880 --> 00:13:34,320
مضيعة كاملة للوقت

185
00:13:35,230 --> 00:13:42,110
أنهي دوري. بما أنّني مُتناغم، أطرح
أوراق يدي وأسحب ستّ بطاقات

186
00:13:50,220 --> 00:13:53,110
!لا جدوى! لا جدوى! لا جدوى من كلِّ ذلك

187
00:13:53,110 --> 00:13:55,640
!لم يعُد فوزي مُشكَّكاً به

188
00:13:55,640 --> 00:14:00,800
مهما كان عدد الأتباع الّذين تلعب بهم
!أو تهاجمني بهم، أو مهما سحبت من بطاقات

189
00:14:00,800 --> 00:14:04,010
!أنت تحتي في النّهاية

190
00:14:05,130 --> 00:14:09,830
سأحرق كلّ تلك الكلمات عديمة
!الجدوى الّتي تقيّأتها عليّ

191
00:14:09,830 --> 00:14:11,150
!باهاموت

192
00:14:31,130 --> 00:14:33,760
!يتفعّل تأثير باهاموت

193
00:14:37,350 --> 00:14:41,650
!يدمِّر كلّ الأتباع بمعزل عن نفسه

194
00:14:58,090 --> 00:15:03,790
،لكن تأثير ملاك الفوضى يمنعه من التدمُّر
ما يعني بأنّه ما زال في وضع اللّعب

195
00:15:05,070 --> 00:15:07,080
!ضعيف! واهن

196
00:15:07,080 --> 00:15:08,920
لذا سأصنع لك معروفاً وأحطّمك

197
00:15:09,270 --> 00:15:11,250
أهاجم بملاك الفوضى

198
00:15:12,690 --> 00:15:15,270
يستطيع الهجوم مرّتين

199
00:15:15,580 --> 00:15:16,840
هذه هي النّهاية

200
00:15:16,840 --> 00:15:18,770
!سأدمّر كلّ شيء

201
00:15:30,490 --> 00:15:32,070
!توقّعتُ ذلك

202
00:15:33,180 --> 00:15:36,000
توقّعتُ أن أربح

203
00:15:37,070 --> 00:15:38,710
أهذا كلّ ما لديك؟

204
00:15:38,710 --> 00:15:41,360
أهذا كلّ ما لدى الظِّلال السّبعة؟

205
00:15:42,410 --> 00:15:44,420
—لا أصدّق بأنّني توقّعتُ أكثر من

206
00:15:44,420 --> 00:15:46,410
لم تنتهِ المعركة بعد

207
00:15:57,080 --> 00:15:58,250
مستحيل

208
00:15:58,600 --> 00:16:03,680
كان لديك 10 دفاع. ينبغي أن يكون
ملاك الفوضى قد هزمك

209
00:16:04,770 --> 00:16:06,690
...تِلك التّميمة

210
00:16:06,690 --> 00:16:08,440
الكيان المُتلاشي

211
00:16:08,860 --> 00:16:13,240
ينقص الضّرر 4 أو أكثر والمُلحَق
بقائدي إلى 3

212
00:16:16,770 --> 00:16:18,860
وماذا يعني ذلك؟

213
00:16:20,530 --> 00:16:23,120
ما زلتُ واقفاً

214
00:16:24,490 --> 00:16:28,750
أنهي دوري، يتفعّل تأثير ملاك الفوضى

215
00:16:28,750 --> 00:16:30,010
الكيان المُتلاشي

216
00:16:33,900 --> 00:16:38,670
ثمّ يستعيد المعبد السّماويّ دفاعي إلى 15

217
00:16:41,280 --> 00:16:43,780
حسناً، أيّاً يكن. هذا غير مهمّ

218
00:16:43,780 --> 00:16:47,110
!لديّ 15 دفاع! لديك 1

219
00:16:47,110 --> 00:16:49,490
!مع ذلك سوف أربح! هذا حتميّ

220
00:17:00,880 --> 00:17:06,090
ميكادو شيروغاني. في شادوفارس، لا شيء حتميّ

221
00:17:07,100 --> 00:17:09,330
هل هذه هي كلماتك الأخيرة؟

222
00:17:09,800 --> 00:17:10,870
لا

223
00:17:11,800 --> 00:17:15,150
...أخبرتُك بأنّني سأريك كيف ألعب

224
00:17:17,060 --> 00:17:19,900
...وبأنّ الأشياء الّتي قرّرتَ بأنّك لا تحتاجها

225
00:17:20,250 --> 00:17:23,640
...الأشياء الّتي افترضتَ بأنّها ضعيفة وواهنة

226
00:17:23,640 --> 00:17:27,060
بأنّ كلّها كانت ضروريّة

227
00:17:28,810 --> 00:17:32,960
سوف تتعلّم الآن بأنّها كانت إمكانيّات ضروريّة

228
00:17:38,050 --> 00:17:43,560
سافيرا، الوحش التّركيبيّ تتطوّر نظراً
!إلى تأثيرها التّعزيزي وتكسب عاصفة

229
00:17:44,450 --> 00:17:45,610
...و

230
00:17:47,580 --> 00:17:48,950
ما-ماذا؟

231
00:17:49,330 --> 00:17:53,770
حتّى نهاية الدّور، يصبح هجومها مساوياً
لعدد بطاقات الآرتيفاكت خاصّتي

232
00:17:53,770 --> 00:17:56,810
!الّتي دُمِّرت في هذه اللّعبة

233
00:18:01,930 --> 00:18:09,280
،بما أنّه دُمِّر 15 بطاقة آرتيفاكت
!يصبح هجومها 15

234
00:18:10,800 --> 00:18:12,020
...لا

235
00:18:12,020 --> 00:18:16,020
كـ-كنتَ تهدف لهذا منذ البداية؟

236
00:18:16,330 --> 00:18:20,030
،افترضتَ بأنّها كانت ضعيفة وواهنة
وأنكرت إمكانيّاتها

237
00:18:20,400 --> 00:18:24,980
!والآن سأغيّر ذلك الضّعف إلى هزيمة قيّمة

238
00:18:25,350 --> 00:18:28,070
!سافيرا تهاجم قائدك

239
00:18:33,750 --> 00:18:36,550
اخسر اللّعبة يا ميكادو شيروغاني

240
00:18:41,790 --> 00:18:43,020
...لا

241
00:18:44,600 --> 00:18:45,810
!مـ-مستحيل

242
00:18:47,980 --> 00:18:49,970
!لا يمكن أن يحدث هذا

243
00:19:07,910 --> 00:19:09,480
ما الخطب يا لايت؟

244
00:19:12,740 --> 00:19:14,920
!لايت

245
00:19:15,210 --> 00:19:17,410
!آسف! اذهبوا من دوني

246
00:19:17,730 --> 00:19:19,940
لكن إلى أين أنت ذاهب؟

247
00:19:19,940 --> 00:19:21,560
!إلى حيث يوجد ميكادو

248
00:19:26,590 --> 00:19:28,140
والآن ماذا؟

249
00:19:28,670 --> 00:19:31,150
انتهت المعركة في هذه المنطقة

250
00:19:31,150 --> 00:19:33,280
حقّقَ الظّلالُ السّبعة فوزاً واحداً

251
00:19:33,680 --> 00:19:39,590
لكن لا أمانع مقاتلتك ثانية إذا كان هذا ما تريده

252
00:19:41,290 --> 00:19:43,560
كـ-كان ذلك مجرّد حظّ

253
00:19:44,620 --> 00:19:48,130
إذا لعبتُ من جديد، سوف أربح

254
00:19:48,130 --> 00:19:50,860
...لأنّني أبداً

255
00:19:54,870 --> 00:19:56,790
أهذه إجابتك؟

256
00:19:56,790 --> 00:19:57,940
...لا

257
00:20:15,030 --> 00:20:17,110
هل ذقتَ لوعة الهزيمة؟

258
00:20:17,590 --> 00:20:18,910
...لم أخسر

259
00:20:19,430 --> 00:20:21,800
لكن في الحقيقة، تعلم بأنّك خسرت، أليس كذلك؟

260
00:20:22,690 --> 00:20:24,900
!قلتُ بأنّني لم أخسر

261
00:20:24,900 --> 00:20:26,670
!توقّف يا ميكادو

262
00:20:29,770 --> 00:20:31,620
!انتهت المعركة

263
00:20:31,620 --> 00:20:32,910
صحيح؟

264
00:20:33,770 --> 00:20:35,300
!هذا ليس من شأنك

265
00:20:35,300 --> 00:20:36,800
!بل هو كذلك

266
00:20:37,110 --> 00:20:39,300
اصمت! لماذا أتيت إلى هنا؟

267
00:20:39,830 --> 00:20:42,170
!لأنّني اتّصلتُ معك في معركتنا

268
00:20:51,350 --> 00:20:54,560
لذا من الطبيعي أن أقلق بشأنك

269
00:20:58,950 --> 00:21:00,330
هذا ما في الأمر إذاً

270
00:21:02,040 --> 00:21:04,890
الوداع أيّها المختارون

271
00:21:04,890 --> 00:21:07,110
استمرّوا إلى المعركة التّالية

272
00:21:08,740 --> 00:21:11,930
أتطلّع قدماً لمعركتي معك

273
00:21:23,670 --> 00:21:24,800
...ميكادو

274
00:21:24,800 --> 00:21:25,750
ابتعد عنّي

275
00:21:26,730 --> 00:21:32,200
...يمكنني النّهوض. أعلم بأنّني أستطيع. أنا فقط

276
00:21:33,620 --> 00:21:34,870
لا تضغط على نفسك

277
00:21:35,560 --> 00:21:37,730
سبقنا الجميع

278
00:21:37,730 --> 00:21:39,230
سوف نذهب أيضاً

279
00:21:39,230 --> 00:21:41,740
لن أقبل مساعدة منك

280
00:21:44,140 --> 00:21:45,260
...ميكادو

281
00:21:46,410 --> 00:21:51,120
...لستُ من الأشخاص الّذين يُشفَق عليهم

282
00:23:23,950 --> 00:23:25,620
استعراض بطاقة شادوفارس

283
00:23:25,620 --> 00:23:29,160
!بطاقة اليوم هو الإله من الآلة

284
00:23:29,160 --> 00:23:33,360
هذا التّابع الأسطوريّ القويّ يملأ يدك
بسرعة إذا كنت في تناغم

285
00:23:33,360 --> 00:23:36,440
كانت مصنوعة البوّابة مفاجأة كبيرة، أليس كذلك؟

286
00:23:36,440 --> 00:23:38,880
أجل. ما زال هناك الكثير ممّا يجب
تعلّمه حول شادوفارس

287
00:23:38,880 --> 00:23:42,980
الظّلال السّبعة مُخيفون. هزموا ميكادو

288
00:23:42,980 --> 00:23:44,980
ألست خائفاً يا تسوباسا؟

289
00:23:44,980 --> 00:23:45,940
أجل

290
00:23:45,940 --> 00:23:49,150
لكن أنا متأكّد بأنّها تنتظرني

291
00:23:49,150 --> 00:23:51,870
"الحلقة القادمة: "إنّه ليس مجرّد يأس، صحيح؟

292
00:23:51,870 --> 00:23:53,720
!قِتال! شادوفارس