1
00:00:06,030 --> 00:00:08,360
بطاقة تميمة جديدة؟

2
00:00:08,360 --> 00:00:12,370
أجل. بطاقة التّميمة سبخة السمّ

3
00:00:12,370 --> 00:00:18,150
أوّلاً، تحوّل كلّ يرقات الحشرات الّتي في وضع
اللّعب وفي يدي إلى حريشة مُتجمّدة

4
00:00:18,150 --> 00:00:22,480
ثمّ إذا كان لديّ الغابة الخصبة أو سبخة
،السمّ في وضع اللّعب

5
00:00:22,480 --> 00:00:25,920
أدمّرهم وأستردّ 2 نقطة لعب

6
00:00:26,380 --> 00:00:29,160
ألعب ببطاقة التّعويذة عضّة السمّ

7
00:00:30,100 --> 00:00:33,840
تستدعي اثنتين من الحريشة المُتجمّدة
وتمنحهما فورة

8
00:00:33,840 --> 00:00:39,720
،وإذا كان لديّ سبخة السمّ في وضع اللّعب
تمنحهما آفة وأسحب بطاقة

9
00:00:40,110 --> 00:00:42,440
التّالي، ألعب بعثّ اللّهب

10
00:00:42,440 --> 00:00:48,640
يدمّر أحد أتباعي وينقص الدّفاع الأقصى
الخاص بقائد العدوّ بمقدار 1

11
00:00:50,450 --> 00:00:52,660
لم ينخفض دفاعي؟

12
00:00:53,480 --> 00:00:55,040
...لا، لحظة، إنّه

13
00:00:55,040 --> 00:01:01,230
ينقص عثّ اللّهب الدّفاع الأقصى. إنّه
ليس وكأنّه يلحق 1 ضرراً

14
00:01:02,190 --> 00:01:04,080
!انتبهي

15
00:01:04,080 --> 00:01:06,500
!لدى عثّ اللّهب تأثيرات أكثر

16
00:01:06,500 --> 00:01:09,800
،إنّه في العادة يلحق 3 ضرراً بتابع عدوّ عشوائيّ

17
00:01:09,800 --> 00:01:15,390
،لكن إذا كان لديّ مستقنع السمّ في وضع اللّعب
فإنّه يلحق 3 ضرراً بكافّة الأتباع بدلاً من ذلك

18
00:01:20,310 --> 00:01:23,520
تتفعّل الكلمات الأخيرة لفيجن رانر والممنوحة
!له بواسطة سراب البطل

19
00:01:23,520 --> 00:01:27,270
!تُضاف نسخة من نفس التّابع إلى يدي

20
00:01:27,270 --> 00:01:31,010
لدى الحريشة المُتجمّدة كلمات أخيرة أيضاً

21
00:01:31,210 --> 00:01:34,960
ينقص الدّفاع الأقصى الخاص بقائد
خصمي بمقدار 1

22
00:01:34,960 --> 00:01:37,270
!والآن فليجمّدك السمّ

23
00:01:42,030 --> 00:01:42,800
من جديد؟

24
00:01:44,580 --> 00:01:46,280
...وهذا

25
00:01:46,550 --> 00:01:48,390
"حريّ بك أن تسرعي أيّتها "البطل

26
00:01:50,500 --> 00:01:53,420
"!اغرقي في جماليّات الشرّ"

27
00:01:53,990 --> 00:01:56,680
سينتشر السمُّ في أنحاء جسدكِ ويشلّكِ

28
00:01:57,420 --> 00:01:58,800
!سحب

29
00:02:00,480 --> 00:02:01,610
!شكراً

30
00:02:01,610 --> 00:02:04,090
ما هذا؟ تخرجين أشياء من مؤخّرتكِ ثانية؟

31
00:02:04,090 --> 00:02:06,540
!البطل يكون قويّاً عندما تتأزّم الأمور

32
00:02:06,540 --> 00:02:08,390
!ألعب ببطاقة الدّخول البطوليّ

33
00:02:15,080 --> 00:02:19,370
أستدعي الفارس ماخ مع عاصفة
!وأسحب بطاقتين

34
00:02:19,370 --> 00:02:22,390
وإذا كان لدى العدوّ أتباع أكثر
،منّي في وضع اللّعب

35
00:02:22,390 --> 00:02:24,710
!أسترجع 5 نقاط لعب

36
00:02:24,710 --> 00:02:27,120
!ثمّ أمر ألويدا

37
00:02:33,540 --> 00:02:35,430
وارد وعاصفة؟

38
00:02:35,430 --> 00:02:37,420
!أُطوِّر القرصان

39
00:02:42,010 --> 00:02:46,010
!يُهاجم إلى جانب أتباعي الآخرين الّذين لديهم عاصفة

40
00:02:49,400 --> 00:02:52,390
"منحَتْهم عضّة السمّ "آفة

41
00:02:56,430 --> 00:02:59,190
،وكلّ من كلماتهما الأخيرة تتفعّل

42
00:02:59,190 --> 00:03:02,930
!ليُنقص دفاعكِ الأقصى بمقدار 2

43
00:03:10,990 --> 00:03:13,180
هل يؤلمك هذا يا بطل؟

44
00:03:14,420 --> 00:03:17,550
أوّلاً، يتفعّل تأثير سبخة السمّ

45
00:03:17,550 --> 00:03:21,050
في بداية دوري، أستدعي حريشة مُتجمِّدة

46
00:03:21,050 --> 00:03:23,560
ثمّ ألعب بواحدة من يدي

47
00:03:24,040 --> 00:03:26,670
!التّالي، عنكبوت الشّراهة

48
00:03:29,470 --> 00:03:31,480
تابع لا يمكن مُهاجمته؟

49
00:03:31,480 --> 00:03:36,580
وبالطبع، هذا ليس كلّ شيء. يتفعّل
التأثير الأوّل لعنكبوت الشّراهة

50
00:03:37,470 --> 00:03:42,830
،مقابل كلّ حريشة مُتجمِّدة لديّ في وضع اللّعب
يدمّر تابعَ عدوّ عشوائيّاً

51
00:03:44,290 --> 00:03:49,410
وينقص دفاعكِ الأقصى بمقدار عدد
الأتباع المُدمَّرين

52
00:03:59,010 --> 00:04:00,330
!دفاعي

53
00:04:00,600 --> 00:04:03,130
سوف يزداد الأمر سوءاً ليس إلّا

54
00:04:03,130 --> 00:04:07,280
عندما ينخفض دفاعكِ الأقصى، فإنّ
الشّفاء يصبح غير فعّال

55
00:04:07,280 --> 00:04:09,280
لا توجد رجعة

56
00:04:09,280 --> 00:04:11,680
وهذا ما ينتظرك

57
00:04:13,910 --> 00:04:15,540
ابتلعتِ لسانكِ؟

58
00:04:15,540 --> 00:04:18,500
لا عجب. فأنا ألعب بجدّية هذه المرّة

59
00:04:18,500 --> 00:04:19,900
—الأمر مختلف عن السّابق

60
00:04:23,360 --> 00:04:26,310
هذه معركة عظيمة، أليس كذلك يا هينا؟

61
00:04:27,580 --> 00:04:33,720
أنا سعيدة جدّاً لأنّني تمكّنتُ من مقاتلة
!مُعجبة باتل فينسر أخرى هكذا

62
00:04:33,720 --> 00:04:35,260
أنتِ تستمتعين أيضاً، صحيح؟

63
00:04:35,610 --> 00:04:37,520
!هل أنتِ حمقاء؟

64
00:04:37,520 --> 00:04:42,050
!لا أحبّ باتل فينسر. أحبّ الحشرة الملِكة

65
00:04:42,050 --> 00:04:45,720
—أعلم! إنّها قائدة العدوّ الّتي تقاتل باتل فينسر

66
00:04:45,720 --> 00:04:47,390
!يكفي

67
00:04:47,390 --> 00:04:49,210
ما أدراكِ أنتِ؟

68
00:04:55,240 --> 00:04:56,580
لستُ أدري

69
00:04:57,440 --> 00:05:00,560
...لكن مثلما لدى تعطُّشي للعدالة أسباب

70
00:05:00,790 --> 00:05:05,510
،مثلما لدى تعطُّشي للعدالة أسباب
هناك سبب لنهجكِ الشرّير أيضاً

71
00:05:05,510 --> 00:05:06,310
...ولذا، أنا

72
00:05:06,580 --> 00:05:09,250
!ولذا أريد معرفة المزيد عنكِ

73
00:05:12,390 --> 00:05:15,420
!أريد أن أعرفكِ يا هينا

74
00:05:16,800 --> 00:05:20,130
!عندما أقاتلكِ، أبتسم

75
00:05:21,670 --> 00:05:23,740
!ألعب برمّاح العاصفة مع فورة

76
00:05:23,740 --> 00:05:25,580
،ألعب بها مع تعزيز

77
00:05:25,990 --> 00:05:31,310
ليمنحها تأثيراً هجوميّاً يلحق 2 ضرراً
!بكافّة أتباع العدوّ

78
00:05:31,310 --> 00:05:33,130
!فلتنفجر العاصفة

79
00:05:33,130 --> 00:05:34,240
!هجوم

80
00:05:39,000 --> 00:05:40,350
...حسناً! الآن

81
00:05:48,170 --> 00:05:49,470
...لكن ما زال بمقدوري

82
00:05:51,480 --> 00:05:54,370
التأثير الثّاني لعنكبوت الشّراهة

83
00:05:54,370 --> 00:05:59,120
،في كلّ مرّة يهاجم فيها تابعُ عدوّ
يلحق 3 ضرراً به

84
00:06:01,810 --> 00:06:04,390
!لكن لن أستسلم

85
00:06:04,930 --> 00:06:06,520
!فيجن رانر

86
00:06:07,750 --> 00:06:11,020
!إنّه الّذي أضافته الكلمات الأخيرة إلى يدي

87
00:06:11,020 --> 00:06:13,460
!إنّه رائع جدّاً! إنّه مثل نينجا

88
00:06:13,460 --> 00:06:14,590
...أنتِ

89
00:06:15,930 --> 00:06:18,780
!أنتِ لا تفهمين شيئاً على الإطلاق

90
00:06:20,230 --> 00:06:22,920
تبتسمين؟ تبّاً لكِ

91
00:06:22,920 --> 00:06:25,800
—لـ-لكن عندما أقاتلكِ، الأمر يبدو

92
00:06:25,800 --> 00:06:30,480
ضحكتي ومظهر وجهكِ الأخرق مختلفان تماماً

93
00:06:30,480 --> 00:06:31,690
!إ-إنّهما نفسهما

94
00:06:32,070 --> 00:06:35,870
كلتانا مُعجبات باتل فينسر! كلتانا لاعبتا شادوفارس

95
00:06:35,870 --> 00:06:37,940
!لستُ بلهاء مثلكِ

96
00:06:38,320 --> 00:06:41,070
...أنا... أنا

97
00:06:43,490 --> 00:06:46,260
لستُ مثلكِ إطلاقاً

98
00:06:52,840 --> 00:06:54,900
لماذا تقولين ذلك؟

99
00:06:55,510 --> 00:07:00,360
لا أريد فعل المزيد من ذلك. لا البيانو
...ولا رقص الباليه ولا مراسم الشّاي

100
00:07:00,660 --> 00:07:04,110
!يجب عليكِ فعل كلّ ذلك لتصبحي بالغة حقيقيّة

101
00:07:04,110 --> 00:07:05,850
...إذا لم تستطيعي حتّى

102
00:07:06,180 --> 00:07:08,730
تعلمين بأنّها على حقّ، أليس كذلك؟

103
00:07:08,730 --> 00:07:10,940
ما تفعلينه ليس صحيحاً

104
00:07:11,340 --> 00:07:13,750
،أجل، من الصّعب تعلّم كلّ شيء

105
00:07:13,750 --> 00:07:18,240
لكن حقيقة قدرتكِ على تعلّم الكثير هي
دلالة على أنّكِ مُبارَكة

106
00:07:18,700 --> 00:07:21,400
وهناك مكافأة لكِ إذا سعيتِ جاهدة

107
00:07:21,400 --> 00:07:23,740
تحبّين كعك أمّكِ، أليس كذلك؟

108
00:07:24,260 --> 00:07:25,790
لا

109
00:07:26,920 --> 00:07:28,040
!لا

110
00:07:28,230 --> 00:07:32,050
!لا! لا! لا أريد أن أفعل المزيد من هذا

111
00:07:33,700 --> 00:07:34,430
...لأنّ

112
00:07:35,430 --> 00:07:36,520
...أنا

113
00:07:37,010 --> 00:07:38,990
العدالة حقّ"، صحيح؟"

114
00:07:38,990 --> 00:07:41,130
الشرّ خاطئ"، صحيح؟"

115
00:07:41,130 --> 00:07:43,410
لكن من يأبه؟

116
00:07:43,850 --> 00:07:46,990
!مع ذلك سوف أفعل ما يحلو لي

117
00:07:47,260 --> 00:07:51,730
!لأنّني لستُ على حقّ! أنا مُخطئة

118
00:07:52,040 --> 00:07:53,170
...هينا

119
00:07:53,170 --> 00:07:56,990
لماذا تقولين ذلك؟ أمّكِ وأبوكِ
—يفعلان هذا لأجلكِ

120
00:07:56,990 --> 00:07:58,700
!لا، لستُما كذلك

121
00:07:58,700 --> 00:08:00,900
أنا من أفعل هذا لأجلكما

122
00:08:01,300 --> 00:08:05,120
يجب أن أكون على حقّ" هذا ما ظننتُه دوماً"

123
00:08:05,120 --> 00:08:08,900
.يجب أن أحرز أعلى العلامات في امتحاناتي"
"يجب أن أتلقّى الإطراء على ما تعلّمتُه

124
00:08:08,900 --> 00:08:11,420
"يجب أن أرسم البسمة في وجهيكما"

125
00:08:11,420 --> 00:08:15,600
.لكن لا يُسمَح لي باللّعب كما يحلو لي
لا يمكنني النّظر إلى هاتفي متى أردتُ ذلك

126
00:08:15,600 --> 00:08:18,430
يجب أن أفعل ما تُمليانه عليّ
وفي الوقت الّذي تريدان

127
00:08:18,430 --> 00:08:21,430
!في كلّ يوم، لا أتمكّن من فعل أيّ شيء

128
00:08:21,430 --> 00:08:22,780
!أكره ذلك

129
00:08:22,780 --> 00:08:26,690
!المدرسة والتعلّم وكعكتك... أكره كلّ شيء

130
00:08:27,070 --> 00:08:28,510
ماذا تقولين؟

131
00:08:28,510 --> 00:08:29,690
—كفي عن هـ

132
00:08:31,260 --> 00:08:35,850
سئمتُ من لعِب دور الفتاة المُهذّبة لأجلكما

133
00:08:35,850 --> 00:08:38,460
هينا الحقيقيّة ليست على حقّ

134
00:08:38,460 --> 00:08:41,030
لكن... لكن لا ضير

135
00:08:44,840 --> 00:08:46,780
لا ضير من يكون المرء على خطأ

136
00:08:46,780 --> 00:08:49,330
لأنّني سوف أعيش لأجل نفسي

137
00:08:51,060 --> 00:08:51,810
!هينا

138
00:08:51,810 --> 00:08:53,090
!انتظري

139
00:08:57,850 --> 00:09:00,520
!ستمدُّك الشّجاعة بالقوّةِ دوماً

140
00:09:00,900 --> 00:09:03,970
هذا كلّ ما يقوله

141
00:09:03,970 --> 00:09:06,490
يحبّ الأبطال اليابانيّين حبّاً جمّاً

142
00:09:06,490 --> 00:09:10,620
ما المشكلةل في ذلك؟ كلّ طفل يحبّ الأبطال

143
00:09:10,620 --> 00:09:13,560
إنَّ الأبطال أروع شيء في الوجود، صحيح؟

144
00:09:13,830 --> 00:09:17,070
أجل! عندما نصل إلى المنزل، لنشاهد
!باتل فينسر معاً

145
00:09:17,070 --> 00:09:18,820
بالتأكيد. بعد العشاء

146
00:09:29,560 --> 00:09:30,800
...أنا

147
00:09:33,070 --> 00:09:36,550
لا أحبّ الأبطال

148
00:09:36,550 --> 00:09:39,470
لا أحبّ التّواجد مع الآخرين. أحبُّ أن أكون وحيدة

149
00:09:39,470 --> 00:09:41,070
أنا مُخطِئة

150
00:09:41,070 --> 00:09:42,460
لكن فليكُن

151
00:09:42,970 --> 00:09:46,230
!هذه هي جماليّات الشرّ خاصّتي

152
00:09:50,900 --> 00:09:53,800
لطالما كنتُ وحيدة

153
00:09:53,800 --> 00:09:57,750
لباسي وطعامي وحيث أعيش
...ومنصبي الحاليّ

154
00:09:57,750 --> 00:10:00,180
كسبتُ كلّ هذا بنفسي

155
00:10:00,180 --> 00:10:01,630
بواسطة شادوفارس

156
00:10:02,200 --> 00:10:05,290
لذا الأمر لا يتمحور حول "المتعة" فقط

157
00:10:05,540 --> 00:10:07,320
الأمر أهمّ من ذلك بكثير

158
00:10:09,040 --> 00:10:15,670
هل نسيتِ أيّتها البطل؟ لم تصغِ الحشرة
الملِكة لأيّ كلمة قالها باتل فينسر

159
00:10:15,670 --> 00:10:19,130
!وأنا كذلك تماماً

160
00:10:20,380 --> 00:10:23,210
يتفعّل تأثير سبخة السمّ

161
00:10:23,210 --> 00:10:24,830
!ألعب بعثّ اللّهب

162
00:10:33,290 --> 00:10:34,360
!هينا

163
00:10:34,360 --> 00:10:37,610
!هلّا صمتِّ فحسب

164
00:10:46,360 --> 00:10:53,620
ينقص تأثيرُ عثّ اللّهب والكلمات الأخيرة
للحريشة المُتجمِّدة دفاعك الأقصى بمقدار 2

165
00:10:53,850 --> 00:10:57,590
ثمّ ألعب ببطاقة التّعويذة كمين دائم

166
00:10:58,440 --> 00:10:59,930
يمنحهم هذا "وارد"؟

167
00:10:59,930 --> 00:11:04,070
هذا ليس كلّ شيء. يجعلني تأثيره
الثّاني أسحب ثلاث بطاقات

168
00:11:04,070 --> 00:11:05,920
...وبالنسبة لتأثيره الثّالث

169
00:11:11,130 --> 00:11:12,540
أنهي دوري

170
00:11:24,400 --> 00:11:27,500
!دوري! أسحب

171
00:11:28,780 --> 00:11:30,200
من جديد؟

172
00:11:30,200 --> 00:11:33,670
هيّا. أريني عدالتكِ الضّعيفة

173
00:11:33,670 --> 00:11:34,840
...هينا

174
00:11:34,840 --> 00:11:38,630
لا أعرف ما الّذي فعلتِه من قبل

175
00:11:38,630 --> 00:11:42,700
!لكن أريتِني أشياء كثيرة تحبّينها

176
00:11:42,700 --> 00:11:46,020
!وأنا أحبّكِ كثيراً

177
00:11:46,750 --> 00:11:50,460
!لذا أريد أن أريكِ الأشياء الّتي أحبُّها

178
00:11:50,460 --> 00:11:53,290
!وهذه واحدة منها

179
00:11:53,290 --> 00:11:57,140
!فلتشهدي! العدالة العظيمة والحصينة

180
00:11:57,930 --> 00:12:01,790
!يعزو الأمر لك الآن يا فاليانت فينسر

181
00:12:06,310 --> 00:12:09,270
،تمّ اللّعِب بفاليانت فينسر مع تعزيز

182
00:12:09,270 --> 00:12:12,450
!لذا يتحفّز تأثير التّعزيز الخاص به

183
00:12:12,450 --> 00:12:17,280
!تعزيز 8! يمكنه التطوُّر من دون استخدام نقاط تطوّر

184
00:12:18,170 --> 00:12:21,840
ثمّ أسحب بطاقات حتّى يكون هناك
،سبع بطاقات في يدي

185
00:12:21,840 --> 00:12:25,590
بالإضافة إلى تعزيز هجمات ودفاعات كلّ أتباع
البطل في يدي بمقدار 1

186
00:12:25,590 --> 00:12:27,970
!وتنقص كلفتهم إلى صفر حتّى ينتهي دوري

187
00:12:28,460 --> 00:12:31,400
!تطوّر، فاليانت فينسر

188
00:12:31,400 --> 00:12:33,740
!يتفعّل تأثيره دائم التطوُّر

189
00:12:38,810 --> 00:12:42,610
يمنح تأثيره دائم التطوُّر قائدي تأثيراً

190
00:12:43,700 --> 00:12:43,860
نمط

191
00:12:43,860 --> 00:12:45,070
نمط
البطل

192
00:12:43,900 --> 00:12:44,070
البطل

193
00:12:44,110 --> 00:12:44,280
رين

194
00:12:44,280 --> 00:12:45,070
رين
كازاماتسوري

195
00:12:44,320 --> 00:12:44,530
كازاماتسوري

196
00:12:45,070 --> 00:12:47,570
!ألعب بكافّة أبطالي ذوي الكلفة صفر

197
00:12:47,940 --> 00:12:49,470
!الشّهم القويّ المُسلّح

198
00:12:49,470 --> 00:12:50,640
!الفارس الجليديّ

199
00:12:50,640 --> 00:12:51,820
!الفارس مخ

200
00:12:51,820 --> 00:12:52,860
!قاطع الرّياح

201
00:12:56,160 --> 00:12:58,480
!أوّلاً، يتفعّل تأثير قائدي

202
00:12:58,480 --> 00:13:04,410
مرّة في كلّ دور، يمكنني تعزيز دفاع
!تابع يدخل وضع اللّعب بمقدار 3 ومنحه فورة

203
00:13:04,410 --> 00:13:08,040
!ثمّ يتفعّل التأثير الأوّل للشّهم القويّ المُسلّح

204
00:13:08,040 --> 00:13:09,890
،يُلحِق 1 ضرراً لنفسه

205
00:13:09,890 --> 00:13:13,320
وحتّى نهاية الدّور، لا يمكن تدميره
!بواسطة التّأثيرات

206
00:13:13,600 --> 00:13:15,000
!لكن هناك المزيد

207
00:13:15,000 --> 00:13:16,270
الفارس الجليديّ

208
00:13:16,270 --> 00:13:21,350
،إذا كان لديّ تابع مُتضرّر في وضع اللّعب
فإنّه يدمّر تابعَ عدوّ

209
00:13:21,650 --> 00:13:24,660
تستعيد كلماته الأخيرة دفاعي بمقدار 3

210
00:13:24,900 --> 00:13:27,350
!التأثير الثّاني للشّهم القويّ المُسلّح

211
00:13:27,350 --> 00:13:32,160
في كلّ مرّة يُدمَّر فيها تابع عدوّ، يُلحق
!ضرراً بمقدار 2 بقائد العدوّ

212
00:13:36,530 --> 00:13:41,470
!ثمّ قاطع الرّياح يهاجم عثّ اللّهب بواسطة فورة

213
00:13:41,470 --> 00:13:46,750
يلحق تأثيره الهجوميّ 3 ضرراً بقائد
!العدوّ إذا كان لديّ تابع مُتضرّر في وضع اللّعب

214
00:13:46,750 --> 00:13:48,180
!الشّهم القويّ المُسلّح

215
00:13:50,970 --> 00:13:52,360
!وهذه هي

216
00:13:52,360 --> 00:13:53,840
!الفارس ماخ

217
00:13:53,840 --> 00:13:58,190
يستطيع الفارس ماخ الهجوم مرّتين
!بفضل قدرة قاطع الرّياح

218
00:13:58,190 --> 00:14:02,200
!يُهاجم قائدك مرّتين

219
00:14:06,950 --> 00:14:09,820
يتفعّل تأثير القائد من الكمين الدّائم

220
00:14:10,140 --> 00:14:14,790
يدمّر أيّ تابع عدوّ مُتضرِّر في نهاية الدّور

221
00:14:19,230 --> 00:14:23,880
لا يمكن تدمير الشّهم القويّ المُسلّح
بواسطة التأثيرات قبل الدّور المُقبل

222
00:14:24,530 --> 00:14:26,760
كم أنتِ مُزعجة

223
00:14:26,760 --> 00:14:29,750
أنتم الأبطال عنيدون لعينون

224
00:14:32,270 --> 00:14:34,520
ألعب ببطاقة النّاقل الجُندُب

225
00:14:34,520 --> 00:14:38,800
يضيف تأثيره تابعاً مع هجوم مقداره 1 إلى يدي

226
00:14:38,800 --> 00:14:40,340
!عضّة السمّ

227
00:14:42,260 --> 00:14:48,520
أستدعي اثنتين من الحريشة المُتجمّدة
مع فورة وآفة، وأسحب بطاقة

228
00:14:49,070 --> 00:14:51,750
!الحريشتان المُتجمّدتان، هاجما

229
00:14:57,570 --> 00:14:59,200
الكلمات الأخيرة

230
00:15:12,510 --> 00:15:15,050
ثمّ ألعب ببطاقة قوّة البناء

231
00:15:15,050 --> 00:15:23,300
،إذا لعبتُ ببطاقتين في هذا الدّور دون احتساب هذه
فأسحب بطاقة وأسترجع 1 نقطة لعب

232
00:15:23,560 --> 00:15:25,560
!التّالي، ألعب بسيّد الحشرات

233
00:15:33,150 --> 00:15:34,670
...تلك البطاقة

234
00:15:34,670 --> 00:15:38,200
إنّه سيّد كلّ الحشرات. لا تحتاجين
شرحاً له ثانية، صحيح؟

235
00:15:39,630 --> 00:15:42,110
!يلحق 4 ضرراً بالفارس ماخ

236
00:15:42,360 --> 00:15:46,190
ولم أنتهِ بعد. تطوَّر يا سيّد الحشرات

237
00:15:52,290 --> 00:15:54,640
!هاجم الفارس الجليديّ

238
00:15:55,460 --> 00:16:00,960
لدى الفارس الجليديّ تأثير ينقص أيّ ضرر
قدره 3 أو أكثر إلى 2 فقط

239
00:16:01,310 --> 00:16:02,980
!أردُّ الهجوم

240
00:16:09,900 --> 00:16:11,660
!وابل الهواء

241
00:16:11,660 --> 00:16:16,570
أعيد النّاقل الجُندُب إلى يدي وألحِق 3 ضرراً

242
00:16:16,570 --> 00:16:18,390
ما رأيكِ يا بطل؟

243
00:16:18,390 --> 00:16:19,960
ألم تشعري بالألم بعد؟

244
00:16:21,340 --> 00:16:23,330
لم أنتهِ بعد

245
00:16:28,930 --> 00:16:30,810
كنتُ أنتظر هذا

246
00:16:30,810 --> 00:16:33,440
أردتُ رؤيتكِ في الأرض

247
00:16:33,440 --> 00:16:36,100
أردتُ رؤية وجهكِ يتلوّى ألماً

248
00:16:36,100 --> 00:16:40,320
والآن، فلتسقطي أمام جماليّات الشرّ خاصّتي

249
00:16:40,320 --> 00:16:45,530
ولتعلمي أنّه لا توجد مجموعة أبطال قادرة
على هزيمة الشرّ، لأنّ الشرّ يقف وحيداً

250
00:16:49,120 --> 00:16:51,560
!لم أبدأ بعد

251
00:16:53,020 --> 00:16:55,940
!ولا أظنّكِ وحيدة

252
00:16:56,580 --> 00:17:02,240
!مثلما لديّ اللّهب السّابع، لديكِ الظّلال السّبعة

253
00:17:02,240 --> 00:17:06,540
أيّاً يكن. الظّلال السّبعة هم أفضل
سبعة لاعبين فحسب

254
00:17:06,540 --> 00:17:08,420
لسنا رفيقتين

255
00:17:08,420 --> 00:17:09,990
هل هذا صحيحٌ حقّاً؟

256
00:17:11,990 --> 00:17:13,720
اصمتي! وما أدراكِ أنتِ؟

257
00:17:13,720 --> 00:17:16,970
!ومصنوعة الغابة هي فئة مزيج

258
00:17:16,970 --> 00:17:20,140
!لديكِ كثير من البطاقات المزيجيّة

259
00:17:20,720 --> 00:17:21,390
—هذا لا

260
00:17:21,390 --> 00:17:22,810
...و... و

261
00:17:22,810 --> 00:17:24,800
!لديكِ أنا يا هينا

262
00:17:29,210 --> 00:17:31,770
يمكننا مشاركة ما نحبّه مع بعضنا الآخر

263
00:17:37,940 --> 00:17:39,080
...نحن

264
00:17:42,950 --> 00:17:45,540
!أعزّ صديقتين

265
00:17:58,860 --> 00:18:00,000
تجمّدي

266
00:18:00,440 --> 00:18:02,220
!تجمّدي فحسب

267
00:18:06,260 --> 00:18:11,260
لماذا لا تستطيعين فهم الفرق
بين الخير والشرّ؟

268
00:18:11,920 --> 00:18:14,280
...مهما كان الاختلاف كبيراً

269
00:18:15,820 --> 00:18:17,560
...مهما كان الاختلاف كبيراً

270
00:18:19,340 --> 00:18:21,400
...إذا تشاركنا ما نحبّ مع بعضنا الآخر

271
00:18:22,390 --> 00:18:24,740
يمكننا الاتّصال معاً

272
00:18:25,860 --> 00:18:29,990
!ما زلتُ أشتعل بريقاً

273
00:18:32,050 --> 00:18:36,790
تتكلّمين بغرور حقّاً. لكن ماذا ستفعلين الآن؟

274
00:18:37,140 --> 00:18:41,620
لا أملك بطاقة في يدي تستطيع الفوز بهذا

275
00:18:42,020 --> 00:18:47,470
لذا بعد تلك الضّربة الهوائيّة الّتي لعبتُ
بها للتوّ، سوف أعلِّق كلّ آمالي

276
00:18:47,470 --> 00:18:49,640
على البطاقة الّتي أسحبها الآن

277
00:18:53,320 --> 00:18:57,190
طيش. سخافة. لكن هكذا هم الأبطال

278
00:18:57,190 --> 00:19:00,350
افعليها. أثبتي ذلك لي بنفسكِ

279
00:19:00,610 --> 00:19:02,870
أثبتي عدم وجود أمل

280
00:19:02,870 --> 00:19:04,870
!هناك! أنا متأكّدة بأنّ هناك أمل

281
00:19:05,190 --> 00:19:08,250
...لأنّه عندما يقع البطل في ورطة

282
00:19:17,160 --> 00:19:19,420
...ا-الرمّاح

283
00:19:19,680 --> 00:19:21,030
المُخضرم...

284
00:19:23,050 --> 00:19:24,960
!مجرّد بطاقة مع وارد

285
00:19:26,410 --> 00:19:29,350
...لكن بهذا الـ"وارد"، يمكنني

286
00:19:29,610 --> 00:19:32,080
!لا أمل! لا أمل! لا أمل

287
00:19:32,690 --> 00:19:35,400
لا يمكنكِ قلب الموازين ببطاقة واحدة فقط

288
00:19:35,400 --> 00:19:38,020
الحياة الواقعيّة لا تسير هكذا

289
00:19:38,620 --> 00:19:41,340
يتفعّل تأثير سبخة السمّ

290
00:19:41,340 --> 00:19:43,520
أستدعي حريشة مُتجمِّدة

291
00:19:43,520 --> 00:19:45,400
!توجيه الطّبيعة

292
00:19:45,400 --> 00:19:47,990
...تُعيد تابعاً إلى يدي

293
00:19:51,130 --> 00:19:53,250
وأسحب بطاقة

294
00:19:53,490 --> 00:19:57,490
!ألعب بحريشة مُتجمِّدة إضافيّة وناقل جُندُب

295
00:19:58,800 --> 00:20:02,060
تضيف تلك البطاقة تابعاً آخر مع هجمة
!بمقدار 1 إلى يدك

296
00:20:02,060 --> 00:20:03,430
خطأ

297
00:20:03,430 --> 00:20:06,000
يتفعّل تأثير النّاقل الجُندُب

298
00:20:06,000 --> 00:20:08,850
،إذا لعبنا بثلاث بطاقات في هذا الدّور

299
00:20:08,850 --> 00:20:12,390
يضيف تابعاً بهجوم مقداره 3 إلى يدي

300
00:20:12,390 --> 00:20:16,840
!والبطاقة الّتي أضافها... كانت هذه

301
00:20:20,800 --> 00:20:23,770
يسقط السمُّ الأوّل

302
00:20:24,270 --> 00:20:27,650
جمّد الحياة وثبّتها جيّداً

303
00:20:30,020 --> 00:20:31,960
!أيّتها المُغير الدبُّور

304
00:20:32,800 --> 00:20:35,050
لـ-ليست ملكة فراشات؟

305
00:20:35,270 --> 00:20:38,420
هذه بطاقتي الأفضل الأخرى

306
00:20:38,420 --> 00:20:40,910
لن تنجي من هذا

307
00:20:40,910 --> 00:20:43,480
يتفعّل تأثير المُغير الدبُّور

308
00:20:44,510 --> 00:20:47,540
...يدمّر كافّة الأتباع الّذين لديّ في وضع اللّعب

309
00:20:49,470 --> 00:20:54,880
ومقابل كلّ تابع مُدمَّر، يستدعي
مُحارب دبُّور مع فورة وآفة

310
00:20:55,180 --> 00:20:57,670
!الكلمات الأخيرة للحريشة المُتجمِّدة

311
00:21:07,170 --> 00:21:09,280
!مُحاربي الدبُّور الخاصّين بي يهاجمون

312
00:21:12,370 --> 00:21:15,210
لكن المُغيرين الدبابير لا يملكون عاصفة

313
00:21:15,210 --> 00:21:16,010
...هذا الدّور

314
00:21:19,030 --> 00:21:21,520
أخبرتُكِ بأنّ الأمر انتهى

315
00:21:22,740 --> 00:21:24,890
تأثير المُغير الدبُّور

316
00:21:25,540 --> 00:21:28,130
،في كلّ مرّة يهاجم فيها أحدُ أتباعي

317
00:21:28,130 --> 00:21:31,520
ينقص الدّفاع الأقصى لقائد العدوُّ بمقدار 1

318
00:21:31,520 --> 00:21:36,470
وإذا تمّ تدمير 10 من الحريشة المُتجمِّدة
،على الأقلّ في هذه المعركة

319
00:21:36,470 --> 00:21:38,930
يتغيّر ذلك الرّقم إلى 3 بدلاً من 1

320
00:21:41,710 --> 00:21:48,740
وبالتّالي، الهجوم بمُحارِبَي دبُّور يخفّض
دفاعكِ بمقدار 6

321
00:21:51,910 --> 00:21:53,910
وداعاً أيّتها البطل

322
00:21:55,590 --> 00:21:59,670
!فلتغرقي في جماليّات الشرِّ خاصّتي

323
00:22:13,120 --> 00:22:14,850
ربحتُ

324
00:22:14,850 --> 00:22:18,840
إذا لم أتحفّظ، فالعدالة ليست ندّاً لي

325
00:22:18,840 --> 00:22:20,910
هل تفهمين أيّتها البطل؟

326
00:22:21,340 --> 00:22:22,580
...كان ذلك

327
00:22:22,580 --> 00:22:24,690
—ماذا؟ ما زلتِ تتكلّمين

328
00:22:24,690 --> 00:22:27,170
!كان ذلك مُمتعاً للغاية

329
00:22:27,170 --> 00:22:29,830
هل استمتعتِ أيضاً يا هينا؟

330
00:22:30,820 --> 00:22:32,190
...هل ما زلتِ

331
00:22:33,070 --> 00:22:35,610
هل ما زلتِ تتفوّهين بهذا الهُراء؟

332
00:22:35,930 --> 00:22:38,390
أنتِ وأنا مختلفتان

333
00:22:38,390 --> 00:22:41,290
!اعفيني من هرائكِ الغبيّ

334
00:22:40,500 --> 00:22:41,580
هينا

335
00:22:42,140 --> 00:22:44,060
أُغمي عليها

336
00:22:48,430 --> 00:22:50,380
طفلة حمقاء

337
00:22:50,810 --> 00:22:52,390
أنتِ مستاءة

338
00:22:52,660 --> 00:22:54,200
ماذا تحاولين أن تقولي؟

339
00:22:54,200 --> 00:22:58,080
،لا شيء. لكن إذا كنتِ شرِّيرة
أفلا ينبغي أن تضحكي؟

340
00:22:58,470 --> 00:23:00,730
أنتِ تهدرين هذا الوجه الظّريف

341
00:23:02,500 --> 00:23:04,440
ما خطب الجميع؟

342
00:23:05,910 --> 00:23:07,850
أثبتُّ لكِ بأنّني أفضل منكِ

343
00:23:08,350 --> 00:23:10,890
لا حاجة لمقاتلتكِ بعد الآن

344
00:23:12,020 --> 00:23:16,310
...لذا لا تُريني وجهكِ أبداً ثانية

345
00:23:16,310 --> 00:23:17,920
أيّتها البطل

346
00:23:23,930 --> 00:23:25,600
!استعراض بطاقة شادوفارس

347
00:23:25,600 --> 00:23:27,710
...بطاقة اليوم هي... المعذرة

348
00:23:27,710 --> 00:23:28,620
ماذا؟ ما الأمر؟

349
00:23:28,620 --> 00:23:33,180
أ-أ-أنا آسفة! أنت رائع حقّاً فحسب
!يا ريوغا! تبدو كقائد للأشرار

350
00:23:33,180 --> 00:23:34,180
...ماذا؟ أنا

351
00:23:34,180 --> 00:23:36,600
...هل لديك أيّ حركات خاصّة؟ أم ربّما

352
00:23:36,600 --> 00:23:38,840
الكثير من الضّوضاء

353
00:23:38,840 --> 00:23:41,210
