1
00:00:05,290 --> 00:00:08,410
!كانت معركة مُبهرة

2
00:00:08,410 --> 00:00:12,900
تنّين اللّهب اللّانهائي الخاص
...بهيرو، والخاص بلوكا

3
00:00:12,900 --> 00:00:14,480
سيّد هلاك الهاوية

4
00:00:14,480 --> 00:00:17,120
!صحيح! سيّد هلاك الهاوية

5
00:00:17,120 --> 00:00:21,380
عندما اشتبك كلاهما معاً، ظننتُ
بأنّ الملعب سينفجر

6
00:00:21,380 --> 00:00:24,500
!أجل! أعتقد كانت أفضل معركة يخوضونها إلى الآن

7
00:00:25,270 --> 00:00:30,380
وبالطبع دوّنتُ مُلاحظات عن كلّ نقلة يا هيرو

8
00:00:31,540 --> 00:00:33,580
!كان ذلك ممتعاً للغاية

9
00:00:33,580 --> 00:00:35,930
شكراً من جديد يا لوكا

10
00:00:38,360 --> 00:00:40,760
أنت أيضاً يا هيرو

11
00:00:45,240 --> 00:00:46,690
أنتما

12
00:00:47,000 --> 00:00:49,510
هدأ كلّ شيء الآن، صحيح؟

13
00:00:49,720 --> 00:00:50,930
أجل

14
00:00:51,330 --> 00:00:55,950
أنقذنا العالم وهيرو وأنهيتُ معركتنا
في البطولة الوطنيّة

15
00:00:56,470 --> 00:00:58,530
لا أعتقد أنّه بقي شيء لنفعله

16
00:00:58,750 --> 00:01:01,950
ليس عليك تصوير الأمر على أنّك
على وشك أن تموت

17
00:01:01,950 --> 00:01:04,750
يمكننا رؤية بعضنا الآخر غداً إذا أردنا

18
00:01:05,450 --> 00:01:06,930
أنت غبيّ جدّاً

19
00:01:07,940 --> 00:01:12,700
لا يمكننا الخروج معاً للأبد. هذا ما يقصده

20
00:01:12,700 --> 00:01:18,110
هذا صحيح. عليّ العودة إلى
...كوني آيدول و

21
00:01:19,400 --> 00:01:20,600
...آليس

22
00:01:21,060 --> 00:01:23,220
جميعكم لديكم أشياء تريدون فعلها، صحيح؟

23
00:01:23,450 --> 00:01:26,760
سأخوض رحلة قصيرة

24
00:01:26,760 --> 00:01:30,060
هناك الكثير ممّا أريد تعلّمه عن العالم

25
00:01:30,280 --> 00:01:34,060
أظنّني سأكون مشغولاً لبعض الوقت أيضاً

26
00:01:34,060 --> 00:01:39,190
هناك شيوري... ولديّ بعض الأشياء
الّتي أريد التّفكير فيها

27
00:01:39,190 --> 00:01:41,700
جميعكم مشغولون حقّاً

28
00:01:41,700 --> 00:01:44,360
كذلك أنت

29
00:01:44,960 --> 00:01:47,410
كلّ ما عليّ فعله هو المساعدة في المطعم

30
00:01:47,410 --> 00:01:48,470
الامتحانات

31
00:01:49,190 --> 00:01:52,670
كازوكي، وعدتَ أخوتك الصّغار، أنسيت؟

32
00:01:52,670 --> 00:01:54,670
هذا صحيح. فعلت

33
00:01:55,500 --> 00:01:58,410
أجل، هذا صحيح

34
00:01:58,410 --> 00:02:00,100
لا تقلق يا هيرو

35
00:02:00,540 --> 00:02:03,270
هذه المرّة، سآتي لأخذك

36
00:02:03,270 --> 00:02:06,400
مهما تباعدنا، ستبقى قلوبنا متّصلة، صحيح؟

37
00:02:07,170 --> 00:02:08,770
الوداع

38
00:02:08,770 --> 00:02:10,880
!أجل، إلى اللّقاء

39
00:02:13,250 --> 00:02:17,520
هذا مُحزن بعض الشيء. لكن جميعنا
أصدقاء، أليس كذلك؟

40
00:02:17,850 --> 00:02:20,870
في المرّة القادمة الّتي نرى بعضنا الآخر
فيها، سنكون جميعنا في المدرسة الثّانويّة

41
00:02:20,870 --> 00:02:23,210
آمل أن نصل جميعنا إلى هناك

42
00:02:23,210 --> 00:02:24,830
ما-ماذا قلت؟

43
00:02:24,830 --> 00:02:27,010
إن لم تبدأ بالدّراسة، فلن تنجح

44
00:02:27,010 --> 00:02:29,000
!من فضلك اخضع للاختبار عنّي

45
00:04:05,150 --> 00:04:06,520
هل أيقظتُك؟

46
00:04:06,520 --> 00:04:09,590
لا. كنتُ أحلم بالماضي حلم يقظة

47
00:04:10,390 --> 00:04:12,480
أيّ ماضٍ؟

48
00:04:13,040 --> 00:04:16,140
عندما قلت بأنّك ستأتي لتأخذني

49
00:04:16,140 --> 00:04:19,640
أتذكّر ذلك

50
00:04:20,140 --> 00:04:22,190
فعلتَ حقّاً

51
00:04:22,600 --> 00:04:23,900
أجل

52
00:04:24,440 --> 00:04:27,410
وتمكّنتُ من منحك المقعد الّذي تستحقّه

53
00:04:27,770 --> 00:04:30,870
...كنتُ قد تمنّيتُ مجيء الآخرين أيضاً، لكن

54
00:04:31,260 --> 00:04:34,990
جميعهم... جميعهم لديهم دربهم الخاص

55
00:04:34,990 --> 00:04:38,000
أجل. وأنا أريد احترام ذلك

56
00:04:39,330 --> 00:04:40,500
...لوكا

57
00:04:40,950 --> 00:04:44,250
...بخصوص منطقة الظلّ

58
00:04:45,330 --> 00:04:47,460
هل يمكنني أن أكون أوّل من يقاتلهم؟

59
00:04:47,890 --> 00:04:49,850
تريد أن تكون الأوّل؟

60
00:04:49,850 --> 00:04:52,350
...أجل، في الحقيقة

61
00:04:52,750 --> 00:04:55,590
سيتشوّق المُتحدُّون لقتال

62
00:04:55,590 --> 00:04:57,900
علينا أن نمنحهم ترحيباً مناسباً

63
00:04:58,330 --> 00:05:03,030
وأنت الشّخص المثالي لتُريهم قوّة الظّلال السّبعة

64
00:05:03,030 --> 00:05:04,520
أتفهّم ما تقوله

65
00:05:04,770 --> 00:05:06,910
!حسناً، سألعب بجدّية

66
00:05:06,910 --> 00:05:08,840
ستلعب بجدّية، أجل

67
00:05:10,070 --> 00:05:13,830
لكن وفّر الأفضل لديك لوقت لاحق

68
00:05:15,650 --> 00:05:17,840
...لطالما فكّرتُ في هذا، لكن

69
00:05:17,840 --> 00:05:21,520
الظّلال السّبعة بحدِّ ذاتهم أقوياء

70
00:05:21,520 --> 00:05:22,760
آسف يا هيرو

71
00:05:23,510 --> 00:05:27,960
سأحضّر مكاناً لك في منطقة الظلّ. أعِدُك

72
00:05:28,320 --> 00:05:29,720
حسناً يا لوكا

73
00:05:30,800 --> 00:05:35,180
!سأريهم قوّة الظّلال السّبعة بهذه

74
00:05:38,300 --> 00:05:40,600
"هذه نقطة ضعفك"

75
00:05:45,050 --> 00:05:47,770
حسناً. سأدمّرك أوّلاً

76
00:05:48,620 --> 00:05:50,780
!قِتال! شادوفارس

77
00:06:13,630 --> 00:06:14,900
دوري

78
00:06:14,900 --> 00:06:15,840
سحب

79
00:06:17,250 --> 00:06:22,180
إذا كنتَ لاعب مصنوعة تنّين، فأفترض
بأنّك ستبدأ بالتنّين العاجي

80
00:06:22,490 --> 00:06:26,190
أو ربّما ستنهي دورك فحسب
وترى ما سوف أفعله

81
00:06:27,100 --> 00:06:28,570
تعرف الفئة جيّداً

82
00:06:28,570 --> 00:06:30,180
أعتقد أجل

83
00:06:33,290 --> 00:06:35,740
قاتلتُه أكثر ممّا أرغب

84
00:06:37,510 --> 00:06:41,720
ميكادو شيروغاني، لقد رأيتُ سجلّ لعِبك

85
00:06:41,720 --> 00:06:45,930
بعد نقطة معيّنة، توقّفتَ عن الخسارة فحسب

86
00:06:45,930 --> 00:06:49,010
لا... خسرتَ مُباراة واحدة على ما أفترض

87
00:06:49,010 --> 00:06:52,850
نسيتُ كلّ ذلك. كانت ضربة حظّ، هذا
كلُّ ما في الأمر

88
00:06:52,850 --> 00:06:54,380
أجل

89
00:06:54,690 --> 00:06:56,600
وهذه نقطة ضعفك

90
00:06:59,610 --> 00:07:01,770
هذه ليست بطاقة مصنوعة تنّين

91
00:07:01,770 --> 00:07:05,220
إنَّ الافتراضات ستجعل من المستحيل
لك أن تغيّر مستقبلك

92
00:07:06,380 --> 00:07:12,170
الفئة الّتي أستخدمها هي الجائزة الخاصّة
التي نحصل عليها من التّصنيف العالمي

93
00:07:12,590 --> 00:07:14,820
:أسياد الميكانيكا والأرتيفاكت

94
00:07:14,820 --> 00:07:16,280
!فئة مصنوعة البوّابة

95
00:07:24,830 --> 00:07:28,210
تضيف أرتيفاكت التّحليل إلى يدي

96
00:07:28,210 --> 00:07:31,120
وأسحب بطاقة في نهاية دوري

97
00:07:31,120 --> 00:07:34,180
فهمت. تأثير غير معتاد

98
00:07:34,180 --> 00:07:35,200
أجل

99
00:07:35,200 --> 00:07:39,740
إنّ مصنوعة البوّابة هي المفتاح الأوّل
الّذي يؤدّي إلى الآرك

100
00:07:39,740 --> 00:07:41,360
هكذا إذاً

101
00:07:41,360 --> 00:07:45,870
من المذهل أن تتمكّن من صنع شيء
مثل منطقة الظلّ

102
00:07:45,870 --> 00:07:49,660
منطقة الظلّ هي مجرّد جزء من برَكات الآرك

103
00:07:50,870 --> 00:07:54,160
إذاً ماذا يحدث إذا حصلتُ على كافّة المفاتيح؟

104
00:07:55,010 --> 00:08:00,080
الآن، نحن نتحدّاكم لنرى ما إن كنتُم
جديرين فعلاً بالاكتشاف

105
00:08:00,430 --> 00:08:04,630
ميكادو، أنت قويّ وصلب

106
00:08:04,630 --> 00:08:07,290
وبالتّالي، أنت ضعيف وواهن

107
00:08:08,410 --> 00:08:10,860
!هذا ذكيّ جدّاً

108
00:08:10,860 --> 00:08:13,720
من الواضح بأنّك تعتقد بأنّك لامع الذّكاء

109
00:08:13,720 --> 00:08:18,260
لكن أنت لا تعلم شيئاً عن أصحاب الموهبة، أليس كذلك؟

110
00:08:18,510 --> 00:08:23,880
الآرك، مصنوعة البوّابة... كلاهما لا يهمّانني

111
00:08:23,880 --> 00:08:25,930
ليس عندما لا يُحقّقان الرّضا لي

112
00:08:26,760 --> 00:08:30,790
لا يوجد رجلٌ يرضى ما لم يمضي قُدماً بمفرده

113
00:08:30,790 --> 00:08:32,060
ألعب بالأسد الفولاذي السّحري

114
00:08:39,840 --> 00:08:44,040
تأثيره يضيف اثنتين من آرتيفاكت
التّحليل إلى مجموعة أوراقي

115
00:08:44,660 --> 00:08:48,490
يبدو أنّك ترفض فكرة السّماح لأحد بفهمك

116
00:08:48,750 --> 00:08:51,890
لا يستطيع الأشخاص العاديّون عادةً فهمي

117
00:08:51,890 --> 00:08:55,710
لكنّني أفهمك جيّداً

118
00:08:55,710 --> 00:08:57,010
تفهمني؟

119
00:08:57,010 --> 00:09:01,470
تضع هذا القِناع لأنّك لا تثِق بنفسك، صحيح؟

120
00:09:01,470 --> 00:09:02,730
أنا أكشفك

121
00:09:04,560 --> 00:09:08,790
وأنا أعلم سلفاً آليّة عمل فئة مصنوعة البوّابة هذه

122
00:09:08,790 --> 00:09:15,580
،تُضيف بطاقات قويّة لمجموعة أوراقها
الأمر الّذي يُعتبَر موطِن هجومها الرّئيسي، صحيح؟

123
00:09:15,580 --> 00:09:17,360
هذا صحيح

124
00:09:17,360 --> 00:09:19,370
رأيت؟ هذا سهل جدّاً

125
00:09:19,370 --> 00:09:23,080
بالنسبة لي، العالم بسيط جدّاً فحسب

126
00:09:23,080 --> 00:09:26,850
إنَّ اللّاعب الّذي لا اسمه له ليس ندّاً لي

127
00:09:27,780 --> 00:09:30,340
أنا مهتمّ بمزيد من اللّاعبين الأقوياء

128
00:09:30,340 --> 00:09:33,070
مثل ولفرام زيرغا على سبيل المثال

129
00:09:33,510 --> 00:09:34,640
أنهي دوري

130
00:09:34,980 --> 00:09:39,980
ويتفعّل تأثير المعبد السّماويّ

131
00:09:40,310 --> 00:09:44,310
إذا كان لديّ 2 أو أكثر من نقاط اللّعب
،في نهاية دوري

132
00:09:44,310 --> 00:09:47,270
أستدعيه بشكل مُباشر من مجموعة أوراقي

133
00:09:50,340 --> 00:09:54,060
...لا تتحفّظ. تابع واركع

134
00:09:55,220 --> 00:09:57,380
أمام مجدي

135
00:09:57,850 --> 00:09:59,880
دوري. اسحب

136
00:10:00,880 --> 00:10:02,870
جنديّ الماكينة الحماسيّ

137
00:10:06,340 --> 00:10:11,460
تأثيره يضيف بطاقة آرتيفاكت من
مجموعة أوراقي إلى يدي

138
00:10:11,690 --> 00:10:16,380
أجل. من الطبيعي أن يكون لديك بطاقات كهذه

139
00:10:16,380 --> 00:10:18,770
الأسد الفولاذي السّحري يهاجم قائدك

140
00:10:23,240 --> 00:10:24,970
مع الأسف

141
00:10:24,970 --> 00:10:27,940
...جائزتك الخاصّة، هذه الفئة الخاصّة

142
00:10:27,940 --> 00:10:30,160
هذا ليس أكثر ممّا توقّعت

143
00:10:30,160 --> 00:10:32,060
دوري. اسحب

144
00:10:33,430 --> 00:10:37,730
في بداية دوري، تأثير المعبد السّماوي يتفعّل

145
00:10:37,730 --> 00:10:43,560
،إذا كنتُ لا أملك "عودة إلى الجنّة" بيدي
تُضاف واحدة من مجموعة أوراقي

146
00:10:45,490 --> 00:10:47,620
ألعب برسول الظّلام

147
00:10:49,840 --> 00:10:55,250
فيما يلي، ألعب ببطاقة تعويذة "عودة
إلى الجنّة" المُضافة توّاً إلى يدي

148
00:10:59,390 --> 00:11:02,130
،تدمّر تابعاً مُحايداً لديّ في وضع اللّعب

149
00:11:02,130 --> 00:11:05,570
ثمّ أضيف نسخةً أخرى منه إلى يدي

150
00:11:05,570 --> 00:11:11,630
،وإذا كان هذا التّابع من نوع معيّن
فإنّه يصبح تابعاً ملائكيّاً

151
00:11:13,180 --> 00:11:18,470
وتدمير مبعوث الظّلام يفعِّل كلماته الأخيرة

152
00:11:18,470 --> 00:11:21,350
أضيف المُجنّح المعكوس إلى أوراق يدي

153
00:11:21,700 --> 00:11:24,330
ثمّ ألعب برسول الأجنحة المُضيئة

154
00:11:28,890 --> 00:11:31,030
مجموعة ورق ملاك ومُنزَّل؟

155
00:11:31,480 --> 00:11:35,320
يتفعّل تأثير رسول الأجنحة المُضيئة. إنّه يتطوّر

156
00:11:36,070 --> 00:11:38,580
يُهاجم جنديّ الماكينة الحماسيّ

157
00:11:41,670 --> 00:11:43,020
ما رأيك؟

158
00:11:43,020 --> 00:11:45,720
نور مثاليّ وظلام مثاليّ

159
00:11:46,110 --> 00:11:48,810
أليسا مثاليّين بالنسبة لي بما أنّني مثاليّ؟

160
00:11:48,810 --> 00:11:53,980
صحيح، التحكّم بالنّور والظّلام يجعلك قويّاً

161
00:11:54,770 --> 00:11:57,500
لكن من ناحية، إنّه غير مُكتمل

162
00:11:57,980 --> 00:12:00,690
لهذا أنت لا تحقِّق أيّ تقدُّم

163
00:12:00,690 --> 00:12:02,420
لا، بل لا يمكنك تحقيق تقدُّم

164
00:12:16,810 --> 00:12:19,750
ألعب الآن بآرتيفاكت التّحليل

165
00:12:21,440 --> 00:12:26,520
يتفعّل تأثير التّميمة الّتي لعبتُها
للتو، التّسارعيّة

166
00:12:27,070 --> 00:12:31,550
في كلّ مرّة يدخل فيها تابع آرتيفاكت
اللّعب بجانبي، يحظى بـ فورة

167
00:12:31,550 --> 00:12:34,880
إذا تمّ اللّعب به، أسترجع نقطة لعِب واحدة

168
00:12:35,530 --> 00:12:39,360
آرتيفاكت التّحليل يهاجم رسول الأجنحة المُضيئة

169
00:12:40,810 --> 00:12:45,040
تشتعل الكلمات الأخيرة خاصّته، وأسحب بطاقة

170
00:12:45,490 --> 00:12:48,870
فيما يلي، الأسد الفولاذي السّحري يُهاجم قائدك

171
00:12:51,610 --> 00:12:56,210
ألعب بمرثاة الشّيطان وأنهي دوري

172
00:12:56,480 --> 00:12:58,900
...تتكلّم كثيراً حقّاً

173
00:12:58,900 --> 00:13:02,580
لكن لا يحقّ لشخص مثلك أن يحاضرني

174
00:13:04,440 --> 00:13:09,770
إنّ مصنوعة البوّابة ليست بتلك القوّة، صحيح؟
إنّها مُملّة وبطيئة

175
00:13:09,770 --> 00:13:13,360
أوّلاً، يضيف المعبد السّماوي بطاقة إلى يدي

176
00:13:14,160 --> 00:13:15,850
ثمّ ألعب بجنديّ الملاك الفاسد

177
00:13:19,490 --> 00:13:23,360
يضيف تأثيره مُجنّحاً معكوساً إلى يدي

178
00:13:26,270 --> 00:13:29,200
اخترتُ اللّعب به كمُنزَّل

179
00:13:32,230 --> 00:13:37,380
يا رجُل مصنوعة التنّين. أو بالأحرى
...لاعب مصنوعة البوّابة

180
00:13:37,380 --> 00:13:39,340
لا تستطيع إرضائي

181
00:13:41,550 --> 00:13:45,470
لا، أنا متأكّد بأنّه لا يستطيع أحد

182
00:13:45,880 --> 00:13:48,460
،يتفعّل تأثير ليريال الظّلامي

183
00:13:48,460 --> 00:13:52,530
ليعزّز هجوم ودفاع تابع مُحايد
بكلفة 5 أو أقلّ

184
00:13:52,530 --> 00:13:55,490
ممّا لديّ في وضع اللّعب، ومنحه فورة

185
00:13:55,490 --> 00:14:00,030
فيما يلي، ألعب بالمُجنَّح المعكوس بهيئة الملاك

186
00:14:00,030 --> 00:14:03,810
،ليُعيد أحد أتباعي إلى هيئتهم الأصليّة

187
00:14:03,810 --> 00:14:07,120
ويعزّز هجومه ودفاعه بمقدار 2 ومنحه فورة

188
00:14:07,360 --> 00:14:09,510
ثمّ أُطوِّر ليريال

189
00:14:14,800 --> 00:14:18,670
تأثيرها التطوُّري بشكل دائم يُلحِق
ضرراً واحدً بتابع عدوّ

190
00:14:19,320 --> 00:14:23,490
الجنديّ الملاك الفاسد يهاجم أسد الفولاذ السّحري

191
00:14:27,810 --> 00:14:29,170
سهل للغاية

192
00:14:29,860 --> 00:14:34,180
أنت أحد السّبعة الأقوى، وهذا
كلّ ما لديك؟ مُضحك للغاية

193
00:14:48,020 --> 00:14:51,510
لم أقل أبداً بأنّني كنتُ الأقوى

194
00:14:53,860 --> 00:14:56,760
!هذا ما يناديني به الآخرون فحسب

195
00:15:03,790 --> 00:15:07,970
.أنت تُطلِق الافتراضات فحسب. تصرخ
وتتظاهر بأنّك لا ترى

196
00:15:07,970 --> 00:15:12,880
لكن هناك عالم خارج عالمك

197
00:15:31,360 --> 00:15:34,110
ما هذا التّابع؟

198
00:15:35,360 --> 00:15:37,360
الإله من الآلة

199
00:15:40,320 --> 00:15:44,450
تأثيرها يمنح قائدي تأثيراً جديداً

200
00:15:46,500 --> 00:15:49,260
أُطوِّر الإله من الآلة

201
00:15:54,250 --> 00:15:56,100
أهاجم ليريال

202
00:16:00,270 --> 00:16:01,970
أنهي دوري

203
00:16:01,970 --> 00:16:03,300
...و

204
00:16:03,300 --> 00:16:05,840
!دوري يا مُسنّنات القدر

205
00:16:05,840 --> 00:16:08,570
يتفعّل التأثير الممنوح من الإله من الآلة

206
00:16:08,820 --> 00:16:11,390
...وفي نهاية دوري، إذا كنتُ مُتناغماً

207
00:16:11,390 --> 00:16:15,440
أي، إذا كنتُ أملك عدداً متساوياً
،من البطاقات في مجموعة أوراقي

208
00:16:15,440 --> 00:16:18,870
أطرح كامل ما بيدي وأسحب ستّ بطاقات

209
00:16:19,870 --> 00:16:22,070
ستّ بطاقات بتأثير واحد؟

210
00:16:22,370 --> 00:16:27,430
سأريك معركة تفوق فهم الزّائلين. عالماً لا تعرفه

211
00:16:28,680 --> 00:16:30,120
عالم لا أعرفه؟

212
00:16:30,550 --> 00:16:32,720
!هذا مستحيل

213
00:16:37,470 --> 00:16:39,150
إنّه العكس تماماً

214
00:16:39,150 --> 00:16:43,100
أنا العالم الّذي لا تعرفه أنت. وأنت
على وشك أن تتعلّم ذلك

215
00:16:52,750 --> 00:16:55,130
ألعب بالجنديّ الملاك الطّاهر

216
00:16:57,570 --> 00:17:01,590
يُضيف تأثير "عودة إلى الجنّة" إلى يدي

217
00:17:05,010 --> 00:17:07,660
فيما يلي، ألعب بالتّلميذ الأسود الفاحم

218
00:17:10,470 --> 00:17:13,110
يُلحِق 3 ضرراً بتابع للعدوّ

219
00:17:14,370 --> 00:17:17,840
ثمّ يتحفّز تأثيره الثّاني

220
00:17:17,840 --> 00:17:22,450
في كلّ مرّة أدمِّر تابعاً للعدوّ، أضيف
مُجنّحاً معكوساً إلى يدي

221
00:17:22,780 --> 00:17:25,670
سأكون أنا من يربح مهما حدث

222
00:17:26,260 --> 00:17:31,190
عودة إلى الجنّة تدمّر تابعاً مُحايداً
،لديّ في وضع اللّعب

223
00:17:31,190 --> 00:17:33,510
وتضيف نسخة منه إلى يدي

224
00:17:33,510 --> 00:17:38,660
،وإذا كان ذلك التّابع من نوع مُعيّن
فإنّه يُصبح تابعاً ملاكاً

225
00:17:38,660 --> 00:17:41,720
يتفعّل تأثير جنديّ الملاك الطّاهر

226
00:17:41,720 --> 00:17:46,470
،لدور واحد، عندما ألعب بالمُجنَّح المعكوس

227
00:17:46,470 --> 00:17:48,450
فإنّه يُلحِق 2 ضرر بقائد العدوّ

228
00:17:50,350 --> 00:17:53,280
لن تتمكّن من البقاء خالي التّعابير فترة طويلة

229
00:17:53,280 --> 00:17:55,290
سوف تبكي خلال لحظات

230
00:17:55,290 --> 00:17:57,140
أتريدني أن أبكي؟

231
00:17:57,140 --> 00:18:02,820
لا. كلّ ما في الأمر أنَّ كلّ من يقاتلني ينهار

232
00:18:02,820 --> 00:18:04,030
أشكُّ في ذلك

233
00:18:04,540 --> 00:18:08,430
أنا واثق بأنّ هناك شخصاً واحداً على
الأقلّ لم يبكِ إطلاقاً

234
00:18:10,030 --> 00:18:13,940
الشّخص الّذي كان قادراً على
هزيمتك عندما كنتَ جادّاً

235
00:18:24,580 --> 00:18:27,280
ماذا علّمك؟

236
00:18:27,280 --> 00:18:30,490
لا شيء. أنا؟ تعلّمتُ منه؟

237
00:18:30,490 --> 00:18:33,000
مستحيل" هو ما أنت على وشك أن تقوله"

238
00:18:33,330 --> 00:18:34,470
حسناً، أنت مخطئ

239
00:18:34,740 --> 00:18:38,470
لا يمكنك قبول ضعفك فحسب

240
00:18:38,470 --> 00:18:41,270
لا يمكنك قبول الهزيمة

241
00:18:41,270 --> 00:18:43,600
ألعب بالكائن التّركيبي ميريام

242
00:18:44,190 --> 00:18:47,170
عندما أكون مُتناغماً بعدد مُتساوٍ
،من البِطاقات في مجموعة أوراقي

243
00:18:47,170 --> 00:18:49,440
يمكنني اختيار أي نسخة ألعب

244
00:18:49,440 --> 00:18:52,070
أختار لا ديبابلوتين ميريام

245
00:18:55,370 --> 00:19:00,250
ينقل تأثيرُها بطاقةَ آرتيفاكت عشوائيّة
من مجموعة أوراقي إلى يدي

246
00:19:01,300 --> 00:19:03,410
ألعب بآرتيفاكت التّحليل

247
00:19:07,230 --> 00:19:11,170
التسارعيّة تمنحه فورة وتستعيد نقطة لعِب واحدة

248
00:19:11,760 --> 00:19:16,430
ويتفعّل التأثير الآخر الّذي أعطتني
إيّاه الإله من الآلة

249
00:19:16,430 --> 00:19:21,340
،في كلّ مرّة ألعب فيها ببطاقة آرتيفاكت
أسترجع نقطة لعِب واحدة

250
00:19:21,340 --> 00:19:22,600
!هجوم

251
00:19:24,540 --> 00:19:26,970
كلماته الأخيرة تعني أن أسحب بطاقة

252
00:19:27,280 --> 00:19:29,600
!بطاقة تعويذة: التّصنيع الحيويّ

253
00:19:30,330 --> 00:19:31,900
تعويذة بكلفة صفر؟

254
00:19:32,850 --> 00:19:36,700
إنّها تُنقِص كلفة بطاقة آرتيفاكت
في يدي بمقدار 1

255
00:19:36,700 --> 00:19:41,840
وتضيف ثلاث نسخ من تلك الآرتيفاكت
إلى مجموعة أوراقي

256
00:19:41,840 --> 00:19:45,460
ألعب بآرتيفاكت التّحليل وبسيّاف الجناح الميكانيكي

257
00:19:50,170 --> 00:19:52,900
يتفعّل تأثير سيّاف الجناح الميكانيكيّ

258
00:19:52,900 --> 00:19:57,790
أضيف بطاقتَي آرتيفاكت عشوائيّتين
إلى يدي وأنهي دوري

259
00:19:58,140 --> 00:20:02,500
بما أنّ لديّ عدد فردي من البِطاقات
في مجموعة أوراقي الآن، لستُ مُتناغماً

260
00:20:02,500 --> 00:20:06,920
بالتّالي، لا يتحفّز تأثير القائد الخاصّ
بالإله من الآلة

261
00:20:08,520 --> 00:20:10,730
أنت أكثر من مجرّد قويّ

262
00:20:10,730 --> 00:20:15,320
أنت جدير بأن تكون أحد الثّمانية
الّذين صمدوا في التّصنيف العالمي

263
00:20:15,320 --> 00:20:18,100
تربح دوماً. لا تنهزم

264
00:20:18,340 --> 00:20:20,930
!لكن هذا لا يهمّ

265
00:20:24,200 --> 00:20:26,160
سجلّ اللّعب

266
00:20:31,160 --> 00:20:33,490
...مستحيل... غير ممكن

267
00:20:34,420 --> 00:20:36,920
تاكوما كيباكورا

268
00:20:36,920 --> 00:20:39,330
لم يخسر ولا مُباراة؟

269
00:20:39,330 --> 00:20:41,230
لا، هذا غير صحيح

270
00:20:46,310 --> 00:20:49,080
خسرتُ مرّة فقط

271
00:20:49,500 --> 00:20:50,890
...وتلك الخسارة

272
00:21:13,170 --> 00:21:16,610
كانت تجربة لا أقدّرها بثمن

273
00:21:16,130 --> 00:21:19,550
نهائيّات البطولة الوطنيّة

274
00:21:20,570 --> 00:21:23,760
تقول بأنّك تُريد أن تُرضى، ومع ذلك لا شيء يُرضيك

275
00:21:24,130 --> 00:21:28,820
لكنّك مليء بالغطرسة والتّحامُل

276
00:21:28,820 --> 00:21:31,210
لا مجال لذرّة من أيّ شيء آخر

277
00:21:31,580 --> 00:21:35,060
ما دمتَ لا تعترف بالهزيمة، لن تتطوّر أبداً

278
00:21:35,450 --> 00:21:36,190
...لذا

279
00:21:40,350 --> 00:21:44,650
لذا يا ميكادو شيروغاني، سوف أهزمك

280
00:21:44,650 --> 00:21:47,190
!سأدمّر القلب الضّعيف الّذي بداخلك

281
00:21:49,040 --> 00:21:52,320
!وذلك كي تستمتع بشادوفارس أكثر

282
00:23:24,080 --> 00:23:25,740
!استعراض بطاقة شادوفارس

283
00:23:26,530 --> 00:23:29,320
بطاقة اليوم هي المعبد السّماوي

284
00:23:29,320 --> 00:23:31,470
—قلعة هائلة في أعالي السّماء. إنّها

285
00:23:31,470 --> 00:23:32,550
—إنّها مثاليّة لـ

286
00:23:32,550 --> 00:23:36,150
مثاليّ بالنسبة لشخص مغرور مثلي"، صحيح؟"

287
00:23:36,150 --> 00:23:37,470
أنا حقّاً لا أحبّك

288
00:23:37,470 --> 00:23:39,030
المشاعر مُتبادَلة

289
00:23:39,030 --> 00:23:42,110
!تتطلّب هزيمتي أكثر من ذلك

290
00:23:42,110 --> 00:23:45,680
ميكادو شيروغاني، أنت ترفض
الآخرين وتختم على قلبك

291
00:23:45,680 --> 00:23:49,240
لا تتكلّم وكأنّك تعرف أيّ شيء! لا أبالي
لكلمات غير الموهوبين

292
00:23:49,240 --> 00:23:51,880
"!الحلقة القادمة: "سأجعلها هزيمة ذات معنى

293
00:23:51,880 --> 00:23:53,720
!قِتال! شادوفارس