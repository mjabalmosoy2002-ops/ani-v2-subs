623
01:04:05,240 --> 01:04:05,840
.أوه

624
01:04:14,280 --> 01:04:18,420
.أنا أُقَدِّرُ ذلكَ حقًا، [فيندي]، لقدْ كُنْتي لطيفةً معي

625
01:04:18,850 --> 01:04:22,190
.لقدْ مضَتْ عشرُ سنينٍ مُنذُ بدأتُ بخدمتِكِ

626
01:04:22,190 --> 01:04:26,990
.أعِدُكِ أنَّني سأُعيدُ الطفلةَ للطبيبِ [بلاك جاك] بأمان

627
01:04:31,760 --> 01:04:34,870
.لقدْ أخبرَني أنْ أمحي جميعَ الدلائل

628
01:04:49,250 --> 01:04:50,980
.أرجو أنْ تتفهَّمي، [فيندي]

629
01:04:55,020 --> 01:04:58,020
.لا زالَ لديَّ أشياءٌ لأفعلها

630
01:05:08,000 --> 01:05:09,640
هل [فيندي] تعملُ اليوم؟

631
01:05:09,640 --> 01:05:10,700
.أجل، إنَّها كذلك

632
01:05:10,700 --> 01:05:12,140
هل تملكُ أّيَّ رسالةٍ لي؟

633
01:05:12,140 --> 01:05:15,640
.لا تأكُلي وتشربي كثيرًا، ولا تلفازَ لوقتٍ متأخر

634
01:05:16,440 --> 01:05:19,340
.دائمًا ما يُقالُ لي ذلك

635
01:05:19,340 --> 01:05:21,350
.عندما كُنتُ صغيرة لَمْ تكُنْ والدتي تسمحُ لي بمشاهدةِ التلفاز

636
01:05:21,350 --> 01:05:22,310
!كم هذا مُريع

637
01:05:28,250 --> 01:05:36,210
.نحنُ نأسفُ لذلك، الرقمُ الذي طلبْتَهُ خارج نطاقِ الخدمة

638
01:05:36,280 --> 01:05:38,900
.لقدْ تمَّ فصلُهُ بناءً على طلبِ المُستخدِم

639
01:05:38,900 --> 01:05:42,200
.أرجو أنْ تنتظِرْ وتُحاوِل مُجدّدًا

640
01:05:45,200 --> 01:05:49,880
.لقدْ كُنّا نُحاوِلُ جاهدين، لكن لا زِلْنا لَمْ نجِدْ مكانَهم إلى الآن

641
01:06:01,150 --> 01:06:04,290
.حاليًّا، درجةُ حرارتي 101.7 فهرنهايت

642
01:06:05,020 --> 01:06:06,590
.حسنًا إذًا نحنُ نتوجَّهُ إلى المطار

643
01:06:06,590 --> 01:06:07,230
.حسنًا

644
01:06:10,400 --> 01:06:14,500
.يبدو واضِحًا أنَّ هذا تأثيرُ إندروف آر

645
01:06:15,130 --> 01:06:21,870
وإنْ كان فعلًا تأثيره، إذًا [جو كارول] يجِبْ أنْ تتأثَّرَ بهِ
.أكثرَ منّي، بما أنَّها شرِبَتْ كميّةً كبيرة منه

646
01:06:30,520 --> 01:06:33,090
!أنا مُستعِدّة

647
01:06:33,090 --> 01:06:35,650
