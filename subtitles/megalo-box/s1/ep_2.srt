1
00:00:06,270 --> 00:00:08,670
!جولات من ثلاث دقائق، لا وقت محدّد للجولات

2
00:00:08,980 --> 00:00:13,960
كم حجم القضمة الّتي يمكن لكلب
!الخردة نشلها من البطل الّذي لا يُقهر؟

3
00:00:17,240 --> 00:00:19,240
!ضعوا رهاناتكم الآن

4
00:00:17,420 --> 00:00:19,240
!تقدّموا

5
00:00:21,650 --> 00:00:23,740
.لكن... أريد أن أصدّق

6
00:00:24,860 --> 00:00:27,130
.أن أصدّق أنَّ إيماني في نفسي حقيقيّ

7
00:00:29,090 --> 00:00:30,580
!هذه ليست كأيّ مباراة

8
00:00:32,390 --> 00:00:34,060
!اسمع، أوقف هذا رجاءً

9
00:00:34,060 --> 00:00:36,620
لا يمكن لهذه الاحتمالات السّيّئة
!أن تشكّل مقامرة جيّدة

10
00:00:36,620 --> 00:00:40,000
دع الأمر فحسب. قال الزّعيم
.أنّ اللّيلة مناسَبة خاصّة

11
00:00:40,430 --> 00:00:41,220
...وأيضًا

12
00:00:41,520 --> 00:00:44,510
هذا أكبر حدثٍ خاصّ شهدته
.هذه المباريات غير الشّرعيّة

13
00:00:44,510 --> 00:00:46,380
كيف لي أن أوقف ذلك؟

14
00:00:49,730 --> 00:00:54,130
اسمع! إن سنحت لك الفرصة، ادّعِ
!السّقوط فحسب! واحسب إلى عشرة

15
00:00:55,940 --> 00:00:57,390
.وإلاّ ستموت

16
00:00:59,890 --> 00:01:01,540
لمَ لا تخبرني باسمك؟

17
00:01:02,190 --> 00:01:04,790
لا أتصوّر أنّك تريد نقش اسم
.شهرتك على شاهدة قبرك

18
00:01:05,660 --> 00:01:07,730
.لا يضعون شاهدة قبور للكلاب الضّالّة

19
00:01:30,470 --> 00:01:31,770
...القوّة الدّافعة من الفرصة الأولى

20
00:01:32,930 --> 00:01:36,240
.يا لها من لكمة
...لو أنّها أصابت بنجاح

21
00:01:43,260 --> 00:01:44,620
ما رأيك أن أمنحك عائقًا؟

22
00:01:47,310 --> 00:01:49,660
.لن أستعمل يدي اليمنى

23
00:01:49,660 --> 00:01:51,440
.يسراي ستكون كافيةً لك

24
00:01:53,210 --> 00:01:54,390
ما الّذي يجري؟

25
00:01:54,690 --> 00:01:57,380
أيقصد أنّه يستطيع هزيمة
كلب الخردة بيدٍ واحدة؟

26
00:02:00,710 --> 00:02:02,320
.هذا ما هو متوقّع من البطل

27
00:02:02,320 --> 00:02:03,580
.كريمٌ جدًّا

28
00:02:04,770 --> 00:02:07,890
!فلنأمل أنّك لن تندم على هذا

29
00:02:13,980 --> 00:02:16,940
!إنّه يغيّر زاوية لكماته المباشرة لصدّ لكماتي

30
00:02:18,060 --> 00:02:20,650
!ما رأيك بهذا إذًا؟

31
00:02:25,640 --> 00:02:26,440
!نلت منك

32
00:02:36,620 --> 00:02:38,970
!لقد سقط كلب الخردة! لقد سقط

33
00:02:39,220 --> 00:02:40,020
...واحد

34
00:02:40,560 --> 00:02:43,470
.تبًّا... لم يكن يتحايل بشأن العائق

35
00:02:41,730 --> 00:02:42,530
...اثنان

36
00:02:44,180 --> 00:02:44,980
...ثلاثة

37
00:02:44,180 --> 00:02:47,110
.لقد احتاج يده اليسرى فحسب حقًّا

38
00:02:46,670 --> 00:02:47,470
...أربعة

39
00:02:48,310 --> 00:02:50,850
!يا شريك، ابقَ ساقطًا! أوقف هذا

40
00:02:49,160 --> 00:02:49,960
...خمسة

41
00:02:51,110 --> 00:02:54,060
!سينتهي بك الأمر ميتًا حقًّا على هذا المعدّل

42
00:02:51,670 --> 00:02:52,620
...ستة

43
00:02:54,270 --> 00:02:55,140
...سبعة

44
00:02:55,960 --> 00:02:57,790
،الموت لا يزعجني

45
00:02:58,310 --> 00:03:00,260
...ليس وأنا أحظى

46
00:03:04,050 --> 00:03:05,970
.بهذه المتعة

47
00:04:55,700 --> 00:04:59,860
!نظرتك المتعجرفة هذه تغضبني

48
00:05:14,220 --> 00:05:18,750
،إن كنتَ تستخدم يسراك فحسب
.لهُزمتَ في طرفة عين الآن

49
00:05:25,580 --> 00:05:27,980
.يمكنك أن تكفّ عن التّباهي

50
00:05:27,980 --> 00:05:30,390
.فلنقاتل بنزاهة الآن

51
00:05:31,100 --> 00:05:32,290
.أجل

52
00:05:32,290 --> 00:05:34,240
...سأحقّق أمنيتك

53
00:05:35,410 --> 00:05:37,560
.وسأريك ملاكمة ميغالو الحقيقيّة

54
00:05:41,310 --> 00:05:42,860
.هذا أفضل

55
00:05:53,690 --> 00:05:55,380
!لا تتبجّح يا فتى

56
00:05:55,830 --> 00:05:57,900
!ابتعد عنه! استفد من حركة قدميك

57
00:06:14,310 --> 00:06:15,430
.أرى ما تنوي إليه

58
00:06:44,650 --> 00:06:45,360
...واحد

59
00:06:48,170 --> 00:06:48,970
...اثنان

60
00:06:51,390 --> 00:06:52,290
...ثلاثة

61
00:06:54,510 --> 00:06:56,470
—أيّها البطل، القتال لم

62
00:06:55,180 --> 00:06:55,980
...أربعة

63
00:06:56,470 --> 00:06:57,440
.لقد انتهى

64
00:06:58,820 --> 00:06:59,620
...خمسة

65
00:06:59,620 --> 00:07:01,600
.لن يستطيع الوقوف

66
00:07:02,770 --> 00:07:03,570
...ستة

67
00:07:05,110 --> 00:07:06,090
!يكفي

68
00:07:06,090 --> 00:07:08,490
!ابقَ ساقطًا! لا تقف

69
00:07:06,330 --> 00:07:07,130
...سبعة

70
00:07:08,490 --> 00:07:11,160
.توقّف أيّها العمّ

71
00:07:09,210 --> 00:07:11,670
!أصغِ إليّ! ابقَ ساقطًا

72
00:07:12,070 --> 00:07:13,350
!استلقِ هناك فحسب

73
00:07:12,380 --> 00:07:14,620
.هذا ليس ما أريد سماعه

74
00:07:14,500 --> 00:07:15,300
...تسعة

75
00:07:15,300 --> 00:07:16,780
!أيمكنك سماعي؟

76
00:07:16,780 --> 00:07:18,840
!فعلت ما يكفي! لا تقف

77
00:07:18,840 --> 00:07:19,640
.عشرة

78
00:07:19,870 --> 00:07:22,120
!انتصار بالضّربة القاضية من الجولة الأولى

79
00:07:22,120 --> 00:07:24,460
!الفائز هو يوري

80
00:07:25,530 --> 00:07:27,840
.أعتذر على مقاطعة عمليّتكم

81
00:07:27,840 --> 00:07:30,490
لقد تسنّى للجميع رؤية الملاكم
!الأهمّ شخصيًّا، وبدون تكلفة إضافيّة

82
00:07:30,490 --> 00:07:32,470
.إنها صفقة

83
00:07:32,470 --> 00:07:34,570
!يوري! يوري

84
00:07:34,570 --> 00:07:38,850
!يوري! يوري! يوري! يوري

85
00:07:38,850 --> 00:07:43,170
!يوري! يوري! يوري

86
00:07:43,170 --> 00:07:48,330
أهذا ما تدعوه بملاكمة ميغالو الحقيقيّة؟

87
00:07:55,990 --> 00:07:58,240
.لستُ منبهرًا

88
00:07:58,730 --> 00:08:01,500
.ما كانت حتّى لتفي بقتل كلبٍ ضالّ

89
00:08:03,580 --> 00:08:05,150
.فلنتابع

90
00:08:05,680 --> 00:08:08,220
.لم أنتهِ بعد

91
00:08:11,870 --> 00:08:15,010
!ذلك مستحيل تمامًا! لقد خسرت

92
00:08:16,250 --> 00:08:18,010
!لا تشغل بالك به رجاءً

93
00:08:18,010 --> 00:08:21,420
!الفتى لا يعي ما يقول

94
00:08:21,420 --> 00:08:22,740
—أمره ميؤوس منه حقًّا

95
00:08:22,740 --> 00:08:23,560
.لقد انتهيتُ منك

96
00:08:25,330 --> 00:08:28,510
.لن أواصل التّشاجر مع كلبٍ ضالّ

97
00:08:29,290 --> 00:08:31,280
.هذه ليست حلبتي

98
00:08:32,670 --> 00:08:34,320
أذلك يضايقك الآن بالتّحديد؟

99
00:08:38,650 --> 00:08:40,940
...إن كنتَ جادًّا في قتالي مجدّدًا

100
00:08:41,810 --> 00:08:42,980
.فشقّ طريقك إليّ

101
00:08:44,650 --> 00:08:46,120
.وفي حلبتي

102
00:08:50,580 --> 00:08:52,220
!ا-انتظر

103
00:08:52,780 --> 00:08:54,950
!أنت! عد إلى هنا

104
00:08:55,550 --> 00:08:56,510
!توقّف

105
00:09:44,450 --> 00:09:46,430
...لا يمكنني الرّجوع للوضع السّابق

106
00:09:57,170 --> 00:10:00,160
!ليس بعد ما حدث للتّوّ

107
00:10:15,350 --> 00:10:16,790
أتريد الخروج؟

108
00:10:31,560 --> 00:10:32,360
...المالكة

109
00:10:36,940 --> 00:10:39,350
ذهبت لمقابلة صاحب الدّراجة
النّارية ذاك، أليس كذلك؟

110
00:10:40,230 --> 00:10:41,360
.نعم

111
00:10:41,360 --> 00:10:43,110
.يجب أن تتذكّر مكانتك

112
00:10:43,110 --> 00:10:48,040
.لا يجب أن تدخل الحلبة دون إذني

113
00:10:48,400 --> 00:10:52,290
.القتال في المباريات غير الشّرعيّة ممنوع تمامًا

114
00:10:52,980 --> 00:10:54,560
.فهمت

115
00:10:54,560 --> 00:10:57,880
.لن أقابله مجدّدًا

116
00:11:04,010 --> 00:11:05,600
...جسدك

117
00:11:05,600 --> 00:11:07,900
.إنّه مستقبل هذه الشّركة

118
00:11:10,190 --> 00:11:10,990
.أعلم

119
00:12:34,030 --> 00:12:37,450
.حسنًا، تعامل مع الأمر كالمعتاد

120
00:12:38,240 --> 00:12:40,350
!دع الأمر لنا

121
00:12:40,350 --> 00:12:42,740
هل شرحتَ له التّرتيب؟

122
00:12:42,740 --> 00:12:44,470
.نعم، كليًّا

123
00:12:45,820 --> 00:12:47,650
!مرحبًا يا شريك

124
00:12:47,650 --> 00:12:49,600
.كلّ شيء جاهز

125
00:12:50,230 --> 00:12:51,580
...منتصف الجولة الخامسة

126
00:12:51,960 --> 00:12:55,070
.ستتلقّى لكمة موفّقة من منافسك وتسقط

127
00:12:57,030 --> 00:12:59,040
.أيّها العمّ. أريد أن أطلب منك معروفًا

128
00:13:01,090 --> 00:13:03,190
.أكيد. أيًّا كان ما تريد

129
00:13:03,760 --> 00:13:06,530
...شجارك مع يوري

130
00:13:06,530 --> 00:13:09,260
،قد ضاعف الجماهير على ما يبدو
.إلى جانب حصّتنا

131
00:13:09,260 --> 00:13:13,110
—لن أكون مديونًا لوقتٍ أطول

132
00:13:14,500 --> 00:13:15,350
ما هذا؟

133
00:13:16,370 --> 00:13:18,520
.أريد أن أقاتل يوري مجدّدًا

134
00:13:19,380 --> 00:13:21,160
.أشركني في ميغالونيا

135
00:13:24,520 --> 00:13:25,440
هل أنت جادّ؟

136
00:13:26,010 --> 00:13:26,810
.نعم

137
00:13:27,270 --> 00:13:30,440
.أدخلني إلى حلبته رجاءً

138
00:13:32,930 --> 00:13:34,040
!كيف تجرؤ؟

139
00:13:35,010 --> 00:13:36,480
ألا تستوعب؟

140
00:13:36,480 --> 00:13:39,190
.أمكنه أن يقتلك حينها

141
00:13:39,570 --> 00:13:42,710
والآن تريد التّفوّه بكلام كبير
و"الدّخول إلى حلبته"؟

142
00:13:43,050 --> 00:13:46,170
أتحسب أنّ المحتال يستطيع
أن يكون استثناءً؟

143
00:13:46,660 --> 00:13:49,130
.لستَ من سيقاتل

144
00:13:49,130 --> 00:13:49,940
.بل أنا

145
00:13:51,010 --> 00:13:51,970
...بحقّك

146
00:13:52,820 --> 00:13:55,180
.عد إلى رشدك يا شريك

147
00:13:56,130 --> 00:14:00,340
كما أنّك تحتاج إلى هويّة مواطن
.للمشاركة في مباراة شرعيّة

148
00:14:00,880 --> 00:14:04,090
هل تملك واحدة؟ لا، أليس كذلك؟

149
00:14:04,690 --> 00:14:06,820
...وحتّى إن كنت تملكها

150
00:14:07,520 --> 00:14:10,930
فقط الملاكمون الأربعة الأوائل في
.التّصنيف يدخلون المربّع النّهائيّ

151
00:14:10,930 --> 00:14:12,490
،يمكنك أن تجاهد نفسك

152
00:14:12,840 --> 00:14:17,100
لكن محال أن تصل إلى ذلك
.الحدّ في ثلاثة أشهر

153
00:14:18,220 --> 00:14:22,480
.اسمع، أمثالنا لا يفكّرون في الغد

154
00:14:23,190 --> 00:14:24,880
،ركّز كثيرًا في تلك الأمور

155
00:14:26,180 --> 00:14:27,340
.وسينتهي بك المطاف ميتًا

156
00:14:32,450 --> 00:14:34,820
...توقّف عن هذه الأحلام

157
00:14:35,230 --> 00:14:38,980
وركّز على تأدية عملك جيّدًا. اتفقنا؟

158
00:14:38,980 --> 00:14:39,770
.هيّا

159
00:14:41,580 --> 00:14:44,940
.حسنًا، سأذهب لتفقّد الجمهور

160
00:14:44,940 --> 00:14:47,200
.اشرع في الاستعداد

161
00:14:58,840 --> 00:15:00,790
!والآن، مباراتنا الافتتاحيّة لليوم

162
00:15:00,790 --> 00:15:01,830
!نعتمد عليكم

163
00:15:02,340 --> 00:15:05,020
.تبًّا، يا لها من مجموعة بسيطة

164
00:15:06,140 --> 00:15:09,510
.حسنًا يا شريك، تساهل معه

165
00:15:10,040 --> 00:15:13,760
.لن يصمد حتّى الجولة الخامسة إن قسوت عليه

166
00:15:14,340 --> 00:15:16,600
أنت. هل تصغي إليّ يا شريك؟

167
00:15:19,240 --> 00:15:20,310
...ذاك الفتى

168
00:15:25,710 --> 00:15:27,070
مـ-ماذا؟

169
00:15:31,950 --> 00:15:33,520
.ا-ابدأ العدّ

170
00:15:33,860 --> 00:15:34,660
...واحد

171
00:15:36,350 --> 00:15:37,150
...اثنان

172
00:15:38,780 --> 00:15:39,580
...ثلاثة

173
00:15:39,430 --> 00:15:41,230
!ذاك الشّقيّ

174
00:15:41,340 --> 00:15:42,140
...أربعة

175
00:15:42,110 --> 00:15:44,380
—انصرف! أنا وسط

176
00:15:43,580 --> 00:15:44,380
...خمسة

177
00:15:46,370 --> 00:15:47,320
...ستة

178
00:16:19,150 --> 00:16:21,610
!أنا آسف جدًّا يا فوجيماكي-سان

179
00:16:22,340 --> 00:16:26,870
،أنا وذلك الطّفل ساعدنا بعضنا
...وكنّا منسجمين حتّى الآن

180
00:16:26,870 --> 00:16:30,260
!لم أتوقّع أبدًا أن يخونني بهذا الشّكل

181
00:16:30,260 --> 00:16:34,770
!أنا مذنبٌ ومحبط جدًّا

182
00:16:37,450 --> 00:16:40,430
أتعرف ما معنى "فوند دو جيبي"؟

183
00:16:41,630 --> 00:16:42,430
عفوًا؟

184
00:16:42,910 --> 00:16:47,750
.تصطاد الطّرائد البرّيّة وتصنع منها شوربة المرقة

185
00:16:49,150 --> 00:16:51,850
...إن أخذت وقتك في غليها

186
00:16:51,850 --> 00:16:56,390
بوسعك أن تحصل على 500 غرام
.من الشّوربة من 500 غرام من العظام

187
00:16:58,140 --> 00:16:59,950
ذلك ينفع بشكلٍ رائع، أليس كذلك؟

188
00:17:03,990 --> 00:17:06,880
نانبو-سان... ما وزنك؟

189
00:17:08,590 --> 00:17:10,050
.أسألك عن وزنك

190
00:17:11,110 --> 00:17:12,260
كم؟

191
00:17:18,550 --> 00:17:19,890
.جرّب هذه

192
00:17:42,520 --> 00:17:46,400
!أتوسّل إليك يا فوجيماكي-سان
!سأجد طريقةً لأردّ لك المال

193
00:17:46,400 --> 00:17:49,710
!لذا امنحني المزيد من الوقت رجاءً

194
00:17:50,610 --> 00:17:52,680
وهذه إجابتك؟

195
00:17:53,500 --> 00:17:54,810
!رجاءً

196
00:18:01,430 --> 00:18:02,720
.حسنًا

197
00:18:05,430 --> 00:18:09,230
.لكن علينا أن نسوّي هذه الحادثة البسيطة

198
00:18:09,980 --> 00:18:14,270
.أظنّ أنّ مقلة عينك الأخيرة ستعوّض عنها

199
00:18:18,200 --> 00:18:20,060
مـ-ماذا عن الفتى؟

200
00:18:20,760 --> 00:18:22,530
ماذا سيحدث لشريكي؟

201
00:18:23,930 --> 00:18:26,040
إذًا، هذه حيلتك؟

202
00:18:26,840 --> 00:18:29,460
...تستخدم قطعتك الوحيدة كبيدقٍ قربانيّ

203
00:18:29,460 --> 00:18:32,390
لقد انحدرت كثيرًا، أليس كذلك يا نانبو-سان؟

204
00:18:37,810 --> 00:18:39,610
.لا تقلق بشأنه

205
00:18:39,610 --> 00:18:43,030
.سوف نستفيد من شريكك ما بقي من حياته

206
00:18:43,460 --> 00:18:45,010
.في حلبتي

207
00:18:46,780 --> 00:18:50,090
.أدخلني إلى حلبته. رجاءً

208
00:18:51,300 --> 00:18:53,600
...إن كنتَ جادًّا في قتالي مجدّدًا

209
00:18:54,500 --> 00:18:55,650
.شقّ طريقك إليّ

210
00:18:56,580 --> 00:18:58,110
.في حلبتي

211
00:18:59,480 --> 00:19:01,280
...حلبته

212
00:19:04,860 --> 00:19:05,950
.صحيح

213
00:19:06,690 --> 00:19:09,440
!لن يقاتل شريكي في حلبتك

214
00:19:11,500 --> 00:19:15,940
يمكنني أن أسدّد لك بالتّمام فور
!أن يفوز بهذه البطولة

215
00:19:26,790 --> 00:19:29,980
إذًا، هل تكفّلت بالأمر أيّها العمّ؟

216
00:19:32,670 --> 00:19:34,980
هل تصغي إليّ؟

217
00:19:36,450 --> 00:19:38,010
!اخرس للحظة

218
00:19:38,010 --> 00:19:41,110
.أنا أحاول التّفكير. لا تعقني

219
00:19:44,620 --> 00:19:46,050
ماذا حدث؟

220
00:19:46,950 --> 00:19:49,080
هل سنفلت ممّا حدث؟

221
00:19:52,320 --> 00:19:53,580
.ميغالونيا

222
00:19:56,790 --> 00:19:58,420
.أجل، صحيح

223
00:19:58,800 --> 00:20:01,090
!ستحصل على مبتغاك أيّها الوغد الصّغير

224
00:20:01,090 --> 00:20:04,440
!سنشارك في ميغالونيا الآن

225
00:20:04,440 --> 00:20:06,040
!مهما كان

226
00:20:07,120 --> 00:20:10,340
هل سأستطيع قتاله؟ يوري؟

227
00:20:10,700 --> 00:20:12,660
!لا تستوعب، أليس كذلك؟

228
00:20:12,660 --> 00:20:15,190
!أمامنا ثلاثة أشهر فحسب

229
00:20:16,460 --> 00:20:18,190
...في ظرف ثلاثة أشهر

230
00:20:18,610 --> 00:20:22,180
.علينا أن ننجح في المشاركة في البطولة ونفوز بها

231
00:20:28,810 --> 00:20:30,080
عليّ أن أفوز فحسب، صحيح؟

232
00:20:32,780 --> 00:20:34,450
.لن أخسر مجدّدًا

233
00:20:35,250 --> 00:20:37,290
.ليس قبل أن أحكم قبضتيّ على يوري مجدّدًا

234
00:20:58,210 --> 00:20:59,480
...يا للمسكين

235
00:21:00,970 --> 00:21:05,290
،لم يُسدّد بعض الدّيون
...فقُطِّعَ وبيعت أعضاؤه

236
00:21:05,290 --> 00:21:08,620
.والآن، سيُعاد صياغة هويّته بالكامل

237
00:21:08,620 --> 00:21:11,220
.هذا أقصى ما سأساعدكما به

238
00:21:11,750 --> 00:21:14,070
.الباقي يعتمد عليكما

239
00:21:14,070 --> 00:21:15,910
أليس كذلك يا نانبو-سان؟

240
00:21:18,950 --> 00:21:20,570
هل أنت جادّ؟

241
00:21:21,880 --> 00:21:24,300
ماذا يستطيع محتالان فعله؟

242
00:21:25,020 --> 00:21:28,670
.أملك خطّة. سنفوز

243
00:21:32,020 --> 00:21:36,230
لقد كنتُ أخاطر بحياتي
!على الخدع لوقتٍ طويل

244
00:21:36,720 --> 00:21:41,310
!وسأريك ما نستطيع نحن المحتالون فعله حقًّا

245
00:21:44,850 --> 00:21:48,290
،بقي اختيار اسم جديد فحسب

246
00:21:48,290 --> 00:21:50,730
.وسيكون لدينا مواطنٌ مبتكرٌ جديد

247
00:21:56,500 --> 00:21:58,930
.إنّه اسمك. اختره أنت

248
00:22:00,510 --> 00:22:01,360
أنا؟

249
00:22:08,610 --> 00:22:09,440
.جو

250
00:22:11,360 --> 00:22:12,160
...جو

251
00:22:13,440 --> 00:22:14,440
جو إذًا؟

252
00:22:15,230 --> 00:22:16,060
...جو

253
00:22:17,880 --> 00:22:19,020
.لديه وقعٌ جميل

254
00:22:20,190 --> 00:22:23,270
.أظنّ أنّ هذا اسم شهرتك الجديد

255
00:22:24,230 --> 00:22:25,360
.قضي الأمر إذًا