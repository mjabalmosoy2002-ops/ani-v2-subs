1
00:00:06,370 --> 00:00:10,670
.بقي أن يُنصّر يوري هذا الاتّفاق بفوز

2
00:00:11,400 --> 00:00:12,200
.أجل

3
00:00:12,700 --> 00:00:15,340
.أعدكم بنصرٍ ساحق

4
00:00:22,790 --> 00:00:24,980
.تهانينا أيّتها المالكة

5
00:00:27,470 --> 00:00:29,840
.لقد وصلنا إلى هذا النّقطة أخيرًا

6
00:00:30,330 --> 00:00:32,500
.كلّ ذلك بفضلك يا يوري

7
00:00:35,980 --> 00:00:38,720
.لكنّ القتال الحقيقيّ سيبدأ الآن

8
00:00:39,500 --> 00:00:44,730
،فور أن يؤمن النّاس بنيّة في الإمكانيّة اللاّنهائيّة للتّرس

9
00:00:44,730 --> 00:00:49,070
.ستصبح شيراتو منارةً للأمل في المستقبل

10
00:00:49,730 --> 00:00:53,160
.وستكون أنت من يثبتُ ذلك لهم يا يوري

11
00:00:53,740 --> 00:00:56,040
.تعال، فلنشرب نخبًا

12
00:00:56,630 --> 00:00:59,620
.نخب بداية حلمنا الجديد

13
00:01:04,570 --> 00:01:08,960
.سأنزع التّرس لكي أقاتل من دونه في النّهائيّ

14
00:01:10,980 --> 00:01:11,980
،أريد أن أقاتله

15
00:01:12,820 --> 00:01:15,510
.أن أقاتل جو على قدم المساواة

16
00:02:57,830 --> 00:03:00,120
تنزع... ترسك؟

17
00:03:01,950 --> 00:03:05,820
هل تُدرك مدى خطورة ذلك؟

18
00:03:05,820 --> 00:03:06,770
.نعم

19
00:03:06,770 --> 00:03:10,660
،هذا ما أريده شخصيًّا
.وليس كملاكمٍ ممثّل لشيراتو

20
00:03:10,660 --> 00:03:14,160
.لا أستطيع الاستمرار في الكذب على نفسي

21
00:03:15,610 --> 00:03:19,220
.لن أسمح بهذا مطلقًا

22
00:03:20,270 --> 00:03:22,360
،إن لم تُذعن للصّواب

23
00:03:22,980 --> 00:03:24,600
!فيمكنني أن أُلغي النّهائيّ

24
00:03:24,600 --> 00:03:25,550
!لا

25
00:03:27,950 --> 00:03:32,800
.جو... لقد خاطر بحياته ليشقّ طريقه إليّ

26
00:03:34,350 --> 00:03:38,220
.لا بدّ أن يتمّ الأمر على الحلبة في ميغالونيا

27
00:03:41,540 --> 00:03:44,670
.لن أعود إلى هذا المكتب

28
00:03:45,290 --> 00:03:47,200
.أردتُ أن أُعلِمك فحسب

29
00:03:50,330 --> 00:03:52,610
ماذا عن حلمنا؟

30
00:03:53,270 --> 00:03:56,100
.من الآن فصاعدًا، بات حلمك وحدك

31
00:04:08,870 --> 00:04:11,010
.على مهلك قليلاً يا جو

32
00:04:11,010 --> 00:04:13,010
.كنت تتدرّب دون توقّف طيلة الصّباح

33
00:04:18,180 --> 00:04:19,240
.ليس بعد

34
00:04:20,070 --> 00:04:21,520
.ما زلت أحتاج القيام بالمزيد

35
00:04:22,730 --> 00:04:25,530
هل ما حدث للعمّ يُربكك؟

36
00:04:28,710 --> 00:04:30,020
.ليس كذلك

37
00:04:30,400 --> 00:04:32,830
.أستطيع قتال يوري أخيرًا

38
00:04:33,480 --> 00:04:35,760
أتتوقّع منّي ألاّ أتحمّس حقًّا؟

39
00:04:36,630 --> 00:04:38,540
.سعيد لأنّك لم تتغيّر يا جو

40
00:04:39,920 --> 00:04:42,460
أنتما... لماذا...؟

41
00:04:43,470 --> 00:04:45,070
.لقد استدعيتهما

42
00:04:46,180 --> 00:04:50,730
،بمعرفتي لك يا جو، إن لم يوقفك أحد

43
00:04:50,730 --> 00:04:53,100
.فلن تتوقّف عن لكم الكيس حتّى تثقبه

44
00:04:54,940 --> 00:04:59,700
لذا سألت مياغي-سان ما إن كنّا
.نستطيع استعارة أراغاكي

45
00:04:59,700 --> 00:05:02,450
.سيكون شريكك في التّدريب

46
00:05:04,490 --> 00:05:06,180
أم تظنّ أنّني غير مؤهّل لذلك؟

47
00:05:06,180 --> 00:05:09,320
.لا بدّ أنّك ستقاتل أفضل من كيس رمل

48
00:05:09,320 --> 00:05:11,040
!فلنبدأ

49
00:05:12,620 --> 00:05:14,310
!هيّا يا جو

50
00:05:15,580 --> 00:05:17,420
هل ستكون ساقاك بخير؟

51
00:05:17,420 --> 00:05:19,380
.نعم. لا تقلق بشأن ذلك

52
00:05:20,730 --> 00:05:21,950
.سعيدٌ لمعرفة ذلك

53
00:05:23,050 --> 00:05:27,180
لعلمك، لطالما ندمتُ على إخفاقي
.في إسقاطك بضربة قاضية

54
00:05:27,180 --> 00:05:28,210
.وأنا أيضًا

55
00:05:29,530 --> 00:05:32,280
!أنت، ابق هادئًا

56
00:05:32,280 --> 00:05:34,730
!لا تنس، هذا مجرّد تدريب

57
00:05:34,730 --> 00:05:36,350
...يا لجو ذاك

58
00:05:36,350 --> 00:05:39,480
يفرح كثيرًا لتحدّي أحد حتّى
.يفقد السّيطرة على نفسه

59
00:05:40,900 --> 00:05:42,180
.أراغاكي كذلك أيضًا

60
00:05:42,750 --> 00:05:45,350
،لم يندم على الاعتزال

61
00:05:45,350 --> 00:05:49,490
،لكن عندما اتّصلت بنا
.لم يستطع إخفاء سعادته

62
00:05:49,960 --> 00:05:52,130
.شكرًا يا مياغي-سان

63
00:05:52,660 --> 00:05:54,480
.أنا من يجبّ أن أشكرك

64
00:05:55,010 --> 00:05:57,500
.تسنّت لنا مساعدتك على قتال البطل

65
00:05:57,500 --> 00:05:59,270
هل تصدّق ذلك؟

66
00:06:00,200 --> 00:06:02,110
،فقط قبل ثلاثة أشهر

67
00:06:02,110 --> 00:06:06,180
أنا وذلك الفتى كنّا ندّعي
.الخسارات في الحلبة السّرّيّة

68
00:06:07,010 --> 00:06:12,110
والآن... سوف يقاتل البطل
.اللّعين في نهائيّ ميغالونيا

69
00:06:12,740 --> 00:06:16,480
هذا يبرهن أنّنا لا نستطيع
.معرفة ما يخفيه الغد أبدًا

70
00:06:17,030 --> 00:06:19,680
.جميعكم دفعتم الكثير لتصلوا إلى هذا المدى

71
00:06:20,030 --> 00:06:21,560
...جو، أراغاكي

72
00:06:22,040 --> 00:06:23,450
.وأنت، بالنّظر إلى الأمور

73
00:06:25,150 --> 00:06:27,040
.فقداني لعيني كان سرقةً، باعتبار ما حدث

74
00:06:27,890 --> 00:06:30,440
.لكنّني استطعتُ لقاء الملاكم الحقيقيّ

75
00:06:31,160 --> 00:06:33,450
لا يمكنني أن أدع هذا ينتهي
.حتّى نصل أبعد ما يمكننا

76
00:06:33,820 --> 00:06:35,000
.الأمر بتلك البساطة

77
00:06:47,100 --> 00:06:48,260
.كان ذلك سريعًا

78
00:07:02,110 --> 00:07:05,380
،عندما وجدت هذا المكان
.كان في حالة خراب

79
00:07:06,150 --> 00:07:08,740
.لكنّه يبدو مناسبًا للسّكن أخيرًا

80
00:07:09,390 --> 00:07:12,450
.إنّه متواضع، لكنّه كلّ ما أحتاج الآن على الأغلب

81
00:07:13,050 --> 00:07:15,030
.لقد تغيّرت يا ميكيو

82
00:07:16,560 --> 00:07:18,290
.رجعتُ إلى دياري الأصليّة فحسب

83
00:07:20,010 --> 00:07:21,410
...بالنّسبة لما طلبت

84
00:07:25,040 --> 00:07:26,110
.إنّه في الأسفل

85
00:07:32,720 --> 00:07:34,680
.هذا الحدّ الأدنى لما نحتاج

86
00:07:36,890 --> 00:07:38,270
.فلنبدأ على الفور

87
00:07:38,270 --> 00:07:40,560
هل أنت واثق من هذا حقًّا؟

88
00:07:41,910 --> 00:07:45,530
.التّرس المتكامل جزء من جسدك الآن

89
00:07:46,650 --> 00:07:48,690
.لا ضمان أنّه يمكن أن يُنزع بأمان

90
00:07:49,520 --> 00:07:51,750
هل أنت قلق من أنّك قد تفشل؟

91
00:07:52,380 --> 00:07:55,530
.على الإطلاق. لقد خسرت أمام جو

92
00:07:56,820 --> 00:07:59,580
.قاتلتُ باستخدام التّرس ومع ذلك خسرت

93
00:08:00,000 --> 00:08:01,790
.لكنّك لم تفعل

94
00:08:03,330 --> 00:08:05,860
هل عليك أن تخوض هذا حقًّا؟

95
00:08:08,530 --> 00:08:13,120
راهنتَ بكلّ شيء لأجل تطوير إيس
.حتّى تستطيع قتالي

96
00:08:14,640 --> 00:08:18,080
.سأنزع هذا لكي أستطيع قتال جو

97
00:08:18,660 --> 00:08:19,850
.الأمر سيّان

98
00:08:51,380 --> 00:08:53,550
ما رأيك أن تعلّمني إذًا؟

99
00:08:53,550 --> 00:08:55,400
.ليس مجرّد شخصين يتشاجران

100
00:08:55,400 --> 00:08:58,070
.أرني ما هي ملاكمة ميغالو الحقيقيّة

101
00:08:59,550 --> 00:09:01,640
.وكأنّ كلبًا ضالاًّ سيفهم

102
00:09:02,220 --> 00:09:03,140
!يوري

103
00:09:03,460 --> 00:09:04,260
—يوري

104
00:09:14,580 --> 00:09:16,240
.سارت العمليّة على خير

105
00:09:16,730 --> 00:09:18,400
.حياته ليست في خطر

106
00:09:19,500 --> 00:09:22,240
...أعلم أنّه قال إنّه أنهى علاقته مع شيراتو

107
00:09:22,240 --> 00:09:24,400
.لكن مع ذلك فكّرت أنّك يجب أن تعرفي

108
00:09:26,740 --> 00:09:29,210
.تبدين وكأنّك تودّين أن تسأليني لِمَ لم أوقفه

109
00:09:31,670 --> 00:09:37,040
،أردت من ميغالونيا أن تظهر أداء التّرس المتكامل

110
00:09:37,040 --> 00:09:39,610
،وتحصلي على العقد الّذي أردتِ
.وفق الشّروط الّتي أردتِ

111
00:09:40,220 --> 00:09:41,240
أليس كذلك؟

112
00:09:43,250 --> 00:09:45,090
.أدّى يوري واجبه

113
00:09:45,490 --> 00:09:47,600
فلمَ لا تتركيه يفعل ما يريد الآن؟

114
00:09:49,710 --> 00:09:51,640
.إنّه ينكرني

115
00:09:52,470 --> 00:09:55,530
.لقد أدار ظهره عن التّرس... عن المستقبل

116
00:09:55,930 --> 00:09:57,740
.كلّ ذلك بسبب حسد سخيف

117
00:09:59,260 --> 00:10:01,060
.سوف ألغي النّهائيّ

118
00:10:01,740 --> 00:10:04,420
...المباراة الّتي تُحدّد ملاكم ميغالو الأعظم

119
00:10:04,420 --> 00:10:07,820
بين ملاكمين دون ترس؟
.هذا هراء تمامًا

120
00:10:08,960 --> 00:10:13,060
،فور أن يزول مفعول التّخدير
...سيعاني الأمرّين

121
00:10:14,270 --> 00:10:16,970
.إنّه قرارك يا يوكيكو

122
00:10:18,730 --> 00:10:21,470
لكن ألا يوجد في الأمر المزيد؟

123
00:10:22,830 --> 00:10:25,310
ألم تري أيّ قيمة أخرى في ملاكمة ميغالو؟

124
00:10:32,650 --> 00:10:35,690
."اسم شهرته في ذلك الحين كان "كلب الخردة

125
00:10:36,020 --> 00:10:40,170
،قبل الأشهر الثّلاثة الماضية
قاتل في ملعب غير قانونيّ

126
00:10:40,170 --> 00:10:42,410
،موجود في مناطق غير مصرّح بها
.لأجل القمار

127
00:10:43,010 --> 00:10:47,040
،وكان يدّعي الخسارة على الأرجح
.بينما يشاركه نانبو غانساكو

128
00:10:48,830 --> 00:10:52,860
لقد جلب أشياءً من ماضينا
.لا نستطيع السّماح بالكشف عنها

129
00:10:54,340 --> 00:10:57,050
.الهويّة مزوّرة

130
00:10:57,310 --> 00:10:59,370
.اسم "جو" اسمٌ مستعار

131
00:10:59,370 --> 00:11:02,450
.ولا نعلم أيّ شيء عن هويّته الحقيقيّة

132
00:11:05,090 --> 00:11:08,250
الشّيء الواضح الوحيد بشأنه
،هو أنّه لا يملك هويّة شرعيّة

133
00:11:08,250 --> 00:11:09,520
.ما يجعله مواطنًا غير شرعيّ

134
00:11:09,800 --> 00:11:14,810
إنّه ملاكم زائف ولا يملك حقّ
.المشاركة في المباريات المُصدّقة

135
00:11:16,120 --> 00:11:17,030
...مع ذلك

136
00:11:17,300 --> 00:11:19,190
.لقد هزم أخي

137
00:11:19,190 --> 00:11:20,400
...وباروز

138
00:11:20,910 --> 00:11:21,910
.وأراغاكي أيضًا

139
00:11:22,420 --> 00:11:25,450
.جو "بلا ترس"... إنّه ملاكم حقيقيّ

140
00:11:26,410 --> 00:11:30,830
.هذه النّتائج مبرّر كافٍ لإلغاء النّهائيّ

141
00:11:31,790 --> 00:11:34,440
.ولن يكون هنالك أيّ تأثير سلبيّ على العقد

142
00:11:35,500 --> 00:11:36,570
.لا أعرف ما يجب فعله

143
00:11:38,250 --> 00:11:40,660
...لِمَ قد يذهبان إلى هذا الحدّ

144
00:11:41,450 --> 00:11:43,210
فقط ليقاتلا بعضهما؟

145
00:11:43,970 --> 00:11:44,950
أيّتها الرّئيسة؟

146
00:11:45,650 --> 00:11:47,050
.أحتاج إلى الوقت للتّفكير في هذا

147
00:11:47,630 --> 00:11:50,120
.أبقي كلّ هذا سرًّا، في الوقت الرّاهن

148
00:11:50,700 --> 00:11:51,680
...لكن

149
00:12:34,370 --> 00:12:36,080
!لقد كان قتالاً مدهشًا

150
00:12:36,080 --> 00:12:38,110
.غير مصقول قليلاً، لكنّك موهوب

151
00:12:38,630 --> 00:12:39,930
!أ-أنت

152
00:12:39,930 --> 00:12:41,370
...بحقّك، انتظر

153
00:12:41,370 --> 00:12:44,270
.أخي! بحقّك يا أخي

154
00:12:44,270 --> 00:12:48,240
اخرس يا رجل. أنا واثق تمامًا
.أنّني لا أملك إخوةً مثلك

155
00:12:48,240 --> 00:12:50,180
ما اسمك يا صاحبي؟

156
00:12:50,180 --> 00:12:51,800
.لا أملك اسمًا

157
00:12:51,800 --> 00:12:53,800
.والآن، اغرب يا عمّ

158
00:12:54,590 --> 00:12:57,130
!تمهّل لحظة

159
00:12:57,130 --> 00:12:59,280
!أعرف طريقةً للحصول على مالٍ أفضل

160
00:13:02,390 --> 00:13:05,430
لِمَ لا تدعني أعتني بك؟

161
00:13:09,110 --> 00:13:09,810
!جو

162
00:13:11,310 --> 00:13:14,170
.هذا ليس جيّدًا كفايةً
.لا تتقدّم بشكلٍ صحيح

163
00:13:18,270 --> 00:13:19,770
وكيف عرفت؟

164
00:13:19,770 --> 00:13:21,230
...لا يمكنك أن ترى

165
00:13:21,230 --> 00:13:22,190
.الصّوت

166
00:13:22,500 --> 00:13:24,010
،إن كانت لكماته حادّة

167
00:13:24,010 --> 00:13:27,270
.لما بدا صوتها كضراط بقرة

168
00:13:27,740 --> 00:13:31,750
!دائمًا ما أخبرك، يجب أن توزّع وزنك بالتّساوي

169
00:13:32,200 --> 00:13:35,450
إن كنت تظنّ أنّك تستطيع أن تتخاذل
!فقط لأنّني لا أستطيع رؤيتك، فسأضربك

170
00:13:44,400 --> 00:13:46,380
ما رأيك يا عمّ؟

171
00:13:46,680 --> 00:13:47,800
.ليست سيّئة إطلاقًا

172
00:13:54,670 --> 00:13:55,680
أترى؟

173
00:13:55,680 --> 00:13:57,230
.تملك فريقًا مبهرًا

174
00:13:58,460 --> 00:14:00,690
.نعم، إنّه كذلك بالفعل

175
00:14:01,230 --> 00:14:03,720
.وهو مذهل

176
00:14:04,650 --> 00:14:08,080
.قد يستطيع أن يهزم يوري بالفعل

177
00:14:10,150 --> 00:14:13,870
.ربّما كان يعتني بي، طوال الوقت

178
00:15:01,360 --> 00:15:02,420
من؟

179
00:15:22,620 --> 00:15:24,860
.إنّه على هذه الحال منذ خمسة أيّام

180
00:15:27,350 --> 00:15:29,200
أليس هنالك ما نستطيع فعله؟

181
00:15:31,150 --> 00:15:33,360
...لكن... إن لم نفعل شيئًا

182
00:15:42,450 --> 00:15:44,420
.سيقضي هذا على الألم

183
00:15:45,710 --> 00:15:46,670
...لكن

184
00:15:47,240 --> 00:15:51,560
،لقد أخبرني "إن استسلمت للألم
."فلا أستحقّ قتاله

185
00:15:52,120 --> 00:15:53,800
.لقد رفض الأمر عندما حدّثته

186
00:15:54,470 --> 00:15:57,210
.لكن لعلّك تستطيعين إقناعه بخلاف ذلك يا يوكيكو

187
00:16:14,070 --> 00:16:16,370
.فلنذهب إلى البيت يا يوري

188
00:16:19,370 --> 00:16:22,340
.لا يمكنك أن تقاتل في هذا الوضع

189
00:16:22,670 --> 00:16:26,860
،سنعيد تركيب ترسك
.ويمكنك أن تقف بفخر مجدّدًا

190
00:16:27,970 --> 00:16:29,360
...بالنّسبة لشيراتو، أنت

191
00:16:30,850 --> 00:16:32,840
.أنت مستقبلي

192
00:16:37,230 --> 00:16:39,920
...حلمتُ بشأن الأيّام الخوالي

193
00:16:42,230 --> 00:16:45,680
.قبل أن ألتقي بك بوقتٍ طويل

194
00:16:46,160 --> 00:16:51,230
...الرّجل الّذي علّمني ملاكمة ميغالو أخبرني بشيء

195
00:16:52,270 --> 00:16:55,840
إن كنت محظوظًا كفايةً لتصادف في جيلك"

196
00:16:55,840 --> 00:16:58,980
،شخصًا تريد قتاله من صميم قلبك

197
00:16:59,450 --> 00:17:00,990
".فاعتبر نفسك مُباركًا

198
00:17:01,970 --> 00:17:04,630
،إن وجدت شخصًا كهذا"

199
00:17:05,310 --> 00:17:08,680
".لا تشح ناظرك عنه أبدًا

200
00:17:10,310 --> 00:17:14,080
.أخيرًا التقيتُ بالخصم الّذي تحدّث عنه

201
00:17:15,210 --> 00:17:16,700
...يوكيكو

202
00:17:17,060 --> 00:17:21,430
.منحتني سببًا للعيش

203
00:17:22,150 --> 00:17:27,380
.أرجوك... لا تسلبيني إيّاه الآن

204
00:18:05,370 --> 00:18:06,470
.إنّه في حالة رائعة

205
00:18:06,760 --> 00:18:09,540
أشكّ أنّ هنالك ملاكمًا يستطيع أن يبقى
.واقفًا إن تلقّى لكمةً من يمناه

206
00:18:13,350 --> 00:18:14,190
!يوري

207
00:18:18,150 --> 00:18:20,480
.أعتذر على مقاطعة تدريبك

208
00:18:20,480 --> 00:18:21,810
.لا بأس يا حضرة الرّئيس

209
00:18:21,810 --> 00:18:25,200
.أردتُ أن أُقدّمك إلى حفيدتي، يوكيكو

210
00:18:26,970 --> 00:18:27,940
.سعيدة بلقائك

211
00:18:29,730 --> 00:18:31,380
...يداي متعرّقتان قليلاً، لذا

212
00:18:38,880 --> 00:18:42,250
.أنتما الاثنان مستقبل شيراتو

213
00:18:53,860 --> 00:18:57,560
.أظنّ أنّ كلانا استخففنا به

214
00:18:59,110 --> 00:18:59,970
يوكيكو؟

215
00:19:00,740 --> 00:19:03,690
.لا شأن لي بملاكمٍ بلا ترس

216
00:19:04,460 --> 00:19:05,940
...مثلك تمامًا

217
00:19:06,450 --> 00:19:09,980
.لم يعد عضوًا بشيراتو

218
00:19:12,950 --> 00:19:15,420
.وداعًا يا أخي

219
00:19:21,950 --> 00:19:23,930
!مرحى

220
00:19:27,220 --> 00:19:30,140
أواثق أنّك لست بحاجةٍ للتّدريب؟

221
00:19:30,140 --> 00:19:31,980
.سوف أقاتل يوري

222
00:19:31,980 --> 00:19:34,100
.قليلٌ من ارتباك الدّقائق الأخيرة لن يفيدني بشيء

223
00:19:36,190 --> 00:19:38,430
.يجب أن تقفز إلى هنا يا ساتشيو

224
00:19:38,850 --> 00:19:40,710
...لا، أنا بخير

225
00:19:41,750 --> 00:19:43,410
لا تستطيع السّباحة؟

226
00:19:44,090 --> 00:19:45,580
!بلى أستطيع

227
00:19:46,210 --> 00:19:48,240
.تبًّا، شاهد فحسب

228
00:19:52,370 --> 00:19:54,800
.سمعت أنّك اعتنيت بزميلي

229
00:19:55,330 --> 00:19:57,670
.لم أحظ بفرصةٍ لشكرك

230
00:19:59,740 --> 00:20:01,630
.لقد أوقع هذه

231
00:20:02,480 --> 00:20:03,250
!ماذا؟

232
00:20:03,250 --> 00:20:05,140
!لقد اختفت! لا أملكها

233
00:20:05,540 --> 00:20:08,490
بمعرفتي لك، لقد بحثت في أمرها، صحيح؟

234
00:20:08,960 --> 00:20:10,050
.نعم

235
00:20:10,050 --> 00:20:13,140
.أعرف من تكون بالضّبط الآن

236
00:20:14,300 --> 00:20:15,150
وبعد؟

237
00:20:16,050 --> 00:20:16,960
.لا شيء

238
00:20:17,960 --> 00:20:20,740
.إنّها تنتمي إليك يا جو

239
00:20:21,770 --> 00:20:22,780
هل أنت واثقة؟

240
00:20:24,700 --> 00:20:27,030
.سوف أهزم بطلك

241
00:20:29,900 --> 00:20:31,870
.يوري قد نزع ترسه

242
00:20:33,290 --> 00:20:34,870
!ماذا فعل؟

243
00:20:34,870 --> 00:20:38,710
."لأجل أن يقاتلك... أن يقاتل جو "بلا ترس

244
00:21:05,070 --> 00:21:08,810
إنّه وحش، حيوان، يعيش يومًا تلو يوم

245
00:21:08,810 --> 00:21:12,540
يطردوه، لكنّه لا يزال يطارد فريسته

246
00:21:12,540 --> 00:21:16,420
مستضعفٌ لم يحظ بأيّ اسم

247
00:21:16,420 --> 00:21:20,130
،جسده عارٍ ومكتسٍ بالنّدوب
لكنّه لا يزال مشاركًا في اللّعبة

248
00:21:20,130 --> 00:21:23,100
سيواجه ملك الوحوش العظيم

249
00:21:23,100 --> 00:21:27,050
مختار، يحوّل كلّ القادمين إليه إلى ولائم

250
00:21:27,050 --> 00:21:30,660
يملك شعرًا فضيًّا، يومض تحت ضوء القمر

251
00:21:30,660 --> 00:21:34,170
هل يعتزل غير مهزوم؟ يقال أنّه قد يفعل

252
00:21:34,170 --> 00:21:38,060
روحان محاصران في نفس التّيّار الرّجعيّ

253
00:21:38,060 --> 00:21:41,530
وها هما الآن مقيّدان معًا، يعويان في الظّلّ

254
00:21:41,530 --> 00:21:45,490
نوعٌ من الحسد، ليس بالشّيء الّذي يريدان الاعتراف به

255
00:21:45,490 --> 00:21:49,320
الطّريقة الوحيدة للتّعامل مع ذلك
هي أن يقفز الكلبان إلى الحفرة

256
00:21:49,610 --> 00:21:53,130
من يملك ومن لا يملك

257
00:21:53,130 --> 00:21:56,790
رجلٌ ينهض ويحاول أخذ مكان الآخر

258
00:21:56,790 --> 00:22:00,360
المتظاهر وصاحب التّاج

259
00:22:00,360 --> 00:22:03,920
حقيقيّ أم مزيّف؟ من منهما سيسقط؟

260
00:22:04,320 --> 00:22:07,940
حيوانان يتوحّشان

261
00:22:07,940 --> 00:22:11,430
الحرّيّة والرّوح، الشّيئان الوحيدان المتشاركان بينهما

262
00:22:11,810 --> 00:22:14,840
وهنا حيث يريدان أن يكونا

263
00:22:14,840 --> 00:22:18,850
حيوانان ضاريان، على وشك أن يُحرّرا

264
00:22:37,000 --> 00:22:40,000
...ليس ميتًا بعد