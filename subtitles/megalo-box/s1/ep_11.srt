1
00:00:06,860 --> 00:00:09,880
سيتأهّل الفائز في مباراة اللّيلة لمواجهة يوري

2
00:00:09,880 --> 00:00:12,990
.الفائز بضربة قاضية حاسمة في ذلك اليوم

3
00:00:13,420 --> 00:00:15,820
هل سيستطيع جو "بلا ترس" الّذي
تمكّن من خطف المركز الأخير

4
00:00:15,820 --> 00:00:19,830
احتمال انقضاض باروز ليُحقّق فوزًا إعجازيًّا آخرًا؟

5
00:00:20,110 --> 00:00:23,580
،بعد هزيمته لشيراتو ميكيو
،ترتفع التّوقّعات كثيرًا

6
00:00:23,580 --> 00:00:28,250
وليس الخبراء فحسب، بل حتّى المعايير
الصّارمة لوكلاء المراهنات في الخارج

7
00:00:28,250 --> 00:00:30,430
.يتنبّؤون فوز جو

8
00:00:30,430 --> 00:00:33,620
.وهذه الاحتمالات تُسرد حاليًّا بين 3/1 و5/1

9
00:00:38,180 --> 00:00:39,020
نعم؟

10
00:00:39,020 --> 00:00:40,380
مذهل، أليس كذلك؟

11
00:00:40,380 --> 00:00:43,350
.لقد خدعت العالم بأسره باحتيالك

12
00:00:44,120 --> 00:00:46,900
.لا أذكر أنّني طلبتُ أيّ حماية

13
00:00:48,010 --> 00:00:52,230
.أعتذر إن كان ذلك يشعرك بعدم الارتياح
.أنا أؤمن بك

14
00:00:53,270 --> 00:00:54,690
.سأراك في الملعب

15
00:03:07,410 --> 00:03:10,170
...لقد كانت... مرميّة في القمامة، لذا

16
00:03:10,170 --> 00:03:11,290
.شكرًا

17
00:03:11,290 --> 00:03:13,880
.فقط أُسدّد لك حقّ المكوث والطّعام

18
00:03:13,880 --> 00:03:16,300
.لا أريد أن أدين لك بأيّ شيء

19
00:03:16,900 --> 00:03:18,700
.لا أنجح في إبقاء الزّهور حيّة أبدًا

20
00:03:18,700 --> 00:03:20,540
.تموت قبل أن تسقط البتلات

21
00:03:24,080 --> 00:03:25,470
.يبدو ذلك كتميمة حظّ سعيد

22
00:03:27,290 --> 00:03:29,480
...إنّني أعتني بهويّة جو، لذا

23
00:03:29,480 --> 00:03:31,280
هل تفعل هذا لأجله إذًا؟

24
00:03:34,430 --> 00:03:37,400
.أ-أمّي كانت تحبّ مثل هذه الزّهور

25
00:03:40,900 --> 00:03:43,240
،لا يزال بوسعك أن تصل في الوقت
.إن غادرت الآن

26
00:03:43,600 --> 00:03:45,870
.لن أذهب! لقد حسمت أمري

27
00:03:46,710 --> 00:03:48,990
ألا تريد أن تراه بنفسك؟

28
00:03:49,420 --> 00:03:51,970
.مشهده وهو يقف على الحلبة في ميغالونيا

29
00:03:52,330 --> 00:03:54,320
!لستُ بحاجة لأرى حتّى أعرف

30
00:03:54,320 --> 00:03:56,940
!لن يخسر جو حتّى يقاتل يوري

31
00:04:01,350 --> 00:04:04,570
.فهمت. هذا قرارك

32
00:04:24,700 --> 00:04:26,670
!غلين باروز

33
00:04:26,670 --> 00:04:30,290
ملاكم الوزن الثّقيل الّذي يمشي بتشامخ
!في الحلبة كما لو أنّها السّافانا

34
00:04:30,950 --> 00:04:33,730
،في مواجهة هذا الوحش البرّيّ

35
00:04:33,730 --> 00:04:37,330
الرّجل الّذي يقاتل بيديه العاريتين
!فحسب، الصيّاد الأعزل

36
00:04:51,420 --> 00:04:54,980
الرّجل الّذي قلب الأوضاع لصالحه بشكلٍ
،إعجازيّ مرّةً تلو الأخرى، بدون أيّ تعزيزات

37
00:04:54,980 --> 00:04:58,020
!"جو "بلا ترس

38
00:05:10,420 --> 00:05:11,580
...بالمناسبة يا جو

39
00:05:11,990 --> 00:05:14,220
ماذا تفعل عندما تكون خائفًا؟

40
00:05:15,450 --> 00:05:18,810
مثلاً، عندما تخاف أن تقدم
.على حركةٍ ما... وتُشلّ

41
00:05:20,440 --> 00:05:24,000
.أريد أن أستطيع القتال بنفسي أيضًا

42
00:05:26,690 --> 00:05:30,020
.فقط المس شيئًا حولك، مهما كان

43
00:05:31,300 --> 00:05:34,280
.ذلك يساعدك على إدراك اللّحظة

44
00:05:34,710 --> 00:05:37,430
.ويُذكّرك بما تحتاج فعله

45
00:05:39,160 --> 00:05:41,120
.إنّها حيلة تعلّمتها قبل وقتٍ طويل

46
00:05:41,500 --> 00:05:43,380
...إنّها مجرّد ترّهات على الأغلب، لكن

47
00:05:43,980 --> 00:05:47,610
ماذا؟ من علّمك هذا الهراء؟

48
00:05:59,310 --> 00:06:00,360
.لحظة رجاءً

49
00:06:01,320 --> 00:06:02,340
هل تريد أيّ شيء؟

50
00:06:03,270 --> 00:06:04,310
.لا

51
00:06:04,310 --> 00:06:06,220
.فهمت. شكرًا

52
00:06:06,570 --> 00:06:07,650
.عن إذنك

53
00:06:12,750 --> 00:06:14,320
.أحضرت وجبتكم

54
00:06:23,550 --> 00:06:27,440
.جميع عملائنا يراهنون على جو

55
00:06:27,440 --> 00:06:31,070
من المؤسف لهم أنّه سيُهزم
.في أوّل مباراةٍ له في البطولة

56
00:06:31,660 --> 00:06:34,540
عليكما أن تنهيا الأمر في الجولة
.الثّالثة، مع تبقّي دقيقة واحدة

57
00:06:34,950 --> 00:06:37,370
.اجعله يقدّم أداءً جيّدًا إلى ذلك الحين

58
00:06:39,310 --> 00:06:42,350
.تملك هذه المياه عسارة تفوق 600 جزء للمليون

59
00:06:43,040 --> 00:06:47,060
.وتنسجم جيّدًا مع السّمك الّذي غُلي به

60
00:06:47,890 --> 00:06:51,300
وميزة الماء العسر هو أنّه تُصنع
.منه مرقة رائعة

61
00:06:58,390 --> 00:07:01,440
!والآن، سيدخل الملاكمان إلى الحلبة

62
00:07:03,400 --> 00:07:07,170
،في الزّاوية الشّرقيّة
،"المصنّف الثّالث في "أي إم آي

63
00:07:07,490 --> 00:07:09,500
...مع فريق القنبلة القاتلة

64
00:07:10,060 --> 00:07:14,160
!غلين "الأسد الدّمويّ" باروز

65
00:07:27,780 --> 00:07:31,680
،وفي الزّاوية الغربيّة
..."المصنّف الرّابع في "أي إم آي

66
00:07:31,680 --> 00:07:33,760
،مع فريق لا مكان

67
00:07:33,760 --> 00:07:38,180
!جو "الولد العاري" بلا ترس

68
00:07:47,680 --> 00:07:49,070
مهلاً... أهذا...؟

69
00:07:50,040 --> 00:07:51,300
ما الّذي يجري؟

70
00:07:51,300 --> 00:07:52,530
!لا بدّ أنّها مزحة

71
00:07:54,960 --> 00:07:58,010
!ثمّة تغيّر مثير للاهتمام يا سادة

72
00:07:58,010 --> 00:08:00,020
،تطوّر لا يمكن تصوّره لعالم ملاكمة ميغالو

73
00:08:00,020 --> 00:08:04,740
..."الرّجل الّذي لطالما لُقّب بجو "بلا ترس

74
00:08:04,740 --> 00:08:07,500
!يرتدي ترسًا

75
00:08:07,500 --> 00:08:11,630
قد تكون استراتيجيّة ليتغلّب على عائق
.القوّة الّذي يملكه مقارنةً بباروز

76
00:08:11,630 --> 00:08:12,620
.مثير للاهتمام

77
00:08:12,620 --> 00:08:15,190
،أيضًا، يبدو أنّ هذه المرّة
،سيقاتل جو وحيدًا

78
00:08:15,190 --> 00:08:17,660
.دون وجود أيّ مساعد في زاويته

79
00:08:20,100 --> 00:08:22,850
.يبدو أنك درّبته جيدًا يا نانبو-سان

80
00:08:27,620 --> 00:08:30,280
.لن أطلب منك أن تسامحني

81
00:08:30,600 --> 00:08:32,540
.لا أستحقّ المسامحة أساسًا

82
00:08:35,370 --> 00:08:37,990
...لا بدّ أنّك لا تريد حتّى أن تسمع صوتي

83
00:08:38,530 --> 00:08:39,730
.لكن أعتمد عليك

84
00:08:40,960 --> 00:08:42,960
.يجب أن تخسر في الجولة الثّالثة

85
00:08:43,300 --> 00:08:44,920
.يجب أن تقاوم حتّى ذلك الحين

86
00:08:46,670 --> 00:08:49,960
...يا له من شرف لي أن ترتدي ذلك التّرس لأجلي

87
00:08:49,960 --> 00:08:51,920
.أيّها الجبان

88
00:08:51,920 --> 00:08:56,390
.سأسحقك كالخردة، أنت وترسك الرّديء

89
00:09:00,340 --> 00:09:03,350
لا أصدّق أنّه يرتدي ترسًا في الحلبة
...بعد كلّ هذا الوقت

90
00:09:05,610 --> 00:09:06,560
لماذا؟

91
00:09:08,110 --> 00:09:10,090
.انظروا. إنه يرتدي ترسًا

92
00:09:10,090 --> 00:09:11,920
لا يجيد سوى الكلام إذًا؟

93
00:09:11,920 --> 00:09:13,780
!هذا ليس وقت الجبن

94
00:09:14,900 --> 00:09:16,310
!ساتشيو

95
00:09:16,310 --> 00:09:18,320
ما الّذي يجري؟

96
00:09:18,320 --> 00:09:20,780
،جو الكبير يرتدي ترسًا

97
00:09:20,780 --> 00:09:22,800
!ولم نستطع إيجادك ولا العمّ

98
00:09:22,800 --> 00:09:24,730
!لا ندري ما يجري بتاتًا

99
00:09:25,200 --> 00:09:26,000
!ساتشيو

100
00:09:28,070 --> 00:09:29,190
.يكفي

101
00:09:33,950 --> 00:09:34,760
ساتشيو؟

102
00:09:40,030 --> 00:09:42,510
!لا تندفع نحوه كثيرًا! سيهاجمك

103
00:09:50,440 --> 00:09:53,530
،إنّه يعتمد على قوّته كثيرًا
.لذا لا يقترب بقوّة كافية

104
00:09:53,530 --> 00:09:55,260
.استخدم ساقيك ودر من حوله

105
00:09:59,050 --> 00:10:02,160
!قلت استخدم ساقيك وإلاّ سيسحق ترسك

106
00:10:02,620 --> 00:10:03,450
!تبًّا

107
00:10:05,910 --> 00:10:07,900
من يأبه لجو "بلا ترس"؟

108
00:10:07,900 --> 00:10:09,460
!من يأبه بشأن بذل قصارى الجهد؟

109
00:10:09,460 --> 00:10:11,290
!لقد كان كلّ ذلك احتيال

110
00:10:17,570 --> 00:10:19,730
!احترس! سيهاجمك بقوّة الآن

111
00:10:27,450 --> 00:10:29,680
!انتهت الجولة الأولى

112
00:10:30,010 --> 00:10:32,020
،لا بدّ وأن أقول

113
00:10:32,020 --> 00:10:36,230
مع أنّه قدّم عرضًا أفضل، إلاّ أنّ
.باروز بدا مرتبكًا بعض الشّيء

114
00:10:36,230 --> 00:10:37,760
.تمامًا

115
00:10:37,760 --> 00:10:40,430
،يتمتّع جو بحسّ الملاكمة الّذي يخوّله المقاومة

116
00:10:40,430 --> 00:10:43,700
.وكذا القوّة لقلب النّزال إلى صالحه بلكمة واحدة

117
00:10:44,760 --> 00:10:48,160
.ذاك النّذل الصّغير، من الأفضل له ألاّ يحاول الفوز

118
00:10:48,160 --> 00:10:50,870
أواثق أنّه ينصت إليك أساسًا؟

119
00:10:51,760 --> 00:10:53,950
،إن كان جو يحاول هزيمته

120
00:10:53,950 --> 00:10:56,760
لكان أسقطه بتلك اللّكمة الصّاعدة
.بعد أن لكمه في جسمه

121
00:10:57,840 --> 00:10:59,870
.إنصاته لي ليس بيت القصيد

122
00:11:00,390 --> 00:11:02,890
.إنّه يقوم بعمله

123
00:11:04,370 --> 00:11:06,680
.لكن أشكّ أنّكما تستطيعان رؤية ذلك

124
00:11:07,510 --> 00:11:09,800
!من الأفضل لك أن تراقب كلامك أيّها الحقير

125
00:11:09,800 --> 00:11:11,650
.إنّه يقدّم عرضًا مذهلاً

126
00:11:12,570 --> 00:11:14,860
،يفوّت اللّكمات عن قصد في البداية

127
00:11:14,860 --> 00:11:17,110
...ثمّ يخرج عن مساره بشكلٍ بسيط

128
00:11:17,440 --> 00:11:20,700
.لن يدرك أيّ أحد أنّه يدّعي الهزيمة

129
00:11:21,910 --> 00:11:25,640
،كنت تمنحه التّعليمات لكي يتفادى الأذى

130
00:11:25,640 --> 00:11:29,750
.لكنّه يعصيها ويتلقّى اللّكمات قصدًا

131
00:11:30,810 --> 00:11:33,260
...إجراءٌ عصيانيّ من كلبٍ ضالّ

132
00:11:33,260 --> 00:11:36,400
.أظنّه يخبرك أنّه لا يقبل مشورتك

133
00:11:45,880 --> 00:11:49,420
.أريد أن أحظى بمباراة حقيقيّة معك، فقط لا غير

134
00:11:50,270 --> 00:11:51,640
،أشعر أنّني إن واجهتك

135
00:11:51,640 --> 00:11:53,830
.يمكنني أن أذهب إلى حدٍّ أبعد من قبل

136
00:12:07,480 --> 00:12:08,910
،بدأت الجولة الثّانية

137
00:12:08,910 --> 00:12:12,320
...ويبدو أنّ باروز يسدّد بعض اللّكمات

138
00:12:12,320 --> 00:12:13,900
.إنّه حذر على الأرجح

139
00:12:13,900 --> 00:12:16,630
لقد أظهر جو عن براعته
.في تسديد اللّكمات المضادّة

140
00:12:20,180 --> 00:12:22,930
لا يا جو! يجب أن تواصل المماطلة
!في هذه الجولة

141
00:12:26,610 --> 00:12:27,930
!هل تسمعني؟

142
00:12:27,930 --> 00:12:29,740
!استمع لي ولو لمرّةً، تبًّا

143
00:12:30,970 --> 00:12:32,850
!لن تدوم المباراة إن استمررت هكذا

144
00:12:41,000 --> 00:12:42,570
!صدّ ثمّ تحرّك إلى الجانب

145
00:12:47,100 --> 00:12:48,640
!هكذا، أحسنت

146
00:12:49,220 --> 00:12:51,490
!لا يستطيع مجاراتك

147
00:12:52,300 --> 00:12:54,830
الكمه على جسده بعد أن يُسدّد
،لكماته لكي تبطئه

148
00:12:54,830 --> 00:12:56,500
!ثمّ سدّد خطّافيّة طويلة إلى كتفه

149
00:13:01,130 --> 00:13:02,050
!أحسنت

150
00:13:08,210 --> 00:13:11,150
انطلاقًا من الجولات السّابقة، يبدو
أنّ جو كان يستطيع القتال بشكلٍ جيّد

151
00:13:11,150 --> 00:13:14,310
...حتّى دون ارتداء أيّ ترس

152
00:13:14,310 --> 00:13:16,310
،بما أنّه لا يوجد أيّ أحد يدعمه

153
00:13:16,310 --> 00:13:20,320
قد نرى اختلافًا في الآراء
.بشأن كيف يجب أن يقاتل

154
00:13:21,290 --> 00:13:24,160
لقد تغيّرت الكثير من الأمور منذ
المباريات السّرّيّة، أليس كذلك؟

155
00:13:24,160 --> 00:13:25,660
.باروز قويّ

156
00:13:26,120 --> 00:13:28,270
.لقد كسب التّرتيب الثّالث

157
00:13:28,800 --> 00:13:31,580
...لكنّ جو... إن قاتل بجدّ

158
00:13:31,580 --> 00:13:33,040
.أقصدك أنت

159
00:13:33,520 --> 00:13:35,620
.إنّك تتصرّف كمدرّب حقيقيّ

160
00:13:36,190 --> 00:13:39,460
.فوجيماكي-سان، معظم الرّهانات ترجّح كفّة جو

161
00:13:39,460 --> 00:13:41,220
.لقد ارتفعت الاحتمالات مجدّدًا

162
00:13:41,220 --> 00:13:42,520
.كلّ شيء يجري بشكل جيّد حاليًّا

163
00:13:48,250 --> 00:13:49,810
...كان يفترض بنا أن نكون فريقًا

164
00:13:50,580 --> 00:13:52,860
.لكن في النّهاية، الجميع يهتمّون لأنفسهم فحسب

165
00:13:57,850 --> 00:13:59,680
!ولا أختلف شأنًا عنهم

166
00:14:00,270 --> 00:14:03,880
.لقد كنتُ أستغلّ جو للحصول على انتقامي

167
00:14:06,370 --> 00:14:07,170
...لكن

168
00:14:17,950 --> 00:14:20,500
،الجميع يلاحظون الرّقم واحد فحسب

169
00:14:20,500 --> 00:14:23,380
.لذا لِمَ تتوقّف الآن؟ لم تنتهِ بعد

170
00:14:23,380 --> 00:14:25,970
،لا ترتدي أيّ معدن على ظهرك
،"لهذا ينادونك "بلا ترس

171
00:14:25,970 --> 00:14:28,630
.لكن الآن لا تتصرّف ببسالة

172
00:14:28,630 --> 00:14:31,320
.أنت تلعب في قتالك فحسب، لا تهتمّ

173
00:14:31,320 --> 00:14:33,940
هل نسيت حقًّا؟
.أتينا جميعًا من لا مكان

174
00:14:33,940 --> 00:14:36,640
!اسمي ساتشيو! لستُ طفلاً ما

175
00:14:36,640 --> 00:14:39,350
.لكن في هذه الرّحلة؟ أنت من يقرّر الوجهة

176
00:14:39,350 --> 00:14:41,970
.لا يمكنك أن تتوقّف الآن. استمر في المحاولة

177
00:14:41,970 --> 00:14:44,570
.لا تقلق حتّى بشأن كذب نانبو

178
00:14:44,570 --> 00:14:47,060
،إن كنت ستنظر إلى الخلف دائمًا

179
00:14:47,060 --> 00:14:49,860
.فمن الأفضل أن تزرع عينين في مؤخرتك

180
00:14:49,860 --> 00:14:52,600
.أردت منّا نحن الثّلاثة أن نذهب للقمّة

181
00:14:52,600 --> 00:14:55,090
.لا أهتمّ للانتقام. اخترت التّوقّف

182
00:14:55,090 --> 00:14:57,820
.اكسب اللّقب، فز بقتالٍ نزيه

183
00:14:57,820 --> 00:15:00,540
.يجب أن تتجاوز هذا... فهو الصّواب

184
00:15:05,710 --> 00:15:07,550
.ستفعلها مع تبقي دقيقة

185
00:15:08,090 --> 00:15:10,000
.أبليت بشكلٍ رائع يا جو

186
00:15:10,620 --> 00:15:13,340
.فور أن ينتهي هذا الأمر، ستكون حرًّا

187
00:15:13,790 --> 00:15:16,180
.لن تكون بحاجة لاستحمال هذا الهراء بعد الآن

188
00:15:17,640 --> 00:15:20,770
.يبدو أنّ لديك الفكرة الخاطئة يا نانبو-سان

189
00:15:23,110 --> 00:15:26,300
...لقد قمتما بعملٍ رائع حتّى الآن

190
00:15:28,350 --> 00:15:29,940
.وذلك مبهر

191
00:15:30,510 --> 00:15:33,790
لكن... هل حسبت حقًّا أنّ هذا سيُغيّر أيّ شيء؟

192
00:15:34,660 --> 00:15:38,560
.أخبرتك سلفًا... لا تستطيع تغيير طبيعتك

193
00:15:39,130 --> 00:15:42,540
.العقرب عقرب، والكلب الضّالّ كلب ضالّ

194
00:15:42,960 --> 00:15:46,850
.سوف يقاتل لما تبقّى من حياته... في حلبتي

195
00:15:48,890 --> 00:15:50,170
...لا

196
00:15:53,590 --> 00:15:54,680
.انتهى الأمر

197
00:15:58,810 --> 00:16:00,330
...جو الكبير

198
00:16:01,800 --> 00:16:02,600
!انظرا

199
00:16:08,260 --> 00:16:10,190
!إيّاك أن تدع الأمر ينتهي هكذا

200
00:16:12,480 --> 00:16:13,470
!ساتشيو؟

201
00:16:14,070 --> 00:16:14,940
!الفتى

202
00:16:16,650 --> 00:16:17,500
!يوري

203
00:16:29,110 --> 00:16:31,560
!قاتل من أجل نفسك يا جو

204
00:16:35,340 --> 00:16:36,140
.حان الوقت

205
00:16:38,190 --> 00:16:40,350
.اذهبا وأحضرا الفتى، الآن

206
00:16:59,490 --> 00:17:00,910
!جو

207
00:17:01,810 --> 00:17:02,750
!لقد سقط

208
00:17:03,300 --> 00:17:04,100
...واحد

209
00:17:04,550 --> 00:17:07,980
!أنت ذاهب إلى القمّة، صحيح؟
!أليس هذا ما كنت تقاتل لأجله؟

210
00:17:07,980 --> 00:17:09,750
!لا تدع الأمر يكون مجرّد تحايل

211
00:17:09,750 --> 00:17:11,340
!جو

212
00:17:12,760 --> 00:17:14,230
.سنلقي عليه القبض فورًا

213
00:17:15,130 --> 00:17:17,810
!ماذا؟! ماذا تفعلون؟

214
00:17:17,810 --> 00:17:19,620
!أفلتني أيّها الحقير

215
00:17:26,070 --> 00:17:28,550
هل نسيت ما أخبرتني؟

216
00:17:35,950 --> 00:17:38,800
!لا تخيّبني يا جو

217
00:17:50,120 --> 00:17:51,050
!انهض

218
00:17:52,830 --> 00:17:54,820
!انهض على قدميك يا جو

219
00:17:56,950 --> 00:17:59,730
!لن أدعهم يمسّون ساتشيو

220
00:18:00,730 --> 00:18:03,390
!لن يسلب أيّ أحد الغد منك

221
00:18:05,730 --> 00:18:09,020
.انهض... انهض وقاتل

222
00:18:09,020 --> 00:18:12,320
!لديك مستقبل يا جو

223
00:18:13,990 --> 00:18:16,350
.لديك مهارة حقيقيّة

224
00:18:16,670 --> 00:18:19,320
!هذا ضمان من نانبو غانساكو

225
00:18:19,880 --> 00:18:22,110
!لم يعد هذا تحايلاً

226
00:18:23,140 --> 00:18:23,940
...سبعة

227
00:18:24,620 --> 00:18:25,540
...ثمانية

228
00:18:26,160 --> 00:18:26,960
...تسعة

229
00:18:36,170 --> 00:18:39,660
لا يمكنني أن أدع الأمر ينتهي هكذا، أليس كذلك؟

230
00:18:56,860 --> 00:18:57,990
!غبيّ

231
00:19:03,490 --> 00:19:05,990
!لا أملك الوقت للعب دور مروّض الأسود

232
00:19:11,120 --> 00:19:13,500
!لا تستعجل! اهدأ يا غلين

233
00:19:28,960 --> 00:19:29,850
!لقد سقط

234
00:19:33,860 --> 00:19:37,070
،بضربة قاضية في الدّقيقة 2:56 من الجولة الثّالثة

235
00:19:37,070 --> 00:19:41,530
!يحرز جو "بلا ترس" من فريق لا مكان فوزه

236
00:19:42,170 --> 00:19:43,620
...انتهى الأمر في لحظة

237
00:19:43,620 --> 00:19:46,020
!ولم تزل القشعريرة بعد

238
00:19:46,020 --> 00:19:49,560
لكمة جو "بلا ترس" الوحشيّة والجميلة المضادّة

239
00:19:49,560 --> 00:19:53,770
!أسقطت باروز في طرفة عين

240
00:19:53,770 --> 00:19:54,670
!جو

241
00:20:01,590 --> 00:20:02,410
!جو

242
00:20:03,350 --> 00:20:05,860
!جو، أنت رائع

243
00:20:05,860 --> 00:20:07,080
!جو

244
00:20:16,780 --> 00:20:18,190
هل انتهيتم؟

245
00:20:21,980 --> 00:20:25,240
.اخترتَ لسع الشّخص الخطأ يا نانبو-سان

246
00:20:27,340 --> 00:20:28,880
.انتهى أمرك

247
00:20:35,970 --> 00:20:38,640
كنتيجة لهذا، ستكون المباراة النهائيّة لميغالونيا

248
00:20:38,640 --> 00:20:42,040
."بين يوري وجو "بلا ترس

249
00:20:43,070 --> 00:20:47,210
لا بدّ أنّها ستكون أكثر مباراة
.لا يمكن تنبّؤها تُزيّن الحلبة

250
00:20:49,410 --> 00:20:50,570
ماذا حدث؟

251
00:20:51,840 --> 00:20:56,510
...لأوّل مرّة في حياتي
.أظنّني أفهم ما تعنيه الغيرة

252
00:20:58,270 --> 00:21:01,250
.جو "بلا ترس"... إنّه ملاكمٌ حقيقيّ

253
00:21:18,460 --> 00:21:19,360
!العمّ

254
00:21:30,540 --> 00:21:31,510
هل فعلت هذا؟

255
00:21:32,700 --> 00:21:34,170
!هل فعلت هذا به؟

256
00:21:34,170 --> 00:21:35,580
.توقّف

257
00:21:35,580 --> 00:21:36,480
...يا عمّ

258
00:21:36,970 --> 00:21:39,470
.لقد سوّيتُ الأمر بنفسي

259
00:21:39,820 --> 00:21:41,980
.لا شيء تفعله

260
00:21:42,850 --> 00:21:45,950
،إن لم تكن راضيًا بمقلة عيني

261
00:21:46,780 --> 00:21:50,200
!أنا مستعدّ لاقتلاع قلبي وتقديمه

262
00:21:55,190 --> 00:21:56,380
.أبعدوهم عن ناظريّ

263
00:21:58,200 --> 00:21:59,840
...فـ-فوجيماكي-سان

264
00:22:01,490 --> 00:22:06,470
الرّجل الّذي أراد رؤية ذاك الفتى يرقص
...على الحلبة أكثر من أيّ أحد

265
00:22:07,140 --> 00:22:10,340
.قد مزّق أيّ فرصة يملكها لرؤية ذلك

266
00:22:10,970 --> 00:22:13,970
أتظنّ أنّ أيّ أحد يستطيع
القيام بهذا العمل المثير؟

267
00:22:16,980 --> 00:22:18,330
.إنّها مزحة لعينة

268
00:22:37,000 --> 00:22:40,000
...ليس ميّتًا بعد