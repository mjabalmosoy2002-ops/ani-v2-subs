1
00:00:01,040 --> 00:00:04,140
.لا تتقدّم كثيرًا أو تتراجع كثيرًا

2
00:00:06,970 --> 00:00:09,230
.وزّع وزنك بالتّساوي. بالمناصفة

3
00:00:09,650 --> 00:00:12,240
عليك أن تتدرّب على هذا الشّكل
.حتّى يصبح تلقائيًّا

4
00:00:13,530 --> 00:00:14,800
.لأجل غدٍ أشرق

5
00:00:16,570 --> 00:00:19,650
.كلّ شيء لأجل الغد يا أراغاكي

6
00:00:23,290 --> 00:00:24,090
...اثنان

7
00:00:25,370 --> 00:00:26,210
...ثلاثة

8
00:00:27,370 --> 00:00:28,290
...أربعة

9
00:00:29,260 --> 00:00:30,300
...خمسة

10
00:00:30,300 --> 00:00:32,360
...حان الوقت لتدفع قسطك من الدّين

11
00:00:31,260 --> 00:00:32,290
...ستّة

12
00:00:33,440 --> 00:00:34,390
...سبعة

13
00:00:33,440 --> 00:00:36,260
.عن الأشياء الّتي خسرتُها

14
00:00:35,310 --> 00:00:36,260
...ثمانية

15
00:00:37,220 --> 00:00:38,100
...تسعة

16
00:00:42,010 --> 00:00:43,230
!جو

17
00:00:45,420 --> 00:00:47,060
إلام تنظر؟

18
00:00:49,380 --> 00:00:52,380
أنا من يجب أن تهزم، أتذكر؟

19
00:02:40,760 --> 00:02:42,210
!هيّا يا أراغاكي

20
00:02:42,210 --> 00:02:43,430
!اسحقه

21
00:02:43,430 --> 00:02:45,720
!أليس هناك ما يستطيع جو فعله يا عمّ؟

22
00:02:45,720 --> 00:02:47,570
لقد درّبت أراغاكي، أليس كذلك؟

23
00:02:47,570 --> 00:02:50,140
!يجدر بك أن تعرف نقاط ضعفه

24
00:02:50,700 --> 00:02:52,180
...كما فكّرت

25
00:02:52,710 --> 00:02:56,190
ملاكمة ميغالو الخاصّة بأراغاكي
.قد تطوّرت إلى مستوى آخر

26
00:02:56,190 --> 00:02:59,070
انظر كيف يستخدم نابض ساقيه
.الاصطناعيّتين أثناء تحريك قدميه

27
00:03:00,660 --> 00:03:02,320
،ربّما لا يملك قوّة كبيرة

28
00:03:02,320 --> 00:03:05,700
لكنّه يستطيع ردّ اللّكمات بسرعة
.فور أن ينتهي خصمه من لكمه

29
00:03:11,310 --> 00:03:12,140
...جو

30
00:03:12,630 --> 00:03:14,420
ألا يوجد سبيل حقًّا؟

31
00:03:17,590 --> 00:03:19,590
!أتينا لمشاهدة قتال

32
00:03:18,310 --> 00:03:20,150
!توقّفا عن هذا الهراء

33
00:03:20,270 --> 00:03:22,260
!هذه ليست رقصة بطيئة

34
00:03:23,100 --> 00:03:25,930
!أنت يا "بلا ترس"! قاتل كرجل

35
00:03:26,840 --> 00:03:28,970
!أحسنت يا جو! لا تفلته

36
00:03:37,030 --> 00:03:39,320
!هذا سيّئ يا عمّ

37
00:04:05,270 --> 00:04:06,430
.أبليت حسنًا

38
00:04:08,010 --> 00:04:09,280
.يكفي

39
00:04:11,100 --> 00:04:13,440
،حتّى إن واصلت القتال
.لا تملك فرصة

40
00:04:14,430 --> 00:04:18,440
إحدى واجبات المدرّب هي أن يحرص
.على أن يغادر ملاكمه الحلبة حيًّا

41
00:04:19,130 --> 00:04:20,750
!أتريد الانسحاب؟

42
00:04:21,450 --> 00:04:23,360
.جو، ثق بي

43
00:04:23,670 --> 00:04:26,300
.يمكنني أن أدبّر لك مباراةً أخرى بسرعة

44
00:04:26,300 --> 00:04:29,370
إن لم نتوقّف الآن، قد تتأذّى كثيرًا
.بحيث لن تستطيع القتال مجدّدًا

45
00:04:30,100 --> 00:04:32,250
!مؤلم، مؤلم، مؤلم! أفلتني

46
00:04:32,470 --> 00:04:35,520
!أفلتني أيّها الوغد

47
00:04:33,070 --> 00:04:35,520
.إنّه قطارٌ بسكّة واحدة وبدون محطّات وقوف

48
00:04:36,370 --> 00:04:37,170
صحيح؟

49
00:04:37,760 --> 00:04:39,580
—لـ-لكن يا فتى

50
00:04:39,580 --> 00:04:41,190
.سآخذ هذا الأمر لأبعد ما يمكن

51
00:04:42,100 --> 00:04:43,910
،إن كنت تريد اعتراض طريقي
.غادر لوحدك

52
00:04:45,100 --> 00:04:49,000
وإن لم تستطع... فاخرس وراقب
.إلام سيؤول الأمر

53
00:04:52,750 --> 00:04:54,020
!أ-أنت

54
00:04:54,020 --> 00:04:55,980
!نحن فريق في النّهاية

55
00:04:56,800 --> 00:04:59,230
.أنت متقدّم عليه
...واصل هكذا في الجولة التّالية

56
00:04:58,290 --> 00:04:59,860
.افعل ما شئت

57
00:05:05,570 --> 00:05:07,950
.وزّعه بالتّساوي... بالمناصفة

58
00:05:09,530 --> 00:05:10,580
...ذاك الـ

59
00:05:12,030 --> 00:05:15,050
هل قرّر أن يفعل ما أخبرته
تمامًا الآن بالتّحديد؟

60
00:05:18,700 --> 00:05:21,140
.وزّعه بالتّساوي... بالمناصفة

61
00:05:23,720 --> 00:05:26,730
!لن يفيدك هذا أمامي

62
00:05:33,770 --> 00:05:34,660
!لقد سقط

63
00:05:35,540 --> 00:05:36,600
...واحد

64
00:05:36,900 --> 00:05:37,760
...اثنان

65
00:05:36,900 --> 00:05:39,520
!جو! لا تقلق بشأن كيف يبدو الأمر

66
00:05:38,570 --> 00:05:39,540
...ثلاثة

67
00:05:39,540 --> 00:05:42,440
يجب أن تقترب منه قدر الإمكان
!حتّى لا تكون سرعته عاملاً مؤثّرًا

68
00:05:40,050 --> 00:05:40,850
...أربعة

69
00:05:41,530 --> 00:05:42,440
...خمسة

70
00:05:43,120 --> 00:05:43,990
...ستّة

71
00:05:43,120 --> 00:05:46,120
!إن أصبح الوضع خطيرًا، ثبّته فحسب! تماسك

72
00:05:48,460 --> 00:05:51,740
.أنت من قال أنّ الخطّة الخاصّة لن تفلح

73
00:05:54,620 --> 00:05:56,970
!تبًّا! فيمَ يفكّر؟

74
00:05:58,650 --> 00:06:01,900
.يريد جو أن يفوز بالاستعانة بما علّمته

75
00:06:14,540 --> 00:06:16,640
.لا تهدر أيّ وقتٍ غير ضروريّ في هذا

76
00:06:17,200 --> 00:06:19,310
.اقضِ عليه في الجولة التّالية

77
00:06:20,200 --> 00:06:23,370
.لا تتقدّم كثيرًا ولا تتراجع كثيرًا

78
00:06:23,730 --> 00:06:26,200
.وزّعه بالتّساوي. بالمناصفة

79
00:06:26,540 --> 00:06:29,210
عليك أن تتدرّب على هذا الشّكل
.حتّى يصبح تلقائيًّا

80
00:06:29,700 --> 00:06:32,210
!وزّعه بالتّساوي! بالمناصفة

81
00:06:35,500 --> 00:06:36,640
صعب جدًّا؟

82
00:06:37,070 --> 00:06:39,360
يدفعك للتّساءل إن كنت تريد أن تصبح
!ملاكم ميغالو حقًّا، أليس كذلك؟

83
00:06:40,670 --> 00:06:43,370
.وزّع وزنك بالتّساوي. بالمناصفة

84
00:06:43,370 --> 00:06:47,090
،مهما كانت الأوضاع صعبة الآن
،إن حافظت على شكلك

85
00:06:47,090 --> 00:06:48,900
.سيكون الغد بانتظارك

86
00:06:50,240 --> 00:06:51,460
.غد أكثر إشراقًا

87
00:06:52,290 --> 00:06:54,580
.هذا الأمر الأهمّ يا أراغاكي

88
00:06:56,040 --> 00:06:58,300
أنت، أراغاكي! هل تسمعني؟

89
00:06:58,950 --> 00:07:02,180
.لا تقلق. سأنهيه في الجولة التّالية

90
00:07:03,780 --> 00:07:06,410
.إنّه يعرف كلّ تحرّكاتك

91
00:07:06,860 --> 00:07:10,820
كما أنّه يملك الأفضليّة في السّرعة
.والمهارة. لا تستطيع هزيمته

92
00:07:11,170 --> 00:07:12,700
.يجب أن تدرك ذلك الآن

93
00:07:13,280 --> 00:07:17,520
.إنّه يريد منّي أن أشاهده وهو يسحقك

94
00:07:17,520 --> 00:07:18,400
—لذا

95
00:07:17,820 --> 00:07:19,030
.لستُ واثقًا

96
00:07:20,360 --> 00:07:23,090
...فكّرت بنفس الطّريقة في البداية

97
00:07:23,880 --> 00:07:24,950
...لكن

98
00:07:27,250 --> 00:07:29,510
.قد لا يكون ذلك صحيحًا

99
00:07:34,450 --> 00:07:37,760
بالفعل، إنّه في مستوى آخر
.عن الأشخاص الّذين قاتلتهم

100
00:07:38,530 --> 00:07:43,270
لكن أظنّ أنّه أتى للحلبة ليفوز
.بهذه المباراة، مثلي

101
00:07:47,500 --> 00:07:50,750
.وإن كان كذلك، فيستحيل أن أهرب منه

102
00:07:54,240 --> 00:07:58,290
أراغاكي... إن لم تكن تفعل
...هذا للانتقام منّي

103
00:07:58,290 --> 00:08:00,620
فلمَ تفعله...؟

104
00:08:02,850 --> 00:08:04,960
.قرّرتُ أنّني أريد سحقه

105
00:08:06,600 --> 00:08:09,740
هذا المقاتل الجديد الّذي أمضيت
.وقتك في الاعتناء به

106
00:08:13,820 --> 00:08:17,180
ما الخطب؟! هل أنت بحاجة لتزويد
تلكما السّاقين بالزّيت أو هكذا شيء؟

107
00:08:17,180 --> 00:08:19,510
!لا يمكنك أن تسحقني هكذا

108
00:08:23,710 --> 00:08:26,670
.جو، لقد أسأت الفهم يا فتى

109
00:08:27,080 --> 00:08:29,500
.كان من الخطأ قبول هذا القتال

110
00:08:31,900 --> 00:08:32,900
...لا

111
00:08:33,380 --> 00:08:37,460
...تركه يذهب إلى تلك الحرب

112
00:08:38,060 --> 00:08:41,100
...وألاّ أصدّق أنّه سيعود حيًّا

113
00:08:41,100 --> 00:08:42,910
.لقد كنت مخطئًا في كلّ ذلك

114
00:08:44,910 --> 00:08:46,580
.كنتُ أهرب

115
00:08:48,160 --> 00:08:51,950
!جو... لستَ بحاجة لتدفع ثمن ما فعلتُه

116
00:09:04,810 --> 00:09:06,250
.انتهى أمره

117
00:09:06,250 --> 00:09:07,310
!سقط

118
00:09:07,310 --> 00:09:08,040
...واحد

119
00:09:08,950 --> 00:09:09,800
...اثنان

120
00:09:10,900 --> 00:09:11,700
...ثلاثة

121
00:09:12,390 --> 00:09:13,200
...أربعة

122
00:09:14,050 --> 00:09:14,860
...خمسة

123
00:09:14,570 --> 00:09:17,170
!جو! يكفي! ابقَ ساقطًا

124
00:09:15,810 --> 00:09:16,780
...ستّة

125
00:09:17,610 --> 00:09:18,420
...سبعة

126
00:09:19,170 --> 00:09:20,060
...ثمانية

127
00:09:20,970 --> 00:09:21,790
...تسعة

128
00:09:26,430 --> 00:09:28,260
.لقد اختلطت عليك الأمور يا عمّ

129
00:09:29,530 --> 00:09:31,990
.لا أكترث بتاتًا لما حدث بينكما

130
00:09:32,430 --> 00:09:37,080
.هذا الشّخص يعترض طريقي، لذا سأهزمه

131
00:09:39,080 --> 00:09:40,040
لماذا؟

132
00:09:45,180 --> 00:09:46,440
!لمَ تقف؟

133
00:09:53,660 --> 00:09:55,680
!وزّعه بالتّساوي... بالمناصفة

134
00:10:01,020 --> 00:10:02,880
.وزعه بالتّساوي، بالمناصفة

135
00:10:02,880 --> 00:10:03,700
!اخرس

136
00:10:10,200 --> 00:10:12,000
.وزعه بالتّساوي، بالمناصفة

137
00:10:12,420 --> 00:10:15,480
!أخبرتك أن تخرس

138
00:10:31,350 --> 00:10:32,280
!لقد سقط

139
00:10:38,700 --> 00:10:39,500
...واحد

140
00:10:40,590 --> 00:10:41,520
...اثنان

141
00:10:42,600 --> 00:10:43,440
...ثلاثة

142
00:10:44,450 --> 00:10:45,280
...أربعة

143
00:10:46,360 --> 00:10:47,160
...خمسة

144
00:10:52,990 --> 00:10:53,790
...اثنان

145
00:10:54,970 --> 00:10:55,770
...ثلاثة

146
00:10:56,850 --> 00:10:57,650
...أربعة

147
00:10:57,080 --> 00:10:58,750
!عـ-عمّ

148
00:10:58,750 --> 00:10:59,590
...خمسة

149
00:10:59,090 --> 00:11:01,270
!أراغاكي! انهض

150
00:11:00,520 --> 00:11:01,270
...ستّة

151
00:11:02,220 --> 00:11:03,100
...سبعة

152
00:11:03,890 --> 00:11:04,690
...ثمانية

153
00:11:17,820 --> 00:11:19,070
.فهمت

154
00:11:25,650 --> 00:11:27,100
.تنفّس بعمق

155
00:11:28,390 --> 00:11:31,060
.تبدو غير متّزن وتهمل دفاعك

156
00:11:31,550 --> 00:11:34,340
عليك أن تتذكّر الأساسيّات
!عندما تشعر بالإنهاك

157
00:11:34,870 --> 00:11:37,360
أواثق من هذا؟
أتريدني أن أفوز حقًّا؟

158
00:11:38,250 --> 00:11:41,390
.نعم... بكلّ تأكيد

159
00:11:42,280 --> 00:11:44,930
.لا تدع ذلك يؤثّر بك
.لقد كانت لكمة حظّ فحسب

160
00:11:46,250 --> 00:11:47,060
...لا

161
00:11:47,700 --> 00:11:49,100
.لقد سدّدها بعد تخطيط

162
00:11:49,480 --> 00:11:51,490
...لم يدع الفرصة تفلت

163
00:11:51,890 --> 00:11:54,320
.وحافظ على وقفته أيضًا

164
00:11:54,800 --> 00:11:56,920
.حتّى إن كان الأمر كذلك، فات الأوان

165
00:11:56,920 --> 00:11:58,820
.مثابرته هي ما تبقيه واقفًا فحسب

166
00:11:59,300 --> 00:12:02,580
.اذهب واكسر روحه القتاليّة

167
00:12:06,400 --> 00:12:08,620
.ذاك الفتى مبهر حقًّا

168
00:12:09,500 --> 00:12:11,150
...جو فهم بالفعل

169
00:12:11,730 --> 00:12:15,630
أنّ الأشياء الّتي كان يتمرّن عليها
...كلّ يوم ويحشدها في صميمه

170
00:12:16,080 --> 00:12:21,130
ستخرج من قوقعتها في النّهاية
.وتؤتي بثمارها الحقيقيّة

171
00:12:21,130 --> 00:12:23,130
.وزّعه بالتّساوي. بالمناصفة

172
00:12:33,290 --> 00:12:35,550
!أحسنت! أنهكه

173
00:12:37,270 --> 00:12:38,150
!لماذا؟

174
00:12:38,710 --> 00:12:40,650
.جو متحمّل إلى أقصى حد

175
00:12:40,980 --> 00:12:45,950
لقد نجى من قتالات في الحلبة
.السّرّيّة بترسٍ بلا نفعٍ في الأساس

176
00:12:46,570 --> 00:12:49,660
،مهما تلقّى من ضرب
.لن يكسر ذلك روحه القتاليّة

177
00:12:50,510 --> 00:12:53,920
.حاليًّا، إنّه أشبه بقطعة حديد حمراء ساخنة

178
00:12:53,920 --> 00:12:56,220
.كلّما ضربتها، أصبحت أصلب

179
00:13:11,530 --> 00:13:13,170
!انظر يا عمّ

180
00:13:13,170 --> 00:13:14,020
.أنا أنظر

181
00:13:24,480 --> 00:13:27,350
.كلّ شيء لأجل الغد يا أراغاكي

182
00:13:30,920 --> 00:13:33,200
.هذه المباراة لكي تمضي قدمًا

183
00:13:34,370 --> 00:13:35,290
أليس كذلك؟

184
00:13:35,290 --> 00:13:36,290
!أراغاكي

185
00:13:48,990 --> 00:13:50,890
!هيّا! هيّا

186
00:14:44,730 --> 00:14:45,710
هل تؤلمك؟

187
00:14:47,100 --> 00:14:48,500
.ليس بما يكفي لإزعاجي

188
00:14:51,600 --> 00:14:53,760
لأجل الغد...؟

189
00:14:58,030 --> 00:14:59,040
...مياغي-سان

190
00:15:04,210 --> 00:15:05,040
.حسنًا

191
00:15:22,140 --> 00:15:23,990
.لقد انسحب أراغاكي من هذه المباراة

192
00:15:23,990 --> 00:15:26,480
...بضربة قاضية فنيّة في ختام الجولة الرّابعة

193
00:15:26,480 --> 00:15:29,790
!"الفائز هو جو "بلا ترس

194
00:15:34,920 --> 00:15:35,830
هل فزنا؟

195
00:15:36,490 --> 00:15:37,380
.نعم

196
00:15:38,190 --> 00:15:39,120
!جو

197
00:15:39,340 --> 00:15:40,790
!لقد فزنا! لقد فزنا

198
00:15:40,790 --> 00:15:42,940
!جو، فزنا بالمباراة

199
00:15:43,770 --> 00:15:45,230
!أجل

200
00:15:44,130 --> 00:15:45,230
...صحيح

201
00:15:47,180 --> 00:15:48,820
!نجحت يا جو

202
00:15:47,500 --> 00:15:50,240
!"جو "بلا ترس"! جو "بلا ترس

203
00:15:48,280 --> 00:15:49,310
.فزنا

204
00:15:51,090 --> 00:15:52,510
!"جو "بلا ترس

205
00:15:52,510 --> 00:15:54,090
!أراغاكي

206
00:16:07,480 --> 00:16:08,820
.آسف

207
00:16:09,280 --> 00:16:10,740
.لست بحاجة للاعتذار

208
00:16:12,760 --> 00:16:14,460
هل ظننت أنّني لن ألحظ؟

209
00:16:15,730 --> 00:16:18,980
!إن لم تتكلّم، لكنت أوقفت المباراة

210
00:16:21,880 --> 00:16:23,720
.أنا مدرّبك

211
00:16:24,420 --> 00:16:28,920
آخر ما أريد هو ألاّ يستطيع
.ملاكمي السّير مجدّدًا

212
00:16:31,090 --> 00:16:35,530
.لا شيء يستدعي الخجل
.لقد كان قتالاً أخيرًا مدهشًا

213
00:16:44,270 --> 00:16:45,440
...أنت

214
00:16:46,150 --> 00:16:47,390
.هيّا، فلنخرج

215
00:16:50,950 --> 00:16:52,160
.أقدّر ذلك

216
00:16:52,670 --> 00:16:53,750
.لا بأس

217
00:17:08,740 --> 00:17:10,750
...لقد تأذّيت حقًّا

218
00:17:11,110 --> 00:17:11,910
.نعم

219
00:17:12,430 --> 00:17:17,260
قال الأطبّاء أنّني أخاطر بنفسي
...وقد أصبح طريح الفراش

220
00:17:18,060 --> 00:17:20,720
.لكنّني واجهت وقتًا صعبًا في استدراك الأمر

221
00:17:21,920 --> 00:17:26,560
...عندما سمعت عنك وجو
.شعرتُ وكأنّها فرصة لوضع خاتمة للأمر

222
00:17:28,280 --> 00:17:31,310
.كنت سأضع نهاية لكلّ ذلك
.أقصد، كلّ شيء

223
00:17:32,680 --> 00:17:39,870
،لكن عندما رأيتك مجدّدًا
.لم أعد واثقًا ممّا أريد

224
00:17:41,500 --> 00:17:45,760
.كنتُ أحاول اكتشاف ذلك الجواب مذ التقينا

225
00:17:47,470 --> 00:17:48,740
وهل اكتشفتَه؟

226
00:17:51,740 --> 00:17:53,320
.أخبرني جو بشيء

227
00:17:53,920 --> 00:17:55,660
فال إنّني أستطيع أن ألوم
،أيّا كان على مشاكلي

228
00:17:55,660 --> 00:17:58,170
.لكن في النّهاية، أنا من أتّخذ القرار

229
00:17:59,790 --> 00:18:03,950
.لقد اخترتُ الطّريق الّذي قاد بي إلى هنا
.لم أعد أمقت أيّ أحد

230
00:18:04,640 --> 00:18:05,990
...ليس أنت

231
00:18:07,550 --> 00:18:09,120
...ولا حتّى نفسي

232
00:18:12,980 --> 00:18:14,450
.سأمضي قدمًا

233
00:18:15,480 --> 00:18:19,320
.بالنّسبة لي... الغد يبدأ اليوم

234
00:18:22,190 --> 00:18:24,800
...وصلت إلى هذا الحدّ بهاتين السّاقين

235
00:18:26,850 --> 00:18:30,840
هذا... يكفي، أليس كذلك يا نانبو-سان؟

236
00:18:32,700 --> 00:18:33,530
.نعم

237
00:18:34,830 --> 00:18:38,730
.كان من الجيّد أن أشاهد ملاكمة ميغالو خاصّتك

238
00:18:42,950 --> 00:18:46,560
هلاّ أعطيت هذه لجو؟

239
00:18:50,410 --> 00:18:51,230
...أنت

240
00:18:53,100 --> 00:18:54,620
هل احتفظت بهذه؟

241
00:19:00,190 --> 00:19:02,230
.سأذهب غدًا

242
00:19:02,740 --> 00:19:03,580
...فهمت

243
00:19:06,150 --> 00:19:06,960
.خذ

244
00:19:08,250 --> 00:19:09,160
ماذا؟

245
00:19:09,660 --> 00:19:13,740
كنتُ آمل أن أعزمك على عشاء
.جيّد قبل مغادرتك

246
00:19:14,140 --> 00:19:16,930
،لذا راهنت بكلّ المال الّذي أملك
...آملاً قلب الأوضاع

247
00:19:16,930 --> 00:19:18,930
.واحزر ماذا، لقد خسرت

248
00:19:20,680 --> 00:19:23,470
.بالمختصر... إنّها كتميمة حظّ

249
00:19:24,460 --> 00:19:27,600
.فلنأمل أنّها ستجنّبك الطّلقات

250
00:19:28,690 --> 00:19:30,460
.يجب أن تترك خزانتك كما هي

251
00:19:30,900 --> 00:19:33,910
.هذا بيتك. تذكّر ذلك

252
00:19:34,550 --> 00:19:36,050
.سأكون في انتظارك

253
00:19:37,470 --> 00:19:38,360
.نعم

254
00:19:39,250 --> 00:19:42,200
.تلك التّذكرة أنقذت حياتي

255
00:19:56,110 --> 00:19:58,470
أنتما ذاهبان للمشاركة في ميغالونيا، صحيح؟

256
00:20:07,030 --> 00:20:08,190
.نعم

257
00:20:08,190 --> 00:20:09,880
...أخبر جو بشيء عنّي

258
00:20:10,980 --> 00:20:13,250
.أنا أؤمن به أيضًا

259
00:20:27,690 --> 00:20:31,130
...اللّيلة، سوف نعلن عن المنافس الثّالث

260
00:20:31,130 --> 00:20:33,410
!ليحجز لنفسه مكانًا في منافسات ميغالونيا

261
00:20:34,780 --> 00:20:38,920
...يوري وبيبي إغليسياس والآن

262
00:20:42,350 --> 00:20:43,990
...مع فريق القنبلة القاتلة

263
00:20:45,580 --> 00:20:47,270
!غلين باروز

264
00:20:50,570 --> 00:20:56,020
أسلوب قتال المتنافس باروز الهادر
."أكسبه لقب "الأسد الدّمويّ

265
00:20:56,020 --> 00:20:57,150
.إنّه ملاكم من الوزن الثّقيل

266
00:20:57,820 --> 00:20:59,530
،يزيد طوله عن مترين

267
00:20:59,530 --> 00:21:01,640
،وبأسلوب قتاله الّذي يؤكّد القوّة والرّشاقة

268
00:21:01,640 --> 00:21:05,150
استطاع إبراز نفسه بشكلٍ فريد
،في ملاكمة ميغالو

269
00:21:05,560 --> 00:21:08,160
حيث يُعتبر أنّ ملاكمي الوزن
.المتوسّط يملكون الأفضليّة

270
00:21:12,050 --> 00:21:15,340
.أقلّ من شهرٍ يفصلنا عن انطلاقة ميغالونيا

271
00:21:15,340 --> 00:21:18,170
،متى سيتمّ الإعلان عن الملاكم الأخير
وما هي المعايير؟

272
00:21:18,460 --> 00:21:20,260
،بعد مراجعة شاملة

273
00:21:20,260 --> 00:21:22,980
.سوف نعلن عن المشارك الأخير

274
00:21:22,980 --> 00:21:25,430
ما هي فرص مشاركة جو "بلا ترس"؟

275
00:21:25,430 --> 00:21:28,610
لقد هزم أراغاكي، أحد المفضّلين
.لنيل خانة المشاركة مؤخّرًا

276
00:21:31,120 --> 00:21:33,930
.الجميع مؤهّلون للقتال في ميغالونيا

277
00:21:33,930 --> 00:21:38,690
،أؤكّد لكم، فور أن يتمّ اختيار المرشّح
.سيتمّ إعلامكم على الفور

278
00:21:41,470 --> 00:21:43,860
.الملل بادٍ عليك يا يوري

279
00:21:44,630 --> 00:21:45,650
...ميكيو

280
00:21:46,380 --> 00:21:48,450
.باروز يملك حظًّا بائسًا

281
00:21:49,440 --> 00:21:53,430
.الجمهور مركّز على ملاكم نكرة بدلاً من مشاركته

282
00:22:07,530 --> 00:22:08,590
...إنّه هو

283
00:22:09,380 --> 00:22:11,180
.أخبرتني يوكيكو بما حدث

284
00:22:11,610 --> 00:22:14,430
.يبدو أنّ هناك تصفية حسابات بينكما

285
00:22:15,770 --> 00:22:19,740
الملاكم الغامض الّذي يدخل حلبة
...ملاكمة ميغالو دون أيّ تعزيز

286
00:22:19,740 --> 00:22:21,100
."جو "بلا ترس

287
00:22:21,490 --> 00:22:22,950
.إنّه ذو شعبيّة كبيرة

288
00:22:24,660 --> 00:22:25,710
...جو

289
00:22:28,310 --> 00:22:30,420
.لكنّ ذلك سينتهي قريبًا

290
00:22:31,240 --> 00:22:35,260
.ميغالونيا ليست مكانًا للكلاب الضّالة

291
00:22:37,040 --> 00:22:40,040
...ليس ميّتًا بعد