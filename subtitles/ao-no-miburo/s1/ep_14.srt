1
00:00:00,900 --> 00:00:04,400
نحتاج إلى مائتين وخمسين ريو
لأجل المعاطف المُوحّدة؟

2
00:00:04,860 --> 00:00:06,000
كم يبلغ نصيب الواحد منّا إذن؟

3
00:00:06,000 --> 00:00:07,310
.لا أملك أدنى فكرةٍ

4
00:00:07,860 --> 00:00:11,240
،لم يبقَ أمامنا إلّا خيارٌ واحد
.التوجّه إلى المدينة وجني المال

5
00:00:12,950 --> 00:00:15,290
،إذن
...من تتوقّعون أنّه سيكون

6
00:00:16,130 --> 00:00:17,870
الأكثر كسبًا بيننا؟

7
00:00:18,060 --> 00:00:19,320
!انتظروا

8
00:00:21,450 --> 00:00:23,790
.سأكون أنا بالتّأكيد

9
00:00:25,560 --> 00:00:28,170
.المال، المال

10
00:00:28,950 --> 00:00:30,640
.حسنًا، لننطلق

11
00:00:30,640 --> 00:00:32,800
.مـ-مهلًا يا هيجيكاتا

12
00:00:32,960 --> 00:00:35,520
ماذا لو صادفنا جماعة الريسّيدان؟

13
00:00:38,380 --> 00:00:39,060
.اقتلوهم

14
00:00:39,060 --> 00:00:40,020
!وكأنّ بمقدورنا ذلك

15
00:00:51,740 --> 00:00:56,040
ذئاب ميبو الزّرق

16
00:02:15,020 --> 00:02:16,530
،حسنًا
ماذا علينا أن نفعل؟

17
00:02:16,840 --> 00:02:19,240
أَتقصد أن لا فكرة لديك أنت أيضًا؟

18
00:02:19,670 --> 00:02:22,590
أين عسانا نعمل سوى
في دُكّان تشيرينويا؟

19
00:02:22,590 --> 00:02:23,400
دُكّان الجدّة؟

20
00:02:23,570 --> 00:02:27,290
،سنمرح، وننال الثّناء
.ونقبض الثّمن

21
00:02:27,290 --> 00:02:28,620
أيّ عيبٍ تجدونه في ذلك؟

22
00:02:30,000 --> 00:02:32,120
—لا أعلم، فالجدّة ليست حقًا

23
00:02:32,120 --> 00:02:32,620
ماذا؟

24
00:02:32,620 --> 00:02:34,070
.هيّا، كفاكما تردّدًا

25
00:02:34,070 --> 00:02:35,420
أنا أيضًا؟

26
00:02:37,090 --> 00:02:38,800
.كُفّوا عن هذا الدّلال الصبيانيّ

27
00:02:38,980 --> 00:02:39,680
ماذا؟

28
00:02:39,840 --> 00:02:40,550
أرأيتما؟

29
00:02:40,550 --> 00:02:42,200
تبغون المال؟

30
00:02:42,200 --> 00:02:44,760
.للأسف... ستعملون بلا أُجرةٍ

31
00:02:44,760 --> 00:02:48,320
!أرجوكِ
،سنكدح حتّى ينقطع نفسنا

32
00:02:48,320 --> 00:02:50,680
.كُلّ ما نرجوه مبلغٌ زهيد

33
00:02:50,680 --> 00:02:53,560
،لكم أن تعملوا
.لكنّي لن أدفع لكم

34
00:02:53,920 --> 00:02:58,330
!ولا حتّى مونًا واحدًا
.هكذا تكون العلاقات العائليّة

35
00:02:58,330 --> 00:02:59,980
أيّ منطقٍ هذا؟

36
00:02:59,980 --> 00:03:02,280
لا تنتظروا مِن الدّنيا أن تُهديكم
!المَطالب على طبقٍ مِن ذهب

37
00:03:02,280 --> 00:03:04,000
تشيرينويا

38
00:03:02,480 --> 00:03:05,200
،إن كنتم تَبغون المال
!فاقصدوا مكانًا آخر

39
00:03:09,540 --> 00:03:11,700
!أيّتها الجدّة

40
00:03:12,090 --> 00:03:14,560
.لا تزال مُتمسّكةً بعقليّةٍ بالية

41
00:03:15,240 --> 00:03:16,800
.أنا لا تربطني بها صلة قرابةٍ حتّى

42
00:03:16,800 --> 00:03:19,190
مـ-ما العمل الآن يا نيو؟

43
00:03:19,190 --> 00:03:21,960
سيريزاوا-سينسي سيُذيقني الويل
.إن عُدت خالي الوفاض

44
00:03:22,230 --> 00:03:24,320
.لهذا السبّب علينا البحث عن عملٍ

45
00:03:24,320 --> 00:03:26,640
!هلكنا، هلكنا لا محالة

46
00:03:28,750 --> 00:03:29,970
.لا تقلقا

47
00:03:30,210 --> 00:03:32,690
سنجد مخرجًا ما دُمنا معًا
.نحن الثّلاثة

48
00:03:33,170 --> 00:03:36,400
!أهلًا بكم، هلمّوا بالدّخول

49
00:03:36,400 --> 00:03:37,400
.متفائلٌ ميؤوس منك

50
00:03:38,160 --> 00:03:39,850
.رائحةٌ شهيّة

51
00:03:40,120 --> 00:03:42,040
،بالمُناسبة
.لم أتناول إفطاري بعد

52
00:03:42,040 --> 00:03:44,270
!تارو-كون، ستتخلّف عنّا

53
00:03:50,060 --> 00:03:53,050
،ماذا؟ إن كان لديك ما تبوح به
.فأَفصح عنه

54
00:03:53,600 --> 00:03:55,050
،صحيحٌ

55
00:03:56,340 --> 00:03:59,900
ما رأيك في
إعادة عصر السّاموراي"؟"

56
00:04:00,170 --> 00:04:02,640
ماذا؟
أَتقصد جماعة الريسّيدان؟

57
00:04:04,480 --> 00:04:08,300
هل هم جادّون حقًا في رغبتهم
للعودة بالزّمن إلى عصر الحُروب؟

58
00:04:08,750 --> 00:04:10,400
.أضغاث أحلامٍ

59
00:04:11,310 --> 00:04:12,770
.فأمرٌ كهذا لا يمتّ للواقع بصلةٍ

60
00:04:13,040 --> 00:04:13,570
.أجل

61
00:04:14,480 --> 00:04:15,720
،وثمّة أمرٌ آخر

62
00:04:16,360 --> 00:04:20,280
،"سألوني عن جوهر "السّيف
فما رأيك أنت يا هاجيمي-كون؟

63
00:04:23,160 --> 00:04:26,360
كيف لي أن أغدو ساموراي مثلك؟

64
00:04:28,800 --> 00:04:30,100
.كن قوّيًا

65
00:04:35,380 --> 00:04:37,350
أليس هذا بديهيًا؟
.القوّة هي كُلّ شيءٍ

66
00:04:38,020 --> 00:04:38,760
القوّة؟

67
00:04:39,620 --> 00:04:42,410
.فهمت، هذا ردٌ يشبهك تمامًا

68
00:04:42,410 --> 00:04:45,510
انظرا، وجدت فطيرة
!كاشيوا موتشي مُلقاةً على الأرض

69
00:04:46,010 --> 00:04:47,990
إلى أين أنت ذاهبٌ يا هاجيمي؟

70
00:04:48,680 --> 00:04:50,270
.لا يتبعني أحدٌ منكما

71
00:04:51,770 --> 00:04:55,360
فهمت، تُريد نصيبك مِن
الموتشي أيضًا، أليس كذلك؟

72
00:04:55,730 --> 00:04:58,890
.حسنًا، سأُقاسمك فطيرتي

73
00:04:58,090 --> 00:05:01,100
نيو، أنا سعيدٌ حقًا
.لأنّني التقيت بك

74
00:05:01,460 --> 00:05:01,900
ماذا؟

75
00:05:03,280 --> 00:05:04,220
هاجيمي-كون؟

76
00:05:06,140 --> 00:05:07,120
.لا تتبعني

77
00:05:08,750 --> 00:05:11,600
ما خطبك؟
ألا تُريد نصيبًا منها؟

78
00:05:16,240 --> 00:05:17,560
.سيريزاوا-سينسي

79
00:05:17,560 --> 00:05:20,880
ما رأيك أن نقترض بعض المال مِن
إحدى هذه الدّكاكين ونذهب للشّرب؟

80
00:05:21,140 --> 00:05:24,390
،فكرةٌ سديدة
.فجني المال ليس بالمُعضلة

81
00:05:24,390 --> 00:05:25,630
.أيّها الحمقى

82
00:05:26,870 --> 00:05:30,260
كيف للسّاموراي أن
يكسبوا قُوت يومهم؟

83
00:05:30,590 --> 00:05:31,640
.بالسّيف طبعًا

84
00:05:36,640 --> 00:05:39,900
،سنتحدّى أرباب الدُوجو
.ونُرغمهم على الدّفع

85
00:05:46,040 --> 00:05:48,540
،شينباتشي
كم تملك مِن المال؟

86
00:05:49,480 --> 00:05:51,110
...دعني أرى

87
00:05:52,210 --> 00:05:54,320
ما يكفي لشراء طبقين
.مِن السّوبا السّاخنة لنا

88
00:05:55,920 --> 00:05:56,810
ما العمل الآن؟

89
00:05:58,370 --> 00:05:59,320
.مقصدنا إلى هناك

90
00:06:00,920 --> 00:06:03,420
دكّان الرّهن

91
00:06:03,700 --> 00:06:04,640
.أعد ما قُلته لتوّك

92
00:06:05,430 --> 00:06:08,170
أَرهنت سيفك مُقابل عشرة ريو؟

93
00:06:09,630 --> 00:06:11,720
.سأستردّه حالما أغدو فاحش الثّراء

94
00:06:11,720 --> 00:06:15,150
ماذا ستفعل؟
.سيف السّاموراي هو رُوحه وحياته

95
00:06:16,140 --> 00:06:18,850
.السّاموراي لا يأبهون بصغائر الأمور

96
00:06:21,230 --> 00:06:25,880
سنُذهل الجميع حينما نَجني مائتين
!وخمسين ريو في ليلةٍ واحدة

97
00:06:27,320 --> 00:06:29,500
.أنت لست ساموراي

98
00:06:32,080 --> 00:06:32,660
ماذا؟

99
00:06:37,600 --> 00:06:38,670
ما الّذي تفوّهت به لتوّك؟

100
00:06:52,190 --> 00:06:54,220
،أعتذر منك، زلّ لساني

101
00:06:54,580 --> 00:06:55,530
.فاغفر لي

102
00:07:00,880 --> 00:07:02,720
.لا بأس عندي

103
00:07:02,720 --> 00:07:04,780
فأنت لا تجد غضاضةً
.في الاعتذار أبدًا

104
00:07:04,780 --> 00:07:08,910
.وهذا ما يُعجبني فيك يا شينباتشي

105
00:07:09,630 --> 00:07:11,600
.كلا، أنا نادمٌ بصدقٍ

106
00:07:12,880 --> 00:07:14,630
والآن، ما هي غايتك؟

107
00:07:14,810 --> 00:07:16,890
وبأيّ شيءٍ خاطرت لأجل سيفك؟

108
00:07:17,420 --> 00:07:20,880
ألم يتّضح لك الأمر بعد؟ معي بعض
.المال، وسأمضي الآن لمُضاعفته

109
00:07:21,200 --> 00:07:22,280
معذرةً؟

110
00:07:24,290 --> 00:07:25,540
!أُلقيت النّرد

111
00:07:25,720 --> 00:07:27,800
!فرديٌ

112
00:07:26,240 --> 00:07:29,170
!زوجيٌ

113
00:07:30,420 --> 00:07:31,510
.هيّا

114
00:07:31,510 --> 00:07:32,400
أيّهما سيظهر؟

115
00:07:38,240 --> 00:07:39,590
!واحدٌ واثنان، فرديٌ

116
00:07:40,400 --> 00:07:41,440
أَكان فرديًا؟

117
00:07:41,440 --> 00:07:42,900
!خسرنا كُلّ شيءٍ

118
00:07:43,200 --> 00:07:44,220
.مُجرّد حمقى سُذّجٍ

119
00:07:44,750 --> 00:07:45,380
.صيدٌ سهل

120
00:07:45,870 --> 00:07:47,400
.حان وقت سلبهم كُلّ ما يملكون

121
00:07:48,470 --> 00:07:50,100
.راقب ما سيحدث فحسب

122
00:07:50,100 --> 00:07:52,820
.سانوسكي، علينا التوقّف الآن

123
00:07:53,000 --> 00:07:53,870
ماذا؟

124
00:07:54,550 --> 00:07:59,590
انسَ أمر استرداد سيفك، سنخسر آخر
.ما نملك إن تمادينا في هذا العبث

125
00:08:01,300 --> 00:08:02,800
،إنه لأمرٌ مُؤسف
.لكن للضّرورة أحكامًا

126
00:08:02,800 --> 00:08:05,080
،سُحقًا
.هذه هي النّهاية إذن

127
00:08:05,080 --> 00:08:06,210
،أيّها الشّباب

128
00:08:06,920 --> 00:08:11,360
لا ينبغي لكم التّراجع
.بعد دُخول المُعترك

129
00:08:12,570 --> 00:08:15,360
،الرّجل يُقاتل حتّى ينتصر

130
00:08:15,360 --> 00:08:18,640
فالمعركة لا تنتهي إلّا
.إذا أقررتم بالهزيمة

131
00:08:20,010 --> 00:08:22,210
...أيّها العجوز، أنت

132
00:08:23,500 --> 00:08:26,640
!خسرت كُلّ ما تملك بالفعل

133
00:08:26,640 --> 00:08:27,920
!كلا

134
00:08:27,920 --> 00:08:31,650
!النّصر لا يزال يَلوح في الأفق

135
00:08:31,910 --> 00:08:33,400
!أيّها العجوز الأحمق

136
00:08:35,170 --> 00:08:38,160
سوجي، أَموقنٌ أنت
بما تعتزم فعله؟

137
00:08:38,430 --> 00:08:39,570
.لا بأس

138
00:08:39,800 --> 00:08:43,740
،يلزمنا تأمين معاطف للجميع
.والمُضطرّ لا يملك خيارًا

139
00:08:44,150 --> 00:08:45,120
...ولكن

140
00:08:45,400 --> 00:08:47,300
،هذا الغرض ثمينٌ عندك
أليس كذلك؟

141
00:08:47,760 --> 00:08:49,550
.حملته معك طوال الطّريق مِن إيدو

142
00:08:49,550 --> 00:08:51,040
أَتريد بيعه حقًا؟

143
00:08:52,670 --> 00:08:53,460
.هيسكي

144
00:08:53,740 --> 00:09:00,940
،أعلم أن هذا خطأٌ، لكن في أعماقي
...ثمّة جزءٌ لا يزال يتوق

145
00:09:00,940 --> 00:09:02,610
.لعصر السّاموري

146
00:09:03,720 --> 00:09:04,550
...أَتقصد

147
00:09:05,690 --> 00:09:08,690
كتبٌ
مُصوّرة

148
00:09:06,200 --> 00:09:08,690
.هذا لا يصلح يا سيّدي

149
00:09:08,880 --> 00:09:09,520
ماذا؟

150
00:09:09,960 --> 00:09:11,440
عمّا تتحدّث؟

151
00:09:11,600 --> 00:09:14,440
،لا جدوى منه
.لا أقدر على منحك الكثير لقاءه

152
00:09:14,440 --> 00:09:16,360
أأنت مجنونٌ يا سيّدي؟

153
00:09:16,650 --> 00:09:19,920
أَلديك أدنى فكرةٍ عمّا كابدته
لأجل جلبه إلى هنا؟

154
00:09:20,120 --> 00:09:23,500
بل عليك أن تمتنّ لي
.لأنّني سأشتريه منك أصلًا

155
00:09:23,680 --> 00:09:26,200
لماذا لا تُقدّر جودته؟

156
00:09:26,490 --> 00:09:28,830
!أَعميت بصيرتك؟

157
00:09:29,040 --> 00:09:32,920
،على رسلك
.لا أحد سيشتري هذه الخلاعة

158
00:09:32,920 --> 00:09:35,340
أخاطيبٌ؟ أم محارٌ؟
.إنّه أمرٌ سخيف

159
00:09:36,220 --> 00:09:38,720
!أنا لا أتحدّث عن الواقعيّة

160
00:09:38,890 --> 00:09:42,350
تقدير الفنّ الغراميّ يتطلب خيالًا
!واسعًا، عليك أن ترى ببصيرتك

161
00:09:42,350 --> 00:09:43,820
!أَغضبتني الآن

162
00:09:44,280 --> 00:09:46,080
!لن أبيع شيئًا لهذا الدُكّان البائس

163
00:09:47,660 --> 00:09:48,790
لن تفعل إذن؟

164
00:09:49,920 --> 00:09:51,890
.سأكسب المال بطريقةٍ شريفة

165
00:09:52,760 --> 00:09:55,590
،أو هكذا أقول
لكن كيف السّبيل إلى ذلك؟

166
00:09:55,590 --> 00:09:56,820
.أنت تُعيق السّير

167
00:09:57,280 --> 00:09:58,840
.لا تقف هنا هكذا

168
00:09:58,840 --> 00:09:59,590
،معذرةً

169
00:10:03,960 --> 00:10:06,170
هل مِن أحدٍ هنا في ضيقٍ؟

170
00:10:06,840 --> 00:10:09,420
أودّ أن أُسدي معروفًا
.لأحدهم ما دمت هنا

171
00:10:13,670 --> 00:10:17,170
المُكافأة: ريوان اثنان     تاما
يُرجى البحث عن هذه القطّة
إيروريّا

172
00:10:15,440 --> 00:10:16,660
قطّةٌ مفقودة؟

173
00:10:18,000 --> 00:10:19,500
.هذا يفي بالغرض تمامًا

174
00:10:19,720 --> 00:10:22,680
،أو بالأحرى
.لا بُدّ أنّ الأمر محزنٌ للغاية

175
00:10:23,610 --> 00:10:27,190
ولكن، قطّةٌ واحدة في
مدينة بهذا الاتّساع؟

176
00:10:27,190 --> 00:10:29,680
أشكّ في أنّ العثور عليها
.سيكون أمرًا سهلًا

177
00:10:34,280 --> 00:10:36,200
المُكافأة: ريوان اثنان     تاما
يُرجى البحث عن هذه القطّة
إيروريّا

178
00:10:37,670 --> 00:10:39,160
!تاما

179
00:10:42,300 --> 00:10:43,040
!انتظري

180
00:10:43,410 --> 00:10:44,780
!أفسحوا الطّريق

181
00:10:45,200 --> 00:10:47,200
!تاما

182
00:10:51,890 --> 00:10:54,290
تمكّنت مِن إعادته
،إلى الغمد بطريقةٍ ما

183
00:10:54,760 --> 00:10:56,410
.لكن لا أمل في إصلاحه

184
00:10:57,120 --> 00:10:58,370
.فقد اعوجّ بشكلٍ كامل

185
00:10:59,260 --> 00:11:03,260
رُغم ذلك، أوصت أُختي بصنعه
.لي خصّيصًا قُبيل رحيلي عن تاما

186
00:11:10,220 --> 00:11:11,970
.سُحقًا لذلك اللّعين ناووزومي

187
00:11:13,280 --> 00:11:14,990
،قبل أن أقلق بشأن المال

188
00:11:15,370 --> 00:11:16,720
.يلزمني سيفٌ جديد

189
00:11:18,240 --> 00:11:26,740
دُكّان
إله السّيوف

190
00:11:18,420 --> 00:11:22,990
!أَتريد عشرة ريو لقاء هذا؟
.لا بُدّ أنّك تمزح

191
00:11:22,990 --> 00:11:25,340
،ألقِ نظرةً عليه
.تلف نصله واعوجّ تمامًا

192
00:11:25,870 --> 00:11:26,740
،معك حقٌّ

193
00:11:27,240 --> 00:11:28,770
.بالغت في مَطلبي

194
00:11:30,720 --> 00:11:32,000
.إذن، قايضني به

195
00:11:32,350 --> 00:11:33,190
ماذا عن ذاك السّيف؟

196
00:11:35,150 --> 00:11:35,670
ماذا؟

197
00:11:35,890 --> 00:11:38,090
!هذا سيف يُوكيهيرا مِن بونغو

198
00:11:38,090 --> 00:11:40,800
!لن أبيعه ولو بمال الدّنيا كُلّها

199
00:11:45,110 --> 00:11:48,010
،على أيّ حالٍ
كم تبلغ ميزانيّتك؟

200
00:11:48,440 --> 00:11:49,270
مالٌ؟

201
00:11:49,870 --> 00:11:53,190
عُذرًا، لا أملك الكثير
.في جُعبتي حاليًا

202
00:11:57,320 --> 00:11:59,280
،إذا كان غرضك التفرّج فحسب
!فارحل إلى دُكّانٍ آخر

203
00:12:00,100 --> 00:12:01,360
ما بال هذا الرّجل؟

204
00:12:02,220 --> 00:12:06,450
لن أخرج بطائلٍ مِن هنا، فهؤلاء يُثمّنون
.اسم الصّانع وشُهرته، لا كفاءة السّيف نفسه

205
00:12:06,780 --> 00:12:07,650
.أنت، أعرني انتباهك

206
00:12:12,250 --> 00:12:14,920
مَن هذا؟
.يبدو رثّ الهيئة

207
00:12:18,760 --> 00:12:19,750
.ابقَ بعيدًا

208
00:12:23,680 --> 00:12:24,760
.أرني وجهك

209
00:12:28,480 --> 00:12:29,390
امرأةٌ؟

210
00:12:30,390 --> 00:12:34,020
أنت مِن جماعة الميبورو، أليس كذلك؟
.هيجيكاتا-سان مِن المِيبورو

211
00:12:34,330 --> 00:12:36,180
صحيحٌ، كيف عرفتِ؟

212
00:12:36,540 --> 00:12:38,030
.في حوزتي سيفٌ جيّد

213
00:12:38,400 --> 00:12:40,280
.وأُريد منك أن تستخدمه

214
00:12:40,280 --> 00:12:42,780
حقًا؟

215
00:12:43,330 --> 00:12:45,230
لديكِ سيفٌ تُريدين منّي استخدامه؟

216
00:12:45,230 --> 00:12:47,840
،صحيحٌ يا هيجيكاتا-سان

217
00:12:47,840 --> 00:12:49,020
.أنت بالذّات دُون غيرك

218
00:12:49,020 --> 00:12:50,500
.مهلًا، ابتعدي قليلًا

219
00:12:52,270 --> 00:12:54,880
،أخبريني أولًا
كيف تعرفين هويّتي؟

220
00:12:55,120 --> 00:12:56,710
وكيف لا أعرفك وشُهرتك تسبقك؟

221
00:12:56,710 --> 00:12:59,360
،هيجيكاتا-سان مِن المِيبورو
،عبوسٌ كشيطانٍ

222
00:12:59,360 --> 00:13:02,040
،برداءٍ نيليّ عتيق
.ووجهٍ حسن ضاع بين طيّات فظاظتك

223
00:13:02,370 --> 00:13:05,120
لا تُفارق تقاطيع وجهك تلك النّظرة
،القاسية الّتي تنفر النّاس مِن حولك

224
00:13:05,120 --> 00:13:09,370
تتهادى في مشيتك كالصّعاليك، وتُهمهم
.بكلامٍ مُبهمٍ، ولا يستسيغ الأطفال رُؤيتك

225
00:13:09,990 --> 00:13:11,800
.حسنًا، كفاكِ تهكّمًا

226
00:13:12,310 --> 00:13:14,670
ما خطب هذا السّيف إذن؟

227
00:13:14,670 --> 00:13:15,810
.صحيحٌ، السّيف

228
00:13:16,240 --> 00:13:18,040
،إنّه مِن صُنع مُعلّمي

229
00:13:18,400 --> 00:13:20,820
فهو أبرع صانع سُيوفٍ
.في اليابان قاطبةً

230
00:13:21,480 --> 00:13:24,550
هل هو كذلك حقًا؟

231
00:13:26,310 --> 00:13:27,600
!يا له مِن مكانٍ مُوحشٍ

232
00:13:28,720 --> 00:13:33,120
هل يطرق أحدٌ بابكم في هذا
الزّقاق المَنسيّ بعيدًا عن الطّريق؟

233
00:13:33,120 --> 00:13:36,530
كان النّاس يتوافدون
.علينا بلا انقطاعٍ

234
00:13:36,530 --> 00:13:38,610
.يصعب تصديق ذلك

235
00:13:40,000 --> 00:13:41,830
.إنّه خطئي أنا

236
00:13:43,420 --> 00:13:44,280
،على كُلّ حالٍ

237
00:13:45,090 --> 00:13:47,690
أبرع صانعٍ في اليابان يقطن هنا؟

238
00:13:47,690 --> 00:13:49,080
!بل الأبرع في العالم

239
00:13:49,080 --> 00:13:51,470
!قُلتِ لتّوكِ إنّه الأبرع في اليابان فقط

240
00:13:51,470 --> 00:13:53,230
!اخفضي صوتكِ يا ساكورا

241
00:13:53,460 --> 00:13:57,620
!ستُشتّتين تركيزي أيّتها الحمقاء
!ادخلي للدّاخل، أزعجتِ الجيران

242
00:13:59,880 --> 00:14:01,990
.معذرةً يا مُعلّمي

243
00:14:02,530 --> 00:14:04,350
.جلبت زبونًا سليط اللّسان

244
00:14:04,350 --> 00:14:04,970
.أنتِ

245
00:14:18,560 --> 00:14:20,220
.ليُغلق الباب حالًا

246
00:14:20,220 --> 00:14:20,790
ماذا؟

247
00:14:21,140 --> 00:14:22,580
،أُحدّثكِ أنتِ يا ساكورا

248
00:14:22,580 --> 00:14:23,680
.أيّتها الخاملة عديمة النّفع

249
00:14:24,070 --> 00:14:25,170
.حسنًا يا سيّدي

250
00:14:32,480 --> 00:14:34,320
.انظر إلى كُلّ هذه السّيوف

251
00:14:34,750 --> 00:14:36,860
.هذه مُجرّد بقايا بائرةٍ لم يبتعها أحدٌ

252
00:14:37,410 --> 00:14:38,720
لم تُبع؟

253
00:14:39,220 --> 00:14:41,600
ألست أبرع صانع سُيوفٍ في اليابان؟

254
00:14:41,840 --> 00:14:44,740
.أ-أنا مَن صنع تلك السّيوف

255
00:14:45,500 --> 00:14:46,280
ماذا تقولين؟

256
00:14:46,860 --> 00:14:50,740
.أنا... لا أزال مُجرّد تلميذةٍ

257
00:14:53,540 --> 00:14:59,130
وُجود امرأةٍ في المصهر
.قد أدحض سُمعتي

258
00:15:00,080 --> 00:15:01,750
.إنّها عبءٌ لا طائل منه

259
00:15:03,660 --> 00:15:05,720
.عُودي إلى كنف والديكِ حالًا

260
00:15:05,720 --> 00:15:07,250
!لن أرحل مِن هنا

261
00:15:07,790 --> 00:15:13,830
،عائلتها معروفةٌ ببراعتها في تنسيق الزّهور
.وتنسيقاتهم تُزيّن معبد هونغانجي كُلّ عامٍ

262
00:15:13,830 --> 00:15:14,970
عُدنا إلى هذا الحديث ثانيةً؟

263
00:15:15,460 --> 00:15:17,470
.حقًا؟ هذا شأنٌ عظيم إذن

264
00:15:17,720 --> 00:15:22,540
طُردت لبلادتها، وقبل أن أُدرك
.الأمر، كانت قد استوطنت هنا

265
00:15:22,540 --> 00:15:24,480
.بل رحلت بمحض إرادتي

266
00:15:24,760 --> 00:15:28,790
فتاةٌ غريبة الأطوار تركت
.عائلةً مرموقةً لتصنع السّيوف

267
00:15:28,790 --> 00:15:32,010
وصانعٌ عنيد لا يكفّ عن
.التذمّر وهو يُعلّمها

268
00:15:32,450 --> 00:15:34,950
.لا أتخيّل ثنائيًا أغرب منكما

269
00:15:36,780 --> 00:15:39,240
.أنا لم أُعلّمها شيئًا يُذكر

270
00:15:39,730 --> 00:15:42,640
فلها مُطلق الحُريّة في مراقبة عملي
.واقتباس ما تستطيع مِن خبرةٍ

271
00:15:43,240 --> 00:15:46,750
ثُمّ تتولّى هي أمر المصهر
.حين لا أكون فيه

272
00:15:47,060 --> 00:15:52,070
لكنّي ملمّةٌ بأصول الصنّعة، فأنا أُراقب
.المُعلّم في كُلّ ساعةٍ، ليلًا ونهارًا

273
00:15:52,070 --> 00:15:56,400
أيّتها الحمقاء! أيّ حرفيّ هذا
الّذي يدّعي الكفاءة لنفسه؟

274
00:15:56,400 --> 00:15:58,520
.لهذا أقول إنّ عُودكِ لم يشتدّ بعد

275
00:15:58,520 --> 00:15:59,990
.معذرةً

276
00:16:01,510 --> 00:16:02,760
أرأيت؟

277
00:16:02,910 --> 00:16:05,290
.لا عجب أنّنا لا نجد مُشتريًا

278
00:16:06,440 --> 00:16:11,770
أيّ ساموراي هذا الّذي قد يأتمن
حياته على سيف صنعته امرأةٌ؟

279
00:16:12,400 --> 00:16:15,040
.لا لوم على أيّ منهم

280
00:16:17,990 --> 00:16:20,420
.هكذا إذن، فهمت الآن

281
00:16:22,360 --> 00:16:27,470
،شاع خبر وُجود صانعة سُيوفٍ
.فانفضّ النّاس عن هذا المصهر

282
00:16:28,460 --> 00:16:33,520
لكن، إن صنعت لنفسي اسمًا باستخدام أحد
.هذه السّيوف، فسيعود الزّبائن مِن جديدٍ

283
00:16:34,280 --> 00:16:35,460
أَهذا هو مُرادكِ؟

284
00:16:42,400 --> 00:16:44,540
.نقش هيتاتسورا مع تموّجات يوباشيري

285
00:16:52,240 --> 00:16:55,040
أ-أنا لا أزال في طور
...التّدريب، لذا

286
00:16:55,250 --> 00:16:57,000
.مقبضه مريحٌ في كفّ اليد

287
00:16:59,220 --> 00:16:59,940
.سآخذه

288
00:17:00,460 --> 00:17:01,090
ماذا؟

289
00:17:01,780 --> 00:17:06,650
كلا، يا هيجيكاتا-سان، أُريدك أن
...تحمل سيفًا مِن صنع المُعلّم

290
00:17:06,920 --> 00:17:09,640
أنا أحكم على الجودة
.لا على السّمعة

291
00:17:10,380 --> 00:17:11,290
.سآخذ هذا

292
00:17:13,020 --> 00:17:14,630
—لا، اصغ إليّ، أنت

293
00:17:14,630 --> 00:17:15,290
.ساكورا

294
00:17:17,100 --> 00:17:17,880
.غِمدٌ

295
00:17:19,000 --> 00:17:19,800
.أسرعي به

296
00:17:20,110 --> 00:17:21,290
.حسنًا

297
00:17:29,080 --> 00:17:30,070
.جيّدٌ

298
00:17:54,440 --> 00:17:55,840
أَتنوين أن تُصبحي صانعة سُيوفٍ؟

299
00:17:57,330 --> 00:18:00,920
ارحلي، لا تعودي لتدنيس
!عتبة دارنا ثانيةً

300
00:18:03,880 --> 00:18:06,600
!لا تهزئي بي أيّتها المرأة
!عودي إلى منزلكِ

301
00:18:07,200 --> 00:18:08,280
!لن أرحل

302
00:18:09,100 --> 00:18:12,410
!لم يعد لديّ مكانٌ آخر ألجأ إليه

303
00:18:09,570 --> 00:18:13,820
صانع سيوف

304
00:18:14,520 --> 00:18:18,580
معذرةً، لكنّي لا أتعامل مع
.مصهرٍ تعمل فيه امرأةٌ

305
00:18:24,220 --> 00:18:26,590
،أنا آسفةٌ
.كُلّ هذا بسببي أنا

306
00:18:27,310 --> 00:18:29,550
.لا ينبغي لكِ القلق بشأن هذا

307
00:18:29,550 --> 00:18:33,230
فعاجلًا أم آجلًا، سيُدركون أنّ العبرة
.في هذه الحرفة هي النّتيجة فحسب

308
00:18:33,560 --> 00:18:35,370
.الجميع سيعلمون ذلك

309
00:19:28,660 --> 00:19:30,100
!على ماذا تبكي؟

310
00:19:30,630 --> 00:19:35,600
،ماذا قُلت لكِ؟ واصلي السّير في طريقكِ
.وسيُغيّرون رأيهم في نهاية المطاف

311
00:19:36,160 --> 00:19:37,120
.مُعلّمي

312
00:19:40,440 --> 00:19:43,870
هيجيكاتا-سان، أليس كذلك؟
.لست بحاجةٍ إلى مالك

313
00:19:44,230 --> 00:19:47,360
.بدل ذلك، لديّ رجاءٌ

314
00:19:48,660 --> 00:19:52,390
مِن الآن فصاعدًا، اعتمد عليها هي
.في أعمالك مُستقبلًا، لا عليّ أنا

315
00:19:52,660 --> 00:19:55,070
،فهي، على أقلّ تقديرٍ
.تُتقن صنعتها جيدًا

316
00:19:56,650 --> 00:19:58,660
!أنتِ أيضًا، انحني له

317
00:19:58,660 --> 00:19:59,820
.سمعًا وطاعةً

318
00:20:01,880 --> 00:20:02,980
.حسنًا

319
00:20:06,460 --> 00:20:07,400
.سأعود لزيارتكما

320
00:20:07,850 --> 00:20:09,400
هل تعني ذلك حقًا؟

321
00:20:09,960 --> 00:20:13,890
،ستلحق بك سمعةٌ سيئّة أيضًا
.إذا حملت سيوفًا صنعتها امرأةٌ

322
00:20:14,470 --> 00:20:15,900
سمعةٌ سيّئة؟

323
00:20:17,570 --> 00:20:20,200
.تعايشت مع سُوء السّمعة

324
00:20:21,660 --> 00:20:24,400
ذلك المكان يصنع كُرات
.دانغو شهيّةً للغاية

325
00:20:24,400 --> 00:20:27,360
عُدنا لهذا ثانيةً؟
.لا بُدّ لي مِن التّجربة الآن

326
00:20:40,340 --> 00:20:41,080
.الجبل

327
00:20:41,760 --> 00:20:43,080
.النّهر

328
00:20:43,510 --> 00:20:45,890
ما صيد اليوم؟

329
00:20:46,370 --> 00:20:47,090
.سمك الشّبوط

330
00:20:50,350 --> 00:20:52,320
.الأفعى في الطّابق الثّاني

331
00:20:52,320 --> 00:20:53,120
.أعلم ذلك

332
00:21:08,760 --> 00:21:12,280
،يا للهول
.مضى وقتٌ طويل

333
00:21:12,970 --> 00:21:15,530
.لم أظنّ أنّك ستعود يومًا

334
00:21:15,960 --> 00:21:20,050
،زاد حجمكِ ثانيةً
.أنتِ أفعى بالاسم فقط

335
00:21:21,920 --> 00:21:25,030
لم أعد قادرةً حتّى على
.قضاء حاجتي دُون مساعدةٍ

336
00:21:26,620 --> 00:21:31,300
،ما بالك إذن؟ بما أنّك قصدتني
فلا ريب أنّك تبغي مالًا؟

337
00:21:33,570 --> 00:21:37,020
مَن ستُرديه قتيلًا هذه المرّة يا جيرو؟

338
00:21:38,970 --> 00:21:44,440
أم أنّك صرت سايتو
هاجيمي الثّاني الآن؟

339
00:21:45,030 --> 00:21:50,040
سباقٌ
مع

340
00:21:45,030 --> 00:21:50,040
الزّمن
لجني
المال

341
00:23:20,160 --> 00:23:25,550
الحلقة القادمة

342
00:23:21,470 --> 00:23:26,580
يسعى رجال المِيبورو جاهدين، كُلٌّ
.بأسلوبه، لجمع ما يلزم مِن المال

343
00:23:27,330 --> 00:23:33,810
،وبينما يمضي هاجيمي في طريقه وحيدًا
.يلتقي نيو وتارو بامرأةٍ غامضة

344
00:23:34,430 --> 00:23:38,480
،وباستثناء لقاء الشّوغون إيموتشي

345
00:23:38,480 --> 00:23:43,940
فإنّ هذا اللّقاء قد غيّر مصير نيو وجماعة
.المِيبورو كافّةً، أكثر من أيّ حدثٍ آخر

346
00:23:44,180 --> 00:23:47,190
."الحلقة القادمة: "كجريان النّهر

347
00:23:47,200 --> 00:23:50,030
كجريان

348
00:23:47,200 --> 00:23:50,030
النّهر

349
00:23:47,880 --> 00:23:49,150
.لن يخيب أملكم