1
00:00:02,200 --> 00:00:04,630
فقدت والديّ بعد ولادتي
.بوقتٍ قصير

2
00:00:05,480 --> 00:00:06,690
.قِيل لي إنّ حريقًا نشب فأودى بهما

3
00:00:08,720 --> 00:00:11,120
،تقاذفني الأقارب فيما بينهم

4
00:00:13,180 --> 00:00:16,760
وما لبثت أن صرت خادمةً
.في نُزلٍ أُصارع لأجل البقاء

5
00:00:18,360 --> 00:00:24,660
كانت بهجتي الوحيدة هي رُكوب القارب
.عبر النّهر عندما كنت أُوصل الطّلبات للزّبائن

6
00:00:26,460 --> 00:00:28,430
.كنت وحيدةً دائمًا

7
00:00:29,810 --> 00:00:32,940
إلى أن جاء اليوم الّذي
.التقيت فيه بـ يوتارو-سان

8
00:00:45,820 --> 00:00:50,120
ذئاب ميبو الزّرق

9
00:02:19,680 --> 00:02:23,160
،هدّئي مِن روعكِ
.فالمخاض سيعود بعد قليلٍ

10
00:02:23,160 --> 00:02:27,040
،ستكونين بخيرٍ يا ناغي-سان
.خُذي نفسًا عميقًا، ثُمّ أطلقيه ببطءٍ

11
00:02:27,350 --> 00:02:30,420
حينما يصفو ذهنكِ، سيهون كُلّ شيءٍ
.بعد ذلك، استرسلي في الاسترخاء

12
00:02:30,800 --> 00:02:32,970
.المَولود يتوق للخُروج

13
00:02:35,610 --> 00:02:37,990
،نيو
.ماء الاستحمام قد برد

14
00:02:37,990 --> 00:02:40,560
،وهذا سيصدم المَولود
.زِد فيه مِن الماء السّاخن

15
00:02:40,910 --> 00:02:42,120
.حسنًا

16
00:02:47,370 --> 00:02:49,560
.هكذا، على مهلكِ وبثباتٍ

17
00:02:55,530 --> 00:02:57,030
...لم تكن لي روابط دمٍ

18
00:02:58,530 --> 00:03:00,530
.في كُلّ أرجاء هذه الحياة

19
00:03:05,310 --> 00:03:07,160
،تبدو كأنّها دميةٌ

20
00:03:07,420 --> 00:03:09,400
لماذا لا تُبدين أيّ غضبٍ؟

21
00:03:09,600 --> 00:03:11,620
،أمرٌ يبعث الرّيبة
.إنّها جوفاء مِن الدّاخل

22
00:03:15,260 --> 00:03:18,180
جوفاء

23
00:03:16,520 --> 00:03:17,470
جوفاء؟

24
00:03:19,200 --> 00:03:20,000
خاوية؟

25
00:03:21,200 --> 00:03:22,380
.بالطّبع كنت كذلك

26
00:03:23,240 --> 00:03:25,610
فلم أملك شيئًا في
.ماضيّ أو مُستقبلي

27
00:03:27,050 --> 00:03:29,430
،لم تكن لي أيّ رغباتٍ
.ولم أُبدِ أيّ مُقاومةٍ

28
00:03:30,630 --> 00:03:32,810
بل تركت التّيار يجرفني
.حيث شاء ولزمت السّكينة

29
00:03:33,870 --> 00:03:35,280
.هكذا كنت سأنجو

30
00:03:36,530 --> 00:03:37,840
...ورُغم كُلّ ذلك

31
00:03:39,100 --> 00:03:40,470
.يا لها مِن صُدفةٍ أن نلتقي مُجددًا

32
00:03:44,600 --> 00:03:45,910
أنا في طريقي لإعطاء
.درسٍ خُصوصيّ

33
00:03:46,860 --> 00:03:48,750
هل أنتِ محبّةٌ للنّهر؟

34
00:03:49,040 --> 00:03:49,900
ماذا؟

35
00:03:49,900 --> 00:03:52,000
أقصد... أراكِ دومًا غارقةً
.في تأمّله

36
00:03:57,270 --> 00:03:59,620
.خبّأ لي القَدر مُفاجأةً لم أتوقّعها

37
00:04:03,880 --> 00:04:05,500
أليست هذه الفتاة خادمةً؟

38
00:04:05,960 --> 00:04:07,940
أنّى لمثلها أن تقترن
برجلٍ مِن السّاموراي؟

39
00:04:08,180 --> 00:04:09,630
.كان عليها أن تَعي مقامها

40
00:04:11,100 --> 00:04:12,650
.يا له مِن زواجٍ غير مُتكافئ

41
00:04:12,650 --> 00:04:13,830
،اخفضوا أصواتكم
.كي لا تسمعكم

42
00:04:15,890 --> 00:04:17,530
.ناغي-سان، ناغي-سان

43
00:04:19,080 --> 00:04:19,810
.لا تقلقي

44
00:04:25,080 --> 00:04:27,060
،لم أكن زوجةً مُلائمةً له

45
00:04:28,910 --> 00:04:31,110
...لكن حماتي قالت لي يومها

46
00:04:32,920 --> 00:04:36,550
لذيذٌ! إنّي أستطعم فيه
.نكهة كيوتو

47
00:04:37,120 --> 00:04:38,770
.تعلّمت الطّهي في نُزلٍ

48
00:04:39,100 --> 00:04:41,560
لم أكن سوى ابنة فلّاحٍ
.بسيط، أنا أيضًا

49
00:04:41,720 --> 00:04:42,130
عفوًا؟

50
00:04:42,620 --> 00:04:44,200
.فضلًا عن أنّي الزّوجة الثّانية

51
00:04:44,200 --> 00:04:44,950
ماذا؟

52
00:04:45,450 --> 00:04:49,680
إذن، يوتارو-سان وأخوه الأكبر
...الّذي غادر الدّار ليسا

53
00:04:49,940 --> 00:04:51,680
.لا تجمعنا أيّ روابط دمٍ

54
00:04:51,920 --> 00:04:52,980
.لا شيء أبدًا

55
00:04:53,340 --> 00:04:57,690
لكن سواءٌ كانت الصّلة بين
...زوجين، أو بين أُمّ وابنتها

56
00:05:01,200 --> 00:05:03,990
فالمعيار الحقيقيّ هو الحفاظ
.على سلامة العائلة

57
00:05:10,100 --> 00:05:14,910
لماذا سايرت أخا يوتارو-سان؟
ولم جئت إلى هذه الدّار؟

58
00:05:15,520 --> 00:05:16,690
.الدّماء تنزف بغزارةٍ

59
00:05:17,600 --> 00:05:18,640
!ابذلي أقصى جُهدكِ

60
00:05:21,030 --> 00:05:23,380
كان كُلّ ما مضى لأجل هذه
.اللّحظة، لأجل هذا الطّفل

61
00:05:24,010 --> 00:05:26,020
،أحسنتِ فعلًا
.ها هو يخرج

62
00:05:26,190 --> 00:05:27,270
!اصمدي يا ناغي-سان

63
00:05:27,670 --> 00:05:28,950
!لم يبقَ إلّا القليل

64
00:05:32,680 --> 00:05:38,070
أحيانًا، تكون الرّوابط العائليّة الّتي
.لا يمسّها دمٌ أقوى مِن تلك الّتي تقوم عليه

65
00:05:41,840 --> 00:05:44,640
،سأُورّث شيئًا للحياة
.ستكون لي رغبةٌ ما

66
00:05:45,150 --> 00:05:48,200
،إذا استطعت ترك أثرٍ يبقى
.فهذا يعني أنّي لست جوفاء

67
00:05:49,270 --> 00:05:50,450
...سأترك خلفي

68
00:05:54,760 --> 00:05:58,080
،ناغي-سان
.اعتني بهذه العائلة

69
00:06:01,560 --> 00:06:03,240
.شاهدًا يُؤكّد أنّي عِشت حقًا...

70
00:06:09,020 --> 00:06:09,840
!لقد خرج

71
00:06:13,730 --> 00:06:16,600
!فعلتِها! أحسنتِ يا ناغي-سان

72
00:06:16,800 --> 00:06:19,230
!أجل، وُلد الطّفل

73
00:06:19,550 --> 00:06:20,290
.مهلًا

74
00:06:21,540 --> 00:06:22,530
،إنّه لا يُصدر أيّ صوتٍ
.لا يبكي

75
00:06:28,470 --> 00:06:30,700
هل ثمّة شيءٌ عالق في حنجرته؟

76
00:06:30,700 --> 00:06:32,700
.كلا

77
00:06:33,110 --> 00:06:33,790
!ناوليني إيّاه، حالًا

78
00:06:35,580 --> 00:06:36,260
كيف؟

79
00:06:36,720 --> 00:06:37,590
لماذا؟

80
00:06:38,510 --> 00:06:39,520
...أرجوك

81
00:06:45,380 --> 00:06:46,580
...أرجوك

82
00:06:49,760 --> 00:06:50,610
.ابكِ

83
00:06:52,460 --> 00:06:53,760
!ابكِ

84
00:06:55,360 --> 00:06:56,530
...أتوسّل إليك

85
00:06:57,950 --> 00:06:58,970
!اجعل بيننا رابطةً لا تنفصم

86
00:07:12,010 --> 00:07:12,850
.صاح باكيًا

87
00:07:21,790 --> 00:07:23,370
،يا هِبتي الغالية

88
00:07:24,770 --> 00:07:25,440
،عجبًا

89
00:07:26,560 --> 00:07:30,200
.ما أرقّ ملمسك وما أشدّ دِفأك

90
00:07:31,790 --> 00:07:32,960
،يوتارو-سان

91
00:07:34,030 --> 00:07:35,880
،أبي، أُمّي

92
00:07:36,880 --> 00:07:38,180
.فعلتها

93
00:07:39,190 --> 00:07:40,150
هل وضعت مَولودها؟

94
00:07:40,390 --> 00:07:41,490
.لا بُدّ أنّها فعلت

95
00:07:44,270 --> 00:07:46,720
!يا للرّاحة، يا للرّاحة

96
00:07:50,560 --> 00:07:53,930
.فعلتها

97
00:08:17,680 --> 00:08:18,890
هل وُلد الطّفل حقًا؟

98
00:08:18,890 --> 00:08:21,440
أَهو صبيٌّ أم فتاةٌ؟

99
00:08:21,670 --> 00:08:23,240
.يا له مِن صغيرٍ فتّان

100
00:08:23,240 --> 00:08:25,060
.دعوني أحمله أنا أيضًا

101
00:08:25,060 --> 00:08:28,320
أروني، دعوني أُلقي
!نظرةً أيضًا

102
00:08:29,960 --> 00:08:31,450
.يا للرّوعة، يا للرّوعة

103
00:08:35,340 --> 00:08:37,620
.إنّه لطيفٌ للغاية

104
00:08:40,110 --> 00:08:42,040
مهلًا، أين نيو؟

105
00:08:42,600 --> 00:08:43,920
أَلم يعد بعد؟

106
00:08:46,270 --> 00:08:48,860
لا بُدّ أنّ ناغي-سان
.تكاد تطير مِن الفرح

107
00:08:48,860 --> 00:08:50,420
.يجب أن نُقيم احتفالًا

108
00:08:53,440 --> 00:08:54,130
...ما الّذي

109
00:08:57,620 --> 00:08:58,420
.إنّها فارقت الحياة

110
00:09:01,860 --> 00:09:02,400
ماذا؟

111
00:09:17,640 --> 00:09:20,880
فهمت، ستكون هذه النّهاية قاسيةً
.جدًا على نيو ليتحمّلها

112
00:09:21,840 --> 00:09:23,780
.ما مضى قد مضى

113
00:09:24,890 --> 00:09:25,570
...ولكن

114
00:09:27,020 --> 00:09:31,460
في رأيي، الشّخص الوحيد القادر
...حقًا على إنقاذ الآخرين

115
00:09:33,070 --> 00:09:35,520
هو مَن يتجرّع الألم
.مِن أعماق قلبه

116
00:09:39,000 --> 00:09:41,120
.مَن ذاق طعم الحُزن وعرف لوعته

117
00:09:49,480 --> 00:09:51,210
.مرّ يومٌ بكامله مُنذ ذلك الحين

118
00:09:52,040 --> 00:09:53,980
لا يُمكنني أن أظلّ غارقةً
.في نحيبي إلى الأبد

119
00:09:54,900 --> 00:09:56,530
...حتّى الطّبيب أكّد لنا

120
00:09:57,840 --> 00:09:59,710
أنّه لم يكن في وسعنا
.فِعل شيءٍ

121
00:10:07,270 --> 00:10:09,000
!ساكورا-سان

122
00:10:09,410 --> 00:10:09,990
ماذا؟

123
00:10:10,690 --> 00:10:11,930
.طاب صباحكِ

124
00:10:12,480 --> 00:10:14,720
هل تقومين بفحص سُيوف
الجميع ثانيةً اليوم؟

125
00:10:15,300 --> 00:10:17,110
.شُكرًا لحضوركِ مُبكّرًا

126
00:10:17,380 --> 00:10:18,960
ماذا؟

127
00:10:19,460 --> 00:10:21,890
،ساكورا
.جئتِ في الوقت المُناسب

128
00:10:22,250 --> 00:10:23,310
.هيجيكاتا-سان

129
00:10:24,790 --> 00:10:29,350
،حاولت تقويم سيفٍ مُنحنٍ بالمطرقة
.فاستحال بين يديّ كأنّه سُنبلة أرزٍ

130
00:10:30,720 --> 00:10:33,380
!ما الّذي فعلته به؟

131
00:10:35,580 --> 00:10:37,720
!نيو، أنا جائعٌ

132
00:10:38,030 --> 00:10:39,360
.حان وقت الإفطار

133
00:10:39,850 --> 00:10:40,790
.سأذهب للمُساعدة

134
00:10:42,240 --> 00:10:45,660
كيف تَرى حال نيو-كون الآن؟

135
00:10:45,880 --> 00:10:47,700
،لا أعلم حقًا

136
00:10:48,240 --> 00:10:51,030
،لم ينبس ببنتِ شفةٍ بالأمس
وهذا شيءٌ مُتوقّع، ولكن الآن؟

137
00:10:51,620 --> 00:10:54,380
هل يتخطّى الصّعاب سريعًا
لأنّه لا يزال صغيرًا؟

138
00:10:54,930 --> 00:10:57,430
أم أنّه استطاع استيعاب ما حدث
لما يملكه مِن ثباتٍ؟

139
00:11:01,540 --> 00:11:04,260
،الطّريق مِن فضلكم
!افسحوا المجال

140
00:11:05,550 --> 00:11:09,580
،حتّى بعد تلك المُهمّة الكبيرة
.لم يتغيّر هذا المكان قيد أنملةٍ

141
00:11:10,930 --> 00:11:13,230
.ما مِن شيءٍ يلبث على حاله

142
00:11:13,230 --> 00:11:15,190
تودو-سان؟

143
00:11:15,480 --> 00:11:16,480
،تودو

144
00:11:17,070 --> 00:11:19,130
.لا تطأ حافّة حصير التّاتامي

145
00:11:19,720 --> 00:11:22,990
عُذرًا، مَن أنت ثانيةً؟

146
00:11:23,150 --> 00:11:26,200
!إنّه شينباتشي
!فقد شينباتشي عقله

147
00:11:26,440 --> 00:11:29,750
يجب على السّاموراي أن يكون
.مثاليًا في كُلّ ما يفعله

148
00:11:31,180 --> 00:11:32,710
هل حلقت شاربك؟

149
00:11:33,300 --> 00:11:36,830
،كففت عن ادعاء ما ليس فيّ
.ينبغي للسّاموراي أن يلتزم بجوهره

150
00:11:36,830 --> 00:11:38,000
.مثيرٌ للإعجاب

151
00:11:38,330 --> 00:11:40,250
،تحوّلٌ جذريّ في الشّخصية
أليس كذلك؟

152
00:11:40,430 --> 00:11:42,000
.أفهم شُعوره تمامًا

153
00:11:42,330 --> 00:11:45,060
تلك المعركة خلّفت مرارةً
.في نُفوسنا

154
00:11:45,340 --> 00:11:47,800
!كفاكم تباكيًا، وامضوا قُدمًا

155
00:11:47,960 --> 00:11:49,290
.كما فعل نيو تمامًا

156
00:11:49,520 --> 00:11:51,270
.فرغت مِن تنظيف الأرضيّات

157
00:11:51,600 --> 00:11:53,770
.عليّ الآن أن أُسرع لغسل الخضراوات

158
00:11:58,240 --> 00:12:00,550
قتلت زعيم المُتمرّدين وأنهيت التّهديد؟

159
00:12:00,550 --> 00:12:02,520
هذا هو سيريزاوا-سينسي
.الّذي نعرفه

160
00:12:02,810 --> 00:12:04,490
.أعظم رجلٍ على قيد الحياة

161
00:12:04,490 --> 00:12:06,790
.لا تقف في طريقي

162
00:12:09,810 --> 00:12:12,200
هل تُصدّقون ما فعله هيراما؟
.لا يملك ذرّةً مِن اللّباقة

163
00:12:12,200 --> 00:12:13,670
.لا تُحدّق فيَّ

164
00:12:14,080 --> 00:12:15,210
ألا يُسمح لي حتّى بالنّظر؟

165
00:12:19,010 --> 00:12:21,190
.مزاج سيريزاوا متعكّرٌ جدًا اليوم

166
00:12:22,960 --> 00:12:27,650
يتعين عليّ تدوين تقريرٍ شامل
.يُلخّص ما جرى بوضوحٍ

167
00:12:27,880 --> 00:12:30,100
سأُحضر لك الورق والمِحبرة
.على الفور

168
00:12:31,520 --> 00:12:32,600
...أَتظنّ أنّ نيو-كون رُبّما

169
00:12:34,540 --> 00:12:39,400
يتحاشى سماع تفاصيل ما حدث؟

170
00:12:39,710 --> 00:12:41,990
،حسنًا
.أُجزم أنّه يُفضّل ذلك

171
00:12:42,200 --> 00:12:45,290
،ومع ذلك، سينسى في غُضون ثلاثة أيّامٍ
.شريطة أن ينال قسطًا مِن الرّاحة ويتناول الطّعام

172
00:12:45,290 --> 00:12:47,740
هذه الأمور تقتضي التّعامل
.معها بحكمةٍ

173
00:12:47,940 --> 00:12:52,080
،المسألة كُلّها تعود لمشاعره
.وكيفية تفكيره في ما جرى

174
00:12:52,080 --> 00:12:54,870
لعلّ انشغاله بحرث الأرض
.يُنسيه هُمومه

175
00:12:54,870 --> 00:12:55,920
.دعوه وشأنه

176
00:12:56,610 --> 00:12:58,280
.هيجيكاتا-سان

177
00:13:00,160 --> 00:13:03,100
كوندو-سان، هل يُمكنني
ترك نيو بمعيّتك؟

178
00:13:04,960 --> 00:13:05,490
.أجل

179
00:13:07,770 --> 00:13:11,640
،هذه المسألة لا يحسمها إلّا السّيف
.لا شيء سواه ينفع

180
00:13:13,090 --> 00:13:14,600
!نيو، حان وقت التّدريب

181
00:13:14,600 --> 00:13:15,440
ماذا؟

182
00:13:16,080 --> 00:13:18,430
كوندو-سان؟

183
00:13:19,160 --> 00:13:20,430
أَتراه بخير؟

184
00:13:20,180 --> 00:13:22,730
مهلًا، ماذا يجري؟

185
00:13:20,430 --> 00:13:21,700
.قلقي عليه يفوق كُلّ وصفّ

186
00:13:23,610 --> 00:13:26,750
،في مثل هذه اللّحظات
.يكون الانغماس في التّفكير مهلكةً

187
00:13:33,020 --> 00:13:35,650
،إذن... عُذرًا
هل تُريد منّي أن أُهاجمك؟

188
00:13:35,890 --> 00:13:37,770
،أجل
.بكُلّ ما أوتيت مِن قوّةٍ

189
00:13:43,160 --> 00:13:44,710
.واصل ولا تتوقّف

190
00:13:45,010 --> 00:13:45,870
.أجل، يا سيّدي

191
00:13:48,560 --> 00:13:49,560
.استمرّ هكذا

192
00:13:49,560 --> 00:13:52,310
.أجل، يا سيّدي

193
00:13:50,230 --> 00:13:51,280
.المزيد

194
00:13:52,310 --> 00:13:53,110
!أَقدم نحوي

195
00:13:53,950 --> 00:13:54,620
!لا تتوقّف

196
00:13:54,510 --> 00:13:56,870
.إنّهما يتدرّبان فحسب

197
00:13:55,200 --> 00:13:56,010
!هيّا

198
00:14:02,840 --> 00:14:07,320
دُفنت ناغي-دونو في مقبرة
.الغُرباء والمُعدمين دُون أهلٍ

199
00:14:09,330 --> 00:14:10,840
،لم يكن لديها أقارب

200
00:14:11,370 --> 00:14:14,520
،وقد طُلّقت قُبيل هذه الأحداث

201
00:14:15,200 --> 00:14:16,840
.لم يكن باليد حيلةٌ

202
00:14:17,210 --> 00:14:19,750
لـ-لماذا تُخبرني بذلك الآن؟

203
00:14:19,750 --> 00:14:20,460
.واصل

204
00:14:22,080 --> 00:14:22,920
.أنت ضعيفٌ

205
00:14:27,680 --> 00:14:29,720
.صرعت يوتارو-دونو

206
00:14:30,400 --> 00:14:31,090
.قتلته

207
00:14:34,140 --> 00:14:37,290
.لم يكن بإمكاني إيقافه دُون قتله

208
00:14:38,420 --> 00:14:40,570
وسيريزاوا-سان هو مَن
.أردى ناووزومي قتيلًا

209
00:14:40,570 --> 00:14:41,840
.أرجوك، توقّف

210
00:14:42,680 --> 00:14:45,650
سيتمّ التخلّص مِن جُثثهم
.كما يُفعل بالمُجرمين

211
00:14:46,640 --> 00:14:48,270
.أرجوك، كُفّ عن ذلك

212
00:14:49,850 --> 00:14:52,620
صار مقرّ كيوهاتشي ودار التّدريب
.كلاهما رُكامًا

213
00:14:53,200 --> 00:14:55,700
،سيُمحى نسبهم تمامًا
.بما في ذلك الفُروع الثّانوية للعائلة

214
00:14:56,450 --> 00:14:58,390
!أرجوك توقّف

215
00:15:06,810 --> 00:15:07,960
.أنا أعلم

216
00:15:08,710 --> 00:15:10,120
.أعلم كُلّ ذلك

217
00:15:12,970 --> 00:15:16,280
،حدث ذلك لأنّني قصّرت

218
00:15:18,120 --> 00:15:20,730
.لأنّني لم أنتبه حينها

219
00:15:21,640 --> 00:15:23,410
.لأنّني أخفقت

220
00:15:24,670 --> 00:15:27,830
.لأنّني كنت ضعيفًا

221
00:15:31,450 --> 00:15:32,450
...كُلّ هذا

222
00:15:35,290 --> 00:15:36,720
.كان خطئي

223
00:15:42,170 --> 00:15:44,880
الولادة دائمًا ما تكون
.محفوفةً بمخاطر الموت

224
00:15:45,700 --> 00:15:48,480
.عُهِد بالمَولود إلى أُناسٍ موثوقين

225
00:15:50,680 --> 00:15:52,290
.الآن صرت تعلم حقيقة ما جرى

226
00:15:54,680 --> 00:15:56,310
أَتظنّ أنّ بمقدوره تحمّل هذا؟

227
00:15:56,310 --> 00:15:57,860
رُبّما كان عليه أن يكون
.أقلّ قسوةً في أُسلوبه

228
00:15:58,280 --> 00:15:59,970
،كلا، هذا هو الصّواب

229
00:16:00,520 --> 00:16:04,230
فلن يخطو خُطوةً للأمام
.ما لم يُسلّم بالواقع

230
00:16:08,300 --> 00:16:09,020
!نيو-كون

231
00:16:13,480 --> 00:16:14,900
.حرارة جسده ترتفع كالنّار

232
00:16:15,050 --> 00:16:16,060
ماذا؟

233
00:16:16,390 --> 00:16:18,610
لماذا لم يلحظ أحدٌ ذلك؟

234
00:16:18,610 --> 00:16:20,280
،أيّها الحمقى
!أرهقتموه بالتّدريب فوق طاقته

235
00:16:20,460 --> 00:16:21,440
.يا للإحراج

236
00:16:33,700 --> 00:16:35,470
هاجيمي، ماذا نفعل الآن؟

237
00:16:35,800 --> 00:16:39,060
،إنّه مُجرّد إعياءٍ
.سيردّ النّوم إليه عافية جسده

238
00:16:39,230 --> 00:16:41,150
جـ-جسده فحسب؟

239
00:16:41,150 --> 00:16:43,140
وماذا عن الأمور الأخرى
الّتي تستوجب القلق؟

240
00:16:44,310 --> 00:16:46,050
إلى أين أنت ذاهبٌ؟

241
00:16:46,050 --> 00:16:46,960
.لديّ شأنٌ أقضيه

242
00:16:46,960 --> 00:16:49,540
ماذا؟
!رفيقنا يتألّم هنا

243
00:16:49,910 --> 00:16:51,560
ألا تملك قلبًا؟

244
00:16:52,230 --> 00:16:54,540
.يا لك مِن مسكينٍ، يا نيو

245
00:16:56,610 --> 00:16:57,630
هكذا إذن؟

246
00:16:58,210 --> 00:17:01,080
.شُكرًا لك على إخباري بحال نيو

247
00:17:01,590 --> 00:17:03,960
،إذن
ما الشّأن الّذي أردتِني فيه؟

248
00:17:04,630 --> 00:17:07,590
،أُريد منك أن تلتقي بأحدهم
.يا هاجيمي

249
00:17:07,990 --> 00:17:08,720
ماذا؟

250
00:17:09,850 --> 00:17:13,000
جدّتي، مضى وقتٌ طويل
!لم نلتقِ فيه

251
00:17:13,000 --> 00:17:15,370
،انظري إلى نفسكِ
.كم تبدين زاهيةً بهذه الثّياب الفاخرة

252
00:17:15,370 --> 00:17:16,720
مـ-من هذه؟

253
00:17:17,320 --> 00:17:18,950
.لا بُدّ أنّك هاجيمي-تشان

254
00:17:19,220 --> 00:17:21,270
!هاجيمي... تشان؟

255
00:17:23,220 --> 00:17:25,720
.أنا إيروها، سُررت بلقائك

256
00:17:25,960 --> 00:17:27,280
مَن تكون هي؟

257
00:17:27,470 --> 00:17:28,990
.إنّها أُخت نيو

258
00:17:28,990 --> 00:17:33,480
أُخته؟ تلك الّتي آوتها
إحدى العائلات النّبيلة؟

259
00:17:35,240 --> 00:17:39,500
أنا على درايةٍ تامّة بك وبالمِيبورو
.مِن خلال رسائل جدّتي

260
00:17:41,280 --> 00:17:44,180
.أُريد أن أطلب منك معروفًا

261
00:17:44,180 --> 00:17:48,920
حسنًا؟ وما هو؟
.أرجو ألًا يكون طلبكِ للّهو والمرح

262
00:17:49,430 --> 00:17:53,750
ثُمّ إنّ خُروج طفلةٍ بمُفردها
.ليلًا أمرٌ محفوف بالمخاطر

263
00:17:54,890 --> 00:17:56,910
.إنّه تمامًا كما وصفتِ في الرّسائل

264
00:17:56,910 --> 00:17:57,980
أليس كذلك؟

265
00:17:57,980 --> 00:17:59,270
ما الّذي تقولانه عنّي؟

266
00:17:59,810 --> 00:18:01,780
.لست بمُفردي، بالطّبع

267
00:18:02,060 --> 00:18:02,770
ماذا؟

268
00:18:09,000 --> 00:18:13,050
،انظروا وتأمّلوا، كُرتي لا تسقط أبدًا
.هكذا يكون إتقان الكيماري

269
00:18:16,120 --> 00:18:18,080
مـ-من هذا الرّجل؟

270
00:18:18,080 --> 00:18:19,120
،هاجيمي-تشان

271
00:18:19,120 --> 00:18:22,780
هذا هو السيّد النّبيل
.والعظيم أنيجاكوجي-ساما

272
00:18:26,280 --> 00:18:27,340
.لم أسمع به قطّ

273
00:18:27,490 --> 00:18:32,900
حتّى المُوالون الوطنيّون في
.ساتسوما يُبجّلونه كقائدٍ لهم

274
00:18:33,440 --> 00:18:38,350
إنّه رائدٌ في الثّالثة والعشرين مِن عُمره، ويتزعّم
.الفصيل المُناهض للأجانب في الدّيوان الإمبراطوريّ

275
00:18:38,660 --> 00:18:41,990
أنت تقف الآن أمام
!أنيجاكوجي كينتومو-ساما

276
00:18:44,880 --> 00:18:47,340
هل بلغت عظمتي هذا القَدر حقًا؟

277
00:18:47,340 --> 00:18:49,680
.لك أن تنهال عليّ بالثّناء والتّبجيل

278
00:18:50,000 --> 00:18:52,680
.حسنًا، فهمت الآن

279
00:18:53,300 --> 00:18:55,160
هل تُمانعين إن لكمت هذا الرّجل؟

280
00:18:56,070 --> 00:18:57,350
!لماذا تقول ذلك؟

281
00:18:57,960 --> 00:19:02,450
اسمع، أُريد منك أن تكون حارسًا للسيّد
.أنيجاكوجي-ساما مِن أجلي

282
00:19:04,440 --> 00:19:07,200
،سآذن لك بأن تكون حارسًا لجنابي
.فلتبتهج، يا هاجيمي

283
00:19:09,570 --> 00:19:11,370
.لثلاثة أيّامٍ فحسب

284
00:19:11,710 --> 00:19:16,210
وليس على مدار السّاعة، بل في طريقه
.مِن داره إلى القصر الإمبراطوريّ فقط

285
00:19:16,760 --> 00:19:19,720
رجلٌ بمقامه، لا ريب أنّ لديه
.حاشيةً وحُرّاسًا يتبعونه

286
00:19:19,880 --> 00:19:24,010
في الواقع، مضوا جميعًا إلى مهرجان
.المحار، فأصابهم المرض كُلّهم

287
00:19:24,360 --> 00:19:28,720
،ومع ذلك سَلمت أنا
.لأنّني مِن الصّفوة المُختارة

288
00:19:28,960 --> 00:19:34,170
،كنت أنوي سؤال نيو-كون أيضًا
.لكن يبدو أنّه يُواجه مشاكل أكبر

289
00:19:34,330 --> 00:19:37,290
أمّا هيجيكاتا-سان وأوكيتا-سان
،فحُضوروهما سيكون لافتًا للأنظار

290
00:19:37,290 --> 00:19:40,510
كما أنّ طلب العون مِن المِيبورو
.سيجعل الأمور مُعقّدةً

291
00:19:41,000 --> 00:19:43,990
مُعقّدة؟ ولماذا؟

292
00:19:44,670 --> 00:19:49,000
على أيّ حالٍ، مَن ذا الّذي يُلاحق
هذا الرّجل المُهمّ؟ وما السّبب؟

293
00:19:56,420 --> 00:19:58,640
حسنًا، لا تُخبرني إن كنت
.لا ترغب في ذلك

294
00:19:59,200 --> 00:20:01,510
إذن، كُلّ ما عليّ فِعله هو
ضمان سلامتك لثلاثة أيّامٍ؟

295
00:20:01,900 --> 00:20:03,220
إذن، هل ستقبل المُهمّة؟

296
00:20:04,290 --> 00:20:06,610
.أجل، فلا خيار أمامي

297
00:20:07,320 --> 00:20:08,510
.بل لا خيار لأيّ منّا

298
00:20:09,080 --> 00:20:10,280
منّا؟

299
00:20:13,280 --> 00:20:16,280
!شُكرًا لك، يا هاجيمي-تشان

300
00:20:15,210 --> 00:20:16,280
.كُفّي عن هذا

301
00:20:16,510 --> 00:20:18,300
!هاجيمي-تشان

302
00:20:18,300 --> 00:20:19,780
،تنحّي جانبًا
!أيّتها العجوز الشّمطاء

303
00:20:19,950 --> 00:20:23,790
القصر الإمبراطوريّ

304
00:20:25,080 --> 00:20:26,930
،المسافة ليست بعيدةً
أليس كذلك؟

305
00:20:27,680 --> 00:20:31,620
مُجرّد ذهابٍ إلى مجلس جلالة
.الإمبراطور في القصر ثُمّ العودة

306
00:20:31,870 --> 00:20:35,790
،لا ريب أنّك لم تطأ أرض القصر مّن قبل
.وإنّني لمعجبٌ بثباتك الّذي لا يفضح ذلك

307
00:20:37,200 --> 00:20:39,340
التّحديق بذُهولٍ سيجعل
.النّاس يرتابون فينا

308
00:20:43,810 --> 00:20:44,520
مذكّراتٌ؟

309
00:20:45,030 --> 00:20:49,990
تدوين الوقائع اليوميّة
.مِن أنبل مهامّ صفوة القوم

310
00:20:50,240 --> 00:20:52,870
فهي ذخرٌ يُستعان به
.حين الشّروع في أمرٍ جديد

311
00:20:54,320 --> 00:20:56,800
.إذ تربط الماضي بالحاضر والمُستقبل

312
00:20:57,260 --> 00:20:59,460
.وبها نصون موروثنا

313
00:21:00,760 --> 00:21:03,120
،لم أستوعب أهمّيته كُليًا
.لكن التّدوين يبدو عملًا مُضنيًا

314
00:21:04,160 --> 00:21:04,870
،على أيّ حالٍ

315
00:21:05,890 --> 00:21:08,200
أَلن تسأليني عن نيو؟

316
00:21:08,200 --> 00:21:08,690
ماذا؟

317
00:21:09,510 --> 00:21:11,520
.لا شكّ أنّكِ على درايةٍ بما جرى

318
00:21:13,790 --> 00:21:18,490
أَلستِ أخته؟ أَليس القلق على كُلّ
شاردةٍ وواردة هو ديدن العائلات؟

319
00:21:21,980 --> 00:21:25,220
،نباهتك ليست بثاقبةٍ كما ظننت
أليس كذلك يا هاجيمي-تشان؟

320
00:21:25,480 --> 00:21:27,160
ماذا تقصدين بهذا؟

321
00:21:29,640 --> 00:21:31,440
،لأنّنا عائلةٌ
...فأنا أعلم يقينًا

322
00:21:38,240 --> 00:21:40,740
...أنّ أخي لا بُدّ وأنّه

323
00:21:44,940 --> 00:21:49,950
روابط

324
00:23:20,090 --> 00:23:25,470
الحلقة القادمة

325
00:23:22,140 --> 00:23:24,750
.مجرى الزّمان يزداد ضراوةً

326
00:23:25,160 --> 00:23:31,080
وفوضاه تتسارع، وها هُم المِيبورو
.يندفعون نحو مُنعطفٍ مصيريّ

327
00:23:31,920 --> 00:23:39,550
،ومع تبدّي الأوراق الخضراء اليانعة
،يتجاوز الذّئاب الصّغار مرارة الحُزن والألم

328
00:23:40,010 --> 00:23:43,240
.ساعين لاكتشاف حقيقتهم

329
00:23:44,290 --> 00:23:46,530
."الحلقة القادمة: "المِيثاق الأزرق

330
00:23:47,110 --> 00:23:49,950
المِيثاق الأزرق

331
00:23:47,370 --> 00:23:48,520
.لن يخيب أملكم