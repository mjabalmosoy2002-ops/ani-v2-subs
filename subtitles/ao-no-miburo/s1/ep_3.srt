1
00:00:01,170 --> 00:00:04,040
أشبحٌ يَسكن بيت ياجي ليلًا؟

2
00:00:04,040 --> 00:00:05,720
.كُفّ عن الهُراء

3
00:00:11,980 --> 00:00:13,720
.ناغاكورا-سان

4
00:00:14,460 --> 00:00:16,370
!ها قد ظهر الشّبح

5
00:00:19,460 --> 00:00:21,520
.لنتخلّص مِن هذا الشّعر الأشعث

6
00:00:21,520 --> 00:00:24,370
.شـ-شكرًا لك، كوندو-سان

7
00:00:24,660 --> 00:00:28,520
ليس عليّ الآن سوى أن أُنشّفه
.وأُمرّر يدي خلاله

8
00:00:29,530 --> 00:00:30,640
!ما هذا؟ أأنت حصانٌ؟

9
00:00:33,770 --> 00:00:36,800
بما في ذلك أنا، أصبح المِيبورو الآن
.خمسة عشر رجلًا أشدّاء

10
00:00:37,600 --> 00:00:39,800
أوشكتُ على حفظ أسمائهم
.ووجوههم تمامًا

11
00:00:45,230 --> 00:00:46,830
ماذا؟ صبيّ؟

12
00:00:47,920 --> 00:00:50,770
،صباح الخير
هل نلتَ قسطًا جيدًا مِن النّوم؟

13
00:00:50,770 --> 00:00:52,270
عجبًا! مَن هذا؟

14
00:00:52,860 --> 00:00:55,760
.أ-أجل، فعلت

15
00:00:56,860 --> 00:01:01,290
،اسمي تشيرينو نيو
.انضممتُ إلى المِيبورو قبل يومين

16
00:01:01,790 --> 00:01:04,120
.أُدعى تاناكا تارو

17
00:01:04,400 --> 00:01:06,670
.وأنا مثلك، أنتمي إلى المِيبورو

18
00:01:07,870 --> 00:01:09,670
حقًا؟ كم تبلغ مِن العمر؟

19
00:01:10,000 --> 00:01:12,110
.أُتمم الثّالثة عشرة

20
00:01:12,110 --> 00:01:14,320
حقًا؟
.وأنا كذلك في الثّالثة عشرة

21
00:01:14,720 --> 00:01:16,880
.مهلًا، هذا غريب

22
00:01:17,260 --> 00:01:20,140
مررتُ البارحة على الجميع
.لأحفظ وجوههم

23
00:01:20,510 --> 00:01:22,560
.ولم أرك في أيّ مكان

24
00:01:22,860 --> 00:01:24,240
...ذلك لأنّني

25
00:01:24,810 --> 00:01:26,720
.أنام في الخزانة

26
00:01:26,720 --> 00:01:27,850
!لماذا؟

27
00:01:27,850 --> 00:01:28,590
!نيو

28
00:01:29,880 --> 00:01:32,120
،حان وقت التّدريب الصباحيّ
ماذا تفعل؟

29
00:01:32,440 --> 00:01:35,760
،هيجيكاتا-سان
...كنتُ أسأل تارو-كن عن

30
00:01:36,480 --> 00:01:37,440
مـ-ماذا؟

31
00:01:41,150 --> 00:01:45,160
،هذا هو الفتى الّذي كنت تتساءل بشأنه
.أوّل ذئبٍ انضمّ لنا مِن كيوتو

32
00:01:45,160 --> 00:01:47,450
...أَهو كذلك؟ إذًا

33
00:01:47,860 --> 00:01:49,830
.ابقَ بعيدًا عن تارو

34
00:01:50,190 --> 00:01:52,080
لماذا يا سيّدي؟

35
00:01:52,480 --> 00:01:53,830
.لا تسألنَّ عن السّبب

36
00:02:13,240 --> 00:02:18,950
ذئاب ميبو الزّرق

37
00:03:37,580 --> 00:03:38,720
.أراك تعمل بجد

38
00:03:42,050 --> 00:03:43,370
هل تُمانع لو جرّبت؟

39
00:03:45,770 --> 00:03:47,920
،حين تشقّ الحطب
.ثبّت الفأس فيه

40
00:03:48,680 --> 00:03:50,010
.ثم أنزِلها دفعةً واحدة

41
00:03:52,120 --> 00:03:54,620
أَرأيت؟ يكون الشقّ أكثر استقامةً
.بهذه الطّريقة

42
00:03:55,030 --> 00:03:56,160
.محقّ

43
00:03:56,420 --> 00:03:57,930
.حسنًا إذن، سأتولّى البقية

44
00:03:58,250 --> 00:04:00,040
!كلا، قُمتَ بما يكفي

45
00:04:00,040 --> 00:04:02,600
،لا بأس
.لديّ متّسعٌ مِن الوقت

46
00:04:03,820 --> 00:04:06,090
.كفى! أرجوك، توقّف

47
00:04:07,560 --> 00:04:08,980
.آ-آسف

48
00:04:19,550 --> 00:04:23,240
لماذا انضممتَ إلى المِيبورو؟
.يا تارو-كون

49
00:04:23,920 --> 00:04:27,240
.لأنّه ما عاد لي مكانٌ آخر سواه

50
00:04:27,650 --> 00:04:28,160
ماذا؟

51
00:04:31,030 --> 00:04:38,370
،بالنّسبة لي أردتُ مساعدة الجميع في حماية كيوتو
.وجعل العالم مكانًا أفضل

52
00:04:46,360 --> 00:04:48,010
.يا له مِن كلامٍ ساذج

53
00:04:48,020 --> 00:04:49,020
ماذا؟

54
00:04:50,860 --> 00:04:51,830
.أستميحك عُذرًا

55
00:04:58,080 --> 00:04:59,280
.رأيتُ كُلّ شيء

56
00:04:59,280 --> 00:05:00,860
!أ-أوكيتا-سان

57
00:05:01,310 --> 00:05:05,860
ألم ينهَكَ هيجيكاتا-سان عن
مخالطة تارو-كون والاقتراب منه؟

58
00:05:06,320 --> 00:05:08,860
.أ-أرجوك، لا تُخبره

59
00:05:09,180 --> 00:05:11,250
.لا أعلم إن كان يسعني ذلك

60
00:05:11,680 --> 00:05:14,870
لكنّي أودّ المزيد مِن حلوى
.الدّانغو مِن دكّان تشيرينويا

61
00:05:20,180 --> 00:05:26,030
عثر سيريزاوا-سان على الصّغير تارو في مكانٍ ما
.لا يَعلمه أحد، في اليوم ذاته الّذي وصلنا فيه إلى كيوتو

62
00:05:26,240 --> 00:05:30,080
سيريزاوا-سان؟ أَتقصد ذلك الرّجل
الطّريف مِن مصارعة السّومو؟

63
00:05:30,910 --> 00:05:32,030
.نعم، هو بعينه

64
00:05:32,470 --> 00:05:36,360
،قد يكون طريفًا حقًا
.لكن له جانبًا جامحًا

65
00:05:37,280 --> 00:05:40,950
فهو لا يكفّ عن ضرب
.الصّغير تارو وركله

66
00:05:40,950 --> 00:05:41,990
.هذا فظيع

67
00:05:41,990 --> 00:05:45,770
لكن يبدو أنّ الصّغير تارو
.يروق له الأمر على هذا النحو

68
00:05:46,310 --> 00:05:46,880
ماذا؟

69
00:05:48,120 --> 00:05:53,040
هيجيكاتا-سان أخبرك أن
.تتجنّب تارو-كون لأنّه قَلِق عليك

70
00:05:55,160 --> 00:05:56,170
.فهمت

71
00:05:58,470 --> 00:05:59,760
هل هناك ما يشغل بالك؟

72
00:06:00,250 --> 00:06:01,040
.كلا

73
00:06:01,640 --> 00:06:03,680
كنت آمل فحسب أن أتبادل
،مع تارو أطراف الحديث قليلًا

74
00:06:04,580 --> 00:06:07,300
.فأنا أرغب في أن أعرف المزيد عنه

75
00:06:08,240 --> 00:06:14,940
.يبدو لي أنّك تُريد أن تُصادقه

76
00:06:16,010 --> 00:06:17,890
أُصادقه؟

77
00:06:18,560 --> 00:06:20,550
وأيُّ نوعٍ من العلاقات هي الصّداقة؟

78
00:06:21,000 --> 00:06:22,710
.سؤالٌ جيد

79
00:06:24,150 --> 00:06:26,320
.أمسك بيدي

80
00:06:27,240 --> 00:06:28,640
يـ-يدك؟

81
00:06:34,210 --> 00:06:36,080
.أغمض عينيك

82
00:06:36,500 --> 00:06:38,380
عـ-عينيّ؟

83
00:06:38,680 --> 00:06:40,940
،أيًا كان ما سيحدث
.إيّاك أن تفتحهما

84
00:06:40,940 --> 00:06:43,580
.ثق بي مهما فعلت

85
00:06:43,580 --> 00:06:45,000
.أ-أجل سيّدي

86
00:06:46,430 --> 00:06:47,700
.ها قد أغمضتهما

87
00:06:51,460 --> 00:06:53,890
،والآن
إلى أين ينبغي أن نذهب؟

88
00:06:54,490 --> 00:06:57,730
وجدتها! ما رأيك بالذهاب
إلى النّهر لصيد السمك؟

89
00:06:58,040 --> 00:07:00,480
ماذا؟
...ولكن كيف لي أن

90
00:07:00,930 --> 00:07:04,140
،لا تقلق
.ليس هناك ما تخشاه

91
00:07:04,140 --> 00:07:06,360
...ولـ-ولكن، ولكن

92
00:07:06,360 --> 00:07:08,870
.لنتوقّف عند بيت الخلاء أولًا

93
00:07:08,870 --> 00:07:09,970
ماذا؟

94
00:07:12,150 --> 00:07:13,740
.افتح عينيك الآن

95
00:07:23,500 --> 00:07:25,630
.الريبة تتسلّل لنفوس البشر

96
00:07:26,050 --> 00:07:27,250
.تلك هي فطرتنا

97
00:07:28,990 --> 00:07:30,380
،لكنّنا نتوق للإيمان بشيءٍ ما

98
00:07:31,030 --> 00:07:33,200
،وتلك أيضًا فطرتنا
أليس أمرًا غريبًا؟

99
00:07:34,070 --> 00:07:36,360
استطعتَ الوثوق بي
.حتّى وأنت مغمض العينين

100
00:07:36,760 --> 00:07:40,020
أظنّ أنّ هذا هو
.المعنى الحقيقيّ للصّداقة

101
00:07:41,400 --> 00:07:44,410
!هاتوا الطعام
!أنا جائعٌ حدّ الهلاك

102
00:07:44,420 --> 00:07:46,770
.لا بُدّ أنّه وقت العشاء

103
00:07:49,620 --> 00:07:50,190
ماذا؟

104
00:07:50,650 --> 00:07:54,020
،الآن وقد فكّرت في الأمر
.لا أرى أثرًا لسيريزاوا-سان أو أيّ مِن رفاقه

105
00:07:58,440 --> 00:08:00,400
.يا رجل، أنا ثملٌ تمامًا

106
00:08:00,720 --> 00:08:03,040
!لم أنتهِ مِن الشّرب بعد

107
00:08:05,150 --> 00:08:07,650
.أشعر بقليلٍ مِن الدوار

108
00:08:08,200 --> 00:08:09,590
.مرحبًا بعودتك، سيّدي

109
00:08:11,170 --> 00:08:12,520
أوقعَ نفسه في المتاعب
.كما هو متوقّع

110
00:08:13,400 --> 00:08:14,360
.سيريزاوا-سان

111
00:08:15,290 --> 00:08:19,300
،توارى تونويتشي-دونو عن الأنظار
تُرى، ما الّذي حلّ به؟

112
00:08:20,800 --> 00:08:22,190
ماذا؟

113
00:08:22,190 --> 00:08:24,560
.أزهقتُ روحَه

114
00:08:24,560 --> 00:08:28,040
.ويا للأسف على مِعطفي الأبيض المُفضّل

115
00:08:28,040 --> 00:08:29,490
أ-أزهقت روحَه؟

116
00:08:30,660 --> 00:08:32,560
!رفيقك مِن المِيبورو؟

117
00:08:32,830 --> 00:08:35,000
.ماذا؟ أجل

118
00:08:35,000 --> 00:08:36,560
...المدعو تونويتشي

119
00:08:37,650 --> 00:08:40,010
كان واحدًا مِن زملائنا الرّونين
.الّذين رافقونا في رحلتنا مِن إيدو

120
00:08:40,700 --> 00:08:42,980
كـ-كيف طاوعته نفسه فعلها؟

121
00:08:43,510 --> 00:08:48,360
ولكن سيريزاوا-سان، ماذا لو علِمَ
رجال الشّوغون بما اقترفت يداك؟

122
00:08:49,440 --> 00:08:51,880
.أصبتَ في قولك

123
00:08:53,730 --> 00:08:57,220
.تارو، قُم بتنظيف المكان

124
00:08:58,080 --> 00:09:01,260
.الجُثّة ملقاةٌ عند جسر شيجو

125
00:09:02,260 --> 00:09:04,790
...مـ-محالٌ أن يفعلها

126
00:09:06,440 --> 00:09:07,070
.أجل، سيّدي

127
00:09:13,070 --> 00:09:14,150
!تارو-كون

128
00:09:14,340 --> 00:09:14,940
!انتظر

129
00:09:14,940 --> 00:09:15,530
!نيو

130
00:09:17,050 --> 00:09:19,790
آمل أن تكون مستعدًا
.لتبِعات ما ستفعل

131
00:09:21,210 --> 00:09:21,810
.أجل، سيّدي

132
00:09:22,450 --> 00:09:24,910
.حسنًا إذن، انطلق الآن

133
00:09:25,500 --> 00:09:26,700
.جزيل الشّكر، سيّدي

134
00:09:36,250 --> 00:09:38,730
.قتلَ رفيقه حقًا

135
00:09:39,600 --> 00:09:41,640
.تماسك، تماسك

136
00:09:41,910 --> 00:09:43,440
.لا بُدّ أنّه تألم كثيرًا

137
00:09:44,440 --> 00:09:46,850
،تغمدتكَ السكينة
.طِب مقامًا في مثواك

138
00:09:56,600 --> 00:09:59,040
!تارو-كن! ماذا تفعل؟

139
00:09:59,040 --> 00:09:59,910
!اخرس

140
00:10:00,170 --> 00:10:03,410
،إن أثخنتُ جُثّته بالثقوب
.لن يطفو فوق الماء بعد أن أقذفه في النّهر

141
00:10:03,760 --> 00:10:06,480
!أأنتَ في كامل عقلك؟

142
00:10:06,480 --> 00:10:07,590
!دعني وشأني

143
00:10:09,080 --> 00:10:12,160
،لم يَعُد هذا الجسد بشرًا
!ما هو إلا كتلةٌ مِن لحم

144
00:10:12,450 --> 00:10:13,920
!مَن ذا الّذي يأبه لما سأفعله به؟

145
00:10:13,920 --> 00:10:19,140
،كـ-كلا! ليس هذا هو المغزى
!كان ينبض بالحياة قبل بُرهةٍ وجيزة

146
00:10:19,600 --> 00:10:21,670
.المسألة تتعلّق بكرامة الإنسان

147
00:10:21,670 --> 00:10:24,060
!كانت هناك روحٌ تسكن هذا الجسد

148
00:10:25,540 --> 00:10:26,440
روح؟

149
00:10:27,680 --> 00:10:30,840
أأبصرت رُوحًا قطّ؟

150
00:10:30,840 --> 00:10:32,820
،إن كان للأرواح وجودٌ فعليّ
فدُلّني.. أين هي الآن؟

151
00:10:33,280 --> 00:10:34,820
...حسنًا

152
00:10:35,030 --> 00:10:36,570
.لهذا السّبب نعتّك بالسّاذج

153
00:10:36,570 --> 00:10:39,820
ستجعل العالم مكانًا أفضل"؟"
تُريد "المساعدة"؟

154
00:10:39,820 --> 00:10:41,080
!هراءٌ مَحضٌ وسُخفٌ لا ينتهي

155
00:10:41,820 --> 00:10:43,980
تجدُ ما تأكله، أليس كذلك؟

156
00:10:44,160 --> 00:10:45,730
ولديك فراشٌ تنام عليه؟

157
00:10:46,300 --> 00:10:47,980
هل ذُقتَ طعم الوحل يومًا؟

158
00:10:48,430 --> 00:10:51,290
أو اضطجعتَ في مكانٍ
تملؤه القاذورات والنّجاسات؟

159
00:10:51,920 --> 00:10:54,850
منذُ الثّالثة مِن عمري
.وأنا أتنقّل بين مهنٍ شاقّة

160
00:10:55,160 --> 00:10:57,550
.لم أكن أطمع في أكثر من النّجاة

161
00:10:57,940 --> 00:10:59,920
،وحين نموت
.ينتهي كُلّ شيء

162
00:10:59,920 --> 00:11:02,550
،ضاقت بي الدنيا
.ولم يَعُد لي سبيلٌ للبقاء إلّا في هذا المكان

163
00:11:03,090 --> 00:11:07,380
أين هي الرّوح في جسدي هذا؟
أو في ذاك؟

164
00:11:07,630 --> 00:11:09,320
،إن كانت موجودةً حقًا
!فأرِني برهانك

165
00:11:09,600 --> 00:11:12,060
!لا يُؤمن بما لا يراه إلا الحمقى

166
00:11:12,260 --> 00:11:16,640
سأنجو، وإن توجّب عليّ أن
!أتّخذ مِن أشلاء الموتى معبرًا لي

167
00:11:23,000 --> 00:11:26,680
يا لهول ما عاناه، لا يكاد عقلي
!يتخيّل مرارة الحياة الّتي عاشَها

168
00:11:30,920 --> 00:11:31,710
...ومع ذلك

169
00:11:33,000 --> 00:11:34,170
.ينبغي عليّ إيقافه

170
00:11:40,340 --> 00:11:44,710
،هيجيكاتا-سان
ألم يئن الوقت بعد لتعقّب أثر نيو؟

171
00:11:45,080 --> 00:11:47,320
.لا قُدرة لنا على استرجاع ما مَضى

172
00:11:47,560 --> 00:11:50,360
.وسيجد نيو لنفسه مخرجًا

173
00:11:51,060 --> 00:11:52,920
.فهو صبيٌّ خبر الأرض وعرك كدّها

174
00:11:53,230 --> 00:11:53,980
ماذا؟

175
00:11:54,320 --> 00:11:56,970
.تجمعنا الغاية ذاتها

176
00:11:58,180 --> 00:12:01,600
،ولأصدقكَ القول
.أنا أيضًا أرغب في التّغيير

177
00:12:02,870 --> 00:12:04,090
.تغيير مصير هذا العالم

178
00:12:08,930 --> 00:12:10,970
!تارو-كون، انظر

179
00:12:12,130 --> 00:12:13,350
!رقصةٌ بلا قميص

180
00:12:14,970 --> 00:12:16,970
هـ-هل تجدُ في هذا ما يُضحك؟

181
00:12:16,970 --> 00:12:18,240
.توقّفتَ عمّا تفعل

182
00:12:18,970 --> 00:12:20,160
.أنا لا أمزح

183
00:12:20,660 --> 00:12:23,420
،حين تُفكّر في الأمر بعقلٍ راجح
ألا يبدو لكَ غريبًا؟

184
00:12:24,740 --> 00:12:25,550
ماذا؟

185
00:12:26,110 --> 00:12:29,160
ما من أحدٍ سيتنزّه سكيرًا
.في هذه الأنحاء

186
00:12:30,960 --> 00:12:32,930
لم يكن هذا مُجرّد عراكٍ
.خرج عن السيطرة

187
00:12:33,530 --> 00:12:35,920
بل كانت جريمة قتلٍ
.خُطّط لها مسبقًا

188
00:12:36,800 --> 00:12:39,430
.نيو لا ينصاع للأوامر قطّ

189
00:12:39,620 --> 00:12:43,440
،إنّه طفلٌ غرّ كثير البكاء
.ولا يزال أمامه دربٌ شاقّ وطويل

190
00:12:43,850 --> 00:12:47,450
،تارو-كون
.أرجو أن تترك هذا الأمر لي

191
00:12:48,520 --> 00:12:52,780
لكن غايتي هي أن أستودع مستقبل
.المِيبورو أمانةً لدى مِن هم مثله

192
00:12:55,050 --> 00:12:57,470
تُريد منّي أن أترك الأمر بين يديك؟

193
00:12:58,000 --> 00:12:58,760
.أجل

194
00:12:59,650 --> 00:13:04,080
أَفقدت صوابك؟! سيريزاوا-سان سيُجهز
!عليّ حتمًا إن تسبّبتَ في إفساد الأمر

195
00:13:04,750 --> 00:13:05,530
.أعلم ذلك

196
00:13:07,100 --> 00:13:09,120
!إنّه... إنّه مجنون

197
00:13:09,120 --> 00:13:12,130
،لا يُمكنني الوثوق بأمثاله
!فصحبتهم ستقودني إلى الهلاك لا محالة

198
00:13:14,200 --> 00:13:16,730
.ليس في عينيه أدنى ذرّةٍ مِن تردّد

199
00:13:17,880 --> 00:13:19,610
.حـ-حسنًا

200
00:13:19,610 --> 00:13:20,970
ماذا تبتغي منّي أن أفعل؟

201
00:13:21,440 --> 00:13:23,200
.لنبدأ أولًا بحمل تونويتشي-سان

202
00:13:23,600 --> 00:13:24,230
.لك ذلك

203
00:13:26,890 --> 00:13:29,000
.إنّه... إنّه ثقيلٌ جدًا

204
00:13:29,300 --> 00:13:30,580
.ليس هكذا، لن تستطيع

205
00:13:30,850 --> 00:13:34,580
،حين تحمل حِملًا ثقيلًا
.عليك أن تلتصق به تمامًا

206
00:13:35,090 --> 00:13:38,500
،حرّكه برفق
.كي لا يتأذى جسده أكثر

207
00:13:42,150 --> 00:13:43,430
.ثبّته جيدًا

208
00:13:43,760 --> 00:13:45,540
.هذا شاقّ

209
00:13:45,540 --> 00:13:47,760
.لا تقلق، سننجح في فعلها

210
00:13:52,800 --> 00:13:53,900
.حسنًا

211
00:13:55,310 --> 00:13:56,770
أأتممنا المُهمّة كما يجب؟

212
00:13:56,770 --> 00:13:57,610
.أجل

213
00:14:01,530 --> 00:14:04,510
!سيريزاوا-سينسي
!نحن في مأزق

214
00:14:04,510 --> 00:14:05,520
ماذا؟

215
00:14:10,160 --> 00:14:12,320
،أفسحوا الطّريق! هيّا
!أخلوا المسار

216
00:14:12,320 --> 00:14:15,520
،أفسحوا الطّريق للسّاموراي العظيم
!سيريزاوا-سينسي

217
00:14:18,240 --> 00:14:19,510
.يا للفظاعة

218
00:14:19,510 --> 00:14:20,960
!مزّقوه إربًا

219
00:14:20,960 --> 00:14:22,390
مَن الضحية؟

220
00:14:22,390 --> 00:14:23,660
ومَن الّذي قتله؟

221
00:14:23,660 --> 00:14:25,720
.تبًا لذلك المدعو تارو

222
00:14:25,720 --> 00:14:27,040
!سأقضي على ذلك الوغد

223
00:14:29,860 --> 00:14:33,360
،قبعةٌ مِن القش، وجوارب سفر
.وسيف، ومتاع

224
00:14:33,360 --> 00:14:35,270
.لا بُدّ أنّ القتيل كان مسافرًا

225
00:14:35,270 --> 00:14:36,640
!يا للبشاعة

226
00:14:36,640 --> 00:14:38,810
أَتعتقد أنّ اللصوص نالوا منه؟

227
00:14:42,190 --> 00:14:44,060
.أَهذه هي الحيلة إذًا

228
00:14:44,340 --> 00:14:46,780
كان مِن المُتوقّع أن
.يعثر أحدهم على الجُثّة

229
00:14:47,030 --> 00:14:50,220
لذا كان التمويه الخيار الأمثل
.في مثل هذه الظروف

230
00:14:50,680 --> 00:14:53,560
أراهن أنّ هيجيكاتا
.هو مَن دبّر هذا الأمر

231
00:14:54,330 --> 00:14:55,530
هيجيكاتا؟

232
00:14:55,990 --> 00:14:57,210
.ذلك الوغد

233
00:15:03,880 --> 00:15:09,290
،والآن
كيف سنقوم بتسوية هذه المسألة؟

234
00:15:13,790 --> 00:15:15,120
.جئتَ في الوقت المناسب

235
00:15:15,410 --> 00:15:17,910
لديه هو الآخر سؤالٌ
.يودّ طرحه عليك

236
00:15:18,570 --> 00:15:21,340
،أنا تشيرينو نيو
.التقينا قبل يومين

237
00:15:21,870 --> 00:15:27,410
تعارفٌ رسميّ إذًا؟
.تُعجبني ثقتك بنفسك

238
00:15:29,190 --> 00:15:33,610
تارو، أرجو أن تكون
.مُستعدًا لما ينتظرك

239
00:15:37,820 --> 00:15:39,960
،لا عجلة
.فكُلّ شيءٍ في أوانه

240
00:15:39,960 --> 00:15:41,120
ما هو سؤالك؟

241
00:15:43,340 --> 00:15:48,230
،نودّ أن نسمع أسبابك لقتل رفيقك
.تونويتشي-سان

242
00:15:49,860 --> 00:15:51,090
ماذا؟

243
00:15:51,090 --> 00:15:54,840
،ماذا؟! إنّه أحمق! غبي، غبي
!غبي، غبي، غبي، غبي، غبي، غبي

244
00:15:59,150 --> 00:16:00,810
!إذًا أنت مَن فعلها

245
00:16:00,810 --> 00:16:03,050
!أنت مَن قام بذلك التمويه اللعين

246
00:16:03,500 --> 00:16:06,870
تسألني لماذا أزهقت رُوحه؟

247
00:16:06,870 --> 00:16:10,860
!هكذا فحسب
.طعنته في لحظة سُكرٍ ونوبة غضبٍ

248
00:16:10,860 --> 00:16:12,610
.نحن في عداد الموتى

249
00:16:16,830 --> 00:16:21,830
،أزهقت رُوحه مِن أجل مصلحة المِيبورو
أأنا مُخطئ؟

250
00:16:22,420 --> 00:16:23,500
ماذا؟

251
00:16:32,650 --> 00:16:34,240
.لا تحرّك ساكنًا

252
00:16:35,150 --> 00:16:40,180
،بمقدوري قصم عُنقك بيُسرٍ شديد
.أيّها الصّبي

253
00:16:40,460 --> 00:16:43,440
فكّر مليًا قبل أن ينطق
.لسانك بحرفٍ آخر

254
00:16:44,270 --> 00:16:47,080
لا يُمكن شراء الخمر في
.أيّ مكانٍ قريبٍ مِن ذلك الجسر

255
00:16:47,440 --> 00:16:50,400
لذا، أجدُ صعوبةً في تصديق
.أنّك مررت مِن هناك بمحض الصّدفة

256
00:16:50,400 --> 00:16:51,470
أَهذا ما تدّعيه؟

257
00:16:51,470 --> 00:16:55,400
سيريزاوا-سان، قُلت إنّك أزهقت
.رُوحه في نوبة غضبٍ وأنت ثمل

258
00:16:55,400 --> 00:17:00,570
،لكنّي أظنّ أنّك استدرجته إلى هناك
.وقتلته بدمٍ بارد

259
00:17:00,980 --> 00:17:05,090
...إذًا، لو كنت تملك
...سببًا واضحًا لتبرير مقتله

260
00:17:13,870 --> 00:17:15,120
.تابع حديثك

261
00:17:16,600 --> 00:17:17,300
.حسنًا، يا سيّدي

262
00:17:17,560 --> 00:17:18,850
...أزهقت رُوحه

263
00:17:20,040 --> 00:17:24,480
لأنّ تونويتشي-سان كان
.خائنًا يعتزم الوشاية بالمِيبورو

264
00:17:28,870 --> 00:17:32,230
فتّش هيجيكاتا-سان في
.مقتنيات تونويتشي-سان مِن أجلي

265
00:17:32,860 --> 00:17:39,360
فوجد خطاباتٍ يسعى فيها للعمل
.مُنفردًا ويُقدّم فيها أسرارًا للمُتمرّدين

266
00:17:39,720 --> 00:17:41,850
.لم تَجد بُدًا مِن قتله

267
00:17:43,280 --> 00:17:44,640
.فكان مصيره القتل على يدك

268
00:17:45,370 --> 00:17:47,040
.صونًا لكيان المِيبورو

269
00:17:54,530 --> 00:17:56,160
.يا للعجب

270
00:17:59,220 --> 00:18:06,230
لم أظنّ أنّ صعلوكًا مثلك بمقدوره
.تخمين ما يدور في خلد العُظماء

271
00:18:11,120 --> 00:18:13,760
،أفهم ذلك
.وأعتذر عن إزعاجك

272
00:18:19,800 --> 00:18:24,490
إن كان صحيحًا أنّك أزهقت رُوحه
،لمجرّد أنّ الخمر غيّب عقلك

273
00:18:25,080 --> 00:18:28,880
ثُمّ استغللتَ تارو-كون
...ليُغطّي على جريمتك

274
00:18:29,600 --> 00:18:33,210
وإن يكن؟
ما الّذي بوسعك فعله حينها؟

275
00:18:36,800 --> 00:18:39,070
،لن أفعل شيئًا
.اعتبِر كُلّ ما قُلته كأن لم يكن

276
00:18:44,680 --> 00:18:48,350
ما زلت لا أُدرك التصرّف
.الصحيح الّذي يجب اتّخاذه

277
00:18:49,080 --> 00:18:51,600
...لكُلّ شخصٍ هنا
.مفهومه الخاص عن العدالة

278
00:18:57,990 --> 00:19:00,110
هل فقدت صوابك؟

279
00:19:01,840 --> 00:19:03,250
.بلغ بي التوتّر مبلغه

280
00:19:03,250 --> 00:19:07,070
!تماديت في التّهور إِلى حدٍ لا يُعقل
.كنت على شفا حُفرةٍ مِن الموت في تلك اللحظة

281
00:19:07,070 --> 00:19:09,450
.كلا، لم يكن ليقتلني حينها

282
00:19:09,970 --> 00:19:14,670
بلى، كان ليفعل! لست على قيد الحياة
.إلا لأنّ مزاجه صدف أن كان رائقًا

283
00:19:17,010 --> 00:19:20,180
،هذا ليس مضحكًا
!ولا حتّى قليلًا

284
00:19:20,340 --> 00:19:22,200
.حسنًا إذن، أستأذنكم الآن

285
00:19:23,360 --> 00:19:24,770
.هيجيكاتا

286
00:19:25,980 --> 00:19:28,880
.أخبرني عن ذلك الصبيّ

287
00:19:29,390 --> 00:19:30,850
.إنّه مجرّد طفل

288
00:19:31,180 --> 00:19:36,940
،كلا، لا أظنّ ذلك
.فلا يوجد طفل طبيعيّ يملك جرأةً كهذه

289
00:19:39,020 --> 00:19:44,440
سيريزاوا-سان، تُصرّ دائمًا على
.إنجاز الأمور بالقوّة المُفرطة

290
00:19:46,950 --> 00:19:51,210
القائد البارع لا يخشى
.تحمّل مسؤوليّة أخطائه

291
00:19:56,010 --> 00:19:57,190
لماذا أشعلت النار؟

292
00:19:57,520 --> 00:20:02,170
،تمنّيت لو واريته الثّرى
.لكن ذلك أمرٌ لا نقدر عليه الآن

293
00:20:03,400 --> 00:20:10,970
،لذا، حتّى وإن عاد جسده إِلى التراب
.أريد لروحه أن تُحلّق حُرّةً في عنان السماء

294
00:20:12,810 --> 00:20:14,360
أين هي الرّوح؟

295
00:20:14,730 --> 00:20:16,600
،إن كانت موجودةً حقًا
!فأرِني برهانك

296
00:20:17,260 --> 00:20:20,260
أتتحدّث بجدية؟
.لا أستطيع استيعاب منطقك أبدًا

297
00:20:21,650 --> 00:20:22,340
حقًا؟

298
00:20:22,910 --> 00:20:27,100
لا أرى من الإِنصاف
...إنكار وُجود الشّيء

299
00:20:28,150 --> 00:20:31,190
.ما لم تملك دليلًا ينفي وُجوده

300
00:20:34,440 --> 00:20:36,870
.أنا لا أفهمك على الإطلاق

301
00:20:37,530 --> 00:20:38,850
!خطرت لي فكرة
.يا تارو-كون

302
00:20:40,670 --> 00:20:41,920
.أمسك بيدي

303
00:20:41,920 --> 00:20:43,700
.ماذا؟ محالٌ

304
00:20:43,700 --> 00:20:44,890
.افعلها فقط

305
00:20:45,360 --> 00:20:47,280
،لا تنطق بكلمة
.أغمض عينيك

306
00:20:47,280 --> 00:20:48,130
ولماذا أطاوعك؟

307
00:20:48,360 --> 00:20:50,160
،أيًا كان ما سيحدث
.إيّاك أن تفتحهما

308
00:20:50,350 --> 00:20:51,520
.ولا حتّى قليلًا

309
00:20:52,970 --> 00:20:54,650
.حـ-حسنًا

310
00:20:55,680 --> 00:20:58,070
.ثق بي مهما فعلت

311
00:20:58,320 --> 00:20:59,770
.حـ-حسنًا

312
00:20:59,770 --> 00:21:02,530
.والآن، لنقم بجولةٍ حول المقر

313
00:21:03,520 --> 00:21:05,090
ماذا؟ هكذا؟

314
00:21:06,040 --> 00:21:09,890
أعلم أنّ بمقدورك الوصول إلى غرفة
.سيريزاوا-سان حتّى وأنت مُغمض العينين

315
00:21:09,890 --> 00:21:12,040
!ماذا؟ لا بُدّ أنّك تمزح

316
00:21:12,040 --> 00:21:14,120
.لا تقلق، سأكون معك

317
00:21:14,120 --> 00:21:16,010
!وجودك يجعل الأمر أسوأ

318
00:21:16,550 --> 00:21:19,190
هل تُمانع لو مررنا ببيت الخلاء أولًا؟

319
00:21:19,190 --> 00:21:20,810
ماذا؟
!ولِمَ عليّ مرافقتك إلى هناك؟

320
00:21:22,310 --> 00:21:24,630
.حسنًا، افتح عينيك

321
00:21:33,070 --> 00:21:36,060
ما قولك؟
لم يكن مُخيفًا حقًا، أليس كذلك؟

322
00:21:36,250 --> 00:21:38,230
!بلى
!بلغ بي الذّعر مبلغه

323
00:21:38,230 --> 00:21:39,760
!توقّف عن التّلاعب بأعصابي

324
00:21:39,760 --> 00:21:41,870
لماذا؟

325
00:21:41,870 --> 00:21:44,910
ألسنا صديقين بعد؟

326
00:21:44,950 --> 00:21:49,950
حيث
تسكن

327
00:21:44,950 --> 00:21:49,950
الرّوح

328
00:23:20,090 --> 00:23:25,510
الحلقة القادمة

329
00:23:22,710 --> 00:23:23,900
.تشيرينو نيو يُحدّثكم

330
00:23:23,900 --> 00:23:28,880
لست أنا وتارو-كون
.الصبيّين الوحيدين في المِيبورو

331
00:23:28,900 --> 00:23:31,310
ثمّة فتىً آخر
.يُدعى سايتو هاجيمي-كون

332
00:23:31,730 --> 00:23:36,840
،رغم طباعه الخشنة ونظراته الحادة
.إلّا أنّه يملك رُوحًا قتاليةً تُضاهي أشدّاء الرجال

333
00:23:37,260 --> 00:23:42,270
أتساءل إن كان سيصبّ جام
!غضبه عليّ لأنّي ناديته طفلًا

334
00:23:43,120 --> 00:23:44,960
."الحلقة القادمة: "اسم العدوّ

335
00:23:45,290 --> 00:23:46,300
.لن يخيب أملكم

336
00:23:47,110 --> 00:23:49,940
اسم

337
00:23:47,110 --> 00:23:49,940
العدوّ