1
00:00:01,980 --> 00:00:04,400
،إليك طلبك مِن الدّانغو
.وهُلام المشمش أيضًا

2
00:00:05,150 --> 00:00:07,090
!شـ-شكرًا لانتظارك

3
00:00:07,090 --> 00:00:08,540
.صدقت الجدّة

4
00:00:08,920 --> 00:00:10,980
...إن كان البشر الّذين نلتقيهم كُنوزًا

5
00:00:11,210 --> 00:00:12,250
!مرحبًا

6
00:00:14,100 --> 00:00:18,010
...فإنّ ذلك اللّقاء لا بُدّ وأن يكون

7
00:00:19,540 --> 00:00:22,120
.أعظم كنزٍ ظفرت به في حياتي

8
00:00:36,220 --> 00:00:41,930
ذئاب ميبو الزّرق

9
00:02:01,870 --> 00:02:03,210
.ماءٌ

10
00:02:03,810 --> 00:02:04,850
!أرجوكم، ماءٌ

11
00:02:04,850 --> 00:02:06,480
هـ-هل أنت بخير؟

12
00:02:06,720 --> 00:02:09,060
أَتحتاج إلى الماء؟
.سآتيك به حالًا

13
00:02:15,080 --> 00:02:16,240
!كوبًا آخر

14
00:02:17,560 --> 00:02:18,770
.إنّه يُريد كوبًا آخر

15
00:02:18,770 --> 00:02:19,990
!يا للإزعاج

16
00:02:20,430 --> 00:02:21,400
.تفضّل هاك الماء

17
00:02:31,380 --> 00:02:33,000
هل هذا دُكّان دانغو؟

18
00:02:33,140 --> 00:02:35,110
.أجل، ودُكّانٌ ممتاز حقًا

19
00:02:35,320 --> 00:02:37,710
دخلت إلى المكان دُون أن تعرف؟

20
00:02:38,060 --> 00:02:40,960
.انفتحت شهيّتي فجأةً

21
00:02:41,170 --> 00:02:42,680
.حسنًا، ها هُو مقعدك

22
00:02:45,110 --> 00:02:47,090
.كلا، أُريد الجُلوس في الخلف

23
00:02:47,090 --> 00:02:49,110
.لا تكن مُتطلّبًا هكذا

24
00:02:50,120 --> 00:02:51,390
،المعذرة

25
00:02:51,390 --> 00:02:53,600
.لم نُنظّف تلك الطّاولة بعد

26
00:02:53,600 --> 00:02:57,110
!كلا، كلا، كلا
.لن أجلس في غير ذلك المكان

27
00:02:57,110 --> 00:03:01,390
مَن تظنّ نفسك بحقّ الجحيم؟
.أنتم أيّها المُترفون محض صبيةٍ مُدلّلين

28
00:03:01,390 --> 00:03:02,810
!تارو، إنّه زبونٌ

29
00:03:03,500 --> 00:03:04,670
!أجل، يا سيّدتي

30
00:03:05,260 --> 00:03:06,280
!تارو

31
00:03:07,340 --> 00:03:08,750
.أحضر لي الشّاي

32
00:03:09,040 --> 00:03:11,130
مَن أعطاك الحقّ لتدعُوني تارو؟

33
00:03:11,670 --> 00:03:15,880
أنكو

34
00:03:11,670 --> 00:03:15,880
إيسوبي

35
00:03:11,670 --> 00:03:15,880
ميتاراشي

36
00:03:11,670 --> 00:03:15,880
كيناكو

37
00:03:12,040 --> 00:03:15,880
،نُقدّم أربعة أنواعٍ مِن الدّانغو
.بالإضافة إلى الدّانغو ثُلاثيّ الألوان

38
00:03:16,100 --> 00:03:18,960
حقًا؟
.سأطلب الأصناف كُلّها

39
00:03:18,960 --> 00:03:19,600
ماذا؟

40
00:03:19,600 --> 00:03:23,640
،أنا أُحبّ الحلوى جدًا
.سألتهمها كُلّها

41
00:03:25,620 --> 00:03:27,830
!ضِرسي يُؤلمني

42
00:03:27,830 --> 00:03:30,150
!غاب عن بالي ذلك التسوّس

43
00:03:30,150 --> 00:03:31,540
.تفضّل قليلًا مِن الشّاي

44
00:03:31,540 --> 00:03:33,020
!لا تُسايره يا نيو

45
00:03:33,740 --> 00:03:36,820
،يا هذا، لنكُن على بيّنةٍ
هل تملك ثمن ما طلبت؟

46
00:03:37,680 --> 00:03:38,560
ثمن ما طلبت؟

47
00:03:43,370 --> 00:03:45,440
.كلا، سجّلها على حسابي

48
00:03:45,440 --> 00:03:46,760
ماذا؟

49
00:03:46,760 --> 00:03:48,200
!إنّه يحاول الفرار

50
00:03:48,640 --> 00:03:50,700
.لن تبرح مكانك

51
00:03:50,930 --> 00:03:53,480
!هاجيمي، سُدّ عليه المخرج

52
00:03:53,820 --> 00:03:55,570
.أنا لا أتلقّى الأوامر منك

53
00:03:58,570 --> 00:04:03,590
،معذرةً على سؤالي
ولكن هل أُصيبت يدك اليُسرى؟

54
00:04:04,910 --> 00:04:08,220
،ارتطمت بشيءٍ فحسب
.لا تَشغل بالك

55
00:04:13,640 --> 00:04:16,790
،أهـ-أهلًا بك في دُكّان تشيرينويا
.تفضّل بالدّخول

56
00:04:22,430 --> 00:04:25,110
اسمك نيو، أليس كذلك؟
.اهرب

57
00:04:25,270 --> 00:04:26,040
ماذا؟

58
00:04:32,000 --> 00:04:35,190
مَن هذا الرّجل؟
.إنّه يرتدي ملابس بيضاء بالكامل

59
00:04:36,480 --> 00:04:38,260
.غادر هذا المكان فورًا

60
00:04:50,180 --> 00:04:52,850
!محالٌ
هل سيُلوّح بذلك الشّيء هنا؟

61
00:04:54,310 --> 00:04:55,400
.إنّه جادٌّ

62
00:04:56,840 --> 00:04:57,430
!نيو

63
00:05:14,500 --> 00:05:15,700
.أيّها الشّقي

64
00:05:18,640 --> 00:05:20,170
!لينجُ كُلّ منكم بنفسه

65
00:05:20,170 --> 00:05:20,720
!هاجيمي

66
00:05:28,280 --> 00:05:29,600
!استوليتُ على سيفه

67
00:05:31,150 --> 00:05:32,370
.انتهى أمرك

68
00:05:33,990 --> 00:05:36,980
مَن تكونون؟

69
00:05:37,400 --> 00:05:38,260
،نحن المِيبورو

70
00:05:38,610 --> 00:05:40,820
.حُماة هذه المدينة

71
00:05:42,180 --> 00:05:43,800
.فهمت

72
00:05:50,600 --> 00:05:52,320
.فهمت

73
00:05:55,810 --> 00:05:57,300
هل أنت راغبٌ بالمزيد؟

74
00:05:59,630 --> 00:06:01,330
هل رحل؟

75
00:06:01,330 --> 00:06:04,840
،مَن يحسب نفسه
ليُثير هذه الفوضى في دُكّاني؟

76
00:06:05,600 --> 00:06:06,780
هل أنت بخير؟

77
00:06:07,730 --> 00:06:08,750
ميبورو؟

78
00:06:09,300 --> 00:06:13,520
فهمت الآن، لم يَدر بخلدي
.أنّهم يضمّون صبيةً مثلكم

79
00:06:14,080 --> 00:06:15,800
.لعلّه القَدر

80
00:06:19,050 --> 00:06:20,850
ما هذا الّذي حَدث لتوّه؟

81
00:06:27,320 --> 00:06:29,100
.تارو، أَغلق ذلك الباب أيضًا

82
00:06:29,100 --> 00:06:30,000
!بسرعة

83
00:06:30,000 --> 00:06:32,200
!ماذا؟ لا تظنّ أنّك سيّدي

84
00:06:32,200 --> 00:06:34,080
ذاك الرّجل لا يزال جالسًا
!في الخارج

85
00:06:34,980 --> 00:06:36,080
ما الّذي تقوله؟

86
00:06:38,080 --> 00:06:40,400
معذرةً، ما اسمك؟

87
00:06:42,020 --> 00:06:43,000
.كيكوتشيو

88
00:06:43,560 --> 00:06:47,000
مَن أنت؟
ومَن ذاك الرّجل؟

89
00:06:47,720 --> 00:06:49,130
ولمَ يقتفي أَثرك؟

90
00:06:55,120 --> 00:06:58,350
.والآن، فليبدأ المَحفل

91
00:07:01,850 --> 00:07:03,200
.كيكوتشيو-سان

92
00:07:04,030 --> 00:07:06,350
ما بالك صمتَّ فجأةً؟

93
00:07:06,350 --> 00:07:08,990
انطق هيّا! هل أنت بطيء
الفهم إلى هذا الحدّ؟

94
00:07:09,590 --> 00:07:14,120
،مِن فضلك يا كيكوتشيو-سان
.نبتغي النّجاة مِن هذا المأزق

95
00:07:14,630 --> 00:07:17,750
.فأفصح عمّا لديك رجاءً

96
00:07:20,030 --> 00:07:23,750
،جرى ذلك فجأةً
.في ساعة الظّهيرة وأمام الملأ

97
00:07:25,010 --> 00:07:26,950
،باغتني بهمجيةٍ

98
00:07:27,230 --> 00:07:30,440
،فحاول حُرّاسي التصدّي له
.إلّا أنّ الأمر انقلب إلى فوضى عارمةٍ

99
00:07:31,520 --> 00:07:36,430
،فهربتُ ناجيًا بنفسي
.واحتميتُ بدُكّان الدّانغو هذا

100
00:07:36,940 --> 00:07:38,960
هجم عليك أمام الملأ؟

101
00:07:39,540 --> 00:07:41,020
مَن هذا الرّجل؟

102
00:07:41,020 --> 00:07:46,520
إنّه معتوهٌ بلا شكٍ، ما الّذي تودّ معرفته أكثر
.مِن ذلك؟ لا جدوى مِن الكلام مع معتوهٍ كهذا

103
00:07:47,540 --> 00:07:50,680
.أتساءل عمّا حلّ بمن تركتهم خلفي

104
00:07:51,580 --> 00:07:53,780
هل تعرف مَن يكون؟

105
00:07:54,890 --> 00:07:56,900
.كلا، ليس لديّ أدنى فكرةٍ

106
00:07:58,350 --> 00:08:03,280
لكنّني أستحضر أسبابًا لا حصر لها
.قد تجعل أحدهم يرغب في قتلي

107
00:08:03,450 --> 00:08:04,300
ماذا؟

108
00:08:04,300 --> 00:08:05,420
ولمَ ذلك؟

109
00:08:05,420 --> 00:08:07,830
أيّ حماقةٍ ارتكبتها لتجلب
لنا هذه المُصيبة؟

110
00:08:10,280 --> 00:08:12,820
!ابقَ بالخارج

111
00:08:12,820 --> 00:08:14,310
ما الّذي يحدث؟
!دعونا ندخل

112
00:08:17,350 --> 00:08:18,720
.كفى هُراءً

113
00:08:19,930 --> 00:08:21,330
أيّ لعبةٍ تلعبها معنا؟

114
00:08:21,330 --> 00:08:24,680
،أخبرونا إن كُنتم ستقضون ليلتكم هنا
.نال منّا القلق عليكم

115
00:08:25,100 --> 00:08:28,430
،هيجيكاتا-سان، أوكيتا-سان
.وتودو-سان أيضًا

116
00:08:28,430 --> 00:08:29,450
!يا للهول

117
00:08:29,730 --> 00:08:31,500
.مضى زمنٌ طويل يا سيّدتي

118
00:08:32,160 --> 00:08:34,320
.ما زلت تفيض وسامةً كعهدي بك

119
00:08:34,710 --> 00:08:37,440
يبدو أنّ الوقت لا يزال مبكرًا
.على إغلاق الدُكّان

120
00:08:37,440 --> 00:08:39,040
.أَوصد الباب حالًا

121
00:08:39,040 --> 00:08:42,070
فثمّة معتوهٌ يرتدي الأبيض
.جالسٌ بالخارج

122
00:08:42,070 --> 00:08:44,070
حقًا؟

123
00:08:44,880 --> 00:08:46,730
.لا أرى أحدًا

124
00:08:46,730 --> 00:08:48,370
ماذا؟ أين اختفى؟

125
00:08:50,780 --> 00:08:53,520
،لم أُبصر أيّ شخصٍ يرتدي الأبيض

126
00:08:54,920 --> 00:09:00,100
لكن ثمّة أشخاصًا مشبوهين
.يُراقبون الدُكّان

127
00:09:01,600 --> 00:09:02,900
ليس بمُفرده إذن؟

128
00:09:03,730 --> 00:09:05,400
.ستةٌ في المُجمل على ما أظنّ

129
00:09:05,820 --> 00:09:08,820
.أدركت مِن نظرةٍ واحدة أنّهم مُحترفون

130
00:09:08,880 --> 00:09:11,880
بل هُم سبعةٌ، أبصرتُ واحدًا
.يتسلّل مِن خلف الدُكّان

131
00:09:12,210 --> 00:09:17,120
،لمحناهم ونحن في طريقنا للدّخول
.لكن الاشتباك معهم لم يكن مُمكنًا حينئذٍ

132
00:09:17,380 --> 00:09:19,620
هل لك أن تشرح لنا الموقف؟

133
00:09:20,000 --> 00:09:23,120
ينتابني شعورٌ بأنّ ثمّة
.أمرًا مثيرًا يحدث هنا

134
00:09:23,520 --> 00:09:25,870
.هذا كيكوتشيو-سان

135
00:09:26,840 --> 00:09:30,380
ذاك الرّجل المُرعب بثيابه البيضاء
.انقضّ عليه فجأةً

136
00:09:31,820 --> 00:09:34,390
مرعبٌ؟ ماذا عن أوصافه؟

137
00:09:34,700 --> 00:09:37,440
!كان يحمل سيفًا بهذا الطّول

138
00:09:37,440 --> 00:09:39,880
!وهمّ بضربنا به مُستخدمًا يدًا واحدة

139
00:09:39,880 --> 00:09:42,430
ماذا؟ ما هذا السّيف؟

140
00:09:42,660 --> 00:09:44,400
وكيف لمرءٍ أن يستلّه أو يُشهره أصلًا؟

141
00:09:44,400 --> 00:09:47,150
.لا بُدّ أنّ طُوله يصل إلى ستّة شاكو

142
00:09:47,310 --> 00:09:48,520
.كيكوتشيو

143
00:09:49,800 --> 00:09:51,820
ما الّذي يُؤرّقك يا هيجيكاتا-سان؟

144
00:09:52,320 --> 00:09:55,400
،في الواقع
،لم يتسنّ لي رُؤية الرّجل قطّ

145
00:09:55,830 --> 00:09:58,560
لكنّني سمعتُ أنّ هذا الاسم
.كان يُلقّب به في طفولته

146
00:09:58,890 --> 00:10:00,810
ما الّذي ترمي إليه؟

147
00:10:01,100 --> 00:10:02,460
...هل يُعقل أن تكون

148
00:10:03,080 --> 00:10:05,040
الشّوغون توكوجاوا إيموتشي؟

149
00:10:05,270 --> 00:10:06,910
الشّوغون؟

150
00:10:09,840 --> 00:10:11,920
ما الّذي تقصده بالشّوغون؟

151
00:10:12,430 --> 00:10:16,880
،الشّوغون هو الشّوغون يا عبقريّ
.أعلى سلطةٍ في اليابان

152
00:10:16,880 --> 00:10:18,280
،ليس الأمر كما تظنّ

153
00:10:19,760 --> 00:10:25,100
،فأنا سي إي تايشوغون
.المُكلّف بالحكم بأمرٍ مِن جلالة الإمبراطور

154
00:10:25,620 --> 00:10:28,180
،سواءٌ حملت اسم توكوجاوا أم لا
.فأنا حاكم منطقةٍ مثل بقيّة الإقطاعيّين

155
00:10:28,180 --> 00:10:29,870
.فهمت

156
00:10:30,550 --> 00:10:32,190
هذا يعني أنّك هو بالفعل؟

157
00:10:32,360 --> 00:10:36,200
اللّورد توكوجاوا إيموتشي
الّذي يزور كيوتو حاليًا؟

158
00:10:36,420 --> 00:10:37,200
.بالتّأكيد

159
00:10:37,430 --> 00:10:38,840
!ماذا؟

160
00:10:38,840 --> 00:10:41,480
!حقًا؟! الرّجل الأوّل في البلاد؟

161
00:10:41,480 --> 00:10:43,920
لكن كيف؟
!يُفترض أن تكون في قصر نيجو الآن

162
00:10:44,890 --> 00:10:45,920
هل هذه مزحةٌ؟

163
00:10:47,880 --> 00:10:51,400
!خمّنتُ أنّ لك سرًا

164
00:10:51,400 --> 00:10:54,400
،يا سيّدي المُبجّل
.أنا طوع أمرك إلى آخر رمقٍ

165
00:10:54,400 --> 00:10:56,590
.وما تتمنّاه نافذٌ لا محالة

166
00:10:56,900 --> 00:11:00,000
!ما هذه النّباهة
.تبدّلت نبرته سريعًا

167
00:11:00,000 --> 00:11:01,650
.إنّه يُجيد التصرّف في الأزمات

168
00:11:01,950 --> 00:11:03,460
كلا، أنا واثقٌ تمامًا
.أنّه لا يُجيد ذلك أبدًا

169
00:11:04,200 --> 00:11:05,930
إذن، ما هي خطوتنا التّالية؟

170
00:11:05,930 --> 00:11:08,720
ألا يعني هذا أنّ الأمور
قد تعقّدت أكثر الآن؟

171
00:11:08,720 --> 00:11:11,950
،معكِ حقٌ
.فكُلّ ثانيةٍ تمرّ قد تُكلّفنا الكثير

172
00:11:12,350 --> 00:11:17,490
،صدقتِ، ففي ظلّ الوضع الرّاهن
.هناك جموعٌ غفيرة مُتعطّشة لرأس الشّوغون

173
00:11:17,760 --> 00:11:21,650
،لـ-لنَستعِن بالمزيد مِن رجال المِيبورو
.ولينطلق أحدنا طلبًا للعون

174
00:11:21,650 --> 00:11:23,430
.إن استطعنا الخُروج مِن هنا أصلًا

175
00:11:23,940 --> 00:11:25,810
فنحن هالكون لا محالة
.إن بادروا بالهجوم

176
00:11:27,280 --> 00:11:30,100
،إنّنا على مقربةٍ مِن قصر نيجو

177
00:11:30,370 --> 00:11:33,080
.لن نستغرق أكثر مِن ساعةٍ مشيًا

178
00:11:35,190 --> 00:11:36,400
.لكنّنا لن نبلغه أبدًا

179
00:11:37,640 --> 00:11:39,220
.الأمر محسومٌ

180
00:11:39,460 --> 00:11:44,210
سنُرافق الشّوغون حتّى قلعة نيجو
.بمن معنا الآن مِن الرّجال لا غير

181
00:11:44,430 --> 00:11:45,720
.لا يُوجد خيارٌ آخر أمامنا

182
00:11:45,720 --> 00:11:48,220
لكن لا أَقبل أن أزجّ بكُم
.في هذه المَهلكة

183
00:11:48,500 --> 00:11:49,790
،لا تقلق

184
00:11:50,210 --> 00:11:55,100
فنحن المِيبورو لم نأتِ مِن إيدو
.في الأساس إلّا لحمايتك

185
00:11:56,700 --> 00:11:58,960
.الآن، لنتحدّث في التّفاصيل

186
00:11:59,640 --> 00:12:01,260
.ينبغي أن ننتظر حتّى المساء

187
00:12:02,760 --> 00:12:04,310
.خطرت لي فكرةٌ

188
00:12:05,040 --> 00:12:06,390
—طفلٌ؟ لا أعتقد أنّ

189
00:12:06,390 --> 00:12:07,450
.حسنًا، هات ما عندك

190
00:12:07,870 --> 00:12:09,060
.إليكم الخُطّة

191
00:12:09,360 --> 00:12:11,070
...أولًا، سنَنقسم إلى مجموعتين

192
00:12:19,330 --> 00:12:22,630
،حان الوقت
.آمل أنّكم على أهبة الاستعداد

193
00:12:22,920 --> 00:12:23,510
.أجل، يا سيّدي

194
00:12:23,510 --> 00:12:24,760
.لا مجال للفشل أبدًا

195
00:12:25,190 --> 00:12:26,720
.استعدّوا لكُلّ طارئٍ

196
00:12:26,720 --> 00:12:28,390
.اشتعلت الحماسة في صدري

197
00:12:30,110 --> 00:12:33,640
،أرجوك، أرجوك
.أسألك أن نبلغ مَقصدنا سالمين

198
00:12:33,660 --> 00:12:35,150
النّصر

199
00:12:37,390 --> 00:12:39,600
،معذرةً يا سيّدة

200
00:12:40,050 --> 00:12:42,600
.جلبت متاعبي إلى دُكّانكِ

201
00:12:43,140 --> 00:12:45,650
.أنت لا تُعجبني

202
00:12:45,900 --> 00:12:48,610
!جدّتي، إنّه الشّوغون

203
00:12:49,140 --> 00:12:52,220
سيّان عندي إن كان الشّوغون
.أو الإمبراطور شخصيًا

204
00:12:52,440 --> 00:12:54,390
.فالخطأ يبقى خطأً

205
00:12:54,870 --> 00:12:58,380
أنت لم تُحرّك ساكنًا لتُنقذ
.نفسك مِن ذلك الهجوم

206
00:12:58,380 --> 00:13:01,200
أيّ شخصٍ سيظنّ أنّك
.كُنت تنتظر الموت

207
00:13:01,380 --> 00:13:06,640
النّصر

208
00:13:01,840 --> 00:13:06,640
،على الوُلاة ألّا يتهاونوا بأرواحهم
.فهذا لا يجلب إلّا المتاعب للبُسطاء أمثالنا

209
00:13:08,640 --> 00:13:12,610
،دَع شأن العامّة للعامّة

210
00:13:08,640 --> 00:13:14,650
النّصر

211
00:13:12,610 --> 00:13:14,640
.فما هذا بشُغلك

212
00:13:14,910 --> 00:13:17,040
،أنت حاكمٌ
.فانشغل بما يليق بالحُكّام

213
00:13:17,040 --> 00:13:19,890
.كُلٌّ ميسرٌّ لما خُلِق له ومطالبٌ بالثّبات

214
00:13:20,120 --> 00:13:22,660
.وهذا أصل المسؤوليّة

215
00:13:26,840 --> 00:13:29,160
!استفق لنفسك أيّها الشّوغون

216
00:13:31,360 --> 00:13:32,440
.شاكرٌ لكِ

217
00:13:33,820 --> 00:13:38,540
بُليت اليابان بشابٍ مثلي
.يشغل منصب الشّوغون

218
00:13:38,860 --> 00:13:40,500
.أحسنتِ يا جدّة

219
00:13:40,070 --> 00:13:42,980
...لكن لعلّي مباركٌ بعض الشّيء

220
00:13:41,200 --> 00:13:43,180
!أخفتني يا جدّتي

221
00:13:43,180 --> 00:13:45,040
.أنا أُخاطر بحياتي طوال الوقت

222
00:13:45,940 --> 00:13:48,520
.أن يكون لي رعيّةٌ كهؤلاء

223
00:13:54,920 --> 00:13:55,810
.أضواءٌ

224
00:13:55,810 --> 00:13:56,800
.ها هُم قادمون

225
00:13:57,880 --> 00:14:00,570
.ائتوني برأس إيموتشي

226
00:14:01,500 --> 00:14:02,620
هل سأنجو؟

227
00:14:05,640 --> 00:14:06,320
.هيّا لننطلق

228
00:14:08,680 --> 00:14:09,550
.ها هُم هناك

229
00:14:09,760 --> 00:14:10,820
.إنّه إيموتشي

230
00:14:13,790 --> 00:14:15,200
.ماذا؟ لقد افترقوا

231
00:14:15,450 --> 00:14:16,780
أيّ طريقٍ سلكه إيموتشي؟

232
00:14:16,780 --> 00:14:19,000
!لا تدعوا أحدًا يفرّ، طاردوهم

233
00:14:26,000 --> 00:14:27,080
.ها قد انطلقوا

234
00:14:27,080 --> 00:14:29,480
،أرى ذلك
.إنّها لخدعةٌ بارعة

235
00:14:30,020 --> 00:14:34,220
ولكن هل سيكونون بخير؟
.لا أُريد لهم أن يموتوا بدلًا منّي

236
00:14:34,680 --> 00:14:37,050
،لا تشغل بالك بذلك

237
00:14:37,320 --> 00:14:39,960
.فهُم أشدّاء كالشّياطين

238
00:14:42,430 --> 00:14:43,480
!أنا الشّوغون

239
00:14:43,480 --> 00:14:46,060
!الشّوغون، الشّوعون

240
00:14:44,510 --> 00:14:46,060
.اصمتي أيّتها العجوز الخرفة

241
00:14:48,440 --> 00:14:50,270
.أحسنت صنعًا يا هيسكي

242
00:14:50,270 --> 00:14:52,080
.أعجبتني تلك الضّحكة المُصطنعة

243
00:14:52,080 --> 00:14:53,250
!انطلقا بأقصى سُرعةٍ

244
00:14:53,940 --> 00:14:58,170
سنعدّ حتّى الثّلاثين، ثُم نسلك
.الأزقّة الخلفيّة نحو قصر نيجو

245
00:14:58,460 --> 00:14:59,150
.حسنًا

246
00:15:04,760 --> 00:15:07,500
حسنًا، ماذا لدينا هنا؟

247
00:15:07,780 --> 00:15:10,260
كـ-كيف انكشفت خُطّتنا له؟

248
00:15:12,140 --> 00:15:17,660
إذن كلتا المجموعتين كانتا للتّمويه؟
.رُغم أنّ عدد الأشخاص بدا منطقيًا

249
00:15:17,660 --> 00:15:20,630
.اتّضح الأمر، المرأة العجوز

250
00:15:21,000 --> 00:15:27,050
كان مُرادكم أن يتسلّل إيموتشي خارجًا
.بعد أن نُولّي أدبارنا وتهدأ الجلبة

251
00:15:27,780 --> 00:15:30,790
،مثيرٌ للدّهشة
.حسبتم لكُلّ خُطوةٍ حسابًا

252
00:15:32,780 --> 00:15:35,710
.لكن الحظّ لم يكن لصالحكم

253
00:15:36,360 --> 00:15:37,690
...في الحقيقة

254
00:15:38,190 --> 00:15:40,480
.لم يكن سبب عودتي إلّا لنيل هذا

255
00:15:41,790 --> 00:15:45,720
لا يُمكن أن يكون الوضع أسوأ ممّا
.نحن فيه، ذهبت جُهودنا سُدىً

256
00:15:47,420 --> 00:15:48,240
.انطلقا الآن

257
00:15:50,680 --> 00:15:53,680
.سأمنحكما مُهلةً حتّى العدّ للعشرة

258
00:15:58,480 --> 00:16:01,530
،إنّه يتلاعب بنا
.فهو لا يرانا سوى طريدةٍ لا أكثر

259
00:16:02,760 --> 00:16:03,560
!كيكوتشيو-سان

260
00:16:04,720 --> 00:16:05,430
.لنذهب

261
00:16:05,430 --> 00:16:06,980
.واحدٌ

262
00:16:07,480 --> 00:16:09,110
.اثنان

263
00:16:09,410 --> 00:16:11,400
.ثلاثةٌ

264
00:16:21,520 --> 00:16:24,330
.هيّا، اهربا

265
00:16:26,880 --> 00:16:29,830
إلى أين نمضي؟
هل وجهتنا قصر نيجو؟

266
00:16:30,620 --> 00:16:32,090
.سنَسلك طريقًا جانبيًا

267
00:16:32,300 --> 00:16:34,590
.علينا أن نُضلّل ذاك الرّجل أولًا

268
00:16:35,020 --> 00:16:35,660
.حسنًا

269
00:16:37,040 --> 00:16:37,800
.مِن هنا

270
00:16:51,240 --> 00:16:52,600
.سنتسلّل عبر هذا المنفذ

271
00:16:52,780 --> 00:16:56,110
عجبًا، أنا مبهورٌ بمعرفتك
.لمثل هذه الأزقّة الضيّقة

272
00:16:57,000 --> 00:16:58,520
.وُلدت في هذه المدينة

273
00:16:58,930 --> 00:17:00,490
.لا بُدّ أنّك تحفظها شبرًا بشبرٍ

274
00:17:04,600 --> 00:17:06,830
.لنتوارَ عن الأنظار هنا ونترقّب قليلًا

275
00:17:06,830 --> 00:17:09,040
!كلا، بلغ منّي التّعب مبلغه

276
00:17:09,040 --> 00:17:10,620
!اطلب لي محفّةً

277
00:17:10,620 --> 00:17:13,000
.تصرّف بعقلانيّة

278
00:17:14,440 --> 00:17:15,510
ما الّذي تفعله؟

279
00:17:15,920 --> 00:17:20,820
،أشكّ في قُدرتي على هزيمته في نزالٍ عادل
.لذا أرجو أن يكون هذا الخيار نافعًا

280
00:17:23,160 --> 00:17:27,390
لست سيّافًا سيّئًا، ولكنّني لا أجد
.فُرصي كبيرةً في النّجاة أيضًا

281
00:17:28,800 --> 00:17:30,500
...معذرةً، يا كيكوتشيو-سان

282
00:17:31,210 --> 00:17:33,020
.أقصد، يا مولاي الشّوغون

283
00:17:34,260 --> 00:17:35,670
.نادني كيكوتشيو فحسب

284
00:17:36,540 --> 00:17:42,570
كيكوتشيو-سان، ما الّذي دفعك
لترك قصر نيجو والخطر يُحيط بك؟

285
00:17:43,230 --> 00:17:44,850
هل كان لديك مهمّةٌ عاجلة؟

286
00:17:45,970 --> 00:17:48,240
،مانع رجالي خُروجي كثيرًا

287
00:17:48,650 --> 00:17:51,480
ويبدو أنّ الموقف الآن
.شاهدٌ على حصافة رأيهم

288
00:17:59,850 --> 00:18:02,560
حصانٌ؟
ما الّذي يفعله في هذا المكان؟

289
00:18:06,800 --> 00:18:08,870
.هدّئ من روعك، ها أنت ذا

290
00:18:10,460 --> 00:18:14,360
لعلّك... أنت مَن كان
يمتطي صهوة هذا الحصان؟

291
00:18:14,610 --> 00:18:15,400
.أجل

292
00:18:15,850 --> 00:18:17,280
.لا بُدّ أنّك عشت لحظاتٍ عصيبةً

293
00:18:18,920 --> 00:18:20,860
ما بك؟ هل تهاب الخُيول؟

294
00:18:21,320 --> 00:18:24,750
،كلا، ليس كذلك
.ولكن لرُؤيتها عن قُربٍ هيبةً

295
00:18:25,200 --> 00:18:28,820
لأكون صريحًا، أُفضّل أن أقضي
.عُمري في رعاية الطّيور والأسماك

296
00:18:29,050 --> 00:18:29,750
ماذا؟

297
00:18:30,400 --> 00:18:32,330
.ما خالج ظنّي قطّ أن أُصبح شوغونًا

298
00:18:32,760 --> 00:18:34,790
أَتُراني أهلًا لهذه الأمانة؟
.لا أكاد أُصدّق ما أنا فيه

299
00:18:36,710 --> 00:18:38,970
،أردت أن ألتقي بأناسٍ مثلكم

300
00:18:39,510 --> 00:18:42,440
.أقصد الرعيّة

301
00:18:44,460 --> 00:18:49,800
إن شئت الحقّ، أردت أن أرى معادن
.النّاس الّذين أحكمهم وألتزم بحمايتهم

302
00:18:51,190 --> 00:18:54,580
هل لك أن تنتظر هنا؟
.سأبعث إليك مَن يصحبك قريبًا

303
00:18:57,880 --> 00:18:58,780
...عذرًا

304
00:18:59,210 --> 00:19:05,260
بلغني أنّك قدمت مِن إيدو لتُعاهد
.الإمبراطور على طرد الأجانب

305
00:19:05,780 --> 00:19:06,600
.بالفعل

306
00:19:07,240 --> 00:19:09,540
.هكذا يظنّ مَن حولي على أيّ حال

307
00:19:09,540 --> 00:19:13,040
ما الخطب؟
هل ترى خلاف ذلك؟

308
00:19:14,740 --> 00:19:16,430
.عَجزي عن دحر الأجانب حقيقةٌ

309
00:19:16,430 --> 00:19:17,280
ماذا؟

310
00:19:18,400 --> 00:19:20,360
ألا تَقوى على ذلك؟

311
00:19:20,760 --> 00:19:21,410
.كلا

312
00:19:22,240 --> 00:19:24,440
...معذرةً، أنا

313
00:19:24,440 --> 00:19:26,440
،الموانئ مفتوحةٌ بالفعل

314
00:19:28,000 --> 00:19:32,780
،ولا سبيل لي لطرد الأجانب منها
.أو منع غيرهم مِن الدّخول

315
00:19:34,100 --> 00:19:37,450
،إن نحن انغلقنا على أنفسنا
.فلن يزيد ذلك العالم إلّا تقدّمًا عنّا

316
00:19:38,130 --> 00:19:39,950
حريٌّ بنا ألّا نُضيّع لحظةً
.واحدة بعد الآن

317
00:19:40,870 --> 00:19:42,320
ما العمل إذن؟

318
00:19:42,880 --> 00:19:43,580
.لست أعلم

319
00:19:44,400 --> 00:19:47,530
ألن يجلب لنا الانفتاح الدّمار؟

320
00:19:47,980 --> 00:19:52,450
،تردّد أنّنا سنقع تحت الاحتلال
.أو نغرق بسُموم المُخدّرات الفتّاكة

321
00:19:52,680 --> 00:19:53,920
،ستَنفتح البلاد

322
00:19:54,380 --> 00:19:56,950
لكنّي لن أُطلق للأجانب العنان
.ليَعيثوا فيها فسادًا

323
00:19:57,530 --> 00:20:01,110
واجبنا أن نبحث عن طريقةٍ
.لكفّ أذاهم

324
00:20:01,110 --> 00:20:03,200
آن الأوان لتتظافر رُؤانا
.وتجتمع كلمتنا

325
00:20:03,560 --> 00:20:05,960
،هذا هو منظوري للمسألة
.على أيّ حالٍ

326
00:20:08,040 --> 00:20:11,140
ليس لي مِن غايةٍ سوى
،أن تتّحد كلمة البلاد

327
00:20:11,670 --> 00:20:13,640
مع أنّني أُدرك أنّ البعض
.سيُبدي مُمانعةً

328
00:20:14,570 --> 00:20:18,200
فقد تنقسم اليابان بين فئة مُناهضةٍ
،للأجانب وأخرى تُطالب بالانفتاح

329
00:20:18,890 --> 00:20:20,950
.رُغم أنّ الفئتان لا تتعارضان بالضّرورة

330
00:20:22,450 --> 00:20:28,450
لكن اعتقادي راسخٌ بأن ثمّة مساعٍ لا يتمّها
.إلّا شوغونٌ يوصف بالضّعف وقلّة الحيلة

331
00:20:34,170 --> 00:20:38,230
لن أدع لهيب الفتنة يأكل بلادنا
.وفي صدري نفسٌ يتردّد

332
00:20:39,160 --> 00:20:41,150
...رُبّما رغب كثيرون في موتي

333
00:20:43,210 --> 00:20:45,370
.غير أنّ الأمانة لا تزال في عُنقي

334
00:20:46,870 --> 00:20:48,000
.كيكوتشيو-سان

335
00:20:49,310 --> 00:20:52,520
!لكن... يا لشدّة كُرهي لهذا الحال

336
00:20:52,770 --> 00:20:55,310
.ليتني أكتفي باللّهو مع خيولي

337
00:20:55,310 --> 00:20:57,430
.فالجراح والطّعنات لا شكّ مؤلمةٌ

338
00:20:57,430 --> 00:20:59,610
.وأنا لا أبتغي منها شيئًا

339
00:20:59,610 --> 00:21:01,640
،إنّي منهكٌ حقًا
.ولا رغبة لي في المسير

340
00:21:02,330 --> 00:21:04,200
هل ستمتطي صهوة حصانك
راجعًا إذن؟

341
00:21:04,700 --> 00:21:06,540
.كلا، محالٌ

342
00:21:07,310 --> 00:21:10,240
لا أقوى على الإمساك باللّجام
.بيدي اليُسرى في حالي هذه

343
00:21:10,620 --> 00:21:12,480
ماذا لو آذيت الحصان؟

344
00:21:12,480 --> 00:21:15,310
هل أنت قلقٌ على الحصان؟

345
00:21:15,310 --> 00:21:17,040
بالطّبع، وهل في ذلك شكٌّ؟

346
00:21:21,190 --> 00:21:22,120
.كيكوتشيو-سان

347
00:21:23,480 --> 00:21:24,420
.اطمئنّ

348
00:21:26,010 --> 00:21:27,310
...فنحن رجال المِيبورو

349
00:21:33,530 --> 00:21:34,960
.سنحميك حتمًا

350
00:21:37,560 --> 00:21:39,970
.أجل، فأنا أعتمد عليكم

351
00:21:45,030 --> 00:21:50,040
أضعفُ

352
00:21:45,030 --> 00:21:50,040
شوغون

353
00:23:20,170 --> 00:23:25,550
الحلقة القادمة

354
00:23:23,000 --> 00:23:24,480
.أوكيتا سوجي يُحدّثكم

355
00:23:24,950 --> 00:23:28,390
يا للعجب! لم أظنّ يومًا
،أنّني سأُقابل الشّوغون

356
00:23:28,640 --> 00:23:31,920
