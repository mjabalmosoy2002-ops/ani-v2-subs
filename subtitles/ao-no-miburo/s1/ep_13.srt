1
00:00:26,160 --> 00:00:27,990
.صحيحٌ

2
00:00:29,920 --> 00:00:33,480
كنت مع كيكوتشيو-سان في
...طريقنا إلى قصر نيجو، وبعدها

3
00:00:51,400 --> 00:00:51,840
ماذا؟

4
00:00:53,360 --> 00:00:54,440
كيكوتشيو-سان؟

5
00:00:55,180 --> 00:00:57,740
مـ-ما الخطب؟
لماذا هذا التكلّف الرسميّ؟

6
00:01:00,520 --> 00:01:02,380
لحظةً، مَن أنت؟

7
00:01:15,260 --> 00:01:19,560
ذئاب ميبو الزّرق

8
00:02:35,320 --> 00:02:38,130
أرجو معذرتي لتطفّلي عليك
.في هذه السّاعة المُتأخّرة

9
00:02:38,470 --> 00:02:45,090
دأبت عائلتي على خدمة سُلالة
.الشّوغون لأجيالٍ كظلٍ لهم

10
00:02:45,260 --> 00:02:46,790
ظـ-ظل؟

11
00:02:47,520 --> 00:02:48,980
هل يعني أنّه كان بديلًا للتّمويه؟

12
00:02:49,380 --> 00:02:52,980
،سمعت عنهم
.لكنّي لم أظنّ أنّ لهم وجودًا فعليًا

13
00:02:53,150 --> 00:02:59,000
،مَن يبدو منّا الأكثر شبهًا بالشّوغون
.يقع عليه الاختيار ليكون ظلّه

14
00:02:59,000 --> 00:03:02,370
.وبكُلّ تواضعٍ، كنت أنا المُختار

15
00:03:02,690 --> 00:03:05,610
معذرةً، لكن لا يُوجد
!أدنى شبه بينكما

16
00:03:05,930 --> 00:03:08,120
مـ-ما اسمك؟

17
00:03:08,280 --> 00:03:10,370
.ليس للظلّ اسمٌ

18
00:03:10,640 --> 00:03:12,020
!هذا الرّجل صعب المِراس

19
00:03:13,160 --> 00:03:17,630
،ذُدت عن سيّدي في وقت شدّته

20
00:03:17,980 --> 00:03:21,390
.فلك منّي أسمى آيات الشّكر

21
00:03:21,390 --> 00:03:25,070
،لا داعي لهذا
.فقد غمرني الكثيرون بشُكرهم

22
00:03:25,070 --> 00:03:26,260
.ولا أستحقّ كُلّ هذا الثّناء

23
00:03:29,080 --> 00:03:34,270
رُغم أنّني لست أهلًا لذلك، لكن هذا ما يُمليه عليّ
.واجبي، فاسمح لي أن أُعبّر عن امتناني كما ينبغي

24
00:03:38,620 --> 00:03:39,150
...والآن

25
00:03:41,160 --> 00:03:42,760
!إنّه يُقلّد الشّوغون ببراعةٍ مُذهلة

26
00:03:43,470 --> 00:03:45,870
لا ريب أن صُحبة سموّه
.قد كشفت لك عن أمورٍ كثيرة

27
00:03:45,870 --> 00:03:46,530
ماذا؟

28
00:03:46,960 --> 00:03:52,660
.سُموّه يُؤثر حياة النّاس على حياته

29
00:03:52,850 --> 00:03:55,950
.أجل، أدهشني ذلك حقًا

30
00:03:56,410 --> 00:03:57,920
.إنّه الشّوغون في نهاية المطاف

31
00:03:58,230 --> 00:04:01,420
...أجل، ورُغم ذلك

32
00:04:01,700 --> 00:04:03,920
!ليست هذه ضحكة نُبلاءٍ أبدًا

33
00:04:05,280 --> 00:04:07,790
...عُذرًا، هل كيكوتشيو-سان

34
00:04:09,120 --> 00:04:09,960
.رحل

35
00:04:11,240 --> 00:04:16,270
سيّد نيو، أعدك بأن أهرع
.لنجدتك في ساعة عُسرك

36
00:04:17,070 --> 00:04:19,280
.شـ-شكرًا لك

37
00:04:26,560 --> 00:04:28,370
ماذا؟ ما الّذي يحدث؟

38
00:04:29,210 --> 00:04:31,280
.أسمع أصواتًا مِن بعيدٍ

39
00:04:31,580 --> 00:04:35,510
!اطردوا البرابرة

40
00:04:32,660 --> 00:04:33,700
!لا مكان للأجانب

41
00:04:35,510 --> 00:04:37,140
!لا مكان للأجانب

42
00:04:36,610 --> 00:04:41,560
!اطردوا البرابرة"؟ لا يُمكن"
داخل قصر نيجو؟ ولكن لماذا؟

43
00:04:37,140 --> 00:04:42,040
!اطردوا البرابرة

44
00:04:39,070 --> 00:04:40,000
!لا مكان للأجانب

45
00:04:42,040 --> 00:04:45,560
!لا مكان للأجانب

46
00:04:42,240 --> 00:04:44,890
،نال منّي التّعب
.حان وقت النّوم

47
00:04:51,750 --> 00:04:54,400
أين أنا؟
.الضّباب كثيفٌ جدًا

48
00:04:57,030 --> 00:04:58,130
.أسمع خرير ماءٍ

49
00:05:00,850 --> 00:05:02,640
هل هذا نهرٌ يا تُرى؟

50
00:05:03,100 --> 00:05:04,070
.سأُجرّب العُبور

51
00:05:05,440 --> 00:05:07,440
...لحظةً، أَيعقل أنّ هذا

52
00:05:08,750 --> 00:05:09,960
.تبًا

53
00:05:13,450 --> 00:05:18,740
أهكذا تُكافئني بنطحة رأسٍ جزاءً
لقلقي عليك وأنت تتقلّب في نومك؟

54
00:05:18,740 --> 00:05:21,470
!كيكوتشيو-سان
!إنّه أنت حقًا هذه المرّة

55
00:05:23,960 --> 00:05:25,960
هل رأيت نهر سانزو؟

56
00:05:25,960 --> 00:05:27,900
.أ-أجل، رأيته

57
00:05:28,160 --> 00:05:30,720
.كدت أعبر إلى أرض الموتى

58
00:05:31,190 --> 00:05:32,590
.هذا غريبٌ

59
00:05:33,030 --> 00:05:36,730
فجُروحك ليست خطيرةً
.إلى هذا الحدّ

60
00:05:36,730 --> 00:05:37,390
ماذا؟

61
00:05:37,960 --> 00:05:41,220
.أظنّ أنّك محقٌّ في ذلك

62
00:05:42,940 --> 00:05:45,240
ما هيةُ ذاك النّهر الّذي رأيته إذن؟

63
00:05:45,710 --> 00:05:49,990
دعنا مِن هذا، أنا مذهولٌ لأنّ
.كاجيمارو قد كشف عن نفسه

64
00:05:50,260 --> 00:05:52,560
،إذن
ذاك الرّجل يُدعى كاجيمارو؟

65
00:05:52,560 --> 00:05:54,970
،أجل
.وذلك أمرٌ غير مألوفٍ بتاتًا

66
00:05:55,710 --> 00:05:58,540
يبدو أنّ هذا يعكس
.مدى امتنانه العميق لك

67
00:05:59,850 --> 00:06:01,260
ماذا؟

68
00:06:01,760 --> 00:06:02,600
...رُغم كُلّ شيءٍ

69
00:06:03,660 --> 00:06:05,510
أنا سعيدٌ لأنّنا وصلنا
.إلى هنا بسلامٍ

70
00:06:05,510 --> 00:06:06,330
.وأنا أيضًا

71
00:06:07,280 --> 00:06:11,110
تعرّضت يدي اليُسرى للإصابة إثر سُقوطي عن
.صهوة جوادي، لكن الأمر لم يتفاقم عن ذلك

72
00:06:11,110 --> 00:06:13,770
أمّا أنا، فقد أُوسعت
.ضربًا حتّى خارت قُواي

73
00:06:14,440 --> 00:06:18,060
بلغني أنّ الرّجال الثّلاثة الّذين
.أصابهم ناووزومي سينجون

74
00:06:18,400 --> 00:06:19,760
.كما أنّ حصاني بخير أيضًا

75
00:06:19,950 --> 00:06:22,240
!حقًا؟ يا للرّاحة

76
00:06:22,880 --> 00:06:25,320
.وقد استعدت لك سيفك الخشبيّ

77
00:06:25,320 --> 00:06:27,610
.شكرًا لك

78
00:06:32,180 --> 00:06:33,650
.يا له مِن أمرٍ مُضحكٍ

79
00:06:33,650 --> 00:06:35,610
.حدّثني أكثر عن جماعة المِيبورو

80
00:06:35,810 --> 00:06:37,960
حسنًا، هل تذكر حين
حدّثتك عن كوندو-سان؟

81
00:06:38,300 --> 00:06:42,720
رشفةٌ واحدة مِن السّاكي تطرحه أرضًا في
.نومٍ عميق، لكنّه لا يُقهر في مصارعة السّومو

82
00:06:42,720 --> 00:06:45,380
.إنّه يقذف بالجميع كأنّهم دُمىً محشوّةٌ

83
00:06:47,700 --> 00:06:50,920
.كم أودّ لقاء بقيّة أعضاء المِيبورو

84
00:06:53,160 --> 00:06:55,350
منظرٌ خلّاب، أليس كذلك؟

85
00:06:55,830 --> 00:06:58,470
.أجل، كأنّه عالمٌ آخر

86
00:07:00,390 --> 00:07:03,640
،ظننت أنّ ما سمعته مُجرّد أوهامٍ

87
00:07:04,040 --> 00:07:06,160
لكن كان هناك صياحٌ يشقّ
.سُكون اللّيل

88
00:07:06,380 --> 00:07:07,160
ماذا؟

89
00:07:07,520 --> 00:07:10,720
تردّد صدى تلك الأصوات
.حتّى بلغ أعماق القصر

90
00:07:11,730 --> 00:07:13,690
.إذن، بلغت مسامعك أصواتهم

91
00:07:14,260 --> 00:07:19,160
كانوا يهتفون "اطردوا البرابرة"، هل كان
صياحهم ذاك مُوجهًا إليك يا كيكوتشيو-سان؟

92
00:07:19,540 --> 00:07:21,200
.إنّه أمرٌ يبعث على الضّجر

93
00:07:21,480 --> 00:07:25,540
فهم لا يملّون مِن الاحتجاج والجلبة
.عند البوّابات في كُلّ ليلةٍ

94
00:07:25,800 --> 00:07:28,250
،أرى أنّك تُقاسي أمرًا عسيرًا أيضًا
أليس كذلك؟

95
00:07:28,860 --> 00:07:31,360
.فَها أنت تستميت لتفادي نُشوب حربٍ

96
00:07:34,040 --> 00:07:37,530
،أيّ شخصٍ مكاني سيفعل ذلك
.هذا هو سبب وُجودي هنا

97
00:07:38,320 --> 00:07:39,200
ماذا تقصد؟

98
00:07:39,760 --> 00:07:42,400
حُسم القرار بشأن
.طرد البرابرة بالفعل

99
00:07:43,310 --> 00:07:48,790
،فالإمبراطور، والحاشية
،ومُؤخّرًا، وصيُّ عرشي يوشينوبو

100
00:07:49,330 --> 00:07:52,830
جميعهم يضغطون عليّ
.لتحديد موعدٍ لتنفيذ هذه السّياسة

101
00:07:54,050 --> 00:07:56,830
لن يكون كبح جماح
.هذا الاندفاع أمرًا هينًا

102
00:07:57,630 --> 00:07:59,750
فلا تُوجد قوّةٌ بشريّة
.يُمكنها صُنع فرقٍ الآن

103
00:08:00,190 --> 00:08:02,780
إنّنا كمن يسحبه تيّار نهر التّاريخ
.الجارف دُون حيلةٍ

104
00:08:04,070 --> 00:08:04,800
تيّار نهر التّاريخ؟

105
00:08:05,570 --> 00:08:08,590
:هذا تمامًا ما قصدته بقولي
".أيّ شخصٍ مكاني سيفعل ذلك"

106
00:08:09,090 --> 00:08:13,590
فالفرد الواحد لا قيمة له تقريبًا
.أمام جريان هذا التّيار

107
00:08:14,680 --> 00:08:18,360
،ما أنا إلّا دميةٌ تُحرّكها الخُيوط
.دميةٌ لا تملك مِن أمرها شيئًا أمام تقلّبات الزّمن

108
00:08:19,100 --> 00:08:22,880
،لكنّك لن تَرتضي بأن تكون مُجرّد دُميةٍ
أليس كذلك يا كيكوتشيو-سان؟

109
00:08:26,560 --> 00:08:28,560
،أقصد أنّك لم تقف مكتوف اليدين
.بل قاومت

110
00:08:29,400 --> 00:08:31,670
،رُغم كُلّ ذلك
.لن أَدعك تُضرم نار الحرب

111
00:08:32,240 --> 00:08:35,870
هذا هو قراري النّهائي
.بصفتي سيّد عشائر السّاموراي

112
00:08:36,330 --> 00:08:41,020
،حتّى وحياتك على المحكّ
.كان لديك الإصرار على عدم سفك الدّماء

113
00:08:42,610 --> 00:08:47,380
،وإن كنت أشبه بقاربٍ صغير يُصارع التّيار
.فأنت لا تزال تُكافح، وستبقى تُكافح

114
00:08:48,080 --> 00:08:50,760
،أنت هو الشّوغون الخاصّ بنا
.يا كيكوتشيو-سان

115
00:08:51,050 --> 00:08:52,880
.وأنا سعيدٌ بذلك حقًا

116
00:08:56,080 --> 00:08:58,100
ومَن أنت لتُصدر مثل هذا الحُكم؟

117
00:08:58,100 --> 00:09:01,440
،أنا أعتذر جدًا
!تماديت في حديثي أكثر ممّا ينبغي

118
00:09:01,440 --> 00:09:02,660
!أرجو معذرتك

119
00:09:04,920 --> 00:09:06,260
مهلًا، نهرٌ؟

120
00:09:07,280 --> 00:09:10,110
أَيمكن أن يكون ذاك هو نهر الزّمن؟

121
00:09:11,040 --> 00:09:14,180
،كلا، هذا سخفٌ
.لم يكن سوى حُلمٍ

122
00:09:16,530 --> 00:09:20,060
،لا بُد أنّك لم تأكل شيئًا
.سآمر بإعداد وجبةٍ لك

123
00:09:20,060 --> 00:09:22,250
!كلا، لا تفعل

124
00:09:22,250 --> 00:09:24,990
لن أَطيق أن أُطعم وحدي
.دُون الآخرين

125
00:09:26,210 --> 00:09:28,160
صدقت، تارو سيُثير ضجيجًا
.وصخبًا لو فعلت

126
00:09:29,620 --> 00:09:31,920
،إذن
هل ترغب في أيّ أمرٍ آخر؟

127
00:09:31,920 --> 00:09:33,920
أ-أنا؟ هل أرغب في شيءٍ؟

128
00:09:34,350 --> 00:09:35,460
.أيّ شيءٍ مهما كان

129
00:09:38,440 --> 00:09:40,180
أَيمكنني حقًا أن أطلب أيّ شيءٍ؟

130
00:09:48,880 --> 00:09:50,480
.اسمها بلاك دايكون

131
00:09:50,480 --> 00:09:51,890
بلاك دايكون؟

132
00:09:51,890 --> 00:09:53,700
.إنّه اسمٌ غير مألوفٍ نوعًا ما

133
00:09:53,940 --> 00:09:56,500
،لونها أسود
.وهي تعشق فجل الدّايكون

134
00:09:56,500 --> 00:09:57,530
.أنا مَن أطلق عليها هذا الاسم

135
00:09:57,530 --> 00:09:58,950
!مولاي، هذا لا يجوز

136
00:09:59,180 --> 00:10:00,950
قيادة الخيل أمرٌ لا يليق
!بمقام سُموّكم

137
00:10:01,140 --> 00:10:02,780
.كُفّا عن الضّجيج

138
00:10:02,780 --> 00:10:04,860
.أنا مدينٌ لنيو بدينٍ عظيم

139
00:10:04,860 --> 00:10:07,200
،أفسحا الطّريق
.أو ستُحرمان مِن العشاء

140
00:10:07,520 --> 00:10:10,210
يبدو أنّ الشّوغون الخاصّ بنا
.يفرض رأيه بقُوّةٍ

141
00:10:12,380 --> 00:10:13,710
!أ-أنا خائفٌ

142
00:10:13,710 --> 00:10:15,560
.لا يجب أن تتشنّج هكذا

143
00:10:15,760 --> 00:10:17,920
.استرخ تمامًا ودعِ الخيل تتولّى الزّمام

144
00:10:17,930 --> 00:10:20,270
هل قُلت: "استرخ"؟

145
00:10:18,990 --> 00:10:20,270
!أحكم القبض على الأعنّة

146
00:10:25,980 --> 00:10:28,150
،أحسنت صُنعًا
.لديك موهبةٌ في التّعامل مع الخيل

147
00:10:30,210 --> 00:10:32,240
.أحسنتِ يا فتاتي، بلاك دايكون

148
00:10:33,960 --> 00:10:35,560
أليست الخُيول رائعةً؟

149
00:10:35,770 --> 00:10:40,560
،كنت أتمنّى لو أريتها لزوجتي
.لكن لا سبيل لإعادتها معي إلى إيدو

150
00:10:40,990 --> 00:10:44,660
سيتعيّن عليّ البحث عن
.هديّةٍ أُخرى للأميرة كازو

151
00:10:45,100 --> 00:10:47,750
هل أنت متزوّجٌ يا كيكوتشيو-سان؟

152
00:10:48,140 --> 00:10:48,660
.أجل

153
00:10:49,360 --> 00:10:51,740
.ومِن سيّدةٍ بارعة الجمال

154
00:10:51,740 --> 00:10:55,160
لكنّها تنفخ وَجنتيها هكذا
.حين يشتدّ غضبها

155
00:10:56,620 --> 00:10:57,680
.هذا لطيفٌ جدًا

156
00:11:00,990 --> 00:11:05,430
نيو، أَتترك جماعة المِيبورو
وتأتي لتعمل في خدمتي؟

157
00:11:05,670 --> 00:11:06,130
ماذا؟

158
00:11:06,860 --> 00:11:10,180
أرغب في أن آخذك معي
.إلى إيدو أيضًا

159
00:11:10,180 --> 00:11:12,350
.عَرضك هذا جاء بغتةً

160
00:11:12,350 --> 00:11:15,950
قُل أجل وحسب، قُلها، وإلّا جعلت الخيل
!تجمح وتُلقي بك مِن فوق ظهرها

161
00:11:15,950 --> 00:11:18,240
،مهلًا
!لا تفعل ذلك يا كيكوتشيو-سان

162
00:11:18,720 --> 00:11:20,240
.كنت أمزح فقط

163
00:11:20,240 --> 00:11:22,640
.بلغ منّي الخوف مَبلغه

164
00:11:22,640 --> 00:11:24,490
.لم يكن ذلك مزاحًا مُضحكًا

165
00:11:25,790 --> 00:11:26,740
.اعذرني

166
00:11:27,680 --> 00:11:30,450
كنت أشعر برغبةٍ صادقة
.في ذلك حتّى ليلة أمس

167
00:11:31,280 --> 00:11:34,010
.ثُمّ استحضرت شيئًا قالته جدّتك

168
00:11:34,960 --> 00:11:37,080
،أنت حاكمٌ
.فانشغل بما يليق بالحُكّام

169
00:11:37,080 --> 00:11:40,120
.كُلٌّ ميسرٌّ لما خُلِق له ومطالبٌ بالثّبات

170
00:11:40,120 --> 00:11:42,760
.وهذا أصل المسؤوليّة

171
00:11:43,470 --> 00:11:49,010
،لكُلّ فردٍ مقامه وواجباته
.وعلينا أن نُؤدّيها بأفضل ما لدينا

172
00:11:49,680 --> 00:11:51,260
.طالما أنّنا نتشارك الهدف ذاته

173
00:11:51,920 --> 00:11:53,050
.كيكوتشيو-سان

174
00:11:54,180 --> 00:11:56,030
،أنا في مقامي بين هذه الجُدران

175
00:11:56,450 --> 00:11:58,320
.وأنت في العالم الخارجيّ

176
00:11:58,980 --> 00:12:02,630
فلنبذل جُهدنا سويًا
.ليبزغ فجر عصرٍ يغمره السّلام

177
00:12:03,630 --> 00:12:06,320
.مولاي، وصل رفاق الفتى

178
00:12:07,970 --> 00:12:09,370
.نفد وقتنا إذن

179
00:12:15,040 --> 00:12:16,320
ما هو جوهر السّيف؟

180
00:12:17,160 --> 00:12:21,260
،حين طرح ناووزومي هذا السّؤال
.لم تستطع إجابته

181
00:12:22,360 --> 00:12:23,190
.معك حقٌّ

182
00:12:24,730 --> 00:12:26,280
أنا لا ألومك على ذلك

183
00:12:27,050 --> 00:12:30,640
،ولكن
كيف لي أن أُدرك هذه الأمور؟

184
00:12:31,360 --> 00:12:35,640
،أنا لست ساموراي حقيقيًا
.نشأت في كنف بائعة دانجو تبنّتني

185
00:12:36,090 --> 00:12:37,390
.أنت مخطئٌ

186
00:12:38,170 --> 00:12:40,350
،في هذه الأيّام
.يُمكن للمال أن يشتري لقب السّاموراي

187
00:12:40,740 --> 00:12:42,660
لم يعد الأمر مرهونًا
.بالنّسب أو بالميلاد

188
00:12:42,880 --> 00:12:46,160
فماذا تظنّه إذن؟

189
00:12:47,360 --> 00:12:49,160
.إنّه نهج رُوحٍ، وعقيدة فِكرٍ

190
00:12:49,430 --> 00:12:51,600
نـ-نهج رُوحٍ؟

191
00:12:52,530 --> 00:12:57,160
،زعم ناووزومي أنّها مسألةٌ تتعلّق بالدّم
.لكن مثل هذه الأسئلة لا تملك إجاباتٍ قاطعة

192
00:12:57,770 --> 00:13:02,180
،فإذا نظرت إليها كنهج رُوحٍ، وعقيدة فكرٍ
.فإنّ الإجابات ستكون بلا نهايةٍ

193
00:13:02,770 --> 00:13:07,170
،ساموراي كان، أم فلّاحًا، أم شوغونًا
.رجلًا كان أم امرأةً، فلا فرق في ذلك أبدًا

194
00:13:12,140 --> 00:13:14,480
ما هو جوهر السّيف في نظرك؟

195
00:13:18,600 --> 00:13:21,640
أخبرني بجوابك حين
.نلتقي مرّةً أُخرى

196
00:13:24,560 --> 00:13:25,730
.ها هو ذا

197
00:13:25,730 --> 00:13:27,330
!نيو-كون

198
00:13:27,330 --> 00:13:28,270
.تأخّرت علينا

199
00:13:28,620 --> 00:13:32,080
.خرج مِن قصر نيجو حقًا

200
00:13:34,960 --> 00:13:38,150
،أيّها الرفاق
!شكرًا لكم لأنّكم جئتم لاصطحابي

201
00:13:39,080 --> 00:13:41,000
،هيجيكاتا-سان
هل أنت بخير؟

202
00:13:41,200 --> 00:13:42,550
.بالطّبع أنا كذلك

203
00:13:42,690 --> 00:13:44,720
.أُراهن أنّك نَعمت بوليمةٍ دسمة هُناك

204
00:13:44,720 --> 00:13:46,340
.لم أذق كِسرة خُبزٍ واحدة

205
00:13:46,340 --> 00:13:48,060
.صرت مِن أرباب المَعالي حقًا

206
00:13:48,060 --> 00:13:49,310
.كُفّوا عن هذا، أرجوكم

207
00:13:49,310 --> 00:13:51,090
ماذا عن النّساء الجميلات؟
!أخبرنا

208
00:13:51,090 --> 00:13:51,980
!كلا

209
00:13:52,350 --> 00:13:54,970
،دعنا مِن النّساء
.لا بُدّ أنّك نِلت عطاءً ما

210
00:13:55,130 --> 00:13:56,480
.كلا! لم أنل شيئًا أبدًا

211
00:13:56,900 --> 00:13:59,980
.لكنّه سمح لي بركوب الخيل

212
00:14:00,120 --> 00:14:02,480
خيلٌ؟ هل ركبت خيلًا؟

213
00:14:02,840 --> 00:14:04,900
،أجل
.كان أمرًا ممتعًا للغاية

214
00:14:04,900 --> 00:14:07,480
،خيلٌ، خيلٌ
هل هذا صحيح؟

215
00:14:07,480 --> 00:14:09,870
،الخُيول تُخلّف الكثير مِن الرّوث
أليس كذلك؟

216
00:14:09,870 --> 00:14:12,490
،أجل
.وتنظيف مكانها عملٌ شاقّ حقًا

217
00:14:13,490 --> 00:14:14,810
!كيكوتشيو-سان

218
00:14:16,380 --> 00:14:18,310
...رُبّما ليس مِن اللّائق قول هذا

219
00:14:21,360 --> 00:14:26,290
،لكن، مُنذ ليلة أمس وحتّى اليوم
!قضيت وقتًا مُذهلًا

220
00:14:29,690 --> 00:14:30,830
!وأنا كذلك

221
00:14:34,510 --> 00:14:36,900
!وداعًا، إلى أن نلتقي مُجدّدًا

222
00:14:37,330 --> 00:14:39,170
!أجل، هذا عهدٌ بيننا

223
00:14:46,270 --> 00:14:51,660
مولاي، يبدو أنّ ملامحك
.قد تغيّرت في غُضون يومٍ واحد

224
00:14:53,120 --> 00:14:54,680
.كاجيمارو

225
00:14:55,620 --> 00:14:59,160
بالنّسبة لظلٍ، فإنّك تتدخّل
!فيما لا يعنيك بشكلٍ مُزعج

226
00:15:03,000 --> 00:15:06,110
ما زال بصيصُ الأمل قائمًا
.لهذه البلاد وأهلها

227
00:15:06,670 --> 00:15:07,910
ما الّذي دفعك لقول ذلك؟

228
00:15:09,560 --> 00:15:10,800
.لا شيء يُذكر حقًا

229
00:15:12,250 --> 00:15:14,840
.والآن، فلنعد إلى العمل

230
00:15:20,690 --> 00:15:22,440
،أودّ القيام بجولةٍ قصيرة في الطّريق

231
00:15:22,900 --> 00:15:24,720
.سألحق بكُم لاحقًا

232
00:15:24,940 --> 00:15:26,200
ماذا؟

233
00:15:26,200 --> 00:15:27,820
ما هذا التصرّف المُفاجئ؟

234
00:15:27,820 --> 00:15:29,940
تجشّمنا عناء المجيء
!إلى هنا لاصطحابك

235
00:15:30,570 --> 00:15:32,350
إلى أين تنوي الذّهاب؟

236
00:15:32,690 --> 00:15:33,640
.إلى عدّة أماكن

237
00:15:34,000 --> 00:15:36,570
،لديّ أشياء أرغب في اقتنائها
.وأمورٌ أودّ التحقّق منها

238
00:15:36,910 --> 00:15:40,580
نيو، العودة إلى المقرّ ومُوافاتنا
.بتفاصيل ما جرى لها الأولويّة

239
00:15:41,080 --> 00:15:43,130
،كلا
.هذا الأمر يسبق كُلّ شيءٍ

240
00:15:44,160 --> 00:15:46,000
!سأنطلق الآن

241
00:15:47,200 --> 00:15:48,390
ما خطبه؟

242
00:15:48,390 --> 00:15:49,140
.لا أملك أدنى فكرةٍ

243
00:15:49,140 --> 00:15:52,560
لن أُحرّك ساكنّا إذا باغته
.أولئك الرّجال مرّةً أُخرى

244
00:15:53,720 --> 00:15:54,920
!عُدت

245
00:15:55,430 --> 00:15:59,390
!اجتمعوا حولي جميعًا، أرجوكم
!لديّ نبأٌ أودّ إطلاعكم عليه

246
00:16:04,600 --> 00:16:07,320
،تجرّد مِن ثيابك يا نيو
.حان دورك

247
00:16:07,320 --> 00:16:10,400
ماذا؟
...ولكن لديّ أمرٌ هامّ أريد

248
00:16:17,320 --> 00:16:19,910
،مهلًا
!خصمي هو سيريزاوا-سان

249
00:16:20,320 --> 00:16:21,940
!ليست لديّ أدنى فُرصةٍ للفوز

250
00:16:21,940 --> 00:16:23,920
!أعلنوا فوزه تلقائيًا فحسب

251
00:16:24,260 --> 00:16:26,820
.نيو، بلغتني القصّة بأكملها

252
00:16:26,820 --> 00:16:27,380
ماذا؟

253
00:16:28,070 --> 00:16:32,050
،أنقذت حياة شوغون عائلة توكوغاوا
أليس كذلك؟

254
00:16:32,280 --> 00:16:37,820
،كـ-كلا. أعني، يُمكنك قول ذلك
...لكنّي في الحقيقة نجوت بفضله أيضًا، لذا

255
00:16:37,820 --> 00:16:40,020
!خدعتك، هذه فُرصتي

256
00:16:42,780 --> 00:16:46,070
.نيو، أيّها الماكر

257
00:16:46,070 --> 00:16:47,000
!أحسنت صنعًا

258
00:16:48,170 --> 00:16:50,020
!رميةٌ خادعة

259
00:16:50,380 --> 00:16:53,520
يا للأسف، خسر نيو-كون
.في الجولة الأولى

260
00:16:53,520 --> 00:16:54,780
!نلت إعجابي

261
00:16:55,220 --> 00:16:56,800
.هاك قطعة مانجو جائزةً لك

262
00:16:57,080 --> 00:16:59,050
.شـ-شكرًا لك يا سيّدي

263
00:16:59,050 --> 00:17:00,530
!مِن أين أخرج هذه القطعة بغتةً؟

264
00:17:00,680 --> 00:17:02,350
!هذا ليس عدلًا
لماذا نيو وحده؟

265
00:17:02,560 --> 00:17:05,040
تبًا، هل هُزمنا شرّ هزيمةٍ
مرّةً أُخرى؟

266
00:17:05,510 --> 00:17:06,700
...بالمُناسبة يا نيو

267
00:17:07,250 --> 00:17:10,340
،سمعت أنّك مكثت في قصر نيجو
.حيث يُقيم اللّورد إيموتشي

268
00:17:10,340 --> 00:17:15,300
أجل، غمرني كيكوتشيو-سان بحفاوةٍ
.بالغة، إنّه شخصٌ مُذهل حقًا

269
00:17:16,290 --> 00:17:18,160
!هذه هي هيبة الشّوغون

270
00:17:18,950 --> 00:17:21,310
،دعني أستنشق رائحتك
.فلا بُدّ أن أُدرك عبيره

271
00:17:21,760 --> 00:17:25,210
.إنّها جذوة عطر الشّوغون

272
00:17:26,910 --> 00:17:30,200
أخبرني، هل كان أولئك
الّذين هجموا عليك أشدّاء؟

273
00:17:30,410 --> 00:17:32,870
أُراهن أنّهم شرذمةٌ
.مِن الضّعفاء لا غير

274
00:17:33,050 --> 00:17:35,630
كلا، تلقّى هيجيكاتا-سان
.ضربًا مُبرحًا

275
00:17:35,870 --> 00:17:36,990
هيجيكاتا؟ حقًا؟

276
00:17:36,990 --> 00:17:38,280
.لم ينالوا منّي قطّ

277
00:17:38,540 --> 00:17:45,170
لكن غايات جماعة الريسّيدان، أو لنقُل
.مآربهم، كانت غريبةً بعض الشّيء

278
00:17:46,530 --> 00:17:48,660
إعادة عصر السّاموراي؟

279
00:17:48,930 --> 00:17:51,670
أجل، هذا ما زعموا
.أنّهم يرغبون فيه

280
00:17:51,670 --> 00:17:52,820
ما هذا الهراء؟

281
00:17:52,820 --> 00:17:54,240
وما مدلول هذا الكلام أصلًا؟

282
00:17:54,240 --> 00:17:56,170
.رُبّما يسعون لإشعال حربٍ

283
00:17:56,350 --> 00:17:59,140
لهذا السبب كان علينا القضاء
!عليهم تمامًا في ذلك الحين

284
00:18:01,160 --> 00:18:04,520
ما الضّير في إعادة عصر السّاموراي؟

285
00:18:04,710 --> 00:18:06,120
هل يُمكننا أن نصبح ساموراي حقًا؟

286
00:18:06,120 --> 00:18:08,200
،يا للهول
.بدأت الفكرة تلقى رواجًا عندهم

287
00:18:10,320 --> 00:18:11,890
حتّى أنت يا سيّد كوندو؟

288
00:18:13,360 --> 00:18:16,570
!هراءٌ محض
مَن ذا الّذي يحتمل عصرًا كهذا؟

289
00:18:17,120 --> 00:18:19,940
،إذا تمادوا في غيّهم
.سنبذل قصارى جُهدنا لصدّهم

290
00:18:20,400 --> 00:18:21,400
.الأمر بسيطٌ للغاية

291
00:18:22,520 --> 00:18:23,400
.أجل يا سيّدي

292
00:18:26,610 --> 00:18:28,130
...والآن، يا رفاق

293
00:18:28,600 --> 00:18:30,660
.فلنبدأ بخياطة معاطف المِيبورو

294
00:18:30,920 --> 00:18:33,290
.لا مجال لإضاعة لحظةٍ واحدة

295
00:18:35,290 --> 00:18:37,230
مـ-معاطف؟

296
00:18:37,230 --> 00:18:39,280
مَن يهتمّ بهذه التّرهات الآن؟

297
00:18:39,280 --> 00:18:41,520
.أنا أهتمّ، سنقوم بصنعها

298
00:18:41,960 --> 00:18:45,080
،دعني أُخمّن
هل وقعت في حُبّ فتاةٍ ما؟

299
00:18:45,760 --> 00:18:48,310
وتُريد التّباهي أمامها، أليس
.كذلك؟ مررت بهذا مِن قبل

300
00:18:48,480 --> 00:18:50,070
.ليس الأمر كذلك أبدًا

301
00:18:50,070 --> 00:18:51,060
ليس كذلك؟

302
00:18:51,540 --> 00:18:56,470
،في ليلة أمس، حين كنت في قصر نيجو
."سمعت هتافات النّاس: "اطردوا البرابرة

303
00:18:56,470 --> 00:19:02,120
...كانوا يتوعّدون كيكوتشيو-سان
.أقصد، الشّوغون

304
00:19:02,970 --> 00:19:08,310
ناووزومي-سان وبقيّة جماعة الريسّيدان
.يرغبون في إشعال حربٍ

305
00:19:10,200 --> 00:19:14,210
هاتان الحقيقتان وحدهما تعنيان
،أنّ الخطر يُحدق بكيوتو

306
00:19:15,100 --> 00:19:17,220
.وأهل المدينة يعيشون في ذُعرٍ

307
00:19:17,730 --> 00:19:21,710
أودّ أن أُثبت لهم
.أنّ المِيبورو موجودون

308
00:19:23,170 --> 00:19:25,680
وأنّنا جميعًا نُشكّل كيانًا
،واحدًا ينبض بالحياة

309
00:19:26,160 --> 00:19:27,600
ولا نتسامح مع الأعمال
.الشّريرة أبدًا

310
00:19:28,560 --> 00:19:32,240
ستكون هذه المعاطف
،بمثابة رايةٍ لأهل كيوتو

311
00:19:32,800 --> 00:19:37,450
،باعثةً للطُمأنينة، وشاهدةً على الأمان
.وملاذًا ينعمون في كنفه بالسّكينة

312
00:19:38,570 --> 00:19:42,480
أرى أنّ هذا هو صميم
،مُهمّتنا بصفتنا ميبورو

313
00:19:42,920 --> 00:19:44,750
.وبصفتنا خادمين لهذا الشّعب

314
00:19:49,380 --> 00:19:54,070
كان حدسي صادقًا حين
.اصطفيته للانضمام إلينا

315
00:19:56,370 --> 00:20:01,890
إذن، ما الّذي كنت تنشد اقتناءه
على عجلٍ لأجل هذه المعاطف؟

316
00:20:02,280 --> 00:20:04,100
وما الّذي تحقّقت منه بالضّبط؟

317
00:20:04,740 --> 00:20:08,360
.حسنًا، هذا ما كنت أنشده

318
00:20:09,270 --> 00:20:13,600
قصدت دُكّان تشيرينويا، وطلبت مِن
.الجدّة أن تضع تصميمًا لمعاطفنا

319
00:20:14,400 --> 00:20:15,660
لونٌ أسود، أليس كذلك؟

320
00:20:15,660 --> 00:20:16,650
.إنّه قاتمٌ وممّلٌ جدّا

321
00:20:16,650 --> 00:20:18,070
ما الضّير في ذلك؟

322
00:20:18,070 --> 00:20:19,300
.الأسود لونٌ رائع

323
00:20:19,520 --> 00:20:22,100
قالت إنّه يجب علينا وضع
.رمزٍ كتابيّ واحدٍ على الظّهر

324
00:20:22,630 --> 00:20:25,410
.شيءٌ يُعبّر عن جوهر المِيبورو

325
00:20:27,520 --> 00:20:30,620
فكرةٌ سديدة، هيّا نشحذ
.عُقولنا جميعًا لنختار واحدًا

326
00:20:30,960 --> 00:20:31,910
.حسنًا

327
00:20:32,120 --> 00:20:32,840
"سيري"

328
00:20:32,160 --> 00:20:35,340
"سيري "بقدونس

329
00:20:33,410 --> 00:20:36,420
"كامو "بط

330
00:20:33,420 --> 00:20:34,010
"كامو"

331
00:20:34,570 --> 00:20:35,160
"زاوا"

332
00:20:34,670 --> 00:20:36,420
"زاوا "الأرض النّدية

333
00:20:35,160 --> 00:20:36,420
هل تجعل المسألة كُلّها
!تدور حول شخصك؟

334
00:20:36,800 --> 00:20:39,420
وعمّ تحقّقت إذن؟

335
00:20:39,880 --> 00:20:44,210
ذهبت إلى بائع الأقمشة
.لأعرف التّكلفة يا سيّدي

336
00:20:45,600 --> 00:20:47,110
.خمسة ريو للمعطف الواحد

337
00:20:47,670 --> 00:20:52,690
وتحسبّا لانضمام مزيدٍ مِن الأعضاء، فإنّ خمسين
.معطفًا ستُكلّفنا مائتين وخمسين ريو

338
00:20:55,800 --> 00:20:57,690
!مهلًا، مائتان وخمسون ريو؟

339
00:20:58,060 --> 00:21:01,700
،هيّا يا رفاق
.آن أوان الكدح لجمع المال

340
00:21:02,300 --> 00:21:03,560
!فلننطلق

341
00:21:04,060 --> 00:21:06,950
هيّا، لنضع أيدينا
!في أيدي بعضٍ

342
00:21:08,710 --> 00:21:10,690
هل فقدت صوابك؟
!مِن أين لنا هذا المبلغ الطّائل؟

343
00:21:10,690 --> 00:21:12,440
!بالعمل الدّؤوب، وبتكاتفنا معًا

344
00:21:12,440 --> 00:21:13,930
.إنّه لا يُصغي إلينا

345
00:21:13,930 --> 00:21:15,710
تبًا، يبدو أنّه
.لا مفرّ لنا مِن الأمر

346
00:21:15,710 --> 00:21:18,200
.أنصت إلينا يا نيو

347
00:21:18,450 --> 00:21:20,160
.أنا أُدرك ذلك يا كوندو-سان

348
00:21:21,040 --> 00:21:23,450
لا يُدرك نيو مدى الرّهبة
،الّتي قد يبثّها الزّي المُوحّد

349
00:21:24,040 --> 00:21:26,690
إنّه يُثير مخاوف النّاس
.قبل كُلّ شيءٍ

350
00:21:24,600 --> 00:21:27,220
محالٌ! لن نتمكّن أبدّا مِن
!جمع مائتين وخمسين ريو

351
00:21:27,220 --> 00:21:29,390
هل تُدرك حجم المبلغ الّذي
!يتعين على كُلّ واحدٍ منّا كسبه؟

352
00:21:27,880 --> 00:21:29,200
.كلا، دعوه وشأنه

353
00:21:29,750 --> 00:21:31,060
،مهلًا
كم سيبلغ نصيب كُلّ فردٍ؟

354
00:21:30,900 --> 00:21:35,550
أفعالنا هي الّتي ستُبرهن لأهل
.المدينة أنّنا نقف في صفّهم

355
00:21:32,720 --> 00:21:33,780
...فضلًا عن ذلك

356
00:21:37,360 --> 00:21:39,660
.أجل، أنت على حقٍ

357
00:21:40,330 --> 00:21:43,390
ربّما يكون هذا العمل الّذي
.يتعيّن علينا القيام به كبالغين

358
00:21:44,950 --> 00:21:49,950
أن

359
00:21:44,950 --> 00:21:49,950
نتقاسم
الحُلم
ذاته

360
00:23:20,080 --> 00:23:25,460
الحلقة القادمة

361
00:23:23,160 --> 00:23:24,590
.تشيرينو نيو يُحدّثكم

362
00:23:25,060 --> 00:23:28,300
نحن المِيبورو بحاجةٍ إلى
.توفير ميزانيّةٍ كافية

363
00:23:29,060 --> 00:23:34,080
أموالٌ لاقتناء معاطف مُوحّدة، كي نمنح أهل
.المدينة شعورًا بالأمان وينعموا بالرّاحة والسّكينة

364
00:23:35,180 --> 00:23:38,600
لكن يبدو أنّ العقبات
.تعترض طريق الجميع

365
00:23:40,800 --> 00:23:43,200
.جني المال أمرٌ في غايّة المشقّة

366
00:23:44,420 --> 00:23:46,440
:الحلقة القادمة
."سباقٌ مع الزّمن لجني المال"

367
00:23:47,110 --> 00:23:47,960
!لا تُفوّتوا المُشاهدة

368
00:23:47,110 --> 00:23:49,940
سباقٌ
مع

369
00:23:47,110 --> 00:23:49,940
الزّمن
لجني
المال