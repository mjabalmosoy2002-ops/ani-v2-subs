1
00:00:01,390 --> 00:00:04,360
إذًا، هذا هو مقرّ المِيبورو؟

2
00:00:05,370 --> 00:00:07,620
.ياجي-سان سيُنزلنا في مُجمّعه

3
00:00:07,930 --> 00:00:10,080
.ستأكل وتنام هنا أيضًا

4
00:00:11,080 --> 00:00:15,500
،الآن وقد فكّرت بالأمر
.سمعتُ أطفال الحيّ يتحدّثون عن هذا المكان

5
00:00:15,500 --> 00:00:17,820
وماذا قالوا عنه؟

6
00:00:20,270 --> 00:00:21,660
."مكانٌ تسكنه الشّياطين"

7
00:00:23,880 --> 00:00:25,210
.ويقصدوننا نحن بالشّياطين

8
00:00:27,780 --> 00:00:30,630
،يا للهول يا هيجيكاتا-سان
.لا تُخِفه هكذا

9
00:00:31,210 --> 00:00:33,800
إذًا، أين الجميع؟

10
00:00:33,800 --> 00:00:35,880
.أظنّ أن ياجي-سان في اجتماع

11
00:00:35,880 --> 00:00:37,260
.انتظر في السّاحة

12
00:00:38,990 --> 00:00:41,480
...جدّتي، إيروها

13
00:00:42,320 --> 00:00:46,530
أشعر أنّ هذا المكان
.لا يُبشّر بالخير

14
00:01:00,250 --> 00:01:05,960
ذئاب ميبو الزّرق

15
00:02:25,530 --> 00:02:28,200
ما هذه الرّائحة؟
.لا أستطيع تحديدها تمامًا

16
00:02:35,360 --> 00:02:36,930
أ-أأنت مصابٌ؟

17
00:02:36,930 --> 00:02:37,880
!ليس هذا كافيًا

18
00:02:38,320 --> 00:02:40,030
عليك ببذلِ ما هو أفضل
.مِن ذلك يا سانوسكي

19
00:02:40,030 --> 00:02:44,300
فمثلُ هذه الحيل الصبيّانية
!لا تنطلي على ناغاكورا شينباتشي

20
00:02:44,500 --> 00:02:46,360
أتراهن، أيّها الوغد؟

21
00:02:46,880 --> 00:02:48,870
مَن هذا الصبيّ؟

22
00:02:48,870 --> 00:02:49,680
ماذا؟

23
00:02:50,990 --> 00:02:54,320
مَن أنت؟
!لا يُمكنك التجوّل هنا هكذا

24
00:02:54,320 --> 00:02:55,920
...أنا

25
00:02:56,200 --> 00:02:57,360
.إنّه مجنّدٌ جديد

26
00:02:58,990 --> 00:03:00,140
.واحدٌ منّا

27
00:03:01,110 --> 00:03:02,620
مجنّدٌ جديد؟

28
00:03:02,620 --> 00:03:05,200
هل تسخر منّا يا هيجيكاتا؟

29
00:03:05,200 --> 00:03:09,040
!ليست هذه بمزحةٍ
!لن أقبل بهذا

30
00:03:09,040 --> 00:03:11,660
.بل أنت مَن يعبث، سانوسكي

31
00:03:11,660 --> 00:03:15,370
،اذهب واغسل وجهك وبرّد رأسك
.أيّها الأحمق

32
00:03:15,570 --> 00:03:20,000
،سوجي
.سئمتُ مِن مقالبك هذه

33
00:03:20,480 --> 00:03:25,130
هل أنت متأكّد أنّك تريد فعل هذا؟
.لا يجدر بك الاستهانة بي، ناغاكورا-سان

34
00:03:25,130 --> 00:03:27,900
!بل أنت مَن ازداد غرورًا

35
00:03:25,130 --> 00:03:27,900
!كُفّ عن الثرثرة

36
00:03:27,900 --> 00:03:31,130
...يا إلهي
.استحال الأمر إلى عراكٍ عنيف

37
00:03:31,130 --> 00:03:33,260
!حسنًا
!لنحسم المسألة بمصارعة السّومو

38
00:03:34,150 --> 00:03:35,330
.لا مانع لديّ

39
00:03:35,330 --> 00:03:36,900
!أرِني أقصى ما لديك

40
00:03:36,900 --> 00:03:38,240
!لنجعلها مِن ثلاث جولات

41
00:03:38,240 --> 00:03:40,030
!بدأتَ تثيرُ حماسي

42
00:03:40,580 --> 00:03:44,520
ماذا؟ مصارعة سومو؟
و... وما الدّاعي لهذا؟

43
00:03:45,780 --> 00:03:48,780
.آسف، هكذا تسير الأمور

44
00:03:48,780 --> 00:03:50,400
.إذن سأكون الحكم

45
00:03:50,960 --> 00:03:52,570
!سنأخذ هاجيمي

46
00:03:53,080 --> 00:03:54,520
لماذا أنا؟

47
00:03:54,520 --> 00:03:56,230
.نحن بحاجةٍ إلى طفلٍ ليُنازلَ طفلًا

48
00:03:56,230 --> 00:03:57,990
!لا تعاملني كطفلٍ

49
00:03:57,990 --> 00:04:01,040
.أَرأيت؟ يا لك مِن طفلٍ

50
00:04:07,190 --> 00:04:09,200
!تشيرينو نيو يقبل التحدّي

51
00:04:09,780 --> 00:04:12,370
.هذا ما أُسمّيه نضجًا

52
00:04:13,830 --> 00:04:15,770
!أ-أنا سأواجهك

53
00:04:15,770 --> 00:04:17,600
مَن يُهزم، فعليه الركض
جولاتٍ مطوّلة، أَفهمت؟

54
00:04:17,930 --> 00:04:20,290
!إيّاك أن تخسر، نيو

55
00:04:20,290 --> 00:04:20,880
!أجل، سيّدي

56
00:04:22,160 --> 00:04:25,110
،حسنًا، إن خسرت
.سأركض معك

57
00:04:25,670 --> 00:04:26,640
!ما زال في الحلبة

58
00:04:26,640 --> 00:04:28,190
!الخاسر لا عشاء له

59
00:04:28,190 --> 00:04:29,120
!اسحقه

60
00:04:29,550 --> 00:04:30,600
!عجبًا

61
00:04:30,600 --> 00:04:32,410
!هذا الصبيّ أصلب ممّا يبدو

62
00:04:32,410 --> 00:04:33,960
!أمسك بحزامه، نيو

63
00:04:33,960 --> 00:04:35,530
!أوقعه أرضًا، هاجيمي

64
00:04:38,630 --> 00:04:39,740
مَن الفائز؟

65
00:04:42,390 --> 00:04:44,100
!تعادلٌ! إنّه تعادلٌ

66
00:04:44,840 --> 00:04:45,470
...اللعنة

67
00:04:46,280 --> 00:04:47,330
.جولةٌ أخرى

68
00:04:50,060 --> 00:04:50,930
.تبًّا

69
00:04:51,080 --> 00:04:52,890
ماذا؟

70
00:04:57,580 --> 00:04:59,690
كيف لكم أن تتصارعوا دُوني؟

71
00:05:02,370 --> 00:05:03,730
!ها هو قادم

72
00:05:03,730 --> 00:05:04,960
!أوقفوه

73
00:05:04,960 --> 00:05:06,370
!سيطرحنا جميعًا

74
00:05:07,340 --> 00:05:08,450
!سأواجهك

75
00:05:09,840 --> 00:05:11,010
!وا أسفاه

76
00:05:11,450 --> 00:05:14,590
!أيّها الأحمق! لا تستهِن بي

77
00:05:16,880 --> 00:05:18,240
!أطاحَ بسانو هو الآخر

78
00:05:18,680 --> 00:05:19,530
.لا جدوى

79
00:05:19,530 --> 00:05:21,070
.إ-إنّه قويٌّ جدًا

80
00:05:24,270 --> 00:05:25,520
!سيّد كوندو

81
00:05:25,520 --> 00:05:30,340
،أنا، سيريزاوا كامو
.سأكون خصمك

82
00:05:41,020 --> 00:05:42,440
!عشرُ أذرع؟ أيعقل هذا؟

83
00:05:44,920 --> 00:05:47,400
!واجه خماسيّ سيريزاوا

84
00:05:47,400 --> 00:05:50,400
!إنّهم يقفون خلفه فقط

85
00:05:50,400 --> 00:05:53,980
،قد نملك خمسة وجوه
!لكن قلوبنا تخفق كقلبٍ واحد

86
00:05:55,610 --> 00:05:57,660
هل خفتَ، كوندو؟

87
00:06:01,960 --> 00:06:03,740
!معًا الآن

88
00:06:19,850 --> 00:06:20,530
.انظروا

89
00:06:20,530 --> 00:06:21,360
...ها هو ذا

90
00:06:21,560 --> 00:06:22,860
!الصبيّ طار في الهواء

91
00:06:27,320 --> 00:06:28,520
هؤلاء هم المِيبورو؟

92
00:06:29,340 --> 00:06:32,160
عصابة الأشقياء الّتي يخشاها
أهل البلدة كلّهم؟

93
00:06:37,080 --> 00:06:38,800
.لا يخيفونني البتّة

94
00:06:42,120 --> 00:06:43,370
.أ-أنت

95
00:06:42,380 --> 00:06:45,380
ناغاكورا شينباتشي

96
00:06:42,380 --> 00:06:45,380
هارادا سانوسكي

97
00:06:43,710 --> 00:06:45,380
.إنّه يضحك

98
00:06:45,590 --> 00:06:47,200
أتراه ارتطم برأسه؟

99
00:06:45,630 --> 00:06:49,010
تودو هيسكي

100
00:06:45,630 --> 00:06:49,010
يامانامي كيسوكي

101
00:06:45,630 --> 00:06:49,010
إينويه غينزابورو

102
00:06:49,260 --> 00:06:51,310
سايتو هاجيمي

103
00:06:49,380 --> 00:06:50,490
!يبدو أنّه قد فقد صوابه تمامًا

104
00:06:52,270 --> 00:06:54,770
أوكيتا سوجي

105
00:06:52,270 --> 00:06:54,770
هيجيكاتا توشيزو

106
00:06:54,770 --> 00:06:56,270
هيرياما جوسوكي

107
00:06:54,770 --> 00:06:56,270
هيرياما غورو

108
00:06:54,770 --> 00:06:56,740
ها قد أحكم قبضته
!على نوغوتشي ثانيةً

109
00:06:56,270 --> 00:06:57,770
نوغوتشي كينجي

110
00:06:57,770 --> 00:06:59,270
نيئيمي نيشيكي

111
00:06:58,150 --> 00:06:59,270
.نوغوتشي

112
00:06:59,580 --> 00:07:02,560
!سيّد كوندو
ماذا عن نزالنا؟

113
00:06:59,730 --> 00:07:02,570
سيريزاوا كامو

114
00:07:04,110 --> 00:07:06,860
كوندو إيسامي

115
00:07:07,020 --> 00:07:09,660
!أمسكوا بواحدٍ آخر
!عند جسر سانجو

116
00:07:11,950 --> 00:07:15,240
...جسر سانجو؟ هل يقصدون

117
00:07:12,560 --> 00:07:14,280
!أسرعوا

118
00:07:14,280 --> 00:07:15,240
!استعدّوا

119
00:07:16,520 --> 00:07:17,120
،نيو

120
00:07:18,430 --> 00:07:19,680
هل ستنضمّ إلينا؟

121
00:07:20,180 --> 00:07:24,400
،لا يُفترض بي تحذيرك
!بيد أنّ ما ستراه لن يسرّك

122
00:07:26,880 --> 00:07:27,780
.أعلم ذلك

123
00:07:29,110 --> 00:07:30,840
.كُلّ مَن يعيش في كيوتو يعلم ذلك

124
00:07:36,310 --> 00:07:38,810
​بيانُ حُجّة

125
00:07:39,540 --> 00:07:41,190
رأسٌ مقطوعٌ آخر؟

126
00:07:41,510 --> 00:07:43,170
ومَن يكون هذه المرّة؟

127
00:07:43,170 --> 00:07:44,710
ما فحوى المكتوب على اللّافتة؟

128
00:07:44,710 --> 00:07:46,320
.كاهنٌ آثم، على ما يبدو

129
00:07:46,980 --> 00:07:50,890
...واحدٌ آخر
.لم يتوقّف الأمر مُنذ عامٍ كامل

130
00:07:51,570 --> 00:07:53,380
مذكورٌ هنا أنّه كان
.داهيةً متآمرًا يبتغي المكائد

131
00:07:53,380 --> 00:07:55,070
.إذًا، فقد قُضي الأمر

132
00:07:55,790 --> 00:07:57,880
.نال جزاءه العادل

133
00:07:58,530 --> 00:08:00,380
.لا بُدّ أنّه اقترف أمرًا شنيعًا

134
00:08:00,380 --> 00:08:02,410
إلى أين يمضي هذا العالم؟

135
00:08:04,000 --> 00:08:04,910
...هيجيكاتا-سان

136
00:08:06,600 --> 00:08:08,570
،لا أعرف الكثير عن هذه الأمور

137
00:08:09,260 --> 00:08:13,290
...ولكن، هل المقتول شريرٌ دومًا
ومَن يُقيم الحدّ عليه مِن الأخيار أصلًا؟

138
00:08:14,790 --> 00:08:19,330
،هل الّذين يحاولون جعل العالم مكانًا أفضل
يقترفون أشياء كهذه حقًا؟

139
00:08:23,860 --> 00:08:26,510
.متطرّفون يتردّدون على نُزلٍ معيّن

140
00:08:27,640 --> 00:08:28,750
.سنُغير عليه الليلة

141
00:08:29,480 --> 00:08:32,480
.سترى بنفسك حين نفعل

142
00:08:35,560 --> 00:08:36,380
.إنّه محقّ

143
00:08:37,120 --> 00:08:38,800
.لا بُدّ أن أرى بعينيّ

144
00:08:39,510 --> 00:08:41,440
.لهذا جئتُ إلى هنا

145
00:08:51,210 --> 00:08:53,310
هل أنت متأكّد فعلًا، يا نيو؟

146
00:08:53,510 --> 00:08:56,240
.أجل، سيّدي

147
00:08:57,360 --> 00:09:00,270
،أريد أن أعرف
.أريد أن أكتشف ما الّذي يحدث في كيوتو

148
00:09:01,200 --> 00:09:04,270
.حسنًا، ابقَ وراءنا

149
00:09:05,750 --> 00:09:06,360
.هيّا بنا

150
00:09:08,440 --> 00:09:11,280
!نحن في جولةٍ تفقّدية
!لا يتحرّك منكم أحد

151
00:09:15,630 --> 00:09:19,400
!أمرٌ مريب
!أيّ نُزلٍ هذا الّذي تخلو ممراته مِن الأضواء

152
00:09:29,760 --> 00:09:31,400
!مُت

153
00:09:39,420 --> 00:09:40,290
...لقد قتله

154
00:09:40,290 --> 00:09:41,610
!لقد قتله فعلًا

155
00:09:45,680 --> 00:09:46,600
...أوكيتا-سان

156
00:09:51,070 --> 00:09:53,060
!لـ-لم يكن هذا هو الاتفاق

157
00:09:53,950 --> 00:09:54,810
أيّ اتفاق؟

158
00:09:55,120 --> 00:09:59,400
،قيلَ لنا إن علينا التخلّص مِن ذلك الشّرير فحسب
!وسنجني مِن ورائه مالًا وفيرًا بلا عناء

159
00:09:59,400 --> 00:10:01,830
كان مِن المُفترض أن ننهل
!مِن الخمر والنّساء كما نشاء

160
00:10:05,140 --> 00:10:07,830
،إنّه لأمرٌ يبعث على الانشراح
!أن أرى صُعلوكًا عديم الحياء مثلك

161
00:10:08,110 --> 00:10:09,560
!ا-انتظر

162
00:10:09,830 --> 00:10:13,590
ألقيتُ بأُذن القتيل داخل المنزل
!الّذي أمروني به فحسب

163
00:10:14,350 --> 00:10:16,210
...إذًا، هذا ما يؤولُ إليه الإنسان

164
00:10:16,590 --> 00:10:22,350
،حين يتجرّد مِن الحقّ والمبادئ
.يصبح حُثالةً على شاكلتك

165
00:10:36,400 --> 00:10:38,480
،هيجيكاتا-سان

166
00:10:39,420 --> 00:10:41,720
.انتبه لموضع تناثر الدّم

167
00:10:42,120 --> 00:10:43,110
.اصمت

168
00:10:47,290 --> 00:10:49,920
مِن الأفضل أن نُسرع
.بالعودة لتستحمّ

169
00:11:19,690 --> 00:11:20,680
لا تستطيع النوم؟

170
00:11:22,700 --> 00:11:25,620
،أَكنت تريد لهم الحياة
على ما هُم عليه مِن خِسّة؟

171
00:11:25,840 --> 00:11:28,560
.ماذا؟ كلا

172
00:11:29,360 --> 00:11:33,080
،مَن استحلّ الدّماء طلبًا للمال
.فثمن ذلك حياته

173
00:11:34,280 --> 00:11:35,880
فما الّذي يُقلقك إذن؟

174
00:11:36,420 --> 00:11:39,400
،لا شيء يُقلقني تحديدًا
.كنت أُفكّر فحسب

175
00:11:39,680 --> 00:11:41,330
تفكّر في ماذا؟

176
00:11:41,950 --> 00:11:44,520
...ماذا لو كان مَن أُمرت بقتله
يشبهني؟

177
00:11:45,150 --> 00:11:47,390
...ماذا لو كان هو أيضًا
يطمح لجعل العالم مكانًا أفضل؟

178
00:11:48,250 --> 00:11:51,360
ماذا عليّ أن أفعل حينئذٍ؟

179
00:11:54,320 --> 00:12:00,460
هيجيكاتا-سان، كنت أظنّ دائمًا أنّ
،هناك أشرارًا يسرقون ويقتلون

180
00:12:00,460 --> 00:12:02,990
،وأخيارًا يحاولون إيقافهم

181
00:12:03,430 --> 00:12:06,300
.وأنّ هذا هو سبب فوضى كيوتو

182
00:12:10,520 --> 00:12:14,950
لكن الأمر لا يتعلّق حقًا
بصراعٍ بين الخير والشر، أليس كذلك؟

183
00:12:15,330 --> 00:12:19,670
،الأخيار يتقاتلون فيما بينهم
.حتّى استحال المطر دمًا

184
00:12:23,160 --> 00:12:25,220
.ما مِن أحدٍ يُولد شريرًا

185
00:12:25,780 --> 00:12:31,880
إذ لا يوجد إنسانٌ
.يرى نفسه الشّرير مهما جنى

186
00:12:32,790 --> 00:12:35,350
ماذا عليّ أن أفعل؟

187
00:12:35,920 --> 00:12:36,820
ماذا تقصد؟

188
00:12:36,820 --> 00:12:40,160
كيف لي أن أتعلّم النّهج
الّذي تسير عليه أنت وأوكيتا-سان؟

189
00:12:42,200 --> 00:12:44,380
...ببساطةٍ يا نيو

190
00:12:45,420 --> 00:12:47,990
اجعل لكَ ثوابت لا تهتزّ
.مهما عصفت بكَ الظروف

191
00:12:49,420 --> 00:12:54,680
فإن لم يستطع أحدٌ
...أن ينزعها مِن وجدانك

192
00:12:56,170 --> 00:12:58,260
.فتلك هي العدالة في نظرك

193
00:12:59,070 --> 00:13:01,830
،طالما استمسكتَ بهذا اليقين
.فبإمكانك أن تصرع كلّ مَن وجب عليك القضاء عليه

194
00:13:06,400 --> 00:13:09,310
،اللعنة… أشعر بالنّعاس
.حان وقت النوم

195
00:13:15,530 --> 00:13:17,720
،فهمت الآن
.اتّضح لي الأمر تمامًا

196
00:13:18,330 --> 00:13:21,010
...الرّائحة العالقة بهذا المكان

197
00:13:23,180 --> 00:13:24,130
،إنّها رائحة الدّماء

198
00:13:24,970 --> 00:13:26,200
!يفوح المكان دمًا

199
00:13:28,380 --> 00:13:30,270
،لستُ أدرك مِن الحقيقة شيئًا بعد

200
00:13:31,090 --> 00:13:35,490
يلزمني أن أشهد المزيد، وأن أُمعن النّظر
.في أشياءٍ كثيرة، حتّى أستقرّ على رأيٍ يخصّني وحدي

201
00:13:38,020 --> 00:13:39,560
ما العدل؟

202
00:13:40,440 --> 00:13:43,410
وأين يكمن الحقّ؟
وما هي الثوابت الّتي لا تقبل التنازل؟

203
00:13:45,490 --> 00:13:47,640
،سأقضي عُمري في غمار هذه الحيرة
...ولن أكفّ عن البحث

204
00:13:48,820 --> 00:13:52,220
.حتّى أظفر بالحقّ الّذي أُؤمن به

205
00:13:58,080 --> 00:14:00,680
أثمّة ما يشغل بالك يا نيو-كون؟

206
00:14:01,070 --> 00:14:05,810
،أوكيتا-سان... أجل، أظنّ ذلك
كنت أتساءل فحسب... ما هي العدالة حقًا؟

207
00:14:06,080 --> 00:14:07,680
العدالة إذن؟

208
00:14:08,370 --> 00:14:09,570
ألديك جواب؟

209
00:14:10,240 --> 00:14:12,360
.عليك أن تكتشف ذلك بنفسك

210
00:14:14,450 --> 00:14:16,030
.مـ-محقٌّ

211
00:14:17,050 --> 00:14:19,820
ليس هذا أمرًا يمكن لأحدٍ
.أن يُلقّنك إياه

212
00:14:19,820 --> 00:14:24,070
على ذِكر ذلك... لم أؤدّ واجب
.الشّكر والتّقدير لعائلة ياجي بعد

213
00:14:24,070 --> 00:14:28,820
،السيّد غينوجو قد خرج للتّو
.لا بأس، ستلتقي به عاجلًا أم آجلًا

214
00:14:28,820 --> 00:14:32,270
،لا تتقيّد بالأعراف والرسميات أبدًا
أليس كذلك يا أوكيتا-سان؟

215
00:14:34,260 --> 00:14:36,310
...هذا هو مفهومي للعدالة

216
00:14:36,860 --> 00:14:38,010
ردٌّ جيّد، ألا تظنّ ذلك؟

217
00:14:38,440 --> 00:14:40,420
!نيو! تعال إلى هنا فورًا

218
00:14:40,420 --> 00:14:44,440
...كدت أنسى
.السيّد هيجيكاتا يطلب رؤيتك

219
00:14:44,810 --> 00:14:45,830
ماذا؟

220
00:14:45,830 --> 00:14:48,230
!قـ-قادمٌ في الحال يا سيّدي

221
00:14:49,720 --> 00:14:52,010
.سنخرج نحن الثّلاثة في جولةٍ تفقّدية

222
00:14:52,810 --> 00:14:55,040
!جولةٌ تفقديّة؟
.سأكون عند حُسن ظنّك يا سيّدي

223
00:14:56,790 --> 00:14:58,400
!مهلًا... أَقُلت نحن الثّلاثة؟

224
00:15:00,870 --> 00:15:02,300
.كوندو-سان

225
00:15:02,720 --> 00:15:05,720
أ-أظنّ أنّنا لم نتعارف
.على نحوٍ لائق بعد، أنا نيو

226
00:15:05,720 --> 00:15:07,300
إنّه لشرفٌ عظيم لي
.أن أكون في خدمتكم

227
00:15:07,620 --> 00:15:10,130
.بكلّ تأكّيد، أنا كوندو إيسامي

228
00:15:11,060 --> 00:15:12,100
.ويسعدني أن أكون معكم

229
00:15:12,600 --> 00:15:13,790
.شـ-شكرًا لك، سيّدي

230
00:15:24,560 --> 00:15:30,070
تمهّل قليلًا، لن تصمد ساعةً وأنت
.على هذه الحال، حاول أن تسترخي

231
00:15:30,500 --> 00:15:32,060
.أجل، سيّدي

232
00:15:32,550 --> 00:15:36,570
كنت أظنّ كيوتو تعجّ
.بالنبلاء المُتملّقين فحسب

233
00:15:37,110 --> 00:15:41,080
لكنّني أرى الكثير مِن السّاموراي
.الّذين يحملون أطقم سيوفٍ ملائمة أيضًا

234
00:15:41,410 --> 00:15:47,040
قاد سيّد إيزو ألف جنديّ إلى المدينة
.في الشهر الثاني عشر مِن العام الماضي

235
00:15:47,280 --> 00:15:50,100
ويبدو أن عدد السّاموراي ازداد كثيرًا
.مُنذ ذلك الحين

236
00:15:50,100 --> 00:15:53,590
،هكذا إذن؟ كيوتو مكانٌ رائع
.كما تصفُها الألسن تمامًا

237
00:15:53,880 --> 00:15:56,280
.سُررت بمجيئي إلى هنا يا توشي

238
00:15:57,610 --> 00:15:59,290
.يسرّني حقًا أن تكون معنا يا نيو

239
00:15:59,910 --> 00:16:03,720
،انضمّ ثلاثةٌ مِن أبناء هذه المنطقة بين صفوفنا
.وسنحتاج إلى معرفتكم العميقة بالأرجاء

240
00:16:04,640 --> 00:16:06,900
...كلا، أنا لا أعرف أيّ شيءٍ يمكنه

241
00:16:07,240 --> 00:16:09,880
،مهلًا، استوقفني قولك
مَن عساهما أن يكونا الآخران؟

242
00:16:09,450 --> 00:16:09,880
.انظرا

243
00:16:13,400 --> 00:16:14,080
.اتبعاه

244
00:16:14,750 --> 00:16:15,360
.أجل، سيّدي

245
00:16:19,740 --> 00:16:22,220
!إ-إنّه سريعٌ جدًا
.أفترض أنّ ذلك طبيعيّ بالنسبة لشخصٍ بالغ

246
00:16:23,800 --> 00:16:24,750
لِمَ هو بطيءٌ هكذا؟

247
00:16:24,750 --> 00:16:26,840
!انسَ أمري! لا تدعه يفلت

248
00:16:27,090 --> 00:16:28,330
.أ-أجل، سيّدي

249
00:16:33,480 --> 00:16:34,920
.غالب الظنّ أنّه سلك هذا الطّريق

250
00:16:34,920 --> 00:16:36,920
.هذه المنطقة مليئةٌ بالأزقة الضيّقة

251
00:16:38,620 --> 00:16:40,390
مِن الأحسن أن يتوزّع
.كلٌّ منّا في اتّجاه

252
00:16:40,960 --> 00:16:42,410
.سأتجه يسارًا

253
00:16:42,630 --> 00:16:44,620
،كوندو-سان
.تقدّم أنت إلى الأمام

254
00:16:44,620 --> 00:16:45,600
.نيو عليك بالجهة اليمنى

255
00:16:46,020 --> 00:16:47,600
اصرخا بأعلى صوتكما
.إن وقعت أعينكما عليه

256
00:16:47,820 --> 00:16:48,350
.أجل، سيّدي

257
00:16:51,470 --> 00:16:55,530
لست أعلم فِعلة ذاك الرجل، بيد أنّ مَن
.ضاقت به السّبل وحُوصر، قد يغدو وحشًا كاسرًا

258
00:16:59,800 --> 00:17:00,840
طفلةٌ؟

259
00:17:01,190 --> 00:17:03,450
.لكنّها خارج نطاق بحثنا

260
00:17:12,360 --> 00:17:13,180
هل أنتِ بخير؟

261
00:17:17,200 --> 00:17:17,770
.تعالي

262
00:17:22,520 --> 00:17:24,520
.لا يلزمكِ أن تقولي شيئًا

263
00:17:27,710 --> 00:17:28,840
.تفضّلي، هذه لكِ

264
00:17:31,000 --> 00:17:35,080
،لا بُدّ أنّ لهذا الصندل مكانةً خاصة عندكِ
هل كانت أختكِ الكبرى مَن أعطتكِ إياه؟

265
00:17:35,080 --> 00:17:36,810
.أجل، شكرًا لك

266
00:17:36,810 --> 00:17:39,320
،على الرحب والسعة
هل يمكنكِ العودة إلى المنزل بمفردكِ؟

267
00:17:41,160 --> 00:17:42,480
!قاتلٌ

268
00:17:43,730 --> 00:17:44,830
!فرّ هاربًا

269
00:17:53,880 --> 00:17:54,720
!نيو

270
00:17:54,720 --> 00:17:56,920
!تنحّ عن طريقي

271
00:18:07,230 --> 00:18:08,310
.سيكون كُلّ شيءٍ على ما يرام

272
00:18:10,790 --> 00:18:14,950
سُحقًا لذاك الرّجل! ليس مِن شيم
...السّاموراي أن يُدبر هاربًا بهذا الشّكل

273
00:18:15,560 --> 00:18:18,870
،لكنّه لن يبتعد كثيرًا
.توشي يلحق أثره، وهو سريعٌ كالبرق الخاطف

274
00:18:26,180 --> 00:18:28,430
ألا يعرف أحدٌ في كيوتو
كيف يقاتل؟

275
00:18:47,840 --> 00:18:49,200
.آسفٌ، سيّدي

276
00:18:49,790 --> 00:18:52,000
ولمَ تتأسّف؟

277
00:18:52,000 --> 00:18:53,980
،عصيتُ الأوامر

278
00:18:54,580 --> 00:18:56,640
.ثمّ لُذت بالفرار

279
00:18:56,640 --> 00:18:59,530
.صحيح، حميت تلك الفتاة

280
00:19:00,110 --> 00:19:03,250
،رأيت طفلةً تبكي
.ولم أحتمل تركها وحدها

281
00:19:04,240 --> 00:19:07,280
.كنت مستميتًا لحمايتِها

282
00:19:09,800 --> 00:19:13,600
.سمعت أنّ والديّ قد قُتلا كليهما

283
00:19:14,870 --> 00:19:16,640
سمعت؟

284
00:19:16,850 --> 00:19:21,240
صحيحٌ، فقد كفلني أحد المعابد
.وأنا بعد طفلٌ غرير لا يعي مِن أمره شيئًا

285
00:19:21,810 --> 00:19:24,550
أظنّ أنّ المعبد كان يضمّ
.نحو عشرة أطفالٍ مثلي

286
00:19:26,070 --> 00:19:29,560
عُلّمنا هناك كيف نكبح
.دموعنا وابتساماتنا

287
00:19:30,580 --> 00:19:31,560
لماذا؟

288
00:19:31,980 --> 00:19:34,060
.لأنّ أحدًا لن يتبنّاهم بخلاف ذلك

289
00:19:34,060 --> 00:19:37,030
،أجل يا سيّدي
.أظنّهم كانوا مُحقّين في ذلك

290
00:19:37,800 --> 00:19:41,120
،فبفضل تلك النّصيحة
.نلتُ فرصة العيش مع جدّتي وأختي

291
00:19:42,760 --> 00:19:46,400
،ولكنّني أعتقد، في قرارة نفسي
.أنّني كنت أريد البكاء

292
00:19:47,720 --> 00:19:51,880
كنت أتوق لشخصٍ يضمّني إليه بقوّةٍ
.بينما أُفرغ كلّ ما في جعبتي مِن دُموع

293
00:19:55,230 --> 00:20:00,840
غادرت منزلي وأنا أتشدّق بكلماتٍ منمقةٍ
.عن رغبتي في جعل العالم مكانًا أفضل

294
00:20:02,120 --> 00:20:04,080
...لكن في الحقيقة

295
00:20:05,410 --> 00:20:09,520
كلّ ما أريده هو عالمٌ يشعر فيه
.الأطفال بالأمان لدرجة البكاء

296
00:20:11,240 --> 00:20:14,730
وأودّ أن أكون بجانبهم
.حين يفعلون ذلك

297
00:20:15,680 --> 00:20:17,480
.أريد عالمًا يتيح حدوث أمرٍ كهذا

298
00:20:22,190 --> 00:20:26,960
،أنا آسفٌ، لم أكن عونًا في شيء
.إنّني وصمة عار

299
00:20:29,880 --> 00:20:30,890
.درجةٌ كاملة

300
00:20:30,890 --> 00:20:31,350
ماذا؟

301
00:20:32,340 --> 00:20:35,200
،ساعدت تلك الفتاة
.وهذا أقصى ما كنت أرجوه

302
00:20:35,720 --> 00:20:37,570
حـ-حقًا ما تقول يا سيّدي؟

303
00:20:38,900 --> 00:20:39,720
.أجل

304
00:20:41,380 --> 00:20:42,940
أكان ما فعلت هو التصرّف الصّحيح؟

305
00:20:44,500 --> 00:20:45,360
.أجل، هو كذلك

306
00:20:49,820 --> 00:20:51,890
...لن أنسى أبدًا

307
00:20:53,620 --> 00:20:56,640
يبدو أنّك قد أدركت الآن
.معنى العدل بالنّسبة إليك

308
00:20:57,760 --> 00:21:02,980
كلمات هيجيكاتا-سان لي، ولا تلك الهيبة...
.الطّاغية الّتي بدت على كوندو-سان آنذاك

309
00:21:05,240 --> 00:21:07,140
.مرحبًا بك في المِيبورو

310
00:21:14,510 --> 00:21:19,380
،لكن في ذلك الوقت
...لم يكن لديّ أدنى وسيلةٍ لأعرف

311
00:21:24,650 --> 00:21:27,000
...استغفلتني

312
00:21:32,450 --> 00:21:34,790
.يا سيريزاوا

313
00:21:37,810 --> 00:21:41,130
أنّ أولى عمليات التّطهير...
.في المِيبورو قد بدأت بالفعل

314
00:21:44,910 --> 00:21:49,910
عالمٌ
لا بأس

315
00:21:44,910 --> 00:21:49,910
فيه
بالبكاء

316
00:23:20,040 --> 00:23:25,460
الحلقة القادمة

317
00:23:23,310 --> 00:23:27,210
،أنا تشيرينو نيو
.وحياتي مع المِيبورو قد بدأت للتّو

318
00:23:27,600 --> 00:23:31,030
أشعر بالوحدة أحيانًا
،بعيدًا عن جدّتي وإيروها

319
00:23:31,380 --> 00:23:33,950
لكن الجميع هنا يملؤون المكان
.صخبًا ومرحًا، لذا يمكنني التحمّل

320
00:23:34,720 --> 00:23:38,040
،لكن.. ثمّة أمرٌ ما يقلقني

321
00:23:38,770 --> 00:23:42,500
يتعلّق بفتىً آخر في مثل
.عمري يُدعى تاناكا تارو-كون

322
00:23:43,720 --> 00:23:45,610
:الحلقة القادمة
."حيث تسكن الرّوح"

323
00:23:45,920 --> 00:23:47,070
.لن يخيب أملكم

324
00:23:47,070 --> 00:23:49,900
حيث
تسكن

325
00:23:47,070 --> 00:23:49,900
الرّوح