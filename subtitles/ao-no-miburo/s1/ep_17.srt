1
00:00:00,450 --> 00:00:08,760
وهكذا، انطلقنا نحن المِيبورو لمُواجهة جماعة
.الريسّيدان الدمويّة الّتي أرادت إحراق المدينة

2
00:00:10,330 --> 00:00:12,380
مَن ذا الّذي قاتله كوندو إيسامي؟

3
00:00:12,380 --> 00:00:14,520
أنا أتشوّق لسماع ما فعله
.أوكيتا سوجي

4
00:00:14,520 --> 00:00:16,190
ماذا عن هيجيكاتا توشيزو؟

5
00:00:17,520 --> 00:00:19,950
ألا يُبالي أحدٌ بما فعلته أنا؟

6
00:00:20,080 --> 00:00:23,280
لحظةً، أَقاتلت أنت كذلك
يا سيّد شينباتشي؟

7
00:00:23,280 --> 00:00:27,290
،أجل
.فلولا معركة تلك اللّيلة

8
00:00:27,560 --> 00:00:33,260
لما عشت حياة السّاموراي
.كما ينبغي حتّى الآن

9
00:00:33,790 --> 00:00:35,240
.يبدو هذا رائعًا

10
00:00:35,240 --> 00:00:37,510
لا أطيق صبرًا لسماع
!ما سيحدث بعد ذلك يا سينسي

11
00:00:39,520 --> 00:00:44,890
،كانت ليلةً عصيفة
.غاب عنها القمر

12
00:00:59,790 --> 00:01:04,090
ذئاب ميبو الزّرق

13
00:02:23,300 --> 00:02:27,180
إذن، أنت قلقٌ بشأن السيّدة
،ناغي-سان الّتي تنتظر مولودًا

14
00:02:27,180 --> 00:02:28,760
وتُريد الاطمئنان عليها؟

15
00:02:29,010 --> 00:02:32,950
،حسنًا، لو أردنا اختصار ما أشعر به
.فهذا هو ما يُمليه عليّ قلبي

16
00:02:33,260 --> 00:02:34,220
!حسنًا إذن

17
00:02:34,220 --> 00:02:36,770
،دعك مِن التّفاصيل المُملّة
!لننطلق يا نيو-كون

18
00:02:36,770 --> 00:02:38,660
.شـ-شكرًا لكِ

19
00:02:38,840 --> 00:02:41,600
بهذه البساطة؟
هل ساكورا بكامل قُواها العقليّة؟

20
00:02:42,360 --> 00:02:43,880
!هيسكي، سوجي

21
00:02:44,200 --> 00:02:45,950
.ليس معنا سيوفٌ

22
00:02:45,950 --> 00:02:48,140
،أعيرانا أيّ شيءٍ
!سنرضى حتّى بالخناجر

23
00:02:48,320 --> 00:02:49,280
!أرجوكما

24
00:02:49,280 --> 00:02:50,690
لـ-لماذا؟

25
00:02:51,010 --> 00:02:56,050
صحيحٌ، رهنتما سيفيكما
.وأضعتما المال في المُقامرة

26
00:02:56,570 --> 00:02:57,790
.لا خيار أمامنا إذن

27
00:02:58,830 --> 00:03:00,120
.أنا مدينٌ لك

28
00:03:00,300 --> 00:03:01,400
!خيرٌ لك أن تُعيده

29
00:03:01,400 --> 00:03:02,810
.حسنًا، حسنًا

30
00:03:03,240 --> 00:03:07,370
أَيريدون إحراق كيوتو؟
.يا لهم مِن مُتباهين حمقى

31
00:03:07,370 --> 00:03:09,870
.سنجعلهم يعرفون حقيقة المِيبورو

32
00:03:10,030 --> 00:03:12,040
.كُن على أهبة الاستعداد يا يامانامي

33
00:03:12,400 --> 00:03:13,880
.لا تُملي عليّ ما يجب فعله

34
00:03:15,240 --> 00:03:18,430
!لا أُريد الموت، لا أُريد الموت

35
00:03:18,430 --> 00:03:19,720
.اخرس

36
00:03:20,120 --> 00:03:21,800
.إنّه الجسر الثّاني بعد المُنعطف

37
00:03:21,800 --> 00:03:22,960
.أعلم ذلك

38
00:03:23,180 --> 00:03:25,230
.نوغوتشي، أنت معي

39
00:03:25,230 --> 00:03:26,440
.لا تتخلّف عن الرّكب

40
00:03:26,440 --> 00:03:28,400
!أجل يا سيّدي، أنا آسفٌ

41
00:03:40,310 --> 00:03:42,120
.هذه الريّاح ستُشكّل عائقًا

42
00:03:42,750 --> 00:03:46,500
إذا أشعلوا النّار عند هذا الجانب
.مِن الجُسور، فستنتشر لمحًا بالبصر

43
00:03:48,720 --> 00:03:49,460
.انظروا

44
00:03:49,750 --> 00:03:51,680
!جسر سانجو

45
00:03:52,100 --> 00:03:53,120
!إشارات دُخانٍ

46
00:03:53,120 --> 00:03:54,760
!إنّها تتصاعد في كُلّ مكانٍ

47
00:03:55,240 --> 00:03:56,640
!ها قد جاءوا

48
00:03:56,640 --> 00:03:57,590
!تفرّقوا

49
00:03:57,880 --> 00:03:58,880
!أجل

50
00:04:16,060 --> 00:04:19,380
وهكذا، انقسم رجال المِيبورو
،إلى سبعة مجموعاتٍ

51
00:04:17,820 --> 00:04:18,400
جسر جوجو

52
00:04:18,360 --> 00:04:20,950
جسر ماتسوبارا

53
00:04:19,380 --> 00:04:23,670
وهرعوا نحو الجُسور السّبعة الّتي
.استهدفتها جماعة الريسّيدان الدمويّة

54
00:04:20,910 --> 00:04:22,660
جسر شيجو

55
00:04:22,620 --> 00:04:25,240
جسر سانجو

56
00:04:24,960 --> 00:04:30,130
انطلق أوكيتا وتودو وكلاهما عدّاءٌ
.سريع حتّى بلغا جسر كوجين-باشي

57
00:04:25,240 --> 00:04:27,500
جسر نيجو

58
00:04:27,540 --> 00:04:29,920
جسر ماروتاماتشي

59
00:04:29,960 --> 00:04:31,170
جسر كوجين

60
00:04:31,480 --> 00:04:36,200
هيجيكاتا، أرسل مجموعة نيو
...عبر جسر سانجو

61
00:04:36,200 --> 00:04:41,180
.نحو مقرّ العدوّ في دُوجو كيوهاتشي

62
00:04:36,260 --> 00:04:41,180
دُوجو كيوهاتشي

63
00:04:41,360 --> 00:04:44,170
!اتبعوني أيّها الرّجال

64
00:04:44,290 --> 00:04:45,170
!أجل يا سيّدي

65
00:04:46,480 --> 00:04:47,170
.إلى المعركة

66
00:04:47,360 --> 00:04:49,680
!لم يعد يهمّني أيّ شيءٍ بعد الآن

67
00:04:53,060 --> 00:04:54,690
!شُعلة نارٍ، وصلوا

68
00:04:59,770 --> 00:05:03,020
!ها قد أَقبل البطل

69
00:05:04,320 --> 00:05:05,950
.تنحَّ عن الطّريق

70
00:05:10,400 --> 00:05:13,430
،يا لحظّك العاثر
.ساقك قَدرك إلى حتفك تمامًا

71
00:05:14,200 --> 00:05:15,160
!ناووزومي-سان

72
00:05:17,290 --> 00:05:19,340
،إذن
.أنت هو زعيم هؤلاء المُتمرّدين

73
00:05:19,580 --> 00:05:21,430
،سيريزاوا-سان
.نحن نعتمد عليك

74
00:05:25,760 --> 00:05:28,320
مع مَن تظنّ أنّك تتحدّث؟

75
00:05:28,320 --> 00:05:29,340
.انطلقوا

76
00:05:32,470 --> 00:05:33,680
...ذلك السّيف، إنّه يُشبه

77
00:05:36,100 --> 00:05:38,100
!لا تتوقّفوا، أسرعوا

78
00:05:40,100 --> 00:05:42,850
!اقـ-اقتحموا، اخترقوا صفّهم

79
00:05:43,320 --> 00:05:44,430
...هؤلاء الـ

80
00:05:44,430 --> 00:05:45,520
،لا تلتفتا إليهم

81
00:05:46,720 --> 00:05:48,350
.تجاهلوهم

82
00:05:55,810 --> 00:05:58,270
ذلك الرّجل ذو المظهر الخشن
.قد يكون مصدر خطر

83
00:05:58,440 --> 00:05:59,000
ماذا؟

84
00:06:04,880 --> 00:06:07,260
ظفرت لنفسي بنصلٍ مِن
.الفُولاذ الأصيل

85
00:06:10,600 --> 00:06:14,010
،أعرف ذلك الغمد الفضّي أيّما معرفةٍ
.صاغه مُعلّمي

86
00:06:14,530 --> 00:06:16,480
.إنّه سيفٌ طويل فريدٌ مِن نوعه

87
00:06:17,490 --> 00:06:20,520
.النّصل الأسود، تسوجوموري

88
00:06:33,040 --> 00:06:38,450
،مِن المُحال تتبّع ذلك النّصل بالبصر
.وغياب ضوء القمر لا يزيد الأمر إلّا تعقيدًا

89
00:06:38,590 --> 00:06:42,710
مـ-ما هذا بحقٍ؟
كيف للمرء أن يصدّ ما لا يراه؟

90
00:06:43,120 --> 00:06:45,670
لا أكاد أُصدّق أنّ هناك مَن يستطيع
.استخدام ذلك الشّيء الثّقيل

91
00:06:51,340 --> 00:06:52,650
!تـ-تراجع

92
00:06:52,650 --> 00:06:53,880
!سيُصيبنا نحن أيضًا

93
00:06:54,880 --> 00:06:58,800
سيريزاوا كامو، أليس كذلك؟
.شُهرتك تسبقك

94
00:06:59,240 --> 00:07:00,550
ماذا؟

95
00:07:03,920 --> 00:07:07,780
،أشرس مُتباهٍ في ميتو
.والنّجم الأبرز بين رجال المِيبورو

96
00:07:07,900 --> 00:07:10,790
لكنّك في الحقيقة لست سوى كُتلةٍ
.مِن التّناقض تمشي بين النّاس

97
00:07:11,030 --> 00:07:12,010
ماذا؟

98
00:07:12,720 --> 00:07:17,280
،سحقت كُلّ مَن تجرأ على اعتراض طريقك
.ودمّرت أصحاب المصالح النّافذة

99
00:07:17,580 --> 00:07:21,290
كنت أنت مَن يتصدّر
.صُفوف المُناهضين للأجانب

100
00:07:23,950 --> 00:07:28,440
وانظر لحالك الآن! صرت النّقيض
.تمامًا، مُجرّد كلبٍ مُطيع للشّوغون

101
00:07:34,310 --> 00:07:36,970
تفسح الدّرب لصَحبك؟

102
00:07:37,400 --> 00:07:39,320
تنصر الضّعفاء؟

103
00:07:40,700 --> 00:07:44,980
،أيّ عدالةٍ هذه الّتي تدّعيها
وهي لا تملك رُكنًا واحدًا ترتكز عليه؟

104
00:07:49,000 --> 00:07:50,830
.صدّ الضّربة

105
00:07:51,000 --> 00:07:53,580
محالٌ! هل يعني هذا أنّه
يستطيع رُؤية ذلك النّصل؟

106
00:07:54,440 --> 00:07:56,590
على ماذا ترتكز؟

107
00:07:57,830 --> 00:07:59,880
.أخطأتَ تمامًا في فهم الأمر

108
00:08:00,720 --> 00:08:05,240
موازين العدالة تتبدّل كُلّما
.بدّلت موقفي الّذي أرتكز عليه

109
00:08:13,240 --> 00:08:14,140
.لا تقلقي

110
00:08:14,600 --> 00:08:15,480
ماذا؟

111
00:08:16,530 --> 00:08:17,890
.محالٌ أن يُهزم سيريزاوا-سان

112
00:08:18,420 --> 00:08:23,320
في هذه اللّحظة، سيريزاوا كامو
...ورجاله في ميبو روشيغومي

113
00:08:23,940 --> 00:08:28,310
هُم الرّكن الأوحد الّذي
.ترتكز عليه موازين العدالة

114
00:08:28,900 --> 00:08:31,910
جسر نيجو

115
00:08:33,330 --> 00:08:34,410
،شينباتشي

116
00:08:37,670 --> 00:08:39,330
.فلا يختلط عليك الأمر

117
00:08:39,330 --> 00:08:40,870
،أعلم ذلك

118
00:08:40,870 --> 00:08:43,660
.أَبقِ نظرك حادًا ولا تغفل يا سانوسوكي

119
00:08:44,370 --> 00:08:47,110
أيمكننا الاتكال عليكما حقًا؟

120
00:08:47,110 --> 00:08:48,880
!هيراما وهيراياما

121
00:08:48,880 --> 00:08:52,700
لا يفقد سيفه عند الشّدائد
.إلّا أبله لا عقل له

122
00:08:52,700 --> 00:08:54,430
!أنتما عالةٌ على المِيبورو بحماقتكما

123
00:08:54,430 --> 00:08:59,140
،سُحقًا لكما
!ما أنتما إلّا أتباعٌ لدى سيريزاوا

124
00:08:59,140 --> 00:09:01,390
،هذا صحيحٌ
!اهتمّا بشُؤونكما فحسب

125
00:09:07,040 --> 00:09:08,640
.معذرةً، نعتذر بشدّةٍ

126
00:09:07,040 --> 00:09:08,640
!أفسحوا الدّرب

127
00:09:09,200 --> 00:09:11,240
!جسرنا المَنشود يقع في مكانٍ أبعد

128
00:09:11,530 --> 00:09:12,900
!حظًا طيبًا

129
00:09:13,320 --> 00:09:15,600
.سرعة هذين الرّفقين لا تُصدّق

130
00:09:15,600 --> 00:09:17,600
إياكما والتّقصير، هل سمعتما؟

131
00:09:17,760 --> 00:09:19,830
!اخرس، وأنتما كذلك

132
00:09:29,210 --> 00:09:30,820
.ها نحن ذا، جسر نيجو

133
00:09:34,240 --> 00:09:36,040
!لا شكّ أنّكما مِن المِيبورو

134
00:09:36,440 --> 00:09:37,680
!لا تقفا في طريقنا

135
00:09:37,880 --> 00:09:40,770
.واحدٌ، اثنان، ثلاثةٌ فحسب

136
00:09:41,070 --> 00:09:42,930
.توقّعت أن نُواجه حشدًا أكبر

137
00:09:43,320 --> 00:09:45,750
انظرا، إنّهما لا يحملان
.سيوفًا حقيقيّة

138
00:09:46,000 --> 00:09:47,990
،معك حقٌّ
.ليس معهما سوى الواكيزاشي

139
00:09:48,330 --> 00:09:50,200
.وأنا الّذي حسبتهما مِن السّاموراي

140
00:09:51,550 --> 00:09:53,900
.لنُقرّر مَن منّا سيتكفّل بهم

141
00:09:54,600 --> 00:09:56,440
.أجل، أُوافقك

142
00:10:00,970 --> 00:10:01,550
.أختار ظهر العُملة

143
00:10:02,860 --> 00:10:04,440
،يا للأسف
.استقرّت على الوجه

144
00:10:05,380 --> 00:10:06,380
.هكذا إذًا

145
00:10:09,240 --> 00:10:10,680
أيّ جانبٍ منها هو الوجه؟

146
00:10:10,680 --> 00:10:13,130
وكيف لي أن أعرف؟ كان عليك
!تحديد ذلك قبل أن تقذفها

147
00:10:13,470 --> 00:10:16,060
ثُمّ، أليست هذه النّقود الّتي
جناها نيو وتارو؟

148
00:10:16,060 --> 00:10:17,610
.استعرتها فحسب

149
00:10:17,950 --> 00:10:22,030
طباعك لا تتغيّر أبدًا، تترك الأمور
.للصّدفة دائمًا ثُمّ تفشل

150
00:10:22,240 --> 00:10:24,640
لم تكن تعتقد ذلك حينما
!وافقت على الانضمام إليّ

151
00:10:25,080 --> 00:10:26,510
!كفاكما هُراءً أيّها المُهرّجان

152
00:10:32,400 --> 00:10:34,240
!ستدفعان ثمن هذا غاليًا

153
00:10:38,580 --> 00:10:39,500
.يا للهول

154
00:10:57,480 --> 00:10:58,780
.مُجرّد ضجيجٍ بلا فعلٍ

155
00:10:58,960 --> 00:11:00,860
.كان عليهم التدرّب بجديّةٍ أكبر

156
00:11:02,230 --> 00:11:04,120
!سانوسوكي، النّار تلتهم ثيابك

157
00:11:06,220 --> 00:11:07,470
!أسرع وأخمدها

158
00:11:11,240 --> 00:11:12,600
.كان ذلك وشيكًا

159
00:11:12,600 --> 00:11:14,260
.تراخيت في حذرك قبل الأوان

160
00:11:15,800 --> 00:11:16,760
.أحسنتما صُنعًا

161
00:11:18,280 --> 00:11:19,760
هل أنت زعيمهم؟

162
00:11:20,630 --> 00:11:21,570
!إنّي أعرفك

163
00:11:25,600 --> 00:11:28,820
،كنت أرجو ألّا تأتيا

164
00:11:29,250 --> 00:11:32,720
،بل للحقيقة
.كنت آمل أن نلتقي

165
00:11:32,940 --> 00:11:34,450
!إنّه ذلك العجوز مِن حانة القمار

166
00:11:34,750 --> 00:11:37,880
،هيهات أن يكون لقاؤنا مُجرّد نحسٍ
.بل هو مشيئة الأقدار

167
00:11:38,500 --> 00:11:40,960
أنت مِن جماعة الريسّيدان إذًا؟

168
00:11:40,960 --> 00:11:44,720
،لم يخطر ببالي أبدًا
.كنت تتودّد إلينا كصديقٍ حميم

169
00:11:44,930 --> 00:11:47,500
،بلغني أنكما مِن المِيبورو

170
00:11:47,870 --> 00:11:50,910
.لكنّي لم أتخيّل أنّنا سننقلب خُصومًا

171
00:11:51,760 --> 00:11:53,950
،طاب لنا السّمر معك

172
00:11:54,250 --> 00:11:56,380
فما بالك تزجّ بنا في
خضمّ القتال الآن؟

173
00:11:57,510 --> 00:11:59,870
!تقاسمنا كأس الشّراب معًا

174
00:12:05,820 --> 00:12:08,410
والآن، مَن منكما يبدأ؟

175
00:12:08,880 --> 00:12:11,400
أم تُفضّلان أن أطيح بكما معًا؟

176
00:12:12,020 --> 00:12:12,760
رمحٌ؟

177
00:12:14,690 --> 00:12:17,140
.لا مفرّ مِن هذه المعركة

178
00:12:17,420 --> 00:12:20,430
جسر كوجين

179
00:12:17,760 --> 00:12:23,090
ما هذه المعركة إلّا جولةٌ في رحى حربٍ
.طاحنة بين المِيبورو والريسّيدان

180
00:12:20,430 --> 00:12:23,430
جسر شيجو

181
00:12:23,430 --> 00:12:26,430
جسر ماروتاماتشي

182
00:12:23,950 --> 00:12:28,600
سقوط جسرٍ واحد مِن بين
.أيديكم كفيلٌ بإعلان هزيمتكم

183
00:12:26,430 --> 00:12:29,440
جسر ماتسوبارا

184
00:12:29,440 --> 00:12:32,440
جسر جوجو

185
00:12:29,930 --> 00:12:36,290
،وبينما نتحدّث الآن
.يصطدم رفاقكم بمُقاتلين أشدّاء وماكرين

186
00:12:32,440 --> 00:12:36,940
جسر سانجو

187
00:12:38,580 --> 00:12:39,950
!هيّا، أسرعوا بخُطاكم

188
00:12:43,120 --> 00:12:45,960
السّاموراي في هذه الأيّام
.ليسوا سوى حُثالةٍ فاسدة

189
00:12:47,440 --> 00:12:49,270
.الكسل طبيعةٌ بشريّة

190
00:12:49,460 --> 00:12:53,660
وما مِن أحدٍ بمقدوره كبت نزواته
.للأبد لمُجرّد مكانة منصبه

191
00:12:54,130 --> 00:13:00,470
،كثر أولئك الّذين يتباهون بلقب السّاموراي
.وهم لا يفعلون شيئًا سوى سحق الضّعفاء تحت أقدامهم

192
00:13:00,820 --> 00:13:03,450
يبدو أنّ لديك ثأرًا قديمًا
.مع السّاموراي

193
00:13:03,670 --> 00:13:06,960
مَن أنت بحقّ السّماء أيّها العجوز؟

194
00:13:12,800 --> 00:13:17,000
،كان جدّي كودو سوكيتسوني
.ساموراي مِن حقبة هيان

195
00:13:17,610 --> 00:13:19,980
.لذلك فأنا أحمل نسب مُحاربٍ حقيقيّ

196
00:13:21,100 --> 00:13:27,840
،لكنّي لم أكن سوى ساموراي مِن رُتبةٍ دنيّة
.أَقتات مِن زراعة الأرز في الشّمال الشّرقي

197
00:13:34,460 --> 00:13:38,000
هناك، قام ساموراي
.بقتل ابني وحفيدي

198
00:13:39,710 --> 00:13:43,000
توقّعت أن يُحكم عليه
،ببقر بطنه عقابًا

199
00:13:44,330 --> 00:13:50,850
،لكنّه نفد بجلده بعُقوبة هزيلةٍ لم تتعدّ النّفي
.بذريعة أنّه كان يثأر لكرامته

200
00:13:52,510 --> 00:13:55,940
.هجرت دياري طلبًا للثّأر

201
00:13:58,340 --> 00:13:59,730
ولكن، ماذا أبصرت عيناي؟

202
00:14:01,080 --> 00:14:06,110
أوغادٌ يجرّون الكهنة العجائز عن قارعة
.الطّريق ليختبروا حِدّة نصالهم

203
00:14:07,450 --> 00:14:12,370
وحوشٌ لا يردّهم رادعٌ
.عن إشباع شهواتهم

204
00:14:13,490 --> 00:14:14,730
.ابتساماتٌ مجبولة على الخسّة

205
00:14:15,090 --> 00:14:17,710
هذه هي حقيقة مَن يحملون
.لقب السّاموراي زُورًا وبُهتانًا

206
00:14:18,730 --> 00:14:22,860
أمثال هؤلاء لا همّ لهم سوى
.إذاقة الضّعفاء مرارة العذاب

207
00:14:24,690 --> 00:14:26,430
لذا، عزمت على الخلاص
.منهم جميعًا

208
00:14:27,890 --> 00:14:29,480
.على إبادتهم

209
00:14:34,600 --> 00:14:40,180
صقلت مهاراتي لأُرسل أكبر قدرٍ
.مُمكن مِن السّاموراي إلى الجحيم

210
00:14:41,050 --> 00:14:44,570
،كنت حارسًا شخصيًا في وضح النّهار
.ومُغتالًا مأجورًا تحت جُنح اللّيل

211
00:14:45,610 --> 00:14:50,400
،انتقيت ضحاياي بعنايةٍ
.وقتلت أكثر مِن عشرين رجلًا

212
00:14:51,920 --> 00:14:55,270
شعرت بالرّضا، لكن الابتسامة
.لم تعرف طريقًا إلى شفتيّ

213
00:14:56,840 --> 00:15:03,950
فكُلّ رُوحٍ أزهقتها كانت تُخلّف في نفسي ذرّةً
.مِن الذّنب، تتراكم كالوحل في قاع النّهر

214
00:15:05,400 --> 00:15:08,710
.وبعدها، التقيت بذاك الرّجل

215
00:15:09,810 --> 00:15:12,530
.لا تَلُم نفسك أيّها العجوز

216
00:15:13,030 --> 00:15:15,970
.أدركت مِن نظرةٍ واحدة أنّه مختلفٌ

217
00:15:16,920 --> 00:15:19,090
.بل لُم الزّمان الّذي نعيش فيه

218
00:15:19,590 --> 00:15:21,880
ألم تُفكّر يومًا في تغييره؟

219
00:15:24,360 --> 00:15:27,640
فهو يتحدّث بمنطقٍ
.لا يمت لعصرنا بصلةٍ

220
00:15:28,260 --> 00:15:32,500
رُبّما ليس كلامه سوى
.أضغاث أحلامٍ أو تُرهاتٍ جُنونيّة

221
00:15:33,340 --> 00:15:38,700
لكن، إذا كان البديل هو أن أَذوي وأَفنى
،دُون أن تطأ قدمي أرض المعركة

222
00:15:39,030 --> 00:15:42,200
فإن لهذه الهذيانات
.قيمةً تستحقّ الالتفات

223
00:15:44,290 --> 00:15:46,200
.هذا العجوز صلدٌ مرير

224
00:15:46,460 --> 00:15:48,880
—لا أحد في دُوجو القتال بمقدوره حتّى

225
00:15:51,800 --> 00:15:56,120
أنا أُدعى الصّياد، وعملي هو قنص تلك
.الوحوش الّتي تُلقّب بالسّاموراي

226
00:15:56,520 --> 00:15:58,310
!والآن، استلّا سلاحكما

227
00:15:58,750 --> 00:16:01,340
،افعلاها
.إن كنتما ساموراي حقيقيّين

228
00:16:04,960 --> 00:16:05,880
.أيّها العجوز

229
00:16:06,480 --> 00:16:08,520
أَمصممٌ أنت على خوض
هذا النّزال حتّى النهاية؟

230
00:16:08,760 --> 00:16:09,470
.بالطّبع

231
00:16:10,450 --> 00:16:11,800
.حسنًا إذًا

232
00:16:13,050 --> 00:16:13,940
.أنا أفهمك

233
00:16:17,090 --> 00:16:20,120
،إن كنت تبتغي رأسي
.فدُونك إيّاه، خُذه، فهو لك

234
00:16:22,100 --> 00:16:23,080
!يا هذا

235
00:16:23,080 --> 00:16:25,550
!ليس هذا وقت المزاح يا شينباتشي

236
00:16:25,930 --> 00:16:27,130
.لست أمزح

237
00:16:27,840 --> 00:16:28,340
!يا إلهي

238
00:16:28,630 --> 00:16:29,500
!احذر

239
00:16:31,680 --> 00:16:33,780
كنت على وشك أن تُصبح
!مخروقًا بنصل رُمحه

240
00:16:33,780 --> 00:16:34,890
.لا أُبالي

241
00:16:34,900 --> 00:16:36,480
!ولكنّي أُبالي

242
00:16:36,670 --> 00:16:37,960
ما الّذي ترمي إليه بفعلتك هذه؟

243
00:16:38,500 --> 00:16:41,730
،أنت تبتغي الثّأر لابنك وحفيدك

244
00:16:42,360 --> 00:16:47,730
لكن نظام الشّوغون يحظر
.على الآباء الاقتصاص لأبنائهم

245
00:16:47,960 --> 00:16:51,960
أجل، لهذا السّبب هجرت
.إقليمي ودياري

246
00:16:52,920 --> 00:16:55,940
.ولكن ذلك حدث مُنذ ثلاثين عامًا مضت

247
00:16:56,520 --> 00:17:00,240
لا بُدّ أنّ غريمي قد صار جُثّةً
.هامدة في خندقٍ ما الآن

248
00:17:00,490 --> 00:17:04,980
أنت تمقت السّاموراي وترغب في
.قتل أكبر قدرٍ مُمكن منهم

249
00:17:05,400 --> 00:17:06,640
.أخبرتك بذلك لتوّي

250
00:17:07,760 --> 00:17:10,880
.لكن لا يوجد ساموراي بين أفراد المِيبورو

251
00:17:15,380 --> 00:17:19,890
،فمُعظمنا فلّاحون أو رونين
.بعضنا لا أعلم منشأه حتّى

252
00:17:20,310 --> 00:17:25,390
ولكن أنا وسيريزاوا كامو فقط مَن
.ننحدر مِن سُلالات ساموراي عريقةٍ

253
00:17:26,120 --> 00:17:28,050
،يُمكنني أن أحمل عنك ثِقل ضغينتك

254
00:17:29,370 --> 00:17:31,130
.لكنّي لا أستطيع قتلك

255
00:17:32,390 --> 00:17:35,410
،ما تُحاول فعله خاطئٌ

256
00:17:36,040 --> 00:17:38,560
.لكنّي أفهم مدى إحباطك

257
00:17:39,200 --> 00:17:44,530
فهل تقبل برأسي أنا ناغاكورا
شينباتشي وتكتفي بذلك؟

258
00:17:44,670 --> 00:17:46,870
!إذًا ستكون أنت أوّل مَن يموت

259
00:17:50,750 --> 00:17:52,780
ما الّذي تظنّ أنّك تفعله يا سانوسوكي؟

260
00:17:55,450 --> 00:17:56,400
.اخرس

261
00:17:59,630 --> 00:18:02,600
ما أنت إلّا رجلٌ
.عاثر الحظّ أيّها العجوز

262
00:18:02,750 --> 00:18:03,440
ماذا؟

263
00:18:03,760 --> 00:18:06,190
كم عقدًا مِن الزّمان أمضيت في التّدريب؟

264
00:18:06,600 --> 00:18:08,080
إنّك لا تملك ذرّةً مِن
.الموهبة لخوض القتال

265
00:18:08,500 --> 00:18:10,790
!أيّها الصّعلوك المغرور

266
00:18:15,360 --> 00:18:16,020
ماذا؟

267
00:18:17,890 --> 00:18:18,850
ألم أقل لك؟

268
00:18:19,350 --> 00:18:20,890
.أنا أرى كُلّ شيءٍ بوُضوح

269
00:18:21,970 --> 00:18:23,720
فالجميع يُخبرونني أنّي
.أمتلك بصيرةً نافذة

270
00:18:34,050 --> 00:18:35,990
.أنا لست رقيق القلب مثل شينباتشي

271
00:18:36,810 --> 00:18:39,010
.ولا يشغلني دافعك أو قصّتك

272
00:18:39,600 --> 00:18:41,430
،حين يتعلّق الأمر بالقتل
.فأنا لا أعرف الهَوادة

273
00:18:48,280 --> 00:18:49,490
.كنت أمزح فقط

274
00:18:50,450 --> 00:18:54,920
،لستُ سيئًا في استخدام السّيف
.لكن هذا الرّمح ينساب في يدي بسلاسةٍ

275
00:18:59,330 --> 00:19:01,870
كنت مُثيرًا للمشاكل
.مُنذ نعومة أظفاري

276
00:19:02,370 --> 00:19:07,040
،أُعربد وأُشاغب وأخوض النّزالات
.ببساطةٍ، لم أجد لي مكانًا أنسجم معه قطّ

277
00:19:07,430 --> 00:19:09,450
...لكنّي وجدت أخيرًا

278
00:19:10,190 --> 00:19:12,680
.ملاذًا يحتويني

279
00:19:17,950 --> 00:19:20,370
أيّ نوعٍ مِن الجماعات أنتم؟

280
00:19:21,270 --> 00:19:24,580
،لماذا تترك شاربك ينمو
وتجعل شعرك منسدلًا؟

281
00:19:24,970 --> 00:19:28,180
لماذا لا تُحاول الظّهور
بمظهر السّاموراي؟

282
00:19:31,050 --> 00:19:32,190
.أخبره

283
00:19:33,920 --> 00:19:36,150
،لا أستسيغ البوح بهذا

284
00:19:37,040 --> 00:19:40,870
لكنّني كنت أتحرّج مِن كوني
.ساموراي بين صُفوف المِيبورو

285
00:19:41,640 --> 00:19:46,100
،فحتّى لو لم يقصد النّاس بناء حواجز بينهم

286
00:19:46,100 --> 00:19:49,090
.فإنّ مَن يقف خارجها يظل يشعر بوُجودها

287
00:19:50,580 --> 00:19:54,740
لذا أردت على الأقلّ
.أن أبدو بمظهر رُونين

288
00:19:55,030 --> 00:19:56,210
...ولكن

289
00:19:57,080 --> 00:20:00,460
بدأت أشعر بأنّي أحمق
.مُنذ أن انضمّ هو إلينا

290
00:20:00,660 --> 00:20:01,440
هو"؟ مَن تقصد؟"

291
00:20:01,680 --> 00:20:04,120
ذلك الفتى الّذي كان يعمل
.في دُكّان الدّانغو

292
00:20:05,190 --> 00:20:07,000
فتى؟
يعمل في دُكّان الدّانغو؟

293
00:20:07,320 --> 00:20:10,680
،أجل، إنّه رقيقٌ جدًا

294
00:20:11,620 --> 00:20:13,560
.وليس ممّن خُلقوا لخوض المعارك

295
00:20:14,250 --> 00:20:17,480
،رُغم ذلك، فهو يتصنّع القُوّة
.ولا يكفّ عن النّحيب

296
00:20:17,850 --> 00:20:20,770
كما أنّه عنيدٌ جدًا ممّا يجعل
.التّعامل معه عبئًا ثقيلًا

297
00:20:21,280 --> 00:20:24,640
إنّه غرٌّ ومُندفع لدرجةٍ تجعلك
.لا تجرؤ على تركه وحده

298
00:20:25,120 --> 00:20:26,410
!أسرع الخُطى يا تارو

299
00:20:25,130 --> 00:20:28,000
،لم يكن يومًا في قلب الأحداث

300
00:20:26,420 --> 00:20:28,000
!إنّك أبطأ منّي

301
00:20:28,360 --> 00:20:29,240
.هيّا، مِن هذا الاتّجاه

302
00:20:28,360 --> 00:20:31,000
،لكنّه بطريقةٍ ما
.يجمع الجميع حوله

303
00:20:34,000 --> 00:20:37,320
أجل، ولدينا فتىً آخر
.أكثر شقاوةً

304
00:20:37,540 --> 00:20:38,710
.ساموراي صغيرٌ في السّن

305
00:20:39,160 --> 00:20:44,270
وفتىً متسوّلٌ آويناه ليُساعدنا
.في بعض الأعمال البسيطة

306
00:20:44,950 --> 00:20:48,770
،نحن منبوذون مِن الجميع
.لكنّنا في كنف المِيبورو وجدنا الانتماء

307
00:20:52,240 --> 00:20:56,320
،وعلى خلافكم
.نحن لا نُقيم وزنًا للأصل أو النّسب

308
00:20:59,370 --> 00:21:03,650
كان عليك أن تنضمّ إلينا
.بدلًا منهم أيّها العجوز

309
00:21:04,070 --> 00:21:05,520
.ليتكَ فعلت ذلك حقًا

310
00:21:09,320 --> 00:21:12,320
.أرى ذلك، لعلّكما على صوابٍ

311
00:21:12,820 --> 00:21:15,310
!اسمع
.خطرت لي فكرةٌ

312
00:21:15,560 --> 00:21:17,920
سأتوسّط لك إن قرّرت
.تغيير موقفك والانضمام إلينا

313
00:21:18,320 --> 00:21:22,820
صحيحٌ، فنحن لسنا سوى جماعةٍ مِن
.السّيافين الّذين عفا عليهم الزّمان

314
00:21:23,200 --> 00:21:26,670
تلك المهارات الّتي صقلتها طيلة
.حياتك لن تذهب سُدىً معنا

315
00:21:44,950 --> 00:21:49,950
ملاذٌ

316
00:21:44,950 --> 00:21:49,950
يحتوينا

317
00:23:20,080 --> 00:23:25,460
الحلقة القادمة

318
00:23:22,840 --> 00:23:24,050
.هيجيكاتا توشيزو يُحدّثكم

319
00:23:25,040 --> 00:23:28,600
ناغاكورا وسانوسوكي يخوضان نزالًا
.ضدّ خصمٍ صلد على جسر آخر

320
00:23:29,610 --> 00:23:31,280
،وأنا أيضًا
.لا أملك خيارًا سوى الانتصار

321
00:23:31,760 --> 00:23:34,110
السّيف الّذي صنعته ساكورا مِن أجلي
.يُثبت متانته في أرض المعركة

322
00:23:34,980 --> 00:23:39,140
،ومهما بلغت براعة أعدائي
،فسأُقاتل بطريقتي الّتي أرتضيها

323
00:23:39,510 --> 00:23:41,740
.وسأُواصل ضربات نصلي دُون توقّفٍ

324
00:23:42,810 --> 00:23:44,790
."الحلقة القادمة: "رجل التّربة

325
00:23:45,520 --> 00:23:47,550
.ترقّبوها، هذا كُلّ ما لديّ

326
00:23:47,110 --> 00:23:49,950
رجل

327
00:23:47,110 --> 00:23:49,950
التّربة