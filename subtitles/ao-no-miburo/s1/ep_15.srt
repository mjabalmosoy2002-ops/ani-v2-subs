1
00:00:00,440 --> 00:00:04,600
،يا للهول
.مضى وقتٌ طويل

2
00:00:04,740 --> 00:00:08,470
،ما بالك إذن؟ بما أنّك قصدتني
فلا ريب أنّك تبغي مالًا؟

3
00:00:10,230 --> 00:00:13,110
مَن ستُرديه قتيلًا هذه المرّة يا جيرو؟

4
00:00:13,710 --> 00:00:18,040
أم أنّك صرت سايتو
هاجيمي الثّاني الآن؟

5
00:00:20,180 --> 00:00:24,000
ما شُعورك وأنت تُدعى
بهذا الاسم؟

6
00:00:24,610 --> 00:00:27,600
لا أشعر بشيءٍ يُذكر، فقد تخليّت
،عن اسمي القديم مُنذ أمدٍ بعيد

7
00:00:27,940 --> 00:00:29,130
.فلم يعد يعني لي شيئًا

8
00:00:29,130 --> 00:00:30,600
حقًا؟

9
00:00:31,020 --> 00:00:33,680
.لا أستطيع تصديق ذلك ولو للحظةٍ

10
00:00:33,960 --> 00:00:38,010
فالاسم هو أوّل عطاءٍ
.يمنحه الوالدان لطفلهما

11
00:00:39,730 --> 00:00:42,110
.صرتِ كثيرة الثّرثرة بالنّسبة لأفعى

12
00:00:42,110 --> 00:00:44,390
.رُويدك، رُويدك

13
00:00:44,390 --> 00:00:47,640
إنّ صبرك لا يُقارن أبدًا
.بصبر مَن تسمّيت باسمه

14
00:00:48,650 --> 00:00:51,850
،رُغم أنّ فظاظتك لم تتغيّر

15
00:00:51,850 --> 00:00:54,080
.فلا ريب أنّك ورثتها عنه

16
00:00:57,840 --> 00:00:59,810
أَتريد الحديث عن العمل؟

17
00:01:00,000 --> 00:01:00,660
.محقّةٌ

18
00:01:04,830 --> 00:01:11,960
خمسة ريو

19
00:01:04,830 --> 00:01:11,960
عشرة
ريو

20
00:01:04,830 --> 00:01:11,960
عشرون ريو

21
00:01:04,830 --> 00:01:11,960
ثلاثون ريو

22
00:01:05,040 --> 00:01:07,220
.الأنف المَعقوف: عشرة ريو

23
00:01:07,220 --> 00:01:08,880
.ذُو العين الحمراء: خمسة ريو

24
00:01:08,880 --> 00:01:11,240
.الضّفدع: عشرون ريو

25
00:01:11,240 --> 00:01:13,870
.اللصّة: ثلاثون ريو

26
00:01:13,870 --> 00:01:16,070
.ذُو الندّبة: مئة ريو

27
00:01:13,880 --> 00:01:16,880
مئة ريو

28
00:01:17,510 --> 00:01:20,430
هل لي أن أفترض أنّ المُكافأة
تتناسب مع مهارتهم في القتال؟

29
00:01:20,610 --> 00:01:22,060
مَن يعلم؟

30
00:01:22,060 --> 00:01:25,700
،قد يعود الأمر لقُوّة الهدف
.أو لعُمق الضّغينة

31
00:01:25,700 --> 00:01:28,490
.فالمُوكِّل هو مَن يضع التّسعيرة

32
00:01:28,990 --> 00:01:33,220
لكن، مئة ريو؟
.هذا أمرٌ استثنائيّ حقًا

33
00:01:33,880 --> 00:01:36,720
،والآن، انتقِ ما شئت
.يا مَن ستخلف مَن سبقك

34
00:01:37,620 --> 00:01:39,490
مَن ستقتل؟

35
00:01:59,850 --> 00:02:04,150
ذئاب ميبو الزّرق

36
00:03:20,970 --> 00:03:23,970
نقبل بأيّ عملٍ كان

37
00:03:20,970 --> 00:03:23,970
المُهمّ أن تمنحنا المال

38
00:03:27,580 --> 00:03:29,560
لا يبدو أنّنا سنعثر على أيّ
فُرصة عملٍ، أليس كذلك؟

39
00:03:29,560 --> 00:03:33,150
تبًا، لماذا لا نسطو على
أحدهم فحسب؟

40
00:03:34,750 --> 00:03:36,810
.ماذا؟ إنّي أعرفك يا فتى

41
00:03:40,320 --> 00:03:41,560
.فونازو-سان

42
00:03:41,810 --> 00:03:43,900
،هذا أنا، نيو
.مضى وقتٌ طويل

43
00:03:44,360 --> 00:03:46,160
لا أزال مدينًا لك
.بما فعلته سابقًا

44
00:03:46,400 --> 00:03:48,960
.أنا وابنتي نعيش في يُسرٍ الآن

45
00:03:49,110 --> 00:03:50,620
.يُسعدني سماع ذلك

46
00:03:50,920 --> 00:03:52,080
مـ-من هذا الرّجل؟

47
00:03:52,260 --> 00:03:53,580
وهل تعرفه حقًا؟

48
00:03:53,590 --> 00:03:55,590
نقبل بأيّ عملٍ كان

49
00:03:53,590 --> 00:03:55,590
المُهمّ أن تمنحنا المال

50
00:03:53,840 --> 00:03:54,550
.أجل

51
00:03:54,550 --> 00:03:55,570
ماذا؟

52
00:03:56,100 --> 00:03:58,530
أَتبحث عن عملٍ أيّها الفتى نيو؟

53
00:03:58,980 --> 00:04:00,600
.لديّ ما يُناسبك تمامًا

54
00:04:00,600 --> 00:04:02,400
ماذا؟ حقًا؟

55
00:04:12,800 --> 00:04:16,230
،فونازو-سان
أَهذه عروسك الجديدة؟

56
00:04:16,580 --> 00:04:19,810
!حاشا لذلك
.ليست سوى معرفةٍ عابرة

57
00:04:20,520 --> 00:04:21,530
،عُذرًا

58
00:04:22,900 --> 00:04:23,710
.أنا نيو

59
00:04:24,380 --> 00:04:26,160
،يا لجمال شعرك

60
00:04:26,600 --> 00:04:28,150
.إنّه يُشبه خيوط السّومين ناصعة البياض

61
00:04:28,750 --> 00:04:30,030
.ممتنٌ لكِ

62
00:04:30,030 --> 00:04:33,190
،هذه ناغي-سان
.سيّدة دارٍ لأسرة ساموراي مرموقةٍ

63
00:04:35,160 --> 00:04:36,620
على ماذا تُصفّق؟

64
00:04:37,020 --> 00:04:38,510
.أراكِ حُبلى

65
00:04:38,870 --> 00:04:40,470
متى موعد وَضع الجنين؟

66
00:04:40,700 --> 00:04:43,430
،لا أعلم
.لكن الأمر لن يطول كثيرًا

67
00:04:43,430 --> 00:04:44,450
ألا يهمّكِ معرفة الموعد؟

68
00:04:44,660 --> 00:04:47,430
ترغب ناغي-سان في
.عُبور النّهر بالقارب

69
00:04:47,430 --> 00:04:50,470
وسأمنحكم مبلغًا بسيطًا إن عاونتموني
.في إيصالها

70
00:04:50,720 --> 00:04:52,320
.يُسعدنا أن نكون في الخدمة

71
00:04:52,540 --> 00:04:54,720
!لا تبخسنا حقّنا في الأجر

72
00:04:59,140 --> 00:05:00,790
.انتبهي لموطئ قدمكِ رجاءً

73
00:05:00,790 --> 00:05:01,730
.حسنًا

74
00:05:01,970 --> 00:05:04,770
إذن، ما سبب رغبتكِ
في عُبور النّهر؟

75
00:05:05,190 --> 00:05:06,070
.هذا سرّي الخاصّ

76
00:05:06,400 --> 00:05:08,500
معذرةً، لم أقصد
.التطفّل على شُؤونكِ

77
00:05:10,030 --> 00:05:11,540
أَهكذا نقوم بذلك؟

78
00:05:11,720 --> 00:05:13,570
لديك براعةٌ فطريّة في
.هذا أيّها الفتى تارو

79
00:05:14,210 --> 00:05:15,250
أجل، أغدق عليّ
.بمزيدٍ مِن الثّناء

80
00:05:15,820 --> 00:05:16,960
.تفضّلي بالمُرور مِن هنا

81
00:05:16,960 --> 00:05:17,650
.حسنًا

82
00:05:20,370 --> 00:05:22,390
،ناغي-سان
!النّهر مِن تلك النّاحية

83
00:05:22,390 --> 00:05:23,910
!مِن هنا، هيّا

84
00:05:24,380 --> 00:05:25,990
.يا للهول، أفزعتني

85
00:05:25,990 --> 00:05:27,970
!سبقتِني بقول ذلك

86
00:05:27,970 --> 00:05:29,600
!أرجوكِ، كُوني حذرةً أكثر

87
00:05:29,740 --> 00:05:31,900
،مهلًا، نيو
.تعال إليّ لحظةً

88
00:05:31,900 --> 00:05:32,510
هل مِن خطبٍ؟

89
00:05:32,510 --> 00:05:34,510
ناغي-سان، عليكِ أن
.تنتبهي لموطئ قدمكِ

90
00:05:33,920 --> 00:05:35,700
.هذه السيّدة تبعث على الرّيبة

91
00:05:34,510 --> 00:05:35,820
.أجل، بالطّبع

92
00:05:35,700 --> 00:05:37,140
أتظنّ ذلك حقًا؟

93
00:05:37,480 --> 00:05:40,520
أيّ امرأةٍ حُبلى تقصد النّهر
في مثل هذا الوقت؟

94
00:05:40,820 --> 00:05:43,210
ألا تخشى أنّها تُخطّط لإغراق نفسها؟

95
00:05:43,210 --> 00:05:45,540
.تُغرق نفسها؟ محالٌ

96
00:05:50,010 --> 00:05:52,120
،يا له مِن نسيمٍ عليل

97
00:05:52,120 --> 00:05:53,660
.إنّه شعورٌ رائع

98
00:05:53,660 --> 00:05:55,160
.أجل، هو كذلك

99
00:05:55,160 --> 00:05:58,030
.انظر، كيف تَتلألأ المياه

100
00:05:58,030 --> 00:05:59,500
.أشعر وكأنّها تجذبني إلى أعماقها

101
00:05:58,480 --> 00:06:00,120
!أرجوكِ، لا تفعلي

102
00:06:03,110 --> 00:06:04,760
هُناك قاربٌ آتٍ مِن
!الاتّجاه المُعاكس

103
00:06:04,930 --> 00:06:06,300
.لا تقلقوا، سنكون بخيرٍ

104
00:06:06,680 --> 00:06:08,370
،حافظوا على المسار
.سيكون الأمر صعبًا قليلًا

105
00:06:14,030 --> 00:06:15,900
.أرجوكِ، تمسّكي جيدًا

106
00:06:16,500 --> 00:06:17,540
أَتمسّك؟

107
00:06:20,930 --> 00:06:23,890
.أجل، تمسّكي بالقارب، هكذا

108
00:06:23,890 --> 00:06:25,980
أَتمسّك بالقارب؟

109
00:06:27,570 --> 00:06:29,360
.لعلّه مِن الأفضل أن أسألها فحسب

110
00:06:30,620 --> 00:06:32,210
...معذرةً، ناغي-سان

111
00:06:33,060 --> 00:06:37,110
،إن كان هناك ما يُؤرّقكِ
.فيُسعدني أن أستمع إليكِ

112
00:06:37,110 --> 00:06:38,280
ما يُؤرّقني؟

113
00:06:38,790 --> 00:06:40,220
...دعني أرى

114
00:06:40,220 --> 00:06:42,750
لديّ مِن الهُموم ما يجعل
.اختيار واحدٍ منها أمرًا عسيرًا

115
00:06:43,720 --> 00:06:48,710
،حسنًا... أنتِ تنتظرين مولودًا
.لذا أرجوكِ، لا تقومي بأيّ فعلٍ طائش

116
00:06:48,710 --> 00:06:52,880
،حينما كنت صغيرةً
.كان الجميع يَدعونني الجوفاء

117
00:06:53,270 --> 00:06:55,390
"سألتهم حينها: "ما معنى ذلك؟

118
00:06:55,760 --> 00:06:59,490
،فقالوا: "لأنّك دائمًا شاردة الذّهن
".لا بُدّ أنّ رأسكِ أجوف

119
00:07:00,260 --> 00:07:02,840
.ظننت أنّ هذا الوصف كان بارعًا

120
00:07:03,150 --> 00:07:05,880
أجوف؟ بمعنى فارغٌ؟

121
00:07:07,430 --> 00:07:08,050
!جسرٌ

122
00:07:09,640 --> 00:07:11,450
أليس النّهر لطيفًا؟

123
00:07:19,420 --> 00:07:20,670
ألا يزعجكِ الوصف؟

124
00:07:21,270 --> 00:07:23,200
.كلا، ولا حتّى قليلًا

125
00:07:23,200 --> 00:07:25,290
ماذا؟ حقًا؟

126
00:07:25,290 --> 00:07:28,020
،فقدت والديّ مُنذ صغري

127
00:07:28,020 --> 00:07:30,790
.وصادف أن التقيت برجلٍ طيّب

128
00:07:30,790 --> 00:07:35,280
لم تكن عائلتي تنتمي للسّاموراي، وأنا
.خرقاء للغاية لذا كنت دائمًا عبئًا على الآخرين

129
00:07:37,220 --> 00:07:38,530
.لكن هذا جعلني أُفكّر

130
00:07:39,280 --> 00:07:39,980
.انظر

131
00:07:41,120 --> 00:07:42,160
هلالٌ؟

132
00:07:43,550 --> 00:07:45,490
فتّانٌ، أليس كذلك؟

133
00:07:46,050 --> 00:07:50,640
أليس مِن الطّريف أنّ كُلّ شيءٍ
جميل لا بُدّ وأن ينقصه شيءٌ ما؟

134
00:07:52,850 --> 00:07:55,240
.لعلّ الأمر ذاته ينطبق علينا

135
00:07:56,370 --> 00:07:57,740
.مثل هذا النّهر تمامًا

136
00:07:58,220 --> 00:08:03,000
،حتّى وإن ضَعف، أو صار هائجًا
،أو سلك مسارًا غير مُتوقّعٍ

137
00:08:03,150 --> 00:08:04,690
أو حتّى إذا كدّر الوحل
،صفو مياهه بين الحين والآخر

138
00:08:05,060 --> 00:08:09,510
،فعلينا أن نُبدي الاحترام
،والتّبجيل، والتّواضع

139
00:08:12,120 --> 00:08:15,510
.وأن نعيش بوقارٍ حيثما جرفنا التيّار

140
00:08:19,660 --> 00:08:23,390
عُذرًا، ألا يتملّككِ الخوف
مِن مخاض الولادة؟

141
00:08:23,660 --> 00:08:25,090
.يبدو لي أنّ ألمها لا يُحتمل

142
00:08:25,090 --> 00:08:27,040
،بالطّبع أنا خائفةٌ

143
00:08:27,040 --> 00:08:29,030
.لكنّي لا أستبق الأحداث

144
00:08:29,030 --> 00:08:30,030
لا تستبقين الأحداث؟

145
00:08:30,480 --> 00:08:34,520
أجل، أنا الّتي في الغد
.هي مِن ستتولّى تدبير الأمر

146
00:08:37,580 --> 00:08:39,380
هل هناك ما يُضحك؟

147
00:08:39,380 --> 00:08:41,080
هل تفوّهت بشيءٍ غريب؟

148
00:08:41,630 --> 00:08:45,040
،إنّها امرأةٌ صلبة
.لعلّ هذا شكلٌ آخر مِن القُوّة

149
00:08:45,990 --> 00:08:47,370
!عجبًا

150
00:08:47,550 --> 00:08:49,090
!ناغي-سان

151
00:08:49,590 --> 00:08:51,180
!وجدتكِ أخيرًا

152
00:08:52,340 --> 00:08:53,360
.هذا زوجي

153
00:08:56,800 --> 00:09:00,840
معذرةً يا فونازو-سان، لا بُد أنّ زوجتي قد أرهقتكم
بمطالبها غير المنطقيّة مرّةً أًخرى، أليس كذلك؟

154
00:09:00,840 --> 00:09:01,800
.كلا، على الإطلاق

155
00:09:01,800 --> 00:09:04,750
مطالبٌ غير منطقيّةٍ؟
.ما كنت لأفعل ذلك أبدًا

156
00:09:04,750 --> 00:09:07,200
كان هذان الفتيان لطيفين
.بما يكفي للمُساعدة

157
00:09:07,200 --> 00:09:08,390
.فهمت الآن

158
00:09:08,390 --> 00:09:09,160
.أنا نيو

159
00:09:09,160 --> 00:09:10,520
.و-وأنا تارو

160
00:09:10,840 --> 00:09:12,520
.أُقدّر لكما ذلك حقًا

161
00:09:13,030 --> 00:09:17,530
أنا يوتارو، وأُدير دوجو لتدريب القتال
.على الجانب الآخر مِن جسر سانجو

162
00:09:17,950 --> 00:09:20,760
يُسعدني أن تزوراني
.إذا مررتما بالجوار

163
00:09:21,130 --> 00:09:22,160
.بكُلّ سُرورٍ

164
00:09:23,280 --> 00:09:24,790
هيّا بنا نعود للمنزل
.قبل أن يُدركنا الظّلام

165
00:09:24,790 --> 00:09:25,390
.حسنًا

166
00:09:27,120 --> 00:09:27,960
.معذرةً

167
00:09:29,380 --> 00:09:32,160
كيف لي أن أكون قوّيًا مثلكِ؟

168
00:09:35,820 --> 00:09:38,550
.أنت قويٌّ بما يكفي بالفعل

169
00:09:40,440 --> 00:09:42,940
يا إلهي، لا أزال
.بحاجةٍ لشراء التّوفو

170
00:09:43,110 --> 00:09:43,970
.وداعًا الآن

171
00:09:47,380 --> 00:09:49,810
،مهلًا
.انتبهي لموطئ قدمكِ

172
00:09:53,290 --> 00:09:55,340
.لا تبدو قويًا ولا حتّى قليلًا

173
00:09:56,530 --> 00:09:57,880
.حذاري

174
00:09:57,880 --> 00:09:59,460
.تارو-كون، لنُصبح قويّين

175
00:09:59,460 --> 00:10:02,120
!ماذا؟ كلا، توقّف
.مِن المُفترض أن نجمع المال لا غير

176
00:10:02,570 --> 00:10:05,610
،لا أفهم فحوى الأمر
.لكن هذا ما يدفعني للتّفكير

177
00:10:07,240 --> 00:10:09,400
،تارو-كون
.لنجنِ المال بالطّريقة القويّة

178
00:10:09,400 --> 00:10:10,960
وما عساها أن تكون
تلك الطّريقة القويّة؟

179
00:10:11,400 --> 00:10:13,120
.كي أتمكّن مِن الاقتراب أكثر فأكثر

180
00:10:13,840 --> 00:10:14,760
!فونازو-سان

181
00:10:15,140 --> 00:10:16,930
.سأُعاونك في إعادة قاربك

182
00:10:17,120 --> 00:10:19,440
وهل ستُساعدني في التّجوال
لبيع السّمك أيضًا؟

183
00:10:19,440 --> 00:10:20,800
.لن يكون ذلك دُون مقابلٍ

184
00:10:21,320 --> 00:10:22,280
.هكذا يكون الكلام

185
00:10:23,160 --> 00:10:24,680
.إنّه قويٌّ

186
00:10:28,950 --> 00:10:32,800
لا أكاد أُصدّق أنّنا طُفنا
.أرجاء المدينة لبيع السّمك

187
00:10:32,800 --> 00:10:34,800
لكنّنا أدخلنا السّرور
.على قلب فونازو-سان

188
00:10:34,800 --> 00:10:36,280
!يا هذان

189
00:10:36,810 --> 00:10:37,700
!نيو

190
00:10:38,600 --> 00:10:39,510
!أيّها الرّفاق

191
00:10:41,320 --> 00:10:42,560
.تأخّرتما

192
00:10:42,560 --> 00:10:45,040
.هاجيمي-كون، وصلت قبلنا

193
00:10:47,690 --> 00:10:50,190
،رائحتك غريبةٌ
.وآثار العراك تبدو عليك بوُضوحٍ

194
00:10:50,190 --> 00:10:51,790
.اصمت أيّها الأبله

195
00:10:52,170 --> 00:10:52,990
.لقد عُدت

196
00:10:55,960 --> 00:10:57,670
.إنُه مصابٌ بجروحٍ أسوأ منك بكثيرٍ

197
00:11:00,200 --> 00:11:03,300
.أنا عُدت

198
00:11:03,550 --> 00:11:04,400
.وأنت غارقٌ في الثّمالة

199
00:11:04,870 --> 00:11:06,680
هل جمعتم مبلغًا طائلًا؟

200
00:11:06,680 --> 00:11:09,180
!يا له مِن سؤالٍ سخيف

201
00:11:10,600 --> 00:11:12,680
لحُسن الحظّ أنّ معنا
!رجالًا يُعتمد عليهم

202
00:11:16,010 --> 00:11:17,690
.ها قد انتهينا

203
00:11:18,230 --> 00:11:20,230
.فرغنا مِن جمع الأموال

204
00:11:22,270 --> 00:11:23,630
.أرى أنّ الجميع هنا

205
00:11:23,940 --> 00:11:25,320
.فلنحسب ما جَنيناه

206
00:11:25,880 --> 00:11:28,160
كم نحتاج لحياكة تلك المعاطف؟

207
00:11:28,420 --> 00:11:29,040
!نيو

208
00:11:29,430 --> 00:11:31,080
نحتاج إلى مائتين وخمسين
.ريو يا سيّدي

209
00:11:31,290 --> 00:11:33,710
حسنًا، ضعوا ما جَنيتموه
!في هذا الوعاء

210
00:11:34,760 --> 00:11:35,710
!أجل

211
00:11:35,710 --> 00:11:36,390
.أخيرًا

212
00:11:36,390 --> 00:11:37,080
.اتركوا الأمر لي

213
00:11:37,280 --> 00:11:38,400
.ولي أيضًا

214
00:11:38,400 --> 00:11:39,340
!وأنا كذلك

215
00:11:39,520 --> 00:11:40,700
رائعٌ، بُوركت جُهودكم
!أيّها الرّجال

216
00:11:40,700 --> 00:11:41,470
!يا للهول

217
00:11:41,470 --> 00:11:42,960
!لا تتوقّفوا

218
00:11:42,960 --> 00:11:44,470
.انتهينا

219
00:11:44,470 --> 00:11:47,230
إذن، كم بلغت حَصيلتنا؟

220
00:11:55,290 --> 00:11:56,200
ثمانية مون؟

221
00:11:57,000 --> 00:11:58,870
!أَتهزأ بي؟

222
00:11:58,870 --> 00:12:01,120
إيّاكما أن تكونا قد استبقيتما
!شيئًا لنفسكما واستغفلتُمانا

223
00:12:01,120 --> 00:12:02,610
!الأمر ذاته ينطبق عليكما

224
00:12:02,830 --> 00:12:05,240
حسنًا، مَن الّذي وضع
عُملات المون هذه؟

225
00:12:05,400 --> 00:12:07,320
.أنا وتارو-كون

226
00:12:07,320 --> 00:12:09,230
.ساهمنا في بيع السّمك

227
00:12:09,400 --> 00:12:11,920
أنا آسفٌ، فما جمعناه
.ليس إلّا نزرًا يسيرًا

228
00:12:11,920 --> 00:12:13,970
.لا تعتذر يا نيو

229
00:12:13,970 --> 00:12:15,630
ماذا كنتم تفعلون أيّها الرّفاق؟

230
00:12:15,630 --> 00:12:17,740
!تبدّدت أموالنا كُلّها في المُقامرة

231
00:12:17,740 --> 00:12:20,380
،رهنّا سُيوفنا وعجزنا عن استردادها

232
00:12:20,380 --> 00:12:22,360
لم نعد نستحقّ لقب
.السّاموراي بعد الآن

233
00:12:22,360 --> 00:12:23,760
.هذا جزاء ما اقترفته أيديكما

234
00:12:24,120 --> 00:12:25,260
ماذا بشأنكما أنتما؟

235
00:12:25,260 --> 00:12:29,140
عملنا كحُرّاسٍ، كُنّا نتعقّب
.حسناء مرموقةً عن كثبٍ

236
00:12:29,140 --> 00:12:29,960
.مقرفٌ

237
00:12:29,960 --> 00:12:32,410
،اتّضح أنّها ابنة عائلةٍ كريمة

238
00:12:32,600 --> 00:12:35,800
وقد أصرّ والدها على
.تقديم هديّةٍ رمزيّة لنا

239
00:12:35,800 --> 00:12:37,640
.حقًا؟ هذا رائعٌ

240
00:12:37,640 --> 00:12:39,400
.هذه اللّوحة الفنيّة الفاضحة

241
00:12:39,400 --> 00:12:40,380
.عجبًا

242
00:12:40,380 --> 00:12:41,390
لماذا؟

243
00:12:41,680 --> 00:12:42,770
وأنت يا كوندو-سان؟

244
00:12:43,010 --> 00:12:43,490
،حسنًا

245
00:12:44,490 --> 00:12:47,500
يا للخزي، فقد أخفقت
.في الإمساك بقطّةٍ

246
00:12:47,500 --> 00:12:49,320
!لا رجاء منك أبدًا

247
00:12:49,450 --> 00:12:51,440
،أمّا أنا
.فقد كددت في الحُقول

248
00:12:51,440 --> 00:12:52,920
.يا للعجب، غين-سان

249
00:12:52,920 --> 00:12:55,410
.وكانت كلمات الشّكر مكافأتي

250
00:12:55,410 --> 00:12:56,590
!ائتِ بالمال في المرّة القادمة

251
00:12:56,800 --> 00:12:58,470
وماذا عن مجموعتك يا سيريزاوا-سان؟

252
00:12:58,470 --> 00:13:02,800
!قرعنا أبواب دُور الدّوجو
.وبطبيعة الحال، حسمنا كُلّ نزالٍ لصالحنا

253
00:13:02,800 --> 00:13:05,320
جني المال لا يُمكن أن
.يكون أبسط مِن ذلك

254
00:13:05,480 --> 00:13:08,970
،دفعوا لنا مُقابل إعادة لافتاتهم

255
00:13:09,470 --> 00:13:12,630
،وهذا جعلنا في مزاجٍ رائع

256
00:13:12,630 --> 00:13:15,030
رائعٌ لدرجة أنّنا أنفقنا
.كُلّ شيءٍ على الشّراب

257
00:13:16,700 --> 00:13:18,500
مـ-ماذا سنفعل؟

258
00:13:18,500 --> 00:13:21,020
لن نجمع قرشًا واحدًا
!بهذه الطّريقة أبدًا

259
00:13:25,430 --> 00:13:26,170
.هذه عشرة ريو

260
00:13:26,480 --> 00:13:28,430
!ماذا؟
!هل قُلت عشرة ريو؟

261
00:13:28,430 --> 00:13:29,750
.مذهلٌ

262
00:13:29,860 --> 00:13:32,270
أكاد أُجزم أنّك ربحتها في
!المُقامرة، أيّها المحظوظ

263
00:13:32,270 --> 00:13:33,860
.لا تخلط بيني وبينك

264
00:13:34,640 --> 00:13:36,440
كنت أعلم، فقد فاحت
.منك رائحة الدّماء

265
00:13:36,760 --> 00:13:37,630
.اصمت

266
00:13:45,280 --> 00:13:47,140
.هذا لا يزال غير كافٍ على الإطلاق

267
00:13:47,880 --> 00:13:50,940
.لم يجنِ مالًا سوى الصّغار

268
00:13:50,940 --> 00:13:52,030
...لن نتمكّن أبدًا

269
00:13:52,030 --> 00:13:53,780
.مِن حياكة تلك المعاطف

270
00:13:54,470 --> 00:13:55,320
.كلا

271
00:13:56,170 --> 00:13:59,520
اقترضنا مبلغ المائتين وخمسين ريو
.كاملًا مِن مُقاطعة آيزو

272
00:13:59,520 --> 00:14:02,020
!يامانامي-سان
!نييمي-سان

273
00:14:05,330 --> 00:14:06,610
...هذا يعني

274
00:14:09,670 --> 00:14:11,720
!أنّنا سنتمكّن مِن حياكة المعاطف

275
00:14:14,610 --> 00:14:15,700
.دائمًا ما تكونان سبّاقين بخُطوةٍ

276
00:14:16,910 --> 00:14:19,050
إنّه قرضٌ دُون فوائد
.أو موعدٍ للسّداد

277
00:14:19,480 --> 00:14:22,150
يبدو أنّ نُفوذ الشّوغون
.قد صبّ في مصلحتنا

278
00:14:23,830 --> 00:14:25,760
،فهمت الآن. إذن
.نحن مدينون لنيو

279
00:14:26,000 --> 00:14:29,950
ومع ذلك، أعجبني ذلك العجوز
.الّذي قابلناه في صالة المُقامرة

280
00:14:29,950 --> 00:14:31,480
.حتّى إنّه اشترى لنا شرابًا

281
00:14:31,480 --> 00:14:34,640
أجل، كان رجلًا
.دمث الخُلق بالفعل

282
00:14:34,860 --> 00:14:36,710
.آمل أن تتقاطع سُبلنا مُجدّدًا

283
00:14:43,770 --> 00:14:46,380
،على أيّ حالٍ
.تفضّل بالجُلوس أيّها الشّيخ

284
00:14:46,650 --> 00:14:48,890
.كلا، اللّيلة، سنحتفل بنُهوضنا

285
00:14:49,110 --> 00:14:52,160
وينبغي لي الانتظار
.حتّى يجتمع شملنا كُلّنا

286
00:14:52,320 --> 00:14:54,810
.أنا واثقٌ أنّ الآخرين سيتأخّرون

287
00:14:55,040 --> 00:14:56,510
.فلنبدأ دُونهم

288
00:14:58,110 --> 00:15:01,540
،امرحوا واستمتعوا
.سنقضي هذه اللّيلة في الشّراب

289
00:15:01,720 --> 00:15:03,200
حسنًا، نحن نحتسي
.الشّراب بالفعل

290
00:15:03,200 --> 00:15:06,440
ما رأيكم أن نَمزج خمرنا بالحديث؟

291
00:15:10,720 --> 00:15:14,180
،نحن، جماعة الريسّيدان الدمويّة
.لدينا هدفٌ مُحدّد: المِيبورو

292
00:15:15,300 --> 00:15:16,120
ماذا؟

293
00:15:16,800 --> 00:15:19,120
.أَنصتوا، لديّ فكرةٌ

294
00:15:19,120 --> 00:15:20,410
.إليكم المُخطّط

295
00:15:21,650 --> 00:15:22,360
مَن هناك؟

296
00:15:26,630 --> 00:15:29,110
.ناووزومي-نيسان، هذه أنا، ناغي

297
00:15:29,110 --> 00:15:30,580
.ناغي

298
00:15:30,580 --> 00:15:34,320
،تزوّجتِ أخي
.لكن هذا ليس عُذرًا للتنصّت

299
00:15:34,680 --> 00:15:37,780
،ابتعت بعض التّوفو الشّهي
ألا ترغب في التّوفو؟

300
00:15:39,190 --> 00:15:41,040
!لـ-ليس هذا الوقت المُناسب

301
00:15:41,250 --> 00:15:42,120
.يا إلهي

302
00:15:43,240 --> 00:15:45,360
.لا مكان للنّساء بالقُرب مِن دار الدّوجو

303
00:15:45,720 --> 00:15:47,030
.أجل، أجل

304
00:15:49,480 --> 00:15:50,930
ماذا أفعل؟

305
00:15:50,930 --> 00:15:52,400
.ناغي-سان

306
00:15:53,200 --> 00:15:55,640
لا يجوز لكِ مُغادرة الفراش
.خلسةً هكذا

307
00:15:55,920 --> 00:15:57,680
.هذا مضرٌّ بالجنين

308
00:15:58,330 --> 00:15:59,940
.يوتارو-سان

309
00:16:00,100 --> 00:16:02,750
—أخوك ورفاقه في الدّوجو الآن

310
00:16:02,750 --> 00:16:06,230
،لا تقلقي
.دَعي أمرهم لي

311
00:16:17,480 --> 00:16:18,620
كيف سار الأمر؟

312
00:16:18,620 --> 00:16:20,080
.لا تتحرّكي يا ناغي-سان

313
00:16:20,290 --> 00:16:22,040
،انتهى كُل شيءٍ
.صار كُل شيءٍ على خيرٍ الآن

314
00:16:22,310 --> 00:16:23,370
حقًا ما تقول؟

315
00:16:23,570 --> 00:16:25,890
،أجل، فلنخلد إلى النّوم
.فقد فات الأوان

316
00:16:30,290 --> 00:16:32,340
.ثمّة أمرٌ يُؤرّقني

317
00:16:32,510 --> 00:16:33,660
،أفزعتني

318
00:16:34,000 --> 00:16:35,090
ما الّذي يُؤرّقكِ؟

319
00:16:35,340 --> 00:16:39,360
مضى شهران مُنذ رحيل
.والدك المُفاجئ

320
00:16:39,490 --> 00:16:40,840
.أجل، صحيحٌ

321
00:16:40,840 --> 00:16:42,550
.هذا مريبٌ

322
00:16:42,550 --> 00:16:45,300
.فقد كان يتردّد على الدّوجو يوميًا

323
00:16:45,800 --> 00:16:47,110
.أنتِ تعرفين مزاج والدي

324
00:16:47,420 --> 00:16:51,070
رُبّما انطلق في رحلةٍ لصقل
.مهاراته دُون أن يُنبئ أحدًا

325
00:16:51,070 --> 00:16:52,600
.ليس هذا فحسب

326
00:16:52,830 --> 00:16:56,400
بل نظرات طُلّاب الدّوجو
.إليك أيضًا

327
00:16:56,400 --> 00:16:57,120
إليّ أنا؟

328
00:16:57,360 --> 00:17:00,850
...إنّهم، كيف أقولها
.يبدو كما لو أنّهم يسخرون منك

329
00:17:01,030 --> 00:17:03,310
،إنّهم يتصرّفون بنوعٍ مِن الاستخفاف
.على ما أظنّ

330
00:17:03,720 --> 00:17:05,490
هل بمقدوركِ تمييز
ذلك يا ناغي-سان؟

331
00:17:05,830 --> 00:17:09,260
،أجل
.ولا أقصد قلّةً فحسب

332
00:17:09,640 --> 00:17:15,810
بل بدأ الكثير مِن الغُرباء يتردّدون
.علينا، مثل أولئك الرّجال في الدّاخل

333
00:17:16,000 --> 00:17:16,760
.صحيحٌ

334
00:17:17,000 --> 00:17:22,150
بدأ كُلّ هذا مُنذ عاد ناووزومي-سان
.مِن جولته في أنحاء البلاد

335
00:17:23,030 --> 00:17:23,440
.محقّةٌ

336
00:17:24,560 --> 00:17:28,890
يبدو أنّ أخي يستمتع بوقته، رُبّما يجدر
.بي أن أطلب منه أن أنضمّ إليكم

337
00:17:29,070 --> 00:17:30,600
.لا شأن لي بك

338
00:17:31,830 --> 00:17:34,930
،اغرب عن وُجوهنا
.أنت تُعكّر صفو مزاجنا

339
00:17:35,620 --> 00:17:38,510
...أنا
.رُبّما سأُحاول في وقتٍ آخر

340
00:17:42,080 --> 00:17:45,240
،حسنًا، عزمت أمري
.سأتحدّث مع أخي بصراحةٍ

341
00:17:45,880 --> 00:17:49,510
لذا حاولي الاسترخاء والتّركيز
.على إنجاب طفلٍ مُعافى

342
00:17:52,210 --> 00:17:52,780
.حسنًا

343
00:18:00,010 --> 00:18:02,540
،أجل، أحسنتم
.اهتفوا بأعلى أصواتكم

344
00:18:08,320 --> 00:18:10,830
،نيشيمورا-سان
هل آذيت معصمك؟

345
00:18:12,270 --> 00:18:15,230
هل خُضت شجارًا؟
.يجب أن تكفّ عن ذلك

346
00:18:15,230 --> 00:18:19,280
،فأنت رجلٌ قويّ
...وإذا استللت سيفك في لحظة غضبٍ

347
00:18:21,800 --> 00:18:25,290
هـ-هل أسأت إليك؟
.أنا آسفٌ

348
00:18:31,530 --> 00:18:33,800
ممّا لا شكّ فيه أنّ
.أمامي طريقًا صعبًا

349
00:18:35,930 --> 00:18:39,610
سنجعل مِن مدينة كيوتو
.ساحةً لمعركتنا

350
00:18:41,360 --> 00:18:45,220
،بقيت معضلةٌ واحدة
كيف نَستميل يوتارو إلى صفّنا؟

351
00:18:50,790 --> 00:18:53,480
.أُمّي، أرجوكِ احميني

352
00:18:54,050 --> 00:18:55,400
!سـ-سيّدتي

353
00:18:59,570 --> 00:19:02,200
كنت مُتيقّنًا أنّني سأجدك هنا
.في ذكرى وفاتها

354
00:19:03,220 --> 00:19:05,600
ما الّذي يُثير ذُعرك هكذا؟

355
00:19:05,940 --> 00:19:09,480
في ليلة أوّل أمس، أثار رجلٌ
،المتاعب بالقُرب مِن قصر نيجو

356
00:19:09,820 --> 00:19:12,140
.ثُمّ انتحر بقضم لسانه

357
00:19:12,140 --> 00:19:14,510
يُريد الحاكم معرفة
.ما إذا كان مِن طلابنا

358
00:19:19,900 --> 00:19:22,140
،سـ-سيّدتي
!لا ينبغي لكِ الجري

359
00:19:29,420 --> 00:19:31,610
.لدينا هدفٌ مُحدّد: المِيبورو

360
00:19:32,120 --> 00:19:33,520
ما هُم المِيبورو؟

361
00:19:35,370 --> 00:19:38,190
،ناغي-سان
.اعتني بهذا المكان

362
00:19:41,180 --> 00:19:43,340
أعلم أنّ ثمّة شيئًا ما
.على وشك الحُدوث

363
00:19:44,070 --> 00:19:45,700
.شيئًا مُريعًا

364
00:19:48,700 --> 00:19:51,120
،مـ-معذرةً
.اسمحوا لي برُؤية ذلك

365
00:19:51,730 --> 00:19:54,000
أشكرك على ما قدّمته
.بالأمس يا يوتارو-سان

366
00:19:55,360 --> 00:19:56,900
.سعيدٌ جدًا برُؤيتك

367
00:19:57,090 --> 00:19:59,170
.شُكرًا لمجيئك يا نيو-كون

368
00:19:59,170 --> 00:20:01,140
هل ناغي-سان في الدّاخل؟

369
00:20:01,480 --> 00:20:05,350
،الأرجح أنّها تزور المقبرة اليوم
.لكنّني أظنّ أنّها ستعود للمنزل قريبًا

370
00:20:06,000 --> 00:20:06,960
.نيو-كون

371
00:20:07,850 --> 00:20:10,110
.كان عونًا لزوجتي بالأمس

372
00:20:10,320 --> 00:20:12,600
حقًا؟
.يسرّني سماع ذلك

373
00:20:12,890 --> 00:20:14,800
.معذرةً على هذه الزّيارة المُفاجئة

374
00:20:15,130 --> 00:20:18,420
اقترضنا مالًا مِن آيزو
،في معبد كونكاي-كومييوجي

375
00:20:18,420 --> 00:20:20,370
ونحن الآن في طريق عودتنا
.بعد أن أدّينا واجب الشّكر لهم

376
00:20:20,450 --> 00:20:23,370
إذن أنتم مِن رجال آيزو؟

377
00:20:23,510 --> 00:20:25,560
.كلا، لسنا منهم

378
00:20:25,560 --> 00:20:27,240
.نحن مِن المِيبورو

379
00:20:28,360 --> 00:20:29,180
المِيبورو؟

380
00:20:30,190 --> 00:20:32,960
،بغضّ النّظر عن كُلّ شيءٍ
.فمن الرّائع دائمًا أن تكون في دار الدّوجو

381
00:20:33,400 --> 00:20:34,420
هل تُحبّ دُور الدّوجو؟

382
00:20:34,690 --> 00:20:35,210
.أجل

383
00:20:36,220 --> 00:20:42,510
كان يُجدر بي التّعريف بنفسي، أنا كيوهاتشي
.يوتارو، كبيرُ مدرسة كيوهاتشي هنا

384
00:20:42,680 --> 00:20:44,780
أَتدير دار دوجو في مثل سنّك هذا؟

385
00:20:44,780 --> 00:20:45,850
.عمري تسعٌ وعشرون سنةً

386
00:20:45,850 --> 00:20:46,630
،وأنا كذلك

387
00:20:47,160 --> 00:20:49,350
.ولديّ دوجو خاصّ بي في إيدو

388
00:20:49,350 --> 00:20:50,820
حقًا؟ عندك واحدٌ؟

389
00:20:50,820 --> 00:20:52,470
هل تتفضّل بمُنازلتي؟

390
00:20:52,680 --> 00:20:54,910
،فكرةٌ رائعة
.يُشرّفني التعلّم منك

391
00:20:55,520 --> 00:20:58,640
ناووزومي، أعلم أنّ يوتارو
،أخوك الأصغر

392
00:20:58,640 --> 00:21:01,740
لكن لا داعي لتنصيبه
.زعيمًا لجماعة الريسّيدان

393
00:21:02,310 --> 00:21:06,650
،إنّه يعجز عن مصارحة نفسه أو زوجته
.وحتّى طُلّابه لا يُقيمون له وزنًا

394
00:21:09,620 --> 00:21:11,040
.كلا، نحن بحاجةٍ إليه

395
00:21:11,040 --> 00:21:13,690
.أنت لا تعرف يوتارو على حقيقته

396
00:21:14,130 --> 00:21:18,050
،فهو الرّجل الوحيد الجدير بقيادة الريسّيدان
،إنّه مثالٌ يُحتذى به في البراعة بالسّيف

397
00:21:19,080 --> 00:21:22,580
،بل هو إلهُ حربٍ حقيقيّ
.لن يقوى بشرٌ على هزيمته أبدًا

398
00:21:23,620 --> 00:21:26,390
وماذا لو هُزم؟

399
00:21:28,780 --> 00:21:30,780
،إذا تمكّن أحدٌ مِن ذلك

400
00:21:31,670 --> 00:21:34,070
.فسيكون خصمًا يعجز أيّ منّا عن صدّه

401
00:21:45,030 --> 00:21:50,040
كجريان

402
00:21:45,030 --> 00:21:50,040
النّهر

403
00:23:20,160 --> 00:23:25,550
الحلقة القادمة

404
00:23:24,530 --> 00:23:26,000
،كوندو إيسامي يُحدّثكم

405
00:23:26,630 --> 00:23:30,970
لطالما أحببت دُور الدّوجو، ولكن شغفي
.بمُنازلة الخُصوم المَهرة يفوق ذلك بكثيرٍ

406
00:23:31,840 --> 00:23:37,720
وإيفاءً لحقّ مدرستي شيكان في إيدو، ومِن أجل
.جماعة المِيبورو، يتحتّم عليّ إتقان هذا النّهج

407
00:23:38,590 --> 00:23:42,330
سأصقل مَهاراتي، وأُعزّز
.قُوّة بدني، وأُطهّر رُوحي

408
00:23:43,320 --> 00:23:44,680
."الحلقة القادمة: "إلى المعركة

409
00:23:45,190 --> 00:23:46,460
.إيّاكم أن تُفوّتوها

410
00:23:47,190 --> 00:23:50,030
إلى المعركة