1
00:00:06,320 --> 00:00:08,480
،لن أفلتك أبدًا
.لن أفعل

2
00:00:09,880 --> 00:00:11,700
.لن أفلتك أبدًا

3
00:00:11,700 --> 00:00:13,120
!لن أفلتك أبدًا

4
00:00:14,390 --> 00:00:16,110
أما زِلت تُعاند وتقول ذلك؟

5
00:00:26,370 --> 00:00:27,410
.هُناك

6
00:00:27,970 --> 00:00:29,150
...عند ذاك المُنعطف

7
00:00:33,940 --> 00:00:36,020
.ها هو ذا، قصر نيجو

8
00:00:50,820 --> 00:00:55,370
اسلك هذا الدّرب، ثُم خُذ أوّل منعطفٍ
.نحو اليمين لتصل إلى زقاق أويكي-دوري

9
00:00:55,370 --> 00:00:59,120
،واصل السّير بمُحاذاة القناة النهريّة
.وسترى قصر نيجو على يمينك

10
00:00:59,420 --> 00:01:00,110
.حسنًا

11
00:01:00,570 --> 00:01:02,160
وماذا عنك يا نيو؟

12
00:01:03,050 --> 00:01:05,790
سأُعيق ناووزومي-سان لأَكسب
.لك بعض الوقت

13
00:01:06,120 --> 00:01:09,330
،كلا، لن أقبل بهذا
.فهو رجلٌ في غاية الخُطورة

14
00:01:09,820 --> 00:01:10,810
.سأكون بخير

15
00:01:11,070 --> 00:01:13,600
،فأنا، بغضّ النّظر عن أيّ شيءٍ
.فردٌ مِن المِيبورو

16
00:01:16,100 --> 00:01:18,770
!كلا، كلا
!أنا خائفٌ من الذّهاب وحدي

17
00:01:18,770 --> 00:01:23,650
،أرجوك كن منطقيًا! إذا نال منك
!فسيضيع كُلّ ما فعلناه سدىً

18
00:01:24,790 --> 00:01:29,190
،يجب عليّ طلب التّعزيزات والتحرّك لنجدته
.حتّى لو استغرق الأمر بعض الوقت

19
00:01:30,160 --> 00:01:32,110
أنا أُدرك ذلك تمامًا
.كأيّ شخصٍ آخر

20
00:01:32,970 --> 00:01:34,140
...أُدركه، ومع ذلك

21
00:01:38,320 --> 00:01:39,570
.هذا لن يُجدي نفعًا

22
00:01:40,400 --> 00:01:41,760
.لن ينفع أبدًا

23
00:01:41,760 --> 00:01:42,730
.سامحني يا نيو

24
00:01:56,220 --> 00:02:01,930
ذئاب ميبو الزّرق

25
00:03:16,960 --> 00:03:18,310
!كفى

26
00:03:19,690 --> 00:03:21,440
!أَفلتني أيّها الصّعلوك

27
00:03:21,440 --> 00:03:22,470
!محالٌ

28
00:03:23,550 --> 00:03:24,420
!ناووزومي

29
00:03:29,810 --> 00:03:31,680
.كُفّ عمّا تفعله حالًا

30
00:03:33,000 --> 00:03:34,490
!كيكوتشيو-سان

31
00:03:35,920 --> 00:03:37,480
ماذا؟

32
00:03:37,800 --> 00:03:39,090
.معذرةً يا نيو

33
00:03:39,640 --> 00:03:42,000
لست ممّن يُؤثرون النّجاة
.بأنفسهم وحدهم

34
00:03:42,960 --> 00:03:47,240
،يبدو أنّني، بهذا المَنطق
.لا أَصلح لمنصب الحاكم

35
00:03:49,130 --> 00:03:50,880
...أنت الشّوغون

36
00:03:52,590 --> 00:03:54,080
.بالفعل

37
00:03:55,590 --> 00:04:00,250
هل عُدت لتلقى حتفك؟
.حسنًا، أَرحتني مِن عناء البحث عنك

38
00:04:04,050 --> 00:04:07,080
،ربّما لا يبدو عليّ ذلك
.لكنّني أنا سي تايشوغون

39
00:04:08,080 --> 00:04:12,150
.تمرّست قليلًا في فُنون السّيف

40
00:04:16,430 --> 00:04:20,690
!إنّك ترتعد
!أنت تجسيدٌ خالص للجُبن

41
00:04:23,440 --> 00:04:26,820
.اهـ-اهرب يا كيكوتشيو-سان

42
00:04:27,050 --> 00:04:29,870
.أنا... لا أستطيع

43
00:04:30,510 --> 00:04:33,520
.أَطـ-أطلق عنان بَطشك

44
00:04:33,520 --> 00:04:34,210
.كلا

45
00:04:35,760 --> 00:04:37,660
.بذلت ما فيه الكِفاية يا صاحب السّمو

46
00:04:40,090 --> 00:04:41,080
...أنت

47
00:04:46,650 --> 00:04:48,030
!هيجيكاتا-سان

48
00:04:54,070 --> 00:04:57,240
والآن، تبدو جديرًا بأن
.تُسلّيني بعض الشّيء

49
00:04:58,940 --> 00:04:59,810
.أَفلتني

50
00:04:59,810 --> 00:05:03,450
!كلا

51
00:05:00,610 --> 00:05:02,400
!أرجوك، أَفلتني

52
00:05:05,760 --> 00:05:07,660
!كُفّ عن العَويل

53
00:05:08,640 --> 00:05:09,950
.لا بُدّ أنّك مِن المِيبورو

54
00:05:16,450 --> 00:05:20,920
تهجم بلا سابق إنذارٍ؟
.إنّك جامحٌ تمامًا كما تقول الشّائعات

55
00:05:23,380 --> 00:05:24,710
.رُويدك

56
00:05:27,890 --> 00:05:29,200
مِن أين أنت؟

57
00:05:29,200 --> 00:05:30,640
وكم تبلغ مِن العُمر؟

58
00:05:30,640 --> 00:05:31,610
ما الخطب؟

59
00:05:32,200 --> 00:05:34,430
أأنت غاضبٌ؟

60
00:05:34,830 --> 00:05:36,480
أيّ أُسلوبٍ هذا الّذي تُقاتل به؟

61
00:05:52,290 --> 00:05:54,960
.يا لها مِن قُوّةٍ جبّارة

62
00:05:55,200 --> 00:05:58,200
.هـ-هذا هو هيجيكاتا-سان بعينه

63
00:05:58,480 --> 00:06:00,840
أما مِن نهايةٍ لثرثرتك هذه؟

64
00:06:01,200 --> 00:06:03,460
.ليس لديّ ما أقوله لك

65
00:06:14,640 --> 00:06:16,990
،معذرةً
.فهذه طبيعةٌ نَكِدة فيَّ

66
00:06:17,990 --> 00:06:22,820
،فمُنذ أمدٍ بعيد لم أظفر بخصمٍ يستحقّ النّزال
.لذا تماديت في الكلام

67
00:06:23,720 --> 00:06:25,320
،نيو
هل ما زِلت قادرًا على الحركة؟

68
00:06:26,530 --> 00:06:29,100
.رافق صاحب السّمو إلى قصر نيجو

69
00:06:29,600 --> 00:06:30,410
.حسنًا، سيّدي

70
00:06:31,320 --> 00:06:32,540
.كم هذا مؤلمٌ

71
00:06:34,000 --> 00:06:34,780
.دعني أُعينك

72
00:06:35,750 --> 00:06:37,450
.المعذرة

73
00:06:38,480 --> 00:06:39,280
أَتقوى على السّير؟

74
00:06:40,000 --> 00:06:41,200
.أنا بخير

75
00:06:47,250 --> 00:06:48,680
.لنسلك هذا الدّرب الجانبيّ

76
00:06:49,000 --> 00:06:49,680
.بالطّبع

77
00:06:50,440 --> 00:06:52,400
هل سيكون ذلك الرّجل بخير؟

78
00:06:52,940 --> 00:06:54,510
ألا يَجدر بنا طلب النّجدة؟

79
00:06:55,070 --> 00:06:56,400
.لا تقلق بشأنه

80
00:06:57,050 --> 00:07:00,930
سنلقى جحيمًا لا يُطاق فيما بعد
.إن طلبنا المَعونة بدلًا من الهرب

81
00:07:02,230 --> 00:07:05,330
كما أنّني لا أتخيّل هزيمة
.هيجيكاتا-سان أبدًا

82
00:07:12,890 --> 00:07:14,160
!ما زال في جعبتي المزيد

83
00:07:19,970 --> 00:07:21,680
.ضربةٌ بارعة

84
00:07:22,070 --> 00:07:25,460
أرى أنّك تجمع بين
.البراعة والقُوّة بإتقانٍ

85
00:07:26,200 --> 00:07:28,000
.ضرباتك مكشوفةٌ أكثر مِن اللّازم

86
00:07:28,600 --> 00:07:32,270
رُغم أنّني لا ألومك، فهذا السّيف الغريب
.وهذا الزّقاق الضيّق يحدّان مِن حركتك

87
00:07:32,270 --> 00:07:37,010
!أدركت الأمر
.كنت متيقنًا أنّك لست برجلٍ عاديّ

88
00:07:37,010 --> 00:07:37,760
ماذا؟

89
00:07:39,080 --> 00:07:42,570
على أيّ حالٍ، أَمتأكّدٌ أنّك
ستدعهم يمضون بهذه البساطة؟

90
00:07:42,990 --> 00:07:44,600
.ترهاتٌ

91
00:07:45,040 --> 00:07:49,080
،يجب علينا أن نتحادث مليًا
.أنا جازم بذلك

92
00:07:49,080 --> 00:07:50,010
ماذا؟

93
00:07:50,910 --> 00:07:56,740
،زعمت لتوّك أنّه لا حديثَ بيننا
.لا تكن قاسيًا هكذا، حدّثني عن نفسك

94
00:07:58,640 --> 00:08:02,040
ما رأيك في حكايةٍ قصيرة عنّي
لتلطيف الأجواء؟

95
00:08:04,330 --> 00:08:05,080
.أَغلق فمك

96
00:08:09,360 --> 00:08:12,460
.لا تهمّني قصّة حياتك

97
00:08:13,640 --> 00:08:15,640
.هذا كلامٌ قاسٍ

98
00:08:15,640 --> 00:08:17,070
.يبدو أنّك تستمتع بهذا النّزال

99
00:08:17,070 --> 00:08:25,650
أنا كذلك بالفعل، بلغني أنّ جماعة المِيبورو ما هي إلّا زمرةٌ
.مِن الرّونين قدموا مِن إيدو واستقرّوا في قرية ميبو

100
00:08:25,650 --> 00:08:27,020
.لم يُخطئ مَن نقل إليك الخبر

101
00:08:27,200 --> 00:08:29,020
.إذًا لا بُدّ أنّك تعي ما أرمي إليه

102
00:08:29,370 --> 00:08:30,630
ماذا تعني؟

103
00:08:34,550 --> 00:08:38,190
ألم تأتِ إلى هنا لتنحت
لنفسك مجدًا؟

104
00:08:38,190 --> 00:08:42,280
لتجعل السّيف مصدر رزقك؟
لتُثبت قيمتك؟

105
00:08:43,850 --> 00:08:46,550
،حسنًا
.رُبّما كان ذلك مسعى بعضنا

106
00:08:47,040 --> 00:08:49,640
.أمّا أنا فكلا

107
00:08:49,640 --> 00:08:50,490
ماذا؟

108
00:08:51,140 --> 00:08:54,300
إذًا لماذا جئت؟

109
00:08:57,240 --> 00:09:02,310
:ألم تسمع بالمثل القائل
"إنّنا جميعًا نُوفي دَين الوالدين ببُلوغنا سنّ الثّالثة؟"

110
00:09:02,450 --> 00:09:03,310
.لم أسمع بهذا المثل قطّ

111
00:09:03,770 --> 00:09:08,970
،معناه أنّ الرُضّع محبوبون جدًا
.لدرجةٍ تجعلك تغضّ الطّرف عمّا سيأتي بعدئذٍ

112
00:09:09,550 --> 00:09:12,810
،ولكن، كما يتّضح
.فأنا حالةٌ استثنائيّة

113
00:09:14,400 --> 00:09:16,980
،فقد كنت آخر العُنقود بين عشرة إخوةٍ
.لذا غمرني الجميع بفيضٍ مِن المودّة

114
00:09:18,980 --> 00:09:22,080
.ولم يقتصر الأمر على والديّ فحسب

115
00:09:33,840 --> 00:09:41,070
،بل أحبّني إخوتي وأخواتي، وأعمامي وعمّاتي
.بل وأهل القرية قاطبةً

116
00:09:42,840 --> 00:09:45,350
كانوا... يُحبّونك؟

117
00:09:45,620 --> 00:09:48,770
،كما ترى
.فقد طوّقوني بدينٍ جسيم

118
00:09:49,340 --> 00:09:50,890
.وأنا لا أَبغي سوى ردّ جميلهم

119
00:09:53,010 --> 00:09:56,810
فحينما بلغني أنّ ثُلّةً مِن أمثالك
،يعيثون فسادًا في كيوتو

120
00:09:57,320 --> 00:10:01,670
،أيقنت أنّ الأهالي في كربٍ عظيم
.ولعلّهم يفيضون أسىً ودموعًا

121
00:10:02,710 --> 00:10:07,330
أيًا كانوا، فكُلّ ما أَبغيه هو تقديم
.العون لهم، هذا كُلّ ما في الأمر

122
00:10:10,280 --> 00:10:16,140
،وبالطّبع، مهما كرّرت هذا على مسامعهم
.فلا أحد مِن المِيبورو يُصدّق حرفًا ممّا أقول

123
00:10:16,950 --> 00:10:18,200
أَتعلم لماذا؟

124
00:10:19,790 --> 00:10:22,730
،لأنّ لي ملامح شرّيرةً
.لا تقلّ سُوءًا عن ملامحك

125
00:10:24,380 --> 00:10:25,510
.فهمت

126
00:10:27,570 --> 00:10:29,600
.فهمت مقصدك تمامًا

127
00:10:30,040 --> 00:10:34,080
فنُصرة الضّعفاء هي أحد جوانب
.حياة السّاموراي

128
00:10:34,310 --> 00:10:36,940
،هكذا إذًا
هذا هو مفهومك عن البوشيدو؟

129
00:10:37,460 --> 00:10:38,540
البوشيدو؟

130
00:10:39,760 --> 00:10:41,780
،أخبرني يا أخي

131
00:10:42,080 --> 00:10:44,430
.لا بُدّ أنّك تملك إجابةً لي

132
00:10:45,120 --> 00:10:49,210
ماذا يعني لك السّيف؟
.هيّا، أفصح عمّا لديك

133
00:10:49,590 --> 00:10:51,560
السّيف؟
أَتقصد نهج السّاموراي؟

134
00:10:52,160 --> 00:10:56,000
أجل! ذاك المَثل الأعلى
.الّذي نسعى جميعًا لبلوغه

135
00:11:04,560 --> 00:11:05,960
.إنّه وهمٌ لا أكثر

136
00:11:12,840 --> 00:11:15,000
أما زال صاحب السّمو مفقودًا؟

137
00:11:15,200 --> 00:11:16,880
!اعثروا عليه بأيّ وسيلةٍ كانت

138
00:11:16,880 --> 00:11:17,600
!أجل، سيّدي

139
00:11:18,320 --> 00:11:21,780
.وصلنا، ها هو قصر نيجو

140
00:11:21,780 --> 00:11:23,830
.نجونا بأعجوبةٍ

141
00:11:28,400 --> 00:11:31,240
.يُقال إنّ نيو والشّوغون لم يصلا بعد

142
00:11:31,480 --> 00:11:32,270
ما العمل الآن؟

143
00:11:32,580 --> 00:11:34,350
.هذا سؤالٌ يصعب جوابه

144
00:11:35,460 --> 00:11:37,310
!ومَن يعلم أيّ مصيرٍ آل إليه هيجيكاتا

145
00:11:37,310 --> 00:11:40,160
!هلكوا جميعًا
!انتهى كُلّ شيءٍ

146
00:11:40,160 --> 00:11:42,650
.كُفّ عن النّحيب يا تارو

147
00:11:42,650 --> 00:11:43,930
!مهلًا

148
00:11:45,830 --> 00:11:48,220
!نحن هنا يا رفاق

149
00:11:48,220 --> 00:11:50,190
،هذا أنا
.ها قد عُدت أخيرًا

150
00:11:50,650 --> 00:11:52,670
.إنّه نيو، والشّوغون أيضًا

151
00:11:52,670 --> 00:11:53,970
.أنتما بخير إذًا

152
00:11:53,970 --> 00:11:55,080
ما زِلتم تَنعمون بالحياة؟

153
00:11:55,080 --> 00:11:56,190
.تأخّرتما كثيرًا

154
00:11:57,860 --> 00:12:01,510
،أنا... في الحقيقة
.لم يُساورني أدنى قلقٍ، بتاتًا

155
00:12:01,510 --> 00:12:02,520
حقًا؟

156
00:12:02,520 --> 00:12:06,000
،مع ذلك، أنا سعيدٌ
...وصلتما إلى هنا بخيرٍ

157
00:12:07,210 --> 00:12:11,270
،أجل
.أنا ممتنٌ لأنّنا نجونا بسلامٍ

158
00:12:11,270 --> 00:12:13,710
بالفعل، لم نُواجه أيّ
.متاعب تستحقّ الذّكر

159
00:12:13,940 --> 00:12:16,750
وهل تُسمّي هذا نجاة؟
!أُشبعتما ضربًا حتّى الموت

160
00:12:17,430 --> 00:12:18,960
.نال منكما أحدهم

161
00:12:19,480 --> 00:12:20,430
هل هو ذاك الرّجل؟

162
00:12:20,680 --> 00:12:23,000
—أجل، عثر ناووزومي-سان علينا و

163
00:12:23,460 --> 00:12:26,340
!لا تقل سان لعدوّنا

164
00:12:27,800 --> 00:12:29,560
أيّ بلاهةٍ هذه الّتي تتملّكك؟

165
00:12:30,240 --> 00:12:31,280
!لورد إيموتشي

166
00:12:31,280 --> 00:12:32,670
.عُدت سالمًا

167
00:12:32,670 --> 00:12:34,310
أيّها اللّورد، هل أنت مصابٌ؟

168
00:12:34,650 --> 00:12:37,320
،مُجرّد خُدوشٍ بسيطة
.لا تُقيموا الدّنيا وتُقعدوها

169
00:12:38,750 --> 00:12:40,480
!لكن الدّماء تُغطّيك

170
00:12:40,480 --> 00:12:41,900
!تبًا لأولئك الأوغاد

171
00:12:41,900 --> 00:12:43,820
!سنجعلهم يدفعون الثّمن

172
00:12:44,120 --> 00:12:44,820
.أيّها الشّوغون

173
00:12:44,820 --> 00:12:46,170
—ماذا؟ كيف تجرؤ

174
00:12:46,170 --> 00:12:46,820
.يا سيّدة

175
00:12:47,110 --> 00:12:48,960
هل بذل نيو جُهده؟

176
00:12:49,780 --> 00:12:53,830
،أجل، كان نعم العون
.أبلى بلاءً يُحتذى به

177
00:12:56,340 --> 00:13:00,080
،أبليت بلاءً حسنًا يا نيو
.أحسنت صُنعًا. يا لك مِن رجلٍ

178
00:13:00,080 --> 00:13:02,340
.هذا مؤلمٌ يا جدّتي

179
00:13:02,540 --> 00:13:05,000
كنت واثقًا أنّك ستكون عند حُسن
.الظّن في اللّحظة الحاسمة

180
00:13:06,130 --> 00:13:07,760
.هذا أقلّ ما يُمكن فعله

181
00:13:07,970 --> 00:13:13,420
رُغم ذلك، كان الموت سيَطال رقابنا
.جميعًا لو أنّه فرّط في حياة الشّوغون

182
00:13:14,860 --> 00:13:17,890
!نيو، أنت بطلٌ مغوار

183
00:13:18,920 --> 00:13:20,460
.إنّكم تُبالغون جميعًا

184
00:13:20,460 --> 00:13:22,070
.كلا، أنا أعني ما أقول

185
00:13:22,380 --> 00:13:24,620
بالمُناسبة، هل لمحت هيجيكاتا؟

186
00:13:24,840 --> 00:13:27,070
.مضى ليقتفي أثرك

187
00:13:27,360 --> 00:13:31,920
لا تقلق، هيجيكاتا-سان يخوض
.نزالًا ضاريًا ضد ناووزومي-سان

188
00:13:31,920 --> 00:13:32,690
أين؟

189
00:13:32,690 --> 00:13:33,680
...لا بُدّ أنّهما الآن في

190
00:13:39,670 --> 00:13:42,890
أفصح عن المكان قبل
.أن تفقد وعيك

191
00:13:42,890 --> 00:13:46,340
،في زقاق أويكي-دوري
.انطلقوا يا رجال المِيبورو

192
00:13:46,490 --> 00:13:47,320
.حسنًا

193
00:13:47,320 --> 00:13:49,080
أتساءل إن كان نزالهما
.مُستمرًا حتّى الآن

194
00:13:49,350 --> 00:13:50,740
أظنّ أنّه مِن الأفضل
.أن نذهب للاستطلاع

195
00:13:52,170 --> 00:13:54,650
،سآخذ نيو إلى الدّاخل
.افتحوا البوّابات

196
00:13:55,730 --> 00:13:59,220
،قُتل اثنان مِن حرسي في الزُقاق
.أرسلوا مَن ينتشلهما

197
00:13:59,220 --> 00:13:59,920
.أمرك يا سيّدي

198
00:13:59,920 --> 00:14:02,040
.واستدعوا طبيبًا على الفور

199
00:14:02,040 --> 00:14:02,950
.أمرك يا سيّدي

200
00:14:03,360 --> 00:14:05,770
،حسنًا أيّها الرّفاق
.حظًا طيبًا

201
00:14:05,770 --> 00:14:06,580
—لا تُهزموا

202
00:14:06,580 --> 00:14:07,800
!تبًا، تبًا، تبًا

203
00:14:07,800 --> 00:14:09,830
!ستلحق بهم يا تارو

204
00:14:10,020 --> 00:14:13,900
،رفاقك يخوضون نزالًا
.فقُم بما يتحتّم عليك

205
00:14:15,790 --> 00:14:18,880
،لنمضِ إذن
.فهذان فقدا صوابهما

206
00:14:20,790 --> 00:14:22,560
السّيف مُجرّد وهمٍ؟

207
00:14:22,910 --> 00:14:23,660
.سمعت ما قُلت

208
00:14:36,470 --> 00:14:37,690
.قطعة خُردةٍ بخسة

209
00:14:37,890 --> 00:14:41,200
،انتهى النّزال
.فلنعُد إلى حديثنا

210
00:14:41,630 --> 00:14:46,450
لماذا؟ لماذا ينطق ساموراي
مثلك بمثل هذا القول؟

211
00:14:48,620 --> 00:14:51,140
.يبدو أنّ ثمّة سُوء فهم هنا

212
00:14:51,140 --> 00:14:52,870
.أنا لست ساموراي

213
00:14:52,870 --> 00:14:53,700
ماذا؟

214
00:14:57,110 --> 00:14:59,010
فما أنت إذن؟

215
00:14:59,010 --> 00:15:01,210
.لست إلّا ابن فلّاحٍ

216
00:15:02,420 --> 00:15:03,280
!محالٌ

217
00:15:03,280 --> 00:15:07,580
أ-أفلاحٌ أنت؟
.يا لها مِن كذبةٍ

218
00:15:07,580 --> 00:15:09,040
!كُفّ عن الكذب

219
00:15:12,560 --> 00:15:15,600
واكيزاشي؟
ألديك رغبةٌ في الاستمرار؟

220
00:15:15,830 --> 00:15:18,480
ماذا عساك تفعل بتلك اللّعبة؟

221
00:15:25,140 --> 00:15:26,780
أَتختبر قُوّتي إذن؟

222
00:15:27,340 --> 00:15:30,940
هل توّهمت أنّ بمقدورك
مُقارعة سيفي والظّفر عليّ؟

223
00:15:31,850 --> 00:15:32,440
ماذا؟

224
00:15:39,050 --> 00:15:40,590
أَتضربني بقبضتك؟

225
00:15:40,590 --> 00:15:42,960
أَهذا أُسلوبك في النّزال؟

226
00:15:43,320 --> 00:15:45,960
لا تتصرّف وكأنّنا في
.مباراةٍ استعراضيّة

227
00:15:46,460 --> 00:15:48,470
،إنّما هو عراكٌ طاحن
.والأمر بهذه البساطة

228
00:15:49,690 --> 00:15:51,080
تبتغي عراكًا إذن؟

229
00:16:06,200 --> 00:16:07,890
!أَفلتني

230
00:16:08,400 --> 00:16:10,080
!بل أنت مَن عليه إفلاتي

231
00:16:10,440 --> 00:16:11,820
!سأقتلك حتمًا

232
00:16:12,330 --> 00:16:14,000
أَترغبان في المُواصلة؟

233
00:16:17,980 --> 00:16:20,210
متى وصل ذاك الرّجل إلى هنا؟

234
00:16:29,760 --> 00:16:31,720
.يا له مِن مشهدٍ يفتقر للجمال

235
00:16:32,250 --> 00:16:34,480
.لا صلة له بالجمال أبدًا

236
00:16:35,170 --> 00:16:36,840
مَن أنت؟

237
00:16:37,890 --> 00:16:38,940
.طاب مساؤكما

238
00:16:40,500 --> 00:16:44,250
ناووزومي، سيفك هذا لن
.يُجدي نفعًا هنا

239
00:16:44,760 --> 00:16:45,720
.وأنت تُدرك هذا تمامًا

240
00:16:45,890 --> 00:16:46,840
عدوٌّ جديد؟

241
00:16:47,370 --> 00:16:49,470
!سُحقًا لك يا أيامي

242
00:16:50,720 --> 00:16:52,770
.سأكون أنا مَن يُرديك قتيلًا

243
00:16:54,000 --> 00:16:57,560
لمَ لا ترتدي زيّ الريسّيدان الرسميّ؟

244
00:16:57,560 --> 00:17:01,890
،كُفّ عن هذا
.سألفت الأنظار لو تجوّلت به

245
00:17:01,890 --> 00:17:03,120
إلى أيّ حدٍ يبلغ حُمقك؟

246
00:17:04,120 --> 00:17:05,420
أَتعرف هذه الزّهرة؟

247
00:17:06,110 --> 00:17:09,130
.تُدعى روز ويُقال إنّ لها أشواكًا

248
00:17:10,040 --> 00:17:11,600
.تمامًا مثلي

249
00:17:11,880 --> 00:17:14,390
!ستلفت الأنظار أكثر بهذا الزّي

250
00:17:16,270 --> 00:17:20,120
،لديك مؤهّلاتٌ واعدة
.لكنّك للأسف تفتقر للبراعة

251
00:17:20,650 --> 00:17:22,290
مَن أنتم؟

252
00:17:23,620 --> 00:17:24,640
وكم عددكم؟

253
00:17:25,050 --> 00:17:31,640
،وفقًا لـ نيهون شوكي، فإنّ الأفعوان العظيم
.ياماتا نو أوروشي، كان له ثمانية رُؤوسٍ

254
00:17:33,330 --> 00:17:35,170
.ثمانية رُؤوسٍ

255
00:17:35,170 --> 00:17:37,570
...وهي: الزّنبق

256
00:17:38,160 --> 00:17:48,420
،الأحمق، المُحرّض، الصّياد، الهادئ
...الشّيطان، صانع الألعاب الناريّة، و

257
00:17:49,340 --> 00:17:50,180
.السّاموراي

258
00:17:52,080 --> 00:17:53,410
ما غايتكم؟

259
00:17:53,410 --> 00:17:55,430
.يُسعدني أنّك سألت

260
00:17:55,810 --> 00:17:57,590
—نحن، جماعة الريسّيدان الدمويّة، سنقوم بـ

261
00:17:57,590 --> 00:17:59,250
!مهلًا، ها هم هناك

262
00:18:00,240 --> 00:18:02,430
!هيجيكاتا-سان

263
00:18:07,890 --> 00:18:09,190
.يا إلهي

264
00:18:10,640 --> 00:18:11,280
ماذا؟

265
00:18:11,900 --> 00:18:13,410
ما هذا؟

266
00:18:13,880 --> 00:18:16,720
لعلّك وقعت في ورطةٍ؟

267
00:18:16,720 --> 00:18:18,510
.بجديّةٍ؟ هيّا يا صاح

268
00:18:18,510 --> 00:18:19,690
.يا للعجب

269
00:18:19,690 --> 00:18:21,950
لمَ لا تُجهز عليهما فحسب؟

270
00:18:24,180 --> 00:18:25,320
.إنّهم رجال المِيبورو

271
00:18:26,450 --> 00:18:29,200
هيجيكاتا، نحن مُستعدّون
.للانضمام في أيّ وقتٍ

272
00:18:29,580 --> 00:18:32,200
هذا يُثبت أنّك لا تزال
.بحاجةٍ لمزيد مِن التّدريب

273
00:18:33,330 --> 00:18:35,280
.زاد عددهم

274
00:18:35,280 --> 00:18:37,210
!تصرّف يا هيجيكاتا

275
00:18:38,000 --> 00:18:38,970
!اصمتوا

276
00:18:39,280 --> 00:18:42,350
.أُثخن ضربًا، يا للخزي

277
00:18:43,890 --> 00:18:47,600
،حسنًا، حسنًا
.كُلّ رفاقك حضروا للفُرجة

278
00:18:51,280 --> 00:18:53,930
،إذا تجاوزتم هذا الخطّ
.فسيبدأ القتال

279
00:18:54,430 --> 00:18:57,610
أَتريدون فضّ هذا النّزاع الآن؟

280
00:18:57,610 --> 00:18:59,110
ماذا؟

281
00:19:04,620 --> 00:19:08,120
.هيّا يا هاجيمي، أَجهز عليهما

282
00:19:09,280 --> 00:19:11,830
كلا، أظنّ أنّنا سنصرف النّظر
.عن التدخّل هذه المرّة

283
00:19:14,820 --> 00:19:15,720
.فهمت

284
00:19:16,430 --> 00:19:19,670
،أجل
.فالضوء ليس مناسبًا اليوم

285
00:19:23,670 --> 00:19:25,120
.لنرحل يا ناووزومي

286
00:19:25,120 --> 00:19:25,850
ماذا؟

287
00:19:26,180 --> 00:19:27,580
.هكذا تسير الأمور

288
00:19:28,680 --> 00:19:30,690
.ليس لك أن تُقرّر عنّي

289
00:19:31,020 --> 00:19:33,280
.سيفك مُنحنٍ

290
00:19:33,280 --> 00:19:33,910
ماذا؟

291
00:19:38,880 --> 00:19:39,640
،مهلًا

292
00:19:41,570 --> 00:19:43,700
.هذا القتال لم ينتهِ بعد

293
00:19:46,620 --> 00:19:49,450
ما هو اسمك؟

294
00:19:50,540 --> 00:19:52,240
.هيجيكاتا توشيزو

295
00:19:53,490 --> 00:19:55,720
.كيوهاتشي ناووزومي

296
00:19:56,190 --> 00:19:58,170
.إلى لقاءٍ آخر

297
00:19:59,780 --> 00:20:03,040
اسأل الفتى ذا الشّعر
.الأبيض عمّا نبغي

298
00:20:03,870 --> 00:20:06,720
أما كان الأجدر بنا مُواجهتهم
ما دامت الفُرصة سانحةً؟

299
00:20:07,100 --> 00:20:08,480
.أ-أجل

300
00:20:08,480 --> 00:20:10,560
هل أنت متأكّدٌ أنّنا سنتركهم يرحلون؟

301
00:20:10,560 --> 00:20:12,230
.اخرس

302
00:20:12,560 --> 00:20:17,390
...لكن حقًا
.ذاك المدعو ناووزومي بدا صلبًا

303
00:20:17,930 --> 00:20:19,920
.سأُصفّي حسابي معه آجلًا أو عاجلًا

304
00:20:20,730 --> 00:20:21,880
...الأهمّ مِن هذا يا سوجي

305
00:20:22,950 --> 00:20:25,360
.لا تشغل بالك بما لا يعنيك

306
00:20:25,750 --> 00:20:27,790
ماذا تقصد بذلك؟

307
00:20:30,590 --> 00:20:34,870
لا بُدّ أنّ ذاك المدعوّ هيجيكاتا
.شخصٌ ذو شأنٍ بالغ

308
00:20:35,330 --> 00:20:35,960
ماذا؟

309
00:20:36,530 --> 00:20:40,530
لم يهمّني سواء نشب
،القتال بيننا أم لا

310
00:20:41,560 --> 00:20:45,050
،لكن بالنّظر إلى وضعه
.كان موته مُؤكّدًا لو فعلنا

311
00:20:46,610 --> 00:20:52,360
،ذاك الفتى الوسيم قدّر مكاسب اعتقالنا
.ثُمّ آثر عدم الاشتباك

312
00:20:53,470 --> 00:20:56,310
رُغم أنّه بدا أنّ البقيّة
.كانوا يتحرّقون شوقًا للنّزاع

313
00:20:57,050 --> 00:20:59,280
.هيجيكاتا هو طريدتي

314
00:20:59,660 --> 00:21:01,560
.إذا مَسسته، سأُرديك قتيلًا

315
00:21:02,280 --> 00:21:04,050
.كم أنا مذعورٌ

316
00:21:13,370 --> 00:21:14,550
...ناووزومي-سان

317
00:21:15,590 --> 00:21:17,000
.إنّك هشٌّ للغاية

318
00:21:20,250 --> 00:21:21,200
ما الخطب؟

319
00:21:23,220 --> 00:21:26,380
مع ذلك، أعجبني ذاك الفتى
.ذُو الشّعر الأبيض

320
00:21:26,870 --> 00:21:28,920
.إنّهم جماعةٌ مُثيرة للاهتمام

321
00:21:29,580 --> 00:21:30,640
حقًا؟

322
00:21:31,870 --> 00:21:33,080
المِيبورو، أليس كذلك؟

323
00:21:35,230 --> 00:21:36,320
.أجل

324
00:21:39,110 --> 00:21:43,770
،قُضي الأمر
.سيكونون نُجوم المَحفل بلا ريبٍ

325
00:21:44,940 --> 00:21:49,950
ثمانيةُ رُؤوسٍ

326
00:23:20,080 --> 00:23:25,460
الحلقة القادمة

327
00:23:21,320 --> 00:23:26,960
بات الاصطدام بين المِيبورو وجماعة
.الريسّيدان الدمويّة أمرًا حتميًا

328
00:23:27,460 --> 00:23:30,800
،وفي هذه الأثناء
،وبعد نجاحه في حماية اللّورد إيموتشي

329
00:23:30,800 --> 00:23:36,050
يُنقل نيو إلى قصر نيجو
.ليكتسب خبرةً لم تكن في الحسبان

330
00:23:36,590 --> 00:23:43,490
أمّا المِيبورو، فسيكون هذا
.دافعًا جديدًا لتلاحمهم واتّحادهم

331
00:23:44,330 --> 00:23:47,660
:الحلقة القادمة
."أن نتقاسم الحُلم ذاته"

332
00:23:47,110 --> 00:23:49,940
أن

333
00:23:47,110 --> 00:23:49,940
نتقاسم
الحُلم
ذاته

334
00:23:47,980 --> 00:23:49,290
.لن يخيب أملكم