1
00:00:03,980 --> 00:00:07,230
مدرسة كيوهاتشي

2
00:00:10,590 --> 00:00:14,000
راودني شعورٌ بأنّكم ستقصدون
.هذا المكان

3
00:00:27,560 --> 00:00:29,210
.متى ما كنت مُستعدًا

4
00:00:30,660 --> 00:00:31,430
.حسنًا

5
00:00:44,770 --> 00:00:49,070
ذئاب ميبو الزّرق

6
00:02:12,990 --> 00:02:14,300
ماذا؟

7
00:02:14,970 --> 00:02:16,520
نِزالٌ؟

8
00:02:16,940 --> 00:02:23,280
هذا غريبٌ! ظننت أنّنا جئنا إلى هنا
.للاطمئنان على سيّدةٍ حُبلى

9
00:02:24,240 --> 00:02:29,240
لذا، بأيّ حالٍ، هل تتفضّلان بتهدئة هذه
الأجواء المُضرّجة بالدّماء والعُنف؟

10
00:02:33,380 --> 00:02:34,680
.سألتزم الصّمت الآن

11
00:02:38,080 --> 00:02:39,050
.إذا سمحت

12
00:02:39,050 --> 00:02:39,890
.نيو

13
00:02:40,840 --> 00:02:42,260
.أرجوك اهدأ للحظةٍ

14
00:02:44,490 --> 00:02:45,350
.نيو-كون

15
00:02:47,530 --> 00:02:50,690
يوتارو-سان، لماذا تفعل هذا؟

16
00:02:51,960 --> 00:02:54,590
،ناغي-سان حُبلى
ألا يجدر بك أن تكون إلى جانبها؟

17
00:02:56,610 --> 00:02:57,470
...ناغي

18
00:02:58,850 --> 00:02:59,990
.ليست هنا

19
00:03:01,440 --> 00:03:02,030
ماذا؟

20
00:03:02,760 --> 00:03:04,730
.إنّها ليست في المدينة حتّى

21
00:03:05,480 --> 00:03:07,600
.أرسلتها لتُقيم عند أقاربنا ليلة أمس

22
00:03:09,600 --> 00:03:11,160
.ستكون آمنةً هناك

23
00:03:12,030 --> 00:03:17,760
،يوتارو-سان
،لا أظنّك تُدرك خطورة ما يحدث

24
00:03:17,760 --> 00:03:19,790
وما قد يؤول إليه الأمر
.في هذه المدينة

25
00:03:20,890 --> 00:03:22,840
،هذا معطف جماعة الريسّيدان
أليس كذلك؟

26
00:03:23,270 --> 00:03:26,060
ناووزومي-سان، الرّجل الّذي كان
...يتردّد على هذا الدّوجو، هو

27
00:03:26,060 --> 00:03:28,120
،ناووزومي أخي الأكبر

28
00:03:30,020 --> 00:03:33,810
أخوك؟

29
00:03:34,670 --> 00:03:35,160
.أجل

30
00:03:36,400 --> 00:03:41,160
إذن، هذا سببٌ أدعى للتحرّك، لنتحدّث
!إليه معًا ونُقنعه بالتوقّف عن هذا

31
00:03:41,340 --> 00:03:44,660
.سأُطلعك على ما ينوون فعله

32
00:03:44,660 --> 00:03:46,960
،لا تُكلّف نفسك
.أنا على درايةٍ بكُلّ شيء

33
00:03:47,930 --> 00:03:49,560
.أخبرني أخي

34
00:03:54,310 --> 00:03:58,420
سيُضرمون النّيران في كيوتو ليُشعلوا
.شرارة عصرٍ جديد مِن الحُروب

35
00:03:59,750 --> 00:04:02,260
،أنا أعلم
.يا لها مِن فكرةٍ شنيعة

36
00:04:03,820 --> 00:04:04,840
...لكن

37
00:04:06,080 --> 00:04:08,160
انضممت إليهم وأنا مدركٌ
.لتلك الحقائق تمامًا

38
00:04:08,810 --> 00:04:12,720
!سيحرقون المدينة عن بكرة أبيها
أَتقبل بفعلةٍ كهذه؟

39
00:04:13,170 --> 00:04:15,280
،لكُلّ منّا شيءٌ يودّ حمايته

40
00:04:16,030 --> 00:04:19,390
والمسألة تنحصر في قيمة
.هذا الشّيء عنده

41
00:04:20,480 --> 00:04:22,490
،ناغي تُدرك هذا أيضًا
.بالطّبع

42
00:04:24,880 --> 00:04:28,770
فهمت، ناووزومي-سان
يُهدّدك، أليس كذلك؟

43
00:04:29,220 --> 00:04:31,300
وأنت لا تقوى على عصيان
.أخيك الأكبر

44
00:04:32,060 --> 00:04:34,230
.سيُؤذيك إن لم تتعاون معه

45
00:04:34,680 --> 00:04:37,350
،رُبّما لن يقتصر الأمر عليك
.بل سيطال عائلتك أيضًا

46
00:04:38,050 --> 00:04:39,880
،لذا لم تملك خيار الرّفض
صحيحٌ؟

47
00:04:50,760 --> 00:04:52,060
،هذا يُثلج صدري

48
00:04:52,940 --> 00:04:54,690
فأنا أُفضّل ألّا أضطرّ
.لإزهاق رُوح طفل

49
00:04:57,980 --> 00:05:00,160
.يوتارو-سان

50
00:05:00,510 --> 00:05:03,200
ألم يكن بمقدورك التّراجع
قبل أن يفوت الأوان؟

51
00:05:03,500 --> 00:05:05,280
،كلا
.لا أظنّ أنّ ذلك كان مُمكنًا

52
00:05:06,080 --> 00:05:09,710
فحماية هذا الدّوجو
.تعني لي العالم بأسره

53
00:05:10,840 --> 00:05:13,460
نيو، لا سبيل لتجنّب
.المُواجهة الآن

54
00:05:15,810 --> 00:05:17,540
.يجب ردعه بالقوّة

55
00:05:18,340 --> 00:05:20,640
.دائمًا ما يكون قولك سديدًا

56
00:05:22,990 --> 00:05:23,730
،كوندو-سان

57
00:05:26,200 --> 00:05:27,510
.أرجوك لا تقتله

58
00:05:29,410 --> 00:05:30,220
.أتوسّل إليك

59
00:05:33,180 --> 00:05:34,900
.كوندو-سان سيتولّى الأمر هنا

60
00:05:35,150 --> 00:05:36,530
.لننطلق يا ساكورا-سان

61
00:05:36,920 --> 00:05:37,340
ماذا؟

62
00:05:38,160 --> 00:05:39,490
،انتظر لحظةً

63
00:05:42,160 --> 00:05:43,720
إلى أين نحن ذاهبان؟

64
00:05:45,760 --> 00:05:49,040
.لا يُمكنني إيقاف يوتارو-سان

65
00:05:50,120 --> 00:05:51,080
...لذا

66
00:05:52,080 --> 00:05:55,380
.سأُركّز على ما بمقدوري فعله

67
00:05:57,060 --> 00:05:58,720
سنبحث عن ناغي-سان
.ونتحدّث إليها

68
00:05:59,020 --> 00:06:02,050
ماذا؟ أَلم تكن تُصغي
لما قِيل قبل قليل؟

69
00:06:02,750 --> 00:06:05,120
قال إنّ ناغي-سان لم تعد
.موجودةً في المدينة

70
00:06:05,120 --> 00:06:06,200
.أعتقد أنّها لا تزال هنا

71
00:06:06,850 --> 00:06:07,360
ماذا؟

72
00:06:08,090 --> 00:06:10,910
ناغي-سان ممتنّةٌ لهذه العائلة
.بشكلٍ لا يُوصف

73
00:06:11,520 --> 00:06:12,910
،أنا موقنٌ أنّها ستعود

74
00:06:13,630 --> 00:06:16,050
.حتّى لو اضطرّت للعودة بمُفردها

75
00:06:16,900 --> 00:06:20,670
عُذرًا، ألا يتملّككِ الخوف
مِن مخاض الولادة؟

76
00:06:20,920 --> 00:06:22,350
.يبدو لي أنّ ألمها لا يُحتمل

77
00:06:22,350 --> 00:06:24,160
،بالطّبع أنا خائفةٌ

78
00:06:24,320 --> 00:06:26,310
.لكنّي لا أستبق الأحداث

79
00:06:26,310 --> 00:06:27,280
لا تستبقين الأحداث؟

80
00:06:27,650 --> 00:06:31,760
أجل، أنا الّتي في الغد
.هي مِن ستتولّى تدبير الأمر

81
00:06:33,070 --> 00:06:36,120
ناغي-سان شخصيّةٌ أقوى
.مِن أن تنكسر

82
00:06:40,120 --> 00:06:40,930
!ناغي-سان

83
00:06:41,890 --> 00:06:43,740
.معذرةً

84
00:06:44,730 --> 00:06:46,900
!ناغي-سان، هذا أنا، نيو

85
00:06:47,720 --> 00:06:49,080
.ناغي-سان

86
00:06:49,380 --> 00:06:51,480
!طاب مساؤكم
هل مِن أحدٍ بالدّار؟

87
00:06:54,800 --> 00:06:55,800
!ناغي-سان

88
00:06:57,600 --> 00:06:58,440
.نيو-كون

89
00:07:06,840 --> 00:07:07,830
!ناغي-سان

90
00:07:09,550 --> 00:07:11,280
،ناغي-سان
هل أصابكِ مكروهٌ؟

91
00:07:11,280 --> 00:07:12,480
،تفضّلا بالجُلوس

92
00:07:15,690 --> 00:07:16,600
.أرجوكما اجلسا

93
00:07:17,320 --> 00:07:18,800
.حسنًا

94
00:07:24,590 --> 00:07:26,020
.اسمي ساكورا

95
00:07:27,400 --> 00:07:28,380
.وأنا ناغي

96
00:07:29,130 --> 00:07:31,320
ألا يوجد أحدٌ سواكِ في الدّار؟

97
00:07:31,800 --> 00:07:34,580
،هذا صحيحٌ
.عُدت دُون إخبار أيّ أحدٍ

98
00:07:35,070 --> 00:07:39,080
هل لكِ... أن تسمعيني؟

99
00:07:39,480 --> 00:07:41,860
،أرجوكِ حافظي على هُدوئكِ
.وحاولي ألّا يغلبكِ الذّعر

100
00:07:42,920 --> 00:07:46,530
،الأمر يتعلّق بما يحدث الآن
.أو بالأحرى، بما يُوشك أن يقع

101
00:07:47,320 --> 00:07:50,750
.عمّا ستنجرّان إليه أنتِ ويوتارو-سان

102
00:07:51,990 --> 00:07:55,090
!قد يحلّ بكيوتو كارثةٌ

103
00:07:55,410 --> 00:07:56,430
—أنا أعني ما أقوله حقًا

104
00:07:56,430 --> 00:07:57,400
،أنا أعلم

105
00:08:00,020 --> 00:08:01,320
.أعلم كُلّ شيء

106
00:08:07,440 --> 00:08:09,130
.بلغت مرحلةً لا مردّ منها

107
00:08:09,960 --> 00:08:13,260
ستقوم السّلطات بتفتيش
.هذا الدّوجو عاجلًا أم آجلًا

108
00:08:14,500 --> 00:08:16,380
.لذا سنُشعل فتيل انتفاضتنا أولًا

109
00:08:18,680 --> 00:08:20,800
،سيكون ذلك بعد ثلاثة أيّامٍ
.في ليلة مَولد القمر الجديد

110
00:08:22,940 --> 00:08:25,850
.لا بأس، لا داعي للقلق

111
00:08:26,940 --> 00:08:29,890
فسيأتي شخصٌ مِن العائلة
.لاصطحابكِ غدًا

112
00:08:30,930 --> 00:08:34,520
أُريد منكِ ومِن الجنين
.الّذي تحملينه مُغادرة المدينة

113
00:08:35,810 --> 00:08:37,040
...يوتارو-سان

114
00:08:40,090 --> 00:08:40,870
.ناغي-سان

115
00:08:42,490 --> 00:08:43,290
.أنا آسفٌ

116
00:08:44,500 --> 00:08:51,880
الريسّيدان

117
00:08:45,200 --> 00:08:51,200
،فلا خيار آخر أمامي، إن لم أفعل هذا
.فلن أستطيع لقاء أخي مرفوع الرّأس أبدًا

118
00:08:52,960 --> 00:08:53,730
.ناغي-سان

119
00:08:56,020 --> 00:08:58,290
.اعتني جيّدًا بالجنين

120
00:09:12,380 --> 00:09:15,190
.أخبرني يوتارو-سان بكُلّ شيءٍ

121
00:09:16,300 --> 00:09:18,640
،عن خُطّة أخيه ناووزومي

122
00:09:19,560 --> 00:09:21,530
.وأنّها ستُنفّذ اليوم

123
00:09:23,840 --> 00:09:25,900
.ناووزومي-سان ورفاقه لن يتوقّفوا

124
00:09:27,080 --> 00:09:29,140
ويوتارو-سان قد سلّم بأمر ذلك
.وتصالح معه

125
00:09:30,660 --> 00:09:31,540
...لذا

126
00:09:32,500 --> 00:09:34,600
.عزمت أنا أيضًا على القتال

127
00:09:35,230 --> 00:09:37,390
أنتِ أيضًا يا ناغي-سان؟

128
00:09:40,030 --> 00:09:43,680
،يوتارو-سان لا يعلم أنّني عُدت

129
00:09:44,370 --> 00:09:46,840
.فقد اتّخذت هذا القرار بمُفردي

130
00:09:48,470 --> 00:09:50,560
،ومع ذلك
.لن أُغادر هذه الدّار أبدًا

131
00:09:51,680 --> 00:09:54,240
،هذا هو عهدي
.وهذه هي معركتي

132
00:09:56,320 --> 00:10:07,540
مدرسة كيوهاتشي

133
00:09:56,820 --> 00:10:00,060
بالطّبع، سأنال عقابي
.إن فشلت الانتفاضة

134
00:10:01,100 --> 00:10:03,760
رُبّما تقوم حكومة الشّوغون
.بإلغاء نسب عائلتنا

135
00:10:05,290 --> 00:10:07,000
.وقد أدفع حياتي ثمنًا لذلك

136
00:10:09,450 --> 00:10:10,610
،لا أفهم

137
00:10:10,950 --> 00:10:13,540
.لا أفهم ما تقولينه على الإطلاق

138
00:10:13,920 --> 00:10:15,170
لماذا تفعلين هذا؟

139
00:10:15,360 --> 00:10:17,990
هل هناك ما هو أغلى
مِن حياتكِ نفسها؟

140
00:10:20,020 --> 00:10:25,920
،لن تفهم تلك المشاعر
.ولا ثِقلها

141
00:10:25,920 --> 00:10:31,040
،لا أتوقّع منك ذلك
.فلا أحد يُمكنه أن يحلّ محلّ الآخر

142
00:10:31,520 --> 00:10:34,980
.لـ-لكن الأبرياء سيتعرّضون للأذى

143
00:10:34,980 --> 00:10:36,640
.ذاك حريقٌ على الضّفة الأخرى

144
00:10:37,360 --> 00:10:39,520
حريقٌ على... ماذا؟

145
00:10:40,450 --> 00:10:43,870
حتّى وإن نشب حريقٌ، فلن يبلغني
.لهبه ما دام بيني وبينه نهرٌ

146
00:10:45,010 --> 00:10:46,620
هل تقصدين ما تقولينه حقًا؟

147
00:10:46,920 --> 00:10:48,490
.بالطّبع أقصد ذلك

148
00:10:49,810 --> 00:10:52,810
ينبغي على كُلّ فردٍ أن يبدأ
.بحماية ما هو قريبٌ منه

149
00:10:53,800 --> 00:10:56,480
فأيّ شيءٍ بعيد جدًا
.لا يستحقّ العناء

150
00:10:57,940 --> 00:11:00,880
بعض البشر يرسمون لاهتمامهم
.دوائر أكبر مِن غيرهم

151
00:11:01,790 --> 00:11:03,050
.أنا أُدرك هذا

152
00:11:03,570 --> 00:11:06,580
سواء أقررت بهذه الحقيقة
.أم غفلت عنها، فهي لا تتغيّر

153
00:11:07,640 --> 00:11:09,380
،أمّا أنا
.فلعلّ دائرتي ضيّقةٌ للغاية

154
00:11:10,070 --> 00:11:13,620
أَتحمين ما هو قريبٌ منكِ فقط؟
هل هذا يعني أنّ كُلّ مَن هو خارج دائرتكِ عدوٌّ لكِ؟

155
00:11:13,850 --> 00:11:14,770
.هذا صحيحٌ

156
00:11:15,940 --> 00:11:19,780
لا يُمكنني حماية ما هو أبعد مِن
.هذا الحصير الّذي أجلس عليه

157
00:11:21,320 --> 00:11:23,290
،لا يعنيني سوى هذا الجنين
.ويوتارو-سان

158
00:11:23,290 --> 00:11:24,470
.ودارنا

159
00:11:25,200 --> 00:11:27,070
...ما أراه ضفّتي

160
00:11:29,090 --> 00:11:30,980
.ليس إلّا الضّفة الأخرى في ناظريك

161
00:11:31,250 --> 00:11:32,800
...لكن

162
00:11:33,580 --> 00:11:38,300
نيو-كون، أَترغب في حمل عبء كُلّ
مأساةٍ تقع مِن الآن وحتّى نهاية العالم؟

163
00:11:39,040 --> 00:11:41,920
.كلا، لا أرغب

164
00:11:42,410 --> 00:11:45,360
.ولكن أقل ما يُمكنني فِعله هو المُحاولة

165
00:11:45,360 --> 00:11:47,960
هل أنت إلهٌ؟ أم أنّك بوذا مثلًا؟

166
00:11:49,800 --> 00:11:51,260
إنّك لا تفعل شيئًا
.سوى التّمادي في غُرورك

167
00:11:54,400 --> 00:11:56,410
ذاك اليوم الّذي استقللنا
...فيه القارب معًا

168
00:11:57,630 --> 00:11:58,270
.انظر

169
00:11:59,450 --> 00:12:00,560
هلالٌ؟

170
00:12:01,920 --> 00:12:03,840
فتّانٌ، أليس كذلك؟

171
00:12:04,380 --> 00:12:09,030
أليس مِن الطّريف أنّ كُلّ شيءٍ
جميل لا بُدّ وأن ينقصه شيءٌ ما؟

172
00:12:09,580 --> 00:12:13,170
أتذكر حين قُلت إنّ الهِلال
فتّانٌ وجميل لأنّه ناقص؟

173
00:12:14,400 --> 00:12:15,460
.البشر كذلك تمامًا

174
00:12:16,040 --> 00:12:18,580
،كُلّنا ضعفاء
.وكُلّنا نفتقر لشيءٍ ما

175
00:12:19,420 --> 00:12:23,910
،قد تكون طيبًا، صادقًا
،عادلًا، وقويًا

176
00:12:24,620 --> 00:12:26,850
.لكنّك تغترّ بنفسك أكثر مِن اللّازم

177
00:12:28,930 --> 00:12:31,410
لن يُمكنك إنقاذ أحدٍ
.وأنت على هذه الحال

178
00:12:36,790 --> 00:12:37,760
لماذا؟

179
00:12:38,830 --> 00:12:42,200
ما الفائدة مِن جرح مشاعر
.طفلٍ مثله؟ أنا لا أفهم

180
00:12:43,340 --> 00:12:45,850
ألا تهتمّين بما يحدث لأيّ شخصٍ آخر؟

181
00:12:46,210 --> 00:12:50,620
...بسبب وجود أُناسٍ بهذه القسوة

182
00:12:51,520 --> 00:12:56,450
،نيو-كون
.أنت لا تجلس قُبالة قدّيسةٍ

183
00:12:57,600 --> 00:12:59,880
.إنّما أنا مُجرّد إنسانةٍ ضعيفة

184
00:13:02,140 --> 00:13:04,700
.كلا، لا طاقة لي بهذا

185
00:13:06,150 --> 00:13:09,380
.لا يُمكنني إقناع امرأةٍ بمثل صلابتها

186
00:13:13,140 --> 00:13:15,890
البسالة

187
00:13:14,400 --> 00:13:15,620
.هذا ليس مُنصفًا

188
00:13:17,850 --> 00:13:20,820
!أنتِ قويّةٌ جدًا يا ناغي-سان

189
00:13:25,120 --> 00:13:29,660
،شُكرًا لك، حتّى وإن قُلتها تهكّمًا
.فلم يسبق لأحدٍ أن وصفني بالقوّة

190
00:13:38,720 --> 00:13:39,540
!ناغي-سان

191
00:13:40,790 --> 00:13:41,970
هل أنتِ بخير؟

192
00:13:41,970 --> 00:13:42,760
!ناغي-سان

193
00:13:43,840 --> 00:13:45,590
!ناغي-سان! ناغي-سان

194
00:13:48,560 --> 00:13:49,740
محالٌ! أَهي آلام المخاض؟

195
00:13:50,510 --> 00:13:51,930
!رُبّما حان موعد الولادة

196
00:13:52,240 --> 00:13:53,060
ماذا؟

197
00:13:58,590 --> 00:13:59,430
!ناغي-سان

198
00:13:59,650 --> 00:14:00,950
!تحمّلي، اصمدي يا ناغي-سان

199
00:14:04,280 --> 00:14:07,840
،كانت تتألّم مُنذ مُدّة
.رُبّما طوال الفترة الّتي مكثناها هنا

200
00:14:08,440 --> 00:14:10,030
مـ-ماذا نفعل؟

201
00:14:10,280 --> 00:14:12,100
!ماذا؟ لا تسألني

202
00:14:12,100 --> 00:14:14,310
ماذا سنفعل؟
.لا يُوجد غيرنا هنا

203
00:14:14,950 --> 00:14:16,840
،هيّا
.اذهب وأغلِ بعض الماء حالًا

204
00:14:16,840 --> 00:14:18,940
،حسنًا
!سآتي بالماء السّاخن فورًا

205
00:14:18,940 --> 00:14:21,890
،وأحضر معك قِطع قُماشٍ نظيفة
.كل ما يُمكنك إيجاده

206
00:14:21,890 --> 00:14:22,420
.فهمت

207
00:14:22,420 --> 00:14:23,270
!أسرع

208
00:14:23,270 --> 00:14:24,260
!حسنًا

209
00:14:25,060 --> 00:14:27,830
كانت تتألّم طوال هذا الوقت
.وتكتم أوجاعها

210
00:14:28,590 --> 00:14:33,850
،ورُغم ذلك
.كابدت لتُحادثني حين حضرت

211
00:14:34,560 --> 00:14:36,740
كيف لي أن أغفل عن أمرٍ كهذا؟

212
00:14:42,560 --> 00:14:44,540
هـ-هل مِن أحدٍ هنا؟

213
00:14:46,430 --> 00:14:47,600
!إنّها حالةٌ عاجلة

214
00:14:47,810 --> 00:14:50,680
،ناغي-سان تمرّ بمخاض الولادة
...لذا

215
00:15:04,140 --> 00:15:07,250
ما الخطب؟ لا يُعقل أنّ هذا
.كُلّ ما تملكه مِن قوّة

216
00:15:07,960 --> 00:15:09,250
.كفاك خداعًا

217
00:15:09,750 --> 00:15:12,070
كيف لرجلٍ بهذه الضّخامة
أن يتحرّك بهذه السّرعة؟

218
00:15:15,290 --> 00:15:18,160
،قُل لي
.أنا لا أرى أيّ نيران

219
00:15:18,680 --> 00:15:21,000
،يبدو أنّك أخفقت
أليس كذلك؟

220
00:15:22,630 --> 00:15:28,640
هذه المدينة الّتي صارت هشّةً ليست
.الشّيء الوحيد الّذي أرغب في إحراقه

221
00:15:29,310 --> 00:15:30,440
ماذا؟

222
00:15:31,050 --> 00:15:34,860
أنا أرغب في زوال تلك
.الدّار الملعونة أيضًا

223
00:15:46,930 --> 00:15:48,780
ماذا تفعل هنا؟

224
00:15:50,120 --> 00:15:52,840
مهلًا، هل هو مِن جماعة الريسّيدان؟
ولكن لماذا هنا؟

225
00:15:54,000 --> 00:15:55,660
.مُجرّد طفلٍ

226
00:15:57,020 --> 00:15:58,220
—أيـ-أيّها النّاس

227
00:15:58,220 --> 00:15:59,230
.لا تُثير الضّجيج

228
00:16:00,180 --> 00:16:01,740
.لن يأتي أحدٌ على أيّ حال

229
00:16:02,580 --> 00:16:05,450
أَتريد إضرام النّار في هذه الدّار؟

230
00:16:05,900 --> 00:16:07,400
ولكن لماذا؟ ما السّبب؟

231
00:16:07,400 --> 00:16:10,490
،لا أعلم
.أنا أُنفّذ الأوامر فحسب

232
00:16:10,920 --> 00:16:12,160
.لا تتدخّل

233
00:16:16,600 --> 00:16:20,000
ماذا عساي أن أفعل؟ إذا أشعل
.تلك النّيران، فقد انتهى كُلّ شيء

234
00:16:21,290 --> 00:16:22,670
.يجب أن أمنعه

235
00:16:25,050 --> 00:16:26,200
.أرجوك، انتظر لحظةً

236
00:16:27,420 --> 00:16:30,710
.سيّدة هذه الدّار على وشك الولادة

237
00:16:34,180 --> 00:16:37,480
لا أُريد تخيّل ما سيحدث لو أحرقت
.المكان في هذه اللّحظة

238
00:16:38,560 --> 00:16:40,090
.ليست مُشكلتي

239
00:16:40,680 --> 00:16:43,500
،لا جدوى
.لا يُمكنني إقناعه بالمنطق

240
00:16:45,240 --> 00:16:46,460
.لا مفرّ مِن القتال

241
00:16:47,830 --> 00:16:50,330
هل أستخدم السّيف؟ أم الخشب؟

242
00:16:54,270 --> 00:16:54,860
.خُذه، إنّه لك

243
00:16:55,280 --> 00:16:55,860
.أجل يا سيّدي

244
00:16:58,400 --> 00:17:00,370
.إنّه... إنّه ثقيلٌ جدًا

245
00:17:00,690 --> 00:17:04,910
كُلّنا نحمل شيئًا يجعل
.لهذا الثّقل قيمةً

246
00:17:06,350 --> 00:17:08,440
،أنت أيضًا
.تقع على عاتقك مسؤوليّةٌ جسيمة

247
00:17:09,190 --> 00:17:10,110
،فلا تغفل عنها

248
00:17:10,920 --> 00:17:13,130
.ولا تدع هذا الشّعور بالثّقل يُفارقك أبدًا

249
00:17:16,050 --> 00:17:18,850
نيو، ما الّذي تُنذر له حياتك؟

250
00:17:19,660 --> 00:17:23,280
أسعى لعالمٍ يمشي فيه المارّة
.ليلًا دُون وَجل

251
00:17:23,680 --> 00:17:24,360
.حسنًا

252
00:17:24,760 --> 00:17:27,200
أريد بناء وطنٍ يبكي
.فيه الصّغار دُون خوفٍ

253
00:17:27,550 --> 00:17:28,310
.جيّد

254
00:17:29,080 --> 00:17:32,320
.أرتجي زمانًا لا يُقهر فيه مَن لا حول له

255
00:17:33,580 --> 00:17:34,390
.عظيم

256
00:17:35,920 --> 00:17:38,130
يجب عليّ ردع هؤلاء العابثين
!بكُلّ سبيلٍ

257
00:17:38,880 --> 00:17:42,570
فليس من الصّواب أن نسفك الدّماء
.رغبةً في إصلاح الدّنيا

258
00:17:43,120 --> 00:17:44,920
،ممتنٌ لك على هذا السّيف يا سيّدي

259
00:17:45,290 --> 00:17:47,120
.وأعاهدك أن أستخدمه بكُلّ حرصٍ

260
00:17:47,120 --> 00:17:49,600
أَتنوي حملهما معًا؟
.ذلك سيُثقل كاهلك

261
00:17:51,050 --> 00:17:52,400
،سأستلّ هذا فقط

262
00:17:52,840 --> 00:17:55,370
،أمّا هذا فإنّه بمنزلة رُوحي
.لذا لا نيّة لي في استلاله أبدًا

263
00:17:58,160 --> 00:18:00,080
...أعلم ما قُلته حينها، ولكن

264
00:18:01,030 --> 00:18:03,000
.اعذرني يا هيجيكاتا-سان

265
00:18:04,320 --> 00:18:05,530
!سأستلّ سيفي

266
00:18:12,320 --> 00:18:16,530
،إذا خسرت الآن
.فسيذهب جُهد الجميع سدىً

267
00:18:17,290 --> 00:18:18,750
.مهما حدث، لا بُدّ أن أمنعه

268
00:18:19,810 --> 00:18:21,910
!أرجوك غادر

269
00:18:22,460 --> 00:18:25,040
!سأقتلك حقًا إن لم تفعل

270
00:18:25,240 --> 00:18:26,620
.ابتعد عن طريقي

271
00:18:29,350 --> 00:18:33,800
لم يسبق لي أن لوّحت بسيفٍ
...حقيقيّ مِن قبل، ولكن

272
00:18:37,950 --> 00:18:38,560
.ها أنا ذا

273
00:18:46,330 --> 00:18:48,100
.اللّعنة

274
00:18:52,320 --> 00:18:53,880
،لا تتدخّل فيما لا يعنيك
.أيّها الشّقي

275
00:18:54,260 --> 00:18:56,200
.كلا، لا بُدّ أن أُخمدها بسرعة

276
00:19:03,690 --> 00:19:06,780
،إنّها تحترق
.الدّار ستحترق بالكامل

277
00:19:08,190 --> 00:19:09,060
!نيو-كون

278
00:19:10,510 --> 00:19:12,520
ماذا دهاك؟
!ابتعد عن هناك فورًا

279
00:19:12,520 --> 00:19:13,720
!طالت النّار شعرك

280
00:19:13,930 --> 00:19:15,000
ماذا عساي أن أفعل؟

281
00:19:15,000 --> 00:19:17,550
،أنا آسفٌ
.لا أعلم كيف أتصرّف

282
00:19:17,550 --> 00:19:19,250
!لم أقدر على إيقافه

283
00:19:19,250 --> 00:19:21,720
!كلا! ناغي-سان

284
00:19:21,990 --> 00:19:22,810
...الدّار

285
00:19:23,470 --> 00:19:24,370
...حتّى السّقف بدأ ينهار

286
00:19:25,500 --> 00:19:26,930
!تمالك نفسك يا نيو-كون

287
00:19:27,150 --> 00:19:28,730
.ليس هذا وقت النّحيب

288
00:19:30,010 --> 00:19:32,360
...ساكورا-سان

289
00:19:32,720 --> 00:19:34,400
.علينا أن نفعل ما بوسعنا

290
00:19:34,400 --> 00:19:36,170
...ما بوسعنا

291
00:19:38,000 --> 00:19:40,730
،بالطّبع! أ-أجل
!أنتِ على حقّ

292
00:19:42,400 --> 00:19:45,610
،البقاء هنا شديد الخُطورة
.لا بُدّ مِن نقل ناغي-سان

293
00:19:46,200 --> 00:19:47,710
هل تعرف أحدًا يُمكننا الاعتماد عليه؟

294
00:19:48,560 --> 00:19:51,230
،جدّتي
.إنّها خبيرةٌ بأمور الولادة

295
00:19:52,360 --> 00:19:54,090
كم تبعد دارها عن هنا؟

296
00:19:54,600 --> 00:19:56,210
.خلف الجسر مُباشرةً

297
00:19:56,400 --> 00:20:00,280
عظيمٌ، نيو-كون، ادفع تلك العربة
.الّتي في الخارج إلى فناء الدّار

298
00:20:00,280 --> 00:20:03,110
حسنًا، يجب أن نخرج مِن الباب
.الخلفي قبل أن تنتشر النّيران

299
00:20:03,110 --> 00:20:04,510
.حسنًا، فلنُسرع

300
00:20:07,050 --> 00:20:09,560
،هناك حياةٌ على المِحك
!يجب أن أُساعد

301
00:20:10,670 --> 00:20:12,390
.فهذا هو السّبب الّذي جئت مِن أجله

302
00:20:24,080 --> 00:20:27,430
ما الخطب يا كوندو-سان؟
.بدأ القتال بالفعل

303
00:20:28,720 --> 00:20:31,420
،لكنّك تتصرّف بحذرٍ شديد
.على خلاف ما كُنت عليه ذلك اليوم

304
00:20:32,380 --> 00:20:35,030
،لنكن على بيّنةٍ
هل أنت راضٍ حقًا عمّا يجري؟

305
00:20:35,880 --> 00:20:37,240
.نحن نُقاتل بالسّيوف

306
00:20:38,160 --> 00:20:41,570
،يُمكن أن أموت أنا، بطبيعة الحال
.ولكنّك قد تموت أيضًا

307
00:20:43,000 --> 00:20:44,020
لماذا تسأل الآن؟

308
00:20:45,120 --> 00:20:48,460
،لديك زوجةٌ
.ومولودٌ قادم في الطّريق

309
00:20:49,280 --> 00:20:50,470
،لا تقلق بشأن ذلك

310
00:20:51,250 --> 00:20:52,820
.فقد طلّقتها بالفعل

311
00:20:54,410 --> 00:20:55,420
أَتعني أنّ كُلّ واحدٍ منكما
مضى في سبيله؟

312
00:20:56,610 --> 00:21:00,390
لن أخرج أنا ولا الدّوجو الخاصّ بي
،مِن هذه المَعمعة بلا خسائر

313
00:21:01,230 --> 00:21:06,460
لكن مشاكلي العائليّة لن تطال
.ناغي أو جنينها بعد الآن

314
00:21:07,710 --> 00:21:11,960
ثُمّ إنّ وزر تشكيل جماعة الريسّيدان
.يقع على عاتقي في المقام الأول

315
00:21:14,060 --> 00:21:19,620
هذا هو تكفيري كأخٍ، وواجبي كقائمٍ
.على شؤون عائلة كيوهاتشي

316
00:21:20,820 --> 00:21:24,050
،لذا، فإنّ عزيمتي راسخةٌ

317
00:21:26,100 --> 00:21:27,160
فهل عزيمتك كذلك؟

318
00:21:36,650 --> 00:21:39,790
،على أيّ حالٍ
.صار بإمكاننا القتال دُون ندمٍ

319
00:21:42,000 --> 00:21:43,410
.هذا هو واقع الحال

320
00:21:44,900 --> 00:21:49,910
مستعدٌّ
لما

321
00:21:44,900 --> 00:21:49,910
هو
آتٍ

322
00:23:20,040 --> 00:23:25,420
الحلقة القادمة

323
00:23:21,900 --> 00:23:23,280
.كوندو إيسامي يُحدّثكم

324
00:23:24,310 --> 00:23:29,770
،يوتارو-دونو، أنت سيّافٌ فذّ لا يُشقّ له غبار
.ولكن ما سيحدث الآن ضرورةٌ لا مناص منها

325
00:23:31,000 --> 00:23:34,120
.عقدت عزيمتي كما فعلت أنت تمامًا

326
00:23:35,450 --> 00:23:40,970
،مهما كان ماضيك
،ومهما بلغ ندمك

327
00:23:41,560 --> 00:23:43,400
.فقد تجاوزنا جميعًا نُقطة اللّا عودة

328
00:23:44,480 --> 00:23:46,470
."الحلقة القادمة: "الجِناية والقَدر

329
00:23:47,060 --> 00:23:48,110
.إيّاكم أن تُفوّتوها

330
00:23:47,070 --> 00:23:49,900
الجِناية

331
00:23:47,070 --> 00:23:49,900
والقَدر