1
00:00:00,100 --> 00:00:02,850
جسرماتسوبارا

2
00:00:07,200 --> 00:00:08,730
.أنت التّالي

3
00:00:09,040 --> 00:00:10,500
.التقيتك سابقًا

4
00:00:11,110 --> 00:00:12,500
ما اسمك؟

5
00:00:12,760 --> 00:00:15,200
.هاجيمي، سايتو هاجيمي

6
00:00:16,230 --> 00:00:17,290
.نِلت إعجابي

7
00:00:17,970 --> 00:00:20,860
خُصوصًا رُوحك المُتّقدة بالقتال
.والمُتعطّشة للقتل

8
00:00:22,370 --> 00:00:23,380
.هاجيمي

9
00:00:23,380 --> 00:00:25,750
—هناك مكانٌ لك في جماعة الريسّيدان

10
00:00:25,160 --> 00:00:25,750
.أرفض

11
00:00:27,070 --> 00:00:28,360
—غادر المِيبورو و

12
00:00:27,520 --> 00:00:28,360
.أرفض

13
00:00:44,770 --> 00:00:49,070
ذئاب ميبو الزّرق

14
00:02:08,720 --> 00:02:10,860
ما هذا؟
أَلم تُجهز عليهم؟

15
00:02:11,640 --> 00:02:13,880
.مُستواهم أدنى مِن أن ألتفت إليهم

16
00:02:14,750 --> 00:02:15,950
.لا يستحقّون القتل

17
00:02:17,680 --> 00:02:20,730
يا للخيبة، أنت مُجرّد هاوٍ
.يتقمّص دور السّاموراي

18
00:02:21,320 --> 00:02:22,640
.قُل ما شئت

19
00:02:23,140 --> 00:02:24,830
.ستلحق بهم عمّا قريب

20
00:02:32,880 --> 00:02:34,040
ما الخطب؟

21
00:02:38,270 --> 00:02:41,500
،سُحقًا
.حسبته مُجرّد فتىً صغير

22
00:02:42,960 --> 00:02:43,800
.لا تتحرّك

23
00:02:44,830 --> 00:02:46,430
.تظاهر بأنّك غائبٌ عن الوعي

24
00:02:47,890 --> 00:02:48,630
،نييمي

25
00:02:50,140 --> 00:02:54,070
،لا أعلم فِيم يُفكّر
.لكنّه سيُتمّ عمله

26
00:02:54,740 --> 00:02:57,020
،كان هيجيكاتا مُتيقظًا للأمر

27
00:02:58,330 --> 00:03:00,350
.فقد اختار لي الشّريك الأمثل

28
00:03:02,240 --> 00:03:03,280
ألن تُهاجم؟

29
00:03:04,240 --> 00:03:07,930
،كلا بالطّبع
.فأنت تَعي ما تفعله تمامًا

30
00:03:09,110 --> 00:03:14,010
مَن أين يأتي بهذه الثّقة المُريبة؟
.يُساورني حدسٌ سيّئ

31
00:03:14,810 --> 00:03:16,530
.فثمّة أمرٌ لم يكن طبيعيًا حينها أيضًا

32
00:03:18,360 --> 00:03:19,410
تعبيرات وجهه؟

33
00:03:20,260 --> 00:03:21,150
أم حركاته؟

34
00:03:22,680 --> 00:03:23,480
أم تُراه اسمه؟

35
00:03:24,890 --> 00:03:29,620
،حين استعرضنا قائمة أسمائهم
.بدا لي أنّ أحدهم لا ينتمي إليهم

36
00:03:25,160 --> 00:03:29,620
.الأحمق، المُحرّض، السّاموراي، الصّياد

37
00:03:31,260 --> 00:03:32,140
،نسيت

38
00:03:32,890 --> 00:03:35,230
.رُبّما لاحظ نيو شيئًا ما

39
00:03:35,920 --> 00:03:37,970
.الحياة مثاليّةٌ في جانبنا يا هاجيمي

40
00:03:38,620 --> 00:03:40,710
،انضمّ إلينا
.وستحظى بفُرصةٍ لقتل النّاس

41
00:03:42,050 --> 00:03:44,540
.يمكنك أن تزداد قوّةً

42
00:03:48,420 --> 00:03:51,080
،عملٌ غير القتل
أليس كذلك؟

43
00:03:53,240 --> 00:03:54,290
التّشريح؟

44
00:03:54,560 --> 00:03:58,750
بتر جُثث الموتى لفحص
.العظام والأعضاء

45
00:03:59,180 --> 00:04:01,200
.لأغراض البحث الطّبي

46
00:04:02,110 --> 00:04:06,080
يجب أن يمنح الشّوغون إذنًا
.لاستخدام جُثمان المُجرمين

47
00:04:06,590 --> 00:04:10,290
وقد قدّم هذا الطّلب طبيبٌ
.لم يمنحه الشّوغون إذنًا رسميًا

48
00:04:10,290 --> 00:04:12,310
.نبشٌ للقبور إذًا

49
00:04:12,590 --> 00:04:15,920
عشرة ريو لقاء الحراسة
.والمُساعدة في حمل الجُثث

50
00:04:16,230 --> 00:04:18,140
.إنّه عملٌ محفوف بالمخاطر

51
00:04:19,060 --> 00:04:21,520
.وستُسجن إذا قُبض عليك

52
00:04:22,330 --> 00:04:24,310
،طالما أنّه ليس قتلًا
.فلا أهتمّ

53
00:04:24,730 --> 00:04:26,620
!ماذا؟
!هل قُلت عشرة ريو؟

54
00:04:27,640 --> 00:04:29,460
كنت أعلم، فقد فاحت
.منك رائحة الدّماء

55
00:04:29,920 --> 00:04:30,880
.اصمت

56
00:04:33,630 --> 00:04:37,330
،لم تسألني عن أيّ شيءٍ
.هذا يعني أنّك تثق بي

57
00:04:39,970 --> 00:04:41,630
.لن أقتل أحدًا

58
00:04:42,450 --> 00:04:45,670
،طالما أنّني أفوق خصمي قوّةً
.فسأقبض عليه حيًا

59
00:04:46,590 --> 00:04:49,760
،أنا مِن المِيبورو
.وسأحمي كيوتو

60
00:04:50,210 --> 00:04:51,540
.هذه هي أوامري

61
00:04:53,410 --> 00:04:54,660
.يا للسّذاجة

62
00:04:55,260 --> 00:04:56,800
.يا للخيبة

63
00:04:58,740 --> 00:04:59,680
.أدركت الأمر

64
00:05:02,360 --> 00:05:06,820
استخدم يده اليمنى ليُرخي سيفه
.في المرّة السّابقة أيضًا

65
00:05:09,320 --> 00:05:10,820
.إنّه لا يستخدم يده اليُسرى

66
00:05:12,980 --> 00:05:14,080
.ويبدو واثقًا بشكلٍ مُريب

67
00:05:15,350 --> 00:05:18,710
هذا يُؤكّد ظُنوني، فهو يُخفي
.ورقةً رابحة ما في يده اليُسرى

68
00:05:19,200 --> 00:05:21,010
.رُبّما سلاحًا صغيرًا مُخبّأ

69
00:05:23,360 --> 00:05:26,350
.سلب الأرواح هو القوّة الحقيقيّة

70
00:05:28,500 --> 00:05:32,590
هاجيمي، لن تستطيع
.إيقافي دُون قتلي

71
00:05:32,840 --> 00:05:33,520
.لا بأس لديّ

72
00:05:42,400 --> 00:05:43,360
ألم يستلّ سيفه بعد؟

73
00:05:43,690 --> 00:05:44,290
.إنّه بارعٌ

74
00:05:45,000 --> 00:05:46,410
!يدك اليُسرى مكشوفةٌ تمامًا

75
00:05:51,880 --> 00:05:52,810
.إنّه بلا ذراعٍ

76
00:05:59,830 --> 00:06:01,630
أَتتراجع؟

77
00:06:01,970 --> 00:06:03,970
،لا أكاد أُصدّق
.إنّه يملك ذراعًا واحدة فقط

78
00:06:05,260 --> 00:06:08,350
،كان ذلك وشيكًا
.لكنّي لن أُكرّر هذا الخطأ ثانيةً

79
00:06:09,070 --> 00:06:12,390
،كلا يا هاجيمي
.فالمعركة قد حُسمت بالفعل

80
00:06:12,670 --> 00:06:13,320
ماذا تقصد؟

81
00:06:18,760 --> 00:06:20,640
أَتظنني جبانًا؟

82
00:06:20,640 --> 00:06:22,320
.يا لك مِن ساذجٍ حقًا

83
00:06:23,920 --> 00:06:25,640
.تذكّرت الآن

84
00:06:26,480 --> 00:06:28,400
...ذلك الاسم الغريب

85
00:06:29,470 --> 00:06:32,260
كُلّ ما يُحقّق لك النّصر
.يُعدّ مشروعًا في القتال

86
00:06:33,220 --> 00:06:36,920
،ليلي، زنبق الوادي
.إنّها زهرةٌ سامّة

87
00:06:38,620 --> 00:06:41,040
سُحقًا! سمٌّ إذًا؟

88
00:06:42,520 --> 00:06:43,680
هل سأُهزم؟

89
00:06:45,440 --> 00:06:48,160
...أيّها العجوز، هل أنا

90
00:06:50,530 --> 00:06:53,120
.جيرو، أنت ضعيفٌ

91
00:06:53,710 --> 00:06:55,800
أنا؟ ضعيفٌ؟

92
00:06:56,420 --> 00:06:58,280
.أجل، ضعيفٌ

93
00:07:00,400 --> 00:07:05,440
أعلم ذلك بالفعل، لهذا السّبب
!قُتل أبي وأمّي على يد اللّصوص

94
00:07:05,440 --> 00:07:06,810
!لأنّني ضعيفٌ

95
00:07:07,610 --> 00:07:08,320
.هذا صحيحٌ

96
00:07:09,510 --> 00:07:12,880
لهذا قُلت إنّي أُريد
!أن أغدو قويًا مثلك

97
00:07:13,440 --> 00:07:16,080
انظر، صار شعري أبيض
!كالثّلج مُنذ ذلك اليوم

98
00:07:16,680 --> 00:07:18,470
.علّمني كيفية استخدام السّيف

99
00:07:18,820 --> 00:07:21,310
.أُريد أن أصير قويًا مثلك

100
00:07:21,760 --> 00:07:22,430
.كلا

101
00:07:22,430 --> 00:07:24,120
لماذا؟

102
00:07:24,540 --> 00:07:27,480
.جيرو، سأكون صريحًا معك

103
00:07:29,260 --> 00:07:32,640
.الحقيقة هي أنّني ضعيفٌ أيضًا

104
00:07:37,300 --> 00:07:39,920
.أنا مُجرّد يتيمٍ مسكين

105
00:07:40,360 --> 00:07:44,130
،والداي قُتلا، وليس لي أقارب
.أنا وحيدٌ تمامًا في هذا العالم

106
00:07:45,480 --> 00:07:46,000
ألا تفهم تلميحي؟

107
00:07:51,360 --> 00:07:53,580
!ما الضّرر في تعليمي كيفية القتال؟

108
00:07:54,810 --> 00:07:56,000
!لا تبخل عليّ بما تعرف

109
00:07:57,050 --> 00:07:58,330
.أنا أعرف كُلّ شيءٍ

110
00:08:01,160 --> 00:08:03,170
.أنت قويٌّ حقًا

111
00:08:03,170 --> 00:08:05,840
صرعت أولئك اللّصوص
.في رمشه عينٍ

112
00:08:06,290 --> 00:08:09,360
،كلا، بل أنا ضعيفٌ
،كُلّ البشر ضُعفاء

113
00:08:10,250 --> 00:08:12,100
—إنّما العِبرة في

114
00:08:11,030 --> 00:08:12,100
!كفى

115
00:08:14,810 --> 00:08:17,340
.ما خطبك؟ سُحقًا لك

116
00:08:19,920 --> 00:08:21,170
.حان وقت الطّعام

117
00:08:25,360 --> 00:08:26,860
.هيّا بنا لنأكل

118
00:08:29,520 --> 00:08:31,240
مُخلّل دايكون مرّةً أُخرى؟

119
00:08:36,480 --> 00:08:39,160
،تناول طعامك أولًا
.الطّعام هو أساس الحياة

120
00:08:44,720 --> 00:08:46,960
.ولا تنسَ ضمّ يديك امتنانًا

121
00:08:56,200 --> 00:08:57,700
.أُريد أن أغدو قويًا

122
00:08:58,160 --> 00:08:59,410
.قويًا مثله

123
00:09:02,680 --> 00:09:04,720
.كان قويًا حقًا

124
00:09:05,290 --> 00:09:06,680
.لا يُمكن أن يكون ضعيفًا

125
00:09:08,830 --> 00:09:10,240
!علّمني كيفية استخدام السّيف

126
00:09:10,860 --> 00:09:11,440
.كلا

127
00:09:13,510 --> 00:09:15,730
.حسنًا، سأتعلّم بنفسي إذًا

128
00:09:22,370 --> 00:09:23,650
.أنا ذاهبٌ للسّباحة

129
00:09:35,150 --> 00:09:37,270
لا أستطيع استلاله، لماذا؟

130
00:09:43,520 --> 00:09:47,520
!عُد إلى هنا، أيّها اللّص

131
00:09:50,200 --> 00:09:51,420
.نعتذر إليك

132
00:09:53,180 --> 00:09:54,240
.لا تُكرّرها مرّةً أُخرى أبدًا

133
00:09:56,120 --> 00:09:56,770
.أجل، يا سيّدي

134
00:09:58,120 --> 00:09:59,580
.طال شعرك

135
00:10:02,080 --> 00:10:02,880
.حان موعد قصّه

136
00:10:02,880 --> 00:10:04,320
!يا للهول

137
00:10:08,640 --> 00:10:10,980
بدأ اللّون الأصليّ يعود
.إلى منابت الشّعر

138
00:10:16,800 --> 00:10:18,590
.سيّدي سايتو

139
00:10:18,970 --> 00:10:19,650
.سمك الأيو

140
00:10:23,730 --> 00:10:24,910
هل لديك عملٌ؟

141
00:10:25,690 --> 00:10:26,670
،أجل

142
00:10:27,520 --> 00:10:28,480
ماذا؟

143
00:10:33,640 --> 00:10:34,660
مُهمّة اغتيالٍ؟

144
00:10:35,650 --> 00:10:37,700
.زهقت رُوحًا وفررت مِن إيدو

145
00:10:38,390 --> 00:10:40,740
.لم أُنقذك إلّا بمحض الصّدفة

146
00:10:42,250 --> 00:10:44,140
.أنا لا أتقن شيئًا سوى القتل

147
00:10:47,170 --> 00:10:50,400
جيرو، يجب أن تمضي
.إلى مكانٍ آخر

148
00:10:51,560 --> 00:10:53,880
فلن تجني أيّ خيرٍ
.مِن بقائك بجانبي

149
00:10:57,800 --> 00:11:02,320
،لا أُريد أن أفقد أحدًا مرّةً أُخرى

150
00:11:05,950 --> 00:11:06,880
.لا أُريد ذلك أبدًا

151
00:11:17,920 --> 00:11:18,760
.طائر الزّرزور

152
00:11:19,110 --> 00:11:19,480
ماذا؟

153
00:11:20,650 --> 00:11:22,480
.هكذا يُحرّك الزّرزور ذيله

154
00:11:24,540 --> 00:11:26,150
أَتقصد حركة ذيله؟

155
00:11:26,420 --> 00:11:27,070
،كلا

156
00:11:28,850 --> 00:11:30,890
.إليك الطّريقة، استخدم الغِمد

157
00:11:31,480 --> 00:11:36,120
حرّك الغِمد بيدك اليُسرى في اللّحظة
.ذاتها الّتي ينسلّ فيها السّيف خارجًا

158
00:11:36,720 --> 00:11:37,420
.راقب بدقّةٍ

159
00:11:50,290 --> 00:11:52,560
.هكذا، هذه هي الحركة المطلوبة

160
00:11:53,190 --> 00:11:56,990
وكرّر الأمر ذاته حين تُعيد السّيف
.إلى غِمده، الزّرزور يُغرّد مرتين

161
00:11:57,740 --> 00:11:59,320
لكنّي أظنّك لا تزال غِرًا صغيرًا
.على استيعاب هذا

162
00:11:59,320 --> 00:12:00,620
،مثل الزّرزور

163
00:12:00,870 --> 00:12:03,020
.مثل الزّرزور، مثل الزّرزور

164
00:12:13,370 --> 00:12:15,040
.لا تستلّه إلّا في الفناء

165
00:12:18,740 --> 00:12:23,280
"كيف لي أن أغدو محاربًا مثله؟"
.كان هذا الهاجس الوحيد في ذهني

166
00:12:23,280 --> 00:12:24,680
،"كلا، ليس حرف "آه
."بل هذا حرف "نو

167
00:12:37,910 --> 00:12:38,860
،سأغدو قويًا

168
00:12:39,600 --> 00:12:41,600
.سأغدو ساموراي مثل ذلك العجوز

169
00:13:06,280 --> 00:13:07,570
لم يعد يفصلني عن النّهاية
.سوى القليل

170
00:13:15,260 --> 00:13:16,660
.أنا ذاهبٌ إلى العمل

171
00:13:16,880 --> 00:13:17,900
،اصحبني معك

172
00:13:18,190 --> 00:13:19,490
،صرت أكثر قوّةً

173
00:13:19,710 --> 00:13:20,560
.وبمقدوري أن أُعاونك

174
00:13:21,040 --> 00:13:22,250
.لا تتبعني

175
00:13:22,250 --> 00:13:23,360
لماذا؟

176
00:13:24,030 --> 00:13:26,310
.جيرو، أنت ضعيفٌ

177
00:13:35,080 --> 00:13:38,850
هل بمقدوره حقًا إنجاز العمل؟
.يبدو وكأنّه على وشك الانهيار

178
00:13:39,370 --> 00:13:41,360
.أخبرتك ألّا تتبعني

179
00:13:44,880 --> 00:13:47,510
لن أُغادر، سأُبرهن لك أنّ
...بمقدوري المُساعدة

180
00:13:47,510 --> 00:13:49,230
.لا أطلب منك المُغادرة

181
00:13:49,950 --> 00:13:50,840
.أمسك هذا

182
00:13:52,250 --> 00:13:55,220
.يبدو أنّ هذه المُهمّة كانت فخًا

183
00:13:55,800 --> 00:13:57,540
.تمّت مُحاصرتنا بالفعل

184
00:13:58,880 --> 00:14:00,970
!لا يُعقل
.إنّ عددهم كبير جدًا

185
00:14:01,230 --> 00:14:07,360
،سايتو هاجيمي، ذاع صِيتك أكثر مِن اللّازم
.ممّا جعل العثور عليك أمرًا سهلًا

186
00:14:08,160 --> 00:14:09,720
،إذًا، نجوت مِن الموت
أليس كذلك؟

187
00:14:10,250 --> 00:14:12,360
أنت مَن خلّفت هذه النُدوب
،على وجهي

188
00:14:12,370 --> 00:14:13,730
.والآن سأردّ الصّاع صاعين

189
00:14:14,000 --> 00:14:16,240
.جيرو، التزم جانبي

190
00:14:23,810 --> 00:14:25,460
.أروني ما عندكم أيّها الحُثالة

191
00:14:25,680 --> 00:14:26,920
!هيّا انقضّوا عليه

192
00:14:29,600 --> 00:14:31,510
!استهدفوا الصّغير أولًا

193
00:14:32,980 --> 00:14:34,430
.أنا أكثر صلابةً ممّا تظنّون

194
00:14:34,630 --> 00:14:35,560
!مُت

195
00:14:36,360 --> 00:14:37,280
.سُحقًا

196
00:14:39,600 --> 00:14:41,850
.لن أدعكم تمسّون شعرةً منه

197
00:14:43,000 --> 00:14:43,930
.أيّها العجوز

198
00:14:48,650 --> 00:14:51,410
!أيّها المسخ اللّعين

199
00:14:53,020 --> 00:14:55,200
ألا تُريد التوقّف؟

200
00:14:55,710 --> 00:14:59,830
،نجوت بأعجوبةٍ في المرّة السابقة
فلماذا تُهدر حياتك الآن؟

201
00:15:05,830 --> 00:15:07,200
.أ-أخي

202
00:15:08,720 --> 00:15:09,600
.جرحٌ طفيف

203
00:15:09,790 --> 00:15:13,350
!صرعت سايتو هاجيمي

204
00:15:13,730 --> 00:15:15,460
!أيّها العجوز، أيّها العجوز

205
00:15:16,210 --> 00:15:17,100
!كفى

206
00:15:17,100 --> 00:15:19,550
!تراجعوا، انسحبوا

207
00:15:22,240 --> 00:15:25,280
لماذا لم تستلّ سيفك أيّها الأحمق؟

208
00:15:26,040 --> 00:15:28,000
.تمسّك بالحياة حتّى نبلغ الطّبيب

209
00:15:28,460 --> 00:15:29,520
،لا جدوى

210
00:15:29,800 --> 00:15:32,960
لم يكن مُقدرًا لي البقاء في هذا
.العالم طويلًا على أيّة حال

211
00:15:33,310 --> 00:15:34,860
عمّا تتحدّث؟

212
00:15:35,440 --> 00:15:38,540
،دَعك منّي
.امضِ إلى ميبو

213
00:15:39,120 --> 00:15:41,070
ميبو؟ ولمَ؟

214
00:15:41,070 --> 00:15:42,500
.دُون نقاشٍ، اذهب فحسب

215
00:15:48,300 --> 00:15:49,350
،سايتو-سان

216
00:15:50,180 --> 00:15:51,100
ماذا دهاك؟

217
00:15:51,550 --> 00:15:53,720
.كوندو-كون، جئت في وقتك

218
00:15:54,210 --> 00:15:56,500
!أنقذه، إنّه سيموت

219
00:15:57,530 --> 00:16:00,320
،أخبرني يا كوندو-كون

220
00:16:01,080 --> 00:16:03,930
ما الّذي جاء بكُم وبرجالكم
إلى كيوتو؟

221
00:16:05,640 --> 00:16:06,800
.لنُصرة الحقّ ودفع الظّلم

222
00:16:11,700 --> 00:16:12,520
!أيّها العجوز

223
00:16:12,750 --> 00:16:13,980
!كُفّ عن الكلام

224
00:16:13,980 --> 00:16:14,770
.أنصت

225
00:16:15,740 --> 00:16:17,170
.لن أموت

226
00:16:17,880 --> 00:16:20,680
.ليس قبل أن أستودعك أمانةً لديه

227
00:16:22,080 --> 00:16:23,220
.هذا ابني

228
00:16:24,230 --> 00:16:30,040
أدركت أنّ النّاس يغدون أقوياء حين
.يُعلّقون قُلوبهم بما هو أسمى مِن ذواتهم

229
00:16:30,320 --> 00:16:32,280
وإن كان فهم هذا قد
.كلّفني عُمرًا طويلًا

230
00:16:33,540 --> 00:16:37,440
لن أموت ما دُمت أنت
.على قيد الحياة

231
00:16:38,480 --> 00:16:41,000
.جيرو، كُن قويًا

232
00:16:47,190 --> 00:16:48,190
.سأتولّى أمره

233
00:16:55,360 --> 00:16:56,880
سيُوارى جسدك الثّرى
.إلى جانب أبويك إذًا

234
00:16:58,140 --> 00:16:59,750
يا فتى، ما اسمك؟

235
00:17:01,320 --> 00:17:02,160
.هاجيمي

236
00:17:04,320 --> 00:17:05,980
.أنا سايتو هاجيمي

237
00:17:06,880 --> 00:17:08,260
،العجوز ليس ضعيفًا

238
00:17:09,610 --> 00:17:11,240
.وسأُثبت ذلك

239
00:17:11,780 --> 00:17:15,220
.سأحمل سيفه وأُكمل مسيرته

240
00:17:16,810 --> 00:17:19,440
.بمقدورك أن تغدو ذئبًا

241
00:17:27,560 --> 00:17:31,940
.أنا سايتو هاجيمي الثّاني

242
00:17:32,450 --> 00:17:34,700
،لا يُعقل
.كان ذلك سمًا قاتلًا

243
00:17:34,950 --> 00:17:36,790
،إنّه ليس ضعيفًا

244
00:17:37,170 --> 00:17:38,340
،ولن يموت

245
00:17:38,960 --> 00:17:41,710
.ما دُمت على قيد الحياة

246
00:17:42,680 --> 00:17:44,080
.فارق العجوز الحياة

247
00:17:44,640 --> 00:17:47,960
،خاض نزاله الأخير وهو مثقلٌ بالمرض

248
00:17:48,560 --> 00:17:50,270
هل لأنّه كان ضعيفًا؟

249
00:17:51,680 --> 00:17:55,720
كلا، فقد أقرّ بأنّ بلوغ هذا الإدراك
.قد كلّفه عُمرًا طويلًا

250
00:17:56,530 --> 00:17:59,550
،لطالما وصف نفسه بالضّعف

251
00:18:00,320 --> 00:18:03,440
.لكنّه في ذلك اليوم كان مُختلفًا

252
00:18:04,370 --> 00:18:05,730
.أكاد أُجزم أنّ وجودي هو السّبب

253
00:18:06,780 --> 00:18:11,600
فلم يكن يرغب في أن أراه وهو
.يسفك الدّماء، لذلك لم يستلّ سيفه

254
00:18:12,660 --> 00:18:19,090
لعلّه أدرك معنى القوّة في تلك اللّحظة
.لأنّه بات يملك غايةً أسمى لحمايتها

255
00:18:21,040 --> 00:18:22,830
،إن تركت هذا الرّجل يمضي
.فسيكون الثّمن أرواحًا بريئة

256
00:18:24,650 --> 00:18:29,170
لم يكن لديّ سببٌ لمدّ يد العون
.للغُرباء، أو هكذا خُيّل إليّ

257
00:18:29,960 --> 00:18:37,280
لكن، لا يستقرّ المرء في أرضٍ دُون
.أن يتسلّل حُبّها إلى نفسه، ولو بقدرٍ ضئيل

258
00:18:38,660 --> 00:18:39,300
...لذا

259
00:18:42,150 --> 00:18:43,690
.لا مجال للخسارة

260
00:18:45,200 --> 00:18:47,600
،لن تقوى على تنفيذ ضربة الإياي

261
00:18:48,100 --> 00:18:51,770
فما هي إلًا لحظاتٌ حتّى
.يغشى عليك وتُفارق الحياة

262
00:18:52,440 --> 00:18:54,200
.جسدك لا يملك القوّة لفعل ذلك

263
00:18:55,600 --> 00:18:58,470
،الإياي ليس مُنوطًا بالقوّة
.بل هو مهارةٌ

264
00:18:59,600 --> 00:19:01,200
.مثل ذيل طائر الزّرزور

265
00:19:02,240 --> 00:19:05,120
،نفّذتها كما علّمني آلاف المرّات
.كلا بل مرارًا وتكرارًا تزيد على عشرات الآلاف

266
00:19:05,710 --> 00:19:07,580
.حتّى نُقشت في عُمق جسدي

267
00:19:08,510 --> 00:19:11,480
.ولا سبب يدعوني للشكّ فيها الآن

268
00:19:14,920 --> 00:19:16,300
.وكأنّي سأدعك تُحاول

269
00:19:16,300 --> 00:19:17,390
ماذا تنتظر؟

270
00:19:17,390 --> 00:19:17,810
ماذا؟

271
00:19:18,010 --> 00:19:18,960
!انقضّ عليه

272
00:19:23,540 --> 00:19:26,070
.سأسحقك

273
00:19:26,390 --> 00:19:29,900
!لن تستطيع، هذا محالٌ

274
00:19:33,470 --> 00:19:35,530
،قُضي عليّ
.لا أقوى على التحرّك

275
00:19:44,770 --> 00:19:45,480
.اغرب عن وجهي

276
00:19:53,720 --> 00:19:54,680
.جيّدٌ، وجدته

277
00:19:55,060 --> 00:19:56,840
،هذا هو التّرياق
.كما آمل

278
00:20:00,520 --> 00:20:01,110
.اشرب

279
00:20:05,120 --> 00:20:07,880
.أنا آسفٌ، أفسدت نزالك

280
00:20:10,150 --> 00:20:12,080
.كلا، بل أنا مدينٌ لك

281
00:20:13,060 --> 00:20:15,230
،أخفقت
.فلم أكن أتوقّع وجود سمّ

282
00:20:16,100 --> 00:20:17,790
ليست هذه ردّة الفعل
.الّتي عهدتها منك

283
00:20:19,360 --> 00:20:20,720
.اصمت

284
00:20:21,330 --> 00:20:23,860
لا بأس، فما زال أمامي
.دربٌ طويل لأبلغه

285
00:20:25,400 --> 00:20:30,390
،أنا ضعيفٌ
.ناقصٌ في رجاحة العقل وقوّة البدن

286
00:20:31,600 --> 00:20:34,540
،أيّها العجوز، أدركت ذلك الآن

287
00:20:35,380 --> 00:20:36,620
فهل ستضحك عليّ؟

288
00:20:37,100 --> 00:20:40,880
،كُلّ البشر ضُعفاء
...إنّما العِبرة في

289
00:20:42,660 --> 00:20:47,340
،يا تُرى
ماذا كان سيقول بعد ذلك؟

290
00:20:50,880 --> 00:20:54,800
أشعر أنّني خطوت الخُطوة
.الأولى على الدّرب أخيرًا

291
00:21:00,380 --> 00:21:03,120
،أنا على يقينٍ أنّ لك دوافعك

292
00:21:03,630 --> 00:21:05,600
،والجميع كذلك
.هذه هي سُنّة الحياة

293
00:21:06,950 --> 00:21:10,920
لكن، لا تُحمّل الآخرين
.تبعات ما تمرّ به

294
00:21:14,160 --> 00:21:15,960
.المدينة لم تلتهمها النّيران

295
00:21:16,600 --> 00:21:18,300
.كنت أنت مَن حال دُون ذلك

296
00:21:22,940 --> 00:21:24,050
.يا لها مِن سُخرية

297
00:21:24,600 --> 00:21:25,680
.نل قسطًا مّن الرّاحة

298
00:21:28,500 --> 00:21:31,070
...أُسند بقيّة المُهمّة إليك

299
00:21:31,310 --> 00:21:33,810
مدرسة كيوهاتشي

300
00:21:32,090 --> 00:21:32,650
.يا نيو

301
00:21:34,260 --> 00:21:37,660
راودني شعورٌ بأنّكم ستقصدون
.هذا المكان

302
00:21:44,940 --> 00:21:49,950
الخَلَف

303
00:23:20,080 --> 00:23:25,460
الحلقة القادمة

304
00:23:21,960 --> 00:23:23,710
مدرسة كيوهاتشي

305
00:23:24,630 --> 00:23:25,720
.تشيرينو نيو يُحدّثكم

306
00:23:26,480 --> 00:23:29,920
أعلم أنّ ناغي-سان حُبلى، لذا سارعت
.إلى مدرسة كيوهاتشي للاطمئنان عليها

307
00:23:30,990 --> 00:23:33,460
لكن لماذا أنت هنا يا يوتارو-سان؟

308
00:23:34,560 --> 00:23:36,810
.كان يجدر بك أن تكون إلى جانبها

309
00:23:38,330 --> 00:23:40,120
،وأنت يا كوندو-سان
.أرجوك اهدأ

310
00:23:40,120 --> 00:23:43,640
.أتوسّل إليكما، لا تستلّا سُيوفكما

311
00:23:45,040 --> 00:23:47,120
:الحلقة القادمة
."مستعدٌّ لما هو آتٍ"

312
00:23:47,110 --> 00:23:49,950
مستعدٌّ
لما

313
00:23:47,110 --> 00:23:49,950
هو
آتٍ