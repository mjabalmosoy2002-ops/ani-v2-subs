1
00:00:00,520 --> 00:00:05,990
وهكذا، غدونا نحن المِيبورو
.حُماةً لمقاطعة آيزو

2
00:00:06,130 --> 00:00:08,680
،يا للرّوعة
!كان رجال الشّينسينغومي أشدّاء حقًا

3
00:00:08,680 --> 00:00:10,770
!فما تركتم شرّيرًا إلّا وقبضتم عليه

4
00:00:11,140 --> 00:00:12,850
...ناغاكورا-سينسي

5
00:00:14,160 --> 00:00:15,670
ماذا يا تسورو؟

6
00:00:15,670 --> 00:00:19,120
مَن كان الاشدّ بأسًا بين
رجال الشّينسينغومي؟

7
00:00:19,320 --> 00:00:21,930
الأشدّ بأسًا؟

8
00:00:24,150 --> 00:00:25,870
...هذا يُعيدني بالذّاكرة للوراء

9
00:00:28,790 --> 00:00:31,390
مَن منّا الاشدّ بأسًا حقًا؟

10
00:00:32,000 --> 00:00:34,410
،وحين ينقشع غُبار المعارك
مَن الّذي سيبقى راسخًا في ميدانه؟

11
00:00:35,110 --> 00:00:39,080
سنعرف ذلك في أوّل نزالٍ كبير
!للمِيبورو في شُرب السّاكي

12
00:00:53,240 --> 00:00:58,950
ذئاب ميبو الزّرق

13
00:02:15,190 --> 00:02:18,820
!الوقت متأخّرٌ، اخفضوا أصواتكم

14
00:02:20,690 --> 00:02:25,760
أهدتنا عائلة ياجي السّاكي
،احتفالًا بمقامنا الجديد

15
00:02:26,630 --> 00:02:28,980
لكن الحفلة ما لبثت أن
.تحوّلت إلى صخبٍ وضجيج

16
00:02:29,870 --> 00:02:32,240
والآن، سيُنهي سيريزاوا-سينسي
.مَجلسنا هذا

17
00:02:32,240 --> 00:02:32,960
.حسنًا

18
00:02:36,000 --> 00:02:36,630
.حسنًا

19
00:02:39,030 --> 00:02:41,220
—نخب راعينا الجديد العظيم

20
00:02:43,570 --> 00:02:45,100
كوندو-سان؟

21
00:02:45,310 --> 00:02:47,180
مَن سيكون آخر رجلٍ
يقف على قدميه؟

22
00:02:47,180 --> 00:02:48,040
!أنا

23
00:02:48,040 --> 00:02:49,860
!سأكون أنا ذلك الرّجل

24
00:02:50,450 --> 00:02:52,360
إنّه لا يملك أيّ قُدرةٍ
!على التحمّل إطلاقًا

25
00:02:52,360 --> 00:02:54,110
لماذا لم تُوقفوه؟

26
00:02:57,480 --> 00:02:59,790
.أَلقوا بالجُثث جانبًا

27
00:03:01,520 --> 00:03:02,960
!أمّا الآن، حان وقت المرح

28
00:03:02,960 --> 00:03:04,320
!اشربوا حتّى الثّمالة

29
00:03:06,750 --> 00:03:09,460
.لطالما كان والدي مرحًا حين يثمل

30
00:03:10,550 --> 00:03:11,570
.هكذا إذن

31
00:03:11,570 --> 00:03:13,040
.انظر يا نيو

32
00:03:13,220 --> 00:03:16,220
.هذه ندبة سيبّوكو

33
00:03:16,220 --> 00:03:17,710
إنّها مُهيبة، أليس كذلك؟

34
00:03:17,710 --> 00:03:19,800
!لماذا تجرّدت مِن ثيابك؟

35
00:03:19,800 --> 00:03:22,300
.يا له مِن شرابٍ زهيد الثّمن

36
00:03:22,300 --> 00:03:24,450
،لا يهمّ
!ما دام سيُذهب عُقولنا فهذا يكفي

37
00:03:24,450 --> 00:03:25,550
!سمعتني جيدًا

38
00:03:25,740 --> 00:03:27,160
!أَهذا يكفيك؟

39
00:03:27,160 --> 00:03:29,680
،أنا أسألك
!هل أنت مستعدٌ للموت؟

40
00:03:29,680 --> 00:03:30,910
!هيّا، أجب

41
00:03:30,910 --> 00:03:34,170
،يامانامي-سان
!ما بالك تصرخ بوجه ذلك الجدار؟

42
00:03:34,180 --> 00:03:36,400
!لم أُهزم بعد

43
00:03:36,640 --> 00:03:38,370
.اصمد قليلًا

44
00:03:41,600 --> 00:03:42,580
.ضاع وقتنا سُدىً

45
00:03:47,760 --> 00:03:49,460
!أَثمل لمُجرّد استنشاق رائحة الشّراب؟

46
00:04:01,470 --> 00:04:02,760
.أشرف الاحتفال على الانتهاء

47
00:04:03,360 --> 00:04:04,880
.أرجو ألّا ينهض أحدٌ منهم ثانيةً

48
00:04:05,960 --> 00:04:07,020
.صارت الآن مواجهةً ثنائيّة

49
00:04:07,580 --> 00:04:10,450
!هيجيكاتا-سان في مواجهة سيريزاوا-سان

50
00:04:12,160 --> 00:04:12,900
.تفضّل، سيّدي

51
00:04:17,760 --> 00:04:23,350
هيجيكاتا، لعلّ علينا الجُلوس
.لنتحاور رجلًا لرجلٍ

52
00:04:23,550 --> 00:04:24,420
حقًا؟

53
00:04:25,640 --> 00:04:28,160
وعمّا سنتحاور إذن؟

54
00:04:28,500 --> 00:04:30,190
.مُستقبل المِيبورو

55
00:04:32,920 --> 00:04:35,600
!ماذا تقصد بذلك؟

56
00:04:36,570 --> 00:04:43,320
يبدو أنّك لا تنظر بعين الرّضا
.أن نكون تحت إمرة آيزو

57
00:04:45,360 --> 00:04:46,520
.لا يمسّني ضيقٌ مِن ذلك

58
00:04:46,820 --> 00:04:50,060
كُلّ ما في الأمر أنّي أتساءل
.إن كان هذا ضروريًا

59
00:04:50,320 --> 00:04:52,960
.نحن بحاجةٍ إلى راعٍ يكفلنا

60
00:04:53,520 --> 00:04:54,320
لماذا؟

61
00:04:54,770 --> 00:04:58,070
ليتسنّى لنا التصرّف بجموحٍ
.بعيدًا عن القُيود

62
00:05:00,720 --> 00:05:01,780
.سيريزاوا-سان

63
00:05:02,360 --> 00:05:07,200
لم نأتِ إلى هنا لنستعرض قُوّتنا
.تملّقًا لمصالحنا الشخصيّة

64
00:05:07,200 --> 00:05:09,200
!ماذا؟

65
00:05:09,490 --> 00:05:12,470
!وُلدت لأفرض سطوتي وأستعرض قُوّتي

66
00:05:12,470 --> 00:05:14,280
أَلست مثلي؟

67
00:05:15,530 --> 00:05:17,500
!ما الّذي يدفعك للتصرّف بهذه الطّريقة؟

68
00:05:19,320 --> 00:05:21,090
!أَتريد أن تعرف حقًا؟

69
00:05:26,930 --> 00:05:28,300
!سُلحفاتي هي السّبب

70
00:05:28,700 --> 00:05:29,380
ماذا؟

71
00:05:30,360 --> 00:05:34,590
سحق أخي الأكبر سُلحفاتي
.حتّى الموت

72
00:05:34,590 --> 00:05:36,400
ماذا؟ ما السّبب؟

73
00:05:36,400 --> 00:05:38,370
وما أَدراني؟

74
00:05:39,110 --> 00:05:43,650
لقّنته درسًا لن ينساه، أوسعته ضربًا
.حتّى فقد وعيه! كان عليك رؤية ذلك

75
00:05:43,650 --> 00:05:48,820
.تورّم وجهه ليُصبح ضعف حجمه

76
00:05:49,330 --> 00:05:52,480
.حسنًا، لا يُمكنني لَومك

77
00:05:52,740 --> 00:05:55,080
أنا أُدرك تمامًا كيف كان
.شُعورك حينها يا سيّدي

78
00:05:57,200 --> 00:06:02,040
،حُبست في غرفتي بلا طعامٍ لثلاثة أيّام
!بينما لم يَنل هو أيّ عقابٍ

79
00:06:02,670 --> 00:06:04,440
.فقد كُنت الابن الرّابع كما تعلم

80
00:06:05,970 --> 00:06:10,670
قُلت لنفسي هذا خطأٌ
.ولا يقبله عقلٌ

81
00:06:11,400 --> 00:06:17,320
،وبما أنّ القوّة بيدي
.فقد آثرت أن آخذ كُلّ شيءٍ

82
00:06:18,090 --> 00:06:22,180
!أريد النّساء الفاتنات
!وأن أُشيّد قصرًا

83
00:06:22,750 --> 00:06:25,120
!وأن تكون لي سيادةٌ مطلقة

84
00:06:27,190 --> 00:06:29,730
أَيبدو هذا ضربًا من الجُنون؟

85
00:06:30,750 --> 00:06:31,410
.كلا

86
00:06:33,400 --> 00:06:37,470
،بخُصوص القصر
هل يهمّك مكان بنائه؟

87
00:06:37,750 --> 00:06:40,590
ما الّذي ترمي إليه؟

88
00:06:40,960 --> 00:06:45,350
،سأبني قصري في هينو
.بين أحضان الرّيف خارج إيدو

89
00:06:47,360 --> 00:06:50,820
،كان مسقط رأسي في تاما
.التّابعة للشّوغون مُباشرةً

90
00:06:51,560 --> 00:06:55,540
،صحيحٌ أنّنا لم ننعم برغد العيش
.لكنّنا لم نَشك ضيقًا

91
00:06:56,160 --> 00:06:56,880
.أفهم ذلك

92
00:06:57,550 --> 00:07:00,020
إنّي أستشعر تمامًا
.ذلك الحنين إلى الدّيار

93
00:07:00,020 --> 00:07:01,230
!مثيرٌ للشّفقة

94
00:07:01,610 --> 00:07:04,330
.حرّرني رحيلي عن مسقط رأسي

95
00:07:04,720 --> 00:07:06,860
.أنا لا أدين له بشيءٍ أبدًا

96
00:07:07,810 --> 00:07:10,120
لا تسمح للمكان الّذي
.وُلدت فيه أن يُقيّدك

97
00:07:10,540 --> 00:07:14,140
!ناضل حيثما حللت

98
00:07:14,440 --> 00:07:17,330
"!وأَسمع العالم صيحتك: "ها أنا ذا

99
00:07:17,610 --> 00:07:22,620
.فهذا هُو جوهر الرّجولة

100
00:07:23,010 --> 00:07:25,440
ألست مُحقًا يا نيو؟

101
00:07:30,830 --> 00:07:32,070
...في الواقع

102
00:07:32,310 --> 00:07:36,540
كُلّ ما أُريده هو حماية
.هذه المدينة الّتي نشأت فيها

103
00:07:37,400 --> 00:07:39,590
!أَتريد حماية المدينة؟

104
00:07:39,590 --> 00:07:41,930
!وكأنّ بمقدور فردٍ واحد فعل ذلك

105
00:07:41,930 --> 00:07:43,300
!لا تكن مغرورًا

106
00:07:44,810 --> 00:07:48,270
.فأنت لا تملك أيّ فكرةٍ عمّا تقول

107
00:07:48,720 --> 00:07:50,030
.سأخلد إلى النوم

108
00:07:55,370 --> 00:07:57,400
".إنّه يقصد: "أَطلق العنان لتفكيرك

109
00:07:58,360 --> 00:08:01,500
،نُدرك مدى حُبّك لهذه المدينة

110
00:08:02,230 --> 00:08:04,920
ولكن ماذا لو أنّك نُفيت بعيدًا عنها؟

111
00:08:05,390 --> 00:08:06,680
أَتموت حسرةً؟

112
00:08:08,620 --> 00:08:11,890
أعتقد أنّ هذا ما أراد
.سيريزاوا قوله

113
00:08:13,340 --> 00:08:14,600
.عمومًا، فكّر في الأمر مليًا

114
00:08:15,460 --> 00:08:16,920
.أنا سأخلد إلى النّوم أيضًا

115
00:08:24,520 --> 00:08:29,110
تُرى ما مصيري لو غادرت كيوتو؟
.ليس لديّ أيّ فكرةٍ

116
00:08:30,720 --> 00:08:33,030
،أخيرًا
هل غطّوا في النّوم جميعًا؟

117
00:08:33,400 --> 00:08:35,280
.لم يبقَ على بُزوغ الفجر إلّا القليل

118
00:08:35,880 --> 00:08:37,840
هل تُحبّ هذه المدينة يا تارو-كون؟

119
00:08:37,840 --> 00:08:41,410
وما الّذي يدعوني لحُبّها؟! هل تعلم كم
!مرّةً كدت أن ألقى حتفي في أرجائها؟

120
00:08:41,410 --> 00:08:42,640
.أجل، تمامًا

121
00:08:43,520 --> 00:08:46,230
ما سبب حُبّي لهذه المدينة؟

122
00:08:47,620 --> 00:08:49,920
.الجدّة، إيروها

123
00:08:50,490 --> 00:08:53,170
،أشعر بشوقٍ عارم إليكما الآن
.ولا أعلم السّبب

124
00:08:56,920 --> 00:08:59,170
!ثمّة شخصٌ ما لا يزال مُستيقظًا

125
00:09:01,180 --> 00:09:02,320
!إنوي-سان

126
00:09:02,640 --> 00:09:05,620
.أنا... المُنتصر

127
00:09:07,000 --> 00:09:11,940
كان النّصر حليف إنوي غينزابورو
.في منافسة الشّرب الكُبرى

128
00:09:12,190 --> 00:09:15,480
إلّا أنّ صفحات التّاريخ
.لم تُدوّن له ذِكرًا

129
00:09:19,640 --> 00:09:22,040
،يا له مِن يومٍ ساكن
أليس كذلك؟

130
00:09:22,280 --> 00:09:24,200
.لعلّ هذا الهُدوء هو غاية ما نتمنّاه

131
00:09:24,200 --> 00:09:25,960
—أُدرك هذا، ولكن

132
00:09:26,490 --> 00:09:27,120
.مهلًا

133
00:09:29,840 --> 00:09:33,420
أليس هذا دُكّان الدّانغو
الخاصّ بجدّتك يا نيو-كون؟

134
00:09:33,420 --> 00:09:34,090
.بالفعل

135
00:09:34,680 --> 00:09:37,380
لا عجب أنّه مغلقٌ في
.مثل هذا الوقت المُتأخّر

136
00:09:44,230 --> 00:09:45,200
.هيّا بنا يا نيو

137
00:09:45,600 --> 00:09:46,870
.أ-أجل سيّدي

138
00:09:48,330 --> 00:09:50,760
.تملّكني الجُوع للدّانغو فجأةً

139
00:09:52,360 --> 00:09:54,440
.لنُصمّم رايةً للمِيبورو

140
00:09:56,510 --> 00:09:57,710
كيف خطرت لك هذه الفكرة؟

141
00:09:58,030 --> 00:10:00,140
.لكنّها قد تكون فكرةً سديدة

142
00:10:00,140 --> 00:10:04,200
رُؤية الرّاية العسكريّة كفيلةٌ بأن
.تردع كُلّ مَن تُسوّل له نفسه العبث

143
00:10:04,540 --> 00:10:06,110
.بل ستكون مهيبةً جدًا

144
00:10:06,610 --> 00:10:09,710
كُنت دائمًا مُعجبًا برجال الرّونين
.السّبعة والأربعين مِن أكو

145
00:10:11,020 --> 00:10:12,200
رايةٌ؟

146
00:10:12,480 --> 00:10:16,870
أظنّ أنّه سيكون أمرًا رائعًا لو ارتدينا
.جميعًا معاطف مُوحّدة أيضًا

147
00:10:17,170 --> 00:10:18,350
!أجل، هذه هي الفكرة

148
00:10:20,560 --> 00:10:21,950
أيّ نوعٍ من المعاطف نُريد؟

149
00:10:21,950 --> 00:10:23,680
.لا بُدّ أن يكون أنيقًا وجذابًا

150
00:10:23,680 --> 00:10:25,270
—كلا، لنبدأ بالرّاية أولًا

151
00:10:25,270 --> 00:10:26,000
.مهلًا

152
00:10:27,540 --> 00:10:30,980
،ثمّة بائعة دانغو مسنّةٌ أعرفها
.لديها ذوقٌ رفيع في اختيار الثّياب الفاخرة

153
00:10:32,460 --> 00:10:35,320
،تقصد جدّة نيو-كون
أليس كذلك؟

154
00:10:35,830 --> 00:10:38,120
.إنّها الشخص المثاليّ لهذه المُهمّة

155
00:10:38,470 --> 00:10:39,530
.هيجيكاتا-سان

156
00:10:43,190 --> 00:10:44,990
عمّ تتحدّثون؟

157
00:10:45,260 --> 00:10:46,390
.سيريزاوا-سان

158
00:10:46,880 --> 00:10:50,720
كُنّا نتبادل الآراء حول توحيد
.المعاطف لتكون زيًا رسميًا لنا

159
00:10:51,000 --> 00:10:52,280
زيٌّ رسمي؟

160
00:10:52,280 --> 00:10:53,200
.ورايةٌ أيضًا

161
00:10:53,670 --> 00:10:55,710
أَتسمحون لي بتولّي هذه المُهمّة؟

162
00:10:57,580 --> 00:10:58,870
.اجعلوه بلونٍ سماويّ مُخضرٍ باهت

163
00:10:58,870 --> 00:11:03,560
كان إينوي-سان هُو البطل المُتوّج
.في منافسة الشّرب الكُبرى

164
00:11:04,990 --> 00:11:06,960
!هذه خدعةٌ دنيئة

165
00:11:06,960 --> 00:11:09,880
ما علاقة ذلك بما نحن فيه الآن؟

166
00:11:09,880 --> 00:11:11,180
.حسنًا، لا بأس

167
00:11:11,840 --> 00:11:16,320
لكن احرصوا على أن يكون
.معطفي بارزًا عن سائر الرّفاق

168
00:11:18,540 --> 00:11:20,120
.نيو، انطلق الآن

169
00:11:20,120 --> 00:11:20,820
!أجل، سيّدي

170
00:11:21,650 --> 00:11:23,640
.تارو، رافقه

171
00:11:23,640 --> 00:11:24,820
.أ-أجل، سيّدي

172
00:11:25,120 --> 00:11:26,790
.وأنت أيضًا يا هاجيمي

173
00:11:26,790 --> 00:11:27,750
!ما الغرض مِن ذلك؟

174
00:11:27,750 --> 00:11:30,320
،فكرةٌ جيّدة
.أرسلوا فرقة الصّبية بكاملها

175
00:11:30,320 --> 00:11:33,080
!كُفّوا عن معاملتي كأنّني طفلٌ

176
00:11:34,240 --> 00:11:35,470
!ثلاث قطعٍ مُحلّاة

177
00:11:35,470 --> 00:11:36,580
!لك ما أَردت

178
00:11:36,890 --> 00:11:41,380
أيّتها السيّدة، أين حساء الزّنزاي
...الخاصّ بي؟ انتظرت نصف ساعةٍ

179
00:11:41,560 --> 00:11:42,640
.اخفض صوتك

180
00:11:42,640 --> 00:11:45,360
،كُفّ عن التذمّر ومُد لنا يد العون
ما رأيك؟

181
00:11:45,360 --> 00:11:46,390
!جدّتي

182
00:11:46,590 --> 00:11:48,760
!مرحبًا، لقد عُدت

183
00:11:54,640 --> 00:11:55,520
...ما لم أَكن مُخطئةً

184
00:11:55,830 --> 00:11:56,480
!جدّتي

185
00:11:57,450 --> 00:11:58,570
مَن تكون؟

186
00:11:58,570 --> 00:12:00,010
!أنا، نيو يا جدّتي

187
00:12:00,010 --> 00:12:02,350
!هل نَسيتني؟
!هل أصابكِ الخرف يا جدّتي؟

188
00:12:02,610 --> 00:12:06,370
!مَن الّتي أصابها الخرف؟
.أنا أُميّزك تمامًا يا نيو

189
00:12:06,580 --> 00:12:08,940
...لكن عينيك

190
00:12:09,440 --> 00:12:10,120
!لحظةً

191
00:12:10,600 --> 00:12:11,420
مَن هذان الّلذان معك؟

192
00:12:11,420 --> 00:12:14,080
،إنّهما تارو-كون وهاجيمي-كون
.كليهما مِن المِيبورو

193
00:12:18,960 --> 00:12:21,240
!حصلت على مُعاونين جُددٍ

194
00:12:21,240 --> 00:12:22,080
ماذا؟

195
00:12:22,960 --> 00:12:26,790
.أ-أهلًا بكُم في دُكّان تشيرينويا

196
00:12:26,790 --> 00:12:28,740
.تكلّم بصوتٍ أعلى يا هاجيمي

197
00:12:28,740 --> 00:12:31,760
!أنا ساموراي
!لا يُعقل أن أفعل أمورًا كهذه

198
00:12:31,990 --> 00:12:33,760
وما شأن كونك ساموراي بهذا؟

199
00:12:34,270 --> 00:12:36,390
.راقبه فحسب

200
00:12:36,580 --> 00:12:39,560
طلبيّةٌ أخرى مِن الدّانغو؟
.قادمٌ حالًا

201
00:12:39,940 --> 00:12:40,680
.شكرًا لك

202
00:12:40,990 --> 00:12:42,280
!لا شُكر على واجبٍ

203
00:12:42,280 --> 00:12:44,540
.الحساب ستّون مُون

204
00:12:44,920 --> 00:12:47,780
،أحسنت يا تارو
.أثبتّ أنّك ذكيٌ

205
00:12:47,950 --> 00:12:50,290
!هذا العمل مُسلّ بعض الشّيء

206
00:12:50,520 --> 00:12:52,510
،حسنًا، سأفعل ذلك
هل أنتِ راضيةٌ الآن؟

207
00:12:52,510 --> 00:12:54,420
—معذرةً، أُريد بعض الدّانغو

208
00:12:54,420 --> 00:12:57,170
تُريد دانغو؟ إيّاك وأن تترك
.قطعةً واحدة دُون أن تلتهمها

209
00:12:57,170 --> 00:12:58,800
لِم تُهدّد الزّبون؟

210
00:12:59,120 --> 00:13:00,800
.تعلّم مِن تارو

211
00:13:02,000 --> 00:13:04,240
!هذا هو المكان الّذي أنتمي إليه حقًا

212
00:13:04,830 --> 00:13:06,000
.شكرًا لكم

213
00:13:06,000 --> 00:13:07,540
!لا داعي للشّكر

214
00:13:07,840 --> 00:13:10,060
.حسنًا، وقت الإغلاق قد حان

215
00:13:10,360 --> 00:13:12,080
.هلكت مِن التّعب

216
00:13:12,380 --> 00:13:13,430
.شكرًا لك على المُساعدة

217
00:13:13,430 --> 00:13:16,190
يبدو أنّ هذا المجال
.يُناسبك تمامًا يا تارو

218
00:13:16,380 --> 00:13:18,690
،لا يُمكنني التوقّف عن البكاء
.ولست أدري ما السّبب

219
00:13:19,690 --> 00:13:21,100
.والآن، باشروا التّنظيف

220
00:13:21,840 --> 00:13:23,360
.وافعلوا ذلك بسرعةٍ

221
00:13:23,360 --> 00:13:24,120
!طوع أمركِ يا سيّدتي

222
00:13:29,040 --> 00:13:30,910
.سُحقًا

223
00:13:29,910 --> 00:13:33,530
.بدت الجدّة لي أقصر طُولًا عمّا أذكر

224
00:13:34,120 --> 00:13:35,040
.يا لها مِن عجوزٍ قويّة

225
00:13:35,250 --> 00:13:37,050
ماذا؟ أَتقصد جدّتي؟

226
00:13:37,390 --> 00:13:40,290
،أجل
.أعتقد أنّها خبيرةٌ في مهنتها

227
00:13:41,070 --> 00:13:44,770
ليس من السهل على أيّ سيّدةٍ
.مُسنّةٍ أن تُدير هذا الدُكّان وحدها

228
00:13:45,130 --> 00:13:47,200
.فمساحة المكان شاسعةٌ

229
00:13:47,480 --> 00:13:49,190
.أجل، معك حقٌّ في ذلك

230
00:13:49,580 --> 00:13:50,900
،تلك هي الصّلابة الحقيقية

231
00:13:51,310 --> 00:13:54,560
يبدو أنّ القوّة لا تنحصر
.في حمل السّيف فقط

232
00:13:55,220 --> 00:13:58,250
إنّها تُجاهد في عملها لتحمي مصدر
.رزقها يومًا بعد يومٍ دُون شكوى

233
00:13:58,960 --> 00:14:00,560
.إنّه أمرٌ يعجز عنه أمثالي

234
00:14:03,470 --> 00:14:07,260
سمعت أنّ هذا الدّكان
،قد احترق ذات مرّةٍ

235
00:14:08,040 --> 00:14:11,230
لكنّها اقترضت المال مِن
.كُلّ حدبٍ وصوب لإعادة بنائه

236
00:14:11,720 --> 00:14:12,750
حقًا؟

237
00:14:13,600 --> 00:14:17,540
ورُغم ذلك احتضنتني وأُختي إيروها
.وربّتنا أحسن تربية

238
00:14:19,220 --> 00:14:22,280
أيّ طاقةٍ جبّارة تلك الّتي تمتلكها؟

239
00:14:23,300 --> 00:14:24,530
.لا تسألني

240
00:14:25,440 --> 00:14:30,760
أردت دائمًا أن أغدو شخصًا
،قويًا يُمكنه حماية النّاس

241
00:14:31,100 --> 00:14:32,480
.كما تفعل الجدّة تمامًا

242
00:14:34,430 --> 00:14:37,920
وما انضمامي إلى المِيبورو
.إلّا لأتعلّم السّبيل لتحقيق ذلك

243
00:14:39,360 --> 00:14:41,120
،فهمت الآن
.إذًا ورثت صفاتك منها

244
00:14:41,120 --> 00:14:41,840
ماذا؟

245
00:14:42,450 --> 00:14:45,300
.اكتشفت سرّ جُرأتك المُفرطة يا نيو

246
00:14:46,740 --> 00:14:49,800
!نيو، هاجيمي
.تعاليا إلى هُنا وقدّما لي يد العون

247
00:14:50,000 --> 00:14:50,860
.هيّا بنا

248
00:14:50,860 --> 00:14:51,400
.حسنًا

249
00:14:53,400 --> 00:14:55,460
.نيو، كِدت أن أنسى

250
00:14:56,970 --> 00:14:58,240
.مرحبًا بعودتك

251
00:14:58,600 --> 00:15:02,250
عُدت وأنت تبدو أكثر نضجًا
.بكثيرٍ ممّا كُنت عليه حين رحلت

252
00:15:05,240 --> 00:15:06,980
.يا للرّاحة

253
00:15:07,840 --> 00:15:09,720
،أجل
!ما أجمل العودة إلى المنزل

254
00:15:10,360 --> 00:15:13,830
كم تشوّقت لرؤية وجهكِ
.يا جدّتي مُجدّدًا

255
00:15:14,490 --> 00:15:15,780
.الآن، هيّا تحرّكوا

256
00:15:15,780 --> 00:15:18,760
،وبعدها ستَبيتون ليلتكم في المنزل
.أنتم الثّلاثة دُون استثناءٍ

257
00:15:19,750 --> 00:15:21,420
.شكرًا لكِ، يسرّنا ذلك

258
00:15:21,730 --> 00:15:22,770
لحظةً؟

259
00:15:22,770 --> 00:15:25,770
لا يُعقل أنّكِ ستُكلّفيننا
!بمهامٍ أخرى غدًا

260
00:15:25,770 --> 00:15:29,030
!مَبيتٌ عند الجدّة
!مَبيتٌ عند الجدّة

261
00:15:29,030 --> 00:15:31,880
!يا لحظّي

262
00:15:29,480 --> 00:15:31,850
معاطف موحّدةٌ للمِيبورو؟

263
00:15:31,850 --> 00:15:36,290
أجل، هيجيكاتا-سان يُريد منكِ
.أن تبتكري لنا تصميمًا خاصًا

264
00:15:31,880 --> 00:15:35,280
!سننام عند الجدّة سويًا، يا لسعادتنا

265
00:15:35,280 --> 00:15:40,800
،لن نرحل الآن، إنّها ليلة مبيتٍ
!والفرحة تملأ قُلوبنا

266
00:15:36,640 --> 00:15:40,380
،حسنًا، بما أنّه طلب رجلٍ وسيم
.فلن أردّه خائبًا أبدًا

267
00:15:40,800 --> 00:15:46,470
!سنبيتُ جميعنا في منزل الجدّة

268
00:15:46,470 --> 00:15:48,260
ألا تصمت قليلًا؟

269
00:15:48,260 --> 00:15:50,340
إنّني أرى تلألؤ عيني
!تارو-كون حماسًا

270
00:15:52,620 --> 00:15:54,890
.جماعة المِيبورو هؤلاء مُثيرون للضّحك

271
00:15:54,890 --> 00:15:57,940
.ذُهلت مِن مقدار شُربهم للخمر

272
00:15:58,510 --> 00:15:59,840
.إنّهم مجموعةٌ مِن الحمقى

273
00:16:00,610 --> 00:16:02,980
!هذا رائعٌ
.لا يُمكنني الاكتفاء أيّتها الجدّة

274
00:16:02,980 --> 00:16:05,600
إلى أيّ حدّ يُمكن أن يكون
السّردين المُجفّف لذيذًا؟

275
00:16:06,220 --> 00:16:11,610
لكن، أليست مُهمّة المِيبورو هي القبض
!على المُجرمين وفصل رُؤوسهم

276
00:16:11,610 --> 00:16:14,520
هل أنتم أيّها الصّبيان
في أمانٍ برفقتهم؟

277
00:16:14,520 --> 00:16:16,360
نحن لا نستلّ سُيوفنا
.دُون سببٍ وجيه

278
00:16:17,000 --> 00:16:23,370
،فغايتنا أن ينعم أهل كيوتو بالسّلام
.ومُهمّتنا هي صون أمن المدينة

279
00:16:24,400 --> 00:16:26,120
صون أمن المدينة؟

280
00:16:26,940 --> 00:16:30,160
واجبنا الأوّل هو حراسة الشّوغون
.توكوغاوا الّذي قدم إلى هنا مِن إيدو

281
00:16:30,380 --> 00:16:31,880
صحيح، فهذا يُعدّ أمرًا
.بالغ الأهمية أيضًا

282
00:16:32,360 --> 00:16:36,760
،صون أمن المدينة؟ هذا رائعٌ
.إنّه عملٌ نبيل حقًا

283
00:16:38,090 --> 00:16:38,600
.أجل

284
00:16:39,930 --> 00:16:42,440
كيف حال إيروها؟

285
00:16:42,440 --> 00:16:45,900
،لا شكّ أنّها بخيرٍ
.فهي ترسل لي رسائل بين حينٍ وآخر

286
00:16:46,280 --> 00:16:48,850
،لطالما كرهت إيروها الكتابة

287
00:16:49,960 --> 00:16:51,400
.مِن المُؤكّد أنّها تبذل جهدًا كبيرًا الآن

288
00:16:54,040 --> 00:16:54,650
.حسنًا

289
00:16:55,160 --> 00:16:57,170
،بعد تناول الطّعام
.وقت الاستحمام

290
00:16:57,170 --> 00:16:59,450
.ماذا؟ لا أُطيق الاستحمام أبدًا

291
00:16:59,450 --> 00:17:03,750
،أجل، أجل، سأترك دوري للنّهاية
.فليذهب كُلّ منكم بسرعةٍ

292
00:17:06,290 --> 00:17:07,780
.لا يحاول أحدٌ منكم التلصّص

293
00:17:08,000 --> 00:17:09,250
!كأنّ هذا سيحدث

294
00:17:12,600 --> 00:17:16,410
،استعرت فُرشًا مِن الجيران
.لكن المكان سيكون ضيقًا حتمًا

295
00:17:17,020 --> 00:17:18,310
!رائعٌ

296
00:17:20,970 --> 00:17:22,180
.أُفضّل النّوم هنا

297
00:17:22,180 --> 00:17:24,140
لن تنعم أبدًا بنومٍ هادئ
.إن فعلت ذلك

298
00:17:24,500 --> 00:17:26,760
رجال السّاموراي لا يغرقون
.في النّوم

299
00:17:26,950 --> 00:17:28,770
!فهمت ما ترمي إليه يا هاجيمي

300
00:17:29,080 --> 00:17:31,800
أنت مبتهجٌ جدًا، ولن تغمض لك
عينٌ اللّيلة، أليس كذلك؟

301
00:17:31,800 --> 00:17:33,520
.هيّا إلى الفراش، يا هذا

302
00:17:37,200 --> 00:17:37,860
.جدّتي

303
00:17:38,800 --> 00:17:39,960
ماذا؟

304
00:17:40,940 --> 00:17:44,280
،أعتذر لأنّنا زُرناكِ بشكلٍ مُفاجئٍ هكذا
هل سبّبنا لكِ أيّ إزعاجٍ؟

305
00:17:44,500 --> 00:17:46,480
،كلا بالتّأكيد

306
00:17:46,480 --> 00:17:48,290
.لا تتفوّه بمثل هذا الكلام مرّةً أُخرى

307
00:17:49,820 --> 00:17:50,510
.حسنًا

308
00:17:55,260 --> 00:17:57,040
ولكن ماذا لو أنّك نُفيت بعيدًا عنها؟

309
00:17:57,550 --> 00:17:59,000
أَتموت حسرةً؟

310
00:18:00,190 --> 00:18:05,130
ماذا لو تعذّر عليكِ البقاء
في كيوتو بعد الآن؟

311
00:18:06,640 --> 00:18:09,280
ماذا تقصد؟
هل تُريد أن تبدو طريفًا بقولك هذا؟

312
00:18:09,610 --> 00:18:12,150
.كلا، أنا جادٌ

313
00:18:15,890 --> 00:18:19,400
،سأموت حتمًا
.سأموت على هذه الأرض

314
00:18:19,870 --> 00:18:26,430
لو حُرمت مِن العيش في كيوتو، لفارقت الحياة
.لحظتها، يُفترض بك أن تُدرك هذا يقينًا

315
00:18:27,550 --> 00:18:30,400
.أجل، توقّعت منكِ هذا الرّد

316
00:18:31,070 --> 00:18:34,160
،أنا أُحبّ هذه المدينة
.وأشاطركِ الإحساس ذاته

317
00:18:34,940 --> 00:18:36,020
لكن ما السّبب؟

318
00:18:36,720 --> 00:18:38,680
ما الّذي يجعل هذه المدينة
غاليةً عليكِ إلى هذا الحدّ؟

319
00:18:39,060 --> 00:18:41,580
...السّبب؟ حسنًا

320
00:18:42,640 --> 00:18:45,180
نِلت نصيبًا وافرًا مِن الحظّ
.في هذه المدينة

321
00:18:45,760 --> 00:18:46,750
حظٌّ؟

322
00:18:47,870 --> 00:18:51,680
عِشت فيها معك
.ومع إيروها يا نيو

323
00:18:54,070 --> 00:18:57,040
وهذا الإحساس بالامتنان يتعاظم لديّ
.الآن بعد أن صرت وحيدةً

324
00:18:59,900 --> 00:19:02,280
.جدّتي، أريد الاعتذار منكِ

325
00:19:03,460 --> 00:19:04,570
وممّ تعتذر؟

326
00:19:05,070 --> 00:19:10,290
،عندما جئت الى هذه المدينة لأوّل مرّةٍ
.عرضتِ عليّ مُرافقتكِ للمعابد والمهرجانات

327
00:19:10,290 --> 00:19:13,590
.إلّا أنّني كُنت أُجيب بالرّفض دومًا

328
00:19:13,910 --> 00:19:16,590
،أجل، صحيحٌ
.كنت تفعل ذلك في البداية

329
00:19:16,880 --> 00:19:18,770
—في الواقع

330
00:19:18,770 --> 00:19:23,260
:ظننت أنّك ستنال الثّناء، أليس كذلك؟ ونقول
".يا له مِن شابٍ دَمثٍ يُؤثر راحتنا على نفسه"

331
00:19:23,590 --> 00:19:24,680
كنتِ تعلمين؟

332
00:19:24,680 --> 00:19:26,460
.أجل، بالطّبع

333
00:19:26,460 --> 00:19:29,640
كم سنةً مرّت وأنا جدّةٌ؟

334
00:19:30,100 --> 00:19:33,800
أستطيع تذكّر كُلّ لحظةٍ
.وأنا مُغمضة العينين

335
00:19:34,010 --> 00:19:37,150
،ما زِلت صغيرًا على فهم ذلك

336
00:19:38,080 --> 00:19:41,520
،لكن تربية الصّغار أمرٌ عجيب

337
00:19:42,200 --> 00:19:47,440
.فأنت تعيش حياةً ثانية مِن خلالهم

338
00:19:49,680 --> 00:19:53,630
كُنت أنت وإيروها بمثابة فُرصةٍ
.ثانية لي في هذه الحياة

339
00:19:54,640 --> 00:19:56,800
...حتّى وإن لم تكن بيننا قرابة دمٍ

340
00:19:58,900 --> 00:20:01,920
.فالنّاس الّذين نلتقيهم كنوزٌ نظفر بها

341
00:20:06,710 --> 00:20:10,680
...أن أحيا لأجل رُوحٍ غير رُوحي

342
00:20:10,950 --> 00:20:14,600
.وجدت في ذلك لذّةً تفوق كُلّ وصفٍ

343
00:20:18,850 --> 00:20:21,230
.هذا ما تُمثّله لي هذه المدينة

344
00:20:22,880 --> 00:20:28,800
،نيو، التقِ بالكثير من البشر
.وتعلّم شتّى الأمور

345
00:20:31,200 --> 00:20:33,040
.فهذا ما يصنع كيان الإنسان

346
00:20:34,630 --> 00:20:38,230
.سأموت هُنا محاطةً بذكرياتي

347
00:20:38,230 --> 00:20:39,910
.وقد هيّأت نفسي لذلك

348
00:20:40,180 --> 00:20:43,710
فلا طاقة لي الآن بالرّحيل
.والعيش في مكانٍ آخر

349
00:20:46,960 --> 00:20:51,560
أيقنت الآن، غايتي مِن النّضال هنا
.في كيوتو باتت جليّةً كشمس النّهار

350
00:20:53,210 --> 00:20:55,230
!بالتّأكيد، مَنيّتي ليست قريبةً بعد

351
00:20:55,900 --> 00:20:57,650
.أمّا الآن، فاخلُد إلى النّوم

352
00:20:57,890 --> 00:20:59,310
.حسنًا، تُصبحين على خيرٍ

353
00:21:02,920 --> 00:21:05,600
.كُلّ مَن أهتمّ لأمرهم هُنا الآن

354
00:21:08,330 --> 00:21:11,540
،هيّا بنا
!أمامنا يومٌ حافل بالعمل

355
00:21:11,890 --> 00:21:14,330
،إليك طلبك مِن الدّانغو
.وهُلام المشمش أيضًا

356
00:21:15,090 --> 00:21:17,040
!شـ-شكرًا لانتظارك

357
00:21:18,320 --> 00:21:20,040
.صدقت الجدّة

358
00:21:23,230 --> 00:21:25,310
...إن كان البشر الّذين نلتقيهم كُنوزًا

359
00:21:26,500 --> 00:21:27,620
!مرحبًا

360
00:21:29,680 --> 00:21:34,250
...فإنّ ذلك اللّقاء لا بُدّ وأن يكون

361
00:21:38,850 --> 00:21:41,380
.أعظم كنزٍ ظفرت به في حياتي

362
00:21:44,870 --> 00:21:49,870
كنزٌ

363
00:23:20,000 --> 00:23:25,380
الحلقة القادمة

364
00:23:21,510 --> 00:23:22,670
،تشيرينو نيو يُحدّثكم

365
00:23:23,260 --> 00:23:26,480
يا له مِن شُعورٍ رائع
.أن أعود إلى المنزل

366
00:23:27,050 --> 00:23:29,850
،رائحة طهي الدّانغو
،وبساط التّاتامي العتيق

367
00:23:30,200 --> 00:23:33,520
والأهمّ مِن ذلك كُلّه، بقاء الجدّة
.على سجيّتها الّتي لم تتبدّل

368
00:23:34,280 --> 00:23:39,350
تيقّنت مرّةً أُخرى أنّ قيمتهم في
.نفسي تفوق كُلّ كنوز الدّنيا

369
00:23:39,910 --> 00:23:43,520
يبدو، أنّني سأمضي في جمع المزيد مِن
الكنوز الّتي تستحقّ الاهتمام، أليس كذلك؟

370
00:23:45,210 --> 00:23:47,020
."الحلقة القادمة: "أضعفُ شوغون

371
00:23:47,030 --> 00:23:49,870
أضعفُ

372
00:23:47,030 --> 00:23:49,870
شوغون

373
00:23:47,580 --> 00:23:48,570
.لن أُخيّب ظنّكم أبدًا