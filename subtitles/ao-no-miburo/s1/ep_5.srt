1
00:00:01,320 --> 00:00:03,270
!أحضروه إلى هنا
!استدعُوا طبيبًا

2
00:00:04,260 --> 00:00:06,600
!لا جدوى
.لفظ أنفاسه الأخيرة

3
00:00:13,290 --> 00:00:14,730
.بلغ العدد أربعةً

4
00:00:15,310 --> 00:00:20,240
،كان كوشيبي مِن أمهر رجال آيزو
.ومع ذلك نالوا منه

5
00:00:20,610 --> 00:00:23,520
ما العمل الآن؟ لا يُمكننا الاستمرار
.في تجاهل هذا يا هيروساوا

6
00:00:23,840 --> 00:00:25,340
أما مِن حلّ؟

7
00:00:25,520 --> 00:00:26,720
.أنا أعرف طريقةً

8
00:00:26,930 --> 00:00:27,580
ما هي؟

9
00:00:27,760 --> 00:00:32,220
،سنضرب الخارجين عن القانون ببعضهم
...ائتُونِي بـ

10
00:00:33,330 --> 00:00:34,530
.المِيبورو

11
00:00:50,240 --> 00:00:55,950
ذئاب ميبو الزّرق

12
00:02:15,530 --> 00:02:17,220
.نيو مجتهدٌ حقًا

13
00:02:21,450 --> 00:02:24,000
إيسامي-سان! ماذا تفعل؟

14
00:02:25,620 --> 00:02:28,120
.أملأ رئتي بهواء كيوتو

15
00:02:28,680 --> 00:02:30,530
ولماذا تفعل ذلك سيّدي؟

16
00:02:30,530 --> 00:02:33,040
.جلالة الإمبراطور يسكن كيوتو

17
00:02:33,040 --> 00:02:35,960
والآن، فإنّ الشّوغون اللّورد إيموتشي
.موجودٌ هنا أيضًا

18
00:02:36,440 --> 00:02:39,440
أشعر أنّ هذا الهواء
.سيعزّز هالة السّاموراي لديّ

19
00:02:40,970 --> 00:02:43,480
هالة
السّاموراي

20
00:02:41,740 --> 00:02:43,110
وما هي هالة السّاموراي؟

21
00:02:44,960 --> 00:02:46,560
.تروقني طريقتك في التّفكير

22
00:02:48,050 --> 00:02:48,860
تارو-كون؟

23
00:02:49,750 --> 00:02:53,560
سيريزاوا-سينسي لديه إعلانٌ
.مهمّ سيُدلي به

24
00:02:53,790 --> 00:02:54,960
سيريزاوا-سان؟

25
00:02:56,040 --> 00:02:58,860
مرّةً أخرى؟ هل تظنّ أنّ شيئًا ما
قد سار بشكلٍ خاطئ؟

26
00:02:59,160 --> 00:03:00,520
مَن يعلم؟

27
00:03:04,450 --> 00:03:05,660
.ها هو ذا

28
00:03:11,920 --> 00:03:13,670
!إنّه في مزاجٍ جيّد؟

29
00:03:13,920 --> 00:03:17,670
،مـ-معذرةً سيّدي
أَثمّة خبرٌ سارّ حلّ بنا؟

30
00:03:17,670 --> 00:03:20,800
خبرٌ سارّ؟
.لا تتظاهر بالجهل

31
00:03:22,400 --> 00:03:26,050
أنا واثقٌ أنّ السيّد كوندو
.قد نقل إليكم الخبر

32
00:03:26,520 --> 00:03:32,020
دعت مقاطعة آيزو فرقة ميبو روشيغومي
.للانضمام إليها بصفةٍ رسميّة

33
00:03:32,770 --> 00:03:35,680
والآن، حان الوقت لنعبّر عن
.احترامنا لحاكم مقاطعة آيزو

34
00:03:36,560 --> 00:03:38,690
.أجل، هذا ما خطّطنا له

35
00:03:39,080 --> 00:03:40,150
!أنا آخر مَن يعلم

36
00:03:40,150 --> 00:03:41,560
!لم تُطلعنا على أيّ تفاصيل

37
00:03:41,560 --> 00:03:43,470
!دائمًا ما تتصرّف بمفردك

38
00:03:43,780 --> 00:03:46,800
.آيزو"؟ هذا خبرٌ طيّبٌ"

39
00:03:46,800 --> 00:03:49,640
ولكن ماذا سيكون ردّ فعل العامّة؟

40
00:03:49,640 --> 00:03:53,790
أظنّ أنّ أهل كيوتو
.يكنّون مودّةً كبيرةً لـ آيزو

41
00:03:53,790 --> 00:03:54,420
ماذا؟

42
00:03:54,420 --> 00:03:55,290
هل تعني ذلك حقًا؟

43
00:03:55,530 --> 00:04:00,040
ابتهج الجميع بقُدوم
.موكب آيزو السّنة الماضية

44
00:04:00,560 --> 00:04:03,720
خرجت أنا وجدّتي وأختي
.إلى الجسر لرؤيتهم

45
00:04:03,720 --> 00:04:05,730
كم هو مفيدٌ وجود فتىً
!مِن أهل المدينة معنا

46
00:04:05,730 --> 00:04:06,800
!كنت عونًا لنا بالفعل

47
00:04:08,260 --> 00:04:11,800
!ما كان هذا ليحدث لولا السيّد سيريزاوا

48
00:04:11,800 --> 00:04:13,520
.هذا هو حصاد فِعلي

49
00:04:18,600 --> 00:04:21,520
،معذرةً
.أرجو منكم التوقّف لحظةً

50
00:04:22,000 --> 00:04:24,400
سيّد يامانامي؟ ما الخطب؟

51
00:04:24,700 --> 00:04:26,820
،أرغب في التحدّث بشفافيّةٍ
هل تأذنون لي؟

52
00:04:27,380 --> 00:04:28,400
.هات ما عندك

53
00:04:28,640 --> 00:04:32,800
لا تزال كيوتو عالقةً في
.خضمّ ثورة سونو جوي العاتية

54
00:04:33,000 --> 00:04:34,800
.كُلّنا نعلم ذلك

55
00:04:35,110 --> 00:04:35,790
...عـ-عذرًا

56
00:04:36,200 --> 00:04:36,610
ماذا؟

57
00:04:36,610 --> 00:04:38,240
.عذرًا يامانامي-سان

58
00:04:38,560 --> 00:04:40,670
ما معنى سونو جوي؟

59
00:04:43,220 --> 00:04:45,270
أَتعني أنّك تجهل أمرًا كهذا؟

60
00:04:45,450 --> 00:04:49,010
،يتردّد هذا الوصف على مسامعي دائمًا
.ولكنّني لا أُدرك مقصده تمامًا

61
00:04:49,690 --> 00:04:51,220
.إنّه سؤالٌ جيّد

62
00:04:51,650 --> 00:04:55,310
سونو تعني تبجيل الإمبراطور
.هنا في كيوتو

63
00:04:55,310 --> 00:05:00,040
أما جوي فتُعبّر عن الرّغبة في طرد
.الأجانب الّذين يُعكّرون صفو بلادنا

64
00:05:00,870 --> 00:05:01,730
.فهمت

65
00:05:02,040 --> 00:05:06,740
المقصود هو توقير الإمبراطور
.وطرد الأجانب

66
00:05:07,810 --> 00:05:13,000
ولكن مهلًا، أليس هذا
ما يسعى إليه عامّة النّاس حقًا؟

67
00:05:14,610 --> 00:05:15,870
ماذا تقصد بكلامك؟

68
00:05:16,120 --> 00:05:17,710
.أصبت كبد الحقيقة

69
00:05:17,710 --> 00:05:19,910
.أجل، وهذا هو سبب الأزمة

70
00:05:19,910 --> 00:05:20,580
ماذا؟

71
00:05:20,960 --> 00:05:24,200
مفهوم سونو جوي
.ليس واحدًا لدى الجميع

72
00:05:24,130 --> 00:05:31,810
سونو جوي

73
00:05:24,130 --> 00:05:31,810
معارضة الشّوغون

74
00:05:24,130 --> 00:05:31,810
مقاطعة توشيو

75
00:05:24,130 --> 00:05:31,810
تأييد الشّوغون

76
00:05:24,130 --> 00:05:31,810
آيزو

77
00:05:25,300 --> 00:05:28,120
.مقاطعة آيزو مثلًا تقف مع الشّوغون

78
00:05:28,400 --> 00:05:31,810
فهم يحترمون الإمبراطور ويريدون إزاحة
.الأجانب مع التزامهم بطاعة الشّوغون

79
00:05:32,390 --> 00:05:34,560
.وهذا هو سبب وجودنا هنا

80
00:05:34,560 --> 00:05:40,940
سونو جوي

81
00:05:34,560 --> 00:05:40,940
معارضة الشّوغون

82
00:05:34,560 --> 00:05:40,940
مقاطعة توشيو

83
00:05:34,560 --> 00:05:40,940
تأييد الشّوغون

84
00:05:34,560 --> 00:05:40,940
آيزو

85
00:05:35,360 --> 00:05:40,950
وفي المقابل، تتبنّى توشيو المبدأ نفسه
.لكنّها تُصرّ على معاداة الشّوغون بكُلّ قوّةٍ

86
00:05:41,390 --> 00:05:44,240
.ونفوذهم هو الأقوى في كيوتو حاليًا

87
00:05:44,240 --> 00:05:47,900
مُعادون للشّوغون؟
...هل يعتقد البعض أنّ إسقاط الشّوغون

88
00:05:47,900 --> 00:05:50,320
هو جوهر العدالة؟

89
00:05:50,950 --> 00:05:53,080
كم تمنّيت لو كان بمقدورنا
.الانسجام معًا دون خصامٍ

90
00:05:53,260 --> 00:05:55,600
.أجل ، وأنا أتمنّى ذلك أيضًا

91
00:05:55,600 --> 00:05:59,320
.لكن المُشكلة لا تكمن في مبادئهم

92
00:05:59,800 --> 00:06:05,460
بل في لجوء البعض للعنف والقتل
.في سبيل تشكيل العالم ليُناسب أهواءهم

93
00:06:08,050 --> 00:06:11,430
.سئم النّاس مِن هذا الوضع

94
00:06:12,090 --> 00:06:16,480
،بتنا نُحكم إغلاق المنازل مِن الرّعب
.رغم حر الصّيف الخانق

95
00:06:18,690 --> 00:06:21,160
.نحلم فقط بالسير بأمان ونحن مبتهجون

96
00:06:22,200 --> 00:06:23,190
لماذا إذن؟

97
00:06:23,440 --> 00:06:26,240
لماذا كُتب على مدينتنا
هذا الشّقاء دُون غيرها؟

98
00:06:26,720 --> 00:06:29,700
،الإمبراطور الحاليّ يمقت الأجانب

99
00:06:30,040 --> 00:06:32,240
وبدأ البعض يستغلّون
.موقفه هذا لتبرير أفعالهم

100
00:06:32,480 --> 00:06:34,990
ماذا؟ هل يعني هذا أنّ
الأمر كُلّه يعود لهذا السّبب؟

101
00:06:35,700 --> 00:06:40,000
تحصّن اللّورد توكوغاوا إيموتشي
.بالفعل في قلعة نيجو بكيوتو

102
00:06:40,330 --> 00:06:45,370
وتتردّد شائعاتٌ بأنّ عدد المُتطرّفين الّذين
.يُخطّطون لاغتياله قد بلغ خمسمائة أو أكثر

103
00:06:45,550 --> 00:06:47,210
مهلًا... خمسمائة شخصٍ؟

104
00:06:47,210 --> 00:06:49,420
أجل؟ وما المُشكلة في ذلك؟

105
00:06:50,840 --> 00:06:54,560
إذن، هل أنتم مُستعدّون
للمخاطرة بحياتكم؟

106
00:06:54,560 --> 00:06:59,180
!نحن رونين! يسهل استغلالنا والاستغناء عنّا
!مقاطعة آيزو لا ترانا سوى بيادق للتّضحية

107
00:06:59,440 --> 00:07:01,690
!ولن تعجبنا كُلّ مهمةٍ يوكلونها إلينا

108
00:07:01,690 --> 00:07:03,990
،دون شكّ
!سيُوكلون إلينا تنفيذ أقذر المهامّ

109
00:07:04,190 --> 00:07:07,440
فهل ما زلتم مُستعدّون لبذل أرواحكم؟
!هيّا، أجيبوا

110
00:07:07,650 --> 00:07:09,870
هـ-هل يُعاني مِن انفصامٍ في الشخصيّة؟

111
00:07:10,740 --> 00:07:14,540
أَمستعدٌّ أنا لبذل روحي؟
مستعدٌّ بحقٍ؟

112
00:07:15,020 --> 00:07:18,170
هل يسعني الجزم بأنّ ثباتي لن ينهار
حين أقف وجهًا لوجه أمام الموت؟

113
00:07:24,230 --> 00:07:25,290
!أنا مستعدٌّ

114
00:07:25,930 --> 00:07:27,120
!كوندو-سان

115
00:07:27,600 --> 00:07:31,140
،هذا يبعثُ على الحماس
.لننضمّ جميعًا

116
00:07:31,320 --> 00:07:32,260
!أوكيتا-سان

117
00:07:34,120 --> 00:07:36,800
بعد كلّ هذا الوقت تسأل؟

118
00:07:36,800 --> 00:07:38,930
،أجل
.ثمّة طريقٌ واحد فقط أمامنا

119
00:07:39,150 --> 00:07:40,310
.نحن معك

120
00:07:40,310 --> 00:07:41,680
.بكُلّ تأكيدٍ نحن معك

121
00:07:42,620 --> 00:07:46,060
،مَن لا يستطيع قول ذلك
.لا مكان له هنا

122
00:07:47,180 --> 00:07:50,440
!أيّها الرّجال، اتبعوني

123
00:07:54,560 --> 00:07:56,200
يبدو أنّ مُحاولة هزّ ثقتهم
.ذهبت سدىً

124
00:07:56,410 --> 00:07:59,330
كلا، بل هذا هو المشهد
.الّذي كنت أترقّبه

125
00:08:00,600 --> 00:08:03,330
كُنت واثقًا مِن أنّ
!هؤلاء الرّجال مذهلون

126
00:08:04,280 --> 00:08:05,710
!أنا معكم أيضًا

127
00:08:06,010 --> 00:08:10,710
،ماذا؟ إذن... في هذه الحالة
.سأنضمّ إليكم، إن كنتم تقبلون بي

128
00:08:11,000 --> 00:08:17,340
،نحن، ميبو روشغومي
!نتشارك غايةً واحدة: الدّفاع عن كيوتو

129
00:08:18,730 --> 00:08:20,940
.تقدّموا

130
00:08:23,070 --> 00:08:25,460
!حسنًا! لنمضِ الآن

131
00:08:33,200 --> 00:08:35,400
،إنّه يُسبّب الحكّة
لماذا هو خشنٌ هكذا؟

132
00:08:35,400 --> 00:08:38,570
هيّا يا هيجيكاتا-سان، نريد لقامتك
.أن تنتصب فخرًا مثل كوندو-سان

133
00:08:38,570 --> 00:08:40,200
.اصمت يا سوجي

134
00:08:40,730 --> 00:08:42,420
أَتظنّ أنّنا سنحظى بوليمةٍ فاخرة؟

135
00:08:46,180 --> 00:08:51,160
الجميع مُتشوّقون للقاء رجلٍ ذي شأنٍ
مثل لورد آيزو، أليس كذلك يا هاجيمي-كون؟

136
00:08:52,080 --> 00:08:52,920
.سُذّج

137
00:08:52,920 --> 00:08:53,350
ماذا؟

138
00:08:54,040 --> 00:08:58,260
ليس لهويّة مَن نتبعه أيّ أهميةٍ
.ما دُمنا نحيا حياة السّاموراي

139
00:08:58,760 --> 00:08:59,560
أَلست مُحقًا؟

140
00:09:02,810 --> 00:09:05,560
مُفوّض كيوتو
اللّورد ماتسودايرا هيغو نو كامي، حاكم آيزو

141
00:09:08,560 --> 00:09:12,810
إذن، هذا هو مقرّ آيزو في كيوتو؟
.إنّه قصرٌ منيع حقًا

142
00:09:15,570 --> 00:09:16,860
.استمتعوا بوقتكم يا سادة

143
00:09:17,600 --> 00:09:19,330
تارو، ألن تدخل معنا؟

144
00:09:19,730 --> 00:09:21,950
بهذه الملابس؟ كيف لي ذلك؟

145
00:09:22,160 --> 00:09:26,050
دعوكم منه، لا نُريده أن
.يُثير غضب أحدٍ على أيّ حالٍ

146
00:09:26,050 --> 00:09:27,100
...إذن

147
00:09:28,360 --> 00:09:31,280
،لن أدخل أنا أيضًا
.لننتظر هنا بالخارج معًا

148
00:09:33,040 --> 00:09:34,590
.لا عتب عليك، فأنت طفلٌ

149
00:09:34,920 --> 00:09:36,250
.إنّه طفلٌ

150
00:09:36,250 --> 00:09:37,350
.بلا ريبٍ، هو ما زال طفلًا

151
00:09:37,350 --> 00:09:38,400
ماذا؟

152
00:09:39,440 --> 00:09:42,220
!يا لها مِن أحجارٍ بديعةٍ

153
00:09:42,220 --> 00:09:44,360
أَمجنونٌ أنت؟
.كفّ عن اللّعب بها

154
00:09:44,690 --> 00:09:48,240
،سأكتفي بالنّظر إليها
.تمنّيت لو أريتها للجدّة وإيروها

155
00:09:48,240 --> 00:09:49,890
!إيّاك أن تأخذها

156
00:09:50,280 --> 00:09:52,360
!لماذا عليّ البقاء هنا أيضًا؟

157
00:09:52,540 --> 00:09:55,920
ما هذا؟ ما بال هؤلاء الأطفال؟

158
00:09:57,800 --> 00:10:00,490
هذه المنطقة تابعةٌ
.للسيّد ماتسودايرا كاتاموري

159
00:10:00,490 --> 00:10:02,570
ليس مسموحًا لكم
.بالتّجول هنا دُون إذنٍ

160
00:10:05,920 --> 00:10:07,080
.تأمّلوا لون شعره

161
00:10:07,080 --> 00:10:08,340
!إنّه يلمع كقصر الذّهب

162
00:10:08,340 --> 00:10:11,470
أَتقصد لون شعري؟
.أصل والدتي مِن خارج البلاد

163
00:10:12,080 --> 00:10:14,760
.حملت والدتي الإنجليزية بي مِن والدي

164
00:10:15,140 --> 00:10:17,760
.ثم غادرت راجعةً إلى ديارها

165
00:10:17,760 --> 00:10:19,780
.لا بُدّ أنّك تشعر بالوحدة

166
00:10:20,120 --> 00:10:21,920
أليس لديك رغبةٌ في رؤية والدتك؟

167
00:10:22,170 --> 00:10:24,020
.لا أشعر بذلك بتاتًا

168
00:10:24,020 --> 00:10:26,150
عائلتي مِن أشهر باعة
.الأقمشة والمنسوجات

169
00:10:26,750 --> 00:10:30,090
،الدُكّان مزدحمٌ دائمًا
.والنّاس ودودون معي

170
00:10:30,440 --> 00:10:33,510
،بالإضافة لذلك
.أنا مغرمٌ بهذه المدينة

171
00:10:33,780 --> 00:10:36,030
.فلا ينقصني شيءٌ هنا

172
00:10:36,480 --> 00:10:41,160
حضرت هنا لأُبدي تقديري بعد أن
.وصلنا طلبٌ لخياطة كيمونو جديدٍ

173
00:10:41,160 --> 00:10:46,450
يا للسّخافة! هذا الطفل المُترف لم يُقاسِ
الشدائد قطّ، مَن الّذي يهتمّ لسيرة حياته؟

174
00:10:46,690 --> 00:10:48,900
.جئنا تلبيةً لدعوة مقاطعة آيزو

175
00:10:49,120 --> 00:10:52,080
،نحن المِيبورو
.أعضاء فرقة ميبو روشيغومي

176
00:10:52,320 --> 00:10:55,300
.المِيبورو؟ أجل، بلغني صيتكم

177
00:10:55,620 --> 00:11:00,320
،شرذمةٌ مِن مُتسكّعي إيدو المُثيرين للمشاكل
والّذين يمقتُهم الجميع، ألست مُحقًا؟

178
00:11:01,260 --> 00:11:04,160
،ليس الأمر كما تظنّ
.فهناك لبسٌ في الموضوع

179
00:11:04,500 --> 00:11:08,260
.نحن نبذل جهدنا لحماية أمن كيوتو

180
00:11:08,260 --> 00:11:11,600
صدقًا؟
.لم أملك أدنى فكرةٍ عن ذلك

181
00:11:11,840 --> 00:11:17,280
،رُغم ذلك، إذا كانوا قد استدعوا ساموراي أشدّاء
.فلا بُدّ أن السّبب هو... "ذلك الأمر" الّذي تعرفه

182
00:11:17,520 --> 00:11:18,500
ماذا تقصد؟

183
00:11:19,280 --> 00:11:22,150
،لا عليك
.تجاهل كلامي تمامًا

184
00:11:22,150 --> 00:11:26,120
مهما يكن، فإنّ حراسة مدينةٍ لا تنتمي
.إليها يتطلّب نوعًا فريدًا مِن الرّجال

185
00:11:26,120 --> 00:11:28,080
،سيّدي الصّغير
.حان وقت الرحيل

186
00:11:28,080 --> 00:11:30,500
.أجل، صحيح، لنعُد أدراجنا

187
00:11:31,070 --> 00:11:35,310
،تُدير عائلتي دُكّان تسورويا في نيجو-دوري
.حيث نلتقي بشتّى أصناف البشر

188
00:11:35,310 --> 00:11:36,840
.ماذا؟ حسنًا، فهمت

189
00:11:38,510 --> 00:11:42,930
أدعى سيتو، زُرني إذا كانت لديك رغبةٌ
.في الحصول على المعلومات في أيّ وقتٍ

190
00:11:43,370 --> 00:11:43,940
.وداعًا

191
00:11:44,780 --> 00:11:48,120
،اسمي نيو
.وداعًا يا سيتو-كون

192
00:11:53,520 --> 00:11:55,170
،كان ودودًا للغاية
ألا تظنّ ذلك؟

193
00:11:55,170 --> 00:11:56,050
عمّا تتحدّث؟

194
00:11:57,490 --> 00:12:00,200
.كانت تُحيط به رائحة دماءٍ باهتة

195
00:12:11,040 --> 00:12:15,720
،أنا ماتسودايرا كاتاموري
.حاكم كيوتو وزعيم آيزو

196
00:12:16,600 --> 00:12:18,960
،تنفيذًا لأوامر الإمبراطور والشّوغون

197
00:12:18,960 --> 00:12:23,720
قدمتُ مِن مقاطعتي لأسهر على
.صون السّلام هنا في رحاب العاصمة

198
00:12:23,900 --> 00:12:24,850
.سيّدي

199
00:12:24,850 --> 00:12:29,720
أحسنتم بقدومكم مِن إيدو
.للدّفاع عن الشّوغون

200
00:12:29,880 --> 00:12:30,400
.سيّدي

201
00:12:30,400 --> 00:12:31,110
...نحن

202
00:12:32,360 --> 00:12:35,720
كنّا 234 مقاتلًا باسلًا
.حين انطلقنا مِن إيدو

203
00:12:36,100 --> 00:12:41,430
،ولكن كيوكاوا هاشيرو صاحب الفكرة
.تحايل ليُردّ أغلبهم إلى أدراجهم

204
00:12:41,430 --> 00:12:43,320
.ولم يتبقّ منّا غير 15 مقاتلًا

205
00:12:43,760 --> 00:12:47,080
استعرت نيران ثورة سونو جوي
.مُنذ مجيء السّفن السّوداء

206
00:12:47,080 --> 00:12:49,280
سقط أجنبيٌّ صريعًا في
.ناماموغي السّنة الماضية

207
00:12:49,280 --> 00:12:53,280
،وفي كيوتو
."يسفك المُغتالون الدّماء باسم "عدالة السّماء

208
00:12:53,660 --> 00:12:58,680
،رغبتنا الوحيدة هي حماية كيوتو
.كما تفعلون يا سيّدي

209
00:12:58,680 --> 00:13:01,960
.بيد أنّنا وصلنا بلا زادٍ سوى إِيماننا

210
00:13:02,180 --> 00:13:06,760
ويُؤسفنا أنّنا نعتمد حاليًا على جود
.عائلة ياغي لعدم وجود دخلٍ لنا

211
00:13:06,760 --> 00:13:12,750
،نأمل أن نُقدّم أقصى ما لدينا
.لا لفترةٍ عابرة، بل إلى الأبد

212
00:13:10,320 --> 00:13:13,160
.دوّن كلماته كُلّها على ظاهر يديه

213
00:13:13,390 --> 00:13:18,940
لذلك، جئنا نلتمس
.مِن سيادتكم الدّعم

214
00:13:22,030 --> 00:13:27,480
،لو كان الأمر بيدي
!لعُدت إلى حياةٍ سالمة في آيزو فورًا

215
00:13:32,480 --> 00:13:34,980
،هذا مقامٌ مُقدّس
.محرابٌ لِـ بوذا

216
00:13:35,240 --> 00:13:38,480
،لن أنطق بالكذب هنا
.لذا فليكن الصّدق سبيلنا جميعًا

217
00:13:40,490 --> 00:13:44,510
!أُريد أن أكون ساموراي جسدًا وروحًا

218
00:13:49,200 --> 00:13:51,310
!أُريد قتال الأشدّاء

219
00:13:51,310 --> 00:13:53,960
!أُريد أن أقضي يومي بكسلٍ

220
00:13:53,960 --> 00:13:56,250
أطمح لبلوغ الذّروة في
!إتقان فنّ السّيف

221
00:13:56,250 --> 00:13:58,730
!أُريد أن ترتمي النّساء تحت قدميّ

222
00:13:58,730 --> 00:14:00,240
!أُريد أن أرتقي في المناصب

223
00:14:00,240 --> 00:14:02,920
!أُريد تناول أشهى الموائد

224
00:14:02,920 --> 00:14:06,240
!أُريد محاورة أكبر عددٍ مِن البشر

225
00:14:02,920 --> 00:14:06,240
!ما أبسط أحلامكم

226
00:14:08,110 --> 00:14:10,220
!يا لكم مِن صُحبةٍ مبهجة

227
00:14:10,220 --> 00:14:11,240
.سيّدي

228
00:14:13,040 --> 00:14:14,560
.أنت، أيّها القابع هناك

229
00:14:16,190 --> 00:14:18,040
.أخبرني بما تبتغيه حقًا

230
00:14:19,140 --> 00:14:21,560
.لا شيء لديّ لأخفيه

231
00:14:22,270 --> 00:14:25,250
أوجز خطاب كوندو
.ما يجول في خاطري

232
00:14:26,220 --> 00:14:30,400
ليس لي مطلبٌ سوى تطهير هذه
.المدينة مِن الأوباش، لا غير

233
00:14:34,270 --> 00:14:35,090
!يا له مِن رجلٍ صلب

234
00:14:35,090 --> 00:14:36,690
.هذا هو هيجيكاتا-سان كما عهدناه

235
00:14:36,690 --> 00:14:38,060
!توقّفوا عن ذلك

236
00:14:39,410 --> 00:14:41,720
.أحسنتم، نِلتُم استحساني

237
00:14:43,150 --> 00:14:44,440
.يا له مِن حاكمٍ مرح وطريف

238
00:14:47,610 --> 00:14:51,580
،يا رجال الرّوشيغومي
.ثمّة أمرٌ أرغب في أن تُعاينوه

239
00:14:51,580 --> 00:14:52,700
.اتبعُوني

240
00:14:57,980 --> 00:14:59,080
مَن هذا الصّريع؟

241
00:14:59,080 --> 00:15:02,590
إنّه رابع قتيلٍ مِن آيزو
.يُغتال في الأزقة

242
00:15:06,190 --> 00:15:10,310
،اقتلعت أعين جميع الضّحايا
.كما هو جليٌّ أمامكم

243
00:15:10,560 --> 00:15:12,010
لِمَ قد يُقدم أحدٌ على فعلةٍ كهذه؟

244
00:15:12,710 --> 00:15:17,560
نقل لنا وعيد القاتل
:قبل أن يلفظ أنفاسه

245
00:15:18,640 --> 00:15:23,870
أيا كلاب آيزو، أَعميت بصائركم؟"
".نحن الخمسة سنُحقّق عدالة السّماء

246
00:15:24,930 --> 00:15:26,280
.لي عندكم مطلبٌ

247
00:15:27,030 --> 00:15:29,270
،تعقّبوا أولئك الشياطين الخمسة

248
00:15:30,040 --> 00:15:32,660
.وواروهم الثّرى

249
00:15:35,430 --> 00:15:36,520
اقتلعت أعينهم؟

250
00:15:37,780 --> 00:15:40,620
كيف لبشرٍ أن يرتكب أمرًا بهذا السّوء؟
.سيلقون جزاءهم

251
00:15:41,190 --> 00:15:42,880
،أولًا
.نحن بحاجةٍ إلى المعلومات

252
00:15:43,120 --> 00:15:47,040
،ملامحهم، مواعيد هجماتهم
.أسلوب عملهم، أيّ تفصيل

253
00:15:47,190 --> 00:15:48,360
...معلومات

254
00:15:49,920 --> 00:15:51,800
أَعندك رأيٌ سديد؟

255
00:15:51,800 --> 00:15:54,170
.كلا، ليس بشكلٍ قاطع

256
00:15:54,780 --> 00:15:55,680
.أفصح عمّا لديك

257
00:15:58,590 --> 00:16:00,180
أَيعلم هذا الصبيّ
الّذي تتحدّث عنه شيئًا؟

258
00:16:00,180 --> 00:16:01,180
أَتتحدّث جِديًا؟

259
00:16:01,970 --> 00:16:02,900
أَنعتمد على صبيّ؟

260
00:16:02,900 --> 00:16:06,680
،إيّاك والثّقة بذاك الصبيّ
.ولا سيّما ملامحه

261
00:16:06,680 --> 00:16:10,110
كلا، لا ينبغي أن
.نحكم عليه مِن ملامحه

262
00:16:10,110 --> 00:16:13,200
،إذن يا نيو
.نُوكِل هذه المُهمّة إليكم أيّها الفتيان

263
00:16:13,200 --> 00:16:13,670
.أمرك يا سيّدي

264
00:16:13,670 --> 00:16:15,360
!أمّا أنا... فاستَثنُوني

265
00:16:17,520 --> 00:16:18,500
.نحن نُضيّع الوقت

266
00:16:21,160 --> 00:16:24,110
.أعلم أنّ العدو سيتربّص بي

267
00:16:24,410 --> 00:16:28,000
،يكفي أن أخرج للتنزّه قليلًا
.وسيَسعون نحوي

268
00:16:28,000 --> 00:16:30,500
كـ-كيف تكون واثقًا هكذا؟

269
00:16:30,500 --> 00:16:32,000
كيف؟

270
00:16:32,190 --> 00:16:36,700
،لأن أيّ امرئٍ بمقدوره أن يرى أنّني
!سيريزاوا كامو، قوّةٌ لا يستهان بها

271
00:16:36,920 --> 00:16:38,620
.لا يمكنهم تجاهلي

272
00:16:47,520 --> 00:16:49,710
،تارو-كون
أَتمنحني دقيقةً من وقتك؟

273
00:16:49,920 --> 00:16:50,780
.أجل يا سيّدي

274
00:16:51,380 --> 00:16:52,940
ما خُطّتك يا هاجيمي-كون؟

275
00:16:52,940 --> 00:16:56,060
ألم يقل دُكّان تسورويا في نيجو-دوري؟
ماذا ننتظر إذن؟

276
00:17:01,700 --> 00:17:03,620
.يا لها مِن مفاجأةٍ

277
00:17:03,800 --> 00:17:07,320
لم يخطر ببالي أنّك
.ستقصدني هنا اليوم

278
00:17:07,320 --> 00:17:10,180
،أعتذر لمُفاجأتك هكذا بغتةً
.يا سيتو-كون

279
00:17:10,180 --> 00:17:11,380
،لا عليك
.ليس هناك ما يُزعج

280
00:17:11,850 --> 00:17:14,300
،لكنّني، للأسف
.لا أملك مكانًا معزولًا لنتبادل فيه الكلام

281
00:17:14,720 --> 00:17:16,480
.دُكّانٌ لطيف

282
00:17:16,680 --> 00:17:19,210
،هو كذلك بالفعل
.وإن كان قد نال منه القِدم

283
00:17:19,530 --> 00:17:22,720
،الجدران مطليّة بإتقانٍ، لونٌ بديع
أليس كذلك؟

284
00:17:22,720 --> 00:17:24,580
.كلا، لم يكن ذلك مقصدي

285
00:17:25,740 --> 00:17:27,720
،"هذا ما يُسمّونه "عرض البضائع عند المدخل
أليس كذلك؟

286
00:17:27,960 --> 00:17:32,230
حيث تضع سلعك أمام الدُكّان
.وتترك للزّبائن حُريّة الاختيار

287
00:17:32,710 --> 00:17:35,910
ألوانها زاهيةٌ جدًا، لدرجة أنّ المرء
.يشعر بالبهجة بمُجرّد قدومه إلى هنا

288
00:17:36,440 --> 00:17:38,200
.لديك معرفةٌ واسعة

289
00:17:38,770 --> 00:17:42,460
تعلّمت ذلك مِن خلال مساعدتي
.في دُكّان الدّانغو الخاص بجدّتي

290
00:17:42,460 --> 00:17:44,680
،اسمه تشيرينويا
هل سمعت به؟

291
00:17:44,680 --> 00:17:46,250
.أجل، أعرف ذلك المكان

292
00:17:47,070 --> 00:17:50,770
،أرى الفرح يعلو وجوه الزّبائن هنا

293
00:17:51,220 --> 00:17:53,720
.فهم غارقون في انتقاء ما يُريدون

294
00:17:54,450 --> 00:17:57,640
،لذا، إن أردت رأيي
.فهذا دُكّانٌ بديع حقًا

295
00:17:59,460 --> 00:18:02,130
،أشكرك
.أثلج صدري قولك هذا

296
00:18:04,030 --> 00:18:07,140
كنت أحسب أنّ كُلّ مَن
.في المِيبورو مِن سكان إيدو

297
00:18:07,560 --> 00:18:09,120
،ذلك ينطبق على الكبار فقط

298
00:18:09,470 --> 00:18:12,610
لكنّنا نحن الصّغار الثّلاثة
.وُلِدنا هنا في كيوتو

299
00:18:12,610 --> 00:18:16,420
!هكذا إذًا
.فنحن الأربعة جميعًا مِن مدينةٍ واحدة

300
00:18:17,640 --> 00:18:18,970
.الآن، دعني أُخمّن

301
00:18:19,520 --> 00:18:22,530
لا بُدّ أنّك جئت لتسأل عن حادثة
.مقتل ذلك السّاموراي مِن آيزو

302
00:18:23,580 --> 00:18:24,080
.أجل

303
00:18:25,160 --> 00:18:28,080
بدأت هذه الحوادث مُنذ قُدوم
.حاكم آيزو

304
00:18:28,360 --> 00:18:32,620
فقد اغتيل ساموراي وهو في طريق عودته
.مِن شيمابارا واقتلعت عيناه

305
00:18:33,190 --> 00:18:34,880
.لا ريب أنّ الدّافع حقدٌ دفين

306
00:18:35,200 --> 00:18:36,090
حقدٌ دفين؟

307
00:18:37,320 --> 00:18:38,760
.لكن ذلك لا يُبرّر الفعلة أبدًا

308
00:18:39,010 --> 00:18:41,520
،مهما كانت دوافعهم
.فقد تجاوزوا كُلّ الحدود

309
00:18:42,530 --> 00:18:43,010
.صدقت

310
00:18:45,270 --> 00:18:47,180
!عجبًا

311
00:18:47,480 --> 00:18:50,010
.ظننت أنّك ستستشيط غضبًا

312
00:18:50,010 --> 00:18:52,270
حقًا؟
.أنا مستشيطٌ غضبًا بكُلّ تأكيد

313
00:18:52,550 --> 00:18:53,770
.لا يبدو عليك ذلك

314
00:18:54,160 --> 00:18:55,180
أَهذا كُلّ ما عندك؟

315
00:18:55,770 --> 00:18:58,870
كلا، بل إنّي أعرف
.مواقع الجرائم أيضًا

316
00:19:02,140 --> 00:19:05,240
،انظر للخريطة
.إنّها في هذه النواحي

317
00:19:05,560 --> 00:19:08,420
،فهمت
.مُعظمها بالقرب مِن نهر كامو

318
00:19:09,240 --> 00:19:11,320
،كفى هدرًا للوقت
.سأنصرف

319
00:19:13,620 --> 00:19:15,910
،خُلاصة القول
.اختلط الحَابل بالنّابل

320
00:19:15,910 --> 00:19:16,360
ماذا؟

321
00:19:16,860 --> 00:19:21,400
،لا ينبغي لي التّصريح بهذا
.لكن حال المدينة يُرثى له

322
00:19:22,010 --> 00:19:24,090
.الوَافدون يغزونها مِن كُلّ ميلٍ

323
00:19:25,670 --> 00:19:29,680
،سواء كانوا مِن تشوشو أم آيزو
.مُتطرّفون أو حتّى مِيبورو، فلا فرق بينهم أبدًا

324
00:19:30,010 --> 00:19:31,420
.جميعهم غُرباء

325
00:19:32,850 --> 00:19:35,270
ما قولكم في التخلّص منهم وطردهم؟

326
00:19:35,760 --> 00:19:37,750
،ليسوا سوى آفاتٍ
.كُلّهم بلا استثناءٍ

327
00:19:38,280 --> 00:19:41,450
سأضع يدي في أيديكم
.لحماية أمن المدينة

328
00:19:43,350 --> 00:19:45,140
...شكرًا لك، لكن

329
00:19:47,720 --> 00:19:51,190
كُل ما أرجوه أن تكون المعلومات الّتي
.قدّمتها كفيلةً بإحلال السّلام في أرجاء المدينة

330
00:19:55,730 --> 00:19:56,540
.أجل

331
00:19:58,180 --> 00:19:59,360
.وأنا أرجو ذلك أيضًا

332
00:20:02,210 --> 00:20:05,010
أشار علينا بهذا الدّرب
.بما أنّ الليل قد دنا

333
00:20:07,310 --> 00:20:08,770
ما قولك يا هاجيمي-كون؟

334
00:20:10,520 --> 00:20:13,260
ما انطباعك أنت؟

335
00:20:14,160 --> 00:20:17,520
،في الحقيقة
.المدعو سيتو تَحوم حوله الشّبهات

336
00:20:19,120 --> 00:20:20,260
متى شعرت بذلك؟

337
00:20:20,720 --> 00:20:22,520
،مُنذ اللّحظة الأولى

338
00:20:23,880 --> 00:20:28,520
كان أسلوبه يُوحي أنّه
.يَجرّنا جرًا خلفه

339
00:20:29,380 --> 00:20:32,200
.رؤيته مجددًا قطعت الشّك باليقين

340
00:20:33,190 --> 00:20:34,310
.إنّه مريبٌ فعلًا

341
00:20:34,820 --> 00:20:35,620
.معك حقٌّ

342
00:20:37,640 --> 00:20:38,500
أَنحسم أمره بالقتل؟

343
00:20:38,750 --> 00:20:39,910
...كـ-كلا

344
00:20:40,510 --> 00:20:44,780
بل أُريد محادثته
.بصدقٍ لمرّة أخيرة

345
00:20:47,030 --> 00:20:50,040
.أنت لا تُقيم للمنطق وزنًا

346
00:20:50,670 --> 00:20:51,870
أَهذا ظنّك بي؟

347
00:21:01,160 --> 00:21:01,860
.مظلّةٌ

348
00:21:10,530 --> 00:21:11,330
أَينوي الهُجوم؟

349
00:21:30,640 --> 00:21:32,300
.لحُسن الحظ أنّنا كُنّا متيقّظين

350
00:21:32,640 --> 00:21:34,690
،قد نكون فتيةً
.لكنّنا لسنا فريسةً سهلة

351
00:21:38,990 --> 00:21:40,750
.إنّي لأَرثي لحالكم أيّها الفتيان

352
00:21:44,910 --> 00:21:49,910
غايةٌ

353
00:21:44,910 --> 00:21:49,910
تجمعنا

354
00:23:20,040 --> 00:23:25,460
الحلقة القادمة

355
00:23:22,370 --> 00:23:23,710
.سايتو هاجيمي يُحدّثكم

356
00:23:24,330 --> 00:23:28,440
تقاطعت سُبلنا أنا ونيو مع
.السّفاح المسؤول عن تلك الاغتيالات

357
00:23:28,960 --> 00:23:32,050
تُرى مَن يكون هذا اللّعين؟

358
00:23:32,670 --> 00:23:35,810
،ضربته الأولى تُثبت أنّه يُجيد فنّ السّيف
.لكن براعته تنتهي عند هذا الحدّ

359
00:23:36,900 --> 00:23:41,100
،لا مجال للتّراجع الآن
.فليس أمامنا إلّا القتال

360
00:23:41,480 --> 00:23:42,700
!لنُجهز عليه يا نيو

361
00:23:43,840 --> 00:23:46,130
:الحلقة القادمة
."لكُلّ امرئٍ ميزان عَدله"

362
00:23:46,590 --> 00:23:47,990
.ويلٌ لمن يُفوّت مُتابعتنا

363
00:23:47,070 --> 00:23:49,910
لكُلّ
امرئٍ

364
00:23:47,070 --> 00:23:49,910
ميزان
عَدله