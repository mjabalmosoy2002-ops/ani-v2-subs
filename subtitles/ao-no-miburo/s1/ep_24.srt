1
00:00:03,400 --> 00:00:05,610
هل كان يتولّى حراسة نبيلٍ
في القصر الإمبراطوريّ؟

2
00:00:05,800 --> 00:00:10,740
أجل، لكن ما بلغني كان نقلًا عن لسان
.غيري، لذا لا أعلم كافّة التّفاصيل

3
00:00:11,000 --> 00:00:12,100
!ضربةٌ باتّجاه الرّأس

4
00:00:12,830 --> 00:00:15,390
أُراهن أنّك سئمت قصص
!الجَدّ الطّويلة أنت أيضًا

5
00:00:18,830 --> 00:00:23,120
كُنا نعلم أنّ مجرى الزّمان
.يزداد ضراوةً

6
00:00:24,260 --> 00:00:25,880
...وبالنّسبة للمِيبورو

7
00:00:27,020 --> 00:00:31,830
فقد كانت تلك الأيّام الّتي يندفعون
.فيها نحو مُنعطفٍ مصيريّ

8
00:00:44,820 --> 00:00:49,120
ذئاب ميبو الزّرق

9
00:02:09,120 --> 00:02:12,080
بلغني أنّ المِيبورو جماعةٌ
.مِن السّيافين الأشدّاء

10
00:02:12,550 --> 00:02:13,770
وماذا لو كُنّا كذلك؟

11
00:02:14,010 --> 00:02:16,770
هل تحتفظون ببنادق أو مدافع للضّرورة؟

12
00:02:17,050 --> 00:02:19,280
.ماذا؟ كلا بالطّبع

13
00:02:19,860 --> 00:02:21,280
،فهمت

14
00:02:21,660 --> 00:02:24,530
قد يكون مِن الحكمة أن
.تُعيدوا النّظر في خياراتكم

15
00:02:28,000 --> 00:02:33,390
فحياتي أمست هدفًا للمخاطر
.مُنذ أن تبدّلت مواقفي

16
00:02:34,480 --> 00:02:40,180
،أقنعني مُفوّض الشّؤون البحريّة
.كاتسو كايشو، بأهمّية القوّة البحريّة

17
00:02:40,640 --> 00:02:43,640
لم أعد أُؤيّد طرد الأجانب
.بأيّ ثمنٍ

18
00:02:44,340 --> 00:02:49,560
ولا بُدّ أنّ المُتشدّدين في حركة مُناهضة
.الأجانب يرون في ذلك خيانةً

19
00:02:50,630 --> 00:02:53,820
.السّياسة تتطلّب يقظةً لا تنقطع

20
00:02:54,160 --> 00:02:56,610
يجد المرء نفسه دومًا
.في موقفٍ شائك

21
00:02:57,230 --> 00:03:02,320
فمن يحميني اليوم قد ينقلب
.ليَسلبني حياتي غدًا

22
00:03:04,850 --> 00:03:08,230
لماذا قبلت بمُهمّة حمايتي
بهذه السّرعة؟

23
00:03:08,990 --> 00:03:10,660
.لا قيمة لهذا الهُراء

24
00:03:12,330 --> 00:03:14,950
فعلت ذلك لأنّ معالم الخوف
.كانت باديةً عليك

25
00:03:16,010 --> 00:03:18,170
،إذا لم يحمِ السّاموراي الضّعفاء
فمن سيفعل؟

26
00:03:21,230 --> 00:03:24,910
أرى أنّ إيروها أحسنت الاختيار
.حين لجأت إليك

27
00:03:25,770 --> 00:03:26,640
...ولكن

28
00:03:27,330 --> 00:03:31,100
،إن ظللت مُمسكًا بتلك المبادئ
.فمجرى الزّمان سيجرفك ويُخلّفك وراءه

29
00:03:31,380 --> 00:03:32,310
أيّ مجرى؟

30
00:03:32,750 --> 00:03:34,310
.مجرى الزّمان

31
00:03:35,440 --> 00:03:39,260
أم أنّك ستتمرّد على العصر
الّذي نعيش فيه؟

32
00:03:42,050 --> 00:03:47,040
إن كان الأمر كذلك، فإنّ أشخاصًا مثل ذاك
،الفتى، ممّن يسعون لدفعنا نحو المستقبل

33
00:03:48,060 --> 00:03:52,030
.قد يغدون يومًا ألدّ خُصومك

34
00:03:52,220 --> 00:03:55,330
أيّ فتى؟ عمّن تتحدّث؟

35
00:03:56,070 --> 00:03:59,720
،ذلك الرّونين ساكاموتو ريوما
.مِن مُقاطعة توسا سابقًا

36
00:04:01,890 --> 00:04:02,920
.لم يسبق لي أن سمعت به

37
00:04:03,550 --> 00:04:05,170
!أنيجاكوجي

38
00:04:05,370 --> 00:04:06,720
!استعدّ للموت

39
00:04:06,720 --> 00:04:08,020
!نتعرّض للهُجوم

40
00:04:07,630 --> 00:04:08,010
ماذا؟

41
00:04:13,530 --> 00:04:15,400
!وراءه، لا تدعه يفرّ

42
00:04:15,400 --> 00:04:16,440
!توقّف

43
00:04:18,850 --> 00:04:21,150
!إنّك مهيبٌ، مهيبٌ للغاية

44
00:04:22,330 --> 00:04:24,100
أَتظنّ أنّني سأدع ذلك الفاشل يهزمني؟

45
00:04:28,080 --> 00:04:32,160
،وواثقٌ أيضًا! هاجيمي
.أثرت اهتمامي

46
00:04:33,970 --> 00:04:35,420
كيف حال نيو؟

47
00:04:35,790 --> 00:04:38,500
،ليس بخيرٍ
.فهو يلزم غُرفته ولا يُغادرها

48
00:04:38,810 --> 00:04:42,660
،لكنّني حسبت أنّ حُمّاه قد سكنت
ألا يزال يشكو شيئًا؟

49
00:04:43,330 --> 00:04:45,470
،إنّها علّة الرّوح
.لا ريب في ذلك

50
00:04:45,470 --> 00:04:46,980
،لا أستوعب هذا

51
00:04:47,320 --> 00:04:50,290
،أعني، ما مضى قد مضى
أليس كذلك؟

52
00:04:50,880 --> 00:04:53,870
،أحيانًا يا سانوسكي-سان
.تُصيب كبد الحقيقة

53
00:04:54,120 --> 00:04:56,010
ماذا تقصد؟

54
00:04:56,440 --> 00:04:57,750
...نيو

55
00:04:58,870 --> 00:05:02,320
رُبّما يبقى نيو مُنعزلًا
.لفترةٍ مِن الوقت

56
00:05:03,520 --> 00:05:04,500
وماذا عن سيريزاوا؟

57
00:05:04,950 --> 00:05:07,320
.ترك غرفته لـ نيو

58
00:05:07,820 --> 00:05:10,350
.دعوه يمكث فيها حتّى يتعافى

59
00:05:11,210 --> 00:05:12,880
حتّى هو لا يخلو مِن
.الوقفات النّبيلة

60
00:05:13,820 --> 00:05:20,920
هاجيمي في الخارج، وغين-سان ينصرف لفلاحة
.الحُقول، أمّا يامانامي-سان فغارقٌ في الكتابة

61
00:05:30,390 --> 00:05:32,720
أدّيت مُهمّتك على
.أكمل وجهٍ يا هاجيمي

62
00:05:32,720 --> 00:05:33,840
!وداعًا

63
00:05:34,080 --> 00:05:36,860
!إلى اللّقاء يا هاجيمي-تشان

64
00:05:37,840 --> 00:05:39,980
.لست بحاجةٍ لتوديعكم

65
00:05:40,300 --> 00:05:41,360
.تبًا

66
00:05:43,680 --> 00:05:48,140
وهكذا، أتمّ هاجيمي مُهمّة
.الحراسة بسلامٍ

67
00:05:48,840 --> 00:05:49,840
...ولكن

68
00:05:50,300 --> 00:05:55,650
في تلك اللّيلة، نال ثلاثة
.مُغتالين مِن حياة أنيجاكوجي

69
00:05:56,780 --> 00:06:01,860
وهي الحادثة الّتي عُرفت لاحقًا
."بـ "حادثة خارج بوّابة ساكوهي

70
00:06:03,920 --> 00:06:05,620
قُتل أحد نُبلاء القصر؟

71
00:06:09,210 --> 00:06:13,010
وتُشير الشّائعات إلى أنّ الفاعل هو
.تاناكا شينبي، مغتالٌ مِن مقاطعة ساتسوما

72
00:06:13,210 --> 00:06:16,520
يبدو أنّ رجال آيزو في
.حالة استنفارٍ قُصوى لتعقّبه

73
00:06:20,430 --> 00:06:22,170
.يا للأسف

74
00:06:22,170 --> 00:06:24,450
.إنّها جريمةٌ تُدمي القلب

75
00:06:25,590 --> 00:06:29,200
،أرسلت إيروها هذه
.إنّها رسالةٌ مُوجّهة إليك

76
00:06:38,130 --> 00:06:41,030
"!مرحبًا، هاجيمي-تشان"

77
00:06:41,400 --> 00:06:44,880
!أنا فتاتك المُفضّلة، إيروها"
"كيف حالك؟

78
00:06:47,170 --> 00:06:51,410
،أُخمّن أنّ معنويّاتك في الحضيض"
".لذا ارتأيت أن أُدخل البهجة على قلبك

79
00:06:52,480 --> 00:06:54,950
"...بشأن أنيجاكوجي-ساما"

80
00:06:56,370 --> 00:06:58,880
"،تبنّى طفلًا مُنذ أيّامٍ"

81
00:06:59,610 --> 00:07:01,880
".صبيًا صغيرًا في الرّابعة مِن عُمره"

82
00:07:03,030 --> 00:07:06,060
وفي اليوم التّالي لتصدّيك"
"،لأولئك الصّعاليك

83
00:07:06,880 --> 00:07:09,820
".لعبا الكيماري معًا لأوّل مرّةٍ"

84
00:07:10,490 --> 00:07:13,990
كان أنيجاكوجي-ساما"
".في غاية السّعادة

85
00:07:15,510 --> 00:07:21,730
أعتقد أنّ مُساعدتك له ليعيش ولو ليومٍ"
".واحد إضافيّ كان عملًا جليلًا لا يُقدّر بثمنٍ

86
00:07:29,940 --> 00:07:31,560
.تاناكا شينبي

87
00:07:39,880 --> 00:07:44,520
،نيو-كون
.كانت ناغي-سان قلقةً عليك

88
00:07:45,120 --> 00:07:49,120
اعتقدت أنّ رحيلها دُون كلمة وداعٍ
.سيكون أشدّ إيلامًا لك

89
00:07:50,160 --> 00:07:53,280
لذا انصبّ غضبها عليك
.بتلك القسوة

90
00:07:54,080 --> 00:07:56,040
.كانت تُعاملك كرجلٍ بالغ

91
00:08:00,700 --> 00:08:03,540
أَتنوي مُجابهة تاناكا شينبي؟

92
00:08:03,540 --> 00:08:08,290
،كُفّ عن ذلك يا فتى
.شينبي السّفاح خصمٌ لا يُستهان به

93
00:08:08,690 --> 00:08:10,290
.إنّه سيّافٌ بارع مِن مدرسة جيغن

94
00:08:10,520 --> 00:08:11,580
.يُمكنك إخباره

95
00:08:12,400 --> 00:08:13,250
.فوجيتا-سان

96
00:08:15,160 --> 00:08:17,820
،سايتو-سان
.أرغب في مَعونتك

97
00:08:20,400 --> 00:08:22,480
.حاول أن تُجاريني يا فوجيتا

98
00:08:23,590 --> 00:08:24,010
!أجل

99
00:08:27,960 --> 00:08:31,720
أَتعلم، لا أظنّ أنّك
.اقترفت ذنبًا

100
00:08:33,040 --> 00:08:36,320
رُبّما لم تملك الصّلابة الكافية لتحمّل
...تبعات الموقف، ولكن رُغم ذلك

101
00:08:37,980 --> 00:08:45,040
قبل انضمامي إلى المِيبورو، كُنت قد استسلمت
.لليأس، ظننت أنّ هذه هي طبيعة الحياة فحسب

102
00:08:45,660 --> 00:08:48,680
لكنّك مَن علمني أنّ
لدينا أرواحًا، أَتذكر؟

103
00:08:52,700 --> 00:08:56,470
إنّه لشعورٌ مقيت كيف انتهى
.بنا الحال هذه المرّة

104
00:08:57,130 --> 00:08:59,280
ولا أجد ما أقوله لك
،حِيال هذا المُصاب

105
00:09:01,010 --> 00:09:07,210
ولكن ما الحيلة سوى الاستمرار في
السّعي نحو... مبادئنا، كما أعتقد؟

106
00:09:08,900 --> 00:09:13,760
،حتّى لو جرت الرّياح بما لا نشتهي
،ومهما تعاظم خذلاننا

107
00:09:15,800 --> 00:09:20,860
فماذا بيدنا فعله غير ذلك؟

108
00:09:24,810 --> 00:09:27,720
تبًا، ما خطبك بحقّ الجحيم؟

109
00:09:30,790 --> 00:09:32,710
.أحسنت قولًا يا تارو

110
00:09:34,250 --> 00:09:35,450
.أنا أوافقك الرّأي

111
00:09:41,780 --> 00:09:43,560
.هذا هو مخبأ شينبي

112
00:09:44,420 --> 00:09:46,060
،سنقتحم المكان مِن الباب الأمامي

113
00:09:46,990 --> 00:09:48,890
.أمّا البقية فليُطوّقوا المخرج الخلفي

114
00:09:49,260 --> 00:09:50,280
.إيّاكم أن يستشعر وجودكم

115
00:09:50,280 --> 00:09:50,820
.أجل، يا سيّدي

116
00:09:53,410 --> 00:09:56,080
سنتريّث حتّى يخفت نشاطه
.مع حُلول المساء

117
00:10:06,530 --> 00:10:07,350
،معذرةً

118
00:10:07,720 --> 00:10:08,840
.يامانامي-سان

119
00:10:09,840 --> 00:10:11,080
.شعرك بحاجةٍ للقصّ

120
00:10:22,310 --> 00:10:25,210
.أسأت التّقدير تمامًا

121
00:10:28,920 --> 00:10:34,570
اندفعت بعماءٍ، أُباهي بمبادئي
.هنا وهناك فحسب وأُثير الفوضى

122
00:10:35,940 --> 00:10:41,110
،لم تُكلّل مساعيّ بالنّجاح إلّا بمحض الصّدفة
.وبفضل العون الّذي تلقّيته ممّن حولي

123
00:10:41,540 --> 00:10:43,880
،تاناكا شينبي
.أنت رهن الاعتقال

124
00:10:44,120 --> 00:10:45,490
ومَن ذا الّذي يقول ذلك؟

125
00:10:46,540 --> 00:10:48,320
ما الخطأ في أن يكون للمرء
مبادئٌ يسعى لأجلها؟

126
00:10:49,240 --> 00:10:52,870
لكن حتّى مبادئي تبيّن لي
.أنّها هشّةٌ وضبابيّة

127
00:10:53,780 --> 00:10:55,720
.لم تكن بمكانةٍ تستحقّ المُجاهرة بها

128
00:10:59,410 --> 00:11:04,110
إنّما يرتقي البشر عبر
.مبادئهم وفلسفتهم

129
00:11:04,440 --> 00:11:06,440
أليس هذا جوهر نُبلنا ومَكمن جمالنا؟

130
00:11:07,610 --> 00:11:09,760
أمّا النّتائج والعواقب فليست
.سوى تبعاتٍ لا أكثر

131
00:11:10,950 --> 00:11:12,770
،نحن لسنا حيواناتٍ

132
00:11:13,490 --> 00:11:15,690
.بل نملك حُلمًا نُسمّيه الأمل

133
00:11:16,520 --> 00:11:22,170
مواقفك وأفعالك في سبيل تحقيقه
.هي ما يصنع كيانك الإنسانيّ

134
00:11:23,650 --> 00:11:27,110
.لا تنسَ أبدًا: أنّك أنجزت مُهمّتك

135
00:11:28,320 --> 00:11:29,850
.وحقٌّ لك أن تفخر

136
00:11:30,440 --> 00:11:32,200
.لا تتوقّف عن المُضيّ في دربك

137
00:11:34,270 --> 00:11:37,670
فهذا هو معنى أن
.تملك رُوحًا سامية

138
00:11:51,370 --> 00:11:52,280
.ناغي-سان

139
00:11:57,300 --> 00:12:00,120
.يوتارو-سان، ناووزومي-سان

140
00:12:04,560 --> 00:12:06,240
.شُكرًا لك على كُلّ شيءٍ

141
00:12:14,100 --> 00:12:20,020
أُلقي القبض على تاناكا شينبي
.ووُجّهت إليه تهمة اغتيال أنيجاكوجي

142
00:12:20,020 --> 00:12:24,510
،وعندما عُرض عليه دليل غمد السّيف
.أنهى حياته بنفسه في الحال

143
00:12:25,620 --> 00:12:32,300
،امتدّت أصابع الاتّهام لتطال مُقاطعة ساتسوما
.ممّا أفقدها نُفوذها في القصر الإمبراطوري

144
00:12:33,150 --> 00:12:37,560
وما تزال الحقيقة غامضةً
.حتّى يومنا هذا

145
00:12:48,560 --> 00:12:50,280
!أرجوك، اعف عنّي يا سيّدي

146
00:12:50,280 --> 00:12:51,640
—غلبني النّعاس و

147
00:12:53,550 --> 00:12:56,750
سأصبح أقوى، سأبلغ مّن القوّة مبلغًا لا يجرؤ
.معه أحدٌ على أن يُقارعني الحُجّة

148
00:12:58,000 --> 00:12:59,860
سأكون قويًا لدرجة لا يستطيع فيها
.كائنٌ مَن كان أن يعترض

149
00:13:01,710 --> 00:13:03,590
.نـ-نيو

150
00:13:05,920 --> 00:13:07,440
.معذرةً لأنّني أثرت قلقك

151
00:13:08,200 --> 00:13:10,580
.شُكرًا لك، أنا بخير الآن

152
00:13:12,560 --> 00:13:14,690
!نيو

153
00:13:16,460 --> 00:13:18,870
!يا للرّاحة

154
00:13:20,120 --> 00:13:23,540
كنت مذعورًا مِن شدّة
!القلق عليك، أيّها الأحمق

155
00:13:21,430 --> 00:13:23,310
سأكتفي بحماية ما يقع
.في مدى يدي حاليًا

156
00:13:28,680 --> 00:13:30,900
يا رجل، لا بُدّ أن حملًا ثقيلًا
.قد أُزيح عن كاهلك

157
00:13:30,900 --> 00:13:32,560
!أنا... لم أكن قلقًا قطّ

158
00:13:32,560 --> 00:13:34,080
ألست سعيدًا؟

159
00:13:34,920 --> 00:13:36,940
.تبًا، هذا مؤلمٌ

160
00:13:41,160 --> 00:13:43,620
"...ملاحظةٌ: هاجيمي-تشان"

161
00:13:44,300 --> 00:13:46,390
".أنا متيقّنةٌ أنّ أخي سيكون بخير"

162
00:13:47,080 --> 00:13:48,250
!مرحبًا

163
00:13:48,890 --> 00:13:51,090
".لست قلقةً عليه"

164
00:13:51,350 --> 00:13:52,600
!هاجيمي-كون

165
00:13:53,080 --> 00:13:54,850
أين كنت بحقّ السّماء؟

166
00:13:58,000 --> 00:14:02,320
!يقولون إنّ معاطفنا قد جهزت أخيرًا
!زيّ المِيبورو الّذي طلبناه

167
00:14:03,900 --> 00:14:04,650
"...في نهاية المَطاف"

168
00:14:05,540 --> 00:14:08,000
مهلًا! ما بالك تمشي
بهذه الطّريقة الغريبة؟

169
00:14:06,880 --> 00:14:10,600
".لديه رفاقٌ مثلك إلى جانبه..."

170
00:14:08,300 --> 00:14:10,320
.كما أنّك تبدو مُنهكًا للغاية

171
00:14:10,320 --> 00:14:11,320
.كُفّ عن الثّرثرة

172
00:14:11,320 --> 00:14:12,920
.هيّا بنا الآن لنُحضر تلك المعاطف

173
00:14:12,920 --> 00:14:15,660
،ليس مِن ذلك الاتّجاه يا هاجيمي-كون
.بل مِن هنا

174
00:14:15,660 --> 00:14:16,520
!أعلم ذلك

175
00:14:17,700 --> 00:14:24,040
في مايو مِن عام 1863، تمكّنت مُقاطعة
...تشوشو مِن إقناع الشّوغون إيموتشي

176
00:14:24,400 --> 00:14:28,130
بأن يقسم على طرد البرابرة
.في حضرة الإمبراطور

177
00:14:28,940 --> 00:14:35,140
وفور سماعها لهذا القَسم، شنّت تشوشو
.قصفًا على السّفن الأجنبيّة في مضيق باكان

178
00:14:35,630 --> 00:14:38,150
،وجّهوا ضربةً قاصمة

179
00:14:38,840 --> 00:14:43,640
ومِن هنا بدأت تلك الأزمنة الفوضويّة
.تتسارع أكثر مِن أيّ وقتٍ مضى

180
00:14:44,680 --> 00:14:47,190
إذن، أنتم تُريدون منّي
العودة إلى إيدو؟

181
00:14:47,550 --> 00:14:51,240
أجل يا مولاي. فالصّدام مع
.القُوى الأجنبيّة بات حتميًا

182
00:14:51,240 --> 00:14:57,000
وأيّ أمرٍ قد يعلو أهمّيةً عن عودتكم إلى
إيدو لتولّي زِمام الدّفاع عن الخليج؟

183
00:14:57,380 --> 00:14:59,760
.ليكُن ذلك، لا بأس

184
00:15:00,000 --> 00:15:01,420
.طوع أمرك يا مولاي

185
00:15:02,830 --> 00:15:05,760
،يا للهول
.جيّدٌ أنّه لم يُثر ضجّةً

186
00:15:06,200 --> 00:15:08,520
.نضج حقًا

187
00:15:11,320 --> 00:15:12,250
.كاجيمارو

188
00:15:12,430 --> 00:15:13,260
.أنا هنا يا مولاي

189
00:15:13,260 --> 00:15:15,640
!إذن، هذا كُلّ شيءٍ؟
!انتهوا منّي الآن؟

190
00:15:15,890 --> 00:15:17,680
!تبًا لـ تشوشو

191
00:15:17,680 --> 00:15:20,690
!فعلها أولئك الحمقى حقًا

192
00:15:20,690 --> 00:15:22,880
.اهدأ يا مولاي، أرجوك

193
00:15:22,880 --> 00:15:26,110
!نبلاءٌ بلا عُقولٍ! وإمبراطورٌ أحمق

194
00:15:28,910 --> 00:15:30,030
.إنّما هي لُعبة أموالٍ لا أكثر

195
00:15:30,200 --> 00:15:31,850
لُعبة أموالٍ يا مولاي؟

196
00:15:32,830 --> 00:15:35,160
!مِن الواضح أنّ تشوشو ستُهزم

197
00:15:35,160 --> 00:15:37,370
!وحينئذٍ سيُطالب المُنتصرون بتعويضاتٍ

198
00:15:37,370 --> 00:15:40,000
لكن تشوشو لن تكون
!قادرةً على الدّفع

199
00:15:40,360 --> 00:15:43,340
وستُجبر الشّوغونية على
!تحمّل دُيونهم

200
00:15:44,880 --> 00:15:47,630
حسنًا، هذا جانبٌ ممّا تهيّأت
.لمُواجهته عند قُدومي هنا

201
00:15:48,510 --> 00:15:52,430
لكن أسفي الوحيد على
.مدينة كيوتو

202
00:15:52,870 --> 00:15:54,890
،بعد مقتل أنيجاكوجي

203
00:15:55,760 --> 00:15:59,350
ستتهافت الفصائل أكثر فأكثر
.إلى العُنف لفرض مطالبها الآن

204
00:16:00,160 --> 00:16:02,620
وستتوالى المآسي فيما بعد
.بشكلٍ لم نعهده

205
00:16:03,420 --> 00:16:07,240
،بخُصوص هذا الشّان
.أرى أنّه لا داعي للقلق أبدًا

206
00:16:10,440 --> 00:16:11,080
ماذا؟

207
00:16:16,500 --> 00:16:18,340
!مهلًا يا نيو

208
00:16:18,340 --> 00:16:20,900
لدينا قطع المانجو تلك لنتسلّى
.بها، هيّا نلتهمها الآن

209
00:16:20,900 --> 00:16:23,460
ماذا؟
أما زِلت تواصل التّدريب؟

210
00:16:23,460 --> 00:16:27,580
،نصحته بأن يلتقط أنفاسه
.لكن انظر إليه، لا يتوقّف

211
00:16:29,680 --> 00:16:31,770
،سأُواظب على التّلويح بسيفي
.مرّةً بعد مرّة

212
00:16:32,350 --> 00:16:33,760
.فليس لديّ ما أفعله سوى ذلك

213
00:16:35,240 --> 00:16:36,510
،أعرف أنّني هشٌّ

214
00:16:37,420 --> 00:16:40,130
وأُدرك أنّني نجوت مِن صعابٍ
.كثيرة لمُجرّد أنّني صبيّ

215
00:16:42,110 --> 00:16:44,600
لأجل مَن؟ ولماذا؟

216
00:16:45,590 --> 00:16:48,360
لأجلي؟ أم لإشباع رغبتي؟

217
00:16:50,120 --> 00:16:51,080
.لا يهمّ، فهذا كافٍ جدًا

218
00:16:52,110 --> 00:16:54,450
.سأمضي بهذا الأمر إلى أقصى مَداه

219
00:16:56,420 --> 00:16:57,860
.تغيّرت ضرباته

220
00:16:58,740 --> 00:16:59,670
—نيو-كون

221
00:16:59,670 --> 00:17:00,700
!مهلًا

222
00:17:01,030 --> 00:17:03,080
.اللّورد إيموتشي سيعود إلى إيدو

223
00:17:08,080 --> 00:17:10,040
ماذا سيحلّ بنا؟

224
00:17:10,780 --> 00:17:12,460
لماذا علينا أن نهتمّ؟

225
00:17:12,850 --> 00:17:19,020
لأنّ جماعة الرّوشيغومي جاءت إلى
.كيوتو في الأصل لحماية الشّوغون

226
00:17:19,020 --> 00:17:21,560
ماذا؟
إذن... هل سترحلون؟

227
00:17:21,560 --> 00:17:23,680
ماذا سيحدث لي؟

228
00:17:23,930 --> 00:17:26,790
ماذا عن مجموعة سيريزاوا؟
هل يُمكننا إقناعهم؟

229
00:17:29,820 --> 00:17:34,190
أعتقد أنّه مِن المنطقيّ
.أن نعود نحن أيضًا إلى إيدو

230
00:17:34,720 --> 00:17:35,400
.كلا

231
00:17:36,720 --> 00:17:39,040
،حماية الشّوغون مُجرّد ذريعةٍ

232
00:17:39,970 --> 00:17:42,880
.فلنا منهجٌ نسير عليه بمحض إرادتنا

233
00:17:51,870 --> 00:17:54,630
!أفسحوا الطّريق لمولانا الشّوغون

234
00:18:00,090 --> 00:18:01,720
.إنّه اللّورد إيموتشي

235
00:18:01,720 --> 00:18:02,800
أَهذا هو؟

236
00:18:02,800 --> 00:18:05,600
.له هيبةً تليق بمقامه حقًا

237
00:18:06,000 --> 00:18:09,090
.لكن، هناك رجلٌ مُريب يُرافقه

238
00:18:09,440 --> 00:18:12,540
.إنّ لمولانا طلعةً مهيبةً لا شكّ

239
00:18:12,540 --> 00:18:13,440
.بالطّبع

240
00:18:13,440 --> 00:18:15,370
هل مولانا راحلٌ بهذه السّرعة؟

241
00:18:16,350 --> 00:18:18,410
ما الغرض مِن مجيئه إلى هنا أصلًا؟

242
00:18:20,200 --> 00:18:22,360
!يا لها مِن وقاحةٍ
مَن الّذي تجرّأ على قول ذلك؟

243
00:18:24,170 --> 00:18:26,090
.لا بأس، دعوه وشأنه

244
00:18:26,090 --> 00:18:27,620
!آه، آه، آه

245
00:18:31,640 --> 00:18:35,640
،تماديت في قولك كثيرًا
ألا تظنّ ذلك؟

246
00:18:36,560 --> 00:18:40,030
سيريزاوا-سان، لا ينبغي لنا أن
.نُعكّر صفو موكب الشّوغون

247
00:18:40,960 --> 00:18:41,770
.نيو

248
00:18:43,720 --> 00:18:45,720
،في لقائنا القادم
.ستكون هالكًا لا محالة

249
00:18:47,380 --> 00:18:52,720
،لا داعي للقلق، لم يكن مُتمرّدًا
.بل مُجرّد صُعلوكٍ نكرة، لا تُعره أيّ اهتمامٍ

250
00:19:07,870 --> 00:19:10,280
،أنت مَن اختار هذه الكلمة
كوندو-سان؟

251
00:19:10,670 --> 00:19:13,920
قلبٌ

252
00:19:10,670 --> 00:19:13,920
أسمى

253
00:19:10,670 --> 00:19:13,920
عدلٌ

254
00:19:10,670 --> 00:19:13,920
أنيقٌ

255
00:19:10,670 --> 00:19:13,920
حربٌ

256
00:19:10,670 --> 00:19:13,920
حاسمٌ

257
00:19:10,670 --> 00:19:13,920
لهبٌ

258
00:19:10,670 --> 00:19:13,920
ولاءٌ

259
00:19:10,670 --> 00:19:13,920
سماءٌ

260
00:19:10,940 --> 00:19:13,530
أجل، اخترتها مِن بين
.ما دوّنته أنت

261
00:19:14,300 --> 00:19:17,040
رُبّما تتقلّب بنا الأزمان، لكن حياتنا
.ستمضي في خطّ مُستقيمِ دومًا

262
00:19:17,650 --> 00:19:18,740
،هذا هو نهجنا

263
00:19:21,170 --> 00:19:22,310
.ونهجك أيضًا

264
00:19:24,360 --> 00:19:28,020
جاءوا إلى كيوتو في الأصل
،لحماية مقامك

265
00:19:28,640 --> 00:19:32,480
لكنّهم يسعون في الوقت الرّاهن
.لتحسين النّظام وفرض القانون هنا

266
00:19:34,400 --> 00:19:42,790
،وكما كان مُتوقّعًا، آثروا البقاء، لذا
.ستكون هذه المدينة آمنةً، على أقلّ تقديرٍ

267
00:19:43,080 --> 00:19:46,780
.فهمت، إذن، سيستقرّون هنا

268
00:19:47,810 --> 00:19:48,480
.أجل يا مولاي

269
00:19:52,770 --> 00:19:55,080
ما هو جوهر السّيف في نظرك؟

270
00:19:57,080 --> 00:20:00,140
أخبرني بجوابك حين
.نلتقي مرّةً أُخرى

271
00:20:02,200 --> 00:20:05,520
نيو، أَهذه هي إجابتك؟

272
00:20:04,970 --> 00:20:09,020
إخلاصٌ

273
00:20:14,160 --> 00:20:15,230
.تبدّل حاله

274
00:20:16,360 --> 00:20:19,960
،لا أملك وصفًا دقيقًا
.لكن ثمّة شيئًا قد اختلف

275
00:20:21,360 --> 00:20:21,960
.بمقدوري إدراك ذلك

276
00:20:22,820 --> 00:20:24,840
.بل لا شكّ أنّ الجميع يُدركونه

277
00:20:25,920 --> 00:20:26,680
،حتّى أنتم

278
00:20:29,060 --> 00:20:29,910
،وأنتما

279
00:20:32,320 --> 00:20:33,560
.وأنتم جميعًا

280
00:20:42,680 --> 00:20:44,150
ما رأيك بهذا؟

281
00:20:44,150 --> 00:20:45,310
!لن تهزمني أبدًا

282
00:20:45,560 --> 00:20:46,680
!تبًا

283
00:20:46,680 --> 00:20:48,310
!لا تضرب بجدّيةٍ

284
00:20:48,810 --> 00:20:51,170
.هيّا، لا تكن ضعيفًا هشًا

285
00:20:55,520 --> 00:21:00,560
الفتى لا يبلغ مَبلغ الرّجال
،إلّا عندما يفقد شيئًا غاليًا

286
00:21:01,360 --> 00:21:06,920
حينما يتجرّع مَرارة الخسارة
.ويتجاوزها بنفسه

287
00:21:23,500 --> 00:21:24,470
!إنّي أُعوّل عليكم

288
00:21:27,400 --> 00:21:28,140
مولاي؟

289
00:21:30,390 --> 00:21:36,390
إخلاصٌ

290
00:21:41,170 --> 00:21:42,230
.لن نخذل ظنّ مقامك

291
00:21:44,900 --> 00:21:49,910
المِيثاق الأزرق