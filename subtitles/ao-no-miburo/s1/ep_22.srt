1
00:00:11,130 --> 00:00:12,360
!نارٌ

2
00:00:16,520 --> 00:00:18,540
ما العمل؟
.ستلتهم النّيران كُلّ شيءٍ

3
00:00:18,880 --> 00:00:22,290
،اسكبوا الماء على المباني المُجاورة
.فإن لم يجد ذلك نفعًا، فاهدموها

4
00:00:22,290 --> 00:00:23,390
!لا تدعوا النّيران تنتشر

5
00:00:23,390 --> 00:00:24,480
!كوندو-سان

6
00:00:24,690 --> 00:00:26,550
تارو، ما الّذي يحدث هنا؟

7
00:00:26,680 --> 00:00:30,300
!الوضع كارثيّ، النّيران تستعر بشدّةٍ
.وقد فقدت أثر نيو في هذه المَعمة

8
00:00:30,300 --> 00:00:31,950
.نحتاج لمُساعدتك هنا

9
00:00:31,950 --> 00:00:32,650
.ناولني هذا

10
00:00:32,650 --> 00:00:33,040
ماذا؟

11
00:00:37,760 --> 00:00:39,920
،أُقسم
!لسوف أُخمد هذه النّيران

12
00:00:41,670 --> 00:00:43,560
!ها قد انطلق

13
00:00:43,560 --> 00:00:45,140
!إنّه كوندو مِن جماعة المِيبورو

14
00:00:45,370 --> 00:00:46,810
!اتبعوه أيّها الرّجال

15
00:00:48,400 --> 00:00:49,560
!جدّتي

16
00:00:49,560 --> 00:00:51,950
!جدّتي، هناك أمرٌ طارئ

17
00:00:53,260 --> 00:00:55,120
!أجيبي يا جدّتي، أفيقي

18
00:00:56,900 --> 00:00:58,290
ما بِك يا نيو؟

19
00:00:58,290 --> 00:01:00,880
.الوقت متأخّرٌ على هذا الصّخب

20
00:01:02,830 --> 00:01:04,610
ماذا جرى لك؟

21
00:01:06,150 --> 00:01:08,100
.مؤلمٌ، مؤلمٌ

22
00:01:08,570 --> 00:01:10,240
ماذا؟ هل جاءها المخاض؟

23
00:01:10,240 --> 00:01:12,090
.يُؤلمني، يُؤلمني للغاية

24
00:01:12,080 --> 00:01:13,130
.سأُلقي نظرةً

25
00:01:14,730 --> 00:01:16,960
.ستكونين بخيرٍ الآن يا ناغي-سان

26
00:01:17,440 --> 00:01:19,670
.ظهر رأس الطّفل

27
00:01:19,670 --> 00:01:21,940
!احملوها إلى الدّاخل يا رجال

28
00:01:22,110 --> 00:01:22,720
.حسنًا

29
00:01:22,110 --> 00:01:22,720
!أجل

30
00:01:36,780 --> 00:01:41,080
ذئاب ميبو الزّرق

31
00:03:00,560 --> 00:03:03,140
حريقٌ على ضفّة النّهر؟

32
00:03:06,310 --> 00:03:10,920
ألم تكن خُطّتك إحراق المدينة قاطبةً؟

33
00:03:12,170 --> 00:03:16,160
فهمت الآن، أنت تُضرم النّار
.في دارك الملعون

34
00:03:18,840 --> 00:03:20,760
.حسنًا، أنا أُدرك ما تمرّ به

35
00:03:21,010 --> 00:03:24,300
فأن تُولد مِن نسل السّاموراي
.لهو نوعٌ مِن اللّعنة

36
00:03:25,070 --> 00:03:29,270
لم يسعني إلّا أن أُلاحظ
.أنّ أتباعك قد طعنوا في السّن

37
00:03:30,920 --> 00:03:33,370
هل ضاقوا ذرعًا بعالمٍ يسوده السّلام؟

38
00:03:33,550 --> 00:03:37,360
أم هم خائفون مِن الذّبول والموت
دُون تحقيق أيّ إنجازٍ يُذكر؟

39
00:03:37,630 --> 00:03:39,110
.أَغلق فمك

40
00:03:39,560 --> 00:03:42,760
أَتهيّئ لهم ميتةً تليق بالسّاموراي؟

41
00:03:42,760 --> 00:03:43,860
.الزم الصّمت

42
00:03:44,090 --> 00:03:47,120
،أيّها الأحمق
ألا تكفّ عن إضاعة وقتي؟

43
00:03:47,350 --> 00:03:49,450
!اخرس

44
00:03:50,580 --> 00:03:52,680
!مُت

45
00:03:58,060 --> 00:04:00,980
.رُؤيتك تُثير حنقي

46
00:04:01,780 --> 00:04:06,910
،إن كُنت ساخطًا إلى هذه الدّرجة
.فسأضع حدًا لحياتك بنفسي

47
00:04:11,320 --> 00:04:12,870
...عشر سنواتٍ مضت

48
00:04:14,180 --> 00:04:15,000
.مُنذ ذلك اليوم

49
00:04:15,830 --> 00:04:17,680
.وداعًا يا يوتارو

50
00:04:19,460 --> 00:04:20,900
!انتظر، ني-سان

51
00:04:23,810 --> 00:04:29,920
رحلتي شرقًا مِن كيوتو بدأت بوقع
.السّفن السّوداء الّذي زلزل كياني

52
00:04:32,160 --> 00:04:34,620
صُفّوا مُصارعي السّومو
!على طول الضّفة

53
00:04:35,020 --> 00:04:36,440
!ليس لدينا ما يكفي مِن المدافع

54
00:04:37,000 --> 00:04:39,680
،انزعوا أجراس المعابد
!سنُوهمهم بقُوّتنا

55
00:04:40,210 --> 00:04:42,430
!اشووا سمك الكوسايا واطردوهم بعيدًا

56
00:04:42,740 --> 00:04:44,720
ولكن هل ستبلغ نتانة الرّائحة
ذلك المدى؟

57
00:04:44,720 --> 00:04:46,320
!العِبرة في الفعل لا في النّتيجة

58
00:04:46,320 --> 00:04:47,370
.حسنًا يا سيّدي

59
00:04:47,930 --> 00:04:50,180
مقرّ حاكم أوراغا

60
00:04:48,560 --> 00:04:50,190
ماذا تفعل السّلطات؟

61
00:04:50,500 --> 00:04:52,440
لماذا لا يخرجون لخوض المعركة؟

62
00:04:52,440 --> 00:04:57,940
مقرّ
حاكم
أوراغا

63
00:04:52,760 --> 00:04:55,210
،ما نفع السّاموراي
إن لم يكونوا لمثل هذه الأوقات؟

64
00:04:55,210 --> 00:04:56,410
!كفى، تراجع

65
00:04:56,410 --> 00:04:57,940
،إن كنت ترغب في الذّهاب
!فاسبح

66
00:05:02,560 --> 00:05:03,610
.لا جدوى

67
00:05:03,610 --> 00:05:05,800
.ظننت أنّي هالكٌ لا محالة

68
00:05:06,890 --> 00:05:09,710
.كان العالم على أعتاب تحوّلٍ جسيم

69
00:05:10,310 --> 00:05:13,200
صارت السّيوف هباءً أمام
.مدافع تلك السّفن السّوداء

70
00:05:14,120 --> 00:05:15,480
،لكن
ماذا كان عساي أن أفعل؟

71
00:05:16,710 --> 00:05:20,710
دوجو القوّة القاهرة

72
00:05:19,420 --> 00:05:20,360
القوّة القاهرة؟

73
00:05:20,720 --> 00:05:24,150
.أنا المُعلّم هنا

74
00:05:24,410 --> 00:05:29,230
خدم أسلافي في فرقة
.فُرسان تاكيدا الشّهيرة

75
00:05:27,160 --> 00:05:29,230
.لا تُكلّف نفسك ما لا تطيق يا جدّي

76
00:05:29,400 --> 00:05:31,370
.أنت تعلم أنّ بصرك قد تلاشى

77
00:05:32,630 --> 00:05:35,110
،ومع ذلك
...فإنّ نهج السّيف الّذي اتّبعته

78
00:05:38,320 --> 00:05:39,500
.كان بديعًا

79
00:05:41,740 --> 00:05:43,240
...كان السّيف حقًا

80
00:05:47,740 --> 00:05:50,200
.جديرًا بأن أبذل رُوحي لأجله

81
00:06:01,520 --> 00:06:03,550
...إتقان فنّ السّيف

82
00:06:06,960 --> 00:06:08,130
.كان له ثقلٌ لا يُقدّر

83
00:06:08,950 --> 00:06:12,130
تعلّمت أشياء كثيرةً في رحلتي
.لنيل هذه المكانة

84
00:06:12,540 --> 00:06:17,060
الزم المخزن! سيُثير النّاس ضجةً
!إن علموا أنّك مبتور الذّراع

85
00:06:17,440 --> 00:06:21,440
،حتّى بين مَن يُدعون ساموراي
.وُجِد منبوذون

86
00:06:25,890 --> 00:06:27,900
هل تُريد أن أُطلق سراحك؟

87
00:06:33,200 --> 00:06:36,370
كانوا ينوون بيعك لأصحاب
.عُروض المُشوّهين

88
00:06:38,280 --> 00:06:41,290
كانوا وصمة عارٍ للسّاموراي
.في كُلّ مكان

89
00:06:41,660 --> 00:06:43,460
.لذا قتلتهم جميعًا

90
00:06:46,510 --> 00:06:47,930
،أنا ناووزومي

91
00:06:48,580 --> 00:06:51,560
وإن لم يُعجبك الأمر، فحاول أن
.تُصفّي حسابك معي يومًا ما

92
00:06:54,430 --> 00:06:56,440
وُجِد أناسٌ يُكافحون فقط
.ليبقوا على قيد الحياة

93
00:07:03,840 --> 00:07:05,320
.لا تقلقوا

94
00:07:05,650 --> 00:07:08,790
.ما علينا سوى حشد قُوانا مِن جديد

95
00:07:10,650 --> 00:07:13,160
الريسّيدان

96
00:07:10,650 --> 00:07:13,160
طُموح

97
00:07:20,770 --> 00:07:23,000
.لقّبتنا بجماعة الريسّيدان

98
00:07:23,830 --> 00:07:26,490
!أنا متيقنٌ أنّ يومنا قادمٌ لا محالة

99
00:07:29,160 --> 00:07:33,260
،ولكن رُغم طول انتظارنا
.لم تتّخذ الشّوغونية أيّ إجراء

100
00:07:34,050 --> 00:07:39,240
حتّى بعد أن تولّى الشّوغون الرّابع عشر إيموتشي
.زمام الحُكم، ظلّ كُلّ شيءٍ على حاله

101
00:07:40,920 --> 00:07:43,400
ما نفع كدّنا وتدريبنا
الّذي خُضناه إذن؟

102
00:07:43,860 --> 00:07:46,760
يقولون إنّ كيوتو هي
.مقرّ الحُكم هذه الأيّام

103
00:07:47,180 --> 00:07:49,490
بمقدورنا إحداث أمرٍ جلل
.إذا ذهبنا إلى هُناك

104
00:07:50,000 --> 00:07:52,990
،تمهّلوا قليلًا بعد
.سأُوافيكم بالمُستجدات

105
00:07:53,770 --> 00:07:57,170
لكن خيانة نكراء كانت
.تتربّص بي هُناك

106
00:07:55,530 --> 00:07:57,080
مدرسة كيوهاتشي

107
00:07:59,500 --> 00:08:01,730
،عشر سنواتٍ مضت
.وهذا المكان لم يتغيّر أبدًا

108
00:08:01,730 --> 00:08:02,430
،يا للعجب

109
00:08:03,440 --> 00:08:05,780
هل أنت أخو يوتارو-سان؟

110
00:08:12,250 --> 00:08:14,770
،لا يُخالجني أدنى شكٍ
أليس كذلك؟

111
00:08:15,000 --> 00:08:19,020
أخبرني يوتارو-سان أنّك رجلٌ
.بكُلّ ما تحمله الكلمة مِن معنى

112
00:08:20,240 --> 00:08:22,020
مَن تكونين؟

113
00:08:22,370 --> 00:08:23,810
،اسمي ناغي

114
00:08:24,160 --> 00:08:26,320
.أنا زوجة يوتارو-سان

115
00:08:26,320 --> 00:08:26,970
زوجته؟

116
00:08:29,200 --> 00:08:31,310
ماذا؟ ناووزومي-نيسان؟

117
00:08:32,480 --> 00:08:34,150
!يا للهول
!تلك النّدبة على جبينك

118
00:08:34,150 --> 00:08:35,440
.يوتارو

119
00:08:35,440 --> 00:08:37,700
...أنا

120
00:08:39,290 --> 00:08:40,980
.أنت لم تتغيّر أيضًا

121
00:08:41,300 --> 00:08:42,760
.أنا مُجرّد عابرٍ لا أكثر

122
00:08:42,760 --> 00:08:43,560
.تمهّل

123
00:08:43,560 --> 00:08:46,300
،جئت مِن مكانٍ بعيد
.فتفضّل بالدّخول على الأقلّ

124
00:08:46,650 --> 00:08:48,190
.سيَسعد والدي برؤيتك كثيرًا

125
00:08:48,190 --> 00:08:49,060
.لا حاجة لذلك

126
00:08:49,460 --> 00:08:50,790
.لا تكن هكذا

127
00:08:51,880 --> 00:08:54,310
!متّعوا أنظاركم
!صنعت حصانًا خشبيًا

128
00:08:54,600 --> 00:08:57,230
!سأضع حفيدي عليه حينما يُولد

129
00:08:58,940 --> 00:09:00,230
.كم هذا لطيفٌ

130
00:09:01,460 --> 00:09:02,720
...ألست

131
00:09:05,370 --> 00:09:06,860
ناووزومي؟

132
00:09:06,860 --> 00:09:09,970
،طال غيابك
...كم هو جميلٌ أن أراك ثانيةً

133
00:09:10,310 --> 00:09:13,460
والدي، لا يجدر بك
.النّهوض بغتةً هكذا

134
00:09:13,790 --> 00:09:15,360
ما خطبك؟

135
00:09:15,360 --> 00:09:17,360
.علّةٌ بسيطة في رئتيّ

136
00:09:17,760 --> 00:09:19,940
،كفانا حديثًا عن هذا

137
00:09:19,940 --> 00:09:21,610
.فأنا سأغدو جدًّا

138
00:09:21,830 --> 00:09:24,610
ألا ترغب في رُؤية الصّغير يا ناووزومي؟

139
00:09:24,910 --> 00:09:28,880
،كانت بيننا خلافاتٌ
.ولكن لنطوِ صفحة الماضي

140
00:09:30,660 --> 00:09:32,570
،لا يُمكنني الرّحيل الآن

141
00:09:32,570 --> 00:09:34,880
ليس قبل أن أرى حفيدي
.وقد اشتدّ عوده

142
00:09:35,180 --> 00:09:38,530
والآن، مِن الأفضل أن أمرّ
...على الدّوجو قبل أن

143
00:09:39,600 --> 00:09:41,800
.لا تُجهد نفسك يا والدي

144
00:09:42,780 --> 00:09:45,230
متى فقد صلابته؟

145
00:09:45,520 --> 00:09:47,380
.بات شخصًا آخر تمامًا

146
00:09:47,640 --> 00:09:49,980
.هذا يُوضّح فحسب كم طال غيابك

147
00:09:51,520 --> 00:09:54,800
أَودى المرض بحياة والدتي
.قبل ثلاث سنواتٍ

148
00:09:55,700 --> 00:09:57,650
.تمنّيت لو وجدت وسيلةً لإخبارك

149
00:10:00,160 --> 00:10:01,800
.سأمضي للتّدريب في الدّوجو

150
00:10:01,800 --> 00:10:02,910
.حسنًا

151
00:10:16,000 --> 00:10:19,280
ما خطب هذه الصّيحات الفاترة؟

152
00:10:20,080 --> 00:10:22,470
.تفضّلوا، لا بُدّ أنّكم مُتعبون

153
00:10:22,470 --> 00:10:24,180
.أعددت طبق الأونيغيري

154
00:10:24,180 --> 00:10:26,280
.بدأت أشعر بالجُوع لتوّي

155
00:10:26,280 --> 00:10:27,930
.حان وقت الاستراحة

156
00:10:27,930 --> 00:10:31,280
هل هذا الدّوجو للهُواة؟
!هل جئتم جميعًا إلى هنا للّهو؟

157
00:10:31,930 --> 00:10:35,700
اصطفّوا! سأُقوّم عزائمكم
!الميّتة ولو بالقسر

158
00:10:36,260 --> 00:10:37,790
.تمهّل يا ني-سان

159
00:10:37,790 --> 00:10:38,800
.هدّئ مِن روعك

160
00:10:38,800 --> 00:10:40,560
.دعني وشأني يا يوتارو

161
00:10:40,560 --> 00:10:42,200
.لا بُدّ أنّك متعبٌ مِن مشقّة السّفر

162
00:10:42,200 --> 00:10:43,540
!لست مُتعبًا

163
00:10:43,540 --> 00:10:45,940
لنحتسِ شرابًا إحياءً لذكرى
.الأيّام الماضية

164
00:10:45,940 --> 00:10:48,170
!أنت لا تقوى على مُعاقرة الشّراب

165
00:10:47,290 --> 00:10:50,090
.هدّئ مِن روعك

166
00:10:50,550 --> 00:10:52,170
.يا لهما مِن أخوين شديدي التّرابط

167
00:11:05,690 --> 00:11:08,180
،على الأقلّ
.واظبتَ على تدريباتك

168
00:11:08,370 --> 00:11:10,830
كلا، ما زال أمامي
.طريقٌ طويل

169
00:11:11,300 --> 00:11:14,200
فأنا لا أُخاطر بحياتي
.كما تفعل أنت

170
00:11:14,770 --> 00:11:16,840
،على أيّ حالٍ
...بشأن تلك المرأة

171
00:11:17,010 --> 00:11:18,190
تقصد ناغي؟

172
00:11:18,190 --> 00:11:21,690
تبدو وكأنّها ليست بكامل
عقلها، مِن أيّ عائلةٍ هي؟

173
00:11:22,210 --> 00:11:26,160
تمّ تبنّيها، وسمعت أنّها
.عاشت طُفولةً قاسية

174
00:11:26,600 --> 00:11:30,360
،التقينا صُدفةً
.وقد أحبّتها والدتي كثيرًا

175
00:11:30,920 --> 00:11:32,450
أليس في عُروقها دم السّاموراي؟

176
00:11:32,850 --> 00:11:34,620
.كلا، لكنّها شخصٌ لطيف

177
00:11:34,930 --> 00:11:36,410
.أنا متيقنٌ أنّك ستُحبّها أنت أيضًا

178
00:11:39,330 --> 00:11:40,000
ني-سان؟

179
00:11:40,830 --> 00:11:42,670
.حتّى النّسب لم يعد له أثرٌ

180
00:11:42,670 --> 00:11:46,510
أيّ جُزءٍ مِن هذه العائلة
يمتّ للسّاموراي بصلةٍ الآن؟

181
00:11:48,160 --> 00:11:49,560
.سأُعيد تقويم الأمور

182
00:11:52,060 --> 00:11:56,810
،إنّها ليّنةٌ وحُلوة المذاق
.لا أكتفي منها أبدًا

183
00:11:57,120 --> 00:11:59,820
ما الّذي تأكله؟

184
00:12:00,020 --> 00:12:03,390
كاستيلا، بعثت في طلبها
.مِن ناغاساكي

185
00:12:03,390 --> 00:12:05,320
!لكنّها بضاعةٌ أجنبيّة

186
00:12:05,320 --> 00:12:07,130
هل أنت خائنٌ لبلادك؟

187
00:12:07,570 --> 00:12:08,300
أَترغب في قطعةٍ؟

188
00:12:08,300 --> 00:12:09,080
!محالٌ

189
00:12:10,640 --> 00:12:11,540
ماذا تُريد؟

190
00:12:11,760 --> 00:12:15,330
كم مرةً عليّ أن أُخبرك؟
.افتح أبواب الدّوجو لرفاقي

191
00:12:16,000 --> 00:12:20,330
كُلّ واحدٍ منهم مقاتلٌ فذّ ذُو رباطة
.جأشٍ، وسيُعيدون لهذا المكان هيبته

192
00:12:20,500 --> 00:12:21,360
.كلا

193
00:12:22,080 --> 00:12:23,630
ما سبب الرّفض؟

194
00:12:24,440 --> 00:12:29,020
ناووزومي، لم تفعل شيئًا
.في حياتك سوى التّمرد

195
00:12:29,580 --> 00:12:32,840
،أنا أتمسّك بمبادئي
.كما يجب على السّاموراي أن يفعل

196
00:12:33,160 --> 00:12:34,810
.أنت مَن علّمني ذلك

197
00:12:36,150 --> 00:12:37,280
.يا له مِن تفكيرٍ بالٍ

198
00:12:40,520 --> 00:12:42,010
ماذا؟

199
00:12:46,960 --> 00:12:49,870
!انظر كيف يُحلّق
.هذا رائعٌ

200
00:12:50,400 --> 00:12:52,360
.سيُحبه حفيدي حقًا

201
00:12:53,000 --> 00:12:54,660
،أخبرني يا ناووزومي

202
00:12:55,040 --> 00:12:58,130
هل هذه الحياة سيّئةٌ إلى هذا الحدّ؟

203
00:12:58,460 --> 00:13:00,340
مَن أنت لتتحدّث هكذا؟

204
00:13:00,630 --> 00:13:03,400
أنت مَن كُنت تقول لي أن أعيش
.بكبرياءٍ كابنٍ للسّاموراي

205
00:13:03,400 --> 00:13:07,480
وأن أكون مُتأهّبًا ومُتيقظًا
!للقتال في أيّ وقت

206
00:13:10,360 --> 00:13:14,180
،تتغيّر الأزمان
.وعلى النّاس أن يتغيّروا معها

207
00:13:14,180 --> 00:13:16,410
،ما أنت إلّا شخصٌ فقد صلابته

208
00:13:16,750 --> 00:13:18,400
.لم تعد ساموراي بعد الآن

209
00:13:18,780 --> 00:13:20,990
،ثمّة عهدٌ جديد آتٍ

210
00:13:21,630 --> 00:13:24,170
.وعلى السّاموراي التكيّف معه

211
00:13:24,170 --> 00:13:27,320
لن تجذب أحدًا بالانضباط
.الصّارم في هذا الزّمان

212
00:13:28,400 --> 00:13:31,920
هل كان بهذا الانكسار والانهزام دائمًا؟

213
00:13:31,920 --> 00:13:34,460
.عهد السّيف سينتهي قريبًا

214
00:13:34,460 --> 00:13:36,080
.هذه خيانةٌ

215
00:13:36,080 --> 00:13:41,080
،جُبتَ أرجاء اليابان، ووسّعتَ مَداركك
.أنت أدرى بهذا الواقع منّي

216
00:13:41,420 --> 00:13:43,950
إذًا، تتخلّى عنّي الآن وتسحب
البِساط مِن تحت قدميّ؟

217
00:13:45,050 --> 00:13:48,300
حقًا؟
.فرغتَ مِن التّفكير البالي إذًا

218
00:13:48,300 --> 00:13:50,550
،أخبرني يا ناووزومي

219
00:13:50,900 --> 00:13:52,650
هل ستبدأ مِن جديدٍ؟

220
00:13:52,650 --> 00:13:53,400
—لم يفت الأوان بعـ

221
00:13:59,760 --> 00:14:02,980
.التّفكير البالي يقبع برأسك أنت

222
00:14:03,310 --> 00:14:04,360
—ناووزومي

223
00:14:15,630 --> 00:14:16,590
.ني-سان

224
00:14:17,660 --> 00:14:20,130
.لم أرَ والدي مُنذ البارحة

225
00:14:20,640 --> 00:14:21,420
.لا تسألني

226
00:14:23,560 --> 00:14:26,330
.لم يعد بمقدوري التّراجع الآن

227
00:14:27,900 --> 00:14:29,370
.حسمت أمري

228
00:14:32,000 --> 00:14:33,570
.سنفعل ذلك بأنفسنا

229
00:14:39,960 --> 00:14:41,500
ستتغيّر الأزمان، أليس كذلك؟

230
00:14:44,350 --> 00:14:46,680
هل يُمكنني الاستمرار
على هذا الحال؟

231
00:14:50,210 --> 00:14:53,160
،أنا الابن الثّالث لساموراي
.عالقٌ في الدّار

232
00:14:53,440 --> 00:14:57,100
جعلت السّنين تتسرّب مِن بين يديّ وأنا
.أتوهّم دائمًا أنّ فُرصتي آتيةٌ لا محالةً

233
00:14:59,320 --> 00:15:03,630
إن بَقي كُلّ شيءٍ راكدًا، فسأموت هرمًا
.على فراشي، وهذا مصيرٌ لا يقبله عقلي

234
00:15:07,080 --> 00:15:11,130
،انظر إلى رفاقنا هنا
.إنّهم أشخاصٌ مثلي تمامًا

235
00:15:14,480 --> 00:15:16,890
،لا بأس بهذا لمن يستطيع التكيّف

236
00:15:17,710 --> 00:15:18,590
...ولكن

237
00:15:19,610 --> 00:15:21,370
،إنّهم حثالةٌ

238
00:15:21,560 --> 00:15:23,650
.لا يحكمون على المرء إلّا مِن مظهره

239
00:15:24,040 --> 00:15:28,150
لعلّهم لا يعبؤون بي لأنّني
.لم أبنِ لنفسي صيتًا بعد

240
00:15:28,500 --> 00:15:31,150
.لم يبقَ لي دارٌ آوي إليه

241
00:15:31,400 --> 00:15:35,660
خضنا نزالًا، لكنّني وحدي مَن دفع الثّمن
.خلف القضبان، فالآخر كان يملك المال

242
00:15:35,790 --> 00:15:37,740
،لنُشعل بعض الألعاب النّارية

243
00:15:37,740 --> 00:15:39,670
فأنا محرومٌ مِن مُمارسة
!هواياتي في داري

244
00:15:42,450 --> 00:15:45,160
ماذا عن الأشخاص الّذين
خلّفناهم وراءنا؟

245
00:15:45,360 --> 00:15:47,500
،لا حاجة لنا بأمثالهم

246
00:15:47,500 --> 00:15:49,670
.فليَمت العاجزون

247
00:15:50,600 --> 00:15:51,960
.لا يُمكنني الموت

248
00:15:53,460 --> 00:15:54,890
.ولن أتراجع

249
00:15:56,140 --> 00:15:58,800
ماذا سيحلّ بهم إذا فعلت؟

250
00:16:00,270 --> 00:16:02,910
،أنت في طريقٍ مسدود بالفعل

251
00:16:02,910 --> 00:16:05,030
والدّرب الوحيد أمامك
.لا يُفضي إلّا إلى الهلاك

252
00:16:05,190 --> 00:16:08,990
،سيريزاوا
.أنا لست مثلك أبدًا

253
00:16:09,610 --> 00:16:11,530
.لن أَلوذ بالفرار

254
00:16:11,530 --> 00:16:13,500
.كفى

255
00:16:13,500 --> 00:16:15,280
.بلغنا النّهاية

256
00:16:15,440 --> 00:16:17,440
،رُبّما أُصارع الأزمان

257
00:16:17,440 --> 00:16:20,200
!لكنّني سأُقاتل حتّى الرّمق الأخير

258
00:16:20,430 --> 00:16:22,560
!كفاك ثرثرةً

259
00:16:36,990 --> 00:16:38,300
.هزمته

260
00:16:39,580 --> 00:16:41,180
.أنا المُنتصر

261
00:16:50,080 --> 00:16:51,970
.لست مثله

262
00:16:52,660 --> 00:16:54,200
.ذاك العجوز معدوم العزيمة

263
00:16:55,700 --> 00:16:59,860
،أنا مَن فاز
.ظللت أُكافح حتّى النّهاية

264
00:17:01,080 --> 00:17:04,460
قاومت هذا العهد الجديد
.حتّى آخر نفسٍ

265
00:17:06,220 --> 00:17:07,610
.قضيت عليك

266
00:17:12,500 --> 00:17:14,470
.وأنت أيضًا

267
00:17:14,720 --> 00:17:17,470
أنا؟ بسبب هذا؟

268
00:17:18,950 --> 00:17:21,570
!لم تقترب منّي حتّى

269
00:17:21,570 --> 00:17:23,360
،جُرحك مميتٌ

270
00:17:23,360 --> 00:17:26,180
أمّا الضّربة الّتي سدّدتها لي
.فما هي إلّا خدشٌ بسيط

271
00:17:29,290 --> 00:17:32,490
.سيفي لم يقطع جسدك

272
00:17:32,680 --> 00:17:33,730
ماذا؟

273
00:17:33,910 --> 00:17:35,720
ألم تُدرك بعد؟

274
00:17:36,230 --> 00:17:37,880
.بل لا بُدّ أنّك أدركت

275
00:17:38,980 --> 00:17:46,000
أنت تتظاهر فقط بتجاهل الطّعنة
.الّتي سدّدتها لك الأزمان

276
00:17:46,530 --> 00:17:48,510
عمّا تتحدّث؟

277
00:17:49,310 --> 00:17:51,020
،سيريزاوا

278
00:17:51,020 --> 00:17:55,260
ذاك الجرح سيتعفّن
.وينهش جسدك يومًا ما

279
00:18:02,240 --> 00:18:03,080
.التزم الصّمت

280
00:18:07,680 --> 00:18:09,360
.هيجيكاتا-كون، نوغوتشي-كون

281
00:18:09,920 --> 00:18:11,610
أهذا أنتما، يامانامي وغين-سان؟

282
00:18:12,320 --> 00:18:13,640
هل أنهيتما مُهمّة الجسر؟

283
00:18:13,640 --> 00:18:14,450
.أجل

284
00:18:14,450 --> 00:18:15,520
.أنهينا المُهمّة أيضًا

285
00:18:16,760 --> 00:18:17,350
.نيمي

286
00:18:18,250 --> 00:18:19,880
هاجيمي! هل هو ميّتٌ؟

287
00:18:20,070 --> 00:18:22,370
،كلا، إنّه نائمٌ فحسب
.تعرّض للسّم

288
00:18:22,670 --> 00:18:23,870
وهل سينجو؟

289
00:18:24,370 --> 00:18:25,210
.أجل، غالبًا

290
00:18:25,210 --> 00:18:26,380
!يا رفاق

291
00:18:26,870 --> 00:18:28,690
هل أنتم بخير جميعًا؟

292
00:18:30,610 --> 00:18:32,280
!هيهات لمُجرمٍ أن يتخطّانا

293
00:18:32,280 --> 00:18:33,940
!أجل، ولا حتّى صعلوكٌ واحد

294
00:18:33,940 --> 00:18:36,390
،تتحدّثان بنبرةٍ واثقة
.رُغم أنّنا مَن أنجزنا مُعظم المُهمّة

295
00:18:36,860 --> 00:18:37,890
هل نِلتم منهم؟

296
00:18:37,890 --> 00:18:39,200
.أجل، بالطّبع

297
00:18:39,540 --> 00:18:43,740
سمعت أنّ هارادا-سان وناغاكورا-سان
.رافقا نيو إلى دار جدّته

298
00:18:44,150 --> 00:18:47,150
هذا يعني أنّ كوندو-سان
.في مقرّ العدو

299
00:18:47,700 --> 00:18:51,910
،تلك النّيران تُقلقني
.لكنّني لا أتخيّل أبدًا أن يُهزم

300
00:18:52,560 --> 00:18:55,400
ممّا يعني أنّه لم يبقَ
.إلّا مكانٌ واحد

301
00:18:56,200 --> 00:18:56,800
.أجل

302
00:18:57,600 --> 00:18:58,530
.هنا تمامًا

303
00:18:59,070 --> 00:19:02,910
،الجسر الأوّل
.ذاك الّذي سلكه سيريزاوا-سان

304
00:19:04,600 --> 00:19:06,160
!ثمّة أحدٌ قادم

305
00:19:06,600 --> 00:19:08,950
مَن هذا؟
هل نفذ أحد الخُصوم مِن خلالنا؟

306
00:19:12,740 --> 00:19:14,660
!سيريزاوا-سينسي

307
00:19:20,910 --> 00:19:22,850
.لا يزال يتنفّس

308
00:19:26,700 --> 00:19:27,840
.هيجيكاتا-سان

309
00:19:44,740 --> 00:19:46,530
هل هرب البقيّة وتركوك؟

310
00:19:46,990 --> 00:19:47,900
.يا لها مِن خاتمةٍ بائسة

311
00:19:48,770 --> 00:19:49,710
.اقتلني

312
00:19:50,460 --> 00:19:51,410
.كلا

313
00:19:54,080 --> 00:19:56,480
.لا تُؤمّل نفسك بموتة السّاموراي

314
00:19:57,070 --> 00:20:02,550
بل ستتفكّر فيما اقترفت يداك، وتتجرّع مرارة
.النّدم، ثُمّ تموت منبوذًا لا تلقى إلّا العناء

315
00:20:04,020 --> 00:20:09,050
لم يخطر ببالي أنّ آخر ما سأراه
.هو وجه شيطانٍ يُحدّق بي

316
00:20:09,590 --> 00:20:12,800
استسلم، فقد نَسج القَدر خاتمتك
.على هذا النّحو

317
00:20:16,680 --> 00:20:18,730
أَلم يكن هناك سبيلٌ آخر؟

318
00:20:19,070 --> 00:20:21,160
بسبب أنّني ساموراي؟

319
00:20:21,860 --> 00:20:23,580
أم لأنّ الدّهر جار علينا هكذا؟

320
00:20:23,780 --> 00:20:27,820
أمثالك هم أحقّ النّاس
.بالانتماء إلى المِيبورو

321
00:20:27,820 --> 00:20:29,010
،لا أعتقد ذلك

322
00:20:29,320 --> 00:20:33,990
لا أهمية لهُويّتك، فالمرء لا قيمة له
.أمام طُوفان الزّمن، فهو العدو الأزليّ

323
00:20:34,830 --> 00:20:37,080
،كفاك ما فعلت
.استرح الآن

324
00:20:37,080 --> 00:20:44,580
هيجيكاتا، أَتظنّ أنّ هذه الفوضى
ستصنع منكم أبطالًا يُشار إليهم بالبنان؟

325
00:20:44,850 --> 00:20:48,340
جئتَ إلى الدّنيا مُتأخّرًا بعد أن
.طُويت صفحات السّاموراي

326
00:20:49,270 --> 00:20:54,140
ما كان ليَحزُنني أن تكون
.المُواجهة الأخيرة بيني وبينك

327
00:21:00,220 --> 00:21:05,290
،لعلّه وهمٌ أصابني
.لكنّني أسمع نحيب وَليدٍ

328
00:21:07,360 --> 00:21:09,270
،ني-سان
.لنتبارز جولةً واحدة

329
00:21:09,270 --> 00:21:11,010
.تناول الزّاد

330
00:21:11,010 --> 00:21:14,340
انظر! صنعت طائرةً خشبيّة
.ستعلو أكثر مِن قبل

331
00:21:15,720 --> 00:21:17,700
،يبدو أنّني لست أوّل مَن غادر الدّنيا

332
00:21:18,510 --> 00:21:21,960
.سأُهيّئ لك مقعدًا بيننا في الجحيم

333
00:21:36,430 --> 00:21:37,550
...أيّها

334
00:21:38,480 --> 00:21:40,470
!الأبله المُغفّل

335
00:21:44,990 --> 00:21:50,000
أولئك
الّذين

336
00:21:44,990 --> 00:21:50,000
يُكافحون

337
00:23:20,130 --> 00:23:25,510
الحلقة القادمة

338
00:23:22,680 --> 00:23:24,040
.تاناكا تارو يُحدّثكم

339
00:23:25,800 --> 00:23:28,590
يبدو أنّ وطأة الصّراع عند
.الجُسور قد خفّت حدّتها

340
00:23:28,850 --> 00:23:31,760
أتساءل إن كانت ناغي-سان
.قد وضعت مولودها بسلامٍ

341
00:23:32,160 --> 00:23:35,120
هل كان إيداعها أمانةً
عند نيو فكرةً سديدة؟

342
00:23:37,100 --> 00:23:43,030
هُمومنا لا تنتهي أبدًا، لكن أظنّ أنّ
.علينا فعل ما بوسعنا فحسب

343
00:23:43,880 --> 00:23:45,390
."الحلقة القادمة: "روابط

344
00:23:46,020 --> 00:23:47,160
ستُشاهدونها، أليس كذلك؟

345
00:23:47,150 --> 00:23:49,990
روابط