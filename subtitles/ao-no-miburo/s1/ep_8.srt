1
00:00:05,550 --> 00:00:09,150
ما الخطب أيّها البطل؟

2
00:00:24,440 --> 00:00:25,760
!أنت وحشٌ

3
00:00:25,760 --> 00:00:30,670
ألن تُنزل بي القصاص
الّذي أستحقه كما زعمت؟

4
00:00:31,690 --> 00:00:34,510
لعلّك تودّ أن أُريك
.حقيقة الفِعل لا زيف الكلام

5
00:00:34,510 --> 00:00:36,510
—!تمهّل، توقّف

6
00:00:36,520 --> 00:00:38,760
!لا يا سيّدي
!نحن بحاجةٍ إليه حيًا

7
00:00:52,280 --> 00:00:57,990
ذئاب ميبو الزّرق

8
00:02:13,390 --> 00:02:15,600
.لن نَكِل هذه المهمّة للرّونين بمُفردهم

9
00:02:16,520 --> 00:02:19,980
،لا يزال هناك ثلاثةٌ يتربّصون بـ آيزو
.وسأقبض عليهم بنفسي

10
00:02:34,440 --> 00:02:36,640
!تمّ القبض على المُجرم

11
00:02:36,960 --> 00:02:38,600
.أخطأته

12
00:02:38,600 --> 00:02:40,880
.يبدو أنّ الخمر فعل بي فعلته

13
00:02:47,240 --> 00:02:51,650
تلاشت كُلّ ثغراته حين تحوّل
.إلى وضعيّة اليد اليُسرى

14
00:02:54,860 --> 00:02:58,850
،ومع ذلك
.لا مجال للتّراجع عن هذه المُهمّة

15
00:03:05,710 --> 00:03:07,080
أَتحسب أنّ بمقدورك مواجهتي وحدك؟

16
00:03:07,790 --> 00:03:10,180
،مهما يكن
.سيُحسم القتال في جولةٍ واحدة

17
00:03:10,180 --> 00:03:12,320
.لن يُجدي سحب السّيفين نفعًا

18
00:03:15,630 --> 00:03:16,630
!سأفعلها

19
00:03:25,410 --> 00:03:26,470
.اقضِ عليّ

20
00:03:26,800 --> 00:03:28,670
.فمن أخفق فمصيره الموت

21
00:03:29,310 --> 00:03:31,280
.هذا هو قانون الشّينوبي

22
00:03:37,280 --> 00:03:39,090
.سُحقًا لقانون الشّينوبي

23
00:03:39,880 --> 00:03:41,290
.أنت لست أهلًا لمثل هذا العمل

24
00:03:47,830 --> 00:03:51,040
،لا حمام زاجل يوافينا بخبرٍ
.والنّزل صار مُراقبًا

25
00:03:51,540 --> 00:03:57,040
،أَيعقل أنّهم أوقعوا بـ كيوشيرو
والعجوز غونزو، وروكوهي أيضًا؟

26
00:03:57,590 --> 00:03:59,380
.جوتارو لقي حتفه

27
00:03:59,870 --> 00:04:02,920
—عليّ الهرب الآن قبل فوات

28
00:04:09,570 --> 00:04:14,520
أشار العجوز الّذي قدّم لنا الشّاي
.إلى رجلٍ فقد عينه اليُمنى

29
00:04:14,840 --> 00:04:16,890
!كشفوا أمري

30
00:04:17,360 --> 00:04:18,790
...لكنّه بمُفرده، ربّما يُمكنني

31
00:04:25,440 --> 00:04:27,750
!لا، محالٌ أن أهزم هذا المسخ، تبًا

32
00:04:27,750 --> 00:04:29,070
.رُويدك

33
00:04:30,160 --> 00:04:32,240
.لن تتقدّم خطوةً أخرى

34
00:04:38,520 --> 00:04:39,920
.يا لها مِن خيبةٍ

35
00:04:40,580 --> 00:04:44,670
كُنت أرجو أن يملك جرأةً
.ليصمد في هذا النّزال

36
00:04:44,670 --> 00:04:48,550
لا تتذمّر يا سوجي، فما أقلّ الرّجال
.الّذين يملكون ثقلًا حقيقيًا

37
00:04:48,760 --> 00:04:50,220
.هذه هي نهايتك

38
00:04:51,400 --> 00:04:54,480
.سنجعلك تدفع ثمن كُلّ شرٍ اقترفته

39
00:05:00,090 --> 00:05:04,210
ما القرار الآن؟
أَنطيح برأسه ونُنهي الأمر؟

40
00:05:05,220 --> 00:05:09,440
ما-ما خطب هؤلاء الرّجال؟
أَيعقل أنّهم المِيبورو؟

41
00:05:10,120 --> 00:05:11,860
.لا مفرّ لك الآن

42
00:05:11,860 --> 00:05:14,720
ما ينتظرك مِن العقاب
.شيءٌ لا أريد أن أشهده

43
00:05:15,740 --> 00:05:17,450
!هل أحضروا فِتيةً معهم؟

44
00:05:17,760 --> 00:05:20,600
.استسلم، قُضي الأمر

45
00:05:22,760 --> 00:05:25,960
!الاستقواء بالكثرة خسّةٌ

46
00:05:26,270 --> 00:05:30,010
!لا يجرؤ أيّ منكم على نِزالي منفردًا

47
00:05:30,460 --> 00:05:32,120
.مثيرٌ للشّفقة

48
00:05:32,120 --> 00:05:33,510
ما الّذي تفوّهت به؟

49
00:05:33,750 --> 00:05:39,020
لا تجرؤ حتّى على المُخاطرة بحياتك
.للدّفاع عمّا اقترفته

50
00:05:40,310 --> 00:05:44,840
أَتحسب أنّني سأُصدّق
أنّكم جميعًا قادرون على ذلك؟

51
00:05:44,840 --> 00:05:46,980
.بالطّبع سنفعل

52
00:05:49,540 --> 00:05:51,800
.لن تصمد أمام هذا الصّغير حتّى

53
00:05:54,040 --> 00:05:55,530
ماذا؟

54
00:05:56,090 --> 00:05:57,470
!كفاك هُراءً

55
00:05:57,470 --> 00:05:59,970
—أَيعقل أن أُبارز طفلًا بكُلّ قوّتي

56
00:05:59,970 --> 00:06:01,000
.سأُقاتلك

57
00:06:02,820 --> 00:06:03,990
.إن كنت لا تُمانع ذلك

58
00:06:04,980 --> 00:06:06,010
سيفٌ خشبيّ؟

59
00:06:07,610 --> 00:06:10,580
!يا لها مِن مهزلةٍ
أَتظنّ نفسك سيّافًا حقيقيًا؟

60
00:06:10,580 --> 00:06:11,760
،لديّ اقتراحٌ

61
00:06:12,740 --> 00:06:15,560
،إن غَلبتك
.فلتأتِ معنا خاضعًا

62
00:06:15,990 --> 00:06:19,990
،وإن غَلبتني
.فلتمضِ في حال سبيلك

63
00:06:21,230 --> 00:06:22,670
أَتتحدّث بصدقٍ؟

64
00:06:22,670 --> 00:06:25,950
.رفاقك لن يُوافقوا على هذا أبدًا

65
00:06:26,150 --> 00:06:27,980
.أُراهن على فوز نيو

66
00:06:27,980 --> 00:06:28,440
ماذا؟

67
00:06:28,610 --> 00:06:30,200
.وأنا أُراهن على نيو أيضًا

68
00:06:30,200 --> 00:06:30,970
.أنا معكما

69
00:06:30,970 --> 00:06:31,960
.وأنا أيضًا

70
00:06:33,740 --> 00:06:35,470
،قتلت رجُلين بالفعل

71
00:06:35,910 --> 00:06:38,960
،وسيفي ليس لُعبةً خشبيّة
...إن أقدمت على مُهاجمتي

72
00:06:39,260 --> 00:06:41,490
فلا تَلُم إلّا نفسك
.حين أسلبك حياتك

73
00:06:44,150 --> 00:06:45,070
.لا بأس عندي

74
00:06:55,240 --> 00:06:58,600
،أَفزعتني لوهلةٍ
.لكنّك ككلبٍ ينبح ولا يعضّ

75
00:06:58,770 --> 00:07:00,550
.كلا، لم يكن أداء نيو سيئًا

76
00:07:11,380 --> 00:07:13,650
ما خطب هذا الصّغير؟

77
00:07:15,980 --> 00:07:17,500
—مهلًا، انتظر لحظةً

78
00:07:17,950 --> 00:07:20,840
،لن تتذمّر حين أُهشّم جمجمتك
أليس كذلك؟

79
00:07:21,880 --> 00:07:23,500
!تـ-تمهّل، انتظر قليلًا

80
00:07:28,810 --> 00:07:30,720
.انتهى الأمر، ظفرنا بك

81
00:07:30,720 --> 00:07:32,630
!تمّ القبض على المُجرم

82
00:07:35,640 --> 00:07:41,000
جميعهم لا يعرفون الخوف إذن؟
حتّى الصّغار منهم؟

83
00:07:41,000 --> 00:07:42,640
،لم يكن الحظّ حليفك

84
00:07:43,080 --> 00:07:46,650
.فمدينة كيوتو تحت حماية المِيبورو

85
00:07:46,910 --> 00:07:48,840
!أحسنت صُنعًا يا نيو-كون

86
00:07:48,840 --> 00:07:49,850
.أداءٌ مذهل

87
00:07:49,850 --> 00:07:51,150
.شـ-شكرًا لكم

88
00:07:51,520 --> 00:07:52,650
.لـ-لقد فَعلتَها

89
00:07:53,060 --> 00:07:54,650
!فَعلتَها حقًا

90
00:07:55,670 --> 00:08:00,910
مهلًا، هل خارت قُواك الآن؟
بعد كُلّ تلك الشّجاعة الّتي أظهرتها؟

91
00:08:01,210 --> 00:08:05,160
لعلّه أدرك أنّ إظهار الضّعف حينها
.كان سيؤدّي لقتله، هذا هو ديدنه تمامًا

92
00:08:05,400 --> 00:08:10,000
لا، لست ماهرًا لدرجة
.التغلّب عليه بغير ذلك

93
00:08:10,320 --> 00:08:12,020
.أ-أنا لا أُصدّق ما تقول

94
00:08:12,280 --> 00:08:15,000
،على أيّ حال
كم ستبقى مُتشبثًا بذاك السّيف؟

95
00:08:15,620 --> 00:08:18,260
صحيحٌ، أعصابي مُتشنّجة
.ولا أقوى على تركه

96
00:08:19,350 --> 00:08:20,430
.كوندو-سان

97
00:08:20,430 --> 00:08:22,400
.تشنّجت أعصابك بسبب شدّة توتّرك

98
00:08:25,670 --> 00:08:29,160
سيّدي، لماذا منحتني ثقتك؟

99
00:08:29,720 --> 00:08:33,090
.واظبت على تدريبات السّيف يوميًا

100
00:08:33,820 --> 00:08:37,920
دائمًا ما أُقدّر الرّوح والعزيمة
.وكُلّ ما هو خفيّ

101
00:08:38,250 --> 00:08:39,400
...لكنّني اليوم

102
00:08:40,360 --> 00:08:41,920
.وثقت بما رأيت في يديك

103
00:08:43,140 --> 00:08:45,160
.إنّهما دليل اجتهادك الدّائم

104
00:08:50,860 --> 00:08:52,380
.واصل كفاحك

105
00:08:52,380 --> 00:08:53,170
.أجل، سيّدي

106
00:08:53,170 --> 00:08:54,680
!قبضنا عليهم جميعًا

107
00:08:53,700 --> 00:08:55,390
،تارو
!اذهب واشترِ لنا حبّارًا مجففًا

108
00:08:54,680 --> 00:08:56,920
!لنُطلق العنان لأنفسنا

109
00:08:55,390 --> 00:08:57,170
وكأن هُناك دُكّانًا مفتوحًا
!في هذا الوقت

110
00:09:00,810 --> 00:09:05,190
مُفوّض كيوتو
اللّورد ماتسودايرا هيغو نوكامي من آيزو
المعبد الرّئيسي كونكاي-كومييوجي

111
00:09:03,170 --> 00:09:03,880
!ها هُم قد أتوا

112
00:09:03,880 --> 00:09:05,180
ماذا؟ مرّةً أُخرى؟

113
00:09:05,580 --> 00:09:09,440
أجل، حضروا لأنّهم نالوا
.مِن القاتل الأخير

114
00:09:10,060 --> 00:09:11,410
.أمرٌ لا يُصدّق

115
00:09:11,680 --> 00:09:15,950
أمضينا ثلاثة أشهرٍ
،في لحاقهم بلا نتيجةٍ

116
00:09:16,390 --> 00:09:18,080
بينما أنهوا هم المُهمّة في يومين فقط؟

117
00:09:24,310 --> 00:09:26,010
.تجتهد في عملك كما أرى

118
00:09:29,000 --> 00:09:32,960
،نال منّي التّعب حقًا
لماذا اختاروا الجبال مكانًا للمقرّ؟

119
00:09:32,960 --> 00:09:35,420
،اصمد يا تارو-كون
.لم يبقَ إلّا القليل

120
00:09:36,100 --> 00:09:37,210
.يا له مِن ضعيفٍ

121
00:09:37,650 --> 00:09:39,020
هل بصحبتهم أطفالٌ أيضًا؟

122
00:09:43,230 --> 00:09:43,970
فوجيتا؟

123
00:09:44,350 --> 00:09:46,980
،معذرةً
.كانوا أسرع منك هذه المرّة

124
00:09:50,560 --> 00:09:52,060
.هؤلاء هم رجال المِيبورو

125
00:09:59,180 --> 00:10:01,700
.أُثني عليكم لخدمتكم العظيمة

126
00:10:01,920 --> 00:10:03,700
.إنّني في غاية السّرور

127
00:10:03,700 --> 00:10:04,700
.جزيل الشّكر، سيّدي

128
00:10:05,540 --> 00:10:07,610
.إذًا، هذا هو لُورد آيزو

129
00:10:08,130 --> 00:10:09,800
ألا تراه غريبًا بعض الشّيء؟

130
00:10:09,760 --> 00:10:10,790
!صمتًا

131
00:10:09,800 --> 00:10:10,790
.إنّه غريبٌ جدّا

132
00:10:11,140 --> 00:10:12,050
.سيّدي

133
00:10:12,050 --> 00:10:12,760
.حسنًا

134
00:10:16,770 --> 00:10:20,210
آمل أن تستمرّوا في تفانيكم
.لخدمة الشّعب

135
00:10:21,380 --> 00:10:27,560
أُعاهدكم بضمّ فرقة ميبو روشيغومي
.بشكلٍ رسميّ وتقديم المزيد مِن الدّعم

136
00:10:30,270 --> 00:10:31,640
!رائعٌ

137
00:10:32,000 --> 00:10:33,720
!يا له مِن يومٍ سعيد

138
00:10:34,160 --> 00:10:36,840
،الـ-الزموا أدبكم
!أنتم في حضرة سُموّ اللّورد

139
00:10:39,120 --> 00:10:40,280
.دعهم وشأنهم

140
00:10:40,870 --> 00:10:44,030
،رغم ذلك
.لا بُدّ أنّكم أقوياء جدًا أيّها الرّفاق

141
00:10:44,420 --> 00:10:48,280
لنُريك مدى قوّتنا، دعنا نُقدّم عرضًا
.لمهاراتنا في مبارزة السّيف

142
00:10:48,840 --> 00:10:50,400
.هيراما، هيرايااما

143
00:10:50,790 --> 00:10:51,540
.أجل يا سيّدي

144
00:10:56,970 --> 00:10:58,550
ما بالك أكثر حماسًا منهم؟

145
00:10:59,810 --> 00:11:01,100
.حسنًا، أنا مستعدٌّ

146
00:11:01,100 --> 00:11:02,550
.لنفعلها

147
00:11:02,850 --> 00:11:04,880
.سنُظهر لهم قُدراتنا

148
00:11:04,880 --> 00:11:07,050
.ونُبهر سُموّ اللّورد بما سيرى

149
00:11:07,050 --> 00:11:08,270
ألم تكتفِ بعد؟

150
00:11:08,270 --> 00:11:09,060
!كوندو-سان

151
00:11:09,970 --> 00:11:11,630
!يا لها مِن حديقةٍ رائعة

152
00:11:09,970 --> 00:11:14,240
،فوجيتا، لا تكتفِ بالوقوف مُتفرجًا
.أثبت أنّك تستحق مقامك

153
00:11:11,630 --> 00:11:12,930
!هُنا يمكننا القتال بحقٍ

154
00:11:12,930 --> 00:11:14,930
!سيفًا، ائتوني بسيفٍ

155
00:11:14,950 --> 00:11:16,520
،مهلًا
!أنا مَن يجب أن يبدأ أولًا

156
00:11:31,080 --> 00:11:32,130
،أنت مِن المِيبورو
أليس كذلك؟

157
00:11:33,430 --> 00:11:34,600
ما الّذي تقوم به؟

158
00:11:35,730 --> 00:11:38,310
سألت عن مكان دفن
.الرّجال الّذين قُتلوا

159
00:11:38,510 --> 00:11:40,180
.إنّي أَتلو صلاةً لأجلهم

160
00:11:41,540 --> 00:11:43,150
عذرًا، ما اسمك أيّها السيّد؟

161
00:11:43,510 --> 00:11:44,640
.أُدعى فوجيتا

162
00:11:44,640 --> 00:11:47,310
،نسيت أن أُعرّفك بنفسي
.أنا نيو

163
00:11:47,620 --> 00:11:50,310
ما هي أسماء السّادة الّذين قُتلوا؟

164
00:11:52,110 --> 00:11:53,310
وما شأنك بأسمائهم؟

165
00:11:53,570 --> 00:11:59,810
لا سبب يُذكر، أردت أن أعلم مَن هُم
.أولئك الّذين أذكرهم في صلاتي

166
00:12:01,670 --> 00:12:03,720
هل ترى ذلك غريبًا؟

167
00:12:04,500 --> 00:12:05,140
.كلا

168
00:12:07,440 --> 00:12:12,700
،أحد الرّجال الّذين قُتلوا، ويُدعى كوشيبي
.ترعرع في القرية ذاتها الّتي نشأت فيها

169
00:12:13,840 --> 00:12:14,740
.كوشيبي-سان

170
00:12:15,870 --> 00:12:20,200
،كثيرًا ما تدرّبنا معًا
.كنت مفتونًا بمهارته في استخدام السّيف

171
00:12:21,500 --> 00:12:24,040
،قَدِمنا للخدمة في كيوتو سويًا

172
00:12:24,830 --> 00:12:27,500
.لكنّه قُتل قبل أن يبلغ مسعاه

173
00:12:27,970 --> 00:12:31,680
أخبرني، هل ثمّة طعامٌ كان يُحبّه
كوشيبي-سان أكثر مِن غيره؟

174
00:12:32,370 --> 00:12:33,300
،لست مُتيقّنًا

175
00:12:33,720 --> 00:12:38,680
ولكن حين أستحضر ذِكراه، أتذكّر أنّه استمتع
.كثيرًا بتناول سمك الشبّوط في زفاف شقيقته

176
00:12:39,290 --> 00:12:41,710
سمك الشبّوط؟
.شكرًا جزيلًا لك

177
00:12:52,920 --> 00:12:54,240
.حان وقت العودة على ما يبدو

178
00:12:54,240 --> 00:12:54,960
.أجل يا سيّدي

179
00:12:58,460 --> 00:13:01,600
!يا له مِن منظرٍ بديع
.لم أعِر الأمر انتباهًا مِن قبل

180
00:13:02,540 --> 00:13:07,000
أراد اللّورد أن تُطلّ
.مقابرهم على المدينة

181
00:13:07,640 --> 00:13:12,150
،ربّما يتظاهر بالبُرود والترفّع
.لكنّه رجلٌ يرعى رِجاله

182
00:13:13,120 --> 00:13:15,160
.إيّاك أن تُخطئ الظنّ به

183
00:13:19,040 --> 00:13:22,620
هل ينعم كوشيبي-سان في الجنّة الآن
مع البوذيّين الصّالحين؟

184
00:13:23,510 --> 00:13:26,540
كلا، كان حقودًا لا يستسلم
،للخسارة أبدًا

185
00:13:26,940 --> 00:13:28,750
.ويُجيد ردّ الإساءة بمثلها

186
00:13:29,570 --> 00:13:32,380
،كوشيبي لا يزال هُنا
،يجوب طُرقات كيوتو في هذه اللّحظة

187
00:13:32,920 --> 00:13:34,800
ولو كان ذلك عبر أحقاده
.الّتي لم تمت

188
00:13:37,000 --> 00:13:41,040
لذا، عزمت أمري أن أبذل مِن الجُهد
.في مهمّاتي ما يكفي لي وله معًا

189
00:13:43,610 --> 00:13:46,520
بهذا، أكون قد عرفت شيئًا
.جديدًا عن كوشيبي-سان

190
00:13:47,100 --> 00:13:50,050
معذرةً، كِدت أنسى
.أهمّ ما في الأمر

191
00:13:52,690 --> 00:13:56,060
.أشكرك مِن أعماقي على كُلّ ما قدّمته

192
00:13:56,560 --> 00:14:00,080
،كلا، أبدًا! أنا لم أصنع شيئًا

193
00:14:00,080 --> 00:14:01,570
فالرّجال في الأسفل
...هُم مَن تولّوا كُلّ شيءٍ

194
00:14:01,730 --> 00:14:02,490
،كلا

195
00:14:02,920 --> 00:14:05,890
بل أنا ممنونٌ لأنّ مَن ثأروا له
،لم يكونوا أقوياء فحسب

196
00:14:06,470 --> 00:14:12,080
بل حملوا في قُلوبهم رأفةً بنا
.نحن رجال آيزو، كما فعلت أنت

197
00:14:12,760 --> 00:14:15,580
كان حُكمي خاطئًا حين اعتبرت
.المِيبورو مُجرّد عصابةٍ مِن المارقين

198
00:14:22,960 --> 00:14:24,720
...كـ-كلا

199
00:14:26,140 --> 00:14:27,480
.بل أنا مَن يشكرك

200
00:14:28,050 --> 00:14:32,670
.بات قلبي مُطمئنًا بأنّنا فعلنا الصّواب

201
00:14:35,190 --> 00:14:39,150
أعدك أنّني سأجلب في زيارتي الآتية سمكة
.شبّوط بهذا الحجم، كاملةً مِن رأسها حتّى ذيلها

202
00:14:41,060 --> 00:14:44,880
سأستفسر عن أحوال الثّلاثة الرّاحلين
.إلى أن نلتقي في الزّيارة المُقبلة

203
00:14:44,880 --> 00:14:45,920
.أرجو منك ذلك

204
00:14:59,960 --> 00:15:02,500
نيو، استعرض براعتك
!في المُبارزة أنت أيضًا

205
00:15:02,500 --> 00:15:04,250
.لا أُجيد سوى تلويحات التّدريب البسيطة

206
00:15:04,250 --> 00:15:06,040
،لا بأس
!افعل ذلك فحسب

207
00:15:06,040 --> 00:15:08,550
لن يسمح لنا اللّورد بالتوقّف
!حتّى نمثل كُلّنا أمام ناظريه

208
00:15:08,920 --> 00:15:11,490
،فـ-في هذه الحالة
.سأُؤدّي تلويحاتي التدريبيّة

209
00:15:14,250 --> 00:15:21,880
،واحدٌ، اثنان، ثلاثةٌ
...أربعةٌ، خمسةٌ

210
00:15:26,190 --> 00:15:28,910
.بات المِيبورو في خدمة آيزو الآن

211
00:15:29,390 --> 00:15:31,320
كُنت أتساءل عمّا
...سيتبدّل بعد هذا، ولكن

212
00:15:31,560 --> 00:15:33,580
وهل هُناك ما هو أكثر نبلًا في
عُرف السّاموراي مِن خدمة اللّورد؟

213
00:15:34,300 --> 00:15:36,240
.لم أتلقّ إجابةً شافيةً تمامًا

214
00:15:37,040 --> 00:15:40,330
ورغم ذلك، فقد غمرت الفرحة
،مُضيفينا مِن عائلة ياغي

215
00:15:40,700 --> 00:15:43,090
واستمرّ بعض رفاقنا في
،الاحتفال دُون انقطاعٍ

216
00:15:43,090 --> 00:15:45,160
وهذا يجعلني متيقنًا بأنّ القادم سيكون
.على خير ما يُرام بالنّسبة إلينا

217
00:15:47,720 --> 00:15:49,840
.عُدت

218
00:15:49,840 --> 00:15:52,090
أظنّ أنّ الإرهاق قد نال منك بسبب
...الجولة التفقديّة، يا تودو-سان

219
00:15:54,590 --> 00:15:56,840
،لم يتبقّ شيءٌ مِن أزهار الكرز
.فقد سقطت كُلّها

220
00:15:58,100 --> 00:15:59,680
.تلك أوراق الشّجر الخريفيّة

221
00:16:00,190 --> 00:16:01,710
لكن، ما الخطب؟

222
00:16:01,930 --> 00:16:04,150
.ملامحك تبدو كئيبةً لدرجةٍ كبيرة

223
00:16:05,620 --> 00:16:07,800
،نيو
!أنا بحاجةٍ إلى مَعونتك حتمًا

224
00:16:12,550 --> 00:16:13,820
.مرحبًا بكم

225
00:16:13,990 --> 00:16:15,400
ما رأيك يا نيو؟

226
00:16:15,400 --> 00:16:17,490
،أنت على حقٍ
.تبدو فتاةً رائعة

227
00:16:17,960 --> 00:16:21,870
،فهي بشوشةٌ، ومراعيةٌ للآخرين
.كما أنّها تُضفي بهجةً على الدّكان بأكمله

228
00:16:21,870 --> 00:16:23,800
!تُدرك تمامًا أنّ مقصدي لم يكن هكذا

229
00:16:23,800 --> 00:16:24,490
!تبًا

230
00:16:24,740 --> 00:16:27,760
:ما يُريد معرفته حقًا هو
هل ستكون زوجةً صالحة؟

231
00:16:27,760 --> 00:16:29,220
.وكأنّ لدى هيسوكي أيّ فرصةٍ

232
00:16:29,220 --> 00:16:30,550
.فهو يفتقر تمامًا للجاذبيّة

233
00:16:30,550 --> 00:16:33,340
لو قارنته بالرّجال مِن
...مجموعة الرّسوم الخليعة خاصّتي

234
00:16:34,880 --> 00:16:36,090
!اخرسوا

235
00:16:36,260 --> 00:16:37,900
ما الّذي تفعلونه هُنا أصلًا؟

236
00:16:39,330 --> 00:16:41,970
!أمرك مكشوفٌ لنا تمامًا

237
00:16:42,350 --> 00:16:44,970
.يا لجرأة هؤلاء الحمقى

238
00:16:45,220 --> 00:16:48,000
إذًا، ما الّذي تُريد مَعونتي فيه؟

239
00:16:49,750 --> 00:16:50,990
.أنا واقعٌ في الحُبّ

240
00:16:50,990 --> 00:16:53,210
.حقًا؟ سأدعمك بكُلّ تأكيد

241
00:16:53,480 --> 00:16:58,680
،يُقال إنّك تَستميل أيّ قلبٍ ينبض
.لذلك قصدتك

242
00:16:58,680 --> 00:17:00,990
لست واثقًا مِن أنّني
.أُحب وصفك هذا

243
00:17:01,320 --> 00:17:02,670
.شكرًا لانتظاركما

244
00:17:03,920 --> 00:17:06,160
،لا بُدّ أنّك تُحبّ السوبا كثيرًا

245
00:17:06,800 --> 00:17:09,380
.فهذه زيارتك الخامسة اليوم

246
00:17:09,380 --> 00:17:10,160
ماذا؟

247
00:17:10,500 --> 00:17:13,130
.أجل، بالتّأكيد

248
00:17:13,130 --> 00:17:15,260
،أنا لا أشبع من السّوبا أبدًا

249
00:17:20,510 --> 00:17:22,460
!فهي شهيّةٌ للغاية

250
00:17:24,970 --> 00:17:27,350
!كفاك إذلالًا لنفسك يا تودو-سان

251
00:17:28,550 --> 00:17:30,290
ماذا عساي أن أفعل غير هذا؟

252
00:17:30,590 --> 00:17:31,800
.إنّهما مِن المِيبورو

253
00:17:31,800 --> 00:17:33,030
.إيّاكِ وتبادل النّظرات معهما

254
00:17:33,590 --> 00:17:36,450
،إنّنا نخدم آيزو الآن
أليس كذلك؟

255
00:17:36,750 --> 00:17:39,370
يبدو أنّ سُكّان المدينة
.لم تبلغهم الأخبار بعد

256
00:17:39,370 --> 00:17:41,500
!أجل، بالتّأكيد، الملابس

257
00:17:41,740 --> 00:17:47,000
أفهم ما ترمي إليه، لعلّ العامّة يثقون
.بنا أكثر حين يروننا بمعاطف مُوحّدة

258
00:17:47,200 --> 00:17:52,010
كلا! الملابس الأنيقة والسّيوف الثّمينة
!ستجعلها تُغيّر نظرتها إليّ كُليًا

259
00:17:52,010 --> 00:17:53,090
أأنت جادٌ فيما تقول؟

260
00:18:01,080 --> 00:18:04,250
لا أظنّه سيسمح لي باستعارة
سيفه أبدًا، أليس كذلك؟

261
00:18:04,470 --> 00:18:07,210
.السّيف رُوح السّاموراي

262
00:18:07,570 --> 00:18:08,760
.أمرٌ غير قابلٍ للنّقاش

263
00:18:08,980 --> 00:18:10,500
.صدقت يا سيّدي

264
00:18:10,900 --> 00:18:11,760
،سيريزاوا-سان

265
00:18:12,840 --> 00:18:14,280
.المسألة تتعلّق بمشاعر القلب

266
00:18:17,200 --> 00:18:18,520
.استعره دُون تردّدٍ

267
00:18:18,760 --> 00:18:20,800
!بل وخُذ معطفي أيضًا

268
00:18:21,380 --> 00:18:22,700
.أنا ممتنٌ لك للغاية يا سيّدي

269
00:18:23,870 --> 00:18:25,530
.أهلًا بك

270
00:18:26,940 --> 00:18:28,780
!ضحكت عليّ

271
00:18:30,730 --> 00:18:32,630
.إنّه كبيرٌ عليك بعض الشّيء

272
00:18:32,630 --> 00:18:35,230
،سُحقًا
.سأَلجأ الآن لخُطّتي الأخيرة

273
00:18:35,430 --> 00:18:36,800
!هيّا، رافقاني

274
00:18:41,590 --> 00:18:44,910
،عندما تلتفّ حول المُنعطف القادم
،سيبدأ سانوسوكي بمُضايقتها

275
00:18:45,080 --> 00:18:46,680
.وحينها سأتدخّل أنا لإنقاذها

276
00:18:47,040 --> 00:18:48,470
.إنّها خطّةٌ مثاليّة

277
00:18:48,880 --> 00:18:50,350
.بل هي أحقر خطّةٍ على الإطلاق

278
00:18:57,370 --> 00:19:01,040
عذرًا، لماذا انضممت إلى
المِيبورو يا تودو-سان؟

279
00:19:01,040 --> 00:19:02,070
ماذا؟

280
00:19:02,400 --> 00:19:05,750
بلغني أنّك تلقّيت تدريبك في دار
.تدريب كوندو-سان في إيدو

281
00:19:09,170 --> 00:19:11,370
ولكن لم يلتحق به كُلّ تلاميذه
إلى هُنا، أليس كذلك؟

282
00:19:11,780 --> 00:19:14,470
،كُنت مُتردّدًا في البداية
...كما تعلم

283
00:19:14,470 --> 00:19:16,520
.أنا صلبٌ للغاية في الواقع

284
00:19:17,150 --> 00:19:17,930
.متيقنٌ مِن ذلك

285
00:19:18,250 --> 00:19:21,760
اعتقدت أنّني سأحظى بإعجاب
.النّساء إذا بلغت ذروة القوّة

286
00:19:22,200 --> 00:19:24,040
،ليس دافعًا نبيلًا
أليس كذلك؟

287
00:19:24,040 --> 00:19:28,020
كلا، بل أراه أمرًا فطريًا
.لدى جميع الكائنات الحيّة

288
00:19:28,350 --> 00:19:30,150
.إنّك صبيٌ غريب الأطوار حقًا

289
00:19:31,070 --> 00:19:34,780
،دأبت أُمّي على إخباري سرًا

290
00:19:35,190 --> 00:19:41,280
أنت سليل اللّورد إيزومي نو كامي مِن علاقةٍ"
".غير شرعيّة، فعِش حياةً تُشرّف هذا النّسب

291
00:19:41,540 --> 00:19:43,300
.هذا مثيرٌ للإعجاب

292
00:19:43,300 --> 00:19:45,160
.فوالدك رجلٌ له مكانةٌ هامّة

293
00:19:45,400 --> 00:19:47,440
.لا أُصدّق حرفًا ممّا قالت

294
00:19:47,440 --> 00:19:50,190
لكنّني رغم ذلك أسعى
.لأصنع لنفسي اسمًا مرموقًا

295
00:19:50,480 --> 00:19:51,920
.كي أُدخل السّرور على قلب أُمّي

296
00:19:54,950 --> 00:19:56,150
!شينسوكي-سان

297
00:19:56,340 --> 00:19:57,920
مرحبًا، هل طال انتظاركِ؟

298
00:20:00,680 --> 00:20:02,190
.يا لك مِن مُشاكس

299
00:20:06,630 --> 00:20:08,360
.هيّا بنا إلى المنزل يا نيو

300
00:20:08,360 --> 00:20:10,090
.ربّـ-رُبّما تكون هذه فكرةً جيّدة

301
00:20:10,930 --> 00:20:15,440
أراكِ تمرحين كثيرًا هُنا في
.وضح النّهار وسط الشّارع

302
00:20:15,980 --> 00:20:17,960
،دعينا نُشارككِ هذا المرح

303
00:20:17,960 --> 00:20:19,700
.أو سلّمينا ما معكِ مِن مالٍ

304
00:20:19,880 --> 00:20:22,110
ماذا؟
!هذا ليس سانوسوكي-سان

305
00:20:22,110 --> 00:20:23,790
،تودو-سان
.وقعنا في مأزقٍ حقًا

306
00:20:23,950 --> 00:20:24,640
ماذا؟

307
00:20:25,750 --> 00:20:28,030
!تبًا، تبًا، تبًا

308
00:20:27,210 --> 00:20:28,030
ماذا؟

309
00:20:28,190 --> 00:20:31,310
،حسنًا، كُفّ عن هذا
.فالآنسة لا ترغب في صُحبتك

310
00:20:31,310 --> 00:20:34,280
!توقّف، ستكسر ذراعي

311
00:20:35,840 --> 00:20:36,580
.تبًا

312
00:20:36,580 --> 00:20:37,840
مَن أنت بحقّ الجحيم؟

313
00:20:38,040 --> 00:20:40,330
،أنا مِن المِيبورو
.وإيّاك أن تنسى ذلك أبدًا

314
00:20:42,150 --> 00:20:42,840
!تبًا

315
00:20:43,840 --> 00:20:45,810
.شـ-شُكرًا جزيلًا لك

316
00:20:51,160 --> 00:20:52,150
!تودو-سان

317
00:20:52,740 --> 00:20:54,600
.يا لك مِن مزعجٍ

318
00:20:54,600 --> 00:20:56,330
!تودو-سان، تودو-سان

319
00:20:56,330 --> 00:20:57,640
ماذا؟

320
00:20:58,230 --> 00:21:00,110
.كنت رائعًا حقًا

321
00:21:02,360 --> 00:21:05,330
!أنا معجبٌ بك يا نيو

322
00:21:06,360 --> 00:21:08,120
دُكّان حِلاقة

323
00:21:06,360 --> 00:21:08,120
مفتوح

324
00:21:08,450 --> 00:21:10,000
.نيو، اتّخذت قراري

325
00:21:14,380 --> 00:21:16,390
،سأبدأ صفحةً جديدة

326
00:21:16,680 --> 00:21:19,370
،بدءًا مِن هذا اليوم فصاعدًا
!سأُكرّس حياتي لأهل كيوتو

327
00:21:20,800 --> 00:21:21,560
!أجل

328
00:21:22,520 --> 00:21:24,640
ما الّذي سيتبدّل بعد انضمام
المِيبورو لخدمة آيزو؟

329
00:21:25,520 --> 00:21:29,830
سنعمل بجدٍ أكثر مِن أيّ وقتٍ
.مضى لأجل أهل هذه المدينة

330
00:21:30,170 --> 00:21:31,640
.وهذا كافٍ جدًا

331
00:21:32,040 --> 00:21:33,540
،هيّا، لنمضِ إذن

332
00:21:33,540 --> 00:21:34,400
.على ما يبدو

333
00:21:35,520 --> 00:21:38,320
!هُناك الكثير مِن الفتيات غيرها

334
00:21:38,320 --> 00:21:40,440
.لـ-لنبذل جهدًا أكبر في المرّة القادمة

335
00:21:40,450 --> 00:21:42,100
.أرغب في لقاء المزيد منهنّ

336
00:21:42,100 --> 00:21:43,160
.ستفعل حتمًا

337
00:21:44,940 --> 00:21:49,950
باطنُ الكفّ

338
00:23:20,040 --> 00:23:25,460
الحلقة القادمة

339
00:23:21,330 --> 00:23:27,920
،بفضل عرض لُورد آيزو
،لم يعد المِيبورو شرذمةً مِن الرّونين

340
00:23:27,920 --> 00:23:33,920
،بل غدوا حُماةً يحملون لِواء مقاطعة آيزو
