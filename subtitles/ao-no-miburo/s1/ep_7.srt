1
00:00:09,180 --> 00:00:11,870
.بدأ النّعاس يغلبني

2
00:00:12,360 --> 00:00:14,030
.البرد قارسٌ في اللّيل

3
00:00:14,320 --> 00:00:19,060
كيف يُفترض بي أن أتعقّب
المشبوهين مِن النّاس في هذا الحشد؟

4
00:00:19,480 --> 00:00:20,670
.لعلّ الاستسلام أَسلم لي

5
00:00:21,330 --> 00:00:24,440
فأنا أعني، أنّهم قد يُزهقون
.رُوحي إن وقعت في قبضتهم

6
00:00:24,750 --> 00:00:25,720
.أحسنت صُنعًا

7
00:00:28,000 --> 00:00:30,290
ما الجدوى مِن التخفّي
إذا كنت ستفضح أمرنا الآن؟

8
00:00:30,690 --> 00:00:32,360
.سأتنحّى جانبًا

9
00:00:32,360 --> 00:00:35,550
فلن تستخلص منه أيّ معلومةٍ
.طالما بقيت أنا هنا

10
00:00:35,880 --> 00:00:37,520
.أجل، أتّفق معك

11
00:00:37,520 --> 00:00:40,560
.تقلّدت سيفًا حقيقيًا الآن

12
00:00:40,980 --> 00:00:44,820
أستبعد أن يكون قد لطّخ يديه
،بالدّماء في هذه الجرائم

13
00:00:45,510 --> 00:00:47,190
،ولكن إن أمكنك
.فأتِ بما يُثبت إدانته

14
00:00:47,510 --> 00:00:48,080
.أجل، سيّدي

15
00:00:48,280 --> 00:00:49,230
ماذا تقول؟

16
00:00:51,070 --> 00:00:53,150
أأنت واثقٌ ممّا تدّعيه؟

17
00:00:53,380 --> 00:00:57,980
لزمت مكاني للمُراقبة ليلةً كاملة
.ولم ألمح أثرًا لأيّ شخصٍ مَشبوه

18
00:00:57,980 --> 00:01:00,940
هل هو متورّطٌ حقًا في هذه المعمعة؟

19
00:01:00,940 --> 00:01:03,710
،أجل، إنّه متورّطٌ
.والآن، هيّا بنا

20
00:01:04,820 --> 00:01:06,590
حقًا؟

21
00:01:20,180 --> 00:01:25,890
ذئاب ميبو الزّرق

22
00:02:38,710 --> 00:02:41,090
،أهلًا بكما
.نيو-كون، تارو-كون

23
00:02:41,470 --> 00:02:44,590
،سُررت لمجيئكما
.فقد كنت في انتظاركما

24
00:02:45,770 --> 00:02:49,430
،أعددت بعض المُقبّلات
.تفضّلا بالدخول

25
00:02:49,690 --> 00:02:54,600
،مهلًا، هذا الصبيّ يبدو شديد الثّقة بنفسه
.أأنت واثقٌ ممّا نحن مُقدمون عليه؟ فلنَلزم الحذر الشّديد

26
00:02:55,180 --> 00:02:56,600
،سأدخل في صُلب الموضوع مباشرةً

27
00:02:57,720 --> 00:03:01,040
كنت أنت خلف ذلك الهُجوم الّذي
استهدفنا ليلة البارحة، أليس كذلك؟

28
00:03:01,260 --> 00:03:02,490
!مباشرٌ لدرجةٍ صادمة

29
00:03:02,920 --> 00:03:05,420
ماذا؟ أثمّة مَن اعتدى عليكما؟

30
00:03:05,420 --> 00:03:06,730
هل أصابكما أيّ مكروهٍ؟

31
00:03:06,730 --> 00:03:09,090
.لا تُجهد نفسك في اصطناع الدّهشة

32
00:03:09,840 --> 00:03:11,670
.سلّمني هيجيكاتا-سان هذه سابقًا

33
00:03:12,190 --> 00:03:14,880
وُجِدت هذه الورقة بحوزة
.مَن هاجمنا، جوتارو-سان

34
00:03:15,260 --> 00:03:20,880
صبيّان يتّجهان
جنوبًا
بمُحاذاة القناة النهريّة
مِيبورو

35
00:03:15,780 --> 00:03:20,880
مكتوبٌ فيها: "صبيّان يتّجهان جنوبًا
".بمُحاذاة القناة النهريّة، مِيبورو

36
00:03:23,120 --> 00:03:27,440
بالفعل، ولكن ما الّذي يدفعك
للظنّ بأنّني كاتبها؟

37
00:03:27,640 --> 00:03:28,560
هل علينا الخوض في هذا حقًا؟

38
00:03:28,830 --> 00:03:30,060
.كفاك حماقةً

39
00:03:30,060 --> 00:03:32,560
انخرطا في نقاشٍ
!يفوق قُدرتي على الفهم

40
00:03:32,880 --> 00:03:38,200
أخبرني، هل تعرّضتما للهُجوم
بعد مغادرتكما لي مباشرةً؟

41
00:03:38,610 --> 00:03:39,560
.أجل

42
00:03:40,000 --> 00:03:43,710
هل تعتقد صدقًا أنّني سبقتك جريًا
لأنقل تلك الرّسالة؟

43
00:03:44,120 --> 00:03:47,460
،ليس بالأمر المُشرّف
.لكنّني بطيءٌ جدًا في الجري

44
00:03:47,560 --> 00:03:48,120
.محقٌّ

45
00:03:49,080 --> 00:03:52,840
بيد أنّك لو أعدت طيّها
...وفقًا للعلامات الظّاهرة

46
00:03:54,360 --> 00:03:56,720
.سترى كم ستغدو رقيقةً

47
00:03:57,300 --> 00:03:59,920
.كأنّها كانت مربوطةٌ بشيءٍ ما

48
00:04:00,300 --> 00:04:01,380
ماذا تقصد؟

49
00:04:07,750 --> 00:04:09,300
استخدمت حَمامًا، أليس كذلك؟

50
00:04:10,260 --> 00:04:12,180
!بالطّبع، الحَمام الزّاجل

51
00:04:12,640 --> 00:04:15,390
بمقدورك إيصال الرّسالة
.دُون أن تبرح مكانك

52
00:04:16,670 --> 00:04:18,180
.وهي وسيلةٌ أسرع مِن البشر

53
00:04:18,360 --> 00:04:20,790
مُذهل! كيف اكتشفت ذلك؟

54
00:04:20,790 --> 00:04:22,070
!أقرَّ بفعلته

55
00:04:22,720 --> 00:04:26,000
رأيت حَمامًا على السّطح في الجهة
.المُقابلة حين كُنت هنا آخر مرّةٍ

56
00:04:26,500 --> 00:04:27,840
.وقد أَثار ذلك تساؤلي

57
00:04:28,100 --> 00:04:29,840
.إذن، لاحظت ذلك

58
00:04:29,840 --> 00:04:31,500
!لا شيء يفوته أبدًا

59
00:04:31,800 --> 00:04:35,460
مهلًا، ولكن... هل يُسمح له حقًا
بإرسال الحمام الزّاجل بهذه البساطة؟

60
00:04:35,950 --> 00:04:39,130
،أشكّ في ذلك
.فقد حظر الشّوغون استعمالها تمامًا

61
00:04:39,690 --> 00:04:41,960
سيزجّون بي في غياهب السّجن
.إن قبضوا عليّ

62
00:04:44,210 --> 00:04:46,560
.خسرت يا صاحب الخصلات الذّهبية

63
00:04:46,900 --> 00:04:48,470
إذن، أين دليلك؟

64
00:04:50,430 --> 00:04:52,980
ما الّذي ستجنيه حقًا يا سيتو-كون؟

65
00:04:54,890 --> 00:04:58,570
،طال تفكيري
.لكنّني عجزت عن فهم مقصدك

66
00:05:01,490 --> 00:05:04,320
أولئك الرّجال يمقتون
،الشّوغون صدقًا

67
00:05:04,610 --> 00:05:08,620
،ويكرهون معه مؤيّديه في آيزو
.وعملاءهم من المِيبورو

68
00:05:09,880 --> 00:05:13,100
أيّ جُرمٍ في منح المعلومات لمن ينشدها؟

69
00:05:13,100 --> 00:05:14,580
.بدا امتنانهم واضحًا

70
00:05:14,780 --> 00:05:18,000
أدركت الأمر! لا بُدّ أنّك تجني أموالًا
.طائلة مِن خلف بيعك لهذه المعلومات

71
00:05:18,520 --> 00:05:21,130
،كلا
.لم أتقاضَ قرشًا واحدًا لقاء ذلك

72
00:05:22,270 --> 00:05:24,960
لم تقوم بذلك إن كُنت لا تبتغي مالًا؟

73
00:05:25,610 --> 00:05:28,240
هل يُعدّ إيذاء البشر جُرمًا؟

74
00:05:28,680 --> 00:05:30,720
وهل محبّتهم تجلب لك المديح؟

75
00:05:33,640 --> 00:05:35,480
ما رأيك أنت يا نيو-كون؟

76
00:05:37,840 --> 00:05:39,720
.لا أعلم

77
00:05:40,080 --> 00:05:43,700
،أنا على يقينٍ أنّك لا تعلم
.هذا العالم مليءٌ بالتّرهات

78
00:05:43,970 --> 00:05:44,990
مثل ماذا؟

79
00:05:45,360 --> 00:05:47,270
...مثل... لننظُر مليًا إلى

80
00:05:47,520 --> 00:05:50,240
،تأمّل في حياة المرء برمّتها

81
00:05:50,990 --> 00:05:54,560
نسبك وترتيبك بين إخوتك
.يرسمان قدرك

82
00:05:55,300 --> 00:05:57,960
،كُلّ النّاس يُدركون هذه الحقيقة
لكن ألا ترى غرابةً في ذلك؟

83
00:05:58,540 --> 00:06:00,910
،مَن يُولد لفلّاحٍ يبقى فلاحًا

84
00:06:01,200 --> 00:06:03,960
،ذُريّة السّاموراي تُصبح ساموراي
.والنّاتج عن التُّجار تاجرٌ

85
00:06:04,480 --> 00:06:06,640
،يرث الابن الأكبر مكانة أبيه قسرًا

86
00:06:06,880 --> 00:06:09,480
بينما يعيش مَن هُو أصغر منه
.عالةً طوال العُمر

87
00:06:09,720 --> 00:06:14,470
،لا مفر مِن هذا القيد إلّا لطبيبٍ، أو سيّافٍ
.أو عالمٍ بحّاثة

88
00:06:14,930 --> 00:06:18,700
ولكن للأسف، ليس لديّ أيّ اهتمامٍ
.بأن أكون أيًا مِن هؤلاء

89
00:06:19,780 --> 00:06:24,110
كفاك هراءً! أَلديك ما تشكو منه
وأنت سليل أصحاب هذا الدُكّان الضّخم؟

90
00:06:24,600 --> 00:06:26,930
.خيالك محدودٌ للأسف

91
00:06:27,120 --> 00:06:30,620
،لا فرق بين كبيرٍ أو صغيرٍ
.فالكُلّ يحمل همًا يشكو منه

92
00:06:31,400 --> 00:06:33,060
أَتسأل عمّا أريد؟

93
00:06:33,400 --> 00:06:34,840
.لا شيء على الإطلاق

94
00:06:36,880 --> 00:06:40,280
،كُلّ ما في الأمر أنّني أستمتع بوقتي
.مُجرّد خدعةٍ بسيطة لا أكثر

95
00:06:43,710 --> 00:06:47,560
لكن الأمر يتجاوز كونه مُجرّد خدعةٍ بسيطة
.حين يتعرّض النّاس للأذى

96
00:06:48,440 --> 00:06:51,560
لن أسمح لك بالاستمرار في هذا العبث
.وتفلت مِن العقاب

97
00:06:55,660 --> 00:06:58,560
!استسلمت
إلى أيّ مدىً يُمكن أن يصل عنادك؟

98
00:06:58,950 --> 00:07:04,180
أجل! سأظلّ أُراقب الحمام الزّاجل
!كي لا تُقدم على أيّ خطوةٍ غادرة

99
00:07:04,180 --> 00:07:06,050
.حسنًا، حسنًا

100
00:07:06,050 --> 00:07:07,820
.سأنسحب مِن هذا العمل برمّته

101
00:07:07,820 --> 00:07:09,310
حقًا؟

102
00:07:09,310 --> 00:07:11,570
،بكُلّ تأكيد
.وسأثبت لك ذلك

103
00:07:12,560 --> 00:07:14,030
هذا ما تبتغيه، أليس كذلك؟

104
00:07:14,400 --> 00:07:17,460
هذه قائمةٌ بالنّزل الّتي يعتاد
.أولئك الرّجال الإقامة فيها

105
00:07:18,890 --> 00:07:20,490
!رائعٌ، أحسنت يا نيو

106
00:07:20,680 --> 00:07:21,340
.أبقها معك

107
00:07:21,870 --> 00:07:23,220
!لماذا؟

108
00:07:23,220 --> 00:07:24,490
.لا أشعر بالارتياح تجاه تصرّفه هذا

109
00:07:24,490 --> 00:07:25,380
!كفاك تصرفًا كالأطفال

110
00:07:25,930 --> 00:07:30,140
أأنت متأكّدٌ؟ لن يتراجعوا لمُجرّد
.أنّني توقّفت عن العمل معهم

111
00:07:32,640 --> 00:07:34,470
.سنعثر عليهم دُون تلك الورقة

112
00:07:35,120 --> 00:07:38,260
كُلّ فردٍ من المِيبورو يبحث عنهم
.في كُلّ شبرٍ بينما نتحدّث الآن

113
00:07:40,760 --> 00:07:42,210
.ليس هذا بالأُسلوب المُجدي تمامًا

114
00:07:42,210 --> 00:07:43,140
!لا بأس

115
00:07:43,950 --> 00:07:47,370
،الآن وبعد أن حسمنا هذا الأمر
.تارو-كون، هيّا بنا لنلحق بالبقيّة

116
00:07:47,370 --> 00:07:49,840
!لماذا؟ هل أنت أحمق؟

117
00:07:49,840 --> 00:07:51,150
!نيو، تارو

118
00:07:51,640 --> 00:07:54,660
وصلتنا للتّو معلومةٌ عن النّزل
.الّذي يتواجدون فيه

119
00:07:54,660 --> 00:07:56,000
هل عثروا عليهم فعلًا؟

120
00:07:59,780 --> 00:08:02,450
أَرأيت؟ أليست فرقة المِيبورو
قوّةً لا يُستهان بها؟

121
00:08:02,450 --> 00:08:03,680
!هيّا أسرعا

122
00:08:03,680 --> 00:08:05,190
،أجل سيدّي
.نحن في الطّريق إليكم الآن

123
00:08:05,910 --> 00:08:06,720
.نيو-كون

124
00:08:07,450 --> 00:08:10,470
هل تبدّل حالك قليلًا عن الأمس؟

125
00:08:11,720 --> 00:08:14,890
،أنت مستشيطٌ غضبًا
ألست مُحقًا؟

126
00:08:17,360 --> 00:08:22,520
في داخلك، لا تحتمل أن
.يتجبّر الغُرباء في موطنك

127
00:08:23,250 --> 00:08:26,890
،لذا سرّبت المعلومات
.آملًا أن يقتل بعضنا بعضًا

128
00:08:27,940 --> 00:08:31,400
ما قُلته سابقًا ليس سوى واجهةٍ
.تتصنّعها أمام النّاس

129
00:08:31,560 --> 00:08:34,660
،تُرهاّت
.ليس لديّ أدنى فكرةٍ عمّا تقوله

130
00:08:35,630 --> 00:08:37,840
نيو! ما الّذي يُؤخّرك؟
!هيّا بنا

131
00:08:37,840 --> 00:08:39,000
.حسنًا

132
00:08:39,000 --> 00:08:40,400
،وداعًا يا سيتو-كون
.نراك لاحقًا

133
00:08:40,760 --> 00:08:41,870
!عجّل قليلًا

134
00:08:41,870 --> 00:08:43,910
.أنت متسرّعٌ جدًا يا تارو-كون

135
00:08:45,350 --> 00:08:46,100
...نيو

136
00:08:50,140 --> 00:08:51,920
.يا له مِن شخصٍ غريب الأطوار

137
00:08:56,440 --> 00:08:59,600
.بلغني أنّهم يتردّدون على هذا النّزل

138
00:08:59,600 --> 00:09:03,010
،صِرنا في وضح النّهار الآن
.رُبّما غادروا المكان

139
00:09:03,480 --> 00:09:04,770
.تبقّى أربعةٌ منهم

140
00:09:05,150 --> 00:09:05,800
.أجل

141
00:09:06,060 --> 00:09:09,240
،كان عددهم خمسةً
.لكن سوجي قد صرع أحدهم بالفعل

142
00:09:11,250 --> 00:09:11,870
.لنقتحم المكان

143
00:09:11,870 --> 00:09:12,940
!أيّها الرّجال

144
00:09:13,200 --> 00:09:14,930
.إنّهم نيو والبقيّة

145
00:09:15,520 --> 00:09:16,580
.جئنا في الوقت المُناسب

146
00:09:16,860 --> 00:09:18,320
.أجل، اكتمل شملنا الآن

147
00:09:18,320 --> 00:09:19,450
.أنا هالكٌ لا محالة

148
00:09:19,740 --> 00:09:20,640
.كوندو-سان

149
00:09:20,840 --> 00:09:21,960
،أعلم ذلك

150
00:09:22,420 --> 00:09:24,510
.لسنا هنا للقتل

151
00:09:24,960 --> 00:09:26,360
.اعتقلوهم أحياءً إن استطعتم

152
00:09:26,640 --> 00:09:30,470
،سنستمع إلى أقوالهم
.ثُمّ نُحاسبهم على جرائمهم

153
00:09:30,780 --> 00:09:31,270
.أجل، سيّدي

154
00:09:32,480 --> 00:09:34,970
سنتولّى أنا وهارا-سان
.حراسة الباب الخلفيّ

155
00:09:35,150 --> 00:09:35,690
.جيّد

156
00:09:36,270 --> 00:09:36,970
.انطلقوا

157
00:09:37,240 --> 00:09:38,680
.حسنًا

158
00:09:39,700 --> 00:09:40,600
.الحقوا بي

159
00:09:40,600 --> 00:09:41,830
!هذا طريقٌ خاطئ

160
00:09:41,830 --> 00:09:42,730
!التف للخلف

161
00:09:42,720 --> 00:09:44,730
نُزل ميزوتايا

162
00:09:46,390 --> 00:09:49,720
تلقّينا أنباءً أنّ عصابةً مِن الخارجين
.عن القانون قد لجأت إلى هذا النّزل

163
00:09:49,960 --> 00:09:52,790
،أخلوا المكان فورًا
.فهم يُشكّلون خطرًا حقيقيًا

164
00:09:52,790 --> 00:09:54,450
.سنفتّش الطّابق الأوّل

165
00:09:55,240 --> 00:09:56,250
.سأتولّى أنا الطّابق الثّاني

166
00:09:56,250 --> 00:09:58,760
!رُحماك أيّها السّاموراي

167
00:09:58,760 --> 00:10:01,970
.لا تُلوّحوا بسيوفكم داخل الغرف

168
00:10:01,970 --> 00:10:04,240
ماذا لو تعرّض النّزلاء للأذى؟

169
00:10:06,920 --> 00:10:08,160
.أتوسّل إليك أيّها السّاموراي

170
00:10:08,160 --> 00:10:08,950
.كوندو-سان

171
00:10:09,560 --> 00:10:10,750
.لا بأس يا سيّدتي

172
00:10:11,480 --> 00:10:14,240
،لن نُلوّح بسيوفنا
.أعدكِ بذلك صادقًا

173
00:10:17,840 --> 00:10:22,260
أظنّ أنّ نُزلاء الغرفة الخلفيّة
.يتردّدون عليها ليلًا

174
00:10:22,820 --> 00:10:23,520
!إذن هي الغرفة المقصودة

175
00:10:27,520 --> 00:10:28,320
ماذا؟

176
00:10:31,200 --> 00:10:33,190
هل تبحثون عن شخصٍ ما؟

177
00:10:34,020 --> 00:10:36,030
نُزل ميزوتايا

178
00:10:40,540 --> 00:10:43,720
،فهمت الآن
.قدمتم مِن مسافةٍ طويلة مِن إيدو

179
00:10:44,130 --> 00:10:46,930
.أنا أنحدر مِن آيزو

180
00:10:47,160 --> 00:10:49,820
مِن آيزو أنت؟
.إنّها لمصادفةٌ غريبة

181
00:10:49,820 --> 00:10:52,040
!لماذا نحتسي الشّاي مع هذا العجوز؟

182
00:10:52,270 --> 00:10:57,790
بالمُناسبة أيّها السّاموراي، هل تملك مهارةً
فائقة في فنّ المُبارزة بالسّيف؟

183
00:10:58,170 --> 00:11:03,670
،أجل، لا أملك موهبةً غيرها
.فأنا أصقل مهارتي بالسّيف ليل نهار

184
00:11:04,320 --> 00:11:07,140
أظنّ أنّ الطّريق لإتقان السّيف
.يحتاج تدريبًا شاقًا بالفعل

185
00:11:07,140 --> 00:11:08,300
.دون شكٍ

186
00:11:09,550 --> 00:11:10,850
!إنّه يُجاريه بالحديث

187
00:11:10,860 --> 00:11:12,860
نُزل ميزوتايا

188
00:11:13,000 --> 00:11:13,850
ماذا؟

189
00:11:14,340 --> 00:11:18,370
كنت تُدير دارًا للتّدريب في إيدو؟
وهل كان هؤلاء الرّفاق تلاميذك؟

190
00:11:18,650 --> 00:11:22,870
كلا، انضمّ هؤلاء الصّبيان
.إلينا في كيوتو

191
00:11:23,570 --> 00:11:25,410
—لا بُدّ أنّ صِيتك ذائعٌ جدًا

192
00:11:25,410 --> 00:11:28,320
،كلا
.كانت مُجرّد دار تدريبٍ صغيرة

193
00:11:28,790 --> 00:11:33,120
عانت زوجتي كثيرًا لتدبير لُقمة العيش
.حين زاد عدد أفراد الأسرة

194
00:11:36,170 --> 00:11:37,880
!هل هو متزوجٌ؟

195
00:11:38,280 --> 00:11:40,260
.كما أنّ طفلنا لا يزال رضيعًا

196
00:11:40,480 --> 00:11:41,760
!لديه طفلٌ أيضًا

197
00:11:42,050 --> 00:11:45,520
يا للهول، لا شكّ أنّك
.خُضت صراعًا مريرًا

198
00:11:45,840 --> 00:11:48,520
،كلا
.لم ينهش الضّيق صدري أبدًا

199
00:11:50,430 --> 00:11:51,480
.أسرّتني تلك الصّنادل فحسب

200
00:11:52,320 --> 00:11:57,770
كانت رُؤية أزواج الصّنادل وهي تتكاثر عند
.مدخل المنزل تملأني غبطةً، ولا أجد تفسيرًا لذلك

201
00:11:58,500 --> 00:12:01,520
لكن الابتسامة كانت ترتسم على
.وجهي رغمًا عنّي كُلّما أبصرتها

202
00:12:02,080 --> 00:12:06,660
أخيرًا، كفّت زوجتي عن
.مُحاولة تغيير قناعتي

203
00:12:07,760 --> 00:12:10,360
أفنيت أيّامي أتصبّب عرقًا
،لأُبرهن على جدارتي

204
00:12:10,770 --> 00:12:13,540
وأمضيت لياليّ في نقاشاتٍ
.لا تنتهي عن فنّ السّيف

205
00:12:14,050 --> 00:12:16,040
.يا لها مِن أيامٍ لا تُنسى

206
00:12:16,370 --> 00:12:21,040
إذًا، ألا ترى أنّ بقاءك للخدمة
في كيوتو قد صار حملًا ثقيلًا؟

207
00:12:21,360 --> 00:12:25,100
،أبدًا، فأنا أجد لذّةً في ذلك
.فكُلّ يومٍ هو مغامرةٌ بذاتها

208
00:12:25,680 --> 00:12:27,840
لا أزال قادرًا على التّفاني
،في طريق السّيف

209
00:12:28,280 --> 00:12:31,420
وتطهير المدينة مِن الأشرار
.يجعل الغاية مِن حياتي جليّةً

210
00:12:31,880 --> 00:12:37,400
،هدفي هو رفاه النّاس
.وطاعة الشّوغون والإمبراطور

211
00:12:38,080 --> 00:12:39,360
أليس كذلك يا نيو؟

212
00:12:40,490 --> 00:12:41,090
.أجل، سيّدي

213
00:12:42,120 --> 00:12:46,860
أظنّ أنّني فهمت السّبب الّذي يجعل
.أتباعك يمتثلون لك بكُلّ هذا الإخلاص

214
00:12:52,180 --> 00:12:53,630
لماذا تلجأ إلى الاغتيال؟

215
00:12:54,630 --> 00:12:57,620
ا-اغتيال؟! هذا العجوز؟

216
00:12:57,810 --> 00:13:00,370
،محالٌ
.إنّه يبدو هزيلًا للغاية

217
00:13:00,650 --> 00:13:03,460
،نيو
هل كنت تعلم شيئًا عن هذا؟

218
00:13:05,040 --> 00:13:06,920
.ما فعلته كان قصاصًا لما حدث لابني

219
00:13:08,910 --> 00:13:14,620
،خدعوني بوعودٍ عن منصبٍ رسميّ
.وكان ذلك محض افتراءٍ

220
00:13:15,500 --> 00:13:19,440
،سلبوا أموالنا دُون مقابلٍ
.وخطف الموت زوجتي بعد صراعٍ مع المرض

221
00:13:20,360 --> 00:13:22,320
.ثُمّ أقدم ابني على الانتحار بَقرًا

222
00:13:23,220 --> 00:13:27,440
،ومع ذلك
.فأنا جانٍ ارتكب جرائم فظيعةً

223
00:13:29,150 --> 00:13:30,740
.سلّم نفسك بهدوءٍ

224
00:13:38,190 --> 00:13:39,120
.كُفّ عن ذلك

225
00:13:39,800 --> 00:13:41,210
.لن تنال إلّا الأذى

226
00:13:43,630 --> 00:13:47,350
أدركت مُنذ اللّحظة الأولى
.أنّني لن أقوى على هزيمتك

227
00:13:47,820 --> 00:13:48,330
.أجل

228
00:13:49,840 --> 00:13:54,320
.لكنّني لم أثأر لابني الرّاحل بعد

229
00:13:54,830 --> 00:13:55,680
.فهمت

230
00:13:58,470 --> 00:14:00,010
!كوندو-سان، لاذ بالفرار

231
00:14:00,730 --> 00:14:01,600
ماذا؟

232
00:14:01,800 --> 00:14:02,580
!قف مكانك

233
00:14:02,580 --> 00:14:03,400
!تنحّ عن الطّريق

234
00:14:06,640 --> 00:14:10,780
،كُنت أتساءل عن سبب هذا الصّمت
.وعمّا أخّركم إلى هذا الحدّ

235
00:14:11,090 --> 00:14:11,960
!يا رفاق

236
00:14:12,910 --> 00:14:14,420
نُزل ميزوتايا

237
00:14:14,600 --> 00:14:16,220
!قبضت عليك

238
00:14:17,730 --> 00:14:19,410
!أَفلتني، تبًا لك

239
00:14:19,760 --> 00:14:21,900
هل ما قُلته كان كذبًا؟

240
00:14:21,900 --> 00:14:22,670
ماذا؟

241
00:14:23,000 --> 00:14:24,720
ماذا عن ابنك إذن؟

242
00:14:24,930 --> 00:14:29,300
،كذبةٌ أخرى بالطّبع
!ابني الأحمق حيٌّ يُرزق في الرّيف

243
00:14:29,720 --> 00:14:30,810
حقًا؟

244
00:14:32,410 --> 00:14:33,660
.يسرّني سماع ذلك

245
00:14:36,560 --> 00:14:40,380
،كوندو-سان
.أنت صريحٌ لدرجة السّذاجة

246
00:14:40,850 --> 00:14:42,310
.وتثق بالنّاس بسهولةٍ

247
00:14:48,120 --> 00:14:49,320
.هيّا بنا

248
00:14:49,320 --> 00:14:50,370
.تحرّك، سِر أمامي

249
00:14:51,450 --> 00:14:53,830
.معذرةٌ على الإزعاج

250
00:14:54,290 --> 00:14:55,160
.لا بأس

251
00:14:55,640 --> 00:14:56,430
...أ-أنا

252
00:14:57,250 --> 00:15:00,480
شكرًا لك لأنّك أوفيت بوعدك
.ولم تستلّ سيفك

253
00:15:04,210 --> 00:15:06,380
.كنت أدرك يقينًا نُبل كوندو-سان

254
00:15:07,000 --> 00:15:10,810
.فهذا سرّ التفاف النّاس حوله

255
00:15:11,340 --> 00:15:13,850
شراب

256
00:15:18,520 --> 00:15:22,030
أظنّ أنّ الوقت قد حان
.لأبدأ التحرّك

257
00:15:23,910 --> 00:15:25,000
.غربت الشّمس

258
00:15:25,850 --> 00:15:27,610
لن نسمح بسقوط ضحايا آخرين
.بعد الآن

259
00:15:28,050 --> 00:15:32,560
لا يزال هناك ثلاثةٌ مِن الخارجين عن القانون ممّن
.هاجموا ساموراي آيزو، وسنتولّى أمرهم هذه الليلة

260
00:15:33,200 --> 00:15:35,910
،لكنّهم عصابةٌ ماكرة

261
00:15:36,200 --> 00:15:38,410
.ولا نعلم ما قد يُقدمون عليه

262
00:15:38,720 --> 00:15:41,750
محقٌّ، أرسلوا خبرًا إلى
.سيريزاوا-سان ورجاله

263
00:15:42,000 --> 00:15:42,620
.تارو

264
00:15:43,320 --> 00:15:47,130
أخبره أن يظلّ يقظًا، وأن يقبض
.عليهم أحياءً إن كان ذلك ممكنًا

265
00:15:47,130 --> 00:15:48,630
!أجل، يا سيّدي

266
00:15:48,980 --> 00:15:52,010
،نحن نعتمد عليك يا تارو-كون
.فلديك مهمّة جسيمةٌ لتؤدّيها

267
00:15:52,010 --> 00:15:53,170
!تبًا لهذا

268
00:15:54,120 --> 00:15:57,200
لماذا لم يكن في محلّه المُعتاد؟

269
00:15:57,200 --> 00:16:01,150
،كيف لي أن أعثر عليه الآن؟ يا للعجب
لماذا تحدث هذه الأمور لي فقط؟

270
00:16:02,420 --> 00:16:04,300
!وطئت قدمي النّجاسة

271
00:16:09,420 --> 00:16:10,780
.تماسك يا تارو-كون

272
00:16:11,050 --> 00:16:14,440
تبًا، لم أرَ خيرًا قطّ
.مُنذ حلّ ذلك الصبيّ بيننا

273
00:16:14,660 --> 00:16:17,540
!تنحَّ عن طريقي

274
00:16:16,190 --> 00:16:17,540
!هـ-هذا الصوت ليس غريبًا عليّ

275
00:16:18,690 --> 00:16:20,500
.سيريزاوا-سينسي

276
00:16:21,870 --> 00:16:22,840
ماذا؟

277
00:16:23,280 --> 00:16:25,300
!نظراته تائهة تمامًا؟

278
00:16:25,440 --> 00:16:27,490
أين ذلك القاتل؟

279
00:16:27,060 --> 00:16:30,380
!اصمت
ماذا ستفعل إن ظهروا حقًا؟

280
00:16:27,840 --> 00:16:30,380
!سيريزاوا كامو أمامك بشحمه ولحمه

281
00:16:30,380 --> 00:16:31,290
.أنت المقصود دُون شكٍ

282
00:16:32,740 --> 00:16:36,050
.رجلٌ ضخم ويرتدي معطفًا أبيض اللّون

283
00:16:36,250 --> 00:16:40,060
.بلغني أنّك تُسمّي نفسك زعيم المِيبورو

284
00:16:40,240 --> 00:16:41,690
!عثروا علينا

285
00:16:41,940 --> 00:16:46,200
اسمح لي أن أُنزل بك
.القصاص الّذي تستحقه

286
00:16:51,770 --> 00:16:55,950
.أظنّ أنّني سأقوم بدور الشّرير إذن

287
00:16:56,240 --> 00:16:57,830
.يا للهول

288
00:16:58,090 --> 00:17:00,830
،لا أمل يُرجى منه
.فهو يترنّح ولا يقوى على الثّبات

289
00:17:02,160 --> 00:17:04,210
.ستكون نهايتنا

290
00:17:06,940 --> 00:17:08,380
.الدّكاكين ستُغلق أبوابها قريبًا

291
00:17:08,690 --> 00:17:10,960
أخبروا كل مَن يسير في الخارج
.بالاحتماء في الدّاخل

292
00:17:11,220 --> 00:17:11,770
.أجل، سيّدي

293
00:17:12,510 --> 00:17:17,050
،أنذروا كُلّ النّساء والأطفال
.وسيروا مع المُسنّين حتّى يبلغوا منازلهم

294
00:17:17,320 --> 00:17:20,510
!الخُروج في هذه السّاعة خطرٌ كبير

295
00:17:20,810 --> 00:17:22,380
.هيّا، أسرعوا إلى منازلكم

296
00:17:22,550 --> 00:17:25,450
،يا لجُرأتكم
!تتبادلون الغزل أمام مرأى الجميع

297
00:17:25,450 --> 00:17:27,040
.يبدو أنّ الغيرة تقتلك لا أكثر

298
00:17:27,040 --> 00:17:29,170
أسرعي إلى بيتكِ
.قبل أن يسدل اللّيل ستاره

299
00:17:29,660 --> 00:17:32,020
،تحرّك
.فالخطر يُحيط بك أيضًا

300
00:17:32,240 --> 00:17:36,030
أتوّسل إليكم، لا تسيروا في
!الطّرقات بعد حُلول الظّلام

301
00:17:36,030 --> 00:17:38,250
،كوندو-سان
.أرى مزيدًا مِن النّاس هناك

302
00:17:38,250 --> 00:17:38,900
.لننطلق

303
00:17:38,900 --> 00:17:39,400
.حسنًا

304
00:17:50,830 --> 00:17:51,440
.يا هذا

305
00:17:54,760 --> 00:17:58,390
،أنت تتربّص بنا لتغتالنا
أليس كذلك؟

306
00:18:00,060 --> 00:18:02,640
،سُقت نفسك إلى الموت
.ووفّرت عليّ مشقّة البحث

307
00:18:03,080 --> 00:18:05,020
.حسبت أنّكم فررتم إلى قُراكم النّائية

308
00:18:05,160 --> 00:18:09,980
،عندما يتولّى الشينوبي مُهمةً
.فإنّه يُتمّها دومًا حتّى النّهاية

309
00:18:16,250 --> 00:18:21,000
،ذاك القتيل، جوتارو أو أيًا كان اسمه
،عُثر معه على هذه المحفظة

310
00:18:22,570 --> 00:18:24,680
.ونقشها يُطابق نقش زِيّك

311
00:18:24,910 --> 00:18:27,240
.لم أُلاحظ ذلك بنفسي

312
00:18:27,750 --> 00:18:32,110
،بل كان نيو
.ذاك الصبيّ ذُو الشّعر الأبيض

313
00:18:32,830 --> 00:18:39,090
،شكّ في وُجود صلةٍ تجمعك بجوتارو
.وأعرب عن رغبته في إعادتها إليك

314
00:18:40,760 --> 00:18:45,770
:أوصاني أن أُبلّغك ما يلي
".أرجو أن تقبل بالاتّفاق بيننا الآن"

315
00:18:50,830 --> 00:18:53,690
أجزم أنّ الحفاظ على توازنك
،في هذا العُلوّ صعبٌ عليك

316
00:18:53,840 --> 00:18:56,440
.بخلافنا نحن شينوبي ساتسوما

317
00:18:56,780 --> 00:19:00,840
،أتفهّم سبب غضبك
.فأغلب النّاس قد يحسبون كلامه تهكّمًا

318
00:19:02,670 --> 00:19:06,160
.لكنّني أظنّ أنّه يُريد بك خيرًا

319
00:19:07,010 --> 00:19:10,440
مع أنّك شريكٌ لرجلٍ
.حاول سلبه حياته

320
00:19:12,710 --> 00:19:17,960
غاضبٌ؟
.نحن الشّينوبي لا تُحرّكنا المشاعر

321
00:19:18,540 --> 00:19:22,700
،إذًا هذا هو ديدن الشّينوبي
.لا شكّ أنّك تعتزّ بهذا المبدأ

322
00:19:23,020 --> 00:19:25,980
،أُدرك شعورك
.فقد كان حالي هو حالك تمامًا

323
00:19:27,040 --> 00:19:30,850
الرّجل الّذي تولّى تربيتي كان
،يُجسّد صورة السّاموراي المثاليّ

324
00:19:31,400 --> 00:19:33,750
ورسّخ في كياني أنّ
.عماد السّاموراي هو القوّة

325
00:19:35,510 --> 00:19:37,800
،فالقوّة هي ميزة المُحارب

326
00:19:38,190 --> 00:19:41,860
،ومَن أراد أن يحيا كساموراي
.فلا بُدّ له مِن تقديس القوّة

327
00:19:43,790 --> 00:19:45,790
،كما أنّه كان شديد التمسّك بالأعراف

328
00:19:46,300 --> 00:19:49,280
:فكان يقول
".إيّاك وأن تدع غريبًا يقف عن شمالك"

329
00:19:49,810 --> 00:19:52,120
ويُردّد: "ليس بمقدورك أن تسحب سيفك
".وتُصيب خصمك في لحظةٍ واحدة

330
00:19:52,280 --> 00:19:53,630
ما الّذي ترمي إليه؟

331
00:19:54,060 --> 00:19:56,630
،ما أقصده هو أنّ نيو فتىً مُثير للمشاكل

332
00:19:59,080 --> 00:20:01,000
،لا أمل يُرجى منه في استخدام السّيف

333
00:20:01,310 --> 00:20:02,390
،فقد فشل فيه تمامًا

334
00:20:03,130 --> 00:20:05,760
كما أنّه يُجادل كثيرًا، ويملاه الغُرور
.بسبب مهارته في مصارعة السّومو

335
00:20:05,760 --> 00:20:08,800
،يتسلّط على النّاس ويأمرهم
.ثُمّ يتمرّد هو على كُلّ الأوامر

336
00:20:08,800 --> 00:20:14,310
،"ساعدني في الغسيل"، "راقب النّار"
"لا تدخل بقدمين مُتّسختين"، "اعتنِ بهذا الصبيّ"

337
00:20:14,800 --> 00:20:16,370
،خلاصة القول
.إنّه شخصٌ مزعج للغاية

338
00:20:16,740 --> 00:20:19,900
صارت الحياة جحيمًا
.مُنذ أن صار فردًا في المِيبورو

339
00:20:20,620 --> 00:20:24,270
لكنّه ليس مُقيّدًا بأغلال التقاليد
.الّتي تُكبّلني أنا وأنت

340
00:20:24,850 --> 00:20:27,910
.لا تُقيّده أعرافٌ حول ما ينبغي فعله

341
00:20:28,650 --> 00:20:30,710
،لا أثر للكبرياء في نفسه

342
00:20:31,880 --> 00:20:36,200
أو لعلّ له منطقًا في الكبرياء
.يعجز عقلي عن إدراكه

343
00:20:36,980 --> 00:20:42,550
جُلّ ما أعلمه أنّه يُحاول مساندة
.كُلّ مَن هو ضعيفٌ أو مصاب

344
00:20:43,110 --> 00:20:47,510
بمعنى آخر، إنّه نقي السّريرة
...لدرجةٍ ميؤوس منها، لذا

345
00:20:47,510 --> 00:20:48,520
!كفى

346
00:20:50,010 --> 00:20:51,470
،كُفَّ عن الثّرثرة

347
00:20:51,870 --> 00:20:56,480
،فلن ينفعك طُول اللّسان في التغلّب عليّ
.كان عليك أن تعي ذلك جيدًا ممّا جرى بالأمس

348
00:20:56,980 --> 00:20:57,730
،أجل

349
00:20:58,840 --> 00:21:00,490
،لو كُنّا بالأمس
.لكان كلامك صحيحًا تمامًا

350
00:21:00,490 --> 00:21:01,360
ماذا؟

351
00:21:02,020 --> 00:21:05,120
ينبغي للسّاموراي أن يحمل سيفه"
".على جانبه الأيسر

352
00:21:08,390 --> 00:21:11,000
،أنت أعسر إذن
يا هاجيمي-كون؟

353
00:21:12,200 --> 00:21:14,260
،سُحقًا للمبادئ والقوانين والكبرياء

354
00:21:16,560 --> 00:21:18,680
.لم تعد قادرًا على غَلبتي بعد الآن

355
00:21:20,190 --> 00:21:22,750
يُقاتل بيده اليُسرى؟

356
00:21:24,430 --> 00:21:30,020
تعال معي صاغرًا، وإلّا بترت أطرافك
.قبل أن أُلقي بك في السّجن

357
00:21:31,230 --> 00:21:32,340
.قرّر حالًا

358
00:21:34,240 --> 00:21:35,220
.الوضع سيّئٌ

359
00:21:36,300 --> 00:21:38,560
!هذا الفتى نذير شرٍ

360
00:21:45,030 --> 00:21:50,030
كبرياءٌ

361
00:23:20,120 --> 00:23:25,550
الحلقة القادمة

362
00:23:22,220 --> 00:23:23,670
.كوندو إيسامي يُحدّثكم

363
00:23:24,190 --> 00:23:28,820
،بقي ثلاثة قتلةٍ
أم كانوا اثنين؟

364
00:23:28,820 --> 00:23:31,720
،في الحقيقة
.ثمّة ما يُخبرني أنّهم كانوا أربعةً

365
00:23:33,200 --> 00:23:34,420
.لا داعي للخوض في التّفاصيل

366
00:23:35,300 --> 00:23:36,890
.لن أسمح بسُقوط مزيدٍ مِن الضّحايا

367
00:23:37,560 --> 00:23:40,160
لن يمضي وقتٌ طويل حتّى نُوقع
.بهم جميعًا، نحن أفراد المِيبورو

368
00:23:41,140 --> 00:23:44,320
،نيو
.إنّ ثقتي في سعيك لا تتزعزع

369
00:23:45,100 --> 00:23:46,690
."الحلقة القادمة: "باطنُ الكفّ

370
00:23:47,190 --> 00:23:48,500
.كُونوا على الموعد

371
00:23:47,190 --> 00:23:50,030
باطنُ الكفّ