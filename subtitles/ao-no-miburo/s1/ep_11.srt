1
00:00:02,640 --> 00:00:04,000
...هل يُعقل أن تكون

2
00:00:04,840 --> 00:00:06,850
الشّوغون توكوجاوا إيموتشي؟

3
00:00:06,850 --> 00:00:08,530
الشّوغون؟

4
00:00:10,690 --> 00:00:15,790
سنُرافق الشّوغون حتّى قلعة نيجو
.بمن معنا الآن مِن الرّجال لا غير

5
00:00:16,860 --> 00:00:18,660
.خطرت لي فكرةٌ

6
00:00:26,410 --> 00:00:27,470
.ماذا؟ لقد افترقوا

7
00:00:28,060 --> 00:00:29,380
أيّ طريقٍ سلكه إيموتشي؟

8
00:00:29,380 --> 00:00:31,780
!لا تدعوا أحدًا يفرّ، طاردوهم

9
00:00:38,340 --> 00:00:39,440
.ها قد انطلقوا

10
00:00:39,440 --> 00:00:41,960
،أرى ذلك
.إنّها لخدعةٌ بارعة

11
00:00:42,130 --> 00:00:44,240
!الشّوغون، الشّوعون

12
00:00:44,680 --> 00:00:46,820
.أعجبتني تلك الضّحكة المُصطنعة

13
00:00:47,580 --> 00:00:51,810
سنعدّ حتّى الثّلاثين، ثُم نسلك
.الأزقّة الخلفيّة نحو قصر نيجو

14
00:00:52,110 --> 00:00:52,830
.حسنًا

15
00:00:55,550 --> 00:00:59,900
إذن كلتا المجموعتين كانتا للتّمويه؟

16
00:01:00,150 --> 00:01:03,240
.الحظّ لم يكن لصالحكم

17
00:01:03,880 --> 00:01:04,760
!كيكوتشيو-سان

18
00:01:05,870 --> 00:01:06,570
.لنذهب

19
00:01:06,570 --> 00:01:08,170
.واحدٌ

20
00:01:08,460 --> 00:01:09,960
.اثنان

21
00:01:10,600 --> 00:01:12,550
.ثلاثةٌ

22
00:01:18,130 --> 00:01:20,470
.هيّا، اهربا

23
00:01:34,200 --> 00:01:39,910
ذئاب ميبو الزّرق

24
00:02:55,640 --> 00:02:56,780
!توقّفوا

25
00:03:11,160 --> 00:03:12,010
!اثبتوا مكانكم

26
00:03:12,410 --> 00:03:13,860
!اقطعوا عليهم الطّريق
!حاصروهم مِن الأمام

27
00:03:13,860 --> 00:03:14,880
!لا تدعوهم يَفلتون

28
00:03:21,770 --> 00:03:23,560
.رائعٌ، ها قد حاصرناهم

29
00:03:23,560 --> 00:03:24,760
!ودّع حياتك يا إيموتشي

30
00:03:26,230 --> 00:03:28,520
أَلم نكسب ما يكفي
مِن الوقت يا هيجيكاتا؟

31
00:03:28,820 --> 00:03:29,960
.كلا

32
00:03:30,460 --> 00:03:33,270
،لا أودّ ردّكم خائبين
.لكنّنا لن نُسلّم الشّوغون أبدًا

33
00:03:34,110 --> 00:03:37,660
النّصر

34
00:03:35,070 --> 00:03:36,540
.أنا الشّوغون

35
00:03:36,540 --> 00:03:37,650
.تبًا لكِ أيّتها العجوز

36
00:03:38,790 --> 00:03:41,050
.سحقًا، إنّه ليس برفقتهم

37
00:03:41,050 --> 00:03:42,290
!الحقوا بالمجموعة الثّانية

38
00:03:42,290 --> 00:03:43,060
.رُويدكما، لا تتعجّلا

39
00:03:46,640 --> 00:03:48,040
.سأتولّى أمركما بنفسي

40
00:03:48,630 --> 00:03:51,120
.فما كانت هذه المهزلة يومًا مِن شيمي

41
00:03:51,320 --> 00:03:52,400
.أيّها الصّعلوك

42
00:03:52,850 --> 00:03:56,880
،لك ما أردت
.سأُعلّمك كيف يستلّ الرّجال سيوفهم

43
00:03:57,500 --> 00:04:00,880
،أولًا
.يُوضع السّيف على يسارك

44
00:04:01,640 --> 00:04:04,180
،هيّا، استلّ سيفك
.فليس عندي وقتٌ أُضيّعه معك

45
00:04:15,350 --> 00:04:16,360
...أنت

46
00:04:16,360 --> 00:04:18,070
!ستدفع ثمن فعلتك غاليًا

47
00:04:25,760 --> 00:04:29,200
ذكّرني... مَن المُعلّم هنا؟
وما عساه أن يُعلّم؟

48
00:04:30,680 --> 00:04:33,940
،إذا استللتُ سيفي فقد انتهى الأمر
.هذا هو أُسلوب الإياي

49
00:04:35,540 --> 00:04:36,830
.يا لك مِن صبيٍ مُتعجرف

50
00:04:36,830 --> 00:04:38,360
!انسحبوا! انسحبوا

51
00:04:38,360 --> 00:04:40,570
ما بالكم؟
لُذتم بالفرار بهذه السّرعة؟

52
00:04:40,570 --> 00:04:42,970
!قاتلا بأنصاف سيفيكما
أما مِن مُجيبٍ؟

53
00:04:42,970 --> 00:04:44,320
.تمهّل يا هاجيمي

54
00:04:44,320 --> 00:04:45,960
ما خطبك يا هيجيكاتا؟

55
00:04:46,480 --> 00:04:48,060
هل كان ذاك الرّجل برفقتهم؟

56
00:04:50,430 --> 00:04:51,600
كلا، لماذا؟

57
00:04:51,800 --> 00:04:52,930
—إذن، وبينما نحن نتحدّث الآن

58
00:04:55,060 --> 00:04:56,600
ماذا تُريدين أيّتها العجوز؟

59
00:04:56,600 --> 00:04:58,240
تجمّدت الدّماء في عروقي
!مِن شدّة الذّعر

60
00:04:58,240 --> 00:05:01,020
!ابتعدي عنّي أيّتها العجوز الخرفة

61
00:05:04,820 --> 00:05:06,690
!تفادى الضّربة

62
00:05:08,620 --> 00:05:11,290
!أوكيتا، اقضٍ على هؤلاء الرّجال

63
00:05:11,760 --> 00:05:17,050
،وعدنا أن نكسب الوقت بأيّ ثمنٍ
.حتّى يتمكّن نيو ومَن معه مِن بُلوغ قصر نيجو

64
00:05:17,050 --> 00:05:18,410
.بالفعل

65
00:05:18,750 --> 00:05:20,410
!أدّينا ما علينا وأكثر

66
00:05:20,680 --> 00:05:22,230
.أنا الشّوغون

67
00:05:22,560 --> 00:05:24,630
متى ستكفّ عن هذا التّمثيل؟

68
00:05:26,260 --> 00:05:27,760
!إنّه مُجرّد مُخادعٍ

69
00:05:27,760 --> 00:05:29,090
!إنّه ليس إيموتشي

70
00:05:29,380 --> 00:05:30,480
.كشفوا الخدعة

71
00:05:30,710 --> 00:05:33,670
!هيّا... أجهز عليهما فورًا

72
00:05:34,010 --> 00:05:36,440
،أنا سيّدكم الشّوغون
.وليس مِن شِيمي الاشتباك بالمعارك

73
00:05:36,440 --> 00:05:38,720
كفاك تمثيلًا، فأنت صلبٌ
!بما يكفي لتُدافع عن نفسك

74
00:05:40,300 --> 00:05:41,880
.لا خِيار أمامي

75
00:05:42,540 --> 00:05:43,730
.سأجعل ألسنتهم تنطق

76
00:05:44,860 --> 00:05:46,740
.هيّا، ضع فانوسك جانبّا

77
00:05:46,910 --> 00:05:49,990
أَتحسب نفسك بطلًا لا يُقهر؟
!أنت هالكٌ لا محالة

78
00:06:03,310 --> 00:06:06,060
،قطعت وَترَك
.فلا مفرّ لك الآن

79
00:06:06,680 --> 00:06:10,200
كان هُناك رجلٌ أعرفه في إيدو
.يستهدف أسفل السّاق دومًا

80
00:06:11,280 --> 00:06:13,360
وقد أَضفيت لمستي الخاصّة
.على أُسلوبه

81
00:06:13,860 --> 00:06:18,170
أخبرني يامانامي-سان أنّهم كانوا
.يُعاقبون المُجرمين بهذه الطّريقة قديمًا

82
00:06:18,730 --> 00:06:21,990
".لذا أَسميتها أشيغيري: "باترةُ الأطراف

83
00:06:22,890 --> 00:06:23,990
.إنّه شيطانٌ

84
00:06:25,510 --> 00:06:28,490
،يا للأسف
.فرّ رفاقك وتركوك وحيدًا

85
00:06:28,720 --> 00:06:30,130
.يا لخسّة فعلتهم

86
00:06:30,130 --> 00:06:31,420
.سُحقًا لكُلّ شيءٍ

87
00:06:31,420 --> 00:06:36,480
حسنًا، ستعترف لي بكُلّ
.خفاياكم وما يتعلّق بجماعتكم

88
00:06:39,950 --> 00:06:42,350
.قضم لسانه

89
00:06:42,770 --> 00:06:43,820
.حاولوا إيقاف النّزيف بأيّ طريقةٍ

90
00:06:44,010 --> 00:06:45,420
.لا جدوى، فات الأوان

91
00:06:45,750 --> 00:06:49,350
مـ-من هؤلاء القوم بحقّ السّماء؟

92
00:06:50,210 --> 00:06:52,010
.هذا الجُنون يتجاوز كُلّ منطقٍ

93
00:06:52,530 --> 00:06:55,530
،لا شكّ أنّهم فقدوا عُقولهم
.لا بُدّ أنّهم كذلك

94
00:06:57,390 --> 00:06:59,400
.شارفنا على بُلوغ قصر نيجو

95
00:07:00,010 --> 00:07:00,720
.بالفعل

96
00:07:03,400 --> 00:07:05,690
!كلا، كفى
!بلغ منّي التّعب مبلغه

97
00:07:05,690 --> 00:07:06,940
!أُريد محفّة حالًا

98
00:07:06,940 --> 00:07:08,830
ألم تُوافقني الرّأي للتّو
!بقولك "بالفعل"؟

99
00:07:10,200 --> 00:07:11,840
مـ-ما هذا؟

100
00:07:12,270 --> 00:07:12,970
ما الخطب؟

101
00:07:13,300 --> 00:07:14,540
.أسمع جلبةً

102
00:07:15,080 --> 00:07:15,820
ماذا؟

103
00:07:16,340 --> 00:07:17,380
أين صاحب السّمو؟

104
00:07:18,010 --> 00:07:19,200
!ابحثوا في كُلّ شبرٍ

105
00:07:19,200 --> 00:07:19,920
!أجل، سيّدي

106
00:07:20,340 --> 00:07:21,780
.إنّهم جُنود القصر

107
00:07:21,780 --> 00:07:24,150
!يا للرّاحة
.نجونا، جاءوا لإنقاذك

108
00:07:24,680 --> 00:07:27,280
!نحن هنا

109
00:07:29,320 --> 00:07:30,710
هل هذا أنت يا سيّدي؟

110
00:07:30,960 --> 00:07:32,600
هل نال الأذى منك يا صاحب السّمو؟

111
00:07:33,450 --> 00:07:34,840
.لم يمسّني مكروهٌ

112
00:07:35,120 --> 00:07:36,620
!إنّه بخير تمامًا

113
00:07:55,070 --> 00:07:56,120
.لا أُصدّق عينيّ

114
00:07:59,200 --> 00:08:01,420
،ما أتيتُ إلّا لأطيح برأسك
.يا إيموتشي

115
00:08:03,290 --> 00:08:05,280
.انج بنفسك يا كيكوتشيو-سان

116
00:08:08,620 --> 00:08:09,710
،لست أفهم

117
00:08:11,150 --> 00:08:13,580
ما اسمك؟

118
00:08:16,040 --> 00:08:17,330
.ناووزومي

119
00:08:18,010 --> 00:08:21,530
ناووزومي، ما الّذي يحملك
على هذه الأفعال؟

120
00:08:22,100 --> 00:08:23,480
هل مُرادك طرد الأجانب؟

121
00:08:24,950 --> 00:08:29,100
قتلي لن يُغيّر مِن واقع
.البلاد العصيب شيئًا

122
00:08:31,840 --> 00:08:32,860
طرد الأجانب؟

123
00:08:33,080 --> 00:08:35,860
،يقول: طرد الأجانب
!وكأنّي مهتمٌ بهذا الهراء

124
00:08:37,550 --> 00:08:38,680
ألست مُحقًا؟

125
00:08:40,470 --> 00:08:43,000
.إنّ أمرهم لا يعنيني أبدًا

126
00:08:43,660 --> 00:08:45,880
ألا يرغب في طرد الأجانب؟

127
00:08:46,920 --> 00:08:48,360
،لا أستوعب ذلك

128
00:08:48,960 --> 00:08:52,120
أخبرني، ما الّذي تبتغيه إذن؟

129
00:08:58,090 --> 00:09:00,260
.لأستعيد أمجاد السّاموراي

130
00:09:01,230 --> 00:09:02,310
تستعيدها؟

131
00:09:04,000 --> 00:09:06,930
.سلبتموها منّا عنوةً

132
00:09:08,270 --> 00:09:09,780
.أنتم عائلة توكوغاوا

133
00:09:12,580 --> 00:09:14,330
عمّا تهذي؟

134
00:09:14,330 --> 00:09:17,370
أَتزعم أنّ عائلة توكوغاوا
انتزعوا حقّكم؟

135
00:09:17,370 --> 00:09:18,550
.هذا صحيحٌ

136
00:09:19,210 --> 00:09:21,400
وما الّذي انتزعناه منكم إذن؟

137
00:09:22,120 --> 00:09:23,950
،ميادين القتال

138
00:09:27,480 --> 00:09:32,240
إنّ إيياسو، مُؤسّس شُوغونيّتكم
،قد كبح جماح عصر الدّول المُتحاربة

139
00:09:32,550 --> 00:09:35,760
وبذلك حرمنا نحن معشر السّاموراي
.مِن مكانٍ نُقاتل فيه

140
00:09:36,880 --> 00:09:39,170
أَتقصد أنّ السّلام يضيق بك ذرعًا؟

141
00:09:51,710 --> 00:09:52,720
.الزم مكانك

142
00:09:56,870 --> 00:09:58,350
.أجل، إنّه ليضيق بي ذرعًا

143
00:10:00,630 --> 00:10:04,460
ولمَ سفك الدّماء إن كان
ثمّة سبيلٌ لتجنّبه؟

144
00:10:09,550 --> 00:10:11,900
ما حاجتكم للسّاموراي إذن؟

145
00:10:13,030 --> 00:10:14,790
،أنا قويٌّ للغاية

146
00:10:15,400 --> 00:10:17,360
،خُلقت قويًا

147
00:10:17,360 --> 00:10:19,900
.وزادني التّدريب شدّةً

148
00:10:19,900 --> 00:10:23,600
.جُبت البلاد لأشحذ مهاراتي

149
00:10:24,600 --> 00:10:30,610
فلمَ أضنينا أبداننا وأرواحنا
لنبلغ هذا المدى مِن القُوّة؟

150
00:10:30,880 --> 00:10:34,110
.لتكون ذُخرًا للرعيّة في الشّدائد

151
00:10:36,820 --> 00:10:38,490
وأين هي تلك الشّدائد؟

152
00:10:38,800 --> 00:10:40,840
إنّني أنحدر مِن نسلٍ مُمتدّ
.مِن السّاموراي

153
00:10:40,840 --> 00:10:43,760
،مات جدّي
...وجدّه من قبله

154
00:10:43,760 --> 00:10:48,630
بين ملاءاتٍ مُهترئة دون أن ينالوا
.فُرصةً لإثبات جوهر السّاموراي

155
00:10:49,520 --> 00:10:56,630
طيلة مائتين وستّين عامًا، بسطت عائلة
.توكوغاوا سُلطانها، وجعلتمونا بلا جدوى

156
00:10:58,500 --> 00:11:00,770
...أخبرني أيّها الفتى

157
00:11:00,770 --> 00:11:02,550
ما الغاية مِن السّيف؟

158
00:11:04,220 --> 00:11:06,510
.أنا... لا أعلم

159
00:11:09,600 --> 00:11:13,570
،أخبرني يا إيموتشي
ما السّيف في نظرك؟

160
00:11:15,390 --> 00:11:16,480
...السّيف

161
00:11:19,560 --> 00:11:21,210
.ليس سوى حليةٍ للزّينة

162
00:11:22,610 --> 00:11:24,070
.لن يَروقه هذا الرّد

163
00:11:25,800 --> 00:11:29,080
السّيف هو صِمام أمانٍ
.للطّوارئ القاسية

164
00:11:34,550 --> 00:11:36,360
.إنّ طريق السّيف مجبولٌ بالدّماء

165
00:11:36,730 --> 00:11:41,590
إرثٌ لم ينقطع مُنذ
.حُروب جينجي وهيكي

166
00:11:42,180 --> 00:11:44,210
لمَ لا تسعى للقتال؟

167
00:11:44,750 --> 00:11:47,740
لمَ لا تستعرض قُوّتك؟

168
00:11:50,260 --> 00:11:52,970
.إنّ القتال رديفٌ للموت

169
00:11:54,900 --> 00:11:57,480
أنصحك بألّا تثق بمن يحضّ
،على الحرب

170
00:11:57,480 --> 00:12:01,150
.مهما نمّقوا دعوتهم بالكلمات الجميلة

171
00:12:04,420 --> 00:12:08,920
هل هذا هو سيّد السّاموراي قاطبةً؟
!يا لها مِن مهزلةٍ

172
00:12:08,920 --> 00:12:12,530
،إذا نخرَ الفساد كبار القوم
.نالَ الهلاك صغارهم

173
00:12:13,000 --> 00:12:15,640
،ثمّة حربٌ طحون قادمة

174
00:12:15,980 --> 00:12:18,840
،ونحن، جماعة الريسّيدان الدمويّة
.مَن سيُشعل فتيلها

175
00:12:19,920 --> 00:12:21,980
جماعة الريسّيدان الدمويّة؟

176
00:12:22,480 --> 00:12:26,200
،يا إيموتشي
.رأسك هو كُلّ ما نحتاج

177
00:12:26,200 --> 00:12:30,560
سيكون القُربان الأمثل
.لتصدّر مَحفلنا القادم

178
00:12:30,830 --> 00:12:34,660
،موتك سيزجّ بالمدينة في غياهب الفوضى
.ويقذفُ بالبلاد إلى جحيم الاقتتال

179
00:12:34,660 --> 00:12:36,720
سيعود عصر الدّول المُتحاربة
.ليبسط ظلّه

180
00:12:37,720 --> 00:12:40,570
وآنذاك سنجدُ المُستقرّ الّذي
.نطمح إليه

181
00:12:41,350 --> 00:12:44,360
،تبًا، لا مجال للمُراوغة
.إنّه يعي جيدًا كُلّ حرفٍ ينطق به

182
00:12:45,010 --> 00:12:46,360
.اسمع يا ناووزومي

183
00:12:48,970 --> 00:12:50,830
،رُغم كُلّ ذلك
.لن أَدعك تُضرم نار الحرب

184
00:12:51,470 --> 00:12:55,080
هذا هو قراري النّهائي
.بصفتي سيّد عشائر السّاموراي

185
00:12:56,900 --> 00:12:58,090
،لن أموت

186
00:12:58,590 --> 00:13:00,320
فليس لي أن أرحل
.في مِثل هذا الوقت

187
00:13:01,200 --> 00:13:02,220
.كلا

188
00:13:03,300 --> 00:13:04,760
،إنّك لهالكٌ

189
00:13:06,740 --> 00:13:09,420
.هنا وفي هذه اللّحظة

190
00:13:12,700 --> 00:13:13,520
نيو؟

191
00:13:17,330 --> 00:13:18,930
.علينا الفرار يا كيكوتشيو-سان

192
00:13:18,930 --> 00:13:20,050
!أرجوك، اركض

193
00:13:24,770 --> 00:13:26,600
.يا للضّعف

194
00:13:27,600 --> 00:13:29,310
.كفى عبثًا

195
00:13:31,360 --> 00:13:32,530
ما خُطّتك الآن؟

196
00:13:32,530 --> 00:13:34,080
.لديّ فكرةٌ

197
00:13:55,760 --> 00:13:58,270
أَلقيت سيفك صاغرًا لتستسلم إذن؟

198
00:14:12,170 --> 00:14:13,080
...ناووزومي-سان

199
00:14:16,070 --> 00:14:17,220
.إنّك هشٌّ للغاية

200
00:14:19,400 --> 00:14:21,040
أين إيموتشي؟

201
00:14:21,650 --> 00:14:22,670
...لن

202
00:14:23,930 --> 00:14:24,880
!لن أُسلّمه إليك

203
00:14:32,560 --> 00:14:36,760
ألم يكن الرّجل ذو الثّياب البيضاء
مع المجموعة الّتي طاردتكم أيضًا؟

204
00:14:36,760 --> 00:14:38,280
.محالٌ

205
00:14:38,890 --> 00:14:42,250
تنفّست الصّعداء لأنّنا لم
.نضطرّ لمواجهة ذلك الكابوس

206
00:14:42,250 --> 00:14:44,580
لكنّني، لا أهابُ أحدًا
.كما أهابُ أوكيتا

207
00:14:47,230 --> 00:14:51,570
،إن كان الأمر كذلك
.فالقلق ينهشني حيال نيو-كون والشّوغون

208
00:14:51,790 --> 00:14:53,010
ما العمل الآن؟

209
00:14:53,010 --> 00:14:54,720
هل نعود إلى دُكّان الدّانغو؟

210
00:14:54,720 --> 00:14:56,960
هـ-هل يُؤذن لي بالانصراف؟

211
00:14:57,290 --> 00:15:00,060
،تارو
!يجب أن تخجل من نفسك

212
00:15:00,060 --> 00:15:03,580
!لكنكِ قُلتِ إنّني أصلح للتّجارة

213
00:15:03,890 --> 00:15:08,590
حتّى باعة الدّكاكين يجب أن يثبتوا
.في مواقعهم عندما يلزم الأمر

214
00:15:13,460 --> 00:15:14,850
.سنمضي إلى قصر نيجو

215
00:15:16,780 --> 00:15:21,100
لعلّ الرّجل ذا الرّداء الأبيض قد لملم
.الرّجال الّذين هربوا، ليسبقونا إلى المكان

216
00:15:22,210 --> 00:15:24,430
.هذا احتمالٌ راجح

217
00:15:24,940 --> 00:15:29,240
فالشّوغون سيتوجّه إليه
.في نهاية المطاف لا محالة

218
00:15:29,640 --> 00:15:34,470
سنتفقّد كُلّ مكانٍ يُحتمل وجود
.كمينٍ فيه بالقرب مِن القصر

219
00:15:34,470 --> 00:15:35,530
!هكذا يكون العمل

220
00:15:35,740 --> 00:15:37,640
!سأمدّ لكم يد العون

221
00:15:38,510 --> 00:15:41,200
،تعال معنا يا تارو
واستجمع قُواك، هلّا فعلت؟

222
00:15:41,200 --> 00:15:42,440
أَتتحدّثين بجديّةٍ؟

223
00:15:43,080 --> 00:15:43,890
.أسرعوا

224
00:15:43,890 --> 00:15:44,530
.حسنًا

225
00:15:51,280 --> 00:15:55,550
،أنا قلقٌ بشأن نيو
.لكن ما باليد حيلةٌ

226
00:15:55,910 --> 00:15:57,800
ألا يُمكنني العودة للمنزل فحسب؟

227
00:15:58,150 --> 00:15:59,470
ما قولك يا هيجيكاتا؟

228
00:16:00,210 --> 00:16:02,280
ماذا؟

229
00:16:03,070 --> 00:16:05,360
!اختفى هيجيكاتا

230
00:16:05,840 --> 00:16:09,340
،أجل، مضى مسرعًا للأمام
.يجب أن نلحق به

231
00:16:10,520 --> 00:16:11,410
ماذا؟

232
00:16:11,410 --> 00:16:13,370
...تُرى مِن بين

233
00:16:16,260 --> 00:16:18,480
.هذا ليس مُنصفًا يا هيجيكاتا-سان

234
00:16:25,430 --> 00:16:27,370
إذن، هل سلك إيموتشي
هذا الطّريق؟

235
00:16:31,880 --> 00:16:37,130
،بالمُناسبة، إن لم يَخنّي سمعي
.فقد وصفتني بالهشّ قبل قليل

236
00:16:37,280 --> 00:16:38,160
.أجل فعلت

237
00:16:38,470 --> 00:16:41,590
.كيكوتشيو-سان أقوى منك

238
00:16:43,070 --> 00:16:46,270
أَتقول هذا لرجلٍ صنديد مثلي؟

239
00:16:47,290 --> 00:16:48,240
.اهدأ

240
00:16:48,610 --> 00:16:50,680
.لا تظهر أمامه بمظهر اليائس

241
00:16:51,810 --> 00:16:54,400
هل أفزعتك حتّى فقدت صوابك؟

242
00:16:54,680 --> 00:16:58,220
خبرتي في مُراقبة المِيبورو
...جعلتني أعرف تمامًا

243
00:16:59,250 --> 00:17:02,600
،كم هو قويٌّ بشكلٍ مُخيف
.وكم هو شديد الخُطورة

244
00:17:03,920 --> 00:17:05,680
...لم آتِ إلى هنا إلّا لهدفٍ واحد

245
00:17:06,520 --> 00:17:08,670
!أن أُقاتل بما لديّ مِن سلاحٍ

246
00:17:10,660 --> 00:17:12,490
.تدّعي أنّك تريد خوض حربٍ

247
00:17:13,870 --> 00:17:15,290
.وتزعم أنّ هذه هي شيمُ السّاموراي

248
00:17:15,290 --> 00:17:20,230
هذا صحيحٌ، فالسّاموراي يُقاتلون
.ويموتون في ساحة المعركة

249
00:17:20,510 --> 00:17:21,940
.لهذا السّبب أنت هشٌّ

250
00:17:22,930 --> 00:17:24,680
.لا أفهم ما ترمي إليه

251
00:17:25,120 --> 00:17:29,190
ألا ترى أنّ مَنطقك هذا أنانيّ؟
ماذا عن البُسطاء الّذين يُقحمون في حربك؟

252
00:17:30,250 --> 00:17:35,790
النّساء؟ العجائز؟ الجرحى والمرضى؟

253
00:17:36,890 --> 00:17:37,800
والأطفال؟

254
00:17:40,200 --> 00:17:43,530
كيكوتشيو-سان يضع نفسه
،مكان هؤلاء جميعًا

255
00:17:43,530 --> 00:17:46,800
ويتساءل عمّا يمكنه فِعله
.لتحسين الأوضاع

256
00:17:47,150 --> 00:17:49,430
.إنّه ينظر للأمور بشُموليّةٍ أكبر

257
00:17:50,240 --> 00:17:54,480
أمّا تمسّكك بمكانتك كساموراي
.فهو ما يجعلك أضعف منه

258
00:17:55,060 --> 00:17:56,550
!لن تهزمه أبدًا

259
00:17:58,110 --> 00:18:00,810
.كفى ثرثرةً الآن

260
00:18:01,660 --> 00:18:04,850
ثقلٌ مُوازن؟
.لا تقل لي إنّه يملك سلسلةً ومِنجلًا

261
00:18:05,600 --> 00:18:09,320
لا بُدّ أنّه يُراوغ، فلا يُمكن لطفلٍ أن
.يُحسن استخدام سلاحٍ بهذا التّعقيد

262
00:18:10,450 --> 00:18:12,850
.لكنّه تخلّى عن سيفه

263
00:18:12,850 --> 00:18:15,980
لذا مِن المنطقيّ افتراض
.أنّه يملك سلاحًا أفضل

264
00:18:18,160 --> 00:18:23,240
إنّه يتعمّد إخفاء جانبه الأيسر
.مُنذ أن لحقت به

265
00:18:24,810 --> 00:18:27,800
والظّلام حالكٌ جدًا لدرجةٍ
.تمنع رُؤية ما يحمله

266
00:18:29,430 --> 00:18:32,230
.لكن، لا شيء مِن هذا يهمّ

267
00:18:32,840 --> 00:18:35,020
.فسيفي سيصلُ إليه

268
00:18:36,500 --> 00:18:37,800
.ويُرديه قتيلًا

269
00:18:37,800 --> 00:18:38,470
!الآن

270
00:18:40,660 --> 00:18:41,560
حجرٌ؟

271
00:18:45,210 --> 00:18:48,160
حجرٌ؟ مُجرّد حجرٍ إذن؟

272
00:18:48,160 --> 00:18:50,480
،كنت تدّعي القُوّة لتكسب الوقت
أليس كذلك؟

273
00:18:50,480 --> 00:18:53,310
.أُحيّي جُرأتك

274
00:18:53,780 --> 00:18:59,180
وكما تعلم، ليس مِن السّهل أن أُلوّح
.بسيفي الطّويل في هذا الممرّ الضيّق

275
00:18:59,890 --> 00:19:02,330
.خطّطت لهذا بدقّةٍ حقًا

276
00:19:04,750 --> 00:19:09,450
.لكن لا حاجة بي لتلويحه

277
00:19:09,930 --> 00:19:11,820
ما رأيك بهذا؟

278
00:19:19,710 --> 00:19:21,150
!كنت أنتظر هذه اللّحظة

279
00:19:21,640 --> 00:19:22,740
!نِلت منك

280
00:19:23,660 --> 00:19:25,840
!والآن لن تَقدر على استخدام سيفك

281
00:19:28,120 --> 00:19:30,090
ما الّذي تُخطّط له؟

282
00:19:30,880 --> 00:19:32,720
!كيكوتشيو-سان أقوى منك

283
00:19:34,550 --> 00:19:36,110
ماذا قُلت؟

284
00:19:38,070 --> 00:19:39,360
.لم أشعر بتلك الضّربة حتّى

285
00:19:43,530 --> 00:19:45,110
.هذا... هذا لن يُجدي نفعًا

286
00:19:45,690 --> 00:19:47,390
.بل أراه يُجدي نفعًا

287
00:19:56,040 --> 00:20:01,250
ماذا تختار؟ الموت بقبضتي؟
أم تفلتني وتموت بسيفي؟

288
00:20:01,960 --> 00:20:05,260
،لن أفلتك أبدًا
.لن أفعل

289
00:20:09,910 --> 00:20:12,240
.سأسحقك وأُنهي أمرك

290
00:20:18,320 --> 00:20:20,740
.لن أفلتك أبدًا

291
00:20:21,980 --> 00:20:23,750
!لن أفلتك أبدًا

292
00:20:23,750 --> 00:20:25,360
!لن تَهزمني مهما حدث

293
00:20:26,640 --> 00:20:28,480
أما زِلت تُعاند وتقول ذلك؟

294
00:20:29,850 --> 00:20:30,870
...أنت قويٌّ

295
00:20:33,290 --> 00:20:34,770
.بالفعل

296
00:20:37,550 --> 00:20:41,280
لم يكن بإمكاني أن
.أهزمك أبدًا

297
00:20:42,760 --> 00:20:43,720
...لكن

298
00:20:45,050 --> 00:20:47,280
،لو أنّني أفلتك الآن

299
00:20:49,130 --> 00:20:51,720
...فلن أستطيع أن أُثبت

300
00:20:52,940 --> 00:20:54,270
،تلك هي الصّلابة الحقيقية

301
00:20:54,690 --> 00:20:58,360
يبدو أنّ القوّة لا تنحصر
.في حمل السّيف فقط

302
00:21:00,480 --> 00:21:01,930
.أنا متيقنٌ مِن ذلك

303
00:21:02,440 --> 00:21:06,140
،هاجيمي-كون
.أنا أُشاركك الشّعور ذاته

304
00:21:07,840 --> 00:21:13,330
لكن اعتقادي راسخٌ بأن ثمّة مساعٍ لا يتمّها
.إلّا شوغونٌ يوصف بالضّعف وقلّة الحيلة

305
00:21:17,290 --> 00:21:19,050
...ثمّة شيءٌ يُخبرني

306
00:21:19,960 --> 00:21:23,960
أنّ قُوّة كيكوتشيو-سان في جوهرها
.تُشبه قُوّة الجدّة تمامًا

307
00:21:25,100 --> 00:21:27,420
،رُغم كُلّ ذلك
.لن أَدعك تُضرم نار الحرب

308
00:21:27,880 --> 00:21:31,560
هذا هو قراري النّهائي
.بصفتي سيّد عشائر السّاموراي

309
00:21:32,480 --> 00:21:34,570
.يجب عليّ إثبات ذلك

310
00:21:37,320 --> 00:21:39,310
...إثبات أنّ القويّ حقًا

311
00:21:42,120 --> 00:21:43,920
!هو كيكوتشيو-سان

312
00:21:45,070 --> 00:21:50,080
القُوّة الحقيقيّة

313
00:23:20,160 --> 00:23:25,550
الحلقة القادمة

314
00:23:21,720 --> 00:23:23,270
.هيجيكاتا توشيزو يُحدّثكم

315
00:23:23,920 --> 00:23:26,710
نجحنا في دَحر القتلة
،الّذين كانوا يُلاحقوننا

316
00:23:27,200 --> 00:23:29,840
لكن ذلك الرّجل ذا الرّداء الأبيض
.لم يكن بينهم

317
00:23:31,020 --> 00:23:33,970
لست راضيًا عن ترك اللّورد إيموتشي
.تحت حماية نيو

318
00:23:34,750 --> 00:23:37,720
التوجّه صوب قصر نيجو
.هو خيارنا الأمثل الآن

319
00:23:38,480 --> 00:23:39,840
...ومع ذلك

320
00:23:40,780 --> 00:23:43,520
،أنا آسفٌ يا سوجي
.فقد حسمت أمري

321
00:23:44,670 --> 00:23:46,650
."الحلقة القادمة: "ثمانيةُ رُؤوسٍ

322
00:23:46,940 --> 00:23:48,920
،شاهدوا الحلقة
.هذا كُلّ ما في الأمر

323
00:23:47,190 --> 00:23:50,070
ثمانيةُ رُؤوسٍ