1
00:00:00,780 --> 00:00:03,870
ناووزومي، أعلم أنّ يوتارو
،أخوك الأصغر

2
00:00:03,870 --> 00:00:06,940
لكن لا داعي لتنصيبه
.زعيمًا لجماعة الريسّيدان

3
00:00:07,490 --> 00:00:11,860
،إنّه يعجز عن مصارحة نفسه أو زوجته
.وحتّى طُلّابه لا يُقيمون له وزنًا

4
00:00:14,870 --> 00:00:16,040
.كلا، نحن بحاجةٍ إليه

5
00:00:16,280 --> 00:00:18,930
.أنت لا تعرف يوتارو على حقيقته

6
00:00:19,360 --> 00:00:23,580
،فهو الرّجل الوحيد الجدير بقيادة الريسّيدان
،إنّه مثالٌ يُحتذى به في البراعة بالسّيف

7
00:00:24,390 --> 00:00:27,900
،بل هو إلهُ حربٍ حقيقيّ
.لن يقوى بشرٌ على هزيمته أبدًا

8
00:00:28,540 --> 00:00:30,550
مدرسة كيوهاتشي

9
00:00:29,320 --> 00:00:30,250
!نزالٌ مِن ثلاث جولاتٍ

10
00:00:31,190 --> 00:00:31,670
!لينحنِ كلاكما

11
00:00:33,700 --> 00:00:35,730
،كوندو إيسامي مِن ميبو رُوشيغومي

12
00:00:36,610 --> 00:00:39,200
،ضدّ كيوهاتشي يوتارو
.كبير مدرسة كيوهاتشي

13
00:00:41,610 --> 00:00:43,870
صحيحٌ أنّه لا يُحسن السّيطرة على
...زمام أُموره دومًا، ولكن مع ذلك

14
00:00:45,710 --> 00:00:48,070
،إن أردت تعلّم فُنون السّيف هنا

15
00:00:48,070 --> 00:00:49,390
.فتحدّث إليه

16
00:00:49,750 --> 00:00:50,940
،تبدأ الضّربة مِن هنا

17
00:00:51,320 --> 00:00:51,990
.وتنتهي هنا

18
00:00:53,430 --> 00:00:54,110
!انطلقا

19
00:00:59,380 --> 00:01:03,520
.أخيرًا سأشهد كيف يُقاتل كوندو-سان

20
00:01:16,760 --> 00:01:21,060
ذئاب ميبو الزّرق

21
00:02:37,010 --> 00:02:37,930
.بدأ النّزال

22
00:02:38,440 --> 00:02:39,430
.وضعيّة سيغان

23
00:02:39,430 --> 00:02:40,470
سيغان؟

24
00:02:40,900 --> 00:02:42,180
.إنها وضعيّةٌ أساسيّة

25
00:02:42,720 --> 00:02:44,940
حيث يترقّب كلٌّ منهما
.خُطوة الآخر الأولى

26
00:02:44,940 --> 00:02:46,470
.فهمت الآن

27
00:02:46,690 --> 00:02:49,370
ألا تظنّ أنّ النّزال سيكون
صعبّا على السّينسي الشابّ؟

28
00:02:49,370 --> 00:02:52,980
،يتملّكني القلق
.ذلك الرّجل يبدو قويًا

29
00:02:53,540 --> 00:02:57,560
حتّى تلاميذ يوتارو-سان
!لا يثقون به

30
00:03:01,270 --> 00:03:03,040
.غيّر وضعيّته

31
00:03:03,360 --> 00:03:05,020
،هاجيمي-كون
ما هذه الوضعيّة؟

32
00:03:05,020 --> 00:03:07,190
،كُفّ عن إزعاجي
.اصمت وشاهد

33
00:03:09,030 --> 00:03:10,380
هل كان ذلك كوندو-سان؟

34
00:03:14,820 --> 00:03:15,580
!إنّه يهجم

35
00:03:15,580 --> 00:03:16,300
.يا لسرعته

36
00:03:21,930 --> 00:03:24,620
.صدّ الهجمة، يا للرّاحة

37
00:03:35,240 --> 00:03:38,920
هيهات لمن يُحاول صدّ
.وابل ضربات يوتارو

38
00:03:39,810 --> 00:03:42,440
فمن يَراها للوهلة الأولى يجزم
.بأنّ الثّبات أمامها ضربٌ مِن الخيال

39
00:03:47,230 --> 00:03:48,080
!نال منه

40
00:03:49,960 --> 00:03:50,580
،كلا

41
00:03:51,850 --> 00:03:54,570
.العجوز يصدّ كُلّ ضربةٍ

42
00:03:55,290 --> 00:03:57,270
ماذا؟ ألم تَنفذ الضّربة؟

43
00:03:57,560 --> 00:03:58,460
.أمسك لسانك

44
00:04:00,440 --> 00:04:04,210
،كوندو-سان يملك الأفضليّة
.إنّه مذهلٌ

45
00:04:05,100 --> 00:04:06,680
يبدو أنّ كفّة القٌوّة
.تميل لصالح العجوز

46
00:04:16,820 --> 00:04:18,650
.نقطة لكيوهاتشي

47
00:04:18,820 --> 00:04:20,050
ماذا؟ كيف؟

48
00:04:20,550 --> 00:04:23,660
،أصاب ساعده
.ضربةٌ خفيفة ولكنّها حاسمة

49
00:04:23,940 --> 00:04:28,500
مهلًا، هل هذا هو السّينسي
.الشابّ حقًا؟ كأنّه شخصٌ آخر

50
00:04:28,810 --> 00:04:31,040
هل كان بهذه البراعة دائمًا؟

51
00:04:33,040 --> 00:04:34,840
لا بُدّ أنّه ممّن يُسمّون
.بالموهوبين فطريًا

52
00:04:35,720 --> 00:04:37,290
.هذا الرّجل فريدٌ مِن نوعه

53
00:04:37,720 --> 00:04:40,050
تقصد أنّه نابغةٌ مثل أوكيتا-سان؟

54
00:04:40,380 --> 00:04:42,850
،كلا
.بل هو أشدّ بأسًا وجديّة

55
00:04:42,850 --> 00:04:43,930
أيّ جديّةٍ تقصد؟

56
00:04:43,930 --> 00:04:45,280
!الجولة الثّانية، انطلقا

57
00:04:46,620 --> 00:04:49,560
،النّزال لمن يفوز بجولتين
.كُلّ شيءٍ مرهونٌ بهذه الجولة

58
00:04:52,830 --> 00:04:54,150
عاد النّزال ليكون مِن
.طرفٍ واحد ثانيةً

59
00:04:55,000 --> 00:04:56,500
ما خطبك يا كوندو-سان؟

60
00:04:56,820 --> 00:04:59,160
سينتهى أمرك إن
.لم تردّ الصّاع صاعين

61
00:05:07,360 --> 00:05:08,580
.حركة قدم كامي-آشي

62
00:05:12,150 --> 00:05:12,910
!تفاداها

63
00:05:13,130 --> 00:05:14,080
!ثغرتك مكشوفةٌ تمامًا

64
00:05:17,600 --> 00:05:19,920
!نـ-نقطةٌ، ضربةٌ على الجسد

65
00:05:22,720 --> 00:05:25,680
أجل! كوندو-سان حسم
.هذه الجولة لصالحه

66
00:05:26,010 --> 00:05:28,400
.دفعه بذراعه

67
00:05:28,400 --> 00:05:31,180
أيّ نوعٍ مِن القتال بالسّيوف هذا؟
هل هذا مسموحٌ به أصلًا؟

68
00:05:31,440 --> 00:05:34,940
،أيّها الحمقى
.لا قوانين في نزالٍ حتّى الموت

69
00:05:35,820 --> 00:05:38,720
ومع ذلك، فإنّ العجوز أكثر
.رشاقةً ممّا ظننت

70
00:05:40,560 --> 00:05:41,560
أَهو صديقٌ؟

71
00:05:42,240 --> 00:05:44,690
ما هي حقيقة هذا الرّجل... كوندو؟

72
00:05:45,280 --> 00:05:48,200
،سؤالٌ جيّد
...باختصار، إنّه يبتغي

73
00:05:49,620 --> 00:05:50,830
.النّهج

74
00:05:53,630 --> 00:05:55,480
.أشكرك لمنحي الجولة الثّانية

75
00:05:55,480 --> 00:05:56,480
...حسنًا

76
00:05:56,820 --> 00:05:57,940
مجاملةٌ؟

77
00:05:57,940 --> 00:05:59,080
.فهمت

78
00:05:59,080 --> 00:06:01,810
،هذا هو السّينسي الخاصّ بنا
.نبيلٌ دائمًا

79
00:06:01,810 --> 00:06:03,970
.لكنّني كنت أُقاتل بكُلّ جديّةٍ

80
00:06:05,460 --> 00:06:08,270
،على أيّ حالٍ
.هذا الزّائر ليس بالمُنافس السّهل

81
00:06:08,270 --> 00:06:09,610
.إنّه ممّن يُشار إليهم بالبنان

82
00:06:16,110 --> 00:06:17,840
!شوغورو هو الأفضل

83
00:06:17,840 --> 00:06:19,600
!لم يُهزم في نزالٍ قطّ

84
00:06:20,160 --> 00:06:22,360
أَسمعتم أنّه صرع خنزيرًا
بريًا هذه المرّة؟

85
00:06:22,360 --> 00:06:23,950
أَيعقل أنّه تينجو؟

86
00:06:23,950 --> 00:06:24,950
أم أنّه إلهُ حربٍ؟

87
00:06:24,950 --> 00:06:26,530
أم تراه أسطورةً حيّةً تمشي بيننا؟

88
00:06:28,080 --> 00:06:29,770
.هذا هو كوندو شوسوكي-سينسي

89
00:06:30,330 --> 00:06:32,680
.قطع كُلّ هذه المسافة ليلقاك فحسب

90
00:06:33,390 --> 00:06:34,120
.إنّه رجلٌ شديد البأس

91
00:06:34,550 --> 00:06:38,630
ما قولك في خوض
بعض الجولات معي؟

92
00:06:45,840 --> 00:06:48,670
هل ظننت أنّ بمقدورك
سحق عظامي الهَرمة؟

93
00:06:49,130 --> 00:06:56,140
شيكان

94
00:06:49,760 --> 00:06:52,580
،مُنذ هذه اللّحظة
.صار اسمك كوندو إيسامي

95
00:06:52,800 --> 00:06:55,630
.وشيكان هو الدّوجو الخاصّ بك

96
00:06:56,500 --> 00:06:58,150
.استقبل فيه كُلّ مَن يأتيك

97
00:06:58,480 --> 00:07:02,640
."هذا ملاذٌ لمن يبتغون إتقان "النّهج

98
00:07:03,180 --> 00:07:08,400
،اصقل مهارتك، وعزّز قوّة بدنك
.وطهّر رُوحك

99
00:07:09,220 --> 00:07:12,220
،ولا تنسَ أبدًا يا إيسامي

100
00:07:12,220 --> 00:07:14,210
.أنّك لا تزال ضعيفًا

101
00:07:14,790 --> 00:07:17,070
.ومِن هنا تنبع كُلّ البدايات

102
00:07:23,880 --> 00:07:25,680
أَهـ-هو يضحك؟

103
00:07:26,510 --> 00:07:28,180
!الجولة الثّالثة، انطلقا

104
00:07:28,400 --> 00:07:29,630
.العالم فسيحٌ

105
00:07:29,950 --> 00:07:32,040
.وثمّة أقوياء كثرٌ لم يبرزوا للعلن بعد

106
00:07:35,880 --> 00:07:37,530
وضعيّة دايجودان؟

107
00:07:37,530 --> 00:07:39,170
.يا لها مِن وضعيّةٍ جريئة

108
00:07:39,710 --> 00:07:40,780
ما هي وضعيّة دايجودان؟

109
00:07:41,080 --> 00:07:43,840
لا توجد وضعيّةٌ تمنحك سُرعةً في
،الهُجوم أو دقّةً في الإصابة مثلها

110
00:07:44,600 --> 00:07:46,680
.لكنّها تجعل جسدك مكشوفًا تمامًا

111
00:07:47,040 --> 00:07:49,320
إذن، هي وضعيّةٌ تعتمد
على الهجوم المَحض؟

112
00:07:52,050 --> 00:07:54,320
!اتّخذ السّينسي الشابّ وضعيّة غيدان

113
00:07:54,800 --> 00:07:56,190
.خيارٌ جريء آخر

114
00:07:57,350 --> 00:07:59,680
وما هي وضعيّة غيدان؟

115
00:08:01,610 --> 00:08:07,400
وضعيّة غيدان تبقى فيها الذّراعان مُنخفضتين، ممّا يُسهل
.التربّص وتَحيّن الفُرص، لكن الهجمات تكون بطيئةً

116
00:08:08,030 --> 00:08:10,500
،باختصارٍ
.إنّها وضعيّةٌ دفاعيّة بحتة

117
00:08:10,900 --> 00:08:14,250
،إذن، كوندو-سان سيتولّى الهُجوم
بينما يلجأ يوتارو-سان للدّفاع؟

118
00:08:14,710 --> 00:08:17,490
لا أحد تقريبًا يستخدم أيًا مِن
.الوضعيّتين في نزالٍ حقيقيّ

119
00:08:20,760 --> 00:08:21,420
ماذا سيحدث تاليًا؟

120
00:08:46,590 --> 00:08:49,840
أَنصبت لي فخًا بإغوائي لضرب
وجهك كي تنقضّ عليّ؟

121
00:08:51,640 --> 00:08:52,290
.عملٌ مُذهل

122
00:08:53,310 --> 00:08:56,170
.النّقطة لكيوهاتشي، انتهى النّزال

123
00:08:57,160 --> 00:08:57,870
!ظَفر بالفوز

124
00:08:58,120 --> 00:08:59,920
.يا لها مِن حركةٍ

125
00:08:59,940 --> 00:09:02,400
لم أرَ قطّ هُجومًا مُضادًا
.بهذه البراعة

126
00:09:06,580 --> 00:09:09,090
،كانت حركتهما خاطفةً
.لم أستطع مُواكبتها

127
00:09:09,530 --> 00:09:11,700
.ذاك الرّجل قويٌّ حقًا

128
00:09:12,200 --> 00:09:13,980
.هُزم كوندو-سان

129
00:09:17,540 --> 00:09:18,160
ماذا؟

130
00:09:19,030 --> 00:09:21,460
.تعلّمت منك الكثير اليوم

131
00:09:21,460 --> 00:09:23,610
كلا، ليس بقدر ما تعلّمته
.أنا منك

132
00:09:24,020 --> 00:09:27,550
،هذا العالم فسيحٌ للغاية
.وهو زاخرٌ بمُبارزين لم ألتقِ بهم بعد

133
00:09:28,240 --> 00:09:31,450
أنا ضعيفٌ، وهذا وحده ما يجعل
.للحياة قيمةً تستحقّ العيش

134
00:09:32,600 --> 00:09:34,390
.أرجوكم، علّموني جميعًا

135
00:09:34,770 --> 00:09:36,470
!محالٌ
.لا نقدر على ذلك

136
00:09:38,270 --> 00:09:41,240
لم أر قطّ رجلًا بهذه الصّلابة
.يتصرّف بكُلّ هذا التّواضع

137
00:09:41,240 --> 00:09:42,480
.كلا، بل أنا ضعيفٌ

138
00:09:42,740 --> 00:09:45,580
سينسي! لم أكن أعلم
.أنّك كنت تُخفي قُوّتك

139
00:09:45,580 --> 00:09:47,970
،في الحقيقة
.لم أفعل ذلك قطّ

140
00:09:48,540 --> 00:09:53,560
كنت قلقًا بشأن ما سيؤول إليه حال هذا
.الدّوجو عندما اختفى السّينسي العجوز فجأةً

141
00:09:53,960 --> 00:09:55,970
،وأنا كذلك
.لكنّه الآن في أيدٍ أمينة

142
00:10:07,260 --> 00:10:09,380
،أعتذر عن تأخّر ناغي

143
00:10:09,840 --> 00:10:11,750
.فلعلّها ذهبت للتسوّق

144
00:10:12,080 --> 00:10:14,990
،لا بأس أبدًا
.سنُعاود الزّيارة مرّةً أُخرى

145
00:10:20,760 --> 00:10:22,490
،حسنًا
.نستأذنك بالانصراف الآن

146
00:10:22,980 --> 00:10:24,230
.نشكرك على كُلّ شيءٍ

147
00:10:28,550 --> 00:10:33,030
،يا لها مِن ضرباتٍ جبّارة
.ما زالت يداي ترتجفان

148
00:10:36,740 --> 00:10:41,820
كوندو إيسامي، لرُبّما اختلفت النّتيجة
.تمامًا لو كان نزالنا بسُيوفٍ مِن الفُولاذ

149
00:10:42,920 --> 00:10:44,540
!نيو-كون

150
00:10:46,460 --> 00:10:47,290
!ناغي-سان

151
00:10:47,290 --> 00:10:49,460
،أنا آسفةٌ جدًا
.كنت في الخارج

152
00:10:49,460 --> 00:10:51,280
،أرجوكِ لا تركضي

153
00:10:51,490 --> 00:10:52,750
.سآتي أنا إليكِ

154
00:10:54,070 --> 00:10:55,830
.كُنّا نهمّ بالرّحيل لتوّنا

155
00:10:56,150 --> 00:10:58,800
.حسنًا، عُدت لتوّي أيضًا

156
00:10:59,560 --> 00:11:01,300
أنا سعيدٌ للغاية لأنّني
.تمكّنت مِن رُؤيتكِ

157
00:11:02,420 --> 00:11:04,050
.أجل، وأنا كذلك

158
00:11:05,310 --> 00:11:08,480
إذن، أنت تنتمي
لـ المِيبورو يا نيو-كون؟

159
00:11:08,830 --> 00:11:10,330
.أجل، نحن كذلك

160
00:11:10,740 --> 00:11:14,210
.مُهمّتنا الحفاظ على أمن كيوتو

161
00:11:15,620 --> 00:11:18,940
،نحن، جماعة الريسّيدان الدمويّة
.لدينا هدفٌ مُحدّد: المِيبورو

162
00:11:24,410 --> 00:11:25,950
.يا له مِن عملٍ نبيل ومُشرّف

163
00:11:26,330 --> 00:11:26,960
،معذرةً

164
00:11:28,270 --> 00:11:29,240
هل أنتِ بخير؟

165
00:11:29,560 --> 00:11:30,280
ماذا؟

166
00:11:30,280 --> 00:11:33,720
تساءلت فحسب لأنّكِ تبدين
.شاحبة الوجه قليلًا

167
00:11:35,480 --> 00:11:36,990
.كلا، أنا بخير

168
00:11:37,420 --> 00:11:38,990
.ليس هُناك ما يستدعي القلق

169
00:11:38,990 --> 00:11:41,150
ماذا؟ حقًا؟

170
00:11:41,360 --> 00:11:42,350
.أجل

171
00:11:43,600 --> 00:11:46,410
.معذرةً، أخطأت التّقدير إذن

172
00:11:46,770 --> 00:11:47,530
.لا بأس أبدًا

173
00:11:48,150 --> 00:11:51,230
...هل تُمانعين
أن آتي لزيارتكِ مرّةً أُخرى؟

174
00:11:53,480 --> 00:11:55,750
حسنًا، انتبه لنفسك
.في طريق عودتك

175
00:11:56,510 --> 00:11:58,260
،صحيحٌ

176
00:12:05,060 --> 00:12:06,040
!ناغي-سان

177
00:12:09,320 --> 00:12:10,970
ما الخطب؟
هل نسيت شيئًا؟

178
00:12:11,200 --> 00:12:12,240
،كلا

179
00:12:12,800 --> 00:12:15,990
،في الحقيقة
.جدّتي امرأةٌ مُذهلة

180
00:12:17,840 --> 00:12:21,480
،فهي تصنع الدّانغو ببراعةٍ
،وماهرةٌ في التّجارة

181
00:12:21,480 --> 00:12:24,250
،وتخيط ثياب الكيمونو بنفسها
،وطباخةٌ مُتمكّنة

182
00:12:24,680 --> 00:12:27,700
،كما أنّها قابلةٌ خبيرة أيضًا
.إن كنتِ تُصدّقين ذلك

183
00:12:30,310 --> 00:12:34,010
،لذا، إذا احتجتِ مُساعدةً في أيّ شيءٍ كان
.فلا تتردّدي في الطّلب

184
00:12:37,420 --> 00:12:37,950
.وداعًا

185
00:12:40,460 --> 00:12:42,270
نيو، ما الّذي أخّرك
كُلّ هذا الوقت؟

186
00:12:42,270 --> 00:12:43,910
.معذرةً

187
00:13:09,390 --> 00:13:11,340
!قفز ساموراي لتوّه

188
00:13:11,340 --> 00:13:12,700
في النّهر شديد البُرودة؟

189
00:13:12,700 --> 00:13:13,900
أَهو مجنونٌ؟

190
00:13:19,310 --> 00:13:20,020
.تفضّلي

191
00:13:21,570 --> 00:13:22,780
...مـ-معذرةً

192
00:13:22,780 --> 00:13:28,160
الماء أكثر دفئًا مِن الهواء
.حينما يكون الجوّ قارسًا هكذا

193
00:13:30,230 --> 00:13:31,520
.أنا آسفةٌ يا نيو-كون

194
00:13:32,760 --> 00:13:36,640
كُلّ ما بمقدوري فعله الآن هو
.الحفاظ على أمن هذه الدّار

195
00:13:38,540 --> 00:13:41,640
.أنا أُؤمن بيوتارو-سان

196
00:13:49,820 --> 00:13:51,880
.لا أُصدّق هذا

197
00:13:52,940 --> 00:13:57,400
باتت السلّطات على درايةٍ بالعراك
.الّذي وقع في قصر نيجو

198
00:13:58,020 --> 00:14:01,310
وهم يعلمون أنّ تلاميذ
.كيوهاتشي كانوا وراء ذلك

199
00:14:01,920 --> 00:14:05,950
،بصفتك رئيسّا للدّوجو
ألا تشعر بالمسؤوليّة؟

200
00:14:11,850 --> 00:14:13,270
إذن، ها قد اجتمعنا
.هنا في نهاية المطاف

201
00:14:14,240 --> 00:14:15,190
.الصّياد

202
00:14:16,180 --> 00:14:17,320
.المُحرّض

203
00:14:18,200 --> 00:14:19,050
.الزّنبق

204
00:14:20,150 --> 00:14:21,190
.صانع الألعاب الناريّة

205
00:14:22,280 --> 00:14:23,000
.الشيطان

206
00:14:24,160 --> 00:14:25,160
.الهادئ

207
00:14:26,280 --> 00:14:27,230
.الأحمق

208
00:14:28,720 --> 00:14:30,260
.والسّاموراي

209
00:14:31,340 --> 00:14:33,360
.سنضرب ضربتنا بعد ثلاثة أيّامٍ

210
00:14:33,360 --> 00:14:36,980
،في ليلة مولد القمر الجديد
،نحن جماعة الريسّيدان الدمويّة

211
00:14:37,200 --> 00:14:39,260
!سنستعيد عصر السّاموراي

212
00:14:48,560 --> 00:14:51,660
ما هي الكلمة المُناسبة
لتكون شعارًا للمِيبورو؟

213
00:14:52,690 --> 00:14:55,950
أنت الوحيد الّذي ما زال يشغل
.باله بهذا الأمر بكُلّ جديّةٍ

214
00:14:56,390 --> 00:14:59,660
هذا ليس صحيحًا، فأنا موقنٌ أنّنا
.جميعًا نبذل جهدنا في التّفكير

215
00:15:00,260 --> 00:15:03,460
.لكن الاستقرار على خيارٍ صعبٌ حقًا

216
00:15:03,460 --> 00:15:09,470
جديد

217
00:15:03,950 --> 00:15:05,450
.رُبّما تكون كلمة "جديد" لطيفةً

218
00:15:06,240 --> 00:15:09,460
،إنّه مولد قمرٍ جديد هذه اللّيلة
.لا بُدّ أنّ النّجوم ستكون فتّانةً

219
00:15:10,250 --> 00:15:11,460
.وكأنّني أهتمّ

220
00:15:11,760 --> 00:15:15,330
على أيّ حالٍ، مرّت ثلاثة أيّامٍ
.مُنذ زيارتنا لدُوجو يوتارو-سان

221
00:15:15,950 --> 00:15:17,560
تُرى، كيف هو حال
ناغي-سان الآن؟

222
00:15:18,170 --> 00:15:19,520
.أرجو ألّا تكون في مأزقٍ

223
00:15:19,810 --> 00:15:20,610
.نيو

224
00:15:23,350 --> 00:15:26,810
لعلّك ترغب في التوقّف
.عن مُؤازرة تلك المرأة

225
00:15:28,330 --> 00:15:29,080
لماذا؟

226
00:15:29,750 --> 00:15:30,780
.لأسبابٍ كثيرة

227
00:15:31,010 --> 00:15:32,660
!مثل ماذا؟ أخبرني

228
00:15:32,660 --> 00:15:34,120
!قُلت لك لأسبابٍ كثيرة

229
00:15:34,600 --> 00:15:36,810
.امرأةٌ، جاءت امرأةٌ للزّيارة

230
00:15:38,510 --> 00:15:39,800
مَن تكون؟

231
00:15:40,150 --> 00:15:41,300
هل هي ناغي-سان؟

232
00:15:41,650 --> 00:15:44,110
،لا عِلم لي
.كُلّ ما سمعته أنّها امرأةٌ

233
00:15:44,880 --> 00:15:48,420
ماذا تقول؟
!هيجيكاتا أحضر امرأةً إلى الدّار؟

234
00:15:48,420 --> 00:15:51,710
،تبًا
متى أصبح لَبقًا هكذا معهنّ؟

235
00:15:51,710 --> 00:15:54,030
،هـ-هذا تصرّفٌ منافٍ للحشمة
.لن أقبل بهذا

236
00:15:54,030 --> 00:15:57,020
هل هي مايكو؟ أم غيشا؟
أم ابنة تاجرٍ؟

237
00:16:00,680 --> 00:16:04,520
،يا للرّوعة
.إنّها خبيرةٌ بحقٍ

238
00:16:05,100 --> 00:16:06,310
!صانعةُ سيوفٍ

239
00:16:08,680 --> 00:16:10,400
...أجل، بخصوص ذلك

240
00:16:10,790 --> 00:16:13,280
،قد تكون امرأةً
.لكنّها تعرف أسرار مهنتها جيدًا

241
00:16:13,660 --> 00:16:17,120
،مَن تظن نفسك يا هيجيكاتا
!لتُحضر امرأةً إلى الدّار؟

242
00:16:17,120 --> 00:16:20,940
هـ-هذا صحيحٌ، نحن نقوم بأعمال
.الرّجال هنا، كُن محتشمًا بعض الشّيء

243
00:16:20,940 --> 00:16:24,750
يا لخيبة الأمل! حينما أسمع كلمة
!امرأةٍ، فإنّني أتوقّع جاذبيّةً أُنثويّة

244
00:16:27,160 --> 00:16:29,600
.يا لها مِن نظرةٍ حادّة كالنّصل

245
00:16:29,600 --> 00:16:33,960
بالفعل، هي ذات النّظرة السّاخطة الّتي
.تبدو جليّةً على وجه صديقة طُفولةٍ

246
00:16:34,120 --> 00:16:37,770
أنا أفهم شعورك، فكُلّ واحدٍ
.منّا مرّ بمثل هذه التّجربة

247
00:16:39,270 --> 00:16:43,070
،عُذرًا، بما أنّنا هنا
هل لكِ أن تُعايني سيفي أيضًا؟

248
00:16:43,070 --> 00:16:44,960
،حسنًا
.الاحتياط خيرٌ مِن النّدم

249
00:16:44,960 --> 00:16:48,670
أجل، أنا لا أحمل سيفًا في الوقت
.الرّاهن، لكنّني أرغب في النّصيحة

250
00:16:48,670 --> 00:16:50,400
ما بالكم تصطفّون هكذا؟

251
00:16:50,830 --> 00:16:54,170
،سأفحص سيف أيّ شخصٍ كان
.فالعمل يبقى عملًا

252
00:16:54,970 --> 00:16:58,200
،لا يُوجد الكثير مِن صانعات السّيوف
أليس كذلك؟

253
00:16:58,560 --> 00:16:59,790
.هذا مدهشٌ

254
00:16:59,790 --> 00:17:02,480
كلا، ليس هُناك
.ما هو مدهشٌ بشأني

255
00:17:02,740 --> 00:17:04,840
.أنا نيو، يُشرّفني لقاؤكِ

256
00:17:05,440 --> 00:17:08,200
.وأنا ساكورا. الشّرف لي

257
00:17:08,540 --> 00:17:10,280
!نيو، هذا ليس عدلًا

258
00:17:10,280 --> 00:17:12,040
!التزم بالصّف وانتظر دورك

259
00:17:13,940 --> 00:17:15,840
،حينما يتعلّق الأمر بالسّيوف
.فأنا الشّخص المُناسب

260
00:17:16,310 --> 00:17:17,850
!ساكورا-تشان

261
00:17:21,320 --> 00:17:25,760
!أنا مذهولٌ بحقٍ
.بعثتِ الحياة في هذا السّيف مِن جديد

262
00:17:27,360 --> 00:17:29,720
سيَسير عملي في الحقل
.الآن بسلاسةٍ أكبر

263
00:17:30,000 --> 00:17:31,070
مِسحاةٌ؟ وما حاجتك بها؟

264
00:17:32,720 --> 00:17:36,080
،أرى ذلك
.فالسّيف يعلق في غمده أحيانًا

265
00:17:36,520 --> 00:17:38,020
،أَلقي نظرةً على سلاحي

266
00:17:38,540 --> 00:17:41,400
ائتُمِنت على سيف الكوتيتسو
.هذا عندما غادرت إيدو

267
00:17:41,680 --> 00:17:42,330
كوتيتسو؟

268
00:17:46,990 --> 00:17:51,170
كلا، ليس هذا بسيف كوتيتسو
.أبدًا، إنّه محض تقليدٍ

269
00:17:55,260 --> 00:17:57,840
هل تُجيدين تقييم السّيوف أيضًا؟
.يا لها مِن مهاراتٍ فريدة

270
00:17:58,390 --> 00:18:00,390
،حينما يتعلّق الأمر بالسّيوف
.فأنا الشّخص المُناسب

271
00:18:00,390 --> 00:18:03,230
ما هذا؟
امرأةٌ تصنع السّيوف؟

272
00:18:03,530 --> 00:18:06,560
أَنسيتِ أداء واجب الاحترام
لـ سيريزاوا-سينسي؟

273
00:18:13,010 --> 00:18:15,600
!هـ-هذا السّيف
أيّ توقيعٍ يحمله؟

274
00:18:16,500 --> 00:18:21,370
،ناغاسوني أوكيساتو-نيودو كوتيتسو
.كان هديّةً مِن لُورد ميتو

275
00:18:22,610 --> 00:18:24,120
!سيف نابيشيما كوتيتسو

276
00:18:24,320 --> 00:18:25,200
!مذهلٌ حقًا

277
00:18:25,200 --> 00:18:28,880
أنا أُدعى ساكورا، أرجوك دعني
.أتولّى صيانة هذا السّيف

278
00:18:32,590 --> 00:18:33,880
!نلتِ إعجابي

279
00:18:34,800 --> 00:18:39,510
ساكورا، مُنذ اليوم، أنتِ الصّانعة
.الّتي لا نرتضي سواها للمِيبورو

280
00:18:39,510 --> 00:18:41,310
،أشكرك يا سيّدي

281
00:18:41,310 --> 00:18:43,380
.رُغم أنّني سأتقاضى أُجرتي كاملةً

282
00:18:45,240 --> 00:18:46,840
.يا لها مِن سيّدة أعمالٍ حاذقة

283
00:18:47,240 --> 00:18:49,640
لم تُضيّع وقتًا في كسب
.ودّ القائد الأعلى

284
00:18:50,030 --> 00:18:52,080
!حيّوا رفيقتنا الجديدة

285
00:18:52,080 --> 00:18:53,650
!أحسنتِ صُنعًا يا ساكورا-تشان

286
00:18:53,650 --> 00:18:55,030
!نحن سُعداء بانضمامكِ إلينا

287
00:18:58,240 --> 00:19:01,490
،انظر إليهم كيف انغمسوا في صخب الاحتفال
لماذا لا تنشغلون بأعمالكم بدلًا مِن هذا؟

288
00:19:13,210 --> 00:19:15,710
تحدٍّ

289
00:19:13,710 --> 00:19:15,710
.سلّم هذه لهم

290
00:19:27,930 --> 00:19:30,350
...حلّت كارثةٌ

291
00:19:30,560 --> 00:19:32,110
!أمرٌ طارئ للغاية

292
00:19:32,890 --> 00:19:33,680
ما الخطب؟

293
00:19:35,560 --> 00:19:39,980
،ذاك المدعو ناووزومي حضر لتوّه
.وطلب أن أُسلّمكم هذه الرّسالة

294
00:19:40,480 --> 00:19:41,470
ناووزومي-سان؟ أَموجودٌ هنا؟

295
00:19:41,950 --> 00:19:43,250
أَتقصد ذاك الرّجل الّذي التقيناه؟

296
00:19:43,250 --> 00:19:44,160
.ناولني إياها

297
00:19:47,480 --> 00:19:48,870
ما الدّاعي لكُلّ هذا الاضطراب؟

298
00:19:50,390 --> 00:19:52,620
ماذا كُتب فيها؟

299
00:19:52,970 --> 00:19:57,090
،مع حُلول ساعة الخنزير مِن ليلتنا هذه"
"،سنهدم جُسور نهر كامو السّبعة

300
00:19:57,090 --> 00:20:00,520
،ونُضرم النّيران في كيوتو"
".التّوقيع: جماعة الريسّيدان الدمويّة

301
00:20:02,390 --> 00:20:03,230
ماذا؟

302
00:20:03,850 --> 00:20:07,350
،تبًا لهم! إنّها تلك الدّوجو
.بادروا بالخُطوة الأولى

303
00:20:07,350 --> 00:20:11,150
الدّوجو؟ أَتقصد مقر ناغي-سان؟
ماذا تعني بقولك؟

304
00:20:11,720 --> 00:20:15,240
،تلك الدّوجو، مدرسة كيوهاتشي
.هي قاعدتهم الّتي ينطلقون منها

305
00:20:15,490 --> 00:20:16,200
ماذا؟

306
00:20:17,400 --> 00:20:19,350
في اليوم الَذي ذهبت
...فيه إلى هناك

307
00:20:23,890 --> 00:20:29,240
رصد هاجيمي بعض أتباعهم
.بين التّلاميذ وأخبرني بالأمر

308
00:20:29,940 --> 00:20:32,750
أمضينا نحن الاثنان الأيّام
،الثّلاثة الماضية في التحرّي

309
00:20:33,300 --> 00:20:36,460
واكتشفنا أنّ ناووزومي وعصابته
.كانوا يتردّدون على ذاك المكان

310
00:20:37,610 --> 00:20:39,680
لماذا لم تُخبرني بالأمر قبل هذا؟

311
00:20:41,200 --> 00:20:42,510
،لا تَلم هاجيمي

312
00:20:43,200 --> 00:20:46,380
.فقد كان يُفكّر في مصلحتك يا نيو

313
00:20:50,350 --> 00:20:50,940
!هيّا بنا

314
00:20:50,940 --> 00:20:52,320
!استلّوا سُيوفكم

315
00:20:52,320 --> 00:20:54,810
،لا تُشعلوا الفوانيس
.كي لا يُكشف أمرنا

316
00:20:55,340 --> 00:20:59,320
النّيران ستنتشر سريعًا مع
!هذه الرّياح، علينا الإسراع

317
00:20:59,320 --> 00:21:00,410
!حسنًا

318
00:21:01,160 --> 00:21:01,790
.نيو

319
00:21:04,690 --> 00:21:05,620
.هذا لك

320
00:21:06,160 --> 00:21:06,830
!أجل، يا سيّدي

321
00:21:08,010 --> 00:21:10,180
.ساكورا، ابقي هنا

322
00:21:10,180 --> 00:21:11,170
.بل سآتي معكم

323
00:21:11,170 --> 00:21:12,330
!هيجيكاتا

324
00:21:14,920 --> 00:21:15,490
خريطةٌ؟

325
00:21:15,720 --> 00:21:17,460
.ستتولّى أنت زِمام القيادة

326
00:21:20,430 --> 00:21:23,960
،سننشر الرّجال عند كُلّ جسرٍ
!لا تدعوا أحدًا يعبر

327
00:21:24,240 --> 00:21:27,460
،نيو! ستتولّى أنت حماية وسط المدينة
أَتقدر على هذه المُهمّة؟

328
00:21:27,840 --> 00:21:28,580
!أجل، يا سيّدي

329
00:21:31,360 --> 00:21:32,520
...والآن

330
00:21:34,880 --> 00:21:36,180
.فلنبدأ العمل

331
00:21:37,500 --> 00:21:39,180
!انطلقوا! أسرعوا

332
00:21:44,990 --> 00:21:49,990
إلى المعركة

333
00:23:20,120 --> 00:23:25,500
الحلقة القادمة

334
00:23:20,690 --> 00:23:22,920
.سيريزاوا كامو يُحدّثكم

335
00:23:23,090 --> 00:23:24,800
جماعة الريسّيدان الدمويّة؟

336
00:23:24,800 --> 00:23:29,830
لا يُقدم على إحراق كيوتو
.إلّا حفنةٌ مِن السّفلة

337
00:23:29,830 --> 00:23:32,890
.سأُريهم مقامهم الحقيقيّ

338
00:23:33,170 --> 00:23:36,960
،هيّا يا رجال
!انطلقوا! أسرعوا

339
00:23:36,960 --> 00:23:39,380
،أفسحوا الطّريق
