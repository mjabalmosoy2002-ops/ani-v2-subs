1
00:00:00,710 --> 00:00:05,000
أنا أُدعى الصّياد، وعملي هو قنص تلك
.الوحوش الّتي تُلقّب بالسّاموراي

2
00:00:05,500 --> 00:00:07,230
!والآن، استلّا سلاحكما

3
00:00:07,750 --> 00:00:13,000
هل تقبل برأسي أنا ناغاكورا
شينباتشي وتكتفي بذلك؟

4
00:00:13,230 --> 00:00:14,990
ما أنت إلّا رجلٌ
.عاثر الحظّ أيّها العجوز

5
00:00:15,170 --> 00:00:16,740
!أيّها الصّعلوك المغرور

6
00:00:18,580 --> 00:00:20,370
.أنا لست رقيق القلب مثل شينباتشي

7
00:00:21,330 --> 00:00:23,200
.ولا يشغلني دافعك أو قصّتك

8
00:00:23,360 --> 00:00:25,250
،حين يتعلّق الأمر بالقتل
.فأنا لا أعرف الهَوادة

9
00:00:27,980 --> 00:00:29,260
.كنت أمزح فقط

10
00:00:29,650 --> 00:00:34,300
،لستُ سيئًا في استخدام السّيف
.لكن هذا الرّمح ينساب في يدي بسلاسةٍ

11
00:00:34,680 --> 00:00:38,580
،نحن منبوذون مِن الجميع
.لكنّنا في كنف المِيبورو وجدنا الانتماء

12
00:00:39,530 --> 00:00:43,860
كان عليك أن تنضمّ إلينا
.بدلًا منهم أيّها العجوز

13
00:00:56,590 --> 00:00:59,040
كنت أعلم أنّ كِبر سنّك
.سيفضح عجزك

14
00:01:03,440 --> 00:01:04,660
.يا لك مِن حُثالةٍ لا نفع منها

15
00:01:09,080 --> 00:01:11,050
!اصمد أيّها العجوز

16
00:01:11,720 --> 00:01:15,240
.سُحقًا لك أيّها الشّيطان

17
00:01:19,360 --> 00:01:22,980
!سانوسوكي، تنحّ جانبًا

18
00:01:34,740 --> 00:01:39,040
ذئاب ميبو الزّرق

19
00:02:57,500 --> 00:02:58,440
!أبصرتها

20
00:02:58,900 --> 00:03:00,570
!تلك الدّار ذات البوابة

21
00:03:01,290 --> 00:03:01,870
.جيّدٌ

22
00:03:02,670 --> 00:03:03,950
.البوّابة مفتوحةٌ

23
00:03:04,470 --> 00:03:07,920
أَتريد منّي... أن أقطع المسافة عدوًا
إلى كوروتاني، أليس كذلك؟

24
00:03:08,260 --> 00:03:11,160
،أجل
.استنجد بـ آيزو ليُرسلوا تعزيزاتهم

25
00:03:11,340 --> 00:03:15,240
ومَن ذا الّذي سيُلقي
.بالًا لحديثي، أو يُصدّقني

26
00:03:15,410 --> 00:03:17,860
،أتوسّل إليك يا تارو-كون
.الأمر كُلّه مرهونٌ بك

27
00:03:17,860 --> 00:03:18,840
!اخرس

28
00:03:19,270 --> 00:03:21,540
،ليَحدث ما يَحدث
!سأبذل قُصارى جهدي

29
00:03:26,850 --> 00:03:29,260
،ناغي-سان
.أرجو أن تكوني بخير

30
00:03:29,860 --> 00:03:34,860
جسر كوجين

31
00:03:52,860 --> 00:03:54,960
.طرحتهم جميعًا بقفا نصلي

32
00:03:55,130 --> 00:03:56,470
.عملٌ رائع

33
00:03:56,470 --> 00:03:59,220
.إذن، دعني أتكفّل بزعيمهم

34
00:04:02,790 --> 00:04:03,320
،مهلًا

35
00:04:05,310 --> 00:04:06,710
.ثمّة أمرٌ غريب

36
00:04:07,020 --> 00:04:09,830
،هناك ثمانية قادة مُتمرّدين
.بينما لا يوجد سوى سبعة جُسور

37
00:04:09,830 --> 00:04:11,690
.لا بُدّ أنّ أحدهم يتوارى هنا

38
00:04:10,730 --> 00:04:17,280
جسر كوجين

39
00:04:11,690 --> 00:04:15,630
،لا تُلقِ ببصرك نحوي
لعلّه انتقل إلى وجهةٍ أُخرى؟

40
00:04:15,630 --> 00:04:17,070
ماذا؟

41
00:04:18,490 --> 00:04:22,490
جسر نيجو

42
00:04:23,140 --> 00:04:24,840
ألا زِلت صامدًا أيّها العجوز؟

43
00:04:27,050 --> 00:04:28,680
!أيّها العجوز

44
00:04:28,960 --> 00:04:29,970
.سانوسوكي

45
00:04:32,120 --> 00:04:33,960
.أخبرتك أن تتنحّى جانبًا

46
00:04:40,800 --> 00:04:41,490
ماذا؟

47
00:04:44,930 --> 00:04:45,990
نصلٌ قصير؟

48
00:04:46,450 --> 00:04:50,290
،كلا، هذا محالٌ
.كنت بعيدًا عن مداه

49
00:04:51,020 --> 00:04:53,190
،حتّى لو استلّ سيفًا طويلًا
.لم يكن ليُدركني

50
00:04:54,760 --> 00:04:56,360
،هذا لن يُجدي

51
00:04:58,930 --> 00:05:02,910
،أنت تُواجه ناغاكورا شينباتشي
.مِن جماعة ميبو روشيغومي

52
00:05:05,680 --> 00:05:06,820
.عجبًا

53
00:05:07,250 --> 00:05:09,830
أَتحسب أنّنا في ميدان مُبارزة
أم ماذا؟

54
00:05:21,580 --> 00:05:22,420
.إنّه سريعٌ

55
00:05:22,650 --> 00:05:25,400
.وضرباته قويّةٌ

56
00:05:26,760 --> 00:05:27,470
،هذا لا يُبشّر بخير

57
00:05:29,000 --> 00:05:30,710
.عليّ أن أُبقيه بعيدًا عنّي

58
00:05:32,480 --> 00:05:37,160
،لم يُراودني أدنى شكّ في مصيري
.أن أعيش ساموراي... أن أكون مُحاربًا

59
00:05:38,680 --> 00:05:43,730
وُلدت لـ ناغاكورا كانجي، الّذي خدم
،مقاطعة ماتسوماي في إيدو

60
00:05:44,140 --> 00:05:46,720
ونشأت هناك رغيد العيش
.خالي البال

61
00:05:47,610 --> 00:05:50,280
يا للرّوعة! أليس هذا
السيّد الصّغير ناغاكورا؟

62
00:05:50,840 --> 00:05:53,790
.يا له مِن وجهٍ وسيم يملكه

63
00:05:54,120 --> 00:05:56,340
.إنّه يخطف الأنظار بهيبته

64
00:05:56,600 --> 00:05:59,050
.سمعت أنّه مثالٌ في الاستقامة والأدب

65
00:05:59,240 --> 00:06:01,290
.إنّه نموذجٌ يُحتذى به للسّاموراي

66
00:06:01,770 --> 00:06:06,710
،لم أكن طالبًا نجيبًا بحق
.إلّا في فنّ السّيف

67
00:06:07,660 --> 00:06:12,760
بلغت مرتبة المُعلّم في دُوجو شيندو مونين
.وأنا في الثّامنة عشرة

68
00:06:13,760 --> 00:06:19,320
،ثم جُبت دُور التّدريب واحدةً تلو الأخرى
.لا أبغي سوى القوّة ولا شيء سواها

69
00:06:20,480 --> 00:06:25,830
،إلى أن التقيت بكوندو في شيكان
.حينها اتّخذت حياتي مسارًا مُختلفًا

70
00:06:28,700 --> 00:06:30,700
.يمكنك القول إنّني كنت سيافًا تقليديًا

71
00:06:32,740 --> 00:06:37,330
،خاليًا مّن الشكّ أو التردّد
...كنت

72
00:06:38,760 --> 00:06:41,190
.أقتفي أثر السّيف فحسب

73
00:06:50,840 --> 00:06:52,670
.خسّةٌ لا مثيل لها

74
00:06:53,860 --> 00:06:56,980
.خسّةٌ؟ لا أُدرك ما تعنيه

75
00:06:57,600 --> 00:07:00,890
ما الدّاعي لإزهاق رُوح ذاك العجوز؟

76
00:07:00,890 --> 00:07:05,230
ناهيك عن طعنه في ظهره غدرًا
.دُون تحذير

77
00:07:05,440 --> 00:07:08,870
،هو ضعيفٌ، لذا فمصيره الموت
.البقاء للأقوى

78
00:07:09,140 --> 00:07:11,240
.هذا هو عرُف السّاموراي

79
00:07:13,070 --> 00:07:13,960
.هكذا إذن

80
00:07:14,750 --> 00:07:18,660
بناء على ذلك، ستلقى مصرعك
.هنا، وهذا جزاءٌ عادل

81
00:07:19,820 --> 00:07:21,600
!كلا

82
00:07:22,520 --> 00:07:24,420
!أيّها العجوز
أما زالت فيك روحٌ باقية؟

83
00:07:24,560 --> 00:07:26,970
—تـ-تقنيّته

84
00:07:26,970 --> 00:07:28,540
!كُفّ عن الكلام ولا تبذل جهدًا

85
00:07:28,910 --> 00:07:34,440
،تقنيّته ضربة إياي
.تُشبه مِنجل الشّيطان

86
00:07:34,810 --> 00:07:37,540
.لا تدع له مجالًا ليستخدمها

87
00:07:42,880 --> 00:07:44,440
.أزفت ساعة موتك

88
00:07:45,440 --> 00:07:46,380
!شينباتشي

89
00:07:48,880 --> 00:07:51,200
غنمت هذا السّيف مِن
!أحد الأتباع، دُونك إياه

90
00:08:09,880 --> 00:08:14,160
،السّيف مرآةٌ تعكس جوهر صاحبه

91
00:08:14,800 --> 00:08:15,850
.خالي البال

92
00:08:17,340 --> 00:08:18,740
.ومَرنٌ

93
00:08:21,160 --> 00:08:26,180
.هادئٌ وطليق كطيرٍ يُحلّق في السّماء

94
00:08:27,860 --> 00:08:29,110
...وكأنّه

95
00:08:39,140 --> 00:08:40,250
.طائر سُنونو مُحلّق

96
00:08:50,780 --> 00:08:53,600
.فهمت، يا للأسف

97
00:08:54,830 --> 00:08:56,640
.نِلت منّي

98
00:09:02,580 --> 00:09:08,840
لم أكن أعلم بوُجود ساموراي
.كهؤلاء، مُحاربون حقيقيّون

99
00:09:15,040 --> 00:09:17,280
.فارق العجوز الحياة

100
00:09:23,280 --> 00:09:26,190
.قال إنّك كنت ساموراي لا يُشقّ له غبارٌ

101
00:09:29,640 --> 00:09:32,670
لنُقم له جنازةً في وقتٍ
.لاحق يا سانوسوكي

102
00:09:35,550 --> 00:09:39,560
جسر شيجو

103
00:09:40,030 --> 00:09:43,050
،أهلًا بكما
.هذا هو جسر القَدر

104
00:09:44,050 --> 00:09:44,850
معذرةً؟

105
00:09:47,090 --> 00:09:48,800
جسر القَدر؟

106
00:09:48,800 --> 00:09:52,070
،أجل
.الجسر الّذي سيَحسم مصيركم

107
00:09:52,560 --> 00:09:57,060
فهل تنضمّان إليّ؟ أم تقضيان
نحبكما نكرتين لا ذِكر لكما؟

108
00:09:57,450 --> 00:09:58,540
.لا تُهدر أنفاسك

109
00:10:00,370 --> 00:10:01,030
.انطلقا

110
00:10:01,030 --> 00:10:01,490
ماذا؟

111
00:10:02,600 --> 00:10:03,500
.انقضّا عليه

112
00:10:15,880 --> 00:10:17,590
كـ-كيف له أن يكون بهذه القوّة؟

113
00:10:26,540 --> 00:10:28,120
.هيجيكاتا توشيزو

114
00:10:28,760 --> 00:10:32,980
لم ألحظ قوّته لأنّني دائمًا
.برفقة سيريزاوا-سينسي

115
00:10:34,710 --> 00:10:36,400
.تنحّ عن طريقي أيّها الصّعلوك

116
00:10:36,890 --> 00:10:38,960
.إيّاك أن تمسّ سيفًا بعد اليوم

117
00:10:39,640 --> 00:10:42,650
،إ-إنّه بارعُ
.ومُتجرّد مِن الرّحمة

118
00:10:47,130 --> 00:10:48,410
.بديعٌ

119
00:10:50,070 --> 00:10:54,420
،لكن السّيف ليس مِعولًا
.فلا تُلوّح به بهذه الهمجيّة

120
00:10:54,690 --> 00:10:55,320
ماذا؟

121
00:10:56,010 --> 00:10:59,640
سوف تتسبّب في تأكّل النّصل
.أو ثنيه، وستُتلفه في لمح البصر

122
00:11:02,820 --> 00:11:04,900
.أَتعرف هذا؟ إنّه كانيناغا

123
00:11:05,510 --> 00:11:10,500
،بريقه، ونصاعته، وحدّة خطّ الهامون الغائر فيه
.لا تملك إلّا أن تقف مأخوذًا به

124
00:11:11,590 --> 00:11:14,950
إنّه تحفةٌ فنيّة صِيغت
.في أواخر حقبة كاماكورا

125
00:11:15,830 --> 00:11:17,430
ماذا عن سيفك؟

126
00:11:17,920 --> 00:11:21,120
،يبدو باهتًا لا مِيزة فيه
فما اسمه؟

127
00:11:23,670 --> 00:11:25,880
.صنعته امرأةٌ نكرة لم يسمع بها أحد

128
00:11:26,880 --> 00:11:28,040
...أمّا عن الاسم

129
00:11:28,280 --> 00:11:31,200
:فلعلّي سأُطلق عليه
."السّيف بلا اسمٍ"

130
00:11:34,550 --> 00:11:35,880
،لنُغيّر الموضوع

131
00:11:36,320 --> 00:11:38,700
هل لك أن تُطلعني عن
روابطك وصِلاتك؟

132
00:11:38,940 --> 00:11:40,790
عن ماذا؟

133
00:11:40,790 --> 00:11:41,890
.عمّن تعرفهم

134
00:11:42,250 --> 00:11:45,200
كم عدد النّخبة الّذين
تربطك بهم صِلات؟

135
00:11:45,840 --> 00:11:48,720
الرّوابط هي المعيار الحقيقيّ
.لقيمة المرء

136
00:11:49,220 --> 00:11:51,360
.لا بُدّ أنّك على درايةٍ بـ دايراكو غينتارو

137
00:11:52,060 --> 00:11:57,980
،تقاسمنا كأس الشّراب سويًا
.ويمكنك اعتبارنا إخوةً بالمِيثاق

138
00:11:58,490 --> 00:11:59,410
.لم أسمع به قطّ

139
00:12:00,240 --> 00:12:05,240
لم تسمع به؟! أما بلغ مسامعك قطّ
!ذِكر دايراكو غينتارو سليل تشوشو؟

140
00:12:05,660 --> 00:12:07,760
،إنّه مناضلٌ فذّ
.رجلٌ ذائع الصّيت

141
00:12:08,020 --> 00:12:12,470
،هو مَن مهّد لهذا العصر
.زمن التّصفيات تحت راية القِصاص الإلهيّ

142
00:12:13,240 --> 00:12:14,750
،هذه أنباءٌ لم تبلغني بعد
مَن يكون؟

143
00:12:16,200 --> 00:12:18,880
،حسنًا
.هذه أمورٌ واردة الحُدوث

144
00:12:19,260 --> 00:12:21,010
،لنَختبر صِلةً أخرى

145
00:12:21,840 --> 00:12:26,010
هل يتردّد ذِكر كاتسورا
كوغورو على مسامعك؟

146
00:12:26,010 --> 00:12:27,040
كاتسورا؟

147
00:12:27,200 --> 00:12:29,880
.خُضت معه سجالًا

148
00:12:30,490 --> 00:12:32,090
.أو خُذ كوساكا-دونو مثلًا

149
00:12:32,320 --> 00:12:34,660
.تشاركنا الاستحمام سويًا

150
00:12:35,970 --> 00:12:39,840
،وفي توسا
.صادفت تاكيتيشي زويزا في الطّريق

151
00:12:40,940 --> 00:12:44,790
،بل إنّني رأيت سايغو العظيم
.سليل ساتسوما، رَأي العين

152
00:12:47,040 --> 00:12:48,790
!لم أسمع بأيّ منهم

153
00:12:49,170 --> 00:12:50,480
!ماذا؟

154
00:12:50,770 --> 00:12:52,790
.أيّ جهلٍ هذا

155
00:12:52,790 --> 00:12:56,920
،القاصي والدّاني يعرف كاتسورا كوغورو
.حتّى في دُوجو رينبيكان في إيدو

156
00:12:56,920 --> 00:12:58,800
،أنا لا أعرفه
.ولا أرغب في ذلك

157
00:13:01,480 --> 00:13:02,290
،أشعر بحِكّة لا تُطاق

158
00:13:03,800 --> 00:13:06,560
.يا لها مِن حِكّة مُزعجة

159
00:13:06,840 --> 00:13:10,730
،كُلّما أطلت في حديثك
.زاد هذا الشّعور المَقيت بالحِكّة

160
00:13:12,960 --> 00:13:14,620
.نفد صبري، مُتِ الآن

161
00:13:17,070 --> 00:13:19,600
ألا تهتمّ بترك بصمتك في التّاريخ؟

162
00:13:19,890 --> 00:13:22,070
.نهجك هذا عصيٌّ على الإدراك

163
00:13:22,530 --> 00:13:24,100
.أغلق فمك فحسب

164
00:13:24,860 --> 00:13:29,490
،إذا نجحت ثورتنا
،بل إذا أحدثت صدىً فقط

165
00:13:29,750 --> 00:13:31,820
.فإنّ شهرة الريسّيدان ستبلغ الآفاق

166
00:13:32,500 --> 00:13:37,330
ولن ينتهي الأمر عند هذا الحدّ، فمتى ما اشتعلت
.شرارة مُناهضة الشّوغون، فلن تنطفئ أبدًا

167
00:13:37,610 --> 00:13:43,250
،سأُؤجّج الثّورة في توسا وساتسوما وتشوشو
.وسأقلب موازين التّاريخ

168
00:13:43,460 --> 00:13:45,610
—أجل، أنا! الرّجل الّذي يُدعى

169
00:13:47,680 --> 00:13:48,840
،عُذرًا

170
00:13:49,090 --> 00:13:51,090
.سئمت هُراءك

171
00:13:54,210 --> 00:13:57,280
ما خطبك؟
ألا تملك حتّى اسمًا؟

172
00:14:01,080 --> 00:14:03,450
،أنت مُجرّد ثرثارٍ لا أكثر
.والآن... مُت

173
00:14:12,860 --> 00:14:13,720
.ستدفع الثّمن غاليًا

174
00:14:14,640 --> 00:14:16,530
ظننتني ثرثارًا؟

175
00:14:17,090 --> 00:14:19,690
قيادة الأتباع تستوجب
.كفاءةً لا يُزعزعها شكّ

176
00:14:20,450 --> 00:14:25,580
،شيندو مونين-ريو، هوكوشين إيتو-ريو
...كيوشين ميتشي-ريو

177
00:14:26,010 --> 00:14:28,350
أحطت علمًا بكُلّ مدرسةٍ
.قد يمرّ ذكرها بخاطرك

178
00:14:31,600 --> 00:14:34,600
،كلا
.هذا الرّجل يملك مهارةً حقيقيّة

179
00:14:34,940 --> 00:14:39,120
،لماذا إذن؟ إذا كنت بهذه الكفاءة
فلماذا أنت مهووسٌ بالسّمعة؟

180
00:14:40,190 --> 00:14:42,100
ما الّذي يدفعك؟

181
00:14:43,160 --> 00:14:45,540
،لا شيء
.لا شيء على الإطلاق

182
00:14:46,440 --> 00:14:51,230
وحدهم الرّجال السطحيّون أمثالك
.يفترضون أنّ لكُلّ فِعلٍ دافعًا

183
00:14:52,880 --> 00:14:53,810
حقًا ما تقول؟

184
00:14:54,140 --> 00:14:55,880
،إليك هذا التّحذير

185
00:14:56,640 --> 00:15:01,440
وقفتك واتّجاه نظراتك
،يجعلان ضرباتك مكشوفة جدًا

186
00:15:01,440 --> 00:15:03,880
.حتّى لو انحرفت قليلًا نحو اليمين

187
00:15:08,990 --> 00:15:13,130
متى كان ذلك؟ كانت هناك تلك
.الفراشات النّادرة ذوات ذيل السّنونو

188
00:15:13,780 --> 00:15:19,140
كنت أعبر التّل والتّلين في إثرها، وكانت
.أختي تفسح لي المجال لصيدها دائمًا

189
00:15:19,810 --> 00:15:21,980
،ومِن هنا اكتسبت لقبًا غريبًا

190
00:15:27,320 --> 00:15:28,260
".أقدام الشّيطان"

191
00:15:29,030 --> 00:15:29,780
!يا لسرعته

192
00:15:30,330 --> 00:15:33,840
إن كنت تحسب أنّ فُنون السّيف محصورةٌ
.بين جُدران الدّوجو، أعد التّفكير مليًا

193
00:15:38,160 --> 00:15:39,430
!نال منه

194
00:15:41,400 --> 00:15:42,680
.هذا لن يُجدي نفعًا معي

195
00:15:43,730 --> 00:15:44,320
ماذا؟

196
00:15:47,880 --> 00:15:49,920
!دِرعٌ... دِرعٌ زرديّ؟

197
00:16:00,650 --> 00:16:01,730
!تبًا

198
00:16:01,730 --> 00:16:05,310
توشي، فُنونك في استخدام
.السّيف باتت مكشوفةً للغاية

199
00:16:07,010 --> 00:16:09,070
!استسلمت

200
00:16:12,440 --> 00:16:16,060
،لا نصيب لي مِن الموهبة
.بات هذا جليًا بمُجرّد مُراقبتي لك

201
00:16:17,540 --> 00:16:19,820
.ليس مِن السّهل تغيير طباعي

202
00:16:21,120 --> 00:16:25,880
سأعود لمهنة بيع الأدوية، وخوض بعض
،العِراكات العابرة بين الحين والآخر

203
00:16:25,880 --> 00:16:27,590
.فهذا هو الأنسب لي

204
00:16:28,340 --> 00:16:29,510
.أنت مخطئٌ يا توشي

205
00:16:30,910 --> 00:16:33,090
،أحكم القبضة على السّيف هكذا

206
00:16:33,590 --> 00:16:35,090
.واحتوه بين كفيك برفق

207
00:16:35,520 --> 00:16:36,850
،أنت كثير التّذمر في كُلّ شأنٍ

208
00:16:37,760 --> 00:16:40,360
وتظنّ أنّ هذا سيجلب لك
.المزيد مِن الاهتمام

209
00:16:40,770 --> 00:16:42,850
!أغلق فمك يا سوجي

210
00:16:43,030 --> 00:16:45,240
.هذا هو الحماس الّذي أبتغي رُؤيته

211
00:16:45,590 --> 00:16:46,600
،اخرس

212
00:16:46,800 --> 00:16:47,750
،انتصرتَ

213
00:16:48,300 --> 00:16:52,770
،ولكن، أرشدني إلى نُقطة البداية
ما الّذي عليّ فعله لأصبح أكثر قوّةً؟

214
00:16:52,770 --> 00:16:56,660
دائمًا ما تنشد العون؛ وتظنّ أنّ النّاس سيُفضون
.إليك بأسرارهم لمُجرّد أنّك سألت

215
00:16:59,420 --> 00:17:01,840
.توشي، أنت قويٌّ بالفعل

216
00:17:02,260 --> 00:17:04,720
،لم تُهزم قطّ في نزالٍ رجل لرجل
أليس كذلك؟

217
00:17:04,940 --> 00:17:06,500
.حسنًا، هذا صحيحٌ

218
00:17:07,140 --> 00:17:09,880
أنت لست هنا لتكون وريث
،مدرسة تينين ريشين

219
00:17:10,520 --> 00:17:13,760
.بل لتدرسها كأسلوبٍ إضافيّ للقتال

220
00:17:14,230 --> 00:17:18,370
،أنت تفعل الأشياء بطريقتك الخاصّة
ما العيب في مدرسة هيجيكاتا؟

221
00:17:20,890 --> 00:17:23,520
.إذن، مدرسةٌ بلا اسمٍ

222
00:17:24,200 --> 00:17:25,770
!هذا يبدو سيئًا يا هيجيكاتا-سان

223
00:17:26,260 --> 00:17:28,290
علينا التّراجع وإعادة تنظيم
...صُفوفنا قبل أن

224
00:17:29,100 --> 00:17:32,280
،فات الأوان
.مُت نكرةً لا ذِكر لك

225
00:17:35,850 --> 00:17:37,520
.أخبرتك أنّ هذا لن يُجدي نفعًا معي

226
00:17:39,440 --> 00:17:43,290
،توشي
.ضربتك الأولى مكشوفةٌ للغاية

227
00:17:45,530 --> 00:17:48,410
.كأنّك تدعو خصمك لردّها

228
00:17:48,880 --> 00:17:50,880
،أخبرتك
.ضرباتك مكشوفةٌ لي تمامًا

229
00:17:52,590 --> 00:17:54,360
ماذا عليّ أن أفعل حيال ذلك إذن؟

230
00:17:54,620 --> 00:17:56,420
،الأمر بسيطٌ

231
00:17:56,960 --> 00:17:58,740
.باغتهم بضربةٍ أخرى قبل أن يفعلوا

232
00:18:00,800 --> 00:18:01,800
ماذا؟

233
00:18:02,530 --> 00:18:03,560
وماذا بعد ذلك؟

234
00:18:03,790 --> 00:18:05,800
.سدّد ضربةً ثالثة، ثُمّ رابعةً

235
00:18:12,240 --> 00:18:13,670
.واصل الانقضاض عليهم دُون هوادةٍ

236
00:18:14,240 --> 00:18:16,600
هكذا ينبغي لرجلٍ جامح
.مثلك أن يُقاتل

237
00:18:17,410 --> 00:18:19,210
.هذه هي مدرسة هيجيكاتا

238
00:18:26,680 --> 00:18:27,670
...ما هذا الّذي

239
00:18:28,720 --> 00:18:31,880
ألا تملك خُطّةً؟
!إنّك تترنّح في ضرباتك لا غير

240
00:18:32,150 --> 00:18:33,200
...كوندو-سان

241
00:18:36,640 --> 00:18:39,210
أَتلك ركلةٌ الّتي شاهدتها لتوّي؟
كيف لك أن تقوم بذلك؟

242
00:18:39,670 --> 00:18:45,930
،طموحٌ بلا حدود، تفانٍ، وتواضع
.لو وُلد في عُصورٍ خَلت لأصبح دايميو

243
00:18:46,200 --> 00:18:49,600
،وحتّى الآن
.قد يُخلّده التّاريخ

244
00:18:52,720 --> 00:18:54,350
.يا له مِن منظرٍ مُزرٍ

245
00:18:54,950 --> 00:18:56,440
هل هُزمت مُجددًا؟

246
00:18:56,680 --> 00:19:00,230
سوجي قد تفتّحت موهبته
.بغتةً ذات يومٍ

247
00:19:01,080 --> 00:19:02,750
تبًا، إنّه عبقريٌّ

248
00:19:02,960 --> 00:19:07,120
،بالمُناسبة، ابتكرت حركةً جديدة
أَتريد رُؤيتها؟

249
00:19:07,640 --> 00:19:13,610
،قد يُؤسّس مدرسته الخاصّة
.أو رُبّما يبدأ شيئًا أعظم

250
00:19:14,430 --> 00:19:16,630
،لا أبوح بذلك
.لكنّني أتحرّق شوقًا لرُؤية ما سيفعله

251
00:19:17,380 --> 00:19:18,600
ماذا عنّي أنا؟

252
00:19:21,670 --> 00:19:23,140
.يا لها مِن ضراوةٍ

253
00:19:24,990 --> 00:19:27,780
إلى متى سيصمد على هذا المِنوال؟

254
00:19:30,680 --> 00:19:34,080
،إنّه خفيفٌ، يُلائم قبضة يدي
.ويتحمّل أقسى الضّربات

255
00:19:35,420 --> 00:19:37,460
هل يتآكل أم ينثني؟

256
00:19:38,380 --> 00:19:39,530
.لا يهمّ

257
00:19:41,270 --> 00:19:42,220
...ساكورا

258
00:19:44,010 --> 00:19:46,740
.أنتِ عبقريّةٌ حقًا

259
00:19:56,600 --> 00:20:01,930
لا أعلم لماذا، لكنّني محاطٌ
.بأشخاصٍ يُذهلونني دائمًا

260
00:20:01,930 --> 00:20:05,120
!تمهّل، لنتحدّث! أجل، لنتحاور

261
00:20:05,460 --> 00:20:06,920
...أولًا، أخبرني باسمك و

262
00:20:07,750 --> 00:20:09,840
يُمكنكم جميعًا أن تُخلّدوا
.في طيّات التّاريخ

263
00:20:10,720 --> 00:20:11,640
.أمّا أنا، فكلا

264
00:20:13,090 --> 00:20:14,850
.أنا رجل التّربة

265
00:20:16,360 --> 00:20:18,930
،يكفيني أن أكون حبّة قمحٍ

266
00:20:20,240 --> 00:20:24,700
تُساعد غيري على النّمو فوق
.هذه الأرض، في هذه التّربة

267
00:20:28,840 --> 00:20:31,820
...اسمي هو

268
00:20:35,880 --> 00:20:36,580
...بايدي

269
00:20:44,740 --> 00:20:48,120
...بايديبو... زابورو

270
00:20:48,560 --> 00:20:49,970
اسمٌ؟

271
00:20:50,700 --> 00:20:53,200
وما جدوى الاسم لديّ؟

272
00:20:53,950 --> 00:20:58,320
بالنّسبة لي، ربطت مصيري
.بأولئك الّذين أنقذوني

273
00:20:59,760 --> 00:21:02,980
،لا يهمّني أيّ شخصٍ آخر
.هذا كل ما أحتاج إليه

274
00:21:03,450 --> 00:21:07,740
.لا يُصدّق

275
00:21:09,400 --> 00:21:10,530
.قشعر بدني

276
00:21:10,790 --> 00:21:11,300
ماذا؟

277
00:21:12,400 --> 00:21:13,740
.أريد أن أكون مثلك

278
00:21:14,290 --> 00:21:16,760
نوغوتشي! لماذا تبكي؟

279
00:21:16,760 --> 00:21:19,100
!هيجيكاتا توشيزو

280
00:21:19,100 --> 00:21:20,760
.اخفض صوتك

281
00:21:21,030 --> 00:21:23,410
والآن، أسرع، ما زال هناك المزيد
.مِن هؤلاء الحُثالة لندحرهم

282
00:21:24,760 --> 00:21:28,770
جسر ماتسوبارا

283
00:21:36,880 --> 00:21:38,610
.لم يكن هذا حتّى بمثابة إحماء

284
00:21:42,970 --> 00:21:43,960
.إذًا، هذا أنت

285
00:21:45,030 --> 00:21:50,040
رجل

286
00:21:45,030 --> 00:21:50,040
التّربة

287
00:23:20,170 --> 00:23:25,550
الحلقة القادمة

288
00:23:21,520 --> 00:23:22,800
.سايتو هاجيمي يُحدّثكم

289
00:23:23,880 --> 00:23:26,170
،إذًا، سأُقاتل ذلك المدعوّ أيامي
أليس كذلك؟

290
00:23:27,090 --> 00:23:31,810
،ثمّة شيءٌ فيه يبثّ القشعريرة في جسدي
.لكن عليّ حماية المدينة مهما كان الثّمن

291
00:23:33,380 --> 00:23:35,500
.كلا، ليس هذا فحسب

292
00:23:36,760 --> 00:23:38,700
.أنا لا أُريد لأيّ شخصٍ أن يهزمني

293
00:23:39,600 --> 00:23:41,440
.كُلّ ما أريده هو أن أزداد قوّةً

294
00:23:42,290 --> 00:23:44,000
.لقد وعدت بذلك

295
00:23:45,340 --> 00:23:46,900
."الحلقة القادمة: "الخَلَف

296
00:23:47,200 --> 00:23:50,040
الخَلَف

297
00:23:47,680 --> 00:23:48,850
.إيّاكم أن تُفوّتوها