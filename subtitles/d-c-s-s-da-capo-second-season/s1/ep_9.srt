1
00:00:01,200 --> 00:00:05,420
كما تعلم,عندما عاشت بعيداً عن جزيرة هاتسوني

2
00:00:05,420 --> 00:00:08,090
واصلت العمل بـ جد لـ أنك كُنت داعمها

3
00:00:12,670 --> 00:00:17,870
لكن,صاحب تلك العاطفة التى جعلها هكذا,من يكون؟

4
00:00:19,970 --> 00:00:20,560
نيمو

5
00:00:36,740 --> 00:00:41,140
لقد تأخرتِ,كُنتُ أنتظركِ

6
00:00:41,580 --> 00:00:44,580
أردتُ الحديث معكِ

7
00:00:45,500 --> 00:00:49,420
أكيشيما سينسي أخبرني,الكثير عن الكليّة

8
00:00:50,460 --> 00:00:53,380
وأدركتُ أن يجبُ أن أعتذر لكِ

9
00:00:53,380 --> 00:00:54,010
...لذا

10
00:02:35,710 --> 00:02:39,030
بعد ذلك,بـ رأيك ماذا قال سوجينامي؟

11
00:02:36,170 --> 00:02:43,140
المشاعر الغيرُ مُحرجة

12
00:02:40,200 --> 00:02:45,850
"صندوق باندورا سوف يكون أفضل من لعنةٍ من الفرعون"

13
00:02:46,790 --> 00:02:48,150
هذا مُضحك,أليس كذلك؟

14
00:02:53,630 --> 00:02:56,050
لم يكن هذا مُضحكاً,آيّشيا؟

15
00:02:56,050 --> 00:02:58,320
ماذا؟,كلا,هذا ليس صحيحاً

16
00:03:01,970 --> 00:03:03,260
..فهمت

17
00:03:03,260 --> 00:03:04,970
...حسناً

18
00:03:17,030 --> 00:03:19,690
ماذا؟,هل سوف تأكلين وحدكِ؟

19
00:03:19,690 --> 00:03:21,720
لمَ لا تأتين للـ آكل معنا؟

20
00:03:22,320 --> 00:03:24,590
طبخُ آيّشيا جيد

21
00:03:31,830 --> 00:03:34,830
..هيا,بما أن آيّشيا قامت بـ الطبخِ

22
00:03:34,830 --> 00:03:36,000
لا تقلق بـ شأني

23
00:03:37,920 --> 00:03:39,690
سوف أعتني بـ نفسي

24
00:03:40,170 --> 00:03:45,490
لا تسئ الفهم,لستُ أريدُ أن أكون عبءً عليك وعلى آيّشيا سان,ني سان

25
00:03:50,060 --> 00:03:51,350
آويّ,نيمو

26
00:03:54,150 --> 00:03:55,270
تباً

27
00:03:56,270 --> 00:03:57,920
هل هذا خطأي؟

28
00:03:59,480 --> 00:04:02,100
هل كان هُناك شئٌ لم يجب عليّ فعله؟

29
00:04:03,990 --> 00:04:10,570
حمقاء,هذا ليس صحيحاً,لا عداوة بينكِ وبينها

30
00:04:11,250 --> 00:04:11,980
...لكن

31
00:04:17,590 --> 00:04:21,460
لا بأس,ليس من الضروريّ أن تقلقِ حِيال هذا الأمر

32
00:04:21,460 --> 00:04:22,920
دعي الأمر عليّ

33
00:04:32,730 --> 00:04:33,300
نيمو

34
00:04:34,350 --> 00:04:38,960
آسف,هل يُمكن أن نتناقش هكذا؟

35
00:04:39,900 --> 00:04:42,690
آسفٌ على ما حدث

36
00:04:42,690 --> 00:04:45,680
لم أعر مشاعركِ أي إهتمام قبل أن أفكر في تلك الأشياء الغريبة

37
00:04:46,240 --> 00:04:52,080
حتى إن لم تغفرِ لي,فـ من الطبيعي أن يحدث ذلك

38
00:04:53,500 --> 00:04:58,730
لـ هذا سوف أنتظر,حتىُ تُريدِ مني رؤية تلك الرسائل التى كتبتها لي

39
00:04:59,540 --> 00:05:00,220
سوف إنتظر

40
00:05:01,630 --> 00:05:03,990
هذا ما أردتُ إخباركِ به بـ المدرسة

41
00:05:05,050 --> 00:05:07,570
آسف,لم أستطيعُ قول هذا مباشرةً

42
00:05:09,470 --> 00:05:10,050
ني سان

43
00:05:10,850 --> 00:05:15,060
لكن,لا علاقة لـ آيّشيا في كُل هذا

44
00:05:15,890 --> 00:05:19,440
لذا,أتمنى أن تفهم ما أريدُ قوله

45
00:05:20,480 --> 00:05:25,030
إذا لم تفهمِ,فـ لا يوجد مكانٌ آخر لكيّ تعيش آيّشيا فيه

46
00:05:29,990 --> 00:05:34,950
آيّشيا في الحقيقة,آتت إلى جزيرة هاتسوني وحدها من أجل مُقابلة جدّة ساكورا

47
00:05:36,460 --> 00:05:39,910
قالت أنها آتت إلى هُنا من أجل دراسة الثقافة اليابانيّة وشئٌ كـ هذا

48
00:05:40,460 --> 00:05:42,340
حسناً,هذا بـ شكلٍ عام

49
00:05:44,630 --> 00:05:47,760
لكن كما تعلمين,الجدّة لم تعد هُنا

50
00:05:47,760 --> 00:05:51,150
...بما أن ساكورا ليست هُنا,قُمت بدلاً عنها

51
00:05:51,760 --> 00:05:52,550
الجدّة

52
00:05:53,220 --> 00:05:53,850
ساكورا

53
00:06:05,820 --> 00:06:06,990
الجدّة

54
00:06:12,410 --> 00:06:19,460
ليس لديّها مكان آخر تعيش فيه,لذا..نيمو,تحدثِ معها بـ شكلٍ طبيعيّ

55
00:06:20,380 --> 00:06:21,310
كلا

56
00:06:23,460 --> 00:06:26,160
لا علاقة لي بـ هذا

57
00:06:26,630 --> 00:06:28,610
لماذا تفعل كل شئٍ كما تشاء؟

58
00:06:29,970 --> 00:06:33,910
لكن,لا أستطيعُ ترك أحد أصدقاء الجدة يحدث لهم هذا

59
00:06:33,910 --> 00:06:35,560
لستُ أهتم

60
00:06:35,560 --> 00:06:37,290
هيّ ليست جدّتي

61
00:06:59,500 --> 00:07:00,250
نيمو

62
00:07:09,380 --> 00:07:14,430
بما أنها جدّة ني سان,فـ هي جدّتي أيضاً

63
00:07:16,930 --> 00:07:17,570
...لكن

64
00:07:26,980 --> 00:07:29,640
أنا لا أعلم,أيتها الجدّة

65
00:08:02,390 --> 00:08:06,260
في وقتٍ كـ هذا؟,ماذا كانت الجدة يوشينو لـ تفعل؟

66
00:08:08,070 --> 00:08:11,030
أي نوعٍ من السحر أستعمله كيّ أُصالح جونيتشي ونيمو؟

67
00:08:38,300 --> 00:08:41,220
مساء الخير

68
00:08:43,230 --> 00:08:45,370
أظنُ أن يُجب أن أقول"صباح الخير"بدلاً من هذه في هذا الوقتِ من اليوم

69
00:08:49,040 --> 00:08:55,700
فهمت,بما أن نيمو سان قد عادت,فـ من الصعبِ البقاء معهم

70
00:08:56,760 --> 00:09:02,310
أنا آسفة,أستطيعُ أن أرى ذلك الصف من أشجار الساكورا من غرفتي

71
00:09:03,290 --> 00:09:06,390
عندما أرى الجميعُ ذاهبين إلى المدرسة

72
00:09:06,390 --> 00:09:08,370
أفهم الكثير من الأشياء

73
00:09:10,380 --> 00:09:14,830
"شئ كـ"اليوم حدث شئٌ مُمتع

74
00:09:15,800 --> 00:09:18,970
"أو"هُناك شئٌ مُقلق

75
00:09:20,390 --> 00:09:23,200
"و"أنا قابلت المزيد من الأصدقاء الجُدد

76
00:09:25,230 --> 00:09:28,130
الناس الذين يفكرون في الموضوع كثيراً دون أن يستطيعوا فعل شئ

77
00:09:29,310 --> 00:09:31,460
أنتِ؟

78
00:09:32,110 --> 00:09:37,780
لا تقلقِ على هذان الإثنان,كلاهما لا يٌريد الصُلح؟

79
00:09:38,780 --> 00:09:42,110
كل ما في الأمر أنها لم يُفهما بعضها جيّداً

80
00:09:42,110 --> 00:09:44,180
يحتاجان إلى الوقت من أجلِ هذا

81
00:09:45,620 --> 00:09:46,960
كوتوري قالت هذا أيضاً

82
00:09:47,560 --> 00:09:57,490
لقد مرّت سنتين,يبدو أنهما نسيّا شيئاً مهماً في ذلك الوقت

83
00:10:06,480 --> 00:10:08,710
أشجار الساكورا التى لا تذبّل

84
00:10:10,520 --> 00:10:15,570
إذا ذهبوا هُناك,أظن أنهم سوف يتذكرون

85
00:10:15,570 --> 00:10:20,440
مع ذلك,كُل الحوادث الغامضة التى حدثت في جزيرة هاتسوني

86
00:10:20,440 --> 00:10:23,330
كانت بـ سبب سحر تلك الشجرة

87
00:11:02,550 --> 00:11:06,740
نيمو سينبايّ,لـ نخرج

88
00:11:08,040 --> 00:11:10,020
إنتظرِ,توقفِ عن هذا,ميهارو

89
00:11:10,020 --> 00:11:13,940
نيمو سينبايّ,ياهو

90
00:11:15,420 --> 00:11:17,990
أرجوكِ,أنتِ تُزعجين الجِيران

91
00:11:18,630 --> 00:11:20,010
..لكن

92
00:11:21,010 --> 00:11:25,060
مُرت فترةٌ طويلة منذُ أن خرجت في موعدٍ معكِ

93
00:11:25,060 --> 00:11:29,250
لقد كُنت أتطلع لـ ذلك منذُ ليلة البارحة,لـ درجة أنني لم أستطع النوم

94
00:11:32,270 --> 00:11:36,500
لكن,هل حقاً نستطيعُ أن نترك أساكورا سينبايّ هكذا؟

95
00:11:37,570 --> 00:11:40,260
لا حاجة لـ أن تقلقِ على أمرٍ كـ هذا

96
00:11:40,570 --> 00:11:43,870
اليوم,دعنا نستمع كثيراً

97
00:11:43,870 --> 00:11:44,800
أجل

98
00:11:44,800 --> 00:11:48,160
إذن,دعينا نأكل بارفت الموز معاً

99
00:11:48,160 --> 00:11:52,620
ثم نذهب إلى مُتحف الموز,ثم نذهب لـ نرى حلقة حروب الموز الثالثّة

100
00:11:52,620 --> 00:11:54,210
هل يُوجد شئٌ كـ هذا؟

101
00:11:56,710 --> 00:11:58,650
مُزعجةٌ منذُ الصباحِ الباكر

102
00:11:59,130 --> 00:12:00,800
ذلك الصوت لـ ميهارو

103
00:12:01,340 --> 00:12:02,260
جونيتشي

104
00:12:03,390 --> 00:12:04,570
ما الأمر,آيّشيا؟

105
00:12:05,720 --> 00:12:08,290
ما رأيك أن نذهب في نُزهة؟

106
00:12:08,640 --> 00:12:09,080
حسناً؟

107
00:13:13,310 --> 00:13:16,230
هيا جونيتشي,أسرع..أسرع

108
00:13:18,150 --> 00:13:19,630
..من هُنا..من هُنا

109
00:13:20,710 --> 00:13:25,410
آيّشيا,لمَ العجلة هكذا؟

110
00:13:28,760 --> 00:13:30,780
...فهمت,إنتظرِ فقط

111
00:13:48,030 --> 00:13:49,020
...هذا المكان

112
00:13:55,500 --> 00:13:59,880
جونيتشي,لا تسرح في أحلام اليقظة,تعال إلى هُنا

113
00:13:59,880 --> 00:14:02,150
تعال لـ نأكل معاً

114
00:14:03,380 --> 00:14:04,670
حـ..حسناً

115
00:14:21,610 --> 00:14:24,210
حسناً,بقيّ القليل,نيمو سينبايّ

116
00:14:24,650 --> 00:14:26,200
تعالِ من هذا الطريق

117
00:14:26,200 --> 00:14:27,320
قاتلِ

118
00:14:27,320 --> 00:14:31,200
ميهارو,لماذا أردتِ المجئ إلى هذا المكان فجأةً؟

119
00:14:49,970 --> 00:14:52,390
آه,أوتامارو,أين تذهب؟

120
00:14:52,390 --> 00:14:55,540
واه,سوف تكون مشكلةً لو ضاع

121
00:14:55,540 --> 00:14:57,930
لـ نسرع ونلحق به

122
00:14:58,770 --> 00:15:01,060
...أنتما الإثنان

123
00:15:01,060 --> 00:15:03,500
ميهارو,إنتظرِ

124
00:15:03,980 --> 00:15:08,480
تباً ميهارو,أخبرتها أن لا تقلق حيال هذا

125
00:15:14,450 --> 00:15:15,660
ماذا سوف نفعل؟

126
00:15:15,660 --> 00:15:17,450
ماذا تعني بـ"ماذا سوف نفعل"؟

127
00:15:17,450 --> 00:15:19,520
لا نعلم إلى أي مكانٍ ذهبوا

128
00:15:20,080 --> 00:15:22,490
كل ما نستطيعُ فعله هو الإنتظار هُنا

129
00:15:23,380 --> 00:15:24,000
أظن ذلك

130
00:15:44,060 --> 00:15:44,810
كُلِ

131
00:15:45,690 --> 00:15:46,600
لا أريد

132
00:15:47,280 --> 00:15:48,860
أنتِ جائعة,أليس كذلك؟

133
00:15:49,400 --> 00:15:50,320
لستُ جائعة

134
00:15:58,120 --> 00:16:00,620
توقف,تضحك أكثر من اللازم

135
00:16:01,620 --> 00:16:03,170
آسف..آسف

136
00:16:06,290 --> 00:16:09,250
نيمو,هل تتذكرين هذا المكان؟

137
00:16:09,710 --> 00:16:11,050
هذا قاسٍ,ني سان

138
00:16:14,180 --> 00:16:16,350
كيف تُريديني أن أنسى؟

139
00:16:16,350 --> 00:16:18,120
..هذا المكان

140
00:16:19,020 --> 00:16:22,910
جئت لـ إحضاري حين هربتُ من المنزل

141
00:16:23,980 --> 00:16:26,560
تلك المرة الأولى التى أصبحت قلوبنا فيها قلباً واحداً

142
00:16:27,820 --> 00:16:32,600
إنه مكانٌ مهم لي ولك وذكرياتنا

143
00:16:34,610 --> 00:16:37,970
في الحقيقة,جدّة ساكورا هيّ من زرعت هذه الشجرة

144
00:16:38,330 --> 00:16:38,870
ماذا؟

145
00:16:39,680 --> 00:16:45,280
...كما خططتِ آيّشيا سان,كلاهما تحت تلك الشجرة,ولكن

146
00:16:45,280 --> 00:16:47,800
هل سوف يتصالحان هكذاً؟

147
00:16:48,340 --> 00:16:49,350
أظن ذلك

148
00:16:50,630 --> 00:16:54,400
مع ذلك,وُجد السِحر من أجل سعادة الناس

149
00:16:58,510 --> 00:17:02,560
..إذا كانت لا تزال هُناك بعض القُوى السحريّة في تلك الشجرة,فـ ربما

150
00:17:03,440 --> 00:17:05,440
كلا,بـ التأكيد

151
00:17:06,900 --> 00:17:13,810
لذا,عندما وجدتكِ عن هذه الشجرة,ظننتُ أن الجدّة هيّ من جعلتنا نتقابل

152
00:17:14,900 --> 00:17:18,780
وأنها حمتكِ طوال الليل

153
00:17:20,790 --> 00:17:25,870
وأيضاً,نيمو,عندما أصبحتِ جزءً من عائلتنا

154
00:17:25,870 --> 00:17:31,520
لم أعرف ما العمل عندما آتيتِ,الجدة أقنعتني بكِ

155
00:17:31,800 --> 00:17:32,380
ماذا؟

156
00:17:37,340 --> 00:17:40,430
..أنتِ تشبهني بعد كُل شئ

157
00:17:40,430 --> 00:17:42,950
...أنت كسولٌ ولا تُحب الإزعاج

158
00:17:42,950 --> 00:17:47,390
لكن يا جونيتشي,مهما كانت عادتك

159
00:17:47,900 --> 00:17:52,800
لكن كـ رجل,عُندما تُقرر قبولها

160
00:17:52,810 --> 00:17:59,620
يجبُ أن تساعدها عندما تحتاج الدعم

161
00:18:01,280 --> 00:18:09,080
إن لم تفعل ذلك,قلبها سوف يُصبح هشّاً سهل الكسر

162
00:18:10,420 --> 00:18:12,500
هل تستطيعُ أن تعدني,جونيتشي؟

163
00:18:13,000 --> 00:18:15,350
أجل,أعدكِ,جدتي

164
00:18:16,170 --> 00:18:18,010
يا لك من طفلٍ جيد

165
00:18:18,010 --> 00:18:19,550
إذن,خُذ

166
00:18:23,100 --> 00:18:24,890
رائع..رائع..رائع

167
00:18:26,940 --> 00:18:28,210
لم أكنّ أعرف

168
00:18:29,730 --> 00:18:35,360
الجدّة كانت خجولة,ربما هيّ من كانت خجلةً منكِ

169
00:18:36,280 --> 00:18:41,200
لكن,رغم أنكِ لم تكونِ تعرفينها,الجدّة حمتكِ دائماً

170
00:18:41,870 --> 00:18:44,540
لم تكنّ تذكركِ بـ لسانها,لكنكِ كُنتِ دائماً في بالها

171
00:19:08,980 --> 00:19:09,810
جدتي

172
00:19:19,760 --> 00:19:20,700
جدتي

173
00:19:25,040 --> 00:19:28,240
لذا,لا تقولِ أشياء حزينة,حسناً؟

174
00:19:30,290 --> 00:19:30,820
أجل

175
00:19:37,590 --> 00:19:42,470
على ما أذكر,الوُعود التى تُعقد تحت هذه الشجرة سوف تتحق بـ التأكيد

176
00:19:42,470 --> 00:19:43,240
ماذا؟

177
00:19:43,760 --> 00:19:48,300
قد تكون ذابلةً الآن,لكن مشاعري لم تتغير منذُ ذلك الوقت

178
00:19:49,270 --> 00:19:49,810
...لذا

179
00:19:54,730 --> 00:19:58,940
أنا,أساكورا جونيتشي,أريدُ تجديد وعدي تحت هذه الشجرة

180
00:19:59,820 --> 00:20:03,720
لـ حمايّة أساكورا نيمو مهما حدث

181
00:20:04,240 --> 00:20:08,700
هذا لـ أني أفعل شيئاً منذُ ذلك الوعد

182
00:20:10,040 --> 00:20:10,700
ني سان

183
00:20:12,250 --> 00:20:13,630
لكن,سوف أصحح شيئاً واحداً

184
00:20:14,330 --> 00:20:18,270
منذُ الآن,سوف أعتني بك كـ حبيبةٍ لي,هذا كل شئ

185
00:20:32,230 --> 00:20:34,480
لـ نعد,إلى بيتنا

186
00:20:44,280 --> 00:20:47,740
ماذا يفعلان الآن,أولئك الإثنان؟

187
00:20:47,740 --> 00:20:48,790
لا أعلم

188
00:20:48,790 --> 00:20:52,200
لمَ لا نرى؟

189
00:20:53,210 --> 00:20:53,870
أجل

190
00:20:54,960 --> 00:20:56,630
آه,ها هم,ها هم

191
00:20:57,500 --> 00:21:02,300
آويّ,آيّشيا,ميهارو

192
00:21:04,180 --> 00:21:05,510
جونيتشي ونيمو

193
00:21:11,930 --> 00:21:15,440
مُذهل,سحرُ شجرة الساكورا ما زال حيّاً

194
00:21:16,020 --> 00:21:19,410
كان هذا السحرّ الذي يجعل الناس سُعداء

195
00:21:20,150 --> 00:21:22,070
لقد فعلناها

196
00:21:22,070 --> 00:21:24,860
أساكورا سينبايّ,نيمو سينبايّ

197
00:21:24,860 --> 00:21:27,030
كُنتما قلقان عليّنا,أنتما الإثنان

198
00:21:27,030 --> 00:21:28,490
على الرحب والسعة

199
00:21:28,990 --> 00:21:33,750
آسفة على ما حدث,آيّشيا,هل يُمكن أن تعدِ لنا العشاء الليلة؟

200
00:21:33,750 --> 00:21:36,080
أجل,أتركِ الأمر عليّ

201
00:23:09,940 --> 00:23:39,970
! لقد إلتحقتُ به

202
00:23:11,050 --> 00:23:11,960
ني سان

203
00:23:11,960 --> 00:23:16,300
الحمدُ لله,عُدنا كما كُنا أخيراً

204
00:23:16,300 --> 00:23:19,290
أنت بـ جانبي,وأنا بـ جانبك

205
00:23:19,290 --> 00:23:20,500
نعيش معاً

206
00:23:21,510 --> 00:23:25,990
لكن,أنت مُحق,هُناك شئ واحد لم يتغيّر

207
00:23:26,670 --> 00:23:31,100
لا تقلق,سوف تتحسن علاقتي مع آيّشيا بـ التأكيد

208
00:23:31,870 --> 00:23:38,140
إذن,آيّشيا,هذا الزيّ,لماذا ترتدينه؟