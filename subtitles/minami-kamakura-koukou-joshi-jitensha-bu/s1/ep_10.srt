1
00:00:02,920 --> 00:00:05,630
.يا مديرة المحلّ كوروني، لقد أتينا

2
00:00:06,830 --> 00:00:08,110
.أنا هنا

3
00:00:11,610 --> 00:00:12,860
!مفاجأة

4
00:00:16,660 --> 00:00:19,390
هذه هي متسابقة الطّرق خاصّتك
.يا مايهارو هيرومي

5
00:00:19,910 --> 00:00:21,870
ما...؟ خاصّتي؟

6
00:00:23,440 --> 00:00:24,920
متسابقة الطّرق خاصّتي؟

7
00:00:27,790 --> 00:00:30,510
إنّها رائعة للغاية، أليس كذلك يا هيرومي؟

8
00:00:30,510 --> 00:00:31,340
.نعم

9
00:00:31,340 --> 00:00:33,420
أيّتها المديرة، متى ركّبتِ هذه؟

10
00:00:34,340 --> 00:00:36,870
هذا هو ذلك الهيكل من السّباق، صحيح؟

11
00:00:36,870 --> 00:00:41,470
نعم. إنّها درّاجة متوازنة تمامًا يمكنك استعمالها
.في السّباقات أو لركوبها لمسافات طويلة

12
00:00:41,470 --> 00:00:43,230
.هذا رائع

13
00:00:43,230 --> 00:00:45,600
.أمست درّاجة فعليّة الآن

14
00:00:46,950 --> 00:00:49,820
لكن من أين حصلتِ على الأجزاء؟

15
00:00:49,820 --> 00:00:51,780
...صحيح، بشأن ذلك

16
00:00:51,780 --> 00:00:56,300
.يا رفاق، إنّنا نُركّب أوّل درّاجة لتلميذة ثانويّة

17
00:00:56,300 --> 00:00:59,780
هل يمكنكم إحضار أجزائكم الإضافيّة لي؟

18
00:00:59,780 --> 00:01:02,290
!أكيد

19
00:01:03,290 --> 00:01:05,040
.وهكذا جمعتُ الأجزاء

20
00:01:05,040 --> 00:01:06,290
.فهمت

21
00:01:07,500 --> 00:01:09,090
.إنّهم لطيفون للغاية

22
00:01:09,090 --> 00:01:12,550
.إنّ من يركبون الدّرّاجات يغيّرون أجزاءها طوال الوقت

23
00:01:12,550 --> 00:01:14,800
.ويكون لديهم أجزاء سابقة إضافيّة أحيانًا

24
00:01:14,800 --> 00:01:18,030
من السّهل العثور على ما يكفي من أجل
.درّاجة واحدة عند جمع كلّ ما لديك

25
00:01:18,030 --> 00:01:22,520
كـ-كم سيكلّف هذا؟

26
00:01:22,520 --> 00:01:25,600
،بما أنّها مصنوعة من أجزاء إضافيّة
.فلستِ بحاجة لتدفعي أيّ شيء

27
00:01:28,060 --> 00:01:29,930
.هذا ممتاز يا هيرومي

28
00:01:30,670 --> 00:01:32,480
...لـ-لكن

29
00:01:32,480 --> 00:01:34,580
هل أنتنّ واثقات أنّه يمكنني أخذها؟

30
00:01:34,580 --> 00:01:39,080
.عمِلنا جميعًا معًا للحصول على هذا الهيكل

31
00:01:39,080 --> 00:01:42,000
.هيرومي، لقد فزتِ بهذه الدّرّاجة

32
00:01:42,000 --> 00:01:44,090
.لقد ثابرتِ حتّى النّهاية وفزتِ

33
00:01:44,090 --> 00:01:45,310
.لا تقلقي بشأن هذا

34
00:01:45,310 --> 00:01:46,900
!أجل، أجل

35
00:01:48,490 --> 00:01:51,180
.لقد تكبّدت مديرة المحلّ عناء تركيبها لك

36
00:01:51,180 --> 00:01:52,980
.عليك أن تقبلي بها

37
00:01:52,980 --> 00:01:54,390
.لا مشكلة

38
00:01:54,390 --> 00:01:56,140
.استعمليها يا هيرومي-سان

39
00:01:56,140 --> 00:01:58,550
.إنّها هديّة منّا لك

40
00:01:58,550 --> 00:02:00,440
.شكرًا يا فتيات

41
00:02:00,860 --> 00:02:03,070
.سوف أقدّر يونيكو خاصّتي للأبد

42
00:02:03,070 --> 00:02:04,040
يونيكو؟

43
00:02:04,040 --> 00:02:06,560
نعم. ألا يبدو المصباح كالقرن؟

44
00:02:06,880 --> 00:02:08,520
.لذلك سأسمّيها يونيكو تيمّنًا بأحاديّ القرن

45
00:02:08,520 --> 00:02:11,280
.هذا جميل. أسمّي درّاجتي مومو

46
00:02:11,280 --> 00:02:13,510
ما...؟ سمّيتِ درّاجتك أيضًا يا أكيزوكي-سان؟

47
00:02:13,510 --> 00:02:14,320
.نعم

48
00:02:14,320 --> 00:02:15,870
.يا لها من فكرة رائعة

49
00:02:15,870 --> 00:02:19,720
أودّ أن أسمّي متسابقة الطُّرق خاصّتي
.عندما أحصل عليها

50
00:02:19,720 --> 00:02:22,780
ما رأيكنّ بـ"شادو المعجزة الخارقة رقم 1"؟

51
00:02:22,780 --> 00:02:24,620
شادو"؟ بمعنى "ظلّ"، صحيح؟

52
00:02:24,620 --> 00:02:26,930
.يبدو هذا كاسم من سلسلة مانغا

53
00:02:26,930 --> 00:02:30,330
!"كلاّ، بل "شادو" من الكلمة اليابانيّة بمعنى "طريق

54
00:02:30,830 --> 00:02:34,000
.يونيكو... متسابقة الطُّرق خاصّتي

55
00:04:05,800 --> 00:04:09,470
عليكنّ أن تحدّدن ما يجب على ناديكنّ
.أن يفعله في المستقبل

56
00:04:09,470 --> 00:04:12,320
هل هنالك شيء ما تردن فعله؟

57
00:04:13,410 --> 00:04:16,840
.كلّ ما أريد فعله هو الذّهاب لمكان بعيد

58
00:04:16,840 --> 00:04:19,650
.أجل! أريد السّفر عبر اليابان بأكملها

59
00:04:19,650 --> 00:04:23,170
.أنا أيضًا. أرغب بزيارة أماكن لم أرها من قبل

60
00:04:23,170 --> 00:04:25,800
لماذا لا تذهبن في رحلة إذًا؟

61
00:04:26,450 --> 00:04:28,280
رحلة؟

62
00:04:28,280 --> 00:04:36,170
يمكنكنّ أخذ درّاجاتكنّ على القطارات
.والطّائرات وتركبنها عندما تصلن لوجهتكنّ

63
00:04:36,170 --> 00:04:38,340
،وبما أنّكنّ ستركبن وسائل نقل أخرى

64
00:04:38,340 --> 00:04:41,170
.فسيوسّع ذلك منطقة نشاطكنّ كثيرًا

65
00:04:43,100 --> 00:04:45,280
.فعلاً؟ هذا رائع

66
00:04:45,280 --> 00:04:48,560
لكن هل يمكننا أخذ درّاجاتنا على القطارات؟

67
00:04:48,560 --> 00:04:51,270
.طبعًا لن تستطعن أخذها وهي مركّبة بشكل كامل

68
00:04:51,840 --> 00:04:54,850
سيتوجّب عليكنّ تفكيكها إلى حجم
توافق عليه شركة السّكك الحديديّة

69
00:04:54,850 --> 00:04:58,730
.ووضعها في حقائب خاصّة بها

70
00:04:58,730 --> 00:05:01,230
هل يمكننا فعل ذلك بمتسابقات الطُّرق خاصّتنا؟

71
00:05:01,230 --> 00:05:05,140
،نعم. بما أنّ درّاجات الطُّرق جدّ خفيفة
.فيمكن القول أنّها مناسبة للرّحلات

72
00:05:05,140 --> 00:05:08,070
إذًا لماذا لا نجرّب ذلك؟

73
00:05:08,070 --> 00:05:11,870
.صحيح. ولكنّ ساندي لديها درّاجة أمّهات

74
00:05:12,210 --> 00:05:14,580
صحيح. ماذا سنفعل؟

75
00:05:14,580 --> 00:05:18,780
،إن اشتريتنّ حقائب درّاجات من محلّي
.فسأؤجّركنّ درّاجة طُرق

76
00:05:18,780 --> 00:05:20,340
ماذا؟ فعلاً؟

77
00:05:20,340 --> 00:05:22,900
!مرحى! سنشتريها في الحال

78
00:05:22,900 --> 00:05:25,050
لكن، أليست غالية الثّمن؟

79
00:05:25,050 --> 00:05:27,050
...بشأن ذلك

80
00:05:27,410 --> 00:05:31,380
،بما أنّكنّ عملتنّ بجدّ في السّباق اللّيليّ
.حصل نادينا على القليل من المال

81
00:05:31,380 --> 00:05:35,390
،لم يتمّ الاعتراف بنا كنادٍ رسميّ بعد
.لكن تمّ القيام باستثناء صغير

82
00:05:36,700 --> 00:05:37,900
فعلاً؟

83
00:05:37,900 --> 00:05:42,770
هل تعتقدن أنّ هذا حدث
لأنّنا غسلنا نقودنا في ذلك اليوم؟

84
00:05:43,410 --> 00:05:45,160
.ربّما يكون الأمر كذلك

85
00:05:47,270 --> 00:05:49,700
.شكرًا جزيلاً

86
00:05:51,020 --> 00:05:52,670
.عدن ثانية

87
00:05:52,670 --> 00:05:55,360
هذه هي حقائب الدّرّاجات إذًا؟

88
00:05:55,360 --> 00:05:57,610
هل ستتّسع فيها بالفعل؟

89
00:05:57,610 --> 00:06:00,870
.لا تقلقن. سأريكنّ كيف تفكّكن درّاجاتكنّ

90
00:06:00,870 --> 00:06:02,640
.شكرًا جزيلاً لك

91
00:06:05,820 --> 00:06:08,080
.لم نحتج للكثير من الوقت لتفكيكها

92
00:06:08,080 --> 00:06:09,590
.هذا رائع

93
00:06:17,060 --> 00:06:18,890
.ها قد انتهينا

94
00:06:20,290 --> 00:06:23,160
.هذا رائع، لقد اتّسعت لها بالفعل

95
00:06:23,160 --> 00:06:27,070
،عندما تركّبن درّاجاتكنّ من جديد
.عليكنّ القيام بالأمر بالعكس فحسب

96
00:06:28,570 --> 00:06:31,570
إلى أين قد نذهب؟

97
00:06:31,570 --> 00:06:34,000
هل من توصيات؟

98
00:06:34,000 --> 00:06:36,090
.أريد أن أركب الدّراجة حول اليابان بأكملها

99
00:06:36,090 --> 00:06:41,580
،حسنًا، بما أنّها رحلتنا الأولى
.أُفضّل مكانًا يمكننا زيارته في يوم واحد

100
00:06:41,710 --> 00:06:46,980
مكان ليس بعيدًا للغاية وفيه
...الكثير لنراه مثل

101
00:06:47,810 --> 00:06:49,170
.شبه جزيرة ميورا، على ما أظنّ

102
00:06:49,170 --> 00:06:50,340
شبه جزيرة ميورا؟

103
00:06:50,660 --> 00:06:55,200
.نعم. هنالك ميناء بحريّ وسمك لذيذ وفجل ميورا

104
00:06:55,200 --> 00:06:58,180
.أعتقد أنّه سيكون مكانًا ممتعًا للتّجوال فيه

105
00:07:00,140 --> 00:07:02,090
.أرغب بالذّهاب

106
00:07:02,090 --> 00:07:06,530
في تلك الحالة، لماذا لا تبدأن
من يوكوسوكا وتنتهين في ميساكي؟

107
00:07:06,530 --> 00:07:09,170
ستكنّ قادرات على الرّكوب
.في ذلك المسار خلال يوم واحد

108
00:07:09,170 --> 00:07:10,580
.لقد اتّخذنا قرارنا

109
00:07:10,580 --> 00:07:15,040
وجهة نادي درّاجات مينامي
...كاماكورا للفتيات هي

110
00:07:15,040 --> 00:07:17,490
!شبه جزيرة ميورا

111
00:07:17,800 --> 00:07:20,500
فعلاً؟ ستذهبن إلى شبه جزيرة ميورا؟

112
00:07:20,500 --> 00:07:24,180
،إنّها قريبة، لكنّي لم أزرها من قبل
.لذلك أنا متحمّسة للغاية

113
00:07:24,180 --> 00:07:27,050
.أودّ الذّهاب أيضًا بمجرّد أن أغادر المستشفى

114
00:07:27,050 --> 00:07:29,330
.فويوني، أرسلي لي الكثير من الصّور

115
00:07:29,330 --> 00:07:31,510
.يمكنك الاعتماد عليّ

116
00:07:32,200 --> 00:07:34,980
.نات-تشان، وصلتكِ رسالة من والديك

117
00:07:34,980 --> 00:07:36,820
.شكرًا يا عمّتي

118
00:07:43,730 --> 00:07:45,560
.إنّهما قليلا الكلام كالعادة

119
00:07:47,720 --> 00:07:50,700
.أودّ أن أسافر بعيدًا يومًا ما أيضًا

120
00:07:54,660 --> 00:07:57,830
ماذا؟ تلمّعين درّاجتك ثانية يا أختي؟

121
00:07:57,830 --> 00:08:02,010
نعم. سوف أركبها طويلاً في الغد، لذلك
.فكّرتُ في جعلها تبدو في أفضل حلّة

122
00:08:02,580 --> 00:08:05,360
فهمت. هل يمكنني المساعدة؟

123
00:08:05,360 --> 00:08:07,040
.نعم، شكرًا

124
00:08:07,490 --> 00:08:11,420
.ستأخذكم الدّرّاجات لأيّ مكان

125
00:08:11,420 --> 00:08:15,760
،عبر الحقول وفوق الجبال
.إنّها تسافر على الطّرقات

126
00:08:17,360 --> 00:08:19,800
.يونيكو، سوف نزور أماكن كثيرة معًا

127
00:08:20,690 --> 00:08:22,510
هيرومي، هل أنت هناك؟

128
00:08:23,320 --> 00:08:28,150
!أنا هنا لأجرّب حمّامًا يابانيًّا

129
00:08:32,530 --> 00:08:34,180
ما الّذي تفعلينه هنا؟

130
00:08:34,180 --> 00:08:38,080
.التقيتُ والدتك للتّوّ. لقد دعتني لمنزلكم

131
00:08:39,490 --> 00:08:42,330
.هيرومي، دعيني أغسل ظهرك

132
00:08:42,330 --> 00:08:44,580
.لستِ بحاجة لفعل ذلك

133
00:08:44,580 --> 00:08:50,690
على الإطلاق. أخبرتني كوروني
.أنّ اليابانيّين يستحمّون هكذا

134
00:08:50,690 --> 00:08:52,450
.لم أسمع بهذا من قبل

135
00:08:54,590 --> 00:08:55,720
...هيرومي

136
00:08:56,510 --> 00:08:59,010
.تبدو انحرافاتك ناقصة

137
00:08:59,010 --> 00:08:59,770
ناقصة؟

138
00:08:59,770 --> 00:09:02,220
.في هذه الجهة هنا

139
00:09:02,220 --> 00:09:03,340
...وهذه

140
00:09:05,980 --> 00:09:07,920
!إنّها تسمّى انحناءات

141
00:09:07,920 --> 00:09:10,950
!لا، مهلاً! كفّي عن التّحديق
!أنت تحرجينني

142
00:09:10,950 --> 00:09:13,010
!لا، لا! لا داعي للحرج

143
00:09:13,010 --> 00:09:14,630
!هذا جزء من التّرابط العاريّ

144
00:09:14,630 --> 00:09:18,030
!سأغسل جهتك الأماميّة الآن

145
00:09:26,830 --> 00:09:33,200
.لا أطيق الانتظار للذّهاب إلى شبه جزيرة ميورا

146
00:09:38,240 --> 00:09:40,640
.صباح الخير يا فتيات

147
00:09:40,640 --> 00:09:42,110
.صباح الخير يا هيرومي

148
00:09:42,110 --> 00:09:45,010
.صباح الخير

149
00:09:45,010 --> 00:09:47,230
.سينسي، لقد حضر الجميع

150
00:09:47,230 --> 00:09:49,480
.حسنًا، لنذهب

151
00:09:50,000 --> 00:09:55,720
بينما سنكون على القطار، فستعترض
،درّاجاتنا الطّريق على المسافرين

152
00:09:55,720 --> 00:09:58,180
.لذلك دعونا نركب في مقطورات منفصلة

153
00:09:58,180 --> 00:09:59,980
.اذهبن إلى الأطراف بمجرّد أن تصلن إلى هناك

154
00:09:59,980 --> 00:10:01,160
.نعم

155
00:10:07,550 --> 00:10:08,790
.حسنًا

156
00:10:17,970 --> 00:10:21,760
.المحطّة التّالية، يوكوسكا. يوكوسكا

157
00:10:21,760 --> 00:10:23,650
.نكاد نصل

158
00:10:34,900 --> 00:10:38,070
!لقد وصلنا

159
00:10:38,070 --> 00:10:40,750
.لم يستغرق ذلك الكثير من الوقت

160
00:10:40,750 --> 00:10:45,030
.رأيت الكثير من السّفن الرّائعة من القطار

161
00:10:45,030 --> 00:10:46,340
هل هي هناك؟

162
00:10:46,340 --> 00:10:47,880
!أودّ رؤيتها

163
00:10:47,880 --> 00:10:48,730
!لنذهب

164
00:10:48,730 --> 00:10:50,290
.لا داعي للعجلة

165
00:10:50,650 --> 00:10:53,660
سينسي، هل علينا تجميع درّاجاتنا الآن؟

166
00:10:53,660 --> 00:10:57,300
.حسنًا، سنعترض طريق المارّة هنا

167
00:10:57,300 --> 00:10:58,770
لماذا لا نذهب إلى حديقة ما؟

168
00:10:58,770 --> 00:11:00,840
!مرحى

169
00:11:03,630 --> 00:11:05,260
.هذا رائع

170
00:11:05,260 --> 00:11:07,310
.إنّها رائعة

171
00:11:07,310 --> 00:11:09,880
.هنالك بعض السّفن الأمريكيّة هناك

172
00:11:09,880 --> 00:11:12,350
فعلاً؟

173
00:11:13,270 --> 00:11:14,860
.حسنًا

174
00:11:14,860 --> 00:11:16,390
.أنا جاهزة

175
00:11:16,390 --> 00:11:18,990
.احرصن على تفقّد كلّ شيء بحذر

176
00:11:19,780 --> 00:11:21,150
.إنّه لا يتزحزح

177
00:11:21,150 --> 00:11:23,280
.أنا على ما يرام أيضًا

178
00:11:23,280 --> 00:11:27,160
.انظرن هنا يا فتيات

179
00:11:30,240 --> 00:11:32,110
ما رأيكنّ؟

180
00:11:32,110 --> 00:11:34,350
.تبدين رائعة يا ساندي

181
00:11:34,350 --> 00:11:36,520
متى جهّزتِ زيّك؟

182
00:11:36,520 --> 00:11:39,090
.سمحت لي توموي باستعارته

183
00:11:39,090 --> 00:11:41,710
.جهّزت يويكا واحدًا احتياطيًّا

184
00:11:41,710 --> 00:11:45,300
.فعلاً؟ هذا رائع يا ساندي

185
00:11:45,300 --> 00:11:46,810
.نعم

186
00:11:46,810 --> 00:11:49,220
.سينسي، نحن جاهزات

187
00:11:49,220 --> 00:11:50,930
.لننطلق

188
00:11:50,930 --> 00:11:52,520
هل تحتاج أيّ واحدة منكنّ
لاستعمال دورة المياه؟

189
00:11:53,200 --> 00:11:54,660
.أظنّني بخير

190
00:11:54,660 --> 00:11:55,570
.وأنا أيضًا

191
00:11:58,970 --> 00:12:02,000
.دعنني أخبركنّ شيئًا عن التّجوال

192
00:12:02,000 --> 00:12:04,280
أوّلاً، اذهبن لدورة المياه دائمًا
.عندما تستطعن ذلك

193
00:12:05,400 --> 00:12:08,970
إن أردتنّ قضاء حاجتكنّ فجأة، فلا يوجد ما
.يضمن أنكنّ ستكنّ قادرات على ذلك في الحال

194
00:12:08,970 --> 00:12:12,770
،قد تكنّ قادرات على ذلك في المناطق الحضريّة
،لكن إن كنتنّ في الجبال أو الشّاطئ

195
00:12:12,770 --> 00:12:14,830
.فقد لا تتمكّنّ من العثور على دورة للمياه في الحال

196
00:12:14,830 --> 00:12:16,250
.معك حقّ

197
00:12:16,250 --> 00:12:17,750
.وهنالك أمر آخر

198
00:12:18,130 --> 00:12:22,220
.اشترين سوائل بقدر الإمكان، وقتما استطعتنّ

199
00:12:22,220 --> 00:12:26,480
لا يمكنكنّ الحصول على المزيد
.وقتما تحتجنه مثل دورة المياة تمامًا

200
00:12:26,480 --> 00:12:29,340
،ليست هنالك متاجر في الجبال غير المأهولة

201
00:12:29,340 --> 00:12:31,180
.وتكون آلات البيع معطّلة أحيانًا

202
00:12:31,580 --> 00:12:34,640
من المهمّ حمل ما يكفي معكنّ دائمًا
.لتتمكّن من الشّرب وقتما تشأن

203
00:12:38,610 --> 00:12:40,220
...فـ-في الحقيقة

204
00:12:40,220 --> 00:12:41,600
.سأذهب إلى دورة المياه

205
00:12:41,600 --> 00:12:42,720
.وأنا أيضًا

206
00:12:42,720 --> 00:12:44,370
.سأذهب لشراء بعض المشروبات

207
00:12:44,370 --> 00:12:45,380
.لنذهب معًا

208
00:12:46,240 --> 00:12:49,990
.إنّنا الآن جاهزات لنبدأ جولتنا في شبه جزيرة ميورا

209
00:12:49,990 --> 00:12:51,190
!أجل

210
00:13:00,110 --> 00:13:01,760
.إنّنا نركب الدّرّاجات في المدينة

211
00:13:19,550 --> 00:13:21,480
.إنّها أشبه بجنّة استوائيّة

212
00:13:26,450 --> 00:13:29,240
أعلم. لماذا لا نحاول تشكيل قطار؟

213
00:13:30,000 --> 00:13:32,560
كما فعلنا خلال السّباق اللّيليّ؟

214
00:13:32,560 --> 00:13:35,320
.نعم. إنّها فرصة جيّدة لمراجعة ذلك

215
00:13:42,130 --> 00:13:44,200
.تبدون في حالة جيّدة

216
00:13:44,200 --> 00:13:46,760
.سنقوم بقيادة المجموعة بالدّور ونحن نتجوّل

217
00:13:46,760 --> 00:13:47,670
.حسنًا

218
00:14:05,990 --> 00:14:07,980
.لقد فعلناها يا فتيات

219
00:14:07,980 --> 00:14:10,520
.نعم، أظنّنا تدبّرنا أمرنا بشكل جيّد

220
00:14:10,520 --> 00:14:12,040
عمّاذا تتحدّثين؟

221
00:14:12,040 --> 00:14:14,870
.كان الوضع صعبًا للغاية أثناء قيادة ساندي

222
00:14:15,180 --> 00:14:17,800
لقد واصلت التّقدّم للأمام دون
.أخذ القطار بعين الاعتبار

223
00:14:17,800 --> 00:14:21,130
.أنتنّ ضعيفات فحسب

224
00:14:21,670 --> 00:14:23,800
.كلاّ، أنت من تسرعين كثيرًا

225
00:14:23,800 --> 00:14:26,380
.حسنًا. لنتمرّن ثانية

226
00:14:26,380 --> 00:14:30,260
.انظرن هناك. لقد بدأنا من هناك

227
00:14:30,260 --> 00:14:32,170
.ماذا؟ المكان بعيد للغاية

228
00:14:32,170 --> 00:14:36,100
كم هذا مفاجئ. لا أصدّق
.أنّنا قطعنا كلّ تلك المسافة

229
00:14:36,100 --> 00:14:39,060
.لقد قطعنا كلّ تلك المسافة في لمح البصر

230
00:14:39,060 --> 00:14:42,230
.متسابقات الطُّرق رائعة فعلاً

231
00:14:45,290 --> 00:14:47,730
التّجوال ممتع، أليس كذلك؟

232
00:14:47,730 --> 00:14:49,360
أليس كذلك؟ أليس كذلك؟ أليس كذلك؟

233
00:14:49,360 --> 00:14:52,310
كم قضينا من الوقت لنصل إلى هنا؟

234
00:14:52,310 --> 00:14:54,330
.لا تقلقي بشأن ذلك كثيرًا

235
00:14:54,670 --> 00:14:58,890
.نسيان الوقت والتّساهل يجعلان التّجوال ممتعًا

236
00:14:59,790 --> 00:15:00,930
.معك حقّ

237
00:15:02,150 --> 00:15:04,040
.هناك، يمكنني رؤية جبل فوجي

238
00:15:04,040 --> 00:15:05,350
أين؟ أين؟

239
00:15:05,350 --> 00:15:06,650
.هناك

240
00:15:06,650 --> 00:15:08,190
.معك حقّ

241
00:15:08,190 --> 00:15:10,640
.يبدو أصغر حجمًا ممّا يبدو عليه في كاماكورا

242
00:15:10,640 --> 00:15:13,360
.لكنّ جبل فوجي جميل سواء كان صغيرًا أم كبيرًا

243
00:15:14,750 --> 00:15:17,600
.أرغب بتسلّق جبل فوجي يومًا ما

244
00:15:17,600 --> 00:15:18,840
.هذه فكرة رائع

245
00:15:18,840 --> 00:15:21,310
.يمكننا ركوب درّاجاتنا حتّى المحطّة الخامسة

246
00:15:21,310 --> 00:15:25,110
قد يكون ركوب الدّرّاجات إلى هناك
.والمواصلة على الأقدام بعدها ممتعًا

247
00:15:26,270 --> 00:15:28,780
.سوف تنفد منّي قوّتي هذه المرّة

248
00:15:28,780 --> 00:15:31,430
.لنقم بالأمر معًا يا فويوني-سان

249
00:15:31,430 --> 00:15:34,620
.ماذا؟ ليتني أستطيع ذلك

250
00:15:34,620 --> 00:15:36,500
أيّ نوع من الأجوبة هو هذا؟

251
00:15:40,000 --> 00:15:42,790
.النّزول سهل للغاية

252
00:15:43,480 --> 00:15:45,850
.أراكنّ في الأسفل يا فتيات

253
00:15:46,520 --> 00:15:48,840
!مهلاً يا فويوني-سان

254
00:15:48,840 --> 00:15:50,730
ماذا؟

255
00:15:51,780 --> 00:15:53,590
.لا تسرعي أكثر

256
00:15:53,590 --> 00:15:56,890
،تزداد سرعتك بينما تنزلين
.وهذا قد يكون خطيرًا

257
00:15:56,890 --> 00:15:57,810
.هذا موجّه لكُنّ أيضًا

258
00:15:58,460 --> 00:16:02,110
.ستزداد سرعتكنّ أكثر ممّا تعتقدن في النّزول

259
00:16:02,110 --> 00:16:06,190
،إن سقطتنّ وأنتنّ تركبن بتلك السّرعة
.فقد تتعرّضن لإصابات خطيرة

260
00:16:07,980 --> 00:16:09,570
!سنكون حذرات

261
00:16:11,780 --> 00:16:13,480
.إنّه نفق

262
00:16:14,280 --> 00:16:17,740
بما أنّ الطّريق ضيّقة في الأنفاق
،ونركب على مقربة من السّيّارات

263
00:16:17,740 --> 00:16:19,450
.فأنا لا أحبّ ذلك كثيرًا

264
00:16:19,450 --> 00:16:21,290
.الأنفاق صخبة ومليئة بالصّدى أيضًا

265
00:16:21,290 --> 00:16:23,200
.معك حقّ

266
00:16:23,200 --> 00:16:24,890
.لنعبره بسرعة

267
00:16:24,890 --> 00:16:25,880
!أجل

268
00:16:34,490 --> 00:16:36,970
.كـ-كان النّفق مخيفًا

269
00:16:36,970 --> 00:16:38,070
.نعم

270
00:16:38,070 --> 00:16:40,390
.ظننتُ أنّ السّيّارات ستدوسني

271
00:16:43,260 --> 00:16:45,010
.هذا حلو

272
00:16:45,010 --> 00:16:46,770
إنّه لذيذ، صحيح؟

273
00:16:46,770 --> 00:16:48,480
أيّ نوع من الشّاي هو هذا؟

274
00:16:48,480 --> 00:16:53,540
يسمّى شاي شيربا. إنّه شاي أسود
.حلو مُعدّ بالعنب البرّيّ

275
00:16:53,540 --> 00:16:56,040
يشربه شعب الشّيربا الّذين يساعدون
.النّاس على تسلّق الجبال أيضًا

276
00:16:56,040 --> 00:16:57,990
.من المفترض أنّه يجدّد طاقة شاربه

277
00:16:57,990 --> 00:17:01,190
.فعلاً؟ تعرفين الكثير عن الشّاي

278
00:17:01,190 --> 00:17:04,710
اعتدنا أنا وأبي على شربه طوال الوقت
.بينما نتجوّل في الجبال

279
00:17:04,710 --> 00:17:07,700
.أنت جيّدة يا ساندي-سان في النّشاطات الخارجيّة

280
00:17:07,700 --> 00:17:09,880
.لا عجب أنّ لديك قدرة احتمال كبيرة

281
00:17:11,040 --> 00:17:15,830
يمكننا رؤية السّاحل المقابل من هنا
.على عكس المحيط الّذي نراه في كاماكورا

282
00:17:17,010 --> 00:17:18,860
هل تلك هي مقاطعة تشيبا؟

283
00:17:18,860 --> 00:17:21,350
.نعم، إنّها شبه جزيرة بوسو

284
00:17:21,350 --> 00:17:24,430
.يوجد أشخاص يعيشون هناك أيضًا

285
00:17:24,430 --> 00:17:25,880
.طبعًا

286
00:17:28,510 --> 00:17:31,280
.أرغب بالذّهاب إلى هناك يومًا ما

287
00:17:32,630 --> 00:17:36,090
.وأبعد حتّى من ذلك

288
00:17:36,550 --> 00:17:37,650
.نعم

289
00:17:37,650 --> 00:17:39,380
.أرغب بالذّهاب أيضًا

290
00:17:48,140 --> 00:17:49,590
.لقد غلبهما النّعاس

291
00:17:50,420 --> 00:17:52,010
.وفويوني-سان أيضًا

292
00:17:52,010 --> 00:17:54,380
.لقد استيقظنا باكرًا هذا الصّباح

293
00:17:54,380 --> 00:17:57,300
.لا أصدّق أنّهنّ قادرات على النّوم في الخارج

294
00:17:59,260 --> 00:18:01,260
.حسنًا، ما باليد حيلة

295
00:18:01,260 --> 00:18:03,050
.لننتظر حتّى يستيقظن

296
00:18:03,050 --> 00:18:03,690
.نعم

297
00:18:08,020 --> 00:18:09,690
.صباح الخير يا فويوني-سان

298
00:18:09,690 --> 00:18:12,260
ماذا؟ كم نمت من الوقت؟

299
00:18:12,260 --> 00:18:13,700
.لحوالي عشر دقائق

300
00:18:13,700 --> 00:18:17,150
.ماذا؟ شعرتُ أنّي نمت لوقت أطول

301
00:18:18,080 --> 00:18:20,680
هل ارتفعت الشّمس أكثر؟

302
00:18:20,680 --> 00:18:22,920
.أصبح الجوّ أكثر دفئًا

303
00:18:22,920 --> 00:18:24,720
.إنّه مناسب تمامًا للتّجوال

304
00:18:27,660 --> 00:18:28,950
.لقد استيقظتا أيضًا

305
00:18:28,950 --> 00:18:31,790
.تومو-تشان، أنا جائعة

306
00:18:31,790 --> 00:18:34,910
ماذا؟ هل تناولت فطورك؟

307
00:18:34,910 --> 00:18:37,160
.تناولت بعض الزّبادي

308
00:18:37,160 --> 00:18:38,860
.ظننتُ أنّي سأتأخّر

309
00:18:38,860 --> 00:18:40,180
.هذا ليس جيّدًا

310
00:18:40,180 --> 00:18:43,260
.ماذا؟ سينسي ليست هنا

311
00:18:43,260 --> 00:18:45,310
هل ذهبت لدورة المياه؟

312
00:18:45,310 --> 00:18:47,020
...في الحقيقة

313
00:18:47,990 --> 00:18:48,950
ماذا؟

314
00:18:48,950 --> 00:18:51,520
.سوف توقظينهنّ

315
00:18:51,520 --> 00:18:56,110
.لكن لا يمكننا الذّهاب إلى ميساكي من دونك

316
00:18:56,110 --> 00:18:58,380
.هذا مستحيل

317
00:18:58,380 --> 00:19:02,410
لكنّ الأمر ليس ممتعًا إن سحبتكنّ
طوال الوقت، صحيح؟

318
00:19:02,410 --> 00:19:05,150
.هذا نشاطُ ناديكنّ

319
00:19:05,150 --> 00:19:09,120
ألا تعتقدان أنّ إضاعة طريقكنّ معًا
ستكون تجربة جيّدة؟

320
00:19:09,900 --> 00:19:12,770
لكن... أليس كذلك؟

321
00:19:12,770 --> 00:19:13,380
.نعم

322
00:19:13,380 --> 00:19:18,450
.حسنًا، إن واجهتنّ مشكلة عويصة، اتّصلا بي

323
00:19:18,450 --> 00:19:20,060
.سأوافيكنّ في الحال

324
00:19:21,130 --> 00:19:23,560
.لذلك تركتنا

325
00:19:25,950 --> 00:19:28,850
هل سنكون بخير؟

326
00:19:31,170 --> 00:19:32,690
.لنذهب يا فتيات

327
00:19:33,390 --> 00:19:35,170
.لقد قطعنا كلّ هذه المسافة

328
00:19:35,170 --> 00:19:36,390
.لا يسعنا إلاّ التّقدّم الآن

329
00:19:36,390 --> 00:19:38,650
لا يمكن للدّرّاجات الرّجوع للخلف، صحيح؟

330
00:19:47,000 --> 00:19:48,710
.هذه هي هيرومي

331
00:19:51,250 --> 00:19:52,740
هل ننطلق؟

332
00:19:52,740 --> 00:19:54,420
.لنركب إلى ميساكي

333
00:19:54,420 --> 00:19:55,820
.لنفعل ذلك

334
00:19:55,820 --> 00:19:58,180
.لننطلق إلى خطّ النّهاية

335
00:19:58,180 --> 00:20:00,010
.نعم، معًا

336
00:20:00,320 --> 00:20:02,100
!أجل

337
00:21:36,150 --> 00:21:40,200
منظر درّاجات الطّريق بكامل المعدّات يجعل
.المرء يرغب بالشّروع في ركوبها من الغد

338
00:21:40,200 --> 00:21:43,250
.فقرة جانبيّة: أوّل نادٍ للدّرّاجات

339
00:21:44,780 --> 00:21:47,380
سوف نتّجه إلى إنوشيما بينما نتوقّف
في أماكن معيّنة في طريقنا

340
00:21:47,380 --> 00:21:49,990
.في أوّل جولاتنا على الدّرّاجات في كاماكورا

341
00:21:50,550 --> 00:21:55,420
انطلقنا في آخر مرّة من محطّة كاماكورا
.واستمتعنا بضريح كوتوكو-إن

342
00:21:55,420 --> 00:21:56,860
...ووجهتنا التّالية هي

343
00:21:57,590 --> 00:21:59,930
إنّها شرفة تطلّ على المحيط

344
00:21:59,930 --> 00:22:03,000
.حيث يمكن تناول الحلويّات من مقهى أنيق للغاية

345
00:22:01,520 --> 00:22:03,360
.أنا أحبّ الحلويّات كثيرًا! أريد بعضها

346
00:22:03,360 --> 00:22:03,950
أتريدين الذّهاب؟

347
00:22:03,950 --> 00:22:08,630
.وجهتنا هذه المرّة هو مقهى أنيق يقدّم الحلويّات

348
00:22:09,240 --> 00:22:12,640
.حان وقت الانطلاق

349
00:22:13,170 --> 00:22:17,050
سوف نركب الدّرّاجات بمحاذاة
.ساحل شيتشيريغاهاما

350
00:22:19,810 --> 00:22:21,400
.إنّه المحيط

351
00:22:21,840 --> 00:22:23,290
.مذهل

352
00:22:24,100 --> 00:22:27,650
.هذا المكان يُدعى إيناموراغاساكي

353
00:22:27,650 --> 00:22:29,680
.إنّ إنوشيما من ذلك الطّريق

354
00:22:29,680 --> 00:22:32,730
.إنّها إنوشيما. يمكنني رؤية إنوشيما

355
00:22:34,450 --> 00:22:38,710
،إن كان الجوّ جيّدًا كفاية
.يمكن رؤية جبل فوجي بوضوح

356
00:22:38,730 --> 00:22:41,440
.لنتوقّف هنا

357
00:22:41,440 --> 00:22:42,150
.حسنًا

358
00:22:42,150 --> 00:22:43,260
.لم نرك من مدّة

359
00:22:44,110 --> 00:22:45,260
.حسنًا

360
00:22:45,260 --> 00:22:50,500
،سنستدير عند إشارة يوكيايباشي
.وسنجد المتجر الّذي نتّجه نحوه هناك

361
00:22:51,960 --> 00:22:53,290
.استعدّي للمفاجأة

362
00:22:53,290 --> 00:22:53,870
هل وصلنا؟

363
00:22:53,870 --> 00:22:54,900
!ها هو ذا

364
00:22:56,590 --> 00:22:57,720
.يا للأناقة

365
00:22:57,720 --> 00:22:58,290
أليست كذلك؟

366
00:22:58,290 --> 00:22:59,510
.نعم، إنّه رائع

367
00:22:59,510 --> 00:23:00,270
.نعم

368
00:23:00,590 --> 00:23:05,310
،هذا هو مقهى أمالفي
.المحلّ الّذي كان عليّ زيارته

369
00:23:05,310 --> 00:23:10,280
إنّه يجعل المرء يشعر
.وكأنّه على ساحل أمالفي الإيطاليّ

370
00:23:12,110 --> 00:23:14,750
.حلويّاتهم رائعة أيضًا

371
00:23:14,750 --> 00:23:16,160
طبقهم الأكثر شعبيّة

372
00:23:16,160 --> 00:23:19,900
هو تحلية تقليديّة تقدّم مع قشدة
،بنكهة اللّيمون المنعشة

373
00:23:19,900 --> 00:23:21,470
.ديليزي أل ليموني

374
00:23:22,250 --> 00:23:24,740
،بعد إتعاب جسدي بركوب الدّرّاجة

375
00:23:24,740 --> 00:23:27,130
.من الرّائع أن أملأه بشيء حلو

376
00:23:27,130 --> 00:23:28,050
.نعم

377
00:23:28,510 --> 00:23:31,290
لماذا لا تزورون المكان؟