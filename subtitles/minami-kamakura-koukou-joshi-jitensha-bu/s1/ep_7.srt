1
00:00:00,560 --> 00:00:03,250
.تبدو درّاجتك في وضع جيّد

2
00:00:03,250 --> 00:00:04,580
.لنبدأ معًا

3
00:00:04,580 --> 00:00:05,940
.إنّها على حقّ

4
00:00:05,940 --> 00:00:07,400
فويوني-تشان؟

5
00:00:07,400 --> 00:00:11,530
هل تظنّين أنّنا قاسيات القلب لذلك الحدّ؟

6
00:00:15,990 --> 00:00:18,870
هل جميعكنّ جاهزات؟

7
00:00:18,870 --> 00:00:21,330
.نعم

8
00:00:21,330 --> 00:00:23,210
.أنا جاهزة دائمًا

9
00:00:23,920 --> 00:00:24,790
.لننطلق

10
00:02:06,160 --> 00:02:10,060
.سباق مينامي كاماكورا اللّيليّ بدأ أخيرًا

11
00:02:10,060 --> 00:02:14,780
يجري حاليًّا سباق حامٍ بين فئة
.المبتدئين على المضمار

12
00:02:15,230 --> 00:02:20,240
هنالك مجموعة من تلميذات السّنة الأولى في مقدّمة
.السّباق يقودهنّ السّيّد دبّ من نادي الكوسبلاي

13
00:02:20,240 --> 00:02:23,200
.وتوجد خلفها مجموعة تلميذات السّنة الثّانية

14
00:02:23,700 --> 00:02:28,160
.وتتبعها مجموعة السّنة الثّالثة ونادي الدّرّاجات

15
00:02:28,500 --> 00:02:33,090
هل ستكنّ قادرات على اللّحاق بالبقيّة؟

16
00:02:33,090 --> 00:02:35,050
!يمكنكنّ النّجاح يا نادي الدّرّاجات

17
00:02:36,780 --> 00:02:38,090
!انطلقن

18
00:02:42,520 --> 00:02:44,400
.لا يمكننا رؤيتهنّ بعد الآن

19
00:02:44,400 --> 00:02:45,930
.إنّهنّ يركبن متسابقات طرق

20
00:02:46,400 --> 00:02:50,410
.ما باليد حيلة. لا يمكننا اللّحاق بهنّ طوال الوقت

21
00:02:50,410 --> 00:02:52,150
.دعي ذلك الأمر لي

22
00:02:52,150 --> 00:02:53,750
سابايا-سان؟

23
00:02:53,750 --> 00:02:58,820
.تقوم شركة أوتوتو للإلكترونيّات ببثّ هذا السّباق

24
00:02:58,820 --> 00:03:02,280
...وهذا هو السّلاح السّرّيّ لهذا اليوم

25
00:03:07,100 --> 00:03:09,750
!طائرة رباعيّة المراوح مصمّمة للتّصوير الجوّيّ

26
00:03:09,750 --> 00:03:11,540
.هذا ليس سيّئًا يا سابايا-سان

27
00:03:12,510 --> 00:03:15,150
.هذا لا شيء

28
00:03:15,840 --> 00:03:19,300
!كفّ عن التّبجّح وأرنا نادي الدّرّاجات بسرعة

29
00:03:19,300 --> 00:03:20,420
!فـ-في الحال

30
00:03:22,760 --> 00:03:24,570
...تحديق

31
00:03:25,060 --> 00:03:26,570
...ضغط كثير

32
00:03:26,570 --> 00:03:29,110
أسرع. ألم تجدهنّ بعد؟

33
00:03:29,110 --> 00:03:30,170
!وجدتهنّ

34
00:03:33,430 --> 00:03:34,310
.هؤلاء هنّ

35
00:03:35,770 --> 00:03:38,700
أين الرّاكبات اللاّتي كنّ أمامنا؟

36
00:03:38,700 --> 00:03:40,810
.لم نر أيّ أحد منذ مدّة

37
00:03:40,810 --> 00:03:43,660
ربّما تكوننَّ في الجانب المعاكس
.من صالة نادي الفنون القتاليّة

38
00:03:43,660 --> 00:03:46,620
.سينتهي السّباق إن لم نلحق بهنّ قريبًا

39
00:03:46,940 --> 00:03:50,910
ولكن إن بذلنا كلّ مجهودنا
.في الرّكوب الآن، فلن نبلغ النّهاية

40
00:03:50,910 --> 00:03:53,950
.لن نلحق بهنّ بأسلوبنا هذا

41
00:03:53,950 --> 00:03:56,780
ماذا؟ ما الّذي علينا أن نفعله إذًا؟

42
00:03:56,780 --> 00:04:00,970
.فويوني-سان على حقّ. علينا أن نهاجم

43
00:04:03,710 --> 00:04:06,510
.يا رفيقات، سأركب في المقدّمة. اتبعوني

44
00:04:07,710 --> 00:04:09,820
.ابدأن بالتّعوّد على وتيرة السّباق والمضمار

45
00:04:09,820 --> 00:04:11,770
.سأقود المجموعة حتّى ذلك الحين

46
00:04:12,800 --> 00:04:15,140
.معك حقّ. قد ينجح ذلك

47
00:04:15,140 --> 00:04:16,680
.نعتمد عليك يا ناتسومي

48
00:04:16,680 --> 00:04:17,400
.شكرًا لك

49
00:04:18,900 --> 00:04:19,900
.لننطلق إذًا

50
00:04:26,240 --> 00:04:26,980
ما هذا؟

51
00:04:26,980 --> 00:04:29,000
.هنالك مشاكل على المضمار

52
00:04:29,000 --> 00:04:32,240
اشتبكت درّاجات مجموعة من تلميذات
.السّنة الثّانية وتوقّفن على المسار

53
00:04:32,240 --> 00:04:38,450
يبدو أنّهنّ قد اصطدمن ببعضهنّ عند دخولهنّ
.الزّاوية دون إفساح مساحة كافية لبعضهنّ

54
00:04:38,450 --> 00:04:39,830
هل هنّ غبيّات؟

55
00:04:40,420 --> 00:04:41,860
!المجموعة التّالية من الرّاكبين قادمة

56
00:04:41,860 --> 00:04:43,670
!أفسحن المضمار

57
00:04:44,360 --> 00:04:46,300
.إنّهنّ أسرع ممّا اعتقدت

58
00:04:46,610 --> 00:04:48,440
.هيروكو، علينا أن نسرع

59
00:04:48,440 --> 00:04:49,560
.انتظري قليلاً

60
00:04:50,040 --> 00:04:51,270
!نحن قادمات

61
00:04:53,550 --> 00:04:54,520
...أزوما-سينباي

62
00:04:54,520 --> 00:04:56,360
.بالتّوفيق

63
00:04:57,030 --> 00:04:59,040
لماذا سمحت لهنّ بالمرور؟

64
00:04:59,040 --> 00:05:00,600
أليس الأمر واضحًا؟

65
00:05:02,250 --> 00:05:04,950
.من الممتع أكثر تجاوز الآخرين من الخلف

66
00:05:07,110 --> 00:05:08,980
لماذا شعرت بالبرد فجأة؟

67
00:05:08,980 --> 00:05:10,160
.يا رفيقات

68
00:05:10,160 --> 00:05:11,940
.نحن في الممرّ المستقيم قبل خطّ النّهاية

69
00:05:11,940 --> 00:05:13,870
بينما كانت تلميذات السّنة الثّانية
،يواجهن بعض المشاكل

70
00:05:13,870 --> 00:05:18,450
،نرى أنّ نادي الدّرّاجات الّذي بدأ بداية بطيئة
كان ثاني مجموعة تدخل الممرّ المستقيم

71
00:05:18,450 --> 00:05:20,860
.قبل خطّ النّهاية بعد مجموعة السّنة الأولى

72
00:05:20,860 --> 00:05:23,090
!انطلقن يا فتيات

73
00:05:23,750 --> 00:05:25,710
هل تعرفن ما تفعلنه يا فتيات؟

74
00:05:25,710 --> 00:05:30,340
ستكون كيفية تعاملكنّ مع هذا الممرّ
.المستقيم أهمّ جزء في هذا السّباق

75
00:05:32,600 --> 00:05:35,850
يا رفيقات، هل تتذكّرن نصيحة شيكي-سينسي؟

76
00:05:36,170 --> 00:05:37,980
ماذا قالت؟

77
00:05:37,980 --> 00:05:39,530
.كانت تلك

78
00:05:39,530 --> 00:05:41,450
.تقصد طريقة ركوبنا على شكل خطّ منفرد

79
00:05:41,450 --> 00:05:42,590
.صحيح

80
00:05:42,590 --> 00:05:44,230
مقاومة الرّياح؟

81
00:05:44,230 --> 00:05:45,350
.نعم

82
00:05:45,350 --> 00:05:50,200
ألا تشعرن أنّ الرّياح تشبه جدارًا ما
أحيانًا وأنتنّ تركبن الدّرّاجات؟

83
00:05:50,200 --> 00:05:51,560
.معك حقّ

84
00:05:51,560 --> 00:05:56,330
كلّما حاولنا الرّكوب بسرعة، يصبح الأمر
.أشبه بالرّكوب تحت الماء أكثر فأكثر

85
00:05:56,810 --> 00:05:58,600
.تلك هي مقاومة الرّياح

86
00:05:58,600 --> 00:06:00,540
.إنّها أسوأ أعداء راكبي الدّرّاجات

87
00:06:00,540 --> 00:06:04,820
.سوف تواجهن وطأة تأثيراته إن ركبتنّ بمفردكنّ

88
00:06:04,820 --> 00:06:07,260
.لكنّ الأمر يختلف تمامًا إن ركبتنّ كمجموعة

89
00:06:07,780 --> 00:06:10,950
،بما أنّ القائد يدفع جدار الرّياح جانبًا

90
00:06:10,950 --> 00:06:13,220
.فإنّ الوضع يكون أسهل على بقيّة الرّاكبين خلفه

91
00:06:13,720 --> 00:06:17,230
يمكنكنّ هزيمة الرّياح عن طريق الرّكوب
...كمجموعة فيما يعرف باسم

92
00:06:17,230 --> 00:06:18,490
!القطار

93
00:06:19,090 --> 00:06:21,150
...الرّكوب كخطّ منفرد

94
00:06:26,290 --> 00:06:27,780
...سوف أصطدم بها

95
00:06:27,780 --> 00:06:29,320
...مايهارو-سان

96
00:06:29,670 --> 00:06:31,730
.ليس عليك أن ترغمي نفسك على البقاء قريبة هكذا

97
00:06:31,730 --> 00:06:35,320
.لنترك مسافة بيننا بما أنّ هذا هو أوّل قطار لنا

98
00:06:35,320 --> 00:06:37,580
.سيكون ذلك فعّالاً في كلّ الأحوال

99
00:06:37,580 --> 00:06:38,500
!أ-أجل

100
00:06:46,370 --> 00:06:49,880
.هذا رائع. لا أصدّق أنّ مقاومة الرّياح قد اختفت

101
00:06:50,900 --> 00:06:52,640
.هذا هو القطار

102
00:06:54,270 --> 00:06:57,060
.أنا لا أفهم ما يجري بالفعل، ولكنّ الأمر ينجح

103
00:06:59,940 --> 00:07:02,120
.ما الّذي يحدث؟ إنّهنّ سريعات

104
00:07:02,120 --> 00:07:04,220
هل درّاجاتهنّ أفضل من درّاجاتنا لتلك الدّرجة؟

105
00:07:04,220 --> 00:07:06,020
.ميكاكو، لنزد من سرعتنا

106
00:07:07,140 --> 00:07:08,890
.كنتِ على حقّ يا هيروكو

107
00:07:08,890 --> 00:07:12,280
.اللّحاق بشخص وتجاوزه يجعل السّباق أكثر متعة

108
00:07:12,740 --> 00:07:14,280
!لننطلق يا ميكاكو

109
00:07:14,280 --> 00:07:14,870
!في الحال

110
00:07:15,370 --> 00:07:17,330
!لنفز بهذا السّباق

111
00:07:17,330 --> 00:07:19,880
.يدخل السّباق دورته الثّالثة

112
00:07:19,880 --> 00:07:22,330
.تتقدّم مجموعة تلميذات السّنة الأولى السّباق

113
00:07:22,710 --> 00:07:26,170
يلحق نادي الدّرّاجات بها عن طريق
.الرّكوب قريبات من بعضهنّ

114
00:07:26,170 --> 00:07:30,310
أصبحت مجموعة السّنة الثّانية
.الّتي خلفهنّ متشتّتة بالكامل

115
00:07:30,310 --> 00:07:31,940
.بقيت ثمانية دورات

116
00:07:31,940 --> 00:07:35,510
أيّ نوع من التّطوّر ينتظرنا؟

117
00:07:35,510 --> 00:07:37,880
.واصلن يا رفيقات

118
00:07:37,880 --> 00:07:40,270
.فكّرن في نصائح شيكي-سينسي الأخرى

119
00:07:40,700 --> 00:07:44,350
...نصائحها الأخرى؟ أظنّ أنّها كانت

120
00:07:45,160 --> 00:07:47,360
.أدرن دوّاساتكنّ بدل الدّوس عليها

121
00:07:47,830 --> 00:07:49,860
ندير الدّوّاسات؟

122
00:07:49,860 --> 00:07:52,240
أليس ذلك واضحًا؟

123
00:07:52,240 --> 00:07:58,550
أأنت واثقة؟ ما الّذي تفعلينه عندما تريدين
الرّكوب بسرعة أو تسلّق التّلال؟

124
00:07:58,550 --> 00:08:00,300
.أدوس عليها بكلّ قوّتي

125
00:08:00,300 --> 00:08:01,500
أتقفين وتدوّسين؟

126
00:08:02,210 --> 00:08:06,990
،ينفع هذا لزيادة السّرعة في الحال

127
00:08:06,990 --> 00:08:10,340
لكن ستكنّ قادرات على الحفاظ
على قوّتكنّ لوقت أطول في النّهاية

128
00:08:10,340 --> 00:08:15,490
.عن طريق تخيّل أنفسكنّ وكأنّكنّ تدرن الدّوّاسات

129
00:08:16,010 --> 00:08:18,600
...نديرها بدل أن ندوس عليها

130
00:08:21,270 --> 00:08:26,150
تدويسهنّ مقبول. إنّه جيّد بما أنّهنّ
.بدأن بالتّدريب حديثًا

131
00:08:26,550 --> 00:08:29,820
.إنّهنّ لسن سيّئات بالنّظر إلى أنّهن مبتدئات

132
00:08:29,820 --> 00:08:31,360
.بل السّبب هو أنّهنّ مبتدئات

133
00:08:32,440 --> 00:08:36,070
.لا أحد جيّد في شيء ما وهو في بدايته

134
00:08:36,070 --> 00:08:40,350
.لكنّهن يردن أن يكنّ أفضل لأنّهنّ لسن جيّدات

135
00:08:40,920 --> 00:08:46,250
،أنا واثقة أنّهنّ سيقترفن الكثير من الأخطاء
،لكن ببذلهنّ كلّ ما لديهنّ لمواجهة التّحدّيّات

136
00:08:46,250 --> 00:08:50,050
.سيتعلّمن حدود ومدى قدراتهنّ شيئًا فشيئًا

137
00:08:50,650 --> 00:08:53,350
.وذلك ممتع للغاية

138
00:08:53,350 --> 00:08:54,390
.معك حقّ

139
00:08:58,930 --> 00:09:00,870
.إنّهنّ يخلقن جوًا مسلّيًا

140
00:09:01,730 --> 00:09:03,640
...ربّما، ولكن

141
00:09:03,640 --> 00:09:08,730
يساورني الفضول بشأن المجموعة الّتي
.تحافظ على تقدّمها أمام نادي الدّرّاجات

142
00:09:08,730 --> 00:09:10,560
تقصدين تلميذات السّنة الثّالثة؟

143
00:09:10,560 --> 00:09:12,360
إنّهنّ مخيفات نوعًا ما، صحيح؟

144
00:09:12,360 --> 00:09:14,830
تشكّل الفتيات الثّلاثة في المقدّمة جدارًا

145
00:09:14,830 --> 00:09:17,360
.لتقليل العبء على الفتيات في الخلف

146
00:09:17,360 --> 00:09:22,580
لكنّي لم أدرك أنّ مدرستنا لديها تلميذات
.يعرفن ما يكفي عن الدّرّاجات للقيام بذلك

147
00:09:22,580 --> 00:09:26,040
.ربّما علّمهنّ أحد ما ذلك

148
00:09:26,810 --> 00:09:28,360
.أنا من علّمهنّ

149
00:09:29,400 --> 00:09:31,310
مـ-مديرة المحلّ؟

150
00:09:31,310 --> 00:09:35,530
لقد كنّ كريمات كفاية لشراء
،ياكيسوبا وعجّة بيض منّي

151
00:09:35,530 --> 00:09:36,680
.لذلك شكرتهنّ بإخباري لهنّ بذلك

152
00:09:37,600 --> 00:09:40,750
لا يجدر بك أن تعلّمي العدوّ أيّ شيء
.قد يمنحه الأفضليّة

153
00:09:40,750 --> 00:09:42,390
.لا تقلقي

154
00:09:42,770 --> 00:09:46,850
لم تكن تلميذات السّنة الثّالثة الوحيدات
.اللاّتي اشترين بضاعتي بسخاء

155
00:09:47,180 --> 00:09:48,810
!هذا لذيذ

156
00:09:48,810 --> 00:09:51,750
يوجد عليها الكثير من البلم المحلّيّ الطّازج

157
00:09:51,750 --> 00:09:54,770
.ومليئة بأوتار البقريّ الممزوجة بالبيض الغنيّ

158
00:09:54,770 --> 00:09:57,230
.هذا البلم وعجّة الأوتار غاية في اللّذّة

159
00:09:58,790 --> 00:10:01,460
،لقد استمتعت مايهارو-تشان كثيرًا بالطّعام

160
00:10:01,460 --> 00:10:04,010
.وعلّمتها شيئًا مميّزًا

161
00:10:04,010 --> 00:10:05,000
شيء مميّز؟

162
00:10:05,000 --> 00:10:09,050
،صحيح. الممرّات المستقيمة في مسار اليوم واضحة

163
00:10:09,050 --> 00:10:10,710
.لكن هنالك الكثير من المنعطفات

164
00:10:11,410 --> 00:10:15,630
طريقة التّعامل مع هذه المنعطفات
.هي جزء مهمّ آخر من هذا السّباق

165
00:10:16,260 --> 00:10:18,840
.التّقليل من السّرعة قبل دخول منعطف ما

166
00:10:18,840 --> 00:10:22,330
البدء من الجزء الخارجيّ والرّكوب تجاه
،الجزء الدّاخليّ للمنعطف

167
00:10:22,330 --> 00:10:23,850
.ثمّ نحو الجزء الخارجيّ ثانية

168
00:10:23,850 --> 00:10:26,740
.وبعدها التّسارع بينما يخرجن من المنعطف

169
00:10:26,740 --> 00:10:30,140
هذه هي تقنيات الإبطاء دخولاً
.والإسراع خروجًا والخروج-دخول-خروج

170
00:10:30,140 --> 00:10:32,020
.إنّها تقنيّات أساسيّة للمنعطف عند الزّوايا

171
00:10:32,020 --> 00:10:37,290
فهمت. لقد لاحظتُ أنّ انعطافهنّ جيّد
.على نحو مفاجئ بالفعل نظرًا لأنّه سباقهنّ الأوّل

172
00:10:37,290 --> 00:10:39,750
.كان تلميحك هو السّبب

173
00:10:39,750 --> 00:10:42,990
ما الّذي تعنينه بتلميح؟
.كانت نصيحة ذات علاقة وطيدة بالسّباق

174
00:10:48,160 --> 00:10:51,880
.الدّورة السّادسة. نحن في منتصف السّباق

175
00:10:52,650 --> 00:10:57,610
.ليس علينا إرغام ناتسومي على سحبنا طوال السّباق

176
00:10:57,610 --> 00:11:01,890
.نعم. علينا ردّ الجميل لها لقاء ما فعلته من أجلنا

177
00:11:02,500 --> 00:11:03,600
!أكيزوكي-سان، أنظري أمامك

178
00:11:05,850 --> 00:11:06,970
!كلاّ

179
00:11:10,880 --> 00:11:13,310
...لقد نجونا

180
00:11:13,820 --> 00:11:17,840
.كان ذلك وشيكًا. كدنا نصطدم بالوسائد

181
00:11:17,840 --> 00:11:21,010
آسفة يا رفيقاتي. هل عليّ أن أبطئ؟

182
00:11:21,010 --> 00:11:25,070
نحن بخير. أعتقد أنّي بدأت أفهم
.ما الّذي كانت تتحدّث عنه مديرة المحلّ

183
00:11:25,070 --> 00:11:26,990
.سأبلي حسنًا في المرّة القادمة

184
00:11:26,990 --> 00:11:29,660
.كما أنّي لا أعتقد أنّه يمكننا أن نبطئ

185
00:11:31,000 --> 00:11:32,830
!أزوما-سينباي

186
00:11:32,830 --> 00:11:35,940
،بينما أبطأ نادي الدّرّاجات قليلاً عند الزّاوية

187
00:11:35,940 --> 00:11:38,550
.قلّلت متقدّمتا مجموعة السّنة الثّانية المسافة بينهنّ

188
00:11:39,410 --> 00:11:42,110
.هيغا-سان، لستِ بحاجة للإبطاء

189
00:11:42,110 --> 00:11:45,900
.بل اتّبعي الطّريقة الّتي ترينها مناسبة

190
00:11:45,900 --> 00:11:48,370
.سوف نسير على خطاك

191
00:11:48,370 --> 00:11:49,470
.حـ-حسنًا

192
00:11:49,470 --> 00:11:52,320
.وسأحتاج لمساعدتك يا فويوني-سان

193
00:11:52,320 --> 00:11:53,690
ماذا؟ مساعدتي؟

194
00:11:54,380 --> 00:11:58,860
نعم. قلت أنّك تثقين بذاكرتك، صحيح؟

195
00:11:59,420 --> 00:12:01,310
.نحن ندخل منتصف السّباق

196
00:12:01,310 --> 00:12:04,870
.ما تزال مجموعة السّنة الأولى في المقدّمة

197
00:12:04,870 --> 00:12:07,700
،وخلفهنّ نادي الدّرّاجات
.يركبن على شكل خطّ منفرد

198
00:12:07,700 --> 00:12:09,790
.إنّهنّ يلحقن بهنّ بسرعة

199
00:12:09,790 --> 00:12:13,920
هل ستكنّ قادرات على اللّحاق بالمجموعة المتقدّمة؟

200
00:12:20,590 --> 00:12:23,130
.نادي الدّرّاجات سريع بالفعل

201
00:12:23,130 --> 00:12:24,590
.سوف يلحقون بنا على هذا المنوال

202
00:12:25,160 --> 00:12:25,630
...دبّ

203
00:12:26,970 --> 00:12:27,820
!دبّ

204
00:12:28,040 --> 00:12:28,560
!سيّد دبّ

205
00:12:28,810 --> 00:12:31,390
!دبّ، دبّ، دبّ

206
00:12:31,390 --> 00:12:33,400
!دبّ

207
00:12:31,390 --> 00:12:34,350
.يتقدّم السّيّد دبّ من نادي الكوسبلاي بسرعة

208
00:12:34,350 --> 00:12:35,990
!انطلقن

209
00:12:34,350 --> 00:12:37,560
هل يحاول البقاء في المقدّمة لبقيّة الدّورات الأربع؟

210
00:12:35,990 --> 00:12:37,560
!افعلن كلّ ما بوسعكنّ لإعادة فتح النّادي

211
00:12:37,560 --> 00:12:40,460
.من هؤلاء؟ إنّهن يبدون متحمّسات كثيرًا

212
00:12:40,460 --> 00:12:42,250
.إنّهنّ نادي الكوسبلاي

213
00:12:42,250 --> 00:12:45,540
من المفترض أنّهنّ ممنوعات
.من المشاركة في الأحداث الخارجيّة

214
00:12:45,540 --> 00:12:48,030
هل مسموح لهنّ المشاركة في هذا السّباق؟

215
00:12:49,310 --> 00:12:53,040
،بما أنّ الحدث يُقام في مدرستنا
.فأظنّ أنّه يمكنهنّ ذلك

216
00:12:53,040 --> 00:12:56,540
.ماذا؟ مجموعة السّنة الثّالثة تتقدّم أيضًا

217
00:12:56,540 --> 00:13:00,050
مجموعة السّنة الثّالثة الّتي كانت
تحافظ على قوّتها حتّى الآن

218
00:13:00,050 --> 00:13:02,800
قد بدأت بالتّقدّم للأمام وتستعمل
تلميذات السّنة الثّانية المتأخّرات

219
00:13:02,800 --> 00:13:04,550
.للتّصدّي للرّياح بينما تواصل التّقدّم

220
00:13:04,550 --> 00:13:08,480
.وكأنّهنّ يتبادلن القطارات واحدة تلو الأخرى

221
00:13:08,480 --> 00:13:11,890
إن واصلن على هذه الوتيرة، فسيلحقن
.بالمجموعة المتقدّمة قبل خطّ النّهاية

222
00:13:12,270 --> 00:13:14,600
.بدأت الأمور تزداد حماسة

223
00:13:15,050 --> 00:13:17,070
.الاستدارة التّالية هي الثّالثة

224
00:13:24,670 --> 00:13:27,230
.سأضغط على الفرامل عند أوّل كوز في اليمين

225
00:13:27,230 --> 00:13:29,670
.سأبدأ بالانعطاف من منتصف الثّاني

226
00:13:29,670 --> 00:13:32,070
.وأتسارع بعد تجاوزي النّور في اليسار

227
00:13:32,070 --> 00:13:33,370
ماذا يا فويوني-سان؟

228
00:13:33,740 --> 00:13:35,830
أتظنّين أنّه بإمكانك تذكّر طريقة ناتسومي-سان؟

229
00:13:36,520 --> 00:13:38,280
.هذا سهل

230
00:13:38,780 --> 00:13:42,700
!دبّ، دبّ، دبّ

231
00:13:42,710 --> 00:13:45,550
.يبتعد السّيّد دبّ شيئًا فشيئًا

232
00:13:45,550 --> 00:13:47,680
.لا يمكننا اللّحاق به الآن

233
00:13:47,680 --> 00:13:49,930
!يمكنكنّ النّجاح يا تلميذات السّنة الأولى

234
00:13:49,930 --> 00:13:51,640
.إنّهنّ نادي الدّرّاجات

235
00:13:52,530 --> 00:13:55,640
.يبدو أنّ تلميذات السّنة الأولى قد التقين ببعضهنّ

236
00:13:55,640 --> 00:13:56,910
.ذلك ما يبدو

237
00:13:56,910 --> 00:13:59,310
ما العمل؟ هل نزيد سرعتنا ونلحق بهنّ؟

238
00:13:59,310 --> 00:14:01,570
.ما زالت أمامنا ثلاث دورات أخرى

239
00:14:01,570 --> 00:14:04,470
علينا التّقليل من المسابقة بيننا
.شيئًا فشيئًا بدل الضّغط على أنفسنا

240
00:14:04,470 --> 00:14:07,280
.لقد لحقنا بمتقدّمتَيْ مجموعة السّنة الثّانية

241
00:14:07,990 --> 00:14:09,110
مجموعة السّنة الثّالثة؟

242
00:14:09,110 --> 00:14:10,480
متى وصلن إلى هنا؟

243
00:14:10,990 --> 00:14:14,450
.أنتما هما محطّتنا التّالية

244
00:14:17,100 --> 00:14:20,130
.تتحرّك المجموعة التّالية بشكل أفضل ممّا ظننت

245
00:14:20,130 --> 00:14:23,480
أتمنىّ أن تتمكّن سيقاهنّ من المواصلة
.لثلاث دورات أخرى

246
00:14:23,480 --> 00:14:27,090
لقد وصلن لهذه المرحلة. علينا أن نثق
.في عملهنّ كفريق الآن

247
00:14:29,400 --> 00:14:32,240
.أزوما-سينباي ومجموعة السّنة الثّالثة تلحقن بنا

248
00:14:32,240 --> 00:14:35,270
على هذا المنوال، لن نكون قادرات
.على البقاء قبلهنّ حتّى خطّ النّهاية

249
00:14:35,810 --> 00:14:38,140
يا رفيقات، أما زالت لديكنّ بعض القوّة؟

250
00:14:38,490 --> 00:14:39,310
.نعم

251
00:14:39,310 --> 00:14:40,520
.القليل

252
00:14:40,850 --> 00:14:45,530
.إذًا ابقين قريبات خلفنا
.أخبريهن بما يجب أن يفعلنه يا فويوني-سان

253
00:14:46,260 --> 00:14:47,400
.دعي الأمر لي

254
00:14:51,470 --> 00:14:53,000
!اضغطن على الفرامل الآن

255
00:14:53,490 --> 00:14:56,410
!قلّدن من أمامكنّ وأمِلن درّاجاتكنّ

256
00:14:56,410 --> 00:14:57,730
!والآن، تسارعن

257
00:15:02,160 --> 00:15:03,940
.فويوني-تشان مذهلة

258
00:15:04,790 --> 00:15:08,010
.إنّ ناتسومي-تشان تسحبنا طوال هذا الوقت أيضًا

259
00:15:09,410 --> 00:15:13,550
عليّ القيام بشيء ما، لكن ماذا يمكنني أن أفعل؟

260
00:15:13,550 --> 00:15:15,220
ماذا يمكنني أن أفعل الآن؟

261
00:15:16,680 --> 00:15:20,710
الرّاكب في المقدّمة قد تجاوز
.البوّابة ودخل دورته التّاسعة

262
00:15:20,710 --> 00:15:23,290
.بقي كيلومتران فقط لبلوغ خطّ النّهاية

263
00:15:23,290 --> 00:15:26,670
ما رأيك في السّباق حتّى الآن أيّتها المديرة؟

264
00:15:26,670 --> 00:15:27,860
...حسنًا

265
00:15:28,890 --> 00:15:32,040
.ما زلت لا أعرف من سيفوز

266
00:15:32,040 --> 00:15:34,240
،لكن لا يهمّ كيف سينتهي

267
00:15:34,600 --> 00:15:38,240
،فما دمن يشعرن أنّهنّ قدّمن كلّ ما لديهنّ

268
00:15:38,660 --> 00:15:42,440
.فأنا واثقة أنّ هذه ستصبح ذكرى مذهلة

269
00:15:43,860 --> 00:15:46,500
.هنالك شيء واحد يمكنني قوله لهنّ الآن

270
00:15:46,500 --> 00:15:50,130
.ابذلن كلّ ما باستطاعتكنّ." هذا كلّ شيء"

271
00:15:54,230 --> 00:15:57,790
دورتان فحسب. عليّ اللّحاق
.بالسّيّد دبّ بطريقة ما

272
00:16:00,350 --> 00:16:01,980
ناتسومي-تشان، هل من خطب ما؟

273
00:16:02,560 --> 00:16:04,400
.كلاّ، ما من خطب

274
00:16:05,130 --> 00:16:07,860
.هذا ليس جيّدًا. بدأت أشعر بالألم

275
00:16:12,380 --> 00:16:13,640
.دورتان فحسب

276
00:16:14,700 --> 00:16:16,570
.أنا بخير. يمكنني أن أنجح

277
00:16:18,280 --> 00:16:21,250
.يا إلهي، إنّهنّ مزعجات

278
00:16:21,250 --> 00:16:25,130
إنّهنّ يستعملننا لصدّ الرّياح
.بينما يستعدن قوّتهنّ

279
00:16:25,670 --> 00:16:27,340
ما العمل يا هيروكو؟

280
00:16:27,340 --> 00:16:29,870
.سنواجه المشاكل لاحقًا إن واصلن اللّحاق بنا

281
00:16:29,870 --> 00:16:34,090
نعم. علينا أن نتخلّص منهنّ في مرحلة ما
.قبل اللّحاق بنادي الدّرّاجات

282
00:16:36,140 --> 00:16:37,790
فويوني-سان، أأنت بخير؟

283
00:16:37,790 --> 00:16:41,850
.بالكاد. لكنّ ساقيّ لم تتشنّجا بعد

284
00:16:41,850 --> 00:16:44,270
.فعلاً؟ لديّ فكرة إذًا

285
00:16:49,210 --> 00:16:51,190
هل ستساعدننا أيضًا يا فتيات؟

286
00:16:52,120 --> 00:16:56,130
،على هذا المنوال، سيلحق بنا من خلفنا
.ولن تحتلّ أيّ منّا المركز الأوّل

287
00:16:56,130 --> 00:17:00,990
لذلك علينا أن نراهن على استراتيجيّة
.قد تمنح إحدانا على الأقلّ الفرصة للفوز

288
00:17:04,340 --> 00:17:06,370
.لا نريد أن ينتهي السّباق هكذا

289
00:17:07,280 --> 00:17:09,440
...لا نعرف ما تخطّطين له

290
00:17:09,440 --> 00:17:12,500
.لكنّنا سنساعد إن كان بمقدورنا فعل أيّ شيء

291
00:17:13,330 --> 00:17:14,340
.شكرًا لكنّ

292
00:17:29,480 --> 00:17:30,520
!الآن

293
00:17:30,520 --> 00:17:33,560
!نادي الصّواريخ يتقدّم

294
00:17:33,560 --> 00:17:36,450
ماذا؟ ما الّذي تفعلنه؟

295
00:17:36,450 --> 00:17:38,660
!هيرومي، هيغا-سان! اتبعانا

296
00:17:39,630 --> 00:17:43,110
.سوف نسحب بأقصى ما لدينا من الآن فصاعدًا

297
00:17:43,110 --> 00:17:44,970
بأقصى ما لديكنّ؟

298
00:17:44,970 --> 00:17:47,420
ما الّذي سيحدث عندما تفقدن قوّتكنّ؟

299
00:17:47,920 --> 00:17:50,670
.سننفصل حينها عن المجموعة

300
00:17:50,980 --> 00:17:51,920
!كلاّ

301
00:17:52,550 --> 00:17:56,950
.الأمر أشبه بالصّاروخ
.يمكن التّخلّص من الإضافات المعزّزة

302
00:17:57,440 --> 00:18:02,390
.لا تقلقا. سنوصلكما إلى المدار مهما كان الثّمن

303
00:18:02,390 --> 00:18:03,940
عمّاذا تتحدّثين؟

304
00:18:03,940 --> 00:18:05,520
!لنصل إلى خطّ النّهاية معًا

305
00:18:05,520 --> 00:18:10,310
.توشك سيقاننا أن تبلغ حدودها للأسف

306
00:18:10,310 --> 00:18:13,530
هذه هي الطّريقة الوحيدة الّتي يمكن
.لنادي الدّرّاجات الفوز بها

307
00:18:13,840 --> 00:18:17,840
.سوف نعهد بكلّ قوّتنا المتبقّية لكما

308
00:18:17,840 --> 00:18:21,240
.هذا هو أفضل خيار لنا الآن

309
00:18:24,020 --> 00:18:25,450
...مايهارو-سان

310
00:18:25,450 --> 00:18:27,400
.لنقم بهذا يا مايهارو-سان

311
00:18:27,400 --> 00:18:28,410
...ناتسومي-تشان

312
00:18:28,940 --> 00:18:31,200
.لن نبلغ المقدّمة أبدًا على هذا الحال

313
00:18:31,200 --> 00:18:33,580
.لنستعر قوّتهنّ

314
00:18:35,600 --> 00:18:37,370
.نعم، مفهوم

315
00:18:38,040 --> 00:18:39,010
!رجاءً يا فتيات

316
00:18:39,010 --> 00:18:42,420
!أوصلننا إلى السّيّد دبّ

317
00:18:44,170 --> 00:18:44,970
!دبّ

318
00:18:44,970 --> 00:18:47,340
!هيّا بنا يا نادي الصّواريخ

319
00:18:47,340 --> 00:18:48,640
!أجل

320
00:18:56,070 --> 00:18:58,050
كيف ابتعدن كثيرًا هكذا؟

321
00:18:58,050 --> 00:19:00,500
.نادي الدّرّاجات يهاجم

322
00:19:00,500 --> 00:19:02,950
.هيروكو، إمّا الآن أو أبدًا

323
00:19:02,950 --> 00:19:03,530
.نعم

324
00:19:09,720 --> 00:19:11,710
.انفصال أولى الرّاكبات

325
00:19:12,940 --> 00:19:14,450
.الباقي منوط بكنّ

326
00:19:14,450 --> 00:19:15,700
.يمكنك الاعتماد علينا

327
00:19:18,420 --> 00:19:20,830
.حظًّا سعيدًا يا نادي الدّرّاجات

328
00:19:20,830 --> 00:19:22,390
.شـ-شكرًا لك

329
00:19:29,160 --> 00:19:31,810
.إنّهنّ ينشئن طريقًا لنا

330
00:19:36,280 --> 00:19:41,990
تبذل تومو-تشان وفويوني-تشان
.كلّ ما لديهما أيضًا

331
00:19:42,850 --> 00:19:44,340
ماذا عنّي؟

332
00:19:44,750 --> 00:19:46,500
ماذا يمكنني أن أفعل؟

333
00:19:49,570 --> 00:19:51,750
ماذا يمكنني أن أفعل؟

334
00:19:51,750 --> 00:19:54,380
كلاّ، بل ماذا عليّ أن أفعل؟

335
00:19:57,050 --> 00:19:58,160
...هذا

336
00:21:36,210 --> 00:21:40,240
منظر درّاجات الطّريق بكامل المعدّات يجعل
.المرء يرغب بالشّروع في ركوبها من الغد

337
00:21:40,230 --> 00:21:43,230
.فقرة جانبيّة: أوّل نادٍ للدّرّاجات

338
00:21:44,480 --> 00:21:48,550
في هذه الفقرة، نقدّم لكم معلومات يجب
مشاهدتها من طرف المبتدئين لركوب الدّرّاجات

339
00:21:48,550 --> 00:21:50,760
...في الفقرة الجانبيّة مع هيروسي يوكي

340
00:21:50,760 --> 00:21:52,950
.وفوكوو يوي

341
00:21:54,390 --> 00:21:58,090
،لا يهمّ ما مدى جودة درّاجتكم
.فهنالك أشياء لا يمكن تجاهلها

342
00:21:58,840 --> 00:22:01,610
"!ماذا؟ لا يوجد هواء"

343
00:22:03,380 --> 00:22:06,840
"!ماذا؟! لقد انثنى مقودي"

344
00:22:07,730 --> 00:22:09,780
"ما العمل؟"

345
00:22:10,860 --> 00:22:16,450
سنتعلّم هذه المرّة طرقًا للصّيانة
.يجب القيام بها قبل ركوب الدّرّاجة

346
00:22:17,350 --> 00:22:21,220
أيّ نوع من الصّيانة تتطلّبه درّاجات الطّرق؟

347
00:22:21,220 --> 00:22:25,590
.هنالك أمور قليلة عليكما التّحقّق منها قبل ركوب الدّرّاجة

348
00:22:25,590 --> 00:22:26,470
قبل ركوب الدّرّاجة؟

349
00:22:26,470 --> 00:22:29,660
.نعم. يجب علينا التّحقّق من ضغط الهواء أوّلاً

350
00:22:29,660 --> 00:22:34,790
سوف تفقد عجلاتكما ضغط الهواء مع
،الوقت حتّى إن لم تركبا درّاجتيكما

351
00:22:34,790 --> 00:22:38,660
لذلك عليكما أن تلمساها للتّحقّق
.من الضّغط بل ركوب الدّرّاجة

352
00:22:38,660 --> 00:22:40,120
.فهمت

353
00:22:40,120 --> 00:22:41,170
.ثمّ ننتقل للنّقطة الثّانية

354
00:22:41,170 --> 00:22:44,100
.تحقّقا من أنّ المقود آمن

355
00:22:44,100 --> 00:22:45,000
آمن؟

356
00:22:44,550 --> 00:22:45,460
.نعم

357
00:22:45,460 --> 00:22:48,470
.أوّلاً، اضغطا بقوّة بشكل عموديّ على المقود

358
00:22:48,470 --> 00:22:50,470
.ثمّ حاولا ليّه لليمين واليسار

359
00:22:50,470 --> 00:22:54,750
،إن لم يكن ثابتًا بشكل آمن
،قد ينثني أو يتسبّب بحوادث

360
00:22:54,750 --> 00:22:56,440
.لذلك من المهمّ التّحقّق أنّه آمن

361
00:22:56,440 --> 00:22:57,180
.فهمت

362
00:22:57,180 --> 00:22:58,180
...أمّا النّقطة الثّالثة

363
00:22:58,180 --> 00:22:58,660
.نعم

364
00:22:58,660 --> 00:23:00,460
.سيكون عليكما التّحقّق من المقعد

365
00:23:00,310 --> 00:23:00,760
.نعم

366
00:23:00,760 --> 00:23:04,410
.أمسكا المقعد واضغطا بقوّة بشكل عموديّ وأفقيّ

367
00:23:04,410 --> 00:23:08,360
،إن سمعتما صوت صلصلة غريبًا
.فعليكما أن تتحقّقا من قوّة العزم

368
00:23:08,360 --> 00:23:10,790
.وأخيرًا، عليكما التّحقّق من السّلسلة

369
00:23:10,820 --> 00:23:11,320
.السّلسلة

370
00:23:10,820 --> 00:23:11,320
.نعم

371
00:23:11,320 --> 00:23:13,240
،إن لم يكن لديكما زيت تشحيم كافٍ

372
00:23:13,240 --> 00:23:16,620
.فستحتكّ الأجزاء المعدنيّة ببعضها وتصدر أصواتًا

373
00:23:16,620 --> 00:23:19,200
،إن أدرتما الدّوّاسات وسمعتما صوت صلصلة

374
00:23:19,200 --> 00:23:20,450
.فقد لا يكون هنالك زيت كافٍ

375
00:23:20,450 --> 00:23:21,150
هذا ليس جيّدًا؟

376
00:23:21,150 --> 00:23:24,260
.لذلك عليكما إضافة المزيد

377
00:23:24,260 --> 00:23:29,220
،إن قمتما بما يمكنكما بشكل دوريّ
،فستدوم درّاجتكما لوقت أطول

378
00:23:27,460 --> 00:23:35,010
في الحلقة القادمة
"وضعيّة الرّكوب الصّحيحة"

379
00:23:29,220 --> 00:23:29,880
.نعم

380
00:23:29,220 --> 00:23:31,900
.لذلك أنصح بالقيام بالصّيانة بشكل دوريّ

381
00:23:31,900 --> 00:23:33,610
.معك حقّ. علينا أن نعتني بدرّاجاتنا جيّدًا

382
00:23:33,610 --> 00:23:35,010
.نعم

383
00:23:35,010 --> 00:23:40,020
في الحلقة القادمة
"!جميعنا معًا"