1
00:00:16,650 --> 00:00:17,760
.حسنًا

2
00:00:17,760 --> 00:00:18,750
.أيّها العمّ

3
00:00:19,370 --> 00:00:21,140
هل يمكنك الاهتمام بهذا؟

4
00:00:21,660 --> 00:00:24,830
.هنالك درّاجة في العلبة السّوداء، لذلك كن حذرًا

5
00:00:29,450 --> 00:00:31,970
.انتهيت من حزم كلّ شيء أيّتها الآنسة الصّغيرة

6
00:00:31,970 --> 00:00:34,540
.لديك الكثير من الأغراض بالفعل

7
00:00:34,540 --> 00:00:36,210
.شكرًا أيّها العمّ

8
00:00:36,210 --> 00:00:38,480
.كما أنّني امرأة راشدة

9
00:00:38,480 --> 00:00:38,890
ماذا؟

10
00:00:39,560 --> 00:00:40,790
...والآن

11
00:00:40,790 --> 00:00:42,350
نادي الدّرّاجات؟

12
00:00:42,350 --> 00:00:44,470
.لنرَ كيف هنّ

13
00:02:19,320 --> 00:02:22,070
ماذا تقصدين بأنّ نادي الدّرّاجات قد حُلّ؟

14
00:02:22,070 --> 00:02:25,040
.لم أكمل كلامي بعد

15
00:02:25,040 --> 00:02:26,660
.أخبرك دائمًا بأن تحسني الإصغاء

16
00:02:29,160 --> 00:02:33,040
.لقد منحتكنّ إذنًا مؤقّتًا فقط لإنشاء النّادي

17
00:02:33,040 --> 00:02:37,090
عليكنّ أن تقدّمن نتائج واضحة بهدف
.أن يتمّ الاعتراف بكنّ كنادٍ رسميّ

18
00:02:37,480 --> 00:02:40,470
ما هذه النّتائج؟

19
00:02:40,470 --> 00:02:42,970
ما الّذي تعنينه بالضّبط؟

20
00:02:42,970 --> 00:02:46,040
.عليكنّ التّفكير بشيء ما من تلقاء أنفسكنّ

21
00:02:46,040 --> 00:02:48,730
.أتوقّع منكنّ أن تقدّمن شيئًا خلال ثلاثة أشهر

22
00:02:48,730 --> 00:02:50,870
ثـ-ثلاثة أشهر؟

23
00:02:50,870 --> 00:02:52,860
!ذلك ليس وقتًا كافيًا

24
00:02:52,860 --> 00:02:56,760
.نعم، كما أنّنا مبتدئات

25
00:02:56,760 --> 00:02:57,610
.نعم

26
00:02:57,610 --> 00:02:59,790
.هذه هي القواعد

27
00:02:59,790 --> 00:03:03,160
سيتمّ اعتباركنّ مجموعة عاديّة
،فحسب دون تقديم نتائج

28
00:03:03,160 --> 00:03:04,980
.وسيُحلّ نادي الدّرّاجات

29
00:03:08,100 --> 00:03:12,420
،علينا تقديم نتائج واضحة
.لكن لا أدري ما الّذي علينا فعله

30
00:03:12,420 --> 00:03:15,750
على الأرجح أنّ ركوب الدّرّاجات
.في الأرجاء لن يكون كافيًا

31
00:03:15,750 --> 00:03:21,020
أو حتّى ركوب الدّرّاجات إلى أماكن
.مختلفة والتمتّع بالمطابخ المحلّية

32
00:03:21,020 --> 00:03:22,570
.نعم

33
00:03:22,570 --> 00:03:25,800
هذه هي الأشياء الّتي علينا
.أن نناقشها مع شيكي-سينسي

34
00:03:26,110 --> 00:03:28,760
بمناسبة ذلك، أين هي؟

35
00:03:28,760 --> 00:03:30,150
ما زالت لم تحضر؟

36
00:03:30,150 --> 00:03:33,350
...قالت أنّها ستأتي، لكن

37
00:03:35,010 --> 00:03:38,010
!استمارات نشاطات النّوادي هذه لا تنتهِ

38
00:03:38,010 --> 00:03:40,510
!هنالك تأمينات ونفقات وجداول زمنيّة

39
00:03:40,510 --> 00:03:42,360
ما الّذي أحتاجه أيضًا؟

40
00:03:42,820 --> 00:03:45,970
.على أيّ حال، علينا شراء درّاجات أوّلاً

41
00:03:45,970 --> 00:03:48,830
.لا يمكننا تقديم أيّ نتائج دون درّاجات

42
00:03:48,830 --> 00:03:52,790
!أعلم، لكنّ المحلّ لم يفتح بعد

43
00:03:53,180 --> 00:03:55,540
ما الّذي يحدث يا تسورو-سان؟

44
00:03:55,540 --> 00:04:00,840
عادت مالكة المحلّ البارحة
.وكان من المفترض أن تفتح اليوم

45
00:04:02,600 --> 00:04:03,730
.ما باليد حيلة

46
00:04:03,730 --> 00:04:05,870
.سيكون علينا العودة غدًا

47
00:04:05,870 --> 00:04:06,850
.صحيح

48
00:04:06,850 --> 00:04:10,570
.أتمنّى أن تعود المالكة قريبًا

49
00:04:10,570 --> 00:04:12,970
ماذا؟ أردتنّ رؤيتي؟

50
00:04:12,970 --> 00:04:13,640
ماذا؟

51
00:04:15,380 --> 00:04:16,740
.أنا هنا

52
00:04:22,390 --> 00:04:24,740
!إنّها ظريفة

53
00:04:24,740 --> 00:04:27,010
.حتّى أنّ لديها أذنيْ قطّة

54
00:04:27,010 --> 00:04:28,340
.وذيل

55
00:04:28,340 --> 00:04:29,570
هل هي حقيقيّة؟

56
00:04:29,570 --> 00:04:31,250
!كفى، توقّفي عن ذلك

57
00:04:31,770 --> 00:04:34,500
.لقد عدت يا مديرة المحلّ

58
00:04:34,500 --> 00:04:36,680
ماذا؟ مديرة المحلّ؟

59
00:04:35,460 --> 00:04:36,680
.أهلاً

60
00:04:36,680 --> 00:04:38,460
.إنّها مجرّد طفلة

61
00:04:38,460 --> 00:04:40,600
!طـ-طفلة؟ كلاّ

62
00:04:40,600 --> 00:04:43,300
!أنا امرأة راشدة! امرأة راشدة تمامًا

63
00:04:43,680 --> 00:04:47,820
.أنا مديرة محلّ "سايكل فلات"، هوجي كوروني

64
00:04:47,820 --> 00:04:49,010
ماذا؟

65
00:04:49,010 --> 00:04:53,890
.لا أصدّق أنّ المديرة فتاة ظريفة وصغيرة

66
00:04:53,890 --> 00:04:56,480
.أخبرتك أنّي امرأة راشدة

67
00:04:56,480 --> 00:04:58,600
من أنتنّ يا فتيات؟

68
00:04:58,600 --> 00:05:02,360
.تبدين كتلميذات من ثانويّة مينامي كاماكورا

69
00:05:02,360 --> 00:05:07,570
هل أنتنّ هنّ نادي الدّرّاجات
الّذي أخبرتني عنه ناغيسا؟

70
00:05:08,410 --> 00:05:10,530
.شكرًا لكم

71
00:05:11,810 --> 00:05:12,790
.فهمت

72
00:05:13,200 --> 00:05:17,030
،إذًا فقد أنشأتنّ نادي درّاجات
.لكنّه معرّض لخطر الحلّ

73
00:05:17,030 --> 00:05:18,210
.نعم

74
00:05:18,870 --> 00:05:21,930
.سمعتُ أنّكنّ أتيتنّ لرؤية الدّرّاجات مرّات عدّة

75
00:05:21,930 --> 00:05:24,050
.آسفة لأنّي أغلقت المحلّ لوقت طويل

76
00:05:24,050 --> 00:05:26,800
.أيّتها المديرة، كنت قلقة عليك

77
00:05:26,800 --> 00:05:31,810
.آسفة، آسفة. لقد تأخّرت بسبب الإعصار في تايوان

78
00:05:31,810 --> 00:05:33,020
.كان عليّ البقاء ليوم إضافيّ

79
00:05:33,430 --> 00:05:35,770
.آسفة لأنّي لم أستطع الاتّصال أيضًا

80
00:05:36,830 --> 00:05:38,020
ما ذلك؟

81
00:05:39,060 --> 00:05:40,460
هذا مذهل، صحيح؟

82
00:05:40,460 --> 00:05:42,610
.اشتريته من حيّ الإلكترونيّات هناك

83
00:05:42,610 --> 00:05:44,820
ماذا عن المعرض التّجاريّ؟

84
00:05:44,820 --> 00:05:47,140
.بالطّبع ذهبت

85
00:05:47,140 --> 00:05:50,540
،بما أنّ تايوان هي أفضل منتجي الدّرّاجات في العالم

86
00:05:50,540 --> 00:05:52,790
.تمكّنت من رؤية كلّ أنواع الدّرّاجات

87
00:05:52,790 --> 00:05:57,530
ماذا؟ هل تصنع تايوان العديد من الدّرّاجات؟

88
00:05:57,530 --> 00:06:00,330
.نعم، إنّهم ينتجون الكثير من القطع أيضًا

89
00:06:00,870 --> 00:06:05,640
على الأرجح أنّ تلك الدّرّاجات الّتي تركبنها
.تستعمل قطعًا تايوانيّة أيضًا

90
00:06:05,640 --> 00:06:07,170
فعلاً؟

91
00:06:07,170 --> 00:06:08,510
.لم أعرف ذلك

92
00:06:08,510 --> 00:06:14,600
حسنًا، لقد زرت أماكن أخرى غير المعرض
.التّجاريّ وحيّ الإلكترونيّات أيضًا

93
00:06:14,600 --> 00:06:18,290
انظرن لهذا. حصلتُ على سُمرة رغم
.أنّنا في فصل الرّبيع فحسب

94
00:06:18,290 --> 00:06:20,820
يا إلهي، ثانية؟

95
00:06:20,820 --> 00:06:23,000
بالمناسبة، أين هي ناغيسا؟

96
00:06:23,000 --> 00:06:25,320
.لقد خرجت للحصول على رخصتها

97
00:06:25,320 --> 00:06:28,140
ثانية؟ بشأن ماذا هذه المرّة؟

98
00:06:28,140 --> 00:06:30,110
.مركبات كبيرة خاصّة

99
00:06:30,110 --> 00:06:31,430
كبيرة خاصّة؟

100
00:06:31,430 --> 00:06:34,080
ما الّذي تريد أن تكونه؟

101
00:06:34,080 --> 00:06:36,090
.أنا خبّازة

102
00:06:36,090 --> 00:06:38,210
.يُفترض أن تكون خبّازة

103
00:06:38,210 --> 00:06:39,370
.حسنًا، لا يهمّ

104
00:06:39,370 --> 00:06:42,250
.تحتاج هؤلاء الفتيات إلى درّاجات

105
00:06:42,700 --> 00:06:46,130
.سأفتح المحلّ من أجلكنّ. تعالين إلى الواجهة

106
00:07:01,050 --> 00:07:04,570
."هذا هو محلّي، "ساكل فلات

107
00:07:05,830 --> 00:07:08,230
.هنالك الكثير من الدّرّاجات

108
00:07:08,230 --> 00:07:11,920
.إنّه مختلف تمامًا عن المحلّ الّذي في البلدة

109
00:07:11,920 --> 00:07:14,320
.يا لها من تشكيلة

110
00:07:14,320 --> 00:07:18,290
.نعم. لديها درّاجات طرق ودرّاجات هجينة أيضًا

111
00:07:18,760 --> 00:07:21,430
أيّها الأسرع؟

112
00:07:21,430 --> 00:07:23,200
.هذا مذهل نوعًا ما

113
00:07:23,200 --> 00:07:26,210
مجرّد رؤية هذه الدّرّاجات مصطفّة
.هكذا يثير حماسي

114
00:07:26,210 --> 00:07:27,750
.نعم، بالفعل

115
00:07:28,090 --> 00:07:31,050
بالتّفكير بالأمر، عندما كنتُ
...في المدرسة الابتدائيّة

116
00:07:34,250 --> 00:07:39,680
.كانت هنالك درّاجة ورديّة برزت أكثر من غيرها

117
00:07:39,680 --> 00:07:44,440
.أتذكّر أنّي أردتُها بشدّة، واشتراها لي والداي

118
00:07:44,870 --> 00:07:49,900
شعرتُ أنّ بإمكاني الذّهاب لأيّ مكان
.وركبتها في الحيّ بأكمله

119
00:07:50,420 --> 00:07:55,060
.على الأرجح أنّي استمتعت بتوسّع عالمي

120
00:07:56,620 --> 00:07:58,910
.أظنّ أنّي أعرف ما تقصدينه

121
00:07:58,910 --> 00:08:02,070
.أتمنّى أن أجرّب ذلك أنا أيضًا

122
00:08:02,070 --> 00:08:04,600
هل يمكنكم المجيء للحظة؟

123
00:08:07,170 --> 00:08:11,050
.هنالك بعض الأشياء الّتي تحتجنها قبل شراء درّاجة

124
00:08:11,420 --> 00:08:14,730
.اختيار شريك هو قرار مهمّ

125
00:08:14,730 --> 00:08:16,090
.استمعن جيّدًا

126
00:08:16,090 --> 00:08:17,880
.شكرًا لك

127
00:08:23,260 --> 00:08:29,270
أوّلاً، تُقسَم الدرّاجات بصورة عامّة
.إلى رياضيّة ووسيلة انتفاع

128
00:08:30,110 --> 00:08:37,620
الدّرّاجات الرّياضيّة هي متسابقات طرق ودرّاجات
.هجينة ودرّاجات "بي إم إكس" ودرّاجات جبليّة

129
00:08:37,620 --> 00:08:42,120
.درّجات الانتفاع هي درّاجات عاديّة كدرّاجات الأمّهات

130
00:08:42,460 --> 00:08:45,620
.مذهل، هنالك أنواع كثيرة

131
00:08:45,620 --> 00:08:47,550
.أنا لا أهتمّ بذلك

132
00:08:47,550 --> 00:08:49,450
.أعطني أسرع وأسهل درّاجة لديك

133
00:08:49,450 --> 00:08:50,590
!غبيّة

134
00:08:50,590 --> 00:08:52,600
.لم أكمل كلامي بعد

135
00:08:53,940 --> 00:08:58,050
عليكنّ أن تقدّمن نتائج خلال ثلاثة
أشهر أيّتها الفتيات، صحيح؟

136
00:08:58,050 --> 00:08:59,470
.رغم أنّ معظمكنّ مبتدئات

137
00:08:59,920 --> 00:09:03,140
.نعم

138
00:09:00,690 --> 00:09:02,030
.هذا مستحيل

139
00:09:03,550 --> 00:09:07,270
.نعم. سأبدأ بالإجابة نظرًا لوضعكنّ

140
00:09:07,890 --> 00:09:12,910
.ما تحتجن إليه يا فتيات هي درّاجات طرق

141
00:09:14,720 --> 00:09:17,130
.لقد ركبتُ واحدة من قبل

142
00:09:17,130 --> 00:09:19,580
.لكن لوقت وجيز

143
00:09:19,580 --> 00:09:20,550
فعلاً؟

144
00:09:20,550 --> 00:09:23,660
لكن لماذا درّاجات الطّرق؟

145
00:09:23,660 --> 00:09:28,380
لأنّها الأسهل للقيام بتحسينات بشأن
المسافة والسّرعة

146
00:09:28,380 --> 00:09:30,630
.في وقت وجيز

147
00:09:30,630 --> 00:09:34,800
.ولا شيء أفضل في ذلك من متسابقات الطّرق

148
00:09:35,410 --> 00:09:37,880
،يمكنكنّ المشاركة في سباقات باستعمال درّاجات الطّرق

149
00:09:37,880 --> 00:09:41,600
،إضافة إلى الذّهاب بها للعمل أو المدرسة
.أو حتّى للتّجوال في الأرجاء

150
00:09:41,600 --> 00:09:45,310
إنّها ممتازة للرّكوب لمسافات طويلة
.أيضًا بما أنّها معدّة للطّرق المعبّدة

151
00:09:45,800 --> 00:09:50,770
،تملك اليابان الكثير من الطّرق المعبّدة
.لذلك ستتمكّنّ من الذّهاب لأماكن عديدة

152
00:09:50,770 --> 00:09:54,770
،لكن عندما ركبت واحدة في ذلك اليوم
.تألّمت مؤخّرتي كثيرًا

153
00:09:54,770 --> 00:09:57,770
.لا أظنّ أنّ بإمكاني ركوب واحدة لمدّة طويلة

154
00:09:57,770 --> 00:10:00,450
.صحيح، هذا ما يقوله الجميع في البداية

155
00:10:00,450 --> 00:10:02,390
ماذا عنك يا ناتسومي؟

156
00:10:02,390 --> 00:10:03,950
ألا تؤلم مؤخّرتك؟

157
00:10:03,950 --> 00:10:06,040
.آلمتني في البداية

158
00:10:06,040 --> 00:10:07,410
.عرفتُ ذلك

159
00:10:07,410 --> 00:10:11,520
فهمت. انقسمت مؤخّرة
.ناتسومي-تشان لنصفين أيضًا

160
00:10:11,520 --> 00:10:13,210
.سوف تنقسم لأربعة في النّهاية

161
00:10:13,570 --> 00:10:15,460
هل كانت قاسية على مؤخّرتك أيضًا؟

162
00:10:16,330 --> 00:10:20,470
.واجهت مشاكل في الاعتياد على المقود

163
00:10:20,470 --> 00:10:24,890
.وكنتُ خائفة عند الأرصفة ومصاريف المياه

164
00:10:24,890 --> 00:10:27,870
.وهنالك أيضًا الوضعيّة المائلة للأمام

165
00:10:27,870 --> 00:10:30,010
.لقد آلمت عنقي وفخذيّ

166
00:10:30,010 --> 00:10:31,960
.تلك تحدّيّات كثيرة

167
00:10:31,960 --> 00:10:33,730
.تبدو متسابقات الطّرق صعبة

168
00:10:34,070 --> 00:10:37,020
.لكنّ متعة ركوبها تفوق كلّ السلبيّات

169
00:10:37,020 --> 00:10:39,860
.يمكن التّحرّك بسرعة بمجرّد تدويسة صغيرة

170
00:10:40,170 --> 00:10:42,680
.شعرتُ وكأنّي متّحدة مع الدّرّاجة

171
00:10:42,680 --> 00:10:45,200
.سوف تواصلن الإسراع بمجرّد أن تبدأن الرّكوب

172
00:10:45,200 --> 00:10:48,900
أجد نفسي أحيانًا قد ابتعدت كثيرًا
.قبل حتّى أن أدرك ذلك

173
00:10:50,030 --> 00:10:54,960
يمكنكنّ الذّهاب لأماكن بعيدة كان يمكن الذّهاب إليها
.بالسّيّارة أو القطار في العادة بمتسابقات الطّرق

174
00:10:55,280 --> 00:11:00,080
نعم. يحبّ البعض ركوب متسابقات
الطّرق إلى محلاّت رامن ومخابز

175
00:11:00,080 --> 00:11:01,920
.رفيعة المستوى في أماكن بعيدة

176
00:11:01,920 --> 00:11:06,350
.نحصل على الكثير من هؤلاء الزّبائن في متجرنا

177
00:11:06,660 --> 00:11:09,000
.المعذرة، لديّ سؤال

178
00:11:09,000 --> 00:11:12,730
هل متسابقات الطّرق هي الدّرّاجات
الأفضل لكلّ الاستعمالات؟

179
00:11:12,730 --> 00:11:18,190
...درّاجة لكلّ الاستعمالات؟ يمكن القول

180
00:11:18,190 --> 00:11:19,470
...يمكن القول

181
00:11:20,750 --> 00:11:21,730
.لا توجد واحدة

182
00:11:21,730 --> 00:11:23,780
.لا يوجد شيء يُدعى درّاجة لكلّ الاستعمالات

183
00:11:26,170 --> 00:11:28,440
يمكنكنّ استعمال درّاجات الأمّهات
.إن كانت لديكنّ أمتعة

184
00:11:28,440 --> 00:11:30,610
.واستعمال متسابقات الطّرق إن أردتنّ الإسراع

185
00:11:30,610 --> 00:11:34,690
وتُستعمل الدّرّاجات الهجينة لقطع
.مسافات متوسّطة بين المدن

186
00:11:34,690 --> 00:11:36,990
وإذا أردتنّ حمل درّاجاتكنّ إلى وجهة ما

187
00:11:36,990 --> 00:11:39,800
،لركوبها بمجرّد الوصول إلى هناك
.فعليكنّ استعمال درّاجة بعجلات صغيرة

188
00:11:39,800 --> 00:11:44,800
بعبارات أخرى، الدّرّاجات العصريّة
.متخصّصة حسب الاستعمال

189
00:11:45,330 --> 00:11:50,090
إنّ الأشخاص متفرّدون، لذلك لا نرى
.أشخاصًا لكلّ الاستعمالات أيضًا

190
00:11:50,090 --> 00:11:53,940
.قد تبدو الدّرّاجات متشابهة، لكنّها متفرّدة أيضًا

191
00:11:53,940 --> 00:12:00,440
والتّوفيق بين ذلك التّفرّد والرّاكب
.هو جزء مهمّ من اختيار الدّرّاجة

192
00:12:00,440 --> 00:12:04,340
.أحبّ تصرّفاتك الطّفوليّة أيّتها المديرة

193
00:12:04,340 --> 00:12:06,270
من تصفين بالطّفوليّة؟

194
00:12:06,270 --> 00:12:08,890
!أخبرتك أنّي امرأة راشدة

195
00:12:08,890 --> 00:12:10,460
.أقصد من الدّاخل

196
00:12:10,460 --> 00:12:12,830
!أنا راشدة من الدّاخل أيضًا

197
00:12:12,830 --> 00:12:16,710
.لكنّ الدّرّاجات الحقيقيّة غالية الثّمن

198
00:12:16,710 --> 00:12:19,470
.يعتمد الأمر على المادّة الّتي صُنع منها الهيكل

199
00:12:19,470 --> 00:12:23,180
.يتراوح الثّمن من ستّين ألف ينّ إلى مليون ينّ

200
00:12:23,980 --> 00:12:25,520
مليون ينّ؟

201
00:12:25,520 --> 00:12:29,340
تومو-تشان، يمكننا السّفر حول العالم
!إن كان لدينا مليون ينّ

202
00:12:29,340 --> 00:12:30,640
.نـ-نعم

203
00:12:30,640 --> 00:12:37,670
كلّما كان وزن الدّرّاجة خفيفًا، كان ركوبها
.لصعود التّلال والإسراع بها سهلاً

204
00:12:37,670 --> 00:12:40,820
.لهذا السّبب يفضّل النّاس موادًّا كالكربون

205
00:12:40,820 --> 00:12:43,820
.لكنّها تزداد غلاءً مع الوقت

206
00:12:43,820 --> 00:12:47,910
.بعبارات أخرى، خفّة الوزن تعادل غلاء السّعر

207
00:12:48,750 --> 00:12:51,040
.لم أكن أعرف ذلك

208
00:12:56,670 --> 00:12:59,570
،علينا مناقشة ميزانيّتكنّ
،لكن بما أنّ لدينا درّاجات اختبار

209
00:12:59,570 --> 00:13:02,300
.سأقوم باستثناء من أجلكنّ اليوم

210
00:13:02,300 --> 00:13:04,380
.سأسمح لكنّ بركوب كلّ شيء هنا

211
00:13:04,820 --> 00:13:07,260
.أعلمنني إن كنتنّ مهتمّات بإحداها

212
00:13:07,260 --> 00:13:09,970
.لا أعرف أيّها أختار

213
00:13:09,970 --> 00:13:11,320
.نعم

214
00:13:11,320 --> 00:13:13,430
.اخترن ما يعجبكنّ

215
00:13:13,840 --> 00:13:16,020
.يمكن أن يكون الخيار مبنيًّا على الحدس أو اللّون

216
00:13:16,020 --> 00:13:20,850
.حسنًا، لنعثر على شريكاتنا

217
00:13:20,850 --> 00:13:25,490
نعم. أنا واثقة أنّ كلّ واحدة منّا ستعثر
.على ما تحبّ بوجود كلّ هذه الدّرّاجات

218
00:13:44,070 --> 00:13:46,040
ألن تركبي واحدة؟

219
00:13:46,040 --> 00:13:48,430
.لديّ درّاجة طرق سلفًا

220
00:13:48,430 --> 00:13:51,430
.ذلك لا يهمّ. اركبي ما يحلو لك

221
00:13:52,920 --> 00:13:54,390
.شكرًا جزيلاً لك

222
00:14:01,570 --> 00:14:04,190
.حسنًا، كلّكنّ جاهزات

223
00:14:04,190 --> 00:14:08,860
.اذهبن واختبرنها في الطّرقات المنبسطة والتّلال

224
00:14:08,860 --> 00:14:10,740
.ها نحن ذاهبات

225
00:15:27,820 --> 00:15:30,800
.يا مديرة المحلّ، أعجبتني هذه

226
00:15:30,800 --> 00:15:33,710
.أحبّ هذه البيـ... لا يهمّ

227
00:15:33,710 --> 00:15:34,950
."اسمها "بيناريلّو

228
00:15:34,950 --> 00:15:38,030
.أريد درّاجة "ليف" هذه، رجاءً

229
00:15:40,070 --> 00:15:41,120
ماذا عنك يا هيرومي؟

230
00:15:41,120 --> 00:15:42,420
...حسنًا

231
00:15:42,420 --> 00:15:43,500
هل من خطب ما؟

232
00:15:45,060 --> 00:15:46,920
.لستُ واثقة

233
00:15:46,920 --> 00:15:51,800
،كانت جميعها ممتعة ويسهل ركوبها
.لكن لم تجذب أيّ واحدة انتباهي

234
00:15:51,800 --> 00:15:52,930
.فهمت

235
00:15:52,930 --> 00:15:55,960
.سأمضي وقتًا أطول في البحث

236
00:15:55,960 --> 00:15:57,010
هل تمانعين ذلك؟

237
00:15:57,010 --> 00:16:00,480
.لا، خذي وقتك

238
00:16:10,090 --> 00:16:11,610
...هذه

239
00:16:36,250 --> 00:16:38,300
هل جذبت هذه انتباهك؟

240
00:16:38,730 --> 00:16:41,810
معذرة، هل يمكننا تجربة ركوب هذه؟

241
00:16:41,810 --> 00:16:43,560
.نعم، بالطّبع

242
00:16:44,750 --> 00:16:46,640
.إنّها في الحجم المناسب لك أيضًا

243
00:16:46,640 --> 00:16:48,450
.حسنًا، اذهبي وخذي جولة بها

244
00:16:48,450 --> 00:16:49,270
.حسنًا

245
00:17:21,830 --> 00:17:24,850
.هذه ممتعة بالفعل

246
00:17:24,850 --> 00:17:28,060
...لستُ واثقة ما المختلف بشأنها، لكن

247
00:17:31,730 --> 00:17:32,730
كيف سار الأمر؟

248
00:17:32,730 --> 00:17:35,090
.كان ركوب هذه سهلاً للغاية

249
00:17:35,090 --> 00:17:36,950
.أريد هذه

250
00:17:38,070 --> 00:17:39,870
هيرومي، عثرتِ على واحدة أخيرًا؟

251
00:17:40,270 --> 00:17:41,130
.نعم

252
00:17:42,660 --> 00:17:46,460
...المعذرة، بشأن السّعر

253
00:17:49,380 --> 00:17:52,380
...إنّها... إنّها... إنّها

254
00:17:52,380 --> 00:17:55,260
!إنّها غالية

255
00:17:55,950 --> 00:17:59,800
.لكنّه سعر مناسب تمامًا بالنّظر لأدائها

256
00:18:00,200 --> 00:18:02,430
ماذا عنك يا تومو-تشان؟

257
00:18:02,430 --> 00:18:07,410
،حسنًا، إن ساعدتُ في محلّ عائلتي أكثر
.فأظنّ أنّ بإمكاني تحمّل ثمنها

258
00:18:07,410 --> 00:18:08,480
فعلاً؟

259
00:18:08,860 --> 00:18:11,690
.لكن لن يتبقّى لي الكثير من المصروف الخاصّ

260
00:18:12,030 --> 00:18:16,190
،لكن بما أنّي سأركبها كثيرًا في نادينا
.فأريد أن أشتري واحدة أحبّها

261
00:18:16,530 --> 00:18:19,370
.صحيح. أنت على حقّ

262
00:18:20,820 --> 00:18:23,280
...أعجبتني هذه، ولكن

263
00:18:30,410 --> 00:18:33,110
.انتهيت من ملء كلّ الاستمارات

264
00:18:33,110 --> 00:18:35,340
.أبليت حسنًا يا شيكي-سينسي

265
00:18:36,390 --> 00:18:38,230
.مرحبًا يا سيّدتي

266
00:18:38,230 --> 00:18:40,850
هل قرّرت عضوات النّادي ماذا سيفعلن؟

267
00:18:41,350 --> 00:18:45,850
كنت أفكّر أنّ بإمكاننا مناقشة كيف
.يمكننا تقديم نتائج كنادٍ بعد هذا

268
00:18:45,850 --> 00:18:49,810
،إن كنت لم تقرّري بشأن أيّ شيء
فما رأيك بهذا إذًا؟

269
00:18:49,810 --> 00:18:50,830
ماذا؟

270
00:18:54,770 --> 00:18:56,990
.يا لحظّكما

271
00:18:56,990 --> 00:18:58,820
.لا تجعلي الأمر يحبطك

272
00:18:58,820 --> 00:19:01,970
.ستعثرين على واحدة تعجبك في النّهاية

273
00:19:03,570 --> 00:19:06,390
.ستستمتعين أكثر لأنّها الدّرّاجة الّتي أردتها

274
00:19:06,390 --> 00:19:08,580
.ستعملين بجدّ أكبر لأنّها الدّرّاجة الّتي اخترتها

275
00:19:08,580 --> 00:19:11,420
.ستثقين بدرّاجتك لأنّها الدّرّاجة الّتي أعجبتك

276
00:19:11,420 --> 00:19:15,370
.تلك أفضل درّاجة يمكن لأيّ أحد ركوبها

277
00:19:15,880 --> 00:19:20,090
الدّرّاجة الّتي تعجبني هي الدّرّاجة الأفضل لي؟

278
00:19:21,970 --> 00:19:24,260
.لا تستعجلي. خذي وقتك في العثور على واحدة

279
00:19:24,260 --> 00:19:26,440
.نعم، شكرًا

280
00:19:26,440 --> 00:19:29,180
.لكن علينا تقديم نتائج واضحة

281
00:19:29,180 --> 00:19:31,660
.لا يمكننا أخذ الكثير من الوقت

282
00:19:31,660 --> 00:19:33,900
.صحيح

283
00:19:33,900 --> 00:19:35,310
!يا فتيات

284
00:19:35,880 --> 00:19:37,240
.إنّها شيكي-سينسي

285
00:19:38,550 --> 00:19:40,360
.أتت أخيرًا

286
00:19:40,360 --> 00:19:42,590
.يبدو أنّها على عجلة من أمرها

287
00:19:42,590 --> 00:19:43,530
.أتساءل ماذا هنالك

288
00:19:44,470 --> 00:19:45,530
.شكرًا على الانتظار

289
00:19:46,170 --> 00:19:50,000
لماذا أنت على عجلة من أمرك؟

290
00:19:50,000 --> 00:19:51,980
.لقد عثرت على أنسب شيء لكنّ

291
00:19:51,980 --> 00:19:52,910
ماذا؟

292
00:19:52,910 --> 00:19:56,170
ما رأيكنّ؟ أليس هذا ممتازًا لتقديم بعض النّتائج؟

293
00:19:57,390 --> 00:19:59,420
ما هذا؟

294
00:19:59,940 --> 00:20:03,580
ليلة سباق الدّرّاجات؟

295
00:21:36,070 --> 00:21:40,100
منظر درّاجات الطّريق بكامل المعدّات يجعل
.المرء يرغب بالشّروع في ركوبها من الغد

296
00:21:40,100 --> 00:21:43,000
.فقرة جانبيّة: أوّل نادٍ للدّرّاجات

297
00:21:44,490 --> 00:21:48,430
سنقدّم لكم في هذه الفقرة معلومات
...مهمّة لركوب الدّرّاجات للمبتدئين في

298
00:21:48,430 --> 00:21:50,690
...الفقرة الجانبيّة لفوكوو يوي

299
00:21:50,690 --> 00:21:52,890
.وهيروسي يوكي

300
00:21:54,410 --> 00:21:59,110
ركوب الدّرّاجات ممتع، لكن يمكن
...أن نواجه مشاكل غير متوقّعة

301
00:21:59,550 --> 00:22:01,880
".هنالك شيء ليس في محلّه"

302
00:22:02,570 --> 00:22:05,470
".إطار مثقوب! هذا سيّئ"

303
00:22:06,380 --> 00:22:10,430
".ماذا؟ لكن لا توجد أيّ محلاّت درّاجات في الجوار"

304
00:22:11,450 --> 00:22:13,380
"ما العمل؟"

305
00:22:14,870 --> 00:22:18,270
سنتعلّم هذه المرّة تقنيّات لإصلاح الإطارات المثقوبة

306
00:22:18,270 --> 00:22:20,300
.يستطيع حتّى المبتدئين استعمالها

307
00:22:21,560 --> 00:22:24,400
هل من الممكن لنا أن نصلح إطارًا مثقوبًا بأنفسنا؟

308
00:22:24,400 --> 00:22:24,940
.نعم

309
00:22:24,940 --> 00:22:31,710
.يمكن إزال العجلات، لذلك فهي تقنيّة إصلاح مفيدة

310
00:22:31,710 --> 00:22:32,870
.يمكننا إصلاحه بأنفسنا إذًا

311
00:22:33,190 --> 00:22:34,690
.أوّلاً، نزيل العجلة

312
00:22:34,690 --> 00:22:35,540
.حسنًا

313
00:22:35,540 --> 00:22:38,170
...هنالك صمّام يُستعمل لإضافة الهواء

314
00:22:38,170 --> 00:22:40,920
.لكنّنا سنبدأ العمل على الجانب المعاكس

315
00:22:40,920 --> 00:22:42,210
.يسهل إزالته بهذه الطّريقة

316
00:22:42,690 --> 00:22:43,420
.فهمت

317
00:22:43,420 --> 00:22:45,090
.هنالك حافّة على أحد أطراف هذه

318
00:22:45,090 --> 00:22:49,680
.ثبّتاها على الإطار واطوياها باستعمال مبدأ الرّفع

319
00:22:48,600 --> 00:22:49,680
.هذا مذهل

320
00:22:49,680 --> 00:22:50,370
.انطوت للأسفل

321
00:22:50,370 --> 00:22:51,760
.هكذا تعمل هذه الأداة

322
00:22:52,630 --> 00:22:56,670
،بمجرّد إزالة الإطار وإخراج الإطار الدّاخليّ في الدّاخل

323
00:22:56,670 --> 00:22:58,270
...فسننتهي، ولكن

324
00:22:58,940 --> 00:23:03,270
.إن أمكن، عليكما أن تحدّدا ما تسبّب في ثقب الإطار

325
00:23:01,750 --> 00:23:02,540
.حسنًا

326
00:23:03,270 --> 00:23:04,730
.أوّلاً، علينا وضع قاعدة

327
00:23:04,730 --> 00:23:07,150
.ضعا شعار الإطار مع الصّمّام

328
00:23:07,150 --> 00:23:09,360
.اعتبرا هذا الجزء كأنّه قطعة واحدة

329
00:23:09,690 --> 00:23:12,460
.والآن، سأنفخ الإطار

330
00:23:14,530 --> 00:23:19,740
،إن تركتما الصّمّام والشّعار معًا
،إن كان الثّقب هنا

331
00:23:19,740 --> 00:23:23,960
فستكونان قادرتين على العثور على السّبب
.إن بحثتما في هذا الجزء من الإطار

332
00:23:23,960 --> 00:23:27,660
،إن كان هنالك خطب ما في هذا الإطار
.فستعرفان أنّه هنا

333
00:23:25,630 --> 00:23:27,660
.هذا صحيح

334
00:23:27,660 --> 00:23:30,210
،بهدف تحديد سبب المشكلة

335
00:23:28,510 --> 00:23:34,930
في الحلقة القادمة
التّعامل مع الحوادث 2

336
00:23:30,210 --> 00:23:33,490
.من المهمّ تطبيق قاعدتك الخاصّة

337
00:23:32,370 --> 00:23:34,930
.إنّها فكرة جيّدة أن تحدّدا قاعدة بأنفسكما

338
00:23:34,930 --> 00:23:39,930
في الحلقة القادمة
"!السّباق الأوّل"