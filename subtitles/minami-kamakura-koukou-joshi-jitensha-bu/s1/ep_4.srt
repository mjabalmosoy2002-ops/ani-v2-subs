1
00:00:16,490 --> 00:00:18,930
.أعلى قليلاً

2
00:00:17,100 --> 00:00:19,450
.هيغا-سان، أنت طاهية ممتازة

3
00:00:20,530 --> 00:00:24,250
اعتدتُ تقديم المساعدة في منزل
.ضيافة عائلتي في أوكيناوا

4
00:00:24,250 --> 00:00:25,420
حقًّا؟

5
00:00:25,420 --> 00:00:27,920
.تومو-تشان، لقد انتهينا هنا

6
00:00:29,590 --> 00:00:30,590
.مذهل

7
00:00:31,220 --> 00:00:33,340
.لقد عملتما بجدّ أنتما أيضًا

8
00:00:33,870 --> 00:00:35,800
.يمكن لأيّ أحد القيام بهذا

9
00:00:36,520 --> 00:00:38,650
هل نحن جاهزات الآن؟

10
00:00:38,650 --> 00:00:39,560
.أظنّ ذلك

11
00:00:39,990 --> 00:00:42,530
!حسنًا، لنقم بهذا

12
00:00:42,530 --> 00:00:44,020
!أجل

13
00:02:17,320 --> 00:02:19,950
!مرحبًا يا شيكي-سينسي

14
00:02:23,250 --> 00:02:25,490
ما-ما كلّ هذا؟

15
00:02:26,860 --> 00:02:28,290
.مِن هنا

16
00:02:28,290 --> 00:02:29,750
ما الّذي يحدث؟

17
00:02:29,750 --> 00:02:31,670
.اجلسي من فضلك

18
00:02:32,530 --> 00:02:34,140
.تفضّلي بعض الشّاي

19
00:02:35,660 --> 00:02:37,380
.خذي وقتك

20
00:02:39,130 --> 00:02:40,590
ما كلّ هذا؟

21
00:02:40,950 --> 00:02:43,600
.تفضّلي طعامك

22
00:02:43,600 --> 00:02:48,430
،إنّه طبق أرزّ أحمر وكيش
.وبراعم السّلجم وسلطة بطاطا

23
00:02:49,060 --> 00:02:50,560
.بالهناء والشّفاء

24
00:02:50,560 --> 00:02:52,230
!بالهناء والشّفاء

25
00:02:52,230 --> 00:02:55,400
.حسنًا. شكرًا على الطّعام

26
00:03:00,990 --> 00:03:03,130
.إنّه لذيذ. إنّه لذيذ للغاية

27
00:03:04,350 --> 00:03:06,450
.هنالك الكثير إن أردتِ المزيد

28
00:03:06,450 --> 00:03:08,410
.تناولي بقدر ما تشائين

29
00:03:08,410 --> 00:03:09,880
.شكرًا لكنّ

30
00:03:10,420 --> 00:03:14,120
حسنًا، ما الغاية من كلّ هذا؟

31
00:03:15,880 --> 00:03:17,830
نادي درّاجات؟

32
00:03:17,830 --> 00:03:21,490
.نعم، إنّنا نفكّر بإنشاء نادٍ

33
00:03:21,490 --> 00:03:25,130
.لكنّنا بحاجة لمستشار من المدرّسين لنبدأ النّادي

34
00:03:25,130 --> 00:03:27,510
.ونريد أن تكوني أنت

35
00:03:27,510 --> 00:03:28,560
.فهمت

36
00:03:29,090 --> 00:03:33,440
أخبرتكنّ بالفعل أن تعثرن على نادٍ، لكنّي
.لم أتوقّع منكنّ إنشاء واحد جديد

37
00:03:33,440 --> 00:03:36,660
.أنت تعرفين الكثير عن الدّرّاجات مسبقًا

38
00:03:36,660 --> 00:03:38,190
.أرجوك يا سينسي

39
00:03:38,190 --> 00:03:39,400
.أرجوك

40
00:03:42,930 --> 00:03:44,380
.حسنًا، أنا موافقة

41
00:03:44,380 --> 00:03:46,090
.سأكون مستشارة نادي الدّرّاجات

42
00:03:47,950 --> 00:03:49,070
!ممتاز

43
00:03:49,070 --> 00:03:50,450
!لقد نجحنا

44
00:03:51,030 --> 00:03:52,700
هل أنت واثقة؟

45
00:03:53,210 --> 00:03:59,840
يُشترط بي في الحقيقة أن أكون
.مستشارة لنادٍ ما أيضًا

46
00:03:59,840 --> 00:04:04,600
أنا لستُ جيّدة كثيرًا في التّدريس، صحيح؟

47
00:04:04,600 --> 00:04:07,670
لكنّي قادرة على الأرجح أن أعلّمكنّ
.ما يخصّ الدّرّاجات

48
00:04:07,670 --> 00:04:08,940
.واثقة أنّه لن تكون هنالك مشاكل

49
00:04:08,940 --> 00:04:11,230
.أعتقد أنّها قالت شيئًا مجنونًا للتّوّ بلا انتباه

50
00:04:11,540 --> 00:04:13,580
.يمكننا تشكيل نادينا الآن

51
00:04:13,580 --> 00:04:16,120
.نعم، نادي الدّرّاجات جاهز لينطلق

52
00:04:18,790 --> 00:04:21,240
.أنا جائعة الآن بعدما ارتحت

53
00:04:21,240 --> 00:04:23,320
.على رسلك يا هيرومي

54
00:04:23,320 --> 00:04:25,450
.سأعدّ أطباقًا لبقيّتكنّ أيضًا

55
00:04:26,390 --> 00:04:28,410
.هذا لذيذ

56
00:04:28,410 --> 00:04:30,040
.نعم، إنّه لذيذ بالفعل

57
00:04:30,530 --> 00:04:33,540
.أعيّن ناتسومي كطاهية لنادي الدّرّاجات

58
00:04:34,000 --> 00:04:36,270
ماذا يمكنك أن تطبخي أيضًا؟

59
00:04:36,270 --> 00:04:39,930
.حسنًا، يمكنني إعداد معظم أطباق أوكيناوان

60
00:04:39,930 --> 00:04:42,040
طعام أوكيناوان؟

61
00:04:42,040 --> 00:04:44,010
.بالتّفكير بالأمر، لا أظنّ أنّي تناولت أيًّا منه من قبل

62
00:04:44,380 --> 00:04:47,050
.سأعدّ بعض التّيبيتشي في المرّة القادمة

63
00:04:47,050 --> 00:04:48,150
تيبيتشي؟

64
00:04:48,150 --> 00:04:50,120
.إنّها قوائم الخنزير المطبوخة

65
00:04:50,120 --> 00:04:51,400
فعلاً؟

66
00:04:51,400 --> 00:04:53,050
.اطبخيه، اطبخيه

67
00:04:53,050 --> 00:04:56,350
حسنًا، ما الّذي سيفعله نادي الدّرّاجات؟

68
00:04:56,770 --> 00:05:00,130
.ركوب درّاجات؟ التّجوال ممتع أيضًا

69
00:05:00,130 --> 00:05:03,800
.أو يمكنكنّ التّدرّب بجدّ والمشاركة في سباقات

70
00:05:03,800 --> 00:05:07,360
.أنا أريد ركوب الدّرّاجات فحسب

71
00:05:07,730 --> 00:05:08,700
.وأنا أيضًا

72
00:05:08,700 --> 00:05:13,120
أحبّ أن أذهب لأماكن لم أزرها
.من قبل دون بذل الكثير من الجهد

73
00:05:13,120 --> 00:05:15,670
.أحبّ أن أسافر لمكان بعيد للغاية

74
00:05:15,670 --> 00:05:17,870
.مثل هوكّايدو

75
00:05:17,870 --> 00:05:18,710
.فكرة ممتازة

76
00:05:19,070 --> 00:05:21,130
.يجب أن تكون أحلامنا كبيرة

77
00:05:21,130 --> 00:05:22,600
.أوافقكما الرّأي

78
00:05:23,090 --> 00:05:25,380
.حسنًا. فهمت

79
00:05:25,380 --> 00:05:28,170
.في الوقت الحاليّ، تردن ركوب الدّرّاجات فحسب

80
00:05:28,170 --> 00:05:29,790
.هذا جيّد كفاية كبداية

81
00:05:40,080 --> 00:05:41,850
.أحسنتِ يا هيروكو

82
00:05:41,850 --> 00:05:46,590
تبلي هيروكو حسنًا هذه السّنة، وهنالك التّلميذة
.الجديدة الواعدة من السّنة الأولى أيضًا

83
00:05:46,590 --> 00:05:49,630
.سيصبح فريقنا أقوى بكثير

84
00:05:51,980 --> 00:05:52,870
!خبر عاجل

85
00:05:57,230 --> 00:06:01,190
كلّ الدّرّاجات الّتي يملكها ناديكنّ
هي درّاجة الأمهّات لمايهارو-سان

86
00:06:01,190 --> 00:06:02,980
ودرّاجة هيغا-سان للطّرق، صحيح؟

87
00:06:02,980 --> 00:06:06,090
.إنّهما درّاجتان مختلفتان للغاية

88
00:06:06,090 --> 00:06:08,380
.أنا أنوي شراء واحدة

89
00:06:08,380 --> 00:06:09,590
.وأنا أيضًا

90
00:06:09,590 --> 00:06:13,100
.هنالك متجر درّاجات قرب مخبزة ناغيسا-سان

91
00:06:13,850 --> 00:06:15,900
مايهارو-سان، ما الّذي ستفعلينه؟

92
00:06:15,900 --> 00:06:21,780
.كنتُ أفكّر في ركوب هذه لوقت أطول

93
00:06:21,780 --> 00:06:22,400
فعلاً؟

94
00:06:23,620 --> 00:06:25,470
أليس المقعد منخفضًا قليلاً؟

95
00:06:25,470 --> 00:06:27,490
.لقد بدأ ينخفض بينما أركبها

96
00:06:27,970 --> 00:06:29,740
.علينا تعديله إذًا

97
00:06:29,740 --> 00:06:31,490
يا هيغا-سان؟

98
00:06:33,990 --> 00:06:35,160
...أزوما-سينباي

99
00:06:35,470 --> 00:06:38,410
.ظننتُ أنّك ستنضمّين لنادينا

100
00:06:38,760 --> 00:06:39,480
ماذا؟

101
00:06:40,840 --> 00:06:42,580
من تكون؟

102
00:06:42,580 --> 00:06:45,880
إنّها أزوما هيروكو-سينباي، تلميذة
.من السّنة الثّانية في فريق السّباحة

103
00:06:46,230 --> 00:06:48,900
...أليست أزوما هيروكو هي

104
00:06:48,900 --> 00:06:50,200
هل تعرفينها؟

105
00:06:50,200 --> 00:06:51,520
.مهلاً

106
00:06:51,520 --> 00:06:53,600
.أنا أحاول استرجاع بعض الذّكريات الآن

107
00:06:55,270 --> 00:06:59,720
هذا صحيح. احتلّت المركز الثّاني في سباق
.السّباحة الوطنيّ العام الماضي

108
00:06:59,720 --> 00:07:01,550
،كانت في نادي الكرة الطّائرة من قبل

109
00:07:01,550 --> 00:07:04,570
.لكنّها انتقلت للسّباحة بعد أن أصابت ركبتها

110
00:07:04,570 --> 00:07:07,100
واحتلّت المركز الثّاني في سباق السّباحة الوطنيّ؟

111
00:07:07,100 --> 00:07:08,900
.هذا رائع

112
00:07:08,900 --> 00:07:10,400
ما الّذي تفعله هنا؟

113
00:07:10,900 --> 00:07:14,460
.سمعتُ أنّك انضممت لنادٍ آخر

114
00:07:14,460 --> 00:07:15,910
إلى أيّ نادٍ انضممت؟

115
00:07:16,690 --> 00:07:18,210
.نادي الدّرّاجات

116
00:07:18,210 --> 00:07:19,410
نادي الدّرّاجات؟

117
00:07:19,910 --> 00:07:21,430
وهل يوجد نادٍ كهذا؟

118
00:07:21,430 --> 00:07:23,890
!لقد أنشأناه بأنفسنا

119
00:07:23,890 --> 00:07:28,570
لا بدّ أنّ المديرة قد وافقت على نادٍ
.آخر بلا تفكير مسبق ثانية

120
00:07:28,570 --> 00:07:30,760
.لن يدوم طويلاً

121
00:07:31,730 --> 00:07:34,520
ما الّذي ستفعلينه بشأن نادي السّباحة؟

122
00:07:34,520 --> 00:07:36,560
.لم أقل أنّي سأنضمّ

123
00:07:36,560 --> 00:07:41,670
.لكن عليك أن تنضمّي
.نحتاج لعضوات واعدات جديدات

124
00:07:42,090 --> 00:07:47,570
.لا يمكننا أن نقبل عدم انضمامك ببساطة

125
00:07:48,440 --> 00:07:51,890
.لذلك دعونا نقرّر بشأن هذا بسباق درّاجات

126
00:07:56,870 --> 00:07:57,370
...مهلاً

127
00:07:57,810 --> 00:07:59,870
لماذا أنا؟

128
00:07:59,870 --> 00:08:05,190
ستكون لديك الأفضليّة إن ركبتِ
.درّاجة هيغا-سان السّريعة

129
00:08:05,190 --> 00:08:07,880
،لكي نجعل الأمور منصفة أكثر

130
00:08:07,880 --> 00:08:12,960
.فإنّ مساوئ قدراتك ستتوازن بحسنات درّاجتك

131
00:08:12,960 --> 00:08:17,510
.وسأتوازن أنا بركوبي لدرّاجتك

132
00:08:17,960 --> 00:08:20,420
.تلك الحسابات لا تبدو منطقيّة

133
00:08:20,420 --> 00:08:23,890
كيف عرفتِ أنّ قدرات هيرومي ضعيفة؟

134
00:08:23,890 --> 00:08:28,900
.صـ-صحيح! قد أكون سريعة للغاية

135
00:08:29,330 --> 00:08:33,990
.رأيتُك تركبين الدّرّاجة في يوم حفل الدّخول المدرسيّ

136
00:08:36,460 --> 00:08:37,500
.لا بأس

137
00:08:37,500 --> 00:08:39,660
.لا أحتاج لأن تمسكي بي بعد الآن

138
00:08:40,000 --> 00:08:41,400
أرأيت؟

139
00:08:42,540 --> 00:08:45,750
مهلاً يا هيرومي. إلى أين أنت ذاهبة؟

140
00:08:47,870 --> 00:08:49,210
.هذا واضح

141
00:08:49,210 --> 00:08:51,910
لكن لماذا اخترت سباق درّاجات؟

142
00:08:51,910 --> 00:08:54,260
.لأنّني سأفوز إن كان سباق سباحة

143
00:08:56,450 --> 00:08:57,840
.القواعد بسيطة

144
00:08:58,170 --> 00:09:02,700
.الفائزة منّا هي الّتي ستصل لقمّة التّلّة أوّلاً

145
00:09:02,700 --> 00:09:04,730
.حتّى أنّي سأعطيك الأفضليّة

146
00:09:04,730 --> 00:09:07,850
.سأبدأ بعد دقيقة من انطلاقك

147
00:09:07,850 --> 00:09:12,690
حتّى أنّه بإمكان أحد ما أن يدفعك
.أثناء الأمتار الخمسة عشر الأولى

148
00:09:14,010 --> 00:09:16,360
...لكن ستكون لي الأفضليّة في كلّ الأحوال

149
00:09:16,360 --> 00:09:17,830
هل هنالك أيّ شيء يمكنني منحك إيّاه؟

150
00:09:17,830 --> 00:09:22,130
ما رأيك في أن يكون جسدك ملامسًا
للدّرّاجة على الدّوام؟

151
00:09:22,130 --> 00:09:23,750
هل أنت واثقة من ذلك؟

152
00:09:23,750 --> 00:09:24,330
.نعم

153
00:09:26,140 --> 00:09:28,300
.سيكون هذا فوزًا سهلاً

154
00:09:29,930 --> 00:09:32,520
.لا بدّ أنّها سريعة

155
00:09:32,520 --> 00:09:34,130
...سينسي

156
00:09:34,130 --> 00:09:36,200
.جرّبي حظّك يا مايهارو-سان

157
00:09:36,200 --> 00:09:39,470
قد تكون هذه أوّل مرّة لك تركبين فيها
.درّاجة طرق، لكنّك ستستمتعين

158
00:09:39,470 --> 00:09:41,550
.لستُ واثقة أنّ الأمر سهل لتلك الدّرجة

159
00:09:41,550 --> 00:09:44,280
.يبدو هذا المقود مخيفًا

160
00:09:44,280 --> 00:09:46,670
.هيرومي-سان، سأريك كيف تركبينها

161
00:09:46,670 --> 00:09:47,940
...هيغا-سان

162
00:09:48,910 --> 00:09:50,900
.يحوّل هذا المسنّنَ للأعلى

163
00:09:50,900 --> 00:09:54,090
اضغطي على هذا مع رافعة الفرامل
.وستنتقلين لمسنّن سفليّ

164
00:09:54,090 --> 00:09:56,190
.وهكذا تُستعمل الفرامل

165
00:09:56,750 --> 00:10:01,270
،أشكال الرّافعات مختلفة
.لكنّها تعمل تمامًا كدرّاجة هجينة

166
00:10:01,880 --> 00:10:05,550
،كنتِ قادرة على ركوب الدّرّاجة الهجينة
.لذلك ستكونين قادرة على ركوب درّاجة طرق

167
00:10:05,550 --> 00:10:07,250
.القول أسهل من الفعل

168
00:10:07,250 --> 00:10:08,910
.ستكونين بخير

169
00:10:08,910 --> 00:10:11,590
.تعلّمتُ ركوب درّاجة ناتسومي في وقت وجيز

170
00:10:11,590 --> 00:10:13,170
ماذا؟ فعلاً؟

171
00:10:13,170 --> 00:10:18,440
إن أردتِ رأيي، فركوب الدّرّاجة أسهل
.من تشغيل جهاز التّحكّم عن بعد

172
00:10:18,440 --> 00:10:21,190
.لا تقلقي يا هيرومي

173
00:10:21,190 --> 00:10:24,650
لم يتطلّب منك تعلّم ركوب درّاجة
.الأمّهات الكثير من الوقت أيضًا

174
00:10:24,650 --> 00:10:26,460
.أنا واثقة أنّك ستركبين درّاجة الطّرق بشكل جيّد

175
00:10:26,980 --> 00:10:28,730
.الأمر أسهل ممّا تعتقدين

176
00:10:29,070 --> 00:10:31,360
...ذلك ما يبدو، ولكن

177
00:10:31,360 --> 00:10:31,980
ماذا؟

178
00:10:32,300 --> 00:10:33,590
ما خطب هذه الدّوّاسات؟

179
00:10:33,590 --> 00:10:34,650
أليست صغيرة نوعًا ما؟

180
00:10:35,060 --> 00:10:37,800
.صحيح. هذه دوّاسات بلا مشبك

181
00:10:41,290 --> 00:10:44,280
حسنًا. ستكونين بخير بما أنّي غيّرتها
.إلى دوّاسات منبسطة

182
00:10:46,270 --> 00:10:48,040
.لقد أنزلتُ المقعد قليلاً أيضًا

183
00:10:49,540 --> 00:10:51,990
.مؤخّرتي تؤلمني

184
00:10:51,990 --> 00:10:53,960
هل أنت جاهزة؟

185
00:10:53,960 --> 00:10:56,270
.نعم، إنّها جاهزة

186
00:10:56,710 --> 00:10:58,550
.سننتظر في خطّ النّهاية

187
00:10:58,550 --> 00:10:59,840
.يمكنك النّجاح يا هيروكو

188
00:11:01,310 --> 00:11:03,720
.سوف نتسابق بالفعل

189
00:11:05,650 --> 00:11:09,140
.هيرومي-سان، سوف أدفعك

190
00:11:09,140 --> 00:11:10,390
...هيغا-سان

191
00:11:11,130 --> 00:11:12,220
.أنا آسفة

192
00:11:12,220 --> 00:11:14,730
.يحدث هذا بسببي أنا

193
00:11:16,570 --> 00:11:17,950
.صحيح

194
00:11:17,950 --> 00:11:21,700
.إن خسرت، ستذهب هيغا-سان لفريق السّباحة

195
00:11:24,440 --> 00:11:26,230
.لا يمكنها فعل ذلك

196
00:11:27,590 --> 00:11:32,020
.سوف تركب هيغا-سان الدّرّاجات معنا

197
00:11:33,390 --> 00:11:35,840
.هيغا-سان، سأبذل جهدي

198
00:11:37,470 --> 00:11:39,500
.حسنًا، شكرًا لك

199
00:11:39,500 --> 00:11:40,470
.يمكنك النّجاح

200
00:11:41,900 --> 00:11:44,610
.هذا ليس مخيفًا، ليس مخيفًا

201
00:11:46,850 --> 00:11:48,930
.لتبذل كلتانا كلّ ما لديها

202
00:11:49,350 --> 00:11:50,270
.نعم

203
00:11:53,830 --> 00:11:58,230
...جهّزا نفسيكما! استعداد

204
00:11:58,230 --> 00:11:59,740
!انطلاق

205
00:12:05,080 --> 00:12:08,910
...جهّزا نفسيكما! استعداد

206
00:12:08,910 --> 00:12:10,100
!استعداد

207
00:12:22,210 --> 00:12:25,390
!لست أسير بثبات! هذا مخيف

208
00:12:25,390 --> 00:12:28,450
!هيرومي-تشان، عليك أن تدوسي

209
00:12:28,450 --> 00:12:30,620
!ستقعين إن لم تدوسي

210
00:12:30,620 --> 00:12:32,580
!آ-آسفة

211
00:12:33,940 --> 00:12:35,700
!واصلي الدّوس

212
00:12:35,700 --> 00:12:37,610
!حـ-حسنًا

213
00:12:39,230 --> 00:12:41,330
!سوف أتركك

214
00:12:41,330 --> 00:12:43,570
ماذا؟ بهذه السّرعة؟

215
00:12:45,170 --> 00:12:46,820
!يمكنك النّجاح

216
00:12:50,950 --> 00:12:52,280
.حسنًا

217
00:12:54,350 --> 00:12:56,500
.حان الوقت لأنطلق أنا

218
00:12:59,740 --> 00:13:01,590
ما-ماذا؟

219
00:13:01,930 --> 00:13:07,050
هل نسيت أنّ على جسدك أن يلامس الدّرّاجة دائمًا؟

220
00:13:07,050 --> 00:13:10,530
ماذا؟ تقصدين أنّه ليس عليّ الوقوف والدّوس؟

221
00:13:12,900 --> 00:13:15,490
.هذه ليست مشكلة

222
00:13:15,490 --> 00:13:16,480
!ها أنا ذي

223
00:13:19,400 --> 00:13:20,270
ماذا؟

224
00:13:22,980 --> 00:13:25,330
.كلاّ! أنا لا أنطلق بقوّة

225
00:13:25,330 --> 00:13:27,700
.لماذا؟ لا يمكنني إدارة الدّوّاسات على الإطلاق

226
00:13:28,220 --> 00:13:30,950
.يبدو أنّ أزوما-سينباي تعاني وهي تصعد التّلّة

227
00:13:31,290 --> 00:13:33,560
.إنّها أبطأ ممّا ظننت

228
00:13:33,560 --> 00:13:36,670
.ربّما ليست جيّدة على الأرض بما أنّها سبّاحة

229
00:13:36,670 --> 00:13:40,040
كلاّ، إنّها غير قادرة على استعمال
.معظم عضلاتها فحسب

230
00:13:40,040 --> 00:13:40,630
ماذا؟

231
00:13:41,140 --> 00:13:45,180
يمكنكما أن تشعرا أنّ عضلاتكما تبذل معظم قوّتها

232
00:13:45,180 --> 00:13:48,220
قبل أن تتمدّد بشكل كامل، صحيح؟

233
00:13:48,950 --> 00:13:54,590
إن كان المقعد في المكان المناسب، يمكن
.استعمال عضلات السّاقين بشكل كامل

234
00:13:55,010 --> 00:13:57,110
،لكن إن كان منخفضًا للغاية
،فلا يمكن مدّ السّاقين

235
00:13:57,110 --> 00:13:59,690
.وتكون طريقة استعمال العضلات محدودة حينها

236
00:13:59,690 --> 00:14:02,940
.بعبارات أخرى، إنّها لا تستفيد من عضلاتها بشكل أفضل

237
00:14:03,370 --> 00:14:07,310
يمكن تدبّر الأمر على طريق منبسطة
.بغضّ النّظر على ارتفاع المقعد

238
00:14:07,310 --> 00:14:11,440
لكن عند تسلّق التّلال، نحتاج للاستفادة
،من عضلاتنا بشكل كامل

239
00:14:11,440 --> 00:14:13,620
.لذلك يصبح ارتفاع المقعد مهمًّا

240
00:14:15,140 --> 00:14:19,960
،كان المقعد جدّ منخفضٍ من أجل مايهارو-سان
.لذلك أصبح أسوأ بكثير لأزوما-سان

241
00:14:20,490 --> 00:14:25,490
تستعمل أزوما-سان عضلاتها بشكل جزئيّ
.فقط، بينما تستعملها مايهارو-سان بالكامل

242
00:14:25,490 --> 00:14:27,630
.هذا هو ما يمكن وصفه بالإنصاف

243
00:14:37,340 --> 00:14:38,640
.لم يكن من المفترض أن يحدث هذا

244
00:14:40,910 --> 00:14:44,070
.بدأ هذا يصبح أصعب

245
00:14:44,530 --> 00:14:46,650
.أظنّ أنّي في منتصف الطّريق

246
00:14:46,650 --> 00:14:48,400
أين هي أزوما-سينباي؟

247
00:14:50,470 --> 00:14:52,820
.تبدو غاضبة للغاية

248
00:14:52,820 --> 00:14:54,280
.لكنّي بعيدة عنها

249
00:14:57,700 --> 00:15:00,410
!هيرومي-سان، انتقلي لمسنّن سفليّ

250
00:15:00,410 --> 00:15:01,470
ماذا؟ أنتقل؟

251
00:15:01,470 --> 00:15:03,850
هل هذا هو؟

252
00:15:05,850 --> 00:15:07,920
.هذا مذهل

253
00:15:07,920 --> 00:15:10,480
.أصبح هذا أسهل من قبل

254
00:15:10,480 --> 00:15:12,640
.قد أكون قادرة على الفوز

255
00:15:14,790 --> 00:15:15,940
.سُحقًا

256
00:15:15,940 --> 00:15:17,930
.لن أسمح للأمر بأن ينتهي هكذا

257
00:15:18,440 --> 00:15:24,310
ما زال بإمكاني استعمال ساقيّ إن فعلتُ هذا
.حتّى إن لم يكن مسموحًا لي بالوقوف

258
00:15:27,580 --> 00:15:28,360
.ليست سيّئة

259
00:15:32,820 --> 00:15:34,340
.لحقت بها

260
00:15:34,340 --> 00:15:34,990
.الهدف في مرماي

261
00:15:35,990 --> 00:15:37,740
!هيرومي، تشجّعي

262
00:15:38,060 --> 00:15:39,190
!هيروكو

263
00:15:39,190 --> 00:15:40,470
!توشكين على الوصول

264
00:15:44,200 --> 00:15:45,670
.أكاد أصل

265
00:15:45,670 --> 00:15:47,380
.يمكنني أن أنجح

266
00:15:47,380 --> 00:15:50,040
!سيأخذن هيغا-سان إن خسرت

267
00:15:50,040 --> 00:15:51,880
!لا يمكنني أن أسمح بذلك

268
00:15:54,200 --> 00:15:55,300
.أكاد أصل

269
00:15:57,760 --> 00:15:59,220
!أنا وشيكة

270
00:16:00,350 --> 00:16:03,310
!وصلت

271
00:16:16,550 --> 00:16:17,950
...هيرومي-سان

272
00:16:19,560 --> 00:16:21,160
.لقد فزت

273
00:16:23,230 --> 00:16:25,130
.خسرت

274
00:16:25,730 --> 00:16:27,150
.أحسنت يا هيروكو

275
00:16:27,150 --> 00:16:29,450
.عرفنا أنّ بإمكانك الفوز

276
00:16:30,410 --> 00:16:31,880
.كان ذلك واضحًا

277
00:16:33,320 --> 00:16:35,040
.آسفة يا هيغا-سان

278
00:16:35,040 --> 00:16:37,970
.سيكون عليك الانضمام لنادي السّباحة بسببي

279
00:16:39,710 --> 00:16:41,310
من قال أيّ شيء بشأن ذلك؟

280
00:16:41,620 --> 00:16:45,520
ماذا؟ أليس ذلك ما كنّا نتسابق من أجله؟

281
00:16:45,520 --> 00:16:49,940
.كلاّ. لا يسعنا فعل شيء إن انضمّت لنادٍ آخر

282
00:16:49,940 --> 00:16:54,200
لم نستطع أن نسمح لكُنّ بأخذ
.عضوة نادينا المحتملة بالمجّان

283
00:16:55,030 --> 00:16:58,200
ويساورني شعور أفضل بشأن
.تركها تنضمّ لكُنّ بعد فوزي أيضًا

284
00:16:58,200 --> 00:17:02,040
هل تقولين أنّه يمكن لهيغا-سان
الانضمام لنادي الدّرّاجات؟

285
00:17:02,040 --> 00:17:03,470
.إنّها حرّة لتقوم بما ترغب به

286
00:17:04,810 --> 00:17:06,520
.نجحنا يا هيغا-سان

287
00:17:06,520 --> 00:17:11,450
نعم، رغم أنّي ما كنتُ لأنسحب
.سواء فزتِ أم لا

288
00:17:11,450 --> 00:17:12,340
فعلاً؟

289
00:17:12,340 --> 00:17:14,260
.شكرًا لأنّك بذلت جهدك

290
00:17:15,770 --> 00:17:16,380
.العفو

291
00:17:16,950 --> 00:17:19,510
.هيروكو، أنت قاسية للغاية

292
00:17:19,510 --> 00:17:21,810
.تحبّين المنافسة كثيرًا

293
00:17:21,810 --> 00:17:23,080
ما الخطب في ذلك؟

294
00:17:23,080 --> 00:17:26,390
من الممتع تجربة أشياء أخرى عدا
.سباقات السّباحة من وقت لآخر

295
00:17:26,390 --> 00:17:27,400
.كان ذلك ممتعًا

296
00:17:27,880 --> 00:17:28,680
.أكيد

297
00:17:31,980 --> 00:17:34,290
.انظرا خلفكما

298
00:17:34,290 --> 00:17:34,990
ماذا؟

299
00:17:37,410 --> 00:17:39,810
.يمكنني رؤية الطّريق حتّى المحيط

300
00:17:39,810 --> 00:17:41,560
.مذهل

301
00:17:41,560 --> 00:17:45,960
لم أدرك أنّ بإمكاني مشاهدة هذا المنظر
.عندما كنت في أسفل التّلّة

302
00:17:46,620 --> 00:17:51,940
يمكن رؤية منظر مختلف تمامًا بمجرّد
.صعود تلّة صغيرة كهذه

303
00:17:52,420 --> 00:17:57,630
هنالك أشياء لن نعرفها أو نراها
.أبدًا ما لم نذهب إليها

304
00:17:58,000 --> 00:18:01,580
.هنالك أشياء تعلّمتها منذ أن بدأت السّباحة

305
00:18:01,580 --> 00:18:03,630
،بما أنّكنّ أنشأتنّ ناديًا الآن

306
00:18:03,630 --> 00:18:06,730
عليكنّ أن تختبرن أشياء ما كنتنّ
.لتعرفنها في حالات أخرى

307
00:18:06,730 --> 00:18:07,890
.نعم

308
00:18:08,350 --> 00:18:11,560
.لكنّنا سنأخذ هيغا-سان إن تمّ حلّ ناديكنّ

309
00:18:11,560 --> 00:18:12,320
ماذا؟

310
00:18:12,320 --> 00:18:14,660
!لا-لا يمكن ذلك

311
00:18:15,310 --> 00:18:16,150
!هيرومي

312
00:18:17,310 --> 00:18:18,570
هل خسرتِ؟

313
00:18:18,570 --> 00:18:21,030
.نعم، لكن لا بأس بذلك

314
00:18:21,030 --> 00:18:24,030
.أحسنت بركوبك لدرّاجة طرق

315
00:18:24,610 --> 00:18:27,420
...لكنّ مؤخّرتي تؤلمني بشدّة

316
00:18:27,420 --> 00:18:29,940
.لا بدّ أنّها انقسمت لنصفين

317
00:18:29,940 --> 00:18:30,900
...كلاّ

318
00:18:30,900 --> 00:18:31,880
.يمكنكنّ النّجاح

319
00:18:39,180 --> 00:18:40,900
.ها هي ذي

320
00:18:42,100 --> 00:18:45,060
.آسفة يا أختي. شكرًا على الانتظار

321
00:18:46,680 --> 00:18:50,210
.سررت بلقائكنّ جميعًا. أنا أكيزوكي يويكا

322
00:18:50,210 --> 00:18:52,270
.ماذا؟ أنت الفتاة الّتي قابلتُها في ذلك اليوم

323
00:18:52,270 --> 00:18:54,150
!هذه أنت

324
00:18:54,150 --> 00:18:55,930
ماذا؟ هل تعرفان بعضكما؟

325
00:18:55,930 --> 00:18:59,230
.نعم، لقد قابلتُها عندما ضعت في ذلك اليوم

326
00:18:59,230 --> 00:19:00,660
.شكرًا على المساعدة

327
00:19:01,020 --> 00:19:02,370
.لا شكر على واجب

328
00:19:02,370 --> 00:19:06,180
ما الّذي أردتِ أن ترينا إيّاه يا يويكا؟

329
00:19:06,180 --> 00:19:10,230
صحيح. لقد أنشأتنّ نادي درّاجات
معًا، أليس كذلك؟

330
00:19:10,230 --> 00:19:12,130
...لذلك فكّرت في أنّكنّ قد تحتجن لهذا

331
00:19:12,520 --> 00:19:15,510
.مفاجأة! زيّ موحّد لنادي الدّرّاجات

332
00:19:15,510 --> 00:19:16,590
زيّ موحّد؟

333
00:19:17,010 --> 00:19:19,590
.صمّمتُ هذا لترتدينه

334
00:19:19,980 --> 00:19:22,590
هنالك أزياء موحّدة دائمًا في النّوادي، صحيح؟

335
00:19:23,090 --> 00:19:24,580
!إنّها ورديّة! ورديّة

336
00:19:24,580 --> 00:19:26,280
.إنّها مبهرجة وظريفة

337
00:19:26,280 --> 00:19:29,290
هنالك قلوب بأجنحة ملائكة؟
.كم هذا ظريف

338
00:19:29,290 --> 00:19:31,900
.يا له من تصميم رائع

339
00:19:32,780 --> 00:19:34,610
زيّ موحّد؟

340
00:19:34,610 --> 00:19:37,780
.صحيح. علينا أن نمتلك واحدًا

341
00:19:37,780 --> 00:19:42,030
.أجل! لنختر هذا التّصميم بما أنّه أعجبكنّ جميعًا

342
00:19:42,450 --> 00:19:43,560
.أجل

343
00:19:43,560 --> 00:19:45,200
.شكرًا يا يويكا-تشان

344
00:19:45,510 --> 00:19:47,800
.أنا سعيدة لأنّه أعجبكنّ

345
00:19:47,800 --> 00:19:53,580
!حسنًا. نادي درّاجات مينامي كاماكورا للفتيات جاهز

346
00:19:53,580 --> 00:19:55,210
!نخبكنّ

347
00:21:30,140 --> 00:21:31,650
تمّ حلّه؟

348
00:21:31,650 --> 00:21:32,520
ماذا؟

349
00:21:32,520 --> 00:21:34,030
لماذا؟

350
00:21:36,180 --> 00:21:39,930
منظر درّاجات الطّريق بكامل المعدّات يجعل
.المرء يرغب بالشّروع في ركوبها من الغد

351
00:21:40,340 --> 00:21:43,310
.فقرة جانبيّة: أوّل نادٍ للدّرّاجات

352
00:21:44,470 --> 00:21:48,550
سنقدّم لكم في هذه الفقرة معلومات
...مهمّة لركوب الدّرّاجات للمبتدئين في

353
00:21:48,550 --> 00:21:50,730
...الفقرة الجانبيّة لفوكوو يوي

354
00:21:50,730 --> 00:21:52,970
.وهيروسي يوكي

355
00:21:54,700 --> 00:21:58,210
بما أنّه لديّ درّاجة طرق الآن وكلّ المعدّات"
"!الضّروريّة، أصبحت جاهزة للانطلاق

356
00:21:59,260 --> 00:22:03,310
".لكن هنالك الكثير من منتجات الدّرّاجات الأخرى"

357
00:22:04,410 --> 00:22:07,750
".لنحصل على كلّ شيء آخر نحتاجه لركوب أكثر راحة"

358
00:22:07,750 --> 00:22:09,430
سنتعرّف في هذه الحلقة

359
00:22:09,430 --> 00:22:13,810
على أغراض مفيدة لجعل
.ركوب الدّرّاجة تجربة مريحة أكثر

360
00:22:14,430 --> 00:22:19,600
أيّ نوع من المنتجات علينا أن نحصل عليها
من أجل تجربة ركوب مريحة أكثر؟

361
00:22:19,600 --> 00:22:25,690
هنالك الكثير من الأغراض المفيدة
.المتوفّرة للدّرّاجات وهذا أحدها

362
00:22:25,690 --> 00:22:31,300
بشكل مبدئيّ، يجب ركوب الدّرّاجات
،على الجانب الأيسر من الطّريق

363
00:22:31,300 --> 00:22:32,580
.لذلك سيكون من المناسب امتلاك مرآة

364
00:22:32,580 --> 00:22:34,330
.إنّها مرآة يمكن ارتداؤها

365
00:22:34,330 --> 00:22:37,620
.يمكن إرفاقها باليد اليمنى

366
00:22:35,710 --> 00:22:36,860
.يبدو هذا مثيرًا للاهتمام

367
00:22:36,860 --> 00:22:37,620
.سأجرّبها

368
00:22:38,210 --> 00:22:39,830
يمكنني رؤية فوكوو. أين هي؟

369
00:22:39,830 --> 00:22:41,320
إنّها بعيدة بذلك القدر منّي؟

370
00:22:41,320 --> 00:22:42,300
.هذا مذهل

371
00:22:42,300 --> 00:22:45,330
يمكن للاستدارة أن تضع الرّاكب
في وضع غير مريح

372
00:22:45,330 --> 00:22:46,930
،قد يتسبّب بخسارة توازنه

373
00:22:46,930 --> 00:22:49,170
.لذلك يصبح من المفيد امتلاك مرآة جانبيّة

374
00:22:49,170 --> 00:22:52,020
.وهنالك هذه العلبة أيضًا

375
00:22:52,490 --> 00:22:53,970
ما هي؟ ما هي؟

376
00:22:53,970 --> 00:22:57,080
إنّها حاملة هاتف ذكيّ يمكنها السّماح لكما
.باستعمال هاتفكما من خلالها

377
00:22:56,090 --> 00:22:57,080
حقًّا؟

378
00:22:57,080 --> 00:22:59,520
،إن أشعلتما مصباح هاتفكما الخلفي

379
00:22:59,520 --> 00:23:03,310
،يمكنكما قراءة الخرائط في اللّيل
.لذلك يُنصح بهذا الغرض كثيرًا

380
00:23:03,310 --> 00:23:05,940
.يبدو أنّ هذا سيجعل ركوب الدّرّاجات أكثر متعة

381
00:23:05,940 --> 00:23:07,500
.إنّه غرض يجب شراؤه

382
00:23:07,500 --> 00:23:08,980
.نعم، هو كذلك

383
00:23:08,980 --> 00:23:14,990
.هنالك غرض أخير أنصح به وهو حاسوب درّاجات

384
00:23:15,300 --> 00:23:16,410
حاسوب؟

385
00:23:15,910 --> 00:23:16,410
.نعم

386
00:23:16,410 --> 00:23:20,120
.أوّلاً، فهو يسمح بمراقبة السّرعة الّتي تسيران بها

387
00:23:20,120 --> 00:23:20,920
.مثير للاهتمام

388
00:23:20,920 --> 00:23:24,630
يمكنكما أيضًا مراقبة المسافة الّتي انتقلتماها
.والسّعرات الحراريّة الّتي حرقتماها

389
00:23:24,630 --> 00:23:25,870
.يبدو ذلك محفّزًا

390
00:23:25,870 --> 00:23:27,340
.نعم، إنّه كذلك

391
00:23:27,340 --> 00:23:31,810
.إنّه أداة لياقة جيّدة، لذلك أظنّ أنّه من المفيد امتلاكه

392
00:23:29,630 --> 00:23:35,010
في الحلقة القادمة
التّعامل مع الحوادث 1

393
00:23:31,810 --> 00:23:35,010
.تحبّ الفتيات مراقبة سعراتهنّ الحراريّة

394
00:23:35,010 --> 00:23:40,020
في الحلقة القادمة
"اختيار الدّرّاجة أمر صعب؟"