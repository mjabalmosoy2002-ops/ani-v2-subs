1
00:01:50,470 --> 00:01:52,360
!سـ-سـأنفصل عن المجموعة

2
00:01:53,410 --> 00:01:54,890
!شكرًا على المساعدة حتّى الآن

3
00:01:54,890 --> 00:01:56,220
!اهتممن بالباقي

4
00:01:57,150 --> 00:02:00,850
.إنّه دوري أخيرًا. سوف أنطلق

5
00:02:04,220 --> 00:02:09,190
تبلغ مجموعة المبتدئات من سباق
.مينامي كاماكورا اللّيليّ قمّتها

6
00:02:09,730 --> 00:02:12,020
،ومع بقاء دورتين فقط

7
00:02:12,020 --> 00:02:14,110
نرى أنّ السّيّد دبّ من نادي الكوسبلاي
.ما يزال في المقدّمة

8
00:02:14,110 --> 00:02:17,950
وتتبعه مجموعة من تلميذات السّنة الأولى
.المتجمّعة حول نادي الدّرّاجات

9
00:02:17,950 --> 00:02:19,450
ولدينا خلفها

10
00:02:19,450 --> 00:02:22,700
.مجموعة مختلطة من تلميذات السّنة الثّانية والثّالثة

11
00:02:25,840 --> 00:02:29,480
يبدو أنّ مجموعة السّنة الأولى تحاول اللّحاق بالرّكب

12
00:02:29,480 --> 00:02:32,550
عن طريق جعل الرّاكبات يسحبن المجموعة
.إلى أن يتعبن وينفصلن عنها بعدها

13
00:02:32,550 --> 00:02:37,050
كم من هؤلاء الرّاكبات ستكنّ قادرات
على اللّحاق بالسّيّد دبّ؟

14
00:02:37,910 --> 00:02:41,840
.أفرمل هنا وأتّجه إلى عمود النّور

15
00:02:43,180 --> 00:02:44,250
!ثمّ أستدير

16
00:02:45,560 --> 00:02:48,430
.أدوّس بأقصى ما لديّ حتّى الزّاوية التّالية

17
00:02:51,690 --> 00:02:52,590
فويوني-سان؟

18
00:02:53,000 --> 00:02:55,730
!تشنّجت ساقي

19
00:02:56,440 --> 00:02:58,070
هـ-هل أنت بخير؟

20
00:02:58,410 --> 00:03:01,030
...أنا آسفة. إنّها تؤلمني كثيرًا

21
00:03:03,120 --> 00:03:05,490
.شكرًا لك يا فويوني-سان. يمكنك التّراجع

22
00:03:05,960 --> 00:03:07,660
.اتبعاني أنتما الاثنتان

23
00:03:07,990 --> 00:03:10,100
.لكن لا يمكننا ترك فويوني-تشان

24
00:03:10,100 --> 00:03:12,850
.لا تقلقي بشأني. اذهبن فحسب يا هيرومي

25
00:03:12,850 --> 00:03:14,170
...فويوني-تشان

26
00:03:14,510 --> 00:03:16,390
.البقيّة بين يديك

27
00:03:17,550 --> 00:03:19,630
.حسنًا. سأواصل الرّكوب

28
00:03:19,630 --> 00:03:22,510
.سأواصل الرّكوب بكلّ قوّتي من أجلك أيضًا

29
00:03:23,800 --> 00:03:24,850
.لننطلق

30
00:03:27,550 --> 00:03:28,890
.حظًّا سعيدًا

31
00:03:33,810 --> 00:03:35,440
...مقاومة الهواء

32
00:03:41,150 --> 00:03:42,730
.صوت الرّياح مختلف

33
00:03:43,260 --> 00:03:44,990
.هذا هو ما يعنيه أن أقود

34
00:03:45,770 --> 00:03:49,200
لم تكن لي أدنى فكرة أنّ عدم وجود
.أحد أمامي قد يشعرني بالوحدة

35
00:03:49,920 --> 00:03:52,490
أكيزوكي-سان، هل أنت بخير؟

36
00:03:53,040 --> 00:03:55,000
.نعم، أنا بخير

37
00:03:55,720 --> 00:03:57,960
.إنّه دوري لبذل كلّ ما لديّ

38
00:03:58,750 --> 00:04:01,550
!لننطلق يا رفيقتاي! جارياني

39
00:04:04,790 --> 00:04:05,470
.فهمت

40
00:04:05,950 --> 00:04:10,000
إنّهنّ يحافظن على سرعتهنّ عن طريق
.جعل قائداتهنّ ينفصلن عن المجموعة

41
00:04:10,000 --> 00:04:11,190
.هذا سيّئ

42
00:04:11,190 --> 00:04:13,940
.لن نستطيع اللّحاق بهنّ إن تقدّمن للأمام أكثر

43
00:04:13,940 --> 00:04:15,310
.هيّا يا هيروكو

44
00:04:16,220 --> 00:04:18,480
.سأسدّ طريق تلميذات السّنة الثّالثة

45
00:04:18,480 --> 00:04:20,070
.اذهبي خلف نادي الدّرّاجات

46
00:04:20,720 --> 00:04:21,870
...ميكاكو

47
00:04:21,870 --> 00:04:24,270
.لا وقت للحديث

48
00:04:24,270 --> 00:04:25,570
.إمّا الآن أو أبدًا

49
00:04:26,860 --> 00:04:30,770
!حسنًا، سآخذ هذه الطّريق

50
00:04:31,250 --> 00:04:32,750
!مع السّلامة يا ميكاكو

51
00:04:32,750 --> 00:04:34,380
!انطلقي

52
00:04:34,380 --> 00:04:35,810
...والآن

53
00:04:35,810 --> 00:04:37,730
يا عضوة نادي السّباحة الخفيفة
!من السّنة الأولى، سوغيتا

54
00:04:38,260 --> 00:04:39,550
نعم أيّتها القائدة؟

55
00:04:39,900 --> 00:04:43,050
.لديّ وظيفة أخرى لك

56
00:04:43,720 --> 00:04:46,430
لقد بدأ السّباق يتحرّك

57
00:04:46,430 --> 00:04:47,160
!بسرعة مذهلة

58
00:04:47,160 --> 00:04:50,880
تلاحق عضوات نادي الدّرّاجات السّيّد دبّ
.الّذي يتقدّم السّباق بكلّ قوّة

59
00:04:50,880 --> 00:04:54,640
.بدأت أزوما-سان من السّنة الثّانية هجومها أيضًا

60
00:04:55,090 --> 00:04:56,350
في هذه الأثناء، طريق السّنة الثّالثة

61
00:04:56,350 --> 00:04:59,110
.قد سُدّ من طرف راكبات قد تراجعن

62
00:04:59,110 --> 00:05:02,070
.إنّهنّ غير قابلات على اللّحاق بالرّاكبات اللاّتي في المقدّمة

63
00:05:02,070 --> 00:05:05,610
ألا يعدّ ذلك تدخّلاً؟

64
00:05:05,610 --> 00:05:11,700
قيادة المجموعة والتّحكّم في وتيرتها
.هي ممارسة أساسيّة في سباقات الدّرّاجات

65
00:05:11,700 --> 00:05:14,900
...فعلاً؟ هذا يعني

66
00:05:14,900 --> 00:05:15,720
.صحيح

67
00:05:15,720 --> 00:05:21,650
القتال من أجل المركز الأوّل قد حُدّد بين
.السّيّد دبّ وأزوما-سان ونادي الدّرّاجات

68
00:05:25,410 --> 00:05:28,070
...لا أستطيع الاستمرار

69
00:05:29,360 --> 00:05:30,830
...هيرومي، ناتسومي-سان

70
00:05:30,830 --> 00:05:33,040
!سأترك الباقي لكما

71
00:05:33,040 --> 00:05:34,020
...أكيزوكي-سان

72
00:05:34,900 --> 00:05:36,100
.أبليت حسنًا

73
00:05:36,100 --> 00:05:37,920
.شكرًا يا تومو-تشان

74
00:05:37,920 --> 00:05:39,780
!حظًّا سعيدًا لكما

75
00:05:40,470 --> 00:05:42,580
أما تزالين على ما يرام يا مايهارو-سان؟

76
00:05:42,580 --> 00:05:43,730
.أنا بخير

77
00:05:43,730 --> 00:05:46,380
.سهّلت كلّ واحدة منهنّ الأمر لنا

78
00:05:46,900 --> 00:05:48,200
.أنا جاهزة للذّهاب

79
00:05:48,930 --> 00:05:49,830
.أنت على حقّ

80
00:05:50,340 --> 00:05:56,940
علينا أن نتجاوز السّيّد دبّ ونحتلّ
!المركز الأوّل من أجل الأخريات

81
00:05:56,940 --> 00:05:57,700
!أجل

82
00:06:02,770 --> 00:06:06,720
.هذا مؤلم... هذا مثير للشّفقة

83
00:06:06,720 --> 00:06:10,680
.لديّ درّاجة رائعة، لكنّ جسدي لا يستطيع المجاراة

84
00:06:11,840 --> 00:06:14,040
.لم أكن ذات فائدة

85
00:06:14,040 --> 00:06:16,140
.هذا ليس صحيحًا

86
00:06:16,730 --> 00:06:21,150
تلاحق هيرومي وناتسومي-سان
.متقدّم السّباق الآن وهذا بفضلك

87
00:06:21,150 --> 00:06:22,550
...أكيزوكي-سان

88
00:06:22,550 --> 00:06:25,570
كما أنّي لم أستطع حتّى الاستمرار
.إلى أن تتشنّج سافيّ

89
00:06:26,070 --> 00:06:27,760
عمّاذا تتحدّثين؟

90
00:06:27,760 --> 00:06:30,530
.قيادتك كانت مبهرة للغاية

91
00:06:30,530 --> 00:06:32,300
.يمكننا أن نتهاون الآن

92
00:06:32,300 --> 00:06:34,530
.لنتّجه إلى خطّ النّهاية أيضًا

93
00:06:34,530 --> 00:06:35,580
.معك حقّ

94
00:06:36,990 --> 00:06:38,120
زهور الكرز؟

95
00:06:39,010 --> 00:06:41,450
.ما زالت هنالك أشجار كرز مزهرة في مكان ما

96
00:06:47,350 --> 00:06:49,170
.بدأ الألم يصبح أسوأ

97
00:06:50,500 --> 00:06:51,510
!ناتسومي-تشان

98
00:06:51,510 --> 00:06:54,220
!أزوما-سينباي خلفنا مباشرة

99
00:06:54,620 --> 00:06:55,520
.نعم

100
00:06:55,520 --> 00:06:58,600
،لكن بمجرّد أن نتجاوز هذه الاستدارة
.سيكون أمامنا طريق مستقيم

101
00:06:58,600 --> 00:07:02,560
.ولدينا الأفضليّة بما أنّنا نركب كثنائيّ

102
00:07:02,560 --> 00:07:06,480
ماذا؟ هل الرّكوب وحيدًا أثّر به أخيرًا؟

103
00:07:06,800 --> 00:07:09,960
.لم يعد السّيّد دبّ يركب بنفس القوّة

104
00:07:09,960 --> 00:07:13,230
.المسافة بينه وبين نادي الدّرّاجات تتقلّص

105
00:07:13,230 --> 00:07:14,830
.يبدو أنّ السّيّد دبّ يعاني

106
00:07:15,150 --> 00:07:18,830
.لقد تجاوزوا البوّابة ودخلوا دورتهم الأخيرة

107
00:07:18,830 --> 00:07:20,100
!الدّورة الأخيرة

108
00:07:20,100 --> 00:07:21,340
!حظًّا سعيدًا

109
00:07:21,340 --> 00:07:22,960
!يمكنكما النّجاح

110
00:07:22,960 --> 00:07:25,790
.مايهارو-سان، لنلحق بالسّيّد دبّ

111
00:07:25,790 --> 00:07:26,920
!اتبعيني

112
00:07:26,920 --> 00:07:27,710
!مفهوم

113
00:07:30,480 --> 00:07:31,430
...قليلاً فحسب

114
00:07:31,430 --> 00:07:33,390
.عليّ أن أتحمّل الأمر قليلاً بعد

115
00:07:34,090 --> 00:07:37,680
.بلغ ثنائيّ نادي الدّرّاجات المقدّمة أخيرًا

116
00:07:37,680 --> 00:07:40,600
هل ستتمكّنان من تجاوز السّيّد دبّ؟

117
00:07:40,600 --> 00:07:42,460
!مايهارو-سان، على يميني

118
00:07:42,460 --> 00:07:43,190
!في الحال

119
00:07:45,610 --> 00:07:46,230
دبّ؟

120
00:07:46,230 --> 00:07:47,730
!دبّ

121
00:07:49,690 --> 00:07:50,490
دبّ؟

122
00:07:52,280 --> 00:07:56,070
!دبّ

123
00:07:56,070 --> 00:07:57,450
!إنّهما رائعتان

124
00:07:57,450 --> 00:08:01,000
.تلميذاتك يتعلّمن يا أختي

125
00:08:01,000 --> 00:08:02,660
!دبّ

126
00:08:01,000 --> 00:08:03,940
احتلّت هيغا-سان ومايهارو-سان المقدّمة

127
00:08:02,830 --> 00:08:05,960
!دبّ! دبّ، دبّ! دبّ

128
00:08:03,940 --> 00:08:05,960
.وتوسّعان المسافة بينهما وبين السّيّد دبّ

129
00:08:08,760 --> 00:08:11,880
.آسفة يا مايهارو-سان. هذا أقصى ما لديّ

130
00:08:11,880 --> 00:08:14,420
ناتسومي-تشان، هل يؤلمك كتفك؟

131
00:08:14,420 --> 00:08:16,890
.أنا بخير. لا تقلقي بشأني

132
00:08:17,480 --> 00:08:21,790
.سأصل إلى خطّ النّهاية، وبعدها سأعود للمنزل

133
00:08:21,790 --> 00:08:25,810
.لذلك انطلقي. إنّها آخر دورة

134
00:08:27,080 --> 00:08:29,940
!اركبي من أجل الأخريات يا مايهارو-سان

135
00:08:31,140 --> 00:08:32,950
.مفهوم يا ناتسومي-تشان

136
00:08:32,950 --> 00:08:35,820
.لقد أوصلتني الأخريات إلى هذه المرحلة

137
00:08:36,470 --> 00:08:40,000
!من الآن فصاعدًا، سأبذل ما أستطيعه

138
00:08:40,560 --> 00:08:44,020
.تتقدّم مايهارو-سان بمفردها

139
00:08:44,020 --> 00:08:45,670
هل هذا هو الإسراع الأخير؟

140
00:08:45,670 --> 00:08:48,840
.هنالك استدارة بمائة وثمانين درجة أمامها

141
00:08:49,380 --> 00:08:51,170
...ما يمكنني فعلها

142
00:08:51,170 --> 00:08:58,050
كلاّ، الشّيء الّذي لا يستطيع أحد غير فعله
!الآن... هو الرّكوب بأقصى ما لديّ

143
00:08:58,650 --> 00:09:00,350
.ها هي الاستدارة

144
00:09:00,350 --> 00:09:04,460
ما المسار الصّحيح؟ متى أستعمل الفرامل؟

145
00:09:05,230 --> 00:09:06,350
ماذا؟

146
00:09:06,350 --> 00:09:09,110
كيف كنتُ أقوم بذلك من قبل؟

147
00:09:11,110 --> 00:09:13,860
!نسيت

148
00:09:14,850 --> 00:09:17,700
.استعملي الفرامل عند عمود النّور يمينًا

149
00:09:20,660 --> 00:09:23,090
.لا تخافي يا هيرومي

150
00:09:29,930 --> 00:09:31,950
.حان وقت الإسراع

151
00:09:31,950 --> 00:09:33,010
!نعم

152
00:09:33,620 --> 00:09:37,220
...تومو-تشان، فويوني-تشان، ناتسومي-تشان

153
00:09:41,180 --> 00:09:43,140
.شكرًا لكنّ جميعًا

154
00:09:43,810 --> 00:09:45,430
!لننطلق معًا

155
00:09:46,350 --> 00:09:51,330
لقد التفّ الرّاكبان في المقدّمة على صالة
.الفنون القتاليّة ودخلا الطّريق المستقيم الأخير

156
00:09:51,330 --> 00:09:57,440
من سيكون أوّل من يُسابق في هذا الطّريق
المستقيم ويتجاوز بوّابة الوصول؟

157
00:09:59,700 --> 00:10:00,910
...ساقيّ

158
00:10:01,740 --> 00:10:03,330
كم يبعد السّيّد دبّ عنّي؟

159
00:10:03,330 --> 00:10:05,420
!شكرًا أيّها السّيّد دبّ

160
00:10:05,040 --> 00:10:05,790
دبّ؟

161
00:10:07,390 --> 00:10:08,790
أزوما-سينباي؟

162
00:10:09,180 --> 00:10:13,320
.جسده الضّخم يجعل منه أفضل متصدٍّ للرّياح

163
00:10:13,320 --> 00:10:15,740
.أنا في كامل قوّتي بفضلك أنت

164
00:10:15,740 --> 00:10:19,680
!لننطلق يا مايهارو هيرومي من نادي الدّرّاجات

165
00:10:21,570 --> 00:10:24,840
.لنستمتع بهذا الطّريق الأخير

166
00:10:24,840 --> 00:10:26,770
.أجل. سوف أستمتع

167
00:10:28,510 --> 00:10:29,770
.قدّمي أفضل ما لديك

168
00:10:34,150 --> 00:10:37,240
!دبّ، دبّ، دبّ

169
00:10:36,010 --> 00:10:38,200
!بقيت عشرون مترًا على خطّ النّهاية

170
00:10:38,200 --> 00:10:39,780
!انطلقي

171
00:10:41,280 --> 00:10:43,490
!عشرة أمتار

172
00:11:06,520 --> 00:11:10,300
!النّهاية

173
00:11:13,690 --> 00:11:20,240
!النّهاية

174
00:11:20,240 --> 00:11:26,330
!انتهى أوّل سباق ليليّ للمبتدئين لمينامي كاماكورا

175
00:11:26,330 --> 00:11:29,860
...والفائزة بهذا السّباق هي

176
00:11:31,090 --> 00:11:37,170
مايهارو هيرومي-سان من نادي الدّرّاجات
!في ثانويّة مينامي كاماكورا

177
00:11:40,480 --> 00:11:42,170
.نجحت يا هيرومي

178
00:11:42,170 --> 00:11:43,470
.لقد نجحت

179
00:11:43,470 --> 00:11:45,010
.لقد فزنا

180
00:11:45,420 --> 00:11:47,020
.أحسنت عملاً

181
00:11:47,020 --> 00:11:48,010
.تهانينا

182
00:11:49,370 --> 00:11:52,070
.لم أستطع اللّحاق بها في النّهاية

183
00:11:52,070 --> 00:11:54,520
كيف استطاعت زيادة سرعتا في آخر ثانية؟

184
00:11:54,980 --> 00:11:56,440
...دبّ

185
00:11:56,750 --> 00:12:00,900
.هنالك جائزة معتبرة للفائزة بالسّباق

186
00:12:01,360 --> 00:12:03,860
...الجائزة هي

187
00:12:04,270 --> 00:12:06,430
.تهانيّ يا مايهارو-سان

188
00:12:06,430 --> 00:12:09,240
!إطار درّاجة طُرق

189
00:12:11,270 --> 00:12:14,840
هذه درّاجة طُرق؟

190
00:12:15,970 --> 00:12:18,820
.إ-إنّه ظريف

191
00:12:37,550 --> 00:12:41,370
.هنالك أنوار كثيرة في كاماكورا

192
00:12:42,570 --> 00:12:45,030
هل هذه هي منارة إنوشيما؟

193
00:12:45,030 --> 00:12:48,530
هذا رائع أيّها الحصان. هل سنعبر المحيط؟

194
00:12:51,530 --> 00:12:55,410
.أمزح فحسب. هذا مستحيل

195
00:12:56,420 --> 00:12:58,340
.لا بدّ أنّه حلم

196
00:12:59,160 --> 00:13:00,570
.قد تكونين على حقّ

197
00:13:00,570 --> 00:13:02,750
تستطيع الكلام؟

198
00:13:03,200 --> 00:13:04,550
.بالطّبع

199
00:13:06,210 --> 00:13:07,750
.أنا أحلم إذًا

200
00:13:08,380 --> 00:13:12,970
...هل يعني ذلك أنّ احتلالي للمركز الأوّل كان أيضًا

201
00:13:12,970 --> 00:13:14,390
.كان ذلك حقيقيًّا

202
00:13:15,660 --> 00:13:17,670
.لقد احتللت المركز الأوّل

203
00:13:18,240 --> 00:13:23,780
.لكنّك لم تفعلي ذلك بمفردك. انظري

204
00:13:24,300 --> 00:13:25,700
!هيرومي

205
00:13:26,500 --> 00:13:27,750
...يا رفيقات

206
00:13:27,750 --> 00:13:32,960
.احتللت المركز الأوّل رفقة هؤلاء الفتيات

207
00:13:33,530 --> 00:13:35,570
.لا تنسيْ ذلك

208
00:13:36,530 --> 00:13:37,580
.بالطّبع

209
00:13:47,750 --> 00:13:49,860
!إنّه كبير

210
00:13:49,860 --> 00:13:56,340
،معك حقّ. العالم كبير
.لكن يمكننا الذّهاب لأيّ مكان معًا

211
00:13:56,340 --> 00:13:58,310
لأيّ مكان في العالم؟

212
00:13:58,310 --> 00:14:02,570
.صحيح. هذا ما دمتِ تتمنّين الذّهاب لأماكن أخرى

213
00:14:03,000 --> 00:14:09,140
يمكننا عبور تلال وجبال وأنهار
.وحتّى المحيط للسّفر لأماكن بعيدة

214
00:14:09,970 --> 00:14:13,340
.أنا واثق أنّنا سنعثر على أشياء لذيذة هناك

215
00:14:13,340 --> 00:14:16,300
ماذا؟ أشياء لذيذة؟

216
00:14:16,300 --> 00:14:17,240
!لا تتركيني

217
00:14:27,990 --> 00:14:28,980
هيرومي؟

218
00:14:28,980 --> 00:14:30,890
ما الّذي تفعلينه؟

219
00:14:32,640 --> 00:14:35,130
.سوف تغرقين إن نمت هناك

220
00:14:36,280 --> 00:14:39,390
.لا بدّ أنّك ما تزالين متعبة من البارحة

221
00:14:39,390 --> 00:14:41,650
.عليك التّخلّص من تعبك في هذا الحمّام

222
00:14:43,610 --> 00:14:47,100
.ماذا؟ كان حلمًا بالفعل

223
00:14:52,630 --> 00:14:54,330
.لقد انتهينا

224
00:14:55,000 --> 00:14:56,780
.شكرًا جزيلاً لك

225
00:14:56,780 --> 00:15:00,300
.حاولي ألاّ تحرّكيه كثيرًا لأسبوع من باب الحيطة

226
00:15:01,750 --> 00:15:02,420
.حاضرة

227
00:15:02,850 --> 00:15:06,630
،يمكنك ركوب درّاجتك
.لكن احذري من أن تؤذي نفسك

228
00:15:07,080 --> 00:15:12,340
.حسنًّا يا أمّ— أقصد، يا والدة مايهارو-سان

229
00:15:14,050 --> 00:15:15,670
.شكرًا لك

230
00:15:19,680 --> 00:15:21,380
.ماذا؟ هذه أنت

231
00:15:21,380 --> 00:15:23,020
ماذا؟ من؟ أنا؟

232
00:15:23,570 --> 00:15:25,270
.لا بدّ أنّك هيغا ناتسومي-سان

233
00:15:25,270 --> 00:15:28,740
هل سبق والتقينا من قبل؟

234
00:15:30,320 --> 00:15:31,450
.انظري لهذا

235
00:15:31,450 --> 00:15:33,870
...ماذا؟ هذه

236
00:15:33,870 --> 00:15:35,940
.إنّ العالم المعاصر مليء بالفرص المناسبة

237
00:15:35,940 --> 00:15:39,310
.يمكنني مشاهدة ما قمت به البارحة عبر هذا

238
00:15:39,750 --> 00:15:41,480
.فهمت

239
00:15:41,480 --> 00:15:43,420
.لم أقدّم نفسي بعد

240
00:15:45,400 --> 00:15:47,130
.أنا كاميكورا ري

241
00:15:47,130 --> 00:15:49,090
...كاميكورا؟ تقصدين

242
00:15:49,520 --> 00:15:52,260
.نعم، أنا أخت فويوني

243
00:15:56,340 --> 00:16:01,020
.لم أكن أتصوّر حتّى أن تركب فويوني درّاجة إلاّ مؤخّرًا

244
00:16:01,020 --> 00:16:03,040
فعلاً؟

245
00:16:03,040 --> 00:16:07,730
إنّها من الفتيات اللاّتي تشتكين
.من تشنّج ساقها بعد المشي قليلاً

246
00:16:09,070 --> 00:16:10,240
.معك حقّ

247
00:16:10,580 --> 00:16:11,570
...لكن

248
00:16:11,900 --> 00:16:19,290
لقد سألتني إن كان هنالك أيّ شيء
.أرغب به بينما كنتُ في المستشفى

249
00:16:20,310 --> 00:16:26,750
لذلك طلبتُ منها أن تريني أماكن
.ذهبت لرؤيتها على قدميها

250
00:16:27,290 --> 00:16:30,590
على قدميها؟ لذلك قرّرتْ ركوب الدّرّاجات؟

251
00:16:31,080 --> 00:16:32,780
.على الأرجح أنّ ذلك هو السّبب

252
00:16:33,210 --> 00:16:37,860
إنّها تحتفظ بآلة تصوير معها
.لأنّها تنصاع لأنانيّتي أيضًا

253
00:16:39,090 --> 00:16:42,770
لذلك أتمنّى أن تستمرّ صداقتكنّ
.مع فويوني يا هيغا-سان

254
00:16:43,420 --> 00:16:46,980
.أ-أجل! أنا أتطلّع لذلك أيضًا

255
00:16:47,730 --> 00:16:52,940
يمكنها أن تكون متهوّرة ولا تتقبّل
.الخسارة، لكنّها فتاة جيّدة

256
00:16:55,180 --> 00:16:57,230
هل أنت بخير يا فويوني-تشان؟

257
00:16:57,230 --> 00:16:58,330
أهو برد بسبب الحمّام؟

258
00:16:58,900 --> 00:17:02,120
.كلاّ. ربّما هنالك من يتحدّث عنّ في غيابي

259
00:17:07,000 --> 00:17:09,200
.هذا هو السّيّد دبّ من سباق البارحة

260
00:17:09,200 --> 00:17:11,850
بالتّفكير بالأمر، إنّه في نادي الكوسبلاي، صحيح؟

261
00:17:11,850 --> 00:17:15,930
لكن ما الّذي يقصدنه بعودة نشاطهنّ؟

262
00:17:15,930 --> 00:17:21,560
يبدو أنّ نادي الكوسبلاي شارك في حدث
.بعد الدّخول المدرسيّ بقليل

263
00:17:21,560 --> 00:17:26,920
لكنّهنّ أثرن غضب جدّتي لأنّ الأزياء الّتي ارتدينها

264
00:17:26,920 --> 00:17:29,270
.كانت مكشوفة للغاية بالنّسبة لتلميذات ثانويّة

265
00:17:29,900 --> 00:17:34,160
وبسبب ذلك، تمّ منعهنّ من المشاركة
.في أحداث خارج المدرسة لثلاثة أشهر

266
00:17:34,160 --> 00:17:36,560
لكنّ هذا الدّبّ كان في السباق، صحيح؟

267
00:17:36,560 --> 00:17:39,910
،معك حقّ. لقد احتلّ المركز الثّالث

268
00:17:39,910 --> 00:17:42,470
لكنّه كان في المقدّمة طوال
،السّباق حتّى الدّورة الأخيرة

269
00:17:42,470 --> 00:17:45,170
.لذلك فاز بجائزة خاصّة على روحه القتاليّة

270
00:17:45,170 --> 00:17:50,630
،لقد تمّ التّقليل من فترة منعهنّ
.لذلك سيعدن لنشاطهنّ اليوم

271
00:17:51,840 --> 00:17:53,710
فعلاً؟

272
00:17:55,960 --> 00:17:57,990
.أخبار ممتازة يا سيّد دبّ

273
00:18:01,840 --> 00:18:04,030
.تهطل الأمطار بغزارة

274
00:18:04,030 --> 00:18:06,860
لا يمكن لنادي الدّرّاجات القيام
.بأيّ شيء إذا كانت تمطر

275
00:18:06,860 --> 00:18:09,350
.أظنّ أنّ علينا الذّهاب للمنزل اليوم

276
00:18:11,420 --> 00:18:14,400
.على أيّ حال، لقد هطلت الأمطار فجأة

277
00:18:14,400 --> 00:18:18,000
.لقد بدأت تُمطر بمجرّد أن عبرنا خطّ النّهاية

278
00:18:18,000 --> 00:18:21,660
وبسبب الأمطار، تمّ إيقاف سباقَيْ
.المجموعتين المتوسّطة والمتقدّمة

279
00:18:21,660 --> 00:18:26,340
.أرادت شيكي-سينسي الفوز بشدّة أيضًا

280
00:18:26,340 --> 00:18:28,280
.لقد خاب ظنّها كثيرًا

281
00:18:28,280 --> 00:18:30,630
هل أرادت أن تتسابق لتلك الدّرجة؟

282
00:18:30,630 --> 00:18:32,280
.بالطّبع أرادت ذلك

283
00:18:32,280 --> 00:18:37,380
.لست واثقة من ذلك. ربّما أرادت الجائزة فحسب

284
00:18:38,760 --> 00:18:41,150
هل أنت بخير يا أختي؟

285
00:18:41,150 --> 00:18:42,860
هل أصبت بالزّكام؟

286
00:18:42,860 --> 00:18:46,220
.كلاّ... أظنّ أنّ هنالك من يتحدّث عنّي في غيابي

287
00:18:46,550 --> 00:18:49,160
.على أيّ حال، كان الأمر مخيّبًا للآمال

288
00:18:49,160 --> 00:18:52,080
.لا أصدّق أنّها بدأت تُمطر حينها

289
00:18:52,080 --> 00:18:53,370
.معك حقّ

290
00:18:53,370 --> 00:18:58,640
كان من المفترض لجائزة مجموعتي
.أن تكون مجموعة أجزاء درّاجات جديدة

291
00:18:58,640 --> 00:19:00,880
.ليتك فزت بذلك

292
00:19:00,880 --> 00:19:02,690
.ما زال بإمكانك الحصول عليها

293
00:19:03,750 --> 00:19:08,250
تريدين الأجزاء والهيكل بالمجّان، صحيح؟

294
00:19:08,250 --> 00:19:14,670
سأطلب من زبائني المعتادين أن يحضروا
.أجزاءً ما عادوا يستعملونها

295
00:19:15,250 --> 00:19:16,580
أأنت واثقة؟

296
00:19:16,580 --> 00:19:21,550
.نعم، يشتري جميعهم الأجزاء الجديدة عندما تتوفّر

297
00:19:21,550 --> 00:19:25,400
لا بدّ أنّ لديهم الكثير من الأجزاء
.الإضافيّة الّتي ليست قديمة كثيرًا

298
00:19:25,400 --> 00:19:27,140
.شكرًا يا مديرة المحلّ

299
00:19:28,060 --> 00:19:29,800
.لا داعي للشّكر

300
00:19:29,800 --> 00:19:34,270
.كنت أرغب بمنح درّاجة سريعة لمايهارو-تشان أيضًا

301
00:19:35,570 --> 00:19:41,300
فقبل كلّ شيء، هذا هو الهيكل الوحيد
.الّذي أحبّته مايهارو-تشان صعبة الإرضاء

302
00:19:41,710 --> 00:19:45,960
.لا أصدّق أنّها فازت بهذا الهيكل

303
00:19:45,960 --> 00:19:48,130
.إنّها فتاة محظوظة

304
00:19:48,130 --> 00:19:49,780
.استمعا أنتما

305
00:19:50,200 --> 00:19:54,690
.لا تخبرا مايهارو-تشان أنّي أجمع هذه الدّرّاجة

306
00:19:54,690 --> 00:19:56,080
.نعلم ذلك

307
00:19:56,080 --> 00:19:58,500
سوف تكون مفاجأة، صحيح؟

308
00:19:59,070 --> 00:19:59,840
.صحيح

309
00:20:00,410 --> 00:20:03,940
.أنا متحمّسة سلفًا لرؤيتها وهي متفاجئة

310
00:21:36,100 --> 00:21:40,130
منظر درّاجات الطّريق بكامل المعدّات يجعل
.المرء يرغب بالشّروع في ركوبها من الغد

311
00:21:40,130 --> 00:21:43,180
.فقرة جانبيّة: أوّل نادٍ للدّرّاجات

312
00:21:44,390 --> 00:21:48,450
في هذه الفقرة، نقدّم لكم معلومات يجب
مشاهدتها من طرف المبتدئين لركوب الدّرّاجات

313
00:21:48,450 --> 00:21:50,660
...في الفقرة الجانبيّة مع هيروسي يوكي

314
00:21:50,660 --> 00:21:52,880
.وفوكوو يوي

315
00:21:54,000 --> 00:21:57,680
حتّى عندما يتعلّق الأمر بركوب الدّرّاجات بشكل
...مريح، فإن ركبتموها بالشّكل الخاطئ

316
00:21:58,180 --> 00:22:02,000
"!لا يمكنني تعمّل هذا! وركاي يؤلمانني"

317
00:22:02,720 --> 00:22:06,420
".كتفاي متشنّجان"

318
00:22:07,500 --> 00:22:11,970
.سنتعلّم هذه المرّة وضعيّة الرّكوب الصّحيحة

319
00:22:13,430 --> 00:22:19,430
هل يمكنك تعليمنا كيف نركب الدّرّاجة
بشكل يمنعنا من إصابة أجسادنا؟

320
00:22:19,430 --> 00:22:24,730
بما أنّي أملك درّاجة هنا، لنرَ ما يمكنكما
.فعله عن طريق ركوب الدّرّاجة بالفعل

321
00:22:24,730 --> 00:22:25,480
.حسنًا

322
00:22:25,480 --> 00:22:27,420
.سأركبها أنا إذًا

323
00:22:28,080 --> 00:22:30,130
.أوّلاً، أمسكي بالمقود

324
00:22:30,130 --> 00:22:30,740
.حسنًا

325
00:22:30,740 --> 00:22:33,180
.هذه وضعيّة الرّكوب العاديّة

326
00:22:33,180 --> 00:22:35,560
—في البداية، الرّكوب وذراعيك ممدودتان بالكامل

327
00:22:35,560 --> 00:22:36,280
هكذا؟

328
00:22:36,280 --> 00:22:41,750
.نعم، يميل النّاس لهذه الوضعيّة

329
00:22:41,750 --> 00:22:46,290
إنّها سهلة للغاية، ولكن لا يمكن المحافظة عليها طويلاً
.لأنّها تستعمل الكثير من العضلات الصّغيرة

330
00:22:46,290 --> 00:22:47,240
فعلاً؟ ما باليد حيلة؟

331
00:22:47,240 --> 00:22:52,390
،إنّها وضعيّة متعبة للرّكوب لمسافات طويلة

332
00:22:52,390 --> 00:22:56,970
لذلك إن كانت الأولويّة لركوب طويل
.ومريح، فعليك ثني مرفقيك قليلاً

333
00:22:57,350 --> 00:22:58,730
،يجعلك هذا تميلين للأمام

334
00:22:58,730 --> 00:23:01,710
لكنّه يسمح لك باستعمال العضلات الكبيرة في بطنك

335
00:23:01,710 --> 00:23:03,780
،وظهرك الّتي تتمتّع بقوّة أكبر

336
00:23:03,780 --> 00:23:07,580
.وتسمح لك بالرّكوب بشكل مريح لوقت طويل

337
00:23:09,650 --> 00:23:11,650
.حيّد، جيّد. أجل

338
00:23:09,800 --> 00:23:11,220
هل أقوم بالأمر بشكل صحيح؟

339
00:23:12,420 --> 00:23:14,720
.هذا مذهل، تبدو وضعيّة صحيحة

340
00:23:14,720 --> 00:23:19,970
في هذه الوضعيّة، إن كانت لديك عضلات
.قويّة هنا، فيمكنك مواصلة الدّوس للأبد

341
00:23:19,970 --> 00:23:22,320
.ذراعيّ مسترخيتان بالكامل

342
00:23:22,750 --> 00:23:26,090
لكنّهما يكونان مشدودان طوال
.الوقت في هذه الوضعيّة

343
00:23:26,090 --> 00:23:32,660
يبدو بالفعل أنّه يمكننا الرّكوب لوقت
.أطوال باستعمال هذه العضلات

344
00:23:26,090 --> 00:23:34,930
في الحلقة القادمة
"ركوب الدّرّاجات حول كاماكورا لأوّل مرّة 1"

345
00:23:32,660 --> 00:23:33,550
.هذا صحيح

346
00:23:33,550 --> 00:23:34,930
.نعم

347
00:23:34,930 --> 00:23:39,930
في الحلقة القادمة
"!تحدٍّ من السّيّد دبّ؟"