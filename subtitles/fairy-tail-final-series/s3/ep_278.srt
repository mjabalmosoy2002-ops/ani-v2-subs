1
00:00:10,210 --> 00:00:15,140
كانت نقابتنا جزءًا جميلًا من هذه البلدة الودودة

2
00:00:15,140 --> 00:00:17,550
.لكنّها تبدو الآن مُشوّهة وباردة...

3
00:00:23,600 --> 00:00:25,230
...سمك

4
00:00:31,820 --> 00:00:35,030
.ناموا الآن يا أصدقائي

5
00:00:38,120 --> 00:00:41,950
.قد يكون هذا الفجر الأخير

6
00:00:43,330 --> 00:00:47,000
.لذا استريحوا جيّدًا

7
00:00:48,500 --> 00:00:51,840
.كلّا، لن يكون الأخير

8
00:00:51,840 --> 00:00:55,180
.أجل. لن يوقفنا شيء

9
00:00:56,180 --> 00:00:58,850
.ما زلنا هنا

10
00:00:58,850 --> 00:01:02,640
.أجل. ولم ننتهِ بعد

11
00:01:02,640 --> 00:01:05,140
.هيّا بنا يا ناتسو

12
00:01:05,140 --> 00:01:07,600
.يجب أن نسترجع نقابتنا سويًّا

13
00:01:10,730 --> 00:01:14,110
!سنفعل بكلّ تأكيد. لأجل الغد

14
00:01:15,150 --> 00:01:16,450
.أجل

15
00:01:16,450 --> 00:01:18,530
!أجل -
!أجل -

16
00:01:18,530 --> 00:01:21,660
!أجل -
!آي سيّدي -

17
00:01:21,660 --> 00:01:24,620
...بدأت ذلك الصّباح

18
00:01:24,620 --> 00:01:28,210
!المعركة الأخيرة لفيري تايل

19
00:01:29,210 --> 00:01:33,590
مهما كنّا بعيدين

20
00:01:33,590 --> 00:01:36,220
عليك التحلّي بالإيمان

21
00:01:36,220 --> 00:01:40,760
...لذا توقّف عن البكاء رجاءً، انظر إلى الأعلى

22
00:01:40,760 --> 00:01:44,180
ولنمضِ قدمًا سويًّا...

23
00:01:58,070 --> 00:02:00,530
لمَ تنظر إلى الأسفل

24
00:02:00,530 --> 00:02:05,290
وتُحدّق في الدّموع التي ذرفت؟

25
00:02:05,290 --> 00:02:07,830
حتّى إن كان اليوم سيّئًا

26
00:02:07,830 --> 00:02:12,500
يمكننا دائمًا أن نمضي قدمًا مؤمنين بالغد

27
00:02:12,500 --> 00:02:16,550
بامتلاكي لشخصٍ يستطيع مساعدتي

28
00:02:16,550 --> 00:02:19,970
ولشخصٍ أستطيع أن أضحك معه

29
00:02:19,970 --> 00:02:24,180
يمدّني بقوّةٍ جديدة

30
00:02:24,180 --> 00:02:26,680
تستطيع تغيير العالم الذي نعرفه

31
00:02:26,680 --> 00:02:31,360
مهما كنّا بعيدين

32
00:02:31,360 --> 00:02:34,110
عليك التحلّي بالإيمان

33
00:02:34,110 --> 00:02:36,940
كلّ شيء لأجلك، لأجلك

34
00:02:36,940 --> 00:02:41,370
شمس الصباح كشحت اللّيل

35
00:02:41,370 --> 00:02:44,910
لن أخاف أو أتردّد بعد الآن

36
00:02:44,910 --> 00:02:48,370
سوف أحوّل أحلامي إلى حقيقة

37
00:02:48,370 --> 00:02:53,210
...لذا توقّف عن البكاء رجاءً، انظر إلى الأعلى

38
00:02:53,210 --> 00:02:56,670
ولنمضِ قدمًا سويًّا...

39
00:03:09,520 --> 00:03:11,020
...حان الوقت

40
00:03:48,770 --> 00:03:52,190
...تبًّا، أنا أتضوّر جوعًا

41
00:03:52,190 --> 00:03:55,020
أتريد أكل سمكي؟

42
00:03:55,020 --> 00:03:57,610
.فقط إن كان مطبوخًا

43
00:03:57,610 --> 00:04:02,240
.لا تكن سخيفًا يا ناتسو
!السّمك أفضل وهو نيّئ

44
00:04:02,240 --> 00:04:06,580
،حتّى بعض مُضيّ عام
.لم تتغيّرا أنتما الاثنان إطلاقًا

45
00:04:06,580 --> 00:04:11,160
.تجعلانني أشعر وكأنّه لم يمضِ عام بتاتًا

46
00:04:11,160 --> 00:04:14,710
ألم نصل بعد يا لوسي؟

47
00:04:14,710 --> 00:04:17,090
...بقي القليل فقط على ما أظن

48
00:04:19,210 --> 00:04:23,180
!عجبًا! إنّه ضخم! وفاتن! ما هو؟

49
00:04:23,180 --> 00:04:25,890
!أعرف هذا الوحش

50
00:04:25,890 --> 00:04:28,050
إنّه يستهوي النّاس بفروه المنفوش

51
00:04:28,050 --> 00:04:31,640
.ثمّ يبتلعهم بأكملهم

52
00:04:37,860 --> 00:04:39,940
!ناتسو! دورك

53
00:04:41,030 --> 00:04:42,280
.لا أملك مزاجًا

54
00:04:42,280 --> 00:04:43,700
!ماذا؟

55
00:04:43,700 --> 00:04:46,200
.سمعتُ أنّها لذيذة جدًّا في الواقع

56
00:04:46,200 --> 00:04:48,490
!ماذا؟ حقًّا؟

57
00:04:53,790 --> 00:04:56,170
!حسنًا! حان وقت الأكل

58
00:04:56,170 --> 00:04:58,250
أتمانعين اللّحم النيّئ يا لوسي؟

59
00:04:58,250 --> 00:04:59,710
!أنتما

60
00:05:03,050 --> 00:05:05,340
!طعمه رائع! يمكنني أكل الأطنان منه

61
00:05:05,340 --> 00:05:08,430
،بغضّ النّظر عن مظهره
.يملك مذاقًا إدمانيًّا بالفعل

62
00:05:08,430 --> 00:05:12,390
.لكن لا شيء يضاهي السّمك النيّئ برأيي

63
00:05:16,850 --> 00:05:19,480
ما الأمر؟ ألن تأكلي؟

64
00:05:19,480 --> 00:05:23,820
...كنتُ أفكّر
.يبدو وكأنّه مرّ وقتٌ طويل على تلك المعركة

65
00:05:26,240 --> 00:05:27,570
.ضدّ تارتاروس

66
00:05:33,370 --> 00:05:37,040
.كانوا أقوياء حقًّا

67
00:05:37,040 --> 00:05:41,040
لكنّنا كنّا حتّى أقوى، صحيح؟

68
00:05:42,880 --> 00:05:46,010
.أجل. كنّا أقوى

69
00:06:04,320 --> 00:06:07,450
انتصرنا في النّهاية، صحيح؟

70
00:06:07,450 --> 00:06:08,610
.أجل

71
00:06:08,610 --> 00:06:11,580
مع ذلك، ألا يبدو الأمر قاسيًا نوعًا ما؟

72
00:06:11,580 --> 00:06:12,450
كيف ذلك؟

73
00:06:12,450 --> 00:06:16,870
.كيف أنّ زعيمنا قرّر حلّ النقابة بعدها

74
00:06:16,870 --> 00:06:22,040
...أفترض أنّه يملك سببًا وجيهًا خلف ذلك، لكن

75
00:06:22,040 --> 00:06:23,420
لكن...؟

76
00:06:23,420 --> 00:06:27,340
...رفضتُ أن أستسلم، لذا

77
00:06:27,340 --> 00:06:34,390
أقول هذا مجدّدًا، لكنّي
.سعيدةٌ حقًّا لإيجادكما مجدّدًا

78
00:06:34,390 --> 00:06:40,770
...بوسعنا الآن أن نبحث عن كلّ الأعضاء المتبقّين

79
00:06:40,770 --> 00:06:43,020
!ما خطبك؟

80
00:06:44,020 --> 00:06:47,030
!أخبرتك، السّمك أفضل وهو مطبوخ

81
00:06:47,030 --> 00:06:50,660
!هذا لئيم جدًّا يا ناتسو! أرجعها نيّئة مجدّدًا

82
00:06:50,660 --> 00:06:52,990
!حسنًا، حسنًا. اعتمد عليّ

83
00:06:54,530 --> 00:06:58,200
!ستحوّلها إلى رماد أيّها النذل الكبير

84
00:06:58,200 --> 00:07:00,210
!خـ-خطئي

85
00:07:00,210 --> 00:07:03,210
!كفّ عن البكاء! سأصطاد لك أخرى

86
00:07:03,210 --> 00:07:05,590
.لقد أفسدا الحنين

87
00:07:09,090 --> 00:07:10,430
أين نحن؟

88
00:07:10,430 --> 00:07:12,470
.قرية تولي

89
00:07:12,470 --> 00:07:14,800
.فلمضِ اللّيلة هنا

90
00:07:14,800 --> 00:07:15,930
!آي

91
00:07:17,140 --> 00:07:19,020
ما الأمر يا ناتسو؟

92
00:07:21,600 --> 00:07:25,570
.إنّه برج السّاعة الذي حطّمته قبل وقتٍ طويل

93
00:07:25,570 --> 00:07:28,280
.أجل. مسرورٌ لأنّهم أصلحوه

94
00:07:28,280 --> 00:07:31,150
.لكن هنالك جزء كبير لا يتطابق الآن

95
00:07:31,150 --> 00:07:33,200
.أجل

96
00:07:33,200 --> 00:07:34,870
أيجب أن أحطّمه مجدّدًا؟

97
00:07:34,870 --> 00:07:36,790
!بالطّبع لا

98
00:07:40,540 --> 00:07:42,540
!أحتاج تحطيم شيءٍ ما

99
00:07:42,540 --> 00:07:46,210
خضتُ كلّ ذلك التّدريب
!لأصبح أقوى، ولأجل ماذا؟

100
00:07:46,210 --> 00:07:51,630
،قاتلتُ الفريق الفائز بالمسابقة
!لكنّهم كانوا مسخرة

101
00:07:51,630 --> 00:07:54,390
حتّى أنّني كنتُ أخطّط لإيساع غراي ضربًا

102
00:07:54,390 --> 00:07:58,850
!وأواجه إيرزا ولاكسس فور أن أعود

103
00:07:58,850 --> 00:08:03,270
غراي شيء، لكن سيكون
.من الجنون أن تقاتل إيرزا ولاكسس

104
00:08:03,270 --> 00:08:05,270
غراي "شيء" فحسب؟

105
00:08:05,270 --> 00:08:07,520
!ستفين بالغرض يا لوسي! قاتليني

106
00:08:07,520 --> 00:08:09,280
...محال

107
00:08:09,280 --> 00:08:15,410
،هذا ما أرغب قوله...
!لكنّي خضتُ تدريبًا سريًّا بدوري

108
00:08:16,410 --> 00:08:21,580
،ما كنتُ لأهزمك أبدًا في قتالٍ جادّ
لكن يمكننا أن نتدرّب سويًّا أحيانًا؟

109
00:08:23,250 --> 00:08:24,370
!مهلًا

110
00:08:24,370 --> 00:08:25,710
ماذا الآن؟

111
00:08:30,460 --> 00:08:33,130
!أرجعاها إليّ

112
00:08:33,130 --> 00:08:37,430
!أدوات عملي هناك! أحتاجها -
!مرحى -

113
00:08:37,430 --> 00:08:39,220
!بئسَ ذلك

114
00:08:39,220 --> 00:08:42,770
!تستحقّ هذا لتجوالك هنا لوحدك

115
00:08:42,770 --> 00:08:44,890
!صحيح

116
00:08:53,490 --> 00:08:56,450
!تبًّا! ما كان ذلك؟

117
00:08:56,450 --> 00:08:58,320
!لا شيء

118
00:08:58,320 --> 00:09:01,450
!أصبحتُ قويّة للغاية أيضًا

119
00:09:01,450 --> 00:09:03,910
.كلّا. لا أشتعلُ حماسًا

120
00:09:03,910 --> 00:09:05,540
!مهلًا

121
00:09:07,880 --> 00:09:09,290
!ماذا؟

122
00:09:10,340 --> 00:09:13,590
!لا تعلمين أين الجميع؟

123
00:09:13,590 --> 00:09:19,350
بذلتُ قصارى جهدي، لكن
.يستحيل أن أُحدّد أماكن الجميع

124
00:09:19,350 --> 00:09:20,810
ماذا؟

125
00:09:20,810 --> 00:09:25,480
بإمكاننا أن نبدأ عبر التوجه إلى
.الجنوب الشرقيّ، إلى بلدة مارغاريت

126
00:09:25,480 --> 00:09:28,230
.حيث توجد لاميا سكيل

127
00:09:28,230 --> 00:09:30,400
!نقابة ليون وجورا

128
00:09:30,400 --> 00:09:32,320
!المكان الأنسب لأُجرّب مهاراتي

129
00:09:32,320 --> 00:09:34,280
.ذاك الرّجل الكلب هناك أيضًا

130
00:09:35,150 --> 00:09:39,530
واحزرا من أصبح عضوًا بلاميا سكيل أيضًا؟

131
00:09:42,200 --> 00:09:43,750
الملك السماويّ؟

132
00:09:43,750 --> 00:09:45,540
أهو سمكة؟

133
00:09:45,540 --> 00:09:47,250
.إليكما عنّي

134
00:09:50,710 --> 00:09:57,720
نقدّم لكم أوّلًا العضوّ المتفوّق
!بلاميا سكيل، بأدائه الجليدي

135
00:10:22,280 --> 00:10:24,910
!أرانب -
!يا لظرافتها -

136
00:10:27,250 --> 00:10:30,420
!تاليًا، عرضُ تقليد توبي

137
00:10:32,670 --> 00:10:35,050
.هذا أنا وأنا أبكي

138
00:10:38,720 --> 00:10:40,470
هل يُقلّد نفسه؟

139
00:10:40,470 --> 00:10:42,300
أيُعتبر هذا تقليدًا أساسًا؟

140
00:10:42,300 --> 00:10:43,640
.نعتذر لكم

141
00:10:43,640 --> 00:10:45,310
!لم أنتهِ بعد

142
00:10:45,310 --> 00:10:49,060
!تـ-تاليًا، أداء شرقيّ من قبل زعيمتنا شخصيًّا

143
00:10:49,060 --> 00:10:54,320
...دوران، دوران... يدور دوران دوران

144
00:11:00,570 --> 00:11:03,030
!وقت التعرّي -
!ماذا؟ -

145
00:11:03,030 --> 00:11:04,240
.نعتذر لكم

146
00:11:04,240 --> 00:11:07,040
!لم أنته بعد! لا تجعلني أُدوّرك

147
00:11:07,040 --> 00:11:10,210
...والآن، ما كنتم تنتظرونه

148
00:11:11,460 --> 00:11:13,040
!مهرجان؟

149
00:11:13,040 --> 00:11:15,210
!بوسعي الشّعور بالتشويق حقًّا

150
00:11:15,210 --> 00:11:17,670
!حمدًا للرّب! وصلنا في الوقت

151
00:11:17,670 --> 00:11:20,470
...ملاكا نقابتنا المحبوبتان

152
00:11:22,180 --> 00:11:26,970
!أُختا السّماء! شيليا وويندي

153
00:11:40,320 --> 00:11:44,030
،والآن، نُقّدم لكم أُختا السّماء، شيليا وويندي

154
00:11:44,030 --> 00:11:47,330
"!وبأغنيتهما، "بلنُحِب

155
00:11:47,330 --> 00:11:50,460
!لطالما كانت ويندي صديقة مقرّبة لشيليا

156
00:11:50,460 --> 00:11:53,670
♪ !في صميم قلبي، إنه ساخن ♪

157
00:11:53,670 --> 00:11:56,540
♪ !آمل أنه لن يلاحظ ♪

158
00:11:56,540 --> 00:12:02,760
♪ !لستُ ملاكًا! أنا أكبر بثبات ♪

159
00:12:03,970 --> 00:12:10,100
♪ ...انسَ بشأن الأجنحة الفاخرة والمُحلّقة ♪

160
00:12:10,100 --> 00:12:16,190
♪ ...وخذ بيدي بدلًا عنها ♪

161
00:12:16,190 --> 00:12:19,320
♪ !بلنسر ♪

162
00:12:19,320 --> 00:12:22,320
♪ !بلنحب! بلنحب! إلى الأبد ♪

163
00:12:22,320 --> 00:12:23,740
♪ ...بمشاعر الحب ♪

164
00:12:23,740 --> 00:12:28,530
!إلى الأبد...

165
00:12:25,410 --> 00:12:26,910
♪ ...وبأعين مُحدّقة إلى الأبد ♪

166
00:12:28,530 --> 00:12:30,500
!ما الذي تفعله؟

167
00:12:30,500 --> 00:12:33,330
...إنّه آسر نوعًا ما... إلى الأبد

168
00:12:33,330 --> 00:12:37,000
.التحق العديد بنقاباتٍ أخرى في الواقع

169
00:12:37,000 --> 00:12:39,130
.يجب عليهم كسب قوتهم في الأخير

170
00:12:39,130 --> 00:12:41,300
!...لا، أقصد

171
00:12:41,300 --> 00:12:44,510
!ما قصّة غنائها إلى الأبد في المسرح؟

172
00:12:44,510 --> 00:12:46,300
!إلى الأبد

173
00:12:46,300 --> 00:12:50,310
!صحيح! إنه مهرجان عيد الشكر للاميا سكيل

174
00:12:50,310 --> 00:12:53,560
.إنّه مثل مهرجان الحصاد الكبير لماغنوليا

175
00:12:53,560 --> 00:12:57,940
وهو يجمع بين المواطنين
.والنّقابلة لتشكيل شعورٍ بالوِحدة

176
00:12:57,940 --> 00:13:01,690
!سأعيد ويندي إلى طريق الصّواب

177
00:13:01,690 --> 00:13:04,280
...ليست في الطريق الخاطئ أساسًا

178
00:13:04,280 --> 00:13:07,780
بالتفكير في الأمر، أين هي شارلي؟

179
00:13:07,780 --> 00:13:10,830
...شككتُ أنّكم ستظهرون الآن

180
00:13:10,830 --> 00:13:15,210
.ناتسو ولوسي والقطّ الذّكر...

181
00:13:15,210 --> 00:13:18,670
."أعتذر. "هابي

182
00:13:23,130 --> 00:13:25,590
.جميع أهالي البلدة الرّديئة مشاركون في المهرجان

183
00:13:25,590 --> 00:13:27,260
!بلنحب! بلنحب

184
00:13:27,260 --> 00:13:29,050
.اخرس

185
00:13:29,050 --> 00:13:33,060
.ستُطرق مطرقة الحُكم اللّيلة على لاميا سكيل

186
00:13:34,180 --> 00:13:36,850
!مهرجان عيد الشكر الدموي يبدأ

187
00:13:38,600 --> 00:13:42,280
!لن أفعل شيئًا بهذا الإحراج مجدّدًا

188
00:13:42,280 --> 00:13:47,200
.كنتِ ظريفةً للغاية
!النّاس يحبّونك حقًّا يا ويندي

189
00:13:47,200 --> 00:13:50,410
♪ !بلنحب! بلنحب! إلى الأبد ♪

190
00:13:50,410 --> 00:13:51,910
♪ !إلى الأبد ♪

191
00:13:51,910 --> 00:13:53,660
!ما معنى "بلنحب" أساسًا؟

192
00:13:53,660 --> 00:13:55,540
.لا تنزعج

193
00:13:55,540 --> 00:13:57,500
.ويندي. لديك زوار

194
00:13:57,500 --> 00:13:58,580
ماذا؟

195
00:14:00,750 --> 00:14:03,000
.مرحبًا -
!مضى وقتٌ طويل -

196
00:14:03,000 --> 00:14:05,210
!كيف الحال يا ويندي؟

197
00:14:05,210 --> 00:14:09,890
!ناتسو! لوسي! وهابي

198
00:14:09,890 --> 00:14:11,800
هل أصبحت أطول؟

199
00:14:11,800 --> 00:14:15,180
.لا... ولو قليلًا

200
00:14:15,180 --> 00:14:17,140
.فهمت

201
00:14:17,140 --> 00:14:18,770
.فلنعد إلى الديار

202
00:14:19,770 --> 00:14:20,860
!أنت

203
00:14:21,770 --> 00:14:28,450
تعيدون الجميع لإعادة بناء فيري تايل؟

204
00:14:28,450 --> 00:14:31,660
أجل. لقد كان الزّعيم
.مختفيًا طوال السّنة الماضية

205
00:14:31,660 --> 00:14:34,910
.لا بدّ أنّ للأمر علاقة بحلّ النقابة المفاجئ

206
00:14:34,910 --> 00:14:39,790
.يبدو أنّ المجلس قلق بشأن السيّد ماكاروف أيضًا

207
00:14:39,790 --> 00:14:43,090
.المجلس؟ تبًّا، أكره ذلك الاسم

208
00:14:43,090 --> 00:14:45,210
.خلتُ أنّه لم يعد هنالك وجود للمجلس

209
00:14:45,210 --> 00:14:49,680
صحيح. كنتما في الجبال طوال
.هذا الوقت، لذا لم تسمعا بالأخبار

210
00:14:49,680 --> 00:14:54,140
.تحتاج النقابات وجود مجلسٍ لأجل العمل

211
00:14:54,140 --> 00:14:57,560
لذا اجتمع السّحرة العشرة القدّيسون قبل عام

212
00:14:57,560 --> 00:14:59,940
.وشكّلوا مجلسًا جديدًا

213
00:15:01,100 --> 00:15:03,610
!تركنا جورا لأجل الالتحاق بالمجلس أيضًا

214
00:15:03,610 --> 00:15:04,980
.لا تنزعج

215
00:15:06,570 --> 00:15:11,660
...السّحرة العشرة القدّيسون
!يبدون كمجلسٍ قويّ

216
00:15:11,660 --> 00:15:13,320
إذًا، هل زعيمنا عضوٌ به أيضًا؟

217
00:15:13,320 --> 00:15:16,830
.كان من المفروض ذلك لكنّه اختفى

218
00:15:16,830 --> 00:15:20,290
.يبدو كعملٍ مزعج
ربّما هرب؟

219
00:15:20,290 --> 00:15:23,250
.على أيّ حال، دعنا منه الآن

220
00:15:23,250 --> 00:15:26,340
!تعالي معنا يا ويندي

221
00:15:33,590 --> 00:15:36,180
.أنا ساحرة بلاميا سكيل الآن

222
00:15:37,180 --> 00:15:39,600
.لا أستطيع الذهاب معكم

223
00:15:41,310 --> 00:15:44,150
!ويندي؟ -
!لماذا؟ -

224
00:15:44,150 --> 00:15:45,650
.آسفة

225
00:15:46,650 --> 00:15:49,860
.لا يجب أن تتراجعي لأجلنا

226
00:15:49,860 --> 00:15:53,070
.علمنا أنّ هذا اليوم سيأتي

227
00:15:53,070 --> 00:15:57,450
!لن نشتاق لك أبدًا! أبدًا -
.كفّ عن البكاء -

228
00:15:57,450 --> 00:15:59,750
!لمَ لا تستطيعين المجيء يا ويندي؟

229
00:15:59,750 --> 00:16:01,460
...لقد

230
00:16:01,460 --> 00:16:04,380
.لقد اتّخذت قرارها

231
00:16:04,380 --> 00:16:07,130
هلّا تركتموها وشأنها؟

232
00:16:07,130 --> 00:16:08,590
...شارلي

233
00:16:08,590 --> 00:16:12,510
لمَ هي إنسان؟

234
00:16:12,510 --> 00:16:14,890
!كيف أصبحت إنسان؟

235
00:16:14,890 --> 00:16:18,220
.هذا؟ تعلّمتُ سحر التحوّل

236
00:16:18,220 --> 00:16:20,770
تزيد هذه الهيئة من قوّتي السحرية قليلًا

237
00:16:20,770 --> 00:16:23,140
.كما تُحسّن من فطنتي

238
00:16:23,140 --> 00:16:24,980
ما رأيك يا هابي؟

239
00:16:24,980 --> 00:16:27,400
.لقد... تدرّبتُ أيضًا

240
00:16:27,400 --> 00:16:30,070
...تدرّبتُ و

241
00:16:30,070 --> 00:16:32,990
!لم أعد آكل السّمك على الفور دائمًا

242
00:16:32,990 --> 00:16:35,410
أيّ تدريبٍ هذا؟

243
00:16:37,740 --> 00:16:40,410
هل أنت واثقة من هذا يا ويندي؟

244
00:16:40,410 --> 00:16:42,870
!لقد رجعتِ إلى هيئتك! ظريف جدًّا

245
00:16:48,250 --> 00:16:50,000
...لا يمكن

246
00:16:51,130 --> 00:16:52,550
...يا إلهي

247
00:17:17,240 --> 00:17:19,160
!هذا يدغدغ

248
00:17:21,700 --> 00:17:23,580
!توقّفا أيها المنحرفان

249
00:17:25,160 --> 00:17:29,130
!ليست غلطتنا، إنّما هي صدمة كبيرة

250
00:17:29,130 --> 00:17:31,050
...آي

251
00:17:31,050 --> 00:17:35,680
...أتساءل إن كان البقيّة يشعرون مثل ويندي أيضًا

252
00:17:35,680 --> 00:17:37,840
!لن أستسلم

253
00:17:37,840 --> 00:17:39,850
!عليّ أن أخطفها فحسب

254
00:17:39,850 --> 00:17:41,220
!لا تجرؤ

255
00:17:43,980 --> 00:17:47,060
...ويندي. بشأن ما حدث عصرًا

256
00:17:47,060 --> 00:17:48,850
.لا تقلقي

257
00:17:48,850 --> 00:17:51,860
!لن أذهب إلى أيّ مكان

258
00:17:51,860 --> 00:17:56,200
.خرجت شيري بالفعل بعد أن تزوّجت

259
00:17:56,200 --> 00:18:00,280
.وإن غادرتُ أيضًا، ستظلّين وحيدة

260
00:18:02,290 --> 00:18:04,410
.كلّا، غير صحيح

261
00:18:05,710 --> 00:18:11,920
لا أزال أملك أعضاء لاميا
.سكيل الأعزّاء إلى جانبي

262
00:18:13,130 --> 00:18:17,010
...بقائك من باب الشّفقة فحسب

263
00:18:17,010 --> 00:18:19,220
.لا يبدو ذلك من شيم الأصدقاء

264
00:18:28,310 --> 00:18:29,940
!ما كان ذلك الصوت؟

265
00:18:29,940 --> 00:18:31,230
!أتى من النقابة

266
00:18:34,230 --> 00:18:36,030
!أخلوا المدنيّين

267
00:18:37,490 --> 00:18:38,900
!هنا

268
00:18:41,910 --> 00:18:43,490
!ما الذي يجري؟

269
00:18:43,490 --> 00:18:44,580
!ناتسو

270
00:18:47,580 --> 00:18:49,120
.إنّه ما يبدو عليه بالضّبط

271
00:18:52,840 --> 00:18:56,710
!اجتاح حشدٌ من الوحوش المدينة فجأةً

272
00:18:56,710 --> 00:18:57,800
!حشد؟

273
00:18:57,800 --> 00:18:59,340
!لماذا؟

274
00:18:59,340 --> 00:19:01,930
!إنّها نقابة أوروتشي فين

275
00:19:01,930 --> 00:19:05,600
!إنّنا منافسون مريرين منذ سنين

276
00:19:05,600 --> 00:19:06,810
!منافسون؟

277
00:19:08,060 --> 00:19:12,270
...يستخدمون الوحوش لمهاجمتنا
.أوروتشي حقراء بحق

278
00:19:12,270 --> 00:19:16,110
!لا بد أنّهم يأملون استغلال غياب جورا-سان

279
00:19:16,110 --> 00:19:19,450
.انتظروا المهرجان ليهاجموننا عن حين غرّة

280
00:19:19,450 --> 00:19:21,490
!اللعنة عليهم

281
00:19:21,490 --> 00:19:22,700
!ليون

282
00:19:22,700 --> 00:19:24,490
!هذه الموجة الأولى فحسب

283
00:19:24,490 --> 00:19:27,080
!سربٌ أكبر من الوحوش قادم من الغرب

284
00:19:27,080 --> 00:19:29,160
!ثمّة مائة ألف منهم

285
00:19:29,160 --> 00:19:30,290
!مائة ألف؟

286
00:19:35,500 --> 00:19:38,210
!على هذا المعدّل، ستُباد المدينة

287
00:19:38,210 --> 00:19:43,260
!هل تتمادون إلى هذا الحدّ يا أوروتشي؟

288
00:19:43,260 --> 00:19:45,100
!يا له من منظر

289
00:19:45,100 --> 00:19:48,310
!ودّعوا مدينتكم بأسرها

290
00:19:48,310 --> 00:19:51,310
.بغياب جورا، لاميا سكيل ضعيفة كالطّفل الرّضيع

291
00:19:55,650 --> 00:19:59,440
...سوف نستنزف قوّتهم السحريّة قدر الإمكان

292
00:19:59,440 --> 00:20:02,410
!ثمّ سنسحقهم...

293
00:20:02,410 --> 00:20:05,120
!اقتلوهم جميعًا

294
00:20:09,660 --> 00:20:12,870
.يبدو أنّ لدى أوروتشي فين مُروّض وحوش

295
00:20:12,870 --> 00:20:15,210
!...إن استطعنا إسقاطه

296
00:20:15,210 --> 00:20:18,130
.مستحيل. ثمّة العديد من الوحوش في الطّريق

297
00:20:19,960 --> 00:20:22,340
!ألا يوجد ما بإمكاننا فعله؟

298
00:20:22,340 --> 00:20:25,090
...يمكننا أن نصعد إلى الأعلى دائمًا -
!وينتهي الأمر -

299
00:20:26,180 --> 00:20:27,760
!صحيح

300
00:20:27,760 --> 00:20:29,850
!هل تنوي مساعدتنا؟

301
00:20:29,850 --> 00:20:31,480
!بالتأكيد

302
00:20:31,480 --> 00:20:35,310
!أنا أشتعل حماسًا! هيا بنا يا هابي

303
00:20:35,310 --> 00:20:37,440
!آي سيدي

304
00:20:37,440 --> 00:20:39,110
!آسفة يا ناتسو

305
00:20:40,320 --> 00:20:42,360
!شيليا؟

306
00:20:42,360 --> 00:20:43,780
ماذا؟

307
00:20:43,780 --> 00:20:46,280
!تابع يا هابي! رجاءً

308
00:20:46,280 --> 00:20:48,160
آ-آي...؟

309
00:20:48,160 --> 00:20:51,500
!سوف ننقذ لاميا سكيل بأنفسنا

310
00:20:51,500 --> 00:20:52,500
!أجل

311
00:20:53,460 --> 00:20:55,750
...هابي قد قطف

312
00:20:58,540 --> 00:21:01,550
!لقد دخل السّرب المدينة

313
00:21:01,550 --> 00:21:04,180
!فقط كم عددها؟

314
00:21:04,180 --> 00:21:06,180
.يجب أن نردعها

315
00:21:06,180 --> 00:21:07,260
!أجل

316
00:21:08,510 --> 00:21:11,930
!يا لصّة هابي الدنيئة

317
00:21:11,930 --> 00:21:13,430
!ماذا؟

318
00:21:13,430 --> 00:21:16,350
!أنا قادم إليكم

319
00:21:16,350 --> 00:21:18,480
!ناتسو -
!لا يعقل أنّه جاد -

320
00:21:20,570 --> 00:21:22,280
!تنحّوا عن الطريق

321
00:21:37,460 --> 00:21:40,540
!تنحّ

322
00:21:50,510 --> 00:22:00,770
حتّى تخلدي إلى النوم، حتّى
ترسمين تلك الابتسامة على وجهك

323
00:22:00,770 --> 00:22:24,960
قلبك المشقوق أكثر جمالًا من أي شيء

324
00:22:24,960 --> 00:22:35,140
،تحت نفس السماء
نظرنا إلى نفس النجوم

325
00:22:35,140 --> 00:22:46,690
يا ليت حلمنا الذي تشاركناه يتحقق الآن

326
00:22:46,690 --> 00:22:57,450
لا شك أننا نستطيع تحقيق المستقبل الذي تمنيناه

327
00:22:59,370 --> 00:23:10,430
بينما يتواصل انسجامنا ويمتدّ إلى الأبد في هذا الطريق

328
00:23:20,890 --> 00:23:25,770
.شنّت أوروتشي فين هجومًا ليليًّا على بلدة مارغاريت

329
00:23:25,770 --> 00:23:28,030
،أختا السماء، ويندي وشيليا

330
00:23:28,030 --> 00:23:32,450
.ارتفعتا إلى السماء سويًّا لحماية النقابة والمدينة

331
00:23:32,450 --> 00:23:36,040
وهدفهما هو: القضاء على مروّض
.الوحوش في الوِحدة الرئيسية للعدوّ

332
00:23:36,040 --> 00:23:41,500
.لكنهما تصطدمان بعدوّين جبّارين

333
00:23:41,500 --> 00:23:43,960
:في الحلقة القادمة
"لأنّي أحبّك"

334
00:23:43,960 --> 00:23:49,510
"تقاتل الفتاتان لأجل "الحبّ
.الأبديّ الذي يسكن قلبهما