1
00:00:09,500 --> 00:00:12,660
لا أطيق الانتظار! حان وقت
!بسط ذِراعي وجناحي

2
00:00:12,830 --> 00:00:16,420
!مرحى! هيّا بنا! هيّا بنا

3
00:00:21,000 --> 00:00:23,870
لا تُفكّر حتّى بالاستدارة بعد قطع
كلّ هذه المسافة

4
00:00:24,040 --> 00:00:26,330
!أ-أعلم

5
00:00:48,320 --> 00:00:50,520
طبخ التّخييم في عالم آخر بمهارتي السّخيفة

6
00:02:06,520 --> 00:02:10,040
الحلقة 16 الدّيماس مع الطّعام المُعدّ سلفاً

7
00:02:10,210 --> 00:02:11,310
الحلقة 16 الدّيماس مع الطّعام المُعدّ سلفاً
لا يوجد إلّا ضعفاء في الطّوابق السّفليّة -

8
00:02:11,480 --> 00:02:13,750
لا يوجد إلّا ضعفاء في الطّوابق السّفليّة

9
00:02:13,920 --> 00:02:16,540
يُقال بأنّ مُعظم المُغامرين يستكشفون
ويكسبون المال

10
00:02:16,710 --> 00:02:18,460
بين الطّابقين العاشر والخامس عشر

11
00:02:18,630 --> 00:02:21,500
يبدو أنّه يمكنك إيجاد صناديق
كنز في تلك الطّوابق

12
00:02:21,830 --> 00:02:24,160
إذاً، الطّوابق الّتي قبلها لا تعنينا

13
00:02:24,330 --> 00:02:27,250
لننزل بسرعة إذاً. اصعد

14
00:02:28,040 --> 00:02:29,250
ماذا؟

15
00:02:37,290 --> 00:02:38,500
!ابتعدوا

16
00:02:42,830 --> 00:02:44,960
...هذا أشبه باصطدام وهروب

17
00:02:45,130 --> 00:02:46,290
...ماذا

18
00:02:56,540 --> 00:02:58,620
!ا-انطلق سهمٌ للتو؟

19
00:02:58,790 --> 00:03:02,080
دستُ على شيء للتو. أعتقد بأنّه كان فخّاً

20
00:03:02,250 --> 00:03:05,040
!أليست الدّياميس شيئاً يُبنى بشكل طبيعيّ؟

21
00:03:05,210 --> 00:03:07,040
!أليست الفِخاخ أشياء اصطناعيّة؟

22
00:03:07,380 --> 00:03:09,160
أخبرتُك من قبل

23
00:03:09,330 --> 00:03:11,540
الدّياميس أشبه بمخلوقات حيّة

24
00:03:11,960 --> 00:03:16,660
تستدرج البشر بالوحوش الّتي يسقط
منها حجارة سحريّة وصناديق كنز

25
00:03:16,830 --> 00:03:20,630
من أجل قتلهم بوحوش مولودة وفِخاخ

26
00:03:21,290 --> 00:03:24,250
ثمّ يتمّ امتصاص الجثث البشريّة
بواسطة الدّيماس

27
00:03:24,420 --> 00:03:27,370
كغذاء يُساهم في نموّ الدّياس

28
00:03:27,540 --> 00:03:31,040
الفِخاخ هي أشبه بأطراف هذا الشّيء
الحيّ الّذي يُدعى ديماس

29
00:03:31,670 --> 00:03:35,170
حسناً، مثل هذه الأشياء لا تنجح على حاجزي

30
00:03:36,920 --> 00:03:40,420
!كما توقّعت، الدّياميس مُخيفة للغاية

31
00:03:50,420 --> 00:03:53,160
إنّها لا تُعرقلني حتّى

32
00:03:53,330 --> 00:03:54,830
!أنت ماهر جدّاً

33
00:03:55,000 --> 00:03:58,000
!العمّ فيل رائع للغاية

34
00:04:00,750 --> 00:04:02,630
!لا أستطيع تحمُّل هذا

35
00:04:07,920 --> 00:04:12,420
...لا بُدّ أنّ هذا هو الطّابق العاشر

36
00:04:12,750 --> 00:04:13,880
ماذا تريد أن تفعل؟

37
00:04:15,540 --> 00:04:17,960
لا يوجد أي أعداء جديرين هنا أيضاً

38
00:04:18,130 --> 00:04:22,210
زعيم هذا الطّابق هو رتيلاء سامّة

39
00:04:22,380 --> 00:04:25,160
!عناكب من جديد؟ كم هذا مُملّ

40
00:04:25,330 --> 00:04:27,830
إذاً هل ينبغي أن نُسارع
إلى غرفة الزّعيم فحسب؟

41
00:04:28,080 --> 00:04:29,250
أجل

42
00:04:39,130 --> 00:04:40,290
!وحش

43
00:04:41,710 --> 00:04:45,460
!آسف! آسف! إنّه كائني المُرافق

44
00:04:47,670 --> 00:04:49,170
كان ذلك مُرعباً

45
00:04:51,420 --> 00:04:54,830
المعذرة، هذه هي غرفة الزّعيم، صحيح؟ -
هذا صحيح -

46
00:04:55,000 --> 00:04:57,410
ألن تدخلوا؟ -
ماذا؟ -

47
00:04:57,580 --> 00:05:00,080
هل يُعقل أنّها زيارتك الأولى لديماس؟

48
00:05:00,250 --> 00:05:02,750
...أجل. ديماس بهذا الحجم

49
00:05:03,580 --> 00:05:07,580
هناك كثير من القواعد في الدّياميس
يتّبعها المُغامرون

50
00:05:07,750 --> 00:05:13,540
عند مُقاتلة الوحوش، الفريق الّذي
يُهاجم أوّلاً يحظى بأولويّة

51
00:05:13,710 --> 00:05:15,580
الغنائم هي مُلك هذا الفريق أيضاً

52
00:05:15,750 --> 00:05:19,630
حالما تبدأ المعركة، لا يُسمَح لك
بالمُساعدة ما لم يُطلَب منك ذلك

53
00:05:20,250 --> 00:05:23,750
المُغامر الّذي يفتح صندوقَ كنز يحظى بأولويّة
الحصول على مُحتوياته

54
00:05:24,000 --> 00:05:25,120
...هكذا إذاً

55
00:05:25,290 --> 00:05:27,580
إذاً، هل يوجد فريق آخر حاليّاً في الدّاخل؟

56
00:05:27,750 --> 00:05:29,040
تماماً

57
00:05:29,210 --> 00:05:33,000
لكن هناك بعض الأشخاص الّذين يتجاهلون
القواعد ويسرقون الغنائم

58
00:05:33,170 --> 00:05:36,580
أو يسرقون المال وكلّ ما هو قيّم
من جدُد مثلك

59
00:05:36,750 --> 00:05:38,880
كُن حذراً -
...مُخيف -

60
00:05:44,790 --> 00:05:46,540
كم بقي من وقت؟

61
00:05:46,710 --> 00:05:49,080
...لنُسرع ونتقدّم

62
00:05:49,250 --> 00:05:54,290
سمعتَ ما قالوا. علينا الالتزام بالقواعد

63
00:05:56,130 --> 00:05:58,620
شكراً على الانتظار. ادخلوا

64
00:05:58,790 --> 00:06:01,330
ماذا؟ لن تنزلوا إلى الطّابق التّالي؟

65
00:06:01,710 --> 00:06:03,540
لن نتجاوز هذا الطّابق

66
00:06:03,710 --> 00:06:05,830
جميعنا لدينا زوجات وأطفال

67
00:06:06,000 --> 00:06:07,710
لن نُجازف بأنفسنا

68
00:06:08,290 --> 00:06:10,410
...هكذا إذاً

69
00:06:10,580 --> 00:06:11,660
هيّا بنا

70
00:06:11,830 --> 00:06:13,290
!حسناً

71
00:06:27,210 --> 00:06:28,330
!هيّا بنا

72
00:06:28,880 --> 00:06:30,420
!خذي هذه

73
00:06:32,750 --> 00:06:35,000
رائع! أشعر نفسي قويّاً للغاية

74
00:06:35,170 --> 00:06:38,540
!البرَكة من إله الحرب رائعة

75
00:06:42,290 --> 00:06:43,670
!غنائم

76
00:06:44,420 --> 00:06:46,580
!هكذا يظهرون إذاً

77
00:06:47,000 --> 00:06:48,910
تبدو هذه كلعبة

78
00:06:49,080 --> 00:06:50,880
...إنّها مُعالَجة بالفعل فوق ذلك

79
00:06:51,580 --> 00:06:53,960
لنُسرع ونتقدّم

80
00:06:54,460 --> 00:06:56,460
...حسناً

81
00:06:58,500 --> 00:07:01,330
الزّعيم في الطّابق الحادي عشر
!هو جنرال أورك

82
00:07:11,500 --> 00:07:15,210
،بما أنّني استهلكتُ الكثير من السّحر
...بدأتُ أشعر بالجوع

83
00:07:15,380 --> 00:07:17,250
سوي أيضاً

84
00:07:17,420 --> 00:07:20,380
أعترف بأنّ جميعكم كنتم تعملون بجدّ

85
00:07:20,960 --> 00:07:23,460
هناك غرفة مفتوحة أمامنا

86
00:07:23,880 --> 00:07:25,540
هل يمكننا أن نأكل هناك؟

87
00:07:25,710 --> 00:07:28,960
لا أثر للوحوش. ينبغي أن تكون آمنة

88
00:07:33,670 --> 00:07:36,290
إنّها أشبه بمنطقة استراحة

89
00:07:43,000 --> 00:07:45,250
!ماذا؟! موكودا؟

90
00:07:45,880 --> 00:07:48,250
!الإرادة الحديديّة

91
00:07:48,420 --> 00:07:50,370
!عرفتُ بأنّه كان أنت يا موكودا

92
00:07:50,540 --> 00:07:52,630
!لم أرك منذ وقت

93
00:07:53,130 --> 00:07:56,330
لم أتوقّع أن نلتقي ببعضنا الآخر
ثانية في مكان كهذا

94
00:07:56,500 --> 00:07:58,330
يبدو أنّك كنت تبلي حسناً

95
00:07:58,500 --> 00:08:00,380
!أجل. جميعكم كذلك

96
00:08:01,000 --> 00:08:06,960
تمكّنتُ من مُغادرة مملكة ريجسيهير
بأمان بفضل هؤلاء

97
00:08:07,420 --> 00:08:10,080
!أنا سعيد جدّاً برؤيتهم جميعاً ثانية

98
00:08:12,330 --> 00:08:15,410
لذا، وصلنا إلى المدينة قبل يوم أمس

99
00:08:15,580 --> 00:08:18,160
وبدأنا بالنّزول مباشرة في الأمس

100
00:08:18,330 --> 00:08:22,210
كنّا ننوي الذّهاب إلى البلدة السّاحليّة، بيرلياند

101
00:08:22,380 --> 00:08:24,540
،لكن حالما سمع فيل بوجود الدّيماس هنا

102
00:08:24,710 --> 00:08:26,790
أراد الدّخول بإصرار

103
00:08:27,330 --> 00:08:28,750
هذا هو طبع فيل-ساما

104
00:08:29,750 --> 00:08:34,210
بالمناسبة يا موكودا، يبدو أنّك حصلت
على مزيد من الكائنات المُرافقة

105
00:08:34,380 --> 00:08:36,620
هل هذا تنّين رضيع؟

106
00:08:36,790 --> 00:08:42,040
هذا تنّين بيكشي بحجمه البالغ بالفعل

107
00:08:42,210 --> 00:08:44,080
اسمه دورا-تشان

108
00:08:47,210 --> 00:08:48,500
ماذا؟

109
00:08:50,170 --> 00:08:51,410
ماذا عن هذا؟

110
00:08:51,580 --> 00:08:53,040
هذا الفتى هو سوي

111
00:08:53,210 --> 00:08:55,460
إنّه هُلام، لكنّه قويٌّ جدّاً

112
00:08:55,630 --> 00:08:58,500
!ماذا؟ لا يبدو كذلك حقّاً

113
00:08:58,670 --> 00:08:59,750
!هذا صحيح. سوي قويّ

114
00:09:01,790 --> 00:09:04,290
هل يمكنني الإمساك به؟ -
تفضّلي -

115
00:09:06,790 --> 00:09:08,710
!إنّه ظريفٌ جدّاً

116
00:09:08,880 --> 00:09:11,540
دورا-تشان، سُررت بلقائك

117
00:09:12,540 --> 00:09:14,960
يبدون سُعداء جميعاً

118
00:09:15,130 --> 00:09:17,410
فيل-ساما مُذهل بحدّ ذاته

119
00:09:17,580 --> 00:09:19,750
يا للعجب! أنت مُبهر حقّاً

120
00:09:21,580 --> 00:09:22,910
...لكن رغم ذلك، في النّهاية

121
00:09:23,080 --> 00:09:24,830
أعدّ الطّعام بسرعة

122
00:09:25,000 --> 00:09:26,870
!لم أعد أحتمل بالفعل

123
00:09:27,040 --> 00:09:29,870
!سوي جائع أيضاً

124
00:09:30,040 --> 00:09:32,870
...الجميع يعتمدون عليّ في الطّعام

125
00:09:33,040 --> 00:09:35,210
هذا هو طبعك يا موكودا

126
00:09:37,290 --> 00:09:38,410
!بالمناسبة

127
00:09:38,580 --> 00:09:41,870
هل يمكننا انتهاز هذه الفُرصة
ونتناول طعاماً معاً؟

128
00:09:42,040 --> 00:09:43,040
!متأكّد؟ -
!ماذا؟ -

129
00:09:43,210 --> 00:09:44,750
!أنتم

130
00:09:44,920 --> 00:09:48,960
لا مُشكلة. حضّرتُ كثيراً من الطّعام سلفاً

131
00:09:51,920 --> 00:09:53,790
إذاً، سنقبل بعرضك

132
00:09:53,960 --> 00:09:56,290
أراك سعيداً بذلك أيضاً يا قائد

133
00:09:56,460 --> 00:10:00,080
حسناً، سنُساهم ببعض مؤوناتنا

134
00:10:01,750 --> 00:10:03,960
!خبز أسود

135
00:10:04,130 --> 00:10:06,630
!إذاً لنتناول شيئاً يتماشى معه

136
00:10:24,460 --> 00:10:27,250
!لذيذ للغاية

137
00:10:30,710 --> 00:10:33,500
ردّة فعلهم رائعة كما العادة

138
00:10:33,670 --> 00:10:37,910
هذه أوّل مرّة آكل فيها لحماً
...يذوب في فمي بهذا الشّكل

139
00:10:38,080 --> 00:10:42,500
هذه النّكهة الغنيّة والعميقة... إنّها
تُبرز حلاوة الخضراوات حقّاً

140
00:10:43,960 --> 00:10:47,830
لم أتوقّع أن أتمكّن من أكل
طعام موكودا ثانية

141
00:10:48,000 --> 00:10:50,080
!هذا هو الأفضل حقّاً

142
00:10:50,250 --> 00:10:54,500
دائماً ما تتحدّث عن مدى لذّة
طعام موكودا

143
00:10:54,920 --> 00:10:55,960
...المعذرة

144
00:10:56,630 --> 00:10:59,000
بالمناسبة، ما نوع هذا اللّحم؟

145
00:10:59,290 --> 00:11:00,880
وايفرن

146
00:11:04,130 --> 00:11:07,710
آ-آسف! لا أصدّق بأنّنا أكلنا مُكوّناً
!فاخراً كهذا منك

147
00:11:07,880 --> 00:11:10,540
لا تعتذروا رجاء

148
00:11:11,040 --> 00:11:13,040
!ما زال لدينا الكثير منه

149
00:11:14,630 --> 00:11:16,750
ما زال لديه الكثير منه؟

150
00:11:17,330 --> 00:11:18,900
فيل وسوي اصطاداه

151
00:11:19,070 --> 00:11:20,120
هذا جنون

152
00:11:20,290 --> 00:11:21,870
كما هو مُتوقَّع من فيل-ساما

153
00:11:22,040 --> 00:11:24,290
لا بُدّ أنّ سوي قويّ حقّاً

154
00:11:24,460 --> 00:11:27,160
إذاً حسناً... هل يريد أحدٌ طبقاً آخر؟

155
00:11:27,330 --> 00:11:28,500
!هل يمكنني حقّاً؟

156
00:11:28,670 --> 00:11:29,750
!فينسنت

157
00:11:30,080 --> 00:11:31,250
ماذا عن بقيّتكم؟

158
00:11:36,250 --> 00:11:38,000
!أجل، من فضلك

159
00:11:39,460 --> 00:11:42,250
هذا يجعل كلّ ذلك العمل الدّؤوب جديراً

160
00:11:42,920 --> 00:11:44,630
كلوا كثيراً رجاء

161
00:11:51,250 --> 00:11:54,790
ننوي استكشاف هذا الطّابق أكثر قليلاً

162
00:11:54,960 --> 00:11:57,790
حسناً. توخّوا الحذر جميعاً رجاء

163
00:11:57,960 --> 00:11:59,370
!كان ذلك مُمتعاً

164
00:11:59,540 --> 00:12:00,790
!وداعاً

165
00:12:00,960 --> 00:12:02,500
!أنتم كذلك

166
00:12:02,670 --> 00:12:06,040
حسناً، أنا متأكّد بأنّك ستكون
بخير بوجود فيل-ساما معك

167
00:12:07,250 --> 00:12:09,500
!إلى اللّقاء

168
00:12:11,130 --> 00:12:13,500
والآن لننزل أكثر

169
00:12:13,670 --> 00:12:15,330
...توقّعتُ هذا

170
00:12:25,460 --> 00:12:27,540
...الطّابق السّادس عشر

171
00:12:27,710 --> 00:12:31,040
يبدو الهواء هنا مختلفاً عن الطّوابق
الخمسة عشر الأولى

172
00:12:31,210 --> 00:12:33,410
هكذا هي الدّياميس

173
00:12:33,580 --> 00:12:36,210
هناك حالات حيث يكون التّغيير أكبر بكثير

174
00:12:43,830 --> 00:12:45,380
!ماذا؟ ما هذا الصّوت؟

175
00:12:53,040 --> 00:12:54,370
!ماذا؟

176
00:12:54,540 --> 00:12:56,330
!ما هذا بالضّبط؟

177
00:12:56,500 --> 00:12:58,130
لا تُحدث جلبة

178
00:13:03,710 --> 00:13:07,290
أليست الفِخاخ هنا أكثر شرّاً من السّابق؟

179
00:13:10,630 --> 00:13:13,040
وصلنا إلى الطّابق عشرين أخيراً

180
00:13:13,210 --> 00:13:15,460
هل أنت مُندهش بقوّتنا؟

181
00:13:15,630 --> 00:13:17,750
!سنظلّ نهزمهم الواحد تلو الآخر

182
00:13:17,920 --> 00:13:21,080
!فأساساً، نحن مُباركون بواسطة إله الحرب

183
00:13:21,250 --> 00:13:23,790
أتمنّى أن أصل إلى الأعماق بسرعة

184
00:13:23,960 --> 00:13:25,750
...لكن لا أريد الذّهاب

185
00:13:25,920 --> 00:13:27,290
مولايّ

186
00:13:28,040 --> 00:13:29,370
ما الأمر يا سوي؟

187
00:13:29,540 --> 00:13:32,420
ثمّة شيء هناك

188
00:13:33,290 --> 00:13:35,790
!هذا صندوق كنز

189
00:13:37,250 --> 00:13:38,660
!يا له من اكتشاف عظيم يا سوي

190
00:13:38,830 --> 00:13:41,210
!صناديق الكنز هي جزء هامّ من الدّياميس

191
00:13:41,380 --> 00:13:44,790
لم أعلم بأنّ إيجاد صندوق
!سيجعلني بهذا الحماس

192
00:13:45,460 --> 00:13:47,290
!ها أنا ذا -
انتظر -

193
00:13:47,830 --> 00:13:52,790
أخبرتُك، الدّياميس تستدرج
البشر بزينة الكنوز

194
00:13:52,960 --> 00:13:54,380
ألقِ نظرة عن كثب

195
00:13:55,330 --> 00:13:57,210
تـ-تقييم

196
00:13:58,170 --> 00:14:01,790
"إذا استنشقت الغاز السّام، ستموت"

197
00:14:01,960 --> 00:14:05,120
إذا تركناك وحيداً، فإنّك ستهلك بسرعة

198
00:14:05,290 --> 00:14:08,880
الدّياميس قاسية حقّاً

199
00:14:09,420 --> 00:14:11,250
...حسناً. سأنسى ذلك فحسب

200
00:14:11,420 --> 00:14:12,830
خيار جيّد

201
00:14:13,000 --> 00:14:16,290
،نحن محميّون بواسطة بركاتنا

202
00:14:16,460 --> 00:14:19,250
لكن أنت لديك برَكات ثانويّة

203
00:14:19,420 --> 00:14:21,080
سأفتحه بالنّيابة عنك

204
00:14:22,380 --> 00:14:25,870
هل تسمعني أيّها القادم من عالم آخر؟

205
00:14:26,040 --> 00:14:27,250
الإلَهة نينرير؟

206
00:14:27,420 --> 00:14:30,540
بخصوص البرَكة الثّانويّة الّتي ألقيتُها عليك

207
00:14:30,710 --> 00:14:33,540
،لأنّنا نحن الإلَهات كوّمنا برَكاتنا عليك

208
00:14:33,710 --> 00:14:36,960
أمستْ قويّة كبرَكة عاديّة

209
00:14:37,750 --> 00:14:42,620
نادراً ما تُبارد ثلاث إلَهات نفس الشّخص

210
00:14:42,790 --> 00:14:44,960
تأخّرتُ في مُلاحظة ذلك

211
00:14:45,420 --> 00:14:48,580
هذا يعني بأنّك لا تمرض والغاز
السّام لن يؤثّر بك

212
00:14:48,750 --> 00:14:51,660
لن تموت من معظم الأشياء، لذا
...ليس عليك القلق

213
00:14:51,830 --> 00:14:56,830
!لذا... استمتع بالدّيماس لأقصى درجة

214
00:14:57,000 --> 00:14:59,710
أين تتعلّم مثل هذه الكلمات؟

215
00:15:00,250 --> 00:15:01,250
ما الأمر؟

216
00:15:01,420 --> 00:15:05,620
يبدو أنّ البرَكات الثّانويّة المُتشابكة
قد تكدّست لتصبح برَكة عاديّة واحدة

217
00:15:05,790 --> 00:15:09,880
،فهمت. إن كانت الإلَهة نينرير تقول ذلك
فلا بُدّ أنّه صحيح إذاً

218
00:15:10,630 --> 00:15:12,160
سأحاول فتح الصّندوق بنفسي

219
00:15:12,330 --> 00:15:13,670
...رغم أنّني خائف

220
00:15:21,250 --> 00:15:22,250
!يا إلهي

221
00:15:22,420 --> 00:15:24,540
!مرحى! مرحى

222
00:15:24,710 --> 00:15:27,250
...إنّه دخانيّ قليلاً، لكن أنا بخير

223
00:15:27,540 --> 00:15:28,960
ماذا يوجد في الدّاخل؟

224
00:15:31,000 --> 00:15:32,910
!سُمِّمتُ عن عبث

225
00:15:33,080 --> 00:15:37,330
!تبّاً! لنبحث عن صندوق كنز جيّد تالياً

226
00:15:37,500 --> 00:15:39,920
...تحفّزت فجأة

227
00:15:43,210 --> 00:15:44,830
!إنّه ضخم

228
00:15:45,000 --> 00:15:47,580
إنّه في أقصى خلف هذه المنطقة

229
00:15:47,750 --> 00:15:48,880
لا بُدّ أنّه مُميّز

230
00:15:49,290 --> 00:15:51,750
!أنا متأكّد بأنّه يوجد شيء رائع في الدّاخل

231
00:15:54,000 --> 00:15:56,460
!أجل! إنّه وحش

232
00:15:56,630 --> 00:15:59,500
الصّندوق المُزيّف يُهاجم حالما تُحاول فتحه

233
00:15:59,670 --> 00:16:03,830
نظراً لحجمه، لعلّه يُخفي شيئاً جيّداً

234
00:16:04,000 --> 00:16:05,210
!لنحاول فتحه

235
00:16:05,380 --> 00:16:07,330
!افتحه! افتحه

236
00:16:09,380 --> 00:16:12,040
!حسناً، لنُجرّب ذلك

237
00:16:17,460 --> 00:16:18,750
أنقذوني إذا حدث شيء

238
00:16:18,920 --> 00:16:20,460
بسرعة

239
00:16:31,790 --> 00:16:32,960
هل مات؟

240
00:16:33,580 --> 00:16:34,620
أجل

241
00:16:34,790 --> 00:16:36,960
!مولايّ، فعلتها

242
00:16:38,460 --> 00:16:40,960
...هذا السّيف القصير الميثريليّ مُذهل

243
00:16:41,420 --> 00:16:43,290
يعزو كلّ الفضل لك يا سوي

244
00:16:51,920 --> 00:16:53,920
!صندوق مُجوهرات

245
00:16:56,670 --> 00:16:58,670
!وهناك أشياء كثيرة في داخله

246
00:16:58,960 --> 00:17:00,170
...عجيب

247
00:17:00,830 --> 00:17:02,540
أنا مسرور لأجلك

248
00:17:02,710 --> 00:17:03,960
!أنتم

249
00:17:04,420 --> 00:17:06,920
!وجدتُ السّلالم

250
00:17:19,750 --> 00:17:20,750
ماذا؟

251
00:17:22,460 --> 00:17:24,080
ما هذا بالضّبط؟

252
00:17:25,210 --> 00:17:26,500
وصلت الأمور إلى هنا إذاً

253
00:17:26,670 --> 00:17:28,790
!هذا الدّيماس مُثير حقّاً للاهتمام

254
00:17:28,960 --> 00:17:32,250
هذا ليس مُثيراً إطلاقاً! أليس
!هذا مُفاجئاً قليلاً؟

255
00:17:32,710 --> 00:17:33,870
اصعد

256
00:17:34,040 --> 00:17:36,620
أشعر بوجود قويّ نسبيّاً

257
00:17:36,790 --> 00:17:38,080
سنتوجّه إلى هناك

258
00:17:38,250 --> 00:17:39,370
حقّاً؟

259
00:17:39,540 --> 00:17:41,040
!هيّا بنا! هيّا بنا

260
00:17:41,210 --> 00:17:42,750
!لا يستطيع سوي الانتظار

261
00:17:42,920 --> 00:17:44,290
بسرعة

262
00:17:44,460 --> 00:17:46,330
حسناً. حسناً

263
00:18:01,500 --> 00:18:04,080
!ضخم للغاية! إنّه برتبة ب

264
00:18:04,250 --> 00:18:05,960
ضعيف آخر

265
00:18:11,880 --> 00:18:13,080
...فيل

266
00:18:13,670 --> 00:18:16,160
!لماذا أسقطته لوحدك؟

267
00:18:16,330 --> 00:18:19,370
!هذا ليس عدلاً يا عمّ فيل

268
00:18:19,540 --> 00:18:23,330
ما أهمّية ذلك؟ ينبغي أن نختار شيئاً أقوى

269
00:18:23,500 --> 00:18:26,540
أنت تقول ذلك، لكن تنوي القتال
بمفردك ثانية، صحيح؟

270
00:18:26,710 --> 00:18:28,710
سوي يريد القتال أيضاً

271
00:18:28,880 --> 00:18:32,830
يريد سوي المُغامرة وهزيمة
!الكثير من الوحوش

272
00:18:33,920 --> 00:18:38,120
مهلاً، مهلاً. لِمَ لا نتناوب على القتال؟

273
00:18:38,290 --> 00:18:41,040
يمكن لدورا-تشان أن يذهب تالياً
ثمّ يأتي دور سوي بعد ذلك

274
00:18:41,210 --> 00:18:42,580
حسناً على ما أعتقد

275
00:18:42,750 --> 00:18:46,080
بما أنّ مولايّ يقول ذلك، سوي سيصغي له

276
00:18:46,250 --> 00:18:48,710
!أنت فتى جيّد يا سوي

277
00:18:51,000 --> 00:18:52,630
!هيّا بنا

278
00:18:57,210 --> 00:18:58,420
!سريع للغاية

279
00:19:00,580 --> 00:19:03,500
هؤلاء يبعثون غُباراً سامّاً يشلّ الحركة

280
00:19:03,670 --> 00:19:05,500
ويمتصّون سوائل جسد فريستهم وهي حيّة

281
00:19:05,670 --> 00:19:07,250
!إنّهم أشرار للغاية

282
00:19:07,420 --> 00:19:09,660
سوي، احرص على مُهاجمتهم من بعيد

283
00:19:09,830 --> 00:19:11,380
عُلِم

284
00:19:14,290 --> 00:19:18,210
!مرحى! هزمتُهم جميعاً

285
00:19:18,380 --> 00:19:21,540
هذا صحيح. سوي مُذهل

286
00:19:24,540 --> 00:19:27,750
اقتربنا من الوجود الّذي أشعر به. إنّه قريب

287
00:19:27,920 --> 00:19:29,500
مهلاً لحظة يا فيل

288
00:19:30,040 --> 00:19:33,330
ذلك الحضور القويّ هو الزّعيم غالباً، صحيح؟

289
00:19:33,500 --> 00:19:35,120
وماذا يعني؟

290
00:19:35,290 --> 00:19:37,540
لنتناول وجبة قبل أن نُقاتله

291
00:19:37,710 --> 00:19:39,870
تحسّباً فقط، أريد استخدام البقالة عبر الإنترنت

292
00:19:42,830 --> 00:19:46,540
،لن نخسر بوضعنا الرّاهن

293
00:19:46,710 --> 00:19:49,830
لكن أكل المُكوّنات من عالمك فكرة سديدة

294
00:19:51,540 --> 00:19:55,380
ما رأيك بشريحة اللّحم الّتي حظينا بها من قبل؟ -
!هذا مثاليّ -

295
00:19:55,670 --> 00:19:58,410
حسناً، لنأكل بعض شرائح لحم
...الواغيو اليابانيّ الأليف

296
00:19:58,580 --> 00:20:00,960
سيكون بلا نكهة إذا لم نحصل
...سوى على هذا

297
00:20:01,130 --> 00:20:03,830
لحم خنزير مشويّ مُتبَّل

298
00:20:04,000 --> 00:20:05,830
بملح اللّيمون ونكهة ملح البصل الأخضر

299
00:20:06,000 --> 00:20:08,580
...ونضيف سجقاً مفروماً خشناً

300
00:20:08,750 --> 00:20:12,000
وحتّى أنّ لديهم بطّ مشويّ بالفلفل الأسود؟

301
00:20:12,630 --> 00:20:15,750
فخذ ياكيتوري وكبد أيضاً

302
00:20:15,920 --> 00:20:17,580
ينبغي أن يكون هذا لحماً كافياً

303
00:20:17,750 --> 00:20:20,630
ثمّ يجدر بنا أن نطلب بعضاً
من الشّطائر لأجلي

304
00:20:21,040 --> 00:20:24,880
شكراً على الانتظار. احرصوا
مدّ أنفسكم بالطّاقة

305
00:20:35,420 --> 00:20:36,790
!طبق آخر

306
00:20:36,960 --> 00:20:38,000
كان ذلك سريعاً

307
00:20:42,670 --> 00:20:45,790
اللّحم المُملّح باللّيمون والبصل المُملّح
!بالبصل الأخضر مُنعشان وشهيّان

308
00:20:47,790 --> 00:20:49,870
!وهذه مُقرمشة وريّانة

309
00:20:50,040 --> 00:20:51,120
!طبق آخر

310
00:20:51,290 --> 00:20:53,000
حسناً. حسناً

311
00:21:01,960 --> 00:21:03,790
!طبق آخر

312
00:21:04,920 --> 00:21:07,120
الطّعام من عالمك شهيّ حقّاً

313
00:21:07,290 --> 00:21:10,370
،هذه أوّل مرّة أتناول فيها بعضاً
لكن كان لذيذاً جدّاً

314
00:21:10,540 --> 00:21:13,210
كان لذيذاً يا مولايّ

315
00:21:14,170 --> 00:21:16,120
يسرّني سماع ذلك

316
00:21:16,290 --> 00:21:19,410
حسناً، ماذا عن إحصائيّاتنا؟

317
00:21:19,580 --> 00:21:20,830
فيل أوّلاً

318
00:21:21,830 --> 00:21:23,830
...ارتفعت كثيراً

319
00:21:24,540 --> 00:21:25,750
ماذا عنك يا دورا-تشان؟

320
00:21:25,920 --> 00:21:27,830
بئساً، ربّما بالغتُ قليلاً؟

321
00:21:28,920 --> 00:21:30,920
ماذا عن سوي؟

322
00:21:33,630 --> 00:21:36,170
،حسناً، نحن على وشك أن نُقاتل زعيماً
...لذا أنا متأكّد بأنّ الأمور بخير

323
00:21:36,670 --> 00:21:38,290
أخيراً، سألقي نظرة إلى نفسي

324
00:21:38,460 --> 00:21:41,790
لا جدوى إذا لم ترتفع إحصائيّاتك كما ينبغي

325
00:21:41,960 --> 00:21:43,790
يجب أن تتمالك نفسك

326
00:21:43,960 --> 00:21:47,290
!مولايّ، يمكنك فعلها

327
00:21:56,210 --> 00:21:57,710
هذا كلّ شيء؟

328
00:23:26,040 --> 00:23:29,460
حسناً، تناولتُ للتو بعضاً من الشّطائر
والأطباق الجانبيّة

329
00:23:29,630 --> 00:23:32,120
أنا متأكّد بأنّ الأمور ستكون على ما يُرام
!ما دامت إحصائيّاتكم مُرتفعة

330
00:23:32,290 --> 00:23:36,080
طريقتك في التّفكير هي السّبب
!في عدم تطوّرك

331
00:23:36,250 --> 00:23:37,960
هذا صحيح

332
00:23:38,380 --> 00:23:43,830
يبدو أنّ الإله هيفايستوس منحني مهارة الدّفاع
المثاليّ في آخر مرّة قدّمتُ فيها العطايا

333
00:23:44,630 --> 00:23:47,540
حسناً، ربّما لستُ بحاجة لها
...بما أنّ لديّ حاجز فيل

334
00:23:47,710 --> 00:23:48,710
!ماذا؟

335
00:23:48,880 --> 00:23:51,250
لكن لا ضير من اتّخاذ إجراءات أمان

336
00:23:51,420 --> 00:23:53,210
فالدّياميس مُخيفة