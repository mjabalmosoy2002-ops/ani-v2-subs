1
00:00:05,220 --> 00:00:08,410
!يمكننا رؤية جبل سيلين

2
00:00:08,410 --> 00:00:10,290
.إنه ضخم

3
00:00:10,290 --> 00:00:13,070
.لكن هناك أمر مريب بهذا الجبل

4
00:00:13,830 --> 00:00:16,000
.قرأت عنه في أحد الكتب

5
00:00:16,000 --> 00:00:19,510
،عندما تدربت الساحرة سيلين هنا

6
00:00:19,510 --> 00:00:23,500
تسبب تأثيرها بحلول الفصول الأربعة
.بالمكان في نفس الوقت

7
00:00:24,040 --> 00:00:26,940
.سيكون هذا المكان ممتعًا

8
00:02:02,280 --> 00:02:04,020
أسنقيم هنا؟

9
00:02:04,020 --> 00:02:05,420
!أشبه بقلعة

10
00:02:05,870 --> 00:02:08,660
هذا النُزل القديم أشبه بقلعة؟
.أنتِ مضحكة

11
00:02:09,290 --> 00:02:10,720
.كيرون

12
00:02:10,720 --> 00:02:13,930
.صحيح، أنت عيش في قلعة حقيقية

13
00:02:13,930 --> 00:02:15,440
أنت الأمير الثاني، صحيح؟

14
00:02:15,440 --> 00:02:16,520
.أجل

15
00:02:16,520 --> 00:02:21,930
تذكرت، أخبرنا المعلم أن نبقى
.ضمن مجمعنا خلال وجودنا هنا

16
00:02:21,930 --> 00:02:24,210
.من الأفضل ألا تعيقيني

17
00:02:24,210 --> 00:02:25,630
.تبدين بطيئة

18
00:02:25,630 --> 00:02:28,190
ما خطبه؟

19
00:02:28,190 --> 00:02:30,360
.إنه مغرور لأنه أمير

20
00:02:32,440 --> 00:02:39,050
.سمعتُ أن غريفون قد ابتلعك خلال الاختبار

21
00:02:39,050 --> 00:02:40,400
.أنت نكرة

22
00:02:40,400 --> 00:02:43,170
.أنت من عليه ألا يعيقنا

23
00:02:43,170 --> 00:02:44,920
ما خطبك؟

24
00:02:44,920 --> 00:02:46,710
!بئسًا، ستقتلني

25
00:02:46,710 --> 00:02:48,560
.توقف يا كيرون

26
00:02:49,180 --> 00:02:51,760
.أعتذر على سلوك كيرون

27
00:02:51,760 --> 00:02:53,810
.هيّا اعتذر

28
00:02:53,810 --> 00:02:55,860
!أفلتني

29
00:02:55,860 --> 00:02:57,640
تفضلا. بعض الوجبات الخفيفة
.كعربون صداقة

30
00:02:58,130 --> 00:03:01,850
.يحاول كيرون الانسجام مع الجميع أيضًا
.إنه مرتبك فحسب

31
00:03:01,850 --> 00:03:03,750
.أتفهّم هذا

32
00:03:03,750 --> 00:03:05,990
!توقف! لستَ أمي

33
00:03:05,990 --> 00:03:07,180
.مرحبًا

34
00:03:08,040 --> 00:03:09,810
.وصلتم جميعًا

35
00:03:09,810 --> 00:03:12,680
.سنبدأ التدريب فور استعداد الجميع

36
00:03:12,680 --> 00:03:14,160
هل أنتم مستعدون؟

37
00:03:14,160 --> 00:03:15,180
!أجل

38
00:03:15,180 --> 00:03:17,780
،حكيتَ لنا قصصًا مرعبة عن هذا المعسكر

39
00:03:17,780 --> 00:03:20,520
،لكن بعد وصولي إلى هنا
.صرتُ أتطلع لذلك

40
00:03:20,520 --> 00:03:21,710
!سأبذل جهدي

41
00:03:21,710 --> 00:03:23,670
.أنت متحمسة جدًا

42
00:03:23,920 --> 00:03:27,130
.يجب أن أحرز "د" على الأقل في الاختبارات الختامية

43
00:03:27,130 --> 00:03:31,030
!راقبني وأنا أجتاز معسكر الثلاثة أيام هذا بتفوّق

44
00:03:31,030 --> 00:03:32,520
.هذه هي الروح المطلوبة

45
00:03:33,020 --> 00:03:37,440
!حركوا أيديكم! لم يحن وقت الاستراحة بعد

46
00:03:39,410 --> 00:03:43,160
واصلوا التلويح يعصيّكم إن كنت تملكون
!الطاقة للصراخ

47
00:03:52,160 --> 00:03:54,120
.لا أستطيع

48
00:03:54,680 --> 00:03:55,980
.هيّا

49
00:03:55,980 --> 00:03:57,960
ماذا حدث لحماسك؟

50
00:03:58,360 --> 00:04:00,290
ستجتازين هذا بتفوّق، أليس كذلك؟

51
00:04:00,680 --> 00:04:01,980
.هيّا، انهضي

52
00:04:01,980 --> 00:04:03,460
!إنه مفعم بالحيوية

53
00:04:03,460 --> 00:04:06,440
!نستخدم سحرنا منذ ساعة دون توقف

54
00:04:06,440 --> 00:04:08,760
!أجل! امنحنا استراحتنا

55
00:04:09,680 --> 00:04:11,310
ألم أخبركم؟

56
00:04:11,310 --> 00:04:15,680
لن ينتهي هذا التدريب
.ما لم تهزموا عشرة غوليم

57
00:04:15,680 --> 00:04:17,430
.لم تدمروا أيًا منها بعد

58
00:04:17,430 --> 00:04:20,850
من المستحيل أن نستطيع هزيمة
!عشر من هذه الغوليم المنيعة

59
00:04:21,790 --> 00:04:26,070
.خارت قواي وتكاد طاقتي السحرية تنفد

60
00:04:26,070 --> 00:04:27,240
.لا تقلقي

61
00:04:28,360 --> 00:04:30,920
ماذا تفعل؟

62
00:04:30,920 --> 00:04:33,360
هل سنعود إلى النُزل؟

63
00:04:33,360 --> 00:04:35,570
!من فضلك أيها المعلم

64
00:04:40,570 --> 00:04:42,110
كيف حالك؟

65
00:04:42,110 --> 00:04:43,370
!أيها الوحش

66
00:04:43,850 --> 00:04:46,520
.أشعر بخفّة

67
00:04:47,090 --> 00:04:50,340
.هذا ينبوع سحري
.يُجدد الطاقة السحرية

68
00:04:50,340 --> 00:04:53,900
لكنه يصبح ماء عاديًا
.إن أُخذ بعيدًا عن جبل سيلين

69
00:04:54,500 --> 00:04:58,040
سيجعلكم هذا قادرين على القتال
.كلما نفدت طاقتكم السحرية

70
00:04:58,040 --> 00:05:00,070
.لا يمكن القيام بهذا النوع من التدريب في أيّ مكان آخر

71
00:05:00,070 --> 00:05:04,660
.أرفض المعاناة حتى لو كان بوسعنا التعافي

72
00:05:04,660 --> 00:05:05,630
!كيرون

73
00:05:05,630 --> 00:05:07,110
ألا توافقيني الرأي؟

74
00:05:07,110 --> 00:05:08,620
.علينا مقاطعة هذا

75
00:05:09,960 --> 00:05:12,830
.أكره التداريب القاسية أيضًا

76
00:05:12,830 --> 00:05:15,790
.واستنزاف الطاقة السحرية مؤلم

77
00:05:16,840 --> 00:05:18,050
...لكن مع ذلك

78
00:05:18,050 --> 00:05:22,210
.لا أريد أن أشعر بذلك الانهزام مجددًا

79
00:05:25,120 --> 00:05:26,600
.سأقوم بهذا

80
00:05:26,600 --> 00:05:28,690
.سواء كانت عشرًا أو مائة

81
00:05:29,210 --> 00:05:31,790
هل أنت جادّة؟

82
00:05:31,790 --> 00:05:35,400
.يمكنك الهرب إن شئت أيها الأمير الكسول

83
00:05:35,890 --> 00:05:40,010
.لكنّي سأحصل على الرتبة "س" في الامتحانات الختامية

84
00:05:43,150 --> 00:05:47,070
لماذا تتصرفين بغطرسة؟

85
00:05:47,630 --> 00:05:49,200
هل ستقوم بذلك يا كيرون؟

86
00:05:49,200 --> 00:05:52,700
.لن أذلّ نفسي بالفرار بينما العامّة صامدون

87
00:05:52,700 --> 00:05:54,410
.ستقومين بهذا أيضًا يا يو

88
00:05:54,410 --> 00:05:56,460
!لا! مستحيل

89
00:06:00,410 --> 00:06:05,230
استنزاف الطاقة السحرية يسبب
أعراضًا أشبه بنقص الأوكسجين

90
00:06:05,230 --> 00:06:09,390
.والإرهاق جرّاء الركض لساعات

91
00:06:09,390 --> 00:06:12,880
لكن الطلاب يقولون أن لينبوع سيلين

92
00:06:12,880 --> 00:06:17,730
مفعول منعش مثل مفعول
.أخذ حمام بارد بعد الخروج من السونا

93
00:06:18,260 --> 00:06:20,290
!عدتُ لطبيعتي

94
00:06:20,290 --> 00:06:27,070
هذه النشوة المذهلة جعلت الجميع
.يتحملون تداريب كلود

95
00:06:27,950 --> 00:06:29,660
!أخيرًا

96
00:06:29,660 --> 00:06:31,280
.انتهى التدريب

97
00:06:31,280 --> 00:06:32,200
.أحسنتم

98
00:06:33,340 --> 00:06:35,370
ما هذا؟

99
00:06:35,630 --> 00:06:38,680
.إشارة على انتهاء تدريبي

100
00:06:38,680 --> 00:06:42,380
ستتدربون على يد معلمي بقية المجامع

101
00:06:42,380 --> 00:06:44,250
.وستجمعون أختامهم

102
00:06:45,100 --> 00:06:49,760
.هناك ستة معلمين آخرين في هذا المعسكر

103
00:06:49,760 --> 00:06:52,660
لن ينتهي تدريبكم إلا بعد جمع
.أختامهم جميعًا

104
00:06:52,660 --> 00:06:55,600
لم ننته بعد؟

105
00:06:55,970 --> 00:06:59,060
.أريد... الفرار

106
00:07:05,160 --> 00:07:09,400
.خلال تدريبي، سأسألكم عن الأبراج الـ12

107
00:07:09,770 --> 00:07:14,820
،للنجاح في التدريب
.عليكم الإجابة ست مرات متتالية بشكل صحيح

108
00:07:14,820 --> 00:07:16,000
...لكن

109
00:07:16,000 --> 00:07:18,010
:سحر الدلو

110
00:07:21,300 --> 00:07:22,890
!الصفر المطلق

111
00:07:28,290 --> 00:07:31,790
.ستصعدون هذا التلّ المتجمّد بينما تجيبون

112
00:07:31,790 --> 00:07:35,090
،إن سقط أحدكم إلى الأسفل
.عليكم أن تبدأوا من جديد

113
00:07:35,630 --> 00:07:37,260
!سبيكا فيرغو

114
00:07:37,260 --> 00:07:37,760
!نعم

115
00:07:37,760 --> 00:07:39,930
!يا له من وجه قبيح

116
00:07:39,930 --> 00:07:41,710
ألا يمكنك الركض بشكل أفضل؟

117
00:07:41,710 --> 00:07:43,470
!اسأليني بسرعة

118
00:07:44,440 --> 00:07:46,300
ما اسم إلهة الخصوبة والحصاد

119
00:07:46,300 --> 00:07:48,020
التي استمدّ منها اسم كوكبة العذراء؟

120
00:07:48,840 --> 00:07:50,930
!سمعتُ هذا الاسم من قبل

121
00:07:50,930 --> 00:07:54,740
!أنا من برج العذراء أيها المعلم
أيّ نوع يجعلني ذلك؟

122
00:07:54,740 --> 00:07:56,990
...برج العذراء متعلق بإلهة الخصوبة

123
00:07:57,350 --> 00:07:58,490
!ديميتر

124
00:07:58,490 --> 00:07:59,670
.صحيح

125
00:07:59,670 --> 00:08:01,120
.أنا منبهرة

126
00:08:01,120 --> 00:08:04,570
.ربما يعود الفضل للمعلم كلود لتعليمي

127
00:08:04,570 --> 00:08:06,760
!حسنًا، لنواصل

128
00:08:07,300 --> 00:08:08,170
.أوريون

129
00:08:08,170 --> 00:08:11,470
.صحيح

130
00:08:09,180 --> 00:08:10,560
.الجسم السفليّ سمكة

131
00:08:12,550 --> 00:08:13,550
!صحيح

132
00:08:13,550 --> 00:08:15,220
!قِنطور

133
00:08:15,220 --> 00:08:16,050
!هذا صحيح

134
00:08:16,350 --> 00:08:19,380
.حان دورك يا يو، ثم ينتهي التدريب

135
00:08:19,660 --> 00:08:20,760
!إنها نائمة

136
00:08:20,760 --> 00:08:21,860
في هذا الوضع؟

137
00:08:21,860 --> 00:08:23,850
كيف يمكنها النوم وهي تركض؟

138
00:08:23,850 --> 00:08:25,840
أتعتقدين أن هذه لعبة؟

139
00:08:25,840 --> 00:08:28,450
!يتحمّل الفريق بأكمله المسؤولية
!ابدأو من جديد

140
00:08:30,570 --> 00:08:32,240
!استيقظي أيتها الغبية -

141
00:08:31,710 --> 00:08:37,330
.صفعت كابيلا يو لتستيقظ وتمكنوا من النجام في النهاية -

142
00:08:39,910 --> 00:08:41,320
!المزيد، المزيد

143
00:08:41,320 --> 00:08:43,390
!هاجموني بقوة أكبر

144
00:08:43,390 --> 00:08:45,570
المغزى من هذا التدريب هو

145
00:08:45,570 --> 00:08:47,740
!تطوير عقلية القتال ضد الآخرين

146
00:08:47,740 --> 00:08:51,000
!هاجموني بأقوى سحر لديكم

147
00:08:51,000 --> 00:08:55,040
!لن تنجحوا ما لم تجعلوني أتألم

148
00:08:55,040 --> 00:08:56,130
ماذا؟

149
00:08:56,130 --> 00:08:57,970
.حسنًا

150
00:08:57,970 --> 00:08:59,980
!سحر العقرب

151
00:09:02,830 --> 00:09:04,450
!مهلًا يا هانا-تشان

152
00:09:04,450 --> 00:09:07,160
.لا، لا تحاول هذه المعلمة الدفاع عن نفسها

153
00:09:08,000 --> 00:09:10,260
!أجل

154
00:09:10,260 --> 00:09:12,240
هل أنت بخير؟

155
00:09:12,240 --> 00:09:13,450
.أنا على ما يرام

156
00:09:13,450 --> 00:09:15,850
.تعذيب السمّ هو البداية فقط بالنسبة لي

157
00:09:15,850 --> 00:09:17,040
البداية؟

158
00:09:17,040 --> 00:09:21,870
يمتص سحر الجدي الهجمات
.من جسدي بأكمله

159
00:09:21,870 --> 00:09:25,060
.ستكونين مهيمنة ممتازة

160
00:09:25,060 --> 00:09:26,620
.لا أريد ذلك

161
00:09:26,620 --> 00:09:30,160
.واستمرّ تدريب المعلمة بولاريس

162
00:09:31,370 --> 00:09:33,760
!يصيب ذلك السوط المكان المناسب

163
00:09:33,760 --> 00:09:35,500
!امنحوني المزيد

164
00:09:35,500 --> 00:09:36,780
!سحر الحمل

165
00:09:36,780 --> 00:09:38,630
.ليس قويًا بما يكفي

166
00:09:38,630 --> 00:09:39,870
!سحر القوس

167
00:09:39,870 --> 00:09:41,380
!هذا يدغدغ

168
00:09:41,680 --> 00:09:44,480
!شكرًا لك -

169
00:09:43,350 --> 00:09:45,520
هل هناك مغزى من هذا؟ -

170
00:09:45,520 --> 00:09:47,860
!أنت لطيف جدًا! هذا ليس ممتعًا

171
00:09:48,160 --> 00:09:51,710
!يجب أن تكون مستعدًا لردّ الصاع صاعين

172
00:09:51,710 --> 00:09:55,710
واجه تارف صعوبة أكثر من الآخرين
.لكونه لطيفًا

173
00:09:58,120 --> 00:10:02,350
.سأقدّم لكم الإرشاد لتدريب أذهانكم

174
00:10:02,350 --> 00:10:06,360
سأستخدم سحر العين الداخلية
.للنظر إلى داخل لا وعيكم

175
00:10:06,360 --> 00:10:08,290
.صفّوا أذهانكم رجاءً

176
00:10:10,240 --> 00:10:13,150
.سحر الميزان: عين العدالة

177
00:10:13,980 --> 00:10:16,540
.هذا التدريب لي سهلًا لكنه ممل

178
00:10:16,540 --> 00:10:17,750
.أنا ضجرة

179
00:10:17,750 --> 00:10:19,640
.المعلم ممل أيضًا

180
00:10:19,640 --> 00:10:22,280
.لا أعتقد أنّي سأتذكر وجهه بحلول الغد

181
00:10:22,280 --> 00:10:25,420
.لا يترسّخ في الذهن مثل بقية المعلمين

182
00:10:25,420 --> 00:10:26,740
.مضغ، مضغ، مضغ

183
00:10:26,740 --> 00:10:27,680
.مضغ، مضغ

184
00:10:27,950 --> 00:10:29,940
.حسنًا، انتهينا من التأمل

185
00:10:29,940 --> 00:10:31,070
...بكاء، بكاء

186
00:10:31,070 --> 00:10:33,150
هل تبكي أيها المعلم؟

187
00:10:34,560 --> 00:10:37,110
.والآن، نتائج إرشادكم

188
00:10:37,110 --> 00:10:43,200
،تواجه سبيكا بعض المخاوف
.لكني أشعر برغبة شديدة في حماية الآخرين

189
00:10:43,410 --> 00:10:46,140
.واصلي على هذا النحو واعملي بجدّ

190
00:10:47,070 --> 00:10:50,690
،تبدو هانا متوّجسة قليلًا من قدراتها

191
00:10:50,690 --> 00:10:55,490
لكن تملك قلبًا طيبًا
.وهي مستعدة للتضحية من أجل أصدقائها

192
00:10:55,490 --> 00:10:58,850
.تميل كابيلا إلى المثالية

193
00:10:58,850 --> 00:11:01,930
.يمكنك الاسترخاء قليلًا

194
00:11:01,930 --> 00:11:05,200
.حسّك بالصواب يجعلك مناسبة للقيادة أيضًا

195
00:11:05,200 --> 00:11:06,430
...الصواب

196
00:11:06,430 --> 00:11:09,320
.يتدخل تارف في شؤون الآخرين

197
00:11:09,320 --> 00:11:11,210
لكنك تملك روحًا كريمة رائعة

198
00:11:11,210 --> 00:11:13,650
.وأنت تقدّر رابطتك بمن حولك

199
00:11:13,650 --> 00:11:15,040
.وكيرون

200
00:11:15,040 --> 00:11:15,940
أجل؟

201
00:11:15,940 --> 00:11:19,040
.أشعر بقلّة الصبر والخوف في روحك

202
00:11:19,770 --> 00:11:25,390
.تحاول إخفاء خجلك بالتظاهر بالقوة

203
00:11:25,390 --> 00:11:28,600
.أول خطة هي الاعتراف بضعفك

204
00:11:28,600 --> 00:11:30,370
كيف تجرؤ؟

205
00:11:30,370 --> 00:11:32,200
من الذي تصفه بالخجول؟ -

206
00:11:30,840 --> 00:11:32,470
!اهدأ -

207
00:11:32,470 --> 00:11:34,950
...والأكثر إثارة للقلق

208
00:11:35,340 --> 00:11:38,950
يو، لا نية لديك لتعلم السحر، صحيح؟

209
00:11:40,640 --> 00:11:43,650
من المبهر أنكِ تمكنت من الالتحاق
،بالأكاديمية بهذا السلوك

210
00:11:43,650 --> 00:11:45,450
.لكن هذا لن ينفعك على المدى الطويل

211
00:11:45,870 --> 00:11:48,370
.يجب أن تعثري على أهداف ومطامح

212
00:11:50,510 --> 00:11:52,880
أكان هذا قاسيًا؟

213
00:11:52,880 --> 00:11:53,560
.لا

214
00:11:53,560 --> 00:11:55,130
.إنها نائمة

215
00:12:03,370 --> 00:12:05,790
.كان يومًا طويلًا

216
00:12:05,790 --> 00:12:07,210
.نحن نستحمّ معًا

217
00:12:07,210 --> 00:12:08,880
.كأننا صديقات حقيقيات

218
00:12:08,880 --> 00:12:10,870
.الينابيع الساخنة هي الأفضل

219
00:12:10,870 --> 00:12:12,850
.أريد العيش في ينبوع ساخن

220
00:12:12,850 --> 00:12:14,340
.أوافقك الرأي

221
00:12:14,620 --> 00:12:18,160
...تذكرت، جعلني الإرشاد أفكر

222
00:12:18,160 --> 00:12:20,840
لماذا التحقت بديانا يا يو؟

223
00:12:21,910 --> 00:12:24,240
.دعتني كابيلا

224
00:12:24,790 --> 00:12:27,700
.قالت أن تعلم السحر ممتع

225
00:12:27,700 --> 00:12:30,300
.نعرف بعضنا منذ زمن طويل

226
00:12:30,300 --> 00:12:32,270
.لطالما كانت كسولة

227
00:12:32,270 --> 00:12:35,940
.يجب أن أراقبها وإلا تدهورت حالتها

228
00:12:36,750 --> 00:12:40,330
.لكن استخدام السحر ليس ممتعًا

229
00:12:40,330 --> 00:12:43,240
...الدراسة والدراسة والتدريب والتدريب

230
00:12:43,240 --> 00:12:45,280
.ثم نُصنّف أيضًا

231
00:12:46,520 --> 00:12:48,990
.أودّ قضاء كل يوم في الاسترخاء

232
00:12:49,360 --> 00:12:53,250
.أنام متى شئت وآكل متى شئت

233
00:12:53,540 --> 00:12:57,080
.أودّ العيش دون أن يسائلني أحد

234
00:12:57,080 --> 00:12:58,220
.لن ينفع هذا

235
00:12:58,220 --> 00:13:00,850
كيف تنوين كسب قوت يومك هكذا؟

236
00:13:00,850 --> 00:13:03,430
.سأزرع خضراواتي وما شابه

237
00:13:03,430 --> 00:13:05,530
هذا ليس سهلًا

238
00:13:05,530 --> 00:13:07,630
!وما همّك؟ أتحدث عن مُثلي فحسب

239
00:13:07,630 --> 00:13:09,310
.أنتِ ملتزمة يا كابيلا

240
00:13:09,980 --> 00:13:13,720
لا فائدة من التحدث عن المُثل
!ما لم تحوليها إلى أفعال

241
00:13:13,720 --> 00:13:16,030
.لهذا عليك أن تدرسي حاليًا

242
00:13:16,030 --> 00:13:18,730
!أكره اضطراري لفعل أمور كهذه

243
00:13:18,730 --> 00:13:22,360
!أريد العيش كما أريد

244
00:13:23,190 --> 00:13:24,030
...كبير

245
00:13:24,380 --> 00:13:25,930
ما العمل يا سبيكا؟

246
00:13:25,930 --> 00:13:27,440
.إنهما تتشاجران

247
00:13:27,970 --> 00:13:30,340
يمكنني إظهار انقسام إن ضغط
!على صدري أيضًا

248
00:13:30,340 --> 00:13:31,700
ما الذي تتحدثين عنه؟

249
00:13:35,730 --> 00:13:38,410
.أشعر بإرهاق أكبر بعد الاستحمام

250
00:13:38,410 --> 00:13:41,770
.دام جدالهما ساعة تقريبًا

251
00:13:42,640 --> 00:13:46,140
المعلم كلود وكابيلا؟

252
00:13:46,140 --> 00:13:47,450
.أقدّر هذا

253
00:13:47,450 --> 00:13:51,220
.أتيتِ إلى المعسكر مع أنك نجحتِ في الاختبار النصفيّ

254
00:13:51,220 --> 00:13:52,100
.لا بأس

255
00:13:52,570 --> 00:13:55,570
.أتيت بسبب يو

256
00:13:55,960 --> 00:14:00,000
آمل أن تعثر في هذا المعسكر
.على أمر يُلهمها

257
00:14:00,320 --> 00:14:03,530
.تملك الكفاءة في الواقع

258
00:14:03,530 --> 00:14:07,330
أنا مقتنعة أنها أكثر أعضاء
.المجمع موهبة

259
00:14:07,860 --> 00:14:11,700
.لذا سأبقى بجانبها حتى النهاية

260
00:14:11,700 --> 00:14:13,300
...كابيلا-تشان

261
00:14:13,300 --> 00:14:14,380
.يا لها من فتاة صالحة

262
00:14:14,380 --> 00:14:16,860
.هذه صداقة حقيقية

263
00:14:20,680 --> 00:14:22,280
!شيء ما آتٍ نحونا

264
00:14:29,320 --> 00:14:33,470
...حملاني الصغيرة، اجتمعي هنا في أرض الفوضى هذه

265
00:14:33,800 --> 00:14:36,690
.لم يُسدل الستار بعد

266
00:14:36,690 --> 00:14:39,070
!أتى أغرب معلم -

267
00:14:36,900 --> 00:14:40,940
!أنا بيغاسوس يامادا، مُرشدكم المخلّص -

268
00:14:39,070 --> 00:14:41,820
!لم نُنه اليوم الأول بعد -

269
00:14:42,360 --> 00:14:45,150
!أهلًا بكم يا جواهري

270
00:14:46,260 --> 00:14:50,270
.سحر كروس هو تناغم السحر مع السحر

271
00:14:50,270 --> 00:14:53,170
.دعوني أعلمكم جوهره

272
00:14:53,720 --> 00:14:55,770
...سحر كروس

273
00:14:55,770 --> 00:14:57,830
.ورد هذا في حصص كلود أيضًا

274
00:14:57,830 --> 00:15:02,450
حيث تدمج السحر لتُنتج شيئًا جديدًا، صحيح؟

275
00:15:02,450 --> 00:15:04,840
!هيّا يا راقصات بيغاسوس

276
00:15:05,990 --> 00:15:07,250
من أين أتين؟

277
00:15:08,660 --> 00:15:12,010
!إليكم سحر كروس خاصتي

278
00:15:12,400 --> 00:15:15,210
.سأجعل الزهور تُزهر

279
00:15:22,700 --> 00:15:24,460
!إنه سحر العذراء

280
00:15:24,460 --> 00:15:25,420
!جميل جدًا

281
00:15:25,420 --> 00:15:26,400
لماذا الرقص؟

282
00:15:26,400 --> 00:15:27,650
.ساطع جدًا

283
00:15:27,650 --> 00:15:31,920
،خذوا يد شخص مختلف
.وستتغيّر الزهور أيضًا

284
00:15:40,690 --> 00:15:43,830
.سحر كروس مذهل حقًا

285
00:15:43,830 --> 00:15:46,450
.أريد فعل ذلك مجددًا

286
00:15:46,680 --> 00:15:49,040
!حان وقت الجواهر

287
00:15:49,040 --> 00:15:51,430
!دعوني أرى رقصكم

288
00:15:51,430 --> 00:15:55,160
.سحر العذراء: جادجمنت روز

289
00:15:56,780 --> 00:15:58,180
ما هذا؟

290
00:15:58,180 --> 00:16:00,830
.ترمز هذه الزهرة إلى ثنائي

291
00:16:00,830 --> 00:16:04,570
.يُزهر البرعم عند تزامن عقليكما

292
00:16:04,570 --> 00:16:07,590
بعد أن تتفتّح، عليكم تشكيل ثنائيّ آخر
.ضمن مجمعكم

293
00:16:07,590 --> 00:16:11,950
،مرّوا على جميع أعضاء المجمع
.وسأمنحكم خاتم موافقتي الرائع

294
00:16:12,690 --> 00:16:15,990
!والآن يا ساندريلا، حان وقت الحفلة الراقصة

295
00:16:15,990 --> 00:16:19,270
.سحر العذراء: حبوب اللقاح الإبهار

296
00:16:21,690 --> 00:16:23,360
!ارقصو بجنون

297
00:16:23,360 --> 00:16:25,640
!ليتس بيغاسوس

298
00:16:27,370 --> 00:16:29,670
.نجحنا مرة من قبل

299
00:16:29,670 --> 00:16:31,830
سيكون الأمر سهلًا علينا، صحيح؟

300
00:16:32,130 --> 00:16:33,920
!لنرقص يا هانا-تشان

301
00:16:36,720 --> 00:16:39,870
...أخجل من الرقص علنًا

302
00:16:40,260 --> 00:16:41,940
.لكن ما باليد حيلة

303
00:16:41,940 --> 00:16:43,800
!حان وقت العرض

304
00:16:47,050 --> 00:16:48,700
!مؤلم

305
00:16:48,700 --> 00:16:51,890
.أنتِ متيبّسة يا هانا-تشان

306
00:16:51,890 --> 00:16:53,400
!أنتِ أيضًا يا سبيكا

307
00:16:53,400 --> 00:16:55,400
!كنتِ تتعثّرين

308
00:16:56,440 --> 00:16:58,670
.لم أتوقع أفضل من هذا من ريفيّتين

309
00:16:58,670 --> 00:16:59,510
!ويحك

310
00:16:59,510 --> 00:17:00,790
!أيها الأمير الكسول

311
00:17:00,790 --> 00:17:01,950
!لا تناديني بالكسول

312
00:17:01,950 --> 00:17:04,290
لكن لماذا ترتدي هذا؟

313
00:17:04,290 --> 00:17:05,180
.ظريف جدًا

314
00:17:05,180 --> 00:17:07,330
!بسبب سحر ذلك المعلم

315
00:17:08,870 --> 00:17:12,820
!شاهدي رقصي الراقي فحسب

316
00:17:14,510 --> 00:17:15,440
.مذهل

317
00:17:15,440 --> 00:17:17,350
.كما هو متوقع من أمير

318
00:17:17,350 --> 00:17:18,170
...لكن

319
00:17:18,170 --> 00:17:20,470
.يلوّح بكانسر في الأرجاء

320
00:17:20,470 --> 00:17:21,640
.أنت محقة

321
00:17:22,900 --> 00:17:25,140
!إنها تذبل

322
00:17:25,140 --> 00:17:27,130
.الوردة هي قلبكما كثنائي

323
00:17:27,610 --> 00:17:32,210
كلما ابتعدتما عن بعضكما
.كلما ذبلت الوردة

324
00:17:33,770 --> 00:17:36,290
!لن أرقص معك مجددًا

325
00:17:36,760 --> 00:17:38,050
!وأنا بالمثل

326
00:17:38,410 --> 00:17:40,580
!كانتا تتشاجران

327
00:17:40,580 --> 00:17:43,120
!مجمع كلود في ورطة

328
00:17:46,800 --> 00:17:49,430
.ليس حسّ الإيقاع ما تفتقرون له

329
00:17:49,850 --> 00:17:54,340
.الأهم هو تكريس قلب يحترق

330
00:17:54,340 --> 00:17:55,920
!بعبارة أخرى، الشغف

331
00:17:56,130 --> 00:17:59,810
هل أنتم شغوفون بالفشل بأنانية؟

332
00:17:59,810 --> 00:18:01,840
.لا يمكنكم الرقص بمفردكم

333
00:18:02,080 --> 00:18:06,310
،انظروا إلى عيني شركائكم
.التقوهم حيث يقفون وواكبوا حركاتهم

334
00:18:06,310 --> 00:18:10,400
.صدام الروح بالأخرى هو ما يُشعل الشغف

335
00:18:10,400 --> 00:18:11,520
!حاضر

336
00:18:12,590 --> 00:18:14,170
...انظري إلى عينيّ شريكتك

337
00:18:14,170 --> 00:18:15,530
.قريبة جدًا

338
00:18:15,810 --> 00:18:17,760
...التقيها حيث تقف

339
00:18:17,760 --> 00:18:19,200
.حسنًا، لا بأس

340
00:18:19,200 --> 00:18:23,290
.عليّ التحلي بالنضج والرقص من أجلها

341
00:18:23,290 --> 00:18:25,180
.والتحرك معًا

342
00:18:25,180 --> 00:18:27,050
هل ستواكب سرعتي؟

343
00:18:27,050 --> 00:18:29,370
.لأستطيع النجاح فحسب

344
00:18:29,780 --> 00:18:34,450
.صدام الروح بالأخرى هو ما يُشعل الشغف

345
00:18:35,950 --> 00:18:37,840
!لقد أزهرت

346
00:18:40,900 --> 00:18:44,800
،حتى بعد أن تعلمت سبيكا والآخرون الرقصة

347
00:18:44,800 --> 00:18:49,970
استغرق الأمر خمس ساعات
.لينجح مجمع كلود أخيرًا

348
00:18:53,060 --> 00:18:54,660
.تهانينا

349
00:18:54,660 --> 00:18:58,000
.شعرتُ بشغف جواهري

350
00:18:59,210 --> 00:19:04,720
.أستخدم سحر العذراء أيضًا أيها المعلم بيغاسوس

351
00:19:05,610 --> 00:19:10,340
هل تعتقد أن بوسعي استخدام سحر كروس
كما تفعل أنت إن بذلت جهدي؟

352
00:19:10,340 --> 00:19:11,590
.الإجابة هي لا

353
00:19:12,830 --> 00:19:15,830
.سحري خاص بي فقط

354
00:19:15,830 --> 00:19:19,810
.أنتِ لوحة يجب أن تلونيها بألوانك

355
00:19:19,810 --> 00:19:21,160
ماذا تعني؟

356
00:19:21,160 --> 00:19:25,180
سحر العذراء متوافق بشدّة
.مع كل أنواع السحر الأخرى

357
00:19:25,480 --> 00:19:27,470
،تدرّبي على سحر كروس

358
00:19:27,470 --> 00:19:30,970
وستستطيعين التحكم في سحر
.الأبراج الـ12 كلها

359
00:19:32,070 --> 00:19:34,920
الأبراج الـ12؟

360
00:19:37,270 --> 00:19:42,900
،أولًا، التقي العديد من الناس
.افهمي أرواحهم وكوّني روابط

361
00:19:43,170 --> 00:19:47,040
.أتطلع لنضج ثمرتك الحلوة

362
00:19:47,320 --> 00:19:49,230
.تسقط الوردة بجمال

363
00:19:49,230 --> 00:19:52,720
!يا جواهري، سنلتقي مجددًا في الأرض الموعودة

364
00:19:53,370 --> 00:19:55,890
،تحت القمر التائه في الظلام

365
00:19:55,890 --> 00:19:58,900
!ستتخبطون في أحضان الأحلام الأبدية

366
00:19:58,900 --> 00:20:01,870
.غريب الأطوار كعادته

367
00:20:02,550 --> 00:20:04,600
.المعلم كلود

368
00:20:04,600 --> 00:20:08,570
لا شكّ أن تأثير سحري قد زال
.لأن الليل قد حلّ

369
00:20:08,570 --> 00:20:09,710
.يا إلهي

370
00:20:09,710 --> 00:20:11,520
.هذا الجسد مزعج

371
00:20:11,520 --> 00:20:14,880
.يتخرّج على يدي بيغاسوس أفضل الطلاب كل عام

372
00:20:14,880 --> 00:20:16,430
.إنه معلم فذّ

373
00:20:16,430 --> 00:20:19,150
.يبدو أنكِ تعلمت منه أيضًا

374
00:20:19,150 --> 00:20:20,070
.أجل

375
00:20:20,690 --> 00:20:26,580
أريد التعرّف أكثر على من في مجمعي
.والتقرّب منهم

376
00:20:27,030 --> 00:20:33,150
لأكون صادقة، هذا المعسكر شاق جدًا
.لكنّي سعيدة لأنّي حضرته

377
00:20:33,150 --> 00:20:35,210
!سأبذل أقصى ما لديّ

378
00:20:39,470 --> 00:20:44,150
،سيكون تدريب الغد مع عجوز ديانا
.المعلم هيركوليس

379
00:20:44,590 --> 00:20:46,760
.يغادر المدرسة العديد من الطلاب كل عام

380
00:20:46,760 --> 00:20:48,310
.ستخوضون معه أصعب تحدي

381
00:20:48,770 --> 00:20:51,190
.تجاوزوه جميعًا

382
00:20:59,060 --> 00:21:02,580
،مرحبًا أيتها الآنسة
.لا تخاطري بالتسكع وحدك هنا ليلًا

383
00:21:02,580 --> 00:21:05,120
.سنحرص على سلامتك

384
00:21:05,120 --> 00:21:06,450
.شكرًا لكما

385
00:21:06,850 --> 00:21:08,530
هذا لطف منكما، صحيح؟

386
00:21:09,000 --> 00:21:10,220
...أنتِ جميـ

387
00:21:18,050 --> 00:21:20,240
.أنت فظيع يا ريغيل

388
00:21:20,240 --> 00:21:24,110
.كانا يحاولان حمايتي لطيبتها فحسب

389
00:21:24,110 --> 00:21:27,880
.يقبع وراء تلك الطيبة دافع خفيّ

390
00:21:27,880 --> 00:21:29,540
.تذكري ذلك

391
00:21:30,280 --> 00:21:32,880
.آسف على التأخر يا أرك

392
00:21:32,880 --> 00:21:35,160
.أحمل أمر من الزعيم

393
00:21:35,160 --> 00:21:39,000
هل نذهب لزيارة سبيكا فيرغو؟

394
00:21:42,750 --> 00:21:44,810
.يمكنني لقاءها أخيرًا

395
00:21:46,270 --> 00:21:48,150
.انتظري فحسب يا سبيكا

396
00:21:48,650 --> 00:21:52,860
.سأنتزع رأسك ذاك

397
00:23:25,230 --> 00:23:26,660
.إنه اليوم الثاني من معسكرنا

398
00:23:26,660 --> 00:23:29,460
.خصمنا في معركة المجمع مريب نوعًا ما

399
00:23:29,460 --> 00:23:32,060
.يبدو أنه حصل على الرتبة "أ" في الامتحان النصفيّ

400
00:23:32,060 --> 00:23:33,890
