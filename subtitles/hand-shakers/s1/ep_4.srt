1
00:00:07,440 --> 00:00:08,680
اختفيا؟

2
00:00:10,310 --> 00:00:13,110
!مع الأسف! كانت خدعة

3
00:00:23,720 --> 00:00:25,480
علينا أن نعيد تنظيم أنفسنا

4
00:00:26,070 --> 00:00:28,040
ستهزمنا هنا

5
00:00:37,710 --> 00:00:39,430
لن تفلت يا صغير

6
00:00:39,430 --> 00:00:43,430
لكن الزوجين الحبيبين اللّذين يستعملان
الجنازير قد أفلتا في المرّة السّابقة

7
00:00:45,350 --> 00:00:46,500
!هاياتي

8
00:00:46,950 --> 00:00:50,680
،كان ذلك لأنّها حمَت الجنزير بريك

9
00:00:50,680 --> 00:00:52,990
وأنت تردّدتَ عن مُهاجمتها

10
00:00:52,990 --> 00:00:54,940
كان بمقدورنا الفوز في تلك المعركة

11
00:00:55,860 --> 00:00:57,450
آسف

12
00:01:00,030 --> 00:01:01,450
هكذا إذاً

13
00:01:01,830 --> 00:01:06,620
يستطيع منعنا من استخدامِ خنجرنا ونصلنا

14
00:02:38,760 --> 00:02:43,010
مختبر حيّ

15
00:02:57,540 --> 00:03:00,840
يمكنُكم استخدام هذه العقبات لمنع مرونتنا في التقدُّم

16
00:03:00,840 --> 00:03:02,360
تفكير ذكيّ

17
00:03:02,650 --> 00:03:07,040
!لكن ليس من السّهل هزيمة خنجر ونصل أيُّها الصغير

18
00:03:17,290 --> 00:03:20,030
هذا مؤسفٌ يا صغير ويا كويوري-تشان

19
00:03:20,030 --> 00:03:21,470
هذه ساحات صيد

20
00:03:23,600 --> 00:03:25,980
حان وقتُ إنهاء الأمر

21
00:03:27,510 --> 00:03:28,700
لا أستطيع استخدام سيفي

22
00:03:28,700 --> 00:03:29,640
!سأستخدم درعاً

23
00:03:33,410 --> 00:03:35,150
لماذا تفعلان هذا؟

24
00:03:35,400 --> 00:03:36,840
لماذا؟

25
00:03:36,840 --> 00:03:40,650
لأنّنا مُتصافِحان أيُّها الصّغير

26
00:03:41,320 --> 00:03:42,400
!لا نريد أن نقاتل

27
00:03:43,460 --> 00:03:45,740
سأخبرك بسبب مختلف إذاً

28
00:03:45,740 --> 00:03:47,880
لأنّ لدينا أمنية

29
00:03:47,880 --> 00:03:50,410
!لهذا نقاتل، ولهذا سنهزمكما

30
00:03:51,050 --> 00:03:53,420
لا تعلمين حتّى ما إن كانت أمنيتكِ ستتحقّق

31
00:03:53,890 --> 00:03:56,440
قد تتحقّق

32
00:03:56,440 --> 00:03:58,100
هذا جيّد بما يكفي

33
00:03:58,100 --> 00:03:59,420
...سأقوِّي عزيمتي

34
00:03:59,960 --> 00:04:01,110
!وأقاتل

35
00:04:04,350 --> 00:04:06,070
...أظنُّنا مضطرّين لفعلها

36
00:04:07,410 --> 00:04:08,760
لا تقلقي

37
00:04:08,760 --> 00:04:09,830
لديّ خطّة

38
00:04:11,240 --> 00:04:14,890
لا نستطيعُ الهرب منهما نظراً لسرعتهما الفائقة

39
00:04:15,460 --> 00:04:19,180
لكن لا بدَّ من وجود طريقةٍ ما كي تتشابك الأمور

40
00:04:20,100 --> 00:04:21,580
...إن خسرتُ فإنَّ كويوري

41
00:04:23,450 --> 00:04:24,940
!سأحمي كويوري

42
00:04:30,950 --> 00:04:32,120
!سِتار دُخاني

43
00:04:32,850 --> 00:04:35,160
هذا ذكيّ

44
00:04:35,160 --> 00:04:36,830
لا بأس بك أيُّها الصّغير

45
00:04:36,830 --> 00:04:40,080
لكن حتّى لو هربتُما، ستكون نسختي بانتظاركما

46
00:04:40,630 --> 00:04:43,050
تبّاً! نسخة أخرى؟

47
00:04:43,770 --> 00:04:44,880
...إنّه بارعٌ حقّاً

48
00:04:45,540 --> 00:04:47,960
!لكن لن أدعك تفلت

49
00:04:47,960 --> 00:04:48,830
هذا مذهل

50
00:04:48,830 --> 00:04:50,810
يستجيبُ جسدي من تلقاء نفسه

51
00:04:51,560 --> 00:04:53,530
،لقد قاتلتُ لمرّةٍ واحدةٍ فقط

52
00:04:54,050 --> 00:04:55,670
لكنّني أعرف ماذا سيفعلان

53
00:04:56,080 --> 00:04:58,140
أستطيع استخدام مسنّناتي بحرّية

54
00:04:58,740 --> 00:05:02,360
هل هذا يعني أنّ مستوايّ كمُتصافح قد ترقّى؟

55
00:05:06,540 --> 00:05:07,920
!آسف لإفلاتكِ

56
00:05:08,470 --> 00:05:09,560
...كويوري

57
00:05:10,800 --> 00:05:12,700
أستطيع حمايتها للأبد هكذا

58
00:05:13,720 --> 00:05:14,540
هذا صحيح

59
00:05:14,540 --> 00:05:18,310
أقسمتُ أنّني لن أتركها

60
00:05:19,000 --> 00:05:21,710
!وألّا أفلت يدها إطلاقاً

61
00:05:22,960 --> 00:05:23,960
!من هنا

62
00:05:25,970 --> 00:05:27,240
...القليل فقط

63
00:05:29,120 --> 00:05:30,360
!القليل فقط

64
00:05:31,160 --> 00:05:32,860
!لن أدعكما تهربان

65
00:05:33,970 --> 00:05:35,530
هل يتبعاننا؟

66
00:05:41,760 --> 00:05:43,320
...إن صعدنا إلى هنا

67
00:05:49,840 --> 00:05:51,260
!هيّا بنا يا كويوري

68
00:06:02,360 --> 00:06:04,300
يبدو أنّكما اخترتُما القتال

69
00:06:08,820 --> 00:06:10,740
لننهِ هذا الأمر يا هاياتي

70
00:06:11,730 --> 00:06:14,310
سأتبعكِ أينما ذهبتِ يا سينباي

71
00:06:21,160 --> 00:06:23,070
!أنت فريستي أيّها الصّغير

72
00:06:31,070 --> 00:06:32,570
...لا أستطيع تمييز النسخ عن الحقيقيّة، لكن

73
00:06:34,320 --> 00:06:36,080
...في الأعلى

74
00:06:39,520 --> 00:06:40,730
تشابكَتْ

75
00:06:50,820 --> 00:06:52,370
كيف ميّزتَني من بين النسخ؟

76
00:06:52,370 --> 00:06:53,350
...لا

77
00:06:54,230 --> 00:06:55,850
استدرجَنا إلى هنا؟

78
00:07:01,350 --> 00:07:03,360
!لا يمكنكما محاصرتي هنا

79
00:07:05,360 --> 00:07:06,360
ماذا تفعل؟

80
00:07:11,510 --> 00:07:12,950
!تعال يا تازونا-كن

81
00:07:13,330 --> 00:07:14,070
!حسناً

82
00:07:14,950 --> 00:07:16,340
!هاياتي

83
00:07:19,580 --> 00:07:20,890
!أزوما-سان

84
00:07:20,890 --> 00:07:23,920
!لنحسم الأمر كرجلَين

85
00:07:24,280 --> 00:07:25,920
!هاياتي

86
00:07:41,840 --> 00:07:42,870
...هاياتي

87
00:07:44,160 --> 00:07:46,690
...أنا آسف

88
00:07:52,600 --> 00:07:53,800
تشيزورو-سان

89
00:07:56,790 --> 00:07:58,680
ربِحتُما

90
00:08:00,450 --> 00:08:03,340
هكذا هي آليّة هذه المعركة

91
00:08:07,970 --> 00:08:10,490
أبليتَ حسناً يا موظّفي

92
00:08:12,850 --> 00:08:14,060
شكراً لك

93
00:08:20,500 --> 00:08:22,680
!أنا حقّاً آسفة

94
00:08:22,680 --> 00:08:24,010
!أنا آسف

95
00:08:27,970 --> 00:08:29,790
...كـ-كفّا عن ذلك

96
00:08:29,790 --> 00:08:31,990
هذا ما يُفترَض بالمُتصافحين أن يفعلوه

97
00:08:32,370 --> 00:08:34,030
،حتّى لو لم نكن نعلم

98
00:08:34,030 --> 00:08:35,920
...تفوّهنا بكلام أنانيّ جدّاً

99
00:08:35,920 --> 00:08:37,720
لا بدَّ أن نعتذر

100
00:08:37,720 --> 00:08:38,800
هذا صحيح

101
00:08:38,800 --> 00:08:42,760
إن لم تشحن نفسها وخسرَتْ قوّتها، تموت؟

102
00:08:42,760 --> 00:08:45,000
!إن خسرَتْ تموت؟ هذا جنون

103
00:08:46,000 --> 00:08:49,750
أنا آسفٌ لأنّني بأتمّ صحّة

104
00:08:50,840 --> 00:08:53,740
قلتُ لها ألّا تدعه يحميها فحسب
...بل تُقاتل لأجل نفسها

105
00:08:53,740 --> 00:08:55,880
...دون أن أعرف ما كان يجري بالضبط

106
00:08:55,880 --> 00:08:58,140
أنا سيّئة للغاية

107
00:08:58,140 --> 00:09:00,010
أنا آسفةٌ يا كويوري-تشان

108
00:09:07,320 --> 00:09:08,550
كويوري-تشان

109
00:09:09,030 --> 00:09:10,220
شكراً لكِ

110
00:09:10,220 --> 00:09:11,520
أنتِ لطيفةٌ للغاية

111
00:09:11,520 --> 00:09:14,620
لكنّكِ تعاملينني كطفلة، توقّفي أرجوكِ

112
00:09:20,440 --> 00:09:27,170
على أي حال، هل عدم امتلاك كويوري-تشان
لنمرود يعزو لطبيعة جسدها؟

113
00:09:27,710 --> 00:09:31,230
لديّ نظريّات، لكن لم أتمكّن من إثبات
أي واحدة منها بعد

114
00:09:31,230 --> 00:09:32,660
هذا أبعد ما توصّلنا إليه

115
00:09:33,760 --> 00:09:36,170
!أحتاج لمزيد من المعلومات

116
00:09:41,430 --> 00:09:43,160
أتريدون بعضاً من الشوماي؟

117
00:09:43,640 --> 00:09:44,680
أوصي به

118
00:09:44,680 --> 00:09:46,690
!بالتأكيد

119
00:09:48,770 --> 00:09:49,690
!إنّه لذيذ

120
00:09:50,120 --> 00:09:54,220
،لكن يسرُّني أنّ كويوري-كن بأمان

121
00:09:54,220 --> 00:09:57,200
وأنّنا لم ينتهِ المطاف بنا كأعداء

122
00:09:57,450 --> 00:09:59,870
كانَتْ معركة مُنصِفة

123
00:09:59,870 --> 00:10:03,160
لن أكذب وأقول أنّني لستُ منزعجة
لكنّني لن أكرهكما بسبب ذلك

124
00:10:03,160 --> 00:10:05,130
أليس كذلك يا هاياتي؟

125
00:10:05,130 --> 00:10:06,200
أجل

126
00:10:07,040 --> 00:10:08,330
...تشيزورو-سان

127
00:10:08,330 --> 00:10:09,210
...هاياتي-سان

128
00:10:09,640 --> 00:10:11,130
،المهمّ

129
00:10:11,130 --> 00:10:14,540
قاتلتَ وحميتَ كويوري-تشان التي لا تملك نمروداً

130
00:10:14,540 --> 00:10:16,160
وهزمتنا

131
00:10:16,160 --> 00:10:20,630
كويوري-تشان، هذا الصّغير شخص رائع

132
00:10:23,530 --> 00:10:26,500
لا تدع فتى أصغر منك يهزمك يا موظَّفي

133
00:10:29,800 --> 00:10:32,830
أنا حقّاً آسف لأنّه هزمَني

134
00:10:32,830 --> 00:10:36,090
بالمناسبة، ما اسمكما؟

135
00:10:37,220 --> 00:10:38,550
اسمنا؟

136
00:10:39,640 --> 00:10:40,360
أجل

137
00:10:40,820 --> 00:10:45,840
أتذكران كيف عرّفنا عن أنفسنا بـ "ظلّ الخنجر
"وظلّ النصل؟

138
00:10:45,840 --> 00:10:48,230
لديكما اسم كهذا، صحيح؟

139
00:10:56,160 --> 00:10:59,450
تذكّرت، هذا

140
00:10:59,450 --> 00:11:02,670
...لطالما نويتُ أن أتحدّث عن ذلك

141
00:11:02,670 --> 00:11:03,820
...في الحقيقة

142
00:11:03,820 --> 00:11:05,500
يحدث ذلك أحياناً، صحيح؟

143
00:11:05,500 --> 00:11:06,640
!مهلاً

144
00:11:07,250 --> 00:11:09,850
أنتَ بمثابة وصيّ عليهما

145
00:11:09,850 --> 00:11:13,640
أنت من أخبرتهما عن المُتصافحين، صحيح؟

146
00:11:13,640 --> 00:11:15,100
!تبّاً

147
00:11:16,160 --> 00:11:18,160
تذكّرت

148
00:11:18,160 --> 00:11:21,070
...لكن كما تعلمين، عندما يتخطّى المرء الثلاثين

149
00:11:21,070 --> 00:11:23,530
لا تستخدم سنّك كعذر

150
00:11:23,530 --> 00:11:26,810
هذه وقاحةٌ بحقِّ أشخاص بنفس السنّ
ويعملون بجدّ

151
00:11:25,230 --> 00:11:27,540
...حـ-حسناً

152
00:11:26,810 --> 00:11:32,040
وعندما تستخدم الفتيات عمرهن كعذر
فإنّهن يكبرن بسُرعة فائقة

153
00:11:29,130 --> 00:11:31,500
نسيتُ أن أقول ذلك فحسب

154
00:11:32,040 --> 00:11:37,610
لا بأس! فأنتِ لا تبدين كبيرة على الإطلاق

155
00:11:37,610 --> 00:11:39,050
تبدين كتلميذة في مدرسة إعداديّة

156
00:11:39,360 --> 00:11:41,320
هل أنا تلميذة في مدرسةٍ إعداديّة؟

157
00:11:41,320 --> 00:11:42,040
!تبّاً

158
00:11:42,040 --> 00:11:43,050
!تعلّم درسك

159
00:11:43,410 --> 00:11:46,430
!ماكيهارا-سان، تعلّم درسك حالاً

160
00:11:46,430 --> 00:11:48,910
افهم سبب غضبي منك

161
00:11:48,910 --> 00:11:50,720
،وتعلّم درسك

162
00:11:50,720 --> 00:11:53,260
!وإلّا فلن تتطوّر

163
00:11:53,260 --> 00:11:54,330
...حاضر

164
00:11:55,530 --> 00:11:58,510
!وأنت سأوبّخك في وقتٍ لاحق حقّاً يا هاياتي

165
00:11:58,510 --> 00:12:01,830
سأدعك وشأنك إذا كانت حفلة الشرب التّالية على حسابك

166
00:12:02,480 --> 00:12:05,320
هذا تهديدٌ خطيرٌ مفاجئ

167
00:12:05,600 --> 00:12:08,860
إلى متى ستستمرُّ في الإمساك بي؟

168
00:12:08,860 --> 00:12:10,060
!تبّاً

169
00:12:10,060 --> 00:12:13,830
آسف، أنتِ خفيفةٌ جدّاً

170
00:12:13,830 --> 00:12:16,570
جسدي ليس كجسدِ تلميذة مدرسة ابتدائيّة

171
00:12:16,570 --> 00:12:18,520
!إنّه أقرب إلى جسد تلميذة مدرسة إعداديّة

172
00:12:18,520 --> 00:12:20,170
لم أقل ذلك، لكن آسف

173
00:12:20,170 --> 00:12:21,340
اصمت

174
00:12:23,940 --> 00:12:27,130
يبدو أنّكما لم تسمعا أنّ إمساك

175
00:12:27,130 --> 00:12:30,350
اليدين مُرتبط مباشرةً بالقتال

176
00:12:30,760 --> 00:12:33,940
تقصدين أنّ هذا سيُوضِّح أنّنا مُتصافِحان؟

177
00:12:34,610 --> 00:12:36,350
هذا جزءٌ من الأمر

178
00:12:36,620 --> 00:12:39,740
،أولاً، عندما تتشابكُ يدا مُتصافحَين

179
00:12:39,740 --> 00:12:42,360
يتبادلان الذكريات والأحاسيس، صحيح؟

180
00:12:44,920 --> 00:12:46,640
،عندما تُمسِك بيدها

181
00:12:46,640 --> 00:12:51,870
فإنّك تستطيع معرفة ما تفكّر أو تحسّ به، صحيح؟

182
00:12:53,200 --> 00:12:56,620
لا، ليس في حالة كويوري-كن

183
00:12:56,620 --> 00:12:57,880
هكذا إذاً

184
00:12:58,850 --> 00:13:01,240
...كانت نائمة طوال الوقت

185
00:13:01,240 --> 00:13:04,060
لهذا لم أشعر بشيء

186
00:13:12,520 --> 00:13:14,100
هكذا إذاً

187
00:13:14,450 --> 00:13:18,280
إن كان هناك ما تريد إخفاؤه فإنّك تستطيع
إخفاؤه بالتركيزِ عليه

188
00:13:18,280 --> 00:13:20,640
وطبعاً لأنّ هذا لا ينطبق إلّا على الأشياء
الموجودة في ذهنِك سطحيّاً

189
00:13:20,640 --> 00:13:22,620
.لا يكون التزامن مثاليّاً

190
00:13:23,620 --> 00:13:25,110
هل تخفين شيئاً؟

191
00:13:25,780 --> 00:13:27,740
سأعود إلى صلبِ الموضوع

192
00:13:27,740 --> 00:13:30,540
كنتُ أفكّر بشيء أكثر جوهريّة

193
00:13:30,540 --> 00:13:32,330
!سينباي

194
00:13:32,760 --> 00:13:36,120
أتعرف ما هي طريقة دخول زيغورات؟

195
00:13:36,400 --> 00:13:38,240
...لا

196
00:13:38,240 --> 00:13:41,130
كنّا ندخل إليه حتّى الآن بشكلٍ عفويّ

197
00:13:41,940 --> 00:13:46,580
إحدى الطرق هي عندَ قيام مجموعتَين من المُتصافحين
بمُشابكة أيديهم والتواجد ضمن مسافة معيّنة

198
00:13:47,890 --> 00:13:49,640
حينئذ يتمُّ الأمر تلقائيّاً

199
00:13:57,750 --> 00:14:00,920
تشير البيانات إلى أنَّ المدى هو حوالي 1 كم

200
00:14:01,480 --> 00:14:05,480
وهنالك حالات دخلَتْ فيها أكثر من مجموعتين
إلى زيغورات في آن واحد

201
00:14:06,460 --> 00:14:10,000
الطريقة الأخرى هي عندما يركّز زوجان من المُتصافحَين

202
00:14:10,000 --> 00:14:13,160
على هدفٍ ويتحدّيانه للقتال

203
00:14:13,720 --> 00:14:17,690
بعبارة أخرى، حالما يعلم شخصٌ أنّك متصافح

204
00:14:17,690 --> 00:14:21,170
يمكنه تحدّيكما حتّى لو لم تكونا تتصافحان

205
00:14:22,690 --> 00:14:26,260
هذا أمرٌ آخر يمكنكم فعله إذا كان الهدف
ضمن مسافة 1 كم

206
00:14:26,870 --> 00:14:29,450
هنالك بيانات أيضاً تشير إلى أنّك إذا ابتعدت
أكثر من 1 كم

207
00:14:29,450 --> 00:14:33,180
عن العدوّ فإنّك ستُطرَد من زيغورات

208
00:14:33,750 --> 00:14:36,300
...إ-إذاً

209
00:14:37,120 --> 00:14:43,530
هل أحمل لافتة كُتِبَ عليها "أنا مُتصافح" بينما أمشي؟

210
00:14:47,840 --> 00:14:51,700
حسناً، يمكنكما أن تفترضا أنّكما زوجان محبّان
فحسب أيضاً

211
00:14:55,080 --> 00:14:56,160
آسف

212
00:14:56,160 --> 00:14:58,120
نسيتُ ذلك الأمر

213
00:14:58,680 --> 00:15:02,110
لكن توقّعتُ أن تعرفوا بطريقةٍ ما

214
00:15:02,110 --> 00:15:04,630
لستَ داعماً موثوقاً جدّاً

215
00:15:05,040 --> 00:15:10,120
عادة، تحاول ألّا تبرز كثيراً كي لا تتلقّى
تحدِّيات للمعارك

216
00:15:10,120 --> 00:15:12,350
وتخفي اسمك عندما تُقاتل

217
00:15:12,350 --> 00:15:14,970
وإلّا سيتوجّب عليك جلب المعركة

218
00:15:14,970 --> 00:15:17,640
إلى العالم الحقيقيّ وحياتك اليوميّة، صحيح؟

219
00:15:18,100 --> 00:15:19,640
!تبّاً

220
00:15:20,020 --> 00:15:23,280
حسناً، أنا وهاياتي سنكون وصيّين عليكما

221
00:15:23,280 --> 00:15:25,650
!بما أنّكما تستطيعان الاعتماد علينا فعلاً

222
00:15:26,640 --> 00:15:28,460
يمكن الاعتماد عليّ؟

223
00:15:28,460 --> 00:15:31,660
سأكون وصيّة يمكنكما الاعتماد عليها

224
00:15:32,000 --> 00:15:33,660
...سينباي

225
00:15:34,870 --> 00:15:38,090
...وصيّة؟ لكن

226
00:15:38,090 --> 00:15:40,700
ألم تفكّر لماذا هزمتَنا؟

227
00:15:41,110 --> 00:15:45,080
هذا لأنّنا أضعف منك

228
00:15:45,080 --> 00:15:48,170
لم نكن قويّين بما يكفي

229
00:15:48,520 --> 00:15:52,410
لا داعي لتنهمك في التفكير بالأمر أنت أو كويوري-تشان

230
00:15:53,590 --> 00:15:58,650
لقد هزمتُمانا، لذا لا أريدكما أن تخسرا

231
00:15:58,650 --> 00:16:00,550
!بسببِ هذه الوصيّة المهملة

232
00:16:01,840 --> 00:16:06,940
لكن لم نخض سوى معركتين فقط

233
00:16:07,210 --> 00:16:10,380
...تشيزورو-سان، هاياتي-سان

234
00:16:11,440 --> 00:16:13,110
شكراً لكما

235
00:16:18,340 --> 00:16:21,260
أليس هذا رائعاً يا تازونا-كن وكويوري-كن؟

236
00:16:21,260 --> 00:16:22,960
أشعر بالرّاحة أيضاً

237
00:16:31,120 --> 00:16:32,600
هل أنتِ ملاك؟

238
00:16:35,470 --> 00:16:40,970
حسناً، سأسدي إليكما نصيحتنا الأولى

239
00:16:41,750 --> 00:16:42,570
!حسناً

240
00:16:42,570 --> 00:16:44,080
مُسنَّن فرديّ

241
00:16:44,080 --> 00:16:44,940
ما رأيك به؟

242
00:16:46,900 --> 00:16:48,440
...تبّاً

243
00:16:48,440 --> 00:16:49,800
!اسمك

244
00:16:49,800 --> 00:16:51,880
اسمك كمُتصافح

245
00:16:52,450 --> 00:16:55,470
أخبرتُك للتو أنّ استخدام اسمك الحقيقيّ
خطير، أليس كذلك؟

246
00:16:55,470 --> 00:16:57,260
لهذا فكّرتُ باسم

247
00:16:57,260 --> 00:16:59,490
،عادة تُقاتلان كثنائي

248
00:16:59,490 --> 00:17:03,500
لكنّك قاتلتَ لحماية كويوري-تشان بمفردك

249
00:17:03,770 --> 00:17:05,960
النمرود الخاصّ بك هو مسنّن

250
00:17:05,960 --> 00:17:08,000
لهذا هو مسنّن فرديّ

251
00:17:09,000 --> 00:17:11,370
!هذا صحيح، لكن لا تشرحه

252
00:17:11,370 --> 00:17:14,320
!أنا محرجةٌ للغاية لدرجة أنّني سأنفجر

253
00:17:15,010 --> 00:17:17,590
!لم يكن ذلك مديحاً

254
00:17:17,590 --> 00:17:19,350
...مسنّن فرديّ

255
00:17:22,020 --> 00:17:23,670
شكراً لكما

256
00:17:27,800 --> 00:17:28,810
لا عليك

257
00:17:28,810 --> 00:17:30,480
يمكنكما الاعتماد علينا

258
00:17:30,480 --> 00:17:31,270
!حسناً

259
00:17:58,130 --> 00:18:01,330
كانا قويّين إذاً؟

260
00:18:01,330 --> 00:18:02,790
أجل

261
00:18:03,280 --> 00:18:05,770
كان تازونا-كن قويّاً للغاية

262
00:18:11,480 --> 00:18:14,900
قلتُ لهما أنّني لم أشعر باستياء
من خسارتنا، صحيح؟

263
00:18:15,880 --> 00:18:17,500
كنتُ أكذب

264
00:18:18,920 --> 00:18:20,570
توقّعتُ هذا

265
00:18:21,520 --> 00:18:23,880
!أنا شديدة الإحباط

266
00:18:23,880 --> 00:18:25,740
...كنتُ متأكّدة أنّنا

267
00:18:25,740 --> 00:18:29,760
!أنّك وأنا نستطيع هزيمة أي شخص

268
00:18:29,760 --> 00:18:31,850
!أنّنا نستطيع فعل أي شيء

269
00:18:31,850 --> 00:18:34,120
ليتهما ينفجران

270
00:18:41,760 --> 00:18:42,890
...تشيزورو-سان

271
00:18:44,180 --> 00:18:45,530
شكراً لك

272
00:18:51,020 --> 00:18:53,380
آسفة لأنّني مديرة عديمة القيمة

273
00:18:57,010 --> 00:19:04,620
بكلّ صراحة وشفافيّة، لقد ساعدتَني ووقفتَ
إلى جانبي كثيراً

274
00:19:05,170 --> 00:19:08,810
أنتَ رجلٌ حقيقيّ

275
00:19:12,760 --> 00:19:17,460
...أنا... أنا منزعج جدّاً أيضاً

276
00:19:14,720 --> 00:19:18,380
!هـ-هاياتي! انتبه للطريق

277
00:19:17,930 --> 00:19:22,470
أنا آسف، لا أستطيع الرّؤية أمامي بسبب
العرق في قلبي

278
00:19:23,160 --> 00:19:25,970
!يا للهول! أيّها الغبيّ

279
00:19:25,970 --> 00:19:28,200
!سنموت! سنموت

280
00:19:28,200 --> 00:19:29,870
!سنموت

281
00:19:29,870 --> 00:19:33,260
!غبيّ! هاياتي الغبيّ

282
00:19:34,240 --> 00:19:36,000
ظننتُ أنّنا سنموت

283
00:19:36,000 --> 00:19:38,230
أنا آسفٌ حقّاً

284
00:19:42,370 --> 00:19:43,820
لا بأس ما دمت تفهم

285
00:19:45,570 --> 00:19:46,840
لكن أتعلم؟

286
00:19:46,840 --> 00:19:50,280
...خسرنا وكان ذلك محبطاً

287
00:19:50,280 --> 00:19:54,010
ذلكما الصغيران يخاطران بحياتهما
ويعملان بجدّ حقّاً

288
00:19:54,010 --> 00:19:57,250
أعتقدُ أنّنا وبصفتِنا أقدم منهما
علينا أن نضاعف جهودنا

289
00:19:58,080 --> 00:20:00,760
نستطيع أنا وأنت فعل أي شيء معاً

290
00:20:00,760 --> 00:20:04,330
حتّى ولو انتهت معركتنا، ما زلتُ أؤمن
بإمكانيّة تحقيق ذلك

291
00:20:04,840 --> 00:20:06,240
هذا صحيح

292
00:20:06,240 --> 00:20:07,450
!سأفعل ما بوسعي أيضاً

293
00:20:07,450 --> 00:20:09,100
!يمكننا فعل أي شيء

294
00:20:09,100 --> 00:20:10,770
حسناً، لنذهب ونشرب

295
00:20:11,360 --> 00:20:12,720
على حسابك

296
00:20:12,720 --> 00:20:14,350
،لدينا عملٌ غداً

297
00:20:14,350 --> 00:20:15,770
لكن يمكننا فعل أي شيء

298
00:20:16,220 --> 00:20:18,760
!سأذهب معكِ يا سينباي

299
00:20:18,760 --> 00:20:21,360
!سأستخدم اليوم بطاقتي الائتمانيّة

300
00:20:21,360 --> 00:20:24,280
!تساهلي معي

301
00:20:24,630 --> 00:20:29,180
بالمناسبة، ألم تكوني تقولين شيئاً في السيّارة يا سينباي؟

302
00:20:29,180 --> 00:20:31,580
أعني حول مُساعدتي لكِ؟

303
00:20:31,580 --> 00:20:33,230
أتتحدّث عن ذلك الآن؟

304
00:20:33,230 --> 00:20:35,450
...أنت حقّاً

305
00:20:35,450 --> 00:20:37,290
سينباي، هذا مؤلم

306
00:20:37,880 --> 00:20:39,800
لنذهب فحسب

307
00:20:39,800 --> 00:20:41,160
هنا؟

308
00:20:41,160 --> 00:20:42,110
هنا، صحيح؟

309
00:20:42,110 --> 00:20:43,710
سأتناول أطيب ما لديهم اللّيلة

310
00:20:43,710 --> 00:20:45,460
!أسعاره باهظة

311
00:23:10,930 --> 00:23:13,740
تزورهما فترةٌ قصيرةٌ من السلام

312
00:23:13,740 --> 00:23:15,900
...ما يريانه، ما يسمعانه، ما يلمسانه

313
00:23:15,900 --> 00:23:17,870
الدفء الذي يشعرانه من القلب

314
00:23:18,420 --> 00:23:21,580
شكّ ونفاد صبر ووحدة

315
00:23:21,900 --> 00:23:24,340
والشعور بنبضةِ قلب متجمِّدة

316
00:23:24,640 --> 00:23:26,250
الورقة الرّابحة هي الشقيقان

317
00:23:26,250 --> 00:23:27,510
إنّه الجوكر

318
00:23:33,680 --> 00:23:36,390
الرجل الذي يعترضُ طريق مسيرهما

319
00:23:36,390 --> 00:23:38,430
يغرسُ وتداً في قلب الصّغير