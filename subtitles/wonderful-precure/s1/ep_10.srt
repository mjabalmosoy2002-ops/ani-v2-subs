1
00:00:13,720 --> 00:00:15,090
!ظريفة جدًا

2
00:00:15,260 --> 00:00:18,430
!كل هذه المنتجات التجميلية تتسم بتصميم رائع

3
00:00:18,600 --> 00:00:20,020
!يا له من حس تصميمي جيد

4
00:00:20,180 --> 00:00:21,350
!حقًا

5
00:00:21,680 --> 00:00:24,810
!أحمر شفاه القطة هذا ظريف -
!أجل -

6
00:00:27,900 --> 00:00:31,070
.جيد! نستقبل المزيد من الزبائن

7
00:00:31,530 --> 00:00:34,910
.ربما حان الوقت لصنع شيء جديد

8
00:00:35,070 --> 00:00:37,410
شيء جديد؟ مثل ماذا؟

9
00:00:37,570 --> 00:00:39,120
...لنرَ

10
00:00:39,280 --> 00:00:43,660
.شيء يبث الحماسة في قلوب الزبائن، حتى إن أتوا كل يوم

11
00:00:44,000 --> 00:00:46,960
!إن كنت تملكين أي أفكار جيدة، أعلميني

12
00:00:47,210 --> 00:00:50,380
ماذا؟ يمكنني أن أبتكر شيئًا؟

13
00:00:50,710 --> 00:00:52,300
!لا أطيق الانتظار

14
00:00:54,510 --> 00:00:56,300
...شيء من تصميمي

15
00:01:05,390 --> 00:01:07,900
ما العمل يا يوكي؟

16
00:01:10,900 --> 00:01:15,070
!قالت أنني أستطيع تصميم منتج جديد من أجل المتجر

17
00:01:23,080 --> 00:01:26,960
ماذا أفعل؟

18
00:03:06,770 --> 00:03:09,640
،عند ضرب وقسمة المفردات الجبرية

19
00:03:09,810 --> 00:03:12,810
.يتم ضرب الأرقام معًا ، ثم الحروف

20
00:03:19,400 --> 00:03:21,150
...والآن، بالنسبة لهذه المسألة

21
00:03:21,320 --> 00:03:22,490
.نيكوياشيكي-سان

22
00:03:24,740 --> 00:03:27,080
!مايو

23
00:03:35,170 --> 00:03:36,960
...عذرًا

24
00:03:38,260 --> 00:03:39,550
ماذا ترسمين؟

25
00:03:39,720 --> 00:03:40,420
ماذا؟

26
00:03:40,590 --> 00:03:43,680
...هذا فقط

27
00:03:43,840 --> 00:03:45,800
!لـ-لا شيء

28
00:03:46,810 --> 00:03:47,970
!يبدو ممتعًا

29
00:03:48,270 --> 00:03:49,810
!سأفعل أيضًا

30
00:03:49,980 --> 00:03:51,770
!لا، توقفي! لا

31
00:03:52,140 --> 00:03:54,940
!نيكوياشيكي-سان! إينوكاي كوموغي-سان

32
00:04:00,400 --> 00:04:03,660
.آسفة يا مايو-تشان. تحمست كوموغي

33
00:04:03,990 --> 00:04:04,870
.آسفة

34
00:04:05,030 --> 00:04:06,240
...لا

35
00:04:06,990 --> 00:04:08,450
.إنه خطئي

36
00:04:08,620 --> 00:04:10,700
لكن ماذا كنت ترسمين؟

37
00:04:14,420 --> 00:04:15,380
.هذا

38
00:04:20,050 --> 00:04:22,880
!عجبًا، إنها ظريفة جدًا

39
00:04:23,050 --> 00:04:24,550
!الكثير منها

40
00:04:24,970 --> 00:04:29,850
.شيء صممته قد يصبح منتجًا في متجرنا

41
00:04:30,350 --> 00:04:32,890
.لذا توالت الأفكار

42
00:04:33,270 --> 00:04:36,060
!مذهل! كلها ظريفة جدًا

43
00:04:37,310 --> 00:04:39,400
ماذا يجري؟ -
!دعيني أرى -

44
00:04:39,570 --> 00:04:41,820
!مذهل، إنها جد ظريفة

45
00:04:41,990 --> 00:04:44,490
!أحببت هذه -
!أحببت هذه -

46
00:04:44,780 --> 00:04:48,370
!كل هذا من تصميمك؟ مذهل

47
00:04:50,080 --> 00:04:51,290
حقًا؟

48
00:04:53,660 --> 00:04:55,960
.كلها جميلة جدًا. لا أستطيع أن أقرر

49
00:04:58,130 --> 00:05:00,170
أيها تفضلين؟

50
00:05:02,090 --> 00:05:03,340
أفضّل؟

51
00:05:04,260 --> 00:05:07,970
أود صنعها كلها، لكن لا أستطيع، أليس كذلك؟

52
00:05:08,430 --> 00:05:12,930
.أريد صنع الذي يعني لك أكثر

53
00:05:13,930 --> 00:05:15,640
يعني لي أكثر؟

54
00:05:16,690 --> 00:05:22,190
.الذي سيرسم الابتسامة على شفاه من يستخدمه

55
00:05:22,730 --> 00:05:26,240
.أريد ملأ المتجر بأشياء مثله

56
00:05:30,990 --> 00:05:33,500
.هذا يجعل القرار صعب

57
00:05:34,330 --> 00:05:37,620
.قالت إيروها-تشان أنها ظريفة كلها

58
00:05:38,080 --> 00:05:41,710
...أوكوما-سان اختارت هذا وكاني-سان اختارت هذا

59
00:05:41,880 --> 00:05:44,010
.أوشيغومي-سان أعجبها هذا

60
00:05:47,010 --> 00:05:49,640
!لا أدري ماذا أفعل

61
00:05:50,100 --> 00:05:53,600
!الأمر يختلف عن القيام به كهواية. هذا صعب

62
00:05:55,060 --> 00:05:56,180
!يوكي

63
00:05:56,600 --> 00:05:58,810
أيها تحبين؟

64
00:06:02,020 --> 00:06:03,480
...صحيح

65
00:06:03,860 --> 00:06:06,530
.لكنك ظريفة حتى عندما تتجاهلينني

66
00:06:12,080 --> 00:06:14,450
.سأبدأ من الصفر

67
00:06:32,600 --> 00:06:35,850
.رأيت شيئًا يشبه بيضة سوداء في النهر البارحة

68
00:06:36,020 --> 00:06:36,930
ما ذلك؟

69
00:06:39,060 --> 00:06:41,520
.حاولت أخذها لكن أبي لم يأذن لي

70
00:06:41,690 --> 00:06:42,770
.أنتما

71
00:06:47,820 --> 00:06:52,200
.يقال أن التمشي يفيد عندما تكون حائرًا في ابتكار شيء

72
00:06:54,870 --> 00:06:57,250
!قد تكون بيضة غاروغارو

73
00:06:57,410 --> 00:07:01,460
!آمل أن نستطيع إيجادها وإنقاذها قبل أن تفقس

74
00:07:01,630 --> 00:07:03,130
!سأبذل جهدي

75
00:07:05,840 --> 00:07:06,840
!وجدتها

76
00:07:07,010 --> 00:07:08,630
!كوموغي

77
00:07:13,390 --> 00:07:15,310
!كنت مخطئة. إنها كرة

78
00:07:17,020 --> 00:07:18,930
إينوكاي-سان، هل أنت بخير؟

79
00:07:20,060 --> 00:07:23,560
.كوموغي، لا يمكنك أن تركضي هكذا

80
00:07:23,730 --> 00:07:24,650
!وان

81
00:07:26,900 --> 00:07:28,990
هل تفهمين حقًا؟ -
أتلك...؟ -

82
00:07:29,150 --> 00:07:30,450
!فهمت

83
00:07:32,160 --> 00:07:33,030
دايفوكو؟

84
00:07:34,660 --> 00:07:36,330
!نيكوياشيكي-سان

85
00:07:36,490 --> 00:07:37,740
مايو-تشان؟

86
00:07:42,290 --> 00:07:45,290
.وجدت كوموغي كرةً وركضت نحوها

87
00:07:45,460 --> 00:07:47,960
!فهمت، إنها مفعمة بالطاقة

88
00:07:49,050 --> 00:07:51,420
!اثبتي يا كوموغي

89
00:07:52,050 --> 00:07:53,640
!هذا يعيد الذكريات

90
00:07:55,050 --> 00:07:57,560
!آسف لأنني لم أستطع منع نفسي

91
00:07:57,720 --> 00:07:59,430
منع نفسك؟ مماذا؟

92
00:07:59,970 --> 00:08:04,440
.ذكرني هذا بأول لقاء مع يوكي

93
00:08:04,940 --> 00:08:07,520
ماذا؟ هل كانت يوكي مغطاة بالوحل؟

94
00:08:07,690 --> 00:08:10,610
!أخبريني! أخبريني -
!أخبريني! أخبريني -

95
00:08:10,780 --> 00:08:13,860
.كانت عطلة الشتاء، في الصف الرابع

96
00:08:15,030 --> 00:08:19,160
.ذهبت مع بابا إلى عمله في قرية الجبل

97
00:08:19,620 --> 00:08:22,580
أي عمل يقوم به والدك؟

98
00:08:22,750 --> 00:08:23,750
.التصوير الفوتوغرافي

99
00:08:24,250 --> 00:08:27,840
.يلتقط صورًا لأشياء مثل الحيوانات والمناظر الخلابة

100
00:08:28,210 --> 00:08:30,300
.حقًا؟ هذا مبهر

101
00:08:30,960 --> 00:08:35,550
.كان يلتقط صورة لبيت قديم مهجور

102
00:08:38,350 --> 00:08:40,640
.ووجدتُ يوكي، مكسية بالتراب

103
00:08:45,850 --> 00:08:47,110
!يا لجمالها

104
00:08:56,200 --> 00:08:57,280
!يا قطة

105
00:08:57,450 --> 00:08:58,580
.انتظري يا مايو

106
00:09:00,330 --> 00:09:01,410
.بابا

107
00:09:01,580 --> 00:09:03,960
.تلك قطة متشردة دون طوق

108
00:09:04,580 --> 00:09:06,370
.لا يجب أن تلمسيها

109
00:09:07,000 --> 00:09:07,830
.حسنًا

110
00:09:08,420 --> 00:09:09,420
.هيا بنا

111
00:09:13,260 --> 00:09:15,220
!تلك القطة

112
00:09:15,380 --> 00:09:18,390
.لاحظنا أنها كانت تعيش هناك لفترة

113
00:09:19,050 --> 00:09:20,890
.لا بد أنها تشعر بالبرد

114
00:09:21,220 --> 00:09:22,680
هل لديها أمًا؟

115
00:09:22,850 --> 00:09:23,980
أو إخوة؟

116
00:09:24,140 --> 00:09:26,850
.من يدري؟ لم أر سواها

117
00:09:27,020 --> 00:09:30,440
.ربما تخلى عنها أحدهم

118
00:09:30,610 --> 00:09:34,150
.تلك القطة لا تحب الناس حقًا

119
00:09:35,110 --> 00:09:36,280
...هكذا إذًا

120
00:09:45,330 --> 00:09:46,870
هل رحلت؟

121
00:09:51,800 --> 00:09:53,800
هل موأت للتو؟

122
00:09:56,220 --> 00:09:59,760
!لديك صوت جميل حقًا

123
00:10:01,970 --> 00:10:04,810
!لا بأس! لن ألمسك

124
00:10:13,610 --> 00:10:14,780
...لا فائدة

125
00:10:17,820 --> 00:10:20,240
.مع ذلك، كنت قلقة عليها

126
00:10:20,740 --> 00:10:22,950
.ذهبت لرؤيتها كل يوم

127
00:10:32,920 --> 00:10:36,840
!انظري! لم أر مثل هذا الثلج الكبير

128
00:10:37,010 --> 00:10:39,130
!إنه جميل جدًا، كالشريط

129
00:10:39,880 --> 00:10:42,510
!أظن أنك ترين الثلج أكثر مني

130
00:10:51,520 --> 00:10:52,860
هل ترينه؟

131
00:11:10,790 --> 00:11:13,040
!سأعطيك هذه

132
00:11:13,920 --> 00:11:15,040
ألا تشعرين بالبرد؟

133
00:11:16,840 --> 00:11:18,970
.ماما حبكتها لي

134
00:11:19,130 --> 00:11:21,090
.إنها دافئة جدًا

135
00:11:21,720 --> 00:11:24,760
.وشكلها ظريف جدًا

136
00:11:25,180 --> 00:11:28,520
.أترين؟ كحقل من أزهار الربيع

137
00:11:29,980 --> 00:11:31,810
.الجو بارد في الخارج

138
00:11:31,980 --> 00:11:34,310
.لكن عساها تدفئ قلبك

139
00:11:43,490 --> 00:11:46,120
.لا أستطيع التصوير اليوم

140
00:11:46,280 --> 00:11:48,540
.لا تخرجي أيضًا

141
00:12:11,060 --> 00:12:13,230
أيتها القطة! هل أنت هناك؟

142
00:12:15,770 --> 00:12:18,150
جيد! كيف حالك؟

143
00:12:20,490 --> 00:12:22,820
.أتيت لتوديعك اليوم

144
00:12:25,240 --> 00:12:28,330
.سأعود إلى البيت غدًا مع بابا

145
00:12:30,450 --> 00:12:33,040
.أردت أن أتحدث إليك أكثر

146
00:12:34,290 --> 00:12:38,420
.عن عائلتي والبلدة التي أعيش فيها

147
00:12:44,760 --> 00:12:47,510
.وداعًا. ابقي آمنة

148
00:13:04,860 --> 00:13:06,740
.شكرًا على استضافتنا

149
00:13:06,910 --> 00:13:08,320
.كررا الزيارة رجاءً

150
00:13:08,490 --> 00:13:11,740
.قصصك عن الحيوانات من حول العالم كانت رائعة

151
00:13:11,910 --> 00:13:13,370
.شكرًا جزيلًا

152
00:13:13,540 --> 00:13:14,660
.سأكرر الزيارة

153
00:13:16,790 --> 00:13:18,460
.حسنًا يا مايو، هيا بنا

154
00:13:18,920 --> 00:13:19,750
.حسنًا

155
00:13:26,720 --> 00:13:27,720
!قطة

156
00:13:27,890 --> 00:13:29,010
!يا إلهي

157
00:13:29,470 --> 00:13:31,310
هل أتيت لتوديعي؟

158
00:13:34,020 --> 00:13:36,440
أتيت لتنادي علي؟

159
00:13:38,060 --> 00:13:41,270
!مذهل -
!تلك القطة تكره البشر -

160
00:13:42,940 --> 00:13:44,110
.أنا آسفة

161
00:13:44,280 --> 00:13:46,490
.أنا سعيدة، لكن لا أستطيع

162
00:13:51,700 --> 00:13:55,410
!أريد أن أكون معك أيضًا

163
00:13:55,580 --> 00:13:56,460
.مايو

164
00:13:57,120 --> 00:14:00,210
.حتى إن كنت لا أستطيع لمسك، حتى إن تجاهلتني

165
00:14:00,380 --> 00:14:03,000
.كان الوقت الذي قضيت معك ممتعًا

166
00:14:03,420 --> 00:14:04,920
.كنتُ سعيدة

167
00:14:05,720 --> 00:14:08,470
...يا ليتنا كنا دائمًا

168
00:14:09,930 --> 00:14:13,010
.يا ليتنا كنا معًا

169
00:14:18,100 --> 00:14:19,520
!قطة

170
00:14:25,190 --> 00:14:27,900
.اسمعي يا مايو. سأكرر هذا

171
00:14:28,070 --> 00:14:30,950
.الاعتناء بكائن حي ليس بالأمر السهل

172
00:14:31,450 --> 00:14:34,410
.عليك الاعتناء بها دائمًا

173
00:14:34,580 --> 00:14:36,540
!نعم! سأفعل ذلك بالتأكيد

174
00:14:44,750 --> 00:14:48,930
!عجبًا يا قطة. أنت بيضاء بياض الثلج

175
00:14:50,550 --> 00:14:53,350
!صحيح! سيكون اسمك يوكي

176
00:14:53,510 --> 00:14:56,430
.التقيت بك في يوم مثلج، وتملكين لون الثلج

177
00:14:56,600 --> 00:14:57,310
اتفقنا؟

178
00:15:01,940 --> 00:15:03,150
!مفاجأة

179
00:15:08,530 --> 00:15:11,070
.صنعت تلك التميمة

180
00:15:11,240 --> 00:15:13,450
إذًا يا يوكي؟ هل أحببتها؟

181
00:15:19,160 --> 00:15:22,880
!بدت يوكي جد سعيدة حينها

182
00:15:23,500 --> 00:15:26,590
.مذهل، يا ليتني رأيتُ ذلك

183
00:15:26,750 --> 00:15:28,050
!ابتسامة يوكي

184
00:15:29,130 --> 00:15:30,130
!صحيح

185
00:15:30,880 --> 00:15:32,090
نيكوياشيكي-سان؟

186
00:15:32,260 --> 00:15:34,010
!إيروها-تشان، شكرًا لك

187
00:15:34,430 --> 00:15:35,680
ماذا؟ على ماذا؟

188
00:15:35,850 --> 00:15:37,270
تريد أن نتسابق؟

189
00:15:37,430 --> 00:15:38,640
.لا أظن ذلك

190
00:15:48,650 --> 00:15:50,860
.غاروغارو

191
00:15:54,320 --> 00:15:56,030
!عجبًا! إنها غاروغارو

192
00:16:00,790 --> 00:16:02,370
!انتظري يا يوكي

193
00:16:14,890 --> 00:16:16,600
!غاروغارو

194
00:16:21,270 --> 00:16:22,770
!إنه هناك

195
00:16:23,480 --> 00:16:24,900
تانوكي آخر؟

196
00:16:25,060 --> 00:16:27,480
.لا، أظن أنه راكون

197
00:16:27,650 --> 00:16:31,690
!لننقذه قبل أن يذهب إلى البلدة! كوموغي

198
00:16:44,710 --> 00:16:46,460
!ميثاق واندرفل

199
00:16:49,590 --> 00:16:52,220
!بريكيور! تطوري

200
00:16:58,640 --> 00:16:59,470
!ثلاثة

201
00:17:00,390 --> 00:17:01,220
!اثنان

202
00:17:02,480 --> 00:17:03,390
!وان

203
00:17:17,490 --> 00:17:20,120
!أحب الجميع في هذا العالم الجميل

204
00:17:20,280 --> 00:17:21,790
!كيور واندرفل

205
00:17:23,000 --> 00:17:24,620
!لنلعب معًا

206
00:17:27,080 --> 00:17:29,750
!ابتسامات الجميع تضيء هذا العالم

207
00:17:29,920 --> 00:17:31,210
!كيور فريندلي

208
00:17:32,340 --> 00:17:34,260
.دعيني أسمع صوتك

209
00:17:35,380 --> 00:17:36,720
!استعداد

210
00:17:38,340 --> 00:17:40,100
!واندرفل بريكيور

211
00:17:50,900 --> 00:17:52,020
!توقف

212
00:17:52,190 --> 00:17:53,070
!غارو

213
00:17:53,230 --> 00:17:56,070
!غاروغارو، غاروغارو، غارو

214
00:17:56,990 --> 00:17:59,070
!توقف! اجلس

215
00:17:59,240 --> 00:18:01,530
!غارو، غارو

216
00:18:01,700 --> 00:18:02,910
ما العمل؟

217
00:18:03,080 --> 00:18:05,000
كيف يمكننا إيقاف الغاروغارو؟

218
00:18:06,250 --> 00:18:07,500
!هذا

219
00:18:07,960 --> 00:18:09,460
!سأستعيره

220
00:18:09,630 --> 00:18:11,290
!غاروغارو

221
00:18:12,210 --> 00:18:13,420
!غارو

222
00:18:14,420 --> 00:18:15,420
غارو؟

223
00:18:16,300 --> 00:18:18,970
!إن أردت أن تغسل يدك فالنهر هناك

224
00:18:19,140 --> 00:18:19,930
غارو؟

225
00:18:20,090 --> 00:18:21,390
!غاروغارو

226
00:18:23,760 --> 00:18:25,640
!لا، انتظر

227
00:18:27,020 --> 00:18:30,270
.ظننت أن الراكون سيريد غسل يديه

228
00:18:30,440 --> 00:18:31,770
.لا يا فريندلي

229
00:18:31,940 --> 00:18:34,150
!الراكون لا يحب الغسل

230
00:18:34,320 --> 00:18:35,110
حقًا؟

231
00:18:35,610 --> 00:18:37,860
،تلك الصور الظريفة التي نملك عنها

232
00:18:38,650 --> 00:18:41,780
.هي في الواقع لها وهي تحاول صيد السمك في النهر

233
00:18:42,530 --> 00:18:43,870
حقًا؟

234
00:18:44,040 --> 00:18:47,580
!غاروغارو! غارو! غارو

235
00:18:48,830 --> 00:18:51,420
.الراكون عنيف على غير المتوقع

236
00:18:51,580 --> 00:18:53,210
.تملك أصابع رشيقة

237
00:18:53,590 --> 00:18:54,920
!معك حق

238
00:19:05,220 --> 00:19:06,390
!غارو

239
00:19:06,560 --> 00:19:08,060
!حاجز الشريط

240
00:19:10,230 --> 00:19:12,770
!غارو! غارو-غارو-غارو-غارو

241
00:19:12,940 --> 00:19:13,860
!ماذا؟

242
00:19:14,020 --> 00:19:15,610
يمكنها حتى فعل ذلك؟

243
00:19:15,940 --> 00:19:17,070
!مذهل

244
00:19:19,360 --> 00:19:21,610
!غارو؟ غارو! غارو

245
00:19:22,200 --> 00:19:23,660
!هذا ليس وقت المديح

246
00:19:23,820 --> 00:19:25,200
!لا تكسر الأشياء

247
00:19:25,370 --> 00:19:26,910
!انتظر -
ماذا؟ -

248
00:19:27,080 --> 00:19:29,330
!فريندلي! استخدمي حاجز شريط آخر

249
00:19:31,830 --> 00:19:34,090
!غارو... غارو

250
00:19:34,750 --> 00:19:36,590
!حاجز الشريط

251
00:19:38,710 --> 00:19:41,340
!غاروغارو، غارو

252
00:19:41,510 --> 00:19:42,340
!غارو

253
00:19:42,510 --> 00:19:44,350
!واندرفل، الآن -
!حسنًا -

254
00:19:51,730 --> 00:19:52,520
غارو؟

255
00:19:52,690 --> 00:19:54,900
!هيا، عد إلى حديقة نيكو

256
00:19:57,820 --> 00:19:59,530
!عصا فريندلي

257
00:20:02,280 --> 00:20:04,030
!واندرفل لك

258
00:20:15,210 --> 00:20:17,340
!وان! وان! وان

259
00:20:21,010 --> 00:20:23,680
!ارحل يا قلب غاروغارو

260
00:20:26,800 --> 00:20:30,140
!بريكيور! تنافر الصديقتين

261
00:20:41,190 --> 00:20:44,530
!نيكونيكو

262
00:20:44,910 --> 00:20:46,370
!مرحبًا بعودتك

263
00:20:53,910 --> 00:20:55,540
!هيا

264
00:21:09,350 --> 00:21:10,890
!اذهب إلى ديارك

265
00:21:23,990 --> 00:21:24,820
!نجحت

266
00:21:27,450 --> 00:21:29,370
انظر يا يوكي! هل أعجبك؟

267
00:21:35,920 --> 00:21:37,250
!مذهل

268
00:21:37,420 --> 00:21:38,750
!إنه ظريف

269
00:21:38,920 --> 00:21:40,250
!يشبه يوكي

270
00:21:40,420 --> 00:21:41,800
أهذ المنتج الجديد؟

271
00:21:41,960 --> 00:21:43,420
!سأشتري واحدًا الآن

272
00:21:43,590 --> 00:21:45,170
!تصميمه جميل

273
00:21:45,340 --> 00:21:48,390
!حسنًا، حان الوقت لأوفّر منحتي

274
00:21:49,970 --> 00:21:52,390
!يبدو الجميع مستمتعات به

275
00:21:52,970 --> 00:21:54,480
!شكرًا يا مايو

276
00:21:54,850 --> 00:21:56,980
.أجل. أنا جد مسرورة

277
00:21:57,650 --> 00:22:01,360
.لكني واثقة أن يوكي هي الأسعد

278
00:22:07,240 --> 00:22:11,530
!أردت رؤية ابتسامتك أكثر

279
00:23:47,000 --> 00:23:50,010
!إيروها! ظهر مخلوق ضخم في الجبل

280
00:23:50,170 --> 00:23:52,640
!قد يكون غاروغارو؟ علينا تفقده

281
00:23:52,800 --> 00:23:56,180
!الجبال تعني النزه! لا أطيق الانتظار

282
00:23:56,350 --> 00:23:58,930
لنخرج في نزهة... ماذا...؟

283
00:23:59,640 --> 00:24:00,980
!واندرفل بريكيور

284
00:24:01,140 --> 00:24:03,980
"!مخلوق عملاق يختبئ في الجبل؟"