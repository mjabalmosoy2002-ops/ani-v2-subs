1
00:00:00,000 --> 00:00:03,290
يُقال أنّ خلال كلّ
بضعة مئات الأعوام

2
00:00:03,420 --> 00:00:06,250
تُبعث الآلهة أثينا

3
00:00:06,380 --> 00:00:10,460
والآن وُلِدت أثينا جديدة
في هذا العالم

4
00:00:10,590 --> 00:00:15,800
لكن هذه المرّة، تحت ظلّ نبوءة
سوداء بقيادتها للبشريّة للهلاك

5
00:00:15,930 --> 00:00:20,220
عُرف المحاربون الذين دافعوا
عن الآلهة أثينا بالفرسان

6
00:00:20,350 --> 00:00:25,650
اليوم، يتحكّم جيلٍ جديد من الفرسان
مصير العالم

7
00:00:25,770 --> 00:00:29,230
يُدعون بفرسان الأبراج

8
00:02:00,030 --> 00:02:02,410
..."سابقاً في "سينت سيا

9
00:02:02,530 --> 00:02:03,790
!مُت

10
00:02:04,370 --> 00:02:08,620
!لن تفقد سينا الأمل في البشر
!وأنا أؤمن بها

11
00:02:10,540 --> 00:02:12,090
!ماذا؟

12
00:02:15,550 --> 00:02:16,510
!سينا

13
00:02:21,360 --> 00:02:25,370
المنازل الاثني عشر

14
00:02:32,730 --> 00:02:35,980
مضى وقتٌ طويل يا معلّم دوكو

15
00:02:36,780 --> 00:02:38,240
ديثماسك السرطان

16
00:02:38,900 --> 00:02:43,030
لا بدّ أنّ السيّد الكبير يشعر
بيأسٍ لإرساله مُغتالاً لي

17
00:02:43,660 --> 00:02:45,160
مقامك محطّ احترام

18
00:02:45,290 --> 00:02:50,370
فيؤسفني اضطراري لقتلك تقيّداً
بالأمر الذي تلقّيتُه

19
00:02:50,500 --> 00:02:54,750
،يا قدّيس السرطان الذهبيّ
ما الخطأ الذي ارتكبتُه؟

20
00:02:54,880 --> 00:02:57,170
أنت خائنٌ للملجأ

21
00:02:57,300 --> 00:03:00,130
يطلب السّد العظيم العدالة

22
00:03:00,260 --> 00:03:04,100
يحاول الفرسان قتل الآلهة أثينا

23
00:03:04,220 --> 00:03:06,720
التي يُفترض بهم صونها

24
00:03:06,850 --> 00:03:09,140
لعلّك تدعو ذلك بالعدالة

25
00:03:10,690 --> 00:03:12,230
معلّم دوكو

26
00:03:12,350 --> 00:03:15,980
على مرّ التاريخ البشريّ
،وفي كلّ الحروب

27
00:03:16,110 --> 00:03:18,860
تُطبّق العدالة من قِبل الفائز

28
00:03:18,990 --> 00:03:22,360
بشكلٍ نسبيّ، القوّة هي عدالة

29
00:03:22,490 --> 00:03:26,870
أثينا ضعيفة، والسيّد العظيم قويّ

30
00:03:26,990 --> 00:03:30,620
من الجليّ إذاً أنّ السيّد العظيم
هو العدالة بحدّ ذاته

31
00:03:31,550 --> 00:03:33,020
أحمق

32
00:03:33,020 --> 00:03:35,250
يوجد صوابٌ يوجد خطأ

33
00:03:35,380 --> 00:03:39,340
،لكنّك تأبى رؤية ذلك
وتختار الجهل على الحقيقة

34
00:03:47,600 --> 00:03:49,980
يبدو أنّك لم تصبني

35
00:03:50,100 --> 00:03:53,480
لطالما تذهلني يا معلّم دوكو

36
00:03:53,600 --> 00:03:56,730
،أم عليّ مناداتك بدوكو

37
00:03:57,270 --> 00:03:59,730
أحد الاثنيّ عشر، فارس الميزان الذهبيّ؟

38
00:04:01,610 --> 00:04:04,610
!أجبرتني على القتال بجدّيةٍ الآن

39
00:04:05,870 --> 00:04:09,700
يدعو الصينيّون نوء نثرة كوكبة السرطان

40
00:04:09,830 --> 00:04:12,250
بضباب روح العالم السفليّ

41
00:04:12,370 --> 00:04:15,250
النور الذي يصعد من الجثث

42
00:04:15,380 --> 00:04:20,630
نوء النثرة هي معبرٌ تصعد عبره
أرواح الموتى إلى السماء

43
00:04:20,760 --> 00:04:24,970
!خنق نوء نثرة العالم السفليّ

44
00:04:33,350 --> 00:04:35,100
!يكفي يا ديثماسك

45
00:04:38,440 --> 00:04:39,440
من هناك؟

46
00:04:41,690 --> 00:04:44,200
فارس الحمل الذهبيّ، مو

47
00:04:47,530 --> 00:04:49,080
أشكرك

48
00:04:49,200 --> 00:04:51,950
أعتذر على التدخّل يا معلّم دوكو

49
00:04:52,080 --> 00:04:56,710
إن نوى أحدٌ أذيّة المعلّم دوكو، فعليه تجاوزي

50
00:04:56,830 --> 00:05:00,840
إذاً يا مو، أتعارض الملجأ بدورك؟

51
00:05:00,960 --> 00:05:03,800
لن أعارض الملجأ أبداً

52
00:05:03,920 --> 00:05:08,090
أحاول اتّباع المبادئ وحسب
وأداء الغرض الحقيقيّ من الفرسان

53
00:05:08,720 --> 00:05:09,970
أنت كذلك

54
00:05:10,100 --> 00:05:13,060
لن أواجه فارسين ذهبيّين بمفردي

55
00:05:13,180 --> 00:05:15,230
سأتراجع حاليّاً

56
00:05:15,350 --> 00:05:18,100
لكنّك تعرف أنّ حياتها متعلّقةٌ بخيط

57
00:05:19,520 --> 00:05:23,280
تبخّر أملكم سلفاً

58
00:05:25,240 --> 00:05:28,110
ما الذي قصده بأملنا؟

59
00:05:28,240 --> 00:05:30,490
ما الذي حلّ بآلهتنا؟

60
00:05:31,660 --> 00:05:34,250
أُصيبت أثينا بسهمٍ قاتل للآلهة

61
00:05:36,710 --> 00:05:38,000
إنّها تحتضر

62
00:05:38,120 --> 00:05:42,000
في آخر لحظة، سأفعل ما عليّ فعله

63
00:05:45,920 --> 00:05:49,930
أنا متأكّدٌ أنّك لا تقصد ذلك يا سيّد مو

64
00:05:53,100 --> 00:05:54,060
!سينا

65
00:05:54,180 --> 00:05:56,020
!لا! لا يمكن

66
00:05:56,140 --> 00:05:57,100
من فعل هذا؟

67
00:05:58,980 --> 00:05:59,860
!سينا

68
00:05:59,980 --> 00:06:02,440
!أرجوكِ سيّدتي، لا تموتي

69
00:06:02,570 --> 00:06:04,110
!ماغنس، اذهب واستدعِ طبيباً

70
00:06:04,230 --> 00:06:06,610
أين؟ نحن في منتصف اللا مكان

71
00:06:06,740 --> 00:06:09,360
أمسكها يا مايلوك، سأنتزعه

72
00:06:11,870 --> 00:06:13,620
كلا، سيا

73
00:06:13,740 --> 00:06:14,910
لا يمكنك

74
00:06:15,040 --> 00:06:17,290
ليس سهماً عاديّاً

75
00:06:17,410 --> 00:06:19,170
صحيح

76
00:06:19,290 --> 00:06:20,920
!من أنت؟

77
00:06:25,300 --> 00:06:27,920
تريمي، فارس السهم الفضيّ

78
00:06:31,850 --> 00:06:34,220
ذاك سهمٌ قاتل للآلهة

79
00:06:34,350 --> 00:06:38,730
الوحيد القادر على انتزاعه هو سيّدنا الكبير

80
00:06:38,850 --> 00:06:42,190
رجلٌ بنبل ورقيّ أدمغة الآلهة

81
00:06:43,370 --> 00:06:44,020
!سينا

82
00:06:44,150 --> 00:06:48,570
سيخترقها السهم أعمق فأعمق تدريجيّاً

83
00:06:48,700 --> 00:06:51,490
في غضون 12 ساعة، سيصل قلبها

84
00:06:51,620 --> 00:06:54,490
!وستلقى حتفها

85
00:06:56,120 --> 00:06:58,750
!هجمة السهام الشبحيّة

86
00:07:00,000 --> 00:07:01,370
!حاذروا

87
00:07:06,130 --> 00:07:08,170
!ماذا؟ هذه السهام مزيّفة

88
00:07:08,990 --> 00:07:09,380
!خطأ

89
00:07:11,680 --> 00:07:14,220
ليست كلّ سهامي شبحيّة

90
00:07:14,350 --> 00:07:17,720
ستكتشفون أن بعضها
حقيقيّةٌ جدّاً

91
00:07:17,850 --> 00:07:19,350
احموا أثينا

92
00:07:19,980 --> 00:07:22,020
!هجمة السهام الشبحيّة

93
00:07:22,150 --> 00:07:25,820
،وزن السهام الحقيقيّة أثقل
فيُفترض أن يكون مسمعها مختلفاً

94
00:07:25,940 --> 00:07:27,610
ثقوا بآذانكم

95
00:07:27,730 --> 00:07:29,780
ركّزوا على الصوت

96
00:07:38,410 --> 00:07:40,120
!هناك

97
00:07:43,000 --> 00:07:46,210
!سينا

98
00:07:48,090 --> 00:07:49,130
إنّها بخير

99
00:07:49,920 --> 00:07:51,380
شكراً يا لونغ

100
00:07:51,510 --> 00:07:52,510
!محض حظّ

101
00:07:52,630 --> 00:07:55,010
!لنرى مدى حظّكم هذه المرّة

102
00:07:55,140 --> 00:07:57,390
!هجمة السهام الشبحيّة

103
00:07:57,510 --> 00:07:58,970
واجهه أنت يا سيا

104
00:07:59,100 --> 00:07:59,930
!عُلِم

105
00:08:04,940 --> 00:08:06,060
ماذا؟

106
00:08:06,190 --> 00:08:08,570
!ريو سي كين الفرس الأعظم

107
00:08:22,960 --> 00:08:25,580
،ربما استطعتم هزيمتي

108
00:08:25,710 --> 00:08:28,630
لكنّكم ميّتون سلفاً

109
00:08:30,300 --> 00:08:31,210
!سيا

110
00:08:31,340 --> 00:08:32,840
!المعبر يُغلق

111
00:08:32,970 --> 00:08:37,220
،أُرسل تريمي من قبل السيّد العظيم
فلا بدّ أنّ ذاك الثقب يقود للملجأ

112
00:08:37,850 --> 00:08:39,600
لا خيار آخر بيدنا إذاً

113
00:08:39,720 --> 00:08:41,310
علينا المغادرة الآن

114
00:08:41,430 --> 00:08:43,350
يجب أن نذهب للملجأ

115
00:08:43,480 --> 00:08:46,350
ونجعل السيّد العظيم ينتزع
هذا السهم الذهبيّ

116
00:08:46,480 --> 00:08:49,520
مايلوك، ابقِ هنا واعتنِ بسينا

117
00:08:49,650 --> 00:08:52,690
كلّا، سآتي أيضاً

118
00:08:53,570 --> 00:08:56,030
قتالنا الحقيقيّ يبدأ الآن

119
00:08:57,740 --> 00:09:00,950
لطالما عرفتُ أنّ هذه الرحلة ستكون صعبة

120
00:09:01,080 --> 00:09:04,960
لكنّي لن أستستلم مهما حصل

121
00:09:05,080 --> 00:09:07,250
تعلّمتُ ذلك منكم

122
00:09:07,380 --> 00:09:10,250
ولن نستسلم في أمركِ
أيضاً يا سينا

123
00:09:10,380 --> 00:09:13,590
سننقذكِ مهما تطلّب الأمر

124
00:09:14,670 --> 00:09:15,880
أعرف يا سيا

125
00:09:16,720 --> 00:09:18,090
لطالما عرفت

126
00:09:25,140 --> 00:09:26,600
أثينا

127
00:09:47,920 --> 00:09:50,170
الملجأ

128
00:09:50,290 --> 00:09:52,920
أجل، هذا هو الملجأ

129
00:09:55,800 --> 00:09:58,800
هذا هو مخبأ أعدائنا إذاً

130
00:09:59,590 --> 00:10:03,060
هذا المكان مهيب

131
00:10:05,890 --> 00:10:08,060
علينا الذهاب لحجرة السيّد الكبير

132
00:10:08,190 --> 00:10:11,060
لفعل ذلك، علينا عبور منازل الأبراج

133
00:10:11,190 --> 00:10:14,070
ويحمي كلّ منها فارسٌ ذهبيّ

134
00:10:14,190 --> 00:10:16,360
الأوّل هو منزل الحمل

135
00:10:16,490 --> 00:10:21,450
،ثمّ منازل الثور، الجوزاء، السرطان، الأسد

136
00:10:21,570 --> 00:10:25,700
،العذراء، الميزان، العقرب، القوس

137
00:10:25,830 --> 00:10:29,580
الجدي، الدلو، الحوت

138
00:10:29,710 --> 00:10:31,920
ثمّ حجرة السيّد العظيم

139
00:10:32,040 --> 00:10:33,210
لكن فليكن في علمكم

140
00:10:33,340 --> 00:10:36,340
أنّ لا فارس قاتل عبر
كلّ المنازل الاثني عشر

141
00:10:36,460 --> 00:10:38,220
ليس منذ العصور القديمة

142
00:10:39,970 --> 00:10:44,310
لنصل السيّد العظيم إذاً، علينا تجاوز
اثنا عشر فارس ذهبيّ فحسب؟

143
00:10:44,430 --> 00:10:45,220
صحيح

144
00:10:45,350 --> 00:10:46,560
!يبدو ذلك مُسليّاً

145
00:10:46,680 --> 00:10:48,140
!هيّا بنا! لنذهب

146
00:10:58,400 --> 00:11:02,530
هذا المعبد الأوّل، منزل الحمل

147
00:11:09,830 --> 00:11:12,880
لا بدّ أنّ ذاك هو الفارس الذهبيّ
الذي يحمي منزل الحمل

148
00:11:18,090 --> 00:11:19,470
...أتيتم إذاً

149
00:11:22,510 --> 00:11:24,390
لحظة، ما هذا؟

150
00:11:24,510 --> 00:11:26,890
هنالك شيءٌ ممسكٌ بي

151
00:11:27,020 --> 00:11:29,180
أنا أيضاً، لا أستطيع الحراك

152
00:11:30,620 --> 00:11:31,640
!تبّاً

153
00:11:37,210 --> 00:11:38,510
فات الأوان

154
00:11:38,530 --> 00:11:40,400
انتهى الأمر

155
00:11:40,530 --> 00:11:45,240
أنا مو، فارس الحمل الذهبيّ

156
00:11:59,760 --> 00:12:02,800
لا يمكن لشيءٍ إنقاذك
من السهم القاتل للآلهة

157
00:12:02,930 --> 00:12:06,800
كلّ ما يسعني فعله لكِ الآن
هو ترككِ تموتين بسلام

158
00:12:06,930 --> 00:12:08,850
دون أيّ مقاطعة

159
00:12:09,560 --> 00:12:11,680
!كلّا! لن نستسلم

160
00:12:11,810 --> 00:12:13,440
!سنقاتل حتّى النهاية

161
00:12:13,560 --> 00:12:16,270
لا شيء بانتظاركم عدا الموت

162
00:12:16,400 --> 00:12:18,320
إن قاتلتم هنا، فستموتون

163
00:12:18,440 --> 00:12:21,070
إن هربتم من هنا، فستموتون

164
00:12:21,190 --> 00:12:24,200
أنا وحدي قادرٌ على تحريركم من عنائكم

165
00:12:27,330 --> 00:12:30,580
لا يستطيع أحدٌ الهرب من تحريكي الذهنيّ

166
00:12:30,700 --> 00:12:33,160
لحظة، أنت السيّد مو

167
00:12:33,290 --> 00:12:34,870
ألا تتعرّف علينا؟

168
00:12:35,000 --> 00:12:37,790
!ساعدتنا على الهروب من البركان

169
00:12:37,920 --> 00:12:41,170
أنت ومعلّمي صديقان لأعوام

170
00:12:41,300 --> 00:12:43,880
أعرف أنّك رجلٌ شريف

171
00:12:44,010 --> 00:12:45,890
لمَ تقوم بهذا؟

172
00:12:46,010 --> 00:12:50,390
صدقت، أكنّ أشدّ الاحترام لمعلّمك

173
00:12:50,520 --> 00:12:54,600
ينتابني الأسى لتحتّم قتلي لتلميذه المفضّل

174
00:12:57,270 --> 00:13:00,980
المساعدة الوحيدة التي أستطيع تقديمها
لكم الآن هي الموت السريع

175
00:13:03,780 --> 00:13:07,990
الآن، كما أراد السيّد العظيم، تصدّينا للنبوءة

176
00:13:08,120 --> 00:13:11,290
لمَ؟ لمَ تصدّق النبوءة؟

177
00:13:11,410 --> 00:13:14,790
يكشف درع فوهة البركان الفضّي المستقبل

178
00:13:15,420 --> 00:13:20,090
قبل 20 عاماً، بُعثت آلهتنا أثينا كطفلة بشريّة

179
00:13:20,210 --> 00:13:22,510
،عندما تلقّاها السيّد العظيم

180
00:13:22,630 --> 00:13:26,340
حمل الرضيعة فوق الماء
في درع فوهة البركان الفضّي

181
00:13:26,470 --> 00:13:28,590
أتريدون معرفة ما الذي عرضه؟

182
00:13:30,970 --> 00:13:33,640
سأُطُلعكم كأمنيتكم الأخيرة

183
00:13:45,570 --> 00:13:48,410
!لا تزيحوا بأنظاركم عن المستقبل

184
00:13:48,530 --> 00:13:50,330
!أبقوا أعينكم مفتوحة

185
00:13:58,880 --> 00:14:01,340
!هُزِمت أثينا

186
00:14:01,460 --> 00:14:04,670
!ودُمّرت البشريّة

187
00:14:07,380 --> 00:14:10,390
لا يمكن أن تنتهي البشريّة هكذا

188
00:14:10,510 --> 00:14:12,390
المأساة

189
00:14:14,520 --> 00:14:17,230
أجل، مأساة بمعنى الكلمة

190
00:14:17,350 --> 00:14:18,140
كلّا

191
00:14:18,270 --> 00:14:21,020
!حتّى لو كانت صحيحة، لا يمكنني تصديقها

192
00:14:21,150 --> 00:14:22,900
!لن أفعل

193
00:14:23,020 --> 00:14:25,030
كنتُ أفكّر بشكلٍ مغايرٍ أيضاً

194
00:14:25,150 --> 00:14:29,280
،وعندما رأيتُ كيف كبرتْ
،وكيف حاولتم حمايتها

195
00:14:29,410 --> 00:14:30,910
،شعرتُ بأمل

196
00:14:31,030 --> 00:14:33,530
أصغر أملٍ قد أتمسّك به

197
00:14:33,660 --> 00:14:35,830
كما أمل المعلّم دوكو

198
00:14:35,950 --> 00:14:39,210
وكما ضحّى آيولوس بحياته لهذا الأمل

199
00:14:39,330 --> 00:14:44,920
لكن بالسهم القاتل للآلهة مغروساً
بجوار قلبها، أثينا هالكة

200
00:14:45,050 --> 00:14:46,590
الأمل ميت

201
00:14:46,710 --> 00:14:49,010
تفهمون ما على المحكّ

202
00:14:49,130 --> 00:14:50,720
!فلتقبلوا قدركم الآن

203
00:14:53,510 --> 00:14:54,890
!توقّف

204
00:14:55,010 --> 00:14:56,720
...أرجوك

205
00:14:56,850 --> 00:14:58,890
يا فارس الحمل الذهبيّ النبيل

206
00:14:59,020 --> 00:15:01,150
دعني أتكلّم

207
00:15:01,270 --> 00:15:04,520
لديكِ سهمٌ قاتل للآلهة
بجوار قلبكِ بالفعل

208
00:15:04,650 --> 00:15:06,530
وتقاومين مع ذلك؟

209
00:15:08,400 --> 00:15:10,400
فلتتكلّمي أيّتها الآلهة أثينا

210
00:15:10,530 --> 00:15:13,160
أتفهّم شكّك بي

211
00:15:14,530 --> 00:15:15,990
انظر لي

212
00:15:16,120 --> 00:15:16,910
أنا ضعيفة

213
00:15:17,700 --> 00:15:21,170
...لم أستطع الارتقاء لتوقّعاتكم، لكن

214
00:15:21,290 --> 00:15:24,250
لكن إن كان قتلي سيجلب الأمان

215
00:15:24,380 --> 00:15:28,510
فأنا متحضّرةٌ للتضحية بحياتي، بلا ندم

216
00:15:28,630 --> 00:15:32,300
لكنّي... لا أزال أشعر

217
00:15:32,430 --> 00:15:35,760
لا تزال تراودك شكوك
حيال قرار السيّد العظيم

218
00:15:35,890 --> 00:15:38,520
تشعر بوجود خطأٍ ما

219
00:15:41,310 --> 00:15:43,060
لا أزال على قيد الحياة

220
00:15:43,190 --> 00:15:45,650
وقتالنا سيُعيد الأمل

221
00:15:47,730 --> 00:15:50,700
،مو، يا فارس الحمل الذهبيّ

222
00:15:50,820 --> 00:15:54,280
فلتحتفظ بأملك فيّ رجاءً
وفي هؤلاء الفرسان البرونزيّين

223
00:15:54,410 --> 00:15:56,080
لن نخذلك

224
00:16:07,040 --> 00:16:08,050
!مُحال

225
00:16:08,170 --> 00:16:11,800
لم يستطع فارسٌ برونزيّ أبداً
!التغلّب على تحريكي الذهنيّ

226
00:16:13,090 --> 00:16:16,720
،إن استطعت الشعور بذلك
فلمَ لا تنصت لنفسك؟

227
00:16:16,850 --> 00:16:20,770
ترى شخصاً بحاجةٍ للعون، ولا تقوم بشيء

228
00:16:20,890 --> 00:16:23,020
ألقِ نظرةً عن كثب لآلهتنا

229
00:16:23,140 --> 00:16:26,360
ألا يمكنك رؤية الحقيقة أمام عينيك؟

230
00:16:26,480 --> 00:16:28,650
يا لطفوليّتك

231
00:16:31,780 --> 00:16:32,700
!درعي

232
00:16:32,820 --> 00:16:33,650
ما الذي يفعله؟

233
00:16:36,620 --> 00:16:37,990
!أنت -
!تبّاً -

234
00:16:38,120 --> 00:16:39,120
!كلّا

235
00:16:59,560 --> 00:17:01,270
طفوليّةٌ بحقّ

236
00:17:01,390 --> 00:17:03,270
روحكِ قويّة

237
00:17:03,390 --> 00:17:05,520
لم يستطع فارسٌ برونزيّ أبداً
التغلّب على

238
00:17:09,650 --> 00:17:11,030
!سينا

239
00:17:14,820 --> 00:17:17,910
الوقت يداهمنا، علينا التحرّك

240
00:17:18,030 --> 00:17:20,540
!نحتاج دروعنا الآن يا سيّد مو

241
00:17:20,660 --> 00:17:25,500
أحذّركم، الفرسان الذهبيّون أشدّ
قوّة مما قد يخطر لكم

242
00:17:25,620 --> 00:17:27,040
لا تعرفون قوّتهم

243
00:17:27,170 --> 00:17:31,000
إنّهم أقوى بأضعاف من كلّ
من سبقت لكم مواجهتهم

244
00:17:31,130 --> 00:17:32,800
تذكروا ذلك

245
00:17:32,920 --> 00:17:37,050
سيّد مو، هذه الدروع بلا قيمة

246
00:17:37,180 --> 00:17:38,550
لحظة، أعرفك

247
00:17:38,680 --> 00:17:41,060
كيكي! ماذا تفعل هنا؟

248
00:17:41,180 --> 00:17:42,810
أسئلةٌ من جديد؟

249
00:17:42,930 --> 00:17:44,930
أنت أحمقٌ بحقّ يا سيا

250
00:17:45,060 --> 00:17:46,940
لا وقت لنهدره

251
00:17:47,060 --> 00:17:48,810
كيكي، تحضّر فوراً

252
00:17:48,940 --> 00:17:51,320
علينا إصلاح كافة الدروع الأربعة

253
00:17:51,440 --> 00:17:53,280
أمرك سيّدي مو

254
00:17:53,400 --> 00:17:56,450
،واجلب لي أوريهالكون، الغامانيوم

255
00:17:56,570 --> 00:17:58,410
ورمال الغبار النجميّ أيضاً

256
00:18:06,040 --> 00:18:07,460
علينا الذهاب

257
00:18:07,580 --> 00:18:10,630
قال مو أنّه سيصلحها، لكنّ ذلك
يستغرق وقتاً طويلاً

258
00:18:10,750 --> 00:18:15,130
،لا تدرك كليّاً ما الذي تواجهه حتّى
صحيح يا سيا؟

259
00:18:15,880 --> 00:18:18,630
ذاك عدوّك الحقيقيّ، الوقت

260
00:18:19,590 --> 00:18:23,760
ستحسب ساعة الأبراج الاثنتيّ عشرة ساعة
المتبقّية من حياة أثينا تنازليّاً

261
00:18:23,890 --> 00:18:27,180
مع مضيّ كلّ ساعة، ستُطفأ شعلة

262
00:18:27,310 --> 00:18:31,020
وسيتغلغل السهم أكثر وأقرب لقلبها

263
00:18:31,150 --> 00:18:33,020
،وفي نهاية الساعة الأخيرة

264
00:18:33,150 --> 00:18:35,570
ستتلاشى نار الحوت

265
00:18:35,690 --> 00:18:38,280
ثمّ ستموت الآلهة

266
00:18:38,400 --> 00:18:40,030
سنهزم الفرسان الذهبيّين

267
00:18:40,160 --> 00:18:43,120
!ونصل حجرة السيّد العظيم قبل حصول ذلك

268
00:18:43,240 --> 00:18:46,620
انظروا يا رفاق، برج ساعة الأبراج

269
00:18:46,750 --> 00:18:49,580
تبقّى أمامنا 11 ساعة لإنقاذ سينا

270
00:18:49,710 --> 00:18:51,880
هيّا، علينا التحرّك

271
00:18:52,000 --> 00:18:55,460
اسمعوا، الطرق... لد توقّف

272
00:19:11,600 --> 00:19:14,690
مذهل، يفيض درعي بالكوزمو

273
00:19:14,820 --> 00:19:17,320
أكاد أسمعه يتنفّس

274
00:19:17,440 --> 00:19:19,490
ودرعي مُكتملٌ مُجدّداً

275
00:19:19,610 --> 00:19:21,240
شكراً لك يا سيّد مو

276
00:19:21,360 --> 00:19:23,490
هذا أقصى ما أستطيع المساعدة به

277
00:19:23,620 --> 00:19:27,370
تذكّروا، قوّة ومهارة الفرسان الذهبيّين أسطورة

278
00:19:27,500 --> 00:19:29,330
يتحلّون بقوّة لا نظير لها

279
00:19:29,460 --> 00:19:32,290
لأنّهم طوّروا جوهر الكوزمو خاصّتهم

280
00:19:32,420 --> 00:19:34,000
جوهر الكوزمو خاصّتهم؟

281
00:19:34,130 --> 00:19:38,710
يعتقد البعض أنّ الكوزمو موهبة
هبة داخليّة للنفس والروح

282
00:19:38,840 --> 00:19:43,090
لكنّ مصدر الكوزمو المُطلق هو... الحاسّة السابعة

283
00:19:43,220 --> 00:19:44,680
الحاسّة السابعة؟

284
00:19:44,800 --> 00:19:47,100
وصولكم للحاسّة السابعة من عدمه

285
00:19:47,220 --> 00:19:50,560
سيحدّد نتيجة مواجهاتكم القادمة

286
00:19:50,680 --> 00:19:52,310
فلتنطلقوا الآن

287
00:20:00,490 --> 00:20:03,360
الفرسان البرونزيّون ضدّ الفرسان الذهبيّين

288
00:20:03,490 --> 00:20:06,990
سيّدي مو، أيمتلكون فرصة؟

289
00:20:09,910 --> 00:20:12,500
المعبد الثاني، منزل الثور

290
00:20:12,620 --> 00:20:15,040
!الوقت يداهمنا! هيّا بنا

291
00:20:19,130 --> 00:20:20,260
تمهّلوا

292
00:20:20,380 --> 00:20:21,510
هذا سهلٌ جدّاً

293
00:20:22,760 --> 00:20:24,640
يبدو مهجوراً

294
00:20:24,760 --> 00:20:27,010
لا أستشعر أيّ كوزمو

295
00:20:27,140 --> 00:20:28,720
لنواصل التحرّك

296
00:20:34,520 --> 00:20:35,940
ما كان ذلك؟

297
00:20:36,060 --> 00:20:38,820
هل اصطدمنا بحائط خفيّ؟

298
00:20:46,120 --> 00:20:49,330
ليس مسموحاً لكم دخول منزل الثور

299
00:20:49,450 --> 00:20:52,290
فارس الثور الفضّي آلديباران يمنع ذلك

300
00:20:52,410 --> 00:20:54,290
!سأتكفّل بهذا الشخص

301
00:20:54,420 --> 00:20:56,630
!أسرعوا وتوجّهوا للمعبد التالي

302
00:20:56,750 --> 00:20:57,590
!سألحق بكم

303
00:20:57,710 --> 00:21:00,300
!نراك في الجانب الآخر، هيّا بنا

304
00:21:02,670 --> 00:21:04,800
!ريو سي كين الفرس الأعظم

305
00:21:15,900 --> 00:21:17,270
!مستحيل

306
00:21:17,400 --> 00:21:20,270
أخبرتكم أنّي لن أسمح لكم بالمرور

307
00:21:20,400 --> 00:21:24,860
إذا أردتم العبور، فعليكم هزيمتي