1
00:00:00,200 --> 00:00:03,450
يُقال أنّ خلال كلّ
بضعة مئات الأعوام

2
00:00:03,570 --> 00:00:06,700
تُبعث الآلهة أثينا

3
00:00:06,830 --> 00:00:10,620
والآن وُلِدت أثينا جديدة
في هذا العالم

4
00:00:10,750 --> 00:00:15,920
لكن هذه المرّة، تحت ظلّ نبوءة
سوداء بقيادتها للبشريّة للهلاك

5
00:00:16,040 --> 00:00:20,550
عُرف المحاربون الذين دافعوا
عن الآلهة أثينا بالفرسان

6
00:00:20,670 --> 00:00:25,720
اليوم، يتحكّم جيلٍ جديد من الفرسان
بمصير العالم

7
00:00:25,850 --> 00:00:29,430
يُدعون بفرسان الأبراج

8
00:02:00,230 --> 00:02:02,650
..."سابقاً في "سينت سيا

9
00:02:02,780 --> 00:02:04,860
لمَ أتيت لتلّ النجم؟

10
00:02:04,990 --> 00:02:05,860
من أنت؟

11
00:02:09,660 --> 00:02:11,790
!الجدار البلّوري

12
00:02:14,750 --> 00:02:17,460
تفاجأتِ برؤيتي يا جينيت؟

13
00:02:17,580 --> 00:02:19,210
معلّم ديدليس؟

14
00:02:20,970 --> 00:02:25,160
من بقوّة إله

15
00:02:28,760 --> 00:02:30,640
أنت على قيد الحياة؟

16
00:02:30,760 --> 00:02:31,970
من هذا؟

17
00:02:32,100 --> 00:02:34,270
معلّمي ديدليس

18
00:02:34,390 --> 00:02:36,690
فارس الملتهب الفضّي

19
00:02:36,810 --> 00:02:38,060
...لكنّه

20
00:02:40,190 --> 00:02:41,440
معلّمي؟

21
00:02:41,570 --> 00:02:43,230
جينيت؟

22
00:02:43,360 --> 00:02:45,490
لمَ رجعتِ؟

23
00:02:45,610 --> 00:02:48,030
!الكوزمو خاصّتك، لقد اختفت

24
00:02:48,150 --> 00:02:52,410
جينيت، فات الأوان بالنسبة لي

25
00:02:54,140 --> 00:02:58,860
لدى السيّد العظيم سرّ

26
00:02:58,980 --> 00:03:00,730
...اذهبي إلى

27
00:03:00,860 --> 00:03:01,940
تلّ النجم

28
00:03:02,070 --> 00:03:03,860
!لا، لا، لا

29
00:03:03,990 --> 00:03:05,450
!لا-لا يمكنك الموت هكذا

30
00:03:05,570 --> 00:03:07,370
!أحتاج منك أن تعلّمني

31
00:03:07,490 --> 00:03:09,780
!لا يا معلّمي، لا تمت رجاءً

32
00:03:12,580 --> 00:03:14,410
...أشعر بالسرور

33
00:03:15,460 --> 00:03:17,420
...لأنّكِ كبرتِ لتصبحي

34
00:03:18,750 --> 00:03:19,840
إنسانةً صالحة

35
00:03:21,710 --> 00:03:23,840
أنا فخورٌ بكِ

36
00:03:31,600 --> 00:03:32,560
معلّمي؟

37
00:03:34,980 --> 00:03:36,270
!معلّمي

38
00:03:47,240 --> 00:03:49,530
!لا يمكنكِ إيقافي، سأذهب أيضاً

39
00:03:49,660 --> 00:03:51,950
ستُقتلين

40
00:03:59,080 --> 00:04:01,460
أنا مستعدّةٌ للمخاطرة بحياتي

41
00:04:06,550 --> 00:04:07,590
!أنت على قيد الحياة

42
00:04:11,600 --> 00:04:12,430
!جينيت

43
00:04:15,310 --> 00:04:16,810
ما هذا؟

44
00:04:16,940 --> 00:04:18,140
طفلٌ مزعج

45
00:04:19,560 --> 00:04:20,730
!حاذر

46
00:04:23,020 --> 00:04:24,610
!كيكي

47
00:04:24,730 --> 00:04:26,740
من أنت بالضبط؟

48
00:04:26,860 --> 00:04:28,410
صمتاً أيّتها الصغيرة

49
00:04:28,530 --> 00:04:29,610
أنا معلّمكِ

50
00:04:30,870 --> 00:04:32,660
كنتِ وشون تلميذتيّ

51
00:04:32,780 --> 00:04:35,370
لكنّكِ كنتِ الأدنى بالتأكيد

52
00:04:36,710 --> 00:04:40,630
،تفوّقت عليكِ شون بسهولة
ولم تستطيعي تقبّل ذلك

53
00:04:40,750 --> 00:04:42,460
يا للبؤس

54
00:04:42,590 --> 00:04:43,380
معلّمي؟

55
00:04:43,500 --> 00:04:45,510
كنتِ عبئاً

56
00:04:45,630 --> 00:04:48,510
تلميذة تفتقر لالتزام المُتابعة

57
00:04:48,630 --> 00:04:51,260
كرة من عقد الدونيّة

58
00:04:51,390 --> 00:04:53,560
أنتِ فشل

59
00:04:53,680 --> 00:04:54,640
!أغلق فمك

60
00:04:54,760 --> 00:04:56,310
!لست معلّمي

61
00:05:01,450 --> 00:05:03,320
أهذا كلّ ما لديك؟

62
00:05:09,530 --> 00:05:13,160
تحاولين إخفاء الأمر، لكنّكِ
لا تستطيعين مواجهة الحقيقة

63
00:05:13,280 --> 00:05:16,450
أنتِ عديمة القيمة، لا تملكين القدرة
على أداء شيء

64
00:05:20,080 --> 00:05:22,960
لا شأن لكِ بأن تصبحي فارسة

65
00:05:23,080 --> 00:05:25,710
!فلتموتي هنا والآن

66
00:05:25,840 --> 00:05:29,220
!مطرقة هدم المُلتهب

67
00:05:37,680 --> 00:05:40,060
شقيّةٌ حقيرة

68
00:05:43,190 --> 00:05:45,770
أجل، قد تكون مُحقّاً

69
00:05:45,900 --> 00:05:48,070
قد لا أملك القدرة على أداء شيء

70
00:05:48,190 --> 00:05:52,070
،لكن رغم أنّ شون كرهت فكرة القتال

71
00:05:52,200 --> 00:05:55,080
كانت عازمةً على التشجّع ومواجهة قدرها

72
00:05:55,200 --> 00:05:57,580
عندما ذهبت للقتال في حروب المجرّات

73
00:06:13,300 --> 00:06:14,510
...إن كانت قادرةً على فعلها

74
00:06:22,350 --> 00:06:23,650
فكذلك أنا

75
00:06:26,270 --> 00:06:28,070
حمقاء واهمة

76
00:06:28,190 --> 00:06:30,490
!سأمحيكِ مع أحلامكِ

77
00:06:30,610 --> 00:06:33,990
!مطرقة هدم المُلتهب

78
00:06:35,660 --> 00:06:37,950
جلدة سوط قوس المطر

79
00:06:39,040 --> 00:06:39,870
!ماذا؟

80
00:06:52,720 --> 00:06:54,840
نلتُ منك أيّها المعلّم المزيّف

81
00:07:07,020 --> 00:07:09,070
أحسنتِ الصنيع يا جينيت

82
00:07:09,190 --> 00:07:12,440
رأيتِ الحقيقة بأمّ عينيكِ

83
00:07:12,570 --> 00:07:13,490
معلّمي؟

84
00:07:13,610 --> 00:07:16,110
...تلك القوّة الداخليّة

85
00:07:16,240 --> 00:07:18,120
لطالما عرفتُ أنّكِ ستجدينها

86
00:07:19,830 --> 00:07:21,830
!معلّمي، لا تذهب رجاءً

87
00:07:21,950 --> 00:07:23,960
لا بأس

88
00:07:24,080 --> 00:07:26,290
لم أعد أمتلك ندماً الآن

89
00:07:26,420 --> 00:07:29,250
أنا فخورٌ بكِ يا جينيت

90
00:07:29,380 --> 00:07:30,590
...يسرّني أنّكِ

91
00:07:31,630 --> 00:07:33,380
كنتِ تلميذتي

92
00:07:47,060 --> 00:07:48,480
!كيكي

93
00:07:51,230 --> 00:07:52,190
ما الذي حدث؟

94
00:07:57,860 --> 00:07:59,030
غلبتِه؟

95
00:07:59,160 --> 00:08:00,950
ماذا؟ أأنت مُتفاجئ؟

96
00:08:01,080 --> 00:08:03,700
حسناً، كيف أقولها؟

97
00:08:03,830 --> 00:08:07,580
أعني، قد تكونين فارسةً حقيقيّة بالفعل

98
00:08:07,710 --> 00:08:10,290
أجل، أصبت. أنا رائعةٌ نوعاً ما

99
00:08:10,420 --> 00:08:12,130
كلّا، لستِ كذلك

100
00:08:33,070 --> 00:08:35,190
معبد العذراء

101
00:08:35,320 --> 00:08:37,530
سيكون الفارس الذهبيّ شاكا بانتظارنا

102
00:08:38,800 --> 00:08:41,450
قال آيوليا أنّ شاكا يكاد يكون إلهاً

103
00:08:41,570 --> 00:08:44,950
حذّرنا من عدم تركه
يفتح عينيه أيضاً

104
00:08:52,590 --> 00:08:55,840
أسيكون هذا مثل منزل السرطان؟

105
00:08:55,960 --> 00:08:57,970
مليئاً برائحة الموت؟

106
00:08:58,090 --> 00:09:00,090
إن كان كذلك، فسنكون مُستعدّين

107
00:09:00,220 --> 00:09:01,430
هيّا بنا

108
00:09:21,910 --> 00:09:23,870
أيّ معبدٍ هذا؟

109
00:09:23,990 --> 00:09:25,160
إنّه كالجنّة

110
00:09:26,290 --> 00:09:29,540
ألذا يدعونه بالأقرب لإله؟

111
00:09:29,660 --> 00:09:31,540
لا بدّ من ذلك

112
00:09:34,670 --> 00:09:36,590
أتشعران بتلك الكوزمو؟

113
00:09:36,710 --> 00:09:39,840
إنّها قويّةٌ جدّاً، لكن رقيقةٌ أيضاً

114
00:09:39,970 --> 00:09:42,800
لا بدّ أن تكون كوزمو شاكا العذراء

115
00:09:42,930 --> 00:09:44,550
علينا مواصلة التقدّم

116
00:09:44,680 --> 00:09:46,720
لا تملك سينا الكثير من الوقت

117
00:09:57,230 --> 00:09:58,610
!شاكا العذراء

118
00:10:04,740 --> 00:10:06,330
أتلك الكوزمو خاصّته؟

119
00:10:06,450 --> 00:10:08,750
لم يسبق وأن رأيتُ شيئاً ساطعاً كهذا

120
00:10:08,870 --> 00:10:10,830
إنّه لا يقلّ عن إله

121
00:10:16,210 --> 00:10:19,710
لا يبدو أنّه يريد القتال، أليس كذلك؟

122
00:10:19,840 --> 00:10:21,880
دعاني أتكلّم معه

123
00:10:22,010 --> 00:10:22,970
توخَّ الحذر يا لونغ

124
00:10:26,100 --> 00:10:28,930
،يُقال أنّ شاكا، فارس العذراء الذهبيّ

125
00:10:29,060 --> 00:10:31,310
شهمٌ وواسع البصيرة

126
00:10:31,430 --> 00:10:33,730
بحيث يستطيع الرؤية عبر الطبيعة البشريّة

127
00:10:33,850 --> 00:10:36,770
أتينا لمساعدة آلهتنا أثينا

128
00:10:36,900 --> 00:10:40,190
نحتاج لرؤية السيّد العظيم، والطلب منه بأن ينزع

129
00:10:40,320 --> 00:10:43,360
السهم القاتل للآلهة في قلبها

130
00:10:43,490 --> 00:10:45,820
هلّا سمحت لنا بالعبور؟

131
00:10:49,200 --> 00:10:50,950
سيّدي؟

132
00:10:51,080 --> 00:10:52,370
شاكا العذراء؟

133
00:10:58,380 --> 00:11:00,840
سأعتبر صمتك موافقةً يا شاكا

134
00:11:00,960 --> 00:11:01,880
!انتظر يا سيا

135
00:11:04,550 --> 00:11:05,890
!سيا -
!سيا -

136
00:11:07,300 --> 00:11:08,430
أأنت بخير؟

137
00:11:08,550 --> 00:11:12,140
أظهروا احتراماً أيّها الأطفال الوقحون

138
00:11:18,520 --> 00:11:22,110
،تقتحمون معبدي، منزل العذراء

139
00:11:22,240 --> 00:11:25,360
وتنتهكان السلام الذي أصنعه للعالم؟

140
00:11:25,490 --> 00:11:27,280
فهمتُ الآن

141
00:11:27,410 --> 00:11:29,620
لا تختلف عن بقيّة الفرسان الذهبيّين

142
00:11:29,740 --> 00:11:31,740
لست تكاد تكون إلهاً إذاً

143
00:11:31,870 --> 00:11:35,750
إنّك مجرّد مسنٍّ آخر لا يستطيع
!رؤية الصورة الأكبر

144
00:11:35,870 --> 00:11:37,750
!تأهّب يا شاكا

145
00:11:37,880 --> 00:11:40,840
!لوشان شين لونغ با

146
00:11:44,970 --> 00:11:47,140
!لم أنتهِ بعد

147
00:11:49,470 --> 00:11:52,100
ماذا؟ ما هذا؟

148
00:11:52,220 --> 00:11:55,230
يوقفٌ جدارٌ هوائيّ قبضتي

149
00:11:55,350 --> 00:11:59,230
قد تكون لكمتك الهزيلة قادرةً
،على إحداث تدفق عكسيّ

150
00:11:59,360 --> 00:12:00,980
لكنّ شلال لوشان العظيم

151
00:12:01,110 --> 00:12:03,230
ليس بذاك الإبهار كما تعلم

152
00:12:05,610 --> 00:12:08,820
سرعان ما سيخترق هذا الجدار الهوائيّ درعك

153
00:12:08,950 --> 00:12:11,240
ويمزّق الجلد من قبضتك

154
00:12:11,370 --> 00:12:14,870
وبعدها، سيهاجم عظامك

155
00:12:15,000 --> 00:12:16,210
ستُسحق

156
00:12:16,330 --> 00:12:18,370
وسيتبقّى لك مجرّد جِذْل

157
00:12:21,130 --> 00:12:22,500
!لونغ

158
00:12:22,630 --> 00:12:26,010
إنّه قويّ، كما قال آيوليا

159
00:12:26,130 --> 00:12:30,140
قد أكون الأقرب للآلهة من بين
،الفرسان الذهبيّين الاثني عشر

160
00:12:30,260 --> 00:12:33,890
لكن هناك شيءٌ تمتلكه الآلهة ولا أملكه

161
00:12:34,020 --> 00:12:36,730
لدى الآلهة شفقةٌ على الضعفاء

162
00:12:40,100 --> 00:12:42,770
سأتلو قداساً لكم الآن

163
00:12:42,900 --> 00:12:46,360
بينما تُنفون لعالم الجوع

164
00:12:46,490 --> 00:12:47,400
ما ذلك؟

165
00:12:47,530 --> 00:12:49,320
يبدو ككوزمو مُصغّر

166
00:12:49,450 --> 00:12:50,910
إنّه على وشك الهجوم

167
00:12:51,660 --> 00:12:53,330
أوم

168
00:12:53,450 --> 00:12:55,080
!تينما كوفوكو

169
00:13:06,130 --> 00:13:07,340
انظروا إليكم

170
00:13:07,470 --> 00:13:10,090
بالكاد استعملتُ أيّاً من قوّتي

171
00:13:10,260 --> 00:13:13,260
يُدهشني أنّ فرساناً بقدراتكم الضعيفة

172
00:13:13,390 --> 00:13:14,850
وصلوا لهذا الحدّ

173
00:13:14,970 --> 00:13:17,980
لا يسعني سوى استنتاج أنّ
الفرسان الذهبيّين قبلي

174
00:13:18,100 --> 00:13:20,600
خانوا السيّد العظيم

175
00:13:32,280 --> 00:13:33,530
مثيرٌ للإعجاب

176
00:13:34,370 --> 00:13:35,790
!سلسلة السديم

177
00:13:37,500 --> 00:13:40,330
ماذا؟ توقّفت سلسلتي

178
00:13:45,040 --> 00:13:47,380
ما الذي يحصل؟

179
00:13:48,970 --> 00:13:52,470
كيف هو شعور تقييدكِ بسلاسلك؟

180
00:13:52,590 --> 00:13:54,550
يا للتعاسة

181
00:13:54,680 --> 00:13:57,180
فلترحلي في أمانٍ الآن

182
00:14:03,740 --> 00:14:04,480
ماذا؟

183
00:14:04,610 --> 00:14:06,610
هل تناثر الدم عليّ؟

184
00:14:06,730 --> 00:14:10,360
كلّا، أتى شيءٌ طائر عبر الهواء

185
00:14:12,110 --> 00:14:13,820
ريشة؟

186
00:14:13,950 --> 00:14:16,240
هذا ما جرح إصبعي؟

187
00:14:16,370 --> 00:14:18,240
أصبت يا شاكا

188
00:14:18,370 --> 00:14:20,290
،لكن لأنّك آذيت أصدقائي

189
00:14:20,410 --> 00:14:21,830
فسأجعلك تنزف

190
00:14:21,960 --> 00:14:24,130
من أماكن كثيرة عير إصبعك

191
00:14:24,250 --> 00:14:25,880
...أذلك

192
00:14:30,510 --> 00:14:31,970
!نيرو

193
00:14:50,990 --> 00:14:52,490
نيرو العنقاء

194
00:14:52,610 --> 00:14:55,240
أتدرك العقوبة الفظيعة التي

195
00:14:55,360 --> 00:14:57,240
ستحلّ بك جرّاء جرحي؟

196
00:14:57,370 --> 00:14:59,620
لا أعرف، ولا أبالي

197
00:14:59,740 --> 00:15:01,450
ذلك ما ظننتُه

198
00:15:01,580 --> 00:15:02,750
انظر لقدميك

199
00:15:04,790 --> 00:15:06,420
بركة جحيم الدم

200
00:15:08,460 --> 00:15:09,420
ماذا؟

201
00:15:10,880 --> 00:15:13,630
كيف خرج كلّ هذا الدم من خدشٍ صغير؟

202
00:15:13,760 --> 00:15:15,510
أهذا وهمٌ ما؟

203
00:15:16,970 --> 00:15:18,350
ليس وهماً

204
00:15:18,470 --> 00:15:20,770
إنّه عقوبةٌ سماويّة

205
00:15:20,890 --> 00:15:23,600
هنالك سبيلٌ واحد فحسب لإنقاذك

206
00:15:23,730 --> 00:15:26,020
وهو بالركوع عند قدميّ

207
00:15:26,150 --> 00:15:29,650
ألصق جبينك بالأرض واعبدني

208
00:15:29,770 --> 00:15:31,070
!كلّا

209
00:15:31,190 --> 00:15:34,490
تريد منّي أن أعبدك كإله؟

210
00:15:34,610 --> 00:15:35,400
بالطبع

211
00:15:35,530 --> 00:15:39,030
إن فعلت، فقد تمتلك فرصةً في النجاة

212
00:15:40,270 --> 00:15:42,160
!كلّا! اخرج من هناك يا أخي الكبير

213
00:15:50,960 --> 00:15:52,510
لا جدوى من المقاومة

214
00:15:52,630 --> 00:15:54,380
مات نيرو

215
00:15:56,180 --> 00:15:57,260
!نيرو

216
00:16:04,460 --> 00:16:05,690
ما هذا؟

217
00:16:05,810 --> 00:16:09,150
الحرارة من كوزمو نيرو تجفّف دمي

218
00:16:14,490 --> 00:16:16,740
،لسوء حظّك يا شاكا

219
00:16:16,860 --> 00:16:19,780
لا أؤمن بالآلهة أو البوذا

220
00:16:19,910 --> 00:16:22,370
،أثق بشيءٍ واحدٍ فحسب في هذا العالم

221
00:16:22,490 --> 00:16:24,370
وهو قوّتي

222
00:16:26,710 --> 00:16:29,750
يبدو أنّك نضجت قليلاً مُذ لقائنا الأخير

223
00:16:29,880 --> 00:16:32,460
ما قصدك بمذ لقائنا الأخير؟

224
00:16:32,590 --> 00:16:36,260
لا تذكر، لكنّي سبق وأن عفوتُ
عن حياتك يا نيرو

225
00:16:36,380 --> 00:16:37,720
ماذا؟

226
00:16:39,840 --> 00:16:40,890
أذكر

227
00:16:41,010 --> 00:16:43,640
كنتُ عديم الحيلة وتحت رحمته

228
00:16:43,760 --> 00:16:45,310
كان بوسعه قتلي

229
00:16:45,430 --> 00:16:48,600
!أنت تستخفّ بي! خذ هذه

230
00:16:51,440 --> 00:16:54,030
ماذا؟ كيف فعلتَ ذلك؟

231
00:16:55,940 --> 00:16:56,990
!رأسي

232
00:16:58,860 --> 00:17:00,610
سأنصرف الآن

233
00:17:00,740 --> 00:17:03,120
ستنسى كلّ شيءٍ حدث هنا

234
00:17:03,240 --> 00:17:07,870
وسيختفي اسمي من ذاكرتك أيضاً

235
00:17:12,000 --> 00:17:12,960
!انتظر

236
00:17:18,130 --> 00:17:20,300
أخبرتُك ذاك اليوم بأنّك ستنسى

237
00:17:20,430 --> 00:17:22,800
كلّ شيءٍ عن لقائك بي

238
00:17:22,930 --> 00:17:25,930
لكنّي أخبرتك أيضاً إنّه
إن أتى وقتٌ

239
00:17:26,060 --> 00:17:28,520
وقفت فيه أمامي عدوّاً لي

240
00:17:28,640 --> 00:17:32,440
فستعيش تلك الذكرى
من جديد مع إحساس خوفك

241
00:17:42,910 --> 00:17:45,490
!تينجو تينغا يوغادوكسون

242
00:17:47,450 --> 00:17:48,580
ماذا؟

243
00:17:48,700 --> 00:17:50,000
ما الذي في رأسي؟

244
00:17:50,120 --> 00:17:53,210
أيمكن أنّ شاكا إعادة
...تجسّدٍ لبوذا حقّاً

245
00:17:53,330 --> 00:17:54,590
أو إلهاً؟

246
00:18:04,050 --> 00:18:05,720
لا أستطيع الحراك

247
00:18:07,600 --> 00:18:11,190
نيرو، فلتختر واحداً من عوالم الوجود الستّة

248
00:18:11,310 --> 00:18:12,730
التي سأريك إيّاها

249
00:18:12,850 --> 00:18:15,980
العالم الذي ستختاره سيكون مسكنك الأبديّ

250
00:18:16,560 --> 00:18:18,530
ريكودو ريني

251
00:18:22,360 --> 00:18:23,950
...ريكودو ريني

252
00:18:24,070 --> 00:18:26,870
مسارات تناسخ الأرواح الستّة

253
00:18:26,990 --> 00:18:29,290
،بناءً على قوانين الكارما

254
00:18:29,410 --> 00:18:33,170
فسيُرسل البشر عبر إحدى هذه المسارات

255
00:18:33,980 --> 00:18:36,290
عالم الملعونين

256
00:18:36,420 --> 00:18:39,210
،بحرٌ من النار، جبلٌ من الإبر

257
00:18:39,340 --> 00:18:40,760
رعبٌ لا متناهٍ

258
00:18:40,880 --> 00:18:45,340
،من يذهبون هنا يسقطون للأبد
متعصّرين ألماً

259
00:18:46,600 --> 00:18:49,100
عالم الجوع

260
00:18:49,220 --> 00:18:52,270
سيبلى جسدك حتّى يصبح جلداً وعظاماً

261
00:18:52,390 --> 00:18:55,980
وستصبح معدتك منتفخةً ومتضخّمة

262
00:18:56,110 --> 00:18:59,570
سيقودك الجوع للاقتيات
على الجيف للأبد

263
00:19:01,030 --> 00:19:02,700
عالم الوحوش

264
00:19:02,820 --> 00:19:05,740
عالمٌ حيث يأكل فيه القويّ الضعيف

265
00:19:05,870 --> 00:19:09,080
إن أردت قتل خصمك، تقتله

266
00:19:09,200 --> 00:19:12,370
إن أردت التهامه، تلتهمه

267
00:19:12,500 --> 00:19:14,290
عالمٌ وحشيّ

268
00:19:16,160 --> 00:19:17,960
عالم نصف الآلهة

269
00:19:18,090 --> 00:19:20,050
الدم والمذابح

270
00:19:20,170 --> 00:19:24,470
ستُجبر على القتال بلا راحةٍ للأبد

271
00:19:26,180 --> 00:19:28,180
...عالم البشر

272
00:19:28,300 --> 00:19:32,730
عالمٌ غير مستقرّ حيث سكّانه عبدةٌ للمشاعر

273
00:19:32,850 --> 00:19:37,190
عاجزون عن تكريس لأنفسهم
للخير أو الشرّ

274
00:19:38,480 --> 00:19:41,070
ختاماً، عالم السماء

275
00:19:41,190 --> 00:19:43,150
يُدعى بالجنّة

276
00:19:43,280 --> 00:19:45,910
لكن في أيّ لحظة، يمكن أن تتعثّر وتسقط

277
00:19:46,030 --> 00:19:51,370
إلى عوالم الوحوش، الجوع، أو الملعونين

278
00:19:56,960 --> 00:19:58,630
بما أنّك متّ الآن

279
00:19:58,750 --> 00:20:00,710
أين سقطت يا نيرو؟

280
00:20:00,840 --> 00:20:04,260
،أتوقّع أنّك اخترت عالم الملعونين

281
00:20:04,380 --> 00:20:06,220
أو عالم نصف الآلهة

282
00:20:08,810 --> 00:20:10,180
نيرو

283
00:20:20,060 --> 00:20:22,070
انتهى كلّ شيء

284
00:20:22,190 --> 00:20:24,070
شاكا لا يُقهر

285
00:20:25,320 --> 00:20:28,070
اختفى نيرو العنقاء أخيراً

286
00:20:30,760 --> 00:20:33,080
مُحال

287
00:20:36,620 --> 00:20:38,460
كان ذلك وشيكاً

288
00:20:45,970 --> 00:20:47,930
!شبح العنقاء

289
00:20:53,260 --> 00:20:54,100
!نيرو

290
00:20:56,060 --> 00:20:59,650
أيمكن أن يكون خالداً حقّاً، مثل العنقاء؟

291
00:20:59,770 --> 00:21:03,650
أرسلتك مسارات تناسخ الأرواح
الستّة إلى الجحيم

292
00:21:03,770 --> 00:21:05,440
ولا تزال حيّاً مع ذلك

293
00:21:06,860 --> 00:21:10,200
رأوني كثير المشاكل، فطردوني

294
00:21:10,320 --> 00:21:11,370
ماذا؟

295
00:21:11,490 --> 00:21:14,030
عشتُ ومتّ في قاع الجحيم

296
00:21:14,160 --> 00:21:17,450
هجماتك النفسيّة عديمة النفع ضدّي

297
00:21:17,580 --> 00:21:22,290
،مهما كان الجحيم الذي أريتني إيّاه
فقد سبق ورأيتُه

298
00:21:22,420 --> 00:21:24,670
حان دورك الآن