1
00:00:00,000 --> 00:00:03,250
يُقال أنّ خلال كلّ
بضعة مئات الأعوام

2
00:00:03,370 --> 00:00:06,500
تُبعث الآلهة أثينا

3
00:00:06,630 --> 00:00:10,420
والآن وُلِدت أثينا جديدة
في هذا العالم

4
00:00:10,550 --> 00:00:15,720
لكن هذه المرّة، تحت ظلّ نبوءة
سوداء بقيادتها للبشريّة للهلاك

5
00:00:15,840 --> 00:00:20,350
عُرف المحاربون الذين دافعوا
عن الآلهة أثينا بالفرسان

6
00:00:20,470 --> 00:00:25,520
اليوم، يتحكّم جيلٍ جديد من الفرسان
بمصير العالم

7
00:00:25,650 --> 00:00:29,230
يُدعون بفرسان الأبراج

8
00:02:00,030 --> 00:02:02,660
..."سابقاً في "سينت سيا

9
00:02:03,330 --> 00:02:07,000
!القرنان العظيمان

10
00:02:13,800 --> 00:02:18,970
،مرحباً بكما لمتاهة الجوزاء
التي يستحيل أن تهربا منها

11
00:02:24,010 --> 00:02:28,800
جزيرة آندروميدا

12
00:02:35,280 --> 00:02:38,950
أفرودايت، فارس الحوت الذهبيّ

13
00:02:39,070 --> 00:02:40,660
كنتُ بانتظارك

14
00:02:42,530 --> 00:02:46,370
تتأمّل بالتركيز على شعلةٍ بسيطة

15
00:02:46,500 --> 00:02:51,290
،أنت رجلٌ قديم الأساليب يا ديدليس
فارس الملتهب الفضّي

16
00:02:51,420 --> 00:02:53,670
لا ضير من التمرّن يوميّاً

17
00:02:53,790 --> 00:02:55,670
ما الذي حلّ بتلامذتك؟

18
00:02:55,800 --> 00:02:57,800
ألست هنا لقتلي؟

19
00:02:59,930 --> 00:03:01,680
أرسلتهم بعيداً إذاً

20
00:03:01,800 --> 00:03:05,810
،فشلت في إظهار نفسك
رغم استدعائك مراراً وتكراراً

21
00:03:05,930 --> 00:03:08,430
السيّد العظيم مُستاء

22
00:03:08,560 --> 00:03:10,520
أفرودايت

23
00:03:10,640 --> 00:03:15,360
لمَ لا يستطيع شخصٌ مثلك
التمييز بين الخير والشرّ؟

24
00:03:15,480 --> 00:03:19,950
كلّ ما يهمّ هو امتلاك شيءٍ
للأناقة من عدمه

25
00:03:26,450 --> 00:03:28,700
محض لعب أطفال

26
00:03:36,130 --> 00:03:37,710
قطعةٌ خشبيّة

27
00:03:37,840 --> 00:03:41,380
مهارة ديدليس كحرفيّ
عاليةٌ كما يُقال عنها

28
00:03:41,510 --> 00:03:43,590
تمكّنت حيلته الصغيرة من خداعي حتّى

29
00:03:51,520 --> 00:03:54,600
لم يكن ذلك عملي الوحيد

30
00:03:54,730 --> 00:03:58,400
بنيتُ حجر الظلام هذه بأسرها

31
00:03:58,530 --> 00:04:01,150
حتّى أنت لن تستطيع إيجادي أبداً

32
00:04:01,280 --> 00:04:02,360
مُبهر

33
00:04:02,490 --> 00:04:04,740
تكاد تكاد تكون بمستوى فارس ذهبيّ

34
00:04:05,370 --> 00:04:06,370
تكاد

35
00:04:14,670 --> 00:04:16,380
،أعرف أنّ الأفضليّة ضدّي

36
00:04:16,500 --> 00:04:18,500
لكنّي سأبذل قصارى جهدي

37
00:04:18,630 --> 00:04:20,010
سأهزمك

38
00:04:20,130 --> 00:04:23,220
أثنيك على عزيمتك يا ديدليس

39
00:04:24,300 --> 00:04:27,680
لكن في النهاية، أنت لا تزال
مجرّد فارسٍ فضّي

40
00:04:27,800 --> 00:04:29,930
أنت تقلّل من شأني

41
00:04:59,090 --> 00:05:03,340
!مطرقة هدم سيفيس

42
00:05:08,010 --> 00:05:10,470
مُحال

43
00:05:10,600 --> 00:05:12,930
صددتها بوردة؟

44
00:05:13,060 --> 00:05:13,980
صحيح

45
00:05:14,100 --> 00:05:17,150
قوّة الفارس الفضّي سيفيس عظيمةٌ

46
00:05:17,270 --> 00:05:20,270
بحيث أجبرتني على التراجع خطوة

47
00:05:22,280 --> 00:05:24,900
لكن، فات الأوان

48
00:05:25,030 --> 00:05:26,950
تمّ تسميمك

49
00:05:27,070 --> 00:05:27,910
ماذا؟

50
00:05:28,030 --> 00:05:30,870
برائحة وردتي المميتة

51
00:05:42,920 --> 00:05:45,170
!وردة الشيطان الملكيّة

52
00:05:53,640 --> 00:05:56,350
،السيّد العظيم شخصيّةٌ جليلة

53
00:05:56,480 --> 00:05:58,770
لكن لديه أشواكه أيضاً

54
00:05:58,900 --> 00:06:02,520
لذا، أناقته كأناقة الورد

55
00:06:02,650 --> 00:06:06,820
الرجل القويم يسلك طريقاً قويماً

56
00:06:07,740 --> 00:06:12,410
سيأتي شخص يتبع خطاي بالتأكيد

57
00:06:12,530 --> 00:06:16,000
،ديدليس، لعلّك تمتلك مخالب سرعوف

58
00:06:16,120 --> 00:06:18,500
لكنّك تفتقر للأناقة والجمال

59
00:06:18,620 --> 00:06:22,380
...سيُنير الفرسان البرونزيّون الدرب

60
00:06:22,500 --> 00:06:24,500
للأمل الحقيقيّ

61
00:06:24,630 --> 00:06:28,340
الأمل الحقيقيّ هو ما قادك لحتفك

62
00:06:40,230 --> 00:06:42,270
!معلّم ديدليس

63
00:06:43,060 --> 00:06:44,270
!معلّم! أأنت بخير؟

64
00:06:44,400 --> 00:06:46,530
!معلّم! معلّم

65
00:06:48,110 --> 00:06:49,030
معلّم؟

66
00:06:49,150 --> 00:06:50,530
جينيت؟

67
00:06:51,280 --> 00:06:52,870
لمَ رجعتِ؟

68
00:06:52,990 --> 00:06:55,540
الكوزمو خاصّتك، ا-اختفت

69
00:06:55,660 --> 00:06:59,370
جينيت، فات الأوان لي

70
00:06:59,500 --> 00:07:01,750
من... من قام بهذا لك؟

71
00:07:01,880 --> 00:07:03,500
كنت تعرف حصول هذا، أليس كذلك؟

72
00:07:03,630 --> 00:07:05,880
ألذا أمرتني بالمغادرة؟

73
00:07:08,050 --> 00:07:11,970
يملك السيّد العظيم سرّاً

74
00:07:12,840 --> 00:07:14,260
...اذهبي إلى

75
00:07:14,390 --> 00:07:15,510
تلّ النجم

76
00:07:15,640 --> 00:07:17,430
!لا، لا، لا

77
00:07:17,560 --> 00:07:19,020
!لا يمكنك أن تموت هكذا

78
00:07:19,140 --> 00:07:20,770
!أحتاجك لأن تعلّمني

79
00:07:20,890 --> 00:07:22,940
!لا يا معلّمي، لا تمت رجاءً

80
00:07:26,150 --> 00:07:27,730
...يسرّني

81
00:07:29,150 --> 00:07:30,950
...أنكِ كبرتِ لتصبحي

82
00:07:32,030 --> 00:07:33,780
إنسانةً صالحة

83
00:07:35,660 --> 00:07:37,790
أنا فخورٌ بكِ

84
00:07:45,460 --> 00:07:46,420
معلّم؟

85
00:07:48,920 --> 00:07:50,170
!معلّم

86
00:08:02,230 --> 00:08:03,900
تأخّرت كثيراً

87
00:08:08,360 --> 00:08:09,860
ابتعدي

88
00:08:14,110 --> 00:08:17,830
يُفترض أنّك تعرفين ضرورة معرفة
الخصم قبل مهاجمته

89
00:08:17,950 --> 00:08:19,200
من أنتِ؟

90
00:08:19,330 --> 00:08:22,460
لطالما كان ديدليس صارماً في الآداب

91
00:08:22,580 --> 00:08:24,080
ألم يعلّمكِ أيّاً منها؟

92
00:08:24,830 --> 00:08:28,290
اسمي جينيت، فارسة الحرباء البرونزيّة

93
00:08:28,420 --> 00:08:30,380
ومن تكونين؟

94
00:08:30,510 --> 00:08:32,090
أنا مارين

95
00:08:32,220 --> 00:08:34,880
فارسة النسر الفضّية مارين؟

96
00:08:44,980 --> 00:08:46,940
لا أفهم ما الذي حصل

97
00:08:47,060 --> 00:08:50,320
منعني المعلّم ديدليس من الدخول، أرسلني بعيداً

98
00:08:50,440 --> 00:08:52,360
تعرفين ما يجري، أليس كذلك؟

99
00:08:54,650 --> 00:08:57,450
ما الذي تخفينه؟
ما الذي تريدينه منّي؟

100
00:08:57,570 --> 00:08:59,490
!قولي شيئاً

101
00:09:01,240 --> 00:09:06,080
.حسناً، أعرف شيئاً واحداً
أعرف بالتحديد متى بدأ كلّ هذا

102
00:09:08,540 --> 00:09:11,590
حروب المجرّات؟ ما تلك؟

103
00:09:11,710 --> 00:09:13,880
بطولة قتاليّة للفرسان البرونزيّين الجدد

104
00:09:14,010 --> 00:09:16,180
الذين تمّ تمرينهم
من قِبل معلّمين مختارين

105
00:09:16,300 --> 00:09:18,340
أرسلها شخصٌ عزيزٌ عليّ

106
00:09:18,470 --> 00:09:20,180
هذه الدعوة شرفٌ كبير

107
00:09:20,310 --> 00:09:23,930
لكن ألن يكون الانضمام لبطولة قتاليّة
قتالاً لدوافع شخصيّة؟

108
00:09:24,060 --> 00:09:25,480
ذلك محظورٌ علينا

109
00:09:25,600 --> 00:09:27,060
بالفعل يا جينيت

110
00:09:29,060 --> 00:09:33,570
آندروميدا شون، أريدكِ أن تشاركي
في حروب المجرّات

111
00:09:35,700 --> 00:09:39,240
لكن معلّمي ديدليس، سامحني على قول هذا

112
00:09:39,370 --> 00:09:41,700
لا-لا أشعر برغبةٍ بالذهاب

113
00:09:41,830 --> 00:09:43,450
كما أنّ جينيت مُحقّة

114
00:09:43,580 --> 00:09:46,040
...إذا كانت البطولة محظورة، فأنا آسفةٌ حقّاً، لكنّي

115
00:09:46,160 --> 00:09:47,790
معلّم، أريد الذهاب

116
00:09:47,920 --> 00:09:49,290
كلا يا جينيت

117
00:09:49,420 --> 00:09:50,670
شون من عليها الذهاب

118
00:09:50,790 --> 00:09:52,710
لكن لمَ هي؟

119
00:09:54,880 --> 00:09:57,510
شون، إن ذهبتِ فستفهمين

120
00:10:01,140 --> 00:10:02,260
معلّم

121
00:10:11,650 --> 00:10:14,860
لم أفهم ما الذي كان يدور
ببال المعلّم ديدليس

122
00:10:14,980 --> 00:10:16,690
كنتُ أعرف أنّه يخبّئ شيئاً

123
00:10:17,650 --> 00:10:18,820
أحترم معلّمي

124
00:10:18,950 --> 00:10:21,620
لكن لا أستطيع فهم لمَ
قد يخفي شيئاً عنّي

125
00:10:21,740 --> 00:10:23,790
كان بمثابة الأب لي

126
00:10:24,370 --> 00:10:25,790
ووثقتُ به

127
00:10:27,000 --> 00:10:29,250
اختار المعلّم شون عليّ

128
00:10:29,370 --> 00:10:32,130
بدايةً، لم أستطع قبول الأمر

129
00:10:32,250 --> 00:10:35,800
لكنّي تعلّمت التعايش معه الآن

130
00:10:49,850 --> 00:10:51,600
آكسيا"؟"

131
00:10:51,730 --> 00:10:54,070
المصطلح الإغريقيّ لـ "مهمّ"؟

132
00:10:54,190 --> 00:10:55,940
لكن لمَ قد يقولون ذلك؟

133
00:10:56,070 --> 00:10:58,240
يبدو أنّ للجميع آراءً

134
00:11:01,700 --> 00:11:03,870
أبى المعلّم ديدليس إخبارنا بشيء

135
00:11:03,990 --> 00:11:06,740
"والآن تكتب سلاسلكِ "آكسيا

136
00:11:07,290 --> 00:11:09,710
،مع كرهي بالاعتراف بذلك

137
00:11:09,830 --> 00:11:12,130
إلّا إنّي أعتقد أنّ هذا
شيءٌ عليكِ فعله حقّاً

138
00:11:13,840 --> 00:11:16,130
...لكن -
ابتهجي يا فتاة -

139
00:11:16,250 --> 00:11:18,300
إنّه اجتماعٌ لأجدد الفرسان البرونزيّين

140
00:11:18,420 --> 00:11:20,840
ذلك يعني أنّ من المحتمل
تواجد أخيك نيرو أيضاً

141
00:11:21,890 --> 00:11:24,550
قال المعلّم ديدليس أنّ عليكِ الذهاب

142
00:11:24,680 --> 00:11:26,560
كان جازماً بالأمر

143
00:11:26,680 --> 00:11:29,230
،أتمنّى لو اختارني المعلّم ديدليس

144
00:11:29,350 --> 00:11:31,020
لكنّي أثق بكِ كليّاً يا شون

145
00:11:39,400 --> 00:11:40,780
كنتُ سعيدةً لها

146
00:11:41,450 --> 00:11:44,280
أردتها أن تفوز بالبطولة

147
00:11:44,410 --> 00:11:46,780
أردتها أن تجد أخيها مُجدّداً

148
00:11:46,910 --> 00:11:49,910
ما أردتُه حقّاً كان فرصةً للذهاب معها

149
00:11:50,040 --> 00:11:53,830
لكن كان للمعلّم ديدليس
خططٌ أخرى لسوء الحظّ

150
00:11:53,960 --> 00:11:55,290
...جينيت

151
00:11:55,420 --> 00:11:57,750
عليكِ أيضاً مغادرة الجزيرة

152
00:11:57,880 --> 00:12:01,050
ماذا؟ -
عليكِ المغادرة وعدم العودة أبداً -

153
00:12:01,170 --> 00:12:04,140
.لحظة، لحظة، لحظة
معلّم ديدليس، أقمتُ بشيءٍ خاطئ؟

154
00:12:04,260 --> 00:12:05,390
أتطردني؟

155
00:12:10,480 --> 00:12:11,980
الوداع يا جينيت

156
00:12:18,940 --> 00:12:22,650
،شعرتُ باختفاء كوزمو المعلّم ديدليس
وعدتُ من فوري

157
00:12:22,780 --> 00:12:23,860
لكن كان الأوان قد فات

158
00:12:23,990 --> 00:12:25,910
ما الذي يجري يا مارين؟

159
00:12:27,870 --> 00:12:30,160
!قولي شيئاً رجاءً

160
00:12:31,290 --> 00:12:33,250
اهتمّ ديدليس بكِ حقّاً

161
00:12:33,370 --> 00:12:34,420
ماذا؟

162
00:12:34,540 --> 00:12:37,170
لم يردكِ أن تعلقي في هذه التعاسة

163
00:12:37,290 --> 00:12:38,880
التعاسة؟

164
00:12:39,000 --> 00:12:40,510
أتقصدين حروب المجرّات؟

165
00:12:40,630 --> 00:12:45,680
أرسلت أثينا توجيهاتاً لحشد
حلفاء للقتال ضدّ الملجأ

166
00:12:45,800 --> 00:12:48,890
كان ذلك الغرض الحقيقيّ من حروب المجرّات

167
00:12:49,010 --> 00:12:51,640
وقف ديدليس بصفّ أثينا

168
00:12:51,770 --> 00:12:54,770
لذا أرسل الملجأ قاتلاً لقتله

169
00:12:55,770 --> 00:12:57,520
أترين تلك؟

170
00:12:58,150 --> 00:13:00,780
العلامة المميّزة لأفرودايت الحوت

171
00:13:00,900 --> 00:13:02,070
الفارس الذهبيّ؟

172
00:13:02,190 --> 00:13:04,530
لمَ قد يقتل فارسٌ ذهبي معلّمي؟

173
00:13:04,650 --> 00:13:06,660
لذا علمت بمقتلك

174
00:13:07,200 --> 00:13:08,320
...لهذا

175
00:13:08,450 --> 00:13:10,790
لذا أبعدني المعلّم

176
00:13:10,910 --> 00:13:13,250
أتذكرين أيّ شيءٍ آخر
قاله ديدليس؟

177
00:13:14,000 --> 00:13:15,290
قبل مماته؟

178
00:13:15,420 --> 00:13:18,170
"قال "اذهبي لتلّ النجم

179
00:13:19,630 --> 00:13:20,960
ثمّ بدأت

180
00:13:21,090 --> 00:13:22,340
ما معنى ذلك؟

181
00:13:22,460 --> 00:13:24,590
معركةٌ ستهزّ العالم

182
00:13:24,720 --> 00:13:25,720
...ما الذي

183
00:13:27,340 --> 00:13:28,640
مهلاً

184
00:13:28,760 --> 00:13:30,100
!ماري، انتظري

185
00:13:30,220 --> 00:13:32,060
لا يمكنكِ اتّباعي حيث أذهب

186
00:13:32,180 --> 00:13:34,390
!لا يمكنك إيقافي، سأذهب أيضاً

187
00:13:34,520 --> 00:13:36,560
ستُقتلين

188
00:13:46,150 --> 00:13:48,070
أنا متأهّبةٌ للمخاطرة بحياتي

189
00:13:50,330 --> 00:13:51,330
تعالي إذاً

190
00:13:51,870 --> 00:13:53,660
سنذهب لتلّ النجم

191
00:14:00,290 --> 00:14:02,420
اُغتيل المعلّم ديدليس

192
00:14:02,550 --> 00:14:05,970
وشون مُشتبكة في معركة
مميتة في الملجأ

193
00:14:06,090 --> 00:14:08,510
سأتكفّل بأيٍّ من كان
الذي قتل معلّمنا

194
00:14:08,630 --> 00:14:11,350
وسآتي لمساعدكِ يا شون، أينما كنتِ

195
00:14:12,010 --> 00:14:15,100
حتّى حينها، لا تموتي

196
00:14:17,640 --> 00:14:19,650
فارس الجوزاء الذهبيّ

197
00:14:19,770 --> 00:14:23,400
الكوزمو خاصّته مختلفةٌ تماماً
عن بقيّة الفرسان الذهبيّين

198
00:14:25,530 --> 00:14:28,820
سلاسلي لا تستجيب أبداً

199
00:14:28,950 --> 00:14:30,200
من هذا؟

200
00:14:30,320 --> 00:14:31,910
كأنّه شبح

201
00:14:32,030 --> 00:14:34,910
لم يسبق وأن رأيتُ سلاسلي
تستجيب هكذا من قبل

202
00:14:35,040 --> 00:14:36,620
حسناً، إنّه لا يقوم بمهاجمتنا

203
00:14:36,750 --> 00:14:37,790
يبدو ذلك

204
00:14:37,910 --> 00:14:40,670
يُقال أنّ أفضل دفاع هو الهجوم الجيّد

205
00:14:40,790 --> 00:14:44,250
،كلا، إذا لم يرد الهجوم
فربما يمكننا التفاهم معه

206
00:14:44,380 --> 00:14:46,010
لا تكوني تبلك السذاجة

207
00:14:46,130 --> 00:14:48,670
اسمعي، بقينا في هذه المتاهة لوقتٍ طويل

208
00:14:48,800 --> 00:14:51,590
عقلكِ الشريف يودي بتأثير
معاكس علينا أحياناً

209
00:14:51,720 --> 00:14:52,720
...ماغنس

210
00:14:52,850 --> 00:14:53,890
!لا! انتظر

211
00:14:54,010 --> 00:14:56,060
!الغبار الألماسيّ

212
00:15:04,400 --> 00:15:08,240
صدّ هجومك دون الحراك حتّى

213
00:15:10,990 --> 00:15:13,120
لا شيء بعد

214
00:15:13,240 --> 00:15:15,120
ما الذي سنفعله الآن؟

215
00:15:17,120 --> 00:15:18,750
دعني أتولّى هذا

216
00:15:19,540 --> 00:15:21,250
!فارس الجوزاء الذهبيّ

217
00:15:21,370 --> 00:15:23,250
نحن لا نريد قتالك

218
00:15:25,630 --> 00:15:27,630
فارس الحمل الذهبيّ
وفارس الثور الذهبيّ

219
00:15:27,760 --> 00:15:30,800
فهما نوايانا وقبلا عرضنا

220
00:15:30,930 --> 00:15:36,060
أعرف أنّك فارسٌ يشاركهما
هدفهما بإنقاذ أثينا

221
00:15:36,180 --> 00:15:38,930
لذا اسمح لنا بالمرور رجاءً

222
00:15:42,270 --> 00:15:43,400
انسي الأمر يا شون

223
00:15:43,520 --> 00:15:45,020
إنّه لا يصغي

224
00:15:45,650 --> 00:15:49,360
أرجوك، دعنا نعبر في سلام
يا فارس الجوزاء الذهبيّ

225
00:15:52,990 --> 00:15:56,120
،اسمعي، هناك وقتٌ للتفاوض والمساومة

226
00:15:56,240 --> 00:15:59,870
وهناك وقتٌ تحتاجين فيه
لقبضتيكِ لصنع فارق

227
00:16:00,000 --> 00:16:01,370
...لكن -
ألا تفهمين؟ -

228
00:16:01,500 --> 00:16:03,500
لن نمرّ من هنا دون إراقة دماء

229
00:16:03,620 --> 00:16:06,290
نحن نهدر وقتنا بمحاولة التفاهم معه

230
00:16:06,420 --> 00:16:08,170
لكنّي أحاول تفادي قتال

231
00:16:08,300 --> 00:16:10,630
لا أظنّ ذلك مُمكناً يا شون

232
00:16:10,760 --> 00:16:13,050
إنّه لا يستجيب لنا البتّة

233
00:16:14,430 --> 00:16:16,720
كيف سنخرج من هنا إذاً؟

234
00:16:16,850 --> 00:16:19,600
لا تقلقي، لا تزال لديّ بطاقة رابحة

235
00:16:19,720 --> 00:16:21,810
!طر أيّها الإوزّ

236
00:16:21,930 --> 00:16:24,770
!زوبعة هولودني

237
00:16:27,820 --> 00:16:30,070
،غباري الألماسيّ ثلجيّ وساكن

238
00:16:30,190 --> 00:16:33,820
لكنّ زوبعة هولودني هذه حركيّةٌ وقويّة

239
00:16:34,820 --> 00:16:36,120
!ماغنس، حاذر

240
00:16:54,630 --> 00:16:55,550
فارسٌ ذهبيّ

241
00:16:55,680 --> 00:16:56,470
أين؟

242
00:16:56,590 --> 00:16:58,640
إنّه أمامنا مباشرةً

243
00:16:58,760 --> 00:17:01,640
لا بدّ أنّك حارس منزل الجوزاء

244
00:17:01,770 --> 00:17:02,850
فلتسمع

245
00:17:02,980 --> 00:17:05,100
،يمكن أن نكون لطيفين، وتفسح لنا الطريق

246
00:17:05,230 --> 00:17:08,230
،أو يمكن أن نكون قاسيين
وسأبرحك ضرباَ بقبضتيّ

247
00:17:08,360 --> 00:17:10,900
أيّاً كان خيارك، سنتجاوز هذا المعبد

248
00:17:11,030 --> 00:17:12,650
هنالك أمرٌ ليس في محلّه

249
00:17:12,780 --> 00:17:16,660
،يُفترض أن أستطيع الإحساس به
،أشعر بتواجده

250
00:17:20,790 --> 00:17:23,410
...ريو سي كين الفرس

251
00:17:23,540 --> 00:17:25,040
لونغ، ما الذي تفعله؟

252
00:17:25,160 --> 00:17:27,540
سينتهي بك المطاف
بمقاتلة نفسك وحسب

253
00:17:27,670 --> 00:17:29,710
فارس الجوزاء الذهبيّ ليس هنا

254
00:17:29,840 --> 00:17:31,170
إنّه أمامنا مباشرةً

255
00:17:31,300 --> 00:17:32,590
لا يمكنك رؤيته؟

256
00:17:33,840 --> 00:17:36,220
إن وقفنا هنا وحسب، سنهلك

257
00:17:36,340 --> 00:17:37,760
سيا، ثق بي

258
00:17:37,890 --> 00:17:40,180
أستشعر كوزمو عدوّ

259
00:17:40,300 --> 00:17:42,770
لكنّها قادمةٌ من مكانٍ آخر

260
00:17:42,890 --> 00:17:43,680
ماذا؟

261
00:17:43,810 --> 00:17:45,690
ويمكنني رؤية المخرج

262
00:17:45,810 --> 00:17:47,400
يمكنك رؤية المخرج؟

263
00:17:47,520 --> 00:17:48,940
أين، وكيف؟

264
00:17:49,060 --> 00:17:50,690
ثق بي، وتمسّك

265
00:17:50,820 --> 00:17:52,900
لونغ، ما الذي تفعله؟

266
00:17:55,030 --> 00:17:56,400
!أنت تتجه صوبه مباشرةً

267
00:17:56,530 --> 00:17:57,780
هذا الطريق الوحيد

268
00:18:07,000 --> 00:18:08,580
أين نحن؟

269
00:18:12,380 --> 00:18:13,590
!عبرنا

270
00:18:13,710 --> 00:18:15,090
!نجح ذلك حقّاً

271
00:18:15,210 --> 00:18:19,050
سيا، لم أشعر بوجود فارس الجوزاء حقّاً

272
00:18:19,180 --> 00:18:23,310
،لكن بما أنّ بمقدورك رؤيته
وقعت ضحيّةً لوهم العدوّ

273
00:18:23,930 --> 00:18:26,730
أي كان الفارس الذهبيّ والمتاهة
محض حيلتين؟

274
00:18:26,850 --> 00:18:28,980
صنعهما أحدهم

275
00:18:29,100 --> 00:18:30,810
الكوزمو الشرّيرة التي شعرت بها؟

276
00:18:30,940 --> 00:18:32,360
أجل

277
00:18:32,480 --> 00:18:35,610
إنّها قويّةٌ إن كان بمقدورها
لوي الزمان والمكان

278
00:18:35,740 --> 00:18:39,700
النور والظلام يتّحدان معاً، مهاجمين أدمغتنا

279
00:18:39,820 --> 00:18:41,870
سيتعيّن علينا اكتشاف ذلك لاحقاً يا لوغن

280
00:18:41,990 --> 00:18:45,120
الآن، ماغنس وشون لا يزالان
في معبد الجوزاء

281
00:18:45,240 --> 00:18:46,040
يمكننا مساعدتهما

282
00:18:47,410 --> 00:18:50,250
تذكّر يا سيا، نحن أوّل من عبرا

283
00:18:50,370 --> 00:18:51,790
فعلينا مواصلة التقدّم

284
00:18:51,920 --> 00:18:54,000
حياة سينا على المحكّ

285
00:18:54,130 --> 00:18:56,760
أنا متأكّد أنّ ماغنس وشون سيتّفقان

286
00:18:57,300 --> 00:18:59,840
أجل، أنت مُحقّ

287
00:19:15,270 --> 00:19:16,150
ماغنس

288
00:19:16,280 --> 00:19:17,820
ماغنس، تماسك

289
00:19:28,290 --> 00:19:29,120
...سلاسلي

290
00:19:29,250 --> 00:19:31,250
!فلتصبحي النجوم

291
00:19:34,920 --> 00:19:38,050
أنا أحذّرك، إن خطوت
،خطوةً واحدة داخل هذا السديم

292
00:19:38,170 --> 00:19:41,220
فستصعقك شحنة كهربائيّة
!بقوّة 10 آلاف فولت

293
00:19:54,810 --> 00:19:56,650
!مستحيل

294
00:19:56,770 --> 00:19:58,900
سلاسلي لا تستجيب أبداً

295
00:19:59,030 --> 00:20:02,570
لا بدّ أنّ ذلك يعني أنّ هذه المتاهة
وفارس الجوزاء أوهام

296
00:20:06,080 --> 00:20:10,910
يُفترض أنّكِ مدركةٌ تماماً
أنّ هجماتك لن تفلح ضدّي

297
00:20:11,620 --> 00:20:15,000
فلتذوقي قوّة الفارس الذهبيّ
الحقيقيّة الآن

298
00:20:15,130 --> 00:20:18,000
!بعد آخر

299
00:20:26,970 --> 00:20:29,680
!ماغنس، أمسك بيدي

300
00:20:29,810 --> 00:20:31,980
!ماغنس، أفق

301
00:20:32,100 --> 00:20:33,850
!ماغنس

302
00:20:40,030 --> 00:20:41,690
...ما-ماذا

303
00:20:41,820 --> 00:20:43,650
أين ذهب ماغنس؟

304
00:20:45,320 --> 00:20:50,240
تملك سلاسل آندروميدا أقوى
غرائز دفاعيّة من بين كلّ الدروع

305
00:20:50,370 --> 00:20:52,040
أنتِ محظوظةٌ لإنقاذها لكِ

306
00:20:52,160 --> 00:20:55,460
وإلّا للقيتِ نفس مصير صديقك

307
00:20:55,580 --> 00:20:58,590
ضائعةً للأبد في بعد النفي

308
00:20:59,130 --> 00:21:02,630
عليك إعادته، وإلّا ستندم

309
00:21:02,760 --> 00:21:04,930
مصيره مختوم

310
00:21:05,050 --> 00:21:08,550
سيعوم الإوزة بلا أملٍ للأبد

311
00:21:08,680 --> 00:21:10,390
وكذلك أنتِ

312
00:21:11,350 --> 00:21:13,390
!بعد آخر

313
00:21:16,850 --> 00:21:18,440
!سلسلة السديم