1
00:00:00,000 --> 00:00:03,250
يُقال أنّ خلال كلّ
بضعة مئات الأعوام

2
00:00:03,370 --> 00:00:06,500
تُبعث الآلهة أثينا

3
00:00:06,630 --> 00:00:10,420
والآن وُلِدت أثينا جديدة
في هذا العالم

4
00:00:10,550 --> 00:00:15,720
لكن هذه المرّة، تحت ظلّ نبوءة
سوداء بقيادتها للبشريّة للهلاك

5
00:00:15,840 --> 00:00:20,350
عُرف المحاربون الذين دافعوا
عن الآلهة أثينا بالفرسان

6
00:00:20,470 --> 00:00:25,520
اليوم، يتحكّم جيلٍ جديد من الفرسان
بمصير العالم

7
00:00:25,650 --> 00:00:29,230
يُدعون بفرسان الأبراج

8
00:02:00,030 --> 00:02:02,780
..."سابقاً في "سينت سيا

9
00:02:02,910 --> 00:02:06,200
!جديه، أيّاً كان وأيّاً يكن

10
00:02:07,370 --> 00:02:09,880
!إعدام الشفق القطبيّ

11
00:02:13,340 --> 00:02:15,300
الوداع يا ماغنس

12
00:02:15,420 --> 00:02:18,300
نم للأبد

13
00:02:22,540 --> 00:02:25,080
أرض الموتى

14
00:02:41,630 --> 00:02:42,530
!لونغ

15
00:03:04,180 --> 00:03:06,930
تريدين معرفة ما إن كان لونغ بخير

16
00:03:07,720 --> 00:03:09,640
ترعرعتما معاً

17
00:03:09,770 --> 00:03:12,690
لا عجب أنّكِ قلقةٌ عليه

18
00:03:12,810 --> 00:03:14,650
راودني حلمٌ سيّئ

19
00:03:14,770 --> 00:03:16,900
كان لونغ يتعرّض للتعذيب وقُتل

20
00:03:17,030 --> 00:03:19,070
ما الذي حلّ به؟

21
00:03:20,240 --> 00:03:23,280
لونغ على وشك مواجهة
...فرسان السرطان الذهبيّ

22
00:03:24,200 --> 00:03:25,410
ديثماسك

23
00:03:25,530 --> 00:03:28,200
من حاول قتلك؟

24
00:03:28,330 --> 00:03:30,250
حتّى أنت عانيت في مقاومته

25
00:03:30,370 --> 00:03:33,040
كيف سيكون لونغ
قويّاً بما يكفي لهزيمته؟

26
00:03:33,170 --> 00:03:37,710
القوّة والضعف، النصر والهزيمة

27
00:03:37,840 --> 00:03:42,430
لا علاقة لهذه الأشياء بمجرى الطبيعة

28
00:03:42,550 --> 00:03:44,470
لا تقلقي يا شونري

29
00:03:44,590 --> 00:03:48,060
أنا متأكّدٌ أنّ لونغ
سيتجاوز هذا التحدّي

30
00:03:49,130 --> 00:03:50,980
آمل ذلك أيضاً

31
00:04:01,150 --> 00:04:03,820
سيا، أيمكنك رؤية الساعة؟

32
00:04:06,740 --> 00:04:08,200
!انطفأت الشعلة الثالثة

33
00:04:08,330 --> 00:04:10,080
مما يعني أنّ أمامنا 9 ساعات فحسب

34
00:04:10,200 --> 00:04:12,960
للوصول للسيّد العظيم وإنقاذ سينا

35
00:04:13,080 --> 00:04:14,420
!يمكننا فعلها

36
00:04:14,540 --> 00:04:16,210
يمكننا هزيمة كافة الفرسان الذهبيّين

37
00:04:16,330 --> 00:04:19,250
!إن وحّدنا عقولنا وقوانا معاً

38
00:04:25,720 --> 00:04:27,760
ستكونين بخيرٍ سيّدتي

39
00:04:27,890 --> 00:04:30,310
سينجح فرسانك البرونزيّون عمَّ قريب

40
00:04:30,430 --> 00:04:32,020
آمل ذلك

41
00:04:48,490 --> 00:04:50,950
وصلنا لمنزل السرطان

42
00:04:53,910 --> 00:04:55,870
لونغ، أهنالك خطبٌ ما؟

43
00:04:56,000 --> 00:04:58,880
أستشعر شيئاً غريباً حولنا

44
00:04:59,000 --> 00:05:00,710
ألا تشعر به يا سيا؟

45
00:05:02,130 --> 00:05:04,760
لستُ متأكّداً، لكنّي أشعر بقشعريرة

46
00:05:04,880 --> 00:05:06,470
مُخيف

47
00:05:06,590 --> 00:05:08,640
بربّك يا لونغ، لا تتصرّف بغرابة

48
00:05:08,760 --> 00:05:11,640
لا شيء يستدعي الخوف البتّة

49
00:05:20,110 --> 00:05:21,900
تفوح رائحة الموت هنا

50
00:05:22,030 --> 00:05:23,650
أسحب كلامي

51
00:05:23,780 --> 00:05:26,740
كلّ شيء هنا يستدعي الخوف

52
00:05:26,860 --> 00:05:28,740
هذا المكان مُريب من أوّله لآخره

53
00:05:29,740 --> 00:05:32,490
لحظة، دهستُ شيئاً غريباً

54
00:05:32,620 --> 00:05:34,160
ما ذلك؟

55
00:05:35,080 --> 00:05:36,040
ما هذا؟

56
00:05:36,160 --> 00:05:39,000
!إنّه وجه! وجهٌ بشريّ

57
00:05:40,040 --> 00:05:42,050
وليس واحداً فحسب

58
00:05:44,630 --> 00:05:48,180
يُفترض أن يكون الفرسان الذهبيّون
شريفين ومُحترمين

59
00:05:48,300 --> 00:05:50,720
من يحرس هذا المكان؟

60
00:05:52,460 --> 00:05:53,890
إنّه أنا

61
00:05:59,770 --> 00:06:01,400
أنالوا إعجابك؟

62
00:06:01,520 --> 00:06:03,070
إنّهم ضحاياي

63
00:06:03,190 --> 00:06:06,860
محكومٌ على أرواحهم بالتجوال
في العذاب الأبديّ

64
00:06:06,990 --> 00:06:10,200
أتسمع أنين الأرواح المفقودة؟

65
00:06:10,320 --> 00:06:12,490
يا للحن الجميل

66
00:06:12,620 --> 00:06:15,540
أبقيهم كدليلٍ على قوّتي وانتصاراتي

67
00:06:15,660 --> 00:06:18,790
!لذا لقبي ديثماسك

68
00:06:18,920 --> 00:06:23,170
أيّ عقلٍ مريض ومنحرف قد
يحتفظ بأوجه الناس كتحف؟

69
00:06:24,880 --> 00:06:26,260
أيّها الوحش

70
00:06:26,380 --> 00:06:27,800
ما الأمر يا سيا؟

71
00:06:27,920 --> 00:06:29,930
!يوجد أطفالٌ على الحائط

72
00:06:30,050 --> 00:06:32,350
لا تقول أنّك قتلت أولئك
الأطفال أيضاً، صحيح؟

73
00:06:32,470 --> 00:06:35,720
تقع أضرارٌ ملازمة في كلّ حرب

74
00:06:35,850 --> 00:06:37,680
!كانت حيوات بشر

75
00:06:37,810 --> 00:06:39,270
!كيف لك أن تكون بهذا التحجّر؟

76
00:06:42,520 --> 00:06:45,530
الفرسان البرونزيّون، يا لكم من أغرار

77
00:06:45,650 --> 00:06:49,570
،يقاتل الفارس الذهبيّ للعدالة
لا يسلب الأرواح البريئة

78
00:06:49,700 --> 00:06:52,320
لا تستحقّ أن تكون فارساً ذهبيّاً

79
00:06:52,450 --> 00:06:55,620
طريف، هذا ما قاله دوكو تماماً

80
00:06:55,740 --> 00:06:58,000
قُبيل مهاجمتي له

81
00:06:58,120 --> 00:06:59,920
ما الذي فعلته لمعلّمي؟

82
00:07:01,500 --> 00:07:06,050
كان الأوان قد آن لينهي أحدٌ
معاناة ذاك العجوز الكهل

83
00:07:07,050 --> 00:07:07,880
دراغون

84
00:07:08,010 --> 00:07:11,090
وجهك القويم يثير أعصابي

85
00:07:11,220 --> 00:07:13,470
مثل معلّمك العجوز

86
00:07:13,600 --> 00:07:17,180
سأستمتع بإضافتك لمجموعتي

87
00:07:17,310 --> 00:07:19,020
!لن يحصل ذلك يا وجه السرطان

88
00:07:19,140 --> 00:07:20,890
!كلّا يا سيا

89
00:07:21,020 --> 00:07:22,560
لونغ، لمَ؟

90
00:07:22,690 --> 00:07:24,650
لا أمانع إهانته لي

91
00:07:24,770 --> 00:07:27,400
لكن لا يمكنني مسامحته
على الإساءة لمعلّمي

92
00:07:27,530 --> 00:07:29,150
...لكن يا لونغ

93
00:07:29,280 --> 00:07:31,320
...دعني أواجهه يا سيا

94
00:07:31,910 --> 00:07:33,660
حسناً يا لونغ، أثق بك

95
00:07:33,780 --> 00:07:35,280
أين تخال نفسك ذاهباً؟

96
00:07:35,410 --> 00:07:36,490
!إنّه لك

97
00:07:37,330 --> 00:07:38,450
ديثماسك

98
00:07:38,580 --> 00:07:39,540
دراغون

99
00:07:39,660 --> 00:07:43,380
أقسم بأسماء كلّ الفرسان
الشرفاء بأنّي سأهزمك

100
00:07:43,500 --> 00:07:45,420
وأحرّر كلّ هذه الأرواح البريئة

101
00:07:45,540 --> 00:07:47,300
أنت تهدر وقتك

102
00:08:18,920 --> 00:08:22,250
أظنّني وجدت المكان المثاليّ لوجهك

103
00:08:30,090 --> 00:08:31,840
سديم الأرواح خاصّتي هو البوّابة

104
00:08:31,970 --> 00:08:35,180
التي تصعد عبرها
أرواح الموتى للسماء

105
00:08:35,300 --> 00:08:37,800
آن أوان أن تتذوّق ذلك

106
00:08:39,350 --> 00:08:41,930
كنتُ سأستعمل هذه على معلّمك

107
00:08:42,060 --> 00:08:47,020
لذا من الملائم أن أستعملها
على تلميذ دوكو المفضّل

108
00:08:47,150 --> 00:08:50,400
لإرسالك إلى أرض الموتى

109
00:08:50,530 --> 00:08:54,070
!خنق نوء نثرة العالم السفليّ

110
00:08:54,200 --> 00:08:57,200
ماذا؟ ما-ما هذا؟

111
00:09:06,830 --> 00:09:07,960
جميل

112
00:09:20,010 --> 00:09:21,310
عيناي

113
00:09:21,430 --> 00:09:23,140
يمكنني أن أرى

114
00:09:24,890 --> 00:09:26,060
أين أنا؟

115
00:09:27,100 --> 00:09:29,860
يبدو هذا المكان مألوفاً

116
00:09:29,980 --> 00:09:32,070
سبق وأن كنتُ هنا

117
00:09:33,150 --> 00:09:37,780
عندما توقّف قلبي عن النبض للحظات
في بطولة حروب المجرّات

118
00:09:44,800 --> 00:09:46,160
ما هذا؟

119
00:09:50,290 --> 00:09:52,170
أرض الموتى

120
00:09:52,800 --> 00:09:56,420
عليّ الخروج من هنا
والعودة لمنزل السرطان

121
00:09:57,880 --> 00:09:59,510
ماغنس

122
00:09:59,640 --> 00:10:03,680
!ماغنس

123
00:10:12,360 --> 00:10:14,730
!ماغنس! انتظر

124
00:10:16,780 --> 00:10:18,110
...لونغ

125
00:10:18,240 --> 00:10:20,120
عليك الاستدارة

126
00:10:20,950 --> 00:10:21,950
سينا؟

127
00:10:22,580 --> 00:10:26,580
إنّهم متوجّهون لفوهة الجحيم
التي لا عودة منها

128
00:10:26,700 --> 00:10:29,290
يمكنني إعادتك بالكوزمو خاصّتي

129
00:10:29,420 --> 00:10:31,710
ماذا عن ماغنس؟ ماذا عنكِ؟

130
00:10:31,840 --> 00:10:33,880
لا تقلق علينا

131
00:10:34,000 --> 00:10:35,510
لكن عليك الإسراع

132
00:10:35,630 --> 00:10:38,840
ارجع لمنزل السرطان فوراً

133
00:10:43,560 --> 00:10:44,850
مُحال

134
00:10:46,720 --> 00:10:47,890
كيف؟

135
00:10:50,100 --> 00:10:52,730
رجعت للحياة؟

136
00:10:56,480 --> 00:11:00,150
لا أعرف كيف هربت، لكنّك لن تستفيد شيئاً

137
00:11:00,280 --> 00:11:02,740
!سأرسلك للجحيم مباشرةً

138
00:11:02,870 --> 00:11:05,660
سبق وأن ذهبت، مرّتين

139
00:11:05,790 --> 00:11:07,870
أعتقد أنّ الموت لا يريدني

140
00:11:09,000 --> 00:11:11,460
حان دورك لتموت الآن

141
00:11:13,290 --> 00:11:16,460
!لوشان شينلونغ با

142
00:11:20,050 --> 00:11:20,840
ماذا؟

143
00:11:26,760 --> 00:11:30,730
،أشعلتُ الكوزمو خاصّتي لأقصاها
ولم تصبه حتّى

144
00:11:30,850 --> 00:11:32,600
سبق وأن أخبرتك

145
00:11:32,730 --> 00:11:36,360
هناك فارقٌ شاسع بين
الفرسان الذهبيّين والبرونزيّين

146
00:11:39,820 --> 00:11:43,740
فسيحميني درعي من كلّ هجماتك

147
00:11:47,200 --> 00:11:49,790
أحسن ذاك العجوز التافه بتمرينك

148
00:11:49,910 --> 00:11:51,750
من المؤسف أنّ الأمر كان بلا فائدة

149
00:11:51,870 --> 00:11:54,540
تهين معلّمي من جديد

150
00:11:57,960 --> 00:12:00,670
سأعيدك لأرض الموتى

151
00:12:00,800 --> 00:12:04,140
وهذه المرّة، بلا عودة

152
00:12:05,260 --> 00:12:08,810
!خنق نوء نثرة العالم السفليّ

153
00:12:08,930 --> 00:12:10,020
!تبّاً

154
00:12:16,690 --> 00:12:18,820
هل مات لونغ؟

155
00:12:18,940 --> 00:12:20,690
فات الأوان

156
00:12:21,490 --> 00:12:23,950
!لا! لا يزال لونغ حيّاً

157
00:12:24,070 --> 00:12:25,530
أشعر بذلك

158
00:12:25,660 --> 00:12:28,120
ما الذي تظنّين أنّكِ
تفعلينه يا شونري؟

159
00:12:28,240 --> 00:12:31,370
إنّه خافت، لكن يمكنني الوصول له

160
00:12:31,500 --> 00:12:33,120
وإعادته للحياة

161
00:12:33,250 --> 00:12:37,460
توخّي الحذر، ظلام الموت أشبه بدوّامة

162
00:12:37,590 --> 00:12:41,670
على المرء ألّا يقترب من الطرف
وإلّا سيفقد موضع قدمه

163
00:12:41,800 --> 00:12:45,050
لا أبالي، سأضحّي بحياتي
لو كان عليّ ذلك

164
00:12:45,180 --> 00:12:47,890
!لو ذلك ما تطلّبه الأمر لإنقاذ لونغ

165
00:13:01,530 --> 00:13:03,570
معلّم مو، أخبرتك

166
00:13:03,700 --> 00:13:06,740
أنّ الفرسان البرونزيّين لن يتجاوزا
المنازل الاثنتي عشرة أبداً

167
00:13:06,860 --> 00:13:07,820
هُزم الإوز

168
00:13:07,950 --> 00:13:11,910
وبالكاد عبرت الآندروميدا شون منزل الجوزاء

169
00:13:13,000 --> 00:13:16,250
لحظة، ما الذي قلته عن الآندروميدا شون؟

170
00:13:16,370 --> 00:13:18,080
من هاتين؟

171
00:13:20,380 --> 00:13:22,510
فارسة النسر الفضّية مارين

172
00:13:22,630 --> 00:13:26,010
ولا بدّ أنّكِ فارسة الحرباء البرونزيّة جينيت

173
00:13:26,930 --> 00:13:30,600
...ذلك إذاً يقتضي أنّ ديدليس المُلتهب قد

174
00:13:31,890 --> 00:13:35,390
كان الأوان قد فات عندما وصلتُه

175
00:13:35,520 --> 00:13:37,650
فات الأوان هنا أيضاً

176
00:13:39,690 --> 00:13:42,860
ما الغرض من قدومكما هنا إذاً؟

177
00:13:42,980 --> 00:13:46,360
،قبل مقتل المعلّم ديدليس
أخبرنا بالتوجّه لتلّ النجم

178
00:13:46,490 --> 00:13:50,910
تلّ النجم؟ ذلك المكان محظورٌ
على الجميع عدا السيّد العظيم

179
00:13:51,030 --> 00:13:53,790
لا يُسمح لأحد بالاقتراب منه حتّى

180
00:13:53,910 --> 00:13:56,660
مع ذلك، إنّه سبب قدومنا

181
00:14:01,040 --> 00:14:04,460
الفارس الذهبيّ مو، الفارس الذهبيّ آلديباران

182
00:14:04,590 --> 00:14:06,840
نستجديكما إعارتنا لقواكما

183
00:14:06,970 --> 00:14:10,800
!جنون! على الفارسة الفضّية معرفة مقامها

184
00:14:11,600 --> 00:14:15,220
معلّم مو، سمعت أنّك تمرّنت
على يدّ السيّد العظيم

185
00:14:15,350 --> 00:14:17,350
رفقة معلّمي ديدليس

186
00:14:18,350 --> 00:14:22,480
علّمني المعلّم ديدليس تقدير
حسّنا بالعدالة قبل أيّ شيء

187
00:14:22,610 --> 00:14:24,530
واتّباع ذاك الحسّ في أفعالنا

188
00:14:24,650 --> 00:14:26,400
أرجوك، يمكنني أن أشعر به

189
00:14:26,530 --> 00:14:30,570
،إن كنّا سنبقى على الدرب الصحيح
فعلينا الذهاب لتلّ النجم

190
00:14:33,030 --> 00:14:36,290
الآندروميدا شون تخاطر
بحياتها في القتال الآن

191
00:14:36,410 --> 00:14:38,580
كفارسة، أودّ فعل الأمر نفسه

192
00:14:43,040 --> 00:14:47,550
،حماس الفرسان الشبّان مُفاجئ دوماً
أليس كذلك يا آلديباران؟

193
00:14:47,670 --> 00:14:48,590
مو

194
00:14:48,720 --> 00:14:50,680
...لا تفكّر حقّاً بأن

195
00:14:50,800 --> 00:14:53,970
كان ديدليس يمتلك مهارات استثنائية كحرفيّ

196
00:14:54,100 --> 00:14:55,390
،إن اكتشف دليلاً

197
00:14:55,520 --> 00:14:59,890
فقد يكون المفتاح لحلّ اللغز
المحيط بالملجأ مؤخّراً

198
00:15:01,190 --> 00:15:02,270
لا بأس

199
00:15:02,400 --> 00:15:05,440
لكنّ الاقتراب من تلّ النجم
ليس بالأمر اليسير

200
00:15:05,570 --> 00:15:07,940
حتّى للفرسان الذهبيّين

201
00:15:08,070 --> 00:15:10,530
لا أضمن لكما نجاتكما من الرحلة

202
00:15:10,660 --> 00:15:12,070
شـ-شكراً لك

203
00:15:12,200 --> 00:15:15,700
كيكي، ابق هنا ووافني بالمستجدّات

204
00:15:15,830 --> 00:15:18,580
ستتركني لمجالسة الأطفال مجدّداً؟

205
00:15:18,700 --> 00:15:19,870
!لكن يمكنني مساعدتك

206
00:15:20,000 --> 00:15:23,330
سأكون أكثر فائدةً بالتأكيد
!من تلك الفارسة البرونزيّة

207
00:15:23,460 --> 00:15:24,380
ما الذي قلته؟

208
00:15:26,460 --> 00:15:28,840
!عندما أضع يدي عليك، ستلقى حتفك

209
00:15:30,140 --> 00:15:30,840
!ارجع هنا

210
00:15:30,970 --> 00:15:32,390
وقتنا ضيّق

211
00:15:32,510 --> 00:15:33,680
لنسرع

212
00:15:35,180 --> 00:15:37,640
اعتقدت أنّ مجموعة الفرسان
الجديدة هذا لا تتحلّى بالجرأة

213
00:15:37,770 --> 00:15:40,020
لكن لعلّي كنت مخطئاً

214
00:15:40,140 --> 00:15:41,980
أتطلّع لرؤية ما يمكنهم فعله

215
00:15:43,040 --> 00:15:44,230
كذلك أنا

216
00:15:44,360 --> 00:15:47,610
لذا علينا أن نريهم الدرب

217
00:15:50,220 --> 00:15:51,900
!انتظروا

218
00:15:53,200 --> 00:15:56,410
نحن على حافّة اضطرابٍ كبير

219
00:16:14,090 --> 00:16:16,260
لا يمكنني فعلها

220
00:16:16,390 --> 00:16:17,890
لمَ لا يمكنني فعلها؟

221
00:16:19,470 --> 00:16:21,680
لا داعي للتضايق أيّها الشاب

222
00:16:21,810 --> 00:16:23,350
،مُذ وصولك هنا

223
00:16:23,480 --> 00:16:26,150
عشت داخل قوقعة، لا تصغي أبداً

224
00:16:26,270 --> 00:16:27,820
ما الذي تقوله؟

225
00:16:27,940 --> 00:16:30,860
!لطالما أصغيتُ كي أغدو قويّاً

226
00:16:32,530 --> 00:16:34,570
يا لطفولتك

227
00:16:34,700 --> 00:16:36,030
لا أصغي؟

228
00:16:36,160 --> 00:16:38,620
!لطالما قمتُ بكلّ شيءٍ طلبته منّي

229
00:16:41,000 --> 00:16:44,370
تبّاً، ما المشكلة في أن ترغب
بأن تصبح قويّاً؟

230
00:16:44,500 --> 00:16:45,630
إنّها غلطته

231
00:16:45,750 --> 00:16:47,250
لا يعلّمني أيّ شيء

232
00:16:47,380 --> 00:16:48,170
لونغ

233
00:16:49,120 --> 00:16:50,760
شونري؟

234
00:16:50,880 --> 00:16:52,420
ارحلي، أحاول التفكير

235
00:16:52,550 --> 00:16:54,590
لا داعي لأن تكون بهذه القسوة

236
00:16:54,720 --> 00:16:56,840
ربما يمكننا أن نفكّر معاً

237
00:16:57,390 --> 00:16:58,180
ماذا؟

238
00:16:59,470 --> 00:17:01,140
تراني الآن

239
00:17:01,270 --> 00:17:03,560
دعيني وشأني، لا أحتاج لوجودكِ

240
00:17:05,020 --> 00:17:07,770
لا تفهمين شعور أن يكون المرء وحيداً

241
00:17:09,900 --> 00:17:11,690
أفهم

242
00:17:11,820 --> 00:17:13,860
فقد تمّ التخلّي عنّي
هنا عندما كنت رضيعة

243
00:17:14,900 --> 00:17:17,570
قام المعلّم دوكو بتربيتي

244
00:17:17,700 --> 00:17:19,410
...أي أنّكِ يتيمة

245
00:17:19,530 --> 00:17:21,080
مثلي

246
00:17:26,670 --> 00:17:29,340
تعال، أريد أن أريك شيئاً

247
00:17:32,920 --> 00:17:36,590
يبدو كلّ شيءٍ جميلاً من هنا، ألا تظنّ؟

248
00:17:36,720 --> 00:17:38,430
إنّه مكاني السرّي

249
00:17:38,550 --> 00:17:42,520
ما الذي دفعك للقدوم هنا
وأن تصبح قويّاً إذاً؟

250
00:17:42,640 --> 00:17:45,730
سأستطيع فعل أيّ ما أريد
إن أصبحتُ قويّاً

251
00:17:45,850 --> 00:17:47,440
هل سيُسعدك ذلك؟

252
00:17:48,770 --> 00:17:52,320
أنت والمعلّم دوكو وأنا معاً هنا

253
00:17:52,440 --> 00:17:54,030
ومع ذلك لست سعيداً؟

254
00:17:55,030 --> 00:17:57,660
حسناً... سعيداً؟

255
00:17:57,780 --> 00:18:01,160
أنا سعيدةٌ لتواجدي معك
ومع المعلّم دوكو

256
00:18:01,280 --> 00:18:03,240
لم أعد أشعر بالوحدة

257
00:18:06,160 --> 00:18:07,080
انظر

258
00:18:13,710 --> 00:18:16,590
يسرّني قدومك هنا حقّاً

259
00:18:21,180 --> 00:18:22,720
أنا أيضاً يا شونري

260
00:18:25,220 --> 00:18:27,980
تشعر بالوحدة هنا أحياناً

261
00:18:28,100 --> 00:18:31,110
حسناً، يمكننا أن نشعر
بالوحدة الآن معاً

262
00:18:41,490 --> 00:18:43,870
هنالك أمرٌ مختلفٌ فيك يا لونغ

263
00:18:48,910 --> 00:18:56,130
لونغ، فلتكن بأمان رجاءً

264
00:18:57,300 --> 00:19:08,980
فلتكن بأمان رجاءً

265
00:19:05,470 --> 00:19:06,720
شونري؟

266
00:19:10,060 --> 00:19:12,270
ما هذا؟ -
فلتكن بأمان رجاءً -

267
00:19:14,110 --> 00:19:16,530
كلّا، لا يُعقل -
فلتكن بأمان رجاءً -

268
00:19:16,650 --> 00:19:20,700
لا تخبرني أنّ لونغ سيرجع
من أرض الموتى من جديد؟

269
00:19:20,820 --> 00:19:24,120
سيتعيّن عليّ إلقاؤه
في فوهة الجحيم بنفسي

270
00:19:30,120 --> 00:19:31,120
ديثماسك؟

271
00:19:31,250 --> 00:19:32,750
كيف أنت هنا؟

272
00:19:32,880 --> 00:19:36,380
هذه أرضي، أذهب وأغادر كيفما أشاء

273
00:19:36,500 --> 00:19:37,510
!فلتنهض الآن

274
00:19:41,590 --> 00:19:45,640
سأسحبك للجحيم بيدي
لو تطلّب الأمر كذلك

275
00:19:54,400 --> 00:19:58,280
انظر، لا يمكنك الخروج هذه المرّة

276
00:19:58,920 --> 00:20:01,320
سألقيك في فوهة الجحيم

277
00:20:01,450 --> 00:20:04,820
حيث تلقى كافة
!الأرواح المفقودة نهايتها

278
00:20:04,950 --> 00:20:08,580
لا يمكن لأحدٍ العودة منها، حتّى أنا

279
00:20:08,700 --> 00:20:10,200
...فوهة الجحيم

280
00:20:10,330 --> 00:20:12,330
هذه النهاية إذاً

281
00:20:20,380 --> 00:20:22,430
انتهى الأمر يا دراغون

282
00:20:22,550 --> 00:20:24,640
لونغ، فلتكن بأمان رجاءً

283
00:20:24,760 --> 00:20:27,890
شونري، أهذه أنتِ؟ -
لونغ، فلتكن بأمان رجاءً -

284
00:20:28,010 --> 00:20:30,140
أتدعين عند الشلّال؟

285
00:20:30,270 --> 00:20:32,350
...ذاك الصوت المزعج -
فلتكن بأمان رجاءً -

286
00:20:32,480 --> 00:20:33,940
ما مصدره؟

287
00:20:39,360 --> 00:20:40,320
وجدتكِ

288
00:20:40,440 --> 00:20:43,650
هي من كانت تزعجني إذاً؟

289
00:20:46,280 --> 00:20:48,740
ما-ما الذي يحصل لي؟

290
00:20:48,870 --> 00:20:50,200
لا، لا

291
00:20:50,330 --> 00:20:52,430
!لا

292
00:20:58,340 --> 00:21:02,090
لا بدّ أنّها أحبّتك حقّاً حتّى
تصل دعواتها لهذا الحدّ

293
00:21:02,210 --> 00:21:05,510
لا تقلق، سيلتمّ شملكما قريباً

294
00:21:05,630 --> 00:21:07,510
!في الجحيم

295
00:21:12,060 --> 00:21:14,140
!يدي! إنّها تحترق

296
00:21:20,380 --> 00:21:21,940
ديثماسك

297
00:21:22,070 --> 00:21:25,030
آذيتَ الشخص الوحيد الذي أحببتُه قطّ

298
00:21:26,410 --> 00:21:29,330
!لن أبدي لك أيّ رحمة