1
00:00:00,600 --> 00:00:03,850
يُقال أنّ خلال كلّ
بضعة مئات الأعوام

2
00:00:03,970 --> 00:00:07,100
تُبعث الآلهة أثينا

3
00:00:07,230 --> 00:00:11,020
والآن وُلِدت أثينا جديدة
في هذا العالم

4
00:00:11,150 --> 00:00:16,320
لكن هذه المرّة، تحت ظلّ نبوءة
سوداء بقيادتها للبشريّة للهلاك

5
00:00:16,440 --> 00:00:20,950
عُرف المحاربون الذين دافعوا
عن الآلهة أثينا بالفرسان

6
00:00:21,070 --> 00:00:26,120
اليوم، يتحكّم جيلٍ جديد من الفرسان
بمصير العالم

7
00:00:26,250 --> 00:00:29,830
يُدعون بفرسان الأبراج

8
00:02:00,130 --> 00:02:02,760
..."سابقاً في "سينت سيا

9
00:02:02,880 --> 00:02:04,890
!سأربطهم هنا، فلتذهبا

10
00:02:07,430 --> 00:02:10,180
سأختبر قلبيكما الآن

11
00:02:12,850 --> 00:02:14,020
!لونغ

12
00:02:14,730 --> 00:02:15,520
أنت تُسلّيني

13
00:02:15,650 --> 00:02:18,360
!معركتنا ليست عرضاً لتسليتك

14
00:02:21,320 --> 00:02:24,600
انعكاسات

15
00:02:28,620 --> 00:02:31,250
سأختبر روحك تالياً

16
00:02:31,370 --> 00:02:35,080
!لا وقت للألعاب! لننهِ هذا

17
00:02:35,210 --> 00:02:37,840
!ريو سي كين الفرس المجنّح

18
00:02:42,340 --> 00:02:45,300
لا تجيد سوى الكلام، وكان اختبارك أضحوكة

19
00:02:47,430 --> 00:02:49,760
آمل أنّ شون ولونغ بخير

20
00:02:57,770 --> 00:02:59,650
أضحوكة إذاً؟

21
00:02:59,780 --> 00:03:02,780
لم تتجاوز اختباري بعد

22
00:03:12,500 --> 00:03:13,460
...ما

23
00:03:18,460 --> 00:03:19,800
!حسناً إذاً

24
00:03:19,920 --> 00:03:20,710
!هات ما لديك

25
00:03:20,840 --> 00:03:23,380
!ريو سي كين الفرس المجنّح

26
00:03:25,880 --> 00:03:27,340
تبّاً

27
00:03:31,810 --> 00:03:33,770
أيّها الأحمق

28
00:03:37,350 --> 00:03:39,480
عليّ اختراق دفاعاته

29
00:03:42,230 --> 00:03:43,490
!هنا

30
00:03:56,160 --> 00:03:58,750
استسلم أيّها الفارس الصغير

31
00:03:58,880 --> 00:04:00,210
!لن يحصل ذلك

32
00:04:00,340 --> 00:04:02,840
!ريو سي كين الفرس المجنّح

33
00:04:05,220 --> 00:04:06,220
!نلتُ منك

34
00:04:30,490 --> 00:04:32,740
ضعيفٌ جدّاً

35
00:04:32,870 --> 00:04:35,620
لمَ قد تخال أنّ بإمكانك إنقاذ أثينا؟

36
00:04:38,920 --> 00:04:43,460
!مقارنةً بفارس الثور الذهبيّ، هجومك لا يُذكر

37
00:04:43,590 --> 00:04:44,880
...إذاً

38
00:04:45,010 --> 00:04:46,510
تودّ مواصلة القتال

39
00:04:47,880 --> 00:04:49,260
!الآن فرصتي

40
00:04:49,380 --> 00:04:50,470
ماذا؟

41
00:04:54,600 --> 00:04:56,640
أنت أسوأ مما ظننتُ حتّى

42
00:04:56,770 --> 00:04:58,100
مثير للشفقة

43
00:04:58,230 --> 00:04:59,940
اضحك أيّها الأحمق

44
00:05:05,940 --> 00:05:07,860
لا جدوى أيّها الصبيّ

45
00:05:07,990 --> 00:05:09,570
!لا أظنّ ذلك

46
00:05:14,080 --> 00:05:14,870
ماذا؟

47
00:05:14,990 --> 00:05:16,620
!خذ هذه

48
00:05:18,000 --> 00:05:21,080
!اصطدام الفرس المجنّح المتدحرج

49
00:05:31,430 --> 00:05:32,680
مثيرٌ للاهتمام

50
00:05:33,890 --> 00:05:38,270
قوّتك وشجاعتك ومخيّلتك استثنائيّة

51
00:05:39,350 --> 00:05:41,020
نجحت في الامتحان

52
00:05:44,440 --> 00:05:45,860
!شون! لونغ

53
00:05:48,610 --> 00:05:50,240
أأنتما بخير؟

54
00:05:53,200 --> 00:05:54,570
نجحتما الاثنان

55
00:06:01,710 --> 00:06:03,330
معبد العذراء

56
00:06:03,460 --> 00:06:04,750
هيّا بنا

57
00:06:41,250 --> 00:06:44,370
!تبّاً! لا يملك أحد وقتاً للفرسان البرونزيّين

58
00:06:58,390 --> 00:06:59,810
تلّ النجم

59
00:06:59,930 --> 00:07:03,020
فقط الأسياد العظماء المُتعاقبون

60
00:07:03,140 --> 00:07:05,810
وضيوفهم المدعوّون يُسمح لهم بالزيارة

61
00:07:13,190 --> 00:07:14,780
لا داعي لتنتظروني

62
00:07:14,900 --> 00:07:17,570
أنا عدّاءة جيّدة، حتّى لو لم يبد عليّ ذلك

63
00:07:19,700 --> 00:07:24,080
أعني، ستقولون على الأرجح أنّ ليس
،على الفارسة البرونزيّة ذلك وما شابه

64
00:07:24,210 --> 00:07:27,670
لكنّي قطعتُ كلّ هذا الطريق دون تذمّر

65
00:07:27,790 --> 00:07:29,460
ألم أخبركِ؟

66
00:07:29,590 --> 00:07:31,960
الفارس البرونزيّ هكذا عديم الجدوى

67
00:07:32,090 --> 00:07:34,840
انظروا لها، تلهث من ذاك العدو القصير فحسب

68
00:07:34,970 --> 00:07:36,470
لمَ أنت هنا؟

69
00:07:37,510 --> 00:07:41,770
كيكي، أخبرتك بالبقاء والتبليغ
عن حالة أثينا

70
00:07:41,890 --> 00:07:43,180
لا تقلق يا معلّم مو

71
00:07:43,310 --> 00:07:45,640
يمكّنني استبصاري من رؤيتها
من أيّ مكان

72
00:07:45,770 --> 00:07:49,150
كما أنّ ذاك الرجل الأصلع
أكثر قدرةً مما تصوّرت

73
00:07:49,270 --> 00:07:50,900
لم أقصد ذلك

74
00:07:51,020 --> 00:07:55,700
عصيت الأوامر يا كيكي، تخلّين عن مسؤوليّاتك

75
00:07:57,110 --> 00:07:58,780
لا يمكننا إهدار الوقت بالحديث

76
00:07:58,910 --> 00:08:00,910
سيتعيّن علينا أخذه معنا وحسب

77
00:08:01,030 --> 00:08:02,370
!فكرةٌ ممتازة يا مارين

78
00:08:02,490 --> 00:08:04,080
أتتوقّف عن الكلام قطّ؟

79
00:08:06,460 --> 00:08:07,370
مارين مُحقّة

80
00:08:07,500 --> 00:08:09,000
لا وقت لدينا

81
00:08:09,130 --> 00:08:10,210
شكراً لك يا معلّم مو

82
00:08:10,340 --> 00:08:14,010
ماذا؟! لا تفكّر بأخذه معنا حقّاً، صحيح؟

83
00:08:16,300 --> 00:08:19,510
حسناً، يُفترض بنا التسلّق للأعلى، أليس كذلك؟

84
00:08:19,640 --> 00:08:22,850
ائتمنني المعلّم ديدليس بطلبه الأخير

85
00:08:22,970 --> 00:08:24,140
بالذهاب لتلّ النجم

86
00:08:24,270 --> 00:08:27,440
!ائتمنني، لذا أفسح الطريق أيّها القصير

87
00:08:34,980 --> 00:08:37,150
!لا أحتاج للمساعدة، يمكنني القيام بالأمر بمفردي

88
00:08:49,620 --> 00:08:51,210
!ولا كلمة

89
00:08:51,330 --> 00:08:52,630
لم أقل شيئاً

90
00:08:53,420 --> 00:08:54,500
ما كان ذلك؟

91
00:08:54,630 --> 00:08:56,510
حاجز خفيّ أو ما شابه؟

92
00:08:56,630 --> 00:09:00,550
فقط من يمتلكون إذن السيّد العظيم
يمكنهم دخول تلّ النجم

93
00:09:00,680 --> 00:09:02,430
إنّه تدبيرٌ دفاعيّ بالطبع

94
00:09:02,550 --> 00:09:04,260
أجل

95
00:09:04,390 --> 00:09:07,810
يمكن دخول تلّ النجم
عبر المسار الصحيح فحسب

96
00:09:16,940 --> 00:09:18,240
!مرحباً

97
00:09:27,200 --> 00:09:28,450
أأنتِ قادمةٌ يا جينيت؟

98
00:09:29,580 --> 00:09:32,080
اصمت وحسب

99
00:09:32,210 --> 00:09:34,090
شكراً على إخباري أين أذهب يا أنا

100
00:09:34,210 --> 00:09:35,250
لا تذكري الأمر

101
00:09:35,380 --> 00:09:36,800
لن أفعل

102
00:09:45,850 --> 00:09:48,980
لم أتصوّر أن يكون
تلّ النجم هكذا أبداً

103
00:09:49,100 --> 00:09:51,520
أتيتُ هنا مع السيّد العظيم سيون

104
00:09:51,640 --> 00:09:53,610
يقود هذا الكهف للقمّة

105
00:09:54,810 --> 00:09:56,480
أعلى تلّ النجم

106
00:09:56,610 --> 00:10:00,360
أعتقد أنّنا سنجد شخصاً
يتحكّم بالملجأ سرّاً

107
00:10:02,820 --> 00:10:05,780
ما رأيكِ يا مرين؟ أتظنّينني مُحقّاً؟

108
00:10:06,740 --> 00:10:07,540
أجل

109
00:10:09,910 --> 00:10:11,500
لنذهب للرؤية إذاً

110
00:10:13,830 --> 00:10:15,130
!انتظروني

111
00:10:19,380 --> 00:10:21,220
مارين -
اسمعي يا جينيت -

112
00:10:21,340 --> 00:10:25,470
إن حصل شيءٌ ما لي، ائتمنكِ
على إرادتي، حسناً؟

113
00:10:25,600 --> 00:10:27,680
مارين، ما الذي تقولينه؟

114
00:10:27,810 --> 00:10:29,720
أنا أعتمد عليكِ

115
00:10:34,310 --> 00:10:35,810
...معلّم ديدليس

116
00:10:35,940 --> 00:10:37,860
ما الذي ينتظرنا هناك بالضبط؟

117
00:10:47,160 --> 00:10:49,410
أتى الوقت

118
00:11:16,440 --> 00:11:19,020
مرحباً؟ أيوجد أحدٌ هنا؟

119
00:11:19,150 --> 00:11:20,610
مارين؟

120
00:11:20,730 --> 00:11:23,320
حسناً، لا تكلّمني مارين بالأصل

121
00:11:23,440 --> 00:11:24,860
!مو؟

122
00:11:24,990 --> 00:11:26,110
!آلديباران

123
00:11:26,240 --> 00:11:28,070
هيّا، أين ذهبتم جميعاً؟

124
00:11:30,870 --> 00:11:32,290
إنّه أنت فحسب

125
00:11:32,410 --> 00:11:34,410
شكراً لكِ على الاستقبال الحارّ

126
00:11:34,540 --> 00:11:35,710
أتشعر بالخوف؟

127
00:11:35,830 --> 00:11:37,670
!ماذا؟ أنا؟ مستحيل

128
00:11:39,960 --> 00:11:41,000
!ماذا؟

129
00:11:41,550 --> 00:11:43,800
غادر الجميع وتركونا وراءهم

130
00:11:43,920 --> 00:11:46,760
أجل، ولمَ تركوني معك بالتحديد؟

131
00:11:46,880 --> 00:11:48,390
!مهلاً! هذه جملتي

132
00:11:52,640 --> 00:11:53,810
لا تبدأ التفكير بأنّي خائفة

133
00:11:53,930 --> 00:11:56,350
أنا أمسك بيدك لأنّك خائفٌ فحسب

134
00:11:56,480 --> 00:11:57,850
لستُ خائفاً البتّة

135
00:11:57,980 --> 00:11:59,730
!لا تحاولي تعليق الأمر بي

136
00:11:59,860 --> 00:12:01,360
!ا-اذهبي أنتِ أوّلاً

137
00:12:03,400 --> 00:12:05,110
أكرهك أشدّ الكره

138
00:12:15,290 --> 00:12:16,290
من هناك؟

139
00:12:19,420 --> 00:12:22,300
لعلّها مخيّلتي

140
00:12:55,410 --> 00:12:56,500
لستُ بمفردي

141
00:13:27,360 --> 00:13:30,660
يبدو أنّه توجد دفاعات داخل الجبل أيضاً

142
00:13:30,780 --> 00:13:35,120
لديك الكثير من الجرأة
بالتسلّل هنا بلا دعوة

143
00:13:35,240 --> 00:13:38,620
لم يخطر لي أن أواجه
نسخةً مزيّفة من نفسي أبداً

144
00:13:38,750 --> 00:13:39,960
!أنت المزيّف

145
00:13:40,080 --> 00:13:42,880
!قلبت ولاءك ضدّ الملجأ

146
00:13:43,000 --> 00:13:44,130
من أنت؟

147
00:13:44,250 --> 00:13:47,420
أنا الفارس الحمل الذهبيّ مو بالطبع

148
00:13:47,550 --> 00:13:48,670
تلك سخافة

149
00:13:48,800 --> 00:13:51,130
لمَ أتيت لتلّ النجم؟

150
00:13:51,260 --> 00:13:54,760
لمساعدة السيّد سيون، السيّد العظيم الحقيقيّ

151
00:13:54,890 --> 00:13:57,100
كيف تجرؤ؟

152
00:13:57,220 --> 00:13:59,730
أفعالك خيانة

153
00:14:03,150 --> 00:14:05,190
تشكّك بالسيّد العظيم

154
00:14:05,310 --> 00:14:08,570
تتسلّل للتلّ العظيم دون إذن

155
00:14:08,690 --> 00:14:10,860
أليست هذه الأفعال خيانة؟

156
00:14:12,490 --> 00:14:16,910
أعرف الشكّ بالسيّد سيون
الساكن في قلبك

157
00:14:17,030 --> 00:14:18,120
أأنا مخطئ؟

158
00:14:51,320 --> 00:14:53,400
...قتالٌ ضدّ نفسي

159
00:14:53,530 --> 00:14:55,160
يفترض أن تكون الكفّة متساوية

160
00:14:55,280 --> 00:14:57,410
فلمَ هو أقوى منّي؟

161
00:14:57,530 --> 00:14:59,870
ذلك بسبب الشكّ في قلبك

162
00:14:59,990 --> 00:15:03,920
،أنا كلّ شيءٍ أنت هو عليه
لكن لا شكّ لديّ

163
00:15:04,040 --> 00:15:06,420
هناك تكمن القوّة الحقيقيّة

164
00:15:06,540 --> 00:15:07,590
هراء

165
00:15:07,710 --> 00:15:09,590
!أنت الهراء

166
00:15:09,710 --> 00:15:12,420
تبالي كثيراً بآراء الآخرين

167
00:15:12,550 --> 00:15:15,680
يستحيل أن يصل شخصٌ مثلك للقوّة الحقيقيّة

168
00:15:15,800 --> 00:15:16,890
أنت مخطئ

169
00:15:17,010 --> 00:15:19,760
!سأريك القوّة الحقيقيّة

170
00:16:05,520 --> 00:16:07,230
أنت قويٌّ حقّاً

171
00:16:07,350 --> 00:16:09,440
لست سيّئاً بدورك

172
00:16:09,560 --> 00:16:10,730
بالنسبة لمزيّف

173
00:16:14,150 --> 00:16:17,320
خدعك مو لأذيّة السيّد العظيم

174
00:16:17,450 --> 00:16:19,160
ستدفع بحياتك مقابل ذلك

175
00:16:19,280 --> 00:16:20,620
هراء

176
00:16:20,740 --> 00:16:22,200
من أنت لتقول ذلك؟

177
00:16:22,330 --> 00:16:24,700
مدافعٌ عن هذا المعبد المُقدّس

178
00:16:24,830 --> 00:16:28,540
موجودٌ هنا لإيقاف الخونة أمثالك
الذين ينقلبون على السيّد العظيم

179
00:16:35,840 --> 00:16:37,300
مثيرٌ للشفقة

180
00:16:37,430 --> 00:16:40,640
سأضربك بما يكفي
حتّى تكتسب جرأةً

181
00:16:49,100 --> 00:16:50,350
!أيّها الوغد

182
00:17:02,030 --> 00:17:03,660
كان ذلك مُسليّاً

183
00:17:03,780 --> 00:17:05,290
لكن حان وقت إنهاء هذا

184
00:17:05,410 --> 00:17:06,870
القرنان العظيمان؟

185
00:17:07,530 --> 00:17:08,410
!فلتفعل

186
00:17:08,540 --> 00:17:09,420
!هات ما لديك

187
00:17:09,540 --> 00:17:11,040
أنت أوّلاً

188
00:17:11,170 --> 00:17:13,790
كلّا، فلتأخذ أنت الضربة الأولى

189
00:17:13,920 --> 00:17:16,510
لأنّك لن تحصل على فرصة ثانية

190
00:17:26,430 --> 00:17:33,020
!القرنان العظيمان

191
00:17:52,080 --> 00:17:53,000
!سيا

192
00:17:53,130 --> 00:17:54,840
أين سيا؟

193
00:17:56,960 --> 00:17:58,920
لمَ أنتِ هنا؟

194
00:17:59,050 --> 00:18:00,590
ما الذي تريدينه؟

195
00:18:24,990 --> 00:18:25,870
!ماذا؟

196
00:18:29,700 --> 00:18:31,870
حميت نفسك إذاً

197
00:18:32,000 --> 00:18:34,830
بدرع الجدار البلّوري المنيع

198
00:18:36,710 --> 00:18:38,710
أذلك كلّ ما تبقّى لديك؟

199
00:18:38,840 --> 00:18:41,630
لن تهزمني حركة دفاعيّة كتلك

200
00:18:48,310 --> 00:18:51,930
ولديك الوقاحة لتقول أنّك
تساعد السيّد سيون؟

201
00:18:59,480 --> 00:19:03,950
وُلِد الشكّ المُتأجّج في قلبي
من ولائي للسيّد العظيم سيون

202
00:19:04,070 --> 00:19:06,490
!لم أخن السيّد العظيم قطّ

203
00:19:07,620 --> 00:19:09,120
!الجدار البلّوري

204
00:19:16,670 --> 00:19:18,130
!اُحتجزت

205
00:19:18,880 --> 00:19:20,840
كنتَ مخطئاً

206
00:19:20,960 --> 00:19:24,300
لا يُستعمل الجدار البلّوري للدفاع فحسب

207
00:19:29,640 --> 00:19:30,770
!لا

208
00:19:55,710 --> 00:19:56,710
!أيّها الأحمق

209
00:19:57,880 --> 00:20:00,590
...تفتح منزل الثور

210
00:20:00,710 --> 00:20:02,710
!لمحض فرسان برونزيّين

211
00:20:03,670 --> 00:20:04,550
ماذا؟

212
00:20:04,670 --> 00:20:07,220
...أولئك الفرسان البرونزيّون

213
00:20:07,340 --> 00:20:09,930
هم مستقبل الملجأ

214
00:20:15,980 --> 00:20:18,850
فلتشهد غضب الثور الحقيقيّ الآن

215
00:20:18,980 --> 00:20:22,480
!القرنان العظيمان

216
00:20:37,870 --> 00:20:41,040
!لن توقف آلديباران الثور أبداً

217
00:20:49,090 --> 00:20:50,890
...مهلاً، هذه

218
00:20:53,890 --> 00:20:55,520
جزيرة آندروميدا؟

219
00:21:02,820 --> 00:21:04,400
مُحال

220
00:21:11,030 --> 00:21:12,160
ما الخطب؟

221
00:21:19,120 --> 00:21:21,380
كلّا، لا يمكن

222
00:21:21,500 --> 00:21:24,250
تفاجأتِ برؤيتي يا جينيت؟

223
00:21:26,590 --> 00:21:28,010
معلّم ديدليس؟