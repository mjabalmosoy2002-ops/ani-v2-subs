1
00:00:00,000 --> 00:00:03,290
يُقال أنّ خلال كلّ
بضعة مئات الأعوام

2
00:00:03,420 --> 00:00:06,250
تُبعث الآلهة أثينا

3
00:00:06,380 --> 00:00:10,460
والآن وُلِدت أثينا جديدة
في هذا العالم

4
00:00:10,590 --> 00:00:15,800
لكن هذه المرّة، تحت ظلّ نبوءة
سوداء بقيادتها للبشريّة للهلاك

5
00:00:15,930 --> 00:00:20,220
عُرف المحاربون الذين دافعوا
عن الآلهة أثينا بالفرسان

6
00:00:20,350 --> 00:00:25,650
اليوم، يتحكّم جيلٍ جديد من الفرسان
بمصير العالم

7
00:00:25,770 --> 00:00:29,230
يُدعون بفرسان الأبراج

8
00:02:00,030 --> 00:02:02,530
..."سابقاً في "سينت سيا

9
00:02:02,660 --> 00:02:05,830
الفرسان الذهبيّون أشدّ
قوّة مما قد يخطر لكم

10
00:02:05,950 --> 00:02:10,170
مصدر الكوزمو المُطلق هو... الحاسّة السابعة

11
00:02:10,290 --> 00:02:12,670
ليس مسموحاً لكم دخول منزل الثور

12
00:02:14,340 --> 00:02:19,890
إذا أردتم العبور، فعليكم هزيمتي

13
00:02:22,460 --> 00:02:25,160
الحاسّة السابعة

14
00:02:27,770 --> 00:02:29,060
رفاق؟

15
00:02:30,270 --> 00:02:31,650
لا بأس

16
00:02:31,770 --> 00:02:33,900
سأهزم هذا الفارس الذهبيّ بمفردي

17
00:02:34,020 --> 00:02:36,650
ستقودك شجاعتك هذه لمصرعك

18
00:02:40,240 --> 00:02:42,780
مذهل، قامت قبضة آلديباران بذلك؟

19
00:02:42,910 --> 00:02:44,160
لم أستطع رؤية شيء

20
00:02:44,280 --> 00:02:46,450
ارحل فوراً

21
00:02:46,580 --> 00:02:47,700
أنت تعترض طريقي

22
00:02:47,830 --> 00:02:49,960
!تنحَّ، وإلّا قف وقاتلني

23
00:02:50,080 --> 00:02:53,880
وكأنّي أحتاج لاتّخاذ وضعيّة قتاليّة
ضدّ فارس برونزيّ

24
00:02:54,000 --> 00:02:56,300
ماذا؟ -
فلتعرف مقامك -

25
00:02:56,420 --> 00:02:58,340
فأنت محض فارس برونزيّ

26
00:02:59,720 --> 00:03:01,470
لا تزال لا تفهم

27
00:03:04,180 --> 00:03:07,280
!ريو سي كين الفرس الأعظم

28
00:03:16,400 --> 00:03:18,150
...قوّته

29
00:03:18,280 --> 00:03:21,820
لم يسبق وأنّ صدّ أحدٌ
ريو سي كين الفرس الأعظم" خاصّتي"

30
00:03:25,740 --> 00:03:27,450
أنت قويّ

31
00:03:27,580 --> 00:03:31,210
لكن لمَ؟ لمَ تطيع السيّد العظيم؟

32
00:03:31,330 --> 00:03:33,580
انتبه لكلامك أيّها الطفل

33
00:03:33,710 --> 00:03:36,710
ليس لك التشكيك في قرار السيّد العظيم

34
00:03:37,590 --> 00:03:40,720
لا ترى الصورة الشاملة كما نفعل

35
00:03:49,730 --> 00:03:51,600
سيّدي آلديباران

36
00:03:51,730 --> 00:03:54,150
كيف صمودك أيّها الجنديّ؟

37
00:04:02,110 --> 00:04:03,530
هل يتحسّن حاله؟

38
00:04:03,660 --> 00:04:06,410
كلّا سيّدي، بل يتدهور

39
00:04:10,620 --> 00:04:12,870
ستكون بخيرٍ أيّها الجنديّ

40
00:04:25,470 --> 00:04:26,890
لن ينجو

41
00:04:28,640 --> 00:04:30,390
لا مفعول للدواء

42
00:04:30,520 --> 00:04:32,390
كان هكذا مُنذ أسبوعين

43
00:04:32,520 --> 00:04:34,230
لقد عانى بما يكفي

44
00:04:34,350 --> 00:04:36,650
لا أستطيع مشاهدته يعاني أكثر

45
00:04:36,770 --> 00:04:39,400
...أنا

46
00:04:40,030 --> 00:04:42,240
لا أريد الموت

47
00:04:44,280 --> 00:04:47,160
لا أريد أن أذهب للجحيم

48
00:04:51,790 --> 00:04:53,540
السيّد العظيم

49
00:05:00,000 --> 00:05:03,420
كوزيمودو، يؤسفني ألمك

50
00:05:03,550 --> 00:05:06,680
تعرف اسمي؟

51
00:05:06,800 --> 00:05:10,140
خدمتَ الملجأ لأعوام مديدة

52
00:05:10,260 --> 00:05:15,060
،ليس اسمك فحسب
أعرف تفانيك ولطفك

53
00:05:16,650 --> 00:05:18,730
أشعر بالشرف

54
00:05:19,940 --> 00:05:22,570
لا تخف يا كوزيمودو

55
00:05:22,690 --> 00:05:27,030
ستُجازى على ولاءك لأثينا وللملجأ

56
00:05:27,160 --> 00:05:30,700
بحياةٍ مليئة بالحبّ والأمان في الآخرة

57
00:05:31,370 --> 00:05:33,450
...أشعر بها

58
00:05:34,160 --> 00:05:37,210
إنّها مقدّسة

59
00:05:40,840 --> 00:05:42,420
شكراً لك يا كوزيمودو

60
00:05:43,300 --> 00:05:45,970
أدعو أن ترقد روحك في سلام

61
00:05:46,090 --> 00:05:50,720
وجه كوزيمودو، لم يعد معصوراً بالخوف

62
00:05:50,850 --> 00:05:52,720
يبدو مُسالماً جدّاً

63
00:05:52,850 --> 00:05:54,600
سيّدي، دعنا نتولّى أمره

64
00:05:54,720 --> 00:05:56,310
ليس عليك فعل هذا

65
00:05:56,430 --> 00:05:58,600
شكراً لكم، لكن بإمكاني تدبّر الأمر

66
00:05:58,730 --> 00:06:01,820
لنرثيه معاً جميعاً

67
00:06:02,730 --> 00:06:06,320
،تعتقد أنّ السيّد العظيم طاغيةٌ عديم المشاعر

68
00:06:06,440 --> 00:06:10,030
لكنّه يهتمّ بالبشريّة أكثر
مما قد تعرف أبداً

69
00:06:10,950 --> 00:06:13,740
إن كان السيّد العظيم مهتمّاً
،بالبشريّة لذاك الحدّ

70
00:06:13,870 --> 00:06:15,750
فلمَ هو متحضّرٌ لقتل سينا؟

71
00:06:15,870 --> 00:06:19,880
لم يكن قراراً اُتّخذ بسهولة أيّها الطفل

72
00:06:21,880 --> 00:06:24,750
بُعثت أثينا اليوم

73
00:06:24,880 --> 00:06:28,760
كانت اللحظة التي انتظرتها طيلة حياتي

74
00:06:28,880 --> 00:06:33,680
لأثينا، كنتُ متأهّباً للتضحيّة بكلّ شيء

75
00:06:34,560 --> 00:06:36,890
لكن لم تمضِ الأمور على ذاك المنوال

76
00:06:37,020 --> 00:06:40,650
عقدتُ طقساً قديماً هنا في الملجأ

77
00:06:40,770 --> 00:06:43,650
وشاركتُ اللحظة مع ساغا وآيولوس

78
00:06:43,770 --> 00:06:46,820
حملتُ أثينا فوق درع فوهة البركان

79
00:06:47,570 --> 00:06:49,650
لرؤية قدرها

80
00:06:49,780 --> 00:06:53,030
ذاك الدرع الذي يكشف المستقبل أيضاً

81
00:06:53,160 --> 00:06:57,910
تقول الأساطير أنّ ما يُعكس على الماء
سيحصل حتميّاً

82
00:06:58,040 --> 00:07:00,540
إنّها مرآة المستقبل بحقّ

83
00:07:00,670 --> 00:07:04,170
،للأسف، بعد الانتظار لمئات الأعوام

84
00:07:04,290 --> 00:07:06,550
لم تكن الرؤيا ما تمنّيناها

85
00:07:09,720 --> 00:07:13,220
!فلتشهدوا الآن قدر آلهتنا

86
00:07:22,230 --> 00:07:24,060
نخسر أمام بوسيدون؟

87
00:07:24,190 --> 00:07:26,270
ونخسر لهيديس

88
00:07:26,400 --> 00:07:28,110
ستتحوّل الأرض إلا ظلام

89
00:07:33,570 --> 00:07:35,660
لا تزيحوا بأنظاركم أيّها الفرسان

90
00:07:35,780 --> 00:07:38,950
هذا ما سيحصل إن وقفنا بجوار أثينا

91
00:07:39,080 --> 00:07:42,460
هكذا هي نهاية بني البشر إذاً؟

92
00:07:42,580 --> 00:07:45,290
اخترتُ تكريس حياتي لأثينا

93
00:07:45,420 --> 00:07:48,960
لكن... لا يمكنني قبول هذا

94
00:07:49,090 --> 00:07:51,590
هذا المستقبل الذي ينتظرنا

95
00:07:53,970 --> 00:07:59,310
،كانت مهمّتنا بسيطةٌ في الماضي
حماية أثينا لحماية البشريّة

96
00:08:00,180 --> 00:08:02,810
لكن لم تعد مهمّتنا بتلك البساطة

97
00:08:03,730 --> 00:08:08,860
،إذا سمحنا للنبوءة بالحصول
فسنضمن دمار البشريّة

98
00:08:08,980 --> 00:08:11,110
لذا وصلتُ لقراري

99
00:08:11,990 --> 00:08:14,860
سأقضي على آلهتنا، أثينا

100
00:08:16,370 --> 00:08:17,200
...لكنّ ذلك يعني

101
00:08:17,330 --> 00:08:22,460
أجل، نعارض الآلهة التي أقسمنا على خدمتها

102
00:08:24,080 --> 00:08:27,750
أدرك أنّ ذلك يخالف مبادئ الفرسان

103
00:08:27,880 --> 00:08:29,750
،بعد موت آلهتنا

104
00:08:29,880 --> 00:08:32,970
سأتحمّل مسؤوليّة أفعالنا الكاملة

105
00:08:33,090 --> 00:08:36,720
لن يضمن قتل أثينا السلام
على سطح الأرض

106
00:08:36,850 --> 00:08:41,350
سيهاجم بوسيدون وهيديس
وبقيّة الآلهة البشر

107
00:08:41,470 --> 00:08:44,350
لكنّي أعلن أنّي سأقاتل

108
00:08:44,480 --> 00:08:47,770
سأقاتل لحقّ البشريّة بالوجود

109
00:08:47,900 --> 00:08:50,110
لحرّيتنا على الأرض

110
00:08:50,230 --> 00:08:55,240
،أيّها الفرسان الذهبيّون، إذا أمكنكم
أتوسّل لكم للانضمام لي

111
00:08:55,360 --> 00:08:57,870
لا يمكنني القيام بهذا من تلقاء نفسي

112
00:09:05,000 --> 00:09:09,340
أيّها الفرسان، هل ستقاتلون بجواري
وتحفظون حرّية البشريّة؟

113
00:09:20,350 --> 00:09:23,600
لمستقبل البشريّة، يجب أن تموت أثينا

114
00:09:23,730 --> 00:09:25,310
لمَ لا نستطيع إنقاذ الاثنين؟

115
00:09:25,440 --> 00:09:27,900
لمَ لا نستطيع إنقاذ أثينا والبشريّة؟

116
00:09:28,020 --> 00:09:29,770
ذلك ليس قرارك

117
00:09:29,900 --> 00:09:32,110
بل قرار السيّد العظيم

118
00:09:32,230 --> 00:09:34,650
لا أبالي ما الذي يقوله السيّد العظيم

119
00:09:34,780 --> 00:09:37,360
!سأقاتل لإنقاذ أثينا والبشريّة

120
00:09:37,490 --> 00:09:38,870
!خذ هذه

121
00:09:38,990 --> 00:09:42,080
!القرنان العظيمان

122
00:09:47,670 --> 00:09:51,540
كأنّ... كل مفصل في جسدي قد خُلِع

123
00:09:51,670 --> 00:09:55,050
لم يخدمك السيّد مو بإصلاح درعك

124
00:09:55,170 --> 00:09:58,300
تطيل حمايته معاناتك لا أكثر

125
00:10:01,680 --> 00:10:03,810
سأبدي رحمةً الآن

126
00:10:03,930 --> 00:10:05,180
وأنهي ألمك

127
00:10:12,320 --> 00:10:15,070
إنّه يسحق عظام يديّ

128
00:10:15,190 --> 00:10:17,700
!ستكون هذه النقطة مقبرتك

129
00:10:33,040 --> 00:10:34,670
لا جدوى

130
00:10:34,800 --> 00:10:37,130
جسدي لا يستجيب

131
00:10:37,260 --> 00:10:39,430
أشعر بالشلل في كلّ مكان

132
00:10:39,550 --> 00:10:41,680
ظننتُ أنّ بإمكاني هزيمته

133
00:10:41,800 --> 00:10:43,180
لعلّي لستُ مستعداً

134
00:10:44,140 --> 00:10:45,680
أهكذا هو الموت؟

135
00:10:47,310 --> 00:10:51,060
إذا متّ الآن، فستموت سينا أيضاً

136
00:10:51,690 --> 00:10:53,400
لا يمكنني السماح بموت سينا

137
00:10:54,070 --> 00:10:56,400
لكن كيف أهزم آلديباران؟

138
00:10:56,530 --> 00:10:58,150
احرق الكوزمو خاصّتك

139
00:10:59,840 --> 00:11:00,610
مارين؟

140
00:11:00,740 --> 00:11:02,870
تذكّر تمرينك يا سيا

141
00:11:05,410 --> 00:11:10,710
يمكنك الأداء بشكلٍ أفضل
إن استعملت كافّة الكوزمو خاصّتك

142
00:11:10,830 --> 00:11:13,540
أنت والنجوم مخلوقون من نفس الذرّات

143
00:11:14,170 --> 00:11:15,340
،في البدء

144
00:11:15,460 --> 00:11:18,420
وُلِد كلّ شيءٍ في الكون
من الانفجار الكبير

145
00:11:19,220 --> 00:11:22,680
جسدك كونه المصغّر الخاصّ

146
00:11:22,800 --> 00:11:27,060
يمكن للفرسان الحقيقيّين توليد الطاقة
عبر إشعال الكوزمو خاصّتهم

147
00:11:27,180 --> 00:11:29,930
يمكنهم شطر الأرض وتحطيم النجوم

148
00:11:30,060 --> 00:11:33,190
سيا، احرق الكوزمو خاصّتك

149
00:11:33,810 --> 00:11:36,690
فجّر كونك الداخليّ

150
00:11:36,820 --> 00:11:41,070
ثمّ ستضرب هجماتك بقوّة النيازك

151
00:11:52,460 --> 00:11:54,960
حسناً، كان لا بدّ من ذلك

152
00:11:55,500 --> 00:11:57,960
وقت تولّي أمر بقيّة الخونة

153
00:12:05,890 --> 00:12:07,060
ما هذا؟

154
00:12:15,310 --> 00:12:16,440
!سيا

155
00:12:16,560 --> 00:12:19,360
!لم ينته هذا القتال يا آلديباران

156
00:12:19,480 --> 00:12:22,110
أنت تقف، هذا مذهل

157
00:12:22,240 --> 00:12:23,360
لديك الجرأة

158
00:12:23,490 --> 00:12:27,240
لكنّك لست قويّاً بما يكفي
لأظهر قبضتيّ حتّى

159
00:12:27,370 --> 00:12:28,490
حقّاً؟

160
00:12:28,620 --> 00:12:31,410
!ريو سي كين الفرس الأعظم

161
00:12:32,210 --> 00:12:33,710
قبضتك النيزكيّة البطيئة البائسة

162
00:12:33,830 --> 00:12:37,500
عديمة الفائدة ضدّ فارسٍ ذهبيّ
يمكنه الحركة بسرعة الضوء

163
00:12:40,380 --> 00:12:42,550
بينما يمكنني تفاديها وحسب؟

164
00:12:44,090 --> 00:12:47,510
ماذا؟ هذه ليست ريو سي كين

165
00:12:47,640 --> 00:12:49,140
انفجار كبير؟

166
00:12:58,900 --> 00:13:01,230
خلقت ضربته انفجاراً كبيراً

167
00:13:01,360 --> 00:13:05,150
أصبحت الكوزمو خاصّته أقوى
مع تدهور حواسه

168
00:13:05,280 --> 00:13:08,780
يستفيق سيا لأعلى مستويات الكوزمو

169
00:13:08,910 --> 00:13:11,660
المستوى الذي أتقنه
الفرسان الذهبيّون وحدهم

170
00:13:11,790 --> 00:13:13,540
الحاسّة السابعة

171
00:13:14,160 --> 00:13:16,790
جعلتك تظهر قبضتك يا آلديباران

172
00:13:16,920 --> 00:13:22,170
مجرّد تمكّنك من فضّ ذراعيّ
لا يعني أنّك وصلت مستواي

173
00:13:22,300 --> 00:13:23,420
!سأريك

174
00:13:23,550 --> 00:13:25,720
!سأحطّم قرنيك الذهبيّين الآن

175
00:13:25,840 --> 00:13:30,010
إن نجحت بمعجزةٍ ما، فسأعترف بالهزيمة

176
00:13:30,140 --> 00:13:32,020
!لكن لن يحصل ذلك

177
00:13:32,140 --> 00:13:35,850
!القرنان العظيمان

178
00:13:52,490 --> 00:13:55,870
أشعر بقوّةٍ أكبر تشعّ من كوزمو سيا

179
00:13:56,000 --> 00:13:59,210
إنّها تزداد قوّةً كلّما يسقط

180
00:13:59,330 --> 00:14:01,960
،إذا واصل النضج على هذا الحدّ

181
00:14:02,090 --> 00:14:04,630
فقد يصبح بقوّة الفرسان الذهبيّين

182
00:14:04,760 --> 00:14:07,550
قد يحدّد قدر الملجأ حتّى

183
00:14:07,680 --> 00:14:09,760
!لا يمكنني السماح بحصول ذلك

184
00:14:09,890 --> 00:14:13,390
إنّه خائنٌ تحدّى قرار السيّد العظيم

185
00:14:13,510 --> 00:14:15,640
!وقت موتك يا سيا

186
00:14:16,270 --> 00:14:19,270
!القرنان العظيمان

187
00:14:21,020 --> 00:14:23,230
!صـ-صددت القرنين العظيمين؟

188
00:14:24,480 --> 00:14:25,740
!مُحال

189
00:14:25,860 --> 00:14:28,070
!لا تمتلك تلك القوّة

190
00:14:40,420 --> 00:14:42,960
الكوزمو خاصّته تنضج بسرعة فائقة

191
00:14:43,090 --> 00:14:46,670
استفاقت الحاسّة السابعة داخله بالتأكيد

192
00:14:46,800 --> 00:14:50,640
لإيقاف القرنين العظيمين المتحرّكين
،بسرعة الضوء ولو جزئيّاً

193
00:14:50,760 --> 00:14:53,180
عليه التحرّك بسرعة الضوء

194
00:14:53,300 --> 00:14:56,770
!بدأ سيا بإتقان سرعة الضوء

195
00:14:58,270 --> 00:14:59,810
...هالة الضوء تلك

196
00:15:01,150 --> 00:15:03,650
!إنّه فرسٌ أعظم

197
00:15:03,770 --> 00:15:07,070
أستطيع رؤيتهما، القرنين العظيمين

198
00:15:07,190 --> 00:15:08,650
أعرف أين يتّجهان

199
00:15:08,780 --> 00:15:10,740
!يمكنني صدّهما الآن

200
00:15:23,120 --> 00:15:24,880
!واصل الحُلم أيّها الطفل

201
00:15:25,000 --> 00:15:27,090
!ستلقى حتفك الآن

202
00:15:27,210 --> 00:15:30,680
!القرنان العظيمان

203
00:15:53,280 --> 00:15:54,990
لا أصدّق

204
00:15:55,120 --> 00:15:57,120
صدّ قرناي العظيمان

205
00:15:57,240 --> 00:15:58,040
...ماذا

206
00:15:58,160 --> 00:16:01,290
!سيا والكوزمو خاصّته... اختفيا

207
00:16:10,260 --> 00:16:12,880
أأنت رجلٌ بما يكفي للاعتراف
بالهزيمة يا آلديباران؟

208
00:16:13,010 --> 00:16:15,470
أم عليّ كسر القرن الآخر؟

209
00:16:45,630 --> 00:16:47,750
ماذا؟ ما المضحك؟

210
00:16:47,880 --> 00:16:51,590
تغلّبت على هجومي الأقوى وقطعت قرني

211
00:16:51,710 --> 00:16:54,220
كما وعدتك، أعترف بالهزيمة

212
00:16:54,340 --> 00:16:56,050
ماذا؟ حقّاً؟

213
00:16:56,180 --> 00:16:58,350
يبقى الوعد وعداً

214
00:16:58,470 --> 00:17:02,060
لكن إذا ظننت أنّ الطريق أمامك
سيكون بتلك السهولة، فأنت مُخطئ

215
00:17:02,180 --> 00:17:06,270
تذكّر يا سيا، إيّاك والاستهانة بفارسٍ ذهبيّ

216
00:17:06,400 --> 00:17:08,440
حسناً، حسناً، أعرف

217
00:17:08,560 --> 00:17:11,400
أريتني مثالاً ممتازاً
لما يقدر عليه الفرسان الذهبيّون

218
00:17:11,530 --> 00:17:12,400
!سيا

219
00:17:14,610 --> 00:17:18,120
فلتذهب الآن، وسأسمح لأصدقائك بمرافقتك

220
00:17:18,240 --> 00:17:19,160
ماذا؟

221
00:17:19,280 --> 00:17:21,240
يمكنكم شكر سيا على ذلك

222
00:17:32,880 --> 00:17:35,800
آلديباران فارسٌ قويّ ونبيل

223
00:17:35,930 --> 00:17:38,260
لكنّه يؤمن بالسيّد العظيم

224
00:17:39,140 --> 00:17:41,640
اعتقدتُ أنّ السيّد العظيم شرّيرٌ حقير

225
00:17:41,760 --> 00:17:45,020
!يودّ قتل أثينا لنبوءة جنونيّة

226
00:17:45,140 --> 00:17:47,560
ما الذي يعرفه وأنا أجهله؟

227
00:17:48,980 --> 00:17:51,520
ها نحن، منزل الجوزاء

228
00:17:51,650 --> 00:17:55,150
ابقوا يقظين، لا نودّ أن نُباغت
هذه المرّة أيضاً

229
00:17:55,280 --> 00:17:58,490
غريب، لا تتفاعل سلاسلي

230
00:17:58,610 --> 00:18:00,910
لا أستشعر أيّ كوزمو
صادرة من الداخل

231
00:18:01,030 --> 00:18:02,910
حسناً، أيّاً كان ما ينتظرنا في الداخل

232
00:18:03,040 --> 00:18:05,790
سواءً كان جيّداً، سيّئاً، أو شديد السوء

233
00:18:05,910 --> 00:18:07,670
فسنكون مستعدّين لمجابهته

234
00:18:32,770 --> 00:18:34,110
!عبرنا

235
00:18:34,690 --> 00:18:36,820
لعلّ فارس الجوزاء الذهبيّ ليس موجوداً

236
00:18:36,940 --> 00:18:39,610
ما كان الذي شعرنا به في الداخل؟

237
00:18:39,740 --> 00:18:41,450
لم يكن طبيعيّاً

238
00:18:42,580 --> 00:18:43,580
لحظة، ماذا؟

239
00:18:47,460 --> 00:18:49,830
رجعنا لحيث دخلنا

240
00:18:49,960 --> 00:18:51,420
كيف يمكن هذا؟

241
00:18:51,540 --> 00:18:54,210
لا أدري، لا نملك وقتاً لاكتشاف ذلك

242
00:18:54,340 --> 00:18:55,340
!هيّا بنا

243
00:19:00,800 --> 00:19:02,800
مضى وقتٌ يا طويل آلديباران

244
00:19:02,930 --> 00:19:05,600
مو؟ صدقت

245
00:19:05,720 --> 00:19:08,060
هل أصلح ذاك القرن لك؟

246
00:19:10,690 --> 00:19:14,190
غلبني محض فارسٍ برونزيّ، أشعر بمنتهى الإحراج

247
00:19:14,320 --> 00:19:17,530
،رافقني. إن أردتَ تحطيمه بحقّ

248
00:19:17,650 --> 00:19:19,820
فسنكون واقفين على دمائه الآن

249
00:19:21,700 --> 00:19:25,200
منزل الجوزاء، لن يكون الأمر يسيراً عليهم

250
00:19:25,330 --> 00:19:27,830
ظننتُ أنّ حارس ذاك المنزل مفقود

251
00:19:27,950 --> 00:19:32,210
صحيح، اختفى فارس الجوزاء الذهبيّ
قبل عدّة عقود

252
00:19:32,330 --> 00:19:34,710
لكن يراودني شعورٌ سيّئ حيال هذا

253
00:19:34,840 --> 00:19:37,340
حتّى نحن نجهل ما الذي يواجهونه

254
00:19:39,090 --> 00:19:41,720
أودّ رؤية وجهها

255
00:19:50,730 --> 00:19:53,600
تبقّت لها 10 ساعات فحسب

256
00:19:59,030 --> 00:20:00,360
ها هو مُجدّداً

257
00:20:00,490 --> 00:20:01,900
أشعر به أيضاً

258
00:20:02,030 --> 00:20:04,740
كأنّ الظلام والنور يلاحقننا معاً

259
00:20:04,870 --> 00:20:07,740
ربما فارس الجوزاء الذهبيّ
موجودٌ في النهاية

260
00:20:12,790 --> 00:20:13,750
!عبرنا

261
00:20:16,380 --> 00:20:18,750
!رجعنا لنفس المكان من جديد

262
00:20:18,880 --> 00:20:20,340
لا أظنّ ذلك

263
00:20:20,460 --> 00:20:22,970
ليس نفس المكان تماماً

264
00:20:25,390 --> 00:20:27,760
كيف يوجد معبدان؟

265
00:20:27,890 --> 00:20:30,060
على هذا النحو، سنركض في دوائر

266
00:20:30,180 --> 00:20:32,180
حتّى تُطفأ كلّ الشعلات

267
00:20:32,310 --> 00:20:34,690
لا بدّ أنّ قوّةً ما تحاول إيقافنا

268
00:20:34,810 --> 00:20:36,270
علينا العبور

269
00:20:36,400 --> 00:20:37,940
لننفصل لفريقين

270
00:20:38,070 --> 00:20:40,190
سأسلك وشون المعبد على اليمين

271
00:20:40,320 --> 00:20:42,820
ولونغ وسيا، ادخلا المعبد يساراً

272
00:20:42,950 --> 00:20:46,200
إذا عبر أيّ فريق، فسيتوجّه للمعبد التالي

273
00:20:46,320 --> 00:20:50,200
مهما يحصل، سنصل لحجرة السيّد العظيم

274
00:20:50,330 --> 00:20:53,160
حتّى لو تبقّى واحدٌ منّا
!فحسب في نهاية المطاف

275
00:20:56,460 --> 00:20:58,130
هذا غريب يا ماغنس

276
00:20:58,250 --> 00:21:00,460
لا نصل هذه المرّة للطرف الآخر حتّى

277
00:21:00,590 --> 00:21:02,380
أشعر أنّنا نركض في مكاننا

278
00:21:02,510 --> 00:21:04,380
كنتُ أفكّر بالأمر نفسه

279
00:21:04,510 --> 00:21:07,300
آمل أنّ حظّ سيا ولونغ أفضل منّا

280
00:21:07,430 --> 00:21:10,310
عليكما القلق على نفسيكما

281
00:21:10,430 --> 00:21:11,810
ماذا؟

282
00:21:11,930 --> 00:21:14,440
دخلتما إلى هلاككما

283
00:21:14,560 --> 00:21:20,070
،مرحباً بكما لمتاهة الجوزاء
التي يستحيل أن تهربا منها

284
00:21:21,690 --> 00:21:23,860
ماغنس، من ذلك؟

285
00:21:23,990 --> 00:21:28,120
إنّه هو، حارس منزل الجوزاء