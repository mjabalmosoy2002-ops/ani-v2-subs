1
00:00:00,000 --> 00:00:03,250
يُقال أنّ خلال كلّ
بضعة مئات الأعوام

2
00:00:03,370 --> 00:00:06,500
تُبعث الآلهة أثينا

3
00:00:06,630 --> 00:00:10,420
والآن وُلِدت أثينا جديدة
في هذا العالم

4
00:00:10,550 --> 00:00:15,720
لكن هذه المرّة، تحت ظلّ نبوءة
سوداء بقيادتها للبشريّة للهلاك

5
00:00:15,840 --> 00:00:20,350
عُرف المحاربون الذين دافعوا
عن الآلهة أثينا بالفرسان

6
00:00:20,470 --> 00:00:25,520
اليوم، يتحكّم جيلٍ جديد من الفرسان
بمصير العالم

7
00:00:25,650 --> 00:00:29,230
يُدعون بفرسان الأبراج

8
00:02:00,030 --> 00:02:03,040
..."سابقاً في "سينت سيا

9
00:02:03,660 --> 00:02:04,790
ما هذا؟

10
00:02:04,910 --> 00:02:08,460
!خنق نوء نثرة العالم السفليّ

11
00:02:10,670 --> 00:02:11,440
!لونغ

12
00:02:12,250 --> 00:02:16,380
آذيتَ الشخص الوحيد الذي أحببتُه قطّ

13
00:02:16,510 --> 00:02:19,430
!لن أبدي لك أيّ رحمة

14
00:02:22,320 --> 00:02:25,930
انبعاث التنّين الصاعد

15
00:02:24,510 --> 00:02:28,980
ديثماسك، لم يسبق وأن أبغضتُ
عدوّاً مثلما أبغضك

16
00:02:29,100 --> 00:02:31,020
!لن أبدي لك أيّ رحمة

17
00:02:31,150 --> 00:02:32,270
!مُحال

18
00:02:32,400 --> 00:02:33,770
!كنت شبه ميت

19
00:02:33,900 --> 00:02:38,030
لكنّ الكوزمو الصادرة منك بقوّة
!كوزمو فارس ذهبيّ

20
00:02:38,150 --> 00:02:40,660
،دمّ التنين داخلي يغلي

21
00:02:40,780 --> 00:02:44,160
!والكوزمو خاصّتي تشتعل لتدميرك

22
00:02:55,710 --> 00:02:57,510
!مُت يا ديثماسك

23
00:02:59,970 --> 00:03:02,220
،هاجمت أعزّ الأشخاص لي

24
00:03:02,340 --> 00:03:05,180
!فستشعر الآن بغضب التنّين

25
00:03:05,310 --> 00:03:08,930
!لن يخمد غضبي إلّا بموتك

26
00:03:17,860 --> 00:03:21,490
غاضبٌ لأنّي أزهقت حياة
صديقتك الصغيرة أيّها التنّين؟

27
00:03:21,610 --> 00:03:23,700
لا تكن عاطفيّاً هكذا

28
00:03:23,820 --> 00:03:26,330
حياتها مثل أيّة حياة أخرى

29
00:03:26,450 --> 00:03:28,450
لم تملك أيّة قيمة

30
00:03:28,580 --> 00:03:30,710
!أغلق فمك يا ديثماسك

31
00:03:30,830 --> 00:03:34,460
بوّابة النسيان هي مدخل العالم السفليّ

32
00:03:34,580 --> 00:03:37,800
!بعدما تدخلها، لا يمكنك العودة أبداً

33
00:03:37,920 --> 00:03:39,840
وسأرسلك هناك

34
00:03:39,970 --> 00:03:43,590
حيث ستواجه الضحايا
الأبرياء الذين قتلتهم

35
00:03:43,720 --> 00:03:44,930
!خذ هذه

36
00:03:45,050 --> 00:03:47,720
!حركة التنّين السرّية المُطلقة

37
00:03:47,850 --> 00:03:51,230
!لوشان شينلونغ با

38
00:03:55,900 --> 00:03:57,400
بائس

39
00:03:57,520 --> 00:04:01,030
!تبخّرت أقوى هجماتي

40
00:04:05,070 --> 00:04:06,830
أكانت تلك بعوضة؟

41
00:04:06,950 --> 00:04:09,540
أم تدعو ذاك الشيء بتنّينٍ حقّاً؟

42
00:04:10,790 --> 00:04:12,540
الموت يأتي للجميع

43
00:04:12,660 --> 00:04:14,540
لقد أتى لك الآن

44
00:04:16,170 --> 00:04:16,960
!أبداً

45
00:04:18,780 --> 00:04:20,710
حتّى لو أشعلت الكوزمو خاصّتك بأكملها

46
00:04:20,840 --> 00:04:22,220
فلن تفيدك بشيء

47
00:04:22,340 --> 00:04:26,220
مهما بلغ غضبك، لا يمكنك إيذائي

48
00:04:30,850 --> 00:04:33,520
،طالما أرتدي درع السرطان الذهبيّ

49
00:04:33,640 --> 00:04:36,520
لديّ شدّة البأس، مما تمنحني قوّة

50
00:04:36,650 --> 00:04:40,900
لا تستطيع قتلي ولو وجّهت 10 آلاف لكمة

51
00:04:47,620 --> 00:04:49,240
هل فهمت الآن؟

52
00:04:49,370 --> 00:04:51,370
لن تهزمني أبداً

53
00:04:52,950 --> 00:04:56,080
!حان وقت هلاكك

54
00:05:02,970 --> 00:05:06,340
يبدو أنّ موجة القدر قد انقلبت ضدّك

55
00:05:06,470 --> 00:05:11,060
ديثماسك، لمَ لا تستطيع استعمال
قواك لخير البشريّة؟

56
00:05:11,180 --> 00:05:14,680
لا أنوي خدمة أيّ شيءٍ أو أيّ أحد

57
00:05:14,810 --> 00:05:16,190
عدا نفسي

58
00:05:18,770 --> 00:05:20,520
ماذا؟ ما هذا؟

59
00:05:20,650 --> 00:05:23,900
أرواح الأبرياء المفقودة
!للأشخاص الذين قتلتهم

60
00:05:24,030 --> 00:05:27,360
اُحتجزت هنا بينا الحياة والآخرة

61
00:05:27,490 --> 00:05:31,660
عاجزةً عن إيجاد السلام، مُعذّبةً بكراهيّتها لك

62
00:05:33,540 --> 00:05:36,160
لا بدّ أنّكم تشعرون بالسرور
لأنّ حيواتكم عديمة المعنى

63
00:05:36,290 --> 00:05:38,920
قد ضُحي بها لهدفٍ نبيل

64
00:05:39,040 --> 00:05:41,920
ألا تشعر بالندم بالنظر لأوجههم؟

65
00:05:42,050 --> 00:05:44,210
محض دليلٍ على قوّتي

66
00:05:44,340 --> 00:05:46,050
لا سبب يدفعني للقلق

67
00:05:46,170 --> 00:05:48,390
!لا يمكنهم فعل شيءٍ لي

68
00:05:50,640 --> 00:05:54,060
!إذا أبيتم الذهاب بأنفسكم، سأرميكم في الجحيم

69
00:05:55,020 --> 00:05:56,730
!هاك! دعني أساعدك

70
00:05:56,850 --> 00:05:59,560
!وأنت! ها أنتم

71
00:06:02,270 --> 00:06:04,730
،يُفترض أن يدافع الفرسان عن الدالة

72
00:06:04,860 --> 00:06:08,030
لكنّه لا يحمل أيّة ندم
على الجرائم التي اقترفها

73
00:06:08,150 --> 00:06:10,370
أو شفقةً لضحاياه

74
00:06:10,490 --> 00:06:13,870
أيمكن لأحدٍ أن يكون بهذه القسوة؟

75
00:06:13,990 --> 00:06:16,120
أعتذر على جعلك تنتظر

76
00:06:16,250 --> 00:06:18,420
لكن حان دورك الآن

77
00:06:23,380 --> 00:06:24,960
أيؤلمك ذلك؟

78
00:06:25,090 --> 00:06:27,090
إنّه ليس ألمي

79
00:06:29,800 --> 00:06:31,970
،درع السرطان الذهبيّ العظيم

80
00:06:32,220 --> 00:06:34,850
أشعر بالألم في قلبي

81
00:06:34,970 --> 00:06:37,770
أيمكنك سماع صيحات بكاء تلك الأرواح البريئة؟

82
00:06:37,890 --> 00:06:39,310
أنا يمكنني

83
00:06:39,440 --> 00:06:41,150
وهي جميلة

84
00:06:45,820 --> 00:06:47,820
!أيّها الدرع الذهبيّ

85
00:06:47,940 --> 00:06:51,910
كيف يُكافئ شخصٍ بمثل شرّه بقوّتك؟

86
00:06:52,030 --> 00:06:53,660
!ذلك غير منطقيّ

87
00:06:53,780 --> 00:06:56,490
تستنجد إرادة الدرع الذهبيّ؟

88
00:06:56,620 --> 00:06:58,250
!سخافة

89
00:06:59,120 --> 00:07:01,370
هذا ما يفعله الضعفاء تماماً

90
00:07:01,500 --> 00:07:04,880
يمكنك الاعتماد على شيءٍ واحدٍ فقط

91
00:07:05,000 --> 00:07:06,500
قوّتك

92
00:07:06,630 --> 00:07:10,800
إن لم تمتلك القوّة، فلا حقّ لديك بالمطالبة بالعدالة

93
00:07:14,010 --> 00:07:15,640
!يا درع السرطان الذهبيّ

94
00:07:20,230 --> 00:07:21,310
!مُحال

95
00:07:21,440 --> 00:07:23,190
!نُزِع من تلقاء نفسه

96
00:07:24,810 --> 00:07:26,400
ما الذي يجري؟

97
00:07:26,520 --> 00:07:28,400
!هذا الدرع يخصّني

98
00:07:32,780 --> 00:07:34,120
ماذا؟

99
00:07:34,240 --> 00:07:37,200
كيف... كيف يحصل هذا؟

100
00:07:37,330 --> 00:07:39,700
إنّها إرادة الدرع الذهبيّ الخاصّة

101
00:07:39,830 --> 00:07:42,000
ما-ما قصدك؟

102
00:07:42,120 --> 00:07:44,290
إنّه ليس محض درع حماية

103
00:07:44,420 --> 00:07:46,250
إنّه أداةٌ للعدالة

104
00:07:46,380 --> 00:07:49,460
ولا يمكنك فرض العدالة بالقوّة

105
00:07:49,590 --> 00:07:52,720
يختار الدرع الذهبيّ
،الفارس الذي يرتديه

106
00:07:52,840 --> 00:07:55,390
مُختاراً العدالة على الشرّ

107
00:07:55,510 --> 00:07:57,680
وقد تحلّى عنك الآن

108
00:07:57,810 --> 00:08:01,810
تعتقد أنّ الدرع الذهبيّ يمتلك
إرادةً تخصّه؟

109
00:08:04,560 --> 00:08:05,610
أحمق

110
00:08:05,730 --> 00:08:08,690
كلّ ما يهمّ هو امتلاكي للقوّة

111
00:08:08,820 --> 00:08:10,610
هذه نهايتك يا ديثماسك

112
00:08:10,740 --> 00:08:13,150
أنت بلا حمايةٍ دون الدرع

113
00:08:14,200 --> 00:08:16,740
،لكن مهما بلغ شرّك

114
00:08:16,870 --> 00:08:19,790
لن أستغلّك

115
00:08:22,460 --> 00:08:23,670
ماذا؟

116
00:08:23,790 --> 00:08:25,830
لمَ قد تختار نزع درعك؟

117
00:08:25,960 --> 00:08:27,960
!لأنّي أقاتل بشرف

118
00:08:28,090 --> 00:08:32,380
نحن مُتكافئان الآن، وستحسم الكوزمو
خاصّتنا هذا القتال

119
00:08:32,510 --> 00:08:36,640
!أحمق! تخلّيتَ عن فرصتك الوحيدة لهزيمتي

120
00:08:36,760 --> 00:08:41,020
في اختبارٍ للكوزمو، سينتصر الفارس الذهبيّ دوماً

121
00:08:41,140 --> 00:08:44,270
علّمني مو المعنى الحقيقيّ للكوزمو

122
00:08:44,390 --> 00:08:47,400
مصدر الكوزمو هو الحاسّة السابعة

123
00:08:47,520 --> 00:08:50,280
إنّها أشدّ قوّةً من بقايا الحواس

124
00:08:50,400 --> 00:08:53,530
حتّى المعلّم دوكو لم يستطع تعليمها لي

125
00:08:53,650 --> 00:08:57,910
إنّها شيءٌ على المرء إيقاظه
وصقله في المعارك

126
00:08:58,030 --> 00:09:00,700
،قد أكون محض فارسٍ برونزيّ

127
00:09:00,830 --> 00:09:03,290
،لكن إن كنتُ صادقاً وأقاتل للعدالة

128
00:09:09,500 --> 00:09:11,670
ولو للحظةٍ فحسب

129
00:09:11,800 --> 00:09:13,300
حسناً إذاً

130
00:09:13,420 --> 00:09:16,550
سأشتعل الكوزمو خاصّتي لأشدّ حدّة لها

131
00:09:16,680 --> 00:09:19,550
وأستعمل هجوم نثرة العالم السفليّ

132
00:09:19,680 --> 00:09:21,930
،لم يسبق وأن استعملتُه هنا

133
00:09:22,060 --> 00:09:25,440
عند مدخل العالم السفليّ نفسه

134
00:09:25,560 --> 00:09:28,270
سيكون من المثير رئية ما سيحصل

135
00:09:29,310 --> 00:09:33,940
ربما ستُمزّق روحك وتُفجّر
لبعدٍ آخر مجهول

136
00:09:34,070 --> 00:09:37,070
حيث لا يمكنك العودة منه لعالم الأحياء أبداً

137
00:09:37,200 --> 00:09:41,330
سأمزّقك إرباً هنا والآن

138
00:09:43,200 --> 00:09:48,080
أحمق! أتعتقد حقّاً أن الكوزمو خاصّتك
تستطيع التوهّج لمستواي؟

139
00:09:50,290 --> 00:09:51,250
ماذا؟

140
00:09:51,380 --> 00:09:52,590
تنانين؟

141
00:09:52,710 --> 00:09:55,590
هالات تنانين لا مُتناهية؟

142
00:09:55,720 --> 00:09:57,220
...لا، إنّها

143
00:09:58,050 --> 00:10:00,180
!كوزمو هائلة

144
00:10:00,300 --> 00:10:04,180
!خنق نوء نثرة العالم السفليّ

145
00:10:04,310 --> 00:10:08,390
،بوصول الكوزمو خاصّتي لأعلى حدّة لها

146
00:10:08,520 --> 00:10:11,770
!اصعد يا تنّيني، أعلى من السماوات

147
00:10:11,900 --> 00:10:15,190
!لوشان شينلونغ با

148
00:10:30,790 --> 00:10:32,460
فعلتُها

149
00:10:32,590 --> 00:10:35,550
هزمتُ فارساً ذهبيّاً

150
00:10:35,670 --> 00:10:38,930
غلبتُ ديثماسك

151
00:11:01,820 --> 00:11:04,950
ما-ما هذا؟

152
00:11:09,830 --> 00:11:11,250
!لونغ

153
00:11:14,000 --> 00:11:15,710
لونغ، اصمد

154
00:11:19,960 --> 00:11:21,550
أأنت بخير؟

155
00:11:21,680 --> 00:11:23,220
أجل، أنا بخير

156
00:11:23,340 --> 00:11:26,100
ما الذي حلّ بفارس السرطان الذهبيّ

157
00:11:26,220 --> 00:11:30,180
كلّ ما يهمّ هو أنّ الشرّ
في هذا المنزل قد زال

158
00:11:30,310 --> 00:11:33,230
يمكن أن ترقد الأرواح
المفقودة في سلامٍ أخيراً

159
00:11:33,860 --> 00:11:35,110
لونغ

160
00:11:35,230 --> 00:11:36,570
معلّم دوكو؟

161
00:11:36,690 --> 00:11:37,980
أهذا أنت سيّدي؟

162
00:11:38,590 --> 00:11:41,490
شونري، ما الذي حلّ بشونري؟

163
00:11:41,610 --> 00:11:44,030
استخفّ ديثماسك بي

164
00:11:44,160 --> 00:11:47,410
لا بدّ أنه اعتقد حقّاً
أنّ بإمكانه التغلّب عليّ

165
00:11:47,540 --> 00:11:50,040
...معلّمي، أهي

166
00:11:50,160 --> 00:11:52,540
شونري بأمان

167
00:11:52,670 --> 00:11:54,540
لا حاجة للقلق

168
00:11:56,340 --> 00:11:58,420
لم تلحظ بعد

169
00:11:58,550 --> 00:12:01,550
يبدو أنّ بصرك قد عاد

170
00:12:03,800 --> 00:12:06,140
لونغ، عيناك

171
00:12:06,260 --> 00:12:07,310
أيمكنك أن ترى؟

172
00:12:07,430 --> 00:12:09,220
يمكنني الرؤية

173
00:12:09,350 --> 00:12:10,430
لكن كيف؟

174
00:12:12,270 --> 00:12:14,600
تطلّبت منك معركتك مع ديثماسك

175
00:12:14,730 --> 00:12:18,190
استحضار أعلى مستويات للكوزمو خاصّتك

176
00:12:18,320 --> 00:12:21,570
حفّزت طاقة حياتك بشكلٍ طبيعيّ

177
00:12:21,690 --> 00:12:24,280
مما شفى عينيك أيضاً بطبيعة الحال

178
00:12:25,320 --> 00:12:30,080
لكنّ أكبر مساندةٍ لك كانت
شونري على الأغلب

179
00:12:30,200 --> 00:12:33,830
دعواتها المتوالية جلبت لك النصر

180
00:12:33,960 --> 00:12:36,580
شكراً لكِ يا شونري

181
00:12:36,710 --> 00:12:40,840
فلتذهب الآن، لا يزال أمامك الكثير لتفعله

182
00:12:40,960 --> 00:12:42,880
أجل معلّمي دوكو

183
00:12:43,550 --> 00:12:46,300
شون، أنا قلقٌ على ماغنس

184
00:12:46,430 --> 00:12:48,220
وأنا كذلك

185
00:12:48,350 --> 00:12:51,350
لم أعد أستطيع الشعور بالكوزمو خاصّته

186
00:12:51,470 --> 00:12:52,480
لنتحرّك

187
00:13:02,860 --> 00:13:04,530
مظهرٌ أخّاذ

188
00:13:04,650 --> 00:13:07,990
عبر الفرسان البرونزيّون منزل السرطان

189
00:13:08,120 --> 00:13:11,370
لا بدّ أنّ ديثماسك فقد زمام السيطرة

190
00:13:11,490 --> 00:13:14,370
هل أنهي الأمور سيّدي العظيم؟

191
00:13:14,500 --> 00:13:16,420
سيتمّ ذلك بسرعةٍ وسهولةٍ أكبر

192
00:13:16,540 --> 00:13:18,080
كلّا

193
00:13:18,210 --> 00:13:21,420
لا بدّ أنّ هذا جزءٌ
من خطّة القدر الكبيرة

194
00:13:21,550 --> 00:13:24,340
علينا الانتظار ورؤية
ما يؤول إليه الأمر

195
00:13:27,050 --> 00:13:29,430
أأنت بخيرٍ سيّدي العظيم؟

196
00:13:30,380 --> 00:13:31,510
ليس شيئاً يُذكر

197
00:13:31,640 --> 00:13:32,680
أنا بخير

198
00:13:38,020 --> 00:13:40,690
عاجلاً أم آجلاً، سيكشف الوقت كلّ شيء

199
00:13:40,820 --> 00:13:43,690
لا يسعنا فعل شيءٍ سوى الانتظار

200
00:13:44,570 --> 00:13:45,700
يمكنك الانصراف الآن

201
00:13:45,820 --> 00:13:47,280
دعني لخلوتي

202
00:13:48,110 --> 00:13:49,990
بالتأكيّد سيّدي

203
00:13:58,670 --> 00:14:00,960
من المستحيل قراءة أفكاره

204
00:14:01,090 --> 00:14:04,960
لكنّ ذلك يجعله أكثر أناقة

205
00:14:07,090 --> 00:14:09,470
التالي هو منزل الأسد

206
00:14:11,220 --> 00:14:14,520
أتطلّع قُدماً لمعركتك يا آيوليا

207
00:14:20,860 --> 00:14:22,230
منزل الأسد

208
00:14:22,360 --> 00:14:24,480
لن يكون هذا سهلاً على الأقل

209
00:14:24,610 --> 00:14:27,450
يحرس هذا المعبد الفارس
الذهبيّ الأسد آيوليا

210
00:14:27,570 --> 00:14:29,200
الذي أقسم بولائه لأثينا

211
00:14:29,840 --> 00:14:32,740
لا أريد تدمير كلّ ما لدينا
على سطح الأرض

212
00:14:32,870 --> 00:14:34,740
لكنّي أحتاج لمساعدتك

213
00:14:37,750 --> 00:14:41,000
ربما قد نستطيع جميعاً
اختيار المستقبل لأنفسنا

214
00:14:51,390 --> 00:14:52,760
آيوليا

215
00:15:01,270 --> 00:15:02,150
لمَ؟

216
00:15:02,270 --> 00:15:03,900
!آيوليا

217
00:15:11,570 --> 00:15:13,410
ما الذي يجري؟

218
00:15:13,530 --> 00:15:14,990
!لمَ تهاجمني؟

219
00:15:15,120 --> 00:15:17,830
!أقسمت بولائك لأثينا

220
00:15:29,050 --> 00:15:31,930
وصل برونزيٌّ منزل الأسد

221
00:15:32,720 --> 00:15:37,180
انحرف آيوليا عن الدرب القويم
بنيّة الإقدام على الخيانة

222
00:15:37,310 --> 00:15:40,940
عبر خيانة الملجأ وكلّ ما نمثله

223
00:15:41,480 --> 00:15:44,270
كما فعل أخيه آيولوس

224
00:15:51,860 --> 00:15:54,370
،إذا لم يتنازل أحدهما

225
00:15:54,490 --> 00:15:57,240
قد يبقيان في سجال هذه المعركة لأعوام

226
00:16:00,620 --> 00:16:02,500
!صاعقة البرق

227
00:16:02,620 --> 00:16:03,750
أوم

228
00:16:15,760 --> 00:16:18,680
أعترف أن قوّتك مُبهرةٌ بالفعل

229
00:16:18,810 --> 00:16:20,430
صدقت الشائعة

230
00:16:20,560 --> 00:16:23,020
أنت الرجل الأقرب لإله

231
00:16:23,140 --> 00:16:25,520
لا بدّ أنّ دموع الأسد تذرف

232
00:16:25,650 --> 00:16:30,530
،فقد انحرفت بنفسك عن الحقّ
وليس أخيك فحسب

233
00:16:44,710 --> 00:16:46,580
!صاعقة البرق

234
00:16:49,340 --> 00:16:52,010
فلتتب وتصلح نفسك

235
00:17:03,270 --> 00:17:05,440
!هجمة الشيطان السرابيّة

236
00:17:18,070 --> 00:17:20,450
هجمة الشيطان السرابيّة

237
00:17:20,580 --> 00:17:25,120
سيّدي العظيم، لمَ قد تودّ
التحكّم بأفكاره ودماغه؟

238
00:17:25,610 --> 00:17:28,500
تتحكّم النزعات بتصرّفات آيوليا

239
00:17:28,630 --> 00:17:31,050
كما حصل مع أخيه قبلاً

240
00:17:39,260 --> 00:17:42,850
عليّ التحكّم بدماغه ومنحه وقتاً للتعافي

241
00:17:42,970 --> 00:17:47,060
بعدما يهدأ، سيتمكّن آيوليا
من التصرّف بعقلانيّة

242
00:17:51,270 --> 00:17:55,360
أنت رجلٌ صبورٌ وكريم سيّدي العظيم

243
00:17:57,360 --> 00:18:00,660
كانت إرادة السيّد العظيم

244
00:18:01,280 --> 00:18:06,660
عندما ينتهي كلّ شيء، سيفهم آيوليا لطفه

245
00:18:11,590 --> 00:18:14,010
أأنت عازمٌ على اعتراض طريقي يا آيوليا؟

246
00:18:14,130 --> 00:18:17,720
سأقتلّ كلّ من يحاول
!عبور منزل الأسد

247
00:18:19,000 --> 00:18:20,600
هنالك أمرٌ غريب

248
00:18:20,720 --> 00:18:22,560
إنّه أشبه بشخصٍ مختلف

249
00:18:22,680 --> 00:18:24,470
ما حلّ به يا ترى؟

250
00:18:25,720 --> 00:18:27,560
!لا تجعلني أستعمل قبضتي

251
00:18:36,780 --> 00:18:39,200
كلّ ما رأيته هو وميض نور

252
00:18:39,320 --> 00:18:41,820
في المرّة القادمة، لن تراه حتّى

253
00:18:42,700 --> 00:18:46,370
،آخر مرّة رأيتك فيها يا آيوليا
كنّا في الجانب نفسه

254
00:18:46,500 --> 00:18:48,080
ما الذي تغيّر؟

255
00:18:48,210 --> 00:18:50,880
ماذا حصل عندما رجعت للملجأ؟

256
00:18:52,750 --> 00:18:54,380
!حصل شيءٌ ما

257
00:18:54,500 --> 00:18:55,590
!أخبرني ما كان

258
00:18:55,710 --> 00:18:57,590
لا علاقة لك

259
00:18:57,720 --> 00:19:00,470
كلّ ما تحتاج لمعرفته
هو أنّي سأوقفك

260
00:19:02,760 --> 00:19:04,060
لا بأس

261
00:19:04,180 --> 00:19:06,720
عليّ إنقاذ ماغنس وسينا

262
00:19:06,850 --> 00:19:09,100
لا أستطيع التهاون أكثر

263
00:19:09,230 --> 00:19:11,150
!لم يعد هناك كلامٌ يُقال يا آيوليا

264
00:19:21,780 --> 00:19:24,780
!سأقاتلك بكلّ قوّتي

265
00:19:33,210 --> 00:19:35,000
...ليس مُجدداً

266
00:19:35,130 --> 00:19:38,630
ومض كتف آيوليا، وتعرّضت لضربة موجعة

267
00:19:42,130 --> 00:19:44,390
لا بدّ أنّه يوجّه لكماتاً بسرعة الضوء

268
00:19:44,510 --> 00:19:47,770
لكن إن لم أستطع رؤيتها، لا يمكنني تفاديها

269
00:19:49,020 --> 00:19:54,230
،آيوليا، إن لم تعد بصفّ أثينا
!فأنت عدويّ

270
00:20:00,780 --> 00:20:05,660
تمكّنت من تفاديها قبلاً بمساعدة
درع القوس الذهبيّ

271
00:20:05,780 --> 00:20:08,660
لكن لا أمل لك الآن

272
00:20:20,010 --> 00:20:22,800
إنّه أقوى بمراحل من معركتنا الأخيرة

273
00:20:23,310 --> 00:20:28,060
كما قال، عليّ إيجاد طريقةٍ لرؤية ضرباته

274
00:20:28,180 --> 00:20:30,640
سينا والبقيّة يعتمدون عليّ

275
00:20:31,230 --> 00:20:32,980
لا خيار أمامي

276
00:20:33,100 --> 00:20:34,310
!عليّ فعلها

277
00:20:37,440 --> 00:20:39,650
!عليّ حرق الكوزمو خاصّتي

278
00:20:39,780 --> 00:20:42,820
!احترقي! احترقي بسخونة كوزمو آيوليا

279
00:20:42,950 --> 00:20:44,820
انتهى الأمر يا سيا

280
00:20:44,950 --> 00:20:47,740
!هيّا أيّتها الكوزمو! فلتعطيني معجزة

281
00:20:47,870 --> 00:20:50,330
!دعيني أرى تحرّكاته بسرعة الضوء

282
00:20:52,660 --> 00:20:55,710
سخافة، الكوزمو خاصّتك ضعيفة

283
00:20:57,080 --> 00:20:58,670
!أ-أراها

284
00:20:58,790 --> 00:21:00,710
تيّارات ضوءٍ لا مُتناهية

285
00:21:00,840 --> 00:21:02,840
لكمات آيوليا ذات سرعة الضوء

286
00:21:09,260 --> 00:21:10,310
!تفاديتُها

287
00:21:11,100 --> 00:21:11,770
ماذا؟

288
00:21:12,430 --> 00:21:16,520
إن استطعتُ الاندفاع نحو صدره الآن
!بشكلٍ ما، فسأستطيع الفوز

289
00:21:24,490 --> 00:21:26,910
!هل صفى دماغك الآن يا آيوليا؟