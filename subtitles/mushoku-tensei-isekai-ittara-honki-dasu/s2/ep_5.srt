1
00:00:51,070 --> 00:00:52,490
!بإمكاني رؤيتها

2
00:00:52,490 --> 00:00:56,410
!تلك هي عاصمة دولة ميليس المقدّسة، ميليشيون

3
00:00:57,870 --> 00:00:59,080
،أمّا الآن

4
00:00:59,080 --> 00:01:01,290
.هنا حيث نفترق

5
00:01:01,290 --> 00:01:03,380
في هذا المكان؟

6
00:01:03,380 --> 00:01:04,380
...على الأقل ابقَ حتّى ندخل

7
00:01:04,380 --> 00:01:07,840
.لا تحزن يا زعيم، سنلتقي مجدّدًا

8
00:01:07,840 --> 00:01:11,340
!غيس، في المرّة القادمة علّمني الطبخ

9
00:01:11,340 --> 00:01:16,310
يا لكِ من لحوحة، لمَ كلّ هذا الإصرار؟

10
00:01:16,310 --> 00:01:18,230
...لأنّني

11
00:01:18,230 --> 00:01:22,560
لماذا يا إيريس؟ ما الذي تحاولين قوله؟

12
00:01:22,560 --> 00:01:25,650
.هيّا بوحي بما عندكِ

13
00:01:25,650 --> 00:01:27,820
.رافقتك السلامة أيّها السيد

14
00:01:27,820 --> 00:01:30,910
.وأنت كذلك، لا تتسبّب بالأذى

15
00:01:30,910 --> 00:01:33,620
.فهمت

16
00:01:37,500 --> 00:01:43,420
.كدت أنسى يا زعيم، تذكّر زيارة نقابة المغامرين

17
00:01:43,420 --> 00:01:46,340
.أ-أجل

18
00:01:46,340 --> 00:01:48,380
!إلى اللقاء

19
00:03:21,220 --> 00:03:22,350
،والآن

20
00:03:22,350 --> 00:03:25,190
.أفتتح اجتماع النهاية المميتة الاستراتيجي

21
00:03:25,190 --> 00:03:27,150
.فليصفّق الجميع

22
00:03:32,570 --> 00:03:37,950
،مضى عام ونصفٌ منذ انتقالنا إلى قارّة الشياطين

23
00:03:37,950 --> 00:03:42,540
.وأخيرًا، أخيرًا وصلنا إلى منطقة البشر

24
00:03:42,540 --> 00:03:45,540
!سننطلق مباشرة نحو أسورا

25
00:03:45,540 --> 00:03:51,340
.أو هذا ما أودّ قوله، لكنّي أفضّل البقاء هنا وجني المال

26
00:03:51,340 --> 00:03:52,920
لماذا؟

27
00:03:52,920 --> 00:03:56,050
.سمعت أنّ المهمّات في ميليس مربحة

28
00:03:56,050 --> 00:03:59,350
.جني أموالنا هنا سيكون أكثر كفاءة

29
00:03:59,350 --> 00:04:03,020
.بالإضافة إلى أنّنا لا نعرف كم ستكلّف رسوم السفينة التالية

30
00:04:03,020 --> 00:04:06,270
ماذا؟ أعلينا ركوب سفينة أخرى؟

31
00:04:06,270 --> 00:04:08,850
،كما أنّني جئت بخطّة جيّدة

32
00:04:08,850 --> 00:04:13,650
.وكذلك سأحسّن سمعة السبيرد

33
00:04:16,450 --> 00:04:20,490
،بعد أن نساعد شخصًا ما، سنكشف له هويّة رويجرد

34
00:04:20,490 --> 00:04:23,370
.ثمّ سنعطيه إحدى هذه كتميمة

35
00:04:23,370 --> 00:04:27,670
،إن حملت هذه فحتّى السبيرد سيهدأ فورًا"

36
00:04:27,670 --> 00:04:33,460
."وخلال دقائق سيُصبح شقيق الروح الذي عرفته منذ زمن

37
00:04:33,460 --> 00:04:36,260
أكنت تصنع هذه؟

38
00:04:36,260 --> 00:04:38,840
!صحيح، فلنرتح في الغد

39
00:04:38,840 --> 00:04:40,260
أثمّة خطبٌ ما؟

40
00:04:40,260 --> 00:04:43,390
،أريد صنع تماثيل رويجرد-سان بالجملة

41
00:04:43,390 --> 00:04:45,850
.وأن أكتب رسالة كذلك

42
00:04:45,850 --> 00:04:47,020
رسالة؟

43
00:04:47,020 --> 00:04:50,900
.أجل، رسالة كي نُخبر الجميع أنّنا بأمان

44
00:04:52,020 --> 00:04:57,070
.الأوضاع كانت عصيبة فنسيت، لكن لا بدّ أنّ عائلتي قلقة

45
00:04:57,070 --> 00:04:59,490
.عليّ التواصل معهم

46
00:04:59,490 --> 00:05:02,910
.لا يمكنهم لومي في هذا الوضع

47
00:05:02,910 --> 00:05:04,620
ماذا ستفعلان؟

48
00:05:04,620 --> 00:05:07,290
!سأنضمّ إلى مهمّة قتل الغوبلين

49
00:05:07,290 --> 00:05:09,580
!سمعت أنّهم يظهرون هنا

50
00:05:09,580 --> 00:05:11,880
قتل الغوبلين؟

51
00:05:15,840 --> 00:05:19,220
.روديوس، لا بأس دعها تحاول

52
00:05:19,220 --> 00:05:21,220
...لكن

53
00:05:23,390 --> 00:05:26,350
...فهمت، ما دام هذا قولك يا رويجرد-سان

54
00:05:26,350 --> 00:05:29,890
!أستطيع قتل الغوبلين وحدي

55
00:05:29,890 --> 00:05:32,940
.أعرف نهاية هذه الكلمات

56
00:05:32,940 --> 00:05:37,990
.في هذه الحالة، فلنأخذ راحة غدًا

57
00:05:37,990 --> 00:05:39,240
!حسنًا

58
00:05:39,240 --> 00:05:40,070
.أجل

59
00:05:40,070 --> 00:05:43,490
!أنا أعتمد عليك في حماية إيريس يا رويجرد

60
00:05:59,510 --> 00:06:03,890
.حسب ما أذكر، هذه أوّل مرّة أكتب فيها إلى باول

61
00:06:03,890 --> 00:06:07,430
،أتساءل إن كان سيصدّق أنّني صادقت سبيردًا

62
00:06:07,430 --> 00:06:12,600
.وحصلت على عينٍ شيطانيّة من إمبراطورة عالم الشياطين العظيمة

63
00:06:12,600 --> 00:06:14,190
!تحرّك

64
00:06:18,190 --> 00:06:20,780
.يا للهول، اختطاف آخر

65
00:06:20,780 --> 00:06:23,780
.هذا العالم مليء بالمختطفين

66
00:06:23,780 --> 00:06:27,200
بصراحة لا أرغب في إقحام نفسي؛

67
00:06:27,200 --> 00:06:31,210
.فقد حُبست ظلمًا آخر مرّة

68
00:06:33,420 --> 00:06:35,500
.يا إلهي

69
00:06:35,500 --> 00:06:39,880
!القاعدة رقم 1 للنهاية المميتة: لا تتخلّ عن طفل أبدًا

70
00:06:39,880 --> 00:06:43,630
.القاعدة رقم 2 للنهاية المميتة: لا تتخلّ عن طفلٍ قطعًا

71
00:06:43,630 --> 00:06:45,930
.النهاية المميتة حليفة للعدالة

72
00:06:45,930 --> 00:06:50,640
.هكذا سنطهّر اسم السبيرد رويدًا رويدًا

73
00:06:52,890 --> 00:06:55,270
لم يتبعنا أحد صحيح؟

74
00:06:55,270 --> 00:06:56,690
.لا

75
00:07:07,620 --> 00:07:08,990
هل أنت بخير؟

76
00:07:08,990 --> 00:07:10,370
.أ-أجل

77
00:07:10,370 --> 00:07:12,580
.أنت، نادِ على القائد

78
00:07:12,580 --> 00:07:14,420
.عُلم

79
00:07:18,590 --> 00:07:20,960
.ثمّة المزيد من رفاقهم

80
00:07:20,960 --> 00:07:24,300
والآن، كيف أنقذ ذلك الطفل؟

81
00:07:24,300 --> 00:07:26,680
.لا أعرف مقدار قوّتهم

82
00:07:26,680 --> 00:07:30,720
.مفاجأتهم وافتعال قتالٍ معهم سيكون خطيرًا

83
00:07:30,720 --> 00:07:33,560
.سأختبئ وأنتظر لبرهة

84
00:07:33,560 --> 00:07:36,980
.أتوسّل إليكم ألّا تستخدموا العنف

85
00:07:36,980 --> 00:07:40,980
لكن ما هذا المكان؟ كنيسة؟

86
00:07:40,980 --> 00:07:44,280
.لا يبدو أنّه كذلك الآن

87
00:07:44,280 --> 00:07:46,450
.قماش

88
00:07:46,450 --> 00:07:48,450
.وصغير ليكون لباسًا

89
00:07:48,450 --> 00:07:52,660
.مع ذلك فلمسه مريح

90
00:07:52,660 --> 00:07:57,460
.أتذكّر هذا الملمس وهذا الشكل

91
00:07:57,460 --> 00:08:01,210
...صحيح، فيه ثقبان واحد هنا والآخر

92
00:08:01,210 --> 00:08:02,920
!أليس سروالاً داخليًا؟

93
00:08:02,920 --> 00:08:03,760
!من هناك

94
00:08:03,760 --> 00:08:04,880
!تـ-تبًّا

95
00:08:04,880 --> 00:08:05,970
!داخل الصندوق

96
00:08:05,970 --> 00:08:06,880
!أظهر نفسك

97
00:08:06,880 --> 00:08:09,970
!سحقًا! من الجبان الذي سيضع فخًّا كهذا؟

98
00:08:09,970 --> 00:08:12,850
!إنّه دخيل! استدعوا الدعم

99
00:08:12,850 --> 00:08:15,230
.ما باليد حيلة

100
00:08:18,060 --> 00:08:21,110
،يا من ينتزعون الصغار من أحضان أوليائهم

101
00:08:21,110 --> 00:08:24,530
!ويجعلونهم ضحايا شهواتهم السقيمة

102
00:08:24,530 --> 00:08:27,360
!عيبٌ عليكم

103
00:08:27,360 --> 00:08:29,320
...الناس تُطلق على ما تفعلونه

104
00:08:29,320 --> 00:08:32,830
!بالاختطاف

105
00:08:32,830 --> 00:08:34,500
!ما الذي ترتديه؟

106
00:08:34,500 --> 00:08:35,750
!مـ-من أنت؟

107
00:08:35,750 --> 00:08:40,420
!أنا رويجرد النهاية المميتة

108
00:08:40,420 --> 00:08:42,800
!ماذا؟! النهاية المميتة؟

109
00:08:42,800 --> 00:08:46,970
!آسف يا رويجرد-سان، لكنّي سأنقذ الطفل

110
00:08:46,970 --> 00:08:51,930
...أيّها الشقي! مثّل دور البطولة في مكانٍ آخر فنحن

111
00:08:49,090 --> 00:08:50,220
!هجوم الشروق

112
00:08:53,680 --> 00:08:55,890
!هل تأذّيت أيّها الفتى؟

113
00:08:57,100 --> 00:09:00,100
.ماذا؟ هذا الفتى يبدو مألوفًا

114
00:09:01,940 --> 00:09:04,780
!ما الذي جرى؟

115
00:09:04,780 --> 00:09:06,030
.احذروا

116
00:09:06,030 --> 00:09:08,400
.إنّه بارع رغم كونه طفلاً

117
00:09:08,400 --> 00:09:11,200
!...إنّ ذلك سروالي

118
00:09:11,200 --> 00:09:15,160
!آسفٌ يا رويجرد! أنا حقًّا آسف

119
00:09:21,000 --> 00:09:22,340
!يا عدو النساء

120
00:09:22,340 --> 00:09:23,960
!نالوا منه

121
00:09:30,590 --> 00:09:33,680
!تـ-تبًّا! لا يمكنني غضّ بصري

122
00:09:33,680 --> 00:09:37,810
!أنا أناشد التيار المتدفّق المنعش هنا والآن، كرة الماء

123
00:09:33,970 --> 00:09:37,810
!يمين، يسار، يا لهما من مذهلين

124
00:09:43,810 --> 00:09:46,150
!أكاد أراهما

125
00:09:49,820 --> 00:09:51,160
.كان ذلك وشيكًا

126
00:09:51,160 --> 00:09:54,620
!توقّف عن التحرّك سريعًا كالصرصور أيّها المنحرف

127
00:09:54,620 --> 00:09:56,990
!ألم يصل القائد بعد؟

128
00:09:56,990 --> 00:10:00,000
.آسف على التأخر

129
00:10:03,420 --> 00:10:06,670
.ماذا؟ أليس مجرّد سكير

130
00:10:06,670 --> 00:10:10,880
.يا لك من رشيق أيّها الوغد

131
00:10:12,260 --> 00:10:14,680
.أتمنّى أن تكون مستعدًا للعواقب

132
00:10:15,930 --> 00:10:19,520
.أشعر أنّي رأيت هذا الرجل في مكانٍ ما

133
00:10:19,520 --> 00:10:22,060
.يبدو مألوفًا

134
00:10:32,910 --> 00:10:36,620
.هذا الوغد يقاتل مثله

135
00:10:39,410 --> 00:10:41,790
!هل هو كلب؟

136
00:10:51,880 --> 00:10:53,720
...هذا الرجل

137
00:10:55,010 --> 00:10:58,010
.في مستوى آخر عن أولئك الأشرار

138
00:11:01,680 --> 00:11:03,640
!تبًّا

139
00:11:08,480 --> 00:11:09,860
رودي؟

140
00:11:12,610 --> 00:11:16,910
.ثمّة رجلٌ واحد فقط في هذا العالم يدعوني بهذا الاسم

141
00:11:16,910 --> 00:11:19,910
.أجل، رجلٌ واحدٌ فقط

142
00:11:19,910 --> 00:11:23,410
...وفي هذا العالم، هو

143
00:11:24,830 --> 00:11:27,750
أبي؟

144
00:11:54,780 --> 00:11:56,610
...رو

145
00:11:56,610 --> 00:11:58,620
رودي؟

146
00:11:58,620 --> 00:12:01,910
.أبي، مضت فترة منذ لقائنا

147
00:12:01,910 --> 00:12:04,080
...حسنًا، أعتقد

148
00:12:04,080 --> 00:12:06,080
،رودي

149
00:12:06,080 --> 00:12:09,130
.أنا سعيد لنجاتك

150
00:12:09,130 --> 00:12:12,090
...أجل

151
00:12:12,090 --> 00:12:15,720
إذًا، ما الذي جاء بك إلى هنا يا أبي؟

152
00:12:15,720 --> 00:12:19,010
لماذا؟ ألم تقرأ الرسالة؟

153
00:12:19,010 --> 00:12:21,430
أيّ رسالة؟

154
00:12:21,430 --> 00:12:24,140
مهلاً، ما الذي يتحدّث عنه؟

155
00:12:24,140 --> 00:12:26,850
.لا أتذكّر رؤية أيّ رسائل

156
00:12:26,850 --> 00:12:30,770
يا رودي، ما الذي كنت تفعله طوال الوقت؟

157
00:12:30,770 --> 00:12:33,990
.ما الذي أفعله؟ ما حدث لي كان عصيبًا

158
00:12:33,990 --> 00:12:37,360
.الكارثة في روا مضى عليها عام ونصف

159
00:12:37,360 --> 00:12:39,820
.كان بجعبتي الكثير لأخبره

160
00:12:39,820 --> 00:12:43,870
،الجزء الأول: لقائي من رويجرد طيّب القلب

161
00:12:43,870 --> 00:12:47,370
.والفوضى في مدينة ريكاريس

162
00:12:47,370 --> 00:12:53,090
،الجزء الثاني: الساحر العظيم روديوس مع صاحبيه إيريس ورويجرد

163
00:12:53,090 --> 00:12:56,590
.عبور قارّة الشياطين وتصحيح الأخطاء

164
00:12:56,590 --> 00:13:00,010
،الجزء الثالث: تقبض قبيلة الوحوش عليّ باستخدام فخٍّ

165
00:13:00,010 --> 00:13:03,390
.وأُصبح سجينًا في وضعٍ يائسٍ صعب

166
00:13:03,390 --> 00:13:07,600
.كانت هذه خلاصة قصّتي المذهلة الواقعيّة تمامًا

167
00:13:07,600 --> 00:13:10,230
.سأترك الحديث عن هيتوغامي

168
00:13:10,230 --> 00:13:12,770
.فهو مشبوه

169
00:13:12,770 --> 00:13:17,400
.لكن باستذكاري لما جرى، كانت رحلة ممتعة

170
00:13:17,400 --> 00:13:20,490
...وحين وصلنا إلى ميناء الرياح، أوّل ما رأيناه

171
00:13:20,490 --> 00:13:22,490
.هذا يكفي

172
00:13:23,490 --> 00:13:26,250
...واضح من كلامك أنّك

173
00:13:26,250 --> 00:13:29,620
.خلال العام الفائت كنت تسرح وتمرح

174
00:13:31,210 --> 00:13:33,540
.كان الوضع صعبًا عليّ أيضًا

175
00:13:33,540 --> 00:13:38,220
.الطريقة التي تحدّثت بها لا توحي أبدًا بذلك

176
00:13:38,220 --> 00:13:41,800
.هذا بسبب الطريقة التي رويت بها القصّة

177
00:13:41,800 --> 00:13:45,890
...لعلّه فعلاً جرفتني الأحداث، لكن

178
00:13:47,140 --> 00:13:50,480
...أخبرني، بينما كنت في قارّة الشياطين

179
00:13:50,480 --> 00:13:54,570
لمَ لم تحاول تقصّي أخبار ضحايا الكارثة الآخرين؟

180
00:13:54,570 --> 00:13:56,280
لماذا؟

181
00:13:56,280 --> 00:13:59,530
.ليست لدي إجابة على هذا السؤال

182
00:13:59,530 --> 00:14:02,780
...التفسير الوحيد الذي يمكنني تقديمه هو

183
00:14:02,780 --> 00:14:06,700
.أنا لم أفكّر بهذا

184
00:14:06,700 --> 00:14:09,750
.أقصد أنّي كنت منشغلاً

185
00:14:09,750 --> 00:14:13,080
،كان عندك الوقت لمساعدة شيطان لم تقابله قط

186
00:14:13,080 --> 00:14:17,510
لكنّك لم تقلق أبدًا على الذين انتقلوا آنيًّا؟

187
00:14:17,510 --> 00:14:22,300
،يمكنك اتّهامي بأنّي أخطأت في ترتيب أولويّاتي، ولعلّي فعلت

188
00:14:22,300 --> 00:14:25,550
.لكن في ذلك الوقت غاب الأمر عنيّ تمامًا

189
00:14:25,550 --> 00:14:26,850
.ما بيدي حيلة

190
00:14:26,850 --> 00:14:29,980
.لم تبحث عن أحد ولم تراسل كذلك

191
00:14:29,980 --> 00:14:34,110
.ذهبت تغامر رفقة فتاة جميلة ثريّة كما لو أنّك في عطلة

192
00:14:34,110 --> 00:14:37,980
.وكذلك امتلكت حارسًا شخصيًّا قويًّا

193
00:14:37,980 --> 00:14:39,320
وماذا فعلت بعدها؟

194
00:14:39,320 --> 00:14:45,160
أوّل ما قمت به في ميليشيون هو ارتداء
.سروال داخلي على رأسك وتمثيل دور البطل

195
00:14:45,160 --> 00:14:48,540
،أنا لم أعرف وقتها أين أنا أو ماذا أفعل

196
00:14:48,540 --> 00:14:51,620
.لكنّي ظننت أنّ عليّ إبقاء إيريس بأمان على الأقل

197
00:14:51,620 --> 00:14:55,000
لذا ما الخطأ في أنّي لم أستطع التفكير بغير ذلك؟

198
00:14:55,000 --> 00:14:57,210
.أنا لا ألومك

199
00:14:57,210 --> 00:14:59,170
!إذًا لمَ أنت عدائيٌ تجاهي؟

200
00:14:59,170 --> 00:15:02,680
إيريس هي ابنة فيليب؟

201
00:15:02,680 --> 00:15:05,090
.أجل، بالطبع هي ابنته

202
00:15:05,090 --> 00:15:08,180
.لا بدّ أنّها فتاة حسنة المظهر

203
00:15:08,180 --> 00:15:10,020
...هل السبب في أنّك لم تراسلنا

204
00:15:10,020 --> 00:15:15,600
هو أنّك كنت قلقًا أن يزداد الحرّاس حولها فيعترض ذلك علاقة حبّك؟

205
00:15:15,600 --> 00:15:19,150
!أخبرتك أنّني لم أراسلكم لأنّ الأمر غاب عن ذهني

206
00:15:19,150 --> 00:15:22,190
أيّها القائد! ألا تظنّ أنّ هذا يكفي؟

207
00:15:22,190 --> 00:15:23,820
.ما يزال طفلاً

208
00:15:23,820 --> 00:15:25,990
.هذي مشكلة عائليّة، لا تتدخّلي

209
00:15:25,990 --> 00:15:27,700
...لكن

210
00:15:27,700 --> 00:15:31,620
.ليس لديك الحقّ في توبيخي بسبب علاقة مع النساء يا أبي

211
00:15:31,620 --> 00:15:32,750
ماذا؟

212
00:15:32,750 --> 00:15:35,170
من هذه المرأة؟

213
00:15:35,170 --> 00:15:41,880
هل تعلم أمّي وليليا أنّك تتسكّع مع امرأة جميلة مثلها؟

214
00:15:41,880 --> 00:15:43,550
.لا تعلمان

215
00:15:43,550 --> 00:15:45,470
كيف لهما أن تعلما؟

216
00:15:45,470 --> 00:15:47,850
.إذًا استمرّ في خيانتهما كما تشاء

217
00:15:47,850 --> 00:15:50,720
.أرى أنّك جعلتها ترتدي زيًّا خالعًا

218
00:15:50,720 --> 00:15:55,600
...أراهن أنّي سأحظى بأخٍ أو أختٍ قريبًا

219
00:15:55,600 --> 00:15:58,690
!لا تتفوّه بالهراء يا رودي

220
00:15:58,690 --> 00:16:03,030
!بما أنّك هنا، لا بدّ أنّك مررت بميناء زانت

221
00:16:03,030 --> 00:16:04,820
!وماذا في هذا؟

222
00:16:04,820 --> 00:16:06,410
!إذًا كان ينبغي أن تعرف

223
00:16:06,410 --> 00:16:08,990
!وأنا أقول لك أنّي لا أعرف

224
00:16:16,370 --> 00:16:18,670
ماذا؟

225
00:16:17,000 --> 00:16:18,670
أكان ذلك سحرًا؟

226
00:16:20,040 --> 00:16:20,920
...أيّها الـ

227
00:16:20,920 --> 00:16:25,760
.لقد كنت أبذل كلّ ما في وسعي أيضًا

228
00:16:25,760 --> 00:16:28,300
!انتقلت إلى مكانٍ غريب

229
00:16:28,300 --> 00:16:31,060
!لم أعرف أحدًا هناك

230
00:16:31,060 --> 00:16:35,310
!وبطريقةٍ ما تمكّنت من الوصول إلى هنا

231
00:16:35,310 --> 00:16:38,650
!لمَ تحاول لومي على هذا؟

232
00:16:39,900 --> 00:16:42,900
!لأنّي أعرف أنّ بإمكانك أن تفعل أفضل ممّا فعلته

233
00:16:42,900 --> 00:16:44,320
!لا يمكنني

234
00:16:44,320 --> 00:16:46,820
!سحقًا! ما خطب هذه النظرة؟

235
00:16:46,820 --> 00:16:49,700
.هو لم يكن ينظر لي هكذا

236
00:16:49,700 --> 00:16:51,530
!سحقًا! سحقًا

237
00:16:51,530 --> 00:16:53,540
!توقّف

238
00:16:55,620 --> 00:16:58,080
!هذا يكفي

239
00:17:03,550 --> 00:17:04,760
نورن؟

240
00:17:04,760 --> 00:17:06,670
...أ-أتذكرينني؟ أنا

241
00:17:06,670 --> 00:17:09,720
!لا تعتدي على أبي

242
00:17:10,800 --> 00:17:13,680
أعتدي؟ أنا أعتدي عليه؟

243
00:17:13,680 --> 00:17:16,140
...لكن

244
00:17:23,480 --> 00:17:26,320
ما الخطب؟

245
00:17:29,780 --> 00:17:31,240
.انسَ الأمر

246
00:17:31,240 --> 00:17:32,660
.أنا مغادر

247
00:17:32,660 --> 00:17:35,040
.لم أرَ شيئًا

248
00:17:35,040 --> 00:17:37,620
.لم أفعل شيئًا

249
00:17:37,620 --> 00:17:41,630
.سأعود إلى النزل وأنتظر إيريس ورويجرد

250
00:17:41,630 --> 00:17:46,010
.وسنغادر فورًا غدًا، أو بعد غد

251
00:17:46,010 --> 00:17:48,670
.لست وحدك من انتقل آنيًّا

252
00:17:48,670 --> 00:17:52,550
.جميع من في قرية بوينا قد تورّطوا في هذه الكارثة

253
00:17:54,600 --> 00:17:56,060
ما الذي قلته؟

254
00:17:56,060 --> 00:18:00,480
.تركت رسالة عند نقابة المغامرين في ميناء زانت

255
00:18:00,480 --> 00:18:03,190
ألست مغامرًا الآن؟

256
00:18:03,190 --> 00:18:05,400
لمَ لم تقرأها؟

257
00:18:05,400 --> 00:18:10,450
!مات الكثير من الناس بينما كنت تسافر مستمتعًا

258
00:18:10,450 --> 00:18:14,450
كارثة الانتقال الآني، لماذا لم أفكّر بذلك؟

259
00:18:14,450 --> 00:18:19,410
لمَ كنت واثقًا أنّ قرية بوينا آمنة؟

260
00:18:19,410 --> 00:18:22,960
.صحيح، الجميع مفقود

261
00:18:22,960 --> 00:18:26,000
!هل هذا يعني أنّ سيلفي مفقودة أيضًا؟

262
00:18:26,000 --> 00:18:31,970
هل أنت قلقٌ على حبيبتك أكثر من أمّك؟

263
00:18:31,970 --> 00:18:35,180
!أ-أمي لم يُعثر عليها بعد؟

264
00:18:35,180 --> 00:18:40,850
!لا، لم أعثر على أيّ أثرٍ لها، ولا ليليا أو عائشة

265
00:18:40,850 --> 00:18:44,730
...لقد شكّلنا فريق البحث والإنقاذ

266
00:18:44,730 --> 00:18:48,190
.من أجل البحث عن كلّ من انتقل آنيًّا

267
00:18:48,190 --> 00:18:52,280
لـ-لمَ قد يُقدم فريق للإنقاذ والبحث على اختطاف الناس؟

268
00:18:52,280 --> 00:18:55,570
.لأنّ بعضهم قد استُعبد

269
00:18:55,570 --> 00:18:57,030
استعبد؟

270
00:18:57,030 --> 00:19:00,910
.انتقل الناس آنيًّا دون سابق إنذار، ولم يكن عندهم أدنى إلمامٍ بمكانهم

271
00:19:00,910 --> 00:19:04,130
!ثمّ خُدعوا واستعبدوا

272
00:19:04,130 --> 00:19:06,750
!حصل هذا للكثير من الناس

273
00:19:06,750 --> 00:19:08,170
!صحيح

274
00:19:08,170 --> 00:19:12,300
!ذلك الفتى كان أحد الذين تنمّروا على سيلفي

275
00:19:15,550 --> 00:19:20,560
.كنت واثقًا أنّك أدركت هذا وبدأت في التصرّف منذ زمن

276
00:19:20,560 --> 00:19:24,350
.لكنّك كنت تغامر دون الاكتراث لما يجري في العالم

277
00:19:59,760 --> 00:20:00,850
.حسنًا

278
00:20:00,850 --> 00:20:02,980
.سنتحدّث مجدّدًا في الغد

279
00:20:02,980 --> 00:20:06,560
.فهذا ليس شجارنا الأول

280
00:20:06,560 --> 00:20:08,110
.سنتفاهم إن تحدّثنا

281
00:20:08,110 --> 00:20:11,820
.سأهدّئ من روع باول، وبعدها سنخطّط لما سنفعله تاليًا

282
00:20:11,820 --> 00:20:14,490
...أجل، أوّلاً سأقابل باول

283
00:20:14,490 --> 00:20:16,990
...سأقابل باول

284
00:20:27,290 --> 00:20:28,710
!لقد عدت يا روديوس

285
00:20:28,710 --> 00:20:29,880
!انصت

286
00:20:29,880 --> 00:20:33,170
...بعد أن قتلت الغوبلين

287
00:20:35,720 --> 00:20:38,340
من؟ من فعل بك هذا؟

288
00:20:38,340 --> 00:20:39,470
.لم يحدث شيء

289
00:20:39,470 --> 00:20:41,510
!لا يعقل هذا

290
00:20:41,510 --> 00:20:43,980
ما الذي جرى؟

291
00:20:43,980 --> 00:20:46,560
.أبي في هذه المدينة

292
00:20:48,100 --> 00:20:51,020
أقال ما لا يسرّك؟

293
00:20:53,030 --> 00:20:56,820
!لماذا؟! أنتما لم تريا بعضكما منذ مدّة

294
00:20:56,820 --> 00:20:58,320
...أجل

295
00:20:58,320 --> 00:21:00,740
!سأقتله

296
00:21:00,740 --> 00:21:02,080
!دعني

297
00:21:02,080 --> 00:21:04,040
!لا تتدخّلي في خلافٍ عائلي

298
00:21:04,040 --> 00:21:07,210
!روديوس كان يبذل كلّ جهده والآن هو في حالة مزرية

299
00:21:07,210 --> 00:21:09,130
!على والده أن يشعر بالعار

300
00:21:09,130 --> 00:21:12,340
.إن كانت حالته مزرية فعليكِ مواساته

301
00:21:40,070 --> 00:21:41,740
.لا بأس

302
00:21:41,740 --> 00:21:45,200
.أنا... هنا من أجلك

303
00:21:46,200 --> 00:21:48,160
.آسفة يا روديوس

304
00:21:48,160 --> 00:21:53,460
.لست مناسبة لهذا النوع من الأمور

305
00:21:53,460 --> 00:21:55,250
.لا بأس

306
00:21:58,130 --> 00:22:02,140
.شكرًا لكِ يا إيريس