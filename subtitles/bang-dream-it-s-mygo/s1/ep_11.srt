1
00:00:33,080 --> 00:00:34,940
كان ذلك رائعاً

2
00:00:34,940 --> 00:00:36,700
!كان كذلك بحقّ

3
00:00:37,250 --> 00:00:39,050
!شكراً جزيلاً لكم

4
00:00:39,050 --> 00:00:40,140
!تأثّرتُ كثيراً

5
00:00:40,780 --> 00:00:42,380
كان مذهلاً

6
00:01:02,950 --> 00:01:03,830
توموري؟

7
00:01:03,830 --> 00:01:06,170
!ما هذا؟ لا أفهم

8
00:01:06,170 --> 00:01:08,090
!لا أفهم بدوري

9
00:01:08,090 --> 00:01:11,160
أتيتُ هنا لإنهاء الأمر

10
00:01:11,980 --> 00:01:13,090
...لذا، لمَ

11
00:01:13,570 --> 00:01:16,640
!لم أعد أعرف

12
00:01:16,640 --> 00:01:19,710
!استغللتكنّ جميعاً

13
00:01:21,390 --> 00:01:25,150
!مع ذلك... سنقوم بهذا لسائر حياتنا

14
00:01:25,150 --> 00:01:27,180
سائر حياتنا؟

15
00:01:27,880 --> 00:01:29,440
!لن يقول ذلك إلّا أحمق

16
00:01:34,660 --> 00:01:36,190
...سويو-سان

17
00:01:38,900 --> 00:01:41,090
!لا تبكي

18
00:03:20,130 --> 00:03:24,090
"في الماضي حلمتُ أنا، المعلّم جوانغ، بأنّي كنت فراشة"

19
00:03:24,090 --> 00:03:26,840
"رفرفتُ وطرت كلا شيء عدا فراشة"

20
00:03:26,840 --> 00:03:30,760
"استمتعت بنفسي وشعرت برضا تام"

21
00:03:30,760 --> 00:03:33,350
"لم أعد أعرف نفسي بصفتي المعلّم جوانغ"

22
00:03:33,350 --> 00:03:38,400
"استيقظتُ فجأةً، وكنت نفسي من جديد"

23
00:03:38,400 --> 00:03:42,120
"لا أعلم لو حلمت أنّي فراشة"

24
00:03:42,120 --> 00:03:45,410
"أو أني فراشة تحلم بأنّي أنا"

25
00:03:45,410 --> 00:03:49,630
لكن لا بدّ من وجود تمييز"
"بين نفسي وبين الفراشة

26
00:03:49,630 --> 00:03:52,360
"هذا ما يُعرف بتحوّل الأشياء"

27
00:03:52,360 --> 00:03:54,260
هل سمع أحدٌ بهذا قبلاً؟

28
00:03:54,260 --> 00:03:58,240
هذا "حلم الفراشة" للمعلّم جوانغ

29
00:04:02,830 --> 00:04:06,010
بخصوص الغدّ، كنت أفكّر بتقديم
الأمر إلى الخامسة مساءً

30
00:04:06,010 --> 00:04:08,090
ميسومي-سان، لديكِ التزامٌ قبل ذلك، صحيح؟

31
00:04:08,090 --> 00:04:09,600
آسفة، سيساعد ذلك كثيراً

32
00:04:09,600 --> 00:04:10,650
لا بأس

33
00:04:11,700 --> 00:04:12,720
أكنتِ بحاجة لشيء؟

34
00:04:14,480 --> 00:04:15,600
ليس حقّاً

35
00:04:21,750 --> 00:04:23,110
أكنتِ بحاجة لشيء؟

36
00:04:25,610 --> 00:04:27,700
أكنتِ صديقة مع ميسومي-سان دوماً؟

37
00:04:27,980 --> 00:04:30,200
تشعرين بالغيرة؟

38
00:04:40,220 --> 00:04:43,040
يبدو أنّ الأوضاع مع فرقتك استقرّت سلميّاً

39
00:04:43,640 --> 00:04:45,640
إن حصل أمرٌ ما، يمكنكِ طلب
خدمتي في أيّ وقت

40
00:04:45,640 --> 00:04:46,800
لن يحصل شيءٌ آخر

41
00:04:46,800 --> 00:04:48,610
...حسناً، حسناً

42
00:04:48,610 --> 00:04:49,960
!أويكا-تشان، صباح الخير

43
00:04:49,960 --> 00:04:51,050
!صباح الخير

44
00:04:57,200 --> 00:04:59,150
أريد الذهاب لمتجر آلات عزف

45
00:04:59,520 --> 00:05:01,710
عليّ شراء قصبة أيضاً

46
00:05:01,710 --> 00:05:02,890
أتودّين القدوم أيضاً يا سويو-تشان؟

47
00:05:02,890 --> 00:05:03,770
ماذا؟

48
00:05:03,770 --> 00:05:07,780
...حسناً، ماذا أفعل؟ لا يزال لديّ زيتٌ أيضاً

49
00:05:12,330 --> 00:05:14,280
متى الحفل المباشر التالي؟

50
00:05:14,280 --> 00:05:14,800
ماذا؟

51
00:05:14,800 --> 00:05:15,790
سنؤدي عرضاً

52
00:05:15,790 --> 00:05:17,200
أكان العرض مؤثّرا لذاك الحدّ؟

53
00:05:17,200 --> 00:05:20,040
كنّا مذهلات، أليس كذلك؟

54
00:05:20,040 --> 00:05:21,290
تأثّرت

55
00:05:25,660 --> 00:05:27,520
لن نحتاج لذلك لفترة

56
00:05:27,520 --> 00:05:29,160
...نودّ التحضير بدقّة للعرض التالي و

57
00:05:29,160 --> 00:05:30,240
لنؤدِ عرضاً

58
00:05:30,240 --> 00:05:31,000
...كما قلت

59
00:05:31,000 --> 00:05:31,820
عرض

60
00:05:31,820 --> 00:05:32,610
...أعني

61
00:05:32,610 --> 00:05:34,300
لحظة، لمَ تقولين ذلك لي وحسب؟

62
00:05:34,300 --> 00:05:35,520
عرض

63
00:05:34,960 --> 00:05:35,520
!مهلك

64
00:05:35,520 --> 00:05:38,440
لا أمل منكِ حقّاً

65
00:05:38,440 --> 00:05:39,850
هاكِ يا رانا-تشان

66
00:05:39,850 --> 00:05:41,770
إنّها حلوى شاي أخضر مبخّر بعمق

67
00:05:55,740 --> 00:05:56,880
!سويو-تشان

68
00:05:56,880 --> 00:05:59,460
!تأخّرتِ! ولم تردّي على الرسالة

69
00:06:05,150 --> 00:06:06,250
سنؤدي عرضاً

70
00:06:06,730 --> 00:06:08,210
لا أمتلك حلوى إضافيّة

71
00:06:08,210 --> 00:06:09,300
عرض

72
00:06:10,620 --> 00:06:12,380
سأذهب لشراء شاي أخضر

73
00:06:12,380 --> 00:06:13,600
ماذا؟

74
00:06:14,270 --> 00:06:16,260
...تحديق

75
00:06:18,240 --> 00:06:19,610
!سـ-سأذهب أيضاً

76
00:06:27,990 --> 00:06:30,780
رأيتُ ميتسومي-تشان قبل أيّام

77
00:06:32,450 --> 00:06:35,200
قالت أنّكِ كنت ضائعةً أيضاً يا سويو-تشان

78
00:06:39,600 --> 00:06:40,590
أجل

79
00:06:45,370 --> 00:06:46,880
أتت سويو-سان

80
00:06:46,880 --> 00:06:48,170
لمَ قد تأتي؟

81
00:06:48,170 --> 00:06:50,920
ذلك قاسٍ، ما المشكلة في قدومها؟

82
00:06:51,490 --> 00:06:52,800
أنتِ

83
00:06:52,800 --> 00:06:53,650
ماذا؟

84
00:06:55,200 --> 00:06:58,140
الغيتار، هل تمرّنتِ كثيراً؟

85
00:07:01,220 --> 00:07:03,440
تمرّنتِ حتّى عندما لم تأتي هنا، صحيح؟

86
00:07:07,760 --> 00:07:11,320
حسناً، عزفتُ بعض الشيء أحياناً
عندما راودتني رغبة بالأمر

87
00:07:11,320 --> 00:07:12,690
أنتِ لا تجيدين الكذب

88
00:07:12,690 --> 00:07:13,700
ماذا؟

89
00:07:13,700 --> 00:07:16,310
ربما من الطبيعيّ أن تتمرّني

90
00:07:21,600 --> 00:07:25,580
قالت أنّها ليست بحاجتكِ أو رانا

91
00:07:25,840 --> 00:07:28,710
!قامت باستغلالكِ لربطي وتوموري معاً وحسب

92
00:07:31,560 --> 00:07:35,680
التمرّن حتّى بعد سماع شيء كذاك... مُبهر

93
00:07:48,240 --> 00:07:50,480
وأنتِ لا تجيدين الاعتذار

94
00:07:50,480 --> 00:07:51,120
ماذا؟

95
00:07:51,120 --> 00:07:52,380
!تاكي-تشان

96
00:07:53,000 --> 00:07:55,600
هل حدّدتِ قائمة الأغاني للعرض
في عطلة نهاية هذا الأسبوع؟

97
00:07:58,810 --> 00:07:59,790
ماذا؟

98
00:08:00,830 --> 00:08:03,000
نحن في اللائحة حقّاً

99
00:08:03,000 --> 00:08:04,210
نسيت

100
00:08:04,210 --> 00:08:05,360
هل ستكنّ بخير؟

101
00:08:05,360 --> 00:08:08,120
توموري-تشان، أخذتِ قدرما استطعتِ من أماكن

102
00:08:08,120 --> 00:08:10,380
!ماذا نفعل؟ العرض بعد ثلاثة أيّام

103
00:08:10,380 --> 00:08:11,870
لا يُعقل

104
00:08:14,710 --> 00:08:17,500
ماذا عن الأغنية التي عزفناها في ذاك اليوم؟

105
00:08:17,960 --> 00:08:19,640
كيف كانت تلك الأغنية؟

106
00:08:19,640 --> 00:08:22,230
سُحِبت هنا فجأةً، وكان الأمر ارتجاليّاً

107
00:08:22,230 --> 00:08:23,330
لا يمكنني عزفها من جديد

108
00:08:23,330 --> 00:08:24,030
سنفعلها

109
00:08:24,030 --> 00:08:26,540
عزفكِ يتغيّر كلّ مرّة

110
00:08:26,540 --> 00:08:28,130
ماذا عن "هيكيتين بانسو"؟

111
00:08:28,130 --> 00:08:29,900
لن تكفي أغنية واحدة

112
00:08:29,900 --> 00:08:31,520
"لن أؤدي "ضوء شمس الربيع

113
00:08:36,890 --> 00:08:38,420
أغنية جديدة إذاً؟

114
00:08:38,420 --> 00:08:39,630
...أغنية جديدة

115
00:08:39,630 --> 00:08:40,320
سنفعلها

116
00:08:40,320 --> 00:08:41,540
أيمكننا فعلها قبل فوات الأوان؟

117
00:08:47,330 --> 00:08:48,570
تمهلن

118
00:08:48,860 --> 00:08:51,560
ألم ننسَ شيئاً أكثر أهميّة؟

119
00:08:52,290 --> 00:08:53,680
!اسم فرقتنا وأزياؤنا

120
00:08:53,680 --> 00:08:55,880
أهذا وقت ذكر ذلك؟

121
00:08:55,880 --> 00:08:57,460
أعتقد أنّ هذا الوضع الحاليّ

122
00:08:57,460 --> 00:08:58,470
ماذا؟

123
00:08:58,470 --> 00:09:00,760
!لن أتنازل عنها أبداً هذه المرّة

124
00:09:00,760 --> 00:09:03,080
هلّا فكّرتِ بالأمر على محمل الجدّ؟

125
00:09:03,080 --> 00:09:05,320
!قلتُ هذا لأنّي أفكّر بجدّية

126
00:09:05,320 --> 00:09:07,400
أتنوين الأداء بثيابكِ الخاصّة للأبد؟

127
00:09:07,400 --> 00:09:08,890
أتردن الإلغاء؟

128
00:09:10,820 --> 00:09:12,500
!سـ-سنشارك

129
00:09:12,500 --> 00:09:13,520
ماذا؟

130
00:09:13,520 --> 00:09:14,340
سنشارك

131
00:09:14,680 --> 00:09:16,040
نحن الخمسة

132
00:09:17,780 --> 00:09:19,790
حسناً، ذلك رائع

133
00:09:19,790 --> 00:09:21,330
تقولين ذلك بمُنتهى التراخي

134
00:09:21,330 --> 00:09:23,260
!أخبرتكِ، عليكنّ الأداء بتراخي

135
00:09:23,260 --> 00:09:25,160
نحن من سنتعرّض للإحراج

136
00:09:26,150 --> 00:09:28,160
ذلك منوطٌ بكنّ

137
00:09:28,160 --> 00:09:29,680
...لذا الراشدون ليسوا

138
00:09:29,680 --> 00:09:32,120
!يمكنني قول الأمر لأنّي راشدة

139
00:09:32,120 --> 00:09:33,760
لا أمانع فعلها

140
00:09:33,760 --> 00:09:35,380
عرّضت نفسي للإحراج من قبل سلفاً

141
00:09:36,820 --> 00:09:37,970
ماذا؟

142
00:09:38,640 --> 00:09:39,840
لا شيء

143
00:09:41,600 --> 00:09:44,160
أعتقد أنّ هذه الفرقة ستنجح

144
00:09:45,270 --> 00:09:49,710
لذا أودّ أداء العرض التالي بشكلٍ لائق

145
00:09:50,160 --> 00:09:53,110
نحن غير منظّمات في العادة

146
00:09:55,450 --> 00:09:58,510
!علينا التجهّز! لا وقت كافٍ قبل العرض

147
00:09:58,510 --> 00:10:00,160
توموري، القطّة الضالة

148
00:10:00,640 --> 00:10:02,610
ارجعا للبيت ثمّ تعالا لمنزلي

149
00:10:02,610 --> 00:10:05,340
سنشكّل الأغنية الجديدة بحلول الغدّ

150
00:10:06,920 --> 00:10:08,000
حسناً

151
00:10:08,790 --> 00:10:12,340
!أنا سأصنع الأزياء! سأفكّر بالتصاميم طوال الليل

152
00:10:13,500 --> 00:10:15,470
لا تعترضي عمل توموري وحسب، حسناً؟

153
00:10:15,470 --> 00:10:17,440
ماذا؟ لن أفعل ذلك

154
00:10:22,910 --> 00:10:25,040
توموري-تشان عنيدة، أليس كذلك؟

155
00:10:26,520 --> 00:10:27,840
تدركين ذلك لتوّكِ؟

156
00:10:28,190 --> 00:10:29,540
"قالت "نحن الخمسة

157
00:10:29,540 --> 00:10:32,430
ما الذي كانت تنوي فعله إن رفضت؟

158
00:10:32,430 --> 00:10:34,650
لم تفكّر بذلك غالباً

159
00:10:34,940 --> 00:10:36,320
،لو لم تكن عنيدة

160
00:10:36,320 --> 00:10:39,920
لما تمادت لحدّ مشاجرتنا لإرجاعكِ يا سويو-سان

161
00:10:39,920 --> 00:10:40,670
ماذا؟

162
00:10:41,200 --> 00:10:43,820
لم تستطع التخلّي عن أمر الفرقة أو عنكِ

163
00:10:43,820 --> 00:10:45,280
حتّى لو اقتضى ذلك أن تكون وحيدة

164
00:10:48,080 --> 00:10:52,260
نحن نتبع توموري-تشان كيف تجرّنا حقّاً

165
00:10:54,940 --> 00:10:59,090
أتعرفين، لن أدعوكِ "سويو-سان" بعد الآن

166
00:10:59,600 --> 00:11:00,470
ماذا؟

167
00:11:06,040 --> 00:11:09,480
!لن أنسحب، لذا لا تنسحبي أيضاً يا سويورين

168
00:11:09,480 --> 00:11:11,350
ماذا؟ "سويورين"؟

169
00:11:11,350 --> 00:11:13,060
لا تنسحبي، اتّفقنا؟

170
00:11:13,060 --> 00:11:14,360
!توقّفي عن ذلك

171
00:11:47,260 --> 00:11:48,390
ماذا؟

172
00:11:57,140 --> 00:11:58,130
ماذا؟

173
00:12:03,160 --> 00:12:04,640
توموري، أأنتِ بخير؟

174
00:12:06,400 --> 00:12:09,020
ماذا؟ "أنون طوكيو" هو الخيار الوحيد، صحيح؟

175
00:12:09,020 --> 00:12:10,570
لا تملكنّ حسّاً بالأسماء

176
00:12:11,540 --> 00:12:12,880
!نيمو-تشي

177
00:12:17,330 --> 00:12:19,180
!صباح الخير نيامو نيامو

178
00:12:19,180 --> 00:12:20,690
كيف حالكم جميعاً؟

179
00:12:20,690 --> 00:12:24,210
أعرف أنّ هذا مُفاجئ، لكنّي اشتريت
مجموعة طبول كهربائيّة

180
00:12:24,210 --> 00:12:26,230
هذا مُذهل

181
00:12:27,130 --> 00:12:29,080
!سأبذل قصارى جهدي

182
00:12:27,420 --> 00:12:28,850
لا، لا

183
00:12:32,250 --> 00:12:34,230
إذاً، ما الذي ستفعلينه؟

184
00:12:34,230 --> 00:12:37,200
في النهاية، لم تنتهِ الأغنية الجديدة أو الأزياء بعد

185
00:12:38,290 --> 00:12:40,390
آسفة، لم أستطع التفكير بكلمات الأغنية

186
00:12:40,830 --> 00:12:42,730
لا داعي لتضغطي على نفسك

187
00:12:43,950 --> 00:12:45,750
أيمكنكِ الإنهاء قبل فوات الأوان
دون الضغط على نفسكِ؟

188
00:12:45,750 --> 00:12:49,020
المعذرة! أنا مهتمّة بوحدة تأثيرات

189
00:12:46,570 --> 00:12:48,210
...ربما معكِ حقّ، لكن

190
00:12:49,020 --> 00:12:50,410
!قادمة

191
00:12:50,410 --> 00:12:52,670
شيء من هذا القبيل

192
00:12:52,670 --> 00:12:53,800
ما الذي تريدينه؟

193
00:12:53,800 --> 00:12:57,300
أتريدين "غيان غيان"؟ أم "غاغان"؟

194
00:12:57,300 --> 00:13:00,590
حسناً... ربما كلّها؟

195
00:13:00,590 --> 00:13:01,830
!كما مضخّم صوت

196
00:13:01,830 --> 00:13:04,040
!فوراً، سأجلبها

197
00:13:04,040 --> 00:13:05,590
لمَ تشترين هذه الآن؟

198
00:13:05,590 --> 00:13:08,550
لأنّي أريدها، ويجلب الجميع قطعهم الخاصّة

199
00:13:08,550 --> 00:13:11,390
رغم أنّكِ لن تفهمي ذلك
بصفتك قارعة الطبل

200
00:13:12,760 --> 00:13:13,760
بأيّ حال

201
00:13:13,760 --> 00:13:16,590
علينا فعل شيء على الأقلّ
حيال الأغنية الجديدة الليلة

202
00:13:16,590 --> 00:13:17,840
هل نجتمع؟

203
00:13:17,840 --> 00:13:19,530
في منزلكِ من جديد يا تاكي؟

204
00:13:19,530 --> 00:13:21,700
لن يتّسع خمسة أشخاص في منزلي

205
00:13:23,410 --> 00:13:25,910
أتردن الكلام في منزلي إذاً؟

206
00:13:38,200 --> 00:13:40,920
!ما الخطب؟ تعالا هنا واجلسا

207
00:13:42,100 --> 00:13:44,070
ماذا؟ ما الذي تأكلينه؟

208
00:13:44,070 --> 00:13:45,210
سوبا

209
00:13:45,210 --> 00:13:46,530
متى اشتريتِها؟

210
00:13:46,530 --> 00:13:47,600
من البقّالة

211
00:13:47,600 --> 00:13:48,800
لا أتذكّر أنّكِ كنت تحبّين السوبا

212
00:13:48,800 --> 00:13:51,220
ألا يُفترض بنا كتابة أغنية جديدة؟

213
00:13:56,740 --> 00:13:58,860
!كفّي عن إحداث جلبة! أنتِ تضايقين توموري

214
00:13:58,860 --> 00:13:59,750
آسفة

215
00:14:06,240 --> 00:14:07,690
!ابقي هنا

216
00:14:09,030 --> 00:14:09,950
هاكِ

217
00:14:14,240 --> 00:14:16,240
!لا يُسمح لكِ بلمس هذا

218
00:14:17,980 --> 00:14:20,960
متى بدأتِ تعلّم استعمال
الواجهة الرقميّة للآلات الموسيقيّة؟

219
00:14:23,530 --> 00:14:24,770
في المدرسة الإعداديّة

220
00:14:25,450 --> 00:14:28,760
ظننتُ قد أحتاج لها إن كنت
في فرقة مُجدّداً

221
00:14:32,760 --> 00:14:34,890
أنتِ متفانيةٌ يا ريكّي

222
00:14:35,560 --> 00:14:37,270
!تتجاهليني دوماً هكذا

223
00:14:37,270 --> 00:14:38,880
...يا إلهي

224
00:14:43,010 --> 00:14:43,600
هاكِ

225
00:14:43,600 --> 00:14:45,650
ماذا؟ شكراً لك

226
00:14:46,160 --> 00:14:47,670
سبيس"؟"

227
00:14:48,150 --> 00:14:49,670
إنّها تخصّ جدّتي

228
00:14:54,740 --> 00:14:57,280
لا داعي لترغمي نفسك على كتابة الكلمات

229
00:14:59,540 --> 00:15:00,790
...بخصوص أزيائنا

230
00:15:00,790 --> 00:15:02,160
ماذا عن شيءٍ كهذا؟

231
00:15:02,160 --> 00:15:03,200
لا مشكلة

232
00:15:03,200 --> 00:15:04,840
!سنكون شبه عاريات

233
00:15:04,840 --> 00:15:07,830
،لن نستطيع شيء كهذا أبداً
ناهيك عن ارتدائه

234
00:15:07,830 --> 00:15:09,040
ماذا؟

235
00:15:09,040 --> 00:15:11,600
ليس شيئاً ترتدينه في فرقة بالأصل، أليس كذلك؟

236
00:15:11,600 --> 00:15:15,410
لا أعتقد أنّ من الحسن
أن تستحوذ علينا الأنماط التقليديّة

237
00:15:15,410 --> 00:15:18,050
أرى أنّ من الجيّد تمثيل أنفسنا بعدّة أشكال

238
00:15:18,050 --> 00:15:19,840
كما أريد البروز

239
00:15:19,840 --> 00:15:21,400
...لذا شيء من هذا القبيل

240
00:15:21,890 --> 00:15:23,160
أو ربما هذا؟

241
00:15:23,640 --> 00:15:25,260
أو هذا؟

242
00:15:27,670 --> 00:15:30,280
عرفت الآن لمَ لم تحدّد أزياؤنا بعد

243
00:15:30,280 --> 00:15:32,120
أيّ عرض تريدين أداءه بها؟

244
00:15:32,120 --> 00:15:32,720
ماذا؟

245
00:15:32,720 --> 00:15:34,650
ألستما قاسيتين قليلاً يا ريكّي وسويورين؟

246
00:15:34,650 --> 00:15:36,920
لا تحبّ سويورين هذا حقّاً

247
00:15:36,920 --> 00:15:38,410
لكن أليست ظريفة؟

248
00:15:38,410 --> 00:15:40,040
قلت أنّها لا تروقني

249
00:15:40,040 --> 00:15:42,790
وحسّك بالأسماء يثير امتعاضي

250
00:15:42,790 --> 00:15:44,160
لا حسّ لكِ حقّاً

251
00:15:44,160 --> 00:15:46,430
!أنتما من لا تمتلكا حسّاً

252
00:15:46,430 --> 00:15:47,540
صحيح يا تومورين؟

253
00:15:47,540 --> 00:15:48,440
تومورين؟

254
00:15:48,440 --> 00:15:49,200
أنو-تشان

255
00:15:49,200 --> 00:15:50,170
!أنو-تشان"؟"

256
00:15:50,170 --> 00:15:51,490
متى حصل ذلك؟

257
00:15:52,230 --> 00:15:54,240
ما-ماذا عنّي؟

258
00:15:56,360 --> 00:15:57,300
تاكي-تشان

259
00:15:57,300 --> 00:15:58,040
ماذا؟

260
00:15:58,040 --> 00:15:59,780
!أنتِ ريكّي يا ريكّي

261
00:16:00,670 --> 00:16:02,600
!لحظة، المنظر الليليّ من هنا رهيب

262
00:16:02,600 --> 00:16:04,170
!لنلتقط صورةً معاً

263
00:16:04,170 --> 00:16:05,810
!صورة يمكننا نشرها على مواقع التواصل

264
00:16:05,810 --> 00:16:06,270
ماذا؟

265
00:16:06,270 --> 00:16:09,040
،علينا القيام بالإعلانات وما شابه
لذا فتحتُ حساباً للفرقة

266
00:16:09,040 --> 00:16:10,260
دون سؤال أحد؟

267
00:16:14,440 --> 00:16:15,750
!سألتقطها الآن

268
00:16:18,070 --> 00:16:19,700
!أنتِ أيضاً يا سويورين

269
00:16:21,340 --> 00:16:24,230
!هيّا، أسرعي يا سويورين! سويورين

270
00:16:28,470 --> 00:16:30,220
اسمي ليس سويورين

271
00:16:33,320 --> 00:16:35,640
كلّا، ما هذا؟

272
00:16:35,640 --> 00:16:37,210
أغلقت عينيّ

273
00:16:37,210 --> 00:16:38,550
هنالك شيءٌ لامع

274
00:16:38,550 --> 00:16:39,600
شبح؟

275
00:16:39,600 --> 00:16:41,300
لا أظنّ ذلك

276
00:16:41,300 --> 00:16:43,020
ماذا؟ ألن نلتقط واحدة أخرى؟

277
00:16:43,020 --> 00:16:45,340
الصور صعبة، أليس كذلك؟

278
00:16:45,340 --> 00:16:45,950
أجل

279
00:16:45,950 --> 00:16:47,480
!لنعد التقاطها

280
00:16:47,480 --> 00:16:48,560
تلك الصورة جيّدة

281
00:16:48,560 --> 00:16:51,570
!لا تقولي ذلك، هيّا، أرجوكما

282
00:16:53,210 --> 00:16:56,360
في الواقع، كنتُ أعرف ما يجول ببالكِ

283
00:16:56,360 --> 00:16:57,130
ماذا؟

284
00:16:57,130 --> 00:16:59,850
"عرفتُ أنّكِ لم تستطيعي نسيان "كرايشيك

285
00:17:00,570 --> 00:17:03,670
عرفتُ ذلك واستغللتكِ بدوري

286
00:17:04,840 --> 00:17:08,000
لذا... أنا فظيعةٌ أيضاً

287
00:17:08,830 --> 00:17:10,070
تاكي-تشان

288
00:17:10,490 --> 00:17:11,960
هذا كلّ ما لديّ لأقوله

289
00:17:22,070 --> 00:17:23,760
ما الذي سنفعله؟

290
00:17:23,760 --> 00:17:25,040
!العرض بالغد

291
00:17:25,040 --> 00:17:27,040
!لم ننجز شيئاً هذه المرّة أيضاً

292
00:17:27,040 --> 00:17:28,270
!أعرف ذلك

293
00:17:28,270 --> 00:17:30,030
ماذا سنفعل حيال الأزياء؟

294
00:17:30,030 --> 00:17:31,970
أنحتاج لها بالمقام الأوّل؟

295
00:17:31,970 --> 00:17:32,920
!أجل

296
00:17:34,400 --> 00:17:35,360
!سنتأخّر

297
00:17:35,360 --> 00:17:36,660
توموري، أتودّين التغيّب اليوم؟

298
00:17:36,660 --> 00:17:38,540
كلّا! لمَ لا تكتبيها في المدرسة؟

299
00:17:38,540 --> 00:17:40,410
لنشترِ إفطاراً من مكانس ما

300
00:17:40,410 --> 00:17:42,400
حصلتُ على قطعة خبز من سينباي

301
00:17:42,400 --> 00:17:43,730
قرن شوكولاته؟

302
00:17:43,740 --> 00:17:44,930
ربما

303
00:17:44,930 --> 00:17:46,250
ربما؟

304
00:17:54,330 --> 00:17:57,300
،كان سباتي الربيعيّ بغاية الراحة
فلم ألاحظ قدوم الفجر

305
00:17:57,300 --> 00:17:59,360
بدأتُ بسماع زقزقة العصافير
من كلّ الأرجاء

306
00:17:58,920 --> 00:18:00,580
انتهيت

307
00:17:59,360 --> 00:18:01,220
البارحة، كان صوت الرياح والمطر شديداً

308
00:18:01,170 --> 00:18:03,050
!تومورين! تومورين

309
00:18:01,220 --> 00:18:03,060
فلا بدّ أنّ عدداً من الأزهار سقط أيضاً

310
00:18:03,050 --> 00:18:05,020
،عالم المناخ الألمانيّ، كوبّين

311
00:18:05,020 --> 00:18:08,400
قسّم المناخات إلى النابتة وغير النابتة

312
00:18:08,400 --> 00:18:11,180
يُشار إليها الآن بتصنيف كوبّين المناخيّ

313
00:18:11,180 --> 00:18:14,090
...يمكن تقسيمها أيضاً وفق درجة الحرارة و

314
00:18:12,890 --> 00:18:14,590
معدتي تؤلمني، لذا سأرجع للبيت

315
00:18:14,590 --> 00:18:16,490
!ماذا؟ اعتني بنفسك

316
00:18:16,490 --> 00:18:17,470
ماذا؟

317
00:18:25,600 --> 00:18:26,560
ماذا؟

318
00:18:27,650 --> 00:18:30,330
ومن قالت أنّها أرادت فعل هذا؟

319
00:18:30,330 --> 00:18:31,260
،بصراحة

320
00:18:31,260 --> 00:18:34,080
من المستحيل عليّ أن أنجز أزياء
خمسة أشخاص بمفردي

321
00:18:34,080 --> 00:18:35,970
عليكِ أن تكوني أكثر مراعاة

322
00:18:37,350 --> 00:18:38,470
ستضيفين أشياء لهذه؟

323
00:18:38,470 --> 00:18:39,870
ألا يمكننا ارتداؤها كما هي؟

324
00:18:39,870 --> 00:18:40,720
!كلّا

325
00:18:41,960 --> 00:18:44,380
!لا تقطعي الورق! بل القماش

326
00:18:44,380 --> 00:18:45,360
القماش؟

327
00:18:46,100 --> 00:18:48,130
لا نملك وقتاً للعبث، أليس كذلك؟

328
00:18:49,230 --> 00:18:51,230
أنون طوكيو

329
00:19:00,050 --> 00:19:02,370
هل أنهيتِ الأغنية؟

330
00:19:02,370 --> 00:19:03,800
أنهيتُ اللحن قبل قدومي

331
00:19:03,800 --> 00:19:07,420
اللحن؟ ساعديني بصنع الأزياء أيضاً

332
00:19:07,420 --> 00:19:08,440
توموري؟

333
00:19:08,830 --> 00:19:11,010
آسفة يا توموري، استيقظي

334
00:19:11,010 --> 00:19:13,000
يمكنكِ سماعي، صحيح؟

335
00:19:13,000 --> 00:19:14,720
علينا إنهاء التنظيم

336
00:19:15,090 --> 00:19:16,260
أتسمعيني؟

337
00:19:16,260 --> 00:19:18,280
قالت أنّها تحرص على عدم السهر في العمل

338
00:19:18,280 --> 00:19:19,370
ماذا؟

339
00:19:19,370 --> 00:19:20,890
...رانا-تشان، هل الأزياء

340
00:19:22,270 --> 00:19:24,760
ما خطب هذه الفرقة؟

341
00:19:33,450 --> 00:19:36,420
كم عليكِ عزف الغيتار قبل أن تصبحي هكذا؟

342
00:19:36,420 --> 00:19:37,670
إنّه يخصّ جدّتي

343
00:19:37,670 --> 00:19:39,030
جدّتكِ؟

344
00:19:39,030 --> 00:19:41,040
ذكرتِها عندما أعطيتِني ريشة العزف تلك أيضاً

345
00:19:41,040 --> 00:19:42,900
القرمزيّ الإعجازيّ

346
00:19:42,900 --> 00:19:45,530
الإعجازيّ... ماذا؟

347
00:19:45,530 --> 00:19:47,260
عزفت في دار حفلاتها الخاصّ

348
00:19:48,210 --> 00:19:49,530
"سبيس"

349
00:19:49,910 --> 00:19:51,980
ظننتُ أنّه سيكون موجوداً لسائر حياتي

350
00:19:51,980 --> 00:19:53,620
لكنّه زال الآن

351
00:19:55,390 --> 00:20:00,800
لكنّها قالت أنّ أحداً سيصنع
مكاناً آخر لي لأنتمي له

352
00:20:07,180 --> 00:20:08,560
عمتنّ مساءً

353
00:20:08,560 --> 00:20:09,670
!مهلاً! لا تنامي

354
00:20:09,670 --> 00:20:11,190
ماذا سنفعل حيال الأغنية؟

355
00:20:11,190 --> 00:20:13,080
هذا سريري

356
00:20:13,080 --> 00:20:14,400
...سائر حياة

357
00:20:16,080 --> 00:20:18,520
سائر الحياة أمرٌ صعب

358
00:20:19,000 --> 00:20:20,560
صعب جدّاً

359
00:20:22,400 --> 00:20:26,800
كنتُ... أخشى التعرّض للأذى

360
00:20:27,790 --> 00:20:30,830
أردتُ العزف في فرقة... لسائر حياتي

361
00:20:31,960 --> 00:20:33,210
...لكن

362
00:20:33,950 --> 00:20:37,080
حياة دون التعرّض للأذيّة... مستحيلة

363
00:20:37,840 --> 00:20:41,600
...تتعرّض للجروح... ويغطّيك الوحل

364
00:20:42,000 --> 00:20:43,910
عليك الكفاح والقتال كثيراً

365
00:20:44,880 --> 00:20:46,280
...مع ذلك

366
00:20:47,450 --> 00:20:49,830
...أريد أن أكون في فرقة معكنّ

367
00:20:50,740 --> 00:20:54,350
مهما سقطت أو ضللت من مرّات

368
00:20:56,880 --> 00:20:58,000
!هذا هو

369
00:20:58,000 --> 00:20:59,020
ماذا؟

370
00:20:59,020 --> 00:21:00,320
أنون-تشان؟

371
00:21:02,630 --> 00:21:04,800
!وجدته! هذا

372
00:21:05,920 --> 00:21:07,780
!اسم فرقتنا

373
00:21:08,440 --> 00:21:10,000
!فرقة الفتيات الضالّات

374
00:21:44,940 --> 00:21:46,320
...زيّي

375
00:21:46,830 --> 00:21:48,950
!قُطِع