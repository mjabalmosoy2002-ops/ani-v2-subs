1
00:00:02,520 --> 00:00:04,710
!لمَ غنّيتِ "ضوء شمس الربيع"؟

2
00:00:05,530 --> 00:00:07,500
!قلتِ أنّكِ لن تفعلي ذلك

3
00:00:08,020 --> 00:00:09,520
لم أقل ذلك

4
00:00:12,050 --> 00:00:14,280
كانت ساكي-تشان تبكي

5
00:00:14,280 --> 00:00:15,980
ماذا؟ كانت هنا؟

6
00:00:17,280 --> 00:00:19,230
أتفهمين مدى تألّمها؟

7
00:00:19,230 --> 00:00:19,960
وما في ذلك؟

8
00:00:20,920 --> 00:00:22,340
وماذا إن بكت؟

9
00:00:22,340 --> 00:00:23,700
لا علاقة لذلك بنا، أليس كذلك؟

10
00:00:26,040 --> 00:00:27,300
!أنتِ فظيعة

11
00:00:28,210 --> 00:00:29,550
!سووي-سان

12
00:02:04,780 --> 00:02:07,480
!كانت الحفلة بالأمس مُذهلة

13
00:02:07,480 --> 00:02:10,000
!كنتِ تغنّين حقّاً يا وتموري-تشان

14
00:02:10,000 --> 00:02:11,740
!كأنّكِ شخص لم ألتقه قبلاً

15
00:02:11,740 --> 00:02:13,520
!كنتِ بغاية الروعة

16
00:02:13,520 --> 00:02:16,240
!كانت وتموري-تشان وأنون-تشان مذهلتين

17
00:02:17,240 --> 00:02:19,460
!استطعتُ رؤيتكم جميعاً من على المسرح

18
00:02:19,460 --> 00:02:21,360
ماذا؟ حقّاً؟

19
00:02:21,360 --> 00:02:23,660
!أودّ أن نعزف بشكل مباشر سريعاً أيضاً

20
00:02:23,660 --> 00:02:24,750
أعرف، صحيح؟

21
00:02:24,750 --> 00:02:25,600
صدقتِ

22
00:02:25,600 --> 00:02:27,370
أتوق لذلك

23
00:02:26,190 --> 00:02:27,370
!تأثّرتُ كثيراً

24
00:02:28,600 --> 00:02:32,020
سووي-سان لطيفة، ستسامحنا

25
00:02:34,180 --> 00:02:37,080
أتساءل لمَ أتت ساكيكن-تشان

26
00:02:45,440 --> 00:02:49,100
أكنتِ تعرف أنّها هنا في هانيبالا؟

27
00:02:50,910 --> 00:02:52,860
في الفصل المجاور لنا

28
00:02:56,140 --> 00:02:58,040
أتريدين الذهاب لرؤيتها؟

29
00:02:58,610 --> 00:03:00,380
لا أستطيع التوقّف
عن التفكير بالأمر أيضاً

30
00:03:10,570 --> 00:03:12,040
ساكيكن-تشان؟

31
00:03:12,040 --> 00:03:14,040
من تلك؟ أتعرفينها؟

32
00:03:14,040 --> 00:03:15,520
قد تكون في فصلٍ مختلف؟

33
00:03:15,520 --> 00:03:16,310
ماذا؟

34
00:03:18,600 --> 00:03:20,560
!أسأل عن ساكيكن-تشان، ساكيكن-تشان

35
00:03:20,560 --> 00:03:23,030
تعزف على البيانو أحياناً
في غرفة الموسيقى

36
00:03:23,760 --> 00:03:25,110
!إنّها بارعةٌ جدّاً

37
00:03:25,110 --> 00:03:26,260
أسمعتِ بها؟

38
00:03:26,260 --> 00:03:27,080
لا

39
00:03:27,080 --> 00:03:28,660
ماذا؟ لا تعرفنها؟

40
00:03:28,660 --> 00:03:30,280
قد تكون في نادي الجاز؟

41
00:03:31,140 --> 00:03:33,020
لا أعتقد أنّها تعزف على الجاز

42
00:03:35,650 --> 00:03:36,400
!ساكيكن-تشان

43
00:03:38,650 --> 00:03:40,840
أكنتِ تقصدين توغلوا-سان؟

44
00:03:40,840 --> 00:03:43,610
اسمها الأوّل ساكيكن إذاً؟

45
00:03:52,060 --> 00:03:53,650
هل فشلتِ في عرضك المباشر الأوّل

46
00:03:53,650 --> 00:03:55,760
وأتيتِ راجعةً بذيلك بين ساقيك؟

47
00:03:56,960 --> 00:03:58,720
كان نجاحاً كبيراً

48
00:03:59,020 --> 00:04:00,140
هكذا إذاً

49
00:04:00,720 --> 00:04:02,600
هاكِ إذاً، للاحتفال

50
00:04:06,740 --> 00:04:10,020
لا أستطيع التوصّل وسبيو-سان أبداً

51
00:04:11,250 --> 00:04:13,520
...ثلاثة أيّام كثيرة

52
00:04:13,880 --> 00:04:16,130
تردّ من فورها في العادة

53
00:04:19,520 --> 00:04:22,510
علينا الكلام مع سووي-سان

54
00:04:22,510 --> 00:04:24,900
أتساءل ما إن كانت يريك
تستطيع التواصل معها

55
00:04:31,280 --> 00:04:32,280
دعيها وشأنها

56
00:04:32,280 --> 00:04:32,840
ماذا؟

57
00:04:32,840 --> 00:04:35,040
ما الذي سنفعله حيال عرضنا التالي وما شابه؟

58
00:04:35,040 --> 00:04:36,280
سنعزف من جديد

59
00:04:36,280 --> 00:04:37,790
ماذا عن سووي-سان؟

60
00:04:39,160 --> 00:04:40,320
أتستمعين؟

61
00:04:40,320 --> 00:04:41,260
ماذا عن رانا-تشان؟

62
00:04:41,260 --> 00:04:43,670
أتعتقدين أنّها تطّلع على هاتفها بالأصل؟

63
00:04:45,090 --> 00:04:47,300
،إن كنتما تسألان عن رانا-تشان
!فقد كانت هنا بالأمس

64
00:04:47,300 --> 00:04:47,970
ماذا؟

65
00:04:47,970 --> 00:04:51,310
متى تأتي رانا-تشان هنا في العادة؟

66
00:04:51,310 --> 00:04:53,700
أعتقد أنّها تأتي متى شعرت
برغبة بالعزف على الغيتار

67
00:04:53,700 --> 00:04:56,540
للعرض الفائت، كانت تأتي
وتختفي متى أرادت، صحيح؟

68
00:04:56,540 --> 00:04:57,640
الفائت؟

69
00:04:58,110 --> 00:04:59,560
!المعذرة

70
00:04:59,560 --> 00:05:01,310
!قادمة

71
00:05:05,400 --> 00:05:06,220
!مهلاً

72
00:05:06,220 --> 00:05:07,190
...لم نتوصّل بشيءٍ بعد

73
00:05:07,190 --> 00:05:09,100
هي الغاضبة

74
00:05:09,100 --> 00:05:10,740
!يريك

75
00:05:13,410 --> 00:05:16,130
يقوم الجميع بأيّ ما يريدونه

76
00:05:18,940 --> 00:05:20,510
أودّ الاعتذار

77
00:05:20,510 --> 00:05:21,370
ماذا؟

78
00:05:21,370 --> 00:05:23,000
لسووي-تشان

79
00:05:23,000 --> 00:05:26,800
لا أدري ما إن كان الاعتذار
هو الفعل الصائب

80
00:05:27,310 --> 00:05:30,520
لكن من الصحيح أنّي جرحتها

81
00:05:32,950 --> 00:05:36,720
يذهب الجميع في اتّجاهات مختلفة من جديد

82
00:05:38,440 --> 00:05:41,520
...على هذا المنوال، الفرقة سوف

83
00:05:46,120 --> 00:05:47,350
وتموري-تشان؟

84
00:05:57,760 --> 00:05:58,870
!انتظري

85
00:05:58,870 --> 00:06:00,840
ذاك الجزء صعب، أليس كذلك؟

86
00:06:00,840 --> 00:06:02,270
بالفعل

87
00:06:02,270 --> 00:06:03,080
صحيح؟

88
00:06:03,080 --> 00:06:03,960
المعذرة

89
00:06:04,500 --> 00:06:06,480
هل ناغازاكي سووي-تشان هنا؟

90
00:06:06,480 --> 00:06:08,640
!آسفة، لن نطيل

91
00:06:08,640 --> 00:06:10,310
تغيّبت سووي-تشان بالأمس

92
00:06:10,310 --> 00:06:10,890
ماذا؟

93
00:06:10,890 --> 00:06:13,220
طال زكامها الآن، أليس كذلك؟

94
00:06:24,190 --> 00:06:26,910
أتساءل ما إن كانت سووي-سان
تعاني من زكامٍ حقّاً

95
00:06:33,780 --> 00:06:36,490
المحطّة من هنا، أين تذهبين؟

96
00:06:43,250 --> 00:06:44,310
للمنزل

97
00:06:46,040 --> 00:06:48,920
وتموري-تشان منزلكِ قريبٌ
!من "تسوكين وموري" حقّاً

98
00:06:59,390 --> 00:07:00,960
مُذهل

99
00:07:14,380 --> 00:07:15,660
مشروب

100
00:07:18,020 --> 00:07:21,210
!حليب؟ يُشعرني بالحنين

101
00:07:21,210 --> 00:07:22,660
!شكراً لكِ

102
00:07:30,630 --> 00:07:32,940
أيمكن أنّ كلّ هذه كلمات أغاني؟

103
00:07:32,940 --> 00:07:34,310
!حشرات؟

104
00:07:37,100 --> 00:07:38,520
خنفساء كابتو

105
00:07:38,520 --> 00:07:41,210
كلّ الحشرات حشرات

106
00:07:41,210 --> 00:07:42,790
...سوكي-تشان

107
00:07:44,780 --> 00:07:48,400
هي من اصطحبتني إلى مكانٍ لامع

108
00:07:49,360 --> 00:07:51,860
جلبت الجميع لي أيضاً

109
00:07:53,050 --> 00:07:55,610
..."عندما بدأت "كرا يشيك

110
00:07:56,690 --> 00:08:00,500
كان الشعور بغاية الدفء

111
00:08:01,800 --> 00:08:02,990
...كلّه

112
00:08:04,270 --> 00:08:05,750
بسبب تواجد ساكي-تشان هناك

113
00:08:07,340 --> 00:08:08,350
...ومع ذلك

114
00:08:10,730 --> 00:08:12,040
"ضوء شمس الربيع"

115
00:08:12,610 --> 00:08:16,880
عندما غنّيتها... جرحتها

116
00:09:04,640 --> 00:09:08,400
أرى أنّكِ تحبّين النجوم
كعادتكِ يا وأيكا

117
00:09:08,400 --> 00:09:09,780
!ساكي-تشان

118
00:09:12,290 --> 00:09:14,350
آسفة

119
00:09:14,350 --> 00:09:16,680
أعرف أنّي من دعوتك، لكن عليّ العودة عمّ قريب

120
00:09:16,680 --> 00:09:19,710
لا بأس، سرّني لقاؤكِ ولو لفترة قصيرة

121
00:09:21,530 --> 00:09:24,010
مضى عامٌ تقريباً مُذ آخر
مرّة التقينا فيها، صحيح؟

122
00:09:24,010 --> 00:09:25,480
شكراً على استدعائي

123
00:09:25,480 --> 00:09:27,910
،أتى الأمر من العدم، فتفاحات
لكنّي كنت مسرورة أيضاً

124
00:09:27,910 --> 00:09:30,790
ليس بشيءٍ يستدعي الشكر

125
00:09:30,790 --> 00:09:34,420
عندما أطّلع على رسائلكِ، تمدّني بالشجاعة دوماً

126
00:09:35,050 --> 00:09:37,550
الرسالة التي أرسلتِها لي عندما
...تأكّد ظهوري الأوّل

127
00:09:37,550 --> 00:09:40,010
"ستصبحين محترفة كما كنتِ تتمنّين بشدّة"

128
00:09:40,010 --> 00:09:41,200
...تلك كانت دوماً

129
00:09:41,200 --> 00:09:42,670
حفظتِها؟

130
00:09:42,670 --> 00:09:46,070
كما أخبرتك، أقرؤها طوال الوقت

131
00:09:47,440 --> 00:09:49,820
هل يمضي عملك بخير؟

132
00:09:50,750 --> 00:09:52,160
إنّه بخير

133
00:09:52,160 --> 00:09:54,810
ماذا عنكِ يا ساكي-تشان؟
أنتِ في فرقة، صحيح؟

134
00:09:54,810 --> 00:09:55,940
ماذا؟

135
00:09:55,940 --> 00:09:58,680
كانت حفلتكنّ العام الفائت مُذهلة

136
00:09:58,680 --> 00:10:02,070
...ما كان اسمها؟ كراي

137
00:10:02,360 --> 00:10:04,200
كفّي عن الكلام عن ذلك رجاءً

138
00:10:09,460 --> 00:10:10,430
آسفة

139
00:10:11,460 --> 00:10:12,640
لا بأس

140
00:10:14,060 --> 00:10:16,550
لمَ أردتِ القدوم لهذا السطح؟

141
00:10:18,200 --> 00:10:20,100
لأنّه قريبٌ من السماء

142
00:10:22,520 --> 00:10:26,560
لطالما تسمّرنا في السماء معاً
في الصيف، أليس كذلك؟

143
00:10:26,560 --> 00:10:28,430
كان ذلك مسليّاً جدّاً

144
00:10:28,430 --> 00:10:31,960
عندما يأتي الصيف، تأتي ساكي-تشان للجزيرة

145
00:10:54,540 --> 00:10:58,680
لم يخطر لي قطّ أنّي سأستطيع
أن أصبح صديقتك

146
00:10:59,900 --> 00:11:02,310
دعوتِني لصيد الحشرات، أليس كذلك؟

147
00:11:02,310 --> 00:11:04,040
ماذا؟ أنتِ من دعوتِني يا ساكي-تشان

148
00:11:04,040 --> 00:11:05,520
حقّاً؟

149
00:11:05,520 --> 00:11:06,600
أجل

150
00:11:06,600 --> 00:11:10,760
ثمّ ظهر عنكبوتٌ عملاق وصرختِ هكذا

151
00:11:10,760 --> 00:11:12,320
!كانت تلك أنتِ يا وأيكا

152
00:11:16,840 --> 00:11:18,690
أشعر بالحنين

153
00:11:34,080 --> 00:11:35,570
حان وقت رحيلي

154
00:11:39,620 --> 00:11:40,730
،وأيكا

155
00:11:40,730 --> 00:11:43,720
هنالك ما أريد مناقشته معكِ

156
00:12:04,950 --> 00:12:08,950
كيف تعرف إنّ تم حجبك
على مواقع التواصل

157
00:12:20,560 --> 00:12:22,090
طاب يومك

158
00:12:22,090 --> 00:12:23,200
سووي-تشان

159
00:12:23,200 --> 00:12:24,460
هل تحسّن زكامكِ؟

160
00:12:24,460 --> 00:12:26,220
أعتذر على إقلاقكنّ

161
00:12:26,220 --> 00:12:28,340
سجّلت مذكّرة لك أثناء غيابك

162
00:12:28,340 --> 00:12:29,340
!شكراً لكِ

163
00:12:29,340 --> 00:12:30,050
لا بأس

164
00:12:30,050 --> 00:12:31,600
فأنتِ تطلعيني على مذكّرتك دوماً

165
00:12:31,600 --> 00:12:33,340
...مذكّرتكِ مفيدة حقّاً

166
00:12:37,840 --> 00:12:40,060
انتهينا باكراً اليوم

167
00:12:40,060 --> 00:12:41,740
كان مستوى الجميع رائعاً

168
00:12:41,740 --> 00:12:43,300
تمكنّا من التركيز

169
00:12:43,300 --> 00:12:45,410
ربما كان ذلك لتمريننا
على أجزائنا بشكل فرديّ

170
00:12:45,410 --> 00:12:46,910
ذلك بفضلكِ يا سووي-تشان

171
00:12:46,910 --> 00:12:48,800
الأمر ليس كذلك أبداً

172
00:12:48,800 --> 00:12:52,240
أعتقد أنّ السبب هو تمرّن
الجميع باجتهاد في البيت

173
00:12:52,630 --> 00:12:54,050
تظنّين ذلك؟

174
00:12:54,060 --> 00:12:55,870
!أطريني أيضاً

175
00:12:55,870 --> 00:12:58,370
!اجتهدتِ كثيراً في تمرين الصباح

176
00:13:05,390 --> 00:13:07,610
أدهشتِني في ذاك اليوم

177
00:13:07,610 --> 00:13:10,170
رؤيتكِ أنتِ وساكي-تشان
...تأتيان للحفلة فجأةً

178
00:13:10,170 --> 00:13:12,640
أجلبتِها هناك يا موسومي-تشان؟

179
00:13:14,600 --> 00:13:17,880
،بما أنّ ساكي-تشان أتت معك

180
00:13:17,880 --> 00:13:21,890
أتعتقدين أنّ ذلك يعني
أنّها تفكّر بنا بإيجابيّة؟

181
00:13:21,890 --> 00:13:23,770
ليس الأمر كذلك

182
00:13:25,510 --> 00:13:29,160
موسومي-تشان، أنتِ تقولين أيّ
ما تفكّرين به حقّاً، صحيح؟

183
00:13:29,160 --> 00:13:31,020
كلّها أشياء لا تريدين منّي فعلها

184
00:13:31,600 --> 00:13:33,780
رغم أنّكِ لا تقومين بأيّ
ما أطلبه منك

185
00:13:40,130 --> 00:13:43,330
موسومي-تشان، أودّ منكِ مساعدتي

186
00:13:44,000 --> 00:13:46,840
تعرفين أين منزل ساكي-تشان، صحيح؟

187
00:13:48,130 --> 00:13:49,240
أرجوكِ

188
00:13:52,220 --> 00:13:54,040
إنّها غلطتكِ يا موسومي-تشان

189
00:13:54,040 --> 00:13:56,600
ما حصل آنذاك، وما يحصل الآن أيضاً

190
00:14:04,960 --> 00:14:06,040
دوّنيها

191
00:14:06,040 --> 00:14:08,420
أدوّن؟ ماذا؟

192
00:14:09,160 --> 00:14:11,780
!لديكِ رسائلٌ كثيرة هنا

193
00:14:11,780 --> 00:14:13,350
هل تقرئينها حقّاً؟

194
00:14:14,960 --> 00:14:16,040
أقرؤها

195
00:14:16,040 --> 00:14:19,210
،إن قرأتِها في مركز الرسائل
فلن تظهر أنّه تمّ قراءتها

196
00:14:19,210 --> 00:14:20,410
تظهر أنّه تمّ قراءتها؟

197
00:14:20,410 --> 00:14:24,540
مع ذلك، من كان ليتصوّر
انضمامكِ لفرقة يا رانا-تشان

198
00:14:24,540 --> 00:14:26,430
توجد نساء مثيرات للاهتمام هناك

199
00:14:27,100 --> 00:14:29,020
"لا تقولي "نساء

200
00:14:29,020 --> 00:14:31,050
تقصدين "فتيات"، صحيح؟

201
00:14:31,690 --> 00:14:33,160
فتيات؟

202
00:14:41,930 --> 00:14:43,580
ماذا؟ رانا-تشان؟

203
00:14:43,580 --> 00:14:44,570
أرأيتِ؟

204
00:14:45,160 --> 00:14:46,840
تقول أنّها تودّ القيام بالفرقة

205
00:14:47,680 --> 00:14:48,700
"لنذهب إلى "يرغن

206
00:14:49,200 --> 00:14:52,280
إذا لم نسرع، ستختفي رانا-تشان

207
00:15:04,150 --> 00:15:05,720
!ها هي

208
00:15:06,470 --> 00:15:09,520
شكراً على رسالتك! أعتذر على الإطالة عليك

209
00:15:09,520 --> 00:15:10,880
أين سووي-سان؟

210
00:15:13,480 --> 00:15:14,960
هل ننتظر قليلاً؟

211
00:15:14,960 --> 00:15:16,220
لا يهمّ حقّاً

212
00:15:16,220 --> 00:15:17,400
لم نعزف منذ العرض

213
00:15:17,400 --> 00:15:19,930
إن بدأنا دون سووي-سان، قد لا يعجبها الأمر

214
00:15:19,930 --> 00:15:21,710
من الأفضل انتظار قدوم الجميع

215
00:15:21,710 --> 00:15:23,110
إن أرادت العزف، فستأتي

216
00:15:23,110 --> 00:15:25,300
ليس ذلك ما أتكلّم عنه

217
00:15:29,380 --> 00:15:30,400
أجل

218
00:15:30,400 --> 00:15:33,120
من الأفضل أن تكون
سووي-تشان هنا أيضاً

219
00:15:35,990 --> 00:15:38,590
!رأيتِ؟ تقول وتموري-تشان الأمر نفسه

220
00:15:40,440 --> 00:15:44,130
لكن... التمرين مهمٌّ أيضاً

221
00:15:46,000 --> 00:15:47,760
ماذا؟ أيّهما؟

222
00:15:49,060 --> 00:15:50,250
وتموري؟

223
00:15:57,260 --> 00:15:59,520
فتيات مُملات

224
00:16:00,830 --> 00:16:02,610
...ماذا؟ لحظة

225
00:16:02,610 --> 00:16:03,950
أين تذهبين؟

226
00:16:06,390 --> 00:16:07,980
!مهلك

227
00:16:13,370 --> 00:16:14,450
ماذا؟

228
00:16:14,450 --> 00:16:17,040
أنتِ من استدعتنا هنا

229
00:17:13,150 --> 00:17:14,330
ساكي-تشان

230
00:17:15,360 --> 00:17:18,960
شكراً على لقائكِ بي اليوم

231
00:17:21,240 --> 00:17:23,840
لا تغضبي من موسومي-تشان

232
00:17:23,840 --> 00:17:28,150
أردتُ قول أنّي أودّ الذهاب لمنزلك
وأرغمتها على مساعدتي

233
00:17:34,430 --> 00:17:35,860
أنا آسفة

234
00:17:35,860 --> 00:17:38,790
كان عليّ لقاؤكِ والاعتذار مهما حصل

235
00:17:48,780 --> 00:17:52,240
!ضوء شمس الربيع"! لم نكن ننوي عزفها بالأصل"

236
00:17:52,240 --> 00:17:54,980
ذاك اليوم، كنّا سنغنّي أغنية واحدة

237
00:17:54,980 --> 00:17:57,090
!لم أرد عزفها بدوري

238
00:17:57,700 --> 00:18:03,020
لكنّهن بدأن أداءها، ولم يكن بيدي خيار

239
00:18:05,430 --> 00:18:07,000
آسفة

240
00:18:07,000 --> 00:18:10,060
جرحناكِ يا ساكي-تشان، أليس كذلك؟

241
00:18:10,560 --> 00:18:14,050
أعتقد أنّ من الطبيعيّ ألّا تسامحينا

242
00:18:14,720 --> 00:18:19,440
فقد غنّينا أغنية عزيزة علينا
دون أخذ إذنك

243
00:18:20,440 --> 00:18:23,450
أنا آسفةٌ حقّاً

244
00:18:23,450 --> 00:18:25,090
تتظاهرين بمساعدتي، لكنّ هذا لأجلك فقط

245
00:18:25,090 --> 00:18:25,900
ماذا؟

246
00:18:25,900 --> 00:18:29,200
،إن كان يتعلّق الأمر بأداء الأغنية
فافعلن ما تردن بها

247
00:18:29,920 --> 00:18:32,840
لكنّ "ضوء شمس الربيع" هي أغنية
...كرا يشيك" المميّزة"

248
00:18:32,840 --> 00:18:35,470
التشبّث بكلّ ذلك أمرٌ مقيت المظهر

249
00:18:36,390 --> 00:18:39,200
لمَ لا تنسي الأمر وحسب؟

250
00:18:43,250 --> 00:18:47,640
لمَ... لمَ تخبريني بالنسيان؟

251
00:18:48,140 --> 00:18:51,240
كنّا جمعياً مقرّبين من بعضنا، أليس كذلك؟

252
00:18:51,760 --> 00:18:55,260
كان كلّ يومٍ مسليّاً، وكنّا معاً

253
00:18:55,650 --> 00:18:58,480
!من الخطأ أن ننفصل هكذا

254
00:18:58,990 --> 00:19:01,570
عندما نكون في فرقة، تتوحّد أقدارنا

255
00:19:01,570 --> 00:19:03,870
ألم تكوني من قالت ذلك؟

256
00:19:04,380 --> 00:19:05,660
...القدر

257
00:19:07,740 --> 00:19:09,750
ما الفرقة الأخرى إذاً؟

258
00:19:10,430 --> 00:19:11,610
!أنتِ مخطئة

259
00:19:11,610 --> 00:19:12,900
ما الذي أخطأت فيه؟

260
00:19:12,900 --> 00:19:15,300
كلماتكِ وأفعالكِ يناقضان بعضهما

261
00:19:16,250 --> 00:19:18,950
"تحطّمت "كرا يشيك

262
00:19:18,950 --> 00:19:20,890
لن ترجع من جديد أبداً

263
00:19:24,310 --> 00:19:25,760
...لمَ

264
00:19:28,270 --> 00:19:31,270
!أرجوكِ! أودّ منح "كرا يشيك" محاولة أخرى

265
00:19:32,280 --> 00:19:35,200
أودّ العودة للوقت الذي
!كنّا نستمتع فيه كثيراً

266
00:19:35,200 --> 00:19:38,150
تريد وتموري-تشان كتاوي-تشان ذلك أيضاً

267
00:19:38,150 --> 00:19:42,840
،طلبتُ من موسومي-تشان الانضمام للفرقة
ثمّ نويت دعوتكِ أيضاً يا ساكي-تشان

268
00:19:42,840 --> 00:19:44,160
أحقّاً ذلك؟

269
00:19:45,720 --> 00:19:47,400
...أنا

270
00:19:47,400 --> 00:19:48,400
ماذا؟

271
00:19:59,710 --> 00:20:01,010
...لمَ

272
00:20:01,840 --> 00:20:03,260
أهي أنا فحسب؟

273
00:20:04,750 --> 00:20:08,930
لكن، أنتِ من بدأت "كرا يشيك" يا ساكي-تشان

274
00:20:08,930 --> 00:20:11,940
لذا أنهيتها بيديّ

275
00:20:11,940 --> 00:20:13,190
!لم تنتهِ

276
00:20:13,190 --> 00:20:14,760
...أنا

277
00:20:14,760 --> 00:20:17,820
!"حاولتُ بجدّ طوال الوقت لأجل "كرا يشيك

278
00:20:18,490 --> 00:20:20,720
لم يطلب أحدٌ منكِ ذلك

279
00:20:21,320 --> 00:20:23,420
هذه كلماتي الأخيرة في الأمر

280
00:20:23,760 --> 00:20:27,200
هذه المرّة، حاذري بالتورّط معي بعد الآن

281
00:20:33,960 --> 00:20:35,270
انتظري

282
00:20:36,740 --> 00:20:38,460
!لا تذهبي

283
00:20:38,460 --> 00:20:43,480
!أخطأتِ! أنا أهتمّ بالجميع حقّاً

284
00:20:43,480 --> 00:20:45,590
!أحبّهنّ

285
00:20:47,180 --> 00:20:48,220
!لا

286
00:20:48,840 --> 00:20:49,960
!أرجوكِ

287
00:20:50,470 --> 00:20:52,720
...ساكي-تشان، بدونكِ والبقيّة، أنا

288
00:20:52,720 --> 00:20:53,640
دعيني

289
00:20:53,640 --> 00:20:55,310
ماذا يمكنني أن أفعله لإعادتكِ؟

290
00:20:55,310 --> 00:20:57,860
!إن كان بمقدوري، فسأفعل أيّ شيء

291
00:21:00,820 --> 00:21:03,040
ما العزيمة التي تمتلكينها بينما تقولين ذلك؟

292
00:21:03,870 --> 00:21:06,270
أنتِ محض تلميذة

293
00:21:06,270 --> 00:21:08,740
أيمكنكِ تحمّل مسؤولية
حياة أحد آخر حقّاً؟

294
00:21:09,670 --> 00:21:13,600
"ذاك ثقل عبارة "سأفعل أيّ شيء

295
00:21:15,230 --> 00:21:18,300
لا تقولي أشياء لا تستطيعين الوفاء بها

296
00:21:18,300 --> 00:21:21,000
...لكنّي حقّاً

297
00:21:22,340 --> 00:21:25,960
أنتِ لا تفكّرين إلّا بنفسك، أليس كذلك؟

298
00:21:25,960 --> 00:21:27,160
ماذا؟