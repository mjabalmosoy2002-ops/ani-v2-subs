1
00:00:16,680 --> 00:00:19,460
!اشتدّت برودة الرياح

2
00:00:19,460 --> 00:00:21,730
اقترب موعد موسم المعاطف

3
00:00:21,730 --> 00:00:23,360
أنتِ ساذجةٌ يا هيمي-تشان

4
00:00:23,360 --> 00:00:24,830
ساذجة بحقّ

5
00:00:24,830 --> 00:00:28,070
أجل، لا تزال هنالك إمكانية
لأيام صيفية في تاجيمي

6
00:00:28,070 --> 00:00:29,580
حقّاً؟

7
00:00:30,310 --> 00:00:32,950
بما أنّي قرّرت التجول في تاجيمي

8
00:00:32,950 --> 00:00:35,470
ها نحن في متحف فخاريات مينو

9
00:02:13,740 --> 00:02:15,750
!يا له من منظر

10
00:02:16,250 --> 00:02:18,740
يعطي شعوراً مهيباً

11
00:02:18,950 --> 00:02:21,240
استرخي وحسب، استرخي

12
00:02:29,220 --> 00:02:30,500
!مرحباً بكنّ

13
00:02:32,290 --> 00:02:34,470
توكو-سينباي، لمَ أنتِ هنا؟

14
00:02:35,400 --> 00:02:36,650
هل اندهشتما؟

15
00:02:36,650 --> 00:02:39,060
تلقّى جدّي اتّصالاً

16
00:02:39,060 --> 00:02:44,260
يبدو أن أمين المتحف الذي كان سيرحّب
بالمجموعة الأجنبيّة أُصيب بتوعّك فجأةً

17
00:02:44,260 --> 00:02:47,870
سألوه ما إن كان يعرف فتاةً تجيد
التحدّث بالإنجليزيّة وصنع الشاي

18
00:02:47,870 --> 00:02:49,050
ولها عٌلم بالفخّار

19
00:02:49,330 --> 00:02:52,250
هذه مواصفاتك، يا للعجب

20
00:02:52,250 --> 00:02:55,630
كنتُ أعرف، لكنّي تكتّمت

21
00:02:55,630 --> 00:02:58,250
!تبدين رائعةً جدّاً في الكيمونو يا سينباي

22
00:02:58,990 --> 00:02:59,970
!شكراً لك

23
00:02:59,970 --> 00:03:03,240
!كان يُفترض أن أقول أنا ذلك

24
00:03:03,920 --> 00:03:06,660
لفخّاريات مينو تاريخٌ يرجع
ألف وثلاثمئة عاماً

25
00:03:07,030 --> 00:03:10,750
بدأ بفخّاريات سوي التي تبنّت
بعض تقنيات مملكة بايكجي

26
00:03:11,510 --> 00:03:13,030
،ثمّ أثناء فترة كاماكورا

27
00:03:13,030 --> 00:03:16,260
بدأ تطبيق الطلاء بتأثير من سيتو

28
00:03:16,260 --> 00:03:21,520
،مما أدّى لولادة أساليب كوسيتو
كيزيتو، وسيتوغورو

29
00:03:24,340 --> 00:03:26,260
ثمّ كانت هناك فخّارت شينو

30
00:03:26,260 --> 00:03:28,790
التي صُنعت لأستاذ شاي
من كيوتو، شينو سوشين

31
00:03:29,470 --> 00:03:32,120
،تحت تأثير تجارة نانبات

32
00:03:32,120 --> 00:03:34,010
ظهرت فخّاريات أوريبي في فترة
أزوتشي موموياما

33
00:03:34,320 --> 00:03:37,500
تغيّرت الأساليب بشكلٍ جذريّ

34
00:03:37,500 --> 00:03:39,000
صحيح

35
00:03:39,000 --> 00:03:41,030
ثمّ عندما ندخل القرن السابع عشر

36
00:03:41,030 --> 00:03:44,430
نرى تأثير توكوغاوا أواري
في فخّاريات أوفوكي

37
00:03:44,430 --> 00:03:46,620
!تغيّر بالكامل مجدّداً

38
00:03:49,380 --> 00:03:52,520
يروقني قدح الشاي هذا

39
00:03:52,520 --> 00:03:55,680
لستُ مندهشة، فقد صنعه كنزٌ
وطنيّ حيّ

40
00:03:55,680 --> 00:03:58,720
تقول الشائعات أنّ بعضها
تملك قيمة مئات آلاف الينّات

41
00:03:59,560 --> 00:04:01,890
ليس عليكِ التوتّر

42
00:04:07,190 --> 00:04:08,890
كان لذيذاً

43
00:04:09,340 --> 00:04:13,240
لكن مرّت فخّاريات مينو بتغييرات كبيرة حقّاً

44
00:04:13,460 --> 00:04:14,990
صحيح

45
00:04:14,990 --> 00:04:16,960
أؤمن أنّ ما فصل فخّاريات
مينو كان انفتاحها

46
00:04:16,960 --> 00:04:19,360
بدل أن تحتجزها التقاليد

47
00:04:19,360 --> 00:04:22,790
إنّها تتقبّل ثقافات مختلفة بأحضان دافئة

48
00:04:22,790 --> 00:04:25,780
تتقبّل ثقافات مختلفة؟

49
00:04:26,230 --> 00:04:27,840
ودليلاً على ذلك

50
00:04:28,530 --> 00:04:34,110
استقبلت محلّات الفخّار في هذه
البلدة الكثير من حرفيّ الفخّار الأجانب

51
00:04:34,110 --> 00:04:38,960
لم يخطر لي أنّ الناس من أرجاء
العالم يأتون هنا

52
00:04:39,190 --> 00:04:42,290
ظننتِ أنّها مجرّد بلدة ريفيّة، أليس كذلك؟

53
00:04:42,290 --> 00:04:44,470
ولا تملك شيئاً إلّا صيفاً حارّاً

54
00:04:44,470 --> 00:04:46,980
ماذا؟ كلا، ليس ذلك ما ظننتُه

55
00:04:46,980 --> 00:04:48,920
وجهك يفضحك

56
00:04:48,920 --> 00:04:50,820
!يبدو أنّكِ ستدعيننا على حسابك

57
00:04:50,820 --> 00:04:52,480
صدقاً؟

58
00:04:52,750 --> 00:04:56,580
ربما عليّ طلب كريب شاي أخضر
فوق لاتيه كستناء القيقب

59
00:04:56,580 --> 00:04:57,470
!سأشارك

60
00:04:57,910 --> 00:05:00,670
ارفقا بي

61
00:05:01,200 --> 00:05:02,630
!المعذرة

62
00:05:05,510 --> 00:05:07,250
أيمكنني طرح سؤال؟

63
00:05:07,250 --> 00:05:08,560
أ-أجل

64
00:05:08,560 --> 00:05:12,650
أين هي سوروراتو زينونيوا؟

65
00:05:13,090 --> 00:05:15,610
سورورات؟ زينونيوا؟

66
00:05:16,000 --> 00:05:17,530
ما الذي تتكلّم عنه؟

67
00:05:18,700 --> 00:05:20,240
!فهمت

68
00:05:20,240 --> 00:05:21,840
!تقصد صخرة زينوني

69
00:05:21,840 --> 00:05:23,070
صخرة زينوني؟

70
00:05:23,070 --> 00:05:25,550
توجد صخرة بذاك الاسم
في مكانٍ ما هنا

71
00:05:25,840 --> 00:05:27,710
!انتظري لحظة

72
00:05:30,520 --> 00:05:33,600
...لا أجد صخرة زينوني

73
00:05:36,000 --> 00:05:37,560
!مرحباً

74
00:05:37,560 --> 00:05:40,040
ما الذي يفعله نادي صنع الفخّار
لأكاديميّة أوري هنا؟

75
00:05:40,040 --> 00:05:42,810
!أوساوا-سان! أتيتِ في وقتك

76
00:05:45,480 --> 00:05:47,800
،أنتِ تعملين في البلديّة

77
00:05:47,800 --> 00:05:49,900
فلا بدّ أنّكِ تعرفين أين سوروات
أو صخرة زينوني

78
00:05:50,390 --> 00:05:52,810
لا بدّ أنّها نقطة سياحة مشهورة

79
00:05:52,810 --> 00:05:55,240
يبدو أنّ هذه الفتاة
تريد الذهاب إلى هناك

80
00:05:55,500 --> 00:05:58,340
سورورا أو صخرة زينوني؟

81
00:06:01,450 --> 00:06:03,430
لديّ صورة

82
00:06:03,430 --> 00:06:04,740
هنا

83
00:06:04,740 --> 00:06:06,250
!ها هي

84
00:06:07,430 --> 00:06:08,760
...هذا

85
00:06:09,460 --> 00:06:11,740
!إنّه الذي صنعته أمّك يا هيمي-تشان

86
00:06:11,740 --> 00:06:13,960
...سورا تو كازي نو نيوا - حديقة السماء والرياح

87
00:06:13,960 --> 00:06:17,610
...سوراتو و كازينونيوا

88
00:06:19,530 --> 00:06:20,900
!فهمت

89
00:06:20,900 --> 00:06:22,150
ماذا؟ ماذا؟

90
00:06:22,760 --> 00:06:24,380
إنّها لغة أسبانيّة

91
00:06:24,810 --> 00:06:26,250
فهمتِها؟

92
00:06:26,670 --> 00:06:28,700
درستُ الإسبانية في الجامعة

93
00:06:29,530 --> 00:06:30,920
المعذرة

94
00:06:30,920 --> 00:06:33,140
أسأت فهمك قليلاً

95
00:06:34,610 --> 00:06:39,660
يمكنني أن أقلّك لحديقة السماء والرياح

96
00:06:39,660 --> 00:06:42,060
!مذهل! ذلك رائع

97
00:06:42,060 --> 00:06:44,810
لمَ تعرف نحت أمّي مع ذلك؟

98
00:06:44,810 --> 00:06:46,670
لمَ أمّي؟

99
00:06:47,330 --> 00:06:51,250
صنعت أمّها ذاك التذكار

100
00:06:52,430 --> 00:06:53,450
!مذهل

101
00:06:53,450 --> 00:06:54,130
!رائع

102
00:06:54,130 --> 00:06:55,110
!بديع

103
00:06:55,110 --> 00:06:56,440
...عذراً

104
00:06:56,750 --> 00:06:58,800
!اسمي هيمينا

105
00:06:59,570 --> 00:07:01,440
مثل أمّي؟

106
00:07:02,670 --> 00:07:04,590
!يا للروعة

107
00:07:04,590 --> 00:07:07,310
!هذا لقاءٌ إعجازيّ

108
00:07:07,770 --> 00:07:10,520
أيمكننا الذهاب معك؟

109
00:07:10,520 --> 00:07:12,470
!أجل! بالطبع

110
00:07:12,830 --> 00:07:15,560
مرّي بمنزلي قليلاً من فضلك إذاً

111
00:07:16,190 --> 00:07:17,380
حسناً

112
00:07:18,730 --> 00:07:20,280
توخّي الحذر

113
00:07:20,280 --> 00:07:21,570
!حاضر

114
00:07:22,630 --> 00:07:27,370
قالت هيمينا-سان أنّها أتت إلى هنا
من المكسيك لرؤية هذا النحت فحسب

115
00:07:28,820 --> 00:07:32,090
أليست المكسيك على الجانب الآخر من العالم؟

116
00:07:32,700 --> 00:07:34,580
يا للتفاني

117
00:07:38,170 --> 00:07:41,110
إنّه وراء هذا المبنى

118
00:07:41,960 --> 00:07:44,390
!أشعر بحماس

119
00:07:45,290 --> 00:07:48,640
كيف عرفتِ عن ذاك النحت مع ذلك؟

120
00:07:49,210 --> 00:07:52,770
ارتدت مدرسة صنع فخّار في المكسيك

121
00:07:52,770 --> 00:07:54,990
كانت لدينا معلّمة يابانيّة

122
00:07:54,990 --> 00:07:56,720
كانت معلّمتك يابانيّة

123
00:07:56,720 --> 00:08:00,120
أرتنا مجلّة فخّار يابانيّة

124
00:08:00,120 --> 00:08:01,740
كانت فيها

125
00:08:01,740 --> 00:08:04,680
!مثل تلك الأشياء التي أقرأها

126
00:08:04,680 --> 00:08:09,220
فورما رأيتها في الصورة، ذاك الشكل
الغامض واللون الرائع

127
00:08:09,220 --> 00:08:10,670
!رائع

128
00:08:10,950 --> 00:08:16,190
وكان مكتوباً إنّها ستعلّم صوت ولون الرياح

129
00:08:17,290 --> 00:08:19,400
قالت أمّي ذلك

130
00:08:19,750 --> 00:08:21,610
قرأت في مقالةٍ هنا

131
00:08:21,610 --> 00:08:25,170
أنّها صنعتها لأنّها أرادت أن يعرف
الناس صوت ولون الرياح

132
00:08:25,170 --> 00:08:27,190
يا للتعليق العبقريّ

133
00:08:27,190 --> 00:08:30,020
كانت توكيكاوا هيمينا مذهلةً بحقّ

134
00:08:30,360 --> 00:08:33,250
!أريد رؤية القطعة الحقيقيّة! أريد رؤيتها

135
00:08:33,250 --> 00:08:36,460
عملتُ بجدٍّ وادّخرت مالاً
!وأتيت الآن لتاجيمي

136
00:09:15,850 --> 00:09:19,080
لمعان من السماء

137
00:09:21,060 --> 00:09:24,220
قالت كأنّ لمعانه ليس من هذا العالم

138
00:09:28,510 --> 00:09:30,510
!تلك الرياح الشمالية

139
00:09:39,500 --> 00:09:43,370
هذا الصوت مختلفٌ عن الذي
سمعتُه قبلاً

140
00:09:44,800 --> 00:09:45,930
...إنّه

141
00:09:51,980 --> 00:09:54,160
صوتٌ لطيفٌ جدّاً

142
00:09:58,650 --> 00:10:03,290
يكون الصوت في الشتاء مختلفاً
عن الصيف برياحه الجنوبيّة

143
00:10:04,310 --> 00:10:06,680
إنّه صوتٌ لطيف وناعم

144
00:10:08,530 --> 00:10:10,070
رائع

145
00:10:11,360 --> 00:10:15,120
!هيمينو، أمّك هي الأفضل

146
00:10:15,420 --> 00:10:17,550
قالت أنّ أمّكِ هي الأفضل

147
00:10:17,550 --> 00:10:19,990
!لحظـ... هيمينا-سان

148
00:10:23,110 --> 00:10:26,340
فلتستشعري شيئاً آخراً من أمّي إذاً

149
00:10:31,950 --> 00:10:34,660
مذهل، أهذا يخصّ هيمينا إذاً؟

150
00:10:35,850 --> 00:10:38,270
ألذا توقّفنا عند منزلك؟

151
00:10:39,480 --> 00:10:40,870
شكراً

152
00:10:44,130 --> 00:10:45,940
توقّفت الرياح

153
00:10:47,020 --> 00:10:49,630
لكنّي أرى الرياح

154
00:10:55,230 --> 00:10:56,840
شكراً لكنّ على اليوم

155
00:10:57,570 --> 00:11:01,600
شكراً لكِ أيضاً على قطعك كلّ تلك
المسافة لرؤية عمل أمّي

156
00:11:01,600 --> 00:11:04,430
ما الذي ستفعلينه الآن؟ سياحة؟

157
00:11:05,330 --> 00:11:08,690
!لا، لا. هذا يكفي لي

158
00:11:11,430 --> 00:11:13,450
تخييم؟

159
00:11:13,450 --> 00:11:15,180
في تلك المرتفعات؟

160
00:11:15,690 --> 00:11:18,920
ألن تشعر بالبرد ليلاً؟

161
00:11:18,920 --> 00:11:20,660
جلبتُ معها كيس نوم

162
00:11:20,660 --> 00:11:23,350
لكن ألا تخصّ تلك المنطقة المدينة؟

163
00:11:23,710 --> 00:11:27,700
يبدو أنّه لا بأس بما أنّ أوساوا-سان
قالت أنّها ستبيت معها هذه الليلة

164
00:11:29,850 --> 00:11:33,200
أتت لأنّها أرادت رؤية ذاك النحت إذاً؟

165
00:11:33,470 --> 00:11:36,210
يبدو أنّ ابنتي كانت مذهلة حقّاً

166
00:11:36,210 --> 00:11:38,710
ليست مجرّد آنسة صغيرة مُتعبة

167
00:11:38,710 --> 00:11:41,840
أمّي... صغيرة مُتعبة؟

168
00:11:43,210 --> 00:11:45,720
لكنّ ذلك رائعٌ بحقّ

169
00:11:45,940 --> 00:11:51,460
جذب عملها شخصاً من الجانب الآخر للعالم

170
00:11:58,570 --> 00:12:02,480
...ثمّ بعد بضعة أيام، في المساء

171
00:12:03,650 --> 00:12:06,060
إنّها الخامسة فحسب، لكن الظلام بدأ يخيم

172
00:12:06,060 --> 00:12:08,420
تغرب الشمس سريعاً في الخريف

173
00:12:08,900 --> 00:12:10,190
!هيمينو

174
00:12:10,900 --> 00:12:13,300
هيمينا-سان؟ كيف؟

175
00:12:13,300 --> 00:12:16,590
!قرّرتُ الانتقال لتاجيمي

176
00:12:16,590 --> 00:12:18,770
ماذا؟ حقّاً؟

177
00:12:18,770 --> 00:12:20,270
!حقّاً

178
00:12:20,270 --> 00:12:22,980
!سأدرس صنع الفخّار في كوكيغاما

179
00:12:22,980 --> 00:12:24,050
مذهل!

180
00:12:24,050 --> 00:12:25,970
يا لحركة القدمين المبهرة

181
00:12:25,970 --> 00:12:28,100
!أراكِ لاحقاً يا هيمي-تشا

182
00:12:30,950 --> 00:12:32,940
إنّها قويّةٌ جدّاً

183
00:12:33,630 --> 00:12:37,450
أشعر أنّها ستصنع شيئاً مذهلاً قريباً

184
00:12:38,400 --> 00:12:39,620
ماذا؟

185
00:12:40,970 --> 00:12:42,910
!القمر ينعكس

186
00:12:43,890 --> 00:12:45,890
أذلك أمرٌ حسن؟

187
00:12:45,890 --> 00:12:47,290
يُقال أنّه إذا وقفت
على جسر تاجيمي

188
00:12:47,290 --> 00:12:50,370
ورأيت انعكاس القمر على نهر توكي

189
00:12:50,370 --> 00:12:52,220
ستحقّق أحلامك

190
00:12:52,540 --> 00:12:54,310
حقّاً؟

191
00:12:54,310 --> 00:12:58,420
قد أستطيع صنع شيءٍ مذهل
!لأضعه على ذلك الرفّ إذاً

192
00:12:58,420 --> 00:13:00,040
!يبدو ذلك حسناً

193
00:13:02,760 --> 00:13:06,370
كانت رياح اليوم دافئةً نوعاً ما

194
00:13:06,780 --> 00:13:07,790
أجل

195
00:14:25,320 --> 00:14:27,570
!ذات الشعر المجعّد مزعجة

196
00:14:26,630 --> 00:14:35,390
