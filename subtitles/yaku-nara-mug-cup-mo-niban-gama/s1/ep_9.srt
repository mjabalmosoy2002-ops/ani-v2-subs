1
00:00:03,810 --> 00:00:05,430
29

2
00:00:06,630 --> 00:00:08,490
30

3
00:00:08,810 --> 00:00:10,650
!انتهيتُ من حصّة اليوم

4
00:00:17,780 --> 00:00:20,790
ناروسي ناوكو
أيمكنني الكلام معك؟

5
00:00:21,370 --> 00:00:22,790
ناروسي-سان؟

6
00:00:24,230 --> 00:00:26,240
ربما إذا نظرتٌ من هذا المنظور

7
00:00:29,790 --> 00:00:32,790
صنعتُ الكثير

8
00:00:33,290 --> 00:00:37,390
ستصنعين شيئاً رائعاً
وتعرضينه في المقهى، أليس كذلك؟

9
00:00:41,560 --> 00:00:43,490
"لا أزال أشعر أنّ "هذه ليست هي

10
00:00:44,930 --> 00:00:48,270
"أجل، إنّه شعور "هذه ليست هي

11
00:00:52,880 --> 00:00:54,230
توكو-سينباي؟

12
00:00:54,450 --> 00:00:58,450
شكراً لكِ على جلب آراي-سان
إلى منزلنا اليوم

13
00:00:58,450 --> 00:01:03,450
شكراً لكِ على جلب آراي-سان
إلى منزلنا اليوم
هنالك أمورٌ عدّة أريد الكلام بشأنها معك
أتمانعين لو أتيتُ للمقهى غداً؟

14
00:01:04,820 --> 00:01:08,950
لا بأس"، إرسال"

15
00:02:50,440 --> 00:02:52,750
!توكو-سينباي

16
00:02:53,540 --> 00:02:55,570
!سينباي

17
00:02:56,470 --> 00:02:59,090
لم يكن عليكِ الركض هكذا

18
00:02:59,540 --> 00:03:04,550
...لكنّكِ... قلتِ أنّ هنالك ما
أردتِ أكله قبل القدوم للمقهى

19
00:03:04,890 --> 00:03:07,350
لحظة، أهو في هذه الحقيبة؟

20
00:03:07,350 --> 00:03:10,840
كلا، أردتُ تناول حلويات محدودة
الفترة من ذاك المحلّ

21
00:03:11,940 --> 00:03:15,380
أعتذر على الأمس، لم أستطع الكلام
كما يجب

22
00:03:15,380 --> 00:03:16,790
لا بأس

23
00:03:16,790 --> 00:03:19,330
تسنّى لي سماع أشياء قيّمة كثيرة

24
00:03:19,770 --> 00:03:23,390
ذلك جانباً، لمَ هذه الحقيبة الكبيرة معك؟

25
00:03:23,390 --> 00:03:24,850
تشعركِ بالفضول إذاً؟

26
00:03:24,850 --> 00:03:27,050
أشعر بفضولٍ كبير

27
00:03:27,050 --> 00:03:28,200
كما ظننت

28
00:03:29,380 --> 00:03:31,080
ما بها إذاً؟

29
00:03:39,900 --> 00:03:42,360
...مذهل، كيف أصفه

30
00:03:42,360 --> 00:03:45,900
له وقعٌ كبير، إنّه يلفت الأنظار

31
00:03:45,900 --> 00:03:46,940
أليس كذلك؟

32
00:03:47,210 --> 00:03:49,090
يبدو باهظاً جدّاً

33
00:03:49,090 --> 00:03:54,000
لم يكن بذاك الثمن الباهظ، لكنّه قطعةٌ
كنتُ أتفحصها لوقتٍ طويل

34
00:03:54,500 --> 00:03:57,800
استعملتُ كافة مدّخراتي لرأس
السنة الجديدة لشرائه

35
00:03:59,110 --> 00:04:02,760
عندما أرسلتُ صورةً له البارحة
إلى ميكا-تشان، اتّصلت بي فوراً

36
00:04:02,760 --> 00:04:04,070
كانت متفاجئة

37
00:04:04,070 --> 00:04:06,210
لا عجب

38
00:04:07,250 --> 00:04:09,930
عندما وضعتُه في غرفتي، شعرتُ بحماسٍ كبير

39
00:04:10,290 --> 00:04:13,490
قد يكون الأمر مبالغاً به، لكنّه
جعلني أشعر أنّي منيعة

40
00:04:14,100 --> 00:04:15,880
أتفهّمك

41
00:04:17,650 --> 00:04:21,020
!مذهل، تشعرني هذه بالحماس أيضاً

42
00:04:21,020 --> 00:04:21,990
أليس كذلك؟

43
00:04:22,260 --> 00:04:25,110
لا أدري كيف أبدأ أكلها حتّى

44
00:04:27,280 --> 00:04:28,870
!لذيذة

45
00:04:28,870 --> 00:04:32,950
أخبرتُك قبلاً، لكن تعرفين أنّ جدّي صانع فخّار

46
00:04:34,700 --> 00:04:36,710
،انتقل أبي لجانب الأعمال

47
00:04:36,710 --> 00:04:39,260
لكنّ كانت عائلة أمّي في مجال
الفخّار لأجيال أيضاً

48
00:04:39,260 --> 00:04:42,010
ترعرعتِ محاطةَ بالفخّار إذاً

49
00:04:42,770 --> 00:04:44,140
أجل

50
00:04:44,990 --> 00:04:47,810
لذا أصبحتُ أحبّ الفخّار بشكلٍ طبيعيّ

51
00:04:51,310 --> 00:04:57,220
صنعتُ الكثير وتلقّيتُ إطراءً كثيراً، مما جعلني أحبّه أكثر

52
00:05:00,180 --> 00:05:02,080
...لكن أتساءل متى أصبح الفخّار

53
00:05:03,150 --> 00:05:07,190
"شيئاً عليّ القيام به كما يجب"

54
00:05:09,010 --> 00:05:11,260
علّق جميع من حولي آمالاً

55
00:05:11,260 --> 00:05:14,250
وأقنعتُ نفسي بأنّه يُفترض
أن أتمكن من فعلها أيضاً

56
00:05:16,180 --> 00:05:21,380
بعدما دخلتُ المتوسّطة، كانت تصيبني
حُمى قبل المسابقات دوماً

57
00:05:21,380 --> 00:05:23,060
حقّاً؟

58
00:05:23,420 --> 00:05:25,490
،كان جدّي عظيماً

59
00:05:25,490 --> 00:05:27,940
ولم أدرك كميّة الضغط التي
وقعت عليّ بسبب ذلك

60
00:05:30,120 --> 00:05:31,610
ضغط؟

61
00:05:33,500 --> 00:05:37,280
كنتُ أقوم بالأمر كي أشعر
،أنّي جديرةٌ بجدّي

62
00:05:37,280 --> 00:05:40,040
ثمّ جعلوني رئيسة مجلس
الطلبة في المدرسة المتوسّطة

63
00:05:43,020 --> 00:05:46,990
الجميع يتوقّعون منّي صنع شيءٍ مذهل حتماً

64
00:05:48,490 --> 00:05:49,740
رجعنا

65
00:05:55,080 --> 00:05:57,030
،لكن في العام الثاني من المتوسّطة

66
00:05:57,030 --> 00:06:00,420
،شعرتُ برغبةٍ في استعمال الأحمر
لون لم يستعمله جدّي كثيراً

67
00:06:01,130 --> 00:06:05,260
...وعندما ذهبتُ لأريه قطعتي الأولى بفخر

68
00:06:06,240 --> 00:06:08,710
آسف، لكنّي مشغولٌ الآن

69
00:06:08,710 --> 00:06:11,010
لذا لا تأتي للورشة بعد الآن رجاءً

70
00:06:12,180 --> 00:06:17,530
جعلني ذلك أفكّر "يبدو أنّ
"عليّ صنع الأشياء بطريقته

71
00:06:17,930 --> 00:06:19,390
...كلا

72
00:06:21,650 --> 00:06:23,330
لكن لم يكن الأمر كذلك

73
00:06:26,810 --> 00:06:28,000
،بعدما غادرتِ بالأمس

74
00:06:28,000 --> 00:06:31,370
طلب منّي جدّي مرافقته
إلى معبد إيهوجي

75
00:06:42,790 --> 00:06:46,300
مشينا وحسب لمدّة ساعتين

76
00:06:47,240 --> 00:06:51,360
كلّما حاولتُ الكلام معه، كان يردّ
بـ "أجل" و"حسناً" فقط

77
00:06:52,220 --> 00:06:57,800
لكن، بينما كنت متسمّرةً
...بأوراق الخريف على جسر موساي

78
00:07:01,600 --> 00:07:02,910
إنّها جميلة

79
00:07:03,880 --> 00:07:05,000
أجل

80
00:07:12,570 --> 00:07:16,580
الصيف الأزرق جميل، لكن الخريف الأحمر
الفاقع جميلٌ أيضاً

81
00:07:17,110 --> 00:07:17,800
أجل

82
00:07:19,910 --> 00:07:21,380
ربما لا تفهمين

83
00:07:24,320 --> 00:07:26,210
لا عجب

84
00:07:27,920 --> 00:07:31,450
بما أنّي كنت محرجاً، طلبتُ من معلّمتك ألّا تخبرك

85
00:07:31,450 --> 00:07:33,960
لكنّي رأيتُ طبقكِ الجديد

86
00:07:38,750 --> 00:07:42,510
أعتذر على إبعادك عنّي بمسافة دوماً

87
00:07:42,510 --> 00:07:46,900
كوزو وناناكو يدركان صعوبة هذه المهنة

88
00:07:46,900 --> 00:07:49,930
كانا قلقين عليكِ على الأرجح

89
00:07:50,350 --> 00:07:53,280
طلبا منّي ألّا أعطيكِ اهتماماً كبيراً

90
00:07:53,580 --> 00:07:55,730
أبي وأمّي؟

91
00:07:56,970 --> 00:07:59,050
،بما أنّي لا أجيد هذا كثيراً

92
00:07:59,050 --> 00:08:02,220
لم أستطع منع نفسي من مقابلتك
بودٍّ عندما أتيتِ للورشة

93
00:08:04,640 --> 00:08:07,000
،بما أنّكِ كنتِ في ذاك السنّ

94
00:08:07,000 --> 00:08:10,030
أخبراني أنّك ستفقدين اهتمامك
ما إن تركتكِ وشأنك

95
00:08:16,330 --> 00:08:19,300
سرّتني رؤيتكِ تكملين

96
00:08:23,980 --> 00:08:26,010
ذاك الأحمر جميلٌ بحقّ

97
00:08:27,980 --> 00:08:30,660
اللمسات الذهبيّة جميلةٌ أيضاً

98
00:08:31,450 --> 00:08:33,120
تقصد طبقي الكبير؟

99
00:08:33,900 --> 00:08:38,030
كان أوّل شيءٍ صنعتِه أشعرني بالغيرة

100
00:08:41,210 --> 00:08:43,360
أتفهمين؟

101
00:08:44,820 --> 00:08:45,640
أجل

102
00:08:46,950 --> 00:08:49,760
لا تقلقي حيال ما يعجبني

103
00:08:49,760 --> 00:08:53,300
اصنعي الأشياء التي تريدين صنعها
بالطريقة التي تحلو لكِ

104
00:08:54,990 --> 00:08:58,630
أنا أنا، وأنتِ أنت

105
00:09:05,770 --> 00:09:07,040
...جدّي

106
00:09:10,350 --> 00:09:11,610
شكراً لك

107
00:09:16,050 --> 00:09:17,190
...لمَ

108
00:09:17,750 --> 00:09:19,190
لا أدري لمَ

109
00:09:20,760 --> 00:09:23,800
...آسفة، لا أدري لمَ

110
00:09:25,470 --> 00:09:28,400
لأنّكِ في نفس موقفي يا توكيكاوا-سان

111
00:09:30,340 --> 00:09:32,130
،أمّكِ توكيكاوا هيمينا أسطورة

112
00:09:32,810 --> 00:09:35,250
فألا تشعرين بالضغط أيضاً؟

113
00:09:37,180 --> 00:09:38,890
إنّه ذاك الرفّ، صحيح؟

114
00:09:38,890 --> 00:09:41,210
الذي ستضعين فيه أفضل قطعك

115
00:09:43,280 --> 00:09:44,520
كيف عرفتِ؟

116
00:09:45,130 --> 00:09:47,860
أرسلت لي ناروسي-سان رسالةً البارحة

117
00:09:47,860 --> 00:09:49,540
ناو-تشان؟

118
00:09:49,540 --> 00:09:53,650
قالت أنّها تظنّ أنّكِ
منشغلة كثيراً بذاك الرفّ

119
00:09:55,470 --> 00:09:57,640
كانت أمّكِ لتقول نفس الشيء وفقما أظنّ

120
00:09:57,990 --> 00:10:00,970
ستخبرك بألّا تقلقي، وتصنعي ما يحلو لك

121
00:10:04,090 --> 00:10:08,450
أمّي، ما الذي كنتِ لتقولينه
لو كنتِ على قيد الحياة؟

122
00:10:11,300 --> 00:10:13,500
سأبذل جهدي بأيّة حال

123
00:10:13,500 --> 00:10:16,060
لكن إذا أصبحت القطعة غريبة، فلا تضحكي عليّ

124
00:10:17,990 --> 00:10:24,170
أتساءل ما إن آذت فكرتي اللا مبالية هيمينو

125
00:10:24,170 --> 00:10:26,090
أظنّها ستكون بخير

126
00:10:26,090 --> 00:10:28,680
فهي تفهم على الأرجح

127
00:10:28,680 --> 00:10:31,760
ذاك المكان ليس للمقارنة

128
00:10:31,760 --> 00:10:34,100
بل لجعلها بجوار بعضها

129
00:10:37,860 --> 00:10:39,690
،رغم جدولكِ المزدحم

130
00:10:39,690 --> 00:10:42,660
قمتِ مع ذلك... كلا، ليس هكذا

131
00:10:43,240 --> 00:10:47,400
آوكي-سينباي، شكراً لكِ على كلّ
...ما فعلتِه لهيمينو

132
00:10:47,760 --> 00:10:50,480
كلا، حتّى هذه لا تصلح

133
00:10:50,480 --> 00:10:53,620
!يا إلهي، سأتّصل وحسب

134
00:10:58,240 --> 00:10:59,270
مرحباً؟

135
00:10:59,270 --> 00:11:02,130
أيمكنني الكلام مع آوكي-سينباي؟

136
00:11:02,130 --> 00:11:03,970
ما الأمر يا ناروسي-سان؟

137
00:11:03,970 --> 00:11:08,640
أ-أنا، وصلتني رسالة شكر
من هيمي-تشان قبل قليل

138
00:11:08,640 --> 00:11:10,180
،يبدو أنّ قلقها زال الآن

139
00:11:10,180 --> 00:11:12,450
لذا أردتُ شكركِ على ذلك

140
00:11:12,450 --> 00:11:13,920
حمداً لله

141
00:11:14,250 --> 00:11:16,830
لم يكن عليكِ الاتّصال لأجل ذلك

142
00:11:16,830 --> 00:11:19,530
كلا، أردتُ القيام بالأمر كما يجب هذه المرّة

143
00:11:19,530 --> 00:11:21,430
!شكراً جزيلاً لك

144
00:11:21,430 --> 00:11:23,910
إذاً، اسمحي لي، أجل، أجل

145
00:11:23,910 --> 00:11:25,920
المعذرة

146
00:11:37,440 --> 00:11:39,540
أنا مرهقة

147
00:11:58,170 --> 00:11:59,740
...ثمّ

148
00:12:01,210 --> 00:12:03,580
أتيتِ باكراً يا هيمي-تشان

149
00:12:08,470 --> 00:12:10,500
جميل، جميل

150
00:12:10,990 --> 00:12:12,580
أيمكنني تصوير فيديو؟

151
00:12:12,580 --> 00:12:15,830
ماذا؟ حسناً ربما

152
00:12:18,180 --> 00:12:20,340
أعجبتني ملامح هيمي-تشان

153
00:12:20,920 --> 00:12:22,340
أنا كذلك

154
00:12:23,740 --> 00:12:25,600
وملامحك يا توكو-سينباي

155
00:12:32,730 --> 00:12:34,850
إذاً يا هيمي-تشان

156
00:12:38,830 --> 00:12:40,340
شكراً لك

157
00:12:40,340 --> 00:12:42,400
ماذا؟ لماذا؟

158
00:12:43,440 --> 00:12:44,790
لمَ يا ترى؟

159
00:12:44,790 --> 00:12:46,270
ما قصدك؟

160
00:12:46,270 --> 00:12:47,970
!لن أخبرك

161
00:12:47,360 --> 00:12:49,790
هيّا، ما هذا؟

162
00:12:49,790 --> 00:12:50,960
أبداً

163
00:12:50,960 --> 00:12:52,380
!أنت

164
00:12:53,410 --> 00:12:55,110
!توقّفي

165
00:12:57,820 --> 00:12:59,770
!أخبريني

166
00:14:25,250 --> 00:14:27,110
،رؤية الفتاة المكسيكيّة مجدّداً

167
00:14:26,550 --> 00:14:35,310
نادي الفخّار المصغر

168
00:14:27,110 --> 00:14:28,720
،لحظة مع الفتاة المتحفّظة

169
00:14:28,720 --> 00:14:30,730
،كلمة من المستشارة

170
00:14:30,730 --> 00:14:33,940
كلّها كنوزٌ للفتاة ذات الشعر
القصير المنسدل

171
00:14:33,940 --> 00:14:35,910
!الحلقة القادمة: وجدتُها

172
00:14:35,390 --> 00:14:39,970
الحلقة القادمة

173
00:14:35,910 --> 00:14:39,600
كانت صِلات ولقاءات اليوم رائعة