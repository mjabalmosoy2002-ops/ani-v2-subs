1
00:00:20,890 --> 00:00:22,040
توكي-كن

2
00:00:23,460 --> 00:00:24,660
الماء الساخن

3
00:00:25,890 --> 00:00:27,370
!يا إلهي

4
00:00:27,370 --> 00:00:30,130
ما الذي يجري؟ تبدو شارد الذهن

5
00:00:30,130 --> 00:00:32,730
...لا شيء، أنا فقط

6
00:00:32,730 --> 00:00:34,020
أنت؟

7
00:00:34,020 --> 00:00:35,850
...حسناً

8
00:00:38,450 --> 00:00:41,520
الموضوع عن هيمينو

9
00:00:42,860 --> 00:00:46,390
قرابة فجر اليوم، كنتُ ذاهباً للحمّام

10
00:00:50,310 --> 00:00:52,810
هيمينو، ما الذي تفعلينه؟

11
00:00:52,810 --> 00:00:55,560
آسفة، لكن هلّا امتنعت عن الكلام معي قليلاً؟

12
00:00:58,430 --> 00:00:59,210
أجل

13
00:01:07,110 --> 00:01:10,230
بدت طبيعيّةً عندما غادرت هذا الصباح

14
00:01:10,230 --> 00:01:15,370
لا بدّ أنّ السبب هو الأشياء التي قلتُها

15
00:01:18,340 --> 00:01:20,340
ما الأمر يا ترى؟

16
00:02:56,300 --> 00:02:59,530
لمعت الفكرة ببالي عندما نظرت
لأقداح أمّي هذا الصباح

17
00:03:03,040 --> 00:03:04,890
أجل، يمكنني فعلها

18
00:03:05,300 --> 00:03:07,480
!انتظري، انتظري، هيمي-تشان

19
00:03:08,380 --> 00:03:10,420
لمَ تمشين مشياً سريعاً؟

20
00:03:10,720 --> 00:03:13,420
لأنّ الركض في الرواق غير مسموح

21
00:03:14,140 --> 00:03:16,090
...لذا من هنا

22
00:03:16,810 --> 00:03:21,720
!سأركض بأقصى قدرتي

23
00:03:21,720 --> 00:03:25,300
!لحظـ... انتظري، هيمي-تشان

24
00:03:25,540 --> 00:03:28,680
ما خطبك يا هيمي-تشان؟

25
00:03:29,280 --> 00:03:31,520
أنتِ بطيئةٌ يا كوكوري-تشان

26
00:03:31,520 --> 00:03:34,350
!بل أنتِ سريعةٌ جدّاً

27
00:03:44,340 --> 00:03:46,540
!البارون بيرنود، انطلاق

28
00:03:46,540 --> 00:03:48,130
أمزح

29
00:04:21,830 --> 00:04:24,200
تويوكاوا-سان، هذا جميل

30
00:04:25,930 --> 00:04:27,570
ماذا؟

31
00:04:27,570 --> 00:04:30,730
!لا تبذلين أيّ قوّة مهدرة، هذا مثاليّ

32
00:04:30,730 --> 00:04:32,740
حقّاً؟

33
00:04:33,100 --> 00:04:35,210
أشعر بالغيرة، مدحتكِ

34
00:04:47,010 --> 00:04:48,740
هذا غريب

35
00:04:51,550 --> 00:04:56,420
،عندما أتيتُ لأوّل مرّةٍ هنا
لم أفقه شيئاً في الفخّار

36
00:04:57,990 --> 00:04:59,450
،آنذاك

37
00:05:00,520 --> 00:05:06,260
تمكّنتُ من إتمام الأمر بشكل سحريّ
لأنّ توكو-سينباي كانت تمسك بيديّ

38
00:05:10,060 --> 00:05:11,970
أظنّ هذا سيفي بالغرض

39
00:05:11,970 --> 00:05:15,300
جرّبي سحبه بيدكِ اليمنى الآن

40
00:05:16,080 --> 00:05:18,930
!أجل، هكذا! رائع

41
00:05:20,140 --> 00:05:22,420
كان ذلك ممتازاً لمحاولتك الأولى

42
00:05:24,660 --> 00:05:29,970
اغتررتُ بعد سماع ذلك
وأفسدته في نهاية المطاف

43
00:05:33,960 --> 00:05:35,480
!مرحباً

44
00:05:35,780 --> 00:05:36,900
ماذا؟

45
00:05:36,900 --> 00:05:39,440
صدرت هذه بالفعل؟

46
00:05:39,440 --> 00:05:42,980
هذا الإصدار الثالث الآن

47
00:05:42,980 --> 00:05:44,560
هكذا إذاً

48
00:05:44,560 --> 00:05:45,980
أين الساقي؟

49
00:05:46,210 --> 00:05:48,890
أتمانع الانتظار قليلاً؟

50
00:05:48,890 --> 00:05:52,240
إنّه في الديماس الآن ولا يستطيع الخروج لفترة

51
00:05:55,320 --> 00:05:56,670
...هيمينا

52
00:05:57,120 --> 00:06:01,630
...قلت أنّي سأهتمّ بهيمينو، مع ذلك

53
00:06:02,010 --> 00:06:03,010
آسف

54
00:06:04,060 --> 00:06:07,520
،وضعتُها تحت ضغطٍ في المقابل
ولا تعرف ما تفعله الآن

55
00:06:09,660 --> 00:06:12,770
عليّ القيام بعملٍ أفضل

56
00:06:24,580 --> 00:06:26,210
كما تصوّرت

57
00:06:27,180 --> 00:06:28,700
هذا جيّد

58
00:06:34,270 --> 00:06:35,510
القليل فقط

59
00:06:41,350 --> 00:06:44,040
أليس هذا مثالياً؟

60
00:06:47,190 --> 00:06:49,960
تعابير تويوكاوا-سان رائعةٌ الآن

61
00:06:50,280 --> 00:06:52,220
"إنّه وجه "رونرو

62
00:06:56,300 --> 00:06:58,780
سأحتفظ بهذه للأبد

63
00:07:00,840 --> 00:07:01,780
أجل

64
00:07:02,450 --> 00:07:03,790
!تذكّرت

65
00:07:05,450 --> 00:07:06,980
ما الأمر؟

66
00:07:06,980 --> 00:07:09,360
خطر لي نمطٌ مختلف

67
00:07:18,660 --> 00:07:20,100
ماذا؟

68
00:07:20,100 --> 00:07:22,210
تسترجع الذكريات؟

69
00:07:22,880 --> 00:07:26,330
بدت متماسكةً جيّداً، لكنّها أرادت أن تُدلّل

70
00:07:27,660 --> 00:07:33,690
:كلّما خرجت، كانت تأتيني وتسأل
"أهذه الملابس ملائمة؟"

71
00:07:34,700 --> 00:07:36,520
أحقّاً ذلك؟

72
00:07:36,520 --> 00:07:41,750
قبل المسابقة الفائتة، أتت لاستشارتي أيضاً

73
00:07:43,170 --> 00:07:46,050
لكنّها لم تقل شيئاَ هذه المرّة

74
00:07:48,220 --> 00:07:51,050
ربما لأنّي من اقترح الأمر غالباً

75
00:07:51,430 --> 00:07:53,430
إنّها طالبة في الثانويّة

76
00:07:53,430 --> 00:07:56,280
فعدم استشارة الوالدين شيءٌ
طبيعيّ لمن في عمرها

77
00:07:56,280 --> 00:07:58,870
سنّ السادسة عشر بمثابة بالبالغ

78
00:07:59,840 --> 00:08:01,470
أحقّاً ذلك؟

79
00:08:08,880 --> 00:08:12,520
...قد يكون ذلك صحيحاً

80
00:08:20,900 --> 00:08:23,580
لحظة، ما الذي يجري يا هيمي-تشان؟

81
00:08:23,580 --> 00:08:25,910
!أنتِ تصنعينها بسرعةٍ كبيرة

82
00:08:29,850 --> 00:08:31,770
لا أظنّها تسمعك

83
00:08:33,320 --> 00:08:36,160
ملامحها وهي تركّز رائعةٌ جدّاً

84
00:08:36,570 --> 00:08:39,400
ما الذي ستصنعه تالياً يا ترى؟

85
00:08:39,400 --> 00:08:41,380
لا أظنّ بإمكانها التوقّف

86
00:08:41,380 --> 00:08:43,280
مذهل

87
00:08:42,310 --> 00:08:44,650
عليّ التقاط صورٍ أكثر

88
00:08:44,650 --> 00:08:45,410
تحطيم

89
00:08:47,220 --> 00:08:49,940
ماذا؟ أكنتنّ تشاهدنني؟

90
00:08:49,940 --> 00:08:53,440
!أجل! وبدت رائعةً حقّاً

91
00:08:53,440 --> 00:08:54,850
لا أدري

92
00:08:54,850 --> 00:08:56,930
كان هنالك شيءٌ غير مناسب فيها

93
00:08:57,600 --> 00:09:01,150
تويوكاوا-سان، أصبحت لديكِ
ثقةٌ أكبر حقّاً

94
00:09:01,710 --> 00:09:03,080
ما قصدك؟

95
00:09:03,080 --> 00:09:06,930
قدرة التخلّص من شيءٍ صنعته
هي علامةٌ على ذلك

96
00:09:07,740 --> 00:09:09,160
!أفهمك

97
00:09:09,160 --> 00:09:10,760
،عندما تبدئين

98
00:09:10,760 --> 00:09:12,400
تشعرين بأسى كبير
على التخلّص من شيء

99
00:09:12,400 --> 00:09:14,900
أخذ منك كلّ ذاك الوقت لصنعه

100
00:09:16,580 --> 00:09:20,950
صحيح، لم أشعر بذلك أبداً

101
00:09:21,630 --> 00:09:23,670
هذه هي الثقة إذاً

102
00:09:25,510 --> 00:09:28,760
عندما صنعتُ الوسادة، استعرتُ ألوان أمّي

103
00:09:29,320 --> 00:09:30,890
لكن ليس هذه المرّة

104
00:09:32,530 --> 00:09:35,570
لستُ... تائهة

105
00:09:37,090 --> 00:09:38,340
هذا مسلٍّ

106
00:09:40,850 --> 00:09:42,600
جسدي يشتعل

107
00:09:43,220 --> 00:09:47,360
!كما... أشعر بمتعة

108
00:09:47,660 --> 00:09:49,680
!متعة كبيرة

109
00:10:02,260 --> 00:10:03,830
مساء الخير

110
00:10:05,230 --> 00:10:07,050
مرحباً بعودتك

111
00:10:07,570 --> 00:10:10,070
تغسل النوافذ في هذا الوقت المتأخّر؟

112
00:10:10,070 --> 00:10:13,140
من الأسهل رؤية الأوساخ مساءً

113
00:10:15,860 --> 00:10:17,590
إذاً، أين هيمينو؟

114
00:10:18,530 --> 00:10:21,390
في وضعها الحاليّ، لا أظنّها
سترجع للمنزل قريباً

115
00:10:21,390 --> 00:10:22,330
ماذا؟

116
00:10:22,330 --> 00:10:27,740
حتّى أنا خطر لي أنّ من الأفضل
تركها وشأنها، لذا رجعتُ بمفردي

117
00:10:27,740 --> 00:10:29,060
إلى اللقاء

118
00:10:36,590 --> 00:10:38,280
...هيمينو

119
00:10:50,070 --> 00:10:52,730
عليكِ العودة للمنزل الآن

120
00:11:13,940 --> 00:11:18,890
هنالك خطبٌ ما بي

121
00:11:19,500 --> 00:11:20,690
ما قصدك؟

122
00:11:21,550 --> 00:11:26,800
كنتُ أشجّع هيمينو طوال الوقت
وأتمنّى الأفضل لها

123
00:11:26,800 --> 00:11:29,630
لكن اليوم، شعرت بشعورٍ مختلف لأوّل مرّة

124
00:11:30,300 --> 00:11:31,420
ما هو؟

125
00:11:32,380 --> 00:11:33,530
الغيرة

126
00:11:33,940 --> 00:11:37,510
أنّي أردتُ صنع شيءٍ أفضل حتّى

127
00:11:39,060 --> 00:11:42,170
لكنّي لا أريد أن أكون كذلك

128
00:11:43,980 --> 00:11:45,680
لا بأس يا ميكا-تشان

129
00:11:47,570 --> 00:11:51,510
هذا يعني أنّكِ اعترفتِ بتويوكاوا-سان
أكثر من السابق حتّى

130
00:11:54,770 --> 00:11:59,320
ستصبحان خصمتان أفضل، كما صديقتان مقرّبتان أكثر

131
00:12:04,480 --> 00:12:05,770
فهمت

132
00:12:08,420 --> 00:12:10,930
أجل، سنصبح

133
00:12:12,070 --> 00:12:14,080
!سنكون كذلك

134
00:12:15,880 --> 00:12:17,350
!رأيتها

135
00:12:17,350 --> 00:12:19,360
ممتاز

136
00:12:20,940 --> 00:12:22,260
سينسي؟

137
00:12:22,260 --> 00:12:24,190
مُذ متى وأنتِ هنا؟

138
00:12:25,300 --> 00:12:27,300
خمس دقائق ربما

139
00:12:27,300 --> 00:12:30,740
آسفة، لم أنتبه البتّة

140
00:12:30,740 --> 00:12:32,230
لا بأس

141
00:12:32,230 --> 00:12:34,300
إذاً، بشأن ما رأيتِه

142
00:12:34,300 --> 00:12:35,190
ماذا الآن؟

143
00:12:40,010 --> 00:12:42,500
أيمكنني البقاء لفترةٍ أطول؟

144
00:12:42,950 --> 00:12:45,410
لا بأس، سأنتظر

145
00:12:45,410 --> 00:12:47,130
!شكراً جزيلاً

146
00:14:25,370 --> 00:14:27,780
فعلتها الفتاة ذات الشعر
!المنسدل القصير أخيراً

147
00:14:26,590 --> 00:14:35,350
نادي الفخّار المصغّر

148
00:14:27,780 --> 00:14:30,220
كان الجميع بانتظارك

149
00:14:30,490 --> 00:14:33,280
...وأنتِ الآن

150
00:14:33,780 --> 00:14:36,850
"!الحلقة القادمة: "سأصنع قدحاً

151
00:14:35,430 --> 00:14:37,430
:الحلقة القادمة

152
00:14:36,850 --> 00:14:39,590
مهما كان بعدك، سنبقى متّصلين