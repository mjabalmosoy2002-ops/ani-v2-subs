1
00:00:04,350 --> 00:00:06,100
،بهذه الكلمات من جلالته

2
00:00:06,100 --> 00:00:09,300
سيحرص البيت السّماوي على فرض
!الهيمنة بين مطاعم جينلينغ

3
00:00:09,790 --> 00:00:12,430
!هيمني على جينلينغ! هيمني على جينلينغ

4
00:00:13,910 --> 00:00:15,840
أين ينبغي أن أعلّق كلمات جلالته؟

5
00:00:15,840 --> 00:00:17,140
ماذا عن هذا المكان؟

6
00:00:17,140 --> 00:00:17,760
يبدو هذا جيّداً

7
00:00:17,760 --> 00:00:18,480
لا بأس، لا بأس

8
00:00:18,480 --> 00:00:19,060
إنّها مائلة

9
00:00:19,060 --> 00:00:20,280
أعلى قليلاً

10
00:00:20,280 --> 00:00:21,400
هكذا مناسب

11
00:01:58,000 --> 00:01:59,810
سموّك، ما هي أوامرك؟

12
00:02:00,770 --> 00:02:01,810
تعال

13
00:02:01,810 --> 00:02:02,520
حسناً

14
00:02:03,140 --> 00:02:05,260
لا تدع هيليان شان يسبقنا

15
00:02:05,260 --> 00:02:06,930
!احرص على مُجاراته

16
00:02:08,060 --> 00:02:10,110
"!أنا... ألتقي بالوالدين"

17
00:02:25,770 --> 00:02:27,540
انتهينا

18
00:02:28,010 --> 00:02:30,640
لم أرَ الحمار يمرّ من هنا منذ مدّة

19
00:02:30,640 --> 00:02:31,620
أختي ياو

20
00:02:31,620 --> 00:02:33,430
...سموّه

21
00:02:33,430 --> 00:02:34,100
جاء؟

22
00:02:34,100 --> 00:02:36,250
أرسل خادمه سونغ شي

23
00:02:36,250 --> 00:02:37,180
!زوجة الابن

24
00:02:40,330 --> 00:02:41,710
لديّ تقرير

25
00:02:41,710 --> 00:02:43,840
هلّا أتيتِ معي قليلاً؟

26
00:02:47,920 --> 00:02:49,100
تكلّم

27
00:02:49,680 --> 00:02:53,530
زارَ سموّه البيت السّماوي قبل أيّام قليلة

28
00:02:53,530 --> 00:02:56,000
لعلّه لاحظ بأنّكِ مشغولة وغادر

29
00:02:57,720 --> 00:02:59,140
،بعد أن عاد إلى المنزل

30
00:02:59,140 --> 00:03:00,800
حدث أمر سيّئ في البيت

31
00:03:00,800 --> 00:03:01,850
ماذا حدث؟

32
00:03:03,520 --> 00:03:06,220
...المركيز والمركيزة

33
00:03:12,500 --> 00:03:13,530
يو

34
00:03:14,060 --> 00:03:18,020
كنّا معاً لثلاثين عاماً رغم أنّها
كانت كلمح البصر

35
00:03:19,440 --> 00:03:20,970
فينغ

36
00:03:20,970 --> 00:03:23,620
لديّ مفاجأة لكِ

37
00:03:24,560 --> 00:03:26,380
لا تستديري بعد

38
00:03:30,930 --> 00:03:33,020
كـ-كيف سُحِقت؟

39
00:03:34,140 --> 00:03:37,600
أخي فينغ، أنا جاهزة

40
00:03:49,560 --> 00:03:52,810
المفاجأة هي ذراعايّ القويّتان

41
00:03:52,810 --> 00:03:54,860
—حتّى بجسدك المليء

42
00:03:54,860 --> 00:03:55,800
ماذا؟

43
00:03:55,800 --> 00:03:56,820
من تقول عنها مليئة؟

44
00:03:56,820 --> 00:03:59,770
—لا، لم أقصد بهذا الشّكل

45
00:04:00,890 --> 00:04:02,920
!يو

46
00:04:05,790 --> 00:04:08,640
شا تشانيو هو ابنهما حقّاً

47
00:04:09,110 --> 00:04:11,710
مرضت المركيزة بعد أن سقطت في الماء

48
00:04:11,710 --> 00:04:13,600
،كان سموّه مشغولاً في مُداواتها

49
00:04:13,600 --> 00:04:15,150
لذا لم يتمكّن من الزيارة منذ حينها

50
00:04:15,150 --> 00:04:17,470
وهل تتحسّن المركيزة؟

51
00:04:18,380 --> 00:04:20,880
تحسّن وضعها بعض الشيء

52
00:04:20,880 --> 00:04:21,870
...الأمر فقط

53
00:04:21,870 --> 00:04:22,680
الأمر ماذا؟

54
00:04:23,940 --> 00:04:26,200
أنّها لم تعُد تأكل شيئاً

55
00:04:26,200 --> 00:04:28,650
—إذا استمرّ هذا، جسدها سوف

56
00:04:28,650 --> 00:04:29,870
خذني إلى منزل المركيز

57
00:04:29,870 --> 00:04:31,560
!كنتُ أنتظركِ حتّى تقولي ذلك

58
00:04:31,790 --> 00:04:34,710
فقط وضّح بأنّني لن أذهب إلى هناك للحمار

59
00:04:34,710 --> 00:04:36,220
حسناً، حسناً

60
00:04:39,770 --> 00:04:40,890
!الرّئيسة ياو

61
00:04:40,890 --> 00:04:43,520
نحن هنا لنأكل ثانية يا أختي ياوياو

62
00:04:44,240 --> 00:04:46,070
إلى أين أنتما ذاهبان؟

63
00:04:51,920 --> 00:04:53,200
لا تخافي أيّتها الرّئيسة ياو

64
00:04:53,200 --> 00:04:54,770
نحن الاثنان سندعمكما

65
00:04:55,280 --> 00:04:57,810
زوجة الابن، لندخل

66
00:04:58,360 --> 00:04:59,360
هيّا بنا

67
00:05:01,920 --> 00:05:03,500
زوجة الابن، من هنا رجاء

68
00:05:12,510 --> 00:05:14,130
منزل المركيز جميل

69
00:05:14,130 --> 00:05:16,270
هذا هو بيت تشانيو إذاً

70
00:05:21,770 --> 00:05:24,620
زوجة الابن، هذه هي غرفة نوم المركيزة

71
00:05:26,500 --> 00:05:27,390
ياوياو

72
00:05:29,270 --> 00:05:30,620
تحيّاتي مولايّ المركيز

73
00:05:31,160 --> 00:05:32,640
أنا ياوياو

74
00:05:33,420 --> 00:05:34,170
—لماذا أنت

75
00:05:34,170 --> 00:05:36,080
تشونفينغ، لم أرك منذ وقت

76
00:05:36,610 --> 00:05:37,560
زوجة الابن، مرحباً

77
00:05:40,200 --> 00:05:41,990
أبي، لندخل

78
00:05:41,990 --> 00:05:43,020
!هيّا بنا

79
00:05:44,800 --> 00:05:46,560
!هيّا

80
00:05:47,990 --> 00:05:49,200
كيف علمت بهذا؟

81
00:05:53,520 --> 00:05:55,680
كيف لك ألّا تخبرني عن شيء بهذه الأهمّية؟

82
00:05:55,680 --> 00:05:57,810
أتساءل ما إن كنت تعتبرني خطيبتك حقّاً

83
00:05:58,200 --> 00:06:01,040
لم أرك إثارة قلقكِ

84
00:06:01,040 --> 00:06:02,430
نفس العذر من جديد

85
00:06:03,100 --> 00:06:04,880
،هذه المرّة، قرّرتَ التصرّف بمفردك

86
00:06:04,880 --> 00:06:06,640
ولم تعر انتباهاً لرأيي

87
00:06:07,550 --> 00:06:09,270
،لكن اليوم، أنا هنا لرؤية المركيزة

88
00:06:09,270 --> 00:06:10,420
لا للحديث عن هذا

89
00:06:14,160 --> 00:06:17,210
مولاتي المركيزة، أنا آيوان، أميرة
من مملكة نانيوي

90
00:06:18,010 --> 00:06:19,820
تحيّاتي المركيزة شا

91
00:06:20,570 --> 00:06:21,560
تفضّلي بالجلوس

92
00:06:23,300 --> 00:06:25,040
!أنتِ ياوياو

93
00:06:25,040 --> 00:06:26,950
مولاتي المركيزة، هل تحسّنتِ؟

94
00:06:26,950 --> 00:06:29,390
عزيزتي، تعالي واجلسي بجانبي رجاء

95
00:06:30,900 --> 00:06:32,680
يداها باردتان جدّاً

96
00:06:32,680 --> 00:06:35,220
إن لم تأكل، فلن يكون لجسدها
حُريرات يحرقها

97
00:06:36,510 --> 00:06:37,210
!هيّا

98
00:06:37,210 --> 00:06:39,270
الدواء جاهز. اشربيه بينما هو ساخن

99
00:06:39,270 --> 00:06:40,640
ابتعد. لن أتناوله

100
00:06:41,600 --> 00:06:43,930
سأطلب من المطبخ إعداد شيء تحبّينه

101
00:06:44,570 --> 00:06:46,620
هناك علبة باتيسري من جلالته في منزلي

102
00:06:46,620 --> 00:06:47,310
سأذهب لإحضارها

103
00:06:47,310 --> 00:06:48,430
قلتُ سلفاً

104
00:06:48,430 --> 00:06:50,270
!بأنّني لا أريد أن آكل

105
00:06:50,720 --> 00:06:51,580
...المركيزة

106
00:06:52,010 --> 00:06:53,910
...ترفضين الطعام باستمرار

107
00:06:53,910 --> 00:06:55,710
هل قرّرتِ أن تنحفي؟

108
00:06:55,710 --> 00:06:56,490
—انت

109
00:06:59,060 --> 00:07:01,060
!مـ-مولاتي المركيزة

110
00:06:59,470 --> 00:07:01,060
أمّي، هل أنتِ بخير؟

111
00:07:02,220 --> 00:07:05,100
عندما كنتُ صغيرة، مرّت عليّ فترة
لم أكن أستطيع الأكل فيها

112
00:07:06,120 --> 00:07:09,280
أتذكّر بأنّني مرضتُ آنذاك

113
00:07:18,900 --> 00:07:21,600
آنذاك، جاءت بعثة من دايان

114
00:07:22,490 --> 00:07:25,060
—أعدّتْ لي طبقاً من الطعام الحلو

115
00:07:26,200 --> 00:07:28,920
شيء شكله كحيوان صغير

116
00:07:28,920 --> 00:07:30,030
كان شهيّاً

117
00:07:31,600 --> 00:07:34,030
،فيما بعد، كلّما مرضت

118
00:07:34,030 --> 00:07:36,280
أرغب في تذوّق ذلك الطبق ثانية

119
00:07:36,280 --> 00:07:37,270
مجرّد التفكير في ذلك

120
00:07:37,570 --> 00:07:39,850
يجعلني أهضم حتّى كثر الأدوية مرارة

121
00:07:42,320 --> 00:07:44,080
...كحيوان صغير

122
00:07:49,200 --> 00:07:51,520
مولايّ المركيز، هل يمكنني استخدام مطبخك؟

123
00:07:52,160 --> 00:07:53,160
مطبخي؟

124
00:07:53,160 --> 00:07:56,270
بالطبع! تشانيو، دُلَّ ياوياو إلى
!المطبخ دونما تأخير

125
00:07:57,440 --> 00:07:59,060
لا تؤرقي نفسكِ لأجلي يا ياياوا

126
00:07:59,620 --> 00:08:00,660
لا عليكِ

127
00:08:00,660 --> 00:08:01,970
انتظريني قليلاً فقط

128
00:08:18,270 --> 00:08:20,140
إنّها حرب باردة إذاً

129
00:08:23,170 --> 00:08:24,680
اكتمل كلّ شيء

130
00:08:25,920 --> 00:08:26,740
ياوياو

131
00:08:27,440 --> 00:08:28,670
هذه الزيارة الأولى لكِ في منزلي

132
00:08:28,670 --> 00:08:29,900
لا داعي للقيام بهذا

133
00:08:30,470 --> 00:08:32,600
سواء كنتُ بحاجة أم لا، أنا لا أفعل هذا لأجلك

134
00:08:33,520 --> 00:08:35,930
إذاً بماذا تحتاجينني أن أساعدكِ؟

135
00:08:37,430 --> 00:08:40,970
أنت... يمكنك أن تحضر لي علبة
من دواء المركيزة

136
00:08:41,670 --> 00:08:42,620
علبة من الدّواء؟

137
00:08:48,240 --> 00:08:51,060
مولاتي المركيزة، سأجعلكِ تتحسّنين حتماً

138
00:09:09,350 --> 00:09:11,800
!دعوا الباقي لي

139
00:10:45,280 --> 00:10:47,000
!آذان قطّ أمل الدّوق العظيم

140
00:10:52,780 --> 00:10:55,480
تبدو كآذان القطّة

141
00:10:59,010 --> 00:11:00,700
المركيزة، جرّبيها من فضلكِ

142
00:11:19,040 --> 00:11:21,890
هناك مذاق حلو وحامض

143
00:11:28,680 --> 00:11:30,480
كيف لها أن تكون هكذا؟

144
00:11:30,480 --> 00:11:32,970
،لم تكن اللّقمة الأولى مُشهّية

145
00:11:32,970 --> 00:11:36,070
لكن كلّما أكلت، ازددتُ رغبة في الأكل

146
00:11:40,830 --> 00:11:41,820
يو

147
00:11:54,660 --> 00:11:58,680
كنّا معاً لثلاثين عاماً رغم أنّها
كانت كلمح البصر

148
00:11:59,830 --> 00:12:04,110
أنتِ حسناء كما اليوم الّذي التقيتُ فيه بكِ

149
00:12:04,110 --> 00:12:05,560
...فينغ

150
00:12:06,200 --> 00:12:10,250
أنت قويّ ومهيب كعادتك

151
00:12:11,690 --> 00:12:12,680
يو

152
00:12:13,100 --> 00:12:14,560
فينغ

153
00:12:23,530 --> 00:12:24,560
تبّاً لك

154
00:12:28,000 --> 00:12:29,570
المركيزة، ماذا حدث لكِ؟

155
00:12:29,570 --> 00:12:31,040
لماذا وجهكِ أحمر؟

156
00:12:35,550 --> 00:12:38,730
الجدّة هيليان والأميرة ليولي
أتيا لرؤية المركيزة

157
00:12:40,160 --> 00:12:41,100
!جدّتي

158
00:12:40,160 --> 00:12:41,100
!ليولي

159
00:12:41,770 --> 00:12:42,690
!أخي تشونفينغ

160
00:12:42,690 --> 00:12:43,700
جدّتي، بالتوفيق

161
00:12:43,700 --> 00:12:44,640
كيف الحال؟

162
00:12:43,700 --> 00:12:45,850
ما الأخبار؟

163
00:12:45,100 --> 00:12:45,850
أنا بخير

164
00:12:45,850 --> 00:12:47,660
تحيّاتي يا جدّتي

165
00:12:48,400 --> 00:12:50,070
شكراً على الاهتمام يا جدّتي

166
00:12:50,070 --> 00:12:52,860
بفضل ياوياو، أشعر بتحسّن كبير الآن

167
00:12:50,770 --> 00:12:52,120
آيوان، تعالي إلى هنا

168
00:12:54,960 --> 00:12:57,900
يبدو هذا شهيّاً

169
00:13:00,360 --> 00:13:01,820
!جدّتي، جدّتي

170
00:13:01,820 --> 00:13:03,780
هذه آيوان، الفتاة التي حدّثتُكِ عنها

171
00:13:06,950 --> 00:13:09,270
جـ-جدّتي

172
00:13:10,530 --> 00:13:13,520
لم أتوقّع أن نلتقي ثانية

173
00:13:14,440 --> 00:13:16,020
هل تتذكّرينني؟

174
00:13:16,260 --> 00:13:17,710
...أنتِ

175
00:13:19,960 --> 00:13:20,830
كُلي

176
00:13:23,500 --> 00:13:26,890
!أنتِ... كنتِ مع البعثة

177
00:13:28,760 --> 00:13:30,140
أتذكّر الآن

178
00:13:30,140 --> 00:13:32,000
التقيتُما من قبل

179
00:13:32,000 --> 00:13:35,640
عندما ذهبتُ إلى مملكة نانيوي
مع الجدّة هيليان قبل عشر سنوات

180
00:13:36,330 --> 00:13:41,310
إذاً البعثة كانت جدّة هيليان جينغ؟

181
00:13:45,430 --> 00:13:48,000
يبدو أنّ القدر جمعنا ثانية

182
00:13:48,000 --> 00:13:51,870
ما رأيكِ أن تبيتي لبضعة أيّام في
منزل هيليانا وتستمرّي في صُحبتي؟

183
00:13:51,870 --> 00:13:53,320
ما رأيكِ في ذلك؟

184
00:13:56,100 --> 00:13:57,100
!بالتأكيد

185
00:13:57,100 --> 00:14:00,630
إذاً مُقدّر لآيوان وجينغ أن يبقيا معاً

186
00:14:01,370 --> 00:14:02,570
ياوياو

187
00:14:02,570 --> 00:14:03,140
مولاتي المركيزة

188
00:14:05,680 --> 00:14:09,520
،عندما وافق جلالته على زواجكِ من تشانيو

189
00:14:09,520 --> 00:14:11,820
كنتُ أنا والمركيز سعيدين جدّاً

190
00:14:14,000 --> 00:14:16,130
تشانيو يشبه أباه

191
00:14:16,130 --> 00:14:17,490
قد يكون غبيّاً أحياناً

192
00:14:18,730 --> 00:14:20,180
أعلم بأنّكِ يستفزّكِ في أغلب الأحيان

193
00:14:22,290 --> 00:14:23,840
لكن لا تنظري إليه من ذلك المنظور

194
00:14:23,840 --> 00:14:27,250
،أعلم بأنّه ضمنيّاً

195
00:14:27,250 --> 00:14:29,440
فتى رقيق جدّاً

196
00:14:31,850 --> 00:14:36,080
أشعر وكأنّ شخصيّتينا ليستا متوافقتين فحسب

197
00:14:38,140 --> 00:14:41,670
أنا والمركيز شخصيّتانا مختلفتان جدّاً أيضاً

198
00:14:42,130 --> 00:14:43,250
،لكن عندما أكون مريضة

199
00:14:43,250 --> 00:14:44,910
رأيتِ كم يكون قلقاً

200
00:14:44,910 --> 00:14:47,200
الآن العائلة سعيدة معاً

201
00:14:48,140 --> 00:14:52,180
إنّهما لا يُجيدان الكلام، الابن كأبيه

202
00:14:53,330 --> 00:14:56,860
،بشخصيّتيهما، رغم أنّهما قد لا يعبّران بالكلام

203
00:14:56,860 --> 00:14:59,450
يُعاملانك مُعاملة حسنة وراء الكواليس

204
00:15:00,910 --> 00:15:02,220
...ياوياو

205
00:15:02,220 --> 00:15:05,280
—ما زلتما بحاجة للوقت لاكتشاف بعضكما

206
00:15:05,720 --> 00:15:08,500
لتفهما كلّ شيء عن بعضكما الآخر بقلبيكما

207
00:15:16,240 --> 00:15:16,980
اسمع

208
00:15:18,630 --> 00:15:20,290
اقتربت مأدبة الدُّول

209
00:15:20,290 --> 00:15:22,850
حريّ بك أن تكثِّف زياراتك للبيت
السّماوي وتعطيني أفكاراً

210
00:15:26,140 --> 00:15:30,060
جينغ، احرص على الاعتناء بآيوان جيّداً

211
00:15:26,580 --> 00:15:30,060
مولاتي المركيزة، إذا فقدتِ شهيّتك
ثانية، أبلغيني فحسب

212
00:15:30,340 --> 00:15:34,260
ياوياو! لا يمكنكِ أن تعامليها مُعاملة
!خاصّة وتطبخي لها فقط

213
00:15:34,260 --> 00:15:36,010
وذنب مَن أنّني مريضة؟

214
00:15:36,010 --> 00:15:38,090
!لا تستحقّ مُعاملة خاصّة

215
00:15:39,930 --> 00:15:41,920
!تبّاً، أريد أن تطبخ لي ياوياو أيضاً

216
00:15:41,920 --> 00:15:43,050
!أريد القفز في الماء

217
00:15:41,920 --> 00:15:43,050
!اهد يا أبي

218
00:15:43,050 --> 00:15:44,890
!دعيني! لا تحاولي إيقافي

219
00:15:43,050 --> 00:15:44,890
!الجميع يرونك

220
00:15:45,680 --> 00:15:47,510
من أين أتى والدك؟

221
00:15:47,510 --> 00:15:48,460
من الشّمال الشّرقي

222
00:15:47,510 --> 00:15:48,460
!اهدأ

223
00:15:48,460 --> 00:15:49,420
!دعيني

224
00:15:50,640 --> 00:15:51,460
تشونفينغ

225
00:15:51,460 --> 00:15:53,290
!أفلتي يدي

226
00:15:53,290 --> 00:15:54,560
ألا تسمعينني؟

227
00:15:55,080 --> 00:15:56,760
تشونفينغ، هل أنت بخير؟

228
00:15:56,760 --> 00:15:58,850
!أبي، لا تضغط على نفسك