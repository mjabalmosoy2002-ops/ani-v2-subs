1
00:00:08,440 --> 00:00:09,400
يمكنكم أن تتوقّفوا الآن

2
00:00:25,800 --> 00:00:28,460
وداعاً يا لوغ

3
00:02:11,970 --> 00:02:12,780
!أبي

4
00:02:13,350 --> 00:02:15,900
لا بأس، نوّمته بعقار

5
00:02:16,680 --> 00:02:17,740
من هذا الرجل؟

6
00:02:18,520 --> 00:02:19,570
...لوغ

7
00:02:21,650 --> 00:02:24,600
تمّ تعييننا لأداء عمل

8
00:02:24,600 --> 00:02:26,830
وأريدك أنت أن تؤديه

9
00:02:27,350 --> 00:02:28,010
حاضر

10
00:02:28,730 --> 00:02:31,670
هدفك هو ابنة الكونت فيكوني

11
00:02:32,540 --> 00:02:34,670
ستغتال ديا فيكوني

12
00:02:39,880 --> 00:02:41,470
...لوغ-ساما

13
00:02:41,470 --> 00:02:45,170
هذا عملٌ يمكنك رفضه

14
00:02:45,880 --> 00:02:48,060
القرار لك

15
00:02:48,740 --> 00:02:50,320
لديّ أسئلة

16
00:02:50,320 --> 00:02:53,700
عائلة فيكوني هم نبلاء لسويغل، مملكة مجاورة

17
00:02:54,250 --> 00:02:56,780
أليس من السيّئ لنا التدخّل
في شؤون مملكة أخرى؟

18
00:02:56,780 --> 00:03:02,160
معك حقّ، ستقع مشكلة دوليّة
إن اُكتشف تدخّلنا

19
00:03:02,490 --> 00:03:07,490
تنفّذ عائلة توا دي الاغتيالات
لصالح مملكة آلفان

20
00:03:08,450 --> 00:03:11,460
لا أرى أنّ قتل ديا سيمتّ لذلك بصلة

21
00:03:12,380 --> 00:03:15,170
توجد مشاعر شخصيّة وراء هذا الاغتيال

22
00:03:15,410 --> 00:03:16,880
مشاعر شخصيّة؟

23
00:03:17,450 --> 00:03:24,140
قاتلت عائلة فيكوني للجيش الملكيّ
في حرب سويغل الأهليّة

24
00:03:24,400 --> 00:03:26,600
وهُزمت

25
00:03:26,950 --> 00:03:29,770
دفعت عائلة فيكوني تعويضها الماليّ

26
00:03:29,770 --> 00:03:31,890
أتممت إجراءات ما بعد الحرب

27
00:03:32,280 --> 00:03:35,450
إذا كنت تعرف كلّ ذلك، سيسهل الموضوع

28
00:03:35,450 --> 00:03:39,800
سلّم الكونت فيكوني
معظم ثروته وأرضه

29
00:03:39,800 --> 00:03:42,860
لكن لم ينته الأمر هناك

30
00:03:43,580 --> 00:03:47,120
صحيح، حوّلوا انتباههم إلى ديا

31
00:03:48,380 --> 00:03:50,800
ديا فتاةٌ جميلة

32
00:03:50,800 --> 00:03:53,760
كما تمتلك سحراً قويّاً

33
00:03:53,760 --> 00:03:56,340
يُرجّح أن تنجب خليفةً ناجحاً

34
00:03:56,960 --> 00:04:00,130
من الطبيعيّ أن يريد أيّ
نبيل طمّاع الحصول عليها

35
00:04:01,440 --> 00:04:05,760
نوى الكونت فيكوني الانصياع لمطالبهم

36
00:04:05,760 --> 00:04:10,620
ووافقت ديا على ذلك أيضاً
لمنع سفك المزيد من الدماء

37
00:04:10,620 --> 00:04:12,310
هكذا إذاً

38
00:04:14,850 --> 00:04:19,330
عرفت ديا أنّها لن تأتي
إلى توا دي من جديد

39
00:04:19,330 --> 00:04:21,070
هنا المشكلة

40
00:04:21,450 --> 00:04:26,790
رفض أعوان فيكوني السماح
لهم بتسليم ديا

41
00:04:26,790 --> 00:04:31,660
قتلوا المبعوثين الذين أتوا
لأخذ ديا فوق ذلك

42
00:04:33,210 --> 00:04:36,490
لا بدّ أنّ عائلة فيكوني بغاية الشعبيّة

43
00:04:36,490 --> 00:04:42,440
ليس أعوانها فحسب، بل شكّل شعبها
جيش متطوّعين أيضاً

44
00:04:42,440 --> 00:04:44,130
حصّنوا أنفسهم داخل القلعة

45
00:04:44,130 --> 00:04:48,010
وأغلقوا على الكونت فيكوني وديا هناك

46
00:04:49,290 --> 00:04:53,150
يُعامل الكونت فيكوني كمُحرّض حرب أهليّة

47
00:04:53,690 --> 00:04:57,810
تمّ إرسال الجيش لقلعته سلفاً، وبدأ القتال

48
00:04:57,810 --> 00:05:01,340
ويريدوننا أن نقتل ديا لإيقاف الحرب؟

49
00:05:02,020 --> 00:05:03,320
من العميل؟

50
00:05:03,640 --> 00:05:07,410
العميل هو أبو ديا، الكونت فيكوني

51
00:05:09,190 --> 00:05:12,850
خاطر هذا الرجل بحياته لإيصال نوايا العميل

52
00:05:12,850 --> 00:05:15,200
طلبه هو اغتيال ديا

53
00:05:15,200 --> 00:05:17,180
لكن هذا إيهام

54
00:05:17,180 --> 00:05:18,080
إيهام؟

55
00:05:18,440 --> 00:05:20,650
،حتّى لو فاز بهذه المعركة

56
00:05:20,650 --> 00:05:23,380
ستُرسل تعزيزات، ولن يكون هنالك معنى

57
00:05:23,640 --> 00:05:28,370
فهمت، لا مفرّ لهم من الموت
بما أنّهم أشعلوا ثورة

58
00:05:29,050 --> 00:05:31,760
ومهما قاوموا، لا يمكن إنقاذ ديا

59
00:05:31,760 --> 00:05:35,140
يفضّل التظاهر بقتلها
كي يمكّنها من الهرب

60
00:05:35,140 --> 00:05:38,040
هذا السبيل الوحيد لإنقاذها

61
00:05:38,040 --> 00:05:42,320
ونحن توا دي هم الوحيدون
القادرون على ذلك

62
00:05:43,140 --> 00:05:44,900
لديّ سؤالٌ آخر

63
00:05:44,900 --> 00:05:45,960
ما هو؟

64
00:05:45,960 --> 00:05:48,320
لمَ قبلت بهذا العمل؟

65
00:05:48,600 --> 00:05:51,940
،حتّى لو كان صديقك في خطر

66
00:05:51,940 --> 00:05:55,120
لا أستطيع تصوّرك تلوي
مبادئ توا دي

67
00:05:55,120 --> 00:05:57,800
أنت تبالغ في تقديري

68
00:05:57,800 --> 00:06:01,770
عليّ أن أردّ ديني للكونت فيكوني

69
00:06:01,770 --> 00:06:06,130
إذا أرادني أن أنقذ ديا، فسأفعل ذلك

70
00:06:06,880 --> 00:06:08,300
وإن رفضت؟

71
00:06:08,300 --> 00:06:10,360
سأذهب أنا

72
00:06:10,360 --> 00:06:14,120
لكنّ الطريق طويل لمنطقة فيكوني

73
00:06:14,120 --> 00:06:16,720
لن أصل في الوقت

74
00:06:16,720 --> 00:06:20,120
كما أنّ المانا خاصّتي ستنفد بوقت وصولي

75
00:06:20,120 --> 00:06:21,760
ولن أستطيع فعل شيء

76
00:06:23,500 --> 00:06:26,250
غادر فيكوني قبل ثلاثة أيام

77
00:06:26,250 --> 00:06:28,320
القتال بدأ

78
00:06:28,700 --> 00:06:30,970
أنت الوحيد القادر على فعلها يا لوغ

79
00:06:30,970 --> 00:06:35,270
لكنّ هذا ينبع من مشاعري الشخصيّة
ولا يتفرّع من مبادئنا

80
00:06:35,270 --> 00:06:38,040
لا يعدو عن كونه طلباً منّي لك

81
00:06:39,440 --> 00:06:41,850
لا دافع مبرّر للقيام بهذا العمل

82
00:06:42,470 --> 00:06:46,050
كما يحمل خطر أذيّة مملكة آلفان

83
00:06:46,050 --> 00:06:49,260
ليس بعملٍ يُفترض بي قبوله في العادة

84
00:06:49,900 --> 00:06:52,470
لكنّي اتّخذت قراري سلفاً

85
00:06:53,470 --> 00:06:57,140
بعد عيش حياتي كأداة، تمّ التخلّص منّي

86
00:06:57,140 --> 00:06:59,390
لن أكرّر تلك الغلطة

87
00:07:00,180 --> 00:07:02,270
لم أعد أداة

88
00:07:02,270 --> 00:07:08,130
،كبشريّ منفرد، سأحكم بنفسي
وأتّخذ خياراتي وقراراتي

89
00:07:09,320 --> 00:07:11,490
أقبل هذا العمل

90
00:07:12,620 --> 00:07:14,370
ما دوافعك؟

91
00:07:14,370 --> 00:07:15,700
لديّ ثلاثة

92
00:07:15,950 --> 00:07:19,330
الأوّل: أدين لـ ديا لتعليمها إيّاي السحر

93
00:07:19,580 --> 00:07:22,170
الثاني: أنا أحبّ ديا

94
00:07:22,440 --> 00:07:28,730
الثالث: وعدتُ ديا أنّي سأهبّ
لمساعدتها متى طلبت

95
00:07:29,360 --> 00:07:31,070
لا بدّ أنّها تناديني الآن

96
00:07:32,570 --> 00:07:38,190
فهمت، لويتُ مبادئي مرّةً
واحدة في حياتي

97
00:07:38,190 --> 00:07:43,560
حملتُ نصل عائلة توا دي
لشخص غير مملكة آلفان

98
00:07:44,460 --> 00:07:46,780
أتعرف السبب؟

99
00:07:46,780 --> 00:07:52,030
كلا، لا يمكنني تصوّرك تفعل ذلك

100
00:07:52,830 --> 00:07:55,490
كانت زوجتي، إيسري

101
00:07:58,640 --> 00:08:03,920
لعلّك شككت بالأمر، لكنّ إيسري
ابنة لعائلة فيكوني

102
00:08:05,200 --> 00:08:07,880
أي يجعل هذا ديا قريبتك

103
00:08:08,120 --> 00:08:10,820
الشعر الفضيّ متوارث

104
00:08:12,070 --> 00:08:16,300
لم يخطر لي أن يُقدم ابني
على نفس الاختيار

105
00:08:16,300 --> 00:08:19,380
ظننتُ أنّك ستكبر
وتصبح مختلفاً عنّي

106
00:08:20,820 --> 00:08:23,390
لكن يبدو أنّ بيننا
شبهاً بطريقة غريبة

107
00:08:23,390 --> 00:08:24,400
...أبي

108
00:08:25,240 --> 00:08:27,230
لوغ، بالتوفيق

109
00:08:27,620 --> 00:08:28,300
أجل

110
00:08:33,040 --> 00:08:33,950
لوغ-ساما

111
00:08:34,540 --> 00:08:36,300
سأساعدك

112
00:08:37,040 --> 00:08:41,410
أقدّر شعورك، لكن تبعد وجهتي
ما يفوق 300 كيلومتراً

113
00:08:41,790 --> 00:08:43,870
سأتحرّك بأقصى سرعتي

114
00:08:43,870 --> 00:08:46,250
المسافة صعبةٌ عليك يا تارت

115
00:08:47,340 --> 00:08:50,550
أجل، أعرف أنّي لن أستطيع
مرافقتك حتّى النهاية

116
00:08:51,860 --> 00:08:55,190
لكن يمكنني مشاركة قوّتي معك

117
00:08:55,700 --> 00:08:57,050
ما قصدك؟

118
00:08:57,050 --> 00:08:59,420
،حتّى بقدرتك في التعافي السريع

119
00:08:59,420 --> 00:09:02,680
لن تتعافى بسرعة كافية إذا
ركضت بأقصى سرعة

120
00:09:02,680 --> 00:09:06,600
عليك ادّخار المانا وقوّتك للقتال

121
00:09:07,260 --> 00:09:10,270
هل تنوين حملي منتصف الطريق؟

122
00:09:10,800 --> 00:09:11,580
أجل

123
00:09:12,970 --> 00:09:15,670
سأستعمل تعويذة الرياح
التي علّمتني إيّاها

124
00:09:17,050 --> 00:09:18,260
درع الرياح

125
00:09:22,000 --> 00:09:26,100
سأجرّك، اتبعني يا لوغ-ساما

126
00:09:31,250 --> 00:09:33,880
توجد مقاومة رياح كبيرة عند
الانتقال بسرعة عالية

127
00:09:36,260 --> 00:09:41,810
بعد قرابة 40 كيلومتراً، ستستهلك
مقاومة الرياح معظم طاقتك

128
00:09:42,800 --> 00:09:46,770
بينما ترتفع سرعتك، ترتفع مقاومة الرياح طردياً

129
00:09:46,770 --> 00:09:48,690
فتستهلك طاقةً أكبر

130
00:09:49,780 --> 00:09:54,690
،باستعمال واقيها للرياح لحجب الهواء
تخفّض مقاومتي للهواء

131
00:09:54,970 --> 00:09:58,860
ليس ذلك فحسب، بل تسحبني بالضغط السلبيّ

132
00:09:58,860 --> 00:10:01,660
أي ما يُعرف بالتيّار الانزلاقيّ

133
00:10:02,070 --> 00:10:04,370
إنّها تحملني فعلياً

134
00:10:08,520 --> 00:10:15,290
العدو بأقصى سرعة أثناء المحافظة على الواقي
أمرٌ منهك ذهنياً وبدنياً

135
00:10:20,630 --> 00:10:24,930
أنقذني لوغ-ساما عندما كنتُ أحتضر

136
00:10:25,280 --> 00:10:29,390
لكنّه لم يفعل ذلك لأجلي

137
00:10:29,810 --> 00:10:35,280
فعله ليستفيد منّي، لأنّي كنت أمتلك مانا

138
00:10:35,780 --> 00:10:39,150
لأنّه رأى أنّ بإمكانه استعمالي كأداة

139
00:10:40,170 --> 00:10:48,080
سيكون ذلك أمراً حزيناً للشخص العاديّ، لكنّه أسعدني

140
00:10:48,510 --> 00:10:50,370
أخبروني أنّي طفلة غير مرغوبٍ بها

141
00:10:50,370 --> 00:10:52,710
تمّ التخلّي عنّي لتقليص عدد
الأفواه على المائدة

142
00:10:52,710 --> 00:10:59,840
ولم يحتجني أحد، لكنّ لوغ-ساما أخبرني أنّه يحتاجني

143
00:11:00,420 --> 00:11:03,550
منحني سبباً للعيش

144
00:11:03,550 --> 00:11:08,470
!لذا سأكرّس حياتي لك يا لوغ-ساما

145
00:11:21,530 --> 00:11:22,630
...المانا خاصّتها

146
00:11:22,630 --> 00:11:24,490
التيّارات الهوائيّة بدأت تصبح هائجة

147
00:11:25,110 --> 00:11:27,380
يكفي يا تارت، وصلتِ حدّك

148
00:11:29,920 --> 00:11:33,270
!ليس بعد! ليس بعد

149
00:11:37,880 --> 00:11:42,680
كره لوغ-ساما فكرة أن يصبح أداة

150
00:11:42,910 --> 00:11:47,060
سواءً كانت أوامر السيّد، أو واجبات عائلة توا دي

151
00:11:47,060 --> 00:11:54,190
،كان يستطيع التفكير دوماً، الاختيار
والقتال بإرادته الخاصّة

152
00:11:54,520 --> 00:11:57,980
وشاهدتُ كلّ ذلك

153
00:11:58,920 --> 00:12:02,570
عملي هو تحقيق أمنيات لوغ-ساما

154
00:12:03,210 --> 00:12:07,620
لذا إذا رفض لوغ-ساما فكرة
،أن يصبح أداة

155
00:12:07,620 --> 00:12:12,290
!فسأصبح الأداة المطلقة له

156
00:12:12,550 --> 00:12:19,460
إذا أراد إنقاذ ديا-ساما، فسأفعل
!كلّ ما بوسعي لإنقاذها

157
00:12:46,250 --> 00:12:47,340
أأنتِ بخير؟

158
00:12:52,720 --> 00:12:59,210
أنا... آسفة... هذا أقصى... حدٍّ لي

159
00:12:59,720 --> 00:13:01,120
إنّه يكفي

160
00:13:01,120 --> 00:13:03,670
تمكّنتُ من ادّخار طاقتي بفضلك

161
00:13:08,030 --> 00:13:12,460
هذه أوّل مرّةٍ أصل لهذا البعد
في فترة وجيزة

162
00:13:17,920 --> 00:13:18,870
...عذراً

163
00:13:20,380 --> 00:13:24,770
تحبّ ديا-ساما يا لوغ-ساما، أليس كذلك؟

164
00:13:25,290 --> 00:13:26,110
بلى

165
00:13:27,900 --> 00:13:29,320
عِدني

166
00:13:30,520 --> 00:13:33,410
عِدني بأن ترجعا معاً

167
00:13:33,820 --> 00:13:34,600
أجل

168
00:13:37,540 --> 00:13:39,040
سأرجع حتماً

169
00:14:22,280 --> 00:14:23,630
!فلأصل قبل فوات الأوان

170
00:14:24,110 --> 00:14:24,940
!ديا

171
00:14:30,510 --> 00:14:31,940
...لوغ-تشان إذاً

172
00:14:32,970 --> 00:14:34,930
هذا يذكّرني بالماضي

173
00:14:34,930 --> 00:14:36,640
وأنا

174
00:14:36,900 --> 00:14:41,100
لكنّه فتى قويّ، أقوى منّي

175
00:14:55,200 --> 00:15:01,790
مشرفة نظام حفظ العالم رقم 3800
تقدّم بلاغها للوجود الأسمى

176
00:15:02,010 --> 00:15:05,230
،لمنع دمار العالم المتوقّع

177
00:15:05,230 --> 00:15:09,850
اخترتُ عدّة خبراء في مجالات مختلفة
على مرّ عقود

178
00:15:09,850 --> 00:15:13,980
،وأخذت أرواحهم عند موتهم، أعدت تجسيدهم

179
00:15:13,980 --> 00:15:16,310
وأرسلتهم كعملاء متخفّيين في العالم

180
00:15:16,600 --> 00:15:18,900
،راقبتُ تقدّمهم وأفعالهم

181
00:15:19,330 --> 00:15:23,460
وحسبتُ المجالات بنسب النجاح العالية

182
00:15:32,880 --> 00:15:36,340
تمّ العثور على روح ملائمة
لإيقاف ثوران البطل

183
00:15:36,920 --> 00:15:38,830
سأنتظر موتها

184
00:15:43,410 --> 00:15:46,290
يبدو أنّ تعداد العدوّ قرابة 1500

185
00:15:47,050 --> 00:15:49,050
هذا أكثر مما توقّعت

186
00:15:49,640 --> 00:15:52,510
قوّات عائلة فيكوني تقلّ عن 200 مقاتل

187
00:15:59,900 --> 00:16:02,570
يمتلك العدوّ مستعملي سحر أكثر أيضاً

188
00:16:02,570 --> 00:16:04,810
أفضليّتهم في القتال كبيرةٌ جدّاً

189
00:16:05,240 --> 00:16:07,350
لكن... الأمر غريب

190
00:16:07,350 --> 00:16:10,150
كيف تصمد قوّات فيكوني في هذا الموقف الضعيف؟

191
00:16:11,750 --> 00:16:15,800
من ظاهرهم، يبدو أنّ جيش
العدو يخشى المقذوفات

192
00:16:17,360 --> 00:16:18,810
هكذا إذاً

193
00:16:20,120 --> 00:16:24,750
كنتُ متحضّراً للعيش في هذا العالم كمغتال

194
00:16:25,350 --> 00:16:30,970
لأنّي أختار وأحكم وأقتل بإرادتي

195
00:16:31,970 --> 00:16:35,510
لذا لا أقتل بلا داعٍ

196
00:16:36,090 --> 00:16:37,150
...لكن

197
00:16:37,150 --> 00:16:38,260
صنع البندقيّة

198
00:16:40,640 --> 00:16:47,700
هذه حرب، وشرطي للنصر هو
إنقاذ ديا وتزييف موتها

199
00:16:49,760 --> 00:16:53,450
سأقتل كلّ من يحاول أخذها، بلا أيّة شفقة

200
00:16:55,150 --> 00:16:56,240
مستعمل سحر

201
00:16:56,800 --> 00:16:58,200
فئة القائد

202
00:17:05,580 --> 00:17:07,190
!طلقات معدنيّة

203
00:17:08,140 --> 00:17:09,490
!أهي ابنة الكونت؟

204
00:17:09,490 --> 00:17:11,230
!كلا، إنّها من خلفنا

205
00:17:11,230 --> 00:17:12,790
!التشكيلة الدفاعيّة

206
00:17:12,790 --> 00:17:13,680
!حاضر

207
00:17:15,130 --> 00:17:16,760
!إطلاق

208
00:17:20,370 --> 00:17:23,890
،إذا استجابوا بهذه السرعة
فلا بدّ أنّهم يعرفون المسدّسات

209
00:17:24,400 --> 00:17:26,190
،لو وضعوا مستعملي السحر في المقدمة

210
00:17:26,190 --> 00:17:28,350
لاستطاعوا الهيمنة بمجرّد
أفضليّتهم العدديّة

211
00:17:28,630 --> 00:17:32,100
لكنّ مستعملي السحر أشخاصٌ رفيعو المراتب

212
00:17:32,100 --> 00:17:35,070
لا يمكنهم أن يرسلوهم للمقدّمة إن
عرفوا أنّهم سيتعرّضون للإطلاق

213
00:17:35,440 --> 00:17:36,810
،نتيجةً لذلك

214
00:17:36,810 --> 00:17:40,280
تمتلك قوّات فيكوني الأفضليّة بما أنّها ترسل
مستعملي السحر للمقدّمة

215
00:17:40,990 --> 00:17:46,580
صمدوا للثلاثة أيّامٍ لأنّ ديا
كانت تساندهم بالمسدّسات

216
00:17:51,520 --> 00:17:53,850
سأستعمل سحر الرياح لسماع الأصوات

217
00:17:53,850 --> 00:17:55,180
تحديد الرياح

218
00:18:02,720 --> 00:18:05,570
!نحن نتعرّضٍ لهجمات من الخلف

219
00:18:05,570 --> 00:18:06,600
أهي تعزيزات؟

220
00:18:06,980 --> 00:18:11,300
يوجد مستعملو طلقات معدنيّة
غير ابنة الكونت؟

221
00:18:11,890 --> 00:18:14,160
!إنّهم يستهدفون مستعملي السحر فحسب

222
00:18:14,160 --> 00:18:15,640
إنّهم مرتبكون

223
00:18:16,160 --> 00:18:18,600
هذه فرصة مهاجمتهم أثناء الهروب

224
00:18:18,600 --> 00:18:20,030
صنع البندقيّة

225
00:18:23,820 --> 00:18:29,070
،عندما يصل حجر فار كتلةً حرجة
سيطلق كلّ المانا خاصّته دفعةً واحدة

226
00:18:29,680 --> 00:18:31,800
،عندما تتحرّر المانا لحظيّاً

227
00:18:31,800 --> 00:18:35,130
،تنطلق بسرعة تفوق سرعة الصوت
وتخلق موجة صدم

228
00:18:39,200 --> 00:18:43,950
وأمنحها قوّة القتل لشظيّة ذخيرة
بـ 10% مانا أرض

229
00:18:45,140 --> 00:18:47,650
ثمّ أطلقها باستعمال قوسٍ
لا يصدر صوتاً

230
00:19:00,110 --> 00:19:02,650
إنّها أشبه بقاذفة قنابل

231
00:19:10,710 --> 00:19:11,790
...ديا

232
00:19:14,400 --> 00:19:15,750
!لا تتجمعّوا

233
00:19:15,750 --> 00:19:17,780
!انتشروا

234
00:19:26,200 --> 00:19:28,400
!قوّات العدوّ في فوضى

235
00:19:28,400 --> 00:19:29,770
!لا تفوّتوا هذه الفرصة

236
00:19:30,280 --> 00:19:32,150
!هجوم

237
00:19:39,360 --> 00:19:41,600
يبدو أنّهم رأوا الفرصة السانحة

238
00:19:41,600 --> 00:19:42,900
تحويل المعدن

239
00:19:43,840 --> 00:19:45,720
يكفي تشتيتاً للانتباه

240
00:19:47,000 --> 00:19:49,080
العمل الحقيقيّ يبدأ الآن

241
00:20:02,920 --> 00:20:04,010
رياح التحديد

242
00:20:13,800 --> 00:20:17,540
وأجد سبيلاً خاوياً

243
00:20:36,020 --> 00:20:39,250
لا بأس، أثق بك

244
00:20:47,770 --> 00:20:53,020
لتزييف موت ديا، عليّ خداع كلّ شعبها

245
00:20:53,020 --> 00:20:58,600
ولتحقيق ذلك، لا يمكن أن يشاهدني
أحد الجنود داخل القلعة أيضاً

246
00:21:00,500 --> 00:21:01,820
تحويل المعدن

247
00:21:04,050 --> 00:21:04,740
!ديا

248
00:21:09,980 --> 00:21:10,970
!لوغ

249
00:21:10,970 --> 00:21:11,790
!ديا

250
00:21:16,000 --> 00:21:18,230
أنا مسرورٌ لأنّكِ بخير

251
00:21:21,580 --> 00:21:23,510
أتيت حقّاً

252
00:23:09,160 --> 00:23:09,990
ادخل

253
00:23:10,750 --> 00:23:14,070
،كنتِ تجمعين معلومات عن الكنوز المقدّسة
صحيح يا ماها؟

254
00:23:14,070 --> 00:23:14,700
أجل

255
00:23:15,090 --> 00:23:17,910
أيمكن أنّها هذه؟

256
00:23:23,190 --> 00:23:26,900
نوين، جهّزي حمامة زاجلة
لإرسالها لـ توا دي

257
00:23:26,900 --> 00:23:27,760
حاضرة

258
00:23:30,030 --> 00:23:34,040
عليّ إعلام أخي لوغ بهذا

259
00:23:36,120 --> 00:23:38,780
"الحلقة القادمة: "معركة المغتالين