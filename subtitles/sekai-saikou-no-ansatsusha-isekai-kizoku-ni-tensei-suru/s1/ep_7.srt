1
00:00:05,780 --> 00:00:08,610
كيف حالك يا أخي؟

2
00:00:09,810 --> 00:00:12,780
أشعر بتحسّنٍ كبير يا إيلغ-ساما

3
00:00:13,040 --> 00:00:16,740
حمداً لله، ستتمكّن من العودة
للعمل يا بيرويد

4
00:00:17,000 --> 00:00:21,930
أجل يا أبي، ذلك بفضل
عمليّة إيلغ-ساما الجراحيّة

5
00:00:21,930 --> 00:00:24,100
،كما ذكرتُ سابقاً

6
00:00:24,100 --> 00:00:27,840
أخف أمر إجرائي للجراحة عليك
عن الجميع من فضلك

7
00:00:27,840 --> 00:00:30,360
حتّى عن أمّك

8
00:00:30,360 --> 00:00:32,630
أجل، أعرف

9
00:00:33,520 --> 00:00:37,550
،لا عجب أنّك كبير عائلة توا دي التالي
العائلة المشهورة بتقنياتها الطبيّة

10
00:00:37,840 --> 00:00:40,050
لا كلمات شكر توفيك حقّك

11
00:00:40,050 --> 00:00:42,040
لا داعي لشكري

12
00:00:42,040 --> 00:00:44,520
فـ بيرويد-ساما أخي

13
00:00:44,950 --> 00:00:51,520
أضفتُ اسم إيلغ بالور لسجلّي العائلي
،ردّاً للجميل الذين أدين لأبيك به

14
00:00:51,520 --> 00:00:54,530
لكنّكم أدّيتم جميلاً آخر لي

15
00:00:54,530 --> 00:00:56,320
كيف لي أن أردّه؟

16
00:00:56,640 --> 00:01:01,740
حسناً، يمكنكم أن تبقوا عائلةً
أستطيع الرجوع لها بأيّ وقت

17
00:01:02,070 --> 00:01:06,260
تلك خطّةٌ احتياطية مثاليّة
لمغتالٍ بالفعل

18
00:01:06,770 --> 00:01:10,670
بالمناسبة، أكملتُ عمليّة التبنّي

19
00:01:10,670 --> 00:01:12,300
هذه الوثائق حقيقيّة

20
00:01:12,890 --> 00:01:14,340
شكراً جزيلاً لك

21
00:01:14,340 --> 00:01:16,220
ازدادت عائلتنا فرداً الآن

22
00:01:17,690 --> 00:01:20,310
أصبحتِ أختي الصغيرة رسميّاً الآن

23
00:01:21,210 --> 00:01:22,980
...من اليوم فصاعداً، اسمكِ هو

24
00:01:24,830 --> 00:01:26,880
ماها بالور

25
00:01:26,880 --> 00:01:28,980
حاضرة يا أخي إيلغ

26
00:03:04,920 --> 00:03:07,870
كيف أساعدك اليوم يا أبي؟

27
00:03:08,250 --> 00:03:10,110
انظر لهذه

28
00:03:10,110 --> 00:03:12,960
إنّه محلٌّ جميل، يمكنك فعل
أيّ شيءٍ به

29
00:03:13,330 --> 00:03:17,280
تبيع شركة بالور التجاريّة مختلف البضائع

30
00:03:17,280 --> 00:03:21,680
جعلنا هذا المحلّ
،متجر خمورٍ مؤقتاً

31
00:03:21,680 --> 00:03:26,160
لكنّه فشل بذراعة، لذا سننتقل للفكرة التالية

32
00:03:26,160 --> 00:03:28,360
أريدك أن تدير هذا المحلّ

33
00:03:28,360 --> 00:03:31,640
أنا متأكّد أنّك ستتمكّن
من بثّ حياةٍ جديدةٍ فيه

34
00:03:31,970 --> 00:03:34,520
لم يمض أكثر من 6 أشهر
على وصولي هنا

35
00:03:34,520 --> 00:03:38,860
،لم أكن لأطلب هذا في العادة
لكنّك لست بعاديّ

36
00:03:39,110 --> 00:03:41,450
سأخبرك بشيء

37
00:03:41,450 --> 00:03:45,320
يحتاج التاجر للعين الثاقبة
الفاحصة للناس قبل أيّ شيء

38
00:03:45,320 --> 00:03:48,210
وأنا تاجرٌ من الطراز الأوّل

39
00:03:48,210 --> 00:03:52,400
وعيني تخبرني أنّك قادرٌ على فعلها

40
00:03:52,400 --> 00:03:55,000
فهمت، سأجرّب

41
00:03:56,760 --> 00:03:57,840
رجعت

42
00:03:58,140 --> 00:04:00,420
مرحباً بعودتك يا إيلغ-ساما

43
00:04:00,420 --> 00:04:02,510
مرحباً بعودتك يا أخي إيلغ

44
00:04:02,880 --> 00:04:04,600
أعتذر على تأخّري

45
00:04:05,590 --> 00:04:08,140
صنعتُ وتارت الحساء

46
00:04:08,390 --> 00:04:10,980
أنا متأكّدةٌ أنّ شريحة اللحم
المقدد التي صنعتها ستروقك

47
00:04:10,980 --> 00:04:12,400
تبدو لذيذة

48
00:04:12,400 --> 00:04:14,350
طبقي لا يقلّ عنها

49
00:04:15,140 --> 00:04:17,110
تناوله رجاءً يا إيلغ-ساما

50
00:04:21,230 --> 00:04:24,440
تلقّيتُ اليوم عملاً جديداً من أبي

51
00:04:24,440 --> 00:04:26,240
وضع متجراً في عهدتي

52
00:04:26,240 --> 00:04:28,200
مبهرٌ يا إيلغ-ساما

53
00:04:28,200 --> 00:04:31,580
أنا فخورةٌ بك يا أخي

54
00:04:31,890 --> 00:04:34,050
ستكون هذه مسألةً سرّية

55
00:04:34,050 --> 00:04:37,520
سأقوم بشيءٍ مختلف كلّياً بهذا المتجر

56
00:04:37,520 --> 00:04:39,920
شيء مختلف؟

57
00:04:39,920 --> 00:04:42,220
هنالك هدفان مهمّان لهذا العمل

58
00:04:42,220 --> 00:04:43,630
أولهما هو جني المال

59
00:04:43,630 --> 00:04:46,510
سيمكّنك ذلك من إبقاء المتجر
مفتوحاً لوقتٍ طويل

60
00:04:46,510 --> 00:04:50,060
والثاني هو عرض البضائع الموجّهة للنبلاء

61
00:04:50,400 --> 00:04:52,200
للاقتراب منهم

62
00:04:52,200 --> 00:04:55,270
أي أنّ خطّتك هي استعمال المتجر
لعمليّات اغتيالك

63
00:04:55,530 --> 00:04:58,560
لذا سأجعله متجراً للنساء

64
00:04:58,560 --> 00:05:01,650
سنبيع مستحضرات التجميل بشكلٍ
أساسيّ كما الحلويات

65
00:05:01,960 --> 00:05:04,310
!رائع

66
00:05:04,310 --> 00:05:07,540
لكن توجد متاجر شهيرة كثيرة
،مشابهة في ميلتيو

67
00:05:07,540 --> 00:05:09,990
ألن يكون دخول السوق صعباً؟

68
00:05:10,760 --> 00:05:12,040
لديّ خطّة

69
00:05:18,740 --> 00:05:20,490
أنا في الثالثة عشر حالياً

70
00:05:21,060 --> 00:05:25,130
أي أنّ عليّ اغتيال البطل
خلال الخمسة أعوامٍ القادمة

71
00:05:25,760 --> 00:05:28,570
أحتاج لأن أصبح أقوى لتحقيق ذلك

72
00:05:36,410 --> 00:05:37,350
لا بأس

73
00:05:37,350 --> 00:05:38,480
شكراً

74
00:05:42,320 --> 00:05:44,230
،تخلّى والدا تارت عنها

75
00:05:44,650 --> 00:05:46,740
وفقدت ماها والديها

76
00:05:47,190 --> 00:05:50,500
تلتمسان الدفء البشريّ أحياناً

77
00:05:51,060 --> 00:05:53,580
آمل أن يمضي عملك بخير

78
00:05:53,580 --> 00:05:55,120
سندعمك

79
00:05:55,120 --> 00:05:58,170
شكراً لكما، يمكنني الاجتهاد بفضلكما

80
00:05:58,470 --> 00:06:00,460
أخبرنا إن كان هناك
ما نستطيع فعله

81
00:06:00,720 --> 00:06:02,840
سنساعد بأيّ شيء

82
00:06:02,840 --> 00:06:04,460
سأعتمد عليكما

83
00:06:05,280 --> 00:06:07,840
كلتاهما معجبتان بي

84
00:06:07,840 --> 00:06:10,700
وتثق بي عائلة بالور كليّاً أيضاً

85
00:06:11,230 --> 00:06:13,150
حصلتُ على قطعٍ ممتازة

86
00:06:14,240 --> 00:06:15,680
كلّ شيءٍ يجري وفق الخطّة

87
00:06:22,220 --> 00:06:26,610
أبي، أمّي، شكراً لكما
على استقطاع وقتٍ لي

88
00:06:26,920 --> 00:06:28,880
أنت سريع العمل يا إيلغ

89
00:06:28,880 --> 00:06:31,490
لا أصدّق أنّك صنعت نموذجاً
أوليّاً خلال يومين

90
00:06:31,940 --> 00:06:35,000
يُستحسن بك ألّا تكون
قد جلبت شيئاً تافهاً

91
00:06:35,000 --> 00:06:39,920
وبكلّ الأحوال، أنت لا تروقني
بما أنّك ابنه اللا شرعيّ

92
00:06:39,920 --> 00:06:43,500
أعتقد أنّي حضّرتُ شيئاً سيفي بتطلّعاتكم

93
00:06:43,500 --> 00:06:46,630
أنوي جعل مستحضرات التجميل
البضاعة الأساسيّة لمتجري الجديد

94
00:06:47,100 --> 00:06:50,600
لكنّ العلامة التجاريّة تهمّ أكثر
من الجودة في عالم المستحضرات

95
00:06:50,600 --> 00:06:53,680
من الصعبّ شق طريقك كوافد
جديد في السوق

96
00:06:53,960 --> 00:06:57,800
بالطبع، ذلك لو كنتُ
أبيع مستحضرات موجودة سلفاً

97
00:06:57,800 --> 00:07:00,860
تجمّل المستحضرات النساء

98
00:07:00,860 --> 00:07:04,490
لكنّ نزعها يمتصّ زيت البشرة معه

99
00:07:04,490 --> 00:07:06,760
وتتسرّب رطوبة البشرة دون الزيت

100
00:07:06,760 --> 00:07:10,200
مما يسبّب جفاف البشرة
ويترك أضراراً أكبر

101
00:07:10,200 --> 00:07:12,590
لن أنكر ذلك

102
00:07:12,590 --> 00:07:15,450
لكنّنا نستعمل المستحضرات
للتجميل بغضّ النظر عن ذلك

103
00:07:15,760 --> 00:07:19,620
وثمن استعمالها هو البشرة المتضرّرة

104
00:07:19,990 --> 00:07:22,750
أريد تحرير النساء من تلك المشكلة

105
00:07:23,170 --> 00:07:25,420
هذا غرض هذا المنتج

106
00:07:26,620 --> 00:07:28,460
أسمّيه بالمُرطّب

107
00:07:29,080 --> 00:07:33,270
لا يوجد الغسول أو المرطّبات
في هذا العالم بعد

108
00:07:33,270 --> 00:07:36,820
أي أنّه المُرطّب الأوّل في هذا العالم

109
00:07:36,820 --> 00:07:39,560
مُرطّب؟ ما الذي يفعله؟

110
00:07:39,850 --> 00:07:44,150
إنّه مستحضرٌ يرطّب البشرة
الجافّة ويحتفظ بحالتها

111
00:07:56,000 --> 00:08:01,120
،تزيّن المساحيق المرء بجمالٍ زائف
لكنّ هذا مختلف

112
00:08:01,440 --> 00:08:04,440
بدل تزيينها، يعالج هذا المنتج
البشرة ويحميها

113
00:08:04,440 --> 00:08:07,170
يجعل البشرة جميلةً من الأصل

114
00:08:07,170 --> 00:08:11,760
لا يُعقل، بشرتي رطبةٌ وملساء جدّاً

115
00:08:11,760 --> 00:08:14,510
مضى وقتٌ طويل مذ كانت بشرتي هكذا

116
00:08:14,510 --> 00:08:16,640
أهذا زيت؟

117
00:08:16,640 --> 00:08:19,220
لكنه منعشٌ جدّاً على ذلك

118
00:08:19,220 --> 00:08:21,480
هذا هو المُرطّب

119
00:08:21,480 --> 00:08:23,620
مُبهر

120
00:08:23,620 --> 00:08:26,230
أستطيع الإحساس بسعادة بشرتي

121
00:08:26,480 --> 00:08:29,460
يمكن أن يكون المُرطّب
درعاً يحمي البشرة أيضاً

122
00:08:29,460 --> 00:08:32,070
جرّبي وضع المساحيق عليه من فضلك

123
00:08:32,390 --> 00:08:33,280
حسناً

124
00:08:36,370 --> 00:08:38,870
سيحدث هذا ثورةً في مساحيق التجميل

125
00:08:39,140 --> 00:08:42,370
،لن يستبدل المستحضرات الموجودة

126
00:08:42,370 --> 00:08:47,710
إضافة هذا المُرطّب مع المستحضرات
سيكون السلوك الطبيعيّ

127
00:08:48,960 --> 00:08:52,260
أنت محقّ، المساحيق تستقرّ عليه بروعة

128
00:08:53,930 --> 00:08:55,880
هل نال إعجابك؟

129
00:08:56,310 --> 00:08:58,680
أنا أكرهك

130
00:08:59,220 --> 00:09:01,640
لكنّي سأحتفظ بهذا

131
00:09:02,050 --> 00:09:06,930
ميرا، أتظنّين أن صديقاتك
قد يردن هذا المُرطّب أيضاً؟

132
00:09:06,930 --> 00:09:10,770
لا أستطيع تخيّل امرأةٍ لن تريده

133
00:09:11,230 --> 00:09:16,780
أتيتُ هنا بنيّة الازدراء والسخرية
،من أيّ ما صنعته يا إيلغ

134
00:09:16,780 --> 00:09:19,930
لكنّك طردت هذه الفكرة من بالي

135
00:09:19,930 --> 00:09:24,740
سأعتبر ابن المومس ابناً لي
لو عنى ذلك تزويدي بهذا المُرطّب

136
00:09:25,410 --> 00:09:27,290
أعجبكِ لهذا الحدّ؟

137
00:09:29,560 --> 00:09:33,890
سأصبّ تركيز موارد شركة
بالور التجاريّة على هذا المُرطّب

138
00:09:33,890 --> 00:09:37,180
وزّعيه على صديقاتكِ يا ميرا وانشري نبأه

139
00:09:41,560 --> 00:09:45,520
أنا بمفردي الآن، لذا يمكنني صنع 200 قنّينة
في الأسبوع كحدٍّ أقصى

140
00:09:45,520 --> 00:09:47,640
يمكنك توظيف عاملين أكثر

141
00:09:47,960 --> 00:09:51,280
إذا كنت لا تمانع اكتشاف الناس
للمُنتج، فسأفعل

142
00:09:51,280 --> 00:09:55,360
فور بدء بيع المُرطّب، ستفكّر
بقيّة الشركات بتقليدنا

143
00:09:56,770 --> 00:09:59,350
تعجّلت

144
00:10:02,500 --> 00:10:04,200
قرابة شهر

145
00:10:04,200 --> 00:10:06,310
لكن هناك مشكلة واحدة

146
00:10:06,310 --> 00:10:07,580
ما هي؟

147
00:10:08,330 --> 00:10:13,680
،يدمج هذا المنتج الماء والزيت
المادتان اللتان لا تندمجا عادةً

148
00:10:17,030 --> 00:10:18,630
توا دي؟

149
00:10:19,200 --> 00:10:21,470
هذه المصاريف الضروريّة المقدّرة

150
00:10:23,470 --> 00:10:27,440
الثمن ليس بمشكلة، لكنّ توا دي
بعيدة من هنا

151
00:10:27,440 --> 00:10:30,310
هذا ما سيعسّر اكتشاف السرّ

152
00:10:30,660 --> 00:10:33,680
لا يمكنني صنع المُرطّب
دون هذا العقار

153
00:10:33,680 --> 00:10:36,680
في توا دي، يمكننا كتم هذا السرّ

154
00:10:36,680 --> 00:10:43,160
وأستطيع جعلهم يعدون بألّا
يبيعون لشركات أخرى

155
00:10:43,410 --> 00:10:46,500
فهمت، حسنٌ، أعطيك الصلاحيّة

156
00:10:46,500 --> 00:10:48,370
ستتولّى المفاوضات

157
00:10:48,940 --> 00:10:50,330
عُلِم

158
00:10:54,490 --> 00:10:56,200
يبدو أنّ الأمور مضت على ما يرام

159
00:10:56,200 --> 00:10:59,790
أجل، نحتاج لليستين لمزج الزيت والماء

160
00:10:59,790 --> 00:11:01,540
يُستخلص من حبوب الصويا

161
00:11:01,540 --> 00:11:03,100
يمكن زراعتها في توا دي

162
00:11:03,510 --> 00:11:07,810
إذا تمكّنا من بيع الكثير، ستنتفع
توا دي أيضاً

163
00:11:10,340 --> 00:11:15,320
لا يمكن أن يتسلّل أحد لأرض مُغتالين
نُبلاء ويسرق أسرارهم

164
00:11:19,430 --> 00:11:23,120
سيضمن ذلك عدم تخلّصهم مني
عندما تنقطع فائدتي لهم

165
00:11:23,120 --> 00:11:25,120
مُبهرٌ كالعادة يا إيلغ-ساما

166
00:11:25,360 --> 00:11:28,180
أجل، يجري كلّ شيءٍ وفق الخطّة

167
00:11:34,270 --> 00:11:36,920
نهاية الصفّ هنا

168
00:11:36,920 --> 00:11:40,380
اصطفّوا إن كنتم ستزورون أورنا من فضلكم

169
00:11:42,560 --> 00:11:43,890
شكراً على انتظاركنّ

170
00:11:44,450 --> 00:11:49,850
متجر علامة مستحضرات تجميل
شركة بالور التجاريّة، أورنا، مفتوحٌ الآن

171
00:11:49,850 --> 00:11:52,560
ابقين هادئات وخذن وقتكنّ
في دخول المتجر

172
00:11:54,790 --> 00:11:59,340
المعذرة، الحدّ الأقصى لقنّينات المرطب
لكلّ زبونة هي قنّينتين

173
00:11:59,340 --> 00:12:00,840
حقّاً؟

174
00:12:00,840 --> 00:12:02,880
لكنّي كنتُ أنتظر في الصفّ منذ الصباح

175
00:12:02,880 --> 00:12:04,610
أقدّم خالص أسفي

176
00:12:06,550 --> 00:12:09,070
مساعدة المدير، وصلتنا رسالةٌ من المصنع

177
00:12:09,070 --> 00:12:11,670
يبدو أنّهم سيتمكّنون من شحن
مستحلبات أكثر ظهيرة اليوم

178
00:12:11,670 --> 00:12:15,000
فهمت، سنفرض شراءه
مع المنتج السابق

179
00:12:15,000 --> 00:12:17,370
حسناً، سأتفقّد المخزن

180
00:12:17,370 --> 00:12:18,590
انتظري يا نوين

181
00:12:21,630 --> 00:12:23,470
نحن متجر مستحضرات تجميل

182
00:12:23,800 --> 00:12:26,530
يجب أن تكون مستحضرات تجميل
الموظّفات بأشدّ حدّتها

183
00:12:26,530 --> 00:12:28,430
حسناً، تبدين جميلةً يا نوين

184
00:12:28,750 --> 00:12:30,750
شكراً لكِ يا ماها

185
00:12:32,240 --> 00:12:36,190
لم يخطر لي أن تنمو أورنا
لهذا الحدّ بغضون 6 أشهر

186
00:12:36,700 --> 00:12:39,870
،تلقّينا دعوات من حكّام ميلتيو

187
00:12:39,870 --> 00:12:42,650
كما من أميرات من الممالك المجاورة

188
00:12:43,200 --> 00:12:46,310
أصبحت أورنا لـ إيلغ بالور اسماً لامعاً

189
00:12:46,740 --> 00:12:50,450
يمكنني التسلّل لأيّ مكان، إنّه نجاحٌ باهر

190
00:12:50,740 --> 00:12:55,080
أجل، يفيض المتجر بلطفك
يا إيلغ-ساما

191
00:12:55,390 --> 00:12:56,700
لمَ تقولين ذلك؟

192
00:12:58,480 --> 00:13:01,870
وظّفت صديقات ماها-تشان

193
00:13:01,870 --> 00:13:04,590
كلهنّ مفعمات بالحيويّة، ويبدو
أنّهن يستمتعن بوقتهنّ

194
00:13:04,990 --> 00:13:08,350
،لم أكن من اخترتهنّ
كان قرار ماها

195
00:13:08,350 --> 00:13:10,480
بالرغم من ذلك

196
00:13:10,480 --> 00:13:14,350
الشابات بالبشرة الجميلة هن
الممثلات المثاليّات للمتجر

197
00:13:15,000 --> 00:13:18,840
،بما أنّهن كنّ مقرّبات مذ صغرهن
فهي تفرض سيطرتها عليهنّ

198
00:13:18,840 --> 00:13:20,580
كما أنّهن سريعات التعلّم

199
00:13:21,010 --> 00:13:23,680
ولذلك نما المتجر بسرعة

200
00:13:23,680 --> 00:13:24,610
إنها خطةٌ ممتازة

201
00:13:24,840 --> 00:13:27,300
لستَ صريحاً يا إيلغ-ساما

202
00:13:27,300 --> 00:13:29,110
تتكلّمين كأمّي

203
00:13:29,540 --> 00:13:30,910
بالمناسبة، كيف الحراسة؟

204
00:13:31,760 --> 00:13:35,820
يتسلّل جواسيس من إرسال
منافسينا للمصنع يوميّاً

205
00:13:35,820 --> 00:13:37,840
يرشون موظّفينا يومياً أيضاً

206
00:13:37,840 --> 00:13:41,590
لكنّهم لم يستطيعوا اكتشاف
كيفيّة حصولنا على الليستين

207
00:13:41,860 --> 00:13:46,070
ممتاز، لكن يُفترض أن ينفد صبرهم قريباً

208
00:13:50,000 --> 00:13:52,390
يريد الكثيرون بيع المُرطّب

209
00:13:55,390 --> 00:13:58,970
من المنطقيّ أن يستهدفوا
شخصاً يعرفها بالتأكيد

210
00:13:59,920 --> 00:14:01,450
أستشعر وجود شخصٍ واحد

211
00:14:01,450 --> 00:14:03,730
إنّه يقترب من غرفة النوم هذه

212
00:14:04,200 --> 00:14:07,320
كما أنّه حاد المهارة، إنّه جاسوسٌ
من الطراز الأوّل

213
00:14:11,090 --> 00:14:12,080
...لكن

214
00:14:27,330 --> 00:14:29,680
أضفتُ سمّاً عصبيّاً للنصل

215
00:14:29,680 --> 00:14:31,850
لن يتمكّن من تحريك إصبع

216
00:14:34,570 --> 00:14:36,260
تمّ ضبط الدخيل

217
00:14:37,190 --> 00:14:39,690
أبهرني انتباهكما للدخيل

218
00:14:39,690 --> 00:14:40,940
أفتخر بكما

219
00:14:41,980 --> 00:14:43,150
يسرّني سماع ذلك

220
00:14:43,150 --> 00:14:46,110
يحفّزني لما سيأتي تالياً

221
00:14:55,560 --> 00:14:57,150
أعددتُ شاي أعشاب

222
00:14:57,150 --> 00:14:59,210
شكراً لك يا إيلغ-ساما

223
00:14:59,470 --> 00:15:02,040
كان بإمكانك أن تنام دوننا

224
00:15:02,720 --> 00:15:06,300
عرّيتماه لإذلاله وإشعاره بعجزه

225
00:15:06,300 --> 00:15:08,780
تذكّرتما أساسيّات التعذيب

226
00:15:09,770 --> 00:15:11,280
لا يمكنك نطق ذلك

227
00:15:11,280 --> 00:15:14,850
لن تكون الفعاليّة نفسها إذا سمعك

228
00:15:15,850 --> 00:15:24,230
،هل نتركك تعيش إذا أخبرتنا بمن أرسلك
أو نقتلك بغضّ النظر؟

229
00:15:25,190 --> 00:15:29,400
عليك الاختيار، فذلك يغيّر كم سنحطّم منك

230
00:15:29,400 --> 00:15:33,740
ستتركين شخصاً نوى أذيّة
إيلغ-ساما يعيش؟

231
00:15:35,240 --> 00:15:37,000
خطر لي أن أسأل فحسب

232
00:15:38,490 --> 00:15:42,540
نادراً ما يعترف السجناء ما لم
نعطهم أملاً بتركهم يعيشون

233
00:15:43,100 --> 00:15:47,050
لا بأس، سأفترض أنّك تريد منّا
أن نقتله سريعاً

234
00:16:00,230 --> 00:16:01,390
أين أنا؟

235
00:16:06,000 --> 00:16:08,320
يا أفضل مغنٍّ حرّ

236
00:16:08,320 --> 00:16:10,610
استدعيتُ روحك إلى هنا
بعد موتك

237
00:16:10,610 --> 00:16:12,900
ماذا تريدين منّي؟

238
00:16:12,900 --> 00:16:15,590
كلمات أغانيك القاتلة ذائعة الصيت

239
00:16:15,590 --> 00:16:17,960
كلّ من قاتلتَه، كان انتحاره أكيد

240
00:16:17,960 --> 00:16:20,360
،كلمات أغانيّ هي الأقوى، كارثةٌ كبرى

241
00:16:20,360 --> 00:16:22,750
كلماتي سلاحٌ منيع

242
00:16:22,750 --> 00:16:25,470
عندما أقمع مشاعري، يمسي كلّ نصرٍ لي يسير

243
00:16:25,470 --> 00:16:27,640
يمكن أن يقتل سجعك البطل

244
00:16:27,640 --> 00:16:30,550
سيُعاد تجسّدك في عالمٍ آخر للقضاء عليه

245
00:16:33,810 --> 00:16:39,830
حسناً، أُعيد تجسّد رقم 423
قبل 30 عاماً، كيف تقدّمه؟

246
00:16:40,470 --> 00:16:42,990
ما الذي قلتَه لتوّك؟

247
00:16:42,990 --> 00:16:44,940
لا شيء، آسف

248
00:16:44,940 --> 00:16:48,410
ماذا؟ سنمزّقك إرباً إذا
!واصلت التظاهر بالحماقة

249
00:16:50,190 --> 00:16:54,020
لعلّه يسيء للناس لا أكثر
في هذا العصر

250
00:16:57,440 --> 00:16:59,350
هذا غداؤك يا إيلغ-ساما

251
00:16:59,350 --> 00:17:00,240
شكراً لك

252
00:17:01,410 --> 00:17:04,080
تارت وماها، ألديكما مخططات
في يوم عطلتكما؟

253
00:17:04,360 --> 00:17:06,440
سأذهب للتسوّق مع ماها-تشان

254
00:17:06,440 --> 00:17:07,710
استمتعا

255
00:17:07,710 --> 00:17:08,590
سنفعل

256
00:17:08,590 --> 00:17:11,870
سأتأخّر الليلة، أراكما لاحقاً

257
00:17:18,440 --> 00:17:19,970
رحل

258
00:17:19,970 --> 00:17:23,360
أشعر بالوحدة هذا اليوم كلّ شهر

259
00:17:23,360 --> 00:17:25,900
أنا خادمته

260
00:17:25,900 --> 00:17:28,190
وأنا أخته

261
00:17:34,990 --> 00:17:37,960
هل ننعم على أنفسنا بوجبةٍ خاصّة؟

262
00:17:37,960 --> 00:17:39,620
أجل، لننعم عليها كليّاً

263
00:17:50,380 --> 00:17:52,710
تسرّني رؤيتك مجدّداً يا لوغ

264
00:17:52,710 --> 00:17:54,460
لم أرك منذ الشهر الماضي يا ديا

265
00:17:54,690 --> 00:17:57,680
جلبتُ لك حلويات من الجانب الآخر للمحيط

266
00:17:57,680 --> 00:18:01,400
حقّاً؟ حصلتُ على شاي أعشاب لذيذ بدوري

267
00:18:01,400 --> 00:18:02,640
فلتدخل

268
00:18:02,640 --> 00:18:03,480
حسناً

269
00:18:10,360 --> 00:18:12,320
هذه تعويذات هذا الشهر

270
00:18:12,870 --> 00:18:14,390
أليست مثيرة؟

271
00:18:14,390 --> 00:18:16,400
يُبهرني صنعك كلّ هذا

272
00:18:16,830 --> 00:18:17,650
ما هذا؟

273
00:18:17,650 --> 00:18:18,960
أنهيتِها؟

274
00:18:18,960 --> 00:18:20,320
تفاجأت؟

275
00:18:20,320 --> 00:18:21,780
سأدوّنها فوراً

276
00:18:23,170 --> 00:18:26,330
حسنٌ، يُفترض أن تتمكّني
من إلقاء هذه التعويذة الآن

277
00:18:26,690 --> 00:18:29,530
حسناً، ها أنا ذي

278
00:18:29,530 --> 00:18:31,090
عكس الجاذبيّة

279
00:18:35,670 --> 00:18:37,970
تعويذة عكس جاذبيّة

280
00:18:37,970 --> 00:18:40,890
غلبتِني، لا أصدّق أنكِ سبقتِني لها

281
00:18:40,890 --> 00:18:42,860
نظرتُ للأمر من زاوية مختلفة

282
00:18:42,860 --> 00:18:45,100
هل زاد تقديرك لأختك الكبيرة قليلاً؟

283
00:18:45,100 --> 00:18:47,130
كنتُ أقدّرك سلفاً

284
00:18:49,230 --> 00:18:51,060
أهذه الهديّة التي جلبتها معك؟

285
00:18:51,060 --> 00:18:51,810
أجل

286
00:18:51,810 --> 00:18:56,030
لا تبدو الحلويات السوداء
جذّابةً بالتحديد

287
00:18:59,800 --> 00:19:02,240
!طعمها حلوٌ مرّ، وغنّية ولذيذة

288
00:19:02,530 --> 00:19:05,840
كنتُ أفكّر ببيع الحلويات
تحت علامة أورنا أيضاً

289
00:19:05,840 --> 00:19:08,180
فكرةٌ حسنة، تلائم الشاي

290
00:19:08,180 --> 00:19:10,580
وقد تكون كعكةً رائعةً أيضاً

291
00:19:10,580 --> 00:19:13,250
فهمت، سأجلب المزيد الشهر القادم

292
00:19:13,250 --> 00:19:15,440
حسناً، أتطلّع لذلك

293
00:20:02,640 --> 00:20:05,050
حان وقت الوداع بالفعل

294
00:20:05,360 --> 00:20:07,850
آسف، سأرجع الشهر القادم

295
00:20:48,280 --> 00:20:51,770
صباح الخير

296
00:20:51,770 --> 00:20:53,520
نمتَ سريعاً

297
00:20:53,790 --> 00:20:57,480
أجل، استهلكتُ الكثير من المانا

298
00:20:59,790 --> 00:21:01,320
أتشمّين رائحةً غريبة؟

299
00:21:02,520 --> 00:21:04,740
بالفعل، ما ذلك؟

300
00:21:05,450 --> 00:21:06,510
ماذا؟

301
00:21:09,600 --> 00:21:11,380
أهي من تحت اللحاف؟

302
00:21:12,500 --> 00:21:13,120
!انتظرا

303
00:21:14,860 --> 00:21:18,630
هذه ظاهرةٌ طبيعيّة يمرّ
بها المراهقون الذكور

304
00:21:18,930 --> 00:21:20,270
يصبح الجهاز العصبي اللاودي

305
00:21:20,270 --> 00:21:22,600
مهيمناً أثناء النوم، مما يضعف المقاومة

306
00:21:22,600 --> 00:21:25,430
من السهل دخول هذه الحالة
للإثارة اللا واعية

307
00:21:25,430 --> 00:21:27,750
التي تسبّبها الأحلام والاستثارة العرضيّة
مقارنةً بوضع الاستيقاظ

308
00:21:27,750 --> 00:21:29,930
...لذا ليس الأمر كما تعتقدانه، بل

309
00:21:29,780 --> 00:21:30,760
!إيلغ-ساما

310
00:21:31,080 --> 00:21:31,870
أجل؟

311
00:21:31,870 --> 00:21:34,370
دعني أهتمّ بهذا من الآن فصاعداً رجاءً

312
00:21:35,270 --> 00:21:38,980
أنا خادمتك الشخصيّة، يمكنني مساعدتك
من تلك الناحية أيضاً

313
00:21:38,980 --> 00:21:40,320
أخي إيلغ

314
00:21:40,320 --> 00:21:40,980
أجل؟

315
00:21:40,980 --> 00:21:44,390
تناديني أختك، لكنّ جسدك صريح

316
00:21:44,390 --> 00:21:45,030
ماذا؟

317
00:21:45,030 --> 00:21:49,850
أظنّ أحياناً أنّ بإمكاني أن أكون
أختك كما حبيبتك

318
00:21:49,850 --> 00:21:51,200
بدل الاختيار بينهما

319
00:21:51,200 --> 00:21:53,320
من الضروريّ أن أهتمّ بك
من تلك الناحية

320
00:21:53,320 --> 00:21:55,410
أرى أنّ لا داعي
لتفكّر عميقاً بالأمر

321
00:21:55,720 --> 00:21:57,470
لا يصحّ بك أن تتركه يتراكم

322
00:21:57,470 --> 00:21:59,610
لا داعي لنجبر نفسينا على الاختيار

323
00:22:00,470 --> 00:22:04,290
أهذا جزءٌ من خطّتي أيضاً؟

324
00:23:36,480 --> 00:23:39,020
"الحلقة القادمة: "طقوس الاختيار