1
00:01:31,640 --> 00:01:35,630
،إذا كنتَ تظن أنك الأسرع
!حاول إذاً ونافسني

2
00:01:36,480 --> 00:01:38,430
هل تعلم؟

3
00:01:39,280 --> 00:01:42,150
!أنتَ مجرد أحمق عادي

4
00:01:48,440 --> 00:01:50,550
هل تتذكرني؟ -
نعم -

5
00:01:50,640 --> 00:01:54,790
أنا لا أنسى وجهاً أبداً -
أنا سعيد لهذا -

6
00:01:54,880 --> 00:01:57,750
الآن تذكر وجه الرجل
!الذي سيهزمك

7
00:01:57,840 --> 00:02:00,710
ألا تعلم إلى من
تتحدث؟

8
00:02:00,800 --> 00:02:04,750
لقد فزتَ فقط لأنني
!كنتُ أقود شاحنة

9
00:02:04,840 --> 00:02:07,030
!سوف أهزمك في السباق

10
00:02:10,120 --> 00:02:11,950
ما الذي تفعله؟

11
00:02:12,040 --> 00:02:15,630
آسف -
لم أتوقع منك هذا -

12
00:02:15,720 --> 00:02:18,750
ألا ترى أنه
مجرد مبتدأ

13
00:02:19,600 --> 00:02:21,590
!لا تبحث عن المشاكل

14
00:02:22,000 --> 00:02:24,150
سأنال منك

15
00:02:25,200 --> 00:02:27,150
!سحقاً

16
00:02:31,120 --> 00:02:33,550
أنصحك أن توفر
طاقتك للسباق

17
00:02:33,640 --> 00:02:36,830
،بفرض أنك ستشارك
هل تفهم؟

18
00:02:40,300 --> 00:02:44,100
!أنا عبقري
قيادة الموت الحتمي

19
00:02:52,400 --> 00:02:54,350
!غونما

20
00:03:07,320 --> 00:03:11,190
غونما، هلا
!أسرعتَ قليلاً

21
00:03:11,480 --> 00:03:13,430
!إخرس

22
00:03:27,960 --> 00:03:29,830
!سحقاً

23
00:03:34,400 --> 00:03:36,020
!غونما

24
00:03:36,160 --> 00:03:39,670
!أسرع -
!قلتُ لك إخرس -

25
00:03:43,080 --> 00:03:45,510
!حسناً، سأفعلها الآن

26
00:03:53,160 --> 00:03:55,670
!قدمي
أشعر بالألم

27
00:03:55,760 --> 00:03:57,710
!سحقاً

28
00:03:58,760 --> 00:04:01,470
!غونما
هل أنت بخير؟

29
00:04:01,560 --> 00:04:03,430
لماذا لا تسرع؟

30
00:04:04,640 --> 00:04:07,270
!هلا خرست
...إما أن تخرس

31
00:04:07,360 --> 00:04:09,990
!أو اغرب عن وجهي

32
00:04:10,080 --> 00:04:12,870
يبدو لي أنك
!منزعج حقاً

33
00:04:12,960 --> 00:04:15,110
أنا أصغر لذلك
!علي أن أتبعك

34
00:04:15,200 --> 00:04:18,740
!لن أتجرأ أبداً على التقدم عليك

35
00:04:18,960 --> 00:04:20,830
!إذا ابق حيث أنت

36
00:04:22,080 --> 00:04:24,640
لن أستطيع الاستمرار
!على هذه الحال

37
00:04:30,720 --> 00:04:33,430
لماذا يسير غونما ببطئ؟

38
00:04:33,520 --> 00:04:35,670
ربما لديه مشكلة

39
00:04:35,880 --> 00:04:39,470
لا بد أن هناك مشكلة
!بسيارته

40
00:04:39,720 --> 00:04:41,670
بقاؤه متحركاً ببطئ

41
00:04:41,760 --> 00:04:43,910
سيؤثر سلباً على المحرك

42
00:04:44,000 --> 00:04:44,950
!نعم

43
00:04:48,190 --> 00:04:49,250
!تبا

44
00:04:51,560 --> 00:04:53,430
آسف، غونما لكننا نسير

45
00:04:53,520 --> 00:04:55,900
!بسرعة 5 كلم في الساعة

46
00:04:56,000 --> 00:04:57,950
!يكفي

47
00:04:58,040 --> 00:05:00,600
!إذا لم يعجبك الأمر تقدم

48
00:05:00,800 --> 00:05:02,750
!لكن... لكنك تبكي

49
00:05:03,400 --> 00:05:05,350
....قد يكون السبب

50
00:05:05,720 --> 00:05:08,750
لقد قطعت طريقاً طويلاً
لكي أشارك في هذا السباق

51
00:05:08,840 --> 00:05:11,190
هل تفهم؟ -
!إخرس -

52
00:05:11,880 --> 00:05:15,270
الآن من سيدفع ثمن الخسائر؟

53
00:05:23,280 --> 00:05:25,840
!تبا ما العمل الآن

54
00:05:27,160 --> 00:05:29,620
!تبا
!عيناي تدمعان

55
00:05:30,000 --> 00:05:32,110
!وأشعر بحمى أيضاً

56
00:05:32,640 --> 00:05:34,990
!إسمع، غونما
...أظن أنني اكتشفت

57
00:05:35,080 --> 00:05:37,380
سبب تحركك ببطئ...

58
00:05:37,480 --> 00:05:40,630
هل تستعمل قدمك اليسرى؟ -
!اهتم بشؤونك -

59
00:05:40,720 --> 00:05:42,830
كما توقعت
غونما

60
00:05:42,920 --> 00:05:45,750
مع قدم مصابة
من المستحيل

61
00:05:45,840 --> 00:05:48,830
!تغيير الدولاب
!أنت في وضع حرج

62
00:05:49,800 --> 00:05:51,870
أعلم أن هذا ليس من شأني

63
00:05:51,960 --> 00:05:53,990
لكن من الأفضل أن تتوقف

64
00:05:54,080 --> 00:05:57,750
لكي نستطيع معالجتك
غونما، انتظر

65
00:06:01,400 --> 00:06:03,270
!أوه

66
00:06:06,280 --> 00:06:08,150
!غونما

67
00:06:08,280 --> 00:06:10,230
عليك أن تتوقف

68
00:06:10,320 --> 00:06:12,350
!قد تزداد حالة قدمك

69
00:06:12,440 --> 00:06:15,590
!توقف عن إزعاجي

70
00:06:16,000 --> 00:06:20,430
تباً... علي أن أفكر
!في حل

71
00:06:20,680 --> 00:06:22,350
ماذا؟

72
00:06:26,400 --> 00:06:28,350
!هل جننت

73
00:06:32,920 --> 00:06:36,430
!أنا الأسرع
!لا أحد في العالم سيهزمني

74
00:06:40,720 --> 00:06:42,590
ماذا يفعل؟

75
00:06:42,720 --> 00:06:46,550
!يمكنني فعلها باليمنى
!لنرى ماذا يمكنني أن أفعل

76
00:06:58,480 --> 00:07:00,670
!رائع
!سترون

77
00:07:06,200 --> 00:07:10,510
!لا أصدق عيني
!إنه محظوظ

78
00:07:16,800 --> 00:07:19,260
!حسناً، سترون

79
00:07:20,640 --> 00:07:22,510
!ابتعدوا عن طريقي

80
00:07:23,240 --> 00:07:26,750
!أنا الأسرع
!أنا الأسرع في هذا السباق

81
00:07:40,960 --> 00:07:43,260
!سأريكم من أنا

82
00:07:51,200 --> 00:07:54,740
يبدو أن المبتدأ
!بدأ يتشجع

83
00:07:55,360 --> 00:07:57,950
حسناً، الآن
!سأنال منك

84
00:08:12,120 --> 00:08:13,950
!تبا

85
00:08:15,750 --> 00:08:16,990
!أوه لا

86
00:08:26,480 --> 00:08:29,230
!إنه قادم، تاموتسو
غونما

87
00:08:29,440 --> 00:08:32,270
!غونما، توقف

88
00:08:38,920 --> 00:08:42,190
هل رأيتم هذا؟ -
!رأيته -

89
00:08:42,480 --> 00:08:44,860
هل أنا مخطئة أم أنه
يقود بساق واحدة؟

90
00:08:45,120 --> 00:08:46,990
بدا كذلك

91
00:08:55,800 --> 00:08:58,230
!هذا جنون
فيما يفكر؟

92
00:08:59,280 --> 00:09:01,430
لم أرى قيادةً كهذه من قبل

93
00:09:02,200 --> 00:09:04,950
!إنه لا يستهان به
!من يهتم

94
00:09:05,080 --> 00:09:08,350
،لنرى ما هو قادر عليه
إنه مجرد ولد صغير

95
00:09:25,320 --> 00:09:29,020
أهو ثمل؟
فيما يفكر؟

96
00:09:34,560 --> 00:09:36,590
!إنه يقود كالمجنون

97
00:10:01,600 --> 00:10:03,550
!سمباي، مذهل

98
00:10:13,480 --> 00:10:15,310
!تبا
كيف يمكنه المرور

99
00:10:15,400 --> 00:10:17,430
بالمنعطفات هكذا؟

100
00:10:20,880 --> 00:10:22,830
!أنا قادم

101
00:10:35,080 --> 00:10:37,830
!ذلك المجنون قادم
!إنه خلف سوناي

102
00:11:02,000 --> 00:11:05,540
!لن تنجح -
!سنرى -

103
00:11:10,360 --> 00:11:13,590
تبا -
سحقا -

104
00:11:16,000 --> 00:11:18,430
إذا أردت نصيحتي إذهب إلى

105
00:11:18,520 --> 00:11:20,900
!الحضانة فلا مكان لك هنا

106
00:11:23,480 --> 00:11:26,190
!لقد جنيتَ على نفسك

107
00:11:27,120 --> 00:11:29,470
!لدي شعور سيئ

108
00:11:30,720 --> 00:11:33,550
!سوف يتأذيان

109
00:11:33,720 --> 00:11:36,510
ما العمل؟ -
تعلمين أن غونما -

110
00:11:36,600 --> 00:11:38,670
!يشتعل غضبه في مثل هذه الحالة

111
00:11:39,320 --> 00:11:42,190
علينا فعل شيء
!قبل فوات الأوان

112
00:11:42,600 --> 00:11:46,030
عندما يغضب يمكن
!أن يفعل أي شيء

113
00:11:51,080 --> 00:11:53,510
!أنا رجل محترم

114
00:11:53,640 --> 00:11:55,910
!أكثر رجل مهذب في السباق

115
00:12:02,640 --> 00:12:04,350
!خذ هذه

116
00:12:06,120 --> 00:12:09,350
ما رأيك؟
!هل كنتُ مهذباً بما يكفي؟

117
00:12:26,320 --> 00:12:29,350
ماذا تعني؟ -
...أرجو أن أكون مخطئاً -

118
00:12:29,720 --> 00:12:33,590
في كل هذا

119
00:12:33,920 --> 00:12:35,870
!لكنني أشك في ذلك

120
00:12:45,400 --> 00:12:48,870
!لا أستطيع تحمل هذا
!كيف يجرؤ على إهانتي هكذا

121
00:12:49,120 --> 00:12:53,270
علي التحرك على أي حال

122
00:12:57,320 --> 00:13:00,030
!لن أستسلم بهذه السهولة

123
00:13:00,160 --> 00:13:02,350
!لن تتجاوزني أبداً

124
00:13:18,320 --> 00:13:22,350
!لن تفلت بفعلتك
سترى

125
00:13:23,480 --> 00:13:25,910
!لا أهتم بصراحة

126
00:13:26,000 --> 00:13:28,510
!هيا! هيا! هيا
!خصمي هو هيجيري

127
00:13:41,240 --> 00:13:43,510
!الآن أنا وأنت فقط، هيجيري

128
00:13:46,200 --> 00:13:49,270
لقد تمكن أخيراً من
تجاوز سوناي

129
00:13:49,600 --> 00:13:52,550
رغم أنه متأخر بثلاث لفات

130
00:13:52,640 --> 00:13:54,590
...لكن في هذه اللفة

131
00:13:54,680 --> 00:13:57,750
!كان أسرع من سوناي -
لكنه في مشكلة -

132
00:13:58,200 --> 00:14:01,900
رغم أن غونما متقدم إلا أنه
!ما تزال لديه لفات يجب أن يقوم بها

133
00:14:02,000 --> 00:14:04,460
وقد لا يبقى لديه الوقت الكافي

134
00:14:04,600 --> 00:14:06,670
وقد ينفذ وقوده

135
00:14:08,680 --> 00:14:12,270
إذا استمر هذا فقد
يحتاج إلى تبديل

136
00:14:13,480 --> 00:14:16,270
!تماسك، غونما
!يمكنك فعلها

137
00:14:19,400 --> 00:14:21,910
!تبا
!منعطف غبي آخر

138
00:14:24,680 --> 00:14:27,030
لا أستطيع البقاء
على الطريق

139
00:14:27,280 --> 00:14:30,510
والأمر أصعب وأنا
!أستعمل ساقاً واحدة

140
00:14:33,600 --> 00:14:36,510
علي أن أخفف السرعة
!وإلا سأتحطم

141
00:14:38,300 --> 00:14:43,190
لكن لا يمكنني الإبطاء لأن
!سوناي سيتجاوزني

142
00:14:43,800 --> 00:14:45,670
!سأنال منك هذه المرة

143
00:14:46,480 --> 00:14:48,350
!حسناً

144
00:14:51,600 --> 00:14:55,550
هاي، سوناي! تفضل هذه
!هدية أخرى! خذ

145
00:14:59,800 --> 00:15:03,110
!رائع! لقدخدعته
!وداعاً

146
00:15:06,000 --> 00:15:07,950
!تبا

147
00:15:12,880 --> 00:15:14,750
!إيه؟ إنه غونما

148
00:15:15,480 --> 00:15:19,100
!هاي، كيشيدا
كيف الأمور معك؟

149
00:15:20,600 --> 00:15:23,590
!انتظر
!كيف تجرؤ على خداعي

150
00:15:25,000 --> 00:15:27,150
!غونما أكاغي شخص استثنائي

151
00:15:27,320 --> 00:15:29,550
رغم أنه في وضع صعب

152
00:15:29,640 --> 00:15:31,670
!إلا أنه تمكن من تجاوز سوناي

153
00:15:39,240 --> 00:15:41,270
أوه، أخيراً

154
00:15:41,560 --> 00:15:44,550
هاي، ماذا حدث؟
هل وقع لك حادث؟

155
00:15:44,880 --> 00:15:47,950
!جيد أنك بخير
!كنت قلقاً

156
00:15:48,080 --> 00:15:50,870
!سأنزع لك الخوذة -
!أنا بخير -

157
00:15:50,960 --> 00:15:53,790
!غونما لديه مشكل -
ماذا قلت؟ -

158
00:15:53,880 --> 00:15:55,910
!لم ألاحظ
ماذا حدث له؟

159
00:15:56,000 --> 00:15:58,190
على ما يبدو لا يستطيع
!استعمال قدمه اليسرى

160
00:15:58,280 --> 00:16:01,550
حقاً؟ -
إنه يقود بقدمه اليمنى -

161
00:16:01,640 --> 00:16:04,350
لهذا كان يجد صعوبة في
!المنحنيات

162
00:16:04,600 --> 00:16:07,190
لكن رغم كل شيء تمكن
!من تجاوز سوناي

163
00:16:07,400 --> 00:16:10,910
لديه حقا شخصية
!البطل

164
00:16:12,240 --> 00:16:15,150
لكن لدي شعوراً سيئاً

165
00:16:16,120 --> 00:16:18,680
!غونما، لا تتهور

166
00:16:19,320 --> 00:16:20,950
!ها هو

167
00:16:25,320 --> 00:16:27,270
أين أنت، هيجيري؟

168
00:16:27,920 --> 00:16:29,750
غونما
!تذكر أنك رجل محترم

169
00:16:29,880 --> 00:16:31,550
!يهو

170
00:16:35,320 --> 00:16:38,150
لقد بدأ يقترب

171
00:16:39,240 --> 00:16:42,670
إذا استمر هذا
سيصل إلي

172
00:16:44,280 --> 00:16:47,430
لا بد أن لديه محركاً
!وميكانيكيا عظيماً

173
00:16:52,880 --> 00:16:56,070
،يجب أن يعمل لدي
!سأتصل به عاجلاً أو آجلاً

174
00:17:02,960 --> 00:17:05,870
،إنتظر فقط يا ولد
السباق بدأ للتو

175
00:17:06,640 --> 00:17:10,590
نلت منك!  نحن نقترب
!من المنعطف

176
00:17:10,680 --> 00:17:12,910
!رائع
!سأريك

177
00:17:31,720 --> 00:17:34,350
!هذه هي -
!لا فرصة لديه -

178
00:17:38,160 --> 00:17:39,750
!حسناً

179
00:17:42,400 --> 00:17:44,270
!هيا

180
00:17:49,880 --> 00:17:51,750
!هذه هي

181
00:18:03,480 --> 00:18:06,670
أنا الأسرع! لا أحد في
!العالم يمكنه تجاوزي

182
00:18:07,080 --> 00:18:10,510
!رائع
!ذلك المحرك مثالي

183
00:18:14,400 --> 00:18:16,270
ماذا يفعل؟ سوناي؟

184
00:18:31,240 --> 00:18:33,700
!أيها الغبي
!إبتعد عن الطريق

185
00:18:33,800 --> 00:18:36,260
!حان وقتُ رد الدَّين

186
00:18:38,600 --> 00:18:40,270
!خذ هذه

187
00:18:44,640 --> 00:18:46,590
!وداعاً

188
00:19:04,080 --> 00:19:07,950
!تبا
!ليس بعد

189
00:19:15,800 --> 00:19:18,030
هاي ولد، ما الذي تفعله؟

190
00:19:35,960 --> 00:19:37,020
!لا

191
00:19:38,680 --> 00:19:40,550
ماذا تفعل؟

192
00:19:41,200 --> 00:19:44,550
!أليس هذا بديهياً -
!لا تكن أحمقاً -

193
00:20:11,880 --> 00:20:13,750
!غونما -
!سمباي -

194
00:20:13,840 --> 00:20:15,670
!أيها الوغد

195
00:20:15,760 --> 00:20:18,190
لم أفعل شيئاً
!غير رد الدَّين

196
00:20:19,080 --> 00:20:21,110
!توقف، غونما -
أيها الوغد -

197
00:20:21,200 --> 00:20:24,350
!أنت من بدأ -
!ماذا؟ أنت من أثارني -

198
00:20:24,440 --> 00:20:27,190
لقد دفعتني إلى
!حافة الطريق

199
00:20:27,280 --> 00:20:30,510
وأنت من بدأ برمي
!الأحذية

200
00:20:30,600 --> 00:20:33,310
!أنت لا تفهم
!ذلك كان دفاعاً عن النفس

201
00:20:33,400 --> 00:20:35,750
!إهدأ، غونما -
!إبتعد عني -

202
00:20:35,840 --> 00:20:37,790
علي أن ألقنك درساً

203
00:20:37,880 --> 00:20:39,870
...إنتظر -
!هذا يكفي -

204
00:20:39,960 --> 00:20:41,830
!لم ينتهي الأمر بعد

205
00:20:41,920 --> 00:20:44,510
سوف ألقنك
!درساً

