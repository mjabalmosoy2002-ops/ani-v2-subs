1
00:01:55,400 --> 00:01:58,630
!سيـ... سيارتي

2
00:02:00,000 --> 00:02:05,000
،سحب رخصة غونما
!لا يمكنه القيادة

3
00:02:19,040 --> 00:02:21,230
!سمباي
!حظا موفقاً

4
00:02:21,600 --> 00:02:23,470
لا يمكنكم منعي
!من رؤيته

5
00:02:23,560 --> 00:02:26,550
!أتركوني
!دعوني

6
00:02:27,800 --> 00:02:30,070
!مجنون -
ماذا تريد؟ -

7
00:02:30,070 --> 00:02:31,070
!ابتعدوا عن طريقي

8
00:02:35,280 --> 00:02:37,150
ما معنى هذا؟

9
00:02:44,200 --> 00:02:47,900
،مرشح الانتخابات
...تاكاو ساتوشي

10
00:02:48,000 --> 00:02:50,670
!ها هم يبدؤون مجدداً -
يريد تحية ناخبيه... -

11
00:02:50,760 --> 00:02:53,430
ويشكركم مسبقاً
!على تصويتكم

12
00:02:55,280 --> 00:02:58,270
!هاي، يا جدة
!أتمنى لكِ حياةً طويلةً وسعيدة

13
00:02:58,880 --> 00:03:00,750
لِمَ لا تهتمون
بشؤونكم؟

14
00:03:00,840 --> 00:03:03,430
!يا جدة
شكراً لكِ مسبقاً على تصويتك

15
00:03:03,600 --> 00:03:05,750
لن أصوت
!على مرشحكم

16
00:03:09,400 --> 00:03:11,350
،إذا لم أكن مخطئة
والد غونما مرشحٌ

17
00:03:11,440 --> 00:03:14,150
!أيضاً في هذه الانتخابات

18
00:03:14,800 --> 00:03:17,260
!أوه
!تاموتسو

19
00:03:19,480 --> 00:03:22,150
لم أرك منذ
مدة، يا جدة

20
00:03:31,200 --> 00:03:33,470
هل أنت المسؤول هنا؟

21
00:03:33,720 --> 00:03:36,150
!ستأتي معنا -
!ابتعدوا -

22
00:03:37,280 --> 00:03:39,580
أخبرني من أنت
وماذا تريد؟

23
00:03:39,680 --> 00:03:42,550
إسمي أكاغي غونما
وأنا سائق فورمولا 3

24
00:03:42,640 --> 00:03:45,070
لماذا لستَ مهتماً بأن
تكون راعياً لي؟

25
00:03:45,400 --> 00:03:47,000
راعي؟

26
00:03:47,000 --> 00:03:49,430
!أنت رئيس شركةٍ مشهورة

27
00:03:49,520 --> 00:03:51,430
!يمكنك أن ترعاني بسهولة

28
00:03:51,560 --> 00:03:54,510
بمساعدتك سأتمكن من الوصول
إلى فورمولا 1 بسهولة

29
00:03:54,880 --> 00:03:57,150
ماذا!؟ فورمولا 1؟ -
حقاً؟ -

30
00:03:57,280 --> 00:03:59,110
لا بد أنه يحلم

31
00:03:59,200 --> 00:04:01,230
لماذا تضحكون؟
!أنا أقول الحقيقة

32
00:04:01,320 --> 00:04:03,470
أؤكد لكم أنني
سائقٌ ممتاز

33
00:04:03,560 --> 00:04:05,750
!لا يوجد سائقٌ مثلي

34
00:04:05,840 --> 00:04:08,670
لسنا متأكدين من قدراتك

35
00:04:08,800 --> 00:04:11,590
لكنني أعرف شخصياً الكثير
من السائقين العظماء

36
00:04:11,680 --> 00:04:14,630
إذا كنتَ جيداً حقاً فلماذا لم تربح
؟F1 بطولة

37
00:04:14,720 --> 00:04:18,340
ألا يبدو هذا غريباً؟ -
نعم، هذا غريب -

38
00:04:20,400 --> 00:04:23,070
أنا أقدر شغفك
وأتمنى لك النجاح

39
00:04:23,200 --> 00:04:26,870
لكن شركتنا لا يمكنها
أن ترعى غريباً

40
00:04:27,480 --> 00:04:30,550
أنا آسف، لكن إبحث
عن عقدٍ في مكانٍ آخر

41
00:04:36,000 --> 00:04:39,510
فهمت! ستعود إلى
!هيجيري قريباً

42
00:04:39,720 --> 00:04:42,020
!نعم
!لدي الكثير من العمل

43
00:04:42,480 --> 00:04:44,860
لكن يمكنك دائماً
العيش معنا

44
00:04:45,040 --> 00:04:47,270
لا، لقد حجزت سلفاً
غرفةً في فندق

45
00:04:47,360 --> 00:04:49,230
فندق؟

46
00:04:50,720 --> 00:04:54,150
هيجيري قال أن الفندق
هو الحل الأنسب لي

47
00:04:56,640 --> 00:04:58,990
بالمناسبة، كيف حال غونما؟

48
00:04:59,080 --> 00:05:01,310
إنه يبحث يائساً
!عن راعٍ

49
00:05:01,400 --> 00:05:03,910
لقد تمكن من الدخول
...إلى فورمولا 3 ولكن

50
00:05:04,040 --> 00:05:07,740
.قد سمعت بما حدث... -
نعم -

51
00:05:08,960 --> 00:05:11,750
،كدت أن أنسى
هذه وصلت لك الأمس

52
00:05:11,840 --> 00:05:13,750
!تبدو مهمة -
شكراً لك -

53
00:05:21,480 --> 00:05:23,750
ما تلك الوثيقة؟

54
00:05:23,960 --> 00:05:26,550
!للحصول على جواز سفر -
جواز سفر؟ -

55
00:05:26,680 --> 00:05:30,150
إذاً سوف ترافق هيجيري
في أسفاره؟

56
00:05:30,240 --> 00:05:32,110
!أنا أحسدك

57
00:05:32,200 --> 00:05:34,630
!أتمنى لو أستطيع السفر خارج البلاد

58
00:05:34,720 --> 00:05:37,070
أليس الوقت متأخراً؟ -
ماذا تقصد؟ -

59
00:05:38,360 --> 00:05:40,310
...أوه، حسناً

60
00:05:44,000 --> 00:05:46,430
!تباً
لماذا يرفضون جميعاً؟

61
00:05:46,520 --> 00:05:48,510
!إنهم جميعاً زمرةٌ من الحمقى

62
00:05:49,760 --> 00:05:52,550
!لكن لم يبقى إلا أسبوع واحد
!الأمر ميؤوسٌ منه

63
00:05:53,000 --> 00:05:55,460
هاي، سمباي. لننسى
...أمر الراعي

64
00:05:55,560 --> 00:05:57,590
!ولنبحث عن سيارة عوضاً عن ذلك...

65
00:05:57,680 --> 00:06:01,150
غبي! لا مال لدينا ولا أحد
!سيعطينا سيارة مجاناً

66
00:06:01,240 --> 00:06:03,310
على أي حال، للتنافس
في سباق

67
00:06:03,400 --> 00:06:05,430
!تحتاج الكثير من المال -
!مرحباً -

68
00:06:05,520 --> 00:06:07,630
تاموتسو كان هنا اليوم

69
00:06:07,720 --> 00:06:09,590
تاموتسو؟

70
00:06:10,000 --> 00:06:12,750
كانت لديه الجرأة
ليظهر هنا

71
00:06:19,200 --> 00:06:21,390
ذلك الولد الذي سبب بعض الفوضى

72
00:06:21,480 --> 00:06:23,940
إنه سائق فورمولا 3 وهو ينتمي

73
00:06:24,040 --> 00:06:25,990
إلى اتحادكم... -
حقاً؟ -

74
00:06:26,360 --> 00:06:29,030
نعم! شاهدت بالصدفة
ما حدث

75
00:06:29,120 --> 00:06:32,070
،وأرسلتُ بعض الصور -
لماذا تفعل هذا؟ -

76
00:06:32,200 --> 00:06:34,830
أنا مساندٌ معارض
!للعنف في الرياضة

77
00:06:35,600 --> 00:06:37,790
لا يمكن أن نتصور سائقاً مثله

78
00:06:37,880 --> 00:06:39,830
!يتورط مع الشرطة

79
00:06:39,960 --> 00:06:43,550
،يجب أن تعاقبوه
قبل أن يخرج عن السيطرة

80
00:06:44,200 --> 00:06:46,990
كل ما أطلبه منك هو اتخاذ إجراء

81
00:06:47,080 --> 00:06:48,950
!لحماية مساندينا

82
00:06:49,040 --> 00:06:52,230
وإلا سأكون مجبراً على
!اللجوء إلى وسائل أخرى

83
00:06:53,080 --> 00:06:55,540
وسائل أخرى؟
ماذا تعني؟

84
00:06:55,880 --> 00:06:58,340
،إذا لم تفعلوا
سيصبح الأمر شخصياً

85
00:07:09,880 --> 00:07:12,230
أوروبا؟ -
إيه؟ -

86
00:07:12,880 --> 00:07:14,350
نعم

87
00:07:14,480 --> 00:07:17,070
سيذهب خارج البلاد
لطلب سيارةٍ جديدة

88
00:07:17,600 --> 00:07:19,470
سيارة جديدة؟

89
00:07:20,640 --> 00:07:22,870
تاموتسو قال أن ذلك ضروري

90
00:07:23,040 --> 00:07:25,600
لأنه إذا تمكن هيجيري من
الفوز في هذه البطولة

91
00:07:25,680 --> 00:07:28,670
فسيذهب العام القادم خارج البلاد -
ماذا؟ -

92
00:07:29,200 --> 00:07:31,310
...هذا يعني أن السباق القادم

93
00:07:31,400 --> 00:07:33,350
!سيكون الأخير له في اليابان

94
00:07:34,480 --> 00:07:36,430
!هذا هراء

95
00:07:36,600 --> 00:07:40,030
لا يجب أن يغير الفئة
...قبلي

96
00:07:40,120 --> 00:07:42,030
!F3 لا يمكن أن أُترك مهزوما في

97
00:07:42,120 --> 00:07:44,390
!لا أحد يمكن أن يهزمني

98
00:07:44,480 --> 00:07:48,150
!سمباي -
!تباً -

99
00:07:49,680 --> 00:07:51,550
!إنتظر

100
00:07:53,120 --> 00:07:56,820
سيارة جديدة؟ -
!يجب أن أشارك في ذلك السباق -

101
00:07:57,200 --> 00:07:59,150
!يجب أن ألحق بهيجيري

102
00:07:59,240 --> 00:08:01,070
!لا يمكنني البقاء مكتوف اليدين

103
00:08:01,160 --> 00:08:03,110
!أنت فقط من تستطيع مساعدتي

104
00:08:03,720 --> 00:08:05,750
بالطبع يمكنني مساعدتك

105
00:08:05,840 --> 00:08:08,030
لكن إذا علموا أنه
أنت ستتم إزالتك

106
00:08:08,120 --> 00:08:11,230
ولماذا؟
ألست سائقاً جيداً؟

107
00:08:11,360 --> 00:08:13,590
!لن أترك الأمر ينتهي هكذا

108
00:08:14,640 --> 00:08:16,750
كل السيارات التي تتنافس
...في فورمولا 3

109
00:08:16,840 --> 00:08:18,830
تحتاج مساعدة راعٍ...

110
00:08:19,080 --> 00:08:21,950
وشخصيتك تجعل الأمر صعباً

111
00:08:22,280 --> 00:08:24,230
!لذا من الأفضل أن تنسى الأمر

112
00:08:24,320 --> 00:08:26,350
بالإضافة إلى أن الأمر يتطلب
!الكثير من المال

113
00:08:26,440 --> 00:08:28,390
!سأتدبر أمر المال بطريقةٍ ما

114
00:08:28,480 --> 00:08:31,590
عليك فقط أن ترشدني إلى شخص
!يمكنه توفير سيارةٍ لي

115
00:08:31,680 --> 00:08:33,950
!سمباي سائقٌ رائع

116
00:08:34,040 --> 00:08:35,990
!أظن أنه الأفضل

117
00:08:38,200 --> 00:08:40,070
!يجب أن نفعل شيئاً من أجله

118
00:08:40,160 --> 00:08:42,620
!أنا مستعد لتقديم كل ما أوفره

119
00:08:42,720 --> 00:08:44,910
حسناً، ما رأيك؟

120
00:08:47,280 --> 00:08:50,590
!طيب! لا أحتاجك على أي حال
!سنتدبر الأمر وحدنا

121
00:08:50,680 --> 00:08:53,350
!هيا، سنريه -
!نعم -

122
00:08:54,400 --> 00:08:56,350
إنتظر

123
00:08:56,600 --> 00:08:58,830
أعرف رجلاً قد يساعدك

124
00:09:00,200 --> 00:09:03,150
.إسمه إيجيرو -
إيجيرو!؟ -

125
00:09:03,240 --> 00:09:06,070
،في آخر مرة رأيته فيها
كان يعيش خارج المدينة

126
00:09:06,400 --> 00:09:09,230
سمعتُ أنه لديه سيارة ليبيعها

127
00:09:09,320 --> 00:09:12,350
!لكن كن حذراً

128
00:09:12,960 --> 00:09:14,990
إنه ليس من النوع الودود

129
00:09:16,280 --> 00:09:18,350
لقد استطعتُ تحملك أنت حتى

130
00:09:18,440 --> 00:09:21,070
لذا قد أستطيع
!إثارة إعجابه أيضاً

131
00:09:26,880 --> 00:09:28,750
!هاي، هات الشراب

132
00:09:31,080 --> 00:09:33,030
!هيا بسرعة! الشراب

133
00:09:42,560 --> 00:09:44,430
!مرحباً

134
00:09:44,680 --> 00:09:46,630
!آه، أنتم أصدقاؤه

135
00:09:47,960 --> 00:09:50,070
،مساء الخير
!لا بد أنك إيجيرو

136
00:09:50,400 --> 00:09:52,350
إسمي أكاغي غونما

137
00:09:52,480 --> 00:09:54,590
أخبرني كوروي عنك

138
00:09:54,880 --> 00:09:56,990
هل تنوي بيع سيارتك؟

139
00:09:57,080 --> 00:09:59,070
!سنشتريها منك طبعاً

140
00:09:59,280 --> 00:10:01,990
علي المشاركة في الجولة
!القادمة من البطولة

141
00:10:02,360 --> 00:10:05,430
ليست لدي أدنى فكرة
!عما تتحدث

142
00:10:05,520 --> 00:10:07,590
هاي، لا تدعي الجهل

143
00:10:07,720 --> 00:10:10,750
!لا فائدة من الادعاء
!نعلم أنك تملك سيارة

144
00:10:12,040 --> 00:10:13,990
ما رأيك؟

145
00:10:14,640 --> 00:10:16,830
هل تنوي بيع السيارة أم لا؟

146
00:10:25,400 --> 00:10:27,670
!إيه
!هذا الرجل متوحشٌ حقاً

147
00:10:27,880 --> 00:10:29,830
!أيها الشقي

148
00:10:31,920 --> 00:10:35,750
إسمع، أنا لستُ من النوع
!الذي يستسلم بسهولة

149
00:10:44,040 --> 00:10:46,030
!أنظر أمامك -
!أحمق -

150
00:10:49,720 --> 00:10:51,590
!وصلتُ أخيراً

151
00:10:59,120 --> 00:11:01,230
هل ظننتَ أن بإمكانك
التخلص مني؟

152
00:11:08,800 --> 00:11:11,230
!مرحباً -
!...أ - أيها الــ -

153
00:11:11,960 --> 00:11:15,190
السيارة تم إعدادها
سلفاً، أليس كذلك؟

154
00:11:15,280 --> 00:11:17,150
!لا تلمسها

155
00:11:30,400 --> 00:11:32,630
!لديك تحفةٌ رائعة، يا عم

156
00:11:34,760 --> 00:11:36,630
!توقف

157
00:11:48,040 --> 00:11:51,820
...غريب
!هذا الإعداد... تاموتسو

158
00:11:54,800 --> 00:11:57,360
!هذا عظيم
!رائعٌ حقاً

159
00:11:58,000 --> 00:12:00,070
!هذه تحفةٌ حقيقية

160
00:12:00,640 --> 00:12:02,910
،بهذه السيارة
!لا أحد سيهزمني

161
00:12:03,000 --> 00:12:06,070
!سمباي -
!إبتعد عنها حالاً -

162
00:12:11,720 --> 00:12:14,750
!سمباي -
لِمَ تفعل هذا؟ -

163
00:12:14,880 --> 00:12:17,710
!أخرج من هنا -
!كلا -

164
00:12:17,800 --> 00:12:20,070
الآن وقد رأيت السيارة
!لا يمكنني العودة

165
00:12:20,640 --> 00:12:22,870
أنا أريد بشدة قيادة هذه السيارة

166
00:12:22,960 --> 00:12:25,190
!يجب أن أشارك في السباق القادم

167
00:12:25,280 --> 00:12:27,840
!أتوسل إليك -
!أرجوك  -

168
00:12:28,240 --> 00:12:30,270
ألم تسمعني؟

169
00:12:30,400 --> 00:12:33,550
!أخرج من هنا
!وإلا جعلتك تندم

170
00:12:43,720 --> 00:12:45,550
!سمباي

171
00:12:45,640 --> 00:12:48,670
!أرجوك إهدأ
!لنتكلم بهدوء

172
00:12:54,120 --> 00:12:56,310
!ذهبا أخيراً

173
00:12:57,200 --> 00:12:59,150
!هذه ليست للأطفال

174
00:13:04,880 --> 00:13:08,350
لن أتخلى عن هذه السيارة
!ولو مقابل كل الذهب الذي في العالم

175
00:13:09,120 --> 00:13:11,910
،هذه السيارة صديقتي
لن تخونني أبداً

176
00:13:12,200 --> 00:13:14,430
!إنها لي وحدي

177
00:13:16,920 --> 00:13:19,430
لقد كان أكثر رجلٍ
!مجنون التقيته

178
00:13:19,520 --> 00:13:21,900
!نعم، لقد حذرتك

179
00:13:22,640 --> 00:13:24,940
!كُنتَ على حق
...على أي حال، سيارته

180
00:13:25,040 --> 00:13:26,910
تحفةٌ حقاً... -
!صحيح -

181
00:13:27,600 --> 00:13:30,510
لكن حالما صعدتُ عليها

182
00:13:30,600 --> 00:13:33,160
ذكرتني بالأيام التي
قضيتُ مع تاموتسو

183
00:13:34,560 --> 00:13:37,190
!هناك شيءٌ واحدٌ لا أفهمه

184
00:13:37,280 --> 00:13:39,910
لماذا يبقيها مخفية في منزله؟

185
00:13:40,000 --> 00:13:42,590
،من الصعب شرح هذا
لقد كان دائماً من النوع

186
00:13:42,680 --> 00:13:44,550
غير الجيد مع الناس

187
00:13:44,640 --> 00:13:47,870
إنه يعتقد  أن السيارت على خلاف
البشر لا تخونك

188
00:13:48,120 --> 00:13:49,910
!لا بد أن شخصاً ما جعله يعاني

189
00:13:50,000 --> 00:13:52,630
هذا ليس سبباً كافياً لإبقائها
!مقفولاً عليها

190
00:13:52,720 --> 00:13:55,180
سآخذ السيارة مهما كان الثمن
وأهزم هيجيري

191
00:13:55,280 --> 00:13:57,230
!...كوروي، هذا سيئ

192
00:13:57,400 --> 00:14:00,550
!آه، أكاغي
!أنت هنا أيضاً

193
00:14:00,720 --> 00:14:03,230
هيا، لِمَ لا تُخبرنا؟
أهو سيئ؟

194
00:14:03,320 --> 00:14:05,880
...حسناً... أمــ... أنا

195
00:14:05,960 --> 00:14:07,990
!ما الأمر؟ أخبرنا ماذا حدث

196
00:14:08,080 --> 00:14:10,030
...في الواقع

197
00:14:10,480 --> 00:14:13,830
...توصلتُ بهذه الرسالة توًّا

198
00:14:15,480 --> 00:14:16,280
...لنرى

199
00:14:18,640 --> 00:14:22,070
!هاي! إنها من رئيس اتحادنا

200
00:14:22,680 --> 00:14:25,470
...أتساءل ماذا يريد

201
00:14:41,720 --> 00:14:44,830
إيه، يريدون سحب رخصته!؟ -
ولأي سبب؟ -

202
00:14:45,000 --> 00:14:47,150
لم يذكروا سبباً محدداً

203
00:14:49,000 --> 00:14:51,430
كيف هو غونما؟ -
...إنه -

204
00:15:10,120 --> 00:15:12,420
كيف هو جواز سفرك الجديد؟
ألم تكن هناك مشكلة؟

205
00:15:12,520 --> 00:15:15,310
!لا! كل شيءٍ بخير -
!مرحباً، هيجيري -

206
00:15:15,400 --> 00:15:17,960
كان لطفاً منك دعوتنا
لهذه الحفلة

207
00:15:18,040 --> 00:15:20,070
!لا داعي للشكر
هذه حفلة أصدقاء

208
00:15:20,160 --> 00:15:23,430
!تحدث مرةً في الشهر فقط
!ليست بشيءٍ رسمي

209
00:15:24,120 --> 00:15:26,030
أرى أنك لا تشرب الكحول

210
00:15:26,120 --> 00:15:28,420
ألا تشرب؟
!جرب كوكتيل على الأقل

211
00:15:29,280 --> 00:15:32,750
!لا أشرب عندما أقود -
أنا مثلك -

212
00:15:32,880 --> 00:15:35,870
بالمناسبة، هل توصلت
إلى اتفاقٍ مع الإدارة؟

213
00:15:36,000 --> 00:15:39,990
أكيد! الآن علي أن أفوز
بالسباقين القادمين

214
00:15:40,120 --> 00:15:43,660
!لديك ثقةٌ كبيرة في نفسك
!حسناً! أتمنى لك حظاً موفقاً

215
00:15:46,560 --> 00:15:49,310
رئيس الاتحاد يلاحظ مساري

216
00:16:10,000 --> 00:16:13,070
هل أنت بخيرٍ حقاً؟ -
أنا بحال أفضل الآن -

217
00:16:14,560 --> 00:16:16,510
كانت نوبة خفيفة لحسن الحظ

218
00:16:16,680 --> 00:16:19,430
لو كانت أقوى لكانت نهايتي

219
00:16:29,400 --> 00:16:31,990
مقر مساندي سويتشيرو

220
00:16:32,080 --> 00:16:34,030
لقد تمكنا من جعله
يسحب الرخصة

221
00:16:34,200 --> 00:16:37,070
رجلنا في الاتحاد
أكد هذا

222
00:16:37,360 --> 00:16:40,230
،فهمت -
!وأخيراً... هذا -

223
00:16:40,680 --> 00:16:42,630
هذه نتيجة التفاوض

224
00:16:57,120 --> 00:16:59,070
ماذا؟ أكاغي غونما؟

225
00:16:59,320 --> 00:17:02,030
!إسمع! لا تدعه يدخل
!مرحباً -

226
00:17:02,120 --> 00:17:04,070
يبدو أنني وجدتك

227
00:17:09,000 --> 00:17:11,300
!أريدك أن تشرح لي

228
00:17:11,400 --> 00:17:13,960
أخبرني لماذا تسحبون رخصتي؟

229
00:17:14,520 --> 00:17:16,980
يسحبون رخصته؟

230
00:17:24,880 --> 00:17:27,990
أبي، إقبل هذا الاعتذار
على المشكل الذي سببتُه

231
00:17:28,080 --> 00:17:29,950
!هذه أموالك

232
00:17:30,040 --> 00:17:32,500
إذاً تم حل الأمر كلياً؟

233
00:17:32,600 --> 00:17:35,750
أجل! وتم التعامل
!مع أمر غونما كذلك

234
00:17:36,400 --> 00:17:39,670
!جيد -
وماذا عن يوكي؟ -

235
00:17:40,480 --> 00:17:42,430
لقد رأيتُ كيف
كُنتَ تُعاملها

236
00:17:42,520 --> 00:17:44,820
لو كنتُ مكانك لما
فكرتُ بالمغادرة

237
00:17:46,120 --> 00:17:48,070
سأهتم بها

238
00:17:57,600 --> 00:17:59,590
من صور هذه؟ -
لا أدري -

239
00:17:59,720 --> 00:18:01,710
كان علي أن أتصرف

240
00:18:01,800 --> 00:18:05,070
!لكن هذا ليس عدلاً
!لم أكن البادئ بالشجار

241
00:18:05,160 --> 00:18:07,430
لا أفهم لِمَ يجب
!علي أن أُعاقب

242
00:18:07,880 --> 00:18:10,670
الأمر لا يتعلق بمن المخطئ
ومن على حق

243
00:18:10,960 --> 00:18:13,340
أنت رجلٌ رياضي
في عيون الجميع

244
00:18:13,600 --> 00:18:16,030
لا يمكننا أن نتورط في

245
00:18:16,120 --> 00:18:18,830
أي شكلٍ من أشكال العنف
!يتورط فيها رياضي

246
00:18:20,880 --> 00:18:23,830
لقد كُنتُ مجبراً على اتخاذ
هذا القرار

247
00:18:23,920 --> 00:18:27,670
لمنع وقوع مشاكل
أخطر في المستقبل

248
00:18:28,520 --> 00:18:31,350
الرخصة تم سحبها ولا
شيء يمكننا فعله

249
00:18:37,400 --> 00:18:39,830
!مهلاً -
!غونما -

250
00:18:39,920 --> 00:18:42,750
تاموتسو؟ -
...غونما -

251
00:18:43,200 --> 00:18:45,150
!أنا سعيدٌ لرؤيتك

252
00:18:45,800 --> 00:18:47,750
لم أتخيل أن ألتقي بك

253
00:18:47,840 --> 00:18:49,790
!في مثل هذا الحفل المهم

254
00:18:49,880 --> 00:18:52,950
!أنت تحب الحفلات الآن

255
00:18:53,280 --> 00:18:55,150
،غونما
...هل صحيح

256
00:18:55,240 --> 00:18:57,190
...أنهم سحبوا رخصتك

257
00:18:57,640 --> 00:19:00,670
لأنك تورطتَ في شجار؟ -
!ولِمَ تهتم -

258
00:19:00,800 --> 00:19:03,630
ظننتُ أنك لا تهتم سوى
بهيجيري وسيارته

259
00:19:03,720 --> 00:19:06,830
!ما خطبك
أنا ما زلتُ صديقك وأهتم بك

260
00:19:07,000 --> 00:19:10,350
وأعلم أيضاً مقدار ما
تعنيه لك فورمولا 3

261
00:19:10,480 --> 00:19:12,910
والآن لا تستطيع القيادة بدون رخصة

262
00:19:13,000 --> 00:19:14,870
!ماذا تقول -
إيه؟ -

263
00:19:15,000 --> 00:19:17,750
هل تذكر كم عملنا
بجد معاً؟

264
00:19:17,880 --> 00:19:20,750
لكن ذلك لم يمنعك من
الانضمام لهيجيري

265
00:19:20,880 --> 00:19:23,070
وتجرؤ على القول
!أنك ما تزال صديقي

266
00:19:23,160 --> 00:19:25,990
...أيها الخائن... أيها الــ

267
00:19:40,000 --> 00:19:42,350
أموري لم تعد تعنيك
بعد الآن

268
00:19:45,280 --> 00:19:47,150
!غونما

269
00:19:55,800 --> 00:19:57,750
لا أدري ماذا أفعل

270
00:20:00,520 --> 00:20:03,060
لا مال لدي، ولا سيارة، والآن
!لم تعد لدي حتى رخصة السياقة

271
00:20:23,200 --> 00:20:25,630
يجب أن أجد حلاً

272
00:20:27,560 --> 00:20:32,110
دارة السباق

273
00:20:32,720 --> 00:20:36,510
!لا يمكنني التخلي عن عالم السباق

274
00:20:46,600 --> 00:20:48,550
إيه؟ هيجيري مريض؟

275
00:20:48,640 --> 00:20:51,150
!نعم، لكنه سر
يجب أن نكون حذرين

276
00:20:51,360 --> 00:20:53,630
للأسف هيجيري يعاني
!من مرض لا علاج له

277
00:20:53,720 --> 00:20:56,230
إنه شيء لا يعلمه إلا
!هيجيري، أنا ورويكو

278
00:20:56,360 --> 00:20:58,270
في الحلقة القادمة

279
00:20:58,360 --> 00:21:00,310
،مرض هيجيري يزحف أكثر
لكنني لستُ خائفاً من الموت

280
00:21:00,400 --> 00:21:02,550
هيجيري، دارة السباق
!لن تصبح قبرك