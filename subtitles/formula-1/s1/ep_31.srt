1
00:01:31,720 --> 00:01:35,870
الآن سأعلمك كيف
!تتجاوز شخصاً، غونما

2
00:01:40,480 --> 00:01:42,350
!تباً

3
00:01:52,000 --> 00:01:56,000
!وداعاً غونما
!!الرجل الأسرع في العالم

4
00:02:14,640 --> 00:02:17,750
هيجيري، الآن أصبح النزال
بيني وبينك فقط

5
00:02:33,600 --> 00:02:36,350
!وجدتُكِ أخيراً
لا فائدة من الهرب

6
00:02:36,440 --> 00:02:38,590
!لأنني سأجدك مجدداً
!تذكري ذلك

7
00:02:43,080 --> 00:02:46,750
،هيا أيها المحرك
لا تخذلني

8
00:02:48,400 --> 00:02:52,230
،إذا كان لديك الحظ
حاول مجاراتي

9
00:02:52,880 --> 00:02:56,030
لأنني سأعلمك شيئاً مثيراً

10
00:02:56,720 --> 00:02:59,750
أتساءل ما الذي كان
يقصد بذلك

11
00:03:01,240 --> 00:03:03,870
لا بد أنه يعني
شيئاً مهما

12
00:03:04,320 --> 00:03:07,590
!لكن ربما كان يتبجح فحسب
!أنا الذي سأريه شيئاً مهما

13
00:03:18,240 --> 00:03:21,270
!مذهل
يمكنني سماع صوت المحرك يغني

14
00:03:29,880 --> 00:03:33,150
صوتُ موسيقاه يخفق
!بانسجام مع دقات قلبي

15
00:03:34,400 --> 00:03:36,550
الآن أنا والمحرك
شيءٌ واحد

16
00:03:37,880 --> 00:03:40,750
!هيا، غني
!بصوتٍ أعلى

17
00:04:04,720 --> 00:04:06,670
إنه يسحبني

18
00:04:28,800 --> 00:04:31,100
ماذا؟ -
!مدهش -

19
00:04:31,200 --> 00:04:34,070
تلك السيارة لديها محرك أقوى بكثير
!من محرك فورمولا 3

20
00:04:34,160 --> 00:04:36,030
!...هـ - هيجيري

21
00:04:38,000 --> 00:04:41,230
كيف فعل هذا؟
!أنا أضغط على سيارتي لأقصى حد

22
00:04:41,320 --> 00:04:43,350
ألا يمكنني أن أسرع أكثر؟

23
00:04:44,720 --> 00:04:47,910
ستكون مهمةً مستحيلة لسيارتك

24
00:04:48,000 --> 00:04:49,950
!إمكانياته أعلى منك

25
00:04:50,080 --> 00:04:51,950
لقد قلت لك أن هيجيري
!في حالةٍ عظيمة

26
00:04:52,040 --> 00:04:54,070
!وهو مصمم على الفوز حتماً

27
00:04:54,600 --> 00:04:57,470
!وعليه أن يفعل
وإلا في العام القادم

28
00:04:57,560 --> 00:04:59,430
لن يتمكن من السباق
!في فورمولا 1

29
00:04:59,600 --> 00:05:06,300
!لن يتمكن من السباق في فورمولا 1
!لن يتمكن من السباق في فورمولا 1

30
00:05:06,640 --> 00:05:10,700
...إذاً
إذاً هيجيري لا يتبجح

31
00:05:10,880 --> 00:05:12,990
...لقد طلب مني أن أتبعه

32
00:05:13,080 --> 00:05:15,030
!لكي يسخر من دونيتي

33
00:05:25,200 --> 00:05:28,670
!أخيراً العالم في يدي

34
00:05:49,480 --> 00:05:51,750
لا أظن أن هيجيري
رأى الإشارة

35
00:05:52,240 --> 00:05:54,430
!لـ - لم أرى شيئاً كهذا أبداً

36
00:05:54,520 --> 00:05:56,390
بعد عدة لفاتٍ من السرعة العالية

37
00:05:56,480 --> 00:05:58,350
!لا يُظهر محركه أي علامة على التباطؤ

38
00:05:58,440 --> 00:06:00,820
كل هذا بسبب قدرات تاموتسو

39
00:06:00,920 --> 00:06:02,870
أليس هذا صحيحاً، إيجيرو؟

40
00:06:03,600 --> 00:06:05,470
سمباي قادم

41
00:06:10,200 --> 00:06:12,660
!هذه أقصى سرعة لسيارتي

42
00:06:13,200 --> 00:06:16,190
غونما يقدم كل
ما لديه

43
00:06:16,400 --> 00:06:18,430
!لكنه لا يستطيع تجاوز هيجيري

44
00:06:18,560 --> 00:06:21,750
...ما لم تحدث معجزة -
معجزة!؟ -

45
00:06:22,400 --> 00:06:24,700
هيجيري يسير بقوة

46
00:06:24,800 --> 00:06:27,670
لكن المحرك قد يتوقف

47
00:06:30,600 --> 00:06:33,710
لقد اكتفيتُ من البقاء
...خلف هيجيري

48
00:06:33,800 --> 00:06:36,230
...حتى لو تحطم محركي

49
00:06:36,320 --> 00:06:39,270
!سأتجاوزه

50
00:06:41,800 --> 00:06:44,260
!هيجيري فوق حدوده

51
00:06:44,600 --> 00:06:47,870
وهو ليس خائفاً بالتأكيد

52
00:06:48,120 --> 00:06:50,070
وهذا يعني شيئاً واحداً

53
00:06:50,320 --> 00:06:53,910
هيجيري حتى الآن هو
!السائق الأعظم لكل الأوقات

54
00:07:01,240 --> 00:07:05,020
!هذه معجزة
!لم أشعر من قبل بهذا الدفئ بداخلي

55
00:07:05,160 --> 00:07:08,270
وهذا يعني أن اللحظة
!الحتمية قريبة

56
00:07:08,600 --> 00:07:12,430
تدهور المعلق، الإطارات والمكابح

57
00:07:12,560 --> 00:07:15,750
،هدير المحرك، الصمامات
...حركة المكابس

58
00:07:15,880 --> 00:07:17,830
يمكنني الشعور بها في يدي

59
00:07:18,320 --> 00:07:21,550
،كل بوصة مربعة من الأسفلت
وكل قطرةٍ من الزيت

60
00:07:21,720 --> 00:07:24,950
!لديها لمعان الألماس

61
00:07:30,080 --> 00:07:32,030
...العشب، الأشجار، الأزهار

62
00:07:32,480 --> 00:07:35,270
ألوانها الآن تبدو أجمل
من ذي قبل

63
00:07:35,880 --> 00:07:38,510
،لم ألاحظ من قبل
كم هي الطبيعة جميلة

64
00:07:39,160 --> 00:07:41,670
للأسف، لقد أدركتُ
ذلك متأخراً

65
00:07:51,000 --> 00:07:53,590
!هذا العالم مليئ بالنور

66
00:07:53,880 --> 00:07:56,150
لم أرى كل هذا النور
!في حياتي

67
00:07:57,480 --> 00:07:59,430
هل تتبعني، غونما؟

68
00:07:59,640 --> 00:08:03,630
هذا رائع! أشعر كأنني
!أسيطر على حياته

69
00:08:07,080 --> 00:08:09,460
أتساءل لماذا لم يرى الإشارة

70
00:08:20,080 --> 00:08:21,550
...تاموتسو

71
00:08:21,920 --> 00:08:23,790
!إنه مصاب

72
00:08:26,080 --> 00:08:28,030
!شكراً على كل شيء، تاموتسو

73
00:08:28,160 --> 00:08:31,630
هذه السيارة هي أفضل هدية
!أتلقاها

74
00:08:33,120 --> 00:08:35,070
!المجد ينتظر

75
00:08:35,360 --> 00:08:37,350
لكن عوضاً عني

76
00:08:38,160 --> 00:08:40,150
تقاسمهُ مع صديقك غونما

77
00:08:56,200 --> 00:08:58,150
!هيجيري

78
00:08:58,320 --> 00:09:00,510
!...لكن

79
00:09:02,680 --> 00:09:05,140
لقد وعدتُ ألا
أوقف سباقك

80
00:09:05,280 --> 00:09:07,230
الآن قرر مصيرك بنفسك

81
00:09:12,520 --> 00:09:14,470
!الآن أنا وأنت فقط، هيجيري

82
00:09:14,600 --> 00:09:17,550
أنا متخلفٌ عنك منذ
بداية السباق

83
00:09:18,240 --> 00:09:21,070
لكنني الأسرع
!على الطريق

84
00:09:21,160 --> 00:09:23,030
وسأبرهن على هذا

85
00:09:24,000 --> 00:09:26,230
،علي أن أسرع
!نحن في اللفة الأخيرة

86
00:09:27,200 --> 00:09:30,630
الطريق مثالي وأنا لا
!أضغط على المحرك حتى

87
00:09:31,240 --> 00:09:35,270
إذا استمريتُ هكذا
!سأتمكن من تجاوزه

88
00:09:36,400 --> 00:09:39,030
!نعم
!الآن

89
00:09:45,080 --> 00:09:47,750
نعم! فقط حين
!لا يتوقع ذلك

90
00:09:49,080 --> 00:09:51,030
!أطلب شيئاً واحداً، غونما

91
00:09:52,800 --> 00:09:56,670
سأعلمك كيف يتصرف البطل
!العظيم على الطريق

92
00:09:58,480 --> 00:10:00,350
!هـ - هيجيري

93
00:10:05,720 --> 00:10:08,670
!هكذا إذاً، هيجيري

94
00:10:08,800 --> 00:10:11,180
الآن فهمت ماذا كنت
!تريد أن تعلمني

95
00:10:28,880 --> 00:10:30,830
!هاي! أبطئ السرعة

96
00:10:30,920 --> 00:10:33,480
إذا استمريت هكذا
قد يذوب المحرك

97
00:10:33,640 --> 00:10:35,470
لنحاول ذلك مجدداً

98
00:10:35,560 --> 00:10:37,940
أسرع واسحبني مثلما
فعلت قبلاً

99
00:10:38,480 --> 00:10:41,670
،وعندما تفعل
!لن أتردد في تجاوزك

100
00:10:42,720 --> 00:10:44,710
!غونما! أبطئ السرعة

101
00:10:44,800 --> 00:10:47,070
!لا يمكن أن تستمر بهذه السرعة

102
00:10:47,560 --> 00:10:49,470
!هيا، هيجيري! لِمَ الانتظار

103
00:10:49,600 --> 00:10:51,550
!قم بذلك مجدداً

104
00:10:52,000 --> 00:10:55,430
هذه المرة سأريك أنني تعلمت
!هذا الدرس جيداً

105
00:10:58,240 --> 00:11:02,810
أكاغي غونما؟
ما يزال معي إذاً، هذا جيد

106
00:11:08,640 --> 00:11:10,510
!عظيم! إنه يسرع

107
00:11:14,640 --> 00:11:17,950
إذا استغليتُ الوضع جيداً
!سأتجاوزه بسهولة

108
00:11:24,720 --> 00:11:26,750
أرجو فقط أن يستمر
المحرك بالعمل

109
00:11:53,360 --> 00:11:56,550
!آه

110
00:12:06,200 --> 00:12:08,070
...هاه

111
00:12:12,100 --> 00:12:13,500
هيجيري؟

112
00:12:39,800 --> 00:12:41,750
ماذا يجري؟

113
00:12:42,480 --> 00:12:44,430
لماذا لا يتبعني هيجيري؟

114
00:12:45,120 --> 00:12:47,110
!لا يمكن أن يكون استسلم بسهولة

115
00:12:48,200 --> 00:12:51,190
!تماسك هيجيري
!تماسك هيجيري

116
00:13:12,400 --> 00:13:15,270
!هيجيري! تماسك -
!هيجيري -

117
00:13:15,800 --> 00:13:18,390
!أرسلوا سيارة إسعافٍ حالاً -
كيف حدث هذا؟ -

118
00:13:18,480 --> 00:13:20,670
!لا أدري
!ربما كانت المكابح

119
00:13:21,400 --> 00:13:23,350
!هيجيري

120
00:13:33,080 --> 00:13:35,350
هيجيري، ما الأمر؟

121
00:13:35,480 --> 00:13:37,630
!تماسك، هيجيري
!أجبني، هيجيري

122
00:13:46,320 --> 00:13:48,670
...في... في كل العالم

123
00:13:52,520 --> 00:13:54,950
...لا يوجد أحد...

124
00:14:00,800 --> 00:14:02,950
!أفضل منك...

125
00:14:03,800 --> 00:14:05,670
!حظا موفقاً

126
00:14:11,600 --> 00:14:15,950
!هيجيري

127
00:14:32,480 --> 00:14:37,110
!مهلاً
سأنزع عنه الخوذة

128
00:14:46,080 --> 00:14:48,030
!والقناع

129
00:14:48,480 --> 00:14:51,830
،أنت حر الآن
يمكنك أن تتنفس

130
00:15:00,960 --> 00:15:03,420
...ما هذا
...يجب أن نفعل شيئاً

131
00:15:04,080 --> 00:15:06,030
هل فات الأوان

132
00:15:18,080 --> 00:15:19,950
إلى أين تأخذه؟

133
00:15:43,240 --> 00:15:46,590
سأعلمك كيف يتصرف البطل
!العظيم على الطريق

134
00:15:46,880 --> 00:15:49,590
كل ما عليك فعله
هو مجاراتي، غونما

135
00:15:49,880 --> 00:15:52,550
شكراً لك هيجيري، على هذا الدرس

136
00:15:52,800 --> 00:15:56,670
أنت سائقٌ عظيم وسأحاول
أن أسير على خطاك

137
00:15:57,200 --> 00:16:00,350
هيجيري طلب مني أن
!أكون ميكانيكيه

138
00:16:00,960 --> 00:16:03,910
لا أستطيع أن أشرح لماذا

139
00:16:04,000 --> 00:16:07,070
لكنني لا أستطيع أن أخلف الوعد
الذي قطعته مع هيجيري

140
00:16:07,680 --> 00:16:10,140
!سامحني أرجوك -
...سامحتك -

141
00:16:10,280 --> 00:16:12,230
الآن فقط فهمت لماذا
!فعلتَ ذلك

142
00:16:18,000 --> 00:16:18,750
!غونما

143
00:16:20,250 --> 00:16:21,750
!هيجيري

144
00:17:09,680 --> 00:17:11,670
!تاموتسو
!الشامبانيا

145
00:17:19,400 --> 00:17:23,310
!أنتَ الفائز
سامحني على وقاحتي، هيجيري

146
00:17:34,680 --> 00:17:37,670
...وداعاً، هيجيري... صديقي

147
00:18:04,320 --> 00:18:07,510
!يا لهم من زمرة من الحمقى
يجازفون بحياتهم على الطريق

148
00:18:07,600 --> 00:18:09,670
والآن أنظروا إلى ما يحدث

149
00:18:10,000 --> 00:18:11,950
!هيا، لنذهب

150
00:18:16,880 --> 00:18:18,830
!يـ - يوكي

151
