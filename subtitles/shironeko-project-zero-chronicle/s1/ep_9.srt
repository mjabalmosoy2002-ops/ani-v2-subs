1
00:00:27,360 --> 00:00:30,610
،لطالما حيرني أمره

2
00:00:31,690 --> 00:00:35,910
.تواجد هناك منذ البداية لكنه بقي بالخلف

3
00:00:35,910 --> 00:00:38,700
،لكنه بدى هادئاً

4
00:00:38,700 --> 00:00:41,660
.وغير متأثر

5
00:00:43,500 --> 00:00:45,620
.ظننت أن الأمر غريب

6
00:00:45,620 --> 00:00:50,250
.استطعت أن أعرف مباشرة أنه كان وريث ملك الظلام

7
00:00:50,250 --> 00:00:55,010
.لكن يكاد يكون الانطباع الذي تركه عكس ذلك تماماً

8
00:00:55,010 --> 00:01:00,390
.كنت قلقة قليلاً بشأن وراثة شخص مثله للعرش

9
00:01:00,390 --> 00:01:06,730
.لم أكن أظن أنني سأحصل على فرصة الحديث معه بشكل هادف

10
00:01:06,730 --> 00:01:08,560
..."الأسود"

11
00:01:17,200 --> 00:01:21,330
.سنجلب السلام لهذا العالم معاً

12
00:01:22,620 --> 00:01:24,330
.أعدك

13
00:01:28,380 --> 00:01:30,090
.وعد

14
00:01:54,480 --> 00:01:59,530
تحت "الضوء والظلام" اللذان يسميان العدالة

15
00:01:59,530 --> 00:02:04,150
ترتطم أمانينا بالأرض تحت الشفق

16
00:02:04,150 --> 00:02:11,540
،إن أردت المستقبل الذي يوجد بالجانب الآخر من المرآة

17
00:02:11,540 --> 00:02:13,540
فاعبُر الكوابيس

18
00:02:13,540 --> 00:02:18,460
تتجزأ الأرواح مثل البحر والسماء

19
00:02:18,460 --> 00:02:23,010
،حتى لو أدركنا أن تشابههما خاطئ

20
00:02:23,010 --> 00:02:26,760
،يمكننا على الأقل ألا نعطيه وصفاً أو شكلاً

21
00:02:26,760 --> 00:02:29,390
أو نشك بروابطنا

22
00:02:29,390 --> 00:02:35,140
ونُخبر أنفسنا أنه حتى العمى رأفة

23
00:02:35,140 --> 00:02:37,690
الأبيض والأسود؟ كفتي الميزان

24
00:02:37,690 --> 00:02:40,480
تتمايل بقسوة

25
00:02:40,480 --> 00:02:45,700
نتشبث بقوة ببريق أملنا

26
00:02:45,700 --> 00:02:47,740
نظرنا إلى سديم بالأعلى

27
00:02:47,740 --> 00:02:50,700
يحمل مُدناً فاسدة لا حصر لها

28
00:02:50,700 --> 00:02:53,370
زحفت عبر الوحل وعقلي مُتّقد

29
00:02:53,370 --> 00:02:57,960
وقابلتكِ في الجانب البعيد لكفتي الميزان

30
00:03:08,140 --> 00:03:10,810
"الفصل 9" "ملكة الضوء وأمير الظلام"

31
00:03:44,760 --> 00:03:45,930
.فايوس

32
00:03:45,930 --> 00:03:47,100
.أجل

33
00:03:47,100 --> 00:03:51,390
.سمعت أن الظلام قد ظهر في المدينة أيضاً

34
00:03:51,390 --> 00:03:54,100
،بأعداد قليلة فحسب

35
00:03:54,100 --> 00:03:55,270
.لكن أجل

36
00:03:55,270 --> 00:03:59,530
.سمعت أن الكشافة قد ظهروا في "ميتيس" كذلك

37
00:04:01,440 --> 00:04:04,820
ما الذي علينا فعله يا أيريس-ساما؟

38
00:04:04,820 --> 00:04:08,370
...في مواجهة هذه الهجمات المتزامنة

39
00:04:08,370 --> 00:04:11,370
.شددوا المراقبة على كل المواقع العسكرية

40
00:04:11,370 --> 00:04:15,750
.سأخرج بمجرد رصدهم لهجوم الظلام

41
00:04:15,750 --> 00:04:18,960
.قد تكون هناك غارات أخرى

42
00:04:18,960 --> 00:04:22,840
ستبقى القوات الرئيسية للفرسان والساحرات
،على أهبة الاستعداد داخل القصر

43
00:04:22,840 --> 00:04:25,930
.ليكونوا مستعدين للاستجابة في أي وقت

44
00:04:25,930 --> 00:04:28,720
.سأتبعهم على الفور

45
00:04:28,720 --> 00:04:30,020
.حاضر

46
00:04:30,020 --> 00:04:32,020
.كما تشائين

47
00:04:38,110 --> 00:04:43,990
.أطلب المغادرة لفترة قصيرة يا أيريس-ساما

48
00:04:43,990 --> 00:04:45,780
ماذا؟

49
00:04:45,780 --> 00:04:47,700
فايوس؟

50
00:04:47,700 --> 00:04:53,710
.من واجبي كفارس ضوء حماية أيريس-ساما، ملكة الضوء

51
00:04:53,710 --> 00:05:00,050
.لكن يبدو أن أيريس-ساما مرهقة من المعركة السابقة

52
00:05:00,050 --> 00:05:03,550
...سنبذل كل جهدنا من أجلها، لذا

53
00:05:03,550 --> 00:05:09,930
لهذا أريد المغادرة بحثاً عن طريقة تُعيد
.لأيريس-ساما صحتها

54
00:05:12,810 --> 00:05:16,520
لكن من سيقود الفرسان في غيابك؟

55
00:05:16,520 --> 00:05:20,980
،"أيريس-ساما هي قلب وروح مملكة "الأبيض

56
00:05:20,980 --> 00:05:25,490
.أعتقد أن علاجها يجب أن يكون أولوية قصوى

57
00:05:30,410 --> 00:05:34,080
،لا داعي للقلق يا فايوس

58
00:05:34,080 --> 00:05:35,830
.سأتعافى في نهاية المطاف

59
00:05:35,830 --> 00:05:37,830
...لكن -
أخي -

60
00:05:41,630 --> 00:05:46,300
.اجعل الفرسان يتدربون استعداداً لاجتياح الظلام رجاءً

61
00:05:46,300 --> 00:05:49,640
.اجعلي الساحرات يركزن على التدريب على إلقاء التعاويذ

62
00:05:49,640 --> 00:05:50,800
حاضر

63
00:05:53,640 --> 00:05:55,020
حاضر

64
00:06:00,940 --> 00:06:02,320
...شيما

65
00:06:03,820 --> 00:06:07,280
.أنا قلق حقاً بشأن حالة أيريس-ساما

66
00:06:07,280 --> 00:06:09,490
.أنا أعارض مغادرتك

67
00:06:09,490 --> 00:06:12,620
.لا يمكنك ترك مركزك في هذا الوضع

68
00:06:12,620 --> 00:06:14,290
،لن يأخذ الأمر وقتاً طويلاً

69
00:06:14,290 --> 00:06:18,040
.ولن تكوني بحاجة للقلق بشأن الفرسان في غيابي

70
00:06:18,040 --> 00:06:20,830
لكن من سيتولى القيادة؟

71
00:06:20,830 --> 00:06:22,920
.أنتِ يا شيما

72
00:06:22,920 --> 00:06:23,960
!ماذا؟

73
00:06:23,960 --> 00:06:26,210
!ذلك ليس مضحكاً

74
00:06:26,210 --> 00:06:28,970
!أتتوقع مني التلويح بسيف في الأرجاء؟

75
00:06:28,970 --> 00:06:31,470
هل أطلب ذلك من ثيو إذن؟

76
00:06:33,050 --> 00:06:36,520
.لن تسمح صاحبة الجلالة بذلك

77
00:06:36,520 --> 00:06:39,640
بجانب ذلك، كيف تُخطط لعلاجها؟

78
00:06:39,640 --> 00:06:41,190
.لدي دليل

79
00:06:44,270 --> 00:06:45,780
.فهمت

80
00:06:46,820 --> 00:06:50,360
.لا تُقدم على أي فعل متهور رجاءً

81
00:07:04,960 --> 00:07:07,710
...فهمت، أيريس-ساما

82
00:07:07,710 --> 00:07:09,050
أجل

83
00:07:09,050 --> 00:07:13,760
.ظننت أنك على معرفة بطريقة ما يا ألانتيا-ساما

84
00:07:13,760 --> 00:07:16,560
،أعرف طريقة ما

85
00:07:16,560 --> 00:07:19,680
.لكنها قد تكون خطيرة

86
00:07:19,680 --> 00:07:21,640
من أي ناحية؟

87
00:07:21,640 --> 00:07:27,150
.تبدو أيريس-ساما مستنزفة بسبب معركتها ضد بال

88
00:07:29,280 --> 00:07:33,070
،يبدو أن أيريس-ساما قد استعادت قوتها

89
00:07:33,070 --> 00:07:39,290
.لكن الأعصاب السحرية التي تنقلها لم تتعافى بعد

90
00:07:40,410 --> 00:07:45,040
،لا خيار أمامنا في العادة غير الانتظار

91
00:07:45,040 --> 00:07:48,420
.لتعالجهم تأثيرات "الروح النقية" بشكل طبيعي

92
00:07:55,100 --> 00:07:59,470
.لكن هناك مكان حيث نِعم "الروح النقية" أعظم

93
00:08:00,390 --> 00:08:04,230
،ذلك الكم الهائل من "الروح النقية" في الينبوع الداخلي

94
00:08:04,230 --> 00:08:08,400
.ستُعالج القطرات المتلألئة أيريس-ساما

95
00:08:08,400 --> 00:08:11,320
.القطرات... المتلألئة

96
00:08:11,320 --> 00:08:15,910
.لكن الطريق وعر، والوصول إليها صعب

97
00:08:19,370 --> 00:08:22,210
،حتى بالنسية لفايوس قائد فرسان الضوء

98
00:08:22,210 --> 00:08:25,000
وألانتيا قائد الإلف؟

99
00:08:26,540 --> 00:08:28,420
،من يعلم

100
00:08:28,420 --> 00:08:30,590
.لن نعلم قبل أن نحاول

101
00:08:30,590 --> 00:08:33,300
.إذن أريدك أن ترشدني إلى الطريق

102
00:08:33,300 --> 00:08:36,390
لكن ماذا عن القصر؟

103
00:08:36,390 --> 00:08:40,810
.لقد سمحت لي أيريس-ساما بالمغادرة

104
00:08:40,810 --> 00:08:42,270
.فهمت

105
00:08:42,270 --> 00:08:45,650
.سأساعدك في هذه الحالة

106
00:08:52,150 --> 00:08:55,990
!تجسد

107
00:08:55,990 --> 00:09:02,120
:إحدى القوى السبع

108
00:09:02,120 --> 00:09:05,460
.قفص العاطفة

109
00:09:24,350 --> 00:09:26,270
...مذهل

110
00:09:33,360 --> 00:09:34,690
!شيما-ساما

111
00:09:34,690 --> 00:09:36,110
هل أنت بخير؟

112
00:09:36,110 --> 00:09:37,490
هل تأذيتِ؟

113
00:09:38,950 --> 00:09:41,790
!يجب ألا تفقدن تركيزكن

114
00:09:41,790 --> 00:09:44,330
...شيما-ساما

115
00:09:44,330 --> 00:09:46,250
...هذه التعويذة المترابطة

116
00:09:46,250 --> 00:09:53,210
.تسحب قوة من "رون" السلف أكثر مما يتحمله شخص واحد

117
00:09:53,210 --> 00:09:56,220
،إن تخاذل أي شخص فسوف تفشل التعويذة

118
00:09:56,220 --> 00:09:59,390
.وسيصيب الارتداد الجميع

119
00:09:59,390 --> 00:10:01,470
...إذن منذ قليل، شيما-ساما

120
00:10:01,470 --> 00:10:02,760
.أنا خجلة

121
00:10:02,760 --> 00:10:03,600
.شيما-ساما

122
00:10:03,600 --> 00:10:05,020
.هذا مروع

123
00:10:06,850 --> 00:10:09,350
،استأنف الظلام اجتياحه

124
00:10:09,350 --> 00:10:13,190
...الوحيدون الذين يستطيعون صده، هم ملكة الضوء والفرسان

125
00:10:13,190 --> 00:10:17,150
.ونحن الساحرات

126
00:10:17,150 --> 00:10:21,910
."علينا أن نكون متحدات إن أردنا الدفاع عن مواطني "الأبيض

127
00:10:23,410 --> 00:10:25,120
.الآن، مرة أخرى

128
00:10:25,120 --> 00:10:26,540
!حاضر

129
00:10:26,540 --> 00:10:28,370
...تجسـ -
!شيما-ساما -

130
00:10:29,620 --> 00:10:30,880
ما الخطب؟

131
00:10:30,880 --> 00:10:32,630
!إنه القائد

132
00:10:32,630 --> 00:10:34,750
!فايوس-ساما مفقود

133
00:10:34,750 --> 00:10:36,460
!ماذا؟

134
00:10:38,800 --> 00:10:41,430
!...يا أيريس-ساما، أخي قد

135
00:10:41,430 --> 00:10:43,010
.سمعت بذلك

136
00:10:44,850 --> 00:10:48,180
.لا بد أنه ذهب للعثور على علاج

137
00:10:48,180 --> 00:10:49,980
ما الذي علينا فعله؟

138
00:10:49,980 --> 00:10:53,980
.لا نستطيع إرسال أي شخص من هنا

139
00:10:53,980 --> 00:10:57,440
.لنصلي لعودة فايوس سالماً

140
00:10:58,360 --> 00:11:01,610
.حاضر، أنا في غاية الأسف

141
00:11:02,990 --> 00:11:06,410
.لا حاجة للاعتذار يا شيما-سان

142
00:11:09,210 --> 00:11:13,590
.عودي الآن إلى برجك ودربي الساحرات

143
00:11:13,590 --> 00:11:14,750
!حاضر

144
00:11:20,300 --> 00:11:21,800
.من هنا

145
00:11:23,550 --> 00:11:25,260
هنا بالداخل؟

146
00:11:25,260 --> 00:11:28,480
.عاد قلة فقط

147
00:11:28,480 --> 00:11:29,890
أما زلت تريد الذهاب؟

148
00:11:31,230 --> 00:11:33,770
.لن أتراجع الآن

149
00:11:36,780 --> 00:11:38,320
.حسنًا

150
00:11:38,320 --> 00:11:40,110
.لنذهب إذن

151
00:11:40,110 --> 00:11:41,240
.أجل

152
00:11:43,070 --> 00:11:45,580
"رقم 9: السحر"
في مملكة ‘الأبيض‘، يشير السحر إلى ظاهرة خارقة للطبيعة"
...تُستحضر من خلال

153
00:11:45,580 --> 00:11:49,220
"نِعم ‘رون‘ السلف، يولد مواطنو ‘الأبيض‘ بحدس لطريقة استعماله

154
00:11:50,540 --> 00:11:55,790
.لا يمكنني السماح لأي شخص بأن يعرف بشأن لقائي بملكة الضوء

155
00:11:57,750 --> 00:11:59,260
،بعد ذلك

156
00:11:59,260 --> 00:12:02,010
،قفزت إلى سفينة السماء بأسرع ما استطعت

157
00:12:02,010 --> 00:12:04,300
."وغادرت مملكة "الأبيض

158
00:12:14,190 --> 00:12:17,940
،لا أعلم إن كان للأمر علاقة بما حدث لأديل

159
00:12:17,940 --> 00:12:20,650
.لكن رُفض دخولي إلى القصر

160
00:12:22,490 --> 00:12:25,490
.لا أشعر بالانزعاج

161
00:12:25,490 --> 00:12:26,910
...لكن

162
00:12:29,120 --> 00:12:32,410
،ملكة الضوء، أيريس

163
00:12:32,410 --> 00:12:35,420
.تحمل عبئًا كبيرًا على كتفيها الصغيرين

164
00:12:37,540 --> 00:12:40,510
،ليس هم مواطني مملكتها فحسب

165
00:12:40,510 --> 00:12:42,170
.بل العالم بأسره

166
00:12:44,630 --> 00:12:47,680
.علي مساندتها

167
00:12:49,810 --> 00:12:51,310
،قد تكون ملكة

168
00:12:51,310 --> 00:12:56,600
.لكن ليس من الصواب أن تحمل كل هذا العبء بمفردها

169
00:12:58,770 --> 00:13:00,780
،انتظريني رجاءً

170
00:13:00,780 --> 00:13:03,740
.سأقف بجانبك يومًا ما

171
00:13:11,450 --> 00:13:12,790
!يكفي هذا

172
00:13:15,420 --> 00:13:18,170
هل عدت من مهمتك كمبعوث

173
00:13:18,170 --> 00:13:20,880
بتصميم جديد؟

174
00:13:22,010 --> 00:13:23,800
.فالوس

175
00:13:23,800 --> 00:13:25,800
ما الأمر؟

176
00:13:25,800 --> 00:13:28,140
هل الأمور على ما يُرام كما هي عليه؟

177
00:13:31,310 --> 00:13:35,140
.لن يكون لنا اتصال بـ"الأبيض" إلى الأبد

178
00:13:36,100 --> 00:13:38,360
.إنها إرادة الملك

179
00:13:42,980 --> 00:13:44,860
أهذا صائب؟

180
00:13:44,860 --> 00:13:46,400
ما هو؟

181
00:13:49,070 --> 00:13:53,330
أن يُصبح الشخص الذي يحمل الظلام الأكبر
.ملكًا ويقود المملكة

182
00:13:53,330 --> 00:13:58,290
.في مملكتنا، الملك هو مصدر قوة الظلام

183
00:13:58,290 --> 00:14:02,750
.إطاعة إرادته عُرف قديم

184
00:14:02,750 --> 00:14:05,300
أهكذا يسير العالم؟

185
00:14:06,260 --> 00:14:10,350
.لا يجب أن نتحدث عن أفكار طائشة كهذه

186
00:14:10,350 --> 00:14:14,350
.ما يلفه الظلام هو كونه نفسه

187
00:14:14,350 --> 00:14:16,850
.الخير والشر وكل شيء

188
00:14:21,860 --> 00:14:25,900
.سيستمر في التمدد ما دام هناك مجال

189
00:14:25,900 --> 00:14:31,240
.تلك هي حقيقة هذا العالم منذ ولادته

190
00:14:31,240 --> 00:14:34,330
!ألم يشكك أي شخص في الأمر من قبل؟

191
00:14:34,330 --> 00:14:37,870
...ما عليه "الأسود" و"الأبيض"، الضوء والظلام الآن

192
00:14:37,870 --> 00:14:40,750
...من يعلم حقاً

193
00:14:40,750 --> 00:14:43,800
ما إذا الطريق الصائب؟

194
00:14:43,800 --> 00:14:48,840
.على الأرجح أن صاحب الجلالة يتساءل بشأن الأمر ذاته

195
00:14:48,840 --> 00:14:50,390
،أتساءل

196
00:14:50,390 --> 00:14:56,520
.ربما التدمير والاحتلال أسوء

197
00:14:56,520 --> 00:15:01,350
."إن غطى الظلام كل شيء، سيكون العالم بأكمله في سلام"

198
00:15:01,350 --> 00:15:03,730
.لكن ربما ذلك مجرد تضليل

199
00:15:03,730 --> 00:15:10,490
،من واجب الملك التفكير في أبعد من ذلك
.أن يقود ويحصد النتائج

200
00:15:10,490 --> 00:15:16,120
لست في مكان يسمح لي بالحكم على المستقبل
.بناءً على تكهنات

201
00:15:16,120 --> 00:15:17,700
.أعلم

202
00:15:17,700 --> 00:15:24,420
.عندما يحين عهدك، استعملني من أجل السبيل الذي تؤمن به

203
00:15:25,880 --> 00:15:29,090
.شكرًا لك يا فالوس

204
00:15:29,090 --> 00:15:32,640
،من المبكر أن تشكرني

205
00:15:32,640 --> 00:15:36,100
.يجب أن تتفوق علي في المسايفة

206
00:15:36,100 --> 00:15:37,390
!أجل

207
00:15:42,100 --> 00:15:43,860
!غروزا

208
00:15:46,020 --> 00:15:47,440
ما الأمر؟

209
00:15:49,400 --> 00:15:54,780
.علينا أنا وأمير الظلام القضاء على الوحوش على الحدود

210
00:15:54,780 --> 00:15:56,030
أوامر الملك؟

211
00:15:56,030 --> 00:16:02,040
.أجل، قال صاحب الجلالة أنها قوية بالنسبة للجنود العاديين

212
00:16:02,040 --> 00:16:03,670
هل سنغادر فورًا؟

213
00:16:03,670 --> 00:16:04,880
.هذا صحيح

214
00:16:04,880 --> 00:16:07,210
.يبدو أنها حالة طارئة

215
00:16:35,320 --> 00:16:36,660
.فالوس

216
00:16:36,660 --> 00:16:40,370
.القوات جاهزة

217
00:16:40,370 --> 00:16:42,210
وطليعة الجيش؟

218
00:16:42,210 --> 00:16:43,500
أجل

219
00:16:43,500 --> 00:16:45,210
.كما تشاء

220
00:16:45,210 --> 00:16:47,170
!سيُنفذ الأمر على وجه السرعة

221
00:16:58,560 --> 00:17:02,060
،إن حجب الظلام النور

222
00:17:02,060 --> 00:17:08,150
.سينافس الظلام كند مجددًا، سينطفئ بسهولة

223
00:17:09,770 --> 00:17:13,280
...سمعت أنها ظهرت هنا، لكن

224
00:17:13,280 --> 00:17:14,950
.هذا المكان مثل المتاهة

225
00:17:14,950 --> 00:17:17,410
.يجب أن نحرص ألا نضل

226
00:17:29,420 --> 00:17:31,130
!ها هي ذي

227
00:17:47,150 --> 00:17:49,440
.كان ذلك سهلًا

228
00:17:49,440 --> 00:17:51,520
.ربما كانت تلك الوحوش الخاطئة

229
00:17:51,520 --> 00:17:53,110
.لنواصل البحث

230
00:17:53,110 --> 00:17:54,320
.حسنًا

231
00:18:10,420 --> 00:18:12,550
ما الخطب؟

232
00:18:12,550 --> 00:18:14,960
.لا شيء

233
00:18:21,430 --> 00:18:22,640
...ذلك

234
00:18:22,640 --> 00:18:27,940
.إذن ملك الظلام لن يعقد صلحًا مع "الأبيض" مجددًا

235
00:18:37,610 --> 00:18:38,820
!احترس

236
00:19:00,050 --> 00:19:01,340
!غروزا

237
00:19:16,480 --> 00:19:18,110
.أيها الأمير

238
00:19:24,870 --> 00:19:26,490
.نحن بأمان الآن

239
00:19:29,410 --> 00:19:32,080
!شكرًا جزيلًا لك

240
00:19:32,080 --> 00:19:33,460
.لا عليك

241
00:19:33,460 --> 00:19:35,750
،الأهم

242
00:19:35,750 --> 00:19:37,460
كيف نعود؟

243
00:19:37,460 --> 00:19:39,880
.أنت محق

244
00:19:42,550 --> 00:19:43,890
...ربما نستطيع

245
00:19:58,690 --> 00:20:01,240
.ربما هذا هو

246
00:20:29,390 --> 00:20:30,480
!إنه آت

247
00:20:40,900 --> 00:20:41,990
!ماذا؟

248
00:20:41,990 --> 00:20:43,910
!...في تلك الحالة

249
00:21:35,120 --> 00:21:36,880
،شيما-ساما

250
00:21:36,880 --> 00:21:39,170
!لقد ظهر الظلام

251
00:21:39,170 --> 00:21:41,880
!إنه هنا في "ميتيس" أيضًا

252
00:21:41,880 --> 00:21:43,970
!ما الذي علينا فعله؟

253
00:21:43,970 --> 00:21:46,260
.تصرفن بهدوء

254
00:21:46,260 --> 00:21:48,850
.استدرجوهم واعترضوهم

255
00:21:48,850 --> 00:21:51,140
.سآتي إلى هناك قريبًا

256
00:22:10,530 --> 00:22:15,290
أمشي في الأزقة الصامتة بمفردي

257
00:22:15,290 --> 00:22:18,920
في ذكرياتي

258
00:22:20,130 --> 00:22:22,380
حينما لا أستطيع رؤيتك

259
00:22:22,380 --> 00:22:28,720
يقودني ذلك للضلال، ضوء عابر

260
00:22:28,720 --> 00:22:36,720
،أريد لمس ظلامك

261
00:22:38,190 --> 00:22:46,190
ما يقبع خلفه وحقيقته

262
00:22:48,360 --> 00:22:51,910
دعني أضيء ظلامك

263
00:22:51,910 --> 00:22:54,700
حتى لو كنا بمعزل عن بعضنا

264
00:22:57,160 --> 00:23:01,420
ألن تسمح لي بإنارة ظلامك؟

265
00:23:01,420 --> 00:23:04,210
سأعثر عليك

266
00:23:07,920 --> 00:23:12,640
اِجرِ أيها الضوء

267
00:23:12,640 --> 00:23:15,970
إلى حيث توجد

268
00:23:15,970 --> 00:23:18,810
من خلال الظلام

269
00:23:20,690 --> 00:23:24,110
من خلال الظلام

270
00:23:38,080 --> 00:23:41,000
"الحلقة القادمة"
"الفصل 10: أغنية الظلام اللطيفة"