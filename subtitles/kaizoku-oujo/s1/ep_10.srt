1
00:00:35,650 --> 00:00:40,180
.تتدفّق المياه، وتسعى الغيوم خلف الدّمية البيضاء

2
00:02:23,880 --> 00:02:27,150
.نوشك على الوصول إلى الإحداثيّات

3
00:02:27,350 --> 00:02:28,710
.نعم

4
00:02:28,710 --> 00:02:31,920
.بطريقة ما، يبدو هذا غريبًا

5
00:02:31,920 --> 00:02:33,420
.أعلم ما ترمين إليه

6
00:02:33,810 --> 00:02:38,010
."ربّما هذا ما شعر به قائل "أشعر بالنّشوة والرّعب

7
00:02:38,010 --> 00:02:39,430
من القائل؟

8
00:02:39,430 --> 00:02:40,380
.لا أدري

9
00:02:41,150 --> 00:02:42,220
أين فينا؟

10
00:02:42,220 --> 00:02:44,180
لم أرها اليوم. ربّما في حُجرتها؟

11
00:02:50,160 --> 00:02:51,590
!فينا

12
00:02:53,410 --> 00:02:55,650
.نكاد نصل. هيّا بنا

13
00:02:55,650 --> 00:02:57,260
.حسنًا

14
00:03:00,210 --> 00:03:01,160
.فينا

15
00:03:01,160 --> 00:03:02,200
ماذا؟

16
00:03:02,740 --> 00:03:04,160
.النّهاية وشيكة

17
00:03:04,160 --> 00:03:05,450
.نعم

18
00:03:05,450 --> 00:03:06,990
.أنا متوتّرة قليلاً

19
00:03:07,750 --> 00:03:08,700
.نعم

20
00:03:09,220 --> 00:03:12,000
هل تعتقدين فعلاً أنّ عدن ستكون هناك؟

21
00:03:12,000 --> 00:03:12,980
.ربّما

22
00:03:13,310 --> 00:03:14,650
.هكذا إذًا

23
00:03:15,020 --> 00:03:16,880
.ثمّة ما ينتظرنا هناك

24
00:03:16,880 --> 00:03:17,760
.نعم

25
00:03:18,900 --> 00:03:22,050
آسفة. لا شيء من كلامي يبدو منطقيًّا، صحيح؟

26
00:03:22,050 --> 00:03:24,220
.أنا معتادة على ذلك

27
00:03:30,080 --> 00:03:31,810
أتلك هي؟

28
00:03:31,810 --> 00:03:34,880
.إنّها ليست ما تخيّلته

29
00:03:35,540 --> 00:03:37,570
!إنّها صغيرة جدًّا

30
00:03:37,570 --> 00:03:38,730
.صحيح

31
00:03:39,040 --> 00:03:40,530
هل أخطأنا في شيء ما؟

32
00:03:39,540 --> 00:03:41,240
فينا؟

33
00:03:40,530 --> 00:03:42,600
ربّما كان يفترض بنا عكس العكس؟

34
00:03:42,920 --> 00:03:43,910
.أظنّنا سنعود أدراجنا

35
00:03:43,910 --> 00:03:46,020
.ربّما تكون محقًّا

36
00:03:48,430 --> 00:03:50,000
فينا؟

37
00:03:51,310 --> 00:03:52,460
.يا فينا

38
00:03:51,960 --> 00:03:53,250
.إنّها قادمة

39
00:03:53,600 --> 00:03:56,190
قادمة؟ ماذا تقصدين؟

40
00:03:57,390 --> 00:03:58,340
ما هذا؟

41
00:03:58,340 --> 00:03:59,000
زلزال؟

42
00:04:06,900 --> 00:04:08,640
—ما الّذي

43
00:04:34,930 --> 00:04:36,420
...جزيرة

44
00:04:37,020 --> 00:04:38,920
!تخرج من العدم

45
00:04:39,770 --> 00:04:41,880
!ما-ما هذا؟

46
00:04:42,940 --> 00:04:44,630
...كانت في انتظار

47
00:04:45,190 --> 00:04:47,640
مجيء فينا؟

48
00:04:48,570 --> 00:04:50,640
...إذًا في مكان ما على هذه الجزيرة

49
00:04:51,490 --> 00:04:53,290
توجد عدن؟

50
00:04:53,620 --> 00:04:56,300
.يا رفاق، لنذهب

51
00:05:05,630 --> 00:05:07,610
!ما كلّ هذا؟

52
00:05:08,160 --> 00:05:10,620
.ثمّة بياض كثير لدرجة أنّ عينيّ تؤلمانني

53
00:05:14,220 --> 00:05:15,000
!فينا

54
00:05:16,060 --> 00:05:17,960
.لا داعي للقلق. هذا هو الطّريق

55
00:05:18,430 --> 00:05:20,000
!اتبعوني

56
00:05:20,000 --> 00:05:22,460
.إنّها لا تتصرّف كما فعلت آخر مرّة

57
00:05:22,460 --> 00:05:24,550
.لا يبدو أنّها تحت سيطرة شيء ما

58
00:05:24,550 --> 00:05:26,330
.أظنّ أنّ الأمر كما قالت فينا

59
00:05:27,190 --> 00:05:31,970
،عندما أتّخذ الخيار الصّحيح"
".سيأتي شخص ما لإخباري

60
00:05:31,970 --> 00:05:33,270
ومن يكون؟

61
00:05:33,270 --> 00:05:34,270
.لا فكرة لديّ

62
00:05:34,270 --> 00:05:34,980
.هكذا إذًا

63
00:05:41,330 --> 00:05:43,070
!هذا مذهل

64
00:05:43,070 --> 00:05:45,030
.لم أرَ أشجارًا كهذه من قبل

65
00:05:45,460 --> 00:05:47,850
!هذا مذهل فعلاً

66
00:05:49,340 --> 00:05:53,790
هذا اللّون ليس من النّوع الّذي
لديه تأثير على جسم الإنسان، صحيح؟

67
00:05:54,390 --> 00:05:56,500
.إن فقد تسوباكي وعيه، سنهرب

68
00:05:56,500 --> 00:05:57,580
.نعم

69
00:06:04,610 --> 00:06:05,800
!هذا مذهل

70
00:06:05,800 --> 00:06:07,220
!إنّها ضخمة

71
00:06:11,070 --> 00:06:13,310
فينا. هل واثقة أنّ هذا هو المكان؟

72
00:06:13,310 --> 00:06:14,870
.نعم، أظنّ ذلك

73
00:06:14,870 --> 00:06:17,460
.لكن لا يوجد هنا سوى الشّلاّلات

74
00:06:18,490 --> 00:06:20,850
إن وُجد شيء ما، فربّما هو خلف الشّلاّلات؟

75
00:06:20,850 --> 00:06:21,980
.لنتحقّق من الأمر

76
00:06:21,980 --> 00:06:22,860
!حان دوركما أيّها النّملتان

77
00:06:22,860 --> 00:06:23,360
!أجل

78
00:06:28,630 --> 00:06:30,530
أيّها في رأيك؟

79
00:06:30,530 --> 00:06:31,910
ربّما هو شلاّل كايدي؟

80
00:06:38,640 --> 00:06:40,250
.كنتِ محقّة

81
00:06:40,250 --> 00:06:41,820
.هيّا بنا

82
00:06:42,140 --> 00:06:44,170
.بكلّ تأكيد

83
00:06:44,730 --> 00:06:47,050
.إنّها متحمّسة للذّهاب بالفعل

84
00:06:49,020 --> 00:06:52,050
!كايدي! أنزل الحبل

85
00:06:56,060 --> 00:06:58,020
...ليس كهفًا آخر

86
00:06:58,020 --> 00:06:59,390
هل نشعل بعض المشاعل؟

87
00:06:59,390 --> 00:07:02,420
سنكون بخير بدونها بمجرّد
.أن تعتاد عيوننا على المكان

88
00:07:11,380 --> 00:07:12,910
أتظنّون أنّ هذه طباشير؟

89
00:07:12,910 --> 00:07:13,910
.لا أدري

90
00:07:13,910 --> 00:07:15,620
!أرى مخرجًا

91
00:07:15,620 --> 00:07:17,080
!المخرج، المخرج

92
00:07:25,230 --> 00:07:27,450
!ما الّذي أنظر إليه؟

93
00:07:29,480 --> 00:07:30,630
...مذهل

94
00:07:30,630 --> 00:07:32,010
...انظروا

95
00:07:32,010 --> 00:07:33,840
.كم هذا مدهش

96
00:07:49,130 --> 00:07:51,450
...الطّريق للأسفل طويل جدًّا

97
00:07:51,450 --> 00:07:52,320
!فينا

98
00:07:52,860 --> 00:07:54,780
إلى أين نذهب تاليًا؟

99
00:07:54,780 --> 00:07:55,990
.ربّما للأسفل

100
00:07:55,990 --> 00:07:57,870
...توقّعت ذلك

101
00:08:07,940 --> 00:08:09,280
.فينا

102
00:08:13,940 --> 00:08:15,140
.ثمّة درجة

103
00:08:17,240 --> 00:08:18,910
!أ-أنا بخير

104
00:08:19,620 --> 00:08:21,680
!كارين! انتظريني

105
00:08:21,680 --> 00:08:23,840
!حسنًا! انتبهي لخطواتك

106
00:08:34,090 --> 00:08:36,160
.يبدو أنّنا وصلنا للقاع

107
00:08:36,400 --> 00:08:38,530
وماذا الآن...؟

108
00:08:38,530 --> 00:08:41,160
فينا! إلى أين نذهب من هنا؟

109
00:08:44,140 --> 00:08:45,790
!من هنا

110
00:08:52,310 --> 00:08:53,800
ما هذا اللّون؟

111
00:08:54,440 --> 00:08:56,720
.إنّه يجعل كلّ شيء يبدو مريبًا

112
00:08:56,720 --> 00:08:59,510
إن كان المكان خطيرًا، فإنّ تسوباكي
.هو أوّل من سيسقط على الأرجح

113
00:08:59,510 --> 00:09:00,760
.وجهة نظر سديدة

114
00:09:00,760 --> 00:09:02,680
.ذلك الفتى حسّاس أكثر من طائر كناري

115
00:09:03,280 --> 00:09:06,190
...هذا اللّون ليس جيّدًا لصحّة المرء

116
00:09:06,660 --> 00:09:09,020
أهذه أطلال قديمة؟

117
00:09:09,020 --> 00:09:11,190
.لا توجد إشارات بوجود أيّ شيء حيّ هنا

118
00:09:11,190 --> 00:09:14,570
.صار حدسك دقيقًا بشكل كبير

119
00:09:14,570 --> 00:09:16,490
.نعم. حتّى أنا لاحظت ذلك

120
00:09:16,490 --> 00:09:18,670
وكأنّ كلّ شيء يصبح أكثر وضوحًا؟

121
00:09:18,670 --> 00:09:22,480
،أظنّ ذلك. منذ أن رسونا على الشّاطئ
.اختفت كلّ شكوكي

122
00:09:25,100 --> 00:09:27,610
ما قصّتكما أنت ويوكيمارو؟

123
00:09:28,640 --> 00:09:31,210
!لا-لا شيء على الإطلاق! لا شيء

124
00:09:31,210 --> 00:09:33,210
.مفهوم

125
00:09:31,210 --> 00:09:33,210
!لا! لا شيء! لا شيء

126
00:09:33,210 --> 00:09:36,220
.حسنًا، فهمت

127
00:09:33,210 --> 00:09:36,220
!لا شيء! لا شيء إطلاقًا، أسمعتِ؟

128
00:09:40,780 --> 00:09:42,180
أذاك هو؟

129
00:09:42,420 --> 00:09:44,670
.نعم. ذلك الجزء الضّيّق هناك

130
00:09:45,530 --> 00:09:47,480
.أعتقد أنّه طريق الدّخول

131
00:09:47,480 --> 00:09:48,810
.الطّريق طويل للأسفل

132
00:09:48,810 --> 00:09:49,960
.نعم

133
00:09:55,500 --> 00:09:57,200
...عفوًا

134
00:09:57,200 --> 00:10:01,810
هيّا يا رفاق! لا يمكنني القفز
!إلى هناك من هذا العلوّ

135
00:10:02,380 --> 00:10:03,910
—ماكابا، أنا لا

136
00:10:03,910 --> 00:10:05,020
.يوكيمارو

137
00:10:05,450 --> 00:10:08,190
هلاّ اهتممتَ بفينا؟

138
00:10:12,480 --> 00:10:14,550
.يا لطيبتك يا ماكابا

139
00:10:14,550 --> 00:10:15,840
.بكلّ تأكيد

140
00:10:15,840 --> 00:10:17,470
ما قصدكما؟

141
00:10:19,440 --> 00:10:20,720
.تشبّثي جيّدًا

142
00:10:20,720 --> 00:10:21,470
!حاضرة

143
00:10:22,070 --> 00:10:25,710
هنالك ما يُنبئني أنّه سيمرّ
.وقت طويل قبل أن ينزلا

144
00:10:32,920 --> 00:10:34,590
.شـ-شكرًا لك

145
00:10:34,880 --> 00:10:37,490
!كايدي! إنجو! انتظراني

146
00:10:37,490 --> 00:10:38,240
...نعم، نعم

147
00:10:38,240 --> 00:10:40,180
.الطّريق أمامك طويل

148
00:10:47,140 --> 00:10:48,620
.هذا هو

149
00:10:49,350 --> 00:10:51,210
أليس هذا سهل أكثر من اللاّزم؟

150
00:10:51,210 --> 00:10:52,880
.معك حقّ

151
00:10:52,880 --> 00:10:54,250
ما قولك؟

152
00:10:57,650 --> 00:10:59,130
فينا؟

153
00:10:59,130 --> 00:11:00,880
.لا تقلقوا

154
00:11:01,530 --> 00:11:03,580
.هيّا بنا

155
00:11:16,540 --> 00:11:20,740
!لا أصدّق عينيّ! هذا المكان موجود فعلاً

156
00:11:21,210 --> 00:11:24,360
هل الكنز المفقود هناك؟

157
00:11:24,360 --> 00:11:25,990
.صحيح

158
00:11:25,990 --> 00:11:29,250
!سيستحقّ هذا العناء أكثر من الوسام

159
00:11:29,250 --> 00:11:33,080
.سأجهّز فرقة للنّزول لليابسة في الحال

160
00:11:42,440 --> 00:11:43,640
ماذا؟

161
00:11:45,030 --> 00:11:47,830
.الكتب هي كلّ ما يوجد على هذه الجدران

162
00:11:49,700 --> 00:11:53,150
!معك حقّ. انظروا لعددها

163
00:11:53,150 --> 00:11:56,520
لكن تبدو جميعها وكأنّها توشك
.على السّقوط إن لمسناها

164
00:11:56,520 --> 00:11:57,730
...لا يعقل

165
00:11:57,730 --> 00:11:59,190
ما الأمر يا كارين؟

166
00:11:59,190 --> 00:12:00,570
.لا يعقل أن تكون كذلك

167
00:12:00,570 --> 00:12:02,150
ماذا تقصدين؟

168
00:12:02,530 --> 00:12:07,950
حسنًا، إن كانت هذه هي المجلّدات
،المائة ألف المفقودة من مكتبة الإسكندريّة

169
00:12:07,950 --> 00:12:09,290
—فسيكون ذلك كنزًا حقيقيًّا

170
00:12:09,290 --> 00:12:10,690
.يا رفاق

171
00:12:31,200 --> 00:12:33,480
هل يفترض بنا فتح هذا؟

172
00:12:33,480 --> 00:12:35,440
.يبدو مختلفًا عن الّذي كان في أورليان

173
00:12:35,950 --> 00:12:37,650
.فينا

174
00:12:37,650 --> 00:12:41,760
.لن نحتاج لأيّ مفاتيح بدءًا من الآن

175
00:12:43,250 --> 00:12:45,070
...الشّيء الوحيد الّذي نحتاج هو

176
00:12:45,710 --> 00:12:47,240
.المهمّة

177
00:12:57,890 --> 00:12:59,950
!ما-ما هذا؟

178
00:14:06,250 --> 00:14:08,070
.مذهل

179
00:14:08,070 --> 00:14:09,660
أهذا معقول؟

180
00:14:41,500 --> 00:14:46,440
أكلّ هذا ذهب؟
!لم أر كلّ هذه الكمّيّة منه من قبل

181
00:14:46,440 --> 00:14:48,740
.أراهن أنّ هنالك ما يكفي لنسبح فيه

182
00:14:49,150 --> 00:14:51,560
أنت عبقريّ! أتريد الغطس فيه؟

183
00:14:51,570 --> 00:14:52,950
!هيّا بنا

184
00:14:52,950 --> 00:14:55,160
!استعداد، قفز

185
00:15:00,680 --> 00:15:02,210
،بمجرّد حفنة كهذه

186
00:15:02,210 --> 00:15:04,590
!سأكون قادرًا على إقامة أفضل زفاف على الإطلاق لهما

187
00:15:06,590 --> 00:15:09,720
أهذه عملة ذهب بندقيّ؟

188
00:15:09,720 --> 00:15:12,470
!هذه عملة غولدن ذهبيّة من هنغاريا

189
00:15:12,470 --> 00:15:15,750
.يبدو أنّ هذا الصّحن مصدره من الشّرق الأقصى

190
00:15:16,110 --> 00:15:19,250
!جميعها من أماكن وأزمنة مختلفة

191
00:15:20,700 --> 00:15:24,050
!يضمّ هذا المكان كنزًا من كلّ أنحاء العالم

192
00:15:39,930 --> 00:15:41,020
فينا؟

193
00:15:42,060 --> 00:15:45,880
أهذا... أهذا هو المكان
الّذي يفترض بي أن أقصده؟

194
00:15:46,650 --> 00:15:51,130
هل هذا فعلاً ما أراد أبي أن أراه؟

195
00:15:51,130 --> 00:15:52,930
ما الّذي ينبئك به حدسك؟

196
00:15:52,930 --> 00:15:54,390
...إنّني

197
00:15:56,360 --> 00:15:57,910
.كلاّ

198
00:16:02,660 --> 00:16:03,900
!فينا

199
00:16:03,900 --> 00:16:05,150
.هذا ليس المكان

200
00:16:05,540 --> 00:16:07,150
ما هو إذًا؟

201
00:16:08,210 --> 00:16:09,840
.يا فينا

202
00:16:19,930 --> 00:16:22,160
—هذا

203
00:16:31,800 --> 00:16:34,930
ما-ما هذا المكان؟

204
00:16:37,820 --> 00:16:39,580
.فينا

205
00:16:58,840 --> 00:17:00,200
فينا؟

206
00:17:00,200 --> 00:17:02,080
!يا فينا

207
00:17:02,080 --> 00:17:03,580
.كانت هنا

208
00:17:04,470 --> 00:17:06,580
.أتت إلى هنا أيضًا

209
00:17:07,480 --> 00:17:10,590
."إينيتيوم"... فينيس"

210
00:17:11,730 --> 00:17:15,090
.إينيتيوم تعني البداية

211
00:17:36,550 --> 00:17:39,740
.خشبة الشّبكيّة

212
00:17:40,760 --> 00:17:42,240
فينا؟

213
00:19:33,290 --> 00:19:37,650
.ارقصي يا عذراء الضّريح

214
00:20:52,280 --> 00:20:54,600
....أكثر من ذهبيّة

