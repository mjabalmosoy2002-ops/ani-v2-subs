1
00:00:06,080 --> 00:00:08,000
أيحدث ذلك كثيرًا؟

2
00:00:08,630 --> 00:00:10,920
زج الأشخاص في السجون بدونِ مُحاكمةٍ؟

3
00:00:11,090 --> 00:00:13,800
مُمكنٌ من الناحية القانونيّة، ولكن نادر الحدوث

4
00:00:14,430 --> 00:00:16,090
ما الذي سيحدُث لـ آش؟

5
00:00:16,260 --> 00:00:17,100
...حسنٌ

6
00:00:17,260 --> 00:00:18,760
كيف الحال، شوينجي؟

7
00:00:19,220 --> 00:00:20,220
!مرحبًا، ماكس

8
00:00:20,390 --> 00:00:22,480
مضى وقتٌ طويل على رؤيتك يا رجُل

9
00:00:22,640 --> 00:00:26,270
يا لك من أحمق لينتهي بك الحال في السجن

10
00:00:27,440 --> 00:00:29,230
لقد سمعتُ بأنك لكمتَ شرطيًا

11
00:00:29,400 --> 00:00:31,400
أتُدرك ما جعلتنا نمرُّ بهِ بسبب ذلك؟

12
00:00:32,360 --> 00:00:34,150
ذلك خطئي

13
00:00:35,450 --> 00:00:38,160
ما كل هذا العبوس، تشارلي؟

14
00:00:39,370 --> 00:00:44,120
هذا ضربٌ من الجنون، فأنا أُعاني الأمرين لحمايةِ نفسي هُنا

15
00:00:45,000 --> 00:00:49,500
ما الذي يسعني فعلهُ ضدّ هولاء الأقوياء من المُجرمين، هاه؟

16
00:00:49,880 --> 00:00:52,050
أعلم ذلك، ولكنّني بحاجةٌ لمُساعدتك

17
00:00:52,210 --> 00:00:54,380
...نعم، ولكن يارجُل

18
00:00:54,720 --> 00:00:55,720
أتوسل إليك

19
00:00:56,300 --> 00:00:58,890
لقد أنقذ حياتي

20
00:00:59,430 --> 00:01:01,600
أتوسل إليك، قُم بحمايتهِ

21
00:02:37,650 --> 00:02:39,400
سجينٌ جديد، تأقلما معًا

22
00:02:44,660 --> 00:02:46,240
أُدعى ماكس لوبو

23
00:02:47,580 --> 00:02:48,500
آش لينكس

24
00:02:49,540 --> 00:02:51,330
تبدو يافعًا، كم هو عُمرك؟

25
00:02:51,500 --> 00:02:53,340
ماذا بشأنك، أيُّها العجوز؟

26
00:02:53,500 --> 00:02:55,590
...عجوز؟ أبلغُ من العُمر 32 عامًا

27
00:02:55,750 --> 00:02:57,840
!إخرس ماكس -
!أيُّها الثرثار -

28
00:02:58,010 --> 00:02:59,380
أسفٌ

29
00:03:00,010 --> 00:03:01,890
32؟
أنتَ عجوزٌ حقًا

30
00:03:02,640 --> 00:03:04,010
أنا في السابعة عشرَ من عُمري

31
00:03:04,930 --> 00:03:07,390
مُقارنةً بك، أيّ شخص سيكون عجوز

32
00:03:09,140 --> 00:03:11,440
من أين أنت؟ ألديك عائلة؟

33
00:03:11,690 --> 00:03:13,150
أنتَ حقًا شخصٌ ثِرثار

34
00:03:13,650 --> 00:03:17,730
صحيح، أسف، أنا في الحقيقةِ صحفيٌّ

35
00:03:18,940 --> 00:03:23,490
ماكس لوبو، هُناك كاتبٌ بهذا الأسم لعامود في صحيفة غرينتش تريبيون.

36
00:03:23,780 --> 00:03:25,700
"كتبَ مقالةً بِعنوان : "73 يومًا في بغداد

37
00:03:25,910 --> 00:03:30,410
نعم! لقد كتبتُ ذلك! هل قرأتها؟

38
00:03:30,580 --> 00:03:34,040
التحقيق الصحفيّ لـ وليام آستر كان أفضل بكثير

39
00:03:34,790 --> 00:03:39,050
من الأفضل لك أن تتوقّف عن كتابة التحقيقات الصحفيّة المُبالغ بها
والتركيز على كتابة مقالات الأعمدة في الصحيفة

40
00:03:39,880 --> 00:03:42,470
هوي، لقد قلتُ ذلك كإطراءٍ لك

41
00:03:42,720 --> 00:03:45,850
الأعمدة التي تكتبها أفضل بكثير من تلك الجرائد التافهة

42
00:03:46,470 --> 00:03:50,480
تبًا، ما خطب هذا الفتى؟
ما قالهُ قد أثرَ بيّ حقًا

43
00:03:51,270 --> 00:03:53,690
على أيّ حال، آش ليس مُجرد رجل عِصابات

44
00:03:53,850 --> 00:03:55,730
لا تستخفَ بهِ

45
00:03:56,150 --> 00:04:00,490
سُحقًا، هذا مُختلفٌ جدًا عمَّ تخيلتهُ

46
00:04:01,110 --> 00:04:06,660
رجل عِصابات معروف يقرأ المقالات السياسيّة وأعمدة الصُحف المحليّة

47
00:04:08,030 --> 00:04:08,870
مهلًا لحظة

48
00:04:09,790 --> 00:04:12,330
إذن ربّما هو سيء في القِتالات

49
00:04:14,330 --> 00:04:18,090
هذا سيجعل من الأمر سهل كفاية، سوف نجلس بهدوء ونقرأ

50
00:04:19,000 --> 00:04:21,050
والمكتبةٌ هُناك

51
00:04:21,260 --> 00:04:22,840
أتُريد إلقاء نظرة؟

52
00:04:24,090 --> 00:04:26,850
لماذا الجميع يُحدّقُ بيّ؟

53
00:04:27,100 --> 00:04:29,560
لأنك سجينٌ جديدٌ هُنا

54
00:04:29,760 --> 00:04:31,600
بالإضافةِ إلى ذلك، أنتَ يافعٌ

55
00:04:36,310 --> 00:04:39,650
من الأفضل لك أنّ لا تتجول لوحدك

56
00:04:39,820 --> 00:04:40,610
لماذا؟

57
00:04:41,900 --> 00:04:43,820
حسنٌ، تعرف ما أقصد

58
00:04:44,280 --> 00:04:48,030
الشبان من أمثالك يُنظَر إليهم كـ"الدُمى" هُنا، إن فهمتَ ما أعني

59
00:04:49,370 --> 00:04:52,120
ويحي، يبدو بأنني أخفتهُ أكثر من اللازم

60
00:04:54,500 --> 00:04:55,960
سيء جدًا؟

61
00:04:56,120 --> 00:04:58,840
مطعم الفقراء الخيريّ يُقدّم أطعمة أفضل من هذا

62
00:04:59,000 --> 00:05:01,550
نعم، ستحتاج لبعض الوقت لكي تعتاد عليهِ

63
00:05:01,710 --> 00:05:02,760
لنجلس هُنا

64
00:05:05,720 --> 00:05:07,340
إنّهُ ظريفٌ جدًا

65
00:05:07,510 --> 00:05:09,140
ربّما سأزورهُ الليلة في زنزانتهِ

66
00:05:09,850 --> 00:05:12,060
لا تتجول وحدك، إتفقنا؟

67
00:05:12,720 --> 00:05:16,060
ماذا عنك؟ أنتَ تتصرّف بطيبةٍ كبيرة معي

68
00:05:16,350 --> 00:05:18,940
ماذا؟ أنا؟ أنتَ مُحق

69
00:05:19,110 --> 00:05:20,900
أنا أُحاول مُساعدتكَ فقط

70
00:05:21,270 --> 00:05:22,610
هوي أنتَ، أيُّها السجين الجديد

71
00:05:22,780 --> 00:05:25,400
أنتَ يافعٌ جدًا، كم عُمرك؟

72
00:05:27,410 --> 00:05:29,990
ماذا؟ أتشعر بالخجل؟

73
00:05:30,160 --> 00:05:32,160
...هوي غارفي، هذا الفتى

74
00:05:32,330 --> 00:05:35,460
لماذا لا تزور زنزانتنا؟

75
00:05:36,160 --> 00:05:38,000
يمكننا أن نحظى بوقتٍ مُمتع

76
00:05:39,420 --> 00:05:41,420
لنكون أصدقاء جيدين

77
00:05:42,500 --> 00:05:45,630
!أبعد يديكَ عني

78
00:05:46,510 --> 00:05:47,800
!أيُّها الشقيّ الصغير

79
00:05:50,470 --> 00:05:52,470
!آش، توقّف

80
00:05:52,930 --> 00:05:53,770
!أيُّها الحُراس

81
00:05:54,100 --> 00:05:55,520
ما الذي يحدث؟

82
00:05:56,060 --> 00:05:58,270
!أتركوني، تبًا

83
00:05:59,020 --> 00:06:00,270
بجديّة؟

84
00:06:01,610 --> 00:06:04,530
تشارلي أنتَ مدينٌ لي بمعروفٍ كبير

85
00:06:06,400 --> 00:06:08,150
فَكر بشأن ما فعلت

86
00:06:13,790 --> 00:06:15,500
أنا لا أستوعب الأمر

87
00:06:15,660 --> 00:06:16,790
ماذا؟

88
00:06:16,960 --> 00:06:19,250
العِقار الذي طلب آش مني تحليلهُ

89
00:06:19,670 --> 00:06:23,550
يتكون أساسًا من دايثيلاميد حمض الليسرجيك

90
00:06:23,710 --> 00:06:25,760
مُخدرٌ قويّ LSD ،بعبارةٍ أخرى

91
00:06:25,920 --> 00:06:27,800
أكانت النتيجة على جميع الفئران مُماثلة؟

92
00:06:27,970 --> 00:06:28,840
نعم

93
00:06:29,800 --> 00:06:34,720
سلوك غير مُنتظم، همجيّة، عدوانيّة، التدمير الذاتيّ

94
00:06:35,520 --> 00:06:37,890
LSD هذا لا يحدث بتعاطي

95
00:06:40,150 --> 00:06:45,530
غريفن، أخشى بأن أخاك الصغير متورطٌ في مأزقٍ كبير

96
00:06:47,610 --> 00:06:51,030
ماذا تعني عبارة : "بنانا فيش"؟

97
00:06:51,280 --> 00:06:54,280
أهو شخصٌ ما؟ أو شفرةٌ من نوعٍ ما؟

98
00:06:54,740 --> 00:06:57,910
ما الذي كان يُخطّط لهُ دينو بحق السماء؟

99
00:06:59,330 --> 00:07:01,920
...أيًّا كانت القضيّة

100
00:07:03,340 --> 00:07:07,460
منذُ أن تم أخذي في الحادية عشر من عُمري
كنتُ أنتظر فرصتي للإنتقام

101
00:07:08,510 --> 00:07:11,680
عليّ مواجهتهُ لكي أتحرّر منه

102
00:07:13,550 --> 00:07:15,180
لن أُسامحهُ أبدًا

103
00:07:15,890 --> 00:07:18,430
قتلُ سكيب وكأنّهُ حشرةٌ ما

104
00:07:19,520 --> 00:07:22,190
لن أخسر أمامهُ، أيًّا كان ما سيفعله

105
00:07:23,190 --> 00:07:24,690
وسوف أنجو

106
00:07:27,780 --> 00:07:28,690
لتخرُج

107
00:07:32,990 --> 00:07:36,330
لقد تعلّمتَ درسك، لتُحسن التصرّف الأن

108
00:07:37,240 --> 00:07:39,080
لقد خرج الشاذ الصغير

109
00:07:41,290 --> 00:07:44,960
أنتَ لا تبدو بحالٍ سيئة لشخص كان في زنزانة الندم

110
00:07:45,750 --> 00:07:47,590
الندم ليس في قاموسي

111
00:07:47,750 --> 00:07:50,720
لم أندم ولا حتّى لمرةٍ في حياتي

112
00:07:52,300 --> 00:07:53,720
يا لهُ من فتى

113
00:07:54,720 --> 00:07:57,760
نعم، لقد تسبّب بالمشاكل في اليوم الأولِ لهُ هُنا

114
00:07:57,930 --> 00:07:59,470
هُناك من يُراقبهُ هُنا

115
00:08:00,230 --> 00:08:03,480
على أيّ حال، إستعجل في التصرّف، أنا أعتمدُ عليك، تشارلي

116
00:08:04,350 --> 00:08:08,320
عليّ إبعاد العِقار عن الطبيب وأخي غريفن

117
00:08:08,650 --> 00:08:10,110
فذلك الشيء خطرٌ عليهم

118
00:08:11,070 --> 00:08:12,150
ولكن كيف؟

119
00:08:12,530 --> 00:08:15,570
على الأرجح هُم يتنصتون على المُكالمات ويقرأون كل الرسائل أيضًا

120
00:08:15,780 --> 00:08:17,280
سُحقًا -
هوي -

121
00:08:18,120 --> 00:08:20,250
لقد إستمتعتُ معكَ في اليوم الماضي، أيُّها الصبيّ

122
00:08:22,120 --> 00:08:25,830
إلى أين ذهب ذلك الفتى؟

123
00:08:26,960 --> 00:08:29,090
هل حدث وأن رأيت آش؟ -
كلّا -

124
00:08:29,380 --> 00:08:30,210
لقد رأيتهُ

125
00:08:30,380 --> 00:08:31,880
حقًا؟ أين؟

126
00:08:32,470 --> 00:08:34,720
ولكن لقد فات الأوان قليلًا على ذلك

127
00:08:35,090 --> 00:08:37,890
لقد ذهب إلى المكتبةِ برفقة غارفي ومن معهُ

128
00:08:41,140 --> 00:08:42,730
كان ذلك مُمتعًا، هاه

129
00:08:42,890 --> 00:08:45,520
ولكن ألم يكُن من المفترض أن تجعلهُ يعترف؟

130
00:08:46,730 --> 00:08:48,900
لدينا الوقت الكافي من أجل ذلك الأمر

131
00:08:49,610 --> 00:08:52,110
هوي ماكس، لِما العجلة؟

132
00:08:52,280 --> 00:08:53,280
أين آش؟

133
00:08:54,780 --> 00:08:57,990
هو يعلم كيفية النجاة في هذا العالم

134
00:08:58,160 --> 00:08:59,030
ماذا تعني بذلك؟

135
00:08:59,780 --> 00:09:02,410
في الحقيقة لقد كان مُطيعًا جدًا

136
00:09:02,580 --> 00:09:05,290
ظنّنتُ بأنّهُ على الأقل سيخوض قتالًا معي

137
00:09:05,460 --> 00:09:07,540
!هذا ليس ما أردتُ سماعه

138
00:09:08,590 --> 00:09:11,300
آش! أين أنت؟

139
00:09:19,100 --> 00:09:20,010
..آش

140
00:09:21,930 --> 00:09:26,060
لم يتعرض لإصاباتٍ بالغة، لا حاجة للقلق

141
00:09:26,690 --> 00:09:29,810
لقد حقنتهُ بمُضادٍ حيويّ ليرتاح اليوم

142
00:09:29,980 --> 00:09:33,070
رأسي يكادُ ينفجر، هلّ لي بمُسكّن؟

143
00:09:33,230 --> 00:09:35,860
رأسك؟ أيًّا كان يا صحاب السموّ

144
00:09:36,030 --> 00:09:40,450
لا أستطيع إبتلاع الحبوب أو المسحوق، فأنا أكرهُ مذاقهما

145
00:09:40,620 --> 00:09:43,700
يا لك من مُتكبر، ما رأيك بذلك؟

146
00:09:44,580 --> 00:09:45,540
شكرًا

147
00:09:45,830 --> 00:09:47,080
إشربهُ

148
00:09:47,250 --> 00:09:51,000
عليّ التأكد من عدم إحتفاظك بالأدوية لإستعمالها كمُخدر

149
00:09:51,210 --> 00:09:52,340
نعم، نعم

150
00:09:52,590 --> 00:09:54,090
ولدٌ مُطيع

151
00:09:56,550 --> 00:09:58,800
لقد أقحمتَ نفسك في ورطةٍ الأن

152
00:09:58,970 --> 00:10:03,520
غارفي ينشر الشائعات حالك، ويقول بأنك لم تُدافع عن نفسك

153
00:10:04,180 --> 00:10:07,560
كانوا يفوقونني عددًا، ولكن لا أستطيع الموت الأن

154
00:10:07,730 --> 00:10:10,020
..حسنٌ، أفهم ذلك ولكن

155
00:10:10,480 --> 00:10:12,150
على أيّ حال، هل أنتَ جائع؟

156
00:10:14,610 --> 00:10:18,240
أُراهن بأنك لا ترغب بأكل هذه الموزة؟ سأكلها عوضًا عنك

157
00:10:19,320 --> 00:10:21,780
كنتُ أمزح معك، إنَّها مُلكك

158
00:10:26,500 --> 00:10:28,000
..بنانا فيش

159
00:10:29,120 --> 00:10:31,000
ماذا قلتهُ للتو؟

160
00:10:32,090 --> 00:10:34,420
أقلتَ بنانا فيش؟

161
00:10:35,090 --> 00:10:36,420
كيف لك معرفة ذلك؟

162
00:10:37,380 --> 00:10:39,800
لماذا أنتَ مُنفعلٌ هكذا؟

163
00:10:40,090 --> 00:10:42,430
إنّها مُجرّد عِبارة في رواية سالينجر

164
00:10:42,800 --> 00:10:46,020
لا تكذب، أنتَ تعلمُ شيئًا ما، صحيح؟

165
00:10:47,680 --> 00:10:50,980
عليكَ إخباري، أتعلم أين هو؟

166
00:10:51,230 --> 00:10:53,270
إلهذا السبب طلب مني تشارلي حمايتك؟

167
00:10:53,440 --> 00:10:55,230
...تشارلي، إذن أنتَ

168
00:10:55,400 --> 00:10:57,360
!أجبني

169
00:10:59,150 --> 00:11:01,660
لقد سألتني إن كنتُ أعرف أين يكون؟

170
00:11:02,490 --> 00:11:04,620
هل بنانا فيش شخصٌ ما؟

171
00:11:05,740 --> 00:11:06,620
نعم

172
00:11:07,120 --> 00:11:10,420
لقد إستغرقتُ 10 أعوام لمعرفة ذلك

173
00:11:11,920 --> 00:11:13,540
الشخص الذي كتبَ المقالة

174
00:11:13,710 --> 00:11:18,380
كان ضابط المخابرات العسكريّة في بغداد من 2005 إلى 2007

175
00:11:18,720 --> 00:11:23,550
ووفقًا لهُ، من غير الواضح ما إذا كانت عبارة بنانا فيش تُمثل هو شخص أو منظمة ما

176
00:11:23,970 --> 00:11:28,430
ولكنها مُرتبطةٌ بطريقةٍ ما بعمليات تهريب المُخدرات (العقاقير)

177
00:11:28,600 --> 00:11:34,020
هذا مُثير، ولكن إن كانت موجودة منذ وقتٍ طويل
لماذا لم نسمع أي إشاعات أو شيء عن هذا الأمر؟

178
00:11:34,190 --> 00:11:35,400
لم أسمع بهذا الأمر من قبل مُطلقًا

179
00:11:35,770 --> 00:11:37,070
هذا كان جلّ الأمر

180
00:11:37,570 --> 00:11:41,950
لقد كتبَ في مقالتهِ بأن جميع الشائعات بشأن ذلك توقّفت بعد عام 2007

181
00:11:42,240 --> 00:11:44,950
وأخيرًا قد حصل على دليل هذا العام، في ولاية لوس أنجلس

182
00:11:45,830 --> 00:11:47,040
أين هو الأن؟

183
00:11:47,290 --> 00:11:49,700
صورتهُ وملفهُ الشخصيّ في آخر صفحة

184
00:11:50,040 --> 00:11:53,290
بعد التقاعد من الجيش، أصبح كاتبًا مُستقلًا

185
00:11:55,040 --> 00:11:57,750
سأذهب لرؤيتهِ حالما أخرج من هُنا

186
00:11:57,920 --> 00:11:59,340
كلّا، لن تفعل

187
00:12:00,050 --> 00:12:01,090
لقد مات

188
00:12:02,050 --> 00:12:03,340
أمام عيناي

189
00:12:04,090 --> 00:12:05,550
ماذا تعني؟

190
00:12:05,720 --> 00:12:10,520
أعتقد بأنّهُ إقترب كثيرًا من كشف الحقيقة بدون أن يعي ذلك

191
00:12:11,020 --> 00:12:13,690
أمرٌ لا يُصدّق

192
00:12:14,650 --> 00:12:17,940
لماذا أنتَ مُهتم بموضوع بنانا فيش، على أيّ حال؟

193
00:12:19,360 --> 00:12:20,900
كان لدي هذا الصديق

194
00:12:21,070 --> 00:12:24,200
كنتُ في العراق منذ عقدٍ من الزمان

195
00:12:24,860 --> 00:12:27,910
وصديقي هُناك أصبح في حالةٍ مُزرية بسبب عِقارٍ سيء

196
00:12:28,280 --> 00:12:29,790
كان شخصًا رائعًا

197
00:12:30,700 --> 00:12:33,080
كان يُحب الشْعر وقد كتب بعض الأشعارِ أيضًا

198
00:12:34,210 --> 00:12:36,420
"...وكانت آخر كلماتهِ هي " بنانا

199
00:12:36,580 --> 00:12:38,130
ما كان اسمهُ؟

200
00:12:38,800 --> 00:12:42,130
ما هو اسمُ صديقك؟

201
00:12:42,470 --> 00:12:44,260
غريفن كالينريس

202
00:12:44,630 --> 00:12:46,890
...كُنا نُناديهِ بـ غريف -
..لابد وأنك -

203
00:12:47,970 --> 00:12:48,970
ماكس غلينرايد

204
00:12:50,310 --> 00:12:52,180
كيف لك أن تعرف اسمي الحقيقيّ؟

205
00:12:54,980 --> 00:12:55,900
إذن هذا أنت

206
00:12:56,980 --> 00:12:59,070
لدي اسمٌ حقيقيّ أيضًا

207
00:12:59,230 --> 00:13:02,030
اسمي الحقيقيّ هو أسلان

208
00:13:03,030 --> 00:13:04,450
أسلان كالينريس

209
00:13:05,700 --> 00:13:09,080
!أ - أنت أخ غريف الأصغر، أسلان

210
00:13:09,410 --> 00:13:13,370
!من كان ليعتقد بأنّني سأقابلك في هذا المكان

211
00:13:14,250 --> 00:13:17,540
ولكن يا إلهي، أنتما مختلفانِ جدًا

212
00:13:17,790 --> 00:13:19,920
أخاك كان شاعرًا هادئًا

213
00:13:20,090 --> 00:13:24,800
نعم، كان يُحب الكتابة، وكان يكتُب لي الكثير من الرسائل

214
00:13:25,050 --> 00:13:26,800
لذا أنا أعلم الكثير بشأنك

215
00:13:27,090 --> 00:13:29,180
...نعم، غريف وأنا، كُنا

216
00:13:29,720 --> 00:13:31,350
لقد أطلقت عليهِ النّار

217
00:13:32,850 --> 00:13:35,060
وتركتهُ هُناك ليموت

218
00:13:35,480 --> 00:13:37,980
...ذلك ليس ما حصل! لقد أطلق

219
00:13:38,690 --> 00:13:40,820
لم يكن أماميّ خيار آخر

220
00:13:41,110 --> 00:13:44,860
لقد جنَّ جنون غريف بسبب ذلك العِقار السيء وحاول قتلنا جميعًا

221
00:13:46,150 --> 00:13:48,280
لقد وثقَ بك

222
00:13:48,820 --> 00:13:50,700
لقد كتبَ عنك كثيرًا

223
00:13:50,870 --> 00:13:53,290
بأنك كنتَ صديقهُ الحقيقيّ الوحيد

224
00:13:55,200 --> 00:13:57,670
لا تزال ساقهُ مشلوله

225
00:13:58,250 --> 00:13:59,830
ولكن لم يكن لديك خيار آخر

226
00:14:01,790 --> 00:14:03,340
ألا يزال غريف حيًّا؟

227
00:14:03,840 --> 00:14:06,590
أين هو؟ دعني أُقابله

228
00:14:07,470 --> 00:14:10,510
!حتّى لو قابلتهُ، فهو لن يتّعرف عليك

229
00:14:11,760 --> 00:14:14,180
!هو لا يمكنهُ التّعرف على أخاهُ حتّى

230
00:14:14,350 --> 00:14:17,850
لقد قلتها بنفسك، بأنّ ذلك العِقار السيء قد أتلف عقله

231
00:14:18,390 --> 00:14:20,610
ومع ذلك، لقد تركتهُ هُناك ليموت

232
00:14:21,690 --> 00:14:25,030
كلّا، لقد تم إرسالهُ للوطن بعد ذلك

233
00:14:25,400 --> 00:14:27,400
...لقد بحثتُ عنهُ في كل مكان، ولكن

234
00:14:27,570 --> 00:14:29,320
!أنتما، أخفضا صوتكما

235
00:14:29,780 --> 00:14:31,070
لتخلدوا إلى النوم

236
00:14:33,790 --> 00:14:36,500
لنخلد إلى النوم ونرتاح

237
00:14:37,000 --> 00:14:37,830
...عندنا أستيقظ

238
00:14:38,790 --> 00:14:40,630
سوف أقتلك

239
00:14:42,460 --> 00:14:43,590
ليلة هانئة، ماكس

240
00:14:44,670 --> 00:14:46,840
لقد أُعجبتُ بأعمدتِكَ

241
00:14:48,720 --> 00:14:50,590
سُحقًا

242
00:14:51,090 --> 00:14:53,680
...لماذا الأن؟ بعد كلِ هذا الوقت

243
00:14:56,310 --> 00:14:57,100
أنتَ تنسحب؟

244
00:14:57,680 --> 00:14:58,810
ماذا تعني بذلك؟

245
00:14:58,980 --> 00:15:01,190
لا يمكنك الإنسحاب الأن

246
00:15:01,350 --> 00:15:02,690
ما الذي يحدث؟

247
00:15:05,020 --> 00:15:06,730
شكرًا على مجئيكَ، إيجي

248
00:15:07,280 --> 00:15:10,820
سُعدتُ بمعرفتي بأنك أردتَ مُقابلتي

249
00:15:11,740 --> 00:15:15,080
...بعد ما حدث لسكيب بسبّبي أنا

250
00:15:15,410 --> 00:15:18,960
لستَ المُخطئ، أيُّها الأحمق

251
00:15:19,210 --> 00:15:22,000
اليابانيون يفكرونَ بطريقةٍ غريبةٍ جدًا

252
00:15:22,210 --> 00:15:23,130
أتظنُّ ذلك؟

253
00:15:23,630 --> 00:15:25,670
يصعب معرفة من هو الأصغر بينهما

254
00:15:26,340 --> 00:15:29,550
لقد سمعتُ بأنك لازلتَ تلتقط الصور

255
00:15:29,970 --> 00:15:31,380
كيف هُم رِجالي؟

256
00:15:32,390 --> 00:15:35,100
في الحقيقة، من الخطر جدًا الإقتراب منهم

257
00:15:35,640 --> 00:15:39,680
على مايبدو بأن أرثر هو الزعيم الأن

258
00:15:39,850 --> 00:15:41,440
لذا أنتَ تعرف كيف تسير الأمور

259
00:15:41,600 --> 00:15:43,350
ذلك الجبان

260
00:15:44,400 --> 00:15:46,110
فهمت

261
00:15:46,650 --> 00:15:52,660
لربّما كنتُ أحقق وُأتابع مسألة بنانا فيش لشعوري بالذنب

262
00:15:53,360 --> 00:15:55,660
ولكن كل ذلك إنتهى الأن

263
00:15:56,620 --> 00:15:58,660
ولكنك كرسّت 10 أعوام من حياتك لذلك الأمر

264
00:16:00,870 --> 00:16:03,040
سأخبر القائد بذلك

265
00:16:04,580 --> 00:16:06,500
إيبي، إيجي، حان وقت المُغادرة

266
00:16:06,670 --> 00:16:07,750
حسنٌ

267
00:16:08,340 --> 00:16:09,630
إعتني بنفسكَ

268
00:16:10,170 --> 00:16:12,260
لا تقلق، ستخرج من هُنا قريبًا

269
00:16:12,510 --> 00:16:13,300
نعم

270
00:16:14,470 --> 00:16:17,140
سُعدتُ بقدومك اليوم، إيجي

271
00:16:17,930 --> 00:16:19,640
...آه، نعم

272
00:16:21,270 --> 00:16:22,810
لتأتي لوحدك في المرّة القادمة

273
00:16:23,440 --> 00:16:25,560
إتفقنا؟ -
لماذا...؟ -

274
00:16:26,230 --> 00:16:27,060
ماذا...؟

275
00:16:42,830 --> 00:16:45,880
أراك لاحقًا، عزيزي، وداعًا

276
00:16:46,290 --> 00:16:48,170
هل أنتَ بخير، إي - تشان؟

277
00:16:48,840 --> 00:16:50,710
عليّ الذهاب لدورة المياه

278
00:16:51,710 --> 00:16:55,180
تلك على الأرجح هي القُبلة الأولى في حياتهِ

279
00:17:04,230 --> 00:17:05,440
شيءٌ ما بداخلها

280
00:17:11,530 --> 00:17:14,740
أعلمُ بأن هذا خطير، ولكن أريدُ منك فعل شيء

281
00:17:15,280 --> 00:17:20,620
إذهب إلى متجر يُدعى تشانغ داي في الحي الصينيّ
ولمقابلة شخص يُدعى شورتر وونغ

282
00:17:21,370 --> 00:17:23,540
وقل بأنّ آش من أرسلك

283
00:17:24,290 --> 00:17:29,710
أخبرهُ بأن يستعيد ما أعطيتهُ للطبيب ميريديث
وأنّ يخبأهُ في مكانٍ آمن

284
00:17:30,460 --> 00:17:35,090
كنُ حذِرًا، لا تدع أحد يعلم بشأن ذلك

285
00:17:37,890 --> 00:17:39,600
سأخرج لبرهةٍ من الوقت

286
00:17:40,260 --> 00:17:42,890
حسنٌ، ولكن كُن على حذر

287
00:17:43,430 --> 00:17:44,430
سأفعل

288
00:17:44,680 --> 00:17:46,440
سامحني، إيبي - سان

289
00:17:48,020 --> 00:17:49,940
هلّا أحضرت لي معك المُثلجات؟

290
00:17:50,940 --> 00:17:53,190
حـ - حسنٌ، بالطبع

291
00:17:54,110 --> 00:17:55,440
شابٌ أسيويّ؟

292
00:17:55,900 --> 00:17:56,990
لقد ذهب لرؤية آش؟

293
00:17:57,200 --> 00:17:59,200
مع مُحقق من شرطة المدينة

294
00:18:01,240 --> 00:18:03,120
أتعلم من يكون؟

295
00:18:03,290 --> 00:18:06,960
آش لن يُقابل أيّ شخص من أجل الدردشةِ فقط

296
00:18:07,540 --> 00:18:10,250
أيُّها الأب دينو، دعني أتولى هذه المسألة

297
00:18:10,920 --> 00:18:12,800
غارفي يأخذُ وقتهُ الكافي، صحيح؟

298
00:18:13,840 --> 00:18:16,220
،إذن، بدلًا من لينكس

299
00:18:16,880 --> 00:18:19,550
سوف أُحضر لك شابًا أسيويًّا ظريفًا

300
00:18:21,800 --> 00:18:23,180
الحي الصينيّ، هاه؟

301
00:18:23,930 --> 00:18:26,180
لقد سمعتُ بأن المكان خطرٌ هُنا

302
00:18:26,890 --> 00:18:29,440
لا أستطيع التراجع الأن

303
00:18:32,270 --> 00:18:33,570
ذلك مُضحك

304
00:18:34,190 --> 00:18:36,030
يجدر بالمتجر أن يكونَ هُنا

305
00:18:37,780 --> 00:18:41,780
مرحبًا، أنا أبحث عن متجر يُدعى تشانغ داي

306
00:18:41,990 --> 00:18:43,330
ومن تكون؟

307
00:18:43,950 --> 00:18:45,620
وما غرضك من ذلك؟

308
00:18:45,790 --> 00:18:46,580
...أنا، آه

309
00:18:47,120 --> 00:18:48,830
..أردتُ فقط... أمم

310
00:18:49,460 --> 00:18:51,380
أنا أبحث عن شخص يُدعى شورتر وونغ

311
00:18:51,710 --> 00:18:53,460
آش لينكس من أرسلني

312
00:18:54,050 --> 00:18:55,000
آش أرسلك؟

313
00:18:55,500 --> 00:18:57,010
شورتر ليس هُنا

314
00:18:57,170 --> 00:19:00,050
أتباع أرثر يُلاحقونهُ للإطاحةِ بهِ

315
00:19:01,340 --> 00:19:04,260
تشانغ داي في تلك الزاوية بجانب متجر الحِلاقة

316
00:19:04,760 --> 00:19:05,560
شكرًا

317
00:19:10,810 --> 00:19:11,900
مائدةٌ لشخصٍ واحد؟

318
00:19:12,900 --> 00:19:14,440
هاه؟ آه، نعم

319
00:19:14,610 --> 00:19:16,150
تفضل بالجلوس في المكان الذي يحلو لك

320
00:19:19,650 --> 00:19:21,990
...لم آتي إلى هُنا لتناول الطعام، ولكن

321
00:19:22,950 --> 00:19:25,790
تفضل، هذا من أجلك، على حِساب المطعم

322
00:19:25,950 --> 00:19:28,910
أُدعى تشانغ، وأنا مالك المطعم

323
00:19:29,410 --> 00:19:31,460
أنتَ هُنا لسؤال عن أمرٍ ما، أيُّها الفتى؟

324
00:19:31,960 --> 00:19:34,960
أنا أبحث عن شورتر وونغ

325
00:19:35,420 --> 00:19:38,670
لدي أمرٌ هام عليّ إخبارهُ بهِ

326
00:19:39,550 --> 00:19:41,630
حسنٌ، هذا مؤسف

327
00:19:42,430 --> 00:19:43,930
هو ليس متواجدٌ هنا الأن

328
00:19:44,390 --> 00:19:46,640
ولا أحد يعلم بمكانهِ

329
00:19:47,890 --> 00:19:49,020
فهمت

330
00:19:49,560 --> 00:19:52,480
إذن هل تعلم طبيب يُدعى ميريديث؟

331
00:19:56,270 --> 00:19:58,610
ظنّنتُ بأنني سأجدُ أحدهما على الأقل

332
00:19:59,070 --> 00:20:01,570
سيخيبُ ظنّ آش بي كثيرًا

333
00:20:02,700 --> 00:20:06,450
لا أستطيع تخيبَ ظنّهِ، سأذهب إلى الطبيب بنفسي

334
00:20:12,330 --> 00:20:14,170
ما الذي تُحدّق بهِ؟

335
00:20:17,000 --> 00:20:18,460
قُل شيئًا

336
00:20:18,840 --> 00:20:21,170
إن كنتَ تحتقرني، فقُلها وحسب

337
00:20:22,010 --> 00:20:22,970
هل تستمعُ إلي؟

338
00:20:25,760 --> 00:20:26,680
ماذا؟

339
00:20:27,760 --> 00:20:29,930
لا تنظر إلى بهذه الطريقة

340
00:20:30,390 --> 00:20:33,850
توقّف، لا تنظر إلي كما كان ينظر لي آخاك

341
00:20:34,350 --> 00:20:35,940
!توقّف

342
00:20:40,280 --> 00:20:42,740
إخرس، لوبو -
ما الذي يحدث؟ -

343
00:20:43,900 --> 00:20:47,200
...أ - أنا آسف، لم أعني أن

344
00:20:48,330 --> 00:20:51,120
سأطلب من الحُراس تغير زنزانتي

345
00:20:51,290 --> 00:20:53,210
سيكون ذلك الحل الأفضل لنا

346
00:20:54,710 --> 00:20:57,960
إن كنتَ تُريد قتلي، فتفضل بذلك

347
00:20:58,790 --> 00:21:00,460
لقد إكتفيتُ من كلِ هذا

348
00:21:01,550 --> 00:21:03,010
ليلة هائنة، آش

349
00:21:12,180 --> 00:21:14,640
..أرجو المعذرة، أردتُ السؤال عن

350
00:21:16,810 --> 00:21:18,230
كنتُ بإنتظاركَ

351
00:21:18,980 --> 00:21:20,520
يا فتى الساموراي