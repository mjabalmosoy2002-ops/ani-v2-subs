1
00:00:08,500 --> 00:00:09,340
آش

2
00:00:10,960 --> 00:00:11,840
سينغ

3
00:00:12,420 --> 00:00:14,050
هذا سيء

4
00:00:14,760 --> 00:00:16,430
إلى أين ستأخذهم؟

5
00:00:16,600 --> 00:00:19,560
لو كنتُ مكانك لقلقتُ على نفسي أولًا

6
00:00:20,390 --> 00:00:25,350
لا تقلق بشأنهم، الطبيب مانيرهايم سوف يعتني بهم جيدًا

7
00:00:25,850 --> 00:00:26,940
ماذا؟

8
00:00:27,110 --> 00:00:28,860
أسرعوا -
!كونغ -

9
00:00:29,780 --> 00:00:32,610
لا يجب على الجنود معاملة الرهائين هكذا

10
00:00:33,320 --> 00:00:37,120
مؤسفٌ للغاية، ولكن القوانين الدوليّة لا تنطبق علينا

11
00:00:37,990 --> 00:00:41,290
نحنُ ليس لنا "وجود" كما تعلم

12
00:00:43,290 --> 00:00:44,870
سوف أتبع الشاحنة

13
00:00:47,000 --> 00:00:49,880
والآن، لتأخذوا اِبن السيّد دينو إلى الداخل

14
00:00:50,710 --> 00:00:52,460
أرغبُ بالتحدث معهُ

15
00:00:53,010 --> 00:00:54,880
لا يوجد ما نتحدّث عنه

16
00:00:55,300 --> 00:00:57,220
سوف تُغيّر رأيك

17
00:02:28,770 --> 00:02:32,480
بالتفكير بأنّك قتلت العديد من رجالي المُحنَّكين

18
00:02:32,650 --> 00:02:35,690
شابٌ صغير ذو وجهٍ بريء

19
00:02:42,570 --> 00:02:44,990
أنتَ تشبه الفهد

20
00:02:45,870 --> 00:02:50,290
شيطانُ الغابةِ البري، والذي يُسبب الرعب لقاطني الغابات

21
00:02:50,620 --> 00:02:53,460
ولكنهُ رشيقٌ وجميل

22
00:02:54,540 --> 00:02:58,170
أولئك الذين يكرهونني يُلقبونني بـ الشّيطان، حاصد الأرواح، أيًّا كان

23
00:02:58,920 --> 00:03:01,680
ولكن أنت، لن أسمح لك بأنّ تُلقبني

24
00:03:02,340 --> 00:03:06,770
أنا لا أقتلع أعين الناس وهُم أحياء

25
00:03:09,520 --> 00:03:12,730
لماذا تُقاوم السيّد؟

26
00:03:12,980 --> 00:03:16,020
أنتَ شابٌ جميل وموهوب

27
00:03:16,440 --> 00:03:18,860
يمكنك أنّ تحصل على أيّ ما تشاء

28
00:03:19,360 --> 00:03:20,900
أيّ شيء؟

29
00:03:21,280 --> 00:03:25,160
فقط على جدول أعمالهِ، ليس لي أيُّ شأن

30
00:03:26,280 --> 00:03:29,160
لماذا لا تنضم إلي، آش؟

31
00:03:30,540 --> 00:03:35,380
إن أصبحت رئيس المُنظمة، سوف ينحني العالم لك

32
00:03:36,250 --> 00:03:41,760
سوف أتولى أمر الأعمال المشبوهةِ
لكي لا تتلطخ يداك

33
00:03:42,550 --> 00:03:45,800
اِنضم إلي، والعالم سيصبح مُلكنا

34
00:03:48,060 --> 00:03:49,390
هل أنتَ جاد؟

35
00:03:50,520 --> 00:03:55,560
أفضل تقبيل بزاقة على أن أتعاون معك

36
00:03:58,650 --> 00:04:02,490
لا ينبغي على اِبنُ رجلٍ بارز أن يتكلم بهذه الطريقة

37
00:04:03,160 --> 00:04:07,990
لاحظتُ بأنّ السيّد يمتلك ورقة رابحة ضدّ الحكومة الأمريكيّة

38
00:04:08,700 --> 00:04:11,290
أنتَ تعلم ما هي، صحيح؟

39
00:04:13,290 --> 00:04:17,670
المنظمة الكورسيكيّة إخترقت وبعمق قلب الحكومة الأمريكيّة

40
00:04:18,130 --> 00:04:19,920
لا بدّ من وجود أمرٍ ما وراء ذلك

41
00:04:21,380 --> 00:04:25,390
سوف تخبرني بذلك، أليس كذلك؟ كدليل على تعاوننا

42
00:04:25,800 --> 00:04:29,140
لا بدّ وأنك تُمازحني، أنتَ مجنون

43
00:04:29,350 --> 00:04:34,600
أنا أتفهم جيدًا بأن هذا العنف العادي
لن يُجدي نفعًا معك

44
00:04:34,770 --> 00:04:39,940
لقد حاولت الهرب من السيّد
لأنك إعتدت أن تكون دميتهُ الجنسيّة

45
00:04:40,900 --> 00:04:44,910
وأنتَ تعلم بأنّه سوف يتحكّم بك من جديد إذا عُدتَ إليه

46
00:04:46,410 --> 00:04:49,450
سوف تستسلم ركبتاك، ولن تكون قادر على الحِراك

47
00:04:50,120 --> 00:04:52,750
لا زلت ضعيف إتجاه تلك اللعنة

48
00:04:53,580 --> 00:04:56,420
!توقّف، أبعد يداك عني

49
00:04:57,380 --> 00:04:59,540
والآن، هل أنتَ مُستعد للتكلم؟

50
00:05:01,670 --> 00:05:03,670
أمثالك دومًا يتصرّفون هكذا

51
00:05:04,470 --> 00:05:07,300
أنتَ تُسيطر على الآخرين عن طريق سحقهم قسرًا

52
00:05:08,220 --> 00:05:09,600
إفعل ما يحلو لك

53
00:05:09,890 --> 00:05:12,060
ولكن لا أحد يستطيع السيطرة عليّ

54
00:05:12,680 --> 00:05:14,060
لن أنحني لك أبدًا

55
00:05:14,810 --> 00:05:17,690
سوف أُقاومك بكامل روحي

56
00:05:18,610 --> 00:05:19,940
حسنٌ إذن

57
00:05:20,400 --> 00:05:22,730
كما ترغب

58
00:05:25,360 --> 00:05:26,990
هناك إثنين من الحُرّاس في الخارج

59
00:05:27,740 --> 00:05:28,740
واربعةٌ في الداخل

60
00:05:29,240 --> 00:05:32,870
علينا التواصل مع آش واتخاذ الإجاراءات اللازمة من الداخل والخارج

61
00:05:37,580 --> 00:05:39,830
أنتَ عنيدٌ جدًا

62
00:05:40,090 --> 00:05:40,920
ماذا؟

63
00:05:41,420 --> 00:05:42,880
اِتصال من السيّد

64
00:05:43,460 --> 00:05:45,130
حسنٌ، أنا قادم

65
00:05:45,800 --> 00:05:49,720
سوف تستسلم لي يومًا ما، لا تنسى ذلك

66
00:05:50,600 --> 00:05:54,720
راقبوه، وانتقموا منه إذا رغبتم

67
00:05:55,430 --> 00:05:59,270
ولكن لا تقتلوه، فهو يُمثل سلعةً ثمينة

68
00:06:02,230 --> 00:06:06,860
لا زلتَ واقعًا على الأرض، لا بدّ وأنك حظيت ببعض الحُب من الكولونيل

69
00:06:08,780 --> 00:06:10,240
أهذا كل شيء؟

70
00:06:10,660 --> 00:06:12,330
لقد أطاح بك جيدًا

71
00:06:12,490 --> 00:06:14,580
لتشرب بعض الماء

72
00:06:14,740 --> 00:06:17,870
اِبن السيّد الغني، هاه؟

73
00:06:18,290 --> 00:06:20,540
أنتَ لست سوى عاهر

74
00:06:29,470 --> 00:06:30,300
!هيَّا، سينغ

75
00:06:31,680 --> 00:06:32,600
تبًا

76
00:06:34,890 --> 00:06:36,390
تراجع، كولونيل

77
00:06:37,020 --> 00:06:38,850
العدوّ يُهاجم، العدد مجهول

78
00:06:39,020 --> 00:06:41,400
تبًا، ليس الآن

79
00:06:44,150 --> 00:06:47,570
لا يُصدّق، بعد كل ذلك الضرّر الذي ألحقتهُ بهِ

80
00:06:47,990 --> 00:06:49,070
!واجهني، فوكس

81
00:06:50,320 --> 00:06:53,620
سوف نلتقي مُجدّدًا، آش، لا تنسى ما قلتهُ لك

82
00:06:57,290 --> 00:06:59,920
آش، أنت بأمان

83
00:07:01,170 --> 00:07:02,960
أيُّها الحمقى، لماذا عُدتم؟

84
00:07:03,840 --> 00:07:05,170
علينا الخروج من هُنا

85
00:07:13,010 --> 00:07:15,760
سوف نكون بمأمنٍ هُنا

86
00:07:19,180 --> 00:07:20,810
هل أنتَ بخير؟

87
00:07:21,440 --> 00:07:22,560
أريني جراحك

88
00:07:24,860 --> 00:07:25,860
ما الخطب؟

89
00:07:28,440 --> 00:07:31,030
أسف، إنّهُ لا شيء

90
00:07:33,910 --> 00:07:35,490
أحتاج لبعضٍ من الراحةِ فقط

91
00:08:04,940 --> 00:08:06,980
ها نحنُ ذا

92
00:08:07,480 --> 00:08:08,440
!سينغ -
!كاين -

93
00:08:10,490 --> 00:08:12,900
لقد كُنا ننتظرك، أيُّها الزعيم -
!أيُّها الزعيم -

94
00:08:13,530 --> 00:08:15,700
أين ويلي ويانغ؟

95
00:08:15,870 --> 00:08:18,620
لقد قُبِضَ عليهما وعشرةٌ أخرين من رجالنا

96
00:08:18,790 --> 00:08:19,660
ماذا؟

97
00:08:20,000 --> 00:08:21,250
أعلم أين أخذوهم

98
00:08:22,210 --> 00:08:24,170
المركز الوطني للسلامة العقليّة

99
00:08:24,330 --> 00:08:26,630
إن كنتَ تعلم، لماذا لم تُساعدهم؟

100
00:08:27,380 --> 00:08:29,000
لقد قُبِضَ عليّ أيضًا

101
00:08:29,880 --> 00:08:31,800
سينغ وكاين من أنقذاني

102
00:08:31,970 --> 00:08:35,050
لقد تركت رجالك للموت وأنقذتهُ عوضًا عنهم؟

103
00:08:35,220 --> 00:08:36,970
لم يكن أماميّ خيار آخر

104
00:08:37,390 --> 00:08:40,640
كان هُناك أكثر من 20 جندي مُحترف

105
00:08:40,810 --> 00:08:43,690
لو حاولنا إنقاذهم لقُبِضَ علينا أيضًا

106
00:08:44,390 --> 00:08:48,310
منذ متى وأصبحت تابعًا لآش، كاين؟

107
00:08:48,480 --> 00:08:50,070
ماذا قلت؟ -
...أيُّها -

108
00:08:50,230 --> 00:08:52,280
لا تتظاهر بخلاف ذلك

109
00:08:52,440 --> 00:08:55,110
أن يتم التأمّر عليك من قِبل شابٍ أبيض هكذا

110
00:08:55,700 --> 00:08:58,490
كرر قول ذلك -
أنتَ ترغب بأن نلقنك درسًا -

111
00:08:58,950 --> 00:09:02,250
هوي، هذا ليس الوقت المُناسب

112
00:09:02,790 --> 00:09:03,750
يكفي ذلك، لاو

113
00:09:04,040 --> 00:09:06,420
أتركني، سينغ، لا يمكنني تحمّل الأمر أكثر من هذا

114
00:09:06,580 --> 00:09:07,420
آش

115
00:09:07,580 --> 00:09:11,710
ما الذي كنتَ تفعلهُ على أيّ حال
إنقاذ آش عوضًا عن رجالك؟

116
00:09:11,880 --> 00:09:13,970
أتُسمي نفسك زعيم؟ -
!كرر قول ذلك -

117
00:09:14,130 --> 00:09:16,090
لا تنسى -
لا شيء أفضل للقيام بهِ؟ -

118
00:09:18,600 --> 00:09:19,680
اِفعل ما تُريد

119
00:09:20,390 --> 00:09:22,600
ولكن لا تعترض طريقي بعد الآن

120
00:09:23,850 --> 00:09:27,690
إنّهُ مُحق، إن لم تكن جادًا حيال هذا فالتخرج

121
00:09:29,360 --> 00:09:31,440
لقد وضحتُ لك الأمر بالفعل

122
00:09:31,980 --> 00:09:34,030
توقّف عن إفتعال الشِجار مع آش

123
00:09:34,440 --> 00:09:37,320
أنتَ هو زعيمنا وليس هو

124
00:09:37,780 --> 00:09:40,620
هو في مستوى مختلف تمامًا

125
00:09:41,120 --> 00:09:45,460
لا يمكنني أن أجعل الجميع يهدأ ببضعةِ كلماتٍ كما يفعل هو

126
00:09:46,460 --> 00:09:49,670
أولئك الذين يتمتعون بالقوّة يتولون السلطة، أمرٌ منتهي

127
00:09:49,830 --> 00:09:52,460
لم يكن شورتر خاضعًا لآش أبدًا

128
00:09:52,880 --> 00:09:56,420
نعم، لكونهم أصدقاء مُقربين

129
00:09:56,800 --> 00:10:00,100
لقد سئمت مُقارنتي بشخص ميت بالفعل

130
00:10:01,600 --> 00:10:06,180
أريد منك فقط أن تصبح ملك الداون تاون

131
00:10:06,730 --> 00:10:10,770
اخرس! لا يهم من هو الزعيم

132
00:10:11,110 --> 00:10:15,360
على أيّ حال سوف يتم استنزافنا من قبل عشيرة لي وعصابة غولزين

133
00:10:15,740 --> 00:10:19,490
إن لم نُقاتل الآن، فسوف نكون وإلى الأبد أدواتٍ مُستهلكة

134
00:10:21,660 --> 00:10:24,240
حسنٌ، اِفعل ما تُريد

135
00:10:24,660 --> 00:10:28,040
ولكن لن أنحني لآش لينكس أبدًا

136
00:10:28,620 --> 00:10:32,290
لن أعترف بهِ أبدًا، مهما قلت

137
00:10:33,290 --> 00:10:34,550
لاو، إلى أين أنتَ ذاهب؟

138
00:10:35,340 --> 00:10:36,460
!لاو

139
00:10:37,670 --> 00:10:38,800
تبًا

140
00:10:40,260 --> 00:10:43,760
أُتسمي نفسك زعيمًا، صحيح؟

141
00:10:44,010 --> 00:10:45,180
كلّا

142
00:10:45,890 --> 00:10:48,770
لقد عاد أليكس، رافقني إن كنت معنا

143
00:10:48,940 --> 00:10:49,770
آش

144
00:10:51,520 --> 00:10:55,650
هل ندمت يومًا على كونك أصبحت زعيمًا؟

145
00:10:57,820 --> 00:10:58,990
طيلة الوقت

146
00:11:02,320 --> 00:11:03,740
لن أفعل ذلك بعد الآن

147
00:11:04,490 --> 00:11:08,200
لماذا عليّ قتل ذلك الصبيّ الصغير؟

148
00:11:08,500 --> 00:11:12,170
لأنك بالمُقابل ستُنقذ حياة صديقك الغالي سينغ

149
00:11:12,330 --> 00:11:14,000
هل نسيت بالفعل؟

150
00:11:14,420 --> 00:11:17,960
لا أستطيع قتل شخص لم يقترف أيّ ذنب

151
00:11:18,130 --> 00:11:20,680
...لا بأس إن طلبت مني قتل آش، ولكن

152
00:11:21,550 --> 00:11:24,760
يؤسفني قول هذا، ولكنك تفتقر للإمكانيات اللازمة لفعل ذلك

153
00:11:25,720 --> 00:11:26,890
ولكن لا بأس

154
00:11:27,850 --> 00:11:30,640
سأجعلك تفعل أمور أخرى من أجلي

155
00:11:32,190 --> 00:11:33,060
...إيجي أوكومورا

156
00:11:34,150 --> 00:11:36,770
لم يعد من شأنك

157
00:11:37,190 --> 00:11:39,490
أنت تظاهر بعدم معرفتك بأيّ شيء وحسب

158
00:11:40,490 --> 00:11:41,910
أيًّا كان ما سيحدث

159
00:11:44,530 --> 00:11:46,280
لا يزال لدينا إثنين آخرين من العقارب

160
00:11:47,450 --> 00:11:50,620
بخلاف لاو، يعرفان مصلحتهما جيدًا

161
00:11:51,120 --> 00:11:52,500
سوف يفعلانِ أيّ شيء

162
00:11:54,210 --> 00:11:56,130
تبدو قلقًا، بلانكا

163
00:11:56,670 --> 00:11:59,300
أشعر بالفضول وحسب

164
00:11:59,550 --> 00:12:02,930
لماذا تكره إيجي أوكومورا لهذا الحدّ؟

165
00:12:04,180 --> 00:12:07,600
أنت تراهُ كنقطةِ ضُعفِ آش أيضًا، أليس كذلك؟

166
00:12:08,770 --> 00:12:09,600
كنتُ كذلك

167
00:12:10,350 --> 00:12:11,770
لا تراهُ بنفس الطريقة الآن؟

168
00:12:12,850 --> 00:12:16,060
لستُ متأكدًا بعد الآن

169
00:12:17,150 --> 00:12:20,990
من الأفضل لآش أن يعود إلى السيّد

170
00:12:22,110 --> 00:12:24,530
أريد رؤية آش يحكم كشّيطانٍ عظيم

171
00:12:25,240 --> 00:12:27,950
وحشٌ حقيقيّ بلا قلب

172
00:12:29,370 --> 00:12:33,750
ذلك طموحي في الحياة
أن أُقاتل بكل ما لدي ضدّ وحشٍ مثله

173
00:12:34,620 --> 00:12:37,710
لا يسعني تركهُ يلعب لعبة الأصدقاء كالأحمق

174
00:12:38,880 --> 00:12:40,510
هو يُشكل عائق

175
00:12:42,470 --> 00:12:44,760
أنا وحشٌ أيضًا، بلانكا

176
00:12:47,180 --> 00:12:48,010
طابت ليلتك

177
00:12:51,470 --> 00:12:54,100
أرى بأن أعمال التشييد تسير بسلاسة

178
00:12:54,480 --> 00:12:58,480
نعم، أنظمة المراقبة ستكون خالية من العيوب بلمح البصر

179
00:12:59,650 --> 00:13:02,400
لا يوجد شيء في العالم خالٍ من العيوب

180
00:13:02,570 --> 00:13:05,360
ليس طالما مصنوعٌ من قِبل البشر

181
00:13:06,110 --> 00:13:09,620
ولكن هذا نظامُ مُراقبةٍ مميز

182
00:13:09,780 --> 00:13:14,120
السجناء هُنا جميعهم مجرمون عنيفون

183
00:13:15,870 --> 00:13:16,920
أحقًا ذلك

184
