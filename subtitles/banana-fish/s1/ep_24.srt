204
00:16:27,270 --> 00:16:29,610
تفضّل إن كنتَ ترغب بأن تُحرق حتّى الموت

205
00:16:30,190 --> 00:16:32,150
كنتَ تُراقبنا، صحيح؟ -
نعم -

206
00:16:32,320 --> 00:16:35,620
تبًا لك، لماذا لم تُنقذنا وحسب

207
00:16:36,660 --> 00:16:39,240
حسبتُ بأنك تُريد إنهاء الأمور على طريقتك

208
00:16:40,040 --> 00:16:41,620
لا بدّ وأنّهُ راضٍ أيضًا

209
00:16:49,710 --> 00:16:52,380
ما تم كشفهُ مُؤسفٌ جدًا

210
00:16:52,550 --> 00:16:55,680
نتمنى أن نكشف طيّات هذه القضيّة بأسرع وقت ممكن

211
00:16:56,010 --> 00:17:02,600
أخبار غير مسبوقة بشأن المسؤولين الحكوميين
يقومون بشراء الجنس من الفتيان في سن المراهقة

212
00:17:03,310 --> 00:17:06,520
قد تستدعي الهيئة سمايلز للمثول أمام المحكمة

213
00:17:08,440 --> 00:17:10,900
ما الخطب؟ ألا تزال جروحك تؤلمك؟

214
00:17:12,440 --> 00:17:13,320
...كلّا

215
00:17:14,320 --> 00:17:16,200
أتُفكر بشأن آش؟

216
00:17:17,070 --> 00:17:19,490
لا تقلق، فهو آش

217
00:17:28,500 --> 00:17:29,840
...آش

218
00:17:35,470 --> 00:17:37,260
اِسمح لهم بالدخول -
...ولكن -

219
00:17:37,430 --> 00:17:38,840
!لقد قلت، أدخلهم

220
00:17:39,010 --> 00:17:40,680
اِهدأ، أيُّها السكير

221
00:17:42,520 --> 00:17:43,980
إنهم خطرون، سيّدي

222
00:17:44,140 --> 00:17:45,520
لقد قلت، أُغرب عن وجهي

223
00:17:46,060 --> 00:17:49,770
يا لهُ من طاغية، سوف يتعرض للتسمم يومًا ما

224
00:17:50,690 --> 00:17:53,360
للأسف، سأكشف ذلك مُسبقًا

225
00:17:53,820 --> 00:17:55,780
لدي خبرة كبيرة في ذلك

226
00:18:03,160 --> 00:18:06,040
تفضل، لديك الحق في ذلك

227
00:18:07,750 --> 00:18:09,790
ألهذه الدرجة ترغب بالموت؟

228
00:18:11,090 --> 00:18:12,420
لقد سمعتُ من بلانكا

229
00:18:13,210 --> 00:18:15,590
أنا أفهم لماذا تكره أخوتك

230
00:18:16,420 --> 00:18:17,550
ذلك الثرثار

231
00:18:18,720 --> 00:18:20,430
أتفهم مشاعرك

232
00:18:20,760 --> 00:18:21,970
!وكأن بمقدورك ذلك

233
00:18:22,140 --> 00:18:23,390
!...أنا

234
00:18:24,310 --> 00:18:29,440
لقد وثقتُ بأنك لن تفترس أخوتنا الصينيّين

235
00:18:29,730 --> 00:18:31,770
ليس مثلما فعلت مع أخوتك عديمي القيمة

236
00:18:32,650 --> 00:18:37,280
ولكنك تحالفت مع غولزين واستغليت لاو لقتل إيجي

237
00:18:38,240 --> 00:18:41,410
لم تستطع أن تغفر لآش لأنّهُ فتح قلبهُ لإيجي

238
00:18:41,910 --> 00:18:45,490
لأن آش عثر ما لا يمكنك العثور عليهِ أبدًا

239
00:18:46,410 --> 00:18:48,620
كنتُ تشعر بالغيرةِ وحسب

240
00:18:57,590 --> 00:19:00,010
توقّف عن التشبث بماضيك

241
00:19:00,680 --> 00:19:04,930
مهما كان مقدار كرهك لهم، لا تزال دماء عشيرة "لي" تجري في عروقك

242
00:19:06,310 --> 00:19:08,140
لن أغفر لك أبدًا

243
00:19:08,980 --> 00:19:14,770
ولكن الحيّ الصينيّ في حالةٍ من الفوضى! ليس من الأمان حتّى التجول في وضح النهار

244
00:19:15,860 --> 00:19:18,940
سوف تعيش وتدفع ثمن ما فعلتهُ

245
00:19:19,490 --> 00:19:21,450
وستُعيد السلام إلى الحيّ الصينيّ

246
00:19:24,580 --> 00:19:27,750
لا أملك الإمكانيات لذلك

247
00:19:28,750 --> 00:19:30,830
لهذا السبب سوف أقدّم لك العون

248
00:19:31,250 --> 00:19:35,090
توقّف عن كرهِ نفسك، لن يصلك ذلك إلى أيّ مكان

249
00:19:35,540 --> 00:19:37,590
الأمر ليس بهذه السهولة

250
00:19:38,260 --> 00:19:41,840
السبب الوحيد في عيشي هو لأستمر في كره أخوتي

251
00:19:42,720 --> 00:19:46,060
بدون ذلك، لما كنتُ سأصل إلى ما وصلتُ إليهِ أبدًا

252
00:19:47,890 --> 00:19:50,020
لقد إنتقمتَ لوالدتك

253
00:19:50,520 --> 00:19:51,770
أليس ذلك كافيًا؟

254
00:19:53,810 --> 00:19:55,730
أنا لا أكرهك

255
00:19:58,610 --> 00:20:02,320
لسببٍ ما، لا يسعني إجبار نفسي على كرهك

256
00:20:03,200 --> 00:20:04,530
أنت مجروح

257
00:20:05,450 --> 00:20:09,290
قلبُك ينزف، حتّى الآن

258
00:20:10,250 --> 00:20:13,000
أنتَ تشبه آش من هذه الناحية

259
00:20:17,920 --> 00:20:21,010
يا إلهي، توقّف عن البكاء كالفتيات

260
00:20:21,300 --> 00:20:24,890
حسنٌ أسف عن كوني أنثوي من الداخل أيضًا

261
00:20:25,220 --> 00:20:27,350
أنتَ حقًا تُثير أعصابي

262
00:20:27,510 --> 00:20:30,180
!إذن لتتركني وحدي -
آوه، با الله عليك -

263
00:20:34,850 --> 00:20:35,690
إنّهُ أنت، يا آش

264
00:20:36,940 --> 00:20:38,690
كيف عرفت أين تجدني؟

265
00:20:39,280 --> 00:20:41,940
اِعتدت أن تقرأ هُنا طيلة الوقت

266
00:20:42,490 --> 00:20:44,110
على أيّ حال، هذا هو أجرك

267
00:20:44,660 --> 00:20:48,280
خمسمائة وخمسة عشر دولار وخمسة وسبعون سنت، التكاليف والضرائب مُدرجة

268
00:20:48,450 --> 00:20:49,450
شكرًا

269
00:20:49,950 --> 00:20:51,660
سوف تُغادر اليوم؟

270
00:20:51,910 --> 00:20:52,750
نعم

271
00:20:53,960 --> 00:20:57,540
أقال سينغ شيئًا بخصوص يوت لونغ - ساما؟

272
00:20:58,500 --> 00:21:03,300
يا لك من خادمٍ مُخلص، يعتني بسيّدهِ حتّى بعد اِنتهاء العقد

273
00:21:04,430 --> 00:21:06,550
ليس بمقدور سينغ قتله

274
00:21:06,720 --> 00:21:09,680
هو لا يزال هش، ليس مثلي

275
00:21:12,100 --> 00:21:13,930
ما الذي ستفعل بهِ؟

276
00:21:14,440 --> 00:21:16,560
سأمزقهُ حتّى الموت

277
00:21:16,900 --> 00:21:21,360
دومًا أتأكد من أن العدوّ قد مات
أنتَ من علّمني ذلك

278
00:21:21,690 --> 00:21:24,200
لم يتم تعليمي بأن أتهاون قط

279
00:21:24,990 --> 00:21:27,950
حسبتُ بأنّهُ لا حاجة لذلك

280
00:21:28,780 --> 00:21:32,620
ولكن على أيّ حال، لستُ من النوع الذي يذهب ويقتل شخصًا ما هكذا

281
00:21:33,080 --> 00:21:35,960
طالما بأنّهُ لن يسعى خلفي، لن أقترب منه

282
00:21:36,870 --> 00:21:37,830
هل أنتَ راضٍ؟

283
00:21:38,420 --> 00:21:39,250
نعم

284
00:21:41,840 --> 00:21:44,220
سيعود إيجي غدًا إلى اليابان

285
00:21:46,300 --> 00:21:48,090
لقد كنتَ مُحق

286
00:21:48,840 --> 00:21:51,350
أنا لا أجلب لهُ سوى المخاطر

287
00:21:52,970 --> 00:21:56,440
أنا الشخص الذي على الآخرين الإبتعاد عنه

288
00:21:57,190 --> 00:21:58,730
أتفهم الأمر الآن

289
00:21:59,730 --> 00:22:02,320
كلّا، لقد كنتُ أفهم ذلك طيلة هذا الوقت

290
00:22:03,320 --> 00:22:05,530
أنا فقط لم أستطع تقبّل ذلك

291
00:22:06,610 --> 00:22:08,360
مثير للشفقةِ، هاه؟

292
00:22:09,910 --> 00:22:14,290
عندما تقابلنا أول مرّة، عَلِمَ على الفور ما أنا عليه

293
00:22:14,580 --> 00:22:18,420
ولكنهُ لم يكن خائفًا مني، أو حذر مني

294
00:22:19,210 --> 00:22:22,380
لقد تحدث معي بلغة إنجليزية رديئة

295
00:22:23,130 --> 00:22:24,960
ظنّنتُ بأنّهُ غريب الأطوار

296
00:22:25,300 --> 00:22:29,010
ظنّنتُ بأن ذلك لكونه شخص أجنبي

297
00:22:30,010 --> 00:22:32,600
ولكنني أدركتُ بعد حين بأنّني كنتُ مخطئ

298
00:22:33,760 --> 00:22:35,850
...عندما يكون بالقرب مني

299
00:22:36,430 --> 00:22:42,020
طيبتهُ وصدقهُ، ودفئهُ... تتدفق إلي

300
00:22:42,730 --> 00:22:45,030
جلعني ذلك مُكتَمِل

301
00:22:46,030 --> 00:22:49,570
...ولكن أنا.. جسدي

302
00:22:50,360 --> 00:22:54,290
يتجاوب كالآلةِ ويقتل الآخرين وكأن شيئًا لم يكن

303
00:22:55,200 --> 00:22:58,210
بدون تفكير، بدون مشاعر

304
00:22:59,000 --> 00:23:03,040
لم أشعر أبدًا بالخوف أو بالعار من نفسي مثلما أنا الآن

305
00:23:04,130 --> 00:23:06,050
لن أُقابلهُ مُجدّدًا

306
00:23:07,720 --> 00:23:09,880
،ولكنهُ صديقي

307
00:23:10,680 --> 00:23:12,640
حتّى لو لم نتقابل مُجدّدًا

308
00:23:14,600 --> 00:23:17,140
هل مسموحٌ لي أن أكن لهُ المشاعر، صحيح؟

309
00:23:20,390 --> 00:23:22,230
ما الذي ستفعلهُ الآن؟

310
00:23:22,900 --> 00:23:26,190
لا شيء، كالعادة سأكون حثالةً أخرى من حثالات المدينة

311
00:23:29,320 --> 00:23:32,160
ألن ترافقني إلى منطقة البحر الكاريبي؟

312
00:23:34,530 --> 00:23:38,370
أتريد أن تأخذني معك لأملأ فراغك؟

313
00:23:39,160 --> 00:23:41,420
هذه ليس من شيمك، سيرجي

314
00:23:42,290 --> 00:23:45,710
أنتَ مُحق، لتنسى بأنّني قلتُ ذلك

315
00:23:49,340 --> 00:23:51,300
حسنٌ، إعتني بنفسك

316
00:23:55,890 --> 00:23:56,930
وأنتَ أيضًا

317
00:24:07,520 --> 00:24:08,940
مرحبًا -
سينغ -

318
00:24:09,360 --> 00:24:11,950
ستُغادر اليوم، صحيح؟

319
00:24:12,320 --> 00:24:14,700
سينغ، هل آش بخير؟ هل هو بأمان؟

320
00:24:16,280 --> 00:24:17,790
ألم يأتي لزيارتك بعد؟

321
00:24:18,790 --> 00:24:19,660
لماذا؟

322
00:24:20,620 --> 00:24:22,620
أنا حقًا لا أفهمه

323
00:24:23,580 --> 00:24:25,210
هلّا طلبتُ منك معروفًا؟

324
00:24:26,170 --> 00:24:28,300
هلّا أعطيت هذه لآش؟

325
00:24:28,960 --> 00:24:32,590
أتمنى لو أعطيتُها لهُ بنفسي، ولكن أنظر إلى حالي

326
00:24:33,550 --> 00:24:35,220
ولم أستطيع طلب ذلك من شخص آخر

327
00:24:36,010 --> 00:24:39,350
ولكنني لا أعلم أين يتواجد آش الآن

328
00:24:40,560 --> 00:24:41,680
...في المكتبة

329
00:24:42,230 --> 00:24:43,730
هو موجود في المكتبة

330
00:24:44,230 --> 00:24:45,350
أنا على يقينٍ من ذلك

331
00:25:02,870 --> 00:25:04,710
لماذا لا تذهب لزيارتهِ؟

332
00:25:05,170 --> 00:25:07,420
سوفي يعود إلى اليابان اليوم

333
00:25:08,500 --> 00:25:09,380
أعلم ذلك

334
00:25:10,170 --> 00:25:11,460
إذن لماذا؟

335
00:25:12,170 --> 00:25:14,510
هو صديقك -
ذلك هو السبب -

336
00:25:15,180 --> 00:25:17,550
أنا أُعيدهُ إلى عالمهِ الخاص

337
00:25:18,260 --> 00:25:19,890
...هو لا ينتمي

338
00:25:21,470 --> 00:25:24,020
إلى عالم القتلِ هذا

339
00:25:26,350 --> 00:25:28,900
ولكن لم يتبقى أيُّ وقت

340
00:25:29,310 --> 00:25:32,030
أتريد أن أعطيه رسالةً منك؟

341
00:25:34,280 --> 00:25:36,820
!أيُّها الأحمق العنيد

342
00:25:40,950 --> 00:25:42,450
أعتنيا بنفسكما

343
00:25:42,830 --> 00:25:45,870
وأنتم أيضًا، سيكون الأمر صعب ولكن حظًا موفقًا

344
00:25:46,040 --> 00:25:49,460
أتركوا الأمر عليّ، سوف أكشف الأمر برمته

345
00:25:49,790 --> 00:25:50,630
...ولكن

346
00:25:50,790 --> 00:25:54,800
آش.. أنتَ لم تأتي

347
00:25:55,920 --> 00:25:58,050
أنا أفهم كيف تشعر

348
00:25:58,930 --> 00:26:02,680
أنتَ لم تأتي لأنك ظنّنت بأن ذلك هو الأفضل بالنسبةِ لي

349
00:26:03,640 --> 00:26:06,640
ولكن هذا مؤلمٌ جدًا

350
00:26:07,730 --> 00:26:10,270
هل أنتَ موافق على ذلك؟

351
00:26:19,700 --> 00:26:26,080
آش، أنا قلقٌ حتّى الموت
لأنّهُ لم يكن بمقدوري رؤيتك تُبلي بلاءً حسنًا

352
00:26:27,080 --> 00:26:30,830
لقد قلتَ بأننا نعيش في عالمين مُختلفين

353
00:26:31,790 --> 00:26:33,590
ولكن هل هذا صحيح؟

354
00:26:34,550 --> 00:26:39,590
أعيننا وبشرتنا مُختلفة، وقد ولدنا في دولتين مُختلفتين

355
00:26:40,010 --> 00:26:43,600
ولكننا أصدقاء، أليس ذلك ما يهم؟

356
00:26:45,100 --> 00:26:47,810
أنا حقًا سعيد لقدومي إلى أمريكا

357
00:26:48,770 --> 00:26:50,480
لقد قابلتُ العديد من الأشخاص

358
00:26:50,730 --> 00:26:54,190
والأهم من ذلك، قابلتُكَ أنت

359
00:26:56,030 --> 00:27:00,320
لقد سألتني مرارًا وتكرارًا إذا ما كنتَ تُخيفني

360
00:27:01,320 --> 00:27:05,740
ولكنني لم أشعر بالخوف منك قط، ولا حتّى لمرّةٍ واحدة

361
00:27:06,700 --> 00:27:10,710
والأهم من ذلك أنتَ مجروحٌ أكثر مني

362
00:27:11,000 --> 00:27:13,290
لم يسعني سوى الشعور بتلك الطريقة

363
00:27:13,920 --> 00:27:15,130
مُضحك، هاه؟

364
00:27:15,460 --> 00:27:20,300
أنتَ أذكى، أضخم، وأقوى مني بكثير

365
00:27:20,800 --> 00:27:26,560
ولكني دومًا شعرتُ بأنّهُ عليّ حمايتُك

366
00:27:33,060 --> 00:27:36,900
أتساءل ما هو الشيء الذي أردتُ حمايتكَ منه

367
00:27:42,870 --> 00:27:43,780
...إيجي

368
00:27:47,790 --> 00:27:49,500
!إيجي

369
00:27:49,960 --> 00:27:52,040
!"آش يقول " إلى اللقاء

370
00:27:52,460 --> 00:27:54,880
ومن الأفضل لك أن تعود

371
00:27:55,170 --> 00:27:56,420
!سنكون في الإنتظار

372
00:27:57,090 --> 00:27:59,460
!سأفعل، سأعود مُجدّدًا

373
00:28:03,010 --> 00:28:04,760
لماذا أرخيت دفاعك؟

374
00:28:05,390 --> 00:28:07,600
أنتَ لا ترخي دفاعك أبدًا، لماذا الآن؟

375
00:28:10,390 --> 00:28:13,100
لا ضغينةَ بيننا

376
00:28:14,020 --> 00:28:18,980
لا يمكنني السماح لك بقتل سينغ

377
00:28:30,910 --> 00:28:33,170
هل أنتَ بخير؟ -
نعم -

378
00:28:34,330 --> 00:28:37,290
،ذات مرّة، عندما دخلتُ في شِجار مع آش

379
00:28:38,340 --> 00:28:41,130
ذهبتُ إلى المكتبة لأعتذر منه

380
00:28:42,420 --> 00:28:44,640
لقد كان يجلس هُناك بهدوء

381
00:28:45,220 --> 00:28:49,100
بسَّكينةٍ جدًا، مُنفصلًا عن عالم القتال والعُنف

382
00:28:50,810 --> 00:28:52,140
ولكن وحيدًا جدًا

383
00:28:52,680 --> 00:28:57,650
و يالها من وحدةٍ سامية لا توصف

384
00:28:58,690 --> 00:29:02,150
أردتُ حمايتك من المصير

385
00:29:03,150 --> 00:29:07,370
المصير الذي يُحاول حملك ليجرفك أبعد فأبعد

386
00:29:09,120 --> 00:29:10,700
...ذلك عندما فكّرتُ

387
00:29:11,200 --> 00:29:14,250
بأنني سأؤمن بك، مهما حدث

388
00:29:15,040 --> 00:29:17,460
بغض النظر عمَّ سيحدث

389
00:29:18,500 --> 00:29:22,420
...ذلك.. ذلك بأنّهُ على الأقل سوف

390
00:29:23,840 --> 00:29:27,970
أخبرتني ذات مرّة بشأن الفهد الذي قرأت عنهُ في كتاب

391
00:29:29,810 --> 00:29:34,390
وكيف ذلك الفهد عَلِمَ بأنّهُ ليس بمقدورهِ العودة

392
00:29:36,810 --> 00:29:40,150
،وأنا قلتُ لك بأنك لستَ بفهد

393
00:29:40,820 --> 00:29:43,440
وبأنك قادر على تغير مصيرك

394
00:29:44,780 --> 00:29:46,240
أنتَ لستَ وحيدًا

395
00:29:47,160 --> 00:29:48,740
أنا إلى جانبك

396
00:29:49,870 --> 00:29:54,040
روحي دومًا معك

397
00:30:09,970 --> 00:30:11,850
سا - يو - نا - را، أمريكا

398
00:30:12,180 --> 00:30:13,890
سا - يو - نا - را، نيويورك

399
00:30:15,230 --> 00:30:18,940
ولكن سأقول "سا - يو - نا - را" لك يا آش

400
00:30:20,690 --> 00:30:24,860
أعلم بأننا سنلتقي مُجدّدًا، مهما كُنا مُتابعدين عن بعضنا البعض

401
00:30:26,070 --> 00:30:30,120
أنتَ أعظم صديق حظيتُ بهِ على الإطلاق

402
00:30:32,490 --> 00:30:33,450
أنت هُناك

403
00:30:34,450 --> 00:30:37,080
لا يجدّر بك النوم هُنا

404
00:30:41,130 --> 00:30:42,790
لا بدّ وأنك تحظى بحُلمٍ جميل

405
00:30:43,250 --> 00:30:44,590
...أمم، أرجو المعذرة