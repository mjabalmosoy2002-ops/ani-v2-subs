1
00:00:31,670 --> 00:00:32,630
!توقف

2
00:00:37,550 --> 00:00:38,560
!سيتسونا-سان

3
00:00:56,200 --> 00:00:56,950
لقد قفز؟

4
00:01:32,070 --> 00:01:32,780
!فلننقذها

5
00:01:33,320 --> 00:01:35,190
!توقف يا جيلتوش

6
00:01:36,280 --> 00:01:38,110
!لا تدمر قلبها

7
00:03:17,590 --> 00:03:21,010
ننقذها؟ كيف عسانا ننقذ نايوتا؟

8
00:03:21,510 --> 00:03:22,550
...نذهب إلى الفضاء و

9
00:03:23,140 --> 00:03:24,180
نذهب ونقوم بماذا؟

10
00:03:25,390 --> 00:03:26,640
،مثل المرة السابقة

11
00:03:27,140 --> 00:03:31,230
.إن وصلت أصواتنا إلى قلب مورياما-سان، فأظن أنَّ ذلك سيفلح بشكلٍ ما

12
00:03:31,730 --> 00:03:33,020
...مثل المرة السابقة... ولكن

13
00:03:33,100 --> 00:03:34,360
أتقصد، مواجهة سانادون السابقة؟

14
00:03:34,440 --> 00:03:34,940
.أجل

15
00:03:35,440 --> 00:03:37,070
!يمكنكِ فعلها يا مورياما نايوتا

16
00:03:37,860 --> 00:03:40,030
!يمكنكِ فعلها! يمكنكِ فعلها

17
00:03:40,530 --> 00:03:44,530
.ستذهب إلى الفضاء كي تشجعها؟ هذا سخيف

18
00:03:45,030 --> 00:03:47,540
...أقدر شعورك، ولكن يا موراتا-كُن

19
00:03:47,990 --> 00:03:50,500
.لن نشجعها، سنكون بمثابة إشارة لها

20
00:03:51,120 --> 00:03:51,960
إشارة؟

21
00:03:54,330 --> 00:03:58,250
...يمكن لنايوتا-تشان التي اتحدت مع قوة الشنجو

22
00:03:58,250 --> 00:04:01,590
.أن تستخدم هذه الإشارة لتعود، كما في المرة السابقة

23
00:04:03,180 --> 00:04:04,470
.هذه فكرةٌ جيدة

24
00:04:05,300 --> 00:04:05,930
.جدي

25
00:04:06,890 --> 00:04:07,430
.مرحباً

26
00:04:07,930 --> 00:04:12,350
.قد تكون فكرةً جيدة، لكنَّ موراتا-كُن لا يمكنه الذهاب إلى الفضاء

27
00:04:12,640 --> 00:04:15,480
.فهو لا يملك مكوكاً، ولا يمكنه القفز إلى الفضاء مثل موريو-كُن

28
00:04:16,020 --> 00:04:17,650
.لهذا سآخذه بنفسي

29
00:04:20,820 --> 00:04:24,950
.أنا متأكدٌ أنني أستطيع أخذ قلب موراتا-كُن معي

30
00:04:42,170 --> 00:04:44,760
...يبدو أنَّ جيلتوش يواجه مشاكل

31
00:04:44,760 --> 00:04:47,470
.في الحفاظ على هدوئه أثناء قتاله لموجين

32
00:04:47,970 --> 00:04:49,560
.لم تعد الصور ترد كما كانت

33
00:04:49,680 --> 00:04:51,930
ميوكين-كُن، لم لا ترينا أنتَ بدلاً منه؟

34
00:04:53,350 --> 00:04:54,560
.أظنُّ أنه لا خيار آخر لي

35
00:04:59,820 --> 00:05:00,820
!هذا رائع

36
00:05:02,030 --> 00:05:03,950
.هذه من وجهة نظري

37
00:05:04,400 --> 00:05:07,950
.من الصعب لي أن أريه من وجهة نظرٍ تناسب المشاهدين كما فعل جيلتوش

38
00:05:08,370 --> 00:05:10,030
...هل أنتَ أيضاً

39
00:05:11,240 --> 00:05:16,620
.منذ 10 آلاف عام، حاربتُ ضدَّ جيلتوش وموجين وآسوجي-سان عدة مرات

40
00:05:19,750 --> 00:05:20,800
.آسوجي-سان

41
00:05:23,880 --> 00:05:25,760
هل الجميع مستعد؟

42
00:05:26,090 --> 00:05:27,050
!أجل

43
00:05:30,350 --> 00:05:32,180
هل سيفلح هذا حقاً؟

44
00:05:32,520 --> 00:05:34,310
!شون! الشكُّ ليس متاحاً الآن

45
00:05:34,680 --> 00:05:36,810
!حسناً! سأتخلى عن شكوكي

46
00:05:37,140 --> 00:05:41,820
.أنتَ متهورٌ فعلاً! حتى أنكَ لستَ من سكان تينمو الأصليين

47
00:05:42,110 --> 00:05:43,780
.لا مشكلة، هذا لأنني ممثل الصف

48
00:05:43,990 --> 00:05:45,780
!فليأخذ أحدكم وسادته

49
00:05:49,070 --> 00:05:50,490
!فلنفعلها يا موراتا

50
00:05:50,990 --> 00:05:51,620
!أجل

51
00:05:51,870 --> 00:05:53,200
سوبارو! هل أنتَ جاهز؟

52
00:05:53,580 --> 00:05:55,540
!أجل! مستعدٌّ في أي وقت

53
00:06:01,250 --> 00:06:02,420
...تأهب

54
00:06:04,260 --> 00:06:05,380
...استعد

55
00:06:23,940 --> 00:06:26,490
!اجمعوا قواكم باتجاه الدوامة

56
00:06:41,500 --> 00:06:42,250
...رائع

57
00:06:49,880 --> 00:06:51,640
!موراتا، إنَّ سوبارو قادم

58
00:07:04,980 --> 00:07:05,940
!هاجيمي! موريو

59
00:07:06,320 --> 00:07:07,570
!أعتمد عليكما

60
00:07:08,110 --> 00:07:08,860
!نعتمد عليكما

61
00:07:08,990 --> 00:07:10,950
!هيا يا سوبارو

62
00:07:18,000 --> 00:07:18,870
!خذه

63
00:07:24,460 --> 00:07:25,170
!موريو-كُن

64
00:07:35,640 --> 00:07:38,310
!ما هذا؟ إنه يتحرك بسرعةٍ غير معقولة

65
00:07:39,140 --> 00:07:42,020
.إنه ابني وصديقه

66
00:07:45,610 --> 00:07:47,110
.إنهما ذاهبان لإنقاذ صديقتهما

67
00:07:55,780 --> 00:07:57,450
هل ها-تشان بخير؟

68
00:07:57,950 --> 00:07:59,080
.لا داعي للقلق

69
00:07:59,080 --> 00:08:00,540
.إنَّ موريو معه

70
00:08:00,830 --> 00:08:05,630
.ولكن وفقاً لما نراه، فإنَّ مورياما-سان وآلوها-سان خارج النظام الشمسي

71
00:08:06,340 --> 00:08:08,340
لا أصدق أنهما سيذهبان إلى هناك

72
00:08:08,710 --> 00:08:10,090
ولكن كيف سيعودون؟

73
00:08:10,720 --> 00:08:12,970
.أنتَ هادئٌ دوماً

74
00:08:13,380 --> 00:08:15,010
.أنا لستُ بالتهور الذي أنتَ عليه وحسب

75
00:08:15,180 --> 00:08:16,010
ماذا؟

76
00:08:17,640 --> 00:08:21,730
.بالمناسبة، لقد كانت فكرة الدوامة خاصتكَ جيدةً حقاً

77
00:08:21,930 --> 00:08:25,480
.جيدة؟ أوه، لقد كانت فكرة كيويتشي

78
00:08:25,690 --> 00:08:26,560
!لم تكن فكرة

79
00:08:26,900 --> 00:08:27,900
!لقد كانت إيحاءً

80
00:08:27,900 --> 00:08:28,860
.هذا نفس الشيء

81
00:08:30,610 --> 00:08:34,410
.إنَّ الإيحاء يأتي نتيجةً لاستمرار الجهد اليومي

82
00:08:34,950 --> 00:08:36,700
.يبدو أنكَ كبرتَ كذلك

83
00:08:36,910 --> 00:08:38,030
...هاه؟ حسناً

84
00:08:41,700 --> 00:08:43,160
...بقيت نايوتا-تشان

85
00:08:44,370 --> 00:08:47,590
.سيُقرر مصير الأرض بناءً على تصرفها

86
00:08:58,470 --> 00:09:01,470
...العدالة المطلقة، الحقيقة المطلقة

87
00:09:01,850 --> 00:09:04,890
...الوجود المطلق الذي يمكنه سلب حياة الأشخاص

88
00:09:05,140 --> 00:09:08,770
...أو حتى تدمير كوكبٍ كاملٍ باسمه

89
00:09:09,400 --> 00:09:10,730
.القاضي

90
00:09:11,690 --> 00:09:12,940
.يبدو أنكِ تعرفين الكثير

91
00:09:13,320 --> 00:09:14,280
.لقد بحثتُ في الأمر

92
00:09:14,570 --> 00:09:15,740
.أحسنتِ عملاً

93
00:09:16,990 --> 00:09:18,910
.كما أنني بحثتُ بشأن علاقتكِ بجيلتوش

94
00:09:19,620 --> 00:09:20,280
.هكذا إذاً

95
00:09:21,580 --> 00:09:23,410
...بعد أن فقد شقيقكِ السيطرة على قواه

96
00:09:24,120 --> 00:09:28,330
.كان جيلتوش، بطل كوكب فيلون، هو من قضى عليه

97
00:09:29,840 --> 00:09:31,250
.إنَّ أخي ليس ميتاً

98
00:09:37,430 --> 00:09:41,970
.إنهما يبعدان 30 سنة ضوئية، حتى أنا لا أستطيع الرؤية إلى هذا الحد

99
00:09:42,350 --> 00:09:43,930
30 سنة ضوئية؟

100
00:09:49,150 --> 00:09:51,230
ماذا سيحصل؟

101
00:09:52,020 --> 00:09:53,280
.سيعتمد ذلك على في-يان

102
00:09:53,650 --> 00:09:55,240
.سيعتمد على القاضي

103
00:10:12,800 --> 00:10:13,460
!انتظر

104
00:10:16,760 --> 00:10:18,510
!انتظر أرجوك! انتظر

105
00:10:34,360 --> 00:10:36,150
هل أنتَ بخيرٍ يا موراتا-كُن؟

106
00:10:36,780 --> 00:10:38,860
...أجل

107
00:10:42,870 --> 00:10:44,030
.كنتُ أعرف أنكَ ستأتي

108
00:10:48,040 --> 00:10:50,500
...أنتما تكوِّنان فريقاً جيداً حقاً

109
00:10:52,040 --> 00:10:53,630
.لكنَّ الأوان قد فات

110
00:10:54,550 --> 00:10:59,380
.لقد تمَّ امتصاص جسد وقلب نايوتا-تشان من قبل قوة الشينجو

111
00:11:01,260 --> 00:11:04,260
!مورياما-سان

112
00:11:06,140 --> 00:11:07,470
،منذ 10 آلاف سنة

113
00:11:07,470 --> 00:11:11,100
.قاتل رجلٌ يدعى موجين ضد سفينةٍ للأعداء

114
00:11:11,730 --> 00:11:15,020
.وحرر قواه وفجر بسبب ذلك مجرةً كاملة

115
00:11:16,360 --> 00:11:20,150
.لقد أخبرني جدي بذلك، لكنَّ أختي لم تخبرني بأي شيء

116
00:11:21,820 --> 00:11:22,780
.هذا طبيعي

117
00:11:23,450 --> 00:11:27,160
.لقد تحول موجين إلى ما نعرفه اليوم بالشينجو

118
00:11:27,660 --> 00:11:30,750
.لقد تحول كلٌّ من جسده وقلبه إلى كتلةٍ من الطاقة

119
00:11:31,420 --> 00:11:33,290
...هذه مجرد عينة

120
00:11:34,290 --> 00:11:39,510
.إنَّ القوة التي استخدمتها نايوتا-تشان كانت مجرد عينةٍ من قوة الشينجو

121
00:11:40,220 --> 00:11:41,220
...القوة الحقيقية

122
00:11:41,720 --> 00:11:42,720
القوة الحقيقية...؟

123
00:11:44,260 --> 00:11:46,180
.مدفونةٌ تحت جبل تينمو

124
00:11:47,100 --> 00:11:49,770
...لقد خبأنا الشينجو هناك و

125
00:11:50,060 --> 00:11:53,310
.خبأ آسوجي سفينته الفضائية في الجبل المقدس

126
00:11:54,730 --> 00:11:55,810
خبأها؟

127
00:11:56,480 --> 00:11:58,400
كيف يمكن تخبئة شيءٍ كذلك؟

128
00:11:59,070 --> 00:12:03,240
.إنَّ القوة التي تخرج هي قوةٌ تدخل كذلك

129
00:12:03,950 --> 00:12:06,120
.لقد قمتُ بلوي ذلك نوعاً ما

130
00:12:07,200 --> 00:12:08,120
لويه؟

131
00:12:09,080 --> 00:12:13,120
...أجل، لقد لوت نايوتا-تشان القوة المتجهة إلى الخارج

132
00:12:13,120 --> 00:12:16,130
.وحولتها إلى قوةٍ متجهةٍ إلى الداخل عن طريق التحول إلى الشينجو والقتال

133
00:12:17,170 --> 00:12:19,130
.وهكذا فعلت موموي-سان وكل من قبلها

134
00:12:19,300 --> 00:12:21,590
.كل من استخدم الشينجو فعل ذلك

135
00:12:22,590 --> 00:12:25,090
.تتحول الطاقة إلى جسدٍ عن طريق تحويلها إلى قوةٍ داخلة

136
00:12:25,470 --> 00:12:27,930
.وتفقد هيأتها بتحويلها إلى قوةٍ خارجة

137
00:12:28,810 --> 00:12:33,270
هل هذا مثل مواجهة التيار أو وقوفك عكسه؟

138
00:12:33,810 --> 00:12:36,940
.إنَّ تفكيركَ جيدٌ حقاً

139
00:12:37,730 --> 00:12:41,280
.لقد واجه موجين ونايوتا-تشان التيار وتمَّ دفعهما بسببه

140
00:12:42,280 --> 00:12:43,950
هل هذا هو التيار؟

141
00:12:44,950 --> 00:12:47,280
ماذا ستفعل الآن؟

142
00:12:48,700 --> 00:12:52,960
.عليَّ أن أحولها إلى قوةٍ داخلةٍ مجدداً عند مصدر الانتشار

143
00:12:53,660 --> 00:12:57,920
إن كانت قد انتشرت وغطت الأرض والنظام الشمسي للتو، ألن يتسبب ذلك بتدميرها؟

144
00:12:59,210 --> 00:13:01,340
.سيتسبب هذا بانفجارٍ ضخم

145
00:13:02,130 --> 00:13:04,840
.ستتحول الكواكب المغطاة بالانفجار إلى غبارٍ نجمي

146
00:13:07,970 --> 00:13:10,430
.أنتَ محق، ولكننا لا نستطيع تفادي ذلك

147
00:13:11,850 --> 00:13:15,190
.يجب أن يُكرر ذلك حتى نتمكن من إلغاء قوة الشينجو

148
00:13:17,310 --> 00:13:21,650
.عليَّ أن أنشرها شيئاً فشيئاً كي أخفف من القيمة الكلية

149
00:13:22,610 --> 00:13:25,490
.تبدو هذه كعمليةٍ طويلةٍ ومتعبة، لكنها الطريقة الوحيدة

150
00:13:27,870 --> 00:13:29,330
إنها الطريقة الوحيدة؟

151
00:13:30,030 --> 00:13:31,330
ولكن ماذا عن الأرض؟

152
00:13:31,540 --> 00:13:33,330
إذاً ما هو سبب وجود سكان تينمو؟

153
00:13:34,460 --> 00:13:38,380
...حسناً، إنهم العقدة التي صنعتُها

154
00:13:39,210 --> 00:13:46,130
.إنهم قبضة الصنبور، والأرض هي خزان المياه

155
00:13:46,510 --> 00:13:48,010
!إنَّ مورياما-سان ليست أداة

156
00:13:48,550 --> 00:13:50,930
...وهذا ينطبق على زعيمة عشيرة سانيموري، والجميع

157
00:13:54,180 --> 00:13:57,560
.لقد رغبت سيتسونا بذلك، وأصبحت حامية الأرض

158
00:13:59,940 --> 00:14:02,400
...كي تكفّر عن ذنب أخيها

159
00:14:03,320 --> 00:14:05,780
.إنَّ عشيرتها هم أجداد سكان تينمو

160
00:14:06,900 --> 00:14:11,830
.لقد تزوجوا سكان الأرض وولدوا منهم، وأصبحوا حراس الشينجو

161
00:14:14,750 --> 00:14:20,130
.في النهاية، لم تتمكن طرقهم من التحكم بقوة الشينجو

162
00:14:23,920 --> 00:14:26,380
إذاً لماذا أتيتَ أنتَ إلى الأرض؟

163
00:14:28,430 --> 00:14:29,390
.لقد كان وعداً قطعتُه

164
00:14:30,840 --> 00:14:31,680
وعداً؟

165
00:14:33,350 --> 00:14:35,770
.وعداً بأن أرى نتيجة محاولتهم

166
00:14:36,850 --> 00:14:39,560
.لقد كان آسوجي إلى جانبنا في الأصل

167
00:14:40,100 --> 00:14:43,400
.لكنه اختار أن يعيش في نفس الوقت مع امرأةٍ على الأرض

168
00:14:44,400 --> 00:14:46,690
.حسناً، أظنُّ أنَّ هذا كان خياراً آخر كذلك

169
00:14:55,700 --> 00:14:58,540
.شكراً لشرحكَ الكثير من الأمور

170
00:14:59,250 --> 00:15:00,330
.لقد فهمت الفكرة الآن نوعاً ما

171
00:15:02,290 --> 00:15:02,920
هل فعلت؟

172
00:15:03,500 --> 00:15:08,170
...ببساطة، إن قمنا بشيءٍ ما بشأن مجرى الطاقة هذا، فسيتمُّ إنقاذ الأرض

173
00:15:08,380 --> 00:15:12,760
.ولن تكون هناك حاجةٌ لك لصنع أمثال سكان تينمو ثانيةً وثالثة

174
00:15:13,100 --> 00:15:14,430
أليس هذا ما تقوله؟

175
00:15:18,180 --> 00:15:19,600
.سأنقذ مورياما-سان

176
00:15:20,640 --> 00:15:22,730
...لا طائل من هذا، إنها

177
00:15:23,610 --> 00:15:24,610
.ستكون الأمور بخير

178
00:15:29,110 --> 00:15:30,990
.سأجد مورياما-سان

179
00:15:31,280 --> 00:15:33,910
.هذا مستحيل، لا يمكنكَ فعل هذا

180
00:15:34,580 --> 00:15:39,790
.أنا لا أملك قوىً مثلكَ أو مثل موريو-كُن، لكنني أستطيع الشعور بالتدفق

181
00:15:40,250 --> 00:15:42,170
.يمكنني الشعور بمورياما-سان

182
00:15:42,670 --> 00:15:45,040
!مورياما-سان، أجيبيني إن كنتِ تسمعينني

183
00:15:45,290 --> 00:15:46,250
!مورياما-سان

184
00:15:49,130 --> 00:15:54,680
.هاجيمي-كُن

185
00:16:18,580 --> 00:16:20,500
...لقد قُلب التيار

186
00:16:21,410 --> 00:16:23,960
أليس هذا ما كنتَ تريده حقاً؟

187
00:16:25,670 --> 00:16:26,840
ماذا؟

188
00:16:27,040 --> 00:16:28,880
...لأجل مورياما-سان... لا

189
00:16:29,670 --> 00:16:33,880
.بل كي يأخذ سكان الأرض قوة الشينجو ويتقدموا إلى المستوى التالي

190
00:16:34,300 --> 00:16:35,800
.لكنَّ ذلك لم يحدث

191
00:16:36,430 --> 00:16:37,510
.ليس بعد

192
00:16:39,060 --> 00:16:41,020
.أنا أؤمن بهما

193
00:16:42,390 --> 00:16:44,730
من تكون أنتَ بالضبط؟

194
00:17:05,790 --> 00:17:06,960
هل شعرتَ بذلك؟

195
00:17:08,210 --> 00:17:08,880
.أجل

196
00:17:10,880 --> 00:17:14,300
...شرارةٌ عظيمة، على بعد 30 سنةٍ ضوئية

197
00:17:15,550 --> 00:17:16,800
ماذا حصل؟

198
00:17:17,430 --> 00:17:20,180
.ستتمكنون من رؤية ذلك بعد 30 سنة

199
00:17:22,390 --> 00:17:24,850
.إنها ولادة مستقبلٍ جديد

200
00:17:25,690 --> 00:17:28,440
...مستقبل؟ إذاً، هل يعني هذا

201
00:17:38,240 --> 00:17:38,820
!فلنذهب

202
00:17:38,950 --> 00:17:39,580
!هاجيمي

203
00:17:39,620 --> 00:17:40,410
!ها-تشان

204
00:17:56,680 --> 00:17:57,260
هاه؟

205
00:18:09,400 --> 00:18:10,440
.أهلاً بعودتك

206
00:18:15,610 --> 00:18:16,490
.أهلاً بعودتك

207
00:18:21,160 --> 00:18:21,830
.مرحباً

208
00:18:23,910 --> 00:18:25,620
.إنها مصافحةٌ أخرى

209
00:18:31,210 --> 00:18:34,000
هيه! ما هذا؟ لقد كنتَ هناك إذاً؟

210
00:18:40,970 --> 00:18:41,550
.مرحباً

211
00:18:44,770 --> 00:18:46,480
أرى أنهم بدؤوا يكرهوك؟

212
00:18:47,770 --> 00:18:49,520
حسناً، لا خيار آخر، أليس كذلك؟

213
00:18:52,610 --> 00:18:55,530
كيف تمكنتَ من إيجاد نايوتا-تشان؟

214
00:18:56,650 --> 00:18:59,110
...في السابق، حين قاتل الشينجو بالقرب من المريخ

215
00:18:59,990 --> 00:19:02,120
.شعرتُ بالتيار حين كنتُ أمسك بيدها

216
00:19:02,950 --> 00:19:03,740
التيار؟

217
00:19:04,160 --> 00:19:07,330
.قوة الشينجو... تيار قوة مورياما-سان

218
00:19:08,290 --> 00:19:09,790
.لقد بقي ذلك الشعور معي

219
00:19:10,670 --> 00:19:13,670
...لهذا تمكنتُ من إيجادها، كما أنَّ مورياما-سان كانت غالباً

220
00:19:14,630 --> 00:19:16,340
غالباً ماذا؟

221
00:19:18,630 --> 00:19:21,680
.لقد كنتُ أبحث عنكَ كذلك

222
00:19:21,970 --> 00:19:23,390
!مرحى لكما

223
00:19:23,930 --> 00:19:24,470
!هيه

224
00:19:25,640 --> 00:19:29,390
.أظنُّ أنَّ الحياة الطويلة لا تجعلكَ حكيماً بالضرورة

225
00:19:30,060 --> 00:19:31,940
هل استوعبتَ هذا للتو؟

226
00:19:32,560 --> 00:19:34,650
من قد يرغب بالاعتراف بذلك؟

227
00:19:39,860 --> 00:19:42,820
...بصفتي القاضي، أعلن الآن

228
00:19:43,320 --> 00:19:46,870
...أنَّ الاتحاد الكوني والتحالف السماوي

229
00:19:46,870 --> 00:19:49,660
.سيقيمون المزيد من الحوارات فيما يتعلق بقضية الأرض

230
00:19:50,290 --> 00:19:54,130
.لقد أبدت الأرض علاماتٍ أنها مستعدةٌ للانتقال إلى المرحلة التالية

231
00:19:55,170 --> 00:19:59,720
.لذا، أنا أمنع أي استكشافاتٍ أخرى تصف هذا الكوكب بأنه غير متطور

232
00:20:01,010 --> 00:20:02,430
ما رأيكم يا سادة؟

233
00:20:02,970 --> 00:20:05,010
هل يمكننا تصديق ما قلته حقاً؟

234
00:20:06,600 --> 00:20:10,020
.هذا سيء. لا مشكلة، يمكنكَ تصديقي

235
00:20:11,480 --> 00:20:14,020
.في الواقع، أريد منكم أن تصدقوني

236
00:20:14,020 --> 00:20:16,480
.أنا أقول هذا مع كل احترامي وتقديري للأرض

237
00:20:18,320 --> 00:20:19,280
...جيلتوش-سان

238
00:20:27,620 --> 00:20:29,790
هاه؟ بالمناسبة، أين موريو-كُن؟

239
00:20:30,410 --> 00:20:32,120
.يراودني شعورٌ سيء

240
00:20:32,370 --> 00:20:33,460
ماذا تقصد؟

241
00:20:41,050 --> 00:20:42,220
!هذا رائع! هذا رائع

242
00:20:42,760 --> 00:20:44,890
!حسناً جميعاً! اتجهوا إلى هنا

243
00:20:51,220 --> 00:20:51,930
هاه؟

244
00:20:53,350 --> 00:20:54,980
.يبدو المكان مملوءاً بالحيوية

245
00:20:57,150 --> 00:20:58,770
.أنتم رائعون حقاً

246
00:21:09,330 --> 00:21:10,370
!سنذهب

247
00:21:10,410 --> 00:21:11,160
.سنذهب

248
00:21:11,500 --> 00:21:12,540
.رافقتكما السلامة

249
00:21:15,670 --> 00:21:17,130
.لقد مرت بضعة أيام

250
00:21:17,880 --> 00:21:22,340
.لم يعد هناك داعٍ للانضمام إلى الاتحاد الكوني بسرعة

251
00:21:22,920 --> 00:21:26,640
.ولهذا، استمرت أيام الراحة والسلام مع الفضائيين

252
00:21:28,640 --> 00:21:32,600
لكنَّ الجميع الآن أصبح يعرف بشأن سكان تينمو

253
00:21:32,890 --> 00:21:34,600
...والاتحاد الكوني والتحالف السماوي

254
00:21:34,770 --> 00:21:35,770
.والفضائيين

255
00:21:36,980 --> 00:21:39,690
...لهذا لا يمكننا أن نكون كما كنا من قبل

256
00:21:40,570 --> 00:21:42,530
.ولكن، لهذا علينا أن نتقدم

257
00:21:43,110 --> 00:21:47,990
.لا يمكننا، ولا يجب علينا، ولن نتتبع خطانا السابقة

258
00:21:49,660 --> 00:21:51,910
هل الاتحاد والتحالف لطفاء حقاً؟

259
00:21:52,160 --> 00:21:53,830
!توكوجاوا إييوشي

260
00:21:54,200 --> 00:21:55,500
.توقف عن هذا يا سو-سان

261
00:21:58,250 --> 00:21:59,540
...يا للسلام

262
00:22:01,750 --> 00:22:03,590
.يا موريو-كُن

263
00:22:03,880 --> 00:22:04,380
ما الأمر؟

264
00:22:05,050 --> 00:22:07,680
إذاً، من أنتَ بالضبط؟

265
00:22:08,010 --> 00:22:09,430
لماذا تسأل عن هذا الآن؟

266
00:22:09,590 --> 00:22:10,890
.أنا أسأل عن هذا لأننا في هذا الوقت

267
00:22:11,390 --> 00:22:13,680
.لم يعد ذلك مهماً بعد كل ما حدث

268
00:22:13,850 --> 00:22:14,560
كل ما حدث؟

269
00:22:14,720 --> 00:22:16,140
.أجل، كل ما حدث

270
00:22:22,400 --> 00:22:23,730
هل أنتَ فضائيٌّ كذلك؟

271
00:22:24,070 --> 00:22:25,900
مثل آسوجي-سان وسيتسونا-سان؟

272
00:22:26,240 --> 00:22:27,530
.لا، لستُ كذلك

273
00:22:28,110 --> 00:22:28,860
حقاً؟

274
00:22:30,740 --> 00:22:32,580
...في الواقع، أنا

275
00:22:33,990 --> 00:22:34,740
في الواقع...؟

276
00:22:38,290 --> 00:22:40,040
.أول ما أتذكره هو أنني هنا

277
00:22:50,800 --> 00:22:52,220
.دعنا نترك الأمر هكذا

278
00:22:56,060 --> 00:22:59,440
!انتظر! انتظر يا موريو-كُن

279
00:23:01,100 --> 00:23:02,610
ماذا يفعلان؟

280
00:23:04,690 --> 00:23:06,280
!هيه! كلاكما

281
00:23:07,860 --> 00:23:10,740
...إنَّ الحفل الثقافي والاختبارات النهائية قادمة

282
00:23:11,780 --> 00:23:13,870
.وبالطبع، قضية الدبلوماسية الفضائية، وبعدها عطلة الشتاء

283
00:23:14,910 --> 00:23:20,040
.ستستمر معاركنا، لكنَّ القصة تنتهي هنا

284
00:23:23,630 --> 00:23:27,090
.حسناً إذاً، بشأن التتمة، سنترك الأمور على حالها