1
00:00:02,450 --> 00:00:05,170
"هذا العالم هو إمّا أن تقتل أو تُقتل"

2
00:00:05,170 --> 00:00:07,340
"لا يوجد ما يُدعى بالجنّة"

3
00:00:07,780 --> 00:00:09,970
"حالما تسقط، يُفقد الأمل"

4
00:00:09,970 --> 00:00:12,570
هناك أشخاص يعانون بسبب هذه المُعتقدات

5
00:00:13,090 --> 00:00:15,620
!مهلاً! أنت

6
00:00:15,620 --> 00:00:18,280
هل تتظاهر أنّك لا ترى ذلك؟

7
00:00:18,610 --> 00:00:21,500
من المؤسف ألّا نستطيع فعل المثل

8
00:00:21,500 --> 00:00:24,240
نأمل أن نمسح دموعك

9
00:00:24,460 --> 00:00:27,230
سندع البسمات تتفتّح بين الجماهير

10
00:00:27,230 --> 00:00:30,220
وبالطبع، التّعويض مطلوب

11
00:00:30,570 --> 00:00:33,850
زُر الحانة ف فحسب

12
00:00:33,850 --> 00:00:36,770
لا تقلق... لا حاجة للمال

13
00:00:36,770 --> 00:00:41,060
!هناك شيء واحد نريده

14
00:00:42,210 --> 00:00:45,750
!سوف نأخذ قلبك

15
00:02:18,950 --> 00:02:20,350
أهذا هو المكان؟

16
00:02:20,350 --> 00:02:23,370
!يُقال أنّ الجنِّيات يُحقّقون الأمنيات

17
00:02:27,960 --> 00:02:30,460
ما الّذي يجري هنا؟

18
00:02:33,110 --> 00:02:35,200
كونوا لطيفين وقدِّموا المساعدة

19
00:02:38,070 --> 00:02:41,060
طبق كاري خاص بالحانة ف

20
00:02:41,060 --> 00:02:44,800
!سوف نوفّر طلبات الجميع! صبراً من فضلكم

21
00:02:45,400 --> 00:02:47,140
أ-أتريد بعضاً من الماء؟

22
00:02:47,490 --> 00:02:49,720
إذاً وجبتا كاري؟

23
00:02:50,040 --> 00:02:52,050
!الحساب لو سمحت

24
00:02:52,470 --> 00:02:55,400
!حسناً! الثمن هو 10.000 ين لكل قطعة

25
00:02:55,660 --> 00:02:56,720
!هذا باهظ الثّمن

26
00:02:55,960 --> 00:02:57,340
!باهظ الثّمن

27
00:02:57,340 --> 00:02:58,400
!لكنّهم وسيمون، لذا لا مشكلة

28
00:02:58,620 --> 00:03:00,600
!عودوا في أي وقت

29
00:03:05,870 --> 00:03:09,310
!يا له من يوم مليء بالأرباح

30
00:03:09,310 --> 00:03:12,820
!هذا أسهل بكثير من جمع المُرفقات

31
00:03:13,340 --> 00:03:18,350
لكن لمَ نُهمّ أنفسنا؟ مال العالم
!البشريّ عديم الفائدة لنا

32
00:03:18,530 --> 00:03:20,500
!هذا غير صحيح إطلاقاً

33
00:03:20,500 --> 00:03:22,880
"حتّى بوّابات الجحيم تُفتح أمام المال"

34
00:03:23,200 --> 00:03:26,320
لن تُخطئ في عالمِ البشر إذا امتلكتَه

35
00:03:26,570 --> 00:03:30,850
لكن لمَ علينا إرسال المُرفق إلى
عالم الجنّيات على أي حال؟

36
00:03:31,220 --> 00:03:33,890
لأنّها مهمّتنا كجنّيات

37
00:03:35,180 --> 00:03:38,000
كلّ شيء هو عبارة عن مهمّات وأنظمة بالنسبة لك

38
00:03:38,000 --> 00:03:41,370
وكأنّه الشيء الوحيد الذي تفهمونه أنتم عشيرة آكوا

39
00:03:41,940 --> 00:03:46,640
هذا لا شيء مُقارنة بالميول الغبيّ
الّذي تتمتّع به عشيرة إغنيس

40
00:03:47,020 --> 00:03:48,330
لحلّ كلّ شيء بالقوّة

41
00:03:48,530 --> 00:03:49,590
ماذا؟

42
00:03:49,590 --> 00:03:52,640
!من يقولُ ذلك هو من ضربَ عميلته

43
00:03:52,640 --> 00:03:54,550
!أنت مُنتهك القواعد هنا

44
00:03:55,000 --> 00:03:57,470
جمعتُ مُرفقات أكثر منكم جميعاً

45
00:03:57,470 --> 00:04:00,250
في خدمةِ مهمّة ملِكتي

46
00:04:00,680 --> 00:04:02,000
هذا كل ما يهمّني

47
00:04:02,200 --> 00:04:04,930
هل فقدتَ صوابك أو ما شابه

48
00:04:05,280 --> 00:04:08,590
ألا تُبالي للأذى الذي ألحقتَه بعميلتك؟

49
00:04:08,780 --> 00:04:10,130
لا آبه

50
00:04:10,130 --> 00:04:13,020
إذا تُرِكت نار صغيرة تحترق، قد تتحوّل إلى جحيم

51
00:04:13,400 --> 00:04:15,220
منعتُ حدوث شيء من البداية وذلك بتطهير

52
00:04:15,220 --> 00:04:18,060
ما سوف يُصبح في نهاية المطاف روحاً شرّيرة

53
00:04:18,630 --> 00:04:20,810
!لم تكن تؤذي أحداً

54
00:04:21,590 --> 00:04:24,770
أنا من تأذّى

55
00:04:25,380 --> 00:04:27,540
لكن لماذا لا تعترِف بذلك؟

56
00:04:27,960 --> 00:04:29,930
لا يمكنك تحمُّل حقيقة أنّني تفوّقتُ عليك

57
00:04:29,930 --> 00:04:31,050
!ماذا؟

58
00:04:31,990 --> 00:04:34,180
!كُفّا عن الشِّجار

59
00:04:40,170 --> 00:04:41,640
مهلاً، مهلاً

60
00:04:41,640 --> 00:04:46,590
تُستخدَم المُرفقات لصون وتحسين عالم الجنِّيات

61
00:04:47,010 --> 00:04:51,030
إنّه بمثابة إصدار مختلِف من عملة العالم البشريّ

62
00:04:51,620 --> 00:04:56,340
دون المُرفقات، سيتعطّل عالم الجنّيات

63
00:04:56,590 --> 00:04:59,270
،كان عالمُ الجنّيات على وشك الإبادة الكاملة

64
00:04:59,270 --> 00:05:02,330
وما زلنا بحاجة الكثير من المُرفقات لإصلاحه

65
00:05:02,790 --> 00:05:07,410
لهذا تُعدُّون أنتم مُنقذينه المُختارين

66
00:05:08,240 --> 00:05:09,520
!أنا مُتوتّر الآن

67
00:05:09,520 --> 00:05:10,990
!حسناً يا رِفاق

68
00:05:10,990 --> 00:05:15,170
!اتّبعوا هذه القوانين العشرة واستمرّوا في كسب المُرفقات

69
00:05:15,910 --> 00:05:18,960
جرعة واعدة من مُكمّلاتنا والمليئة بالعناصر
،الغذائيّة المُستخرَجة من أنقليس الشّيق

70
00:05:18,960 --> 00:05:22,210
!ستقضي على ألمِ الرّكبة بالكامل

71
00:05:22,210 --> 00:05:25,340
!اعملوا الآن لتحصلوا على خصم 50 بالمئة

72
00:05:25,340 --> 00:05:27,710
أوّل عشر أشخاص يشترون سيحصلون
،على هذه المِزهريّة

73
00:05:27,710 --> 00:05:31,630
لإعلام الجميع أنّكم تحرّرتم من تيبُّس الأكتاف

74
00:05:32,080 --> 00:05:34,040
شكراً على قدومكم

75
00:05:34,910 --> 00:05:36,460
ماذا أفعل؟

76
00:05:36,460 --> 00:05:38,160
لم أبع شيئاً

77
00:05:38,160 --> 00:05:40,140
سيحدث ذلك من جديد

78
00:05:41,710 --> 00:05:44,540
...مرحباً يا سيّد مدير المنطقة

79
00:05:44,540 --> 00:05:46,240
هل من مبيعات اليوم؟

80
00:05:46,240 --> 00:05:48,780
لا مع الأسف

81
00:05:48,780 --> 00:05:51,850
أنتِ موظّفة بدوام كامل

82
00:05:51,850 --> 00:05:52,900
آسفة

83
00:05:55,650 --> 00:05:57,400
!حاضر. أنا آسفة

84
00:06:02,140 --> 00:06:04,730
معدتي تُؤلمني

85
00:06:06,350 --> 00:06:07,590
...حاضر! آسفة

86
00:06:07,590 --> 00:06:09,470
!أعني، أنا آسفة

87
00:06:10,160 --> 00:06:11,170
جدّتي؟

88
00:06:11,540 --> 00:06:13,120
نعم، أنا بخير

89
00:06:14,450 --> 00:06:16,460
لستِ على ما يُرام؟

90
00:06:16,800 --> 00:06:17,910
أنا آسفة جدّاً

91
00:06:17,910 --> 00:06:19,720
أظنّني سأتأخّر في العودة

92
00:06:20,030 --> 00:06:20,810
—لا أستطيع تحقيق المبيعات

93
00:06:20,810 --> 00:06:23,640
أعني، وقتي ضيّق

94
00:06:24,630 --> 00:06:26,620
على أي حال... أتكلّم معكِ لاحقاً

95
00:06:33,210 --> 00:06:34,360
...المعذرة

96
00:06:34,830 --> 00:06:35,880
نعم؟

97
00:06:36,330 --> 00:06:40,780
كان رانمارو... عشيرة كو كانوا نجوم
عالم الجنّيات، أليس كذلك؟

98
00:06:41,010 --> 00:06:42,840
تقصد أثناء الفترة الزرقاء؟

99
00:06:43,330 --> 00:06:44,500
هذا ما سمعتُه

100
00:06:44,850 --> 00:06:48,130
،سمعتُ أنّهم كانوا أبطالاً ومُلهِمين لكلّ الجنّيات

101
00:06:48,130 --> 00:06:52,120
يجمعون عدداً كبيراً من المُرفقات لدعمِ عالم الجنّيات

102
00:06:52,120 --> 00:06:52,910
أجل

103
00:06:52,910 --> 00:06:56,830
لكن أحد أولئك الأبطال تمرّدوا على الملِكة

104
00:06:56,830 --> 00:07:00,120
وهذا ما دمّر عالمَ الجنّيات؟

105
00:07:01,280 --> 00:07:05,450
وسمعتُ أنّها كانت أوقات عصيبة لنا منذ ذلك الحين

106
00:07:05,450 --> 00:07:09,700
يزداد الكوكب سوءاً أكثر فأكثر دون
أي تقدير لعالمِ الطبيعة

107
00:07:10,060 --> 00:07:14,880
هواء وماء مُلوّثان. زملاؤنا الجنّيين يختفون، واحداً تلو الآخر

108
00:07:16,150 --> 00:07:18,450
مُنقِذو عالم الجنّيات؟

109
00:07:18,760 --> 00:07:21,220
!هذا يجعل المرء يتوتّر حقّاً

110
00:07:21,220 --> 00:07:24,410
!لم أتصوّر يوماً أن أكون "مُختاراً" حقيقيّاً

111
00:07:24,780 --> 00:07:27,780
لكن... لماذا أنا يا تُرى؟

112
00:07:27,780 --> 00:07:30,700
لا بدَّ أنَّ هناك الكثير من الشّباب الّذين
يتمتّعون بصفات أفضل من صفاتي

113
00:07:30,700 --> 00:07:34,440
رُبّما لأنَّ أبي كان زعيم عشيرة ي

114
00:07:34,440 --> 00:07:35,680
يا لها من صُدفة

115
00:07:36,290 --> 00:07:38,930
كان أبي رئيس وُزراء عشيرة آكوا كذلك

116
00:07:38,930 --> 00:07:40,210
أنت أيضاً يا أورو؟

117
00:07:40,210 --> 00:07:42,150
...أتعتقِد

118
00:07:44,220 --> 00:07:46,780
هومورا، هل كان أبوك شخصيّة بارزة أيضاً؟

119
00:07:46,780 --> 00:07:47,970
!حُلَّ عنّي

120
00:07:50,210 --> 00:07:51,420
...أيُعقَل

121
00:07:52,880 --> 00:07:54,220
...رانمارو

122
00:07:54,550 --> 00:07:56,920
ألم تلتقِ بصديقِك القديم بعد؟

123
00:07:58,030 --> 00:07:59,920
لا يُمكنك خِداعي

124
00:08:00,730 --> 00:08:02,420
...سيريوس

125
00:08:02,420 --> 00:08:06,090
شريكك العزيز القديم ذاك

126
00:08:07,210 --> 00:08:10,030
ما هدف الملِكة بالضبط؟

127
00:08:10,640 --> 00:08:11,980
آسف يا تاكارا

128
00:08:12,380 --> 00:08:14,890
لا أفهم حقّاً ما تتحدّث عنه

129
00:08:15,690 --> 00:08:18,340
ألا تتذكّر حقّاً إذاً؟

130
00:08:20,210 --> 00:08:21,350
...فخامتك

131
00:08:21,970 --> 00:08:25,440
يبدو أنّهم بدؤوا يفهمون

132
00:08:26,030 --> 00:08:27,810
،حتّى لو علِموا الحقيقة

133
00:08:27,810 --> 00:08:29,800
لا داعي لإرخاء الحِبال

134
00:08:30,130 --> 00:08:32,910
ما داموا مُخلصين لهدف استعادة المملكة

135
00:08:35,530 --> 00:08:37,170
لماذا تنظر إليّ بهذا الشكل؟

136
00:08:37,630 --> 00:08:38,550
سامحيني

137
00:08:39,130 --> 00:08:43,370
آمل ألّا تراودك أي أفكار برّاقة

138
00:08:43,770 --> 00:08:45,620
مُحال

139
00:08:50,770 --> 00:08:52,470
تعودين إلى منزل والديكِ؟

140
00:08:53,120 --> 00:08:53,910
!لا تكوني حمقاء

141
00:08:54,350 --> 00:08:58,890
الإجازات تُعطى للأشخاص الذين يؤدّون أعمالهم

142
00:08:59,290 --> 00:09:00,930
...آسفة

143
00:09:04,160 --> 00:09:05,560
!أنا آسفة يا سيّدي

144
00:09:06,080 --> 00:09:08,030
!هذه حصّتكِ لهذا الشّهر

145
00:09:09,180 --> 00:09:12,160
!يا لكِ من قمامة عديمة القيمة

146
00:09:16,050 --> 00:09:18,220
ما الّذي أفعله حتّى؟

147
00:09:18,970 --> 00:09:20,770
!المعذرة

148
00:09:20,770 --> 00:09:22,540
!نريد تفسيراً

149
00:09:21,390 --> 00:09:25,010
!مُنتجكم كذبة وقِحة

150
00:09:24,410 --> 00:09:25,940
!هذا هُراء

151
00:09:28,980 --> 00:09:30,710
!خذوا هذه مع اعتذارنا الشّديد

152
00:09:30,710 --> 00:09:31,640
!ماذا؟

153
00:09:31,640 --> 00:09:33,730
!يا له من متجر عظيم

154
00:09:38,340 --> 00:09:41,670
أريد الاستقالة من هذا العمل حالاً

155
00:09:42,420 --> 00:09:43,610
شكراً لك

156
00:09:43,610 --> 00:09:46,110
ساعدتَني في استجماعِ شجاعتي

157
00:09:46,110 --> 00:09:46,850
تفضّلي

158
00:09:49,420 --> 00:09:51,970
سوف أنقذ قلبكِ

159
00:09:52,410 --> 00:09:53,930
ذكّرني من تكون؟

160
00:09:53,930 --> 00:09:56,010
!رانمارو أي

161
00:09:57,550 --> 00:10:00,770
ما المعنى الذي يحمله اسم؟

162
00:10:01,240 --> 00:10:04,670
تسمية الشّيء يعني فقدان جوهر هذا الشيء

163
00:10:04,670 --> 00:10:07,360
تتردّد أصداؤه في صمت بلا أي معنى

164
00:10:18,700 --> 00:10:21,910
!مُحال! هذه عرقلةٌ للعمل

165
00:10:21,910 --> 00:10:23,360
!هذه مُضايقة وأذى

166
00:10:23,360 --> 00:10:25,650
!لم أعد أستطيع العمل هنا فحسب

167
00:10:25,950 --> 00:10:28,610
!إذا استقلتِ، سأقاضيكِ بمبلغ ضخم

168
00:10:29,860 --> 00:10:32,780
...إذا كان هذا المُنتج مُزيّفاً كما تدّعين

169
00:10:33,610 --> 00:10:36,320
فهذا يجعلكِ متواطئة في عمليّة الاحتيال، أليس كذلك؟

170
00:10:41,010 --> 00:10:42,840
مرحباً؟ أمّي؟

171
00:10:42,840 --> 00:10:44,800
—آسفة، ما زلتُ في العمل

172
00:10:45,620 --> 00:10:48,350
جدّتي... في حالة حرجة؟

173
00:10:49,810 --> 00:10:53,040
!آسفة، عليّ الذهاب إلى المنزلِ حقّاً

174
00:10:53,040 --> 00:10:55,080
!جدّتي تموت

175
00:10:55,080 --> 00:10:57,680
لن تلحقي على أي حال

176
00:10:57,680 --> 00:11:02,260
!لكن... أريد أن أتواجد هناك لأودّعها على الأقلّ

177
00:11:02,700 --> 00:11:04,650
إنّها مجرّد جدّة

178
00:11:04,650 --> 00:11:06,720
!لو كان أحد والديكِ، لتعاطفتُ رُبّما

179
00:11:07,450 --> 00:11:08,940
...لا

180
00:11:11,020 --> 00:11:15,400
في عالمٍ يتوجّب عليّ فيه أن أتجرّد
...من المشاعر فقط لأداء عملي

181
00:11:16,590 --> 00:11:18,920
هل من فائدة من العيش فيه؟

182
00:11:21,970 --> 00:11:23,920
...بضع خطوات فقط

183
00:11:25,050 --> 00:11:27,110
...وأرى جدّتي

184
00:11:31,130 --> 00:11:34,150
سأكون معكِ قريباً

185
00:11:44,710 --> 00:11:46,020
...أنت

186
00:11:59,090 --> 00:12:03,530
دائماً ما أستخدم عملي كعذر

187
00:12:03,720 --> 00:12:06,320
لم أردها أن تراني هكذا

188
00:12:06,970 --> 00:12:11,210
لا أتخيّل أنّها ستكون سعيدة برؤيتي هكذا

189
00:12:14,730 --> 00:12:18,680
ستكون سعيدة برؤيتكِ تحت أي ظرفٍ كان

190
00:12:21,810 --> 00:12:23,090
أشتاق إليها

191
00:12:25,230 --> 00:12:28,010
!أريد رؤية جدّتي حالاً

192
00:12:29,070 --> 00:12:32,510
سوف أنقذ قلبكِ

193
00:12:33,210 --> 00:12:34,640
رانمارو؟

194
00:12:46,320 --> 00:12:49,450
هل يمكنني أخذ قلبكِ؟

195
00:12:49,740 --> 00:12:52,030
قلبي؟

196
00:12:53,720 --> 00:12:54,680
أجل

197
00:13:56,240 --> 00:13:58,060
!إبطال الممنوع

198
00:13:58,060 --> 00:13:59,640
!الحبّ بكامل تفتّحه

199
00:14:00,070 --> 00:14:04,220
!قدوم جنّي التّنوير، رانمارو

200
00:14:06,100 --> 00:14:08,610
هل تحاولين تدميرنا؟

201
00:14:09,010 --> 00:14:11,960
!يبدو أنّني سأخصم من راتبكِ

202
00:15:36,650 --> 00:15:39,530
ما هذا المكان؟

203
00:15:40,260 --> 00:15:43,340
هل هذا... رانمارو؟

204
00:15:51,280 --> 00:15:56,340
!أ-أ-أرجوك اسمعيني! أ-أ-أنا نادم على كلّ شيء

205
00:15:57,970 --> 00:16:01,410
سامحيني أرجوكِ! كنتُ أفعل ما أملاه
!عليّ مُدرائي فحسب

206
00:16:01,410 --> 00:16:02,770
!كنتُ أتبع الأوامر فحسب

207
00:16:03,360 --> 00:16:08,510
هذا لا يُبرِّر مُعاملتك الفظيعة لي

208
00:16:10,260 --> 00:16:12,080
سامحيه

209
00:16:12,080 --> 00:16:17,490
يحاول ابني أن يفعل ما بوسعه لحمايةِ عائلته فحسب

210
00:16:18,530 --> 00:16:25,690
مرضتُ وكان هو يعمل بجدٍّ ليسدّد ثمن علاجي

211
00:16:25,690 --> 00:16:28,700
إنّه فتى ظريف ولطيف

212
00:16:28,700 --> 00:16:30,500
ستُسامحينه، أليس كذلك؟

213
00:16:32,360 --> 00:16:35,830
!أتوسّل إليكِ، سامحيه. أتوسّل إليكِ

214
00:16:35,830 --> 00:16:38,130
!سامحيني! سامحيني

215
00:16:43,090 --> 00:16:44,530
هل ستفعلها؟

216
00:16:46,180 --> 00:16:47,920
ماذا؟

217
00:16:47,920 --> 00:16:51,200
هل ستستخدم نور العدالةِ لإسقاطِ رجل

218
00:16:51,200 --> 00:16:54,820
ضعيف تائب بصدق؟

219
00:16:55,460 --> 00:16:56,530
من أنت؟

220
00:16:58,420 --> 00:17:00,650
هل يُعقَل أنّك نسيتني؟

221
00:17:01,150 --> 00:17:03,170
اسمي تشيلكا

222
00:17:03,930 --> 00:17:05,150
تشيلكا؟

223
00:17:08,170 --> 00:17:09,500
تشيلكا؟

224
00:17:09,500 --> 00:17:11,160
من هو هذا؟

225
00:17:11,160 --> 00:17:12,870
هل هو وراء كلّ هذه الأمور؟

226
00:17:13,050 --> 00:17:15,260
...سامحيه أرجوكِ

227
00:17:15,260 --> 00:17:17,610
!أرجوكِ، أتوسّل إليكِ

228
00:17:18,070 --> 00:17:19,810
!لن أكرّرها

229
00:17:19,810 --> 00:17:21,850
!سامحيني أرجوكِ

230
00:17:22,090 --> 00:17:25,050
حسناً؟ ماذا ستفعل؟

231
00:17:26,760 --> 00:17:29,740
!سامحيه! سامحيه

232
00:17:29,740 --> 00:17:32,700
!سامحيني! سامحيني

233
00:17:35,060 --> 00:17:38,360
!رانمارو! دعه وشأنه من فضلك

234
00:17:38,590 --> 00:17:41,070
!أقبلُ باعتذاره

235
00:17:50,410 --> 00:17:57,210
!شكراً جزيلاً لك

236
00:18:04,870 --> 00:18:08,570
!أيّتها الحمقاء

237
00:18:16,550 --> 00:18:17,830
!رانمارو

238
00:18:20,440 --> 00:18:21,440
!رانمارو

239
00:18:21,830 --> 00:18:23,010
!تراجعوا

240
00:18:23,010 --> 00:18:24,050
...لكن

241
00:18:24,050 --> 00:18:25,460
!ابقوا حيث أنتم

242
00:18:25,690 --> 00:18:28,650
!إن خرجتُم... ستموتون

243
00:18:43,520 --> 00:18:45,840
!تستحقّين هذا

244
00:18:45,840 --> 00:18:49,240
!والآن ستكونين عبدة لعملي للأبد

245
00:19:22,230 --> 00:19:23,800
!رانمارو

246
00:19:24,290 --> 00:19:26,350
...بيتيلغيوس

247
00:19:26,350 --> 00:19:28,460
فهمتُ الآن

248
00:19:30,560 --> 00:19:33,140
!كنتُ أمزح بشأنِ كلّ ذلك! كانت مجرّد مزحة

249
00:19:35,420 --> 00:19:38,680
!أون مايالتا هاريكيرا

250
00:19:51,180 --> 00:19:53,520
!افتح حقيقة القلب

251
00:20:02,720 --> 00:20:04,510
!انتقال الأمّ المُقدّسة

252
00:20:08,600 --> 00:20:13,250
!فلتذهب إلى الجنّة

253
00:20:26,570 --> 00:20:29,740
شكراً لك... يا رانمارو

254
00:20:32,590 --> 00:20:38,890
!أنت أكثر شخص... أمقته

255
00:20:40,450 --> 00:20:42,680
تشيلكا؟

256
00:20:44,210 --> 00:20:45,960
!هذا رانمارو الذي عهِدناه

257
00:20:49,770 --> 00:20:51,060
تشيلكا؟

258
00:20:51,060 --> 00:20:51,770
أجل

259
00:20:51,770 --> 00:20:53,460
هذا ما قاله

260
00:20:53,860 --> 00:20:55,690
تابع التحرّي

261
00:20:56,110 --> 00:20:58,270
...لكن إذا تخلّى عن اسمه

262
00:20:59,370 --> 00:21:02,010
نبذَ ماذيه وسقطَ في الظلام

263
00:21:03,060 --> 00:21:04,770
لا حاجة للتردّد إذاً

264
00:21:05,810 --> 00:21:07,210
اقضوا عليه

265
00:21:08,400 --> 00:21:11,370
طُردت من عملك؟

266
00:21:11,370 --> 00:21:14,400
!لا تعُد حتّى تكسب من جديد أيُّها الوغد

267
00:21:14,400 --> 00:21:16,460
!آسف

268
00:21:16,940 --> 00:21:20,720
تفاجأتُ كثيراً عندما أتيتِ إلى المشفى

269
00:21:21,200 --> 00:21:24,420
أجل. وجدتُ نفسي فجأة واقِفة هناك

270
00:21:24,940 --> 00:21:30,020
أنا متأكّدة أنّها فرِحَتْ بسماع صوتك في النِّهاية

271
00:21:36,100 --> 00:21:38,220
هل أنقذَها؟

272
00:21:38,530 --> 00:21:39,670
من يدري؟

273
00:21:39,670 --> 00:21:43,920
لعلّ عملنا لا يكون أكثر من مجرّد علاج مؤقّت

274
00:21:44,560 --> 00:21:50,330
لكن لا أستطيع الوقوف مكتوف الأيدي
عندما يتأذّى قلب شخص

275
00:21:52,120 --> 00:21:53,950
!هذا هو رانمارو الذي نعرفه

276
00:21:53,950 --> 00:21:55,850
!رائع للغاية

277
00:21:55,850 --> 00:21:59,520
بالمناسبة، إن كنتَ تعرف أي فتاة، فلا تنسَني

278
00:21:59,520 --> 00:22:02,490
...أنت أيضاً يا جيوكا، إن عرفت أي