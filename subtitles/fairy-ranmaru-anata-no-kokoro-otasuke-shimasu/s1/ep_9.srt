1
00:00:02,450 --> 00:00:05,210
"هذا العالم هو إمّا أن تقتل أو تُقتل"

2
00:00:05,210 --> 00:00:07,340
"لا يوجد ما يُدعى بالجنّة"

3
00:00:07,790 --> 00:00:09,940
"حالما تسقط، يُفقد الأمل"

4
00:00:09,940 --> 00:00:12,570
هناك أشخاص يعانون بسبب هذه المُعتقدات

5
00:00:13,090 --> 00:00:15,600
!مهلاً! أنت

6
00:00:15,600 --> 00:00:18,300
هل تتظاهر أنّك لا ترى ذلك؟

7
00:00:18,540 --> 00:00:21,390
من المؤسف ألّا نستطيع فعل المثل

8
00:00:21,390 --> 00:00:24,250
نأمل أن نمسح دموعك

9
00:00:24,470 --> 00:00:27,240
سندع البسمات تتفتّح بين الجماهير

10
00:00:27,240 --> 00:00:30,220
وبالطبع، التّعويض مطلوب

11
00:00:30,640 --> 00:00:33,750
زُر الحانة ف فحسب

12
00:00:33,750 --> 00:00:36,750
لا تقلق... لا حاجة للمال

13
00:00:36,750 --> 00:00:41,270
!هناك شيء واحد نريده

14
00:00:42,240 --> 00:00:45,800
!سوف نأخذ قلبك

15
00:02:26,750 --> 00:02:29,510
!أمّي! انظري

16
00:02:29,510 --> 00:02:32,770
!حللتُ في المركز الأوّل في مسابقة الرّسم

17
00:02:33,360 --> 00:02:34,890
...لذا شجّعيني من فضلك

18
00:02:40,070 --> 00:02:41,530
!أمّي؟

19
00:02:52,320 --> 00:02:55,270
العالم الجميل

20
00:02:56,530 --> 00:03:00,170
سأحمي ما هو لائق فيه

21
00:03:08,570 --> 00:03:10,500
!عدنا

22
00:03:11,490 --> 00:03:13,180
!تسرّني رؤيتكم

23
00:03:15,470 --> 00:03:18,180
هومورا! هل تحسّنت؟

24
00:03:18,680 --> 00:03:19,690
أجل

25
00:03:25,050 --> 00:03:27,320
يسرّني أنّ الأمور سارت على ما يُرام

26
00:03:27,320 --> 00:03:29,570
!عاد الأنمي إلى مساره أيضاً

27
00:03:30,050 --> 00:03:31,700
...أ-أجل

28
00:03:35,650 --> 00:03:37,580
عنيد جدّاً تأبى الذّهاب عندما يحين دورك، صحيح؟

29
00:03:37,580 --> 00:03:38,690
!ماذا؟

30
00:03:39,600 --> 00:03:41,310
!كيف تجرؤ؟

31
00:03:41,310 --> 00:03:43,770
!أورو هو من أنقذك يا هومورا

32
00:03:43,770 --> 00:03:44,700
ماذا؟

33
00:03:45,590 --> 00:03:47,150
لا أقول أنّني أنقذتُك

34
00:03:47,510 --> 00:03:49,460
أردتُك حيّاً فحسب

35
00:03:51,720 --> 00:03:54,640
!فأنا الوحيد الّذي يُسمَح لي بقتلك

36
00:03:54,640 --> 00:03:56,220
!ماذا؟

37
00:03:57,520 --> 00:03:59,910
مهلاً، عليك أن تأخذ الأمور برويّة

38
00:04:07,770 --> 00:04:10,080
يبدو أنّ هومورا قد تعافى

39
00:04:10,990 --> 00:04:14,480
لكن أشكُّ أنّه سيعود إلى الميدان بسرعة

40
00:04:17,620 --> 00:04:19,930
هل أنتِ مستاءة؟

41
00:04:20,950 --> 00:04:22,110
بالطبع لا

42
00:04:23,530 --> 00:04:25,100
تتحرّك بسرعة فائقة

43
00:04:37,770 --> 00:04:39,220
افتقدتُك

44
00:04:39,670 --> 00:04:40,930
افتقدتُك أيضاً

45
00:04:41,200 --> 00:04:42,120
...ماما

46
00:04:56,760 --> 00:04:58,360
لا أستطيع فعل هذا اليوم

47
00:05:09,180 --> 00:05:10,390
لماذا؟

48
00:05:12,290 --> 00:05:14,370
كانت تبدو جميلة جدّاً

49
00:05:16,210 --> 00:05:18,340
دُنّس قلبي

50
00:05:23,680 --> 00:05:26,130
لوحاتي لا تحقّق نجاحاً

51
00:05:26,500 --> 00:05:27,420
حقّاً؟

52
00:05:27,760 --> 00:05:29,630
أراها جميلة جدّاً

53
00:05:29,820 --> 00:05:31,570
لكنّها كذبة

54
00:05:31,910 --> 00:05:32,790
كذبة؟

55
00:05:33,460 --> 00:05:36,250
لم يكن الرّسم الأوّلي مثاليّاً

56
00:05:36,690 --> 00:05:38,820
والألوان غير دقيقة

57
00:05:39,150 --> 00:05:42,860
اللّوحة ليست بديلاً عن صورة على أي حال

58
00:05:42,860 --> 00:05:44,150
...لكن رسمكِ

59
00:05:45,440 --> 00:05:50,790
إنّه إعادة صياغة مثاليّة للمشهد كما
كما يُصوّره قلبكِ

60
00:05:52,590 --> 00:05:54,540
لديكِ قلب صادق

61
00:05:55,020 --> 00:05:56,770
قلب صادق؟

62
00:05:57,450 --> 00:05:58,980
أشكّ في ذلك

63
00:06:00,720 --> 00:06:03,670
إذا وجدتِ نفسكِ بحاجة لمُساعدة، فلا
تتردّدي عن الاتّصال بي

64
00:06:07,350 --> 00:06:11,010
سوف ننقذ قلبك"؟"

65
00:06:12,050 --> 00:06:16,130
لكن يتعذّر إنقاذي قطعاً

66
00:06:23,690 --> 00:06:24,830
!عُدت

67
00:06:25,750 --> 00:06:27,900
!آسفة لخروجي حتّى وقت متأخّر

68
00:06:28,210 --> 00:06:29,450
لا عليكِ

69
00:06:29,450 --> 00:06:31,130
أين كنتِ؟

70
00:06:31,130 --> 00:06:33,580
أتنزّه مع صديقة

71
00:06:33,880 --> 00:06:37,960
تعرفين شوجي، زميلكِ في الحضانة؟ أمّه

72
00:06:39,090 --> 00:06:40,530
هكذا إذاً

73
00:06:40,530 --> 00:06:45,190
سمعتُ أنّ المتحف سيعرض إحدى لوحاتكِ

74
00:06:45,560 --> 00:06:47,770
...أجل

75
00:06:47,770 --> 00:06:49,020
!هذا مذهل

76
00:06:49,640 --> 00:06:53,490
قال مُستشاركِ أنّ لديكِ مُستقبل واعد جدّاً

77
00:06:53,490 --> 00:06:56,790
!سأكون هُناك لرؤيتها

78
00:06:56,790 --> 00:06:57,720
حسناً

79
00:06:58,470 --> 00:07:00,290
تأخّر الوقت يا بيريكا

80
00:07:00,290 --> 00:07:01,510
أنا آسفة

81
00:07:01,980 --> 00:07:03,960
سأعدّ العشاء

82
00:07:04,330 --> 00:07:06,860
لا تقلقي. أكلتُ بالفعل

83
00:07:07,230 --> 00:07:08,430
أنا آسفة

84
00:07:09,550 --> 00:07:11,790
المكان فوضويّ

85
00:07:12,110 --> 00:07:15,210
إذا أردتِ أن تدّعي أنّكِ ربّة منزل، على
الأقلّ نظّفيه ورتّبيه

86
00:07:15,860 --> 00:07:16,670
حاضرة يا عزيزي

87
00:07:17,130 --> 00:07:19,170
ما رأيكِ أن نأكل شيئاً في الخارج؟

88
00:07:20,510 --> 00:07:21,430
حسناً

89
00:07:27,600 --> 00:07:30,650
أمّي تخون أبي

90
00:07:32,410 --> 00:07:36,310
ذاك الرّجل الآخر يدمّر عائلتي

91
00:07:37,050 --> 00:07:39,260
!أنا متأكّدة أنّه يستغلّها بطريقة ما

92
00:07:39,260 --> 00:07:42,320
!يستغلّها بطريقة ما

93
00:07:47,600 --> 00:07:51,830
تمّ استغلال أمّك بواسطة مُجرمي عشيرة إغنيس

94
00:07:52,160 --> 00:07:54,570
،العلاقات مع الجنس الآخر داخل العشائر

95
00:07:54,930 --> 00:07:58,210
لا سيّما بين عشيرة آكوا والمُكلّفة
،بالشؤون الحكوميّة

96
00:07:58,210 --> 00:08:01,670
،وعشيرة إغنيس، المُكلّفة بالشؤون القتاليّة

97
00:08:01,670 --> 00:08:05,790
مُحرّمة بالقانون باسم التفريق بين المدنيين والعسكريّين

98
00:08:06,430 --> 00:08:12,260
ثمّة عصابة تخطّط لسقوطي استغلّت أمّك ضدّي

99
00:08:12,960 --> 00:08:15,340
كانت ضحيّة مسكينة

100
00:08:20,780 --> 00:08:23,270
ماذا تريدين أن يتحقّق؟

101
00:08:24,190 --> 00:08:26,870
،لو يرحل ذلك الرّجل

102
00:08:26,870 --> 00:08:29,480
سيعود كلّ شيء إلى ما كان عليه

103
00:08:29,780 --> 00:08:32,450
وستعود أمّي إلى ما كانت عليه

104
00:08:35,460 --> 00:08:38,110
أتفهّم شعورك

105
00:08:38,870 --> 00:08:42,600
أورو... شكراً لك على استيعابي

106
00:08:44,110 --> 00:08:45,930
الماء دائم التغيُّر

107
00:08:45,930 --> 00:08:47,750
يتموّج ويتحوّل

108
00:08:47,750 --> 00:08:49,540
إنّه غير ثابت جوهريّاً

109
00:08:50,340 --> 00:08:53,580
باعتدال، يغذّي الحياة

110
00:08:53,930 --> 00:08:56,070
...لكن الضّرر الذي يُسبّبه فيضان

111
00:08:56,070 --> 00:08:57,410
هائل

112
00:09:14,330 --> 00:09:17,660
!إنّها موهوبة بحقّ

113
00:09:17,660 --> 00:09:18,780
حقّاً؟

114
00:09:18,780 --> 00:09:20,430
!بالتأكيد

115
00:09:21,090 --> 00:09:22,680
!يسرّني ذلك

116
00:09:22,680 --> 00:09:23,730
...ماما

117
00:09:30,080 --> 00:09:31,480
!مرحباً

118
00:09:32,490 --> 00:09:34,380
طلبتُ لكِ قهوة

119
00:09:34,700 --> 00:09:38,050
أم أطلب لكِ عصير برتقال؟

120
00:09:38,540 --> 00:09:41,560
لا هذا ولا ذاك. لستُ عطشانة

121
00:09:42,100 --> 00:09:45,550
تتحدّث أمّكِ عنكِ طوال الوقت

122
00:09:45,550 --> 00:09:47,510
تدرسين الفنون حسبما سمعت

123
00:09:47,970 --> 00:09:50,600
أنت تُقابل أمّي إذاً

124
00:09:52,350 --> 00:09:54,860
طلبَتْ مشورتي بشأن مُستقبلكِ

125
00:09:55,390 --> 00:10:01,090
طلبَتْ منّي استخدام علاقاتي في المتحف لتأمين
شاغر لكِ في مدرسة فنون خارج البلاد

126
00:10:01,090 --> 00:10:02,610
!لم أطلب ذلك

127
00:10:02,810 --> 00:10:05,090
حقّاً؟

128
00:10:05,520 --> 00:10:07,870
!ابتعد عن أمّي

129
00:10:07,870 --> 00:10:10,050
هذا ليس قراري

130
00:10:10,360 --> 00:10:12,990
إنّه قرار أمّكِ، أليس كذلك؟

131
00:10:16,040 --> 00:10:18,570
أنتِ جميلة عندما تغضبين

132
00:10:19,320 --> 00:10:20,400
!توقّف عن ذلك

133
00:10:20,710 --> 00:10:23,220
تُشبهين أمّكِ كثيراً

134
00:10:42,870 --> 00:10:44,210
...أورو

135
00:10:51,550 --> 00:10:54,530
...أمّي... بين يدي ذلك الرّجل

136
00:10:54,920 --> 00:10:56,960
...أمّي المسكينة

137
00:10:57,730 --> 00:11:00,040
دعي كلّ شيء لي

138
00:11:03,370 --> 00:11:06,670
!سوف أنقذ قلبكِ

139
00:12:14,800 --> 00:12:16,540
!إبطال الممنوع

140
00:12:17,020 --> 00:12:19,160
!الحبّ بغزارة

141
00:12:19,830 --> 00:12:24,500
!ظهور جنّي البريق، أورو

142
00:12:27,440 --> 00:12:31,640
لنأخذ بيريكا معنا إلى العشاء في المرّة المقبلة

143
00:12:33,290 --> 00:12:38,660
لا أمانع إعالتكما أنتِ وابنتكِ معاً

144
00:14:20,070 --> 00:14:21,100
ما هذا المكان؟

145
00:14:22,250 --> 00:14:23,220
ماذا؟

146
00:14:23,220 --> 00:14:24,750
أورو؟

147
00:14:25,760 --> 00:14:27,500
...كيف تجرؤ

148
00:14:28,060 --> 00:14:30,680
!تدخّلت عند أهمّ لحظة

149
00:14:36,980 --> 00:14:39,050
أ-أمّي؟

150
00:14:40,250 --> 00:14:41,740
!اشتقتُ إليك

151
00:14:41,740 --> 00:14:43,060
اشتقتُ إليك أيضاً

152
00:14:44,370 --> 00:14:45,580
...هذا

153
00:14:52,830 --> 00:14:54,190
!فلتمُت

154
00:14:54,460 --> 00:14:56,170
!توقّف

155
00:14:59,290 --> 00:15:03,310
!أرجوك! لا تؤذِه

156
00:15:04,120 --> 00:15:05,710
...أمّي

157
00:15:13,740 --> 00:15:18,200
!لن تنسى تلك المرأة جسدي أبداً

158
00:15:18,200 --> 00:15:19,780
!أغلق فمك المقرف

159
00:15:20,130 --> 00:15:22,390
!لم يرتكب أي خطأ

160
00:15:24,100 --> 00:15:27,310
!إنّها أكثر عاهرة رأيتُها في حياتي

161
00:15:28,970 --> 00:15:30,270
!مُت

162
00:15:32,450 --> 00:15:33,650
!لا

163
00:15:36,780 --> 00:15:38,630
!كُفّ عن هذا يا أورو

164
00:15:39,260 --> 00:15:43,090
!أصبحت مثل أبيك تماماً

165
00:15:51,060 --> 00:15:52,240
أين أنا؟

166
00:15:53,100 --> 00:15:57,230
!ربّما سأعرّضك لنفس المُعاناة التي عانيتُها

167
00:16:07,900 --> 00:16:08,980
!أورو

168
00:16:08,980 --> 00:16:12,710
ألا يروقك انصهار القلب هذا؟

169
00:16:14,390 --> 00:16:16,700
!لا جدوى! لا يمكننا التقدّم أكثر

170
00:16:16,700 --> 00:16:19,410
هذا جزء مفصول من قلب أورو

171
00:16:19,410 --> 00:16:21,590
!لا يمكننا الدخول

172
00:16:24,240 --> 00:16:25,510
!يا للهول

173
00:16:26,110 --> 00:16:27,960
!إنه هو من جديد

174
00:16:27,960 --> 00:16:30,280
لا تقلقوا. إنه مفصول أيضاً

175
00:16:32,010 --> 00:16:33,550
...هذه الروح الشرّيرة

176
00:16:33,550 --> 00:16:36,830
إنّها الرّوح التي لا يستطيع البريق هزيمتها

177
00:16:38,850 --> 00:16:43,400
أظهِر لهُنّ قليلاً من العطف والمودّة، وسيمنحنَك كلّ شيء

178
00:16:43,400 --> 00:16:47,900
لكنّهن بغيضات جدّاً عندما يسرحن
"في أحلام "الحبّ الحقيقيّ

179
00:16:47,900 --> 00:16:51,230
!كنت تستغلّ أمّي فعلاً إذاً

180
00:16:51,620 --> 00:16:56,190
هل أمنحكِ ما تحلم به النساء أيضاً؟

181
00:16:58,040 --> 00:16:59,300
...اصمت

182
00:17:08,470 --> 00:17:10,040
!أمّي

183
00:17:10,040 --> 00:17:13,300
!حللتُ الأوّل في المدرسة

184
00:17:17,060 --> 00:17:19,510
!هذا ساخن... ساخن جدّاً

185
00:17:19,510 --> 00:17:21,560
!لم يراودني شعور كهذا من قبل

186
00:17:21,560 --> 00:17:22,800
!أحبّك

187
00:17:22,800 --> 00:17:24,080
...شكراً لك

188
00:17:24,080 --> 00:17:25,940
...أحبّك أيضاً

189
00:17:25,940 --> 00:17:27,420
!أحبّك حبّاً جمّاً

190
00:17:32,150 --> 00:17:33,510
...هذا ساخن جدّاً

191
00:17:33,820 --> 00:17:34,910
!أورو

192
00:17:35,340 --> 00:17:37,440
...يا ابن البريق

193
00:17:37,440 --> 00:17:40,120
!تبخّر واصعد

194
00:17:40,640 --> 00:17:42,180
...أجل، أنا

195
00:17:44,610 --> 00:17:46,130
أنا قادم

196
00:17:49,650 --> 00:17:50,910
!هومورا

197
00:17:51,140 --> 00:17:52,640
!لهب؟

198
00:18:01,760 --> 00:18:03,020
!ماذا؟

199
00:18:04,390 --> 00:18:07,030
أورو! ما خطبك؟

200
00:18:07,030 --> 00:18:08,680
لماذا أنت هنا؟

201
00:18:08,880 --> 00:18:10,920
أردُّ الجميل فحسب، مفهوم؟

202
00:18:10,920 --> 00:18:12,660
!اقضِ عليه بسرعة

203
00:18:13,570 --> 00:18:14,910
!طفل بغيض

204
00:18:15,860 --> 00:18:18,200
!أون مايالتا هاريكيرا

205
00:18:31,630 --> 00:18:33,950
!افتح حقيقة القلب

206
00:18:43,000 --> 00:18:45,550
!انتقال الأمّ المُقدّسة

207
00:18:49,090 --> 00:18:53,570
!فلتذهبي إلى الجنّة

208
00:19:08,370 --> 00:19:11,580
شكراً لك... يا أورو

209
00:19:13,840 --> 00:19:14,980
هل أنت بخير؟

210
00:19:14,980 --> 00:19:16,540
!لا تُتعب نفسك أكثر

211
00:19:19,840 --> 00:19:24,290
هل تدرك ما سيحدث عندما تجتمع
العناصر الخمسة معاً؟

212
00:19:25,170 --> 00:19:28,710
سوف تُنبذ كما كنتَ آنذاك

213
00:19:29,010 --> 00:19:33,270
يُشغّلونك حتّى تُنهك تماماً كخرقة بالية

214
00:19:35,970 --> 00:19:39,370
يبدو أنّ هومورا لم يدرك ذلك بعد

215
00:19:40,310 --> 00:19:44,190
لكنّها ليست سوى مسألة وقت

216
00:19:45,160 --> 00:19:48,160
أثِق بك

217
00:19:50,400 --> 00:19:53,330
أثِق أنّك أنت الوحيد لن تخونني أبداً

218
00:19:59,960 --> 00:20:01,390
...هل كنت تعرف

219
00:20:02,460 --> 00:20:04,810
هل كنت تعرف أمّي؟

220
00:20:05,870 --> 00:20:08,990
كيف علمت بوفاتها؟

221
00:20:09,320 --> 00:20:13,720
لم يخبر أبي أحداً بسبب الفضيحة التي
كان ليُسبّبها ذلك

222
00:20:15,470 --> 00:20:17,900
كانت أمّي تخونه

223
00:20:17,900 --> 00:20:20,660
،لكن الرّجل الآخر تركها

224
00:20:20,660 --> 00:20:22,700
وقتلت نفسها من شدّة الحزن

225
00:20:23,360 --> 00:20:27,700
لم نشعر أنّها تستحقّ عزاء

226
00:20:28,300 --> 00:20:33,370
كان تعلّق تلك المرأة التي في مُنتصف
العمر بي مُزعجاً للغاية

227
00:20:33,650 --> 00:20:35,800
!لا أعلم لمَ لم أتركها في وقتٍ أبكر

228
00:20:35,800 --> 00:20:37,810
!فتاة مسكينة

229
00:20:39,140 --> 00:20:43,020
،حتّى لو انحرفت عن الطريق وأذيت الآخرين

230
00:20:43,020 --> 00:20:45,860
قد لا تحظى بالسّعادة

231
00:20:47,960 --> 00:20:50,390
يا له من عالم مُحزِن

232
00:21:06,770 --> 00:21:09,040
رحّبت أمّي بالموت بابتسامة

233
00:21:10,460 --> 00:21:12,900
بدَتْ مرتاحة

234
00:21:32,700 --> 00:21:36,790
إذا كان هناك ما يجرحك، فضفِض عنه فحسب

235
00:21:40,860 --> 00:21:42,390
...هذا ساخن جدّاً

236
00:21:59,030 --> 00:22:01,950
لم يأتِ الأسوأ بعد