1
00:00:07,990 --> 00:00:09,480
!رانمارو

2
00:00:10,210 --> 00:00:11,610
!هل أنت بخير يا رانمارو؟

3
00:00:11,610 --> 00:00:12,670
!استيقظ

4
00:00:12,670 --> 00:00:13,790
!رانمارو

5
00:00:18,460 --> 00:00:22,680
!رانمارو

6
00:00:24,140 --> 00:00:25,510
!الوقت يُداهمنا

7
00:00:33,330 --> 00:00:35,050
ما كلّ هذا بالضبط؟

8
00:00:39,470 --> 00:00:40,750
!هوجو

9
00:00:43,490 --> 00:00:47,840
سيريوس... أسقطَ ملِكتنا

10
00:00:49,170 --> 00:00:52,730
!أتوسّل إليكم... أنقذوها

11
00:00:53,170 --> 00:00:54,490
!ارتح حاليّاً

12
00:00:54,920 --> 00:00:57,000
سوف أنجو

13
00:00:58,380 --> 00:00:59,430
...رانمارو

14
00:01:00,270 --> 00:01:01,260
!خذ هذا

15
00:01:07,470 --> 00:01:10,700
أنت رئيس عشيرة تيرّا الجديد إذاً؟

16
00:01:10,700 --> 00:01:11,620
أنت يافع جدّاً

17
00:01:12,000 --> 00:01:14,560
مـ-من دواعي سروري أن أخدمك

18
00:01:16,880 --> 00:01:18,580
لديك وجه جذّاب

19
00:01:20,690 --> 00:01:24,040
أعيّنك هاهُنا حارسي الزمنيّ

20
00:01:24,820 --> 00:01:26,460
أدِرْه بشكلٍ دقيق

21
00:01:27,140 --> 00:01:28,760
!سمعاً وطاعة

22
00:01:31,350 --> 00:01:35,180
!احمِ الملكة... بالنيابة عنّي

23
00:01:35,920 --> 00:01:39,200
!رانمارو... لا، بيتيلغيوس

24
00:01:40,040 --> 00:01:42,720
أثِق بك

25
00:01:45,930 --> 00:01:47,200
!هوجو

26
00:01:59,130 --> 00:02:02,870
!سوف نأخذ قلبك

27
00:02:52,390 --> 00:02:54,130
!إبطال الممنوع

28
00:02:54,130 --> 00:02:55,830
!الحبّ بكامل تفتّحه

29
00:02:55,830 --> 00:02:58,360
!جنّي النّور، رانمارو

30
00:02:58,360 --> 00:03:01,070
!جنّي اللّهب، هومورا

31
00:03:01,070 --> 00:03:04,110
!جنّي البريق، أورو

32
00:03:04,110 --> 00:03:06,500
!جنّي الخضرة، جيوكا

33
00:03:06,500 --> 00:03:09,000
!جنّي الذّهب، تاكارا

34
00:03:09,000 --> 00:03:10,450
!وصول

35
00:04:42,090 --> 00:04:46,290
وها هي نهايتك قد حانت على عرش
مملكة ميّتة

36
00:04:46,290 --> 00:04:48,660
كم أنتِ أضحوكة

37
00:04:48,660 --> 00:04:52,990
كان ينبغي أن تستسلمي وتموتي
في آخر مرّة حاولتُ فيها

38
00:04:53,680 --> 00:04:56,940
!والآن... ابكي! اصرخي

39
00:04:56,940 --> 00:04:59,560
!اسجدي أمامي وتوسّلي غفراني

40
00:04:59,560 --> 00:05:01,820
!إذا أردت قتلي، فافعل ذلك حالاً إذاً

41
00:05:02,370 --> 00:05:07,390
!سأذلّك إذلالاً أصعب من الموت

42
00:05:12,070 --> 00:05:14,530
!بيتيلغيوس! لقد أتيت

43
00:05:14,530 --> 00:05:17,960
!والآن أرسل سيريوس إلى الجحيم

44
00:05:23,350 --> 00:05:25,730
هل موتك الوشيك أفقدك صوابك؟

45
00:05:26,110 --> 00:05:28,390
ترتكبين خطأ سوء فهم فادح

46
00:05:29,650 --> 00:05:31,300
ألا تعلمين؟

47
00:05:31,300 --> 00:05:34,470
!لم أكن أنا من دمّر هذه المملكة

48
00:05:34,890 --> 00:05:37,190
...من دمّرها

49
00:05:39,790 --> 00:05:41,890
!كان بيتيلغيوس

50
00:05:42,520 --> 00:05:43,750
!ماذا؟

51
00:05:45,270 --> 00:05:47,330
!أتعتقد أنّك تستطيع إيقافي؟

52
00:05:47,990 --> 00:05:49,950
!ابتعد

53
00:05:50,370 --> 00:05:52,030
!بيتيلغيوس

54
00:05:55,550 --> 00:05:58,270
...لو كان على الأمر أن ينتهي بهذا الشّكل، لما

55
00:05:58,900 --> 00:06:02,050
!لما قمنا بكلّ هذا

56
00:06:03,680 --> 00:06:05,010
لماذا تفعل هذا؟

57
00:06:05,490 --> 00:06:08,780
!ألا تعلم... كيف هو شعوري تجاهك؟

58
00:06:08,780 --> 00:06:11,430
عمّا... عمّاذا تتحدّث؟

59
00:06:26,010 --> 00:06:28,390
ما هو الحبّ؟

60
00:06:28,980 --> 00:06:33,180
!ما هو الحبّ بالضبط؟

61
00:06:43,560 --> 00:06:47,150
هل ما يقوله... صحيح يا بيتيلغيوس؟

62
00:06:51,260 --> 00:06:52,730
!قُل شيئاً

63
00:06:54,680 --> 00:06:57,980
!أجبني يا بيتيلغيوس

64
00:07:12,500 --> 00:07:14,510
!يا للقباحة

65
00:07:14,510 --> 00:07:18,920
!هذه حقيقتك إذاً يا بروكيون

66
00:07:25,360 --> 00:07:27,010
!يجب أن تحترموا ملكتكم

67
00:07:27,010 --> 00:07:28,670
!اركعوا أمامي

68
00:07:34,110 --> 00:07:35,550
!اسجدوا

69
00:07:36,280 --> 00:07:37,760
!على ركبتيكم

70
00:07:38,330 --> 00:07:40,470
!امنحوني كلّ ما أستحقّ

71
00:07:43,370 --> 00:07:47,720
!يجب للماشية أن يؤدّوا غرضهم فقط

72
00:07:48,630 --> 00:07:50,750
!ما هذه القوّة؟

73
00:07:50,750 --> 00:07:52,690
!لا أستطيع الحركة

74
00:07:53,850 --> 00:07:56,660
!لستم بحاجة لفعل شيء سوى خدمتي

75
00:07:59,580 --> 00:08:02,850
!عينان عصيّتان من عبد مُثير للشفقة؟

76
00:08:08,610 --> 00:08:11,880
!سأعلّمك كيف تخدم ملِكتك

77
00:08:13,770 --> 00:08:14,780
!العقها

78
00:08:16,600 --> 00:08:18,800
!هذا أمر من ملِكتك

79
00:08:34,010 --> 00:08:35,490
لماذا تنظر إليّ هكذا؟

80
00:08:39,510 --> 00:08:41,410
!لا تنظر إليّ هكذا

81
00:08:44,240 --> 00:08:45,170
!الآن

82
00:08:48,630 --> 00:08:50,310
—هذه لهوجو

83
00:08:50,850 --> 00:08:54,070
!أون مايالتا هاريكيرا

84
00:08:58,570 --> 00:09:01,840
!أون مايالتا هاريكيرا

85
00:09:07,730 --> 00:09:09,820
!تـ-توقّفوا

86
00:09:11,650 --> 00:09:12,880
!لا تنظروا إليّ

87
00:09:12,880 --> 00:09:16,240
!لا تتعمّقوا أكثر في قلبي

88
00:09:16,240 --> 00:09:18,850
!افتح حقيقة القلب

89
00:09:24,450 --> 00:09:27,040
!ألا تعلم يا هومورا؟

90
00:09:29,370 --> 00:09:34,720
كانت أمّ أورو من تسبّبت بموت أبيك

91
00:09:34,720 --> 00:09:35,750
!ماذا؟

92
00:09:44,380 --> 00:09:45,980
!بيتيلغيوس

93
00:09:45,980 --> 00:09:48,580
!سأدفِعك ثمن ما فعلتَه لي

94
00:09:55,860 --> 00:09:57,040
أين نحن؟

95
00:10:04,340 --> 00:10:06,340
أنا آسف جدّاً... يا أورو

96
00:10:06,950 --> 00:10:09,960
!أرجوك... اقتلني

97
00:10:16,610 --> 00:10:19,840
...أعتقد هذا ما جذب أمّي إليه

98
00:10:20,210 --> 00:10:22,420
هذه العاطفيّة المُلتهبة

99
00:10:25,410 --> 00:10:29,990
أراد أبوك إنقاذ أمّي حتّى لو كلّفه ذلك حياته

100
00:10:30,650 --> 00:10:35,130
كانت على الأرجح لتقتل نفسها حتّى
لو لم يكن قد فعل هو

101
00:10:37,210 --> 00:10:42,660
الدفء الذي منحها إيّاه قُبيل موته

102
00:10:43,370 --> 00:10:45,990
هو ما جعلها تستقبل ذلك بابتسامة

103
00:10:58,750 --> 00:11:01,610
!لماذا تحمي الملكة؟

104
00:11:07,760 --> 00:11:09,400
!اقتلا بعضكما الآخر

105
00:11:10,670 --> 00:11:15,560
!كلّ من يرفض حكمي يستحقّ الموت

106
00:11:19,150 --> 00:11:24,760
كرِهَ أبي حقيقة أنّ القوّة لا يُمكن
أن تحقّق السّعادة

107
00:11:25,800 --> 00:11:29,540
وقوّة النّار قد تؤذي الآخرين بسهولة

108
00:11:30,570 --> 00:11:32,530
لا يمكن للقوانين أن تقيّد القلب

109
00:11:34,650 --> 00:11:39,830
لكن يمكن لحرارة اللّهب الخفيفة أن تُدفئه

110
00:11:41,040 --> 00:11:42,140
...أورو

111
00:11:47,680 --> 00:11:48,560
هومورا

112
00:12:03,890 --> 00:12:05,720
بهذا، أسامحك

113
00:12:06,500 --> 00:12:08,620
حسناً

114
00:12:13,590 --> 00:12:14,590
هيّا بنا

115
00:12:14,590 --> 00:12:17,500
يبدو أنّه ما زال أمامنا عمل غير مُكتمل

116
00:12:17,730 --> 00:12:18,470
!أجل

117
00:12:22,400 --> 00:12:24,370
!ما الأمر يا بيتيلغيوس؟

118
00:12:24,370 --> 00:12:27,840
!هل حياة الرفاهيّة جعلَتْ ردودك الانعكاسيّة بطيئة؟

119
00:12:28,340 --> 00:12:31,080
!مُت! مُت

120
00:12:42,620 --> 00:12:43,850
...هذا

121
00:12:48,930 --> 00:12:50,560
بلدنا المهجور...

122
00:12:55,930 --> 00:12:58,340
تحلّل بشكل كبير

123
00:13:03,190 --> 00:13:05,210
...رائحة الوطن

124
00:13:12,280 --> 00:13:14,340
!نلتُ منك

125
00:13:20,460 --> 00:13:23,230
!انتهى أمرك الآن يا بيتيلغيوس

126
00:13:26,430 --> 00:13:27,440
هومورا

127
00:13:28,720 --> 00:13:29,930
...أبي

128
00:13:30,520 --> 00:13:31,480
...هومورا

129
00:13:31,980 --> 00:13:34,250
،هل يمكنك تحمُّل عبء العدالة

130
00:13:34,250 --> 00:13:38,070
وتطبيق عدالة عبثَ بها الحبّ على الشرّ؟

131
00:13:43,120 --> 00:13:44,280
أورو

132
00:13:45,710 --> 00:13:48,160
!أبي! أبي

133
00:13:48,160 --> 00:13:49,160
...أورو

134
00:13:49,590 --> 00:13:53,840
...هل يمكنك الالتزام، من خلال تطبيق القانون

135
00:13:53,840 --> 00:13:55,260
...وبكلّ محبّة...

136
00:13:55,260 --> 00:13:57,780
بتسليم القيادة لجمهور الأبرياء؟

137
00:14:01,860 --> 00:14:03,050
جيوكا

138
00:14:04,780 --> 00:14:07,200
!أبي! أمّي

139
00:14:07,200 --> 00:14:08,480
...جيوكا

140
00:14:08,480 --> 00:14:11,920
،هل يمكنك الالتزام بمحبّة وتقدير الطبيعة

141
00:14:11,920 --> 00:14:16,120
حتّى لو تخلّت عنك هذه الطبيعة؟

142
00:14:21,010 --> 00:14:22,150
تاكارا

143
00:14:23,880 --> 00:14:26,530
!أمّي! أ-أبي

144
00:14:28,290 --> 00:14:29,420
...تاكارا

145
00:14:29,780 --> 00:14:33,310
،هل يمكنك الالتزام بالحدّ من الفساد والتحلّي بالنزاهة

146
00:14:33,310 --> 00:14:36,760
وإعادة بناء بلدنا بالمحبّة؟

147
00:14:42,040 --> 00:14:45,500
...استمتعتُ باللّعب معك ثانية بعد هذه المدّة الطويلة

148
00:14:46,240 --> 00:14:47,960
يا بيتيلغيوس

149
00:14:49,400 --> 00:14:50,640
أحبّك

150
00:14:51,580 --> 00:14:53,610
!مُت

151
00:14:57,840 --> 00:14:58,960
—ما الّذي

152
00:15:00,300 --> 00:15:02,390
،لو وافقتُ على أن أكون معك

153
00:15:02,390 --> 00:15:04,440
،ومتُّ بعد ذلك بفترة قصيرة

154
00:15:04,440 --> 00:15:06,300
لكنتَ قد تحسّرت على ذلك

155
00:15:06,700 --> 00:15:11,100
أريدك أن تنقذ مزيداً ومزيداً من النّاس

156
00:15:11,960 --> 00:15:16,060
أتقول... أنّها أحبّتني؟

157
00:15:17,000 --> 00:15:19,440
!كانت مريضة

158
00:15:19,440 --> 00:15:20,600
!كاذب

159
00:15:21,340 --> 00:15:23,100
كانت حادثة مؤسفة

160
00:15:23,760 --> 00:15:27,310
كانت روحها عاجزة عن الصّعود

161
00:15:27,700 --> 00:15:28,970
!ماذا؟

162
00:15:53,800 --> 00:15:55,200
!هوجو

163
00:16:00,490 --> 00:16:01,410
!خذها

164
00:16:02,510 --> 00:16:04,630
!أشكرك جزيل الشّكر

165
00:16:04,630 --> 00:16:07,140
!والآن جميعاً! لنبدأ

166
00:16:07,430 --> 00:16:08,320
!حسناً

167
00:16:09,020 --> 00:16:12,130
!أون مايالتا هاريكيرا

168
00:16:17,800 --> 00:16:20,830
!أون مايالتا هاريكيرا

169
00:16:32,550 --> 00:16:35,110
!افتح حقيقة القلب

170
00:17:01,960 --> 00:17:04,000
...هذه هي الذّات الحقيقيّة

171
00:17:04,460 --> 00:17:06,280
للملكة؟...

172
00:17:08,820 --> 00:17:10,700
أنا آسفة جدّاً يا سيريوس

173
00:17:11,560 --> 00:17:13,550
أنا آسفة جدّاً يا بيتيلغيوس

174
00:17:14,120 --> 00:17:18,880
أردتُ فقط البدء معكما من جديد

175
00:17:20,690 --> 00:17:25,390
في البداية، أحببتُ مشاهدتكما وأنتما مُنسجمان

176
00:17:27,000 --> 00:17:32,100
ثمّ... أردتُ فقط رسم البسمة في وجه
أكبر قدر ممكن من البشر

177
00:17:33,430 --> 00:17:37,060
،لكن كلّما كَبُرَتْ مملكتي

178
00:17:37,060 --> 00:17:40,090
احتجتُ لعدد أكبر من المُرفقات للحفاظ عليها

179
00:17:40,810 --> 00:17:42,900
،كانت أيّامي مليئة بالهراء البيروقراطيّ

180
00:17:43,320 --> 00:17:45,220
وبدأتُ أرغب في التخلّي عنها كلّها

181
00:17:48,260 --> 00:17:50,700
...خسرتُ كلّ شيء، صحيح

182
00:17:50,700 --> 00:17:53,580
لكن من ناحية، كان ذلك جيّداً

183
00:17:56,820 --> 00:17:58,810
!خلاص جيّد

184
00:17:59,610 --> 00:18:05,010
لكن الوحدة أغرقتني في حزن لا يتوقّف

185
00:18:05,010 --> 00:18:06,910
!فخامتك! فخامتك

186
00:18:08,800 --> 00:18:10,100
أهذا أنت يا هوجو؟

187
00:18:10,610 --> 00:18:11,410
أجل

188
00:18:12,680 --> 00:18:14,480
لماذا تبدو هكذا؟

189
00:18:15,030 --> 00:18:16,340
ألم يُعجبك؟

190
00:18:17,610 --> 00:18:20,240
على العكس، أعجبني

191
00:18:21,080 --> 00:18:23,020
أشكرك

192
00:18:23,020 --> 00:18:24,440
!لم يكن ذلك مديحاً

193
00:18:25,390 --> 00:18:27,900
ومظهرك يا مولاتي؟

194
00:18:36,260 --> 00:18:37,600
هذا هو؟

195
00:18:38,910 --> 00:18:42,860
هذا هو الشّكل الّذي تفضّله الآن إذاً

196
00:18:43,290 --> 00:18:45,640
إنّه عاديّ جدّاً يا بيتيلغيوس

197
00:18:46,580 --> 00:18:47,650
أنا رانمارو

198
00:18:48,330 --> 00:18:50,570
رانمارو أي

199
00:18:51,520 --> 00:18:54,790
دمار قلبه جعله يفقد ذاكرته؟

200
00:18:55,440 --> 00:18:56,900
عظيم

201
00:18:56,900 --> 00:18:59,460
!افعل كلّ ما يمكنك فعله لإحياء مملكتي

202
00:19:00,960 --> 00:19:05,040
قرّرتُ البدء من الصّفر لاستعادة كلّ ما خسرته

203
00:19:05,870 --> 00:19:09,650
قادَني تأمُّلي للماضي لتأسيس قوانين الجنّيات العشر

204
00:19:09,650 --> 00:19:14,080
ولمنع نهوض أي ثورة مُمكنة، وضعتُ هومورا
وأورو في نفس الفريق

205
00:19:15,430 --> 00:19:19,420
لكن كان هناك شيئاً آخر كان ينبغي
أن أفعله أوّلاً

206
00:19:20,720 --> 00:19:23,300
...سيريوس، بيتيلغيوس

207
00:19:24,070 --> 00:19:27,220
...وكلّ الجنّيات في كلّ مكان

208
00:19:28,130 --> 00:19:29,940
أنا آسفة حقّاً

209
00:19:31,780 --> 00:19:35,190
كلّ هذا غلطتي. جشعي أعماني

210
00:19:36,540 --> 00:19:37,770
...بروكيون

211
00:19:39,140 --> 00:19:41,860
أتوسّل إليكم أن تسامحوني

212
00:19:42,330 --> 00:19:43,630
!أرجوكم

213
00:19:46,800 --> 00:19:50,810
!أريد أن أستمرّ في مُحاولة جعلكِ تبتسمين

214
00:19:51,940 --> 00:19:53,040
أنا أيضاً

215
00:19:53,770 --> 00:19:54,810
وكذلك أنا

216
00:19:55,550 --> 00:19:56,790
!وأنا

217
00:19:57,550 --> 00:19:58,640
كذلك أنا

218
00:19:59,560 --> 00:20:02,650
!أنا أيضاً أنضمّ لهذا الهدف

219
00:20:03,640 --> 00:20:04,960
...جميعكم

220
00:20:06,980 --> 00:20:08,130
شكراً لكم

221
00:20:46,410 --> 00:20:48,950
هذه رسالة لك

222
00:20:50,710 --> 00:20:54,260
سمعتُ أنّها كتبَتْها في حال زرتها

223
00:20:55,480 --> 00:21:01,210
"أريدك أن تستمرّ في جعل النّاس يبتسمون كجنّي"

224
00:21:01,610 --> 00:21:06,970
،كنتُ سعيدة جدّاً بالحصول على قلبك"
".ولو لفترة قصيرة من الزمن

225
00:21:08,060 --> 00:21:09,230
"شكراً لك"

226
00:21:10,840 --> 00:21:14,860
"سأحبّك للأبد"

227
00:21:15,740 --> 00:21:17,270
!أزهار الكرز

228
00:21:22,430 --> 00:21:26,130
أزهار الكرز تتفتّح إذاً

229
00:21:28,910 --> 00:21:31,220
ما زلتُ لا أثق بالبشر

230
00:21:31,720 --> 00:21:33,760
،عندما يفيض هذا العالم بالأرواح الشرّيرة

231
00:21:33,760 --> 00:21:36,290
...ويفقد النّاس كلّ الأمل

232
00:21:36,290 --> 00:21:38,790
ستكون نهاية الجنّيات أيضاً

233
00:21:38,790 --> 00:21:39,870
...سيريوس

234
00:21:41,070 --> 00:21:43,850
أحبّك

235
00:21:47,400 --> 00:21:49,300
...هل يُعقل

236
00:21:55,530 --> 00:21:57,280
لم أكن أعلم

237
00:22:01,520 --> 00:22:04,260
والآن فليبدأ المؤتمر

238
00:22:05,250 --> 00:22:08,050
،عاد عالم الجنّيات لنشاطه

239
00:22:08,050 --> 00:22:11,090
لكن ما زلتُم تتسكّعون في هذا المكان الضيّق؟

240
00:22:11,090 --> 00:22:13,270
!صُن لسانك

241
00:22:13,270 --> 00:22:17,560
اختارت الملكة أن تعود للمبادئ الأولى

242
00:22:17,960 --> 00:22:22,270
ظننتُ أنّني سأكون أخيراً زعيم عشيرة ميتالوم

243
00:22:22,270 --> 00:22:25,800
لا نملك القدرة أو الإنجازات الكافية بعد

244
00:22:25,800 --> 00:22:28,960
إنّ بلداً كبيرة كهذه تجعلني أتوتّر

245
00:22:28,960 --> 00:22:30,850
إن لم يُعجبكم، يمكنكم المُغادرة

246
00:22:33,460 --> 00:22:35,480
حسناً فخامتك

247
00:22:35,480 --> 00:22:36,740
أمركِ

248
00:22:37,490 --> 00:22:42,200
حافظوا على القوانين العشرة واجمعوا
!كمّيات كبيرة من المُرفقات

249
00:22:43,000 --> 00:22:47,170
!وارسموا البسمة في وجه أكبر عدد مُمكن من البشر

250
00:22:47,410 --> 00:22:50,830
!حاضر! سمعاً وطاعة يا سيّدتي

251
00:22:53,130 --> 00:22:55,840
هلّي أن أسألكِ الآن لمَ اخترتِ هذا الشّكل؟

252
00:22:56,070 --> 00:22:59,110
لماذا أنت ما زلت بهذا الشّكل؟

253
00:23:00,280 --> 00:23:03,440
وذلك كي أناديكِ بمولاتي

254
00:23:05,160 --> 00:23:08,260
إذا احتجتِ لأي خدمة، فليس عليكِ
إلّا قول ذلك

255
00:23:08,260 --> 00:23:09,470
يا مولاتي

256
00:23:10,570 --> 00:23:12,850
لا تفعل ذلك إلّا عندما نكون بمفردنا فقط

257
00:23:14,790 --> 00:23:16,530
!صباح الخير جميعاً

258
00:23:17,140 --> 00:23:19,490
!لنبدأ بالمعتاد

259
00:23:20,200 --> 00:23:21,460
قوانين الجنّيات العشرة

260
00:23:22,250 --> 00:23:24,410
:نحن ممنوعون من التّالي

261
00:23:25,050 --> 00:23:27,130
واحد، رومانسيّة

262
00:23:27,130 --> 00:23:29,440
لا تقع في الحبّ أبداً