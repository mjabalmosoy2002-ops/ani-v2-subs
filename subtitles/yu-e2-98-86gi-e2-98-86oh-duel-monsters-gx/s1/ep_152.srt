188
00:14:39,590 --> 00:14:42,860
ولم تكلّف نفسك عناء البحث عنّي إطلاقًا

189
00:14:42,970 --> 00:14:44,070
هذا ظلم يا (جوداي)

190
00:14:45,120 --> 00:14:46,110
...(يوبيل)

191
00:14:46,470 --> 00:14:49,020
لكنّي لن أستسلم

192
00:14:49,370 --> 00:14:52,330
!سأجعلك لي، لي وحدي

193
00:14:55,210 --> 00:14:56,840
،إذا كان كلام حيوانات الجواهر صحيح

194
00:14:57,620 --> 00:15:01,840
فسيعيد طمس ظلام (تنّين  قوس قزح الظلامي) (يوهان)

195
00:15:02,490 --> 00:15:04,590
لكن، لن يكون ذلك هينًا

196
00:15:04,970 --> 00:15:06,890
...إذا كان هنالك سبيلاً لتحقيق ذلك

197
00:15:10,260 --> 00:15:11,850
فعليّ استخدام تلك الورقة

198
00:15:14,540 --> 00:15:16,330
حان دوري، أسحب

199
00:15:16,950 --> 00:15:19,270
،معركة! يا (تنّين قوس قزح الظلامي)

200
00:15:19,540 --> 00:15:21,280
!هاجم (نيوس العاصفة)

201
00:15:29,760 --> 00:15:31,280
!هذا محال

202
00:15:31,280 --> 00:15:34,390
!سُحق (نيوس العاصفة) وكأنّه لا شيء

203
00:15:34,390 --> 00:15:36,570
نقطة 300 والأسوأ أنّ نقاط حياته هي

204
00:15:36,570 --> 00:15:39,390
إنّ حياته معلّقة بخيط رفيع الآن فعلاً

205
00:15:39,390 --> 00:15:40,210
...(جوداي)

206
00:15:43,860 --> 00:15:45,070
لم أنتهِ بعد

207
00:15:45,070 --> 00:15:47,700
أفعّل تأثير (الفضاء الجديد الفوريّ)

208
00:15:47,700 --> 00:15:52,920
أستدعي (نيوس) باستدعاء خاص من مجموعتي
بما أنّ (نيوس العاصفة) قد غادرَ الملعب

209
00:15:56,160 --> 00:15:57,720
!ذلك الوحش ثانيةً؟

210
00:15:58,140 --> 00:16:01,710
لا بدّ أنّكَ تحب ذلك الوحش حقًّا

211
00:16:02,090 --> 00:16:05,120
...لا بأس، فعلى أيّ حال، ستكون قريبًا

212
00:16:05,120 --> 00:16:06,040
أجل

213
00:16:06,040 --> 00:16:10,940
لم تخرج ورقتي المُميّزة إلى الملعب
مذ بدأنا مبارزتنا

214
00:16:10,940 --> 00:16:13,450
آنَ أوان اللّحظة الّتي سأستعملها فيها

215
00:16:13,870 --> 00:16:17,160
أضع ورقتيْن مقلوبتيْن وأنهي دوري

216
00:16:20,670 --> 00:16:24,130
لا يمكنني السّقوط حتّى أحصل
على تلك الورقة الّتي ستنقذ (يوهان)

217
00:16:24,640 --> 00:16:27,130
!مهما تطلّب ذلك

218
00:16:28,370 --> 00:16:29,180
دوري

219
00:16:30,220 --> 00:16:30,710
أسحب

220
00:16:31,650 --> 00:16:33,250
!(أمل الخمسة)

221
00:16:33,250 --> 00:16:37,650
أختار خمس أوراق لأبطال عناصر في مقبرتي

222
00:16:37,960 --> 00:16:41,330
وأعيدها إلى مجموعتي وأخلطها

223
00:16:44,270 --> 00:16:46,700
تاليًا، أسحب ورقتيْن

224
00:16:49,500 --> 00:16:51,090
أتت أخيرًا

225
00:16:51,660 --> 00:16:53,640
...ورقة الظلام الّتي أوقعتني

226
00:16:54,280 --> 00:16:56,000
!في الجحيم

227
00:17:29,150 --> 00:17:32,490
تحكّمتْ بي هذه القوّة الهائلة

228
00:17:33,030 --> 00:17:35,760
ففقدت نفسي

229
00:17:36,060 --> 00:17:40,710
خسرت أشياءً لا أستطيع استردادها بسببها

230
00:17:56,790 --> 00:18:01,040
...لكن، لأجل النّاس الّذين أحببتهم وفقدتهم الآن

231
00:18:01,040 --> 00:18:05,750
...حتّى لو كانت هذه قوّة شر
...حتّى لو تحكّمتْ بي قوّة الملك الأسمى

232
00:18:10,710 --> 00:18:13,490
أنا... سأرتقي إلى مستوى قِيَمي

233
00:18:14,060 --> 00:18:15,650
لن أؤذي أحدًا آخر

234
00:18:15,980 --> 00:18:17,630
!سأحمي ما يهمّني أمره

235
00:18:18,270 --> 00:18:21,730
!أفعّل السّحر السّريع، (الدّمج الخارق)

236
00:18:22,820 --> 00:18:24,210
...تلك الورقة

237
00:18:24,490 --> 00:18:29,170
تُفعّل هذه الورقة برمي ورقة من يدي

238
00:18:29,260 --> 00:18:30,420
(نيوس) الّذي في ملعبي

239
00:18:30,750 --> 00:18:33,630
ووحش آخر في الملعب ألا وهو
،(تنّين قوس قزح الظلاميّ)

240
00:18:34,040 --> 00:18:37,510
،سيتطوّران إلى هيئتهما المُطلقة
مُتخطّيان أسوار مجموعتيْنا

241
00:18:48,340 --> 00:18:49,430
!(جوداي)

242
00:18:51,140 --> 00:18:52,610
!(يوهان)

243
00:18:55,810 --> 00:18:57,610
...إنّ (تنّين قوس قزح الظلاميّ)

244
00:18:57,610 --> 00:19:01,770
!عاد (تنّين قوس قزح) إلى طبيعته

245
00:19:08,290 --> 00:19:09,130
!(يوهان)

246
00:19:13,770 --> 00:19:16,100
!اظهر يا (نيوس قوس قزح)

247
00:19:25,110 --> 00:19:26,910
!(نيوس قوس قزح)؟

248
00:19:36,310 --> 00:19:37,780
...(جوداي)

249
00:19:38,110 --> 00:19:40,040
!يا (يوهان)، هل أنت بخير؟

250
00:19:40,920 --> 00:19:42,000
...(جوداي)

251
00:19:42,580 --> 00:19:44,910
!أنت... أنقذتني إذًا؟

252
00:19:44,910 --> 00:19:45,500
!(يوهان)

253
00:19:49,030 --> 00:19:51,070
كنت أنتظر هذه اللّحظة

254
00:19:51,070 --> 00:19:53,500
تسير الأمور كما هو مُخطّط لها

255
00:19:53,750 --> 00:19:54,510
!ماذا تقولين؟

256
00:19:54,730 --> 00:19:59,370
يمكنك أخذ جسده، فلا أحتاج إليه بعد الآن

257
00:19:59,370 --> 00:20:02,300
فأنا أملك ما أريده بشدّة

258
00:20:03,480 --> 00:20:08,130
الورقة الأشد قوّة والّتي اكتملت
بتحويلك إلى الملك الأسمى

259
00:20:08,320 --> 00:20:11,020
القوّة المُطلقة للتحكّم بالكون

260
00:20:11,410 --> 00:20:12,520
!(الدّمج الخارق)؟

261
00:20:12,810 --> 00:20:14,310
!كيف هي لديكِ؟

262
00:20:16,050 --> 00:20:16,810
...هذا

263
00:20:18,350 --> 00:20:19,880
!(الخدعة الأخيرة)

264
00:20:19,880 --> 00:20:22,240
...فخ يضيف ورقة سحر إلى يدك

265
00:20:23,130 --> 00:20:25,000
!قد ذهبت إلى مقبرة الخصم؟

266
00:20:25,150 --> 00:20:27,590
كانت مبارزتنا ممتعة حتّى اللّحظة

267
00:20:27,590 --> 00:20:29,590
لكنّ هذه بداية متعتنا

268
00:20:31,120 --> 00:20:33,710
ورقة الفخ، (سقطة الألف)

269
00:20:34,260 --> 00:20:36,840
!نقطة حياة 1000 أفعّلها بدفع

270
00:20:37,160 --> 00:20:41,340
تُدمّر كلّ الوحوش الّتي هجومها أو دفاعها
نقطة 1000 يقل عن

271
00:20:41,770 --> 00:20:44,520
نقطة ضرر 1000 ونتلقّى كلانا

272
00:20:47,090 --> 00:20:47,610
!(يوهان)

273
00:21:04,460 --> 00:21:07,330
حسنًا، هلاّ بدأنا يا (جوداي)؟

274
00:21:10,560 --> 00:21:13,860
وقتنا الحقيقيّ معًا

275
00:22:52,010 --> 00:23:06,610
الحلقة القادمة

276
00:22:52,480 --> 00:22:55,640
ظهرت (يوبيل) أخيرًا أمام (جوداي) بعودة (يوهان)

277
00:22:55,640 --> 00:22:59,150
!يا (يوبيل)، ماذا تنوين أن تفعلي بورقة (الدّمج الخارق) تلك؟

278
00:22:59,150 --> 00:23:00,840
!هل حان لهما أن يصفيّا حساباتهما؟

279
00:23:00,840 --> 00:23:01,900
...يا (جوداي)، أين

280
00:23:01,900 --> 00:23:05,400
!سأكون بخير يا (شو)! (كرونوس) سينسي! (يوهان)

281
00:23:05,400 --> 00:23:06,610
!انتظريني يا (يوبيل)

282
00:23:06,810 --> 00:23:11,220
!في الحلقة القادمة: مواجهة الأوراق المُختارة
أبطال العناصر ضد (يوبيل)

283
00:23:11,220 --> 00:23:14,520
!سأشاهد معركتك حتّى النّهاية يا (جوداي)

284
00:23:14,520 --> 00:23:18,260
،ما دمتِ غاضبة عليّ يا (يوبيل)
!فأفرغي غضبكِ عليّ وحدي

285
00:23:18,260 --> 00:23:19,790
!فأنا أقف أمامكِ

286
00:23:22,850 --> 00:23:24,950
أفضل ورقة لليوم هي (نيوس العاصفة)

287
00:23:25,400 --> 00:23:27,950
نقطة 3000 نقاط هجومه هي
نقطة 2500 ونقاط دفاعه هي

288
00:23:28,320 --> 00:23:32,710
استعمل ثلاثة أبطال، واحد من السّماء والبحر
وآخر من الفضاء لأجل دمج الاتّصال الثلاثي

289
00:23:33,020 --> 00:23:34,920
!إنّه يجتاح المبارزة