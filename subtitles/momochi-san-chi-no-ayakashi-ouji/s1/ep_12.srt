1
00:00:01,690 --> 00:00:07,130
...هيماري، هناك ما عليّ إخباركِ به

2
00:00:14,930 --> 00:00:19,410
عليكِ ألّا تنظري لي

3
00:01:49,500 --> 00:01:53,380
الحلقة الثانية عشرة  النور الذي يعبر البحر

4
00:01:50,330 --> 00:01:53,190
!الجوّ حارٌّ جدّاً

5
00:01:53,190 --> 00:01:55,640
!انتبهوا الحرق الشمسيّ

6
00:01:55,640 --> 00:01:57,600
تهتمّون بتلك الأشياء؟

7
00:01:57,600 --> 00:01:59,700
لا يزال الصيف في بدايته

8
00:01:59,700 --> 00:02:01,630
لا بدّ أنّ الطقس سيزيد حرارةً من الآن

9
00:02:02,140 --> 00:02:06,870
بالكلام عن الصيف، انتقل
...ناتشي-سينسي فجأةً، لكن

10
00:02:06,870 --> 00:02:10,180
ألا ينتظرون للعطلة الصيفيّة
للقيام بتلك الأشياء عادةً؟

11
00:02:11,150 --> 00:02:12,960
أجل، كانت تلك مُفاجأة

12
00:02:12,960 --> 00:02:15,780
...معلّم قلبي

13
00:02:15,780 --> 00:02:17,030
!اصمت

14
00:02:18,130 --> 00:02:19,710
...بالمناسبة يا هيماري

15
00:02:20,320 --> 00:02:23,120
سيٌعقد مهرجان حول منزلي الليلة

16
00:02:23,120 --> 00:02:24,130
مهرجان؟

17
00:02:24,130 --> 00:02:26,060
إنّها مرّتكِ الأولى، صحيح؟

18
00:02:26,060 --> 00:02:28,120
نشارك فيه بحماس عادةً

19
00:02:28,120 --> 00:02:29,860
أتريدين القدوم معنا؟

20
00:02:29,860 --> 00:02:31,920
من الرائع أنّ الطقس سيكون
لطيفاً هذا العام

21
00:02:31,920 --> 00:02:36,350
الياكيسوبا وكاكيغوري، ولا يمكنكم
نسيان الكاستيلا الصغيرة

22
00:02:36,350 --> 00:02:39,230
مضت فترة طويلة مُذ ذهبت إلى مهرجان

23
00:02:40,360 --> 00:02:44,820
...أريد مرافقتكم للمهرجان حقّاً، لكن

24
00:02:44,820 --> 00:02:49,140
!آسفة، لديّ التزامٌ هام اليوم لا يمكنني إلغاؤه

25
00:02:50,230 --> 00:02:51,310
!يا إلهي

26
00:02:51,310 --> 00:02:53,030
ليس باليد حيلة

27
00:02:53,550 --> 00:02:56,530
لنذهب سويّاً العام المقبل، أتعديننا؟

28
00:02:56,530 --> 00:02:59,500
!أجل، أعدكم! إلى اللقاء

29
00:03:01,980 --> 00:03:03,160
!رجعت

30
00:03:22,890 --> 00:03:23,950
مرحباً بعودتكِ

31
00:03:24,420 --> 00:03:26,790
...آ-آوي

32
00:03:27,130 --> 00:03:29,820
لا تخفني هكذا

33
00:03:29,820 --> 00:03:31,360
آسف

34
00:03:33,140 --> 00:03:34,310
أين الجميع؟

35
00:03:34,670 --> 00:03:36,850
إنّهم يتجهّزون سلفاً

36
00:03:36,850 --> 00:03:39,520
!علينا الإسراع ومساعدتهم إذاً

37
00:03:40,270 --> 00:03:42,590
!بسرعة، بسرعة! يجب أن نجهز

38
00:03:42,590 --> 00:03:44,540
!إنّها حفلة

39
00:03:44,540 --> 00:03:47,230
!انتبه لخطواتك يا تامامو

40
00:03:47,230 --> 00:03:49,620
!إيسي، الستارة ليست مستوية

41
00:03:49,620 --> 00:03:51,530
بالكاد يمكن ملاحظة ذلك

42
00:03:51,530 --> 00:03:52,990
!رجعت

43
00:03:52,990 --> 00:03:54,270
مرحباً بعودتكِ

44
00:03:58,640 --> 00:04:00,570
يبدو أنّكم أوشكتم على الانتهاء

45
00:04:00,570 --> 00:04:03,870
...أعتقد أنّنا بحاجة للمزيد من الزينة بعض الشيء

46
00:04:03,870 --> 00:04:07,480
أجل، ربما إن كانت لدينا
...أزهار أو ما شابه

47
00:04:07,480 --> 00:04:09,590
أتحتاجون لأزهار؟

48
00:04:12,410 --> 00:04:13,550
!من هنا

49
00:04:18,890 --> 00:04:21,110
!يا لجمالها

50
00:04:21,110 --> 00:04:23,880
!حقل أزهار دوّار الشمس لمنزل موموتشي

51
00:04:25,210 --> 00:04:29,330
لم أكن أعلم أنّ المنزل
متّصل بمكانٍ بهذا الجمال

52
00:04:31,810 --> 00:04:34,190
!أنا أحبّ دوّار الشمس كثيراً

53
00:04:34,190 --> 00:04:35,140
حقّاً؟

54
00:04:35,140 --> 00:04:38,720
!إنّه يعطي رونقاً صيفيّاً وبهيجاً

55
00:04:39,460 --> 00:04:41,090
كما أنّكِ مفعمة بالحيويّة للغباء

56
00:04:41,090 --> 00:04:43,310
!"لا حاجة لتضيف "غباء

57
00:04:43,770 --> 00:04:49,040
لطالما أردتُ أن أكون مثل
هذه الأزهار مُذ صغري

58
00:04:49,040 --> 00:04:50,670
هذا يليق بكِ حقّاً

59
00:04:50,670 --> 00:04:54,480
هيماواري" هي أزهارٌ تتفتّح نحو الشمس في النهاية

60
00:04:55,620 --> 00:05:00,210
...أتساءل ما إن استوحى والداي اسمي منها

61
00:05:00,680 --> 00:05:02,640
أو ذلك ما أعتقده على الأقلّ

62
00:05:03,930 --> 00:05:06,790
حسناً، أتفهّم منطقيّة ذلك بما أنّكِ
مفعمة بالحيويّة للغباء

63
00:05:06,790 --> 00:05:10,140
!"كما قلت! لا داعي لتضيف "غباء

64
00:05:11,910 --> 00:05:17,030
حسناً، فلنسرع بقطف دوّار الشمس
كي ننهي زينة حفلتنا

65
00:05:17,030 --> 00:05:18,260
!أجل

66
00:05:20,180 --> 00:05:24,890
...شيء يليق بحفلة، يليق بحفلة

67
00:05:24,890 --> 00:05:26,600
...لا أجد شيئاً

68
00:05:26,600 --> 00:05:29,630
انتهينا من الزينة، لذا ظننت

69
00:05:29,630 --> 00:05:33,910
أنّه إن امتلكنا شيئاً لإشعال
...حماس الحفلة مع الجميع

70
00:05:33,910 --> 00:05:37,730
يصعب إيجاد أشياء للحفلات
في هذا المنزل نوعاً ما

71
00:05:37,730 --> 00:05:43,020
إشعال... ما رأيكِ بالشموع؟

72
00:05:46,120 --> 00:05:47,610
تقصد قصص الأشباح؟

73
00:05:47,610 --> 00:05:51,690
هذه الأزياء التي ارتديناها
عندما تنكّرنا كأخوات

74
00:05:53,150 --> 00:05:54,790
هل تودّ ارتداءها من جديد؟

75
00:05:54,790 --> 00:05:56,130
لا، شكراً

76
00:05:56,130 --> 00:05:58,290
يا إلهي، كدت أنسى

77
00:05:58,290 --> 00:06:01,130
يجب أن أرجع للمطبخ

78
00:06:01,570 --> 00:06:05,080
آسف، أيمكنني ترك الباقي لكما؟

79
00:06:05,320 --> 00:06:06,200
أجل

80
00:06:06,200 --> 00:06:07,480
بالطبع

81
00:06:07,480 --> 00:06:10,060
شكراً لكما، أراكما بعد قليل

82
00:06:11,060 --> 00:06:14,630
توجد أشياء كثيرة مخزّنة هنا حقّاً

83
00:06:14,630 --> 00:06:16,550
هذا مستودع منزل موموتشي، فلا عجب

84
00:06:17,240 --> 00:06:20,870
هنالك عدّة أشياء هنا تحمل تاريخاً
حتّى أنا لا أعرفه

85
00:06:21,350 --> 00:06:23,000
حقّاً؟

86
00:06:23,790 --> 00:06:27,530
لكنّي لا أمانع رائحة الأشياء القديمة

87
00:06:28,210 --> 00:06:31,530
تشعرني بالحنين نوعاً ما

88
00:06:35,930 --> 00:06:36,950
هيماري

89
00:06:38,080 --> 00:06:38,990
ماذا؟

90
00:06:39,820 --> 00:06:42,460
...بخصوص رفّ القلوب

91
00:06:42,460 --> 00:06:43,390
أجل

92
00:06:43,390 --> 00:06:48,460
السبب الوحيد لكون الجميع بأمانٍ
الآن هو لاختياركِ رفّي

93
00:06:48,460 --> 00:06:53,710
لكنّي اعرف أنّكِ أردتِ اختيار رفّكِ
لمعرفة المزيد عن والديكِ في الواقع

94
00:06:53,710 --> 00:06:58,880
كنتِ تبحثين عن دلائل لهما
مُذ أتيتِ لهذا المنزل

95
00:06:59,360 --> 00:07:02,320
أعرف، لكنّي لا أندم على قراري

96
00:07:02,800 --> 00:07:03,730
هيماري

97
00:07:05,360 --> 00:07:09,200
هناك ما عليّ إخباركِ به

98
00:07:15,360 --> 00:07:20,590
في الماضي، وجدت مذكّرة يوميّات والديكِ
في هذا المستودع

99
00:07:23,180 --> 00:07:27,760
كان ذلك بعد بضعة أعوام
مُذ وصولي لمنزل موموتشي

100
00:07:30,930 --> 00:07:36,290
حينذاك، كانت الأرواح الشرّيرة منتشرة
ثائرةً في منزل موموتشي

101
00:07:36,290 --> 00:07:38,880
بعد أعوام من غياب سيّد المنزل

102
00:07:42,690 --> 00:07:47,360
كدحت ليلاً ونهاراً للقضاء على الأياكاشي

103
00:07:47,360 --> 00:07:50,980
دون معرفة سبب اختياري كنوي

104
00:07:56,180 --> 00:07:59,820
يوكاري، هذا ما يُفترض بي فعله، صحيح؟

105
00:07:59,820 --> 00:08:02,290
أجل، أحسنت البلاء

106
00:08:02,290 --> 00:08:08,000
عملك كأوماموري-ساما يضمن
سلامة العالم البشريّ

107
00:08:09,480 --> 00:08:11,970
...حاول يوكاري تشجيعي، لكن

108
00:08:12,970 --> 00:08:16,240
كان كلّ شيءٍ آنذاك مؤلماً لي

109
00:08:16,890 --> 00:08:20,510
لمَ كان يجب أن أكون
من يقوم بهذا؟

110
00:08:20,510 --> 00:08:22,990
إلى متى سأواصل؟

111
00:08:23,730 --> 00:08:29,710
،بدا المستقبل ظلاماً لا مُتناهياً
ولم أستطع إيجاد النور

112
00:08:30,340 --> 00:08:31,730
...وعندها

113
00:08:37,270 --> 00:08:39,450
أهذه... مذكّرة يوميّات؟

114
00:08:40,240 --> 00:08:43,530
،رغم أنّي وُلِدت باسم موموتشي

115
00:08:43,530 --> 00:08:48,500
لا أملك أيّ طاقة روحيّة
ولا أستطيع الوفاء بواجبي

116
00:08:49,180 --> 00:08:53,340
أهذه... مذكّرة يوميّات أحد بني موموتشي؟

117
00:08:53,820 --> 00:08:56,990
لا أستطيع أن أصبح أوماموري-ساما

118
00:08:57,550 --> 00:09:01,620
أنا بشريّة عاديّة بالكاد
تستطيع رؤية الأياكاشي

119
00:09:02,330 --> 00:09:04,490
عبء اسم موموتشي ثقيلٌ
على أن أحمله

120
00:09:05,470 --> 00:09:08,450
لكنّي وجدت الآن شخصاً أحبّه

121
00:09:08,450 --> 00:09:11,990
شخص يساندني وأسانده

122
00:09:11,990 --> 00:09:18,420
لا يمكنه رؤية الأياكاشي، لكن حتّى بعد معرفته
،لطبيعة قدرتي وظروف منزل موموتشي

123
00:09:18,420 --> 00:09:22,100
تقبّلها، وقال أنّه يريد البقاء معي

124
00:09:23,010 --> 00:09:26,520
لا أصدّق أنّه يوجد أشخاص مثله... حقّاً؟

125
00:09:26,520 --> 00:09:28,780
بدايةً، شعرت بالفضول حيال قصّتهما

126
00:09:29,760 --> 00:09:34,140
أردت معرفة المزيد عن المرأة التي
كانت تستطيع رؤية الأياكاشي مثلي

127
00:09:34,140 --> 00:09:36,350
وعاشت هنا في منزل موموتشي

128
00:09:37,510 --> 00:09:45,090
لكنّي أصبحت أكثر تعلّقاً... بها وبقصّة منزلها

129
00:09:47,020 --> 00:09:51,970
آوي، هل ستذهب للمستودع من جديد؟

130
00:09:52,230 --> 00:09:53,080
أجل

131
00:09:53,080 --> 00:09:56,350
ابنتي هيماري تضحك كثيراً

132
00:09:56,350 --> 00:10:01,520
وتأكل الكثير، لحدٍّ يُشعرني ببعض القلق حتّى

133
00:10:03,130 --> 00:10:07,840
،بكت هيماري البارحة كثيراً
واستيقظنا العديد من المرّات

134
00:10:08,290 --> 00:10:11,610
أودّ الاعتقاد أنّ بكاءها برهانٌ على صحّتها

135
00:10:12,350 --> 00:10:15,880
مهما بكت، تطغى ظرافتها

136
00:10:15,880 --> 00:10:22,620
لكنّي أتساءل ما إن كانت تبكي
لأنّ بإمكانها رؤية الأياكاشي

137
00:10:22,620 --> 00:10:27,230
بما أنّ دم موموتشي يجري
في عروقها أيضاً

138
00:10:27,760 --> 00:10:32,180
إن صحّ ذلك، فسيتعيّن عليها
حمل قدر ثقيل

139
00:10:32,790 --> 00:10:34,140
...أشعر بالقلق

140
00:10:34,570 --> 00:10:38,960
لكن مهما حصل، سنكون أكبر مساندين لهيماري

141
00:10:38,960 --> 00:10:43,410
حتّى بدون أيّ قوّة، سنحميها حتّى النهاية

142
00:10:44,930 --> 00:10:50,450
بينما واصلت القراءة، تسلّل الدفء
لقلبي البارد، وبدأ الخفقان من جديد

143
00:10:51,820 --> 00:10:55,610
كلّ ذلك بسبب ذكريات عائلة
لم يسبق وأن رأيتها أو التقيتها

144
00:10:56,770 --> 00:10:59,470
قرأت المذكّرة عدّة مرّات مُذ حينها

145
00:11:00,950 --> 00:11:03,880
لكن في أحد الأيام، لاحظت شيئاً غريباً

146
00:11:04,350 --> 00:11:10,520
...لا أستطيع المغادرة... هذا المنزل كثيرٌ عليّ

147
00:11:11,210 --> 00:11:12,960
...أ-أهذا

148
00:11:15,570 --> 00:11:16,910
!تراجع

149
00:11:19,190 --> 00:11:21,370
آوي، أأنت بخير؟

150
00:11:21,370 --> 00:11:22,750
أ-أجل

151
00:11:26,790 --> 00:11:28,580
...لكن المذكّرة

152
00:11:29,090 --> 00:11:33,460
بدا كما لو أنّ الشرّ التهمها

153
00:11:33,460 --> 00:11:34,650
الشرّ؟

154
00:11:39,580 --> 00:11:40,920
...أهذا

155
00:11:40,920 --> 00:11:42,120
هيماري؟

156
00:11:43,170 --> 00:11:46,170
لا يمكننا البقاء بجواركِ بعد الآن

157
00:11:46,170 --> 00:11:50,150
آسفة، لكن هذا هو قدرنا

158
00:11:50,940 --> 00:11:55,000
كنّا سعيدين جدّاً بلقائكِ

159
00:11:55,890 --> 00:12:00,310
لا بدّ أنّها كاتبة المذكّرة وزوجها

160
00:12:00,310 --> 00:12:04,780
لا بدّ أنّهما تركا مقداراً صغيراً
من الطاقة الروحيّة في المذكّرة

161
00:12:04,780 --> 00:12:10,530
بنو الموموتشي الذين لا يمتلكون قوّة روحيّة
،"لا يمكن اختيارهم ليصبحوا "نوي

162
00:12:10,530 --> 00:12:13,920
ويصبحون ضحيّة الشرّ المتكثّف
في هذا المنزل بنهاية المطاف

163
00:12:14,580 --> 00:12:17,330
ربما لم يستطيعا الهرب بدورهما

164
00:12:17,640 --> 00:12:19,190
...لا يمكن

165
00:12:19,190 --> 00:12:23,730
لكن أقلّ ما يمكننا فعله هو ترك
شيء ينير قلبكِ

166
00:12:23,730 --> 00:12:26,650
لذا تركت هذه المذكّرة لكِ

167
00:12:27,000 --> 00:12:32,260
،مهما بلغت الصعوبات التي واجهتِها في حياتكِ

168
00:12:32,260 --> 00:12:35,430
فلتجدي السلام في النهاية

169
00:12:42,190 --> 00:12:43,580
أنا أحبّكِ

170
00:12:54,020 --> 00:12:58,300
ما الذي سيحلّ إن أتت ابنتهما
لهذا المنزل يوماً ما؟

171
00:12:58,950 --> 00:13:03,180
وماذا إن كانت لا تمتلك
أيّة قوى أيضاً؟

172
00:13:03,180 --> 00:13:06,590
يمكن أن تلقى نفس المصير

173
00:13:06,590 --> 00:13:12,240
لكن المختلف الآن هو أنّك
"موجودٌ هنا كأوماموري-ساما، "نوي

174
00:13:12,860 --> 00:13:16,300
...معك حقّ... في تلك الحالة

175
00:13:17,380 --> 00:13:21,330
من اليوم فصاعداً، سأعيش لحماية هيماري

176
00:13:29,200 --> 00:13:32,230
ذلك ما أردت إخباركِ به

177
00:13:33,500 --> 00:13:36,490
...ما قلتَه آنذاك إذاً

178
00:13:36,840 --> 00:13:41,890
إذا لم أستطع إنقاذ هيماري، فما الذي
عشت لأجله إلى الآن؟

179
00:13:43,110 --> 00:13:45,370
...ذلك ما قصدته

180
00:13:46,700 --> 00:13:50,550
نجوت بفضل والديكِ

181
00:13:50,550 --> 00:13:55,970
لكنّي سرقت آخر تركة حبّ منهما لكِ

182
00:13:58,170 --> 00:14:02,430
أنا آسفٌ حقّاً، أعرف أنّه ليس شيئاً
...يمكنكِ مسامحتي عليه

183
00:14:02,430 --> 00:14:03,700
!ليس الأمر كذلك

184
00:14:05,060 --> 00:14:07,630
...أنا سعيدة! أنا

185
00:14:08,530 --> 00:14:13,890
...ظننت أنّ فرصتي تبدّدت بعد رفّ القلوب، لكن

186
00:14:19,520 --> 00:14:23,400
كان أبي وأمّي هنا

187
00:14:25,420 --> 00:14:28,270
...آوي، شكراً لك

188
00:14:31,510 --> 00:14:33,550
على ربطي بوالديّ

189
00:14:35,200 --> 00:14:36,440
...هيماري

190
00:14:38,350 --> 00:14:42,710
لكن كان بإمكانك إخباري بهذا قبلاً

191
00:14:42,710 --> 00:14:45,310
لطالما تفاديتَ الكلام في الموضوع

192
00:14:45,310 --> 00:14:46,260
آسف

193
00:14:47,350 --> 00:14:49,920
شكراً لكِ يا هيماري

194
00:15:01,390 --> 00:15:04,890
!"حسناً إذاً، لنبدأ حفلة "أحسنتم البلاء

195
00:15:04,890 --> 00:15:07,750
!مرحى

196
00:15:07,750 --> 00:15:09,550
!ستجلس هنا يا آوي، المقعد الرئيسيّ

197
00:15:13,430 --> 00:15:16,490
!هذه وليمةٌ يا يوكاري

198
00:15:16,490 --> 00:15:18,450
...لنبدأ الأكل

199
00:15:17,810 --> 00:15:21,070
...انتظري، كلّ هذه الأطباق لأجل

200
00:15:22,360 --> 00:15:24,600
!لنافورة عصيدة الفاصولياء الحمراء هذه

201
00:15:27,150 --> 00:15:28,870
...هذا دقيقٌ حقّاً

202
00:15:29,370 --> 00:15:31,310
...حاولت إيقافه، لكن

203
00:15:31,670 --> 00:15:33,850
ماذا تريد أكله بدايةً؟

204
00:15:33,850 --> 00:15:36,000
تيمبورا قريدس؟ أم زلابية غيوزا؟

205
00:15:40,610 --> 00:15:42,520
!هذه التونا لذيذة جدّاً

206
00:15:42,520 --> 00:15:43,620
أأنت متأكّد؟

207
00:15:43,620 --> 00:15:46,670
افتح فمك يا آوي

208
00:15:46,670 --> 00:15:49,440
...هذا يذكّرني بحساء الخليط

209
00:15:51,800 --> 00:15:55,600
حسناً، استعدّوا لسماع أغنية "أوندو
!رفض موموتشي" الأسطوريّة

210
00:15:55,600 --> 00:15:57,550
!لا أريد سماعها من جديد

211
00:15:59,500 --> 00:16:03,350
!سأريكم رقصة أوبون خاصّتي بدل ذلك

212
00:16:03,350 --> 00:16:04,950
!لا يختلف ذلك عن أوندو الرفض

213
00:16:04,950 --> 00:16:06,690
!بل يختلف كلّياً

214
00:16:07,430 --> 00:16:10,710
أنا بارعٌ في القصر بدوري

215
00:16:14,040 --> 00:16:16,190
!ما رأيكم؟ أليس هذا مذهلاً؟

216
00:16:26,510 --> 00:16:28,880
كان ذلك صاخباً بحقّ

217
00:16:28,170 --> 00:16:30,450
لم أعد أستطيع الأكل

218
00:16:30,450 --> 00:16:33,650
كان الطعام لذيذاً، شكراً لك يا يوكاري

219
00:16:33,650 --> 00:16:35,420
يسرّني أنّك استمتعت به

220
00:16:35,880 --> 00:16:40,290
،أرى أنّ الحفلة اقتربت من ختامها
لكن لديّ مُفاجأة للجميع

221
00:16:40,290 --> 00:16:41,390
ما هي؟

222
00:16:42,150 --> 00:16:44,170
!الصيف يعني وقت الألعاب الناريّة

223
00:16:44,510 --> 00:16:47,190
يوجد الكثير منها! كيف حصلتِ عليها؟

224
00:16:48,590 --> 00:16:51,700
جهّزتها مع يوكاري-سان لليوم

225
00:16:52,050 --> 00:16:57,900
كانت في المستودع، لكنّي لا أستشعر
...أيّة أرواح شرّيرة منها، لذا ظننت أنّها

226
00:16:57,900 --> 00:16:59,880
!لنشعلها

227
00:17:03,540 --> 00:17:04,600
ماذا؟

228
00:17:05,340 --> 00:17:06,940
!لم تُشعل هذه أيضاً

229
00:17:06,940 --> 00:17:08,250
!ولا هذه

230
00:17:09,160 --> 00:17:15,170
ماذا؟ لا يمكن! كان هذا
!الحدث الرئيسيّ في الحفلة

231
00:17:15,170 --> 00:17:17,180
لا تقلقي يا هيماري

232
00:17:45,920 --> 00:17:48,480
تنانين نور؟

233
00:17:50,120 --> 00:17:53,080
!كنت أعرف أنّها يوكاي ألعاب ناريّة

234
00:17:53,080 --> 00:17:54,280
!آوي

235
00:17:54,280 --> 00:17:56,030
هذا رائع، أترين؟

236
00:17:56,970 --> 00:17:58,510
الجميع مُستمتعون

237
00:18:03,300 --> 00:18:07,150
شكراً لكِ على المفاجأة الرائعة يا هيماري

238
00:18:12,590 --> 00:18:16,060
لحظة، يمكن صعود تنّين النور ذاك؟

239
00:18:17,190 --> 00:18:19,820
أجل... فهو يوكاي ألعاب ناريّة

240
00:18:19,820 --> 00:18:21,610
!كان عليك إخباري قبلاً

241
00:18:22,300 --> 00:18:25,040
!الأكبر حجماً هناك

242
00:18:26,650 --> 00:18:28,220
!هيّا بنا يا آوي

243
00:18:28,910 --> 00:18:31,990
...لا-لا أدري ما إن كان سيُفلح ذلك

244
00:18:43,500 --> 00:18:47,630
...يمكنني الطيران عليه حقّاً... لا أصدّق

245
00:18:48,230 --> 00:18:52,830
!أنا كذلك، لكنّي مسرورة لأنّ الأمر نجح! انظر

246
00:18:54,910 --> 00:18:59,370
تلك أنوار المدينة التي تحميها يا آوي

247
00:19:06,560 --> 00:19:11,860
إنّها جميلة، كلّ هذا بفضل عملك الجادّ في منزل موموتشي

248
00:19:12,240 --> 00:19:14,550
لذا لا تخبو الأنوار أبداً

249
00:19:18,050 --> 00:19:20,680
!شكراً لك يا آوي

250
00:19:57,220 --> 00:20:01,780
لم يخطر لي أبداً بأنّ آوي قد
يستطيع الطيران في السماء

251
00:20:02,480 --> 00:20:07,440
حسناً، لا بدّ أنّ ذلك يعني أنّه
جزء من منزل موموتشي أيضاً

252
00:20:07,760 --> 00:20:09,880
...ربما، لكن

253
00:20:10,400 --> 00:20:16,300
قد يستطيع آوي يوماً ما العودة حقّاً
لعالم البشر بفضلها

254
00:20:17,570 --> 00:20:23,190
اسمع يا إيسي، أتعرف كيف يُكتب
دوّار شمس" بالكانجي؟"

255
00:20:24,130 --> 00:20:25,620
أجل

256
00:20:26,510 --> 00:20:29,500
..."الزهرة التي "تصل آوي مع الشمس

257
00:20:30,110 --> 00:20:34,530
ذكرت رغبتها في أن تكون مثل دوّار الشمس

258
00:20:34,530 --> 00:20:37,900
لعلّ هذا ما يدعوه الناس بالقدر

259
00:20:44,520 --> 00:20:48,170
اعذرني، تكلّمت كالبشر من جديد

260
00:20:48,570 --> 00:20:51,150
كلامٌ مبتذل، إن أردت رأيي

261
00:20:53,440 --> 00:20:57,740
"...كي ينتشر نورها ليعبر أبعد البحار حتّى"

262
00:20:59,390 --> 00:21:02,370
الكلمات التي تركها والداكِ في المذكّرة

263
00:21:03,850 --> 00:21:06,820
هيماري، ذلك معنى اسمكِ

264
00:21:07,210 --> 00:21:09,320
اسمي؟

265
00:21:10,790 --> 00:21:14,020
"توموشيبي" و"بانري" لتهجئة "هيماري"

266
00:21:14,800 --> 00:21:16,640
فهمت أخيراً

267
00:21:17,760 --> 00:21:22,990
كنت أحمي النور الذي كان
المعنى وراء اسمك

268
00:21:23,960 --> 00:21:30,580
وكنتِ من تحميني طوال الوقت

269
00:21:32,260 --> 00:21:34,110
شكراً لكِ يا هيماري

270
00:21:34,720 --> 00:21:35,950
...آوي

271
00:21:36,360 --> 00:21:40,850
لم أكن أمتلك الشجاعة لمواجهة قدري

272
00:21:41,850 --> 00:21:45,280
لذا واصلت الهرب من صراحتكِ وصدقكِ

273
00:21:46,870 --> 00:21:51,500
لا بأس، أعرف أنّك كاذبٌ يا آوي

274
00:21:51,500 --> 00:21:52,610
،لكن يا هيماري

275
00:21:54,030 --> 00:21:56,040
يمكنني قولها دون خوفٍ الآن

276
00:21:56,870 --> 00:21:59,590
...في الحقيقة

277
00:22:11,960 --> 00:22:14,120
أنا أحبّكِ