1
00:00:06,400 --> 00:00:08,470
تمّ العقد هكذا

2
00:00:09,510 --> 00:00:12,690
سيكون أمامنا وقت أبديّ
للتعرّف على بعضنا يا إيسي

3
00:00:12,690 --> 00:00:15,160
بدأ الأمر شيئاً خارجاً عن إرادتي

4
00:00:15,160 --> 00:00:16,980
كان عقداً لا بدّ من إبرامه

5
00:00:17,590 --> 00:00:18,790
...ومع ذلك

6
00:00:20,920 --> 00:00:25,400
عليكِ ألّا تنظري لي

7
00:01:55,590 --> 00:01:59,510
الحلقة الرابعة   قرمزيّ يحرق الظلام

8
00:01:58,100 --> 00:01:59,670
...ختمٌ آخر

9
00:02:00,040 --> 00:02:03,190
...لم نشهد أيّة مشاكل كبيرة إلى الآن، لكن

10
00:02:03,190 --> 00:02:05,150
هذا الثالث اليوم

11
00:02:05,460 --> 00:02:06,650
غير مألوف أبداً

12
00:02:06,650 --> 00:02:11,010
كلّه بسبب سماحنا لكاشا في منزل موموتشي

13
00:02:12,880 --> 00:02:14,240
...كاشا

14
00:02:17,970 --> 00:02:19,910
!استعدّا لإصلاح الختم فوراً

15
00:02:19,910 --> 00:02:20,650
!أمرك

16
00:02:20,970 --> 00:02:23,560
يجب أن نقتلع كلّ مصدر خطر من جذوره

17
00:02:24,170 --> 00:02:27,370
عليّ حماية هيماري

18
00:02:28,730 --> 00:02:30,070
رجعت

19
00:02:34,540 --> 00:02:38,000
ماذا؟ هنالك ما يشعرني بالتوتّر

20
00:02:40,400 --> 00:02:41,680
!رجعت

21
00:02:41,940 --> 00:02:44,880
ماذا؟ ما خطبكم؟

22
00:02:44,880 --> 00:02:46,010
!هيماري

23
00:02:46,010 --> 00:02:47,810
!هنالك شيء مُريب

24
00:02:47,810 --> 00:02:49,360
!أشعر بقشعريرة

25
00:02:49,360 --> 00:02:51,440
تشعرون به أيضاً إذاً؟

26
00:02:51,440 --> 00:02:53,730
بدا لي المنزل غريباً

27
00:02:54,150 --> 00:02:55,420
!أشعر بالخزي

28
00:02:55,420 --> 00:02:59,430
—من كان ليتصوّر تملّص شيطان عظيم
!أقصد، ذاك الرجل منّي هكذا

29
00:02:59,910 --> 00:03:01,640
ذاك الرجل"؟"

30
00:03:04,920 --> 00:03:06,370
تقصد كاشا؟

31
00:03:07,480 --> 00:03:11,490
!عـ-عليكِ ألّا تنطقي باسمه بهذه البساطة

32
00:03:11,490 --> 00:03:14,990
!لعالم الأياكاشي هرميّة حازمة

33
00:03:14,990 --> 00:03:17,330
لا بدّ أنّكم لا تفهمون يا بني البشر

34
00:03:17,770 --> 00:03:23,650
تمتلك الأياكاشي القديمة وذوات السلالة
النبيلة قوى روحيّة عظيمة

35
00:03:23,650 --> 00:03:26,550
ومن بينهما، هو في مستوى بمفرده

36
00:03:26,840 --> 00:03:34,730
بالكاد نستطيع نحن اليوكاي الصغرى النطق
!باسم كاشا-ساما دون أن يعترينا الارتجاف

37
00:03:35,230 --> 00:03:37,200
كاشا-ساما إذاً؟

38
00:03:37,630 --> 00:03:40,410
!أ-أنا شيكيغامي لنوي-ساما

39
00:03:40,410 --> 00:03:43,790
!لا نظير لعظمته أبداً

40
00:03:43,790 --> 00:03:45,880
...لـ-لا أخشى كاشا

41
00:03:45,880 --> 00:03:47,070
يبدو أنّك تفعل

42
00:03:47,070 --> 00:03:48,370
!لا أخشاه

43
00:03:48,850 --> 00:03:51,610
لم أدرك أنّه كان رفيعاً لتلك الدرجة

44
00:03:49,370 --> 00:03:55,410
!أخشاه؟! مستحيل! قطعاً لا

45
00:03:51,610 --> 00:03:57,330
لحظة، لكن لم يبد أنّ يوكاري-سان وإيسي يخشيانه

46
00:03:57,330 --> 00:04:00,550
!ما هذا الجهل؟

47
00:04:00,550 --> 00:04:01,290
ما قصدك؟

48
00:04:01,500 --> 00:04:02,740
اسمعي

49
00:04:02,740 --> 00:04:05,220
يوكاري-ساما وإيسي-ساما رفيعيّ المقام بحدّ ذاتهما

50
00:04:05,220 --> 00:04:08,760
فلتعتبري نفسكِ محظوظة
!للكلام معهما حتّى

51
00:04:09,250 --> 00:04:13,430
الميزوتشي يوكاري-ساما هو يوكاي عظيم يعيش أبديّاً

52
00:04:13,430 --> 00:04:18,990
وإيسي-ساما رغم صغر سنّه هو من
!سلالة أياكاشي شوجو النبيلة

53
00:04:18,990 --> 00:04:23,070
...أتفهم كون يوكاري-سان يوكاي عظيماً

54
00:04:23,070 --> 00:04:26,610
لكن إيسي؟ فتى نبيل من طبقة مرموقة؟
يصعب عليّ تصديق ذلك

55
00:04:26,610 --> 00:04:28,080
!يا للفظاظة

56
00:04:28,800 --> 00:04:30,450
!الشوجو مُبهرون

57
00:04:30,450 --> 00:04:34,650
تشتعل أجسادهم بلونٍ قرمزيّ
!ويصدح زئيرهم عبر البحار

58
00:04:34,650 --> 00:04:38,840
يبثّون الرعب ويفرضون الاحترام بصفتهم
!يوكاي أسطوريّين عظماء

59
00:04:40,220 --> 00:04:42,940
يوكاي أسطوريّين عظماء؟

60
00:04:42,940 --> 00:04:46,610
لا تزال هناك أشياء كثيرة أجهلها

61
00:04:46,610 --> 00:04:51,670
ليس عن والديّ فحسب، لكن عن
يوكاري-سان وإيسي وحتّى آوي

62
00:04:52,190 --> 00:04:53,460
...لكن للوقت الراهن

63
00:04:53,990 --> 00:04:54,870
!حسناً

64
00:05:02,660 --> 00:05:04,360
بُوركت جهودك

65
00:05:04,360 --> 00:05:05,810
كيف تشعر؟

66
00:05:05,810 --> 00:05:09,790
أنا بخير، التصدعات الفرديّة
ليست مشكلة لذاك الحدّ

67
00:05:09,790 --> 00:05:13,180
لكنّ ذلك ما يجعل الأمر غير مفهوم

68
00:05:13,180 --> 00:05:17,060
لمَ يلجأ لحيلة لكسر الأختام على حدة؟

69
00:05:17,060 --> 00:05:18,600
وكيف استطاع فعل ذلك؟

70
00:05:19,320 --> 00:05:20,990
إنّه يحاول استفزازك وحسب

71
00:05:21,580 --> 00:05:23,270
هذا مُزعج

72
00:05:23,270 --> 00:05:27,800
لكن خيارنا الوحيد للوقت الحاليّ هو
تفقّد كافّة الأختام تدريجيّاً

73
00:05:27,800 --> 00:05:31,010
ما الذي يسعى له كاشا؟

74
00:05:31,280 --> 00:05:32,360
!آوي

75
00:05:32,360 --> 00:05:33,900
وجدتك أخيراً

76
00:05:34,360 --> 00:05:36,220
ما الذي أتى بكِ إلى هذا المكان البعيد؟

77
00:05:36,650 --> 00:05:38,690
أردت سؤالك عن كاشا

78
00:05:39,210 --> 00:05:40,250
كاشا؟

79
00:05:41,080 --> 00:05:44,490
...أتفهّم امتلاكك لأسبابك، لكن

80
00:05:47,560 --> 00:05:51,320
إن أخبرتكِ، فما الذي ستفعلينه لي بالمقابل إذاً؟

81
00:05:51,820 --> 00:05:53,910
!لـ-لن ينطلي عليّ ذلك اليوم

82
00:05:54,220 --> 00:05:57,270
لا يهمّ، إن كنت لا تريد الكلام
!يا آوي، إذاً إيسي

83
00:05:57,740 --> 00:06:00,260
أنت أياكاشي مُستعمل للنار، صحيح؟

84
00:06:00,260 --> 00:06:01,940
أي أنّك مثله

85
00:06:01,940 --> 00:06:03,620
...لا بدّ أنّك تعرف شيئاً في تلك الحالة

86
00:06:04,070 --> 00:06:06,310
!لا تلحقيني به

87
00:06:06,310 --> 00:06:08,410
!نيراننا بلونين مُختلفين كليّاً

88
00:06:08,410 --> 00:06:09,380
...صحيح

89
00:06:09,910 --> 00:06:13,740
ناره الظلاميّة تبتلع كلّ شيء فعليّاً

90
00:06:14,180 --> 00:06:18,860
بينما ناري في المقابل تحرق كلّ شيء
!أشبه بنيران الجحيم

91
00:06:18,860 --> 00:06:20,570
!لا تستهيني بي يا ابنة البشر

92
00:06:20,570 --> 00:06:22,920
أي أنّك أقوى منه؟

93
00:06:22,920 --> 00:06:24,020
!بالطبع

94
00:06:24,690 --> 00:06:25,990
...لكن

95
00:06:26,480 --> 00:06:32,380
تركت كلّ ذاك الهراء بين الأياكاشي
عندما أصبحت شيكيغامي آوي

96
00:06:32,820 --> 00:06:37,460
بعد كلّ ما مضى، أفضّل ألّا
أتعامل مع وغد مثل كاشا

97
00:06:37,950 --> 00:06:39,670
...هكذا إذاً

98
00:06:41,590 --> 00:06:44,880
لكن يا إيسي، أيمكنك حرق الأشياء
التي تركها كاشا؟

99
00:06:44,880 --> 00:06:47,100
!أنتِ... ألم تسمعي شيئاً مما قلتُه؟

100
00:06:47,480 --> 00:06:49,970
ما الذي تتكلّمين عنه يا هيماري؟

101
00:06:49,970 --> 00:06:53,280
ماذا؟ إنّها مثيرة للاشمئزاز ومزعجة، أليس كذلك؟

102
00:06:53,280 --> 00:06:57,730
وجود علامة كاشا أو أيّ ما كانت
...في أرجاء المنزل هكذا

103
00:06:58,100 --> 00:06:59,180
علامة؟

104
00:06:59,450 --> 00:07:01,720
لا تُمسح أيضاً

105
00:07:01,720 --> 00:07:04,280
من الجليّ أنّها ليست رسومات عاديّة

106
00:07:04,280 --> 00:07:07,000
أيمكن أنّكِ ترين شيئاً يا هيماري؟

107
00:07:07,290 --> 00:07:09,950
ماذا؟ لا ترونها؟

108
00:07:10,530 --> 00:07:13,920
توجد عجلات سوداء في أرجاء المنزل

109
00:07:14,240 --> 00:07:17,630
"كأنّها أثر صريح متبقّي يصرخ "كاشا

110
00:07:18,760 --> 00:07:20,670
انظروا، توجد واحدة هناك أيضاً

111
00:07:30,640 --> 00:07:31,330
!حاذري

112
00:07:36,350 --> 00:07:37,520
—ذلك

113
00:07:37,840 --> 00:07:40,590
!إنّه غوزو! لا بدّ أنّ كاشا نصب فخّاً

114
00:07:52,490 --> 00:07:54,330
أمسكت بك يا نوي

115
00:07:54,330 --> 00:07:55,030
!آوي

116
00:07:55,030 --> 00:07:55,980
!نوي-ساما

117
00:07:58,810 --> 00:08:00,160
تراجعوا

118
00:08:00,550 --> 00:08:02,560
...إيّاكم والاقتراب

119
00:08:02,560 --> 00:08:05,710
!تلك الحبال! إنّها تمتصّ قوّته

120
00:08:05,710 --> 00:08:08,080
!أي أنّها لعنة كانت تستهدف نوي-ساما

121
00:08:08,870 --> 00:08:10,170
!آوي

122
00:08:14,600 --> 00:08:15,430
!نوي-ساما

123
00:08:15,700 --> 00:08:16,660
!انتظر

124
00:08:16,660 --> 00:08:18,930
...لا توقفني! على هذا النحو، نوي-ساما سوف

125
00:08:18,930 --> 00:08:21,010
تمتصّ نيران كاشا الطاقة الروحيّة

126
00:08:21,010 --> 00:08:23,180
ستزيد الهجمات العشوائيّة
الطين بلّة وحسب

127
00:08:23,180 --> 00:08:23,850
!حسناً

128
00:08:23,850 --> 00:08:26,220
!سأحرقها كلّها بنيران أقوى

129
00:08:26,650 --> 00:08:27,720
!كلّا يا إيسي

130
00:08:29,690 --> 00:08:31,780
!فلتشتّت انتباهه

131
00:08:35,180 --> 00:08:36,900
!سأتكفّل بهذا الجانب

132
00:08:36,900 --> 00:08:38,240
!لا تفعل يا إيسي

133
00:08:38,240 --> 00:08:40,040
...إن أطلقتَ قوّتك الآن

134
00:08:52,340 --> 00:08:55,960
هذه هيئة إيسي الحقيقيّة... الشوجو

135
00:09:00,720 --> 00:09:02,430
!نجح! فعلها

136
00:09:05,980 --> 00:09:08,010
!إيسي؟ ما الخطب؟

137
00:09:08,010 --> 00:09:08,820
هذا سيّئ

138
00:09:09,850 --> 00:09:10,870
!إنّه يهيج

139
00:09:11,530 --> 00:09:12,760
يهيج؟

140
00:09:12,760 --> 00:09:17,110
وفق عقدنا كشيكيغامي، قوّتنا الروحيّة
مقيّدة بنوي-ساما

141
00:09:17,110 --> 00:09:20,760
لكنّ نوي-ساما مشلول

142
00:09:20,760 --> 00:09:23,420
وروابطنا كشيكيغامي كأنّها قُطعت

143
00:09:23,640 --> 00:09:25,930
ما الذي سيحلّ بإيسي إذاً؟

144
00:09:25,930 --> 00:09:30,660
على هذا النحوي، يمكن أن يحرق
إيسي نفسه ويهلك بنيرانه

145
00:09:30,660 --> 00:09:32,120
!كلّا

146
00:09:40,230 --> 00:09:42,290
!إيسي

147
00:09:50,520 --> 00:09:52,980
!يستحيل أن أسقط

148
00:09:52,980 --> 00:09:54,810
!يجب أن أحمي صديقي

149
00:09:55,440 --> 00:09:56,640
!هذه المرّة بالتأكيد

150
00:09:57,770 --> 00:09:59,000
...لذا

151
00:10:18,070 --> 00:10:19,760
!إيسي-دونو

152
00:10:20,090 --> 00:10:23,690
لاحقك أياكاشي شرّير من جديد، صحيح؟

153
00:10:23,690 --> 00:10:26,970
!أجل، رغم بؤس ذلك، شكراً لك على إنقاذي

154
00:10:26,970 --> 00:10:29,160
!كنت مُذهلاً يا إيسي-دونو

155
00:10:29,160 --> 00:10:32,780
!تزول الأياكاشي الشرّيرة من محض وهيج نيرانك

156
00:10:32,780 --> 00:10:34,050
...أ-أجل

157
00:10:35,210 --> 00:10:40,750
كما يُتوقّع من مُحارب شاب
!لعشيرة شوجو النبيلة

158
00:10:40,750 --> 00:10:43,900
لن أعرف، فقد نُفيت من العشيرة

159
00:10:43,900 --> 00:10:47,110
تكبّدوا وضع هذه عليّ أيضاً

160
00:10:47,370 --> 00:10:48,690
ما هي؟

161
00:10:48,690 --> 00:10:50,510
ألقوا لعنة عليها

162
00:10:50,510 --> 00:10:54,740
إن أطلقت قوّتي في عالم البشر، سيهلك جسدي

163
00:10:54,740 --> 00:10:56,790
!يا-يا للفظاعة

164
00:10:57,580 --> 00:11:00,980
كنتُ المنبوذ في العشيرة سلفاً

165
00:11:01,320 --> 00:11:04,640
"أحمقٌ يخالف قواعد عشيرتنا الفخورة"

166
00:11:04,640 --> 00:11:07,190
الابن الأصغر الشائن"، كانوا يقولون ذلك عنّي"

167
00:11:10,280 --> 00:11:14,820
أنا مسرورٌ بصراحة لأنّي ابتعدت
!عن تلك العشيرة المتزمتة

168
00:11:14,820 --> 00:11:19,950
!لا أحمل أيّ ندم، ولا أفتقد أيّ أحد بالتأكيد

169
00:11:20,360 --> 00:11:21,690
...إيسي-دونو

170
00:11:22,520 --> 00:11:27,450
ذلك جانباً، لا بدّ أنّك كنت متوجهاً للبئر
لاستراق نظرة لعالم البشر من جديد

171
00:11:28,060 --> 00:11:30,710
كنت على وشك التنزّه بدوري، سأرافقك

172
00:11:30,710 --> 00:11:31,840
!أجل

173
00:11:31,840 --> 00:11:34,200
يا إلهي، ما المسليّ في البشر؟

174
00:11:35,480 --> 00:11:40,430
يا للشخص الغريب، يرافق أحداً مثلي
رغم أنّه ضعيف جدّاً

175
00:11:41,110 --> 00:11:45,470
لكن، لن يكون من السيّئ
لو بقت الأمور على هذا الحال

176
00:11:45,470 --> 00:11:49,500
لا بأس بمجرّد التسكّع معه كلّ يوم والعيش باسترخاء

177
00:11:51,240 --> 00:11:55,660
إيسي-دونو، هلّا أخذتني لعالم البشر من فضلك؟

178
00:11:55,660 --> 00:11:56,680
لمَ؟

179
00:11:56,680 --> 00:11:59,970
أودّ رؤية البشر عن قرب

180
00:11:59,970 --> 00:12:01,720
!إنّهم مثيرون للاهتمام

181
00:12:01,720 --> 00:12:06,860
يتسلّل الدفء إلى قلبي برؤية روابطهم
"وما يدعونه بـ "العائلة" و "الأصدقاء

182
00:12:06,860 --> 00:12:08,180
يُسعدني ذلك جدّاً

183
00:12:08,180 --> 00:12:10,490
أودّك أن تشاركني الشعور يا إيسي-دونو

184
00:12:10,970 --> 00:12:13,520
عائلة وأصدقاء؟

185
00:12:13,520 --> 00:12:16,010
ما نفع هذه للأياكاشي؟

186
00:12:16,010 --> 00:12:17,580
...لا أفهم، لكن

187
00:12:27,370 --> 00:12:28,860
حسناً

188
00:12:28,860 --> 00:12:30,800
!شكراً لك

189
00:12:38,730 --> 00:12:39,810
أين نحن؟

190
00:12:39,810 --> 00:12:44,900
منزلٌ يقع على الحدّ بين عالم البشر
وعالم الأرواح كما يبدو

191
00:12:44,900 --> 00:12:47,100
إن عبرنا من هنا ونزلنا الجبل

192
00:12:47,100 --> 00:12:49,470
فسنصل بلدةً في عالم البشر

193
00:12:49,470 --> 00:12:51,610
!أشعر بالحماس

194
00:12:59,680 --> 00:13:02,490
!لن أدعك تؤذيه

195
00:13:12,180 --> 00:13:14,480
!فلتحترق

196
00:13:25,360 --> 00:13:26,850
!إيسي-دونو

197
00:13:28,900 --> 00:13:30,940
لم تُصب بأذى، صحيح؟

198
00:13:31,860 --> 00:13:34,590
!إيسي-دونو

199
00:13:42,370 --> 00:13:43,720
أين أنا؟

200
00:13:44,890 --> 00:13:47,010
...لا أستطيع الحراك

201
00:13:47,700 --> 00:13:49,150
صحيح

202
00:13:49,150 --> 00:13:52,360
...خرقت القاعدة، مما يعني أنّ اللعنة

203
00:13:57,050 --> 00:13:58,280
بشريّ؟

204
00:13:58,670 --> 00:14:00,320
من أنت؟

205
00:14:00,320 --> 00:14:04,200
أنا آوي، يدعوني البعض بأوماموري-ساما

206
00:14:04,520 --> 00:14:06,480
أوماموري-ساما؟

207
00:14:06,480 --> 00:14:10,040
ستموت إذا لم نقم بشيء

208
00:14:10,040 --> 00:14:12,920
لكن إن أصبحت الشيكيغامي خاصّتي، فستنجو

209
00:14:12,920 --> 00:14:13,810
أخبرني يوكاري بذلك

210
00:14:14,160 --> 00:14:17,720
لمَ قد ينقذ طفل بشريّ يوكاي؟

211
00:14:17,720 --> 00:14:19,610
أتسعى وراء قوّتي؟

212
00:14:19,990 --> 00:14:23,330
لا، طلب منّي صديقك أن أساعدك

213
00:14:23,700 --> 00:14:25,440
صديقي؟

214
00:14:25,440 --> 00:14:26,770
!إيسي-دونو

215
00:14:29,350 --> 00:14:32,100
أنت! ما الذي حصل لك؟

216
00:14:32,100 --> 00:14:35,600
استهلك كافّة قوّته لحمايتك

217
00:14:37,310 --> 00:14:42,300
...أخشى أنّي بقيت بائساً إلى النهاية

218
00:14:42,620 --> 00:14:46,310
لكنّي مسرورٌ لرؤيتك مرّة أخيرة يا إيسي-دونو

219
00:14:47,400 --> 00:14:51,620
أوماموري-ساما، فلتنقذه رجاءً

220
00:14:51,990 --> 00:14:54,840
إيسي-دونو أقوى وألطف من أيّ أحدٍ أعرفه

221
00:14:54,840 --> 00:14:57,190
إنّه مهمٌّ جدّاً لي

222
00:14:59,300 --> 00:15:00,950
...حمداً للربّ

223
00:15:02,140 --> 00:15:05,330
إيسي-دونو، شكراً لك على كلّ شيء

224
00:15:05,330 --> 00:15:07,450
...أدركت أخيراً

225
00:15:08,800 --> 00:15:14,200
الوقت الذي أمضيتُه معك كان أشبه
بحلم ظهيرة دافئ

226
00:15:14,200 --> 00:15:16,970
كان كنزاً ثميناً أعتزّ به

227
00:15:17,830 --> 00:15:18,970
...أنت

228
00:15:19,370 --> 00:15:21,550
فلتعش رجاءً

229
00:15:22,350 --> 00:15:26,450
أتمنّى لك السعادة الأبديّة

230
00:15:32,520 --> 00:15:34,390
...يا صديقي العزيز

231
00:15:41,990 --> 00:15:46,260
في ذاك اليوم، فقدت أوّل صديق حصلت عليه

232
00:15:46,940 --> 00:15:49,160
...ثمّ أقسمت

233
00:15:49,160 --> 00:15:53,140
أنّي لن أقوم بشيء يعرّضني
!لخسارة صديق من جديد

234
00:15:53,410 --> 00:15:56,070
!سأحميه بكافّة الوسائل

235
00:15:56,730 --> 00:16:00,340
!حتّى لو أهلكت نفسي

236
00:16:03,810 --> 00:16:06,190
!إيسي! توقّف رجاءً

237
00:16:06,190 --> 00:16:08,200
!لا يحتمل جسدك المزيد

238
00:16:08,430 --> 00:16:10,870
!فقد إيسي السيطرة على نفسه كليّاً

239
00:16:10,870 --> 00:16:12,800
لم يعد يسمعنا

240
00:16:12,800 --> 00:16:15,240
كلّا... ألا يوجد ما يمكننا فعله؟

241
00:16:15,510 --> 00:16:19,900
...لو استرجع نوي-ساما قواه وأمَر إيسي

242
00:16:19,900 --> 00:16:22,490
تلك الحبال تمنع ذلك، صحيح؟

243
00:16:22,490 --> 00:16:23,340
أجل

244
00:16:23,830 --> 00:16:28,260
لو ضعفت نيران كاشا ولو للحظة، فسأستطيع إزالتها

245
00:16:28,630 --> 00:16:32,330
!تحتاج للحظة وحسب، صحيح؟ فهمت

246
00:16:32,330 --> 00:16:34,350
!يوكاري-سان، أودّ طلب معروف منك

247
00:16:34,940 --> 00:16:36,170
هيماري؟

248
00:16:40,700 --> 00:16:42,350
ما أروع هذا لي

249
00:16:42,350 --> 00:16:45,830
يا لجمالك في ألمك ومعاناتك يا نوي

250
00:16:46,430 --> 00:16:47,650
...كاشا

251
00:16:48,290 --> 00:16:49,870
أخبرني يا نوي

252
00:16:49,870 --> 00:16:53,460
لم ترَ الشعارات التي تركتها، صحيح؟

253
00:16:53,460 --> 00:16:55,660
لمَ برأيك؟

254
00:16:58,330 --> 00:17:02,830
سأخبرك، ذلك دليلٌ على كونك أحدنا

255
00:17:03,270 --> 00:17:06,790
عبرتَ إلى جانب الأياكاشي سلفاً

256
00:17:07,120 --> 00:17:09,360
هيّا، فلنذهب معاً

257
00:17:09,360 --> 00:17:11,740
يا لعبتي الظريفة

258
00:17:11,740 --> 00:17:15,300
أرحّب بك في عالم الظلام الجميل

259
00:17:18,140 --> 00:17:19,270
!آوي

260
00:17:29,770 --> 00:17:31,200
...هيماري

261
00:17:31,420 --> 00:17:35,010
أنا بخير، يحميني حاجز يوكاري-سان

262
00:17:35,010 --> 00:17:36,050
...ما أهمّ من ذلك

263
00:17:36,980 --> 00:17:38,360
!تماسك

264
00:17:38,360 --> 00:17:40,940
!الشيكيغامي... عائلتك تناديك

265
00:17:40,940 --> 00:17:43,530
ألا تسمع صراخ إيسي؟

266
00:17:45,970 --> 00:17:47,120
...إيسي

267
00:17:48,500 --> 00:17:49,500
!هذه الحبال الكريهة

268
00:17:51,590 --> 00:17:52,960
!يوكاري-سان! الآن

269
00:17:57,220 --> 00:17:59,900
هيّا، فلتفق

270
00:17:59,900 --> 00:18:01,960
من هنا يا آوي

271
00:18:02,510 --> 00:18:03,660
...هيماري

272
00:18:06,900 --> 00:18:09,370
شكراً على مساعدتك

273
00:18:10,170 --> 00:18:11,130
!آوي

274
00:18:11,650 --> 00:18:14,510
اسمعني أيّها الشيكيغامي خاصّتي

275
00:18:15,200 --> 00:18:17,600
...هذا صوت

276
00:18:17,600 --> 00:18:22,940
!بأمر الأوماموري، استعد اسمك أيّها الخاطف إيسي

277
00:18:26,500 --> 00:18:29,280
أطلت عليك بالانتظار، أنا آسف

278
00:18:29,280 --> 00:18:30,530
...نوي-ساما

279
00:18:34,420 --> 00:18:37,450
!هيّا يا إيسي، استعمل نيرانك الحقيقيّة لحرقه

280
00:18:55,110 --> 00:18:57,060
...منزلي المسكين

281
00:18:57,060 --> 00:18:58,370
لا مفرّ من هذا

282
00:18:58,370 --> 00:19:00,860
لم أستعمل كامل قوّتي منذ فترة

283
00:19:00,860 --> 00:19:02,060
!لكن منزلي

284
00:19:02,060 --> 00:19:04,100
فلتصمتي وحسب

285
00:19:04,100 --> 00:19:05,730
سأصلحه

286
00:19:05,730 --> 00:19:08,380
أجل، هذا أفضل

287
00:19:08,380 --> 00:19:11,360
لكن لا تقلق، سأساعدك

288
00:19:11,660 --> 00:19:15,280
،بما أنّنا أصدقاء... أو ربما عائلة

289
00:19:15,280 --> 00:19:16,640
!تعيش تحت السقف نفسه

290
00:19:18,390 --> 00:19:19,720
اصمتي

291
00:19:20,290 --> 00:19:24,580
لم أتصوّر أنّ هيماري تستطيع
رؤية الشعارات الخفيّة

292
00:19:24,930 --> 00:19:29,440
ناهيك عن هبّها في نيران كاشا
بلا خوف رغم كونها بشريّة

293
00:19:29,440 --> 00:19:31,060
لأجل إنقاذك يا آوي

294
00:19:31,580 --> 00:19:33,530
فاجأتني بصراحة

295
00:19:33,530 --> 00:19:34,290
أجل

296
00:19:34,640 --> 00:19:39,060
هيماري أقوى بمراحل مما ظننت في البداية

297
00:19:39,480 --> 00:19:44,860
لا تقيّدها أيّة قواعد، وتعلّمني دوماً الأشياء
المهمّة بينما تبقى مخلصة لذاتها

298
00:19:45,350 --> 00:19:48,530
إنّها تمتلك شيئاً أفتقر له

299
00:19:48,530 --> 00:19:52,200
أيضايقك عجزك عن رؤية علامات كاشا؟

300
00:19:52,200 --> 00:19:54,730
—وضعها عمداً كيلا

301
00:19:54,730 --> 00:19:55,640
الأمر ليس كذلك

302
00:19:57,060 --> 00:20:00,140
،سمعت ما قاله إيسي
إنّه يحاول استفزازي

303
00:20:00,590 --> 00:20:03,010
يستغلّ نقاط ضعفي

304
00:20:03,500 --> 00:20:06,760
ذلك دليلٌ على كونك أحدنا

305
00:20:06,760 --> 00:20:09,760
عبرتَ إلى جانب الأياكاشي سلفاً

306
00:20:10,130 --> 00:20:14,480
إنّه يجيد مهاجمة أكثر
ما أكرهه في نفسي دوماً

307
00:20:15,100 --> 00:20:16,150
...آوي

308
00:20:26,740 --> 00:20:28,610
ما-ما الخطب يا آوي؟

309
00:20:30,080 --> 00:20:31,610
لا شيء

310
00:20:36,490 --> 00:20:37,820
!آوي

311
00:20:37,820 --> 00:20:38,960
آسف، لم أستطع منع نفسي

312
00:20:38,960 --> 00:20:40,420
عن ماذا؟

313
00:20:41,500 --> 00:20:43,450
عن تمنّي شيء

314
00:20:43,450 --> 00:20:44,760
ماذا تقصد بالضبط؟

315
00:20:45,760 --> 00:20:49,440
أتمنّى بقائكِ هنا لفترة أطول

316
00:20:51,420 --> 00:20:54,750
يا إلهي، لا أفهم ما الذي
تتكلّم عنه أبداً

317
00:20:56,680 --> 00:20:58,100
...أتساءل

318
00:20:58,100 --> 00:21:00,810
إلى متى سنستطيع
مواصلة العيش هكذا؟

319
00:21:01,910 --> 00:21:03,180
لا أعلم

320
00:21:10,210 --> 00:21:12,410
تمّ العقد هكذا

321
00:21:13,170 --> 00:21:16,030
سيكون أمامنا وقت أبديّ
للتعرّف على بعضنا يا إيسي

322
00:21:16,520 --> 00:21:18,670
بدأ الأمر شيئاً خارجاً عن إرادتي

323
00:21:18,670 --> 00:21:20,800
كان عقداً لا بدّ من إبرامه

324
00:21:20,800 --> 00:21:22,130
...ومع ذلك

325
00:21:22,130 --> 00:21:25,650
أبديّ"؟ إلى متى بالضبط؟"

326
00:21:25,650 --> 00:21:28,980
لا أدري، ربما إلى مماتي؟

327
00:21:31,550 --> 00:21:32,780
فقط؟

328
00:21:33,070 --> 00:21:35,430
لن يطول الأمر إذاً

329
00:21:35,960 --> 00:21:37,740
فالبشر قصيرو الأعمار

330
00:21:39,800 --> 00:21:40,900
معك حقّ

331
00:21:41,840 --> 00:21:42,980
...ومع ذلك

332
00:21:43,420 --> 00:21:46,110
لن أفلت هذه الرابطة

333
00:21:46,670 --> 00:21:48,580
ذلك ما أقسمتُ به

334
00:21:51,900 --> 00:21:55,410
من يأبه بالمدّة؟

335
00:21:55,850 --> 00:21:57,920
سأبقى بجانب آوي إلى الأبد

336
00:21:58,820 --> 00:22:00,210
ألست مثلي؟

337
00:22:00,960 --> 00:22:02,250
ربما

338
00:22:04,830 --> 00:22:09,030
يا صديقي الذي أنقذني في الماضي، أتشاهدني الآن؟

339
00:22:09,980 --> 00:22:16,210
أنا أعيش يوماً آخراً أضحك فيه مع أعزّ أصدقائي

340
00:23:49,980 --> 00:23:52,390
...لا أتذكّر

341
00:23:52,390 --> 00:23:54,430
من كنت؟

342
00:23:54,950 --> 00:23:59,950
الحلقة القادمة

343
00:23:54,950 --> 00:23:59,950
غروب إيناري

344
00:23:54,950 --> 00:23:59,950
الحلقة الخامسة