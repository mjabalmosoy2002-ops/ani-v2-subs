1
00:00:02,970 --> 00:00:05,760
ما كانت الحصّة الأولى من جديد؟

2
00:00:18,650 --> 00:00:20,240
...ا-المعذرة

3
00:00:24,780 --> 00:00:26,410
لا تقتربي منّي

4
00:00:27,060 --> 00:00:28,500
ستلحق بكِ اللعنة

5
00:00:37,920 --> 00:00:42,430
عليكِ ألّا تنظري لي

6
00:02:12,560 --> 00:02:16,570
الحلقة الخامسة   غروب إيناري

7
00:02:14,390 --> 00:02:15,660
أتى اليوم؟

8
00:02:15,660 --> 00:02:17,320
لا أزال خائفةً منه

9
00:02:17,320 --> 00:02:18,630
...هيداكا الملعون

10
00:02:18,630 --> 00:02:19,790
ملعون؟

11
00:02:21,750 --> 00:02:23,530
!صباح الخير يا هيماري

12
00:02:23,530 --> 00:02:24,790
!روي! صباح الخير

13
00:02:24,790 --> 00:02:26,670
أخبريني، من ذاك الفتى؟

14
00:02:27,240 --> 00:02:29,300
إنّه هيداكا هاياتو

15
00:02:29,300 --> 00:02:31,520
أهذه أوّل مرّة ترينه فيها؟

16
00:02:32,030 --> 00:02:33,660
هيداكا-كن؟

17
00:02:33,660 --> 00:02:38,890
لا يأتي للمدرسة كثيراً، ويصعب الاقتراب منه نوعاً ما

18
00:02:38,890 --> 00:02:41,420
تنبعث منه هالة "اتركوني وشأني" بالتأكيد

19
00:02:41,420 --> 00:02:44,260
...أجل، كما هناك تلك الشائعة الغريبة عنه

20
00:02:44,260 --> 00:02:44,860
شائعة؟

21
00:02:45,110 --> 00:02:49,730
،يُقال إنّه إن اقتربتِ من هيداكا-كن
فسيصبكِ المرض أو تتعرّضين للأذى

22
00:02:49,730 --> 00:02:51,180
لم أكن أعلم

23
00:02:51,180 --> 00:02:54,300
أجل، لكنّها محض شائعة

24
00:02:54,740 --> 00:02:59,370
سمعت أنّ السيّد هيداكا كان بهيجاً جدّاً

25
00:02:59,370 --> 00:03:03,420
لكنّ شخصيّته تغيّرت فجأةً وبدأ
بقول أشياء غريبة

26
00:03:03,420 --> 00:03:05,780
عن صديق طفولة اختفى أثره

27
00:03:05,780 --> 00:03:07,760
صديق طفولة؟

28
00:03:07,760 --> 00:03:10,760
لذا يقول الجميع أنّ هيداكا-كن ملعون

29
00:03:10,760 --> 00:03:12,990
لكنّها مجرّد شائعة سخيفة

30
00:03:13,260 --> 00:03:18,490
كون عائلة السيّد هيداكا هي عشيرة
تسوكيمونو لا تخدمه هنا

31
00:03:18,490 --> 00:03:20,800
عشيرة تسوكيمونو؟ من أولئك؟

32
00:03:21,080 --> 00:03:25,260
ربما عليكِ سؤال ناتشي-سينسي
عن المزيد من المعلومات

33
00:03:26,060 --> 00:03:28,640
،إنّه يدرّس اليابانيّة الكلاسيكيّة

34
00:03:28,640 --> 00:03:32,890
لكنّه ضليعٌ في الثقافة المحلّية
والتاريخ والمأثورات الشعبيّة أيضاً

35
00:03:32,890 --> 00:03:35,270
أذهب إليه أحياناً للاستنارة من علمه

36
00:03:35,270 --> 00:03:36,860
أحقّاً ذلك؟

37
00:03:37,350 --> 00:03:40,050
...لا تزال مجرّد شائعة، لكن

38
00:03:40,050 --> 00:03:42,120
فلتتوخي الحذرة يا هيماري-تشان

39
00:03:42,120 --> 00:03:43,830
سأفعل، شكراً لكم

40
00:03:44,860 --> 00:03:46,720
هيداكا-كن إذاً؟

41
00:03:47,180 --> 00:03:50,230
قلّما يأتي للمدرسة

42
00:03:50,600 --> 00:03:52,530
كنت قلقاً عليه أيضاً

43
00:03:52,870 --> 00:03:58,240
لذا يسرّني أنّكِ لا تخافينه
وتودّين التعرّف عليه

44
00:03:58,580 --> 00:04:02,130
ما قصّة "عشيرة تسوكيمونو" بالأصل؟

45
00:04:04,590 --> 00:04:12,410
ببساطة، إنّهم عائلات تجنّد الأياكاشي
على مرّ الأجيال

46
00:04:12,410 --> 00:04:17,050
توجد أصناف كثيرة لتتعاقد معها، من الثعالب
والكلاب والأفاعي والكثير غير ذلك

47
00:04:17,370 --> 00:04:21,060
تطغى العائلات الثرّية على مجتمع عشيرة تسوكيمونو

48
00:04:21,060 --> 00:04:26,140
وعادةً ما تتعرّض للكراهيّة والتمييز

49
00:04:26,140 --> 00:04:28,780
الكراهيّة؟ لمَ؟

50
00:04:28,780 --> 00:04:33,280
توجد أسباب كثيرة، لكنّ الدافع الرئيسيّ
هو الغيرة البشريّة

51
00:04:33,280 --> 00:04:35,860
وربما الخوف من المجهول

52
00:04:37,360 --> 00:04:43,240
لا يفهم الناس بالضرورة دوماً
أولئك ذوي الموهبة الاستثنائيّة

53
00:04:43,850 --> 00:04:48,690
لحسن الحظّ، لم يتعرّض بنو هيداكا
إلى تمييزٍ وفق علمي

54
00:04:49,020 --> 00:04:53,130
كانوا يمتلكون مستشارين بارعين من عائلة موموتشي

55
00:04:53,130 --> 00:04:55,190
ماذا؟ تـ-تقصد عائلتي؟

56
00:04:55,490 --> 00:05:00,160
يبدو أنّ بنو موموتشي كانوا يشغلون
دور وسطاء روحيّين بشكلٍ ما

57
00:05:00,160 --> 00:05:04,210
ويقدّمون العون للعوائل مثل عائلة هيداكا وغيرها

58
00:05:04,940 --> 00:05:10,060
سمعت أنّ رئيسيّ عائلة موموتشي السابقين
كانا زوجين بغاية اللطف

59
00:05:10,670 --> 00:05:13,530
أنا متأكّد أنّ بني هيداكا اعتمدوا عليهما كثيراً

60
00:05:13,530 --> 00:05:16,590
...الرئيسين السابقة؟ لا بدّ أنّهما كانا

61
00:05:16,590 --> 00:05:21,790
ربما يمكنني اكتشاف المزيد عن والديّ
بزيارتي لمنزل هيداكا-كن

62
00:05:22,100 --> 00:05:25,160
ذلك حدّ معرفتي

63
00:05:27,440 --> 00:05:29,090
!شكراً جزيلاً لك

64
00:05:29,090 --> 00:05:32,230
سأجرّب زيارة منزل هيداكا-كن

65
00:05:34,210 --> 00:05:38,930
هنا يعيش هيداكا-كن إذاً؟

66
00:06:05,870 --> 00:06:06,460
!من هناك؟

67
00:06:08,970 --> 00:06:11,270
إنّها... أنتِ من الصباح

68
00:06:11,270 --> 00:06:13,950
أنا موموتشي، موموتشي هيماري

69
00:06:13,950 --> 00:06:15,780
ماذا تفعلين عند منزلي؟

70
00:06:15,780 --> 00:06:19,590
أتيت لأنّي سمعت أنّ عائلتي
وعائلتك كانتا مقرّبتين

71
00:06:20,950 --> 00:06:23,550
،هل تعرف شيئاً عن والديّ

72
00:06:23,550 --> 00:06:26,030
رئيسا عائلة موموتشي السابقين؟

73
00:06:26,750 --> 00:06:28,210
لا أعرفهما

74
00:06:30,120 --> 00:06:33,580
—فهمت، إذاً ما الظلام الذي

75
00:06:33,580 --> 00:06:36,260
أخبرتكِ، لا تقتربي منّي وإلّا ستلحق بكِ اللعنة

76
00:06:36,260 --> 00:06:37,290
ارحلي من هنا

77
00:06:47,590 --> 00:06:52,360
من المؤسف أنّي لم أكتشف شيئاً عن والديّ

78
00:06:52,720 --> 00:06:55,580
...لكن أيمكن أن تكون لعنة هيداكا-كن

79
00:06:55,580 --> 00:06:56,680
ارحلي

80
00:06:57,810 --> 00:07:02,500
لا تقتربي من هيداكا، لن أدعه يفلت

81
00:07:08,560 --> 00:07:10,400
مـ-من أنت؟

82
00:07:17,790 --> 00:07:19,900
ما الخطب يا هيماري؟

83
00:07:21,250 --> 00:07:23,620
تبدين شاردة الذهن

84
00:07:23,620 --> 00:07:25,700
هل لم يناسبكِ الطعام؟

85
00:07:25,700 --> 00:07:27,150
لـ-ليس الأمر كذلك

86
00:07:27,150 --> 00:07:30,260
آسفة، كان هناك ما يشغل بالي وحسب

87
00:07:32,540 --> 00:07:36,830
التقيتُ بصغيرٍ غامض اليوم
يرتدي قناع ثعلب

88
00:07:36,830 --> 00:07:37,910
أياكاشي؟

89
00:07:37,910 --> 00:07:41,430
أعتقد أنّه متّصل بأحد زملائي في المدرسة

90
00:07:41,700 --> 00:07:43,390
فتى يُدعى هيداكا-كن

91
00:07:44,550 --> 00:07:47,100
تقصدين هيداكا هاياتو؟

92
00:07:49,020 --> 00:07:51,900
آوي، أتعرف هيداكا-كن؟

93
00:07:52,490 --> 00:07:54,480
أجل، أعرفه

94
00:07:56,240 --> 00:07:58,150
كان صديق طفولتي

95
00:07:59,130 --> 00:08:02,410
...أي أنّ صديق طفولته الذي اختفى أثره

96
00:08:02,410 --> 00:08:04,880
أجل، كان أنا على الأرجح

97
00:08:05,220 --> 00:08:07,580
رغم أنّي لا أظنّه يتذكّر

98
00:08:11,400 --> 00:08:12,670
صحيح

99
00:08:12,940 --> 00:08:16,930
لا أحد يتذكّر آوي الآن بما
،أنّه أوماموري-ساما

100
00:08:16,930 --> 00:08:18,770
بالرغم من أنّه يتذكّرهم

101
00:08:18,770 --> 00:08:23,550
إذا كان هناك من يتذكّرك، فهل تودّ لقاءه؟

102
00:08:23,550 --> 00:08:26,130
أنا بخير دون ذلك الآن

103
00:08:26,660 --> 00:08:28,750
...أنا أعيش في عالمٍ مختلف، لذا

104
00:08:35,490 --> 00:08:38,240
هيماري؟ ما الخطب؟

105
00:08:38,950 --> 00:08:40,860
تبدين حزينة

106
00:08:42,130 --> 00:08:44,280
لا، لا شيء هناك

107
00:08:59,160 --> 00:09:01,550
...لا أتذكّر

108
00:09:01,550 --> 00:09:03,620
من كنت؟

109
00:09:12,100 --> 00:09:13,830
صباح الخير يا هيداكا-كن

110
00:09:13,830 --> 00:09:14,770
...أنتِ

111
00:09:14,770 --> 00:09:17,360
اسمي ليس "أنتِ"، إنّه موموتشي هيماري

112
00:09:18,910 --> 00:09:21,700
ألم أخبركِ بعدم الاقتراب منّي؟

113
00:09:22,370 --> 00:09:23,540
لأنّي سأُلعن؟

114
00:09:26,190 --> 00:09:29,380
أنا بخير، فلديّ مقاومة عالية لتلك الأشياء

115
00:09:29,380 --> 00:09:31,780
هذه ليس طرفة

116
00:09:31,780 --> 00:09:37,970
أعرف أنّك تتفادى الناس كيلا تُلحق
اللعنة بهم أموراً سيّئة

117
00:09:37,970 --> 00:09:38,980
ذلك لطفٌ منك

118
00:09:40,430 --> 00:09:46,320
بعدما غادرتُ منزلك بالأمس، التقيتُ
صغيراً يرتدي قناع ثعلب

119
00:09:46,840 --> 00:09:48,360
!استطعتِ رؤيته؟

120
00:09:48,360 --> 00:09:50,640
أجل، أعتقد أنّه أياكاشي

121
00:09:50,950 --> 00:09:53,440
يبدو خطيراً نوعاً ما في الواقع

122
00:09:53,440 --> 00:09:57,030
تفهمين إذاً، فلتدعيني وشأني الآن

123
00:09:57,340 --> 00:10:01,110
،لكن بعد رؤيتي له الآن
لا يمكنني التظاهر بعدم حصول ذلك

124
00:10:03,660 --> 00:10:07,050
لنحلّ الأمر معاً، لا تعزل نفسك

125
00:10:10,780 --> 00:10:15,700
إلى جيل جدّي، كانت عائلتي ترى
تلك الأشياء وفقما يبدو

126
00:10:16,180 --> 00:10:18,330
لكن لا أحد يستطيع الآن

127
00:10:18,630 --> 00:10:22,530
مع ذلك، أشعر بتلبّس شيءٍ لي

128
00:10:22,980 --> 00:10:24,930
ألديك فكرة عن طبيعته؟

129
00:10:25,740 --> 00:10:27,230
...أبرمت صفقة

130
00:10:27,230 --> 00:10:28,390
صفقة؟

131
00:10:34,860 --> 00:10:35,830
انظري

132
00:10:35,830 --> 00:10:38,320
نفل رباعيّ الأوراق؟ يا للظرافة

133
00:10:38,560 --> 00:10:41,050
أعطاني إيّاها صديقي كتميمة

134
00:10:41,050 --> 00:10:44,660
كنتُ مقرّباً جدّاً من أحدهم

135
00:10:44,860 --> 00:10:47,310
أو على الأقلّ، أظنّ ذلك

136
00:10:47,310 --> 00:10:49,620
لا أتذكّر وجهه أو اسمه

137
00:10:50,190 --> 00:10:54,220
كان بغاية الذكاء، وكنّا مختلفين كليّاً

138
00:10:54,220 --> 00:10:57,770
لكنّنا أمضينا جلّ وقتنا سويّاً
...دون انفصال، ومع ذلك

139
00:10:58,970 --> 00:11:01,920
بدأ يتفاداني فجأةً

140
00:11:01,920 --> 00:11:03,470
هل تشاجرتما؟

141
00:11:03,470 --> 00:11:04,210
كلّا

142
00:11:04,440 --> 00:11:07,570
لكن كان من الجليّ لي أنّه
أراد تجنّبي

143
00:11:08,940 --> 00:11:11,490
شعرت كأنّه سينبذني

144
00:11:11,490 --> 00:11:17,860
لذا خطرت لي فكرة إعطاؤه تميمة
نفل رباعيّ الأوراق متماثلة

145
00:11:20,300 --> 00:11:22,240
لكنّي لم أستطع إيجاد واحدة أبداً

146
00:11:22,770 --> 00:11:26,360
وعندئذٍ سمعت ذاك الصوت لأوّل مرّة

147
00:11:27,130 --> 00:11:30,200
أتريدنني أن أحقّق أمنيتك؟

148
00:11:31,160 --> 00:11:36,130
أعطني أغلى شيء لديك، وسأحقّق أمنيتك

149
00:11:42,970 --> 00:11:45,250
!حسنٌ، اكتمل عقدنا

150
00:11:55,080 --> 00:11:58,980
ظننت أنّنا سنستطيع أن نكون
صديقين من جديد أخيراً

151
00:11:59,920 --> 00:12:05,210
لكنّه اختفى، وكأنّه لم يكن موجوداً

152
00:12:05,210 --> 00:12:08,570
!لم يتذكّر أحدٌ وجهه أو اسمه

153
00:12:09,190 --> 00:12:10,530
...ولا حتّى أنا

154
00:12:10,860 --> 00:12:13,650
!أقدمتُ على أمرٍ فظيع

155
00:12:13,650 --> 00:12:18,870
قايضتُ أعزّ أصدقائي لتحقيق
!أمنية تافهة صغيرة

156
00:12:19,750 --> 00:12:22,730
!لن أستطيع مسامحة نفسي قطّ

157
00:12:23,220 --> 00:12:26,920
لا يمكنني الاعتذار أو التعويض عليه حتّى

158
00:12:27,650 --> 00:12:29,260
!لا شيء يسعني فعله

159
00:12:29,260 --> 00:12:30,310
...هيداكا-كن

160
00:12:30,310 --> 00:12:32,810
لذا جنيتُ على نفسي بما أعانيه الآن

161
00:12:33,190 --> 00:12:35,690
لا بدّ أنّه لعنني

162
00:12:35,690 --> 00:12:36,650
!أنت مُخطئ

163
00:12:37,320 --> 00:12:40,890
لم يكن صديق طفولتك من لعنك

164
00:12:41,720 --> 00:12:44,600
هيداكا-كن، لم يختف صديقك

165
00:12:44,600 --> 00:12:47,360
لا يزال معنا... أنا مؤمنة بذلك

166
00:12:47,800 --> 00:12:49,080
...موموتشي

167
00:12:49,320 --> 00:12:52,540
لنزل اللعنة معاً يا هيداكا-كن

168
00:12:57,010 --> 00:13:00,010
...فهمت، أي من منظور هاياتو، أنا

169
00:13:00,010 --> 00:13:03,770
،أجل، لا يتذكّر اسمك أو ملامحك

170
00:13:03,770 --> 00:13:06,760
لكنّه لم ينسك كليّاً أيضاً

171
00:13:07,110 --> 00:13:08,870
لا خيار بيدنا إذاً

172
00:13:08,870 --> 00:13:10,460
لنرَ ما يمكننا فعله

173
00:13:10,460 --> 00:13:11,830
!شكراً لك

174
00:13:11,830 --> 00:13:17,530
تكمن المغالطة الأساسيّة في ظنّ هاياتو
أنّي اختفيت بسببه

175
00:13:17,900 --> 00:13:23,520
لا بدّ أنّ يوم دخولي لمنزل موموتشي
كان نفس يوم

176
00:13:23,520 --> 00:13:25,480
تمنّيه لأمنيته في الضريح

177
00:13:26,030 --> 00:13:29,440
ذلك ما عقّد الوضع

178
00:13:29,440 --> 00:13:34,570
ولا تزال اللعنة التي لحقت به
تسبّب له متاعباً لهذا اليوم

179
00:13:34,840 --> 00:13:40,230
لا بدّ أنّ الأياكاشي الذي رأيتِه بقناع
الثعلب كان كبير الضريح

180
00:13:40,230 --> 00:13:44,040
روح الثعلب التي حرست عائلة
هيداكا هي من وراء هذا

181
00:13:44,580 --> 00:13:49,920
لمَ تلعنه روح الثعلب التي تحرس عائلته؟

182
00:13:50,260 --> 00:13:55,710
ربما لأنّ لا أحد في عائلة هيداكا يعرف
شيئاً عن روح الثعلب بعد الآن

183
00:13:56,210 --> 00:14:00,480
عشيرة تسوكيمونو هي عوائل تبرم
اتّفاقيّات مع الأياكاشي التي تجنّدها

184
00:14:00,480 --> 00:14:03,020
لكن يتبع ذلك صعوبة التعامل معها

185
00:14:03,600 --> 00:14:07,610
عند عدم تبجيلها كما يجب، ستجلب المصائب للعائلة

186
00:14:07,610 --> 00:14:12,110
لكن لم يعد بمقدور عائلة
هيداكا-كن رؤية الأياكاشي

187
00:14:12,110 --> 00:14:14,240
لا يشكّل ذلك فرقاً

188
00:14:14,810 --> 00:14:19,630
لا تأبه الأياكاشي بما يناسب
البشر، أو بشعورهم

189
00:14:19,630 --> 00:14:21,830
...لذا لعنت هيداكا-كن

190
00:14:22,400 --> 00:14:25,690
مقابل ما كان "الأغلى" له

191
00:14:27,050 --> 00:14:28,990
،لإزالة اللعنة

192
00:14:28,990 --> 00:14:33,720
علينا قطع العقد بين روح الثعلب
وعائلة هيداكا كما يجب

193
00:14:33,720 --> 00:14:37,550
ولتحقيق ذلك، سأحتاج لعونكِ يا هيماري

194
00:14:39,580 --> 00:14:42,070
أعد بأن تشعر بتحسّن عمَّ قريب

195
00:14:42,510 --> 00:14:43,930
تماسك أكثر

196
00:14:43,930 --> 00:14:45,530
موموتشي، ما الذي تفعلينه؟

197
00:14:45,530 --> 00:14:48,400
يبدو أنّ علينا تنظيف الضريح أوّلاً

198
00:14:48,400 --> 00:14:51,220
ثمّ نشكر الروح على كلّ ما قدّمته
على مرّ الأعوام

199
00:14:52,940 --> 00:14:55,480
حسناً، إلى الجزء الرئيسيّ

200
00:14:55,700 --> 00:14:56,620
مستعدّ؟

201
00:15:05,090 --> 00:15:07,130
كلّهم أرواح ثعلب إذاً؟

202
00:15:07,130 --> 00:15:08,600
...عددها كبير

203
00:15:08,600 --> 00:15:10,330
ما كانت تلك الريح؟

204
00:15:10,330 --> 00:15:11,300
!هيداكا

205
00:15:11,620 --> 00:15:15,560
احتجزتمونا في هذا الضريح
ولم تبجّلونا أبداً

206
00:15:15,560 --> 00:15:16,790
لن نغفر لكم

207
00:15:16,790 --> 00:15:17,790
!يا أرواح الثعلب

208
00:15:17,790 --> 00:15:19,650
!استمعي لنا رجاءً

209
00:15:19,650 --> 00:15:20,560
موموتشي؟

210
00:15:20,560 --> 00:15:22,660
من أنتِ؟

211
00:15:22,660 --> 00:15:24,390
أنا موموتشي هيماري

212
00:15:24,390 --> 00:15:27,520
موموتشي؟ من عائلة موموتشي؟

213
00:15:27,520 --> 00:15:29,430
أعتذر على كلّ شيء

214
00:15:29,430 --> 00:15:33,110
على احتجازكم هنا وترككم
خلال كلّ تلك الأعوام

215
00:15:34,560 --> 00:15:35,790
صحيح

216
00:15:35,790 --> 00:15:39,330
...توقّفت عائلة هيداكا عن الكلام معنا فجأةً

217
00:15:39,330 --> 00:15:40,420
لمَ؟

218
00:15:40,870 --> 00:15:42,080
...ذلك

219
00:15:42,890 --> 00:15:48,400
لم يعد هناك أحدٌ في العائلة
قادر على رؤيتكم

220
00:15:48,400 --> 00:15:51,450
!لذا... تعالوا معي

221
00:15:52,040 --> 00:15:55,200
يوجد آخرون مثلكم في منزلي

222
00:15:55,200 --> 00:15:56,970
لا بدّ أنّكم ستستمتعون بوقتكم هناك

223
00:15:56,970 --> 00:16:01,530
لم يعد بمقدور آل هيداكا رؤيتنا؟

224
00:16:03,210 --> 00:16:06,840
وأنتِ... الوحيدة المتبقيّة
القادرة على ذلك؟

225
00:16:06,840 --> 00:16:07,740
أجل

226
00:16:11,040 --> 00:16:14,600
حسناً، سنرافقكِ

227
00:16:14,600 --> 00:16:15,530
!رائع

228
00:16:15,530 --> 00:16:16,990
...لكن أخونا الأكبر

229
00:16:17,220 --> 00:16:19,210
!أخوكم؟ ذاك الفتى

230
00:16:19,470 --> 00:16:22,240
لن أقبل بهذا يا ابن هيداكا

231
00:16:22,760 --> 00:16:25,050
لم يعد بمقدورك رؤيتي؟

232
00:16:25,050 --> 00:16:27,470
سألتهم فتاة موموتشي إذاً
!وأصبح أياكاشي عظيماً

233
00:16:27,470 --> 00:16:31,160
!سأريك عظم قوّتي

234
00:16:34,030 --> 00:16:35,750
!كلّا يا أخي

235
00:16:36,070 --> 00:16:37,720
...أنتم! ما الذي

236
00:16:37,720 --> 00:16:41,510
هذه الفتاة هي الوحيدة التي
يمكننا الاعتماد عليها

237
00:16:41,510 --> 00:16:42,190
—لذا

238
00:16:42,190 --> 00:16:43,850
!لا تتدخلّوا

239
00:16:47,250 --> 00:16:49,070
!اهربي يا ابنة موموتشي

240
00:16:49,070 --> 00:16:50,140
...لكن

241
00:16:50,570 --> 00:16:52,160
!لا يمكننا كبحه طويلاً! اذهبي

242
00:16:52,160 --> 00:16:53,850
!فهمت، هيّا بنا

243
00:16:53,850 --> 00:16:55,290
أ-أجل

244
00:16:56,360 --> 00:16:57,410
!لن تفلت

245
00:16:57,410 --> 00:17:00,830
!لن تفلت أبداً يا ابن هيداكا

246
00:17:02,420 --> 00:17:03,640
!نكاد نصل

247
00:17:03,640 --> 00:17:04,290
!أجل

248
00:17:04,290 --> 00:17:09,820
قال ذاك الفتى أنّه سيلتهمني
ليريك عظم قوّته

249
00:17:10,250 --> 00:17:15,390
لا بدّ أنّه يخال أنّي سأجعلك
تدرك وجوده أخيراً

250
00:17:16,710 --> 00:17:19,610
...إنّه يستهدفني بشكلٍ رئيسيّ، لذا

251
00:17:19,610 --> 00:17:22,400
لا داعي لتأتي، هذا خطر جدّاً

252
00:17:22,400 --> 00:17:24,000
كانت مشكلتي بالأصل

253
00:17:24,000 --> 00:17:26,510
لن أدعكِ تحملين العبء بمفردكِ

254
00:17:26,510 --> 00:17:27,440
...كما

255
00:17:27,900 --> 00:17:30,810
!لا أودّ فقدان صديقٍ آخر

256
00:17:30,810 --> 00:17:32,350
...هيداكا-كن

257
00:17:32,350 --> 00:17:33,720
!وجدتكما

258
00:17:35,730 --> 00:17:37,690
!روح الثعلب هنا، صحيح؟

259
00:17:37,990 --> 00:17:39,950
...ابنة موموتشي وهيداكا

260
00:17:39,950 --> 00:17:41,450
!لن تفلتا

261
00:17:41,450 --> 00:17:42,590
!أسرع

262
00:17:43,400 --> 00:17:46,600
!سألتهمكِ وأكتسب القوّة

263
00:17:46,600 --> 00:17:48,380
...عندها هيداكا

264
00:17:49,070 --> 00:17:52,170
!أرجوك! دع هيداكا-كن يذهب

265
00:17:52,170 --> 00:17:54,200
!لا يمكنه أن يكون معك بعد الآن

266
00:17:54,200 --> 00:17:56,280
!اصمتي! اصمتي

267
00:17:56,280 --> 00:17:58,470
!ما الذي تعرفينه؟

268
00:18:05,170 --> 00:18:08,000
دخلت نطاقي المُقدّس

269
00:18:09,640 --> 00:18:11,980
هذا... روح الثعلب

270
00:18:11,980 --> 00:18:13,800
بإمكانك رؤيته يا هيداكا-كن؟

271
00:18:13,800 --> 00:18:14,530
أجل

272
00:18:14,530 --> 00:18:17,210
...فهمت، لأنّنا داخل محيط منزل موموتشي

273
00:18:17,210 --> 00:18:19,150
...يا-يا هذا

274
00:18:19,150 --> 00:18:20,550
يا هذا"؟"

275
00:18:20,550 --> 00:18:23,160
ليس هكذا تخاطب سيّد منزل موموتشي

276
00:18:23,890 --> 00:18:25,320
فلتتعلّم الأدب

277
00:18:28,870 --> 00:18:29,820
...إنّه

278
00:18:31,230 --> 00:18:32,340
!آوي؟

279
00:18:33,840 --> 00:18:35,070
...لم أنتهِ بعد

280
00:18:35,070 --> 00:18:37,910
...لا-لا يزال بإمكاني أن أري هيداكا

281
00:18:37,910 --> 00:18:41,630
تتحلّى بالجرأة أيّها الثعلب الصغير

282
00:18:41,960 --> 00:18:43,850
—هدّئ من انفعالك و

283
00:18:44,460 --> 00:18:45,530
!انتظر

284
00:18:46,710 --> 00:18:49,730
!أرجوك، دعني أتكلّم معه

285
00:18:53,500 --> 00:18:55,560
أنا آسفٌ يا روح الثعلب

286
00:18:55,560 --> 00:18:57,760
على دعم رؤيتك خلال كلّ تلك الأعوام

287
00:18:57,760 --> 00:18:59,400
...هـ-هيداكا

288
00:18:59,650 --> 00:19:03,220
...في ذاك اليوم، حقّقت لي أمنيتي

289
00:19:03,610 --> 00:19:08,490
كان ذلك لمساعدتي في الشعور بوجودك، صحيح؟

290
00:19:11,290 --> 00:19:15,760
أعتقد أنّي أفهم شعورك، ولو بعض الشيء

291
00:19:16,150 --> 00:19:20,410
أردت أن تريني حاجتي لك، أليس كذلك؟

292
00:19:20,980 --> 00:19:23,420
وأنّك لم ترد تركي

293
00:19:23,700 --> 00:19:25,210
أنا آسفٌ حقّاً

294
00:19:27,130 --> 00:19:31,770
لم تجب عليّ مهما ناديت عليك

295
00:19:32,210 --> 00:19:36,730
شعرت بالوحدة، لذا ظننت أنّي بحاجة للمزيد من القوّة

296
00:19:36,940 --> 00:19:37,710
أجل

297
00:19:37,710 --> 00:19:39,340
...لكن لا بأس الآن

298
00:19:39,340 --> 00:19:41,450
كنت أعرف سلفاً في أعماقي

299
00:19:41,450 --> 00:19:43,440
أنّ عليّ التوقّف

300
00:19:43,740 --> 00:19:45,330
أنا آسفٌ أيضاً

301
00:19:45,330 --> 00:19:48,360
سأعيد لك الشيء الغالي لديك

302
00:19:54,530 --> 00:19:55,930
...صحيح

303
00:19:55,930 --> 00:19:59,470
كان اسم صديقي هو آوي

304
00:20:00,130 --> 00:20:01,770
ما-ما هذا؟

305
00:20:01,770 --> 00:20:03,610
كان ذلك محض أثر

306
00:20:03,610 --> 00:20:04,590
ماذا؟

307
00:20:05,290 --> 00:20:10,040
لم يأخذ روح الثعلب صديقك
كمقابل لتحقيق أمنيتك قطّ

308
00:20:10,440 --> 00:20:12,310
بل أخذ أثر ما تبقّى وحسب

309
00:20:12,670 --> 00:20:17,600
لا يمتلك ثعلبٌ صغير القوّة على خطف
الناس ومحي ذكرياتهم بالأصل

310
00:20:18,190 --> 00:20:21,520
اختفاء صديقك ليس غلطتك أنت

311
00:20:21,520 --> 00:20:23,720
أين ذهب آوي إذاً؟

312
00:20:24,420 --> 00:20:26,640
لم يعد في العالم البشريّ

313
00:20:30,310 --> 00:20:34,220
سأذهب إلى حيث هو إذاً

314
00:20:35,080 --> 00:20:39,380
لا أريد العيش مع عبء ما فقدتُه بعد الآن

315
00:20:40,000 --> 00:20:41,460
أرجوك، أنا أتوسّل إليك

316
00:20:42,440 --> 00:20:44,920
خذني إلى حيث هو

317
00:20:50,830 --> 00:20:53,320
أخشى أنّ ذلك غير ممكن

318
00:20:57,570 --> 00:20:58,850
!هيداكا-كن

319
00:20:59,630 --> 00:21:01,360
نوّمته وحسب

320
00:21:02,530 --> 00:21:05,280
هل سيكون هيداكا-كن بخير؟

321
00:21:05,890 --> 00:21:07,580
سيكون بخيرٍ الآن

322
00:21:09,300 --> 00:21:12,820
كبرت من الخارج حقّاً

323
00:21:14,200 --> 00:21:15,180
يا هاياتو

324
00:21:21,130 --> 00:21:22,750
!صباح الخير يا هيداكا-كن

325
00:21:23,160 --> 00:21:25,160
صباح الخير يا موموتشي

326
00:21:25,160 --> 00:21:27,110
أخبرني، أأنت بخير؟

327
00:21:27,110 --> 00:21:28,470
أجل، تحسّنت كليّاً

328
00:21:28,470 --> 00:21:30,610
فهمت، يسرّني سماع ذلك

329
00:21:31,850 --> 00:21:34,650
أعنتِني كثيراً مع روح الثعلب

330
00:21:34,650 --> 00:21:35,730
شكراً لكِ

331
00:21:35,730 --> 00:21:40,520
ليس عليك القلق حيال اللعنة أو آوي الآن

332
00:21:40,520 --> 00:21:42,980
ماذا؟ من آوي؟

333
00:21:45,160 --> 00:21:46,870
سيكون بخيرٍ الآن

334
00:21:48,380 --> 00:21:51,850
ستستطيع نسيان كلّ شيء
هذه المرّة بالتأكيد

335
00:21:57,110 --> 00:21:59,960
موموتشي؟ أأنتِ بخير؟

336
00:21:59,960 --> 00:22:02,250
!أجل، أنا بخير

337
00:22:03,560 --> 00:22:07,040
فهمت شعور هيداكا-كن وآوي

338
00:22:07,590 --> 00:22:10,620
...أعرف أنّ هذا مصيراً لا مناص منه

339
00:22:11,140 --> 00:22:14,680
لكن أأنت راضٍ بهذا حقّاً يا آوي؟

340
00:23:54,990 --> 00:23:59,990
الحلقة القادمة

341
00:23:54,990 --> 00:23:59,990
الحلقة السادسة

342
00:23:54,990 --> 00:23:59,990
الأوقات العابرة