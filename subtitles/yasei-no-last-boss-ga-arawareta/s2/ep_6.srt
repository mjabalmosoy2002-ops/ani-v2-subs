1
00:00:03,090 --> 00:00:04,900
...والآن، بخصوص الغد

2
00:00:04,900 --> 00:00:07,940
بما أنَّ إمبراطور دراوبنير
...استدعى فيرغو

3
00:00:07,940 --> 00:00:10,040
.قرّرنا إرسالها إلى هناك

4
00:00:10,930 --> 00:00:12,670
سنجعل ليبرا والبقية يتفرّقون

5
00:00:12,670 --> 00:00:15,090
.للبحث عن ساجيتاريوس الرامي

6
00:00:15,090 --> 00:00:16,910
!سنبحث عنه ونقبض عليه

7
00:00:16,910 --> 00:00:18,560
.مفهوم

8
00:00:19,300 --> 00:00:20,620
،وأنت يا أرييس

9
00:00:21,000 --> 00:00:23,340
.نودّ أن تتولى مسألة أخرى

10
00:02:15,970 --> 00:02:17,980
،أنتم جميعًا من تصدّرتُم مهرجان الصيد

11
00:02:17,980 --> 00:02:21,580
.نشكركم على تلبية استدعاء إمبراطورنا

12
00:02:22,060 --> 00:02:26,250
.أنا بيتو، كبير محاربي دراوبنير

13
00:02:27,360 --> 00:02:29,250
.أنا قط

14
00:02:30,830 --> 00:02:33,010
.هذا واضح

15
00:02:36,090 --> 00:02:37,440
!هل أنا الوحيد؟

16
00:02:37,440 --> 00:02:40,430
!هل أنا الوحيد الذي يرى هذا مضحكًا؟

17
00:02:40,680 --> 00:02:43,360
استدعيناكم جميعًا إلى هنا اليوم

18
00:02:44,610 --> 00:02:48,120
.لأنّ مملكتنا بحاجة إلى مساعدتكم

19
00:02:49,360 --> 00:02:51,260
ليس من المبالغة القول
أنَّ أحد أهداف

20
00:02:51,260 --> 00:02:54,710
مهرجان الصيد لهذه السنة
.كان اكتشاف محاربين شجعان

21
00:02:55,280 --> 00:02:56,320
!ماذا؟

22
00:02:56,650 --> 00:03:00,530
.هذا طلب رسمي من دراوبنير

23
00:03:00,530 --> 00:03:05,140
نريد منكم جميعًا إحضار الغرض
.الذي نبتغيه من مكان مُحدّد

24
00:03:06,270 --> 00:03:07,460
لماذا؟

25
00:03:07,890 --> 00:03:10,170
ما الذي تريدون منّا إحضاره؟

26
00:03:10,170 --> 00:03:15,230
نريد منكم تسلّق قمّة
،جبل هنيتيبيورغ المقدس

27
00:03:16,130 --> 00:03:18,640
.واسترجاع الإكسير المحفوظ هناك

28
00:03:19,890 --> 00:03:21,390
!الإكسير؟

29
00:03:21,390 --> 00:03:23,310
!كفّ عن المزاح

30
00:03:23,310 --> 00:03:26,850
إنّه العقار الأعجوبة الأسطوري الذي
فُقد قبل قرنين

31
00:03:26,850 --> 00:03:28,690
!بسبب ملك الشياطين

32
00:03:28,690 --> 00:03:30,710
!هذا شائع جدًا في الألعاب وما شابهها

33
00:03:32,790 --> 00:03:35,780
.لا يزال العقار الأعجوبة موجودًا

34
00:03:36,000 --> 00:03:37,600
،سلفنا العظيم

35
00:03:37,600 --> 00:03:39,040
،ملك الوحوش دوبهي

36
00:03:39,040 --> 00:03:42,740
أودع بعضًا من ذلك العقار
.الأعجوبة في هنيتيبيورغ

37
00:03:43,410 --> 00:03:46,710
لِم تحتاجون إلى هذا الإكسير؟

38
00:03:48,750 --> 00:03:49,670
...في الحقيقة

39
00:03:50,550 --> 00:03:54,290
التنين الحارس الذي يُعدّ
الركيزة الأساسية لدفاع بلادنا

40
00:03:54,290 --> 00:03:57,310
.أُصيب بمرض خطير فجأة

41
00:03:58,470 --> 00:04:02,720
إن لم نفعل شيئًا، فقد تقع
.بلادنا تحت سيطرة الشياطين

42
00:04:02,720 --> 00:04:06,590
.نحتاجُ إلى الإكسير لمنع ذلك

43
00:04:07,510 --> 00:04:09,250
،إن أتممتم هذه المهمة

44
00:04:09,250 --> 00:04:11,210
،وأحضرتم الإكسير

45
00:04:11,520 --> 00:04:13,940
!سنكافئكم بمبلغ مليون إل

46
00:04:15,100 --> 00:04:16,210
...عفوًا

47
00:04:16,210 --> 00:04:17,450
!علاوة على ذلك

48
00:04:18,120 --> 00:04:23,250
نعدكم بمنحكم جزءًا صغيرًا
.من الإكسير أيضًا

49
00:04:23,250 --> 00:04:25,310
!مرحى

50
00:04:25,830 --> 00:04:28,190
.عفوًا، لديّ سؤال

51
00:04:28,190 --> 00:04:32,080
هل يستطيع هذا الإكسير شفاء
ساقين فقدتا القدرة على الحركة؟

52
00:04:32,300 --> 00:04:33,520
.نعم يستطيع

53
00:04:33,520 --> 00:04:37,550
حتّى كمية ضئيلة منه
.تكفي لعلاج الشلل بسهولة

54
00:04:43,920 --> 00:04:46,910
إن كان سيُخوّل لي شفاء
،أحد الأبطال السبعة

55
00:04:46,910 --> 00:04:49,440
.فالأمر يستحق المخاطرة

56
00:04:50,640 --> 00:04:52,080
!سمعتُ كلامك

57
00:04:53,080 --> 00:04:54,540
.يا لها من مفاجأة

58
00:04:54,540 --> 00:04:57,830
.لا أصدّق أنّ بعض الإكسير لا يزال موجودًا

59
00:04:57,830 --> 00:04:59,810
...شيء كهذا

60
00:05:00,170 --> 00:05:03,280
سيكون قادرًا على شفاء
.جراح الأبطال السبعة

61
00:05:07,570 --> 00:05:09,140
!فرد من الشياطين؟

62
00:05:13,580 --> 00:05:15,090
.لا تأثير

63
00:05:18,370 --> 00:05:19,480
!بيتو-سان

64
00:05:20,470 --> 00:05:22,960
!سأقضي عليكم جميعًا هنا

65
00:05:22,960 --> 00:05:24,470
.أبساراس

66
00:05:49,080 --> 00:05:51,210
،لا أعرف من تكونين

67
00:05:51,210 --> 00:05:54,170
لكن يبدو أنّ بينكم
.خصمًا لا يُستهان به

68
00:05:54,860 --> 00:05:58,130
.لستُ أحمق يجهل حدود قدراته

69
00:05:58,130 --> 00:06:00,800
.سأغادر الآن

70
00:06:05,500 --> 00:06:06,790
هل انسحب؟

71
00:06:12,940 --> 00:06:16,830
جسد سائل لا تؤثّر فيه
...الهجمات الجسدية

72
00:06:16,830 --> 00:06:19,690
...وتلك البراعة في سحر الماء

73
00:06:19,990 --> 00:06:22,190
أكان ذلك أحد الأنوار السبعة؟

74
00:06:22,190 --> 00:06:25,160
ميركوريوس، الماء؟

75
00:06:25,160 --> 00:06:27,390
!أ-أحد الأنوار السبعة؟

76
00:06:27,390 --> 00:06:28,570
!أنت تمزح، صحيح؟

77
00:06:28,570 --> 00:06:30,000
!سأكفّ عن التأنق

78
00:06:30,000 --> 00:06:33,070
!هذه ليست مهمة يصحّ تكليف مغامر بها

79
00:06:33,070 --> 00:06:35,370
!دعوا جنود بلادكم يتولّون الأمر

80
00:06:35,870 --> 00:06:37,690
.هذا سيئ

81
00:06:37,690 --> 00:06:39,110
ماذا أفعل؟

82
00:06:39,540 --> 00:06:42,350
.لكن كلامهم منطقي

83
00:06:42,350 --> 00:06:46,590
أعتقد أيضًا أنَّ إرسال جنودكم
.أفضل من الاستعانة بمغامرين

84
00:06:46,930 --> 00:06:50,150
.كنّا سنرسلهم لو استطعنا

85
00:06:50,150 --> 00:06:52,810
نحن نجنّد مغامرين
.لأنّنا لا نستطيع إرسال جنودنا

86
00:06:53,190 --> 00:06:54,240
لا يمكنكم؟

87
00:06:54,640 --> 00:06:56,020
ما السبب؟

88
00:06:56,270 --> 00:06:58,980
.جبل هنيتيبيورغ المقدس أرض مُعظَّمة

89
00:06:59,430 --> 00:07:03,230
.لذا يحميه حاجز مقدس يصدّ الوحوش

90
00:07:03,230 --> 00:07:07,480
لكنّ ذلك الحاجز يؤثر فينا
.نحن قوم الوحوش

91
00:07:07,950 --> 00:07:10,700
.وكذلك في قوم الشياطين

92
00:07:11,480 --> 00:07:14,660
.لذا لا يستطيعون دخوله بسهولة أيضًا

93
00:07:14,660 --> 00:07:18,420
إذًا لن يُسرَق الإكسير قريبًا، صحيح؟

94
00:07:19,930 --> 00:07:22,190
،لكن بعد أن علموا بوجوده

95
00:07:22,190 --> 00:07:24,880
.سيدبّرون وسيلة ما لسرقته

96
00:07:28,340 --> 00:07:30,270
.انتظر لحظة رجاء

97
00:07:31,060 --> 00:07:32,960
.سأستدعي حلفائي أيضًا

98
00:07:33,810 --> 00:07:35,650
.البلاد في مأزق

99
00:07:35,650 --> 00:07:38,560
!سنساعدكم إن قبلتم مشاركتنا

100
00:07:38,560 --> 00:07:41,020
!كم هذا مطمئن

101
00:07:41,900 --> 00:07:43,780
!إنّه أنت يا فريد

102
00:07:43,780 --> 00:07:45,320
!أتيتَ

103
00:07:46,900 --> 00:07:48,740
!لم أرك منذ زمن طويل

104
00:07:48,740 --> 00:07:51,920
!سمعنا أيضًا عن إنجازاتك

105
00:07:52,720 --> 00:07:54,640
!نعم، أنا بخير طبعًا

106
00:07:54,640 --> 00:07:57,110
.ينبغي أن تزورها مجددًا أيضًا

107
00:07:59,440 --> 00:08:02,720
إن كنتَ قلقًا لهذه الدرجة
.فاعترف لها بمشاعرك بالفعل

108
00:08:02,720 --> 00:08:04,670
.لا تتركها تنتظر إلى الأبد

109
00:08:05,070 --> 00:08:09,160
هل يمكنك أن تترجمي لنا حتّى
نفهم أيضًا يا نائبة القائد؟

110
00:08:06,880 --> 00:08:09,160
!ما زلتَ خجولًا كما عهدتك

111
00:08:09,160 --> 00:08:13,430
يبدو أنَّ ذلك القط من قوم الوحوش
.هو الأخ الأكبر للقائد

112
00:08:13,430 --> 00:08:14,690
!إنّهما أخوان؟

113
00:08:14,690 --> 00:08:18,390
يبدو أنَّ لديهما الكثير
.ليتحدثا عنه بعد لقائهما مجددًا

114
00:08:18,930 --> 00:08:20,240
!كن أكثر وضوحًا

115
00:08:18,930 --> 00:08:23,460
أيّ والدين يمكن أن ينجبا
شقيقين كهذين؟

116
00:08:21,070 --> 00:08:22,630
.هذا جيّد

117
00:08:25,490 --> 00:08:28,190
.سمعتُ التفاصيل من أخي الأصغر

118
00:08:28,190 --> 00:08:30,950
.لم أدرك أنّك البطل يا سيّد سِي

119
00:08:31,250 --> 00:08:34,270
.يسعدنا أن ينضم البطل ورفاقه لمساعدتنا

120
00:08:34,270 --> 00:08:35,160
!بالطّبع

121
00:08:35,160 --> 00:08:38,010
!عفوًا، اسمحوا لي بمرافقتكم أيضًا

122
00:08:38,010 --> 00:08:41,010
ألا بأس... إن انضممتُ إليكم أيضًا؟

123
00:08:41,010 --> 00:08:42,480
.نحن ممتنون

124
00:08:42,480 --> 00:08:46,090
والآن، دعوني أرشدكم إلى
.جبل هنيتيبيورغ المقدس

125
00:08:46,090 --> 00:08:49,030
!اتبعوني يا أبطال

126
00:08:53,260 --> 00:08:56,680
هل أنت متأكدة من وجود
ساجيتاريوس هنا يا ليبرا؟

127
00:08:56,680 --> 00:08:58,230
.أنا مُتأكدة

128
00:08:58,610 --> 00:09:02,430
ترك ساجيتاريوس أثره
.في أرجاء هذه المنطقة

129
00:09:02,980 --> 00:09:04,980
.يبدو أنَّ ذلك كان مقصودًا

130
00:09:08,870 --> 00:09:11,510
.يبدو أنَّه ترك لي دربًا يقودني إليه

131
00:09:13,200 --> 00:09:14,160
.وجدته

132
00:09:27,410 --> 00:09:29,030
.أتيتِ يا ليبرا

133
00:09:33,570 --> 00:09:34,630
...أنت

134
00:09:34,630 --> 00:09:37,910
أنت معلّق مهرجان الصيد، صحيح؟

135
00:09:38,830 --> 00:09:40,420
ماذا تفعل هنا؟

136
00:09:40,420 --> 00:09:42,020
.هذا أمر غير مسبوق

137
00:09:42,020 --> 00:09:45,660
،فأنت نادرًا ما تكشف نفسك للآخرين

138
00:09:45,660 --> 00:09:47,770
...لذا فإنّ إظهار وجهك الآن يعني

139
00:09:49,250 --> 00:09:51,050
.لا تكفّين عن إبهاري

140
00:09:51,050 --> 00:09:54,240
.لا تنطلي عليكِ الأوهام

141
00:10:01,350 --> 00:10:02,950
.ساجيتاريوس

142
00:10:05,850 --> 00:10:09,360
.لا أحتمل مقابلة السيّدة لوفاس حاليًا

143
00:10:09,360 --> 00:10:11,340
.ولهذا استدعيتُك

144
00:10:11,340 --> 00:10:12,600
،وفقًا لكلامك

145
00:10:12,600 --> 00:10:16,300
أستنتج أنّك أقدمتَ على أمر
.لا يصب في مصلحة سيّدتنا لوفاس

146
00:10:16,300 --> 00:10:17,400
.لا بأس

147
00:10:17,400 --> 00:10:21,270
.لكنّني أودّ منك أن تسمعي قصّتي أوّلًا

148
00:10:27,370 --> 00:10:29,400
ماذا عنّي؟

149
00:10:29,400 --> 00:10:33,470
.أنا أعمل حاليًا مع ليون

150
00:10:33,470 --> 00:10:36,870
ليون الأسد، أحد النجوم
.السماوية الاثني عشر

151
00:10:37,340 --> 00:10:39,580
أتقصد ذلك المتمرّد؟

152
00:10:41,540 --> 00:10:45,170
لم يتبع ذلك الرّجل سيّدتنا لوفاس
،يومًا بدافع ولاء حقيقي

153
00:10:45,170 --> 00:10:49,600
بل ظلّ يترقّب الفرصة
.المناسبة للاستيلاء على عرشها

154
00:10:49,600 --> 00:10:52,410
ثار ذلك الخائن

155
00:10:52,410 --> 00:10:55,200
بعدما هُزم أمام سيّدتنا لوفاس
.قبل مئتي سنة

156
00:10:56,460 --> 00:10:58,710
.سأستمع الآن إلى تفسيرك

157
00:10:59,620 --> 00:11:04,690
.أولًا، دعيني أحدثك عن عرقي، القناطير

158
00:11:05,080 --> 00:11:08,080
لا يكادُ يوجد فرق بين
.قوم الوحوش والوحوش

159
00:11:08,080 --> 00:11:11,950
،لهذا عُومل أبناء عرقي
.القناطير، على أنّهم وحوش

160
00:11:11,950 --> 00:11:13,750
هل تعرفين السبب؟

161
00:11:14,620 --> 00:11:17,200
.لأنّكم لا تمشون على قدمين

162
00:11:17,600 --> 00:11:20,200
في هذا العالم، يستند تعريف البشرية

163
00:11:20,200 --> 00:11:22,080
.في جوهره على الهيئة البشرية

164
00:11:22,080 --> 00:11:24,800
الأجناس التي تتميّز ببعض
الإضافات البسيطة كالأجنحة

165
00:11:24,800 --> 00:11:26,750
،التي لا تبتعد كثيرًا عن الهيئة البشرية

166
00:11:26,750 --> 00:11:30,630
،وتثبت قدرتها على التعايش
.تُعدّ من البشر

167
00:11:30,630 --> 00:11:31,940
.هذا صحيح

168
00:11:31,940 --> 00:11:33,450
،لهذا السبب وحده

169
00:11:33,450 --> 00:11:37,340
.صُنّف قومنا وحوشًا، وعوملنا بعدائية

170
00:11:38,210 --> 00:11:42,060
رغم أنَّنا قادرون على التعايش
.مع البشر بخلاف الأورك

171
00:11:44,550 --> 00:11:48,880
.لكن ليون سيغيّر هذا العالم

172
00:11:51,450 --> 00:11:56,070
نحن أشباه البشر الذين صُنّفنا وحوشًا

173
00:11:56,070 --> 00:11:58,610
.مثل القناطير، انضممنا لصفوف ليون

174
00:11:58,610 --> 00:12:00,600
،ما إن يسيطر على العالم

175
00:12:00,600 --> 00:12:03,050
.ستنال الوحوش مزيدًا من الحقوق

176
00:12:03,050 --> 00:12:04,300
والآن بعدما أطلق جموحه

177
00:12:04,300 --> 00:12:08,410
،وعاد إلى المستوى 1000
!صار قادرًا على تحقيق هذا الهدف

178
00:12:08,410 --> 00:12:11,490
.لا، لا يصلح ليون ليكون ملكًا

179
00:12:12,270 --> 00:12:14,300
ذلك الرجل لا يختلف عن وحش

180
00:12:14,300 --> 00:12:17,180
.يعيش وفق غرائزه ورغباته فقط

181
00:12:17,180 --> 00:12:20,260
العالم الذي سينشئه ليس
.العالم الذي تتمناه سيّدتنا لوفاس

182
00:12:20,260 --> 00:12:23,440
هل فقدتَ القدرة
على فهم هذا أيضًا؟

183
00:12:24,220 --> 00:12:26,240
.لهذا أحذّرك الآن

184
00:12:26,240 --> 00:12:28,940
،إن عدتَ إلى سيّدتنا الآن
.فسينتهي الأمر على خير

185
00:12:28,940 --> 00:12:31,280
،أمّا إن أصررت على اتباع ليون

186
00:12:31,280 --> 00:12:32,970
فسأعتبرك تهديدًا

187
00:12:33,410 --> 00:12:35,610
.وسأقضي عليك هنا

188
00:12:38,730 --> 00:12:39,900
،أنا آسف

189
00:12:39,900 --> 00:12:42,620
.لكنّني اتخذتُ قراري بالفعل

190
00:12:42,930 --> 00:12:46,990
سأفعل كلّ ما يلزم من
.أجل مستقبل أبناء عرقي

191
00:12:46,990 --> 00:12:48,470
...حتّى لو أدّى خياري هذا

192
00:12:49,390 --> 00:12:52,630
!لمعارضة السيّدة لوفاس

193
00:12:54,430 --> 00:12:55,170
!ماذا؟

194
00:12:56,130 --> 00:12:57,400
.هجومك بلا جدوى

195
00:12:57,400 --> 00:12:58,590
!حاجز كاركينوس

196
00:12:58,590 --> 00:13:01,450
!لا

197
00:13:02,520 --> 00:13:05,970
تأكدتُ من وجود نيّة
.عدائية تجاه سيّدتي

198
00:13:05,970 --> 00:13:08,680
يجري الآن تصنيف ساجيتاريوس كعدو

199
00:13:08,680 --> 00:13:10,190
.وسأشرع في القضاء عليه

200
00:13:13,610 --> 00:13:15,320
!توقفي

201
00:13:21,700 --> 00:13:23,930
.سرعتك مثيرة للإعجاب كالعادة

202
00:13:23,930 --> 00:13:25,160
.كم هذا مزعج

203
00:13:25,160 --> 00:13:27,910
!لا! يا إلهي

204
00:13:27,910 --> 00:13:29,080
!ماء

205
00:13:29,370 --> 00:13:30,290
!النجدة

206
00:13:30,290 --> 00:13:33,000
!لا

207
00:13:36,290 --> 00:13:39,390
ألا يمكنك أن تكوني
أكثر رفقًا بي قليلًا؟

208
00:13:39,390 --> 00:13:42,790
لا تصلح إلّا كدرع
.وأنا أمنحك فرصة للتألق

209
00:13:42,790 --> 00:13:44,140
.تحمّل

210
00:13:56,610 --> 00:14:01,110
النصر"، السهم الذي يخترق"
خصمك حتمًا بمجرّد إطلاقه؟

211
00:14:01,320 --> 00:14:02,590
.صحيح

212
00:14:03,850 --> 00:14:06,780
حتّى أنتِ لن تستطيعي
.تفادي هجومي الآن

213
00:14:06,780 --> 00:14:11,000
،إن كنتُ عاجزة عن تفادي هجومك
.فلا بدّ أن أواجهه بهجوم مماثل وأسقطه

214
00:14:12,830 --> 00:14:15,750
...أستطيع

215
00:14:21,050 --> 00:14:24,720
!تحليق

216
00:14:31,640 --> 00:14:33,340
!زوبيل الجنوبي

217
00:14:31,640 --> 00:14:33,340
!النصر

218
00:14:45,480 --> 00:14:46,810
ماذا حدث؟

219
00:14:47,610 --> 00:14:49,900
.اختفى ساجيتاريوس

220
00:14:49,900 --> 00:14:50,700
!ماذا؟

221
00:14:50,700 --> 00:14:52,570
...مسح المنطقة المحيطة

222
00:14:53,200 --> 00:14:54,040
.لا يوجد هدف

223
00:14:54,390 --> 00:14:56,910
.إعادة عرض التسجيل قبل عدّة ثوان

224
00:14:59,080 --> 00:15:00,250
.إيقاف مؤقت

225
00:15:00,600 --> 00:15:02,130
،مباشرة بعد الإطلاق

226
00:15:02,130 --> 00:15:04,380
.أمسك بالسهم الذي أطلقه

227
00:15:05,880 --> 00:15:09,680
يُرجّح أنّه اختار مكانًا بعيدًا
،في الأفق ليكون هدفًا له

228
00:15:09,680 --> 00:15:11,660
ثمّ قفز إلى هدف هجومه

229
00:15:11,660 --> 00:15:13,220
.ومعه السهم ذاته

230
00:15:14,480 --> 00:15:17,340
هذه الطريقة في استخدام
.السهام ليست في سجلاتي

231
00:15:17,340 --> 00:15:20,190
بهذه الحيلة، سيستحيل
.عليّ رصده أيضًا

232
00:15:20,600 --> 00:15:22,520
.أوقع بنا إذًا

233
00:15:33,790 --> 00:15:36,000
!مـ-مذهل

234
00:15:36,310 --> 00:15:38,560
!كلّ هذه بلورات مانا

235
00:15:38,970 --> 00:15:40,530
المانا التي حبسها الحاجز هنا

236
00:15:40,530 --> 00:15:42,200
تكتّفت وتحوّلت إلى بلورات مانا صلبة

237
00:15:42,200 --> 00:15:43,960
!وهناك أعداد هائلة منها

238
00:15:43,960 --> 00:15:47,750
هل لديكم أدنى فكرة عن
قيمة البلورات الموجودة هنا وحدها؟

239
00:15:48,180 --> 00:15:52,140
.عفوًا، لديّ تساؤل

240
00:15:52,140 --> 00:15:55,070
،قيل أنّ هذا الحاجز يصدّ الوحوش

241
00:15:55,070 --> 00:15:58,470
لذا فهل تلك الغوريلا من
قوم الوحوش بخير؟

242
00:15:59,600 --> 00:16:01,380
!لا يمكنك قول هذا

243
00:16:01,380 --> 00:16:03,600
!إنّها بشرية وليست من قوم الوحوش

244
00:16:03,600 --> 00:16:04,610
!بشرية

245
00:16:04,610 --> 00:16:07,570
...أعلم أنّها تشبه الغوريلا قليلًا

246
00:16:18,720 --> 00:16:21,290
هل يسمع أحدكم
هذا الصوت الغريب؟

247
00:16:29,270 --> 00:16:31,760
!اقتربوا منّي جميعًا

248
00:16:36,390 --> 00:16:38,100
!ما هذا؟

249
00:16:38,100 --> 00:16:41,210
!لم تتكوّن هذه المياه بصورة طبيعية

250
00:16:41,210 --> 00:16:44,380
!إنّها تعويذة ماء أطلقها أحدهم علينا

251
00:16:44,380 --> 00:16:49,160
يبدو أنَّ ذلك الشيطان
!قد اخترق الحاجز بالفعل

252
00:16:58,000 --> 00:16:59,930
!هذا سيئ

253
00:17:00,930 --> 00:17:02,040
!كروس-سان

254
00:17:06,370 --> 00:17:08,260
!فينديمياتريكس

255
00:17:13,900 --> 00:17:15,350
!هذا لا يصدّق

256
00:17:15,350 --> 00:17:17,230
...كلّ تلك المياه

257
00:17:17,230 --> 00:17:18,390
...اختفت

258
00:17:18,390 --> 00:17:19,850
!في لحظة

259
00:17:22,070 --> 00:17:25,980
يسعدني أنَّ تقنية الدّفاع عن النفس
.التي تعلّمتها من جدّتي أثبتت فائدتها

260
00:17:26,570 --> 00:17:28,530
!مـ-مستحيل

261
00:17:28,930 --> 00:17:31,490
!كان هذا إلغاء مانا بلا شك

262
00:17:31,490 --> 00:17:34,980
هذه قوّة تخوّل فرض السلطة
على هذا العالم ولا تملكها سوى الربة

263
00:17:34,980 --> 00:17:36,950
!ومن تمنحهم موافقتها لاستخدامها

264
00:17:36,950 --> 00:17:40,410
!من تكونين بالضبط يا فيرغو؟

265
00:17:40,840 --> 00:17:41,870
من أكون؟

266
00:17:41,870 --> 00:17:46,460
أنا مُجرد مجنّحة سماوية عادية
.كانت تعيش في الغابة حتّى وقت قريب

267
00:17:46,460 --> 00:17:47,800
عادية؟

268
00:17:47,800 --> 00:17:49,500
!هذا مستحيل

269
00:17:49,500 --> 00:17:53,470
لا تستطيع مجنّحة سماوية
!عادية محو المانا ذاتها

270
00:17:53,740 --> 00:17:56,200
!حتّى ملك السماء عاجز عن فعل ذلك

271
00:17:56,200 --> 00:17:58,640
!ماذا تفعل يا كروس-سان؟

272
00:17:59,190 --> 00:18:00,760
:علينا أن نتخذ قرارًا

273
00:18:00,760 --> 00:18:04,350
إمّا أن نوقف مَن استخدم ذلك
!السحر فورًا أو نغادر هذا الجبل

274
00:18:04,630 --> 00:18:06,270
.سِي مُحق

275
00:18:06,270 --> 00:18:08,150
،سواءً قرّرنا التقدم أو التراجع

276
00:18:08,150 --> 00:18:10,000
.علينا أن نقرر بسرعة

277
00:18:10,000 --> 00:18:12,310
.أتفق مع غانتز

278
00:18:12,310 --> 00:18:14,510
.لنواصل التقدم

279
00:18:14,510 --> 00:18:17,260
.لا، أرى أنَّ علينا العودة

280
00:18:17,260 --> 00:18:19,880
،في ظلّ الوضع الراهن
،يستطيع العدو إلقاء ما يشاء

281
00:18:19,880 --> 00:18:21,810
.وسنُباد جميعًا

282
00:18:23,830 --> 00:18:26,090
ما رأيك يا سي؟

283
00:18:26,950 --> 00:18:30,240
.تبعناك طيلة رحلتك حتّى وصلنا هنا

284
00:18:30,240 --> 00:18:32,130
.عليك أن تُقرّر بصفتك البطل

285
00:18:41,700 --> 00:18:42,710
!لنواصل التقدّم

286
00:18:50,820 --> 00:18:53,900
من المرجّح أنَّ الشيطان هاجم
دون كشف نفسه

287
00:18:53,900 --> 00:18:56,300
.لأنّه يريد منّا المغادرة

288
00:18:56,800 --> 00:18:58,490
،حتّى لو شقّ طريقه إلى الداخل

289
00:18:58,490 --> 00:19:01,450
فلا بدّ أنَّ الحاجز الذي يصدّ
.المانا لا يزال يؤثر فيه

290
00:19:01,930 --> 00:19:05,420
والدليل على ذلك أنَّ كروس-سان
.استطاع صدّ معظم هجومه

291
00:19:06,270 --> 00:19:09,630
،لو واجهناه خارج الحاجز
.لاخترق دفاعاتنا بسهولة

292
00:19:11,120 --> 00:19:13,800
،لذا نحن من نضغط عليه في الواقع

293
00:19:13,800 --> 00:19:15,800
!وهو من يواجه مأزقًا

294
00:19:17,560 --> 00:19:18,950
!موجة ثانية

295
00:19:18,950 --> 00:19:19,720
!حسنًا

296
00:19:24,140 --> 00:19:26,100
!مستحيل! مستحيل

297
00:19:26,100 --> 00:19:28,070
!مستحيل! مستحيل! مستحيل

298
00:19:26,340 --> 00:19:28,070
!أنت مذهلة يا آنسة

299
00:19:28,070 --> 00:19:31,190
تصادف أشخاصًا أقوياء في
!أماكن لا تخطر ببالك حقًا

300
00:19:31,190 --> 00:19:33,470
...لا، لستُ بتلك القوة

301
00:19:33,470 --> 00:19:35,200
.لا داعي لكلّ هذا التواضع

302
00:19:35,200 --> 00:19:38,660
.نحن أحياء بفضلك

303
00:19:38,950 --> 00:19:41,490
.عليك أن تثقي بنفسك

304
00:19:41,750 --> 00:19:42,950
!قويّة

305
00:19:51,270 --> 00:19:54,290
.نريد منك أن تدعم فيرغو

306
00:19:56,030 --> 00:19:59,760
لمساعدة فيرغو في اكتساب الثقة؟

307
00:20:05,010 --> 00:20:08,860
هذه ليست مهمة يمكن
.تكليف الآخرين بها بكلّ تأكيد

308
00:20:10,400 --> 00:20:12,930
،فجميعهم كانوا أقوياء من البداية

309
00:20:12,930 --> 00:20:15,290
لذا أشك في أنّهم سيفهمون
.ما تشعر به فيرغو

310
00:20:15,910 --> 00:20:17,750
...أمّا أنا

311
00:20:17,750 --> 00:20:20,800
.فأدرك جيدًا وبمرارة ما تشعر به فيرغو الآن

312
00:20:22,470 --> 00:20:25,850
الأمر متروك لك لتقرّر متى
.وكيف ستدعمها

313
00:20:26,190 --> 00:20:29,110
.اعتنِ بها يا أرييس

314
00:20:37,750 --> 00:20:38,950
!انظروا

315
00:20:38,950 --> 00:20:40,830
!إنّها القمة، صحيح؟

316
00:20:42,430 --> 00:20:44,260
!الإكسير موجود هناك؟

317
00:20:44,260 --> 00:20:46,140
!وكذلك الشيطان

318
00:20:47,070 --> 00:20:50,100
أستطيع حسم هذه المسألة بسهولة
،بمواجهة فرد الأنوار السبعة

319
00:20:50,100 --> 00:20:54,070
.لكن ذلك لن يساعد فيرغو على التطور

320
00:20:56,200 --> 00:20:57,380
.لا بأس

321
00:20:58,030 --> 00:21:00,860
!أنت قادرة على تجاوز هذا التحدّي

322
00:21:20,100 --> 00:21:23,220
يبدو أنَّنا نجحنا في
.الوصول إلى هنا سالمين

323
00:21:23,220 --> 00:21:25,030
!لم يبقَ أمامنا سوى هزيمته

324
00:21:33,950 --> 00:21:37,860
سلِّمنا الإكسير يا ميركوريوس
!من الأنوار السبعة

325
00:21:40,270 --> 00:21:42,060
ومن تكونين أنت؟

326
00:21:45,190 --> 00:21:46,280
أنا؟

327
00:21:46,280 --> 00:21:50,050
.أبطلتِ تعويذاتي واستطعتِ الوصول إلى هنا

328
00:21:50,050 --> 00:21:51,770
فمن غيرك قد أخاطب؟

329
00:21:52,350 --> 00:21:55,750
.لكن لا يهم من تكونين

330
00:21:55,750 --> 00:21:59,800
لن أسمح لأيّ شخص قادر على
.استخدام تلك التقنية بالنجاة

331
00:22:02,090 --> 00:22:06,180
!سأستخدم كامل قوّتي للقضاء عليك هنا