...لا، ليست كذلك

54
00:04:52,080 --> 00:04:53,670
هذه البشرة الزرقاء

55
00:04:53,920 --> 00:04:56,580
...وعيناك مقلوبتا السواد والبياض

56
00:04:56,710 --> 00:04:57,960
أأنت من الشياطين؟

57
00:04:58,080 --> 00:04:59,290
.صحيح

58
00:04:59,420 --> 00:05:00,540
.منطقي

59
00:05:00,920 --> 00:05:04,380
.كان قوم الشياطين يتلاعبون بأرييس إذًا

60
00:05:04,880 --> 00:05:07,710
ما معنى هذا يا أرييس؟

61
00:05:07,830 --> 00:05:10,500
ماذا حدث لحقدك تُجاه البشر؟

62
00:05:10,630 --> 00:05:14,290
حسبتُ أنّك ستسقط سفيل
وتثأر لسيّدتك؟

63
00:05:14,750 --> 00:05:15,670
.مارس

64
00:05:15,790 --> 00:05:18,170
،ما زلتُ لا أستطيع مسامحة البشر

65
00:05:18,290 --> 00:05:20,630
.وما زلتُ أبغض الأبطال السبعة حتّى الموت

66
00:05:20,750 --> 00:05:25,210
لكن من سيفرحُ إن حققتُ انتقامي؟

67
00:05:25,960 --> 00:05:28,670
...لن تفرح سيّدتي لوفاس بل أنتم

68
00:05:29,330 --> 00:05:30,630
.يا قوم الشياطين

69
00:05:32,630 --> 00:05:34,880
فذلك لم يكن المثَل الذي
سعت إليه سيّدتي لوفاس

70
00:05:35,000 --> 00:05:36,330
.ولا ما أرادته

71
00:05:37,830 --> 00:05:39,960
!علمتُ ذلك منذ البداية أيضًا

72
00:05:41,080 --> 00:05:42,460
!لذا لن أتردّد بعد الآن

73
00:05:42,580 --> 00:05:44,500
!سأوقفك هنا والآن

74
00:05:46,170 --> 00:05:47,380
حقًا؟

75
00:05:48,630 --> 00:05:50,830
.توقعتُ قدوم هذا اليوم

76
00:05:50,960 --> 00:05:53,380
،كان بوسعك إسقاط سفيل متى شئتَ

77
00:05:53,500 --> 00:05:55,500
.لكنّك ترددتَ وأضعت سنوات

78
00:05:55,630 --> 00:05:58,130
،كنتَ ورقتنا الرابحة ضد ليفيا

79
00:05:58,250 --> 00:06:01,330
.لكنّك أدّيتَ غرضك الآن بالفعل

80
00:06:01,750 --> 00:06:02,830
...مع ذلك

81
00:06:02,960 --> 00:06:07,630
لا تعتقد أنّنا سنتركك حيًا بعد
!أن انقلبتَ علينا نحن الشياطين

82
00:06:07,750 --> 00:06:10,710
!سأقضي عليك بيدي

83
00:06:11,290 --> 00:06:12,170
.أرييس

84
00:06:12,290 --> 00:06:13,630
.اترك هذا لنا

85
00:06:14,170 --> 00:06:15,750
!...لـ-لكن

86
00:06:16,080 --> 00:06:18,880
لم تشفَ من جراحك في
.معركتنا بعد

87
00:06:19,130 --> 00:06:20,500
.تراجع

88
00:06:20,750 --> 00:06:21,790
.نـ-نعم

89
00:06:22,460 --> 00:06:24,420
ومن تكونين إذًا؟

90
00:06:24,540 --> 00:06:27,960
أدهشني أن أرى في هذا
.العالم من بقي بقوّتك

91
00:06:28,080 --> 00:06:30,040
!لكن هذه هي نهايتك

92
00:06:30,170 --> 00:06:33,920
!العني خطأكِ الأبله بقدومكِ إلى هنا

93
00:06:34,040 --> 00:06:36,380
!أبصري وتأمليها

94
00:06:36,500 --> 00:06:39,830
هذه هي تقنية مارس السرية، شيطان
!الجليد والنّار، أحد السبعة الأنوار

95
00:06:39,960 --> 00:06:44,500
سيف الشيطان الوهمي
!جحيم الجليد والنار الفوري

96
00:06:46,830 --> 00:06:49,290
!هذان السيفان تجسيد لي

97
00:06:49,420 --> 00:06:52,750
انظري، أقبض في يدي
!اليمنى سيف الجحيم الناري

98
00:06:52,880 --> 00:06:56,330
انظري، أقبض في يدي
!اليسرى سيف الجليد القارس

99
00:06:56,670 --> 00:07:01,250
كلّ من يواجه مهارتي بهذين
!السيفين يصير رمادًا

100
00:07:05,880 --> 00:07:07,830
معًا، ضربتهما هي العقاب

101
00:07:07,960 --> 00:07:09,920
الجميل المهيب، عقاب
!الحاصد الذي سيقتنص حياتك

102
00:07:10,040 --> 00:07:12,080
أحدهما يسلبك حركتك ويضعف جسدك

103
00:07:12,210 --> 00:07:14,130
!وعند حافة الموت، سترينه

104
00:07:14,250 --> 00:07:16,830
الحاصد الناري الذي يحرق
!كلّ شيء بلا رحمة

105
00:07:16,960 --> 00:07:18,670
!لا حاجة للرثاء رغم ذلك

106
00:07:18,790 --> 00:07:19,920
!فلن يدوم ألمك إلّا لحظة

107
00:07:20,040 --> 00:07:21,000
!هذه رحمتي لك

108
00:07:21,130 --> 00:07:23,710
!بل ستشكرينني في لحظة موتك قائلة

109
00:07:23,830 --> 00:07:26,790
"!شكرًا لأنّك حرّرتني من هذا العذاب"

110
00:07:26,920 --> 00:07:29,250
!اعتبري الموت على يدي أعظم شرف

111
00:07:29,380 --> 00:07:30,920
!والآن، اغرقي في ظلام أبدي

112
00:07:31,040 --> 00:07:33,330
!حان وقت إسدال الستار عليك

113
00:07:33,460 --> 00:07:34,630
.اخرس

114
00:07:41,630 --> 00:07:43,250
!مـ-مستحيل

115
00:07:44,540 --> 00:07:47,580
!جناحان أسودان وشعر أشقر؟

116
00:07:48,000 --> 00:07:49,420
!لا يعقل

117
00:07:52,580 --> 00:07:54,080
.كان ضعيفًا جدًا

118
00:07:54,210 --> 00:07:57,670
أذلك حقًا هو العقل المدبّر
الذي قصده ميغريز؟

119
00:07:57,790 --> 00:07:58,830
!سيّدتي لوفاس

120
00:07:58,960 --> 00:08:00,330
!كان ذلك مذهلًا

121
00:08:00,460 --> 00:08:03,830
يا أرييس، لقد ذكر شيئًا
عن كونه أحد "السبعة الأنوار"؟

122
00:08:03,960 --> 00:08:04,830
.نعم

123
00:08:04,960 --> 00:08:07,880
كان أحد السبعة الأنوار عند
.قوم الشياطين، النّار، مارس

124
00:08:08,000 --> 00:08:10,500
...السبعة الأنوار هُم-
!سأفسّر-

125
00:08:13,460 --> 00:08:14,460
.من فضلك

126
00:08:15,210 --> 00:08:19,710
الأنوار هو اللقب الذي يُمنح
.لسبعة من أعظم قادة الشياطين

127
00:08:19,830 --> 00:08:22,290
!أُسِّسُوا قبل 80 سنة

128
00:08:22,420 --> 00:08:25,380
وهُم حاليًا أقوى وأكفأ الشياطين

129
00:08:25,500 --> 00:08:27,880
.بعد ملك الشياطين وابنه

130
00:08:28,000 --> 00:08:29,460
بهذا المستوى؟

131
00:08:29,580 --> 00:08:31,790
.لم يبدُ أنّه يتجاوز المستوى 300

132
00:08:31,920 --> 00:08:35,500
هذا يبيّن أنّ معايير الشياطين
.نفسها قد تدنّت

133
00:08:35,630 --> 00:08:38,290
صحيح أنّ البشرية هُزِمت على
،يد ملك الشياطين

134
00:08:38,420 --> 00:08:41,540
.لكنّه خسر معظم رجاله الموهوبين أيضًا

135
00:08:41,670 --> 00:08:44,830
لولا ذلك لكان العالم قد
.هلك منذ زمن

136
00:08:45,960 --> 00:08:49,920
أيعني هذا أنّ ملك الشياطين والنجوم
السماوية الإثني عشر

137
00:08:50,040 --> 00:08:51,790
هُم وحدهُم القادرون على مقاتلتي إذًا؟

138
00:08:52,420 --> 00:08:55,630
سيّدتي لوفاس، يبدو أنّك لم
...تقتلي أيًا منهم ولكن

139
00:08:55,750 --> 00:08:59,250
.نعم
.لأنّ الوحوش كانت ضحية للتلاعب فقط

140
00:08:59,540 --> 00:09:03,750
،لكن إن تركناهُم وشأنهُم
فقد يهاجمون النّاس مجددًا؟

141
00:09:03,960 --> 00:09:05,750
.لدينا خطّة

142
00:09:07,790 --> 00:09:09,170
!قبض

143
00:09:17,330 --> 00:09:21,130
حوّلتِ هذا العدد الكبير
!إلى أتباعك دفعة واحدة

144
00:09:21,250 --> 00:09:22,710
!كما هو متوقع

145
00:09:22,960 --> 00:09:25,830
لكن هل سنصطحب كلّ هؤلاء معنا؟

146
00:09:25,960 --> 00:09:28,290
.لن نفعل ذلك طبعًا

147
00:09:28,420 --> 00:09:29,630
!اسمعوا

148
00:09:29,830 --> 00:09:32,830
!على جميعكم أن تعودوا إلى مواطنكم

149
00:09:33,170 --> 00:09:36,420
!وإيّاكم مهاجمة النّاس بلا سبب

150
00:09:36,540 --> 00:09:37,750
!انصرفوا

151
00:09:43,210 --> 00:09:44,460
.هذا يفي بالغرض

152
00:09:44,580 --> 00:09:46,380
!سُوِّيَ كلّ شيء

153
00:09:46,500 --> 00:09:47,710
.نعم

154
00:09:48,330 --> 00:09:49,960
أليس كذلك يا أرييس؟

155
00:09:53,080 --> 00:09:54,080
!نعم

156
00:09:57,130 --> 00:09:58,210
...والآن

157
00:09:58,420 --> 00:10:00,290
،استعدنا أرييس بسلام

158
00:10:00,750 --> 00:10:04,210
.وهزمنا أيضًا مارس ذاك من الأنوار

159
00:10:04,750 --> 00:10:08,290
لِم عانينا كلّ تلك السنين؟

160
00:10:08,790 --> 00:10:10,580
ماذا حدث للوحوش؟

161
00:10:10,710 --> 00:10:13,750
أخضعناهم جميعًا تحت أمرنا الآن
.لذا لن يُسبّبوا مشكلة

162
00:10:16,790 --> 00:10:18,920
...كما توقعت، أنتِ

163
00:10:21,080 --> 00:10:22,580
هلّا ترافقينني؟

164
00:10:22,920 --> 00:10:25,250
.أودّ التحدث بعيدًا عن الأنظار

165
00:10:32,460 --> 00:10:36,920
هذا أحد أفضل اللّاعبين
.الذين استمتعوا باللعبة معي

166
00:10:37,040 --> 00:10:40,040
،خرجتُ للصيد مع ميغريز من قبل

167
00:10:40,170 --> 00:10:42,330
.واستمتعنا بالحديث في أمور تافهة

168
00:10:43,330 --> 00:10:45,920
هل ميغريز هذا هو
،نفسه ذلك اللاعب

169
00:10:46,040 --> 00:10:47,080
أم أنّه...؟

170
00:10:49,420 --> 00:10:50,460
!سيّد ميغريز

171
00:10:50,580 --> 00:10:51,750
!كنّا قلقين عليك

172
00:10:51,880 --> 00:10:55,630
لم نكن نعلم ما قد يحدث
.حين خرجتَ بمفردك

173
00:10:55,750 --> 00:10:58,460
،لكن يا سيّد ميغريز، لو سمحتَ

174
00:10:58,580 --> 00:11:00,420
.عليك أن تكون أكثر حذرًا

175
00:11:00,540 --> 00:11:04,630
أنت وليفيان ركيزتان لا يُستغنى
.عنهما في هذا البلد

176
00:11:04,750 --> 00:11:06,210
!هذا صحيح! هذا صحيح-

177
00:11:06,330 --> 00:11:10,080
.لا أستشعر أيّ مشاعر قلق تجاه السيّد ميغريز

178
00:11:10,500 --> 00:11:14,500
يبدو أنّ كلّ ما كان يهمّهم
.هو النجاة بحياتهم فقط

179
00:11:14,710 --> 00:11:17,330
.بصدق، يسرنا جدًا رؤيتك بخير

180
00:11:17,460 --> 00:11:18,540
!هذا صحيح-

181
00:11:18,670 --> 00:11:21,830
!والآن ضُمنت سلامة هذا البلد من جديد

182
00:11:24,040 --> 00:11:25,040
إذًا؟

183
00:11:25,170 --> 00:11:26,710
أليس ذلك فظيعًا؟

184
00:11:26,830 --> 00:11:29,880
كان أولئك الطبقة العليا الذين
يفترض أن يدافعوا عن الشعب

185
00:11:30,420 --> 00:11:31,670
لكن همّهم الوحيد

186
00:11:31,790 --> 00:11:34,130
.هو حماية أنفسهم والتملّق طلبًا للرضا

187
00:11:34,250 --> 00:11:36,330
هل أردت أن ترينا ذلك؟

188
00:11:36,960 --> 00:11:39,040
أردتُ أن أريك الدليل على خطئي

189
00:11:39,170 --> 00:11:41,670
.لأنّكِ أنتِ

190
00:11:46,290 --> 00:11:48,790
،لا أحد هنا سواي

191
00:11:48,920 --> 00:11:50,250
.ولا توجد مراقبة أيضًا

192
00:11:52,250 --> 00:11:54,130
هل يمكنك أن تريني وجهك؟

193
00:11:54,960 --> 00:11:56,210
.حسنًا

194
00:12:04,960 --> 00:12:07,000
.إنّها أنتِ حقًا إذًا

195
00:12:07,580 --> 00:12:08,670
.لوفاس

196
00:12:08,790 --> 00:12:12,210
.مضى زمن طويل يا صديقي القديم ميغريز

197
00:12:15,290 --> 00:12:17,460
...لا

198
00:12:18,830 --> 00:12:22,750
...هذا ليس اللّاعب

199
00:12:24,790 --> 00:12:28,580
أسترمقنا بهذه النظرة أنت أيضًا إذًا؟

200
00:12:30,670 --> 00:12:33,460
.يبدو أنك لستَ ميغريز الذي عرفناه

201
00:12:34,580 --> 00:12:39,380
....أظنني ما زلتُ وحيدة في هذا العالم إذًا

202
00:12:39,830 --> 00:12:42,000
.يتغيّر النّاس يا لوفاس

203
00:12:42,540 --> 00:12:46,040
بوسعهم أن يزدادوا قوّة
.أو يضعفوا على مدى 200 سنة

204
00:12:46,170 --> 00:12:48,040
.أنا ضعفت

205
00:12:48,170 --> 00:12:50,630
...ليس جسديًا فقط بل في الروح أيضًا

206
00:12:51,580 --> 00:12:52,750
يا لوفاس؟

207
00:12:52,880 --> 00:12:55,880
لِم عدت إلى هذا العالم الآن؟

208
00:12:56,210 --> 00:12:58,670
هل أتيت لتسخري من تدنّينا؟

209
00:12:59,580 --> 00:13:01,290
لا يسعنا إلّا القول
.أنّها كانت محض صدفة

210
00:13:01,880 --> 00:13:04,130
من حاولوا استدعاء بطل

211
00:13:04,250 --> 00:13:06,920
.جاؤوا بنا إلى هذا العالم عن طريق الخطأ

212
00:13:07,040 --> 00:13:08,130
.هذا كلّ ما في الأمر

213
00:13:11,630 --> 00:13:12,790
.فهمت

214
00:13:14,290 --> 00:13:16,580
ما خطب ميغريز هذا العالم؟

215
00:13:17,080 --> 00:13:19,040
.عدوتك اللدودة عادت من الموت

216
00:13:19,170 --> 00:13:21,080
.فمن المنطقي أن تعارضني

217
00:13:21,630 --> 00:13:22,790
...ومع ذلك

218
00:13:24,750 --> 00:13:25,880
.فهمت

219
00:13:26,710 --> 00:13:28,580
.رأينا مكتبات هذا البلد

220
00:13:28,710 --> 00:13:31,880
كان فيها كُتب كثيرة
.تنتقد الأبطال السبعة

221
00:13:32,000 --> 00:13:34,460
أنت من جمعتها هنا، صحيح؟

222
00:13:35,790 --> 00:13:41,420
يبدو أنّك تريد الإهانة أكثر من
.المديح والازدراء على الاحترام

223
00:13:41,790 --> 00:13:47,710
أتشعر بالذنب لأنّك فتحت الباب
لغزو الشياطين عند هزيمتنا؟

224
00:13:49,920 --> 00:13:50,920
.فهمت

225
00:13:51,170 --> 00:13:54,710
لم تعُد قادرًا على تحمّل الإعجاب
والحسد من حولك، صحيح؟

226
00:13:54,830 --> 00:13:56,790
،تُسحَق تحت وطأة لومك لنفسك

227
00:13:56,920 --> 00:13:58,920
،ومع ذلك لا تستطيع تفريغ ندمك

228
00:13:59,040 --> 00:14:01,500
.لذا يغدو احترامهم لك أشد سيف مُضاءً

229
00:14:02,210 --> 00:14:03,580
أهذا ما في الأمر؟

230
00:14:08,960 --> 00:14:11,460
.أرى أنّ طبيعتك المزعجة لم تتغيّر

231
00:14:12,330 --> 00:14:14,080
.احتفل إن فزتَ

232
00:14:14,380 --> 00:14:16,960
.افتخر بهزيمتك لخصم عظيم

233
00:14:17,080 --> 00:14:20,170
ثم امضِ قدمًا في الطريق
الذي تعتقد أنّه الصواب

234
00:14:20,580 --> 00:14:24,380
.على الأقل، هذا هو ميغريز الذي عرفناه

235
00:14:25,540 --> 00:14:28,880
ألا تضمرين لنا ضغينة لما فعلناه؟

236
00:14:30,000 --> 00:14:33,960
كنتِ على وشك تحقيق المستقبل
.الذي سعيتِ إليه

237
00:14:34,290 --> 00:14:37,290
.ونحن من دمّرناه بخيانتنا

238
00:14:37,710 --> 00:14:40,750
ألا تكرهيننا بسبب ذلك؟

239
00:14:43,960 --> 00:14:47,080
.لا أشعر بأيّ كراهية تجاههم

240
00:14:47,500 --> 00:14:52,210
وقعت تلك المعركة في اللّعبة
.ولم أخضها فعليًا

241
00:14:53,790 --> 00:14:56,250
كيف كانت لوفاس ستردّ عليه؟

242
00:14:57,540 --> 00:15:00,880
.حسنًا، سأحاول أن أعطيه إجابتي الخاصة

243
00:15:01,960 --> 00:15:03,000
.ميغريز

244
00:15:04,960 --> 00:15:08,380
،إن انتفضتم علينا لعدم رضاكم عنّا

245
00:15:08,750 --> 00:15:11,290
.فذلك لا يعني إلّا أنّنا قصّرنا كقائدة

246
00:15:12,040 --> 00:15:14,960
.ليس لنا أدنى سبب لنكرهكم جميعًا

247
00:15:16,290 --> 00:15:17,290
...لا يعقـ

248
00:15:22,040 --> 00:15:23,170
.ميغريز

249
00:15:24,500 --> 00:15:26,710
.كفّ عن لوم نفسك باستمرار

250
00:15:28,290 --> 00:15:31,710
.أنت بطل في نظر شعب هذا البلد

251
00:15:32,080 --> 00:15:33,380
.قف بفخر

252
00:15:34,630 --> 00:15:36,880
.كما كنتَ قبل 200 سنة

253
00:15:38,460 --> 00:15:40,040
!أتعلمان ما أظن؟

254
00:15:40,290 --> 00:15:43,210
الإلف منغلقون أكثر ممّا ينبغي

255
00:15:43,330 --> 00:15:45,630
!عليهم النظر إلى العالم الأوسع

256
00:15:45,750 --> 00:15:46,920
لذا أريد

257
00:15:47,040 --> 00:15:50,830
أن أنشئ دولة يعيش فيها الإلف
بفخر في مدينة عظيمة زاهرة

258
00:15:50,960 --> 00:15:53,830
!بدلًا من أن يظلّوا حبيسي أعماق الغابات

259
00:15:53,960 --> 00:15:57,000
أريد أن أثبت للجميع أنّ الإلف
!قادرون مثل غيرهم تمامًا

260
00:15:57,130 --> 00:15:58,130
!صحيح

261
00:15:58,250 --> 00:16:00,460
!على الرجل أن يحلم أحلامًا كبيرة

262
00:16:00,580 --> 00:16:01,960
!هذا لا يكفي يا ميغريز

263
00:16:02,080 --> 00:16:03,580
،إن كان حلمك تأسيس دولة

264
00:16:03,710 --> 00:16:05,500
!فحلمي هو غزو العالم

265
00:16:05,630 --> 00:16:10,130
سأنشئ مدينة فاضلة
!لا يخاف فيها أحد من الشياطين

266
00:16:11,040 --> 00:16:12,500
!ما-ما المضحك؟

267
00:16:12,630 --> 00:16:15,670
!غزو العالم حلم كبير جدًا

268
00:16:15,790 --> 00:16:16,920
،إن استطعتِ تحقيقه حقًا

269
00:16:17,040 --> 00:16:19,420
!فسألتهم المعكرونة من أنفي

270
00:16:19,540 --> 00:16:21,420
!قلتَها الآن يا أليوث

271
00:16:21,540 --> 00:16:22,920
،حين أغزو العالم

272
00:16:23,040 --> 00:16:24,920
!ستكون رئتاك محشوة بالمعكرونة

273
00:16:25,040 --> 00:16:27,130
!حسنًا، حسنًا

274
00:16:30,250 --> 00:16:31,130
!توقف

275
00:16:31,250 --> 00:16:33,170
!لا تضحك أيضًا

276
00:16:55,170 --> 00:16:57,290
.شكرًا على النصيحة

277
00:16:58,960 --> 00:16:59,960
.شكرًا

278
00:17:05,580 --> 00:17:07,790
.يفترض أن ليفيا بخير الآن

279
00:17:07,920 --> 00:17:09,420
.أنا ممتن

280
00:17:09,750 --> 00:17:14,380
لم أستطع استعادة نقاط حياتها
.القصوى المفقودة بحالتي الراهنة

281
00:17:18,250 --> 00:17:19,920
.نعتذر بشأن ما تسبّب به أرييس من مشاكل

282
00:17:20,040 --> 00:17:22,080
.لن أعتذر

283
00:17:22,420 --> 00:17:25,290
!إنّهم الملامون لأنّهم خانوك أولًا

284
00:17:25,790 --> 00:17:27,000
.هوّن

285
00:17:29,170 --> 00:17:30,830
ما الذي تنوين فعله الآن؟

286
00:17:30,960 --> 00:17:34,710
سنواصل طبعًا استعادة كلّ
.النجوم السماوية الإثني عشر

287
00:17:34,830 --> 00:17:35,880
...التالي هو

288
00:17:36,000 --> 00:17:37,580
"عند "قبر الملك أسود الجناحين

289
00:17:37,710 --> 00:17:39,330
قبر الملك أسود الجناحين؟

290
00:17:39,710 --> 00:17:42,040
.يبدو من اسمه وكأنّه قبرنا

291
00:17:42,170 --> 00:17:45,880
.إنّه كذلك بالضبط يا سيّدتي لوفاس

292
00:17:46,080 --> 00:17:47,420
،قبل 200 سنة

293
00:17:47,540 --> 00:17:53,040
شيّد الذين أعجبوا بك
.أكبر بناء في العالم

294
00:17:53,170 --> 00:17:54,250
،وفي طابقه الأعلى

295
00:17:54,380 --> 00:17:58,380
دُفنت الكنوز والمعدات
.التي كنتِ تستعملينها

296
00:17:58,710 --> 00:18:01,460
ظلّت واحدة من النجوم السماوية
،الإثني عشر، ليبرا الميزان

297
00:18:01,580 --> 00:18:05,000
.تحرسه طيلة هذه السنين بلا انقطاع

298
00:18:05,250 --> 00:18:06,380
ليبرا إذًا؟

299
00:18:06,500 --> 00:18:07,750
يشاعُ أنّها

300
00:18:07,880 --> 00:18:11,080
صارت آلة قتل تفتك بكلّ

301
00:18:11,210 --> 00:18:13,250
.من يقترب من الطابق الأعلى بغير سؤال

302
00:18:15,170 --> 00:18:16,080
...مع ذلك

303
00:18:16,210 --> 00:18:20,670
هل من سبب يدفع النّاس للمخاطرة
بقتال ليبرا لمجرد نهب قبرنا؟

304
00:18:21,420 --> 00:18:25,380
لم يتدهور البشر والوحوش وحدهم
بغضون المئتي سنة

305
00:18:25,500 --> 00:18:27,880
.بل الأسلحة والمعدات صارت أردأ أيضًا

306
00:18:28,170 --> 00:18:30,580
معظم الأسلحة الأسطورية

307
00:18:30,710 --> 00:18:33,040
.فُقدت في المعركة مع ملك الشياطين

308
00:18:33,170 --> 00:18:36,380
.لذا ما بقي منها مُودَع في قبرك

309
00:18:36,500 --> 00:18:40,960
إنّها أشياء تتوق إليها البشرية بشدة

310
00:18:41,080 --> 00:18:44,710
.لكن لم يستطع أحد الحصول عليها بسبب ليبرا

311
00:18:45,080 --> 00:18:47,080
،مع ذلك، من وجهة نظرنا

312
00:18:47,210 --> 00:18:49,630
فهي ليست سوى خادمة
.مخلصة تحرس ممتلكاتنا

313
00:18:50,710 --> 00:18:52,210
.أعلم ذلك

314
00:18:53,040 --> 00:18:56,580
،لوفاس، أعلم أنّ طلبي هذا مُخزٍ

315
00:18:56,710 --> 00:18:58,290
،لكن بعد أن تستعيدي ليبرا

316
00:18:58,420 --> 00:19:02,500
هلّا تتركين لنا في القبر
ما لن تحتاجي إليه من أشياء؟

317
00:19:03,330 --> 00:19:06,080
.نعدّ هذا طلبًا معقولًا

318
00:19:06,580 --> 00:19:07,580
.شكرًا

319
00:19:07,880 --> 00:19:10,830
.حان وقتُ زيارة ليبرا إذًا

320
00:19:11,250 --> 00:19:12,250
.مهلًا لحظة

321
00:19:13,210 --> 00:19:16,040
لا شك أنّ التنقل في
هذا اللّباس عسير، صحيح؟

322
00:19:22,830 --> 00:19:24,380
!تبدين رائعة يا سيّدتي لوفاس

323
00:19:24,500 --> 00:19:27,080
!إنّه يليق بك كثيرًا

324
00:19:29,290 --> 00:19:30,670
ما رأيك يا ميغريز؟

325
00:19:30,790 --> 00:19:33,330
.أظنّ أنّك تبدين جميلة بأيّ لباس ترتدينه

326
00:19:33,630 --> 00:19:35,960
.أنا شاكرة للأداة التي تخفي جناحيّ

327
00:19:36,080 --> 00:19:38,460
.لن نتردد في الاستفادة منها

328
00:19:38,580 --> 00:19:40,960
تحررتُ أخيرًا من ذلك القيد
!الذي فرضته على نفسي

329
00:19:41,080 --> 00:19:42,750
!شكرًا يا ميغريز

330
00:19:43,580 --> 00:19:45,830
.لنلتقِ مجددًا يومًا ما

331
00:19:46,580 --> 00:19:47,920
.اعذرنا

332
00:19:48,500 --> 00:19:51,250
!لا أريد أن أراك من جديد

333
00:19:52,710 --> 00:19:53,960
.هون يا فتى

334
00:19:54,080 --> 00:19:55,080
.لوفاس

335
00:20:02,790 --> 00:20:03,920
.رافقتك السلامة

336
00:20:09,170 --> 00:20:10,170
!غانتز

337
00:20:11,130 --> 00:20:12,710
!مذهل، ما أجملكِ

338
00:20:12,830 --> 00:20:16,210
ما-ما حاجتك بي يا آنسة؟

339
00:20:16,330 --> 00:20:20,290
.هيّا، لا داعي للتحدث هكذا الآن

340
00:20:20,960 --> 00:20:23,460
.انظر، نحن سفالو

341
00:20:24,790 --> 00:20:27,750
!أكنتِ بهذا الجمال.

342
00:20:28,790 --> 00:20:31,290
.أردنا أن نُودّعك قبل أن ننطلق

343
00:20:31,790 --> 00:20:33,380
!شكرًا لمساعدتنا

344
00:20:33,500 --> 00:20:34,710
...احذرا كلاكما

345
00:20:35,080 --> 00:20:39,080
.وأنت أيضًا أيتها الشابة الجميلة

346
00:20:39,210 --> 00:20:40,380
.إنّه فتى في الحقيقة

347
00:20:40,500 --> 00:20:41,790
!حقًا؟

348
00:20:41,920 --> 00:20:46,420
.تـ-توخ الحذر أيّها الشاب الوسيم

349
00:20:48,380 --> 00:20:49,790
!وداعًا يا غانتس

350
00:20:49,920 --> 00:20:52,210
!لنلتقِ مجددًا إن سنحت الفرصة

351
00:20:56,420 --> 00:20:57,420
.مهلًا

352
00:20:57,960 --> 00:20:59,830
...هل أنتِ

353
00:21:00,630 --> 00:21:02,210
...في الواقع لو

354
00:21:04,710 --> 00:21:06,630
.لا تبالي

355
00:21:06,960 --> 00:21:08,920
!اعتنِ بنفسك يا سفالو

356
00:21:10,380 --> 00:21:11,380
.نعم

357
00:21:15,170 --> 00:21:16,960
.محال

358
00:21:18,630 --> 00:21:21,790
كان غانتز رجلًا طيبًا حقًا، صحيح؟

359
00:21:21,920 --> 00:21:22,920
.نعم

360
00:21:23,630 --> 00:21:25,000
...والآن، محطتنا التالية

361
00:21:25,830 --> 00:21:27,500
.ليبرا الميزان

362
00:23:02,420 --> 00:23:06,420
...تلك القوة، الجناحان الأسودان
.لا مجال للشك

363
00:23:06,920 --> 00:23:08,250
لوفاس مافاهل

364
00:23:08,380 --> 00:23:09,710
!عادت

365
00:23:10,130 --> 00:23:11,290
!هذا كابوس

366
00:23:11,420 --> 00:23:12,960
!كيف يعقل حدوث هذا؟

367
00:23:15,420 --> 00:23:16,630
!...أ-أنت

368
00:23:16,750 --> 00:23:18,330
.هذا لا يصلح

369
00:23:18,460 --> 00:23:22,130
الممثلون الذين أدّوا دورهم
.عليهم الانسحاب بهدوء

370
00:23:22,330 --> 00:23:24,580
.حين ينتهي دورك، تغادر

371
00:23:25,000 --> 00:23:27,170
.هذه هي قاعدة اللعبة

372
00:23:28,500 --> 00:23:30,330
.وداعًا يا مارس

373
00:23:30,460 --> 00:23:32,380
.أيّها الدمية البائسة

374
00:23:32,500 --> 00:23:33,580
!لا