1
00:01:03,210 --> 00:01:04,410
.حسنًا

2
00:01:04,680 --> 00:01:05,750
.سأفعلها

3
00:01:05,990 --> 00:01:08,050
.سأثقب أذناي

4
00:01:08,050 --> 00:01:09,510
.سأفعلها اليوم

5
00:01:10,450 --> 00:01:12,170
!سأفعلها الآن

6
00:01:13,480 --> 00:01:14,830
.افعليها فحسب

7
00:01:15,070 --> 00:01:16,210
ما الذي تفعلينه؟

8
00:01:16,210 --> 00:01:17,510
هل أضغط على هذه؟

9
00:01:17,920 --> 00:01:18,930
!سأقتلك

10
00:01:18,930 --> 00:01:20,930
!كدتِ أن تحفري أذني

11
00:01:20,930 --> 00:01:22,160
!ياه، إبرة

12
00:01:22,160 --> 00:01:24,640
ما الذي كنتِ ستفعلينه
بأذنك مع هذه؟

13
00:01:24,640 --> 00:01:25,210
ماذا؟

14
00:01:25,420 --> 00:01:27,110
...حسنًا

15
00:01:27,110 --> 00:01:29,720
.كنت سأثقبها

16
00:01:29,720 --> 00:01:31,150
!لمَ قد تفعلين ذلك؟

17
00:01:31,850 --> 00:01:36,500
إن ثقبتِ أذنك بإبرة، فسينثر
.الدم في كل مكان

18
00:01:36,910 --> 00:01:41,460
ثم ستدخل البكتيريا داخل
...الجرح وتلوثه

19
00:01:41,780 --> 00:01:43,060
...ثم تعانين

20
00:01:43,510 --> 00:01:44,180
.وتموتين

21
00:01:44,180 --> 00:01:44,950
!توقفي

22
00:01:45,170 --> 00:01:47,030
...لـ-لن أموت

23
00:01:47,300 --> 00:01:48,620
...لن

24
00:01:50,400 --> 00:01:51,770
لن أموت، صحيح؟

25
00:01:51,770 --> 00:01:53,080
.ستكونين على ما يرام

26
00:01:53,080 --> 00:01:54,810
لن أنزف، صحيح؟

27
00:01:54,810 --> 00:01:55,960
.ستنزفين

28
00:01:56,190 --> 00:01:57,660
!سحقًا

29
00:01:58,050 --> 00:02:01,820
...كل ما أردته هو ارتداء أقراط ظريفة

30
00:02:01,820 --> 00:02:03,000
!لا تكوني مجنونة

31
00:02:03,000 --> 00:02:04,380
!لمَ تفعلين هذا؟

32
00:02:05,590 --> 00:02:06,840
!أتريدين رجلًا؟

33
00:02:07,090 --> 00:02:08,560
!ماذا لو أردت؟

34
00:02:09,010 --> 00:02:10,440
،أردت أن ألبس ملابس أفضل

35
00:02:10,770 --> 00:02:12,190
...وأكون أجمل قليلًا

36
00:02:12,780 --> 00:02:14,980
.أنا أيضًا أريد حبيبًا

37
00:02:14,980 --> 00:02:16,600
.لهذا السبب إذًا

38
00:02:17,570 --> 00:02:20,170
أنتِ يا هيراغي يطلب الشبان
،مواعدتك أحيانًا

39
00:02:20,170 --> 00:02:22,620
.وشينا تتغازل مع حبيبها طوال الوقت

40
00:02:23,240 --> 00:02:25,210
!ولكن لا أحد يقترب مني أبدًا

41
00:02:25,210 --> 00:02:27,370
،إلّم أستطع ثقب أذني حتى

42
00:02:27,370 --> 00:02:29,570
!فسأكون عزباء إلى الأبد

43
00:02:29,820 --> 00:02:32,250
.لذا لا توقفيني

44
00:02:33,070 --> 00:02:34,420
.أتفهم تمامًا

45
00:02:34,420 --> 00:02:38,160
ولكن إن فعلتِها بهاتين اليدين
.المرتجفتين فستفشلين حتمًا

46
00:02:38,160 --> 00:02:39,670
!اصمتي فحسب

47
00:02:40,200 --> 00:02:41,110
...لذا

48
00:02:41,680 --> 00:02:44,920
.أنا سأدعم يدك

49
00:02:46,520 --> 00:02:47,550
...أنتِ

50
00:02:47,550 --> 00:02:49,150
!والآن، افعليها

51
00:02:49,150 --> 00:02:51,180
!سأمسك بيدك بكل قوتي

52
00:02:51,180 --> 00:02:52,640
!نعم! سأفعلها

53
00:02:52,640 --> 00:02:55,240
!اثقبيها! احفري حفرة في أذنك

54
00:02:55,240 --> 00:02:57,570
...عليّ أولًا أن أهدّئ قلبي

55
00:02:57,570 --> 00:03:00,690
احفري حفرة في باب
!مستقبلك الجديد

56
00:03:00,690 --> 00:03:01,550
!لحظة، توقفي

57
00:03:01,550 --> 00:03:02,740
!لا تدفعي

58
00:03:02,740 --> 00:03:07,450
!هيّا

59
00:03:04,050 --> 00:03:07,450
!اتركيني! لست جاهزة لهذا

60
00:03:10,660 --> 00:03:12,050
.هوني عليك

61
00:03:13,200 --> 00:03:14,370
.بذلتِ جهدك

62
00:03:19,890 --> 00:03:22,720
لـ-لكنّه لم يؤلم كثيرًا، أليس كذلك؟

63
00:03:23,190 --> 00:03:24,680
.نعم

64
00:03:24,680 --> 00:03:26,090
.ليس إلى ذلك الحد

65
00:03:26,090 --> 00:03:28,300
.اثقبي الأذن الثانية إذًا

66
00:03:28,300 --> 00:03:29,180
!ماذا؟

67
00:03:29,970 --> 00:03:32,060
...لنرى

68
00:03:32,350 --> 00:03:34,890
.ربما في وقتٍ آخر

69
00:03:34,890 --> 00:03:36,410
.حـ-حسنًا

70
00:03:42,150 --> 00:03:42,860
!حسنًا

71
00:03:42,950 --> 00:03:44,950
!لنذهب للتمشي

72
00:03:49,490 --> 00:03:51,890
!أنت مفعم بالحيوية اليوم

73
00:03:51,890 --> 00:03:53,540
أتريد التمشي لوقتٍ أطول؟

74
00:04:05,770 --> 00:04:09,780
ألم يبقَ أحد ليُشعل النار
في قلب صقر معبر كودان؟

75
00:04:11,710 --> 00:04:12,560
!ماذا؟

76
00:04:12,560 --> 00:04:14,400
!ما هذا؟

77
00:04:18,000 --> 00:04:22,020
كـ-كلب وطفلة ما يتحدانني
لسباق على الطريق السريع؟

78
00:04:23,060 --> 00:04:24,930
!لا تستهينا بي

79
00:04:23,890 --> 00:04:26,130
!مرحى

80
00:04:27,160 --> 00:04:29,410
!سهل

81
00:04:27,770 --> 00:04:29,110
!ماذا؟

82
00:04:29,410 --> 00:04:31,200
!يا له من التفاف حاد

83
00:04:31,200 --> 00:04:33,000
!أهي غبية لا تقدر حياتها؟

84
00:04:33,230 --> 00:04:36,760
!أم هل تثق بآلتها إلى هذا الحد؟

85
00:04:36,760 --> 00:04:38,250
!مرحى

86
00:04:38,540 --> 00:04:39,210
...ولكن

87
00:04:39,210 --> 00:04:42,630
هذا الطريق المستقيم
!سيظهر من آلته أفضل

88
00:04:43,360 --> 00:04:44,400
!هنا

89
00:04:45,410 --> 00:04:46,180
—ما

90
00:04:46,360 --> 00:04:47,920
!ماذا؟

91
00:04:48,140 --> 00:04:52,820
إنّها تقلل من دفع الهواء
!بإرجاع جسدها إلى الخلف؟

92
00:04:53,280 --> 00:04:54,720
!إنّه كلب! كلب

93
00:04:54,720 --> 00:04:56,530
!كيف لي أن أخسر أمام حيوان؟

94
00:04:56,740 --> 00:04:57,890
!كيف لي أن أخسر؟

95
00:05:00,010 --> 00:05:03,400
!وغدان

96
00:05:08,230 --> 00:05:11,650
!لا شيء أفضل من موزة ما بعد التمرين

97
00:05:14,290 --> 00:05:16,030
.الفتاة الحمقاء

98
00:05:16,930 --> 00:05:19,140
!حسنًا! سآتي لإنقاذك الآن

99
00:05:19,910 --> 00:05:22,120
!أيّها الجميع، لنلعب

100
00:05:22,120 --> 00:05:22,770
.آه

101
00:05:22,770 --> 00:05:23,750
.يوشيكو

102
00:05:23,750 --> 00:05:27,010
أهذه ميكا-تشان؟ لم أرها
!منذ مدة طويلة

103
00:05:27,280 --> 00:05:29,740
يوشيكو-أونيتشان، هل يمكنك
أن تلعبي بمايكل؟

104
00:05:30,350 --> 00:05:32,100
!أريد أن أكون ميكا-تشان

105
00:05:32,100 --> 00:05:32,880
!هل أنتِ طفلة

106
00:05:33,110 --> 00:05:33,950
.حسنًا

107
00:05:33,950 --> 00:05:35,180
!إنّها البالغة

108
00:05:36,120 --> 00:05:37,930
.مرحبًا يا مايكل

109
00:05:37,930 --> 00:05:40,930
.ميكا-تشان، تبدين ظريفة اليوم

110
00:05:40,930 --> 00:05:45,210
ماذا؟ أتحاول إغرائي بهذا؟
ما الذي تريده؟

111
00:05:45,430 --> 00:05:46,280
المال؟

112
00:05:46,280 --> 00:05:47,600
!جسدي؟

113
00:05:48,030 --> 00:05:51,230
.لا يهم. لا يهمني ما هو هدفك

114
00:05:51,560 --> 00:05:55,350
لا أهتم لشيء، أريد أن
.أُحب فحسب

115
00:05:55,350 --> 00:05:57,620
ما الذي حدث لها؟

116
00:05:57,620 --> 00:05:59,630
.إنّي أحبك حقًّا

117
00:05:59,630 --> 00:06:00,250
!كاذب

118
00:06:00,250 --> 00:06:03,510
تعرف أيّ نوعٍ من النساء أنا، أليس كذلك؟

119
00:06:03,510 --> 00:06:04,540
!لا أحد يعرف

120
00:06:04,870 --> 00:06:07,460
!لا أفهم ما تقولينه تمامًا، لكن لا بأس

121
00:06:07,460 --> 00:06:08,960
!هل يهمك حتّى يا مايكل؟

122
00:06:09,540 --> 00:06:10,720
...مايكل

123
00:06:10,720 --> 00:06:12,250
!إنّك سهلة يا ميكا-تشان

124
00:06:12,430 --> 00:06:14,990
...يمكنني أن أكون سعيدة أخيرًا

125
00:06:14,990 --> 00:06:16,220
!ميكا-تشان

126
00:06:17,120 --> 00:06:18,870
.لنلعب هناك

127
00:06:18,870 --> 00:06:20,060
.نعم

128
00:06:23,350 --> 00:06:25,180
!مايكل

129
00:06:25,180 --> 00:06:26,280
!آسف

130
00:06:26,280 --> 00:06:28,150
!مايكل! قل شيئًا

131
00:06:29,760 --> 00:06:32,370
...نبضه... قد توقّف

132
00:06:33,220 --> 00:06:36,260
...سآخذ

133
00:06:36,260 --> 00:06:38,740
!بانتقامك

134
00:06:39,940 --> 00:06:44,010
!سأعذب كلّ واحدٍ منهم بنفسي

135
00:06:44,010 --> 00:06:45,380
!ميكا-تشان مخيفة

136
00:06:45,380 --> 00:06:47,380
!اذهب إلى الجحيم

137
00:06:48,920 --> 00:06:53,550
!مت! ركلة ميكا-تشان القاتلة

138
00:06:51,830 --> 00:06:53,750
!تـ-توقفي

139
00:06:57,150 --> 00:06:58,410
!لا

140
00:06:58,410 --> 00:06:59,260
!لا تعريها

141
00:06:59,640 --> 00:07:00,840
!إنّك فظيع

142
00:07:00,840 --> 00:07:04,330
!لمَ تضربني حتّى نُزعت ملابسي عني؟

143
00:07:04,330 --> 00:07:06,320
!لا! أنتِ من نزع الملابس

144
00:07:06,320 --> 00:07:08,300
.لا يهم. يمكنك فعل ما تريده بي

145
00:07:08,300 --> 00:07:09,150
!ما يعني ذلك؟

146
00:07:09,390 --> 00:07:12,590
،يمكنك فعل ما تريده بجسدي

147
00:07:13,270 --> 00:07:14,650
...ولكن قلبي

148
00:07:15,020 --> 00:07:16,950
!سينتمي لمايكل دائمًا...

149
00:07:16,950 --> 00:07:18,450
!ما الذي تتحدثين عنه؟

150
00:07:18,450 --> 00:07:21,300
...أنا آسفة... مايكل

151
00:07:21,560 --> 00:07:23,060
.لنرحل فحسب

152
00:07:23,060 --> 00:07:23,990
.نعم

153
00:07:23,990 --> 00:07:27,400
!ماذا؟! ألا تهتم لجسدي حتى؟

154
00:07:27,400 --> 00:07:28,740
!إنّك مزعجة يا ميكا-تشان

155
00:07:29,330 --> 00:07:31,130
!انتهى كل شيء

156
00:07:31,130 --> 00:07:32,810
!انتهت حياتي

157
00:07:33,100 --> 00:07:35,410
!أنا بلا قيمة كامرأة

158
00:07:35,410 --> 00:07:36,840
.هذا غير صحيح

159
00:07:37,920 --> 00:07:39,050
...ذلك الصوت

160
00:07:40,880 --> 00:07:43,030
!مـ-مايكل

161
00:07:43,220 --> 00:07:45,400
.لنعش معًا

162
00:07:45,400 --> 00:07:47,650
لـ-لا... لكن كيف؟

163
00:07:47,650 --> 00:07:49,870
!اعتقدت أنّك ميّت

164
00:07:51,770 --> 00:07:53,690
!عدت إلى الحياة

165
00:07:53,690 --> 00:07:56,100
!مايكل

166
00:07:56,540 --> 00:07:58,330
.يا لها من قصة مرقّعة

167
00:08:12,260 --> 00:08:17,010
،إن كنت أريد التقرب من أكتسو-كن
.فعليّ التقرب من عائلته

168
00:08:18,340 --> 00:08:20,130
!أحبّك يا أونيه-تشان

169
00:08:20,130 --> 00:08:23,700
!تزوجي أخي لتكوني أختي حقًّا

170
00:08:23,700 --> 00:08:27,080
.ماذا؟ لا يجب أن نستعجل

171
00:08:27,080 --> 00:08:27,970
أليس كذلك؟

172
00:08:27,970 --> 00:08:30,360
متى نتزوج؟

173
00:08:31,070 --> 00:08:32,820
!الآن

174
00:08:33,290 --> 00:08:37,950
حـ-حسنًا! سأقوم بإبهاجها بما
!أنّها أحرزت صفرًا في الاختبار

175
00:08:37,950 --> 00:08:38,900
.لا تتحركي

176
00:08:38,900 --> 00:08:39,790
!ماذا؟

177
00:08:39,790 --> 00:08:41,650
ما الذي تظنين أنّك فاعلة؟

178
00:08:41,650 --> 00:08:44,450
!أنتِ والدة هاناباتاكي-سان

179
00:08:44,670 --> 00:08:47,600
!لحظة، نزعت حمالة صدري بتلك اللمسة

180
00:08:47,600 --> 00:08:49,290
!ما هذه العجوز؟

181
00:08:50,380 --> 00:08:55,070
إن كنتِ تحاولين التقرب من تلك
.الفتاة، فاعلمي أنّ لن يكون لذلك معنى

182
00:08:55,070 --> 00:08:57,320
مـ-ماذا تقصدين؟

183
00:08:58,690 --> 00:09:00,050
.عمّة

184
00:09:00,050 --> 00:09:01,460
.آه، روري-تشان

185
00:09:01,460 --> 00:09:02,870
.تبدين محبطة

186
00:09:02,870 --> 00:09:04,510
.حصلت على صفر مرة أخرى

187
00:09:04,510 --> 00:09:09,440
.كما أقول دائمًا، ستفعلينها مع الوقت

188
00:09:09,780 --> 00:09:13,150
.شكرًا لك يا عمّة، إنّك لطيفة دائمًا

189
00:09:13,150 --> 00:09:14,110
!ياه

190
00:09:13,150 --> 00:09:14,110
...هذه المرأة

191
00:09:14,570 --> 00:09:17,020
!إنّها تتقرب من هذه الفتاة منذ مدّة طويلة

192
00:09:17,720 --> 00:09:20,700
!لا! إنّها امرأة سيئة في الحقيقة

193
00:09:20,700 --> 00:09:23,000
ماذا؟ من تكونين؟

194
00:09:23,910 --> 00:09:25,840
!إنّها مُلاحقة لـ آ-كن

195
00:09:25,840 --> 00:09:27,500
!ما— لـ-لا

196
00:09:27,750 --> 00:09:30,640
—أوني-تشان أغرب من أن يُلاحَق

197
00:09:30,640 --> 00:09:32,160
!أكتسو-كن غريب؟

198
00:09:32,160 --> 00:09:34,550
!ولكنّه بارد القلب وسادي

199
00:09:34,550 --> 00:09:35,960
!هذه الفتاة تبدو خطيرة

200
00:09:35,960 --> 00:09:40,090
!لست كذلك! هذه المرأة هي الخطيرة

201
00:09:42,430 --> 00:09:47,150
أتعتقدين أنّ روري-تشان ستصدق
كلمات فتاة كاشفة لا ترتدي سروالًا داخليًّا؟

202
00:09:47,150 --> 00:09:49,150
!سروالي الداخلي؟

203
00:09:49,850 --> 00:09:53,930
!فهمت! نزع حمالة صدري كان مجرّد إلهاء

204
00:09:53,930 --> 00:09:59,900
أرادتني أن أركز على جسمي العلوي لكي
!يكون جسمي السفلي وسروالي بلا دفاع

205
00:10:01,220 --> 00:10:06,060
هذه الفتاة مُلاحقة وكاشفة
.ولا ترتدي سروالًا داخليًّا

206
00:10:06,060 --> 00:10:09,650
!ماذا؟ نزعتِ سروالي للتو بسرعة شديدة

207
00:10:09,650 --> 00:10:11,370
كيف يمكنني أن أفعل هذا؟

208
00:10:11,370 --> 00:10:13,340
!أيّتها العجوزة الشمطاء

209
00:10:13,540 --> 00:10:15,410
!ابتعدي عنها أيّتها المنحرفة

210
00:10:15,410 --> 00:10:19,380
!أعيدي لي سروالي أيّتها العجوز الشمطاء اللّعينة

211
00:10:19,380 --> 00:10:21,890
!أيّتها المنحرفة

212
00:10:32,180 --> 00:10:34,350
مـ-ما هاتان الاثنتان؟

213
00:10:34,350 --> 00:10:36,600
!سروالي

214
00:10:36,600 --> 00:10:38,180
!لا فائدة! لا فائدة

215
00:10:38,180 --> 00:10:39,690
!أو هذا ما يبدو

216
00:10:39,690 --> 00:10:41,950
!سآخذ سروالك بدلًا من ذلك

217
00:10:44,040 --> 00:10:46,720
!هذا واضحٌ تمامًا أيّتها الصغيرة

218
00:10:48,640 --> 00:10:50,570
!والآن، انظري جيّدًا يا روري-تشان

219
00:10:50,570 --> 00:10:53,970
!سأثبت أنّها كاشفة لا ترتدي سروالًا

220
00:10:53,970 --> 00:10:54,640
!لا

221
00:10:55,000 --> 00:10:56,560
!تـ-توقفي

222
00:10:56,560 --> 00:10:58,590
!إنّها نهايتك

223
00:10:58,590 --> 00:11:02,620
!لا! أرجوك لا

224
00:11:14,260 --> 00:11:16,310
.إنّها ترتدي سروالًا

225
00:11:16,310 --> 00:11:17,190
!ماذا؟

226
00:11:17,440 --> 00:11:19,910
!مستحيل

227
00:11:22,230 --> 00:11:24,070
.إنّها ترتديه

228
00:11:24,070 --> 00:11:25,760
!ماذا؟ كيف؟

229
00:11:25,760 --> 00:11:29,200
.أشعر بالرياح تحت تنورتي

230
00:11:29,200 --> 00:11:30,900
...ماذا؟ لم تقومي

231
00:11:31,860 --> 00:11:34,020
!لا يمكن! أيّتها الوغدة

232
00:11:35,460 --> 00:11:40,600
!نزعتِ سروال روري برجلك وارتديته؟

233
00:11:43,790 --> 00:11:46,920
.دون أن ألاحظ، بلمح البصر

234
00:11:51,550 --> 00:11:55,740
.عليّ أنا أعاود التدريب

235
00:11:56,220 --> 00:11:59,650
.سنحلّ هذا في يومٍ آخر

236
00:12:01,460 --> 00:12:02,150
ماذا؟

237
00:12:14,290 --> 00:12:16,120
ما كان ذلك؟

238
00:12:17,020 --> 00:12:17,830
ماذا؟

239
00:12:18,050 --> 00:12:18,990
هاه؟

240
00:12:19,300 --> 00:12:21,340
!اختفى سروالي؟

241
00:12:25,780 --> 00:12:29,520
!المعركة الأخيرة! الضربة القاضية! الفتاة الحمقاء