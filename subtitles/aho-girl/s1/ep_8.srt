1
00:01:01,910 --> 00:01:03,660
!أيّتها الجانحات

2
00:01:03,930 --> 00:01:06,040
!لنلعب

3
00:01:06,040 --> 00:01:08,160
.ابتعدي أيّتها الحمقاء

4
00:01:08,390 --> 00:01:09,670
من تراسلين؟

5
00:01:09,670 --> 00:01:11,260
!أيمكن أن يكون حبيبك؟

6
00:01:11,260 --> 00:01:13,750
.لـ-لا علاقة لك بهذا

7
00:01:15,170 --> 00:01:17,130
.يبدو أنّك عزباء

8
00:01:17,130 --> 00:01:18,540
!اصمتي

9
00:01:19,140 --> 00:01:21,940
!ما يهمّك ما إن كان لدي حبيب أو لا؟

10
00:01:21,940 --> 00:01:24,080
!أريد معرفة طبيعة علاقات الجانحات

11
00:01:24,080 --> 00:01:25,880
!اسأليها إذًا

12
00:01:26,140 --> 00:01:26,930
!ماذا؟

13
00:01:26,930 --> 00:01:28,310
!لديك حبيب؟

14
00:01:28,310 --> 00:01:30,140
!منذ متى تتواعدان؟

15
00:01:31,810 --> 00:01:34,360
.ثـ-ثلاثة شهور

16
00:01:34,550 --> 00:01:37,560
!يعني أنّكما في أعلى درجات الغزل

17
00:01:36,250 --> 00:01:37,560
!اصمتي

18
00:01:38,230 --> 00:01:39,300
ما الذي تحبينه فيه؟

19
00:01:39,300 --> 00:01:40,170
كيف بدأتما بالمواعدة؟

20
00:01:40,170 --> 00:01:41,400
!من يهمّه هذا؟

21
00:01:41,530 --> 00:01:43,360
نحن نهتم! صحيح؟ صحيح؟

22
00:01:43,360 --> 00:01:45,420
.حسنًا، لم تخبرنا من قبل

23
00:01:45,420 --> 00:01:46,360
!أنتِ

24
00:01:47,900 --> 00:01:50,540
!حسنًا! لنسمع ما لديها

25
00:01:50,540 --> 00:01:50,870
!ماذا؟

26
00:01:51,940 --> 00:01:54,580
!هيّا! لدينا الكثير من الوقت

27
00:01:56,900 --> 00:01:59,620
.هو من طلب مواعدتي

28
00:01:59,620 --> 00:02:00,930
!كيف فعلها؟

29
00:02:00,930 --> 00:02:04,860
.قـ-قال "أحبّك منذ أوّل مرّة تقابلنا

30
00:02:05,270 --> 00:02:07,280
"هلّا واعدتِني؟

31
00:02:07,280 --> 00:02:09,390
!ها هو! أكثر ما هو متداولٌ به

32
00:02:09,390 --> 00:02:12,040
"!الـ"أحبّك منذ أوّل مرّة تقابلنا

33
00:02:12,040 --> 00:02:13,390
.إنّك تستمتعين بهذا أكثر من اللازم

34
00:02:13,390 --> 00:02:15,520
!ما كان ردّك إذًا؟

35
00:02:15,520 --> 00:02:16,540
...حسنًا

36
00:02:16,540 --> 00:02:18,270
".حسنًا، لا أمانع"

37
00:02:18,270 --> 00:02:20,990
كلّ شجاعته وبسالته كسبت
!ردًّا ضعيفًا كهذا؟

38
00:02:20,990 --> 00:02:24,110
أ-أنا كنت أحبّه منذ وقت
...طويل أيضًا، لذا تفاجأت

39
00:02:24,110 --> 00:02:25,800
!أيّتها البريئة

40
00:02:27,470 --> 00:02:29,650
!قبلة؟ هل قبّلتما بعضكما؟

41
00:02:30,240 --> 00:02:32,460
!بـ-بالطبع لا

42
00:02:32,460 --> 00:02:34,200
أأمسكتما يد بعضكما على الأقل؟

43
00:02:34,200 --> 00:02:35,830
!وكأنّ بإمكاني فعل شيء كهذا

44
00:02:37,890 --> 00:02:39,840
أأخبرته أنّك تحبينه حتّى الآن؟

45
00:02:41,990 --> 00:02:43,280
.هذا محرج للغاية

46
00:02:44,110 --> 00:02:47,140
!هنالك حدود لنقائك

47
00:02:48,160 --> 00:02:49,760
،لم تقبلا بعضكما، ولم تمسكا بيد بعضكما

48
00:02:49,760 --> 00:02:51,830
!ولم تخبريه عن مشاعرك حتّى؟

49
00:02:51,830 --> 00:02:55,020
...لـ-لكني قلت أنّي سأواعده

50
00:02:55,250 --> 00:02:58,490
يشعر الصبيان بالقلق إن
!لم تتحدثي معهم

51
00:02:58,490 --> 00:03:01,830
هذه العلاقة في طريقها للانهيار
من تلقاء نفسها

52
00:03:01,830 --> 00:03:02,360
!مستحيل

53
00:03:02,360 --> 00:03:05,520
.من وجهة نظري، أشفق على حبيبك

54
00:03:05,520 --> 00:03:07,390
.أنا أعتقد ذلك أيضًا

55
00:03:07,390 --> 00:03:08,240
.ربّما

56
00:03:08,240 --> 00:03:09,040
.خذي إذًا

57
00:03:09,210 --> 00:03:11,190
.أخبريه. الآن

58
00:03:11,190 --> 00:03:11,700
!ماذا؟

59
00:03:11,980 --> 00:03:14,220
!أرسلي حبّك بأسرع وقت

60
00:03:14,870 --> 00:03:17,290
.لـ-لا يمكنني فعل هذا

61
00:03:17,290 --> 00:03:19,500
!هذا من أجل حبيبك

62
00:03:24,370 --> 00:03:28,000
!لحظة، لا يمكنني فعلها علنًا

63
00:03:37,870 --> 00:03:40,610
...إ-إنّها أنا

64
00:03:42,520 --> 00:03:45,580
!أ...أحبّك، حسنًا؟

65
00:03:45,800 --> 00:03:47,900
!أنا كنت أحبّك طوال الوقت أيضًا

66
00:03:47,900 --> 00:03:49,530
!لذا لا تتركني أرجوك

67
00:03:53,160 --> 00:03:54,620
...قلتها

68
00:03:56,000 --> 00:03:56,490
ماذا؟

69
00:03:56,490 --> 00:03:57,290
!ماذا؟

70
00:03:57,290 --> 00:03:58,420
...تحديق

71
00:03:59,350 --> 00:04:01,220
!كان ذلك ظريفًا

72
00:04:01,220 --> 00:04:04,170
تبدين كجانحة، ولكنّك
!عذراء حقًّا من الداخل

73
00:04:04,390 --> 00:04:06,630
"!أنا كنت أحبّك طوال الوقت أيضًا"

74
00:04:06,630 --> 00:04:07,330
!أنتِ

75
00:04:08,340 --> 00:04:11,720
"!لذا ابقَ معي دائمًا"

76
00:04:11,720 --> 00:04:13,900
!توقفي

77
00:04:21,450 --> 00:04:22,380
!حسنًا

78
00:04:22,380 --> 00:04:24,840
لنشترِ الكثير من الحلوى
!ونذهب في رحلة ميدانيّة

79
00:04:24,840 --> 00:04:25,860
!الكثير

80
00:04:25,860 --> 00:04:28,770
.إنّها رحلتنا المدرسية نحن

81
00:04:28,770 --> 00:04:29,940
.لا يهم

82
00:04:29,940 --> 00:04:31,120
ماذا ستشتري؟

83
00:04:31,120 --> 00:04:33,460
—أفكّر بالشوكولاتة، البطاطس، و

84
00:04:33,460 --> 00:04:34,160
!يا صبيان

85
00:04:34,500 --> 00:04:36,530
!لا تستخفوا بحلويّات الرحلات الميدانيّة

86
00:04:36,530 --> 00:04:37,040
ماذا؟

87
00:04:37,500 --> 00:04:40,660
ستكون في ورطة لو
!أسأت الاختيار

88
00:04:40,660 --> 00:04:41,270
!ماذا؟

89
00:04:41,270 --> 00:04:42,210
ماذا تقصدين؟

90
00:04:42,210 --> 00:04:45,750
.ستشعر بتعاسة شديدة

91
00:04:45,750 --> 00:04:46,800
!لم أفهم

92
00:04:46,800 --> 00:04:50,600
لأنّ يمكن أن تذوب الشوكولاتة
!وأن تتكسّر البطاطس في حقيبتك

93
00:04:50,780 --> 00:04:54,410
!وسينفد مخزونك إلّم تملك ما يكفي

94
00:04:54,990 --> 00:04:56,300
.فهمت

95
00:04:56,300 --> 00:05:01,920
هذا يعني أنّه علينا موازنة الجودة
،والكميّة بميزانيّة 300 ين

96
00:05:01,920 --> 00:05:04,810
أثناء التخطيط مقدمًا لحالة الجو
!ومعاملة الأمتعة

97
00:05:06,230 --> 00:05:07,630
هلّا استخدمت كلمات أبسط؟

98
00:05:07,630 --> 00:05:08,690
!كانت كلمات بسيطة

99
00:05:08,690 --> 00:05:11,440
أنتِ غبيّة يا يوشيكو، لكنّنا
.نفهم ما تقولينه

100
00:05:11,440 --> 00:05:13,530
.علينا التفكير قبل الشراء

101
00:05:14,280 --> 00:05:14,980
!احذروا

102
00:05:15,390 --> 00:05:18,890
يخلط هذا المتجر الأشياء
!الغالية مع الأشياء الرخيصة

103
00:05:18,890 --> 00:05:23,040
يا إلهي! بوتشي اللوز
!المكسر الخارق! 300 ين

104
00:05:23,040 --> 00:05:26,430
!لا يمكنك شراء شيء آخر لو اشتريت هذا

105
00:05:26,430 --> 00:05:30,010
ولكن إن وضعته بين تلك الأشياء
!الرخيصة، فسيبدو لذيذًا أكثر

106
00:05:30,280 --> 00:05:31,220
...لا يمكن

107
00:05:31,220 --> 00:05:32,140
.وميض

108
00:05:32,140 --> 00:05:35,060
غرست هذا الفخ لتفرّغ
!محافظ الأطفال المساكين

109
00:05:35,060 --> 00:05:36,550
!يا لها من عجوزة ماكرة

110
00:05:36,820 --> 00:05:38,480
...لـ-لكن أنا

111
00:05:38,480 --> 00:05:40,640
...لن أقع...

112
00:05:41,370 --> 00:05:43,640
...في فخٍ واضح كهذا...

113
00:05:43,640 --> 00:05:45,470
.إنّه يبدو لذيذًا

114
00:05:45,470 --> 00:05:46,370
!إنّك ضعيفة

115
00:05:48,720 --> 00:05:50,270
.لا تملكين ما يكفي

116
00:05:50,270 --> 00:05:51,940
!هل أنتِ طالبة ثانويّة حقًّا؟

117
00:05:51,940 --> 00:05:53,490
.اترك يوشيكو وشأنها

118
00:05:53,490 --> 00:05:54,720
!صحيح

119
00:05:54,720 --> 00:05:55,320
!حسنًا

120
00:05:55,320 --> 00:05:58,630
!سآخذ علكة لمتعة طويلة الأمد

121
00:05:59,000 --> 00:06:00,420
!وأنا سآخذ حلوى يابسة لنفس الغرض

122
00:06:00,420 --> 00:06:01,830
ماذا عنكِ يا نوزومي؟

123
00:06:01,830 --> 00:06:03,540
.اشتريت هذا

124
00:06:03,540 --> 00:06:06,180
!بوتشي اللوز المكسّر الخارق؟

125
00:06:06,450 --> 00:06:08,810
!ماذا؟! هل اشتريتِ هذا يا نوزومي-تشان؟

126
00:06:08,810 --> 00:06:10,170
!بدا لذيذًا للغاية

127
00:06:10,170 --> 00:06:11,560
...لا

128
00:06:11,560 --> 00:06:12,890
...بهذا المعدّل

129
00:06:17,980 --> 00:06:20,130
...ليس لديّ ما يكفي من الحلوى

130
00:06:20,130 --> 00:06:23,770
سيسود الحزن في رحلة
.نوزومي-تشان الميدانيّة

131
00:06:24,450 --> 00:06:27,130
!تبدو حلوى نوزومي-تشان لذيذة

132
00:06:27,690 --> 00:06:30,120
أتريدين تبادل واحدة منك بواحدة مني؟

133
00:06:30,390 --> 00:06:32,730
!أيمكن أنّها تسعى للتبادل؟

134
00:06:32,730 --> 00:06:34,510
!صحيح

135
00:06:34,510 --> 00:06:39,680
بوتشي اللوز المكسّر الخارق سيلفت
!الانتباه بشدّة من بين حلويّات الأطفال الرخيصة

136
00:06:39,680 --> 00:06:43,470
إن بادلت عصا بوتشي اللوز المكسّر الخارق
...بالحلويّات الأخرى

137
00:06:44,030 --> 00:06:45,490
!فيمكنها أخذ أيّ شيء...

138
00:06:45,490 --> 00:06:51,400
عصا واحدة من بوتشي اللوز المكسّر الخارق
!يمكن مبادلتها بخمس، لا، بعشر حبّات شوكولاتة

139
00:06:51,400 --> 00:06:53,190
!عشر حبّات شوكولاتة

140
00:06:53,880 --> 00:06:55,040
...مخيف

141
00:06:55,640 --> 00:06:56,770
...لديها

142
00:06:56,770 --> 00:06:58,610
.عقليّة الشيطان بنفسه...

143
00:06:59,740 --> 00:07:02,510
لم أعلم أنّ اختيار الحلوى
.قد يكون بهذا العمق

144
00:07:02,510 --> 00:07:05,640
.استهنّا بمقدرة نوزومي

145
00:07:05,640 --> 00:07:08,340
أتريدونه إلى هذه الدرجة؟

146
00:07:08,340 --> 00:07:10,440
!كيف تجرؤين على التظاهر بالجهل؟

147
00:07:10,870 --> 00:07:13,770
!سأعطي واحدة لكلّ واحدٍ منكم

148
00:07:13,770 --> 00:07:15,960
!مرحى

149
00:07:16,210 --> 00:07:17,370
!خذا أيضًا

150
00:07:17,370 --> 00:07:18,920
هـ-هل أنتِ متأكّدة؟

151
00:07:18,920 --> 00:07:20,100
!نعم

152
00:07:20,100 --> 00:07:21,190
...إنّها ملاك

153
00:07:29,010 --> 00:07:30,460
.أكتسو-كن

154
00:07:30,900 --> 00:07:33,070
.يشعر قلبي بالطمأنينة عندما تكون قريبًا

155
00:07:33,070 --> 00:07:35,110
.أريد أن أكون بقربك دائمًا

156
00:07:38,100 --> 00:07:41,190
.الشاي لذيذ يا أكورو-سان

157
00:07:41,190 --> 00:07:42,730
،الشاي لذيذ

158
00:07:44,440 --> 00:07:48,260
.ولكنّ جسدك ألذ شيءٍ في العالم

159
00:07:48,600 --> 00:07:51,370
!ألا تعرف رغبتك الجنسيّة عمرًا؟

160
00:07:54,730 --> 00:07:56,500
ما الذي أردتِ التحدّث معي بشأنه؟

161
00:07:57,440 --> 00:08:00,280
...قد يكون من الأفضل أن تتوقّفي عن الملاحقة

162
00:08:00,280 --> 00:08:01,230
!ماذا؟

163
00:08:01,230 --> 00:08:04,860
إنّي أراقب لأتأكد أنّ أكتسو-كن
!لا يخترق اللوائح

164
00:08:04,860 --> 00:08:07,280
في المقام الأوّل، ليس
!لديّ سبب لملاحقته

165
00:08:07,280 --> 00:08:09,790
أنت تحبّين آ-كن-سان، صحيح؟

166
00:08:11,340 --> 00:08:13,130
كيف عرفتِ؟

167
00:08:13,130 --> 00:08:14,840
.هذا واضحٌ للجميع

168
00:08:15,070 --> 00:08:16,510
!مـ-ما الذي تتحدثين عنه؟

169
00:08:16,510 --> 00:08:17,830
—أكتسو-كن مجرّد

170
00:08:17,830 --> 00:08:19,320
،إنّه لطيفٌ أحيانًا

171
00:08:19,320 --> 00:08:22,270
لكنّه ينظر للناس بنظرة ساخطة
...ويقسو على الجميع وساديٌّ جدًّا

172
00:08:22,270 --> 00:08:23,950
ولكن هذا ما تحبينه فيه؟

173
00:08:23,950 --> 00:08:25,320
!لا يمكنني الاكتفاء منه

174
00:08:25,970 --> 00:08:28,260
!وقعت في فخّها

175
00:08:27,340 --> 00:08:28,940
...ردّة فعلها مبالغة لكل شيء

176
00:08:28,940 --> 00:08:34,140
،قد يكون من الأفضل أن تتصرّفي بجهد
.هدوء، وسويّة أمام أ-كن-سان

177
00:08:34,140 --> 00:08:34,610
ماذا؟

178
00:08:34,880 --> 00:08:37,620
تعنين أنّي ملائمة تمامًا له؟

179
00:08:37,620 --> 00:08:38,410
ماذا؟

180
00:08:39,790 --> 00:08:42,930
ألا تفقدين هدوءك دائمًا وتحدثين جلبة؟

181
00:08:42,930 --> 00:08:45,080
.حتى أنكِ تسللتِ إلى فراش آ-كن-سان من قبل

182
00:08:45,080 --> 00:08:48,150
.لحماية أكتسو-كن من مكائد هاناباتاكي-سان

183
00:08:48,150 --> 00:08:49,650
.حاولتِ اختلاس النظر إليه في الحمّام

184
00:08:49,650 --> 00:08:52,160
فعلت ذلك من أجله. عليه
.أن يحبني أكثر لأجل ذلك

185
00:08:53,740 --> 00:08:54,900
.فات الأوان

186
00:08:54,900 --> 00:08:56,010
ما هذه النظرة؟

187
00:08:56,010 --> 00:08:59,100
!أ-أفعل شيئًا غريبًا؟

188
00:08:59,100 --> 00:09:02,750
إ-إذًا ما هي نظرة آ-كن-سان لك برأيك؟

189
00:09:02,750 --> 00:09:05,550
كسينباي قدوة وجميلة، صحيح؟

190
00:09:06,430 --> 00:09:09,600
.قد تبقيك تلك الإيجابيّة سعيدة طوال حياتك

191
00:09:09,600 --> 00:09:11,310
حقًّا، ما هذه النظرة؟

192
00:09:12,050 --> 00:09:13,960
كيف يراني حقًّا؟

193
00:09:13,960 --> 00:09:14,810
!أخبريني

194
00:09:15,030 --> 00:09:19,020
!أريد الحقيقة! يمكنني تقبلها

195
00:09:20,460 --> 00:09:23,690
.يراك كمهووسة مجنونة

196
00:09:26,620 --> 00:09:27,460
...ذلك

197
00:09:27,460 --> 00:09:28,910
!مستحيل...

198
00:09:28,910 --> 00:09:30,090
!ترفض تقبّل الحقيقة؟

199
00:09:30,370 --> 00:09:33,580
لا، ولكن قد يكون ذلك أفضل لها؟

200
00:09:33,580 --> 00:09:34,120
مـ-ماذا؟

201
00:09:34,120 --> 00:09:37,270
كانت تلك مزحة... صحيح؟

202
00:09:39,560 --> 00:09:41,010
لم تكن كذلك؟

203
00:09:42,940 --> 00:09:44,010
...إذًا

204
00:09:44,250 --> 00:09:46,060
...عندما تسللت إلى غرفته

205
00:09:46,060 --> 00:09:47,440
.كانت تلك جريمة

206
00:09:47,440 --> 00:09:48,680
...واختلست النظر في الحمّام

207
00:09:48,680 --> 00:09:50,080
.جريمة أيضًا

208
00:09:50,600 --> 00:09:51,580
.سأموت

209
00:09:51,580 --> 00:09:52,140
ماذا؟

210
00:09:52,400 --> 00:09:56,640
.لا... لقد مُتّ بالفعل كامرأة

211
00:09:57,090 --> 00:09:58,990
مـ-ماذا أفعل؟

212
00:09:59,350 --> 00:10:01,300
!أ-أمزح فحسب

213
00:10:01,300 --> 00:10:02,410
!كانت مزحة

214
00:10:02,410 --> 00:10:03,210
ماذا؟

215
00:10:03,210 --> 00:10:04,250
حـ-حقًّا؟

216
00:10:04,250 --> 00:10:06,450
ما رأيه بي إذًا؟

217
00:10:06,450 --> 00:10:08,290
.إ-إنّه على وشك الوقوع في حبّك

218
00:10:08,290 --> 00:10:09,790
!كما توقّعت

219
00:10:13,290 --> 00:10:14,660
ماذا أفعل؟

220
00:10:21,000 --> 00:10:22,830
!مرحبًا يا جرو

221
00:10:23,620 --> 00:10:25,820
ساياكا-تشان، ألديك كلب؟

222
00:10:25,820 --> 00:10:27,220
.لدينا واحد

223
00:10:27,220 --> 00:10:28,370
.بوميرانيان

224
00:10:28,370 --> 00:10:29,180
!حقًّا؟

225
00:10:29,180 --> 00:10:30,310
!دعيني أركبها

226
00:10:30,770 --> 00:10:32,640
...لـ-لا يمكنك ركوبها

227
00:10:32,640 --> 00:10:35,280
ماذا؟ لماذا تحتفظين بها إذًا؟

228
00:10:35,280 --> 00:10:36,600
!لأنّها ظريفة؟

229
00:10:38,050 --> 00:10:39,140
!لقد عدت

230
00:10:41,990 --> 00:10:44,320
.ها هي، إنّها بومي-تشان

231
00:10:44,320 --> 00:10:45,820
!آه، بومي-تشان

232
00:10:46,940 --> 00:10:48,160
أليست ظريفة؟

233
00:10:48,160 --> 00:10:49,660
.تبدو ضعيفة للغاية

234
00:10:49,660 --> 00:10:50,700
!تعنين "ظريفة" أليس كذلك؟

235
00:10:50,700 --> 00:10:53,710
.إنّها لا تعرف حجم وقسوة العالم

236
00:10:53,710 --> 00:10:55,460
!انظروا من يتحدّث

237
00:11:00,330 --> 00:11:02,970
ما هذا الوجه المتشنّج؟

238
00:11:02,970 --> 00:11:03,970
...أيمكن

239
00:11:03,970 --> 00:11:04,900
!ستقتلها؟

240
00:11:04,900 --> 00:11:05,500
!يقتل من؟

241
00:11:11,930 --> 00:11:13,280
!مـ-ما الخطب؟

242
00:11:13,280 --> 00:11:14,920
!ما الذي يرعبك؟

243
00:11:18,680 --> 00:11:20,690
!إنّه يرتجف خوفًا

244
00:11:22,350 --> 00:11:24,820
!قربان كإكرام أملًا بالسلام؟

245
00:11:28,740 --> 00:11:30,070
!ولكنّها ترفض

246
00:11:30,500 --> 00:11:31,620
!يا إلهي

247
00:11:31,620 --> 00:11:34,440
!بومي-تشان هي من تريد القتال

248
00:11:34,440 --> 00:11:35,830
أليست ظريفة؟

249
00:11:35,830 --> 00:11:37,190
...لـ-لا يمكن

250
00:11:37,190 --> 00:11:38,710
!أهي بهذه القوّة؟

251
00:11:39,510 --> 00:11:40,500
!هـ-ها هي قادمة

252
00:11:40,500 --> 00:11:42,300
!كن حذرًا يا كلب

253
00:11:42,300 --> 00:11:44,340
!ستموت إن أرخيت دفاعك

254
00:11:51,370 --> 00:11:52,990
!كلب

255
00:11:52,990 --> 00:11:54,800
ماذا فعلتْ لك؟

256
00:11:55,520 --> 00:11:57,310
!تماسك

257
00:11:57,810 --> 00:12:00,180
!ا-استسلم؟

258
00:12:00,530 --> 00:12:02,350
.مـ-مستحيل

259
00:12:02,350 --> 00:12:05,500
.كلبي العزيز خسر

260
00:12:05,500 --> 00:12:08,070
.آمل أن تتوافق مع بومي-تشان

261
00:12:08,280 --> 00:12:11,660
.أنا آسفة يا ساياكا-تشان، كنت مخطئة

262
00:12:11,660 --> 00:12:12,160
ماذا؟

263
00:12:12,350 --> 00:12:14,330
!بومي-تشان كلبة مذهلة

264
00:12:15,210 --> 00:12:16,890
أعرفتِ ذلك الآن؟

265
00:12:17,790 --> 00:12:20,930
!سحقًا

266
00:12:25,810 --> 00:12:28,560
!الحلقة القادمة: احتفال! الفتاة الحمقاء