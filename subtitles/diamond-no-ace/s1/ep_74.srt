1
00:00:03,440 --> 00:00:04,940
!دعوها لي

2
00:00:06,380 --> 00:00:06,940
!ها هي ذي

3
00:00:06,940 --> 00:00:08,510
!خرج واحد ، [تانبا]

4
00:00:08,510 --> 00:00:10,320
!لست سيئاً. أحسنت الرميّ

5
00:00:11,760 --> 00:00:14,200
.أجل ، لقد انتصرتُ على [فوريا]

6
00:00:17,290 --> 00:00:18,140
،]زونو]

7
00:00:18,140 --> 00:00:19,830
أولستَ الضارب التالي؟

8
00:00:20,820 --> 00:00:22,280
.أ-أنا آسف

9
00:00:26,480 --> 00:00:27,970
ما هذا بحق الجحيم؟

10
00:00:30,690 --> 00:00:32,810
.لم تُخبرنا بأيّ شيء

11
00:02:04,090 --> 00:02:07,830
الضوء المرشد

12
00:02:11,640 --> 00:02:13,560
لعبةٌ مضاعفة؟

13
00:02:13,560 --> 00:02:15,020
.يالها من خسارة

14
00:02:15,020 --> 00:02:18,150
.لم يخرج أي لاعب ، والعدّاء على القاعدة الأولى ، هذا كثيرٌ جداً

15
00:02:18,150 --> 00:02:20,520
!افعلوا ما أمرناكم بهِ أيّها الأغبياء

16
00:02:20,520 --> 00:02:22,480
أتودّون التسجيل حقاً؟

17
00:02:22,480 --> 00:02:24,650
!لأني لا أشعرُ برغبتكم في ذلك

18
00:02:25,040 --> 00:02:26,180
.معك حق

19
00:02:27,030 --> 00:02:29,540
.مواجهتكم سهلةٌ جداً

20
00:02:31,220 --> 00:02:33,620
لم تستطع فعل شيء ، أليس كذلك؟

21
00:02:34,180 --> 00:02:35,400
.لقد كان خصماً صعباً بالنسبة لك

22
00:02:35,400 --> 00:02:36,270
![ميوكي]

23
00:02:41,160 --> 00:02:43,150
هل سمعت بالأمر؟

24
00:02:45,120 --> 00:02:46,090
ماذا؟

25
00:02:54,180 --> 00:02:56,680
!ما الذي تفعلونه؟ عودوا إلى الملعب

26
00:02:57,740 --> 00:02:59,690
.حاضر ، سنأتي على الفور

27
00:03:02,180 --> 00:03:03,440
.هيّا بنا

28
00:03:04,670 --> 00:03:06,260
ما خطبك؟

29
00:03:06,690 --> 00:03:08,450
أوَ لا يُزعجك الأمر؟

30
00:03:08,990 --> 00:03:11,210
كُنت تعلمُ بذلك ، أليس كذلك؟

31
00:03:11,210 --> 00:03:13,450
ماذا؟ ما الذي تقوله؟

32
00:03:13,980 --> 00:03:16,380
،لم أكن أعلم ، توقعتُ ذلك فقط

33
00:03:16,380 --> 00:03:19,900
.لأن مساعد المدرب ليس من مدرستنا

34
00:03:22,220 --> 00:03:25,460
.أنا لن أُبدّل الرامي الأساسي مهما حدث

35
00:03:25,960 --> 00:03:29,970
توضّحت الأمور لديه

36
00:03:27,600 --> 00:03:29,450
!لهذا قال ذلك

37
00:03:30,480 --> 00:03:33,580
.على أيّ حال ، سنؤجّلُ حديثنا هذا لوقتٍ آخر

38
00:03:33,580 --> 00:03:35,700
.فالنجعل تركيزنا ينصبّ على المُباراة الآن

39
00:03:36,110 --> 00:03:38,930
.السنباي تكّبدوا عناء لعِب هذه المُباراة من أجلنا

40
00:03:45,200 --> 00:03:46,890
...بعد الخريف

41
00:03:48,900 --> 00:03:50,940
المدربُ سيستقيل؟

42
00:03:52,000 --> 00:03:54,410
...ألهذا السبب قام السنباي

43
00:03:54,410 --> 00:03:58,140
بتقديم مُباراة التقاعد ولعبها الآن؟

44
00:04:00,720 --> 00:04:04,860
ما الذي بإمكاننا تقديمه كونُنا الفريق الأساسيّ الجديد؟

45
00:04:05,360 --> 00:04:09,720
ما الذي يُمكننا تقديمه بعد كل ما فعله السنباي والمدرب؟

46
00:04:14,980 --> 00:04:18,200
أعادةً ما تحدثُ مثلُ هذه الأمور يا [كانيماور]؟

47
00:04:19,240 --> 00:04:22,300
،حسنٌ ، بالتأكيد تحدثُ مثل هذه الأمور لمدارس أخرى

48
00:04:22,900 --> 00:04:26,880
.خاصّة تلك المدارس التي تضع الفوز بالكوشين هدفاً نُصب عينيّها

49
00:04:28,180 --> 00:04:29,100
.لقد تأخّرتم

50
00:04:29,100 --> 00:04:30,030
.نحنُ آسفون

51
00:04:31,000 --> 00:04:33,380
،نحنُ ما زلنا طُلاباً في السنة الأولى

52
00:04:33,380 --> 00:04:35,290
،ولأكون صادقاً

53
00:04:35,290 --> 00:04:38,040
.لا أعلمُ كيف تسيرُ مثل هاتهِ الأمور

54
00:04:38,700 --> 00:04:42,540
.لكنّي متأكّدٌ من شيءٍ واحد فقط

55
00:04:44,180 --> 00:04:45,300
...أنا

56
00:04:46,990 --> 00:04:48,170
...أنا

57
00:04:49,960 --> 00:04:52,700
.لم أجعلهُ يعترف بي حتّى الآن

58
00:04:56,420 --> 00:04:57,300
!حسنٌ

59
00:04:57,870 --> 00:04:59,060
!رميةٌ أخيرة

60
00:05:00,590 --> 00:05:03,190
.مهما كان وضعُ الفريق سيّئاً ، حافظ على رباطة جأشك

61
00:05:04,340 --> 00:05:07,360
.إن بدا القائدُ يائساً ، فسوف يؤثّر ذلك على الفريق بأكمله

62
00:05:07,850 --> 00:05:10,700
...أقوالُك ، أفعالُك

63
00:05:10,700 --> 00:05:13,590
.الفريقُ يُراقبها ويتأثّر بها

64
00:05:14,250 --> 00:05:16,370
.لا تنسى ذلك أبداً

65
00:05:17,370 --> 00:05:20,080
.عليك قيادةُ الفريق بالشكل الصحيح

66
00:05:25,620 --> 00:05:28,380
طلاب السنة الأولى والثانية
طلاب السنة الثالثة

67
00:05:26,580 --> 00:05:28,380
!والآن فالنُنهيها

68
00:05:28,380 --> 00:05:31,790
،جميعهم يبدون نائمين

69
00:05:31,790 --> 00:05:33,630
!لذا فالتوقظهم ، [ساكاي]

70
00:05:33,630 --> 00:05:34,880
.أجل

71
00:05:34,880 --> 00:05:36,770
!خصوصاُ ذلك الراميّ

72
00:05:36,770 --> 00:05:39,320
!إنّه لا يستطيع حتّى رميّ الكُرة حيث يريد

73
00:05:39,320 --> 00:05:41,390
!لذا فالتُنهي أمرهُ الآن

74
00:05:42,990 --> 00:05:45,450
،مع أنّها مُباراةُ أمام الطلاب الأصغر سنّاً

75
00:05:45,450 --> 00:05:47,450
.إلّا أن السنباي يلعبون بكل ما لديهم حقاً

76
00:05:47,450 --> 00:05:50,150
.إنّهم يلعبون كما لو أنّهم في منتصف الموسم

77
00:05:50,470 --> 00:05:52,820
!اقضوا على أولئك الفتية

78
00:05:52,820 --> 00:05:54,900
!الفتية؟

79
00:05:55,920 --> 00:05:57,000
![فوريا]

80
00:05:57,780 --> 00:06:00,720
!لا تقلق بشأن إيقاعك في الرميّ بعد الآن

81
00:06:00,720 --> 00:06:01,790
!ارمي بكلّ ما لديك فقط

82
00:06:03,830 --> 00:06:07,780
،أنت تُواجه ضاربين ليس من السّهل إخراجهم

83
00:06:07,780 --> 00:06:09,850
،لذا لا تقلق بشأن إيقاعك

84
00:06:09,850 --> 00:06:12,800
!وارمي أفضل الرّميات لديك

85
00:06:12,800 --> 00:06:14,200
!أوي! أوي

86
00:06:14,200 --> 00:06:16,600
!يقول له أن لا يُفكر بإقاعه؟

87
00:06:16,600 --> 00:06:18,800
.هذا غريبٌ عليه

88
00:06:20,220 --> 00:06:23,810
!دعونا نسحق طلاب السنة الثالثة

89
00:06:28,810 --> 00:06:32,660
،سوف نُواجههم مواجهة رجلٍ لـ رجل

90
00:06:32,660 --> 00:06:36,180
!لذا أعتمدُ عليكم في إلتقاط الرّميات

91
00:06:37,820 --> 00:06:39,850
هل جُننت يا هذا؟

92
00:06:39,850 --> 00:06:41,950
،[فوريا] سيفقد تركيزه

93
00:06:41,950 --> 00:06:44,080
.وسيتحوّل إلى غبيّ آخر لا غير

94
00:06:44,220 --> 00:06:49,580
الغبي الحقيقيّ

95
00:06:44,490 --> 00:06:45,720
!صحيح ، صحيح

96
00:06:45,720 --> 00:06:49,580
!أعطنا تعليماتٍ صحيحةً كالقائد الحقيقيّ ولو لمرّةٍ واحدة

97
00:06:49,960 --> 00:06:52,090
!هاتِ ما لديك ، [ميوكي]

98
00:06:52,090 --> 00:06:54,340
!سوف نُطيحُ بكم لا محالة

99
00:06:54,340 --> 00:06:57,260
!ولستم في حاجة لإلتقاط الرّميات

100
00:07:15,790 --> 00:07:18,360
!غير معقول

101
00:07:18,360 --> 00:07:20,220
!إخراجان على التواليّ

102
00:07:20,220 --> 00:07:22,370
!ولم يصل أحدهم لأي قاعدة في هذا الشوط

103
00:07:23,460 --> 00:07:26,600
!هذه رمياتُ [فوريا] السريعة إذن

104
00:07:26,600 --> 00:07:28,370
.بدأت المُباراةُ تًصبحُ ممتعةً أكثر

105
00:07:28,980 --> 00:07:30,570
هل أنتم أغبياء؟

106
00:07:30,570 --> 00:07:32,690
!جميعُ الرّميات كانت منخفضةً كثيراً

107
00:07:32,690 --> 00:07:34,450
![فوريا] ، ضع هالتك حانباً

108
00:07:34,450 --> 00:07:37,280
أنت لا تُخطط بأن يستمر بالرميّ هكذا ، أليس كذلك؟

109
00:07:37,280 --> 00:07:38,750
.بالتأكيد سأجعلهُ يستمرّ

110
00:07:38,750 --> 00:07:39,400
ماذا؟

111
00:07:40,020 --> 00:07:42,580
!من المستحيل أن تنجح هذه الخطّة أمام ضاربين كهؤلاء

112
00:07:42,580 --> 00:07:43,880
!هذا تهوّر كبير

113
00:07:45,100 --> 00:07:47,640
لكن

114
00:07:46,040 --> 00:07:47,640
أوليست خطةً مثيرة؟

115
00:07:52,390 --> 00:07:55,760
،أعلمُ مدى صعوبة سماع إستقالة المدرب

116
00:07:56,640 --> 00:07:59,150
.لكنّنا في مباراةٍ الآن

117
00:07:59,540 --> 00:08:00,900
!هيّا بنا

118
00:08:00,900 --> 00:08:04,190
،السنباي يلعبون بكل جدّية

119
00:08:04,190 --> 00:08:07,910
أوليسَ من واجبنا ردّ ذلك واللّعب بجدّية أيضاً؟

120
00:08:20,000 --> 00:08:21,510
!خرج اثنان

121
00:08:21,860 --> 00:08:26,290
.رمياتُ [تانبا-سان] تبدو صعبةً كثيراً اليوم

122
00:08:26,290 --> 00:08:29,770
.علينا التركيز في رميةٍ واحدة ، وضربها بشكل عدوانيّ

123
00:08:30,410 --> 00:08:32,440
.لا تُفكّر كثيراً

124
00:08:32,440 --> 00:08:35,060
.افعلوا ما تستطيعون فِعله ، وقدّموا كل ما لديكم

125
00:08:35,560 --> 00:08:36,900
،إن أصبح لدينا عدّاء على القاعدة

126
00:08:39,790 --> 00:08:43,030
.دعونا نفعل ما يطلبهُ منّا المدرب عادةً

127
00:08:47,700 --> 00:08:49,450
!إصابة! الضارب للخارج

128
00:08:51,980 --> 00:08:53,980
.[تانبا] يردُّ على [فوريا] بالحصول على إخراجان أيضاً

129
00:08:53,980 --> 00:08:55,520
!إنّهُ بأفضلِ حالاته

130
00:08:55,520 --> 00:08:56,960
.مع انّه يواجه الكوهاي

131
00:08:55,520 --> 00:08:56,960
الكوهاي هم الطلاب الأصغر سنّاً

132
00:08:56,960 --> 00:08:58,290
!أيّها الغبيّ

133
00:08:58,290 --> 00:09:01,030
لمَ لم تستطع فِعل ذلك في البطولة الصيفيّة؟

134
00:09:01,030 --> 00:09:02,970
!لا أكاد أُصدّق أن قدمك قد تشنّجت

135
00:09:03,410 --> 00:09:06,790
!هذا ما خطر لي أيضاً ، اللّعنة

136
00:09:06,790 --> 00:09:08,470
.مع أنك لم ترمي سوى لثلاثة أشواط

137
00:09:08,470 --> 00:09:09,900
!لنغيّر وتيرتنا

138
00:09:09,900 --> 00:09:11,280
!سنلحقُ بهم

139
00:09:11,980 --> 00:09:14,480
طلاب السنة الأولى والثانية
طلاب السنة الثالثة

140
00:09:12,430 --> 00:09:16,980
خرج عدائان
عداء على القاعدة الأولى

141
00:09:12,430 --> 00:09:16,980
الضارب الثالث

142
00:09:18,980 --> 00:09:20,480
![فوريا] ، العدّاء

143
00:09:26,060 --> 00:09:29,240
.يبدو أنّه مركّزٌ كثيراً على العدّاء

144
00:09:29,790 --> 00:09:31,220
أتمزحُ معي؟

145
00:09:31,220 --> 00:09:33,750
!تجعلهُ يواجه [تيتسو-سان] مواجهةً مباشرة

146
00:09:38,660 --> 00:09:40,750
!اضربها بعيداً يا [تيتسو]

147
00:09:40,750 --> 00:09:42,510
!هيّا يا [فوريا]

148
00:09:43,140 --> 00:09:45,890
!فالترمي تلك الرمية التي أطحت فيها بـ [تودوروكي]

149
00:09:45,890 --> 00:09:48,010
.إن رميّتها بمستوىً منخفض ، فسنهزمه

150
00:09:49,620 --> 00:09:50,220
!العدّاء

151
00:10:01,530 --> 00:10:04,280
!لقد أخرج [تيتسو-سان]

152
00:10:04,650 --> 00:10:06,780
!مستحيل ، فوريا! لا ، كان ذلك حظّاً فقط

153
00:10:06,780 --> 00:10:09,110
!سريعةٌ ومنخفضة

154
00:10:07,030 --> 00:10:11,280
.هو الآخر هُزِمَ من فوريا

155
00:10:09,110 --> 00:10:10,740
!أفضل رمية اليوم

156
00:10:10,740 --> 00:10:11,280
!أجل

157
00:10:11,280 --> 00:10:13,790
!إنّها المرة الخامسة التي يُخرج فيها ضارباً

158
00:10:15,180 --> 00:10:17,790
!إنّه يقدّم كل ما لديه من الشوط الخامس

159
00:10:18,220 --> 00:10:21,800
!لوهلةٍ ظننتُ بأن الرمية وميض

160
00:10:21,800 --> 00:10:23,300
ابتسامة

161
00:10:23,300 --> 00:10:31,810
سعيدٌ جداً

162
00:10:23,860 --> 00:10:27,410
،من الجيّد أن خطّتي قد نجحت

163
00:10:27,410 --> 00:10:31,810
.وإلا كان سمح للعدّائين بأن يتقدّموا ، وسيُجنّ حينها

164
00:10:32,270 --> 00:10:33,140
!حسناً

165
00:10:33,140 --> 00:10:34,760
.لقد أخلينا جميع القواعد من العدّائين

166
00:10:34,760 --> 00:10:35,810
!لنفعلها يا [كوروماتشي]

167
00:10:36,230 --> 00:10:38,520
.يبدو أن معنويّاتهم قد ارتفعت الآن

168
00:10:38,520 --> 00:10:42,070
.رميةُ [فوريا-كن] أعادت لهم حماسهم

169
00:10:42,070 --> 00:10:45,570
.وكما قلتُ سابقاً ، إنّه رامٍ ممتاز

170
00:10:45,950 --> 00:10:47,760
![كواكامي] ، [سوامورا]

171
00:10:47,760 --> 00:10:50,320
.ستدخلان في أيّة لحظة ، لذا استعدّا لذلك

172
00:10:51,220 --> 00:10:52,580
!سيتم تبديلي؟

173
00:10:52,970 --> 00:10:54,600
—حسنٌ

174
00:10:53,420 --> 00:10:54,600
!أنا على أتمّ الإستعداد

175
00:10:54,600 --> 00:10:56,080
!أستطيعُ اللّعب الآن لو أردت

176
00:10:56,430 --> 00:10:58,320
!ما زال ذلك مُبكراً

177
00:10:58,320 --> 00:11:01,980
!فرصةُ مواجهة ضاربين كهؤلاء لا تحدث كل يوم

178
00:11:01,980 --> 00:11:02,780
.أنت

179
00:11:02,780 --> 00:11:05,400
!أستطيعُ تفهم إشراكك لـ [كواكامي] ، لكن [سوامورا] أيضاً؟

180
00:11:06,940 --> 00:11:08,560
!لا تحزن! لا تحزن

181
00:11:07,940 --> 00:11:09,340
تجاهل

182
00:11:09,860 --> 00:11:10,770
!عملٌ جيّد

183
00:11:10,770 --> 00:11:12,600
!قدّمت عملاً جيّداً

184
00:11:13,500 --> 00:11:14,700
.أجل

185
00:11:14,700 --> 00:11:17,490
.أُريدهُ أن يواجه خصماً كهذا الآن

186
00:11:18,080 --> 00:11:20,760
.إنّهُ يحتاج لذلك من أجل مستقبله

187
00:11:24,440 --> 00:11:26,360
،في العطلة الصيفيّة

188
00:11:27,090 --> 00:11:28,860
!لم تسِر الأمور على ما يُرام

189
00:11:29,260 --> 00:11:33,430
.ولأكون صادقاً ، كان قلقي يزداد كل يوم

190
00:11:34,760 --> 00:11:39,420
.لكن بعد أن علِمتُ بشأن المدرب ، أصبحت الأمور أكثر سهولة

191
00:11:41,500 --> 00:11:44,040
.دعونا نفوز بـ بطولة الخريف

192
00:11:46,700 --> 00:11:48,550
ما الذي تقولهُ فجأةً؟

193
00:11:48,900 --> 00:11:51,390
،لم يتم تحديد المجموعات حتى الآن

194
00:11:51,860 --> 00:11:54,550
.ولرّبما هذا يُشكّلُ ضغطاً على الفريق

195
00:11:55,720 --> 00:11:58,220
،لكن إذا فزنا بـ بطولة الخريف

196
00:11:58,820 --> 00:12:00,740
.فسنذهب للكوشين

197
00:12:08,660 --> 00:12:14,580
،لا أعلمُ ما إن كان المدرّب أو المدرسة هي من قرّرت أمر الإستقالة

198
00:12:15,830 --> 00:12:18,620
،لكن إن وصلنا للكوشين

199
00:12:19,150 --> 00:12:20,940
.فلن يستقيل المدرب

200
00:12:31,730 --> 00:12:32,930
!أجل ، هذه هي

201
00:12:32,930 --> 00:12:34,930
![كوراموتشي] ، أحسنت باستخدام المضرب

202
00:12:36,250 --> 00:12:38,430
.تبّاً ، ذلك الوغد

203
00:12:38,810 --> 00:12:41,180
!دعونا نستغلّ هذه الفرصة

204
00:12:41,940 --> 00:12:44,740
،لكن إن وصلنا للكوشين

205
00:12:45,350 --> 00:12:47,070
.فلن يستقيل المدرب

206
00:12:48,180 --> 00:12:49,940
أتقول الفوز؟

207
00:12:50,500 --> 00:12:52,700
.الأمرُ ليسَ بتلك السهولة

208
00:12:54,380 --> 00:12:56,200
!الكوشين

209
00:12:57,580 --> 00:12:58,200
!"ستيل"

210
00:12:57,580 --> 00:12:58,200
.مصطلح يُشير إلى تقدّم عدّاء لقاعدة ليست مخصّصة له

211
00:12:59,450 --> 00:13:01,390
بعد التقاط كل تلك الرميات؟

212
00:13:01,390 --> 00:13:02,210
...أيّها

213
00:13:05,440 --> 00:13:07,460
أتعبثُ معنا أيّها الوغد؟

214
00:13:08,960 --> 00:13:11,130
...أتعلمُ كم هو صعبٌ ومُجهدٌ

215
00:13:11,500 --> 00:13:14,470
مُحاولةُ الوقوف على ذلك الملعب هُناك؟

216
00:13:16,380 --> 00:13:19,510
.الكلامُ سهل

217
00:13:19,920 --> 00:13:22,020
!ينبغي أن تكون على درايةٍ بذلك

218
00:13:25,640 --> 00:13:26,520
!آمن

219
00:13:26,900 --> 00:13:28,580
!سرقةٌ جيّدة

220
00:13:29,020 --> 00:13:31,380
!مُذهل ، لقد حلّق عالياً

221
00:13:31,380 --> 00:13:33,030
!حركةٌ رائعة ، [كوروماتشي]

222
00:13:33,740 --> 00:13:36,530
.سُرعتهُ مفيدة

223
00:13:42,280 --> 00:13:43,290
!اللّعنة

224
00:13:43,680 --> 00:13:47,660
،لا أُحبّذ فكرة أن يقول لنا [ميوكي] ما يجب علينا فعله

225
00:13:48,790 --> 00:13:51,060
.لكن لا خيار أمامنا

226
00:13:51,060 --> 00:13:52,800
!يتحتّم علينا فِعلُها

227
00:13:53,230 --> 00:13:55,300
![كوميناتو] ، اضربها

228
00:13:55,700 --> 00:13:59,450
.هذه فرصتنا الأولى والأخيرة للوصول للكوشين معاً

229
00:14:00,340 --> 00:14:02,430
.أُريدُ الذّهاب للكوشين

230
00:14:04,170 --> 00:14:06,500
،أردتُ الذهاب هُناك رفقة أخي

231
00:14:08,000 --> 00:14:10,540
.لكن ذلك أصبح مُحالاً الآن

232
00:14:14,320 --> 00:14:15,700
...لكنّي سأذهب

233
00:14:17,630 --> 00:14:18,750
!بنفسي

234
00:14:25,840 --> 00:14:28,090
!رائع! لقد وصل للقاعدة

235
00:14:29,400 --> 00:14:30,710
!كان ذلك وشيكاً

236
00:14:35,540 --> 00:14:37,400
!هل اعتقدت أنّك ستتفوّق عليّ؟

237
00:14:37,400 --> 00:14:39,170
.الأمرُ لن يكون بهذه السهولة

238
00:14:43,280 --> 00:14:45,180
!خرج واحد! خرج واحد

239
00:14:49,500 --> 00:14:50,560
!إصابة

240
00:14:51,560 --> 00:14:53,070
!إخراجٌ آخر

241
00:14:55,520 --> 00:14:56,600
!خرج اثنان

242
00:14:56,600 --> 00:14:57,820
!رميةٌ جيّدة ، [تانبا]

243
00:14:59,280 --> 00:15:01,590
،صحيحٌ أنّها كانت رميةً صعبة

244
00:15:02,840 --> 00:15:04,680
.لكن كان عليك أن تؤرجح مضربك

245
00:15:06,640 --> 00:15:07,820
!اللّعنة

246
00:15:16,140 --> 00:15:17,470
...حقاً

247
00:15:17,470 --> 00:15:19,840
.رمياته السريعة صعبةُ الضرب اليوم

248
00:15:24,580 --> 00:15:26,850
،مهما كانت روعة الرميات المسكورة التي سترميها اليوم

249
00:15:27,240 --> 00:15:29,300
.الكرات السريعة تظلّ أفضل حلّ

250
00:15:30,110 --> 00:15:32,400
.لا تنسى ذلك أبداً من فضلك

251
00:15:35,080 --> 00:15:37,360
!إنّهُ محاصر ، ومع ذلك يبتسم

252
00:15:37,360 --> 00:15:40,360
...والآن دعنا نُخرج طالب السنة الثانية صاحب

253
00:15:40,800 --> 00:15:42,370
!الفم الثرثار

254
00:15:42,720 --> 00:15:43,810
!بهذه

255
00:15:48,250 --> 00:15:50,040
،في البداية ، تكون كالرمية السريعة

256
00:15:50,390 --> 00:15:53,380
.لكنّها تسقط فيما بعد أمام الضارب لتبدو كما لو أنّها تغطس

257
00:15:56,280 --> 00:15:57,430
،لأكون صادقاً

258
00:15:57,430 --> 00:16:00,880
.لم أتوقع بأنها ستكون بهذه الروعة حينما أكون الضارب

259
00:16:00,880 --> 00:16:01,890
.[تانبا-سان]

260
00:16:02,750 --> 00:16:06,350
.اللّعنة ، لقد توقعتها إذن

261
00:16:11,640 --> 00:16:12,900
...أيّها

262
00:16:14,020 --> 00:16:14,960
!أجل

263
00:16:14,960 --> 00:16:16,270
!جولة ركض

264
00:16:17,660 --> 00:16:19,780
!ميوكي يسجّل

265
00:16:19,780 --> 00:16:23,030
!طلاب السنة الأولى والثانية يردّون الصاع للسنباي

266
00:16:23,430 --> 00:16:26,030
!لقد بدأت المُباراة للتوّ

267
00:16:27,290 --> 00:16:29,040
!تستطيع فعلها ، [فوريا]

268
00:16:29,040 --> 00:16:30,520
!هيّا بنا

269
00:16:31,040 --> 00:16:33,700
،من الجيّد أنّي ضربتها

270
00:16:33,700 --> 00:16:37,050
.لو لم أفعل ذلك ، لسخِر منّي الجميع

271
00:16:40,550 --> 00:16:43,720
!لا تفرح كثيراً لتسجيلك جولة ركض واحدة فقط

272
00:16:43,720 --> 00:16:45,800
!هزيمة السنباي ليست بتلك السهولة

273
00:17:00,980 --> 00:17:02,070
!للخارج

274
00:17:02,070 --> 00:17:02,700
!أجل

275
00:17:02,700 --> 00:17:05,160
.[كوميناتو] دائماً ما يتواجدُ في المكان الصحيح

276
00:17:05,160 --> 00:17:07,700
!واجهوا الضارب الثالث والرابع والخامس في جولة ركض واحدة

277
00:17:09,170 --> 00:17:10,460
!أحسنت الرميّ

278
00:17:10,460 --> 00:17:13,210
![سوامورا] ، اخفض إيقاعك قليلاً

279
00:17:14,790 --> 00:17:17,090
.مع أن أمرُ مشاركتهِ غيرُ مؤكّد

280
00:17:20,150 --> 00:17:25,180
.إن فزنا في بطولة الخريف ، فسوف نذهب للكوشين

281
00:17:25,580 --> 00:17:26,900
!أجل

282
00:17:26,900 --> 00:17:27,900
.لم تكن سيئاً

283
00:17:29,820 --> 00:17:31,000
...العودة للتلّ

284
00:17:32,630 --> 00:17:34,740
!بعد أن خرجتُ في ذلك الحين

285
00:17:36,600 --> 00:17:38,170
،في حالتي هذه

286
00:17:40,390 --> 00:17:43,100
لأي درجةٍ سأكونُ مفيداً للفريق؟

287
00:17:47,900 --> 00:17:50,540
،طريقتك في الرميّ هي أن تلعب بعدوانيّة

288
00:17:51,280 --> 00:17:54,160
.لهذا لطالما أردت تعليمك هذه الرمية

289
00:17:57,420 --> 00:17:59,100
![كاريبا] ، هيّا بنا

290
00:17:59,100 --> 00:18:00,640
مازلت تريدُ الرميّ؟

291
00:18:01,170 --> 00:18:05,240
الشوط السابع

292
00:18:10,450 --> 00:18:13,930
الضارب الثامن

293
00:18:29,490 --> 00:18:31,360
.[كواكامي] أوقفهم في الشوطين السابع والثامن

294
00:18:31,360 --> 00:18:33,450
!يبدو أنّه قد عاد لطبيعته أخيراً

295
00:18:33,800 --> 00:18:35,820
.لا ، ما زال ذلك مبكراً

296
00:18:35,820 --> 00:18:38,460
.لاعبيّ الدفاع ينقذونه في العديد من المرات

297
00:18:39,160 --> 00:18:41,460
.في النهاية ، لم يستطع أن يُخرج [تيتسو-سان]

298
00:18:42,200 --> 00:18:44,760
،هناك فرقٌ كبير بين الرميّ بحذر

299
00:18:44,760 --> 00:18:46,600
.والهروب

300
00:18:47,840 --> 00:18:49,970
تم تبديله عند الضارب الخامس

301
00:18:49,970 --> 00:18:52,720
طلاب السنة الأولى والثانية
طلاب السنة الثالثة

302
00:18:51,100 --> 00:18:52,720
.إنهم متأخّرون بجولة ركض واحدة فقط بعد مرور ثمان أشواط

303
00:18:53,340 --> 00:18:55,500
.ذلك ليس سيئاً أمام طلاب السنة الثالثة

304
00:18:55,500 --> 00:18:59,480
.[فوريا] و [كواكامي] أوقفوا زخمهم ، ولم يستطيعوا تسجيل سوى ثلاث جولات ركض

305
00:18:59,480 --> 00:19:02,160
،لكن وبالرّغم من مستواهم هذا

306
00:19:02,160 --> 00:19:05,200
.إلّا أن مستوى الضاربين الآن ليس بمستوى السنة الماضية

307
00:19:13,860 --> 00:19:15,510
!جولة ركض

308
00:19:15,510 --> 00:19:16,780
!لقد أتت

309
00:19:16,780 --> 00:19:19,000
![زونو-سنباي] انتظر طويلاً قبل ضرب الكُرة

310
00:19:20,520 --> 00:19:22,500
كانت رميةً سهلة ، أليس كذلك؟

311
00:19:24,920 --> 00:19:27,550
!إنّهُ يركض بسرعةٍ كبيرة

312
00:19:27,550 --> 00:19:28,510
!اهدئ يا [زونو]

313
00:19:29,850 --> 00:19:32,960
.لقد حان الوقت أخيراً لتضرب الرميات كما كنتُ في الماضي

314
00:19:32,960 --> 00:19:35,790
.لا تفكّر في ضرب الكرة جهة اليمين طِوال واقت

315
00:19:35,790 --> 00:19:38,090
.أرجح مِضربك فقط

316
00:19:39,140 --> 00:19:41,490
.أنت مختلفٌ عنّي

317
00:19:41,490 --> 00:19:44,440
.لأنّك تعتمدُ على ضرب الكرة في جهةٍ معيّنة

318
00:19:45,020 --> 00:19:47,610
لمَ تبدو مُتفاجئاً أكثر من أي شخصٍ هُنا؟

319
00:19:50,060 --> 00:19:51,950
!توقف عن البكاء

320
00:19:53,520 --> 00:19:55,590
!ضربةٌ رائعة! [زونو-سنباي]

321
00:19:55,590 --> 00:19:56,910
!لقد عادلنا النتيجة

322
00:19:56,910 --> 00:19:58,720
!فالنقلب المُباراة لصالحنا الآن

323
00:20:00,300 --> 00:20:01,240
،]سوامورا]

324
00:20:02,370 --> 00:20:03,960
.ستلعبُ في الشوط التالي

325
00:20:05,960 --> 00:20:09,220
.بفضل جولة ركض [زونو-سنباي] أصبحت قادراً على المُشاركة

326
00:20:09,560 --> 00:20:12,720
،لن أطلب منك رمياتٍ داخليّة اليوم

327
00:20:13,250 --> 00:20:15,230
.دعنا نُركّز على الرميات الخارجيّة فقط

328
00:20:21,980 --> 00:20:24,920
.ما أُريدُ معرفته هو شيءٌ واحدٌ فقط

329
00:20:25,520 --> 00:20:27,580
،في حالتك هذه

330
00:20:27,580 --> 00:20:30,260
هل ستكونُ  مفيداً للفريق أم لا؟

331
00:20:35,150 --> 00:20:36,990
!خرج ثلاثة! تغيير

332
00:20:37,820 --> 00:20:39,720
!لا تستخفّوا بنا

333
00:20:43,260 --> 00:20:45,680
!والآن هيّا بنا

334
00:20:49,880 --> 00:20:52,010
هل سيلعبُ [سوامورا] الآن؟

335
00:20:52,350 --> 00:20:54,010
،صحيحٌ أنّهُ لاعبٌ مهمٌّ في الفريق

336
00:20:54,690 --> 00:20:59,020
.لكنّه هُزِمَ هزيمةً نكراء أمام (ياكوشي)

337
00:21:00,500 --> 00:21:01,540
.[كريس]

338
00:21:04,770 --> 00:21:07,240
![إيجون-كن] ، نحنُ خلفك

339
00:21:07,240 --> 00:21:09,440
!ركّز على الضارب الأوّل ، [سوامورا]

340
00:21:09,440 --> 00:21:10,780
!أخرِج في كل مرّة ضارب

341
00:21:12,240 --> 00:21:13,430
.اهدئ

342
00:21:13,890 --> 00:21:16,460
.أنا لا أملكُ سلاحاً سرّياً لأبدء بهِ

343
00:21:17,250 --> 00:21:20,790
،قليلةٌ هي الأشياء التي أستطيعُ فِعلها

344
00:21:21,550 --> 00:21:22,670
...لكن

345
00:21:23,520 --> 00:21:25,720
.هذا لا يعني أنّي لا أستطيعُ فِعل شيء

346
00:21:26,910 --> 00:21:29,800
!حضرة المدرب ، نطلبُ تغيير لاعب

347
00:21:32,180 --> 00:21:34,060
.كونوا مستعدّين أنتم أيضاً

348
00:21:34,060 --> 00:21:35,250
.بالتأكيد

349
00:21:35,250 --> 00:21:36,300
.نحنُ مستعدّين في أي وقت

350
00:21:36,300 --> 00:21:39,300
!لقد أشركنا أوراقنا الرابحة

351
00:21:39,300 --> 00:21:41,740
.كن مستعدّاً ، [سوامورا]

352
00:21:42,700 --> 00:21:44,900
!اذهب واقضي عليه

353
00:21:44,900 --> 00:21:47,060
.أجل ، أنا مدينٌ لكم

354
00:21:52,070 --> 00:21:55,050
![كريس] سيكون الضارب أيّها الغبيّ

355
00:22:01,620 --> 00:22:03,200
![كريس-سنباي]

356
00:23:54,770 --> 00:24:00,150
المثابرة

357
00:23:55,310 --> 00:23:58,720
:في الحلقة القادمة من دايموند نو آيس
.المثابرة