1
00:00:01,080 --> 00:00:02,220
!هيّا بنا

2
00:00:02,220 --> 00:00:03,940
!ركّز على الضاربين

3
00:00:12,290 --> 00:00:13,820
!حسناً! أحسنت الرميّ

4
00:00:14,380 --> 00:00:15,870
!أحسنت الرميّ يا [فوريا]

5
00:00:16,330 --> 00:00:17,700
!خرج لاعبان

6
00:00:19,620 --> 00:00:21,700
!حان الوقتُ للإطاحة به

7
00:00:21,700 --> 00:00:23,710
!لقد نالَ منهُ التعب

8
00:00:25,200 --> 00:00:26,710
.لم أتعب بعد

9
00:00:27,500 --> 00:00:28,710
.[كانيماور]

10
00:00:28,710 --> 00:00:29,710
.أجل

11
00:00:30,130 --> 00:00:33,590
.أخبر [سوامورا] أن يُريح كتفيه

12
00:00:34,630 --> 00:00:36,100
.أنت

13
00:00:36,100 --> 00:00:38,600
.لقد أحضرتُ لكَ الثلج

14
00:00:39,510 --> 00:00:41,810
.تأكّد من وضعهِ على كتفك

15
00:00:43,650 --> 00:00:47,500
!منذُ لحظةِ خروجه وهو على هذهِ الحالة

16
00:00:48,330 --> 00:00:53,610
.هذه هي المرّة الأولى التي أراهُ فيها هكذا منذُ البطولة الصيفيّة

17
00:00:54,260 --> 00:00:55,610
!إنّها رميةٌ عاليةٌ جدّاً

18
00:00:55,990 --> 00:00:57,620
!أجل! الجولةُ الثالثة

19
00:00:57,620 --> 00:00:59,620
!لقد تقدّمنا الآن

20
00:01:00,000 --> 00:01:01,620
لماذا لم تقم بالتغطية؟

21
00:01:03,150 --> 00:01:04,120
![ميوكي]

22
00:02:37,820 --> 00:02:40,080
كيف ترى [سوامورا]؟

23
00:02:37,830 --> 00:02:39,830
المرحلة التالية

24
00:02:40,510 --> 00:02:42,410
،رمياتهُ تمتلكُ القوّة

25
00:02:42,410 --> 00:02:44,880
.وهو لا يهتمّ بالضارب أمامه كعادتهِ

26
00:02:46,540 --> 00:02:50,080
ليس في هذه المُباراة وحسب ، بل في المُباريات الأخيرة أيضاً

27
00:02:50,080 --> 00:02:53,350
!رمياته الداخليّة دائماً ما تكون خاطئة

28
00:02:54,270 --> 00:02:57,830
،لا أعلمُ ما إن كان يُدركُ مشكلتهُ هذه

29
00:02:57,830 --> 00:03:01,610
.لكنّه على هذه الحال منذُ إصابته لذلك الضارب في النهائي

30
00:03:05,700 --> 00:03:06,730
![فوريا]

31
00:03:13,640 --> 00:03:14,660
.[سوامورا]

32
00:03:15,370 --> 00:03:16,500
.تبديل

33
00:03:21,530 --> 00:03:23,730
.حسناً ، لا خيارَ آخر

34
00:03:23,730 --> 00:03:27,010
.الأمورُ ستزدادُ سوءاً إن استمرّ بالرميّ

35
00:03:27,640 --> 00:03:29,240
[فوريا] سيرمي من جديد؟

36
00:03:29,240 --> 00:03:32,000
،صحيحٌ أن [كواكامي] كان جيّداً في المُباراة الأخيرة

37
00:03:32,000 --> 00:03:35,760
.لكن [فوريا] هو الأفضلُ في الوقت الحاليّ

38
00:03:36,690 --> 00:03:39,640
.مهلاً قليلاً

39
00:03:41,340 --> 00:03:43,150
.لم أُخرج أيّ لاعبٍ حتى الآن

40
00:03:46,220 --> 00:03:47,530
.[إيجون-كن]

41
00:03:49,520 --> 00:03:51,030
...إذا

42
00:03:51,980 --> 00:03:54,250
...إذا غادرتُ التلّ على هذه الحالة

43
00:04:05,790 --> 00:04:06,750
.أعطني الكُرة

44
00:04:07,340 --> 00:04:10,260
.نحنُ لسنا بحاجةٍ لراميين يقفان على التلّ

45
00:04:13,700 --> 00:04:15,760
—أعلمُ بأن ذلك قاسٍ ، لكن

46
00:04:19,590 --> 00:04:21,230
!هذا طبيعيٌّ جداً

47
00:04:21,230 --> 00:04:24,050
.لقد تخلّيتُ عن ثلاث جولات ركض ، وفوق هذا لم أُخرج أيّ لاعب

48
00:04:24,050 --> 00:04:25,770
!لهذا أمرُ تبديلي طبيعيٌّ جداً

49
00:04:35,940 --> 00:04:40,380
.أعتذرُ عن وضعي كل هذا الحِمل عليك

50
00:04:41,660 --> 00:04:42,790
.أتركُ الباقي لك

51
00:04:46,680 --> 00:04:47,720
.لا

52
00:04:48,510 --> 00:04:49,720
.توقّف

53
00:04:51,020 --> 00:04:53,050
.لا تخرج

54
00:05:02,890 --> 00:05:04,060
...هذا الشعور

55
00:05:06,360 --> 00:05:07,560
.إنّهُ تماماً كذلك الوقت

56
00:05:10,040 --> 00:05:11,570
...التلّ أصبح أبعد

57
00:05:12,590 --> 00:05:14,850
.أبعد بكثيرٍ من ذي قبل

58
00:05:16,480 --> 00:05:18,080
...لقد

59
00:05:18,970 --> 00:05:20,340
...لقد قلتُ لنفسي

60
00:05:21,570 --> 00:05:24,440
.بأني لن أسمح لهذا الموقف أن يتكرّر مرةً أُخرى

61
00:05:26,980 --> 00:05:28,230
.والآن ها هو ذا يتكرّرُ مُجدّداً

62
00:05:29,330 --> 00:05:31,040
.إذا خرجتُ الآن

63
00:05:32,050 --> 00:05:33,060
...سوف

64
00:05:48,860 --> 00:05:49,860
ملعب تدريب مدرسة سيدو العليا

65
00:05:50,320 --> 00:05:51,360
!اجل

66
00:05:51,860 --> 00:05:53,240
!انتصارُنا العشرون على التواليّ

67
00:05:53,680 --> 00:05:55,490
!حقّقنا هدفنا

68
00:05:55,490 --> 00:05:57,490
!نحنُ الأفضل

69
00:05:57,490 --> 00:05:59,310
...كما توقعت

70
00:05:59,310 --> 00:06:01,740
!لقد فُزنا بسبب أنّي أول من بدأ بالرميّ

71
00:06:02,100 --> 00:06:03,600
!أجسنت الرميّ يا [سانادا]

72
00:06:03,600 --> 00:06:05,000
!أحسنت الرميّ يا [ساندا]

73
00:06:05,000 --> 00:06:07,250
ماذا عنّي؟

74
00:06:08,290 --> 00:06:10,690
.شكراً لكم على مُباراة اليوم

75
00:06:10,690 --> 00:06:13,100
،لقد ساعدتنا على اكتشاف مشاكلنا

76
00:06:13,100 --> 00:06:15,260
.لقد كانت مُباراةً مُفيدةً حقاً

77
00:06:15,950 --> 00:06:18,680
.لا ، لا ، الشكرُ لكم

78
00:06:18,680 --> 00:06:20,720
مُفيدة؟

79
00:06:20,720 --> 00:06:23,640
هل تعتبرها مُباراةً تدريبيّة؟

80
00:06:24,540 --> 00:06:25,700
...لكن عليّ القول

81
00:06:25,700 --> 00:06:29,730
.ذلك الفتى [فوريا] يبدو رامياً رائعاً

82
00:06:29,730 --> 00:06:32,750
.لعلّ الفريق المُحترفة سترغب في ضمّهِ إليها

83
00:06:33,130 --> 00:06:34,110
.معك حق

84
00:06:34,110 --> 00:06:38,680
.إمكانياتهُ الكبيرة قد تخوّل لهُ ذلك

85
00:06:38,680 --> 00:06:41,910
.لكن ذات الأمر ينبطق على ضاربك الأول أيضاً

86
00:06:42,200 --> 00:06:43,100
ماذا؟

87
00:06:43,100 --> 00:06:45,120
أوَتعتقدُ ذلك حقاً؟

88
00:06:45,120 --> 00:06:46,920
.إنّهُ ابني

89
00:06:47,620 --> 00:06:51,450
.الأهمّ هوَ كيف يُطوّر اللاعب من نفسهِ بنفسه

90
00:06:52,150 --> 00:06:56,800
.من الصّعب جداً أن يُطوّر المُدرب من إمكانيات لاعبيه

91
00:06:57,500 --> 00:07:00,550
.رغم ذلك ، فـ [فوريا] ليس اللاعب الوحيد في فريقنا

92
00:07:01,930 --> 00:07:03,820
.أجل ، معك حق

93
00:07:03,820 --> 00:07:07,230
.تتحدثُ كمُدرّب حقيقيّ حقاً

94
00:07:07,930 --> 00:07:09,820
.مع أنّك مُملّ

95
00:07:10,370 --> 00:07:13,220
.أنا مُدربٌ يتقاضى أجره من التدريب

96
00:07:13,220 --> 00:07:15,820
.إن لم تكن نتائجي جيدة ، فسوف يتمّ طردي

97
00:07:17,330 --> 00:07:19,820
.نفسُ الأمر ينطيقُ عليه

98
00:07:20,390 --> 00:07:23,390
،حسنٌ ، ربما في بطولة الصيف أو الربيع

99
00:07:23,390 --> 00:07:25,620
.أو رُبما في الخريف

100
00:07:26,140 --> 00:07:28,020
،قد نواجهُ بعضنا البعض

101
00:07:28,020 --> 00:07:29,870
.فالنقدّم كل ما لدينا عندما يحينُ ذلك

102
00:07:32,740 --> 00:07:33,960
!فالنعد أدراجنا

103
00:07:33,960 --> 00:07:34,840
!حاضر

104
00:07:35,360 --> 00:07:37,130
هل انتهينا؟

105
00:07:37,130 --> 00:07:38,630
.أجل

106
00:07:39,660 --> 00:07:43,160
!قوّة فريقهم تكمن في الضارب الأوّل والرامي

107
00:07:44,300 --> 00:07:50,010
.لا أرغبُ في مواجهةِ فريقٍ كهذا في البطولة الصيفيّة

108
00:07:51,260 --> 00:07:52,280
،في النهاية

109
00:07:52,280 --> 00:07:55,650
.[كواكامي] لم يستطع هو الآخر إيقاف ضاربي (ياكوشي)

110
00:07:56,160 --> 00:07:59,280
.خسرنا مع أن فوريا قدّم مُباراةً رائعة

111
00:07:59,280 --> 00:08:04,630
.إضافة إلى ذلك ، [سانادا] أوقف ضاربي فريقنا

112
00:07:59,280 --> 00:08:07,290
سيدو
ياكوشي

113
00:08:04,630 --> 00:08:07,290
.الفريقُ أصبح ضعيفاً مقارنةً بفريقٍ العام الماضيّ

114
00:08:07,810 --> 00:08:10,570
،التصفياتُ بعد أُسبوعين

115
00:08:10,570 --> 00:08:12,500
.والبطولة بعد شهر

116
00:08:12,500 --> 00:08:15,570
هل سيكونُ الفريق مُستعدّاً حتى ذلك الوقت؟

117
00:08:25,310 --> 00:08:26,300
.لقد هُزمتم تماماً

118
00:08:26,300 --> 00:08:32,310
سيدو
ياكوشي

119
00:08:27,420 --> 00:08:30,410
.هذا هو مستواكم الحاليّ

120
00:08:30,410 --> 00:08:32,310
.هذه هي إمكانيّاتكم

121
00:08:33,940 --> 00:08:36,490
.الأجواء سيّئةٌ جداً

122
00:08:36,490 --> 00:08:39,690
.كما توقعت ، ما كان علينا قبول لعب هذه المُباراة

123
00:08:40,130 --> 00:08:42,970
!الضاربين! خاصّة طلاب السنة الثانية

124
00:08:42,970 --> 00:08:45,130
!إنّكم تفتقرون إلى الإصرار

125
00:08:45,780 --> 00:08:48,920
.صحيحٌ أن تركيزكم منصبٌّ على استخدام المضرب من أجل الفريق

126
00:08:48,920 --> 00:08:51,960
لكن ما فائدة ذلك إن لم تضربوا بأسلوبكم الخاصّ؟

127
00:08:52,930 --> 00:08:56,840
،تعمّدتُ عدم إعطائكم أي تعليماتٍ في جميع المُباريات التدريبيّة

128
00:08:56,840 --> 00:08:59,140
...لأنّي أعلمُ بأنّكم ستقدّمون أداءاً جيّداً

129
00:08:59,140 --> 00:09:02,000
.لو أرجحتم مضاربكم مثل تدريباتنا

130
00:09:02,000 --> 00:09:06,050
.والآن فقدتُ ثقتي في استخدامكم للمضرب

131
00:09:07,760 --> 00:09:10,640
.أسماءُ الفريق الأساسي ستتغيّر

132
00:09:10,640 --> 00:09:14,250
.من سيلعب في الفريق الأساسي هو من قدّم أداءاً جيّداً فقط ، لا تُهمّني الأسماء الكبيرة بعد الآن

133
00:09:14,250 --> 00:09:15,810
.تذكّروا هذا جيّداً

134
00:09:17,740 --> 00:09:19,660
.قوموا بتمديد أجسادكم ، وبهذا يومنا ينتهي

135
00:09:19,660 --> 00:09:20,820
!حاضر

136
00:09:21,140 --> 00:09:23,540
[ميوكي] ، [كواكامي]

137
00:09:23,540 --> 00:09:24,320
و [سوامورا]

138
00:09:26,440 --> 00:09:28,370
.ثلاثتكم لا تذهبوا

139
00:09:32,180 --> 00:09:36,080
كيف ترى رمياتك اليوم يا [سوامورا]؟

140
00:09:37,330 --> 00:09:38,590
.أجل

141
00:09:39,080 --> 00:09:43,590
.لم أتمكن من الرميّ حيث يوجد قفّاز [ميوكي-سنباي]

142
00:09:44,650 --> 00:09:46,010
...هل أنت مُدركٌ

143
00:09:47,690 --> 00:09:50,850
أنّك غير قادرٍ على رميّ رمياتٍ داخليّة؟

144
00:09:55,320 --> 00:09:56,600
.مُدركٌ لذلك

145
00:09:58,920 --> 00:10:02,320
.لقد غادرت في المُباراة النهاية لأنّك أصبت الضارب

146
00:10:02,320 --> 00:10:07,110
.لعلّ جسدك يرفضُ تلقائيّاً أن يرمي رمياتٍ داخليّة

147
00:10:09,960 --> 00:10:11,890
مشكلةُ "الليبس"؟

148
00:10:09,960 --> 00:10:11,890
.هي مشكلة يُعاني منها الرامي بسبب حادثة ما ، حيث يرفض جسده تلقائياً أن يرمي رمايت معيّنة

149
00:10:17,560 --> 00:10:21,120
،رميةٌ خاطئة أو إصابةٌ للاعب في لحظةٍ حرجة

150
00:10:21,120 --> 00:10:25,300
.بعدها تكون الرميات السهلة مستحيلةً للرامي

151
00:10:25,300 --> 00:10:28,510
.لأنه قد تكوّنت لديه عُقدة من تلك الحادثة

152
00:10:28,940 --> 00:10:31,040
...ولو كان يُعاني من "الليبس" حقاً

153
00:10:31,040 --> 00:10:34,990
.فسوف يكون عديم الفائدة في بطولة الخريف

154
00:10:39,710 --> 00:10:40,780
.[سوامورا]

155
00:10:41,850 --> 00:10:43,910
.ستتدرّب لوحدك بدءاً من الغدّ

156
00:10:43,910 --> 00:10:45,940
.لا تلمس الكُرة أبداً

157
00:10:45,940 --> 00:10:49,280
.ستركض كل يوم من أجل أن تُقويّ أقدامك

158
00:10:52,380 --> 00:10:55,710
!لقد وضع تدريباتٍ خاصّة من أجلي

159
00:10:55,710 --> 00:10:56,790
...أذلك يعني

160
00:10:56,790 --> 00:10:59,990
،[كواكامي] ، صحيحٌ أنّك تخلّين عن بعض جولات الركض

161
00:10:59,990 --> 00:11:02,290
.لكنّك أدائك كان جيّداً ، وحافظت على مستوى رمياتك المُنخفضة

162
00:11:02,890 --> 00:11:05,780
.حاول أن تُحسّن من رميات قبل بطولة الصيف

163
00:11:05,780 --> 00:11:06,300
!حاضر

164
00:11:06,920 --> 00:11:08,530
.هذا طبيعيّ

165
00:11:09,490 --> 00:11:11,800
،بسبب رمياتي السيّئة اليوم

166
00:11:12,880 --> 00:11:14,400
...أنا

167
00:11:16,060 --> 00:11:17,810
.أنا عديمُ الفائدة..

168
00:11:18,320 --> 00:11:19,540
،في الوقت الحاليّ

169
00:11:19,540 --> 00:11:22,660
.الضاربين أضعف من السنة الماضية

170
00:11:22,660 --> 00:11:25,560
.لهذا من الأفضل أن نُركّز على الدفاع

171
00:11:25,560 --> 00:11:28,820
.سيكونُ لدينا مُباريات قويّة ستشكّلُ ضغطاً على الدفاع

172
00:11:29,230 --> 00:11:31,630
،مهما كان أداء [فوريا] جيّداً

173
00:11:31,630 --> 00:11:35,080
.فهو لا يستطيع أن يرمي لمباراةٍ كاملة

174
00:11:35,860 --> 00:11:37,750
،من أجل الفوز في بطولة الخريف

175
00:11:38,540 --> 00:11:40,960
.سنحتاجُ إليكما أيضاً

176
00:11:44,630 --> 00:11:45,130
ماذا؟

177
00:11:45,770 --> 00:11:47,510
هل رأيت [سوامورا] اليوم؟

178
00:11:48,010 --> 00:11:50,780
.لقد كان يركضُ طِوال اليوم في الملعب الثاني

179
00:11:50,780 --> 00:11:51,900
لماذا؟

180
00:11:51,900 --> 00:11:54,020
بسببِ مباراة الأمس؟

181
00:11:54,020 --> 00:11:55,060
...في الواقع

182
00:11:55,760 --> 00:11:58,020
مسحيل! [سوامورا] يُعاني من "الليبس"؟

183
00:11:58,470 --> 00:12:02,230
.أحد اللاعبين شاهده يركض وحيداً

184
00:12:04,750 --> 00:12:07,900
.لعلّ هذه قد تكونُ فرصةً لـ [توجو]

185
00:12:07,900 --> 00:12:08,880
هل أنت غبيّ؟

186
00:12:08,880 --> 00:12:12,240
.لقد قام بتغيير مركزه ولن يعود كرامٍ

187
00:12:12,850 --> 00:12:16,500
أخبرني ما الذي يجري يا [كانيمارو]؟

188
00:12:18,720 --> 00:12:20,340
![كريس-سنباي]

189
00:12:21,780 --> 00:12:24,290
(سيدو) و (ياكوشي) لعِبا مُباراةً تدريبيّة؟

190
00:12:24,780 --> 00:12:25,710
.أجل

191
00:12:25,710 --> 00:12:27,690
،نتيجة المباراة كانت 7-2

192
00:12:27,690 --> 00:12:29,550
.المُباراة كانت لصالح (ياكوشي)

193
00:12:29,940 --> 00:12:32,890
!لعِبا قبل بطولة الخريف؟

194
00:12:33,460 --> 00:12:35,490
.تمنّيت لو أنّي شاهدتها

195
00:12:35,490 --> 00:12:37,020
.وأنا أيضاً

196
00:12:37,020 --> 00:12:39,060
.من فاز هو (ياكوشي) إذن

197
00:12:39,470 --> 00:12:41,620
،من دون طلاب السنة الثالثة

198
00:12:41,620 --> 00:12:44,730
.مستوى الفِرق سيتغيّر كثيراً

199
00:12:45,380 --> 00:12:49,070
.أنا على يقينٍ أن نتيجة المُباراة تُمثّل مستوى كُل منهما

200
00:12:49,800 --> 00:12:51,000
.معك حث

201
00:12:51,000 --> 00:12:54,130
.(ياكوشي) ما زال لديهم نفسُ لاعبيهم من السنة الماضية

202
00:12:54,130 --> 00:12:57,700
،الأمرُ يعتمدُ على أفراد الفريق

203
00:12:57,700 --> 00:13:00,830
.ومدى استعدادهم خلال العُطلة

204
00:13:01,140 --> 00:13:02,110
.أجل

205
00:13:05,600 --> 00:13:07,340
!يالهُ من حشدٍ كبير

206
00:13:08,490 --> 00:13:11,430
،وهذا الأمر ينطبق على جميع الفِرق

207
00:13:10,090 --> 00:13:15,340
مدرسة إيناشيرو العُليا

208
00:13:11,430 --> 00:13:14,860
.أدائك في الصيف لا يهمّ

209
00:13:19,800 --> 00:13:22,460
،العطلة الصيفيّة شارفت على النهاية

210
00:13:22,460 --> 00:13:25,920
.لكن طلاب السنة الثالثة ما زالوا يتدرّبون

211
00:13:25,920 --> 00:13:29,600
.لقد تم اختيار البعض منهم لخوض مباراة اليابان ضد أمريكا

212
00:13:29,600 --> 00:13:32,610
.وأيضاً يوجدُ المهرجان الوطنيّ في سبتمبر

213
00:13:33,210 --> 00:13:35,620
،عندما تذهب للكوشين

214
00:13:35,620 --> 00:13:38,120
.فهذا يزيد من فترة لعِب طلاب السنة الثالثة

215
00:13:38,780 --> 00:13:40,900
.الحضورٌ كبيرٌ أيضاً

216
00:13:40,900 --> 00:13:42,620
.كما هو متوقع من وصيف الكوشين

217
00:13:43,280 --> 00:13:46,370
.لقد مضت عشرةُ أيام منذ نهائي الكوشين ، ومع ذلك الجمهور ما زال يأتي إلى هُنا

218
00:13:47,090 --> 00:13:49,960
،لقد أمضوا أغلب فترات العُطلة الصيفيّة في الكوشين

219
00:13:49,960 --> 00:13:53,420
...الآن أصبح لديهم خبرةٌ كبيرة

220
00:13:53,420 --> 00:13:55,380
.بعد أن وصلوا إلى النهائي

221
00:13:55,820 --> 00:13:56,920
،بالرّغم من ذلك

222
00:13:56,920 --> 00:13:59,640
.الفريق لم يستعدّ جيّداً لبطولة الخريف

223
00:14:00,650 --> 00:14:03,180
أتسمحُ بدقيقةٍ من وقتك يا [هارادا-كن]؟

224
00:14:03,180 --> 00:14:04,140
.بالتأكيد

225
00:14:04,880 --> 00:14:06,650
.أحسنتم صُنعاً بالكوشين

226
00:14:06,650 --> 00:14:08,920
هل هدأت الأمورُ الآن؟

227
00:14:08,920 --> 00:14:10,150
.معكِ حق

228
00:14:10,880 --> 00:14:13,920
.أنا متأكدةٌ أن هُنالِك ضغطاً كبيراً على من سيحلّ مكانك

229
00:14:13,920 --> 00:14:15,710
هل اخترتم الكابتن الجديد؟

230
00:14:16,210 --> 00:14:17,160
.أجل

231
00:14:17,810 --> 00:14:21,310
.كُلٌ من المدرّب واللاعبين وقع اختيارهم على [فوكو-تشان]

232
00:14:22,180 --> 00:14:23,670
[فوكو-تشان]؟

233
00:14:23,670 --> 00:14:24,660
من هذا؟

234
00:14:25,120 --> 00:14:27,550
،لقد كان في قائمة الأسماء المُشاركة في الكوشين

235
00:14:27,550 --> 00:14:30,500
.في الواقع ، أشكُّ أنّه سيشارك مع الفريق

236
00:14:31,120 --> 00:14:35,170
،لكنّه بالرّغم من ذلك أكثر شخص مسؤول حالياً بالفريق

237
00:14:35,490 --> 00:14:39,290
.كما أنّه يهتمّ بالملعب كثيراً

238
00:14:39,290 --> 00:14:41,180
.حتى أن [ناروميا] قد اعترف به

239
00:14:41,870 --> 00:14:43,800
.يبدو مُثيراً للإهتمام

240
00:14:45,820 --> 00:14:46,760
.الجوُّ حارّ

241
00:14:46,760 --> 00:14:48,090
![كارلوس]

242
00:14:48,090 --> 00:14:49,690
!لا تخلع قميصك هُنَا

243
00:14:50,130 --> 00:14:52,430
.بالأمسِ كان هُنالك كُرة في الملعب

244
00:14:52,430 --> 00:14:54,150
.وكرتان قبل الأمس

245
00:14:54,150 --> 00:14:56,090
،إن لم تستطع التنظيف جيّداً بعد التدريب

246
00:14:56,090 --> 00:14:57,950
.من الأفضل أن تقتل نفسك وحسب

247
00:15:00,430 --> 00:15:02,930
!أيّها الوغد ، لا تشرب كل هذا القدر

248
00:15:02,930 --> 00:15:04,200
!أنت تُهدرُ الماء هكذا

249
00:15:05,480 --> 00:15:10,250
.لا أحد من هؤلاء يصلحُ لمهمّة الكابتن ، لذا هذا يُعتبرُ سبباً آخر أيضاً

250
00:15:10,250 --> 00:15:11,960
.هكذا إذن

251
00:15:12,560 --> 00:15:15,440
بامناسبة ، أين [ناروميا-كن]؟

252
00:15:15,440 --> 00:15:17,930
.يبدو أن الأبرز مختفٍ عن الأنظار

253
00:15:18,520 --> 00:15:20,720
.على الأرجح هو في منطقة الإحماء

254
00:15:20,720 --> 00:15:21,600
ماذا؟

255
00:15:21,600 --> 00:15:24,200
أيستعدُّ لبطولة الخريف بهذه السرعة؟

256
00:15:24,200 --> 00:15:25,220
.لا ، لا

257
00:15:25,220 --> 00:15:29,570
.لم يرمي أي رمية منذُ أن أتينا إلى هُنَا

258
00:15:29,570 --> 00:15:33,480
.كما أن المدرب يرغب في أن يُشرك لاعبيّ السنة الثالثة في مهرجان الألعاب الرياضيّة

259
00:15:34,180 --> 00:15:37,660
،لقد أرهقهٌ اللعب في الكوشين

260
00:15:37,660 --> 00:15:41,990
.وما زالت الطريقُ طويلةً أمامه

261
00:15:42,530 --> 00:15:44,740
.لكنّهُ يعلمُ كيف يقضي وقته

262
00:15:45,420 --> 00:15:49,000
.أنا على يقينٍ أنّهُ يُفرغُ غضبهُ في منطقة الإحماء

263
00:15:52,430 --> 00:15:54,130
.حسناً ، أحسنت الرميّ

264
00:15:54,130 --> 00:15:56,400
!كرة! تلك كانت كرة

265
00:15:56,400 --> 00:15:58,380
!منخفضةٌ وسيّئةٌ جداً

266
00:15:58,760 --> 00:16:02,640
.من فضلك ، لا تتدخّل بما أنّك لا ترمي

267
00:16:02,640 --> 00:16:05,510
!ولمَ لا؟ أنا أتدخّلُ في أيّ وقتٍ أُريد

268
00:16:05,510 --> 00:16:06,780
.لا تكن هكذا

269
00:16:06,780 --> 00:16:09,580
.أنت من طلاب السنة الثالثة ، لذا لا تكن أنانيّاً هكذا

270
00:16:09,580 --> 00:16:10,450
ماذا؟

271
00:16:10,450 --> 00:16:13,020
أتقولُ أن طلاب السنة الثالثة لا يُمكن أن يكونوا أنانيّين؟

272
00:16:13,020 --> 00:16:16,070
كيف يكونون إذن؟

273
00:16:13,720 --> 00:16:16,630
.إنّهُ عنيدٌ جدّاً

274
00:16:16,630 --> 00:16:20,410
.الآن بعد أن رحل [ماسا-سان] ، لن يستطيع أحدٌ أن يُسيّطر عليه

275
00:16:20,410 --> 00:16:22,030
.لن يقف أحدٌ في وجهه

276
00:16:22,530 --> 00:16:25,360
.أنا في الواقعِ قلقٌ بعض الشيء

277
00:16:25,360 --> 00:16:29,040
.أعتقدُ أن من الأفضل أن ألتقط رمياتك أكثر

278
00:16:29,040 --> 00:16:30,800
.لا تقلق ، لا تقلق

279
00:16:30,800 --> 00:16:33,670
.سأرمي حيثُ يوجد قفّازك تماماً

280
00:16:36,380 --> 00:16:38,100
.هكذا أنا لا أختلفُ عن الحائط أبداً

281
00:16:39,440 --> 00:16:41,380
ما بالُ هذا الوجه التعيس؟

282
00:16:41,380 --> 00:16:43,550
!كما لو أنّك تقول بأنّي غبيّ ولا أفهمُ شيئاً

283
00:16:43,550 --> 00:16:46,260
.أنا لم أقلّ ذلك

284
00:16:46,260 --> 00:16:47,930
.إنّهُ عنيدٌ جداً

285
00:16:48,400 --> 00:16:50,010
.لا تقلق

286
00:16:50,010 --> 00:16:53,940
.فأنا على أيّة حال ، لا أتوقع منك أن تكون بديلاً لـ [ماسا-سان] بهذه السرعة

287
00:16:56,820 --> 00:17:00,730
...حسناً ، إن قلتها بهذه الطريقة

288
00:17:00,730 --> 00:17:03,660
.لكنّي أيضاً لا أُخطّط لأن أخسر

289
00:17:06,060 --> 00:17:08,660
.ليس قبل أن نصل إلى القمّة

290
00:17:15,480 --> 00:17:17,930
.حتى تكونوا على درايةٍ بالأمر ، أنا أنانيّ جدّاً

291
00:17:17,930 --> 00:17:18,920
.حاضر

292
00:17:18,920 --> 00:17:20,920
.سأرفضُ إشاراتك كثيراً

293
00:17:20,920 --> 00:17:21,670
.أعلمُ ذلك

294
00:17:22,040 --> 00:17:24,810
.ولديّ العديد من رسائل المُعجبين أيضاً

295
00:17:25,500 --> 00:17:26,680
...حسناً

296
00:17:26,970 --> 00:17:29,680
،وبما أنّنا نتكلم عن المُعجبين

297
00:17:30,080 --> 00:17:33,590
.ظهرت لي فتاةٌ من السنة الأولى تطلبُ الخروج معي

298
00:17:34,500 --> 00:17:36,350
ما الذي ترميه بكلامك هذا؟

299
00:17:38,360 --> 00:17:41,010
.اختيار اللاعبين لبطولة الخريف سيكون قريباً

300
00:17:41,010 --> 00:17:44,330
.طلاب السنة الثالثة سيتقاعدون بعد بعد مهرجان الألعاب الرياضية في سبتمبر

301
00:17:44,330 --> 00:17:47,570
.وبطولةُ الخريف ستبدأ في أكتوبر

302
00:17:48,040 --> 00:17:52,380
.يجبُ عليهم أن يشكّلوا الفريق الجديد سريعاً

303
00:17:53,120 --> 00:17:57,450
.وهذا لن يكون سهلاً بالنسبة للفِرق التي تأهّلت للكوشين

304
00:17:57,450 --> 00:18:01,340
.لكن هذه تُعدّ تجربة مهمّة للفريق الذي لعِب في الكوشين

305
00:18:01,840 --> 00:18:06,380
.وهذا نوعاً ما عقابُ من يلعبُ هُناك

306
00:18:06,090 --> 00:18:10,050
الطموح

307
00:18:08,080 --> 00:18:10,880
،الفريق الذي لم يذهب للكوشين

308
00:18:11,670 --> 00:18:14,820
،والفريق الذي ذهب إلى نهائي الكوشين

309
00:18:15,380 --> 00:18:17,680
،كل منهما خاض صيفه بشكل يختلف عن الآخر

310
00:18:18,080 --> 00:18:21,360
.لكن في النهاية ، سيقفون على نفس خط البداية من جديد

311
00:18:30,360 --> 00:18:31,960
!يا لاعب البيسبول

312
00:18:31,960 --> 00:18:34,120
كيف كانت عطلتكم الصيفيّة؟

313
00:18:34,450 --> 00:18:35,620
.اصمت

314
00:18:36,080 --> 00:18:38,820
.لقد كنتم قريبين حقاً من الوصول للكوشين

315
00:18:38,820 --> 00:18:41,140
.الجميعُ قد بكى بعد المُباراة

316
00:18:41,140 --> 00:18:45,130
.صديقٌ لي يقول بأن تلك المُباراة كان أشدّ إثارةً من نهائي الكوشين

317
00:18:45,600 --> 00:18:47,750
أمازالوا يتحدّثون عن ذلك؟

318
00:18:47,750 --> 00:18:50,180
.لقد أصبح في طيّ النسيان

319
00:18:50,490 --> 00:18:54,180
.وبالمناسبة ، [سوامورا] كان رائعاً جداً

320
00:18:54,880 --> 00:18:58,050
.لقد كان يرمي بشكل مدهش حقاً

321
00:18:58,050 --> 00:18:59,470
.وكان متهوّراً كثيراً

322
00:18:59,470 --> 00:19:02,190
.إنّ شخصيّته تختلف عن التي نشاهدها بالفصل

323
00:19:02,530 --> 00:19:06,400
أتتذكّر ما الذي كان يقوله عندما أتى هنا لأوّل مرة؟

324
00:19:06,650 --> 00:19:10,810
.سأكونُ الراميّ الأساسيّ في الفريق ، وأدعى [سوامورا إيجون]

325
00:19:10,810 --> 00:19:12,240
!تذكّروا هذا الإسم جيّداً

326
00:19:13,160 --> 00:19:15,900
،في ذلك الوقت سخِر منه الجميع

327
00:19:15,900 --> 00:19:17,960
.لكن الآن قد يكون الرامي الأساسيّ حقاً

328
00:19:22,180 --> 00:19:24,920
هل قلتُ شيئاً غريباً؟

329
00:19:25,410 --> 00:19:26,710
.لا

330
00:19:27,560 --> 00:19:29,120
![هارونو]

331
00:19:30,170 --> 00:19:32,850
هل حدث شيءٌ ما مع [سوامورا] في العطلة الصيفيّة؟

332
00:19:33,220 --> 00:19:35,350
!لقد أصبحَ مُختلفاً تماماً

333
00:19:38,940 --> 00:19:41,320
هل أظهر هذا الوجه من قبل؟

334
00:19:41,320 --> 00:19:43,360
!علاوةً على ذلك ، إنّه يقراُ كتاباً

335
00:19:44,210 --> 00:19:45,930
."إنّه كتاب "الخمس خواتم

336
00:19:45,930 --> 00:19:48,050
.إنّهُ كتابٌ ألّفه [مياموتو موساشي] قُبيل موته

337
00:19:48,050 --> 00:19:51,150
.وهو يتحدث عن طريقتهِ في استخدام السيف

338
00:19:51,150 --> 00:19:52,120
[موساشي]؟

339
00:19:52,370 --> 00:19:55,360
ماذا؟ أيريدُ [سوامورا] أن يُصبح ساموراي؟

340
00:19:55,360 --> 00:19:58,500
.لكن شخصيّتهُ الكئيبة تروق لي

341
00:19:59,310 --> 00:20:03,630
أيُحاول أن يتعلّم شيئاً من رجلٍ لم يخسر قطّ؟

342
00:20:05,220 --> 00:20:06,880
،بدأ الفصلُ الثاني

343
00:20:07,290 --> 00:20:10,300
،واختيار أسماء اللاعبين لبطولة الخريف اقترب

344
00:20:10,860 --> 00:20:13,580
.و [سوامورا] ما زال يتدرّب وحيداً

345
00:20:21,910 --> 00:20:24,650
.والآن هو يقرأ كتاباً عن فنون القتال

346
00:20:26,180 --> 00:20:27,150
.هكذا إذن

347
00:20:28,040 --> 00:20:29,150
.الرمية الداخليّة

348
00:20:29,540 --> 00:20:34,730
.الرميّ بعدوانيّة كان ذلك أُسلوبه في الرميّ

349
00:20:35,580 --> 00:20:38,410
.والآن كأنّه فقد ذلك الأسلوب

350
00:20:41,010 --> 00:20:42,080
.معك حق

351
00:20:43,180 --> 00:20:45,170
،لو أنّه يُعاني من "الليبس" حقاً ، فستكون تلك مشكلة

352
00:20:46,380 --> 00:20:50,150
لكن في المُباريات التدريبيّة الأخرى كان يرمي بشكل جيّد ، أليس كذلك؟

353
00:20:50,260 --> 00:20:51,670
.أجل

354
00:20:52,330 --> 00:20:56,930
.إذن من الأفضل أن لا نُعطي الأمر أكبر من حجمه

355
00:20:58,240 --> 00:21:00,680
ألن تتحدث مع [سوامورا] بشأن هذا الأمر؟

356
00:21:01,020 --> 00:21:05,940
.أنا واثقٌ من أنّه سيعود كما كان ، بل وأفضل

357
00:21:06,750 --> 00:21:10,270
.لأن تلك هي طبيعته

358
00:21:16,000 --> 00:21:18,960
،لا وقت لديّ للقلق بشأن الآخرين

359
00:21:18,960 --> 00:21:22,210
!قائمة اللاعبين ستتغيّر ، وهذه فرصةٌ عظيمة بالنسبة لي

360
00:21:37,840 --> 00:21:40,360
.الموسم الجديد على وشك أن يبدأ

361
00:21:40,360 --> 00:21:42,200
ما الذي أفعلهُ بالركض وحيداً هكذا؟

362
00:21:44,890 --> 00:21:48,410
كيف أكون الرامي البادئ دون أن أُخرج أيّ لاعب؟

363
