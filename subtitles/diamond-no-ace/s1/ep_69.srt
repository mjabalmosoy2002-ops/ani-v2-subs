1
00:00:00,930 --> 00:00:03,320
.راقب المُباراة جيّداً

2
00:00:03,320 --> 00:00:05,470
."فهذا أمرٌ مُهمٌّ لنجاح خطّة "تتابع الرماة

3
00:00:06,320 --> 00:00:10,320
.لا تنسى زيارتنا في منتديات العاشق

4
00:00:09,490 --> 00:00:12,110
تتابع الرماة؟

5
00:00:44,380 --> 00:00:47,100
.ارمي بكلّ ما لديك

6
00:00:53,580 --> 00:00:55,680
!إصابة! الضاربُ للخارج

7
00:00:56,010 --> 00:00:57,110
...لن أُسلّم

8
00:01:00,770 --> 00:01:02,070
.التلّ لأيِّ كان..

9
00:02:36,120 --> 00:02:40,790
! لن أخسر أبداً

10
00:02:36,120 --> 00:02:41,090
سيدو
ياكوشي

11
00:02:45,390 --> 00:02:46,590
!للخارج

12
00:02:46,920 --> 00:02:49,590
!لعبةٌ مزدوجة أنهت الشوط

13
00:02:49,900 --> 00:02:52,470
،لا يوجد عدّاء على القاعدتين الأولى والثانية

14
00:02:52,750 --> 00:02:54,850
.استطاع إنهاء الشوط قبل أن يحين دور الضارب الثالث

15
00:02:56,250 --> 00:02:58,850
!مذهل

16
00:03:00,920 --> 00:03:02,160
!أحسنت الرميّ

17
00:03:02,160 --> 00:03:05,880
![فوريا] استطاع إيقافَ ضاربيّ (ياكوشي)

18
00:03:05,880 --> 00:03:10,360
!جولتا ركضٍ في ستّة أشواط

19
00:03:10,920 --> 00:03:14,990
.(سيدو) الآن باتت تملكُ رامٍ حقيقيّ أخيراً

20
00:03:21,650 --> 00:03:22,910
!لا! لا! لا

21
00:03:22,910 --> 00:03:24,610
.من المُبكرِ جداً قولُ ذلك

22
00:03:24,610 --> 00:03:26,510
.ما زالَ في بدايته

23
00:03:27,010 --> 00:03:30,880
.[كانيمارو] ، سنُدخلُ [سوامورا] في الشوطِ التالي

24
00:03:31,810 --> 00:03:32,700
.حاضر

25
00:03:32,700 --> 00:03:33,800
.سأخبرهُ بذلك

26
00:03:35,200 --> 00:03:38,140
.لقد أظهرت لي ما يكفي

27
00:03:39,450 --> 00:03:42,150
.إنّي أضعُ عليكَ أمالاً كبيرة في بطولة الخريف

28
00:03:45,480 --> 00:03:47,410
—في هذه الحالة ، أيُمكنُني أن ألعب

29
00:03:47,410 --> 00:03:49,150
.اذهب ليسار الملعب

30
00:03:51,770 --> 00:03:53,650
!هيّا يا [توجو]

31
00:03:53,650 --> 00:03:55,740
!تقدّم إلى القاعدة مهما كان الثمن

32
00:04:03,480 --> 00:04:04,450
ماذا؟

33
00:04:04,800 --> 00:04:06,000
...أيبدو دائماً

34
00:04:06,770 --> 00:04:08,580
مُخيفاً جداً هكذا؟..

35
00:04:14,480 --> 00:04:18,000
أكان يتعمّدُ إصابتي بهذه الرمية؟

36
00:04:21,070 --> 00:04:21,600
!للخارج

37
00:04:22,690 --> 00:04:23,640
!أجل

38
00:04:23,640 --> 00:04:26,640
!خرج ضارب

39
00:04:26,640 --> 00:04:28,200
!أحسنت الرميّ يا [سانادا]

40
00:04:28,200 --> 00:04:30,610
!أحسنت الرميّ يا [سانادا-سنباي]

41
00:04:31,430 --> 00:04:34,740
!لا تُضيّع صنيعهُ بأخطائك يا [رايتشي]

42
00:04:35,720 --> 00:04:38,500
...يبدو أنّه منذ أن دخل ذلك الرامي

43
00:04:38,500 --> 00:04:42,950
!فريقهم أصبح أكثر قوّةً

44
00:04:42,950 --> 00:04:43,870
.أجل

45
00:04:52,510 --> 00:04:53,470
!خطأ

46
00:04:54,870 --> 00:04:56,600
الرمية القاطعة؟

47
00:04:57,250 --> 00:05:00,000
.لقد أصبحت رميتهُ أصعب من ذي قبل

48
00:05:01,290 --> 00:05:05,600
،الرميةُ النارية يستخدمها الرّماة الذي يستخدون يدهم اليُمنى .والرميةُ القاطعة يستخدمها من يرمي بيدهِ اليُسرى

49
00:05:08,330 --> 00:05:12,060
.إنّهُ عدوانيٌّ كعادته

50
00:05:16,980 --> 00:05:20,350
.ستواجه الضارب الثالث في الشوط التالي

51
00:05:21,100 --> 00:05:23,480
.يجبُ أن تكون أنت الآخرُ عدوانيّاً

52
00:05:24,360 --> 00:05:28,290
.إنّهم لا يعلمون بشأن مقدرتك على رميّ الرمية القاطعة

53
00:05:28,990 --> 00:05:32,880
.فالتريهم إلى أيّ مدىً قد تطوّرت

54
00:05:39,890 --> 00:05:40,970
!للخارج

55
00:05:41,690 --> 00:05:44,970
!خرج اثنان

56
00:05:44,970 --> 00:05:46,710
!أحسنت الرميّ يا [سانادا]

57
00:05:47,940 --> 00:05:50,110
!رمياتُ [سانادا] رائعة

58
00:05:50,700 --> 00:05:54,360
!بالرّغم من أنّهُ أخرج ضارباً واحداً فقط ، إلّا أنّ الفريق أصبح مُتحمّساً بسببه

59
00:05:54,680 --> 00:05:56,640
!خرج إثنان! خرج إثنان

60
00:05:57,460 --> 00:05:58,880
!واحد! واحد

61
00:05:58,880 --> 00:06:01,360
هل سمعتني يا [رايتشي]؟

62
00:06:01,360 --> 00:06:03,810
.هذا ما يعنيهِ أن تكون رامٍ أساسيّ

63
00:06:14,910 --> 00:06:17,280
.راقب المُباراة جيّداً

64
00:06:17,280 --> 00:06:19,510
."فهذا أمرٌ مُهمٌّ لنجاح خطّة "تتابع الرماة

65
00:06:20,990 --> 00:06:22,940
.لم يستطيعوا تسجيل جولات ركضٍ لستة أشواط على التوالي

66
00:06:25,240 --> 00:06:27,420
!أكونُ رامٍ تابعاً له؟

67
00:06:28,030 --> 00:06:29,560
!لا تعبث معي

68
00:06:29,930 --> 00:06:32,840
!لا تعتقد بأنّك أفضلُ منّي

69
00:06:33,720 --> 00:06:35,820
!سأكونُ أنا الراميّ الأساسي

70
00:06:38,920 --> 00:06:39,980
!للخارج

71
00:06:41,320 --> 00:06:42,910
!خرج ثلاثة! تبديل

72
00:06:43,490 --> 00:06:44,580
!رائع جداً

73
00:06:45,090 --> 00:06:46,290
.هذا ما قصدّته

74
00:06:47,420 --> 00:06:48,860
!أنت رائعٌ حقاً

75
00:06:48,860 --> 00:06:50,420
.أنت مُدهشُ جداً

76
00:06:50,700 --> 00:06:52,940
.راميهمُ الأساسيّ مُذهلُ حقاً

77
00:06:52,940 --> 00:06:56,420
.لقد قام بإخراج ثلاثةٍ من أفضل ضاربينا

78
00:06:56,800 --> 00:06:57,610
...إذن

79
00:06:58,060 --> 00:07:01,050
كم عدد جولات الركض التي ستسجّلونها في الأشواط القادمة؟

80
00:07:01,390 --> 00:07:03,310
هاه؟

81
00:07:03,880 --> 00:07:06,200
،إذا لم تسجّلوا

82
00:07:06,200 --> 00:07:09,570
.سأتوقفُ عن تدريبكم

83
00:07:09,570 --> 00:07:11,850
!وسأغضبُ كثيراً ، وأغادرُ الفريق فوراً

84
00:07:12,700 --> 00:07:14,140
.هيّا بنا

85
00:07:17,490 --> 00:07:19,830
...سأثبتُ لهُ نفسي

86
00:07:28,650 --> 00:07:30,130
!حتماً..

87
00:07:31,960 --> 00:07:33,400
سيدو
ياكوشي

88
00:07:32,880 --> 00:07:36,090
.إذاً قاموا بتبديل الرُّماة

89
00:07:36,570 --> 00:07:40,780
.أردتُ رؤية [فوريا] يرمي أكثر

90
00:07:40,780 --> 00:07:42,340
.لكن لا بأس

91
00:07:42,750 --> 00:07:46,510
.فأنا أُحبُّ أُسلوب [سوامورا] في الرميّ

92
00:07:46,510 --> 00:07:49,250
.إنّهُ مهوّر ولا يخافُ أبداً

93
00:07:49,250 --> 00:07:51,980
.أجل ، فهو لاعبٌّ مهمٌّ في الفريق هو الآخر

94
00:07:52,550 --> 00:07:54,610
،مع أنّه لم يُنهي المُباراة في البطولة الصيفيّة

95
00:07:54,610 --> 00:07:57,230
.لكنّهُ ما زالَ مُحافظاً على طريقتهِ في الرميّ

96
00:08:09,690 --> 00:08:10,960
!أيّها المُدرّب

97
00:08:10,960 --> 00:08:12,920
!أنا جاهزٌ الآن

98
00:08:13,730 --> 00:08:16,800
أيُمكنُني أن أبدأ من هذا الشوط؟

99
00:08:18,490 --> 00:08:22,250
.لدينا رامٍ متحمّسٌ آخر

100
00:08:22,250 --> 00:08:24,970
.تبقّة ثلاثةُ أشوط ، ونحنُ مُتقدّمون بجولتيّ ركض

101
00:08:25,890 --> 00:08:28,480
،بما أن [كاتاوكا-سان] أشركهُ الآن

102
00:08:28,480 --> 00:08:31,390
.فلا بد أنّهُ يتوقع الكثير منه

103
00:08:33,890 --> 00:08:35,810
أذلك صاحب الرميات المُتحرّكة؟

104
00:08:36,540 --> 00:08:38,810
...بسببكم أيّها الضاربين

105
00:08:38,810 --> 00:08:41,740
!ذلك الرامي استطاع الهرب

106
00:08:42,080 --> 00:08:43,720
.كونوا جدّيين

107
00:08:44,680 --> 00:08:46,240
.أنا لم أهرب

108
00:08:46,600 --> 00:08:49,210
.رمياته تبدو صعبةً

109
00:08:49,210 --> 00:08:50,240
.أجل

110
00:08:50,240 --> 00:08:52,310
.ليست سريعة ولكنّها كثيرةُ الحركة

111
00:08:52,310 --> 00:08:54,120
.هذا ليس كافيّاً

112
00:08:54,590 --> 00:08:56,840
!لم أضرب العديد من الرميات

113
00:08:57,620 --> 00:09:00,420
!أريدُ ضرب رميات [سوامورا]

114
00:09:00,420 --> 00:09:04,010
!لكنّي أريدُ ضرب رميات [فوريا] أكثر

115
00:09:04,320 --> 00:09:05,270
!حسناً

116
00:09:05,270 --> 00:09:06,770
!فالنلعب خمسَ مُبارياتٍ أخرى

117
00:09:06,770 --> 00:09:07,450
!مقزّز

118
00:09:07,450 --> 00:09:09,010
!لا تتحدّث وأنت تأكل

119
00:09:11,190 --> 00:09:12,140
.[إيجون-كن]

120
00:09:12,640 --> 00:09:14,040
.دعنا نُركّز على إخراج ضاربٍ واحد

121
00:09:14,040 --> 00:09:15,900
.كما جرت العادة ، واحدٌ في كُل مرة

122
00:09:18,720 --> 00:09:20,280
!فالترمي للضارب

123
00:09:20,800 --> 00:09:22,370
!سترمي أمام الضارب الثالث يا [سوامورا]

124
00:09:22,370 --> 00:09:24,610
!الرّميةُ الأولى مُهمّة يا [سوامورا]

125
00:09:26,640 --> 00:09:29,310
ألن يقوم بما يفعلهُ عادةً؟

126
00:09:29,850 --> 00:09:33,040
!الكراتُ ستذهبُ بإتجاهكم ، لذا أعتمدُ عليكم

127
00:09:33,040 --> 00:09:34,740
!شكراً لكم

128
00:09:34,740 --> 00:09:36,400
.كنتُ أحبُّ ذلك

129
00:09:38,860 --> 00:09:40,550
هل سيكونُ بخير؟

130
00:09:40,990 --> 00:09:43,120
.لقد أجهد نفسه بالرميّ في منطقة الإحماء

131
00:09:44,810 --> 00:09:46,800
.أرجح مضربك للرّمية الأولى

132
00:09:48,050 --> 00:09:49,680
.نحنُ نلعبُ أمام (ياكوشي)

133
00:09:50,440 --> 00:09:54,340
.لذا فأنا مُتفهمٌ لغضبك الكبير تجاه [فوريا]

134
00:09:55,660 --> 00:09:56,840
...لكن

135
00:09:56,840 --> 00:09:59,060
.ربما يكونُ متوتّراً إزاء ذلك...

136
00:10:01,060 --> 00:10:01,820
!العب

137
00:10:14,320 --> 00:10:16,760
،كلّما كانت التوقعات كبيرةً عليك

138
00:10:16,760 --> 00:10:18,470
.كلّما ازداد الضغط عليك

139
00:10:19,570 --> 00:10:21,710
...لكن وقوفك وحده على التلّ

140
00:10:22,940 --> 00:10:24,140
.هو ما يجعلُك رامٍ...

141
00:10:25,400 --> 00:10:27,970
أنت الآخرُ ترغبُ بأن تظفر بورقة الرامي الأساسي ، أليس كذلك؟

142
00:10:31,340 --> 00:10:34,940
.إذن من الأفضل أن تُحافظ على أُسلوبك في الرميّ

143
00:10:36,440 --> 00:10:38,440
!فالتكن عُدوانيّاً! رميةٌ داخليّة

144
00:10:39,250 --> 00:10:41,440
.سأضربها

145
00:10:41,440 --> 00:10:43,570
.رمياتهُ ليست بتلك الصعوبة

146
00:10:51,200 --> 00:10:53,580
!إنّها مُنخفضةٌ جداً

147
00:10:54,800 --> 00:10:56,250
!لا تتنهد هكذا

148
00:10:56,250 --> 00:10:58,190
!فالترمي رميةً بإمكان الضارب ضربُها

149
00:10:58,190 --> 00:10:59,710
!اهدئ! اهدئ

150
00:11:00,210 --> 00:11:02,090
!كتفك متصلّبةٌ للغاية

151
00:11:03,560 --> 00:11:04,480
.اللّعنة

152
00:11:04,480 --> 00:11:06,340
.اهدئ

153
00:11:06,720 --> 00:11:07,900
.تبّاً

154
00:11:07,900 --> 00:11:10,340
.لا أستطيعُ رؤية ذراعهِ وهوَ يرمي

155
00:11:10,800 --> 00:11:12,520
!سنُمسكُ الرميات التي يضربها

156
00:11:16,480 --> 00:11:17,770
!الكرة الثانية

157
00:11:18,060 --> 00:11:19,690
!"الرامي لا يستطيعُ الحصول على "إصابة

158
00:11:19,690 --> 00:11:21,020
!استمرّ هكذا يا [أكيبا]

159
00:11:21,290 --> 00:11:23,150
!تمالك نفسك يا [سوامورا]

160
00:11:25,160 --> 00:11:28,010
.بما أنّهُ لم يُسجّل ، فليس بإمكانه فعلُ أيّ شيء حيال ذلك

161
00:11:28,460 --> 00:11:31,210
أيجبُ علي أن أطلُب منهُ كراتٍ خارجيّة؟

162
00:11:32,860 --> 00:11:34,090
.لا

163
00:11:34,090 --> 00:11:35,790
.إنّه الضاربُ الثالث في (ياكوشي)

164
00:11:36,640 --> 00:11:39,300
.التسجيلُ لن يكونَ سهلاً أمامه

165
00:11:40,460 --> 00:11:42,800
!ضع كُل ما لديك في هذه الرمية

166
00:11:45,520 --> 00:11:48,650
.أن أرمي أربع رمياتٍ خاطئة ، هذا يُعدُّ سيئاً

167
00:11:49,300 --> 00:11:51,220
.أن أرمي كُراتٍ سهلة ، هذا يُعدُّ سيئاً

168
00:11:52,490 --> 00:11:54,550
!لكن الشعور بالخوف هو الأسوء على الإطلاق

169
00:11:57,040 --> 00:11:57,770
في المُنتصف؟

170
00:12:01,900 --> 00:12:03,650
!أجل! ضربةٌ إلى نصف الملعب

171
00:12:08,100 --> 00:12:09,800
.لقد فاجأني

172
00:12:09,800 --> 00:12:12,780
.رميتهُ كانت سهلةً جداً

173
00:12:13,600 --> 00:12:17,910
.أعطى الضارب رميةً سهلة ، وبهذا حاصر نفسهُ أمامه

174
00:12:18,390 --> 00:12:23,020
.هذا شيءٌ لا ترغبُ في رؤيته من رامٍ

175
00:12:24,330 --> 00:12:25,570
.اللّعنة

176
00:12:25,570 --> 00:12:26,670
!غيّر طريقة لعِبك

177
00:12:27,300 --> 00:12:29,710
،بإمكاني أن أشعر برغبته في التسجيل من هُنَا

178
00:12:30,640 --> 00:12:33,680
.لكنّهُ قام برميةٍ سهلةٍ مُجدّداً

179
00:12:35,130 --> 00:12:36,930
!لا تتجهّز لأخذ مكاني

180
00:12:36,930 --> 00:12:39,000
!حان دورك

181
00:12:39,000 --> 00:12:40,930
!اضربها بعيداً

182
00:12:41,410 --> 00:12:43,170
!اجعل الكُرة تنفجرُ بمضربك

183
00:12:43,170 --> 00:12:44,810
!اقذفها بعيداً

184
00:12:47,870 --> 00:12:49,420
!أرسلها بعيداً

185
00:12:49,420 --> 00:12:50,900
![رايتشي]

186
00:13:28,100 --> 00:13:29,880
.إنّهُ عنيدٌ للغاية

187
00:13:29,880 --> 00:13:31,860
.لا تتصرّف بلؤمٍ هكذا

188
00:13:32,190 --> 00:13:33,980
.لن أهرُب

189
00:13:33,980 --> 00:13:35,610
.لا حاجة لِذلك

190
00:13:48,480 --> 00:13:51,350
.كرةٌ خارجيّة

191
00:13:51,350 --> 00:13:54,480
.ليس من عادةِ [سوامورا] أن يبدأ برميةٍ خارجيّة

192
00:13:54,480 --> 00:13:56,710
أيُعقلُ أنّهم يتجنّبون مواجهته؟

193
00:13:56,710 --> 00:14:00,390
.إنّهم حذرين ليس إلّا ، فالضاربُ الذي أمامهم ليس سهلاً

194
00:14:02,920 --> 00:14:03,890
.حسناً

195
00:14:03,890 --> 00:14:05,730
،رمياتهُ تملكُ القوّة

196
00:14:06,450 --> 00:14:09,180
.وسيّطرتهُ ليست سيئة

197
00:14:10,250 --> 00:14:12,520
!إمّا الآن أو لا ، رميةٌ داخليّة

198
00:14:14,870 --> 00:14:16,940
.إنّ [تودوروكي] لا يعلمُ بمقدرتك على رميها

199
00:14:18,550 --> 00:14:20,460
!فالترمي كُرةً قاطعة

200
00:14:28,770 --> 00:14:30,380
،إن لم يكن بإمكانك رميُّها

201
00:14:30,760 --> 00:14:32,580
.فلن تُخرج [تودوروكي]

202
00:14:38,710 --> 00:14:41,520
،أعلمُ بأن سيّطرتك على الكرة ليست جيّدة

203
00:14:41,520 --> 00:14:44,050
.لذا لن أطلُب منك ما هو فوق طاقتك

204
00:14:44,050 --> 00:14:46,390
.لكنّك في الآونة الأخيرة ترمي العديد من الرّميات ذات المدى العريض

205
00:14:47,240 --> 00:14:51,190
.لن يكون الأمرُ سهلاً أمام (ياكوشي)

206
00:14:52,330 --> 00:14:53,790
.اللّعنة

207
00:14:53,790 --> 00:14:54,890
.اصمت

208
00:14:55,470 --> 00:14:57,780
.لا تنبض بهذه السّرعة

209
00:15:04,160 --> 00:15:06,910
أُواجههُ أم أهرب؟

210
00:15:08,920 --> 00:15:11,540
.هذا واضح

211
00:15:19,260 --> 00:15:21,250
!الرامي الأساسيّ لا يهربُ أبداً

212
00:15:52,490 --> 00:15:53,560
.أجل

213
00:15:54,730 --> 00:15:55,930
!اقتربنا من التعادل

214
00:15:55,930 --> 00:15:56,840
!إنّها جولةُ ركض

215
00:16:02,180 --> 00:16:04,320
!شكراً لكم! شكراً لكم

216
00:16:04,320 --> 00:16:07,040
!لا تنسى أن تلمس القاعدة يا [رايتشي]

217
00:16:08,760 --> 00:16:09,800
.أيّها الوغد

218
00:16:09,800 --> 00:16:12,130
ما الذي أكلتهُ حتى أصبح بإمكانك ضرب الكُرة هكذا؟

219
00:16:12,130 --> 00:16:14,020
هل هو الموز؟ هل كان ذلك بسبب الموز؟

220
00:16:14,020 --> 00:16:16,230
!ضربةٌ رائعة أيّها الوغد

221
00:16:16,670 --> 00:16:18,180
.وقتٌ مستقطع من فضلك

222
00:16:18,550 --> 00:16:19,400
!وقتٌ مُستقطع

223
00:16:20,890 --> 00:16:23,800
.تلك الرمية كانت سيّئة جداً

224
00:16:23,800 --> 00:16:26,330
.إنّهُ متهوّرٌ للغاية

225
00:16:26,690 --> 00:16:27,990
!أحسنت يا ابني

226
00:16:28,940 --> 00:16:31,750
،اعتقدتُّ بأنّهُ سيرمي رميةً داخليّة

227
00:16:32,480 --> 00:16:35,060
.لكنّهُ لم يفعل

228
00:16:43,300 --> 00:16:45,100
.مرّةً أخرى سجّل [تودوروكي-كن]

229
00:16:45,100 --> 00:16:48,100
.يبدو أنّهُ قد تولّدت لديه نقطةُ ضعفٍ أمامه

230
00:16:48,100 --> 00:16:50,020
!يالها من ضربة

231
00:16:50,480 --> 00:16:54,720
.يجب أن أعترف  ، تلك الضربة كانت مُذهلة حقاً ، بالرّغم من أن الخصم سجّلها

232
00:16:54,720 --> 00:16:57,270
.أشعرُ بالرّاحة عندما أُشاهدُ القواعد خالية من اللاعبين

233
00:17:00,170 --> 00:17:02,370
ماذا؟ هل كلامي خاطئ؟

234
00:17:02,370 --> 00:17:03,780
!أجل ، من دون أدنى شكّ

235
00:17:04,040 --> 00:17:06,330
.حسناً ، لقد هُزمتَ تماماً أمامه

236
00:17:06,330 --> 00:17:07,450
ماذا؟

237
00:17:07,450 --> 00:17:09,290
.تلك كانت ضربةً رائعة

238
00:17:09,580 --> 00:17:10,430
.حسناً

239
00:17:10,430 --> 00:17:12,820
.ركّز على الضارب التالي فقط

240
00:17:12,820 --> 00:17:14,350
.لا تقلق بشأن تلك الضربة

241
00:17:14,350 --> 00:17:15,700
لا بأس بذلك صحيح؟

242
00:17:15,700 --> 00:17:17,800
.لا ، أجل

243
00:17:17,800 --> 00:17:18,810
.أعتقدُ ذلك

244
00:17:18,810 --> 00:17:20,850
!اجعل الرميات تتجه صوّبنا

245
00:17:21,610 --> 00:17:22,760
صوّبكم؟

246
00:17:23,300 --> 00:17:25,080
.ركّز على الضارب التالي

247
00:17:25,080 --> 00:17:26,460
.فالتكن عُدوانيّاً

248
00:17:26,460 --> 00:17:28,680
!حاضر ، بالتأكيد سأفعلُ ذلك

249
00:17:28,920 --> 00:17:30,930
!هذا هو الشيء الوحيدُ الذي يُمكنني فعله

250
00:17:31,250 --> 00:17:31,830
.معك حق

251
00:17:31,830 --> 00:17:33,510
!لا تتفق معي بهذه السهولة

252
00:17:34,460 --> 00:17:35,720
!لم يخرُج أيُّ عدّاء

253
00:17:35,720 --> 00:17:37,750
!ما زلنا نملكُ عدّائيين

254
00:17:37,750 --> 00:17:39,320
أذلك ضروريٌّ لتقوله؟

255
00:17:50,350 --> 00:17:51,330
!حسناً

256
00:17:51,640 --> 00:17:52,410
!أجل

257
00:17:52,610 --> 00:17:54,060
.ضربةٌ رائعة

258
00:17:54,060 --> 00:17:55,500
!هكذا يكونُ الضرب

259
00:17:55,800 --> 00:17:57,240
!استطاع ضرب ثلاث رمياتٍ على التواليّ

260
00:17:57,240 --> 00:17:59,790
.على الأقل أحدث فوضى بين اللاعبين

261
00:17:59,790 --> 00:18:01,880
.يجبُ عليه أن يُخرجَ ضارباً الآن

262
00:18:02,320 --> 00:18:04,250
!خروجٌ واحد

263
00:18:05,930 --> 00:18:07,300
![سانادا]

264
00:18:07,300 --> 00:18:08,930
!اقذفها بعيداً

265
00:18:09,510 --> 00:18:11,620
.لن أُرخي دفاعي أمامك

266
00:18:11,620 --> 00:18:14,850
.يجبُ أن نستغلّ أي فُرصةٍ تسنحُ لنا للتسجيل

267
00:18:19,000 --> 00:18:21,520
،شيءٌ واحدٌ أستطيعُ فعله

268
00:18:23,020 --> 00:18:25,510
.وهو الرميّ إلى ذلك القفّاز

269
00:18:30,700 --> 00:18:31,870
!إلى ذلك القفّاز

270
00:18:35,050 --> 00:18:38,150
.إنّ لا يُسيّطرُ على رمياتهِ أبداً

271
00:18:38,900 --> 00:18:41,810
كيف للماسكِ أن يقوده الآن؟

272
00:18:47,340 --> 00:18:50,770
...من خلال كلامه ، توقعتُ أن يفعل الكثير

273
00:18:51,490 --> 00:18:56,320
.لكن يبدو بأنّهُ خائفٌ من أن يرمي رمياتٍ داخليّة..

274
00:18:59,480 --> 00:19:01,690
...رميةٌ قاطعة

275
00:19:02,660 --> 00:19:04,150
.تمرّ أمام صدره...

276
00:19:05,580 --> 00:19:07,400
!إليك هذه إذن

277
00:19:13,660 --> 00:19:15,410
!ضربةٌ في منتصف المركز والجهة اليُمنى

278
00:19:15,780 --> 00:19:17,490
!أربعُ ضرباتٍ على التواليّ

279
00:19:17,490 --> 00:19:19,620
!أحسنت يا [سانادا-سنباي]

280
00:19:24,640 --> 00:19:26,690
،لم يتجنّب الضارب وحسب

281
00:19:27,350 --> 00:19:30,390
.بل أنّهُ لم يرمي أي كُرة داخليّة أيضاً

282
00:19:38,960 --> 00:19:42,690
...[سوامورا] أيُعقلُ أنّك

283
00:19:43,870 --> 00:19:46,620
.رامٍ أعسر ذا نمطٍ غريبٍ في الرميّ

284
00:19:46,620 --> 00:19:49,000
.كما أنّهُ طالبُ سنةٍ أولى كـ [فوريا]

285
00:19:50,130 --> 00:19:53,240
.فهمتُ الآن لمَ [كاتاوكا-سان] يضعُ عليهِ أمالاً كبيرة

286
00:19:54,330 --> 00:19:56,980
،لكن إن لم يستطع أن يرمي رميةً داخليّة واحدة

287
00:19:56,980 --> 00:19:59,760
.فإنه لا يستحقّ أن يكون الرامي الأساسي أبداً

288
00:20:04,440 --> 00:20:05,710
!بول

289
00:20:04,440 --> 00:20:05,710
.بول: وهي الرميات التي يرميها الرامي دون أن يتم إحتسابها كنقطة

290
00:20:14,480 --> 00:20:15,880
!الكرةُ الرابعة

291
00:20:17,090 --> 00:20:19,010
.القواعدُ ممتلئةٌ بالعدّائيين

292
00:20:19,010 --> 00:20:22,060
.[سوامورا] لم يُخرج أيّ لاعبٍ حتى الآن

293
00:20:35,920 --> 00:20:38,960
.لابدّ أنّك تمزح

294
00:20:38,960 --> 00:20:42,460
.ليس مُمتعاً رؤيةُ رامٍ يُحطّمُ نفسهُ بنفسِه

295
00:20:42,460 --> 00:20:44,630
.نحنُ من يُفترض بنا أن نحطّمه

296
00:20:45,320 --> 00:20:48,840
.لا تقلق بشأن سيّطرتك يا [سوامورا]

297
00:20:48,840 --> 00:20:51,370
.رمياتُك ما زالَ لديها بعضُ القوّة

298
00:20:59,210 --> 00:21:01,260
.لا تقلق

299
00:21:01,260 --> 00:21:02,520
.نحنُ هُنَا معك

300
00:21:04,320 --> 00:21:05,270
![سوامورا]

301
00:21:05,600 --> 00:21:07,970
!ثق بنا واجعل الكُرة تأتي إلى هُنَا

302
00:21:07,970 --> 00:21:09,560
!اهدئ! اهدئ

303
00:21:09,560 --> 00:21:11,030
!دعنا نُخرجه

304
00:21:11,030 --> 00:21:12,830
!انظر حولك

305
00:21:12,830 --> 00:21:14,160
!أنتَ لستً وحدك

306
00:21:14,520 --> 00:21:15,870
!كُن عُدوانيّاً

307
00:21:15,870 --> 00:21:17,110
!كُلّ ضاربٍ على حدى

308
00:21:17,110 --> 00:21:18,530
!ركّز على الضارب

309
00:21:22,010 --> 00:21:23,320
...لن أجعلَ

310
00:21:23,970 --> 00:21:26,180
.لن أجعلَ المُباراةَ تنتهي هكذا

311
00:21:27,270 --> 00:21:29,120
...لم أُقدّم

312
00:21:31,160 --> 00:21:33,560
.لم أُقدّم شيئاً يُذكر حتى الآن

313
00:21:45,560 --> 00:21:46,780
هل أنت جادّ؟

314
00:21:48,740 --> 00:21:50,150
!قم بالتغطية يا [سوامورا]

315
00:21:58,090 --> 00:22:00,210
![سوامورا]

316
00:23:36,340 --> 00:23:37,590
،رمياتهُ تملكُ بعض القوّة

317
00:23:37,590 --> 00:23:39,960
...لديهِ إرادةٌ قويّة للمواصلة ، لكن

318
00:23:39,960 --> 00:23:42,220
لم أستطع إخراج لاعبٍ واحد وأُريدُ أن أكون أوّل من يرمي؟

319
00:23:42,220 --> 00:23:43,220
كيف لي أن أكون نجم الفريق؟

320
00:23:43,600 --> 00:23:44,970
...أيُمكنُ أن ذلك الرامي

321
00:23:45,570 --> 00:23:49,990
.في هذه الحالة ، سيكونُ عديم الفائدة في بطولة الخريف

322
00:23:49,990 --> 00:23:53,510
.ما الذي أفعله؟ بطولةُ الخريف على وشك أن تبدأ

323
00:23:53,510 --> 00:23:56,490
:في الحلقة القادمة من بطل الملاعب
.المرحلة التالية

324
00:23:56,480 --> 00:23:58,480
المرحلة التالية

325
00:23:56,490 --> 00:23:58,950
.لا فائدةَ تُرجى منّي