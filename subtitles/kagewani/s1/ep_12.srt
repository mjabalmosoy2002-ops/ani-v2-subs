1
00:00:13,130 --> 00:00:16,990
حتّى باحِثي شركتي الموهوبين مذهولون

2
00:00:17,370 --> 00:00:21,900
يقولون أنّ بعد مجيئك، يسيرُ تطويرُ عقارنا
الجديد على قدم وساق

3
00:00:22,350 --> 00:00:26,000
وما الذي أردتَ أن تريني إيّاه؟

4
00:00:26,390 --> 00:00:28,890
لا داعي لإخفاء الأمر

5
00:00:28,890 --> 00:00:31,110
أنا وأنت نريدُ الشيء ذاته

6
00:00:31,110 --> 00:00:32,480
أليس كذلك؟

7
00:00:35,020 --> 00:00:35,850
الكاغيواني

8
00:00:36,510 --> 00:00:38,150
جيّد

9
00:00:39,570 --> 00:00:41,020
أنتَ تعلم إذاً

10
00:00:47,880 --> 00:00:48,760
ما هذا؟

11
00:00:50,190 --> 00:00:53,010
مُختبرنا

12
00:00:55,500 --> 00:00:58,060
فيما يلي، تقرير عن حالة العيّنة أ 69

13
00:00:58,060 --> 00:00:59,370
...بالمناسبة

14
00:00:59,650 --> 00:01:03,370
ماذا تعرفُ عنه؟

15
00:01:03,740 --> 00:01:07,200
أعرفُ فقط أنه وحش قديم يأكلُ الظِلال

16
00:01:08,030 --> 00:01:12,150
بدأنا بتحقيقاتنا بالبحثِ عن أصوله

17
00:01:12,490 --> 00:01:14,690
...كشفَت أبحاث في مخطوطات قديمة

18
00:01:14,690 --> 00:01:16,750
حوادث الاختفاء في مُقاطعة يونان

19
00:01:18,150 --> 00:01:20,240
كان السبب ورائها

20
00:01:21,210 --> 00:01:26,050
صُنِعَ الكاغيواني بواسطة قبيلتَين مُتناحرتَين
"باستخدام وسيلة تُدعى "كودوكو

21
00:01:26,540 --> 00:01:29,400
لإنهاءِ سلسلة الحروب بينهما

22
00:01:30,000 --> 00:01:32,630
تمّ تربيّة كافّة أنواع الحيوانات في حاوية مُفرَدة

23
00:01:32,630 --> 00:01:34,510
،ودُفِعَتْ لالتهام بعضها الآخر

24
00:01:34,510 --> 00:01:38,270
وبعد تكرار هذه العمليّة مرَّاتٍ كثيرة
بقي مخلوق واحد

25
00:01:38,890 --> 00:01:41,460
،أُطلِقَ على المخلوق المُتبقِّي اسم كاغيواني

26
00:01:41,460 --> 00:01:43,910
وضعَ هذا المخلوق حدّاً لحربِهما

27
00:01:44,300 --> 00:01:48,820
لكن فعلَ ذلك بالتهامِ كِلَي القبيلتَين

28
00:01:50,110 --> 00:01:53,250
،قتلَ كلّ ما وجدَه أمامه

29
00:01:54,200 --> 00:01:56,750
إلى أن هُزِمَ في قرية صيَّادي السمك شيماني

30
00:01:58,370 --> 00:01:59,730
صحيح

31
00:01:59,730 --> 00:02:01,590
لم يعُد الأصليّ موجوداً

32
00:02:01,590 --> 00:02:02,640
لكن

33
00:02:02,640 --> 00:02:06,420
،تبعثرَتْ خلاياه في كل أنحاء العالم

34
00:02:06,950 --> 00:02:11,050
وبدأنا نرى في العصرِ الحديث
مخلوقات متأثِّرة به

35
00:02:12,010 --> 00:02:15,280
تشكّلَتْ هذه "السُلالات" بواسطةِ خلايا الكاغيواني

36
00:02:15,670 --> 00:02:19,280
،كانَتْ تِلك التي حصلنا عليها قليلة الذكاء

37
00:02:19,990 --> 00:02:22,380
وتمتلك قدرات بدائية فقط

38
00:02:22,380 --> 00:02:29,120
لكن اكتشفنا أن نقاوات خليّة مختلفة
تمنح قدرات مختلِفة

39
00:02:29,620 --> 00:02:32,170
فبعضها لديها القدرة على تغيير انعكاسية الجسد

40
00:02:32,800 --> 00:02:35,170
ممّا سمحَ لها بتمويهِ نفسها وجذب الفريسة

41
00:02:36,070 --> 00:02:40,690
وأظهرَ بحثنا أنّها تناغمَتْ مع بعضها البعض

42
00:02:40,690 --> 00:02:43,140
وتجمّعَتْ هنا

43
00:02:43,560 --> 00:02:45,550
ماذا كان هذا المكان؟

44
00:03:01,870 --> 00:03:04,740
هذا هو طليعةُ أبحاث كاغيواني

45
00:03:04,740 --> 00:03:06,740
منطِقة فريق التجديد

46
00:03:06,740 --> 00:03:07,910
التجديد؟

47
00:03:07,910 --> 00:03:09,740
كيفَ حالُ نبات ألفا؟ أرسل البيانات

48
00:03:14,240 --> 00:03:18,880
هل تتذكّرُ البيضة التي عثرنا عليها في المجارير؟

49
00:03:20,580 --> 00:03:25,600
...استخرجنا من جسدِها السائلَ الذي يُجري هذه التغييرات

50
00:03:33,170 --> 00:03:36,740
وصنَعْنا مُستنسَخاً يُعَدُّ الأقرب إلى الوحش الأصلي

51
00:03:37,760 --> 00:03:39,140
ما رأيك؟

52
00:03:39,570 --> 00:03:42,760
هذا أعظم وحش قد صنعناه

53
00:03:44,440 --> 00:03:48,210
ما الذي يجري هنا بالضبط؟

54
00:03:48,210 --> 00:03:49,840
إنه ظلّ

55
00:03:49,840 --> 00:03:54,380
لهذا نردعُه بتسليطِ ضوء خاصّ
عليه من كافّة الاتِّجاهات

56
00:03:54,780 --> 00:03:58,210
،إن كنت بحاجة لهذا الجهاز فقط للتحكُّم بهذا الوحش

57
00:03:58,210 --> 00:03:59,730
فماذا ستفعلُ به إذاً؟

58
00:04:00,480 --> 00:04:06,550
معك حقّ، يُعَدُّ بهذا الشكل مجرَّد
وحش يهدِّدُ حياةَ البشرية

59
00:04:06,900 --> 00:04:10,040
لكنّه مختلِف

60
00:04:10,460 --> 00:04:15,900
لأنه يمتلِكُ قوّةَ الكاغيواني ويحافِظُ على عقله في نفس الوقت

61
00:04:17,020 --> 00:04:22,140
السببُ باعتقادِنا هو أنَّ خلايا الكاغيواني
قد اختلطَتْ بنبات

62
00:04:22,140 --> 00:04:25,510
فتطفّرَتْ إلى هذا المخلوق

63
00:04:26,390 --> 00:04:29,870
استخدمَ قوّة الكاغيواني للانتقام من أولئك

64
00:04:29,870 --> 00:04:31,820
الذين قد استغلُّوه

65
00:04:32,360 --> 00:04:35,360
بعبارة أخرى، إنه قابِل للسيطرة

66
00:04:36,260 --> 00:04:38,500
هل هو آمن؟

67
00:04:40,380 --> 00:04:41,360
أجل

68
00:04:42,280 --> 00:04:44,790
كان متعاوناً جداً

69
00:04:47,070 --> 00:04:49,660
هل نحتاجُ لأمن مُشدَّد إلى هذا الحد؟

70
00:04:49,660 --> 00:04:51,250
كلامك صحيح

71
00:04:51,250 --> 00:04:52,130
ألستُ كذلك؟

72
00:04:54,600 --> 00:04:56,510
ألا تشعر بالملل؟

73
00:04:56,880 --> 00:04:58,020
!ركِّز

74
00:04:58,020 --> 00:04:59,070
!لا مُشكلة

75
00:05:27,340 --> 00:05:30,090
يستحيلُ التحكُّم بهم

76
00:05:31,580 --> 00:05:34,940
إن ساءَ الأمرُ فسندخلُ منطقةَ الأمان فحسب

77
00:05:39,060 --> 00:05:43,960
لماذا تستمرُّ في تطبيقِ الأبحاث
على الكاغيواني إن كان يتطلّبُ كل هذه المُجازفات؟

78
00:05:43,960 --> 00:05:48,900
نفس السبب الذي دفعَ تِلك القبيلة
لاختراعه بالطبع

79
00:05:48,900 --> 00:05:50,500
سِلاح بيولوجي

80
00:05:51,200 --> 00:05:52,730
هل ستورِّط

81
00:05:54,140 --> 00:05:56,470
أبرياء مثل ساوري؟

82
00:05:57,560 --> 00:05:59,420
هذا لمنفعتِنا الشخصيّة

83
00:06:01,700 --> 00:06:02,500
!مهلاً

84
00:06:02,660 --> 00:06:03,770
ما الذي يجري؟

85
00:06:03,770 --> 00:06:05,460
المُستنسَخ مفقود

86
00:06:06,320 --> 00:06:09,130
والفتى، عيّنة البحث، قد اختفى أيضاً

87
00:06:10,110 --> 00:06:11,100
كيف؟

88
00:06:11,100 --> 00:06:13,210
حسبتُك قادراً على التحكُّم بهم

89
00:06:13,790 --> 00:06:16,070
لا أراك متوتِّراً

90
00:06:16,570 --> 00:06:18,940
إنه يستهدفُك أيضاً

91
00:06:19,510 --> 00:06:20,950
لا تقلق عليّ

92
00:06:20,950 --> 00:06:22,270
أنا جاهِز له

93
00:06:23,700 --> 00:06:24,720
!اللّعنة

94
00:06:24,720 --> 00:06:26,350
!أرسِلوا فريقَ الردع

95
00:06:26,350 --> 00:06:27,070
!بسرعة

96
00:06:47,920 --> 00:06:49,320
...كيمورا

97
00:06:57,140 --> 00:06:58,030
!انتظر

98
00:07:01,810 --> 00:07:02,600
!كيمورا

99
00:07:03,060 --> 00:07:05,150
!هل تنوي أن تكون الناجي الوحيد؟

100
00:07:05,150 --> 00:07:08,390
ما دمت على قيدِ الحياة، يمكنُك أن تبدأ
حياتك من جديد قدرَ ما تشاء

101
00:07:08,390 --> 00:07:09,450
!الوداع

102
00:07:10,310 --> 00:07:11,110
!كيمورا

103
00:07:12,050 --> 00:07:13,100
انتظر يا كيمورا

104
00:07:13,510 --> 00:07:14,300
!انتظر

105
00:07:37,910 --> 00:07:39,450
...بانبا-سينسي

106
00:07:40,260 --> 00:07:42,980
لا تلمْني على هذا، مفهوم؟