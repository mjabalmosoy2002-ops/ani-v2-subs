1
00:00:01,750 --> 00:00:03,890
هذا موضوعٌ لا أتنازل فيه

2
00:00:04,360 --> 00:00:09,050
أشعر أنّ هذه السيّارة ستصبح
أسرع مما تظنّ بعدما تجهز

3
00:00:13,640 --> 00:00:16,110
!لا أريد الموت! النجدة

4
00:02:01,900 --> 00:02:04,010
أأنت بخيرٍ يا أوغاتا-سان؟

5
00:02:05,170 --> 00:02:10,410
فهمتُ الآن تماماً كيف يقود الإلهيّون الخمسة عشر

6
00:02:10,410 --> 00:02:15,650
،أنت تعاني من انهيار بعض قواعد دماغك
كيف لا تكبح أبداً؟

7
00:02:16,090 --> 00:02:19,520
أليست السيّارة مزوّدة بالمكابح الجديدة
الرائعة من أوكوياما-سان؟

8
00:02:20,410 --> 00:02:23,690
أحاول تفادي الكبح قدر المستطاع
أثناء صعود تلّ

9
00:02:24,480 --> 00:02:29,120
تفقد السيّارة سرعةً طبيعيّاً
من مدخل الركن إلى القمّة

10
00:02:29,330 --> 00:02:33,080
،وبسيّارة أقلّ قوّة من نظيراتها مثل 86
فهذا النهج الأفضل نظريّاً

11
00:02:33,900 --> 00:02:37,630
،لكن بما أنّك كنت معي اليوم
،وكانت مجرّد قيادة تجريبيّة

12
00:02:37,870 --> 00:02:40,050
كنت أقود بقدرة 80% فحسب

13
00:02:40,050 --> 00:02:41,790
!ثمانون بالمئة فقط؟

14
00:02:43,750 --> 00:02:46,390
سأعاني صدمةً لفترة

15
00:02:46,390 --> 00:02:49,770
والاختلاف بين ملامح كاناتا الهادئة
وراء عجلة القيادة

16
00:02:49,770 --> 00:02:52,400
وحدّة إمساكه الانعطافيّة كانت مهولة

17
00:02:53,770 --> 00:02:57,710
أوغاتا-سان، هل من غير المسموح إجراء
دورة حول مضمار أشينوكو حقّاً؟

18
00:02:58,480 --> 00:03:01,220
إنّه على مرآتنا تماماً

19
00:03:01,220 --> 00:03:03,780
"تقصد على "مرآنا

20
00:03:04,670 --> 00:03:08,860
تحوي تلك المنطقة شوارع عموميّة
تحت تحكّم حركة مروريّة صارم

21
00:03:08,860 --> 00:03:12,870
لا يُسمح لأحدٍ بالسباق عليها
لحين بدء التصفيات الرسميّة

22
00:03:13,310 --> 00:03:15,880
لذا هذه المرّة، يعتمد كلّ شيء على التصفيات

23
00:03:16,250 --> 00:03:20,840
يقولون أنّ ذلك يعطي أفضليّة كبيرة للمُتسابقين
الدائمين الذين تسابقوا فيه قبلاً

24
00:03:21,510 --> 00:03:26,930
الجزء الوحيد المُصرّح لقيادة "إم إف جي" اختباريّة
هو هذا المقطع بمنفذ الرسوم

25
00:03:27,290 --> 00:03:30,710
وللسبعة أيام المؤدية إلى التصفيات وحسب

26
00:03:32,540 --> 00:03:35,190
سأرى كيف تعمل السيّارة تحت الضغط

27
00:03:35,790 --> 00:03:37,910
انتظر هنا من فضلك يا أوغاتا-سان

28
00:03:39,540 --> 00:03:41,590
سآتي لأخذك بعد خوضي لدورتين

29
00:03:41,590 --> 00:03:46,010
فلتفعل ذلك، لا أصلح لأكون ملّاحك

30
00:03:59,920 --> 00:04:02,570
كاد يُغمى عليّ عدّة مرّات

31
00:04:10,860 --> 00:04:15,940
تلك الألبين الزرقاء بدا أنّها
كانت تلاحق سيّارتنا

32
00:04:16,470 --> 00:04:18,500
يراودني شعورٌ سيّئ

33
00:04:34,910 --> 00:04:39,540
أعتقد أنّي ربما كنت فظّاً مع السيّد أوكوياما

34
00:04:42,090 --> 00:04:44,590
لم أتوقّع أن تتغيّر القيادة لهذه الدرجة

35
00:04:45,230 --> 00:04:47,010
إنّها بمثابة سيّارة مختلفة كليّاً

36
00:04:47,660 --> 00:04:51,350
،كيف يا ترى؟ قال أنّه لم يمسّ المُحرّك

37
00:04:51,350 --> 00:04:54,100
لكنّها تبدو أكثر قوّة بالتأكيد

38
00:04:58,860 --> 00:05:00,690
وبغاية الخفّة

39
00:05:00,960 --> 00:05:03,440
تحسّن إمساكها الميكانيكيّ لحدٍّ ملحوظ

40
00:05:03,440 --> 00:05:06,030
وماصّات الصدمات تعمل بسلاسة
كما لو كانت تغنّي

41
00:05:06,830 --> 00:05:10,290
سيفيد كلّ هذا في السباق المُتقارب

42
00:05:19,030 --> 00:05:22,630
هذه المكابح جيّدة بشكلٍ خاص

43
00:05:22,630 --> 00:05:25,800
تمتلك لمسة قاسية لها، كما لو
كانت سيّارة سباقات حقيقيّة

44
00:05:26,120 --> 00:05:28,260
يلائمني هذا الشعور تماماً

45
00:05:28,500 --> 00:05:31,640
أشعر أنّ بإمكاني إطلاق العنان
لنفسي كلّياً المرّة التالية

46
00:05:45,940 --> 00:05:49,360
هذا تجاوز عدائيّ بالنظر
لعدم كونه سباقاً

47
00:05:50,370 --> 00:05:52,580
انتظر، لحظة وحسب

48
00:05:52,810 --> 00:05:56,910
لطالما حذّرني فوجيوارا-سينسي
أنّ أكبر سذاجة ممكنة

49
00:05:57,270 --> 00:05:59,650
هي ترك المشاعر تغلبك
وراء عجلة القيادة

50
00:06:00,370 --> 00:06:02,590
تحمّستُ بتطوّر 86

51
00:06:02,970 --> 00:06:06,550
وأهملت ونسيت الانتباه لمرآة رؤيتي الخلفيّة

52
00:06:07,310 --> 00:06:08,840
...السيّارة رقم 4

53
00:06:09,520 --> 00:06:13,850
كما يليق بالمركز الذي حقّقه العام الفائت، إنّه سريع

54
00:06:17,500 --> 00:06:19,960
لم أتوقّع أن أصادفك هنا

55
00:06:20,680 --> 00:06:22,080
يا كاناتا ريفينغتون

56
00:06:25,890 --> 00:06:29,530
خلال الأعوام الثلاثة التي أمضيتها
،بدراسة سباقات السيّارات في فرنسا

57
00:06:30,100 --> 00:06:32,780
تنافسنا في السباقات نفسها مراراً وتكراراً

58
00:06:33,220 --> 00:06:35,790
،لعلّك لا تتذكّرني

59
00:06:36,480 --> 00:06:42,490
لكن بكلّ الانتباه الذي حظيت به بصفتك
المُبتدئ الجديد الصاعد، برز نجمك لي

60
00:06:45,650 --> 00:06:51,260
مشاكل التمويل أدّت إلى قيادتي خرداً في سلسلة
يورو إف إي 3"، فمررت بوقتٍ عصيب"

61
00:06:51,670 --> 00:06:55,970
لكن في بحيرة أشينوكو، لنكمل من حيث
توقّفنا في بول ريكارد وهوكّينهايم

62
00:06:56,960 --> 00:06:59,930
يسرّني أنّك هنا يا كاناتا ريفينغتون

63
00:07:00,970 --> 00:07:03,310
"مرحباً بك في "إم إف جي

64
00:07:08,960 --> 00:07:13,530
لذيذ، هذه الحلويّات اليابانيّة رائعة

65
00:07:14,120 --> 00:07:19,330
سيتفاجأ البريطانيّون من مدى رخص ثمن
وتنوّع هذه الأشياء هنا

66
00:07:19,550 --> 00:07:21,720
أنت تبالغ كثيراً

67
00:07:24,220 --> 00:07:26,170
أصدرت "إم إف جي" بياناً صحفيّاً

68
00:07:26,170 --> 00:07:30,120
يبدو أنّه تمّ الإعلان عن ترتيب
"تصفيات أشينوكو "جي تي

69
00:07:30,120 --> 00:07:32,630
متى سنشارك؟

70
00:07:33,240 --> 00:07:36,470
،وجدته، توقّعت هذا نوعاً ما
لكنّنا سنشارك في اليوم السادس

71
00:07:36,470 --> 00:07:40,990
هل تحدّد قاعدة ما ترتيب التصفيات؟

72
00:07:45,030 --> 00:07:51,190
للسعي للإنصاف، يوزّعون السائقين ذوي المراكز
الأعلى على مدى الأيام السبعة

73
00:07:51,190 --> 00:07:54,860
السائق صاحب المركز الأعلى يشارك
في اليوم الختاميّ دوماً

74
00:07:55,080 --> 00:07:57,830
انظر، سيشارك بيكينباور في اليوم السابع

75
00:07:57,830 --> 00:08:00,440
لا أستطيع قراءة اليابانيّة

76
00:08:00,440 --> 00:08:03,510
سيشارك صاحب المركز الثاني إيشيغامي
في اليوم السادس السابق له

77
00:08:03,510 --> 00:08:06,040
وسائق الفيراري أكابا في اليوم الخامس

78
00:08:06,040 --> 00:08:10,670
إكمالاً من ذاك المنطق، سيضعك
مركزك التاسع في اليوم السادس

79
00:08:10,670 --> 00:08:14,880
ليس سيّئاً، يُقال أنّ الأفضليّة للمُشاركة المتأخّرة

80
00:08:14,880 --> 00:08:19,510
،سيكون لديك جدول زمن منافسيك
فسيسهل عليك تحديد هدف

81
00:08:20,070 --> 00:08:25,480
بالنسبة لنا، يعني ذلك امتلاكنا لفكرة عن السرعة
التي سنستهدفها للتأهّل للسباق

82
00:08:25,740 --> 00:08:27,100
فهمتك

83
00:08:27,500 --> 00:08:30,720
،وبتعديلات السيّد أوكوياما المذهلة للسيّارة

84
00:08:31,070 --> 00:08:34,200
أعتقد أنّي سأستطيع تقديم أفضل أدائي

85
00:08:34,770 --> 00:08:40,660
يُفترض أن آخذ 86 إلى "سبايرل" من جديد
قبل التصفيات لفحصٍ أخير

86
00:08:41,030 --> 00:08:43,760
أهنالك ما تريد أن أسألهم عنه؟

87
00:08:43,760 --> 00:08:46,200
لا شيء، إنّها مثاليّة

88
00:08:47,660 --> 00:08:50,710
سأطلب المزيد من الحلويّات، أتريد شيئاً؟

89
00:08:51,050 --> 00:08:53,060
لقد اكتفيت

90
00:09:00,080 --> 00:09:03,690
مناوبتي التالية ستكون في اليومين
الثالث والرابع إذاً؟

91
00:09:06,630 --> 00:09:09,060
مرحباً من أوداوارا في اليابان

92
00:09:09,780 --> 00:09:13,800
"أنقل تحيّتي إلى كافّة مشاهدي "إم إف جي
الثلاثين مليوناً حول العالم

93
00:09:13,800 --> 00:09:18,820
يقترب الموسم الماطر، لكنّ سماء هاكوني مُزرقة صحوة

94
00:09:19,120 --> 00:09:23,290
تغيّر التقويم إلى يونيو، وحان اليوم الأوّل
"في تصفيات أشينوكو "جي تي

95
00:09:24,020 --> 00:09:29,330
مضمار السباق الثاني للموسم يحيط
ببحيرة أشينوكو ويبلغ طوله 25.3 كيلومتراً

96
00:09:29,640 --> 00:09:33,210
،تتألّف التصفيات من دورة واحدة
بينما السباق من ثلاث دورات

97
00:09:34,230 --> 00:09:41,040
ها هو صاحب المركز السابع في سيّارة
لامبرغيني هوراكان، أويشي دايغو

98
00:09:45,990 --> 00:09:48,850
المشاركة في يوم التصفيات الأوّل مزعجة حقّاً

99
00:09:49,590 --> 00:09:52,420
سيتعيّن عليّ خوض مخاطر إضافيّة والتسابق بهجوميّة

100
00:10:00,220 --> 00:10:02,100
!لنفعلها يا هوراكان

101
00:10:02,860 --> 00:10:04,410
!أسمعيني زئير الأسطوانات العشر

102
00:10:12,610 --> 00:10:14,030
"إم إف غوست"

103
00:10:18,550 --> 00:10:20,040
"إم إف غوست"

104
00:10:25,680 --> 00:10:32,540
يا للسرعة! يقطع أويشي دايغو في لامبرغيني
!هوراكان رقم 3 المضمار محلّقاً

105
00:10:33,110 --> 00:10:37,880
في "أوداوارا بايكس بيك"، تجاوز منافساً
في تقاطع كازاماتسوري الشرقيّ

106
00:10:37,880 --> 00:10:40,820
مُظهراً فخر سائق السيّارة الإيطاليّة الخارقة

107
00:11:03,780 --> 00:11:05,430
نراك لاحقاً يا كاتاغيري-كن

108
00:11:05,430 --> 00:11:06,640
سنعود عمَّ قريب

109
00:11:06,910 --> 00:11:08,460
شكراً على زيارتكم

110
00:11:09,890 --> 00:11:11,320
إنّه ظريف

111
00:11:11,320 --> 00:11:14,110
لطيفٌ على العين حقّاً

112
00:11:14,110 --> 00:11:17,700
كاتاغيري-كن، هل كتبت هذا الطلب؟

113
00:11:17,700 --> 00:11:21,450
أجل. أعتذر، هل ارتكبتُ خطأً؟

114
00:11:21,450 --> 00:11:26,160
لا، إنّه مثالي. متى تعلّمت كتابة اليابانيّة؟

115
00:11:26,440 --> 00:11:30,620
كان ذلك بالتقليد فحسب، نسختُ كتابة أحدهم بالنظر لها

116
00:11:32,060 --> 00:11:33,530
نحن جاهزون للطلب

117
00:11:33,900 --> 00:11:35,380
أجل، سآتيكم فوراً

118
00:11:37,620 --> 00:11:40,050
ذاكرته مُذهلة

119
00:11:40,380 --> 00:11:45,510
وخطّه واضحٌ لحدّ مبهر بالنسبة
لشخص أتى لليابان لتوّه

120
00:11:45,850 --> 00:11:48,470
كما أنّه وسيمٌ ومراعٍ للمشاعر

121
00:11:48,470 --> 00:11:52,980
أشعر أنّنا نتلقّى زيارات متكرّرة أكثر
من النساء مُذ قمت بتعيينه

122
00:11:53,290 --> 00:11:56,470
لا يسعني طلب أكثر من هذا حقّاً

123
00:12:05,570 --> 00:12:09,540
مايزونو كازوهيرو في رقم 13
يبحر في عرم المضمار

124
00:12:10,120 --> 00:12:14,010
للتقيّد بالقواعد، نزع المحرّكات الكهربائيّة الثلاثة
،ونظام استرجاع الطاقة الحركيّة

125
00:12:14,010 --> 00:12:18,590
مما أدّى إلى هوندا "إن إس إكس" ذات وزن أخفّ
مولودة من جديد ذات دفع خلفيّ ومحرّك أوسط

126
00:12:25,720 --> 00:12:28,220
كنتُ أنتظر هذه اللحظة

127
00:12:28,670 --> 00:12:31,430
بلغنا هذه المرحلة أخيراً بعد عامين

128
00:12:32,290 --> 00:12:35,800
شارك مايزونو بهذه السيّارة
،العام الفائت أيضاً

129
00:12:35,800 --> 00:12:40,110
لكن أدّت مشاكل في إعادة ضبط حاسوبه
إلى انخفاض أدائه عمَّ كان يتوقّع

130
00:12:41,310 --> 00:12:44,530
،في "إم إف جي"، يمكنك تبديل طراز سيّارتك

131
00:12:44,530 --> 00:12:48,120
لكن يجب أن تكون لنفس الصانع
من سباقك الأوّل في الموسم

132
00:12:48,790 --> 00:12:52,300
ولذا، بدأ مايزونو العام في سيفيك

133
00:12:53,570 --> 00:12:55,580
،لكنّه يقود "إن إس إكس" الآن

134
00:12:55,580 --> 00:12:59,670
آلة قتاليّة يابانيّة فائقة السرعة
"تضاهي "جي تي-آر

135
00:13:00,260 --> 00:13:02,540
!لنرَ ما الذي سيستطيع فعله بها

136
00:13:05,500 --> 00:13:08,590
ما الخطب يا مايزونو؟ أنت تضحك منذ فترة

137
00:13:08,590 --> 00:13:12,930
،أستطيع سماع ذلك من قناة الاتّصال
وهو يُنفرني، لذا توقّف

138
00:13:13,690 --> 00:13:15,480
أنا أحاول مقاومة نفسي

139
00:13:15,740 --> 00:13:18,480
لكن يصعب احتواء مشاعري

140
00:13:18,690 --> 00:13:22,650
أنت تقود بسرعة هائلة وتخوض
!مخاطر كثيرة! اهدأ قليلاً

141
00:13:22,650 --> 00:13:24,110
أتمازحني؟

142
00:13:24,360 --> 00:13:26,320
هذه السيّارة تدفعني

143
00:13:26,320 --> 00:13:29,570
ليست راضيةً بعد وتريدني أن أضغط أكثر

144
00:13:29,980 --> 00:13:32,030
لذا اصمت وشاهد فقط

145
00:13:32,030 --> 00:13:36,840
"لا تعترض لحظة مجدي ومجد "إن إس إكس

146
00:13:39,990 --> 00:13:42,550
،"يتجاوز مايزونو كازوهيرو في رقم 13، "إن إس إكس

147
00:13:42,550 --> 00:13:47,820
زمن أويشي دايغو في اللامبرغيني ويعتلي
جدول الترتيب للوقت الراهن

148
00:13:48,230 --> 00:13:50,550
لكن لا يزال هذا اليوم الأوّل فحسب

149
00:13:51,060 --> 00:13:57,370
يترقّب بقيّة المحاربين الإلهيّين الخمسة عشر
فرصتهم لدخول المضمار

150
00:14:15,370 --> 00:14:16,660
!هاجمي أكثر يا نوزومي

151
00:14:16,660 --> 00:14:17,850
!أنتِ تتراخين

152
00:14:17,850 --> 00:14:19,620
اصمت وحسب

153
00:14:19,990 --> 00:14:25,080
تفهمين، صحيح؟ المشاركة في اليوم الثاني تعني
!أنّه يجب أن تكوني الثالثة على الأقلّ

154
00:14:25,080 --> 00:14:27,210
!اصمت يا أخي! أنت تشتّت انتباهي

155
00:14:32,050 --> 00:14:33,470
!أيّتها السائقة الفاشلة

156
00:14:33,470 --> 00:14:36,010
!كفّي عن أرجحة مؤخرتك! لا يريد أحد رؤية ذلك

157
00:14:36,780 --> 00:14:39,190
!اخرس أيّها الصبيّ المزعج

158
00:14:39,190 --> 00:14:42,860
!ياماتاني-كن، اطرد ذاك الأحمق من الحجرة

159
00:14:42,860 --> 00:14:46,290
ماذا يا نوزومي؟ كيف تستعملين
هذا السلوك مع أخيكِ؟

160
00:14:44,530 --> 00:14:46,820
هكذا الحال دوماً في كلّ سباق تصفيات

161
00:14:46,290 --> 00:14:49,360
!تصرّف كأخٍ إذاً وأعطني نصائح مفيدة

162
00:14:47,400 --> 00:14:49,790
،يتناوشان ويستفزّان بعضهما

163
00:14:49,360 --> 00:14:50,280
!كفّي عن التصرّف كطفلة

164
00:14:49,790 --> 00:14:52,830
لكن تحقّق نوزومي-تشان زمناً رائعاً
في النهاية لسببٍ ما

165
00:14:50,990 --> 00:14:52,240
ما الذي تفعلينه يا حمقاء؟

166
00:14:52,240 --> 00:14:53,700
!يا إلهي! اصمت وحسب

167
00:14:56,500 --> 00:14:58,490
مرحباً" يا آيبا-سينباي"

168
00:14:59,370 --> 00:15:01,370
يسرّني لقاؤك هنا

169
00:15:01,370 --> 00:15:03,710
مرحباً بالفرنسيّة؟

170
00:15:03,710 --> 00:15:05,840
أين كنت أثناء السباق الافتتاحي؟

171
00:15:06,140 --> 00:15:11,040
صادف أنّه أُجري في نفس يوم عيد
ميلاد حبيبتي، فكنت في شيبويا

172
00:15:11,040 --> 00:15:12,800
لم يكن بيدي خيار

173
00:15:13,300 --> 00:15:17,470
دعني أعرّفك عليه، هذا أكيموتو الذي
يعمل ميكانيكيّاً لي هذا العام

174
00:15:17,470 --> 00:15:18,270
مرحباً

175
00:15:18,270 --> 00:15:19,400
سُررت بلقائك

176
00:15:19,400 --> 00:15:21,400
هذا الشاب مثيرٌ للاهتمام

177
00:15:21,400 --> 00:15:26,180
،إنّه يواعد ذوات السبعة عشر عامٍ فحسب
إنّه "لوليكون" ميؤوس منه

178
00:15:26,800 --> 00:15:29,490
ذلك ليس دقيقاً يا سينباي

179
00:15:29,790 --> 00:15:32,100
"لا أمتلك نفس ميول "اللوليكون

180
00:15:32,100 --> 00:15:35,320
،إن كنت سأطلق على حالتي اسماً
فهي عقدة السابعة عشر

181
00:15:35,610 --> 00:15:36,860
ما معنى ذلك؟

182
00:15:37,310 --> 00:15:42,290
،وقعت في الحبّ لأوّل مرّة في الابتدائيّة
كانت الأخت الكبرى لصديقٍ لي

183
00:15:43,040 --> 00:15:46,340
السترة التي ارتدتها مع زيّها
جعلتها تبدو بغاية النضج

184
00:15:46,650 --> 00:15:48,090
وأعتقد أنّها كانت في السابعة عشر

185
00:15:48,090 --> 00:15:50,290
ما قصدك بـ "تعتقد"؟ يا للإبهام

186
00:15:51,380 --> 00:15:54,010
لم أحمل أيّ اهتمام بالفتيات في سنّي

187
00:15:54,440 --> 00:15:59,440
حصلت على حبيبتي الأولى في سنتي الثانية
في الإعداديّة، كانت طالبة ثانويّة في السابعة عشر

188
00:15:59,440 --> 00:16:02,230
وعلى نحوٍ مُتوقّع، هجرتني بعد أسبوع

189
00:16:02,510 --> 00:16:06,690
مُذ حينها، الفتيات في السابعة عشر
وحدهنّ يبدين كنساءٍ لي

190
00:16:07,460 --> 00:16:12,070
،حتّى عندما كنت في فرنسا، واعدت أربع فتيات
وكنّ في السابعة عشر جميعاً

191
00:16:12,780 --> 00:16:13,740
أليس ذلك مُذهلاً؟

192
00:16:13,970 --> 00:16:16,240
أنت منحرفٌ بحقّ

193
00:16:16,240 --> 00:16:22,330
لديّ سؤال، ما الذي يحصل عندما تبلغ
الفتاة التي تواعدها الثامنة عشر؟

194
00:16:22,570 --> 00:16:23,520
أهجرها

195
00:16:24,170 --> 00:16:25,920
أنت مُضحك

196
00:16:26,410 --> 00:16:29,130
سلوكه يعارض مظهره كليّاً

197
00:16:29,400 --> 00:16:33,010
لن تراني أفعل ذلك، يستحيل أن
أواعد طالبات في السابعة عشر

198
00:16:33,010 --> 00:16:37,430
إن كنت سأواعد امرأة، يجب أن تكون مثيرة وناضجة

199
00:16:37,660 --> 00:16:41,890
سينباي، أنت تقلّل من إمكانيّات ذوات
سنّ السابعة عشر

200
00:16:42,160 --> 00:16:43,850
إنّهن منيعات

201
00:16:44,560 --> 00:16:47,310
حسناً، يجب أن أدخل وضعيّة التأهّب، لذا أستأذنكما

202
00:16:47,310 --> 00:16:50,220
أجل، لا تدع مايزونو يغلبك

203
00:16:56,540 --> 00:16:59,820
إنّه رجلٌ غريب، ساواتاري كوكي هذا

204
00:16:59,820 --> 00:17:04,220
أجل، قد يكون مُنحرفاً، لكنّ
مهارته في القيادة فائقة

205
00:17:04,630 --> 00:17:08,340
يبرع تحديداً في المضمار التقنيّ
مثل بحيرة أشينوكو

206
00:17:09,130 --> 00:17:14,340
من ناحية الإمكانيّة الكامنة، قد يكون الوحيد
الذي يستطيع مضاهاة بيكينباور

207
00:17:14,340 --> 00:17:16,360
أهو قويّ لذاك الحدّ؟

208
00:17:16,360 --> 00:17:20,120
مع ذلك، يفتقر لأيّ طموح حقيقيّ

209
00:17:20,120 --> 00:17:23,310
ونقطة ضعفه الكبرى هي عدم امتلاكه للدافع

210
00:17:24,050 --> 00:17:28,900
بالنسبة له، المشاركة في "إم إف جي" هي
طريقة لجني المال، لا يأخذها على محمل الجدّ

211
00:17:29,120 --> 00:17:33,220
،لكن إن حفّزه شيء على القيادة بجديّة
يصبح خطيراً جدّاً

212
00:17:34,790 --> 00:17:39,360
ومع إبراز كاناتا لنفسه على الساحة، يبدو
أن الكثير من المُنافسين الشبّان بدؤوا بالصعود

213
00:17:40,050 --> 00:17:44,330
لكنّي لا أزال في الخامسة والعشرين، لا أريد
أن أُجمع مع المُسنّنين أولئك

214
00:17:44,950 --> 00:17:48,970
وهذه المرّة، سأحصل على قُبلة
رقم 7 مهما حصل

215
00:17:55,300 --> 00:17:59,800
بما أنّي تغيّبت عن السباق الأوّل، ولتوجّب
،حفاظي على رفاهيّة عزيزتي سانا

216
00:18:00,430 --> 00:18:02,190
عليّ بذل جهدٍ حقيقيّ

217
00:18:09,460 --> 00:18:12,860
ها هو ساواتاري كوكي في رقم 4 ينطلق

218
00:18:12,860 --> 00:18:17,450
إنّه سائق بإمكانيّة غامضة مما
يجعل مشاهدته حماسيّة

219
00:18:21,620 --> 00:18:25,080
تجاوز مهبط الهليكوبتر  ويعبر ركن الماعز

220
00:18:25,080 --> 00:18:27,140
كلّ شيء سلس إلى الآن

221
00:18:30,500 --> 00:18:33,460
مُختبر موازنة عجلات ثلاثيّ الأبعاد؟

222
00:18:33,460 --> 00:18:36,670
مُذهل، لديكم أشياء كهذه؟

223
00:18:36,970 --> 00:18:39,970
يستحيل أن أحلم بتحمل تكلفة واحد لورشتي المتواضعة

224
00:18:40,340 --> 00:18:46,140
الموازنة هي خطّ الحياة إن أردت
استخراج 100% من تعليق السيّارة

225
00:18:46,500 --> 00:18:52,220
وبالنظر لمستوى السائق العالي، أنوي
إضافة كلّ ما لديّ في هذا

226
00:18:52,220 --> 00:18:54,940
بدا كاناتا مُتحمساً أكثر من المعتاد أيضاً

227
00:18:54,940 --> 00:18:57,320
كان يقول باستمرار أنّ كلّ شيءٍ مثاليّ

228
00:18:57,320 --> 00:18:58,650
يشرّفني ذلك

229
00:18:59,680 --> 00:19:04,200
لم يخطر لي أن أقوم بعمل مساند
لتلميذ لـ فوجيوارا تاكومي

230
00:19:04,870 --> 00:19:06,860
أشعر بالامتنان لكوني في هذا المجال

231
00:19:08,830 --> 00:19:09,750
!سريعٌ جدّاً

232
00:19:11,010 --> 00:19:14,840
!دخل المقطع الثاني بأسرع زمنٍ إلى الآن

233
00:19:16,100 --> 00:19:19,440
عرضٌ مذهل للسرعة جعله
!يتجاوز المقطع الأوّل طائراً

234
00:19:19,440 --> 00:19:21,970
!وكان زمناً قياسيّاً جديداً لذاك المسار

235
00:19:39,870 --> 00:19:42,400
ما الذي أصاب ساواتاري اليوم؟

236
00:19:42,900 --> 00:19:45,390
من الغريب بما يكفي أنّه
...تغيّب عن السباق الافتتاحي

237
00:19:45,390 --> 00:19:49,200
لا أعلم ما إن بدا بهذه الحدّة
في التصفيات من قبل

238
00:19:49,200 --> 00:19:51,750
!ينتقل من المقطع الثاني للمقطع الثالث

239
00:19:51,980 --> 00:19:55,690
لا يزال في طريقه لتحقيق زمن
!قياسيّ جديد للمضمار

240
00:19:58,530 --> 00:20:03,590
كان يُقال باستمرار أنّه يمتلك الإمكانيّة الكامنة
"الأعلى بين كافّة سائقي "إم إف جي

241
00:20:03,920 --> 00:20:07,320
لطالما كان دافعه هي مشكلته الكبرى

242
00:20:07,320 --> 00:20:09,410
هل استيقظ العبقريّ النائم؟

243
00:20:10,150 --> 00:20:13,190
ما الذي دهى ساواتاري كوكي بالضبط؟

244
00:20:13,730 --> 00:20:17,410
هل نحن على وشك أن نشهد
زمن دورة خارق لا مسبوق؟

245
00:20:17,410 --> 00:20:19,690
!إن حصل ذلك، سيكون موضوعاً هائلاً

246
00:20:21,150 --> 00:20:25,610
رأيت؟ كما أخبرتك، يمكنه تقديم
أشياء كهذه عندما يكون جاداً

247
00:20:26,270 --> 00:20:29,420
سيحطّم رقم المضمار القياسيّ

248
00:20:29,990 --> 00:20:35,010
هذا المسار المُستقيم الوحيد على مضمار
يكاد يخلى منها

249
00:20:35,010 --> 00:20:37,880
إنّه يخترق مسار التتابع المستقيم بالسرعة الكاملة

250
00:20:38,290 --> 00:20:44,740
وباقتراب خطّ النهاية، يصل آخر مُرتقى للمضمار

251
00:20:47,490 --> 00:20:51,970
يدفع محرّك توربو الهيكل خفيف الوزن
!صعوداً للمنحدر بقوّة هائلة

252
00:20:52,390 --> 00:20:54,890
!ما الزمن الذي سنشهده؟

253
00:21:03,690 --> 00:21:08,120
يا إلهي، يبدو أنّ المفاجآت
لا تنقطع هذا العام

254
00:21:08,730 --> 00:21:10,910
يسرّني ذلك بصفتي المُنظّم

255
00:21:10,910 --> 00:21:15,330
،كلّما زاد عدد نجوم الاستعراض
لمعت ساحة "إم إف جي" أكثر

256
00:21:17,040 --> 00:21:20,380
مرحباً، سانا؟ إنّه أنا، فعلتها

257
00:21:21,000 --> 00:21:22,690
حقّقت زمناً قياسيّاً جديداً للمضمار

258
00:21:24,740 --> 00:21:26,720
أجل، لا أزال في هاكوني

259
00:21:27,210 --> 00:21:30,560
سأرجع عمَّ قريب، لذا لمَلا
نخرج في شيبويا؟

260
00:21:30,560 --> 00:21:32,130
أحبّكِ يا عزيزتي

261
00:23:32,070 --> 00:23:36,370
الحلقة القادمة، المنعطف 12: إدراك موروث