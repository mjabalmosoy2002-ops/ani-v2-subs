1
00:00:40,770 --> 00:00:44,350
المخاوف البيئيّة والشحّ المُتصاعد للوقود الأحفوريّ

2
00:00:48,760 --> 00:00:52,770
ونتيجةً لذلك، أصبحت السيّارات الرياضيّة
فائقة القوّة مهدّدةً بالبياد

3
00:00:53,600 --> 00:00:58,520
وكما لو كانت تلحّن قدّاساً لندب
زوالها الوشيك، ظهرت في اليابان

4
00:00:58,830 --> 00:01:00,660
سلسلة سيّارات سباق جديدة

5
00:01:01,150 --> 00:01:05,660
،بمتابعة عالميّة تناهز 30 مليون مشترك

6
00:01:06,230 --> 00:01:08,810
حقّقت شعبيّةً مُتفجّرة

7
00:01:10,900 --> 00:01:15,640
المُتطلّب الوحيد هو معدّل
قبضة ووزن مُنتظم

8
00:01:16,360 --> 00:01:19,760
مما يؤدي إلى سباقات خالية القيود مُشتعلة الحماس

9
00:01:20,900 --> 00:01:23,970
"واسمها: "إم إف جي

10
00:01:31,680 --> 00:01:34,820
،إنّه سباق "إم إف جي" الافتتاحيّ للموسم
"ونحن هنا في "أوداوارا بايكس بيك

11
00:01:34,820 --> 00:01:37,820
!لبدء اليوم الثاني للتصفيات

12
00:01:40,090 --> 00:01:41,290
عشر ثوانٍ للانطلاق

13
00:01:41,290 --> 00:01:43,740
،تسع، ثمان، سبع

14
00:01:44,210 --> 00:01:47,160
،ستّ، خمس، أربع

15
00:01:47,160 --> 00:01:49,920
ثلاثة، اثنان، واحد

16
00:02:00,090 --> 00:02:02,460
!انطلق يا آيبا! أنت لها

17
00:02:02,770 --> 00:02:04,330
!إنّه مُندفع

18
00:02:05,280 --> 00:02:07,060
إم إف جي"؟"

19
00:02:07,320 --> 00:02:11,170
ليتني أستطيع رؤية سباقهم
شخصيّاً ولو لمرّة

20
00:02:11,170 --> 00:02:14,770
ذلك مستحيل، فهم لا يسمحون
،باصطفاف المُتفرّجين على المسار

21
00:02:14,770 --> 00:02:19,650
ولا يزال توجد غازات بركانيّة
في الهواء من ذاك الثوران

22
00:02:19,940 --> 00:02:22,910
كان كلّ رفاقي في إنجلترا
مهووسون به أيضاً

23
00:02:22,910 --> 00:02:25,440
لا عجب أنّه شعبيّ هنا
بما أنّ اليابان هي مُنطلقه

24
00:02:26,610 --> 00:02:31,400
،لا أستطيع فهم العنوانين هنا في اليابان
يا للانطلاقة الصعبة

25
00:02:33,240 --> 00:02:34,920
مرحباً، واكانا؟

26
00:02:34,920 --> 00:02:37,710
سيأتي الإنجليزيّ اليوم، صحيح؟

27
00:02:37,710 --> 00:02:41,420
بدقّة، إنّه نصف إنجليزيّ ونصف يابانيّ

28
00:02:43,640 --> 00:02:46,290
فلا أستشعر ذبذبات رائعة من إنجلترا

29
00:02:46,610 --> 00:02:49,330
!لا تقولي هذا الكلام المُمل

30
00:02:49,330 --> 00:02:51,570
!فلتعرّفيني عليه إن كان وسيماً

31
00:02:52,130 --> 00:02:53,980
...يا إلهي، واكانا تلك

32
00:02:53,980 --> 00:02:58,190
ارتباطكِ برجال تافهين يرجع لأنّكِ
تلاحقين أيّ وسيم وحسب دوماً

33
00:02:59,330 --> 00:03:01,670
لا أستطيع تخيّل الوقوع
في الحُبّ من أوّل نظرة أبداً

34
00:03:03,170 --> 00:03:05,660
المعذرة، أنا آيبا شون

35
00:03:05,910 --> 00:03:11,290
،حقّقتُ المركز التاسع العام الفائت
...ومُذ... لحظة رؤيتي لكِ

36
00:03:12,210 --> 00:03:14,500
!بأيّ حال، أنا جاد

37
00:03:14,720 --> 00:03:15,690
آسفة

38
00:03:15,690 --> 00:03:16,380
!ردٌّ سريع

39
00:03:16,850 --> 00:03:21,220
لا أعلم ما الذي تتوقّعه منّي بينما
لا تعرف شيئاً عنّي

40
00:03:21,420 --> 00:03:23,330
!ا-انتظري رجاءً

41
00:03:23,640 --> 00:03:26,300
،على صفحة ملفّات ملائكة "إم إف جي" الشخصيّة

42
00:03:26,300 --> 00:03:29,020
كنتِ الوحيدة بلا أيّة معلومات شخصيّة، صحيح؟

43
00:03:29,020 --> 00:03:32,350
هلّا أخبرتِني باسمكِ على الأقلّ؟

44
00:03:35,370 --> 00:03:37,550
"إم إف جي إيه 7"

45
00:03:37,550 --> 00:03:41,110
يمكنك مناداتي برقم 7 إن أردت

46
00:03:41,490 --> 00:03:46,700
المظاهر مثل الثياب، لا تعكس جوهرك أبداً

47
00:03:47,320 --> 00:03:51,540
أودّ الوقوع في حُبّ رجل
،أراه بغاية الوسامة

48
00:03:51,540 --> 00:03:56,270
ولو لم تتّفق معي 99% من الفتيات

49
00:03:58,490 --> 00:03:59,920
!رجعت

50
00:04:00,160 --> 00:04:02,050
تأخّرتِ يا رين

51
00:04:02,360 --> 00:04:04,170
تعالي هنا، سأقدّمكِ إليه

52
00:04:04,690 --> 00:04:09,090
أنا مُتأكّدة أنّي أخبرتكم بتأخّري اليوم
بسبب العمل، قلت لأمّي على الأقلّ

53
00:04:15,810 --> 00:04:18,750
هذا كاناتا-كن، السيّد كاناتا ريفينغتون

54
00:04:18,750 --> 00:04:21,010
وصل ظهيرة اليوم

55
00:04:21,010 --> 00:04:25,040
،هذه أوّل مرّة يعيش فيها خارج البلاد
فلا بدّ أنّه سيمتلك تساؤلات

56
00:04:25,040 --> 00:04:27,620
وأقدّر مساعدتكِ له قدرما
تستطيعين يا رين

57
00:04:29,290 --> 00:04:32,520
سُررت بلقائكِ يا رين-سان

58
00:04:32,520 --> 00:04:34,060
ناديني بـ كاناتا رجاءً

59
00:04:37,790 --> 00:04:39,530
...أ-أنا

60
00:04:39,530 --> 00:04:42,520
...المعذرة، لديّ فرض رياضيّات، لذا أستأذن

61
00:04:45,970 --> 00:04:48,800
حسنّاً، إنّها في سنٍّ معقّد

62
00:04:49,280 --> 00:04:53,430
ذلك جانباً، أبهرتني طلاقتك في اليابانيّة

63
00:04:53,430 --> 00:04:56,230
علّمتني أمّي مُذ صغري

64
00:04:57,140 --> 00:04:58,210
فهمت

65
00:04:58,720 --> 00:05:01,690
ما حلّ بـ كاثيرن كان مؤسفاً بحقّ

66
00:05:02,370 --> 00:05:06,490
تذكّرني بها في صغرها

67
00:05:10,930 --> 00:05:11,990
...يا للهول

68
00:05:12,610 --> 00:05:15,250
أشعر أنّي أصبت بصدمة كهربائيّة
من مليون فولت

69
00:05:16,280 --> 00:05:18,040
لمَ لا يزال قلبي يخفق؟

70
00:05:18,420 --> 00:05:21,710
يُفترض أنّي لا أحكم
على الآخرين بمظاهرهم

71
00:05:22,480 --> 00:05:25,820
ما هذا إذاً؟

72
00:05:30,580 --> 00:05:32,230
!صباح الخير يا رين

73
00:05:32,820 --> 00:05:33,930
واكانا

74
00:05:33,930 --> 00:05:35,990
أخبريني، كيف مضى الأمر؟

75
00:05:35,990 --> 00:05:36,870
ما قصدكِ؟

76
00:05:36,870 --> 00:05:40,550
!أليس واضحاً؟ ضيفكم المنزليّ من إنجلترا

77
00:05:41,320 --> 00:05:43,400
لا... أعلم حقّاً

78
00:05:43,400 --> 00:05:47,300
!ما هذه الإجابة؟ أريني صورةً على الأقلّ

79
00:05:47,300 --> 00:05:49,340
لم ألتقط واحدة

80
00:05:49,340 --> 00:05:52,660
،سيمكث لدينا لفترة وفقما يبدو
لذا يمكنكِ الزيارة لرؤيته

81
00:05:52,910 --> 00:05:57,330
!مُذهل! تسكنين مع نصف إنجليزيّ

82
00:05:57,330 --> 00:06:00,880
ما الذي أتى به لليابان؟ لعطلة وما شابه فحسب؟

83
00:06:00,880 --> 00:06:05,450
لا أدري... صحيح، لم أسأله عن شيء

84
00:06:11,510 --> 00:06:13,010
أهذا المكان؟

85
00:06:15,930 --> 00:06:17,110
المعذرة

86
00:06:17,110 --> 00:06:19,420
!أتيت في الوقت تماماً

87
00:06:19,420 --> 00:06:22,650
حسناً... أأنت كاناتا ريفينغتون؟

88
00:06:22,650 --> 00:06:24,970
وأنت أوغاتا-سان، صحيح؟

89
00:06:25,310 --> 00:06:27,360
سُررت بلقائك، أنا كاناتا

90
00:06:27,830 --> 00:06:30,820
تجيد كلام اليابانيّة إذاً؟ ذلك رائع

91
00:06:31,240 --> 00:06:35,000
سمعتُ أنّك ارتدت مدرسة سباقات
سيّارات شهيرة في إنجلترا

92
00:06:35,000 --> 00:06:39,230
ظننتُ سايونجي-سان يمازحني
عندما ذكر الأمر

93
00:06:40,230 --> 00:06:41,760
،لعلّك تعلم سلفاً

94
00:06:41,760 --> 00:06:46,880
لكن لدى "إم إف جي" قاعدة غريبة تنصّ
على معدّل قبضة ووزن مُوحّد

95
00:06:47,770 --> 00:06:51,000
أقوى السيّارات تكون عادةً الطرازات
الأوروبيّة ذات قدرة الأحصنة العالية

96
00:06:51,000 --> 00:06:53,050
والتوازن المُتناسق مع خلوّها من التعديلات الكثيرة

97
00:06:53,820 --> 00:06:57,770
ونتيجةً لذلك، عادةً ما يتذمّر الناس من هذا
"المُتطلّب ويسمّونه "قاعدة الأثرياء

98
00:06:58,330 --> 00:07:02,970
وذلك سبب عدم استطاعتي
إعطاءك سيّارة تنافسيّة

99
00:07:02,970 --> 00:07:05,250
"بالنظر للصورة الشاملة لأداء "إم إف جي

100
00:07:05,250 --> 00:07:06,730
سمعتُ بذلك

101
00:07:07,030 --> 00:07:11,200
"لكنّي سأكون سعيداً بمجرّد تجربة "إم إف جي

102
00:07:11,600 --> 00:07:15,660
،حسناً! في تلك الحالة
!سأساندك بكلّ قدرتي

103
00:07:17,650 --> 00:07:19,250
أتودّ الاطّلاع على السيّارة؟

104
00:07:25,000 --> 00:07:26,420
عجباً

105
00:07:28,380 --> 00:07:29,920
جيّد

106
00:07:30,230 --> 00:07:31,480
إنّها رائعة

107
00:07:31,480 --> 00:07:35,480
لا داعي لتطريني، إنّها محض طراز
قديم ثلاثيّ الدوّاسات

108
00:07:35,480 --> 00:07:36,600
أيمكنك قيادتها؟

109
00:07:36,890 --> 00:07:38,140
لا مشكلة

110
00:07:38,600 --> 00:07:42,480
في الأكاديميّة، كانت السيّارات ذات ناقلات الحركة
بشكل "إتش" وثلاث دوّاسات هي الاعتياديّة

111
00:07:42,700 --> 00:07:44,920
تكفّلت بتسجيلك سلفاً

112
00:07:44,920 --> 00:07:47,670
ستشارك في اليوم السابع والختاميّ للتصفيات

113
00:07:54,550 --> 00:07:55,430
ماذا؟

114
00:07:56,500 --> 00:07:57,850
يا للمُصادفة

115
00:07:57,850 --> 00:07:59,190
...صحيح

116
00:07:59,660 --> 00:08:01,950
أأنتِ عائدةٌ من المدرسة يا رين-سان؟

117
00:08:01,950 --> 00:08:03,160
"لا داعي لإضافة "سان

118
00:08:03,390 --> 00:08:07,130
أنت تكبرني سنّاً، يمكنك مناداتي بـ رين فحسب

119
00:08:08,140 --> 00:08:10,580
من أين رجعت يا كاناتا؟

120
00:08:10,580 --> 00:08:14,820
ذهبتُ إلى طوكيو لزيارة السفارة
البريطانيّة في يوتسويا

121
00:08:15,250 --> 00:08:17,850
كما اشتريتُ هاتفاً جديداً

122
00:08:17,850 --> 00:08:21,810
حقّاً؟ في تلك الحالة، لنتشارك بيانات التواصل

123
00:08:22,030 --> 00:08:23,540
...ليس لسبب معيّن

124
00:08:23,540 --> 00:08:27,770
،لكن متى كنت تحتاج لمساعدة
فسيمكنك التواصل معي فوراً

125
00:08:27,770 --> 00:08:30,810
معكِ حقّ، انتظري قليلاً

126
00:08:38,500 --> 00:08:42,750
كان لديكِ عملٌ بالأمس يا رين، صحيح؟
ماذا عن اليوم؟

127
00:08:42,750 --> 00:08:46,740
عملي... غير عاديّ نوعاً ما

128
00:08:46,740 --> 00:08:50,870
،يكون يومان أو ثلاثة أيّام كلّ أسبوع
ثم فترة مطوّلة إلى المرّة القادمة

129
00:08:50,870 --> 00:08:51,960
فهمت

130
00:08:51,960 --> 00:08:55,700
أردتُ طلب شيءٍ منك يا كاناتا

131
00:08:55,700 --> 00:08:57,680
أيمكننا التقاط صورة معاً؟

132
00:08:57,680 --> 00:08:59,140
صورة؟

133
00:08:59,140 --> 00:09:02,680
عندما أخبرت صديقتي عنك، قالت أنّها
تودّ معرفة كيف تبدو

134
00:09:02,990 --> 00:09:03,960
أذلك مقبول؟

135
00:09:03,960 --> 00:09:05,640
!ها أنا ذي، ابتسم

136
00:09:07,770 --> 00:09:10,230
إنّها رائعة! أتودّ أن ترى؟

137
00:09:11,300 --> 00:09:13,480
لا تستهويني الصور

138
00:09:14,520 --> 00:09:19,470
ما الذي دفعك لمغادرة موطنك
والقدوم لليابان يا كاناتا؟

139
00:09:22,110 --> 00:09:25,660
لا أمانع استثناءكِ وإخباركِ يا رين

140
00:09:26,050 --> 00:09:28,850
أتيتُ لليابان لسببين

141
00:09:28,850 --> 00:09:31,730
حسناً، إنّه واحد بالأحرى

142
00:09:31,730 --> 00:09:32,920
واحد؟

143
00:09:35,350 --> 00:09:38,190
للعثور على أبي المفقود

144
00:09:38,980 --> 00:09:40,450
والدك؟

145
00:09:44,470 --> 00:09:45,760
"إم إف غوست"

146
00:09:49,480 --> 00:09:50,730
"إم إف غوست"

147
00:09:54,440 --> 00:09:56,570
!صباح الخير يا رين

148
00:09:56,980 --> 00:09:58,290
صباح الخير يا واكانا

149
00:09:58,290 --> 00:09:59,980
!أريني! أريني! أريني إيّاها

150
00:09:59,980 --> 00:10:01,980
توقّعت ذلك

151
00:10:04,220 --> 00:10:04,880
هاكِ

152
00:10:09,760 --> 00:10:10,800
!يا للهول

153
00:10:11,710 --> 00:10:15,130
لعلّ كاناتا وسيمٌ حقّاً

154
00:10:16,210 --> 00:10:17,380
ما هذه؟

155
00:10:17,590 --> 00:10:20,380
صورة من قبل 20 عاماً

156
00:10:20,380 --> 00:10:23,350
والوحيدة لديّ عن أبي

157
00:10:23,740 --> 00:10:28,990
أحبّ هذه الصورة لمظهر أمّي السعيد فيها

158
00:10:28,990 --> 00:10:31,560
اُلتقطت في مكانٍ يُدعى كاماكورا

159
00:10:31,980 --> 00:10:38,000
عقدتُ عزيمتي على أن أجد المكان
في الصورة متى ذهبتُ لليابان

160
00:10:38,000 --> 00:10:41,860
كاماكورا قريبةٌ من هنا، أنا أعرفها

161
00:10:42,500 --> 00:10:45,620
أتمانع لو ساعدتك في إيجاده يا كاناتا؟

162
00:10:46,700 --> 00:10:49,310
إنّها فكرة شاعريّة حقّاً وحسب

163
00:10:49,310 --> 00:10:52,100
أريد مساعدتك في العثور على هذا المكان

164
00:10:53,730 --> 00:10:55,590
ما الخطب يا كاناتا؟

165
00:10:56,560 --> 00:11:00,050
لمَ تعامليني بهذا اللطف يا رين؟

166
00:11:00,770 --> 00:11:05,010
لا أعرف كيف أعبّر عن امتناني

167
00:11:05,840 --> 00:11:09,390
استقبلتِني ووالدكِ بلطفٍ كبير

168
00:11:09,650 --> 00:11:11,810
لا يسعني شكركما بما يكفي

169
00:11:12,280 --> 00:11:14,550
اليابانيّون مُذهلون بحقّ

170
00:11:20,700 --> 00:11:22,990
ذلك غير ممكنٍ يا آيبا-سان

171
00:11:23,280 --> 00:11:25,370
!لا تكن مُتزمّتاً

172
00:11:25,370 --> 00:11:28,850
!أريد معرفة اسم وعمر رقم 7 وحسب

173
00:11:28,850 --> 00:11:32,000
!نشرتم مختلف المعلومات عن بقيّة الملائكة

174
00:11:32,000 --> 00:11:35,890
تلك المعلومات الشخصيّة سرّية، ولا استثناء لذلك

175
00:11:35,890 --> 00:11:39,390
أخبرني بالسباق التالي الذي
ستعمل فيه على الأقلّ

176
