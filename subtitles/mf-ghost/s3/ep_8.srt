1
00:00:02,290 --> 00:00:04,310
هل أنتِ متأكّدة بأنّه لا يبدو غريباً؟

2
00:00:04,920 --> 00:00:07,690
!إطلاقاً يا كانا-تشان

3
00:00:07,950 --> 00:00:10,440
يمكنني القول بأنّه أفضل من أيّ لباس آخر

4
00:00:11,150 --> 00:00:14,410
يقول البعض بأنّ الأجانب يبدون بمظهر
...سيّئ باليوكاتا

5
00:00:14,410 --> 00:00:18,190
لكن ربّما النّصف اليابانيّ أو حمضك النّوويّ
هو الّذي يُعوّض ذلك الفرق؟

6
00:00:18,190 --> 00:00:19,200
ما رأيكِ يا أمّي؟

7
00:00:19,570 --> 00:00:21,950
أدلي برأيكِ حول اليوكاتا خاصّتي أيضاً

8
00:00:21,950 --> 00:00:25,010
أعتقد بأنّكِ تبدين ظريفة أيضاً يا رين-تشان

9
00:00:25,010 --> 00:00:26,330
!لم تنظري إليّ حتّى

10
00:00:29,240 --> 00:00:32,140
أتطلّع قُدماً لأوّل ألعاب ناريّة يابانيّة لي

11
00:00:32,140 --> 00:00:34,220
لا بُدّ من وجود ألعاب ناريّة في إنجلترا أيضاً

12
00:00:34,490 --> 00:00:35,530
بالتّأكيد

13
00:00:35,530 --> 00:00:40,910
بالتّحديد، أتذكّر عندما أخذتْني أمّي
إلى ليلة البون فاير، في لندن

14
00:00:40,910 --> 00:00:42,350
حقّاً؟

15
00:00:46,670 --> 00:00:48,680
لديّ طلب يا رين

16
00:00:48,680 --> 00:00:51,510
ماذا؟ ولِمَ هذه الرّسميّة؟

17
00:00:51,870 --> 00:00:54,490
أودّ التقاط صورة لك

18
00:00:55,370 --> 00:00:57,700
صورة؟ لليوكاتا خاصّتي؟

19
00:00:58,790 --> 00:01:00,330
ألا ينبغي أن أفعل ذلك؟

20
00:01:01,780 --> 00:01:03,490
لـ-لا أقصد هذا

21
00:01:04,100 --> 00:01:05,580
شكراً لك يا رين

22
00:01:05,580 --> 00:01:09,700
،إذا كان هذا ما تريده حقّاً
فالتقط ما تشاء

23
00:01:10,620 --> 00:01:11,570
...ها أنا ذا

24
00:01:12,210 --> 00:01:15,720
حسناً، أعلم بأنّني بدوتُ قبيحة في تلك
!الصّورة! لنلتقط صورة أُخرى

25
00:01:16,020 --> 00:01:19,030
شكراً. أنتِ  الأظرف في العالم يا رين

26
00:01:21,330 --> 00:01:25,480
لا أملك فكرة عمّا يعتبره
...الإنجليزيّون ظريفاً

27
00:01:34,230 --> 00:01:38,240
بما أنّنا نلتقط صوراً، لنلتقط صورة
ثنائيّة بارتدائنا اليوكاتا

28
00:01:38,600 --> 00:01:40,860
هل ينبغي أن أطلب من شخص التقاطها؟

29
00:01:40,860 --> 00:01:41,870
فكرة سديدة

30
00:01:45,030 --> 00:01:46,570
!شكراً جزيلاً لك

31
00:01:57,070 --> 00:02:01,270
تذكّرت. اليوم هو يوم مهرجان
إينوشيما للألعاب النّاريّة

32
00:02:01,270 --> 00:02:05,930
هذا صحيح. رين وكانا-تشان بدوا
مُتشوّقين للخروج باليوكاتا

33
00:02:06,440 --> 00:02:08,660
كانا مُنسجمين كحبّة فول
انقسمت إلى نصفين

34
00:02:08,660 --> 00:02:12,700
أحياناً، يبدوان كشقيقين حقيقيّين بالنّسبة لي

35
00:02:12,700 --> 00:02:13,950
...وربّما يوماً ما

36
00:02:18,280 --> 00:02:19,850
...عندما أشاهد تلك الألعاب النّاريّة

37
00:02:19,850 --> 00:02:24,100
أتذكّر بأنّ الصّيف سينتهي ممّا
يجعلني أحزن بعض الشّيء

38
00:02:24,460 --> 00:02:27,310
قرأتُ في مكان ما بأنّ الشّعور بالعاطفة

39
00:02:27,310 --> 00:02:31,100
في أواخر الصّيف هو أمر تختصّ به اليابان

40
00:02:31,100 --> 00:02:33,840
حقّاً؟ ما السّبب يا ترى؟

41
00:02:33,840 --> 00:02:37,470
اليابان هي على ما يبدو إحدى البلاد

42
00:02:37,470 --> 00:02:39,770
ذات المواسم الأربعة الأكثر ثراء في العالم بأسره

43
00:02:46,290 --> 00:02:47,980
مُذهل

44
00:02:48,660 --> 00:02:52,100
لم أرَ ألعابَ ناريّة مُدهشة كهذه من قبل

45
00:02:52,520 --> 00:02:55,110
أعشق رائحة البارود

46
00:02:55,990 --> 00:02:58,010
إنّها جميلة حقّاً يا رين

47
00:02:58,010 --> 00:03:02,070
.كاناتا يستمتع وقتاً مُمتعاً
يسرّني أنّني دعيتُه

48
00:03:03,060 --> 00:03:07,770
حدثتْ أمور كثيرة، منها السّعيدة ومنها الحزينة

49
00:03:08,600 --> 00:03:11,430
كان هذا الصّيف حافلاً حقّاً

50
00:03:12,450 --> 00:03:15,390
وداعاً يا صيفي السّابع عشر

51
00:03:16,050 --> 00:03:19,670
،لم يكن مُوحشاً إطلاقاً في هذا العام
بفضل كاناتا

52
00:03:20,500 --> 00:03:26,040
في العام المُقبل... والّذي يليه... آمل
أن أستطيع قضاءها معه أيضاً

53
00:03:26,910 --> 00:03:32,620
أتساءل ما إن كنتُ قد بدأتُ أريد
المزيد والمزيد، شيئاً فشيئاً

54
00:03:40,150 --> 00:03:41,400
مُدهش

55
00:03:43,510 --> 00:03:44,680
!مهلاً لحظة

56
00:03:44,680 --> 00:03:46,650
!لا تنسَ الوعد

57
00:03:46,650 --> 00:03:49,410
قلتَ بأنّك لن تتخطّى المُنعطفات
!قبل أن أخرج يا كاناتا

58
00:03:49,700 --> 00:03:51,560
أجل، بالطّبع

59
00:03:51,560 --> 00:03:56,340
مُذهل يا سيّد أوكوياما. أنا مصدوم
من مدى تطوُّر السّيّارة 86

60
00:03:58,070 --> 00:04:00,920
سريعة! سريعة جدّاً! إلى أيّ
!سرعة يمكن أن تصل؟

61
00:04:04,210 --> 00:04:05,680
حسناً، سأغادر

62
00:04:05,950 --> 00:04:08,140
أجل، ابذل قصارى جهدك

63
00:04:14,440 --> 00:04:19,570
،حتّى مُقارنة بالتّرقيات من السّباق الثّالث
مانازارو، ألاحظ تغييرات

64
00:04:22,150 --> 00:04:23,970
...هناك المزيد من القوّة المُثبّطة

65
00:04:23,970 --> 00:04:25,900
،في السّابق، عندما كنتُ أتجاوز أيّ مطبّ

66
00:04:25,900 --> 00:04:27,950
كنتُ أضطرّ لإيقاف التّسارع للحفاظ
...على السّيطرة، لكن

67
00:04:28,270 --> 00:04:32,910
والآن بوجود هواء يدفع السّيّارة للأسفل
!مباشرة... يمكنني الانطلاق بأقصى سرعة

68
00:04:34,200 --> 00:04:36,460
سمعتُ بأنّه لم يغيّر مستويات الطّوربين الفعليّة

69
00:04:37,000 --> 00:04:40,210
لكن من الواضح بأنّ المُحرّك يعمل
بشكل أحدّ من السّابق

70
00:04:40,580 --> 00:04:42,850
سبّبت لي مُشكلة بعض الشّيء يا سيّد أوكوياما

71
00:04:43,320 --> 00:04:47,060
بسيّارة كهذه، لن أتمكّن من اختلاق أي عذر

72
00:04:52,450 --> 00:04:53,730
...نوزومي وكاكيرو

73
00:04:54,980 --> 00:04:57,230
!إنّه كاناتا

74
00:05:05,400 --> 00:05:08,160
!كاناتا، هنا

75
00:05:15,230 --> 00:05:16,650
مرحباً يا نوزومي

76
00:05:17,560 --> 00:05:21,460
اسمح لي أن أعرّفك، هذا هو
الميكانيكيّ الخاص بي، ياماتاني-كن

77
00:05:21,460 --> 00:05:22,380
مرحباً

78
00:05:22,600 --> 00:05:23,860
سررتُ بلقائك

79
00:05:24,270 --> 00:05:26,430
وهذا هو الميكانيكيّ الخاصّ بي، أوغاتا-سان

80
00:05:26,430 --> 00:05:28,910
إنّه مالك السّيّارة 86 أيضاً

81
00:05:28,910 --> 00:05:29,890
مرحباً

82
00:05:29,890 --> 00:05:32,640
يبدو أنّ السّيّارة 86 أضحت ممتازة

83
00:05:33,100 --> 00:05:34,890
...ومجرى الهواء يصنع فرقاً، لكن

84
00:05:35,110 --> 00:05:38,400
إنّها تبعث نوعاً مُختلفاً من الهالة

85
00:05:38,730 --> 00:05:41,150
غريزة الميكانيكيّ الخاصّ بي يُعتمَد عليها

86
00:05:41,500 --> 00:05:45,880
في الواقع... لدينا طاقم استشاري موهوب حقّاً

87
00:05:45,880 --> 00:05:48,410
،وكنتُ أدعه يتّخذ الكثير من القرارات

88
00:05:48,410 --> 00:05:49,370
بقدر ما الاعتراف مُحرِج

89
00:05:49,620 --> 00:05:54,210
بالمناسبة، أتينا لاختبار في الأمس
ورأيتُ السّيّارة 4

90
00:05:54,210 --> 00:05:57,040
ساواتاري كوكي طوّرَ مركبته أيضاً

91
00:05:57,430 --> 00:06:02,170
تواردت تقارير عن أنّ مايكل بيكينباور
لديه سيّارة جديدة أيضاً

92
00:06:02,170 --> 00:06:04,720
الجميع يعملون على ذلك بالفعل

93
00:06:04,720 --> 00:06:06,660
لعلّ المسار المُزدوج قد بدأ بالفعل

94
00:06:06,660 --> 00:06:08,430
الشّرارات تتطاير

95
00:06:08,650 --> 00:06:09,970
ماذا عن خاصّتكِ؟

96
00:06:10,190 --> 00:06:13,600
تمّ التّلاعب بالكمبيوتر. وتعزيز قوّتها أيضاً

97
00:06:13,600 --> 00:06:16,400
أعلم بأنّ أخي تلاعب بعازل صدمات
سيّارة اللّوتس خاصّته

98
00:06:16,400 --> 00:06:20,350
لا تريدها أن تكون قاسية جدّاً
في المسار المُزدوج

99
00:06:21,480 --> 00:06:24,720
إنّه في الواقع مُنفعل وكان
يقود كثيراً في الأمس

100
00:06:24,720 --> 00:06:27,530
بما أنّه سيّئ بعض الشّيء، فإنّه يستغرق
وقتاً حتّى يفهم ويُحلّل شيئاً

101
00:06:27,530 --> 00:06:29,620
بخلافي، لا يمتلك حسّاً فطريّاً

102
00:06:29,620 --> 00:06:34,120
!هذا النّوع من الكلام هو سبب شجاركما الدّائم

103
00:06:40,440 --> 00:06:42,990
بالنّسبة لشخص مثلي، الّذي يُفضّل
...الحركات السّريعة

104
00:06:42,990 --> 00:06:46,630
سيستغرق وقتاً الاعتياد على هذا
النّوع من الحركات العريضة

105
00:06:47,340 --> 00:06:50,880
لكن أعتقد... بأنّني بدأتُ أتأقلم معها أخيراً

106
00:06:54,190 --> 00:06:55,140
!من هذا؟

107
00:06:55,580 --> 00:06:57,520
لم أرَ تلك السّيّارة من قبل

108
00:06:57,810 --> 00:07:00,620
...بما أنّها سيّارة إنجليزيّة الصّنع

109
00:07:00,620 --> 00:07:03,020
سأظهر لك بعضاً من الاحترام يا لوتس

110
00:07:03,260 --> 00:07:05,400
عندما أقذفك بعيداً، سأفعلها بطريقة جميلة

111
00:07:05,710 --> 00:07:07,400
أستون مارتين؟

112
00:07:07,400 --> 00:07:09,780
!تبّاً... يا للقوّة

113
00:07:15,940 --> 00:07:17,610
إنّهما بارعان حقّاً

114
00:07:17,610 --> 00:07:19,500
بموهبة في القيادة الفنّية

115
00:07:19,820 --> 00:07:23,570
أعتقد بأنّ هذا يعني ظهور مُستجدّ
آخر في م.ف.ج

116
00:07:27,640 --> 00:07:31,760
إنّه شهر سبتمبر، لكن الشّمس لا تهدأ

117
00:07:31,990 --> 00:07:34,060
ومع نهاية الصّيف

118
00:07:34,060 --> 00:07:36,470
!تبدأ هذه المعركة ذات السّرعة الفائقة
!مسار السّاحل المُزدوج

119
00:07:37,260 --> 00:07:40,740
،إنّها اللّحظة الّتي كنتم تنتظرونها جميعاً
ويسرّنا أن ننقلها إليكم

120
00:07:40,740 --> 00:07:43,440
وأقول ذلك بكلّ صدق

121
00:07:43,440 --> 00:07:45,900
اسمي يوشيكي تاناكا، هنا في التّعليق

122
00:07:45,900 --> 00:07:50,660
،بطول مسار يبلغ 21.7 كم في كلّ لفّة
يتكوّن هذا السّباق من 6 لفّات

123
00:07:51,220 --> 00:07:54,820
يمتدّ نحو الشّمال بوجود خليج ساغامي
،في جهة اليمين قبل العودة من نفس الطّريق

124
00:07:54,820 --> 00:07:57,700
،يبدو هذا المضمار بسيطاً نسبيّاً

125
00:07:57,700 --> 00:08:02,160
لكن السّرعات العالية لا تحتمل ولو لحظة استهتار

126
00:08:02,450 --> 00:08:04,140
!اليوم هو اليوم الأوّل للمُتأهّلين

127
00:08:04,140 --> 00:08:07,420
!ولدينا أحد أفضل المُنافسين الثّلاثة هنا بالفعل

128
00:08:08,010 --> 00:08:10,160
إنّه سائق لديه مُعجبون كُثُر

129
00:08:10,160 --> 00:08:11,920
،ومنذ عودته إلى الموسم

130
00:08:11,920 --> 00:08:14,430
!استعرضَ حسّ قيادة طبيعيّاً مُدهشاً أيضاً

131
00:08:14,780 --> 00:08:19,310
،في سيّارة فرنسيّة مُبهرة... السّيّارة 4
!الّتي يقودها ساواتاري كوكي

132
00:08:20,840 --> 00:08:22,310
!وها هو يقلع

133
00:08:25,100 --> 00:08:27,060
...ساواتاري كوكي بالفعل

134
00:08:27,640 --> 00:08:30,610
إنّه أحد أكثر المُرشّحين للفوز
!كيفما نظرنا للأمر

135
00:08:31,160 --> 00:08:34,320
كانت هذه ستصبح مُنافسة زمنيّة
تلفت الاهتمام مهما حدث

136
00:08:34,840 --> 00:08:37,510
والوقت الّذي تُحقّقه السّيّارة 4

137
00:08:37,510 --> 00:08:41,830
سينتهي المطاف به كمقياس
للأيّام السّبعة المُتبقّية

138
00:08:44,130 --> 00:08:46,790
أتطلّع قُدماً لهذا يا أ 110 س

139
00:08:49,000 --> 00:08:51,500
!وساواتاري كوكي في الطّريق

140
00:08:53,050 --> 00:08:54,740
إنّه مُعلَّم سلفاً براية تركيز

141
00:08:54,740 --> 00:08:57,430
ويتجاوز قسم الطّريق السّريع الأوّل له

142
00:08:57,710 --> 00:09:01,430
...بكونه اليوم الأوّل، لا جدوى فعليّة من المُقارنة

143
00:09:01,430 --> 00:09:03,880
لكنّه يحرز وقتاً أفضل من الآن ممّا

144
00:09:03,880 --> 00:09:07,810
فعله أكابا كايتو عندما أحرز رقماً
!قياسيّاً في مضمار في الموسم الماضي

145
00:09:14,320 --> 00:09:16,340
،مُحافظاً على وتيرته العالية

146
00:09:16,340 --> 00:09:20,330
إنّه حاليّاً على وشك هزيمة الرّقم القياسيّ
!لمضمار بفارق 2 ثانية تقريباً

147
00:09:20,860 --> 00:09:24,630
لا تترك مجالاً للأعذار، وادفع
...بحدودك قدر المستطاع

148
00:09:24,630 --> 00:09:26,580
هذه هي الخطّة هذه المرّة

149
00:09:26,870 --> 00:09:29,870
...مايكل بيكينباور... كاناتا ريفينغنتون

150
00:09:29,870 --> 00:09:31,840
!من الأفضل أن تنتبها على نفسيكما

151
00:09:32,320 --> 00:09:35,460
ومن خلال القسم ثلاثة، تتواجد المنطقة
،السّكنيّة الأعقد في المضمار

152
00:09:35,460 --> 00:09:37,110
تبقى راية التّركيز سليمة

153
00:09:37,110 --> 00:09:39,470
!إنّه يبذل أقصى حدوده

154
00:09:48,700 --> 00:09:50,760
ويُهزَم الرّقم القياسيّ للمضمار
الخاصّ بأكابا كايتو

155
00:09:50,760 --> 00:09:54,860
!بفارق 3 ثوانٍ بينما يتجاوز خطّ الهدف

156
00:09:54,860 --> 00:09:59,450
إذا حافظ سائقٌ من اليوم الأوّل على مركز
،الصّدارة حتّى يبدأ السّباق

157
00:09:59,450 --> 00:10:03,580
فستكون الحالة الأولى في تاريخ م.ف.ج

158
00:10:03,580 --> 00:10:08,960
!قدّمَ ساواتاري كوكي أداء إلهيّاً اليوم

159
00:10:11,230 --> 00:10:12,650
شبح م.ف

160
00:10:19,740 --> 00:10:23,850
من سِمات الطّفل الوحيد هو أنّهم
لا يُبالون بأن يعيشوا وحيدين

161
00:10:24,280 --> 00:10:28,550
الرّقم اثنان: نحاول حلّ المشاكل
بأنفسنا من دون مُساعدة

162
00:10:28,550 --> 00:10:29,600
عمّاذا تتكلّمين؟

163
00:10:29,970 --> 00:10:32,860
مفاجأت! إنّها قائمة من أشياء طفوليّة

164
00:10:32,860 --> 00:10:36,840
نميل أيضاً للإعجاب بعلاقات الأشقاء
بل ونُقدّسها أيضاً

165
00:10:36,840 --> 00:10:38,300
،ونميل للعمل على كثير من الأنشطة خارج المنهاج

166
00:10:38,300 --> 00:10:39,650
ونتكلّم مع أنفسنا أكثر

167
00:10:39,650 --> 00:10:42,490
!يا إلهي، كأنّكِ تتحدّثين عنّي

168
00:10:42,490 --> 00:10:45,430
عندما يزعجنا شيء ما فيكون ذلك
واضحاً من وجوهونا

169
00:10:45,430 --> 00:10:46,900
نميل لنكون أنانيّات ونحبّ فعل
الأمور على طريقتنا الخاصّة

170
00:10:46,900 --> 00:10:49,300
ولدينا قواعدنا الدّاخليّة الخاصّة
الّتي نتمسّك بها

171
00:10:50,570 --> 00:10:51,530
هذا صحيح تماماً

172
00:10:51,530 --> 00:10:54,270
تميل الفتيات للعلاقات مع والديهن
والّتي تكون أقرب إلى صداقات

173
00:10:54,270 --> 00:10:55,780
ويميل الشّباب لإصابتهم بعقدة الأمّ

174
00:10:55,780 --> 00:10:57,760
بدأتِ تُخيفينني بمدى دقّة هذا الكلام

175
00:10:57,760 --> 00:11:00,970
اسمعي، لأنّ هذا هو الجزء المُهمّ

176
00:11:00,970 --> 00:11:02,890
...السّمات الرّومانسيّة للأطفال الوحيدين

177
00:11:02,890 --> 00:11:07,290
يميلون ليكونوا أكثر سلبيّة، مُنتظرين
الشّخص الآخر حتّى يُبادر

178
00:11:07,290 --> 00:11:09,390
!يحبّون التملُّك وغيّورون أيضاً

179
00:11:10,520 --> 00:11:12,480
!بسقف معايير عالٍ جدّاً

180
00:11:13,490 --> 00:11:15,640
إجمالاً، يكونون قليلي الخبرة

181
00:11:15,640 --> 00:11:17,940
!إنّهم سيّئون في التّعبير عن مشاعرهم
!النّهاية

182
00:11:20,130 --> 00:11:21,660
ما رأيكِ؟ مُذهل، صحيح؟

183
00:11:21,660 --> 00:11:23,200
قد يكون اسمك عليه

184
00:11:24,130 --> 00:11:26,700
...عندما يُذكَر الافتقار للخبرة الرّومانسيّة

185
00:11:26,700 --> 00:11:28,580
ألا تعتقدين بأنّ هذا ينطبق على كاناتا أيضاً؟

186
00:11:28,580 --> 00:11:32,470
لِمَ لا ينطبق؟ هذه سِمات عالميّة
للأطفال الوحيدين

187
00:11:45,610 --> 00:11:50,210
ركّز. إذا لم أستطع أن أحقّق نجاحاً
في المسار المزدوج، فمتى سأفعل؟

188
00:11:54,820 --> 00:11:56,990
أيبا-سينباي. كاناتا يتكلّم

189
00:11:57,460 --> 00:11:58,360
أهلاً

190
00:11:58,900 --> 00:12:02,580
أودّ أن أتحدّث معك حول أمر

191
00:12:03,540 --> 00:12:05,370
...بخصوص الرّقم سبعة

192
00:12:06,950 --> 00:12:11,620
بخصوص ذلك، أريد أن أطرح عليك
سؤالاً أوّلاً يا كاناتا

193
00:12:14,610 --> 00:12:17,500
هل... تحبّ الرّقم سبعة؟

194
00:12:21,960 --> 00:12:22,840
أجل

195
00:12:23,430 --> 00:12:25,790
أنا آسف يا أيبا-سينباي

196
00:12:27,950 --> 00:12:31,640
حسناً. قولاً سديداً

197
00:12:32,110 --> 00:12:36,540
،إن كان الأمر كذلك، فابتداء من الآن
نحن مُنافسان رومانسيّان

198
00:12:37,330 --> 00:12:38,790
...هذا يُحزنني

199
00:12:39,240 --> 00:12:42,030
في الواقع... كاناتا... أريد توضيح أمر

200
00:12:42,830 --> 00:12:45,390
لا تزال زميلي الكوهاي الظّريف

201
00:12:45,390 --> 00:12:49,010
ومهما حدث من الآن فصاعداً، سنبقى صديقين

202
00:12:49,650 --> 00:12:52,540
أنا أعلن ذلك والآن

203
00:12:53,470 --> 00:12:54,920
!...أيبا-سينباي

204
00:12:58,290 --> 00:12:59,610
!مهلاً يا صاح، لا تبكِ

205
00:12:59,610 --> 00:13:00,550
حسناً

206
00:13:01,800 --> 00:13:05,400
سينباي... بالتّوفيق لك في المرحلة
التّمهيديّة اليوم

207
00:13:05,980 --> 00:13:08,200
أجل! أنت أيضاً

208
00:13:08,200 --> 00:13:10,850
لا تسمح لساواتاري كوكي يتفوّق عليك

209
00:13:18,380 --> 00:13:23,800
"اسمها هو "رين" كما في "حُب
في حُبّ ضائع، وهي ملاكي

210
00:13:24,380 --> 00:13:26,750
كان ذلك شاعريّاً للغاية. لكنّه
ليس حكيماً من حيث التّركيب

211
00:13:28,920 --> 00:13:31,250
...لم أعتبرها يوماً تلميذة مدرسة ثانويّة

212
00:13:31,580 --> 00:13:35,460
وكأنّ توقُّع ساواتاري كان مُصيباً

213
00:13:35,850 --> 00:13:39,420
أنا متأكّد بأنّها أصغر بكثير ممّا تعتقد أنت

214
00:13:40,070 --> 00:13:43,760
إنّها إمّا 17 أو 18. ضمن هذا الهامش

215
00:13:44,230 --> 00:13:47,240
هذا مُنحرف شديد المُلاحظة

216
00:14:05,750 --> 00:14:08,680
ماري، هل زاد وزنكِ أكثر؟

217
00:14:09,500 --> 00:14:12,330
ماذا حدث للحمية في الصّيف؟

218
00:14:12,330 --> 00:14:14,910
!لا تفعلي من فضلكِ! أنتِ تحرقي أُذنَي

219
00:14:14,910 --> 00:14:17,550
!أنا ضعيفة إلى هذا الحدّ

220
00:14:17,550 --> 00:14:21,470
الشّيء الوحيد القويّ بي هو
!شهيّتي وشهوتي

221
00:14:21,470 --> 00:14:23,770
ماذا أصابكِ بالضّبط يا ماري؟

222
00:14:32,140 --> 00:14:33,140
كيوكو؟

223
00:14:33,450 --> 00:14:37,390
امسح عن وجهك تلك النّظرة الغبيّة
وابقَ يقظاً يا آيبا شون

224
00:14:37,830 --> 00:14:40,400
...ليس عليكِ تذكيري

225
00:14:43,270 --> 00:14:45,740
تصل السّيّارة 9 إلى البوّابة

226
00:14:45,740 --> 00:14:47,060
،والتوقُّعات في تصاعد

227
00:14:47,060 --> 00:14:49,930
بما أنّ أيبا شون لديه موهبة
!في المسار المُزدوج

228
00:14:51,650 --> 00:14:52,820
!لقد انطلق

229
00:14:52,820 --> 00:14:56,250
سيّارته البيضاء ج.ت-آر تنطلق للأمام
!كبيان للنّوايا

230
00:14:56,250 --> 00:15:00,830
شقيّ الكاميكازي يبدأ بهجومه
!على المسار المُزدوج في السّاحل

231
00:15:01,470 --> 00:15:03,580
!أعشق هذا المضمار يا رجل

232
00:15:03,580 --> 00:15:06,710
،وبما أنّه لا يوجد جزءٌ منه يُوتّرني
!فيمكنني تفجير كلّ طاقتي

233
00:15:15,640 --> 00:15:19,770
هذه هديّة. كُلنَها عندما تسنح الفُرصة

234
00:15:20,810 --> 00:15:24,020
فطائر الكريمة المنفوشة هذه يُفترض
بأن تكون مشهورة في أوداوارا

235
00:15:24,020 --> 00:15:26,220
!فطائر كريمة منفوشة! مرحى

236
00:15:26,220 --> 00:15:27,890
!تبدو لذيذة

237
00:15:27,890 --> 00:15:30,280
هل يمكننا فتحها الآن يا كيوكو-سان؟

238
00:15:30,510 --> 00:15:34,910
هل نسيتُن شيئاً؟ عليكن أن تشكرنَه أوّلاً

239
00:15:34,910 --> 00:15:38,060
!هذا صحيح. شكراً لك

240
00:15:38,060 --> 00:15:39,290
!نحن مُمتنّات

241
00:15:41,010 --> 00:15:44,510
!يا لأطفال هذه الأيّام

242
00:15:45,700 --> 00:15:47,180
آسفة بشأن ذلك يا أيبا

243
00:15:47,180 --> 00:15:49,800
لا. هذا ليس بالأمر الجلل

244
00:15:50,210 --> 00:15:55,300
إذاً، ما الفتاة الّتي تضع عيناك عليها على أيّ حال؟
هناك كثير من الصّاعدات الظّريفات في هذا العام

245
00:15:56,550 --> 00:15:57,810
الأمر ليس كذلك

246
00:15:59,410 --> 00:16:03,780
أعتبر الملائكة جزءاً هامّاً من الفريق

247
00:16:11,320 --> 00:16:15,830
لديك شخصيّة رجوليّة حقيقيّة، أليس كذلك؟
بالتّوفيق لك في المرحلة التّمهيديّة

248
00:16:17,030 --> 00:16:20,080
تبدين امرأة لطيفة بحدّ ذاتكِ أيضاً يا كيوكو

249
00:16:22,660 --> 00:16:25,060
سماع شخص أصغر منّي لا يستخدم
...نداء تشريفيّاً

250
00:16:25,060 --> 00:16:29,580
.ومع ذلك، أحببتُ وقع اسمي من فمه
هذا يُسعدني بصراحة

251
00:16:31,180 --> 00:16:35,250
يشتري هديّة للملائكة كلّما شارك في سِباق

252
00:16:35,250 --> 00:16:39,490
وهو السّائق الوحيد الّذي يفعل ذلك

253
00:16:40,570 --> 00:16:43,590
...ربّما ما كنتُ لأُمانع مُحاولتك مُغازلتي

254
00:16:46,840 --> 00:16:49,950
حيويّته واضحة في المقطع

255
00:16:49,950 --> 00:16:53,150
!في المركز الثّاني، خلف ساواتاري كوكي

256
00:16:53,690 --> 00:16:56,850
،حتّى لو رُفِضوا، أو بدوا سخيفين

257
00:16:56,850 --> 00:16:59,990
،أعتقد بأنّه عندما يحبُّ شخصٌ شخصاً آخر
فهذا شيء يستحقّ التّقدير

258
00:17:00,280 --> 00:17:03,650
ومهما حدث، ما زلتُ أستهدف الشّيء نفسه

259
00:17:04,000 --> 00:17:07,500
الوصول إلى منصّة الفائزين! والحصول
!على قبلة من الرّقم سبعة

260
00:17:08,030 --> 00:17:10,790
تستمرّ ج.ت-آر نيسمو في اندفاعها

261
00:17:10,790 --> 00:17:13,190
،بجمالها الأنيق الأخّاذ

262
00:17:13,190 --> 00:17:17,390
يمكن مُقارنتها بسيّارات أوروبّية
،فاخرة ذات راكبين

263
00:17:17,390 --> 00:17:21,420
لكن لعلّه الفخر اليابانيّ فقط هو
ما يجعلني أعتقد

264
00:17:21,420 --> 00:17:23,520
بأنّ جمالها لا يفشل عند المُقارنة؟

265
00:17:23,520 --> 00:17:26,100
إحدى أكثر المُنتجات اليابانيّة
،المنشودة في العالم

266
00:17:26,100 --> 00:17:30,110
!تجسيد للتّكنولوجيا والحِرفيّة، نيسان ج.ت-آر

267
00:17:32,110 --> 00:17:36,060
والآن ينتقل بثّنا إلى السّيّارة 18
!وكيتاهارا نوزومي

268
00:17:36,450 --> 00:17:39,620
!أحسنتِ يا نوزومي! واظبي على ذلك
!ابقي هجوميّة

269
00:17:39,850 --> 00:17:43,370
عُلِم. نظراً إلى كيفيّة ارتكابك الأخطاء
...في مرحلتك التّمهيديّة في الامس

270
00:17:43,370 --> 00:17:47,000
عليّ العمل بجدّ، وإلّا فلن نكسب
!جائزة مالية مُعتبَرة

271
00:17:47,000 --> 00:17:49,500
!لذا سأحرص على تعويض كسلك

272
00:17:49,500 --> 00:17:52,630
!تحبّين الثّرثرة كثيراً، أليس كذلك؟
!حسناً، لا تغترّي

273
00:17:52,890 --> 00:17:55,170
ما رأيك أن تصلني بياماتاني-كن
على الخطّ بسرعة؟

274
00:17:55,170 --> 00:17:57,340
!من المُزعج الاستماع إلى سائق أسوأ منّي

275
00:17:57,340 --> 00:18:01,830
ماذا تقولين؟! آمل أن تسقطي
!في خليج ساغامي

276
00:18:03,170 --> 00:18:06,730
،يومنا الثّاني من المرحلة التّمهيديّة
والسّيّارة 9 الخاصّة بأيبا تخلّفتْ فقط

277
00:18:06,730 --> 00:18:09,000
خمسة أعشار الثّانية عن الرّقم
،القياسيّ السّابق في المضمار

278
00:18:09,000 --> 00:18:10,940
ما يُكسبه مركزاً ثانياً مبدئيّاً

279
00:18:10,940 --> 00:18:15,440
والسّيّارة 18 الخاصّة بكيتاهارا نوزومي تُقدّم
أداء جيّداً ممّا يجعلها في المركز الثّالث

280
00:18:20,520 --> 00:18:24,790
...لطالما عرفتُ بأنّ ساواتاري موهوب

281
00:18:24,790 --> 00:18:27,000
لكنّه أفضل حتّى ممّا توقّعت

282
00:18:27,000 --> 00:18:29,700
،اكتسبَ مركزه بين أفضل 3

283
00:18:29,700 --> 00:18:33,370
وعندما يكون في قمّة مستواه، تراه
حادّاً كشفرة حلاقة

284
00:18:33,880 --> 00:18:38,380
لكن مُشكلة الحدّة هي أنّها قد
تكون هشّة أيضاً

285
00:18:38,380 --> 00:18:41,640
!وهذا ينطبق كذلك على ساواتاري

286
00:18:44,740 --> 00:18:49,770
وقت ساواتاري... إنّه جنونيّ جدّاً لدرجة
لا أستطيع تخيُّل مُحاولة مُجاراته

287
00:18:50,060 --> 00:18:54,270
لكن لا يسعني سوى التّفكير بما فعله
أيبا شون في الأمس

288
00:18:54,510 --> 00:18:56,430
!لا أريد أن يتفوّق عليّ

289
00:18:59,420 --> 00:19:02,580
ظننتُ بأنّ المسار المُزدوج يُفترض
أن يكون مضمار سرعات عالية

290
00:19:02,580 --> 00:19:05,790
كيف تمكّن من تحقيق وقت كهذا
بسيّارة ألبين ضعيفة؟

291
00:19:06,140 --> 00:19:09,150
حسناً، ينبغي أن أتمكّن من مُجاراة
ذلك بإمكانيّات هذه السّيّارة

292
00:19:09,150 --> 00:19:12,120
إذا استطاع ساواتاري فعلها، فأستطيع أنا

293
00:19:12,500 --> 00:19:16,750
!لا أصدّق بأنّه سائق أفضل منّي بكثير

294
00:19:19,790 --> 00:19:22,580
كان وقت ساواتاري كوكي غير منطقيّ

295
00:19:22,580 --> 00:19:25,750
القدرة على كسر الرّقم القياسيّ
...السّابق بفارق 3 ثوانٍ

296
00:19:26,170 --> 00:19:29,490
يا له من إنجاز يُحقّقه في اليوم الأوّل
من المرحلة التّمهيديّة

297
00:19:29,490 --> 00:19:32,770
أشعر وكأنّ م.ف.ج على وشك
أن يمرّ بفترة تغيير

298
00:19:33,080 --> 00:19:36,770
...وإذا لم أستطع التكيُّف، سيتمّ إقصائي
لذا حريّ بي أن أتدبّر أمري

299
00:19:37,190 --> 00:19:40,510
أمتلك الخبرة والكبرياء من ناحيتي

300
00:19:41,290 --> 00:19:42,500
،في اليوم الثّالث والرّابع

301
00:19:42,500 --> 00:19:45,260
شهِدنا بعضاً من المُتسابقين ذوي التّصنيف
،العالي يتحدّون بعضهم في مُنافسة زمنيّة

302
00:19:45,260 --> 00:19:47,910
لكن يمكن وصفها بحالة حيث
...يُضاعف الجميع جهودهم

303
00:19:47,910 --> 00:19:50,230
لا يبدو أنّ أحداً منهم يحقّق الكثير من المكاسب

304
00:19:50,230 --> 00:19:55,540
لعلّ هذا نتيجة الضّغط الّذي فُرِض عليهم
بواسطة الرّقم القياسيّ الخارق

305
00:19:55,540 --> 00:19:57,710
الّذي سجّلَه ساواتاري كوكي من اليوم الأوّل؟

306
00:19:57,710 --> 00:20:01,990
،لكن أعتقد إذا كان سيطرأ تغيير
فغالباً سيحدث غداً

307
00:20:01,990 --> 00:20:04,150
،في اليوم الخامس، المُتسابق المُفضّل

308
00:20:04,150 --> 00:20:06,220
!الإعجازيّ كاتاغيري كاناتا

309
00:20:06,590 --> 00:20:10,000
وفي اليوم السّادس، صاحب المركز الأوّل في بداية
!سباقات العام الماضي، أكابا كايتو

310
00:20:10,000 --> 00:20:12,920
،ويختتم التّشكيلة، في اليوم الأخير

311
00:20:12,920 --> 00:20:16,380
هو الرّجل الغنيّ عن التّعريف، بطلنا
،المُطلَق مايكل بيكنباور

312
00:20:16,380 --> 00:20:21,950
والّذي حقّقَ أرقامَ قياسيّة جديدة
في ثلاثة مضمارات على التّوالي

313
00:20:21,950 --> 00:20:26,170
!لا بُدّ أن تتابعونا، سيّداتي سادتي

314
00:20:26,170 --> 00:20:29,330
لأنّها نشهد صناعة التّاريخ في م.ف.ج

315
00:20:29,640 --> 00:20:35,330
لنلتقِ ثانية غداً. أراكم من جديد
من أوادارا اليابان

316
00:20:35,330 --> 00:20:37,030
كان معكم تاناكا يوجي

317
00:20:41,400 --> 00:20:44,970
ماذا تقولين؟ هذه أوّل مرّة أسمع فيها ذلك

318
00:20:46,420 --> 00:20:49,010
يبدو أنّ الشّخص الّذي قدّمَ
تحليلَ السّباق في يوليو

319
00:20:49,010 --> 00:20:51,470
يعرف مُعلّم كاناتا-سان

320
00:20:51,470 --> 00:20:55,940
ووضّح بأنّ كاناتا-سان سيعود
إلى إنجلترا بعد عام

321
00:20:55,940 --> 00:21:01,070
ألم تكوني تعلمين؟ ألا يبثّون التّعليق
في مكان تواجدكم؟

322
00:21:01,070 --> 00:21:05,820
يبثّونه بالطّبع. هناك مكبّرات صوت ضخمة

323
00:21:06,060 --> 00:21:10,720
على الأغلب، عندما قالَ ذلك، كانت
هناك كثير من السّيّارات تمرّ من جانبنا

324
00:21:10,720 --> 00:21:16,110
فقد تكون سيّارات السّباق صاخبة لدرجة
...تحجب صوت التّعليق

325
00:21:25,980 --> 00:21:29,470
هذا سيّئ... لم أشعر بهلع كهذا من قبل

326
00:21:30,070 --> 00:21:34,230
...أتى كاناتا إلى اليابان ليبحث عن أبيه

327
00:21:34,930 --> 00:21:37,930
،لكنّه انتهى من ذلك تقريباً

328
00:21:38,440 --> 00:21:41,320
ولم يعُد لديه أي سبب للبقاء، أليس كذلك؟

329
00:21:41,740 --> 00:21:46,320
!هل سيغادر بعد سِباقَين آخرين؟

330
00:21:50,950 --> 00:21:52,990
!لا يمكن لهذا أن يحدث

331
00:23:32,230 --> 00:23:36,380
الحلقة القادمة، المُنعطف 33: الرّصاصة الحمراء