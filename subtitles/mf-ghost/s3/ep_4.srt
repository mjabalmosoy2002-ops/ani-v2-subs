1
00:00:02,300 --> 00:00:05,560
!إنّها السّيّارة 86

2
00:00:06,400 --> 00:00:12,940
الملك، بيكنباور، قد تمّ خلعه بواسطة صاعد

3
00:00:14,410 --> 00:00:18,780
كاناتا أمام مايكل الآن؟ مستحيل. ما الخطب؟

4
00:00:18,780 --> 00:00:22,120
كيف استطاع التمكّن من ذلك
المهووس، مايكل؟

5
00:00:24,500 --> 00:00:26,380
حافظ على هدوئك

6
00:00:26,380 --> 00:00:30,170
خُذ نفساً عميقاً لتثبيت نبضك

7
00:00:32,470 --> 00:00:37,430
يجب على البشر أن يسترخوا للأداء
بنسبة 100% تقريباً من قدرتها

8
00:00:37,740 --> 00:00:42,140
هذا مُجرّد هدف إضافيّ. النّتيجة
النّهائيّة لن تتغيّر

9
00:00:42,360 --> 00:00:44,890
بقي نصف المضمار في هذه
،اللّفّة الأخيرة

10
00:00:44,890 --> 00:00:48,090
وتستمرّ المعركة على المركز الأوّل
بين ثُلاثي الألوان

11
00:02:20,520 --> 00:02:22,490
...هنا زاوية أوي

12
00:02:23,700 --> 00:02:25,120
!ها هُم

13
00:02:25,450 --> 00:02:30,420
،هذه السّيّارات الثّلاثة جميعها قويّة
لكن هل ستتفوّق السّيّارة 12 على التلّة؟

14
00:02:30,640 --> 00:02:33,200
لا أعرف ما حدث، لكن هذه
فُرصة مؤاتية لي

15
00:02:33,200 --> 00:02:35,500
أحسنت صنعاً يا كاناتا ريفينغتون

16
00:02:35,970 --> 00:02:40,390
ما دمتَ بيننا، فأنا بمأمن
من هجمات مايكل

17
00:02:44,710 --> 00:02:46,600
!تتقارع السّيّارة 12 مع الأُخرى

18
00:02:49,250 --> 00:02:51,980
!تخرج السّيارتان من الزّاوية معاً

19
00:02:51,980 --> 00:02:53,480
تماسك يا كاناتا

20
00:02:54,010 --> 00:02:57,230
تسير السّيّارتان بشكلٍ مُتوازٍ
وتخرجان من الزّاوية ببطء

21
00:02:57,230 --> 00:03:00,350
!سيمنحني هذا فُرصة للابتعاد عن الخطر

22
00:03:01,010 --> 00:03:03,160
!السّيّارة 86 لا تتخلّى عن هذا دون قتال

23
00:03:03,970 --> 00:03:06,200
!تقطعان الزّاوية التّالية جنباً لجنب

24
00:03:07,700 --> 00:03:09,870
!لا أحد منهما يتراجع

25
00:03:14,210 --> 00:03:17,820
بطريقة ما، تدخلان زاوية ثالثة
!وما زالتا مُلتصقتين معاً

26
00:03:19,590 --> 00:03:21,060
...وكلتاهما تنبثقان

27
00:03:21,060 --> 00:03:22,470
!بشكل مُتوازٍ

28
00:03:22,480 --> 00:03:25,890
والآن إلى قسم التلّة الضّيّقة المؤدّي
إلى الزّاوية غير المُتّزنة

29
00:03:26,110 --> 00:03:29,520
القوّة الخّالصة للسّيّارة 12 تسمح لها
بتقدُّم مُقدّمتها تدريجيّاً

30
00:03:35,400 --> 00:03:39,030
!السّيّارة 12 قد ثبّتتْ مُقدّمة السّيّارة 86 الآن

31
00:03:39,530 --> 00:03:42,150
!تتبادلان الأماكن من جديد

32
00:03:42,630 --> 00:03:47,450
مراراً وتكراراً، شهِدنا كاتاغيري كاناتا يخرج
مُنتصِراً في مثل هذه الأوضاع

33
00:03:47,450 --> 00:03:52,020
،لكنّه الآن في مُواجهة سيّد النّقاط
ومايكل بيكنباور من معدن مُختلف

34
00:03:55,580 --> 00:03:57,060
إنّها الإطارات حتماً

35
00:03:57,390 --> 00:04:00,700
لا غيار ثانٍ في النّصف الأوّل استطاع
إجباره على استهلاك إطاراته الأماميّة

36
00:04:01,090 --> 00:04:05,000
على وجه التّحديد، إنّه يدفع ثمن الدّفع
بقبضته الجانبيّة لأقصى حدودها

37
00:04:05,680 --> 00:04:08,850
سيترتّب عليه التّبديل للحِفاظ
على مركزه الحاليّ الآن

38
00:04:09,250 --> 00:04:13,260
فقدَ التّسليح الّذي يحتاجه لمُقارعة القادة

39
00:04:14,020 --> 00:04:17,190
أكثر الأشخاص المُستفيدين
من هذا الصّراع الشّديد

40
00:04:17,190 --> 00:04:19,360
!بين السّيّارة 86 و 12 كان السّيّارة 4

41
00:04:19,360 --> 00:04:22,740
لقد سبقَهما بـ 20 متر الآن

42
00:04:23,360 --> 00:04:26,120
رأى فُرصته وانتهزها

43
00:04:26,350 --> 00:04:30,620
قد يكون الفوز الأوّل لساواتاري كوكي
!في الموسم بمتناول يده

44
00:04:33,070 --> 00:04:35,460
لن تفلت يا ساواتاري

45
00:04:35,730 --> 00:04:37,580
،في العادة لا أبذل كلّ هذا الجهد

46
00:04:37,860 --> 00:04:40,800
لكن سأريك ما يحدث عندما
أسرع بشكل حقيقيّ

47
00:04:45,670 --> 00:04:46,970
!لا تضغط على نفسك كثيراً يا شون

48
00:04:46,970 --> 00:04:49,220
هذا ليس أفضل مكان للاعتماد على الإطارات

49
00:04:49,220 --> 00:04:53,600
عليك أن تسعى لتثبيت نفسك وتوفّر
الهجمة الضّخمة للطّريق المُستقيم

50
00:04:53,600 --> 00:04:54,730
عُلِم

51
00:04:59,320 --> 00:05:04,160
هذا تدريجيّ فحسب، لكن ألا يبدو أنّ السّيّارة 4
تُجاري السّيّارة 12؟

52
00:05:04,160 --> 00:05:08,370
ونحن نشهد الثّغرة بين السّيّارة 86
والسّيّارة 12 تنمو حجماً

53
00:05:08,690 --> 00:05:11,530
!يبدو أنّ كاتاغيري كاناتا يُعاني

54
00:05:11,850 --> 00:05:15,370
لا يسعني سوى التّفكير بأنّ إنهاك
إطاراته بدأ يُعرقله

55
00:05:15,650 --> 00:05:17,580
،ما زال الجزء الخلفيّ لديّ يتمتّع بثبات

56
00:05:17,850 --> 00:05:21,090
لكن أيّ حركة جانبيّة ستكون قاسية
على إطاراتي الأماميّة

57
00:05:21,090 --> 00:05:23,730
،لن أستسلم حتّى النّهاية

58
00:05:23,730 --> 00:05:26,470
...لكن أعرف تماماً بأنّ الثّنائي الّذي أمامي

59
00:05:26,920 --> 00:05:28,370
لن يترك لي أي ثغرة

60
00:05:44,220 --> 00:05:48,240
!يا للهول! تتلقّى السّيّارة 12 راية تنبيه

61
00:05:48,240 --> 00:05:52,760
هل تُصدّق هذا يا أكياما-سان؟ وفي
وقت كهذا، في اللّفّة الأخيرة؟

62
00:05:52,760 --> 00:05:55,750
يمكنك الشّعور بالثّقة الّتي تُغذّي خياراته

63
00:05:55,750 --> 00:05:59,380
وفي حين أنّني لا أفضّل شخصيّاً
...أسلوب السّباق التحفُّظيّ هذا

64
00:05:59,770 --> 00:06:02,610
!من الصّعب مُخالفة النّتائج

65
00:06:02,610 --> 00:06:05,850
!يبدو وكأنّه بمستوى آخر تماماً

66
00:06:07,220 --> 00:06:08,970
،إنّه يتفوّق عليّ في كلّ ثانية

67
00:06:09,590 --> 00:06:12,640
رغم أنّني كنتُ أسعى للتهرُّب
كي أبقى مُؤهّلاً

68
00:06:12,640 --> 00:06:14,450
أنت سريع يا مايكل

69
00:06:14,450 --> 00:06:16,680
!إنّه سريع جدّاً لدرجة تجعل بدني يقشعرّ

70
00:06:16,930 --> 00:06:19,620
هذا ما عليّ العمل عليه

71
00:06:19,620 --> 00:06:24,060
عندما أكون بكامل تركيزي وأسير بأقصى
،سرعة، فإنّ أنفاسي تغدو غير مُنتظمة

72
00:06:24,060 --> 00:06:26,240
ويتسارع نبضي بشكل تدريجيّ

73
00:06:26,690 --> 00:06:30,240
ما زلتُ لستُ بمستوى أعظم
السّائقين في العالم

74
00:06:31,210 --> 00:06:35,120
!ها هو. الفجوة بين الثّنائي تنكمش

75
00:06:35,120 --> 00:06:37,880
!يدخلان مُنعطف دبّوس الشّعر الثّاني

76
00:06:40,550 --> 00:06:42,230
!وهو معه مُباشرة

77
00:06:42,230 --> 00:06:44,840
!عاد الملك المُطلَق بقوّة

78
00:06:45,390 --> 00:06:47,070
،في هذا الشّارع المُستقيم

79
00:06:47,070 --> 00:06:50,590
!تلتصق السّيّارة 12 بتيّار مروحة السّيّارة 4

80
00:06:50,590 --> 00:06:54,350
!قد تكون هذه لحظة الحقيقة

81
00:06:54,350 --> 00:06:56,560
لا أستطيع التملُّص من هذا
الإحساس السّيّئ

82
00:06:56,560 --> 00:07:02,150
كلّ ما يمكنني فعله الآن هو السّير
بسرعة قصوى آمنة والإيمان بسّيارتي

83
00:07:02,440 --> 00:07:06,070
!أعتمد عليكِ. تماسكي يا أ-110

84
00:07:08,150 --> 00:07:11,910
يبدو أنّ السّيّارة 86 غير قادرة
!على الإسراع أكثر

85
00:07:11,910 --> 00:07:15,660
من الآمن القول بأنّه لم يعُد مُؤهّلاً
!للفوز في هذه المرحلة

86
00:07:15,900 --> 00:07:20,060
لكن من سيربح؟ متى ستشنّ
السّيّارة 12 هجوماً؟

87
00:07:20,470 --> 00:07:24,840
السّيّارتان 4 و 12 تتوجّهان نحو مُنعطف
!دار البلديّة بأقصى سرعة

88
00:07:28,630 --> 00:07:30,510
لن أدعك تقترب من الدّاخل

89
00:07:30,510 --> 00:07:32,800
!إذا انسللتَ من هناك، فسيُقضى عليّ

90
00:07:33,250 --> 00:07:35,180
تأهّب يا ساواتاري

91
00:07:35,470 --> 00:07:37,140
!مُنعطف دار البلديّة سيحسم ذلك

92
00:07:38,380 --> 00:07:40,530
!ويدوسان بقوّة على المكابح

93
00:07:41,690 --> 00:07:43,020
من الجهة الخارجيّة؟

94
00:07:43,020 --> 00:07:47,410
تبّاً لك يا مايكل. هذا خيار
!سوف أجرّدك منه

95
00:07:48,820 --> 00:07:52,610
إنّهما ندّ لندّ بينما يخرجان
!من زاوية دار البلديّة

96
00:07:52,610 --> 00:07:56,120
إنّها معركة إرادة وكبرياء، والشّرارة تتطاير

97
00:07:56,380 --> 00:07:57,950
...استدارة عالية السّرعة في مُنحدر

98
00:07:57,950 --> 00:07:59,950
!ثمّ يغوصان إلى داخل النّفق

99
00:08:10,310 --> 00:08:13,630
الفجوة بين الثّنائي المُتصدّر انكمشت فجأة

100
00:08:13,960 --> 00:08:18,830
فهمت. القيادة جنباً لجنب يُقلّص
نطاقهما ويحدّ سرعتهما

101
00:08:19,950 --> 00:08:22,480
لا أعلم كيف سينتهي هذا الآن يا أوغاتا-كن

102
00:08:22,890 --> 00:08:24,700
اتّخذ الأمر منحى مُثيراً للاهتمام

103
00:08:24,700 --> 00:08:25,730
ماذا تقصد؟

104
00:08:25,980 --> 00:08:30,060
قد نشهد سحابة بيضاء تنبثق من الغيوم

105
00:08:34,110 --> 00:08:35,610
بئساً

106
00:08:36,440 --> 00:08:39,740
السّبب الّذي جعل مايكل يتّخذ المسار
...الخارجيّ رغم أنّه أضيق بكثير

107
00:08:39,740 --> 00:08:41,250
!هو هذا

108
00:08:45,560 --> 00:08:48,250
ليس لديّ فراغ

109
00:08:50,010 --> 00:08:52,510
،وكاناتا هناك

110
00:08:52,750 --> 00:08:55,130
ليجعل هذا الخطأ الأكبر في حياتي

111
00:08:56,130 --> 00:08:59,760
،وبعد أن أصبح خطّ النّهاية مرئيّاً
!تتبدّل المراكز من جديد

112
00:08:59,760 --> 00:09:03,180
يحتلّ بيكنباور المركز الأوّل، بينما
،كاتاغيري كاناتا في المركز الثّاني

113
00:09:03,180 --> 00:09:05,950
!ويتراجع ساواتاري كوكي إلى الثّالث

114
00:09:06,710 --> 00:09:09,940
!تقلُّب صادم للأحداث. يا لها من نهاية

115
00:09:09,940 --> 00:09:14,570
لا أعتقد بأنّنا شهدنا الكثير من التّقلُّبات في المراكز
!في اللّفّة الأخيرة هكذا من قبل

116
00:09:15,150 --> 00:09:16,030
...والآن

117
00:09:16,330 --> 00:09:18,030
!راية المُربّعات

118
00:09:18,920 --> 00:09:22,910
قائد النّقاط، مايكل بيكنباور، يضيف فوزاً
!ثالثاً لسلسلته الحاليّة

119
00:09:23,390 --> 00:09:25,470
،ثمّ يأتي الصّاعد كاتاغيري كاناتا تالياً

120
00:09:25,470 --> 00:09:30,140
والّذي يختتم في المركز الثّاني
!في سباقه الثّالث فقط

121
00:09:30,140 --> 00:09:32,420
حلّ كاناتا ثانياً

122
00:09:33,640 --> 00:09:35,170
!فعلَها

123
00:09:35,170 --> 00:09:38,040
!فعلَها حقّاً! فعلَها كاناتا

124
00:09:38,690 --> 00:09:42,180
هل أنا في حلم الآن؟

125
00:09:42,180 --> 00:09:47,190
لكن بالحديث عن القوّة! المُحارب السّايبورغ
!الألمانيّ أثبت قوّته المُتفوّقة

126
00:09:47,190 --> 00:09:51,080
،السّيّارتان 4 و 86 تنافستا بشراسة

127
00:09:51,080 --> 00:09:54,690
لكن لم يكن طموحهما كافياً في النّهاية

128
00:09:58,950 --> 00:10:01,950
أنا قريب بما يكفي لرؤية خلفيّة السّيّارة 2

129
00:10:01,950 --> 00:10:04,950
لكن لا أثر لكاتاغيري كاناتا

130
00:10:05,470 --> 00:10:10,210
يبدو أنّني في المركز الخامس في سباقي
...الأوّل. ليست نتيجة سيّئة. ومع ذلك

131
00:10:10,510 --> 00:10:14,070
ما هذا؟ لماذا أشعر وكأنّني فاشل
مُثير للشفقة؟

132
00:10:15,610 --> 00:10:17,170
أكابا في السّيّارة 2 في المركز الرّابع

133
00:10:17,170 --> 00:10:20,840
موروبوشي في السّيّارة 885 يجتاز
الدّورة الأخيرة ليحتلّ المركز الخامس

134
00:10:21,180 --> 00:10:24,100
ومن خلفه قليلاً إيشيغامي في السّيّارة 1

135
00:10:28,100 --> 00:10:31,860
!أنت خلفه مباشرة يا شون! هيّا

136
00:10:31,860 --> 00:10:34,020
!لا بُدّ أنّ إطاراتك ما زالت قادرة على الصّمود

137
00:10:34,020 --> 00:10:35,110
!عُلِم

138
00:10:40,510 --> 00:10:42,120
مزيد ومزيد من السّيّارات تصل للخطّ

139
00:10:42,490 --> 00:10:44,250
في المركز السّابع، أويشي في السّيّارة 3

140
00:10:44,250 --> 00:10:45,870
وفي السّيّارة 6، إنّه ياناغيدا

141
00:10:45,870 --> 00:10:47,810
ثمّ مايزونو في السّيّارة 13

142
00:10:47,810 --> 00:10:50,250
ويبدو أنّ هناك بعض الحركة خلفهم

143
00:10:50,580 --> 00:10:51,780
!انظروا إلى هذا

144
00:10:51,780 --> 00:10:55,210
سيّارتان تندفعان من النّفق
!بجانب بعضهما الآخر

145
00:10:55,620 --> 00:10:58,220
إنّه ساكاموتو في السّيّارة 5، وأيبا
في السّيّارة 9

146
00:10:58,220 --> 00:11:03,720
!إنّهما جنباً لجنب! وتنطلق شرارة من حولهما

147
00:11:04,010 --> 00:11:06,840
!أجل! عليك به يا أيبا

148
00:11:05,650 --> 00:11:07,970
!لا تخف! انطلق بأقصى سرعة

149
00:11:07,970 --> 00:11:10,920
لكن يراودني شعور بأنّني رأيتُ
هذا المشهد من قبل

150
00:11:11,440 --> 00:11:14,730
السّيّارة 9 على اليمين ليست
ضمن مسار السّباق

151
00:11:14,730 --> 00:11:17,730
أحمق. استخدم عقلك قليلاً

152
00:11:23,700 --> 00:11:29,010
يا للهول! تسلك السّيّارتان طريقاً
!مُخصّصاً لسيّارة واحدة فقط

153
00:11:29,880 --> 00:11:32,460
...وأوّل من يعبر خطّ النّهاية هو

154
00:11:32,460 --> 00:11:34,710
!آيبا في السّيّارة 9

155
00:11:35,460 --> 00:11:36,720
وحصل على الرّاية

156
00:11:36,720 --> 00:11:38,960
تلك الحركة قيد المُراجعة

157
00:11:39,300 --> 00:11:42,030
أكياما-سان، ما الّذي يحدث هنا بالضّبط؟

158
00:11:42,030 --> 00:11:43,970
لم أتخيّل أن يحدث ذلك أبداً

159
00:11:44,280 --> 00:11:47,430
أشكّ في أنّ لجنة الإدارة احتسبت لذلك أيضاً

160
00:11:47,430 --> 00:11:49,470
قد يكون هذا سهواً من جانبهم

161
00:11:49,470 --> 00:11:54,040
تمّ تهيئة المضمار بحيث لا تتّسع سيّارتان
،هناك في آن واحد

162
00:11:54,040 --> 00:11:56,980
لكن رأينا ما حدث للتو

163
00:11:56,980 --> 00:12:00,870
يراودني فضول حقّاً لمعرفة
القرار الّذي سيتّخذونه

164
00:12:17,750 --> 00:12:22,010
لا. ليس هناك مَن أُفضّلها. أيّ واحدة تنفع

165
00:12:42,650 --> 00:12:46,270
هل سمعتِ؟ حلّ كاتاغيري-كن في المركز
الثّاني وليس لديه مَن يُفضّلها

166
00:12:46,270 --> 00:12:48,060
حسناً، ماذا سيحدث الآن؟

167
00:12:48,060 --> 00:12:50,660
أعتقد سيختار أويهارا-سان إحدانا
بشكل عشوائيّ

168
00:12:50,970 --> 00:12:54,320
إذاً هذا يعني بأنّ لديّ فُرصة أيضاً

169
00:12:54,320 --> 00:12:56,110
أجل، لا أعتقد ذلك

170
00:12:56,460 --> 00:12:59,210
في الحقيقة، لديّ فكرة ممتازة

171
00:12:59,860 --> 00:13:01,710
أويهارا-سان

172
00:13:02,130 --> 00:13:03,580
ما الأمر يا كيوكو-تشان؟

173
00:13:03,580 --> 00:13:06,710
إذا أردت مُكافأتي على السّنوات
،الأربعة الّتي عملتُها كملاك

174
00:13:06,710 --> 00:13:09,720
...وكلّ ما ساهمتُ به في م.ف.ج

175
00:13:10,420 --> 00:13:12,290
فأودّ أن أطلب طلباً

176
00:13:14,220 --> 00:13:16,230
كاناتا ريفينغتون

177
00:13:16,540 --> 00:13:18,680
...غالباً لا تعرفني، لكن

178
00:13:18,680 --> 00:13:20,360
لا، أعرفك

179
00:13:20,740 --> 00:13:24,860
في الخريف الماضي، كنّا في نفس السّباق
في سلسلة يورو ف.إي 3

180
00:13:25,810 --> 00:13:30,830
ظهرتَ في موجز السّائقين في هوكينهايم
وبول ريكارد أيضاً

181
00:13:30,830 --> 00:13:36,040
بجدّية؟ عجباً يا رجل، لديك ذاكرة حديديّة

182
00:13:37,020 --> 00:13:38,040
رقم سبعة

183
00:13:38,040 --> 00:13:38,810
نعم؟

184
00:13:38,810 --> 00:13:42,760
بخصوص المراسم، ستقفين بجانب
المركز الثّاني كاتاغيري

185
00:13:42,760 --> 00:13:45,550
وستمنحينه أيضاً قبلة التّهنئة

186
00:13:46,550 --> 00:13:49,480
...لـ-لـ-لكن... لكن... كاناتا

187
00:13:49,480 --> 00:13:52,810
أقصد، سمعتُ بأنّ كاتاغيري-سان
ليس لديه مَن يُفضّلها؟

188
00:13:52,810 --> 00:13:53,960
هذا صحيح

189
00:13:53,960 --> 00:13:57,960
وعندما لا يكون لدى السّائق مَن
يُفضّلها، فأنا من يتّخذ القرار

190
00:13:58,340 --> 00:13:59,390
بالتّوفيق

191
00:14:03,690 --> 00:14:06,930
!ماذا أفعل؟ لا أستطيع فعل هذا. مستحيل

192
00:14:07,320 --> 00:14:09,110
أنا؟ أُقبّل كاناتا؟

193
00:14:10,600 --> 00:14:16,500
لحظة. مهلاً. هل هذا يعني
بأنّه يُسمَح لي بتقبيل كاناتا؟

194
00:14:17,800 --> 00:14:21,790
تصفيق حارّ لهؤلاء السّائقين الّذين كافحوا
!وغزوا مانازورو

195
00:14:25,470 --> 00:14:27,420
لم أفعل هذا منذ فترة طويلة

196
00:14:27,420 --> 00:14:29,680
...وبعد الشّامبانيا، قبلة

197
00:14:30,040 --> 00:14:33,180
التّهنئة التّقليديّة من الملائكة...

198
00:14:36,350 --> 00:14:39,200
...لا أعلم بشأن هذا. قبلة من الرّقم سبعة

199
00:14:39,200 --> 00:14:41,830
سيغضب أيبا-سان منّي

200
00:14:43,590 --> 00:14:45,070
حسناً

201
00:15:00,490 --> 00:15:02,570
أحسنتُ صنعاً

202
00:15:04,280 --> 00:15:06,020
تهانينا يا كاناتا

203
00:15:06,720 --> 00:15:07,510
ماذا؟

204
00:15:07,970 --> 00:15:09,660
...هذا الصّوت

205
00:15:09,980 --> 00:15:13,510
شكراً جزيلاً لك على إنقاذي البارحة

206
00:15:13,960 --> 00:15:15,490
وأنا آسفة يا كاناتا

207
00:15:16,090 --> 00:15:18,690
...حقيقة أنّني ملاك م.ف.ج

208
00:15:19,110 --> 00:15:21,130
كان ينبغي أن أخبرك من قبل. أنا آسفة

209
00:15:23,910 --> 00:15:27,270
هل أنا أتوهّم أم أنّ كاناتا
يبدو في حالة صدمة؟

210
00:15:27,270 --> 00:15:32,830
هذا ليس رائعاً. لم أرد أبداً أن
أرى الرّقم سبعة تُقبّل كاناتا

211
00:15:34,010 --> 00:15:35,870
...لحظة، تلك الفتاة

212
00:15:36,970 --> 00:15:37,880
المعذرة

213
00:15:38,780 --> 00:15:40,570
أريد أن أطرح عليك سؤالاً

214
00:15:40,570 --> 00:15:41,670
!ها أنا ذي

215
00:15:41,980 --> 00:15:45,570
!أحد سائقي م.ف.ج يُغازلني أخيراً

216
00:15:45,570 --> 00:15:48,200
سأتمكّن من التبجُّح بهذا
!في اللّقاء المُختلط التّالي

217
00:15:48,670 --> 00:15:51,980
آسفة. أعلم بأنّني لا أستطيع

218
00:15:51,980 --> 00:15:54,410
أنتِ والرّقم سبعة مُقرّبتان جدّاً، صحيح؟

219
00:15:54,410 --> 00:15:55,180
ماذا؟

220
00:15:55,520 --> 00:15:57,930
إنّه لا يُغازلني إذاً

221
00:15:58,180 --> 00:16:01,970
هل تعرفين اسمها؟

222
00:16:02,380 --> 00:16:04,140
اسمها؟

223
00:16:05,510 --> 00:16:08,710
أنا متأكّدة بأنّ اسم الرّقم سبعة
هو رين-تشان

224
00:16:08,710 --> 00:16:10,190
!رين-تشان

225
00:16:11,160 --> 00:16:14,780
"رين. يُكتَب بنفس الكانجي في "حُبّ
"الّذي في "الحُبّ الأوّل

226
00:16:15,350 --> 00:16:20,170
هذا اسم ظريف لزوجتي المُستقبليّة

227
00:16:20,170 --> 00:16:23,500
وهو مثاليّ بالنّسبة لها

228
00:16:25,170 --> 00:16:26,310
أوغاتا

229
00:16:26,310 --> 00:16:28,520
كالعادة، تبدو ككل ضالّ

230
00:16:28,520 --> 00:16:30,040
لن تحظى بأيّ فتاة

231
00:16:30,040 --> 00:16:32,380
هذا جارح. لا تتدخّل في شؤون غيرك

232
00:16:32,380 --> 00:16:35,640
سنقيم حفلة الاختتام المعتادة خاصّتنا
في المكان المعتاد

233
00:16:35,640 --> 00:16:40,270
احرص على مجيء ك اناتا. لنجعل
هذا أفضل يوم على الإطلاق

234
00:16:40,270 --> 00:16:42,150
أراك هناك

235
00:16:43,490 --> 00:16:46,520
!يبدو مُتفائلاً بشكل غريب

236
00:16:46,520 --> 00:16:52,710
حسناً، أعتقد بأنّ اللّجنة وافقتْ
على تجاوزه قُبيل الخطّ

237
00:16:55,880 --> 00:16:58,620
أوغاتا-سان، اكتشفتُ شيئاً جنونيّاً للتو

238
00:16:59,350 --> 00:17:02,450
ملاك م.ف.ج الرّقم سبعة هي رين في الواقع

239
00:17:02,720 --> 00:17:06,730
المعذرة؟ تدرك بأنّ هناك حدّاً
للدّعابة، أليس كذلك يا كاناتا؟

240
00:17:06,730 --> 00:17:08,840
أنا لا أمزح. إنّها الحقيقة

241
00:17:08,840 --> 00:17:13,210
تكلّمتُ معها في المراسم، وارتعدتُ
عندما سمعتُ صوتها

242
00:17:13,610 --> 00:17:15,410
إنّها رين حقّاً

243
00:17:15,410 --> 00:17:19,510
مهلاً يا رجل. كيف يمكنك إدراك هذا
الآن بعد كلّ هذا الوقت؟

244
00:17:19,510 --> 00:17:22,940
كنتُما تعيشان معاً لثلاثة أشهر الآن

245
00:17:22,940 --> 00:17:25,800
لا أعتقد بأنّ أحداً من عائلتها يعلم

246
00:17:25,800 --> 00:17:28,780
ولديها هالة مُختلفة كلّياً عن
هالة رين المعتادة

247
00:17:29,400 --> 00:17:31,780
على أيّ حال، يمكنني أن أشير
إلى أنّك لم تلحظ أيضاً

248
00:17:32,020 --> 00:17:36,770
،كنتَ تعرف رين منذ كانت صغيرة
ومع ذلك لم تملك فكرة

249
00:17:37,090 --> 00:17:38,580
...في الواقع

250
00:17:38,920 --> 00:17:44,020
لم أتوقّع أبداً أن تحاول تلك الأميرة
المُدلّلة ارتداء مثل هذا اللّباس المُثير

251
00:17:44,290 --> 00:17:47,370
...التّباين بين هذا ومدى برائتها في العادة

252
00:17:47,370 --> 00:17:51,340
هذا يكفي لإغواء أيّ رجل

253
00:17:52,190 --> 00:17:53,370
أهذه هي عبرتك؟

254
00:17:56,430 --> 00:17:58,630
ظهري يؤلمني

255
00:17:58,630 --> 00:18:00,920
هل أنت بخير؟ هل هذا سيّئ؟

256
00:18:00,920 --> 00:18:02,190
أجل

257
00:18:02,580 --> 00:18:06,350
.لنطلب من فريق م.ف.ج الطبّي يفحصه
إنّه الخيار الأسرع

258
00:18:06,580 --> 00:18:08,850
لا، لا أُفضّل ذلك

259
00:18:09,340 --> 00:18:12,860
إذا عَلِمَ النّاس بإصابتي، فستعلم رين أيضاً

260
00:18:12,860 --> 00:18:17,460
في هذه الحالة، أعرف جرّاح عِظام
في أوداوارا. لنتوجّه إلى هناك

261
00:18:17,950 --> 00:18:19,340
اركب هنا يا كاناتا

262
00:18:19,710 --> 00:18:21,470
أشكرك يا أوغاتا-سان

263
00:18:22,830 --> 00:18:26,750
يا إلهي. إنّه ليس الوقت المُناسب
للذّهاب للاحتفال

264
00:18:27,470 --> 00:18:31,750
ينبغي أن أتّصل بشون لأشرح
سبب عدم انضمامي له

265
00:18:32,090 --> 00:18:34,040
أنا مُطمئن بعض الشّيء

266
00:18:34,470 --> 00:18:38,330
أشعر بالإحراج من رؤية وجه
أيبا-سينباي اليوم

267
00:18:38,330 --> 00:18:39,250
ما السّبب؟

268
00:18:40,010 --> 00:18:41,140
...أقصد

269
00:18:41,700 --> 00:18:45,260
إنّه مفتون بملاك م.ف.ج رقم سبعة

270
00:18:46,230 --> 00:18:49,380
أجل. إنّه كذلك إذاً

271
00:18:49,380 --> 00:18:52,730
أوغاتا-سان. ماذا ينبغي أن أفعل برأيك؟

272
00:18:53,020 --> 00:18:57,110
لا أعرف ماذا أقول. ولا أعتقد
حقّاً بأنّك ينبغي أن تسألني

273
00:18:57,570 --> 00:18:59,330
عليك أن تطرح هذا السّؤال على نفسك

274
00:19:00,920 --> 00:19:04,780
ما هو شعورك تجاه رين-تشان فعليّاً؟

275
00:19:05,470 --> 00:19:07,940
رين مُهمّة بالنّسبة لي

276
00:19:07,940 --> 00:19:10,960
إنّها فرد من العائلة. كأخت صغرى

277
00:19:10,960 --> 00:19:16,950
ليس هذا ما أقصده. هل ترى نفسك
مُهتمّاً بها من النّاحية العاطفيّة؟

278
00:19:17,450 --> 00:19:18,470
...أنا

279
00:19:19,350 --> 00:19:21,630
لا أستطيع الإجابة عن هذا فجأة

280
00:19:22,340 --> 00:19:25,130
بربّك. هذا واضح يا رجل

281
00:19:25,130 --> 00:19:28,140
يبدو لي أنّك تحبّ رين-تشان حقّاً

282
00:19:28,900 --> 00:19:33,620
قد تكون خارج هذا العالم وأنت خلف
،العجلات، لكن في باقي الوقت

283
00:19:33,620 --> 00:19:37,860
أنت أغبى من معظم اليابانيّين
الّذين في سنّك

284
00:19:38,330 --> 00:19:40,380
أنت غريب أطوار

285
00:19:45,660 --> 00:19:48,620
أ-110. أنتِ سيّارة جيّدة

286
00:19:49,550 --> 00:19:51,850
لا أعتقد بأنّني سأحظى بشريك أفضل من هذا

287
00:19:53,050 --> 00:19:56,000
،لكن عندما يتعلّق الأمر بالسّباق والصّراعات

288
00:19:56,000 --> 00:20:00,210
لطالما بدا مايكل يسبقني بخطوة دوماً

289
00:20:02,070 --> 00:20:03,380
لذا أنا آسف جدّاً

290
00:20:04,200 --> 00:20:08,660
وداع سيّارة ظريفة أصعب
بكثير من وداع فتاة

291
00:20:10,450 --> 00:20:12,760
أظنّني سأبكي

292
00:20:17,070 --> 00:20:18,210
سانا؟

293
00:20:19,290 --> 00:20:22,450
مرحباً يا كو-كن. ماذا تفعل؟

294
00:20:22,780 --> 00:20:26,120
ماذا تقصدين؟ انتهى السّباق للتو

295
00:20:26,420 --> 00:20:29,780
أعلم ذلك. وقد سألتُ على أيّ حال

296
00:20:30,220 --> 00:20:32,370
كو-كن. هل يمكننا الخروج معاً اليوم؟

297
00:20:32,370 --> 00:20:36,130
أذكر أنّكِ قلتِ بأنّكِ لديك أمر اليوم

298
00:20:36,410 --> 00:20:40,050
لا يهمّني ذلك الآن. أنت أهمّ
بكثير بالنّسبة لي الآن يا كو-كن

299
00:20:40,840 --> 00:20:44,620
أنت تشعر بإحباط غالباً، صحيح؟ هذا واضح

300
00:20:44,620 --> 00:20:48,700
وأعلم بأنّك بذلت قصارى جهدك
في سِباق اليوم

301
00:20:49,130 --> 00:20:53,180
لذا كمُكافأة، سوف أحسّن نفسيّتك

302
00:20:53,940 --> 00:20:56,520
أراك قريباً. أخبرني أين تريد أن نلتقي

303
00:20:56,990 --> 00:21:00,060
سأحرص على ارتداء الملابس
النّسائيّة الّتي تحبّها

304
00:21:02,130 --> 00:21:06,760
تلك الفتاة. توقّعتُ أنّ لديها وجه
،ظريف وشخصيّة لطيفة

305
00:21:07,300 --> 00:21:11,170
لكن يبدو أنّ لديها جانب ملائكيّ تربويّ أيضاً

306
00:21:19,300 --> 00:21:20,220
ماذا قالوا؟

307
00:21:20,220 --> 00:21:23,550
يبدو أنّها كدمة خطيرة. العظم بخير

308
00:21:23,950 --> 00:21:28,680
قالوا أن أستخدم ضمادات لمدّة أسبوع
وأتجنّب تحريك مِرفقي كثيراً

309
00:21:28,680 --> 00:21:31,160
فهمت. حسناً، لا يبدو هذا سيّئاً جدّاً

310
00:21:31,160 --> 00:21:33,560
أجل. ينبغي أن يكون من السّهل
التّعامل مع هذا نسبيّاً

311
00:21:34,120 --> 00:21:38,810
سوف تدخل م.ف.ج عطلتها الصّيفيّة
الطّويلة الّتي تدوم 40 يوماً

312
00:21:39,310 --> 00:21:43,180
في التّعليق، كان معكم الموسوعة المُتنقّلة
...لـ م.ف.ج، تاناكا يوجي

313
00:21:43,180 --> 00:21:45,820
وأكياما واتارو في التّحليل

314
00:21:46,090 --> 00:21:49,140
أراكم في المرّة المُقبلة من أوداوارا، اليابان

315
00:23:32,290 --> 00:23:37,390
الحلقة القادمة، الحلقة 29: شاحنة كي الخاصّة بالجدّة