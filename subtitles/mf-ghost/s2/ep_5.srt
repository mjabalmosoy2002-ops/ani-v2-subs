1
00:00:01,100 --> 00:00:03,020
بئساً. مُقدّمتي تبتعد عنّي

2
00:00:03,810 --> 00:00:07,740
التلّة شديدة الانحدار. يجب عليّ منعها
!من نصف الدّوران

3
00:00:11,960 --> 00:00:14,390
!والسيّارة 3 تدور

4
00:00:16,160 --> 00:00:19,740
إنّها تواجه الجهة الخاطئة الآن
!بينما تنزلق عن الطّريق

5
00:02:16,610 --> 00:02:17,860
حسناً

6
00:02:18,110 --> 00:02:19,820
الكثير من الحركة اليوم

7
00:02:20,250 --> 00:02:23,780
إنَّ بروز جزء واحد قليلاً هو الأظرف، صحيح؟

8
00:02:26,850 --> 00:02:28,250
السيّارة 86؟

9
00:02:29,450 --> 00:02:32,420
أصبح في قمّة العمود الثّاني فجأة

10
00:02:33,200 --> 00:02:35,910
هذا رائع يا كاتاغيري كاناتا

11
00:02:43,700 --> 00:02:45,940
السيّارتان 7 و 6 بمُلاصقة بعضهما

12
00:02:45,940 --> 00:02:47,930
قد تكون هذه فُرصتي

13
00:02:48,160 --> 00:02:51,560
تشكيل الشّطيرة الّذي أستخدمه
...في العادة مع أخي

14
00:02:51,560 --> 00:02:53,560
يمكنني فعلها بنفسي

15
00:02:56,020 --> 00:02:59,150
تبّاً. لَحِقَتْ 18 بي

16
00:03:03,620 --> 00:03:05,950
أنت بطيء جدّاً يا أوتاني

17
00:03:05,950 --> 00:03:09,750
أبدو كالأحمق بسببك

18
00:03:09,750 --> 00:03:13,770
ماذا تريد منّي؟ لديّ قوّة زائدة
مُقارنة بالظّروف المُحيطة

19
00:03:13,770 --> 00:03:15,900
،إن كنت تعتقد بأنّك تستطيع العبور
!فأكمل وحاول إذاً

20
00:03:17,840 --> 00:03:20,800
،لا أستطيع اجتياز الآخرين مثلما يفعل كاناتا

21
00:03:20,800 --> 00:03:23,510
لكن يمكنني الاختباء وسط الرّذاذ

22
00:03:24,470 --> 00:03:26,100
...سأتظاهر بالتحرّك نحو خارج الزّاوية ثمّ

23
00:03:26,480 --> 00:03:27,100
!إلى الدّاخل

24
00:03:30,420 --> 00:03:32,560
بئساً. ها هي قادمة

25
00:03:32,910 --> 00:03:36,020
قد تبدو ظريفة، لكن تتمتّع بجانب جامح

26
00:03:36,020 --> 00:03:40,420
لا أعتقد ذلك! مُحال أن تتمكّن
!آلفا من هزيمتي في الزّوايا

27
00:03:48,490 --> 00:03:52,500
،قد نكون بنفس المستوى عند الانعطاف
لكن ماذا عن قوّة الدّفع؟

28
00:03:53,090 --> 00:03:56,100
!لا تعبث مع مركبة أحاديّة هيكل كربونيّة

29
00:03:57,460 --> 00:04:01,400
!كان ذلك مُذهلاً يا نوزومي-تشان
!يا له من تجاوز

30
00:04:05,890 --> 00:04:09,390
تقدّمتْ نوزومي مركزاً؟ أيُعقل هذا؟

31
00:04:21,570 --> 00:04:25,490
في أوقات كهذه، أكون ممتنّاً حقّاً
لامتلاكي دوّاسة قابض

32
00:04:25,770 --> 00:04:26,990
!أحسنت يا كاكيرو

33
00:04:26,990 --> 00:04:29,720
أحسنت التّعافي من ذلك الدّوران

34
00:04:29,720 --> 00:04:35,540
بربّك يا ياماتاني. لا أريد من نوزومي
أن تعلم بشأن ذلك الدّوران

35
00:04:35,760 --> 00:04:39,750
دار؟ يا له من فاشل

36
00:04:40,540 --> 00:04:42,720
نشهد تحرُّكاً في المجموعات الأدنى

37
00:04:42,720 --> 00:04:45,840
كيتاهارا في السيّارة 18 قد تقدّم مركزاً

38
00:04:48,100 --> 00:04:49,670
مُذهل

39
00:04:49,670 --> 00:04:54,160
السّائق في السيّارة 18 هي فتاة
في مثل سنّي تقريباً، صحيح؟

40
00:04:56,010 --> 00:04:58,110
والآن سؤال لماري-تشان

41
00:04:58,900 --> 00:05:01,080
،إن سنحتْ لكِ فُرصة للذّهاب إلى مكان
فإلى أين تذهبين؟

42
00:05:01,080 --> 00:05:05,820
في الواقع، لا أحبّ السّفر بمفردي

43
00:05:05,820 --> 00:05:09,840
،أعتقد إذا تواجدتُ مع شخص أحبّه
فلا يهمّ أينما نذهب

44
00:05:11,110 --> 00:05:15,540
،سأكون بنفس الحماس للوجبات السّريعة
حيث سأزور مطاعمَ فاخرة

45
00:05:16,120 --> 00:05:18,500
رغم أنّه ليس لديّ شخص كهذا حاليّاً

46
00:05:18,500 --> 00:05:19,760
!لكنّني أبحث

47
00:05:20,810 --> 00:05:25,710
فهمت. إنّها إحدى الفتيات سهلات
الإرضاء النّمطيّات، أليس كذلك؟

48
00:05:25,710 --> 00:05:29,510
هذا النّوع هو دوماً القطعة الجانبيّة
من المشهد لكن ليس الحدث الرّئيسيّ

49
00:05:35,730 --> 00:05:40,620
المجموعة القمّة تعبر جسر كوجيري
!وتدخل القطاع 2

50
00:05:41,490 --> 00:05:44,380
وإذا لم تُضلّلني عينايّ، تهطل الأمطار بغزارة

51
00:05:44,380 --> 00:05:47,030
نحن نشهد غيوماً ضخمة من الرّذاذ الآن

52
00:05:47,280 --> 00:05:50,270
أحبّ ألّا يحجب شيء الرّؤية أمامي

53
00:05:50,270 --> 00:05:53,500
ليس عليّ القلق بشأن القيادة
عبر رذاذ أحد آخر

54
00:05:53,500 --> 00:05:55,000
هذا مُتحرّر

55
00:06:21,530 --> 00:06:24,820
تبدو قلقاً يا أكابا كايتو

56
00:06:25,280 --> 00:06:28,950
لكن لن تتجاوزني. ليس عندما أمتلك
أفضليّة قوّة الدّفع

57
00:06:29,600 --> 00:06:32,820
،عندما تمّ الإعلان عن قوانين م.ف.ج في البداية

58
00:06:32,820 --> 00:06:35,520
راودني شعور بأنّها مُصمّمة بشكل
مثاليّ على طلب 911

59
00:06:35,870 --> 00:06:41,580
إنّها لا تُعرقِل إعداد المُحرّك الخلفيّ
مثلما تفعل لتصاميم المُحرّك الأوسط

60
00:06:42,130 --> 00:06:45,550
...كان ريو تاكاهاشي قد نسي كلّ شيء

61
00:06:45,550 --> 00:06:48,180
!عن هذه البورش ذات المحرّك الخلفيّ

62
00:06:52,600 --> 00:06:56,010
وها هي ذي مجموعة المركز الثّالث
!تعبر جسر كوجيري

63
00:06:56,620 --> 00:07:00,060
بإقصاء 3 من السّباق، يقتصر
،الآن على مجموعة من خمسة

64
00:07:00,060 --> 00:07:03,710
لكنّهم يبقون خلف بعضهم الآخر
!في هذا العِراك المُحتدم

65
00:07:04,360 --> 00:07:05,900
ما رأيك يا إيكيدا-سان؟

66
00:07:05,900 --> 00:07:11,110
أشعر بأنّ السيّارة 1 في مُقدّمة قطار
السّباق لا تُسرِع قدر ما تستطيع

67
00:07:11,110 --> 00:07:12,990
معك حقّ في ذلك

68
00:07:13,240 --> 00:07:15,950
،لا أحاول اختلاق أعذار لإيشيغامي-كن

69
00:07:15,950 --> 00:07:20,620
لكن تصدُّر مجموعة من السيّارات
هو موقف صعب

70
00:07:20,620 --> 00:07:26,090
أن تكون صانع سلام في أيّام كهذه عندما
تكون الطُّرُقات زلِقة هو تحدٍّ حقيقيّ

71
00:07:26,330 --> 00:07:31,030
لكن عندما تضع بعين الاعتبار الفجوة
،الّتي تُتيح دخول سيّارتين في الصّدارة

72
00:07:31,030 --> 00:07:36,350
فلا بُدّ هنا أن أُقرّ بتقييد إيشيغامي-كن
لمجموعته بسرعة معتدلة نسبيّاً

73
00:07:36,720 --> 00:07:40,100
أنت بطيئ أيّها العجوز إيشيغامي

74
00:07:40,600 --> 00:07:45,560
أنا متأكّد بأنّك تعرف سلفاً سبب
ازدحام مجموعة المركز الثّالث هذه

75
00:07:46,060 --> 00:07:49,110
لأنّ بصفتك قائد القطار، أنت بطيء للغاية

76
00:07:54,070 --> 00:07:57,240
ما تفكِّر فيه واضح وضوح الشّمس

77
00:07:57,770 --> 00:08:02,080
أنا واثق بأنّك تعتقد أنّ امتلاك نموذج
،محرّك خلفيّ يجعلك مُميّزاً

78
00:08:02,080 --> 00:08:04,660
لكن ريو تاكاهاشي لم يُفوّت أي تفصيل

79
00:08:05,470 --> 00:08:07,490
تاريخ البورش ذات المُحرّك الخلفيّ

80
00:08:07,490 --> 00:08:11,920
مليء بالتّعديلات للتغلُّب على سلبيّات
إعداد قيادة العجلات الخلفيّة

81
00:08:12,140 --> 00:08:17,020
،إطالة قاعدة العجلة، وتوسيع المُسنّنات
...وإضافة توجيه المحور الخلفيّ

82
00:08:17,020 --> 00:08:22,100
.بالإضافة إلى ذلك، تنصيب أنظمة كهربائيّة
بالنّسبة للسيّارات ذات الرّاكبين، إنّها ناضجة جدّاً

83
00:08:22,480 --> 00:08:25,940
لكن كيف ستُثبت جودتها في تلك المنافسة؟

84
00:08:26,280 --> 00:08:30,860
لا سيّما في الظّروف الرّطبة، تبرز المزايا الأساسيّة

85
00:08:31,280 --> 00:08:35,470
،لا ينبغي الاستهانة بريو تاكاهاشي
عقليّة جيل"، كما يُعرَف عنه"

86
00:08:36,150 --> 00:08:41,250
هناك سبب وجيه وراء عدم كون سيّارات القيادة
ذات المحرّك الخلفيّ، والعجلات الخلفيّة، غير مُعرقِلة

87
00:08:42,860 --> 00:08:46,170
!أكابا كايتو يعزّز من الضّغوطات

88
00:08:47,670 --> 00:08:51,410
!السيّارتان 1 و 2 على بُعد شعرة من الاحتكاك

89
00:08:55,120 --> 00:08:57,010
لا، اصطدمتا ببعضهما بالفعل

90
00:08:57,400 --> 00:09:03,050
أكابا عديم الرّحمة. هذا النّوع
من القيادة يُغضب السّائق الآخر

91
00:09:03,420 --> 00:09:07,230
وكأنّها صعقة كهربائيّة لكرامة سائق سباق

92
00:09:07,980 --> 00:09:11,540
رغم ذلك، لم أكن مُتحمّساً بوتيرتنا هذه أيضاً

93
00:09:11,930 --> 00:09:14,740
ليس بوجود 86 خلفي مباشرة

94
00:09:25,790 --> 00:09:28,790
عزّزت السيّارة 1 من سرعتها
كما لو أنّ التحدِّي قد قُبِل

95
00:09:28,790 --> 00:09:32,070
ها هي كاريرا جي.تي 3 تنطلق
!بسرعة كبيرة الآن

96
00:09:32,710 --> 00:09:36,930
نادراً ما نرى هذا بوجود شخص
مُتّزن مثل إيشيغامي-كن

97
00:09:36,930 --> 00:09:40,510
يزداد التوتّر تدريجيّاً بين 1 و 2

98
00:09:40,930 --> 00:09:43,020
سوف نستمرّ في مراقبتهم حاليّاً

99
00:09:59,530 --> 00:10:03,570
سلسلة من الزّوايا العمياء تنتظر في الغابة
قُرب الحافّة الشّماليّة لبُحيرة أشينوكو

100
00:10:04,010 --> 00:10:08,670
هل ستزداد المعركة حدّة بينما تنتقل
إلى هذا القسم المحفوف بالمخاطر؟

101
00:10:08,900 --> 00:10:15,110
علامتان تجاريّتان أوروبّيتان بتاريخ
حافل طويل في السّباق تهيجان

102
00:10:15,110 --> 00:10:19,220
!أجل، إنّه بورش ضدّ فيراري في عِراك مستميت

103
00:10:19,220 --> 00:10:23,680
لا أريد حتّى التّفكير في تكلفة
هاتين السيّارتين الباهظة

104
00:10:32,300 --> 00:10:35,900
اتّخذتُ موقفاً خشناً. سرعتي لا تنخفض

105
00:10:35,900 --> 00:10:38,070
لم تعُد إطاراتي الأماميّة تثبت؟

106
00:10:38,740 --> 00:10:40,850
لا ترتعد. انتظر فحسب

107
00:10:40,850 --> 00:10:43,830
،إذا ارتعدتُ وأفلتُّ الدوّاسة
سينتهي الأمر خلال ثانية

108
00:10:43,830 --> 00:10:47,250
سأسترخي تدريجيّاً وأنتظر
الإطارات حتّى تهدأ

109
00:10:47,250 --> 00:10:50,720
هيّا. يجب أن تثبت إطاراتي الأماميّة

110
00:10:51,130 --> 00:10:52,500
!عودي إليّ

111
00:11:02,720 --> 00:11:04,150
شبح م.ف

112
00:11:08,510 --> 00:11:09,850
شبح م.ف

113
00:11:24,710 --> 00:11:27,130
!السيّارة 1 تدور

114
00:11:27,130 --> 00:11:30,100
!بالكاد تمكّنت السيّارة 2 من المرور

115
00:11:30,290 --> 00:11:33,920
!توقّف وهو في مواجهة الجهة الخاطئة

116
00:11:33,920 --> 00:11:37,400
والسيّارات خلفه تمرّ الواحدة تلو الأخرى

117
00:11:39,470 --> 00:11:42,300
من مركز التحكّم إلى سائق السيّارة 1

118
00:11:42,300 --> 00:11:45,550
أنت في مكان خطير. ابقَ حيث أنت

119
00:11:45,550 --> 00:11:47,780
لا تتحرّك حتّى نطلب منك ذلك

120
00:11:51,760 --> 00:11:53,560
طائرة من دون طيّار؟

121
00:11:53,970 --> 00:11:55,520
لا بدّ أنّ شيئاً قد حدث

122
00:11:55,890 --> 00:11:58,670
كان العجوز إيشيغامي؟

123
00:11:59,610 --> 00:12:01,680
من السيّارة 1 إلى مركز التحكّم

124
00:12:01,680 --> 00:12:04,700
سأعود إلى السّباق. أحتاج لإذن
بعبور مُنعطف نصف دائري

125
00:12:04,700 --> 00:12:09,000
.هذا خطير جدّاً. اثبت مكانك حالياً
هناك سيّارات تقترب

126
00:12:09,000 --> 00:12:13,920
تبّاً. إلى أي درجة سيضغطون عليّ؟
كنتُ في المركز الثّالث

127
00:12:17,880 --> 00:12:21,110
بعد تعثّره في الميدان، عاد إلى السّباق

128
00:12:21,110 --> 00:12:24,390
انخفضت السيّارة 1 إلى المركز 12

129
00:12:24,390 --> 00:12:28,010
بدا ذلك كاصطدام رهيب في جدار إسمنتيّ

130
00:12:28,010 --> 00:12:30,390
هل تعتقد بأنّ سيّارته قد تضرّرت يا إيكيدا-سان؟

131
00:12:30,390 --> 00:12:35,850
بالنّظر إلى المقطع، زاوية الاصطدام
ساهمت في تخفيف الضّربة

132
00:12:36,250 --> 00:12:40,590
درجة الاحتكاك المُنخفضة بالطّريق ساهمت
أيضاً في تقليص الضّرر

133
00:12:41,190 --> 00:12:45,470
يبقى السّؤال فيما إذا كان عازل
صدماته قد تأثّر أم لا

134
00:12:46,390 --> 00:12:48,110
!رقم 7! كيوكو-تشان

135
00:12:48,110 --> 00:12:50,990
،سيتمّ نقل الكثير من اللّافتات هذه المرّة
لذا افعلا ذلك معاً رجاء

136
00:12:50,990 --> 00:12:52,290
!حسناً

137
00:12:52,290 --> 00:12:53,460
عُلِم

138
00:12:54,530 --> 00:12:58,290
لافتة السيّارة 86 ستنتقل إلى أسفل
،العمود في أقصى اليسار

139
00:12:58,290 --> 00:13:00,880
لذا من الأفضل إزالة لافتة السيّارة 1 أوّلاً

140
00:13:03,750 --> 00:13:05,340
...لنرَ

141
00:13:05,970 --> 00:13:06,860
تماماً

142
00:13:08,530 --> 00:13:11,770
المركز الخامس؟ هذا جنون يا كاناتا

143
00:13:12,430 --> 00:13:13,940
ما الّذي يجري هناك؟

144
00:13:26,200 --> 00:13:30,030
والآن، سؤال للملاكتين اللّتين
أنهيتا واجبهما للتو

145
00:13:30,430 --> 00:13:34,370
سنبدأ مع الرّقم 7. إذا سنحتْ لكِ فُرصة
للذّهاب إلى مكانٍ ما، فإلى أين ستذهبين؟

146
00:13:34,760 --> 00:13:40,990
في الواقع، يخطر على ذهني مكان واحد
دوماً عند اقتراب الصّيف

147
00:13:41,370 --> 00:13:45,340
إنّه منزل في نيغاتا ينتمي إلى جدّتي
من طرف والدي

148
00:13:46,350 --> 00:13:48,850
،حيث الجبال والنّهر قريب

149
00:13:48,850 --> 00:13:54,100
وكنّا نذهب إلى هناك في كلّ عطلة
صيفيّة طوال فترة المدرسة الابتدائيّة

150
00:13:54,100 --> 00:13:58,940
،لكن انشغل أبي في العمل لاحقاً
فمضى خمس سنوات منذ ذهبنا آخر مرّة

151
00:13:59,370 --> 00:14:01,340
ينبغي أن أعود بين الفيّنة والأخرى

152
00:14:01,340 --> 00:14:02,400
ينبغي لك ذلك

153
00:14:02,400 --> 00:14:05,470
لا تسهّلي عليهم تخمين عمركِ

154
00:14:05,470 --> 00:14:10,260
هناك حقول أرزّ بالقرب من منزلها أيضاً

155
00:14:10,260 --> 00:14:14,620
كنّا نأكل البطّيخ ونشوي. كان
ذلك غاية في المتعة

156
00:14:14,620 --> 00:14:18,870
كنتُ أفكّر في الواقع في الذّهاب إلى هناك
في عطلة هذا الصّيف خاصّتي

157
00:14:19,100 --> 00:14:23,010
يا لها من فكرة جميلة. قد تفاجئين جدّتكِ

158
00:14:23,010 --> 00:14:23,750
أجل

159
00:14:23,750 --> 00:14:26,340
...يمكنني تخيّلها الآن

160
00:14:27,080 --> 00:14:32,400
ترتدي قبّعة قشّ وفستاناً أبيض... أنا واثق
بأنّها ستبدو رائعة بالصّندل أيضاً

161
00:14:32,850 --> 00:14:36,120
الصّورة المثاليّة لعطلة صيفيّة يابانيّة

162
00:14:37,730 --> 00:14:40,860
أنا متأكّد بأنّ هذه الإجابة البريئة
،لن يكون من السّهل التحقّق منها

163
00:14:40,860 --> 00:14:42,900
لكن ماذا عنكِ أيّتها الأخت الكبرى كيوكو؟

164
00:14:42,900 --> 00:14:44,150
هوّن عليّ

165
00:14:44,900 --> 00:14:48,650
أرغب في الذّهاب إلى شاطئ استوائيّ
مُطلّ على مُحيط جميل

166
00:14:49,280 --> 00:14:54,730
حيث أرتدي بيكيني مُثيراً وأرتشف
عصيراً استوائيّاً تحت مظلّة

167
00:14:54,730 --> 00:14:57,900
وأسترخي من الصّباح حتّى المساء
دون أن أفعل شيئاً

168
00:14:59,730 --> 00:15:06,450
لقد سئمتُ من شواطئ شونان حيث
يتجمّع رجال بغيضون حولك كالذُّباب

169
00:15:06,450 --> 00:15:08,300
تبدين مُرهقة يا أختي

170
00:15:08,560 --> 00:15:10,530
مشاكل عاطفيّة مؤخّراً؟

171
00:15:10,530 --> 00:15:16,510
هذه وقاحة. فتاة مثلي هي من تهجر
!الآخرين دوماً، وليس العكس

172
00:15:20,480 --> 00:15:24,480
السيّارة 2 تعزّز وتيرة سرعتها في مركزها
الجديد في مُقدّمة مجموعة المركز الثّالث

173
00:15:24,480 --> 00:15:27,500
أكابا كايتو يتقدّم بخشونة

174
00:15:27,500 --> 00:15:28,940
من المقصورة إلى كايتو

175
00:15:28,940 --> 00:15:32,410
.الفجوة نحو المجموعة القمّة كبيرة جدّاً
لا تبالغ كثيراً

176
00:15:32,410 --> 00:15:36,400
اسمعني. إنّ الخشونة في هذه الظّروف
تُرافقها مخاطر شديدة

177
00:15:36,400 --> 00:15:39,580
ركّز فقط على إدارة السّباق
لضمان حلولك في المركز الثّالث

178
00:15:39,890 --> 00:15:41,630
من كايتو إلى المقصورة

179
00:15:41,630 --> 00:15:44,040
ما الجدوى من السّباق بالضّبط إذاً؟

180
00:15:44,450 --> 00:15:48,510
،بابتعاد ذلك البغيض في السيّارة 1 عن الطّريق
يمكنني الرّؤية بوضوح أخيراً

181
00:15:49,410 --> 00:15:52,720
إن لم تواجه التحدّي، فلن تحظى بفُرصة أبداً

182
00:15:53,220 --> 00:15:57,680
سننتهي من الحديث عن هذا عند
بلوغ الرّاية. حوّل

183
00:15:57,680 --> 00:16:05,280
بعد السيّارة 2 في المركز الثّالث، هناك فجوة نحو المعركة المُتنامية
على المركز الرّابع بين السيّارتين 13 و 86

184
00:16:06,780 --> 00:16:10,030
لم أتوقّع أن نتواجه ثانية في هذا
المكان المرتفع من الميدان

185
00:16:10,710 --> 00:16:14,490
كلانا قطعنا شوطاً ضخماً منذ سباق الافتتاحيّة

186
00:16:15,050 --> 00:16:20,610
ما زال مشهد إنجازاتك في امتداد مُنخفض
التلّة ذاك محفوراً في ذهني

187
00:16:20,610 --> 00:16:23,380
أشعر وكأنّني أُصِبتُ باضطراب ما بعد الصّدمة

188
00:16:24,590 --> 00:16:27,560
ما يجعل هذه الفُرصة المثاليّة لتجاوزه

189
00:16:27,960 --> 00:16:30,210
!سأبقى أمامك

190
00:16:30,970 --> 00:16:34,590
السيّارة 86 مُلاصقة لـ ن.س.أكس
ذات القوّة الأكبر

191
00:16:34,590 --> 00:16:36,290
،رأينا ذلك في المرحلة التّأهيليّة

192
00:16:36,290 --> 00:16:40,160
لكن لدى كاتاغيري كاناتا موهبة حقيقيّة
في تجاوز هذا القسم المُحرَّج

193
00:16:40,560 --> 00:16:45,020
قابليّة الرّؤية في هذا القسم من المضمار
ضعيفة ويوجد الكثير من الزّوايا العمياء

194
00:16:45,020 --> 00:16:50,830
قوّة الجاذبيّة الأفقيّة الّتي يخضع لها السّائق
تسهّل أيضاً من تعزيز السّرعة

195
00:16:50,830 --> 00:16:53,530
كلّ هذا يصعّب عمليّة مهاجمة المضمار

196
00:16:53,800 --> 00:16:56,290
...ما هو ملحوظ في كاتاغيري-كن

197
00:16:56,290 --> 00:17:00,490
هو كيف يبدو أنّه حفظ هذا المضمار المُعقّد

198
00:17:00,710 --> 00:17:05,460
لا يوجد تفسير آخر لشجاعته في مثل
هذا القسم الصّعب

199
00:17:05,790 --> 00:17:10,380
حتّى المخضرمين الّذين تسابقوا هنا عدّة
مرّات لا يفهمون هذا القسم جيّداً

200
00:17:14,630 --> 00:17:19,180
"أنا متردّد قليلاً عن قول كلمة "عبقريّ

201
00:17:19,400 --> 00:17:23,600
لكن من الواضح أنّ كاتاغيري-كن
سخّر كثيراً من الوقت والطّاقة

202
00:17:23,600 --> 00:17:26,160
في تحضيراته لهذا السّباق

203
00:17:26,810 --> 00:17:30,110
،معظم الرّياضات تشترك في ذلك

204
00:17:30,460 --> 00:17:35,930
لكن تبرز الموهبة الحقيقيّة من حوض
بذور جهود قديمة

205
00:17:37,280 --> 00:17:43,580
تلتقط الكاميرا الثّنائي المُتصدِّر، السيّارة 4 و 12 بينما
تخرجان من القطاع 2 وتدخلان القطاع 3

206
00:17:44,220 --> 00:17:46,870
يبدو أنّ نزالهما قد هدأ

207
00:17:46,870 --> 00:17:51,000
لا أعتقد ذلك. نحن نشهد حرباً
نفسيّة حابسة للأنفاس

208
00:17:51,590 --> 00:17:59,020
لاحظتُ أنّ ساواتاري-كن كان يشكّل ضغطاً
لتضليل السيّارة 12 بعد التصدُّر

209
00:17:59,020 --> 00:18:01,810
لكن لم تُثمِر جهوده

210
00:18:01,810 --> 00:18:05,120
يستجيب بيكنباور لتكتيكاته بقلب بارد

211
00:18:05,860 --> 00:18:10,910
على العكس، أسلوب بيكنباور التّحفّظيّ
في مُهاجمته مُخيف قليلاً

212
00:18:11,290 --> 00:18:14,350
أعتقد أنّ ساواتاري-كن يواجه وقتاً عصيباً هنا

213
00:18:19,750 --> 00:18:23,950
لكن كم هذا مُطمئن. سنكون في وضع
بائس لولا هذه الخيمة

214
00:18:24,180 --> 00:18:26,810
كنتُ بمزاج عكِر في الأمس

215
00:18:26,810 --> 00:18:31,330
كنتُ متأكّدة بأنّنا سنُغمَر بالمياه بينما نؤدّي
عملنا ونقلّب لافتات لائحة المُتسابقين

216
00:18:31,600 --> 00:18:35,210
تعلمين بأنّني ما كنتُ لأتحمّل هراء كهذا

217
00:18:35,210 --> 00:18:39,420
رغم أنّه لم يكن هناك خيمة
في سباق الافتتاحيّة، صحيح؟

218
00:18:39,420 --> 00:18:42,520
من الآن فصاعداً، ينبغي أن يكون هناك
خيمة في كلّ سباق

219
00:18:43,690 --> 00:18:49,700
رغم ذلك، الأشعّة فوق البنفسجيّة في الصّيف ضارّة
جدّاً، لذا لا تنسي أن تدهني من الواقي الشّمسيّ

220
00:18:50,340 --> 00:18:53,110
،أنتِ تتكتّمين على هذا العمل سرّاً
أليس كذلك يا رين-تشان؟

221
00:18:54,020 --> 00:18:59,560
إذا ذهبتِ إلى مسبح أو شاطئ بعد أن تشكّلت خطوط
السّمرة في جسدكِ بسبب هذا الزي، ستنكشفين

222
00:19:00,000 --> 00:19:03,960
.لا سيّما هذا العِقد المُجنّح الّذي نرتديه
سيجعل الأمر مكشوفاً

223
00:19:06,070 --> 00:19:09,570
معكِ حقّ. حريّ بي أن أتوخّى الحذر

224
00:19:11,640 --> 00:19:13,190
ملابس سباحة؟

225
00:19:13,920 --> 00:19:16,980
لستُ واثقة بما يكفي من ارتداء
واحد أمام كاناتا

226
00:19:17,410 --> 00:19:21,020
وليست لديّ منحنيات لأبدو جيّدة ببيكيني

227
00:19:21,690 --> 00:19:26,180
أنا واثقة أنّ شخصاً قادماً من بلاد أجنبيّة
مثل كاناتا سيعتقدني طفلة

228
00:19:53,000 --> 00:19:56,500
يبدو أنّه لا فراغ لا تستطيع سيّارة 86
المرور منه مهما كان صغيراً

229
00:19:56,720 --> 00:20:01,010
يبدو أنّ السّرعة الّتي تُظهرها هي
!السّلاح السرّي لكاتاغيري كاناتا

230
00:20:03,350 --> 00:20:06,880
لكن هذا هو القطاع 3، حيث السيّارات
!الأسرع هي الّتي يمكنها أن تسود

231
00:20:06,880 --> 00:20:11,210
من الغيار الأوسط وما فوق، لا تستطيع
!تويوتا 86 جي.تي المُجاراة

232
00:20:11,210 --> 00:20:14,220
!من الواضح أنّ ن.س.أكس مُتفوّقة

233
00:20:17,430 --> 00:20:20,110
لو كانت هناك زاوية أخرى
،بعد السّير جنباً إلى جنب

234
00:20:20,110 --> 00:20:22,990
لتمكّن من تجاوز الخصم

235
00:20:23,730 --> 00:20:28,720
إنّ الهجوم في خطّ سريع كهذا
هو ضرب من الطّيش يا كاناتا

236
00:20:29,120 --> 00:20:33,730
تمكّنت 86 من الصّمود بفضل
،سرعته عند المُنعطفات

237
00:20:33,730 --> 00:20:39,030
لكنّه يواجه الآن سائقين لا ينوون
تسهيل الأمر بالنّسبة له

238
00:20:39,030 --> 00:20:43,050
هذا واضح نظراً إلى أنّه تندلع
معركة على المركز الرّابع

239
00:20:43,500 --> 00:20:49,060
ذكرتُ بأنّ الأمطار كانت قد خفّفت
...من سلبيّات 86

240
00:20:49,460 --> 00:20:52,600
لكن لا شيء يلغي إعاقتها كلّياً

241
00:20:53,270 --> 00:20:56,910
مركزه الحاليّ قد يكون سقف
ما يستطيع تحقيقه

242
00:20:56,910 --> 00:20:58,630
أعتقد هذه هي حدوده

243
00:20:59,760 --> 00:21:03,550
وعندما لا تستطيع المُنافسة في القطاع 3
،من أشينوكو جي.تي

244
00:21:03,550 --> 00:21:06,910
فلا يمكنك المنافسة فعليّاً
في بقيّة السّباق

245
00:21:07,300 --> 00:21:10,850
إنّها حقيقة قاسية يجب على 86
أن تواجهها وتتقبّلها

246
00:21:11,720 --> 00:21:15,580
...لا يمكن أن أكون الوحيد الّذي يريد

247
00:21:15,890 --> 00:21:19,840
رؤية كاتاغيري كاناتا يقود مركبة أكثر تنافسيّة

248
00:21:19,840 --> 00:21:23,840
صدّقني، لا أحد يريد ذلك أكثر منّي

249
00:21:24,600 --> 00:21:27,470
،حتّى لو تجاوز كاناتا الحدود الّتي بلغها الآن

250
00:21:28,190 --> 00:21:32,460
نصف جائزة المركز الخامس الّتي قدرها 50 مليون ين
سوف تكون من نصيبي. أي 10 مليون

251
00:21:33,110 --> 00:21:38,480
سيغطّي هذا فواتير المشفى الخاصّة بأبي
وكذلك كافّة ديون المتجر

252
00:21:39,300 --> 00:21:41,820
،أريد ذلك المال باستماتة بالفعل

253
00:21:42,180 --> 00:21:44,690
لكن ثمّة شيء يجب أن أقوم به أوّلاً

254
00:21:45,910 --> 00:21:48,080
لقد اتّخذتُ قراري يا كاناتا

255
00:21:49,120 --> 00:21:52,600
عندما ينتهي هذا السّباق، سوف أحقّق ذلك

256
00:23:31,590 --> 00:23:36,970
:الحلقة القادمة
شيطان أشينوكو سكايلاين