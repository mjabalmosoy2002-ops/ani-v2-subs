1
00:00:05,350 --> 00:00:08,070
!تستمرّ 86 في إشعال عجلاتها

2
00:00:09,850 --> 00:00:15,320
حتّى الهاوي يستطيع أن يعرف بأنّ كاتاغيري
!كاناتا يقود في المضمار بخبرة كبيرة

3
00:00:15,570 --> 00:00:18,780
حافظ على الخُطى الّتي يحتاجها
،لكسر الرّقم القياسيّ للمضمار

4
00:00:18,780 --> 00:00:20,770
وثمّة نفق أخير ينتظر

5
00:00:21,090 --> 00:00:25,500
!حالما يعبر، سيبلغ خطّ النّهاية

6
00:00:27,000 --> 00:00:30,880
أهذه هي؟ هل سنشهد رقماً قياسيّاً
!جديداً في مضمار؟

7
00:00:30,880 --> 00:00:33,920
!إنّه يقود كإله شيطانيّ

8
00:00:39,910 --> 00:00:45,210
صدمَتْنا تويوتا 86 جي.تي جميعنا
!بكسر رقم المضمار القياسيّ

9
00:00:49,470 --> 00:00:51,330
هذا جنون يا كاناتا

10
00:00:51,330 --> 00:00:53,850
لعلّ هذا السّحر قد بجودة أكبر من اللّازم

11
00:02:27,830 --> 00:02:29,920
،من الغريب الحديث عن الأمر الآن

12
00:02:29,920 --> 00:02:33,920
لكن كان أوكوياما-سان يقول بأنّه يهدف
للمركز الخامس في مرحلة التّصفيات

13
00:02:33,920 --> 00:02:37,000
بدلاً من ذلك، فعلتَها وحطّمتَ
الرّقم القياسيّ للمضمار

14
00:02:37,000 --> 00:02:38,880
أنا واثق بأنّه كان مصدوماً

15
00:02:38,880 --> 00:02:41,990
لا. ما زالت هناك أربعة أيّام
من مرحلة التّصفيات

16
00:02:41,990 --> 00:02:44,970
هناك كثير من السّائقين السّريعين
الّذين لم يُشاركوا بعد

17
00:02:44,970 --> 00:02:49,880
أظنّني سأحتلّ في نهاية المطاف المركز
الخامس كما توقّع السيّد أوكوياما

18
00:02:50,950 --> 00:02:54,800
لستُ راضياً تماماً عن أداء الأمس

19
00:02:55,230 --> 00:02:57,360
ارتكبتُ بضعة أخطاء

20
00:02:57,700 --> 00:03:00,080
كان بوسعي تحقيق رقم أفضل

21
00:03:03,620 --> 00:03:06,650
مُذهل، بدأت السيّارة 4

22
00:03:06,650 --> 00:03:08,290
إنّه ساواتاري كوكي

23
00:03:08,290 --> 00:03:12,830
تمكّن من بثّ الرُّعب في قلب
بيكنباور في أشينوكو جي.تي

24
00:03:13,220 --> 00:03:16,340
تجاوزَتْني سيّارتُه في طريق رئيسيّ
في تلك المرّة

25
00:03:16,580 --> 00:03:20,920
منذ ذلك الحين، أيقنتُ كم هو فائق السّرعة

26
00:03:28,740 --> 00:03:31,730
لماذا أنا مُتحفّز جدّاً في هذا الموسم؟

27
00:03:31,730 --> 00:03:33,400
الجواب واضح

28
00:03:33,980 --> 00:03:36,860
كاناتا ريفينغتون. هذا لأنّك في سِباق

29
00:03:37,600 --> 00:03:42,660
،كان جانبي التّنافسيّ نائماً، لكن الآن
كلّ جزء منه صاحٍ تماماً

30
00:03:43,090 --> 00:03:46,280
لم تعُد الفتيات أولويّتي بعد الآن

31
00:03:47,450 --> 00:03:49,580
آسف بشأن ذلك يا سانا

32
00:03:49,920 --> 00:03:52,270
لكن هذه هي حقيقتي

33
00:03:52,850 --> 00:03:55,630
مكتب أوداوارا مزدحم يا ناس

34
00:03:56,160 --> 00:04:01,760
وتيرة ساواتاري كوكي تُنافس الرّقم القياسيّ
!الجديد الخاصّ بالمضمار في الأمس

35
00:04:06,160 --> 00:04:08,940
!لا تمزح مع ساواتاري في السيّارة 4

36
00:04:08,940 --> 00:04:11,100
!إنّه مُتقدّم الآن بعِشر من الثّانية

37
00:04:11,100 --> 00:04:14,030
!إنّه في طريقه نحو القمّة

38
00:04:14,030 --> 00:04:18,470
"مُبهر. هذا هو الفرق بين شكل "أتش
ومُبدِّل غيار

39
00:04:18,860 --> 00:04:22,490
عندما تُبدّل الغيار أثناء تعرّضك
،لجاذبيّة أفقيّة شديدة

40
00:04:22,490 --> 00:04:28,370
فهنالك دوماً هدر للوقت بينما تنقل
يدك من المِقود إلى المِقبض

41
00:04:29,340 --> 00:04:34,510
،لكن إذا ذكرتُ ذلك، فسأزعج أوغاتا-سان
لذا سوف أبقى صامتاً

42
00:04:43,090 --> 00:04:48,470
تبّاً يا رجل. السيّارة ضعيفة، لكنّه
يُعاملها كامتداد لأطرافه

43
00:04:48,990 --> 00:04:52,810
قبل الظّهور الأوّل لمايكل بيكنباور
،وكاتاغيري كاناتا

44
00:04:52,810 --> 00:04:57,560
مُصطلح "أعجوبة م.ف.ج الشّاب" قد أُطلِق
على هذا السّائق

45
00:04:58,380 --> 00:05:03,450
،كان ساواتاري يقود بتألُّق في السيّارة 4
كما لو أنّه يعلن بأنّه ما زال هنا

46
00:05:16,890 --> 00:05:17,960
!ها هو ذا

47
00:05:17,960 --> 00:05:21,920
الرّقم القياسيّ الجديد دام يوماً واحداً
!قبل أن يكسره ساواتاري كوكي

48
00:05:21,920 --> 00:05:24,420
!بجزئين عشريّين من الثّانية

49
00:05:24,890 --> 00:05:26,910
عمليّة النّقل قد أحدثت الفرق

50
00:05:31,550 --> 00:05:36,560
عشران من الثّانية فقط؟ أقسم
بأنّني كنتُ أُبلي أفضل من ذلك

51
00:05:37,040 --> 00:05:41,200
لا أعرف السّبب، لكن يراودني
هذا الإحساس بالفزع

52
00:05:44,940 --> 00:05:49,870
هيّا يا جي.تي.آر. امنحيني ما أحتاج

53
00:06:12,980 --> 00:06:16,040
إنّها اللّحظة الّتي كنتُم تنتظرونها
يا مُعجبي م.ف.ج

54
00:06:16,040 --> 00:06:18,610
،بعد تأخير لخمسة أيّام بسبب المطر

55
00:06:18,610 --> 00:06:23,020
حان الوقت أخيراً لليوم الخامس
من مرحلة التّصفيات

56
00:06:32,450 --> 00:06:33,360
أحسنت صنعاً

57
00:06:33,360 --> 00:06:34,700
أحسنت صنعاً اليوم

58
00:06:35,040 --> 00:06:37,620
هل ستكونين بخير في امتحاناتك إذاً؟

59
00:06:37,620 --> 00:06:43,520
أجل. بفضل الطّقس، هناك فجوة زمنيّة كافية لاجتيازها
جميعها، لذا أنا مُتفرّغة في اليوم الأخير

60
00:06:43,520 --> 00:06:45,840
هذا يعني بأنّني لن أحتاج امتحاناً تعويضيّاً

61
00:06:46,500 --> 00:06:49,780
شكراً جزيلاً لك يا إله الطّقس

62
00:06:54,050 --> 00:06:58,310
في السّنوات الأولى من م.ف.ج، اشتُهِر
،ياناغيدا تاكويا بأنّه ساحر المُنعطفات

63
00:06:58,310 --> 00:07:00,770
ويُثبت بأنّه ما زال يستحقّ هذا اللّقب

64
00:07:00,770 --> 00:07:06,730
ما زال مُتفوِّقاً على البقيّة، تسير
السيّارة 6 بخُطى سريعة

65
00:07:07,190 --> 00:07:10,530
ياناغيدا-سان، انتقلتَ إلى م-4؟

66
00:07:10,830 --> 00:07:15,260
أجل. إنّ رؤية البعض من هؤلاء السّائقين
الجدُد جعلَتْني أُدرك شيئاً

67
00:07:15,260 --> 00:07:18,790
م-6 كبير جدّاً على الرّشاقة الّتي
سأحتاجها للمضيّ قُدماً

68
00:07:19,370 --> 00:07:26,630
في السّابق، كنتُ إذا حصلتُ على نقطة انطلاق جيّدة، فأستطيع استخدام
الشّاسيه الأكبر الخاصّ بي لإبقاء المُتسابقين خلفي

69
00:07:27,040 --> 00:07:28,710
لكن ليس بعد الآن

70
00:07:29,150 --> 00:07:32,630
،فإذا تمسّكتُ بتلك التّكتيكات الكسولة
سوف يتمّ إقصائي

71
00:07:35,820 --> 00:07:39,610
هذه هي الـ م.ف.ج الّتي كنتُ
أريدها منذ البداية

72
00:07:39,980 --> 00:07:42,600
نحن نجذب الأنظار من كلّ أنحاء العالم

73
00:07:42,600 --> 00:07:45,300
فلِمَ لا ينبغي أن نكون قُساة معهم؟

74
00:07:46,150 --> 00:07:50,110
،إذا ما رأيتُ أدنى فُرصة
سوف أنتهزها فوراً

75
00:07:50,390 --> 00:07:54,170
لم أنسَ بأنّك تجاوزتني بهذا
الشّكل في أوداوارا

76
00:07:54,740 --> 00:07:57,740
لكن أضمن بأنّك ستتمكّن من ردّ الاعتبار

77
00:07:57,740 --> 00:07:59,330
يروقني ذلك

78
00:07:59,330 --> 00:08:00,870
حظّاً سعيداً هناك

79
00:08:11,340 --> 00:08:13,140
كيف سار اختبارك؟

80
00:08:13,140 --> 00:08:14,800
أنا قلقة بشأن الفيزياء

81
00:08:15,200 --> 00:08:18,100
دائماً ما تقولين ذلك، لكن تبلين
حسناً في النّهاية

82
00:08:18,100 --> 00:08:19,890
لكن هذه المرّة، أنا جادّة

83
00:08:20,210 --> 00:08:23,940
كنتُ مشغولة جدّاً بعملي، كنتُ قد واجهتُ
صعوبة في التّركيز في الفصل الأوّل

84
00:08:24,460 --> 00:08:27,530
هل أنتِ متأكّدة بأنّه كان
العمل وليس كاناتا-سان؟

85
00:08:27,530 --> 00:08:31,520
،قد يكون هذا سبباً من الأسباب
لكن لن أعترف بذلك أبداً

86
00:08:32,640 --> 00:08:37,590
فكرة انخفاض درجاتي لأنّني أحبّ
كاناتا مُحزِنة جدّاً

87
00:08:37,590 --> 00:08:41,010
هذا أسوأ نوع من أنواع الحُبّ

88
00:08:42,290 --> 00:08:45,130
يجب أن أعمل باجتهاد لأجله

89
00:08:45,130 --> 00:08:48,860
بقي يومان. سأبذل قصارى
جهدي وأكون قويّة

90
00:08:52,160 --> 00:08:56,390
إنّه صاعد في سباقه الأوّل، لكنّه
يقدّم أداء مُلفِتاً

91
00:08:56,830 --> 00:09:00,890
!السيّارة 885، تويوتا جي.آر سوبرا

92
00:09:00,890 --> 00:09:03,310
واسم السّائق هو موروبوشي سينا

93
00:09:03,310 --> 00:09:06,670
إنّه في المركز السّابق حاليّاً

94
00:09:07,100 --> 00:09:11,900
نظراً إلى أنّ هذا هو اليوم السّادس من مرحلة
التّصفيات، فهذا مركز مُلفِت

95
00:09:12,370 --> 00:09:13,860
أكاديميّة بورش

96
00:09:13,860 --> 00:09:15,820
برنامج دراسيّ أجنبيّ في فرنسا

97
00:09:16,230 --> 00:09:19,080
مدرسة سِباق بريطانيّة شهيرة

98
00:09:19,120 --> 00:09:21,160
تبّاً لهذا الهُراء

99
00:09:22,350 --> 00:09:24,290
مهما قضيت من وقت في أوروبّا

100
00:09:25,040 --> 00:09:29,460
ما تحتاجه في م.ف.ج هو الموهبة
في سِباق السيّارات

101
00:09:30,140 --> 00:09:32,650
،بعد إنهاء مشروع شارع كانتو الخاصّ به

102
00:09:32,650 --> 00:09:36,090
أصبح ريو تاكاهاشي ملِك م.ف.ج
بصفته مُؤسّسه

103
00:09:36,090 --> 00:09:42,010
الحمض النّوويّ الرّيبيّ المطلوب لتكون الأسرع
في الطّرُق العامّة قد نُقِل إلى الزّعيم، ثمّ إليّ

104
00:09:42,910 --> 00:09:45,680
أساسي بأكمله هو فخر غونما

105
00:09:46,250 --> 00:09:50,470
.سوف أريهم ما الّذي يعنيه ذلك
عينايّ تُركّزان على القمّة

106
00:09:50,860 --> 00:09:54,010
في السّباق الأوّل لبيكنباور، احتلّ المركز السّابع

107
00:09:54,010 --> 00:09:58,690
حتّى كاتاغيري كاناتا كان في المركز 12 في أوّل
سِباق زمنيّ له، لينجح بالكاد في السّباق

108
00:09:58,690 --> 00:10:04,450
ويحذو حذوّه هذا السّائق الشّاب والمُقدَّر له أن يكون
!ضمن الإلَهيّين الخمسة عشر

109
00:10:04,810 --> 00:10:06,250
!مُذهل

110
00:10:06,250 --> 00:10:09,570
،إذا كانت كاناغاوا موطِناً بالنّسبة لأوكوياما
،مُحقِّق مُعجزة عازل الصّدمات

111
00:10:09,570 --> 00:10:13,590
ففي غونما، لديهم ماتسوموتو شويتشي
والمعروف بـ"يد الإله" لخبرته

112
00:10:14,250 --> 00:10:18,060
كان ماتسوموتو في الأصل ميكانيكيّاً
في ريدسانس

113
00:10:18,060 --> 00:10:21,450
أصقلَ مهاراته بتلبية مطالب ريوسكي الصّعبة

114
00:10:22,190 --> 00:10:25,110
كان ميكانيكيّاً لسائقي التّلال
،في مشروع دي

115
00:10:25,110 --> 00:10:27,530
والآن هو عضو في مشروع دريم

116
00:10:28,530 --> 00:10:33,630
إنَّ سوبرا هذه هي تحفة ماتسوموتو شويتشي
الّتي تستعرض كلّ معرفته بسباق الشّوارع

117
00:10:34,040 --> 00:10:38,880
بالإضافة إلى ذلك، اللّون الأصفر الفاقع هو نفس اللّون
التّقليديّ الّذي استخدمه كيسكي في ف.د خاصّته

118
00:10:41,170 --> 00:10:42,530
غرغرت الدّمعة في عيني

119
00:10:42,880 --> 00:10:45,600
أعتقد بأنّ الإنسان يزداد عاطفيّة
مع التقدُّم في العمر فعلاً

120
00:10:49,650 --> 00:10:54,920
ها هو ذا! الصّاعد موروبوشي سينا يُنهي
!سِباقه في المركز السّابق مؤقّتاً

121
00:10:55,240 --> 00:10:58,250
،لطالما أحدثتْ شبه الجزيرة بلبلة

122
00:10:58,250 --> 00:11:01,710
!وبقي الآن يوم واحد فقط من مرحلة التّصفيات

123
00:11:07,370 --> 00:11:10,390
رين، عيناك حمراوتان! هل أنتِ بخير؟

124
00:11:10,390 --> 00:11:12,190
هل نمتِ جيّداً؟

125
00:11:12,190 --> 00:11:15,680
لا مُشكلة. سأدرس في المكتبة
حتّى مساء اليوم

126
00:11:15,680 --> 00:11:19,110
ثمّ سأعود إلى المنزل وأتناول العشاء
وأحظى بقليل من النّوم

127
00:11:19,110 --> 00:11:21,990
قبل الاستيقاظ والدّراسة طوال
اللّيل مجدّداً، صحيح؟

128
00:11:21,990 --> 00:11:25,670
طريقتكِ في التّركيز الفائق مُبهرة فعلاً

129
00:11:35,370 --> 00:11:39,720
اسمعي. تعرّض أحد أقربائي
لحادث سير مؤخّراً

130
00:11:39,720 --> 00:11:41,720
،لم يُصَب أحدٌ بجروح

131
00:11:42,030 --> 00:11:46,040
لكنّه في حقيقة الأمر يشتري تميمة
أمان من حوادث السّير في كلّ عام

132
00:11:46,040 --> 00:11:49,180
وكان هذا أوّل عام منذ زمن بعيد
لم يشترِ واحدة

133
00:11:49,180 --> 00:11:51,570
،عقب ذلك، سارع للحصول على واحدة

134
00:11:51,570 --> 00:11:55,650
"!قائلاً، "حماية هاتشيمان-ساما مُذهلة حقّاً

135
00:11:55,870 --> 00:11:57,900
أليس هذا طريفاً؟

136
00:11:57,900 --> 00:11:59,740
تميمة؟

137
00:12:00,010 --> 00:12:03,920
كنتُ أفكّر في الحصول على واحدة
لأجله منذ مدّة

138
00:12:03,920 --> 00:12:07,850
أنا واثقة بأنّه سيفرح بذلك نظراً
إلى عشقه للمزارات

139
00:12:07,850 --> 00:12:09,160
تقصدين كاناتا؟

140
00:12:09,550 --> 00:12:12,810
لنتوجّه إلى مزار هاتشيمان في طريق عودتنا

141
00:12:12,810 --> 00:12:16,480
ماذا؟ بالتّأكيد، لكن ألا يمكن تأجيل
ذلك إلى ما بعد انتهاء الامتحانات؟

142
00:12:16,480 --> 00:12:18,300
لن يفلح هذا

143
00:12:18,600 --> 00:12:20,710
غداً هو يوم مُواعدتنا المعتاد

144
00:12:23,430 --> 00:12:26,050
من المقصورة إلى مايكل. يسير
كلّ شيء وفق الخطّة حتّى الآن

145
00:12:26,050 --> 00:12:29,510
.أنت متخلّف عِشرين من الثّانية فقط
هذا ممتاز. حوّل

146
00:12:29,940 --> 00:12:33,730
هذا أوّل مضمار م.ف.ج تسابقتُ
فيه في العام الأخير

147
00:12:34,510 --> 00:12:38,320
بما أنّ هذه محاولتي الثّانية، فأشكّ
في أنّ أحداً سيهزمني

148
00:12:39,270 --> 00:12:41,740
لا حاجة للضّغط على نفسي لدرجة
تُسبّب لي الإجهاد

149
00:12:41,740 --> 00:12:44,200
،سأحافظ على مُعدّل نبضات قلب مُنخفض

150
00:12:47,080 --> 00:12:51,540
رغم ذلك، لا أنوي التخلّي عن الصّدارة

151
00:12:53,500 --> 00:12:56,960
لأنّ هذا سيكون الاستعراض الأنقى للسّرعة

152
00:12:57,270 --> 00:13:01,420
مُذهل! هل تتصدّر السيّارة 12 القطيع؟

153
00:13:01,420 --> 00:13:04,470
إنّه مُتقدّم الآن بعِشرين من الثّانية

154
00:13:07,690 --> 00:13:09,140
!وتمّ تأكيد ذلك

155
00:13:09,470 --> 00:13:14,640
كسرَ مايكل بيكنباور الرّقم القياسيّ الخاص
!بالمضمار وتولّى الصّدارة

156
00:13:15,090 --> 00:13:19,780
ثلاثة سائقين يكسرون الرّقم الزّمنيّ
التّجريبيّ الخاصّ بكيسكي؟

157
00:13:20,190 --> 00:13:23,750
هذه أوّل مرّة نشهد موهبة
كهذه في م.ف.ج

158
00:13:39,130 --> 00:13:41,670
يبدو أنّه سيكون يوماً صحواً غداً

159
00:13:41,670 --> 00:13:45,360
هذا ممتاز. السّباق في أجواء
جافّة هو الأفضل

160
00:13:45,360 --> 00:13:49,890
رغم كوننا في موسم ماطر، إلّا أنّ الطّقس
جيّد دوماً في يوم سِباق شبه الجزيرة

161
00:13:50,910 --> 00:13:54,220
تُعَدّ إحدى أعاجيب م.ف.ج السّبع

162
00:13:54,560 --> 00:13:56,020
الأعاجيب السّبع"؟"

163
00:13:56,730 --> 00:13:57,980
ماذا؟

164
00:14:01,630 --> 00:14:03,360
!انتهينا أخيراً

165
00:14:04,170 --> 00:14:06,820
شكراً على القهوة يا أوغاتا-سان

166
00:14:06,820 --> 00:14:09,210
سأراكِ غداً

167
00:14:09,210 --> 00:14:10,910
ستذهب إلى المُواعدة من الآن؟

168
00:14:10,910 --> 00:14:14,870
لكنّ الوقت مُبكّر. ألا تزال رين-تشان في المدرسة؟

169
00:14:15,120 --> 00:14:18,060
لديها امتحانات لذا سوف تخرج باكراً

170
00:14:18,060 --> 00:14:20,670
وهذه ليست مُواعدة

171
00:14:20,670 --> 00:14:23,960
سأرافقها فقط في رحلة إلى معبد

172
00:14:31,960 --> 00:14:34,760
آسفة! هل انتظرتَ طويلاً يا كاناتا؟

173
00:14:38,380 --> 00:14:39,940
هل أنتِ بخير يا رين؟

174
00:14:40,230 --> 00:14:42,520
تبدين شاحبة قليلاً

175
00:14:42,520 --> 00:14:46,080
لا تُحدِّق بي من هذه المسافة
!القريبة يا كاناتا

176
00:14:46,080 --> 00:14:47,710
أبدو قبيحة اليوم

177
00:14:48,080 --> 00:14:52,370
،لاحظتُ بأنّكِ لم تنامي جيّداً مؤخّراً

178
00:14:52,370 --> 00:14:57,830
لا حاجة للقلق. أشعر بالرّاحة الآن
بعد أن انتهيتُ من امتحاناتي. هيّا بنا

179
00:15:00,570 --> 00:15:03,130
متى ينبغي أن أعطيه التّميمة؟

180
00:15:04,410 --> 00:15:05,250
ماذا؟

181
00:15:07,260 --> 00:15:09,720
حصلَ على واحدة بالفعل؟

182
00:15:10,070 --> 00:15:11,280
كاناتا

183
00:15:12,190 --> 00:15:13,940
من أين حصلت على هذه التّميمة؟

184
00:15:13,940 --> 00:15:18,660
أعطاني إيّاها أحد سائقي م.ف.ج

185
00:15:18,660 --> 00:15:22,380
كاناتا، هذا السّائق الآخر... هل كان فتاة؟

186
00:15:23,210 --> 00:15:29,360
ولِمَ تسألين عن ذلك؟ جنسه
غير مهمّ بالنّسبة لي

187
00:15:30,010 --> 00:15:35,520
عندما كنتُ في أوروبّا، لم تكن هناك روح
،صداقة كبيرة بين المُتنافسين

188
00:15:36,000 --> 00:15:40,780
لكن يبدو أنّ هناك إحساساً حقيقيّاً
بالتّضامن بين سائقي م.ف.ج

189
00:15:41,150 --> 00:15:43,960
هذا صادم بصراحة

190
00:15:43,960 --> 00:15:48,220
هذا غير ممكن. لم تقل هذا الكلام
بدافع تأنيب الضّمير، أليس كذلك؟

191
00:15:48,220 --> 00:15:50,650
لا. هذا غير صحيح

192
00:15:50,650 --> 00:15:52,770
لو سألتِ، لكنتُ قد أخبرتُكِ

193
00:15:52,770 --> 00:15:54,760
لم أكن أحاول التكتّم على ذلك

194
00:15:56,300 --> 00:15:59,320
أنا مُشوّش قليلاً بشأن ما تحاولين قوله يا رين

195
00:15:59,320 --> 00:16:01,400
،ربّما لأنّكِ لستِ سائقة

196
00:16:01,790 --> 00:16:05,230
لا تفهمين ما نشعر به

197
00:16:06,920 --> 00:16:08,800
شكراً على سفركم معنا

198
00:16:08,800 --> 00:16:14,070
سيصل القطار العائد من ساغامي-أونو
إلى المنصّة 1

199
00:16:12,350 --> 00:16:15,220
أنا آسفة. لستُ أفهم

200
00:16:15,610 --> 00:16:18,620
ربّما لو كنتُ فتاة مُتسابقة، لفهمت

201
00:16:19,210 --> 00:16:22,010
لكنّني لستُ مُتسابقة، أليس كذلك؟

202
00:16:23,490 --> 00:16:24,490
خطأ

203
00:16:24,880 --> 00:16:28,180
،لكن حتّى لو لم أفهم مشاعر السّائقين

204
00:16:28,780 --> 00:16:31,340
هذا لا يمنع أن أشجّعك يا كاناتا

205
00:16:31,340 --> 00:16:34,130
أيّها الوغد. لم أعد أُبالي

206
00:16:34,550 --> 00:16:35,710
!سأذهب بمفردي

207
00:16:36,140 --> 00:16:38,810
!يمكنك العودة إلى المنزل! لا تتبعني

208
00:16:39,080 --> 00:16:41,060
!رين! انتظري أرجوكِ

209
00:16:43,610 --> 00:16:44,820
تميمة حظّ سعيد؟

210
00:16:44,570 --> 00:16:47,310
سيصل القطار إلى المنصّة 1

211
00:16:47,720 --> 00:16:52,250
الرّجاء الوقوف خلف الخطّ الأصفر
حرصاً على سلامتك

212
00:16:49,270 --> 00:16:52,240
يراودني شعور فظيع. أكاد أتقيّأ

213
00:16:55,200 --> 00:16:57,790
هذا سيّئ حقّاً

214
00:17:01,200 --> 00:17:02,200
!رين

215
00:17:12,110 --> 00:17:13,800
!سقطت فتاة في السكّة

216
00:17:13,800 --> 00:17:15,800
!لا، قفز شابٌّ إلى هناك

217
00:17:24,560 --> 00:17:25,690
نحن بخير

218
00:17:26,090 --> 00:17:29,050
لم نتأذّ

219
00:17:36,660 --> 00:17:37,690
كيف حالها؟

220
00:17:37,690 --> 00:17:39,410
لا حاجة للقلق

221
00:17:39,870 --> 00:17:43,690
كانت صدمة بسيطة، لكنّها نائمة بعمق الآن

222
00:17:44,910 --> 00:17:47,980
،بحسب ما أخبرني به طاقم المحطّة

223
00:17:47,980 --> 00:17:50,360
كانت بالقرب من بداية المنصّة

224
00:17:50,360 --> 00:17:53,380
لذا كان القطار مُسرِعاً

225
00:17:53,670 --> 00:17:57,800
اندهشوا بشجاعة الشّاب الّذي قفز خلفها

226
00:17:57,800 --> 00:18:00,940
أنقذتَ حياة رين

227
00:18:00,940 --> 00:18:02,660
الأمر ليس كذلك

228
00:18:03,310 --> 00:18:06,390
لقد تشاجرنا

229
00:18:06,890 --> 00:18:08,570
أزعجتُها

230
00:18:09,200 --> 00:18:11,650
لذا أنا مسؤول عمّا حدث

231
00:18:12,410 --> 00:18:16,940
فضلاً عن ذلك، لم يكن الأمر
خطيراً كما تتخيّلين

232
00:18:17,770 --> 00:18:21,640
فالسّائقون المُتسابقون أصقلوا
،رؤيتهم لتُصبح ديناميكيّة

233
00:18:22,070 --> 00:18:25,790
لذا كنتُ أقدّر مدى سرعة القطار

234
00:18:26,150 --> 00:18:27,450
عرفتُ بأنّني أستطيع فعلها

235
00:18:28,490 --> 00:18:30,740
لذا من فضلك، لا تشكريني

236
00:18:37,970 --> 00:18:43,620
.أنت طيّب القلب يا كانا-تشان
عائلتنا ممتنّة لك

237
00:18:49,960 --> 00:18:53,400
كذبتُ على ماما مايوكو

238
00:18:54,020 --> 00:18:57,940
،كنتُ أستوعب حقّاً مدى سرعة القطار

239
00:18:58,350 --> 00:19:02,430
لكن لم أكن متأكّداً من أنّني
سوف أفعلها في الوقت

240
00:19:03,430 --> 00:19:05,210
كان ذلك وشيكاً حقّاً

241
00:19:06,340 --> 00:19:12,650
بالكاد أتذكّر عندما احتكّ كعب حذائي
الرّياضيّ بعجلات القطار

242
00:19:14,290 --> 00:19:16,920
،عندما أمسكتُ برين وتدحرجتُ نحو الجانب الآخر

243
00:19:17,460 --> 00:19:21,850
أُصيب مِرفقي الأيسر الّذي كان بارزاً

244
00:19:22,850 --> 00:19:24,970
الألم يزداد سوءاً

245
00:19:25,320 --> 00:19:29,520
هل سأتمكّن من استخدام مِقبض الغيار
جيّداً في سِباق الغد؟

246
00:19:32,070 --> 00:19:34,610
رغم ذلك، أنا مسرور لأنّني تمكّنتُ
من إنقاذ رين

247
00:19:35,450 --> 00:19:42,290
،لو قُطِع ذراعي بأكمله من أجل إنقاذها
فلن أتحسّر على ذلك

248
00:19:44,410 --> 00:19:48,280
كان جسدها خفيفاً جدّاً عندما حملتُها

249
00:19:48,870 --> 00:19:54,060
كانت ظريفة جدّاً لدرجة كدتُ أضمّها بشدّة

250
00:20:01,020 --> 00:20:05,970
يبدو أنّ حبيبي أنقذ حياتي

251
00:20:10,550 --> 00:20:11,980
صباح الخير يا رين

252
00:20:11,980 --> 00:20:13,090
صباح الخير

253
00:20:16,430 --> 00:20:18,890
أنا مُشوّشة جدّاً الآن

254
00:20:19,780 --> 00:20:23,020
لم أتمكّن من النّظر في عينيه طيلة الصّباح

255
00:20:23,610 --> 00:20:29,080
أنا لا أحاول تجنّبه. كلّ ما في الأمر
أنّ التّفاعل معه يبدو مُربِكاً

256
00:20:29,430 --> 00:20:32,140
لم أشكره حتّى بعد

257
00:20:33,400 --> 00:20:37,730
متى حاولتُ قول شيء، أشعر
بأنّني أكاد أبكي

258
00:20:39,330 --> 00:20:44,550
.الخُرافة تُثبت صحّتها من جديد
السّماوات الصّافية فوق شبه الجزيرة

259
00:20:44,550 --> 00:20:51,200
،هذه السّماء الزّرقاء تدفعك للسّؤال
"أين الموسم الماطر؟"

260
00:20:51,760 --> 00:20:55,230
مرحباً جميعاً. أنا مُعلّقكم، تاناكا يوجي

261
00:20:55,230 --> 00:20:59,690
وزميلي في التّعليق اليوم أكياما واتارو-سان

262
00:21:00,130 --> 00:21:06,910
،سواء كان رالي اليابان، أو جيمكانا اليابان
،أو بطولة سيّارات التّجوال

263
00:21:07,290 --> 00:21:12,010
أكياما-سان هو سائق نشِط
،في مجالات متنوّعة

264
00:21:12,010 --> 00:21:15,870
ما يجعله دائم التّواجد في عالم
سِباق السيّارات

265
00:21:17,950 --> 00:21:19,750
شكراً يا كيوكو-سان

266
00:21:20,280 --> 00:21:24,590
إنّه أيضاً عضو في لجنة التّوجيه
الخاصّة بـ م.ف.ج

267
00:21:24,590 --> 00:21:27,050
أكياما-سان، شكراً على الانضمام لنا

268
00:21:27,050 --> 00:21:30,050
من دواعي سروري وجودي هنا

269
00:21:33,470 --> 00:21:38,090
أنا بحاجة للاعتذار منك ومن السيّد
أوكوياما، أوغاتا-سان

270
00:21:39,830 --> 00:21:43,570
جرحتُ باستهتار مِرفقي الأيسر في الأمس

271
00:21:45,330 --> 00:21:46,860
إنّه يؤلمني كثيراً

272
00:21:47,900 --> 00:21:51,100
لا أظنّني سأتمكّن من تبديل الغيار
بالطّريقة الّتي أريدها

273
00:23:31,380 --> 00:23:33,930
الحلقة القادمة: قرار مُرّ