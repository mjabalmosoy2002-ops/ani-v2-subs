1
00:00:00,680 --> 00:00:05,940
وهكذا، تصل 86 إلى البوّابة بينما
لا تزال هناك 15 ثانية مُتبقّية

2
00:00:07,210 --> 00:00:09,110
وها هي تُرفَع اللّافتة

3
00:00:09,110 --> 00:00:11,070
بقي عشر ثوانٍ

4
00:00:13,880 --> 00:00:18,640
خمسة. أربعة. ثلاثة. اثنان. واحد

5
00:00:20,580 --> 00:00:23,040
!وينطلق سريعاً بصورة تشبه القذيفة

6
00:00:23,040 --> 00:00:26,730
بدأ كاتاغيري كاناتا بسِباق
!أشينوكو جي.تي

7
00:00:28,070 --> 00:00:29,630
ألن تتفرّجي يا أمّي؟

8
00:00:29,880 --> 00:00:35,090
لا أريد. مُشاهدة كانا-تشان يتسابق
يُضرُّ قلبي

9
00:00:35,370 --> 00:00:39,520
الأمر ليس خطيراً كما تعتقدين يا عزيزتي

10
00:00:39,520 --> 00:00:43,560
لا سيّما بوضع موهبة كاناتا-كن بعين الاعتبار

11
00:00:43,560 --> 00:00:47,790
أبي، ألا تعتقد بأنّ الوقت قد حان للكفّ
عن إضافة "كن" بعد كاناتا؟

12
00:00:48,910 --> 00:00:51,750
أنت الفرد الوحيد في المنزل
الّذي يتعامل معه برسميّة

13
00:00:52,530 --> 00:00:55,900
بالفعل. أخبريه أن يكفّ عن ذلك

14
00:00:55,900 --> 00:00:57,740
لا مُشكلة

15
00:00:58,390 --> 00:01:02,370
في الحقيقة، بصِفتي مُعجب بسِباق
المُركبات والأمور الميكانيكيّة

16
00:01:02,370 --> 00:01:08,000
أحترم كاناتا-كن بشدّة لدرجة
أناديه بشكل عفويّ

17
00:01:08,350 --> 00:01:11,100
هنا في أشينوكو، الّذي قيل بأنّه
،أصعب مضمار في م.ف.ج

18
00:01:11,100 --> 00:01:14,170
يطلق كاتاغيري كاناتا عنان
!كلّ مهاراته الفنّية

19
00:03:00,640 --> 00:03:02,210
لن يطول الأمر كثيراً الآن

20
00:03:02,560 --> 00:03:06,040
رويداً رويداً، بدأ المنظر يتحوّل إلى لون أبيض

21
00:03:06,760 --> 00:03:10,880
حُمِلَ الرّماد البُركانيّ من جبل فوجي
،بواسطة الرّياح

22
00:03:10,880 --> 00:03:13,000
ولسبب ما، يتشبّث بتلك المنطقة

23
00:03:13,630 --> 00:03:17,820
كلّ تلك الجُسيمات تعلق بين الطّريق
والإطارات ممّا يجعل الانزلاق سهلاً للغاية

24
00:03:18,550 --> 00:03:24,680
يُطلِقون على هذه الظّاهرة بـ"هبوط حصّاد
الموتى الأبيض" والمعروفة أيضاً بفخّ الانزلاق

25
00:03:25,250 --> 00:03:28,880
مهما حاولوا تنظيفه، يعود ليتجمّع في كلّ مرّة

26
00:03:28,880 --> 00:03:31,400
إنّه إحدى أعاجيب م.ف.ج السّبعة

27
00:03:31,820 --> 00:03:34,980
من المقصورة إلى كاناتا. نحن
على وشك دخول منطقة الموت

28
00:03:34,980 --> 00:03:36,600
عليك أن تتأنّى. حوِّل

29
00:03:36,600 --> 00:03:37,530
عُلِم

30
00:03:37,990 --> 00:03:40,360
يمكنني الشُّعور ببدء انخفاض
درجة احتكاك العجلات مع الطّريق

31
00:03:40,610 --> 00:03:43,260
سأعدّل قيادتي بما يتلاءم مع ذلك. حوّل

32
00:03:44,460 --> 00:03:45,580
ماذا يقصد؟

33
00:03:54,840 --> 00:03:58,150
لم يكن انزلاقاً طبيعيّاً

34
00:03:58,150 --> 00:04:01,500
دفعَ بالنّهاية الخلفيّة نحو الزّاوية عمداً

35
00:04:01,500 --> 00:04:02,510
...هل يُعقَل

36
00:04:02,740 --> 00:04:06,520
أوغاتا. ما خطب التحكُّم بالجرّ
الخاصّ بـ 86؟

37
00:04:06,520 --> 00:04:08,620
بدا ذلك جنونيّاً. هل أنت متأكّد
بأنّ ذلك سيفلح؟

38
00:04:08,620 --> 00:04:09,730
على العكس

39
00:04:09,730 --> 00:04:12,520
طلب منّي كاناتا إيقافه

40
00:04:13,060 --> 00:04:14,560
ماذا تقول؟

41
00:04:18,690 --> 00:04:20,570
ينحرف هكذا عمداً إذاً؟

42
00:04:21,030 --> 00:04:26,510
هل يحاول فعلاً قطع منطقة الموت؟

43
00:04:28,530 --> 00:04:29,910
انظروا إلى هذا

44
00:04:30,200 --> 00:04:35,210
راية التّنبيه الّتي فقدها 86 عند دخول
!منطقة الموت قد عادت

45
00:04:35,660 --> 00:04:38,390
حصل على راية تنبيه من خلال الانحراف؟

46
00:04:38,390 --> 00:04:42,090
كنتُ أفعل هذا لثلاث سنوات
ولم أتمكّن من فعل هذا أبداً

47
00:04:42,460 --> 00:04:45,550
،بقدر ما قد يكون هذا الانحراف مُخيفاً
لعلّ الأكثر لفتاً للانتباه

48
00:04:45,550 --> 00:04:49,520
هو أنّني لا أتذكّر أحداً حصل على راية تنبيه
داخل منطقة الموت الخاصّة بأشينوكو

49
00:04:49,790 --> 00:04:54,270
منحَ الحاسوب في المقرّ تكتيك
!الانحراف هذا ختم مُوافقته

50
00:04:54,540 --> 00:04:57,310
يتلاعب بوزن السيّارة ويحرف الخلفيّة

51
00:04:57,310 --> 00:05:01,360
من أجل رسم أي مسار يريده
باستخدام أدنى زاوية توجيه

52
00:05:02,040 --> 00:05:07,070
هذا هو الانعطاف التّوجيهيّ الصّفريّ
الخاصّ بوفجيوارا تاكومي بلا شكّ

53
00:05:07,420 --> 00:05:12,680
"وكأنّ نجم المُنحدرات الّذي لا يُقهَر من "بروجيكت د
قد ظهر في مسار أشينوكو

54
00:05:13,840 --> 00:05:19,300
كي يدخل الزّاوية بميلانٍ كافٍ لتجنُّب
...أي حالة توجيه ناقص

55
00:05:19,300 --> 00:05:26,260
ويستطيع سلوك مثل هذا المسار الشّديد لأنّه
متأكّد تماماً بأنّه لن يوجّه السيّارة توجيهاً مُفرِطاً؟

56
00:05:26,560 --> 00:05:29,470
لكن لا يستوعب عقلي فحسب بأنّ هذه
الطّريقة أسرع في واقع الأمر

57
00:05:29,470 --> 00:05:32,060
لا، إنّها كذلك حتماً. انظر يا شون

58
00:05:35,060 --> 00:05:39,480
ولمرّة ثانية، يحقّق مكاسبَ
!ضخمة في منطقة الموت

59
00:05:39,480 --> 00:05:43,940
!صعد إلى المركز العاشر
!لا تمزح مع كاتاغيري كاناتا

60
00:05:43,940 --> 00:05:47,610
الحصّاد الأبيض الّذي هو مصدر تعاسة
،كلّ سائق في م.ف.ج

61
00:05:47,850 --> 00:05:53,220
يبتسم ابتسامة ملائكيّة لهذا
!الشّاب لسببٍ ما

62
00:05:54,390 --> 00:05:56,170
بدأتُ أتأقلم مع القبضة

63
00:05:56,820 --> 00:05:58,880
سأخرج من منطقة الموت قريباً

64
00:06:01,960 --> 00:06:05,500
!تخرج 86 من فخّ الانزلاق

65
00:06:05,500 --> 00:06:09,930
ومع استعادة إطاراتها ثباتها، تبلغ شيئاً
فشيئاً مُعدّل السّرعة من جديد

66
00:06:14,460 --> 00:06:18,440
إنّه الآن في قسم انحداريّ من تقاطُع
معبر كوجيري المؤدّي إلى بوّابة السدّ

67
00:06:18,440 --> 00:06:22,980
!و 86 تتحرّك بسرعة كما تفعل سمكة في الماء

68
00:06:24,400 --> 00:06:26,610
رقم فرديّ؟ أيُعقَل هذا؟

69
00:06:27,020 --> 00:06:30,780
هل سأُهزَم بواسطة كاناتا
في سِباقه المجنون الثّاني؟

70
00:06:31,180 --> 00:06:34,950
ارتقت السيّارة 86 من المركز 16
!في الافتتاحية إلى مركز تأهيليّ

71
00:06:34,950 --> 00:06:37,210
المركز التّاسع؟ معقول؟

72
00:06:37,210 --> 00:06:41,580
أن يؤدّي هذا الأداء ضدّ أفضل
...المُتسابقين في الإلَهيّين الخمسة عشر

73
00:06:41,580 --> 00:06:43,920
هذا غير منطقيّ فحسب

74
00:06:44,230 --> 00:06:48,400
يدور عبر مُنعطَف ميناء كوجيري الحادّ
!محتلّاً المركز التّاسع

75
00:06:48,970 --> 00:06:51,260
!هذا لا يُصدَّق بالفعل

76
00:06:51,260 --> 00:06:56,350
،رغم أنّها خضعتْ لتحديثات بلا شكّ
إلّا أنّ 86 ما زالت تمتلك مُحرّك تنفُّس طبيعيّ سِعة 2 لتر

77
00:06:56,350 --> 00:06:58,550
فكيف يُحقِّق هذا الرّتم؟

78
00:06:59,120 --> 00:07:02,500
ماذا يقصد بـ"تنفُّس طبيعيّ سِعة 2 لتر" يا أبي؟

79
00:07:03,040 --> 00:07:05,400
...في الواقع

80
00:07:05,400 --> 00:07:09,320
هو مُحرّك يُنتِج انزياحاً قدره 2000 سنتيمتر مُكعب

81
00:07:09,320 --> 00:07:12,030
اختصارها ت.ط

82
00:07:12,240 --> 00:07:15,180
ما يعني بأنّه من دون شاحن طوربينيّ

83
00:07:15,180 --> 00:07:17,200
ما الفرق الّذي يُحدِثه "الطّوربين"؟

84
00:07:17,530 --> 00:07:22,420
جوهريّاً يمنحك من اثنين إلى ثلاثة أضعاف
مقدار قوّة الانزياح

85
00:07:23,080 --> 00:07:28,050
تقصد بأنّ سيّارة كاناتا أضعف
بكثير من حيث القوّة؟

86
00:07:28,050 --> 00:07:30,300
أجل، تقريباً

87
00:07:30,600 --> 00:07:33,240
كيف يصعد سلّم التّرتيب بهذه السّرعة إذاً؟

88
00:07:33,860 --> 00:07:36,890
هل يستخدم سحر هاري بوتر أو ما شابه؟

89
00:07:40,640 --> 00:07:43,440
هذه طريقة سيّئة للتّعبير عن الأمر

90
00:07:53,050 --> 00:07:57,960
تقطع 86 وبشكلٍ إيقاعيّ الغابة
في السّاحل الشّرقيّ لأشينوكو

91
00:07:58,250 --> 00:08:01,610
يتطلّب هذا القسم تحريك المِقوَد
،يُمنة ويُسرة مع الحفاظ على التّوازن

92
00:08:01,610 --> 00:08:04,430
وبالتّالي دقّة في التّعامل
مع الدوّاسة من أجل العبور

93
00:08:05,090 --> 00:08:06,890
وها هو يُحافظ على ثباته

94
00:08:06,890 --> 00:08:10,160
لكن إلى أي حدٍّ آمن هو الهامش
،الّذي شكّلتْه 86 في منطقة الموت

95
00:08:10,160 --> 00:08:12,010
نظراً إلى ضعف قوّتها؟

96
00:08:12,010 --> 00:08:15,720
!يستمرّ سحر كاتاغيري كاناتا

97
00:08:16,510 --> 00:08:19,520
ما زال لم يبذل كلّ ما عنده بعد

98
00:08:20,030 --> 00:08:23,010
،مضامير م.ف.ج كلّها مُميّزة

99
00:08:23,010 --> 00:08:26,480
ممّا يفرض طلبات مختلفة
على عازل الصّدمة في كلّ مُناسبة

100
00:08:27,210 --> 00:08:32,050
سخّرتُ كلّ خبرتي الفنّية الّتي اكتسبتُها
خلال مسيرتي لدوزنة الهيكل السّفليّ لـ 86

101
00:08:32,050 --> 00:08:35,240
يمكن أن نُطلِق على هذا بعُرف
من أعراف أشينوكو

102
00:08:35,710 --> 00:08:41,750
الفُرصة لزلزلة م.ف.ج، الّذي بُني
...على رُكام شارع غونما القديم

103
00:08:41,970 --> 00:08:46,790
هل يتمنّى مُتسابِق كاناغاوا قديم
ما هو أفضل من ذلك؟

104
00:08:55,480 --> 00:08:57,680
أعتقد بأنّ إحدى ميزات كاناتا

105
00:08:57,680 --> 00:09:01,980
هي الانعطاف عبر أكبر عدد ممكن
من المسارات الجانبيّة المُتتاليّة

106
00:09:03,190 --> 00:09:05,980
هذا مختلف عن الخطوط الّتي تكون على شكل
حرف "في" الّتي نستخدمها بقيّتنا

107
00:09:06,500 --> 00:09:09,150
يستخدم إطاراته بصورة مختلفة تماماً

108
00:09:09,660 --> 00:09:14,990
والتّغيّرات الّتي طرأت على عازل الصّدمة
الخاصّ بـ 86 تلائم أسلوبه بمثاليّة

109
00:09:15,240 --> 00:09:19,450
كان ذلك بلمسات ساحر عازل
الصّدمات بذاته، أوكوياما هيرويا

110
00:09:19,450 --> 00:09:22,410
هل يمكنها حقّاً تحقيق نتائج كهذه؟

111
00:09:22,410 --> 00:09:25,930
تغادر 86 القِطاع 2 وتدخل القِطاع 3

112
00:09:25,930 --> 00:09:28,940
لا يوجد سوى منحدر سفليّ
من هنا إلى ضفّة البُحيرة

113
00:09:36,160 --> 00:09:38,100
!وهو الآن في المركز السّابع

114
00:09:38,100 --> 00:09:41,210
إلى أي نقطة يستطيع أن يصعد
في سلّم ترتيب المُتسابقين؟

115
00:09:41,210 --> 00:09:45,020
أشعر وكأنّ راية التّنبيه كانت مع كاتاغيري كاناتا

116
00:09:45,020 --> 00:09:48,150
فترة أطول من حامل الرّقم القياسيّ
!في مضمار، ساواتاري كوكي

117
00:09:48,600 --> 00:09:53,820
تُوضَع راية التّنبيه على السّائقين الجيّدين
بواسطة كمبيوتر، صحيح يا أبي؟

118
00:09:53,820 --> 00:09:54,980
هذا صحيح

119
00:09:54,980 --> 00:09:56,770
لكن هل هذا منطقيّ؟

120
00:09:56,770 --> 00:10:02,830
يتكلّم المُعلِّق وكأنّ كاناتا يُبلي بلاء أفضل في المركز
السّابق من المُتسابق في المركز الأوّل

121
00:10:03,250 --> 00:10:05,790
...في الواقع، بخصوص هذا الأمر

122
00:10:06,230 --> 00:10:12,070
نِظام الكمبيوتر مُصمّم ليُطلِق حكماً
مُستنِداً على التّقنيّة بشكلٍ صرف

123
00:10:12,380 --> 00:10:16,090
لذا ليس بالضّرورة أن يُوافق
دوماً ما ورد في ساعة التّوقيت

124
00:10:16,470 --> 00:10:19,570
في السّباق، حتّى أكثر سائق
موهوب في العالم لا يكفي

125
00:10:19,570 --> 00:10:21,310
ليُنافس من تلقاء نفسه

126
00:10:21,740 --> 00:10:27,590
تقنيّة السّائق ونقاط قوّة السيّارة يجب
أن تؤخذا بعين الاعتبار من أجل الفوز

127
00:10:27,590 --> 00:10:28,600
هل فهمتِ؟

128
00:10:29,120 --> 00:10:31,330
أظنّني فهمت، أجل

129
00:10:31,920 --> 00:10:36,110
لكن هذا ليس عدلاً. أشفق على كاناتا

130
00:10:36,840 --> 00:10:39,280
،تنطلِق بأقصى سرعة عبر الشّارع المستقيم

131
00:10:39,280 --> 00:10:43,930
ثمّ يتبقّى صعود تلّة طولها 2 كم
!للوصول إلى خطّ النّهاية

132
00:10:43,930 --> 00:10:46,180
،بالنّظر إلى قلّة حيلتها

133
00:10:46,180 --> 00:10:49,170
قد يكون هذا الاختبار الأقسى
بالنّسبة لتويوتا 86

134
00:10:56,030 --> 00:11:00,720
هذا هو الصُّعود الأقسى والأطول
في مضمار أشينوكو

135
00:11:01,190 --> 00:11:04,600
إنّه سيّئ بالنّسبة لكاناتا و 86

136
00:11:04,830 --> 00:11:08,640
حقيقة قربه من خطّ النّهاية تزيد الأمر سوءاً

137
00:11:09,090 --> 00:11:14,190
أثناء السِّباق الفعليّ، سيكون في وضع
حرِج في أيّ معركة نحو الخطّ

138
00:11:21,340 --> 00:11:22,520
!تراجع مركزاً

139
00:11:22,520 --> 00:11:26,450
،مهما كان ممتازاً في الزّوايا
لا يسعه فعل شيء هنا

140
00:11:26,910 --> 00:11:28,680
،من كلّ النّواحي الفنّية

141
00:11:28,680 --> 00:11:32,420
يستطيع مُجاراة أو حتّى التفوُّق
على باقي الإلَهيّين الخمسة عشر

142
00:11:32,840 --> 00:11:36,950
لكن هنا، السيّارات ذات القوّة الحصانيّة
الأكبر ستجعله يتراجع للخلف

143
00:11:37,580 --> 00:11:40,550
تماسك يا كاناتا! يجب أن تصمد
!في المركز الثّامن

144
00:11:40,550 --> 00:11:42,580
!شارفت على بلوغ خطّ النّهاية

145
00:11:48,720 --> 00:11:50,130
شبح م.ف

146
00:11:54,800 --> 00:11:56,260
شبح م.ف

147
00:11:59,840 --> 00:12:03,320
تستهلك 86 آخر ما تبقّى من تسارعها
!بينما تتقدّم للأمام

148
00:12:03,320 --> 00:12:05,140
!خطّ النّهاية ضمن المرأى

149
00:12:07,920 --> 00:12:11,870
!المركز الثّامن! يُنجز المضمار بمركز ثامن واعد

150
00:12:11,870 --> 00:12:18,340
وبهذا، لا تغدو قدرة كاتاغيري كاناتا
!في القيادة موضع شكّ أحد

151
00:12:18,700 --> 00:12:22,380
يبقى المركز الثّامن مُبهِراً، صحيح؟

152
00:12:31,310 --> 00:12:34,560
!أنت غير معقول

153
00:12:35,250 --> 00:12:37,140
كان ذلك رائعاً يا رجُل

154
00:12:37,470 --> 00:12:39,780
أين تعلّمت الانزلاق الانعطافيّ بهذا الشّكل؟

155
00:12:40,130 --> 00:12:43,190
علّمني مُعلّمي في الأكاديميّة

156
00:12:43,960 --> 00:12:48,840
.كان خبيراً في الانزلاق الانعطافيّ
كانت تقنيّته هائلة بصراحة

157
00:12:49,400 --> 00:12:53,420
ما يمكنني فعله هو مجرّد هزل مُقارنة به

158
00:12:53,420 --> 00:12:57,250
يُعلّمون الانزلاق الانعطافي
في مدارس السّباق خارج البلاد؟

159
00:12:57,250 --> 00:13:00,500
لا. لم يكن ذلك جزءاً من المنهاج النّظاميّ

160
00:13:00,820 --> 00:13:03,430
كانت تُعطى دروس خاصّة بعد الدّوام

161
00:13:04,170 --> 00:13:07,430
كان يأخذني إلى مضامير السّباق
في أيّام عطلة الأسبوع

162
00:13:07,670 --> 00:13:10,120
،بسيّارات ذوات عازل صدمات خفيف

163
00:13:10,120 --> 00:13:14,640
وذلك كي أعتاد على تحويل الوزن
في الطّرُقات ذات درجة احتكاك مُنخفضة

164
00:13:15,420 --> 00:13:21,490
.أحياناً، كنتُ أجلس في مقعد الرُّكّاب
وأحياناً هو من يفعل ويسدي إليّ بالنّصائح

165
00:13:22,290 --> 00:13:25,320
كنّا نقود السيّارة ونتجوّل بها
عندما لا تكون هناك دروس

166
00:13:25,980 --> 00:13:31,290
أعتقد لهذا السّبب لا أتكبّد عناء كبيراً
مع مضامير الشّارع الخاصّة بـ م.ف.ج

167
00:13:32,310 --> 00:13:37,260
كنّا نجلس في حقل لتناول الغداء
ونضحك على أمور تافهة

168
00:13:37,260 --> 00:13:39,220
كان ذلك مُمتعاً للغاية

169
00:13:40,510 --> 00:13:44,070
لم يكن هناك الكثير من اليابانيّين
،المُجنّسين في الأكاديميّة

170
00:13:44,070 --> 00:13:49,180
وأعتقد بأنّ لغتي اليابانيّة المُتقطِّعة
قد لفتت انتباهه

171
00:13:49,920 --> 00:13:56,620
،لم أعرف أبي أبداً، وفي بعض الأوقات
كنتُ أشعر وكأنّ مُعلّمي هو أبي

172
00:13:57,310 --> 00:13:58,690
هكذا إذاً

173
00:13:58,690 --> 00:14:00,740
هذا يجعل الدّمعة تغرغر في عيني

174
00:14:06,240 --> 00:14:11,910
لدى هذه السيّارة قوّة كافية للتفوُّق
على كلّ مركبة في هذا الحدث

175
00:14:11,910 --> 00:14:14,330
هذا ليس موضِع خِلاف

176
00:14:14,970 --> 00:14:18,910
وأعي تماماً بأنّه لا يمكن قول
نفس الكلام عنّي شخصيّاً

177
00:14:19,500 --> 00:14:25,650
لكن بينما تفقد أشياء معيّنة مع التقدُّم
في السنّ، تكسب أشياء أخرى

178
00:14:25,650 --> 00:14:28,950
هذه الأشياء الأخرى هي الّتي
يجب أن أستخدمها للقتال

179
00:14:29,680 --> 00:14:31,850
سِباق السيّارات هو مجموع كلّ شيء

180
00:14:31,850 --> 00:14:35,060
ولو أطبقت السّماء على الأرض لن أدع
!أطفالاً بكّائين يسخرون منّي

181
00:14:41,350 --> 00:14:46,610
حسناً، نحن على يقين الآن بأنّ كاناتا
مُؤهّل للسّباق الآن

182
00:14:47,300 --> 00:14:49,780
ما رأيكما أن نحتفل؟ على حسابي

183
00:14:50,100 --> 00:14:52,080
لا بدّ أنّكما جائعان

184
00:14:52,410 --> 00:14:54,790
ممتاز! المزيد من اللّحم العضويّ؟

185
00:14:54,790 --> 00:14:59,140
تحبّ الأحشاء حقّاً، أليس كذلك؟ اتبعني

186
00:15:05,500 --> 00:15:07,630
تفضّل. وجبة تيندون

187
00:15:07,630 --> 00:15:10,820
!ممتاز! تيمبورا يابانيّة

188
00:15:10,820 --> 00:15:15,060
هذا المطعم شهير. الجميع في أوداوارا يعرفونه

189
00:15:15,780 --> 00:15:18,270
جرّب آجي سوشي أيضاً. إنّه لذيذ

190
00:15:18,620 --> 00:15:23,960
أعتقد بأنّ اليابان تمتلك أكبر تشكيلة متنوِّعة
من الطّعام البحريّ في أيّ بلد في العالم

191
00:15:23,960 --> 00:15:27,950
هذا منطقيّ نظراً إلى أنّها جزيرة
مُحاطة ببحر من كلّ الجهات

192
00:15:27,950 --> 00:15:30,490
...تشترك في ذلك مع إنجلترا، لكن

193
00:15:30,730 --> 00:15:34,200
من حيث المقياس، ثقافتنا فيما يتعلّق
بالطّعام البحريّ لا تُقارَن ببساطة

194
00:15:39,460 --> 00:15:43,720
!طبق تيمبورا هذا مُبهر! لامسَ شيئاً في داخلي

195
00:15:44,620 --> 00:15:49,560
يروقني كيف أنّ كافّة أطباق الإناء
خاصّتكم تنتهي بـ"دون" مثل تيندون وغيودون

196
00:15:49,560 --> 00:15:54,170
تعيش بالقرب من إينوشيما، أليس كذلك؟
يجب أن تجرّب شيراسودون

197
00:15:54,560 --> 00:15:57,140
ستُصدَم من مدى جودته بالرّغم من بساطته

198
00:15:57,860 --> 00:15:59,830
شيراسودون؟

199
00:16:07,980 --> 00:16:08,940
المركز التّاسع

200
00:16:09,440 --> 00:16:12,310
لكن سيكون كاناتا بخير غالباً

201
00:16:16,800 --> 00:16:17,790
كاناتا

202
00:16:18,190 --> 00:16:19,970
كم ستتأخّر في العمل اليوم؟

203
00:16:20,380 --> 00:16:23,030
لديّ مُناوبة مُبكِّرة، لذا حتّى الثّالثة فقط

204
00:16:23,030 --> 00:16:28,050
.هذا يتزامن إذاً مع توجُّهي إلى كاماكورا
لنلتقِ ونجرِ بحثاً

205
00:16:28,050 --> 00:16:29,380
حسناً

206
00:16:31,340 --> 00:16:34,070
أرغب في الذّهاب لتجربة شيراسودون أيضاً

207
00:16:34,070 --> 00:16:35,800
هل يمكنكِ الانضمام لي يا رين؟

208
00:16:35,800 --> 00:16:41,050
أكيد! سأبلغ أمّي بأنّنا سنأكل في الخارج

209
00:16:41,050 --> 00:16:43,950
شكراً لكِ يا رين. أتطلّع قُدماً لذلك

210
00:16:45,150 --> 00:16:46,650
أنا أيضاً

211
00:16:47,200 --> 00:16:48,910
!أمّنتُ مُواعدة مع كاناتا

212
00:16:55,530 --> 00:16:57,830
إنّه اليوم الأخير من المرحلة التأهيليّة
لبُحيرة أشينوكو جي.تي

213
00:16:57,830 --> 00:17:00,760
وحان الوقت لإقلاع السّائق القمّة

214
00:17:01,840 --> 00:17:03,830
لنُراقب جميعنا هذا المُتسابِق

215
00:17:09,050 --> 00:17:14,160
الرّجل الّذي قيل بأنّه الأسرع في تاريخ
م.ف.ج، مايكل بيكنباور، ينطلق

216
00:17:20,620 --> 00:17:22,940
تنطلق 12 كالبرق عبر منطِقة الموت

217
00:17:22,940 --> 00:17:26,240
إنّه على بُعد مسافة عشرَين
،عن المركز الأوّل ساواتاري كوكي

218
00:17:26,240 --> 00:17:28,440
!ما يجعله في المركز الثّاني مؤقّتاً

219
00:17:28,730 --> 00:17:34,150
سمعتُ النّاس يتحدّثون بحماس عن المجنون
الّذي ينزلق عبر كلّ انعطاف

220
00:17:35,120 --> 00:17:38,910
لكن ضدّ عازل الصّدمات المُصنَّع بواسطة
،فاحصي المركبات الموهوبين في بورش

221
00:17:38,910 --> 00:17:41,120
!ستذهب جهوده أدراج الرّياح

222
00:17:42,540 --> 00:17:45,080
تسير السيّارة 12 بخُطى أنيقة

223
00:17:45,080 --> 00:17:49,670
!لا ذرّة اضطراب! لا شيء سوى السّرعة الملساء

224
00:17:50,590 --> 00:17:52,330
ومع ذلك، يبدو هذا غريباً

225
00:17:52,330 --> 00:17:55,650
الوتيرة الّتي يسير عليها... ما الّذي
نشهده هنا يا جماعة؟

226
00:17:55,650 --> 00:17:58,460
يبدو أنّه يتعمّد الحِفاظ على وتيرة

227
00:17:58,460 --> 00:18:01,510
تُبقيه على بُعد مسافة عشرَين
خلف صاحب الرّقم القياسيّ في مضمار

228
00:18:01,510 --> 00:18:04,980
هل هذه صدفة أم استعراض؟

229
00:18:05,380 --> 00:18:09,650
ما هذا الشّعور الغريب الّذي يراودني؟

230
00:18:10,790 --> 00:18:14,610
هذا مُدهش يا مايكل. يسير
الأمر كما قلتَ تماماً

231
00:18:14,610 --> 00:18:18,450
كنتَ على بُعد عشرَين عنه
في نقطة العبور السّابقة

232
00:18:18,850 --> 00:18:22,630
يبدو وكأنّك خلف السيّارة 4 مباشرة

233
00:18:23,090 --> 00:18:27,000
،هذا لأنّني كذلك. قد لا يكون هنا فعلياً

234
00:18:27,000 --> 00:18:29,750
لكن يمكنني رؤية مؤخّرة السيّارة 4

235
00:18:30,290 --> 00:18:32,300
أستخدمه كمُنظِّم سرعة بالنّسبة لي

236
00:18:33,070 --> 00:18:37,720
سأدّخر السّرعة العُليا للصّعود
في مسافة 2 كم الأخيرة

237
00:18:38,210 --> 00:18:41,760
سأتروّى إلى ذلك الحين. لا حاجة
لبذل جهد أكبر

238
00:18:42,690 --> 00:18:45,680
رغم ذلك، لا أنوي السّماح لأحد آخر
انتهاز وقت الذّروة

239
00:18:45,970 --> 00:18:49,890
تلك كانت القاعدة الوحيدة الّتي وضعتُها لنفسي

240
00:18:50,960 --> 00:18:54,150
يمكنني تقريباً رؤية الشّرارات تتطاير بينهما

241
00:18:54,150 --> 00:18:56,290
إنّه صِراع حقيقيّ بين الأنا هناك

242
00:18:56,290 --> 00:19:00,450
لم أتوقّع أن نشهد صِراعاً على الصّدارة
بين كايمان وآلبين

243
00:19:00,450 --> 00:19:05,420
أجل. الوضع القائم من أيّام "قانون
الرّجل الثّريّ" ينهار

244
00:19:06,200 --> 00:19:08,330
!من القِطاع 1 إلى القِطاع 2

245
00:19:08,330 --> 00:19:11,790
إنّه الآن خلف 4 بمسافة ثلاثة أعشار

246
00:19:11,790 --> 00:19:14,920
!يستمرّ صِراع الرّأس بالذّيل

247
00:19:15,630 --> 00:19:19,760
تِلك هي خطّته إذاً؟ ليست جريئة تماماً

248
00:19:20,010 --> 00:19:23,320
لا مُشكلة على ما أعتقد. يستطيع
الحصول على الصّدارة

249
00:19:23,320 --> 00:19:27,750
لكن أتطلّع قُدماً لتمريغ أنفه المُتعجرف
في التُّراب في السّباق

250
00:19:28,180 --> 00:19:30,800
لستُ خائفاً من بيكنباور

251
00:19:30,800 --> 00:19:34,210
إنّه مجرّد مُتنوِّع المواهب، وهذا
كلّ ما سيكون عليه دوماً

252
00:19:39,360 --> 00:19:44,030
!ما زالت فجوة الثّلاثة أعشار سليمة
!تصيبني قشعريرة في هذه اللّحظة يا ناس

253
00:19:44,030 --> 00:19:48,030
!نشهد عِراكاً شبحيّاً بين السيّارتين 4 و 12

254
00:19:48,030 --> 00:19:52,280
لا بدّ أن أُقرّ، كاناتا ريفينغتون أكثر رُعباً بكثير

255
00:19:52,690 --> 00:19:54,610
ذلك الشّاب لا يعرف حدوداً

256
00:19:55,750 --> 00:20:00,480
إنّه يقود بمُحرّك ت.ط 2 لتر
ونِظام ثلاثي الدّواسات عتيق الطّراز

257
00:20:00,860 --> 00:20:02,880
ويحتلّ المركز الثّامن بسيّارة كتلك؟

258
00:20:02,880 --> 00:20:05,770
كيف لم يلحظ أحدٌ غيري جنونَ ذلك؟

259
00:20:05,770 --> 00:20:08,350
آسفة! هل انتظرتَ طويلاً يا كو-كن؟

260
00:20:08,590 --> 00:20:11,420
حاولتُ أن أستعجل، لكن لم يفلح ذلك

261
00:20:12,890 --> 00:20:15,230
!والآن الطّريق المستقيم

262
00:20:15,230 --> 00:20:23,530
مُحرّكها بسعة 2.5 لتر فقط، لكن نِظام نقل الحركة ثنائي القابض
بسرعة 7 خاصّتها يمنحها سرعة قصوى مُلفِتة

263
00:20:25,670 --> 00:20:28,410
تزدحم شيبويا في أيّام الأحد

264
00:20:28,750 --> 00:20:29,770
إلى أين ينبغي أن نذهب؟

265
00:20:29,770 --> 00:20:33,420
أليس هذا واضحاً؟ يمكن تأجيل
الغداء والكاراوكي

266
00:20:34,670 --> 00:20:39,180
توقّعتُ هذا. لهذا ارتديتُ زيّاً تحتيّاً ظريفاً

267
00:20:40,110 --> 00:20:42,610
!الكيلومتران الأخيران هما صعود تلّة

268
00:20:42,610 --> 00:20:45,890
الانزياح المُتفوِّق الخاصّ بكايمان
!يمنحها أفضليّة واضحة

269
00:20:53,520 --> 00:20:55,480
!وها هي راية التّنبيه

270
00:20:55,480 --> 00:20:59,440
!الفجوة بينه وبين السيّارة 4 تتقلّص إلى العدم

271
00:20:59,700 --> 00:21:02,530
وداعاً يا ساواتاري. سأسبقك

272
00:21:03,340 --> 00:21:05,410
!ها هو ذا

273
00:21:05,410 --> 00:21:10,220
!لأوّل مرّة في سباقه، يسبق السيّارة 4

274
00:21:10,220 --> 00:21:15,290
يتغلّب عليه أخيراً! يتقدّم بيكنباور
!إلى المركز الأوّل مؤقّتاً

275
00:21:16,040 --> 00:21:20,460
!وبهذا الشّكل، يصبح مُتقدّماً عن خصمه بفارق ثانية

276
00:21:20,460 --> 00:21:26,130
لم يكن ذلك موضِع شكّ! هذا السّايبورغ
!ألمانيّ الصّنع أثبت شجاعته

277
00:21:27,790 --> 00:21:30,810
يتولّى مايكل بيكنباور الصّدارة بثِقة

278
00:21:30,810 --> 00:21:36,400
لكن كان ساواتاري كوكي في المركز الثّاني
!قد سجّل رقماً قياسيّاً جديداً مذهلاً في مضمار

279
00:21:36,790 --> 00:21:42,280
ووسط صِراع الجبابرة هذا لدينا
كاتاغيري كاناتا الّذي احتلّ المركز 10

280
00:21:42,620 --> 00:21:48,310
"هذه الفئة الجديدة من "نجوم السّرعة
!تسعى لزعزعة التّسلسل التّراتبيّ في م.ف.ج

281
00:21:48,310 --> 00:21:53,090
تشتعل الأجواء حماساً بينما تتّجه
!نحو سِباق بُحيرة أشينوكو جي.تي

282
00:23:31,720 --> 00:23:36,600
الحلقة القادمة، 14: الهجوم 4 في 4