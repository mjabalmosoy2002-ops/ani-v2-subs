1
00:00:01,050 --> 00:00:04,140
،عندما أحرِّك مُبدِّل السّرعة للأمام
فلا مُشكلة

2
00:00:04,140 --> 00:00:07,760
غالباً لأنّني أستخدم كتِفي، لا مِرفقي

3
00:00:07,760 --> 00:00:11,860
،لكن عندما أحاول سحبها للخلف
الألم أكبر من أن يُحتمَل

4
00:00:13,510 --> 00:00:16,740
هذا سيجعل التّبديل من الأوّل إلى الثّاني
والثّاني إلى الثّالث صعباً

5
00:00:17,260 --> 00:00:21,290
قد أضطرّ للانتقال مباشرة من الغيار
الأوّل إلى الثّالث مباشرة

6
00:00:21,790 --> 00:00:23,910
ماذا عن الثّالث إلى الرّابع؟

7
00:00:24,220 --> 00:00:28,910
هذا يؤلم قليلاً، لكن بما أنّها حركة
سحب بسيطة، فيمكنني تحمّلها

8
00:00:28,910 --> 00:00:30,790
ماذا عن التّوجيه؟

9
00:00:31,200 --> 00:00:32,380
لا مشاكل في ذلك

10
00:00:33,030 --> 00:00:37,600
بما أنّ ذراعي اليمنى تفيدني، هناك
عبء أخفّ على المِرفق الأيسر

11
00:00:37,940 --> 00:00:43,060
في الحقيقة يا كاناتا، لمُجاراة مُبدِّلي
،الغيار بالنّمط أتش الخاصّ بـ 86

12
00:00:43,060 --> 00:00:46,560
تحتاج لقدرة إلَهيّة للتّبديل سريعاً

13
00:00:46,830 --> 00:00:52,370
إذا لم تستطع فعل ذلك أو حتّى استخدام
الغيار الثّاني، فلا تملك فُرصة

14
00:00:53,030 --> 00:00:55,260
أوكوياما-سان، لنسحب السيّارة

15
00:00:55,710 --> 00:00:58,920
،إذا ازدادت سوء حالة مِرفقه
فستكون المُشكلة أكبر

16
00:00:58,920 --> 00:01:01,840
لسنا نحن من نُقرّر ذلك

17
00:01:03,210 --> 00:01:05,420
أيّاً ما نقوله لا يهمّ في النّهاية

18
00:01:05,840 --> 00:01:09,620
إنّه الوحيد الّذي يعلم كم هذا مؤلم

19
00:01:10,090 --> 00:01:12,820
لهذا القرار هو قرارك

20
00:01:13,230 --> 00:01:16,550
سنلتزم بما تقوله بكلّ سرور

21
00:01:16,820 --> 00:01:20,280
سيّد أوكوياما، من المُطمئن سماع ذلك

22
00:01:20,770 --> 00:01:25,520
أنا حقّاً لا أعلم ما طبيعة الأداء الّذي يمكنني
تقديمه ما لم أبدأ في السّباق

23
00:01:26,200 --> 00:01:29,300
أردتُ السّباق مهما كلّف الأمر

24
00:01:30,900 --> 00:01:35,350
،حالما أكون في نقطة انطلاق السّباق
،فلا يهمّ من يتجاوزني أو كم يؤلمني ذلك

25
00:01:35,350 --> 00:01:37,770
أنوي إكمال السّباق حتّى النّهاية

26
00:03:10,130 --> 00:03:13,730
بقي أقلّ من خمس دقائق الآن
حتّى وقت البدء المُقرَّر

27
00:03:13,730 --> 00:03:17,390
،ورغم أنّ ذلك يحدث في كلّ مرّة
مزيج القلق والتأمُّل

28
00:03:17,390 --> 00:03:19,720
قبل العدّ التّنازليّ مُثير

29
00:03:20,530 --> 00:03:22,880
اليوم هو الحدث الكبير يا آكياما-سان

30
00:03:22,880 --> 00:03:25,960
ما الّذي ينبغي أن ننتبه له برأيك
في سباق اليوم؟

31
00:03:25,960 --> 00:03:27,640
...لنرَ

32
00:03:27,960 --> 00:03:31,810
أنا شخصيّاً يراودني فضول بشأن أداء صاعدَين لدينا

33
00:03:32,380 --> 00:03:37,350
أشعر بإمكانيّة غير مُتوقَّعة من موروبوشي-كن
الّذي سيبدأ في المركز الثّامن

34
00:03:37,670 --> 00:03:42,770
ثمّ هناك كاتاغيري كاناتا الّذي سيبدأ في المركز
الثّالث. هذان هما من سأراقبهما

35
00:03:43,350 --> 00:03:45,980
إذا تأزّم الأمر كثيراً، فيمكنك الانسحاب يا كاناتا

36
00:03:46,460 --> 00:03:50,620
يتطلّب الانسحاب من سِباق شجاعة أيضاً

37
00:03:51,300 --> 00:03:53,750
وثمّة أمر آخر: لا يمكنك فعل ذلك

38
00:03:54,210 --> 00:03:57,350
وجود تميمتين في السيّارة مُحرّم في اليابان

39
00:03:57,820 --> 00:04:00,210
فأنت لا تريد أن يتشاجر إلَهان، صحيح؟

40
00:04:00,510 --> 00:04:02,180
!يا لها من غلطة

41
00:04:03,780 --> 00:04:06,870
هلّا وضعت هذه في حقيبتي إذاً؟

42
00:04:06,870 --> 00:04:08,010
عُلِم

43
00:04:08,320 --> 00:04:12,420
كان مُبهراً في آخر سباقين له

44
00:04:12,760 --> 00:04:18,400
وأشعر بأنّه من النّوع الّذي يُظهِر إمكانيّته الحقيقيّة
في سِباق أكثر ممّا يفعل في مرحلة تصفيات

45
00:04:19,130 --> 00:04:24,510
لديه قوّة ناريّة كافية لتهديد الملك
المُهيمن، بيكنباور

46
00:04:25,190 --> 00:04:31,580
أنا متأكّد بأنّ المُعجبين يتطلّعون قُدماً لفقدان
سفّاح شتوتغارت رباطة جأشه ولو لمرّة

47
00:04:31,840 --> 00:04:37,880
.أؤيّدك بشكل كامل بشأن ذلك
كاتاغيري كاناتا لا يُخيّب الآمال أبداً

48
00:04:38,440 --> 00:04:41,710
...أتفهّم سبب قوله ذلك، لكن

49
00:04:41,710 --> 00:04:44,620
أجل، يؤلمني سماع ذلك في ظلّ هذه الظّروف

50
00:04:45,740 --> 00:04:49,760
آمل أن يحميني إله رين

51
00:04:51,770 --> 00:04:54,850
وهكذا، بقي 15 ثانية على البدء

52
00:04:55,340 --> 00:04:59,020
ما حدث في الأمس كان غلطتي تماماً

53
00:04:59,020 --> 00:05:00,930
أنا آسفة يا كاناتا

54
00:05:01,890 --> 00:05:04,130
لا بدّ أنّك تعتقد بأنّها غلطتي

55
00:05:05,320 --> 00:05:09,240
تخرج السيّارة 12 من البوّابة

56
00:05:09,240 --> 00:05:13,260
أريد أن أعتذر كما ينبغي عندما
ينتهي هذا السّباق

57
00:05:13,730 --> 00:05:16,710
أرجوك لا تكرهني

58
00:05:18,670 --> 00:05:24,910
إذا كرهتني، فسأصبح مجرّد
قطعة قماش مهترئة

59
00:05:26,130 --> 00:05:31,160
الظّلام يبتلع الإلَهيّين الخمسة عشر
واحداً تلو الآخر

60
00:05:31,160 --> 00:05:33,530
...وقادمة من الخلف، السيّارة 7

61
00:05:34,010 --> 00:05:35,980
!عبرت البوّابة

62
00:05:46,000 --> 00:05:48,990
!المجموعة المُتصدِّرة تخرج من النّفق

63
00:05:49,750 --> 00:05:53,870
السيّارة 2 قد تجاوزت 86 لتصعد مركزاً

64
00:05:53,870 --> 00:05:55,830
هل أخطأتَ في تبديل الغيار؟

65
00:05:55,830 --> 00:05:58,960
هل يحدث هذا مع سائق بمستواك؟

66
00:06:00,700 --> 00:06:05,060
والآن، إيشيغامي في السيّارة 1
!يكاد يُلامس السيّارة 86

67
00:06:05,060 --> 00:06:07,220
هل سيتجاوزها؟

68
00:06:09,430 --> 00:06:10,720
!لا، لن يفعل

69
00:06:10,720 --> 00:06:14,100
تدخل السيّارة 86 المُنعطَف
!بسرعة فائقة جدّاً

70
00:06:14,600 --> 00:06:19,520
نشهد عِراكاً حامياً من الآن في القسم
الأبيض والأسود في بداية هذا السّباق

71
00:06:20,140 --> 00:06:26,940
عندما تُحدّد سرعتك في الغيار الأوّل قبل الانتقال مباشرة
إلى الثّالث، ينخفض التاكوميتر إلى 3000 دورة

72
00:06:26,940 --> 00:06:30,410
،لكن إذا لم تتجاوز الـ 4500 دورة
فإنّ تسارعك سيُعاني

73
00:06:31,220 --> 00:06:34,370
فستكون لقمة سائغة لأسطول السيّارات المُتوحّشة

74
00:06:34,790 --> 00:06:37,330
هذا ما يحدث عندما لا تستطيع
استخدام الغيار الثّاني

75
00:06:37,840 --> 00:06:40,960
يتمّ تجاوزك كما لو أنّ حركتك ثابتة

76
00:06:40,960 --> 00:06:42,670
سيكون هذا صعباً

77
00:06:48,800 --> 00:06:53,230
تحاول 1 التّجاوز مرّة أخرى في طريق
مُنتصف اللّيل المستقيم

78
00:06:53,760 --> 00:06:57,220
مُحرّك الستّ أسطوانات ذو القوّة الحصانيّة
!خمسمئة يفرض نفسه

79
00:06:57,490 --> 00:07:03,150
السيّارتان في الرّابع والخامس تتبادلان
المواقع مع تجاوز السيّارة 1 للسيّارة 86

80
00:07:08,820 --> 00:07:13,700
مُذهل! لكن السيّارة 86 تشنّ هجوماً
!مُضادّاً بفرملة متأخّرة

81
00:07:13,700 --> 00:07:17,710
هذا هُراء. أوروجيه قادم. هل يحاول الانتحار؟

82
00:07:22,210 --> 00:07:27,670
تستعيد 86 ثباتها الّذي فقدته. هذا جنونيّ

83
00:07:28,040 --> 00:07:30,630
كاتاغيري كاناتا مُبهر بحقّ

84
00:07:30,630 --> 00:07:34,490
يمكن رؤية استماتته على عدم التخلّي
عن مركز بلا مُقاومة بوضوح

85
00:07:34,990 --> 00:07:37,380
أعشق هذا النّوع من المواقف

86
00:07:37,850 --> 00:07:45,220
أخيراً نشهد عِراكاً بين 86 وبطل العام الماضي

87
00:07:45,220 --> 00:07:48,480
تبدو هذه المعركة بصراحة وكأنّها
،ترمز إلى شيء

88
00:07:48,480 --> 00:07:52,450
نظراً إلى أنّ الموسم حتّى الآن كان كلّه
يتمحور حول ظهور مُتحدّيين جدُد

89
00:07:53,090 --> 00:07:56,870
تندفع المجموعة المُتصدِّرة عبر التعرُّج الحادّ

90
00:07:57,490 --> 00:08:01,350
يغادرون الطّريقَ العامّ ويدخلون النّصف
الأوّل من الطّريق الداخليّ

91
00:08:03,720 --> 00:08:08,760
مُذهل! تلتفّ السيّارة 1 من حول
السيّارة 86 وتبتعد

92
00:08:09,300 --> 00:08:11,720
أهذا هو سباق مانازورو حقّاً؟

93
00:08:11,720 --> 00:08:17,890
إنّه مشهور بقلّة التّجاوزات فيه، لذا
هذا أمرٌ غير مسبوق حقّاً

94
00:08:17,890 --> 00:08:21,030
ماذا كان ذلك بالضّبط؟ تباطأ فجأة

95
00:08:21,030 --> 00:08:23,100
كدتُ أجهِز عليه

96
00:08:23,400 --> 00:08:27,190
ثمّة مُشكلة ما تُعاني منها السيّارة 86

97
00:08:27,540 --> 00:08:28,750
لماذا؟

98
00:08:28,750 --> 00:08:32,160
وكأنّ هناك تأخير عند التّسارع عن الغيار الأوّل

99
00:08:32,510 --> 00:08:35,670
قد يكون خللاً من نوع ما

100
00:08:36,280 --> 00:08:39,450
أوّل ما يخطر على الذّهن هو خلل
في علبة السّرعة

101
00:08:39,720 --> 00:08:42,580
من المُحتمل أنّه لا يستطيع استخدام الغيار الثّاني

102
00:08:44,960 --> 00:08:47,630
،إذا بقيتُ في الثّالث والرّابع هنا

103
00:08:47,630 --> 00:08:52,210
فيمكنني الحِفاظ على وتيرة تُبقيني
أمام اللّامبورغيني

104
00:08:52,210 --> 00:08:54,320
...لكن الألم في مِرفقي

105
00:08:55,460 --> 00:09:01,180
الآن بعد أن بدأ السّباق، أنا أتوتّر
وأشدّ على نفسي من غير قصد

106
00:09:03,610 --> 00:09:08,110
المُتصدِّرون يتجاوزون محطّة مانازورو القديمة

107
00:09:08,110 --> 00:09:10,320
ينعطفون يميناً إلى داخل شبه الجزيرة

108
00:09:11,530 --> 00:09:13,490
ويتقدّمهم بيكنباور

109
00:09:13,490 --> 00:09:15,450
ساواتاري كوكي في المركز الثّاني

110
00:09:15,450 --> 00:09:17,410
وأكابا كايتو في الثّالث

111
00:09:17,410 --> 00:09:20,980
.وإيشيغامي فوجين في الرّابع
بينما كاتاغيري كاناتا في الخامس

112
00:09:20,980 --> 00:09:22,790
أويشي دايغو في السّادس

113
00:09:23,060 --> 00:09:28,630
ياناغيدا تاكويا في السّابع، وموروبوشي سينا
في الثّامن، وساكاموتو يوداي في التّاسع

114
00:09:28,630 --> 00:09:30,590
ومايزونو كازوهيرو في العاشر

115
00:09:30,590 --> 00:09:32,540
وياشيو كاكيرو في الأحد عشر

116
00:09:32,540 --> 00:09:34,510
وآيبا شون في الثّاني عشر

117
00:09:34,510 --> 00:09:36,470
وكيتاهارا نوزومي في الثّالث عشر

118
00:09:36,470 --> 00:09:40,220
،وجاكسون تايلور في الرّابع عشر
وأوتاني يوسكي في الخامس عشر

119
00:09:44,930 --> 00:09:48,840
ماذا تفعل يا 86؟ لا تبدو قويّاً اليوم

120
00:09:49,170 --> 00:09:52,180
الفيراري والبورش تبتعدان بسببك

121
00:09:52,570 --> 00:09:56,490
لكن لا أستطيع المرور نظراً لضيق الطّرُق

122
00:09:57,580 --> 00:09:59,840
هذه هي شبه الجزيرة

123
00:10:02,580 --> 00:10:06,580
من كوكي إلى المقصورة. أين 86 الآن؟

124
00:10:06,580 --> 00:10:09,210
ثمّة أمر غريب. لا ينفكّ يتراجع

125
00:10:09,480 --> 00:10:12,460
يعتقد طاقم التّعليق بأنّه قد يكون
خللاً في علبة السّرعة

126
00:10:12,460 --> 00:10:15,170
علبة السّرعة؟ هذا غير مُرجّح

127
00:10:15,450 --> 00:10:19,470
،لديه مُبدّل سرعة بنمط أتش مع ثلاث دوّاسات
لا يمكن أن يتعطّل هذا فجأة

128
00:10:19,470 --> 00:10:21,390
لا أصدّق هذا الكلام الفارغ

129
00:10:22,770 --> 00:10:24,500
ما الّذي يجري إذاً؟

130
00:10:24,500 --> 00:10:28,790
كانت استراتيجيّتي بأكملها استخدامك كأداة
إلهاء لهذا الألمانيّ المزعج

131
00:10:29,140 --> 00:10:35,230
أنت  المُتفجِّر الوحيد الّذي يستطيع
بثّ الرُّعب في قلب هذا المُتعجرف

132
00:10:35,730 --> 00:10:38,920
لذا انهض بسرعة يا كاناتا ريفينغتون

133
00:11:03,660 --> 00:11:05,850
نال منّي

134
00:11:05,850 --> 00:11:08,850
!تمّ تجاوز آيبا في السيّارة 9

135
00:11:12,810 --> 00:11:16,980
الإلَهيّون الخمسة عشر يعبرون الغابة
،في شبه جزيرة مانازورو

136
00:11:16,980 --> 00:11:21,950
رغم أنّ المجموعة المُتصدِّرة شارفت على بلوغ
،قسم السّاحل تالياً

137
00:11:23,930 --> 00:11:26,480
تبدين حزينة يا رين-تشان

138
00:11:26,930 --> 00:11:28,130
كيوكو-سان؟

139
00:11:28,130 --> 00:11:31,120
هل تشاجرتِ مع زميلكِ في السّكن؟

140
00:11:32,500 --> 00:11:34,710
ما-ما أدراكِ بذلك؟

141
00:11:34,710 --> 00:11:37,430
هذا واضح من تعابير وجهكِ

142
00:11:37,930 --> 00:11:39,770
ماذا كان سبب الخِلاف؟

143
00:11:40,180 --> 00:11:41,470
...في الواقع

144
00:11:41,950 --> 00:11:44,010
كانت غلطتي

145
00:11:44,350 --> 00:11:47,430
أغار من أشياء تافهة

146
00:11:48,550 --> 00:11:49,930
!هذا مُضحك

147
00:11:50,770 --> 00:11:53,450
!يروقني ذلك. ما أحلى الشّباب

148
00:11:54,950 --> 00:11:56,520
...والسيّارة 12

149
00:11:56,520 --> 00:11:59,460
!تعبر المُنحنى الحادّ أونيسي

150
00:12:02,490 --> 00:12:07,910
الفجوة بين المجموعة المُتصدِّرة والمجموعة
الوسطى تبدو أقلّ من المُتوقَّع

151
00:12:08,330 --> 00:12:12,620
هذا لأنّ المُتصدِّر بيكنباور لا يحاول جاهداً الابتعاد

152
00:12:13,450 --> 00:12:18,040
إنّه واثق بأنّه يستطيع أن يعزّز وتيرته والحِفاظ
على مسافة جيّدة بينه وبين السّائقين خلفه

153
00:12:18,630 --> 00:12:21,510
إنّه لا يُقدِم على أيّ مُجازفة غير ضروريّة

154
00:12:22,040 --> 00:12:26,350
أسلوبه في السّباق هو جعل الفوز حتميّاً

155
00:12:27,070 --> 00:12:30,640
لكن شخصيّاً، لا أجد هذه الطّريقة مُثيرة

156
00:12:31,230 --> 00:12:34,730
!مُبهر! السيّارة 13 تفعلها

157
00:12:35,010 --> 00:12:37,690
أحدهم في الأمام يفرمل باكراً

158
00:12:37,690 --> 00:12:40,690
هذه فُرصتي للتقدُّم إلى مركز أعلى

159
00:12:42,150 --> 00:12:45,490
إنّهما بجانب بعضهما الآخر ولا يتراجع
السّائقان قيد أنملة

160
00:12:45,770 --> 00:12:47,440
يدوران عبر زاوية مياماي

161
00:12:47,440 --> 00:12:50,370
...السيّارة 13 مُتقدِّمة بفارق نصف عجلة

162
00:12:50,940 --> 00:12:52,830
!ويستكمل التّجاوُز

163
00:12:52,830 --> 00:12:56,290
!السيّارة 13 في المركز التّاسع الآن

164
00:12:56,660 --> 00:12:59,630
حسناً، حان وقت الأسئلة للرّقم 7

165
00:12:59,900 --> 00:13:02,320
هل هناك ما أثار قلقك مؤخّراً؟

166
00:13:03,710 --> 00:13:09,070
أكثر شيء يُقلقني هو أنّني ربّما
ما زلتُ غير ناضجة ذهنيّاً

167
00:13:09,660 --> 00:13:12,310
أو أنّني لم أكبر بما يكفي

168
00:13:12,830 --> 00:13:18,770
أقلق من إزعاجي للآخرين بقول
كلام طائش. أكره ذلك

169
00:13:19,090 --> 00:13:23,020
أحياناً، أدرك ذلك متأخِّرة وأبدأ بجلد ذاتي

170
00:13:23,680 --> 00:13:27,250
أريد أن أكون أكثر مُراعاة لمشاعر الآخرين

171
00:13:29,550 --> 00:13:30,900
من المقصورة إلى دايغو

172
00:13:30,900 --> 00:13:32,050
دايغو يتكلّم

173
00:13:32,050 --> 00:13:37,120
سمعنا بأنّ السيّارة 86 تواجه مشكلة في التّبديل
ولا تستطيع استخدام الغيار الثّاني

174
00:13:37,120 --> 00:13:39,080
هل هذا يُطابق ما تراه؟

175
00:13:39,080 --> 00:13:41,930
لا أدري. يبدو لي وكأنّه يقود بصورة طبيعيّة

176
00:13:44,260 --> 00:13:49,570
،إنّه لا يتسارع جيّداً عند صعود تلّة
لكن ألم يكن 86 هكذا دوماً؟

177
00:13:49,570 --> 00:13:54,270
،عند الخروج من منطقة سكنيّة تلّية
فإنّك تُنزِل الغيار إلى الأوّل

178
00:13:54,270 --> 00:13:58,930
لنفترض أنّ 86 سيتباطأ وينتهز
تلك الفُرصة لتجاوزه

179
00:13:58,930 --> 00:13:59,750
حوّل

180
00:14:01,560 --> 00:14:05,900
قادَ عبر قسم شبه الجزيرة بصورة
مثاليّة في مرحلة التّصفيات

181
00:14:05,900 --> 00:14:11,670
لكن السّخرية أنّ هذا سيكون أصعب
جزء لكاتاغيري-كن اليوم

182
00:14:12,280 --> 00:14:16,500
لأنّ كامل قسم شبه الجزيرة تقريباً
يُقطَع بالغيار الثّاني والثّالث

183
00:14:16,720 --> 00:14:23,170
حقيقة أنّه يبدو وكأنّه يقود بصورة طبيعيّة
هي دلالة على أنّ شيئاً جنونيّاً يحدث

184
00:14:27,920 --> 00:14:29,630
هنا. في زاوية النّقطة تي

185
00:14:35,020 --> 00:14:37,900
بجدّية؟ هل تباطأ حقّاً؟

186
00:14:38,270 --> 00:14:41,230
قاومَ هذه المُقاومة بلا غيار ثانٍ؟

187
00:14:41,480 --> 00:14:44,420
كاتاغيري كاناتا وحش حقيقيّ

188
00:14:45,180 --> 00:14:49,320
أويشي في السيّارة 3 يلتفّ خلسة حول كاتاغيري
كاناتا في الـ 86 ويكسب مركزاً

189
00:14:49,320 --> 00:14:53,990
لا بدّ أنّ كاتاغيري كاناتا يترنّح مع عودته
!إلى شبه الجزيرة الّتي هيمن عليها من قبل

190
00:14:54,790 --> 00:14:57,030
أوغاتا يتكلّم. هل أنت بخير؟

191
00:14:57,030 --> 00:14:59,070
لا مشكلة. حوّل

192
00:15:00,150 --> 00:15:06,070
بحسب ما رأيناه للتو، أنا متأكّد بأنّ 86
لا يستطيع استخدام الغيار 2

193
00:15:06,760 --> 00:15:08,720
لكن هذا عجيب

194
00:15:08,720 --> 00:15:13,970
إن طلبت منّي القيادة في شبه الجزيرة هذه من دون
غيار ثانٍ، فسأكون ضائعاً تماماً

195
00:15:14,490 --> 00:15:19,480
من السّهل الحديث عن استخدام الغيار الثّالث
،للتّعويض عن عدم استخدام الغيار الثّاني

196
00:15:19,830 --> 00:15:23,770
لكن تنفيذ ذلك يعني معركة ضدّ
عدم وجود عزم دوران

197
00:15:24,130 --> 00:15:29,850
في الواقع، مُشكلة علبة السّرعة هذه تُظهِر مهارات
كاتاغيري كاناتا أكثر من أيّ وقت مضى

198
00:15:31,680 --> 00:15:35,490
والمجموعة المُتصدِّرة تتجاوز التعرُّج الحادّ

199
00:15:35,940 --> 00:15:38,360
ثمّ يبدأ النّصف الثّاني من الطّريق الدّاخليّ

200
00:15:48,090 --> 00:15:51,130
هل سيتمكّن ياناغيدا في السيّارة 6 من التّجاوز؟

201
00:15:52,090 --> 00:15:56,230
!يتخطّى 86 بينما تتباطأ

202
00:15:56,640 --> 00:15:58,970
،أشعر بالحسرة لتجاوزك هكذا

203
00:15:58,970 --> 00:16:03,650
لكن نِزال المُنعطف بيننا سيُؤجَّل
حتّى المرّة المُقبلة

204
00:16:03,960 --> 00:16:05,610
تبّاً، نالَ منه

205
00:16:05,960 --> 00:16:08,240
ربّما كان من الأفضل البقاء في الأوّل

206
00:16:08,570 --> 00:16:09,450
أوغاتا يتكلّم

207
00:16:09,450 --> 00:16:11,070
هل أنت بخير يا كاناتا؟

208
00:16:11,070 --> 00:16:13,250
لا مشكلة. حوّل

209
00:16:14,110 --> 00:16:17,890
"كلّ ما كان يقوله منذ مدّة هو "لا مشكلة

210
00:16:17,890 --> 00:16:20,160
صوته يخلو من الحيويّة

211
00:16:20,620 --> 00:16:25,960
.لا بدّ أنّ مِرفقه يؤلمه بشكلٍ مُبرح
لدرجة تجعله لا يستجيب كما ينبغي

212
00:16:26,880 --> 00:16:27,960
...لكن

213
00:16:34,240 --> 00:16:38,970
!إنّ 885 تُطبِق على 86 الآن

214
00:16:38,970 --> 00:16:43,440
نحن نشهد بداية نِزال بين هذين الصّاعدين
على المركز السّابع

215
00:16:48,860 --> 00:16:51,820
!كم هذا مُخيف

216
00:16:52,200 --> 00:16:56,280
تمكّنت 7 من تجاوزه، لكنّه الآن
يُطبِق عليه من جديد

217
00:17:03,650 --> 00:17:06,250
!وبدأ 86 بتحرّكاته

218
00:17:06,250 --> 00:17:07,960
ماذا؟

219
00:17:08,180 --> 00:17:10,170
هذا مُؤلم للغاية

220
00:17:13,590 --> 00:17:16,090
طريق مُنحني سريع يُطلّ على مُنحدر

221
00:17:16,090 --> 00:17:20,350
أيّ تعثُّر للعجلات قد يؤدّي إلى رحلة
!وعرة نحو خليج ساغامي

222
00:17:25,890 --> 00:17:28,430
لكن السيّارة 6 لا تستسلم دون مُقاومة

223
00:17:28,430 --> 00:17:31,320
!تدخلان النّفق جنباً إلى جنب

224
00:17:31,540 --> 00:17:35,400
لكن أي من ساحرَي المُنعطفات هذين
سيخرج منه وهو في القمّة؟

225
00:17:35,400 --> 00:17:37,850
تبّاً. إذا لم أفعل شيئاً بشأن
،قوّة الجاذبيّة الأفقيّة هذه

226
00:17:37,850 --> 00:17:40,410
فلن أبلغ حتّى نصف قوّتي
الحصانيّة البالغة 800

227
00:17:41,720 --> 00:17:44,870
!وما زالت النّتيجة مُتعادِلة بينما يخرجان من النّفق

228
00:17:44,870 --> 00:17:48,330
عرض المضمار ينقسم إلى نصفين بعد قليل

229
00:17:48,330 --> 00:17:50,790
!لا يستطيعان المُواظبة على هذا

230
00:17:50,790 --> 00:17:54,260
ماذا سيحدث؟ يتحوّل هذا إلى سِباق
!حقيقيّ بين دجاجتين

231
00:17:56,170 --> 00:18:00,640
،السيّارة 6 في الجهة الخارجيّة
!ما يعني بأنّه مُجبَر على التّراجُع

232
00:18:02,350 --> 00:18:05,920
!تعود السيّارة 86 إلى المركز السّادس

233
00:18:06,530 --> 00:18:10,980
لم يتخيّل أحدٌ بأنّنا سنشهد هذه التّغييرات الكثيرة
في المراكز، نظراً إلى سمعة مانازورو

234
00:18:10,980 --> 00:18:15,440
!والسيّارة 86 هي الّتي في عين العاصفة

235
00:18:16,020 --> 00:18:19,360
يفعل هذا باستخدام الغيارين
الثّالث والرّابع فقط؟

236
00:18:19,910 --> 00:18:22,660
يا لها من قيادة ممتازة يا كاتاغيري كاناتا

237
00:18:23,040 --> 00:18:28,730
هذا ما أتوقّعه من الشّخص الآخر هنا
والّذي ورث فخر غونما

238
00:18:31,100 --> 00:18:33,410
،هذا هو سِباقي الثّالث إلى جانب كاناتا

239
00:18:33,720 --> 00:18:37,630
وهو يفاجئني اليوم أكثر من أيّ وقت مضى

240
00:18:38,260 --> 00:18:40,950
...بالنّسبة لموهبته كسائق سِباق

241
00:18:41,310 --> 00:18:45,350
،تقنيّته الفاخرة مُلفِتة للأنظار حقّاً
لكن ليس هذا ما يجعله هو

242
00:18:45,350 --> 00:18:47,280
بل قوّة قلبه

243
00:18:48,030 --> 00:18:49,960
رفضه التّام للاستسلام

244
00:18:50,460 --> 00:18:56,110
،مُضافاً إلى ذلك روحه التّنافسيّة
هذه أُسُس موهبته

245
00:18:57,190 --> 00:19:00,640
امتلاك كاتاغيري كاناتا أفضليّة
على الصّعيد الفنّي

246
00:19:00,640 --> 00:19:02,950
...قد أصبح النّظريّة المقبولة

247
00:19:03,560 --> 00:19:06,290
لكن لم أؤيّد ذلك أبداً...

248
00:19:07,160 --> 00:19:11,080
،في حقيقة الأمر، في السّباقين الماضيّين
،عانى بسيّارة مُستضعفة

249
00:19:11,080 --> 00:19:14,900
لذا كان قد واجه مشكلة في مُجاراة مُنافسيه
،عبر الأقسام الّتي تتطلّب سرعة أعلى

250
00:19:14,900 --> 00:19:20,720
ممّا أجبره على أن يصبح شرِساً في المُنخفضات

251
00:19:21,490 --> 00:19:28,360
يمكنني القول أنّه كلّما كان نِطاق السّرعة في سِباق
أوسع، برزَ كاتاغيري كاناتا أكثر

252
00:19:29,230 --> 00:19:32,230
يغدو هذا جليّاً عندما ترى سِباق اليوم

253
00:19:32,810 --> 00:19:37,350
إنّه يتّخذ أسلوباً هجوميّاً في نقاط محفوفة بالمخاطر
ما كان ليجرؤ عليها سائقون آخرون

254
00:19:38,210 --> 00:19:42,500
إن فكّرت في الأمر، من الغريب الافتراض بأنّ
شخصاً تلقّى تعليماً مُتقدِّماً كهذا

255
00:19:42,500 --> 00:19:46,550
أن يختصّ في الأقسام الّتي تتطلّب سرعة مُنخفضة

256
00:19:47,260 --> 00:19:52,870
كاتاغيري كاناتا هو بصراحة شخص سريع
مهما كان الطّريق الّذي يقود فيه

257
00:19:53,170 --> 00:19:56,540
تعبر المجموعة المُتصدِّرة أوروجيه تلو الآخر

258
00:19:59,770 --> 00:20:02,730
لم أصل إليه بعد؟

259
00:20:23,360 --> 00:20:28,200
هل كان ذلك كاناتا للتو؟ ما الّذي
يفعله في تلك المسافة البعيدة؟

260
00:20:31,600 --> 00:20:32,770
كاناتا

261
00:20:33,860 --> 00:20:36,870
أوغاتا يتكلّم. هل أنت بخير يا كاناتا؟

262
00:20:37,530 --> 00:20:38,960
لا مشكلة

263
00:20:40,200 --> 00:20:41,280
حوّل

264
00:22:21,150 --> 00:22:23,910
ماذا أصابك بالضّبط يا كاناتا؟

265
00:22:25,860 --> 00:22:28,200
سأسبقك يا أخي

266
00:22:28,770 --> 00:22:32,730
هل تمانع أن أتحدّث عن فوجيوارا قليلاً؟

267
00:22:33,540 --> 00:22:37,630
هذه أكثر نهاية ذات مغزى في المركز
الأخير في تاريخ م.ف.ج

268
00:22:37,950 --> 00:22:41,000
ويجب علينا إكمالها إلى الأخير

269
00:22:41,000 --> 00:22:46,110
سأقولها. عندما ينتهي هذا السّباق، سأخبره

270
00:22:47,220 --> 00:22:50,430
!وكاتاغيري كاناتا يبتعد أكثر فأكثر حتّى

271
00:22:56,340 --> 00:23:00,500
.سوف يحلّ في المركز الأخير
لا بدّ أنّ الشّعور فظيع يا كاناتا

272
00:23:01,630 --> 00:23:05,230
الطّبيب تاكاهاشي، تفاقم سوء حالة المريض

273
00:23:05,230 --> 00:23:07,190
عُلِم. أنا قادم في الحال

274
00:23:09,150 --> 00:23:11,570
أوغاتا-سان. حان وقت الانتقام

275
00:23:12,980 --> 00:23:15,260
...كلّ السيّارات الّتي تجاوزتني

276
00:23:15,830 --> 00:23:17,700
...يجب أن أتجاوزها ثانية

277
00:23:19,010 --> 00:23:21,020
قبل أن ينتهي هذا السّباق

278
00:23:21,880 --> 00:23:22,850
حوّل