1
00:00:00,580 --> 00:00:04,440
التّالي هو تايلور. وخلفه كاناتا

2
00:00:04,440 --> 00:00:06,620
أريد مُقارعته

3
00:00:06,620 --> 00:00:10,940
أريد مواجهة عبقريّ القيادة ذاك
والّذي لم أشهد مثله من قبل

4
00:00:11,290 --> 00:00:13,950
،المجموعة الرّئيسيّة غادرت الطّريق 1

5
00:00:13,950 --> 00:00:18,170
وتنعطف يميناً نحو أشينوكو سكايلاين

6
00:00:18,860 --> 00:00:23,110
هناك فجوة كبيرة، ثمّ نرى مجموعة
المركز الثّالث

7
00:00:23,730 --> 00:00:24,960
...لحظة، هذا

8
00:00:24,960 --> 00:00:27,240
لا أنكر بأنّني متفاجئ

9
00:00:27,720 --> 00:00:29,980
الـ 86 موجودة هناك

10
00:00:30,310 --> 00:00:33,000
لم يتراجع كما توقّعت

11
00:00:33,640 --> 00:00:35,680
إنّها ميزة الظّروف الرّطبة

12
00:00:36,190 --> 00:00:38,520
يمكنك الحصول على وحش بقوّة
،حصانيّة أزيد من 600

13
00:00:48,160 --> 00:00:52,000
بطريقة تُعرقل أيضاً سرعتهم
الإجماليّة في السّباق

14
00:00:52,940 --> 00:00:57,170
قد يتطلّب هذا شرحاً مُطوّلاً. هل أتابع؟

15
00:00:57,170 --> 00:00:58,740
تفضّل لو سمحت يا إيكيدا-سان

16
00:00:59,210 --> 00:01:04,210
هذه هي النّتيجة الّتي استخلصتُها
بعد مسيرة طويلة في السّباق

17
00:01:04,210 --> 00:01:07,690
عندما تقود في مضمار بنموذج
،سيّارة جاهز ومُعدّ للبيع

18
00:01:07,690 --> 00:01:13,090
فيمكنني القول بأنّ 400 قوّة حصانيّة هي أقصى
ما يستطيع شخصٌ عاديّ التحكّم به

19
00:01:13,430 --> 00:01:18,900
لكن في الطّرُق العامّة، هذا الرّقم
أقلّ بعض الشّيء

20
00:01:18,900 --> 00:01:21,060
...أنظمة القيادة تُشكّل فرقاً

21
00:01:21,060 --> 00:01:24,850
لكن يمكنني التّخمين بأنّه محصور
بين 300 و 350 قوّة حصانيّة

22
00:01:24,850 --> 00:01:27,210
هل هو منخفض إلى هذا الحدّ حقّاً؟

23
00:01:27,530 --> 00:01:32,770
لكن السيّارات القريبة من قمّة م.ف.ج
تتجاوز الـ 600 قوّة حصانيّة

24
00:01:32,770 --> 00:01:34,030
هذا صحيح

25
00:01:34,030 --> 00:01:37,490
...لكن أعتقد عندما يتعلّق الأمر بـ م.ف.ج

26
00:01:37,490 --> 00:01:41,190
فتلك القوّة الكبيرة غير ضروريّة فعليّاً

27
00:03:46,650 --> 00:03:50,870
أشعر بأنّ النّاس قد يُخطئون في فهم ذلك القانون

28
00:03:50,870 --> 00:03:55,350
هناك بضعة فِخاخ مُضلّلة في قانون
الثّبات نسبة إلى الوزن

29
00:03:55,350 --> 00:03:58,050
أحدثتْ فوارقَ جمّة في الأداء

30
00:03:58,520 --> 00:04:05,010
يراودني شعور بأنّ الإسهاب أكثر
،سوف يزعج ريو تاكاهاشي، لذا لن أفعل

31
00:04:05,010 --> 00:04:09,520
لكن كثيراً من الصّادرات ذات العلامة التّجاريّة
الممتازة تمتلك قوّة أكبر ممّا سُخِّرتْ لأجله

32
00:04:09,520 --> 00:04:12,520
،مكبوتة بإطارات ضخمة وأنظمة إلكترونيّة

33
00:04:12,520 --> 00:04:16,150
وتُباع للأكثر ثراء كدلالة على المكانة

34
00:04:16,610 --> 00:04:19,540
يبدو هذا سخيفاً جدّاً بالنّسبة لي

35
00:04:20,290 --> 00:04:21,750
...لكن بالعودة إلى الموضوع

36
00:04:22,280 --> 00:04:24,810
،في ظروف رطِبة كالّتي نشهدها اليوم

37
00:04:24,810 --> 00:04:29,410
مقدار القوّة الحصانيّة المُتاحة للسّائق
في الطُّرُق العامّة ينخفض أكثر حتّى

38
00:04:29,640 --> 00:04:32,540
إلى ما بين 200 و 250 قوّة
حصانيّة كحدٍّ أقصى

39
00:04:32,540 --> 00:04:36,370
كي لا يُساء فهمي، هذه هي
الحدود الّتي أخمّنها

40
00:04:36,370 --> 00:04:38,500
هذا انخفاض كبير

41
00:04:38,500 --> 00:04:42,090
لكن هذا الرّقم يمثّل صدمة حقيقيّة

42
00:04:49,970 --> 00:04:51,270
تماماً

43
00:04:51,510 --> 00:04:57,730
هذه الأمطار قد تخلّصت من الإعاقة في القوّة
لدى 86 لبقيّة الميدان

44
00:04:58,330 --> 00:05:06,280
أعتقد بأنّ المُعجبين ينبغي أن يضعوا ذلك في الحسبان
بينما يشاهدون السّباق الآن

45
00:05:12,240 --> 00:05:13,200
...والآن

46
00:05:13,550 --> 00:05:16,660
ها هي مجموعة المركز الثّالث تعبر
خطّ البداية والنّهاية

47
00:05:17,120 --> 00:05:22,800
ماذا؟ يبدو أنّ هناك مسارين مُميّزين
عبر البوّابتين اليسرى واليمنى

48
00:05:22,800 --> 00:05:25,010
هذا شيء نادراً ما نراه

49
00:05:25,010 --> 00:05:29,010
،أعتقد أنّه بسبب ضيق البوّابات

50
00:05:29,010 --> 00:05:32,560
كان السّائقون يتوتّرون من عبورها
بسرعة قصوى

51
00:05:32,810 --> 00:05:35,520
كان الرّذاذ يحجب رؤيتهم بما يكفي

52
00:05:35,770 --> 00:05:39,730
لحثّهم على ترك أكبر مسافة مُمكنة
بينهم وبين السيّارات الّتي أمامهم

53
00:05:40,580 --> 00:05:43,390
هكذا إذاً. فهمت

54
00:05:43,760 --> 00:05:48,510
لعلّنا نشهد حالة نادرة من السّلوك
المُتأثِّر بالأمطار

55
00:05:49,740 --> 00:05:52,400
تحلّق المزيد من السيّارات عبر البوّابة

56
00:05:52,400 --> 00:05:55,860
!انتهى ثلثُ السّباق بينما ندخل اللفّة الثّانية

57
00:06:21,210 --> 00:06:25,110
الماكينات المُتوحّشة الخمسة عشر الإلَهيّة
!تُقارع المطر بحدّ ذاته

58
00:06:25,110 --> 00:06:27,930
هل سيتمكّن السّائقون الأكثر موهبة فنّياً فقط

59
00:06:27,930 --> 00:06:30,450
من إثبات أنفسهم من الآن فصاعداً؟

60
00:06:31,150 --> 00:06:36,510
تنتظرهم منطِقة الموت من بُحيرة أشينوكو الّتي
تُكشِّر عن أنيابها للانقضاض على فريستها الطّازجة

61
00:06:57,960 --> 00:06:59,730
أنا جاهز للقيام بهذا

62
00:07:00,120 --> 00:07:04,570
الامتداد الأخطر في السّباق والّذي
...يكرهه كلُّ السّائقين

63
00:07:05,050 --> 00:07:06,070
منطِقة الموت

64
00:07:07,040 --> 00:07:08,500
سأبدأ بتحرُّكاتي هناك

65
00:07:25,840 --> 00:07:30,260
السيّارات المُتصدِّرة تدخل منطقة
!الموت للمرّة الثّانية

66
00:07:53,580 --> 00:07:58,160
ساواتاري في 4 يُراقب 12 عن كثب
!بينما يُطارده

67
00:07:58,770 --> 00:08:03,750
هذا وضعٌ حسّاس! يمكنكم الشّعور بهذه
!المُناورات الخطيرة الّتي يشوبها التوتُّر

68
00:08:03,750 --> 00:08:05,710
!لا أجرؤ على الإشاحة بنظري

69
00:09:46,180 --> 00:09:49,450
!والسيّارة 4 تتصدّر السِّباق

70
00:09:49,450 --> 00:09:53,270
!انقلبت الطّاولة على بيكنباور

71
00:10:03,490 --> 00:10:04,880
شبح م.ف

72
00:10:08,070 --> 00:10:11,920
!أخيراً تمّ قلب الموازين على بيكنباور

73
00:10:11,920 --> 00:10:15,590
!شهدنا للتوّ تغيُّراً جذريّاً للمُتصدِّر

74
00:10:15,590 --> 00:10:18,550
أنا مُندهش من عدم احتكاكهما
وسط كلّ تلك الأمطار

75
00:10:18,550 --> 00:10:23,250
كثيراً ما نرى سيّارات فارهة تساوي الملايين
تتدمّر طوال الوقت

76
00:10:23,250 --> 00:10:25,520
بعد هفوة واحدة في م.ف.ج

77
00:10:25,760 --> 00:10:27,980
هكذا هم الخمسة عشر الإلَهيّين

78
00:10:27,980 --> 00:10:30,170
حدث احتكاك بينهما ثلاث مرّات

79
00:10:30,170 --> 00:10:32,650
إيكيدا-سان، هلّا أعطيتنا رأيك
حول ذلك التّجاوز؟

80
00:10:33,010 --> 00:10:36,110
أنا مصدوم من حتّى إقدامه على ذلك
التصرُّف في منطقة الموت

81
00:10:36,420 --> 00:10:39,390
ليس وكأنّ بيكنباور ارتكب خطأ

82
00:10:39,390 --> 00:10:43,080
ساواتاري-كن هو من تجاوز الحدود

83
00:10:43,300 --> 00:10:45,720
الاحتكاك بحدّ ذاته كان حدثاً عارضاً

84
00:10:45,720 --> 00:10:50,500
كانت السيّارة 12 تسعى لذروة الزّاوية
،كما يفعل كلّ سائق

85
00:10:50,500 --> 00:10:54,340
ولم يتوقّع أن تُقحِم السيّارة 4 نفسها

86
00:10:54,740 --> 00:10:59,970
النّكزة نحو الزّاوية الخلفيّة الفارغة زعزعت
توازن الـ 12 لتحرفها قليلاً عن المسار

87
00:11:00,410 --> 00:11:03,680
والوقت الّذي استغرقَتْه لتصحيح المسار
هو الّذي أحدث كلّ الفرق

88
00:11:04,480 --> 00:11:07,220
...المرّتان الأُخرتان اللّتان احتكّا فيهما

89
00:11:07,220 --> 00:11:11,520
حسناً، كيف أصِف الأمر؟
كان أشبه بصِراع عواطف

90
00:11:11,940 --> 00:11:16,400
...بعد الاصطدام بينهما، انبثقت السيّارة 4 مُنتصرة

91
00:11:16,400 --> 00:11:21,500
لتجعله يضغط على دوّاسة السّرعة
حتّى وهو يمسّ سياج الحماية

92
00:11:22,050 --> 00:11:25,320
كان عرضاً مُبهراً بواسطة السّائقَين

93
00:11:25,640 --> 00:11:31,660
لعلّ هذا أعظم تجاوز دراماتيكيّ
!في تاريخ م.ف.ج

94
00:11:38,350 --> 00:11:41,850
أهنّئك لأنّك أجبرتني على أن أصبح
جادّاً، ولو كان ذلك لبُرهة

95
00:11:42,380 --> 00:11:45,260
لكن سأردّ لك الصّاع صاعين
على تلك الإهانة

96
00:11:45,260 --> 00:11:49,230
المركز الأوّل لا يليق بتلك المركبة
الفرنسيّة الرّخيصة

97
00:11:49,230 --> 00:11:53,930
!إنّه ينتمي لي وللبورش العظيمة خاصّتي فقط

98
00:12:01,650 --> 00:12:02,860
مذهل

99
00:12:03,400 --> 00:12:05,820
تمّ تجاوز مايكل في الواقع

100
00:12:06,450 --> 00:12:09,610
أعتقد هذه أوّل مرّة منذ بدأ في م.ف.ج

101
00:12:10,120 --> 00:12:13,310
إذا احتلّ المركز الثّاني، فستكون
صدمة حقيقيّة للنّظام

102
00:12:15,520 --> 00:12:20,940
غالباً سينعزل في غرفة نومه ليومين
أو ثلاث دون أن يأكل شيئاً

103
00:12:22,310 --> 00:12:26,700
ذلك الفتى بائس من دوني حقّاً

104
00:12:27,590 --> 00:12:32,340
إنّه متغطرس وأنانيّ ومزاجيّ ولا يستطيع
التّعبير عن نفسه جيّداً

105
00:12:33,020 --> 00:12:35,760
أشكّ في أنّه سيتزوّج يوماً

106
00:12:36,630 --> 00:12:40,470
،لكن عندما يتعلّق الأمر بالسّباق
فهو لا يخسر أبداً

107
00:12:40,470 --> 00:12:43,110
لأنّه الشّيء الوحيد الّذي يبرع فيه

108
00:12:44,290 --> 00:12:49,450
خسارة مايكل في منافسة كهذه
لا يمكن تخيّلها

109
00:13:13,790 --> 00:13:18,770
المجموعة الّتي تتنافس على المركز
الثّالث تقترب من معبر ميكوني

110
00:13:20,090 --> 00:13:23,740
مجموعة الستّة الأقوياء تشقُّ طريقها
!عبر منطقة الموت

111
00:14:31,440 --> 00:14:32,300
ماذا؟

112
00:14:36,740 --> 00:14:40,190
لا أستطيع التّسارع بوجودك هنا، اللّعنة

113
00:14:42,150 --> 00:14:44,610
أعلم بأنّه سِباق، لكن هذا خشن
جدّاً أيّها الأحمق

114
00:14:44,840 --> 00:14:47,070
لن تتمكّن من الانعطاف هكذا

115
00:14:50,910 --> 00:14:51,570
—ما

116
00:14:51,940 --> 00:14:53,040
انزلاق؟

117
00:15:02,820 --> 00:15:08,180
مذهل! إنّه معبر ميكوني والسيّارة 5
!ظهرت في مرأى 86

118
00:15:08,180 --> 00:15:11,590
لا يوجد ما يخمد نار كاتاغيري كاناتا

119
00:15:11,590 --> 00:15:16,390
!إنّه ينطلق من خلف المجموعة

120
00:15:16,690 --> 00:15:21,310
إيكيدا-سان، ما رأيك بالتّجاوز الّذي
قام به 86 للتو؟

121
00:15:22,270 --> 00:15:28,320
لا أستطيع تحليل المُناورة الّتي قام
بها كاتاغيري-كن بدقّة

122
00:15:28,980 --> 00:15:35,280
أن يُنحى ساكاموتو يوداي في السيّارة 5
...بسهولة هكذا

123
00:15:35,720 --> 00:15:38,120
يمكنني إخبارك بشيء واحد وهو
أنّ معبر ميكوني هذا

124
00:15:38,120 --> 00:15:44,690
هو امتداد طويل عبر صعود تلّة
ثمّ تحوُّل مفاجئ نحو مُنخفض

125
00:15:44,690 --> 00:15:47,630
في حين أنّ المُتسابقين جيّدون في التّعامل
،مع قوّة الجاذبيّة الجانبيّة

126
00:15:47,630 --> 00:15:50,260
إلّا أنّهم لا يحسنون التّعامل عادة
مع تلك العاموديّة

127
00:15:50,920 --> 00:15:57,470
،في أوضاع كهذه، مهما كان ذلك قصيراً
يفقد النّاس إحساسهم بالتّوازن

128
00:15:57,870 --> 00:16:03,820
أعتقد بأنّ ذلك خلقَ ثغرة طفيفة في انعطاف
ساكاموتو-كن عند الزّاوية

129
00:16:04,190 --> 00:16:07,880
وكاتاغيري-كن لم يفوّت الفُرصة

130
00:16:07,880 --> 00:16:11,980
برأيي كان يتوقّع ذلك، وكان يطمح
لإتمام الأمر هناك

131
00:16:17,300 --> 00:16:23,120
درّبني أخي على تلك الخدعة
أثناء أيّامنا في بروجيكت دي

132
00:16:23,590 --> 00:16:26,500
بالنّسبة لمُتسابقي الشّوارع، إنّه التّجاوز 101

133
00:16:26,980 --> 00:16:32,470
هذا يدلّ على أنّه تمّ توارثه من فوجيوارا
تاكومي إلى كاتاغيري كاناتا

134
00:16:33,270 --> 00:16:34,930
لكن لديّ خدعتي الخاصّة

135
00:16:36,600 --> 00:16:38,600
خدعة أنتظر حتّى أطلق عنانها

136
00:16:44,990 --> 00:16:49,030
ذلك الشّيء الّذي فعله كاناتا يُدعى
بالانزلاق الانعطافيّ، صحيح؟

137
00:16:50,030 --> 00:16:53,460
رأيتُه يفعلها من قبل، لكن كان يبدو دوماً
بأنّه سوف ينحرف عن المسار

138
00:16:55,040 --> 00:16:58,410
آمل ألّا أضطرّ لتبديل المراكز السّفليّة كثيراً

139
00:16:58,850 --> 00:17:01,620
كاميرا الملائكة دائماً ما تكبّر
الصّورة على مؤخّرتي

140
00:17:01,620 --> 00:17:02,560
هل من مشكلة؟

141
00:17:02,560 --> 00:17:03,710
إطلاقاً

142
00:17:03,710 --> 00:17:06,370
والآن، سؤال لموي-تشان

143
00:17:06,660 --> 00:17:09,140
،إن سنحتْ لكِ فُرصة للذّهاب إلى مكان
فإلى أين كنتِ ستذهبين؟

144
00:17:09,140 --> 00:17:13,090
...في الواقع... أتساءل

145
00:17:13,960 --> 00:17:18,800
عرفت! في أساغايا في طوكيو، هناك
مطعم مشويّات شهير

146
00:17:18,800 --> 00:17:22,280
يُفترَض أن يكون من المستحيل الحصول
على حجز فيه

147
00:17:22,280 --> 00:17:26,230
أتمنّى الذّهاب إلى هناك ولو لمرّة واحدة

148
00:17:26,480 --> 00:17:34,030
مشويّات؟ كنتُ أتوقّع أن تمنحي المُعجبين
إجابة أكثر رومانسيّة يا موي-تشان

149
00:17:34,030 --> 00:17:40,980
،يعرف كلّ مُعجبيّي بأنّني أحبّ اللّحم
لذا أشكّ في أنّهم سيخيب أملهم

150
00:17:40,980 --> 00:17:45,190
أعتقد بأنّ المدير العامّ جويو
زبون منتظم في ذلك المطعم

151
00:17:45,190 --> 00:17:46,710
حقّاً؟

152
00:17:46,710 --> 00:17:49,070
ربّما ينبغي أن تطلبي منه أن يأخذكِ

153
00:17:49,070 --> 00:17:52,250
من فضلك يا حضرة المُدير العام؟

154
00:17:52,250 --> 00:17:56,380
!خذني إلى مطعم المشويّات

155
00:18:05,860 --> 00:18:09,050
أيمكننا يا حضرة المدير العامّ؟

156
00:18:09,470 --> 00:18:13,130
حسناً. بعد أن حقّقن الرّقصة الخاصّة
،بأغنيتهن الجديدة

157
00:18:13,130 --> 00:18:16,240
سآخذهن جميعاً كمُكافأة

158
00:18:17,650 --> 00:18:20,160
!تستمرّ المعركة في منطقة الموت

159
00:18:21,620 --> 00:18:23,080
!ساواتاري كوكي

160
00:18:23,080 --> 00:18:24,490
!بيكنباور

161
00:18:24,490 --> 00:18:27,260
!وكاتاغيري كاناتا

162
00:18:27,710 --> 00:18:30,670
ثلاثي الأسود الصّغار الّذين جذبوا
اهتمام إيكيدا-سان

163
00:18:30,670 --> 00:18:34,050
يندفعون عبر المطر في منطِقة
!الموت الخاصّة بأشينوكو

164
00:18:44,030 --> 00:18:45,100
ما هذا؟

165
00:18:45,390 --> 00:18:48,560
كانت الأودي الخاصّة بساكاموتو
خلفي من قبل

166
00:18:49,120 --> 00:18:51,440
من أين أتت هذه السيّارة الحمراء؟

167
00:18:52,230 --> 00:18:54,270
من المقصورة إلى دايغو! هل تسمعني؟

168
00:18:54,660 --> 00:18:56,900
اِبقَ يقظاً للسيّارة 86 خلفك

169
00:18:57,120 --> 00:18:59,650
إنّها تنطلق مُسرعة نحو الزّوايا

170
00:18:59,650 --> 00:19:03,620
.هكذا تمكّن من تجاوز السيّارة 5
!إن لم تتوخّ الحذر، ستكون التّالي

171
00:19:03,620 --> 00:19:05,230
!لذا كُن حذراً! حوّل

172
00:19:06,290 --> 00:19:10,750
قال "كُن حذراً" قال! أليس
لديك أكثر نفعاً؟

173
00:19:10,750 --> 00:19:13,500
منطِقة الموت هذه زلِقة جدّاً

174
00:19:13,500 --> 00:19:18,920
بالكاد أستطيع الدّفع بأقصى ما عندي

175
00:19:30,810 --> 00:19:33,650
التحكم في الاتّزان لا يهدأ

176
00:19:33,650 --> 00:19:36,130
مُقدّمتي وخلفيّتي تتزحلقان وتنزلقان

177
00:19:50,080 --> 00:19:52,040
اللّعنة. مُقدّمتي تبتعد عنّي

178
00:19:56,960 --> 00:20:01,340
المُنخفض شديد الانحدار. يجب أن أمنعها
!من القيام بنصف دورة

179
00:20:05,760 --> 00:20:07,990
!والسيّارة 3 تدور

180
00:20:10,890 --> 00:20:14,310
إنّها تُقابِل الآن الجهة الخاطئة
!بينما تنزلق عن الطّريق

181
00:20:16,190 --> 00:20:18,360
انتهى أمري. خسرتُ السّباق

182
00:20:26,170 --> 00:20:31,470
لا يبدو هذا مُبشّراً. لا أظنّه سوف
يتمكّن من استئناف السّباق

183
00:20:31,470 --> 00:20:34,280
!تمّ إقصاء أويشي دايغو

184
00:20:34,690 --> 00:20:37,090
آمل ألّا يكون قد تأذّى فحسب

185
00:20:37,630 --> 00:20:40,590
.من مركز التحكّم إلى سائق السيّارة 3
هل تسمعني؟

186
00:20:41,470 --> 00:20:45,050
استجب من فضلك! إن تأذّيت، أبلغنا بذلك

187
00:20:47,510 --> 00:20:51,080
سائق السيّارة 3، هل تسمعني؟
!سائق السيّارة 3

188
00:20:51,450 --> 00:20:54,650
أويشي يتكلّم. أنا بخير

189
00:20:55,470 --> 00:20:57,480
لا أعاني من أي إصابات

190
00:20:57,850 --> 00:21:00,320
أخرجوني من هنا بسرعة

191
00:21:00,730 --> 00:21:03,030
يبدو أنّ أويشي لم يتأذّ

192
00:21:03,030 --> 00:21:04,790
هذا مُطمئن

193
00:21:04,790 --> 00:21:06,490
جيّد

194
00:21:06,830 --> 00:21:10,930
من المركز إلى الإنقاذ 3، من فضلكم
أعيدوا السّائق حاليّاً

195
00:21:10,930 --> 00:21:15,080
سنرسل شاحنة سحب للسيّارة
حالما ينتهي السّباق. حوّل

196
00:21:19,480 --> 00:21:24,590
أعتقد بأنّ أويشي أفسد الأمر بسيّارة
لامبو خاصّته. يسرّني أنّه لم يتأذَّ

197
00:21:25,380 --> 00:21:28,550
يبدو أنّني تقدّمتُ مركزاً بشكل تلقائيّ

198
00:23:32,590 --> 00:23:37,430
الحلقة القادمة: حقيقة قاسية