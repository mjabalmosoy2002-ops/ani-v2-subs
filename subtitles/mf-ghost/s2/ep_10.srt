1
00:00:14,200 --> 00:00:16,320
هل أنت بخير يا أوغاتا-سان؟

2
00:00:17,520 --> 00:00:19,630
،لا أعرف طبيعة السّحر الّتي استخدمها

3
00:00:19,990 --> 00:00:23,830
لكن حتّى أنا أستطيع أن أميّز
بأنّها سيّارة مختلفة تماماً الآن

4
00:00:23,830 --> 00:00:26,320
أجل. إنّها حتّى أفضل ممّا تمنّيت

5
00:00:26,690 --> 00:00:30,920
رغم صعودها التلّة، إلّا أنّها تندفع نحو المركز
الثّالث مثلما كانت تندفع نحو المركز الثّاني

6
00:00:31,560 --> 00:00:33,630
هذا ما أردتُه من السيّارة 86

7
00:00:34,010 --> 00:00:38,390
بتسارُع من هذا النّوع، يمكنني مُواجهة
أفضل السيّارات، حتّى في الأجواء الجافّة

8
00:00:39,420 --> 00:00:43,290
تفاجأتُ بمدى سهولة قيادتها بالرّغم
من منحنى عزم الدّوران الثّابت

9
00:00:43,950 --> 00:00:46,730
سيكون ذلك نافعاً جدّاً في المُقارعات

10
00:00:47,400 --> 00:00:51,190
قد يكون السيّد أوكوياما ساحراً حقّاً

11
00:00:53,580 --> 00:00:56,870
أريد أخذها في جولة اختبار بأقصى
سرعة لتفقّد أدقّ التّفاصيل

12
00:00:56,870 --> 00:00:59,820
هل تمانع الانتظار هنا يا أوغاتا-سان؟

13
00:01:01,580 --> 00:01:03,910
كانت نظرة مختلفة

14
00:01:11,900 --> 00:01:16,350
لعلّه كان وجه كاناتا ريفينغتون، سائق السّباق

15
00:01:17,300 --> 00:01:21,810
لكن عجباً، كان ارتفاعاً من 200
إلى 300 قوّة حصانيّة

16
00:01:22,100 --> 00:01:26,060
وكاناتا وأوكوياما-سان يعتقدان حقّاً بأنّهما يستطيعان
مواجهة الوحوش ذات القوّة الحصانيّة 600

17
00:01:26,430 --> 00:01:28,980
هذا تفاؤل هائل

18
00:01:36,010 --> 00:01:39,430
ماذا؟ لن تلحق ماري-سان بذلك؟

19
00:01:39,430 --> 00:01:41,200
هذا ليس بالأمر الجلل

20
00:01:41,550 --> 00:01:44,200
على أيّ حال، إنّها تبدو من النّوع
الّذي يستمرّ بلا توقُّف

21
00:01:44,200 --> 00:01:47,660
والآن يمكنني استغراق وقتي في استيعاب
وضعكِ العاطفيّ يا رين-تشان

22
00:01:48,170 --> 00:01:51,220
قد يكون هذا من حسن حظّي

23
00:01:52,360 --> 00:01:56,420
حسناً، أخبريني عن هذا الشّخص الّذي تحبّينه

24
00:01:56,850 --> 00:02:00,680
أنا متأكّدة بأنّني لا أعرفه، لذا
لذا لا تتحفّظي بشأن التّفاصيل

25
00:02:01,060 --> 00:02:05,470
،حسناً، عندما تصِفين الأمر بهذا الشّكل
فلا أعلم من أين أبدأ حقّاً

26
00:02:06,220 --> 00:02:10,050
...بصراحة، الشّخص الّذي أحبّه هو

27
00:02:10,400 --> 00:02:14,210
سأعطيكِ بضع لمحات، ويمكنكِ
محاولة التّخمين

28
00:02:14,210 --> 00:02:17,700
ماذا؟ سوف نفعل هذا على طريقة
مسابقة أسئلة؟ لماذا؟

29
00:02:18,310 --> 00:02:23,160
آسفة. كلّ ما في الأمر أنّه
...من الصّعب مناقشة الموضوع

30
00:02:24,010 --> 00:02:28,380
في أواخر أبريل، أتى والدايّ إليّ

31
00:02:28,380 --> 00:02:33,920
وأخبراني بأنّ شخصاً من خارج البلاد
سوف يأتي ويقيم معنا

32
00:02:36,090 --> 00:02:37,160
شكراً

33
00:02:37,720 --> 00:02:39,780
،أنا مجرّد طفلة

34
00:02:39,780 --> 00:02:44,140
لذا فكرة مجيء فتى غريب للإقامة
معنا لم تلائمني حقّاً

35
00:02:44,500 --> 00:02:46,330
معكِ حقّ

36
00:02:46,330 --> 00:02:50,600
العيش تحت سقف واحد مع شخص
لا تعرفينه... حتّى أنا كنتُ لأرفض ذلك

37
00:02:51,060 --> 00:02:53,220
حسناً، من أين هو؟

38
00:02:53,220 --> 00:02:57,980
إنّه مُواطن إنجليزيّ، لكنّه نصف يابانيّ

39
00:02:58,360 --> 00:03:02,450
عمره 19 عام. ولغته اليابانيّة ممتازة

40
00:03:03,680 --> 00:03:04,920
كيوكو-سان

41
00:03:05,780 --> 00:03:09,000
هل يذكّركِ كلّ ذلك بشخص؟

42
00:03:10,270 --> 00:03:11,280
يذكّرني؟

43
00:03:12,870 --> 00:03:16,670
مهلاً. هل هذا يعني بأنّني
أعرف هذا الشّخص؟

44
00:03:17,720 --> 00:03:18,470
لحظة

45
00:03:19,030 --> 00:03:20,470
!هو؟

46
00:03:20,470 --> 00:03:24,090
الصّاعد الخارق الّذي صار
!حديث النّاس في م.ف.ج؟

47
00:03:24,090 --> 00:03:25,640
تخمينك صحيح

48
00:03:30,710 --> 00:03:34,300
يا للعجب! أيّ شابّ أُعجِبتِ به هو هذا؟

49
00:03:35,200 --> 00:03:37,850
إنّه لطيف إذاً؟

50
00:03:38,220 --> 00:03:41,780
كافّة سائقي م.ف.ج يبدو
نرجسيّين في نظري

51
00:03:42,240 --> 00:03:44,260
أظنّه لطيفاً حقّاً

52
00:03:44,610 --> 00:03:48,680
إنّه لطيف وبريء، وناضج أيضاً

53
00:03:48,680 --> 00:03:54,170
أحياناً، يبدو كشخص رزين، وفي أحيان
أخرى، يكون ظريفاً كطفل

54
00:03:54,840 --> 00:03:59,800
كنتُ أعتقد بأنّ العيش معه كان
،ليساعدني في رؤية كافّة خطاياه

55
00:04:00,190 --> 00:04:04,970
،لكن لم أرَ شيئاً يغيّر رأيي. على العكس
ازداد إعجابي به أكثر

56
00:04:05,490 --> 00:04:09,500
وبالنّظر إلى عقد الملائكة، أنا
في وضع شائك، أليس كذلك؟

57
00:04:09,500 --> 00:04:10,930
لا أعتقد ذلك

58
00:04:11,380 --> 00:04:14,230
وقوعكِ في حبّه ليس بيدكِ

59
00:04:14,680 --> 00:04:19,900
فضلاً عن ذلك، ليس وكأنّكِ تعرّفتِ
عليه من خلال العمل

60
00:04:20,500 --> 00:04:26,230
شاء القدر أن يصبح أحد معارفكِ في حياتكِ
الخاصّة سائقاً في م.ف.ج

61
00:04:26,570 --> 00:04:30,070
لا أعتقد بأنّ هذا يُخالف بنود العقد

62
00:04:30,070 --> 00:04:32,080
أوتظنّين ذلك؟

63
00:04:32,080 --> 00:04:36,680
لكن حاليّاً، لنُبقِ الأمر بيني وبينكِ فقط

64
00:04:37,230 --> 00:04:37,960
حسناً

65
00:04:38,330 --> 00:04:41,080
ما كنتُ لأقلق بشأن كلّ تلك الأمور الأخرى

66
00:04:41,080 --> 00:04:46,750
تصرّفي كما تتصرّف أيّ تلميذة
ثانويّة أمام شخص تحبّه فحسب

67
00:04:48,010 --> 00:04:52,000
وإذا وقع مكروه، سوف أساندكِ

68
00:04:52,000 --> 00:04:54,220
الوقِحون سابقاً مُخيفون

69
00:04:54,540 --> 00:04:58,930
حسناً، أنا مُعحبة به في نهاية المطاف، لذا
...لا أعلم ما إن سأحتاج مساعدة كهذه

70
00:05:00,710 --> 00:05:03,280
أنا مسرورة حقّاً لأنّنا تمكنّا
من التكلّم يا كيوكو-سان

71
00:05:03,280 --> 00:05:05,570
هذا يُثقِل كاهلي حقّاً

72
00:05:06,400 --> 00:05:08,790
أربعة أيّام حتّى الحدث الأخير؟

73
00:05:08,790 --> 00:05:10,030
أجل

74
00:05:10,660 --> 00:05:13,330
شبه الجزيرة مُزعجة في كلّ عام

75
00:05:13,330 --> 00:05:15,800
فجدول الأعمال يكون فوضويّاً دوماً

76
00:05:15,800 --> 00:05:18,290
،إنّنا في منتصف الموسم الماطر
لذا لا شيء مُستغرَب

77
00:05:19,280 --> 00:05:21,380
أنا قلقة بعض الشّيء بصراحة

78
00:05:21,380 --> 00:05:25,120
ماذا لو تقاطع سِباقي مع امتحانات
نهاية الفصل خاصّتي؟

79
00:05:26,990 --> 00:05:30,790
إذا كانت مرحلة تصفيات، فأنا متأكّدة بأنّني
،أستطيع إيجاد شخص يناوب عنّي

80
00:05:31,100 --> 00:05:34,220
لكن قالوا لي بأنّني لا يجوز أن أُفوّت
السّباقات مهما كان السّبب

81
00:05:34,220 --> 00:05:38,600
يعني ذلك بأنّني سأضطرّ للخضوع
لامتحان تعويضيّ. هذا كابوس

82
00:05:38,600 --> 00:05:42,560
حسبما يبدو، الملاك وتلميذة ثانويّة
في نفس الوقت تُواجه تحدّيات إضافيّة

83
00:05:46,040 --> 00:05:48,290
إنّها اللّحظة الّتي كنتم تنتظرونها

84
00:05:48,290 --> 00:05:53,450
،سِباق م.ف.ج الثّالث في الموسم
شبه جزيرة مانازورو، على وشك البدء

85
00:05:54,170 --> 00:05:57,540
طول المضمار هو 17.4 كم
وهو سِباق بخمس لفّات

86
00:05:58,050 --> 00:06:01,110
،مع جسر يمتدّ فوق البحر وثلاثة أنفاق

87
00:06:01,110 --> 00:06:05,510
مُخطّط مُعقَّد يتقاطع فيه المضمار
في أربعة أماكن

88
00:06:05,910 --> 00:06:09,640
،خليط من الطّرُق السّريعة جدّاً وأخرى فائقة السّرعة

89
00:06:09,640 --> 00:06:15,970
الرّوعة البصريّة للمناطق الحضريّة في مانازورو
تجعلها شهيرة لدى مُتابعي م.ف.ج

90
00:06:21,610 --> 00:06:27,460
حقيقة انطلاقتي في اليوم الأوّل عقب الحلول
بشكل مُتكرّر في المركز الأخير مُهينة

91
00:06:28,280 --> 00:06:32,160
سيترتّب عليّ التحلّي
بروح التحدّي من جديد

92
00:06:32,160 --> 00:06:34,330
أطمح للقمّة

93
00:06:41,380 --> 00:06:45,430
لن أنتهج نهجاً يجعلني أتشارك
معه في السّباق بعد الآن

94
00:06:45,880 --> 00:06:48,800
يتحسّن أداء نوزومي في السّباق

95
00:06:48,800 --> 00:06:51,720
أنا الّذي يُعاني من اضطراب

96
00:06:52,000 --> 00:06:53,510
لذا هيّا يا لوتس

97
00:06:53,990 --> 00:06:57,190
.مانازورو هي مُباراة جيّدة لنا
!لنقلب الموازين

98
00:06:58,410 --> 00:07:02,010
يبدأ كلّ سائق بمُعالجته الخاصّة للسّباق

99
00:07:02,010 --> 00:07:06,090
في معركة البقاء والصّمود
!لمدّة سبعة أيّام اليوم

100
00:07:23,760 --> 00:07:25,910
العبور شبه مستحيل في مانازورو

101
00:07:26,280 --> 00:07:31,880
،إذا تراجعت مركزاً في المرحلة التّأهيليّة
فالتّعويض من جديد في السّباق تعجيزيّ

102
00:07:32,320 --> 00:07:37,850
ونظراً إلى أنّني لم أحصد أي نقطة
في أشينوكو، هذا السّباق حسّاس بالنّسبة لي

103
00:07:38,150 --> 00:07:40,140
أنا مُتعطّش للفوز

104
00:07:42,180 --> 00:07:43,280
رائع

105
00:07:43,800 --> 00:07:45,730
لامبورغيني هوراكان

106
00:07:45,960 --> 00:07:48,020
جامح ومُثير

107
00:07:49,360 --> 00:07:50,990
إنّه دورك غداً

108
00:07:51,280 --> 00:07:54,790
تأخّرتَ في ترتيب الانطلاق
في المرّتين السّابقتين

109
00:07:54,790 --> 00:07:57,120
هل من الصّعب البدء بانطلاقتك
في وقت أسرع؟

110
00:07:57,120 --> 00:08:00,620
لا أعتقد ذلك. لا فرق بالنّسبة للي

111
00:08:00,890 --> 00:08:04,330
أتحضّر قدر المستطاع وذلك كي أبلي
بلاء جيّداً في عملي

112
00:08:04,900 --> 00:08:10,070
انطلاقتي في وقت سابق أو لاحق
لا ينبغي أن يؤثّر على أدائي

113
00:08:10,830 --> 00:08:13,550
هل أنا أتوهّم أم أنّك تتطلّع قُدماً إلى هذا؟

114
00:08:13,790 --> 00:08:18,260
أجل. يبدو أنّ التّربين الخاصّ بـ 86
قد تحسّن بصورة واضحة

115
00:08:18,870 --> 00:08:23,730
حمّسني ذلك. لا أطيق انتظار القيادة
في مضمار مانازورو

116
00:08:24,250 --> 00:08:26,770
،لا أعلم ما إن كنتُ مُندهشاً أم لا

117
00:08:27,000 --> 00:08:29,200
لكن عقليّة هذا الفتى رهيبة

118
00:08:30,270 --> 00:08:36,320
يجب عليّ أن أصبح أقوى من تلك النّاحية
إذا أردتُ أن أكون شريكاً جيّداً لكاناتا

119
00:08:45,340 --> 00:08:48,500
لم يُراسلني كاتاغيري-كن أبداً

120
00:08:53,880 --> 00:08:56,260
الانطلاق في اليوم الثّاني سيّئ

121
00:08:56,640 --> 00:08:58,760
ليست لديك مؤشّرات تطمح لها

122
00:08:58,760 --> 00:09:01,170
،يجب أن تكون خشناً

123
00:09:01,170 --> 00:09:04,100
لكن أخشى أن أفقد الثّبات إذا شكّلتُ
ضغطاً زيادة عن اللّزوم

124
00:09:29,130 --> 00:09:31,090
سوف أغادر

125
00:09:31,510 --> 00:09:36,800
لحظة يا كاناتا، ستذهب إلى العمل اليوم؟
ماذا عن تصفيات م.ف.ج؟

126
00:09:36,800 --> 00:09:40,390
أحاول أن أكون مرناً في أيّام عطلتي

127
00:09:40,840 --> 00:09:43,220
وفي ظلّ هذه الأمطار، هكذا تجري الأمور

128
00:09:51,320 --> 00:09:53,480
هل هناك موسمٌ ماطر في إنجلترا أيضاً؟

129
00:09:53,480 --> 00:09:56,730
أجل. يوجد شيء كهذا بالتّأكيد في إنجلترا

130
00:09:57,070 --> 00:10:01,600
عادة يبدأ في سبتمبر وينتهي
في مارس تقريباً

131
00:10:02,820 --> 00:10:05,500
فترة طويلة جدّاً! يدوم سبعة أشهر؟

132
00:10:05,820 --> 00:10:10,610
إنّها لا تُمطر كلّ يوم، لكن نادراً
ما نرى الشّمس أيضاً

133
00:10:11,000 --> 00:10:15,330
مقارنة بذلك، اليابان هي بلد
حيث الشّمس المُشرِقة وكثير من المياه

134
00:10:15,330 --> 00:10:18,720
أفهم ما تعنيه بشأن الشّمس، لكن
شوّشتني بمسألة المياه

135
00:10:19,030 --> 00:10:22,880
،قد يكون من الصّعب عليكِ الاستيعاب
بما أنّكِ ترعرعتِ هنا

136
00:10:22,880 --> 00:10:25,060
الماء ثمين في إنجلترا

137
00:10:25,390 --> 00:10:27,480
ضغط المياه في الحمّامات ضعيف

138
00:10:27,480 --> 00:10:31,520
ويجب أن تكوني حريصة وإلّا نفد الخزّان

139
00:10:31,970 --> 00:10:35,980
فكرة الغطس في حوض استحمام
كما تفعلون في اليابان غير واردة

140
00:10:37,180 --> 00:10:39,380
إنجلترا أقلّ حيويّة ممّا تصوّرت

141
00:10:39,380 --> 00:10:41,950
لا. بل اليابان هي المُميّزة

142
00:10:42,280 --> 00:10:46,750
لا أعلم ما إن كان هناك بلد آخر
في اليابان يتنعّم بالماء مثل اليابان

143
00:10:47,570 --> 00:10:50,790
هل تحبّ اليابان يا كاناتا؟

144
00:10:51,120 --> 00:10:54,130
بالطّبع. أعشق هذا المكان

145
00:10:54,760 --> 00:11:00,010
لكن الأهمّ من ذلك، أظنّني
أعشق الشّعب اليابانيّ

146
00:11:03,970 --> 00:11:10,450
أعتقد سأغيب عن الوعي إذا قال
أحبّك يا رين" بنفس الطّريقة"

147
00:11:12,900 --> 00:11:14,350
شبح م.ف

148
00:11:18,440 --> 00:11:20,070
شبح م.ف

149
00:11:21,380 --> 00:11:23,580
مضى يومان، وهنا في شبه
،جزيرة مانازورو

150
00:11:23,580 --> 00:11:26,490
الجوّ غائم جزئيّاً

151
00:11:27,190 --> 00:11:32,460
صباح الخير إلى كافّة مُعجبي م.ف.ج
البالغ عددهم 30.35 مليون حول العالم

152
00:11:32,890 --> 00:11:35,170
أنا مُعلّقكم، تاناكا يوجي

153
00:11:35,580 --> 00:11:39,550
اليوم الثّالث المُنتظَر طويلاً من المُنافسة
الزمنيّة على وشك البدء

154
00:11:39,550 --> 00:11:43,390
ونجم اليوم لا بدّ أن يكون السيّارة 86

155
00:11:43,390 --> 00:11:49,560
هذا الصّاعد الّذي يخوض الآن سِباقه الثّالث في المركز
الخامس ضمن التّصنيف بعد هاكوني وأشينوكو

156
00:11:49,560 --> 00:11:52,190
،مانازورو هي مضمار شوارع

157
00:11:52,190 --> 00:11:55,740
وأتطلّع قُدماً إلى الأداء الّذي سيُقدّمه

158
00:11:56,180 --> 00:11:57,970
مرحباً يا كاناتا

159
00:11:57,970 --> 00:11:59,480
مرحباً يا نوزومي

160
00:11:59,700 --> 00:12:01,190
أحضرتُ لك شيئاً

161
00:12:02,080 --> 00:12:04,820
تفضّل. هديّة صغيرة

162
00:12:05,530 --> 00:12:06,860
ما هي؟

163
00:12:06,860 --> 00:12:08,130
افتحها

164
00:12:10,940 --> 00:12:14,170
!كم هي جميلة! وجذّابة

165
00:12:14,390 --> 00:12:18,800
إنّها تميمة من مزار هاكوني. الإله هناك
يُهيمن على المُنافسات حسبما يُزعَم

166
00:12:19,060 --> 00:12:23,900
أنا وأخي الأحمق دائماً ما نزوره
قبل كلّ سباق

167
00:12:24,300 --> 00:12:27,100
بهذه التّميمة، سيمدّك ذلك الإله بالقوّة

168
00:12:27,420 --> 00:12:29,110
حظّاً سعيداً يا كاناتا

169
00:12:29,110 --> 00:12:30,660
شكراً يا نوزومي

170
00:12:30,660 --> 00:12:34,000
لا أعرف ماذا أقول. أنا متأثّر

171
00:12:34,570 --> 00:12:38,030
لكن لماذا؟ نحن مُتنافسان

172
00:12:38,030 --> 00:12:39,190
أوتظنّ ذلك؟

173
00:12:39,660 --> 00:12:42,070
،قد نكون مُتنافسين في المضمار

174
00:12:42,070 --> 00:12:46,660
لكنّنا أيضاً شريكان نحاول جعل
م.ف.ج شيئاً عظيماً، صحيح؟

175
00:12:46,660 --> 00:12:51,120
شريكان"؟ يا لها من روح يابانيّة مُفعمة"

176
00:12:51,440 --> 00:12:54,550
شكراً يا نوزومي. حظّاً سعيداً لك أيضاً

177
00:12:55,770 --> 00:12:59,040
عجباً! إنّه يجذب كلّ الفتيات. كم أغار منه

178
00:13:01,870 --> 00:13:04,510
ارتأيتُ أن أمرّ فحسب يا كاناتا

179
00:13:05,280 --> 00:13:06,760
!آيبا-سينباي

180
00:13:06,760 --> 00:13:10,830
لماذا تظهر في كلّ انطلاقة مرحلة تأهيليّة
من انطلاقات كاناتا يا شون؟

181
00:13:19,050 --> 00:13:21,840
وصلت 86 إلى البوّابة

182
00:13:22,800 --> 00:13:25,150
عشر ثوانٍ حتّى تبدأ انطلاقته

183
00:13:25,150 --> 00:13:27,660
أوغاتا يتكلّم. تفقّد الرّاديو

184
00:13:27,980 --> 00:13:28,980
يعمل بصورة سليمة

185
00:13:29,480 --> 00:13:34,960
أنا متأكّدٌ بأنّك تعلم، لكن الجزء الأصعب
هو الجسر والنّفق بالقرب من البداية

186
00:13:35,270 --> 00:13:39,690
ستكون رؤيتك معدومة، لذا توخّ
أقصى درجات الحذر. حوّل

187
00:13:40,070 --> 00:13:40,880
عُلِم

188
00:13:41,890 --> 00:13:44,630
إذاً هذا هو الشّخص الّذي تحبّه رين-تشان؟

189
00:13:44,630 --> 00:13:47,590
تسعة. ثمانية. سبعة

190
00:13:47,590 --> 00:13:51,590
ستّة. خمسة. أربعة. ثلاثة

191
00:13:47,590 --> 00:13:51,590
،الآن بعد أن تمعّنتُه جيّداً
قد يكونان مُناسبين لبعضهما البعض

192
00:13:51,590 --> 00:13:53,460
اثنان. واحد

193
00:13:56,100 --> 00:14:01,440
وها هو ذا! بدأت انطلاقة كاتاغيري
!كاناتا في شبه الجزيرة

194
00:14:01,970 --> 00:14:05,070
هذا يدفعني لتشجيع ذلكما العاشقين الصّغيرين

195
00:14:05,610 --> 00:14:08,030
بالتّوفيق أيُّها الوسيم

196
00:14:08,620 --> 00:14:10,490
هل بدأت انطلاقة كانا-تشان؟

197
00:14:10,910 --> 00:14:14,900
كالعادة، لن أتفرّج، لذا أخبرني بالنّتيجة

198
00:14:14,900 --> 00:14:15,950
بالتّأكيد

199
00:14:16,240 --> 00:14:18,460
!وبشكل شبه فوريّ، إنّه النّفق

200
00:14:18,460 --> 00:14:23,210
،في حين أنّ النّفق يكون مُنيراً عادةً
إلّا أنّ الإضاءة مُطفأة عمداً

201
00:14:23,450 --> 00:14:24,560
!يا للهول

202
00:14:24,560 --> 00:14:29,930
مُنبثِقاً من الظّلام إلى النّور، إلى
!القسم الأسود والأبيض المُميّز

203
00:14:29,930 --> 00:14:31,870
المشهد مُبهر وبرّاق عندما تخرج

204
00:14:31,870 --> 00:14:37,020
حتّى في يوم غائم كاليوم، نظرة واحدة
للشّمس قد تعميك بشكل مُؤقّت

205
00:14:37,020 --> 00:14:39,730
،لا تكون هذه مُشكلة عند القيادة بصورة طبيعيّة

206
00:14:39,730 --> 00:14:44,000
لكن بأقصى سرعة، سرعان ما ستصطدم
بمُنعطفات بعد الخروج من النّفق

207
00:14:44,000 --> 00:14:48,280
انعدام الرّؤية في وضع كهذا
كافية لإخافة السّائق

208
00:14:48,800 --> 00:14:51,010
وما يعقب ذلك أشدّ رُعباً

209
00:14:51,320 --> 00:14:55,660
،حالما تتكيّف عينا السّائق مع الضّوء
يظهر النّفق الثّاني

210
00:14:55,660 --> 00:15:01,040
كوحش يفتح فمه المُظلم ويؤدّي
مباشرة نحو الجحيم

211
00:15:01,040 --> 00:15:02,960
هذا صعب بعض الشّيء أيضاً

212
00:15:02,960 --> 00:15:07,420
في جي.تي.آر، بلغتُ سرعة 200 كيلومتر
بانزلاق العجلات الأربع كلّها عمليّاً

213
00:15:07,970 --> 00:15:13,010
إذا أخطأتَ مسارك ولو قليلاً
،بعد تلك التّعمية

214
00:15:13,010 --> 00:15:15,470
فقد تحدث كارثة في ظلام دامس

215
00:15:19,130 --> 00:15:21,730
يبدو أنّ إسراعه بهذا الشّكل
لا يُمثّل مُشكلة بالنّسبة له

216
00:15:22,080 --> 00:15:27,150
حـ-حسناً، قد لا يكون هذا أمراً جللاً
بالنّسبة لشخص بمستوى كاناتا

217
00:15:27,150 --> 00:15:28,610
لا أدري ما إن كان يروقني ذلك

218
00:15:29,080 --> 00:15:31,990
!يُعرَف هذا بطريق منتصف اللّيل المستقيم

219
00:15:31,990 --> 00:15:36,950
في مخرج النّفق، نصل إلى أقصى
!السّرعات في المضمار

220
00:15:36,950 --> 00:15:39,070
،وبعد الخروج منه بأقصى سرعة

221
00:15:39,070 --> 00:15:43,880
نصطدم بمُنعطف على شكل حرف أس فائق
!السّرعة يُرعِب كلّ مُتسابق م.ف.ج

222
00:15:43,880 --> 00:15:46,210
!يُطلِقون عليه باسم أوروجيه

223
00:15:48,620 --> 00:15:52,060
أوّل منعطف أيمن أشدّ على ما يبدو

224
00:15:52,060 --> 00:15:55,050
عند الولوج إليه بسرعة، فلا يمكن
استعادة السّيطرة في الوقت

225
00:15:56,820 --> 00:15:59,430
هذا سيّئ يا كاناتا. أنت تُسرع
زيادة عن اللّزوم

226
00:16:09,780 --> 00:16:14,670
أرأيت؟ انطلقَ مُلتصقاً بالجهة الدّاخليّة نحو
!الانسياب عبر السّور الخارجيّ

227
00:16:14,670 --> 00:16:17,670
كادت تُصيبني نوبة قلبيّة

228
00:16:17,670 --> 00:16:23,870
بلوغ الحدّ الأقصى من قوّة الجاذبيّة الجانبيّة
!يجعل الحركة الانحداريّة يُبطلها

229
00:16:24,170 --> 00:16:26,370
،لا أعلم مَن أوّل من أشار إلى ذلك

230
00:16:26,370 --> 00:16:29,760
لكن يُفترض بأنّ هذا يُشبه أوروجيه
!في دي سبا فرانكورشومب

231
00:16:30,290 --> 00:16:34,970
وتقول لي بأنّ كاناتا عبر من هناك
من دون مشاكل؟

232
00:16:34,970 --> 00:16:38,180
!تجتاز 86 أوروجيه بيسر وسهولة

233
00:16:38,180 --> 00:16:41,020
!لم يُظهِر مثل هذه السّرعة من قبل

234
00:16:42,080 --> 00:16:46,950
يمتدّ المضمار من هذا الطّريق البحريّ
إلى طريق داخليّ

235
00:16:46,950 --> 00:16:51,530
،كان خليج ساغامي على يمينه سابقاً
لكن سيصبح على يساره قريباً

236
00:16:54,300 --> 00:16:57,990
وهذه انعطافة بفرامل اليد
!مُبهرة بواسطة 86

237
00:16:57,990 --> 00:17:00,740
عند نقطة العبور، إنّه يسعى
!لدخول المركز الثّالث مؤقّتاً

238
00:17:01,010 --> 00:17:02,200
أيُعقَل هذا؟

239
00:17:02,200 --> 00:17:06,450
،ذكرتَ بأنّك ركّبت تربيناً للسيّارة
صحيح؟ 400؟ 500؟

240
00:17:06,450 --> 00:17:07,710
300

241
00:17:07,710 --> 00:17:10,000
!ماذا؟! لديه 300 قوّة حصانيّة فقط؟

242
00:17:10,600 --> 00:17:12,260
!يا للهول يا كاناتا

243
00:17:12,540 --> 00:17:16,470
أهذا ما يستطيع فارق 100 قوّة
حصانيّة إضافيّة فعله لك؟

244
00:17:16,470 --> 00:17:22,320
غزوتَ قسم الأبيض والأسود بمستوى
لم يُحقّقه أحدٌ آخر من قبل

245
00:17:22,320 --> 00:17:23,430
أوغاتا يتكلّم

246
00:17:23,430 --> 00:17:25,440
أنت في المركز الثّالث الآن. حوّل

247
00:17:25,760 --> 00:17:29,520
عُلِم. تربين السيّارة 86 لم يستعرض
قدراته الحقيقيّة بعد

248
00:17:29,960 --> 00:17:30,980
عذراً؟

249
00:17:32,750 --> 00:17:35,900
يرتفع المضمار الآن برفق نحو
محطّة مانازورو القديمة

250
00:17:36,670 --> 00:17:39,430
!وتصعد السيّارة 86 الطّريق بعزم

251
00:17:39,430 --> 00:17:43,870
من الواضح أنّ هذا لم يعُد مُحرّك تنفُّس
!طبيعيّ بعد الآن! إنّه مشحون بالتّربين

252
00:17:43,870 --> 00:17:49,380
يبدو أنّ كاتاغيري كاناتا و 86
!يمتلكان قوّة أكبر أخيراً

253
00:17:49,690 --> 00:17:52,430
!ثمّ ينعطف يميناً عند محطّة مانازورو القديمة

254
00:17:52,930 --> 00:17:56,550
،يا للهول! اعتباراً من نقطة العبور تلك
!إنّه حالياً في المركز الثّاني

255
00:17:56,550 --> 00:17:59,510
!إنّه يتخطّى أويشي في السيّارة 3

256
00:17:59,510 --> 00:18:02,970
!يستمرّ كاتاغيري كاناتا في الهجوم

257
00:18:02,970 --> 00:18:05,430
!إنّه أسرع من لامبو

258
00:18:05,430 --> 00:18:09,980
!فيما يلي نُواة مضمار شبه الجزيرة هذه

259
00:18:10,360 --> 00:18:14,940
،المُحارب الشّاب، كاتاغيري كاناتا
!يواجه متاهة حصينة

260
00:18:15,210 --> 00:18:19,410
استعرضت 86 إتقاناً لا نظير له
للأقسام الفنّية حتّى الآن

261
00:18:19,410 --> 00:18:22,980
هل أصبح إيشيغامي الّذي في المركز
الأوّل ضمن مرآه بالفعل؟

262
00:18:28,310 --> 00:18:32,580
هذا أكثر شيء مذهل في كاناتا

263
00:18:32,900 --> 00:18:38,080
إنّها المرّة الأولى له، لكن الطّرُق أمامه حادّة جدّاً
ولا يتردّد في الضّغط على دوّاسة الوقود

264
00:18:38,800 --> 00:18:42,950
يستطيع الاحتساب لمُنعطفين اثنين
عقب المُنعطف الّذي يسلكه

265
00:18:43,280 --> 00:18:45,900
...الشّيء الّذي لا يمكنني تقليده أبداً

266
00:18:46,120 --> 00:18:49,980
مهما أردتُ ذلك بشدّة. لأنّني أحمق

267
00:18:55,320 --> 00:18:58,930
إنّه يخترق الطّرُق الضيّقة للمنطقة السّكنيّة
!كما تسبح سمكة في الماء

268
00:18:58,930 --> 00:19:01,250
!سريع جدّاً! سريع بعزم

269
00:19:01,690 --> 00:19:05,350
عند هذه النّقطة، يبلغ المضمار
مستوى البحر

270
00:19:05,350 --> 00:19:09,230
.إنّها أيضاً نقطة العبور التّالية
ماذا سوف نرى؟

271
00:19:09,230 --> 00:19:13,670
كم بقي له حتّى يبلغ القمّة؟

272
00:19:16,070 --> 00:19:20,630
!ها هو ذا! ها قد بلغ قمّة الزّمن المُؤقّت

273
00:19:22,090 --> 00:19:26,060
رغم بلوغه القمّة، لا يُبدي 86
!أي إشارة للتّباطؤ

274
00:19:26,310 --> 00:19:30,600
إنّه عازم على توسيع الهامش بينه
!وبين السيّارة 1

275
00:19:31,010 --> 00:19:33,080
هذا هو اليوم الثّالث من المرحلة التّأهيليّة فقط

276
00:19:33,080 --> 00:19:36,840
،سنرى الشّخصيّات البارزة في م.ف.ج لاحقاً

277
00:19:36,840 --> 00:19:42,570
ولا شكّ في أنّ الزّمن الّذي حقّقته 86
!سيكدّس مزيداً من الضّغط عليهم

278
00:19:43,290 --> 00:19:46,060
هل ينبغي أن أخبره يا شون؟

279
00:19:46,060 --> 00:19:47,690
لا داعي غالباً

280
00:19:47,690 --> 00:19:50,850
يتمتّع كاناتا بعقليّة تُشبه
عقليّة سوبّر ألّوي زد

281
00:19:51,390 --> 00:19:54,150
أوغاتا يتكلّم. أنت في القمّة حاليّاً

282
00:19:54,150 --> 00:19:56,670
أنا مُندهش، لكن لا تُبالغ كثيراً، مفهوم؟

283
00:20:00,050 --> 00:20:02,090
...كما قلتُ من قبل

284
00:20:02,600 --> 00:20:05,550
إنّه الأكثر رُعباً هناك

285
00:20:08,360 --> 00:20:13,390
هذا لا يعني إلّا أنّه توجد ذُبابة
أخرى مُزعجة تطير حول وجهي

286
00:20:13,960 --> 00:20:17,610
،ومثل ساواتاري تماماً، إذا أزعجني
فسوف أسحقه

287
00:20:17,970 --> 00:20:23,280
تخرج السيّارة 86 من منطقة شبه الجزيرة
وتدخل إلى المنطقة الدّاخليّة

288
00:20:23,590 --> 00:20:28,740
،إنّه يُحافظ على خُطاه ووتيرته
لكن هذا ليس كلّ شيء

289
00:20:28,740 --> 00:20:31,830
وبكسر الرّقم القياسيّ لمنطقة شبه
،الجزيرة بفارق كبير

290
00:20:31,830 --> 00:20:35,920
فهو بالتّأكيد في طريقه إلى كسر
الرّقم القياسيّ للمضمار كذلك

291
00:20:37,380 --> 00:20:39,830
!الرّقم القياسيّ للمضمار؟

292
00:20:42,160 --> 00:20:47,220
!ما زال كاتاغيري كاناتا يُشكّل تهديداً
!المُتحدّي من إنجلترا ليس ندّاً سهلاً

293
00:20:47,760 --> 00:20:51,430
يُثبت تلميذ فوجيوارا تاكومي
بأنّه خطر حقيقيّ

294
00:20:51,790 --> 00:20:55,110
لكن هذا ما وُجِد لأجله

295
00:21:01,160 --> 00:21:04,140
!تستمرّ 86 في إشعال عجلاتها

296
00:21:06,230 --> 00:21:11,740
حتّى الهاوي يستطيع أن يعرف بأنّ كاتاغيري
!كاناتا يقود في المضمار بخبرة كبيرة

297
00:21:12,160 --> 00:21:15,200
حافظ على الخُطى الّتي يحتاجها
،لكسر الرّقم القياسيّ للمضمار

298
00:21:15,670 --> 00:21:17,660
وثمّة نفق أخير ينتظر

299
00:21:18,140 --> 00:21:22,480
!حالما يعبر، سيبلغ خطّ النّهاية

300
00:21:23,710 --> 00:21:27,820
أهذه هي؟ هل سنشهد رقماً قياسيّاً
!جديداً في مضمار؟

301
00:21:27,820 --> 00:21:30,850
!إنّه يقود كإله شيطانيّ

302
00:21:37,270 --> 00:21:42,690
صدمَتْنا تويوتا 86 جي.تي جميعنا
!بكسر رقم المضمار القياسيّ

303
00:21:45,110 --> 00:21:51,960
حفر كاتاغيري كاناتا اسمه
!في تاريخ م.ف.ج

304
00:23:31,260 --> 00:23:36,040
الحلقة القادمة: ثمن الشّجاعة