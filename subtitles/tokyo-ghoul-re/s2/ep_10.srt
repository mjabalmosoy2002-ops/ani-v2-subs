1
00:00:27,460 --> 00:00:28,750
.توكا-تشان

2
00:00:30,510 --> 00:00:31,590
أين الجميع؟

3
00:00:34,220 --> 00:00:35,390
.عليّ المغادرة

4
00:00:36,340 --> 00:00:37,600
.عليّ العودة

5
00:01:21,010 --> 00:01:22,350
.عليّ المغادرة

6
00:01:30,150 --> 00:01:31,480
.توكا-تشان

7
00:02:06,350 --> 00:02:07,600
ما كان هذا؟

8
00:02:16,820 --> 00:02:20,490
أين أنت ذاهب أيّها القاتل؟

9
00:03:52,290 --> 00:03:53,880
.حيث يتواجد الآخرون

10
00:03:54,920 --> 00:03:56,170
.عليّ إنقاذهم

11
00:04:04,260 --> 00:04:07,010
!ساعدوني! ساعدوني

12
00:04:08,640 --> 00:04:11,600
!لا، توقّف، أوقف هذا

13
00:04:13,440 --> 00:04:16,520
.أبقِ على طفلي رجاءً

14
00:04:28,330 --> 00:04:29,490
...أهؤلاء

15
00:04:30,120 --> 00:04:31,330
.أجل

16
00:04:32,160 --> 00:04:34,540
.إنّها أصوات من قتلتهم

17
00:04:38,840 --> 00:04:40,460
.لم أقصد حصول هذا

18
00:04:41,460 --> 00:04:43,340
حماية الجميع؟

19
00:04:44,130 --> 00:04:47,800
خلق عالمٍ يمكن فيه لكلٍّ من البشر
والغيلان فهم بعضهم بعضًا؟

20
00:04:56,730 --> 00:04:59,610
.مات أولئك الناس نتاجَ أفعالك

21
00:05:02,280 --> 00:05:04,700
.وجب عليك أن تترك الأمور كما هي عليه

22
00:05:05,700 --> 00:05:07,030
.منذ البداية

23
00:05:18,630 --> 00:05:19,790
.انظر

24
00:05:21,340 --> 00:05:26,180
.من قتلتهم يغمرون المحيط

25
00:05:29,890 --> 00:05:31,350
.صحيح

26
00:05:32,310 --> 00:05:35,730
.لا يعنيك إن مات الآخرون أم لا

27
00:05:39,560 --> 00:05:41,110
...لم أدرك

28
00:05:42,480 --> 00:05:44,360
.أنّ هذا ما سيحصل ...

29
00:05:45,950 --> 00:05:50,370
.لا يهمّ إذًا لو قتلت الناس جهلًا أو من غير قصد

30
00:05:50,370 --> 00:05:51,410
.لا

31
00:05:52,330 --> 00:05:55,160
كيف تمكّنت من فعل ذلك إذًا؟

32
00:05:55,450 --> 00:05:57,160
ألأنّك متوحش؟

33
00:05:57,160 --> 00:05:58,580
.لا

34
00:05:58,580 --> 00:06:00,500
أوتحسب نفسك شخصًا طيبًا؟

35
00:06:01,500 --> 00:06:02,840
.غير صحيح

36
00:06:03,340 --> 00:06:05,800
أنت سيّءٌ إذًا؟

37
00:06:06,720 --> 00:06:08,090
.لا أعلم

38
00:06:09,300 --> 00:06:11,970
أكنت تقاتل دون علمٍ إذًا؟

39
00:06:14,890 --> 00:06:15,890
...أنا

40
00:06:17,690 --> 00:06:20,060
.أردت أن يحتاجني أحدٌ ما ...

41
00:06:22,060 --> 00:06:26,900
.منذ أن قدّم لي يوشيمورا-سان القهوة في الأنتيك

42
00:06:27,900 --> 00:06:29,700
.اتّسع عالمي أكثر

43
00:06:32,370 --> 00:06:34,540
.صادقت غيلانًا أكثر

44
00:06:36,410 --> 00:06:38,000
،وحتّى بعد أن أصبحت هايسي

45
00:06:38,710 --> 00:06:43,710
.اختارني كلّ من أريما-سان وإيتو-سان

46
00:06:45,760 --> 00:06:49,930
.بقيت توكا-تسان بجانبي

47
00:06:54,970 --> 00:06:57,850
.انتابني شعورٌ بأنّي شخصٌ مرغوب به

48
00:06:59,270 --> 00:07:00,560
.أسعدني هذا

49
00:07:03,440 --> 00:07:08,610
.توهّمت حقًا أنّ بمقدوري أن أنتمي لعالمين

50
00:07:10,780 --> 00:07:12,490
.الأمر كما أسلفتِ وحسب

51
00:07:13,320 --> 00:07:15,160
.لم أهتمّ بالآخرين

52
00:07:16,660 --> 00:07:19,750
.لم أهتمّ بالغاية حقًا

53
00:07:21,170 --> 00:07:26,300
ظننت أنّي طالما أواصل القتال
.سيحتاجني أحدٌ ما

54
00:07:29,670 --> 00:07:33,430
أتذكر حين قلت أنّك لم تكرهني؟

55
00:07:36,850 --> 00:07:39,270
.أنا أكرهك مع ذلك

56
00:07:41,730 --> 00:07:46,230
.لم يكن هذا ليحصل لي لو لم ألتقي بك

57
00:07:47,190 --> 00:07:50,190
.احترت لمَ لم تشعر أنت بالمثل

58
00:07:51,450 --> 00:07:52,910
ما شعورك الآن؟

59
00:07:53,450 --> 00:07:55,030
هل تكرهني؟

60
00:07:56,120 --> 00:08:05,500
أظنّ أنّ كلّ الألم الذي قاسيته، المشقّات التي كابدتها
والأوقات التي ظننت أنّي سأموت فيها

61
00:08:05,880 --> 00:08:10,420
.كانت ضروريّة لأبصر أمورًا شتّى وألتقي من قابلتهم

62
00:08:13,470 --> 00:08:15,890
،إذ ثمّة من أنا شاكرٌ أنّي التقيتهم

63
00:08:17,560 --> 00:08:20,100
...وأناسٌ بحاجةٍ إلي

64
00:08:22,390 --> 00:08:24,150
،مع ذلك وحتّى الآن

65
00:08:26,020 --> 00:08:28,520
.لا أكنّ أيّ مشاعر كرهٍ لكِ

66
00:08:30,230 --> 00:08:31,190
،لذا

67
00:08:36,700 --> 00:08:38,080
.فهمت

68
00:08:41,160 --> 00:08:42,330
،كنت

69
00:08:43,710 --> 00:08:45,620
.سعيدًا

70
00:08:54,630 --> 00:08:55,840
ستغادر؟

71
00:08:56,390 --> 00:08:58,550
أيمكنك عبور بحر الدماء هذا؟

72
00:08:58,550 --> 00:09:00,430
تجاهل كلّ خطاياك؟

73
00:09:04,310 --> 00:09:07,060
.سأذهب لأتبيّن إن كان بمقدوري حمل وزرها كلّها

74
00:09:08,020 --> 00:09:09,190
.فهمت

75
00:09:11,440 --> 00:09:14,650
.سيكون من الممتع مشاهدة غرقك

76
00:10:06,750 --> 00:10:08,750
إنّه حي، أليس كذلك؟

77
00:10:10,130 --> 00:10:15,590
إن كنت تقصد أنّ دماغه لا زال يعمل
.فبوسعك قول أنّه لا يزال حيًا

78
00:10:18,260 --> 00:10:22,640
.بئسًا، دومًا ما تندفع وحيدًا

79
00:10:23,060 --> 00:10:26,390
.دعنا نتذمّر قليلًا على الأقل يا كانيكي

80
00:10:30,060 --> 00:10:31,230
.أخي

81
00:10:32,020 --> 00:10:33,770
.يبدو الوضع كئيبًا هنا

82
00:10:34,570 --> 00:10:36,190
.يتطلّب بعض الزهور

83
00:10:37,240 --> 00:10:38,650
.مامان

84
00:10:48,330 --> 00:10:52,460
.يبدو أنّ كلّ الغيلان اجتمعوا في غرفة ساساكي

85
00:10:53,170 --> 00:10:56,510
.هكذا إذًا، إنّم يحترمونه حقًا

86
00:10:56,960 --> 00:10:57,880
أتريدين الذهاب؟

87
00:10:58,380 --> 00:11:00,180
ألا تريدين رؤية وجهه على الأقل؟

88
00:11:01,260 --> 00:11:02,850
.لا أستحقّ رؤيته

89
00:11:04,100 --> 00:11:08,390
اذهبي لرؤيته، وبوحي له بنفسك
.ما فعلتِ

90
00:11:09,640 --> 00:11:12,650
.وإلّا لن تبارحي ما أنتِ عليه

91
00:11:14,360 --> 00:11:15,650
.أوريي-كن

92
00:11:16,860 --> 00:11:22,570
ثمّة أمورٌ عديدة في هذا العالم
. لا يمكن لك التعامل معها بمفردك

93
00:11:23,870 --> 00:11:25,280
.هذا ينطبق عليّ أيضًا

94
00:11:26,540 --> 00:11:28,120
.كنت عاجزًا لوحدي

95
00:11:29,870 --> 00:11:32,000
.أنقذني أناسٌ عديدون

96
00:11:34,840 --> 00:11:38,670
.يحاول الجميع أن يحمّلوا أنفسهم فوق طاقتها

97
00:11:41,680 --> 00:11:45,260
أتساءل كيف ستؤول الأمور بالغيلان؟

98
00:11:46,100 --> 00:11:50,270
CCG ما رأيك؟ أيّها العضو السابق في الـ
هيراكو تاكي-سان؟

99
00:11:50,810 --> 00:11:53,770
.كلّ من التعايش والنزاع أمران تافهان

100
00:11:54,940 --> 00:12:02,860
قال أريما-سان أنّه حتّى لو تمكّن البشر والغيلان من تجاوز خلافهما
.فستندلع ثورة أخرى

101
00:12:03,820 --> 00:12:09,750
.لا بدّ أنّه عنى لك حقًا يا تاكي-سان ليحملك على الاستكانة هكذا

102
00:12:09,750 --> 00:12:11,910
أتكنّ له الضغينة يا إيتو؟

103
00:12:13,500 --> 00:12:15,880
...قال أريما-سان أيضًا

104
00:12:16,710 --> 00:12:20,170
.أنّ كلّ بشريٍّ سيغدو غولًا ...

105
00:12:21,840 --> 00:12:24,180
.سحقًا، تنفسه غير مستقر

106
00:12:24,180 --> 00:12:25,550
،على هذا المعدّل

107
00:12:26,260 --> 00:12:28,350
!إنّه يتعرّض لنوبة، أسرعوا

108
00:12:28,810 --> 00:12:30,810
ما هذا؟

109
00:13:00,800 --> 00:13:02,010
.توكا-تشان

110
00:13:16,400 --> 00:13:17,810
.مذهل

111
00:13:18,560 --> 00:13:20,570
.استيقظت بالفعل

112
00:13:22,110 --> 00:13:23,030
...عذرًا

113
00:13:23,570 --> 00:13:28,160
لمَ أنتِ وسايكو-تشان هنا رفقة توكا-تشان والآخرين يا كيمي-سان؟

114
00:13:29,070 --> 00:13:31,790
.لنتمكّن من مواجهة التهديد الأعظم

115
00:13:32,540 --> 00:13:34,250
.ليستا هما وحسب

116
00:13:35,080 --> 00:13:40,210
.حاليًا، يعمل كلّ من أعضاء غوتو واليمام سويًا

117
00:13:41,000 --> 00:13:43,760
؟CCG الغيلان والـ

118
00:13:44,970 --> 00:13:46,130
لماذا؟

119
00:13:47,130 --> 00:13:49,010
.لإنقاذك

120
00:13:49,680 --> 00:13:54,350
.CCG ولفعل هذا، وحّد ناغاتشيكا كلًّا من الغيلان والـ

121
00:13:54,730 --> 00:13:55,730
هيدي؟

122
00:13:56,690 --> 00:13:57,850
...فعل هذا

123
00:13:59,560 --> 00:14:02,440
أهو حي، هيدي؟

124
00:14:08,990 --> 00:14:13,290
أتسمحون لي برؤية المدينة؟

125
00:14:14,500 --> 00:14:15,620
ألا بأس بهذا؟

126
00:14:20,170 --> 00:14:21,790
.لا تضغط على نفسك كثيرًا

127
00:14:24,800 --> 00:14:26,760
.سأذهب رفقته

128
00:14:27,720 --> 00:14:28,970
.أوريي-كن

129
00:14:39,600 --> 00:14:42,770
إن كان هنالك ما تودّ قوله
.فقله وحسب يا ساساكي

130
00:14:43,020 --> 00:14:43,770
ماذا؟

131
00:14:44,230 --> 00:14:46,490
.بوسعي على الأقلّ الإنصات لك

132
00:14:47,440 --> 00:14:51,030
.لن تكون قادرًا على التفكير بأيّ فكرةٍ جديرة بالاعتماد على نفسك وحسب

133
00:14:51,410 --> 00:14:53,490
.شكرًا يا أوريي-كن

134
00:14:55,540 --> 00:14:57,200
ما الأمر يا يونيباياشي؟

135
00:14:58,330 --> 00:14:59,870
.هناك

136
00:15:08,470 --> 00:15:09,800
.غول

137
00:15:10,680 --> 00:15:12,140
!توقفوا

138
00:15:13,760 --> 00:15:15,970
.سامحوني رجاءً

139
00:15:15,970 --> 00:15:18,560
.كنت جائعةً جدًا

140
00:15:19,230 --> 00:15:20,350
...أرجوكم

141
00:15:20,940 --> 00:15:22,270
.دعوني أذهب

142
00:15:28,190 --> 00:15:30,570
.أيّها القائد، تلك الغولة

143
00:15:31,070 --> 00:15:32,070
.إنّها بشريّة

144
00:15:33,490 --> 00:15:38,500
.إنّها محققة عملت في القطاع العشرين

145
00:15:39,830 --> 00:15:43,330
مرحبًا، أيسمعني الجميع؟

146
00:15:44,130 --> 00:15:47,840
.انظروا رجاءً، ثمّة وحوشٌ تلتهم البشر

147
00:15:47,840 --> 00:15:51,090
أهذه علامة على فناء العالم؟

148
00:15:51,930 --> 00:15:55,680
.سأجري مقابلة مع أحد الوحوش

149
00:15:55,680 --> 00:15:56,850
ما اسمك؟

150
00:15:56,850 --> 00:15:58,560
.يبدو أنّه عنيفٌ حقًا

151
00:15:58,560 --> 00:15:59,730
،وحاليًا

152
00:15:59,730 --> 00:16:01,890
.يبدو أنّ قوّات الدفاع الذاتي اليابانيّة قد وصلت

153
00:16:04,690 --> 00:16:07,020
.يبدو أنّهم يحققون تأثيرًا

154
00:16:13,990 --> 00:16:16,450
.الوحوش تنفجر

155
00:16:18,330 --> 00:16:20,250
أنت، ما الخطب؟

156
00:16:20,250 --> 00:16:21,290
ما الأمر؟

157
00:16:22,040 --> 00:16:24,710
...يبدو أنّ أمرًا مريبًا يحصل

158
00:16:25,170 --> 00:16:29,420
والآن، لنرى ماذا يحصل
وما الذي علينا فعله؟

159
00:16:30,170 --> 00:16:31,970
كيف يبثُّ هذا؟

160
00:16:31,970 --> 00:16:35,340
.يبدو أنّه يستخدم نظام بثٍ خاص

161
00:16:35,890 --> 00:16:37,180
.هنا أوريي

162
00:16:37,180 --> 00:16:39,310
.إنّنا في المنطقة لذا سنتوجه هناك

163
00:16:39,310 --> 00:16:42,600
.حسنٌ، سأرسل المساندة حالًا

164
00:16:43,480 --> 00:16:44,480
.مارودي-سان

165
00:16:44,480 --> 00:16:45,560
ما الأمر؟

166
00:16:45,980 --> 00:16:47,400
.أولئك الذين انفجروا

167
00:16:49,400 --> 00:16:51,030
.لديّ شعورٌ سيءٌ حيالهم

168
00:16:54,280 --> 00:16:55,950
.لا أحد هنا

169
00:16:55,950 --> 00:16:58,160
!ألقوا نظرةً رجاءً

170
00:16:58,740 --> 00:17:01,950
،يبدو أنّ أولئك الرجال الذين كانوا متلوّين على الأرض الآن

171
00:17:01,950 --> 00:17:04,920
.تنمو بروزات ما من أجسادهم

172
00:17:06,290 --> 00:17:07,630
.إنّه تسجيل

173
00:17:08,670 --> 00:17:10,550
.فوروتا ليس هنا

174
00:17:17,590 --> 00:17:20,560
،بعد أن تنفسوا السمّ من تلك الوحوش

175
00:17:20,560 --> 00:17:24,100
!تحوّلوا إلى غيلان

176
00:17:24,390 --> 00:17:28,230
يا إلهي، ما الذي سيحدث للبشريّة؟

177
00:17:28,980 --> 00:17:31,110
.ابذلوا جهدكم جميعًا

178
00:17:32,030 --> 00:17:33,280
.سحقًا

179
00:17:33,990 --> 00:17:35,240
.فوروتا

180
00:17:50,670 --> 00:17:51,800
.سايكو-تشان

181
00:18:11,610 --> 00:18:12,730
.ساساكي

182
00:18:14,230 --> 00:18:15,860
.سأؤمّن سبيلًا لكما

183
00:18:15,860 --> 00:18:17,780
!خذ يونيباياشي وعودا إلى المقرّ

184
00:18:18,160 --> 00:18:21,200
،لكنّهم سامّون يا أوريي-كن

185
00:18:21,200 --> 00:18:22,410
.اذهبا وحسب

186
00:18:24,200 --> 00:18:26,540
.أنتما من ستغادران

187
00:18:27,000 --> 00:18:28,540
ما الذي تتفوهين به؟

188
00:18:28,540 --> 00:18:30,630
.لا تكن غبيًا

189
00:18:30,630 --> 00:18:33,750
.أنا الوحيدة التي تسممت

190
00:18:34,250 --> 00:18:36,920
!أنا من عليها البقاء

191
00:18:35,920 --> 00:18:37,470
...إن قاتلت

192
00:18:36,920 --> 00:18:38,970
!لا يمكننا أن نذرك خلفنا

193
00:18:39,180 --> 00:18:44,560
لكن، إن استخدمت قواي
.قد أفقد السيطرة مجدّدًا

194
00:18:45,770 --> 00:18:48,060
.كنت قادرًا على العودة بفضل الجميع

195
00:18:49,100 --> 00:18:50,980
.انتظروني جميعًا

196
00:18:51,810 --> 00:18:54,520
.لا أريد أنا أسبب لهم الأسى بعد الآن

197
00:18:57,570 --> 00:19:01,530
...لكن، على هذا الحال فسايكو-تشان وأوريي-كن

198
00:19:02,990 --> 00:19:06,870
ما العمل؟

199
00:19:08,750 --> 00:19:10,620
...العجز عن فعل شيء

200
00:19:12,170 --> 00:19:14,170
...العجز عن فعل شيء

201
00:19:15,300 --> 00:19:17,710
!لا أريد ذلك

202
00:19:39,740 --> 00:19:40,950
.ساساكي

203
00:19:41,740 --> 00:19:42,700
.لنذهب

204
00:19:43,320 --> 00:19:44,450
.أجل

205
00:19:50,120 --> 00:19:53,130
ما الذي سيحصل ليونيباياشي؟

206
00:19:54,250 --> 00:19:57,130
.تجاوز تعداد خلايا آر-سي لديها الألف

207
00:19:57,750 --> 00:20:00,130
.هذا العدد كافٍ لجعلها غولة

208
00:20:01,090 --> 00:20:04,220
.متأكدة أنّ ما قيل في البث عن تحوّل البشر إلى غيلانٍ صحيح

209
00:20:05,180 --> 00:20:07,600
،إن لم تستقرّ الأمور

210
00:20:07,600 --> 00:20:11,020
...فلن نتمكّن من تحليل أعراضها أكثر

211
00:20:12,270 --> 00:20:13,730
.سايكو-تشان

212
00:20:30,870 --> 00:20:31,660
.مرحبًا

213
00:20:34,080 --> 00:20:34,960
.مرحبًا

214
00:20:36,330 --> 00:20:37,710
.تبدو بخير

215
00:20:38,250 --> 00:20:39,380
.نوعًا ما

216
00:20:43,260 --> 00:20:44,260
.هيدي

217
00:20:44,720 --> 00:20:45,720
ماذا؟

218
00:20:47,300 --> 00:20:51,270
أيمكنك أن تريني وجهك؟

219
00:20:51,270 --> 00:20:54,690
.لكنّي لا أضع أيّ مساحيق تجميل الآن

220
00:20:54,690 --> 00:20:56,980
!إنّني محرجٌ جدًا

221
00:20:59,480 --> 00:21:00,780
.أريد أن أرى

222
00:21:03,280 --> 00:21:04,820
.ما فعلت لك

223
00:21:07,700 --> 00:21:08,780
.بئسًا

224
00:21:24,170 --> 00:21:25,300
.شكرًا

225
00:21:28,220 --> 00:21:33,600
.كنت دومًا تخفي ما لم أرد رؤيته

226
00:21:35,190 --> 00:21:36,190
...كنت دومًا

227
00:21:37,900 --> 00:21:39,520
.تحميني ...

228
00:21:41,860 --> 00:21:43,110
.صحيح

229
00:21:44,240 --> 00:21:46,400
.أنت تفهمني

230
00:21:48,820 --> 00:21:52,410
.سأتحمّل وزر كلّ هذا

231
00:21:54,200 --> 00:21:55,710
