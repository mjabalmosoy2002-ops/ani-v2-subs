1
00:01:45,370 --> 00:01:48,920
.عاودت الإشارات الحيويّة للتنّين النشاط

2
00:01:48,920 --> 00:01:52,840
.تحوّل مزيدٌ من البشر إلى غيلانٍ بفعل السمّ أيضًا

3
00:01:54,340 --> 00:01:58,930
لمَ لا يزال ذلك الشيء يتحرّك بعد أن أخرجنا كانيكي منه؟

4
00:01:59,590 --> 00:02:01,010
.ألقوا نظرة على هذه رجاءً

5
00:02:02,180 --> 00:02:04,520
.ثمّة نواةٌ أخرى

6
00:02:05,180 --> 00:02:06,980
نواة أخرى؟

7
00:02:07,350 --> 00:02:10,020
.أظنّ أنّ علينا تولّي أمرها أيضًا

8
00:02:10,020 --> 00:02:13,730
...لنرسل إذًا فريقًا ليستقصي أمر النواة

9
00:02:13,730 --> 00:02:14,940
.لا وقت لدينا

10
00:02:15,900 --> 00:02:16,820
كم لدينا بعد؟

11
00:02:17,360 --> 00:02:20,820
،هذا بناءً على تحليلي للبيانات فقط

12
00:02:21,370 --> 00:02:24,370
.ما لا يقلّ عن اثنتي عشرة ساعة

13
00:02:25,240 --> 00:02:28,250
ما الذي سيحدث لو نشط التنين مجدّدًا؟

14
00:02:28,830 --> 00:02:32,040
.سيصبح كلّ البشر في طوكيو غيلانًا

15
00:02:33,040 --> 00:02:35,710
.لا وقت للاستقصاء إذًا

16
00:02:36,510 --> 00:02:41,140
لكنّنا تتبعنا أيضًا آثار السمّ إلى المجرى
.تحت الأرض المؤدي إلى النواة

17
00:02:41,550 --> 00:02:43,810
ألا يعني هذا أنّ بوسع غول الذهاب؟

18
00:02:44,510 --> 00:02:47,600
،حتّى بالنسبة للغيلان، لو تخطّوا حدودهم

19
00:02:47,600 --> 00:02:51,150
.فقد يعرّض هذا خلايا آر-سي لديهم للخطر

20
00:02:51,480 --> 00:02:53,400
.اسمحوا لي بالذهاب رجاءً

21
00:02:58,240 --> 00:03:01,860
لدى جسدي مقاومة للسمّ، أليس كذلك؟

22
00:03:02,370 --> 00:03:07,410
.بالفعل، لم تظهر خلايا آر-سي لديك أي تغيير حقًا يا كانيكي-سان

23
00:03:07,830 --> 00:03:09,210
،رغم هذا

24
00:03:19,220 --> 00:03:20,880
هجوم؟

25
00:03:20,880 --> 00:03:22,510
.ثمّة عدد كبير منهم

26
00:03:22,510 --> 00:03:24,850
.أتوا بجديّة لسحقنا

27
00:03:25,260 --> 00:03:26,720
.لا وقت لدينا

28
00:03:28,140 --> 00:03:30,140
.سأتوجه إلى النواة

29
00:03:30,140 --> 00:03:32,350
.سأحتاج دعمك يا كيمي-سان

30
00:03:33,100 --> 00:03:37,320
.CCG ابقوا جميعًا هنا رجاءً وساندوا الـ

31
00:03:38,740 --> 00:03:40,030
.سأذهب أيضًا

32
00:03:42,160 --> 00:03:43,320
.أياتو-كن

33
00:03:43,780 --> 00:03:45,240
أين كنت؟

34
00:03:45,700 --> 00:03:49,250
.كنت أحاول أن أتحرّى أكثر عن الوحش تحت الأرض

35
00:03:49,750 --> 00:03:51,830
.أياتو، كانيكي

36
00:03:53,960 --> 00:03:55,880
.احرصا على العودة

37
00:04:09,390 --> 00:04:10,270
.أجل

38
00:04:12,310 --> 00:04:13,560
.لننطلق

39
00:04:56,150 --> 00:04:58,310
.لديّ أمرٌ واحدٌ لكم

40
00:04:58,900 --> 00:05:01,320
!انتصروا! هذا كلّ شيء

41
00:05:02,030 --> 00:05:04,240
.يبدو أنّهم متحمسون للقتال

42
00:05:04,780 --> 00:05:07,110
.علينا كسب بعض الوقت

43
00:05:07,450 --> 00:05:08,700
أليس كذلك؟

44
00:05:09,200 --> 00:05:11,120
.أنت محق

45
00:05:11,700 --> 00:05:13,410
.سنستخدمه

46
00:05:18,130 --> 00:05:20,750
!سأمزّق ما يكفي عن كانيكي-كن أيضًا

47
00:05:20,750 --> 00:05:23,420
!سأمزق! سأمزق! سأمزق

48
00:05:21,000 --> 00:05:22,840
ألن تخرس؟

49
00:05:38,600 --> 00:05:39,690
.سينسي

50
00:05:51,620 --> 00:05:54,200
.يبدو أنّنا تولينا أمر جميع من هنا

51
00:05:54,200 --> 00:05:55,870
.شيء ما خاطئ

52
00:05:55,870 --> 00:05:57,330
.لم تزدد أعدادهم

53
00:05:57,790 --> 00:05:59,830
.وليس كما لو أنّهم تراجعوا

54
00:06:01,540 --> 00:06:04,710
ما ذلك الصوت؟

55
00:06:15,270 --> 00:06:16,680
ما هذا؟

56
00:06:35,790 --> 00:06:37,710
ما هذا؟

57
00:06:43,670 --> 00:06:46,010
البومة؟

58
00:06:58,230 --> 00:07:00,140
.لا بدّ أنّك تابع كيشو

59
00:07:00,850 --> 00:07:02,860
.يا لسخرية القدر

60
00:07:02,860 --> 00:07:11,450
لم أكن لأخال أنّي سأكون من يقتل
.تابع ذلك الخائن

61
00:07:12,320 --> 00:07:14,280
.تلقيت جرعة من السمّ إذًا

62
00:07:14,830 --> 00:07:16,240
سم؟

63
00:07:16,740 --> 00:07:19,710
.إنّها هِبَة

64
00:07:20,210 --> 00:07:25,460
.إن تنازلت عن جسدي الناقص وغدوت غولًا بالكامل

65
00:07:25,460 --> 00:07:29,220
.فيمكن لي أنا حتّى أن أبلغ التناغم في داخلي

66
00:07:29,220 --> 00:07:34,390
.ذلك التنين هو كسفينة نوح لهذه الحياة

67
00:07:37,970 --> 00:07:39,350
.سحقًا

68
00:07:39,350 --> 00:07:41,100
.فرقة أوكاكو

69
00:07:41,100 --> 00:07:44,270
!أطلقوا، أطلقوا وواصلوا ذلك

70
00:07:47,440 --> 00:07:49,190
.سوزويا

71
00:07:54,320 --> 00:07:58,490
!تنحّوا جانبًا أيّها الفتية وأيتها الفتيات

72
00:08:05,420 --> 00:08:06,670
هل نجحنا؟

73
00:08:10,010 --> 00:08:11,170
.جيد

74
00:08:12,680 --> 00:08:14,760
.لا، ليس بعد

75
00:08:30,780 --> 00:08:34,610
.بدأت أعتاد على هذا

76
00:08:37,160 --> 00:08:41,040
.هذه... مشكلة

77
00:09:03,520 --> 00:09:08,860
تُخلق بيوض تلك المخلوقات في الجذر
.ثمّ تُرسّل إلى السطح

78
00:09:09,820 --> 00:09:13,320
.كما توقعت، ثمّة إشارة قويّة أمامكما

79
00:09:13,320 --> 00:09:14,900
.أسرعا رجاءً

80
00:09:27,500 --> 00:09:30,840
لمَ أشعر بوجودها؟

81
00:09:40,350 --> 00:09:42,010
.يبدو أنّهم يستيقظون

82
00:09:42,600 --> 00:09:43,770
.انزل

83
00:10:11,170 --> 00:10:13,420
.يستمرون بالتكاثر

84
00:10:13,840 --> 00:10:14,880
.كانيكي

85
00:10:15,760 --> 00:10:18,180
!سأشغلهم أنا، اذهب

86
00:10:19,590 --> 00:10:22,140
.لا يمكن لأحدٍ أن يحلّ مكانك

87
00:10:22,560 --> 00:10:25,140
.لا تهدر طاقتك هنا

88
00:10:25,140 --> 00:10:26,310
!اذهب

89
00:10:32,820 --> 00:10:34,190
.أعتمد عليك

90
00:10:34,980 --> 00:10:36,570
.أيّها الأخ الوغد

91
00:10:42,580 --> 00:10:45,160
.اللعنة على ذلك الوحش

92
00:10:45,580 --> 00:10:47,620
كم شخصًا بقي بوسعه التحرك؟

93
00:10:47,620 --> 00:10:49,290
.سأتحقق من هذا الآن

94
00:10:49,870 --> 00:10:51,630
أتسمعني يا ناغاتشيكا؟

95
00:10:51,630 --> 00:10:52,630
.أجل

96
00:10:53,130 --> 00:10:56,340
.سمعنا صوتًا غريبًا قبل ظهورهم

97
00:10:56,340 --> 00:10:58,590
.بدا كصوتِ نايٍ أو ما شابه

98
00:10:58,590 --> 00:11:00,930
ألذلك علاقة بأيّ شيء؟

99
00:11:01,340 --> 00:11:02,600
نغمة ناي؟

100
00:11:05,720 --> 00:11:07,180
ألي برؤية خريطة رجاءً؟

101
00:11:08,180 --> 00:11:11,900
.في مكان ما، لا بدّ أنّ أحدًا يتحكّم بالبومة من مكانٍ ما

102
00:11:14,060 --> 00:11:15,150
.هينامي-تشان

103
00:11:15,820 --> 00:11:19,110
.تفقّدي الجنوب، باتّجاه الساعة السابعة

104
00:11:19,450 --> 00:11:20,280
.حسنٌ

105
00:11:26,410 --> 00:11:28,410
...صوت محرّك شاحنة

106
00:11:29,460 --> 00:11:31,040
...أصواتٌ عابرة

107
00:11:32,120 --> 00:11:33,500
...خطوات أقدام

108
00:11:34,460 --> 00:11:36,300
...أنفاس مجهدة لمصاب

109
00:11:37,130 --> 00:11:40,590
...الاهتزازات التي تسببها البومة في الهواء

110
00:11:41,680 --> 00:11:44,430
...لكن خلفه وأبعد من ذلك بعد

111
00:11:44,890 --> 00:11:47,310
...أكثر بعدًا حتّى

112
00:11:48,680 --> 00:11:49,890
.وجدتهم

113
00:11:50,730 --> 00:11:53,350
.إنّهم على سطح بناءٍ في كتلة الأبنية الثالثة جنوبًا

114
00:11:54,860 --> 00:11:58,530
.يا ويحي، يبدو أنّهم وجدونا

115
00:11:58,980 --> 00:12:00,950
.لنعد التموضع

116
00:12:02,700 --> 00:12:04,320
.اسبقاني

117
00:12:04,320 --> 00:12:05,570
.حسنٌ إذًا

118
00:12:18,750 --> 00:12:21,050
...مضت فترة

119
00:12:22,010 --> 00:12:23,380
.يا كوتارو

120
00:12:46,950 --> 00:12:51,250
.لست سيئًا يا كوتارو

121
00:12:51,250 --> 00:12:52,710
...رغم هذا

122
00:12:53,080 --> 00:12:56,330
.إنّي أفوقك سنينًا

123
00:13:44,170 --> 00:13:47,970
.دومًا ما حلمت بمجيء يومٍ كهذا

124
00:13:47,970 --> 00:13:53,470
ستتلطّخ يداي بدمائك بينما تشقّان
.طريقهما إلى قلبك

125
00:13:53,970 --> 00:13:55,480
.هذا ممتع جدًا

126
00:13:56,810 --> 00:13:59,480
.لست مستمتعًا بتاتًا

127
00:14:00,440 --> 00:14:05,940
.ما من شيء ممتع حيال هذا إطلاقًا

128
00:14:07,030 --> 00:14:08,490
...إنّك

129
00:14:08,490 --> 00:14:09,870
.صديق

130
00:14:11,990 --> 00:14:16,460
!لا أريد قتلك أو أن أقتل على يديك

131
00:14:22,800 --> 00:14:26,010
!يسعدني بالفعل أنّك صديقي

132
00:14:26,340 --> 00:14:31,760
.دومًا ما كنت وفيًا وصادقًا جدًا يا رينجي-كن

133
00:14:32,470 --> 00:14:35,970
.لذا يمكنني الوثوق بك في عالم كهذا حقًا

134
00:14:39,060 --> 00:14:44,190
.دومًا ما أردت التهامك

135
00:14:46,650 --> 00:14:51,320
.ابعث فيَّ شعور الحياة يا رينجي-كن

136
00:15:04,340 --> 00:15:06,550
.يبدو أنّني أمسكتك

137
00:15:06,550 --> 00:15:08,380
...والآن

138
00:15:23,860 --> 00:15:27,860
.هذا ممتع حقًا يا رينجي-كن

139
00:15:47,550 --> 00:15:51,430
.أوتا، لقد مضى بنا زمنٌ مذ غدونا بالغين

140
00:15:52,510 --> 00:15:55,220
.لا يمكن لنا إضاعة الوقت سدى وحسب

141
00:16:06,860 --> 00:16:10,150
...أعني، أوليس هذا موحشًا جدًا

142
00:16:11,240 --> 00:16:12,650
يا رينجي-كن؟

143
00:16:19,410 --> 00:16:22,290
أخبرني، هل تذكر؟

144
00:16:23,250 --> 00:16:26,880
.حين أصيبت ساقا كلّ منا

145
00:16:26,880 --> 00:16:29,300
.واضطرت إيتوري لحملنا إلى المنزل

146
00:16:30,380 --> 00:16:32,470
،مهما كان الصدع بيننا

147
00:16:33,090 --> 00:16:35,640
،ومهما أريقت دماء

148
00:16:36,550 --> 00:16:39,010
.لم يكن لذلك أهميّة حينها

149
00:16:40,470 --> 00:16:44,060
.انتهى كلّ ذلك الآن، كلّه

150
00:16:45,690 --> 00:16:47,980
،لم أستطع التغيّر

151
00:16:48,690 --> 00:16:51,490
.رغم أنّ العالم حولي استمرّ بالتغيّر

152
00:16:52,530 --> 00:16:55,780
.إن كنت تود التهامي، فلتحاول مجدّدًا لاحقًا

153
00:16:55,780 --> 00:16:56,820
ماذا؟

154
00:16:56,820 --> 00:17:00,290
.عليك فعلها إن كانت تلك أمنيتك

155
00:17:01,620 --> 00:17:04,290
.لا يهمني مقدار الأذية التي ستسببها لي

156
00:17:05,170 --> 00:17:07,880
.لأنّك صديقي

157
00:17:09,290 --> 00:17:10,460
.هكذا إذًا

158
00:17:11,340 --> 00:17:12,840
.أنت محق

159
00:17:13,380 --> 00:17:16,840
.أظنّ أنّ كلينا بالغان الآن

160
00:17:17,430 --> 00:17:18,510
أتريد منّي حملك؟

161
00:18:25,080 --> 00:18:30,710
.لم أكنّ لك سوى الكره أيّها الوغد

162
00:18:32,090 --> 00:18:34,050
.لكنّني أدركت

163
00:18:35,840 --> 00:18:39,890
.أدركت ذلك وواصلت تجاهله

164
00:18:44,510 --> 00:18:46,810
.هذا العالم فاسد

165
00:18:48,100 --> 00:18:49,350
...من شوّهوه

166
00:18:54,650 --> 00:18:56,440
.ومن يشوّهونه

167
00:18:59,820 --> 00:19:00,990
.أنا أحدهم

168
00:19:04,200 --> 00:19:05,330
...لقد

169
00:19:06,750 --> 00:19:08,540
.أحببتك

170
00:19:36,480 --> 00:19:42,570
.دوناتو بوربورا هو الشرير الذي تظنّه تمامًا

171
00:19:42,950 --> 00:19:46,830
.مهما يكن عدد البشر الذين تحوّلوا إلى غيلان

172
00:19:46,830 --> 00:19:50,750
.ومهما يكن عدد الحيوات التي أزهقت

173
00:19:50,750 --> 00:19:53,210
.لم يأبه لذلك أبدًا

174
00:19:55,710 --> 00:20:03,180
لكن من كان ليظن أنّني سأُردَى
.على يدي شخصٍ صالحٍ مثلك

175
00:20:03,550 --> 00:20:07,640
.لم أكن لأطلب خاتمةً ملائمة أكثر من هذه

176
00:20:07,640 --> 00:20:09,980
...ذلك الكعك الذي خبزته لنا

177
00:20:10,810 --> 00:20:11,980
.كان شهيًا

178
00:20:13,100 --> 00:20:16,520
.كنت تأتي لتعيد تغطيتي بالبطانية في الليالي الباردة

179
00:20:17,730 --> 00:20:20,240
...حين مات كلبنا

180
00:20:21,240 --> 00:20:23,530
.حفرت له قبرًا في الجبل النائي

181
00:20:24,280 --> 00:20:29,120
.كنت أستنزفك من غير علمك

182
00:20:29,950 --> 00:20:32,790
ألا تزال تشعر بحنين لذلك؟

183
00:20:33,420 --> 00:20:35,040
.بالطبع

184
00:20:36,040 --> 00:20:38,170
،مهما حاولت النسيان

185
00:20:39,710 --> 00:20:41,920
،مهما حاولت كرهك

186
00:20:42,970 --> 00:20:48,560
.لا يمكنني إلا أن أعزّ تلك الأيّام التي قضيناها

187
00:20:52,020 --> 00:20:55,270
ما الخطأ في ابنٍ يحبّ أباه؟

188
00:21:02,940 --> 00:21:07,160
.أب؟! كم أنت مخلص

189
00:21:26,840 --> 00:21:28,930
.حانت الجولة الثانية

190
00:21:37,520 --> 00:21:39,480
أثمّة ما يمكنني مساعدتك به؟

191
00:21:40,570 --> 00:21:42,150
...أيعقل

192
00:21:42,730 --> 00:21:49,200
أنّك تفكّر بمحاولة إيقاف هذا حقًا؟

193
00:21:55,540 --> 00:21:57,620
،عليّ تحذيرك

194
00:21:58,080 --> 00:22:02,750
.إنّني قويّ بشكلٍ غير عادي

195
00:24:06,710 --> 00:24:07,840
.شكرًا