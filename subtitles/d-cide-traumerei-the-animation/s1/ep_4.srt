1
00:00:02,360 --> 00:00:04,910
!توقّفي يا أمّي

2
00:00:04,910 --> 00:00:06,730
!أفلتني يا أروتو

3
00:00:06,730 --> 00:00:08,390
!ما عدت أتحمّل

4
00:00:08,390 --> 00:00:10,070
!لا يمكنك فعل هذا

5
00:01:43,660 --> 00:01:45,110
...نبدأ بالحجرة

6
00:01:45,110 --> 00:01:46,500
!حجرة، ورقة، مقصّ

7
00:01:47,750 --> 00:01:49,800
!تعادل آخر

8
00:01:50,750 --> 00:01:52,260
...نبدأ بالحجرة

9
00:01:52,260 --> 00:01:54,220
!حجرة، ورقة، مقصّ

10
00:01:55,680 --> 00:01:57,550
.إنّه خطؤك لأنّك لم تأكل على الفور

11
00:01:59,100 --> 00:02:00,800
!سأحصل على التّالية

12
00:02:01,750 --> 00:02:04,170
.لننسَ أمر هذين الأحمقين

13
00:02:04,170 --> 00:02:06,560
على أيّ حال، هل عرفتم أيّ شيء عن السّومنيوم؟

14
00:02:06,560 --> 00:02:09,240
.السّومنيوم دروب، صحيح؟ دروب

15
00:02:09,240 --> 00:02:10,350
.اخرس

16
00:02:10,680 --> 00:02:12,740
هل عرفت أيّ شيء أم لا؟

17
00:02:12,740 --> 00:02:14,190
...لا للأسف

18
00:02:14,190 --> 00:02:16,800
جرّبت باستعمال عدّة حسابات أخرى

19
00:02:16,800 --> 00:02:18,700
.لكنّ رجل الأحلام لم يظهر

20
00:02:18,700 --> 00:02:21,520
،رأيت رجلاً غريبًا في شيبويا

21
00:02:21,520 --> 00:02:23,370
.لكن يبدو أنّه مجرّد تابع متدنّي المستوى

22
00:02:23,370 --> 00:02:26,610
الشّيء الوحيد الّذي نعرفه هو أنّه حتّى
.المنظّمات الّتي توزّعه لا تصنعه بنفسها

23
00:02:26,610 --> 00:02:29,330
.نعم. كان بحوزة إحدى صديقاتي

24
00:02:29,650 --> 00:02:33,320
،قالت أنّها حصلت عليه في ملهى ما
.لكنّها لم تتذكّر أيّ شيء آخر

25
00:02:33,320 --> 00:02:37,030
.تلبّسني ويرد في الترويميراي بعد استعمال واحد فقط

26
00:02:37,030 --> 00:02:38,280
أليس هذا ما حدث معها أيضًا؟

27
00:02:38,280 --> 00:02:42,340
قالت تومومي أنّ البعض  يذهبون
.إلى الترويميراي عدّة مرّات

28
00:02:42,590 --> 00:02:44,820
.أي أنّ الأمر يختلف حسب كلّ فرد

29
00:02:44,820 --> 00:02:46,400
!كم هذا مقرف

30
00:02:46,400 --> 00:02:48,320
!لقد لعقها

31
00:02:48,320 --> 00:02:51,040
!أكيد! هذه البودينغ لي الآن

32
00:02:51,040 --> 00:02:53,510
...أيّها اللّعين

33
00:02:51,990 --> 00:02:54,410
.يا لحظّ الفتيان لحماقتهم

34
00:02:57,880 --> 00:02:59,380
.لا يمكنك أكلها الآن

35
00:02:59,380 --> 00:03:03,130
!لا تستخفّ بشهيّة مراهق

36
00:03:03,130 --> 00:03:04,910
!أكلها فعلاً

37
00:03:09,800 --> 00:03:11,000
!إلى اللّقاء

38
00:03:11,000 --> 00:03:11,980
!أكيد

39
00:03:23,010 --> 00:03:24,390
.ها قد عدت

40
00:03:25,080 --> 00:03:27,220
.مرحبًا بك. الحمّام جاهز

41
00:03:27,220 --> 00:03:29,260
.شكرًا كالعادة

42
00:03:30,350 --> 00:03:32,100
إنّك تعمل منذ الفجر، صحيح؟

43
00:03:32,100 --> 00:03:33,720
.أسرع بأخذ حمّامك

44
00:03:33,720 --> 00:03:35,840
.أنا جدّ... آسف

45
00:03:36,430 --> 00:03:37,400
أين أمّك؟

46
00:03:39,470 --> 00:03:41,400
.قالت لا طعم لما تأكله مهما كان

47
00:03:41,760 --> 00:03:43,070
.فهمت

48
00:04:54,720 --> 00:04:56,650
.نعم، هذه هي العلامة

49
00:04:56,650 --> 00:04:57,800
أهنالك المزيد؟

50
00:04:57,800 --> 00:04:59,530
.هذا كلّ ما وجدت

51
00:04:59,530 --> 00:05:02,370
.بحثت في الأرجاء، ولا يوجد غيرها

52
00:05:02,370 --> 00:05:04,280
.فهمت. أحسنتما عملاً

53
00:05:04,280 --> 00:05:05,950
.لم يكن عملاً

54
00:05:05,950 --> 00:05:07,960
.ولا تتصرّف وكأنّك رئيسي

55
00:05:07,960 --> 00:05:10,780
!"هيّا أشتري لي  "بي إس

56
00:05:10,780 --> 00:05:12,560
!"أريد لعب "غابة الفيل

57
00:05:12,560 --> 00:05:13,910
!يلعبها الجميع

58
00:05:13,910 --> 00:05:17,420
!وعدتك أنّني سأشتريه لك في عيد الميلاد المجيد

59
00:05:18,670 --> 00:05:21,550
!لن أتمكّن من مجاراة أحاديث صديقي هكذا

60
00:05:21,880 --> 00:05:26,470
أحتاجه لأكون قادرًا على التّواصل جيّدًا
!مع بقيّة تلاميذ الابتدائيّة

61
00:05:26,470 --> 00:05:30,890
وأنا في سنّك، كان الجميع يتحدّثون
...عن ألعاب الفيديو طوال اليوم بالفعل

62
00:05:30,890 --> 00:05:33,260
...فعلاً؟ فعلاً؟ لذلك

63
00:05:33,260 --> 00:05:35,260
.حسنًا، حسنًا، لنسأل والدك

64
00:05:35,260 --> 00:05:36,860
سنسأل أبي؟

65
00:05:35,840 --> 00:05:38,790
ماذا؟ تريد "بي إس" أيضًا؟

66
00:05:38,790 --> 00:05:40,150
.لديّ واحد

67
00:05:40,150 --> 00:05:43,390
إن كنت تريد واحدًا بشدّة
.اطلب من أمّك شراءه

68
00:05:45,990 --> 00:05:47,760
!هذا مؤلم

69
00:05:47,760 --> 00:05:48,950
!أروتو

70
00:05:51,320 --> 00:05:53,580
!هذا خطؤك لتباهيك بجهازك

71
00:05:53,580 --> 00:05:55,890
!إنّك صبيانيّ للغاية

72
00:05:55,890 --> 00:05:57,970
.لم يكن الأمر كذلك

73
00:05:59,200 --> 00:06:01,820
.الأمر واضح لي... بطريقة ما

74
00:06:03,790 --> 00:06:06,280
.لا أدري

75
00:06:06,280 --> 00:06:07,970
وكيف لي أن أدري؟

76
00:06:08,620 --> 00:06:10,150
إنّه من رفاقك، صحيح؟

77
00:06:10,150 --> 00:06:12,720
ومع ذلك لا تعرفين كيف هي عائلته؟

78
00:06:12,720 --> 00:06:15,970
هل لذلك أيّ علاقة بكيفية قتالنا؟

79
00:06:17,660 --> 00:06:18,670
.لا

80
00:06:18,670 --> 00:06:20,730
.إذًا لست بحاجة لأعرف

81
00:06:22,440 --> 00:06:24,430
.لا تنظر إليّ هكذا

82
00:06:24,430 --> 00:06:27,860
.لا أختار النوكر-أب حسب عائلاتهم

83
00:06:28,110 --> 00:06:31,170
.فمثلًا، لا أدري أيّ شيء عن ظروفك

84
00:06:31,170 --> 00:06:34,850
لماذا تهتمّ لأمر عائلته على أيّ حال؟

85
00:06:35,800 --> 00:06:37,120
...عيناه

86
00:06:38,120 --> 00:06:41,630
كانت عينا شخص يشعر بالغيرة
.من عائلة سعيدة

87
00:06:42,770 --> 00:06:45,130
كيف عرفت ذلك؟

88
00:06:45,400 --> 00:06:49,630
.إنّه من النّوع الّذي لا يظهر ضعفه

89
00:06:59,460 --> 00:07:00,640
ماذا؟

90
00:07:01,040 --> 00:07:03,400
أتقوم بالطّبخ دائمًا؟

91
00:07:03,700 --> 00:07:05,000
وما دخلك أنت؟

92
00:07:05,000 --> 00:07:07,150
.هذا لا يؤثّر على عملي

93
00:07:07,790 --> 00:07:10,400
.لا شيء. أنا فضوليّ فحسب

94
00:07:10,720 --> 00:07:12,900
.فهمت. مع السّلامة إذًا

95
00:07:16,000 --> 00:07:16,660
.تمهّل

96
00:07:17,910 --> 00:07:21,530
رؤية عائلة تبتسم تزعجك أحيانًا، صحيح؟

97
00:07:22,670 --> 00:07:24,170
.كان ذلك حالي أيضًا

98
00:07:25,440 --> 00:07:28,910
.عندما مات أخي، تداعت عائلتي بأكملها

99
00:07:28,910 --> 00:07:32,660
قضى والداي كلّ أيّامهم بالبكاء
.وهما يجهلان ما العمل

100
00:07:33,270 --> 00:07:36,310
.حزنتُ جدًّا لدرجةٍ لم أستطيع فيها البكاء

101
00:07:36,600 --> 00:07:37,680
أنت تشفق عليّ إذًا؟

102
00:07:37,680 --> 00:07:39,140
!ليست شفقة

103
00:07:39,490 --> 00:07:41,680
!كلّ ما هنالك... هو أنّ بإمكانك طلب المساعدة

104
00:07:41,680 --> 00:07:43,520
!اخرس! دعني وشأني

105
00:07:54,800 --> 00:07:58,510
...حتّى إن طلبتُ المساعدة

106
00:07:59,040 --> 00:08:01,770
!فلن يساعدني أحد

107
00:08:10,800 --> 00:08:13,050
.لا تتدافعوا أثناء ركوب

108
00:08:13,320 --> 00:08:14,950
.ستُغلق الأبواب

109
00:08:33,200 --> 00:08:35,570
!آسف! كان خطئي

110
00:08:38,690 --> 00:08:40,700
!آسف جدًّا يا سيّدي

111
00:08:48,090 --> 00:08:50,530
!أنا آسف! أنا آسف

112
00:08:52,040 --> 00:08:56,280
.الآن؟ نعم... نعم

113
00:08:57,200 --> 00:08:58,970
.مفهوم

114
00:09:21,120 --> 00:09:22,530
.أنا متعب

115
00:09:24,910 --> 00:09:26,080
...أريد الموت

116
00:10:03,800 --> 00:10:07,630
.أشعر وكأنّي آكل الورق

117
00:10:17,850 --> 00:10:19,590
.أمّي، لقد عدت

118
00:10:21,830 --> 00:10:22,710
أمّي؟

119
00:10:25,220 --> 00:10:26,480
أمّي؟

120
00:10:55,630 --> 00:10:57,130
!أمّي

121
00:11:02,260 --> 00:11:03,140
!أمّي

122
00:11:06,890 --> 00:11:09,420
!أمّي

123
00:11:40,460 --> 00:11:41,680
...أمّي

124
00:11:41,680 --> 00:11:42,880
...أروتو

125
00:11:47,600 --> 00:11:50,000
!أمّي

126
00:11:54,840 --> 00:11:56,190
...أنا متعب

127
00:11:57,340 --> 00:11:59,740
...يحدث هذا دائمًا

128
00:12:00,380 --> 00:12:03,360
...توقّفي فحسب

129
00:12:11,310 --> 00:12:14,550
.أنا سفة... أنا أمّ فاشلة

130
00:12:14,550 --> 00:12:18,220
...لا مكان لي في العمل ولا في المنزل

131
00:12:18,740 --> 00:12:21,460
!عليّ أن أختفي فحسب

132
00:12:28,100 --> 00:12:29,770
...هذا ليس صحيحًا

133
00:12:30,600 --> 00:12:35,100
...آسفة... آسفة... آسفة

134
00:12:35,550 --> 00:12:38,740
...آسفة... آسفة

135
00:12:40,530 --> 00:12:41,690
...أمّي

136
00:12:42,400 --> 00:12:44,290
.لم تقترفي أيّ خطأ

137
00:12:55,900 --> 00:12:56,670
.لقد عدت

138
00:12:59,840 --> 00:13:00,670
.مرحبًا بعودتك

139
00:13:01,690 --> 00:13:02,980
.الحمّام جاهز

140
00:13:03,840 --> 00:13:05,740
.قرات رسالتك

141
00:13:06,210 --> 00:13:08,550
.تناولت أدويتها وهي بخير الآن

142
00:13:08,550 --> 00:13:10,350
.آسف لأنّي أحمّلك كلّ هذا العبء

143
00:13:10,600 --> 00:13:12,570
.واثق أنّك تفضّل اللّعب مع أصدقائك

144
00:13:12,570 --> 00:13:14,170
.الأصدقاء مزعجون

145
00:13:14,170 --> 00:13:16,510
.جميع من في المدرسة صغار

146
00:13:16,510 --> 00:13:18,970
!هيّا! اذهب واستحمّ

147
00:13:18,970 --> 00:13:22,510
!إن لم تستحمّ يا أبي، فلن أستطيع الاستحمام أيضًا

148
00:13:50,720 --> 00:13:52,640
...إن تناولته

149
00:13:59,680 --> 00:14:00,520
.تعال معي

150
00:14:00,790 --> 00:14:02,460
المزيد من الشّفقة؟

151
00:14:03,490 --> 00:14:04,900
.ليست شفقة

152
00:14:04,900 --> 00:14:07,400
.هذا أكثر ما تحتاجه الآن

153
00:14:11,480 --> 00:14:12,580
.ادخل

154
00:14:12,580 --> 00:14:14,650
.أمسموح لنا بالدّخول؟ لا أحد هنا

155
00:14:14,650 --> 00:14:17,660
.لا بأس. المالك صديق لي

156
00:14:22,850 --> 00:14:23,670
.خذ

157
00:14:24,420 --> 00:14:26,920
.اصرخ، باستعمال جسدك

158
00:14:28,680 --> 00:14:34,180
!واحد اثنان، واحد اثنان، واحد اثنان

159
00:14:36,280 --> 00:14:37,810
.هذا شعور رائع

160
00:14:38,900 --> 00:14:40,310
.هذا ما أردتُ سماعه

161
00:14:43,440 --> 00:14:45,030
!هيّا، تعال

162
00:14:51,220 --> 00:14:52,470
أكان ذلك مفاجئًا؟

163
00:14:52,990 --> 00:14:54,600
أتمازحني؟

164
00:14:54,600 --> 00:14:57,240
.سأقوم تاليًا بيُمنى فيسرى ثمّ الرّكبة اليمنى

165
00:14:57,240 --> 00:14:58,180
!حسنًا

166
00:15:04,380 --> 00:15:05,520
!تمهّل

167
00:15:05,520 --> 00:15:07,090
.تساهل معي

168
00:15:07,340 --> 00:15:08,990
آسف! هل آلمك ذلك؟

169
00:15:08,990 --> 00:15:11,510
.لم تؤلمني فحسب

170
00:15:21,170 --> 00:15:22,560
أتشعر بتحسّن؟

171
00:15:24,390 --> 00:15:27,320
.أراد جسدك الصّراخ بهذا القدر

172
00:15:37,680 --> 00:15:39,290
.أنا لا أشفق عليك

173
00:15:40,080 --> 00:15:44,580
.لأنّني لا أعرف ما الّذي تمرّ به

174
00:15:44,970 --> 00:15:48,140
.لكن وقتما أردت الصّراخ، افعل ذلك هنا

175
00:15:48,140 --> 00:15:50,340
!بأعلى صوت يمكنك

176
00:15:59,230 --> 00:16:00,890
!نوكر-أب

177
00:16:23,860 --> 00:16:24,770
.تأخّرتما

178
00:16:24,770 --> 00:16:25,630
أين الحالم؟

179
00:16:26,060 --> 00:16:27,430
!خلفها

180
00:16:32,930 --> 00:16:34,200
!أنت هناك

181
00:16:39,860 --> 00:16:43,390
.أريد... أن أختفي فحسب

182
00:16:45,830 --> 00:16:48,820
...أنا أعرض أمنيتي

183
00:16:55,360 --> 00:16:57,520
ماذا؟ أهذا ديزاريا أيضًا؟

184
00:16:57,520 --> 00:16:58,700
ما العمل؟

185
00:16:58,700 --> 00:17:00,540
.سنطلق عليه

186
00:17:04,410 --> 00:17:06,120
!كان ذلك وشيكًا يا جيسيكا

187
00:17:06,120 --> 00:17:08,210
!انتبهي إلى أين تصوّبين ذلك الشّيء

188
00:17:08,210 --> 00:17:11,040
.لا سلطة لديك عليّ لتملي الأوامر

189
00:17:11,040 --> 00:17:14,190
.لكن لا سبب لإضاعة ذخيرتك

190
00:17:17,090 --> 00:17:19,070
أين الويرد على أيّ حال؟

191
00:17:19,070 --> 00:17:20,220
.تلك هي على الأرجح

192
00:17:25,850 --> 00:17:27,800
أتلك ويرد أيضًا؟

193
00:17:27,800 --> 00:17:28,860
.على الأرجح

194
00:17:28,860 --> 00:17:30,210
.لا يوجد موطئ قدم

195
00:17:30,210 --> 00:17:32,160
.وعدوّنا مجرّد نقطة

196
00:17:32,160 --> 00:17:34,030
.لا طريقة لمهاجمتها

197
00:17:34,030 --> 00:17:35,550
!سُحقًا

198
00:17:35,550 --> 00:17:37,400
!تبًّا! تبًّا

199
00:17:37,400 --> 00:17:38,890
!ريوهي، استمع لي

200
00:17:39,830 --> 00:17:43,540
!قبل أن يصير ويرد، قال أنّه أراد أن يختفي

201
00:17:43,540 --> 00:17:46,030
،نعم. إن أراد أن يقتل نفسه

202
00:17:46,030 --> 00:17:48,250
!لم يكن بحاجة لتوريط شيبويا

203
00:17:48,630 --> 00:17:51,000
.لا أظنّ أنّ الانتحار مسعاه

204
00:17:51,860 --> 00:17:53,830
!يريد أن يختفي بالفعل

205
00:17:53,830 --> 00:17:56,720
تعرف ذلك الشّعور أيضًا، صحيح؟

206
00:17:57,870 --> 00:18:01,530
،عندما مات أخي وتداعت عائلتي

207
00:18:01,530 --> 00:18:03,140
.أردت الاختفاء أيضًا

208
00:18:03,760 --> 00:18:06,830
لكنّ الانتحار يتطلّب جهدًا، صحيح؟

209
00:18:06,830 --> 00:18:08,640
.لم أكن أملك الطّاقة حتّى لذلك

210
00:18:09,110 --> 00:18:10,150
...لذا

211
00:18:10,710 --> 00:18:12,650
.أردت أن أختفي بكلّ صمت

212
00:18:13,810 --> 00:18:16,900
لكن ما أردته بالفعل هو الصّراخ، صحيح؟

213
00:18:19,360 --> 00:18:22,660
.لديّ فكرة، لكن لا يمكنني تنفيذها وحدي

214
00:18:22,660 --> 00:18:25,160
!حسنًا، يمكنك الاعتماد عليّ

215
00:18:25,550 --> 00:18:27,040
!نعم، شكرًا لك

216
00:18:31,550 --> 00:18:33,830
!ذلك ليس ما يعنيه الاعتماد على شخص ما

217
00:18:33,830 --> 00:18:35,050
!مهلاً، أنت

218
00:18:37,620 --> 00:18:41,050
.حتّى أن محوت العالم بأسره، فلن تختفي

219
00:18:41,050 --> 00:18:43,050
.ولن يختفي ألمك أيضًا

220
00:18:43,310 --> 00:18:45,560
.يا لأروتو ذاك

221
00:18:45,560 --> 00:18:47,060
!ريوهي، خلفك

222
00:18:49,190 --> 00:18:50,190
!مهلاً لحظة

223
00:18:54,650 --> 00:18:57,840
.هنالك من بحاجتك

224
00:18:58,560 --> 00:19:01,830
.لكن لا يهمّ كم مرّة سأخبرك بذلك، فلن تفهم

225
00:19:08,520 --> 00:19:12,070
.هذا كلّ ما يمكنني قوله لك

226
00:19:16,770 --> 00:19:18,110
...كم هذا دافئ

227
00:19:18,640 --> 00:19:20,140
.صحيح

228
00:19:20,140 --> 00:19:22,010
...ما أردتُه

229
00:19:23,110 --> 00:19:25,220
.هو دفء أحدهم

230
00:19:43,110 --> 00:19:44,560
...أيّتها

231
00:19:44,560 --> 00:19:46,620
.اهدآ، انتهى الأمر

232
00:19:47,030 --> 00:19:49,540
.هزمت الويرد دون محوه

233
00:19:49,540 --> 00:19:51,300
.أحسنت يا أروتو

234
00:19:58,510 --> 00:20:00,600
ألن يستيقظ أبدًا؟

235
00:20:00,600 --> 00:20:01,550
...نعم

236
00:20:01,550 --> 00:20:04,400
لكنّه تحرّر من ألمه، صحيح؟

237
00:20:05,230 --> 00:20:07,060
!لا أحبّ هذا

238
00:20:07,060 --> 00:20:11,400
!أرفض أن أقبل تحرّر شخصٍ ما من ألمه بهذه الطريقة

239
00:20:11,400 --> 00:20:12,940
.ولا أنا

240
00:20:14,320 --> 00:20:17,180
...لذلك

241
00:20:18,240 --> 00:20:20,320
هلاّ تأتي معي؟

242
00:20:21,550 --> 00:20:27,950
اسمع أيّتها الغبية، لا تستعملي عيدان الأسنان لتثبيت
.لفائف الملفوف بل السباغيتّي الجافّ

243
00:20:27,950 --> 00:20:30,100
لماذا تتفاخر بكونك ربّة منزل جيّدة؟

244
00:20:30,100 --> 00:20:31,020
.أنا متفاجئة

245
00:20:31,020 --> 00:20:31,830
بشأن ماذا؟

246
00:20:31,830 --> 00:20:34,110
!لا يبدو عليك أنّك تجيد الطّهي

247
00:20:34,110 --> 00:20:35,740
!الطّبخ سهل

248
00:20:36,610 --> 00:20:38,210
.آسف على الضّجيج

249
00:20:39,120 --> 00:20:41,270
.هذا لأنّ إيري أميرة

250
00:20:45,800 --> 00:20:48,350
هل بإمكاني البقاء هكذا لوهلة؟

251
00:20:51,260 --> 00:20:52,560
...أنا آسفة

252
00:20:53,830 --> 00:20:55,740
...آسف يا أمّي

253
00:20:56,440 --> 00:20:58,780
...ظننتُ أنّه كان عليّ بذل جهدي

254
00:20:58,780 --> 00:21:00,670
.لكنّي كنت قد بلغت حدودي

255
00:21:01,350 --> 00:21:04,990
.لكن لديّ الآن أصدقاء لأعتمد عليهم

256
00:21:10,670 --> 00:21:12,030
...أروتو

257
00:21:12,030 --> 00:21:13,870
...أنت دافئ للغاية

258
00:21:14,220 --> 00:21:15,630
...وكذلك أنت يا أمّي

259
00:21:28,000 --> 00:21:29,010
...هذا لذيذ

260
00:21:29,010 --> 00:21:30,310
!أجل

261
00:21:30,310 --> 00:21:32,100
أنا رائع، صحيح؟

262
00:23:24,960 --> 00:23:27,340
الحلقة القادمة

263
00:23:25,740 --> 00:23:27,340
.نحكم جميعًا على الآخرين

264
00:23:27,340 --> 00:23:30,680
.لكنّ نتائج ذلك الحكم قد لا تصيب

265
00:23:30,680 --> 00:23:33,220
.ومن نحكم عليهم لا يندمون دائمًا

266
00:23:33,220 --> 00:23:37,600
.تمتدّ أيادي الإغراء المظلمة نحو قلب ضحيّة تعاني

267
00:23:37,600 --> 00:23:40,060
قراري الخاصّ

268
00:23:37,940 --> 00:23:39,980
."في الحلقة القادمة: "قراري الخاصّ