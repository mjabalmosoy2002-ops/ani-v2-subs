1
00:00:00,520 --> 00:00:05,100
.أمنيتي هي حمايتك

2
00:00:05,100 --> 00:00:08,320
!أرأيتم؟ إنّها تهتمّ لأصدقائها

3
00:00:13,830 --> 00:00:14,920
!أودا-كُن

4
00:00:14,920 --> 00:00:15,740
!ريوهي

5
00:00:18,410 --> 00:00:20,970
.رينا... أنا آسف

6
00:00:20,970 --> 00:00:24,060
.لجعلك تأخذين مكاني

7
00:00:30,560 --> 00:00:34,360
.لم تكوني بحاجة لعرض أمنيتك

8
00:00:34,360 --> 00:00:36,140
...إن فعلتُ أنا

9
00:00:38,390 --> 00:00:42,980
.آسف لجعلك تعانين يا رينا

10
00:00:51,710 --> 00:00:53,860
.أهلاً بعودتك يا رينا

11
00:00:59,820 --> 00:01:02,120
!لقد عادت لتكون نوكر-أب

12
00:01:02,120 --> 00:01:03,580
...مستحيل

13
00:01:05,240 --> 00:01:06,380
!ريوهي

14
00:01:09,630 --> 00:01:11,750
ما الخطب يا ريوهي؟

15
00:01:11,750 --> 00:01:14,140
!ريوهي! ريوهي

16
00:01:22,500 --> 00:01:24,730
!ريوهي! ريوهي

17
00:01:25,080 --> 00:01:26,630
.ريوهي، أنا آسفة

18
00:01:27,520 --> 00:01:30,480
...لم أقصد أن

19
00:01:32,220 --> 00:01:33,720
.اهدئي

20
00:01:35,990 --> 00:01:37,740
!توقّف! لا تخرجه بالقوّة

21
00:01:37,740 --> 00:01:44,250
!اخرسي! هكذا... أقوم بالأمور

22
00:01:55,630 --> 00:01:57,020
!ريوهي

23
00:02:03,370 --> 00:02:05,780
.آسف لكم جميعًا

24
00:02:06,520 --> 00:02:12,440
!انسوا أمري... اهزموا ذلك الكتولهوغ فحسب

25
00:02:12,440 --> 00:02:15,190
!لا أستطيع تركك هنا

26
00:02:15,190 --> 00:02:18,940
.إن لم تهزموا الكتولهوغ، فسينتهي العالم

27
00:02:18,940 --> 00:02:20,570
أليس كذلك يا تريس؟

28
00:02:20,570 --> 00:02:26,540
!نعم. دعوا هذا الأمر يلي واهزموا الكتولهوغ

29
00:02:26,540 --> 00:02:27,180
...لكن

30
00:02:27,180 --> 00:02:28,330
!بدون لكن

31
00:02:31,960 --> 00:02:34,000
.حميت صديقتي

32
00:02:35,100 --> 00:02:38,340
!والآن حان دوركم لحماية العالم

33
00:02:41,760 --> 00:02:44,850
...تبعيد قبيحة بالفعل عندما تبكين

34
00:02:53,500 --> 00:02:56,060
.لن أسمح لك بمناداتي بالقبيحة ثانية

35
00:02:59,780 --> 00:03:03,460
.هذه المرّة، سأقاتل لحمايتك بالفعل

36
00:03:03,460 --> 00:03:05,240
!يا رفاق، ساعدوني

37
00:03:05,480 --> 00:03:06,320
!أكيد

38
00:03:13,390 --> 00:03:14,790
.أنا ذاهبة

39
00:03:15,230 --> 00:03:16,050
.نعم

40
00:03:29,830 --> 00:03:31,050
أنجح الأمر؟

41
00:03:31,050 --> 00:03:34,650
.إنّه أكبر بكثيري الآن. سيأخذ الأمر وقتًا أكثر

42
00:03:46,830 --> 00:03:50,330
إنّه يمتصّ أجسام الدّيزاريا النّجميّة
!ليعيد تجديد نفسه

43
00:03:50,720 --> 00:03:52,840
إنّه الدّيزاريا خاصّتي، صحيح؟

44
00:03:52,840 --> 00:03:53,810
.صحيح

45
00:03:53,810 --> 00:03:57,640
!إذًا... بإمكاني التّحكّم به

46
00:04:41,720 --> 00:04:43,530
!توقّفي! لا يمكنك ذلك

47
00:04:44,130 --> 00:04:45,390
!هذا صحيح يا رينا

48
00:04:45,390 --> 00:04:48,970
،حتّى إن كان الدّيزاريا خاصّتك
...حتّى إن واصلتِ القيام بهذا

49
00:04:48,970 --> 00:04:51,100
إن لم أبالغ في أوقات كهذه، فمتى إذًا؟

50
00:04:52,100 --> 00:04:53,580
!اذهبوا جميعًا

51
00:05:18,400 --> 00:05:19,670
!نلت منك

52
00:05:50,730 --> 00:05:52,740
أأنت بخير يا ريوهي؟

53
00:05:53,410 --> 00:05:56,750
هل سأمون هنا؟

54
00:05:57,120 --> 00:06:00,630
يستطيع جسدك النّجميّ إعادة تجديد
.نفسه بما يكفي من الوقت

55
00:06:01,040 --> 00:06:02,660
فعلاً؟

56
00:06:02,660 --> 00:06:04,820
...لكنّ ذلك الوقت

57
00:06:06,940 --> 00:06:08,750
!أكثر ممّا بقي لي، صحيح؟

58
00:06:13,750 --> 00:06:15,330
!اهرب يا تريس

59
00:06:15,330 --> 00:06:16,390
!بسرعة

60
00:06:18,930 --> 00:06:21,400
!ما الّذي تفعله؟ اهرب بسرعة

61
00:06:25,610 --> 00:06:26,780
تريس؟

62
00:06:27,820 --> 00:06:28,730
...إنّك

63
00:06:29,500 --> 00:06:33,530
!هذا كلّ ما أستطيع فعله الآن

64
00:06:48,280 --> 00:06:49,590
هل أنت بخير؟

65
00:06:50,200 --> 00:06:53,140
.لا أريدك أن قلق عليّ

66
00:06:54,560 --> 00:06:55,590
فعلاً؟

67
00:06:57,010 --> 00:07:01,130
أخبرني، قلتَ أنّ هنالك نوكر-أب
آخرين على يوراجيما، صحيح؟

68
00:07:01,130 --> 00:07:03,230
لديك مشاكل أكبر الآن، صحيح؟

69
00:07:03,570 --> 00:07:06,020
.أحضرهم إلى هنا

70
00:07:06,020 --> 00:07:09,980
!صحيح! بإمكاننا الاستفادة من مساعدتهم

71
00:07:09,980 --> 00:07:11,130
!مفهوم

72
00:07:14,540 --> 00:07:16,740
...لكن يا ريوهي

73
00:07:16,740 --> 00:07:19,870
.لن أموت بتلك السّهولة

74
00:07:20,220 --> 00:07:23,740
أنت مبعوث للإله تحمي نظام الكون، صحيح؟

75
00:07:23,740 --> 00:07:26,130
.قم بواجبك

76
00:07:27,920 --> 00:07:29,100
.حاضر

77
00:07:33,980 --> 00:07:35,820
...ولكن اعلم

78
00:07:36,600 --> 00:07:40,740
.لا أظنّني سأنجو حتّى عودتك

79
00:07:58,730 --> 00:07:59,790
!ريوهي

80
00:08:01,000 --> 00:08:02,580
!لم أرك منذ وقت طويل

81
00:08:05,000 --> 00:08:08,670
ما الّذي تحاول دفعي لأقوم به
!هذه المرّة مستغلاًّ جسد أخي؟

82
00:08:08,670 --> 00:08:11,550
!كلاّ، هذا أنا! جونبي الحقيقيّ

83
00:08:11,550 --> 00:08:14,180
!لا تلحق العار بأخي

84
00:08:15,360 --> 00:08:16,930
!ريوهي

85
00:08:21,430 --> 00:08:22,730
!ريوهي

86
00:08:25,650 --> 00:08:27,520
.اهدأ يا ريوهي

87
00:08:27,520 --> 00:08:31,090
.يبدو أنّه قام بأمر فظيع لك

88
00:08:32,920 --> 00:08:34,910
.إنّه خصم فظيع

89
00:08:35,480 --> 00:08:39,330
.حاول التّسلّل إلى دماغي باستخدام كلامه المعسول

90
00:08:39,900 --> 00:08:44,580
،قائلاً أنّه سيعلّمني حقيقة العالم
...أو جعلي ملكًا عليه

91
00:08:45,340 --> 00:08:48,160
ظننتُ أنّني في مأمن ما دمت

92
00:08:48,160 --> 00:08:51,640
،لن أعود أبدًا إلى داخل الترويميراي
...أو إلى أيّ مكان قريب منه

93
00:08:51,640 --> 00:08:52,760
.لكنّني كنت مخطئًا

94
00:08:53,630 --> 00:08:59,350
.لم أظنّ أبدًا أنّه سيقتلني أمام عينيك مباشرة

95
00:09:17,320 --> 00:09:21,540
كلّ ما أمكنني فعله هو رسم
.علامة الكنيسة لتحذيرك

96
00:09:21,540 --> 00:09:23,630
.كان يفترض أن أموت

97
00:09:26,240 --> 00:09:28,940
،صارت عظامي وعاءً له

98
00:09:28,940 --> 00:09:34,040
.وروحي مقيّدة بهذا العالم في معانات أبديّة

99
00:09:35,720 --> 00:09:39,340
هل أنت أخي بالفعل؟

100
00:09:40,100 --> 00:09:42,450
.نعم. هذا أنا

101
00:09:42,450 --> 00:09:43,580
!أخي

102
00:09:45,180 --> 00:09:47,280
!أخي

103
00:09:47,280 --> 00:09:48,180
...نعم

104
00:10:02,460 --> 00:10:03,660
،ريوهي

105
00:10:05,030 --> 00:10:06,660
.تحلّ بالقوّة

106
00:10:06,660 --> 00:10:11,050
.لا يعني التّحلّي بالقوّة أن تقدر على لكم النّاس فحسب

107
00:10:11,050 --> 00:10:13,460
.بل يعني أن تقدر على حماية شخص ما

108
00:10:13,770 --> 00:10:14,710
...حسنًا

109
00:10:14,710 --> 00:10:16,630
!جيّد، سرّني سماع ذلك

110
00:10:22,870 --> 00:10:25,350
.صرت قويًّا للغاية

111
00:10:25,920 --> 00:10:29,100
.لذلك استمع لأمنيتي

112
00:10:29,650 --> 00:10:30,690
ماذا؟

113
00:10:32,570 --> 00:10:34,160
.اقتلني

114
00:10:41,670 --> 00:10:45,370
!كلاّ... لا يمكنني فعل ذلك

115
00:10:45,370 --> 00:10:47,500
!بل يمكنك

116
00:10:47,500 --> 00:10:48,750
!لا يمكنني

117
00:10:48,750 --> 00:10:52,820
!روحي تتعذّب وغير قادرة حتّى على الموت

118
00:10:52,820 --> 00:10:54,310
!لذلك اقتلني رجاءً

119
00:10:55,630 --> 00:11:00,380
وعدتَ أن تصير أقوى لحماية شخص ما، صحيح؟

120
00:11:00,380 --> 00:11:03,180
!احم روحي منه

121
00:11:03,180 --> 00:11:04,770
!لا! لا يمكنني فعل ذلك

122
00:11:04,770 --> 00:11:06,800
!إنّها الطّريقة الوحيدة

123
00:11:06,800 --> 00:11:08,870
!قلتُ لا

124
00:11:08,870 --> 00:11:10,320
!أنت الوحيد الّذي يمكنني طلب ذلك منه

125
00:11:10,320 --> 00:11:12,090
!أنت لا تفهم

126
00:11:13,410 --> 00:11:18,370
!حاولتُ أن أصير أقوى بعد مماتك

127
00:11:19,040 --> 00:11:24,350
!ظننتُ إنّني كنتُ أقوى، لأمكنني حمايتك

128
00:11:24,910 --> 00:11:27,650
...والآن... والآن

129
00:11:28,410 --> 00:11:31,790
!حاولتُ أن أصير أقوى لكي لا أخسرك ثانية

130
00:11:32,440 --> 00:11:34,250
!لا يمكنني فعل ذلك

131
00:11:35,250 --> 00:11:36,810
!أعلم أنّه يمكنك

132
00:11:37,740 --> 00:11:39,430
!أنت قويّ

133
00:11:39,430 --> 00:11:40,920
!أقوى منّي

134
00:11:40,920 --> 00:11:42,990
...ذلك ليس صحيحًا

135
00:11:42,990 --> 00:11:45,630
!لا يمكنني أن أكون أقوى منك

136
00:11:45,630 --> 00:11:48,560
!لا صحّة في ذلك! أرفض أن يكون ذلك صحيحًا

137
00:11:48,560 --> 00:11:51,060
.لنقم بذلك معًا إذًا

138
00:11:56,140 --> 00:11:57,570
أخي؟

139
00:12:03,900 --> 00:12:05,000
أأنت بخير؟

140
00:12:05,000 --> 00:12:06,220
.نوعًا ما

141
00:12:06,220 --> 00:12:07,920
لكن هل لاحظت؟

142
00:12:08,540 --> 00:12:11,010
...ثمّة بنايات أقلّ

143
00:12:11,010 --> 00:12:13,650
.كلنا أنا ورينا قد بلغنا حدودنا

144
00:12:29,680 --> 00:12:30,470
!أروتو

145
00:13:05,130 --> 00:13:06,130
!راندو-كُن

146
00:13:36,680 --> 00:13:37,770
...تبًّا

147
00:13:38,270 --> 00:13:40,500
لا يمكننا هزيمته وحدنا؟

148
00:13:42,310 --> 00:13:44,440
إرو، أأنت بخير؟

149
00:13:44,440 --> 00:13:46,880
هل سينتهي العالم؟

150
00:13:53,920 --> 00:13:55,700
!انتظر يا ريوهي

151
00:13:59,150 --> 00:14:01,400
!سأوقفك

152
00:14:24,190 --> 00:14:25,300
هل نلنا منه؟

153
00:14:50,980 --> 00:14:52,220
...كلاّ

154
00:14:53,440 --> 00:14:54,490
!كلاّ

155
00:14:55,410 --> 00:14:58,250
!رينا

156
00:15:16,770 --> 00:15:17,640
ريوهي؟

157
00:15:17,640 --> 00:15:20,390
!ريوهي-كُن

158
00:15:18,520 --> 00:15:21,770
!ريوهي

159
00:15:22,160 --> 00:15:23,630
.أبليتِ بلاءً حسنًا

160
00:15:24,400 --> 00:15:25,900
.دعي البقيّة لي الآن

161
00:15:26,480 --> 00:15:27,690
!أودا-كُن

162
00:15:28,210 --> 00:15:29,130
!رينا

163
00:15:31,930 --> 00:15:34,000
.إيبوساكي، اعتني برينا

164
00:15:34,000 --> 00:15:35,070
.مفهوم

165
00:15:35,650 --> 00:15:40,430
.ريوهي، سأدعوك لتناول السّوشي في المرّة القادمة

166
00:15:41,290 --> 00:15:45,920
.لذلك... عد حيًّا

167
00:16:09,530 --> 00:16:11,070
...مذهل

168
00:16:11,070 --> 00:16:13,110
أنّه بنفس قوّة ذلك الوحش؟

169
00:16:21,280 --> 00:16:23,750
ما زال مصابًا؟

170
00:16:28,070 --> 00:16:31,510
إنّه يمتصّ جسد الدّيزاريا النّجميّ
!ويعيد تجديد نفسه

171
00:16:32,380 --> 00:16:34,760
!ريوهي، استعمل جسدي النّجميّ

172
00:16:34,760 --> 00:16:36,390
!لا يمكنني ذلك

173
00:16:36,390 --> 00:16:37,890
!أظنّك تستطيع الآن

174
00:16:38,150 --> 00:16:39,760
!جرّب ذلك

175
00:16:39,760 --> 00:16:43,270
!استعمل أجسادنا النّجميّة لهزيمته

176
00:16:43,270 --> 00:16:46,650
!نعم

177
00:17:11,870 --> 00:17:13,800
ألسنا أقوياء كفاية؟

178
00:17:16,380 --> 00:17:19,400
!ذلك... تريس، شويتشي

179
00:17:19,400 --> 00:17:20,140
والآخرون أيضًا؟

180
00:17:20,560 --> 00:17:25,520
لم أكن أعلم أنّه من الممكن جمع
...أجساد النوكر-أب النّجميّة

181
00:17:25,520 --> 00:17:26,960
!رجاءً جميعًا

182
00:17:26,960 --> 00:17:28,150
!ساعدوني

183
00:17:29,030 --> 00:17:29,790
.نعم

184
00:17:30,770 --> 00:17:33,400
!أعطوا أجسادكم النّجمية جميعًا لريوهي

185
00:18:29,040 --> 00:18:30,690
!هذه هي

186
00:19:04,560 --> 00:19:05,620
!أخي

187
00:19:07,090 --> 00:19:09,250
.شكرًا يا ريوهي

188
00:19:09,840 --> 00:19:11,430
!أخي

189
00:19:36,310 --> 00:19:37,420
!أودا-كُن

190
00:19:37,920 --> 00:19:39,440
!ريوهي

191
00:19:42,320 --> 00:19:45,530
.أخي... رحل

192
00:19:46,780 --> 00:19:47,490
.نعم

193
00:19:50,530 --> 00:19:54,430
."لقد تحرّر من قبضة "الأشرار

194
00:19:54,430 --> 00:19:55,340
.هذا صحيح

195
00:19:55,690 --> 00:19:58,090
.نجونا والفضل لك في ذلك

196
00:20:01,920 --> 00:20:03,010
...رفاق

197
00:20:06,460 --> 00:20:09,100
.نعم. هذا صحيح

198
00:20:11,360 --> 00:20:12,250
...ريوهي

199
00:20:12,800 --> 00:20:14,100
!راندو

200
00:20:14,370 --> 00:20:18,050
."بفضلك، تمّت حماية شيبويا من "الأشرار

201
00:20:18,590 --> 00:20:19,640
.شكرًا لك

202
00:20:19,640 --> 00:20:21,790
!شكرًا يا ريوهي-كُن

203
00:20:21,790 --> 00:20:22,620
.إرو

204
00:20:23,120 --> 00:20:26,000
!ريوهي، أبليت حسنًا

205
00:20:26,000 --> 00:20:27,210
!أثرت إعجابي

206
00:20:27,210 --> 00:20:28,120
...تريس

207
00:20:29,050 --> 00:20:32,370
أكان هذا للأفضل يا راندو؟

208
00:20:34,970 --> 00:20:36,250
!لنعد للجزيرة

209
00:20:43,650 --> 00:20:44,510
.مع السّلامة

210
00:20:45,660 --> 00:20:47,010
!إلى اللّقاء يا صديقي

211
00:20:47,010 --> 00:20:47,700
.نعم

212
00:20:53,150 --> 00:20:55,410
.سأعود أنا للجزيرة

213
00:20:56,300 --> 00:20:58,650
ستغادر أنت أيضًا؟

214
00:20:58,650 --> 00:21:01,240
.ما حدث على الجزيرة لم ينتهي بعد

215
00:21:01,240 --> 00:21:06,030
.وما حدث في شيبويا قد لا يكون قد انتهى فعلاً

216
00:21:06,030 --> 00:21:10,230
سيبحث "الأشرار" دائمًا عن ثغرات
في قلوب النّاس

217
00:21:10,230 --> 00:21:14,330
يتمكّنون بها من الدّخول وفتحها
.بالقوّة ليتمكّنوا ون ولوج هذا العالم

218
00:21:15,100 --> 00:21:19,700
!من الصّعب كثيرًا الحفاظ على نظام العالم

219
00:21:19,700 --> 00:21:24,300
.مع السّلامة للجميع
!زوروا يوراجيما يومًا ما إن استطعتم

220
00:21:24,830 --> 00:21:25,680
!أكيد

221
00:21:31,550 --> 00:21:33,170
.لقد ذهب

222
00:21:33,170 --> 00:21:35,760
.لكنّه على حقّ

223
00:21:35,760 --> 00:21:36,940
.لم ينتهِ الأمر

224
00:21:37,900 --> 00:21:38,980
.هذا صحيح

225
00:21:39,630 --> 00:21:41,130
.لقد حلّ الصّباح

226
00:21:46,460 --> 00:21:49,270
انتهى وقت الأحلام إذًا؟