1
00:00:02,720 --> 00:00:07,780
،لا يهمّ كم سيأتي من النّوكر-أب
.فلا يمكن تغيير القدر

2
00:00:09,680 --> 00:00:12,540
،شيبويا هي الأرض المختارة

3
00:00:13,480 --> 00:00:15,990
...مطهّرة بدماء أراقتها الدّيزاريا

4
00:00:16,410 --> 00:00:19,500
...علينا جعلها تتجسّد

5
00:02:09,620 --> 00:02:13,520
!بسرعة! توشك الترويميراي أن تصبح ديزاريا

6
00:02:14,020 --> 00:02:15,030
!هناك

7
00:02:20,660 --> 00:02:22,310
!مهلاً

8
00:02:22,310 --> 00:02:24,290
!ما الّذي تفعلينه؟ بسرعة

9
00:02:24,290 --> 00:02:26,790
!انتظروا رجاءً

10
00:02:27,120 --> 00:02:28,910
!ثمّة ترويميراي

11
00:02:29,360 --> 00:02:30,790
!انتبه أمامك يا أودا-كُن

12
00:02:36,720 --> 00:02:37,800
!بدا ذلك مؤلمًا

13
00:02:38,100 --> 00:02:39,620
!نراك لاحقًا

14
00:02:43,390 --> 00:02:45,590
!انتظرا كلاكما

15
00:02:54,060 --> 00:02:56,480
...لقد تركاني، سُحقًا

16
00:03:00,650 --> 00:03:03,120
!بسرعة! بسرعة

17
00:03:14,380 --> 00:03:15,380
!أنت بطيء

18
00:03:16,130 --> 00:03:16,710
!انتظر

19
00:03:20,170 --> 00:03:21,220
!هيّا يا إرو

20
00:03:22,240 --> 00:03:23,620
!استعملا مصعدًا آخر

21
00:03:23,620 --> 00:03:25,180
هذا هو الأسرع، صحيح؟

22
00:03:33,560 --> 00:03:35,190
!إنّه بطيء جدًّا

23
00:03:36,310 --> 00:03:37,340
.لا بأس

24
00:03:54,760 --> 00:03:56,430
ما الّذي يحدث؟

25
00:03:59,160 --> 00:04:00,460
!لقد توقّف

26
00:04:01,160 --> 00:04:02,840
هل تسمعونني؟

27
00:04:04,600 --> 00:04:07,680
قولوا شيئًا! أيمكنكم سماعي؟

28
00:04:10,110 --> 00:04:11,560
...أيّها الـ

29
00:04:13,200 --> 00:04:13,710
...عفوًا

30
00:04:13,710 --> 00:04:14,770
!اخرس

31
00:04:16,300 --> 00:04:17,050
.اسمع

32
00:04:18,390 --> 00:04:19,600
.لا فائدة

33
00:04:22,200 --> 00:04:24,410
.يبدو أنّه لا توجد إشارة ولا وايفاي

34
00:04:27,530 --> 00:04:29,160
!سُحقًا

35
00:04:30,330 --> 00:04:33,860
هل هناك من يسمعني؟

36
00:04:33,860 --> 00:04:35,420
!أتسمعونني؟

37
00:04:36,420 --> 00:04:38,290
!هيّا! أيّ أحد

38
00:04:37,240 --> 00:04:38,290
!إرو

39
00:04:43,040 --> 00:04:44,930
!سُحقًا

40
00:04:53,210 --> 00:04:54,290
.اسمع

41
00:04:54,290 --> 00:04:56,650
ماذا تريد الآن؟

42
00:04:57,220 --> 00:05:00,020
.من الخطير فتح باب مصعد متوقّف

43
00:05:00,710 --> 00:05:02,280
لماذا؟

44
00:05:02,820 --> 00:05:04,780
ما الّذي سيحدث إن فتحت ذلك الباب

45
00:05:05,500 --> 00:05:08,410
وبدأ المصعد بالتّحرّك بمجرّد أن تخطو خارجه؟

46
00:05:11,480 --> 00:05:13,120
.سنغادر إذًا عن طريق بوّابة التّفتيش

47
00:05:13,120 --> 00:05:15,160
.لا أنصح بذلك أيضًا

48
00:05:15,910 --> 00:05:18,210
،نرى ذلك في أفلام الحركة كثيرًا

49
00:05:18,210 --> 00:05:21,550
.لكنّ احتمال توقّفه في مكان مناسب ضعيف

50
00:05:21,550 --> 00:05:23,550
ما الّذي نفعله إذًا؟

51
00:05:24,920 --> 00:05:29,050
اهدأ وانتظر قدوم المساعدة
.أو بدء المصعد بالتّحرّك ثانية

52
00:05:30,600 --> 00:05:32,600
!لا يمكنني أن أهدأ

53
00:05:32,600 --> 00:05:34,310
!ثمّة ترويميراي في الخارج

54
00:05:34,310 --> 00:05:38,310
.حتّى إن كان، هذا كلّ ما يمكننا فعله الآن

55
00:05:40,810 --> 00:05:43,440
!لا يمكنني الجلوس هنا فحسب

56
00:05:45,480 --> 00:05:48,450
!النّجدة! هل يوجد أيّ أحد في الخارج؟

57
00:05:48,850 --> 00:05:52,590
!أتسمعونني؟! أتسمعونني؟! أتسمعونني؟

58
00:05:53,200 --> 00:05:55,400
!أتسمعونني؟

59
00:05:57,800 --> 00:05:58,890
.سُحقًا

60
00:06:07,640 --> 00:06:10,340
أراهن أنّك سعيد لأنّ هذه الأمور
لا تحدث في الجزيرة، صحيح؟

61
00:06:10,680 --> 00:06:12,360
.لدينا مصاعد أيضًا

62
00:06:12,360 --> 00:06:14,860
فعلاً، أهذا صحيح؟

63
00:06:14,860 --> 00:06:18,730
العيش على جزيرة لا يعني أنّنا نعيش
.في عصر ما قبل التّاريخ

64
00:06:19,080 --> 00:06:22,160
.لدينا وايفاي وهواتف محمولة

65
00:06:22,160 --> 00:06:23,110
.هذا طبيعيّ

66
00:06:23,480 --> 00:06:27,780
وتريدني أن أعلم أنّك لاحظت الأمر
قبلي أنا ساكن طوكيو، صحيح؟

67
00:06:27,780 --> 00:06:28,840
.لنجلس

68
00:06:28,840 --> 00:06:29,530
.حسنًا

69
00:06:33,360 --> 00:06:34,910
.أنت، لا تتجاهلني

70
00:06:35,370 --> 00:06:36,270
هل أنت بخير؟

71
00:06:37,040 --> 00:06:39,160
!أنت! قل شيئًا

72
00:06:39,740 --> 00:06:45,050
أتوقّع أنّ الحالم قد عرض أمنيته
.وظهرت الدّيزاريا

73
00:06:45,670 --> 00:06:48,920
...حسنًا، ذلك تخمين واضح

74
00:06:48,920 --> 00:06:51,910
محطّات توصيل الشّبكات الإلكترونيّة
والهواتف المحمولة الأساسيّة هنا

75
00:06:51,910 --> 00:06:53,930
.قد التُهمت من طرف الدّيزاريا على الأرجح

76
00:06:53,930 --> 00:06:56,030
هذا هو السّبب؟

77
00:06:56,030 --> 00:06:57,010
أتشعرين بالبرد؟

78
00:06:57,560 --> 00:06:58,690
.لا

79
00:07:05,110 --> 00:07:07,480
هل تلك الجزيرة رائعة لهذا الحدّ؟

80
00:07:07,800 --> 00:07:10,480
،أجهل كيف قد تشعر حيالها

81
00:07:10,480 --> 00:07:11,380
.لكنّني أحبّها

82
00:07:12,000 --> 00:07:13,280
ما الجيّد كثيرًا فيها؟

83
00:07:13,960 --> 00:07:16,490
.تغطّي الطّبيعة جزءًا كبيرًا منها

84
00:07:16,490 --> 00:07:18,270
!نعم، هذا ما يقوله الجميع

85
00:07:19,120 --> 00:07:20,460
.النّاس لطفاء أيضًا

86
00:07:20,460 --> 00:07:22,210
!هذا ما يقوله الجميع أيضًا

87
00:07:22,210 --> 00:07:27,710
يقول جميع من في الأرياف نفس
.الشّيء عندما يأتون إلى طوكيو

88
00:07:28,570 --> 00:07:30,970
.كنت أعيش في طوكيو حتّى مدّة قصيرة

89
00:07:32,590 --> 00:07:35,470
.كبرت في الجزيرة حتّى بلغت العاشرة

90
00:07:41,170 --> 00:07:44,800
.ثمّ انتقلتُ إلى طوكيو لأسباب تتعلّق بأبي

91
00:07:46,020 --> 00:07:48,970
.لذلك قضيت الكثير من الوقت في طوكيو

92
00:07:48,970 --> 00:07:51,280
.توقّف إذًا عن ذكر الجزيرة مرارًا

93
00:07:51,680 --> 00:07:54,280
.لم أستطع الحصول على أيّ أصدقاء في طوكيو

94
00:07:54,670 --> 00:07:57,480
هنالك أماكن مهمّة لديك ذكريات مهمّة فيها، صحيح؟

95
00:07:57,480 --> 00:08:00,580
.قلعة طوكيو أو مركز أطفال طوكيو

96
00:08:02,450 --> 00:08:04,540
.كلاهما اختفى الآن

97
00:08:05,650 --> 00:08:09,880
،لو كانا ما زالا موجودين
أما كنت لتعتبرهما ملاذًا لك؟

98
00:08:11,110 --> 00:08:13,550
.ذلك ما تعنيه لي الجزيرة

99
00:08:14,360 --> 00:08:17,680
.ما زالت الأماكن الّتي لعبنا فيها كأطفال موجودة هناك

100
00:08:18,400 --> 00:08:21,610
.في نظري، الجزيرة هي ملاذي

101
00:08:23,610 --> 00:08:27,430
.اعتاد أخي أن يأخذني إلى مركز الأطفال دائمًا

102
00:08:28,730 --> 00:08:33,760
.أتذكّر ذلك القدْر، لكنّني لا أتذكّر الكثير غير ذلك

103
00:08:33,760 --> 00:08:35,320
.لم يعد المكان موجودًا

104
00:08:35,960 --> 00:08:38,580
.تتغيّر طوكيو سريعًا

105
00:08:39,010 --> 00:08:41,590
.لا وقت لديك للتّذكّر

106
00:08:41,590 --> 00:08:43,590
.كلّ شيء يذهب مهبّ الرّيح

107
00:08:44,820 --> 00:08:50,960
".المياه في النّهر دائمة التّدفّق ودائمة التّغيير"

108
00:08:52,170 --> 00:08:54,740
"...والفقاعات في الأماكن الرّاكدة"

109
00:08:54,740 --> 00:09:01,060
،تتشكّل تارة وتختفي تارة"
".لكنّ لا واحدة منها تظلّ للأبد

110
00:09:02,430 --> 00:09:04,600
!يكفي

111
00:09:04,600 --> 00:09:09,190
،تذكّرت وجه يوشيتاتسو للتّوّ
.أستاذي في مادّة اليابانيّة الكلاسيكيّة

112
00:09:07,270 --> 00:09:09,190
سجلاّت كوخ للمؤلّف
كامو نو تشومي

113
00:09:07,270 --> 00:09:09,190
...سجلاّت كوخ

114
00:09:12,630 --> 00:09:15,820
.ثمّة الكثير من الأساطير الغريبة على الجزيرة

115
00:09:17,040 --> 00:09:18,460
مثل ماذا؟

116
00:09:20,190 --> 00:09:24,080
.على سبيل المثال، عودة الأموات للحياة

117
00:09:24,080 --> 00:09:25,980
عودة الأموات للحياة؟

118
00:09:26,750 --> 00:09:28,430
مثل الزّومبي؟

119
00:09:28,430 --> 00:09:30,960
.لا. بطريقة مختلفة

120
00:09:33,560 --> 00:09:34,900
،في قديم الزّمان

121
00:09:35,400 --> 00:09:40,070
.ماتت ابنة كبير القرية في ربيعها السّادس عشر

122
00:09:41,600 --> 00:09:44,400
،تملّكه حزن شديد

123
00:09:44,400 --> 00:09:47,660
.لكنّه تذكّر قصّة حاصد الأرواح كيوو

124
00:09:48,170 --> 00:09:51,850
ما-ما هو حاصد الأرواح كيوو؟

125
00:09:52,640 --> 00:09:54,980
...لا أدري أيضًا، ولكن

126
00:09:56,160 --> 00:09:58,200
،حاصد الأرواح إله أيضًا

127
00:09:58,200 --> 00:09:59,940
.لذلك بإمكان تقديم قرابين له

128
00:10:01,160 --> 00:10:04,910
،لذلك حضّر له وليمة أمام قصره

129
00:10:06,770 --> 00:10:09,040
.ثمّ ظهر أوني

130
00:10:11,120 --> 00:10:15,050
،حاول الأوني دخول منزله

131
00:10:15,480 --> 00:10:22,330
لكنّه قال، "أتقبّل تعاليم حاصد
"!الأرواح كيوو، لذلك أنقذ حياة ابنتي

132
00:10:23,620 --> 00:10:25,370
.لم يعرف الأوني ماذا يفعل

133
00:10:25,980 --> 00:10:30,570
"!عليّ استعادة روح فتاة في السّادسة عشر"

134
00:10:30,570 --> 00:10:32,940
"أيوجد من يستطيع أخذ مكانها؟"

135
00:10:33,410 --> 00:10:35,840
"!نعم! توجد! توجد"

136
00:10:35,840 --> 00:10:39,570
"!ثمّة فتاة في المنزل المجاور أتمّت سنتها السّادسة عشر"

137
00:10:40,920 --> 00:10:43,680
،أخرج الأوني مسمارًا أحمر كالدّماء

138
00:10:43,680 --> 00:10:45,950
!وغرسه في جبهتها

139
00:10:53,290 --> 00:10:56,760
،ثمّ ماتت الفتاة في المنزل المجاور مكانها

140
00:10:56,760 --> 00:10:59,300
.وعادت ابنة كبير القرية

141
00:10:59,820 --> 00:11:01,230
.هذه هي القصّة

142
00:11:03,660 --> 00:11:09,270
ثمّ اكتشف سيّد الجحيم الأمر وأعاد تلك الفتاة، صحيح؟

143
00:11:09,270 --> 00:11:10,160
.لا

144
00:11:11,110 --> 00:11:16,270
قيل أنّ ابنة كبير القرية عاشت حتّى
.بلغت المائة عام تقريبًا

145
00:11:17,560 --> 00:11:19,770
...الجزيرة مخيفة

146
00:11:20,240 --> 00:11:23,160
.أشعر بالسّوء حيال الفتاة الّتي ماتت

147
00:11:23,160 --> 00:11:24,560
.صحيح

148
00:11:24,560 --> 00:11:29,540
.لذلك أشفق أهل القرية عليها وبنوا لها قبرًا

149
00:11:31,660 --> 00:11:33,540
.إنّه يُسمّى قبر كازوها

150
00:11:48,470 --> 00:11:49,930
أين جيسيكا وأروتو؟

151
00:11:49,930 --> 00:11:52,230
!يقاتلان ويرد آخر على ما أظنّ

152
00:11:55,550 --> 00:11:57,730
هنالك اثنان منها؟

153
00:11:59,530 --> 00:12:02,360
لماذا يقع اللّوم عليّ وحدي؟

154
00:12:02,760 --> 00:12:06,740
!لقد كان مقرفًا للغاية

155
00:12:32,770 --> 00:12:37,950
سُحقًا! إنّهم يعملون بجدّ ونحن لا حول لنا؟

156
00:12:41,850 --> 00:12:43,340
أهنالك من يسمعني؟

157
00:12:43,340 --> 00:12:46,410
.المصعد متوقّف حاليًّا

158
00:12:47,170 --> 00:12:51,290
.الزموا الهدوء رجاءً وانتظروا وصول المساعدة

159
00:12:48,660 --> 00:12:51,290
خلل في الطّاقة

160
00:12:52,080 --> 00:12:53,600
...أكرّر

161
00:12:53,600 --> 00:12:55,170
.المصعد متوقّف حاليًّا

162
00:12:56,430 --> 00:12:58,670
!كفاكم عبثًا معي

163
00:13:04,510 --> 00:13:08,870
.نستطيع على الأقلّ رؤية وجوه بعضنا الآن

164
00:13:09,880 --> 00:13:13,560
.لكن محطّات النّقل الأساسيّة ما زالت غير متّصلة

165
00:13:14,130 --> 00:13:15,940
ما القدْر الّذي أطلعتكم عليه؟

166
00:13:16,460 --> 00:13:21,320
.قلت أنّ فتاة تحمل نفس الاسم قُتلت أيضًا

167
00:13:21,850 --> 00:13:24,570
هذه أكثر من مجرّد مصادفة، صحيح؟

168
00:13:25,260 --> 00:13:27,410
.ما زال قبر كازوها موجودًا

169
00:13:27,410 --> 00:13:30,500
.لكنّ القصّة ترجع لمئات السّنين

170
00:13:31,170 --> 00:13:33,550
.وهنالك فرق كبير واحد

171
00:13:35,240 --> 00:13:37,910
.كازوها الّتي في القصّة ماتت من أجل شخص آخر

172
00:13:37,910 --> 00:13:41,460
لكنّ كازوها-سان الّتي تعرفها
.وُلدت لتكون تضحية

173
00:13:41,830 --> 00:13:45,340
ماذا إن كانوا قد ضحّوا بها مكان شخص آخر...؟

174
00:13:47,640 --> 00:13:49,780
...لحظة، ما أعنيه

175
00:13:50,380 --> 00:13:55,170
ماتت كازوها-سان الّتي على الجزيرة بعد
أخذ مكان ابنة كبير القرية، صحيح؟

176
00:13:55,170 --> 00:13:58,840
...ثمّ روح ابنته قد

177
00:13:58,840 --> 00:14:03,730
عفوًا، عفوًا... ماذا؟

178
00:14:06,970 --> 00:14:10,070
،باختصار، شخص آخر كان يوشك أن يموت

179
00:14:10,070 --> 00:14:15,050
.ووُلدت كازوها لتأخذ مكانه هو ما أحاول قوله

180
00:14:15,990 --> 00:14:21,340
لنقل أنّ هذا "الشّخص" كان جزءًا
.من الكنيسة أو ما شابه

181
00:14:22,320 --> 00:14:24,750
...إن هربت كازوها-سان مع أبيها

182
00:14:25,240 --> 00:14:27,190
فما الّذي حلّ بذلك الشّخص؟

183
00:14:28,280 --> 00:14:29,510
أهذا ما تحاول قوله؟

184
00:14:31,460 --> 00:14:33,260
،إن كانت ستأخذ مكان شخص آخر

185
00:14:33,680 --> 00:14:35,710
.لكانوا في مأزق بعد اختفاء كازوها

186
00:14:36,350 --> 00:14:39,260
هل صنعوا هجينة ثانية وثالثة؟

187
00:14:39,260 --> 00:14:42,060
أم شيئًا آخر؟

188
00:14:54,480 --> 00:14:58,120
يظنّ كلّ من في الإنترنيت أنّني كنت
المسؤولة عن التّنمّر؟

189
00:14:58,120 --> 00:15:00,960
،انفصل خطيب أختي عنها

190
00:15:00,960 --> 00:15:05,090
!وأمّي في المستشفى بعد نوبة قلبيّة

191
00:15:07,880 --> 00:15:11,970
لكنّ الفتاة قتلت نفسها لأنّك تنمّرت عليها، صحيح؟

192
00:15:11,970 --> 00:15:14,050
!لقد اعتذرت

193
00:15:17,570 --> 00:15:19,100
.أدركت أن ما فعلت كان خاطئًا

194
00:15:19,720 --> 00:15:21,600
ألم يكن ذلك كافيًا؟

195
00:15:21,600 --> 00:15:25,230
ألا نملك حقوقًا على الإطلاق
حتّى بعد التّوبة؟

196
00:15:25,490 --> 00:15:27,740
.بإمكاني تفهّم لوم العائلة لي

197
00:15:27,740 --> 00:15:31,860
لكنّني لا أفهم لماذا يلومني
!أشخاص لا علاقة لهم بالأمر

198
00:15:32,400 --> 00:15:34,480
...يظنّون أنّهم نظيفون تمامًا

199
00:15:34,480 --> 00:15:37,120
...إنّهم مجرّد عجائز نال منهم الملل

200
00:15:37,120 --> 00:15:39,620
!دعوني وشأني

201
00:15:46,700 --> 00:15:49,630
هل تعرف ما معنى تلك العلامة؟

202
00:15:49,630 --> 00:15:51,630
!بالطّبع لا

203
00:15:53,600 --> 00:15:55,190
.كان لي أخ

204
00:15:55,840 --> 00:15:57,760
.لكنّه قُتل أمام عينيّ

205
00:16:00,350 --> 00:16:04,050
.وقد رسم نفس العلامة بالدّماء

206
00:16:04,820 --> 00:16:07,070
!نفس العلامة على جباههم

207
00:16:09,040 --> 00:16:11,650
!أريد معرفة معناها

208
00:16:13,280 --> 00:16:16,790
ثمّة لفيفة قديمة في الجزيرة
.تدعى دراما معبد هورياجي

209
00:16:16,790 --> 00:16:18,330
.وهي تضمّ تلك العلامة

210
00:16:20,300 --> 00:16:24,160
كانت هنالك جمجمة في المعبد
،لا تنتمي لإنسان أو حيوان

211
00:16:24,160 --> 00:16:26,210
.ونُحتت العلامة عليها

212
00:16:28,790 --> 00:16:30,710
.يُفترض أنّها كانت أقدم

213
00:16:31,160 --> 00:16:32,840
.إنّها في دسغو أيضًا

214
00:16:34,000 --> 00:16:35,390
د-دسغو؟

215
00:16:35,390 --> 00:16:38,600
.جداريّة اكتشفت في كهف في دسغو في إسبانيا

216
00:16:39,240 --> 00:16:42,600
،يعود تاريخها لعصور ما قبل التّاريخ
.بين 50 ألف و25 ألف سنة مضت

217
00:16:42,600 --> 00:16:45,020
.إنّها تضمّ نفس الشّيء

218
00:16:45,020 --> 00:16:46,700
قديمة لهذا الحدّ؟

219
00:16:47,540 --> 00:16:51,720
.ذكر تريس أيضًا عن جنس حكم قبل البشر

220
00:16:52,340 --> 00:16:54,110
."الأشرار"

221
00:16:57,930 --> 00:17:00,180
،وصل حكمهم إلى نهايته

222
00:17:00,810 --> 00:17:04,710
.لكنّنا إمّا نسيناهم أو تظاهرنا أنّهم لم يُوجدوا قطّ

223
00:17:05,690 --> 00:17:07,880
تظاهرنا أنّهم لم يوجدوا قطّ؟

224
00:17:08,600 --> 00:17:10,750
.كان أسلافنا مصدومين

225
00:17:11,520 --> 00:17:14,220
.من الطّبيعيّ أنّهم أرادوا غضّ أبصارهم عن الأمر

226
00:17:14,220 --> 00:17:16,600
والعلامة من بقاياهم؟

227
00:17:16,600 --> 00:17:18,890
.على الأرجح أنّها علامتهم

228
00:17:18,890 --> 00:17:21,770
إعادة أشياء شرّيرة هو هدف الكنيسة، صحيح؟

229
00:17:22,240 --> 00:17:25,770
تدمير العالم. ذلك هو هدفهم النّهائيّ، صحيح؟

230
00:17:28,690 --> 00:17:31,020
لماذا قتلوا أخي إذًا؟

231
00:17:31,510 --> 00:17:34,170
.ذلك... أجهله

232
00:17:35,390 --> 00:17:38,410
كيف كان أخوك؟

233
00:17:42,370 --> 00:17:45,790
.كان اسمه جونبي. أودا جونبي

234
00:17:46,930 --> 00:17:50,590
.كان قويًّا وحادّ الذّكاء

235
00:17:51,640 --> 00:17:52,790
...وطيّبًا

236
00:17:54,740 --> 00:17:57,270
.لم تكن له علاقة بهم

237
00:17:58,180 --> 00:17:59,890
هل كان يقرأ كثيرًا؟

238
00:18:00,280 --> 00:18:03,470
.كانت أشياء معقّدة جدًّا. بحوثًا أكاديميّة

239
00:18:04,620 --> 00:18:07,850
.ربّما كان ذكيًّا أكثر من اللاّزم

240
00:18:09,720 --> 00:18:11,830
.تلك العلامة قديمة جدًّا

241
00:18:12,510 --> 00:18:16,740
.ربّما أدرك وجود الكنيسة من تلك السّجلاّت

242
00:18:17,370 --> 00:18:19,240
ولهذا السّبب قُتل؟

243
00:18:20,360 --> 00:18:23,450
.كان خائفًا جدًّا قبل موته

244
00:18:23,700 --> 00:18:25,190
.حتّى الأصوات الخافتة كانت تخيفه

245
00:18:26,240 --> 00:18:28,090
ما الّذي أخافه؟

246
00:18:28,740 --> 00:18:31,060
هل ما زالت الكتب الّتي قرأها أخوك موجودة؟

247
00:18:31,060 --> 00:18:32,340
.نعم

248
00:18:32,340 --> 00:18:34,710
.ربّما نجد فيها تلميحًا ما إذًا

249
00:18:34,710 --> 00:18:35,980
تلميحًا؟

250
00:18:40,300 --> 00:18:43,430
!عجائز حقيرون بلا فائدة

251
00:18:45,670 --> 00:18:48,850
!إنّهم يستغلّونني فقط لجعل حياتهم أقل بؤسًا

252
00:18:50,350 --> 00:18:57,030
!أريدهم أن يموتوا فحسب

253
00:18:58,900 --> 00:19:00,300
!هذا فظيع

254
00:19:00,300 --> 00:19:02,660
!لا يبرّر ذلك قتلهم

255
00:19:02,910 --> 00:19:04,620
!اخرسي

256
00:19:07,380 --> 00:19:11,290
...كلّ أولئك العجائز الّذين سخروا منّي... سوف

257
00:19:12,290 --> 00:19:14,210
!لا تملكين الحقّ لذلك

258
00:19:14,210 --> 00:19:16,800
!موتي

259
00:19:21,300 --> 00:19:22,680
!إري

260
00:19:35,190 --> 00:19:36,320
!إري

261
00:19:40,070 --> 00:19:44,070
!موتي! موتي! موتي! موتي

262
00:19:45,580 --> 00:19:48,700
!لا أحد يستحقّ الموت

263
00:19:56,540 --> 00:19:59,590
!سُحقًا لكلّ هذا... لن أموت هنا

264
00:20:04,490 --> 00:20:06,220
...هل يعني هذا

265
00:20:09,010 --> 00:20:11,230
.حمدًا على هذا... إنّه يتحرّك ثانية

266
00:20:15,950 --> 00:20:21,110
.كان هنالك اثنان من الويرد
.كان واحدًا وانفصل

267
00:20:22,240 --> 00:20:24,320
وصلتم أخيرًا؟

268
00:20:24,320 --> 00:20:25,740
!لم يكن بوسعنا فعل أيّ شيء

269
00:20:25,740 --> 00:20:28,620
.لقد علقنا في المصعد

270
00:20:28,620 --> 00:20:29,620
صحيح يا راندو؟

271
00:20:31,560 --> 00:20:33,500
.تناديه باسمه الشّخصيّ بالفعل

272
00:20:33,790 --> 00:20:35,500
ماذا حدث؟

273
00:20:39,400 --> 00:20:42,450
.نفس العلامة الّتي على جباه ضحايا الجزيرة

274
00:20:42,450 --> 00:20:45,340
.يفترض أنّها موجودة في جداريّة كهف في دسغو

275
00:20:45,340 --> 00:20:46,510
دسغو؟

276
00:20:47,240 --> 00:20:49,390
على جداريّة من ما قبل التّاريخ؟

277
00:20:49,670 --> 00:20:51,640
،الأهمّ من ذلك يا راندو

278
00:20:51,640 --> 00:20:55,140
قلتَ أنّ ما يحدث في شيبويا له علاقة
بما يحدث على الجزيرة، صحيح؟

279
00:20:56,720 --> 00:20:59,150
هلاّ قاتلتما معنا إذًا؟

280
00:21:04,240 --> 00:21:07,060
...آسف. أودّ ذلك، لكن

281
00:21:07,830 --> 00:21:09,410
أنت قلق حيال الجزيرة؟

282
00:21:11,210 --> 00:21:15,040
.حسنًا. كنت لأقول نفس الشّيء في مكانك

283
00:21:19,100 --> 00:21:19,920
.شكرًا لك

284
00:21:20,580 --> 00:21:23,670
.أنت أوّل صديق لي في طوكيو

285
00:21:32,880 --> 00:21:34,980
...أنا جدّ سعيد

286
00:21:34,980 --> 00:21:37,820
!صار اثنان من النّوكر-أب متفاهمان

287
00:21:37,820 --> 00:21:39,980
!كم هذا جميل

288
00:21:40,710 --> 00:21:42,820
...اسمع يا هذا

289
00:21:42,820 --> 00:21:44,990
...إنّ شرح هذه الأمور

290
00:21:46,150 --> 00:21:49,910
!يقع ضمن مسؤوليّاتك

291
00:23:25,040 --> 00:23:27,380
في الحلقة القادمة

292
00:23:25,700 --> 00:23:27,380
.مرور الوقت لا يتوقّف

293
00:23:27,380 --> 00:23:29,220
.تمرّ أوقات المرح بسرعة

294
00:23:30,010 --> 00:23:32,470
.يتمنّى الجميع أن تتواصل للأبد

295
00:23:32,880 --> 00:23:35,300
.لكنّها ستنتهي يومًا ما

296
00:23:35,300 --> 00:23:36,640
.تنتهي جميعها

297
00:23:37,180 --> 00:23:39,980
."في الحلقة القادمة: "الرّجل الّذي يوقف الوقت

298
00:23:37,180 --> 00:23:40,020
الرّجل الّذي يوقف الوقت