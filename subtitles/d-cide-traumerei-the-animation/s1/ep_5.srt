1
00:00:05,740 --> 00:00:06,980
.النّطق بالحُكم

2
00:00:10,130 --> 00:00:12,860
.حُكم على المتّهم بالسّجن لمدّة 15 سنة

3
00:01:53,720 --> 00:01:56,630
.أنا آسف، فأنا سائق حذر

4
00:01:57,540 --> 00:01:59,740
هل أنا آخر الواصلين؟

5
00:02:00,390 --> 00:02:02,570
!تأخّر تريس

6
00:02:02,570 --> 00:02:03,510
.أنا هنا سلفًا

7
00:02:07,530 --> 00:02:10,600
.لنراجع ما نعرفه

8
00:02:10,600 --> 00:02:14,400
.أوّلاً، هدف العدوّ هو إعادة إحياء الويرد

9
00:02:15,360 --> 00:02:17,650
وهذا العدوّ هو الصّوت الّذي تحدّث إلى إري؟

10
00:02:17,650 --> 00:02:19,100
.نعم، أظنّ ذلك

11
00:02:19,100 --> 00:02:23,450
.ولبلوغه، يستعمل السّومنيوم دروب

12
00:02:23,450 --> 00:02:28,240
،وعندما يعثرون على هدف
.يعطوه هذا المخدّر ليجعلوه يحلم

13
00:02:32,770 --> 00:02:34,840
.ربّما صاروا أكثر حذرًا

14
00:02:34,840 --> 00:02:37,650
،أو ربّما يغيّرون طريقة توصيله بانتظام

15
00:02:37,650 --> 00:02:40,930
.ليصعّبوا مسألة تعقّبهم

16
00:02:42,300 --> 00:02:45,180
،إن جُلنا مهدّدين كلّ من تحوم حولهم الشّبهات

17
00:02:45,180 --> 00:02:47,310
فسنكتشف أمرًا ما، صحيح؟

18
00:02:47,310 --> 00:02:50,690
.يا إلهي، هذه هي مشكلة من يفكّرون بعضلاتهم

19
00:02:50,920 --> 00:02:54,850
.عدوّنا ليس متدنّي المستوى ليجول الشّوارع يا غبيّ

20
00:02:54,850 --> 00:02:56,260
!ماذا قلت؟

21
00:02:56,260 --> 00:02:58,940
.إنّهم يعرفون وجوهنا

22
00:03:00,010 --> 00:03:01,450
،يغضبني الاعتراف بهذا

23
00:03:01,450 --> 00:03:05,830
لكن لا شكّ أنّنا متأخّرون بخطوة
.أو خطوتين في حرب المعلومات هذه

24
00:03:06,950 --> 00:03:12,080
أروتو، هل يمكننا تعقّب طريقة استعمالهم
للإنترنت لنقل السومنيوم دروب؟

25
00:03:13,880 --> 00:03:17,320
،حسنًا... مهما ظنّوا أنّهم قد برعوا في إخفاء أثرهم

26
00:03:17,320 --> 00:03:20,220
.إلاّ أنّ الإنترنيت يتذكّر شيئًا ما دائمًا

27
00:03:20,220 --> 00:03:21,590
.أعتمد عليك

28
00:03:22,000 --> 00:03:23,150
...وأنت يا إري

29
00:03:23,150 --> 00:03:23,970
نعم؟

30
00:03:23,970 --> 00:03:27,360
.أنت الوحيدة الّتي كانت على اتّصال حقيقيّ مع ويرد

31
00:03:27,360 --> 00:03:29,350
.أريدك أن تخبريني بما تعرفينه

32
00:03:29,350 --> 00:03:33,090
.أخبريني بما تتذكّرين فحسب
.لا يجب أن يكون كلّ شيء

33
00:03:34,690 --> 00:03:36,860
.ليست لديّ ذكريات واضحة تمامًا

34
00:03:37,720 --> 00:03:39,920
...سمعتُ صوتًا فحسب

35
00:03:39,920 --> 00:03:46,870
وكلّ ما أتذكّره هو ذلك الصّوت
.يأمرني بأن أعرض أمنيتي

36
00:03:46,870 --> 00:03:48,120
أمنية؟

37
00:03:48,120 --> 00:03:54,380
،قال إن عرضتُ أمنيتي، فسيعطيني القوّة
.وأنّه سيحقّق أمنيتي

38
00:03:56,670 --> 00:04:00,990
،لو أنّي فعلتُ ما أمرني به
...من كان يدري ما قد يحدث

39
00:04:06,030 --> 00:04:06,900
.إري

40
00:04:13,490 --> 00:04:17,400
.يستغلّ عدوّنا قلوب النّاس الضّعيفة

41
00:04:17,400 --> 00:04:21,650
.نحتاج لنكون حذرين ألاّ نمنحهم أيّ ثغرات

42
00:04:21,650 --> 00:04:25,560
هنالك أشخاص بإمكانهم إغضاب
المرء حتّى وهم على حقّ، صحيح؟

43
00:04:30,760 --> 00:04:32,000
ماذا؟

44
00:04:33,040 --> 00:04:34,670
السّجن لمدّة 15 سنة
لقاتل فتاة في الثّانويّة

45
00:04:33,040 --> 00:04:34,670
لم يظهر المتّهم الشّابّ أيّ علامات ندم، وواصل السّبّ خلال المحاكمة

46
00:04:33,040 --> 00:04:36,170
اتُّهم المدّعى عليه بالاغتصاب والقتل

47
00:04:36,170 --> 00:04:40,500
.وحُكم عليه اليوم بالسجن لمدّة 15 سنة

48
00:04:40,500 --> 00:04:44,680
أعلن كلّ من الحكومة ومحاموه
...نيّتهم في الاستئناف

49
00:04:45,220 --> 00:04:46,930
.يا لها من حادثة فظيعة

50
00:04:47,660 --> 00:04:50,680
.الاغتصاب والقتل... هذا أسوأ شيء

51
00:04:51,000 --> 00:04:53,680
،إن وصلت المسألة حتّى المحكمة العليا

52
00:04:54,090 --> 00:04:57,310
.فستستمرّ معاناة العائلة فحسب

53
00:04:57,310 --> 00:05:03,570
لم يظهر المتّهم أيّ علامات ندم وصرخ قائلاً "سأفعلها ثانية! أثناء المحاكمة

54
00:04:57,840 --> 00:04:59,170
هذا مزعج، صحيح؟

55
00:05:00,000 --> 00:05:03,570
.قوانين اليابان رؤوفة بالمتّهم

56
00:05:03,950 --> 00:05:06,150
،إن كنتُ من عائلتها

57
00:05:06,150 --> 00:05:09,830
لوضعتُ رصاصة 9 ملم في دماغ
.القاتل وأنهيتُ المسألة

58
00:05:09,830 --> 00:05:13,510
.ألم تعرفي؟ اليابان بلاد قانون

59
00:05:13,510 --> 00:05:15,110
.وكذلك الولايات المتّحدة

60
00:05:15,110 --> 00:05:16,830
.هذا جديد عليّ

61
00:05:17,700 --> 00:05:21,340
.صحيح أنّ شرطة اليابان قاسية على ضحايا الجرائم

62
00:05:30,720 --> 00:05:33,180
هلاّ أعطيتنا أيّ تعليق؟

63
00:05:33,180 --> 00:05:35,390
ما شعورك بعد فقدانك لفرد من عائلتك؟

64
00:05:52,120 --> 00:05:53,990
!هذا مؤلم

65
00:05:53,990 --> 00:05:57,410
انتهى عملنا هنا، صحيح؟

66
00:05:57,410 --> 00:05:59,540
!اتركيني يا رينا! فهمت

67
00:05:58,910 --> 00:05:59,540
.نعم

68
00:06:00,310 --> 00:06:03,050
.حسنًا، هذا كلّ شيء لليوم

69
00:06:26,100 --> 00:06:29,320
.مرحبًا؟ نريد الحديث فحسب

70
00:06:29,320 --> 00:06:32,450
هلاّ أعطيتمونا بيانًا فحسب؟

71
00:06:32,730 --> 00:06:34,030
مرحبًا؟

72
00:06:40,710 --> 00:06:44,210
أنا رجل الأحلام

73
00:06:46,510 --> 00:06:48,220
رجل الأحلام؟

74
00:06:48,220 --> 00:06:51,720
رجل الأحلام

75
00:06:48,220 --> 00:06:51,720
أنا رجل الأحلام

76
00:06:48,220 --> 00:06:51,720
أنا صديقك، بإمكاني مساعدتك

77
00:06:59,820 --> 00:07:02,110
.حسنًا، أراك غدًا في المدرسة

78
00:07:04,140 --> 00:07:04,820
!رينا

79
00:07:07,980 --> 00:07:12,700
.بشأن ما حدث قبل قليل... أنا أشكرك

80
00:07:14,320 --> 00:07:15,950
ماذا تعني؟

81
00:07:16,500 --> 00:07:19,200
تعرفين، فعلتِ ذلك من أجلي، صحيح؟

82
00:07:19,200 --> 00:07:22,000
.لا يمكنني سماعك بسبب ضجيج الدّرّاجة

83
00:07:22,000 --> 00:07:22,960
ماذا؟

84
00:07:25,590 --> 00:07:27,420
!لا شيء

85
00:07:27,420 --> 00:07:28,340
!مع السّلامة

86
00:07:39,310 --> 00:07:42,480
.الفتيان حسّاسون للغاية

87
00:08:04,250 --> 00:08:06,870
إنّه لا يستعمل خوادم وكيلة فحسب؟

88
00:08:07,830 --> 00:08:10,380
.إنّه أكثر حذرًا ممّا ظننت

89
00:08:10,810 --> 00:08:13,530
.الإشاعات هي كلّ ما أعثر عليه

90
00:08:48,000 --> 00:08:49,800
مرحبًا بك في عالم الأحلام

91
00:09:23,700 --> 00:09:26,460
!مذنب! مذنب! مذنب

92
00:09:26,800 --> 00:09:29,710
.حُكم على المتّهم بالإعدام

93
00:09:42,880 --> 00:09:44,850
!مهلاً، توقّف

94
00:09:57,260 --> 00:09:59,740
.سأنفّذ الآن حكم الإعدام

95
00:10:00,990 --> 00:10:02,580
!مفهوم! هذا يكفي

96
00:10:02,580 --> 00:10:04,580
!أنا آسف! أرجوك

97
00:10:04,580 --> 00:10:07,830
!عانت أختي ما هو أسوأ من هذا

98
00:10:21,580 --> 00:10:23,220
هل أنت راضٍ؟

99
00:10:24,080 --> 00:10:25,970
راضٍ بمجرّد حلم؟

100
00:10:26,220 --> 00:10:27,180
من هناك؟

101
00:10:27,770 --> 00:10:31,560
،سُلبت براءة أختك منها

102
00:10:31,560 --> 00:10:34,610
!ولُوّث جسدها ودُنّس

103
00:10:36,240 --> 00:10:38,490
!لا! يكفي

104
00:10:38,820 --> 00:10:40,320
!أختي

105
00:10:40,320 --> 00:10:48,370
،صرخت وتوسّلت حتّى جشّ صوتها
!بينما راقبها هو وضحك فحسب

106
00:10:48,370 --> 00:10:51,380
!يكفي! يكفي! يكفي

107
00:10:51,380 --> 00:10:55,500
.وخنقها بينما كان يضحك

108
00:10:56,350 --> 00:11:01,390
ما زالت روح أختك تعاني
.وتحترق في نار جحيم أبديّة

109
00:11:01,390 --> 00:11:05,660
.إنّها تبكي دمًا، وتسعى للانتقام

110
00:11:06,510 --> 00:11:07,520
...لكن

111
00:11:10,030 --> 00:11:14,020
.انظر. ما زال حيًّا

112
00:11:15,670 --> 00:11:18,720
تريد قتل ذلك الرجل، أليس كذلك؟

113
00:11:21,030 --> 00:11:21,990
!سأقتله

114
00:11:24,920 --> 00:11:27,160
.حقّق حلمك بيديك

115
00:11:30,850 --> 00:11:32,850
.اجعل حلمك حقيقة

116
00:11:37,390 --> 00:11:40,940
...أجعل حلمي... حقيقة

117
00:11:53,610 --> 00:11:55,980
.هذا صحيح. اقتله

118
00:11:59,470 --> 00:12:02,660
.كلّ ما عليك فعله هو إطاعتي

119
00:12:33,110 --> 00:12:34,230
كنيسة؟

120
00:12:34,540 --> 00:12:36,230
أيّ نوع من الكنائس؟

121
00:12:36,490 --> 00:12:38,200
.لا أعرف اسمها

122
00:12:38,200 --> 00:12:42,360
."كلّ ما أعرفه هو أنّ اسمها "الكنيسة

123
00:12:42,920 --> 00:12:45,840
.ويفترض أنّ ذاك هو مصدر سومنيوم دروب

124
00:12:45,840 --> 00:12:47,370
أهي مجموعة دينيّة؟

125
00:12:47,680 --> 00:12:50,040
.ستكون طائفة من نوع ما إن صحّ ذلك

126
00:12:50,580 --> 00:12:53,750
.يبدو أنّهم يسمّون أنفسهم رعايا الكنيسة

127
00:12:54,100 --> 00:12:56,620
.لكنّهم ليسوا مسجّلين لدى السّلطات

128
00:12:56,620 --> 00:12:57,500
ماذا أيضًا؟

129
00:12:59,270 --> 00:13:01,490
.هنالك إشاعة صغيرة

130
00:13:02,560 --> 00:13:05,760
،إنّهم ينشرون السّومنيوم دروب في كلّ مكان

131
00:13:06,530 --> 00:13:09,510
.لكنّ مركز أعمالهم هنا في شيبويا

132
00:13:10,290 --> 00:13:16,070
إنّ سبب جهل الجميع لكلّ شيء هو أنّه
.لا يوجد أيّ مال في عمليّات تسليم الدّروب

133
00:13:16,650 --> 00:13:19,150
.صحيح، لا يبدو أنّهم يتاجرون به

134
00:13:20,560 --> 00:13:22,650
.إليكم ما يجعل الأمر مريبًا أكثر

135
00:13:23,160 --> 00:13:26,280
كلّ المجموعات الخطيرة المتمركزة في هذه المنطقة

136
00:13:26,630 --> 00:13:30,780
.اعتبرت الكنيسة كمنافس لها وحاولت إبعادها

137
00:13:32,930 --> 00:13:34,160
.لكنّها اختفت

138
00:13:35,260 --> 00:13:36,040
اختفت؟

139
00:13:36,360 --> 00:13:40,920
إنّ كلّ من سعى خلف الكنيسة
.اختفى بالكامل من شيبويا

140
00:13:41,200 --> 00:13:42,550
خسروا جميعًا إذًا؟

141
00:13:42,550 --> 00:13:45,550
.وأصبحوا عبرة فظيعة للآخرين

142
00:13:45,960 --> 00:13:48,590
".لا تعبثوا معنا"

143
00:13:48,590 --> 00:13:50,510
.أو شيء من ذلك القبيل

144
00:13:50,840 --> 00:13:52,810
.صار اسمهم محرّمًا نوعًا ما

145
00:13:53,990 --> 00:13:55,520
...وهنالك أمر أخير

146
00:13:56,000 --> 00:13:58,520
.من المفترض أنّ هذه علامة الكنيسة

147
00:14:01,760 --> 00:14:02,820
...هذه

148
00:14:04,020 --> 00:14:05,000
ريوهي؟

149
00:14:09,620 --> 00:14:14,410
ما العلاقة الّتي كانت لدى
شقيق أودا-كُن مع الكنيسة؟

150
00:14:15,790 --> 00:14:19,040
.ربّما كان متورّطًا في توصيل السّومنيوم دروب

151
00:14:20,890 --> 00:14:22,170
...أخي

152
00:14:22,170 --> 00:14:24,830
!ما كان أخي ليفعل ذلك

153
00:14:26,630 --> 00:14:32,800
.أو ربّما... كان لديه سبب وجيه لاعتراض طريقهم

154
00:14:34,010 --> 00:14:34,940
سبب؟

155
00:14:44,610 --> 00:14:45,440
.هذا هو المكان

156
00:14:46,090 --> 00:14:46,690
.هيّا بنا

157
00:14:46,690 --> 00:14:47,820
!حاضر

158
00:14:58,840 --> 00:15:00,120
!ذاك هو الحالم

159
00:15:01,410 --> 00:15:03,180
!إنّه يوشك على عرض أمنيته

160
00:15:03,180 --> 00:15:04,340
!علينا إيقافه

161
00:15:17,180 --> 00:15:19,100
!ابتعد عن طريقي

162
00:15:22,980 --> 00:15:26,190
!لا وقت لديك للتّعامل معك

163
00:15:36,870 --> 00:15:37,740
!سأسبقك

164
00:15:38,700 --> 00:15:40,330
!تمهّل

165
00:15:44,680 --> 00:15:46,200
...أنا أعرض

166
00:15:46,200 --> 00:15:48,370
—أنت، انتظر

167
00:15:48,370 --> 00:15:49,710
!توقّف مكانك

168
00:15:50,670 --> 00:15:52,180
!لا تعترضوا طريقي

169
00:15:52,860 --> 00:15:55,180
!سوف أقتله

170
00:15:55,580 --> 00:15:59,360
!إنّه الرّجل الّذي قتل أختي

171
00:15:59,360 --> 00:16:01,000
...أيعقل أنّه

172
00:16:01,000 --> 00:16:02,020
أتعرفه؟

173
00:16:02,440 --> 00:16:06,020
!إنّه أخو الضّحيّة في قضيّة الاغتصاب والقتل

174
00:16:06,840 --> 00:16:07,900
ماذا؟

175
00:16:08,770 --> 00:16:12,030
رأيت صورة لعائلة الضّحيّة
!في الشبكة المظلمة

176
00:16:12,030 --> 00:16:13,410
!استمع إلينا

177
00:16:13,410 --> 00:16:15,490
!اخرسوا

178
00:16:22,170 --> 00:16:25,750
...لا أحد... سيقف في طريقي

179
00:16:27,070 --> 00:16:33,510
!سوف... أقتله

180
00:16:34,520 --> 00:16:36,520
!توقّف

181
00:16:36,520 --> 00:16:40,270
!أنا أعرض أمنيتي

182
00:17:31,200 --> 00:17:33,110
!اتركني! اتركني

183
00:17:41,370 --> 00:17:43,120
!إيّاك

184
00:17:48,460 --> 00:17:49,750
!اتركه

185
00:17:49,750 --> 00:17:51,220
!اخرسي

186
00:17:51,850 --> 00:17:56,510
!ستدفع... ستدفع ثمن قتلك لأختي

187
00:17:57,880 --> 00:17:59,010
أختك؟

188
00:17:59,370 --> 00:18:00,720
!هذا هو

189
00:18:01,970 --> 00:18:05,680
إنّه يحاول الانتقام لأخته؟

190
00:18:05,930 --> 00:18:08,810
إذًا فأنت هو أخو تلك السّاقطة الصّغيرة؟

191
00:18:09,310 --> 00:18:11,320
!سوف أقتلك

192
00:18:12,530 --> 00:18:14,370
.يا لها من مفاجأة

193
00:18:14,370 --> 00:18:18,570
تحوّلت إلى وحش فقط لتنتقم منّي؟

194
00:18:18,810 --> 00:18:21,730
.أمعقول؟ هذا مضحك للغاية

195
00:18:21,730 --> 00:18:23,830
...دعني أخبرك بشيء

196
00:18:24,210 --> 00:18:30,080
.عندما أدخلته فيها، فتلك السّاقطة أحبّت ذلك

197
00:18:31,960 --> 00:18:34,430
!كانت لذيذة

198
00:18:42,390 --> 00:18:44,860
!توقّف

199
00:18:52,560 --> 00:18:54,690
ما الغاية من قتله؟

200
00:18:54,690 --> 00:18:57,440
!اخرس! أنا أنتقم لأختي

201
00:18:57,440 --> 00:19:00,570
أهذا ما كانت أختك لتريده؟

202
00:19:00,570 --> 00:19:01,600
!اخرس

203
00:19:01,600 --> 00:19:04,200
!أنت لا تفهم ما أشعر به

204
00:19:04,520 --> 00:19:05,420
!بل أفهم

205
00:19:06,190 --> 00:19:08,100
!أنا مثلك تمامًا

206
00:19:08,760 --> 00:19:10,830
!لذلك أفهم ما تشعر به

207
00:19:10,830 --> 00:19:13,080
كاذب! كيف لك أن تفهم؟

208
00:19:13,080 --> 00:19:14,920
!أنا لا أكذب

209
00:19:14,920 --> 00:19:17,670
!قُتل أخي أمام عينيّ

210
00:19:17,670 --> 00:19:19,410
!لذلك فأنا أفهم

211
00:19:19,410 --> 00:19:21,420
!أكره القاتل كثيرًا لدرجة الموت

212
00:19:21,420 --> 00:19:23,600
!لماذا تحاول إيقافي إذًا؟

213
00:19:25,190 --> 00:19:30,100
.لأنّ ذلك... سيكون جريمة قتل لا غير

214
00:19:37,490 --> 00:19:39,320
!إنّه المخطئ الوحيد هنا

215
00:19:39,320 --> 00:19:41,520
!لقد قتل أختي

216
00:19:41,520 --> 00:19:44,740
كنتَ لتقتل قاتل أخيك أيضًا
!إن سنحت لك الفرصة

217
00:19:55,290 --> 00:19:59,050
!ركّز يا ريوهي! هل ستسمح له أن يصير قاتلاً؟

218
00:20:06,680 --> 00:20:09,430
!توقّف

219
00:20:38,460 --> 00:20:40,880
.لنرحل من هنا قبل مجيء الشّرطة

220
00:20:41,460 --> 00:20:45,220
.كنت لأكون مكانه

221
00:20:46,280 --> 00:20:47,470
...ريوهي

222
00:20:51,630 --> 00:20:53,130
.صبيّ غبيّ

223
00:20:53,130 --> 00:20:56,730
.سأواصل ما كنت أفعله بعد خروجي

224
00:20:57,690 --> 00:21:00,930
سجن لمدّة 15 سنة؟

225
00:21:00,930 --> 00:21:04,490
.سأخرج بعد 10 سنوات وأوضع تحت المراقبة

226
00:21:05,400 --> 00:21:11,330
ثمّ سأمسك بفتاة جميلة أخرى
!وأعود لسابق عهدي

227
00:21:12,750 --> 00:21:14,620
!...أيّها الـ

228
00:23:24,960 --> 00:23:27,340
الحلقة القادمة

229
00:23:25,650 --> 00:23:29,840
.في قديم الزّمان، كانت هنالك فتاة تُدعى كازوها

230
00:23:30,630 --> 00:23:33,470
...ليتها كانت قصّة خياليّة

231
00:23:33,470 --> 00:23:35,430
.أكره قول هذا، ولكنّه الواقع

232
00:23:35,740 --> 00:23:37,810
.واقع أليم للغاية

233
00:23:37,810 --> 00:23:39,600
."الحلقة القادمة: "كازوها

234
00:23:37,810 --> 00:23:39,980
كازوها