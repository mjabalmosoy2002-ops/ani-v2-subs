1
00:00:21,220 --> 00:00:22,990
...أ-أنت

2
00:00:30,210 --> 00:00:31,710
!ريوهي

3
00:00:33,470 --> 00:00:36,340
!ريوهي! استيقظ يا ريوهي

4
00:00:35,850 --> 00:00:38,680
!ريوهي

5
00:00:36,340 --> 00:00:37,420
!أودا-كُن، استيقظ

6
00:00:47,970 --> 00:00:50,920
هل أنا... خائف منه؟

7
00:00:52,870 --> 00:00:53,940
!سُحقًا

8
00:00:58,790 --> 00:00:59,950
...ريوهي

9
00:02:42,010 --> 00:02:44,950
.الشّخص الّذي تتّصلون به غير متوفّر

10
00:02:44,950 --> 00:02:47,790
.عاودوا الاتّصال لاحقًا

11
00:02:47,790 --> 00:02:49,880
.شكرًا على اتّصالكم

12
00:02:53,670 --> 00:02:57,780
.لم تُقرأ رسائله أيضًا. لا بدّ أنّ هاتفه غير مشغّل

13
00:02:57,780 --> 00:03:00,150
هل أصيب بشكل خطير؟

14
00:03:00,150 --> 00:03:04,760
كانت الضّربة خفيفة. كان يجدر بنوم
.ليلة جيّد أن يحسّن حالته

15
00:03:04,760 --> 00:03:06,500
...إنّ إصاباته

16
00:03:07,570 --> 00:03:09,910
ماذا؟ ما الخطب؟

17
00:03:09,910 --> 00:03:10,790
.لا شيء

18
00:03:10,790 --> 00:03:14,850
تعرفين كلّ شيء عن أودا-كُن، صحيح؟

19
00:03:14,850 --> 00:03:17,420
!مهلاً، الأمر ليس كذلك

20
00:03:17,420 --> 00:03:22,550
.لكنّي لا أفهم ما الّذي تسعى خلفه الكنيسة

21
00:03:22,550 --> 00:03:27,340
."الأمر واضح، صحيح؟ إعادة إحياء "الأشرار

22
00:03:27,340 --> 00:03:29,680
.لا، نعرف ذلك الجزء مسبقًا

23
00:03:30,120 --> 00:03:35,440
تتساءلين لماذا لم يقتل أودا-كُن، صحيح؟

24
00:03:35,740 --> 00:03:38,940
أي أنّ الأمر ليس بسبب مجيئنا؟

25
00:03:40,220 --> 00:03:46,670
،كان معه الكثير من الوقت لإنهاء الأمر
.لكنّه لم يكمله حتّى النّهاية

26
00:03:46,670 --> 00:03:49,870
حدث نفس الشّيء مع كازوها. لماذا؟

27
00:03:50,090 --> 00:03:53,120
.لا تحدث المصادفات مرّتين

28
00:03:53,340 --> 00:03:58,190
.قد نكون بيادق في لعبة شخص آخر

29
00:03:58,190 --> 00:03:59,900
.هذا ليس من عادتك يا جيسيكا

30
00:04:00,630 --> 00:04:03,810
لا تنتهي المباراة حتّى سماع
صافرة النّهاية، صحيح؟

31
00:04:03,810 --> 00:04:06,260
هذا ما قد يقوله ريوهي، صحيح؟

32
00:04:06,970 --> 00:04:09,640
.نعم. معك حقّ

33
00:04:09,640 --> 00:04:13,940
.لنبحث عن موراسي
.إنّه الدّليل الوحيد الّذي لدينا

34
00:04:13,940 --> 00:04:15,020
.نعم

35
00:04:33,270 --> 00:04:35,540
!أخي! بسرعة، بسرعة

36
00:04:38,280 --> 00:04:40,210
.ريوهي، ستتعثّر إن ركضت

37
00:04:42,970 --> 00:04:44,300
!أيّها الخاسر

38
00:04:44,300 --> 00:04:46,240
!أيّها الغبيّ

39
00:04:48,370 --> 00:04:50,960
.أنت ولد طيّب يا ريوهي

40
00:04:50,960 --> 00:04:55,230
.لستَ ضعيفًا. لا تحبّ القتال فحسب

41
00:05:02,560 --> 00:05:03,910
...أخي

42
00:05:12,410 --> 00:05:13,200
!كلاّ

43
00:05:13,200 --> 00:05:14,160
!ضربة قاضية

44
00:05:14,160 --> 00:05:16,220
!ها قد خسرت ثانية

45
00:05:16,220 --> 00:05:17,750
ألم أخبرك؟

46
00:05:17,750 --> 00:05:23,130
عليك أن تبدأ هجومك المتتالي
.بهجوم قذف بعيد المدى

47
00:05:23,480 --> 00:05:25,380
.مستحيل أن أستطيع ذلك

48
00:05:25,380 --> 00:05:26,930
.بل تستطيع

49
00:05:26,930 --> 00:05:28,440
،راقب خصمك فحسب

50
00:05:28,440 --> 00:05:32,640
وتدرّب حتّى تتحرّك أصابعك
.دون حتّى الحاجة للتّفكير في الأمر

51
00:05:32,920 --> 00:05:34,770
.هذا صعب

52
00:05:34,770 --> 00:05:36,780
.إن استسلمت، فسينتهي كلّ شيء

53
00:05:37,420 --> 00:05:40,020
.هيّا، سألعب معك ثانية

54
00:05:56,540 --> 00:05:59,940
.أخي... كنتَ دائم الابتسام

55
00:06:06,550 --> 00:06:09,300
هل أنا... خائف منه؟

56
00:06:09,560 --> 00:06:13,180
.لستَ ضعيفًا. لا تحبّ القتال فحسب

57
00:06:13,180 --> 00:06:15,430
.إن استسلمت، فسينتهي كلّ شيء

58
00:06:42,650 --> 00:06:43,900
.تبًّا

59
00:06:47,880 --> 00:06:49,880
هل ما زالت الكتب الّتي قرأها موجودة؟

60
00:06:50,400 --> 00:06:52,640
.ربّما نجد فيها تلميحًا ما إذًا

61
00:07:04,630 --> 00:07:07,400
.لا فائدة. غلبني النّعاس بعد دقيقتين فحسب

62
00:07:07,970 --> 00:07:12,910
لا أصدّق أنّ أخي قرأ هذه الأشياء
.عندما كان في مثل سنّي

63
00:07:17,740 --> 00:07:19,620
هل رسم هذه؟

64
00:07:20,140 --> 00:07:22,490
هذه... الترويميراي، صحيح؟

65
00:07:22,970 --> 00:07:25,250
...وهذه العلامة

66
00:07:25,500 --> 00:07:26,380
نصوص سي-ثروغ

67
00:07:25,500 --> 00:07:26,380
كتاب سومزي

68
00:07:25,500 --> 00:07:26,380
قبر كازوها

69
00:07:25,500 --> 00:07:26,380
استجابة حاصد الأرواح

70
00:07:26,990 --> 00:07:30,990
هل جرّب أخي السّومنيوم دروب؟

71
00:07:39,800 --> 00:07:44,810
.سوف نفتح آخر ديزاريا وسنقلب موازين هذا الكون

72
00:07:45,180 --> 00:07:47,070
.سمعًا وطاعة

73
00:07:47,070 --> 00:07:52,950
.ساعة استيقاظه تدنو

74
00:07:58,000 --> 00:07:59,700
.مرحبًا يا رفاق

75
00:07:59,960 --> 00:08:01,040
!أهلاً يا رينا

76
00:08:01,040 --> 00:08:02,080
أنت برفقة طفلة اليوم؟

77
00:08:02,080 --> 00:08:03,960
أهي ابنتك؟

78
00:08:06,250 --> 00:08:08,340
.أنا وصيّة عليها

79
00:08:11,120 --> 00:08:12,810
.كفّي عن ذلك

80
00:08:13,660 --> 00:08:15,250
ذلك مستحيل، صحيح؟

81
00:08:15,250 --> 00:08:19,470
.مرّ وقت طويل. اعتقدت أنّك نسيت أمرنا

82
00:08:19,470 --> 00:08:22,100
.حسنًا، ذلك صحيح نوعًا ما

83
00:08:23,850 --> 00:08:26,810
.على أيّ حال، أنا أبحث عن شخص ما

84
00:08:26,810 --> 00:08:29,860
هل رأيتم هذا الرّجل؟

85
00:08:30,290 --> 00:08:31,360
ماذا؟

86
00:08:31,360 --> 00:08:36,990
حتّى أنا لا أستطيع الولوج لبيانات التّعرّف
.على الوجود لشرطة العاصمة بتلك السّهولة

87
00:08:36,990 --> 00:08:39,240
.بإمكانك ذلك باستعمال هذا

88
00:08:39,760 --> 00:08:40,620
أهذا معقول؟

89
00:08:41,800 --> 00:08:44,120
من تظنّني؟

90
00:08:44,120 --> 00:08:45,790
.أنت مخيفة يا إري

91
00:08:51,770 --> 00:08:53,520
.ولجت لها بالفعل

92
00:08:53,520 --> 00:08:54,970
.لنعثر عليه بسرعة

93
00:09:05,680 --> 00:09:08,880
كلّ ذلك البحث ولن نجد شيئًا؟

94
00:09:10,400 --> 00:09:15,650
سيكون علينا تقبّل أنّ موراساكي
.قد توارى عن الأنظار فحسب

95
00:09:16,090 --> 00:09:21,290
...لا بدّ أنّ الأمر صدم أودا-كُن كثيرًا
.فقد خانه صديقه

96
00:09:21,290 --> 00:09:23,790
!كان صادمًا فعلاً، ولكن مثيرًا للغضب أيضًا

97
00:09:24,060 --> 00:09:29,920
...كان موراسي يكذب على ريوهي
!علينا جميعًا... طوال هذا الوقت

98
00:09:37,390 --> 00:09:41,440
،إن عثر ريوهي على موراسي
.قد يضربه حتّى الموت

99
00:09:42,470 --> 00:09:44,430
!لا أريد ذلك

100
00:10:05,640 --> 00:10:08,120
.منصّة المراقبة من هنا

101
00:10:21,870 --> 00:10:27,740
أدركت أنّني لا أعرف شيئًا عن موراسي
.سوى ما يحدث في المدرسة

102
00:10:28,180 --> 00:10:30,400
.هكذا هي الأمور عادة

103
00:10:33,800 --> 00:10:37,400
.هذا ما هو عليه الصّديق فعلاً

104
00:10:49,920 --> 00:10:51,920
!سأجعلك تدفع الثّمن

105
00:10:54,320 --> 00:10:55,610
لماذا؟

106
00:10:56,940 --> 00:10:59,170
!لماذا لم تحاول حتّى تفاديها؟

107
00:10:59,520 --> 00:11:03,470
.لأنّني كنت أكذب عليك لوقت طويل

108
00:11:04,330 --> 00:11:08,430
.لذلك قرّرت ألاّ أتفادى لكماتك إن قرٍّت ضربي

109
00:11:08,430 --> 00:11:11,310
!سُحقًا، إنّه تسخر منّي

110
00:11:11,310 --> 00:11:13,440
أواثق أنّك لا تريد لكمي؟

111
00:11:13,440 --> 00:11:17,230
!لا يمكنني لكمك الآن بعد ما قلته

112
00:11:17,880 --> 00:11:18,950
.فهمت

113
00:11:20,050 --> 00:11:23,200
.حان الوقت الآن لتستمع إليّ إذًا

114
00:11:24,940 --> 00:11:26,920
.سأختصر في كلامي

115
00:11:27,420 --> 00:11:29,960
.انضمّ إليّ يا ريوهي

116
00:11:29,960 --> 00:11:32,450
ماذا؟ ما معنى ذلك أساسًا؟

117
00:11:32,450 --> 00:11:33,970
.انضمّ للكنيسة

118
00:11:33,970 --> 00:11:36,290
.أطع الكاهن الأكبر

119
00:11:36,290 --> 00:11:38,880
.غيّرت رأيي. قد ألكمك الآن بالفعل

120
00:11:38,880 --> 00:11:43,040
.أتفهّم شعورك، لكنّي أقول هذا لصالحك

121
00:11:43,680 --> 00:11:45,290
.لا يمكنك معارضة الكاهن الأكبر

122
00:11:45,840 --> 00:11:48,650
.أنت هالك إن فعلت

123
00:11:49,350 --> 00:11:51,140
.كما حدث لأخيك

124
00:11:54,650 --> 00:11:58,220
!لا يمكنني خدمة الرّجل الّذي قتل أخي

125
00:11:58,220 --> 00:12:01,150
.فهمت. هذا مؤسف

126
00:12:01,900 --> 00:12:03,770
...ظننتُ أنّك صديقي

127
00:12:04,260 --> 00:12:07,660
.لكنّك كنت تسخر منّي  خلف ظهري طوال الوقت

128
00:12:07,660 --> 00:12:12,160
.فهمت الأمر بشكل خاطئ
.لم أظنّ ذلك أبدًا

129
00:12:12,160 --> 00:12:14,120
ما الّذي ظننته إذًا؟

130
00:12:14,120 --> 00:12:18,240
!أعلم أنّك من توزّع السّومنيوم دروب

131
00:12:18,240 --> 00:12:20,300
لن تكذب عليّ وتنكر ذلك، صحيح؟

132
00:12:20,300 --> 00:12:25,320
تجلب السّومنيوم دروب الخالص
.للضّائعين ومن يعانون

133
00:12:25,320 --> 00:12:26,770
.تعلم ذلك بنفسك

134
00:12:26,770 --> 00:12:28,810
!كيف لك أن تسمّي ذلك "خلاصًا"؟

135
00:12:28,810 --> 00:12:32,390
هل قُتل أخي بسبب ذلك الهراء؟

136
00:12:32,960 --> 00:12:35,700
.أنا آسف حيال أخيك

137
00:12:35,700 --> 00:12:38,800
.لا أعلم كلّ التّفاصيل

138
00:12:38,800 --> 00:12:41,900
.لكنّي أعلم أنّ موته لم يكن سدى

139
00:12:42,200 --> 00:12:44,150
.لا يهمّ ما كان السّبب

140
00:12:44,150 --> 00:12:46,160
.يظلّ القتل قتلاً

141
00:12:47,650 --> 00:12:51,080
.سأهزمه وأسحق الكنيسة

142
00:12:51,080 --> 00:12:55,670
أخبرني! أين الكنيسة؟ أين الكاهن الأكبر؟

143
00:12:57,310 --> 00:12:59,160
.لن أخبرك بذلك

144
00:12:59,160 --> 00:13:02,890
.وحتّى إن أخبرتك، إنّه مكان لا يمكن بلوغه

145
00:13:02,890 --> 00:13:04,300
.أين؟ أخبرني

146
00:13:05,100 --> 00:13:07,680
أهكذا تطلب خدمة من شخص ما؟

147
00:13:07,680 --> 00:13:09,200
!كفاك عبثًا معي

148
00:13:11,700 --> 00:13:16,270
،قلتُ أنّني سأسمح لك بضربي
.لكنّك فوّتّ قرصتك

149
00:13:16,560 --> 00:13:18,520
!موراسي

150
00:13:21,480 --> 00:13:24,600
أنت ممارس كيك بوكسينغ، صحيح؟

151
00:13:24,600 --> 00:13:27,860
إذًا لن تُمانع أن امتلكت أفضليّة ما، صحيح؟

152
00:13:27,860 --> 00:13:29,910
!أكيد، لا أمانع

153
00:13:31,480 --> 00:13:33,750
!هذا مؤلم! ليس عدلاً

154
00:13:33,750 --> 00:13:35,540
.أخبرتك أنّها أفضليّة

155
00:13:35,540 --> 00:13:36,620
!اخرس

156
00:13:38,260 --> 00:13:39,350
!أيّها الوغد

157
00:13:48,270 --> 00:13:50,760
.حسنًا، خسرت

158
00:13:52,370 --> 00:13:54,390
.أنت قويّ يا ريوهي

159
00:13:54,690 --> 00:13:55,990
.لا يمكنني هزيمتك

160
00:13:57,410 --> 00:14:02,700
استمع لي. كنت أقول الحقيقية عندما
.قلتُ أنّك لا تستطيع مقابل الكاهن الأكبر

161
00:14:03,830 --> 00:14:06,530
.مقرّ الكنيسة ليس في هذا العالم

162
00:14:06,530 --> 00:14:09,240
.ما معنى ذلك؟ كلامك ليس منطقيًّا

163
00:14:10,860 --> 00:14:13,370
إنّه في الترويميراي. أين قد يكون سوى هناك؟

164
00:14:13,370 --> 00:14:15,420
!كيف لي أن أعرف ذلك إن لم تخبرني؟

165
00:14:15,420 --> 00:14:19,000
إذًا هل الكاهن الأكبر هناك أيضًا؟

166
00:14:19,000 --> 00:14:19,720
.نعم

167
00:14:20,310 --> 00:14:21,130
.حسنًا

168
00:14:21,740 --> 00:14:25,010
انتظر يا ريوهي. ستذهب إلى هناك؟

169
00:14:25,010 --> 00:14:29,010
!بالطّبع. سوف أوسعه ضربًا

170
00:14:30,460 --> 00:14:31,790
.عرفت ذلك

171
00:14:32,400 --> 00:14:35,670
.اسمع، خذ نصيحتي وانس الأمر

172
00:14:36,190 --> 00:14:38,140
.لا يمكنك هزيمة الكاهن الأكبر

173
00:14:38,140 --> 00:14:39,470
.سأفعل ذلك

174
00:14:39,470 --> 00:14:42,520
.أستطيع الفوز ما دمت لستُ مهملاً

175
00:14:42,520 --> 00:14:44,770
.عليّ القيام بذلك

176
00:14:46,970 --> 00:14:48,400
.فهمت

177
00:14:50,120 --> 00:14:51,660
.استعمل هذه إذًا

178
00:14:52,090 --> 00:14:55,910
السّومنيوم دروب... لماذا قد أستعملها؟

179
00:14:55,910 --> 00:15:00,360
.توجد الكنيسة في هاوية نوم أعمق من الترويميراي

180
00:15:00,860 --> 00:15:05,300
.مكان حتّى النّوكر-أب لا يمكنهم بلوغه

181
00:15:05,570 --> 00:15:08,630
وبإمكاني الذّهاب إلى هناك إن تناولتها؟

182
00:15:08,630 --> 00:15:11,050
.لا يمكنني أن أضمن ذلك

183
00:15:11,530 --> 00:15:17,810
لكنّ ذلك ممكن إن اجتمع مع رغبتك
.المتّقدة للقاء الكاهن الأكبر

184
00:15:23,110 --> 00:15:24,440
هل أنت جادّ؟

185
00:15:25,270 --> 00:15:27,320
.أخبرتك ألاّ تقوم بالأمر

186
00:15:30,560 --> 00:15:31,840
.أخبرني يا موراسي

187
00:15:32,680 --> 00:15:33,740
ماذا؟

188
00:15:33,740 --> 00:15:37,360
لماذا انضممت للكنيسة؟

189
00:15:37,360 --> 00:15:38,420
...لأنّ

190
00:15:38,870 --> 00:15:42,760
.أنت وسيم ومجتهد ومن عائلة ثريّة

191
00:15:42,760 --> 00:15:45,880
ما الّذي قد تريده أكثر من ذلك؟

192
00:15:47,640 --> 00:15:49,880
أهكذا... يبدو الأمر لك؟

193
00:15:49,880 --> 00:15:50,740
.نعم

194
00:15:52,860 --> 00:15:56,640
.لا بأس إذًا. لم أتوقّع منك أن تفهم من الأساس

195
00:16:01,650 --> 00:16:03,600
...مذاقها غريب

196
00:16:03,600 --> 00:16:05,610
ماذا يوجد فيها؟

197
00:16:05,610 --> 00:16:07,110
.هذا سرّ المهنة

198
00:16:20,190 --> 00:16:22,500
!الترويميراي! إنّها قريبة

199
00:16:22,500 --> 00:16:23,260
.لنذهب

200
00:16:30,250 --> 00:16:33,130
.انتظر فحسب... يا موراسي

201
00:16:33,670 --> 00:16:38,420
...سأوسعه ضربًا

202
00:16:39,760 --> 00:16:41,750
.سأدعو أن تنجح

203
00:16:42,730 --> 00:16:46,520
ريوهي! هل أنت بخير يا ريوهي؟

204
00:16:47,160 --> 00:16:49,320
.أنا آسف

205
00:16:50,110 --> 00:16:51,600
...أودا-كُن... مستحيل

206
00:16:51,600 --> 00:16:52,440
!ريوهي

207
00:16:52,440 --> 00:16:54,110
.تصبح على خير يا ريوهي

208
00:16:54,780 --> 00:16:56,570
.أتمنّى أن تراودك أحلام جيّدة على الأقلّ

209
00:16:56,570 --> 00:16:57,950
!توقّف

210
00:17:11,920 --> 00:17:14,200
موراسي، ما الّذي يدور في ذهنك؟

211
00:17:14,200 --> 00:17:15,720
!ما الّذي فعلته لريوهي؟

212
00:17:15,720 --> 00:17:18,490
.منحته ما يريد

213
00:17:18,490 --> 00:17:21,850
.أراك رؤية الكاهن الأكبر، لذلك أرسلته لمقابلته

214
00:17:22,930 --> 00:17:25,330
ما الّذي تسعى خلفه يا موراسي؟

215
00:17:25,330 --> 00:17:27,810
أتظنّين أنّ توجيه مسدّس في وجهي سيجعلني أتكلّم؟

216
00:17:27,810 --> 00:17:31,440
.لديّ عدّة طرق لجعلك تتكلّم

217
00:17:31,690 --> 00:17:32,940
.مخيفة

218
00:17:33,580 --> 00:17:36,820
أعتقد أنّك تعلّمت الكثير من الخدع
.في القوّات الخاصّة للجيش الأمريكيّ

219
00:17:37,610 --> 00:17:39,090
!لا تغيّر الموضوع

220
00:17:39,090 --> 00:17:44,270
أنت ذكيّ، لذلك أعلم أنّك خدعت
.ريوهي ليقوم بما تريد

221
00:17:44,270 --> 00:17:46,580
!أنت أذكى بكثير منه

222
00:17:46,580 --> 00:17:52,740
كلّ ما قلته له هو أنّه إن أراد الذّهاب
،حيث يوجد الكاهن الأكبر في الترويميراي

223
00:17:52,740 --> 00:17:55,220
.فسيحتاج لتناول هذه وإن كان نوكر-أب

224
00:17:56,460 --> 00:17:57,840
!لا يمكننا تصديق ذلك

225
00:17:58,090 --> 00:17:59,740
.هذا فظّ

226
00:17:59,740 --> 00:18:05,020
كنت حالمة بنفسك. ظننتُ أنّك تعرفين
.كيف تعمل الدّروب

227
00:18:06,920 --> 00:18:08,100
!أنا سأستعملها

228
00:18:08,440 --> 00:18:09,110
!رينا

229
00:18:09,110 --> 00:18:10,010
!إيّاك يا رينا

230
00:18:10,010 --> 00:18:11,650
!هذا صحيح! إنّها خطيرة

231
00:18:11,650 --> 00:18:14,020
...لن أصير حالمة

232
00:18:14,470 --> 00:18:18,780
وحتّى إن صرت، ستوقفونني جميعًا، صحيح؟

233
00:18:19,230 --> 00:18:19,980
...لكن

234
00:18:19,980 --> 00:18:22,660
سبق وتناولها ريوهي، صحيح؟

235
00:18:32,400 --> 00:18:33,800
...موراسي

236
00:18:34,810 --> 00:18:40,140
...ربّما ظننتَ أنّك صديق ريوهي

237
00:18:40,520 --> 00:18:42,360
...لكنّك مخطئ

238
00:18:42,360 --> 00:18:43,760
ماذا تعنين؟

239
00:18:44,200 --> 00:18:46,900
...لا تحتاج لأيّ أحد

240
00:18:47,900 --> 00:18:53,900
...إنّ شخصًا كهذا لا يمكنه... عقد صداقات

241
00:18:59,150 --> 00:19:02,260
!رينا

242
00:19:03,660 --> 00:19:04,840
...إنّه

243
00:19:04,840 --> 00:19:05,910
!جيسيكا

244
00:19:05,910 --> 00:19:07,410
.هذه أولويّتنا الآن

245
00:19:22,820 --> 00:19:24,590
ما هذا؟

246
00:19:39,380 --> 00:19:42,180
عبرت... خلال الأرض مباشرة؟

247
00:19:42,780 --> 00:19:47,370
.توجد الكنيسة في هاوية نوم أعمق من الترويميراي

248
00:19:47,870 --> 00:19:49,750
هذا ما قصد إذًا؟

249
00:19:51,130 --> 00:19:52,080
...إنّ هذه

250
00:19:55,930 --> 00:19:58,060
.إنّها الويرد الّتي قاتلناها

251
00:20:10,490 --> 00:20:11,820
.لقد استيقظت

252
00:20:13,890 --> 00:20:15,120
أين ريوهي؟

253
00:20:22,690 --> 00:20:25,090
ما... هذا؟

254
00:20:25,090 --> 00:20:26,410
.ضيوف

255
00:20:26,650 --> 00:20:29,990
عفوًا... هل يمكنني العودة للنّوم؟

256
00:20:29,990 --> 00:20:30,910
.لا

257
00:20:30,910 --> 00:20:33,160
...توقّعت ذلك

258
00:20:36,040 --> 00:20:40,550
!يا إلهي! أين أنت يا ريوهي؟

259
00:20:40,880 --> 00:20:41,700
!رينا

260
00:21:46,000 --> 00:21:47,080
أخي؟

261
00:23:25,040 --> 00:23:27,380
في الحلقة القادمة

262
00:23:25,840 --> 00:23:27,210
!أيّها الغبيّ ريوهي

263
00:23:27,210 --> 00:23:31,260
!تناولت السّومنيوم دروب ودخلت الترويميراي بدوننا

264
00:23:31,260 --> 00:23:33,220
.ظننتُ أنّنا أصدقاء

265
00:23:33,220 --> 00:23:36,810
!عندما ألحق بك، فسأصفعك بكلّ ما لديّ

266
00:23:36,810 --> 00:23:38,810
."في الحلقة القادمة: "الوفاء لمشاعرك

267
00:23:37,010 --> 00:23:40,020
الوفاء لمشاعرك