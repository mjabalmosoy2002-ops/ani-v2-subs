1
00:00:01,070 --> 00:00:02,770
تريد نصب كمينٍ للقلعة المُتحرّكة؟

2
00:00:02,770 --> 00:00:07,150
أجل، ستختبئ فرقتي في البحر
وتباغتهم من الوراء

3
00:00:07,150 --> 00:00:09,860
أتعتقد أنّ ذلك سيُفلح أمام فالغيا؟

4
00:00:09,860 --> 00:00:11,650
!إنّها القلعة المُتحرّكة

5
00:00:11,650 --> 00:00:16,870
وفقاً لإفادة ريريها-ساما، فهي أقرب
لكونها سفينة لاجئين من قلعة

6
00:00:17,160 --> 00:00:19,990
إن استطعنا دخولها، فيمكننا السيطرة عليها

7
00:00:19,990 --> 00:00:23,210
ما أهمّ من ذلك، من سيدافع عن بلادنا

8
00:00:23,210 --> 00:00:25,650
!في غيابك، قائد حرّاسنا الملكيّين؟

9
00:00:25,650 --> 00:00:26,270
مولنوتا

10
00:00:26,270 --> 00:00:26,710
أمرك؟

11
00:00:27,080 --> 00:00:28,740
لنراهن على خطّة أورينوغا

12
00:00:29,160 --> 00:00:31,440
سأقود الحرس الملكيّين

13
00:00:31,440 --> 00:00:32,470
!جلالتك

14
00:00:32,890 --> 00:00:34,840
نعتمد عليك يا أورينوغا

15
00:00:34,840 --> 00:00:37,620
أجل جلالتك، أعد بأن أجلب نتائجاً

16
00:00:39,670 --> 00:00:42,480
علينا الإسراع قبل أن يبدأ القتال

17
00:00:42,480 --> 00:00:48,060
يجب أن نري أبي والبقيّة الدليل
على شجرة القمّة العملاقة

18
00:00:48,340 --> 00:00:52,010
،كان عليّ أن أسأل قبلاً
لكنّي لم أفهم كليّاً بعد

19
00:00:52,010 --> 00:00:55,320
ما هي الكلمات المكتوبة بالضبط؟

20
00:00:55,320 --> 00:00:57,200
إنّها كلمات مكتوبة على لافتات

21
00:00:57,440 --> 00:01:00,830
لافتات؟ كلمات... مكتوبة؟

22
00:01:00,830 --> 00:01:05,020
اللافتات هي ألواحٌ تحوي كلماتاً

23
00:01:05,020 --> 00:01:08,750
كلّ رمز يحمل شكلاً يشير لكلمة

24
00:01:09,710 --> 00:01:10,800
صحيح؟

25
00:01:10,800 --> 00:01:16,910
أجل، كان الناس في الماضي يتركون
الأشياء الهامة في الكتابة

26
00:01:17,370 --> 00:01:18,870
ذلك ما أخبرني به أمين اللافتات

27
00:01:20,370 --> 00:01:25,560
ربما اللافتات التي جمعها أمين اللافتات
هي من العصر الذي عاش فيه الحكيم

28
00:01:26,010 --> 00:01:27,590
العصر الذي عاش فيه الحكيم؟

29
00:01:27,590 --> 00:01:28,230
أجل

30
00:01:28,470 --> 00:01:32,400
إن كانت الكلمات المكتوبة في الظلّة
،موجودةً في البحر الثلجيّ

31
00:01:32,630 --> 00:01:35,740
فهي دليلٌ على كون عالمينا مُتّحدين قبلاً

32
00:01:35,740 --> 00:01:38,700
فهمت، وذلك حين عاش الحكيم؟

33
00:01:38,700 --> 00:01:39,450
أجل

34
00:01:39,450 --> 00:01:43,910
تناقلنا المعلومات الهامّة شفويّاً
،أو عبر الطقوس السرّية

35
00:01:43,910 --> 00:01:48,080
لكن آنذاك، ربما تناقلها الناس
عبر الكلمات المكتوبة

36
00:01:48,080 --> 00:01:52,350
يُحتمل أنّهم تناقلوا أشياءً
أكثر من ذلك

37
00:01:52,350 --> 00:01:55,210
،حتّى للأشخاص البعيدين بمسافة
أو الناس من عصور مُختلفة

38
00:01:55,580 --> 00:01:58,530
مُذهل، ويمكنك قراءتها يا كاينا؟

39
00:01:58,530 --> 00:02:00,220
ذلك بفضل أمين اللافتات

40
00:02:00,470 --> 00:02:04,330
أتساءل ما إن كانوا جميعاً بخير؟

41
00:02:07,390 --> 00:02:11,530
الكلمات المكتوبة إذاً؟ أودّ
أن أتمكّن من قراءتها أيضاً

42
00:02:11,530 --> 00:02:12,940
سأعلّمك

43
00:03:49,410 --> 00:03:50,030
!مؤلم

44
00:03:51,330 --> 00:03:55,170
أتعتقدين أنّ أبي سيُصدّق
أمر شجرة القمّة حقّاً؟

45
00:03:55,170 --> 00:03:57,860
توارثت العائلة الملكيّة ذاك العلم

46
00:03:57,860 --> 00:03:59,920
حتّى أبي لا يستطيع تجاهل شيءٍ كذاك

47
00:03:59,920 --> 00:04:04,470
ولو صدّقنا أبي، لن يمنع ذلك
حربنا مع فالغيا

48
00:04:04,470 --> 00:04:09,810
أعرف، لذا نحن بحاجةٍ لإعلام
شعب فالغيا بطريقةٍ أيضاً

49
00:04:10,050 --> 00:04:14,220
نُعلمهم أنّ لا داعي لسرقة
الماء من بعضنا البعض

50
00:04:14,220 --> 00:04:18,410
أشكّ أن يكفي ذلك لإقناع أميرال
فالغيا بإيقاف الحرب

51
00:04:18,780 --> 00:04:19,730
الأميرال؟

52
00:04:19,730 --> 00:04:23,820
ذاك الرجل المُتوحّش الذي
حاول قتلكِ يا أختي

53
00:04:23,820 --> 00:04:26,310
لن أتعامل معه

54
00:04:27,080 --> 00:04:30,240
،أودّ الوصول لأهل آطلاند

55
00:04:30,240 --> 00:04:33,950
ولآهل فالغيا، لقلوب الناس

56
00:04:33,950 --> 00:04:37,710
،إن أظهرنا أنّنا نودّ إنقاذ الشعبين

57
00:04:37,950 --> 00:04:40,250
فأنا مُتأكّدةٌ أنّنا سنجد
أشخاصاً ينضمّون لنا

58
00:04:40,870 --> 00:04:42,260
مثل نوزي وجماعته؟

59
00:04:43,400 --> 00:04:44,150
أجل

60
00:04:45,330 --> 00:04:51,160
أنتِ أصلح بكثير لتكونين الملكة
منّي يا أختي

61
00:05:02,390 --> 00:05:03,330
ها هم

62
00:05:05,650 --> 00:05:06,830
!فالغيا

63
00:05:10,230 --> 00:05:12,080
يوجد جوادٌ ثلجيّ أمامنا

64
00:05:12,390 --> 00:05:14,590
لعلّه جنديّ استطلاع من آطلاند

65
00:05:15,540 --> 00:05:20,340
هل سيستسلمون رعباً
،من قوّتنا العظيمة

66
00:05:21,550 --> 00:05:23,380
...أم يا ترى

67
00:05:26,760 --> 00:05:31,000
أسمعتم؟ تمكّنت أميرة آطلاند من الهرب

68
00:05:31,000 --> 00:05:34,410
ماذا؟ ظننتُ أنّها غرقت في البحر الثلجيّ

69
00:05:34,410 --> 00:05:35,430
كيف نجت؟

70
00:05:35,650 --> 00:05:40,170
سمعتُ القصّة، يبدو أنّ بطلاً
من الظلّة قد أنقذها

71
00:05:40,170 --> 00:05:42,520
ماذا؟ بطل من الظلّة؟

72
00:05:47,340 --> 00:05:49,700
شجرة القمّة العملاقة؟ ما تلك؟

73
00:05:50,010 --> 00:05:52,650
أسمعتِ عن شجرة القمّة العملاقة؟

74
00:05:53,000 --> 00:05:56,620
يُقال أنّه لن يتعيّن علينا القلق
حيال الماء إن وجدناها

75
00:05:56,620 --> 00:05:58,400
أذلك صحيح؟

76
00:05:58,400 --> 00:06:01,540
ربما علينا التوجّه إلى شجرة القمّة
العملاقة بدل آطلاند إذاً

77
00:06:02,590 --> 00:06:05,290
سئمتُ من الحرب

78
00:06:07,580 --> 00:06:11,050
يبدو أنّ هناك شائعات غريبة
تنتشر بين الناس

79
00:06:11,320 --> 00:06:13,540
تقصدين تلك؟

80
00:06:13,540 --> 00:06:18,040
ربما ذلك لأنّنا سمحنا
بدخلاء آطلاند أولئك بالتوغّل بيننا

81
00:06:18,040 --> 00:06:21,060
ولم يساعدنا هروبهم أمام أنظارنا أيضاً

82
00:06:23,640 --> 00:06:29,070
يـُ-يُقال أنّ أميرة آطلاند قد
جلبت بطلاً من الظلّة

83
00:06:29,540 --> 00:06:32,870
أتذكّر تفوّهها بهراءٍ كذاك

84
00:06:32,870 --> 00:06:34,790
لكن لا يقتصر الأمر على ذلك

85
00:06:41,010 --> 00:06:42,420
شجرة القمّة العملاقة؟

86
00:06:42,670 --> 00:06:46,380
يبدو أنّها شجرة قمّة مداريّة
عملاقة لم تجفّ أبداً

87
00:06:53,510 --> 00:06:54,560
هذا غريب

88
00:06:54,830 --> 00:06:58,640
لم تذكر الأميرة ريريها شيئاً
عن ذلك أثناء استجوابها

89
00:07:00,920 --> 00:07:02,100
آميلوثي-ساما؟

90
00:07:05,430 --> 00:07:07,870
أخبرهم أنّنا سنحظى بالماء لأنفسنا
بعد هزيمة آطلاند

91
00:07:07,870 --> 00:07:08,630
!أمركِ

92
00:07:10,240 --> 00:07:14,370
لا بدّ أنّ الجميع يودّون الاستغراق
في الأحلام غير المنطقيّة

93
00:07:15,250 --> 00:07:16,680
...شجرة القمّة العملاقة

94
00:07:19,220 --> 00:07:21,500
،لو كانت شجرة كتلك موجودة

95
00:07:23,640 --> 00:07:27,470
لما تدمّر موطني

96
00:07:29,750 --> 00:07:31,030
هذا يُشعرني بالحنين

97
00:07:31,030 --> 00:07:32,290
تتذكّرين يا أختي؟

98
00:07:32,290 --> 00:07:33,970
أتينا هنا لقتال الوحوش

99
00:07:33,970 --> 00:07:36,930
تعيّن علينا العودة بسبب خوفك

100
00:07:36,930 --> 00:07:39,680
!ماذا؟ شعرتِ بالخوف أيضاً

101
00:07:41,400 --> 00:07:42,990
لم يتغيّر أبداً

102
00:07:42,990 --> 00:07:44,400
ها هي، هذه

103
00:07:45,130 --> 00:07:47,970
إنّها مُشابهة للتي في غرفة العرش

104
00:07:47,970 --> 00:07:53,740
،أجل، كانت تمتلك نمطاً يبدو كالكلمات
لكن غير قابلة للقراءة

105
00:07:54,000 --> 00:07:57,120
لكنّ شكل هذه أوضح وأكثر قابليّة للقراءة

106
00:07:57,410 --> 00:08:01,500
قد يكون العلم في غرفة العرش
نسخة من هذا

107
00:08:01,500 --> 00:08:06,760
بعد مرور عدّة أجيال، لعلّهم نسوا
أنّهم كانوا ينسخون كلماتاً

108
00:08:07,570 --> 00:08:09,760
إذاً؟ ما المكتوب؟

109
00:08:13,500 --> 00:08:14,300
إذاً؟

110
00:08:14,950 --> 00:08:17,800
لا تخبرني أنّك لا تستطيع قراءتها؟

111
00:08:19,960 --> 00:08:21,020
لا أستطيع

112
00:08:21,020 --> 00:08:22,310
!ماذا؟

113
00:08:26,970 --> 00:08:28,650
وصلوا أخيراً

114
00:08:28,650 --> 00:08:31,290
!أسرعوا جميعاً للقاعة الكبيرة

115
00:08:31,290 --> 00:08:33,730
!إنّهم فالغيا! لقد وصلوا

116
00:08:33,730 --> 00:08:35,520
!ما الذي سيحلّ بنا؟

117
00:08:35,520 --> 00:08:36,700
إنّهم قريبون جدّاً

118
00:08:37,050 --> 00:08:38,900
!بسرعة! للقاعة الكبيرة

119
00:08:40,450 --> 00:08:42,230
ما قصدك يا كاينا؟

120
00:08:42,230 --> 00:08:43,730
ألم تكن كلماتاً مكتوبة؟

121
00:08:43,730 --> 00:08:47,380
لكن هناك أشياءً مكتوبة
شبيهة بالكلمات، أليس كذلك؟

122
00:08:48,950 --> 00:08:52,920
لعلّ الكلمات المكتوبة في الظلّة وهنا مُختلفة

123
00:08:55,290 --> 00:08:57,170
!هدفنا هو أسطول فالغيا

124
00:08:58,010 --> 00:08:59,210
!استعداد

125
00:09:02,430 --> 00:09:05,940
الأسوار تمنعنا من الاقتراب
!من شجرة القمّة

126
00:09:05,940 --> 00:09:07,740
!لكافّة السفن، استعدّوا للإطلاق

127
00:09:07,740 --> 00:09:08,360
!أمرك

128
00:09:08,360 --> 00:09:09,510
!إطلاق

129
00:09:12,650 --> 00:09:16,250
!إطلاق

130
00:09:20,990 --> 00:09:23,080
!إطلاق! ردّوا عليهم

131
00:09:28,230 --> 00:09:30,130
!كلّا، علينا السماح للحرس الملكيّين بالتراجع

132
00:09:30,130 --> 00:09:31,810
،مع كامل احترامي جلالتك

133
00:09:31,810 --> 00:09:35,310
إن تراجعوا، فلن تصل طلقات
مدافعنا أسطول فالغيا

134
00:09:35,310 --> 00:09:36,880
كما انظر هناك رجاءً

135
00:09:36,880 --> 00:09:42,140
لا يستطيع العدوّ الاقتراب أكثر
بسبب الأسوار التي نشرناها

136
00:09:42,140 --> 00:09:46,180
يبدو أنّ أقصى مدى منجنيق
فالغيا هو منطقة المرفأ فحسب

137
00:09:46,180 --> 00:09:48,180
...إن استطعنا تعطيل المنجنيق

138
00:09:48,180 --> 00:09:49,510
تقصدين أنّ علينا الصمود؟

139
00:09:50,760 --> 00:09:54,940
حسناً، سأقود الحرس الملكيّين
!من برج المراقبة في المرفأ

140
00:09:54,940 --> 00:09:57,490
!من برج المراقبة؟ ذلك خطرٌ جلالتك

141
00:09:57,490 --> 00:10:00,230
!وعدتُ أورينوغا أنّي سأحمي بلادنا

142
00:10:00,230 --> 00:10:01,370
!جلالتك

143
00:10:04,700 --> 00:10:05,400
!هيّا بنا

144
00:10:05,400 --> 00:10:06,160
!أجل

145
00:10:16,970 --> 00:10:18,370
!ابقوا منخفضين

146
00:10:26,510 --> 00:10:27,770
ماذا نفعل يا أختي؟

147
00:10:27,770 --> 00:10:29,470
ماذا يسعنا أن نفعل؟

148
00:10:29,470 --> 00:10:33,230
أتعتقدين أنّ أبي سيستمع لنا
بمجرّد هذا فحسب؟

149
00:10:33,230 --> 00:10:34,270
!مستحيل

150
00:10:34,270 --> 00:10:38,380
،إذا لم نستطع قراءة ما هو مكتوب
فهو محض علمٍ بأشكال

151
00:10:38,380 --> 00:10:40,410
لنرجع للوقت الراهن

152
00:10:40,410 --> 00:10:43,490
قد يُستولى على آطلاند
بينما نحن ساكنون هنا

153
00:10:43,490 --> 00:10:45,940
!ياونا! لا تقل أشياء كتلك

154
00:10:45,940 --> 00:10:46,940
...لكن

155
00:10:46,940 --> 00:10:51,710
لا خيار أمامنا، سأشرح كلّ شيءٍ
...باستعمال هذا العلم

156
00:10:52,250 --> 00:10:53,070
بمخيّلتي

157
00:10:53,070 --> 00:10:53,490
!ماذا؟

158
00:10:53,490 --> 00:10:56,260
،قد لا نستطيع قراءة الكلمات
لكنّي سأرتجل في شرحي

159
00:10:56,260 --> 00:10:58,170
!ذلك تهوّر

160
00:10:59,460 --> 00:11:02,070
هذه مقلوبةٌ يا أمين اللافتات

161
00:11:04,010 --> 00:11:06,510
!ما عسانا نفعل غير ذلك؟

162
00:11:06,510 --> 00:11:07,270
!وجدتُها

163
00:11:08,190 --> 00:11:09,530
ساعداني

164
00:11:09,990 --> 00:11:11,090
!هيّا، بسرعة

165
00:11:19,430 --> 00:11:24,030
ستُزال الأسوار سريعاً، الأفضليّة لأسطولنا بالفعل

166
00:11:24,430 --> 00:11:27,800
هذا سهلٌ جدّاً، يُفترض أن تكون
آطلاند أشدّ مقاومة

167
00:11:27,800 --> 00:11:31,710
تظنّين ذلك؟ إنّه جيش بلدٍ صغير

168
00:11:32,190 --> 00:11:37,860
،تمتلك آطلاند سلاح فرسانٍ من النخبة
لمَ لم يطلقونهم؟

169
00:11:39,210 --> 00:11:41,880
فهمت، كانت مقلوبة

170
00:11:41,880 --> 00:11:44,620
!يا إلهي! أقلقتنا يا كاينا

171
00:11:44,620 --> 00:11:45,350
آسف

172
00:11:45,620 --> 00:11:48,670
يتغيّر شكل الكلمات
عندما تكون مقلوبة

173
00:11:48,670 --> 00:11:51,280
لذا ظننتُ أنّها كانت كلماتاً
لم أعرفها بعد

174
00:11:51,280 --> 00:11:52,870
ما المكتوب إذاً؟

175
00:11:53,740 --> 00:11:56,520
"هنا مكتوبٌ "شجرة القمّة المداريّة

176
00:11:58,080 --> 00:11:59,550
هذه "شجرة القمّة المداريّة" إذاً؟

177
00:11:59,550 --> 00:12:00,350
وهنا أيضاً

178
00:12:02,100 --> 00:12:04,450
أيعني ذلك أنّ المكتوب هنا
شجرة القمّة المداريّة" أيضاً؟"

179
00:12:04,450 --> 00:12:06,680
أجل، أحسنت

180
00:12:06,680 --> 00:12:08,120
!يمكنني القراءة

181
00:12:08,350 --> 00:12:11,120
فهمت، هذه هي "الكلمات المكتوبة" إذاً

182
00:12:11,950 --> 00:12:13,080
أتلك كذلك أيضاً؟

183
00:12:13,080 --> 00:12:13,620
أجل

184
00:12:20,550 --> 00:12:21,570
كما ظننت

185
00:12:21,570 --> 00:12:22,290
ماذا؟

186
00:12:22,290 --> 00:12:23,340
هذه خريطة

187
00:12:23,610 --> 00:12:26,870
انظرا، هذه القرية في الظلّة
التي عشتُ فيها

188
00:12:27,350 --> 00:12:28,970
هذه آطلاند

189
00:12:28,970 --> 00:12:31,640
وهنا شجرة القمّة العملاقة

190
00:12:32,810 --> 00:12:35,520
إنّها في نفس المكان الذي
رأيتُه من الظلّة

191
00:12:35,810 --> 00:12:39,880
،"الكلمة المكتوبة هذه تعني "العملاقة
أي شيء كبير الحجم

192
00:12:39,880 --> 00:12:43,140
أي إن استعملنا هذه دلالةً
،وسافرنا على متن سفينة

193
00:12:43,140 --> 00:12:45,960
فسنستطيع الوصول لشجرة القمّة العملاقة، صحيح؟

194
00:12:45,960 --> 00:12:47,070
!أجل

195
00:12:47,290 --> 00:12:48,710
!إنّهم قادمون من هنا

196
00:12:48,710 --> 00:12:50,090
!أطلقوا

197
00:12:50,090 --> 00:12:51,560
!إطلاق

198
00:12:51,560 --> 00:12:53,040
!حسنٌ

199
00:12:53,040 --> 00:12:55,620
!هجوم قادم من القلعة! كونوا حذرين

200
00:12:56,170 --> 00:13:00,620
إذا لم تُطلق آطلاند نخبة قوّاتها بعد، فمتى ستفعل؟

201
00:13:01,910 --> 00:13:02,380
...أيمكن

202
00:13:02,610 --> 00:13:04,050
!آميلوثي-ساما

203
00:13:04,050 --> 00:13:04,760
!انظري هناك

204
00:13:06,440 --> 00:13:07,620
...إنّه

205
00:13:07,620 --> 00:13:10,160
أينوون مهاجمة القلعة مباشرةً؟

206
00:13:10,160 --> 00:13:11,390
!أعلموا الأميرال

207
00:13:13,460 --> 00:13:14,680
!لديّ رسالة

208
00:13:15,150 --> 00:13:17,100
!إنّهم يستهدفون القلعة

209
00:13:17,100 --> 00:13:19,040
دعوهم

210
00:13:19,040 --> 00:13:23,530
لكن... معظم جنودنا على السفينة
مما يترك القلعة عرضةً للهجوم

211
00:13:24,330 --> 00:13:30,230
من سنفتقد هناك إن قُتِلوا؟

212
00:13:31,670 --> 00:13:35,290
نجحنا! يعني هذا أنّنا سنستطيع
!الوصول لشجرة القمّة العملاقة

213
00:13:35,290 --> 00:13:36,250
!نجحنا

214
00:13:36,520 --> 00:13:41,960
،أخبرني يا كاينا، إن كانت هذه خريطة
فما معنى هذه الأنماط؟

215
00:13:42,940 --> 00:13:44,800
كلمة "عملاق" مكتوبةٌ هنا أيضاً

216
00:13:45,550 --> 00:13:48,390
"لكن لا تسبقها "شجرة القمّة المداريّة

217
00:13:48,780 --> 00:13:52,700
"مكتوبٌ هنا... "الخندق البحريّ العملاق

218
00:13:52,700 --> 00:13:53,450
ماذا؟

219
00:13:53,450 --> 00:13:55,870
أتساءل ما معنى "الخندق البحريّ"؟

220
00:13:55,870 --> 00:13:57,820
مكتوبٌ "الخندق البحريّ"؟

221
00:13:57,820 --> 00:13:58,500
أجل

222
00:13:59,170 --> 00:14:00,170
...لا نستطيع إذاً

223
00:14:00,170 --> 00:14:00,900
ماذا؟

224
00:14:00,900 --> 00:14:09,070
إن كانت هذه شجرة القمّة العملاقة، فالخندق
البحريّ العملاق يسدّ طريقنا

225
00:14:09,070 --> 00:14:10,500
يسدّه؟

226
00:14:10,500 --> 00:14:16,210
حتّى السفن بالعصيّ الثلجيّة لا تستطيع
عبور البحر الثلجيّ الثقيل في الخنادق البحريّة

227
00:14:16,210 --> 00:14:18,100
ماذا؟ لا يمكننا الذهاب بالسفينة؟

228
00:14:18,100 --> 00:14:19,790
"ناهيك عن أنّه خندق بحريّ "عملاق

229
00:14:19,790 --> 00:14:25,630
،إن كان مقياس هذه الخريطة دقيقاً
...فهو خندقٌ هائلٌ جدّاً

230
00:14:25,930 --> 00:14:30,890
بعدما ظننتُ أنّنا وجدنا
...طريقةً لإنقاذ الجميع

231
00:14:38,260 --> 00:14:41,020
!اقتحام للعدوّ! اقتحام للعدوّ

232
00:14:45,870 --> 00:14:46,630
!انتظروا

233
00:14:46,940 --> 00:14:48,740
ليسوا جنوداً، دعوهم

234
00:14:48,740 --> 00:14:50,720
علينا الصعود للأعلى

235
00:14:50,720 --> 00:14:51,570
!اتبعوني

236
00:14:58,330 --> 00:15:01,790
،السطح الداخليّ ليس مُبهراً
كما قالت ريريها-ساما

237
00:15:02,140 --> 00:15:04,060
...حضرة القائد، هذا المكان

238
00:15:13,690 --> 00:15:16,070
توجّهوا للجسر في قمّة القلعة

239
00:15:16,470 --> 00:15:17,310
لنسرع

240
00:15:17,310 --> 00:15:18,060
!أمرك

241
00:15:18,770 --> 00:15:21,600
بـ-بأيّ حال، لنُرجع هذه معنا وحسب

242
00:15:21,600 --> 00:15:25,000
بعدما نريها لأبي، قد تخطر له خطّة

243
00:15:25,000 --> 00:15:26,020
معك حقّ

244
00:15:26,020 --> 00:15:27,150
كاينا، فلتساعدني

245
00:15:27,410 --> 00:15:28,150
حسناً

246
00:15:41,650 --> 00:15:43,840
ما هذا؟

247
00:15:43,840 --> 00:15:48,760
أهذه... عصا ثلجيّة؟ حجمها كبير

248
00:15:48,760 --> 00:15:51,990
أختي، أتعتقدين أنّ هذه عصا ثلجيّة؟

249
00:15:52,810 --> 00:15:55,800
يصعب تصديق الأمر، لكنّي متأكّدة من ذلك

250
00:15:57,770 --> 00:16:01,340
بعصا بهذه الحجم، يمكننا صنع سفينة مُذهلة

251
00:16:02,500 --> 00:16:07,920
اسمعا، أتعتقدا أنّ بإمكاننا عبور الخندق
البحريّ العملاق بهذه السفينة؟

252
00:16:08,540 --> 00:16:09,480
انظر هنا

253
00:16:10,180 --> 00:16:14,330
ربما علينا الذهاب هناك باستعمال
العصا الثلجيّة العملاقة

254
00:16:15,020 --> 00:16:16,930
معك حقّ

255
00:16:17,660 --> 00:16:19,130
!لا بدّ من ذلك

256
00:16:19,130 --> 00:16:22,960
لذا ترك أسلافنا هذه العصا
الثلجيّة العملاقة مع العلم

257
00:16:22,960 --> 00:16:27,460
في آطلاند، فُقِدت مهارة
بناء سفنٍ عملاقة

258
00:16:27,460 --> 00:16:29,540
...لكن إن استطعنا استعمال سفينة فالغيا

259
00:16:37,980 --> 00:16:39,300
...عددهم كبير

260
00:16:39,300 --> 00:16:41,220
!وانظر لتلك القلعة

261
00:16:41,220 --> 00:16:44,020
يستحيل أن نستطيع هزيمة شيءٍ
!بهذا الحجم الهائل

262
00:16:44,020 --> 00:16:45,100
!لا تثبط عزيمتكم

263
00:16:45,100 --> 00:16:48,700
!من سيحمي آطلاند إن استسلمنا؟

264
00:16:48,700 --> 00:16:51,030
!جهّزوا المدافع

265
00:16:51,280 --> 00:16:52,050
أختي

266
00:16:52,050 --> 00:16:54,860
أتمنّى لو بإمكاننا أخذ هذه
العصا الثلجيّة العملاقة معنا

267
00:16:54,860 --> 00:16:56,070
لكنّنا لا نستطيع الآن

268
00:16:56,070 --> 00:16:59,010
لنأخذ هذا العلم معنا
على الأقل إلى أبي

269
00:16:59,010 --> 00:16:59,950
أجل

270
00:16:59,950 --> 00:17:02,880
!آميلوثي-ساما! لديّ رسالة من الأميرال

271
00:17:02,880 --> 00:17:03,410
ما هي؟

272
00:17:03,410 --> 00:17:07,290
قال بأن نوفّر التغطية
لسفينته من الوراء

273
00:17:07,290 --> 00:17:08,540
ماذا؟

274
00:17:10,450 --> 00:17:12,460
هل سيستعمل ذاك؟

275
00:17:12,720 --> 00:17:18,170
لتتقدّم كافة السفن للأمام، سنستلم زمام المعركة

276
00:17:18,170 --> 00:17:19,030
!أمرك

277
00:17:25,310 --> 00:17:28,060
تنتابني قشعريرةٌ متى رأيته

278
00:17:29,620 --> 00:17:31,970
نابوجي، أترك قيادة هذه السفينة لك

279
00:17:31,970 --> 00:17:32,470
ماذا؟

280
00:17:32,470 --> 00:17:33,950
وفّر تغطيةً للأميرال

281
00:17:33,950 --> 00:17:37,320
ماذا؟ لكن... ماذا عنكِ يا آميلوثي-ساما؟

282
00:17:37,660 --> 00:17:39,990
!جهّزوا قارباً! سآخذ خمسة جنودٍ معي

283
00:17:40,910 --> 00:17:42,290
آميلوثي-ساما؟

284
00:17:42,710 --> 00:17:45,040
!تقدّموا! تقدّموا

285
00:17:45,040 --> 00:17:47,860
مقاومتهم ضعيفة، ما الذي يجري؟

286
00:17:58,210 --> 00:17:59,560
العرض على وشك البدء

287
00:18:10,030 --> 00:18:13,440
.حسنٌ، وصلنا للأعلى
هل الجميع معي؟

288
00:18:13,440 --> 00:18:14,620
!أجل

289
00:18:15,430 --> 00:18:16,750
هذا ما تبقّى منّا فحسب؟

290
00:18:18,110 --> 00:18:19,990
!سنستولي على برج قيادة القلعة

291
00:18:19,990 --> 00:18:21,390
!إنّهم جنود آطلاند

292
00:18:21,390 --> 00:18:22,080
!كيف وصلوا هنا؟

293
00:18:22,300 --> 00:18:25,410
!تراجعوا إذا لم تريدوا الموت

294
00:18:38,130 --> 00:18:39,640
!استولينا على برج القيادة

295
00:18:41,850 --> 00:18:44,210
أليس هذا برج القيادة؟

296
00:18:44,210 --> 00:18:45,720
لسوء حظّك

297
00:18:50,940 --> 00:18:52,110
!أنتِ

298
00:19:00,450 --> 00:19:01,340
!تبّاً

299
00:19:04,660 --> 00:19:07,040
كانت خطّةً جيّدة، لكنّها تنتهي هنا

300
00:19:07,320 --> 00:19:09,260
!لم نحسم قتالنا بعد

301
00:19:16,610 --> 00:19:18,050
استسلم

302
00:19:18,050 --> 00:19:19,850
لا داعي للموت بلا معنى

303
00:19:19,850 --> 00:19:22,440
لمَ تتبعين إمرته؟

304
00:19:23,080 --> 00:19:26,020
نصبوا كميناً لموطنكِ

305
00:19:26,020 --> 00:19:29,870
لمَ تتبعين قائداً يأبى إرجاع
أسطوله لحماية شعبه؟

306
00:19:30,980 --> 00:19:34,610
!ستخسرون بعدما نسيطر على هذا المكان

307
00:19:34,610 --> 00:19:38,690
لا جدوى. فلتنظر، إنّه على وشك التفعيل

308
00:19:55,240 --> 00:19:56,660
!انظروا هناك

309
00:19:56,660 --> 00:19:58,210
!بدأ شكله يتغيّر

310
00:20:24,530 --> 00:20:26,080
ما هذا؟

311
00:20:26,080 --> 00:20:28,990
نسمّيه بالمعماريّ

312
00:20:34,470 --> 00:20:38,060
إنّه عملاق، ويتحرّك! أهو مخلوقٌ حيّ؟

313
00:20:38,060 --> 00:20:39,980
!سيهاجمنا

314
00:20:39,980 --> 00:20:41,670
!هلكت آطلاند

315
00:20:44,680 --> 00:20:47,100
ما ذاك الشيء؟

316
00:20:47,470 --> 00:20:50,470
!اصمدوا! إطلاق! إطلاق

317
00:21:03,350 --> 00:21:04,570
ما ذلك؟

318
00:21:05,340 --> 00:21:08,890
إنّه عملاق الحجم، أهو سلاحٌ لفالغيا؟

319
00:21:09,580 --> 00:21:13,170
أيمكن أنّه ما كان نوزي يتكلّم عنه؟

320
00:21:14,530 --> 00:21:15,540
...الوحش