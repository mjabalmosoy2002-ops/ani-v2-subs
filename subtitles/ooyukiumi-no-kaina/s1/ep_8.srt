1
00:00:00,000 --> 00:00:02,280
!تبّاً له! سأحطّمه

2
00:00:06,670 --> 00:00:10,380
!إنّها مشكلة! الجنود متوجّهون إلينا

3
00:00:11,240 --> 00:00:13,820
ماذا نفعل يا نوزي؟ هل نسلّمهم؟

4
00:00:13,820 --> 00:00:14,740
!أخي

5
00:00:18,010 --> 00:00:19,500
سنعطيكم قاربنا

6
00:00:19,500 --> 00:00:20,630
...مهلاً، ذلك

7
00:00:20,630 --> 00:00:21,200
انظروا

8
00:00:21,710 --> 00:00:26,230
بنيناه كي نستعمله عندما نجد شجرة
قمّة يمكننا الاحتفاظ بها لأنفسنا

9
00:00:26,490 --> 00:00:28,460
ذاك القارب أملنا

10
00:00:29,380 --> 00:00:32,350
لذا أئتمنكم عليه

11
00:00:32,770 --> 00:00:33,720
...نوزي

12
00:00:33,720 --> 00:00:37,650
،إن وصلتم لآطلاند بسلام وتمكّنتم من النجاة

13
00:00:37,650 --> 00:00:39,470
فأودّ منكم إيجاد شجرة القمّة العملاقة

14
00:00:39,470 --> 00:00:40,510
أتثق بهم؟

15
00:00:41,890 --> 00:00:44,100
أثق بحقيقة كلام كاينا

16
00:00:45,730 --> 00:00:46,710
شكراً لك

17
00:00:48,060 --> 00:00:49,440
!هنا

18
00:00:49,900 --> 00:00:52,050
!وجدتُ أميرة آطلاند

19
00:00:52,050 --> 00:00:52,860
!لنذهب

20
00:00:53,170 --> 00:00:55,720
!من هنا! تعالوا جميعاً

21
00:00:59,570 --> 00:01:00,590
لنستغلّ الفرصة

22
00:01:01,980 --> 00:01:04,620
شكراً لكم، لا أعرف كيف أعبّر عن امتنانا

23
00:01:04,620 --> 00:01:06,290
لا تهتمّي بشكرنا

24
00:01:06,290 --> 00:01:09,210
عدينا وحسب أن تعثروا
على شجرة القمّة العملاقة

25
00:01:09,210 --> 00:01:10,220
نعدك

26
00:01:12,340 --> 00:01:13,840
إلى اللقاء يا تشيرو

27
00:01:13,840 --> 00:01:15,010
أجل

28
00:01:15,010 --> 00:01:18,470
...تشيرو، تبقّى لديّ القليل وحسب، لكن

29
00:01:18,190 --> 00:01:18,780
ماذا؟

30
00:01:19,310 --> 00:01:20,700
إنّه ماءٌ من شجرة قمّة

31
00:01:20,700 --> 00:01:21,590
!ماذا؟

32
00:01:21,590 --> 00:01:22,520
اشربيه

33
00:01:22,520 --> 00:01:23,520
حسناً

34
00:01:29,260 --> 00:01:30,520
!لذيذ

35
00:01:30,740 --> 00:01:32,780
!هذا مذاق الماء الحقيقيّ

36
00:01:32,780 --> 00:01:33,490
أجل

37
00:01:34,700 --> 00:01:35,380
إلى اللقاء

38
00:01:35,380 --> 00:01:36,150
انتظروا

39
00:01:38,810 --> 00:01:40,120
أقسموا على الجمجمة

40
00:01:40,120 --> 00:01:41,310
هكذا

41
00:01:47,790 --> 00:01:50,880
نقسم بصداقتنا الأبديّة على هذه الجمجمة

42
00:01:51,170 --> 00:01:53,240
نقسم

43
00:01:56,510 --> 00:01:57,380
وداعاً

44
00:01:57,380 --> 00:01:59,640
أجل، فتلبقوا أحياءً حتّى نلقاكم من جديد

45
00:02:01,640 --> 00:02:03,530
أجل، إلى اللقاء

46
00:02:03,530 --> 00:02:04,350
!إلى اللقاء

47
00:04:12,470 --> 00:04:14,110
اسمع يا كاينا

48
00:04:14,930 --> 00:04:17,420
أأنت مُتأكّد أنّ هذا الاتّجاه الصحيح؟

49
00:04:17,420 --> 00:04:19,110
...حسناً

50
00:04:19,110 --> 00:04:23,150
أنحن مُتوجّهون نحو آطلاند حقّاً؟

51
00:04:23,150 --> 00:04:24,110
...في الواقع

52
00:04:25,100 --> 00:04:28,630
يُفترض أنّنا مُتوجّهون في نفس الاتّجاه
الذي كانت عليه فالغيا

53
00:04:28,630 --> 00:04:30,370
...لستُ متأكّداً من وضعنا يا أختي

54
00:04:32,340 --> 00:04:34,870
،لكن حتّى لو كان الاتّجاه العام صحيحاً

55
00:04:35,150 --> 00:04:39,020
...آطلاند بعيدة، لذا الانحراف الآن ولو قليلاً يعني

56
00:04:39,020 --> 00:04:40,330
!ماذا؟

57
00:04:40,670 --> 00:04:44,470
أمكننا رؤية النجوم دوماً فوق الظلّة

58
00:04:44,470 --> 00:04:45,390
النجوم؟

59
00:04:45,390 --> 00:04:45,800
أجل

60
00:04:46,110 --> 00:04:48,180
تلك النقاط اللامعة المُنتشرة في السماء

61
00:04:48,530 --> 00:04:51,350
استعملناها لتحديد اتّجاهنا العام

62
00:04:51,630 --> 00:04:57,270
لكن لا معالم ترشدنا
في البحر الثلجيّ ليلاً

63
00:04:57,640 --> 00:05:00,770
لكن كان أسطول فالغيا قادراً
على الإبحار ليلاً

64
00:05:00,770 --> 00:05:04,770
لا بدّ من وجود طريقةٍ نجهلها

65
00:05:05,220 --> 00:05:08,370
،لو تشارك الجميع المعلومات القيّمة

66
00:05:08,370 --> 00:05:11,290
لاستطعنا جميعاً عيش حياةٍ أفضل

67
00:05:11,610 --> 00:05:13,080
أنتِ مُحقّة

68
00:05:14,580 --> 00:05:18,110
بأيّ حال، ماذا سنفعل الآن؟
أحريّ بنا المواصلة هكذا؟

69
00:05:20,270 --> 00:05:22,300
لنرجع للموضوع صباحاً

70
00:05:22,300 --> 00:05:23,040
ماذا؟

71
00:05:23,040 --> 00:05:25,670
أعتقد أنّنا سنستطيع رؤية شجرة
القمّة بعد طلوع الشمس

72
00:05:25,670 --> 00:05:29,330
لو اكتشفنا أنّنا منحرفون عن المسار
قليلاً، فيمكننا تعديله حينها

73
00:05:29,330 --> 00:05:30,540
معك حقّ

74
00:05:30,850 --> 00:05:34,220
كلّ ما يسعنا فعله الآن هو مواصلة
الحركة كيلا تلحق بنا فالغيا

75
00:05:34,460 --> 00:05:35,510
لنتناوب على النوم

76
00:05:35,510 --> 00:05:36,100
ماذا؟

77
00:05:36,100 --> 00:05:37,290
ناما قبلي

78
00:05:37,290 --> 00:05:40,520
لن تخطر لنا خططٌ جيّدة إن كنّا مُنهكين

79
00:05:40,520 --> 00:05:42,240
علينا الاستراحة

80
00:05:42,240 --> 00:05:43,180
...يا إلهي

81
00:05:49,100 --> 00:05:52,200
لا بدّ أنّكِ سئمتِ من البرد الآن، صحيح؟

82
00:05:53,580 --> 00:05:54,700
شكراً لك

83
00:06:26,650 --> 00:06:27,610
!ياونا

84
00:06:29,590 --> 00:06:30,410
!ياونا

85
00:06:30,880 --> 00:06:31,450
ماذا؟

86
00:06:31,450 --> 00:06:33,490
!إنّه ياونا! أوقفي القارب يا ريريها

87
00:06:33,490 --> 00:06:34,060
!ماذا؟

88
00:06:34,760 --> 00:06:35,490
!حسناً

89
00:06:38,290 --> 00:06:41,320
!هيّا، القليل فحسب! تماسك

90
00:06:46,980 --> 00:06:48,700
حمداً لله

91
00:06:51,640 --> 00:06:52,850
حسنٌ

92
00:06:53,190 --> 00:06:54,570
أنت بخيرٍ الآن

93
00:06:54,570 --> 00:06:58,220
يا إلهي، أنت كثير الحركة
في نومك يا ياونا

94
00:06:58,220 --> 00:06:59,410
أنا آسف

95
00:06:59,410 --> 00:07:01,640
...حسناً، يُفترض أن نتّجه

96
00:07:02,620 --> 00:07:03,790
هناك ربما

97
00:07:03,790 --> 00:07:05,260
ماذا؟ أأنت مُتأكّد؟

98
00:07:05,260 --> 00:07:07,990
...لا أستطيع الجزم بثقتي، لكن

99
00:07:09,150 --> 00:07:10,380
هذه غلطتي

100
00:07:12,090 --> 00:07:13,710
لنبطئ سرعتنا

101
00:07:14,130 --> 00:07:16,290
يُفترض أنّنا ابتعدنا عن فالغيا بمسافة

102
00:07:17,020 --> 00:07:20,650
لنبقَ متيقّظين لما حولنا
كيلا تفوتنا أشجار قمّة

103
00:07:21,030 --> 00:07:21,730
أجل

104
00:07:28,850 --> 00:07:29,980
إنّه الثلج

105
00:07:29,980 --> 00:07:31,490
في وقتٍ كهذا؟

106
00:07:33,740 --> 00:07:35,510
لا يمكننا رؤية شيءٍ هكذا

107
00:07:46,300 --> 00:07:47,450
شكراً لك

108
00:08:00,330 --> 00:08:03,290
أتساءل ما إن كنّا سنستطيع العودة لآطلاند

109
00:08:03,290 --> 00:08:05,380
لا تكن مُتشائماً يا ياونا

110
00:08:05,380 --> 00:08:10,020
يُفترض أنّنا لم ننحرف عن المسار
كثيراً بما أنّنا أبطأنا سرعتنا

111
00:08:10,450 --> 00:08:13,400
يجب أن تتراءى لنا شجرة
قمّة آطلاند في الصباح

112
00:08:13,400 --> 00:08:16,090
!لكنّ فالغيا ستلحق بنا على هذا النحو

113
00:08:16,090 --> 00:08:21,600
الثلج كثيف، لذا لا أتوقّع أن
تتحرّك فالغيا أيضاً... غالباً

114
00:08:21,600 --> 00:08:23,640
تذكّر يا ياونا

115
00:08:24,010 --> 00:08:29,320
كان سفرنا على الجذور أسفل البحر
الثلجيّ أكثر مشقّة، لكنّنا نجحنا

116
00:08:29,690 --> 00:08:32,810
كنت من أنقذني آنذاك

117
00:08:33,620 --> 00:08:34,950
صحيح

118
00:08:37,000 --> 00:08:41,050
ونحن مررنا بعوائق مهولة عندما
نزلنا من شجرة القمّة

119
00:08:41,050 --> 00:08:41,850
أليس كذلك يا كاينا؟

120
00:08:41,850 --> 00:08:43,870
ماذا؟ بـ-بلى

121
00:08:43,870 --> 00:08:47,170
ظننتني هالكةً أكثر من مرّة

122
00:08:47,170 --> 00:08:50,780
...ما يجري لا يُذكر مقارنةً

123
00:08:54,550 --> 00:08:57,840
،ما أرمي إليه يا ياونا
،إن تعاونّا جميعاً

124
00:08:58,060 --> 00:09:00,430
فلا شيء لا يمكننا تجاوزه

125
00:09:01,990 --> 00:09:05,820
أخبرني المزيد عن قصّة
نزولكِ من الظلّة

126
00:09:05,820 --> 00:09:06,630
ماذا؟

127
00:09:06,630 --> 00:09:08,900
وعن القرية على الظلّة

128
00:09:08,900 --> 00:09:09,440
ماذا؟

129
00:09:09,780 --> 00:09:12,940
ما كان رأي أهل القرية بكِ يا أختي؟

130
00:09:13,560 --> 00:09:15,950
لم يعرفوا أنّ هناك ناساً
يعيشون على البحر الثلجيّ، صحيح؟

131
00:09:16,240 --> 00:09:18,700
ثوب زفافكِ

132
00:09:19,530 --> 00:09:21,070
...حسناً

133
00:09:23,540 --> 00:09:26,980
كان الجميع بغاية اللطف معي

134
00:09:26,980 --> 00:09:29,060
صنعوا لي هذه الثياب

135
00:09:29,060 --> 00:09:31,650
وعلّمونا كيفيّة النزول

136
00:09:33,380 --> 00:09:34,830
أنا مُمتنّةٌ لهم كثيراً

137
00:09:35,890 --> 00:09:39,300
،أرادت المُسنّات أن تبقى ريريها هناك

138
00:09:39,590 --> 00:09:44,140
لكنّهم أعطونا أدواتاً كي نستطيع النزول بصرف النظر

139
00:09:45,750 --> 00:09:47,390
ما كان أكبر عائق؟

140
00:09:47,390 --> 00:09:48,600
ماذا؟

141
00:09:48,600 --> 00:09:51,090
حسناً، لا بدّ أنّها تلك ا

142
00:09:53,730 --> 00:09:55,380
!ذبابة الشجرة العملاقة

143
00:09:55,380 --> 00:09:57,400
ما-ما تلك؟

144
00:09:57,400 --> 00:09:59,390
إنّها حشرةٌ تعيش بالقرب من الظلّة

145
00:09:59,390 --> 00:10:01,550
إنّها أكبر من سفينة لـ فالغيا

146
00:10:01,550 --> 00:10:03,130
!لا بدّ أنّكِ تمزحين

147
00:10:03,130 --> 00:10:05,660
!إنّها الحقيقة! كانت بهذا الحجم الهائل

148
00:10:05,660 --> 00:10:08,290
سقطت ريريها في عشّ تلك الحشرة

149
00:10:08,520 --> 00:10:10,710
غضبت الذبابة لذلك، وهاجمتني

150
00:10:10,710 --> 00:10:13,210
لكنّ كاينا أنقذني في لنهاية

151
00:10:14,860 --> 00:10:17,220
آمل أن تتسنّى لي رؤية
ذبابة الشجرة العملاقة أيضاً

152
00:10:18,590 --> 00:10:20,830
أنا متأكّدٌ أنّك ستستطيع يوماً ما

153
00:10:39,500 --> 00:10:40,750
أين نحن؟

154
00:10:44,310 --> 00:10:46,020
هذه ليست آطلاند

155
00:10:46,020 --> 00:10:47,550
ربما انحرفنا عن المسار؟

156
00:10:50,990 --> 00:10:53,630
انظر يا كاينا! ألا يبدو هذا المكان مألوفاً؟

157
00:10:54,620 --> 00:10:57,070
سبق وأن أتينا هنا

158
00:10:58,050 --> 00:11:01,070
عندما كنّا نمشي على الجذور
في طريقنا لإنقاذ أختي

159
00:11:01,070 --> 00:11:01,800
أجل

160
00:11:02,390 --> 00:11:04,210
!إنّه الجذر نفسه

161
00:11:04,210 --> 00:11:05,510
...مما يعني

162
00:11:09,470 --> 00:11:10,620
!تلك آطلاند

163
00:11:10,620 --> 00:11:14,190
!رجعنا، استطعنا الرجوع

164
00:11:14,190 --> 00:11:17,820
انحرفنا قليلاً، لكنّنا لم نبتعد بذاك القدر

165
00:11:17,820 --> 00:11:20,000
!نجحنا يا كاينا! أختي

166
00:11:20,000 --> 00:11:23,090
!أجل

167
00:11:21,670 --> 00:11:22,180
!هيّا بنا

168
00:11:32,470 --> 00:11:35,750
!الفرقة الأولى! الفرقة الثانية
!تمركزوا في مواقعكم عند المرفأ

169
00:11:35,970 --> 00:11:38,670
!فلتتحضّر بقيّة الفرق لعمليّة الهبوط

170
00:11:42,200 --> 00:11:44,060
!انظر هناك

171
00:11:46,290 --> 00:11:47,220
!جلالتك

172
00:11:47,680 --> 00:11:50,820
!رجعت ريريها-ساما وياونا-ساما

173
00:11:50,820 --> 00:11:51,850
!ماذا؟

174
00:11:52,090 --> 00:11:54,270
!الفتى من الظلّة معهما أيضاً

175
00:11:58,740 --> 00:12:02,290
!أبي

176
00:12:02,840 --> 00:12:05,450
!ريريها! ياونا! تسرّني عودتكما بخير

177
00:12:14,870 --> 00:12:16,150
!أيّها الفتى الصالح كاينا

178
00:12:16,150 --> 00:12:17,000
أجل؟

179
00:12:21,860 --> 00:12:22,890
!شكراً لك

180
00:12:24,000 --> 00:12:24,860
...لا داعي

181
00:12:26,470 --> 00:12:28,610
!سمعتُ أنّ ريريها-ساما رجعت

182
00:12:28,610 --> 00:12:30,290
!ياونا-ساما كذلك

183
00:12:30,290 --> 00:12:32,600
يُقال أنّهما هربا من قلعة فالغيا

184
00:12:32,600 --> 00:12:34,050
!تلك مُعجزة

185
00:12:34,050 --> 00:12:36,280
قالوا أنّ ذلك بفضل
الفتى من الظلّة

186
00:12:36,280 --> 00:12:38,060
يوجد بلادٌ فوق الظلّة؟

187
00:12:38,060 --> 00:12:40,580
أيعني ذلك أن الظلّة
سترسل لنا تعزيزاتاً؟

188
00:12:40,580 --> 00:12:43,870
!لدينا أملٌ بهزيمة فالغيا إذاً؟

189
00:12:49,540 --> 00:12:51,330
ما الذي تقولينه يا ريريها؟

190
00:12:51,330 --> 00:12:56,460
يمكننا منع هذه الحرب إن وجدنا
!شجرة القمّة المداريّة العملاقة

191
00:12:56,690 --> 00:13:02,340
عليّ أن أقول، قصّة ريريها-ساما
غير معقولة بحيث تتجاوز فهمي

192
00:13:02,340 --> 00:13:05,010
...إن أخبرنا فالغيا بهذا، فلا بدّ أنّهم

193
00:13:05,010 --> 00:13:06,430
ما رأيك يا أورينوغا؟

194
00:13:06,430 --> 00:13:11,800
سيّدي، حتّى لو عرفوا أنّ شجرة القمّة
،العملاقة تحتوي ماءً أكثر من آطلاند

195
00:13:11,800 --> 00:13:14,270
فلن تفوت فالغيا هذه الفرصة للإطاحة بنا

196
00:13:14,540 --> 00:13:15,640
!لم تفهمني

197
00:13:15,640 --> 00:13:17,930
علينا إخبارهم أنّ لا حاجة
!للقتال حول ذلك

198
00:13:17,930 --> 00:13:22,410
ليسوا سُذّجاً بحيث تنطلي
عليهم كذبة كهذه

199
00:13:22,410 --> 00:13:23,570
!ليست كذبة

200
00:13:23,790 --> 00:13:25,360
انتهينا من هذا النقاش

201
00:13:26,830 --> 00:13:31,370
جهّزنا حمّاماً بخارياً لكم، فلتذهبوا الثلاثة
لتدفئة أجسادكم الباردة

202
00:13:31,700 --> 00:13:34,470
مولنوتا، كيف هي تجهيزات إخلاء المواطنين؟

203
00:13:36,410 --> 00:13:37,380
!أبي

204
00:13:37,380 --> 00:13:41,930
لكنّي أشهد أنّ معلومتكِ في كون القلعة
المُتحرّكة محض استعراض مفيدة حقّاً

205
00:13:45,810 --> 00:13:47,480
!لا يصغي أبداً

206
00:13:47,480 --> 00:13:49,790
أختي، ما الذي سنفعله؟

207
00:13:51,300 --> 00:13:52,530
!كاينا-ساما

208
00:13:52,530 --> 00:13:54,030
!كاينا-ساما، تعال هنا

209
00:13:54,570 --> 00:13:59,130
كاينا-ساما هو بطلٌ أنقذ أميرتنا وأميرنا

210
00:13:59,130 --> 00:14:01,690
يستحقّ ترحيب بطل

211
00:14:01,690 --> 00:14:05,050
هذا ما أمر به جلالة الملك

212
00:14:05,780 --> 00:14:07,030
...ماذا؟ مهلاً

213
00:14:07,320 --> 00:14:09,380
هيّا، من هنا رجاءً

214
00:14:09,380 --> 00:14:11,110
...لكن، أنا

215
00:14:17,000 --> 00:14:18,040
!أختي؟

216
00:14:30,610 --> 00:14:32,970
اعذرنا يا كاينا-ساما

217
00:14:34,040 --> 00:14:34,870
حسناً

218
00:14:35,790 --> 00:14:37,770
كيف تجد الحمّام البخاريّ؟

219
00:14:38,050 --> 00:14:40,740
حسناً... إنّه رائعٌ جدّاً

220
00:14:41,190 --> 00:14:43,900
بعد إذنك إذاً

221
00:14:47,570 --> 00:14:49,400
لا تتوتّر رجاءً

222
00:14:49,400 --> 00:14:51,560
أرخ كامل جسدك

223
00:14:51,970 --> 00:14:54,330
استلقِ على معدتك هناك

224
00:14:55,720 --> 00:14:58,520
أهذه مرّتك الأولى في حمّامٍ بخاريّ؟

225
00:14:58,520 --> 00:15:00,080
أ-أجل

226
00:15:00,080 --> 00:15:03,070
ألا يوجد لديكم واحدٌ في الظلّة؟

227
00:15:03,070 --> 00:15:05,370
مكانٌ للاسترخاء كهذا؟

228
00:15:05,370 --> 00:15:07,820
لا شيء مثله

229
00:15:07,820 --> 00:15:11,680
سنكون رقيقتان معك إذاً

230
00:15:12,330 --> 00:15:13,470
لا تقلق

231
00:15:13,470 --> 00:15:17,410
ستحظى بتدليكٍ من أفضل مُحترفي
تدليك في آطلاند

232
00:15:17,410 --> 00:15:23,820
ستشعر بنعيمٍ كامل، استلقِ واسترخِ فقط

233
00:15:23,820 --> 00:15:26,360
جهزنا إذاً

234
00:15:26,360 --> 00:15:28,300
نأمل أن تستمتع به

235
00:15:28,300 --> 00:15:31,180
شـ-شكراً لكما

236
00:15:38,760 --> 00:15:40,570
لنبدأ إذاً

237
00:15:40,570 --> 00:15:41,410
!ماذا؟

238
00:15:43,300 --> 00:15:44,500
!مؤلم

239
00:15:44,500 --> 00:15:46,390
!هذا مؤلم! مؤلم

240
00:16:07,340 --> 00:16:08,660
ماذا؟

241
00:16:08,660 --> 00:16:10,280
ر-ريريها؟

242
00:16:10,280 --> 00:16:11,310
كاينا؟

243
00:16:15,240 --> 00:16:17,490
لـ-لم أعلم أنّك لا تزال هنا

244
00:16:17,490 --> 00:16:22,760
أجل... مررتُ بتدليك جسدٍ كامل

245
00:16:23,940 --> 00:16:25,130
من قِبل رجل

246
00:16:25,130 --> 00:16:25,830
ماذا؟

247
00:16:25,830 --> 00:16:27,850
لذا أنا مُنهك

248
00:16:31,350 --> 00:16:32,470
فهمت

249
00:16:32,470 --> 00:16:33,220
أجل

250
00:16:34,160 --> 00:16:35,640
سأخرج

251
00:16:35,640 --> 00:16:36,290
انتظر

252
00:16:38,050 --> 00:16:40,850
أيمكننا الكلام قليلاً؟

253
00:16:40,850 --> 00:16:42,200
...حسناً

254
00:16:42,200 --> 00:16:46,270
،بعدما أنقذتني، كان ياونا رفقتنا طوال الوقت

255
00:16:46,270 --> 00:16:48,650
فلم يتسنّ لنا الكلام على انفراد

256
00:16:48,650 --> 00:16:50,480
أ-أجل

257
00:16:53,000 --> 00:16:54,840
!يا أحمق، لا تنظر هنا

258
00:16:54,840 --> 00:16:56,070
آسف

259
00:16:57,090 --> 00:16:58,830
إيّاك والنظر، حسناً؟

260
00:16:58,830 --> 00:17:00,030
فهمت

261
00:17:03,620 --> 00:17:04,640
شكراً لك

262
00:17:05,390 --> 00:17:09,820
كنتُ مسرورةً جدّاً لقدومك لإنقاذي

263
00:17:11,070 --> 00:17:12,150
أجل

264
00:17:12,150 --> 00:17:17,400
سرعان ما افترقنا بعد نزولنا
من الظلّة، فشعرتُ بالقلق

265
00:17:18,110 --> 00:17:19,400
يسرّني أنّك كنت بخير

266
00:17:21,390 --> 00:17:24,180
آسفةٌ على توريطك

267
00:17:24,180 --> 00:17:24,890
ماذا؟

268
00:17:25,180 --> 00:17:29,530
لو بقيت في قريتك، لما مررت بهذا الخطر

269
00:17:29,530 --> 00:17:31,080
...لكن بسببي

270
00:17:31,800 --> 00:17:32,520
لا عليكِ

271
00:17:32,520 --> 00:17:33,360
ماذا؟

272
00:17:33,360 --> 00:17:35,490
أردتُ المساعدة

273
00:17:35,940 --> 00:17:41,780
غادرتُ قريتي بوعد أن
أعيدكِ إلى آطلاند

274
00:17:45,340 --> 00:17:46,120
اسمع يا كاينا

275
00:17:47,320 --> 00:17:48,370
استلقِ على معدتك

276
00:17:48,370 --> 00:17:49,290
ماذا؟

277
00:17:58,510 --> 00:17:59,740
لا تشعر بألم، صحيح؟

278
00:17:59,740 --> 00:18:01,600
كلّا، شكراً لك

279
00:18:02,510 --> 00:18:08,390
بعدما وصلتُ فالغيا، أدركت أنّ
لديهم مشاكلهم الخاصّة

280
00:18:08,850 --> 00:18:14,580
يوجد أطفالٌ مثل نوزي وتشيرو
يناضلون للعيش كلّ يوم

281
00:18:14,580 --> 00:18:15,460
أجل

282
00:18:15,780 --> 00:18:21,120
لكن لا يعذر ذلك سرقة فالغيا للماء

283
00:18:21,120 --> 00:18:23,070
وقتل كلّ من يعترض طريقهم

284
00:18:23,070 --> 00:18:24,120
معكِ حقّ

285
00:18:24,120 --> 00:18:27,160
أريد إنقاذ الجميع

286
00:18:27,160 --> 00:18:32,650
،أهل آطلاند، شعب فالغيا
...وأهل القرية فوق الظلّة

287
00:18:33,660 --> 00:18:35,160
...ولأجل ذلك

288
00:18:35,160 --> 00:18:37,170
نحتاج للماء

289
00:18:37,170 --> 00:18:38,220
صحيح

290
00:18:38,680 --> 00:18:41,850
لو امتلكنا الماء، يمكن للجميع مواصلة العيش

291
00:18:41,850 --> 00:18:45,350
لذا إن أخبرنا الجميع عن شجرة
،القمّة العملاقة

292
00:18:45,350 --> 00:18:47,770
يمكننا تجنّب الحروب العقيمة

293
00:18:47,770 --> 00:18:50,240
...أجل، لكن

294
00:18:50,240 --> 00:18:54,110
لا يقتضي إخبارهم أنّهم سيصدّقوننا

295
00:18:54,110 --> 00:18:54,980
صحيح

296
00:18:55,210 --> 00:18:57,900
حتّى أبي لم يصدّقني

297
00:18:58,290 --> 00:19:01,850
نحتاج لدليل، ليس كلمات فحسب

298
00:19:01,850 --> 00:19:04,620
...دليل، ليس كلمات فحسب

299
00:19:06,450 --> 00:19:07,950
!ربما تلك هي

300
00:19:07,950 --> 00:19:08,870
ماذا؟

301
00:19:08,870 --> 00:19:13,460
رأيتها عندما عبرت النفق
تحت الأرض مع ياونا

302
00:19:13,850 --> 00:19:16,920
كانت هناك قطعة قماشِ كبيرة
تحوي ما بدت كلمات مكتوبة

303
00:19:16,920 --> 00:19:19,720
كلمات مكتوبة؟ ما معنى ذلك؟

304
00:19:19,720 --> 00:19:24,120
أتذكرين الأشياء التي كان يقرؤها
أمين اللافتات في قريتي؟

305
00:19:24,120 --> 00:19:25,860
...حسناً

306
00:19:26,700 --> 00:19:29,840
مثل تعويذة ما على ألواح؟

307
00:19:29,840 --> 00:19:32,520
تبدو كأنماط، لكنّها كلمات

308
00:19:32,820 --> 00:19:36,150
رأيتُ شيئاً يشبهها في قبو هذه القلعة

309
00:19:36,590 --> 00:19:41,990
،كان هناك شيءٌ مشابه في غرفة أبيكِ
لكنّي لم أستطع قراءته

310
00:19:42,230 --> 00:19:44,120
لكن كانت التي في القبو مُختلفة

311
00:19:44,120 --> 00:19:45,780
أعتقد أنّها كانت كلمات حقيقيّة

312
00:19:46,120 --> 00:19:49,000
"رأيتُ كلمة "عملاق

313
00:19:49,350 --> 00:19:50,320
عملاق؟

314
00:19:51,230 --> 00:19:52,670
شجرة القمّة المداريّة العملاقة؟

315
00:19:52,670 --> 00:19:56,710
أجل، لا بدّ أنّ ما هو مكتوب كان
!"شجرة القمّة المداريّة العملاقة"

316
00:19:56,710 --> 00:20:02,510
لكن لمَ توجد كلمات مكتوبة
من الظلّة في قبو القلعة؟

317
00:20:02,510 --> 00:20:04,220
أعتقد أنّها خريطة

318
00:20:04,570 --> 00:20:08,100
كانت هناك علامات مُشابهة
للتي استعملتُها في قريتي

319
00:20:08,470 --> 00:20:11,100
أتعتقدين أنّهم سيصدّقوننا بهذه؟

320
00:20:11,750 --> 00:20:15,990
...كلمات مكتوبة، خريطة
لم يعد محض كلام منّا

321
00:20:16,360 --> 00:20:21,150
سيثق أبي بالتأكيد بآثار القلعة التاريخيّة

322
00:20:21,150 --> 00:20:23,340
!هيّا بنا! لنذهب لجلب الخريطة

323
00:20:28,780 --> 00:20:29,630
ماذا؟

324
00:20:32,490 --> 00:20:33,320
!مؤلم

325
00:20:34,070 --> 00:20:35,020
!انتظري

326
00:20:58,550 --> 00:21:03,780
شُوهِد قارب صغير متوجّه
إلى آطلاند بالأمس

327
00:21:03,780 --> 00:21:07,190
نرجّح أنّه كان يحمل الأميرة وفرسانها

328
00:21:09,240 --> 00:21:10,570
لا بأس

329
00:21:11,200 --> 00:21:18,010
،حتّى لو رجعوا إلى آطلاند
لا يزال الموت بانتظارهم