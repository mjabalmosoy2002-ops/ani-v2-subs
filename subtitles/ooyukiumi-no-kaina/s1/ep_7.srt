1
00:00:05,590 --> 00:00:08,440
!أنزلوها! حسناً، التالية

2
00:00:08,440 --> 00:00:10,110
!لا يزال لدينا المزيد

3
00:00:10,990 --> 00:00:12,850
!اعملوا أسرع

4
00:00:15,110 --> 00:00:18,210
...هذه فالغيا إذاً

5
00:00:18,870 --> 00:00:20,970
!فلتمسك به بإحكام

6
00:00:21,280 --> 00:00:23,330
سنقع في مشكلةٍ كبيرة
!إن انسكب منّا شيء

7
00:00:25,580 --> 00:00:26,570
هناك

8
00:00:28,110 --> 00:00:29,460
الفرصة سانحةٌ لنا الآن للهرب

9
00:00:29,460 --> 00:00:30,230
أجل

10
00:00:32,440 --> 00:00:33,670
كاينا؟

11
00:00:35,090 --> 00:00:36,580
!هيّا يا كاينا

12
00:00:37,080 --> 00:00:38,190
أ-أجل

13
00:00:38,190 --> 00:00:40,540
!حسناً! لننتقل للتالية

14
00:00:44,730 --> 00:00:47,020
...المكان دافئٌ هنا، لكن

15
00:00:47,020 --> 00:00:48,400
رائحته نتنة

16
00:00:48,660 --> 00:00:51,730
علينا إيجاد خطّةٍ للهرب أوّلاً

17
00:00:52,380 --> 00:00:53,330
...كما نحتاج

18
00:00:55,190 --> 00:00:57,070
الطعام، صحيح؟

19
00:00:58,090 --> 00:01:00,020
!انظر للمقدار الذي سكبته

20
00:01:00,020 --> 00:01:02,050
!كان ذلك آخر ما تبقّى لنا من ماء

21
00:01:16,770 --> 00:01:19,940
أهذه... فالغيا؟

22
00:01:20,540 --> 00:01:21,930
إنّها كبيرة

23
00:01:23,270 --> 00:01:26,440
لكنّ هذه القلعة مبهرةٌ من الخارج فحسب

24
00:01:27,400 --> 00:01:29,400
...ماذا؟ أولئك

25
00:01:30,660 --> 00:01:31,660
ما الذي يجري؟

26
00:01:33,480 --> 00:01:36,650
لا تتعبوا أنفسكم بالاصطفاف إذا
!لم تمتلكوا ختم حصّة

27
00:01:37,090 --> 00:01:39,700
الماء ثمينٌ على أن نعطيه
!لمن لا يعملون

28
00:01:40,250 --> 00:01:43,450
أرجوكم، أعطوني رشفةً صغيرة فحسب

29
00:01:44,750 --> 00:01:45,750
!ارحل

30
00:01:49,190 --> 00:01:52,910
يبدو أنّ الماء ثمينٌ في فالغيا أيضاً

31
00:01:53,880 --> 00:01:56,640
حسناً، انتهينا لليوم

32
00:01:56,640 --> 00:01:57,800
!فلتنصرفوا

33
00:01:57,800 --> 00:01:59,300
متى الحصّة التالية؟

34
00:01:59,300 --> 00:02:01,340
!سنموت على هذا النحو

35
00:02:01,340 --> 00:02:03,570
!اسمعوا، عليكم الصمود لفترةٍ قصيرة وحسب

36
00:02:03,570 --> 00:02:06,500
!بعدما نهزم آطلاند، سنحصل على الماء

37
00:02:07,750 --> 00:02:08,770
!مرحى

38
00:02:08,770 --> 00:02:09,850
!صحيح

39
00:02:09,850 --> 00:02:12,080
!اهزموا آطلاند

40
00:02:12,080 --> 00:02:13,070
!علينا الحصول على المزيد من الماء

41
00:02:13,070 --> 00:02:14,700
!لا تسمحوا لهم باستحكاره

42
00:03:53,730 --> 00:03:56,040
سيكون من الصعب سرقة سفينة

43
00:03:57,550 --> 00:04:00,440
علينا العودة لبلادنا قبل بدء القتال

44
00:04:00,750 --> 00:04:03,880
ربما لا مانع لهذه الحرب الآن

45
00:04:04,570 --> 00:04:07,090
لنبحث في المدينة من جديد

46
00:04:07,800 --> 00:04:08,700
أصبت

47
00:04:09,350 --> 00:04:10,890
سنبرز هكذا

48
00:04:10,890 --> 00:04:12,050
لنخفي أغراضنا

49
00:04:12,050 --> 00:04:13,030
أجل

50
00:04:13,030 --> 00:04:15,020
أشعر ببعض الحرّ بدوري

51
00:04:18,110 --> 00:04:19,170
كاينا

52
00:04:19,170 --> 00:04:19,770
أجل

53
00:04:19,770 --> 00:04:21,490
أين علينا إخفاؤها؟

54
00:04:22,680 --> 00:04:23,830
ما الخطب؟

55
00:04:24,420 --> 00:04:25,410
انقطعت

56
00:04:25,410 --> 00:04:26,130
ماذا؟

57
00:04:40,220 --> 00:04:41,930
!كاينا، ياونا، الحقا بأولئك

58
00:04:41,930 --> 00:04:42,540
!حسناً

59
00:04:49,310 --> 00:04:50,750
!توقّفي

60
00:04:59,420 --> 00:05:00,170
!انتظر

61
00:05:07,300 --> 00:05:08,850
!توقّفي! أرجوك

62
00:05:24,700 --> 00:05:25,550
!انتظري

63
00:05:38,460 --> 00:05:39,650
!لمَ فعلت ذلك؟

64
00:05:39,650 --> 00:05:41,440
!أأنتما مع أولئك الأطفال؟

65
00:05:42,290 --> 00:05:45,940
أنتم الوافدون الجدد الذين جلبوهم
على متن القارب اليوم، صحيح؟

66
00:05:46,810 --> 00:05:49,340
لم يسبق وأن رأيتُ ثياباً غريبة كهذه

67
00:05:49,340 --> 00:05:51,700
ماذا؟ أ-أجل

68
00:05:51,700 --> 00:05:55,700
حريٌّ بكم الاستسلام، لن ينفعكم اللطف هنا

69
00:05:55,700 --> 00:05:58,460
الجميع يكافحون للعيش

70
00:06:00,510 --> 00:06:01,610
...تمهّل

71
00:06:10,810 --> 00:06:13,310
!لا يمكنكِ الدخول هكذا وحسب

72
00:06:13,560 --> 00:06:17,110
أريد حصّة ماءٍ فحسب

73
00:06:17,110 --> 00:06:20,850
لن تنالي معاملةً خاصّة لأنّكِ
طفلة فحسب، ارحلي

74
00:06:20,850 --> 00:06:22,980
لا تكن بهذه البرودة

75
00:06:22,980 --> 00:06:25,570
!جلبتُ ختم حصّةٍ مميّز لك

76
00:06:25,570 --> 00:06:26,240
ماذا؟

77
00:06:26,940 --> 00:06:28,430
!مُفاجأة

78
00:06:35,870 --> 00:06:39,100
أليس ساحراً؟ إنّه فريدٌ من نوعه

79
00:06:39,100 --> 00:06:42,060
ما رأيك؟ ألا ترى أنّه
ختم حصّةٍ مميّز؟

80
00:06:46,380 --> 00:06:47,630
ما رأيكم؟

81
00:06:47,630 --> 00:06:50,760
أليس ساحراً؟ إنّه فريدٌ من نوعه

82
00:06:50,760 --> 00:06:53,810
أنا متأكّدٌ أنّ الرؤساء سيدركون
!روعة شيءٍ كهذا

83
00:07:01,730 --> 00:07:03,110
ما الذي معك؟

84
00:07:04,400 --> 00:07:05,900
!إ-إنّه لي

85
00:07:06,600 --> 00:07:10,110
هذه الحلية مصنوعة
من أصداف في آطلاند

86
00:07:10,110 --> 00:07:11,600
أين حصلت عليها؟

87
00:07:12,570 --> 00:07:14,620
تكلّم بصراحة، ولن تنال عقوبة

88
00:07:16,220 --> 00:07:18,280
!جلبتها طفلةٌ من الأحياء الفقيرة

89
00:07:18,280 --> 00:07:21,050
فلتجلبها لي فوراً إذاً

90
00:07:21,050 --> 00:07:22,040
...ماذا؟ أنا

91
00:07:22,040 --> 00:07:23,040
!قلتُ فوراً

92
00:07:23,040 --> 00:07:23,500
!أمرك

93
00:07:28,110 --> 00:07:31,190
سيتعيّن عليّ إعلام الأميرال

94
00:07:34,310 --> 00:07:37,140
أهذه أداة صيد أو ما شابه؟

95
00:07:38,970 --> 00:07:40,350
!نوزي، أسمعت؟

96
00:07:41,780 --> 00:07:43,310
لا تنسَ طقسنا

97
00:07:43,310 --> 00:07:45,140
حـ-حسناً

98
00:07:46,930 --> 00:07:48,110
ما الذي حصل؟

99
00:07:48,110 --> 00:07:51,250
يبدو أنّ أميرة آطلاند تسلّلت للمدينة

100
00:07:51,250 --> 00:07:52,970
أميرة آطلاند؟

101
00:07:52,970 --> 00:07:55,200
سيقومون بإعدامها الآن

102
00:07:55,200 --> 00:07:57,490
لنذهب لرؤية كيف تبدو

103
00:08:00,970 --> 00:08:02,110
ربما ذلك

104
00:08:04,730 --> 00:08:07,380
هذا مكانٌ مريعٌ حقّاً

105
00:08:07,620 --> 00:08:09,160
وأنا أتضوّر جوعاً

106
00:08:11,870 --> 00:08:15,620
،إعدام أميرة عدوّنا، بلاد آطلاند
!على وشك البدء

107
00:08:16,350 --> 00:08:20,770
!احتشدوا جميعاً

108
00:08:21,340 --> 00:08:23,490
سيعدمون أميرة آطلاند؟

109
00:08:23,490 --> 00:08:24,480
كيف تبدو يا ترى؟

110
00:08:24,850 --> 00:08:27,230
لمَ هي في فالغيا؟

111
00:08:54,650 --> 00:08:56,050
ما الذي يجري؟

112
00:08:56,050 --> 00:08:57,730
أختي هنا

113
00:08:59,620 --> 00:09:01,060
...تلك القلادة

114
00:09:02,310 --> 00:09:03,370
...إنّها

115
00:09:04,120 --> 00:09:05,570
...ماذا؟ أليست تلك

116
00:09:05,570 --> 00:09:06,810
!تشيرو

117
00:09:06,810 --> 00:09:08,310
كيف علقت في هذا؟

118
00:09:09,820 --> 00:09:11,300
!أنت ذاك الشاب

119
00:09:11,300 --> 00:09:12,180
!تبّاً

120
00:09:12,840 --> 00:09:14,070
!مهلاً، أنت

121
00:09:15,220 --> 00:09:17,280
!يا شعب فالغيا

122
00:09:20,030 --> 00:09:23,740
!من أمامكم هي ريريها، أميرة آطلاند

123
00:09:23,740 --> 00:09:25,500
!كلّا

124
00:09:25,990 --> 00:09:31,080
!في غضون بضعة أيّام، سنهزم آطلاند

125
00:09:31,590 --> 00:09:36,930
!لكن قبل ذلك، سنُعدم الأميرة المأسورة

126
00:09:40,960 --> 00:09:41,850
!اخرسي

127
00:09:43,430 --> 00:09:45,860
كيف اختلط عليهم أنّها أختي؟

128
00:09:45,860 --> 00:09:47,810
ماذا؟ ما الذي قلته؟

129
00:09:47,810 --> 00:09:48,920
!ما الذي قلته للتوّ؟

130
00:09:50,020 --> 00:09:51,640
...أيمكن أنّكِ

131
00:09:55,740 --> 00:10:02,120
ألا ترين أنّ هذه أفضل طريقة
لاستدراج حشرةٍ مُختبئة؟

132
00:10:02,590 --> 00:10:05,580
أنتِ! إنّكِ أميرة آطلاند، صحيح؟

133
00:10:06,010 --> 00:10:08,760
!لمَ ستُعدم تشيرو مكانكِ؟

134
00:10:08,760 --> 00:10:11,170
!لأنّ تلك الفتاة سرقة شيئاً من أختي

135
00:10:11,170 --> 00:10:15,670
كلّا، إنّهم يستعملونها كطعمٍ لاستدراجي

136
00:10:15,940 --> 00:10:16,630
ماذا؟

137
00:10:17,570 --> 00:10:21,300
.لا يمكننا الكشف عن أنفسنا إذاً
...أنا آسفٌ بشأن الفتاة، لكن

138
00:10:21,300 --> 00:10:22,790
...أيّها الـ

139
00:10:32,820 --> 00:10:35,580
لا يهمّ، ما المعنى؟

140
00:10:36,050 --> 00:10:39,450
يحاول الجميع هنا إطالة
نجاتهم ليومٍ إضافيّ فحسب

141
00:10:57,810 --> 00:10:58,660
كاينا

142
00:10:59,190 --> 00:10:59,930
أجل

143
00:11:02,650 --> 00:11:04,220
!ماذا؟ أختي

144
00:11:09,410 --> 00:11:10,980
!يا شعب فالغيا

145
00:11:15,330 --> 00:11:17,010
!أطلقوا سراح الفتاة

146
00:11:25,690 --> 00:11:29,830
!أنا أميرة آطلاند، ريريها

147
00:11:35,990 --> 00:11:39,340
!تلك الفتاة ليست من آطلاند

148
00:11:39,700 --> 00:11:43,680
،إن أعدمتم فتاةً بريئة بشبهة كونها الأميرة

149
00:11:43,680 --> 00:11:47,890
!فسيتردّد صدى فشل فالغيا في أرجاء البحر الثلجيّ

150
00:12:12,420 --> 00:12:13,940
أنت، أطلق سراحها

151
00:12:13,940 --> 00:12:14,460
!أمرك

152
00:12:25,050 --> 00:12:27,480
أهي أميرة آطلاند الحقيقيّة؟

153
00:12:27,480 --> 00:12:30,550
أظهرت نفسها كي تُقتل وحسب؟

154
00:12:31,470 --> 00:12:33,660
!سأذهب لجلب تشيرو

155
00:12:33,660 --> 00:12:37,600
أعتذر على عجزنا عن مساعدتكم بعدما أنقذتموها

156
00:12:37,600 --> 00:12:41,340
لسنا بأندادٍ لدرع فالغيا الأسود أبداً

157
00:12:41,890 --> 00:12:44,610
درع فالغيا الأسود؟

158
00:12:44,610 --> 00:12:50,740
صحيح، لا أحد في أرجاء البحر الثلجيّ بأسره
يستطيع هزيمة آميلوثي في مُبارزة سيف

159
00:12:54,150 --> 00:12:56,840
أخبرتكِ أنّ الأفعال النبيلة ستقودكِ لمقتلكِ

160
00:12:56,840 --> 00:13:01,380
صحيح، لكنّها ليست شيئاً
أستطيع تغيير بسهولة

161
00:13:02,550 --> 00:13:07,260
قد يكون ذلك. اطمئنّي، لا أملك نيّةً بقتلكِ

162
00:13:07,260 --> 00:13:08,200
ماذا؟

163
00:13:08,690 --> 00:13:10,140
،إن أردتِ إنقاذ شعبكِ

164
00:13:10,430 --> 00:13:13,600
فتخلّي عن مقامكِ العائليّ
وعيشي كجنديّة لـ فالغيا

165
00:13:16,330 --> 00:13:18,770
مثلكِ؟

166
00:13:20,020 --> 00:13:21,000
!أختي

167
00:13:21,000 --> 00:13:21,850
!ياونا

168
00:13:22,340 --> 00:13:23,190
تمهّل

169
00:13:26,850 --> 00:13:30,600
عليكِ شغل نفسكِ بسلامتك
بدل التفكير في أمري

170
00:13:32,150 --> 00:13:33,040
احمل هذه

171
00:13:33,040 --> 00:13:34,500
!ماذا؟ ا-انتظر

172
00:13:34,940 --> 00:13:38,660
أنا أهوى التهوّر بطبعي

173
00:13:45,630 --> 00:13:46,610
!ماذا؟

174
00:14:08,030 --> 00:14:12,450
عجباً... لا يمكن الاستهانة بها حقّاً

175
00:14:13,800 --> 00:14:14,750
!ا-الحقوا بها

176
00:14:14,750 --> 00:14:15,250
!أمرك

177
00:14:15,610 --> 00:14:17,410
!لديها رفاقٌ مختبئون

178
00:14:17,410 --> 00:14:19,830
!فتّشوا الأطباق السفليّة واعثروا عليهم

179
00:14:40,950 --> 00:14:42,670
!هربوا للأطباق السفليّة

180
00:14:42,670 --> 00:14:43,900
!اعثروا عليهم

181
00:14:45,050 --> 00:14:47,070
!نوزي، إنّنا في مشكلة

182
00:15:03,830 --> 00:15:07,050
شكراً لك يا كاينا، أنقذت حياتي من جديد

183
00:15:09,900 --> 00:15:11,590
!أين ذهبوا؟

184
00:15:11,590 --> 00:15:13,730
!لا يفتكم حتّى ذباب قمَص

185
00:15:13,730 --> 00:15:15,590
!بسرعة، اتبعوني

186
00:15:23,390 --> 00:15:25,020
هيّا، ادخلوا

187
00:15:26,900 --> 00:15:28,180
!أخي

188
00:15:28,180 --> 00:15:30,990
تشيرو! حمداً لله على كونكِ بخير

189
00:15:33,290 --> 00:15:35,620
المعذرة... شكراً لكِ

190
00:15:36,970 --> 00:15:38,330
أأنتِ بخير؟

191
00:15:38,330 --> 00:15:39,240
!أجل

192
00:15:41,550 --> 00:15:44,420
المعذرة... أين نحن؟

193
00:15:50,660 --> 00:15:53,020
هذا منزلنا، مخبأ أخويّة الجمجمة

194
00:15:53,020 --> 00:15:55,620
!من الخطر أن نبقيهم هنا

195
00:15:55,620 --> 00:15:57,260
ندين لهم، لا يمكننا تركهم وحسب

196
00:15:57,260 --> 00:15:59,330
أقدّر ما فعلتموه حقّاً

197
00:15:59,330 --> 00:16:01,520
أنا نوزي، وهذه تشيرو

198
00:16:01,520 --> 00:16:05,060
أنا ريريها، وهذا أخي ياونا

199
00:16:05,060 --> 00:16:06,690
أنا كاينا

200
00:16:07,570 --> 00:16:09,860
ربما علينا إعادة ما سرقناه

201
00:16:09,860 --> 00:16:11,570
هذه أيضاً

202
00:16:13,270 --> 00:16:17,330
إذاً، ما الذي جلب أميرة آطلاند إلى فالغيا؟

203
00:16:23,470 --> 00:16:26,250
فلتجلب لهم طعاماً

204
00:16:37,870 --> 00:16:40,650
!هل رأى أيّ أحد شخصاً مثيراً للشبهة؟

205
00:16:41,500 --> 00:16:45,420
!سنعطي ماءً لكلّ من يقدّم لنا معلومات

206
00:16:47,250 --> 00:16:51,460
الأمر سيّئ! المكان يعجّ بالجنود
!الذين يبحثون عنهم في الأعلى

207
00:16:51,460 --> 00:16:54,450
هدفهم التالي هي آطلاند، فلا عجب

208
00:16:54,740 --> 00:16:57,070
لذا علينا إيجاد سبيلٍ للعودة بشكلٍ ما

209
00:16:57,070 --> 00:17:01,660
حتّى لو رجعتم، سرعان ما ستدخلون
في الحرب، وستخسر آطلاند

210
00:17:02,000 --> 00:17:03,460
!لن تخسر آطلاند

211
00:17:03,460 --> 00:17:04,440
ماذا؟

212
00:17:06,770 --> 00:17:08,710
أتعتقدون أنّ بمقدوركم هزيمة فالغيا حقّاً؟

213
00:17:11,220 --> 00:17:15,880
،من الصحيح أنّ أسطول فالغيا مُبهر
لكنّ هذه القلعة محض استعراض

214
00:17:16,590 --> 00:17:19,180
يبدو أنّهم لا يعلمون

215
00:17:19,180 --> 00:17:19,970
نعلم ماذا؟

216
00:17:19,970 --> 00:17:24,020
هنالك شيءٌ أكثر إخافة
من القلعة أو الأسطول

217
00:17:24,320 --> 00:17:25,950
ما هو؟

218
00:17:25,950 --> 00:17:27,140
الأميرال

219
00:17:27,140 --> 00:17:27,770
ماذا؟

220
00:17:28,010 --> 00:17:30,480
للأميرال وحش أليف

221
00:17:30,480 --> 00:17:31,550
وحش؟

222
00:17:31,550 --> 00:17:36,010
أجل، لا أحد يستطيع هزيمة ذاك
الوحش، ولا حتّى آميلوثي

223
00:17:36,010 --> 00:17:38,450
سقطت بلادنا بسبب ذاك الوحش أيضاً

224
00:17:38,690 --> 00:17:39,240
ماذا؟

225
00:17:39,240 --> 00:17:40,930
لم تُولدوا هنا؟

226
00:17:40,930 --> 00:17:42,530
اُختطفنا

227
00:17:42,530 --> 00:17:45,580
تضمّ فالغيا النُجاة من البلدان
التي قامت بتدميرها

228
00:17:45,580 --> 00:17:47,760
هكذا يعيدون تعويض الجنود والبحّارين

229
00:17:47,760 --> 00:17:49,810
ينطبق ذلك على الجميع، حتّى على الأطفال

230
00:17:49,810 --> 00:17:52,370
إنّه حُكم جدارة

231
00:17:52,370 --> 00:17:55,090
يمكن لجنود الأعداء السابقين الارتقاء
بمراتبهم إن كانوا أقوياء

232
00:17:55,310 --> 00:17:59,480
يُختار نخبة الأطفال ليتمّ تمرينهم أيضاً

233
00:18:01,810 --> 00:18:04,600
ثيابك أنت غريبةٌ حقّاً

234
00:18:04,930 --> 00:18:07,320
ماذا؟ تظنّ ذلك؟

235
00:18:07,320 --> 00:18:08,980
إنّه من الظلّة

236
00:18:10,220 --> 00:18:14,280
الظلّة؟ أي التي في السماء؟

237
00:18:14,280 --> 00:18:15,580
أجل

238
00:18:15,580 --> 00:18:19,410
ذهبت أختي إلى الظلّة للقاء
الحكيم لإنقاذ الجميع

239
00:18:22,690 --> 00:18:25,530
احكوا لي المزيد عن هذا

240
00:18:26,270 --> 00:18:27,980
!أنت! أتعرف شيئاً؟

241
00:18:27,980 --> 00:18:30,900
!لا-لا تؤذوني رجاءً! لا بدّ أنّهم مع أولئك

242
00:18:30,900 --> 00:18:31,710
ماذا؟

243
00:18:31,710 --> 00:18:33,920
!أقصد الأطفال، مجموعة اللصوص

244
00:18:33,920 --> 00:18:35,500
مجموعة اللصوص؟

245
00:18:42,380 --> 00:18:45,270
وذلك كلّ ما أعرفه

246
00:18:45,750 --> 00:18:48,680
كاينا، أنت من الظلّة حقّاً

247
00:18:48,680 --> 00:18:53,310
لكنّ الحكيم محض قصّة خياليّة
من مخيّلة شخص يلتمس الأمل

248
00:18:54,650 --> 00:18:57,940
حكت لي جدّتي قصصاً
عن شجرة قمّة عملاقة

249
00:18:57,940 --> 00:19:03,070
عملاقة بما يكفي لإطعام العالم بأسره

250
00:19:03,070 --> 00:19:04,740
شجرة قمّة عملاقة؟

251
00:19:04,740 --> 00:19:07,250
قالت أنّها أكبر بأضعاف
من شجرة القمّة العاديّة

252
00:19:07,250 --> 00:19:09,080
ألن يكون ذلك رائعاً؟

253
00:19:19,990 --> 00:19:21,970
توجد شجرة قمّة عملاقة

254
00:19:22,190 --> 00:19:23,150
ماذا؟

255
00:19:23,490 --> 00:19:24,550
حقّاً؟

256
00:19:24,860 --> 00:19:28,630
كنّا نرى شجرة القمّة العملاقة
تلك من على الظلّة

257
00:19:28,630 --> 00:19:29,930
!مُستحيل

258
00:19:29,930 --> 00:19:32,940
إن كانت تلك الشجرة حقيقيّة، فلن تشنّ
!فالغيا حروباً كهذه

259
00:19:32,940 --> 00:19:33,890
ماذا؟

260
00:19:34,300 --> 00:19:35,270
ما قصدك؟

261
00:19:35,490 --> 00:19:39,970
أصبحت فالغيا على هذا الحال بسبب
!جفاف الأشجار المداريّة حول البحر

262
00:19:39,970 --> 00:19:43,630
طافت السفينة بدايةً لإنقاذ الناس
،عندما جفّت الأشجار المداريّة

263
00:19:43,630 --> 00:19:45,620
!لكن تضاعف التعداد السكنيّ، وها نحن اليوم

264
00:19:48,290 --> 00:19:51,300
،لو كنّا نملك ماءً يكفي الجميع
ما كنّا لنعيش هكذا

265
00:19:52,230 --> 00:19:55,500
أتوجد شجرة قمّة عملاقة كتلك حقّاً؟

266
00:19:56,010 --> 00:19:56,920
أجل

267
00:19:58,730 --> 00:20:02,630
...إذاً إذا لم تجفّ شجرة القمّة تلك بعد

268
00:20:02,630 --> 00:20:05,850
،يمكنك رؤية النور من الأصداف المُضيئة
لذا لم تجفّ بعد

269
00:20:09,660 --> 00:20:10,850
أخبريني

270
00:20:11,090 --> 00:20:13,300
هل سيكون مذاق ذاك الماء لذيذاً؟

271
00:20:13,300 --> 00:20:15,690
ماذا؟ ما قصدك؟

272
00:20:15,690 --> 00:20:20,290
الماء الذي يوزّعونه علينا
ليس طيّب المذاق أبداً

273
00:20:20,290 --> 00:20:23,820
نعيش من السوائل المُستخرجة
من الجِياد الثلجيّة والحشرات

274
00:20:40,770 --> 00:20:42,410
!أنت، تعال هنا قليلاً

275
00:20:44,380 --> 00:20:45,850
لكنّها بعيدة، صحيح؟

276
00:20:45,850 --> 00:20:50,140
...أجل، كان من المستحيل الوصول لها مشياً، لكن

277
00:20:51,230 --> 00:20:52,680
يمكننا الذهاب بسفينة

278
00:20:52,680 --> 00:20:53,730
أجل

279
00:20:53,970 --> 00:20:58,770
ذلك رائع، لكن لن يصدّقكم أحد دون دليل

280
00:20:59,050 --> 00:21:01,110
...دليل

281
00:21:04,620 --> 00:21:05,860
!إنّه ممرّ مخفيّ

282
00:21:05,860 --> 00:21:08,040
!تبّاً له! سأحطّمه

283
00:21:13,650 --> 00:21:17,530
!إنّها مشكلة! الجنود متوجّهون إلينا