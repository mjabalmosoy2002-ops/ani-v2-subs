1
00:00:01,450 --> 00:00:06,570
.هذه قصّة أخ وأخت يديران محلّ تأجير

2
00:00:07,440 --> 00:00:12,520
،رغم أنّهما يسمّيان نفسيهما أخًا وأختًا
.إلاّ أنّهما لا يقربان بعضهما

3
00:00:13,550 --> 00:00:19,330
كانت الأخت الكبرى أوكو الابنة الوحيدة
.لمالك محلّ أغراض مستعملة في نيهونباشي

4
00:00:21,470 --> 00:00:24,170
ولكن بسبب الحريق الكبير الّذي
،حدث قبل عدّة سنوات

5
00:00:24,170 --> 00:00:28,600
فقدت أوكو والدها واستقبلها عمّها عنده

6
00:00:28,600 --> 00:00:34,070
وحينها أصبح سيجي، الّذي كان
.ابن عمّها بالتّبنّي، أخاها الأصغر

7
00:00:36,110 --> 00:00:40,060
.هذان الشّقيقان الغريبان مثيران للاهتمام

8
00:00:40,670 --> 00:00:42,570
ولماذا؟

9
00:00:42,570 --> 00:00:46,540
.حسنًا، يبدو أنّ سيجي مغرم بأوكو

10
00:00:48,400 --> 00:00:51,380
.إنّ سيجي ليس رجلاً سيّئًا

11
00:00:51,380 --> 00:00:55,980
لكنّه مفكّر بارع وهو صادق
.ومراعٍ كثيرًا للآخرين

12
00:00:55,980 --> 00:00:59,480
،لكنّه لا يتحلّى بالكثير من الشّجاعة

13
00:00:59,480 --> 00:01:02,080
.لم يفصح بعد عن مشاعره نحو أوكو

14
00:01:02,500 --> 00:01:04,820
.هذا سيّئ

15
00:01:05,460 --> 00:01:08,210
.السّبب وراء ذلك راجع لشيء حدث في ماضيهما

16
00:01:08,580 --> 00:01:12,770
،بينما كانت أوكو لا تزال في نيهونباشي
،تعرّفت على السّيّد الصّغير لمحلّ كبير

17
00:01:12,770 --> 00:01:15,010
.وهذا الرّجل يُدعى ساتارو

18
00:01:15,010 --> 00:01:20,220
،رغم أنّه كان مخطوبًا سلفًا
.إلاّ أنّ ساتارو قد وقع في حبّ أوكو

19
00:01:20,590 --> 00:01:22,720
.في أحد الأيّام، حدث أمر ما

20
00:01:22,720 --> 00:01:29,800
اختفت مبخرة قيّمة للغاية تُدعى
.سوو أهدتها خطيبة ساتارو إليه

21
00:01:30,220 --> 00:01:37,230
دارت الشّبهات حول ساتارو من قِبل عائلة
.خطيبته بأنّه باع سوو ليهرب برفقة أوكو

22
00:01:37,670 --> 00:01:41,230
.ولكنّ ساتارو أقسم أنّ لا علم له بالأمر

23
00:01:41,230 --> 00:01:44,740
لكن لسوء الحظّ، كان ذلك سببًا
،في رحيله عن نيهونباشي

24
00:01:44,740 --> 00:01:47,240
.واختفى من إيدو بعد ذلك

25
00:01:47,600 --> 00:01:52,240
.واصلت أوكو البحث عن سوو منذ اختفائها

26
00:01:52,800 --> 00:01:58,680
ربّما كانت رؤية أوكو على هذه الحال
.هو سبب اعتقاد سيجي أنّها تنتظر ساتارو

27
00:01:59,250 --> 00:02:02,260
،المعذرة... آسف على المقاطعة

28
00:02:03,090 --> 00:02:07,420
لكن أيعقل أنّك تتحدّث
عن ساتارو-سان من إييدا-يا

29
00:02:07,420 --> 00:02:10,020
في نيهونباشي وأوكو-سان من كوداما-يا؟

30
00:02:10,380 --> 00:02:13,010
نعم، أنا كذلك. فمن أنت؟

31
00:02:13,010 --> 00:02:17,520
.اسمي أوكون، وأنا تسوكوموغامي نيتسوكي

32
00:02:18,150 --> 00:02:21,530
هل تعرف بشأن ساتارو وأوكو؟

33
00:02:21,530 --> 00:02:27,540
أعرف الكثير، لقد كان مالكي السّابق
.هو ساتارو-سان بنفسه

34
00:04:03,610 --> 00:04:06,480
كانت ساناي-ساما على علاقة برجل آخر؟

35
00:04:06,480 --> 00:04:07,560
.نعم

36
00:04:07,560 --> 00:04:12,210
عندما ذهبت إلى منزل هاتشيا في أحد
،الأيّام بعد أن استدعاني حموّي

37
00:04:13,430 --> 00:04:19,060
كان الرّجل الّذي أحبّته قبل أن تتمّ
.خطبتي معها موجودًا هنا

38
00:04:19,370 --> 00:04:22,580
.طبعًا قد أكون مخطئًا

39
00:04:23,370 --> 00:04:27,070
لكن لا يمكنني حمل نفسي على
.سؤال ساناي بشأن الأمر

40
00:04:27,640 --> 00:04:30,130
!سيجي، ساعدني

41
00:04:41,570 --> 00:04:43,090
!هل فقدت عقلك؟

42
00:04:43,430 --> 00:04:47,200
!من المستحيل أن تفعل ساناي-ساما أمرًا كهذا

43
00:04:47,200 --> 00:04:50,610
لماذا الرّجال سريعون دائمًا
بالتّفكير في استنتاجات كهذه؟

44
00:04:51,100 --> 00:04:53,350
.لا تغضبي عليّ رجاءً يا أختي

45
00:04:53,840 --> 00:04:56,610
.لست أنا من يشّك في أمرها

46
00:04:57,030 --> 00:05:00,980
ما كانت هذه لتكون مشكلة إن وبّختَه
ببساطة كما كان يجب أن تفعل

47
00:05:00,980 --> 00:05:03,620
.واللّوم يقع على كاتسوسابورو-ساما أيضًا

48
00:05:04,150 --> 00:05:09,840
لا فكرة لديه أبدًا كم أصبحت
.ساناي-ساما تهتمّ لأمره

49
00:05:09,840 --> 00:05:11,650
ماذا ستفعلين يا أختي؟

50
00:05:12,790 --> 00:05:16,130
.سوف أريه أنا ما يستحقّه إن لم تفعل أنت

51
00:05:16,130 --> 00:05:18,080
!لا تفعلي رجاءً

52
00:05:21,810 --> 00:05:24,230
.يبدو أنّك تعاني وقتًا عصيبًا أيضًا يا سيجي-سان

53
00:05:24,690 --> 00:05:26,410
.أنا في ورطة بالفعل

54
00:05:26,980 --> 00:05:31,080
أودّ أن أسأل ساناي-ساما عن مشاعرها
،بما أنّ ذلك ما طُلب منّي

55
00:05:31,620 --> 00:05:34,930
لكنّ أختي سبق وقالت
.إنّها لن تسامحني إن فعلت

56
00:05:35,290 --> 00:05:39,100
ولا يمكنني أن أكذب على كاتسوسابورو-ساما
.لأريح باله فحسب أيضًا

57
00:05:40,110 --> 00:05:41,330
.بطني تؤلمني

58
00:05:41,680 --> 00:05:45,680
.أفهم قصدك. ربّما هنالك ما يمكنني فعله

59
00:05:46,300 --> 00:05:47,640
مثل ماذا؟

60
00:05:48,500 --> 00:05:53,830
أنا مدين لك لذهابك معي على
.القارب في النّهر للمرّة الثّانية

61
00:05:53,830 --> 00:05:55,700
.لم يكن الأمر مهمًّا لذلك الحدّ

62
00:05:56,070 --> 00:06:01,920
دعوتُ كونوسكي-سان وأوهانا-سان
.إلى حفلة شاي سأقيمها لاحقًا

63
00:06:02,550 --> 00:06:06,960
لماذا لا تأتي أنت أيضًا
وتدعو أولئك الاثنين معك؟

64
00:06:07,390 --> 00:06:09,730
كاتسوسابورو-ساما وساناي-ساما؟

65
00:06:10,330 --> 00:06:14,950
.سأترك التّرتيبات لك، لكي يحضر كلاهما

66
00:06:14,950 --> 00:06:15,970
.حسنًا

67
00:06:16,430 --> 00:06:21,860
على أيّ حال، هل أنت واثق من دعوتك
لكونوسكي-سان وأوهانا-سان؟

68
00:06:21,860 --> 00:06:23,600
.بالطّبع

69
00:06:23,600 --> 00:06:29,380
في الوقت الحاليّ، أقوم فقط بنصح
كونوسكي-سان بكيفية الاعتراف

70
00:06:29,380 --> 00:06:32,610
.بمشاعره نحو أوهانا-سان كرجل حقيقيّ

71
00:06:32,610 --> 00:06:34,310
.هذا مذهل

72
00:06:34,750 --> 00:06:38,130
إذًا فأنت تحاول الجمع بين
كونوسكي-سان وأوهانا-سان؟

73
00:06:38,850 --> 00:06:41,130
.نعم، وأنا أستمتع بذلك

74
00:06:41,830 --> 00:06:44,310
.أنت قويّ جدًّا يا هانسكي-سان

75
00:06:44,310 --> 00:06:45,380
ماذا؟

76
00:06:45,380 --> 00:06:48,120
.لا شيء. كنت أحدّث نفسي فحسب

77
00:06:55,300 --> 00:06:57,490
!ماذا؟

78
00:06:58,810 --> 00:07:00,930
ماذا يحدث يا أختي؟

79
00:07:00,930 --> 00:07:06,150
لقد أعاد إيزويا-سان تسوكويومي
.من شيناغاوا للتّوّ

80
00:07:06,520 --> 00:07:07,690
!أأنت جادّ؟

81
00:07:08,140 --> 00:07:12,150
قابلت تسوكوموغامي نيتسوكي
!كان يملكه ساتارو؟

82
00:07:12,150 --> 00:07:13,150
ماذا؟

83
00:07:14,740 --> 00:07:16,570
.ذلك صحيح تمامًا

84
00:07:16,570 --> 00:07:20,410
إذًا، إذًا، هل عرفت أيّ شيء جديد؟

85
00:07:20,410 --> 00:07:22,120
.بالطّبع

86
00:07:22,120 --> 00:07:26,140
يقال إنّ المرء لا يمكنه معرفة الحقيقة
،ما لم يذهب إلى شيناغاوا

87
00:07:26,140 --> 00:07:27,660
—وبالطّبع، كان عليّ المرور بعدّة صعاب

88
00:07:27,660 --> 00:07:30,680
سوف نحرص على الاستماع
.لأقوالك بحذر أكبر لاحقًا

89
00:07:30,680 --> 00:07:32,040
!أمّا الآن فأخبرنا بما جرى

90
00:07:32,590 --> 00:07:38,030
تسوكوموغامي نيتسوكي يُدعى أوكون
.هو من قال أنّ ساتارو كان مالكه

91
00:07:38,030 --> 00:07:41,430
حسب كلام أوكون، يبدو أنّ سبب
اتّخاذ ساتارو لقرار

92
00:07:41,430 --> 00:07:44,940
.مغادرة إيدو من تلقاء نفسه كان أوكو

93
00:07:44,940 --> 00:07:46,210
!ماذا؟

94
00:07:53,520 --> 00:07:56,200
ماذا في الصّندوق يا أوكو-سان؟

95
00:07:56,760 --> 00:08:00,580
.عد إلى إييدا-يا ومعك هذا الغرض

96
00:08:00,580 --> 00:08:05,700
لقد عثرنا على طريقة من أجلك
.لكي لا تغادر إيدو

97
00:08:10,360 --> 00:08:12,710
!ماذا؟ أليست هذه سوو؟

98
00:08:13,060 --> 00:08:15,130
.إنّها ليست سوو

99
00:08:15,130 --> 00:08:18,210
إنّها واحدة من ثلاث مبخرات صنعت في نفس الوقت

100
00:08:18,210 --> 00:08:22,100
.على يد رجل يُدعى نيشيون وتُدعى سانيو

101
00:08:22,720 --> 00:08:26,850
.هذا يعني أنّ سوو كانت مبخرة من أصل ثلاثة

102
00:08:27,310 --> 00:08:30,150
إنّها بنفس قيمة سوو إذًا، صحيح؟

103
00:08:30,150 --> 00:08:32,720
من أين حصلتم على المال لشرائها؟

104
00:08:33,130 --> 00:08:37,750
لقد تدبّرنا أمره بمساعدة من المشط
.الّذي أعطته والدتك لي

105
00:08:41,360 --> 00:08:46,870
هذا مذهل يا أوكو-سان. إذًا فقد جنيتِ
أرباحًا من المشط قبل كلّ شيء؟

106
00:08:46,870 --> 00:08:49,500
.كلاّ، كان من المستحيل فعل ذلك

107
00:08:49,500 --> 00:08:51,890
.لقد ساعدني سيجي بكلّ شيء

108
00:08:52,250 --> 00:08:53,310
ساعدك سيجي؟

109
00:08:55,970 --> 00:09:00,640
.أعطِ تلك المبخرة رجاءً إلى سوميوشيا-سان بدل سوو

110
00:09:00,640 --> 00:09:02,650
.لا يمكنني فعل ذلك

111
00:09:02,650 --> 00:09:06,790
سأكون بذلك أستعمل المال الّذي عملتما
.بجدّ لكسبه بأنانيّة

112
00:09:06,790 --> 00:09:10,150
.ما كانت أمّي لتسمح لي بذلك إن اكتشفت الأمر

113
00:09:10,520 --> 00:09:12,980
ما من سبب يدفعك لإخبارها بهذا، صحيح؟

114
00:09:13,980 --> 00:09:19,150
كلّ ما عليك قوله هو أنّني فشلت
.في جني أيّة أرباح وفقدت المشط

115
00:09:19,500 --> 00:09:24,150
.هذا يعني أنّ والدتي لن توافق عليك

116
00:09:24,850 --> 00:09:28,160
.إن كان هذا سيحلّ كلّ شيء، فهو الخيار الأنسب

117
00:09:28,160 --> 00:09:33,650
أختي، هذا يعني أنّك لن تتمكّني
...من أن تصبحي عروسه

118
00:09:37,030 --> 00:09:39,170
تلك هي إجابتك إذًا؟

119
00:09:45,300 --> 00:09:47,180
!ساتارو-سان، ماذا فعلت؟

120
00:09:48,430 --> 00:09:50,660
.اتّخذتُ قراري

121
00:09:50,660 --> 00:09:53,370
.سوف أترك إيدو

122
00:09:53,690 --> 00:09:55,880
!ما خطبك؟

123
00:09:55,880 --> 00:10:00,530
ما دامت هذه المبخرة موجودة، فسيكون
.هنالك مهرب آخر لي وستتزعزع عزيمتي

124
00:10:01,010 --> 00:10:02,330
.لذلك كسرتُها

125
00:10:02,700 --> 00:10:04,530
!لا تكن أنانيًّا

126
00:10:04,530 --> 00:10:06,330
!لقد عانت أختي من أجل تلك المبخرة

127
00:10:09,790 --> 00:10:11,700
.أنا آسف يا سيجي

128
00:10:12,970 --> 00:10:15,710
.أوكو-سان، سامحيني

129
00:10:20,000 --> 00:10:21,770
.هذا ليس وداعًا

130
00:10:21,770 --> 00:10:24,720
.أنوي العودة بمجرّد أن أصبح ناجحًا

131
00:10:25,120 --> 00:10:26,370
...ساتارو-سان

132
00:10:26,730 --> 00:10:30,370
.سأصبح رجلاً أفضل عندما أعود

133
00:10:30,370 --> 00:10:34,520
قد أكون قادرًا حتّى على جعلك
.تقعين في حبّي يا أوكو-سان

134
00:10:39,320 --> 00:10:42,230
هلاّ فكّرتِ في انتظاري لبعض الوقت؟

135
00:10:42,710 --> 00:10:44,840
.سأحاول أن أعود بأسرع ما يمكنني

136
00:10:59,760 --> 00:11:01,770
.أنا مندهش تمامًا

137
00:11:01,770 --> 00:11:05,050
كسر مبخرة قيمتها 80 ريو؟

138
00:11:05,050 --> 00:11:06,760
لماذا قد يفعل أمرًا كهذا؟

139
00:11:06,760 --> 00:11:09,770
.لأنّه شعر أنّ عزيمته تتزعزع

140
00:11:09,770 --> 00:11:13,260
لكن هل قال ساتارو تلك الأشياء بالفعل؟

141
00:11:20,540 --> 00:11:23,710
إذًا، إلى أين ذهب ساتارو؟

142
00:11:23,710 --> 00:11:27,750
،اتّجه ساتارو إلى منطقة كانساي
لكن يبدو أنّه باع ذلك التسوكوموغامي

143
00:11:27,750 --> 00:11:31,110
المدعوّ أوكون في شيناغاوا
.لتغطية نفقات سفره

144
00:11:31,110 --> 00:11:35,770
هذا يعني أنّ لا فكرة لدينا
إلى أين ذهب بعد شيناغاوا؟

145
00:12:22,960 --> 00:12:25,970
كونوسكي-سان، ليس عليك
.أن تكون متوتّرًا هكذا

146
00:12:32,720 --> 00:12:36,610
لكنّ هانسكي-سان رائع بالفعل، صحيح؟

147
00:12:37,070 --> 00:12:40,950
.إنّه رجل وسيم ويتصرّف بلطف
.إنّني أجده فاتنًا للغاية

148
00:12:41,360 --> 00:12:44,240
أنا واثق أنّ النّسوة اللاّتي حولك
.لا يدعنك وشأنك أيضًا

149
00:12:44,240 --> 00:12:45,540
.كلاّ

150
00:12:45,540 --> 00:12:49,450
تعلّمت درسي بالطّريقة الصّعبة
.عن طريق تجربة سابقة مؤلمة

151
00:12:49,450 --> 00:12:53,240
.أنا أتخصّص الآن في مراقبة الحبّ فحسب

152
00:12:54,240 --> 00:12:58,690
لكن قيل إنّ حسّك في التّجارة عبقريّ للغاية

153
00:12:58,690 --> 00:13:01,960
،وإن كانت لديك تجربة الفشل فوق ذلك

154
00:13:01,960 --> 00:13:05,470
فمن المؤكّد أنّ بإمكانك الكشف
.عن جوهر العلاقات بين الرّجال والنّساء

155
00:13:05,900 --> 00:13:08,420
،لا أعرف تمامًا بشأن جوهرها

156
00:13:08,420 --> 00:13:14,470
لكنّني أعرف طريقة مهمّة للغاية لإبقاء
.العلاقات بين الرّجال والنّساء من أن تفسد

157
00:13:14,470 --> 00:13:15,910
وكيف ذلك؟

158
00:13:15,910 --> 00:13:17,490
!أخبرنا رجاءً

159
00:13:18,490 --> 00:13:21,990
.كان هنالك زوجان عرفتُهما منذ مدّة طويلة

160
00:13:22,590 --> 00:13:25,570
.كان الزّوج رجلاً كريمًا مع الجميع

161
00:13:25,570 --> 00:13:28,980
.كان يخشى ألاّ يحبّه الآخرون

162
00:13:28,980 --> 00:13:31,990
وذات يوم، أعطته فتاة غيشا وقع الزّوج في حبّها

163
00:13:31,990 --> 00:13:35,620
.كيسيرو نفيسًا كان رمزًا لحبّهما

164
00:13:36,250 --> 00:13:40,520
.ثمّ عثرت الزّوجة على الكيسيرو الّذي يرمز لخيانته

165
00:13:40,520 --> 00:13:44,750
،لكن بدل لومها لزوجها

166
00:13:44,750 --> 00:13:47,780
أمست الزّوجة يائسة وقلقة للغاية
من إمكانية هرب الزوج مع عشيقته

167
00:13:47,780 --> 00:13:50,000
.وواصلت تظاهرها بجهلها للأمر برمّته

168
00:13:50,650 --> 00:13:54,750
.في تلك الأثناء، اختفى الكيسيرو من منزلهما

169
00:13:55,390 --> 00:13:58,310
.لامته الغيشا الّتي كان الزّوج يقابلها

170
00:13:58,310 --> 00:14:01,570
اتّهمته ببيعه خوفًا من اكتشاف زوجته للأمر

171
00:14:01,570 --> 00:14:03,660
.وأجبرت الزّوجة على اتّخاذ قرار ما

172
00:14:04,510 --> 00:14:09,320
إن اختار زوجته، فعليه أن يخبر
،زملاءه وأقرباءه بالعلاقة

173
00:14:09,320 --> 00:14:13,770
.لكن إن اختارها، فستُبقي السّرّ محفوظًا

174
00:14:14,300 --> 00:14:19,470
في النّهاية، وبهدف رغبته بعدم انتشار
،قصّة علاقته الغراميّة ووصولها لأقربائه

175
00:14:19,470 --> 00:14:23,190
انفصل الزّوج عن زوجته وتزوّج
.فتاة الغيشا في نهاية الأمر

176
00:14:23,190 --> 00:14:24,290
...يا إلهي

177
00:14:24,690 --> 00:14:29,810
،إنّها قصّة سخيفة بكلّ تأكيد
.لكن هنالك درس مهمّ نتعلّمه منها

178
00:14:30,360 --> 00:14:32,430
أتعرفين ما هو يا أوهانا-سان؟

179
00:14:32,430 --> 00:14:35,680
.إنّه عدم إخفاء الأمور

180
00:14:36,050 --> 00:14:38,450
،من المؤكّد أنّه ليس من الجيّد إخفاء الأمور

181
00:14:38,450 --> 00:14:42,680
لكنّ البشر لديهم في العادة ما
.يخفونه عن بعضهم

182
00:14:43,030 --> 00:14:44,690
.هذا صحيح

183
00:14:46,220 --> 00:14:49,760
.الدّرس المهمّ هو التزام الهدوء

184
00:14:50,380 --> 00:14:55,320
.فقدت الزّوجة هدوءها عندما عرفت بأمر الكيسيرو

185
00:14:55,690 --> 00:14:58,700
.وبالتّالي، تظاهرت  أنّها لم تره على الإطلاق

186
00:14:59,330 --> 00:15:03,290
.ولامت الزّوجة عشيقة زوجها وفقدت هدوءها

187
00:15:03,840 --> 00:15:07,720
.لذلك فكّرت في البداية على الحفاظ على المظاهر

188
00:15:08,150 --> 00:15:11,710
عندما ينزعج النّاس، يميلون إلى الهرب
.أوّلاً لحماية أنفسهم

189
00:15:11,710 --> 00:15:17,220
إن التزمنا الهدوء، فسنعرف ما المهمّ
.ولمن علينا أن نخبره أمورًا معيّنة

190
00:15:18,420 --> 00:15:23,790
،لكي يظلّ الرّجال والنّساء معًا لوقت طويل
.من الضّروريّ قول ما يجب قوله

191
00:15:23,790 --> 00:15:27,820
.لهذا السّبب من المهمّ جدًّا التزام الهدوء

192
00:15:28,230 --> 00:15:32,850
،وبالطّبع، قد لا يكون ذلك مقنعًا جدًّا
.بما أنّه صادر من أمثالي

193
00:15:36,560 --> 00:15:38,260
!أنت محقّ تمامًا

194
00:15:38,260 --> 00:15:42,890
بهدف الحفاظ على العلاقات بين الرّجال
.والنّساء، عليهم إخبار بعضهم بالأمور المهمّة

195
00:15:44,550 --> 00:15:45,730
!أوهانا-سان

196
00:15:45,730 --> 00:15:46,620
نعم؟

197
00:15:46,620 --> 00:15:49,220
...أنا... إنّني في الحقيقة

198
00:15:49,220 --> 00:15:52,150
.قد وقعتُ في حبّك منذ مدّة طويلة

199
00:15:53,100 --> 00:15:54,630
.أعلم ذلك

200
00:15:55,070 --> 00:15:57,990
،كونوسكي-سان، من المهمّ إخبار بعضنا بأشياء مهمّة

201
00:15:57,990 --> 00:16:00,150
.لكن عليك أن تعير المكان والزّمان بعض الاهتمام

202
00:16:00,150 --> 00:16:02,400
...نعم، حسنًا

203
00:16:06,290 --> 00:16:12,650
بالمناسبة، أين انتهى المطاف بالكيسيرو
الّذي ذُكر في القصّة الأخيرة؟

204
00:16:12,650 --> 00:16:15,150
،سمعتُ بهذا الجزء من القصّة فحسب

205
00:16:15,600 --> 00:16:20,960
لكنّ العشيقة الغيشا دُعيَتْ إلى غرفة
،الزّوج بينما كانت الزّوجة غير موجودة

206
00:16:20,960 --> 00:16:26,610
وخلال ذلك الوقت، أخذت خلسة
.الكيسيرو وخبّأته في منزلها

207
00:16:26,910 --> 00:16:28,110
!يا إلهي

208
00:16:28,760 --> 00:16:30,930
إذًا كلّ ذلك كان خدعة؟

209
00:16:30,930 --> 00:16:32,160
.بالفعل

210
00:16:32,160 --> 00:16:35,950
إنّ المرأة الّتي استسلمت لمشاعرها
قد تستعمل أيّة وسيلة

211
00:16:35,950 --> 00:16:38,430
.للحفاظ على اهتمام الرّجل الّذي تحبّ

212
00:16:39,930 --> 00:16:42,950
.ممّا يعني أنّها خدعت الزّوجة والزّوج معًا

213
00:16:48,340 --> 00:16:50,030
.كان ذلك ممتعًا كثيرًا

214
00:16:50,830 --> 00:16:56,000
أوهانا-سان وكونوسكي-سان وهانسكي-سان
.أشخاص رائعون جميعهم

215
00:16:57,220 --> 00:16:58,440
كاتسوسابورو-ساما؟

216
00:16:59,270 --> 00:17:03,450
.لقد أثّرت فيّ قصّة هانسكي-سان اليوم

217
00:17:03,790 --> 00:17:05,470
فعلاً؟

218
00:17:05,880 --> 00:17:10,080
.أنا أبذل جهدي دائمًا للحفاظ على مظهري

219
00:17:10,080 --> 00:17:12,470
.لهذا السّبب أرغب بطرح سؤال عليك

220
00:17:12,780 --> 00:17:13,720
.تفضّل

221
00:17:14,490 --> 00:17:19,050
هل انتهت العلاقة الّتي كانت بينك
وبين الرّجل الّذي كنتِ تهتمّين لأمره؟

222
00:17:20,390 --> 00:17:23,820
أم أنّك سمعتِ عنه مؤخّرًا؟

223
00:17:24,700 --> 00:17:25,740
.نعم

224
00:17:27,250 --> 00:17:29,330
.لقد بعث لي رسالة

225
00:17:29,970 --> 00:17:31,710
.فهمت

226
00:17:31,710 --> 00:17:33,250
.لكنّ الأمر من جانب واحد تمامًا

227
00:17:34,450 --> 00:17:38,010
لماذا يعتقد الرّجال دائمًا أنّه بمجرّد
أن تقع المرأة في حبّهم

228
00:17:38,010 --> 00:17:41,790
أنّها ستظلّ تحبّهم دائمًا؟

229
00:17:42,180 --> 00:17:43,990
ماذا عن الرّسالة إذًا؟

230
00:17:43,990 --> 00:17:46,210
!لن أقوم بالرّدّ عليها

231
00:17:46,210 --> 00:17:47,490
.إنّها تشعرني بعدم الارتياح

232
00:17:49,140 --> 00:17:51,020
...هكذا إذًا

233
00:17:51,510 --> 00:17:57,380
أهذا ما كان يزعجك يا كاتسوسابورو-ساما؟

234
00:17:57,380 --> 00:17:58,500
.نعم

235
00:18:01,810 --> 00:18:04,510
ما-ما بال تلك التّعابير على وجهك؟

236
00:18:06,030 --> 00:18:07,680
.لا سبب لها

237
00:18:12,590 --> 00:18:14,510
!أختي، إنّها سوو

238
00:18:17,370 --> 00:18:19,940
!ربّما أكون قد اكتشفت مكان سوو

239
00:18:21,330 --> 00:18:22,430
ماذا تعني؟

240
00:18:23,380 --> 00:18:25,290
...لكنّ هذا ما زال مجرّد حدس

241
00:18:25,980 --> 00:18:30,230
إنّ المرأة الّتي استسلمت لمشاعرها
قد تستعمل أيّة وسيلة

242
00:18:30,230 --> 00:18:32,750
.للحفاظ على اهتمام الرّجل الّذي تحبّ

243
00:18:33,990 --> 00:18:38,890
،إن كان ما قاله هانسكي-سان صحيحًا
.فذلك ينطبق على خطيبة ساتارو-سان أيضًا

244
00:18:38,890 --> 00:18:43,810
،أختي، إن استطعنا العثور على سوو
.فسيحلّ ذلك أمورًا عدّة

245
00:18:44,270 --> 00:18:45,370
...صحيح

246
00:18:47,510 --> 00:18:48,760
!سأخرج لبعض الوقت

247
00:18:57,770 --> 00:19:02,820
أهذا ما قصدتَه عندما كنتَ تتحدّث عن غرض
دون صندوق وملفوف في قماش حريريّ؟

248
00:19:03,330 --> 00:19:05,820
.غونبي-سان، افتحه رجاءً

249
00:19:10,100 --> 00:19:12,860
!هذه... سوو؟

250
00:19:14,830 --> 00:19:18,470
ما الّذي تفعله هنا؟ ماذا يحدث؟

251
00:19:19,560 --> 00:19:21,710
...إنّه مجرّد حدس

252
00:19:22,840 --> 00:19:25,340
،عندما وجدت أوكانو-سان سوو

253
00:19:25,340 --> 00:19:30,760
ربّما ظنّت أنّها ستكون الغرض المثاليّ الّذي
.سيرضي ساتارو-سان الّذي يحبّ الخزفيّات

254
00:19:31,510 --> 00:19:36,230
لكنّها لم تعجب ساتارو-سان كثيرًا
.كما كانت تأمل أوكانو-سان

255
00:19:36,230 --> 00:19:41,380
وأدركت أنّها لن تستطيع جعل
.ساتارو-سان يبادلها نفس الشّعور

256
00:19:42,380 --> 00:19:44,210
.حينها فكّرت في خطّة

257
00:19:45,020 --> 00:19:49,240
ستزور ساتارو-سان في إييدا-يا
وتستعيد المبخرة

258
00:19:49,240 --> 00:19:52,780
،عندما بقيت وحدها في غرفته
.وتعيدها إلى هذا المستودع

259
00:19:54,560 --> 00:19:58,110
ربّما تكون أوكانو-سان قد أصبحت
.عنيدة نوعًا ما

260
00:19:58,790 --> 00:20:02,320
على الأرجح أنّها لم ترد أن يتجاهل
.ساتارو-سان مشاعرها

261
00:20:02,750 --> 00:20:07,830
لكنّني لا أعتقد أنّ السّيّدة الصّغيرة
.كانت لتقوم بأمر كهذا بمفردها

262
00:20:07,830 --> 00:20:09,660
.أنت على حقّ. لم تفعل

263
00:20:09,660 --> 00:20:10,760
!ماذا؟

264
00:20:10,760 --> 00:20:14,700
.لهذا السّبب حصلت على مساعدة جدّتي

265
00:20:15,020 --> 00:20:16,110
!السّيّدة الصّغيرة

266
00:20:16,110 --> 00:20:17,020
...أوكانو-سان

267
00:20:17,390 --> 00:20:19,540
غونبي، من هذا الرّجل؟

268
00:20:19,910 --> 00:20:22,590
.إنّه سيجي-سان من إيزومو-يا

269
00:20:23,700 --> 00:20:27,530
إيزومويا-سان... أنت أخو أوكو-سان الأصغر إذًا؟

270
00:20:27,880 --> 00:20:28,690
.نعم

271
00:20:30,490 --> 00:20:34,050
.سيجي-سان، كان حدسك صائبًا

272
00:20:34,570 --> 00:20:41,040
لم يكن ساتارو-سان هناك في ذلك اليوم
.عندما أخذتني خادمة في إييدا-يا إلى غرفته

273
00:20:41,730 --> 00:20:45,370
،عندما ذهبت الخادمة للبحث عن ساتارو-سان

274
00:20:45,370 --> 00:20:49,410
.أخذت سوو وأعطيتُها لجدّتي

275
00:20:50,360 --> 00:20:53,040
،في تلك الأثناء، عادت جدّتي إلى منزلنا

276
00:20:53,040 --> 00:20:56,120
.واتّجهتُ أنا إلى الحديقة حيث كان ساتارو-سان

277
00:20:56,660 --> 00:20:59,570
.وتعرف ما حدث بعد ذلك

278
00:21:00,730 --> 00:21:02,760
!أنا جدّ آسفة

279
00:21:05,320 --> 00:21:08,550
.كلاّ، إنّها غلطتي بالكامل

280
00:21:09,250 --> 00:21:14,050
عندما سمعت أنّ غونبي قد اصطحب
،شخصًا ما للمستودع للبحت عن شيء

281
00:21:14,050 --> 00:21:15,840
.ظننت أنّ للأمر علاقة بهذا

282
00:21:16,460 --> 00:21:18,290
.أنا جدّ آسف

283
00:21:18,840 --> 00:21:23,440
كلاّ، أشعر وكأنّني كنت بانتظار
.مجيء هذا اليوم منذ زمن

284
00:21:24,480 --> 00:21:32,820
سيجي-سان، لقد أخطأت في حقّك وحقّ أختك
.وكذا في حقّ ساتارو-سان وإييدايا-سان

285
00:21:33,690 --> 00:21:34,780
.أنا آسفة

286
00:21:35,750 --> 00:21:38,550
...أنا

287
00:21:40,260 --> 00:21:42,990
لم تستطيعي المحافظة على رباطة جأشك، صحيح؟

288
00:21:46,230 --> 00:21:51,430
كانت مشاعر ساتارو-سان تجاه أختي
.أقوى من مشاعرك تجاهه

289
00:21:52,110 --> 00:21:55,490
ولهذا السّبب لم تكوني قادرة على
.المحافظة على رباطة جأشك

290
00:21:57,620 --> 00:22:03,880
ما اقترفته يداك قد غيّر حياة
.ساتارو-سان ولا يمكن أن يُغتفر

291
00:22:04,760 --> 00:22:11,510
لكن لا يستطيع أحد أن يلومك على
.مشاعر الحبّ الّتي شوّشت قلبك

292
00:22:29,260 --> 00:22:30,270
.المعذرة

293
00:22:34,510 --> 00:22:35,780
.مرحبًا

294
00:22:35,780 --> 00:22:38,780
.أنا يامامورايا ولديّ حجز هنا

295
00:22:38,780 --> 00:22:42,740
.أنت هو يامامورايا-ساما إذًا، كنّا في انتظارك

296
00:22:42,740 --> 00:22:44,050
.تفضّل من هنا رجاءً

297
00:22:44,400 --> 00:22:47,460
.ساتارو، أسرع وادخل

298
00:22:48,210 --> 00:22:48,980
.حاضر

299
00:24:30,330 --> 00:24:33,680
!لا أصدّق أن خطيبته أوكانو-سان هي الفاعلة

300
00:24:33,680 --> 00:24:35,520
،كانت تعرف طوال الوقت مكان سوو

301
00:24:35,520 --> 00:24:39,480
لكن لا يمكن أن تتطوّر أحداث القصّة
.بينما نجهل مكان ساتارو-سان

302
00:24:39,480 --> 00:24:43,240
!أختي، يبدو أنّ ساتارو-سان قد عاد إلى إيدو

303
00:24:43,240 --> 00:24:43,750
!ماذا؟

304
00:24:43,750 --> 00:24:47,790
ولكن بسبب امتلاكه للكثير من الأغراض
!القيّمة، يبدو أنّه قد اختفى

305
00:24:47,790 --> 00:24:50,740
!كلاّ! أيّها التسوكوموغامي، نحتاج لمساعدتكم

306
00:24:50,740 --> 00:24:52,670
،"في الحلقة القادمة من "نحن نؤجّر التسوكوموغامي

307
00:24:52,670 --> 00:24:54,240
."الفصل الأخير: "سوو