1
00:00:03,280 --> 00:00:04,950
.حيّ فوكاغاوا في فترة إيدو

2
00:00:04,950 --> 00:00:10,010
إنّه المكان الّذي يدير فيه شقيقان
.محلّ إجارة يُدعى إيزومو-يا

3
00:00:10,830 --> 00:00:14,460
"قد يبدو مصطلح "إجارة
،قديم الطّراز على ما أظنّ

4
00:00:14,460 --> 00:00:20,960
،لكن في المصطلحات الحديثة
.ربّما يمكنكم تسميته محلّ تأجير

5
00:00:21,860 --> 00:00:24,750
إنّه محلّ تأجير تحف حيث يمكنكم
العثور على أيّ شيء

6
00:00:24,750 --> 00:00:28,550
ابتداءً من الضّروريّات اليوميّة
.وصولاً للتّحف القديمة والفنّيّة

7
00:00:29,070 --> 00:00:36,230
ولكن، انتشرت إشاعات تقول إنّ محلّ
.إيزومو-يا لا يشبه أيّ محلّ تأجير آخر

8
00:00:32,460 --> 00:00:34,140
.شكرًا جزيلاً لكم

9
00:00:38,490 --> 00:00:40,910
.أهلاً يا أوكينو-سان، مرحبًا بك

10
00:00:40,910 --> 00:00:43,720
شكرًا جزيلاً لكما على الأوبياغي
.الّذي أجّرتماه لي مؤخّرًا

11
00:00:44,340 --> 00:00:48,500
هنالك أمر صغير تمنّيتُ
.التّحدّث به معكما اليوم

12
00:00:48,500 --> 00:00:49,720
هل لديكما وقت لذلك؟

13
00:00:50,360 --> 00:00:53,470
.نحن سعداء بتقديم أيّ مساعدة لك

14
00:00:53,470 --> 00:00:56,290
.هذا صديق مقرّب لي

15
00:00:56,290 --> 00:00:58,310
اِسمي ساكوما كاتسوسابورو

16
00:00:58,820 --> 00:01:00,580
...الأمر الّذي تقصده هو

17
00:01:01,500 --> 00:01:06,000
.نبتت أرجل لنتسوكي فأر نفيس وهرب

18
00:01:06,620 --> 00:01:09,510
نبتت أرجل لنتسوكي؟

19
00:01:09,510 --> 00:01:11,110
،أعرف أنّ الأمر يبدو مستحيلاً

20
00:01:12,030 --> 00:01:16,020
لكنّني بدأت أتساءل إن كان ذلك
.النّتسوكي عبارة عن تسوكوموغامي

21
00:01:18,140 --> 00:01:19,260
تسوكوموغامي؟

22
00:01:19,880 --> 00:01:21,130
ألا تعرف؟

23
00:01:21,740 --> 00:01:24,540
يُقال أنّ الأغراض الّتي يقدّرها
النّاس لوقت طويل

24
00:01:24,540 --> 00:01:26,730
،تصبح آلهة بينما تتقدّم في العمر

25
00:01:26,730 --> 00:01:29,260
.وهذه الأغراض تُعرف باسم تسوكوموغامي

26
00:01:29,670 --> 00:01:32,500
.بشكل أساسيّ، إنّها تشبه اليوكاي

27
00:01:32,500 --> 00:01:33,250
!يوكاي؟

28
00:01:33,250 --> 00:01:36,630
إنّ هذا السّاموراي جريء فعلاً بوضعنا
!في نفس الخانة مع تلك الأشياء

29
00:01:40,400 --> 00:01:41,780
هل قلت شيئًا ما؟

30
00:01:42,950 --> 00:01:45,770
.أخشى أنّني لم أسمع أيّ شيء

31
00:01:46,290 --> 00:01:49,540
،هذان الشّقيقان يتظاهران فحسب

32
00:01:49,950 --> 00:01:55,990
لكنّ محلّ إيزومو-يا هو في الحقيقة محلّ
.تأجير يمكن استعارة تسوكوموغامي منه

33
00:03:36,780 --> 00:03:40,270
حسنًا، ما قصّة هذا النّتسوكي
الّذي نبتت له أرجل وهرب؟

34
00:03:42,010 --> 00:03:45,280
.هنالك عائلة عتيقة تُعرف بعائلة هاتشيا

35
00:03:46,020 --> 00:03:51,800
تمّ توارث هذا الغرض المذهل من
.طرف الورثة المتعاقبين لتلك العائلة

36
00:03:52,500 --> 00:03:55,860
،ومؤخّرًا، توفّي ابن عائلة هاتشيا البكر

37
00:03:55,860 --> 00:03:58,070
،وبما أنّ ذلك ترك العائلة بلا وريث

38
00:03:58,070 --> 00:04:02,040
.رتّب كبير العائلة لزواج ابنته

39
00:04:02,850 --> 00:04:05,790
،وبالتالي، أمسى خطيب الابنة الوريث

40
00:04:05,790 --> 00:04:08,310
.لذلك تمّ منح هذا النّتسوكي إليه

41
00:04:09,540 --> 00:04:13,320
.لكنّه فقده. كلاّ، بل هرب منه

42
00:04:13,610 --> 00:04:15,820
ومن يكون خطيبها؟

43
00:04:16,290 --> 00:04:17,950
،إنّه أنا

44
00:04:17,950 --> 00:04:22,320
لكنّ الاتّفاق عُقد بين عائلتينا دون
.أخذ رغبتي في الاعتبار

45
00:04:22,700 --> 00:04:28,060
—وبعدها، أين هرب نتسوكي الفأر هذا
أقصد، أين فقدتَه؟

46
00:04:28,700 --> 00:04:35,080
مُنحت مجموعة غرف لعائلتي
.داخل قصر السّيّد الّذي نخدمه

47
00:04:35,730 --> 00:04:41,350
،احتفظتُ بالنّتسوكي في غرفتي في القصر
.لكنّ لصًّا اقتحم المكان ذات يوم

48
00:04:43,770 --> 00:04:45,350
.فهمت

49
00:04:45,880 --> 00:04:48,550
.سأكافئكما بسخاء. ساعداني رجاءً

50
00:04:51,570 --> 00:04:57,470
على كلّ حال، صدّق كاتسوسابورو-ساما
.بسرعة أنّه كان تسوكوموغامي

51
00:04:57,470 --> 00:04:59,860
.ليست التسوكوموغامي عاديّة بالضّبط

52
00:04:59,860 --> 00:05:03,200
إنّها ليست شيئًا يمكن للمرء
.أن ينساه بمجرّد أن يراه

53
00:05:03,200 --> 00:05:07,110
.يا لغرابة الطّلب الّذي قبل به هذين

54
00:05:07,110 --> 00:05:11,440
،كان عليهما رفض طلبه في الحال
أليس كذلك يا تسوكويومي؟

55
00:05:11,440 --> 00:05:17,130
من الصّعب الجزم متى على المرء
.أن يرفض أو يقبل طلبًا ما

56
00:05:17,130 --> 00:05:21,630
لكن، لكن، من غير الطّبيعيّ جدًّا بالنّسبة
لتسوكوموغامي أن يتحرّك أمام البشر، صحيح؟

57
00:05:21,630 --> 00:05:25,390
.أتساءل لماذا هرب من مالكه من الأساس

58
00:05:25,690 --> 00:05:27,520
.هذا سؤال جيّد يا أوساغي

59
00:05:27,520 --> 00:05:30,500
لماذا لا نحاول مراجعة التّفاصيل مرّة أخرى إذًا؟

60
00:05:30,500 --> 00:05:32,880
.لقد اكتشفنا الأمر برمّته سلفًا

61
00:05:32,880 --> 00:05:35,660
تسألون لماذا هرب نتسوكي الفأر؟

62
00:05:35,660 --> 00:05:38,140
.السّبب هو أنه خائف بكلّ وضوح

63
00:05:38,580 --> 00:05:41,240
.هذا هو نوتيتسو، إنّه تسوكوموغامي

64
00:05:41,890 --> 00:05:44,410
.إنّه نتسوكي وطواط

65
00:05:44,410 --> 00:05:47,840
بالمناسبة، النّتسوكي الّتي كنّا نتحدّث عنها

66
00:05:47,840 --> 00:05:50,700
هي مشابك كانت تُستعمل من
،طرف معاصري فترة إيدو

67
00:05:50,700 --> 00:05:54,160
وكانت على وجه الخصوص الأنيقة
منها الّتي تُثبَّتُ بحاويات التّبغ

68
00:05:54,160 --> 00:05:58,010
أو العلب المقفلة الموضوعة على الأحزمة
.بواسطة خيوط بينما يتجوّلون

69
00:05:58,010 --> 00:06:03,660
في لغة عصركم، يمكنكم  تسميتها
.بتمائم جالبة للحظّ

70
00:06:03,660 --> 00:06:06,740
،خطأ واحد قادر على فصله لنصفين

71
00:06:06,740 --> 00:06:09,930
.وسيكون ذلك نهاية حياته كتسوكوموغامي

72
00:06:10,290 --> 00:06:11,820
.هذا منطقيّ

73
00:06:11,820 --> 00:06:15,960
هل تقصدون أنّ من الممكن أن
يكون ما زال مختبئًا في مكان ما؟

74
00:06:17,000 --> 00:06:22,030
سيجي، تعرف أنّ التسوكوموغامي
.لن تجيب على أسئلتنا

75
00:06:26,550 --> 00:06:30,320
.لقد قبلنا بقضيّة مزعجة حقًّا

76
00:06:30,320 --> 00:06:32,820
.لا يمكننا رفض طلب من أوكينو-سان

77
00:06:33,510 --> 00:06:37,080
ما الأمر على أيّ حال؟ هل تريد الاستسلام؟

78
00:06:37,080 --> 00:06:39,720
.كلاّ، ذلك ليس ما قصدت

79
00:06:40,070 --> 00:06:42,840
سيجي، ألا تريد أن تعرف

80
00:06:43,220 --> 00:06:45,510
السّبب الّذي قد يدفع امرؤًا ما إلى الذّهاب

81
00:06:45,510 --> 00:06:49,580
حتّى قصر حاكم إقطاعي ساعيًا
فقط خلف شيء مثل النّتسوكي؟

82
00:06:50,680 --> 00:06:54,780
.بالفعل، لا بدّ أنّه كانت ثمّة أغراض أكثر قيمة

83
00:06:55,810 --> 00:06:56,850
أتظنّ؟

84
00:07:01,340 --> 00:07:05,060
لكن، لكن، أنا مهتمّة كثيرًا فيما
إذا كان ذلك السّاموراي

85
00:07:05,060 --> 00:07:09,160
سيتمّ احتضانه من طرف تلك العائلة
.بمجرّد أن يستعيد النّتسوكي

86
00:07:09,160 --> 00:07:14,780
أريد أن أعرف إن كانت الفتاة الّتي سيتزوّجها
.كاتسوسابورو-ساما جميلة أم لا

87
00:07:14,780 --> 00:07:17,710
إن اكتشفنا ذلك، سيكون لدينا الكثير
—من الأمور لندردش بها

88
00:07:17,710 --> 00:07:20,870
أعني، الكثير من الأمور لمناقشتها
.لبعض الوقت

89
00:07:20,870 --> 00:07:22,340
!صحيح! صحيح

90
00:07:22,340 --> 00:07:24,900
.يا أختي، راودتني فكرة ممتازة للتّوّ

91
00:07:25,550 --> 00:07:30,380
بشأن القصر الّذي يعيش فيه الحاكم الإقطاعيّ
...الّذي تخدمه عائلة كاتسوسابورو

92
00:07:30,880 --> 00:07:33,880
ماذا؟! تريد أن تعيرهم أحد تحفنا؟

93
00:07:34,740 --> 00:07:39,190
نعم، إنّ حقيقة أنّ النّتسوكي
قد يكون مختبئًا في مكان ما

94
00:07:39,190 --> 00:07:42,560
تعني أنّه قد يكون مختبئًا
في مكان ما في القصر، صحيح؟

95
00:07:42,900 --> 00:07:46,090
سوف نعير أحد تحفنا لفرد من القصر بالمجّان

96
00:07:46,090 --> 00:07:48,260
.بذريعة أنّنا نسمح لهم بتجربته

97
00:07:48,640 --> 00:07:53,220
سوف يجمع الإشاعات من القصر
.وسيناقشها مع البقيّة بمجرّد عودته

98
00:07:54,230 --> 00:07:58,380
علينا أن نطلب من كاتسوسابورو-ساما
أن يوصي لنا بفرد من قصر عائلة هاتشيا

99
00:07:58,380 --> 00:08:01,000
،ونعيره أحد التسوكوموغامي أيضًا

100
00:08:01,500 --> 00:08:04,770
بما أنّ النّتسوكي قد يكون
.قد عاد إلى مكانه الأصليّ

101
00:08:04,770 --> 00:08:08,410
!إنّهما سيعيروننا فقط من أجل صالحهما

102
00:08:08,410 --> 00:08:11,110
!هذا يخالف تمامًا الهدف من محلّ التّأجير

103
00:08:11,110 --> 00:08:13,560
.لكن، لكن، يبدو هذا مثيرًا للاهتمام

104
00:08:13,560 --> 00:08:14,670
!كيف ذلك؟

105
00:08:14,670 --> 00:08:16,420
.كم سيكون ذلك رائعًا

106
00:08:17,120 --> 00:08:19,810
أنا واثقة أنّها ستستمع للكثير
من القصص المثيرة

107
00:08:19,810 --> 00:08:22,440
بما أنّها ستتواجد بين عائلتَيْ
.ساكوما وهاتشيا معًا

108
00:08:23,170 --> 00:08:25,740
يملك محلّ التّأجير كامل الحرّيّة
.في إعارة أيّ غرض يختارونه

109
00:08:25,740 --> 00:08:28,090
.لا يوجد ما بوسعنا فعله حيال ذلك

110
00:08:28,090 --> 00:08:31,710
،أنت مهتمّ بالأمر بقدر بقيّتنا فحسب
صحيح يا تسوكويومي؟

111
00:08:31,710 --> 00:08:34,190
.بهذا تكون قد حلّت المسألة

112
00:08:34,190 --> 00:08:36,080
!حسنًا، أنا لست مهتمًّا

113
00:08:40,310 --> 00:08:43,200
...أتمنّى أن نحصل على نتيجة من هذا

114
00:08:43,540 --> 00:08:47,410
،بعيدًا عن ذلك
ما رأيك بحِلية شعري؟

115
00:08:47,410 --> 00:08:49,710
.لدينا بعض الأغراض الأكثر أناقة في المخزن

116
00:08:49,710 --> 00:08:54,130
.ماذا؟ صحيح... من الأفضل أن نسرع

117
00:08:54,130 --> 00:08:58,720
.سأتّجه إلى قصر ساكوما-ساما
.اتّجهي أنت إلى عائلة هاتشيا

118
00:09:07,110 --> 00:09:10,100
حسنًا، هل تعتقد أنّ بإمكانك العثور
على النّتسوكي خاصّتي؟

119
00:09:10,550 --> 00:09:12,980
.يعتمد ذلك على التسوكوموغامي

120
00:09:14,930 --> 00:09:16,240
ماذا تعني؟

121
00:09:16,610 --> 00:09:18,630
.لا شيء. لا تهتمّ

122
00:09:19,090 --> 00:09:23,730
الأهمّ من ذلك الآن، سمعت أنّ مخطوبتك
ساناي-ساما امرأة جميلة للغاية، صحيح؟

123
00:09:24,870 --> 00:09:26,620
.كفانا حديثًا عن ساناي-دونو

124
00:09:27,150 --> 00:09:30,890
إضافة لذلك، هنالك آنسة جميلة
.جدًّا في محلّ إيزومو-يا أيضًا

125
00:09:30,890 --> 00:09:32,750
هل هي زوجتك؟

126
00:09:33,130 --> 00:09:35,270
.كلاّ، إنّها أختي الكبرى

127
00:09:36,000 --> 00:09:38,510
.هكذا إذًا؟ أعتذر، أعتذر

128
00:09:38,820 --> 00:09:41,790
أنتما متوافقان كثيرًا لدرجة
.أنّني حسبتها زوجتك

129
00:09:42,250 --> 00:09:47,490
لا تجمعنا قرابة دم، لكن يمكنك العثور
.على أشقّاء من هذا النّوع في كلّ مكان

130
00:09:50,060 --> 00:09:52,010
...ليت كان ذلك صحيحًا

131
00:09:53,640 --> 00:09:56,100
.حسنًا، سأعهد لك بهذه المهمّة

132
00:09:56,710 --> 00:09:57,590
.بالطّبع

133
00:10:03,280 --> 00:10:06,530
!رأيت أخ كاتسوسابورو الأكبر، يونوسكي

134
00:10:06,850 --> 00:10:10,040
كان لديه وجه نحيل سيكون محبوبًا أكثر
!لدى الفتيات أكثر من وجه كاتسوسابورو

135
00:10:10,860 --> 00:10:14,110
!لكنّه بدا أكثر إزعاجًا

136
00:10:15,060 --> 00:10:19,300
لكن، لكن، ألم يكن نوتيتسو
الأقلّ اهتمامًا بالأمر؟

137
00:10:19,660 --> 00:10:21,330
.هذا صحيح

138
00:10:21,330 --> 00:10:24,320
إذًا، هل سمعتِ أو رأيتِ أيّ شيء يا أوهيمي؟

139
00:10:24,970 --> 00:10:29,350
انهمكت خادماتهم في النّميمة قائلات
!إنّ عائلة ساكوما لديها 200 كوكو

140
00:10:29,350 --> 00:10:32,320
.إنّهم إذًا عائلة ساموراي متوسّطة المستوى

141
00:10:32,710 --> 00:10:36,190
ذهبنا نحن إلى عائلة هاتشيا، وكان لديهم

142
00:10:36,190 --> 00:10:40,330
.قصر يتّسع لحوال 500، بل إلى 600 كوكو

143
00:10:40,330 --> 00:10:43,580
.حتّى أنّه تسنّى لي رؤية مخطوبته ساناي-ساما

144
00:10:43,580 --> 00:10:44,450
!ماذا؟

145
00:10:44,450 --> 00:10:45,570
هل كانت جميلة؟

146
00:10:45,570 --> 00:10:49,490
،إنّها في السّادسة عشر وجميلة للغاية

147
00:10:49,490 --> 00:10:52,210
.لكنّها بدت طيّعة قليلاً بالنّسبة لذوقي

148
00:10:52,210 --> 00:10:55,900
!على الإطلاق، على الإطلاق
!لم تبدُ طيّعة على الإطلاق

149
00:10:55,900 --> 00:10:57,470
ما الّذي كنت تنظر إليه يا غوي؟

150
00:10:57,920 --> 00:11:02,210
،كانت تتوصّل برسائل من رجل آخر
!رغم أنّها مخطوبة

151
00:11:07,320 --> 00:11:08,860
،ناهيكم عن ذكر، ناهيكم عن ذكر

152
00:11:08,860 --> 00:11:12,810
كانت تبكي أمام والدها وتقول
.إنّها تريده أن يلغي الزّفاف

153
00:11:13,470 --> 00:11:17,320
أختي، ذكر كاتسوسابورو-ساما
أنّ هنالك أخًا أكبر

154
00:11:17,320 --> 00:11:20,330
لعائلة هاتشيا وقد توفّي قبل مدّة
ليست ببعيدة، صحيح؟

155
00:11:20,690 --> 00:11:21,820
...نعم

156
00:11:22,300 --> 00:11:26,860
ممّا يعني أنّ خطوبة كاتسوسابورو-ساما
من ساناي-دونو

157
00:11:26,860 --> 00:11:31,510
تمّ التّرتيب لها بسرعة بسبب موت
.ابن عائلة هاتشيا البكر

158
00:11:32,580 --> 00:11:35,230
إذًا فالرّسائل الّتي كانت تتلقّاها ساناي-ساما

159
00:11:35,230 --> 00:11:41,070
هي من شخص آخر أحبّته قبل
أن تُخطب لكاتسوسابورو-ساما؟

160
00:11:41,070 --> 00:11:43,750
،نعم، وإن كان الوضع هكذا

161
00:11:43,750 --> 00:11:48,030
أنا مقتنع أنّ ذلك هو السّبب الّذي
.دفعها للتّوسّل لوالدها ليؤجّل الزّفاف

162
00:11:48,590 --> 00:11:50,860
...ولكنّ ذلك يعني

163
00:11:51,320 --> 00:11:53,870
.أختي، سأقترح أمرًا جنونيًّا

164
00:11:54,420 --> 00:11:57,390
،ماذا لو كان من سرق النّتسوكي ليس لصًّا

165
00:11:57,390 --> 00:11:59,860
بل شخصًا كان يحاول أن يجعله يُسرق؟

166
00:12:00,480 --> 00:12:03,740
مستحيل! هل تقترح أنّ للأمر
علاقة بساناي-ساما؟

167
00:12:05,900 --> 00:12:09,130
.لا يمكن، أنت تبالغ كثيرًا بتخمينك هذا

168
00:12:09,570 --> 00:12:13,950
،لكن ما دامت ثمّة احتماليّة لذلك
.فلا يجب علينا التّدخّل أكثر

169
00:12:14,500 --> 00:12:16,260
.لنتوقّف عن البحث عن النّتسوكي

170
00:12:16,260 --> 00:12:17,370
!ذلك ليس عادلاً

171
00:12:17,370 --> 00:12:20,830
أنتما تهتمّان فقط بشأن استعمالنا
إلى أن يصبح الوضع غير مناسب لكما

172
00:12:20,830 --> 00:12:23,130
!ودون اعتبار معاناتنا أيضًا

173
00:12:23,510 --> 00:12:28,140
في النّهاية، سيقدّر النّاس التّحف
،من أمثالنا عندما يحتاجونها

174
00:12:28,140 --> 00:12:32,890
لكن بمجرّد تغيّر ذلك، يحاولون
!بيعنا أو أن يهبونا للغرباء

175
00:12:32,890 --> 00:12:36,340
أنا غاضب بشدّة على نفسي لمعرفتي لذلك

176
00:12:36,340 --> 00:12:38,700
وما زلت مثيرًا للشّفقة لدرجة
!أن أُخدع من طرف هذين الاثنين

177
00:12:38,700 --> 00:12:40,660
!اكتفيت من الحديث بهذا الشّأن

178
00:12:41,840 --> 00:12:44,970
إنّ نوتيتسو قاسٍ كثيرًا على البشر، صحيح؟

179
00:12:44,970 --> 00:12:47,160
.ذلك طبيعيّ

180
00:12:47,630 --> 00:12:53,060
سمعتُ أنّ نوتيتسو كان غرضًا نفيسًا
،لدى مالكه السّابق لوقت طويل

181
00:12:53,060 --> 00:12:56,910
،لكن عندما فشل عمل ابن مالكه

182
00:12:56,910 --> 00:13:01,920
باعه مالك نوتيتسو لجمع المال
.من أجل ديون ابنه

183
00:13:02,490 --> 00:13:06,380
ومذّاك الحين، أمسى نوتيتسو ينتقل
من شخص لآخر

184
00:13:06,380 --> 00:13:09,260
.قبل أن يصل أخيرًا إلى هنا في إيزومو-يا

185
00:13:10,180 --> 00:13:17,360
،لذلك فهو يعتقد أنّ في النّهاية
.لا يقدّر البشر التّحف بالفعل

186
00:13:23,660 --> 00:13:25,270
وجدت النّتسوكي؟

187
00:13:25,670 --> 00:13:26,870
!نعم

188
00:13:26,870 --> 00:13:30,170
بائعة هوى من معارفي أخبرتني قبل قليل

189
00:13:30,170 --> 00:13:35,530
عن زبون لصديقتها يبدو أنّه يملك
.ما يشبه نتسوكي فأر

190
00:13:36,010 --> 00:13:41,230
،لكنّني لم أستطع الذّهاب للسّؤال بنفسي
.بما أنّه كان زبون بائعة هوى أخرى

191
00:13:41,770 --> 00:13:43,810
.سيجي، عليك الذّهاب

192
00:13:44,250 --> 00:13:46,550
.هذا مستحيل تمامًا

193
00:13:46,550 --> 00:13:49,010
هل يفترض بي الذّهاب إلى حيّ الدّعارة

194
00:13:49,010 --> 00:13:51,450
والتّحقيق مع كلّ رجل نام
مع بائعة الهوى تلك؟

195
00:13:52,100 --> 00:13:53,100
—مستحيل أن

196
00:13:53,100 --> 00:13:54,980
.من المستحيل أن يتمكّن من ذلك

197
00:13:55,980 --> 00:13:58,970
.إنّه لا يملك ما يكفي من الشّجاعة على أيّ حال

198
00:13:58,970 --> 00:14:00,060
!صحيح، صحيح

199
00:14:00,060 --> 00:14:05,820
إنّه لم يستطع حتّى استجماع الشّجاعة
!ليُثنِيَ على حلية شعرها ذلك اليوم

200
00:14:05,820 --> 00:14:09,440
.ربّما هنالك شيء يمكننا فعله

201
00:14:09,440 --> 00:14:12,480
الوحيد الّذي يستطيع التّحرّك
...بسهولة بيننا

202
00:14:12,920 --> 00:14:14,310
!لا بدّ أنّك تمزحين

203
00:14:14,310 --> 00:14:18,070
لماذا عليّ أن أكون من يساعد
!ذلك الفتى ثانية؟

204
00:14:18,370 --> 00:14:20,540
.لكنّ ذلك ليس من أجله

205
00:14:20,540 --> 00:14:22,720
.بل من أجل فضولنا نحن

206
00:14:23,120 --> 00:14:24,610
.معها حقّ

207
00:14:24,610 --> 00:14:26,260
.حسنًا، أعتقد أنّ المسألة قد حُلّت

208
00:14:26,260 --> 00:14:28,980
ألا تهتمّ بالفعل بأيّ شيء آخر عدى
اتّخاذ القرار في مسائل كهذه؟

209
00:14:29,290 --> 00:14:30,550
.توقّف

210
00:14:30,550 --> 00:14:32,730
.لا يمكن لنوتيتسو المساعدة

211
00:14:33,250 --> 00:14:38,970
سمعتم ما قاله كاتسوسابورو-ساما عندما
.وصف نتسوكي الفأر بكونه غرضًا مذهلاً

212
00:14:39,380 --> 00:14:42,850
.لا يريد نوتيتسو رؤية نتسوكي أفضل منه

213
00:14:44,510 --> 00:14:49,290
إنّ لقاءه لنتسوكي أكثر قيمة وروعة
.منه سيجرح كرامته لا غير

214
00:14:49,740 --> 00:14:52,910
لهذا السّبب لن يقدّم نوتيتسو
.المساعدة في هذه المسألة

215
00:14:52,910 --> 00:14:54,490
!ذلك ليس السّبب على الإطلاق

216
00:14:54,490 --> 00:14:57,820
لا بأس، سوف أذهب لملاحقة
!نتسوكي الفأر ذاك

217
00:14:58,250 --> 00:14:59,430
!انتظروا فحسب

218
00:15:00,600 --> 00:15:05,330
إذًا فتسوكويومي هو من أراد معرفة
.الحقيقة أكثر منّا قبل كلّ شيء

219
00:15:05,330 --> 00:15:06,700
.ذلك ما يبدو

220
00:15:09,280 --> 00:15:10,480
!أوكينو-سان

221
00:15:11,570 --> 00:15:12,720
...هذا أنت

222
00:15:13,370 --> 00:15:16,370
هلاّ أخذتِ هذا معك لحيّ الدّعارة؟

223
00:15:53,100 --> 00:15:55,150
.اسمي ريكيو

224
00:15:55,150 --> 00:15:57,580
!إذًا فأنت تسوكوموغامي بالفعل

225
00:15:57,580 --> 00:16:02,940
هلاّ أخبرتنا ما حدث عندما اقتحم اللّصّ
قصر كاتسوسابورو-ساما؟

226
00:16:03,350 --> 00:16:06,690
عندما اقتحم اللّصّ ماذا؟

227
00:16:06,690 --> 00:16:09,440
،لقد تمّت سرقتي بالفعل
،لكن حسبما أذكر

228
00:16:09,440 --> 00:16:13,200
.بدا اللّصّ أنّه يعرف كاتسوسابورو-ساما

229
00:16:11,200 --> 00:16:12,410
...أنت

230
00:16:13,940 --> 00:16:16,440
هل كان ذلك لصًّا بالفعل؟

231
00:16:16,780 --> 00:16:21,650
إذًا فأنت لم تهرب من تلقاء نفسك
لأنّك كنتَ خائفًا من اللّصّ؟

232
00:16:21,650 --> 00:16:26,460
.كلاّ، لقد بقيت كغرض بسيط طوال الوقت

233
00:16:26,890 --> 00:16:32,220
لماذا قال كاتسوسابورو-ساما
أنّك هربتَ بعيدًا إذًا؟

234
00:16:32,620 --> 00:16:33,950
.لا أدري

235
00:16:35,320 --> 00:16:37,720
ماذا، ماذا؟ ما الأمر يا نوتيتسو؟

236
00:16:38,330 --> 00:16:41,720
...رأيتُ ذلك الوجه من قبل

237
00:16:42,250 --> 00:16:46,600
أخبريني يا أختي، إن كان نتسوكي الفأر
،لم يبرح مكانه طوال الوقت

238
00:16:46,600 --> 00:16:50,480
فمن المستحيل أن يكون كاتسوسابورو-ساما
.قد عرف أنّه تسوكوموغامي

239
00:16:50,850 --> 00:16:54,360
،وإن لم يكن هنالك لصّ، بل شخصًا يعرفه

240
00:16:54,360 --> 00:16:56,490
.فهذا يعني أنّه سمح له بالاحتفاظ به

241
00:16:56,910 --> 00:17:00,440
لا يبدو أنّ منح شيء نفيس
.كهذا أمرًا منطقيًّا

242
00:17:02,000 --> 00:17:06,990
في النّهاية، سيقدّر النّاس التّحف
،من أمثالنا عندما يحتاجونها

243
00:17:06,990 --> 00:17:11,930
لكن بمجرّد تغيّر ذلك، يحاولون
!بيعنا أو أن يهبونا للغرباء

244
00:17:12,540 --> 00:17:14,040
!فهمت

245
00:17:14,040 --> 00:17:17,880
لم يعد كاتسوسابورو-ساما
!بحاجة للفأر النّتسوكي

246
00:17:18,940 --> 00:17:19,930
ماذا؟

247
00:17:22,800 --> 00:17:25,350
ما خطب هذا الصّراخ المفاجئ؟

248
00:17:25,350 --> 00:17:29,070
!تذكّرت! ذلك الرّجل في حيّ الدّعارة

249
00:17:31,520 --> 00:17:35,600
.تفاجأت من سماع أنّك وجدت نتسوكي الفأر

250
00:17:35,980 --> 00:17:37,630
.كان الأمر صعبًا

251
00:17:37,630 --> 00:17:42,620
.خاصّة أنّ ما قلتَه عن هربه كان كذبة

252
00:17:43,320 --> 00:17:44,650
ماذا تقصد؟

253
00:17:45,170 --> 00:17:49,370
تبدو وكأنّك كنتَ هناك
.وقت اقتحام اللّصّ للمكان

254
00:17:49,370 --> 00:17:51,890
.كلاّ، لم يكن هنالك لصّ

255
00:17:52,280 --> 00:17:55,640
!تذكّرت! ذلك الرّجل في حيّ الدّعارة

256
00:17:55,640 --> 00:17:56,890
!كان هو

257
00:17:56,890 --> 00:17:58,890
!إنّه أخو كاتسوسابورو الأكبر

258
00:17:58,890 --> 00:18:00,630
!كان ذلك الرّجل

259
00:18:01,080 --> 00:18:05,140
لم يكن لصًّا، بل صديقًا لأخيك الأكبر
.يونوسكي-ساما

260
00:18:05,790 --> 00:18:07,910
.لقد سمحتَ له بالهرب

261
00:18:08,740 --> 00:18:10,910
...عندما زرتك في منزلك

262
00:18:11,550 --> 00:18:16,660
لا تجمعنا قرابة دم، لكن يمكنك العثور
.على أشقّاء من هذا النّوع في كلّ مكان

263
00:18:17,280 --> 00:18:19,240
...ليت كان ذلك صحيحًا

264
00:18:19,900 --> 00:18:23,920
كنتَ تتحدّث عن علاقتك السّيّئة
مع أخيك يونوسكي-ساما، صحيح؟

265
00:18:24,930 --> 00:18:26,080
،إضافة لذلك

266
00:18:26,080 --> 00:18:30,660
ما كنتَ لتمانع إن فُسخت خطبتك
من ساناي-ساما، صحيح؟

267
00:18:33,100 --> 00:18:36,680
.كانت خطوبة مرتّبة دون أيّ اعتبار لرغبتك

268
00:18:37,190 --> 00:18:40,310
وبينما أقنعت نفسك بقبولها
،تلبية لرغبة عائلتك

269
00:18:40,310 --> 00:18:43,180
،كانت ساناي-ساما مركّزة على الشّخص الّذي تحبّ

270
00:18:43,180 --> 00:18:45,420
.تاركة إيّاك بمنأى عنها

271
00:18:46,000 --> 00:18:49,250
،وبذلك أصبحت يائسًا بشكل متزايد

272
00:18:49,250 --> 00:18:51,940
،واستغللت محاولة مضايقة أخيك لك

273
00:18:52,740 --> 00:18:56,710
،وكذبت بشأن كون النّتسوكي تسوكوموغامي
،وجعلت الأمر يبدو وكأنّك تبحث عنه

274
00:18:56,710 --> 00:19:00,190
.وحاولت خداع والدك وحمُوِّك

275
00:19:04,740 --> 00:19:07,740
تملك عائلة هاتشيا ثروة تقدّم
.بحوال 450 كوكو

276
00:19:08,180 --> 00:19:10,210
،وهذا أكثر بكثير ممّا لدى عائلة ساكوما

277
00:19:10,210 --> 00:19:12,460
.وهي عائلة عتيقة ومترسّخة

278
00:19:12,780 --> 00:19:17,100
.لطالما استخفّ بي أخي بصفتي الابن الثّاني

279
00:19:17,100 --> 00:19:21,380
.وكنتُ سأصبح كبير عائلة كبيرة الشّأن

280
00:19:21,890 --> 00:19:23,970
.لا بدّ أنّه كره ذلك بشدّة

281
00:19:24,800 --> 00:19:26,990
لكن كيف عرفتَ بشأن الوضع مع ساناي؟

282
00:19:27,840 --> 00:19:29,480
هل هي من أخبرك؟

283
00:19:29,860 --> 00:19:32,730
كلاّ، بل عرفتُ انطلاقًا
.من شيء أخبرني به أحدهم

284
00:19:33,130 --> 00:19:36,980
في النّهاية، سيقدّر النّاس التّحف
،عندما يحتاجونها

285
00:19:36,980 --> 00:19:42,480
لكن بمجرّد تغيّر ذلك، يحاولون
!بيعها أو أن يهبوها للغرباء

286
00:19:43,100 --> 00:19:46,140
إنّ حقيقة سماحك له بالهرب بنتسوكي الفأر ذاك

287
00:19:46,140 --> 00:19:49,740
.تفيد أنّه ما عاد ذا قيمة لديك

288
00:19:50,140 --> 00:19:54,260
ذلك لأنّك اعتقدت أنّك ما عدت
.ترغب بالزّواج منها

289
00:19:56,480 --> 00:19:57,850
.هذا صحيح

290
00:19:58,890 --> 00:20:02,840
.لم أعد بحاجة لنتسوكي الفأر ذاك

291
00:20:03,360 --> 00:20:05,060
.لذلك سمحت له بأخذه

292
00:20:05,990 --> 00:20:07,390
.لقد أثرت إعجابي

293
00:20:09,530 --> 00:20:11,630
ألا تحتاجه بالفعل؟

294
00:20:14,100 --> 00:20:19,120
بينما كنّا نبحث عن النّتسوكي، سمعنا
إشاعات أنّ الرّجل الّذي تحبّ ساناي-ساما

295
00:20:19,120 --> 00:20:22,340
.سيتزوّج قريبًا بفتاة أخرى

296
00:20:23,090 --> 00:20:24,340
وماذا في ذلك؟

297
00:20:25,370 --> 00:20:27,920
.أخبرها أنّها جميلة

298
00:20:30,240 --> 00:20:31,790
.أنا أقصد ساناي-ساما

299
00:20:32,410 --> 00:20:35,920
لقد جمع القدر بينكما، لذلك عليك
.إخبارها بذلك على الأقلّ

300
00:20:36,760 --> 00:20:39,480
ثمّ يومًا ما، عندما تكونان
،متزوّجان وتعيشان بسعادة

301
00:20:39,480 --> 00:20:43,960
ستكون قادرًا على تقدير هذا النّتسوكي
.الّتي تشعر أنّك ما عدتَ تحتاجه الآن

302
00:20:45,640 --> 00:20:46,970
،يا إلهي

303
00:20:48,020 --> 00:20:51,420
.لقد نصحتني أوكينو بمحلّ تأجير ممتاز

304
00:21:01,890 --> 00:21:03,330
هلّي أن أسألك عن شيء؟

305
00:21:04,490 --> 00:21:08,820
لماذا واصلت مجاراتي بقصّتي إن لم
يكن هنالك وجود للتسوكوموغامي؟

306
00:21:09,480 --> 00:21:12,190
حسنًا، من يدري؟

307
00:21:12,940 --> 00:21:15,200
.لكن يمكنني إخبارك بهذا على الأقلّ

308
00:21:15,660 --> 00:21:19,380
.وحدها التّحف الّتي نقدّرها تصبح تسوكوموغامي

309
00:21:20,010 --> 00:21:23,540
من هذا الّذي قد يرغب في التّخلّي
عن أشياء كهذه؟

310
00:21:24,010 --> 00:21:27,400
التّخلّي عن أغراض مثلها سيكون
.أمرًا صعبًا على المالك أيضًا

311
00:21:28,270 --> 00:21:32,540
،لذا إن كان هذا النّتسوكي عبارة عن تسوكوموغامي
.فذلك يُظهر أنّ هنالك من احتاجه

312
00:21:33,570 --> 00:21:38,350
،حتّى إن كانت قصّة فقدانه كذبة
.ما كنت لأسمح للأمر أن يمرّ مرور الكرام

313
00:21:39,190 --> 00:21:41,480
.أنا أدير محلّ تأجير قبل كلّ شيء

314
00:21:42,190 --> 00:21:45,260
.فهمت. شكرًا على مساعدتك

315
00:21:49,860 --> 00:21:51,310
.أخبرني يا سيجي

316
00:21:53,730 --> 00:21:59,010
لقد تدخّلتَ في شؤون شخص آخر
وحاولت مساعدته. فما خطبك؟

317
00:21:59,750 --> 00:22:03,540
.من يدري؟ حتّى أنا لست واثقًا

318
00:22:03,540 --> 00:22:07,280
إذًا، إذًا، كان سيجي لطيفًا على
غير المعتاد اليوم، صحيح؟

319
00:22:07,280 --> 00:22:09,820
.لطيفًا مع كاتسوسابورو-ساما ونوتيتسو أيضًا

320
00:22:09,820 --> 00:22:12,510
إنّ لدى سيجي الكثير من الأشياء
.ليتعاطف معهما بها

321
00:22:14,120 --> 00:22:18,120
إضافة لذلك، رغم أنّه قد لا يكون
،النّتسوكي الفأر ريوكو

322
00:22:18,120 --> 00:22:19,910
إلاّ أنّ هذين الاثنين يبحثان
...عن شيء ما بالفعل

323
00:22:20,650 --> 00:22:22,040
.ألا وهو سوو

324
00:22:23,340 --> 00:22:24,530
...سوو

325
00:22:28,790 --> 00:22:34,080
سيجي! أنا أخبرك دائمًا بالاهتمام
!أكثر بالبضائع في محلّنا

326
00:22:34,080 --> 00:22:38,550
يستطيع شخص طائش مثلك الذّهاب
.للخارج ليهدأ وينظّف واجهة المحلّ

327
00:22:50,720 --> 00:22:55,700
.أختي، حلية الشّعر تلك جميلة

328
00:24:30,990 --> 00:24:33,650
!لقد كان ضعيفًا للغاية بالفعل

329
00:24:33,650 --> 00:24:36,460
.أختي، حلية الشّعر تلك جميلة

330
00:24:36,460 --> 00:24:38,280
!كان عليه إخبارها بذلك مباشرة

331
00:24:38,280 --> 00:24:41,200
دعونا من سيجي الآن، حان الوقت
.العرض المسبق للحلقة القادمة

332
00:24:41,200 --> 00:24:45,120
يأخذ تاجر تحف فنّيّة معيّن
.استشارة سيجي وأوكو

333
00:24:45,120 --> 00:24:49,260
ومع نهاية كلّ يوم، تتغيّر الصّورة
.على اللّفيفة المعلّقة

334
00:24:49,260 --> 00:24:53,050
:"الفصل الثّاني من "نحن نأجّر تسوكوموغامي
".(كوتشيناشي (غاردينيا"