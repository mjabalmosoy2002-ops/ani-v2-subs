1
00:00:05,120 --> 00:00:07,360
.حيّ فوكاغاوا في فترة إيدو

2
00:00:07,850 --> 00:00:10,430
إنّه المكان الّذي يتواجد فيه
.محلّ إجارة يُدعى إيزومو-يا

3
00:00:11,690 --> 00:00:15,150
"قد يبدو مصطلح "إجارة
،قديم الطّراز على ما أظنّ

4
00:00:15,150 --> 00:00:21,870
،لكن في المصطلحات الحديثة
.ربّما يمكنكم تسميه محلّ تأجير

5
00:00:22,410 --> 00:00:25,220
إنّه محلّ تأجير تحف حيث يمكنكم
العثور على أيّ شيء

6
00:00:25,220 --> 00:00:29,450
ابتداءً من الضّروريّات اليوميّة
.وصولاً للتّحف القديمة والفنّيّة

7
00:00:29,970 --> 00:00:32,250
.شكرًا على عملك

8
00:00:32,250 --> 00:00:38,200
ولكن، انتشرت إشاعات تقول إنّ محلّ
.إيزومو-يا لا يشبه أيّ محلّ تأجير آخر

9
00:00:38,200 --> 00:00:43,050
إنّ إيزومو-يا عبارة عن محلّ إعارة
.يمكن استعارة التسوكوموغامي منه

10
00:00:43,050 --> 00:00:44,220
أرأيتم؟ أرأيتم؟

11
00:00:44,220 --> 00:00:47,330
!لقد استعار أفضل هاوري في المحلّ

12
00:00:47,330 --> 00:00:49,800
على الأرجح أنّه سيذهب
.إلى يوشيوارا به فحسب

13
00:00:49,800 --> 00:00:52,270
.أنا واثق أنّها ستكون ليلة ممتازة

14
00:00:55,680 --> 00:00:58,740
إنّ ذلك المكان غير لائق أبدًا مقارنة

15
00:00:58,740 --> 00:01:01,300
بالولائم الّتي يقيمها الحاكم
.الإقطاعيّ والنّبلاء في كيوتو

16
00:01:01,790 --> 00:01:05,700
أنت تدقّق كثيرًا فقط لأنّك ذهبت للكثير
.من الولائم يا تسوكويومي

17
00:01:05,700 --> 00:01:06,970
.بالطّبع

18
00:01:07,620 --> 00:01:09,290
.هذا هو تسوكويومي

19
00:01:09,290 --> 00:01:14,020
إنّه أجود تسوكوموغامي اللّفائف
.المعلّقة في إيزومو-يا

20
00:01:14,640 --> 00:01:20,750
اللّفائف المعلّقة أدوات مهمّة لتزيين
حفلات الشّاي وما شابه

21
00:01:20,750 --> 00:01:24,140
.لإظهار جودة حسّ المضيف الثّقافي والجماليّ

22
00:01:25,310 --> 00:01:29,470
مراسم الشّاي والاحتفاليّات والمهرجانات
...الموسميّة وأيّام مشاهدة الزّهور

23
00:01:29,470 --> 00:01:33,910
.أنا أزيّن أكثر الولائم أناقة

24
00:01:34,690 --> 00:01:35,940
...المعذرة

25
00:01:35,940 --> 00:01:37,310
.مرحبًا

26
00:01:38,290 --> 00:01:40,480
أيّ نوع من الأغراض تبحث عنه؟

27
00:01:40,850 --> 00:01:43,330
.كلاّ، أنا لست زبونًا

28
00:01:43,330 --> 00:01:45,840
.جئت طالبًا مساعدتكما

29
00:01:46,240 --> 00:01:47,490
مساعدة؟

30
00:01:48,000 --> 00:01:52,190
في الحقيقة، تتغيّر الرّسومات على
.بعض لفائفي المعلّقة في اللّيل

31
00:01:52,190 --> 00:01:54,870
.كنتُ آمل أن تتمكّن من حلّ هذا اللّغز

32
00:01:57,450 --> 00:02:00,230
الرّسومات على اللّفائف المعلّقة تتغيّر؟

33
00:03:32,880 --> 00:03:35,530
.أنا هاماماتسويا سويمون

34
00:03:35,530 --> 00:03:37,510
.أنا أتاجر بالتّحف القديمة

35
00:03:37,870 --> 00:03:43,290
سمعتُ أنّه يمكنكما حلّ أيّ نوع
.من القضايا الصّعبة بسهولة

36
00:03:43,880 --> 00:03:46,770
هل أنتما على استعداد لسماع قصّتي؟

37
00:03:46,770 --> 00:03:48,680
ماذا نفعل يا أختي؟

38
00:03:48,680 --> 00:03:51,500
.يبدو هذا وكأنّه سيكون قضيّة مزعجة أخرى

39
00:03:51,500 --> 00:03:52,890
.بالطّبع

40
00:03:52,890 --> 00:03:56,280
سأطلب من أخي سيجي
.أن يذهب لمنزلك لإلقاء نظرة

41
00:03:57,570 --> 00:03:58,790
...أختي

42
00:04:12,200 --> 00:04:13,770
.من هنا تمامًا

43
00:04:20,070 --> 00:04:21,820
.لديّ هذه هنا

44
00:04:24,220 --> 00:04:26,910
لديك مجموعة ممتازة من الرّسومات
.واللّفائف المعلّقة القديمة

45
00:04:27,370 --> 00:04:33,120
هذه هي مختلف الأغراض الّتي تمّ توريثها
.لي من سَلفي... بل ومن سلفه قبل ذلك

46
00:04:33,890 --> 00:04:36,590
هذا هيكارو غينجي، صحيح؟

47
00:04:36,590 --> 00:04:39,350
.تواجده في رسمة مع نمر يجعلها غير عاديّة

48
00:04:39,350 --> 00:04:42,560
.حسنًا، لقد كانت رسمة لكاتو كيوماسا في الأصل

49
00:04:42,870 --> 00:04:44,120
.وهذه ليست الوحيدة

50
00:04:46,140 --> 00:04:49,720
ميناموتو نو يوشيتسوني في حضرة
كلب وقرد وطائر تدرج أخضر؟

51
00:04:50,640 --> 00:04:53,340
لكن تلك الخوذة... إنّه السّيّد كاتو كيوماسا؟

52
00:04:53,340 --> 00:04:55,890
لماذا هو رفقة طائر كركيّ بدل نمر؟

53
00:04:56,640 --> 00:05:01,220
مؤخّرًا عند حلول اللّيل، تتغيّر
.الرّسومات على اللّفائف المعلّقة

54
00:05:01,220 --> 00:05:02,760
لماذا قد تتغيّر؟

55
00:05:02,760 --> 00:05:07,370
لستُ واثقًا. ربّما هنالك من يقوم
.بمقلب ما أو أنّ هذا من صنيع شبح

56
00:05:07,980 --> 00:05:11,590
.أودّ منك أن تكتشف السّبب

57
00:05:12,550 --> 00:05:14,960
،إن كان أحدًا ما يقوم بمقلب

58
00:05:14,960 --> 00:05:18,320
.فذلك يعني أنّه يتسلّل للمحلّ ليلاً

59
00:05:18,320 --> 00:05:20,480
لن أكون قادرًا على النّوم بهناء
.إن كان الأمر كذلك

60
00:05:20,480 --> 00:05:22,820
.عليّ استعادة اللّفائف الحقيقيّة

61
00:05:24,080 --> 00:05:28,370
،لكن إن كان هذا من صنيع شبح
.فستحتاج هذه اللّفائف للتّطهير

62
00:05:28,940 --> 00:05:32,570
،تمّ توريث هذه الأغراض في عائلتي لعدّة أجيال

63
00:05:32,570 --> 00:05:34,380
.لا أستطيع التّخلّي عنها ببساطة

64
00:05:34,380 --> 00:05:39,890
،هذه قضيّة غريبة بالفعل
لكن لماذا أتيت لنا للمساعدة؟

65
00:05:40,730 --> 00:05:45,650
لقد أوصاني بكما الابن الثّاني
.لعائلة ساكوما، كاتسوسابورو-ساما

66
00:05:47,010 --> 00:05:48,410
...عرفتُ ذلك

67
00:05:48,990 --> 00:05:50,320
.سأكافئك بسخاء

68
00:05:50,320 --> 00:05:53,140
أرجوك، هلاّ قبلت بطلبي؟

69
00:05:54,610 --> 00:05:56,200
.هكذا سار الأمر

70
00:05:56,200 --> 00:06:01,160
بصراحة، لقد تمّ إقحامنا في شيء غريب
.ثانية الفضل يعود لكاتسوسابورو-ساما

71
00:06:02,680 --> 00:06:06,060
لا بدّ أنّ صيتنا قد ذاع كثيرًا

72
00:06:06,060 --> 00:06:09,260
ما دام هنالك من يوصي بنا لتاجر
.تحف قديمة متميّز مثله

73
00:06:09,260 --> 00:06:12,170
.ما كنت لأحبّ أن يذيع صيتنا هكذا

74
00:06:12,170 --> 00:06:16,570
كما أنّه كيف أمكنك إرسالي إلى محلّ
هاماماتسويا بتلك السّهول يا أختي؟

75
00:06:17,240 --> 00:06:19,090
.الأمر ليس بتلك الأهمّيّة في الحقيقة

76
00:06:19,090 --> 00:06:21,930
إضافة لذلك، ما الّذي ستفعله؟
.أعرف أنّ لديك فكرة ما

77
00:06:24,800 --> 00:06:26,190
...أنت على حقّ

78
00:06:26,540 --> 00:06:31,360
لن يقوم سيجي بإعارتنا لتاجر التّحف
القديمة ذاك، صحيح؟

79
00:06:31,360 --> 00:06:35,700
!نعم! نعم! سنكتشف حينها من خلف كلّ هذا

80
00:06:36,360 --> 00:06:38,980
لا يرى المرء شيئًا غريبًا

81
00:06:38,980 --> 00:06:42,450
مثل تغيّر رسم لفيفة معلّقة
.أو لوحة ما كلّ يوم

82
00:06:42,450 --> 00:06:44,450
.حسنًا، أظنّك محقّة

83
00:06:44,890 --> 00:06:47,190
.جيّد، حُلّت المسألة إذًا

84
00:06:47,190 --> 00:06:52,360
سيتمّ إعارتنا لهاماماتسويا معًا
هذه المرّة. أهذا جيّد؟

85
00:06:52,690 --> 00:06:55,500
يبدو أنّ للأمر علاقة بالعديد
،من اللّفائف المعلّقة والرّسومات

86
00:06:55,500 --> 00:06:57,980
ألا يعني هذا أنّنا سنحتاج لتسوكويومي؟

87
00:06:58,410 --> 00:07:01,800
ليس من طبيعتي أن أتورّط
،في قضايا مزعجة كهذه

88
00:07:01,800 --> 00:07:03,980
.لكن ما باليد حيلة، سأرافقكم

89
00:07:05,660 --> 00:07:06,490
ما هذه؟

90
00:07:07,110 --> 00:07:10,480
عليّ استعارة كلّ هذه التّحف؟

91
00:07:11,110 --> 00:07:14,830
،ردًّا على استماعنا لطلبك

92
00:07:14,830 --> 00:07:17,790
.نودّ منك أن تستعير تحفنا كتجربة

93
00:07:18,860 --> 00:07:22,500
.فهمت. حسنًا، أظنّ أنّ لا خيار لديّ إذًا

94
00:07:22,890 --> 00:07:23,950
.سأستعيرها

95
00:07:24,350 --> 00:07:26,500
.لدينا طلب آخر أيضًا

96
00:07:29,110 --> 00:07:33,250
.نودّ منك أن تعثر على مبخرة تحمل اسم سوو

97
00:07:34,130 --> 00:07:35,510
سوو؟

98
00:07:35,510 --> 00:07:36,960
—أختي، ما الّذي

99
00:07:36,960 --> 00:07:38,510
.الزم الصّمت يا سيجي

100
00:07:39,100 --> 00:07:40,260
ما قولك؟

101
00:07:40,740 --> 00:07:42,970
.أنا تاجر تحف قديمة

102
00:07:42,970 --> 00:07:47,440
.العثور على مبخرة أو مبخرتين ليس بالأمر الصّعب

103
00:07:47,440 --> 00:07:49,080
.سوف أبحث في الأمر

104
00:07:49,080 --> 00:07:50,710
.شكرًا جزيلاً لك

105
00:07:55,050 --> 00:07:55,950
.أختي

106
00:07:56,630 --> 00:07:57,550
ماذا؟

107
00:07:58,140 --> 00:08:03,030
هل يعقل أنّ سبب استماعك
...لطلب هاماماتسويا هو

108
00:08:06,010 --> 00:08:08,350
.لا، لا تهتمّي

109
00:08:12,470 --> 00:08:13,810
ما باله؟

110
00:08:23,160 --> 00:08:26,980
هل سمعتم ما قالته أوكو هذا المساء؟

111
00:08:26,980 --> 00:08:28,340
!سمعت! سمعت

112
00:08:28,340 --> 00:08:31,220
.ما زال وضع سوو يؤثّر عليها قبل كلّ شيء

113
00:08:31,730 --> 00:08:35,520
ألا يجب علينا أن نركّز على الرّسومات
المتغيّرة الآن بدلاً من أوكو؟

114
00:08:35,880 --> 00:08:38,840
.يبدو أنّ هنالك وافدين جدد

115
00:08:38,840 --> 00:08:39,950
من هناك؟

116
00:08:40,770 --> 00:08:42,950
!أنا ميناموتو نو يوشيتسوني

117
00:08:43,480 --> 00:08:47,820
!سأعاقبكم أيّها الأشرار لاقتحامكم هذا المحلّ

118
00:08:47,820 --> 00:08:49,460
!انتظر لحظة

119
00:08:49,960 --> 00:08:55,470
أنا كاتو كيوماسا، أكثر كفاءة منك
.لمعاقبة هؤلاء الأشرار وحدي

120
00:08:55,470 --> 00:08:58,650
ميناموتو نو يوشيتسوني وكاتو كيوماسا؟

121
00:08:58,650 --> 00:08:59,890
!مهلاً لحظة

122
00:08:59,890 --> 00:09:02,910
!لم نقتحم المكان

123
00:09:02,910 --> 00:09:04,490
!لا طائل تحت حديثكم

124
00:09:04,490 --> 00:09:06,140
.كم هذا همجيّ

125
00:09:06,140 --> 00:09:06,970
!ماذا؟

126
00:09:07,430 --> 00:09:11,480
.نلت كفايتي من الأوغاد سيّئي المزاج مثلكما

127
00:09:11,950 --> 00:09:14,990
.وخاصّة في حضرة امرأة جميلة

128
00:09:16,730 --> 00:09:19,060
.اعذري ذلكما الأبلهين الهمجيّين رجاءً

129
00:09:19,490 --> 00:09:20,810
!اللّعنة عليك يا هيكارو غينجي

130
00:09:20,810 --> 00:09:23,330
كيف تجرؤ على نعتنا بالهمجيّين
!يا زير النّساء المثير للشّفقة؟

131
00:09:23,600 --> 00:09:28,760
أنا لا أغوي النّساء، لا هنّ من يقعن
.ضحيّة لجاذبيّتي بمفردهنّ

132
00:09:28,760 --> 00:09:30,900
هل أنت بخير يا أوهيمي؟

133
00:09:29,050 --> 00:09:30,900
!كيف تجرؤ؟

134
00:09:30,900 --> 00:09:33,900
تُعجب النّساء بالرّجال ذوي القوّة
!العسكريّة الأفضل مثلي

135
00:09:30,900 --> 00:09:33,990
.نعم. لا أطيق أبدًا هكذا رجال

136
00:09:33,990 --> 00:09:35,240
فعلاً؟

137
00:09:35,240 --> 00:09:39,020
.لا توجد امرأة قيد الحياة قد ترفض دعوتي

138
00:09:39,460 --> 00:09:40,640
!هذا مثير للاهتمام

139
00:09:40,640 --> 00:09:43,220
حسنًا، إن تمكّنت من الحصول
،على اهتمام هذه المرأة

140
00:09:43,220 --> 00:09:46,020
!فذلك يعني أنّني الرّجل الأفضل

141
00:09:46,020 --> 00:09:50,340
!ما هذا الغباء؟
!لا يوجد رجل أفضل منّي

142
00:09:50,340 --> 00:09:53,240
!سنحسم هذه المسألة مرّة واحدة وإلى الأبد

143
00:09:53,240 --> 00:09:54,900
!أنا أوافقك

144
00:09:54,900 --> 00:09:59,540
سيُحسم من منّا الرّجل الأفضل ونضع حدًّا
!لهذا الصّراع اليوم قبل طلوع الشّمس

145
00:10:00,320 --> 00:10:02,120
ما بالهم؟

146
00:10:02,510 --> 00:10:04,720
.فهمت. أمسى كلّ شيء واضحًا الآن

147
00:10:05,180 --> 00:10:10,780
إنّهم تسوكوموغامي من الرّسومات على
.اللّفائف المعلّقة واللّوحات، مثلي تمامًا

148
00:10:11,320 --> 00:10:15,330
وفي اللّيل، لا بدّ أنّ أماكنهم تتغيّر بالكامل

149
00:10:15,330 --> 00:10:18,310
.بعد قتالهم لبعضهم لتحديد من الأفضل بينهم

150
00:10:18,310 --> 00:10:22,800
إنّهم منهمكون في الصّراع بينهم لدرجة
،أنّهم لا يلاحظون أنّ الصّباح قد حلّ

151
00:10:22,800 --> 00:10:27,800
لذلك عند دخول أحد ما للمحلّ، يهرعون
.بالعودة إلى أيّ كتاب أو لفيفة معلّقة

152
00:10:27,800 --> 00:10:29,490
!فعلاً! فعلاً

153
00:10:29,490 --> 00:10:32,430
.لقد قالوا فعلاً أنّهم سيحسمون الأمر اليوم

154
00:10:32,430 --> 00:10:33,740
وماذا بعد إذًا؟

155
00:10:33,740 --> 00:10:38,150
تتغيّر الرّسومات على اللّفائف المعلّقة
لأنّ التسوكوموغامي

156
00:10:38,150 --> 00:10:41,900
يعودون إلى اللّفائف المعلّقة الخطأ
بدون انتباه وعلى عجل؟

157
00:10:41,900 --> 00:10:43,070
!هذا مضحك

158
00:10:43,070 --> 00:10:44,790
.هذه ليست مسألة مضحكة

159
00:10:44,790 --> 00:10:49,360
ما كنتُ لأقبل بالأمر إن دخل هؤلاء
.الحمقى إلى لفيفتي

160
00:10:49,590 --> 00:10:52,320
ماذا؟ هؤلاء الحمقى؟

161
00:10:53,580 --> 00:10:55,340
.حسنًا، انظروا من يتكلّم

162
00:10:55,340 --> 00:10:57,720
بالنّظر إليك، يمكنني الجزم
،أنّك لفيفة معلّقة مثلنا

163
00:10:57,720 --> 00:11:00,600
.لكنّك تسوكوموغامي لرسمة لمنظر طبيعيّ

164
00:11:00,600 --> 00:11:03,580
لا نريد رؤية تصرّف متعالٍ كهذا

165
00:11:03,580 --> 00:11:06,340
صادر من رسمة منظر طبيعيّ
.مملّ وبشع مثلك

166
00:11:07,360 --> 00:11:08,610
!صحيح! صحيح

167
00:11:08,610 --> 00:11:10,570
!أنت رسمة فارغة وغير معبّرة

168
00:11:10,570 --> 00:11:12,600
!أنت غير راقٍ بتاتًا

169
00:11:17,670 --> 00:11:19,600
!نحن في ورطة! نحن في ورطة

170
00:11:19,600 --> 00:11:22,170
!سوف ينفجر

171
00:11:22,170 --> 00:11:25,480
.حـ-حسنًا، لقد حُلّت هذه المسألة

172
00:11:25,480 --> 00:11:27,270
من سيهدّئ تسوكويومي؟

173
00:11:27,270 --> 00:11:28,620
!هدّئه أنت يا غوي

174
00:11:29,510 --> 00:11:31,050
!هذا مؤلم

175
00:11:31,050 --> 00:11:33,220
.الـ-المعذرة يا تسوكويومي

176
00:11:33,220 --> 00:11:35,870
...لماذا لا تحاول أن تهدأ قليلاً

177
00:11:39,030 --> 00:11:40,680
.أنت، أنت

178
00:11:40,680 --> 00:11:44,220
هلاّ صمتّم جميعًا؟

179
00:11:56,080 --> 00:11:59,240
.أنا لا أحبّ الضّوضاء

180
00:12:07,520 --> 00:12:10,010
.كانت ليلة البارحة مميّزة بالفعل

181
00:12:10,010 --> 00:12:13,260
كانت تلك أوّل مرّة أرى فيها منافسة
.مصارعة سومو للتسوكوموغامي

182
00:12:13,780 --> 00:12:18,940
هل سبق ورأيتم لفيفة معلّقة يمارس فيها
موموتارو وهيكاري غينجي مصارعة السّومو؟

183
00:12:19,240 --> 00:12:21,750
،ولكن، ولكن، مع ذلك

184
00:12:21,750 --> 00:12:28,370
لماذا يتقاتل أولئك التسوكوموغامي
لتحديد من الأفضل في المحلّ؟

185
00:12:28,370 --> 00:12:31,260
.ربّما يكون السّبب هو تلك التسوكوموغامي المرأة

186
00:12:31,260 --> 00:12:34,260
تسوكوموغامي امرأة؟ تلك؟

187
00:12:35,030 --> 00:12:38,180
.أنا لا أحبّ الضّوضاء

188
00:12:38,520 --> 00:12:43,900
ممّا يعني أنّ الرّجال يتشاجرون مع
بعضهم لجذب انتباه امرأة واحدة؟

189
00:12:45,170 --> 00:12:48,530
على الأرجح أنّ الأمر لن ينتهي على خير
.إن تدخّلنا أكثر من هذا

190
00:12:48,530 --> 00:12:51,150
من هي على أيّ حال؟

191
00:12:51,150 --> 00:12:54,290
إنّها تحدّق في الخارج دائمًا
.دون أن ترى أيّ شيء

192
00:12:54,290 --> 00:12:56,060
ما رأيك يا تسوكويومي؟

193
00:12:56,830 --> 00:12:57,920
.لا أهتمّ

194
00:12:58,670 --> 00:13:00,690
.أنت تتصرّف بغرابة

195
00:13:00,690 --> 00:13:05,810
حتّى أنّك لم تردّ عندما كان تسوكوموغامي
.هاماماتسويا يذمّونك ليلة البارحة

196
00:13:06,140 --> 00:13:07,790
.ذلك ليس مهمًّا

197
00:13:07,790 --> 00:13:09,270
.لا تشغلوا بالكم بي

198
00:13:18,750 --> 00:13:20,560
ماذا نفعل يا أختي؟

199
00:13:20,940 --> 00:13:22,900
اللّفائف المعلّقة هي تسوكوموغامي

200
00:13:22,900 --> 00:13:26,330
يتقاتلون فيما بينهم من أجل تسوكوموغامي
.امرأة، وتتغيّر الرّسومات بسبب ذلك

201
00:13:26,330 --> 00:13:30,310
.من المستحيل أن يصدّق سويمون-سان أيًّا من هذا

202
00:13:30,310 --> 00:13:33,060
.كلّ ما يمكننا فعله هو إخباره بالحقيقة

203
00:13:33,860 --> 00:13:37,200
والأهمّ من ذلك، يتصرّف أحد
،التسوكوموغامي خاصّتنا بغرابة

204
00:13:37,200 --> 00:13:38,830
وذلك ما أنت قلق بشأنه؟

205
00:13:38,830 --> 00:13:44,340
هذا ما تقولينه، لكن لا يمكنني التّخيّل
.أنّ لفيفة معلّقة لديها ما تقلق بشأنه

206
00:13:44,340 --> 00:13:46,200
.هذا قاسٍ

207
00:13:46,200 --> 00:13:49,590
عليك أن تحاول رؤية الأمور
.من وجهة نظر التسوكوموغامي

208
00:13:49,590 --> 00:13:52,770
لن تتمكّن أبدًا من فهم مشاعر
.شخص آخر بسلوكك هذا

209
00:14:01,520 --> 00:14:04,110
.من هنا يا سيجي. شكرًا على قدومك

210
00:14:04,690 --> 00:14:07,530
هل تسير الأمور على ما يرام مع ساناي-سان؟

211
00:14:07,530 --> 00:14:09,620
.لستُ واثقًا ممّا قد تصفه بعلى ما يرام

212
00:14:11,170 --> 00:14:15,980
.ذهبنا ذات يوم معًا إلى ضريح توميوكا هاتشيمان

213
00:14:16,390 --> 00:14:18,280
.سررت بسماعي لذلك

214
00:14:19,330 --> 00:14:21,640
كيف أمورك أنت يا سيجي؟

215
00:14:23,620 --> 00:14:27,120
هل اكتشفت أيّ شيء بشأن
ما يحدث في محلّ سويمون؟

216
00:14:27,120 --> 00:14:30,210
.ذلك ما قصدته بسؤالك إذًا

217
00:14:30,210 --> 00:14:32,960
.لسوء الحظّ، ما زلنا لم نحلّ القضيّة بعد

218
00:14:33,750 --> 00:14:36,740
ولكن، لماذا استدعيتني إلى هنا اليوم؟

219
00:14:37,780 --> 00:14:41,130
لقد دعوت حموّي من عائلة هاتشيا

220
00:14:41,130 --> 00:14:43,700
،وساناي لحفلة شاي عمّا قريب

221
00:14:44,220 --> 00:14:47,150
.لكنّني لستُ راضيًا بأواني الشّاي الّتي لديّ

222
00:14:48,700 --> 00:14:52,710
هل هنالك مزهريّة ما في إيزومو-يا
قد تناسب هذه اللّفيفة المعلّقة؟

223
00:14:53,620 --> 00:14:55,660
هل قلتَ مزهريّة؟

224
00:14:56,070 --> 00:14:58,770
.سوف أقوم إذًا باختيار شيء ما حسب ذوقي

225
00:14:59,120 --> 00:15:00,420
.شكرًا لك

226
00:15:00,780 --> 00:15:03,910
هل تستضيف حفلات الشّاي
يا كاتسوسابورو-ساما؟

227
00:15:04,350 --> 00:15:06,140
.أنا أستمتع بها لحدّ معيّن

228
00:15:06,140 --> 00:15:09,290
إذًا هل أنت ضليع في اللّفائف المعلّقة؟

229
00:15:09,770 --> 00:15:13,150
.ليس على وجه التّحديد
.لديّ معرفة طفيفة بها فحسب

230
00:15:13,730 --> 00:15:17,810
إن كانت لفيفة معلّقة ما منزعجة
لسبب من الأسباب، فماذا قد يكون؟

231
00:15:18,170 --> 00:15:20,030
لفيفة معلّقة منزعجة؟

232
00:15:20,510 --> 00:15:22,340
.أنت تقول أشياء غريبة

233
00:15:22,670 --> 00:15:26,190
.كلاّ، هذا خطئي. ذلك ليس ما قصدته

234
00:15:27,000 --> 00:15:30,550
.لدينا غرض يسمّى لفيفة البدر المعلّقة

235
00:15:30,550 --> 00:15:33,020
ما المعنى خلفها في رأيك؟

236
00:15:33,450 --> 00:15:37,020
.لفيفة بدر معلّقة؟ بالكاد رأيت شيئًا مشابهًا

237
00:15:37,410 --> 00:15:39,870
هل يجعلها ذلك نادرة إذًا؟

238
00:15:42,400 --> 00:15:44,350
إنّها لا تُستعمل إلاّ نادرًا؟

239
00:15:45,310 --> 00:15:47,100
.نعم، هذا صحيح

240
00:15:48,850 --> 00:15:53,480
تُستعمل اللّفائف المعلّقة خلال
.حفلات الشّاي لإمتاع الضّيوف

241
00:15:55,170 --> 00:15:59,740
قد تتغيّر رسومات اللّفائف المعلّقة
.لتناسب الموسم أو الهدف من المأدبة

242
00:16:00,320 --> 00:16:05,470
ومع ذلك، يمكن لحساسيّات المضيف
.وما يفضّله أن تلعب دورًا في اتّخاذ القرار

243
00:16:06,490 --> 00:16:10,850
يُستعمل تصميم البدر في اللّفائف
.المعلّقة خلال الخريف

244
00:16:11,420 --> 00:16:15,760
ومع ذلك، ما كنتُ لأعلّق
.رسمة بدر خلال حفل نهاريّ

245
00:16:16,280 --> 00:16:20,920
سيبدو الأمر غريبًا قليلاً إن عُلّقت
.رسمة بدر خلال النّهار

246
00:16:21,430 --> 00:16:24,380
إذًا، هل سيكون شيئًا قد
تستخدمه خلال حفل مسائيّ؟

247
00:16:26,790 --> 00:16:28,290
.لا أظنّ ذلك

248
00:16:29,490 --> 00:16:32,750
تعمّد تزيين مكان ما برسمة القمر عندما يكون

249
00:16:32,750 --> 00:16:35,500
جمال القمر الحقيقيّ حاضرًا
.في سماء اللّيل قد يكون غريبًا

250
00:16:41,010 --> 00:16:42,520
!صحيح

251
00:16:42,940 --> 00:16:49,070
نعم، ربّما يعني هذا أنّ تسوكويومي بالكاد
.استُعمل من طرف مالكه كلفيفة معلّقة

252
00:16:50,430 --> 00:16:53,530
...إذًا فكلّ تلك الأشياء الّتي قالها تسوكويومي

253
00:16:53,530 --> 00:16:57,690
مراسم الشّاي والاحتفاليّات والمهرجانات
...الموسميّة وأيّام مشاهدة الزّهور

254
00:16:57,690 --> 00:17:02,280
.أنا أزيّن أكثر الولائم أناقة

255
00:17:02,820 --> 00:17:05,090
كان كلّ ذلك كذبة؟

256
00:17:05,090 --> 00:17:06,290
.ذلك محتمل

257
00:17:07,070 --> 00:17:10,780
،بالكاد كان تسوكويومي يُستعمل من مالكه

258
00:17:11,240 --> 00:17:13,100
،وامتلاك عقدة نقص بسبب ذلك

259
00:17:13,100 --> 00:17:16,310
أدّى به للتّصرّف بتعالٍ وفخر
.وقال كلّ تلك الأمور الّتي لم تحدث

260
00:17:18,540 --> 00:17:24,320
ذلك هو السّبب الّذي دفع اللّفائف المعلّقة
.في محلّ سويمون-سان لتسخر منه

261
00:17:26,380 --> 00:17:29,800
ربّما نحن هم المخطئون لإعارتنا تسوكويومي

262
00:17:29,800 --> 00:17:33,010
.لحلّ هذا الطّلب الّذي قبلناه

263
00:17:37,130 --> 00:17:39,470
.أوهانا-تشان، الفاتورة لو سمحت

264
00:17:39,470 --> 00:17:40,680
.في الحال

265
00:17:40,680 --> 00:17:42,970
.صحنا حساء فاصولياء حمراء حلوة بثمانية مون

266
00:17:59,580 --> 00:18:01,020
!ماذا؟

267
00:18:01,020 --> 00:18:05,280
ماذا تقصد بأنّنا سنقمع التسوكوموغامي
في محلّ هاماماتسويا؟

268
00:18:05,280 --> 00:18:07,030
ألن ننسحب؟

269
00:18:07,030 --> 00:18:09,030
...بشأن ذلك

270
00:18:09,760 --> 00:18:13,370
ربّما نحن هم المخطئون لإعارتنا تسوكويومي

271
00:18:13,370 --> 00:18:16,680
.لحلّ هذا الطّلب الّذي قبلناه

272
00:18:17,210 --> 00:18:19,280
...كيف أصف الأمر... حسنًا

273
00:18:19,280 --> 00:18:21,350
!لا يمكننا الانسحاب الآن

274
00:18:21,350 --> 00:18:23,490
!سيكون من الخطأ إن فعلنا

275
00:18:23,490 --> 00:18:26,040
أوافقك الرّأي، لكن ما العمل؟

276
00:18:26,360 --> 00:18:28,540
.التسوكوموغامي المرأة

277
00:18:29,280 --> 00:18:32,710
علينا أن نقنع تلك التسوكوموغامي المرأة

278
00:18:32,710 --> 00:18:36,190
.لتضع حدًّا لتسوكوموغامي هاماماتسويا

279
00:18:36,190 --> 00:18:41,190
قد تكون على حقّ، لكن لا يبدو
.أنّها قد تستمع إلينا

280
00:18:41,190 --> 00:18:42,550
.مهلاً، مهلاً

281
00:18:42,550 --> 00:18:46,670
ما الأشياء الّتي تحنّ لها امرأة ما
عندما تحدّق في الخارج؟

282
00:18:48,120 --> 00:18:50,820
.على الأرجح عندما تفكّر في شخص ما

283
00:18:51,660 --> 00:18:55,870
تمامًا مثل ما تفعل أوكو عندما تفكّر بسوو؟

284
00:18:56,200 --> 00:18:58,600
.عليك أن تتوقّفي عن الحديث عن ذلك يا أوساغي

285
00:18:58,600 --> 00:19:00,190
لماذا؟ لماذا؟

286
00:19:05,660 --> 00:19:09,950
تذكّرت، عليّ أخذ مزهريّة
.إلى منزل كاتسوسابورو-ساما

287
00:19:14,100 --> 00:19:15,580
!وجدتُها

288
00:19:16,370 --> 00:19:18,340
لا يمكن مشاهدة أيّ شيء من النّافدة

289
00:19:18,340 --> 00:19:20,700
في مخزن سويمون-سان
!لأنّ الأشجار تعترض الطّريق

290
00:19:21,570 --> 00:19:22,920
ماذا تقصد؟

291
00:19:27,790 --> 00:19:31,490
أرغب منك أن تعلّق هذه
.في المكان الّذي تحدّثنا عنه

292
00:19:32,260 --> 00:19:35,490
،إن سار الأمر على ما يرام
.آمل أن يحلّ هذا كلّ شيء

293
00:19:35,490 --> 00:19:38,980
،حسنًا، لا أفهم ما يجري تمامًا
.لكنّني سأفعل ما طلبت

294
00:19:38,980 --> 00:19:40,480
.شكرًا جزيلاً لك

295
00:19:40,480 --> 00:19:41,730
...ذلك المكان

296
00:19:44,770 --> 00:19:47,940
!حسنًا، سوف نحسم المسألة اللّيلة بكلّ تأكيد

297
00:19:47,940 --> 00:19:49,240
!أنا موافق

298
00:19:55,250 --> 00:19:56,870
الأميرة كاغويا؟

299
00:20:01,620 --> 00:20:05,440
!يا لجمال القمر

300
00:20:08,060 --> 00:20:10,380
التسوكوموغامي المرأة في محلّ هاماماتسويا

301
00:20:10,380 --> 00:20:13,360
هي الأميرة كاغويا من أسطورة
."حكاية قاطع الخيزران"

302
00:20:14,930 --> 00:20:19,980
عندما زرت محلّ سويمون أوّل مرّة، رأيتُ
."أنّه يملك "حكاية قاطع الخيزران

303
00:20:21,830 --> 00:20:25,410
لقد تذكّرتها عندما كنت أخرج المزهريّة
.لآخذها إلى كاتسوسابورو-ساما

304
00:20:25,410 --> 00:20:28,420
لقد صُنعت تلك المزهريّة من الخيزران، صحيح؟

305
00:20:28,420 --> 00:20:33,170
كما أنّه لا يمكن رؤية أيّ شيء
.من نافذة مخزن محلّ هاماماتسويا

306
00:20:35,740 --> 00:20:40,670
كنتُ أنظر للأعلى لسماء اللّيل دائمًا
،وأنا أفكّر في القمر الّذي لا يمكنني رؤيته

307
00:20:43,500 --> 00:20:45,970
.لكنّ أمنيتي قد تحقّقت أخيرًا

308
00:20:46,440 --> 00:20:49,170
.والفضل يعود لذلك الشّخص الرّائع

309
00:20:50,190 --> 00:20:51,430
.شكرًا لك

310
00:20:54,870 --> 00:20:57,610
.لا يمكننا مجاراة القمر

311
00:20:57,610 --> 00:21:00,190
.علينا الاعتراف بهزيمتنا

312
00:21:06,440 --> 00:21:11,050
.أنا متفاجئ باعتراف أميرة بمدى عظمتي

313
00:21:11,050 --> 00:21:15,350
ولكنّني تسوكوموغامي من محلّ
.تأجير يُدعى إيزومو-يا

314
00:21:15,350 --> 00:21:17,930
لك كامل الحرّيّة باستدعائي
.في حالة ما إذا احتجتني ثانية

315
00:21:34,210 --> 00:21:37,730
عادت كلّ لفائفي المعلّقة إلى سابق
.عهدها والفضل لك

316
00:21:37,730 --> 00:21:39,280
.أنا أشكرك

317
00:21:39,280 --> 00:21:41,740
ما الخدعة الّتي استعملتها؟

318
00:21:42,540 --> 00:21:45,580
...لستُ واثقًا كيف أشرح الأمر

319
00:21:45,580 --> 00:21:48,060
.حسنًا، سأسألك عن الأمر مرّة أخرى لاحقًا

320
00:21:48,060 --> 00:21:50,610
...والآن، بشأن تلك اللّفيفة المعلّقة

321
00:21:50,610 --> 00:21:54,940
.شكرًا على استعمالها رغم أنّها ليست مفيدة كثيرًا

322
00:21:56,010 --> 00:21:58,260
!ليست مفيدة؟ على الإطلاق

323
00:21:58,640 --> 00:21:59,750
ماذا؟

324
00:21:59,750 --> 00:22:03,770
،مع أنّه من الصّعب استعمال لفيفة بدر معلّقة

325
00:22:03,770 --> 00:22:08,070
،لكن إن كان المالك لديه حسّ ثقافيّ وجماليّ عالٍ

326
00:22:08,070 --> 00:22:11,760
.فقد تكون غرضًا يمكن استعماله بأناقة

327
00:22:12,210 --> 00:22:14,030
أحقًّا ما تقول؟

328
00:22:14,420 --> 00:22:19,590
كما أنّه يمكن للّفائف المعلّقة القديمة
،أن تتلف عندما تُخزّن بشكل مهمل

329
00:22:19,590 --> 00:22:25,180
،لكنّ تلك اللّفيفة في حالة جيّدة
.وكأنّ لها مالكًا يقدّرها كثيرًا

330
00:22:25,180 --> 00:22:28,030
وبعد تحقيق عميق في التّوقيع
،على اللّفيفة المعلّقة

331
00:22:28,030 --> 00:22:32,250
.فقد صُنعت عندما كان عمّ كانو إيتوكو صغيرًا

332
00:22:32,530 --> 00:22:35,140
!بعبارات أخرى، إنّها لوحة من رسم كانو هيديوري

333
00:22:35,140 --> 00:22:37,030
!يجب الاهتمام بها بعناية

334
00:22:42,850 --> 00:22:44,410
.سوف أدفع لك الثّمن الّذي تستحقّ

335
00:22:44,410 --> 00:22:46,060
فهلاّ بعتني إيّاها؟

336
00:22:48,440 --> 00:22:50,420
.أنا آسف بشدّة

337
00:22:51,050 --> 00:22:54,970
إنّ هذا عبارة عن محلّ تأجير، لذلك
.سنسرّ بتأجيرها لك عندما تحتاجها

338
00:24:30,440 --> 00:24:33,560
زفاف ساناي-ساما لكاتسوسابورو-ساما
.قد تمّ التّرتيب له بنجاح

339
00:24:33,560 --> 00:24:35,870
وانتهازًا لهذه الفرصة، قيل لها أن تتخلّص
،من بعض مقتنياتها الشّخصيّة

340
00:24:35,870 --> 00:24:37,940
...وتذهب أختي لأخذها منها، ولكن

341
00:24:37,940 --> 00:24:41,750
بعد سماع قصّتها، بدا الأمر وكأنّها
.ليست على ما يرام مع والدتها

342
00:24:41,750 --> 00:24:43,390
!سيجي، عليك القيام بشيء ما

343
00:24:43,390 --> 00:24:46,760
...القول أسهل من الفعل
...ولكن يا أختي، حلية الشّعر تلك

344
00:24:46,760 --> 00:24:48,950
.لقد عهدت بها ساناي-ساما لي

345
00:24:48,950 --> 00:24:50,880
!يبدو أنّها تسوكوموغامي

346
00:24:50,880 --> 00:24:52,590
في الحلقة القادمة من
،"نحن نأجّر تسوكوموغامي"

347
00:24:52,590 --> 00:24:54,440
."الفصل الثّالث: "ناديشيكو