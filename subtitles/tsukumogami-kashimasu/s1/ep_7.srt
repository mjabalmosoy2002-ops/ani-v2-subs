1
00:00:00,930 --> 00:00:04,020
.أنا أوراها-ياناغي

2
00:00:04,020 --> 00:00:06,270
،كنتُ إنسانًا في الأصل

3
00:00:06,270 --> 00:00:09,000
وعندما متّ، كان ما زال لديّ عمل
،غير منتهٍ في هذا العالم

4
00:00:09,000 --> 00:00:11,290
.لذلك عدتُ لأتلبّس هذه المبخرة

5
00:00:11,290 --> 00:00:13,780
.إذًا فهناك تسوكوموغامي من هذا النّوع أيضًا

6
00:00:13,780 --> 00:00:17,280
حسنًا، حسنًا، ما هو عملك
غير المنتهي يا أوراها-ياناغي؟

7
00:00:17,870 --> 00:00:21,770
تمّ تخزيني في مستودع مذ
،أخذتُ هذه الهيئة

8
00:00:21,750 --> 00:00:24,790
،وعلى الأقلّ، أرغب في رؤية زوجتي المحبوبة

9
00:00:24,790 --> 00:00:27,290
الّتي تركتُها  في هذا العالم
.وحدها مرّة أخرى

10
00:00:27,790 --> 00:00:31,670
لماذا أتيتَ إلى هنا في محلّ إيزومو-يا إذًا؟

11
00:00:32,060 --> 00:00:35,130
كان الحريق الكبير منذ بضعة
.سنوات المحفّز لذلك

12
00:00:36,160 --> 00:00:40,500
.احترق نصف المنزل الّذي كنتُ فيه

13
00:00:40,510 --> 00:00:44,980
لحسن الحظّ، كنت في مأمن داخل
.ذلك المستودع طوال الوقت

14
00:00:45,390 --> 00:00:48,400
ولكن بهدف جمع المال، باع سكّان المنزل

15
00:00:48,400 --> 00:00:51,820
.ممتلكات مختلفة بدءًا بي أنا

16
00:00:52,230 --> 00:00:54,900
بعد ذلك، تمّ تمريري من مكان لآخر

17
00:00:54,900 --> 00:00:57,570
.إلى أن ابتاعني مالك هذا المحلّ ذات يوم

18
00:00:58,070 --> 00:01:00,320
لماذا أنت شارد يا سيجي؟

19
00:01:00,810 --> 00:01:03,400
أليس عليك لقاء كاتسوسابورو-ساما؟

20
00:01:03,400 --> 00:01:04,820
!هذا صحيح

21
00:01:08,660 --> 00:01:09,970
الحريق الكبير؟

22
00:02:42,760 --> 00:02:44,560
كان هنالك طبّاخ يافع في منزلي

23
00:02:44,560 --> 00:02:47,680
يُدعى توكوبي، لكنّه أصبح مكتفيًا بذاته

24
00:02:47,680 --> 00:02:50,810
.وقرّر أن يفتح محلّه الخاص

25
00:02:51,440 --> 00:02:55,720
فقد توكوبي عائلته قبل بضعة سنوات
.وكان يبذل قصارى جهده وحده

26
00:02:56,370 --> 00:02:58,780
.كما أنّه سيفتتح المحلّ بمفرده

27
00:02:58,780 --> 00:03:00,950
.لا بدّ أنّه شخص يستحقّ الإعجاب بالفعل

28
00:03:01,260 --> 00:03:03,680
.وأيضًا، أرغب بكلّ تأكيد أن أدعمه

29
00:03:03,660 --> 00:03:07,540
وبشأن ذلك الخصوص، يبدو أنّه قد
قام بدعوة معارفه إلى حفلة

30
00:03:07,540 --> 00:03:09,960
.ستكون أيضًا افتتاحًا لمتجره قريبًا

31
00:03:10,310 --> 00:03:14,500
هل سأكون قادرًا على استعارة بعض
الأغراض من إيزومو-يا لهذا الحدث؟

32
00:03:14,500 --> 00:03:16,010
.بالطّبع! سيكون ذلك من دواعي سرورنا

33
00:03:16,360 --> 00:03:19,600
.يمكنك إرسال كلّ الأتعاب إليّ

34
00:03:19,890 --> 00:03:24,080
مفهوم، وأين هو محلّه؟

35
00:03:24,080 --> 00:03:25,470
.في نيهونباشي

36
00:03:28,820 --> 00:03:30,240
نيهونباشي؟

37
00:03:35,550 --> 00:03:38,160
.حتّى نيهونباشي قد تغيّرت بالكامل

38
00:03:42,990 --> 00:03:44,130
...لا يعقل

39
00:03:56,100 --> 00:03:58,290
ساتارو-سان؟

40
00:04:08,560 --> 00:04:10,510
.اسمي هو تسورويا توكوبي

41
00:04:11,420 --> 00:04:16,700
إنّه لشرف كبير أن أتلقّى المساعدة
.من زميل أقدم منّي في إدارة محلّ

42
00:04:16,700 --> 00:04:19,020
.لا داعي رجاءً لكلّ هذه الرّسميّات

43
00:04:19,360 --> 00:04:24,880
،أنا لستُ مكتفيًا بذاتي بشكل كبير
.كما أنّ محلّي ليس بنفس روعة محلّك

44
00:04:25,280 --> 00:04:29,030
،المالك السّابق أوكومايا-سان

45
00:04:29,030 --> 00:04:32,040
.باعه لي بسعر لا يصدّق

46
00:04:32,370 --> 00:04:35,580
أنا ممتنّ لوجود أشخاص رائعين هكذا حولي

47
00:04:35,580 --> 00:04:38,540
.من كاتسوسابورو-ساما وأوكومايا-سان

48
00:04:41,040 --> 00:04:44,800
ستتحسّن الأمور بكلّ تأكيد هنا
.إن زيّنّا المكان بدمية الأميرة هذه

49
00:04:44,800 --> 00:04:47,110
ماذا عن اللّفائف المعلّقة؟

50
00:04:47,110 --> 00:04:50,220
أعتقد أنّ لديّ أشياء قد تناسب
.التّوكونوما الّتي لديك هنا

51
00:04:52,550 --> 00:04:55,130
.إنّها رسمة من كانو هيديوري

52
00:04:57,400 --> 00:05:00,580
.كان هنالك بدر جميل في ذلك اليوم أيضًا

53
00:05:00,910 --> 00:05:01,800
ذلك اليوم؟

54
00:05:02,170 --> 00:05:05,070
.اليوم الّذي اندلع فيه الحريق الكبير في نيهونباشي

55
00:05:06,570 --> 00:05:09,580
،في الحقيقة، أنا من نيهونباشي في الأصل

56
00:05:09,950 --> 00:05:14,080
.لكن بعد الحريق، قرّرت ترك المدينة

57
00:05:14,460 --> 00:05:16,290
.هكذا إذًا

58
00:05:16,590 --> 00:05:20,080
.ثمّ تحقّق أعزّ أمانِيّ وتمكّنت من العودة

59
00:05:20,090 --> 00:05:22,590
،وبفضلكما أنت وكاتسوسابورو-ساما

60
00:05:23,010 --> 00:05:25,090
.سأكون قادرًا على تقديم حفلة افتتاح رائعة

61
00:05:25,590 --> 00:05:28,090
.والآن، أستأذن للذّهاب

62
00:05:36,650 --> 00:05:39,990
لكنّ كاتسوسابورو-ساما قال
.إنّه سيفتتح المحلّ بمفرده

63
00:05:40,540 --> 00:05:42,890
.حسنًا، أعتقد أنّ عليه تعيين خادمة على الأقلّ

64
00:05:46,420 --> 00:05:47,860
.هذا المكان هادئ للغاية

65
00:05:48,200 --> 00:05:51,860
.هذا لأنّ أيّ بناء جديد سيمتلئ بالأغراض الجديدة

66
00:05:51,860 --> 00:05:54,170
.لن يتواجد هنا أيّ تسوكوموغامي

67
00:05:54,170 --> 00:05:56,120
.ماذا؟ ماذا؟ يبدو أنّ هنالك مستجدّين

68
00:05:56,860 --> 00:05:57,870
.هنالك واحد هنا

69
00:05:58,880 --> 00:05:59,870
!مرحى

70
00:06:00,830 --> 00:06:02,960
.اسمي نوري-غاراسو

71
00:06:02,960 --> 00:06:04,880
.من الأفضل تذكّر ذلك أيّها المستجدّان

72
00:06:04,880 --> 00:06:06,750
.نحن لسنا مستجدّان

73
00:06:06,750 --> 00:06:09,860
.أتينا إلى هنا من أجل حفلة المحلّ

74
00:06:09,860 --> 00:06:11,510
.نحن هنا للمساعدة

75
00:06:11,510 --> 00:06:13,390
.إذًا فثمّة تسوكوموغامي هنا أيضًا

76
00:06:13,390 --> 00:06:16,530
.حسنًا، لكنّني التسوكوموغامي الوحيد هنا

77
00:06:16,530 --> 00:06:19,940
لا بدّ إذًا أنّك كنت تشعر بالملل
.لعدم وجود من تتحدّث إليه

78
00:06:19,940 --> 00:06:21,900
!لم أشعر بالملل على الإطلاق

79
00:06:22,230 --> 00:06:24,400
.لديّ شخص أتحدّث إليه في الحقيقة

80
00:06:24,400 --> 00:06:26,020
إلى من تتحدّث؟

81
00:06:36,020 --> 00:06:38,000
!سيجي! سيجي

82
00:06:39,610 --> 00:06:41,340
!هنالك حريق في نيهونباشي

83
00:06:41,340 --> 00:06:42,160
!أختي

84
00:06:44,070 --> 00:06:46,060
!أختي! أيّها العمّ كيوبي

85
00:06:46,440 --> 00:06:47,830
!أختي

86
00:06:53,470 --> 00:06:55,550
!أختي! هل أنت بخير؟

87
00:06:56,150 --> 00:06:57,280
!سيجي

88
00:07:01,150 --> 00:07:03,220
.مرّ أسبوع على الحريق

89
00:07:03,220 --> 00:07:05,090
.أبي قلق عليك أيضًا

90
00:07:05,880 --> 00:07:09,610
أخبرني أن أجسّ نبضكما بخصوص
.المجيء إلى إيزومو-يا

91
00:07:11,160 --> 00:07:13,950
،أنا ممتنّة لعرضه

92
00:07:13,950 --> 00:07:18,330
.لكن لا يمكنني التّخلّي عن المحلّ المحترق

93
00:07:19,180 --> 00:07:22,540
لكن بعد قولي لهذا، أدركت
...أنّه لم يعد لي أيّ شيء

94
00:07:26,220 --> 00:07:27,860
حلية شعر كرويّة؟

95
00:07:27,860 --> 00:07:30,310
.لقد استبدلت ذلك المشط بها

96
00:07:31,630 --> 00:07:33,640
،إن بعتِ هذه الحلية

97
00:07:33,640 --> 00:07:37,010
ستكونين قادرة على الحصول على أكثر
.من ثمانين ريو حتّى إن قمتِ بصفقة ما

98
00:07:37,010 --> 00:07:38,460
!ثمانين ريو؟

99
00:07:38,460 --> 00:07:40,790
،بوجود هذه في كوداما-يا

100
00:07:40,790 --> 00:07:44,090
.فستعود الحياة لمحلّ العمّ كيوبي

101
00:07:46,230 --> 00:07:50,070
،إن لم تقابلي ساتارو-سان ثانية في المستقبل

102
00:07:50,070 --> 00:07:53,450
.سيكون إيدايا-سان راضيًا حتّى إن اختفى المشط

103
00:07:54,200 --> 00:07:58,410
إضافة إلى أنّني أعتقد أنّ والدة
،ساتارو-سان، تومي-سان

104
00:07:58,410 --> 00:08:01,290
.لا نيّة لها بالتّرحيب بك في عائلة إيدا-يا

105
00:08:02,520 --> 00:08:06,740
.شكرًا لك، لكنّني لن أبيع حلية الشّعر

106
00:08:06,740 --> 00:08:08,170
لماذا؟

107
00:08:08,170 --> 00:08:10,840
هل الوعد الّذي قطعته لساتارو-سان بتلك الأهمّيّة؟

108
00:08:11,260 --> 00:08:12,630
...إضافة لذلك، عليك

109
00:08:21,600 --> 00:08:24,510
.أختي، عرفت ذلك

110
00:08:27,420 --> 00:08:28,690
كان حلمًا؟

111
00:08:29,520 --> 00:08:31,000
!ماذا؟

112
00:08:31,000 --> 00:08:33,270
!هنالك شبح في تسورو-يا؟

113
00:08:33,270 --> 00:08:37,780
.نعم، لم نكن قادرين على لقائه لسوء الحظّ

114
00:08:38,280 --> 00:08:40,830
،نحسب كلام التسوكوموغامي في تسورو-يا

115
00:08:40,830 --> 00:08:45,420
فإنّ الشّبح يعود لامرأة ويبدو أنّها
.عاشت على تلك الأرض قبل الحريق

116
00:08:45,750 --> 00:08:47,580
،إنّها نحيفة وشاحبة البشرة

117
00:08:47,580 --> 00:08:51,300
وتشبه ممثّل الكابوكي ناكامورا كيكونوجو

118
00:08:51,300 --> 00:08:54,260
الّذي لعب أدوار نساء، وهذا يجعل
.منها شبحًا للغاية

119
00:08:54,260 --> 00:08:56,920
!رائع، رائع! أريد رؤيتها أيضًا

120
00:08:57,420 --> 00:08:58,640
...لا يمكن

121
00:08:58,640 --> 00:09:00,360
ما الأمر يا أوراها-ياناغي؟

122
00:09:00,360 --> 00:09:03,420
هل يعقل أن يكون ذلك الشّبح زوجتي؟

123
00:09:03,420 --> 00:09:04,430
ماذا؟

124
00:09:04,790 --> 00:09:07,650
لقد كنت أعيش في الأصل في
نيهونباشي، وإن كان ذلك المحلّ

125
00:09:07,650 --> 00:09:11,560
الّذي يُدعى تسورو-يا قد بُني
،على أنقاض منزلي

126
00:09:11,560 --> 00:09:15,670
فهل يعقل أن يكون الشّبح
الّذي يسكنه هو زوجتي؟

127
00:09:15,670 --> 00:09:18,800
كيف كانت زوجتك؟

128
00:09:18,800 --> 00:09:20,820
.كانت نحيلة وشاحبة البشرة

129
00:09:20,820 --> 00:09:23,070
هل كانت تشبه ناكامورا كيكونوجو؟

130
00:09:23,070 --> 00:09:25,820
،كنتُ أذهب لحضور عروض مع زوجتي

131
00:09:25,820 --> 00:09:29,280
.كما أنّنا رأينا عرض ناكامورا كيكونوجو الجيل الأوّل

132
00:09:29,570 --> 00:09:32,580
،كان يمثّل دور رجل في ذلك الوقت

133
00:09:32,580 --> 00:09:36,090
،لكن إن وضع مساحيق تجميل نسائيّة
!فقد يشبهها

134
00:09:36,090 --> 00:09:38,720
...إذًا، إذًا، الشّبح في تسورو-يا

135
00:09:38,720 --> 00:09:41,210
!قد يكون زوجتي

136
00:09:41,570 --> 00:09:43,900
.لا بدّ من وجود طريقة لأراها

137
00:09:46,440 --> 00:09:50,480
...إذًا فالمرأة الّتي رأيتها في تسورو-يا كانت

138
00:09:51,210 --> 00:09:52,680
شبحًا؟

139
00:09:53,390 --> 00:09:58,480
أخبرني يا سيجي. هل هنالك طريقة ما
لنُعير بها أوراها-ياناغي لتسورو-يا؟

140
00:09:58,820 --> 00:10:00,970
.مستحيل أن نفعل شيئًا كهذا

141
00:10:00,970 --> 00:10:03,800
.لا يجب علينا التّجوّل وإعارة أغراضنا للنّاس

142
00:10:03,800 --> 00:10:05,830
.يا له من رجل قاسي القلب

143
00:10:06,240 --> 00:10:09,530
كان أيّ شخص يملك قلبًا
ليهتمّ عندما يطلب زوجان

144
00:10:09,530 --> 00:10:12,740
.فرّق بينهما الموت أن يلتقيا

145
00:10:12,740 --> 00:10:14,210
.يا إلهي

146
00:10:14,210 --> 00:10:16,240
،إن لم يمكنه فهم ذلك

147
00:10:16,240 --> 00:10:20,570
فسيكون من المستحيل له
.أن يفهم مشاعره الخاصّة

148
00:10:21,860 --> 00:10:23,260
.المعذرة

149
00:10:27,340 --> 00:10:28,280
تسورويا-سان؟

150
00:10:30,240 --> 00:10:34,780
.شكرًا لإعارتك لي تلك الأغراض الرّائعة ذلك اليوم

151
00:10:35,320 --> 00:10:40,330
،هذه المرّة، أودّ دعوة أوكومايا-سان
.لأتمكّن من الإعراب عن امتناني بشكل شخصيّ

152
00:10:40,330 --> 00:10:42,530
من هو أوكومايا-سان؟

153
00:10:42,910 --> 00:10:46,650
.الشّخص الّذي باعني المحلّ بسعر جيّد

154
00:10:47,050 --> 00:10:50,420
،يبدو أنّه لا يحبّ تناول العشاء مع من لا يعرفهم

155
00:10:50,420 --> 00:10:53,470
.لذلك لم يكن قادرًا على المجيء للحفلة السّابقة

156
00:10:53,790 --> 00:10:58,740
عندما عرضت عليه أن نتناول العشاء
.نحن فقط، وافق أخيرًا

157
00:10:59,580 --> 00:11:01,560
.هذه أخبار جيّدة

158
00:11:01,560 --> 00:11:05,670
وبالتّالي، كنت آمل أن أستعير بعض
.الأغراض من إيزومو-يا ثانية

159
00:11:05,670 --> 00:11:08,760
وطبعًا سأحرص على الدّفع
،مقابل كلّ شيء بنفسي هذه المرّة

160
00:11:08,760 --> 00:11:10,940
.لذلك ساعدني رجاءً

161
00:11:10,940 --> 00:11:12,430
.فهمت

162
00:11:12,840 --> 00:11:14,950
حسنًا، ما رأيك بمبخرة؟

163
00:11:14,950 --> 00:11:16,450
!أختي

164
00:11:16,450 --> 00:11:22,300
أنا واثقة أنّه إن كانت هنالك رائحة عطرة
.في المحلّ، فسيسعد ذلك ضيفك

165
00:11:22,690 --> 00:11:25,570
.مفهوم. هذه فكرة جيّدة

166
00:11:26,090 --> 00:11:29,080
.خذ هذه الأغراض معك أيضًا

167
00:11:29,080 --> 00:11:31,120
.لن نأخذ مقابلاً لها

168
00:11:31,120 --> 00:11:33,570
.هذه طريقتنا لتهنئتك

169
00:11:33,570 --> 00:11:35,080
...أختي

170
00:11:36,120 --> 00:11:40,000
...تسورويا-سان، بشأن محلّك

171
00:11:40,000 --> 00:11:41,090
ماذا هنالك؟

172
00:11:41,530 --> 00:11:45,080
.سمعتُ إشاعات عن أنّ شبحًا يسكنه

173
00:11:45,080 --> 00:11:47,730
.شبح؟ هذا مستحيل

174
00:11:47,730 --> 00:11:49,510
،حسنًا، عندما زرتك في ذلك اليوم

175
00:11:49,510 --> 00:11:51,930
.رأيت امرأة خلال تواجدي هناك

176
00:11:51,930 --> 00:11:52,970
من كانت؟

177
00:11:54,760 --> 00:11:57,840
.لا بدّ أنّها كانت زوجتي

178
00:11:59,850 --> 00:12:00,610
زوجتك؟

179
00:12:00,980 --> 00:12:04,720
نعم، أنت شخص مثير للاهتمام جدًّا

180
00:12:05,260 --> 00:12:07,590
.بتصديقك لتلك الإشاعات يا إيزومويا-سان

181
00:12:07,590 --> 00:12:08,630
.سأغادر الآن

182
00:12:18,000 --> 00:12:21,250
ماذا؟ أهذا كلّ ما كلّفه الأمر؟

183
00:12:21,590 --> 00:12:23,750
لم يستأجر توكوبي الكثير، صحيح؟

184
00:12:24,200 --> 00:12:26,700
.لم تكن هذه هديّة تهنئة كما كان يجب

185
00:12:28,690 --> 00:12:30,070
ما الخطب يا سيجي؟

186
00:12:31,250 --> 00:12:32,150
.لا شيء

187
00:12:32,670 --> 00:12:38,440
لقد ارتحت عندما سمعتُ أنّ كلّ الضّيوف
.الّذين أتوا لحفلة تسورو-يا قد سرّهم الأمر

188
00:12:39,040 --> 00:12:42,900
،كان توكوبي يعمل بجدّ بمفرده
.لذلك أنا سعيد من أجله

189
00:12:43,220 --> 00:12:44,600
بمفرده؟

190
00:12:44,600 --> 00:12:47,680
إذًا لم تذهب زوجته إلى المحلّ؟

191
00:12:49,060 --> 00:12:50,410
!كلاّ

192
00:12:50,850 --> 00:12:54,000
.توفّيت زوجة توكوبي قبل بضعة سنوات

193
00:12:54,940 --> 00:12:56,940
ألم أذكر ذلك من قبل؟

194
00:12:57,430 --> 00:13:00,060
،عندما عاشت زوجة توكوبي في نيهونباشي

195
00:13:00,060 --> 00:13:02,280
.بدا وكأنّها كانت تعاني من مرض لوقت طويل

196
00:13:03,680 --> 00:13:09,180
لكن بعد الحريق الكبير، باع المالك
،المنزل الّذي عاش فيه توكوبي وزوجته

197
00:13:09,550 --> 00:13:12,170
.لذلك لم يستطيعوا البقاء في نيهونباشي

198
00:13:12,690 --> 00:13:14,510
،وبسبب مرض زوجته

199
00:13:14,510 --> 00:13:18,000
توسّل إلى المالك الجديد للسّماح لهما
،بالبقاء إلى أن يجدا مكانًا آخر

200
00:13:18,000 --> 00:13:20,930
.لكن يبدو أنّ المالك قد رفض

201
00:13:21,940 --> 00:13:27,450
وقيل إنّه بعد وقت قصير من خسارة
.الزّوجين لمنزلهما، توفّيت الزّوجة

202
00:13:29,540 --> 00:13:31,030
.إنّه لأمر مؤسف للغاية

203
00:13:38,590 --> 00:13:42,370
إذًا فأنت تقول إنّ هنالك شبحًا في تسورو-يا؟

204
00:13:42,370 --> 00:13:46,110
.نعم، ليس من عادة كاتسوسابورو-ساما أن يكذب

205
00:13:47,120 --> 00:13:50,310
،إن كان ما رأيته هو زوجة تسورويا-سان

206
00:13:50,310 --> 00:13:54,680
فمن الواضح إذًا أنّها شبح كما قال
.تسوكويومي وأوهيمي

207
00:13:55,290 --> 00:13:56,880
شبح؟

208
00:13:57,520 --> 00:14:02,150
أظنّ إذًا إنّه علينا فقط أن نأمل الجمع بين
.أوراها-ياناغي بزوجته الّتي أمست شبحًا

209
00:14:03,510 --> 00:14:07,230
ماذا؟ أما زلت غير مقتنع بشأن هذا؟

210
00:14:07,230 --> 00:14:12,430
لكن لماذا أخبرني تسورويا-سان
بأنّها كانت زوجته؟

211
00:14:13,250 --> 00:14:15,860
ربّما لم تسمعه جيّدًا؟

212
00:14:18,580 --> 00:14:19,910
.إيزومويا-سان

213
00:14:19,910 --> 00:14:21,780
.سويمون-سان من هاماماتسو-يا

214
00:14:21,780 --> 00:14:22,760
.طاب يومك

215
00:14:22,760 --> 00:14:24,550
.أنا سعيد بلقائكما

216
00:14:24,550 --> 00:14:26,740
.لديّ أمر أودّ الحديث به معكما

217
00:14:29,750 --> 00:14:31,110
...هذه

218
00:14:31,110 --> 00:14:32,270
.رسمات ممثّلين

219
00:14:32,620 --> 00:14:35,610
طُلب منّي شراء هذه من زبون قيّم

220
00:14:35,610 --> 00:14:37,390
.ولم أستطع الرّفض

221
00:14:37,950 --> 00:14:40,080
،قد يستمتع بها بقيّة النّاس

222
00:14:40,080 --> 00:14:42,730
لكنّني لا أستطيع التّعامل معها
.بما أنّها ليست أعمالاً فنّيّة

223
00:14:43,160 --> 00:14:46,790
قد يكون ثمنها قليلاً، لكن هلاّ أخذتماها منّي؟

224
00:14:47,200 --> 00:14:52,080
نودّ مساعدتك فعلاً، لكنّني لست واثقًا
.أنّ النّاس قد يستأجرون رسمات ممثّلين

225
00:14:52,400 --> 00:14:58,170
بالمناسبة، هل كنتما تتحدّثان عن
تسورويا-سان من نيهونباشي قبل قليل؟

226
00:14:58,170 --> 00:15:01,530
نعم. هل تعرفه أيضًا؟

227
00:15:01,910 --> 00:15:05,340
،كلاّ، أنا لا أعرفه تمام المعرفة

228
00:15:05,340 --> 00:15:10,180
لكنّ المالك السّابق أوكومايا
.كان شخصًا شنيعًا جدًّا

229
00:15:10,600 --> 00:15:13,610
،خلال الفوضى بعد الحريق الكبير

230
00:15:13,610 --> 00:15:17,430
اشترى أوكومايا المكان الّذي كان
.يُعرف بقصر نيهونباشي بسعر زهيد

231
00:15:17,840 --> 00:15:20,510
ويبدو أيضًا أنّه كان هنالك أشخاص
.تمّ طردهم بالقوّة

232
00:15:21,260 --> 00:15:25,410
بدأ يعمل هناك، ويعيد بناء المنازل
.ويبيعها بأسعار غالية

233
00:15:25,410 --> 00:15:27,930
.قيل إنّه كان يدير أعماله بقسوة

234
00:15:28,660 --> 00:15:32,440
وإضافة لذلك، من بين تلك القصور
،الّتي لها تاريخ مثير للاهتمام

235
00:15:32,760 --> 00:15:36,940
يُشاع أنّ شبحًا بدأ يظهر هناك
.بعد الحريق الكبير

236
00:15:37,300 --> 00:15:38,690
بدأ شبح يظهر؟

237
00:15:39,250 --> 00:15:42,890
.قيل إنّ أوكومايا استعجل ليبيعه بسعر منخفض

238
00:15:42,890 --> 00:15:44,240
هل باعه لتسورويا-سان؟

239
00:15:44,240 --> 00:15:45,540
.صحيح

240
00:15:45,540 --> 00:15:49,500
هذا لسوء الحظّ، لكن يبدو أنّه قد
.خُدع بسبب صغر صنّه

241
00:15:49,500 --> 00:15:50,750
...يا إلهي

242
00:15:50,750 --> 00:15:55,910
يبد وأنّ أوكومايا لم يذهب إلى حفلة
.افتتاح تسورو-يا خوفًا من الشّبح

243
00:15:56,260 --> 00:16:00,870
ولكن، سمعتُ أنّه قد دُعي مجدّدًا
.بعد سماعه أنّ للمكان سمعة جيّدة

244
00:16:00,870 --> 00:16:04,270
.أعتقد أنّ شهيّته تغلّبت على خوفه

245
00:16:06,520 --> 00:16:09,990
،قال إنّ الشّبح بدأ يظهر بعد الحريق الكبير

246
00:16:10,460 --> 00:16:14,420
كما أنّ زوجة أوراها-ياناغي
.قد قضت نحبها في نفس الحريق

247
00:16:19,950 --> 00:16:21,800
!ناكامورا كيكونوجو

248
00:16:27,820 --> 00:16:31,560
الشّبح في محلّ تسورويا-سان
!ليس زوجة أوراها-ياناغي

249
00:16:32,470 --> 00:16:33,750
...ممّا يعني

250
00:16:34,360 --> 00:16:37,550
الشّبح هو زوجة تسورويا-سان الميتة؟

251
00:16:38,030 --> 00:16:41,110
،إذًا إذا تمّ خداع تسورويا-سان لشراء المحلّ

252
00:16:41,110 --> 00:16:43,340
فهل تواجد شبح زوجته هناك مجرّد مصادفة؟

253
00:16:43,340 --> 00:16:47,570
.كلاّ، لا بدّ أنّ تسورويا-سان كان مدركًا لكلّ شيء

254
00:16:47,920 --> 00:16:50,210
.كما أنّه دعا أوكومايا للمحلّ

255
00:16:50,210 --> 00:16:51,490
...ممّا يعني

256
00:16:52,790 --> 00:16:54,300
...هل ينوي تسورويا-سان أن

257
00:16:54,300 --> 00:16:55,830
!ماذا؟ مهلاً يا سيجي

258
00:16:58,720 --> 00:17:01,330
!مهلاً! خذا هذه معكما

259
00:17:10,610 --> 00:17:12,090
إيزومويا-سان؟

260
00:17:12,090 --> 00:17:13,330
!الحمد لك

261
00:17:14,240 --> 00:17:15,550
هل أوكومايا-سان هنا؟

262
00:17:15,550 --> 00:17:17,000
.كلاّ، لم يعد بعد

263
00:17:17,000 --> 00:17:19,010
.انتهيت من تجهيز كلّ شيء للتّوّ

264
00:17:19,430 --> 00:17:21,430
هل وضعت السّمّ أيضًا؟

265
00:17:22,000 --> 00:17:23,730
أم ستقوم بذلك لاحقًا؟

266
00:17:23,730 --> 00:17:25,670
ماذا؟ سمّ؟

267
00:17:27,720 --> 00:17:29,280
أقلت سمّ؟

268
00:17:29,720 --> 00:17:32,150
.لقد تجاوزت حدودك بهذا إيزومويا-سان

269
00:17:32,150 --> 00:17:34,270
.كلاّ، لم أفعل

270
00:17:35,640 --> 00:17:39,510
أنت تنوي قتل أوكومايا-سان، صحيح؟

271
00:17:42,250 --> 00:17:44,290
!سيجي، لماذا تقول شيئًا كهذا؟

272
00:17:44,920 --> 00:17:49,240
لقد ربطت بين كلّ شيء بعد أن تحدّثت
.مع كاتسوسابورو-ساما وسويمون-سان

273
00:17:50,190 --> 00:17:56,710
إنّ من دفع تسورويا-سان وزوجته لمغادرة
.نيهونباشي بعد الحريق الكبير كان أوكومايا-سان

274
00:17:57,570 --> 00:18:00,670
،لم يهتمّ لمرض زوجة تسورويا-سان

275
00:18:01,620 --> 00:18:04,200
.وبعد ذلك توفّيت

276
00:18:04,730 --> 00:18:09,830
ذلك الشّبح الّذي رأيته هو زوجتك، صحيح؟

277
00:18:12,620 --> 00:18:16,190
هنالك قصّة معروفة بين المحلّيّن عن شبح

278
00:18:16,820 --> 00:18:19,190
.بدأ يظهر في هذا المحلّ بعد الحريق الكبير

279
00:18:20,610 --> 00:18:23,950
.وأنت اشتريت المحلّ مدركًا لكلّ هذا

280
00:18:23,950 --> 00:18:28,700
،قبل كلّ شيء، الشّبح هو زوجتك
وهذا المكان هو المكان

281
00:18:29,280 --> 00:18:31,650
.الّذي عشتما فيه سويّة

282
00:18:32,890 --> 00:18:36,160
كنتَ إذًا ستحقّق انتقامك
من أوكومايا في هذا المكان

283
00:18:36,160 --> 00:18:37,980
.وذلك لترقد زوجتك بسلام

284
00:18:38,400 --> 00:18:40,030
.هذه خطّتك

285
00:18:40,410 --> 00:18:41,570
أليس كذلك؟

286
00:18:44,080 --> 00:18:45,340
.نعم

287
00:18:45,340 --> 00:18:48,500
،الانتقام من أوكومايا الّذي عجّل موت زوجتي

288
00:18:50,470 --> 00:18:54,470
،وبعدها الانضمام لزوجتي بعد موتي

289
00:18:55,240 --> 00:18:58,990
.كانا هدفاي الوحيدان بعد الحريق الكبير

290
00:18:59,670 --> 00:19:02,180
القيام بشيء كهذا لن يفيدك
.بأيّ شكل من الأشكال

291
00:19:02,180 --> 00:19:05,480
.أعرف ذلك تمام المعرفة

292
00:19:05,870 --> 00:19:08,750
.لكن... عليّ ذلك

293
00:19:09,360 --> 00:19:10,740
لماذا؟

294
00:19:10,740 --> 00:19:13,240
هل نبش الماضي مهمّ لك إلى ذلك الحدّ؟

295
00:19:13,540 --> 00:19:14,940
...إضافة لذلك، عليك

296
00:19:21,130 --> 00:19:25,520
إضافة لذلك، عليك أن تختار أن تواصل
.التّركيز على التّقدّم للأمام

297
00:19:26,110 --> 00:19:28,530
أنت من عمل بجهد هكذا لتصل
.إلى هذه المرحلة

298
00:19:28,530 --> 00:19:33,350
.واثق أنّ بإمكانك التّحرّر من حزنك وغضبك

299
00:19:41,490 --> 00:19:43,930
لكن ماذا سنفعل مع أوكومايا؟

300
00:19:44,840 --> 00:19:46,750
.لديّ فكرة بشأن ذلك

301
00:19:47,790 --> 00:19:51,530
تسورويا-سان، هلاّ خرجت لبعض الوقت؟

302
00:19:52,170 --> 00:19:54,640
.أريدك أن تترك الأمر لنا

303
00:19:57,550 --> 00:19:59,500
.هذا ما يحدث

304
00:20:00,020 --> 00:20:02,880
.أعرف أنّكم لن تتحدّثوا إليّ

305
00:20:03,400 --> 00:20:05,050
.لكن يمكنكم القيام بما يحلو لكم بعد هذا

306
00:20:10,920 --> 00:20:12,570
هل أنت واثق بشأن هذا؟

307
00:20:12,570 --> 00:20:17,810
نعم، نوتيتسو وأوساغي سيحرصان
.على الانتقام لتسورويا-سان

308
00:20:24,740 --> 00:20:27,030
ماذا؟ تسورويا-سان؟

309
00:20:27,030 --> 00:20:28,330
هل أنت هنا؟

310
00:20:29,720 --> 00:20:30,840
تسورويا-سان؟

311
00:20:37,010 --> 00:20:41,700
!علينا الحصول على انتقامنا

312
00:21:00,610 --> 00:21:03,360
إيزومويا-سان، ماذا يحدث؟

313
00:21:04,940 --> 00:21:07,490
.لقد عاقبته الآلهة

314
00:21:12,280 --> 00:21:13,630
!أوكيكو

315
00:21:16,730 --> 00:21:18,850
،ليس عليك القلق بعد الآن

316
00:21:18,850 --> 00:21:21,230
.سوف أترك هذا خلفي الآن

317
00:21:34,220 --> 00:21:39,640
لكن يا سيجي، كيف عرفت أنّ الشّبح
لم يكن زوجة أوراها-ياناغي؟

318
00:21:40,080 --> 00:21:41,280
.بسبب هذه

319
00:21:43,350 --> 00:21:44,650
...هذه

320
00:21:45,160 --> 00:21:47,380
هذه رسمة ممثّل لممثّل الدّور
،النّسائيّ المحبوب حاليًّا

321
00:21:47,380 --> 00:21:50,160
.الجيل الرّابع من ناكامورا كيكونوجو

322
00:21:51,270 --> 00:21:54,170
وهذه رسمة للجيل الأوّل لناكامورا كيكونوجو

323
00:21:54,170 --> 00:21:56,540
.الّتي قال أوراها-ياناغي إنّه قد رآه

324
00:21:57,810 --> 00:22:00,760
كان يمثّل ممثّل الجيل الأوّل
،قبل أزيد من مائة عام

325
00:22:00,760 --> 00:22:03,770
.وقد أدّى أدوارًا رجاليّة فقط في إيدو

326
00:22:05,040 --> 00:22:09,200
.مرّت مائة عام على بقاء أوراها-ياناغي في المستودع

327
00:22:09,730 --> 00:22:13,560
ربّما تكون زوجة أوراها-ياناغي ترقد بسلام الآن؟

328
00:22:15,160 --> 00:22:16,820
.هذا صحيح

329
00:22:17,680 --> 00:22:19,750
،مع كلّ احترامي

330
00:22:19,750 --> 00:22:23,200
،كان ذلك الشّبح يشبه زوجتي
.لكنّه لم يكن هي

331
00:22:23,200 --> 00:22:26,120
!إنّها لم تكن جميلة على الإطلاق

332
00:22:26,940 --> 00:22:29,740
.أستطيع الآن ترك هذا العالم بعد معرفتي بذلك

333
00:22:29,740 --> 00:22:31,870
!عليّ الإسراع للجانب الآخر

334
00:22:36,170 --> 00:22:39,400
.حسنًا إذًا، شكرًا جميعًا على المساعدة

335
00:22:39,400 --> 00:22:40,650
.اهتمّوا بأنفسكم

336
00:22:44,920 --> 00:22:47,740
.حسنًا، لقد كان تسوكوموغامي غير عاديّ

337
00:22:47,740 --> 00:22:50,630
لكن، ألا يعني ذلك أنّه كان مجرّد شبح

338
00:22:50,630 --> 00:22:53,820
يتلبّس مبخرة بدل كونه تسوكوموغامي؟

339
00:22:53,820 --> 00:22:55,120
...صحيح

340
00:24:31,020 --> 00:24:32,030
.هذا كونوسكي

341
00:24:32,030 --> 00:24:36,040
،تتمّ دعوتي أحيانًا إلى حفلات من طرف هانسكي-سان

342
00:24:36,040 --> 00:24:39,410
،تاجر الطّحالب البحريّة بالجملة
.وهو زير نساء استثنائيّ

343
00:24:39,410 --> 00:24:41,350
قريبًا، سنبحر في النّهر

344
00:24:41,350 --> 00:24:43,540
.مع مجموعة من معارفنا الآخرين من الرّجال

345
00:24:43,540 --> 00:24:46,000
!ماذا؟! أوهانا-سان قادمة أيضًا؟

346
00:24:46,500 --> 00:24:48,680
لـ-لكن إن كانت ستأتي، فماذا سأفعل؟

347
00:24:49,520 --> 00:24:51,550
في الحلقة القادمة من
:"نحن نؤجّر التسوكوموغامي"

348
00:24:51,550 --> 00:24:53,910
."الفصل الثّامن: "إيدو-موراساكي