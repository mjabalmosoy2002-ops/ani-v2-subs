1
00:00:01,500 --> 00:00:04,040
إنّها غائبة عن الوعي. يجب
!علينا إيقاف النّزيف الآن

2
00:00:04,130 --> 00:00:05,580
!ساكورا، اسحبي من ذلك الطّرف

3
00:00:05,670 --> 00:00:06,830
!حسناً

4
00:00:07,170 --> 00:00:09,040
هارو، هل يمكنك إحضار تريسي؟

5
00:00:09,130 --> 00:00:12,580
!نحن جاهزون! أدخلنَها بسرعة
!ساكورا، اركبي من مقعد الرّكّاب

6
00:00:12,670 --> 00:00:15,670
!يو، ماذا تفعلين؟! ادخلي! بسرعة

7
00:00:17,920 --> 00:00:19,460
صعدَ الجميع

8
00:00:19,540 --> 00:00:21,210
!حسناً، أخرجنا من هنا

9
00:00:23,170 --> 00:00:25,500
الزّومبي خلفنا مباشرة! دُس
!على دوّاسة الوقود

10
00:00:25,580 --> 00:00:27,580
!تمسّكي بها كي لا تسقط

11
00:00:28,790 --> 00:00:30,420
!ناتشان! ناتشان

12
00:00:31,670 --> 00:00:32,960
هل استيقظتِ؟

13
00:00:33,630 --> 00:00:36,380
ماذا؟ ماذا حدث لي؟

14
00:00:37,330 --> 00:00:38,380
ناتشان

15
00:00:42,170 --> 00:00:45,290
عُضضتِ في الذّراع بواسطة زومبي

16
00:00:45,380 --> 00:00:46,540
ماذا؟

17
00:00:48,420 --> 00:00:51,540
!قضمَ قطعةً منّي

18
00:00:51,630 --> 00:00:53,750
!ناتشان

19
00:00:53,830 --> 00:00:56,960
آ-آ-آ-آكي هي الّتي قطعتْ
!قضمةً كبيرة

20
00:00:57,040 --> 00:00:59,750
لـ-لـ-لـ-لماذا فعلتِ ذلك؟

21
00:00:59,830 --> 00:01:01,920
انتهزتْ فُرصة وهي أنّها قد تُنقذ ناتسكي

22
00:01:02,830 --> 00:01:06,380
قطعتْ آكي ذِراعها حالما عضّها
الزّومبي. هذه آكي

23
00:01:06,880 --> 00:01:08,670
لم تتردّد إطلاقاً

24
00:01:09,250 --> 00:01:13,250
هناك احتمال أن تتمكّني من النّجاة
ببتر المنطقة المُصابة فوراً

25
00:01:14,040 --> 00:01:18,380
.لكن لم نُجرّب ذلك من قبل
إنّها مُجرّد ضربة حظّ

26
00:01:19,170 --> 00:01:22,580
فهمت. أنت من فعلها إذاً

27
00:01:22,670 --> 00:01:27,580
.أنتِ رهيبةٌ حقّاً يا آكي
لكن قد لا أنجو

28
00:01:28,500 --> 00:01:32,580
إذا تحوّلتُ إلى زومبي، فأريدك
أن تقتليني

29
00:01:32,670 --> 00:01:33,790
مفهوم؟

30
00:01:34,080 --> 00:01:35,790
أجل، حسناً

31
00:01:35,880 --> 00:01:38,130
هل لديكِ ما تقولينه بينما ما زلتِ تستطيعين؟

32
00:01:38,830 --> 00:01:44,080
تمنّيتُ حقّاً أكل تلك الفرابّوتشينو
بشوكولاتة اللّوز المُقرمشة

33
00:01:44,790 --> 00:01:49,710
كرو... كروبّي؟ حسناً، لن أنسى

34
00:01:49,790 --> 00:01:51,790
نسيتِ من الآن

35
00:01:52,040 --> 00:01:56,750
هذا سيّئ. أحببتُ ذلك السِّوار حقّاً

36
00:01:57,080 --> 00:02:00,500
كيف أخطأتُ هكذا؟

37
00:02:00,580 --> 00:02:04,130
أنقذتِ يو. أنتِ مُذهلة يا ناتشان

38
00:02:04,210 --> 00:02:05,250
يو؟

39
00:02:05,330 --> 00:02:08,960
هذا صحيح؟ ماذا عن يو؟ هل أنتِ بخير؟

40
00:02:15,830 --> 00:02:19,460
هذا مُطمئن

41
00:02:23,170 --> 00:02:25,420
كرو... كروبّي؟

42
00:02:25,500 --> 00:02:28,380
.انسي الأمر. البودينغ مُناسبة
أريد بودينغ

43
00:02:28,460 --> 00:02:29,420
!حسناً، بودينغ

44
00:04:01,920 --> 00:04:04,000
تستغرق الأعراض حتّى تظهر 24 ساعة

45
00:04:04,080 --> 00:04:08,130
إذا صمدتِ يوماً كاملاً، فيمكننا
استبعاد مسألة الإصابة بالعدوى

46
00:04:08,790 --> 00:04:10,460
اصبري إلى ذلك الحين فحسب

47
00:04:10,540 --> 00:04:14,170
لكن أعتقد بأنّه ما زال يترتّب عليكِ تحمُّل
الجرح حتّى بعد ذلك

48
00:04:14,750 --> 00:04:17,380
على أيّ حال، تماسكي يا ناتسكي

49
00:04:17,460 --> 00:04:19,540
هل ما زلتِ بخير يا ناتشان؟

50
00:04:19,630 --> 00:04:21,830
هل تشتهين البودينغ؟ أم البشر؟

51
00:04:21,920 --> 00:04:23,750
سأصفعكِ

52
00:04:23,830 --> 00:04:27,710
.سأذهب لأحضر لكِ لحماً غير بشريّ
يجب أن تستعيدي قوّتكِ

53
00:04:27,790 --> 00:04:29,040
شكراً

54
00:04:30,790 --> 00:04:36,250
حتّى لو نجوت، لن أتمكّن من الإطلاق
بقوسي من جديد

55
00:04:36,330 --> 00:04:39,540
ولن أتمكّن من التأنُّق في
في الملابس بعد الآن

56
00:04:39,630 --> 00:04:41,630
هذا سيّئ حقّاً

57
00:04:43,380 --> 00:04:44,630
...ناتشان

58
00:04:57,830 --> 00:04:58,830
يو؟

59
00:04:59,540 --> 00:05:00,920
ماذا تفعلين؟

60
00:05:01,460 --> 00:05:04,130
هذه أنتِ. سأبحث عن مشفى

61
00:05:06,080 --> 00:05:08,630
—سأذهب إلى المشفى لإحضار مُستلزمات طبّية

62
00:05:08,710 --> 00:05:11,130
أيّ شيء قد ينفع

63
00:05:11,210 --> 00:05:14,670
،حتّى لو لم تكن مُصابة
تبقى جريحة بشكل بليغ

64
00:05:14,750 --> 00:05:18,710
إن لم نفعل شيئاً، فقد تتطوّر
لديها عدوى مُختلفة

65
00:05:18,790 --> 00:05:21,210
لكن ستذهبين بمفردكِ؟

66
00:05:21,710 --> 00:05:24,920
حدث هذا لأنّها كانت تُنقذني

67
00:05:25,170 --> 00:05:29,130
يقع الأمر على عاتقي. يجب
عليّ تصحيح الأمر

68
00:05:29,210 --> 00:05:31,670
ابقي مكانكِ هنا يا ساكورا

69
00:05:31,750 --> 00:05:33,750
!ماذا؟

70
00:05:34,080 --> 00:05:37,000
!ليس ثانية! أنتِ حمقاء

71
00:05:37,080 --> 00:05:39,380
من النّوع الّذي لا يفلح
سوى في الدّراسة

72
00:05:39,460 --> 00:05:43,040
—ساكورا؟ ماذا تقصدين

73
00:05:43,130 --> 00:05:46,580
ستُلتهَمين بواسطة الكايري إذا
!خرجتِ إلى هناك بمفردكِ

74
00:05:46,670 --> 00:05:49,380
!أنتِ ضعيفةٌ جدّاً يا يو

75
00:05:50,290 --> 00:05:53,000
وفكّري في ناتسكي! خاطرتْ
،بحياتها لإنقاذكِ

76
00:05:53,080 --> 00:05:55,210
فقط كي تموتي في مكانٍ ما دون علمها

77
00:05:55,290 --> 00:05:58,000
!وستأخذين سيّارتهم معكِ؟ أنتِ سيّئة

78
00:05:58,380 --> 00:06:00,250
!أنتِ تتهرّبين فحسب

79
00:06:00,330 --> 00:06:03,080
!لا تُعقّدي الأمور على آكي والآخرين

80
00:06:03,460 --> 00:06:05,290
!استخدمي عقلكِ هذا يا غبيّة

81
00:06:05,380 --> 00:06:07,630
!غبيّة! غبيّة! غبيّة

82
00:06:09,830 --> 00:06:14,830
...لكن يا ساكورا... فكّرتُ في هذا قليلاً

83
00:06:15,330 --> 00:06:19,420
من الأفضل زراعة برسيّة ألبيّة في قدور

84
00:06:19,500 --> 00:06:20,580
ماذا؟

85
00:06:20,670 --> 00:06:24,210
برسيّة ألبيّة؟ عمّاذا تتكلّمين؟

86
00:06:24,290 --> 00:06:27,500
في الصّيف، ينبغي سقايتها
بعد غروب الشّمس

87
00:06:27,750 --> 00:06:31,040
هذا شيء علّمتُكِ إيّاه

88
00:06:31,130 --> 00:06:32,210
هذا صحيح

89
00:06:32,460 --> 00:06:35,170
علّمتِني أشياء كثيرة يا يو

90
00:06:35,250 --> 00:06:38,920
وعندما اتّبعتُ نصيحتكِ، تفتّحت
الزّهور بشكل جميل

91
00:06:41,580 --> 00:06:43,960
ينبغي أن تُشاركي ما تعرفينه مع الجميع

92
00:06:49,330 --> 00:06:50,380
يو

93
00:06:51,420 --> 00:06:54,040
هل تبحثين عن عذر للمُغادرة؟

94
00:06:54,130 --> 00:06:56,500
أم أنّكِ تريدين مُساعدة ناتسكي؟

95
00:06:57,420 --> 00:06:58,540
أيُّهما؟

96
00:07:00,830 --> 00:07:04,040
تماسكي يا ناتشان! ألم
تشتهي البشر بعد؟

97
00:07:04,420 --> 00:07:06,080
بودينغ؟ تريدين بودينغ، صحيح؟

98
00:07:06,170 --> 00:07:07,790
!أحضري لي بعض البودينغ

99
00:07:07,880 --> 00:07:11,500
جيّد! ليس لدينا بودينغ، لكن
سأحضر بعض الطّعام

100
00:07:15,170 --> 00:07:16,290
ناتسكي

101
00:07:16,380 --> 00:07:19,920
ماذا؟ ولماذا أنتِ مُبتلّة؟

102
00:07:21,580 --> 00:07:22,830
هل تتألّمين؟

103
00:07:23,130 --> 00:07:25,210
!أجل، ألماً مُبرِحاً

104
00:07:25,290 --> 00:07:30,170
ستشعرين بألم قد يتسبّب
بألمٍ أبديّ لي

105
00:07:30,250 --> 00:07:35,670
بجرح بليغ كهذا، قد تُصابين بعدوى
أُخرى وتعانين أكثر حتّى

106
00:07:36,290 --> 00:07:38,920
من الأفضل أن تتحوّلي إلى كايري فحسب

107
00:07:39,000 --> 00:07:41,630
هل تفتعلين شِجاراً معي؟

108
00:07:41,710 --> 00:07:43,210
!مـ-مهلاً يا يو

109
00:07:46,380 --> 00:07:51,380
لكن سأنقذكِ! سأحضر شيئاً
!لتخفيف ألمكِ

110
00:07:51,790 --> 00:07:55,830
.آكي، سنستقلّ السّيارةَ إلى المشفى
تعالي معي

111
00:07:55,920 --> 00:07:57,170
المشفى

112
00:07:57,250 --> 00:08:01,750
هارو وساكورا، ابقيا معها. لا يمكننا
المُخاطرة بأخذ ناتسكي

113
00:08:03,250 --> 00:08:06,040
أعتمد عليك إن وقع أيّ مكروه يا هارو

114
00:08:07,330 --> 00:08:08,500
!عُلِم

115
00:08:11,130 --> 00:08:16,290
لم أستسلم! إذاً لا يُسمَح
!لكِ بالاستسلام أيضاً

116
00:08:20,580 --> 00:08:23,250
من ذكرَ شيئاً عن الاستسلام؟

117
00:08:25,210 --> 00:08:28,540
!مهلاً! ما هذا بالتّحديد؟

118
00:08:28,630 --> 00:08:31,210
لا أستطيع أن أدعكِ تتحوّلين إلى كايري
وتُعرِّضين ساكورا لخطر

119
00:08:31,290 --> 00:08:34,580
ولا نريدكِ أن تهدري طاقتكِ بالتحرُّك

120
00:08:34,670 --> 00:08:38,880
.انتظري فقط ريثما أصل إليك
!سأقضي عليكِ عندما تعودين

121
00:08:41,080 --> 00:08:43,630
يو، اسمعيني قليلاً

122
00:08:51,040 --> 00:08:53,710
لا تدعي آكي تقود

123
00:08:53,790 --> 00:08:54,920
ماذا

124
00:08:55,000 --> 00:08:58,790
يو! هيّا بنا، بسرعة

125
00:08:58,880 --> 00:09:00,380
قـ-قادمة

126
00:09:00,460 --> 00:09:02,920
ما الّذي يؤخّركِ؟ بسرعة

127
00:09:03,000 --> 00:09:04,880
أنا قادمة. اهدئي

128
00:09:04,960 --> 00:09:06,960
!المشفى ينتظرني

129
00:09:07,040 --> 00:09:08,920
لا تدعيه ينتظر. ستنحسيننا

130
00:09:10,830 --> 00:09:14,960
نادتْنا بأسمائنا ولو لمرّة واحدة

131
00:09:15,040 --> 00:09:17,790
هيّا، بسرعة. اركبي من ذلك الجانب

132
00:09:19,080 --> 00:09:21,290
هل تعرفين أين المشفى؟

133
00:09:21,380 --> 00:09:22,290
أجل

134
00:09:22,380 --> 00:09:24,420
حسناً، هيّا بنا

135
00:09:28,210 --> 00:09:30,210
!انتظري لحظة-
!لننطلق-

136
00:09:37,080 --> 00:09:38,710
يو، من أيّ اتّجاه ينبغي أن أذهب؟

137
00:09:38,790 --> 00:09:40,130
!يـ-يمين

138
00:09:40,210 --> 00:09:41,880
ماذا؟ لا أستطيع سماعكِ

139
00:09:41,960 --> 00:09:43,880
!انظري أمامكِ! أمامكِ

140
00:09:43,960 --> 00:09:46,960
!بشكل مُستقيم؟ عُلِم. أنا بارعة في ذلك

141
00:09:47,040 --> 00:09:48,750
!ليس هذا ما قصدت

142
00:09:51,170 --> 00:09:52,920
بئساً، تُمطر بغزارة

143
00:09:53,380 --> 00:09:55,920
ستكون تريسي نظيفة تماماً

144
00:09:56,000 --> 00:09:57,170
أجل

145
00:09:58,130 --> 00:10:02,080
بالإضافة إلى ذلك، الأمطار ستحجب
صوتَ المُحرِّك

146
00:10:02,460 --> 00:10:05,540
أتساءل ما إن كان كره الماء يعني
أنّهم يكرهون المطر أيضاً

147
00:10:17,580 --> 00:10:18,830
عُدت

148
00:10:27,540 --> 00:10:29,330
!ها هو

149
00:10:30,290 --> 00:10:31,210
هذا هو، صحيح؟

150
00:10:31,290 --> 00:10:34,880
!بناء كبير مع أحرف بالكانجي
"مكتوب "مشفى

151
00:10:35,250 --> 00:10:38,380
!أنا مُحقّة، أليس كذلك؟ أعلم، لأنّني عبقريّة

152
00:10:38,460 --> 00:10:39,330
بالتّأكيد

153
00:10:39,580 --> 00:10:41,540
هذا هو الثّالث

154
00:10:41,830 --> 00:10:44,330
كنتُ سأتفاجأ أكثر إن لم تُميّزيه هذه المرّة

155
00:10:44,420 --> 00:10:47,670
أعرف منذ البداية. لم أقل شيئاً فحسب

156
00:10:47,750 --> 00:10:52,330
حسناً. لنبحث عن شيء لمُعالجة
ذِراع ناتشان هذه المرّة

157
00:10:59,880 --> 00:11:03,830
وبعد؟ هل تشمّين رائحة أي زومبي... كايري؟

158
00:11:05,460 --> 00:11:06,630
لا

159
00:11:07,500 --> 00:11:10,710
بئساً. لا زومبي هنا؟

160
00:11:10,790 --> 00:11:14,460
أنتِ الوحيدة الّتي تُصاب بخيبة أمل
عندما لا يكون هناك كايري

161
00:11:16,630 --> 00:11:20,880
لكن هذه المرّة، سيكون من الأفضل
وجود كايري

162
00:11:20,960 --> 00:11:25,380
ماذا تقصدين؟ قلتِ ذلك في
المشفى السّابق أيضاً

163
00:11:25,630 --> 00:11:29,250
ألا يُثير استغرابكِ عدم وجود
أي كايري هنا؟

164
00:11:30,250 --> 00:11:33,500
أجل. لم يكن هناك أي زومبي
يلتجئ من المطر أيضاً

165
00:11:34,170 --> 00:11:38,250
ما يعني بأنّ هذا المكان
قد تمّ تطهيره بالفعل

166
00:11:38,330 --> 00:11:39,710
تمّ تطهيره"؟"

167
00:11:39,790 --> 00:11:42,290
وصلَ أحدٌ إلى هنا أوّلاً
وقضى على الكايري

168
00:11:43,000 --> 00:11:46,750
بصيغة أُخرى، أخذَ المُستلزمات بالفعل أيضاً

169
00:11:46,830 --> 00:11:48,790
سنبحث في الأرجاء تحسُّباً فقط

170
00:11:50,210 --> 00:11:52,540
!مرحباً، أهلاً وسهلاً

171
00:11:52,630 --> 00:11:54,000
ماذا تفعلين؟

172
00:11:54,080 --> 00:11:55,580
!ألعب تبادُل الأدوار

173
00:11:55,670 --> 00:11:58,670
كنّا نفعل ذلك كثيراً متى
واجهنا المتاعب في الصّيد

174
00:11:58,750 --> 00:12:02,670
هيّا يا يو. قفي هنا. قد نكتشف شيئاً

175
00:12:03,290 --> 00:12:06,880
مرحباً، أهلاً وسهلاً! هل
من شيء تبحث عنه؟

176
00:12:07,290 --> 00:12:11,500
المشافي ليست هكذا. إنّهم
"لا يُرحّبون بالنّاس بـ"أهلاً وسهلاً

177
00:12:11,580 --> 00:12:14,000
!اعملي معي هنا. نحن نتبادل الأدوار

178
00:12:16,670 --> 00:12:20,380
هناك شخص... بُتِرَ ذِراعه

179
00:12:20,880 --> 00:12:23,830
أبحث عن مُستلزمات طبّية لمُعالجته

180
00:12:24,130 --> 00:12:27,040
أخشى أنّني لا أستطيع مُساعدتكِ في ذلك

181
00:12:27,130 --> 00:12:28,710
كفى عبثاً

182
00:12:33,500 --> 00:12:35,500
يو-
ماذا؟-

183
00:12:35,580 --> 00:12:37,420
إلى أين تريدين الذّهاب؟

184
00:12:37,750 --> 00:12:39,500
لماذا تسألينني هذا السّؤال؟

185
00:12:39,750 --> 00:12:45,580
.أريد الذّهاب إلى برج طوكيو
سنذهب حالما تتحسّن ناتشان

186
00:12:45,670 --> 00:12:48,000
إلى أين أردتِ الذّهاب عندما
غادرتِ القرية؟

187
00:12:48,710 --> 00:12:50,000
لا مكان مُحدَّد

188
00:12:50,080 --> 00:12:53,210
لا مكان مُحدَّد؟ ماذا عن شيء أردتِ فعله؟

189
00:12:53,290 --> 00:12:55,790
لا شيء-
ولا ذلك حتّى؟-

190
00:12:57,380 --> 00:12:59,750
إذاً لماذا غادرتِ قريتكِ

191
00:13:00,170 --> 00:13:03,210
هربتُ من القرية فحسب

192
00:13:05,210 --> 00:13:09,080
أو بالأحرى، من الأشخاص الّذين
اعتدتُ أن أناديهم بالعائلة

193
00:13:09,170 --> 00:13:11,920
إذاً قريتكِ كانت مليئة بالزّومبي

194
00:13:12,000 --> 00:13:13,210
ليس تماماً

195
00:13:14,040 --> 00:13:19,000
منذ أصبح العالم هكذا، لم يعُد
لديّ مكان أنتمي له

196
00:13:19,080 --> 00:13:20,420
أبي

197
00:13:21,210 --> 00:13:24,380
ترعرعتُ في كنف عائلة ثريّة

198
00:13:24,460 --> 00:13:26,500
حفظتُ جدولَ الضّرب في الثّانية

199
00:13:26,580 --> 00:13:29,460
وأتقنتُ المُعادلات التّربيعيّة في الخامسة

200
00:13:29,750 --> 00:13:33,630
مدحَني النّاس بوصفي بالعبقريّة
والطّفلة النّابغة

201
00:13:34,210 --> 00:13:36,130
أحبّني والدايّ أيضاً

202
00:13:36,210 --> 00:13:39,130
أنتِ ذكيّةٌ للغاية يا يو

203
00:13:39,210 --> 00:13:40,460
...لكن حينها

204
00:13:43,920 --> 00:13:45,880
غيّرَ اليوم الأحمر كُلَّ شيء

205
00:13:46,580 --> 00:13:50,580
يبدو أنّ القوّة الجسديّة أعلى من أيّ
شيء في هذا العالم الجديد

206
00:13:52,380 --> 00:13:55,130
كانت المرّة الأولى الّتي يُهينني
فيها شخصٌ على الإطلاق

207
00:13:59,130 --> 00:14:04,080
مات أبي، وأنجبت أمّي طفلاً من رجل آخر

208
00:14:04,750 --> 00:14:07,130
أريدك أن تنمو قويّاً

209
00:14:10,500 --> 00:14:13,830
لا تكوني كتلك الطّفلة

210
00:14:16,920 --> 00:14:18,960
ثمّ وُلِدَ أخي الصّغير

211
00:14:19,790 --> 00:14:22,880
كانت قريتنا تُقيم مهرجاناً حيث
يُمنَح الرُّضَّع أقنعة

212
00:14:24,500 --> 00:14:29,130
من حماقتي، صنعتُ قِناعاً قبيحاً
له بنفسي

213
00:14:31,380 --> 00:14:36,580
عندما عدتُ إلى المنزل، كانت
عائلتي قد رحلت. وتُرِكت رسالة

214
00:14:38,080 --> 00:14:40,710
"نحن ذاهبون إلى المهرجان كعائلة"

215
00:14:42,040 --> 00:14:44,750
لم أعُد جزءاً من العائلة حينها

216
00:14:46,500 --> 00:14:50,000
استغرقتُ عشر سنوات حتّى
أدركتُ ذلك أخيراً

217
00:14:50,080 --> 00:14:52,710
ثمّ... غادرتُ القرية

218
00:14:52,790 --> 00:14:55,210
يتغيّر النّاس عندما تتغيّر ظروفهم

219
00:14:57,130 --> 00:15:01,000
أيّ شخص لا يستطيع الصُّمود يُترَك

220
00:15:05,170 --> 00:15:08,420
انظري إلى ما وجدت. ستُحبّ
ناتشان هذا بكلّ تأكيد

221
00:15:08,500 --> 00:15:09,960
لم تكوني تستمعين إليّ؟

222
00:15:10,040 --> 00:15:12,500
!لم أشارك تلك القصّة مع أحد من قبل

223
00:15:13,920 --> 00:15:16,960
والدايّ تركاني أيضاً

224
00:15:17,250 --> 00:15:20,500
رُبّما ذهبَ أبي إلى ذلك المهرجان

225
00:15:22,580 --> 00:15:25,170
يا لهما من والدين سيّئين

226
00:15:25,250 --> 00:15:26,830
بالفعل

227
00:15:27,750 --> 00:15:29,460
لا تتحرّكي

228
00:15:30,130 --> 00:15:32,880
هذه مادّة كيميائيّة ميّتة. حركة
واحدة وستموتين

229
00:15:33,960 --> 00:15:35,210
بشريّ؟

230
00:15:35,290 --> 00:15:36,750
أنتِ، هناك

231
00:15:36,830 --> 00:15:38,960
ارمي سلاحكِ وتعالي بهدوء

232
00:15:45,460 --> 00:15:48,790
أنتم مليئون بالكدمات

233
00:15:48,880 --> 00:15:53,750
تبّاً. عدم وجود كايري يعني
وجود ناجين آخرين في الجوار

234
00:15:53,830 --> 00:15:55,580
كان ينبغي أن أتوقّع هذا

235
00:15:56,080 --> 00:16:00,000
يبدو أنّ آكي تستطيع اشتمام
رائحة الكايري فقط

236
00:16:00,960 --> 00:16:04,290
أنتما مُبتدئتان، أليس كذلك؟
أنتما مُستهترتان للغاية

237
00:16:04,380 --> 00:16:06,420
سألقّنكما درساً قيّماً

238
00:16:06,500 --> 00:16:09,540
في هذا العالم، إن لم يُبادر المرء
بالخطوة الأولى، يُقضى عليه

239
00:16:09,630 --> 00:16:12,580
!سمعتُ هذا من قبل

240
00:16:13,040 --> 00:16:15,170
...وطريقة اللّباس

241
00:16:17,880 --> 00:16:20,130
فهمت. لا بُدّ أنّ هذا أنتم

242
00:16:20,210 --> 00:16:21,250
ماذا؟

243
00:16:21,790 --> 00:16:23,960
هل تعرفون ميكازوكي؟

244
00:16:25,630 --> 00:16:27,330
ما أدراكِ بهذا الاسم؟

245
00:16:27,420 --> 00:16:30,790
ماذا؟ ميكازوكي؟ ما بها؟

246
00:16:30,880 --> 00:16:34,170
هناك أشخاص كانت تبحث عنهم

247
00:16:34,830 --> 00:16:39,540
فهمت! أصبحنا أصدقاء لها

248
00:16:39,960 --> 00:16:43,080
،قالت بأنّها انفصلتْ عن أصدقائها
وبأنّها كانت تتضوّر جوعاً

249
00:16:43,170 --> 00:16:44,670
لذا قدّمنا لها بعض الطّعام

250
00:16:44,750 --> 00:16:49,330
ثمّ غادرتْ قائلةً بأنّها ستعود
—إلى مجموعتها. ثمّ

251
00:16:49,420 --> 00:16:50,500
لا

252
00:16:54,000 --> 00:16:55,500
تخلّوا عنّي

253
00:16:56,170 --> 00:16:59,130
.ميكازوكي أُصيبَتْ بالعدوى
وقد تخلّوا عنها

254
00:16:59,710 --> 00:17:02,830
لهذا اختارت الموت وحيدة

255
00:17:03,210 --> 00:17:05,960
مـ-ما أدراكِ بذلك يا يو؟

256
00:17:06,960 --> 00:17:08,580
سألتُها بعد ذلك

257
00:17:12,960 --> 00:17:14,920
هل صحيح أنّكم تخلّيتم عنها؟

258
00:17:17,250 --> 00:17:19,040
كانت منكم، أليس كذلك؟

259
00:17:19,580 --> 00:17:23,130
كانوا مضطرّين لفعلها لحماية
سلامة الجميع

260
00:17:23,210 --> 00:17:24,210
لماذا؟

261
00:17:24,750 --> 00:17:27,330
يتغيّر النّاس عندما تتغيّر ظروفهم

262
00:17:27,420 --> 00:17:31,130
كانت أحد الأشخاص الّذين تُرِكوا
وحيدين. هذا كُلّ ما في الأمر

263
00:17:32,790 --> 00:17:34,920
أيّ شخص مُصاب لم يعُد منّا

264
00:17:37,130 --> 00:17:38,250
!ماذا؟

265
00:17:39,210 --> 00:17:40,130
...أيّتها

266
00:17:40,210 --> 00:17:43,420
ذكرتْ ميكازوكي بأنّكم أصدقاؤها
حتّى الرّمق الأخير

267
00:17:43,500 --> 00:17:45,920
!كانت قلقة عليكم-
!ثبّتوها-

268
00:17:46,000 --> 00:17:48,040
!كيف أمكنَكم التخلِّي عنها؟

269
00:17:48,130 --> 00:17:49,130
!أيّتها الطّفلة الشّقيّة

270
00:17:53,250 --> 00:17:56,380
!يبقى الأصدقاء معاً حتّى النّهاية

271
00:17:56,460 --> 00:17:59,500
أهكذا تريدون حقّاً إنهاء حياتكم؟

272
00:18:02,130 --> 00:18:05,790
رُبّما إحدى صديقاتنا مُصابة بالعدوى أيضاً

273
00:18:05,880 --> 00:18:08,830
لذا اضطررنا لبتر ذِراعها المعضوضة

274
00:18:08,920 --> 00:18:11,630
أتينا إلى هنا بحثاً عن مُستلزمات
طبّيّة لمُعالجتها

275
00:18:11,710 --> 00:18:15,080
!مُحال أن نتخلّى عنها

276
00:18:15,790 --> 00:18:17,500
!لكن سأنقذكِ

277
00:18:22,250 --> 00:18:26,210
قاعدتنا كائنة في متجر المُستلزمات
المنزليّة عند النّهر

278
00:18:26,290 --> 00:18:27,750
...مـ-ما الّذي

279
00:18:28,130 --> 00:18:32,080
!حفرنا قبراً لميكازوكي هناك
!اذهبوا وزوروها

280
00:18:37,460 --> 00:18:42,080
يكفي. لندعهما يذهبان. لندعهما
يحصلان على بعض المُستلزمات

281
00:18:42,170 --> 00:18:43,290
ماذا؟

282
00:18:48,170 --> 00:18:53,000
أمثالكم لن يصمدوا طويلاً هناك

283
00:18:56,460 --> 00:18:57,790
...لماذا

284
00:19:02,880 --> 00:19:05,080
تبيّن بأنّه شخص لطيف

285
00:19:05,170 --> 00:19:07,250
والآن يمكننا مُعالجة جرح ناتشان

286
00:19:07,330 --> 00:19:12,130
،لا تكوني حمقاء! إذا استمرّ هذا
!فستتأذّين يوماً ما

287
00:19:12,210 --> 00:19:14,210
!لن يردّ النّاسُ جميلكِ دوماً

288
00:19:14,290 --> 00:19:17,960
لكنّكِ تُحاولين إنقاذ ناتشان أيضاً

289
00:19:20,250 --> 00:19:23,330
ليس هذا ما أفعله

290
00:19:24,630 --> 00:19:26,880
لا تزال ناتسكي تتألّم

291
00:19:28,210 --> 00:19:32,250
لو لم تُنقذني، لما حدث هذا

292
00:19:33,170 --> 00:19:39,290
أنا خائفة من اعتقادها بأنّ الأمور
كانت لتغدو أفضل من دوني

293
00:19:40,670 --> 00:19:45,250
لهذا السّبب كنتُ أخطّط في الواقع
للذّهاب إلى المشفى بنفسي

294
00:19:45,580 --> 00:19:48,960
ارتأيتُ بأنّه لا يهمّ لو متُّ هناك

295
00:19:50,500 --> 00:19:54,630
في نهاية المطاف، نويتُ بالفعل
أن أموت عندما غادرتُ القرية

296
00:19:57,380 --> 00:20:00,170
أستطيع رؤية متجر المُستلزمات الطبّيّة

297
00:20:00,630 --> 00:20:04,500
حالما أُعالج ناتسكي، سأغادر
قبل أن تستيقظ

298
00:20:04,580 --> 00:20:05,630
—والباقي

299
00:20:14,710 --> 00:20:16,710
!ماذا تفعلين؟ انظري إلى السّيّارة

300
00:20:16,790 --> 00:20:20,500
!لا أهتمّ للسّيّارة! يمكننا إصلاحها

301
00:20:20,580 --> 00:20:22,170
!علّميني كيفيّة إصلاحها

302
00:20:22,250 --> 00:20:25,080
ماذا؟ أنتِ سخيفة

303
00:20:25,170 --> 00:20:28,710
!من دونكِ، فلن أعرف كيف أصلح سيّارة

304
00:20:28,790 --> 00:20:32,920
لا أعرف كيف أصل إلى برج طوكيو
!أو كيف أحمّض الصُّور

305
00:20:33,250 --> 00:20:37,790
لن أدعكِ تُغادرين! فنحن
!نعيش تحت نفس السّقف

306
00:20:37,880 --> 00:20:39,250
!هذا يجعلنا عائلة

307
00:20:43,420 --> 00:20:45,080
!آكي! يو

308
00:21:01,880 --> 00:21:03,040
أهلاً بعودتكما

309
00:21:04,210 --> 00:21:05,420
أهلاً بك

310
00:21:17,920 --> 00:21:18,960
!مؤلم

311
00:21:52,040 --> 00:21:53,290
لقد عُدت

312
00:21:55,210 --> 00:21:59,000
أخفتِني. ظننتُكِ ستعضّيننا يا ناتشان

313
00:21:59,080 --> 00:22:01,040
سأصفعكِ

314
00:22:01,130 --> 00:22:02,420
أهلاً بعودتكما

315
00:22:02,500 --> 00:22:03,580
أهلاً بكما