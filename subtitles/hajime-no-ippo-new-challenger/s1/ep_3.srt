1
00:01:10,420 --> 00:01:13,330
!اللكمة الحادة القاضية

2
00:01:13,330 --> 00:01:14,220
!تمكنتُ منه

3
00:01:17,600 --> 00:01:19,520
...لقد لوى كوعه

4
00:01:19,520 --> 00:01:22,190
!و غير اتجاه اللكمة...

5
00:01:24,580 --> 00:01:26,690
و يُمنى البطل تقذف برأسهِ للخلف

6
00:01:27,250 --> 00:01:28,200
!و يُسرى

7
00:01:28,200 --> 00:01:30,610
!يُمنى

8
00:01:30,610 --> 00:01:32,030
!إنهُ وابل من اللكمات

9
00:01:32,030 --> 00:01:34,950
!المُتحدي يتلقى جميع اللكمات

10
00:01:37,450 --> 00:01:39,630
!لقد سقط

11
00:01:39,630 --> 00:01:41,210
!لقد سقط المُتحدي للمرةِ الثانية

12
00:01:41,210 --> 00:01:44,170
!قام البطل بإظهار قوته الكاملة

13
00:01:44,870 --> 00:01:46,960
!تبًا

14
00:01:46,960 --> 00:01:49,800
!كيف يتجرأ ليسعى خلف مُضاداتي

15
00:01:49,800 --> 00:01:52,410
!لا يوجد ماهو أذلُ من هذا

16
00:01:52,410 --> 00:01:55,200
!أشعر و كأنهُ انتزعني و كبريائي معًا

17
00:01:56,510 --> 00:01:59,380
!لن أخسر بهذه الطريقة

18
00:02:00,130 --> 00:02:04,270
الجولة الثالثة

19
00:02:05,450 --> 00:02:08,590
!هذا هو السقوط الثاني للمُتحدي

20
00:02:08,590 --> 00:02:10,660
!لقد تضرر بشدة

21
00:02:10,660 --> 00:02:12,580
!وجهه مُغطى بالدماء

22
00:02:12,580 --> 00:02:15,490
هل يستطيعُ إكمال القتال؟

23
00:02:17,990 --> 00:02:20,230
!اللعنة على هذا

24
00:02:20,230 --> 00:02:25,250
!كيف تتجرأ على إهانة مُضاداتي، وكبريائي

25
00:02:25,250 --> 00:02:27,200
!فلتنهض يا مياتا

26
00:02:27,200 --> 00:02:28,970
!لا تدع الأمر ينتهي هُنا

27
00:02:28,970 --> 00:02:31,760
!لم نأتِ لنُشاهدك بهذا الشكل

28
00:02:32,920 --> 00:02:34,260
!مياتا-كُن

29
00:02:35,330 --> 00:02:37,010
إيتشيرو

30
00:02:37,010 --> 00:02:41,730
!مُضادة مياتا كانت أسرع مما توقعنا

31
00:02:41,730 --> 00:02:46,620
لهذا تلقاها أرني في الجولة الأولى
بينما كان يُجهز الطُعم

32
00:02:48,480 --> 00:02:50,210
!لن تعمل بعد الآن

33
00:02:52,440 --> 00:02:55,160
!لا يوجد ما يُمكنك فعلة حتى إن نهضت

34
00:02:58,320 --> 00:03:02,410
!لن أخسر بعد

35
00:03:04,860 --> 00:03:05,920
!لقد نهض

36
00:03:08,320 --> 00:03:09,770
بإمكاني الإستمرار أيها الحكم

37
00:03:10,320 --> 00:03:11,420
!ابتعد عن طريقي

38
00:03:16,300 --> 00:03:19,460
حتى ولو نهضت، فمُضاداتك قد خُتمت بالفعل

39
00:03:19,460 --> 00:03:22,280
لا يوجد سبب للخوف من مُلاكم لا يمتلك لكمة قاضية

40
00:03:22,280 --> 00:03:25,060
أنتَ الآن مثل الطائر الذي فقد جناحيه

41
00:03:27,690 --> 00:03:29,320
!ضرره خطير

42
00:03:29,320 --> 00:03:31,820
!المُتحدي لا يستطيع الوقوف بثبات

43
00:03:31,820 --> 00:03:35,320
!سقوطٌ أخير من المُتحدي و سينتهي النزال

44
00:03:35,320 --> 00:03:39,080
تبقت 20 ثانية من الوقت
هل سيصمد المُتحدي كل تلك المُدة؟

45
00:03:39,790 --> 00:03:40,930
!لكمة يُمنى

46
00:03:40,930 --> 00:03:42,330
!تصدى له بشق الانفس

47
00:03:42,330 --> 00:03:43,790
!تحرك مياتا

48
00:03:43,790 --> 00:03:45,500
!قم باحتضانه لكسب الوقت

49
00:03:45,970 --> 00:03:47,470
لن أدعكَ تحتضنني

50
00:03:47,470 --> 00:03:48,710
!سأدفعك بوابل من اللكمات

51
00:03:50,810 --> 00:03:53,500
!إن المُتحدي يُقاوم

52
00:03:53,500 --> 00:03:55,260
!روحك القتالية جيدة

53
00:03:57,510 --> 00:03:58,900
وابل من اللكمات مُجددًا

54
00:03:58,900 --> 00:04:01,060
إنهُ يدفع المُتحدي بسهولة ناحية الحبال

55
00:04:01,060 --> 00:04:02,500
!لا تقف عند الحبال

56
00:04:02,500 --> 00:04:04,580
أخرج من عندك لكسب الوقت

57
00:04:03,370 --> 00:04:04,580
اهرب

58
00:04:06,350 --> 00:04:07,660
لن يهرب من مكانه

59
00:04:07,660 --> 00:04:09,060
!إنهُ يتبادل اللكمات معه

60
00:04:09,060 --> 00:04:12,070
لماذا تُبادله باللكمات؟

61
00:04:10,630 --> 00:04:12,070
!فلتتحركك من مكانك

62
00:04:12,570 --> 00:04:14,070
!لقد تلقى لكمة

63
00:04:14,230 --> 00:04:16,140
!إنه يتألم! لا يستطيع الوقوف

64
00:04:16,140 --> 00:04:17,820
!ولكنهُ لم يسقط

65
00:04:18,910 --> 00:04:20,780
!إنهٌ يُقاتل و يُكافح

66
00:04:20,780 --> 00:04:21,910
عشر ثوانٍ مُتبقية

67
00:04:21,910 --> 00:04:24,410
!أرجوك! اهرب

68
00:04:23,080 --> 00:04:24,410
!لا تسقط

69
00:04:25,190 --> 00:04:26,420
!البطل يستمر باللكم

70
00:04:27,170 --> 00:04:28,420
!و مياتا يُقاوم

71
00:04:28,780 --> 00:04:31,940
لقد تأثر! لا يُمكنه التغلب على ضرره

72
00:04:32,420 --> 00:04:33,940
!يمينية من البطل

73
00:04:35,220 --> 00:04:36,180
!سأتصدى لها بمضادة

74
00:04:36,770 --> 00:04:40,220
!فشلت المُضادة! لقد تلقى لكمة في الوجه

75
00:04:40,860 --> 00:04:42,220
خمس ثوانٍ باقية

76
00:04:44,000 --> 00:04:45,100
إنهُ يُقاوم

77
00:04:45,100 --> 00:04:46,230
!ثلاث ثوانٍ

78
00:04:47,020 --> 00:04:47,970
ثانيتان

79
00:04:48,670 --> 00:04:49,900
!ثانية

80
00:04:53,900 --> 00:04:55,140
!لقد سقط

81
00:04:56,090 --> 00:04:58,570
!انهُ سُقوطه الثالث

82
00:04:59,440 --> 00:05:00,070
...مـ

83
00:05:00,770 --> 00:05:03,660
...مياتا-كُن قد خسر

84
00:05:07,660 --> 00:05:09,170
!انزلاق

85
00:05:09,700 --> 00:05:11,700
!الحكم احتسبهُ كـ انزلاق

86
00:05:11,700 --> 00:05:13,320
!لم يكن سقوطًا

87
00:05:13,320 --> 00:05:17,170
القاعة بأكملها حبست أنفاسها
مُنتظرين قرار الحكم

88
00:05:18,100 --> 00:05:21,430
!ها قد رن الجرس، معلنًا نهاية الجولة الثانية

89
00:05:23,740 --> 00:05:25,840
!لقد توقف قلبي

90
00:05:26,540 --> 00:05:28,690
!روحه تخرج من جسده

91
00:05:29,140 --> 00:05:31,050
.كان ذلك وشيكًا

92
00:05:31,050 --> 00:05:33,260
!ما بال اهتياجه قبل قليل

93
00:05:33,260 --> 00:05:36,260
!لا أعلم ما إذا كان ذلك تهورًا أم قوة

94
00:05:36,260 --> 00:05:39,200
!لم أُشاهد مياتا من قبل يُقاتل هكذا

95
00:05:39,200 --> 00:05:41,570
.لابد أنه الغضب

96
00:05:41,570 --> 00:05:42,660
الغضب؟

97
00:05:42,660 --> 00:05:45,300
.عندما يتلقى مياتا اللكمات فلن يؤدي جيدًا

98
00:05:45,300 --> 00:05:49,010
...كان من المُمكن أن تنتهي المُباراة بعد سقوطه الثاني

99
00:05:49,010 --> 00:05:52,710
ولكن كبريائه قد تحطم بعد أن علم بأن أرني يسعى خلف مُضاداته

100
00:05:53,280 --> 00:05:55,880
!الغضب جعله يستمر بالوقوف

101
00:05:57,380 --> 00:05:58,470
.هذا صحيح

102
00:05:58,470 --> 00:06:01,720
.لكمتي القاضية هي المُضادة

103
00:06:02,510 --> 00:06:07,220
سوف أُسقط أي شخص بها
بدون الاعتماد على القوة

104
00:06:07,220 --> 00:06:11,330
.المُضادات هيَ كبرياء مياتا

105
00:06:11,330 --> 00:06:13,060
لكن ماذا سيفعل الآن؟

106
00:06:13,060 --> 00:06:16,980
مع سلب لكمته المُضادة سيكون من الصعب عليه القتال

107
00:06:16,980 --> 00:06:19,690
.الجولة التالية ستكون حرجة

108
00:06:19,690 --> 00:06:22,100
...سواءً قام بالدفاع أو الهُجوم

109
00:06:22,100 --> 00:06:26,170
فما مقدار القدرة على التحمل و الأضرار التي سيستطيع التعافي منها قبل الجولة التالية

110
00:06:28,350 --> 00:06:30,960
!للأسف، لن يتمكن من التعافي

111
00:06:30,960 --> 00:06:33,650
!لقد فقد الكثير من الوزن

112
00:06:33,650 --> 00:06:37,080
.لقد تلقى الكثير من الضرر خلال هيجانه قبل قليل

113
00:06:37,080 --> 00:06:40,210
!مخزون تحملة أصبح فارغًا الآن

114
00:06:40,210 --> 00:06:42,500
...لا أريد الاعتراف بهذا، ولكنهُ

115
00:06:45,280 --> 00:06:46,510
.لقد انتصرنا

116
00:06:46,880 --> 00:06:50,070
.لم أتوقع أنهُ سيُعاود القتال بعد تلك

117
00:06:51,000 --> 00:06:54,770
"لابد أن ذلك هو ما يُسمونه بـ "روح الساموراي

118
00:06:55,420 --> 00:07:00,350
لكنهُ لا يعلم بأن مخزونهُ نفذ بسبب تحكم الوزن

119
00:07:00,350 --> 00:07:03,990
لقد كان تصرفًا طائشًا منه قبل قليل

120
00:07:03,990 --> 00:07:08,130
مياتا الآن ليس إلا مُجرد كيس مُلاكمة

121
00:07:06,910 --> 00:07:09,540
توقف، سيد ساكاجوتشي

122
00:07:11,160 --> 00:07:14,430
لم أرَ مُلاكمًا شُجاعًا مثله من قبل

123
00:07:15,150 --> 00:07:17,500
بدون أدنى شك، إنهُ أقوى متحدٍ لي على الإطلاق

124
00:07:17,500 --> 00:07:19,500
...أرني

125
00:07:20,080 --> 00:07:23,260
أنا أحترمهُ، وسوف أُسقطهُ بكل ما أملك من قوة

126
00:07:23,790 --> 00:07:25,760
فلتصمت و تُشاهد فحسب

127
00:07:26,230 --> 00:07:30,560
!وإلا ستكون هذه آخر مُباراة تكسب فيها المال مني

128
00:07:34,110 --> 00:07:36,080
.هذا ليس جيدًا

129
00:07:36,080 --> 00:07:41,280
لقد عاودتٌ القتال بقوة، ولكنني لم أستطع
تفادي جميع اللكمات التي رأيتها

130
00:07:41,280 --> 00:07:43,860
!أنا أكرهُ هذا الجسد الجبان

131
00:07:43,860 --> 00:07:47,280
.لا تتحدث، اُصمت وركز على استعادة قُدرة تحملك

132
00:07:48,740 --> 00:07:50,710
لكن ماذا سأفعل الآن؟

133
00:07:50,710 --> 00:07:53,940
لسوء الحظ، تقنيتهُ المُضادة تكاد تكون مثالية

134
00:07:53,940 --> 00:07:56,640
وفقدت كُل ما أملك من سُرعة أيضًا

135
00:07:56,640 --> 00:08:00,990
الاستمرار بحذر سوف يؤخر من سقوطي فحسب

136
00:08:02,260 --> 00:08:05,930
سأستمر بالتلويح، حتى لو كان ذلك هجومًا انتحاريًّا

137
00:08:05,930 --> 00:08:09,610
!سوف أستخدم كل ما تبقى لي من تحمل لأستمر باللكم

138
00:08:09,610 --> 00:08:11,560
!لعلي أُصيبهُ بلكمة حظ

139
00:08:12,530 --> 00:08:15,310
هل ستذهب بلا مُبالاة، محاولًا الحصول على لكمة حظ؟

140
00:08:16,810 --> 00:08:22,060
أنا مُتأكد بأنك تعلم تمامًا ما هي حالتك الآن

141
00:08:22,060 --> 00:08:26,240
الناس تدعوك بالذكي، ولكنك لست إلا أكثر عنادًا من الآخرين

142
00:08:26,240 --> 00:08:30,200
أعلم بأنك ستقوم بهجومٍ انتحاري على أن تفوز بقرار الحُكام

143
00:08:30,200 --> 00:08:32,860
.هنالك شيءٌ أدركتهُ مؤخرًا

144
00:08:32,860 --> 00:08:36,780
إنهُ شيءٌ أدركته اخيرًا بعد مُشاركتي في المُلاكمة لعدة عقود

145
00:08:36,780 --> 00:08:40,090
...لم أعترف بذلك عندما كُنّتُ ملاكمًا

146
00:08:40,460 --> 00:08:42,800
.لا توجد لكمة حظ في المُلاكمة

147
00:08:44,280 --> 00:08:48,440
.كنتُ أعتقد في يومٍ ما أنني خسرتُ بسبب لكمة حظ

148
00:08:48,440 --> 00:08:50,760
.لكنني أخطأت

149
00:08:50,760 --> 00:08:55,320
اللكمات المُتهورة التي يقوم بها المُلاكمون الذين استسلموا لن تصل أبدًا

150
00:08:55,320 --> 00:08:58,980
حتى لو أصابت واحدة، فالقبضة الميتة لن تُسقط رجلاً

151
00:09:00,370 --> 00:09:03,980
أدركتُ ذلك بعد أن أصبحتُ مدربًا

152
00:09:05,160 --> 00:09:09,220
،البعض يُلاكم من أجل المجد
و البعض يلاكم من أجل المال

153
00:09:09,220 --> 00:09:12,490
.الناس يتحملون التدريبات القاسية لأسبابهم الخاصة

154
00:09:12,860 --> 00:09:15,700
.يلكمون كيس المُلاكمة آلاف وملايين المرات

155
00:09:15,700 --> 00:09:19,280
يضعون كل إصرارهم و عزيمتهم في قبضاتهم

156
00:09:19,280 --> 00:09:21,800
....حتى إن أصابت لكمة الحظ

157
00:09:21,800 --> 00:09:24,990
فإنها نتيجة قبضات تدربت آلاف وملايين المرات...

158
00:09:25,550 --> 00:09:27,820
وتلك القبضات حية

159
00:09:29,990 --> 00:09:32,590
...القبضات التي لا تستسلم حتى آخر لحظة مُمكنة

160
00:09:32,590 --> 00:09:36,270
هي القبضات التي تصنعُ المُعجزات...

161
00:09:40,600 --> 00:09:42,410
...انا أتذكر الآن

162
00:09:42,410 --> 00:09:44,560
لقد رأيتُ العديد منهم...

163
00:09:45,430 --> 00:09:47,390
.سأفعلها إذًا

164
00:09:47,390 --> 00:09:50,780
!كلا، هنالك سبب لفعلها

165
00:09:51,210 --> 00:09:52,360
.المُساعدون للخارج

166
00:09:56,570 --> 00:09:58,540
.شُكرًا لك، أبي

167
00:10:00,120 --> 00:10:01,420
...الآن تحقق

168
00:10:03,060 --> 00:10:06,330
ما إذا كانت قبضتي حيةٌ أم لا...

169
00:10:07,440 --> 00:10:09,120
!الجولة الثالثة

170
00:10:11,030 --> 00:10:13,570
.لقد نجا المُتحدي بشقِ الأنفس في الجولةِ الثانية

171
00:10:13,570 --> 00:10:16,090
.ولكن بلا شك، ما زال على حافة الانهيار

172
00:10:16,090 --> 00:10:18,520
هل سيقضي عليه البطل في هذه الجولة؟

173
00:10:19,100 --> 00:10:22,010
من الذي سيلبس الحزام في نهاية هذه المُباراة؟

174
00:10:22,550 --> 00:10:23,700
...الآن

175
00:10:24,490 --> 00:10:25,520
ماذا؟

176
00:10:25,520 --> 00:10:29,120
إنهما لا يتحركان. كلاهما يُحدق في الآخر وسط الحلبة

177
00:10:29,120 --> 00:10:31,030
!يالها من بداية لهذه الجولة

178
00:10:31,030 --> 00:10:34,870
.لن يدعهُ البطل يأخذ راحته

179
00:10:34,870 --> 00:10:38,070
حذره دليلٌ بأن لديه الكثير من الخبرة

180
00:10:38,070 --> 00:10:42,290
برؤية أنهُ يأخذ الأمر على محمل الجد هكذا
فمن الصعب على مياتا أن يُنهي النزال بضربة قاضية

181
00:10:44,230 --> 00:10:45,270
...مياتا-كُن

182
00:10:45,880 --> 00:10:48,950
...لقد سُلبت منك المُضادات و مازلتَ مُتضررًا

183
00:10:49,540 --> 00:10:50,800
مالذي ستفلعهُ الآن؟

184
00:10:51,440 --> 00:10:53,780
إذًا من الذي سيتحرك أولاً؟

185
00:10:54,640 --> 00:10:55,300
!إنهُ قادم

186
00:10:57,590 --> 00:10:58,680
!واحد-اثنان

187
00:10:59,460 --> 00:11:00,710
!حادة وسريعة

188
00:11:00,710 --> 00:11:02,690
!ملامح البطل قد تغيرت

189
00:11:03,270 --> 00:11:04,690
.لقد قطع الهواء

190
00:11:05,210 --> 00:11:07,700
يبدو بأنهُ ما زال يمتلك بعض اللكمات الحادة

191
00:11:09,030 --> 00:11:10,360
!و ما زال يتقدم للأمام

192
00:11:10,360 --> 00:11:13,760
!المُتحدي يبدأ القتال

193
00:11:13,760 --> 00:11:15,360
هل تعافى من الأضرار؟

194
00:11:15,360 --> 00:11:17,870
!انطلق! واقضِ عليه

195
00:11:18,370 --> 00:11:20,030
.أنا لستُ مُتفاجئًا

196
00:11:20,030 --> 00:11:22,240
.لقد توقعت هذا

197
00:11:22,240 --> 00:11:24,460
.الأمر يتطلب رجلًا بشجاعة مياتا ليبدأ الهجوم

198
00:11:25,320 --> 00:11:28,250
...هجوم بتصميم عالٍ، القتال حتى آخر دقيقة، ثم سحق الخصم

199
00:11:29,250 --> 00:11:31,060
!يُمنى! وبعدها يُسرى

200
00:11:31,060 --> 00:11:33,220
!لقد قبض على البطل

201
00:11:35,330 --> 00:11:35,970
...ما

202
00:11:36,700 --> 00:11:38,610
ما بال تلك العينين؟

203
00:11:39,260 --> 00:11:41,100
إنهُ لا يُفكر بهجومٍ انتحاري

204
00:11:41,100 --> 00:11:43,640
!إنهُ مُصممٌ على الفوز في هذا القتال

205
00:11:43,640 --> 00:11:47,150
لكن بالطبع، سوف يأخذ زمام الأمور إذا لم أُعاود القتال

206
00:11:47,830 --> 00:11:50,650
!البطل يرد الهجوم على المُتحدي و يُعاود القتال

207
00:11:51,410 --> 00:11:52,600
!إنهُ تبادل لكمات

208
00:11:52,600 --> 00:11:54,780
!إنها عاصفة من اللكمات قريبة المدى

209
00:11:54,780 --> 00:11:57,660
من سيُسقط من في معركة القوة هذه!؟

210
00:11:58,370 --> 00:11:59,770
البطل!؟

211
00:11:59,770 --> 00:12:01,660
أم المُتحدي!؟

212
00:12:05,170 --> 00:12:07,750
...تبًا! لقد رأيت تلك اللكمة

213
00:12:07,750 --> 00:12:09,920
!و لكن لم أستطع تفاديها

214
00:12:10,750 --> 00:12:12,800
!ردود أفعالي مُنخفضة

215
00:12:12,800 --> 00:12:14,650
!سأعمل على أعصابي

216
00:12:14,650 --> 00:12:17,180
!ركز. ركز

217
00:12:18,770 --> 00:12:19,880
!لكمات كاملة

218
00:12:19,880 --> 00:12:22,180
!ثلاث لكمات بسرعة الضوء

219
00:12:22,180 --> 00:12:24,310
مالذي يؤخرك؟

220
00:12:24,310 --> 00:12:26,580
!إنهُ يترنح بالفعل

221
00:12:26,580 --> 00:12:28,230
!أسرع واقضِ عليه

222
00:12:29,000 --> 00:12:31,180
أتقول بأنهُ آخر عمل لكسب المال منك؟

223
00:12:31,180 --> 00:12:33,870
!لكنك ما زلت بيدقي

224
00:12:33,870 --> 00:12:38,570
سأستمر في امتصاص الرسوم الإدارية حتى تصل للقب العالمي

225
00:12:39,130 --> 00:12:41,110
هل استعاد المُتحدي إيقاعه؟

226
00:12:41,110 --> 00:12:42,620
!لقد حاصر البطل أمام الحِبال

227
00:12:42,620 --> 00:12:44,580
هل تعافى من جميع ضرره؟

228
00:12:45,040 --> 00:12:46,770
.ما زال مُتضررًا

229
00:12:46,770 --> 00:12:49,330
!إن ما يُبقيه صامدًا هي عزيمته الحديدية

230
00:12:49,880 --> 00:12:54,160
.سأقلب الأوضاع بجعله يتذكر الضرر الذي تلقاه مُسبقًا

231
00:12:54,160 --> 00:12:54,840
!على جسده

232
00:12:55,400 --> 00:12:56,840
!دفاعة صلب

233
00:12:57,290 --> 00:12:58,840
!لكنني أعلم أنهُ سيُعاود القتال

234
00:12:59,300 --> 00:13:01,870
وعندما يفعل، سوف أسدد له لكمةً قوية

235
00:13:05,030 --> 00:13:05,850
!ها هيَ

236
00:13:06,460 --> 00:13:07,810
!سأُقاطعها بيُمناي

237
00:13:09,850 --> 00:13:12,860
!مهلاً! لقد تراجع عن تسديد المُضادة

238
00:13:13,560 --> 00:13:15,860
!كلا! يستطيع إيقاف مُضادتي

239
00:13:15,860 --> 00:13:17,110
.لقد أُصبتَ بالذعر

240
00:13:20,220 --> 00:13:23,620
!لكمة للجسد! و يالها من لكمةٍ تفجيرية

241
00:13:35,120 --> 00:13:36,450
!سأُقاطعها بيُمناي

242
00:13:38,490 --> 00:13:41,490
!مهلاً! لقد تراجع عن تسديد المُضادة

243
00:13:42,290 --> 00:13:44,500
!كلا! سيستطيع التصدي لمُضادتي

244
00:13:44,500 --> 00:13:45,750
.لقد أُصبتَ بالذُعر

245
00:13:48,830 --> 00:13:52,260
!لكمة للجسد! و يالها من لكمةٍ تفجيرية

246
00:13:54,970 --> 00:13:56,090
!إيتشيرو

247
00:13:56,490 --> 00:13:58,210
!لقد فقد المُتحدي زخمه

248
00:13:58,210 --> 00:14:00,100
!والبطل يُحاول الإنهاء الآن

249
00:14:00,590 --> 00:14:04,060
!لقد قلب الوضع، بلكمةٍ واحدة فحسب

250
00:14:04,060 --> 00:14:06,850
ما زال يحمل ذلك القدر من الضرر؟

251
00:14:06,850 --> 00:14:08,620
.لقد قاتلت جيدًا

252
00:14:08,620 --> 00:14:12,230
ولكنك لن تستطيع العودة بعد هذا الضرر العاطفي و الجسدي

253
00:14:12,230 --> 00:14:15,240
كل ما علي فعله هو تدمير روحك القتالية
و إفقادك الوعي

254
00:14:15,240 --> 00:14:17,410
!كل ما أحتاجهُ هو هذه اللكمة

255
00:14:20,480 --> 00:14:22,240
.هذه هي النهاية مياتا

256
00:14:25,970 --> 00:14:27,750
مُستحيل! إنهُ يُعاود القتال!؟

257
00:14:31,530 --> 00:14:34,230
ما...هذه؟

258
00:14:34,230 --> 00:14:36,260
لماذا يستمر بالقتال في هذه الحالة؟

259
00:14:39,190 --> 00:14:40,850
!ليس لروحه القتالية دخل

260
00:14:40,850 --> 00:14:44,020
!ما يُبقيه واقفًا هو شيءٌ مُختلف كُليًا

261
00:14:44,020 --> 00:14:46,020
لكن ماهوَ؟

262
00:14:47,430 --> 00:14:50,020
...ما زال لدي ذلك الوعد

263
00:14:57,400 --> 00:14:58,530
...مياتا-كُن

264
00:14:59,260 --> 00:15:03,030
...سأدركه هذه المرة

265
00:15:07,440 --> 00:15:11,540
ذلك الوعد الذي لم أستطع الحفاظ عليه...

266
00:15:15,490 --> 00:15:20,050
!لن أسمح لنفسي بالخروج من هذه الحلبة كاذبًا

267
00:15:21,400 --> 00:15:25,020
!مياتا-كُن

268
00:15:22,920 --> 00:15:25,020
!انطلق مياتا

269
00:15:25,020 --> 00:15:28,310
!لا تستسلم الآن! البطل يرتعد خوفًا

270
00:15:28,310 --> 00:15:48,200
!مـ...يا...تا! مـ...يا...تا

271
00:15:37,770 --> 00:15:40,890
لا داعي للقلق. أنا المُنتصر في هذا القتال

272
00:15:40,890 --> 00:15:44,830
.كل ما يجب علي فعلهُ هو إنهاء روحه من المُعاناة

273
00:15:45,280 --> 00:15:47,200
!سوف أُنهيه بهذه اللكمة

274
00:15:49,430 --> 00:15:50,770
!البطل ينطلق

275
00:15:50,770 --> 00:15:53,210
!خطوتهُ واسعة! سيُسدد تلويحة يسارية

276
00:15:56,210 --> 00:15:57,060
!توقفا

277
00:15:57,060 --> 00:15:58,300
!رن الجرس

278
00:15:58,300 --> 00:16:00,720
!لقد رن الجرس في لحظة تقاطع ذراعهما

279
00:16:01,150 --> 00:16:03,720
!هكذا تنتهي الجولة الثالثة

280
00:16:06,720 --> 00:16:08,580
!لقد أضعت الكثير من الوقت

281
00:16:08,580 --> 00:16:10,850
!كانت لديك العديد من الفُرص لإسقاطه

282
00:16:10,850 --> 00:16:12,440
!أنا أعلم مالذي حدث

283
00:16:12,440 --> 00:16:14,520
لقد أُصبت بالهلع من روحه القتالية، أليس كذلك؟

284
00:16:14,520 --> 00:16:16,020
!ياللعار

285
00:16:16,020 --> 00:16:18,230
!كان ذلك مُهينًا لي بما أنني مُنظم مُبارايات

286
00:16:18,660 --> 00:16:22,590
قيمتك ستنخفض إذا لم تتمكن من القضاء على مُلاكمين كهذا

287
00:16:24,220 --> 00:16:25,490
تتحدث عن العمل مُجددًا؟

288
00:16:26,320 --> 00:16:29,510
.بالطبع. فأنتَ مُحترف

289
00:16:29,510 --> 00:16:31,750
.وظيفتك هي جذب المُشاهدين

290
00:16:31,750 --> 00:16:33,460
.لا تقلق

291
00:16:33,460 --> 00:16:34,900
!سأسقطهُ في الجولة التالية

292
00:16:34,900 --> 00:16:38,220
!أجل! هذا ما أردتُ سماعه

293
00:16:38,220 --> 00:16:39,760
!نعم! نعم

294
00:16:41,410 --> 00:16:44,260
.فلتقلق بشأن مُستقبلك قبل أن تبدأ بالاحتفال

295
00:16:46,290 --> 00:16:49,240
.لقد كُنتَ جيدًا كـ مُديري الفني

296
00:16:49,240 --> 00:16:52,280
،كُنتُ أستغل ذلك ايضًا

297
00:16:52,280 --> 00:16:56,760
ولكن ليس لدي أي نية بالعودة إلى مُساعد لا يهتم بشأن مشاعر مُلاكمة

298
00:16:56,760 --> 00:16:58,780
ماذا تقصد بهذا؟

299
00:16:59,290 --> 00:17:02,530
.سيد ساكاجوتشي، أنت مطرود

300
00:17:03,640 --> 00:17:05,350
.هذه نهاية صفقتنا

301
00:17:07,300 --> 00:17:10,330
هل تعتقد أن بإمكانك فعل ذلك؟

302
00:17:10,330 --> 00:17:12,540
.لأنكَ ما زلتَ مُرتبطًا بعقد

303
00:17:12,980 --> 00:17:15,390
.سوف أشكرك على شيءٍ واحد فقط

304
00:17:15,390 --> 00:17:18,450
على الرغم من أنك لا تعتبر المُلاكمة إلا مُجرد عمل

305
00:17:18,450 --> 00:17:21,550
.إلا أنك نظمت لي مُباراة مع أفضل خصم في النهاية

306
00:17:21,550 --> 00:17:24,210
النهاية؟ هل تمزحُ معي؟

307
00:17:24,210 --> 00:17:27,550
--سنستمر بتبادل المصالح

308
00:17:26,130 --> 00:17:27,550
أغرب عن وجهي

309
00:17:28,470 --> 00:17:31,530
،سوف أهزم إيتشيرو مياتا

310
00:17:31,530 --> 00:17:33,810
!و سأذهب للعالمية لوحدي

311
00:17:34,480 --> 00:17:37,130
.مـ...ماء

312
00:17:37,130 --> 00:17:38,820
.لا تشرب كثيرًا

313
00:17:43,010 --> 00:17:45,490
.يالهُ من شعور جيد

314
00:17:45,490 --> 00:17:49,720
...لا أعلم مقدار فائدتها لهذا الجسد الخالي من الطاقة

315
00:17:49,720 --> 00:17:53,410
...ولكن الآن يوجد لدي

316
00:17:53,410 --> 00:17:55,790
ما يكفي للكمة واحدة...

317
00:17:56,860 --> 00:17:58,560
.هذا كافٍ

318
00:17:58,560 --> 00:18:01,300
.مُضادة بكل ما أملك من قوة ستكون كافية

319
00:18:02,480 --> 00:18:04,050
.المُساعدون للخارج

320
00:18:05,410 --> 00:18:06,430
,إيتشيرو

321
00:18:10,760 --> 00:18:12,060
.اذهب ونل منه

322
00:18:16,530 --> 00:18:19,020
.بدا مُصممًا

323
00:18:19,020 --> 00:18:21,740
.إنه ينوي جعل هذه الجولة الأخيرة

324
00:18:21,740 --> 00:18:24,320
.إنهُ يعلم أنهُ وصل لحدوده

325
00:18:24,740 --> 00:18:26,360
!الجولة الرابعة

326
00:18:27,040 --> 00:18:27,970
!تلاكما

327
00:18:29,300 --> 00:18:31,080
.لابد بأنك تُشاهد الآن

328
00:18:31,080 --> 00:18:34,080
.لم أنسَ الوعد الذي بيننا

329
00:18:35,350 --> 00:18:36,590
.سأُحافظ عليه بكل تأكيد

330
00:18:37,170 --> 00:18:38,170
!ياللهول

331
00:18:38,860 --> 00:18:40,100
!المُتحدي يُلوح له

332
00:18:40,100 --> 00:18:43,920
!إنهُ يدعو البطل ليأتي وينال منه

333
00:18:43,920 --> 00:18:46,380
ماذا سيكون رد البطل!؟

334
00:18:46,380 --> 00:18:48,150
!ليس سيئًا

335
00:18:48,150 --> 00:18:50,060
.لن أتجرأ على رفض ذلك

336
00:18:50,060 --> 00:18:52,180
سوف أواجهه مُباشرةً

337
00:18:53,090 --> 00:18:54,890
.لقد بدأ الهجوم

338
00:18:54,890 --> 00:18:55,960
!يسارية! يمينية

339
00:18:55,960 --> 00:18:57,810
!لقد ضاعت الكثير من الضربات

340
00:18:58,440 --> 00:19:02,070
!سأضمن فوزي إذا أبقيت مسافة آمنة بيننا

341
00:19:02,650 --> 00:19:06,320
ولكن كيف لي أن أُسمي نفسي بطلاً إذا فعلتُ ذلك مع رجل شبه ميت؟

342
00:19:06,910 --> 00:19:09,910
،أنا لا أرغب في الدفاع عن اللقب فحسب

343
00:19:09,910 --> 00:19:12,330
!أُريدُ هزيمتهٌ و التوجه إلى اللقب العالمي

344
00:19:12,330 --> 00:19:13,830
!إنها لكمات قوية

345
00:19:13,830 --> 00:19:15,950
!ولكنني شاكرٌ لك

346
00:19:15,950 --> 00:19:18,790
!أن يقترب بهذا القدر مع علمه بضرري

347
00:19:19,230 --> 00:19:21,790
بعد تفاديه لتلك اللكمات
ها هو يُطلق وابلاً منها

348
00:19:21,790 --> 00:19:23,220
!إنها لا تؤلم على الإطلاق

349
00:19:23,220 --> 00:19:25,050
!لكماتك ميتة بالفعل

350
00:19:25,050 --> 00:19:27,770
!ياللهول! لقد تلقى المُتحدي لكمة

351
00:19:27,770 --> 00:19:28,970
!تراجعت خُطواته للحبال

352
00:19:28,970 --> 00:19:31,700
هذا سيء! لن يستطيع القتال مع هذا الضرر

353
00:19:31,700 --> 00:19:33,470
لا تغتر بحظك، قم باحتضانه

354
00:19:33,840 --> 00:19:37,340
.يُريد القضاء عليه بلكمة واحدة، مياتا اللعين

355
00:19:37,340 --> 00:19:38,350
بمُضادة؟

356
00:19:38,350 --> 00:19:40,230
!ولكن ماذا عن التقاطع الدموي

357
00:19:41,300 --> 00:19:43,580
.إنهُ يستمر بدفعه بقوة

358
00:19:43,580 --> 00:19:45,830
.هنالك لكمة واحدة قادرة على تغير الوضع

359
00:19:45,830 --> 00:19:46,880
!مُضادة

360
00:19:47,900 --> 00:19:50,240
لم يتبقَّ لديه الكثير من الوقت

361
00:19:50,240 --> 00:19:52,490
!مع علمه بأنها مُخاطرة، يجب عليه تسديدها

362
00:19:53,540 --> 00:19:55,810
...في كلتا الحالتين، اللكمة التالية

363
00:19:56,710 --> 00:19:58,250
...ستكون الأخيرة

364
00:19:58,730 --> 00:20:00,930
!البطل يُحاول كسر دفاع مياتا

365
00:20:00,930 --> 00:20:03,000
!يبدو أنها مسألة وقت فحسب

366
00:20:03,440 --> 00:20:05,920
.ليست لديك فُرصة في المدى القريب

367
00:20:05,920 --> 00:20:07,460
حان وقت إنهاء الأمر

368
00:20:08,540 --> 00:20:11,010
!لكمة تفجيرية للكبد

369
00:20:11,010 --> 00:20:14,840
!اللكمة قد حطمت روح المُتحدي

370
00:20:14,840 --> 00:20:16,760
...هل هذا حدي

371
00:20:18,970 --> 00:20:21,520
.و ينقض على فك المُتحدي بيُمناه

372
00:20:22,080 --> 00:20:24,050
هل هذه الضربة القاضية؟

373
00:20:25,490 --> 00:20:27,110
.كلا، ليس بعد

374
00:20:28,250 --> 00:20:30,050
...لم أقم باستخدام

375
00:20:30,740 --> 00:20:34,290
القوة الموجودة في جسدي
لتسديد لكمة أخيرة

376
00:20:34,290 --> 00:20:36,040
.لم أستخدمها بعد

377
00:20:36,580 --> 00:20:37,920
.إنها النهاية

378
00:20:40,890 --> 00:20:41,790
!الآن

379
00:20:45,150 --> 00:20:46,660
!لقد جهز لكمته بالفعل

380
00:20:46,660 --> 00:20:47,550
مُضادة؟

381
00:20:47,550 --> 00:20:50,100
!آخر ما تبقى لي من قوة

382
00:20:50,100 --> 00:20:52,050
!أفضل ما لدي

383
00:20:52,050 --> 00:20:54,140
!انطلق

384
00:20:57,690 --> 00:20:58,810
!لقد تصدى لها

385
00:20:58,810 --> 00:21:00,750
!التقاطع الدموي قادم

386
00:21:00,750 --> 00:21:02,440
!اللعنة! قُم بتفاديها

387
00:21:02,840 --> 00:21:04,690
!الأمر ميئوسٌ منه الآن

388
00:21:04,690 --> 00:21:07,700
!نهايتها تكون في اللحظة التي أحني فيها ذراعك

389
00:21:07,700 --> 00:21:09,940
!وداعًا، يا إيتشيرو مياتا

390
00:21:20,370 --> 00:21:21,720
!لقد دفعها بقوة

391
00:21:22,690 --> 00:21:23,960
!ليس بذراعة فحسب

392
00:21:24,560 --> 00:21:26,790
!بل وضع كامل وزنه فيها

393
00:21:42,180 --> 00:21:42,850
...لـ

394
00:21:43,550 --> 00:21:45,810
!لقد سقط

395
00:22:55,720 --> 00:22:59,910
الحلقة الرابعة