1
00:01:14,600 --> 00:01:18,370
!إنهُ يُناشد القاعة لتشجيعه

2
00:01:18,370 --> 00:01:20,680
!إنهٌ يُعلن الضربة القاضية

3
00:01:24,400 --> 00:01:29,200
"الأيدي التي تدعمه"

4
00:01:24,400 --> 00:01:29,200
الحلقة 23

5
00:01:29,400 --> 00:01:31,400
!سوف يُنهيها في الجولة التالية

6
00:01:31,400 --> 00:01:33,400
!الحزام في متناول اليد

7
00:01:33,780 --> 00:01:36,340
.الـ-الهتاف صاخبٌ للغاية

8
00:01:36,340 --> 00:01:38,410
!إنهُ يعرف كيف يُحمسنا

9
00:01:38,930 --> 00:01:40,810
.جسدي يرتعش من الحماس

10
00:01:40,810 --> 00:01:42,410
.إنهُ مُثيرٌ للغاية

11
00:01:42,410 --> 00:01:44,190
أتريد إنهائها؟

12
00:01:44,190 --> 00:01:47,410
.لقد انطلقتَ برتمٍ جيد، و هذا شيءٌ جيد لتبدأ به

13
00:01:47,410 --> 00:01:48,290
!إفعلها

14
00:01:49,050 --> 00:01:51,080
!المُتحدّي ينطلق

15
00:01:51,080 --> 00:01:53,590
!إنهُ يتجه مُباشرةً لحزام البطل

16
00:01:57,590 --> 00:01:59,470
.انا أعاني من وقتٍ عصيب

17
00:01:59,470 --> 00:02:01,600
...لم يحصل لي هذا من قبل

18
00:02:03,050 --> 00:02:04,600
...و لكن

19
00:02:05,200 --> 00:02:07,100
!لم يحدث هذا إلا في الحلبة

20
00:02:08,140 --> 00:02:10,200
!يا إلهي! البطل يهجم كذلك

21
00:02:10,200 --> 00:02:12,270
!يهجم و يهجم و يهجم

22
00:02:12,270 --> 00:02:14,800
!هجومٌ إنتقامي

23
00:02:16,770 --> 00:02:19,730
!لقد كنتُ في المئازق مراتٍ عديدة في مدينتي

24
00:02:26,680 --> 00:02:32,540
كل رجلٍ صوب المُسدس نحوي
.و هوَ واثقٌ من فوزه مُبتسمًا

25
00:02:33,240 --> 00:02:34,550
...و لكن

26
00:02:39,170 --> 00:02:41,260
.لقد نجوتُ دائمًا

27
00:02:42,320 --> 00:02:46,810
،مٌقارنةً بتلك المئازق
.في الحلبة، داخل هذه الحبال

28
00:02:47,710 --> 00:02:50,100
!تجعلني أتثاءب أيها الياباني

29
00:02:51,230 --> 00:02:52,600
!لا تتوانى يا تاكامورا

30
00:02:52,600 --> 00:02:55,960
!بامكانك إنهاء الأمر برتمك هذا

31
00:02:57,100 --> 00:03:00,270
!يا إلهي! الآن المُتحدّي يُطلقها

32
00:03:00,270 --> 00:03:02,290
!لكمةٌ قوية توقف وابل اللكمات

33
00:03:02,290 --> 00:03:06,790
!لستَ سيئًا، ما زلتَ تُقاتل حتى بعد أن تلقيت العديد من لكماتي

34
00:03:06,790 --> 00:03:07,490
...لكن

35
00:03:08,070 --> 00:03:09,500
!هذه النهاية

36
00:03:09,950 --> 00:03:12,490
!سأنهي المُباراة في هذه الجولة

37
00:03:12,490 --> 00:03:14,500
!هذه الجولة

38
00:03:14,910 --> 00:03:17,760
!إنهُ يُسدد وابل لكماته الآن

39
00:03:18,510 --> 00:03:19,700
!سيستطيع فعلها

40
00:03:19,700 --> 00:03:21,010
!أجل، هكذا

41
00:03:21,010 --> 00:03:22,200
!بامكانه فعلها

42
00:03:22,200 --> 00:03:23,010
!بامكانه الفوز

43
00:03:23,670 --> 00:03:25,470
.هُناك شيءٌ لا أفهمه

44
00:03:25,470 --> 00:03:29,480
بعد مُشاهدتهم لـ اربع جولات
.فإن قُدرتهم على التحمل مُتساوية تقريبًا

45
00:03:29,850 --> 00:03:32,560
!كأنهما ماكينتين من نفس نوع المُحرك

46
00:03:32,560 --> 00:03:35,560
لماذا إذن يتلقى الضربات؟

47
00:03:36,680 --> 00:03:37,670
!مهلًا

48
00:03:40,240 --> 00:03:42,200
!البطل يتفادى الوقوف عند الحبال

49
00:03:43,160 --> 00:03:45,160
!لكنهُ لا يُفلت

50
00:03:45,160 --> 00:03:46,720
!هذه الجولة

51
00:03:46,720 --> 00:03:48,740
!سوفَ أنهيها في هذه الجولة

52
00:03:49,100 --> 00:03:50,270
!لكمة علوية

53
00:03:50,270 --> 00:03:51,250
!إصابة مُباشرة

54
00:03:51,980 --> 00:03:53,470
!و يتبعها بيسارية

55
00:03:53,470 --> 00:03:55,630
!هذه الجولة مهما حدث

56
00:03:55,630 --> 00:03:56,420
!هوك

57
00:04:06,360 --> 00:04:09,100
!مهلًا! لكمة جسدية من البطل

58
00:04:09,100 --> 00:04:11,810
!إنها أول لكمة جسدية له في هذه المُباراة

59
00:04:14,150 --> 00:04:16,060
!إنهُ لا يتوانى! و يندفع للأمام

60
00:04:16,060 --> 00:04:19,820
.لن تكسر جسد تاكامورا المبني جيدًا بكلمةٍ واحدة

61
00:04:19,820 --> 00:04:22,210
!تاكامورا-سان! أنتَ البطل

62
00:04:22,210 --> 00:04:23,700
!إقضي عليه

63
00:04:25,570 --> 00:04:27,400
!البطل يُعزز دفاعة

64
00:04:27,400 --> 00:04:29,580
!إنهُ دفاعٌ شامل

65
00:04:29,580 --> 00:04:32,960
!و المُتحدّي يستمر باللكم و يُصيبة رغم دفاعه

66
00:04:32,960 --> 00:04:35,130
!إنهُ وابل لكمات يشتعل لهيبًا من المُتحدّي

67
00:04:35,130 --> 00:04:36,210
!إسقط

68
00:04:36,210 --> 00:04:38,340
!إسقط أيها السافل

69
00:04:38,340 --> 00:04:40,590
!إسقط! إسقط

70
00:04:40,590 --> 00:04:42,590
!إسقــــط

71
00:04:42,590 --> 00:04:43,720
!توقف

72
00:04:43,720 --> 00:04:45,300
!لقد تدخل الحكم

73
00:04:45,300 --> 00:04:46,220
!لقد أوقفهما

74
00:04:46,900 --> 00:04:49,400
هل إنتهت؟

75
00:04:50,750 --> 00:04:53,020
!يا إلهي، لقد رن الجرسُ بالفعل

76
00:04:53,020 --> 00:04:55,060
!الهدير الذي يصم الآذان قد أخفى الصوت

77
00:04:55,060 --> 00:04:57,730
!البطل ينجو من هذه الجولة

78
00:04:57,730 --> 00:05:02,170
الضربة القاضية التي أعلنها لم تحصل
.لكنها كانت جولة المُتحدّي بالكامل

79
00:05:02,170 --> 00:05:05,730
!ما تزال هُنالك آمالٌ كبيرة للجولةِ التالية

80
00:05:07,610 --> 00:05:08,830
هكذا إذن؟

81
00:05:09,420 --> 00:05:11,450
!لقد رن الجرس بالفعل

82
00:05:11,450 --> 00:05:13,660
.ليسَ باليدِ حيلة

83
00:05:18,260 --> 00:05:20,060
.هذا صحيح

84
00:05:23,260 --> 00:05:25,510
.لقد أُصبتَ بجروحٍ بالغة

85
00:05:25,850 --> 00:05:29,230
.لم أرك قطّ تتعرض لكل هذا الضرب

86
00:05:29,230 --> 00:05:31,400
.لديه لكماتٌ جيدة

87
00:05:31,400 --> 00:05:33,200
.ذلك المُتحدّي قوي

88
00:05:33,200 --> 00:05:34,860
.إنهُ كذلك

89
00:05:34,860 --> 00:05:36,480
.أراه بوضوحٍ الآن

90
00:05:36,480 --> 00:05:40,030
.أجل، أنا كذلك

91
00:05:41,520 --> 00:05:42,530
!كان ذلك وشيكًا

92
00:05:42,530 --> 00:05:43,810
!لكنك قمتَ بعملٍ عظيم

93
00:05:43,810 --> 00:05:46,180
!سوفَ تستمر في الجولةِ التالية

94
00:05:46,180 --> 00:05:47,530
!إستمر بنفس الوتيرة

95
00:05:49,400 --> 00:05:50,100
—يا عجوز

96
00:05:50,100 --> 00:05:51,010
!لا تتحدث

97
00:05:51,010 --> 00:05:53,060
!إسترح و حافظ على طاقتك

98
00:05:53,060 --> 00:05:54,540
.دعني أمسحُ عنك العرق

99
00:05:59,590 --> 00:06:01,550
...تاكا...مورا

100
00:06:04,920 --> 00:06:07,510
.لاحظتَ الآن

101
00:06:08,710 --> 00:06:10,520
.يالهُ من مُساعدٍ أحمق

102
00:06:10,520 --> 00:06:13,510
.لقد أدركَ أخيرًا حالة مُلاكمة

103
00:06:13,890 --> 00:06:17,300
.أجل، كِلانا نمتلك نفس الماكينتان

104
00:06:17,300 --> 00:06:19,060
.لكن لماذا كان مُتفوقًا علينا

105
00:06:19,060 --> 00:06:20,600
.الإجابة بسيطة

106
00:06:20,600 --> 00:06:24,020
،أحدهما كان يُقاتل بأقصى ما لديه
.و لم يقلق بشأن كامل القتال

107
00:06:25,470 --> 00:06:27,360
ما الخطب؟

108
00:06:27,360 --> 00:06:31,070
.لم يخرج أي عرق بعد أن مسحت العرق عنه

109
00:06:31,520 --> 00:06:34,030
!إنهُ لا يتعرق على الإطلاق

110
00:06:34,580 --> 00:06:39,570
.ظننتُ بأنني سأنطلق بكل ما لدي بينما أستطيعُ ذلك

111
00:06:40,460 --> 00:06:42,960
.لكنني فارغٌ الآن

112
00:06:42,960 --> 00:06:44,750
.بالكامل

113
00:06:46,340 --> 00:06:48,450
.لقد عرفت ذلك منّذُ تحكمي بالوزن

114
00:06:48,450 --> 00:06:53,140
.أن بامكاني القتال بشكلٍ طبيعي لمدة  أقصاها 5 جولات في هذا الوزن

115
00:06:53,140 --> 00:06:54,080
!لا تتحدث

116
00:06:54,080 --> 00:06:55,100
!ياغي-تشان، ماء

117
00:06:55,100 --> 00:06:57,420
!صُب كل ما لدينا على رأسه

118
00:06:57,420 --> 00:06:58,300
!حاضر

119
00:07:00,330 --> 00:07:04,070
.لقد ظهر الألم على وجهه بعد لكمة الجسد

120
00:07:04,070 --> 00:07:06,530
.كان الأمرُ واضحًا

121
00:07:06,530 --> 00:07:09,110
.بدون ادنى شك، لقد إنتهى مخزونه

122
00:07:10,140 --> 00:07:12,070
!المُساعدون للخارج

123
00:07:13,720 --> 00:07:15,740
!سأعذبه حتى الموت

124
00:07:18,140 --> 00:07:19,640
...تاكامورا

125
00:07:19,640 --> 00:07:21,970
"إستخدم قوة الروح عندما تنتهي طاقتك"

126
00:07:21,970 --> 00:07:24,250
أليسَ هذا ما تقوله دائمًا؟

127
00:07:24,720 --> 00:07:27,530
.حسنًا، سأفعلها بطريقةٍ ما

128
00:07:29,200 --> 00:07:30,840
.الآن تبدأ الجولة السادسة

129
00:07:30,840 --> 00:07:33,260
هل سيتغير مالك العرش؟

130
00:07:33,260 --> 00:07:35,400
.الجماهير تتوقع الأفضل الآن

131
00:07:35,400 --> 00:07:38,800
يرغبون برؤية هجومٍ شرس من صقر اليابان
.كما ظهر في الجولةِ الخاسة

132
00:07:38,800 --> 00:07:40,870
!يُريدون رؤية ضربة قاضية

133
00:07:43,310 --> 00:07:46,770
!يا إلهي! هجوم البطل يُحطم توقعات الجماهير

134
00:07:46,770 --> 00:07:48,790
.الوضع إختلف كُليًّا الآن

135
00:07:48,790 --> 00:07:50,610
!إنها وتيرة البطل بالكامل

136
00:07:50,610 --> 00:07:53,530
!المُتحدّي مُحاصرٌ أمام الحبال

137
00:07:54,440 --> 00:07:55,530
.كان مُلاكمًا جيدًا

138
00:07:55,530 --> 00:07:59,210
.ربما كنتُ سأتمكن من جعله بطلًا للعالم

139
00:07:59,210 --> 00:08:03,540
.لكنهُ سيُحطم من هوك و لن تأتيه الفُرصة ثانيةً

140
00:08:04,010 --> 00:08:06,290
.كل هذا بسبب مُساعدة الغير كفؤ

141
00:08:06,850 --> 00:08:08,830
!أنا آسف! يا تاكامورا

142
00:08:08,830 --> 00:08:10,800
!كل الخطأ يقع على عاتقي

143
00:08:11,270 --> 00:08:14,300
،لا تستخدم أعذارًا مثل
"لو لم أمر بتحكم الوزن"

144
00:08:14,300 --> 00:08:18,310
أنتَ تعرف قواعد قِتال الشوارع جيدًا، أليسَ كذلك؟

145
00:08:18,930 --> 00:08:20,060
،بغض النظر عما يحدث

146
00:08:20,620 --> 00:08:22,060
،بغض النظر عن ما تفعله

147
00:08:22,420 --> 00:08:25,820
...من يبقى واقفًا في النهاية

148
00:08:29,990 --> 00:08:31,830
!هوَ الأقوى

149
00:08:31,830 --> 00:08:33,820
!سـ-سقوط

150
00:08:33,820 --> 00:08:35,320
!يا لهُ من تغير

151
00:08:35,320 --> 00:08:40,420
توقعنا من المٌتحدّي ضربةً قاضية
. لكنهُ سقط بدلًا من ذلك

152
00:08:51,390 --> 00:08:53,770
!هل ترون هذا أيها اليابانيين؟

153
00:08:56,730 --> 00:09:00,600
!إنهُ يُعيد نفس ما فعله المُتحدّي سابقًا

154
00:09:01,230 --> 00:09:03,600
!لكن المُتحدّي ينهض

155
00:09:03,950 --> 00:09:07,060
!لم يستسلم بعد! إنهُ يقف مُجدّدًا

156
00:09:10,230 --> 00:09:13,200
.مظهره يبدو مُختلفًا بشكلٍ مؤلم عن السابق

157
00:09:13,200 --> 00:09:16,610
.عينهُ اليُمنى مُنتفخة و وجهه مُغطًا بالدماء

158
00:09:16,610 --> 00:09:21,160
!لكن غريزة المُلاكمة ترفض بدأ العد

159
00:09:21,160 --> 00:09:22,630
!تاكامورا-سان

160
00:09:22,630 --> 00:09:24,120
...إنهُ تحكم الوزن

161
00:09:24,620 --> 00:09:26,680
...إذا لم يكن يُعاني من تحكم الوزن

162
00:09:27,370 --> 00:09:30,380
!هذا لن يحدث إذا كان تاكامورا-سان في أفضل حالاته

163
00:09:30,380 --> 00:09:32,880
هل قال أنهُ كان صعبًا داني؟

164
00:09:34,270 --> 00:09:38,890
هل ذكر ذلك الرجل أثناء التحكم بالوزن
بأنهُ كان أمرًا شاقًا؟

165
00:09:38,890 --> 00:09:44,890
أنا مُتأكدٌ من أنهُ كان يعلم
.بأنهُ يمكنه أن يستمر خمس جولاتٍ فقط

166
00:09:50,420 --> 00:09:53,780
.إنهُ يُدرك أيضًا مقدار ما يتوقعه الناس منه

167
00:09:53,780 --> 00:09:56,260
،حتى عندما جُرح كبريائه

168
00:09:56,260 --> 00:09:57,990
،قام بقمع عواطفه

169
00:09:57,990 --> 00:10:01,890
،التزم الصمت ولم يتذمر أبدًا

170
00:10:01,890 --> 00:10:07,340
.و بنى جسدًا لا يُقاتل سوى لخمس جولاتٍ محدودة

171
00:10:08,340 --> 00:10:09,960
،كـ مُلاكمٍ مثله

172
00:10:09,960 --> 00:10:14,920
كلا- كـ رجلٍ مثله، هل ستفعل نفس الشيء؟

173
00:10:14,920 --> 00:10:16,920
.هذا يجعلني أبكي

174
00:10:16,920 --> 00:10:22,430
!عندما أرى كبرياء هذا الرجل وهوَ يُدمر هكذا، فإنهُ يجعلني أبكي

175
00:10:23,660 --> 00:10:24,930
!تاكامورا-سان

176
00:10:26,580 --> 00:10:28,320
!المُباراة تُستأنف

177
00:10:28,320 --> 00:10:30,940
.البطل يقترب ببطء

178
00:10:31,780 --> 00:10:33,940
حتى لو نهضت فمالذي بإمكاني فعله؟

179
00:10:34,320 --> 00:10:36,440
مالذي أستطيع فعله في هذا الوضع؟

180
00:10:38,490 --> 00:10:43,130
.حتى وأنا في هذا الوضع، مُتأكدٌ من أن الجميع يتوقعون الكثير مني

181
00:10:43,130 --> 00:10:47,000
.يا رجل، أن تكونَ نجمًا ليسَ بالأمر الهين

182
00:10:47,620 --> 00:10:51,250
.بما اني أستطيع تحريك أصابعي، سأقاتلك حتى الموت

183
00:10:51,250 --> 00:10:54,250
.التوتر يزداد بينما المسافة بينهما تتقلص

184
00:10:54,250 --> 00:10:56,730
!الجماهير كلهم سكتوا

185
00:10:56,730 --> 00:11:00,030
!خيم الصمت على قاعة ريكوجوكو كوكوجيكان

186
00:11:11,130 --> 00:11:13,730
.لقد هدأتم الآن

187
00:11:14,650 --> 00:11:17,570
.فقط اجلسوا وشاهدوا أيها اليابانيين

188
00:11:18,480 --> 00:11:21,320
!حان وقتُ العرض

189
00:11:24,370 --> 00:11:25,740
ما هذا؟

190
00:11:25,740 --> 00:11:27,750
!حتى الذبابة يمكن أن تهبط عليها

191
00:11:28,380 --> 00:11:31,590
.عينهُ اليُمنى مُنتفخة، لذلك لا يستطيع رؤية هوك

192
00:11:31,590 --> 00:11:32,500
.هذا سيء

193
00:11:32,930 --> 00:11:34,460
.ما زال يتلقى اللكمات

194
00:11:34,460 --> 00:11:36,250
.قد يوقف الحكم المُباراة

195
00:11:36,250 --> 00:11:39,340
.ربما يكون من الأفضل لو فعلها

196
00:11:39,340 --> 00:11:43,990
...لكمات الوزن المتوسط الخفيف بامكانها

197
00:11:43,990 --> 00:11:45,260
.إنهاء حياة الرجل

198
00:11:47,040 --> 00:11:47,890
...مياتا

199
00:11:48,370 --> 00:11:54,150
.اظن أنهُ أكثر شخصٍ عاشر تاكامورا من بينهم

200
00:11:54,150 --> 00:11:55,440
!رُكبتيه فد انحنت

201
00:11:55,810 --> 00:11:57,870
!لا يُمكنه تحمل هجوم البطل العنيف

202
00:11:57,870 --> 00:11:59,400
هل سيسقط؟

203
00:11:59,400 --> 00:12:01,220
!كلا، إنهُ يُعاود القتال

204
00:12:01,220 --> 00:12:02,430
!لكنهُ يُصيب الهواء

205
00:12:03,810 --> 00:12:06,450
.يبدو أن مامورو يمر بوقتٍ عصيب

206
00:12:06,450 --> 00:12:08,370
!أخي سوجورو

207
00:12:08,370 --> 00:12:11,950
لنتمنى بأن يخرج من الحلبة بدون
.إصاباتٍ بليغة دائمة

208
00:12:12,690 --> 00:12:16,620
.وإلا فإن المكتب الذي جهزتهُ له في الشركة سيذهبُ سُدى

209
00:12:16,620 --> 00:12:18,960
!لكنَ أخي مامورو ما زال يُقاتل

210
00:12:18,960 --> 00:12:21,950
.النتيجة واضحة حتى لغير المُعجبين بالمُلاكمة

211
00:12:21,950 --> 00:12:23,970
.فلتقلق على جسده إذا كنتَ أخًا له

212
00:12:26,350 --> 00:12:29,930
!أنتَ لا تعلم من المُنتصر ما دامت لم تنتهي

213
00:12:31,130 --> 00:12:32,940
...مامورو-تشان

214
00:12:33,510 --> 00:12:35,440
!قوة البطل لا تُصدق

215
00:12:35,440 --> 00:12:37,960
!يتراكم الضرر حتى مع دفاعه

216
00:12:37,960 --> 00:12:39,590
.لقد أشعل النار

217
00:12:39,590 --> 00:12:41,930
!روحه المُشتعلة لن تُتطفأ الآن

218
00:12:41,930 --> 00:12:44,490
...سيتم تعنيف تاكامورا

219
00:12:45,240 --> 00:12:48,450
.حتى يصل هوك إلى نشوته

220
00:12:55,880 --> 00:12:58,000
مالذي تنظر إليه أيها العجوز؟

221
00:12:58,840 --> 00:13:01,140
!إنهُ فاقدٌ للوعي

222
00:13:01,140 --> 00:13:01,960
...لو بالغتَ قليلًا

223
00:13:02,980 --> 00:13:04,440
!توقف! ستقتله

224
00:13:04,440 --> 00:13:05,420
!حقًا ستقتله

225
00:13:05,420 --> 00:13:06,680
!لا توقفني

226
00:13:06,680 --> 00:13:09,180
!لا أهتم بما سيحدث له

227
00:13:09,180 --> 00:13:11,160
!أنا ساخن

228
00:13:11,160 --> 00:13:12,220
...أنا

229
00:13:12,220 --> 00:13:15,730
!أنا حارٌ جدًا و كأنني أحترق بالنار

230
00:13:15,730 --> 00:13:20,230
لكي أهدأ يجب علي لكم أي شخص
.أو مُمارسة الجنس مع النساء

231
00:13:20,230 --> 00:13:22,460
!أعطني المال إذا أردتَ إيقافي

232
00:13:22,460 --> 00:13:24,750
!أو أحضر لي امرأه أيها العجوز

233
00:13:24,750 --> 00:13:26,740
.تِلكَ ليست عيون بشر

234
00:13:27,960 --> 00:13:32,460
،لقد تعاملتُ مع الكثير من المُلاكمين
.لكنني لم أشهد قطّ مثل هذه الأعين المجنونة

235
00:13:32,460 --> 00:13:34,280
!ساخنٌ جدًا

236
00:13:34,280 --> 00:13:35,230
!أنا ساخنٌ للغاية

237
00:13:35,230 --> 00:13:36,490
مالذي سيحدث؟

238
00:13:36,490 --> 00:13:39,750
ماذا سيحدث لو أدخلت هذا الرجل إلى الحلبة؟

239
00:13:40,900 --> 00:13:42,260
!أريدُ رؤية ذلك

240
00:13:42,260 --> 00:13:44,760
.أريدُ رؤية مُستقبلة

241
00:13:45,750 --> 00:13:47,210
.دعني أريكَ شيئًا

242
00:13:47,210 --> 00:13:51,510
.مكانٌ حيث تلكم الرجال بقدرِ ما تشاء

243
00:13:51,510 --> 00:13:56,740
إنهُ المكان الذي سيُغفر لك حتى إذا قتلتَ رجلًا
.بسبب حادثةٍ مؤسفة

244
00:13:56,740 --> 00:13:57,710
حقًا؟

245
00:13:57,710 --> 00:14:01,520
هل ستُعطيني رُخصةً للقتل؟

246
00:14:05,630 --> 00:14:07,100
.تعال معي

247
00:14:08,030 --> 00:14:12,040
.أجل، إنهُ يظن بأن الأمر مسموح

248
00:14:12,040 --> 00:14:18,580
.و بعد هدوئه، سيواصل لكم الرجل حتى لو عنى ذلك قتله

249
00:14:18,580 --> 00:14:22,540
المُساعد الذي في الزاوية الأخرى...كاموغاوا، أليسَ كذلك؟

250
00:14:22,540 --> 00:14:27,590
أخر شيءٍ يُمكن أن يفعله
.المُدرب الغير كفؤ هو إيقاف المُباراة

251
00:14:27,590 --> 00:14:29,550
.اجل، فلترمي المنشفة

252
00:14:29,550 --> 00:14:32,050
!المُتحدّي أصبحَ ككيس المُلاكمة

253
00:14:37,060 --> 00:14:39,060
!تاكامورا

254
00:14:39,060 --> 00:14:40,630
!أجل! إرمي المنشفة

255
00:14:40,630 --> 00:14:41,810
!أوقف المُبارة من أجله

256
00:14:46,340 --> 00:14:47,860
لماذا لم ترمها؟

257
00:14:47,860 --> 00:14:50,580
ألا يُمكنك حتى إنقاذ مُلاكمك؟

258
00:14:50,580 --> 00:14:53,330
هل تُريد أن تستمر في إظهار مدى حماقتك؟

259
00:14:53,330 --> 00:14:55,480
!تاكامورا

260
00:14:55,480 --> 00:14:59,320
.أنا فقط أشعرُ براحةٍ شديدة عندما أكونُ في الحلبة

261
00:15:01,110 --> 00:15:05,630
.أُريدُ أن أكون جادًا عندما يتعلق الأمر بالمُلاكمة

262
00:15:06,300 --> 00:15:11,640
،أنتَ دائمًا ما تكونُ مغرورًا
.و لكنك تُصبحُ جادًا عندما تدخل الحلبة

263
00:15:12,280 --> 00:15:16,640
،كنتَ دائمًا تتدرب وتتدرب
.ودائمًا ما تُقاتل بشجاعة

264
00:15:17,030 --> 00:15:21,650
!أنا أحب طريقة قتالك

265
00:15:21,650 --> 00:15:22,970
.أريد مشاهدة المزيد

266
00:15:22,970 --> 00:15:25,130
!لا أريد أن أكون الشخص الذي يوقفك

267
00:15:26,860 --> 00:15:29,630
.هذا قاسٍ جدًا

268
00:15:29,630 --> 00:15:30,860
.لا أستطيع تحمل المزيد بعد الآن

269
00:15:32,110 --> 00:15:36,370
.لم أكن أعلم أبدًا أن من الممكن أن يتواجد شخصٌ أقوى مني

270
00:15:37,750 --> 00:15:38,870
.يالها من مُفاجئة

271
00:15:39,800 --> 00:15:41,570
.أنتَ قويٌ بحق

272
00:15:42,600 --> 00:15:43,880
.أعترفُ لك بذلك

273
00:15:43,880 --> 00:15:46,020
.لقد صمدت بما يكفي

274
00:15:46,020 --> 00:15:48,780
.لقد متعتني بما يكفي

275
00:15:48,780 --> 00:15:50,690
.أنا على وشك الوصول للنشوة

276
00:15:50,690 --> 00:15:52,520
...و الآن

277
00:15:52,520 --> 00:15:55,260
!فلتذهب للجحيم

278
00:15:56,000 --> 00:15:57,440
!يمينية

279
00:15:57,440 --> 00:15:59,270
!قُذف المُتحدي للخلف

280
00:16:02,160 --> 00:16:04,520
...لقد...إنتهى

281
00:16:10,760 --> 00:16:12,310
ماذا؟

282
00:16:12,310 --> 00:16:14,030
يوجد شيءٌ ما على ظهري؟

283
00:16:27,800 --> 00:16:29,300
!لكنهُ لن يسقط

284
00:16:29,300 --> 00:16:32,200
!إنهُ متمسكٌ بالحبال

285
00:16:33,350 --> 00:16:35,800
!مالذي تفعلونه؟

286
00:16:35,800 --> 00:16:38,850
لماذا أنتم صامتون الآن، بين كل الأوقات؟

287
00:16:39,490 --> 00:16:40,810
!يالكم من زملاءٍ مُثيرين للشفقة

288
00:16:42,070 --> 00:16:43,810
!مياتا-كُن

289
00:16:43,810 --> 00:16:45,010
!إخرس

290
00:16:45,010 --> 00:16:46,820
!نحنُ ننتظر هجومه المُضاد

291
00:16:46,820 --> 00:16:48,980
!لا نعتقد أن هنالك فرصة حتى لخسارته

292
00:16:48,980 --> 00:16:51,220
تاكامورا-سان! مالذي تفعله؟

293
00:16:51,220 --> 00:16:53,320
!كُن جريئًا مثل العادة

294
00:16:53,960 --> 00:16:55,140
...أجل

295
00:16:56,730 --> 00:16:58,440
!لا تُقلقنا

296
00:16:58,440 --> 00:16:59,450
!هيا بحق الجحيم

297
00:16:59,450 --> 00:17:01,580
!تاكامورا-سان! قاتل

298
00:17:02,130 --> 00:17:04,380
.نحنُ مُلاكمون أيضًا

299
00:17:04,990 --> 00:17:08,740
!أعلم مقدار الألم الذي تشعر به

300
00:17:08,740 --> 00:17:10,590
!كم هوَ صعبٌ

301
00:17:11,310 --> 00:17:13,180
!ولكن مع ذلك، لا تخسر

302
00:17:13,180 --> 00:17:14,570
!قاتل

303
00:17:14,570 --> 00:17:16,590
!لا يجب عليكَ الخسارة

304
00:17:17,140 --> 00:17:22,100
.لقد أتينا معك بعد ان أريتنا قوتك ذلك اليوم

305
00:17:22,100 --> 00:17:26,100
.لولاك، لما كنتُ واقفًا هُنا الآن

306
00:17:27,080 --> 00:17:29,120
...تاكامورا-سان، أنتَ

307
00:17:29,120 --> 00:17:31,040
...أنتَ

308
00:17:31,040 --> 00:17:33,110
!قدوتنا

309
00:17:33,110 --> 00:17:34,650
!لذلك لا تخسر

310
00:17:34,650 --> 00:17:35,820
!لا تخسر مهما كان

311
00:17:35,820 --> 00:17:37,610
!لا أريدُ رؤيتك خاسرًا

312
00:17:38,170 --> 00:17:39,690
!قاتل

313
00:17:39,690 --> 00:17:41,260
!أرجوك إنتصر

314
00:17:46,000 --> 00:17:48,100
!الناس لا يحبون أن تكون مُزعجًا جدًا

315
00:17:48,100 --> 00:17:49,650
!تعالَ معي

316
00:17:52,840 --> 00:17:54,750
...لقد فهمت

317
00:17:54,750 --> 00:17:56,130
.لقد فهمتُ جيدًا

318
00:17:58,330 --> 00:17:59,140
...من الذين

319
00:18:00,540 --> 00:18:02,620
!يدعمونني

320
00:18:04,910 --> 00:18:07,160
.هُنالك أشخاصٌ يؤمنون بي

321
00:18:09,150 --> 00:18:12,550
.يجبُ أن أبقى قويًا بوجودهم

322
00:18:12,550 --> 00:18:14,160
!الخسارة ليست مسموحة

323
00:18:15,270 --> 00:18:18,910
!حتى لو توقف قلبي، فروحي ستستمرُ بالقتال

324
00:18:20,160 --> 00:18:21,910
،و حتى لو اختفت روحي

325
00:18:21,910 --> 00:18:24,410
،سأخرج نفسي من التابوت

326
00:18:25,000 --> 00:18:26,410
!و أهزمك

327
00:18:27,600 --> 00:18:30,420
!واحد-اثنان غير مُتوقعة من المُتحدّي شبه الميت

328
00:18:30,420 --> 00:18:32,900
!لقد أصابتهُ بنجاح

329
00:18:34,240 --> 00:18:35,750
ألم تؤثر فيه؟

330
00:18:35,750 --> 00:18:38,840
ألم تعد هُنالك قوة في لكمات تاكامورا-سان؟

331
00:18:40,820 --> 00:18:42,360
!كان ذلك ضارًا

332
00:18:42,360 --> 00:18:44,310
!البطل يلتوي

333
00:18:44,310 --> 00:18:47,710
.كان الهجوم المضاد غير واردٍ في هذه المرحلة

334
00:18:47,710 --> 00:18:49,540
!لقد تلقى اللكمات بدون استعداد

335
00:18:49,540 --> 00:18:50,560
!هذا مُحال

336
00:18:50,560 --> 00:18:52,920
!بالكاد يقف

337
00:18:52,920 --> 00:18:54,570
كيف له أن يُسدّد لكمة صحيحة؟

338
00:18:54,940 --> 00:18:57,570
!يا إلهي، البطل يتراجع للمسافة الآمنة

339
00:18:57,570 --> 00:18:58,790
!لقد تغير التيار

340
00:18:58,790 --> 00:19:00,490
!جيد يا تاكامورا

341
00:19:00,490 --> 00:19:01,570
!إنها فُرصتك

342
00:19:01,570 --> 00:19:03,100
!إنطلق! إنطلق

343
00:19:03,100 --> 00:19:04,580
!أقتله

344
00:19:04,580 --> 00:19:05,740
!لا يُمكن المتابعة

345
00:19:05,740 --> 00:19:07,600
!ضرر المُتحدّي خطيرٌ كذلك

346
00:19:09,080 --> 00:19:10,850
!و ها قد رن الجرس

347
00:19:10,850 --> 00:19:13,720
!مُعلنًا نهاية الجولة السادسة

348
00:19:20,360 --> 00:19:24,210
.المُتحدّي أخطأ في زاويته

349
00:19:24,210 --> 00:19:25,900
.لا عجب

350
00:19:25,900 --> 00:19:28,350
،لقد تحمل لكمات البطل الكاملة كثيرًا

351
00:19:28,350 --> 00:19:30,270
...و استخدم كامل قُدرة تحمله

352
00:19:30,270 --> 00:19:32,700
!تاكامورا! من هذا الطريق

353
00:19:35,520 --> 00:19:39,480
.أنا مُتأكدٌ أن عقله ورؤيته في فوضةٍ الآن

354
00:19:39,480 --> 00:19:40,530
...لكن مع ذلك

355
00:19:40,530 --> 00:19:43,530
هل رأيتَ ذلك، هل رأيتَ وجهه؟

356
00:19:43,530 --> 00:19:44,070
.أجل

357
00:19:44,730 --> 00:19:47,070
.إنهُ مُتهالك

358
00:19:47,070 --> 00:19:49,040
!إنهُ نصفُ ميتٍ الآن

359
00:19:49,040 --> 00:19:51,370
إذن لماذا لا يزال يُكافح؟

360
00:19:51,370 --> 00:19:52,540
!و مضطرب؟

361
00:19:52,540 --> 00:19:55,050
...كنتُ أشعر بحالة جيدة

362
00:19:55,050 --> 00:19:57,590
!كنتُ قريبًا من النشوة

363
00:19:57,590 --> 00:19:58,930
.يا للأزعاج

364
00:19:58,930 --> 00:20:01,400
.إنهُ مُزعجٌ جدًا

365
00:20:01,400 --> 00:20:02,300
!هوك

366
00:20:02,300 --> 00:20:04,360
.لقد اكتفيت من هذه المُباراة

367
00:20:04,360 --> 00:20:05,720
.سوف أنهيها الآن

368
00:20:05,720 --> 00:20:10,310
.و سأذهب لممارسة الجنس مع النساء عندها سأشعرُ جيدًا

369
00:20:10,310 --> 00:20:11,650
،ميغيل

370
00:20:12,740 --> 00:20:15,530
هل تتذكر رخصة القتل التي منحتني؟

371
00:20:15,530 --> 00:20:18,320
.سوف أستخدمها في الجولةِ التالية

372
00:20:19,260 --> 00:20:21,100
!سأقتله

373
00:20:22,820 --> 00:20:24,260
!أحسنتَ عملًا بصمودك

374
00:20:24,260 --> 00:20:25,590
!و أحسنتَ عملًا بمعاودة القتال

375
00:20:25,590 --> 00:20:27,530
!أحسنتَ عملًا بصمودك هُناك

376
00:20:29,500 --> 00:20:34,830
.لقد ضُرب ضربًا مُبرحًا، ومع ذلك ما زال يُقاتل بكل فخر

377
00:20:35,240 --> 00:20:38,040
.كل ما أمكنني فعله هوَ المُشاهدة

378
00:20:38,040 --> 00:20:40,340
!أنا مُنزعجٌ من عدم كفاءتي

379
00:20:41,300 --> 00:20:42,570
...أنا آسف

380
00:20:42,570 --> 00:20:44,340
!آسف يا تاكامورا

381
00:20:44,340 --> 00:20:47,850
.كـ-كنتُ سأسقط

382
00:20:47,850 --> 00:20:51,060
.كـ-كان الأمرُ قاسيًا

383
00:20:51,060 --> 00:20:52,200
...حقًا

384
00:20:52,200 --> 00:20:53,140
...تاكامورا

385
00:20:53,720 --> 00:20:57,400
.لم أكن سأصمد بدون دعمك لي

386
00:20:58,800 --> 00:21:01,190
.لقد كنتَ تدعمني طوال الوقت

387
00:21:02,030 --> 00:21:03,550
.لقد فهمتُ الأمر جيدًا

388
00:21:06,510 --> 00:21:07,910
!المُساعدون للخارج

389
00:21:07,910 --> 00:21:09,210
...الآن

390
00:21:11,630 --> 00:21:13,110
.خُذ قطعة الفم

391
00:21:18,890 --> 00:21:19,930
...أنتَ

