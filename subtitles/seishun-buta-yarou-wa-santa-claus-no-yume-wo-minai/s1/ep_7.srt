1
00:00:06,150 --> 00:00:10,150
سينباي، نُشِر منشور على دريمينغ
قد لفت انتباهي

2
00:00:10,150 --> 00:00:13,360
ماذا؟ هل هو حلمٌ أخيراً حيث
تجد كوغا خليلاً؟

3
00:00:13,360 --> 00:00:14,910
!لا شيء من هذا

4
00:00:15,610 --> 00:00:18,740
شاهدتُ حلماً حيث كسرتُ أضواء"
"فلورنست في صفّ المدرسة

5
00:00:18,740 --> 00:00:21,540
،كان في الصفّ 1-2 في ثانويّة مينيغاهارا"

6
00:00:21,540 --> 00:00:24,420
لذا لا بُدّ أنّه عندما أبدّل ملابسي
"#بعد تمرين النّادي. دريمينغ

7
00:00:24,920 --> 00:00:26,630
هذا يشير إلى مدرستنا الثّانويّة

8
00:00:26,630 --> 00:00:28,250
وحدث ذلك اليوم

9
00:00:29,340 --> 00:00:31,050
أنا متأكّد بأنّ الأمور ستكون على ما يُرام

10
00:00:31,050 --> 00:00:32,800
لماذا؟

11
00:00:32,800 --> 00:00:35,510
سيفعل بطل العدالة شيئاً بشأن الأمر

12
00:02:07,940 --> 00:02:09,190
شكراً على الانتظار

13
00:02:09,190 --> 00:02:10,600
آسف لطلبي منكِ الخروج

14
00:02:11,020 --> 00:02:14,360
كنتُ أنوي المرور من هنا من عملي
في مدرسة الحشو على أيّ حال

15
00:02:15,570 --> 00:02:19,280
أوّلاً، بخصوص مُتلازمة المُراهقة
...الخاصّة بإيكومي أكاغي

16
00:02:19,780 --> 00:02:22,830
يراودني شعور بأنّ نظريّتك ليست خاطئة

17
00:02:23,620 --> 00:02:25,160
إذاً كنتُ مُحقّاً

18
00:02:25,160 --> 00:02:26,660
وثمّة أمر آخر

19
00:02:27,080 --> 00:02:28,000
هذا

20
00:02:29,500 --> 00:02:32,130
أليس لهذا علاقة بك؟

21
00:02:33,590 --> 00:02:35,800
أنا متأكّد من أنّه كذلك

22
00:02:35,800 --> 00:02:38,050
لديّ دعوة هنا أيضاً

23
00:02:38,590 --> 00:02:41,590
رأت إيكومي أكاغي حلماً عن اللّقاء
كذلك، صحيح؟

24
00:02:42,090 --> 00:02:44,390
حلماً حيث تجرح شخصاً

25
00:02:44,890 --> 00:02:49,230
حسناً، يبدو أنّك اتّخذت إجراءات بشأن
ذلك بالفعل، لذا لستُ قلقة

26
00:02:49,810 --> 00:02:51,650
لكن كُن حذراً تحسُّباً فقط

27
00:02:51,650 --> 00:02:54,270
فقد تكون الشّخص الّذي طُعِن

28
00:03:01,450 --> 00:03:04,410
ربّما ينبغي أن أُلصق مجلّة بربطة معصمي

29
00:03:21,180 --> 00:03:23,340
لا بُدّ أنّك الخرّيج الّذي اتّصل بنا

30
00:03:23,720 --> 00:03:24,640
أجل

31
00:03:24,640 --> 00:03:26,720
اسمك هنا من فضلك

32
00:03:29,730 --> 00:03:30,940
هذه؟

33
00:03:31,230 --> 00:03:32,900
ثمّة تلميذ آخر هنا

34
00:03:32,900 --> 00:03:37,020
أراد إلقاء نظرة تعريفيّة على الحرم
لكتابة تقرير للكلّية

35
00:04:05,140 --> 00:04:07,760
إذاً يا أكاغي، كنت مُتحسّرة
على هذا طوال الوقت

36
00:04:09,180 --> 00:04:13,690
كيف أنّ ندوباً وكدمات ظهرت
في جسد أختي الصّغرى

37
00:04:13,690 --> 00:04:17,110
،وأردتُ من المُعلّم وصفّي أن يُصدّقوني

38
00:04:17,110 --> 00:04:20,150
...تلك الأوقات الّتي أردتُ فيها أن ينقذني شخص

39
00:04:21,240 --> 00:04:22,780
فقد أزوساغاوا صوابه

40
00:04:22,950 --> 00:04:24,990
إنّه مجنون

41
00:04:26,530 --> 00:04:30,790
كنتِ قد ندمتِ على العجز
عن إنقاذي آنذاك

42
00:04:32,000 --> 00:04:33,290
أخطأتَ قليلاً

43
00:04:34,870 --> 00:04:38,340
ما تحسّرتُ عليه لم يكن عدم القدرة على
،فعل شيء، بالرّغم من إخبار صديقة لي

44
00:04:38,340 --> 00:04:43,380
"إيكومي، افعلي شيئاً بشأن هذه الأجواء"

45
00:04:44,340 --> 00:04:47,890
في نهاية المطاف، أظنّني قد تعثّرتُ آنذاك

46
00:04:47,890 --> 00:04:50,970
وكنتُ في حيرة تامّة أمام ما يجب فعله

47
00:04:52,770 --> 00:04:57,270
هل استدرجتني للخروج اليوم
للحديث عن هذه الذّكريات؟

48
00:04:57,270 --> 00:04:58,770
بمنشور مُزيّف؟

49
00:04:59,230 --> 00:05:01,150
من الجيّد ألّا يُصَب أحدٌ بجروح، أليس كذلك؟

50
00:05:01,650 --> 00:05:05,360
أجل. لكن أتمنّى ألّا تكرّر هذا

51
00:05:05,360 --> 00:05:08,120
بسببك، فاتني اجتماع لمّ الشّمل

52
00:05:08,120 --> 00:05:11,370
هذا الظّرف الّذي يجري الآن هو
لمّ شمل من ناحية، أليس كذلك؟

53
00:05:11,370 --> 00:05:13,790
نحن في غرفة صفّ ذكرياتنا

54
00:05:13,790 --> 00:05:15,960
أجل، هذا من ناحيتك أنت

55
00:05:15,960 --> 00:05:17,670
ومن ناحيتك أيضاً

56
00:05:18,170 --> 00:05:21,170
...كنتِ تُداومين في هذا الصفّ أيضاً

57
00:05:21,590 --> 00:05:23,920
عندما كنتِ في الكون المُحتمَل الآنر

58
00:05:28,550 --> 00:05:30,850
هذه الرّياح تحمل معها الذّكريات

59
00:05:31,350 --> 00:05:34,060
...رائحة المُحيط، والأُفُق

60
00:05:37,940 --> 00:05:39,560
كيف عرفت ذلك؟

61
00:05:39,560 --> 00:05:43,030
كنتُ مرتاباً في البداية في مراسم القبول

62
00:05:43,530 --> 00:05:46,360
،حدتِ عن طريقكِ للتكلّم معي

63
00:05:46,360 --> 00:05:48,570
لكن لم أسمع عنكِ شيئاً منذ
ذلك الحين، صحيح؟

64
00:05:50,070 --> 00:05:53,990
لكن لم أفكّر في تلك الحادثة إلّا
في الآونة الأخيرة أيضاً

65
00:05:54,790 --> 00:05:56,660
إذاً بعد الهالوين؟

66
00:05:57,160 --> 00:05:58,250
هذا ما أعتقده

67
00:05:58,830 --> 00:06:01,170
ظللتُ أرى أشياء ليست في مكانها
منذ ذلك الحين

68
00:06:01,670 --> 00:06:02,920
مثلاً؟

69
00:06:02,920 --> 00:06:04,920
مثلاً انسجامكِ مع كاميساتو

70
00:06:05,420 --> 00:06:07,680
ساكي وأنا كنّا في نفس الصفّ

71
00:06:07,680 --> 00:06:10,640
في عامنا الثّاني والثّالث من الثّانويّة
في العالم الآخر

72
00:06:10,640 --> 00:06:12,970
ثمّ الرُّوح الشّرّيرة

73
00:06:13,470 --> 00:06:16,480
تلك أحاسيس من أكاغي الّتي
هي في العالم الآخر حاليّاً

74
00:06:16,480 --> 00:06:17,890
تنساب إلى داخلكِ، صحيح؟

75
00:06:18,440 --> 00:06:21,730
الكتابة على ذراعيكِ كُتِبَتْ بواسطة
أكاغي الأُخرى، أليس كذلك؟

76
00:06:23,690 --> 00:06:26,570
كلّ ما قلتَه حتّى الآن هو تخمين، صحيح؟

77
00:06:26,570 --> 00:06:29,660
كنتُ قد اقتنعتُ عندما رأيتُ كتابي السّنويّ

78
00:06:30,160 --> 00:06:31,780
قلتَ بأنّك تخلّصت منه

79
00:06:32,160 --> 00:06:36,580
أكاغي، ذكرتِ ما كتبتُه في كتابي
السّنويّ، أليس كذلك؟

80
00:06:37,080 --> 00:06:40,120
"ذات يوم، أودُّ أن أبلغ الحنان"

81
00:06:40,120 --> 00:06:42,130
لم أكتب شيئاً كهذا

82
00:06:42,960 --> 00:06:46,170
كانت هذه عبارة أخبرني بها شخص مُعيّن

83
00:06:46,760 --> 00:06:49,970
،لم أتذكّرها في المدرسة الإعداديّة

84
00:06:49,970 --> 00:06:52,300
لذا مُحال أن أكون قد كتبتُها

85
00:06:53,510 --> 00:06:58,230
أنا في العالم الآخر كان قادراً على تذكُّر تلك
،الكلمات أبكر ممّا فعلتُ وأنا هنا

86
00:06:58,230 --> 00:07:01,190
ولهذا كان قادراً على كتابتها
في مقالة تخرُّجه

87
00:07:01,690 --> 00:07:04,060
أنا متأكّد بأنّه ببساطة أفضل منّي

88
00:07:05,110 --> 00:07:08,650
بالنّسبة لي، هذا العالم هنا مُريح أكثر

89
00:07:09,150 --> 00:07:11,360
لأنّني لستُ جيّداً بنفس الدّرجة؟

90
00:07:11,360 --> 00:07:12,410
صحيح

91
00:07:12,910 --> 00:07:15,080
هل قرأتَ مقالتي هناك؟

92
00:07:15,490 --> 00:07:18,660
أريد أن أصبح بالغة تستطيع"
"مُساعدة الآخرين

93
00:07:18,660 --> 00:07:22,080
لم يتحقّق هذا الحلم في العالم الآخر

94
00:07:22,580 --> 00:07:24,920
لأنّه يوجد أزوساغاوا جيّد هناك

95
00:07:25,880 --> 00:07:29,670
،في أيّام المدرسة الإعداديّة
لم يُسمَح لي بفعل شيء

96
00:07:30,170 --> 00:07:35,180
،حتّى عندما تمّ التنمُّر على أخته الصّغرى
عالجَ أزوساغاوا الأمور من تلقاء نفسه

97
00:07:35,180 --> 00:07:37,060
بتولّي غرفة البثّ

98
00:07:37,060 --> 00:07:40,060
ذاتي الأُخرى هناك تتعامل
مع الأمور بذكاء

99
00:07:40,060 --> 00:07:42,230
نفس الأمر كان ينطبق على ما بعد
دخول المدرسة الثّانويّة أيضاً

100
00:07:42,230 --> 00:07:47,730
عالجَ أزوساغاوا كافّة المشاكل الّتي
أردتُ المُساعدة بها بنفسه

101
00:07:49,030 --> 00:07:54,240
لم أكن أنا، بل كان أزوساغاوا الّذي
أصبح "الشّيء" الّذي أردتُ أن أكون

102
00:07:54,700 --> 00:07:56,620
،وفشلتُ أيضاً في امتحانات دخول الكلّية

103
00:07:56,620 --> 00:07:58,620
،لذا لم أفشل في أن أصبح "شيئاً" فحسب

104
00:07:58,620 --> 00:08:00,370
لن أستطع حتّى أن أصبح طالبة كلّية

105
00:08:02,920 --> 00:08:05,710
لم يفلح أيّ شيء بالنّسبة لي

106
00:08:06,920 --> 00:08:09,130
...لهذا كنتُ أفكّر كلّ يوم

107
00:08:09,800 --> 00:08:12,260
بأنّني أردتُ الهرب إلى مكان
غير هذا المكان

108
00:08:15,720 --> 00:08:16,800
...ثمّ

109
00:08:24,770 --> 00:08:26,610
وصلتُ إلى هذا العالم هنا

110
00:08:27,900 --> 00:08:31,070
عندما استفقت، كنتُ في طريق
...مرصوف بالشّجر في الحرم

111
00:08:32,700 --> 00:08:35,660
ووجدتُك بين الحشود

112
00:08:36,030 --> 00:08:38,120
أنت أزوساغاوا... صحيح؟

113
00:08:39,410 --> 00:08:41,080
أكاغي، صحيح؟

114
00:08:42,040 --> 00:08:44,330
ظننتُ بأنّني كنتُ أرى حلماً

115
00:08:44,330 --> 00:08:45,540
لكن لم أكن كذلك

116
00:08:46,040 --> 00:08:49,710
راودني هذا الشُّعور لأنّني التقيتُ بك
مرّة في العالم الآخر

117
00:08:51,920 --> 00:08:55,010
رحتَ إلى هناك في شتاء عامنا الثّاني، صحيح؟

118
00:08:55,800 --> 00:08:56,640
أزوساغاوا

119
00:08:56,640 --> 00:08:58,220
...المعذرة

120
00:08:58,220 --> 00:08:59,760
واجب الصّفّ على عاتقك اليوم، صحيح؟

121
00:09:00,260 --> 00:09:01,930
سوف يقرع الجرس قريباً

122
00:09:04,770 --> 00:09:06,230
أنا متفاجئ من أنّكِ أدركتِ ذلك

123
00:09:07,400 --> 00:09:09,610
كنتُ أُراقبك دوماً

124
00:09:10,770 --> 00:09:12,860
ألم تشعري يوماً بأنّكِ أردتِ العودة؟

125
00:09:13,360 --> 00:09:16,160
لم أُرد ذلك أبداً، وما زلتُ لا أُريد

126
00:09:16,660 --> 00:09:20,870
هنا، أنا طالبة جامعة في المدرسة
،الّتي أردتُ ارتيادها

127
00:09:20,870 --> 00:09:24,250
...ومُمثّلة مجموعة تطوُّعيّة، و

128
00:09:24,250 --> 00:09:26,120
وبطلة عدالة

129
00:09:27,960 --> 00:09:31,880
في هذا العالم، تمكّنتُ من أن أصبح
الّذي أردتُ أن أكون

130
00:09:31,880 --> 00:09:35,380
إذاً لماذا تحدّيتِني في تلك المُسابقة؟

131
00:09:36,010 --> 00:09:39,680
ارتأيتُ بأنّني أستطيع الفوز
عليك في هذا العالم

132
00:09:39,680 --> 00:09:45,140
في هذه الحالة، لماذا تبدين مرتاحة بالرّغم
من الخسارة في تلك المُسابقة؟

133
00:09:45,640 --> 00:09:46,640
...هذا لأنّ

134
00:09:47,770 --> 00:09:50,770
في الواقع، أردتِ شخصاً أن يُلاحظ، صحيح؟

135
00:09:51,270 --> 00:09:54,690
بأنّ إيكومي أكاغي الّتي هنا ليست الحقيقيّة

136
00:09:55,030 --> 00:09:56,820
لماذا تعتقد ذلك؟

137
00:09:57,320 --> 00:10:01,450
أكاغي ليست ليّنة مع نفسها لدرجة
تستطيع مُسامحة نفسها على الهرب

138
00:10:01,990 --> 00:10:05,160
لذا أرادتْ شخصاً أن يكشفها وهي تغشّ

139
00:10:06,460 --> 00:10:09,080
وها أنتِ ذي

140
00:10:09,500 --> 00:10:12,090
كشفتُك يا أكاغي" إن جاز التّعبير؟"

141
00:10:17,800 --> 00:10:21,930
لكن كنتُ ماهرة في الغُمّيضة وأنا طفلة

142
00:10:23,390 --> 00:10:27,430
إنّما لم أتوقّع أن أستطيع البقاء هكذا للأبد

143
00:10:28,600 --> 00:10:32,440
لم يلحظ أحد. لم يكترث أحد حتّى يلاحظ

144
00:10:32,440 --> 00:10:34,980
كنتُ أفقد رؤية كياني

145
00:10:36,360 --> 00:10:40,320
الشّخص الّذي ينظر إليه الجميع
ليس إيكومي أكاغي الحقيقيّة

146
00:10:41,410 --> 00:10:44,990
،إذا لم يكن كوني بديلة مُهمّاً
فما انا بالضّبط إذاً؟

147
00:10:45,490 --> 00:10:47,200
كنتُ أتساءل حول ذلك طوال الوقت

148
00:10:47,790 --> 00:10:50,080
حسناً، لديك فكرة الآن، أليس كذلك؟

149
00:10:51,290 --> 00:10:52,840
لستُ أفهم إطلاقاً

150
00:10:53,540 --> 00:10:57,880
أكاغي فتاة جشعة تُواجه
كلّ شيء بمفردها

151
00:10:59,550 --> 00:11:04,050
إنّها جادّة لدرجة مُضحكة وتبدو
ماهرة في كوزبلاي المُمرّضات

152
00:11:04,600 --> 00:11:06,180
هذه هي أكاغي

153
00:11:10,520 --> 00:11:11,730
أين المُشكلة في ذلك؟

154
00:11:15,730 --> 00:11:18,490
مشينا معاً هكذا في ذلك اليوم أيضاً

155
00:11:18,490 --> 00:11:19,530
أجل

156
00:11:19,530 --> 00:11:21,610
هل تتذكّر ما تحدّثنا حوله؟

157
00:11:22,530 --> 00:11:25,580
لكن لماذا قرّرتِ اختيار هذه الثّانويّة
من بين كلّ المدارس؟

158
00:11:26,370 --> 00:11:29,330
ألم يكن بوسعكِ ارتياد ثانويّة مرموقة أكثر؟

159
00:11:33,080 --> 00:11:34,340
...أزوساغاوا

160
00:11:37,460 --> 00:11:39,470
لا تهتمّ. انسَ الأمر

161
00:11:43,340 --> 00:11:45,350
...تلك الكلمات الّتي كنتِ تحاولين قولها آنذاك

162
00:11:46,060 --> 00:11:48,100
هل قلتِها لذاتي الأُخرى؟

163
00:11:48,470 --> 00:11:52,520
لو قلتُها كلّها، فماذا كنتَ لتفعل؟

164
00:11:52,520 --> 00:11:54,940
مبدئيّاً، ستغمرني السّعادة غالباً

165
00:11:55,440 --> 00:11:57,690
رغم أنّ لديك حبيبة رائعة كهذه؟

166
00:11:58,110 --> 00:12:02,150
لستُ مشهوراً بما يكفي حتّى أضطرب
عندما تقول لي فتاة بأنّها تُحبّني

167
00:12:02,570 --> 00:12:06,490
أزوساغاوا، لم تُجِب عن سؤال
بشكل صريح يوماً

168
00:12:07,030 --> 00:12:08,370
ولا أنتِ

169
00:12:25,510 --> 00:12:26,930
هنا نفترق

170
00:12:28,640 --> 00:12:29,810
هل أنتِ راضية؟

171
00:12:30,560 --> 00:12:32,560
أعتقد أنّ كلّ شيء جاهز الآن

172
00:12:32,560 --> 00:12:33,520
ماذا؟

173
00:12:33,520 --> 00:12:35,900
رسالة من ذاتي الأُخرى

174
00:12:43,450 --> 00:12:44,280
هل رأيتها؟

175
00:12:44,280 --> 00:12:46,740
ما الّذي تنوي أكاغي فعله؟

176
00:12:49,290 --> 00:12:50,120
وداعاً

177
00:13:05,130 --> 00:13:06,470
!انتظري لحظة

178
00:13:07,180 --> 00:13:08,390
ماذا؟

179
00:13:12,520 --> 00:13:15,390
ما زال بإمكاني اللّحاق باجتماع
لمّ الشّمل، صحيح؟

180
00:13:28,280 --> 00:13:29,450
!أجل، في تلك المرّة

181
00:13:29,450 --> 00:13:30,450
هل تتذكّرين؟

182
00:13:41,630 --> 00:13:43,670
لِمَ يجب عليّ فعل هذا؟

183
00:13:52,810 --> 00:13:54,140
انظروا، ذاك الشّخص

184
00:13:56,100 --> 00:13:57,810
هذا أزوساغاوا، صحيح؟

185
00:13:57,810 --> 00:13:58,650
لماذا؟

186
00:13:58,980 --> 00:14:00,060
من دعاه؟

187
00:14:00,060 --> 00:14:01,270
وما أدراني؟

188
00:14:05,360 --> 00:14:06,200
أكاغي

189
00:14:07,820 --> 00:14:09,200
ماذا؟

190
00:14:10,320 --> 00:14:11,530
إيكومي، كنتِ هنا؟

191
00:14:11,830 --> 00:14:12,740
!مستحيل

192
00:14:12,740 --> 00:14:13,910
منذ متى؟

193
00:14:15,160 --> 00:14:19,040
كنتُ هنا طوال الوقت، منذ حوالي ساعة

194
00:14:19,710 --> 00:14:24,090
منذ دخول فوجينو وتوزيع
النّخب على الجميع

195
00:14:24,590 --> 00:14:27,010
وتعثُّر تانيمورا وكسر الكأس

196
00:14:27,680 --> 00:14:30,930
واعتراف ناكاي بحُبّه لأيوساوا

197
00:14:31,510 --> 00:14:32,760
كنتُ هنا في هذا المكان

198
00:14:38,190 --> 00:14:40,560
لم أرك منذ وقت طويل يا أزوساغاوا

199
00:14:41,560 --> 00:14:43,860
هل تتذكّرني؟

200
00:14:43,860 --> 00:14:45,110
لقد نسيت

201
00:14:46,280 --> 00:14:47,860
هذا قاسٍ قليلاً

202
00:14:52,780 --> 00:14:54,290
رأيتم ذلك الآن، صحيح؟

203
00:14:54,620 --> 00:14:57,290
أُصِبتُ بمُتلازمة المُراهقة أيضاً

204
00:14:57,290 --> 00:14:59,040
تمهّلي لحظة يا أكاغي

205
00:14:59,040 --> 00:15:00,790
هذا ليس مُزاحاً

206
00:15:00,790 --> 00:15:05,130
،إذا كنتم تعتقدون بأنّها خدعة سحريّة
فهل يستطيع أحدٌ أن يشرح كيف فعلتُ ذلك؟

207
00:15:06,550 --> 00:15:08,760
مُتلازمة المُراهقة موجودة

208
00:15:09,340 --> 00:15:11,050
هذه هي الحقيقة

209
00:15:11,390 --> 00:15:13,470
لم يكن أزوساغاوا مُخطئاً

210
00:15:13,970 --> 00:15:15,680
بل نحن جميعاً من كنّا مُخطئين

211
00:15:17,220 --> 00:15:19,190
كفّي عن قول هذا بعد كلّ
هذا الوقت يا إيكومي

212
00:15:19,480 --> 00:15:22,440
!مُتلازمة المُراهقة؟ سئمتُ من هذا

213
00:15:22,650 --> 00:15:25,480
بسبب هذا، تلقّيتُ توبيخاً من والدَي

214
00:15:25,480 --> 00:15:28,110
وفي المدرسة الثّانويّة، ظلّوا
يسألون عن المدرسة الإعداديّة

215
00:15:28,110 --> 00:15:30,360
!كان كما لو أنّني مُجرمة

216
00:15:30,360 --> 00:15:32,990
كنتُ مُتوتّرة حقّاً قبل المجيء
إلى هنا اليوم أيضاً

217
00:15:33,320 --> 00:15:35,120
لكن يسرّني أنّني أتيت

218
00:15:35,120 --> 00:15:39,250
،تذكّرتُ بأنّه كانت هناك أوقات مُمتعة أيضاً
عندما دردشتُ مع الجميع هنا

219
00:15:40,250 --> 00:15:42,420
!لذا لا تُفسدي كلّ هذا ثانية الآن

220
00:15:42,420 --> 00:15:44,880
!وبمُتلازمة المُراهقة بالتّحديد

221
00:15:45,130 --> 00:15:46,090
!هذا صحيح يا إيكومي

222
00:15:46,090 --> 00:15:47,920
ماذا تريدين من هذا؟

223
00:15:48,590 --> 00:15:51,590
رينا، لماذا أتيتِ إلى هنا إن كنتِ مُتوتّرة؟

224
00:15:52,930 --> 00:15:55,720
جميعكم، لماذا أتيتُم إلى هنا إن
كنتُم تشعرون بقلق؟

225
00:15:57,010 --> 00:15:59,850
"رأيتُ حلماً عن اجتماع لمّ شمل اليوم"

226
00:15:59,850 --> 00:16:01,350
كتبتِ هذا أيضاً يا رينا

227
00:16:01,940 --> 00:16:06,110
سخرتِ من مُتلازمة المراهقة، ومع ذلك
#تؤمنين بدريمينغ

228
00:16:08,150 --> 00:16:10,440
جميعكم أيضاً

229
00:16:10,440 --> 00:16:12,280
الجميع قالوها آنذاك

230
00:16:12,280 --> 00:16:13,740
"أزوساغاوا فقد صوابه"

231
00:16:14,740 --> 00:16:17,790
لكن نحن من فقدنا صوابنا

232
00:16:18,330 --> 00:16:21,500
سخرنا من أزوساغاوا بجهلنا

233
00:16:21,500 --> 00:16:22,960
جرحناه

234
00:16:22,960 --> 00:16:27,750
نعتناه بالمجنون وأفسدنا حياته

235
00:16:29,340 --> 00:16:31,050
...حتّى بعد أن أدركنا بأنّ ذلك خاطئ

236
00:16:31,670 --> 00:16:34,430
ظللنا نضحك دون أي تكفير

237
00:16:34,430 --> 00:16:36,550
هذه حالة أسوأ بكثير من "فقدان
الصّواب"، أليس كذلك؟

238
00:16:36,890 --> 00:16:40,220
!تقولين هذا، لكن فات الأوان على ذلك الآن

239
00:16:41,520 --> 00:16:43,190
،كما قالت رينا للتو

240
00:16:43,190 --> 00:16:46,690
بسبب تلك الحادثة، لم يسرِ شيء
على ما يُرام بالنّسبة لي أيضاً

241
00:16:47,190 --> 00:16:50,230
لم أستمتع بعد الانتقال إلى المدرسة الثّانويّة

242
00:16:50,900 --> 00:16:54,410
.واجهتُ وقتاً عصيباً كلّ يوم
ظللتُ أشقّ طريقي بصعوبة

243
00:16:54,990 --> 00:16:56,620
—إذاً، لماذا

244
00:16:56,620 --> 00:16:57,990
...حتّى لو كان كلّ ذلك صحيحاً

245
00:16:58,410 --> 00:17:02,000
أزوساغاوا هو الشّخص الوحيد الّذي
"يحقّ له أن يقول "فات الأوان

246
00:17:12,590 --> 00:17:13,760
!أمزح فحسب

247
00:17:14,130 --> 00:17:16,890
،في الواقع، سار الأمر على ما يُرام
أليس كذلك يا أكاغي؟

248
00:17:17,340 --> 00:17:19,510
أكاغي وأنا نرتاد نفس الجامعة

249
00:17:19,510 --> 00:17:22,730
،سمعتُ بأنّكم ستُقيمون اجتماع لمّ شمل
لذا طلبتُ منها مُساعدتي هنا

250
00:17:22,730 --> 00:17:23,810
—لا، الأمر ليس كذلـ

251
00:17:23,810 --> 00:17:25,730
كانت خدعة سحريّة مُدهشة جدّاً، صحيح؟

252
00:17:25,980 --> 00:17:28,230
كان تمثيل أكاغي وكأنّه حقيقيّ أيضاً

253
00:17:28,730 --> 00:17:30,400
كان كلّ هذا مزحة

254
00:17:30,650 --> 00:17:34,740
ما حدث في المدرسة الإعداديّة
!مضى عليه وقت طويل

255
00:17:34,740 --> 00:17:37,660
لم تكن حياتي جميلة كلّها أيضاً

256
00:17:37,660 --> 00:17:42,370
بصراحة، أعتقد بأنّ المطاف انتهى بي
أسعد بكثير منكم جميعاً

257
00:17:42,580 --> 00:17:47,960
لعلّكم تعلمون جميعاً، لكنّني
أُواعد ماي ساكوراجيما

258
00:17:47,960 --> 00:17:51,380
لذا... تستحقّون هذا، صحيح؟

259
00:17:55,510 --> 00:17:58,010
كانت هذه اللّحظة الّتي يُفترض
بكم أن تضحكوا فيها

260
00:17:58,640 --> 00:18:00,720
أتيتُ إلى هنا لأخبركم جميعاً بذلك

261
00:18:01,100 --> 00:18:02,180
آسف لإزعاجكم

262
00:18:02,560 --> 00:18:03,520
إلى اللّقاء

263
00:18:35,340 --> 00:18:37,130
هل أنتِ راضية عن كلّ هذا؟

264
00:18:37,630 --> 00:18:38,930
راضية؟

265
00:18:39,300 --> 00:18:41,890
راضية عن أنّ كلّ شيء سار
وفق المُخطّط، صحيح؟

266
00:18:42,390 --> 00:18:43,850
المُخطّط؟ ماذا تقصد؟

267
00:18:44,350 --> 00:18:46,680
!جمع كلّ زملاء الصّفّ من المدرسة الإعداديّة

268
00:18:46,680 --> 00:18:51,310
وجعلهم يعترفون بوجود مُتلازمة
المُراهقة أمامكِ

269
00:18:52,770 --> 00:18:55,400
لهذا خطّطتِ لاجتماع لمّ الشّمل، أليس كذلك؟

270
00:18:56,490 --> 00:18:59,950
ثمّ استدرجتني للخروج باستخدام دريمينغ

271
00:18:59,950 --> 00:19:02,740
بكذبة كبرى حول تسبّبكِ بجرح شخص

272
00:19:03,990 --> 00:19:06,330
،إذا كنتَ قد كشفتني فعلاً
فأعتقد لا أملك خياراً

273
00:19:06,790 --> 00:19:09,500
كم مضى على تخطيطكِ لأحداث اليوم؟

274
00:19:10,080 --> 00:19:12,380
...مع تفشّي مُتلازمة المُراهقة

275
00:19:12,960 --> 00:19:15,340
ارتأيتُ بأنّ هذا هو التصرُّف الصّائب

276
00:19:15,800 --> 00:19:19,430
...وجدتُك أثناء مراسم القبول في الجامعة

277
00:19:20,180 --> 00:19:21,430
وشعرتُ بصدمة

278
00:19:21,930 --> 00:19:25,350
كنتَ تقف هناك وكأنّ شيئاً لم يحدث

279
00:19:25,850 --> 00:19:29,440
كنتَ تضحك وكأنّك نسيت كلّ
تلك الأوقات آنذاك

280
00:19:30,640 --> 00:19:34,320
شعرتُ بالخجل من نفسي لأنّني ظللتُ
أجرّ ذلك الماضي معي حتّى يومنا هذا

281
00:19:34,320 --> 00:19:35,980
عاجزة عن أن أصبح شخصاً لافتاً

282
00:19:36,360 --> 00:19:39,110
شعرتُ بأنّني لا أستطيع أن أكشف
عن نفسي هكذا

283
00:19:40,360 --> 00:19:44,700
كنتَ قد حقّقتَ تقدُّماً، بينما
أنا لم أُحرز شيئاً يُذكَر

284
00:19:45,580 --> 00:19:49,160
بالتّفكير في ذلك، شعرتُ بالتّعاسة ولم أستطع
التّواجد في ذلك المكان بعدها

285
00:19:49,660 --> 00:19:52,460
أردتُ الهرب من أعماق قلبي

286
00:19:59,970 --> 00:20:02,590
رحلتِ فعلاً إلى مكانٍ قصيّ جدّاً

287
00:20:03,010 --> 00:20:06,430
رغم ذلك، ظننتُ بأنّني كنتُ أحلم في البداية

288
00:20:07,930 --> 00:20:11,230
...لكن بعد قضاء يوم في ذلك العالم الآخر

289
00:20:11,810 --> 00:20:14,610
ارتأيتُ بأنّني سأعود إلى هنا
عند مطلع الصّباح التّالي

290
00:20:15,230 --> 00:20:17,020
لكن بقيتُ في ذلك العالم

291
00:20:18,360 --> 00:20:20,820
لذا ترتّب عليّ التّصديق بأنّ
كلّ شيء كان حقيقيّاً

292
00:20:21,780 --> 00:20:23,910
لم تريدي العودة أبداً؟

293
00:20:24,410 --> 00:20:26,080
شعرتُ بقلق

294
00:20:26,080 --> 00:20:28,410
،لكن بعد حوالي شهر

295
00:20:28,410 --> 00:20:31,120
بدأتُ بالتّفكير بأنّه كان لا ضير
من بقاء كلّ شيء على هذه الحال

296
00:20:31,620 --> 00:20:34,670
إذاً بالنّسبة لكِ، كان عالماً مُريحاً جدّاً؟

297
00:20:35,170 --> 00:20:37,000
أكثر بكثير من هنا

298
00:20:37,500 --> 00:20:41,630
هناك، فشلتُ في امتحانات قبول الكلّية

299
00:20:41,630 --> 00:20:43,800
ورُفِضتُ أثناء مُحاولتي الالتحاق بها

300
00:20:43,800 --> 00:20:47,220
بذلك الشّكل، ما كنتَ لرأيتِني في الجامعة

301
00:20:47,220 --> 00:20:49,010
...والأهمّ من أيّ شيء، شعرتُ براحة

302
00:20:49,640 --> 00:20:52,770
بأنّ كلّ شيء من أيّام المدرسة الإعداديّة قد عولِج

303
00:20:53,270 --> 00:20:55,350
سمعتُ بأنّني عالجتُ المُشكلة
المُتعلّقة بأختي

304
00:20:55,350 --> 00:20:57,610
بتولّي غرفة البثّ

305
00:20:57,610 --> 00:21:01,110
لذا ارتأيتُ بأنّني سأبدأ بكلّ شيء
ثانية من هناك

306
00:21:01,110 --> 00:21:04,910
ارتأيتُ بأنّني أستطيع أن أصبح الشّخص
الّذي أردتُ أن أكون في ذلك العالم

307
00:21:04,910 --> 00:21:07,660
تقولين نفس الكلام الّذي كانت
أكاغي الأُخرى تقوله

308
00:21:09,410 --> 00:21:10,910
أزوساغاوا

309
00:21:12,370 --> 00:21:16,460
كيف لي أن أكره نفسي البغيضة
الّتي لم تستطع فعل شيء؟

310
00:21:17,790 --> 00:21:19,170
هذا سهل

311
00:21:20,210 --> 00:21:21,460
حقّاً؟

312
00:21:21,460 --> 00:21:24,680
.تناولي الفطور كلّ يوم
واذهبي إلى المدرسة

313
00:21:24,680 --> 00:21:28,300
واحضري درساً. وأجري مُحادثات
تافهة مع الأصدقاء

314
00:21:28,300 --> 00:21:30,470
.داومي في عمل بدوام جزئيّ
واستحمّي

315
00:21:30,470 --> 00:21:32,310
فرّشي أسنانكِ ونامي

316
00:21:32,810 --> 00:21:36,020
حسناً، تذكّري بعض الأشياء السّيّئة
بين الحين والآخر أيضاً

317
00:21:36,560 --> 00:21:39,980
وعندما تفعلين، تلوّي قليلاً
،على سريركِ

318
00:21:39,980 --> 00:21:42,110
ثمّ سرعان ما ستجدين بأنّ
،النّعاس قد غلبكِ

319
00:21:42,110 --> 00:21:45,110
ومُنبّه السّاعة يوقظكِ بأسوأ شعور مُمكن

320
00:21:45,110 --> 00:21:48,490
لكن يمكنكِ أن تتناولي الفطور وتتوجّهي
إلى المدرسة ثانية فحسب

321
00:21:49,120 --> 00:21:51,200
إلى متى يجب عليّ الاستمرار
في فعل ذلك؟

322
00:21:51,200 --> 00:21:53,450
وما أدراني؟

323
00:21:53,450 --> 00:21:54,710
صحيح

324
00:21:55,250 --> 00:21:58,290
أنا حقّاً مُثيرة للشّفقة وغير رائعة

325
00:21:58,790 --> 00:22:01,130
...من الجيّد أنّكِ اكتشفتِ ذلك اليوم

326
00:22:02,380 --> 00:22:06,380
وليس غداً أو بعد غد أو بعد
أسبوع أو حتّى بعد عام من الآن

327
00:22:07,340 --> 00:22:09,970
رغم أنّني سلكتُ طريقاً التفافيّاً
للوصول إلى هنا

328
00:22:11,720 --> 00:22:13,470
يسرّني أنّ ذلك كان اليوم

329
00:22:14,180 --> 00:22:15,020
صحيح؟

330
00:22:18,560 --> 00:22:22,820
كان الجميع مدهوشاً من تباهيك
بشأن خليلة مشهورة

331
00:22:22,820 --> 00:22:25,990
سمعتُ بأنّ لمّ الشّمل هو مكان حيث
تغترّ فيه بكونك أفضل بكثير من الآخرين

332
00:22:26,360 --> 00:22:28,530
لكن كان ذلك خبيثاً حقّاً

333
00:22:28,530 --> 00:22:31,030
سأوجّه شكري لماي-سان حتماً

334
00:22:31,330 --> 00:22:33,660
كانت تحميني طوال الوقت اليوم أيضاً

335
00:22:45,090 --> 00:22:46,470
...أتعلمين يا ماي-سان

336
00:22:46,470 --> 00:22:47,300
ماذا؟

337
00:22:47,680 --> 00:22:51,180
ثمّة أمر واحد أريد أن أعتذر بشأنه

338
00:22:51,180 --> 00:22:52,510
هل خنتني ثانية؟

339
00:22:52,510 --> 00:22:54,640
متى خنتُكِ أساساً؟

340
00:22:54,640 --> 00:22:56,390
هذا ما تقوله، لكنّك سريع

341
00:22:56,390 --> 00:22:57,850
في التعرُّف على فتيات

342
00:22:57,850 --> 00:23:02,440
في الواقع، تبجّحتُ في الأمس بأنّني
أُواعد ماي ساكوراجيما

343
00:23:02,940 --> 00:23:04,440
لا أُبالي حقّاً

344
00:23:04,440 --> 00:23:06,530
أقصد بانّها الحقيقة، صحيح؟

345
00:23:06,530 --> 00:23:08,570
في الواقع، إنّها كذلك

346
00:23:08,570 --> 00:23:13,280
أم أنّك تحاول القول بأنّني لستُ حبيبة
يمكنك التبجُّح بها؟

347
00:23:15,290 --> 00:23:16,620
هل لي بلحظة؟

348
00:23:17,750 --> 00:23:19,250
—من فضلك لا -
تفضّلي -

349
00:23:20,460 --> 00:23:22,250
لا بُدّ أنّك أكاغي-سان؟

350
00:23:22,250 --> 00:23:23,340
تفضّلي بالجلوس

351
00:23:25,210 --> 00:23:26,880
هل ينبغي أن أستأذن بالانصراف؟

352
00:23:27,380 --> 00:23:30,840
لا، للأمر علاقة بكِ كذلك يا ساكوراجيما-سان

353
00:23:31,340 --> 00:23:32,600
بي كذلك؟

354
00:23:33,760 --> 00:23:34,600
إنّها هذه

355
00:23:38,350 --> 00:23:39,520
—هذا

356
00:23:39,520 --> 00:23:40,980
لا تقلق

357
00:23:41,230 --> 00:23:44,230
أنا حتماً هي أنا الّتي وُلِدتُ
في هذا العالم

358
00:23:44,610 --> 00:23:46,570
وما الرّسالة؟

359
00:23:55,990 --> 00:23:57,450
أزوساغاوا

360
00:23:57,950 --> 00:23:59,210
يا لك من شقيّ

361
00:23:57,950 --> 00:24:00,000
الحلقة القادمة
الحلقة 8: أسرار ووعود