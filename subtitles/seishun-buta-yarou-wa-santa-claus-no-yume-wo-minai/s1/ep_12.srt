1
00:00:03,890 --> 00:00:05,860
هل تشعرين بأنّكِ أصبحتِ بالغة؟

2
00:00:05,860 --> 00:00:07,730
هل تناولتِ مشروبات كحوليّة
من قبل بالفعل؟

3
00:00:08,320 --> 00:00:11,940
ثمّة إشاعات على وسائل التّواصل
الاجتماعيّ مؤخّراً

4
00:00:11,940 --> 00:00:15,610
تُفيد بأنّكِ توكو كيريشيما، مُغنِّية الإنترنت

5
00:00:16,160 --> 00:00:20,080
مع الأسف، لستُ توكو كيريشيما-سان

6
00:00:20,080 --> 00:00:22,250
أنا آسفة لأنّني لم أرتقِ لتوقّعاتكم

7
00:00:22,620 --> 00:00:26,380
إن أحببتِ، أستطيع أن أعرض
لكم جدول أعمالي؟

8
00:00:26,380 --> 00:00:31,590
لا مجال لي قطعاً لأكون
فنّانة موسيقيّة نشِطة

9
00:00:32,920 --> 00:00:35,680
يجب عليّ مُشاورة المسؤولين
!قبل الإفصاح عن ذلك

10
00:00:38,050 --> 00:00:40,680
ما رأيكِ بتوكو كيريشيما-سان؟

11
00:00:40,680 --> 00:00:43,350
هل تؤمنين بإشاعة تحوُّل الأحلام إلى حقيقة؟

12
00:02:15,150 --> 00:02:17,490
لستُ توكو كيريشيما-سان

13
00:02:18,070 --> 00:02:22,120
وهكذا، تصريحها وتعليقاتها الرّسميّة
من الوكالة

14
00:02:22,120 --> 00:02:26,080
أنكرت الإشاعات، لكن عبر
،وسائل التّواصُل

15
00:02:26,080 --> 00:02:31,130
ما زال هناك على ما يبدو منشورات
بواسطة المُؤمنين بدريمينغ

16
00:02:31,790 --> 00:02:35,460
والآن علينا فقط أن نخطو خطوة
فعليّة للأمام

17
00:02:40,050 --> 00:02:41,220
صباح الخير

18
00:02:43,890 --> 00:02:47,850
صباح الخير. ماذا تفعلين في الجامعة اليوم؟

19
00:02:48,350 --> 00:02:49,850
أحضر الدّروس بالطّبع

20
00:02:49,850 --> 00:02:51,480
رغم أنّكِ بشريّة خفيّة؟

21
00:02:51,770 --> 00:02:54,480
أبقى طالبة جامعيّة، لذا هذا طبيعيّ

22
00:02:55,270 --> 00:02:57,820
رأيتُ المُقابلة وتجمّع أعمار العشرين سنة

23
00:02:57,820 --> 00:02:59,780
اترك اليوم 30 شاغراً

24
00:03:01,030 --> 00:03:03,700
سأخرج في مُواعدة معك كما وعدتُ

25
00:03:09,790 --> 00:03:11,210
تويوهاما

26
00:03:11,210 --> 00:03:12,040
ماذا؟

27
00:03:12,460 --> 00:03:17,510
إذا بدأت الآيدول الأشهر الآن
،بالحضور إلى جامعتنا غداً

28
00:03:17,510 --> 00:03:18,800
فماذا ستعتقدين؟

29
00:03:18,800 --> 00:03:21,680
مبدئيّاً، لا أظنّني سأكون سعيدة
على ما أعتقد؟

30
00:03:21,680 --> 00:03:23,180
هكذا إذاً

31
00:03:23,680 --> 00:03:25,430
،حتّى لو لم أكن واعية لهم

32
00:03:25,430 --> 00:03:28,270
الجميع حولنا سيُقارنوننا كآيدول

33
00:03:28,640 --> 00:03:33,650
سيشفقون عليكِ ظاهريّاً بينما
يسخرون ضمنيّاً

34
00:03:33,650 --> 00:03:34,480
!مؤلم

35
00:03:34,480 --> 00:03:35,860
أتفتعل شجاراً معي؟

36
00:03:36,230 --> 00:03:39,530
ماذا؟ تريد أن تتكلّم عن كم أنّ
أختي الكبرى على خطأ؟

37
00:03:39,530 --> 00:03:42,240
أتظنّينني سأتكلّم عن شيء كهذا؟

38
00:03:42,740 --> 00:03:45,660
لديّ لمحة حول ما تحاول الرّمي إليه

39
00:03:45,660 --> 00:03:49,410
رأيتُ بضع فتيات من هذا النّوع
عندما دخلتُ الجامعة أوّل مرّة

40
00:03:49,410 --> 00:03:50,500
أيّ نوع من الفتيات؟

41
00:03:50,910 --> 00:03:53,580
الفتيات اللّواتي يُعتبَرنَ الأجمل

42
00:03:53,580 --> 00:03:54,580
حتّى المدرسة الثّانويّة

43
00:03:55,080 --> 00:03:57,630
،لكن عندما دخلنَ الجامعة
كانت أختي الكبرى موجودة

44
00:03:57,630 --> 00:04:01,420
لذا أصابهن التشوُّش، من حيث
،الشّخصيّة والمكانة

45
00:04:01,420 --> 00:04:03,050
وفقدنَ رؤيتهن لأنفسهن

46
00:04:03,050 --> 00:04:03,880
ماذا عنكِ؟

47
00:04:04,390 --> 00:04:05,220
أنا؟

48
00:04:05,510 --> 00:04:08,180
أنتِ رئيسة نادي ضحايا ماي-سان، صحيح؟

49
00:04:08,180 --> 00:04:09,720
!لا تُلفّق نوادي غريبة

50
00:04:11,270 --> 00:04:15,100
بالنّسبة لي، أعتقد بأنّ
أختي الكبرى بعيدة المنال

51
00:04:15,560 --> 00:04:18,940
حتّى لو بذلتُ جهدي، لا أستطيع
مُجاراتها إطلاقاً

52
00:04:18,940 --> 00:04:23,030
حتّى الآن، لا أعرف كيف يبدو
العالم في نظرها

53
00:04:23,530 --> 00:04:24,860
مُحال أن أعلم

54
00:04:26,570 --> 00:04:28,030
...لذا يا ساكوتا

55
00:04:29,410 --> 00:04:31,870
أريدك أن تكون حليف أختي الكبرى دوماً

56
00:04:33,620 --> 00:04:34,870
بالطّبع

57
00:04:42,550 --> 00:04:46,640
سانتا كلوز لا تتجوّل على مزلجة
يجرّها حيوان رنّة، صحيح؟

58
00:04:47,510 --> 00:04:49,760
لماذا كنت تنظر للخارج طوال الوقت؟

59
00:04:50,390 --> 00:04:54,560
كنتُ أتساءل كيف يرى الآخرون
هذا الوضع الّذي نحن فيه الآن

60
00:04:54,560 --> 00:04:56,650
يبدو وكأنّ حبيب ماي ساكوراجيما

61
00:04:56,650 --> 00:04:59,770
يُقابل نساء أُخريات سرّاً؟

62
00:04:59,770 --> 00:05:03,280
ربّما ذلك إذا كانوا يرونكِ يا كيريشيما-سان

63
00:05:04,030 --> 00:05:07,570
بالمناسبة، هل تُواعدين أحداً الآن؟

64
00:05:08,280 --> 00:05:09,990
كنتُ حتّى فصل الرّبيع

65
00:05:09,990 --> 00:05:13,450
كما تعلم، حتّى حبيبي توقّف عن الشّعور بي

66
00:05:13,750 --> 00:05:16,540
منذ متى كنتِ تُواعدين ذلك الشّخص؟

67
00:05:16,540 --> 00:05:17,960
الصّيف الثّاني من المدرسة الثّانويّة

68
00:05:18,540 --> 00:05:22,340
هذا يعني عندما كنتِ
في هوكّايدو، صحيح؟

69
00:05:22,340 --> 00:05:25,840
بصيغة أُخرى، قبل بدء نيني إيواميزاوا-سان
بالادِّعاء بأنّها توكو كيريشيما؟

70
00:05:27,470 --> 00:05:29,600
،وإذا كان مع شخص في هوكّايدو

71
00:05:29,600 --> 00:05:32,640
هل أقمتِ علاقة مسافات بعيدة
بعد التخرُّج من الثّانويّة؟

72
00:05:33,220 --> 00:05:37,140
تقدّمنا لجامعتنا معاً، لكن لم يُقبَل هو

73
00:05:37,140 --> 00:05:38,730
عامان على التّوالي حتّى

74
00:05:39,230 --> 00:05:40,520
ماذا يفعل الآن؟

75
00:05:41,020 --> 00:05:43,190
.المرّة الثّالثة هي الثّابتة
لقد قُبِلَ فيها

76
00:05:43,190 --> 00:05:44,990
بدأ بالحضور في هذا الرّبيع

77
00:05:45,360 --> 00:05:47,150
،بعد بذل كلّ هذا الجهد للدّخول

78
00:05:47,150 --> 00:05:49,950
أصبح عاجزاً عن الشّعور بكِ يا كيريشيما-سان؟

79
00:05:50,570 --> 00:05:51,910
هذا ما حدث

80
00:05:52,410 --> 00:05:53,950
ما اختصاصه؟

81
00:05:55,790 --> 00:05:56,960
علوم إحصائيّة

82
00:05:57,540 --> 00:05:59,580
هل هو شخص أعرفه؟

83
00:06:02,420 --> 00:06:04,340
إنّه فوكوياما، أليس كذلك؟

84
00:06:08,510 --> 00:06:13,180
هل يعلم فوكوياما بأنّ الهويّة الحقيقيّة
لتوكو كيريشيما هي نيني إيواميزاوا؟

85
00:06:13,680 --> 00:06:14,850
لا يعلم

86
00:06:15,470 --> 00:06:18,690
إنّه يشعر بوجود توكو كيريشيما

87
00:06:19,310 --> 00:06:22,400
لكن لماذا لا يستطيع رؤيتكِ
يا كيريشيما-سان؟

88
00:06:24,190 --> 00:06:27,190
غالباً لأنّه لا يعلم بأنّني توكو كيريشيما

89
00:06:27,900 --> 00:06:32,320
"أليس لأنّكِ "نيني إيواميزاوا
في مُخيّلة فوكوياما؟

90
00:06:32,530 --> 00:06:34,290
وماذا لو كنتُ كذلك؟

91
00:06:35,240 --> 00:06:36,790
اذهب واشترِ هذه

92
00:06:40,420 --> 00:06:44,340
يتمّ توفير هدايا سانتا في موتوماتشي، صحيح؟

93
00:06:45,670 --> 00:06:47,210
سنذهب إلى المكان التّالي

94
00:06:53,350 --> 00:06:55,060
إلى أين نحن ذاهبان؟

95
00:06:58,140 --> 00:06:59,060
وصلنا

96
00:07:00,230 --> 00:07:01,060
هذا هو

97
00:07:01,520 --> 00:07:04,320
يبدو كمنزل قد يعيش فيه سانتا

98
00:07:13,950 --> 00:07:17,450
ابحث عن حيوان رنّة، بحجم الكفّ

99
00:07:17,450 --> 00:07:18,830
هل تبحثان عن شيء؟

100
00:07:19,710 --> 00:07:22,000
هل لديك حيوانات رنّة مُصغّرة؟

101
00:07:22,000 --> 00:07:24,500
أعتقد تقصد هذا

102
00:07:25,420 --> 00:07:28,960
أتى عددٌ قليلٌ من النّاس مؤخّراً
إلى هنا لشراء هذا

103
00:07:32,890 --> 00:07:34,050
شكراً لك

104
00:07:34,050 --> 00:07:36,060
شكراً على مُواعدة اليوم

105
00:07:36,810 --> 00:07:38,470
ستعطينني هذا؟

106
00:07:38,470 --> 00:07:40,270
أعطِ هذه لتاكومي رجاء

107
00:07:40,770 --> 00:07:44,150
إذاً لِمَ لا نُعطيه إيّاه معاً الآن؟

108
00:07:44,150 --> 00:07:46,270
اليوم عيد ميلاد فوكوياما، أليس كذلك؟

109
00:07:47,400 --> 00:07:50,190
لهذا اقتطعتِ من وقتكِ واخترتِ
هذا اليوم، صحيح؟

110
00:07:50,740 --> 00:07:54,160
لا جدوى من الذّهاب. لا يستطيع تاكومي رؤيتي

111
00:07:54,620 --> 00:07:56,280
قد يتمكّن من ذلك اليوم

112
00:07:56,280 --> 00:07:59,040
كانت النّتيجة سيّئة مهما حاولتُ
التكلُّم معه من مرّات

113
00:07:59,040 --> 00:08:00,750
قد تكون النّتيجة جيّدة اليوم

114
00:08:00,750 --> 00:08:02,410
!هذا ليس من شأنك

115
00:08:03,750 --> 00:08:05,920
أريدكِ أن تسرعي وتتوقّفي
...عن كونكِ خفيّة

116
00:08:06,340 --> 00:08:10,050
،كي تتمكّني من قولها صراحة
"أنا توكو كيريشيما"

117
00:08:10,670 --> 00:08:12,680
أهذا لأجل حبيبتك؟

118
00:08:13,090 --> 00:08:17,640
تعلمين بأنّه ما زال هناك أشخاصاً يعتقدون
بأنّ ماي-سان هي توكو كيريشيما، صحيح؟

119
00:08:17,640 --> 00:08:22,100
لِمَ عليّ فعل شيء لأجلك
ولأجل حبيبتك؟

120
00:08:22,480 --> 00:08:26,310
لأنّ أُمنيتك الكبرى هي
البقاء كتوكو كيريشيما

121
00:08:27,480 --> 00:08:29,940
لدينا هدفٌ مُشترَك

122
00:08:30,940 --> 00:08:32,400
أعيريني هاتفكِ النقّال رجاء

123
00:08:32,900 --> 00:08:35,070
لديكِ معلومات الاتٍّصال بفوكوياما، صحيح؟

124
00:08:36,570 --> 00:08:40,450
ألم تشترِ له هديّة لأنّكِ
تتأمّلين منه شيئاً؟

125
00:08:40,910 --> 00:08:43,330
وأفترض بأنّ الوشاح الّذي يستخدمه
فوكوياما الآن

126
00:08:43,330 --> 00:08:45,580
هو هديّة منك كذلك، صحيح؟

127
00:08:47,630 --> 00:08:50,300
إنّه أوّل عيد ميلاد له بعد أن تواعدنا

128
00:08:50,960 --> 00:08:54,550
إنّه مُهترئ جدّاً. ينبغي أن يشتري
واحداً مختلفاً فحسب

129
00:08:55,090 --> 00:08:58,220
إنّه ثمين بالنّسبة له لأنّه شيء
قدّمَتْه له حبيبته

130
00:08:58,720 --> 00:09:00,720
رغم أنّه لا يستطيع رؤيتي؟

131
00:09:01,270 --> 00:09:04,350
اشتكِ له شخصيّاً من فضلكِ

132
00:09:08,770 --> 00:09:09,730
مرحباً؟

133
00:09:09,730 --> 00:09:12,190
فوكوياما؟ هذا أنا، أزوساغاوا

134
00:09:12,190 --> 00:09:14,860
ماذا؟ لماذا أنت؟

135
00:09:15,030 --> 00:09:16,240
هل أنت في الخارج في مكان ما الآن؟

136
00:09:16,660 --> 00:09:18,780
أجل، في طريقي إلى المطار

137
00:09:19,070 --> 00:09:21,200
هل أنت عائد إلى هوكّايدو بالمناسبة؟

138
00:09:21,700 --> 00:09:24,460
أجل. طرأتْ مُشكلة ما هناك

139
00:09:25,080 --> 00:09:26,540
حسناً، ماذا تريد؟

140
00:09:26,540 --> 00:09:29,040
قلتَ بأنّ عيد ميلادك هو اليوم، أليس كذلك؟

141
00:09:29,540 --> 00:09:31,000
قلتُ ذلك

142
00:09:31,500 --> 00:09:35,090
إذاً انتظرني في المطار. أودُّ
أن أعطيك شيئاً

143
00:09:37,340 --> 00:09:40,010
إذاً التقيتِ بفوكوياما في الثّانويّة؟

144
00:09:40,640 --> 00:09:42,520
ارتدنا نفس الإعداديّة أيضاً

145
00:09:42,850 --> 00:09:44,850
ما الّذي يُعجبكِ في فوكوياما؟

146
00:09:44,850 --> 00:09:47,560
أنت تطرح الكثير من الأسئلة منذ مدّة

147
00:09:47,560 --> 00:09:49,770
أعتقد ما هو رائع في فوكوياما

148
00:09:49,770 --> 00:09:54,610
هو أنّه لا يُراعي المشاعر عندما
لا يتوجّب عليه ذلك

149
00:09:55,320 --> 00:09:56,320
مثلاً؟

150
00:09:56,820 --> 00:10:00,570
كان أوّل شخص سألني
لدى الدّخول إلى الجامعة

151
00:10:00,570 --> 00:10:03,120
ما إن كان صحيحاً أنّني أُواعد ماي-سان

152
00:10:04,580 --> 00:10:07,500
لم يستطع حمل نفسه على طلب
الخروج معي لفترة طويلة جدّاً

153
00:10:07,500 --> 00:10:10,000
لكنّه قادر دوماً على فعل مثل هذه الأمور

154
00:10:10,540 --> 00:10:11,750
مثلاً؟

155
00:10:11,750 --> 00:10:15,630
في الإعداديّة، كان هناك فتى
انتقل من طوكيو

156
00:10:16,050 --> 00:10:20,260
انتشرت الإشاعات في الصّفّ كلّه عن أنّه
كان قد رفض ارتياد المدرسة

157
00:10:20,260 --> 00:10:22,640
كان الجميع مُتردّدين بشأن التكلُّم معه

158
00:10:22,970 --> 00:10:25,430
،لكن لم يأبه تاكومي لأيّ من ذلك

159
00:10:25,430 --> 00:10:28,230
وكان أوّل شخص يتكلّم مع الفتى

160
00:10:28,230 --> 00:10:30,520
!كم هو رائع

161
00:10:31,150 --> 00:10:33,320
أعتقد بفضل ذلك التّلميذ المُنتقل

162
00:10:33,320 --> 00:10:35,990
بدأتُ ألتفِت لتاكومي

163
00:10:37,150 --> 00:10:39,780
كان يحضر حفلات التّوفيق بين
حبيبين طوال الوقت

164
00:10:39,780 --> 00:10:41,660
لذا ينبغي لكِ أن تعظيه كما ينبغي

165
00:10:42,490 --> 00:10:45,080
إذا استطاع تاكومي رؤيتي، فسأفعل ذلك

166
00:10:55,460 --> 00:10:57,260
أنت هنا فعلاً

167
00:10:57,260 --> 00:10:59,010
أخبرتُك بأنّني سآتي

168
00:10:59,010 --> 00:11:01,720
هذا مُفاجئ. أتعتقد بأنّني
سأصدّق مزحة كهذه؟

169
00:11:02,180 --> 00:11:03,140
تاكومي

170
00:11:03,140 --> 00:11:07,270
إذاً، آسف لقولي هذا بعد أن قطعتَ
كلّ هذه المسافة، لكن الوقت يُداهمني

171
00:11:07,270 --> 00:11:08,770
اسمع يا تاكومي

172
00:11:09,310 --> 00:11:10,230
انظر إليّ

173
00:11:10,230 --> 00:11:14,190
يجب عليّ الذّهاب لفحص أمتعتي
قريباً، وإلّا سأقع في ورطة

174
00:11:14,190 --> 00:11:18,860
فوكوياما، هل تتذكّر من أعطاك هذا الوشاح؟

175
00:11:19,200 --> 00:11:20,530
من فعل؟

176
00:11:21,360 --> 00:11:22,570
ماذا؟

177
00:11:23,450 --> 00:11:25,370
صحيح، كيف حصلتُ عليه؟

178
00:11:25,370 --> 00:11:29,210
حصلتَ عليه من حبيبتك الّتي
كنتَ تُواعدها منذ الثّانويّة

179
00:11:29,210 --> 00:11:31,500
ماذا؟ لا، لا. عمّاذا تتكلّم؟

180
00:11:31,500 --> 00:11:34,960
صدّقني. إنّه شيء حصلت عليه من حبيبتك

181
00:11:35,500 --> 00:11:38,590
آسف. أنا فعلاً لا أفهم ما تقوله

182
00:11:38,590 --> 00:11:40,590
لقد نسيت

183
00:11:40,590 --> 00:11:43,470
بعبارة أدقّ، فقدتَ فقط القدرة
على الشّعور بها

184
00:11:44,010 --> 00:11:47,350
لا تستطيع تذكُّر من أعطاك
الوشاح، صحيح؟

185
00:11:47,850 --> 00:11:49,480
...هذا صحيح، لكن

186
00:11:49,980 --> 00:11:54,440
عجباً لأمرك، لديك حبيبة كنتَ
تُواعدها منذ الثّانويّة

187
00:11:55,440 --> 00:11:57,110
تعرفها منذ الإعداديّة

188
00:11:57,110 --> 00:12:00,070
طلبتَ منها الخروج معك في صيف
عامك الثّاني في الثّانويّة

189
00:12:00,070 --> 00:12:02,400
اسمها نيني إيواميزاوا

190
00:12:04,660 --> 00:12:07,330
أنا آسف. لستُ أفهم بصراحة

191
00:12:07,830 --> 00:12:09,950
هل كنتُ تواعدها حقّاً؟

192
00:12:10,750 --> 00:12:12,790
هذا الوشاح هو البُرهان

193
00:12:15,380 --> 00:12:18,550
آسف لقولي هذا... لكن لستُ أفهمك

194
00:12:19,050 --> 00:12:20,880
فكّر في الأمر مليّاً ولو لمرّة

195
00:12:20,630 --> 00:12:23,260
،إلى كافّة ركّاب الرّحلة 555
الرّجاء التوجُّه إلى مطار تشيتوسي الجديد

196
00:12:23,010 --> 00:12:25,680
بئساً. يجب عليّ الذّهاب

197
00:12:23,260 --> 00:12:26,510
من فضلكم افحصوا أمتعتكم فوراً

198
00:12:25,680 --> 00:12:26,510
!انتظر يا فوكوياما

199
00:12:26,800 --> 00:12:30,520
،قد لا تتمكّن من تصديق هذا
!لكن أنا لا أكذب

200
00:12:30,520 --> 00:12:33,980
أعلم بأنّك شخص صادق

201
00:12:33,980 --> 00:12:35,400
شكراً على المجيء لوداعي

202
00:12:38,650 --> 00:12:39,480
ماذا؟

203
00:12:40,480 --> 00:12:41,400
كيريشيما-سان؟

204
00:12:55,330 --> 00:12:57,040
ماذا يجدر بي أن أفعل؟

205
00:12:57,040 --> 00:12:59,750
تبدو مُكتئباً تماماً

206
00:13:01,420 --> 00:13:04,430
إذاً تذهبين إلى مدرسة القيادة
تلك أيضاً؟

207
00:13:04,430 --> 00:13:06,590
حصلتُ بالفعل على رخصتي المؤقّتة

208
00:13:06,590 --> 00:13:09,890
في الواقع، أريدك أن تلقي
نظرة إلى هذه

209
00:13:16,850 --> 00:13:19,400
أليست هذه قاعة الحفل الموسيقيّ
الخاصّة بجامعتنا؟

210
00:13:19,400 --> 00:13:22,440
هذا فيديو حيث ربحت نيني إيواميزاوا
مُنافسة ملكة جمال الحرم

211
00:13:22,940 --> 00:13:25,400
أعتقد بأنّها فقرة حيث يستعرضنَ
فيها مواهبهن

212
00:13:26,490 --> 00:13:28,910
هذه أغنية توكو كيريشيما، صحيح؟

213
00:13:29,160 --> 00:13:31,700
عدد المُشاهدات مُذهل أيضاً

214
00:13:36,370 --> 00:13:39,590
آخر تعليق قد نُشِر في أبريل الماضي

215
00:13:39,590 --> 00:13:43,460
أعتقد بأنّ الجميع توقّف عن
الشّعور بها بعد ذلك

216
00:13:43,960 --> 00:13:47,470
ماذا عن نفس الأغنية الّتي
غنّتْها توكو كيريشيما؟

217
00:13:48,050 --> 00:13:50,180
أجل، هذه هي

218
00:13:54,020 --> 00:13:56,480
أجريتِ أبحاثكِ حقّاً إذاً؟an}

219
00:13:56,480 --> 00:14:02,110
أعني أنّه من المُخيف جدّاً أن يكون هناك
شخص لا يراه سواك وأنا

220
00:14:02,110 --> 00:14:07,200
بمُجرّد سماع هذا، أنا أيضاً أعتقد
بأنّ إيواميزاوا-سان هي توكو كيريشيما

221
00:14:11,740 --> 00:14:14,120
عثرتُ على شيء كهذا أيضاً

222
00:14:15,540 --> 00:14:18,870
هناك أكثر من مئة فيديو هكذا

223
00:14:24,300 --> 00:14:28,590
وكلّ فيديو فيه تعليقات مثل
"وكأنّكِ الحقيقيّة"

224
00:14:28,590 --> 00:14:30,510
،رغم أنّ الإطار الزّمنيّ مُشتّت

225
00:14:30,510 --> 00:14:33,890
جميع الفيديوهات توقّفتْ عن تلقّي تعليقات
في مرحلة ما

226
00:14:34,310 --> 00:14:37,980
تقصدين بأنّ هؤلاء النّاس لم يعُد
أحد يشعر بهم أيضاً؟

227
00:14:41,440 --> 00:14:46,900
لهذا أخبرتُ المُدير بأنّنا نحتاج
لنكون أكثر تنبُّهاً لأعدادنا

228
00:14:47,700 --> 00:14:50,320
من ناحية، ذلك الرّجل رهيب

229
00:14:50,320 --> 00:14:52,370
إن كان كذلك، فماذا يجدر بنا أن نفعل؟

230
00:14:52,870 --> 00:14:54,330
هذه مُشكلة

231
00:14:58,460 --> 00:15:01,210
أنا في ورطة حقيقيّة

232
00:15:03,380 --> 00:15:05,880
حسناً، حسناً. أنا قادم

233
00:15:07,550 --> 00:15:09,380
نعم؟ أزوساغاوا

234
00:15:09,380 --> 00:15:11,220
هذا أنا، فوكوياما

235
00:15:11,220 --> 00:15:13,300
ما الأمر؟ هل حدث شيء؟

236
00:15:13,800 --> 00:15:15,720
آسف بشأن ما حدث في المطار

237
00:15:15,720 --> 00:15:19,940
في النّهاية، لم أعرف ما أردتَ قوله

238
00:15:19,940 --> 00:15:22,020
لا عليك. لستُ مُستاء من ذلك

239
00:15:22,020 --> 00:15:27,280
.بالأحرى، قلتَ بأنّ هناك مُشكلة ما
هل كنتَ بخير من تلك النّاحية؟

240
00:15:27,570 --> 00:15:30,950
حسناً، ارتأيتُ أن أتحدّث حول ذلك

241
00:15:31,700 --> 00:15:34,620
...تلقّيتُ نبأ من هوكّايدو في ذلك اليوم

242
00:15:35,120 --> 00:15:38,500
بأنّ أحد زملائي في الإعداديّة
تُوفّي في حادث سير

243
00:15:39,460 --> 00:15:41,460
شخص تعرفه جيّداً؟

244
00:15:41,460 --> 00:15:44,130
خير معرفة في الإعداديّة

245
00:15:44,130 --> 00:15:47,460
انتقل من طوكيو في عامنا الثّاني

246
00:15:47,460 --> 00:15:50,510
أردتُ حضور الجنازة، لذا كنتُ
على عجلة من أمري

247
00:15:50,970 --> 00:15:53,510
لا، آسف لأنّني أزعجتُك

248
00:15:53,510 --> 00:15:55,510
هل تمكّنتَ من إقامة حفل وداع مُناسب؟

249
00:15:55,510 --> 00:16:01,020
،أجل. بدأتُ بالبُكاء في لحظة ما
وزملائي القدامى ضحكوا عليّ

250
00:16:01,640 --> 00:16:03,440
واتّصلتَ لتخبرني بذلك فقط؟

251
00:16:03,940 --> 00:16:06,360
...هذا أحد الأسباب أيضاً، لكن

252
00:16:06,360 --> 00:16:09,990
سمعتُ بأمر غريب من زملاء الصّفّ
الّذين تجمّعوا هناك

253
00:16:09,990 --> 00:16:11,320
شيء غريب؟

254
00:16:11,320 --> 00:16:13,160
بخصوص دريمينغ

255
00:16:13,660 --> 00:16:15,950
...ذلك الصّديق الّذي تعرّض لحادث

256
00:16:15,950 --> 00:16:18,410
لم يرَ حلماً في ليلة الكريسماس

257
00:16:19,290 --> 00:16:23,370
تعلم كيف أنّه يُعتقَد بأنّنا
ننظر للمُستقبل، صحيح؟

258
00:16:23,370 --> 00:16:25,580
لذا كانوا يقولون بأنّ حقيقة
أنّه لم يرَ حلماً

259
00:16:25,580 --> 00:16:28,920
سببها هو أنّه كان ميّتاً في المستقبل

260
00:16:29,590 --> 00:16:31,800
أنا متأكّد بأنّه لا يمكن أن
...يكون ذلك صحيحاً، لكن

261
00:16:31,800 --> 00:16:37,180
شعرتُ وكأنّك ذكرتَ بأنّ ساكوراجيما-سان
...لم ترَ حلماً، لذا

262
00:16:38,560 --> 00:16:42,770
لا أعتقد بأنّ الأمر كذلك، لكن
شكراً جزيلاً لك على إبلاغي

263
00:16:42,770 --> 00:16:44,900
ماذا؟ لماذا أصبحت مُهذّباً فجأة؟

264
00:16:44,900 --> 00:16:48,020
أنا من النّوع الّذي يحترم مَن هو أكبر منّي

265
00:16:48,020 --> 00:16:48,860
ماذا؟

266
00:16:49,150 --> 00:16:52,360
فوكوياما-سان، أنت أكبر، صحيح؟
بفارق عامين؟

267
00:16:52,360 --> 00:16:54,820
!كيف عرفت ذلك؟ لم أذكر شيئاً

268
00:16:55,110 --> 00:16:58,410
سمعتُ من شخص يعرفك خير معرفة

269
00:16:58,410 --> 00:17:03,460
هل يُعقَل أنّها الحبيبة الّتي كنتَ
تتحدّث عنها في المطار؟

270
00:17:03,460 --> 00:17:04,670
أجل

271
00:17:04,670 --> 00:17:08,340
إذاً هناك أمر نسيتُه فعلاً، صحيح؟

272
00:17:08,840 --> 00:17:10,210
،إذا صدّقتَ ما قلتُه

273
00:17:10,210 --> 00:17:13,260
فافعل ما يلزم من فضلك لإعادتها إلى الذّاكرة

274
00:17:13,840 --> 00:17:17,300
فوكوياما-سان، ذكرتْ حبيبتُك أيضاً
بأنّها لم ترَ حلماً

275
00:17:17,300 --> 00:17:18,140
ماذا؟

276
00:17:18,140 --> 00:17:21,270
قد تكون في وضع خطير كذلك

277
00:17:21,270 --> 00:17:22,430
بجدّية؟

278
00:17:22,430 --> 00:17:23,520
بجدّية

279
00:17:23,980 --> 00:17:29,060
،عقلي مليء بالأفكار عن ماي-سان
لذا سأتركها لك

280
00:17:29,570 --> 00:17:33,900
إذا فعلتُ شيئاً حيال الأمر، فهلّا توقّفتَ
عن طريقة الكلام المُهذّبة المُريبة هذه؟

281
00:17:33,900 --> 00:17:35,320
أعدُك

282
00:17:35,320 --> 00:17:37,490
هذا يمنحني حافزاً

283
00:17:37,490 --> 00:17:38,780
حسناً، إلى اللّقاء

284
00:17:45,660 --> 00:17:47,460
ساكوتا؟ ما الأمر؟

285
00:17:47,460 --> 00:17:49,250
...ماي-سان -
ماذا؟ -

286
00:17:49,250 --> 00:17:50,670
أريد رؤيتك الاًن

287
00:17:50,670 --> 00:17:52,800
ماذا؟ هذا مثاليّ

288
00:17:55,220 --> 00:17:57,470
الطّقس بارد في الخارج، لذا
افتح الباب بسرعة

289
00:18:02,100 --> 00:18:03,560
ما الأمر؟

290
00:18:05,350 --> 00:18:06,390
ماي-سان

291
00:18:11,860 --> 00:18:13,280
ما الأمر؟

292
00:18:13,280 --> 00:18:16,490
سوف أحميكِ

293
00:18:17,490 --> 00:18:21,080
إذاً أنا سأحميك

294
00:18:25,000 --> 00:18:28,000
جاري الاتّصال بخدمة البريد الصّوتيّ

295
00:18:29,790 --> 00:18:33,210
اتّصلتُ لأنّ هناك شيئاً أريد
مُساعدتك فيه

296
00:18:37,010 --> 00:18:38,720
...حيّ كانازاوا في يوكوهاما

297
00:18:44,220 --> 00:18:46,520
هذا هو المكان، صحيح؟

298
00:18:52,310 --> 00:18:54,530
أتيتُ إلى هنا كما طلبتِ فحسب

299
00:18:55,190 --> 00:18:56,030
خذ هذه

300
00:18:56,280 --> 00:18:59,410
ارمِها في مكبّ النّفايات في الطّابق
السّفليّ. شكراً

301
00:19:13,250 --> 00:19:14,550
تأخّرتَ كثيراً

302
00:19:14,550 --> 00:19:16,920
ألا ينبغي أن تستهلّي كلامكِ بالشّكر؟

303
00:19:17,340 --> 00:19:19,340
شكراً. أنقذتني

304
00:19:19,840 --> 00:19:22,390
وهل يمكنني التخلُّص من هذا؟

305
00:19:23,100 --> 00:19:26,140
ألم يكن هذا شيئاً ثميناً بالنّسبة لكِ؟

306
00:19:26,720 --> 00:19:28,100
عمّاذا تتكلّم؟

307
00:19:28,850 --> 00:19:30,310
ادخل بسرعة

308
00:19:50,460 --> 00:19:52,330
لا تقف مكانك فحسب

309
00:19:52,750 --> 00:19:54,960
أريدك أن تبني هذه

310
00:19:55,710 --> 00:19:58,170
الفتيان ماهرون في أشياء كهذه، صحيح؟

311
00:19:58,590 --> 00:20:01,590
أعتقد بأنّ هناك فتياناً غير
ماهرين في هذا أيضاً

312
00:20:05,180 --> 00:20:08,600
تعلمين كيف أنّ دريمينغ أحدثتْ
ضجّة في الكريسماس الماضي، صحيح؟

313
00:20:09,100 --> 00:20:10,270
ماذا يعني؟

314
00:20:10,270 --> 00:20:13,600
كيريشيما-سان، قلتِ بأنّكِ
لم تُشاهدي حلماً، صحيح؟

315
00:20:14,190 --> 00:20:16,270
مثل حبيبتك فحسب

316
00:20:17,020 --> 00:20:21,650
سمعتُ إشاعة غريبة عن أنّ الأشخاص
الّذين لم يروا حلماً

317
00:20:21,650 --> 00:20:25,410
لم روها لأنّهم ليسوا موجودين في المُستقبل

318
00:20:25,410 --> 00:20:26,410
...معنى هذا

319
00:20:27,200 --> 00:20:28,910
أنّهم ماتوا

320
00:20:30,500 --> 00:20:32,670
وهذه ليست إشاعة فحسب

321
00:20:32,670 --> 00:20:34,670
هناك شخص مات بالفعل

322
00:20:35,330 --> 00:20:36,790
هل هو شخص تعرفه؟

323
00:20:37,290 --> 00:20:38,920
إنّه شخص تعرفينه أنتٍ

324
00:20:39,630 --> 00:20:43,430
كان هناك فتى انتقل من طوكيو
في أيّام المدرسة الإعداديّة، صحيح؟

325
00:20:43,800 --> 00:20:45,800
لا أعرف شخصاً كهذا

326
00:20:45,800 --> 00:20:50,810
سارع فوكوياما بالعودة إلى هوكّايدو
قد يتمكّن من حضور جنازة ذلك الشّخص

327
00:20:51,310 --> 00:20:52,890
من هو فوكوياما؟

328
00:20:53,190 --> 00:20:56,690
!ماذا؟ تاكومي فوكوياما، حبيبكِ

329
00:20:57,020 --> 00:20:58,820
لا أعرف شخصاً كهذا

330
00:20:58,820 --> 00:21:01,820
إنّه شخصٌ كنتِ تُواعدينه منذ
!عشتِ في هوكّايدو

331
00:21:01,820 --> 00:21:03,650
أقول لك بأنّني لا أعلم

332
00:21:03,820 --> 00:21:07,780
فوكوياما، الشّخص الّذي واعدتِه
كـ نيني إيواميزاوا

333
00:21:07,780 --> 00:21:09,990
اسم آخر لا أعرفه

334
00:21:09,990 --> 00:21:10,830
ماذا؟

335
00:21:12,290 --> 00:21:14,420
من إيواميزاوا هذه؟

336
00:21:17,130 --> 00:21:19,210
هذا هو اسمكِ الحقيقيّ

337
00:21:20,420 --> 00:21:23,380
عمّاذا كنت تتكلّم طوال هذا الوقت؟

338
00:21:23,380 --> 00:21:26,970
قلتُ مراراً بأنّني توكو كيريشيما، أليس كذلك؟

339
00:21:31,680 --> 00:21:35,060
يبدو أنّه تسلسُل أحداث غريب آخر

340
00:21:35,390 --> 00:21:37,730
لهذا السّبب أستشيركِ

341
00:21:37,730 --> 00:21:41,030
إذاً لنتكلّم عن غرفة سانتا كلوز

342
00:21:41,440 --> 00:21:44,900
أخبرتني هيميجي-سان بأنّه
،في فيديوهات توكو كيريشيما

343
00:21:44,900 --> 00:21:48,450
هناك دوماً أداة لها علاقة
بالشّاشة الرّئيسيّة للكريسماس

344
00:21:50,990 --> 00:21:55,330
لعلّ نيني إيواميزاوا لاحظتْ ذلك
وبدأت بجمع نفس الأدوات؟

345
00:21:55,330 --> 00:21:56,500
ما الغاية؟

346
00:21:57,210 --> 00:21:59,790
لتصبح توكو كيريشيما بالطّبع

347
00:22:00,290 --> 00:22:03,090
إن كنتِ توكو كيريشيما، فسيكون
من التّناقُض

348
00:22:03,090 --> 00:22:06,010
عدم امتلاك أغراض توكو كيريشيما، صحيح؟

349
00:22:06,010 --> 00:22:06,880
...في الواقع

350
00:22:07,380 --> 00:22:10,850
إذا كانت حريصة على أن
...تكون توكو كيريشيما

351
00:22:11,350 --> 00:22:14,230
فهذا يعني أنّ ساكوراجيما-سينباي
في خطر حقّاً

352
00:22:14,730 --> 00:22:15,770
ما مقصدكِ؟

353
00:22:16,350 --> 00:22:19,520
في وسائل التّواصُل، لا تزال ساكوراجيما-سينباي
المُرشّحة الأرجح

354
00:22:19,520 --> 00:22:23,190
كهويّة توكو كيريشيما الحقيقيّة، صحيح؟

355
00:22:23,690 --> 00:22:27,610
بصيغة أُخرى، كي تصبح نيني
إيواميزاوا توكو كيريشيما

356
00:22:27,610 --> 00:22:29,410
ماي-سان تُشكِّل عقبة

357
00:22:29,870 --> 00:22:31,620
ذكرتَ من قبل

358
00:22:31,620 --> 00:22:34,370
أنّ ساكوراجيما-سينباي تعرّضتْ لحادث

359
00:22:34,370 --> 00:22:37,080
في مركز الشّرطة في فعاليّة
نهاريّة غداً، صحيح؟

360
00:22:37,080 --> 00:22:39,380
...أجل، في الحلم الّذي رأته كوغا

361
00:22:39,380 --> 00:22:41,920
أو بالأحرى، في مُحاكاتها للمُستقبل

362
00:22:42,500 --> 00:22:44,420
...لعلّي أبالغ في التّفكير في هذا

363
00:22:44,920 --> 00:22:47,170
لكن الآن، إنّها شخصٌ خفيّ

364
00:22:47,170 --> 00:22:49,180
لذا، من ناحية، يمكنها فعل أيّ شيء، صحيح؟

365
00:22:51,050 --> 00:22:54,560
أعتقد يجب عليّ حسم الأمر
مع حلول يوم غد

366
00:23:55,780 --> 00:23:58,750
أزوساغاوا، يا لك من شقيّ