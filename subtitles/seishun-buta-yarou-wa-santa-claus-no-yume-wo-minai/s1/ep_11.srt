1
00:02:27,580 --> 00:02:32,250
أودّ انتهاز هذه الفُرصة لمُشاركة
إعلان معكم جميعاً

2
00:02:32,670 --> 00:02:35,710
أنا متأكّدة بأنّ بعضاً منكم
...يدرك هذا بالفعل

3
00:02:36,880 --> 00:02:40,340
لكن في الحقيقة، أنا توكو كيريشيما

4
00:02:49,270 --> 00:02:51,850
!والآن، أُغنية إضافيّة

5
00:03:04,280 --> 00:03:05,870
نعم، أكاغي تتكلّم

6
00:03:06,580 --> 00:03:07,830
هذا أنا، أزوساغاوا

7
00:03:08,330 --> 00:03:10,540
هل يمكنني رؤيتكِ بعد هذا؟

8
00:03:19,510 --> 00:03:21,720
صباح الخير يا ماي-سان

9
00:03:22,890 --> 00:03:25,300
هل قلتُ كلاماً غريباً في منامي؟

10
00:03:25,300 --> 00:03:28,470
ماذا كنت تفعل مع أكاغي-سان
في حلمك؟

11
00:03:28,720 --> 00:03:31,940
كنتُ أتّصل بها بهاتفي النّقّال

12
00:03:31,940 --> 00:03:33,440
بهاتفك النّقّال؟

13
00:03:33,440 --> 00:03:34,360
أنت يا ساكوتا؟

14
00:03:34,360 --> 00:03:35,230
أجل

15
00:03:35,230 --> 00:03:37,650
هذا حلم غريب

16
00:03:37,980 --> 00:03:40,110
أعتقد بأنّني كنتُ في مهرجان
موسيقيّ أو ما شابه؟

17
00:03:40,110 --> 00:03:43,160
...كنتِ تُغنّين أغنية توكو كيريشيما هناك

18
00:03:43,660 --> 00:03:46,530
وحتّى أنّكِ ادّعيتِ بأنّكِ توكو كيريشيما

19
00:03:47,950 --> 00:03:51,460
هل تعتقد بأنّ للأمر علاقة
بالأحلام التّنبؤيّة الأخيرة؟

20
00:03:53,120 --> 00:03:54,920
كان ذلك واقعيّاً إلى حدّ مُخيف

21
00:03:55,210 --> 00:03:59,000
لكن ليس لديّ أي مُخطّطات
للأداء في مهرجان موسيقيّ

22
00:03:59,420 --> 00:04:02,300
وأن أكون توكو كيريشيما ليس مُمكناً حتّى

23
00:04:02,970 --> 00:04:05,800
صباح الخير

24
00:04:06,720 --> 00:04:09,720
...ماي-سان، نسيتُ أن أخبركِ البارحة

25
00:04:10,220 --> 00:04:12,600
لكن تلقّينا عرضاً لمشروع غير مألوف

26
00:04:12,600 --> 00:04:14,310
...إنّه عمل يخصُّ الموسيقى، لكن

27
00:04:16,860 --> 00:04:20,400
هل يُعقَل أن يكون عرضاً للأداء
في مهرجان موسيقيّ؟

28
00:04:20,730 --> 00:04:22,860
ماذا؟ كيف عرفتِ ذلك؟

29
00:04:24,660 --> 00:04:29,490
طبقاً لريوكو-سان، سيُقام المهرجان
الموسيقيّ في 1 أبريل

30
00:04:29,870 --> 00:04:31,660
ما زال أمامنا مُتّسعاً من الوقت

31
00:04:32,080 --> 00:04:34,040
أعضاء الفرقة الّتي أدّتْ معي

32
00:04:34,040 --> 00:04:35,920
في الفيلم الّذي صدر في الشّهر الماضي

33
00:04:35,920 --> 00:04:38,790
دعوني لإحدى عروضهم الموسيقيّة
كمُغنّية ضيفة على ما أعتقد

34
00:04:39,840 --> 00:04:42,090
إذاً يا ماي-سان، ماذا ستفعلين؟

35
00:04:42,510 --> 00:04:43,340
سأوافق

36
00:04:43,340 --> 00:04:46,260
فأساساً، إنّه طلب من أشخاص
أشعر بالتزام لمُساعدتهم

37
00:04:46,550 --> 00:04:50,890
هذا يعني أنّ المُستقبل على بُعد
خطوة واحدة عن الحلم الّذي رأيتُه

38
00:04:51,350 --> 00:04:55,850
كلّ ما عليّ فعله الآن هو الإفصاح
للجميع بأنّني توكو كيريشيما؟

39
00:04:56,190 --> 00:05:00,070
هذا يعني أنّه يجب عليّ شراء
هاتف نقّال أيضاً

40
00:05:01,980 --> 00:05:02,860
!عُدت

41
00:05:02,860 --> 00:05:07,740
عدنا لأخبارنا عن مشاكل الاتّصال
في منصّات تواصل اجتماعيّ مُتنوّعة

42
00:05:03,280 --> 00:05:05,150
تأخّرت يا أخي

43
00:05:05,820 --> 00:05:08,740
،نظراً إلى أنّني عدتُ من مُواعدة
فقد عدتُ باكراً جدّاً، أليس كذلك؟

44
00:05:07,740 --> 00:05:10,280
منذ هذا الصّباح، كانت هناك صعوبات

45
00:05:10,280 --> 00:05:13,750
في الوصول إلى العديد
من خدمات التّواصل الاجتماعيّ

46
00:05:14,160 --> 00:05:17,370
سبب الضّغط الفائض
على الخوادم

47
00:05:17,370 --> 00:05:19,880
من منشورات كثيرة في آن واحد
#بهاشتاغ دريمينغ

48
00:05:19,880 --> 00:05:21,960
مضى قرابة نصف يوم
منذ حدوث ذلك

49
00:05:20,380 --> 00:05:21,960
دريمينغ من جديد؟

50
00:05:21,960 --> 00:05:24,340
لكن ما زالت مشاكل الاتّصالات مُستمرّة

51
00:05:24,340 --> 00:05:26,680
كايدي، هل شاهدت حلماً من نوع ما أيضاً؟

52
00:05:24,340 --> 00:05:29,600
هناك احتمال بأن يستغرق الإصلاح
الكامل بعض الوقت

53
00:05:27,510 --> 00:05:28,390
أجل

54
00:05:29,600 --> 00:05:32,520
هل كان حلماً مُحرِجاً لدرجة
لا تودّين الحديث عنه؟

55
00:05:33,100 --> 00:05:35,350
...ليس مُحرِجاً، لكن

56
00:05:35,350 --> 00:05:36,190
لكن؟

57
00:05:36,850 --> 00:05:39,900
كان حلماً حيث عدتُ إلى ذاتي الأُخرى

58
00:05:39,900 --> 00:05:43,150
كنتُ أنتظر مجيئك إلى المنزل
رفقة ناسونو

59
00:05:44,940 --> 00:05:50,030
يدور شيء في ذهنكِ سبّبَ انتكاسة
إلى اضطراب انفصاميّ؟

60
00:05:51,120 --> 00:05:52,280
مثل مسيرتي المهنيّة

61
00:05:52,280 --> 00:05:54,700
هذه مُشكلة كبيرة

62
00:05:55,410 --> 00:05:57,790
سأتقدّم للكلّية أيضاً

63
00:05:58,960 --> 00:06:01,840
ما زلتُ غير مرتاحة في أماكن مُزدحمة بالنّاس

64
00:06:02,340 --> 00:06:05,970
لكن سمعتُ بانّ خيار كومي الأوّل
...كان جامعتك

65
00:06:06,590 --> 00:06:10,550
.لذا ارتأيتُ أن أذهب أيضاً
إذا أردتُ أن أكون مع كومي

66
00:06:11,930 --> 00:06:13,310
هل هذا خاطئ؟

67
00:06:13,810 --> 00:06:15,520
أعتقد لا مانع

68
00:06:15,520 --> 00:06:19,230
كنتُ مُتحفّزاً لارتياد نفس
جامعة ماي-سان أيضاً

69
00:06:19,730 --> 00:06:21,650
بالأحرى، هل ستتداركين الوقت؟

70
00:06:21,650 --> 00:06:23,110
يبدأ عملكِ في السّادسة، صحيح؟

71
00:06:23,980 --> 00:06:24,820
أجل

72
00:06:26,110 --> 00:06:27,190
سأغادر الآن

73
00:06:30,160 --> 00:06:31,910
حلم كايدي إذاً؟

74
00:06:56,640 --> 00:06:57,680
مرحباً

75
00:06:57,680 --> 00:07:01,730
اسمي أزوساغاوا. هل هذا هو
الرّقم الصّحيح لأكاغي-سان؟

76
00:07:02,230 --> 00:07:03,690
أزوساغاوا؟

77
00:07:04,190 --> 00:07:06,320
آسف لاتّصالي بك فجأة
في يوم كهذا

78
00:07:06,820 --> 00:07:09,280
مِمّن حصلتَ على رقمي؟

79
00:07:09,280 --> 00:07:10,860
لم أطلبه من أحد

80
00:07:10,860 --> 00:07:14,700
رأيتُه في حلمي. كنتُ أتّصل بك فيه

81
00:07:15,160 --> 00:07:19,370
لذا اتّصلتُ بهذا الرّقم لأتحقّق
ما إن كان هذا الرّقم حقيقيّاً

82
00:07:19,370 --> 00:07:21,420
أنا آسف لاتّصالي فجأة هكذا

83
00:07:21,420 --> 00:07:22,500
لا تقلق بشأن ذلك

84
00:07:22,880 --> 00:07:25,170
ثمّة أمر أردتُ الحديث معك حوله أيضاً

85
00:07:25,670 --> 00:07:28,670
هل يُعقَل أنّكِ رأيتِ حلماً أيضاً؟

86
00:07:28,670 --> 00:07:32,050
صحيح، حلم تلقّيتُ فيه مُكالمة منك

87
00:07:32,470 --> 00:07:34,090
"قلتَ، "هل يمكنني رؤيتك بعد هذا؟

88
00:07:34,550 --> 00:07:37,640
إذاً حلم في نفس اليوم
الّذي رأيتُ فيه حلماً

89
00:07:38,180 --> 00:07:39,770
...أزوساغاوا

90
00:07:40,640 --> 00:07:43,900
أعتقد بأنّني عرفتُ عمّا كان
يدور حوله الحلم

91
00:07:44,100 --> 00:07:45,270
حقّاً؟

92
00:07:45,770 --> 00:07:48,400
...ذلك الحلم هو في الواقع

93
00:07:49,860 --> 00:07:52,660
هل يمكنني التغيُّب عن درس اليوم يا سينسي؟

94
00:07:53,240 --> 00:07:55,780
على الأقلّ أخبرني بالسّبب؟

95
00:07:55,780 --> 00:07:58,410
رأيتُ حلماً في ليلة الكريسماس

96
00:07:58,950 --> 00:07:59,830
ما طبيعته؟

97
00:08:03,500 --> 00:08:06,000
حلم حيث أُواعد يوشيوا في إينوشيما

98
00:08:06,000 --> 00:08:07,550
هذا حلم بالفعل

99
00:08:07,920 --> 00:08:11,670
أكلنا طبقَ سردين طازجاً، وأطعمَتْني
،هي بوظة ناعمة

100
00:08:11,670 --> 00:08:13,010
وكنّا نُمسك بأيدي بعضنا الآخر

101
00:08:13,510 --> 00:08:16,350
أي أنّك تشعر بالإحراج من رؤية
،يوشيوا-سان الآن

102
00:08:16,350 --> 00:08:18,470
وتريد التغيُّب عن درس اليوم؟

103
00:08:18,470 --> 00:08:19,310
!أجل

104
00:08:19,770 --> 00:08:22,940
يامادا، أنت مُعجب بهيميجي-سان
في الآونة الأخيرة، أليس كذلك؟

105
00:08:24,940 --> 00:08:28,900
اصطدمتُ بهيميجي-سان في ليلة
الكريسماس في محطّة القطار

106
00:08:28,900 --> 00:08:32,570
قالت، "أنا آسفة إذا جعلتُك تحصل
"على فكرة خاطئة حتّى الآن

107
00:08:32,570 --> 00:08:37,160
ظننتُ بأنّك لا تؤمن بقصص الغوامض
مثل دريمينغ؟

108
00:08:37,320 --> 00:08:41,620
لا أؤمن بها، لكن لعلّ يوشيوا رأتْ
!نفس الحلم الّذي رأيتُه

109
00:08:41,620 --> 00:08:43,210
!يحدث هذا مع كثير من النّاس

110
00:08:50,800 --> 00:08:53,260
شاهدا فعلاً نفس الحلم

111
00:08:53,760 --> 00:08:57,010
على أيّ حال، ألا يوجد الكثير
من النّاس يتحدّثون عن الأحلام؟

112
00:09:02,060 --> 00:09:04,730
لا، ظننتُ حقّاً بأنّه كان موتشي. أتفهمونني؟

113
00:09:04,730 --> 00:09:05,900
هذا سخيف

114
00:09:06,270 --> 00:09:09,690
ماي-سان، شكراً لكِ على
إرسال كعك سمك لنا

115
00:09:09,690 --> 00:09:11,730
أُرسِلَ ذلك باسمي، أليس كذلك؟

116
00:09:12,320 --> 00:09:14,780
كانت ماي-سان لطيفة بما يكفي
لإرساله، أليس كذلك؟

117
00:09:15,530 --> 00:09:18,660
.أمّي يُعتمَد عليها حقّاً
تفهمين حقّاً

118
00:09:18,990 --> 00:09:21,830
!سنعود مباشرة بعد الأخبار

119
00:09:22,040 --> 00:09:24,040
،حان وقت الأخبار. قبل فجر الأمس

120
00:09:24,040 --> 00:09:26,290
اعتقال رجل يمشي من مكان لآخر
ويعبث بنمرة السّيّارات

121
00:09:26,290 --> 00:09:29,840
في حيّ يوكوهاما السّكنيّ

122
00:09:30,130 --> 00:09:31,960
،أثناء استجواب الشّرطة، صرّح الرّجل

123
00:09:31,960 --> 00:09:34,130
رأيتُ حلماً بأنّني ما زلتُ"
لم أتوظّف في أبريل

124
00:09:34,130 --> 00:09:36,130
"فعلتُ ذلك لأنّني كنتُ غاضباً ومستاء

125
00:09:36,130 --> 00:09:41,100
ما زالت الشّرطة تُحقّق نظراً لاحتماليّة
أنّه ارتكب جرائمَ أُخرى

126
00:09:38,640 --> 00:09:40,640
هذه حادثة غريبة جدّاً

127
00:09:40,640 --> 00:09:41,600
أتّفق

128
00:09:42,140 --> 00:09:45,730
بالمناسبة، ما طبيعة الحلم الّذي
رأيتِه في ليلة الكريسماس يا ماي-سان؟

129
00:09:46,520 --> 00:09:48,100
لم أرَ حلماً

130
00:09:48,600 --> 00:09:49,650
هكذا إذاً

131
00:09:50,440 --> 00:09:53,150
ماي-سان، لديكِ مراسم بلوغ سنّ
الرّشد هذا العام، صحيح؟

132
00:09:53,400 --> 00:09:54,990
هل سترتدين كيمونو بأكمام طويلة؟

133
00:09:55,440 --> 00:10:00,740
زارتني أمّي فجأة في الأمس وتركتْ
"واحداً لي قائلة، "ارتدي هذه

134
00:10:01,030 --> 00:10:02,370
!ما أجمله

135
00:10:02,370 --> 00:10:04,250
أنا متأكّدة بأنّه سيليق بكِ يا ماي-سان

136
00:10:04,580 --> 00:10:06,460
هذا مُبهر حقّاً

137
00:10:06,960 --> 00:10:09,000
أتطلّع قُدماً لبلوغ كايدي
سنّ العشرين أيضاً

138
00:10:09,460 --> 00:10:11,420
ما زال الطّريق أمامي طويلاً

139
00:10:12,090 --> 00:10:13,800
ثلاث سنوات أُخَر

140
00:10:14,000 --> 00:10:15,670
!أقول أنّه ما زال الطّريق أمامي طويلاً

141
00:10:16,220 --> 00:10:19,220
!لكن ثلاث سنوات ستنتهي بلمح البصر

142
00:10:20,220 --> 00:10:22,050
ليلة الكريسماس؟ رأيتُ واحداً أيضاً

143
00:10:22,050 --> 00:10:24,640
حلماً حيث كنّا نؤدّي على الهواء مباشرة
في قاعة حفلات موسيقيّة في يوكوهاما

144
00:10:25,220 --> 00:10:28,640
كافّة أعضاء مجموعتي قالوا
بأنّهم شاهدوا نفس الحلم أيضاً

145
00:10:28,940 --> 00:10:30,350
هكذا إذاً

146
00:10:30,350 --> 00:10:32,440
.آسف لإزعاجكِ أثناء استراحتكِ
إلى اللّقاء

147
00:10:32,940 --> 00:10:35,730
هل أنت قلق من أنّني لم أرَ حلماً؟

148
00:10:36,240 --> 00:10:38,900
لأنّكِ الوحيدة المُقرّبة منّي
الّتي لم ترَ واحداً

149
00:10:39,490 --> 00:10:43,370
أنا قلق أكثر بشأن رؤيتك
حلماً غريباً جدّاً

150
00:10:43,990 --> 00:10:47,370
يمكنك حتّى رؤية سانتا كلوس لا أراه

151
00:10:47,710 --> 00:10:49,960
فضلاً عن ذلك، إذا كان بشأن
،عدم رؤية حلم

152
00:10:49,960 --> 00:10:52,540
يمكنك قول نفس الكلام لوالديك، صحيح؟

153
00:10:52,540 --> 00:10:54,550
إنّهما بالغان بالفعل

154
00:10:54,550 --> 00:10:56,130
إنّهما بعيدان كلّ البُعد عن الاحتلام

155
00:10:56,630 --> 00:10:59,260
إذاً ربّما المُراهقة انتهت بالنّسبة لي أيضاً

156
00:10:59,760 --> 00:11:02,300
أنتِ ناضجة من أكثر من ناحية يا ماي-سان

157
00:11:02,300 --> 00:11:04,930
ينبغي أن تنضج قريباً أيضاً

158
00:11:04,930 --> 00:11:08,430
بهذا الشّكل، لن تقلق بشأن
مُتلازمة المُراهقة بعدها

159
00:11:11,480 --> 00:11:13,980
صباح الخير يا ساكوتا-سينسي

160
00:11:14,520 --> 00:11:16,070
مرحباً يا هيميجي-سان

161
00:11:16,230 --> 00:11:18,940
سينسي، يجب أن تتفاجأ قبل كلّ شيء

162
00:11:18,940 --> 00:11:22,110
في العادة، يجب أن أسمعك
"تقول "لماذا أنتِ هنا؟

163
00:11:22,490 --> 00:11:24,410
بدأتِ بالعمل، صحيح؟

164
00:11:24,410 --> 00:11:25,660
هذا واضح من مُجرّد النّظر

165
00:11:25,950 --> 00:11:27,910
بئساً، أنت مُملّ جدّاً

166
00:11:28,330 --> 00:11:30,540
،بالمناسبة يا هيميجي-سان

167
00:11:30,540 --> 00:11:32,330
هل رأيتِ أيّ حلم في ليلة الكريسماس؟

168
00:11:32,750 --> 00:11:34,000
رأيتُ واحداً

169
00:11:34,000 --> 00:11:36,750
ذهبتُ إلى إينوشيما للتنزُّه مع أصدقاء

170
00:11:37,210 --> 00:11:40,220
لم تري يامادا هناك بالمُناسبة؟

171
00:11:40,670 --> 00:11:43,760
رأيتُه في مُواعدة مع يوشيوا-سان

172
00:11:44,260 --> 00:11:46,260
كان واقعاً في حُبّي منذ
فترة ليست ببعيدة

173
00:11:46,260 --> 00:11:47,890
أليس يامادا فظيعاً؟

174
00:11:48,310 --> 00:11:49,230
بالمناسبة

175
00:11:49,730 --> 00:11:51,980
هل تعلم بهذا يا ساكوتا-سينسي؟

176
00:11:52,520 --> 00:11:55,900
الجميع يقولون بأنّ ماي ساكوراجيما
هي توكو كيريشيما

177
00:11:56,400 --> 00:11:58,980
هناك أكثر من 5000 منشور حول ذلك

178
00:11:58,980 --> 00:12:02,110
خمسة آلاف عدد كبير جدّاً بالفعل

179
00:12:03,700 --> 00:12:06,330
ماذا؟ هل لديكِ شكوى ضدّي؟

180
00:12:06,990 --> 00:12:10,700
لا، ارتأيتُ فقط بأنّني أودّ
الحديث معك حول دريمينغ

181
00:12:11,210 --> 00:12:13,790
إذاً رأيت حلماً في ليلة الكريسماس أيضاً؟

182
00:12:14,420 --> 00:12:16,090
أعتقد بأنّ الجميع رأوا واحداً

183
00:12:16,590 --> 00:12:21,050
إذاً هل رأيتِ أيضاً إفصاح ماي-سان
أثناء المهرجان الموسيقيّ في حلمكِ؟

184
00:12:21,550 --> 00:12:22,880
لم أرَ ذلك

185
00:12:22,880 --> 00:12:24,050
إذاً ماذا كان حلمكِ؟

186
00:12:24,680 --> 00:12:28,720
رأيتُ حلماً يقع قبل 1 أبريل بكثير

187
00:12:29,220 --> 00:12:31,350
في الحلم، في 4 فبراير، ساكوراجيما-سينباي

188
00:12:31,350 --> 00:12:35,900
"تُقيم حدثَ "رئيس شرطة لمدّة يوم
في محطّة شرطة فوجيساوا

189
00:12:36,650 --> 00:12:39,530
لكن سمعتُ في الأخبار كيف أنّها
،تعرّضت لحادث أثناء الحدث

190
00:12:39,530 --> 00:12:42,700
وغابت عن الوعي، وهي في حالة حرجة

191
00:12:43,200 --> 00:12:45,610
قالوا بأنّها سُحِقَتْ بواسطة
أداة ما قد سقطت

192
00:12:45,610 --> 00:12:47,280
ونُقِلتْ إلى المشفى

193
00:12:48,950 --> 00:12:52,370
وبعد؟ لا تعرفين ما حدث
عقب ذلك، صحيح؟

194
00:12:52,830 --> 00:12:55,500
على الأقلّ، لم يكن هناك أيّ! إعلان

195
00:12:55,500 --> 00:12:57,790
بأنّها استعادتْ وعيها قبل 9 أبريل

196
00:12:58,130 --> 00:13:01,510
ماذا؟ قضيتِ كلّ تلك الأيّام في حلمكِ؟

197
00:13:02,010 --> 00:13:03,920
—ليست أيّاماً كثيرة إلى هذا الحدّ، لكن

198
00:13:03,920 --> 00:13:07,640
لا يمكن أن تكوني قد شهدتِ كلّ يوم
بين ليلة الكريسماس و 9 أبريل، صحيح؟

199
00:13:07,850 --> 00:13:09,390
ماذا لو فعلت؟

200
00:13:09,890 --> 00:13:13,230
في هذه الفترة، ليس وكأنّني كنتُ أكرّر
نفس اليوم مراراً

201
00:13:13,640 --> 00:13:14,730
دعيني أُخمّن

202
00:13:14,730 --> 00:13:16,690
،كنتِ قد أوشكتِ على التخرُّج من الثّانويّة

203
00:13:16,690 --> 00:13:19,520
،وقلقة بشأن التعرُّف على أصدقاء في المدرسة

204
00:13:19,520 --> 00:13:21,150
لذا كنتِ تشعرين بالقلق، أليس كلك؟

205
00:13:21,980 --> 00:13:23,610
اصمت

206
00:13:24,240 --> 00:13:26,450
لكن حاليّاً، شكراً

207
00:13:26,450 --> 00:13:27,950
أنقذتِني حقّاً

208
00:13:27,950 --> 00:13:30,240
حسناً. سأذهب من هنا

209
00:13:30,240 --> 00:13:32,040
اشترِ لي مون بلانك يوماً ما، اتّفقنا؟

210
00:13:34,790 --> 00:13:36,790
ابحث عن توكو كيريشيما
!ماي-سان في خطر

211
00:13:37,330 --> 00:13:40,500
هذا يُشوّشني تماماً الآن

212
00:13:41,000 --> 00:13:43,010
الشّقيّ لا يحلم بسانتا كلوز

213
00:13:43,010 --> 00:13:47,640
‏6 يناير

214
00:13:43,960 --> 00:13:47,640
أتساءل إن كان أزوساغاوا هو
الهويّة الحقيقيّة لتوكو كيريشيما

215
00:13:48,050 --> 00:13:50,390
من الطّبيعيّ أن يكون كذلك إذا كان الحبيب

216
00:13:50,890 --> 00:13:52,600
!أزوساغاوا، عام جديد سعيد

217
00:13:52,890 --> 00:13:55,770
أتمنّى لك عاماً جديداً سعيداً كذلك -
!آمل أن تقضي عاماً جميلاً

218
00:13:55,770 --> 00:13:58,270
أتمنّى لك السّلامة الدّائمة
في العام المُقبل

219
00:13:58,270 --> 00:13:59,100
هل أنت جادّ؟

220
00:13:59,480 --> 00:14:04,610
الحبيبة الأظرف في العالم قد علّمَتْني
إلقاء التّحية على الآخرين كما ينبغي

221
00:14:06,490 --> 00:14:10,820
بالمناسبة، بخصوص ساكوراجيما-سان
...تلك الأظرف في العالم

222
00:14:11,330 --> 00:14:13,990
ذلك الأمر الّذي يخصُّ كونها
توكو كيريشيما، هل هذا حقيقيّ؟

223
00:14:13,990 --> 00:14:17,210
ذلك الأمر الّذي يتحمّس له النّاس عبر
وسائل التّواصُل كتكهُّن جماعيّ

224
00:14:17,540 --> 00:14:21,170
رؤية المُستقبل في الأحلام؟
لا يمكنك اتّخاذ هذا على محمل الجدّ

225
00:14:21,170 --> 00:14:23,300
...أنا لا أتّخذ الأمر بجدّية، لكن

226
00:14:23,630 --> 00:14:25,630
ما طبيعة الحلم الّذي رأيته؟

227
00:14:26,010 --> 00:14:28,090
عدتُ إلى هوكّايدو لأجل شيء

228
00:14:28,340 --> 00:14:29,640
لماذا هوكّايدو؟

229
00:14:29,640 --> 00:14:30,720
أنا من هناك

230
00:14:30,720 --> 00:14:32,350
هذه أوّل مرّة أسمع فيها بذلك

231
00:14:32,560 --> 00:14:34,970
أخبرتُك عندما عرّفتُ عن نفسي

232
00:14:34,970 --> 00:14:37,810
قلتُ أيضاً بأنّ عيد ميلادي
في 30 من الشّهر الجاري

233
00:14:37,980 --> 00:14:39,600
أوّل مرّة أسمع فيها بذلك أيضاً

234
00:14:40,100 --> 00:14:43,900
أو بالاحرى، هل من الشّائع أن يأتي النّاس
من هوكّايدو إلى جامعتنا؟

235
00:14:44,280 --> 00:14:45,320
لماذا ذلك؟

236
00:14:45,320 --> 00:14:48,820
تعرّفتُ مؤخّراً على تلميذ
آخر من هوكّايدو

237
00:14:48,820 --> 00:14:52,030
أعرفك، لا بُدّ أنّه فتاة ظريفة حقّاً

238
00:14:52,030 --> 00:14:53,030
هل يمكنك أن تُعرّفني؟

239
00:14:53,490 --> 00:14:56,410
فوكوياما، لماذا اخترت جامعتنا؟

240
00:14:56,580 --> 00:14:59,040
لا تُغيّر الموضوع بشكل واضح

241
00:14:59,040 --> 00:15:01,080
...لا بُدّ أنّها الظّريفة

242
00:15:05,460 --> 00:15:06,300
ما الخطب؟

243
00:15:06,880 --> 00:15:11,510
على ذكر الأمر، لماذا اخترتُ
التقدُّم لهذه الجامعة؟

244
00:15:25,690 --> 00:15:27,030
علينا أن نتكلّم

245
00:15:29,650 --> 00:15:32,160
في منتصف امتحان الآن

246
00:15:32,620 --> 00:15:34,740
إذاً سأنتظر هنا حتّى تنتهي

247
00:15:41,210 --> 00:15:44,960
أنا آسف. معدتي تؤلمني، لذا
سأدخل دورة المياه

248
00:16:01,600 --> 00:16:04,190
حسناً، ماذا تريدين منّي؟

249
00:16:04,690 --> 00:16:07,020
ما الّذي تنوي له حبيبتك؟

250
00:16:07,020 --> 00:16:08,440
تنوي له؟

251
00:16:08,440 --> 00:16:10,820
لماذا يقول النّاس بأنّها توكو كيريشيما؟

252
00:16:11,320 --> 00:16:12,740
،إذا أردتِ أن تشتكي

253
00:16:12,740 --> 00:16:16,950
فيجدر بك أن تُعلني فحسب، "أنا
"توكو كيريشيما الحقيقيّة

254
00:16:17,120 --> 00:16:19,080
لماذا لا تبثّين ذلك عبر الإنترنت الآن؟

255
00:16:19,370 --> 00:16:23,250
لا جدوى. أيّ مقطع فيديو بوجهي
سيكون خفيّاً لدى الجميع

256
00:16:23,250 --> 00:16:27,340
كلّ ما يمكنهم رؤيته هو مشاهد
خلفيّة أُصوّرها من بعيد

257
00:16:27,630 --> 00:16:31,340
إذاً أنتِ بحاجة أوّلاً لأن يلاحظكِ الآخرون

258
00:16:32,130 --> 00:16:35,390
كيريشيما-سان، ألا تملكين سبباً
بشأن حدوث ذلك؟

259
00:16:35,390 --> 00:16:36,470
لا

260
00:16:36,470 --> 00:16:39,350
ليس لدى إيواميزاوا-سان أيّ
أفكار أيضاً؟

261
00:16:40,180 --> 00:16:41,770
يبدو أنّ هناك شيئاً من هذا القبيل

262
00:16:41,770 --> 00:16:44,850
سيُحَلُّ كلّ هذا إذا أنكرتْ
حبيبتك ذلك ببساطة

263
00:16:44,850 --> 00:16:46,230
يمكنك تحقيق ذلك، صحيح؟

264
00:16:46,610 --> 00:16:49,860
،لو كنتُ أستطيع تحقيق شيء
فهل سأتلقّى منكِ شيئاً بالمُقابل؟

265
00:16:50,400 --> 00:16:51,530
...لنرَ

266
00:16:52,190 --> 00:16:54,110
سأخرج في مُواعدة معك ليوم

267
00:16:54,950 --> 00:16:55,820
مُوافق

268
00:16:56,320 --> 00:16:57,490
سأحقِّق شيئاً

269
00:17:02,450 --> 00:17:04,000
اتّفقنا

270
00:17:06,670 --> 00:17:08,250
إذاً، أعتمد عليك

271
00:17:09,710 --> 00:17:13,220
بالمناسبة يا كيريشيما-سان، ما طبيعة
الحلم الّذي رأيتِه؟

272
00:17:13,720 --> 00:17:15,220
لم أرَ واحداً

273
00:17:15,720 --> 00:17:17,550
هذا مثل ماي-سان

274
00:17:21,850 --> 00:17:23,730
أهلاً بعودتك يا فتى الإسهال

275
00:17:24,230 --> 00:17:26,980
هل هذا عنوان مسلسل دراميّ صباحيّ
يبدأ في العام المُقبل؟

276
00:17:27,440 --> 00:17:30,400
سارعَ الجميع في حلقتنا الدّراسيّة
،الأساسيّة وغادروا

277
00:17:30,400 --> 00:17:32,360
قائلين بأنّهم سيُقيمون حفلة عام جديد

278
00:17:32,900 --> 00:17:34,860
لم تذهبي يا ميتو؟

279
00:17:35,200 --> 00:17:37,870
ثمّة أمر أردتُ أن أخبرك به

280
00:17:38,240 --> 00:17:41,490
أتسألين عن نوعي المُفضَّل؟
ماي-سان بالطّبع

281
00:17:41,490 --> 00:17:45,000
إذاً من كانت المرأة الّتي غادرت
الغرفة معها قبل قليل؟

282
00:17:45,920 --> 00:17:49,420
ترتدي ثياب سانتا بتنّورة قصيرة
بين الحين والآخر، أليس كذلك؟

283
00:17:50,130 --> 00:17:51,420
استطعتِ رؤيتها؟

284
00:17:54,760 --> 00:17:57,300
هكذا إذاً. فهمتُ فحوى الأمر الآن

285
00:17:57,800 --> 00:18:00,300
لهذا إذاً حدّقتْ مانامي بي
بنظرة غريبة قبل أيّام

286
00:18:00,300 --> 00:18:02,470
"عندما قلتُ لها، "توجد سانتا هناك

287
00:18:02,470 --> 00:18:04,730
في الحقيقة، ليس وكأنّها خفيّة

288
00:18:04,730 --> 00:18:08,190
لكن لا أحد، غيري وغيرك، يُلاحظها

289
00:18:08,690 --> 00:18:10,480
نفس الأمر ينطبق على الصّفحة الرّئيسيّة
لمُسابقة ملكة جمال الحرم

290
00:18:10,480 --> 00:18:14,110
الصّفحة الّتي تحكي عن خفاء
نيني إيواميزاوا أمام الجميع

291
00:18:14,610 --> 00:18:16,530
هل يمكنني رؤية ذلك؟

292
00:18:17,400 --> 00:18:19,700
تحملين هذا معكِ كلّ يوم

293
00:18:20,070 --> 00:18:22,740
لا ينبغي أن تختلس النّظر
إلى مكتبة عذراء

294
00:18:23,160 --> 00:18:25,830
إذاً يحتوي هذا على بعض الملفّات الفاحشة

295
00:18:26,080 --> 00:18:27,580
هذا طبيعيّ

296
00:18:29,380 --> 00:18:31,000
ربّما هذا؟

297
00:18:31,000 --> 00:18:32,550
الجائزة الكبرى للعام السّابق

298
00:18:33,130 --> 00:18:37,050
،طالبة سنة ثانية في التّربية الدّوليّة
الأصل من هوكّايدو

299
00:18:37,340 --> 00:18:38,180
هذه

300
00:18:38,590 --> 00:18:41,010
إنّها في مواقع التّواصل الاجتماعيّ أيضاً

301
00:18:41,930 --> 00:18:45,060
هل تعتقدين بأنّ هناك ظرفاً
جعلَها ترغب في الاختفاء؟

302
00:18:45,060 --> 00:18:48,890
توقّفتْ عن النّشر في أبريل، لذا
ربّما يكون قد حدث شيء إذاً؟

303
00:18:49,350 --> 00:18:50,190
على سبيل المثال؟

304
00:18:50,520 --> 00:18:54,650
ربّما عادتْ ماي-سان بعد قضاء إذن
الغياب وظهرتْ في الجامعة

305
00:18:54,650 --> 00:18:59,200
وجذبتْ اهتمام الجميع بلمح البصر؟

306
00:18:59,610 --> 00:19:00,450
هكذا إذاً

307
00:19:00,910 --> 00:19:04,200
هذه الفتاة هي عارضة أزياء ورابحة بالجائزة
الكبرى في مُسابقة ملكة جمال الحرم

308
00:19:04,620 --> 00:19:08,410
أنا متأكّدة بأنّ الآخرين تملّقوا لها
في كلّ أنحاء الحرم حتّى ذلك الحين

309
00:19:08,410 --> 00:19:13,000
ربّما كان هذا الحرم مملكة
الأميرة نيني إيواميزاوا

310
00:19:13,000 --> 00:19:14,710
قبل ظهور ماي-سان؟

311
00:19:15,050 --> 00:19:20,340
ثمّ ظهرت ملكة التّمثيل الشّهيرة
ماي ساكوراجيما

312
00:19:20,680 --> 00:19:24,970
ضدّ ماي-سان، من الطّبيعيّ
السّقوط في رمشة عين

313
00:19:24,970 --> 00:19:27,520
ربّما إكليلها الجميل وفستانها أُخِذا منها

314
00:19:27,520 --> 00:19:30,350
وانخفضت رتبتها وصولاً إلى شخص عاديّ

315
00:19:30,940 --> 00:19:33,860
...لهذا اختفتْ نيني إيواميزاوا

316
00:19:34,320 --> 00:19:37,110
لأنّه لم يعُد يُعترَف بقيمتها

317
00:19:37,400 --> 00:19:40,740
أعتقد الأمر مختلف قليلاً

318
00:19:41,360 --> 00:19:44,700
لأنّ ماي-سان قد ظهرتْ، لم تعُد مُميّزة

319
00:19:45,030 --> 00:19:48,620
واكتشفتْ بأنّ كافّة أصدقائها
المزعومين الّذين أحاطوا بها

320
00:19:48,620 --> 00:19:50,750
،كانوا يسخرون منها

321
00:19:50,750 --> 00:19:53,170
لذا أصابها البؤس وتوارت عن الأنظار رُبّما؟

322
00:19:54,210 --> 00:19:57,670
انهزام شخص كان في السّابق
يفرض هيمنته

323
00:19:57,670 --> 00:19:59,880
يجعلك تقول لنفسك، "تستحقّ هذا"، صحيح؟

324
00:20:00,510 --> 00:20:02,260
حسناً، أجل

325
00:20:02,640 --> 00:20:07,890
علاوة على ذلك، يعتقد الأشقياء
بأنّهم لا يؤذون أحداً آخر

326
00:20:08,140 --> 00:20:11,770
إمّا هذا أو يعتقدون بانّه لا مانع
من أذيّة الآخرين

327
00:20:12,100 --> 00:20:15,110
كما لو أنّها كانت ميزة الضّعيف

328
00:20:16,570 --> 00:20:18,780
أحدث شيء لكِ في الماضي يا ميتو؟

329
00:20:18,780 --> 00:20:19,990
شيء؟

330
00:20:19,990 --> 00:20:22,320
كأنّ كلامكِ ينبع من خبرة

331
00:20:22,700 --> 00:20:26,830
من الطّبيعيّ أن أكون قد خضتُ
تجربة أو اثنتين في الماضي

332
00:20:27,120 --> 00:20:30,200
لكنّها توكو كيريشيما كما تعلمين

333
00:20:30,700 --> 00:20:34,000
بتلك السّمعة، يمكنها فرض
الهيمنة قدر ما تريد

334
00:20:34,000 --> 00:20:36,210
"بالقول، "أنا توكو كيريشيما

335
00:20:36,500 --> 00:20:39,590
في هذه الحالة، ربّما ليستْ توكو كيريشيما؟

336
00:20:40,630 --> 00:20:41,470
ماذا؟

337
00:20:42,590 --> 00:20:45,550
من المُؤكّد أنّ صديقتك تقول
كلاماً مُثيراً للاهتمام

338
00:20:45,550 --> 00:20:48,220
رغم أنّها ما زالت تعتبرني صديقاً مُرشَّحاً

339
00:20:48,890 --> 00:20:50,810
وبعد، ما رأيك؟

340
00:20:51,310 --> 00:20:55,480
ما تتحدّث عنه تلك الفتاة هو
إحدى طُرُق التّفكير في الامر

341
00:20:55,480 --> 00:20:56,480
صحيح

342
00:20:56,810 --> 00:20:59,530
أنا مُهتمّة أكثر بشأن ذلك الالتباس

343
00:20:59,530 --> 00:21:02,360
لكن بخصوص ساكوراجيما-سينباي حاليّاً

344
00:21:02,860 --> 00:21:06,620
يتحدّثون حول الأمر كما لو أنّه
كان الحقيقة في جامعتي

345
00:21:06,620 --> 00:21:09,620
بأنّ ساكوراجيما-سينباي هي توكو كيريشيما

346
00:21:09,620 --> 00:21:12,750
أعتقد بأنّ الأمر سيُعالَج بعد يوم غد

347
00:21:13,410 --> 00:21:14,830
في يوم بلوغ سنّ الرّشد؟

348
00:21:14,830 --> 00:21:18,880
ماي-سان هي النّجمة الأشهر
الّتي بلغت 20 في هذا العام، صحيح؟

349
00:21:18,880 --> 00:21:21,840
ستنكر ذلك في مُقابلة وسائل التّواصُل
خلال مراسم بلوغ سنّ الرّشد

350
00:21:21,840 --> 00:21:25,180
وأيضاً تنشر تعليقاً رسميّاً عبر وسائل
التّواصل في نفس الوقت

351
00:21:25,180 --> 00:21:26,930
،إن وقعتْ أي مُشكلة

352
00:21:26,930 --> 00:21:30,010
فستكون بقاء الإشاعات حتّى
بعد تجاوز كلّ تلك الحدود

353
00:21:30,510 --> 00:21:35,350
الأشخاص الّذين رأوا نفس الحلم الّذي رأيتُه
قد يؤمنون أكثر بالأحلام الّتي رأوها

354
00:21:36,270 --> 00:21:40,110
على ذكر الأمر، ما طبيعة الحلم
الّذي رأيته في ليلة الكريسماس؟

355
00:21:40,610 --> 00:21:42,440
حلم كنتُ أواعد فيه كونيمي

356
00:21:42,440 --> 00:21:43,490
ماذا؟

357
00:21:43,490 --> 00:21:45,400
كنّا نأكل في الخارج معاً

358
00:21:45,400 --> 00:21:47,070
أعتقد كانت مُواعدة

359
00:21:47,070 --> 00:21:47,910
حقّاً؟

360
00:21:48,490 --> 00:21:50,240
لكن هذا مستحيل

361
00:21:50,240 --> 00:21:51,490
...كونيمي من بين كلّ النّاس

362
00:21:53,160 --> 00:21:55,920
بعد ذلك الأمر مع كاساي، أدركتُ أمراً

363
00:21:57,460 --> 00:22:01,670
من الخانِق عدم القدرة على مُبادلة
النّاس مشاعرهم

364
00:22:03,050 --> 00:22:05,510
أتساءل ما إن كان يراود
كونيمي نفس الشّعور أيضاً

365
00:22:08,430 --> 00:22:12,100
لا أعتقد بأنّ ذلك الحلم كان المُستقبل

366
00:22:12,600 --> 00:22:14,810
إن كنتِ أنتِ من يقول ذلك، فرُبّما صحيح

367
00:22:15,560 --> 00:22:20,060
بحسب أكاغي  أيضاً، فإنّ الأمر لم يكن
تكهُّن الحلم بالمُستقبل

368
00:22:20,060 --> 00:22:24,070
إنّما كانت نظرة خاطفة للكون المُحتمَل الآخر

369
00:22:25,950 --> 00:22:29,990
،حسناً، حتّى لو كان كذلك
"دعني أقول "فليكُن؟

370
00:22:30,490 --> 00:22:34,540
صحيح. مهما كان المُستقبل
،أو الكون المُحتمَل الآخر

371
00:22:34,540 --> 00:22:37,580
لن نعرف في النّهاية ما لم يحِن
ذلك اليوم فعليّاً

372
00:22:37,580 --> 00:22:40,170
إنّه حلم مُزعج حقّاً

373
00:22:40,710 --> 00:22:42,090
هذا صحيح

374
00:22:42,090 --> 00:22:45,550
سأكون رئيس شرطة لمدّة يوم قريباً

375
00:22:47,090 --> 00:22:50,180
هل يُصادِف ذلك 4 فبراير؟

376
00:22:50,510 --> 00:22:51,800
...أجل

377
00:22:52,300 --> 00:22:53,390
لكن كيف عرفت؟

378
00:23:56,160 --> 00:23:59,000
أخي، يا لك من شقيّ