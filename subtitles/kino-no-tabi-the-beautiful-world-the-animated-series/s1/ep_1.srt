1
00:00:06,200 --> 00:00:08,850
...هذا مبهم، لكن

2
00:00:09,300 --> 00:00:11,380
مبهم، لكن؟

3
00:00:12,390 --> 00:00:18,770
أتساءل أحياناً إن ما كنتُ شخصاً
ميؤوساً منه، ساذجاً، ومثيراً للشفقة؟

4
00:00:19,250 --> 00:00:21,940
أأنا شخصٌ دنيءٌ حقّاً؟

5
00:00:22,580 --> 00:00:24,440
لا أفهم السبب

6
00:00:25,020 --> 00:00:27,260
لكن أشعر بهذا أحياناً

7
00:00:27,910 --> 00:00:30,700
ويكون كلّ ما يشغل بالي أحيان أخرى

8
00:00:31,100 --> 00:00:34,800
لكن في تلك الأوقات حيث أجد أشياء أخرى دوماً

9
00:00:34,800 --> 00:00:35,950
على سبيل المثال، كالعالم

10
00:00:36,640 --> 00:00:38,910
أو أسلوب عيشة بقيّة الناس

11
00:00:39,380 --> 00:00:43,670
التحلّي بالجمال الكلّي والروعة

12
00:00:44,120 --> 00:00:47,130
تصبح عزيزةً عليّ

13
00:00:47,810 --> 00:00:51,130
أريد معرفة المزيد والمزيد عنها

14
00:00:51,680 --> 00:00:54,540
ولذا أظنّ أنّي أسافر

15
00:00:56,430 --> 00:00:58,740
أعرف أنّه في ترحالي

16
00:00:58,740 --> 00:01:05,150
سأجد الكثير من المشاق والمآسي على الطريق أمامي

17
00:01:07,270 --> 00:01:10,300
لكن لا يجعلني ذلك أفكّر بالتوقف عن الترحال

18
00:01:11,260 --> 00:01:13,850
الترحال مسلٍّ

19
00:01:13,850 --> 00:01:16,690
وحتّى لو كان عليّ قتل آخرين

20
00:01:16,690 --> 00:01:19,280
سأظلّ أريد التقدّم للأمام

21
00:01:20,150 --> 00:01:21,370
...كما

22
00:01:21,600 --> 00:01:22,620
كما؟

23
00:01:23,380 --> 00:01:25,570
يمكنني التوقّف متى أردت

24
00:01:26,340 --> 00:01:28,920
لذا أريد الاستمرار

25
00:01:29,860 --> 00:01:31,390
يبدو هذا منطقياً؟

26
00:01:31,390 --> 00:01:33,530
بصراحة، لا أفهم تماماً

27
00:01:34,150 --> 00:01:35,910
لا بأس بهذا أيضاً

28
00:01:35,910 --> 00:01:36,640
حقّاً؟

29
00:01:37,760 --> 00:01:42,440
ربما لا أفهم تماماً بدوري كذلك

30
00:01:42,440 --> 00:01:44,310
لعلّي تائه

31
00:01:44,820 --> 00:01:50,020
ولعلّي أرتحل لفهم ذلك أكثر

32
00:01:53,290 --> 00:01:56,250
حسناً، سأخلد للنوم الآن

33
00:01:56,250 --> 00:01:58,570
لا يزال أمامنا طريقٌ طويلٌ غداً

34
00:01:59,910 --> 00:02:02,150
عمتَ مساءً يا هيرمس

35
00:02:02,150 --> 00:02:03,910
عمتَ مساءً يا كينو

36
00:02:05,580 --> 00:02:09,920
تائهٌ في الغابة . ب

37
00:02:29,160 --> 00:02:31,590
كينو، لم نصل للبلد القادم بعد؟

38
00:02:31,590 --> 00:02:33,190
قريباً يا هيرمس

39
00:02:33,720 --> 00:02:36,360
هل تعني "قريباً" بالنسبة لك يومين كاملين؟

40
00:02:36,360 --> 00:02:39,240
هذا ما قالوه في البلد السابق

41
00:02:44,040 --> 00:02:45,460
ذاك حصان

42
00:02:47,620 --> 00:02:49,710
يبدو أنّ أحدهم هناك

43
00:02:51,630 --> 00:02:53,340
لنتوقّف يا هيرمس

44
00:03:04,820 --> 00:03:05,730
مرحباً

45
00:03:07,120 --> 00:03:07,980
مساء الخير

46
00:03:07,980 --> 00:03:09,150
مرحباً

47
00:03:09,150 --> 00:03:11,170
أأنتَ من البلد مُقدمة الطريق؟

48
00:03:11,170 --> 00:03:13,760
كلا، أنا في طريقي له

49
00:03:13,760 --> 00:03:17,240
هذا رائع، أنا متّجهٌ هناك أيضاً

50
00:03:17,240 --> 00:03:19,490
احمل نصف أمتعتي

51
00:03:19,490 --> 00:03:20,870
لا يمكنني ذلك

52
00:03:20,870 --> 00:03:21,490
أجل

53
00:03:21,490 --> 00:03:24,390
ماذا؟ يا لبرودتكما

54
00:03:24,390 --> 00:03:27,210
يمكنني الهرب بها

55
00:03:28,000 --> 00:03:31,250
قد أسبقك هناك وأبيعها كلّها

56
00:03:32,200 --> 00:03:33,500
أيّاً يكن

57
00:03:33,990 --> 00:03:35,250
بأيّ حال

58
00:03:35,250 --> 00:03:37,270
أتعرف عن ذاك البلد؟

59
00:03:37,270 --> 00:03:39,170
ليس كثيراً

60
00:03:39,170 --> 00:03:41,760
لكنّي سمعتُ أنّه بلدٌ بغاية التهذيب

61
00:03:44,500 --> 00:03:46,890
من أخبرك بذاك؟

62
00:03:46,890 --> 00:03:48,770
!أخطأتَ الفهم تماماً

63
00:03:49,930 --> 00:03:51,270
...في ذاك البلد

64
00:03:52,050 --> 00:03:55,150
يمكنك قتل الناس

65
00:03:55,150 --> 00:03:57,150
ماذا؟ ما قصدك؟

66
00:03:57,150 --> 00:04:00,550
لا يحظر قانونهم القتل

67
00:04:00,550 --> 00:04:02,910
رغم أنّ السرقة محظورةٌ لسببٍ ما

68
00:04:03,140 --> 00:04:05,900
لذا تتّجه هناك؟

69
00:04:05,900 --> 00:04:06,910
أجل، بالطبع

70
00:04:07,490 --> 00:04:09,000
سأعيش هناك

71
00:04:11,550 --> 00:04:13,310
في البلد الذي وُلِدت فيه

72
00:04:13,310 --> 00:04:15,450
كان النظام العام حسناً لحدٍّ جنوني

73
00:04:15,450 --> 00:04:17,520
وانسجم الجميع مع بعضهم كزُمرة حمقى

74
00:04:18,140 --> 00:04:21,680
يرمقونك بنظرة ازدراءٍ لضربك أحدهم فقط

75
00:04:21,910 --> 00:04:23,850
لذا غادرت

76
00:04:24,380 --> 00:04:26,430
ماذا ستفعل بعد انتقالك إذاً؟

77
00:04:27,750 --> 00:04:29,430
من يدري؟

78
00:04:29,430 --> 00:04:30,940
سأجرب العيش هناك حالياً

79
00:04:34,060 --> 00:04:37,250
وقد أقتل شخصاً لا يروقني

80
00:04:37,250 --> 00:04:39,690
إنّه بلدٌ يمكنني التصرّف فيه على سجيّتي

81
00:04:43,450 --> 00:04:46,700
كما، سمعتما حتماً، صحيح؟

82
00:04:47,210 --> 00:04:49,730
ريغيل ذائع الصيت يعيش هناك

83
00:04:49,730 --> 00:04:50,470
كلا

84
00:04:50,470 --> 00:04:51,210
لا أعرفه

85
00:04:51,590 --> 00:04:54,010
لا بدّ أنّكما من الأرياف

86
00:04:54,600 --> 00:04:58,740
ريغيل-سان ذاك قاتلٌ تسلسلي شهير

87
00:04:58,740 --> 00:05:03,720
قطع رؤوس خلية إرهابيّين ولصوص
في البلد جنوباً من هنا

88
00:05:04,560 --> 00:05:06,470
اعتقلوه مرّةً

89
00:05:06,470 --> 00:05:09,940
لكنّه بارعٌ فهرب من السجن قبل أن يشنقوه

90
00:05:09,940 --> 00:05:12,810
كان ذلك قبل بضعة عقود

91
00:05:12,810 --> 00:05:18,980
لكن حقيقة عدم قبضهم عليه تعني
أنّه هرب لذاك البلد حتماً

92
00:05:18,980 --> 00:05:22,060
لا بدّ أنّه كان يقضي أيامه حرّاً في قتل من يريد

93
00:05:22,060 --> 00:05:26,660
كم أودّ أن يعلّمني بضعة أشياء

94
00:05:26,660 --> 00:05:29,200
فهمت. سنمضي في طريقنا إذاً

95
00:05:30,660 --> 00:05:34,050
يا إلهي، يالكما من مملان

96
00:05:34,960 --> 00:05:35,500
!أنت

97
00:05:36,230 --> 00:05:38,520
لن تساعدني في حمل أيّ شيءٍ حقّاً؟

98
00:05:38,520 --> 00:05:42,820
أجل. تكفّل بأمتعة ترحالك بنفسك رجاءً

99
00:06:07,190 --> 00:06:08,450
تظنّ هذا هو؟

100
00:06:08,450 --> 00:06:10,740
أجل، غالباً

101
00:06:10,740 --> 00:06:13,000
قد يكون الوضع جنونياً في الداخل

102
00:06:13,350 --> 00:06:14,630
ربما

103
00:06:14,630 --> 00:06:16,000
أجهّزتَ كانون؟

104
00:06:16,000 --> 00:06:17,020
جاهز

105
00:06:17,500 --> 00:06:19,250
والخشّاب؟

106
00:06:19,250 --> 00:06:20,750
لا مشاكل

107
00:06:20,750 --> 00:06:22,010
جاهز ذهنياً؟

108
00:06:22,910 --> 00:06:24,440
حالياً، أجل

109
00:06:25,010 --> 00:06:27,180
حسنٌ، هيّا بنا

110
00:06:33,020 --> 00:06:35,520
إقامة لثلاثة أيام؟

111
00:06:36,520 --> 00:06:39,560
هل ستجلب تلك الموتوراد معك للمدينة؟

112
00:06:39,560 --> 00:06:41,610
أجل، رجاءً

113
00:06:42,200 --> 00:06:47,610
أتعرف أنّ القتل ليس محظوراً بالقانون في هذا البلد؟

114
00:06:47,610 --> 00:06:49,720
سواءً كنت مسافراً أو مواطناً

115
00:06:49,720 --> 00:06:55,380
الجميع هنا أحرار في قتل أيّ شخص
لأيّ سبب دون الإدانة الجنائية

116
00:06:55,380 --> 00:06:56,740
أتفهم ذلك؟

117
00:06:56,740 --> 00:06:57,530
أجل

118
00:07:00,040 --> 00:07:03,580
ولا تزال تريد الدخول صدقاً؟

119
00:07:06,020 --> 00:07:08,470
حسناً، ادخل

120
00:07:54,150 --> 00:07:56,180
يا له من بلدٍ غريب

121
00:07:57,000 --> 00:07:59,090
يبدو طبيعياً لي

122
00:07:59,090 --> 00:08:01,520
أجل، إنّه طبيعي

123
00:08:02,120 --> 00:08:04,650
الشوارع نظيفة، والناس يمشون بحريّة

124
00:08:05,000 --> 00:08:07,030
بالكاد توجد أيّ شرطة

125
00:08:07,320 --> 00:08:10,150
ولا متاجر بمصاريع كبيرة

126
00:08:10,530 --> 00:08:12,850
يعاملون المسافرين بودٍّ فوق ذلك

127
00:08:12,850 --> 00:08:14,160
وكان الطعام لذيذاً

128
00:08:14,700 --> 00:08:15,660
مما يعني؟

129
00:08:15,930 --> 00:08:18,430
النظام العام ممتاز

130
00:08:21,430 --> 00:08:22,670
لذا هو غريب

131
00:08:23,460 --> 00:08:24,740
فهمتك

132
00:08:24,740 --> 00:08:27,350
كنتَ تتطلّع لعصابات مجرمين متجوّلة

133
00:08:27,350 --> 00:08:30,090
أو أشخاص يقتلون نساء بعضهم في الحانات

134
00:08:30,090 --> 00:08:33,690
أو كلاب تتجوّل بأيدي بشرية في أفواهها

135
00:08:33,690 --> 00:08:36,300
أشياء كهذه، صحيح؟

136
00:08:36,300 --> 00:08:37,230
للأسف

137
00:08:37,230 --> 00:08:41,940
...كلا، لم أكن أتطلّع لذلك، لكن

138
00:08:56,770 --> 00:08:58,380
عمتَ مساءً يا كينو

139
00:09:34,480 --> 00:09:37,740
هيرمس، أتشعر برغبةٍ في الاستيقاظ بعد؟

140
00:09:40,260 --> 00:09:42,870
سنخرج حالما آكل الفطور

141
00:09:43,430 --> 00:09:46,670
لنقم بجولةٍ في هذا البلد

142
00:10:36,670 --> 00:10:37,970
هذه إضافةٌ لأجلك

143
00:10:38,660 --> 00:10:41,160
أحبّ إعطاء المسافرين خدمةً خاصة

144
00:10:41,160 --> 00:10:42,470
شكراً جزيلاً

145
00:10:42,950 --> 00:10:44,690
أتحتاج شيئاً آخراً؟

146
00:10:44,690 --> 00:10:45,900
هذا يكفي

147
00:10:52,840 --> 00:10:55,680
أهذا لردع اللصوص؟

148
00:10:55,680 --> 00:10:59,180
لم يسبق أن زارني لصّ

149
00:10:59,180 --> 00:10:59,740
...هذا

150
00:11:01,470 --> 00:11:03,740
لقتل الناس

151
00:11:05,500 --> 00:11:06,250
متى؟

152
00:11:06,630 --> 00:11:08,500
...حسناً

153
00:11:09,130 --> 00:11:13,260
لا تعرف متى حقّاً، لذا أحتفظ به دوماً هنا

154
00:11:25,360 --> 00:11:26,930
هذا طبق بلدنا الخاص

155
00:11:27,350 --> 00:11:28,460
خُذ وقتك

156
00:11:31,720 --> 00:11:32,550
كينو؟

157
00:11:33,060 --> 00:11:35,440
الحياة مليئةٌ بالتحديات

158
00:11:37,580 --> 00:11:38,450
كيف كان؟

159
00:11:39,870 --> 00:11:41,450
لذيذ

160
00:11:42,830 --> 00:11:45,450
أأنت مُسافر؟

161
00:11:45,450 --> 00:11:47,460
أنتَ كذلك بالفعل

162
00:11:48,300 --> 00:11:48,790
مرحباً

163
00:11:48,790 --> 00:11:52,960
أنهينا لتوّنا مجموعة رقصنا قبل القدوم هنا

164
00:11:52,960 --> 00:11:54,580
نؤدي ذلك مرّتين أسبوعياً

165
00:11:54,580 --> 00:11:58,950
في هذا السنّ، عليك تعويد بدنك على الحركة

166
00:11:58,950 --> 00:11:59,880
هكذا إذاً

167
00:11:59,880 --> 00:12:00,780
ما طلبكم؟

168
00:12:00,780 --> 00:12:02,470
سأطلب المعتاد

169
00:12:02,470 --> 00:12:05,470
أجل، المُعتاد بالطبع من فضلك

170
00:12:05,470 --> 00:12:08,480
الشاي هنا طيّبٌ دوماً

171
00:12:07,000 --> 00:12:08,480
أيّها المسافر

172
00:12:08,480 --> 00:12:11,640
ما رأيك بأكل تحلية هذا البلد الخاصة؟

173
00:12:11,640 --> 00:12:14,100
ستكون قصّةً ممتازة لرحلاتك حتماً

174
00:12:14,100 --> 00:12:17,230
وربما يمكنك مشاركتنا بعض قصص ما وراء السور بالمقابل

175
00:12:18,040 --> 00:12:19,330
آسف

176
00:12:19,330 --> 00:12:22,870
يا للأسف، بذل ما بوسعه لفتح مجالٍ بنفسه

177
00:12:23,110 --> 00:12:25,420
هكذا إذاً

178
00:12:25,420 --> 00:12:28,720
ما رأيك بالغد أثناء شاي الصباح إذاً؟

179
00:12:35,800 --> 00:12:36,750
كينو

180
00:12:37,480 --> 00:12:39,070
هل ستأكلها مجدداً اليوم؟

181
00:12:39,070 --> 00:12:40,980
سيكون ذلك يسيراً بنا الاثنان

182
00:12:46,150 --> 00:12:49,930
كم ستبقى في هذا البلد كينو-سان؟

183
00:12:49,930 --> 00:12:51,770
سأرحل اليوم بعد جلستنا

184
00:12:52,160 --> 00:12:53,610
هكذا إذاً

185
00:12:55,880 --> 00:12:59,740
يبدو أنّك سافرتَ عبر بلادٍ عديدة

186
00:12:59,740 --> 00:13:01,780
لكن لأي حدٍّ ستمضي؟

187
00:13:02,010 --> 00:13:03,720
لا أدري

188
00:13:03,720 --> 00:13:07,010
لعلّ الموتوراد خاصّتك يعرف إذاً؟

189
00:13:07,010 --> 00:13:08,490
مُحال

190
00:13:10,530 --> 00:13:15,960
حسناً، ما رأيك بالاستقرار في هذا البلد؟

191
00:13:15,960 --> 00:13:19,590
أظنّ شخصاً مثلك سيكون ملائماً لبلدنا

192
00:13:19,590 --> 00:13:20,510
أيّ شخص بالضبط؟

193
00:13:22,310 --> 00:13:25,490
شخص يمكنه قتل الآخرين

194
00:13:37,770 --> 00:13:40,910
فهمت، هذا مؤسفٌ قليلاً

195
00:13:43,530 --> 00:13:45,530
شكراً لك على اليوم

196
00:13:45,530 --> 00:13:48,290
أنا مسرورٌ لسماعي قصصك

197
00:13:48,290 --> 00:13:49,290
شكراً لك

198
00:13:49,540 --> 00:13:50,570
شكراً لك أيضاً

199
00:13:50,570 --> 00:13:52,160
استمتعتُ بالدعوة

200
00:13:55,010 --> 00:13:57,290
!وجدتُك

201
00:13:58,060 --> 00:13:59,040
!أنت

202
00:13:59,400 --> 00:14:01,300
!صاحب الموتوراد

203
00:14:03,530 --> 00:14:04,710
ماذا هناك؟

204
00:14:04,710 --> 00:14:07,520
اترك كلّ أغراضك هناك

205
00:14:07,520 --> 00:14:08,950
لما؟

206
00:14:08,950 --> 00:14:11,310
لا بدّ أنّ أمتعة سفرك ثقيلة، صحيح؟

207
00:14:11,550 --> 00:14:13,840
لذا سآخذ بعضها لتخفيف العبء عنك

208
00:14:13,840 --> 00:14:15,700
سأستعمل ما يمكنني منها

209
00:14:15,700 --> 00:14:17,470
وأبيع ما لا أحتاجه

210
00:14:17,470 --> 00:14:19,320
لأدفع نفقات حياتي هنا

211
