1
00:00:10,620 --> 00:00:12,030
...شوزا

2
00:00:55,320 --> 00:01:00,620
.وَصلنا أنّك قد أعدت تأسيس جيش قهر الملك الأسود

3
00:01:01,240 --> 00:01:03,530
.تلقّينا طلبًا للتعزيزات

4
00:01:03,530 --> 00:01:08,270
.لكنّنا لن نقاتل إلى جانب جيش القهر

5
00:01:09,670 --> 00:01:12,090
.لن تنتصر بوسائلك

6
00:01:12,090 --> 00:01:14,500
.نحن سنهزم الملك الأسود

7
00:01:17,500 --> 00:01:20,250
من أعطاكما الحقّ بالتحدّث بهذه الطريقة؟

8
00:01:20,250 --> 00:01:22,410
من تظنّان أنفسكما؟

9
00:01:22,410 --> 00:01:23,260
.تراجع

10
00:01:23,640 --> 00:01:29,060
.هذا الرجل هو شوزا، السيّد الأول لمناطق النّار التسع في أرض الغيلان

11
00:01:29,060 --> 00:01:31,510
.وأنا السيّد الثاني، يوشيتسوغو

12
00:01:31,510 --> 00:01:33,570
.أعجبتني روحك العاليّة أيها الطفل

13
00:01:33,570 --> 00:01:34,790
!أنا لست طفلًا

14
00:01:34,790 --> 00:01:36,030
!أنا أرام

15
00:01:36,030 --> 00:01:40,030
!سئمت من تفاهاتك أيّها الغبيّ

16
00:01:40,340 --> 00:01:42,990
!لا تقف صامتًا هناك فحسب! قل شيئًا يا يوري

17
00:01:44,990 --> 00:01:47,460
.سلّميني السّجلّ المتسلسل

18
00:01:47,460 --> 00:01:49,920
!لن نعطيه لأمثالك أبدًا

19
00:01:50,910 --> 00:01:51,910
.ابتعد عن طريقي

20
00:01:54,960 --> 00:01:56,210
.شوزا

21
00:01:56,210 --> 00:01:58,960
.هذا ليس وقت القتال فيما بيننا

22
00:01:59,360 --> 00:02:01,280
.لم تتغيّر البتّة أيها الفتى

23
00:02:02,070 --> 00:02:03,790
ألم أحذّرك؟

24
00:02:04,250 --> 00:02:06,880
.الرحمة ستعيقك فحسب خلال الحرب

25
00:02:07,380 --> 00:02:11,060
.لهذا السبب هُزِمتَ أمام الملك الأسود

26
00:02:20,010 --> 00:02:23,490
.استعمل أيّ وسيلة ممكنة عند مقاتلة الملك الأسود

27
00:02:24,080 --> 00:02:27,340
.استعدّ لاستعمال رفاقك كدروع إن اقتضى الأمر

28
00:02:28,670 --> 00:02:31,870
.الرّحمة ستعيقك فحسب

29
00:02:32,750 --> 00:02:34,710
.هذه هي طريقة قتالي

30
00:02:37,800 --> 00:02:38,850
!يوري

31
00:02:39,810 --> 00:02:41,280
!أغمِد سيفك

32
00:02:41,280 --> 00:02:43,420
.نفضّل تجنب أيّ سفكٍ غير ضروري للدماء

33
00:02:43,420 --> 00:02:44,560
.حسنًا إذًا

34
00:02:45,300 --> 00:02:49,300
.قوّة السجّل تتجسّد فقط لمن يختاره

35
00:02:49,710 --> 00:02:51,950
.سأجعله يختارني إذًا

36
00:02:51,950 --> 00:02:54,500
هل تظنّ أنّك قادر على ذلك؟

37
00:02:54,500 --> 00:02:57,570
.لهذا السبب بالضبط أنا واقف هنا

38
00:02:57,570 --> 00:02:59,090
!توقّف

39
00:03:10,630 --> 00:03:17,560
مهما حاولنا كبح اهتياج الناس، إلّا أنهم لا يتوّقفون

40
00:03:17,830 --> 00:03:21,440
إن كان القتال بالسيّف ضدّ الجيش الأسود شكلًا من أشكال المعارك

41
00:03:21,440 --> 00:03:24,960
.فكذلك محاربة مخاوفنا الخاصة

42
00:03:26,340 --> 00:03:29,970
.أنا أحارب مخاوفي الخاصّة دائمًا

43
00:03:30,520 --> 00:03:35,540
...واجباتي بصفتي أحد الكهنة السبعة عشر للضّريح العظيم

44
00:03:36,480 --> 00:03:39,980
وبصفتي متّخذة قرارات، مع اقتراب العالم إلى حافة الانهيار

45
00:03:40,680 --> 00:03:45,700
.عليّ أن أختار من أأتمنه على قيادة العالم إلى المستقبل

46
00:03:46,630 --> 00:03:51,430
—بصفتي كاهنة— لا، بل بصفتي بشرًا

47
00:03:51,430 --> 00:03:54,410
.فأنا قلقة بسبب الواجب الذي أواجهه

48
00:03:55,140 --> 00:04:00,230
.لكن هذا ليس الوقت لذلك بعد الآن

49
00:04:00,230 --> 00:04:04,030
.لقد قُرِّر ما عليّ فعله بالفعل

50
00:04:05,400 --> 00:04:07,180
.أنتِ محقّة يا ليليث

51
00:04:07,180 --> 00:04:09,010
ما على كلتينا فعله

52
00:04:09,800 --> 00:04:11,880
.قد تمّ تقريره مسبقًا

53
00:04:12,410 --> 00:04:15,010
.عليّ أن أطلع الناس على ما أفكّر به

54
00:04:15,010 --> 00:04:21,780
لا أعلم إن كان ذلك سيخفّف من مخاوفهم
.أم لا، لكن علي أن أنقل لهم أفكاري

55
00:04:27,990 --> 00:04:29,660
.اجمعوا النّاس رجاءً

56
00:04:30,010 --> 00:04:35,860
.إلى الآن، تشاركت أنا ولويزي وآينسلوت واجبات الملكة المقدّسة

57
00:04:36,590 --> 00:04:39,770
،لقد ساعدتماني عندما افتقرت للخبرة

58
00:04:39,770 --> 00:04:43,110
.لكنّي كنت أستغلّ ذلك للتهرّب من مسؤوليّاتي

59
00:04:43,110 --> 00:04:44,250
...يوريانا-ساما

60
00:04:44,640 --> 00:04:50,020
.فهمت الآن ما عليّ فعله بعد رؤيتي لوضع البلاد الحاليّ

61
00:04:53,810 --> 00:04:56,530
،من أجل إخماد مخاوف النّاس

62
00:04:56,530 --> 00:05:02,390
على الحاكم أن يريهم أوّلًا كيف يتقدمون
.نحو الأمام وكيف يعيشون حياتهم

63
00:05:02,990 --> 00:05:07,150
.سأقوم بواجبي بصفتي وريثة للعرش

64
00:05:08,870 --> 00:05:10,200
...يوريانا-ساما

65
00:05:10,200 --> 00:05:12,500
.أنا أحترم عزيمتك

66
00:05:18,540 --> 00:05:22,630
.سترث جلالة الملكة يوريانا العرش

67
00:05:25,040 --> 00:05:27,670
.وبالتّالي سنقيم حفلًا للتّتويج

68
00:05:32,370 --> 00:05:34,300
!أرام! اعتنِ بفينا

69
00:05:34,300 --> 00:05:35,110
.حسنًا

70
00:05:46,590 --> 00:05:48,650
.كما هو مُتَوقّع من السيّد الثاني للأراضي التسع

71
00:05:50,140 --> 00:05:51,740
!هذا مثير

72
00:05:59,780 --> 00:06:01,040
.شوزا

73
00:06:01,440 --> 00:06:04,410
ألا يمكننا أن نقاتل جنبًا إلى جنب مرّة أخرى؟

74
00:06:04,410 --> 00:06:05,420
.هذا يكفي

75
00:06:06,750 --> 00:06:11,130
.لقد خُيِّرتُ بين النور والظلام

76
00:06:11,720 --> 00:06:14,610
،إن اخترتَ اتّباع طريق النّور

77
00:06:14,610 --> 00:06:18,570
.فسأختار اتّباع طريق الظّلام

78
00:06:21,430 --> 00:06:23,550
.سآخذ كلّ شيء

79
00:06:23,550 --> 00:06:24,500
.الأراضي التّسع

80
00:06:24,500 --> 00:06:25,890
.يوغدو

81
00:06:25,890 --> 00:06:27,900
.وقوة السّواد

82
00:06:27,900 --> 00:06:32,900
!سأستولي على هذه القوّة، وسأصبح الملك الأسود الحقيقيّ

83
00:06:42,070 --> 00:06:44,200
!يوري

84
00:06:45,140 --> 00:06:47,230
!فلتختفوا أيها الضّعفاء

85
00:06:47,230 --> 00:06:48,170
!أيّها القائد

86
00:06:50,460 --> 00:06:52,340
!فلنسرع بتنفيذ هجوم متسلسل

87
00:07:07,480 --> 00:07:08,980
...أمسك

88
00:07:16,380 --> 00:07:17,240
!أيها القائد

89
00:07:17,240 --> 00:07:18,490
!يوري

90
00:07:18,490 --> 00:07:20,490
!لقد كسر هجومهم المتسلسل

91
00:07:27,080 --> 00:07:29,830
.أنت واثق من نفسك كثيرًا أيّها الطّفل

92
00:07:46,470 --> 00:07:47,650
!أرام

93
00:07:48,500 --> 00:07:50,520
.سلّميه لي الآن

94
00:07:50,520 --> 00:07:51,720
.لا

95
00:07:53,090 --> 00:07:54,480
!توقّف

96
00:08:01,200 --> 00:08:03,950
!شوزا

97
00:08:40,280 --> 00:08:41,920
من تكونين؟

98
00:08:42,550 --> 00:08:44,480
.اسمي أولزادا

99
00:08:44,480 --> 00:08:47,860
.كائن قديم قيل أنّه يجلب الكوارث

100
00:08:48,420 --> 00:08:50,200
أليست ظريفة؟

101
00:08:51,270 --> 00:08:54,710
.حان الوقت لكي تأتي إلى ديارك

102
00:08:55,960 --> 00:08:57,430
.شيطان

103
00:08:58,430 --> 00:09:01,380
.لا يبدو أنّك تختلف عنّا

104
00:09:01,380 --> 00:09:03,620
هل تريد مرافقتنا أيضًا؟

105
00:09:03,620 --> 00:09:05,970
.لا تضحكيني أيّتها الحثالة

106
00:09:07,350 --> 00:09:10,750
.أكره ذلك، لكن عليك أن تموت

107
00:09:13,160 --> 00:09:14,940
!احموا السيّد

108
00:09:16,320 --> 00:09:17,440
.يا للبشاعة

109
00:09:24,320 --> 00:09:26,200
.لا حاجة لي بالضّعفاء

110
00:09:26,590 --> 00:09:28,160
.جميل

111
00:09:28,830 --> 00:09:30,580
!سأقطعك

112
00:09:31,510 --> 00:09:33,580
!فلنحرقهم جميعًا

113
00:09:34,150 --> 00:09:35,960
.أيّتها الحشرات

114
00:09:44,070 --> 00:09:47,510
.هيّا، فلننضمّ للملك

115
00:09:47,510 --> 00:09:53,190
.حُسِم قدرك في اللّحظة التي ظهرت فيها أمام الملك الأسود

116
00:09:53,190 --> 00:09:54,910
.هذا هراء

117
00:09:55,590 --> 00:09:58,410
.أنت ملطّخ بالسّواد بالفعل

118
00:10:00,450 --> 00:10:03,030
.هيا، فلنذهب

119
00:10:05,400 --> 00:10:07,360
لمَ تتردّد؟

120
00:10:09,500 --> 00:10:10,550
.انظر

121
00:10:11,900 --> 00:10:14,790
.لقد فشلت في حماية أصدقائك

122
00:10:14,790 --> 00:10:15,880
!لا

123
00:10:15,880 --> 00:10:19,170
.وسمحت بأن يُسرَق السجلّ المتسلسل

124
00:10:20,300 --> 00:10:22,670
.مرّة أخرى

125
00:10:22,670 --> 00:10:24,300
...هـ-هذا

126
00:10:24,300 --> 00:10:25,430
.إنّها الحقيقة

127
00:10:33,440 --> 00:10:34,810
...سحقًا

128
00:10:34,810 --> 00:10:36,280
...أرام

129
00:10:36,280 --> 00:10:37,120
.فينا

130
00:10:37,120 --> 00:10:38,720
...السجلّ المتسلسل

131
00:10:39,480 --> 00:10:41,480
.سأستعيده

132
00:10:44,140 --> 00:10:46,120
!يوري-سان، لا

133
00:10:46,120 --> 00:10:47,490
!لا يمكنك الذّهاب

134
00:10:47,490 --> 00:10:48,540
!سأوقفه

135
00:10:50,400 --> 00:10:52,040
.لن أدعك تتدخّل

136
00:10:54,170 --> 00:10:56,230
لقد فهمت بالفعل، أليس كذلك؟

137
00:10:56,860 --> 00:10:58,740
.أنت ضعيف

138
00:10:59,280 --> 00:11:01,100
...أنا، أنا

139
00:11:01,100 --> 00:11:03,540
.هيّا، تقبّل الأمر

140
00:11:03,890 --> 00:11:07,380
...أنا... أنا

141
00:11:07,380 --> 00:11:08,830
...هيّا

142
00:11:19,570 --> 00:11:21,400
.كدت أنجح

143
00:11:21,400 --> 00:11:25,070
.أقسمت على هزيمة الملك الأسود هذه المرّة

144
00:11:25,070 --> 00:11:27,530
!لذا لن أتردّد

145
00:11:28,910 --> 00:11:32,190
!سوف أنتصر رفقة أصدقائي

146
00:11:32,190 --> 00:11:33,040
أصدقاؤك؟

147
00:11:38,310 --> 00:11:43,120
لمَ تظنّ إذًا أنّ بوركهارت أصبح شيطانًا؟

148
00:11:44,890 --> 00:11:46,050
!أرام

149
00:11:51,660 --> 00:11:54,850
.ألق نظرة على أصدقائك

150
00:11:56,260 --> 00:11:57,810
!لن أسلّم لكم يوري

151
00:11:57,810 --> 00:11:59,880
.إنّه قدره

152
00:11:59,880 --> 00:12:01,360
!لا أكترث

153
00:12:01,360 --> 00:12:03,620
.الجميع يملكون مكانهم المناسب

154
00:12:03,620 --> 00:12:06,990
.لقد رفضني الشّخص الذي أعطيت له كل شيء

155
00:12:08,860 --> 00:12:13,320
.كانت تلك اللحظة التي فهمت فيها الخطأ الذي ارتكبته

156
00:12:13,320 --> 00:12:15,320
!لا فكرة لي عمّا تتحدّث

157
00:12:17,330 --> 00:12:19,890
.أنت في حالة يرثى لها

158
00:12:19,890 --> 00:12:21,330
وكذلك هم، انظر

159
00:12:31,520 --> 00:12:32,510
.لا

160
00:12:36,510 --> 00:12:38,770
يوشيتسوغو، لماذا؟

161
00:12:40,720 --> 00:12:43,450
.كان بإمكانك إيقاف شوزا

162
00:12:43,450 --> 00:12:45,250
أنا؟ أوقفه؟

163
00:12:46,000 --> 00:12:48,380
.أنا أملك شرفًا بصفتي غولًا

164
00:12:48,380 --> 00:12:52,650
.أراهن بما بقي لي من حياة على شوزا

165
00:12:53,450 --> 00:12:56,290
.تمامًا كما تراهن أنت بحياتك على يوري

166
00:12:57,030 --> 00:13:00,790
.سأقاتل من أجل الشّخص الذي وثقت به

167
00:13:01,350 --> 00:13:02,500
.وكذلك أنا

168
00:13:14,110 --> 00:13:15,950
.يا للمساكين

169
00:13:15,950 --> 00:13:19,810
.سيموتون فقط لأنّهم قرّروا أن يثقوا بك

170
00:13:20,400 --> 00:13:22,690
.كلّ ذلك خطؤك

171
00:13:24,760 --> 00:13:25,720
...إنّه

172
00:13:25,720 --> 00:13:29,150
.هذا صحيح. لا يمكنك أن تحميَ أحدًا

173
00:13:29,150 --> 00:13:31,700
...أنا... أنا

174
00:13:36,210 --> 00:13:37,500
!يوري

175
00:13:37,850 --> 00:13:39,710
!لا تذهب

176
00:13:41,450 --> 00:13:45,450
.علمت أنّك لست بطلًا

177
00:13:46,650 --> 00:13:50,890
.علمت أنّك لم تمتلك القدرة على حماية أصدقائك

178
00:13:50,890 --> 00:13:54,090
.لكنّك لم تستطع الاعتراف بذلك لنفسك

179
00:13:54,090 --> 00:13:57,430
.لا، لم يسمح لك من حولك بذلك

180
00:13:57,430 --> 00:13:58,590
!هذا ليس صحيحًا

181
00:13:58,590 --> 00:14:01,730
.لا يوجد ولا حتّى شعاع أملٍ واحد لهذا العالم

182
00:14:02,310 --> 00:14:05,310
.سيغمره السّواد قريبًا

183
00:14:06,510 --> 00:14:09,970
.لكنّك ستحرّر عندما يحدث ذلك

184
00:14:09,970 --> 00:14:14,200
ما الطّائل من معاناتك أو جعل أصدقائك يعانون لوقت أطول؟

185
00:14:15,450 --> 00:14:16,410
...أنا

186
00:14:16,410 --> 00:14:22,330
.السّلام الذي تسعى إليه هو في الحقيقة عالم الظّلام

187
00:14:22,330 --> 00:14:29,250
.كن لطيفًا مع أصدقائك وأنهِ الأمور بيديك

188
00:14:31,210 --> 00:14:35,470
.هذا هو الطريق الوحيد المتبقي لك

189
00:14:36,120 --> 00:14:39,240
لطف؟ إنهاء... الأمور؟

190
00:14:40,470 --> 00:14:41,640
!يوري

191
00:14:45,260 --> 00:14:46,850
.تعالَ معي

192
00:14:48,400 --> 00:14:50,600
.إلى العالم الذي تنتمي إليه

193
00:14:51,170 --> 00:14:55,470
.لم يعد بإمكانك حماية أحد بعد الآن

194
00:14:56,390 --> 00:14:58,770
.اتبع قلبك

195
00:15:00,140 --> 00:15:02,760
...أنا... أنا

196
00:15:05,250 --> 00:15:06,450
!يوري

197
00:15:09,400 --> 00:15:12,290
!لن أدع السّواد يهزمني

198
00:15:16,300 --> 00:15:19,270
هل هذا هو جوابك؟

199
00:15:24,450 --> 00:15:26,900
...كاين... لماذا

200
00:15:29,140 --> 00:15:30,460
...أيّها القائد

201
00:15:42,460 --> 00:15:46,960
.لقد قطعت ذلك الرابط المتلاشي بيديك

202
00:15:51,090 --> 00:15:52,340
!كاين

203
00:15:53,500 --> 00:15:55,730
هل أنت بخير أيّها القائد؟

204
00:15:55,730 --> 00:15:56,800
...أنا

205
00:15:56,800 --> 00:15:58,830
.ما دمت بخير فهذا كلّ ما يهم

206
00:15:59,310 --> 00:16:02,230
.جيش قهر الملك الأسود بحاجة لك

207
00:16:03,950 --> 00:16:04,820
.كاين

208
00:16:05,880 --> 00:16:07,120
!كاين

209
00:16:20,150 --> 00:16:21,150
!أيّها القائد

210
00:16:21,690 --> 00:16:23,040
ماذا؟

211
00:16:30,690 --> 00:16:32,880
سنجمع الجنود من جميع أنحاء البلاد

212
00:16:32,880 --> 00:16:35,040
.وسنشكّل جيشًا لقهر الملك الأسود

213
00:16:35,290 --> 00:16:37,920
.يعلّق قائدنا آمالًا كبيرة عليك

214
00:16:39,250 --> 00:16:42,270
.اتبع الطريق الذي تعتقده صحيحًا

215
00:16:44,110 --> 00:16:45,550
أمل؟

216
00:16:45,550 --> 00:16:48,020
كيف يساعد ذلك؟

217
00:16:48,020 --> 00:16:52,140
.توسّلك الناس لتنقذ العالم

218
00:16:52,140 --> 00:16:57,930
.كلّفك العالم بمهمّة إنقاذه لأنّك بطل

219
00:17:04,200 --> 00:17:06,180
.لقد كنت بانتظارك

220
00:17:13,010 --> 00:17:19,050
.تواجه قارة يوغدو اختبارًا لم يسبق له مثيل

221
00:17:19,990 --> 00:17:25,660
.وهذه البلاد أيضًا قد أحيطت بالظلام ولا يبدو أنّ لذلك نهاية قريبة

222
00:17:26,660 --> 00:17:30,520
.لكن هذا لا يعني أنّ الأمل قد انعدم كلّيًا

223
00:17:30,520 --> 00:17:33,210
—لقد قرّرت اليوم أن

224
00:17:33,210 --> 00:17:34,600
من تظنّين نفسك؟

225
00:17:34,600 --> 00:17:35,350
.إنّها غلطتك

226
00:17:35,350 --> 00:17:37,260
!لقد خسرنا الحرب بسببك

227
00:17:37,260 --> 00:17:38,230
!أجل

228
00:17:43,080 --> 00:17:46,430
،عندما قتل الجيش الأسود أبي

229
00:17:46,430 --> 00:17:52,140
.وقعت في يأس عميق، وفقدت النّور

230
00:17:52,940 --> 00:18:00,180
.وبسبب هوسي، رميت نفسي في معركة غير مثمرة للانتقام لوالدي

231
00:18:01,250 --> 00:18:05,320
.ورّطت أصدقاء كانوا أعزّاء عليّ وسببت لهم المعاناة

232
00:18:07,900 --> 00:18:11,810
.تلك كانت اللّحظة التي أوقفني فيها أحد المحاربين

233
00:18:12,240 --> 00:18:13,910
.لقد وبّخني بصراحة

234
00:18:13,910 --> 00:18:16,850
.كان قلقًا عليّ، وواجهني

235
00:18:16,850 --> 00:18:21,070
.وبفضله تمكنّت من إيقاف نفسي

236
00:18:29,150 --> 00:18:33,220
لكن للأسف عندما عدت

237
00:18:33,220 --> 00:18:37,960
.وجدت شعبي يفتقر للنور، كما كنت أنا من قبل

238
00:18:38,590 --> 00:18:44,010
.أعلم عن خبرة أنّ الخراب هو ما ينتظرنا إن تابعنا سلك هذا الطريق

239
00:18:44,220 --> 00:18:48,140
.لهذا عليّ أن أكون قويّة

240
00:18:48,490 --> 00:18:52,020
.فأنتم كالعائلة بالنّسبة لي

241
00:18:53,810 --> 00:18:58,270
.لقد قرّرت الجلوس على العرش

242
00:18:59,320 --> 00:19:03,620
.لكي أعيد نور الأمل إلى قلوبنا

243
00:19:05,940 --> 00:19:10,210
.علينا الآن أن نتّحد معًا ونقاتل معًا

244
00:19:13,150 --> 00:19:21,210
هذه المملكة المقدّسة القديمة تجنّبت
.الكثير من المآسي بفضل روابطنا القويّة

245
00:19:21,210 --> 00:19:26,080
.وبهذه الرّوابط، لا يوجد شيء لا يمكننا الانتصار عليه

246
00:19:28,930 --> 00:19:32,030
.لن يهزمنا الظّلام أبدًا

247
00:19:33,120 --> 00:19:38,870
،من أجل المملكة المقدّسة النّبيلة ومن أجل سكّانها الفخورين

248
00:19:39,760 --> 00:19:42,750
!فليسطع نور الأمل بقوة

249
00:19:55,080 --> 00:19:57,640
،باسم الكهنة السبعة عشر

250
00:19:57,640 --> 00:20:00,990
.يوريانا، أتوّجك ملكةً للمملكة المقدّسة