1
00:00:29,200 --> 00:00:31,500
ما خطبك يا يوري؟

2
00:00:31,500 --> 00:00:32,740
لماذا؟

3
00:00:32,740 --> 00:00:34,810
كيف لك أن تتحوّل وتصبح هكذا؟

4
00:00:38,260 --> 00:00:40,060
.هذا مضحك

5
00:00:40,060 --> 00:00:43,850
...من كان يظنّ أنّك ستسقط في الظلام فقط بقطع صديقك

6
00:00:43,850 --> 00:00:46,090
.بطل؟ هذا هراء

7
00:00:46,090 --> 00:00:47,400
.أنت ضعيف

8
00:00:47,400 --> 00:00:49,070
.ضعيف جدًّا

9
00:00:49,070 --> 00:00:50,470
.فهمت الآن

10
00:00:50,470 --> 00:00:54,100
.لا عجب أنّك لم تكن ندًّا للملك الأسود

11
00:00:54,100 --> 00:00:59,430
.من جهة أخرى، يعطيني هذا سببًا إضافيًّا للقضاء عليك

12
00:01:12,790 --> 00:01:14,350
.أيتها الدمية الملعونة

13
00:01:16,430 --> 00:01:22,300
.يبدو أنّك جاهز للقتال، لكني لا أملك الوقت للهو معك الآن

14
00:01:23,750 --> 00:01:25,310
.تعال يا يوري

15
00:01:25,790 --> 00:01:28,700
.سيّدنا في الانتظار

16
00:01:34,220 --> 00:01:36,320
!لن تذهبوا إلى أيّ مكان

17
00:01:42,410 --> 00:01:45,200
.سأصفح عنك الآن

18
00:01:45,200 --> 00:01:48,180
.لكن المرّة المقبلة التي سنلتقي فيه ستكون الأخيرة لك

19
00:01:50,640 --> 00:01:52,590
!يوري-سان

20
00:01:56,360 --> 00:01:58,220
.لا فائدة من هذا

21
00:02:04,250 --> 00:02:06,840
...ها هي طريقة استعمال

22
00:02:08,740 --> 00:02:10,420
!قوة الظلام

23
00:02:17,690 --> 00:02:20,270
.هذا مذهل

24
00:02:21,040 --> 00:02:23,960
.للأسف انتهى وقتنا لهذا اليوم

25
00:02:23,960 --> 00:02:26,280
.سآخذ يوري معي

26
00:02:34,320 --> 00:02:35,610
...سحقًا

27
00:02:36,240 --> 00:02:37,870
!أيّها الغبي

28
00:02:40,370 --> 00:02:41,730
...يوري

29
00:02:43,670 --> 00:02:47,660
!يوري

30
00:02:54,430 --> 00:02:55,780
...إذًا

31
00:02:55,780 --> 00:02:56,640
.أجل

32
00:02:57,280 --> 00:03:01,240
مارينا تحاول إغلاق جرح كاين الآن

33
00:03:01,730 --> 00:03:05,780
.لكننا سنحتاج لمساعدة معالجين آخرين لمعالجته كلّيًا

34
00:03:10,250 --> 00:03:11,430
!أنت

35
00:03:11,430 --> 00:03:12,750
لمَ أنت هنا؟

36
00:03:16,870 --> 00:03:21,290
وأنتم أيضًا، لمَ لا تزالون مجتمعين هنا؟

37
00:03:22,550 --> 00:03:27,180
.لقد سقط الرّجل الذي يقودكم ضحيّة الظّلام

38
00:03:27,180 --> 00:03:29,790
.لقد انتهى أمر جيش القهر المزعوم

39
00:03:29,790 --> 00:03:31,560
.اذهبوا

40
00:03:31,560 --> 00:03:32,670
!ماذا قلت؟

41
00:03:32,670 --> 00:03:36,750
.لا سبب يدفعنا للاستماع لك يا سيد الأراضي التسعة

42
00:03:36,750 --> 00:03:38,480
بلى

43
00:03:38,850 --> 00:03:45,490
.يا أعضاء جيش الساحر، إن كنتم لا تزالون تملكون رغبة القتال فانضموا لي

44
00:03:46,100 --> 00:03:52,040
.أنا الوحيد القادر على استعمال قوتكم بأقصى حدّ لها

45
00:03:52,040 --> 00:03:53,550
أنت؟ تستعملنا؟

46
00:03:53,550 --> 00:03:55,430
.أنت حقًّا واثق من نفسك

47
00:03:55,430 --> 00:03:58,500
.لكن للأسف لا أظنّ أنّك ستكون قادرًا على تدبيرنا

48
00:04:01,490 --> 00:04:03,610
.افعلوا ما شئتم إذًا

49
00:04:03,610 --> 00:04:08,300
،لكن إن اعترضتم طريقي، فسواء كنتم من جيش الساحر

50
00:04:09,000 --> 00:04:14,470
.أو حكيمًا من برج الحكيم، لن أرحمكم

51
00:04:14,470 --> 00:04:16,070
.لا تنسوا ذلك

52
00:04:16,070 --> 00:04:19,130
.لم ينتهِ أمر جيش القهر بعد

53
00:04:19,130 --> 00:04:22,020
.لا تقررّ ذلك بدلًا عنّا أيهّا الغول اللّعين

54
00:04:22,020 --> 00:04:24,090
.أعد لنا السجلّ المتسلسل

55
00:04:24,090 --> 00:04:25,740
.فهو لا يخصّك

56
00:04:25,740 --> 00:04:27,330
!أيّها الحقير

57
00:04:27,990 --> 00:04:30,150
هل عدوت طروك أيها الطفل؟

58
00:04:30,150 --> 00:04:33,580
أم أنّ خيانته لكم جعلتك يائسًا؟

59
00:04:33,580 --> 00:04:35,670
.يوري لم يخنّا أبدًا

60
00:04:35,670 --> 00:04:37,160
.أصغِ إلى نفسك

61
00:04:37,160 --> 00:04:38,640
.لقد هُزِم

62
00:04:38,640 --> 00:04:41,410
.لقد تخلّى عنكم وانضمّ إلى الملك الأسود

63
00:04:41,870 --> 00:04:44,970
أوليست هذه خيانة؟

64
00:04:45,210 --> 00:04:46,850
.بل ليست بشيء

65
00:04:46,850 --> 00:04:49,380
.يوري تائه الآن فحسب

66
00:04:49,830 --> 00:04:52,410
.وهو ينتظرنا لنساعده

67
00:04:53,170 --> 00:04:56,890
.لطالما وثق بأصدقائه

68
00:04:57,310 --> 00:04:59,690
.وفي روابطه مع أصدقائه

69
00:04:59,690 --> 00:05:02,770
.وأنّ أصدقاءه سيأتون دائمًا للمساعدة إن أحسسنا أنّنا تائهون

70
00:05:03,080 --> 00:05:04,900
.ما زالت تلك الرّوابط هنا

71
00:05:05,340 --> 00:05:08,940
.حان الوقت لنحمله نحن الآن

72
00:05:11,100 --> 00:05:13,380
هل ستعيدونه؟

73
00:05:13,380 --> 00:05:14,320
.أجل

74
00:05:17,070 --> 00:05:19,790
.هذا هراء أيّها الطفل

75
00:05:26,710 --> 00:05:27,850
.مثير

76
00:05:27,850 --> 00:05:30,010
.حاول ذلك إذًا أيّها الطّفل

77
00:05:30,010 --> 00:05:32,630
.لكن من الأفضل لك أن تسرع

78
00:05:32,630 --> 00:05:35,230
.قبل أن أقتله أوّلًا

79
00:05:35,840 --> 00:05:37,520
.لن أسمح لك بذلك

80
00:05:38,780 --> 00:05:41,400
.أصبح السجلّ المتسلسل ملكًا لي

81
00:05:41,400 --> 00:05:44,690
.إن أردت استعادته فسيتوجّب عليك أخذه بالقوّة

82
00:05:52,100 --> 00:05:54,980
.كنت في انتظارك يا يوري

83
00:05:54,980 --> 00:05:57,110
أم هل عليّ أن أناديك بالفارس الأسود؟

84
00:05:57,810 --> 00:06:00,680
.لقد رحّبت بك الظلمات

85
00:06:01,340 --> 00:06:08,000
كيف تشعر وأنت تتّبع ما يوجد في أعماق قلبك؟

86
00:06:08,000 --> 00:06:12,600
.أتيتُ إلى هنا ذات مرّة لأنقذ العالم

87
00:06:12,600 --> 00:06:16,550
.لكن ذلك فقط لأنّ القدر أرغمني على ذلك

88
00:06:16,550 --> 00:06:21,550
.قاتلت يائسًا دون أن أجد سببًا لإنقاذ هذا العالم

89
00:06:21,550 --> 00:06:25,470
.لكنّني سأتحدّى العالم هذه المرّة

90
00:06:25,470 --> 00:06:29,390
—وإن سقط أمامي—أمام الظلام

91
00:06:29,390 --> 00:06:31,860
.فسيعني ذلك أنّه لم يستحق الإنقاذ أبدًا

92
00:06:31,860 --> 00:06:34,340
.وأنّ عليه أن ينهار

93
00:06:36,160 --> 00:06:41,730
.سنعود إلى برج الحكيم لإعلامهم بالأمر

94
00:06:41,730 --> 00:06:43,780
.شكرًا لك

95
00:06:44,180 --> 00:06:47,300
.أنا مذهول لأنّك رددت على شوزا بتلك الطريقة

96
00:06:47,300 --> 00:06:49,750
.سوف تموت شابًّا

97
00:06:49,750 --> 00:06:50,880
لماذا؟

98
00:06:50,880 --> 00:06:52,300
.قمت بما هو بديهيّ فحسب

99
00:06:53,260 --> 00:06:55,100
!قال بديهيّ قال

100
00:06:55,100 --> 00:06:56,780
!يعجبني هذا الفتى

101
00:06:58,600 --> 00:07:01,760
.هذا وضع خطير بالنّسبة لنا

102
00:07:02,310 --> 00:07:05,410
.لكنّي مسرور لأنّك معنا يا أرام

103
00:07:06,190 --> 00:07:09,230
...لربّما كان يوري

104
00:07:11,560 --> 00:07:12,480
.لا شيء

105
00:07:12,480 --> 00:07:13,700
.لا تشغل بالك

106
00:07:13,700 --> 00:07:17,970
.اعتني بكاين-سان رجاءً يا مارينا-سان

107
00:07:18,970 --> 00:07:19,900
.نعم

108
00:07:20,310 --> 00:07:24,600
هناك الكثير من المعالجين الموهوبين
.في نقابة المعالج في العاصمة الثانوية

109
00:07:24,600 --> 00:07:27,540
.أنا واثقة أنّ مارينا ستتمكّن من إبقائه حيًّا إلى أن تصلوا إلى هناك

110
00:07:28,700 --> 00:07:31,120
.لن أدع كاين يموت

111
00:07:32,420 --> 00:07:35,260
إلى أينّ ستذهب أنت وفينا الآن؟

112
00:07:35,260 --> 00:07:36,960
...بشأن ذلك

113
00:07:36,960 --> 00:07:40,540
هل ستذهبين إلى جزيرة الأرواح كما خطّطنا؟

114
00:07:40,540 --> 00:07:41,190
.أجل

115
00:07:41,610 --> 00:07:43,600
.أظنّ أنّ ذلك هو أفضل خيار لنا

116
00:07:45,260 --> 00:07:48,220
.لا أظنّني سأساعد إن قلت لك أن تبتهجي

117
00:07:48,220 --> 00:07:50,480
.لكن على الأقل حاولي ألّا تلومي نفسك كثيرًا

118
00:07:50,480 --> 00:07:51,790
.سأكون بخير

119
00:07:51,790 --> 00:07:53,730
.سنتدبّر الأمر بطريقة ما

120
00:07:53,730 --> 00:07:58,620
.فكما قال أرام-سان، حان الآن دورنا لنبذل ما بوسعنا

121
00:07:59,230 --> 00:08:01,390
.معك حقّ

122
00:08:10,580 --> 00:08:11,880
.هيّا بنا

123
00:08:16,200 --> 00:08:17,340
.حسنًا

124
00:08:17,340 --> 00:08:19,130
.فلنذهب نحن أيضًا يا فينا

125
00:08:20,470 --> 00:08:21,320
فينا؟

126
00:08:22,010 --> 00:08:23,510
.أجل

127
00:09:26,160 --> 00:09:28,450
ما الخطب؟ هل أنت جائع؟

128
00:09:31,070 --> 00:09:32,690
ما الخطب؟

129
00:09:34,050 --> 00:09:36,400
هل أنت قلق؟

130
00:09:36,400 --> 00:09:37,950
.أنا بخير

131
00:09:37,950 --> 00:09:39,790
.لست مكتئبًا أو ما شابه

132
00:09:39,790 --> 00:09:45,220
.لكن يمكنني أن أرى أنّ فينا تجهد نفسها

133
00:09:45,940 --> 00:09:47,520
الأمر غريب، أليس كذلك؟

134
00:09:47,520 --> 00:09:54,000
.لم أفكّر في الغير من قبل إلى أن التقيت بيوري

135
00:09:54,770 --> 00:09:59,120
.لم أكترث حتّى لو مات مَن مِن حولي

136
00:09:59,810 --> 00:10:02,820
.أعتقد أنّ الجميع بمفردهم في النّهاية

137
00:10:03,230 --> 00:10:05,170
...لكن الآن

138
00:10:07,570 --> 00:10:08,770
.أرام-سام

139
00:10:09,410 --> 00:10:10,720
.شكرًا لك

140
00:10:11,430 --> 00:10:13,170
.أشعر بالانتعاش

141
00:10:13,170 --> 00:10:15,210
.هـ-هذا... هذا جيّد

142
00:10:15,510 --> 00:10:17,500
لمَ لا تستحمّ أنت أيضًا؟

143
00:10:17,500 --> 00:10:18,900
.أ-أجل

144
00:10:18,900 --> 00:10:20,080
.بالمناسبة

145
00:10:20,080 --> 00:10:21,210
.العشاء جاهز

146
00:10:21,210 --> 00:10:23,590
.شكرًا لك

147
00:10:25,890 --> 00:10:27,100
.إنّه لذيذ

148
00:10:27,100 --> 00:10:28,890
.حقًّا؟ يسعدني سماع ذلك

149
00:10:28,890 --> 00:10:31,340
.قد تكون طبّاخًا أفضل منّي

150
00:10:31,340 --> 00:10:32,790
.مستحيل

151
00:10:32,790 --> 00:10:34,320
.طبخك لذيذ أيضًا

152
00:10:35,520 --> 00:10:37,070
.أعلم أنّ ذلك ليس صحيحًا

153
00:10:37,490 --> 00:10:42,970
.أنت ويوري-سان هما الوحيدان اللذان قالا أنّ طبخي لذيذ

154
00:10:45,440 --> 00:10:49,440
فينا، هلّا أخبرتني عن يوري؟

155
00:10:49,860 --> 00:10:53,070
.فقد كنت تسافرين معه لمدّة أطول منّي

156
00:10:53,070 --> 00:10:55,420
.أريد أن أعرف المزيد عنه

157
00:10:55,420 --> 00:10:58,510
بالمناسبة، أخبرتك عن الرّجل الغريب الذي التقيناه

158
00:10:58,510 --> 00:11:00,720
عندما كنّا عالقين في الجبال، صحيح؟

159
00:11:00,720 --> 00:11:03,500
أكان اسمه بالتازاري؟

160
00:11:03,500 --> 00:11:08,090
.قال أنّ يوري هزم تنّينًا ذات مرّة

161
00:11:08,890 --> 00:11:10,740
هل هذا صحيح؟

162
00:11:11,400 --> 00:11:12,230
.أجل

163
00:11:12,740 --> 00:11:15,010
.لكنّي أفضّل ألّا أتحدّث عن ذلك

164
00:11:15,010 --> 00:11:16,460
لمَ لا؟

165
00:11:16,460 --> 00:11:18,770
!فهزيمة تنّين ما تبدو أمرًا مذهلًا

166
00:11:18,770 --> 00:11:21,320
!أنا واثق أنّها كانت مغامرة رائعة

167
00:11:21,320 --> 00:11:22,650
!كلّا، لم تكن كذلك

168
00:11:24,470 --> 00:11:26,630
.لم تكن كذلك أبدًا

169
00:11:26,630 --> 00:11:32,780
.فقد كان التنّين الذي هزمه مُسوَدًّا

170
00:11:35,910 --> 00:11:40,460
.كان ذلك التنّين يُعرَف بحارس الصّحراء

171
00:11:40,460 --> 00:11:43,750
.لكنّه تعرّض للسّواد في مرحلةٍ ما

172
00:11:43,750 --> 00:11:45,420
.وأصبح ملطّخًا بالسّواد

173
00:12:31,310 --> 00:12:34,560
من كان ليتوقّع أنّي أنا حارس الصحراء

174
00:12:34,560 --> 00:12:37,770
.سأسبّب الفوضى فيها

175
00:12:38,280 --> 00:12:39,890
هل استعدت صوابك؟

176
00:12:40,360 --> 00:12:42,440
.في الوقت الحالّي

177
00:12:42,810 --> 00:12:45,690
.اقضِ عليّ أيّها البطل

178
00:12:46,200 --> 00:12:47,570
!مهلًا

179
00:12:47,570 --> 00:12:49,720
.لا حاجة لأن نقتلك

180
00:12:49,720 --> 00:12:51,150
.هذا هو الصّواب

181
00:12:51,150 --> 00:12:56,420
.التسبّب بالمعاناة لسكّان الصّحراء يتعارض مع طبيعتي الحقيقيّة

182
00:12:56,420 --> 00:13:00,370
.لذا فالهلاك هو مصيري

183
00:13:02,030 --> 00:13:03,900
.قم بذلك الآن

184
00:13:04,500 --> 00:13:07,560
.بينما لا أزال على طبيعتي

185
00:13:07,560 --> 00:13:08,880
...فارا

186
00:13:11,360 --> 00:13:12,380
.اقتله

187
00:13:16,740 --> 00:13:19,890
.شكرًا لك على حماية مدينة الصّحراء

188
00:13:21,240 --> 00:13:22,530
.ارقد بسلام

189
00:13:28,850 --> 00:13:33,920
.لم يكن هناك شيء يمكننا فعله لإنقاذ التنّين من الظلام

190
00:13:34,870 --> 00:13:39,690
.كلّ ما استطعنا فعله هو تخليصه من عذابه

191
00:13:41,710 --> 00:13:42,790
لماذا؟

192
00:13:43,570 --> 00:13:45,900
لمَ لم نستطع إيقافه؟

193
00:13:46,510 --> 00:13:50,590
.علمت أنّ يوري-سان كان يعاني

194
00:13:51,510 --> 00:13:52,430
...فينا

195
00:13:52,970 --> 00:13:55,370
.كنت أقرب شخصٍ منه

196
00:13:56,230 --> 00:13:57,380
فلماذا إذًا؟

197
00:13:57,760 --> 00:13:59,950
.كان شخصًا طيّبًا

198
00:13:59,950 --> 00:14:01,980
.كان طيّبًا أكثر من اللّازم

199
00:14:02,740 --> 00:14:06,930
.ومع ذلك أرغمناه على القتال

200
00:14:09,910 --> 00:14:12,410
هل ذلك هو الخطأ الذي اقترفناه؟

201
00:14:12,410 --> 00:14:14,480
إرغامه على تكبّد عبء كل ذلك على عاتقه؟

202
00:14:14,940 --> 00:14:16,110
—ألهذا السبب قام بـ

203
00:14:16,110 --> 00:14:17,120
!لا

204
00:14:17,120 --> 00:14:19,400
!محال أن يكون ذلك صحيحًا

205
00:14:19,400 --> 00:14:22,800
.إنّه خطأ الملك الأسود لأنّه يهاجم النّاس لحظة ضعفهم

206
00:14:22,800 --> 00:14:23,660
أليس كذلك؟

207
00:14:25,970 --> 00:14:30,780
...خطيئتي أسوأ بكثير إذًا

208
00:14:36,500 --> 00:14:40,840
لم تأخذ الظلمة الجميع؟

209
00:14:41,620 --> 00:14:45,150
أهذا هو مصيرنا المحتوم؟

210
00:14:46,050 --> 00:14:50,650
في تلك الحالة، هل يستحقّ هذا العالم أن يغطّى بالسّواد؟

211
00:14:50,650 --> 00:14:52,020
!بالطّبع لا

212
00:14:52,020 --> 00:14:52,610
...لكن

213
00:14:55,780 --> 00:14:56,830
...فينا

214
00:14:58,760 --> 00:15:04,700
.قبل أن ألتقي يوري، اعتقدت أنّه قويّ جدًّا

215
00:15:05,420 --> 00:15:07,640
.لم يكن لديه أيّ مناصرين يدعمونه

216
00:15:07,640 --> 00:15:10,470
،لكن بالرّغم من ذلك، أصبح قائد جيش المتطوّعين

217
00:15:10,810 --> 00:15:15,240
.لكن بعد لقائه، أدركت أنّه لم يكن كذلك أبدًا

218
00:15:15,690 --> 00:15:19,900
.كانت تلك اللّحظة التي أدركت فيها أنّه لا يوجد أحدٌ قويّ كلّيًّا

219
00:15:19,900 --> 00:15:21,930
.الجميع لديهم نقاط ضعف

220
00:15:21,930 --> 00:15:23,400
...لكن

221
00:15:24,480 --> 00:15:27,850
!لكن لهذا السبب نعقد الصّداقات

222
00:15:30,250 --> 00:15:31,930
.نحن أصدقاء

223
00:15:32,340 --> 00:15:34,240
.وسوف نستعيد يوري

224
00:15:34,240 --> 00:15:35,870
.يمكننا ذلك

225
00:15:35,870 --> 00:15:38,370
.فنحن نملك روابط قويّة

226
00:15:38,370 --> 00:15:40,400
أليس كذلك يا فينا؟

227
00:15:54,420 --> 00:15:55,620
.لا بأس

228
00:15:56,020 --> 00:16:00,640
.سيكون كلّ شيء على ما يرام يا فينا

229
00:16:12,610 --> 00:16:14,650
روابط؟

230
00:16:15,280 --> 00:16:18,520
.أدركت فقط بعد أن رحلت

231
00:16:19,250 --> 00:16:24,670
.ثقلها وألمها

232
00:16:45,850 --> 00:16:47,920
.يبدو أنّ بإمكاننا تنفّس الصعداء الآن

233
00:16:47,920 --> 00:16:48,560
.أجل

234
00:16:49,790 --> 00:16:53,780
.يمكن لمارينا أن تنام أخيرًا أيضًا

235
00:16:57,090 --> 00:17:00,530
هذا ينطبق عليك أنتِ أيضًا يا ميتشيديا، أليس كذلك؟

236
00:17:00,530 --> 00:17:02,370
.أنا بخير

237
00:17:02,690 --> 00:17:06,450
.أريد أن أكون إلى جانب كاين عندما يستيقظ

238
00:17:09,220 --> 00:17:10,670
.يوريانا-ساما

239
00:17:11,450 --> 00:17:12,780
.لقد سمعت بالخبر

240
00:17:12,780 --> 00:17:14,260
هل هو صحيح؟

241
00:17:14,570 --> 00:17:17,410
هل سقط يوري-دونو في الظلمات؟

242
00:17:17,410 --> 00:17:19,430
.أجل، يبدو ذلك

243
00:17:19,430 --> 00:17:20,980
...لا

244
00:17:20,980 --> 00:17:24,170
بوركهارت أوّلًا والآن يوري-دونو؟

245
00:17:24,520 --> 00:17:28,640
.انقلاب شوزا علينا وحده أمر سيّئ بما يكفي

246
00:17:28,960 --> 00:17:30,180
والآن هذا؟

247
00:17:30,740 --> 00:17:33,490
لمَ نواجه العديد من المحن؟

248
00:17:36,820 --> 00:17:40,660
.لا فائدة من الحزن على ما حدث بالفعل

249
00:17:41,490 --> 00:17:44,820
.أنا أنوي لقاء شوزا في الحال

250
00:17:45,510 --> 00:17:49,090
.وضعنا معه يتطلّب تشديدًا فائقًا

251
00:17:49,540 --> 00:17:57,630
اسمع، هذه الأوقات المضطربة تستدعي
.المبادرة لإيجاد طريق المستقبل

252
00:17:57,630 --> 00:18:01,730
.هذا هو واجب من ترتدي تاج الملكة المقدّسة

253
00:18:02,400 --> 00:18:03,590
أليس هذا صحيحًا؟

254
00:18:03,920 --> 00:18:07,600
.لا، كلامك صحيح تمامًا يا يوريانا-ساما

255
00:18:07,600 --> 00:18:10,330
.أقصد يا جلالة الملكة

256
00:18:10,690 --> 00:18:11,810
.هذا صحيح

257
00:18:11,810 --> 00:18:14,040
.عليّ أن أتصرّف

258
00:18:14,040 --> 00:18:17,440
.حماية النّاس مسؤوليّتي

259
00:18:17,990 --> 00:18:23,570
،إن وقف شوزا أو يوري في حالته المسودّة في طريقي

260
00:18:25,090 --> 00:18:26,810
.فسأقضي عليهما بيديّ هاتين

261
00:18:26,810 --> 00:18:29,330
.لأنّني الملكة المقدّسة

262
00:18:32,800 --> 00:18:35,960
أتيت بحامية من ألفي رجل كانوا متمركزين

263
00:18:35,960 --> 00:18:37,300
في الأراضي التسعة

264
00:18:37,800 --> 00:18:41,100
.نخطّط للقاء المزيد

265
00:18:41,100 --> 00:18:43,360
.أحسنت عملًا يا شيدوهو

266
00:18:45,700 --> 00:18:50,110
.لدينا الآن أكثر من 5000 رجل

267
00:18:50,960 --> 00:18:52,470
.نحتاج المزيد

268
00:18:52,900 --> 00:18:57,600
،لكي نهزم الملك الأسود ونصبح أسياد هذه القارة

269
00:18:58,320 --> 00:18:59,990
.سنحتاج للمزيد من الرّجال

270
00:19:00,430 --> 00:19:02,190
.المزيد من الرّجال الأقوياء

271
00:19:06,810 --> 00:19:09,740
.عجبًا، عجبًا، عجبًا، هذا مثير للاهتمام

272
00:19:10,220 --> 00:19:14,460
.من الواضح أنّ هذه ليست مجرّد أداة قديمة

273
00:19:15,040 --> 00:19:17,710
ما هذا النّص المنقوش على هذا السيّف؟

274
00:19:17,710 --> 00:19:18,890
.إنّها أغنية

275
00:19:18,890 --> 00:19:22,270
.يمكننا صنع شيء مثير للاهتمام بالفعل بهذا

276
00:19:22,870 --> 00:19:24,130
صنع؟

277
00:19:24,130 --> 00:19:26,220
...كلّ ما نحتاجه الآن

278
00:19:27,490 --> 00:19:29,510
.لقد عدنا

279
00:19:30,720 --> 00:19:34,470
.عجبًا، لقد عدتم بسرعة

280
00:19:34,470 --> 00:19:36,270
...كيف حال جيش القهر

281
00:19:42,320 --> 00:19:45,270
...لا... يوري

282
00:19:47,490 --> 00:19:52,200
.لربّما كان هذا اختبارًا ضروريًّا لخلق نور جديد

283
00:19:52,200 --> 00:19:54,050
نور جديد؟

284
00:19:54,050 --> 00:19:55,080
ما معنى ذلك؟

285
00:19:55,590 --> 00:19:58,400
.ما زال احتمالًا ضئيلًا

286
00:19:58,400 --> 00:20:03,420
.لكن هناك شيء يجب فعله لجعله مؤكّدًا قدر المستطاع

287
00:20:04,420 --> 00:20:07,920
.لديّ معروف أطلبه منكم

288
00:20:15,810 --> 00:20:18,310
.هذه هي جزيرة الأرواح إذًا

289
00:20:18,770 --> 00:20:19,720
.أجل

290
00:20:19,720 --> 00:20:22,110
...هناك بالتّأكيد