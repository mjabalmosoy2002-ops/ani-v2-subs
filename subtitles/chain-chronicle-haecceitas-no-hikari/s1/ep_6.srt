1
00:00:00,620 --> 00:00:02,030
...شوزا

2
00:02:25,300 --> 00:02:30,600
.وَصلنا أنّك قد أعدت تأسيس جيش قهر الملك الأسود

3
00:02:31,220 --> 00:02:33,510
.تلقّينا طلبًا للتعزيزات

4
00:02:33,510 --> 00:02:38,250
.لكنّنا لن نقاتل إلى جانب جيش القهر

5
00:02:39,650 --> 00:02:42,070
.لن تنتصر بوسائلك

6
00:02:42,070 --> 00:02:44,480
.نحن سنهزم الملك الأسود

7
00:02:47,480 --> 00:02:50,230
من أعطاكما الحقّ بالتحدّث بهذه الطريقة؟

8
00:02:50,230 --> 00:02:52,390
من تظنّان أنفسكما؟

9
00:02:52,390 --> 00:02:53,240
.تراجع

10
00:02:53,620 --> 00:02:59,040
.هذا الرجل هو شوزا، السيّد الأول لمناطق النّار التسع في أرض الغيلان

11
00:02:59,040 --> 00:03:01,490
.وأنا السيّد الثاني، يوشيتسوغو

12
00:03:01,490 --> 00:03:03,550
.أعجبتني روحك العاليّة أيها الطفل

13
00:03:03,550 --> 00:03:04,770
!أنا لست طفلًا

14
00:03:04,770 --> 00:03:06,010
!أنا أرام

15
00:03:06,010 --> 00:03:10,010
!سئمت من تفاهاتك أيّها الغبيّ

16
00:03:10,320 --> 00:03:12,970
!لا تقف صامتًا هناك فحسب! قل شيئًا يا يوري

17
00:03:14,970 --> 00:03:17,440
.سلّميني السّجلّ المتسلسل

18
00:03:17,440 --> 00:03:19,900
!لن نعطيه لأمثالك أبدًا

19
00:03:20,890 --> 00:03:21,890
.ابتعد عن طريقي

20
00:03:24,940 --> 00:03:26,190
.شوزا

21
00:03:26,190 --> 00:03:28,940
.هذا ليس وقت القتال فيما بيننا

22
00:03:29,340 --> 00:03:31,260
.لم تتغيّر البتّة أيها الفتى

23
00:03:32,050 --> 00:03:33,770
ألم أحذّرك؟

24
00:03:34,230 --> 00:03:36,860
.الرحمة ستعيقك فحسب خلال الحرب

25
00:03:37,360 --> 00:03:41,040
.لهذا السبب هُزِمتَ أمام الملك الأسود

26
00:03:49,990 --> 00:03:53,470
.استعمل أيّ وسيلة ممكنة عند مقاتلة الملك الأسود

27
00:03:54,060 --> 00:03:57,320
.استعدّ لاستعمال رفاقك كدروع إن اقتضى الأمر

28
00:03:58,650 --> 00:04:01,850
.الرّحمة ستعيقك فحسب

29
00:04:02,730 --> 00:04:04,690
.هذه هي طريقة قتالي

30
00:04:07,780 --> 00:04:08,830
!يوري

31
00:04:09,790 --> 00:04:11,260
!أغمِد سيفك

32
00:04:11,260 --> 00:04:13,400
.نفضّل تجنب أيّ سفكٍ غير ضروري للدماء

33
00:04:13,400 --> 00:04:14,540
.حسنًا إذًا

34
00:04:15,280 --> 00:04:19,280
.قوّة السجّل تتجسّد فقط لمن يختاره

35
00:04:19,690 --> 00:04:21,930
.سأجعله يختارني إذًا

36
00:04:21,930 --> 00:04:24,480
هل تظنّ أنّك قادر على ذلك؟

37
00:04:24,480 --> 00:04:27,550
.لهذا السبب بالضبط أنا واقف هنا

38
00:04:27,550 --> 00:04:29,070
!توقّف

39
00:04:40,610 --> 00:04:47,540
مهما حاولنا كبح اهتياج الناس، إلّا أنهم لا يتوّقفون

40
00:04:47,810 --> 00:04:51,420
إن كان القتال بالسيّف ضدّ الجيش الأسود شكلًا من أشكال المعارك

41
00:04:51,420 --> 00:04:54,940
.فكذلك محاربة مخاوفنا الخاصة

42
00:04:56,320 --> 00:04:59,950
.أنا أحارب مخاوفي الخاصّة دائمًا

43
00:05:00,500 --> 00:05:05,520
...واجباتي بصفتي أحد الكهنة السبعة عشر للضّريح العظيم

44
00:05:06,460 --> 00:05:09,960
وبصفتي متّخذة قرارات، مع اقتراب العالم إلى حافة الانهيار

45
00:05:10,660 --> 00:05:15,680
.عليّ أن أختار من أأتمنه على قيادة العالم إلى المستقبل

46
00:05:16,610 --> 00:05:21,410
—بصفتي كاهنة— لا، بل بصفتي بشرًا

47
00:05:21,410 --> 00:05:24,390
.فأنا قلقة بسبب الواجب الذي أواجهه

48
00:05:25,120 --> 00:05:30,210
.لكن هذا ليس الوقت لذلك بعد الآن

49
00:05:30,210 --> 00:05:34,010
.لقد قُرِّر ما عليّ فعله بالفعل

50
00:05:35,380 --> 00:05:37,160
.أنتِ محقّة يا ليليث

51
00:05:37,160 --> 00:05:38,990
ما على كلتينا فعله

52
00:05:39,780 --> 00:05:41,860
.قد تمّ تقريره مسبقًا

53
00:05:42,390 --> 00:05:44,990
.عليّ أن أطلع الناس على ما أفكّر به

54
00:05:44,990 --> 00:05:51,760
لا أعلم إن كان ذلك سيخفّف من مخاوفهم
.أم لا، لكن علي أن أنقل لهم أفكاري

55
00:05:57,970 --> 00:05:59,640
.اجمعوا النّاس رجاءً

56
00:05:59,990 --> 00:06:05,840
.إلى الآن، تشاركت أنا ولويزي وآينسلوت واجبات الملكة المقدّسة

57
00:06:06,570 --> 00:06:09,750
،لقد ساعدتماني عندما افتقرت للخبرة

58
00:06:09,750 --> 00:06:13,090
.لكنّي كنت أستغلّ ذلك للتهرّب من مسؤوليّاتي

59
00:06:13,090 --> 00:06:14,230
...يوريانا-ساما

60
00:06:14,620 --> 00:06:20,000
.فهمت الآن ما عليّ فعله بعد رؤيتي لوضع البلاد الحاليّ

61
00:06:23,790 --> 00:06:26,510
،من أجل إخماد مخاوف النّاس

62
00:06:26,510 --> 00:06:32,370
على الحاكم أن يريهم أوّلًا كيف يتقدمون
.نحو الأمام وكيف يعيشون حياتهم

63
00:06:32,970 --> 00:06:37,130
.سأقوم بواجبي بصفتي وريثة للعرش

64
00:06:38,850 --> 00:06:40,180
...يوريانا-ساما

65
00:06:40,180 --> 00:06:42,480
.أنا أحترم عزيمتك

66
00:06:48,520 --> 00:06:52,610
.سترث جلالة الملكة يوريانا العرش

67
00:06:55,020 --> 00:06:57,650
.وبالتّالي سنقيم حفلًا للتّتويج

68
00:07:02,350 --> 00:07:04,280
!أرام! اعتنِ بفينا

69
00:07:04,280 --> 00:07:05,090
.حسنًا

70
00:07:16,570 --> 00:07:18,630
.كما هو مُتَوقّع من السيّد الثاني للأراضي التسع

71
00:07:20,120 --> 00:07:21,720
!هذا مثير

72
00:07:29,760 --> 00:07:31,020
.شوزا

73
00:07:31,420 --> 00:07:34,390
ألا يمكننا أن نقاتل جنبًا إلى جنب مرّة أخرى؟

74
00:07:34,390 --> 00:07:35,400
.هذا يكفي

75
00:07:36,730 --> 00:07:41,110
.لقد خُيِّرتُ بين النور والظلام

76
00:07:41,640 --> 00:07:44,400
،إن اخترتَ اتّباع طريق النّور

77
00:07:44,400 --> 00:07:48,550
.فسأختار اتّباع طريق الظّلام

78
00:07:51,410 --> 00:07:53,530
.سآخذ كلّ شيء

79
00:07:53,530 --> 00:07:54,480
.الأراضي التّسع

80
00:07:54,480 --> 00:07:55,870
.يوغدو

81
00:07:55,870 --> 00:07:57,880
.وقوة السّواد

82
00:07:57,880 --> 00:08:02,880
!سأستولي على هذه القوّة، وسأصبح الملك الأسود الحقيقيّ

83
00:08:12,050 --> 00:08:14,180
!يوري

84
00:08:15,120 --> 00:08:17,210
!فلتختفوا أيها الضّعفاء

85
00:08:17,210 --> 00:08:18,150
!أيّها القائد

86
00:08:20,440 --> 00:08:22,320
!فلنسرع بتنفيذ هجوم متسلسل

87
00:08:37,460 --> 00:08:38,960
...أمسك

88
00:08:46,360 --> 00:08:47,220
!أيها القائد

89
00:08:47,220 --> 00:08:48,470
!يوري

90
00:08:48,470 --> 00:08:50,470
!لقد كسر هجومهم المتسلسل

91
00:08:57,060 --> 00:08:59,400
.أنت واثق من نفسك كثيرًا أيّها الطّفل

92
00:09:16,450 --> 00:09:17,630
!أرام

93
00:09:18,480 --> 00:09:20,500
.سلّميه لي الآن

94
00:09:20,500 --> 00:09:21,700
.لا

95
00:09:23,070 --> 00:09:24,460
!توقّف

96
00:09:31,180 --> 00:09:33,930
!شوزا

97
00:10:10,260 --> 00:10:11,900
من تكونين؟

98
00:10:12,500 --> 00:10:14,460
.اسمي أولزادا

99
00:10:14,460 --> 00:10:17,840
.كائن قديم قيل أنّه يجلب الكوارث

100
00:10:18,400 --> 00:10:20,180
أليست ظريفة؟

101
00:10:21,250 --> 00:10:24,690
.حان الوقت لكي تأتي إلى ديارك

102
00:10:25,940 --> 00:10:27,410
.شيطان

103
00:10:28,410 --> 00:10:31,360
.لا يبدو أنّك تختلف عنّا

104
00:10:31,360 --> 00:10:33,600
هل تريد مرافقتنا أيضًا؟

105
00:10:33,600 --> 00:10:35,950
.لا تضحكيني أيّتها الحثالة

106
00:10:37,330 --> 00:10:40,730
.أكره ذلك، لكن عليك أن تموت

107
00:10:43,140 --> 00:10:44,920
!احموا السيّد

108
00:10:46,300 --> 00:10:47,420
.يا للبشاعة

109
00:10:54,300 --> 00:10:56,180
.لا حاجة لي بالضّعفاء

110
00:10:56,570 --> 00:10:58,140
.جميل

111
00:10:58,810 --> 00:11:00,560
!سأقطعك

112
00:11:01,490 --> 00:11:03,560
!فلنحرقهم جميعًا

113
00:11:04,130 --> 00:11:06,020
.أيّتها الحشرات

114
00:11:14,050 --> 00:11:17,490
.هيّا، فلننضمّ للملك

115
00:11:17,490 --> 00:11:23,170
.حُسِم قدرك في اللّحظة التي ظهرت فيها أمام الملك الأسود

116
00:11:23,170 --> 00:11:24,890
.هذا هراء

117
00:11:25,570 --> 00:11:28,390
.أنت ملطّخ بالسّواد بالفعل

118
00:11:30,430 --> 00:11:33,010
.هيا، فلنذهب

119
00:11:35,380 --> 00:11:37,340
لمَ تتردّد؟

120
00:11:39,480 --> 00:11:40,530
.انظر

121
00:11:41,880 --> 00:11:44,770
.لقد فشلت في حماية أصدقائك

122
00:11:44,770 --> 00:11:45,860
!لا

123
00:11:45,860 --> 00:11:49,150
.وسمحت بأن يُسرَق السجلّ المتسلسل

124
00:11:50,280 --> 00:11:52,650
.مرّة أخرى

125
00:11:52,650 --> 00:11:54,280
...هـ-هذا

126
00:11:54,280 --> 00:11:55,410
.إنّها الحقيقة

127
00:12:03,420 --> 00:12:04,790
...سحقًا

128
00:12:04,790 --> 00:12:06,260
...أرام

129
00:12:06,260 --> 00:12:07,100
.فينا

130
00:12:07,100 --> 00:12:08,700
...السجلّ المتسلسل

131
00:12:09,460 --> 00:12:11,460
.سأستعيده

132
00:12:14,120 --> 00:12:16,100
!يوري-سان، لا

133
00:12:16,100 --> 00:12:17,470
!لا يمكنك الذّهاب

134
00:12:17,470 --> 00:12:18,520
!سأوقفه

135
00:12:20,380 --> 00:12:22,020
.لن أدعك تتدخّل

136
00:12:24,150 --> 00:12:26,210
لقد فهمت بالفعل، أليس كذلك؟

137
00:12:26,840 --> 00:12:28,720
.أنت ضعيف

138
00:12:29,260 --> 00:12:31,080
...أنا، أنا

139
00:12:31,080 --> 00:12:33,520
.هيّا، تقبّل الأمر

140
00:12:33,870 --> 00:12:37,360
...أنا... أنا

141
00:12:37,360 --> 00:12:38,810
...هيّا

142
00:12:49,550 --> 00:12:51,380
.كدت أنجح

143
00:12:51,380 --> 00:12:55,050
.أقسمت على هزيمة الملك الأسود هذه المرّة

144
00:12:55,050 --> 00:12:57,510
!لذا لن أتردّد

145
00:12:58,890 --> 00:13:02,170
!سوف أنتصر رفقة أصدقائي

146
00:13:02,170 --> 00:13:03,020
أصدقاؤك؟

147
00:13:08,290 --> 00:13:13,100
لمَ تظنّ إذًا أنّ بوركهارت أصبح شيطانًا؟

148
00:13:14,870 --> 00:13:16,030
!أرام

149
00:13:21,640 --> 00:13:24,830
.ألق نظرة على أصدقائك

150
00:13:26,240 --> 00:13:27,790
!لن أسلّم لكم يوري

151
00:13:27,790 --> 00:13:29,860
.إنّه قدره

152
00:13:29,860 --> 00:13:31,340
!لا أكترث

153
00:13:31,340 --> 00:13:33,600
.الجميع يملكون مكانهم المناسب

154
00:13:33,600 --> 00:13:36,970
.لقد رفضني الشّخص الذي أعطيت له كل شيء

155
00:13:38,840 --> 00:13:43,300
.كانت تلك اللحظة التي فهمت فيها الخطأ الذي ارتكبته

156
00:13:43,300 --> 00:13:45,300
!لا فكرة لي عمّا تتحدّث

157
00:13:47,310 --> 00:13:49,870
.أنت في حالة يرثى لها

158
00:13:49,870 --> 00:13:51,310
وكذلك هم، انظر

159
00:14:01,500 --> 00:14:02,490
.لا

160
00:14:06,490 --> 00:14:08,750
يوشيتسوغو، لماذا؟

161
00:14:10,700 --> 00:14:13,430
.كان بإمكانك إيقاف شوزا

162
00:14:13,430 --> 00:14:15,230
أنا؟ أوقفه؟

163
00:14:15,980 --> 00:14:18,360
.أنا أملك شرفًا بصفتي غولًا

164
00:14:18,360 --> 00:14:22,630
.أراهن بما بقي لي من حياة على شوزا

165
00:14:23,430 --> 00:14:26,270
.تمامًا كما تراهن أنت بحياتك على يوري

166
00:14:27,010 --> 00:14:30,770
.سأقاتل من أجل الشّخص الذي وثقت به

167
00:14:31,330 --> 00:14:32,480
.وكذلك أنا

168
00:14:44,090 --> 00:14:45,930
.يا للمساكين

169
00:14:45,930 --> 00:14:49,790
.سيموتون فقط لأنّهم قرّروا أن يثقوا بك

170
00:14:50,380 --> 00:14:52,670
.كلّ ذلك خطؤك

171
00:14:54,740 --> 00:14:55,700
...إنّه

172
00:14:55,700 --> 00:14:59,130
.هذا صحيح. لا يمكنك أن تحميَ أحدًا

173
00:14:59,130 --> 00:15:01,680
...أنا... أنا

174
00:15:06,190 --> 00:15:07,480
!يوري

175
00:15:07,830 --> 00:15:09,690
!لا تذهب

176
00:15:11,430 --> 00:15:15,430
.علمت أنّك لست بطلًا

177
00:15:16,630 --> 00:15:20,870
.علمت أنّك لم تمتلك القدرة على حماية أصدقائك

178
00:15:20,870 --> 00:15:24,070
.لكنّك لم تستطع الاعتراف بذلك لنفسك

179
00:15:24,070 --> 00:15:27,410
.لا، لم يسمح لك من حولك بذلك

180
00:15:27,410 --> 00:15:28,570
!هذا ليس صحيحًا

181
00:15:28,570 --> 00:15:31,710
.لا يوجد ولا حتّى شعاع أملٍ واحد لهذا العالم

182
00:15:32,290 --> 00:15:35,290
.سيغمره السّواد قريبًا

183
00:15:36,490 --> 00:15:39,950
.لكنّك ستحرّر عندما يحدث ذلك

184
00:15:39,950 --> 00:15:44,180
ما الطّائل من معاناتك أو جعل أصدقائك يعانون لوقت أطول؟

185
00:15:45,430 --> 00:15:46,390
...أنا

186
00:15:46,390 --> 00:15:52,310
.السّلام الذي تسعى إليه هو في الحقيقة عالم الظّلام

187
00:15:52,310 --> 00:15:59,230
.كن لطيفًا مع أصدقائك وأنهِ الأمور بيديك

188
00:16:01,190 --> 00:16:05,450
.هذا هو الطريق الوحيد المتبقي لك

189
00:16:06,100 --> 00:16:09,220
لطف؟ إنهاء... الأمور؟

190
00:16:10,450 --> 00:16:11,620
!يوري

191
00:16:15,240 --> 00:16:16,830
.تعالَ معي

192
00:16:18,380 --> 00:16:20,580
.إلى العالم الذي تنتمي إليه

193
00:16:21,150 --> 00:16:25,450
.لم يعد بإمكانك حماية أحد بعد الآن

194
00:16:26,370 --> 00:16:28,750
.اتبع قلبك

195
00:16:30,120 --> 00:16:32,740
...أنا... أنا

196
00:16:35,230 --> 00:16:36,430
!يوري

197
00:16:39,380 --> 00:16:42,270
!لن أدع السّواد يهزمني

198
00:16:46,280 --> 00:16:49,250
هل هذا هو جوابك؟

199
00:16:54,430 --> 00:16:56,880
...كاين... لماذا

200
00:16:59,120 --> 00:17:00,440
...أيّها القائد

201
00:17:12,440 --> 00:17:16,940
.لقد قطعت ذلك الرابط المتلاشي بيديك

202
00:17:21,070 --> 00:17:22,320
!كاين

203
00:17:23,480 --> 00:17:25,710
هل أنت بخير أيّها القائد؟

204
00:17:25,710 --> 00:17:26,780
...أنا

205
00:17:26,780 --> 00:17:28,810
.ما دمت بخير فهذا كلّ ما يهم

206
00:17:29,290 --> 00:17:32,210
.جيش قهر الملك الأسود بحاجة لك

207
00:17:33,930 --> 00:17:34,800
.كاين

208
00:17:35,860 --> 00:17:37,100
!كاين

209
00:17:50,130 --> 00:17:51,130
!أيّها القائد

210
00:17:51,670 --> 00:17:53,020
ماذا؟

211
00:18:00,670 --> 00:18:02,860
سنجمع الجنود من جميع أنحاء البلاد

212
00:18:02,860 --> 00:18:05,020
.وسنشكّل جيشًا لقهر الملك الأسود

213
00:18:05,270 --> 00:18:07,900
.يعلّق قائدنا آمالًا كبيرة عليك

214
00:18:09,230 --> 00:18:12,250
.اتبع الطريق الذي تعتقده صحيحًا

215
00:18:14,090 --> 00:18:15,530
أمل؟

216
00:18:15,530 --> 00:18:18,000
كيف يساعد ذلك؟

217
00:18:18,000 --> 00:18:22,120
.توسّلك الناس لتنقذ العالم

218
00:18:22,120 --> 00:18:27,910
.كلّفك العالم بمهمّة إنقاذه لأنّك بطل

219
00:18:34,180 --> 00:18:36,160
.لقد كنت بانتظارك

220
00:18:42,990 --> 00:18:49,030
.تواجه قارة يوغدو اختبارًا لم يسبق له مثيل

221
00:18:49,970 --> 00:18:55,640
.وهذه البلاد أيضًا قد أحيطت بالظلام ولا يبدو أنّ لذلك نهاية قريبة

222
00:18:56,640 --> 00:19:00,500
.لكن هذا لا يعني أنّ الأمل قد انعدم كلّيًا

223
00:19:00,500 --> 00:19:03,190
—لقد قرّرت اليوم أن

224
00:19:03,190 --> 00:19:04,580
من تظنّين نفسك؟

225
00:19:04,580 --> 00:19:05,330
.إنّها غلطتك

226
00:19:05,330 --> 00:19:07,240
!لقد خسرنا الحرب بسببك

227
00:19:07,240 --> 00:19:08,210
!أجل

228
00:19:13,060 --> 00:19:16,410
،عندما قتل الجيش الأسود أبي

229
00:19:16,410 --> 00:19:22,110
.وقعت في يأس عميق، وفقدت النّور

230
00:19:22,920 --> 00:19:30,160
.وبسبب هوسي، رميت نفسي في معركة غير مثمرة للانتقام لوالدي

231
00:19:31,230 --> 00:19:35,270
.ورّطت أصدقاء كانوا أعزّاء عليّ وسببت لهم المعاناة

232
00:19:37,880 --> 00:19:41,790
.تلك كانت اللّحظة التي أوقفني فيها أحد المحاربين

233
00:19:42,220 --> 00:19:43,890
.لقد وبّخني بصراحة

234
00:19:43,890 --> 00:19:46,830
.كان قلقًا عليّ، وواجهني

235
00:19:46,830 --> 00:19:51,050
.وبفضله تمكنّت من إيقاف نفسي

236
00:19:59,130 --> 00:20:03,200
لكن للأسف عندما عدت

237
00:20:03,200 --> 00:20:07,940
.وجدت شعبي يفتقر للنور، كما كنت أنا من قبل

238
00:20:08,570 --> 00:20:13,990
.أعلم عن خبرة أنّ الخراب هو ما ينتظرنا إن تابعنا سلك هذا الطريق

239
00:20:14,200 --> 00:20:18,120
.لهذا عليّ أن أكون قويّة

240
00:20:18,470 --> 00:20:22,000
.فأنتم كالعائلة بالنّسبة لي

241
00:20:23,790 --> 00:20:28,250
.لقد قرّرت الجلوس على العرش

242
00:20:29,300 --> 00:20:33,600
.لكي أعيد نور الأمل إلى قلوبنا

243
00:20:35,920 --> 00:20:40,190
.علينا الآن أن نتّحد معًا ونقاتل معًا

244
00:20:43,130 --> 00:20:51,190
هذه المملكة المقدّسة القديمة تجنّبت
.الكثير من المآسي بفضل روابطنا القويّة

245
00:20:51,190 --> 00:20:56,060
.وبهذه الرّوابط، لا يوجد شيء لا يمكننا الانتصار عليه

246
00:20:58,910 --> 00:21:02,010
.لن يهزمنا الظّلام أبدًا

247
00:21:03,100 --> 00:21:08,850
،من أجل المملكة المقدّسة النّبيلة ومن أجل سكّانها الفخورين

248
00:21:09,740 --> 00:21:12,720
!فليسطع نور الأمل بقوة

249
00:21:25,060 --> 00:21:27,620
،باسم الكهنة السبعة عشر

250
00:21:27,620 --> 00:21:30,970
مُمَزَّق

251
00:23:36,230 --> 00:23:38,820
.تبدأ عجلة القدر بالدوران