1
00:00:05,560 --> 00:00:08,350
سيعود الحارس التّنّين إلى الحياة؟

2
00:00:08,350 --> 00:00:08,770
.أجل

3
00:00:08,770 --> 00:00:11,730
.العجوز المدعو بالتازاري قال ذلك

4
00:00:11,730 --> 00:00:16,400
قال أنّ علينا الذهاب إلى بحيرة الرّمل
.حيث سيظهر تنّين حارس جديد

5
00:00:16,400 --> 00:00:18,860
حكيم القدر؟

6
00:00:18,860 --> 00:00:23,670
.لقد تلطّخ سجلّ هذه القارة بالسّواد

7
00:00:23,670 --> 00:00:25,880
.لا نملك وقتًا لنضيّعه

8
00:00:26,440 --> 00:00:30,500
.علينا أن نستجمع كلّ القوّة التي نملكها

9
00:00:30,500 --> 00:00:34,000
.ساعدينا رجاءً يا أشرينا-ساما

10
00:00:35,180 --> 00:00:38,040
...إن كان هذا ما قاله بالتازاري

11
00:00:38,040 --> 00:00:40,510
.فقد يكون هذا هو وقت الاختبار

12
00:00:41,770 --> 00:00:42,510
.فارا

13
00:00:42,510 --> 00:00:43,400
.أجل

14
00:00:45,830 --> 00:00:49,300
تمّ اكتشاف هذه في أطلال الضريح

15
00:00:49,740 --> 00:00:53,520
.الذي كان منزلًا للتنّين المسودّ الذي هزمه يوري-دونو

16
00:00:53,520 --> 00:00:55,770
هل هذه أغنية؟

17
00:00:55,770 --> 00:01:00,740
.لطالما أردت من موزيكا أن تغنيَّ هذه

18
00:01:01,160 --> 00:01:03,000
.قد يحدث شيء ما

19
00:01:03,630 --> 00:01:04,870
موزيكا؟

20
00:01:04,870 --> 00:01:07,990
.إنّها جنيّة غابة. يسمّونها المغنيّة الأسطوريّة

21
00:01:07,990 --> 00:01:12,720
.بالفعل، لا أظنّ أنّ أحدًا آخر قادر على غناء هذه الأغنية

22
00:01:14,000 --> 00:01:16,840
هل سنوقظ التّنين بأغنيّة؟

23
00:01:16,840 --> 00:01:18,660
.هذا رائع

24
00:01:19,540 --> 00:01:21,830
.نحن ندين ليوري

25
00:01:21,830 --> 00:01:26,490
.وما كنّا لنرفض طلبًا للمساعدة في قتال الملك الأسود أبدًا

26
00:01:26,490 --> 00:01:30,160
.فارا، ابحثي عن موزيكا وناديها

27
00:01:30,160 --> 00:01:31,510
هل يمكنك ذلك؟

28
00:01:31,510 --> 00:01:32,470
.مفهوم

29
00:01:32,470 --> 00:01:34,480
هل يمكنني المجيء معك؟

30
00:01:34,860 --> 00:01:36,230
.بالطّبع

31
00:01:36,580 --> 00:01:38,300
جلالة الملكة، كاليفا-ساما

32
00:01:38,300 --> 00:01:40,180
ما الذي تريده؟

33
00:01:41,150 --> 00:01:42,440
...جيش

34
00:01:43,530 --> 00:01:45,730
.هناك جيش يحمل راية الأراضي التّسع

35
00:01:45,730 --> 00:01:47,610
.عددهم حوالي 10000 رجل

36
00:01:47,610 --> 00:01:48,750
الأراضي التسع؟

37
00:01:48,750 --> 00:01:50,250
.إنّه ذلك الوغد شوزا

38
00:01:51,020 --> 00:01:52,910
.علينا أن نجهّز جيشنا في الحال يا جلالة الملكة

39
00:01:54,020 --> 00:01:55,250
.انتظر رجاءً

40
00:01:55,970 --> 00:02:01,210
.هناك جيش آخر يعترضهم، عددهم 10000 أيضًا

41
00:02:01,730 --> 00:02:03,860
جيش آخر؟

42
00:02:05,670 --> 00:02:07,710
.الحراس المقدسون للمملكة المقدسة

43
00:02:08,170 --> 00:02:11,230
.تقودهم الملكة المقدسة يوريانا

44
00:03:48,380 --> 00:03:49,860
.إنّهم لا يتحرّكون

45
00:03:49,860 --> 00:03:52,450
.لا بدّ أنّهم ينتظرون تحرّكنا أوّلًا

46
00:03:53,940 --> 00:03:55,540
هل نرسل الرّسل؟

47
00:03:55,540 --> 00:04:00,080
.لم يعد أيٌّ من الرسل الذين أرسلناهم

48
00:04:00,080 --> 00:04:01,680
.أشك في أنّ ذلك سيفيد

49
00:04:02,310 --> 00:04:04,920
.حدث ذلك مع رسلنا أيضًا

50
00:04:06,210 --> 00:04:08,590
.قد لا يكون لدينا خيار سوى القتال

51
00:04:09,040 --> 00:04:11,280
.ابقيا أماكنكما أيّها الجيشان

52
00:04:12,190 --> 00:04:16,270
.لديّ رسالة من أشرينا ملكة الصّحراء

53
00:04:16,870 --> 00:04:21,410
.سيعاني الجيشان إن قاتلتما الآن

54
00:04:21,410 --> 00:04:27,310
أليس من الأفضل أن نسويّ هذا بالكلمات بدل السّيف؟

55
00:04:27,310 --> 00:04:31,210
.سنوفّر المكان نحن سكّان بحيرة الرمل

56
00:04:31,210 --> 00:04:34,490
.فليحضر كلّ منكما مئة رجل

57
00:04:34,490 --> 00:04:36,870
إهدار قوّاتنا بهذه السهولة قبل مواجهة

58
00:04:36,870 --> 00:04:39,740
.الملك الأسود لهو ضرب من الغباء

59
00:04:39,740 --> 00:04:44,260
لا جلالة الملكة المقدّسة ولا قادة

60
00:04:44,260 --> 00:04:47,180
.الأراضي التسع الكرماء أغبياء لدرجة فعل شيء كهذا

61
00:04:47,200 --> 00:04:51,510
.أثق في قبولكم اللّطيف لهذا العرض

62
00:04:51,510 --> 00:04:53,200
.محال

63
00:04:53,690 --> 00:04:55,180
هل نطلق عليه؟

64
00:04:55,180 --> 00:04:56,030
.لا

65
00:04:56,030 --> 00:04:57,190
.هذا مثير للاهتمام

66
00:04:57,190 --> 00:04:59,030
.سأقبل العرض

67
00:04:59,030 --> 00:04:59,730
...لكن

68
00:04:59,740 --> 00:05:04,450
سيكون من الممتع رؤية الفتاة التي تجرّأت

69
00:05:04,450 --> 00:05:08,080
.على مناداة نفسها بالملكة المقدّسة قبل الإطاحة بها

70
00:05:08,080 --> 00:05:10,530
هل سنقبل العرض؟

71
00:05:10,530 --> 00:05:11,310
.أجل

72
00:05:11,310 --> 00:05:13,120
.هذه فرصة غير متوقّعة

73
00:05:13,120 --> 00:05:15,950
.سيكون إقناعنا لهم أمرًا مثاليًا إن استطعنا

74
00:05:16,380 --> 00:05:18,470
.هيّا بنا يا آينسلوت

75
00:05:18,470 --> 00:05:19,340
.حاضر

76
00:05:22,320 --> 00:05:29,090
.جلالة الملكة المقدّسة، أنا كاليفا، مستشار جلالة الملكة أشرينا

77
00:05:29,940 --> 00:05:33,100
.أهنّئك على تتويجك

78
00:05:33,100 --> 00:05:35,670
.لقد أخجلت تواضعي بترحيبك المهذّب

79
00:05:36,430 --> 00:05:39,400
.سامحنا على حضورنا بجيش دون سابق إنذار

80
00:05:39,400 --> 00:05:42,640
.لا يوجد لأسامحك عليه

81
00:05:43,230 --> 00:05:44,820
.مرحبًا، مضى وقت طويل

82
00:05:45,940 --> 00:05:48,200
.هذا أنت يا أرام

83
00:05:48,200 --> 00:05:49,650
لمَ أنتَ هنا؟

84
00:05:49,650 --> 00:05:51,210
لماذا؟

85
00:05:51,210 --> 00:05:56,290
.لمساعدة يوري وهزيمة الملك الأسود بالطّبع

86
00:05:57,520 --> 00:05:58,860
.حسنًا

87
00:05:58,860 --> 00:06:02,300
.أنا واثقة أنّ يوري سيقدّر ذلك

88
00:06:02,300 --> 00:06:04,820
.فلنبذل جهدنا يا أرام

89
00:06:05,830 --> 00:06:08,870
.مهلًا، لا تعامليني كطفل

90
00:06:13,830 --> 00:06:15,800
.أنت هنا إذًا

91
00:06:22,400 --> 00:06:24,050
.مهلًا، قل شيئًا

92
00:06:24,550 --> 00:06:27,780
.أرام، دع هذا لنا

93
00:06:38,040 --> 00:06:40,350
.عليها أن تكون في مكان ما هنا

94
00:06:55,090 --> 00:06:56,050
ماذا؟

95
00:06:57,190 --> 00:07:01,060
هل تطلب منّي أن أتنحى عن العرش؟

96
00:07:01,060 --> 00:07:02,060
.لا

97
00:07:02,480 --> 00:07:05,000
.لا أكترث إن ناديت نفسك بالملكة المقدّسة أو لا

98
00:07:05,000 --> 00:07:09,070
.لكنّي أريدك أن تتنازلي عن قيادة الحرس المقدّسين

99
00:07:09,070 --> 00:07:11,240
.لن أفعل ذلك أبدًا

100
00:07:11,240 --> 00:07:14,080
.لن أبقى الملكة المقدسة حينها

101
00:07:15,580 --> 00:07:24,080
.يوري حامل رايتك هُزِم على يد الملك الأسود وسقط في الظلام

102
00:07:24,530 --> 00:07:28,980
.وسمعت أيضًا أنّ أحد رجالك اسودّ وأصبح شيطانًا

103
00:07:29,590 --> 00:07:32,340
.أنت لست مناسبة لذلك المنصب

104
00:07:32,850 --> 00:07:36,230
كنت تتجنّبين العرش لوقت طويل

105
00:07:36,230 --> 00:07:41,230
وتسمحين للغير بالقيام بدورك لأنّك تعرفين ذلك، أليس هذا صحيحًا؟

106
00:07:41,230 --> 00:07:42,550
...هذا

107
00:07:46,230 --> 00:07:47,460
هذا؟

108
00:07:47,460 --> 00:07:51,240
هذا ماذا يا جلالة الملكة المقدّسة يوريانا؟

109
00:07:51,770 --> 00:07:54,360
...شوزا، أنت

110
00:07:56,690 --> 00:07:58,380
.هذا سيّئ

111
00:07:58,380 --> 00:08:00,580
.شوزا يجيد استفزاز الغير

112
00:08:00,580 --> 00:08:02,010
.لن ينتهي هذا في سلام

113
00:08:03,870 --> 00:08:05,870
!نحن نتعرّض للهجوم

114
00:08:06,750 --> 00:08:08,220
ما الذي يجري؟

115
00:08:08,210 --> 00:08:10,790
!لقد ظهر الجيش الأسود يا سيّدي

116
00:08:23,160 --> 00:08:27,470
.يبدو أنّ عليّ أن أهتم بأمرهم قبل مواجهة الملكة المقدّسة

117
00:08:30,150 --> 00:08:32,150
.هذا ليس الوقت المناسب

118
00:08:32,520 --> 00:08:34,720
هل نرسل بقيّة جيشنا؟

119
00:08:35,580 --> 00:08:38,860
.لا، سنتعامل معهم بما لدينا هنا

120
00:08:40,170 --> 00:08:42,650
.سيكون هذا ممتعًا

121
00:08:53,050 --> 00:08:54,380
...أنت

122
00:09:20,740 --> 00:09:21,380
.مت

123
00:09:40,710 --> 00:09:43,160
.هذه دمى ممتعة

124
00:09:51,530 --> 00:09:53,840
.يا له من منظر مزعج

125
00:09:53,840 --> 00:09:55,360
.مثيرة للشفقة

126
00:09:55,360 --> 00:09:56,310
.بوركهارت

127
00:09:56,310 --> 00:09:59,890
.سمعت أنّك قد اعتليت العرش

128
00:09:59,890 --> 00:10:03,910
هل أهنئك يا يوريانا-ساما؟

129
00:10:06,910 --> 00:10:10,510
.لا تبدين مرتاحة الآن

130
00:10:10,510 --> 00:10:13,870
هل عرش الملكة المقدّسة ثقيل إلى تلك الدّرجة؟

131
00:10:14,340 --> 00:10:18,710
.مشاهدتك مثيرة للشفقة

132
00:10:25,440 --> 00:10:26,220
!جلالة الملكة

133
00:10:33,110 --> 00:10:36,270
.أنتِ شخص أكثر حدّة

134
00:10:36,270 --> 00:10:38,240
لمَ تقتلين نفسك؟

135
00:10:38,240 --> 00:10:40,660
لمَ لا تفعلين ما تريدين؟

136
00:10:40,660 --> 00:10:43,660
.تمامًا كما دستِ عليّ

137
00:10:48,780 --> 00:10:49,620
.كلّا

138
00:10:49,620 --> 00:10:51,000
...كنت

139
00:10:51,000 --> 00:10:52,580
.كنت أفعل ذلك من أجلك

140
00:10:52,580 --> 00:10:54,790
.لست بحاجة لأعذارك

141
00:10:54,790 --> 00:10:57,910
،مهما كان ما كنت تظنّين نفسك تفعلينه

142
00:10:57,910 --> 00:11:01,390
.كلّ ما يهمّ هو ما شعرتُ به ونتيجة ذلك

143
00:11:02,160 --> 00:11:05,120
.أنت أكثر إثارة للشفقة في وضعك الحاليّ

144
00:11:05,120 --> 00:11:09,360
.ما كنت لتستطيعي هزيمة شوزا، فما بالك بسيّدنا الملك الأسود

145
00:11:09,930 --> 00:11:13,390
.لا أريد رؤيتك بعد الآن

146
00:11:15,810 --> 00:11:17,770
.سأهتمّ بأمره

147
00:11:22,310 --> 00:11:23,320
.أيّها العجوز

148
00:11:23,320 --> 00:11:24,430
.أنت حيّ

149
00:11:24,430 --> 00:11:25,970
.أحسنت، أحسنت

150
00:11:25,970 --> 00:11:28,570
هل رأيت شوزا-دونو ويوريانا-دونو؟

151
00:11:28,570 --> 00:11:29,810
.لا أدري

152
00:11:29,810 --> 00:11:30,950
.الفوضى تعمّ المكان

153
00:11:30,950 --> 00:11:32,320
.تبًّا

154
00:11:32,320 --> 00:11:34,290
.لم أرد أن أفقدهما

155
00:11:35,550 --> 00:11:40,310
.لا أحد يدري أيّ حادث قد يحدث نظرًا لوضعنا هذا

156
00:11:41,060 --> 00:11:42,260
حادث؟

157
00:11:42,260 --> 00:11:44,780
.إنّهما مثل الماء والزيّت

158
00:11:44,780 --> 00:11:47,130
.من المستحيل أن يتفاهما

159
00:11:47,130 --> 00:11:49,220
.وكلاهما يعرفان ذلك

160
00:11:49,220 --> 00:11:53,730
...إن وجدا أيّ فرصة للإطاحة ببعضهما

161
00:11:53,730 --> 00:11:55,080
فماذا سيحدث برأيك؟

162
00:11:58,400 --> 00:12:01,020
وإن مات أحدهما

163
00:12:02,730 --> 00:12:05,940
.فستنشب مجزرة مروعة من دون شكّ

164
00:12:05,940 --> 00:12:08,240
.لن أدع ذلك يحدث

165
00:12:25,730 --> 00:12:27,250
.هذا غريب

166
00:12:36,310 --> 00:12:37,520
...لولا

167
00:12:37,520 --> 00:12:39,530
!لولاك

168
00:12:40,670 --> 00:12:42,690
.الأمر ينطبق على كلينا

169
00:12:47,750 --> 00:12:50,750
لمَ تقف في طريقي يا شوزا؟

170
00:12:50,750 --> 00:12:53,370
.أنت من يعترض طريقي

171
00:12:53,370 --> 00:12:57,830
.من المضحك أن تنادي فتاة عاجزة مثلك نفسها بالملكة المقدّسة

172
00:13:02,120 --> 00:13:08,060
!أنت لا تعرف ما تطلبّه منّي اتّخاذ ذلك القرار

173
00:13:13,250 --> 00:13:15,910
.سوف أهزمك يا شوزا

174
00:13:15,910 --> 00:13:17,190
...إن فعلت ذلك

175
00:13:19,190 --> 00:13:20,690
...إن لم أفعل

176
00:13:22,020 --> 00:13:23,350
...أنا

177
00:13:31,290 --> 00:13:33,410
.أيّتها الطفلة اللّعينة

178
00:13:35,080 --> 00:13:37,670
!أنتِ من سيموت

179
00:13:53,170 --> 00:13:54,680
.يا إلهي

180
00:14:07,290 --> 00:14:09,110
.هذا مسلٍّ

181
00:14:21,210 --> 00:14:24,340
!توقّفا

182
00:15:08,340 --> 00:15:09,610
...أنا

183
00:15:10,540 --> 00:15:14,320
.كنتما تتحوّلان إلى السّواد

184
00:15:15,160 --> 00:15:17,620
.كان عليكما أن تلاحظا ذلك عاجلًا أيّها الغبيّان

185
00:15:17,620 --> 00:15:19,160
.تبًّا

186
00:15:22,780 --> 00:15:25,300
.أنتم مجموعة عنيدة حقًّا

187
00:15:25,300 --> 00:15:31,010
.كان يمكن ليوريانا-ساما أن تصبح منّا

188
00:15:36,080 --> 00:15:38,950
هل تقاومين يا يوريانا-ساما؟

189
00:15:38,950 --> 00:15:44,040
رغم الحرّية الّتي نملكها في هذا الجانب؟

190
00:15:44,040 --> 00:15:46,090
.اخرس يا بوركهارت

191
00:15:46,530 --> 00:15:51,100
هل تذكر عندما قلت أنّ المرة التالية
الّتي سنلتقي فيها ستكون الأخيرة؟

192
00:15:51,100 --> 00:15:54,720
.فلنجعلها كذلك إذًا

193
00:15:56,310 --> 00:15:59,760
!إيّاك أن تجرؤ على التّكلّم أيّها الطّفل

194
00:16:04,730 --> 00:16:06,190
!أرام

195
00:16:07,360 --> 00:16:10,810
لقد أخبرني العجوز كاليفا

196
00:16:10,810 --> 00:16:16,080
.أنّ لا أحد يعرف ما سيحدث لجيشيكما إن مات أحدكما

197
00:16:16,950 --> 00:16:21,450
.لن أدعك تموتين

198
00:16:29,840 --> 00:16:30,680
ماذا؟

199
00:16:34,260 --> 00:16:36,260
.سأقتل أيّ أحد يعترض طريقي

200
00:16:43,400 --> 00:16:44,630
!كرة الفرو

201
00:17:03,020 --> 00:17:07,600
.أيها التنّين حارس بحيرة الرّمل، امنحنا نورًا من الأمل

202
00:17:25,150 --> 00:17:27,060
.دمّر الظّلام

203
00:17:27,060 --> 00:17:29,680
.يمكنك ذلك يا أرام

204
00:18:23,000 --> 00:18:24,610
كرة الفرو؟

205
00:18:24,610 --> 00:18:26,510
تنّين حارس؟

206
00:18:34,560 --> 00:18:36,590
.لا يبدو هذا جيّدًا

207
00:18:36,590 --> 00:18:37,970
.بوركهارت

208
00:18:48,110 --> 00:18:48,930
.أنت

209
00:18:52,460 --> 00:18:54,120
.أعطني السّجل

210
00:18:54,120 --> 00:18:56,800
.فهو ليس لك

211
00:19:22,260 --> 00:19:23,920
...السّجلّ

212
00:19:24,390 --> 00:19:26,270
.لقد عاد بياضه

213
00:19:38,160 --> 00:19:40,820
.شكرًا لك يا أرام-سان

214
00:19:42,930 --> 00:19:44,310
.كرة الفرو

215
00:19:44,310 --> 00:19:46,170
.لقد أخفتني حقًّا

216
00:19:46,170 --> 00:19:48,580
...لم أتوقّع أن تكن التنين الحارس

217
00:19:48,580 --> 00:19:50,380
.لكن شكرًا لك

218
00:19:50,380 --> 00:19:53,080
.فقد أنقذتنا

219
00:19:58,580 --> 00:20:00,730
أنتِ موزيكا، صحيح؟

220
00:20:00,730 --> 00:20:02,840
.نحن هنا لنعيدك معنا

221
00:20:02,840 --> 00:20:03,980
أنا؟

222
00:20:03,980 --> 00:20:04,720
.أجل

223
00:20:04,720 --> 00:20:09,310
.السيّوف التي ستخترق الظلّام بحاجة إليك

224
00:20:12,160 --> 00:20:13,150
.يوريانا

225
00:20:16,670 --> 00:20:20,230
سوف أهزم الملك الأسود

226
00:20:20,230 --> 00:20:22,110
.وسأعيد يوري بالتّأكيد

227
00:20:22,110 --> 00:20:25,150
.لذا ساعديني

228
00:20:25,150 --> 00:20:26,900
لا، ساعديني أرجوك

229
00:20:26,900 --> 00:20:28,370
.أرجوك

230
00:20:32,580 --> 00:20:35,860
.لا، أنا من لديها طلب

231
00:20:36,880 --> 00:20:40,790
.اسمح للحرس المقدسين بالانضمام إلى جيش القهر رجاءً

232
00:20:41,260 --> 00:20:42,360
هل يمكننا ذلك؟

233
00:20:44,440 --> 00:20:45,200
.أجل

234
00:20:46,570 --> 00:20:47,610
.بالطّبع

235
00:20:49,990 --> 00:20:52,770
.فليبارك الربّ جيش القهر

236
00:20:52,770 --> 00:20:55,080
.وجيش المتطوّعين

237
00:20:58,330 --> 00:20:59,520
.أرام-سان

238
00:21:00,070 --> 00:21:01,570
.مرحى يا فينا

239
00:21:01,570 --> 00:21:04,000
.سيساعدنا الحرس المقدّسون

240
00:21:07,890 --> 00:21:08,860
.شوزا

241
00:21:10,800 --> 00:21:14,270
.أعتذر عن محاولتي بذلك الهجوم المفاجئ الجبان

242
00:21:14,270 --> 00:21:16,580
لكنّنا متعادلان، أليس كذلك؟

243
00:21:17,740 --> 00:21:19,980
.أنا واثقة أنّك فهمت الآن

244
00:21:19,980 --> 00:21:21,710
.انضمّ إلينا

245
00:21:25,420 --> 00:21:28,320
.أنا أتبع دربي الخاص

246
00:21:29,960 --> 00:21:31,110
...شوزا

247
00:21:41,980 --> 00:21:43,570
هل ستدعينه يذهب؟

248
00:21:43,570 --> 00:21:44,640
.أجل

249
00:21:44,640 --> 00:21:48,950
.أشكّ في أنّهم سيقفون في طريقنا

250
00:21:50,570 --> 00:21:52,020
.حسنًا

251
00:21:52,020 --> 00:21:53,360
!هيّا بنا جميعًا

252
00:22:00,540 --> 00:22:02,920
.انتظر يا يوري

253
00:23:36,210 --> 00:23:38,790
.تبدأ عجلة القدر بالدوران