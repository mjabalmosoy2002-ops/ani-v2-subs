1
00:00:01,260 --> 00:00:03,310
أجل، حادثة فرن الصهر تلك

2
00:00:03,310 --> 00:00:05,590
سمعتُ أنّ مديراً سقط فيه

3
00:00:05,590 --> 00:00:07,520
لكن أكانت حادثةً حقّاً؟

4
00:00:07,520 --> 00:00:11,710
سمعتُ أنّ الروبوت أقدم على ذلك
انتقاماً من عنف المدير

5
00:00:11,710 --> 00:00:14,740
ماذا؟ تقصدين أنّه ثار؟ تلك مصيبة

6
00:00:15,200 --> 00:00:17,900
الروبوتات ليست أشياء حسنة بالفعل

7
00:00:24,690 --> 00:00:26,130
ما-ماذا؟

8
00:00:26,130 --> 00:00:29,580
عليك الأكل عدّ مرّات يوميّاً

9
00:00:29,580 --> 00:00:31,290
لا بدّ أن من الصعب أن تكون بشريّاً

10
00:00:31,290 --> 00:00:33,380
،يبدو ذلك غير فعّالٍ بالفعل

11
00:00:33,380 --> 00:00:37,340
لكن يبدو أنّ الطعام للبشر يقدّم
أكثر من مجرّد الحفاظ على حياتهم

12
00:00:37,340 --> 00:00:40,140
حيث يؤدي دوراً ترفيهيّاً

13
00:00:40,490 --> 00:00:42,520
أتقصد مثل الهواية؟

14
00:00:42,520 --> 00:00:44,110
تريد أكل المزيد إذاً؟

15
00:00:44,110 --> 00:00:46,860
!سأعدّ مختلف الأشياء لك يا إيسولا

16
00:00:46,860 --> 00:00:48,940
!صمتاً

17
00:00:49,800 --> 00:00:53,630
أتنوون إثارة جلبةٍ كلّما
تناول إيسولا وجبة؟

18
00:00:53,630 --> 00:00:55,110
!لكنّه إيسولا

19
00:00:55,110 --> 00:00:57,230
!يعيش إيسولا معنا الآن

20
00:01:00,140 --> 00:01:01,650
كذلك كارون

21
00:01:01,650 --> 00:01:03,540
،المكان مفعمٌ بالحيويّة هنا
صحيح يا كارون؟

22
00:01:05,720 --> 00:01:06,960
مركز الشرطة؟

23
00:02:53,070 --> 00:02:55,290
أكلّ شيءٍ على خير يا رفاق؟

24
00:02:55,290 --> 00:02:56,730
ما قصدك؟

25
00:02:57,140 --> 00:02:59,040
كنّا في طور النوم لا أكثر

26
00:02:59,040 --> 00:03:00,110
إنّه مُملّ

27
00:03:01,460 --> 00:03:03,240
أنا مُمتنٌّ لتعاونكم

28
00:03:03,870 --> 00:03:05,370
لا داعي

29
00:03:05,370 --> 00:03:07,870
لكنّ هذا ليس مركز الشرطة

30
00:03:07,870 --> 00:03:09,690
لمَ كان علينا القدوم هنا؟

31
00:03:09,690 --> 00:03:12,630
هذه مُنشأة أبحاث مرتبطة بالشرطة

32
00:03:13,020 --> 00:03:14,260
توفّر طاقم أبحاث

33
00:03:14,260 --> 00:03:18,130
وتقنية ذكاء اصطناعيّ فائقة
التطوّر للتحقيقات الخاصّة

34
00:03:19,280 --> 00:03:23,140
ألا يمتلك مركز الشرطة البيانات
عن حادثة فرن الصهر سلفاً؟

35
00:03:23,140 --> 00:03:25,010
لستُ مُلزماً بالإجابة على ذلك

36
00:03:26,580 --> 00:03:27,830
إيسولا، لنرجع للبيت

37
00:03:27,830 --> 00:03:29,420
حسناً

38
00:03:31,310 --> 00:03:33,390
!عندما نرجع، سأطهو لك طعاماً من جديد

39
00:03:33,390 --> 00:03:35,310
لا أزال مُتخماً

40
00:03:35,310 --> 00:03:38,280
نحن مستعدّون لبدء تحليل بيانات الأربعة

41
00:03:35,740 --> 00:03:38,280
لكنّي أشعر ببعض العطش

42
00:03:39,000 --> 00:03:41,140
في تلك الحالة، فلتبدؤوا رجاءً

43
00:03:45,680 --> 00:03:46,630
إيسولا؟

44
00:03:47,640 --> 00:03:48,740
ما الخطب؟

45
00:03:48,740 --> 00:03:51,460
مجرّد شيءٍ على بالي

46
00:03:52,870 --> 00:03:54,850
!ستاند-آلون" هنا أيضاً"

47
00:03:54,850 --> 00:03:56,460
نفس الأشخاص من ذي قبل؟

48
00:03:56,460 --> 00:03:58,690
أراهم كثيراً مؤخراً

49
00:03:58,690 --> 00:04:00,590
إنّهم مُتسلّقون مشهورون، أليس كذلك؟

50
00:04:01,050 --> 00:04:04,130
ستاند-آلون" هم المُتسلّقون الأعلى"

51
00:04:04,130 --> 00:04:06,590
شعبيّتهم عاليةٌ جدّاً بحيث
يؤدون دور مُمثليّن

52
00:04:06,590 --> 00:04:09,620
لحكومة العالم والتي تدير بابل

53
00:04:09,620 --> 00:04:15,520
قائد "ستاند-آلون" هو شخص مُتحفّظ
وساعٍ للكمال، هيتوتسوباشي كايت

54
00:04:16,200 --> 00:04:17,960
لديه الكثير من المُعجبين الشغوفين

55
00:04:17,960 --> 00:04:21,540
الذين يتبعونه في كلّ عروضه
مسحورين بهالته المُميّزة

56
00:04:21,540 --> 00:04:23,710
ورقصه القويّ

57
00:04:25,460 --> 00:04:27,070
تعرف الكثير عنه

58
00:04:27,070 --> 00:04:29,790
قرأتُ عنه في مجلّة مجّانية قبل أيّام

59
00:04:29,790 --> 00:04:32,870
!اسمعوا، علينا فعل شيءٍ كهذا أيضاً

60
00:04:33,330 --> 00:04:34,970
شيء مثل ماذا؟

61
00:04:34,970 --> 00:04:38,500
علينا التقاط صورة رائعة
!مثل "نوكس" هكذا

62
00:04:38,500 --> 00:04:40,350
فيما نحتاجها؟

63
00:04:40,350 --> 00:04:42,190
تتصرّف تلك بغرابة

64
00:04:48,750 --> 00:04:49,920
ما الخطب؟

65
00:04:51,290 --> 00:04:53,160
يا أخت، أتشعرين بتوعّك؟

66
00:04:53,160 --> 00:04:54,750
تبدين شاحبة

67
00:04:55,860 --> 00:04:56,980
شكراً على سؤالكم

68
00:04:57,360 --> 00:04:58,870
أأنتِ بخير؟

69
00:04:58,870 --> 00:05:01,110
أجل، أحتاج لبعض الراحة فحسب

70
00:05:02,000 --> 00:05:05,990
أنا مريضةٌ في المستشفى في الأسفل

71
00:05:05,990 --> 00:05:08,520
حسناً، لنساعدكِ بالذهاب لغرفتكِ

72
00:05:08,520 --> 00:05:09,320
!ناغي

73
00:05:10,050 --> 00:05:12,380
ناغي، أأنتِ بخير؟

74
00:05:12,380 --> 00:05:13,830
...أخي الكبير

75
00:05:14,280 --> 00:05:15,980
أتيتِ هنا مُجدّداً؟

76
00:05:18,130 --> 00:05:20,040
...لحظة، هذا الشخص

77
00:05:20,450 --> 00:05:22,980
!كايت من "ستاند-آلون"؟

78
00:05:27,130 --> 00:05:30,740
أعتذر على التسبّب بمتاعب

79
00:05:31,060 --> 00:05:33,220
يسرّني أنّه لم يكن خطباً كبيراً وحسب

80
00:05:37,350 --> 00:05:38,740
لا تضغطي على نفسك

81
00:05:39,430 --> 00:05:44,160
قالت المجلّة أنّه كان مُتحفّظاً، لكن يبدو
أنّ المعلومة ليست دقيقة

82
00:05:44,160 --> 00:05:45,300
فجوة

83
00:05:45,300 --> 00:05:47,110
...أ-أنتما

84
00:05:47,690 --> 00:05:50,580
أنتم مُتسلّقون في بابل أيضاً، أليس كذلك؟

85
00:05:50,580 --> 00:05:52,350
أتعرفنا؟

86
00:05:52,350 --> 00:05:53,080
أجل

87
00:05:53,980 --> 00:05:56,780
رأيتُ ظهور وافدين جدد مثيرين للاهتمام

88
00:05:57,940 --> 00:05:59,140
ما اسم تسلّقكم؟

89
00:05:59,140 --> 00:06:02,040
!نوكس"! اختاره إيسولا لنا"

90
00:06:03,360 --> 00:06:04,380
سأتذكّره

91
00:06:04,870 --> 00:06:08,270
أنتم أوّل مُتسلّقين أواجههم غير مجموعة أخي

92
00:06:08,270 --> 00:06:10,940
أيعني ذلك أنّكِ مُهتمّةٌ ببابل؟

93
00:06:10,940 --> 00:06:12,470
أسبق وأن حضرتِه؟

94
00:06:12,470 --> 00:06:13,890
كلّا، لم أفعل

95
00:06:14,320 --> 00:06:16,560
لكنّكِ كنتِ تحدّقين في بابل
قبل قليل، أليس كذلك؟

96
00:06:20,480 --> 00:06:22,550
!بابل مُذهل

97
00:06:22,550 --> 00:06:24,900
!تحصلين على جوائز عند الفوز

98
00:06:24,900 --> 00:06:26,990
أجل، يمكّننا من دفع فاتورة الكهرباء

99
00:06:26,990 --> 00:06:28,450
فاتورة الكهرباء؟

100
00:06:28,450 --> 00:06:31,370
لا نزال مُتأخّرين في دفعاتنا

101
00:06:31,370 --> 00:06:32,870
علينا دفعها عمّ قريب

102
00:06:33,360 --> 00:06:38,000
،أجل، إذا لم نستطع الشحن
!فسنُجبر على الإطفاء

103
00:06:38,980 --> 00:06:40,910
تُجبرون على الإطفاء؟

104
00:06:40,910 --> 00:06:43,750
أجل، لأنّنا آندرويد

105
00:06:44,340 --> 00:06:46,250
لكنّ إيسولا بشريّ

106
00:06:50,550 --> 00:06:51,890
...أخي

107
00:06:52,690 --> 00:06:53,970
أمسكتُ به

108
00:06:54,570 --> 00:06:55,890
!آمن

109
00:06:55,890 --> 00:06:56,740
هاكِ

110
00:07:05,580 --> 00:07:06,820
لا تلمسها

111
00:07:07,690 --> 00:07:10,650
لا نريد علاقةً بكم أيّها الروبوتات

112
00:07:11,150 --> 00:07:12,410
اخرجوا من هنا

113
00:07:14,240 --> 00:07:15,160
كايت؟

114
00:07:15,160 --> 00:07:16,480
!فلتخرجوا

115
00:07:20,200 --> 00:07:22,170
كان كايت غاضباً جدّاً

116
00:07:22,610 --> 00:07:25,830
قال أنّه لا يريد علاقةً بالروبوتات

117
00:07:25,830 --> 00:07:26,840
لمَ ذلك؟

118
00:07:26,840 --> 00:07:29,400
يوجد أشخاصٌ هكذا

119
00:07:29,400 --> 00:07:31,020
لكنّ الأمر مُحزن

120
00:07:32,090 --> 00:07:33,040
!انتظروا

121
00:07:34,050 --> 00:07:35,780
ناغي-سان؟

122
00:07:35,780 --> 00:07:37,050
ما الخطب؟

123
00:07:37,780 --> 00:07:41,700
لديّ... ما أودّ... إخباركم به

124
00:07:44,630 --> 00:07:46,960
...لمَ آندرويد قد

125
00:07:46,960 --> 00:07:48,360
المعذرة

126
00:07:48,780 --> 00:07:51,760
أيمكن أنّك كايت-سان من "ستاند-آلون"؟

127
00:07:51,760 --> 00:07:52,840
من أنت؟

128
00:07:52,840 --> 00:07:54,270
سُررت بلقائك

129
00:07:54,270 --> 00:07:56,870
اسمي مادارامي كيريا

130
00:07:57,620 --> 00:07:59,860
أنا عضوٌ من مُنظّمة ناشطة

131
00:07:59,860 --> 00:08:03,040
تعمل لحماية مستقبل
وكرامة الجنس البشريّ

132
00:08:08,060 --> 00:08:10,340
ما الذي يريده حزب مُعارضي الروبوتات منّي؟

133
00:08:13,530 --> 00:08:15,220
أعتذر عمَّ حصل

134
00:08:15,880 --> 00:08:21,270
لعلّ الأمر انجلى لكم، لكنّ أخي يكره الآندرويد

135
00:08:23,240 --> 00:08:27,350
في الماضي، تعرّضنا لحادثٍ مروريّ

136
00:08:28,900 --> 00:08:31,990
اصطدمت سيّارة يقودها آندرويد بسيّارتنا

137
00:08:33,020 --> 00:08:35,530
...وأبي وأمّي قد

138
00:08:36,570 --> 00:08:39,310
!ناغي، أأنتِ بخير؟ ناغي؟

139
00:08:39,730 --> 00:08:40,760
...أوّلاً

140
00:08:41,630 --> 00:08:43,580
...السلامة أوّلاً

141
00:08:43,870 --> 00:08:47,060
...كـ-كلّ يوم، السلامة أ-أوّ

142
00:08:47,060 --> 00:08:49,170
...الـ-الـ... ر-راح... راح

143
00:08:50,930 --> 00:08:55,870
يبدو أنّك عانيت بشكلٍ كبير بعد
فقدانك لوالديك في الحادث

144
00:08:56,990 --> 00:08:59,740
تكاليف علاج أختك الطبّية عاليةٌ جدّاً

145
00:08:59,740 --> 00:09:02,520
سبب استمرارك بالأداء كمُتسلّق أعلى

146
00:09:02,520 --> 00:09:04,390
هو لمُساندة أختك، ألستُ مُحقّاً؟

147
00:09:04,800 --> 00:09:09,390
،توجد فواتير طبيّة لدفعها
لكنّي أصعد المسرح لأسبابي الخاصّة

148
00:09:09,390 --> 00:09:11,000
لا تسئ الفهم

149
00:09:11,000 --> 00:09:13,400
أعتذر إن بدا كلامي جارحاً

150
00:09:13,980 --> 00:09:20,660
آخر ما تريده مُنظّمتنا هو إضافة
المزيد من المعاناة لأشخاص مثلكم

151
00:09:21,820 --> 00:09:24,110
أردتُ تقديم نفسي فحسب اليوم

152
00:09:25,180 --> 00:09:27,830
سأعاود التواصل معك في وقتٍ لاحق

153
00:09:33,020 --> 00:09:37,220
بقائي في المُستشفى لحدّ الآن هو بسبب آثار الحادث

154
00:09:37,880 --> 00:09:42,470
لطالما اعتنى أخي بي

155
00:09:42,930 --> 00:09:47,460
ليس ذلك عذراً ليتفوّه
بأمور فظيعة لكم بالطبع

156
00:09:47,870 --> 00:09:49,480
أنا أعتذر بصدق

157
00:09:50,730 --> 00:09:51,980
...كلّ ما بالأمر

158
00:09:51,980 --> 00:09:55,850
أردتُكم أن تعرفوا أنّه لن يقول
أشياء كتلك بلا سبب

159
00:09:56,910 --> 00:09:59,990
لا بدّ أنّكِ تحبّين أخيكِ كثيراً

160
00:10:00,820 --> 00:10:01,820
أجل

161
00:10:05,060 --> 00:10:08,970
لديّ أمنيةٌ لطالما أردت تحقيقها

162
00:10:08,970 --> 00:10:10,170
أمنية؟

163
00:10:10,170 --> 00:10:14,440
يوماً ما، أودّ الذهاب لرؤية
عرضٍ حقيقيّ في بابل

164
00:10:15,150 --> 00:10:17,670
بأمّ عيني

165
00:10:18,460 --> 00:10:22,980
،إن تحسّنت حالتي بما يكفي لذلك
لن أعود عبئاً على أخي

166
00:10:23,430 --> 00:10:27,180
سيتمكّن من الوقوف على المسرح
الذي يحبّه بحريّةٍ أكثر

167
00:10:27,970 --> 00:10:32,400
لذا حلمتُ بالذهاب هناك يوماً ما

168
00:10:33,730 --> 00:10:36,860
!لنذهب إذاً! سنصطحبكِ معنا

169
00:10:38,180 --> 00:10:39,390
لا أستطيع

170
00:10:39,390 --> 00:10:40,450
ماذا؟

171
00:10:40,450 --> 00:10:41,900
،لطالما انتظرت

172
00:10:41,900 --> 00:10:45,840
لكن من الصعب إيجاد كلّ مُتبرّعي
الأعضاء التي أحتاجها

173
00:10:46,500 --> 00:10:51,340
لا أستطيع مغادرة المُستشفى ما لم
أمرّ ببضعة عمليات زرع

174
00:10:52,550 --> 00:10:56,670
لا أعتقد أنّ أمنيتي ستتحقّق أبداً

175
00:10:57,190 --> 00:10:58,630
...ناغي-سان

176
00:11:02,900 --> 00:11:06,950
،أنا آسفة، التقينا لتوّنا اليوم
وأنا أثقل عليكم بهذا الحديث

177
00:11:06,950 --> 00:11:08,640
من السهل الكلام معكم جميعاً

178
00:11:09,340 --> 00:11:12,900
لا تواجهين مشكلةً في كوننا
آندرويد يا ناغي؟

179
00:11:13,560 --> 00:11:16,440
كنتُ في المستشفى لفترةٍ طويلة بحيث

180
00:11:17,240 --> 00:11:21,500
أعرف أنّ الكثير من الآندرويد والروبوتات صالحين

181
00:11:22,830 --> 00:11:26,050
!بالتوفيق في مسرح تسلّقكم التالي

182
00:11:30,430 --> 00:11:33,380
أيعني ذلك أنّ ناغي
لا تستطيع الذهاب لبابل حقّاً؟

183
00:11:33,380 --> 00:11:36,250
قالت أنّ ليس بإمكانها مغادرة المستشفى

184
00:11:36,250 --> 00:11:38,180
ما لم تمرّ بعدّة عمليات زرع أعضاء

185
00:11:38,180 --> 00:11:41,840
!أعرف، لكنّي أود فعل شيءٍ لأجلها

186
00:11:42,230 --> 00:11:46,000
إن قمنا بشيء، ألن يتضايق كايت؟

187
00:11:46,000 --> 00:11:47,720
...ربما ذلك، لكن

188
00:11:48,160 --> 00:11:51,730
أعرف أنّك تودّ تحقيق أمنية
ناغي-سان يا كوبالت

189
00:11:52,360 --> 00:11:53,940
!إيسولا

190
00:11:54,270 --> 00:11:56,980
ليس كأنّنا نعارض ذلك

191
00:11:57,900 --> 00:12:02,320
علينا إيجاد طريقةٍ لإخراجها من المستشفى
دون إرهاق جسدها

192
00:12:02,320 --> 00:12:04,450
!رفاق

193
00:12:05,950 --> 00:12:07,830
...لا بدّ من وجود طريقة مناسبة

194
00:12:12,000 --> 00:12:13,290
!وجدتُها

195
00:12:13,720 --> 00:12:17,090
،إذا لم تستطع الذهاب لبابل
!فيمكن أن يأتي بابل لها

196
00:12:21,560 --> 00:12:23,730
أرسلتُ لكم طلب عمليّة

197
00:12:23,730 --> 00:12:27,100
!حسنٌ! لنتجهّز

198
00:12:27,100 --> 00:12:30,580
،بالفعل، إن قدّمنا عرضاً في المستشفى

199
00:12:30,580 --> 00:12:32,730
فلن يتعيّن عليها الخروج

200
00:12:32,730 --> 00:12:34,480
!إنّها فكرةٌ رائعة يا كوبالت

201
00:12:34,480 --> 00:12:35,440
أعرف، صحيح؟

202
00:12:35,440 --> 00:12:38,930
لكنّي مُندهش أنّك تمكّنت
من إيجاد هذه الغرفة

203
00:12:38,930 --> 00:12:41,780
أخبروني عند مكتب الاستعلامات عندما سألتهم

204
00:12:41,780 --> 00:12:44,090
،كانوا يستعملونها للمؤتمرات

205
00:12:44,090 --> 00:12:47,490
لكنّها بمثابة مخزنٍ الآن، فقالوا أنّ
لا بأس من استعمالها

206
00:12:49,680 --> 00:12:51,330
يوجد مجالٌ للتحسين

207
00:12:52,170 --> 00:12:53,910
لنقم بالتنظيف مبدئيّاً

208
00:12:54,810 --> 00:12:57,130
بالمناسبة، ماذا عن الموسيقى؟

209
00:12:57,130 --> 00:12:59,000
ربما أغنية جديدة؟

210
00:12:59,000 --> 00:13:01,000
هل نبحث عن شيءٍ مناسب؟

211
00:13:01,450 --> 00:13:03,680
شيء مختلف عن ذي قبل

212
00:13:03,680 --> 00:13:06,580
ما رأيكم بشيء مثل "بانغ! انفجار!"؟

213
00:13:05,510 --> 00:13:08,350
سأذهب لاستعارة أدوات تنظيف

214
00:13:06,580 --> 00:13:08,350
ذلك مُبهم جدّاً

215
00:13:10,490 --> 00:13:12,220
جميعهم مذهلون

216
00:13:13,770 --> 00:13:15,730
ليتني أستطيع فعل شيءٍ بدوري

217
00:13:17,050 --> 00:13:18,540
ماذا عن الموسيقى؟

218
00:13:21,500 --> 00:13:25,280
لمَ لا تجرّب تأليف الموسيقى
التي يبحثون عنها؟

219
00:13:25,280 --> 00:13:27,500
...حسناً... أنت

220
00:13:27,500 --> 00:13:28,870
اعذرني

221
00:13:29,220 --> 00:13:33,370
،كنتُ أشاهدكم قبلاً
ولم أستطع منع نفسي

222
00:13:34,640 --> 00:13:36,870
لا حاجة للحذر

223
00:13:37,250 --> 00:13:42,890
،يمكنك صنع الموسيقى لهم
المبادرة بالعمل هي العامل المهمّ

224
00:13:42,890 --> 00:13:44,010
ماذا؟

225
00:13:44,360 --> 00:13:48,720
وأنا متأكّدٌ أنّك تعرف كيفيّة ذلك سلفاً

226
00:13:54,590 --> 00:13:55,830
...أأنت

227
00:13:56,660 --> 00:13:57,660
ماذا؟

228
00:13:59,550 --> 00:14:02,670
!إيسولا! اسمع

229
00:14:02,670 --> 00:14:04,610
!يتكلّم نيون بترهات

230
00:14:05,040 --> 00:14:08,290
علينا استبدال ورق الحوائط أوّلاً

231
00:14:08,290 --> 00:14:10,030
ثمّ نعيد تصميم الغرفة بأسرها

232
00:14:10,030 --> 00:14:11,320
رأيت؟

233
00:14:11,320 --> 00:14:14,210
من أين سنجلب المال لذلك؟

234
00:14:12,960 --> 00:14:14,210
إيسولا؟

235
00:14:14,210 --> 00:14:16,600
كما أنّنا لا نملك إذن فعل ذلك

236
00:14:14,780 --> 00:14:17,330
أتساءل ما إن كان بإمكاني صنعها

237
00:14:18,660 --> 00:14:19,670
صنع ماذا؟

238
00:14:20,040 --> 00:14:21,250
ورق الحائط؟

239
00:14:21,990 --> 00:14:22,880
الموسيقى

240
00:14:24,860 --> 00:14:26,220
الموسيقى؟

241
00:14:26,220 --> 00:14:27,300
أنت يا إيسولا؟

242
00:14:28,120 --> 00:14:30,930
آ-آسف! كانت محض فكرة سخيفة

243
00:14:31,490 --> 00:14:35,880
ذلك مستحيل، صحيح؟ لم يسبق وأن
درستُ تأليف الأغاني وما شابه

244
00:14:36,710 --> 00:14:40,130
كنتُ أحاول التفكير بطريقةٍ لمساعدتكم فحسب

245
00:14:40,130 --> 00:14:41,650
!ذلك رائع

246
00:14:41,650 --> 00:14:43,320
!أغنيتك

247
00:14:43,320 --> 00:14:46,380
في تلك المرّة، جعلتَ كافّة
دوائري تشعر بتنعّم

248
00:14:46,380 --> 00:14:48,920
تلك المرّة؟ تقصد أثناء الصيانة؟

249
00:14:49,570 --> 00:14:50,950
حقّاً ذلك؟

250
00:14:50,950 --> 00:14:56,600
أجل، فلتألّف أغنيةً لنا من فضلك يا إيسولا

251
00:14:59,040 --> 00:15:01,020
أريد المحاولة

252
00:15:01,570 --> 00:15:02,990
!دعوني أجرّب رجاءً

253
00:15:05,990 --> 00:15:07,400
أسمعتِ؟

254
00:15:08,150 --> 00:15:12,060
"ستقدّم مجموعة التسلّق "نوكس
!عرضاً في المستشفى

255
00:15:12,710 --> 00:15:14,180
ذلك ما سمعته

256
00:15:14,180 --> 00:15:15,390
ستذهبين، صحيح؟

257
00:15:16,210 --> 00:15:17,350
!لنذهب

258
00:15:17,350 --> 00:15:20,350
أعرف أنّكِ تريدين رؤية
عرض لبابل في الواقع، أليس كذلك؟

259
00:15:20,350 --> 00:15:24,220
"كما أعرف أنّكِ تشاهدين بثّ "ستاند-آلون
!المُباشر سرّاً أيضاً

260
00:15:24,220 --> 00:15:26,960
!صه! لا تقوليها بصوتٍ مُرتفع

261
00:15:33,140 --> 00:15:35,340
هذا ما تستعمله لتأليف الأغنية؟

262
00:15:35,340 --> 00:15:40,540
أجل، خطر لي أنّه قد يكون
مثل ما أفعله دوماً

263
00:15:41,080 --> 00:15:43,010
تقصد أداء الصيانة، صحيح؟

264
00:15:43,010 --> 00:15:43,920
أجل

265
00:15:43,920 --> 00:15:48,660
لم أتصوّر أن أقوم بتأليف
الموسيقى من قبل أبداً

266
00:15:48,920 --> 00:15:52,840
لكنّ الأمر أكثر تسليةً مما ظننت

267
00:15:55,840 --> 00:15:57,460
التالي هو تزيين المسرح

268
00:15:58,080 --> 00:16:00,980
لا أريد أن نهدر أغنية إيسولا

269
00:16:03,700 --> 00:16:07,440
...كنتُ أتساءل، لكن هذا القماش

270
00:16:09,070 --> 00:16:10,570
!إنّها ستائرنا

271
00:16:11,380 --> 00:16:13,120
أخذتُها كلّها

272
00:16:13,120 --> 00:16:15,070
سأعلّقها على الحائط وراء المسرح

273
00:16:15,440 --> 00:16:18,890
معايير نيون مضبوطةٌ
،نحو حسّ فنّي

274
00:16:18,890 --> 00:16:20,950
لذا يركّز كثيراً على الجماليّات

275
00:16:21,320 --> 00:16:25,020
لهذا يعمل جاهداً لتحسين القاعة

276
00:16:27,610 --> 00:16:28,590
نورا؟

277
00:16:30,230 --> 00:16:31,380
ما هذا؟

278
00:16:32,100 --> 00:16:34,150
!صحيح! نسيتُ ذلك

279
00:16:34,150 --> 00:16:34,880
ماذا؟

280
00:16:34,880 --> 00:16:38,640
قد نستطيع استعماله لعرضكم

281
00:16:39,230 --> 00:16:40,360
هذا؟

282
00:16:56,340 --> 00:17:00,200
!"مرحباً جميعاً! نحن"نوكس

283
00:17:00,200 --> 00:17:01,950
فلتستمعوا اليوم، اتّفقنا؟

284
00:17:05,540 --> 00:17:06,930
!ناغي

285
00:17:06,930 --> 00:17:08,590
!شكراً على قدومك

286
00:17:10,250 --> 00:17:13,740
نأمل أن تتطلّعوا للموسيقى اليوم

287
00:17:13,740 --> 00:17:15,440
!مؤلّفها هو إيسولا

288
00:17:15,440 --> 00:17:16,180
إيسولا؟

289
00:17:16,180 --> 00:17:17,210
من يكون؟

290
00:17:17,210 --> 00:17:18,400
...رفاق

291
00:17:19,700 --> 00:17:22,260
عملنا نحن الخمسة بجدٍّ
لتجهيز هذا العرض لكم

292
00:17:22,260 --> 00:17:23,480
!لنبدأ

293
00:17:32,380 --> 00:17:35,200
يُعطي جوّاً شبيهاً ببابل على الأقلّ

294
00:18:00,010 --> 00:18:01,680
ماذا؟ ما هذا؟

295
00:18:00,010 --> 00:18:02,810
!حسناً، ها نحن ذا

296
00:18:02,810 --> 00:18:04,040
!كأنّه عرضٌ في بابل

297
00:18:04,040 --> 00:18:04,560
...هذا

298
00:18:04,560 --> 00:18:06,310
كيف يوجد فيديو؟

299
00:19:17,100 --> 00:19:19,430
...هذا بابل

300
00:19:28,430 --> 00:19:29,310
ناغي؟

301
00:19:30,170 --> 00:19:31,480
...أخي

302
00:19:32,590 --> 00:19:36,520
يوماً ما، سآتي لرؤية عرضٍ في بابل

303
00:19:37,130 --> 00:19:39,240
سأفعل حتماً

304
00:19:56,880 --> 00:19:59,510
!كان ذلك مذهلاً حقّاً يا رفاق

305
00:19:59,970 --> 00:20:01,330
شكراً لكِ

306
00:20:01,330 --> 00:20:04,180
،فلتحقّقي أمنيتكِ مهما حصل
حسناً يا ناغي؟

307
00:20:05,300 --> 00:20:08,170
،عندما رأيتُكِ بين الحضور قبل قليل

308
00:20:08,170 --> 00:20:13,240
،أردتُ أن تري عرضاً حقيقيّاً في بابل بشدّة
!فغمرني شعورٌ هنا

309
00:20:13,240 --> 00:20:15,400
أعتقد أنّ بعض حماسكِ انتقل لنا

310
00:20:16,010 --> 00:20:20,400
أيمكن أنّ هذا ما يُدعى بالتمنّي؟

311
00:20:20,400 --> 00:20:22,560
عليكِ الذهاب لبابل

312
00:20:24,010 --> 00:20:25,360
...يا رفاق

313
00:20:26,350 --> 00:20:30,760
أجل، أعد بأن أتحسّن وأذهب لبابل

314
00:20:30,760 --> 00:20:33,870
أودّ رؤية أداء أخي بأمّ عيني أيضاً

315
00:20:35,900 --> 00:20:38,020
...مجموعة آلات مُقلّدة للبشر

316
00:20:38,790 --> 00:20:41,250
أخبرتكم بالابتعاد عنّا

317
00:20:41,250 --> 00:20:44,630
!أخي! استمتعتُ كثيراً اليوم

318
00:20:44,630 --> 00:20:47,890
عرضٌ حقيقيّ في بابل
ليس شيئاً كذاك

319
00:20:48,960 --> 00:20:52,220
،لحظة صعودنا نحن المُتسلّقون على المسرح

320
00:20:52,220 --> 00:20:55,740
نكرّس كافّة أذهاننا وأرواحنا
لاستقطاب قلوب الجمهور

321
00:20:56,700 --> 00:20:59,520
لكنّكم لا تستطيعون فهم ذلك

322
00:21:00,300 --> 00:21:02,020
أتعرفون لمَ؟

323
00:21:02,630 --> 00:21:05,410
لأنّ الآندرويد لا يمتلكون قلوباً

324
00:21:06,410 --> 00:21:07,820
قلوب؟

325
00:21:09,300 --> 00:21:12,580
وبالنسبة لك، عليك اختيار
من تقدّم موسيقاك له

326
00:21:13,730 --> 00:21:16,000
لا تهدر الموهبة التي وُهِبت إيّاها

327
00:21:18,050 --> 00:21:19,490
...مهلاً، أخي

328
00:21:20,280 --> 00:21:21,790
!انتظر

329
00:21:22,650 --> 00:21:24,970
!شكراً لكم جميعاً

330
00:21:25,900 --> 00:21:28,200
سأراكم على المسرح في بابل، حسناً؟

331
00:21:32,460 --> 00:21:34,820
...أخي، كان عليك عدم التفوّه

332
00:21:34,820 --> 00:21:36,180
مستحيل

333
00:21:38,810 --> 00:21:45,070
كيف يمكن أن يحرّك أداءٌ من قِبل
آندرويد عديمي القلب أفئدة الناس هكذا؟

334
00:22:01,220 --> 00:22:08,060
لمَ يمتلك آندرويد عاديّون حمايةً صارمة لبرمجتهم هكذا؟

335
00:22:15,490 --> 00:22:16,480
...أيمكن أنّ هذا