1
00:00:02,500 --> 00:00:04,150
.عيون ذهبيّة

2
00:00:10,650 --> 00:00:11,530
!أزو

3
00:00:20,320 --> 00:00:21,370
...سِت

4
00:00:22,090 --> 00:00:23,870
!سِت

5
00:00:22,370 --> 00:00:23,870
.نادتني نينا

6
00:00:26,060 --> 00:00:28,880
!نينا! أنا مسرورة لأنّك بخير

7
00:00:29,590 --> 00:00:33,630
.لولا نينا، لكنتِ الآن عشاء ذلك المخلوق

8
00:00:35,910 --> 00:00:36,530
.خذي

9
00:00:37,910 --> 00:00:40,140
.ماء؟ شكرًا لك

10
00:00:40,530 --> 00:00:41,820
.لنتحرّك

11
00:00:41,820 --> 00:00:44,140
.عثرتُ على مكان هناك حيث يمكننا أن نرتاح

12
00:00:44,140 --> 00:00:46,830
ماذا؟ لكن ماذا عن البقيّة؟

13
00:00:46,830 --> 00:00:48,540
.تركتُ علامات

14
00:00:48,910 --> 00:00:51,280
.سيصلون عند الصّباح

15
00:00:51,990 --> 00:00:56,270
الصّباح؟ سنكون وحدنا حتّى ذلك الحين؟

16
00:02:28,240 --> 00:02:30,750
هل تعتقدين أنّ الأميرة أليشا بخير؟

17
00:02:31,010 --> 00:02:33,960
.قالوا أنّها ليست في العربة

18
00:02:34,660 --> 00:02:36,380
.لا بدّ أنّها خرجت منها

19
00:02:37,260 --> 00:02:42,140
،أتمنّى لو أستطيع الذّهاب للبحث عنها
.لكنّي لا أستطيع ذلك بصفتي وصيفة

20
00:02:43,020 --> 00:02:48,800
.عليّ فقط أن أثق في تلك النّجمة المحظوظة

21
00:02:51,180 --> 00:02:51,650
!أنت سريع

22
00:02:51,870 --> 00:02:55,900
،لم ينظر للخلف أبدًا
!لكنّي لم أشعر بالإحباط

23
00:02:55,900 --> 00:02:57,950
.حتّى أنّه بإمكاني تحمّل الألم

24
00:02:58,660 --> 00:03:01,050
.إنّ عدم كوني وحيدة أمر مذهل

25
00:03:10,820 --> 00:03:12,290
.لا تجلسي قربي

26
00:03:12,530 --> 00:03:13,720
.نعم، نعم

27
00:03:13,720 --> 00:03:14,920
.اتركي الماء

28
00:03:14,920 --> 00:03:16,670
.تبًّا لك، تبًّا لك

29
00:03:21,010 --> 00:03:23,540
.سِت. سِت

30
00:03:23,540 --> 00:03:24,180
نينا؟

31
00:03:30,290 --> 00:03:33,060
!لا تقم بتكتكة لسانك هكذا
!دعني ألقي نظرة

32
00:03:33,060 --> 00:03:34,060
!لا تقتربي

33
00:03:35,170 --> 00:03:36,690
هل تأذّيت؟

34
00:03:37,550 --> 00:03:38,980
أحدث ذلك حينها؟

35
00:03:39,190 --> 00:03:41,960
.بالكاد يمكن وصفه بالجرح

36
00:03:41,960 --> 00:03:43,700
.إنّه لا يؤلمني حتّى

37
00:03:44,030 --> 00:03:46,420
.إنّ الجروح من الحيوانات البرّيّة خطيرة

38
00:03:46,420 --> 00:03:48,800
.بإمكانها قتل النّاس

39
00:03:49,510 --> 00:03:53,960
غبيّة. لم أقم بأفعال جيّدة بما
.يكفي بعد لأموت هكذا

40
00:03:54,410 --> 00:03:57,000
.لا أزال أخسر معركتي ضدّ الإله

41
00:04:00,230 --> 00:04:02,970
.سأرتاح بعض الشّيء

42
00:04:03,220 --> 00:04:05,670
.ابتعدي عنّي

43
00:04:05,670 --> 00:04:06,470
سِت؟

44
00:04:07,290 --> 00:04:11,250
ما كان إله العالم السّفليّ
.أن يأتي حتّى وإن طلبتُ ذلك

45
00:04:11,250 --> 00:04:13,470
!سِت! سِت

46
00:04:14,410 --> 00:04:15,570
.أشعر بالحرارة

47
00:04:16,030 --> 00:04:17,690
.ذلك غير ممكن

48
00:04:19,070 --> 00:04:21,580
.لطالما كان الجوّ باردًا هنا

49
00:04:22,520 --> 00:04:23,490
.لنصلِّ

50
00:04:24,140 --> 00:04:26,490
...واثق أنّ الإله سيسامحك

51
00:04:27,180 --> 00:04:30,140
.على هذه الجريمة ودماؤك

52
00:04:31,000 --> 00:04:32,500
.الصّلوات اليوميّة

53
00:04:33,180 --> 00:04:35,580
.استُدعيتْ سيّدتي ميجي للسّماء

54
00:04:36,080 --> 00:04:40,500
.لا بأس. سأحميك من العائلة الملكيّة

55
00:04:41,320 --> 00:04:43,640
.الحبّ والإعجاب في تلك الأيّام

56
00:04:44,560 --> 00:04:48,140
مذهل. تعلّمت هذا سلفًا؟

57
00:04:48,540 --> 00:04:51,140
.التّطهير والولادة من جديد

58
00:04:51,690 --> 00:04:55,900
علينا تصفية دماء الملك
.الشّرّير من داخلك

59
00:04:56,690 --> 00:04:59,050
.هذا لأجل سلامتك

60
00:04:59,820 --> 00:05:01,270
...وبعد عمليّة الفصد

61
00:05:02,140 --> 00:05:05,710
.لنصلِّ للإله الآن

62
00:05:09,250 --> 00:05:10,780
!شاهدوا

63
00:05:10,780 --> 00:05:15,040
!أنا أضحّي بنفسي لراهبة الإله النّقيّة ميجي

64
00:05:15,930 --> 00:05:18,420
!هذا هو حبّي

65
00:05:23,560 --> 00:05:25,060
.لقد استيقظت

66
00:05:25,800 --> 00:05:28,550
.أصبتَ بالحمّى. حاول ألاّ تتحرّك

67
00:05:29,560 --> 00:05:30,960
.كنتَ تئنّ أثناء نومك

68
00:05:33,080 --> 00:05:34,020
...حلم

69
00:05:39,950 --> 00:05:41,150
ما الّذي تفعلينه؟

70
00:05:41,520 --> 00:05:43,630
ألا يبدو هذا مريحًا وباردًا؟

71
00:05:44,020 --> 00:05:47,770
اعتدتُ القيام بهذا لطفل مريض

72
00:05:48,670 --> 00:05:52,310
.لتنتقل نصف حرارته إلى يدي

73
00:05:53,980 --> 00:05:56,180
.أنت راهبة إله بالفعل

74
00:05:56,180 --> 00:05:57,960
.لطفك أجوف

75
00:06:01,260 --> 00:06:03,590
.كفّ عن ذكرك للإله في كلّ وقت

76
00:06:02,980 --> 00:06:03,590
...يا لك من

77
00:06:03,590 --> 00:06:05,670
.لا يهمّ إن كنتُ راهبة أم لا

78
00:06:05,670 --> 00:06:07,930
أنت لا تفهم على الإطلاق، صحيح؟

79
00:06:08,300 --> 00:06:09,990
.هذا طبيعيّ جدًّا أيضًا

80
00:06:11,280 --> 00:06:12,810
هل تشعر بالبرد؟

81
00:06:12,810 --> 00:06:16,950
،إنّ ملابسك تحت معطفك جافّة
.لكنّ قدميك مبلّلتان

82
00:06:17,380 --> 00:06:19,940
.يبرد الجوّ كثيرًا في اللّيل

83
00:06:19,940 --> 00:06:25,190
هنالك طرق أفضل للتّخفيف
.من البرد أيّتها الخادمة

84
00:06:25,620 --> 00:06:27,690
."كلاّ. قصدتُ "أيّتها الملكة

85
00:06:30,700 --> 00:06:31,580
.قضم

86
00:06:41,750 --> 00:06:43,710
.تستحقّ هذا أيّها الغبيّ

87
00:06:43,930 --> 00:06:47,170
!لا معنى لهذا بدون الحبّ

88
00:06:47,170 --> 00:06:48,030
!إنّه غائط

89
00:06:48,970 --> 00:06:50,180
غائط؟

90
00:06:50,180 --> 00:06:51,220
.غائط

91
00:06:51,650 --> 00:06:54,080
.تتصرّف كالأطفال

92
00:06:54,080 --> 00:06:58,230
هل تعتقدين أنّك في موضع يسمح لك بالشّكوى؟

93
00:06:58,570 --> 00:07:02,750
.الحبّ هو أكثر شيء متطّفل في هذا العالم

94
00:07:03,170 --> 00:07:06,370
.الحبّ لعنة. التّعلّق ضغينة

95
00:07:06,980 --> 00:07:11,260
.إنّ كلّ شيء غير الألم والموت كذبة

96
00:07:13,010 --> 00:07:15,540
.ذلك لأنّك وحيد

97
00:07:15,540 --> 00:07:18,750
.لأنّك لا تفهم ما يعنيه أن تكون مميّزًا

98
00:07:19,270 --> 00:07:22,150
لماذا لا تحاول التّظاهر أنّي أروق لك؟

99
00:07:24,150 --> 00:07:25,750
لماذا قد أفعل ذلك؟

100
00:07:25,750 --> 00:07:29,410
.إنّ كلّ ما تقوله خاطئ

101
00:07:29,410 --> 00:07:31,570
.الطّريقة الوحيدة لإثبات ذلك هي أن تجرّب

102
00:07:33,020 --> 00:07:35,140
عمّ تتحدّث؟

103
00:07:35,390 --> 00:07:38,790
،إن فشلتُ في إثبات أنّك مخطئ
.فسأقبل بالهزيمة

104
00:07:38,790 --> 00:07:42,270
لذلك حاول التّظاهر أنّك تهتمّ
.لأمري كما تهتمّ لأمر نينا

105
00:07:44,490 --> 00:07:45,700
ماذا؟

106
00:07:46,010 --> 00:07:48,280
.ثمّة شيء ما هناك

107
00:07:50,170 --> 00:07:53,500
أهي المزيد من تلك المخلوقات؟

108
00:07:53,500 --> 00:07:57,870
لا. ليس من المرجّح أن يتواجد
.الكثير منها في هذه المنطقة

109
00:07:58,290 --> 00:08:01,130
.على الأرجح أنّه شيء أصغر

110
00:08:01,130 --> 00:08:03,440
—إنّه ليس شيئًا خطيرًا. سوف

111
00:08:03,440 --> 00:08:04,920
.لا تتحرّك

112
00:08:04,920 --> 00:08:06,720
.سألقي أنا نظرة

113
00:08:06,720 --> 00:08:08,300
.ذلك ليس ضروريًّا

114
00:08:09,270 --> 00:08:13,480
.ماذا؟ لا يوجد شيء هنا

115
00:08:13,870 --> 00:08:16,230
.ربّما كانت نينا مخطئة

116
00:08:20,790 --> 00:08:25,600
...أهذا الجحر لذلك المخلوق

117
00:08:30,430 --> 00:08:34,960
.كانت أمًّا

118
00:08:35,890 --> 00:08:38,490
.لماذا أحضرته إلى هنا؟ أعيديه

119
00:08:38,490 --> 00:08:42,060
.لكنّه صغير جدًّا للنّجاة وحده

120
00:08:42,710 --> 00:08:44,520
.أريد إنقاذه

121
00:08:44,520 --> 00:08:47,280
!غبيّة! سيكبر وسيصير مثل أمّه

122
00:08:48,620 --> 00:08:52,460
أيمكنك استعمال قواك الملكيّة للقيام باستثناء؟

123
00:08:53,100 --> 00:08:55,970
.قُدّر لذلك الشّيء أن يموت

124
00:08:56,440 --> 00:08:58,350
.لا تقل ذلك

125
00:08:58,350 --> 00:09:01,060
.لا يتعلّق الأمر بأيّ نجم وُلد تحتها

126
00:09:01,060 --> 00:09:03,060
.لا أريد أن تقرّر الآلهة في هذا الأمر

127
00:09:03,060 --> 00:09:04,630
ألست راهبة؟

128
00:09:05,380 --> 00:09:07,760
.حتّى الرّاهبات تعرف

129
00:09:07,760 --> 00:09:12,480
.ربّما تراقبنا الآلهة، لكنّها لن تساعد أبدًا

130
00:09:13,220 --> 00:09:14,490
.لا أفهم

131
00:09:15,200 --> 00:09:19,640
،تبدو وكأنّها ستنكسر في أيّ لحظة
.ولكن لا يوجد ولو شرخ واحد فيها

132
00:09:20,840 --> 00:09:23,020
.إنّها نزيهة ولكنّها فظّة

133
00:09:23,500 --> 00:09:25,700
.إنّه أمر آخر غير الطّيبة البسيطة

134
00:09:27,160 --> 00:09:31,310
لماذا تنجذب عيناي لشيء عليّ كسره؟

135
00:09:32,410 --> 00:09:35,010
.سأستدعي شخصًا ذا معرفة بالرّعاية به

136
00:09:35,010 --> 00:09:36,310
...تعني

137
00:09:36,310 --> 00:09:39,140
.حصلتُ على نينا تحت ظروف مماثلة

138
00:09:39,490 --> 00:09:43,140
.هذا رائع. سنكون سعيدين معًا

139
00:09:44,930 --> 00:09:49,440
لذلك حاول التّظاهر أنّك تهتمّ
.لأمري كما تهتمّ لأمر نينا

140
00:09:50,550 --> 00:09:53,260
.من الآن فصاعدًا، سأناديك نينا

141
00:09:53,260 --> 00:09:54,150
ماذا؟

142
00:09:54,790 --> 00:09:55,730
.نينا

143
00:09:56,650 --> 00:09:58,250
!لا تنادني نينا كطائرك

144
00:09:59,170 --> 00:10:02,190
.قصدتُ اسم طفولتك نينا

145
00:10:03,020 --> 00:10:07,830
عاد إليّ اسمي في هذا المكان
.حيث لا يعرفني أيّ أحد

146
00:10:10,430 --> 00:10:11,770
.إنّه الفجر

147
00:10:13,060 --> 00:10:16,820
.سأسمّيك نيفاريا، تيمّنا بالفجر

148
00:10:18,080 --> 00:10:21,540
.ستشرق الشّمس دائمًا بكلّ تأكيد

149
00:10:26,490 --> 00:10:27,450
.لقد وصلوا

150
00:10:28,540 --> 00:10:30,440
!أيّها الأمير سِت

151
00:10:30,440 --> 00:10:31,940
.أتوا لأجلنا

152
00:10:32,160 --> 00:10:34,600
.مهلاً، لا تقف

153
00:10:35,290 --> 00:10:36,690
.أنا بخير الآن

154
00:10:37,330 --> 00:10:41,820
.لا يريد أن يراه الجنود ضعيفًا

155
00:10:42,220 --> 00:10:45,920
.يمكنك الاتّكاء عليّ إن اعتقدت أنّك ستسقط

156
00:10:45,920 --> 00:10:46,840
ماذا؟

157
00:10:46,840 --> 00:10:49,560
.لن أخبر أيّ أحد أنّك فقدت وعيك

158
00:10:51,350 --> 00:10:56,520
هل تتطلّب منه مكانته أن يخفي ضعفه؟

159
00:10:57,780 --> 00:11:01,550
،إنّهما مختلفان عن بعضهما كثيرًا
.لكنّه يشبه أزو قليلاً

160
00:11:02,080 --> 00:11:04,850
.ومع ذلك، إنّهما مختلفان بالكامل

161
00:11:06,310 --> 00:11:09,060
.ربّما سأتظاهر أنّه يروق لي قليلاً أيضًا

162
00:11:09,520 --> 00:11:11,190
.ولكن ليس بقدر أزو بالطّبع

163
00:11:11,920 --> 00:11:15,810
.لا يستطيع أحد أخذ مكان أزو
.آمل أن يسامحني على ذلك

164
00:11:16,600 --> 00:11:20,860
.بمجرّد خروجنا من هنا، سنصل إلى غالغادا

165
00:11:21,560 --> 00:11:24,580
.سأصير ملكة هذا الرّجل

166
00:11:26,720 --> 00:11:30,000
.كان الشّمال أرضًا فقيرة

167
00:11:30,420 --> 00:11:32,340
،وقبل أربعة أجيال

168
00:11:32,340 --> 00:11:36,990
أخبر مبعوث من الإلهِ الملكَ
.بأن يسافر إلى جنّة الأحلام

169
00:11:37,650 --> 00:11:40,010
.تطلّب بناء قوّات البلاد جيلاً واحدًا

170
00:11:40,010 --> 00:11:43,260
وجيلين للاستحواذ على البلدان
.المجاورة كمناطق تابعة لها

171
00:11:43,650 --> 00:11:48,470
صارت الآن بلادًا خصبة تُعرف
،بشكل كبير بقوّتها

172
00:11:48,470 --> 00:11:50,290
.تحلم حلمًا لا نهاية له

173
00:11:50,870 --> 00:11:54,510
بلاد غالغادا العظيمة
.الّتي تحكم خمسة مناطق

174
00:11:59,340 --> 00:12:00,820
ما الأمر يا نينا؟

175
00:12:01,240 --> 00:12:03,850
.لا تنادني بذلك أمام الآخرين

176
00:12:03,850 --> 00:12:06,830
لكنّه اسم طفولتك، صحيح؟
ما المشكلة في ذلك؟

177
00:12:07,210 --> 00:12:10,570
.يعتقد سِت أنّ نينا هو اسم طفولة أليشا

178
00:12:10,890 --> 00:12:13,830
.لكن لا أعتقد أنّ لفورتنا نفس هذا العُرف

179
00:12:14,050 --> 00:12:17,340
.مرحبًا بعودتك أيّها الأمير سِت

180
00:12:17,760 --> 00:12:20,840
هذا مذهل! أهكذا يُستقبل أمير بلاد قويّة؟

181
00:12:20,840 --> 00:12:25,340
.يا إلهي، أشمّ رائحة عفنة

182
00:12:26,080 --> 00:12:28,290
.إذًا فلا تزال حيًّا

183
00:12:29,600 --> 00:12:33,160
.إنّك رجل محظوظ فعلاً يا أخي

184
00:12:33,730 --> 00:12:36,540
.من الجيّد رؤيتك ثانية يا أخي

185
00:12:37,700 --> 00:12:39,480
إخوة سِت؟

186
00:12:39,710 --> 00:12:42,740
!أخفضي رأسك يا امرأة! يا للفظاظة

187
00:12:43,920 --> 00:12:45,490
!أنا آسفة

188
00:12:46,770 --> 00:12:48,560
.ليس عليك أن تخفضي رأسك يا أميرة

189
00:12:48,560 --> 00:12:50,490
.استرخِ يا يور

190
00:12:50,870 --> 00:12:54,860
.أخبرَنا الملك أن نرحّب بأمير فورتنا

191
00:12:55,220 --> 00:12:59,490
.إنّ لون عينيك الأزرق الغامق جميل يا أميرة

192
00:13:00,230 --> 00:13:01,510
.عجبًا، عجبًا

193
00:13:02,590 --> 00:13:04,260
أهذه فرصتي لأروق لهم؟

194
00:13:04,670 --> 00:13:07,310
.أنا أليشا سث فورتنا

195
00:13:07,850 --> 00:13:11,900
.سررت كثيرًا بلقاء إخوة الأمير سِت

196
00:13:12,490 --> 00:13:16,410
،لم أرَ عينين زرقاوين مثلهما من قبل

197
00:13:16,410 --> 00:13:19,270
.لكنّ الزّواج من راهبة جريمة

198
00:13:19,270 --> 00:13:22,680
ألا يعتبر هذا ازدراءً؟
كيف تتولّى ذلك الأمر؟

199
00:13:22,680 --> 00:13:24,520
—فقبل كلّ شيء، كانت أمّك أيضًا

200
00:13:24,520 --> 00:13:26,490
هل قلتُ أنّ بإمكانك الحديث معي؟

201
00:13:27,890 --> 00:13:30,940
.سألتك إن قلتُ أنّ بإمكانك الحديث معي

202
00:13:30,940 --> 00:13:33,540
.إنّ رأسك فارغ كالعادة

203
00:13:33,920 --> 00:13:35,040
من تظنّ نفسك؟

204
00:13:35,040 --> 00:13:38,330
تعتقد أنّك أعلى شأنًا منّا
،لأنّك تتقدّمنا في تسلسل الخلافة

205
00:13:38,330 --> 00:13:40,920
.لكنّك لستَ الملك بعد

206
00:13:42,030 --> 00:13:44,920
ما خطب هذا الجوّ المحموم؟

207
00:13:45,260 --> 00:13:48,150
،لماذا لا تسرع وتنضمّ للأموات

208
00:13:48,150 --> 00:13:49,930
.أيّها الشّقيّ المترعرع في معبد الدّم

209
00:13:50,520 --> 00:13:52,830
.أرى أنّك لا تزال تحبّ الحديث كثيرًا

210
00:13:52,830 --> 00:13:56,560
.إنّ ابن المحظيّة المتملّقة يحبّ النّباح

211
00:13:56,560 --> 00:13:58,060
!كيف تجرؤ؟

212
00:13:58,540 --> 00:14:02,320
،إن كنت ترغب في النّزال
.فعليك تجهيز نعش أوّلاً أيّها النّكرة

213
00:14:04,820 --> 00:14:08,200
!مهلاً! لا تصعّدوا الوضع أكثر

214
00:14:08,480 --> 00:14:10,320
ألا ترونا أنّكم تزعجون الجميع هنا؟

215
00:14:10,320 --> 00:14:13,080
.من المفترض أنّكم أمراء
.انتبهوا أكثر لمحيطكم

216
00:14:13,710 --> 00:14:16,740
.وأنت تماديتَ كثيرًا بإهاناتك

217
00:14:20,470 --> 00:14:21,840
.أيّتها الأميرة أليشا

218
00:14:24,840 --> 00:14:28,140
.لديّ أخ صغير مشاكس في فورتنا

219
00:14:28,140 --> 00:14:30,130
!هذا فظيع يا أختي

220
00:14:33,760 --> 00:14:35,910
.أفسدت الأمر

221
00:14:36,630 --> 00:14:42,620
إنّ خطّتي لجعلي أروق لعائلته
...وأن أصير الملكة

222
00:14:44,810 --> 00:14:48,110
.ما باليد حيلة، ما حدث قد حدث

223
00:14:48,380 --> 00:14:50,020
.يمكنني المحاولة ثانية فحسب

224
00:14:50,020 --> 00:14:53,350
.أعتقد أنّي صرتُ أقرب لسِت أيضًا

225
00:14:53,710 --> 00:14:56,500
.سأصير الملكة وأحمي فورتنا

226
00:14:56,500 --> 00:14:58,120
.إنّها الطّريقة الوحيدة

227
00:14:59,860 --> 00:15:02,780
...أيّتها الأميرة أليشا، بخصوص غرفتك

228
00:15:02,780 --> 00:15:05,550
.ستتشاركين غرفة النّوم مع الأمير سِت

229
00:15:05,550 --> 00:15:06,890
.سِت

230
00:15:06,890 --> 00:15:08,660
.يمكنك الذّهاب إلى هناك اللّيلة

231
00:15:12,430 --> 00:15:14,890
ليس لدينا سريران منفصلان؟

232
00:15:15,310 --> 00:15:17,430
.لا، سأنظر للأمر بشكل مختلف

233
00:15:17,430 --> 00:15:19,890
.هذه فرصتي

234
00:15:20,440 --> 00:15:21,940
لماذا أنت هنا؟

235
00:15:26,880 --> 00:15:28,620
...سِـ-سِت

236
00:15:30,800 --> 00:15:32,700
.لا تعلّميها كلمات غريبة

237
00:15:32,700 --> 00:15:37,160
.لديّ هذا لأعتني به، لذلك سأنام على الأرض

238
00:15:37,650 --> 00:15:41,150
.ليالي غالغادا باردة
.لا يمكنك النّوم على الأرض

239
00:15:41,150 --> 00:15:45,050
أم كنتِ تأملين أن يحدث شيء ما؟

240
00:15:45,420 --> 00:15:47,670
.طبعًا لا

241
00:15:47,670 --> 00:15:52,180
آسف على تخييب ظنّك، لكنّي
.لستُ في مزاج جيّد لذلك اللّيلة

242
00:15:58,110 --> 00:15:59,660
.اسمع

243
00:16:00,300 --> 00:16:04,690
.آسفة على ما قلتُه أمام إخوتك اليوم

244
00:16:05,660 --> 00:16:08,340
،كنتِ لتدفعي ثمن ذلك بحياتك في العادة

245
00:16:08,890 --> 00:16:11,320
.لكنّي غيّرتُ رأيي عندما رأيت وجهك الغبيّ

246
00:16:11,740 --> 00:16:17,100
.إنّهم إخوتي، لكنّنا لسنا إخوة أشقّاء

247
00:16:17,690 --> 00:16:22,210
ليسوا إخوة أشقّاء؟
.أي أنّ لديهم أمّهات مختلفات

248
00:16:22,980 --> 00:16:26,640
.كُنتُ لأسعد بامتلاك الكثير من الإخوة

249
00:16:26,640 --> 00:16:28,210
حتّى إن كانوا إخوة مثلهم؟

250
00:16:28,820 --> 00:16:33,480
،عندما يموت والداك ولا يكون لديك أيّ إخوة

251
00:16:33,480 --> 00:16:35,220
.فسيكون عليك توديعهما بنفسك

252
00:16:35,810 --> 00:16:40,470
.أعتقد أنّ ذلك سيكون حزينًا ووحيدًا وصعبًا

253
00:16:40,880 --> 00:16:42,510
.لم أشعر بتلك الطّريقة من قبل

254
00:16:43,100 --> 00:16:47,730
،كنتُ وحيدًا عندما ماتت
.لكنّي لم أشعر بأيّ شيء محدّد

255
00:16:47,990 --> 00:16:50,610
ماتت والدته؟

256
00:16:50,950 --> 00:16:55,360
.ربّما لم تشعر بأيّ شيء لأنّك كنت حزينًا جدًّا

257
00:16:56,010 --> 00:16:57,810
وما هو الحزن؟

258
00:16:57,810 --> 00:16:59,990
.لم أختبر ذلك الشّعور من قبل

259
00:17:00,460 --> 00:17:03,740
.إنّه وحيد. السّبب هو لأنّه وحيد

260
00:17:03,740 --> 00:17:05,800
...إن كان وحيدًا دائمًا

261
00:17:07,680 --> 00:17:12,320
أيعقل أنّك لم تكبر في هذه القلعة يا سِت؟

262
00:17:12,840 --> 00:17:15,880
هل تعيش منفصلاً عن الملك وإخوتك؟

263
00:17:17,660 --> 00:17:20,140
.فهمت. هكذا هو الحال إذًا

264
00:17:20,530 --> 00:17:21,970
.لم أقل أيّ شيء

265
00:17:21,970 --> 00:17:24,410
.نعم، نعم. فهمت

266
00:17:24,410 --> 00:17:24,890
—ما

267
00:17:27,560 --> 00:17:28,840
.لا بأس

268
00:17:31,800 --> 00:17:32,810
ماذا تقصدين؟

269
00:17:32,810 --> 00:17:34,850
ماذا؟ ماذا أقصد؟

270
00:17:34,850 --> 00:17:38,020
لحظة... كلّ شيء؟

271
00:17:38,020 --> 00:17:38,780
كلّ شيء؟

272
00:17:39,290 --> 00:17:42,410
.ستتعلّم الكثير بدءًا من الآن

273
00:17:43,220 --> 00:17:44,410
.لا فكرة لديّ ما الّذي تقصدينه

274
00:17:47,620 --> 00:17:51,890
.أنا متوتّرة جدًّا ولا أستطيع النّوم في مكان جديد

275
00:17:57,830 --> 00:17:59,570
متوتّرة ولا تستطيع النّوم؟

276
00:18:00,040 --> 00:18:02,970
.ليس لديها ذرّة من التّوتّر أو الحذر

277
00:18:03,350 --> 00:18:05,300
...أزو

278
00:18:12,440 --> 00:18:14,480
.تنفّس منتظم

279
00:18:15,210 --> 00:18:16,070
.الجسد الدّافئ

280
00:18:17,280 --> 00:18:18,830
.وجود كائنات حيّة أخرى

281
00:18:19,830 --> 00:18:24,870
أنا أنام إلى جانب شخص بدون
.أيّ أهداف أو نوايا

282
00:18:26,230 --> 00:18:27,250
.هذا غريب

283
00:18:28,150 --> 00:18:32,700
.لا يفترض أن تكون ليالي غالغادا بهذا الدّفء

284
00:18:47,980 --> 00:18:51,520
كيف حدث هذا؟

285
00:18:53,260 --> 00:18:55,020
.لا يمكنني النّهوض

286
00:18:57,530 --> 00:18:59,420
.رموشه برّاقة

287
00:19:00,130 --> 00:19:00,920
.يا له من لون أحمر

288
00:19:02,690 --> 00:19:03,810
.إنّه قريب

289
00:19:04,730 --> 00:19:07,520
كيف حدث هذا؟

290
00:19:07,900 --> 00:19:09,790
.لقد اقتربت منّي أثناء نومك

291
00:19:09,790 --> 00:19:12,930
...ماذا؟ لكن من الواضح أنّك

292
00:19:12,930 --> 00:19:14,290
!مهلاً، مهلاً، مهلاً

293
00:19:14,290 --> 00:19:16,620
!أتركني

294
00:19:18,250 --> 00:19:19,300
.تركتك

295
00:19:25,310 --> 00:19:28,310
.نعم، نعم. وقت الفطور

296
00:19:29,050 --> 00:19:30,800
ما كان ذلك للتّوّ؟

297
00:19:31,230 --> 00:19:35,980
.بدا مختلفًا عن السّابق بعض الشّيء

298
00:19:36,440 --> 00:19:40,450
.بدت عيناه وكأنّهما تبتسمان قليلاً

299
00:19:45,860 --> 00:19:46,840
.ألبسيني

300
00:19:46,840 --> 00:19:47,360
ماذا؟

301
00:19:47,360 --> 00:19:48,700
.إنّه عمل وصيفة

302
00:19:48,700 --> 00:19:51,210
—ماذا؟ قم بذلك بنفـ

303
00:19:52,610 --> 00:19:54,710
.أعتقد أنّ ذلك طبيعيّ لأمير

304
00:19:55,590 --> 00:19:56,580
!ماذا؟

305
00:19:56,580 --> 00:19:57,710
.أسرعي

306
00:19:59,480 --> 00:20:03,470
حسنًا! عليّ القيام بهذا فحسب، صحيح؟

307
00:20:04,850 --> 00:20:06,230
.انتهيت

308
00:20:06,230 --> 00:20:07,700
ما هذا؟

309
00:20:09,180 --> 00:20:12,960
حسنًا يا سِت، كيف الأوضاع مع أميرة فورتنا؟

310
00:20:14,240 --> 00:20:19,890
،أخطّط لاستعمالها لغزو فورتنا
.لذلك لم أقم بأيّ شيء معها بعد

311
00:20:22,090 --> 00:20:23,990
.ليس مع تلك الأميرة بالتّحديد

312
00:20:24,340 --> 00:20:27,650
إذًا فأنت عازم على استعمال القوّة معهم؟

313
00:20:27,650 --> 00:20:30,400
.إنّك تملك القوّة اللاّزمة لذلك بالفعل

314
00:20:30,400 --> 00:20:32,500
.يفتقر بقيّة الأمراء لذلك

315
00:20:32,960 --> 00:20:37,710
إنّ الاستيلاء على فورتنا كان أمنيتنا
.منذ جيل جدّكم الأكبر

316
00:20:37,710 --> 00:20:40,870
.أودّ فعلاً تحقيق ذلك تحت حكمي

317
00:20:41,810 --> 00:20:44,600
إنّ ذلك الأحمق غير مناسب
.ليكون ملكًا على الإطلاق

318
00:20:45,060 --> 00:20:49,590
وتلك الأميرة ذات الدّماء الملكيّة
.كانت راهبة نجميّة، رمز فورتنا

319
00:20:49,990 --> 00:20:52,070
.لدينا كلّ الأفضليّة هنا

320
00:20:52,640 --> 00:20:54,520
.ثمّة أكثر من طريقة واحدة

321
00:20:55,470 --> 00:20:56,520
.اتّخذت قراري

322
00:20:56,520 --> 00:20:59,590
.سألغي تسلسل الخلافة الحاليّ

323
00:20:59,940 --> 00:21:04,590
.سيكون العرش من نصيب أيّ أحد يغزو فورتنا

324
00:21:05,530 --> 00:21:09,130
.حسنًا، كم هذا مثير للاهتمام

325
00:21:09,130 --> 00:21:11,340
.كنتُ أنتظر أمرًا كهذا منذ مدّة

326
00:21:11,340 --> 00:21:12,790
.أيّها الأمير بيدو

327
00:21:13,380 --> 00:21:16,040
.لن أدع سِت أو بيدو يهزمانني

328
00:21:16,710 --> 00:21:20,030
سأصير الملك. سأقوم بكلّ
.ما يتطلبه الأمر لذلك

329
00:21:20,340 --> 00:21:23,740
أيُمكن استعمال طفل أميرة فورتنا للغزو؟

330
00:21:24,250 --> 00:21:25,300
،بتعبير آخر

331
00:21:26,230 --> 00:21:31,820
،إنّ من سيحصل على أميرة فورتنا
.سيصير الملك التّالي لغالغادا

332
00:21:48,330 --> 00:21:51,330
.وبالتّالي، تمّ تمرير العهد

333
00:21:51,790 --> 00:21:57,600
تحت رعاية إله النّجوم الّذي يحكم
،مصير شعب فورتنا ويرشده

334
00:21:59,020 --> 00:22:03,720
.سيكون أزور سث فورتنا الملك الجديد لفورتنا

335
00:23:36,020 --> 00:23:38,800
".اللّيلة الثّامنة: ذكريات دماء"