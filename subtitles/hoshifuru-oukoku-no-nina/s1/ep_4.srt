1
00:00:02,980 --> 00:00:07,480
أرسلت غالغادا هذه الأغراض لك
.استعدادًا للزّواج

2
00:00:08,460 --> 00:00:09,860
.إنّه طائر

3
00:00:10,250 --> 00:00:12,490
.مذهل، يا له من صندوق

4
00:00:13,180 --> 00:00:16,310
.قطع شاتار؟ إنّها تبدو باهظة

5
00:00:16,310 --> 00:00:19,480
.هذا رائع أيّتها الأميرة أليشا

6
00:00:20,660 --> 00:00:23,470
.إنّك بتدين كعروس

7
00:00:24,370 --> 00:00:27,300
.لا تلمسن أيًّا من الهدايا بعد

8
00:00:27,300 --> 00:00:28,880
.الأمير أزور

9
00:00:28,880 --> 00:00:31,510
.قد نضطرّ لإعادتها

10
00:00:36,820 --> 00:00:37,850
...ذلك

11
00:00:39,710 --> 00:00:41,770
.لم يكن حلمًا

12
00:00:44,440 --> 00:00:46,230
.هذا لا يناسبك

13
00:00:47,480 --> 00:00:49,110
!أنا أعلم ذلك

14
00:00:49,420 --> 00:00:51,700
.لا ترتدي ملابس غالغادا هذه

15
00:00:51,700 --> 00:00:52,540
ماذا؟

16
00:00:54,330 --> 00:00:55,860
.لأنّك أهديتني السّوار المضفّر

17
00:00:56,190 --> 00:01:00,370
.الأزرق يليق بك. تبدين ظريفة

18
00:01:00,370 --> 00:01:03,370
ظريفة؟

19
00:01:03,590 --> 00:01:07,090
...شـ-شكرًا

20
00:01:09,410 --> 00:01:11,500
لماذا أنت مرتبكة جدًّا يا نينا؟

21
00:01:12,510 --> 00:01:15,120
لا تنادني بذلك عندما يكون
!هنالك أشخاص حولنا

22
00:01:15,120 --> 00:01:16,850
.لكن لا يوجد أيّ أحد هنا الآن

23
00:01:16,850 --> 00:01:19,530
!أبلغني قبل استعماله فحسب

24
00:01:22,670 --> 00:01:27,560
سأرسل مبعوثًا إلى غالغادا
.للتّفاوض بشأن حلّ خطبتك

25
00:01:27,560 --> 00:01:28,020
ماذا؟

26
00:01:28,740 --> 00:01:31,350
.اعتقدتُ أنّ ذلك لم يكن ممكنًا

27
00:01:31,350 --> 00:01:33,280
.ولا يزال كذلك، لكنّي سأحاول رغم ذلك

28
00:01:33,640 --> 00:01:36,900
.عليك البقاء هنا. للأبد

29
00:01:38,460 --> 00:01:41,030
ليس عليّ أن أتزوّج؟

30
00:01:42,230 --> 00:01:44,480
أستطيع البقاء مع أزو للأبد؟

31
00:01:44,890 --> 00:01:48,040
.سأكون سعيدة جدًّا إن حدث ذلك

32
00:03:22,660 --> 00:03:25,720
.ما زالت هنالك مشكلة واحدة لم تُحلّ

33
00:03:25,720 --> 00:03:28,200
.لا يجب لمس ذلك

34
00:03:28,200 --> 00:03:30,230
.هذه الهدايا للملك

35
00:03:30,450 --> 00:03:36,730
.ما زلنا نجهل من يحاول قتل أزو. أنا قلقة

36
00:03:36,730 --> 00:03:40,530
.بإمكان أليشا حماية أزور

37
00:03:40,780 --> 00:03:43,860
!لا يمكنني اكتشاف الأمر

38
00:03:43,860 --> 00:03:48,120
لكنّي إن كنتُ الوحيدة الّتي بإمكانها
.ذلك، سيكون عليّ بذل جهدي فحسب

39
00:03:48,560 --> 00:03:51,240
.سمعتُ أنّه قد وصلتك هدايا رائعة

40
00:03:51,240 --> 00:03:53,570
.ماذا؟ تبدين مضطربة

41
00:03:53,570 --> 00:03:55,750
.لا يناسبك التّفكير يا أختي

42
00:03:55,750 --> 00:03:57,430
ما معنى ذلك؟

43
00:03:57,430 --> 00:03:59,880
!توقّفي رجاءً يا أختي

44
00:03:59,880 --> 00:04:02,180
ما الهدايا الّتي تلقّيتها؟

45
00:04:03,090 --> 00:04:05,740
.أثواب وحليّ وطائر

46
00:04:05,740 --> 00:04:06,860
!طائر؟

47
00:04:06,860 --> 00:04:11,180
إضافة إلى مجموعة شاتار باهظة
.الثّمن مصنوعة من الجواهر

48
00:04:11,180 --> 00:04:13,520
مجموعة شاتار من الجواهر؟
.أودّ رؤية ذلك

49
00:04:13,520 --> 00:04:16,270
هل اعتقدوا أنّ ذلك سيُعجبني؟

50
00:04:17,900 --> 00:04:20,080
.يا لك من فتاة ساذجة لا مبالية

51
00:04:20,080 --> 00:04:23,900
ألا تدركين أنّك ستتزوّجين
مقابل تلك الهدايا؟

52
00:04:24,370 --> 00:04:25,410
!أمّاه

53
00:04:25,730 --> 00:04:28,410
أكانت تلك نميمة مهمّة للغاية؟

54
00:04:29,890 --> 00:04:31,870
.سأكون في الخارج

55
00:04:33,490 --> 00:04:35,790
حسنًا، ما الّذي أردتِ مناقشته؟

56
00:04:36,210 --> 00:04:38,280
.سأدخل الموضوع مباشرة

57
00:04:38,280 --> 00:04:42,420
ما الّذي تحاولين فعله لأزور؟

58
00:04:42,770 --> 00:04:46,300
.لقد طرقتُ مسمارًا كان بارزًا فحسب

59
00:04:46,660 --> 00:04:52,810
،عندما يصير موهولوم ملكًا
ألن يكون أزور مفيدًا كمستشار له؟

60
00:04:54,960 --> 00:04:57,440
.واثقة أنّه سيكون كذلك. لا مجال الشّكّ

61
00:04:57,440 --> 00:04:59,450
ماذا؟ فعلاً؟

62
00:04:59,450 --> 00:05:02,660
.إنّ وجوده إلى جانب موهولوم سيفيده كثيرًا

63
00:05:02,660 --> 00:05:05,050
.إنّه بحاجة إليه بكلّ تأكيد

64
00:05:05,050 --> 00:05:09,450
أنا أذكّره فحسب بألاّ يسمح
.لأيّ أفكار غريبة أن تخطر عليه

65
00:05:09,680 --> 00:05:14,580
.ثمّ لن يقترح أيّ أحد أن يصير ملكًا

66
00:05:14,850 --> 00:05:18,130
.إذًا فهي لا تعتقد فعلاً أنّه مصدر إزعاج

67
00:05:18,130 --> 00:05:19,710
.لا يبدو أنّها تكذب أيضًا

68
00:05:19,710 --> 00:05:25,290
.ثمّة رجل بعينين مرفوعتين وظهر منحنٍ

69
00:05:26,430 --> 00:05:29,880
.لم أره منذ مهرجان النّجوم

70
00:05:30,470 --> 00:05:32,040
كيف ستكون ردّة فعلها؟

71
00:05:32,660 --> 00:05:35,320
.يبدو أنّك تصفين اللّورد بولغ

72
00:05:35,320 --> 00:05:37,480
.لم أره منذ ذلك الوقت أيضًا

73
00:05:37,780 --> 00:05:41,730
.ما كنت لأتعامل معه رغم لقبه

74
00:05:41,730 --> 00:05:43,980
...ماذا؟ إذًا

75
00:05:43,980 --> 00:05:46,910
.ذلك الرّجل واحد من كلاب الملك

76
00:05:52,740 --> 00:05:56,250
.لا داعي لهذه الرّسميّة يا أليشا

77
00:05:56,650 --> 00:06:01,250
بالنّسبة لسؤالك، لقد اختفى
.بينما كان يبحث في أمر ما

78
00:06:02,390 --> 00:06:04,250
هل تعرفين أيّ شيء عن الأمر؟

79
00:06:04,510 --> 00:06:06,840
.لا، لا شيء

80
00:06:07,240 --> 00:06:11,010
على الأرجح أنّ الملك هو الشّخص
.الّذي يحاول التّخلّص من أزو

81
00:06:11,320 --> 00:06:14,820
.لا يوجد ما يمكننا فعله إن كان الملك

82
00:06:15,460 --> 00:06:18,040
.سمعتُ أنّك ذهبت لرؤية جدّي

83
00:06:18,040 --> 00:06:19,770
لماذا فعلتِ ذلك؟

84
00:06:20,320 --> 00:06:24,270
.ويشكّ الملك أنّي مزيّفة

85
00:06:24,270 --> 00:06:26,990
.لن أعرف ما لم تخبريني

86
00:06:26,990 --> 00:06:29,660
.ليس عليك إخفاء الأسرار عن والدك

87
00:06:30,010 --> 00:06:31,300
.اهدئي

88
00:06:31,300 --> 00:06:35,290
.إن كان يسأل، فلا بدّ أنّه غير واثق بعد

89
00:06:35,520 --> 00:06:40,020
حسنًا. سأخبرك بسرّ بدوري
.لتشجيعك على إخباري أيضًا

90
00:06:40,020 --> 00:06:44,830
في الحقيقة، إنّ أزور هو بديل للأمير
.الحقيقيّ الّذي مات عندما كان صبيًّا

91
00:06:45,700 --> 00:06:47,670
هل يجدر به قول ذلك لي؟

92
00:06:48,530 --> 00:06:52,290
.كانت احتفالات عيد مولدي وشيكة

93
00:06:52,290 --> 00:06:54,680
.كنتُ في مزاج جيّد

94
00:06:55,370 --> 00:06:56,180
!أبتاه

95
00:06:58,680 --> 00:07:01,190
ما الّذي تعتقد أنّك فاعل؟
!إنّ يديك متّسختان

96
00:07:04,920 --> 00:07:06,670
...أزور

97
00:07:06,670 --> 00:07:08,690
.لم تكن غلطتي

98
00:07:08,690 --> 00:07:11,200
.كان الفتى غير محظوظ فحسب

99
00:07:11,610 --> 00:07:13,400
.سنحتفظ بهذا الأمر سرًّا

100
00:07:13,400 --> 00:07:15,700
.أحضروا لي طفلاً ليأخذ مكانه

101
00:07:15,700 --> 00:07:18,110
.هذا مشؤوم للغاية

102
00:07:18,110 --> 00:07:20,150
.إنّ احتفالات عيد مولدي وشيكة

103
00:07:20,150 --> 00:07:23,640
لم يمت أزور، أليس كذلك؟

104
00:07:24,960 --> 00:07:26,960
كيف لك أن تكون بهذه الحماقة؟

105
00:07:27,210 --> 00:07:30,840
.إن كنتُ أحمقًا، فكلّ شيء حماقة

106
00:07:31,380 --> 00:07:33,850
.إذًا فالملك هو الفاعل

107
00:07:33,850 --> 00:07:36,600
.ليس ذلك فحسب، ولكن لسبب سخيف أيضًا

108
00:07:36,600 --> 00:07:40,200
.إنّك تنظرين إليّ بنفس نظرات الجميع

109
00:07:40,200 --> 00:07:43,380
الأطفال مجرّد أشخاص يتشاركون
.نفس دماء والديهم فحسب

110
00:07:43,380 --> 00:07:45,230
.ما هم إلاّ بيادق للمملكة

111
00:07:45,230 --> 00:07:46,490
...بيادق

112
00:07:47,390 --> 00:07:50,860
ألهذا السّبب تحاول التّخلّص من أزور؟

113
00:07:51,160 --> 00:07:54,870
.أرى أنّك سريعة البديهة
...ممّا يعني

114
00:07:55,120 --> 00:07:58,030
!لا يملك أزور أيّ نيّة لخيانتك

115
00:07:58,030 --> 00:08:00,750
!إنّه يريد دعم هذه البلاد فحسب

116
00:08:00,750 --> 00:08:02,410
.أعلم

117
00:08:02,410 --> 00:08:07,470
إنّ الاحتفاظ بأزور قريبًا منك
!سيجعل حياتك أسهل بكثير

118
00:08:07,470 --> 00:08:09,130
.أعلم ذلك

119
00:08:09,130 --> 00:08:10,760
لماذا إذًا؟

120
00:08:11,130 --> 00:08:12,760
.لأنّي أكرهه

121
00:08:13,020 --> 00:08:13,800
ماذا؟

122
00:08:13,800 --> 00:08:16,260
،رغم افتقاره للدّماء الملكيّة

123
00:08:16,260 --> 00:08:20,120
إلاّ أنّه يهتمّ لهذه البلاد
.ويكرّس نفسه لخدمتها بلا أيّ أنانيّة

124
00:08:20,120 --> 00:08:22,770
.إنّه مثاليّ جدًّا، وذلك يُريبني كثيرًا

125
00:08:23,010 --> 00:08:25,070
.لكنّ الجميع يثقون به

126
00:08:25,070 --> 00:08:27,650
.حتّى جدّي يُثني عليه كثيرًا

127
00:08:28,040 --> 00:08:32,650
لماذا يجب أن تتمّ مقارنتي
.بمزيّف مثله؟ أنا الملك

128
00:08:32,900 --> 00:08:35,010
.يضايقني ذلك كثيرًا

129
00:08:35,010 --> 00:08:37,660
.على البيدق أن يظلّ بيدقًا

130
00:08:38,310 --> 00:08:40,660
.هذه البلاد هي رقعة لعبي

131
00:08:41,050 --> 00:08:43,060
.أنا من عليه حكمها

132
00:08:43,060 --> 00:08:45,420
.لا يجب أن أقارَن ببيدق

133
00:08:45,420 --> 00:08:47,960
.هذا الرّجل يلعب لعبة فحسب

134
00:08:47,960 --> 00:08:50,920
.لا يهتمّ إلاّ بمتعته، ويقتل بدافع الحقد

135
00:08:51,380 --> 00:08:54,420
.والآن، أريد أن أسمع منك التّالي

136
00:08:55,330 --> 00:08:59,600
".أنا مزيّفة أتى بها أزور إلى هنا"

137
00:08:59,600 --> 00:09:01,430
.هذا كلّ ما في الأمر

138
00:09:01,430 --> 00:09:05,670
.أخبريني أنّك فعلتِ شيئًا أحمقًا

139
00:09:05,670 --> 00:09:07,190
ماذا أفعل؟

140
00:09:07,480 --> 00:09:11,440
.إنّ أليشا هي الّتي تتحكّم بمصير فورتنا...

141
00:09:11,440 --> 00:09:15,500
ماذا يمكنني— ماذا يمكن لأليشا فعله؟

142
00:09:16,990 --> 00:09:19,950
.عليك البقاء هنا. للأبد

143
00:09:20,320 --> 00:09:22,060
.أريد البقاء معه

144
00:09:22,060 --> 00:09:22,950
.نينا

145
00:09:24,060 --> 00:09:25,960
.أريده أن يناديني نينا للأبد

146
00:09:27,930 --> 00:09:32,760
.لكن لا أستطيع أن أكون معه
.لا أريد فقدانه

147
00:09:33,970 --> 00:09:37,220
.سأصير أليشا

148
00:09:38,980 --> 00:09:41,100
.يبدو أنّك مرتبك

149
00:09:41,340 --> 00:09:45,100
.أنا هي أليشا بشحمها ولحمها

150
00:09:45,600 --> 00:09:49,650
.إن كنت تشكّ في ذلك، فتفضّل وقم بفحصي

151
00:09:51,070 --> 00:09:53,610
هل تسرّع اللّورد بولغ في استنتاجاته؟

152
00:09:53,610 --> 00:09:58,010
.أقسم بإلهة النّجوم أنّني أليشا

153
00:09:58,010 --> 00:10:00,490
.سأكذب على الآلهة

154
00:10:01,680 --> 00:10:03,410
.لا بأس إن كان الحال هكذا

155
00:10:03,410 --> 00:10:06,000
.انتهت محادثتنا. يمكنك المغادرة

156
00:10:06,000 --> 00:10:08,930
.ستعاقبني الآلهة بكلّ تأكيد
.لكنّي لا أمانع ذلك

157
00:10:09,470 --> 00:10:11,750
.سأذهب إلى غالغادا للزّواج

158
00:10:12,040 --> 00:10:18,100
.سأصير ملكتهم والدّرع الّذي يحمي فورتنا

159
00:10:18,530 --> 00:10:20,620
.كم هذا مطمئن

160
00:10:20,620 --> 00:10:24,770
.ولكنّي سأحمي فورتنا مع أزور فحسب

161
00:10:25,290 --> 00:10:27,630
.سأستمع للنّجوم

162
00:10:27,630 --> 00:10:30,740
.تستطيع عيناي رؤية نهاية العالم

163
00:10:31,280 --> 00:10:35,780
،إن مات أزور تحت أيّ ظروف مريبة

164
00:10:36,450 --> 00:10:40,830
فسأقود غالغادا لتصير السّيف
.الّذي يدمّر فورتنا

165
00:10:41,280 --> 00:10:45,720
!ماذا؟ هذه خيانة ضدّ الملك

166
00:10:45,720 --> 00:10:48,290
،قد تكونين طفلة
!لكنّك لن تفلتين من هذا بدون عقاب

167
00:10:48,980 --> 00:10:53,080
إن متّ، فلن تكون لديك
.أيّ وسيلة لصدّ غالغادا

168
00:10:53,420 --> 00:10:57,550
إنّك بلا حول ولا قوّة الآن
.كما كنت دائمًا

169
00:10:58,970 --> 00:11:03,430
استمتع بأيّامك وأنت تلعب بمجموعة
.الشّاتار الّتي بعتني مقابلها

170
00:11:03,930 --> 00:11:06,240
.سأحمي بقيّة سنواتك

171
00:11:07,300 --> 00:11:09,080
.سأصير أليشا

172
00:11:09,630 --> 00:11:13,790
سأذهب إلى غالغادا للزّواج
.وسأصير ملكتها في النّهاية

173
00:11:14,380 --> 00:11:17,810
.وحدي قادرة على ذلك
.أنا واثقة من قدرتي على ذلك

174
00:11:19,180 --> 00:11:19,950
!أزو

175
00:11:20,780 --> 00:11:23,920
.سأحمي هذا الرّجل وحرّيّته

176
00:11:26,960 --> 00:11:28,700
.خذي أيّ شيء تريدين

177
00:11:28,700 --> 00:11:31,460
.سمعتُ أنّك كنت توّاقة للدّراسة مؤخّرًا

178
00:11:31,460 --> 00:11:33,810
.لا أصدّق أنّي في غرفة أزو ثانية

179
00:11:33,810 --> 00:11:38,060
على الأرجح أنّ هذه ليست معلومات
.عليك معرفتها، لكن لا ضرر من المعرفة

180
00:11:38,060 --> 00:11:39,670
.لديّ كتب بها صور أيضًا

181
00:11:41,750 --> 00:11:45,280
كم هي جميلة. ما هذا المخلوق؟

182
00:11:45,280 --> 00:11:47,720
ماذا؟ ماذا كُتب هنا؟

183
00:11:48,060 --> 00:11:50,820
.هذا الكتاب من بلاد في الغرب

184
00:11:50,820 --> 00:11:52,760
.لغتهم مختلفة قليلاً

185
00:11:53,960 --> 00:11:56,340
.يبدو صوته سلسًا جدًّا في أذناي

186
00:11:56,340 --> 00:11:58,520
.يُسمّى هذا الحيوان بالجمل

187
00:11:58,850 --> 00:12:00,630
.أتمنّى لو أستطيع الاستماع له للأبد

188
00:12:01,930 --> 00:12:02,740
.نينا

189
00:12:03,210 --> 00:12:05,360
.أرسلتُ مبعوثًا إلى غالغادا

190
00:12:05,360 --> 00:12:08,240
.اقترحتُ تأجيل زواجك بهدف توفير الوقت

191
00:12:08,570 --> 00:12:10,040
.أعدك أن أقوم بشيء ما

192
00:12:10,520 --> 00:12:12,210
.لا داعي للقلق. انتظري فحسب

193
00:12:12,700 --> 00:12:16,710
.أزو، لن يصل ذلك المبعوث إلى غالغادا

194
00:12:16,960 --> 00:12:18,900
.أتيتُ إليك سرًّا

195
00:12:18,900 --> 00:12:23,090
يعتقد الملك السّابق
.أنّه ربّما هنالك ما تطلبينه منّي

196
00:12:23,520 --> 00:12:26,340
.كان كلّ شيء واضحًا لجدّه الأكبر

197
00:12:26,340 --> 00:12:28,620
.عرف ما الإجابة الّتي كنت لأقدّمها

198
00:12:29,980 --> 00:12:32,360
...عرف أنّه بهدف حماية أزو من الملك

199
00:12:32,360 --> 00:12:34,770
،ولحماية فورتنا من غالغادا

200
00:12:35,330 --> 00:12:39,230
...عليّ مغادرة هذه البلاد بدون إخبار أزو

201
00:12:39,970 --> 00:12:41,510
.وألاّ أراه ثانية

202
00:12:41,510 --> 00:12:42,350
ما الخطب؟

203
00:12:42,350 --> 00:12:45,060
كنتُ أفكّر فحسب في أنّك تملك
.الكثير من الأشياء الأجنبيّة

204
00:12:45,060 --> 00:12:46,990
.لا بدّ أنّك تدرس كثيرًا

205
00:12:46,990 --> 00:12:50,780
.نصفها للدّراسة، ونصفها الآخر للمتعة

206
00:12:50,780 --> 00:12:53,250
.أشعر وكأنّي أسافر. أستمتع بذلك كثيرًا

207
00:12:54,070 --> 00:12:56,720
.هذه أوّل مرّة أكتشف فيها شيئًا يحبّه

208
00:12:56,720 --> 00:12:58,270
.أريد معرفة المزيد

209
00:12:58,910 --> 00:13:03,690
.عفوًا، أريد أخذ استراحة
هل يمكنني ذلك؟

210
00:13:04,160 --> 00:13:06,960
.أودّ الذّهاب للبلدة. معًا

211
00:13:07,590 --> 00:13:11,640
سأرشدك في شوارعها. أريدك
.أن تعرف المكان الّذي عشتُ فيه

212
00:13:12,570 --> 00:13:15,590
!أرجوك، أرجوك، أرجوك

213
00:13:13,750 --> 00:13:18,620
.لا أهتمّ ما قد تكون
.أريد تشكيل ذكريات معه فحسب

214
00:13:19,790 --> 00:13:22,400
!إنّه السّوق! يُشعرني هذا بالحنين

215
00:13:22,400 --> 00:13:25,880
.أخفي عينيك. نحنا هنا متخفّيين

216
00:13:25,880 --> 00:13:28,310
.لكنّه يعترضني

217
00:13:28,310 --> 00:13:29,910
!انظر، انظر

218
00:13:29,910 --> 00:13:31,910
!إنّها لذيذة جدًّا

219
00:13:32,620 --> 00:13:35,070
.اعتدتُ سرقة هذه طوال الوقت

220
00:13:36,300 --> 00:13:37,540
.اثنتان لو سمحت

221
00:13:37,540 --> 00:13:38,490
.في الحال

222
00:13:39,220 --> 00:13:40,290
.احتفظ بالباقي

223
00:13:42,050 --> 00:13:45,050
!أيّها الشّابّ، إنّها قطعة ذهبيّة

224
00:13:45,050 --> 00:13:46,800
.دفعتُ له ما يدين به لك

225
00:13:47,280 --> 00:13:48,160
...نعم

226
00:13:50,520 --> 00:13:53,060
أيّها الشّابّ، ما رأيك بشيء لحبيبتك؟

227
00:13:53,060 --> 00:13:56,950
ما-ما الّذي يقصده بحبيبة؟
أليس كذلك؟

228
00:14:00,060 --> 00:14:02,440
!إنّه لا ينكر ذلك؟

229
00:14:02,440 --> 00:14:04,280
!فعلاً؟

230
00:14:04,280 --> 00:14:05,440
ماذا؟

231
00:14:06,080 --> 00:14:07,760
.لا تفعل ذلك

232
00:14:08,160 --> 00:14:09,950
.من هنا بسرعة

233
00:14:09,950 --> 00:14:13,030
.لا يمكننا. سوف ننفصل في النّهاية

234
00:14:15,040 --> 00:14:15,960
!يدانا

235
00:14:16,220 --> 00:14:18,240
.سيكون عليّ ترك يده

236
00:14:19,450 --> 00:14:21,350
...ولكن الآن

237
00:14:21,960 --> 00:14:23,000
!إنّه ساخن

238
00:14:23,440 --> 00:14:24,710
.لديك لسان حسّاس كالأطفال

239
00:14:24,710 --> 00:14:27,490
هذا طبيعيّ. من كان ليأكل
شيئًا ساخنًا هكذا؟

240
00:14:27,490 --> 00:14:29,220
.وجدتُ نقطة ضعف

241
00:14:29,790 --> 00:14:31,700
.ربّما بإمكاننا ذلك في الوقت الحاليّ

242
00:14:32,200 --> 00:14:33,700
اسمي الحقيقي؟

243
00:14:33,700 --> 00:14:36,290
.نعم، قبل أن تصير الأمير

244
00:14:37,440 --> 00:14:41,220
.أنا لا أذكر. لم يطلعني به أيّ أحد

245
00:14:41,220 --> 00:14:44,110
.لطالما كنتُ أزور فحسب

246
00:14:44,440 --> 00:14:45,840
فعلاً؟

247
00:14:46,250 --> 00:14:48,120
لماذا تريدين أن تعرفي؟

248
00:14:48,120 --> 00:14:50,180
.لا سبب معيّن

249
00:14:50,180 --> 00:14:53,120
لا أريد إخباره أنّي أريد اسمًا
.مميّزًا لأناديه به

250
00:14:53,120 --> 00:14:58,620
بالتّفكير في الأمر، أنت الوحيدة
.الّتي تناديني أزو يا نينا

251
00:14:59,970 --> 00:15:02,720
.ليس من العدل إخباري بذلك هكذا

252
00:15:03,060 --> 00:15:06,280
أشعر وكأنّه قد تسنّى لي رؤية
.عدّة جوانب من أزو اليوم

253
00:15:07,530 --> 00:15:08,870
.علينا العودة الآن

254
00:15:09,230 --> 00:15:10,010
.مهلاً

255
00:15:10,010 --> 00:15:11,690
.بقي مكان واحد فقط

256
00:15:14,020 --> 00:15:18,120
.يرقد الفتى الّذي كان كأخ أصغر لي هنا

257
00:15:18,690 --> 00:15:24,170
لقد مرض، لكنّنا لم نكن نملك
.المال لأخذه لطبيب، فمات

258
00:15:25,350 --> 00:15:28,120
.قال أنّ تلك هي النّجمة الّتي وُلد تحتها

259
00:15:28,120 --> 00:15:30,410
.أكره عندما يقول النّاس ذلك

260
00:15:30,970 --> 00:15:33,500
.فورتنا بلاد ثريّة

261
00:15:33,500 --> 00:15:36,690
يجدر بنا القيام بما هو أكثر
.من هذا للتّقليل من الفقر

262
00:15:37,170 --> 00:15:38,540
.هنالك طريقة للقيام بذلك

263
00:15:39,290 --> 00:15:43,120
العينان الذّهبيّتان اللّتان رأيتهما
...عندما باعني ساجي

264
00:15:43,570 --> 00:15:47,210
لقد أخافتاني، كانتا مثل عيني
.وحش تتوهّجان في الظُّلمة

265
00:15:48,190 --> 00:15:51,980
.أودّ رؤية مستقبل هذه البلاد الّذي تتخيّله

266
00:15:53,660 --> 00:15:54,930
.لا تكوني سخيفة

267
00:15:55,310 --> 00:15:58,450
.لكنّهما ليستا مخيفتين
.إنّما لونهما أكثر لطفًا بكثير

268
00:15:59,660 --> 00:16:02,910
.كالقمر الّذي ينير ظُلمة اللّيل

269
00:16:03,560 --> 00:16:04,440
...أزو

270
00:16:07,860 --> 00:16:09,490
ما-ماذا هنالك؟

271
00:16:09,900 --> 00:16:12,910
لا أدري ما السّبب، لكنّي شعرت
.أنّ عليّ القيام بهذا

272
00:16:16,130 --> 00:16:17,470
.ما عدت أتحمّل

273
00:16:18,210 --> 00:16:19,150
ماذا؟

274
00:16:19,150 --> 00:16:21,040
.تعرفين السّبب

275
00:16:21,040 --> 00:16:24,710
.هذا هو ما نسمّيه بالحبّ

276
00:16:26,210 --> 00:16:31,210
.أشعر بدفء وخفّة شديدين
.إضافة إلى ضيق في صدري

277
00:16:31,860 --> 00:16:37,720
سأملأ قلبي بهذه اللّحظة
.وأغلق عليها وأقدّرها للأبد

278
00:16:38,340 --> 00:16:40,720
.كان ذلك ممتعًا. علينا الخروج ثانية لاحقًا

279
00:16:40,720 --> 00:16:42,670
.لا يمكنني السّماح بذلك طول الوقت

280
00:16:42,670 --> 00:16:43,340
.أنت مملّ

281
00:16:43,340 --> 00:16:45,740
...ستكون فرصتنا التّالية

282
00:16:45,740 --> 00:16:48,480
،ربّما في مهرجان حصاد الخريف
.عندما تكون المدينة في أوج نشاطها

283
00:16:49,810 --> 00:16:50,840
...الخريف

284
00:16:52,200 --> 00:16:54,490
.نعم. أتطلّع لذلك

285
00:16:55,400 --> 00:16:57,810
.لن يحلّ ذلك الخريف أبدًا

286
00:16:58,260 --> 00:17:02,500
.لكنّي في الخريف الّذي يتخيّله أزو

287
00:17:02,880 --> 00:17:03,760
.أزو

288
00:17:04,210 --> 00:17:06,830
.عليّ العودة لواجباتي. سأراك غدًا

289
00:17:07,500 --> 00:17:08,480
.أزو

290
00:17:10,340 --> 00:17:13,750
.شكرًا لك

291
00:17:15,600 --> 00:17:19,890
.شكرًا لمنحك لي شيئًا مميّزًا أتشبّث به

292
00:17:20,300 --> 00:17:21,520
ما سبب ذلك؟

293
00:17:21,520 --> 00:17:22,790
.كان وليد اللّحظة فحسب

294
00:17:23,260 --> 00:17:24,850
.وهذا ليس بسبب النّجوم

295
00:17:25,530 --> 00:17:27,420
.اخترتُ هذا بنفسي

296
00:17:30,880 --> 00:17:33,360
.كم هذا جميل

297
00:17:33,360 --> 00:17:36,990
.تُلائمك ملابس غالغادا كثيرًا

298
00:17:36,990 --> 00:17:39,560
.لديك الكثير من حليّ الشّعر لتختاري منها أيضًا

299
00:17:39,560 --> 00:17:42,480
لكن قد يكون من الصّعب كثيرًا
.أن ترتديها بنفسك

300
00:17:42,480 --> 00:17:44,500
ماذا؟ ألن تذهبا معي؟

301
00:17:44,720 --> 00:17:49,260
.إنّنا نخدم القصر النّجميّ
.لا يمكننا ترك البلاد

302
00:17:49,260 --> 00:17:51,880
من غير المعتاد لنا أن نكون
.في القلعة من الأساس

303
00:17:51,880 --> 00:17:56,380
.سأكون وحدي بالكامل إذًا

304
00:17:56,620 --> 00:17:59,620
.وحدي، بدون أيّ أحد أعرفه

305
00:18:00,390 --> 00:18:02,020
أيّتها الأميرة أليشا؟

306
00:18:02,020 --> 00:18:05,380
.أنا خائفة. كأنّ الأرض الّتي أقف عليها تختفي

307
00:18:05,380 --> 00:18:07,910
.وعندما أمدّ يدي، لا أجد سوى الظُّلمة

308
00:18:09,320 --> 00:18:10,270
...أنا

309
00:18:10,270 --> 00:18:11,900
!أختي

310
00:18:11,900 --> 00:18:13,150
.موهولوم

311
00:18:13,900 --> 00:18:16,370
لماذا ستغادرين اليوم؟

312
00:18:16,370 --> 00:18:18,900
!ألا يفترض أنّه ما زالت أمامك عشرة أيّام أخرى؟

313
00:18:18,900 --> 00:18:21,030
!أزور ليس هنا أيضًا

314
00:18:21,030 --> 00:18:26,250
حضّر الملك السّابق لكلّ شيء
.لأنّ أزور مشغول جدًّا

315
00:18:26,250 --> 00:18:28,230
!لا أريدك أن تذهبي

316
00:18:28,230 --> 00:18:30,620
!ابقي هنا للأبد يا أختي

317
00:18:34,300 --> 00:18:38,050
لا تكن أنانيًّا. لن تصير رجلاً
.عظيمًا على هذا الحال

318
00:18:38,780 --> 00:18:43,050
.ستراقب أختك فورتنا دائمًا

319
00:18:43,050 --> 00:18:45,560
...أختي

320
00:18:45,560 --> 00:18:48,120
بمجرّد أن أضع أُسسي في غالغادا
،وأحصل على السّلطة

321
00:18:48,120 --> 00:18:49,280
.سأعود لرؤيتك

322
00:18:49,280 --> 00:18:52,060
!يبدو ذلك مخيفًا

323
00:18:52,060 --> 00:18:53,650
.أيّتها الأميرة أليشا

324
00:18:53,650 --> 00:18:57,510
.أحببناك كثيرًا

325
00:18:57,510 --> 00:19:00,860
.نتمنّى لو استطعنا خدمتك للأبد

326
00:19:03,570 --> 00:19:06,500
.شكرًا لكما على كلّ شيء

327
00:19:09,170 --> 00:19:11,530
أيّها الأمير أزور، هل من خطب ما؟

328
00:19:11,530 --> 00:19:15,340
.أشعر وكأنّ شيئًا ما ليس في محلّه

329
00:19:16,110 --> 00:19:19,860
.أشعر وكأنّ هنالك ما فاتني

330
00:19:21,020 --> 00:19:23,340
.سمعتُ أنّكم تواجهون المشاكل

331
00:19:23,620 --> 00:19:26,100
.لقد تمّ حلّ ذلك الأمر سلفًا

332
00:19:28,180 --> 00:19:29,230
تحت أوامر من؟

333
00:19:29,230 --> 00:19:30,730
...أنا

334
00:19:31,040 --> 00:19:32,650
.إنّه الملك السّابق

335
00:19:33,230 --> 00:19:35,670
!لقد خدعتني يا دايتس

336
00:19:35,670 --> 00:19:37,350
.إنّه من أجل صالح البلاد

337
00:19:38,660 --> 00:19:39,780
!ابتعدوا

338
00:19:40,700 --> 00:19:42,780
.هذا ما كان يضايقني

339
00:19:43,750 --> 00:19:46,200
.كانت نينا تتصرّف بغرابة

340
00:19:46,730 --> 00:19:50,410
ذهب مبعوثي لتفتيش الأرياف
.فجأة بدل العودة إليّ

341
00:19:50,410 --> 00:19:52,510
.كلّ هذا بغرض إبعادي

342
00:19:52,960 --> 00:19:54,120
لكن من قد يفعل هذا؟

343
00:19:56,430 --> 00:19:58,140
أهي أنت يا نينا؟

344
00:20:00,360 --> 00:20:03,740
.أتساءل إن كان أزو غاضبًا الآن

345
00:20:03,740 --> 00:20:05,500
.لكن لم يكن لديّ خيار

346
00:20:06,020 --> 00:20:07,810
.لم أستطع السّماح له بإيقافي

347
00:20:08,640 --> 00:20:10,170
...إن حاول إيقافي

348
00:20:13,130 --> 00:20:14,520
.تعال لإيقافي رجاءً

349
00:20:14,960 --> 00:20:16,990
.لا أريد الذّهاب

350
00:20:16,990 --> 00:20:18,070
.أريد رؤية وجهك

351
00:20:18,860 --> 00:20:21,520
.أريد رؤيتك لمرّة أخيرة

352
00:20:22,910 --> 00:20:24,900
!طُلب منّا ألاّ نسمح لك بالعبور

353
00:20:25,590 --> 00:20:27,410
!سيتطلّب الأمر ثلاثة أيّام لبلوغ الحدود

354
00:20:27,410 --> 00:20:28,580
!لن تصل في الوقت المناسب

355
00:20:32,710 --> 00:20:35,580
.نينا

356
00:20:35,820 --> 00:20:38,090
.أخبرتك أن تنتظريني

357
00:20:38,500 --> 00:20:40,620
.وعدتك أن أقوم بشيء ما

358
00:21:03,870 --> 00:21:07,560
.لهذه المرّة فقط. سأبكي لهذه المرّة فقط

359
00:21:11,290 --> 00:21:12,990
.لهذه المرّة فقط

360
00:22:51,900 --> 00:22:55,090
.هذه ليست جيّدة للاستخدام العفويّ

361
00:22:55,530 --> 00:22:57,780
.كان لديها صوت جميل أيضًا
.يا للأسف

362
00:23:00,320 --> 00:23:03,180
.لا ترتجفا هكذا

363
00:23:03,180 --> 00:23:06,040
ستجعلاني أعتقد أنّكما تريدان
.قتلي مثلها تمامًا

364
00:23:07,020 --> 00:23:08,490
...الأميرة إليزا

365
00:23:08,930 --> 00:23:11,630
.صحيح. كان هذا اسمها

366
00:23:12,370 --> 00:23:15,120
.حان الوقت أيّها الأمير سِت

367
00:23:15,390 --> 00:23:20,590
تتميّز ملابس اليوم بتطريز
.قرمزيّ يتناسب مع عينيك

368
00:23:20,590 --> 00:23:21,730
