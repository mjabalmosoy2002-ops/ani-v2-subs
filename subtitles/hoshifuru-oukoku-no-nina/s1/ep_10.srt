1
00:00:01,430 --> 00:00:04,550
.لا يوجد ما يمكنني إخبارك به

2
00:00:04,980 --> 00:00:06,950
!يمكنك إذًا استعمال مخيّلتك فحسب

3
00:00:08,730 --> 00:00:13,240
.لقد وقف. ذلك كلّ ما يمكنني قوله

4
00:00:14,440 --> 00:00:15,820
.أنا قلقة

5
00:00:16,680 --> 00:00:20,750
أعد أن أعيدك إلى فورتنا قبل
.زفافك في الرّبيع

6
00:00:21,020 --> 00:00:23,750
.أعد أن أستعيدك من هنا

7
00:00:25,220 --> 00:00:27,180
.سيكون من الجنون استعادتي

8
00:00:27,540 --> 00:00:31,200
أنا قلقة من أن يكون
.قد تجاوز الحدود من أجلي

9
00:00:31,630 --> 00:00:37,140
ما كان يجب إرسالك
.إلى بلاد العدوّ للزّواج

10
00:00:37,480 --> 00:00:40,830
ليس وأنت الأميرة الرّاهبة النّجميّة
.ذات العينين الزّرقاوين

11
00:02:13,180 --> 00:02:15,990
هل تعرفين قصّة تأسيس فورتنا؟

12
00:02:15,990 --> 00:02:18,190
.حتّى الأطفال يعرفونها

13
00:02:18,190 --> 00:02:22,120
أليس ذلك هو مصدر مهرجان
النّجوم وإله النّجوم؟

14
00:02:23,290 --> 00:02:24,740
،قبل زمن بعيد

15
00:02:25,490 --> 00:02:28,600
كانت هنالك مجموعة بدوٍ يُطلق
،عليهم شعب النّجوم

16
00:02:28,600 --> 00:02:31,950
وكانوا يمتلكون قدرة غامضة تمكّنهم
.من الحديث مع أرواح كلّ شيء

17
00:02:32,750 --> 00:02:34,750
.كانت عيونهم زرقاء

18
00:02:35,830 --> 00:02:41,760
وذات يوم، وقعت فتاة من شعب
.النّجوم في حبّ الملك الشّابّ

19
00:02:42,730 --> 00:02:46,920
تحدّت الفتاة المعارضة الّتي واجهتها
،وتركت شعبها

20
00:02:46,920 --> 00:02:48,760
.وتزوّج الشّابّان

21
00:02:49,980 --> 00:02:53,950
،صارت الأرض خصبة تحت إرشادها

22
00:02:54,320 --> 00:02:58,030
.كما هدأت الرّياح وصفت المياه

23
00:02:58,590 --> 00:03:04,030
لقد بنيا بلادًا مزدهرة اسمها
.فورتنا استمرّت لألف عام

24
00:03:04,470 --> 00:03:09,490
وبسبب ذلك، تحظى العائلة المالكة
.بمواليد بعيون زرقاء أحيانًا

25
00:03:11,520 --> 00:03:15,040
.يعرف الجميع هذا القدر من القصّة على الأقلّ

26
00:03:15,040 --> 00:03:16,970
.لكن هنالك المزيد

27
00:03:17,520 --> 00:03:21,340
لماذا تصير الأميرات ذوات العيون
الزّرقاء راهبات؟

28
00:03:21,710 --> 00:03:25,050
إضافة لذلك، لماذا يتمّ تربيتهنّ
في قصر النّجوم؟

29
00:03:26,590 --> 00:03:30,810
.لأنّه قيل أنّهنّ يملكن قوّة من نوع ما

30
00:03:32,190 --> 00:03:38,690
لذلك يبدو من المنطقيّ
.أن تلغي فورتنا هذا الزّفاف

31
00:03:39,690 --> 00:03:42,900
.لا يجب أن يتمّ أخذك من طرف أيّ أحد آخر

32
00:03:44,580 --> 00:03:48,240
.لكنّي لستُ الأميرة أليشا الحقيقيّة

33
00:03:49,230 --> 00:03:53,080
.ولكن ليس عليك القيام بأيّ شيء

34
00:03:54,840 --> 00:03:58,090
ليس عليّ القيام بأيّ شيء؟

35
00:03:59,020 --> 00:04:02,780
.لم يأتِ أزو لرؤيتي فقط، بل ولم ينسني أيضًا

36
00:04:03,160 --> 00:04:05,590
.جعلني ذلك أطير من السّعادة

37
00:04:06,290 --> 00:04:09,870
...بصوته العذب وعيناه اللّتان بلون القمر

38
00:04:10,600 --> 00:04:11,540
.نينا

39
00:04:14,330 --> 00:04:17,360
.إنّ ذلك يُشعرني بحماسة شديدة

40
00:04:18,350 --> 00:04:21,360
،ولكن في نهاية المطاف
،أنا لا أعرف أيّ شيء

41
00:04:22,240 --> 00:04:24,330
.رغم أنّ كلّ هذا من أجلي

42
00:04:26,550 --> 00:04:32,080
،تحدث أمور من حولي
.لكنّي أجهل كلّ شيء

43
00:04:34,050 --> 00:04:36,950
،أشعر بثقل في قلبي
.وكأنّ غمامة استقرّت عليه

44
00:04:38,670 --> 00:04:41,640
أتشعرين بالحنين لوطنك ثانية؟

45
00:04:43,750 --> 00:04:45,010
...سِت

46
00:04:52,270 --> 00:04:56,450
لا تريدين هذه الأشياء بدون
حبّ يدعمها، صحيح؟

47
00:04:58,010 --> 00:05:01,220
.عليّ التّأكّد ممّا قصده بذلك أيضًا

48
00:05:01,540 --> 00:05:02,130
...ما

49
00:05:03,700 --> 00:05:05,130
!كـ-كلاّ

50
00:05:06,630 --> 00:05:07,290
ماذا؟

51
00:05:07,290 --> 00:05:08,660
...لا-لا تفعل فحسب

52
00:05:08,920 --> 00:05:12,560
...إن كان هنالك حبّ وراء ذلك بالفعل

53
00:05:12,560 --> 00:05:15,300
.ثمّة أمور عديدة تشغل بالي الآن

54
00:05:15,300 --> 00:05:17,400
.لا يمكنني تحمّل هذا عاطفيًّا

55
00:05:18,230 --> 00:05:21,060
لا يمكنني قبول ذلك بينما
.مشاعري غير واضحة

56
00:05:21,430 --> 00:05:22,970
.فقبل كلّ شيء، إنّها مهمّة

57
00:05:24,670 --> 00:05:28,490
.انتظر حتّى يصفى ذهني

58
00:05:28,980 --> 00:05:31,180
ماذا يمكنني فعله إذًا؟

59
00:05:31,420 --> 00:05:32,430
!ماذا؟

60
00:05:33,010 --> 00:05:38,100
...حسنًا... ربّما لا بأس بعناق

61
00:05:40,990 --> 00:05:45,480
.الأمر أشبه بإعجاب حيوان ضخم جميل بي

62
00:05:46,260 --> 00:05:48,120
لماذا هو معجب بي لهذا الحدّ؟

63
00:05:50,850 --> 00:05:57,470
سِت، إن طلبتُ منك ألاّ تهاجم
فورتنا، فماذا كنتَ لتفعل؟

64
00:05:58,410 --> 00:05:59,610
فورتنا؟

65
00:05:59,960 --> 00:06:02,460
.لا تهتمّ بشأن ذلك. انس الأمر

66
00:06:03,270 --> 00:06:06,200
.سأصير ملكة وأحمي فورتنا

67
00:06:06,200 --> 00:06:09,440
.سأجعل الأمير يُحبّني لأتمكّن من ذلك

68
00:06:09,790 --> 00:06:12,080
.كانت تلك أهدافي عندما أتيتُ إلى هنا

69
00:06:12,470 --> 00:06:13,830
.لكنّي كنتُ مخطئة

70
00:06:13,830 --> 00:06:16,610
.إنّ استغلال مشاعر شخص آخر أمر خاطئ

71
00:06:17,230 --> 00:06:19,230
.لا شيء

72
00:06:20,280 --> 00:06:23,230
.إنّ قرار غزو فورتنا اتُّخذ سلفًا

73
00:06:23,810 --> 00:06:27,740
سيذهب العرش لمن سيتزوّج أميرة فورتنا

74
00:06:27,740 --> 00:06:34,740
لأنّ الأمير المولود بين غالغادا
.وفورتنا هو أداة مفيدة للسّيطرة

75
00:06:35,360 --> 00:06:39,990
.لا أحد يفكّر فيما ترغب به أميرة فورتنا

76
00:06:41,410 --> 00:06:46,250
إنّ لهذا الأمر ثقلاً كبيرًا يجعل جسدي
.يتصدّع تحته. يجعل قلبي ينفطر

77
00:06:46,900 --> 00:06:48,290
كم مرّة حدث هذا الآن؟

78
00:06:49,950 --> 00:06:52,620
.سأذهب لتنشّق بعض الهواء النّقيّ

79
00:06:56,310 --> 00:06:58,190
.إنّها ليست غلطة سِت

80
00:06:58,190 --> 00:07:01,520
لكن كم مرّة شعرتُ بهذا العجز؟

81
00:07:01,840 --> 00:07:04,270
.كنتُ دائمًا في راحة يد شخص ما

82
00:07:04,500 --> 00:07:07,170
.إنّ المعاناة لا تجدي أيّ نفع

83
00:07:12,290 --> 00:07:14,780
...سئمت من كلّ هذا

84
00:07:21,290 --> 00:07:23,060
ما خطبكما؟

85
00:07:26,970 --> 00:07:27,800
!ماذا؟

86
00:07:33,460 --> 00:07:37,820
تبدو المدينة صغيرة جدًّا من فوق
.هذه القلعة الضّخمة

87
00:07:37,820 --> 00:07:40,100
.تبدو ضئيلة

88
00:07:40,560 --> 00:07:44,860
لكنّ المدينة أكبر بكثير من القلعة
في الواقع. ألا تدرون هذا؟

89
00:07:48,340 --> 00:07:50,690
!هذا غباء

90
00:07:50,690 --> 00:07:53,100
!لا يوجد ما هو أسوأ من الملك

91
00:07:53,100 --> 00:07:55,090
!كيف يجرؤ على استعمالي كأداة فحسب؟

92
00:07:55,090 --> 00:07:58,280
!على الأقلّ قابلني وألق التّحيّة

93
00:07:58,280 --> 00:07:59,580
!لا تتجاهلني

94
00:07:59,580 --> 00:08:01,290
!وأنا كذلك غبيّة

95
00:08:01,290 --> 00:08:02,710
!كفّي عن الشّعور بالاكتئاب

96
00:08:02,710 --> 00:08:05,540
!لا يهمّ إن كنت لا أفهم

97
00:08:05,540 --> 00:08:08,300
.قرّرتُ أنّي سأحمي كلّ شيء

98
00:08:08,910 --> 00:08:12,620
.والآن، عليّ أن أقاتل ملك غالغادا

99
00:08:20,290 --> 00:08:23,580
سيكون الجنرال السّابق هولت هنا، صحيح؟

100
00:08:23,580 --> 00:08:27,260
.نعم. تتمّ مرافقته الآن عبر الشّوارع الخلفيّة

101
00:08:28,110 --> 00:08:30,590
والإشاعات عن الخلافة الملكيّة؟

102
00:08:30,590 --> 00:08:33,140
.واثق أنّ جميع النّبلاء يتحدّثون عن ذلك الآن

103
00:08:37,190 --> 00:08:40,740
سمعتُ أنّهم يُقاتلون من أجل
.أميرة فورتنا في هذه البطولة

104
00:08:41,010 --> 00:08:45,960
.والأمير الّذي سيفوز بها سيصير الملك التّالي

105
00:08:45,960 --> 00:08:49,750
،يبدو ذلك ممتعًا— أقصد
.يا لها من أوقات جامحة

106
00:08:50,720 --> 00:08:55,480
.يبدو أنّ الأمير يور ينوي استعمال هذه البطولة

107
00:08:55,480 --> 00:09:00,260
لطالما خسر في السّابق، ولكن ربّما
.لديه فرصة للفوز هذه السّنة

108
00:09:02,770 --> 00:09:05,880
.لم نلاحظ أيّ تغيّرات في الأجنحة الأخرى

109
00:09:05,880 --> 00:09:08,560
.كما كان المبعوثون صامتون أيضًا

110
00:09:10,660 --> 00:09:11,240
ماذا هنالك؟

111
00:09:11,240 --> 00:09:11,660
!انظروا

112
00:09:11,660 --> 00:09:12,280
ما هذا؟

113
00:09:12,600 --> 00:09:14,520
...تـ-تلك

114
00:09:26,620 --> 00:09:29,170
إنّها أميرة فورتنا؟

115
00:09:29,780 --> 00:09:32,610
!إنّها أشبه بجوهرة نادرة

116
00:09:37,200 --> 00:09:40,100
.إنّه لشرف لي أن ألقاء يا ملك غالغادا

117
00:09:40,410 --> 00:09:43,080
.أنا أليشا ست فورتنا

118
00:09:43,680 --> 00:09:46,810
هلّي بالحديث معك لبضع الوقت؟

119
00:09:47,980 --> 00:09:49,410
.أوّلاً، عليّ أن أشكرك

120
00:09:49,850 --> 00:09:52,810
أنا مسرورة لأنّك وضعتني في موقف

121
00:09:52,810 --> 00:09:56,700
.يسمح لي بتحديد من سيصبح الملك التّالي

122
00:09:57,400 --> 00:10:02,230
سمعتُ أنّ هناك من يرغبون
.في المطالبة بي كمكافأة في هذه البطولة

123
00:10:03,390 --> 00:10:06,470
،سأحترم ذلك الطّلب

124
00:10:06,470 --> 00:10:11,710
ولكنّني أعتقد أنّني أستحقّ
.مكافأة من الملك أيضًا

125
00:10:12,610 --> 00:10:15,960
.يأمرك الملك أن تفصحي عن رغبتك

126
00:10:16,590 --> 00:10:18,730
.لن أدعه يتجاهلني ثانية

127
00:10:18,730 --> 00:10:21,970
.لا بأس. فقبل كلّ شيء، أنا الأمير أليشا

128
00:10:22,780 --> 00:10:25,860
،بابتسامة جميلة ستحبس أنفاسه

129
00:10:26,220 --> 00:10:28,190
.سأعلن عن طلبي بوضوح تامّ

130
00:10:28,760 --> 00:10:30,730
،يا ملك غالغادا

131
00:10:32,060 --> 00:10:34,580
.أعطني فورتنا لو سمحت

132
00:10:44,460 --> 00:10:47,430
.يا له من كلام ممتع

133
00:10:48,200 --> 00:10:50,870
...ماذا؟ هذا الصّوت

134
00:10:51,380 --> 00:10:54,750
.اقتربي. دعيني أنظر لوجهك

135
00:10:54,750 --> 00:10:58,810
.أنا ملك غالغادا، نوا هالي

136
00:11:03,230 --> 00:11:04,270
امرأة؟

137
00:11:06,010 --> 00:11:07,850
إنّها ملكة إذًا؟

138
00:11:08,150 --> 00:11:10,770
قلتِ أنّك تريدين فورتنا؟

139
00:11:10,770 --> 00:11:13,730
أتعتقدين أنّك جديرة بمثل هذه المكافأة؟

140
00:11:14,460 --> 00:11:15,490
هل أنا جديرة؟

141
00:11:16,810 --> 00:11:19,920
إن كان هناك أيّ معنى للقيمة
،الّتي وضعها النّاس فيّ

142
00:11:20,490 --> 00:11:24,420
.فمن المؤكّد أنّ قيمتي لا جدال فيها

143
00:11:26,490 --> 00:11:28,110
.انضمّي إليّ

144
00:11:28,110 --> 00:11:29,820
.سنشاهد البطولة معًا

145
00:11:35,090 --> 00:11:36,490
.أخذتُ الخطوة الأولى

146
00:11:40,740 --> 00:11:45,510
لا أدري ما الّذي كنت أتوقّعه، ولكن
."لم يكن "أعطني فورتنا لو سمحت

147
00:11:45,890 --> 00:11:50,270
.بصراحة، لا تهتمّ ما هي خططي على الإطلاق

148
00:11:50,890 --> 00:11:53,000
.إنّ العراقيل لا معنى لها أمامها

149
00:11:53,000 --> 00:11:56,650
.إنّها تقفز فوقها بسهولة لتأتي وتقف أمامي

150
00:11:59,410 --> 00:12:03,580
.لذلك السّبب أحبّك يا نينا

151
00:12:07,350 --> 00:12:10,170
...منذ اليوم الّذي غادرتِ فيه

152
00:12:11,040 --> 00:12:13,370
تعيد أليشا إلى هنا؟

153
00:12:13,370 --> 00:12:15,540
!لا يمكننا فعل ذلك

154
00:12:15,910 --> 00:12:21,320
ما كان علينا أن نزوّج الرّاهبة
.النّجميّة لبلاد أخرى

155
00:12:22,050 --> 00:12:25,930
على كلّ من القصر النّجميّ والملك
.السّابق أن يعارضوا الفكرة

156
00:12:26,400 --> 00:12:28,310
هل تتحدّث عن تلك الأسطورة؟

157
00:12:28,310 --> 00:12:32,170
.لكنّي سمعتُ أنّ أليشا لا تملك تلك القوّة

158
00:12:32,170 --> 00:12:34,190
.لذلك السّبب زوّجتها

159
00:12:34,680 --> 00:12:39,480
سأقود غالغادا وأصير السّيف
.الّذي سيدمّر فورتنا

160
00:12:40,380 --> 00:12:44,700
قد تكون ابنتي، ولكن ربّما عليّ
.القيام بشيء ما بخصوصها

161
00:12:45,160 --> 00:12:46,860
هل لديك أيّ خطّة؟

162
00:12:47,690 --> 00:12:51,200
.امنحني السّلطة لحشد الأمّة

163
00:12:51,730 --> 00:12:54,880
،إن وعدتَ ألاّ تتدخّل

164
00:12:55,330 --> 00:13:00,960
فسأعيد الأميرة أليشا
.وأحمي البلاد من غالغادا

165
00:13:01,250 --> 00:13:04,870
!لا تكن سخيفًا
لماذا قد أسمح لك بذلك؟

166
00:13:05,620 --> 00:13:06,970
...لا، مهلاً

167
00:13:07,580 --> 00:13:10,170
،إن سارت الأمور كما يجب
.فسأُسقط عصفورين بحجر

168
00:13:10,170 --> 00:13:11,900
.لن أخسر أيّ شيء بموافقتي

169
00:13:11,900 --> 00:13:14,420
السّلطة لحشد الأمّة؟

170
00:13:14,420 --> 00:13:17,600
.حسنًا. أفترض أنّ لا بدّ من ذلك

171
00:13:17,600 --> 00:13:19,730
.سأمنحك العرش

172
00:13:19,730 --> 00:13:22,270
.ولكن، عليك الخروج بنتيجة ما خلال سنة

173
00:13:22,270 --> 00:13:24,140
.ذلك هو شرطي

174
00:13:24,940 --> 00:13:27,260
.ستكون الملك لسنة واحدة فقط

175
00:13:27,260 --> 00:13:30,190
.قدّم كلّ ما لديك لفورتنا ومُت

176
00:13:31,700 --> 00:13:35,500
.لطالما كان ذلك قدري

177
00:13:35,900 --> 00:13:38,420
.ما عاد لديّ ما أقلق حياله الآن

178
00:13:40,450 --> 00:13:41,570
.أحمق

179
00:13:42,440 --> 00:13:46,160
هل يعتقد أنّ الأمور يمكن أن تعود
لما كانت عليه بعد منحي هذه السّلطة؟

180
00:13:49,410 --> 00:13:50,630
.اتّخذت قراري

181
00:13:51,710 --> 00:13:55,270
.فهمت. إذًا فقد نهض أزور

182
00:13:56,240 --> 00:13:58,620
.لن أتهاون بعد الآن

183
00:14:01,830 --> 00:14:04,060
.سأعثر على طريقة للحصول على فورتنا

184
00:14:06,380 --> 00:14:12,020
.هذه البطولة معركة لتحقيق المكانة والمجد

185
00:14:12,390 --> 00:14:15,910
يتشارك فيها الجنود والمقاتلون
.الّذين يمثّلون أجنحة الأمراء

186
00:14:16,140 --> 00:14:17,800
يُمنع الأمراء والجنرالات

187
00:14:17,800 --> 00:14:21,040
من المشاركة، ليستطيع المقاتلون
.القتال بدون قيود

188
00:14:21,320 --> 00:14:26,910
.لقد قُتل وريث العرش مرّة في البطولة

189
00:14:26,910 --> 00:14:31,050
،لا يهمّ ما مدى قوّة الأمراء
.فلا يُسمح لهم بدخول الحلبة

190
00:14:31,050 --> 00:14:35,440
عفوًا، ما علاقتك بالأمراء الأربعة؟

191
00:14:35,440 --> 00:14:37,060
لا تعرفين الخوف، صحيح؟

192
00:14:37,770 --> 00:14:42,130
جميعهم أبناء الملك السّابق
.الرّاحل، أخي الأكبر العزيز

193
00:14:43,110 --> 00:14:47,700
بتعبير آخر، الملك نوا هي أخت
.الملك السّابق الصّغرى

194
00:14:47,700 --> 00:14:52,230
.بعد وفاة أخي، كان الأمراء لا يزالون صغارًا

195
00:14:52,700 --> 00:14:56,450
.ومن واجبي تجهيز العرش المثاليّ لهم

196
00:14:56,450 --> 00:15:01,460
.صحيح. يفتقر كلّ الأمراء لأمور عدّة

197
00:15:03,200 --> 00:15:04,590
.يا له من قول تقولينه أمامي

198
00:15:04,590 --> 00:15:06,120
.أنا آسفة

199
00:15:06,120 --> 00:15:07,950
.لا بأس. إنّها الحقيقة

200
00:15:08,290 --> 00:15:10,810
،قابلتِهم مؤخّرًا فحسب
.لكنّك راقبتهم عن كثب

201
00:15:11,520 --> 00:15:13,720
.يفتقر بيدو للطّموح

202
00:15:13,720 --> 00:15:15,720
.ويفتقر يور للذّكاء

203
00:15:15,720 --> 00:15:17,960
.بينما يفتقر سِت للقلب

204
00:15:17,960 --> 00:15:21,100
.وتوت ليس مناسبًا ليكون ملكًا البتّة

205
00:15:22,170 --> 00:15:25,320
.يمكن تعويض ما يفتقرون له

206
00:15:25,320 --> 00:15:28,190
.سأكون قلب الأمير سِت

207
00:15:28,520 --> 00:15:30,110
!يا لطموحك

208
00:15:30,110 --> 00:15:31,740
.لا أكره تلك الشّيمة في الشّخص

209
00:15:32,220 --> 00:15:35,560
.حضورها قويّ حتّى عندما تبتسم

210
00:15:35,560 --> 00:15:38,630
تبدو صريحة، لكنّي أشعر أيضًا
.أنّها تُبقي مسافة بيننا

211
00:15:38,630 --> 00:15:40,810
لماذا أشعر أنّ هنالك شيئًا ما ليس في محلّه؟

212
00:15:40,810 --> 00:15:43,700
.لنرَ كيف سيُبلون

213
00:15:43,700 --> 00:15:46,630
ما زلتُ لا أعرف بالضّبط
،أيّ نوع من النّاس تكون

214
00:15:47,190 --> 00:15:50,530
.لكنّي سأحمي فورتنا منها

215
00:15:52,280 --> 00:15:53,840
لـ-لماذا؟

216
00:15:54,350 --> 00:15:57,260
.أخبرتكم أن تحضروا الجنرال السّابق هولت

217
00:15:57,560 --> 00:15:59,230
.ربّما كان هنالك سوء تواصل

218
00:15:59,230 --> 00:16:00,610
!تسمّي هذا سوء تواصل؟

219
00:16:00,610 --> 00:16:02,990
إنّ هذا هو المجرم الفظيع

220
00:16:02,990 --> 00:16:05,800
الّذي ذبح بكلّ فرح مجموعة
،من القرويّين العزّل

221
00:16:06,220 --> 00:16:08,120
!دوغرا كيت

222
00:16:08,650 --> 00:16:10,850
!يجب أن ينسحب من البطولة في الحال

223
00:16:11,160 --> 00:16:14,880
!سيدنّس سمعة الجناح الأسود، سمعتي

224
00:16:14,880 --> 00:16:15,930
!لا نستطيع

225
00:16:15,930 --> 00:16:19,820
!لم يتبقّ وقت لذلك
!ليس بوسعنا فعل أيّ شيء ما لم يخسر

226
00:16:20,210 --> 00:16:23,290
...لا يعقل أنّ هذا ما يحدث

227
00:16:25,000 --> 00:16:26,230
.أنا أستسلم

228
00:16:28,660 --> 00:16:30,550
ما هذا؟

229
00:16:31,040 --> 00:16:36,550
.الـ-الفائز هو ممثّل الجناح الأسود دوغرا

230
00:16:37,020 --> 00:16:41,180
.اختار يور وضيعًا حقيقيًّا ليمثّله

231
00:16:41,180 --> 00:16:43,230
.لا بدّ أنّه يرغب في الفوز بشدّة

232
00:16:43,230 --> 00:16:46,560
.ما كنتُ لأتفاجأ إن لقي البعض حتفه

233
00:16:46,890 --> 00:16:49,900
أذلك مسموح به؟

234
00:16:50,240 --> 00:16:53,190
.سبق وأعلن منافسه استسلامه

235
00:16:54,240 --> 00:16:59,100
.إنّه أمر غير محبّذ، لكنّه ليس ممنوعًا أيضًا

236
00:17:00,030 --> 00:17:03,400
.في غالغادا، القوّة دائمًا على حقّ

237
00:17:03,400 --> 00:17:07,090
.كلٌّ من الحياة والموت بين أيدي القويّ

238
00:17:09,390 --> 00:17:12,210
يتلقّى البطل مكافأة أعظم ممّا يستحقّ

239
00:17:12,210 --> 00:17:16,010
.لأنّه يخاطر بحياته في القتال لأجلها

240
00:17:16,830 --> 00:17:19,180
.وجدتُ ما هو ليس في محلّه

241
00:17:19,980 --> 00:17:23,640
.ربّما فمها يبتسم، لكنّ عيناها لا

242
00:17:24,560 --> 00:17:26,380
.هذه هي ملك غالغادا

243
00:17:26,990 --> 00:17:29,620
.إنّها ملك تُوسّع منطقها من خلال المعارك

244
00:17:31,050 --> 00:17:34,800
.عليّ الحفاظ على هدوئي وأعصابي

245
00:17:35,500 --> 00:17:39,730
بالمناسبة، سمعتُ أنّ مبعوثي
.فورتنا قد سُمح لهم بالمشاركة

246
00:17:39,730 --> 00:17:42,080
.ربّما سيقاتلونه في النّهاية

247
00:17:42,080 --> 00:17:45,310
.أنا... أتطلّع قُدمًا لذلك

248
00:17:45,930 --> 00:17:47,920
.إنّها تحاول إرباكي

249
00:17:47,920 --> 00:17:50,230
.لا بأس. أزو قويّ

250
00:17:50,790 --> 00:17:53,460
.الفائز هو ممثّل الجناح الأسود دوغرا

251
00:17:54,490 --> 00:17:57,210
أيّها الأمير سِت، هل لديك بعض الوقت؟

252
00:17:57,930 --> 00:17:58,890
.اتبعني

253
00:17:59,350 --> 00:18:00,510
.عليّ تحمّل الأمر

254
00:18:00,890 --> 00:18:04,890
.وأحافظ على هدوئي وأبتسم بأناقة

255
00:18:09,810 --> 00:18:13,700
.مسكين. لا تزال حيًّا

256
00:18:13,700 --> 00:18:17,370
!لا يجب أن يُتوقّع منّي أن أتحمّل هذا

257
00:18:17,840 --> 00:18:19,530
هل يمكنني إيقاف البطولة؟

258
00:18:19,940 --> 00:18:23,400
.لا أدري كيف ستستطيعين ذلك
.الزمي الصّمت وشاهدي

259
00:18:23,740 --> 00:18:25,040
.هذا أمر

260
00:18:26,600 --> 00:18:29,090
أمر؟

261
00:18:29,540 --> 00:18:34,050
.لا أهتمّ لذلك ولو قيد أنملة

262
00:18:35,920 --> 00:18:37,950
.لا أريد تحمّل هذا الظّلم

263
00:18:38,300 --> 00:18:40,440
لا أريد الخسارة في مواجهة
.ما كُتب في النّجوم بعد الآن

264
00:18:41,190 --> 00:18:42,230
الأميرة أليشا؟

265
00:18:42,230 --> 00:18:43,180
ماذا تفعلين؟

266
00:18:43,180 --> 00:18:45,100
.انتهى هذا القتال

267
00:18:45,440 --> 00:18:47,040
.لنُخرج الرّجل المصاب من الحلبة

268
00:18:49,960 --> 00:18:53,330
.لا بأس. أنا سأساعد في ذلك

269
00:18:54,520 --> 00:18:55,210
ماذا؟

270
00:18:59,210 --> 00:19:02,410
.لم أتوقّع أبدًا أنّها قد تقفز للحلبة طواعية

271
00:19:02,410 --> 00:19:03,700
أهي غبيّة؟

272
00:19:04,590 --> 00:19:08,400
.دوغرا، لديك مهمّة واحدة

273
00:19:08,400 --> 00:19:11,070
.اقتل أميرة فورتنا

274
00:19:12,350 --> 00:19:17,200
.استدعى الجناح الأسود الجنرال السّابق هولت

275
00:19:17,200 --> 00:19:20,360
هل تعتقد فعلاً أنّ هذا كان
ليحدث عن طريق الخطأ؟

276
00:19:20,360 --> 00:19:22,810
.ربّما علينا إبلاغ الملك

277
00:19:23,780 --> 00:19:27,100
أهذا ما أردت إخباري به؟
.افعل ما يحلو لك

278
00:19:27,570 --> 00:19:28,360
.حاضر

279
00:19:28,730 --> 00:19:30,860
.في تلك الحالة، لنذهب إلى الملك بسرعة

280
00:19:31,580 --> 00:19:33,980
.مهلاً. غيّرتُ رأيي. أنا سأذهب

281
00:19:34,320 --> 00:19:36,480
.عليّ إعادة نينا في كلّ الأحوال

282
00:19:36,890 --> 00:19:39,130
وإبلاغ الملك كانت مجرّد فكرة ثانويّة؟

283
00:19:39,130 --> 00:19:40,930
نينا؟ من تكون؟

284
00:19:40,930 --> 00:19:43,350
.يبدو أنّه اسم طفولة الأميرة أليشا

285
00:19:43,350 --> 00:19:44,500
اسم طفولة؟

286
00:19:45,250 --> 00:19:47,820
.لكنّ فورتنا لا يستعملون أسماء طفولة

287
00:19:48,200 --> 00:19:48,880
ماذا؟

288
00:19:49,960 --> 00:19:52,120
!أيّها الأمير سِت، ثمّة أمر عاجل

289
00:19:52,390 --> 00:19:53,600
!إنّها الأميرة أليشا

290
00:19:56,530 --> 00:20:00,300
لماذا يحاول مهاجمتي؟

291
00:20:00,300 --> 00:20:02,760
!لا علاقة للأميرة بهذا

292
00:20:03,010 --> 00:20:04,260
!ابتعدا

293
00:20:04,260 --> 00:20:06,680
!أنتما تعترضان طريقي

294
00:20:07,600 --> 00:20:10,030
!تسبّبتُ في أذيّة المزيد

295
00:20:10,880 --> 00:20:13,490
.يتشارك كلّ النّاس نفس نقاط الضّعف

296
00:20:13,490 --> 00:20:15,940
...كائنًا من كانوا، بمجرّد ضرب تلك النّقاط

297
00:20:16,920 --> 00:20:19,930
.سأنتهز الفرصة. سأفعل ما باستطاعتي

298
00:20:21,530 --> 00:20:22,940
،حتّى إن لم أستطع الفوز

299
00:20:24,030 --> 00:20:26,030
!الخسارة ليست خيارًا

300
00:20:26,330 --> 00:20:27,140
.نينا

301
00:20:27,990 --> 00:20:29,040
.أزو

302
00:20:32,160 --> 00:20:34,370
.أنا منافسه التّالي

303
00:20:34,370 --> 00:20:36,540
.تراجعي رجاءً أيّتها الأميرة

304
00:20:36,930 --> 00:20:39,050
!أنت تعترض طريقي

305
00:20:41,860 --> 00:20:43,950
هل جسده من حديد؟

306
00:20:44,360 --> 00:20:47,470
.يبدو أنّه لا يشعر بالألم أيضًا
.كم هذا مزعج

307
00:20:47,470 --> 00:20:49,840
.عليّ جعل الأمر يبدو مثل فوز صعب أيضًا

308
00:20:50,560 --> 00:20:52,250
.إنّه موهوب بالفعل

309
00:20:52,250 --> 00:20:54,400
.يبدو لي أنّه يعاني بعض الشّيء

310
00:20:54,400 --> 00:20:57,080
.أحمق. ذلك ما يجعله موهوبًا

311
00:20:58,100 --> 00:21:02,060
ولكن لماذا يحاول قتل أميرة فورتنا؟

312
00:21:02,060 --> 00:21:03,440
أنا ثانية؟

313
00:21:03,880 --> 00:21:06,280
لماذا يواصل المجيء لنجدتي؟

314
00:21:06,280 --> 00:21:09,100
.لا يستطيع أزو القتال جيّدًا هكذا

315
00:21:10,820 --> 00:21:11,950
...أزو

316
00:21:13,240 --> 00:21:15,820
ماذا أفعل؟ ماذا عليّ أن أفعل؟

317
00:21:17,070 --> 00:21:19,920
لا يمكنني فعل أيّ شيء أمام
.كلّ هؤلاء النّاس

318
00:21:22,060 --> 00:21:23,340
.لم أشعر به حتّى

319
00:21:39,630 --> 00:21:40,730
!سِت

320
00:21:43,440 --> 00:21:45,600
هل أنت بخير أيّتها الأميرة؟

321
00:21:46,190 --> 00:21:48,490
.ماذا؟ نـ-نعم

322
00:21:55,450 --> 00:21:58,840
.المسها ثانية وسأقتلك

323
00:21:59,190 --> 00:22:00,520
ألم أخبرك بذلك؟

324
00:23:36,120 --> 00:23:39,230
."اللّيلة الحادية عشرة: "الحبّ المستحيل