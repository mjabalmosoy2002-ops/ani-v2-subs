1
00:00:19,870 --> 00:00:24,620
أيّها الأمير سِت، ما غرضك
من الأميرة في مثل هذه السّاعة؟

2
00:00:25,140 --> 00:00:29,470
،لقد تقيّح جرحها، وأصيبت بحمّى
.لكن لا يوجد ما يدعو للقلق

3
00:00:29,880 --> 00:00:32,360
.مع أنّ الجرح سيترك ندبة

4
00:00:33,860 --> 00:00:35,630
.لم أسألك

5
00:00:36,210 --> 00:00:38,660
.إنّك وقحة بالإضافة لكونك فظّة أيضًا

6
00:00:39,240 --> 00:00:42,380
ألم يتمّ تعليمك أن تنحني للملوك؟

7
00:00:42,380 --> 00:00:44,250
.سامحني

8
00:00:44,250 --> 00:00:47,150
.أرغب في تبديل ضماداتها
.أستأذن منك

9
00:00:47,610 --> 00:00:50,670
.أنت لستِ من فورتنا

10
00:00:50,670 --> 00:00:53,340
هل أنت من ليندورم أم ستاربيا؟

11
00:00:54,940 --> 00:00:59,120
،عندما تكون عيناها مغلقتان
.تبدو كمخلوق صغير ظريف

12
00:01:00,050 --> 00:01:02,290
.إنّها ليست أميرة عاديّة

13
00:01:02,740 --> 00:01:09,040
لقد تربّت داخل جدران القصر النّجميّ
.منذ نعومة أظفارها

14
00:01:09,430 --> 00:01:12,270
إنّها غير مطّلعة بعض الشّيء
.بكيفية سير العالم

15
00:01:12,740 --> 00:01:17,640
فقبل كلّ شيء، إنّها مبعوثة إله النّجوم
.الخاصّ بفورتنا الّذي يتحكّم بالقدر

16
00:01:18,010 --> 00:01:19,940
.إنّ ذلك يجعلها متهوّرة قليلاً

17
00:01:22,030 --> 00:01:26,560
.يحكم القدر؟ يا للغطرسة

18
00:01:27,020 --> 00:01:30,080
.حتّى الجرح السّطحيّ قد يقتل

19
00:01:30,860 --> 00:01:33,070
.إله العالم السّفليّ عادل

20
00:01:33,510 --> 00:01:34,930
.من الأفضل أن تصلّي لها

21
00:03:12,210 --> 00:03:15,460
!خذ هذا يا سِت

22
00:03:15,920 --> 00:03:17,330
...هذا مؤلم

23
00:03:17,330 --> 00:03:18,960
ما الّذي تفعلينه؟

24
00:03:18,960 --> 00:03:22,970
.لن أرضى حتّى أقوم بذلك

25
00:03:23,210 --> 00:03:27,120
،صحيح أنّ جرحك قد التأم
.لكنّه لم يُشفَ بالكامل بعد

26
00:03:27,120 --> 00:03:28,970
.أنا بخير

27
00:03:29,280 --> 00:03:32,930
سأذهب لرؤية سِت بهذه
!الإصابة الّتي بادلتُها بوعده

28
00:03:32,930 --> 00:03:35,480
.سيغيب الأمير سِت لفترة

29
00:03:36,170 --> 00:03:38,220
.غادر للقيام بعمليّة تطهير

30
00:03:38,220 --> 00:03:44,900
فرّت العروستان المحتملتان الأخريتان إلى
.بلديهما، لذلك فسيموت الكثيرون جرّاء ذلك

31
00:03:45,740 --> 00:03:48,180
...إنّهما

32
00:03:49,210 --> 00:03:51,120
ماذا؟ الجميع؟

33
00:03:51,120 --> 00:03:57,420
نعم. يبدو أنّ كلّ أميرة أتت إلى هنا
.بغرض الزّواج عانت عاطفيًّا

34
00:03:57,420 --> 00:03:59,920
شعر الجميع بالأسى حيالهنّ
.ولم يستطيعوا تحمّل مشاهدتهنّ

35
00:04:07,010 --> 00:04:11,220
لذلك عليك أن تكوني حذرة جدًّا
.أيّتها الأميرة أليشا

36
00:04:11,220 --> 00:04:13,520
...إن حدث أيّ شيء كهذا ثانية

37
00:04:13,760 --> 00:04:16,860
.أنا بخير. أنا في أحسن حال الآن

38
00:04:16,860 --> 00:04:18,900
.أنا أقوى ممّا يبدو عليّ

39
00:04:19,130 --> 00:04:24,750
آن، أخبرتك ألاّ تخرجي وحدك
!أثناء غياب الأمير سِت

40
00:04:25,510 --> 00:04:27,780
أثناء غيابه؟ لِمَ لا؟

41
00:04:28,760 --> 00:04:31,460
.لا تهتمّي رجاءً

42
00:04:31,460 --> 00:04:32,860
!سامحني

43
00:04:33,410 --> 00:04:36,540
.تعالي. سأعاقبك

44
00:04:37,780 --> 00:04:41,240
!إنّه قائد الحرس الفاسد ذاك

45
00:04:42,230 --> 00:04:43,800
!ابكي، ابكي

46
00:04:43,800 --> 00:04:46,210
.كلاّ. علينا إيقافه

47
00:04:44,210 --> 00:04:46,770
!هيّا، ابكي أكثر

48
00:04:46,770 --> 00:04:48,390
ما...؟ ماذا؟

49
00:04:49,080 --> 00:04:50,810
يتظاهرون أنّهم لا يرون شيئًا؟

50
00:04:50,000 --> 00:04:51,810
!تعالي! قلتُ تعالي

51
00:04:51,810 --> 00:04:56,560
.إنّ قائد الحرس من النّبلاء

52
00:04:56,560 --> 00:04:57,310
ماذا؟

53
00:04:57,310 --> 00:04:58,950
لذلك لم يقدّم أيّ أحد المساعدة؟

54
00:04:58,950 --> 00:05:00,460
.هيّا، من هنا

55
00:05:03,070 --> 00:05:06,570
!كلاّ! هذا مؤلم

56
00:05:06,570 --> 00:05:09,580
!الجرح الّذي سبّبه لي الأمير سِت

57
00:05:10,030 --> 00:05:11,830
!أنت

58
00:05:11,830 --> 00:05:14,150
!خذيني إلى غرفتي

59
00:05:14,150 --> 00:05:18,030
!عليّ الذّهاب في الحال وإلاّ سأموت

60
00:05:20,760 --> 00:05:23,090
.لا أدري ماذا أقول

61
00:05:23,480 --> 00:05:25,670
.لم يكن لديّ خيار آخر

62
00:05:25,670 --> 00:05:29,890
.واضح أنّ قائد الحرس ذاك رجل خطير

63
00:05:29,890 --> 00:05:31,880
ألا يوجد ما يمكنني فعله؟

64
00:05:36,100 --> 00:05:39,380
.عليك أن تقلقي على نفسك

65
00:05:40,020 --> 00:05:44,610
...إن أزعجت الأمير سِت ثانية

66
00:05:44,610 --> 00:05:47,250
.أتساءل بشأن ذلك بعد كلّ ما سمعتُ عنه

67
00:05:47,250 --> 00:05:50,870
.ربّما يملك سِت قواعد معيّنة لنفسه

68
00:05:51,320 --> 00:05:56,870
ما كان للأمر أن يكون غريبًا
.إن قتلني وقتها، لكنّه لم يفعل

69
00:05:57,090 --> 00:06:00,370
،إنّ سِت يهدّد بالقتل بالفعل

70
00:06:05,030 --> 00:06:07,610
،ربّما لا يقتل إلاّ من يحاولون قتله

71
00:06:07,610 --> 00:06:12,760
.وقد اختار أميرات خصّيصًا للقيام بذلك

72
00:06:12,760 --> 00:06:16,510
.لذلك أعتقد أنّ هذه قد تكون منافسة صبر

73
00:06:18,050 --> 00:06:19,650
أيمكنك هزيمته؟

74
00:06:19,650 --> 00:06:23,400
.ليس عليّ ذلك. عليّ ألاّ أخسر فحسب

75
00:06:23,400 --> 00:06:26,560
.أشكّ أنّه بذلك اللّين

76
00:06:27,720 --> 00:06:32,280
كيف لها أن تكون بهذه الشّجاعة
بعدما حدث لها؟

77
00:06:32,750 --> 00:06:34,810
ألا تقدّر حياتها؟

78
00:06:36,150 --> 00:06:41,340
.هيكامي، أنا أعتمد عليك لاكتشاف الأمور

79
00:06:41,990 --> 00:06:43,710
،يا صاحب الجلالة

80
00:06:44,330 --> 00:06:47,410
.لا يمكنني فهم هذه المزيّفة

81
00:06:47,410 --> 00:06:51,930
ما مدى أهمّيّة الأميرات الأجنبيّات
في هذه القلعة برأيك؟

82
00:06:52,310 --> 00:06:54,840
.سأعلّمك كيف تحمين نفسك

83
00:06:55,770 --> 00:07:00,210
.إنّها ليست غبيّة، لكنّها متهوّرة

84
00:07:01,030 --> 00:07:06,610
،إن كنت لن تغيّري طُرقك
.فسيكون ذلك مفيدًا

85
00:07:11,450 --> 00:07:12,850
.حسنًا

86
00:07:12,850 --> 00:07:16,200
،هذه الملابس فضفاضة قليلاً
.لكن من السّهل التّحرّك فيها

87
00:07:16,480 --> 00:07:18,730
...أيّتها الأميرة أليشا؟ أنا

88
00:07:18,730 --> 00:07:21,210
هل استطعت ارتداء ملابسي يا آن؟

89
00:07:21,210 --> 00:07:24,210
.لا يمكنني إغلاق الأزرار الّتي في الصّدر

90
00:07:26,210 --> 00:07:30,730
...تحديق

91
00:07:26,680 --> 00:07:28,670
.أنا آسفة

92
00:07:28,670 --> 00:07:32,410
،بإمكاني إغلاق البقيّة
.لكنّ الثّوب ضيّق في جهة الصّدر

93
00:07:33,600 --> 00:07:37,210
ما الّذي تخطّطين لفعله أيّتها الأميرة أليشا؟

94
00:07:37,840 --> 00:07:41,350
،قد تكون هذه قيّمة
.لكن لا فائدة منها إن لم نستعملها

95
00:07:41,350 --> 00:07:42,080
.سحب

96
00:07:44,310 --> 00:07:46,510
.سنقتل عصفورين بحجر واحد

97
00:07:48,560 --> 00:07:51,270
!إن قلتُ أنّك لا تستطيع، فلن تستطيع

98
00:07:53,140 --> 00:07:54,950
.يا له من شعور

99
00:07:56,370 --> 00:07:59,670
.لكن يجب أن تكون امرأة

100
00:08:02,230 --> 00:08:03,870
.لم أرَ هذه الوصيفة من قبل

101
00:08:03,870 --> 00:08:06,880
.يا لها من ريشة جميلة

102
00:08:08,380 --> 00:08:10,340
!أنت هناك

103
00:08:11,110 --> 00:08:15,390
!إنّ لمس ممتلكات الأمير سِت جريمة خطيرة

104
00:08:15,390 --> 00:08:17,340
!سأعاقبك

105
00:08:17,340 --> 00:08:19,140
!كلاّ! النّجدة

106
00:08:19,140 --> 00:08:21,040
.لن يأتي أحد لمساعدتك

107
00:08:21,040 --> 00:08:23,140
—إنّ أيّ أحد يتجرّأ على مجابهة

108
00:08:23,140 --> 00:08:25,900
.ولكن هنالك من يجرؤ أيّها الفظّ

109
00:08:26,750 --> 00:08:29,400
!عينان زرقاوان؟ الأميرة أليشا

110
00:08:29,400 --> 00:08:33,400
!النّجدة! هاجم هذا الرّجلُ أميرة

111
00:08:33,750 --> 00:08:35,850
.كان خطأ فحسب

112
00:08:35,850 --> 00:08:37,810
أتسمّي هذا خطأ؟

113
00:08:37,810 --> 00:08:40,160
.انظر. لقد تركتَ كدمة واضحة على يدي

114
00:08:40,380 --> 00:08:46,540
ألم تقل أنّ لمس ممتلكات
الأمير سِت جريمة خطيرة؟

115
00:08:40,660 --> 00:08:42,160
!من هنا

116
00:08:46,740 --> 00:08:49,080
عليك أن تُعاقَب، أليس كذلك؟

117
00:08:49,550 --> 00:08:52,800
.إنّك مجرّد أميرة بلاد صغيرة

118
00:08:53,030 --> 00:08:56,840
هل قائد الحرس أعلى مرتبة من أميرة؟

119
00:08:58,470 --> 00:08:59,300
...سُحقًا لك

120
00:08:59,680 --> 00:09:01,810
!فتاة حقيرة

121
00:09:02,580 --> 00:09:04,850
.لا تحتاجين لتكوني قويّة

122
00:09:05,670 --> 00:09:08,560
.سأستعمل قوّة الخصم ضدّه. استدارة

123
00:09:09,220 --> 00:09:12,210
.سيسمح لك هذا بهزيمة أعدائك بسهولة

124
00:09:12,630 --> 00:09:14,360
.ركّزي اهتمامك على نقاط محدّدة

125
00:09:15,580 --> 00:09:17,820
.يتشارك كلّ النّاس نفس نقاط الضّعف

126
00:09:18,460 --> 00:09:22,450
،حتّى بجسدك الخفيف
...إن ضربتِ نقطة معيّنة بالتّحديد

127
00:09:28,960 --> 00:09:31,700
!ماذا؟

128
00:09:31,700 --> 00:09:36,220
أيّها الحرس، ألقوا بهذا الرّجل
.في الزّنزانة بينما تستطيعون ذلك

129
00:09:36,220 --> 00:09:40,220
لكن ما الّذي سيقوله الأمير سِت عندما يعود؟

130
00:09:40,440 --> 00:09:42,560
.سيكون ذلك رائعًا

131
00:09:42,560 --> 00:09:45,980
،لا يُسمح لي بالحديث معه أوّلاً
.لذلك كنتُ أتساءل ما العمل

132
00:09:46,210 --> 00:09:48,490
.صار لديّ سبب للحديث معه الآن

133
00:09:48,490 --> 00:09:51,480
.اتّضح أنّه حتّى قائد الحرس الفاسد هذا مفيد

134
00:09:51,480 --> 00:09:54,440
.احرصوا على إبلاغ الأمير سِت بكلّ هذا

135
00:09:56,240 --> 00:09:59,090
.ربّما هذه الأميرة مختلفة

136
00:09:59,400 --> 00:10:01,240
...حتّى إن صادقناها بينما نخدمها

137
00:10:01,480 --> 00:10:05,750
فربّما لن نضطرّ لمشاهدتها
.تغرق في اليأس

138
00:10:05,990 --> 00:10:08,530
.عليك تغيير ملابسك أيّتها الأميرة أليشا

139
00:10:08,950 --> 00:10:10,630
.سأحضّر لك بعض الشّاي

140
00:10:10,630 --> 00:10:12,500
أتريدين بعض المخبوزات؟

141
00:10:12,500 --> 00:10:18,760
!أيّتها الأميرة أليشا! أيّتها الأميرة أليشا
!أيّتها الأميرة أليشا

142
00:10:17,040 --> 00:10:17,820
!نعم

143
00:10:24,720 --> 00:10:27,730
.مرحبًا أيّها الأمير سِت

144
00:10:29,330 --> 00:10:32,230
هل حدث شيء ما خارج العادة؟

145
00:10:32,630 --> 00:10:34,600
.لقد تغيّر الجوّ العامّ للقلعة

146
00:10:34,600 --> 00:10:36,610
...في الحقيقة

147
00:10:38,850 --> 00:10:39,720
ماذا؟

148
00:10:41,270 --> 00:10:43,780
.كانت هنالك مناوشات بسيطة في منطقة كوسك

149
00:10:43,780 --> 00:10:44,810
فعلاً؟

150
00:10:46,950 --> 00:10:48,690
ما عذرك؟

151
00:10:48,690 --> 00:10:52,070
.استعملتِ اسمي للزّجّ برجل في الزّنزانة

152
00:10:52,380 --> 00:10:54,780
هل تعتقدين نفسك سيّدة هذه القلعة؟

153
00:10:57,340 --> 00:10:59,540
.كان ذلك ضروريًّا

154
00:10:59,540 --> 00:11:01,240
.كان يزعج الجميع

155
00:11:01,240 --> 00:11:03,510
الجميع؟ قلعة من هذه؟

156
00:11:03,740 --> 00:11:06,520
!إنّه خطؤك أنت لسماحك له بفعل ما يحلو له

157
00:11:07,790 --> 00:11:09,760
.سأقطعك حتّى العظم هذه المرّة

158
00:11:11,810 --> 00:11:14,520
.اهدئي. لا ترتعدي

159
00:11:14,960 --> 00:11:16,610
.لن يحدث ذلك

160
00:11:16,990 --> 00:11:19,890
.فقبل كلّ شيء، لن أقدم على أذيّتك

161
00:11:20,210 --> 00:11:21,140
—ما الّذي تعـ

162
00:11:21,140 --> 00:11:22,280
!سِت

163
00:11:22,280 --> 00:11:25,440
!سِت! سِت! نينا

164
00:11:25,440 --> 00:11:26,790
!أنت ثانية

165
00:11:26,790 --> 00:11:30,550
!حسنًا، حسنًا! على الأقلّ انزل هنا

166
00:11:33,520 --> 00:11:37,500
...عينا المبعوثة المقدّسة الزّرقاوين

167
00:11:38,550 --> 00:11:40,980
.يا إلهي. هذا مؤلم

168
00:11:40,980 --> 00:11:43,550
.سأجعلك مسؤولة عن رعاية نينا

169
00:11:43,550 --> 00:11:44,300
ماذا؟

170
00:11:44,640 --> 00:11:46,980
.أقول أنّني سأبقيك قريبة منّي

171
00:11:47,660 --> 00:11:51,080
.يمكنك الرّفض إن أردت
فما قولك؟

172
00:11:52,970 --> 00:11:54,590
.هذا تحدٍّ

173
00:11:55,380 --> 00:11:58,380
.لا، أودّ ذلك

174
00:12:00,940 --> 00:12:02,240
!لن يهزمني

175
00:12:05,130 --> 00:12:07,450
.سِت غبيّ، غبيّ

176
00:12:07,450 --> 00:12:10,450
.نينا غبيّة، غبيّة

177
00:12:10,450 --> 00:12:12,770
"!قلتُ "سِت غبيّ

178
00:12:12,770 --> 00:12:15,080
!نينا غبيّة

179
00:12:15,340 --> 00:12:17,980
.يُزعجني جدًّا أنّها لا تقصد اسمها

180
00:12:17,980 --> 00:12:19,610
.أشعر أنّها تتعمّد ذلك

181
00:12:20,230 --> 00:12:21,590
!أنت تحبّين هذه الحبوب

182
00:12:23,070 --> 00:12:24,090
أتريدينها؟

183
00:12:27,370 --> 00:12:28,910
!هذا مؤلم

184
00:12:28,910 --> 00:12:32,770
كنتُ أمزح فحسب! لم آكلها، أترين؟

185
00:12:32,770 --> 00:12:35,850
.اخرسي. لا يمكنني أخذ قيلولتي هكذا

186
00:12:36,110 --> 00:12:38,480
.طائرك الصّغير من عليها أن تخرس

187
00:12:38,480 --> 00:12:39,360
.سِت

188
00:12:40,470 --> 00:12:42,730
.صوت نينا أشبه بالنّسيم العليل

189
00:12:42,730 --> 00:12:44,610
.أنت المزعجة هنا

190
00:12:49,170 --> 00:12:50,740
.سِت نائم

191
00:12:51,620 --> 00:12:52,630
ما هذا؟

192
00:12:53,620 --> 00:12:55,590
.قد تصاب بالزّكام

193
00:12:55,590 --> 00:12:59,140
يا لي من ملكة متفهّمة، صحيح؟

194
00:13:00,090 --> 00:13:02,880
.فهمت. إنّك خادمة متفهّمة بالفعل

195
00:13:03,380 --> 00:13:05,900
.لا تقدّم اليوم

196
00:13:05,900 --> 00:13:08,890
.أنا لا أخسر، لكنّي لا أفوز أيضًا

197
00:13:09,750 --> 00:13:14,320
.أتيتُ إلى هنا لأصير ملكة وأحمي فورتنا

198
00:13:15,740 --> 00:13:22,290
لكنّ سِت يعتقد أنّ الملكات
.مجرّد أدوات ليُبرّر غزواته

199
00:13:23,350 --> 00:13:28,410
...كنتُ آمل أن يُغيّره هذا، لكن

200
00:13:28,760 --> 00:13:31,910
.لا يروق لي تحديقك بي
.غادري في الحال

201
00:13:31,910 --> 00:13:34,850
.نعم، نعم. سأستأذن بالذّهاب

202
00:13:34,850 --> 00:13:37,920
.لكنّي سأعود، فأنا مسؤولة عن طائرك

203
00:13:37,920 --> 00:13:40,660
.ليت كان هنالك شيء آخر ليساعدني

204
00:13:40,660 --> 00:13:43,270
.صحيح. نسيت إخبارك

205
00:13:44,230 --> 00:13:48,050
.سنذهب إلى غالغادا لبعض الوقت

206
00:13:48,050 --> 00:13:49,430
.جهّزي نفسك

207
00:13:49,430 --> 00:13:50,290
ماذا؟

208
00:13:51,650 --> 00:13:53,680
!ماذا؟

209
00:13:54,700 --> 00:13:56,940
!يا لها من أخبار ممتازة

210
00:13:56,940 --> 00:14:00,160
.لم يذهب أيّ أحد إلى غالغادا من قبل

211
00:14:00,160 --> 00:14:03,190
.ربّما بدأت أخيرًا تروقين للأمير سِت

212
00:14:04,190 --> 00:14:05,690
أتعتقدن ذلك؟

213
00:14:05,690 --> 00:14:07,330
.نعم

214
00:14:07,330 --> 00:14:09,450
.عرفنا أنّ بإمكانك ذلك أيّتها الأميرة أليشا

215
00:14:11,520 --> 00:14:15,390
.لا يبدو لي أنّي أروق للأمير سِت بعد

216
00:14:16,430 --> 00:14:18,100
.سيُقام زفافك في الرّبيع

217
00:14:18,490 --> 00:14:23,600
،إن تمّت دعوتك في هذا الوقت
.فربّما يراودهم الفضول لرؤيتك

218
00:14:23,600 --> 00:14:26,320
.واثقة أنّهم تلقّوا تقارير مختلفة عنك

219
00:14:26,720 --> 00:14:29,830
يحمل كلام هيكامي معانٍ أكثر
.ممّا يبدو عليه دائمًا

220
00:14:29,830 --> 00:14:32,720
.تمّ تغيير قائد الحرس أيضًا

221
00:14:33,000 --> 00:14:35,720
.قد يكون هذا نقطة تحوّل حاسمة بالنّسبة لك

222
00:14:36,510 --> 00:14:38,190
نقطة تحوّل حاسمة؟

223
00:14:39,670 --> 00:14:42,980
.موافقة الوالدين ضروريّة لأيّ زواج

224
00:14:43,280 --> 00:14:49,160
صحيح. سيكون من السّهل حماية
.فورتنا إن أحبّتي عائلته

225
00:14:50,530 --> 00:14:51,260
.حسنًا

226
00:14:51,490 --> 00:14:53,890
سمعتُ أنّ ملك غالغادا شخص صارم

227
00:14:53,890 --> 00:14:57,250
.وسّع البلاد وقاد شعبه

228
00:14:57,250 --> 00:14:59,760
هل هو مثل جدّ أزو الأكبر؟

229
00:15:00,000 --> 00:15:03,540
.لا بدّ أنّ الأمير سِت مميّز

230
00:15:03,540 --> 00:15:07,620
،إنّ لديه أخوان أكبر منه
.لكن هو من سيرث العرش

231
00:15:07,620 --> 00:15:09,760
إذًا فسِت مثل موهولوم؟

232
00:15:10,270 --> 00:15:15,260
.قد يعرف خدم الأمير سِت أكثر عنه منّا نحن

233
00:15:15,730 --> 00:15:18,780
.لا يمكننا قول أيّ شيء عن هذا الموضوع

234
00:15:18,780 --> 00:15:20,520
.توقّعتُ هذا

235
00:15:20,760 --> 00:15:22,570
...في تلك الحالة

236
00:15:23,650 --> 00:15:26,370
.سأذهب للمصدر مباشرة

237
00:15:27,510 --> 00:15:30,620
.أنا متحمّسة جدًّا للذّهاب إلى غالغادا

238
00:15:30,620 --> 00:15:34,000
.أتطلّع قُدمًا للقاء الملك وإخوتك

239
00:15:35,120 --> 00:15:37,380
.أتساءل كيف سيكونون

240
00:15:38,630 --> 00:15:40,560
.لا تستعملي نينا كعذر للكلام معي

241
00:15:40,560 --> 00:15:43,500
أتودّ الحديث أيّها الأمير سِت؟

242
00:15:43,500 --> 00:15:45,040
.يا لك من فتاة ماكرة

243
00:15:45,540 --> 00:15:48,350
هل تعتقدين أنّ هذه فرصة لكسب ودّهم؟

244
00:15:49,070 --> 00:15:50,320
.نعم

245
00:15:51,420 --> 00:15:55,050
لا يمكنك. إنّهم ليسوا من النّوع
.الّذي تظنّينه

246
00:15:55,360 --> 00:15:56,660
.لا بأس

247
00:15:56,660 --> 00:16:01,810
.إنّ كلاًّ من أبي وجدّي الأكبر شخصان غريبان للغاية

248
00:16:02,050 --> 00:16:04,280
ولكن ما أتطلّع له أكثر

249
00:16:04,280 --> 00:16:08,480
.هو التّعرّف عليك أكثر عن طريق لقاء عائلتك

250
00:16:08,480 --> 00:16:12,450
أودّ التّقرّب إليك أكثر
.بصفتي ملكتك المستقبليّة

251
00:16:12,700 --> 00:16:15,700
عائلة؟ لأشخاص ملكيّين؟

252
00:16:15,700 --> 00:16:17,010
.اقتربي

253
00:16:18,610 --> 00:16:19,920
.اركعي هنا

254
00:16:21,750 --> 00:16:24,600
.تمّت تربيتك كراهبة رغم أنّك أميرة

255
00:16:24,600 --> 00:16:25,950
،ولمصلحة بلادك

256
00:16:25,950 --> 00:16:28,630
.تمّ إرسالك فجأة للزّواج كرهينة

257
00:16:29,170 --> 00:16:32,430
لا تشتكين عندما يتصرّف زوجك
.المستقبليّ معك ببرود

258
00:16:32,430 --> 00:16:38,220
تواصلين القيام بواجبك نحو بلادك
.دون أيّ كره أو قلق

259
00:16:38,660 --> 00:16:40,970
أنت مخلصة جدًّا لدرجة
.أنّ هذا يُشعرني بالغثيان

260
00:16:40,970 --> 00:16:46,410
ماذا؟ ألا يحبّ كيف يتصرّف
الأشخاص الملكيّون أيضًا؟

261
00:16:47,750 --> 00:16:50,480
.إنّه ليس إخلاصًا

262
00:16:50,920 --> 00:16:53,740
.إنّه خياري

263
00:16:56,560 --> 00:16:59,740
.لا تعرف الخوف ولا تهتمّ

264
00:16:59,740 --> 00:17:01,860
.طيبة غير مدنَّسة

265
00:17:02,760 --> 00:17:06,250
.راهبة للإله. تجسيد للإله

266
00:17:06,480 --> 00:17:10,250
.هذه هي أكثر الأشياء الّتي أكرهها في هذا العالم

267
00:17:14,200 --> 00:17:16,160
.يُفترض أن تُدنّس

268
00:17:33,530 --> 00:17:35,400
هل كبرت بعض الشّيء؟

269
00:17:42,030 --> 00:17:46,530
!أيّها الغبيّ! أيّها الغبيّ، أيّها الغبيّ، أيّها الغبيّ

270
00:17:46,960 --> 00:17:50,940
!هل كبرت؟ سل نفسك ذلك أيّها الرّضيع الضّخم

271
00:17:50,940 --> 00:17:53,520
!لم تقع حتّى في حبّ أيّ أحد آخر من قبل

272
00:17:56,020 --> 00:17:58,930
لقد أفسدت الأمر. ما الّذي سأفعله؟

273
00:17:58,930 --> 00:18:00,340
.بالغتُ في ردّة فعلي

274
00:18:01,330 --> 00:18:08,400
.جعلني ذلك حزينة أكثر من غاضبة أو محبطة

275
00:18:08,840 --> 00:18:10,300
.لكنّي لن أبكي

276
00:18:14,840 --> 00:18:17,480
.يتطلّب الوصول إلى غالغادا عشرة أيّام

277
00:18:19,440 --> 00:18:22,580
أما زلت متعبة أيّتها الأميرة أليشا؟

278
00:18:22,820 --> 00:18:23,580
ماذا؟

279
00:18:24,430 --> 00:18:27,480
...تبدين محبطة مؤخّرًا

280
00:18:27,480 --> 00:18:30,080
ذلك ليس صحيحًا. أرأيت؟

281
00:18:32,990 --> 00:18:37,190
.انتهبي لخطواتك. الأرضيّة موحلة

282
00:18:37,190 --> 00:18:39,840
.كانت تُمطر بشدّة حتّى البارحة

283
00:18:39,840 --> 00:18:43,300
.حسنًا. سنغادر قريبًا

284
00:18:43,300 --> 00:18:44,870
ماذا؟ بهذه السّرعة؟

285
00:18:44,870 --> 00:18:46,730
.سنأخذ طريقًا آخر

286
00:18:47,140 --> 00:18:50,370
كان هناك انهيار أرضيّ على الطّريق
.الّذي يسلكه النّاس عادة

287
00:18:53,250 --> 00:18:56,050
.أنا مسرورة لأنّ لديّ عربتي الخاصّة

288
00:18:58,720 --> 00:19:02,730
.كان عقلي مكفهرًّا، مثل هذه السّماء

289
00:19:07,210 --> 00:19:12,380
.لا بأس. لا يوجد ما يدعو للخوف

290
00:19:12,630 --> 00:19:15,400
!كونوا حذرين ألاّ تنزلقوا

291
00:19:15,880 --> 00:19:19,380
.آمل أن تكون هيكامي وآن بخير

292
00:19:34,390 --> 00:19:36,160
...هذا مؤلم

293
00:19:38,320 --> 00:19:41,420
هل انزلقتُ إلى هنا؟

294
00:19:42,820 --> 00:19:46,330
...أنا محظوظة. هذا مؤلم

295
00:19:49,870 --> 00:19:51,080
!نينا

296
00:19:51,370 --> 00:19:52,470
...مستحيل

297
00:19:58,270 --> 00:20:01,050
!نينا! كلاّ! عليك العودة

298
00:20:01,590 --> 00:20:05,240
!نينا! نينا

299
00:20:05,610 --> 00:20:07,600
أين أنت؟

300
00:20:08,220 --> 00:20:09,850
...هذا مؤلم

301
00:20:10,460 --> 00:20:12,390
.لا بدّ أنّها خائفة

302
00:20:12,700 --> 00:20:15,110
.عليّ إخبارها أنّ كلّ شيء بخير

303
00:20:17,370 --> 00:20:20,430
.كلاّ، تلطّخ فستاني بالوحل

304
00:20:20,430 --> 00:20:22,360
.ستغضب هيكامي كثيرًا

305
00:20:22,920 --> 00:20:26,450
.أتساءل إن كانت آن قلقة

306
00:20:27,130 --> 00:20:28,870
.كتفي يؤلمني

307
00:20:29,210 --> 00:20:31,370
لماذا يحدث هذا؟

308
00:20:33,550 --> 00:20:35,250
.أشعر بالبرد

309
00:20:35,250 --> 00:20:38,130
هل اقترفتُ خطأ ما؟

310
00:20:38,830 --> 00:20:41,380
.أشعر أنّ جسدي صار ثقيلاً

311
00:20:41,380 --> 00:20:44,380
هل يعاقبني الإله؟

312
00:20:47,760 --> 00:20:49,240
لأنّي اعتقدتُ أنّ بإمكاني أن أصير ملكة؟

313
00:20:50,140 --> 00:20:54,030
...هذا مؤلم... مؤلم

314
00:20:54,580 --> 00:20:57,700
لأنّي كذبت عليه؟

315
00:20:58,340 --> 00:21:01,450
من أيّ طريق أتيت؟

316
00:21:03,150 --> 00:21:06,530
.لن يأتي أيّ أحد لإنقاذي

317
00:21:10,160 --> 00:21:14,320
.أنا لستُ أليشا الحقيقيّة في نهاية المطاف

318
00:21:14,960 --> 00:21:19,050
.ربّما سأموت هنا بدون اسم

319
00:21:20,740 --> 00:21:22,670
.أريد العودة إلى فورتنا

320
00:21:24,890 --> 00:21:28,410
.العودة للمنزل. أريد العودة

321
00:21:29,950 --> 00:21:32,620
هل سيسامحني؟

322
00:21:33,550 --> 00:21:37,440
...قلبه هو كلّ ما أحتاجه، فرجاءً

323
00:21:38,940 --> 00:21:40,790
ما...؟ ماذا؟

324
00:21:41,740 --> 00:21:44,190
.ثمّة شيء ما هناك

325
00:21:46,560 --> 00:21:48,030
.عيون ذهبيّة

326
00:21:57,900 --> 00:21:58,960
!أزو

327
00:23:36,050 --> 00:23:38,930
".اللّيلة السّابعة: حلم البلاد العظيمة"