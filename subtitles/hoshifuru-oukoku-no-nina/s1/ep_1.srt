1
00:00:01,870 --> 00:00:05,070
.سيقتلني ذلك الرّجل للمرّة الثّانية

2
00:00:05,720 --> 00:00:09,480
...لذلك أرجو على الأقلّ أن

3
00:00:09,960 --> 00:00:11,570
.أحضروا المجرمة إلى هنا

4
00:00:15,090 --> 00:00:16,390
تفهمين، صحيح؟

5
00:00:16,970 --> 00:00:19,740
.التّآمر ضدّنا جريمة خطيرة

6
00:00:20,230 --> 00:00:21,000
.نعم

7
00:00:22,550 --> 00:00:25,210
.أرجو أنّ تنظر إليّ مرّة أخرى

8
00:02:03,690 --> 00:02:05,420
!لصّة

9
00:02:05,420 --> 00:02:06,980
!توقّفي

10
00:02:11,790 --> 00:02:12,980
!هنا يا نينا

11
00:02:18,640 --> 00:02:20,270
!توقّفي

12
00:02:21,390 --> 00:02:22,370
.سُحقًا

13
00:02:24,890 --> 00:02:27,500
.أهلا بعودتكما يا ساجي ونينا

14
00:02:27,770 --> 00:02:29,350
.شكرًا لك يا كولين

15
00:02:29,350 --> 00:02:31,180
لا مانع من أن تجلس؟

16
00:02:31,180 --> 00:02:33,200
.نعم. أشعر بتحسّن

17
00:02:33,200 --> 00:02:34,030
كيف سار الأمر؟

18
00:02:34,030 --> 00:02:35,010
.متّع نظرك

19
00:02:35,010 --> 00:02:36,130
!هذا المتوقّع منك

20
00:02:36,130 --> 00:02:38,580
كنّا نعيش نحن الثّلاثة عيش الكفاف

21
00:02:38,580 --> 00:02:42,390
عن طريق سرقة أغراض نفيسة
.من الأثرياء من وقت لآخر

22
00:02:43,850 --> 00:02:47,340
مات العديد من النّاس خلال
.الطّاعون قبل خمس سنوات

23
00:02:47,340 --> 00:02:51,540
صرنا مضطرّين للقيام بهذا للنّجاة
.بعد فقداننا لعائلاتنا

24
00:02:52,150 --> 00:02:55,830
،وبيننا نحن الثّلاثة
.ساجي وكولين أخوان حقيقيّان

25
00:02:56,250 --> 00:02:58,290
.يبدو أنّه يوجد الكثير هنا

26
00:02:59,040 --> 00:03:00,650
.انظري يا نينا

27
00:03:01,020 --> 00:03:02,410
.إنّها تشبه عينيك تمامًا

28
00:03:02,410 --> 00:03:04,490
.لازورد غامق اللّون مثل سماء ما قبل الفجر

29
00:03:04,940 --> 00:03:06,040
.توقّف عن هذا

30
00:03:06,040 --> 00:03:09,880
.عيناها جميلتان للغاية
.خسارة أن تقوم بإخفائهما

31
00:03:09,880 --> 00:03:13,420
سيسعى تجّار العبيد خلفها
.إن لم تخفهما أيّها الغبيّ

32
00:03:14,700 --> 00:03:16,760
.إنّ العيون مثل عينيها نادرة جدًّا

33
00:03:16,760 --> 00:03:19,990
،وبما أنّها نادرة
.فالكثير من الأغنياء يرغبون بها

34
00:03:20,410 --> 00:03:21,930
.سأعدّ شيئًا ما للأكل

35
00:03:22,830 --> 00:03:27,930
،كنّا جائعين ومفلسين دائمًا
.لكن كان وضعنا مريحًا

36
00:03:28,230 --> 00:03:31,270
.طبخك سيّئ للغاية يا نينا

37
00:03:31,270 --> 00:03:32,250
أليس كذلك؟

38
00:03:32,250 --> 00:03:33,270
.اخرسا

39
00:03:33,860 --> 00:03:37,530
.كان حالنا جيّدًا، نضحك ونستمتع بوقتنا دائمًا

40
00:03:38,520 --> 00:03:39,510
...ظننتُ

41
00:03:41,010 --> 00:03:43,990
.ظننتُ أنّ ذلك سيدوم للأبد

42
00:03:47,830 --> 00:03:49,960
.إنّ حرارته لا تنخفض

43
00:03:50,800 --> 00:03:52,830
.إنّه هالك

44
00:03:52,830 --> 00:03:55,560
.عمّ تتحدّث؟ نحن لا نعلم ذلك

45
00:03:55,560 --> 00:03:56,860
—إن بحثنا عن طبيب

46
00:03:56,860 --> 00:03:58,860
!لا مال لدينا لشيء كهذا

47
00:04:01,240 --> 00:04:04,590
."هذا ما يعنيه "ما تشاؤه النّجوم

48
00:04:05,690 --> 00:04:08,200
.نكون فقراء بسبب نجمة وُلدنا تحتها

49
00:04:09,040 --> 00:04:11,670
.نكون أغنياء بسبب نجمة وُلدنا تحتها

50
00:04:12,300 --> 00:04:15,780
.إنّ كلّ شيء محدّد وقت ولادتنا

51
00:04:16,860 --> 00:04:20,110
—ذلك ليس صحيحًا! يومًا ما، سوف

52
00:04:20,110 --> 00:04:24,300
!يومًا ما؟ قد لا يعيش كولين ليرى الغد حتّى

53
00:04:24,740 --> 00:04:28,880
"بإمكانك الحديث عن "يوم ما
!فقط لأنّك غريبة عنّا

54
00:04:29,260 --> 00:04:30,300
...غريبة

55
00:04:32,460 --> 00:04:34,780
!لا يهمّ! سأجد حلاًّ ما

56
00:04:34,780 --> 00:04:36,130
!أيّها الغبيّ ساجي

57
00:04:40,170 --> 00:04:43,250
،اسرق شيئًا ما ثانية
!وسيكون ذلك آخر شيء تسرق يا فتى

58
00:04:43,250 --> 00:04:44,760
!يا لك من جرذ شوارع

59
00:04:45,950 --> 00:04:48,340
.أنا غبيّة

60
00:04:48,340 --> 00:04:51,920
الأمر أصعب على ساجي بما
.أنّه أخوه الحقيقيّ

61
00:04:57,980 --> 00:05:00,360
.عيناي الزّرقاوان مختلفتان عن أعين الآخرين

62
00:05:01,030 --> 00:05:02,820
.أنا وحيدة تمامًا

63
00:05:03,660 --> 00:05:06,340
.أتساءل إن كان هنالك أيّ شخص لأجلي

64
00:05:09,430 --> 00:05:12,970
.شخص واحد سيفي بالغرض
...كائنًا من كان

65
00:05:13,750 --> 00:05:16,930
.أريد أن أكون مميّزة بالنّسبة لشخص ما فحسب

66
00:05:23,150 --> 00:05:24,170
كيف هي الأميرة؟

67
00:05:24,780 --> 00:05:26,490
.مستحيل أن تكون قد نجت

68
00:05:26,980 --> 00:05:28,970
.لم أتوقّع أبدًا أن يحدث هذا

69
00:05:29,880 --> 00:05:31,180
ماذا سنفعل؟

70
00:05:31,580 --> 00:05:33,620
.لا يجب أن يعرف أيّ أحد بهذا

71
00:05:33,970 --> 00:05:36,160
خيارنا الوحيد هو العثور على
.بديلة في أقرب وقت ممكن الآن

72
00:05:38,770 --> 00:05:39,640
...أليشا

73
00:05:43,410 --> 00:05:46,200
.نينا، آسف بشأن ما حدث ذلك اليوم

74
00:05:46,200 --> 00:05:49,210
.لا، أنا من عليها أن تعتذر

75
00:05:52,290 --> 00:05:55,810
.أريدك أن ترافقيني إلى مكان ما

76
00:05:55,810 --> 00:05:57,640
.أكيد. بالطّبع

77
00:06:01,210 --> 00:06:02,160
هذا هو المكان؟

78
00:06:02,160 --> 00:06:06,420
.لا يستطيع أيّ منّا مواصلة العيش هكذا

79
00:06:06,730 --> 00:06:07,720
ساجي؟

80
00:06:08,040 --> 00:06:11,730
.أدركتُ أنّ هذا هو الخيار الأفضل

81
00:06:13,100 --> 00:06:13,800
ماذا؟

82
00:06:14,990 --> 00:06:16,240
.آسف يا نينا

83
00:06:18,200 --> 00:06:19,250
.لقد باعني

84
00:06:20,250 --> 00:06:21,610
.إنّهما تجّار عبيد

85
00:06:25,110 --> 00:06:27,000
.كن لطيفًا معه

86
00:06:27,340 --> 00:06:29,210
.إن أصبته، فسيضيع كلّ هذا هباءً

87
00:06:29,210 --> 00:06:31,240
.حاضر. أرجو أن تسامحني

88
00:06:32,190 --> 00:06:33,620
...ساجي

89
00:06:33,880 --> 00:06:37,330
ساجي، لماذا يا ساجي؟

90
00:06:37,330 --> 00:06:39,270
أكنتَ غاضبًا لذلك الحدّ؟

91
00:06:39,270 --> 00:06:42,630
ما عدت تريدني إلى جانبك الآن
بعد رحيل كولين؟

92
00:06:43,760 --> 00:06:45,130
...إنّ قلبي

93
00:06:45,380 --> 00:06:48,580
.إنّ قلبي يتألّم كثيرًا لدرجة الموت

94
00:06:46,800 --> 00:06:48,950
هل هذا الفتى يبكي؟

95
00:06:48,950 --> 00:06:52,050
.لا بدّ أنّه خائف
.إنّه مجرّد طفل في النّهاية

96
00:06:52,050 --> 00:06:54,180
.هذا لا يهمّ. ما يهمّنا هما عيناه

97
00:06:54,180 --> 00:06:56,130
...إن كانتا كما قيل لنا

98
00:06:57,160 --> 00:06:58,180
.أرني عينيك

99
00:07:00,340 --> 00:07:02,810
.فهمت. إنّهما زرقاوان بالفعل

100
00:07:04,650 --> 00:07:06,280
...عينان ذهبيّتان

101
00:07:08,270 --> 00:07:10,350
.عيون وحش

102
00:07:11,520 --> 00:07:14,730
.في كلّ الأحوال، إنّه متّسخ
.رائحته لا تُطاق

103
00:07:14,730 --> 00:07:15,950
.اخلع ملابسه وأحضر ملابس أخرى

104
00:07:15,950 --> 00:07:16,790
.حاضر

105
00:07:16,790 --> 00:07:17,830
ماذا؟

106
00:07:19,420 --> 00:07:20,710
!توقّف

107
00:07:20,710 --> 00:07:23,040
!هذا مؤلم! انتظر أيّها الشّقيّ

108
00:07:23,330 --> 00:07:25,320
!لا تسبّب أيّ مشاكل

109
00:07:25,320 --> 00:07:27,050
!اتركني

110
00:07:27,460 --> 00:07:31,170
لا تتحرّك! سنغيّر ملابسك
!المتّسخة هذه فحسب

111
00:07:31,170 --> 00:07:33,530
!توقّف! لا أريد

112
00:07:40,590 --> 00:07:41,500
فتاة؟

113
00:07:41,930 --> 00:07:45,370
لماذا كانت ترتدي ملابس أولاد؟

114
00:07:45,810 --> 00:07:47,930
.إنّها يتيمة بعينين زرقاوين

115
00:07:48,240 --> 00:07:50,380
.ربّما كان ذلك لتفادي تجّار العبيد

116
00:07:50,740 --> 00:07:51,690
ماذا نفعل؟

117
00:07:52,050 --> 00:07:53,930
.إنّ هذا يناسب خططنا بالكامل

118
00:07:53,930 --> 00:07:55,940
.ما عادت هنالك حاجة للتّظاهر أنّها فتاة الآن

119
00:07:55,940 --> 00:07:58,490
.صارت الآن أكثر من مجرّد حلّ مؤقّت

120
00:08:00,490 --> 00:08:01,950
.اسمعي يا فتاة

121
00:08:02,790 --> 00:08:04,500
...ستموتين اليوم

122
00:08:04,770 --> 00:08:07,490
.وستعيشين كأميرة

123
00:08:13,230 --> 00:08:16,260
!مهلاً، انتظري

124
00:08:16,260 --> 00:08:18,760
!لن أنتظر فقط لأنّ ذلك ما تريدينه منّي

125
00:08:21,860 --> 00:08:23,150
ما كلّ هذا الضّجيج؟

126
00:08:23,150 --> 00:08:26,020
...مولاي أزور! في الحقيقة

127
00:08:26,360 --> 00:08:28,450
...هذا مؤلم

128
00:08:32,360 --> 00:08:35,280
هذه هي ذلك الفتى القذر؟

129
00:08:35,780 --> 00:08:38,440
!أنت ذو العينين الذّهبيّتين

130
00:08:39,700 --> 00:08:43,150
.أرى أنّك لا تزالين على حالك في الدّاخل

131
00:08:43,150 --> 00:08:45,790
من تكون يا هذا؟

132
00:08:46,410 --> 00:08:47,930
.اركعي أيّتها الفتاة

133
00:08:50,920 --> 00:08:53,580
.من غير المسموح لك بردّ الكلام على الآخرين

134
00:08:53,580 --> 00:09:01,000
،ابتداءً من هذه اللّحظة، اسمك أليشا
،الأميرة الرّاهبة الجميلة لهذه البلاد

135
00:09:01,000 --> 00:09:04,180
والّتي تملك عينين بلون اللاّزورد
.مثل إله النّجوم

136
00:09:04,470 --> 00:09:05,760
،في الشّهور الثّلاثة القادمة

137
00:09:05,760 --> 00:09:09,290
ستتعلّمين كيف تتصرّفين مثل
.أميرة وكيف تتأنّقين بكلّ جمال

138
00:09:09,290 --> 00:09:15,850
.ثمّ ستتزوّجين الأمير الّذي سيرث عرش غالغادا

139
00:09:17,010 --> 00:09:20,260
.لا يجب أن يعرف أحد أنّك مزيّفة

140
00:09:21,350 --> 00:09:24,710
ذلك هو واجبك. أهذا مفهوم؟

141
00:09:30,810 --> 00:09:33,540
!قد تكون شخصًا مهمًّا للغاية

142
00:09:33,540 --> 00:09:37,220
.ما عدت خائفة لأنّه ما عاد لي ما أخسره

143
00:09:37,220 --> 00:09:40,220
!لكنّك تطلب منّي خدمة

144
00:09:45,230 --> 00:09:47,370
إنّ تصويب مقبض السّيف ناحيتي
.لن يفيدك بشيء

145
00:09:49,460 --> 00:09:51,430
!في كلّ الأحوال، قوّم تصرفاتك

146
00:09:51,430 --> 00:09:54,700
!وأيضًا أيّها الذّهبيّ، أخبرني من أنت

147
00:09:54,700 --> 00:09:58,070
!وإلاّ سأغادر ولن أقوم بأيّ شيء من أجلك

148
00:09:58,070 --> 00:10:01,960
فعلاً؟ وهل لشخص فقير مثلك مكان ليعود إليه؟

149
00:10:01,960 --> 00:10:02,890
!...أيّها الـ

150
00:10:04,130 --> 00:10:07,950
.لكنّي أدرك ما الّذي تحاولين قوله
.أعتذر على فظاظتي

151
00:10:07,950 --> 00:10:10,500
هل هذا اعتذار بالفعل؟

152
00:10:10,500 --> 00:10:16,630
أيّتها الأميرة، أنا سيّدك المسؤول عن تدريبك
...خلال الأشهر الثّلاثة القادمة

153
00:10:17,960 --> 00:10:22,490
.الابن الثّاني لفورتنا، أزور سث فورتنا

154
00:10:24,780 --> 00:10:25,660
!نعم

155
00:10:26,310 --> 00:10:28,360
كم مرّة عليّ تكرار هذا؟

156
00:10:28,360 --> 00:10:31,610
.لا أحد يقول "نعم" بهذه العدوانيّة
!حاولي ثانية

157
00:10:32,020 --> 00:10:33,730
.سُحقًا لك أيّها الذّهبيّ

158
00:10:33,730 --> 00:10:39,030
إنّه يرغمني على قول نفس
.الشّيء مرارًا طوال الصّباح

159
00:10:39,290 --> 00:10:41,030
ما هذه التّعابير؟

160
00:10:42,000 --> 00:10:45,830
لا تتوقّع منّي أن أتذكّر كلّ هذا
.مرّة واحدة بهذه البساطة

161
00:10:45,830 --> 00:10:49,290
،إضافة لذلك
.لا يمكنني حتّى الكتابة أو القراءة

162
00:10:49,290 --> 00:10:53,520
.لذلك السّبب نقوم بتكرار جُمل بسيطة

163
00:10:53,890 --> 00:10:55,780
.علينا أن نستعجل في تحضيراتنا

164
00:10:55,780 --> 00:10:57,330
نستعجل في تحضيراتنا؟

165
00:10:57,330 --> 00:11:00,300
.ستمثلين أمام الملك بعد ثلاثة أيّام من الآن

166
00:11:00,300 --> 00:11:04,280
ماذا؟ هذا يعني أنّي سأقابله، صحيح؟

167
00:11:04,280 --> 00:11:07,670
أهذه فكرة جيّدة؟
هل يعلم أنّي مجرّد بديلة؟

168
00:11:07,670 --> 00:11:11,060
هل أشبه هذه الفتاة أليشا بالفعل؟

169
00:11:11,060 --> 00:11:12,730
.على الإطلاق

170
00:11:12,730 --> 00:11:14,060
.قطعًا لا

171
00:11:14,060 --> 00:11:15,000
ماذا؟

172
00:11:15,000 --> 00:11:17,690
.تشبهينها بلون عينيك فقط

173
00:11:17,690 --> 00:11:21,440
كانت مولاتي أليشا ابنة الملكة
.الثّالثة المتوفّاة

174
00:11:21,440 --> 00:11:25,210
ولأنّه تمّ اختيارها لتخلف الرّاهبة
،النّجميّة بعد ولادتها بفترة وجيزة

175
00:11:25,210 --> 00:11:27,700
.تمّت تربيتها في القصر النّجميّ

176
00:11:28,050 --> 00:11:29,190
...النّجمي

177
00:11:29,620 --> 00:11:35,160
يتمّ الكشف عن الرّاهبة الجديدة لأوّل مرّة في
.المهرجان النّجميّ عندما تبلغ السّادسة عشرة

178
00:11:35,570 --> 00:11:36,960
...المهرجان النّجميّ

179
00:11:37,450 --> 00:11:40,000
.نينا، هذه هي أنوار الأمل

180
00:11:40,000 --> 00:11:43,740
تمنّي أمنية. ستصلّي الرّاهبة
.النّجميّة من أجلك لتحقيقها

181
00:11:44,510 --> 00:11:48,050
.كان لديّ أب وأمّ عندما كنت صغيرة

182
00:11:50,160 --> 00:11:52,400
ما الّذي علينا أن نتمنّاه هذه السّنة؟

183
00:11:52,400 --> 00:11:56,980
.نحتاج لقناديل جديدة. ليتنا نملك المال لذلك

184
00:11:56,980 --> 00:11:59,150
،وفي السّنة الماضية
.تمنّيت أمنية مع ساجي وكولين

185
00:12:01,880 --> 00:12:05,880
وحتّى ذلك الوقت، لا يُسمح لها
،بمغادرة القصر النّجميّ

186
00:12:05,880 --> 00:12:11,370
لذلك وحدهم موظّفو القصر
.وقلّة آخرون من يعرفون ملامحها

187
00:12:11,370 --> 00:12:13,650
وهذه المرّة، كان من المقرّر
أن تعود إلى الحياة الدّنيويّة

188
00:12:13,650 --> 00:12:16,910
،قبل بلوغها السّادسة عشرة
.حتّى تتمكّن من الزّواج

189
00:12:16,910 --> 00:12:18,680
.لذلك لا يوجد ما يدعو للقلق

190
00:12:18,680 --> 00:12:21,010
هل تفهمين؟ أكنت تستمعين؟

191
00:12:22,060 --> 00:12:25,530
...عفوًا ولكن

192
00:12:25,530 --> 00:12:26,900
.لا خيار أمامي

193
00:12:26,900 --> 00:12:30,430
،إن مرّ اللّقاء مع الملك على خير
.فسأكافئك بأيّ شيء ترغبين به

194
00:12:30,430 --> 00:12:31,520
!وغد متغطرس

195
00:12:31,520 --> 00:12:35,970
.رجاءً! حدث هذا بسبب خطئنا

196
00:12:35,970 --> 00:12:37,960
.سنُضطرّ لدفع الثّمن بأرواحنا

197
00:12:37,960 --> 00:12:39,330
!رجاءً، رجاءً

198
00:12:40,700 --> 00:12:42,890
!مفهوم! هذا يكفي رجاءً

199
00:12:43,900 --> 00:12:48,910
يُغضبني الأمير الذّهبيّ كثيرًا، لكنّي
.أشعر بالأسف على خادمات البلاط

200
00:12:48,910 --> 00:12:50,010
!مهلاً لحظة

201
00:12:50,010 --> 00:12:50,900
...لكن

202
00:12:51,420 --> 00:12:52,600
.مرّة أخرى

203
00:12:52,600 --> 00:12:55,770
.حاضر يا جلالتك

204
00:12:55,770 --> 00:12:59,290
...لكن... لكن

205
00:12:59,290 --> 00:13:02,760
.هذا صعب. لا أطيق هذا

206
00:13:02,760 --> 00:13:07,950
لن أقوم بهذا! لماذا كلّ هذا من الأساس؟

207
00:13:07,950 --> 00:13:10,310
.ربّما تحتاج إلى استراحة

208
00:13:12,490 --> 00:13:15,510
.سنأخذ استراحة قصيرة. تعالي معي

209
00:13:20,940 --> 00:13:24,190
لم أكن أدري بما أنّي ظللتُ
،في الدّاخل طوال هذا الوقت

210
00:13:24,190 --> 00:13:27,450
.لكنّنا بالفعل في القصر الملكيّ

211
00:13:30,410 --> 00:13:33,650
.يا لها من رائحة طيّبة. لا بدّ أنّها له

212
00:13:33,650 --> 00:13:37,460
هل رائحة كلّ النّبلاء هكذا؟

213
00:13:37,460 --> 00:13:39,460
هل وُلدوا وتفوح منهم هذه الرّائحة؟

214
00:13:40,000 --> 00:13:42,540
.إنّهم لا يشبهوننا أبدًا نحن ساكنة القاع

215
00:13:42,930 --> 00:13:46,780
إنّه شخص مهمّ، لذلك ما كنّا في العادة
.أن نقف حتّى على نفس الأرض

216
00:13:47,340 --> 00:13:51,100
كم هذا غريب! ما الّذي أفعله هنا؟

217
00:13:53,540 --> 00:13:57,370
.أحتاج لمساعدتك من أجل هذه البلاد

218
00:13:57,370 --> 00:13:58,760
.يحتاج لمساعدتي

219
00:13:58,760 --> 00:14:02,360
.مساعدة شخص مثلي

220
00:14:04,020 --> 00:14:05,450
.فهمت

221
00:14:09,510 --> 00:14:11,160
!هذا مذهل

222
00:14:11,160 --> 00:14:12,990
!يبدو الثّوب رائعًا عليك

223
00:14:12,990 --> 00:14:17,200
.حاولي ألاّ تفسدي هذا الأمر رجاءً

224
00:14:17,200 --> 00:14:23,000
،إن تمّ اكتشاف أنّك مزيّفة
.فستُقطع رؤوسنا جميعًا

225
00:14:23,000 --> 00:14:24,000
ماذا؟

226
00:14:24,250 --> 00:14:26,820
!وصلت الأميرة أليشا

227
00:14:26,820 --> 00:14:29,380
سنموت إن فشلت؟

228
00:14:31,540 --> 00:14:36,520
.صحيح. عليّ خداع الملك أيضًا

229
00:14:42,420 --> 00:14:46,530
.إنّه حقًّا لشرف لي أن ألقاء يا صاحب الجلالة

230
00:14:46,530 --> 00:14:51,530
.أنا أليشا سث فورتنا

231
00:14:53,130 --> 00:14:56,880
.لا داعي لأن تكوني متيبّسة هكذا يا فتاة

232
00:14:59,110 --> 00:14:59,940
.حاضرة

233
00:15:00,520 --> 00:15:03,430
...أنا خائفة. هذا

234
00:15:08,630 --> 00:15:10,740
.هو ملك هذه البلاد

235
00:15:10,740 --> 00:15:14,470
،عجبًا! يا لهما من عينان زرقاوان
.أنت أليشا بالفعل

236
00:15:14,470 --> 00:15:17,100
.إنّ زُرقة هذا اللّون لا تُعادلها زُرقة

237
00:15:17,100 --> 00:15:22,440
أعتذر على إعادتك إلى القصر
.استجابة إلى رغباتي

238
00:15:22,680 --> 00:15:25,330
عفوًا، ما الّذي يُفترض بي قوله؟

239
00:15:25,330 --> 00:15:27,600
.عـ-على الإطلاق

240
00:15:27,600 --> 00:15:32,450
.إنّه لفخر لي أن أخدمك

241
00:15:32,450 --> 00:15:35,610
.يمكنك أن تسترخي أكثر

242
00:15:35,610 --> 00:15:39,700
أعتقد أنّي تركت مسؤوليّة رعايتك
.بين يدي أخيك غير الشّقيق أزور

243
00:15:39,700 --> 00:15:40,630
.نعم

244
00:15:40,960 --> 00:15:43,280
.سأعتني بها حتّى تبلغ السّنّ المناسبة للزّواج

245
00:15:43,280 --> 00:15:46,470
.جيّد. يمكنني أن أثق بك يا أزور

246
00:15:50,470 --> 00:15:52,240
...بالمناسبة

247
00:15:52,780 --> 00:15:55,890
في بلادنا، تؤدّي الرّاهبة النّجميّة رقصة

248
00:15:55,890 --> 00:15:58,970
.في حفلِ بلوغِ وليِّ العهدِ سنَّ الرّشد

249
00:15:59,300 --> 00:16:04,980
هلاّ أدّيتِ تلك الرّقصة لأميري موهولوم هنا؟

250
00:16:05,470 --> 00:16:07,980
رقصة؟ أيّ رقصة؟

251
00:16:08,290 --> 00:16:11,990
.لكنّ موهولوم لم يبلغ سنّ الرّشد بعد

252
00:16:12,710 --> 00:16:14,350
.ستكون من باب التّرفيه فحسب

253
00:16:14,350 --> 00:16:17,200
إضافة لذلك، ألن يكون من الخسارة تزويجها

254
00:16:17,200 --> 00:16:21,250
دون رؤيتها ترقص بعد أن تدرّبت
لتصير راهبة لـ15 سنة؟

255
00:16:21,250 --> 00:16:23,750
.الملكة امرأة سيّئة الطّباع بالفعل

256
00:16:23,750 --> 00:16:26,250
واضح أنّ ذلك استعراض قوّة
.تتباهي به على الأمير أزور

257
00:16:26,730 --> 00:16:29,580
.لم أتعلّم أيّ رقصة

258
00:16:29,580 --> 00:16:32,310
ألا تريد رؤيتها يا صاحب الجلالة؟

259
00:16:32,310 --> 00:16:35,510
،بمجرّد أن تتزوّج
.فلن تحصل على تلك الفرصة أبدًا

260
00:16:35,980 --> 00:16:37,480
.معك حقّ

261
00:16:37,480 --> 00:16:39,890
.سأسمح بذلك. قومي بتأدية الرّقصة

262
00:16:39,890 --> 00:16:41,270
ماذا أفعل؟

263
00:16:45,270 --> 00:16:47,450
...عفوًا، أنا

264
00:16:48,920 --> 00:16:52,900
...إنّني... إنّني في الحقيقة

265
00:16:52,900 --> 00:16:54,280
.انتهى الأمر

266
00:16:54,970 --> 00:16:56,410
أواثقة أنّ ذلك تصرّف حكيم؟

267
00:16:57,280 --> 00:16:58,920
...أزور

268
00:16:58,920 --> 00:17:03,200
،لم تبلغ الأميرة سنّ الرّشد بعد
.ولم تبدأ واجباتها الدّينيّة أيضًا

269
00:17:03,200 --> 00:17:08,410
إنّ دفع شخص كهذا لرّقص قد يؤثّر
.سلبًا على مستقبل الأمير موهولوم

270
00:17:09,760 --> 00:17:15,340
ليس ذلك فحسب، لكنّ الأمير بحدّ
.ذاته غائب، بما أنّه طريح الفراش

271
00:17:16,830 --> 00:17:19,880
.ربّما الحقّ مع أزور

272
00:17:19,880 --> 00:17:23,550
إضافة لذلك، يبدو أنّ الأميرة
.ليست في كامل عافيتها

273
00:17:23,550 --> 00:17:25,440
.أقترح تأجيل ذلك

274
00:17:26,480 --> 00:17:27,630
.حاضرة

275
00:17:29,000 --> 00:17:31,290
.لقد فشلت

276
00:17:31,990 --> 00:17:37,100
.لم يكتشفوا الحقيقة، لكنّي خيّبتُ ظنّه

277
00:17:42,760 --> 00:17:47,190
.أنا لا أنتمي إلى مكان مهيب كهذا

278
00:17:48,830 --> 00:17:52,570
هذا صحيح! هذا لا يستحقّ
!المخاطرة بحياتي لأجله

279
00:17:52,570 --> 00:17:54,840
!لا يهمّني ما قد يحدث للذّهبيّ

280
00:17:54,840 --> 00:17:57,590
.عليّ الهرب. سأعود من حيث أتيت

281
00:17:58,240 --> 00:17:59,490
.آسف يا نينا

282
00:18:02,510 --> 00:18:04,920
هل لديّ مكان أعود إليه؟

283
00:18:05,290 --> 00:18:06,600
...أقدّر لك هذا العرض، ولكن

284
00:18:06,600 --> 00:18:07,910
لِمَ لا؟

285
00:18:11,070 --> 00:18:15,240
لماذا لا يمكنني استقبال الأميرة أليشا في جناحي؟

286
00:18:15,240 --> 00:18:18,860
.المعذرة، لكن سبق واتُّخذ القرار في المسألة

287
00:18:18,860 --> 00:18:21,490
.إنّها الملكة

288
00:18:21,490 --> 00:18:24,690
.إنّ إله النّجوم هو من يتحكّم بالمصير

289
00:18:24,690 --> 00:18:28,870
.إنّك تصرّ على إبقاء الرّاهبة النّجميّة تحت رعايتك

290
00:18:28,870 --> 00:18:31,540
لا تقل لي أنّك تعتقد

291
00:18:31,540 --> 00:18:35,580
أنّك الوريث الشّرعيّ للعرش
.بصفتك ابن زوجة الملك السّابقة

292
00:18:36,830 --> 00:18:38,340
.بالطّبع لا

293
00:18:38,340 --> 00:18:42,010
.إنّ رغبتي الوحيدة هي دعم هذه البلاد

294
00:18:42,400 --> 00:18:46,020
.أحتاج لمساعدتك من أجل هذه البلاد

295
00:18:47,530 --> 00:18:52,820
،إنّ زوجته السّابقة، الّتي هي والدتك
.كانت امرأة ضعيفة الإرادة

296
00:18:52,820 --> 00:18:54,400
.جدّ خجولة وجدّ خائفة

297
00:18:54,400 --> 00:18:56,660
...أمّا أنت

298
00:18:58,210 --> 00:19:00,410
!يمكنك تعلّم بعض الأشياء من والدتك

299
00:19:05,800 --> 00:19:08,660
.هذه غلطتك. اذهب وأحضرها

300
00:19:08,660 --> 00:19:10,420
!ما-ماذا؟

301
00:19:11,100 --> 00:19:13,320
.سأطلب تقديم واحدة جديدة لك

302
00:19:13,320 --> 00:19:16,150
.أخبرتك أن تذهب وتحضرها

303
00:19:16,150 --> 00:19:19,670
اليوم يوم حارّ. جوّ مناسب تمامًا
من أجل الغطس، أليس كذلك؟

304
00:19:28,670 --> 00:19:30,620
ما-ما-ما...؟

305
00:19:34,430 --> 00:19:36,260
.تفضّلي يا جلالتك

306
00:19:37,630 --> 00:19:41,950
!كـ-كيف تجرئين على تبليلي بالماء؟

307
00:19:49,730 --> 00:19:53,010
.معك حقّ. إنّه يوم مناسب جدًّا للغطس

308
00:19:55,590 --> 00:19:58,250
!أزور

309
00:19:58,250 --> 00:20:00,990
.يا صاحبة الجلالة، عليك تغيير ملابسك

310
00:19:58,700 --> 00:20:01,260
!ما الّذي تفعلنه؟ اتركنني

311
00:20:01,260 --> 00:20:03,730
!كم هذا فظيع! سأخفي جسدك عن نظرات الآخرين

312
00:20:02,220 --> 00:20:04,890
!أخبرتكنّ أن تنتظرن

313
00:20:04,890 --> 00:20:08,750
!لم أنتهي من كلامي معك يا أزور

314
00:20:06,960 --> 00:20:09,220
.أنا آسفة

315
00:20:09,770 --> 00:20:12,500
.لم أستطع الوقوف هناك فحسب

316
00:20:12,500 --> 00:20:13,230
.تعالي معي

317
00:20:14,200 --> 00:20:16,880
.دايتوس، تولّ الباقي

318
00:20:16,880 --> 00:20:17,620
.حاضر

319
00:20:21,520 --> 00:20:27,820
...عفوًا، أردتُ للمياه أن تصيب الملكة فقط

320
00:20:29,890 --> 00:20:33,000
!إنّه غاضب جدًّا لدرجة الارتعاش؟

321
00:20:33,930 --> 00:20:34,540
ماذا؟

322
00:20:35,000 --> 00:20:38,000
إنّه... لا يضحك؟

323
00:20:39,920 --> 00:20:42,260
.أشعر ببعض الرّاحة

324
00:20:42,850 --> 00:20:47,640
ماذا؟ لم تكن لديّ أدنى فكرة
.أنّه قد تعلو وجهه تلك الملامح

325
00:20:48,010 --> 00:20:52,830
.لكنّي أفسدت اللّقاء مع الملك

326
00:20:52,830 --> 00:20:55,050
.مرّ اللّقاء كما توقّعت تمامًا

327
00:20:55,530 --> 00:20:57,670
.بدا ذلك كشيء قد تقوله الملكة

328
00:20:57,670 --> 00:20:59,270
.أقدّر مدى بساطتها

329
00:20:59,270 --> 00:21:00,020
ماذا؟

330
00:21:00,260 --> 00:21:03,870
وعلى الأغلب أنّه من المناسب
.أنّ بإمكاننا التّأجيل قبل أن يتمّ اكتشافك

331
00:21:04,730 --> 00:21:07,680
.سأقدّم لك مكافأة كما وعدتك
.اطلبي ما تشائين

332
00:21:07,680 --> 00:21:08,920
ما أشاء؟

333
00:21:16,060 --> 00:21:17,020
.أثنِ عليّ

334
00:21:18,080 --> 00:21:23,550
.أثنِ عليّ إذًا. أشعرني أنّي مميّزة

335
00:21:24,210 --> 00:21:25,600
أيّ نوع من الطّلبات هذا؟

336
00:21:25,600 --> 00:21:29,280
.مولاي أزور، ربّما تشعر الفتاة بالوحدة

337
00:21:29,280 --> 00:21:30,730
.عليك أن تعاملها بلطف أكثر

338
00:21:32,560 --> 00:21:34,630
—مهلاً، ما

339
00:21:37,170 --> 00:21:39,800
.أبليت بلاء حسنًا

340
00:21:47,780 --> 00:21:51,990
.سمعتُ إشاعة مثيرة للاهتمام عن الأميرة أليشا

341
00:21:52,770 --> 00:21:54,880
.سأعتقد أنّي سأبحث في أمرها

342
00:23:36,030 --> 00:23:39,110
".اللّيلة 2: الاسم الضّائع"