1
00:00:10,180 --> 00:00:11,690
!صباح الخير

2
00:00:11,690 --> 00:00:12,860
.لقد تأخّرت

3
00:00:13,050 --> 00:00:16,010
التّأخّر على المناوبة يتسبّب
.بالمشاكل للجميع

4
00:00:16,010 --> 00:00:16,590
!مفهوم

5
00:00:16,590 --> 00:00:18,860
.تفضّلي قائمة اليوم رجاءً

6
00:00:21,900 --> 00:00:23,370
".طبق بقايا خاصّ"

7
00:00:23,640 --> 00:00:25,000
!هذا صريح للغاية

8
00:00:25,200 --> 00:00:28,250
!في أوقات كهذه، نختار ما نألفه

9
00:00:31,420 --> 00:00:32,960
.هذا كلّ شيء بالنّسبة لتقرير المناوبة

10
00:00:32,960 --> 00:00:34,510
هل هنالك أيّ أعمال أخرى لمناقشتها؟

11
00:00:34,510 --> 00:00:39,120
المعذرة، كنتُ أعتقد مشروب كالبيس
...المعدّ سلفًا خفيف للغاية

12
00:00:39,660 --> 00:00:41,380
إنّه قويّ كثيرًا، صحيح؟

13
00:00:40,950 --> 00:00:42,070
.إنّه مشروب كالبيس للفقراء

14
00:00:42,070 --> 00:00:44,030
."لا تصفيني بـ"الفقيرة

15
00:00:46,350 --> 00:00:47,420
الشّخص المسؤول؟

16
00:00:47,420 --> 00:00:52,740
حسنًا، لقد أعدّه الشّخص المسؤول
،البارحة وليس أنا

17
00:00:52,740 --> 00:00:54,280
.لكنّني سأبذل ما في وسعي

18
00:00:54,970 --> 00:00:56,200
!الجوّ بارد

19
00:00:56,200 --> 00:00:59,100
...قالوا أنّ الرّياح ستهبّ بالفعل

20
00:00:59,100 --> 00:01:00,800
ماذا يفترض بنا فعله بعد هذا؟

21
00:01:01,330 --> 00:01:03,580
!تنظيف الحمّامات

22
00:01:15,570 --> 00:01:19,140
!أخبرتك أنّني أكره هيجيكي

23
00:01:19,300 --> 00:01:21,150
.كليه فحسب

24
00:01:21,150 --> 00:01:24,120
قيل لي أنّك تعانين فقر دم مؤخّرًا
.يا هونامي-سان

25
00:01:24,120 --> 00:01:25,650
!أنت لئيمة

26
00:01:26,860 --> 00:01:30,460
.فتيات الثّانويّة هؤلاء كنّ ظريفات في البداية

27
00:01:30,460 --> 00:01:32,590
.لم يكنّ يفعلن أيّ شيء حينها

28
00:01:32,590 --> 00:01:33,740
أتريدان بعض الشّاي؟

29
00:01:34,430 --> 00:01:38,600
،بعد كلّ هذا الوقت في القطب الجنوبيّ
.لن تندمجن ثانية مع المجتمع

30
00:01:38,600 --> 00:01:39,870
.هكذا

31
00:01:40,070 --> 00:01:41,290
.تشيسو، رون

32
00:01:41,500 --> 00:01:43,900
...ريسوكو، جونتشانسانشيكي، دورا دورا

33
00:01:43,900 --> 00:01:46,830
.آسفة... مع أوراورا، أصبحت سانباي مان

34
00:01:47,300 --> 00:01:49,850
!أخبرتك ألاّ تعتمدي على السّوجي

35
00:01:48,770 --> 00:01:51,290
...في الحقيقة، أعتقد أنّ ذلك شيء مختلف

36
00:01:53,260 --> 00:01:56,910
ألا يجعلك صوت المكنسة الكهربائيّة
تفكّرين في المنزل؟

37
00:01:58,020 --> 00:01:59,200
أين كنتِ؟

38
00:01:59,200 --> 00:02:01,060
.لقد دعوني للخروج، لذلك قمتُ ببعض المقابلات

39
00:02:02,320 --> 00:02:03,910
ماذا؟ نزهة الجزيرة؟

40
00:02:03,910 --> 00:02:04,540
.نعم

41
00:02:04,540 --> 00:02:07,440
لقد دعوننا أنا وشيراسي-تشان
.للخروج معًا البارحة

42
00:02:07,680 --> 00:02:09,190
!أجل

43
00:02:09,190 --> 00:02:11,190
!لماذا لم تخبريني؟

44
00:02:11,380 --> 00:02:13,620
!لأنّه كان لديك مناوبة اليوم

45
00:02:13,620 --> 00:02:15,110
!لم يبق غيرك

46
00:02:15,110 --> 00:02:15,740
!اخرسي

47
00:02:15,740 --> 00:02:16,580
!هذا مؤلم

48
00:02:17,680 --> 00:02:19,280
من يهتمّ لنزهة جزيرة؟

49
00:02:19,280 --> 00:02:22,530
!أنا سأخرج في عمليّة الجليد لاحقًا

50
00:02:22,530 --> 00:02:24,330
!هذا صحيح! عليّ الإسراع

51
00:02:24,500 --> 00:02:26,590
!أوشك وقت الاجتماع

52
00:02:26,590 --> 00:02:27,310
!انتظرا

53
00:02:27,310 --> 00:02:30,000
.سنذهب جميعًا في عمليّة الجليد

54
00:02:31,880 --> 00:02:33,030
فعلاً؟

55
00:02:34,640 --> 00:02:38,940
سنتّجه نحن الأربعة للانضمام
.لعمليّة الجليد. حوّل

56
00:02:38,940 --> 00:02:41,340
.عُلم. كنّ حذرات

57
00:02:42,310 --> 00:02:44,190
أيّها علينا أن نأخذ؟

58
00:02:46,260 --> 00:02:48,610
!مرحبًا

59
00:02:55,590 --> 00:02:57,430
!يمكنني أن أموت

60
00:03:01,000 --> 00:03:03,790
!مذهل! أنهار جليديّة

61
00:03:04,260 --> 00:03:07,660
تبشرون من هذه الكتل الجليديّة الضّخمة؟

62
00:03:08,130 --> 00:03:10,290
،من غير المسموح إزالة أشياء من القطب الجنوبيّ

63
00:03:10,290 --> 00:03:13,540
لذلك فهذا هو التّذكار الوحيد
.المسموح لنا بأخذه بكلّ حرّيّة

64
00:03:14,230 --> 00:03:19,140
هذا الجليد مليء بهواء عمره
،عشرات آلاف السّنين

65
00:03:19,140 --> 00:03:22,010
.لذلك فهو يفرقع بينما يذوب

66
00:03:22,740 --> 00:03:23,760
أتردن أكل بعضه؟

67
00:03:23,960 --> 00:03:25,100
!نعم

68
00:03:30,420 --> 00:03:32,970
!هذا هو مذاق هواء عمره ألف عام

69
00:03:32,970 --> 00:03:34,090
أيمكنك التّفريق بينهما؟

70
00:03:34,090 --> 00:03:36,820
سوف أشرب كحولاً مصنوعًا
.من هذا عندما أكبر

71
00:03:36,820 --> 00:03:39,140
أراهن أنّك ستكونين صاخبة عندما
.تشربين يا كيماري

72
00:03:39,140 --> 00:03:39,740
فعلاً؟

73
00:03:40,840 --> 00:03:44,870
عند بداية هذا الأمر، نشعر بالفعل
.أنّ الصّيف يوشك أن ينتهي

74
00:03:45,400 --> 00:03:47,120
فعلاً؟

75
00:03:47,510 --> 00:03:50,560
...سيحلّ الخريف قريبًا، ثمّ الشّتاء

76
00:03:50,560 --> 00:03:51,620
!فريق الشّتاء

77
00:03:51,960 --> 00:03:54,460
ماذا تفعلون خلال الشّتاء؟

78
00:03:54,780 --> 00:03:58,840
...نقوم بأمور كثيرة. نلعب ونشرب

79
00:04:00,850 --> 00:04:04,350
،وبالطّبع، الأبحاث والتّحقيقات مهمّة

80
00:04:04,770 --> 00:04:08,800
لكن عندما نبلغ شهر يونيو، يكون
.طوال اليوم ليلًا

81
00:04:09,320 --> 00:04:10,600
...فهمت

82
00:04:10,600 --> 00:04:12,780
تقصدين اللّيل القطبيّ، صحيح؟

83
00:04:13,330 --> 00:04:16,710
،خلال النّهار، يشعّ نور خافت في الأفق

84
00:04:17,100 --> 00:04:19,860
.لكنّ ذلك هو التّغيير الوحيد الّذي نلاحظه

85
00:04:19,860 --> 00:04:23,620
.وإلاّ، فسيكون ليلاً لوقت طويلٍ طويل

86
00:04:23,960 --> 00:04:25,870
ليل دائم، صحيح؟

87
00:04:26,190 --> 00:04:28,750
!لكنّ ذلك يجعل النّجوم أجمل بكثير فحسب

88
00:04:29,170 --> 00:04:30,700
!يمكننا رؤية الشّفق القطبيّ أيضًا

89
00:04:30,700 --> 00:04:31,750
...الشّفق القطبيّ

90
00:04:32,870 --> 00:04:34,390
!هذا صحيح، لم نره أبدًا

91
00:04:34,390 --> 00:04:37,160
.هذا لأنّ اللّيل قصير جدًّا الآن

92
00:04:37,160 --> 00:04:39,860
التقطنا صورًا مع البطاريق وأكلنا
...ثلجًا مبشورًا

93
00:04:39,860 --> 00:04:41,970
لكنّنا لم نر الشّفق القطبيّ
!أو نجوم القطب الجنوبيّ

94
00:04:41,970 --> 00:04:43,910
هذا لأنّ الشّمس لا تغرب كما
.سلف وشرحت لك

95
00:04:43,910 --> 00:04:46,160
!النّجدة

96
00:04:46,160 --> 00:04:49,900
!لكنّني سعيدة! لكنّ الرّائحة نتنة! لكنّني سعيدة

97
00:04:50,260 --> 00:04:52,850
!لكنّ الرّائحة نتنة! لكنّني سعيدة

98
00:04:50,280 --> 00:04:51,830
ماذا تفعل؟

99
00:04:52,740 --> 00:04:54,880
.عليّ العودة للعمل

100
00:04:54,880 --> 00:04:56,900
.فلتقمن بالعمل على مهلكنّ

101
00:04:54,890 --> 00:04:58,020
!لكنّ الرّائحة نتنة! لكنّني سعيدة

102
00:04:56,900 --> 00:04:59,200
سيكون هذا آخر يوم لكنّ على
البحر المتجمّد، صحيح؟

103
00:05:07,260 --> 00:05:08,450
...هذا صحيح

104
00:05:10,570 --> 00:05:12,080
!أخبرتك أن تنجديني

105
00:05:12,080 --> 00:05:14,690
آسفة، الحفاظ على مسافة
...خمسة أمتار

106
00:05:14,690 --> 00:05:15,700
!افعلي شيئًا

107
00:05:15,700 --> 00:05:17,370
!آسفة، لا يمكنني

108
00:05:17,370 --> 00:05:20,340
لقد اعتدنا على الوضع بأكمله، صحيح؟

109
00:05:21,220 --> 00:05:22,600
...وهذا المشهد أيضًا

110
00:05:26,900 --> 00:05:28,310
...ولكن بشكل نظريّ فحسب

111
00:05:31,300 --> 00:05:32,850
...بشكل نظريّ

112
00:05:35,840 --> 00:05:38,090
.حسنًا، لا يحتاج أيّ أحد آخر الغرف

113
00:05:38,090 --> 00:05:40,730
ويمكننا مواصلة إرسال
الفيديوهات من هنا، صحيح؟

114
00:05:40,730 --> 00:05:43,620
لذلك لا يوجد سبب يدفعنا
للمغادرة الآن، صحيح؟

115
00:05:47,920 --> 00:05:49,740
!توشكين على ضربي

116
00:05:49,740 --> 00:05:51,340
.لن أفعل، لن أفعل

117
00:05:53,570 --> 00:05:55,710
!كاذبة

118
00:05:54,190 --> 00:05:58,400
،وماذا ظننتِ؟ إن لم نعد الآن
.فسنبقى عالقات هنا طوال العام

119
00:05:58,400 --> 00:06:00,590
.أعلم ذلك. سنكون بخير

120
00:06:00,590 --> 00:06:04,060
،أراهن أنّه بمجرّد أن يحلّ الظّلام
.فيمكنني النّوم للأبد

121
00:06:04,060 --> 00:06:08,280
،ماذا عن المدرسة؟ فحين نعود
.سيكون الجميع قد تخرّج

122
00:06:08,280 --> 00:06:09,570
...في الواقع

123
00:06:09,570 --> 00:06:11,280
ماذا عن عائلاتنا؟

124
00:06:11,280 --> 00:06:12,880
ومسلسل يوزو؟

125
00:06:17,300 --> 00:06:21,540
...حسنًا، أنا أتفهّم عدم الرّغبة في العودة

126
00:06:21,540 --> 00:06:23,060
ستعودين إذًا؟

127
00:06:23,060 --> 00:06:24,230
...ماذا؟ أكيد

128
00:06:24,230 --> 00:06:26,450
!للبقاء في فصل الشّتاء. نحن الأربعة

129
00:06:26,450 --> 00:06:27,490
.حسنًا

130
00:06:27,490 --> 00:06:30,370
!من الأفضل أن تكنّ جادّات
!من الأفضل ألاّ تخذلنني

131
00:06:30,370 --> 00:06:31,870
...نعم، نعم

132
00:06:32,980 --> 00:06:34,620
.أنا جادّة في سؤالي

133
00:06:35,350 --> 00:06:36,870
.أنا أجيب بجدّيّة

134
00:06:39,580 --> 00:06:40,830
!حسنًا إذًا

135
00:06:49,060 --> 00:06:51,260
لكن... ماذا سنفعل؟

136
00:06:52,330 --> 00:06:54,720
أتذكرن ما قالته القائد؟

137
00:06:54,720 --> 00:06:57,890
إن كان هنالك أيّ شيء نريد القيام به
.قبل المغادرة، فعلينا إخبارها

138
00:07:03,220 --> 00:07:04,580
قبل المغادرة؟

139
00:07:08,110 --> 00:07:09,950
أواثقات أنّ هذا ما تردنه؟

140
00:07:09,950 --> 00:07:14,250
،نعم. قبل أن نغادر
!نودّ اللّعب مع الجميع هنا

141
00:07:15,830 --> 00:07:17,790
!هيّا! ارمها

142
00:07:18,060 --> 00:07:20,250
!أنت لها

143
00:07:18,750 --> 00:07:22,170
!لنقم بهذا

144
00:07:22,750 --> 00:07:26,430
،أيّتها القائد! إن ضربتُها خارج الملعب
فهل ستعيدين التّفكير في عرضي؟

145
00:07:28,240 --> 00:07:28,930
.أكيد

146
00:07:29,830 --> 00:07:31,560
!سأعتبر هذا وعدًا

147
00:07:31,560 --> 00:07:33,840
ما زال لم يستسلم؟

148
00:07:33,840 --> 00:07:35,150
هل يمكنه صدّها؟

149
00:07:35,150 --> 00:07:36,140
.أشكّ في ذلك

150
00:07:36,140 --> 00:07:40,200
تُعرف غين-تشان بلقب "صاحبة قميص
."الرّقم 19 المقلّم للقطب الجنوبيّ

151
00:07:40,200 --> 00:07:42,060
.رمياتها هي من الدرجة الأولى

152
00:07:42,060 --> 00:07:42,930
...وأيضًا

153
00:07:47,270 --> 00:07:48,870
.لا يستطيع أحد تفاديها

154
00:07:48,870 --> 00:07:49,960
...مستحيل

155
00:07:50,500 --> 00:07:52,110
.لا تقلقي

156
00:07:52,300 --> 00:07:54,850
.كان بمقدور تاكاكو ضربها

157
00:08:08,250 --> 00:08:08,760
...تاكاكو

158
00:08:12,450 --> 00:08:13,390
أنت تشاهدين، صحيح؟

159
00:08:19,780 --> 00:08:21,020
!هيناتا-سان

160
00:08:33,530 --> 00:08:34,950
ماذا؟ الآن؟

161
00:08:35,270 --> 00:08:37,720
إن كنتِ ستقصّينه، فكان عليك
.القيام بذلك عندما وصلنا

162
00:08:37,720 --> 00:08:39,200
.لقد راودتني رغبة بقصّه للتّوّ

163
00:08:39,200 --> 00:08:40,130
هل أقصّه أنا؟

164
00:08:40,130 --> 00:08:41,790
.تراجعي رجاءً يا كيماري-سان

165
00:08:41,790 --> 00:08:43,080
ماذا؟

166
00:08:43,320 --> 00:08:44,420
إلى أيّ حدّ؟

167
00:08:48,210 --> 00:08:49,050
أأنت جادّة؟

168
00:08:52,250 --> 00:08:53,070
!نعم

169
00:08:55,320 --> 00:08:59,200
.لا يمكنك مواصلة تأجيل الأمر
...تعلم أنّها ذاهبة بالفعل

170
00:09:04,500 --> 00:09:05,450
.جيّد

171
00:09:07,900 --> 00:09:09,830
هل العلم مصنوع يدويًّا؟

172
00:09:09,830 --> 00:09:11,400
.لقد وصلت ضيفات الشّرف

173
00:09:11,400 --> 00:09:12,480
!تعالين، اصطففن هنا

174
00:09:12,480 --> 00:09:13,600
!حسنًا

175
00:09:18,030 --> 00:09:18,650
ماذا؟

176
00:09:24,670 --> 00:09:26,920
ما رأيكما؟ هل يليق عليّ؟

177
00:09:30,190 --> 00:09:31,680
.أنت سرّ والدتك بالفعل

178
00:09:32,470 --> 00:09:34,360
.تبدين مثلها تمامًا وأنت تبتسمين

179
00:09:34,930 --> 00:09:36,470
ماذا حدث؟ هل فُطر فؤادها؟

180
00:09:36,470 --> 00:09:37,560
.كلاّ

181
00:09:37,560 --> 00:09:39,750
...لكن يمكنك قول ذلك نوعًا ما

182
00:09:39,750 --> 00:09:40,750
نوعًا ما؟

183
00:09:40,750 --> 00:09:41,810
.استعملي مخيّلتك

184
00:09:41,810 --> 00:09:44,060
!لا أفهم الأمر

185
00:09:44,980 --> 00:09:48,960
،في العادة، كنّا لنغيّر أماكننا مع الفريق الشّتويّ

186
00:09:48,960 --> 00:09:51,070
،لكن لا يوجد تبادل هذه المرّة

187
00:09:51,070 --> 00:09:53,610
لذلك فهي حفلة وداع فحسب
.لفريق الصّيف المغادر

188
00:09:54,100 --> 00:09:55,340
حسنًا أيّتها القائد؟

189
00:10:00,280 --> 00:10:02,250
.لقد أبليتم حسنًا جميعًا

190
00:10:02,810 --> 00:10:06,960
.كان الجوّ صحوًا في هذا الصّباح
.إنّه لصباح ممتاز للمغادرة

191
00:10:08,410 --> 00:10:11,490
وعلى وجه الخصوص، أودّ الحديث
عن أولى عضوات

192
00:10:11,490 --> 00:10:14,740
في اليابان ضمن فريق أبحاث
.القطب الجنوبيّ في سنّ الثّانويّة

193
00:10:15,440 --> 00:10:17,770
.كانت هذه تجربة رائدة

194
00:10:18,410 --> 00:10:20,420
.واثقة أنّهنّ كنّ متوتّرات كثيرًا

195
00:10:20,940 --> 00:10:23,750
.لقد كنّا متوتّرين للغاية جميعًا أيضًا

196
00:10:25,190 --> 00:10:29,920
لكنّهنّ قمن بعمل ممتاز
.كعضوات في بعثة

197
00:10:30,360 --> 00:10:32,410
أماني أعضاء الفريق الرّجال السّرّيّة

198
00:10:32,410 --> 00:10:36,080
.الرّاغبة ببقائهنّ قد أمست علنيّة ومسموعة

199
00:10:37,130 --> 00:10:40,850
.لكنّهنّ عائدات للوطن

200
00:10:41,490 --> 00:10:42,830
.حان الوقت لوداعهنّ

201
00:10:46,740 --> 00:10:47,830
...وفي النّهاية

202
00:10:51,120 --> 00:10:52,680
.شكرًا على كلّ شيء

203
00:10:53,710 --> 00:10:58,700
،حتّى بعد عودتكنّ للوطن
،آمل أن نشغل تفكيركنّ أحيانًا

204
00:10:58,700 --> 00:11:04,140
ونحن هنا في الظّلام عند الأفق البعيد
.نقضي شتاءنا بصمت

205
00:11:05,520 --> 00:11:08,240
.لنلتقِ ثانية هنا يومًا ما

206
00:11:16,630 --> 00:11:19,150
،والآن، كلمة من ممثّلة الفريق الصّيفيّ

207
00:11:19,150 --> 00:11:20,810
.كوبوتشيزاوا شيراسي-سان

208
00:11:21,400 --> 00:11:22,280
.حاضرة

209
00:11:27,520 --> 00:11:28,470
.يا رفاق

210
00:11:29,590 --> 00:11:31,050
.صباح الخير

211
00:11:33,080 --> 00:11:34,960
،كما تعلمون جميعًا

212
00:11:35,440 --> 00:11:38,550
.كانت أمّي عضوة في بعثتكم للقطب الجنوبيّ

213
00:11:39,540 --> 00:11:44,510
لقد أحبّت القطب الجنوبيّ وتركت
.منزلنا سعيًا خلف هوسها

214
00:11:45,040 --> 00:11:49,780
بصراحة عند التّفكير بالأمر، فقد كان من الصّعب
.امتلاك مشاعر إيجابيّة نحو القطب الجنوبيّ

215
00:11:50,580 --> 00:11:56,190
أعتقد أنّ الرّغبة في تغيير ذلك الشّعور
.كانت سبب قدومي إلى هنا

216
00:11:59,890 --> 00:12:01,870
.مكان أبعد من الكون

217
00:12:02,430 --> 00:12:08,530
.إن ماما... أقصد والدتي دعته هكذا

218
00:12:09,820 --> 00:12:12,320
.إنّه مكان يُظهر كلّ شيء على حقيقته

219
00:12:13,040 --> 00:12:16,770
...الوقت والحياة والقلوب

220
00:12:17,590 --> 00:12:21,240
إنّه مكان لا يضمّ أيّ شيء لحمايتنا
.أو أمكنة للاختباء فيها

221
00:12:22,380 --> 00:12:26,040
،إنّه بيئة تكشف كلّ شيء نشعر بالحرج منه

222
00:12:26,040 --> 00:12:29,070
،وكلّ شيء نودّ إخفاءه

223
00:12:29,440 --> 00:12:33,870
وقد أُجبرنا ونحن عراة وباكين
.على مواجهة حقيقتنا الفعليّة

224
00:12:34,780 --> 00:12:38,170
.لقد تخطّينا محنة تلو الأخرى معًا

225
00:12:39,450 --> 00:12:41,070
...ومن ذلك، أظنّني أدرك الآن

226
00:12:42,800 --> 00:12:48,800
أنّ السّبب الّذي دفع أمي لتحبّ هذا المكان
،ليس هذا المنظر وهذه السّماء وهذه الرّياح فحسب

227
00:12:48,800 --> 00:12:55,090
،إنّما أيضًا الوقت الّذي قضته هنا
.متخطّية أمورًا رفقة فريقها

228
00:12:56,290 --> 00:12:58,000
،لقد أحبّت هذا الجوّ

229
00:12:58,000 --> 00:13:00,840
حيث لا خيار لدينا سوى تخطّي
،الأمور مع فريقنا

230
00:13:00,840 --> 00:13:02,600
.ولا شيء آخر يعترض الطّريق

231
00:13:04,100 --> 00:13:06,080
.أنا أحبّ هذا المكان

232
00:13:06,670 --> 00:13:08,100
.حظًّا سعيدًا خلال الشّتاء

233
00:13:09,350 --> 00:13:12,230
.سوف أعود ثانية، أعد بذلك

234
00:13:26,240 --> 00:13:27,230
هل تبكين؟

235
00:13:44,800 --> 00:13:45,510
.تفضّلن

236
00:13:46,840 --> 00:13:48,220
أعددتِ هذه من أجلنا؟

237
00:13:48,420 --> 00:13:50,060
.باستعمال بقايا الطّعام بالطّبع

238
00:13:50,060 --> 00:13:51,120
...المعذرة

239
00:13:52,310 --> 00:13:54,360
...شكرًا جزيلاً

240
00:13:54,610 --> 00:13:58,360
هل يمكنكنّ أخذ هذه إلى يو-كُن؟
.إنّه ينتظر في اليابان

241
00:13:59,680 --> 00:14:00,610
ماذا؟

242
00:14:00,610 --> 00:14:02,470
!لا تذهبي

243
00:14:02,470 --> 00:14:03,990
...تفوح منك رائحة الكحول

244
00:14:03,990 --> 00:14:06,130
!بالطّبع! لقد كنت أشرب

245
00:14:06,130 --> 00:14:08,490
.لا تقلقي. خذي هذه

246
00:14:10,710 --> 00:14:12,720
!شيراسي-سان، اشكريها! اشكريها

247
00:14:12,720 --> 00:14:14,620
!اذهب فحسب

248
00:14:18,360 --> 00:14:20,130
ذلك هو توقيعك يا يوزوكي-تشان؟

249
00:14:20,130 --> 00:14:21,500
.يبدو كتوقيع نجمة مشهورة

250
00:14:21,500 --> 00:14:23,260
كم واحدًا بعتِ منه؟

251
00:14:23,260 --> 00:14:25,640
هلاّ كففتنّ عن الثّرثرة؟

252
00:14:25,920 --> 00:14:26,680
.تفضّل

253
00:14:30,210 --> 00:14:31,030
...المعذرة

254
00:14:31,520 --> 00:14:32,390
نعم؟

255
00:14:32,610 --> 00:14:35,040
.أنا أتطلّع لمشاهدة مسلسلك

256
00:14:35,040 --> 00:14:36,900
رغم أنّني لن أتمكّن من مشاهدته
...حتّى أعود

257
00:14:38,780 --> 00:14:39,640
...حسنًا

258
00:14:44,320 --> 00:14:45,780
كيف سار الأمر؟

259
00:14:44,910 --> 00:14:48,660
...هنالك بالفعل أشخاص يتطلّعون إليه

260
00:14:48,870 --> 00:14:49,890
!بالطّبع

261
00:14:49,890 --> 00:14:51,040
!من الأفضل أن تعملي بجدّ

262
00:14:53,000 --> 00:14:53,770
!نعم

263
00:15:00,100 --> 00:15:01,860
!حان وقت الذّهاب

264
00:15:02,440 --> 00:15:03,890
!حسنًا

265
00:15:05,930 --> 00:15:06,930
.اعتنين بأنفسكنّ

266
00:15:06,930 --> 00:15:08,430
!شكرًا جزيلاً

267
00:15:08,890 --> 00:15:10,550
...في الحقيقة، أنا من عليها شكركنّ

268
00:15:10,920 --> 00:15:14,070
هل تتذكّرن ما تحدّثنا عنه
في السّيّارة في يومنا الأوّل؟

269
00:15:15,480 --> 00:15:20,190
أمدّني الحديث معكنّ حينها
.بالكثير من الشّجاعة

270
00:15:20,970 --> 00:15:24,910
عندما رأيتُ وجوهكنّ، أدركت أنّه لم
.يجدر بي السّماح بخططنا أن تُلغى

271
00:15:24,910 --> 00:15:26,740
هل كنتم تفكّرون بإلغائها؟

272
00:15:26,740 --> 00:15:27,780
.نعم

273
00:15:27,780 --> 00:15:31,890
بالنّسبة للرّاشدين، هنالك لحظة
.ليس علينا أن نكون صريحين فيها

274
00:15:34,710 --> 00:15:37,210
.اعتني بالقائد رجاءً

275
00:15:37,790 --> 00:15:38,650
.سمعتِها

276
00:15:38,650 --> 00:15:40,040
.انتبهي لكلامك

277
00:15:41,150 --> 00:15:42,570
!هيّا، اركبن

278
00:15:42,570 --> 00:15:44,050
!حسنًا

279
00:15:44,590 --> 00:15:46,070
.وخذي هذا

280
00:15:49,000 --> 00:15:52,760
أعتقد أنّ والدتي كانت لتغضب
.إن لم تسمحي لها بالبقاء خلال الشّتاء

281
00:15:54,680 --> 00:15:55,690
...لكن

282
00:15:55,920 --> 00:15:58,940
.لا أحتاجه بعد الآن

283
00:16:04,980 --> 00:16:05,850
.مفهوم

284
00:16:08,240 --> 00:16:09,180
.لنذهب

285
00:16:43,720 --> 00:16:44,990
.لقد غادرن

286
00:16:47,140 --> 00:16:49,710
.لقد ارتفع متوسّط الأعمار هنا فجأة

287
00:16:49,710 --> 00:16:50,310
!هذا مؤلم

288
00:16:50,310 --> 00:16:53,240
!حسنًا، لدينا الكثير من الوقت أمامنا

289
00:17:20,850 --> 00:17:24,440
،عندما أتينا إلى هنا أوّل مرّة
...بدا ذلك بعيدًا جدًّا

290
00:17:24,790 --> 00:17:27,560
.حسنًا، هكذا هي الرّحلات

291
00:17:27,560 --> 00:17:29,450
.إنّها لم تنتهِ بعد

292
00:17:29,450 --> 00:17:32,170
ما زال علينا تجاوز خطوط
...الدّرجات 60 و50 و40

293
00:17:32,170 --> 00:17:33,540
!صراخ

294
00:17:33,540 --> 00:17:35,660
.على الأرجح أنّني سأتقيّأ ثانية

295
00:17:35,660 --> 00:17:36,980
.لا بأس

296
00:17:36,980 --> 00:17:41,190
سنتقيّأ ونتقيّأ ونقول لأنفسنا
"...أنا مريضة، سوف أموت"

297
00:17:41,190 --> 00:17:44,040
.لا بأس بذلك. هكذا هي الرّحلات أيضًا

298
00:17:46,640 --> 00:17:50,250
هل تعتقدن أنّنا أصبحنا قويّات قليلاً؟

299
00:17:50,250 --> 00:17:52,750
...أو ربّما أصبحنا متخاذلات أكثر

300
00:17:52,750 --> 00:17:56,520
.هذا لأنّ كلّ شيء أكبر حجمًا هنا

301
00:18:00,770 --> 00:18:01,960
أهذا ما سنلبسه؟

302
00:18:01,960 --> 00:18:04,650
!هذا آخر تصوير لدينا
!علينا جعل الأمر مميّزًا

303
00:18:04,650 --> 00:18:09,090
حسنًا... سيكون هذا آخر تقرير
...آسر وظريف وحسّاس

304
00:18:09,090 --> 00:18:11,530
ربّما عليك وضع النّصّ أرضًا؟

305
00:18:11,530 --> 00:18:13,280
!حسنًا، لنبدأ

306
00:18:13,720 --> 00:18:16,660
!مهلاً! هذا آخر فيديو
!أحتاج للمزيد من الوقت

307
00:18:27,990 --> 00:18:29,550
!إنّه الشّفق القطبيّ

308
00:18:31,840 --> 00:18:33,050
!معك حقّ

309
00:18:33,050 --> 00:18:35,020
!كلاّ! لا أستطيع تصويره

310
00:18:35,020 --> 00:18:36,840
.لا بأس

311
00:18:37,550 --> 00:18:39,730
.إنّه يحدث بين حين وآخر

312
00:19:10,370 --> 00:19:11,580
...أمّي

313
00:19:12,380 --> 00:19:13,300
!مستحيل

314
00:19:26,500 --> 00:19:27,720
.أعلم

315
00:19:44,750 --> 00:19:45,580
!هذا هو

316
00:19:45,880 --> 00:19:48,260
!إنّه نجم الجنوب! رأيتُه أوّلاً

317
00:19:48,260 --> 00:19:50,910
...لا أظنّ أنّه لامع لذلك الحدّ

318
00:21:19,970 --> 00:21:20,590
.اسمعن

319
00:21:21,880 --> 00:21:23,240
.لنودّع بعضنا هنا

320
00:21:24,220 --> 00:21:25,140
...كيماري

321
00:21:25,930 --> 00:21:29,210
هل يعني هذا أنّنا لن نكون معًا بعد الآن؟

322
00:21:29,210 --> 00:21:33,670
بل العكس. هذا يعني أنّه حتّى إن لم
.نكن معًا، فيمكننا أن نكون معًا

323
00:21:33,670 --> 00:21:36,900
.فقبل كلّ شي... نحن هنّ من نحن

324
00:21:37,250 --> 00:21:40,590
من قائل ذلك؟ أهي هيناتا-سان؟

325
00:21:40,590 --> 00:21:41,910
.لكنّه ليس قولاً سيّئًا

326
00:21:42,360 --> 00:21:43,310
فعلاً؟

327
00:21:43,990 --> 00:21:46,890
ما زال أمامنا الكثير لنفعله، صحيح؟

328
00:21:46,890 --> 00:21:50,640
،نعم. عندما ننتهي من ذلك
.فلنذهب في رحلة أخرى

329
00:21:50,910 --> 00:21:52,010
.نحن الأربعة

330
00:21:52,010 --> 00:21:53,590
.نحن الأربعة بالفعل

331
00:21:53,590 --> 00:21:57,000
.حسنًا، ما زالت شيراسي تملك المليون ينّ
...ولديّ مدّخراتي أيضًا

332
00:21:57,000 --> 00:21:58,040
.لم تعد معي الآن

333
00:21:59,550 --> 00:22:00,740
.لقد تركتُها هناك

334
00:22:03,370 --> 00:22:05,370
.في المكان الأبعد من الكون

335
00:22:11,750 --> 00:22:14,860
،عندما نشدّ رحالنا إلى وجهة ما
.نتعلّم أمورًا للمرّة الأولى

336
00:22:16,210 --> 00:22:20,360
.نتعلّم أنّ ذلك المشهد لا غنى عنه

337
00:22:21,050 --> 00:22:25,370
أنّ النّاس يتغيّرون وأنّ العالم يتغيّر
.حتّى عندما لا ننظر إليهم

338
00:22:26,390 --> 00:22:30,870
.نعلم أنّه لا يوجد شيء يُدعى يوم فراغ

339
00:22:32,020 --> 00:22:34,370
.نتعلّم أنّ لمنزلنا رائحته الخاصّة

340
00:22:36,690 --> 00:22:40,130
.إن أردنا تعلّم هذه الأمور، فعلينا التّحرّك

341
00:22:41,270 --> 00:22:46,140
ثمّ علينا أن نواصل التّقدّم إلى
.أن نرى شيئًا لم نره من قبل

342
00:22:46,880 --> 00:22:50,390
،مهما كانت وجهتنا بعيدة
...فإنّ العالم واسع جدًّا

343
00:22:50,580 --> 00:22:53,550
.سنجد شيئًا جديدًا بكلّ تأكيد

344
00:22:55,650 --> 00:22:58,740
الأمر مخيف قليلاً، لكنّني واثقة
.أنّكم قادرون على ذلك

345
00:23:00,160 --> 00:23:01,120
...لأنّ

346
00:23:28,850 --> 00:23:32,120
لماذا؟

347
00:23:32,630 --> 00:23:36,390
من يتشاركون نفس الإحساس
.سيجدونكم في الحال

348
00:23:37,140 --> 00:23:39,350
!لماذا؟