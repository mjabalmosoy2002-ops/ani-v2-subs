1
00:00:13,540 --> 00:00:15,990
.يمكنني أن أموت الآن

2
00:01:52,480 --> 00:01:56,110
.تلاميذ ثانويّة. القطب الجنوبيّ

3
00:01:56,110 --> 00:01:57,760
.أشكّ بشدّة أنّنا قد نعثر على شيء ما

4
00:01:58,740 --> 00:01:59,740
.تفضّلي

5
00:01:59,740 --> 00:02:01,080
!شكرًا لك

6
00:02:01,080 --> 00:02:01,930
!ساخن

7
00:02:02,140 --> 00:02:03,760
!لماذا قدّمته لنا ساخنًا؟

8
00:02:03,760 --> 00:02:05,880
...قالت جدّتي أنّنا ما زلنا في شهر ماي

9
00:02:05,880 --> 00:02:07,770
!حتّى إن كنّا في شهر ماي، ما زال ساخنًا

10
00:02:08,020 --> 00:02:09,590
.أريد شايًا باردًا

11
00:02:09,590 --> 00:02:10,640
!وبعض الحلويّات معه أيضًا

12
00:02:10,640 --> 00:02:12,980
!أطلب شيئًا مثل البودينغ

13
00:02:12,980 --> 00:02:15,280
ألا تعتقدان أنّ هذا غريب قليلاً؟

14
00:02:15,560 --> 00:02:16,610
غريب؟

15
00:02:16,610 --> 00:02:19,670
الفتاة الّتي فكّرت في الخطّة الأخيرة تقول هذا؟

16
00:02:19,670 --> 00:02:23,040
صحيح! ألا تدركين كم كنّا محرجتين؟

17
00:02:23,040 --> 00:02:24,660
ما كان يفترض بي فعله؟

18
00:02:24,660 --> 00:02:26,520
.كان ذلك خيارنا الوحيد

19
00:02:26,520 --> 00:02:28,890
...ورغم ذلك

20
00:02:30,860 --> 00:02:31,590
ماذا؟ ماذا؟

21
00:02:31,590 --> 00:02:32,580
!فتاة في الثّانويّة

22
00:02:33,120 --> 00:02:34,740
!لقد ذهبت إلى القطب الجنوبيّ

23
00:02:35,910 --> 00:02:40,410
أعلنت البعثة الاستكشافيّة المدنيّة"
"المخطّط لها أن تذهب للقطب الجنوبيّ

24
00:02:40,410 --> 00:02:44,020
أنّها سترسل فتاة في الثّانويّة مع فريقها الإخباريّ"؟"

25
00:02:44,020 --> 00:02:47,700
الفتاة المشاركة هي الشّخصيّة"
"...المشهورة شيرايشي يوزوكي-سان

26
00:02:47,700 --> 00:02:50,660
ستوفّر أخبارًا أوّل بأوّل على الإنترنت"
حول الرّحلة للقطب الجنوبيّ

27
00:02:50,660 --> 00:02:52,980
".والأوضاع في محطّة شوا

28
00:02:52,980 --> 00:02:54,730
!لقد سبقتني فتاة أخرى

29
00:02:55,020 --> 00:02:56,680
!لم أكن أعلم بشأن هذا

30
00:02:56,680 --> 00:02:59,270
...لم يذكر أعضاء البعثة أيّ شيء عن هذا

31
00:02:59,270 --> 00:03:01,430
على الأرجح أنّهم أدركوا المشاكل
.الّتي قد يسبّبها ذلك

32
00:03:01,430 --> 00:03:02,280
أرأيت؟

33
00:03:02,470 --> 00:03:04,840
صحفيّة... مراسلة... أين؟

34
00:03:04,840 --> 00:03:06,040
...لحظة... لحظة... لحظة

35
00:03:06,330 --> 00:03:07,540
.شيرايشي يوزوكي

36
00:03:10,100 --> 00:03:11,220
وماذا نقول بالضّبط؟

37
00:03:11,220 --> 00:03:13,510
.سليهم إن كان بإمكاننا الذّهاب معها

38
00:03:13,510 --> 00:03:16,420
أنا ابنة عضوة في بعثة استكشافيّة
.للقطب الجنوبيّ وفتاة في الثّانويّة

39
00:03:16,420 --> 00:03:17,910
!أعرف كلّ شيء عن القطب الجنوبيّ

40
00:03:17,910 --> 00:03:19,250
.اتّصلي بها بنفسك

41
00:03:19,250 --> 00:03:22,230
...لكنّي لست مناسبة لتلك الأمور

42
00:03:22,230 --> 00:03:23,510
...جميعهم غرباء في نهاية المطاف

43
00:03:23,510 --> 00:03:26,970
.لقد بدأت أفهم تدريجيًّا كيف تفكّر هذه الفتاة

44
00:03:26,970 --> 00:03:28,020
.وأنا أيضًا

45
00:03:28,640 --> 00:03:29,390
!رنّة

46
00:03:34,100 --> 00:03:35,240
!مستحيل، مستحيل، مستحيل

47
00:03:35,240 --> 00:03:39,360
اتركيه! تريدين الذّهاب للقطب الجنوبيّ، صحيح؟

48
00:03:38,890 --> 00:03:39,840
...المعذرة

49
00:03:39,360 --> 00:03:41,370
!كيف تجرئين على إرغامي على هذا؟

50
00:03:41,370 --> 00:03:43,010
!نفس الشّيء ينطبق عليك

51
00:03:42,360 --> 00:03:43,820
مرحبًا؟

52
00:03:45,510 --> 00:03:46,390
بماذا تفكّرين؟

53
00:03:46,390 --> 00:03:47,260
...المعذرة

54
00:03:48,810 --> 00:03:51,860
أنت هي كوبوتشيزاما شيراسي-سان، صحيح؟

55
00:03:52,300 --> 00:03:53,620
نعم؟

56
00:03:53,620 --> 00:03:58,090
.سررت بلقائك. اسمي شيرايشي يوزوكي

57
00:03:58,880 --> 00:04:00,140
...شيرايشي

58
00:04:00,140 --> 00:04:01,270
يوزوكي؟

59
00:04:01,900 --> 00:04:04,690
...ماذا؟ أليس ذلك هو اسم

60
00:04:16,280 --> 00:04:17,830
!إنّها على موسوعة ويكي

61
00:04:17,830 --> 00:04:21,520
ممثّلة طفلة بدأت في مجال
.الإعلانات في سنّ الخامسة

62
00:04:21,520 --> 00:04:24,200
لديها 38 ألف متابع؟

63
00:04:24,200 --> 00:04:27,950
أطلقت أوّل أغنية لها بعنوان
."المتابعات لا تتوقّف"

64
00:04:31,400 --> 00:04:32,100
!شيراسي-تشان

65
00:04:32,100 --> 00:04:33,130
!التقطي صورة

66
00:04:33,130 --> 00:04:36,710
نشر صورة مع قاصر دون إذن
.هو خرق لحقوق الشّخصيّة

67
00:04:36,090 --> 00:04:38,540
هل يمكنني إذًا الحصول على توقيعك وبصمة يدك؟

68
00:04:38,540 --> 00:04:39,640
!إنّها ليست مصارِعة سومو

69
00:04:39,640 --> 00:04:41,460
لكن لماذا أنت هنا؟

70
00:04:41,800 --> 00:04:43,920
.صحيح... أردت الحديث معك

71
00:04:43,920 --> 00:04:44,800
عمّاذا؟

72
00:04:45,240 --> 00:04:48,000
هلاّ ذهبتِ إلى القطب الجنوبيّ بدلاً منّي؟

73
00:04:49,820 --> 00:04:50,730
ماذا؟

74
00:04:50,730 --> 00:04:51,350
.القطب الجنوبيّ

75
00:04:52,220 --> 00:04:53,550
تريدين الذّهاب، صحيح؟

76
00:04:53,850 --> 00:04:56,900
أين سرّبت الأمر؟ لوحة الرّسائل؟ تويتر؟ على جدارك؟

77
00:04:56,320 --> 00:04:57,610
!لم أسرّب الأمر

78
00:04:57,610 --> 00:04:58,860
...كلاّ، كلاّ

79
00:04:59,500 --> 00:05:03,090
هل تتذكّرين الاجتماع في شينجوكو من قبل؟

80
00:05:03,090 --> 00:05:05,030
.تمّت دعوتي أيضًا

81
00:05:05,030 --> 00:05:06,610
.سمعت عنك هناك

82
00:05:07,100 --> 00:05:08,120
.فهمت

83
00:05:08,510 --> 00:05:09,990
لكن ماذا تقصدين بالذّهاب بدلاً منك؟

84
00:05:11,260 --> 00:05:13,870
.ببساطة، لا أريد الذّهاب

85
00:05:14,830 --> 00:05:18,670
أنا من هوكّايدو في الأصل، لذلك
.فقد سئمت من البرد كبداية

86
00:05:18,670 --> 00:05:23,340
أعتقد أنّ ذهاب أيّ فتاة في الثّانويّة
...سيناسب متطلّبات المشروع، لذا

87
00:05:23,340 --> 00:05:24,200
...أنت

88
00:05:25,840 --> 00:05:26,510
أنت واثقة؟

89
00:05:28,510 --> 00:05:29,550
!شيراسي

90
00:05:29,860 --> 00:05:31,060
!شيراسي-تشان

91
00:05:31,280 --> 00:05:32,490
!نجحتِ

92
00:05:34,570 --> 00:05:36,810
!أجل... أجل

93
00:05:37,750 --> 00:05:38,850
!أجل

94
00:05:39,110 --> 00:05:42,980
أرأيت؟ لقد أخبرتك، صحيح؟ أخبرتك
!أنّ خطّتي ستنجح بشكل مثاليّ

95
00:05:42,220 --> 00:05:42,980
...لكن

96
00:05:42,980 --> 00:05:45,550
أقلتِ مستحيل؟ أقلتِ أنّ الأمر سخيف؟

97
00:05:44,810 --> 00:05:46,740
أكان هذا... جزءًا من الخطّة؟

98
00:05:45,550 --> 00:05:46,740
لقد نجح، صحيح؟

99
00:05:47,530 --> 00:05:49,490
!نجحتُ أيّها القطب الجنوبيّ
!وأخيرًا أيّها القطب الجنوبيّ

100
00:05:49,900 --> 00:05:50,910
!انتظروني أيّتها البطاريق

101
00:05:51,160 --> 00:05:52,490
!انتظرني أيّها الشّفق القطبيّ

102
00:05:55,370 --> 00:05:56,620
.لا بدّ أنّ ذلك مؤلم

103
00:05:56,950 --> 00:05:58,590
.آسفة، إنّها غبيّة

104
00:05:58,590 --> 00:05:59,460
...لا بأس

105
00:06:02,660 --> 00:06:04,420
أهذا هو طريق الخروج الوحيد؟

106
00:06:05,180 --> 00:06:05,960
...نعم، لكن

107
00:06:06,280 --> 00:06:07,380
.سوف أغادر إذًا

108
00:06:07,380 --> 00:06:08,240
.أستأذن

109
00:06:08,240 --> 00:06:09,510
!مهلاً

110
00:06:17,280 --> 00:06:18,560
.مرحبًا

111
00:06:20,460 --> 00:06:23,440
.أنا مديرة أعمال يوزوكي

112
00:06:23,910 --> 00:06:26,060
.اسمي شيرايشي تاميكو

113
00:06:27,100 --> 00:06:28,480
شيرايشي؟

114
00:06:28,480 --> 00:06:29,700
.أنا والدتها أيضًا

115
00:06:30,030 --> 00:06:31,300
.ذلك ما ظننتُه

116
00:06:31,300 --> 00:06:33,700
.أخبرتك مرارًا أنّي لا أريد الذّهاب

117
00:06:33,900 --> 00:06:36,700
لكن عليك الذّهاب. هذا عملك، هل نسيت؟

118
00:06:37,030 --> 00:06:39,780
أخبرت هؤلاء الفتيات أنّ بإمكانهنّ
.الذّهاب بدلاً منّي

119
00:06:39,780 --> 00:06:43,290
هل تعتقدين بالفعل أنّه بإمكانك
اتّخاذ قرار كهذا؟

120
00:06:43,290 --> 00:06:43,960
.أستأذن الآن

121
00:06:46,890 --> 00:06:47,800
ما هذا؟

122
00:06:47,800 --> 00:06:49,340
...حسنًا... أنا

123
00:06:49,710 --> 00:06:51,630
عليها أن تقدّم تقريرها عن القطب
الجنوبيّ فحسب، صحيح؟

124
00:06:51,630 --> 00:06:52,840
!أعتقد أنّ بإمكانها فعل ذلك

125
00:06:52,840 --> 00:06:56,630
!إنّها جميلة، انظري؟ إنّها كممثّلة مشهورة

126
00:06:58,100 --> 00:06:58,980
هل يمكنها الأداء؟

127
00:06:59,690 --> 00:07:00,890
!بـ-بالطّبع

128
00:07:01,390 --> 00:07:06,650
...أنا حا-حاليًّا... في... القطب
...الجنوبيّ... الجوّ

129
00:07:04,950 --> 00:07:06,650
!مرحبًا! لا يمكنني سماعك

130
00:07:07,540 --> 00:07:10,360
!مهلاً! أنا يمكنني الأداء! سأتولّى الأمر

131
00:07:10,660 --> 00:07:15,120
!مرحبًا! أنا موجودة في القطب الجنوبيّ
يا شعب اليابان، هل تشاهدونني؟

132
00:07:15,370 --> 00:07:16,370
أيمكنك أن تكوني جذّابة؟

133
00:07:16,890 --> 00:07:18,430
!إنّها لم تحاول حتّى تلطيف كلامها

134
00:07:18,430 --> 00:07:21,000
...اخرسي! حسنًا، في تلك الحالة

135
00:07:21,350 --> 00:07:23,000
!ما رأيك؟

136
00:07:23,000 --> 00:07:24,310
.أستأذن الآن

137
00:07:24,800 --> 00:07:25,500
ماذا؟

138
00:07:27,240 --> 00:07:29,210
ماذا نفعل من الأساس؟

139
00:07:36,520 --> 00:07:38,270
...لـ-لحظة

140
00:07:38,930 --> 00:07:39,980
ماذا؟

141
00:07:42,480 --> 00:07:46,980
...قـ-قد يبدو كلامي مفاجئًا، لكن

142
00:07:47,850 --> 00:07:49,940
هلاّ أصبحتنّ صديقاتي؟

143
00:07:51,780 --> 00:07:53,950
أخبرتك من قبل، صحيح؟

144
00:07:54,450 --> 00:07:57,510
،عندما ستنتقلين لسنتك الثّانية
.ستحصلين على المزيد من وقت الفراغ

145
00:07:58,780 --> 00:08:00,450
ألا يمكنك تحمّل الأمر لسنة واحدة فقط؟

146
00:08:00,780 --> 00:08:01,720
.كلاّ

147
00:08:01,720 --> 00:08:04,510
ليس عليك أن تقلقي. سوف أحرص على أن تحضري
—في الوقت لامتحانات الولو

148
00:08:04,510 --> 00:08:06,330
.لا أهتمّ لامتحانات الولوج

149
00:08:06,750 --> 00:08:09,460
.لا أذهب للثّانويّة من أجل امتحانات الولوج

150
00:08:17,780 --> 00:08:20,520
.وأنا الّتي ظننتُ أنّنا عثرنا على معجزة

151
00:08:20,520 --> 00:08:23,600
من المؤسف أنّ شيراسي لا تستطيع
.الحديث أمام النّاس

152
00:08:23,600 --> 00:08:25,270
—لكن يا هيناتا-تشان، أنت أيضًا لم

153
00:08:25,270 --> 00:08:26,600
!ليس عليك إضافة الملح على الجرح

154
00:08:26,600 --> 00:08:28,520
!لقد أخافها ذلك أكثر ممّا ظننت

155
00:08:30,170 --> 00:08:31,030
—مرحبًا بـ

156
00:08:31,970 --> 00:08:32,950
!حصلنا عليها

157
00:08:33,710 --> 00:08:34,700
حصلنا على ماذا؟

158
00:08:37,900 --> 00:08:39,330
نقنعها؟

159
00:08:39,540 --> 00:08:43,080
.نعم. يبدو أنّ الفتاة ترفض الذّهاب

160
00:08:43,540 --> 00:08:45,120
،إن كان بإمكانك إقناعها بالذّهاب

161
00:08:49,680 --> 00:08:50,740
ما قولك؟

162
00:08:52,060 --> 00:08:54,010
...بعبارات أخرى، إن أقنعناها بالذّهاب

163
00:08:54,010 --> 00:08:55,620
!فهمت

164
00:08:55,620 --> 00:08:58,010
لكنّ يوزوكي-تشان قد رحلت، صحيح؟

165
00:08:58,010 --> 00:09:00,980
،في الحقيقة، لديها عمل في طوكيو يوم الأحد

166
00:09:00,980 --> 00:09:03,390
!وسوف تنزل في فندق حتّى يوم السّبت

167
00:09:03,700 --> 00:09:05,640
الجمعة والسّبت... يومان؟

168
00:09:05,930 --> 00:09:07,530
!ممّا يعني أنّه ليس هنالك وقت لنضيّعه

169
00:09:07,530 --> 00:09:08,190
!لنذهب

170
00:09:08,470 --> 00:09:09,870
.تجاوزت السّاعة العاشرة

171
00:09:09,870 --> 00:09:12,340
.نذهب غدًا صباحًا إذًا، قبل المدرسة
الخامسة فجرًا؟

172
00:09:12,340 --> 00:09:13,920
مهلاً، مهلاً. هل سنجرّها من سريرها؟

173
00:09:13,920 --> 00:09:16,490
!السّادسة إذًا؟ السّابعة؟ متى نذهب؟

174
00:09:16,740 --> 00:09:17,740
.اهدئي

175
00:09:20,850 --> 00:09:23,130
،إن كانت قد قرّرت عدم الذّهاب

176
00:09:23,130 --> 00:09:26,000
.فلا بدّ أنّ لديها سببًا وجيهًا لعدم رغبتها في ذلك

177
00:09:26,260 --> 00:09:28,590
.ظننتُها قالت أنّها لا تحبّ البرد فحسب

178
00:09:28,590 --> 00:09:30,770
.قالت ذلك بشكل صريح جدًّا

179
00:09:30,770 --> 00:09:33,360
ذلك يعني أنّ لديها سببًا وجيهًا أكثر
.لعدم رغبتها في الذّهاب

180
00:09:33,360 --> 00:09:34,970
!هيناتا-تشان، أنت ناضجة للغاية

181
00:09:34,970 --> 00:09:36,160
ما السّبب إذًا؟

182
00:09:36,160 --> 00:09:38,130
.حسنًا، لا أعرف ذلك بعد

183
00:09:38,130 --> 00:09:41,140
لكنّ السّؤال عن ذلك يجب
.أن يكون مهمّتنا الأولى

184
00:09:42,230 --> 00:09:44,020
السّبب؟

185
00:09:44,620 --> 00:09:46,550
!كلاّ! نلقاك لاحقًا

186
00:09:46,550 --> 00:09:47,270
!حسنًا

187
00:09:47,270 --> 00:09:48,710
!ألقاكما غدًا

188
00:09:54,480 --> 00:09:55,750
ما الخطب؟

189
00:09:55,750 --> 00:09:56,860
.أكره نفسي

190
00:09:58,680 --> 00:10:02,300
كنت أفكّر في أنّك قد تكونين
.على حقّ يا هيناتا-تشان

191
00:10:03,210 --> 00:10:07,750
في النّهاية، كنتُ أعطي الأولويّة
.لمشاعري بشكل أساسيّ

192
00:10:07,750 --> 00:10:09,880
.لم أكن أفكّر في أيّ أحد آخر

193
00:10:09,880 --> 00:10:11,380
أدركتِ ذلك للتّوّ؟

194
00:10:11,630 --> 00:10:13,390
.أمزح فحسب

195
00:10:13,390 --> 00:10:17,380
كما يُقال، الفرق ضئيل جدًّا بين
.الثّقة العالية والأنانيّة

196
00:10:17,710 --> 00:10:18,900
من قال ذلك؟

197
00:10:18,900 --> 00:10:19,970
!أنا

198
00:10:32,090 --> 00:10:33,610
أستعملين اليوم؟

199
00:10:33,800 --> 00:10:34,670
!كلاّ

200
00:10:34,670 --> 00:10:36,720
أتريدين الخروج للأكل معًا إذًا؟

201
00:10:39,880 --> 00:10:40,860
القطب الجنوبيّ؟

202
00:10:41,780 --> 00:10:43,190
هل يسير الأمر على ما يرام؟

203
00:10:43,570 --> 00:10:46,000
...حسنًا... لسنا واثقات بعد، لكن

204
00:10:46,500 --> 00:10:48,380
.آسفة. لنتحدّث لاحقًا

205
00:10:53,020 --> 00:10:53,880
هنا؟

206
00:10:54,850 --> 00:10:57,090
.الغرفة 305

207
00:10:59,430 --> 00:11:00,930
ما العمل؟ هـ-هـ-هل نتعقّبها؟

208
00:11:00,930 --> 00:11:02,300
بماذا سيفيدنا ذلك؟

209
00:11:02,710 --> 00:11:04,810
.صدفة. لنتظاهر أنّها صدفة

210
00:11:05,330 --> 00:11:07,360
!ماذا؟ هل تنزلين هنا؟

211
00:11:07,360 --> 00:11:08,310
إلى أين ذاهبة؟

212
00:11:10,140 --> 00:11:11,310
...صحيح

213
00:11:12,460 --> 00:11:13,810
الدّراسة؟

214
00:11:13,960 --> 00:11:17,500
.نعم. أريد أن أعوّض عن الدّروس الّتي فوّتّها

215
00:11:18,190 --> 00:11:21,600
يمكننا إعادة ملء مشروباتنا مجّانًا في
.هذا المحلّ، كما أنّه يتأخّر في الإغلاق

216
00:11:22,330 --> 00:11:23,620
...حسّك بالمسؤولية كبير

217
00:11:24,040 --> 00:11:25,770
تردن التّحدّث عن القطب الجنوبيّ، صحيح؟

218
00:11:25,770 --> 00:11:27,870
.أنا آسفة، لم أحرز أيّ تقدّم بعد

219
00:11:28,290 --> 00:11:31,240
...نـ-نعم، نعرف ذلك، لكن

220
00:11:31,240 --> 00:11:34,500
.هنالك أمر آخر أردنا أن نسألك عنه

221
00:11:34,500 --> 00:11:35,130
ما هو؟

222
00:11:36,130 --> 00:11:38,590
لماذا لا تريدين الذّهاب؟

223
00:11:39,740 --> 00:11:41,010
هل من الغريب ألاّ أرغب في الذّهاب؟

224
00:11:41,010 --> 00:11:44,110
!ولِمَ لا؟ هنالك بطاريق في القطب الجنوبيّ

225
00:11:44,110 --> 00:11:45,260
!وجبال ثلجيّة أيضًا

226
00:11:45,260 --> 00:11:47,740
!ويمكن مشاهدة الشّفق القطبيّ

227
00:11:47,740 --> 00:11:50,310
لقد أقنعتكنّ أمّي بأمر ما، صحيح؟

228
00:11:50,310 --> 00:11:53,230
هل تريد منكنّ أن تقنعنني بالذّهاب؟

229
00:11:53,520 --> 00:11:55,150
...تحديق

230
00:11:58,290 --> 00:11:59,000
.نعم

231
00:11:59,000 --> 00:11:59,650
!جبانة

232
00:12:00,520 --> 00:12:06,370
لكنّي ما زلت أرغب في معرفة سبب
.عدم رغبتك في الذّهاب

233
00:12:06,370 --> 00:12:07,910
لماذا عليّ إخبارك؟

234
00:12:10,050 --> 00:12:12,160
...حسنًا، لا بأس إن لم ترغبي بذلك

235
00:12:20,340 --> 00:12:23,930
.أشكّ أنّكنّ قد تفهمن

236
00:12:24,380 --> 00:12:26,240
.ليس لديّ أيّ أصدقاء

237
00:12:26,780 --> 00:12:28,190
.ليس الآن فحسب

238
00:12:29,130 --> 00:12:30,190
.بل على الإطلاق

239
00:12:30,560 --> 00:12:32,050
.ولا صديق واحد

240
00:12:33,700 --> 00:12:36,940
.لقد كنت ممثّلة مذ كنت في الرّابعة من عمري

241
00:13:16,620 --> 00:13:19,060
.العفو! فلنخرج معًا لاحقًا

242
00:13:19,450 --> 00:13:20,550
فعلاً؟

243
00:13:20,550 --> 00:13:21,570
.أكيد

244
00:13:21,840 --> 00:13:23,750
هل يمكننا أخذ صورة معك أيضًا؟

245
00:13:23,750 --> 00:13:26,220
،يوزوكي-تشان شخصيّة مشهورة
.لذلك سيرغب النّاس في رؤية الصّور

246
00:13:26,220 --> 00:13:28,000
!تصوّري معي أيضًا

247
00:13:28,570 --> 00:13:29,630
...آسفة

248
00:13:32,350 --> 00:13:34,200
.هكذا إذًا، وداعًا

249
00:13:35,380 --> 00:13:38,790
الانطباعات الأولى مهمّة، صحيح؟

250
00:13:40,260 --> 00:13:42,460
.عليّ أن أعمل بجدّ لأجد صداقات الآن

251
00:13:42,860 --> 00:13:47,910
...علاقات ومجموعات جيّدة
.إنّها تحدّد هويّاتنا بشكل أساسيّ

252
00:13:49,350 --> 00:13:50,780
ما-ماذا؟

253
00:13:50,780 --> 00:13:53,070
!أردتُ أن أحضنك فجأة فحسب

254
00:13:53,580 --> 00:13:55,020
!لا يمكنني التّنفّس

255
00:13:56,000 --> 00:13:57,790
!أنا أتفهّك تمامًا

256
00:13:57,790 --> 00:14:00,390
لطالما كرهت دورات المدارس
!الجديدة وما إلى ذلك أيضًا

257
00:14:00,390 --> 00:14:02,110
!أنت لا تفهمين

258
00:14:02,110 --> 00:14:02,940
!بل أفهم

259
00:14:02,940 --> 00:14:03,730
!كلاّ، لا تفهمين

260
00:14:04,180 --> 00:14:06,820
لأنّكنّ صديقات حميمات، صحيح؟

261
00:14:07,870 --> 00:14:09,120
صديقات حميمات؟

262
00:14:12,860 --> 00:14:14,080
أليس كذلك؟

263
00:14:14,720 --> 00:14:17,840
.لم يمرّ على معرفتنا ببعضنا حتّى شهر واحد

264
00:14:17,840 --> 00:14:19,830
.كما أنّنا لم نخرج حتّى معًا

265
00:14:20,960 --> 00:14:24,050
.جميعنا نحاول الذّهاب لنفس المكان فحسب

266
00:14:24,720 --> 00:14:26,240
.في الوقت الحاليّ على الأقلّ

267
00:14:28,070 --> 00:14:28,910
صحيح؟

268
00:14:29,300 --> 00:14:29,940
.نعم

269
00:14:29,940 --> 00:14:31,050
!نعم

270
00:14:34,870 --> 00:14:36,840
.آسفات لجعلك تتأخّرين هكذا

271
00:14:36,840 --> 00:14:39,560
.أتمنّى أن تتفهّم والدتك

272
00:14:40,350 --> 00:14:44,710
على الإطلاق. أشعر بتحسّن أكثر
.بعد أن تحدّثت عن الأمر

273
00:14:44,710 --> 00:14:45,520
.إلى اللّقاء

274
00:14:46,670 --> 00:14:47,810
!مع السّلامة

275
00:14:53,860 --> 00:14:57,450
إذًا... ما الّذي خرجنا به من هذا الأمر؟

276
00:14:57,450 --> 00:14:58,460
ماذا تقصدين؟

277
00:14:58,460 --> 00:15:02,080
!هل نسيت؟ أتينا إلى هنا لإقناعها

278
00:15:02,300 --> 00:15:04,300
!أجل! هذا صحيح

279
00:15:04,300 --> 00:15:07,970
،ماذا؟ لكن إن رفضت يوزوكي-تشان

280
00:15:07,970 --> 00:15:10,340
...تستطيع شيراسي-تشان الذّهاب مكانها

281
00:15:11,100 --> 00:15:13,420
...إن أقنعناها، فيمكننا الذّهاب معًا

282
00:15:13,420 --> 00:15:14,010
ماذا؟

283
00:15:14,010 --> 00:15:18,090
،لكن إن رفضت يوزوكي-تشان
...ستذهب شيراسي-تشان مكانها

284
00:15:18,090 --> 00:15:20,150
!أنا مرتبكة

285
00:15:20,150 --> 00:15:21,350
!تمالك نفسك

286
00:15:21,630 --> 00:15:23,470
،إن رفضت

287
00:15:23,470 --> 00:15:26,810
فسوف يبحثون عن فنّانة أخرى
.للذّهاب بدلاً منها

288
00:15:26,810 --> 00:15:27,690
!فهمت

289
00:15:28,400 --> 00:15:30,960
.كان إقناعها الفرصة الوحيدة

290
00:15:32,020 --> 00:15:33,200
...لكن

291
00:15:34,010 --> 00:15:36,430
.حسنًا، أعتقد أنّ لا بأس بهذا

292
00:15:50,850 --> 00:15:54,500
.كانت تلك أوّل مرة فعل أحدهم ذلك لي

293
00:16:06,940 --> 00:16:10,630
هل ذلك هو إحساس... امتلاك أصدقاء؟

294
00:16:35,640 --> 00:16:36,930
!كيماري-سان

295
00:16:36,930 --> 00:16:38,760
!لنذهب إلى القطب الجنوبيّ

296
00:16:39,120 --> 00:16:41,770
!ما الّذي تفعلنه؟ سوف يوبّخنكنّ

297
00:16:41,770 --> 00:16:43,480
!لا بأس، لنذهب فحسب

298
00:16:44,020 --> 00:16:45,930
!هيّا، الرّياح تهبّ بشدّة

299
00:16:45,930 --> 00:16:46,730
!بسرعة

300
00:16:46,990 --> 00:16:48,480
...لكنّي

301
00:16:48,480 --> 00:16:50,060
!أمسكي بيدي

302
00:17:42,270 --> 00:17:43,370
.يا له من حلم غريب

303
00:18:31,720 --> 00:18:32,960
!صباح الخير

304
00:18:34,670 --> 00:18:35,710
...أنتنّ

305
00:18:35,710 --> 00:18:38,820
!أخبرتك أنّ الوقت لا يزال باكرًا
!إنّها لا تزال مرتدية منامتها

306
00:18:38,820 --> 00:18:40,680
!شيراسي-تشان من قالت ذلك

307
00:18:40,680 --> 00:18:43,670
ماذا كان يفترض بي أن أفعل؟
.الرّحلة طويلة حتّى طوكيو

308
00:18:43,670 --> 00:18:44,600
طوكيو؟

309
00:18:45,060 --> 00:18:48,960
،نعم! سمعنا أنّ لديك عملاً في طوكيو

310
00:18:48,960 --> 00:18:51,370
!لذلك فكّرت في أن نذهب معًا

311
00:18:51,370 --> 00:18:53,280
!آسفات لمفاجأتك هكذا

312
00:18:53,280 --> 00:18:55,660
.كلّ هذا لأنّها لم تسأل عن معلومات الاتّصال بك

313
00:18:55,660 --> 00:18:56,640
!أنا؟

314
00:18:56,640 --> 00:18:58,070
هل لديك وقت؟

315
00:18:58,940 --> 00:18:59,540
.نعم

316
00:18:59,540 --> 00:19:01,330
...فعلاً؟! حسنًا، حسنًا

317
00:19:01,330 --> 00:19:03,630
...يمكننا الذّهاب لمتحف طوكيو... القطبيّ

318
00:19:16,240 --> 00:19:17,840
ما-ما الخطب؟

319
00:19:28,370 --> 00:19:31,120
!كيماري

320
00:19:31,120 --> 00:19:32,010
ماذا فعلت؟

321
00:19:32,010 --> 00:19:33,580
!لا بدّ أنّك السّبب

322
00:19:33,580 --> 00:19:37,250
...لكنّك من قلتِ أنّ علينا الذّهاب معًا

323
00:20:06,200 --> 00:20:10,060
ما أقوله هو أنّي سأذهب إن كان
.بمقدوري الذّهاب مع ثلاثتهنّ

324
00:20:11,260 --> 00:20:13,100
.ولن أذهب من دونهنّ

325
00:20:16,410 --> 00:20:18,610
!حسنًا يا يوزوكي-تشان! لنذهب

326
00:20:19,930 --> 00:20:20,770
!حسنًا

327
00:20:25,040 --> 00:20:28,090
!بـ-بطاريق

328
00:20:28,090 --> 00:20:30,050
ألا تبدو لطيفة ومنفوخة؟

329
00:20:30,050 --> 00:20:31,260
...نعم

330
00:20:33,720 --> 00:20:35,250
!إلى هنا

331
00:20:36,990 --> 00:20:38,090
!إنّه طويل

332
00:20:38,500 --> 00:20:40,340
!انظرن، يمكننا دخول هذه

333
00:20:40,650 --> 00:20:41,750
فعلاً؟

334
00:20:44,930 --> 00:20:47,050
المكان مزدحم هنا نوعًا ما، صحيح؟

335
00:20:47,050 --> 00:20:50,930
أعتقد أنّهم يستعملون نماذج جديدة
.لمركبات الثّلوج في هذه الأيّام بالطّبع

336
00:20:52,000 --> 00:20:54,160
!السّرعة القصوى، وأبقوها ثابتة

337
00:20:54,160 --> 00:20:55,940
.لا أظنّ أنّها قارب

338
00:20:57,450 --> 00:20:59,190
!سرير الطّوابق هذا لديه طابق واحد

339
00:20:59,450 --> 00:21:02,160
ذُكر أنّهم يحافظون على الحرارة بما يزيد عن 20
!درجة مئويّة في الغرف

340
00:21:02,160 --> 00:21:03,200
!ذلك جيّد

341
00:21:03,200 --> 00:21:05,860
!لأنّ الحرارة ستكون ناقص عشرة في الخارج

342
00:21:05,860 --> 00:21:07,770
...أراهن أنّ أنفي سيسيل

343
00:21:10,600 --> 00:21:12,580
!اقتربن أكثر

344
00:21:23,870 --> 00:21:26,610
!أراهن أنّ الشّفق القطبيّ الحقيقيّ أجمل بكثير

345
00:21:26,610 --> 00:21:29,400
.نعم، سمعت أنّه جميل للغاية

346
00:21:29,400 --> 00:21:32,270
.قالت أمّي أنّه دفعها للبكاء

347
00:21:32,710 --> 00:21:36,410
لكن لا يتسنّى للكثير من النّاس
رؤية الشّفق القطبيّ، صحيح؟

348
00:21:36,410 --> 00:21:38,190
.سمعتُ ذلك أيضًا

349
00:21:39,490 --> 00:21:42,670
،حينها، إذا تسنّى لنا الذّهاب بالفعل

350
00:21:42,670 --> 00:21:46,780
فقد نكون تلاميذ الثّانويّة الوحيدين في العالم
.الّذين رأوا الشّفق القطبيّ من القطب الجنوبيّ

351
00:21:47,140 --> 00:21:48,410
فعلاً؟

352
00:21:49,200 --> 00:21:50,530
...في تلك الحالة

353
00:21:57,010 --> 00:21:58,970
.يمكنني أن أموت الآن