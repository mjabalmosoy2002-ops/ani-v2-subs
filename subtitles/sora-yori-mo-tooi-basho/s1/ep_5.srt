1
00:00:01,230 --> 00:00:06,700
ستنطلق التّلميذتان تاماكي ماري-سان وكوبوتشيزاوا
.شيراسي-سان في رحلة للقطب الجنوبيّ الشّهر القادم

2
00:00:06,700 --> 00:00:07,480
.تقدّما رجاءً

3
00:00:09,210 --> 00:00:10,480
...المعذرة

4
00:00:10,850 --> 00:00:14,830
،ما زال من الصّعب تصديق أنّ الأمر سيحدث

5
00:00:14,830 --> 00:00:16,520
!لكنّني سأبذل جهدي حيث سأذهب

6
00:00:19,370 --> 00:00:20,790
.أنا ذاهبة

7
00:00:35,860 --> 00:00:37,600
.ما كان عليك الانتظار كثيرًا

8
00:00:37,600 --> 00:00:38,390
...لكن

9
00:00:39,080 --> 00:00:41,060
.فهمت، فهمت

10
00:00:41,060 --> 00:00:42,890
.لقد أسعدني ذلك

11
00:00:54,340 --> 00:00:56,090
.أنت ذكيّة جدًّا يا ميغومي-تشان

12
00:00:59,070 --> 00:01:01,700
.شعرت أنّني أصبحت أختًا كبرى

13
00:01:02,300 --> 00:01:03,330
.ماري-تشان

14
00:01:05,020 --> 00:01:07,410
.يمكننا اللّعب معًا غدًا أيضًا

15
00:02:44,850 --> 00:02:50,000
هذه هي سفينة القطب الجنوبيّ الكاسرة
،للجليد المعدّلة من سفينة شيراسي 2

16
00:02:50,000 --> 00:02:52,810
!"سفينة "شيتشيشينيا بينغوين مانجو

17
00:02:52,810 --> 00:02:56,990
أداؤها الأساسيّ لم يتغيّر، لكن تمّ
،إدخال بعض التّعديلات الدّاخليّة

18
00:02:56,990 --> 00:02:59,920
!وكما ترون، حصلت على تعديل خارجيّ كبير

19
00:03:00,960 --> 00:03:02,720
"!لندخل"

20
00:03:02,720 --> 00:03:05,040
!هو ما أريد إخباركم به

21
00:03:05,040 --> 00:03:08,830
لكن في الحقيقة، لن نتمكّن من الصّعود
.على متنها حتّى تصل إلى أستراليا

22
00:03:08,830 --> 00:03:12,310
!لذلك، لنقفز إلى أستراليا في الحال

23
00:03:12,310 --> 00:03:13,530
...واحد، اثنان

24
00:03:13,530 --> 00:03:15,450
!قفز

25
00:03:15,450 --> 00:03:16,670
!حسنًا! هذا جيّد

26
00:03:18,460 --> 00:03:19,520
!يا لك من محترفة

27
00:03:19,520 --> 00:03:21,010
!كنتِ رائعة

28
00:03:21,430 --> 00:03:22,540
.ليس عليكما السّخريّة منّي

29
00:03:22,540 --> 00:03:23,760
!كلاّ! كلاّ

30
00:03:23,760 --> 00:03:26,050
.نحن نحترمك بالفعل

31
00:03:26,750 --> 00:03:30,010
لكن في المقابل، لن نقدّمَ تقريرنا
،التّالي حتّى نصل إلى أستراليا

32
00:03:30,010 --> 00:03:31,440
.لكن انظرا إلى مدى خوفها من الآن

33
00:03:32,500 --> 00:03:35,170
...أ-أنا هنا في أستلاريا. مهلاً! أعني

34
00:03:35,170 --> 00:03:36,360
...عليّ أن أقفز أوّلاً

35
00:03:36,780 --> 00:03:37,400
.ثمّ أهبط

36
00:03:37,670 --> 00:03:38,450
!مهلاً، كلاّ

37
00:03:38,450 --> 00:03:39,570
أهبط ثمّ أقفز؟

38
00:03:39,570 --> 00:03:40,670
أهبط؟

39
00:03:40,670 --> 00:03:41,680
...أهبط تعني

40
00:03:43,190 --> 00:03:44,660
.اهدئي يا شيراسي-سان

41
00:03:44,660 --> 00:03:47,690
!ماذا سأفعل؟! لا أستطيع الهبوط في أستراليا

42
00:03:47,690 --> 00:03:50,300
.يمكنهم تعديل الأمر في مرحلة التّحرير

43
00:03:50,300 --> 00:03:52,210
.قومي في الوقت الحاليّ بالتّمارين الصّوتيّة فحسب

44
00:03:52,210 --> 00:03:53,930
هل كنت تقومين بها؟

45
00:03:53,930 --> 00:03:55,830
.خيطان حرير على حيطان جميل

46
00:03:55,830 --> 00:03:58,050
.ليس تمامًا، لكنّ ذلك مقبول

47
00:03:58,450 --> 00:04:00,230
لماذا الخيطان على الحيطان؟

48
00:04:00,230 --> 00:04:02,550
.لا تحاولي تحليل الأمر

49
00:04:02,900 --> 00:04:04,890
ماذا حدث لها؟

50
00:04:04,890 --> 00:04:07,150
لقد تحدّثت بشكل جيّد
...في اجتماع هذا الصّباح

51
00:04:07,150 --> 00:04:09,400
.لأنّه لا يوجد أحد هنا تعتبره عدوًّا لها

52
00:04:09,400 --> 00:04:11,870
،عند وجود شخص تعاديه
...فإنّها تتصرّف هكذا

53
00:04:11,870 --> 00:04:15,390
!"ثمّ يشتغل وضع "سُحقًا لكم

54
00:04:15,390 --> 00:04:16,190
.فهمت

55
00:04:16,650 --> 00:04:19,610
أنتما! تتحدّثان عنّي، صحيح؟

56
00:04:22,530 --> 00:04:25,090
سوف نركب على متنها بالفعل، صحيح؟

57
00:04:25,560 --> 00:04:26,570
.نعم

58
00:04:29,400 --> 00:04:30,830
هل أنهيتنّ حزم حقائبكنّ؟

59
00:04:30,830 --> 00:04:33,560
ليس بعد. يجب التّفكير مليًّا في ذلك، صحيح؟

60
00:04:33,560 --> 00:04:34,590
فعلاً؟

61
00:04:34,590 --> 00:04:38,780
يُسمح لنا بأخذ 100 كيلوغرام بالكامل
.بما فيها وزن أجسادنا

62
00:04:38,780 --> 00:04:40,490
.سيكون ذلك أكثر من كافٍ

63
00:04:40,490 --> 00:04:43,210
لكنّنا سنبقى لثلاثة أشهر، صحيح؟

64
00:04:43,210 --> 00:04:45,410
!نعم، نعم! أي ما يقارب تغيير ملابسنا 90 مرّة

65
00:04:45,410 --> 00:04:46,550
.قومي بغسل ملابسك من حين لآخر

66
00:04:46,550 --> 00:04:47,760
!صحيح

67
00:04:48,140 --> 00:04:52,940
رغم أنّها رحلة، فسوف نعيش حياتنا
.بشكل طبيعيّ بمجرّد أن نصل

68
00:04:52,940 --> 00:04:56,150
،وسيكون هنالك الكثير من العمل لنقوم به
...لذلك يقال أنّ الوقت سيمرّ بسرعة

69
00:04:56,150 --> 00:04:59,650
لكن عندما نفكّر بالأمر ونبدأ بحزم
،أغراضنا في صناديق

70
00:04:59,650 --> 00:05:01,650
...فستكون كثيرة في النّهاية

71
00:05:01,650 --> 00:05:03,280
هل هي كثيرة لذلك الحدّ؟

72
00:05:03,280 --> 00:05:06,180
اسمعي، ألم تبدئي حتّى؟

73
00:05:06,760 --> 00:05:10,540
لكن علينا أخذ أقلّ من 100 كيلوغرام
فحسب بما فيها وزن أجسادنا، صحيح؟

74
00:05:10,540 --> 00:05:13,660
...بالنّسبة لي، فذلك هو 50، 52، 53

75
00:05:14,590 --> 00:05:17,400
!أستطيع أخذ ما يقارب 58 كيلوغرامًا من الأمتعة

76
00:05:17,400 --> 00:05:18,920
!هذا سهل، لا مشكلة

77
00:05:18,920 --> 00:05:20,920
.الاستخفاف بوزنك جريمة خطيرة

78
00:05:20,920 --> 00:05:24,370
‏58 كيلوغرامًا؟
هذا يعني أنّ وزنك 42 كيلوغرامًا؟

79
00:05:24,370 --> 00:05:26,550
...اتركي شحوم ذراعي وشأنها

80
00:05:32,060 --> 00:05:35,680
...قد يكون هذا أصعب ممّا ظننت

81
00:05:39,980 --> 00:05:44,040
ماري-تشان، كم مرّة عليّ أن أخبرك
أن تحملي غسيلك بنفسك؟

82
00:05:46,760 --> 00:05:48,070
...ماري-تشان

83
00:05:52,000 --> 00:05:53,290
ما كلّ هذا؟

84
00:05:53,900 --> 00:05:56,410
.لا أعتقد أنّك ستحتاجين معدّات طبخ

85
00:05:56,720 --> 00:06:00,820
!فعلاً؟ إنّها مغطّاة بطبقة ماسيّة
!لا شيء يلتصق بها

86
00:06:01,850 --> 00:06:04,500
وهذا؟

87
00:06:02,600 --> 00:06:03,920
!إنّه طوق نجاة

88
00:06:04,500 --> 00:06:05,420
!قاموس إنجليزيّ يابانيّ

89
00:06:05,900 --> 00:06:06,860
.قاموس يابانيّ إنجليزيّ

90
00:06:06,860 --> 00:06:08,110
.المحادثة بالإنجليزي في السّفر

91
00:06:08,110 --> 00:06:08,690
.مقشرة

92
00:06:08,690 --> 00:06:10,080
.المحادثة بالصّيني في السّفر

93
00:06:10,080 --> 00:06:12,180
.دليل السّفر العالميّ الموثوق

94
00:06:12,470 --> 00:06:14,060
!لقد اشتريتها خصّيصًا لهذه الرّحلة

95
00:06:14,330 --> 00:06:17,290
ستكونين برفقة العديد من النّاس
!الّذين يتحدّثون اللّغات الأجنبيّة

96
00:06:17,290 --> 00:06:18,810
...أعلم، ومع ذلك

97
00:06:19,930 --> 00:06:21,560
.أعتقد أنّ هذا سيفي بالغرض

98
00:06:21,560 --> 00:06:22,580
!هذا قليل

99
00:06:22,580 --> 00:06:24,960
.عليك أن تأخذي رأي شيراسي-سان أيضًا

100
00:06:24,960 --> 00:06:27,600
قد يكون هنالك بعض الأشياء المعيّنة
.الّتي ستحتاجينها

101
00:06:28,330 --> 00:06:30,930
لكن هل تظنّين بالفعل أنّ هذا سيكفي؟

102
00:06:31,820 --> 00:06:33,320
.سوف أغيب لثلاثة أشهر

103
00:06:33,320 --> 00:06:36,470
يا أختي... هل أنت واثقة أنّك أهلٌ لهذا؟

104
00:06:36,470 --> 00:06:37,700
...لكن

105
00:06:37,700 --> 00:06:41,790
...لا شيء في ذلك الكتيّب يخبرنا عمّا نحضر

106
00:06:41,790 --> 00:06:44,090
.هذا لأنّه تصرّفُ راشدين

107
00:06:44,090 --> 00:06:45,710
.عليك أن تكوني مسؤولة

108
00:06:45,710 --> 00:06:47,940
أقلتِ مسؤولة؟

109
00:06:47,940 --> 00:06:50,110
كون المرء راشدًا صعب، صحيح؟

110
00:06:54,620 --> 00:06:55,690
!هذا الشّيء

111
00:06:59,300 --> 00:07:00,640
ماذا هنالك؟

112
00:07:00,900 --> 00:07:02,420
...في الحقيقة

113
00:07:02,900 --> 00:07:03,900
!مفاجأة

114
00:07:04,640 --> 00:07:05,420
ما هذا؟

115
00:07:05,420 --> 00:07:09,720
انظري! إنّها لعبتك! اللّعبة الّتي
!اعتقدتُ أنّي أضعتُها

116
00:07:09,720 --> 00:07:12,700
.أجل، لقد نسيتُ أمرها بالكامل

117
00:07:13,870 --> 00:07:15,800
.ليس عليك أن تجرّبيها بالفعل

118
00:07:15,800 --> 00:07:18,410
!لكنّي لم أرها منذ مدّة طويلة

119
00:07:18,410 --> 00:07:21,310
.مرّت ثلاث سنوات، قد لا تعمل

120
00:07:26,170 --> 00:07:28,260
!مذهل، هذا يعيد الذّكريات

121
00:07:32,470 --> 00:07:34,760
لقد أحببتِ هذا الشّيء بالفعل، صحيح؟

122
00:07:34,760 --> 00:07:35,600
!نعم

123
00:07:36,000 --> 00:07:39,600
فقبل كلّ شيء، إنّها اللّعبة الوحيدة
.الّتي هزمتك فيها

124
00:07:40,050 --> 00:07:40,980
فعلاً؟

125
00:07:41,310 --> 00:07:43,360
،لم تستطيعي هزيمتي على الإطلاق

126
00:07:43,360 --> 00:07:46,450
.لذلك قلتِ أنّ بإمكاني استعارتها قدر ما أشاء

127
00:07:46,450 --> 00:07:47,430
...وحينها

128
00:07:47,430 --> 00:07:48,320
أضعتِها؟

129
00:07:49,540 --> 00:07:51,320
...في النّهاية، نعم

130
00:07:51,320 --> 00:07:53,610
!لكنّي أنهيت اللّعبة قبل ذلك

131
00:07:58,430 --> 00:08:00,190
!لقد فزت

132
00:08:02,680 --> 00:08:04,140
حسنًا، كيف سارت الأمور في طوكيو؟

133
00:08:04,140 --> 00:08:06,710
.جيّدة، في أغلب الأحيان

134
00:08:06,710 --> 00:08:09,190
"هل استطاعت "القطب الجنوبيّ
إنهاء تقريرها؟

135
00:08:09,190 --> 00:08:11,840
القطب الجنوبيّ"؟ تقصدين شيراسي-تشان؟"

136
00:08:11,840 --> 00:08:14,300
ليس على شيراسي-تشان أن تقدّم
.تقارير إلاّ بعد مدّة

137
00:08:14,580 --> 00:08:16,300
إنّها غريبة، صحيح؟

138
00:08:16,710 --> 00:08:17,820
!بالفعل

139
00:08:17,820 --> 00:08:21,730
.إنّها تنتقل بين الثّقة الزّائدة والخجل الزّائد

140
00:08:21,730 --> 00:08:23,500
...كنتُ أتحدّث مع هيناتا-تشان بشأن ذلك

141
00:08:23,500 --> 00:08:25,390
أهذه الفتاة الّتي تعلمان معًا؟

142
00:08:25,390 --> 00:08:26,190
.نعم

143
00:08:26,190 --> 00:08:29,850
لكنّ يوزوكي-تشان قامت بالتّقرير
...بشكل مثاليّ

144
00:08:29,850 --> 00:08:31,450
هل تلك هي الفتاة من هوكّايدو؟

145
00:08:31,450 --> 00:08:32,070
.نعم

146
00:08:33,830 --> 00:08:35,920
.حسنًا، لا تضغطي على نفسك كثيرًا

147
00:08:35,920 --> 00:08:38,580
.إن فشلتِ، فستندمين أكثر

148
00:08:39,980 --> 00:08:40,830
!أجل

149
00:08:43,690 --> 00:08:45,290
...معك حقّ

150
00:08:59,640 --> 00:09:00,510
.صحيح

151
00:09:01,160 --> 00:09:02,200
.آسفة

152
00:09:03,520 --> 00:09:05,010
!لقد عدت

153
00:09:11,800 --> 00:09:15,400
...تحدّي القطب الجنوبيّ

154
00:09:51,710 --> 00:09:52,660
!حسنًا

155
00:10:04,540 --> 00:10:05,750
!إلى اللّقاء

156
00:10:06,280 --> 00:10:08,350
أحضري لي جبلاً جليديًّا، موافقة؟

157
00:10:08,350 --> 00:10:09,860
...لستُ واثقة أنّه سيتّسع في

158
00:10:09,860 --> 00:10:11,820
.سأرسل لك صورًا لأشياء دافئة

159
00:10:11,820 --> 00:10:13,130
.شكرًا لك

160
00:10:13,130 --> 00:10:14,690
هل يتجمّد مخاطك في القطب الجنوبيّ؟

161
00:10:14,690 --> 00:10:16,380
.أريد بعض الثلج المبشور

162
00:10:16,380 --> 00:10:18,750
هل صحيح أنّ هنالك أطباقًا طائرة
مدفونة في الجليد هناك؟

163
00:10:25,060 --> 00:10:27,970
يبدو وكأنّني سأنتقل لمدرسة
أخرى أو ما شابه، صحيح؟

164
00:10:32,210 --> 00:10:34,020
!مع السّلامة يا مخفوق البودينغ

165
00:10:34,020 --> 00:10:36,060
...لن أراك لوقت طويل

166
00:10:36,060 --> 00:10:37,650
أيّ نوع من الاحتفال توقّعتِ؟

167
00:10:38,010 --> 00:10:41,880
لم أتوقّع أن يتفاعلوا مع الأمر
!بشكل كبير هكذا فحسب

168
00:10:41,880 --> 00:10:44,470
عندما قالت شيراسي-تشان
،أنّها ذاهبة للقطب الجنوبيّ

169
00:10:44,470 --> 00:10:45,660
.سخر منها الجميع فحسب

170
00:10:46,260 --> 00:10:48,760
.ذلك لأنّهم لم يعتقدوا أنّها ستذهب

171
00:10:49,230 --> 00:10:52,110
.إضافة إلى أنّه ما زال هنالك من يسخر منها

172
00:10:52,110 --> 00:10:53,420
!ذلك صحيح

173
00:10:56,600 --> 00:10:59,760
لن أكون قادرة على المجيء
.إلى هنا لثلاثة أشهر أيضًا

174
00:11:00,720 --> 00:11:01,510
تشعرين بالوحدة؟

175
00:11:01,980 --> 00:11:02,970
...كلاّ

176
00:11:02,970 --> 00:11:05,890
...لم أكن واثقة كيف سأشعر

177
00:11:09,590 --> 00:11:13,580
.ربّما من الأفضل ألاّ تتباهين بالأمر كثيرًا

178
00:11:13,580 --> 00:11:17,030
هنالك الكثير من النّاس يعتقدون
.أنّك تغترّين بنفسك

179
00:11:17,030 --> 00:11:20,050
.أنا لا أتباهى بأيّ شيء. سوف أغادر غدًا

180
00:11:20,050 --> 00:11:22,350
...ذلك صحيح

181
00:11:22,720 --> 00:11:25,080
.لكن هنالك أمور فظيعة كثيرة تُقال عنك

182
00:11:25,580 --> 00:11:26,580
فعلاً؟

183
00:11:26,950 --> 00:11:28,930
.أظنّ أنّها بسبب الغيرة

184
00:11:28,930 --> 00:11:33,050
أشياء مثل السّرقة من متاجر
.بقالة لتجمعي المال

185
00:11:33,050 --> 00:11:36,090
وأنّك تعبثين مع الفتيان في
.كابوكيتشو وما إلى ذلك

186
00:11:36,730 --> 00:11:37,590
ماذا تقولين؟

187
00:11:38,860 --> 00:11:42,090
لذلك أخبرك أنّ النّاس يعتقدون
.أنّك مغترّة بنفسك

188
00:11:42,090 --> 00:11:43,770
!لكنّني لست كذلك

189
00:11:43,770 --> 00:11:44,860
...على أيّ حال

190
00:11:44,860 --> 00:11:45,830
ماذا؟

191
00:11:46,420 --> 00:11:49,370
هل أنت واثقة أنّ عليك الذّهاب
دون حلّ هذا الأمر؟

192
00:11:49,370 --> 00:11:52,100
...بمجرّد أن تعودي، سيزداد الأمر سوءًا لا غير

193
00:11:55,990 --> 00:11:57,110
.كيماري

194
00:11:57,560 --> 00:11:59,610
هل هذه هي صديقتك ميغو-تشان؟

195
00:11:59,890 --> 00:12:00,770
!نعم

196
00:12:00,770 --> 00:12:03,580
...صحيح، هذه أوّل مرّة تلتقيان فيها

197
00:12:04,730 --> 00:12:07,070
،أنا زميلة كيماري في العمل
!واسمي مياكي هيناتا

198
00:12:07,070 --> 00:12:07,840
.مرحبًا

199
00:12:07,840 --> 00:12:08,780
.مرحبًا بك

200
00:12:08,780 --> 00:12:09,920
.من الأفضل أن أغادر

201
00:12:09,920 --> 00:12:10,860
!انتظري

202
00:12:10,860 --> 00:12:11,370
ماذا؟

203
00:12:12,050 --> 00:12:13,500
...ما قلتِه سابقًا

204
00:12:14,830 --> 00:12:16,750
!من يقول ذلك؟

205
00:12:16,960 --> 00:12:19,080
...لا أدري، سمعتُه فحسب

206
00:12:19,080 --> 00:12:20,610
!سأبحث عن الجاني

207
00:12:20,610 --> 00:12:21,460
...شيراسي-تشان

208
00:12:21,460 --> 00:12:22,880
.تذكّري، سوف نغادر غدًا

209
00:12:23,090 --> 00:12:26,640
لا أستطيع الجلوس بينما هنالك
!من ينشر هذه الإشاعات السّخيفة

210
00:12:27,090 --> 00:12:30,370
.لن يفيد افتعال قتال الآن أيّ أحد

211
00:12:30,370 --> 00:12:33,430
لقد تجاهلتِ كلّ الإشاعات القذرة
حتّى الآن، صحيح؟

212
00:12:33,430 --> 00:12:34,440
.انسي الأمر فحسب

213
00:12:34,640 --> 00:12:36,070
!الأمر مختلف تمامًا

214
00:12:36,070 --> 00:12:37,470
!هذا كذب وقح وشنيع

215
00:12:37,470 --> 00:12:39,690
لا أصدّق أنّهم يقولون إنّنا نعبث
...مع الفتيان في شينجوكو

216
00:12:39,690 --> 00:12:41,540
.لكنّنا ذهبنا إلى شينجوكو بالفعل

217
00:12:41,540 --> 00:12:42,700
!لكنّنا لم نكن نعبث

218
00:12:42,700 --> 00:12:44,660
لكن أيمكنك إثبات ذلك؟

219
00:12:46,890 --> 00:12:48,660
!ومع ذلك، الأمر خاطئ

220
00:12:49,420 --> 00:12:51,180
ما رأيك يا ميغو-تشان؟

221
00:12:51,180 --> 00:12:52,290
رأيي؟

222
00:12:52,660 --> 00:12:54,880
.أحيانًا، يتصرّف النّاس بلؤم وحسب

223
00:12:54,880 --> 00:12:57,000
.لا يجب مواجهة اللّؤم بالمثل

224
00:12:58,130 --> 00:12:59,010
أهي واحدة من مقولاتك؟

225
00:12:59,010 --> 00:13:00,500
!بالطّبع

226
00:13:00,500 --> 00:13:03,310
.إضافة إلى أنّكما لستما وحدكما الآن

227
00:13:03,310 --> 00:13:04,430
ماذا تعنين؟

228
00:13:04,770 --> 00:13:07,140
!لديكما أشخاص للتّنفيس عن إحباطكما معهم

229
00:13:07,610 --> 00:13:09,140
!بصحّتكنّ

230
00:13:13,140 --> 00:13:15,910
!كم احتجتُ لذلك

231
00:13:16,360 --> 00:13:17,470
!فهمت

232
00:13:17,470 --> 00:13:20,850
لا بدّ أنّ هذا هو شعور احتساء شراب
.في طريق العودة من العمل

233
00:13:20,850 --> 00:13:22,660
.أفترض ذلك

234
00:13:22,660 --> 00:13:24,520
!حسنًا، لنحتسِ واحدًا آخر

235
00:13:24,520 --> 00:13:26,530
،إنّه يوم قبض الرّاتب
.لذلك سيقوم العجوز بالدّفع

236
00:13:27,850 --> 00:13:29,800
.ومع ذلك، هذا يثير السّخط كثيرًا

237
00:13:29,800 --> 00:13:31,650
أنت لا تنسين بسهولة، صحيح؟

238
00:13:31,650 --> 00:13:35,620
ولكنّ النّاس الّذين ينشرون الإشاعات
.هم من على خطأ

239
00:13:35,620 --> 00:13:37,210
لماذا عليّ الخضوع لهم؟

240
00:13:37,550 --> 00:13:38,810
.فهمت، فهمت

241
00:13:38,810 --> 00:13:39,780
.اهدئي

242
00:13:41,500 --> 00:13:43,960
!أريد الصّراخ بأعلى صوتي فحسب

243
00:13:44,280 --> 00:13:45,090
!اصرخي إذًا

244
00:13:45,720 --> 00:13:48,630
...أمام معبد؟ ليست فكرة جيّدة

245
00:13:48,630 --> 00:13:50,770
!لنذهب لمحلّ كاراوكي إذًا

246
00:13:50,770 --> 00:13:52,640
.سيكون بمقدورنا ذلك إن ذهبنا خلال ساعة

247
00:13:52,640 --> 00:13:53,970
.لم أذهب لمحلّ كاراوكي من قبل

248
00:13:53,970 --> 00:13:54,530
!مستحيل

249
00:13:54,530 --> 00:13:55,570
!لنذهب إذًا

250
00:13:55,570 --> 00:13:56,700
!كلاّ، مستحيل

251
00:13:56,700 --> 00:13:58,810
كيف لكنّ جميعًا أن تفعلن
شيئًا محرجًا هكذا؟

252
00:13:59,010 --> 00:14:01,060
.لا مشكلة في التّرويح عن أنفسنا

253
00:14:01,060 --> 00:14:02,710
!ستكون حفلة رحيلنا

254
00:14:02,710 --> 00:14:03,580
صحيح؟

255
00:14:04,100 --> 00:14:05,150
...أفترض ذلك

256
00:14:05,150 --> 00:14:06,630
!أنت مدعوّة أيضًا يا ميغو-تشان

257
00:14:06,950 --> 00:14:07,470
...لكن

258
00:14:07,470 --> 00:14:08,570
.قلتُ إنّك مدعوّة

259
00:14:13,030 --> 00:14:14,380
!كوبوتشيزاوا شيراسي

260
00:14:14,380 --> 00:14:15,130
.كلاّ

261
00:14:15,580 --> 00:14:16,940
!شاركينا

262
00:14:16,940 --> 00:14:19,300
!حسنًا... تاكاهاشي ميغو-تشان

263
00:14:20,010 --> 00:14:22,460
!صديقتي ميغو-تشان

264
00:14:33,400 --> 00:14:39,980
!كوبوتشيزاوا شيراسي

265
00:14:51,210 --> 00:14:53,190
.أنا سعيدة للغاية لأنّني لم أكن معهنّ

266
00:14:55,430 --> 00:14:57,120
!كان هذا منعشًا

267
00:14:57,120 --> 00:14:58,000
فعلاً؟

268
00:14:58,000 --> 00:15:00,430
!نعم، كانت أفضل ليلة

269
00:15:00,430 --> 00:15:03,270
لم أتوقّع أبدًا أنّه سيتسنّى لي فعل
.هذا في اللّيلة الّتي تسبق رحيلي

270
00:15:03,720 --> 00:15:08,920
أعني أنّني لم أستطع قضاء الكثير من الوقت
.معك مذ قرّرتُ الذّهاب للقطب الجنوبيّ

271
00:15:08,920 --> 00:15:11,290
...رغم أنّني أعتقد أنّ ذلك كان راحة لك

272
00:15:11,290 --> 00:15:13,010
...ما كنتُ لأقول ذلك

273
00:15:13,010 --> 00:15:16,020
.حسنًا، ربّما كان كذلك

274
00:15:16,360 --> 00:15:17,520
فعلاً؟

275
00:15:17,520 --> 00:15:20,020
.لكن لم يكن الأمر كذلك بالنّسبة لي

276
00:15:21,270 --> 00:15:23,710
...كنتُ أفكّر طوال هذا الوقت

277
00:15:23,710 --> 00:15:25,230
،أفكّر بشأن رغبتي في الابتعاد

278
00:15:25,230 --> 00:15:26,870
،وبشأن كرهي لحيث أنا الآن

279
00:15:26,870 --> 00:15:28,280
.وكم أكره نفسي

280
00:15:28,680 --> 00:15:31,530
.لم أعلم أبدًا لماذا شعرتُ هكذا

281
00:15:31,990 --> 00:15:33,930
.ربّما كان ذلك بسببك يا ميغو-تشان

282
00:15:35,070 --> 00:15:39,620
أنا متردّدة دائمًا وأحتاجك
.لكي تهتمّي بأموري

283
00:15:40,540 --> 00:15:43,130
أنا متشبّثة بك دائمًا وأسألك
...عمّا يجب فعله

284
00:15:44,290 --> 00:15:45,500
فعلاً؟

285
00:15:45,500 --> 00:15:48,250
.نعم، ولطالما كرهتُ هذا

286
00:15:48,250 --> 00:15:50,430
.أعتقد أنّني أردتُ تغيير ذلك

287
00:15:50,430 --> 00:15:54,300
وهذا لكي لا أتشبّث بك
.ولكي تكون لي قيمة

288
00:15:54,300 --> 00:15:56,500
أردتُ أن أكون شخصًا يمكنك
.الاستمتاع بألعاب الفيديو معه

289
00:15:59,940 --> 00:16:01,390
.لذلك سأبذل جهدي هناك

290
00:16:07,780 --> 00:16:09,520
.حسنًا، إلى اللّقاء

291
00:16:10,790 --> 00:16:12,150
!لقد عدت

292
00:16:16,080 --> 00:16:18,450
!مذهل، ما كلّ هذا؟ هذا رائع

293
00:16:18,720 --> 00:16:19,830
!لقد تأخّرتِ

294
00:16:19,830 --> 00:16:20,950
.إنّه عشاء خاصّ

295
00:16:22,020 --> 00:16:22,580
!أجل

296
00:16:22,810 --> 00:16:24,330
!وهنالك المزيد

297
00:16:24,730 --> 00:16:27,340
!أجل! جنّة البيض

298
00:16:44,100 --> 00:16:46,230
...لا

299
00:17:04,490 --> 00:17:05,330
!حسنًا

300
00:17:07,160 --> 00:17:08,040
.إلى اللّقاء

301
00:17:10,800 --> 00:17:15,870
.إلى اللّقاء. إلى اللّقاء. إلى اللّقاء. إلى اللّقاء

302
00:17:19,090 --> 00:17:20,360
.إلى اللّقاء

303
00:17:22,190 --> 00:17:22,810
ستغادرين؟

304
00:17:23,070 --> 00:17:24,040
.نعم

305
00:17:24,040 --> 00:17:26,180
احرصي على تناول فطورك في طوكيو، مفهوم؟

306
00:17:26,180 --> 00:17:26,820
.نعم

307
00:17:28,260 --> 00:17:29,460
!أختي

308
00:17:31,700 --> 00:17:32,360
...رين

309
00:17:32,360 --> 00:17:34,230
لماذا لم توقظيني؟

310
00:17:34,230 --> 00:17:36,450
...حسنًا، ما زال الوقت باكرًا

311
00:17:36,900 --> 00:17:37,950
!أنا قلقة

312
00:17:42,410 --> 00:17:45,160
.لا تقلقي. سأبقي نفسي آمنة

313
00:17:57,480 --> 00:17:58,740
!إلى اللّقاء

314
00:18:06,110 --> 00:18:07,730
ميغو-تشان؟

315
00:18:07,730 --> 00:18:09,930
.آسفة لإزعاجك صباحًا قبل ذهابك

316
00:18:09,930 --> 00:18:11,390
ماذا هنالك؟

317
00:18:11,390 --> 00:18:12,730
.أتيت لأنفصل عنك

318
00:18:14,990 --> 00:18:16,990
.ما أقوله هو أنّنا لم نعد صديقتين

319
00:18:21,290 --> 00:18:23,390
ماذا؟ ماذا تقصدين؟

320
00:18:23,390 --> 00:18:26,180
ما زلتِ لم تدركي الأمر؟

321
00:18:27,470 --> 00:18:32,300
من أين أتت الإشاعات حول ذهابك
و"القطب الجنوبيّ" إلى شينجوكو؟

322
00:18:32,300 --> 00:18:34,000
هل أخبرتِ أيّ أحد بذلك؟

323
00:18:35,270 --> 00:18:36,210
...كلاّ

324
00:18:36,610 --> 00:18:38,980
،"في أوّل مرّة قابلتِ فيها "القطب الجنوبيّ

325
00:18:38,980 --> 00:18:42,420
كيف عرفت الفتيات الأكبر
أنّها تملك مليون ينّ؟

326
00:18:42,420 --> 00:18:46,720
كيف عرفت أمّك أنّك ذاهبة للقطب
الجنوبيّ قبل أن تخبريها أنت؟

327
00:18:47,540 --> 00:18:48,600
كيف؟

328
00:18:49,270 --> 00:18:50,770
!لأنّني أخبرتهنّ بالطّبع

329
00:18:52,470 --> 00:18:58,690
ظننتُ أنّك ستدركين الأمر
...أخيرًا وتغضبين منّي

330
00:18:58,690 --> 00:19:00,070
...في النّهاية

331
00:19:00,070 --> 00:19:00,990
لِمَ؟

332
00:19:00,990 --> 00:19:06,030
لكن أنت و"القطب الجنوبيّ" والأخريات
!أغبياء للغاية لعدم إدراككنّ

333
00:19:06,030 --> 00:19:06,950
!لِمَ؟

334
00:19:06,950 --> 00:19:07,960
!لا أدري

335
00:19:10,370 --> 00:19:16,390
لا أدري لماذا غضبتُ كثيرًا عندما أخبرتني
!أوّل مرّة أنّك ذاهبة للقطب الجنوبيّ

336
00:19:17,070 --> 00:19:22,230
كنتِ تستشيرينني دائمًا قبل
...قيامك بأيّ شيء

337
00:19:22,840 --> 00:19:24,720
...كلاّ... مهلاً

338
00:19:25,320 --> 00:19:27,490
.أعرف أنّني قسوت عليك كثيرًا

339
00:19:27,490 --> 00:19:28,230
.أنا أعتذر

340
00:19:28,580 --> 00:19:29,630
.أنا آسفة

341
00:19:31,230 --> 00:19:35,190
،البارحة، عندما كنتِ تتحدّثين
.أدركتُ الأمر أخيرًا

342
00:19:35,610 --> 00:19:39,990
،لم تكوني من تتشبّثين بي
.بل أنا من كنت أتشبّث بك

343
00:19:40,640 --> 00:19:44,920
...إنّ اعتمادك عليّ واستشارتي
،وسخطي عليك

344
00:19:44,920 --> 00:19:48,540
وتظاهري بأنّني المسؤولة عنك
...والتّصرّف بذكاء حولك

345
00:19:50,620 --> 00:19:55,500
،لأنّني إن لم أمتلك ذلك
.فلن يكون لديّ أيّ شيء

346
00:19:57,160 --> 00:20:02,240
ولأنّي لم أكن أيّ شيء، لم أرد
.أن يكون لك أيّ شيء

347
00:20:03,330 --> 00:20:05,310
.لستِ من بلا قيمة

348
00:20:05,880 --> 00:20:07,140
!بل أنا

349
00:20:09,120 --> 00:20:13,560
!أنا من تحتاج للذّهاب لمكان ما بعيدًا عن هنا

350
00:20:27,310 --> 00:20:28,300
.وداعًا

351
00:20:32,270 --> 00:20:33,330
!ميغو-تشان

352
00:20:35,930 --> 00:20:38,560
.تعالي معي

353
00:20:40,110 --> 00:20:41,090
أين؟

354
00:20:42,840 --> 00:20:44,340
!للقطب الجنوبيّ

355
00:20:48,890 --> 00:20:50,290
.لا تكوني سخيفة

356
00:20:50,810 --> 00:20:53,260
أنا أخطو أخيرًا أولى خطواتي

357
00:20:54,850 --> 00:20:56,660
.إلى عالم من دونك

358
00:21:02,900 --> 00:21:04,860
.نحن نخطو خطوتنا الأولى

359
00:21:06,810 --> 00:21:11,060
إلى عالم من دون الأشياء الّتي
.نعتمد عليها في العادة

360
00:21:12,720 --> 00:21:14,870
إلى عالم حيث لا ندري ما
.قد يلوح في الأفق

361
00:21:15,400 --> 00:21:18,380
.حيث لا ندري حتّى أين الطّريق للمنزل

362
00:21:19,550 --> 00:21:25,880
إلى عالم حيث لا نعرف أين سنكون غدًا
.ولا حتّى تخيّل أين سنتّجه اليوم التّالي

363
00:21:26,470 --> 00:21:28,100
.ومع ذلك سنخطو تلك الخطوة

364
00:21:30,670 --> 00:21:32,350
.رُفض الانفصال

365
00:21:35,570 --> 00:21:37,660
.تتجمّع المياه في بركات راكدة

366
00:21:38,170 --> 00:21:41,140
.لطالما أحببت مشاهدتها تتسرّب دفعة واحدة

367
00:21:41,780 --> 00:21:45,990
.حرّة وطليقة ومندفعة

368
00:21:47,100 --> 00:21:50,350
.الطّاقة المتجمّعة خلال ركودها تتدفّق للأمام

369
00:21:50,850 --> 00:21:53,500
!كلّ شيء بدأ بالحركة

370
00:21:59,060 --> 00:22:03,010
!كلّ شيء بدأ بالحركة