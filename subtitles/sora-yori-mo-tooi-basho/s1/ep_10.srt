1
00:00:10,990 --> 00:00:12,520
القطب الجنوبيّ؟

2
00:00:12,520 --> 00:00:13,990
...القطب الجنوبيّ بالفعل

3
00:00:13,990 --> 00:00:15,990
!إنّه القطب الجنوبيّ بالفعل

4
00:00:16,350 --> 00:00:17,360
...نعم

5
00:00:20,700 --> 00:00:22,000
!يا فتيات الثّانويّة

6
00:00:22,730 --> 00:00:23,750
نعم؟

7
00:00:24,600 --> 00:00:26,750
.تحت المائة كيلوغرام. أنت جاهزة

8
00:00:27,880 --> 00:00:31,130
،أكلت الكثير بينما قلّلت من الحلويّات
!لكنّ الوزن لم يتغيّر

9
00:00:31,130 --> 00:00:33,650
.عليك أن تفكّري بشأن ذلك يا عزيزتي

10
00:00:35,090 --> 00:00:36,890
أتلك بالفعل ما سنستقلّ إلى هناك؟

11
00:00:37,570 --> 00:00:39,890
لا يمكننا ركوب مركبات الثّلج على ما أظنّ؟

12
00:00:40,280 --> 00:00:42,490
.يوزوكي-تشان، تبدين كأنّك ستموتين الآن

13
00:00:42,490 --> 00:00:43,770
.أودّ أن أموت بالفعل

14
00:00:48,170 --> 00:00:49,140
!انظري

15
00:00:56,590 --> 00:00:59,820
إنّها سفينة كبيرة بالفعل، صحيح؟

16
00:01:07,240 --> 00:01:07,820
صحيح؟

17
00:01:08,360 --> 00:01:09,160
.نعم

18
00:01:09,160 --> 00:01:10,460
.انظري على الأقلّ

19
00:02:42,010 --> 00:02:47,520
جنّيّ_الجرّة #سأقتلك_إن_لمستني #قراءة_رسائل#

20
00:03:16,940 --> 00:03:19,370
!اسمعن، استلقين أرضًا

21
00:03:19,370 --> 00:03:20,170
!حسنًا

22
00:03:20,410 --> 00:03:23,270
!هذا بارد جدًّا

23
00:03:23,270 --> 00:03:23,930
أو لا؟

24
00:03:24,210 --> 00:03:26,120
،شهر ديسمبر هو صيف هنا

25
00:03:26,120 --> 00:03:29,630
لذلك قد لا تنزل درجة الحرارة حتّى
.تحت التّجمّد في الأيّام الدّافئة نهارًا

26
00:03:29,630 --> 00:03:31,230
فعلاً؟

27
00:03:31,230 --> 00:03:32,690
!يدي على ما يرام تمامًا

28
00:03:33,400 --> 00:03:34,440
!هذا بارد

29
00:03:40,990 --> 00:03:45,540
سأقدّم لكنّ جولة سريعة قبل وصول
.الطّاقم وخروج الأمور عن السّيطرة

30
00:03:46,060 --> 00:03:47,960
هذه هي محطّة شوا؟

31
00:03:48,280 --> 00:03:51,760
ذلك الشّيء الّذي يبدو ككومة
.مكعّبات هو مبنى التّحكّم

32
00:03:51,760 --> 00:03:55,130
إن كان منزلاً، فسيكون كغرفة المعيشة
.حيث يقضي الجميع معظم وقته

33
00:03:55,720 --> 00:03:57,130
.ذلك هو مبنى المُوَلّد

34
00:03:57,630 --> 00:04:00,130
.وهذه هي مباني الإسكان والمخازن

35
00:04:00,130 --> 00:04:01,940
.وذلك هو فندق ليكسايد

36
00:04:01,940 --> 00:04:03,340
ليكسايد؟

37
00:04:03,340 --> 00:04:05,640
هذا ما نطلقه على منازل السّكن
.للفريق الصّيفيّ

38
00:04:06,440 --> 00:04:09,780
في العادة، الأعضاء الّذين لن يظلّوا
.خلال الشّتاء يقطنون هنا

39
00:04:09,780 --> 00:04:13,390
وبسبب عدم وجود أيّ إصلاحات
،في المبنى الآخر لثلاث سنوات

40
00:04:13,390 --> 00:04:16,110
...وبما أنّكنّ فتيات

41
00:04:17,000 --> 00:04:18,860
!فستحصلن على غرفكنّ الخاصّة

42
00:04:20,280 --> 00:04:22,320
بإمكاننا استعمال كلّ هذا؟

43
00:04:24,590 --> 00:04:27,750
الهواء جافّ للغاية، لذلك عليكنّ
.الاستعداد للكثير من الكهرباء السّاكنة

44
00:04:34,370 --> 00:04:38,290
وأخيرًا لن يكون علينا أن نقلق بشأن الأمور
.الّتي تتمتم بها كيماري-سان أثناء نومها

45
00:04:38,590 --> 00:04:40,260
هل أتحدّث أثناء نومي كثيرًا بالفعل؟

46
00:04:40,590 --> 00:04:41,850
!نعم، بالتّأكيد

47
00:04:41,850 --> 00:04:43,170
...وتقومين بذلك وعيناك مفتوحتان

48
00:04:43,750 --> 00:04:44,550
.حالة طارئة

49
00:04:45,560 --> 00:04:47,200
ماذا هنالك؟

50
00:04:47,200 --> 00:04:49,760
.لا يريد جنّيّ الجرّة الخروج من المرحاض

51
00:04:50,930 --> 00:04:53,080
.على الأرجح أنّه لا يستطيع عبور بوّابة التّذاكر

52
00:04:55,190 --> 00:04:56,090
.أشياء كهذه

53
00:04:56,090 --> 00:04:57,220
ما هو جنّيّ الجرّة؟

54
00:04:57,220 --> 00:04:58,650
!كيف لي أن أعرف؟

55
00:04:59,570 --> 00:05:01,510
...حسنًا، لننتقل لمبنى التّحكّم

56
00:05:01,510 --> 00:05:05,120
أو تلك كانت خطّتي، لكن أراهن
.أنّ الطّاقم يوشك على الوصول

57
00:05:05,120 --> 00:05:06,590
.لنعد إلى مهبط الحوّامات

58
00:05:06,590 --> 00:05:07,540
!حسنًا

59
00:05:10,520 --> 00:05:13,040
...سأضطرّ لتغيير هذه

60
00:05:16,830 --> 00:05:17,330
.حسنًا

61
00:05:24,320 --> 00:05:26,590
!وقت التّنظيف

62
00:05:33,990 --> 00:05:36,870
حسنًا، لنأخذ استراحة حتّى
!وصول الفوج التّالي

63
00:05:36,870 --> 00:05:37,650
هل أنتنّ بخير؟

64
00:05:37,880 --> 00:05:38,570
.نعم

65
00:05:38,570 --> 00:05:40,430
.عملت بدوام جزئيّ في شركة نقل

66
00:05:40,430 --> 00:05:43,490
حسنًا، ارتحن إذًا لعشر دقائق ثمّ
.ساعدنني في حمل الأغراض هناك

67
00:05:43,880 --> 00:05:45,870
...ماذا؟ وصلتني رسالة

68
00:05:46,120 --> 00:05:48,970
لا بدّ أنّها وصلت عندما كنّا
.في المحطّة سابقًا

69
00:05:48,970 --> 00:05:51,120
يمكننا التقاط إشارات هواتف
.محمولة قرب مبنى التّحكّم

70
00:05:51,290 --> 00:05:54,770
ماذا؟ بإمكاننا استعمال هواتفنا
النّقّالة حتّى في القطب الجنوبيّ؟

71
00:05:57,550 --> 00:05:58,610
!إنّها بطاريق

72
00:05:58,610 --> 00:05:59,920
!أخفضي صوتك

73
00:05:59,920 --> 00:06:01,130
!يوزو! أحضري الكاميرا

74
00:06:01,130 --> 00:06:02,290
!حـ-حسنًا

75
00:06:03,160 --> 00:06:05,990
حافظن على مسافة خمسة أمتار، مفهوم؟

76
00:06:05,990 --> 00:06:07,560
!مفهوم

77
00:06:06,260 --> 00:06:08,720
...بطـ... ريق

78
00:06:09,070 --> 00:06:09,970
!مهلاً

79
00:06:10,250 --> 00:06:12,840
حسنًا، أنا أصوّر! خذي الميكروفون
!وابدئي التّقرير يا يوزو

80
00:06:12,020 --> 00:06:13,310
!هيناتا-تشان، حالة طارئة

81
00:06:13,310 --> 00:06:13,980
ماذا؟

82
00:06:14,750 --> 00:06:15,980
!إنّه قادم نحونا

83
00:06:19,230 --> 00:06:21,480
...إنّها قادم... قادم

84
00:06:22,170 --> 00:06:24,870
!مهلاً، مهلاً، مهلاً
!حافظي على مسافة خمسة أمتار

85
00:06:24,870 --> 00:06:26,020
!مهلاً، مهلاً

86
00:06:25,590 --> 00:06:27,490
!كلاّ

87
00:06:28,020 --> 00:06:29,600
ما مِن لحظة ملل معكنّ، صحيح؟

88
00:06:30,870 --> 00:06:32,300
هل من خطب ما؟

89
00:06:32,300 --> 00:06:33,500
...كلاّ

90
00:07:00,280 --> 00:07:02,860
هل مسموح لنا وضع ثلج متّسخ هناك؟

91
00:07:03,140 --> 00:07:05,830
.قالوا أنّهم سيصفّونه، لذلك لا بأس

92
00:07:05,830 --> 00:07:07,650
.لا تخلعيها. سوف تصابين بحروق شمس

93
00:07:07,650 --> 00:07:09,910
!لكنّ التّنفّس صعب

94
00:07:10,910 --> 00:07:15,120
لكنّنا نقوم بعمل تلو الآخر، صحيح؟

95
00:07:15,120 --> 00:07:19,420
،لم يزر أحد هذا المكان لحوالي ثلاث سنوات
.لذلك على الأرجح أنّنا سنكون مشغولين لمدّة

96
00:07:19,420 --> 00:07:20,470
...فهمت

97
00:07:20,470 --> 00:07:21,090
لا تحبّين هذا؟

98
00:07:21,580 --> 00:07:25,220
!الانشغال هو أفضل طريقة لتمضية الوقت

99
00:07:25,220 --> 00:07:27,440
مقولة مبتكرة أخرى؟

100
00:07:27,440 --> 00:07:30,060
فكّرت فيها عندما كنت أعمل
.في متجر البقالة

101
00:07:30,060 --> 00:07:33,220
.أعتقد أنّني أُفضّل الانشغال

102
00:07:36,840 --> 00:07:37,810
!أنا متعبة

103
00:07:37,810 --> 00:07:38,920
.وأنا أيضًا

104
00:07:39,420 --> 00:07:42,730
.أعتقد أنّني أحبّ البقاء منشغلة أيضًا

105
00:07:42,730 --> 00:07:43,770
ماذا؟

106
00:07:44,110 --> 00:07:47,900
حسنًا... كنّا نسافر معًا لوقت طويل، صحيح؟

107
00:07:47,900 --> 00:07:48,990
!نعم! هذا صحيح

108
00:07:49,250 --> 00:07:53,120
تحدّثنا عن أمور كثيرة واستمتعنا معًا، صحيح؟

109
00:07:53,340 --> 00:07:55,620
ما بالك فجأة؟

110
00:07:56,060 --> 00:07:56,910
مسلسل دراميّ؟

111
00:07:57,220 --> 00:07:59,910
.قمت بتجربة أداء قبل مجيئنا

112
00:07:59,910 --> 00:08:02,350
.إنّه مسلسل دراميّ صباحيّ
.سألعب دور صديقة البطلة المفضّلة

113
00:08:02,350 --> 00:08:03,670
مستحيل! وحصلتِ على الدّور؟

114
00:08:05,470 --> 00:08:06,340
!هذا رائع

115
00:08:06,540 --> 00:08:08,170
!إنّه أمر مدهش

116
00:08:08,170 --> 00:08:11,680
لكن لن يكون لي وقت كافٍ
.بمجرّد أن يبدأ تصوير المسلسل

117
00:08:11,680 --> 00:08:14,220
لن نكون قادرات على قضاء
!الوقت معًا هكذا بعد الآن

118
00:08:14,430 --> 00:08:15,920
لا تحبّين ذلك؟

119
00:08:15,920 --> 00:08:19,720
،حسنًا، حتّى بدون المسلسل
.ستعود كلّ واحدة منّا لحياتها الخاصّة

120
00:08:20,030 --> 00:08:21,280
...لـ-لكن

121
00:08:21,280 --> 00:08:24,070
.لا بأس. نحن أفضل صديقات سلفًا

122
00:08:27,200 --> 00:08:28,840
أفضل صديقات؟

123
00:08:28,840 --> 00:08:30,320
هل نحن أفضل صديقات؟

124
00:08:33,990 --> 00:08:34,830
.لا تبكي

125
00:08:35,160 --> 00:08:38,280
...لكن ألم تقلن من قبل

126
00:08:38,280 --> 00:08:40,740
أنّكنّ التقيتنّ حديثًا؟

127
00:08:40,970 --> 00:08:44,500
.حسنًا، ذلك كان الحال حينها

128
00:08:44,800 --> 00:08:47,410
إذًا متى قرّرتنّ أنّكنّ أفضل صديقات؟

129
00:08:48,140 --> 00:08:51,630
هل حدث الأمر بينما كنتُ في هوكّايدو؟

130
00:08:51,630 --> 00:08:52,790
...كلاّ

131
00:08:54,730 --> 00:08:55,900
ذلك ما حدث، صحيح؟

132
00:08:55,900 --> 00:08:56,640
!لا تبكي

133
00:08:57,910 --> 00:08:59,140
...أنتنّ الثّلاثة، بدوني

134
00:08:59,290 --> 00:09:00,390
!مهلاً، مهلاً، مهلاً

135
00:09:00,670 --> 00:09:02,460
...دون إخباري حتّى

136
00:09:03,900 --> 00:09:05,650
!لا تخرجي

137
00:09:08,990 --> 00:09:13,280
!على أيّ حال، لا يوجد ما فعلناه دون إخبارك

138
00:09:13,670 --> 00:09:15,780
فعلاً؟

139
00:09:15,990 --> 00:09:19,020
أنت لا تثقين بأيّ أحد بالفعل، صحيح؟

140
00:09:19,550 --> 00:09:22,130
!في الحقيقة، هنالك أمر لم نخبرك به

141
00:09:22,970 --> 00:09:27,350
!لكنّنا ما زلنا صديقات. جميعنا

142
00:09:28,830 --> 00:09:30,320
منذ متى؟

143
00:09:30,320 --> 00:09:33,350
...لا أدري. لا يوجد وقت معيّن

144
00:09:33,350 --> 00:09:35,800
!هذا ما يعنيه أن نكون صديقات

145
00:09:36,140 --> 00:09:41,060
لكنّكنّ لم تخبرنني أبدًا أنّكنّ أردتنّ
.أن نكون صديقات

146
00:09:46,900 --> 00:09:48,830
!لنطمح ليوم مثمر آخر غدًا

147
00:09:48,830 --> 00:09:50,280
!أجل

148
00:09:52,350 --> 00:09:55,130
متى أصبحنا صديقات؟

149
00:09:55,130 --> 00:09:59,890
تعتقدين أنّها كانت تنتظر كلّ هذا الوقت
ليأتي أحدهم ويقول "لنصبح أصدقاء"؟

150
00:10:00,270 --> 00:10:01,650
.يمكننا أن نقولها فحسب

151
00:10:01,650 --> 00:10:03,000
.مستحيل

152
00:10:03,280 --> 00:10:06,390
"!واضح أنّكنّ تقلنها لأنّني دفعتكنّ لذلك"

153
00:10:06,390 --> 00:10:08,080
.ليس علينا فعل ذلك

154
00:10:08,080 --> 00:10:09,030
كيف الوضع مع كيماري؟

155
00:10:09,030 --> 00:10:12,050
...لا أدري. قالت أنّ بإمكانها الاهتمام بالأمر

156
00:10:13,040 --> 00:10:17,280
لكنّها جريئة للغاية بشأن أمور ما
...وخجولة جدًّا بشأن أمور أخرى

157
00:10:27,730 --> 00:10:28,850
هل الخوذ جيّدة؟

158
00:10:28,850 --> 00:10:30,040
!الخوذ جيّدة

159
00:10:30,040 --> 00:10:31,040
أحزمة الذّقن جيّدة؟

160
00:10:31,040 --> 00:10:32,320
!أحزمة الذّقن جيّدة

161
00:10:32,320 --> 00:10:33,410
الصّحّة جيّدة؟

162
00:10:33,410 --> 00:10:34,690
!الصّحّة جيّدة

163
00:10:34,690 --> 00:10:35,710
الأقدام جيّدة؟

164
00:10:35,710 --> 00:10:36,910
!الأقدام جيّدة

165
00:10:36,910 --> 00:10:38,620
!لنطمح ليوم مثمر آخر

166
00:10:38,620 --> 00:10:39,740
!أجل

167
00:10:39,740 --> 00:10:40,670
!كونوا حذرين

168
00:10:40,670 --> 00:10:41,780
!سنكون حذرين

169
00:10:42,440 --> 00:10:45,110
...قالوا أنّنا سنتمكّن من العمل في الدّخل

170
00:10:45,110 --> 00:10:46,840
!لكنّ الجوّ أكثر برودة هنا عمّا هو في الخارج

171
00:10:46,840 --> 00:10:48,120
!بدأ أنفي يحمرّ

172
00:10:48,120 --> 00:10:50,000
إنّهم يقتصدون في الطّاقة، أتتذكّرن؟

173
00:10:50,000 --> 00:10:51,670
.علينا التّقليل من العمل الدّاخليّ

174
00:10:52,070 --> 00:10:53,800
هذا كلّ شيء، صحيح؟

175
00:10:53,980 --> 00:10:55,450
.نعم، شكرًا لكنّ

176
00:10:55,450 --> 00:10:57,490
.والآن، إليكنّ هذه

177
00:10:57,490 --> 00:10:58,220
دجاجة؟

178
00:10:58,220 --> 00:11:00,150
.نعم، إنّه عيد الميلاد المجيد

179
00:11:00,150 --> 00:11:04,010
.أريدكنّ أن تجدن مكانًا دافئًا لإذابتها

180
00:11:04,010 --> 00:11:08,120
لقد قمت بتجهيز القليل لإذابتها
.البارحة، لكن يبدو أنّها لن تكفي

181
00:11:08,120 --> 00:11:09,350
...مكان ما دافئ

182
00:11:09,570 --> 00:11:11,310
!لديّ فكرة

183
00:11:11,310 --> 00:11:12,780
!شكرًا لك

184
00:11:12,780 --> 00:11:16,010
.ويمكنكما أنتما البقاء هنا ومساعدتي

185
00:11:16,010 --> 00:11:16,900
.حاضرة

186
00:11:17,480 --> 00:11:18,900
!سيكون ذلك أفضل مكان

187
00:11:19,280 --> 00:11:21,660
.يبدو ذلك خطيرًا للغاية

188
00:11:21,880 --> 00:11:23,410
ماذا عن إذابتها بالشّمس؟

189
00:11:23,720 --> 00:11:26,360
!إنّها لا تغرب هنا أبدًا في النّهاية

190
00:11:26,360 --> 00:11:27,580
...لا أدري

191
00:11:30,270 --> 00:11:31,480
.كلاهما طائر

192
00:11:31,480 --> 00:11:33,410
.لا أظنّ أنّ ذلك يشكّل فرقًا لها

193
00:11:33,410 --> 00:11:34,900
.ثمّة بطاريق هنا أيضًا

194
00:11:34,900 --> 00:11:36,280
!هل تأكل الطيّور أيضًا؟

195
00:11:36,280 --> 00:11:37,460
!كيف لي أن أعرف؟

196
00:11:38,970 --> 00:11:40,700
.حسنًا، سيفي هذا بالغرض

197
00:11:40,700 --> 00:11:41,340
!نعم

198
00:11:41,780 --> 00:11:43,970
لكن كيف تسير الأمور بشأن الأمر الآخر؟

199
00:11:44,280 --> 00:11:46,470
!أجل، بأحسن حال

200
00:11:46,880 --> 00:11:49,480
!حسنًا، انتهينا من وجبة اليوم الخفيفة

201
00:11:49,770 --> 00:11:51,630
.يبدو هذا إسرافًا كبيرًا

202
00:11:51,630 --> 00:11:53,900
...حسنًا، إنّه عيد الميلاد المجيد

203
00:11:53,900 --> 00:11:55,960
هل هو بتلك الأهمّيّة؟

204
00:11:55,960 --> 00:11:59,400
هل تعرفين أهمّ النّقاط في الحياة في المحطّة؟

205
00:11:59,400 --> 00:12:00,380
...لا

206
00:12:00,380 --> 00:12:02,400
.الطّعام والمناسبات

207
00:12:02,400 --> 00:12:05,920
سوف نعيش حياة تقشّف في مكان
.محدود لوقت طويل قبل كلّ شيء

208
00:12:07,300 --> 00:12:09,000
هكذا الأمر إذًا؟

209
00:12:11,060 --> 00:12:12,750
.حان وقت وجبتكم الخفيفة

210
00:12:13,780 --> 00:12:15,250
!كعكة عيد الميلاد

211
00:12:15,640 --> 00:12:19,510
!عيد ميلاد مجيد

212
00:12:20,730 --> 00:12:22,440
لا تحبّين عيد الميلاد؟

213
00:12:22,440 --> 00:12:24,510
...ليست مسألة لا أحبّه

214
00:12:25,040 --> 00:12:28,010
لكنّه يشبه الاحتفال بيوم المولد؟

215
00:12:28,010 --> 00:12:29,060
وماذا في ذلك؟

216
00:12:29,560 --> 00:12:31,270
هذا ليس عادلاً، صحيح؟

217
00:12:31,770 --> 00:12:36,430
للجميع عيد مولده، ومع ذلك ثمّة العديد
،من النّاس ممّن يُحتفل بيوم مولدهم

218
00:12:36,430 --> 00:12:38,270
!وآخرون لا

219
00:12:49,950 --> 00:12:51,430
أليست تلك أغنيتك؟

220
00:12:59,650 --> 00:13:01,630
تريدين الحصول على مقاطع خارجيّة مقدّمًا؟

221
00:13:01,920 --> 00:13:02,890
.نعم

222
00:13:02,890 --> 00:13:07,510
بما أنّهم قالوا أنّه قد لا يمكننا
.الخروج إن ازداد هبوب الرّياح

223
00:13:07,730 --> 00:13:08,540
...المعذرة

224
00:13:10,200 --> 00:13:12,050
...بشأن الأمر الّذي ذكرتُه من قبل

225
00:13:12,050 --> 00:13:13,710
صحيح، ماذا حدث؟

226
00:13:13,710 --> 00:13:15,770
.قرّرت المشاركة في المسلسل

227
00:13:16,460 --> 00:13:17,150
فعلاً؟

228
00:13:17,690 --> 00:13:20,800
،نعم. لقد فكّرت في الأمر كثيرًا

229
00:13:20,800 --> 00:13:23,780
ويبدو أنّ بعض الأشخاص هنا
.قد يتطلّعون للأمر

230
00:13:24,270 --> 00:13:25,460
!نعم، هذا صحيح

231
00:13:25,460 --> 00:13:26,410
!نعم، نعم

232
00:13:27,180 --> 00:13:31,270
لذلك، هلّي أن أطلب خدمة منكنّ؟

233
00:13:32,160 --> 00:13:34,460
أيمكنكنّ ملء هذا؟

234
00:13:35,490 --> 00:13:36,080
ما هذا؟

235
00:13:36,650 --> 00:13:39,100
،وهكذا، حتّى بعد انتهاء مغامرتنا

236
00:13:39,100 --> 00:13:43,090
ولا نعود قريبات من بعض كما
.اعتدنا، فسأعلم أنّنا سنكون بخير

237
00:13:43,360 --> 00:13:45,100
...ولكن

238
00:13:45,100 --> 00:13:46,660
.لن يعني هذا أيّ شيء

239
00:13:48,450 --> 00:13:51,150
.لقد كنتُ وحيدة من قبل، لذلك أنا أعلم

240
00:13:51,150 --> 00:13:52,550
...حتّى إن فعلتِ هذا

241
00:13:56,720 --> 00:13:58,080
كيماري-سان؟

242
00:13:58,530 --> 00:14:01,260
.آسفة. أنا آسفة

243
00:14:02,630 --> 00:14:04,610
أنت لا تعرفين، صحيح؟

244
00:14:07,780 --> 00:14:09,970
لا يمكنك أن تعرفي، صحيح؟

245
00:14:15,170 --> 00:14:16,710
!لا تتركوا شيئًا خلفكم

246
00:14:16,710 --> 00:14:18,790
إن لم تنظّفوا أطباقكم، فستُحرمون
!من امتيازات الحمّام خاصّتكم

247
00:14:20,790 --> 00:14:22,790
!لنبدأ بالأكل

248
00:14:28,320 --> 00:14:29,650
!بصحّة الجميع

249
00:14:34,030 --> 00:14:35,260
.مجمّدة جزئيًّا

250
00:14:35,260 --> 00:14:37,200
.نعم، مجمّدة جزئيًّا

251
00:14:37,200 --> 00:14:41,020
!مكتوب "وعاء أرزّ متجمّد جزئياً" في القائمة

252
00:14:41,020 --> 00:14:42,520
.يمكن تبرير الأمر هكذا

253
00:14:44,470 --> 00:14:46,150
أتريدين المزيد يا يوزوكي-تشان؟

254
00:14:48,020 --> 00:14:48,790
...لا

255
00:14:51,310 --> 00:14:51,990
!كيماري-سان

256
00:14:54,880 --> 00:14:59,000
.أنا... كنتُ آمل التّحدّث معك بعد العشاء

257
00:15:01,120 --> 00:15:03,000
.آسفة، لديّ شيء عليّ الاهتمام به

258
00:15:05,400 --> 00:15:06,510
...فهمت

259
00:15:09,100 --> 00:15:10,280
ما العمل؟

260
00:15:10,280 --> 00:15:12,350
.لا أعرف إن كنتُ أعرف ما أقوله لها

261
00:15:12,350 --> 00:15:13,850
إذًا، هل علينا الانسحاب؟

262
00:15:13,850 --> 00:15:15,180
...لم أقل ذلك

263
00:15:16,700 --> 00:15:17,530
.يوزو

264
00:15:18,530 --> 00:15:21,730
.لا تقلقي. ليست غاضبة أو ما شابه

265
00:15:22,220 --> 00:15:25,410
.لكنّ كيماري-سان بكت

266
00:15:25,410 --> 00:15:27,230
.أعتقد أنّها جُرحت

267
00:15:29,550 --> 00:15:30,540
.الكرة في ملعبك

268
00:15:30,540 --> 00:15:31,610
!لا تتخلّي عنّي

269
00:15:32,080 --> 00:15:34,370
هل فعلتُ شيئًا غريبًا؟

270
00:15:34,640 --> 00:15:37,360
.حسنًا.... ما كنتُ لأصفه بالغريب

271
00:15:37,360 --> 00:15:41,470
.إن كنتُ في مكانك، لشعرتُ بالمثل على الأرجح

272
00:15:41,820 --> 00:15:42,830
...كلّ ما هنالك

273
00:15:42,100 --> 00:15:44,380
!عيد ميلاد مجيد

274
00:15:44,980 --> 00:15:48,410
.الصّداقة ليست كلمات كثيرة

275
00:15:48,970 --> 00:15:51,830
...أسمع ذلك كثيرًا

276
00:15:51,830 --> 00:15:53,100
ما هي إذًا؟

277
00:15:53,880 --> 00:15:55,320
...تريّثي عليّ

278
00:15:55,320 --> 00:15:58,850
إنّها... مشاعر؟

279
00:15:59,030 --> 00:16:00,250
مشاعر؟

280
00:16:00,250 --> 00:16:03,340
.مثلاً، لنقل أنّك أخبرت كيماري أنّها تروق لك

281
00:16:03,340 --> 00:16:08,130
لكنّ كيماري لا تصدّقك، لذلك
.تريدك أن تكتبي الأمر على ورقة

282
00:16:08,130 --> 00:16:10,890
سوف تكرهين ذلك، صحيح؟
.ستشعرين أنّها لم تثق بك

283
00:16:10,890 --> 00:16:11,950
...حسنًا

284
00:16:11,950 --> 00:16:14,230
!أريد المزيد رجاءً

285
00:16:15,330 --> 00:16:18,040
.على الأرجح أنّها بكت لهذا السّبب

286
00:16:20,050 --> 00:16:23,530
.يوزو، إنّ كيماري تعتبرك صديقة سلفًا

287
00:16:24,280 --> 00:16:26,930
لكن ما الّذي يجعلنا صديقات؟

288
00:16:26,930 --> 00:16:29,170
كيف نصبح صديقات؟

289
00:16:29,170 --> 00:16:30,470
...حسنًا

290
00:16:30,730 --> 00:16:33,970
على الأرجح أنّه لا توجد طريقة
.حقيقيّة لتعريف الأمر

291
00:16:35,050 --> 00:16:38,470
.إنّها ليست كالعلاقة الأبويّة أو الزّوجيّة

292
00:16:38,470 --> 00:16:40,110
.إنّها أكثر غموضًا من ذلك

293
00:16:40,470 --> 00:16:43,200
.لا أحد يُلام إن تلاشت

294
00:16:43,200 --> 00:16:44,190
...كلاّ

295
00:16:44,540 --> 00:16:46,520
.هذا هو الحال بالنّسبة لي على الأقلّ

296
00:16:46,520 --> 00:16:48,670
.لكنّ ذلك هو ما يجعلها غير مقيّدة

297
00:16:48,670 --> 00:16:50,490
.ذلك ما يجعلنا نكون معًا

298
00:16:58,920 --> 00:17:00,360
.عيد ميلاد مجيد

299
00:17:00,740 --> 00:17:01,500
.لقد عدنا

300
00:17:06,490 --> 00:17:08,500
هل ثمّة أطفال جيّدون هنا أيضًا؟

301
00:17:11,310 --> 00:17:14,170
هل ثمّة أطفال جيّدون هنا أيضًا؟

302
00:17:14,170 --> 00:17:16,510
لماذا نتكبّد عناء العرض من الأساس؟

303
00:17:16,740 --> 00:17:18,870
!لهذا السّبب لم أرد القيام بهذا

304
00:17:18,870 --> 00:17:19,730
لماذا أرغمتِنا على فعله؟

305
00:17:19,730 --> 00:17:21,720
.انسي الأمر. هيّا، لنذهب

306
00:17:21,720 --> 00:17:23,270
أخبرتنا كيماري، أتذكرين؟

307
00:17:25,820 --> 00:17:27,620
ما معنى ذلك؟

308
00:17:28,080 --> 00:17:30,240
...لا أظنّ بالفعل أنّني أفهم

309
00:17:40,010 --> 00:17:42,080
!عـ-عيد ميلاد مجيد

310
00:17:43,960 --> 00:17:45,230
!ماذا تفعلين؟

311
00:17:45,230 --> 00:17:47,210
...إنّه عيد الميلاد، لذا

312
00:17:48,970 --> 00:17:50,540
!هذا مؤلم

313
00:17:50,540 --> 00:17:52,240
هل أنت بخير؟

314
00:17:52,240 --> 00:17:53,840
هل يمكننا أن نتحدّث قليلاً؟

315
00:17:55,140 --> 00:17:59,230
من الصّعب أن نخلد للنّوم بينما
الوقت غسقًا هكذا، صحيح؟

316
00:17:59,230 --> 00:18:01,490
.كما لو أنّ اليوم لا ينتهي أبدًا

317
00:18:02,600 --> 00:18:04,290
أنت غاضبة، صحيح؟

318
00:18:05,240 --> 00:18:06,850
.لم تردّي عليّ

319
00:18:08,040 --> 00:18:10,360
.هذا لأنّه ليس لديك أيّ شيء لتعتذري عنه

320
00:18:12,620 --> 00:18:14,090
ما هذا؟

321
00:18:14,090 --> 00:18:18,740
كانت ميغو-تشان صديقتي
.مذ كنّا في الحضانة

322
00:18:20,070 --> 00:18:24,140
قُبيل مغادرتي، قالت أنّها لا تريد
...أن نظلّ صديقتين

323
00:18:24,140 --> 00:18:26,440
...لكن ما زلت أعتبرها صديقة لي

324
00:18:26,440 --> 00:18:28,490
إنّها لا تجيب كثيرًا، صحيح؟

325
00:18:28,490 --> 00:18:30,800
...لكن بطريقة ما، أنا أعرف

326
00:18:30,800 --> 00:18:32,700
،عندما أشاهد الشّاشة

327
00:18:32,700 --> 00:18:36,100
.وتظهر ملحوظة أنّ الرّسالة قد قُرئت

328
00:18:36,100 --> 00:18:37,810
،تقوم أحيانًا بالرّدّ عليّ

329
00:18:38,260 --> 00:18:41,610
،أحيانًا في الحال، وأحيانًا بعد فترة

330
00:18:41,610 --> 00:18:43,110
...وأحيانًا أخرى بعد نصف يوم

331
00:18:44,070 --> 00:18:47,270
.في كلّ مرّة أراها، أعرف

332
00:18:47,950 --> 00:18:50,960
".أراهن أنّها في المدرسة الآن"

333
00:18:50,960 --> 00:18:53,130
".أراهن أنّها في السّرير"

334
00:18:53,130 --> 00:18:56,390
أراهن أنّها ليست واثقة"
".أنّ عليها أن تردّ أم لا

335
00:18:59,170 --> 00:19:02,130
.أستطيع أن أعرف كيف تشعر

336
00:19:02,130 --> 00:19:03,120
هل ذلك غريب؟

337
00:19:04,620 --> 00:19:07,870
.تلك هي فكرتي عن الأصدقاء

338
00:19:08,630 --> 00:19:13,280
،أعلم أنّها غامضة تمامًا
.لكنّ الأمر كذلك بالنّسبة لي

339
00:19:15,720 --> 00:19:19,140
أنا آسفة. أعتقد أنّ ذلك
...لا يحلّ أيّ شيء

340
00:19:23,390 --> 00:19:24,790
!عيد ميلاد مجيد

341
00:19:24,790 --> 00:19:25,850
...وأيضًا

342
00:19:25,850 --> 00:19:28,060
!عيد مولد سعيد

343
00:19:29,430 --> 00:19:32,660
يوزوكي-تشان، كان عيد مولدك
من قبل، صحيح؟

344
00:19:32,660 --> 00:19:36,150
لكنّنا أمضينا معظم وقتنا
...مصابات بالدّوار

345
00:19:36,150 --> 00:19:37,030
.نحن آسفات

346
00:19:37,540 --> 00:19:41,390
اقترحت كيماري أنّ علينا الاحتفال به
.في القطب الجنوبيّ

347
00:19:41,390 --> 00:19:43,490
.طلبنا من يوميكو-سان توفير المكوّنات

348
00:19:43,490 --> 00:19:47,290
حسنًا، املئي الأجزاء الّتي أخطأنا
.فيها بمخيّلتك فحسب

349
00:19:50,950 --> 00:19:52,290
...يوزوكي-تشان

350
00:19:53,040 --> 00:19:54,040
عيد مولد سعيد

351
00:19:54,040 --> 00:19:54,990
!عيد مولد سعيد

352
00:19:54,990 --> 00:19:55,800
.حسنًا، أطفئي الشّمعة

353
00:20:00,630 --> 00:20:01,730
ثانية؟

354
00:20:01,730 --> 00:20:04,050
هذا ما حدث أيضًا عندما التقيناك
أوّل مرّة، صحيح؟

355
00:20:04,500 --> 00:20:06,840
!لستُ أبكي

356
00:20:06,840 --> 00:20:09,030
.أطفئي الشّمعة قبل أن تذوب

357
00:20:09,030 --> 00:20:10,440
.يوزوكي-تشان

358
00:20:10,440 --> 00:20:11,810
!كلاّ

359
00:20:12,610 --> 00:20:13,740
...لأنّها

360
00:20:13,740 --> 00:20:15,930
...أوّل مرّة

361
00:20:15,930 --> 00:20:18,070
...يحتفل فيها أصدقائي بعيد مولدي

362
00:20:21,600 --> 00:20:23,180
.هيّا يا يوزوكي-تشان

363
00:20:33,030 --> 00:20:33,960
!بوركتِ

364
00:20:33,960 --> 00:20:35,170
...يا إلهي

365
00:20:40,350 --> 00:20:44,220
!لقد أفسدتُ أوّل تجربة لي

366
00:21:02,890 --> 00:21:04,610
!وقت الوجبة الخفيفة

367
00:21:05,140 --> 00:21:05,910
!أجل

368
00:21:20,620 --> 00:21:25,390
،لكن عندما يُطرح السّؤال عليك
يصعب التّعبير عنه، صحيح؟

369
00:21:26,260 --> 00:21:27,330
تقصدين من هم الأصدقاء؟

370
00:21:27,330 --> 00:21:27,930
.نعم

371
00:21:27,930 --> 00:21:31,670
.يُمسي لدينا القليل بعد حرقها

372
00:21:31,670 --> 00:21:36,040
لكن قالوا عند استعادة قمامة سنة
.كاملة، فستكون بحجم جبل

373
00:21:44,640 --> 00:21:45,990
!فهمت

374
00:21:46,570 --> 00:21:49,890
!أعتقد أنّ الصّداقة تكمن في هذه الكلمة الصغيرة

375
00:21:51,610 --> 00:21:53,030
"ماذا؟ تقصدين "صحيح؟

376
00:21:53,030 --> 00:21:55,430
.لكنّها أفضل من اقتباسك يا هيناتا

377
00:21:55,430 --> 00:21:56,380
!أعلم