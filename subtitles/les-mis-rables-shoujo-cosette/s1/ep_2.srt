192
00:14:51,250 --> 00:14:53,620
!توقفي عن إضاعة الوقت يا كوزيت

193
00:14:53,620 --> 00:14:54,290
.حاضرة

194
00:14:54,290 --> 00:14:56,790
.أحضري لي المزيد من النبيذ من الخلف يا كوزيت

195
00:14:56,790 --> 00:14:57,500
.حاضرة

196
00:14:57,670 --> 00:15:00,130
أين فستاني يا كوزيت؟

197
00:15:00,130 --> 00:15:01,090
وخاصّتي؟

198
00:15:01,090 --> 00:15:02,840
.لم يجف بعد

199
00:15:03,170 --> 00:15:04,550
كيف ذلك؟

200
00:15:27,700 --> 00:15:29,490
.تعثّرت

201
00:15:30,330 --> 00:15:31,950
!يا لقسوتك يا إيبونين

202
00:15:32,120 --> 00:15:34,000
أنتِ هي القاسية يا كوزيت؛

203
00:15:34,200 --> 00:15:36,290
.بترككِ دلوًا هنا

204
00:15:36,750 --> 00:15:39,380
.انظري، ابتلّت ملابسي

205
00:15:39,380 --> 00:15:40,590
!ابتلّت

206
00:15:40,590 --> 00:15:42,000
...فعلتِ ذلك عمدًا

207
00:15:42,340 --> 00:15:44,920
.إذن، أنتِ تتحدَّينني

208
00:15:44,920 --> 00:15:46,010
.تحدّي

209
00:15:46,010 --> 00:15:48,390
أينبغي عليّ إخبار أمي يا ترى؟

210
00:15:48,390 --> 00:15:49,470
.إخبار أمي

211
00:15:56,690 --> 00:15:58,480
.أسرعي ونظفّي الأرضية

212
00:15:58,480 --> 00:15:59,900
.نظفيها

213
00:16:01,570 --> 00:16:03,860
.أشعر وكأنّ شيئًا سقط على رأسي

214
00:16:04,190 --> 00:16:05,860
.لا يسعني الرّؤية

215
00:16:06,570 --> 00:16:07,820
!فأر

216
00:16:10,240 --> 00:16:12,700
التنمّر أمر سيّئ، أليس كذلك؟

217
00:16:12,870 --> 00:16:14,080
.غافروش

218
00:16:14,660 --> 00:16:16,750
.أردت رمي واحد آخر

219
00:16:17,660 --> 00:16:19,540
.سأساعدكِ يا كوزيت

220
00:16:19,540 --> 00:16:21,420
.شكرًا لك يا غافروش

221
00:16:21,420 --> 00:16:23,090
...أكره الفئران

222
00:16:23,090 --> 00:16:24,760
.لا بدّ أن غافروش من فعل ذلك

223
00:16:24,760 --> 00:16:26,380
.إنّ تصرّفاته تغضبني حقًّا

224
00:16:26,380 --> 00:16:28,760
.إيبونين، آزيلما، لديّ وجبة خفيفة لكما

225
00:16:28,760 --> 00:16:29,890
!قادمتان

226
00:16:30,590 --> 00:16:32,470
.ها أنتما

227
00:16:32,800 --> 00:16:34,680
.خبزت لكما بعض الكعك اليوم

228
00:16:34,680 --> 00:16:36,930
رائحة الزبدة زكيّة، أليس كذلك؟

229
00:16:37,140 --> 00:16:40,690
.إذن، لنأكلها أمام كوزيت

230
00:16:40,690 --> 00:16:42,060
.لنتباهى بها أمامها

231
00:16:42,400 --> 00:16:45,320
بفضل مساعدتك أصبحت
.الأرضيّة نظيفة يا غافروش

232
00:16:45,440 --> 00:16:47,240
.دعيني أساعدكِ أكثر

233
00:16:47,400 --> 00:16:48,530
!يا لها من رائحة زكيّة

234
00:16:48,530 --> 00:16:49,490
.رائحة زكيّة

235
00:16:50,160 --> 00:16:52,200
.تبدو هذه الكعكة لذيذة

236
00:16:52,200 --> 00:16:53,740
.سآكلها هنا

237
00:16:54,410 --> 00:16:56,660
.إنهما يفعلان شيئًا غريبًا مجددًا اليوم

238
00:16:56,750 --> 00:16:58,410
.لا تشغل بالك بهما

239
00:16:59,410 --> 00:17:00,580
!لنأكل

240
00:17:00,580 --> 00:17:01,500
.انتظري قليلاً

241
00:17:02,000 --> 00:17:02,920
.تعالي إلى هنا

242
00:17:02,920 --> 00:17:03,670
ماذا؟

243
00:17:04,500 --> 00:17:06,380
.سأضع هذا جانبًا

244
00:17:07,760 --> 00:17:09,880
.هيّا، ضعي خاصّتكِ هنا أيضًا يا آزيلما

245
00:17:10,050 --> 00:17:11,680
!لا، أريد أن آكلها

246
00:17:11,680 --> 00:17:13,050
.لديّ فكرة أفضل

247
00:17:13,350 --> 00:17:16,430
.كما ترين، سنخبّئه هنا

248
00:17:17,020 --> 00:17:20,690
.وبعد ذلك، سنخبر أمي أنّ كوزيت أخذت الكعك منا

249
00:17:21,690 --> 00:17:24,940
حينها، ستقوم أمي بتوبيخ كوزيت، أليس كذلك؟

250
00:17:24,940 --> 00:17:28,070
.بعد ذلك، يمكننا أكل الكعك الذي خبّأناه

251
00:17:28,190 --> 00:17:29,070
.فهمت

252
00:17:32,110 --> 00:17:33,490
!أمّي

253
00:17:33,870 --> 00:17:34,830
ما الخطب؟

254
00:17:35,030 --> 00:17:36,240
!أُخذ كعكنا

255
00:17:36,240 --> 00:17:37,120
!أُخذ

256
00:17:37,120 --> 00:17:39,040
.أخذه كوزيت وغافروش

257
00:17:39,040 --> 00:17:40,250
!كوزيت وغافروش

258
00:17:40,710 --> 00:17:41,960
الكعك الذي أعطيتكم إيّاه؟

259
00:17:41,960 --> 00:17:43,040
.نعم

260
00:17:43,960 --> 00:17:45,670
.لا أشم رائحة زبدة

261
00:17:46,170 --> 00:17:48,550
أُخذ الكعك منكما قبل أن تأكلا
قضمة واحدة حتّى، أليس كذلك؟

262
00:17:48,550 --> 00:17:49,090
.بلى

263
00:17:49,420 --> 00:17:52,430
.حسنٌ، ستلقّنهما أمّكما درسًا

264
00:17:55,680 --> 00:17:56,720
!كوزيت

265
00:17:56,720 --> 00:17:57,260
.نعم

266
00:17:57,600 --> 00:17:58,770
.أعيدهم بسرعة

267
00:18:00,350 --> 00:18:05,730
لا تتظاهري بالغباء، أخذتِ الكعك
من إيبونين وآزيلما، أليس كذلك؟

268
00:18:05,980 --> 00:18:07,190
.لم أفعل

269
00:18:07,190 --> 00:18:09,650
ماذا؟! أتظنّين أنّني سأصدّق ذلك؟

270
00:18:09,650 --> 00:18:11,280
.أنا حقًّا لم أفعل ذلك

271
00:18:12,360 --> 00:18:14,280
.يبدو أنّها أكلته بالفعل

272
00:18:14,280 --> 00:18:15,490
.أكلته

273
00:18:16,490 --> 00:18:18,330
.لا أشمُّ رائحة زبدة

274
00:18:18,790 --> 00:18:20,910
!لم تأكليه بعد، أعيديه بسرعة

275
00:18:20,910 --> 00:18:21,830
!لم آخذه

276
00:18:21,830 --> 00:18:22,540
!ماذا؟

277
00:18:23,460 --> 00:18:25,500
!إنّكِ طفلة بغيضة حقًّا

278
00:18:26,880 --> 00:18:30,710
.أيتها المسكينتان، سأصنع لكما المزيد غدًا

279
00:18:30,710 --> 00:18:32,470
تحمّلا لليوم، أفهمتما؟

280
00:18:32,880 --> 00:18:34,470
.سنحتمّل

281
00:18:34,470 --> 00:18:37,600
!يا لكما من طفلتين رائعتين ولطيفتين

282
00:18:37,800 --> 00:18:39,100
...مؤلم

283
00:18:39,600 --> 00:18:41,430
.هيّا، اذهبا للعب في غرفتكما

284
00:18:41,430 --> 00:18:42,480
!حاضرة

285
00:18:42,480 --> 00:18:44,310
.سأناديكما حين يجهز العشاء

286
00:18:44,310 --> 00:18:45,060
!مؤلم

287
00:18:50,440 --> 00:18:52,070
.سار ذلك جيّدًا

288
00:18:52,150 --> 00:18:54,320
.بالطّبع، والآن لنأكل

289
00:18:55,320 --> 00:18:57,320
.عجبًا، أنا واثقة أنّني وضعتها هنا

290
00:18:58,120 --> 00:18:59,200
!اختفت العلبة

291
00:19:06,670 --> 00:19:08,000
...إنّني جائعة

292
00:19:08,000 --> 00:19:09,710
!كوزيت! كوزيت

293
00:19:10,090 --> 00:19:11,000
غافروش...؟

294
00:19:11,000 --> 00:19:12,380
!انظري! انظري

295
00:19:12,510 --> 00:19:13,550
ماذا؟

296
00:19:15,720 --> 00:19:16,590
.انظري

297
00:19:17,590 --> 00:19:20,470
.وجدت ما أخفته إيبونين وآزيلما

298
00:19:20,890 --> 00:19:22,890
.إذن، عليك إعادتها

299
00:19:22,890 --> 00:19:26,810
.لكنّ إيبونين وآزيلما كذبتا وتنمرتا عليكِ

300
00:19:27,770 --> 00:19:29,480
.التنمّر أمر سيّئ

301
00:19:29,690 --> 00:19:30,610
أنأكلها؟

302
00:19:30,610 --> 00:19:31,440
.نعم

303
00:19:31,440 --> 00:19:33,320
!اختفى الكعك

304
00:19:33,320 --> 00:19:36,110
!كوزيت وغافروش أخذاه

305
00:19:36,110 --> 00:19:40,120
سمعت ذلك بالفعل، لهذا عاقبت كوزيت، أتذكرين؟

306
00:19:40,580 --> 00:19:43,620
ماذا؟ ما الأمر الآن؟

307
00:19:53,710 --> 00:19:54,840
.كان ذلك لذيذًا

308
00:19:54,840 --> 00:19:56,550
.أجل، كان لذيذًا

309
00:19:58,220 --> 00:20:00,600
هل سلكت والدتكِ ذلك الطريق؟

310
00:20:00,760 --> 00:20:01,470
.نعم

311
00:20:02,180 --> 00:20:04,270
متى ستعود؟

312
00:20:04,600 --> 00:20:10,270
لا أعلم، ولكنها قالت إنّها ستعود بمجرد أن
.تجد منزلاً يمكننا العيش فيه بسعادة كعائلة

313
00:20:10,270 --> 00:20:14,150
"في كلّ صباح أسأل نفسي: "أستعود اليوم؟

314
00:20:14,610 --> 00:20:18,490
"ومع حلول الليل أسأل نفسي: "هل ستعود غدًا؟

315
00:20:18,700 --> 00:20:20,700
.آمل أن تعود قريبًا

316
00:20:20,700 --> 00:20:25,120
.أجل، ولكن حينها سأضطرّ إلى توديعك

317
00:20:25,790 --> 00:20:27,710
أستأتي معنا يا غافروش؟

318
00:20:27,710 --> 00:20:28,290
.نعم

319
00:20:28,290 --> 00:20:30,790
هل تودّ أن تكون أخي الصغير يا غافروش؟

320
00:20:30,790 --> 00:20:32,040
.نعم أودّ ذلك

321
00:20:32,040 --> 00:20:33,210
.هذا مطمئن

322
00:20:36,050 --> 00:20:39,260
هل ستعودين قريبًا يا أمي؟

323
00:20:41,140 --> 00:20:44,390
.كوزيت كبرت وهي بخير وصحة جيّدة

324
00:20:46,220 --> 00:20:47,390
...كوزيت

325
00:20:47,890 --> 00:20:52,360
.أعرف عن حالكِ من رسائل عائلة تيناردييه الطيبين

326
00:20:53,270 --> 00:20:57,400
.ولكن بعدي عنكِ هو ما يؤلمني

327
00:20:59,070 --> 00:21:01,910
.أريد رؤيتكِ يا كوزيت

328
00:21:04,990 --> 00:21:06,700
.أجل، أحسنت عملاً

329
00:21:07,000 --> 00:21:08,870
.هذا تقرير ممتاز يا ألان

330
00:21:09,040 --> 00:21:12,210
إذن، أتظنّ أنّ عمليّة البناء لدار
الأيتام الجديدة ستبدأ قريبًا؟

331
00:21:13,630 --> 00:21:19,260
علمت أنّ جزءًا صغيرًا فحسب من المراهقين
.قادرون على دخول دار الأيتام الحاليّة

332
00:21:20,090 --> 00:21:26,390
أريد أن أكون قادرًا على توفير أسرّة دافئة وطعام
.دافئ وتعليم للعديد من الأطفال في أقرب وقت ممكن

333
00:21:26,560 --> 00:21:27,140
.نعم

334
00:21:32,520 --> 00:21:33,690
عاصفة...؟

335
00:21:33,690 --> 00:21:35,770
.هذا غير معتاد في هذا الموسم

336
00:23:26,840 --> 00:23:28,470
لمَ أنتِ غاضبة؟

337
00:23:28,470 --> 00:23:31,060
!تيناردييه الحقير! لا تتنمّر على كوزيت

338
00:23:31,060 --> 00:23:33,730
.الأمر نفسه ينطبق على السيّدة وإيبونين وآزيلما

339
00:23:33,730 --> 00:23:36,980
.من بينهم جميعًا، يبدو أنّ غافروش صديقها الوحيد

340
00:23:36,980 --> 00:23:38,650
!نحن نعتمد عليك يا غافروش

341
00:23:38,650 --> 00:23:40,320
.حسنٌ، بخصوص الحلقة القادمة

342
00:23:40,320 --> 00:23:42,730
.اسمها: صديق جديد، تشو تشو

343
00:23:42,730 --> 00:23:44,030
من هو تشو تشو؟

344
00:23:44,030 --> 00:23:45,860
.عليكِ مشاهدة الحلقة القادمة لمعرفة ذلك

345
00:23:45,860 --> 00:23:49,240
وأيضًا، في نهاية هذه الحلقة
...سيظهر شخص له وجه مخيف

346
00:23:49,240 --> 00:23:51,870
.عليكم مشاهدة الحلقة القادمة لرؤية ذلك أيضًا