1
00:00:02,950 --> 00:00:06,000
...ابتعدوا... ابتعدوا

2
00:00:06,000 --> 00:00:08,240
...لا تقتربوا

3
00:00:14,480 --> 00:00:15,920
...الجوّ بارد

4
00:00:16,980 --> 00:00:19,440
.الجوّ بارد اليوم بالفعل

5
00:00:19,440 --> 00:00:23,620
سيّدتي أزوسا، ألن يكون اليوم
يومًا مناسبًا للينابيع السّاخنة؟

6
00:00:23,620 --> 00:00:25,540
!هذه فكرة جيّدة

7
00:00:25,540 --> 00:00:29,050
.يا إلهي. أنتم التّنانين الحمراء مثيرون للشّفقة

8
00:00:29,050 --> 00:00:32,610
تريدين الذّهاب للينابيع السّاخنة
!لأنّك تشعرين بالبرد؟ يا لضعفك

9
00:00:32,610 --> 00:00:35,050
الأيّام الباردة هي أفضل الأيّام
!للذّهاب للبحر

10
00:00:35,290 --> 00:00:38,560
هذه هي الأفكار الغبيّة الّتي
.أتوقّعها من تنّينة زرقاء

11
00:00:40,120 --> 00:00:42,860
يا سيّدتي، ألا تجدين البحر أكثر حماسة؟

12
00:00:42,860 --> 00:00:45,200
.لا، ليس تمامًا

13
00:00:45,900 --> 00:00:47,620
البحر؟

14
00:00:47,620 --> 00:00:50,370
أعتقد أنّي لا أمانع الذّهاب
.إن لم يكن الجوّ باردًا

15
00:00:50,370 --> 00:00:52,190
.لنذهب جميعًا يومًا ما

16
00:00:52,190 --> 00:00:55,700
!مرحى! أريد رؤية نجم بحر حيّ وحقيقي

17
00:00:55,700 --> 00:00:59,160
.إنّ أشكالها الخماسيّة مثيرة للاهتمام

18
00:00:59,160 --> 00:01:01,960
.أراهن أنّه ستكون هناك أرواح أيضًا

19
00:01:01,960 --> 00:01:06,050
.أنا لا أحبّ جوّ البحر المالح، لكن لا بأس

20
00:01:11,830 --> 00:01:15,710
!البحر الجنوبيّ! يبدو ذلك حماسيًّا بالفعل

21
00:01:15,710 --> 00:01:17,820
!أودّ زيارته أيضًا

22
00:01:17,820 --> 00:01:19,530
!حسنًا، اتّفقنا إذًا

23
00:01:19,530 --> 00:01:22,050
!لنذهب جميعًا للبحر

24
00:01:22,050 --> 00:01:23,980
!أجل

25
00:02:56,680 --> 00:02:58,590
!والبحر أزرق

26
00:02:59,320 --> 00:03:01,830
!نحن في الجنوب

27
00:03:03,970 --> 00:03:06,510
!لنصنع قلعة رمال يا شالشا

28
00:03:06,510 --> 00:03:09,290
نعم. أريد بناء نموذج بقياس 1/100

29
00:03:09,290 --> 00:03:13,130
لقلعة ألفانتونو الشّهيرة المصمّمة
.على طراز لوبكيني

30
00:03:13,650 --> 00:03:17,830
سأذهب لرؤية إن كان هنالك
!أيّ أشباح في أسفل الجرف

31
00:03:18,250 --> 00:03:20,000
.ستذهب للبحث بالفعل

32
00:03:20,000 --> 00:03:24,010
!يا لأشعة الشّمس الجميلة
!يساعدني هذا على التّركيب الضّوئيّ بالفعل

33
00:03:24,550 --> 00:03:27,500
!الجوّ جميل ودافئ، أشعر بشعور رائع أيضًا

34
00:03:27,500 --> 00:03:30,010
.كنتِ تشعرين بالبرد سابقًا بالفعل

35
00:03:30,010 --> 00:03:32,520
!البحر! إنّه البحر

36
00:03:34,520 --> 00:03:39,030
!اسمعا أنتما! تذكّرا أن تقوما بالإحماء أوّلاً

37
00:03:43,950 --> 00:03:45,530
!ما الّذي حدث؟

38
00:03:48,660 --> 00:03:50,100
!ما الخطب؟

39
00:03:52,490 --> 00:03:54,540
!لقد لُسعنا

40
00:03:57,790 --> 00:03:59,000
!قناديل بحر؟

41
00:03:59,000 --> 00:04:00,710
!ثمّة الكثير منها

42
00:04:11,510 --> 00:04:13,680
.اختفى الانتفاخ الآن

43
00:04:18,360 --> 00:04:20,090
هنالك قناديل بحر إذًا؟

44
00:04:20,090 --> 00:04:22,940
.لم أكن أعلم أنّها ستكون بهذه الأعداد

45
00:04:22,940 --> 00:04:25,230
.لن نستطيع السّباحة هكذا

46
00:04:25,230 --> 00:04:27,290
.مع أنّي لم أكن سأسبح على أيّ حال

47
00:04:27,290 --> 00:04:28,950
.هذا مؤسف

48
00:04:28,950 --> 00:04:31,720
.أردتُ رؤية نجم بحر

49
00:04:31,720 --> 00:04:32,950
...وشكله الخماسيّ

50
00:04:32,950 --> 00:04:36,680
.يا إلهي، أردتُ الاسترخاء أكثر

51
00:04:45,090 --> 00:04:46,920
أهي رسّامة؟

52
00:04:49,460 --> 00:04:53,100
مرحبًا! ما الّذي ترسمينه؟

53
00:04:53,100 --> 00:04:54,370
.البحر

54
00:04:56,570 --> 00:04:59,360
هذا البحر جميل بالفعل، صحيح؟

55
00:05:01,210 --> 00:05:02,070
.نعم

56
00:05:03,810 --> 00:05:06,110
أتريدان رؤية رسوماتي الأخرى؟

57
00:05:10,630 --> 00:05:12,800
...إنّها... حسنًا، لنقل أنّها

58
00:05:14,620 --> 00:05:18,100
.نعم، لذلك السّبب من الصّعب بيعها

59
00:05:18,880 --> 00:05:23,450
.مرحبًا. أنا كورالينا، روح قنديل بحر

60
00:05:23,450 --> 00:05:28,390
.أجوب أنحاء العالم بلا هدف وأرسم

61
00:05:28,610 --> 00:05:30,530
أنت روح؟

62
00:05:30,530 --> 00:05:34,090
!مهلاً، أقلت قنديل بحر؟
!مثل الّتي تملأ البحر الآن؟

63
00:05:35,530 --> 00:05:36,640
.نعم

64
00:05:36,990 --> 00:05:40,710
،عفوًا... أتينا إلى هنا للسّباحة

65
00:05:40,710 --> 00:05:43,000
.لكنّنا لا نستطيع دخول المياه

66
00:05:43,000 --> 00:05:45,750
هل تستطيعين إبعاد القناديل؟

67
00:05:45,750 --> 00:05:47,520
.لا يمكنني ذلك

68
00:05:48,170 --> 00:05:50,560
.لا تملك قناديل البحر أيّ أفكار

69
00:05:50,560 --> 00:05:53,390
.إنّها تنجرف حيث تأخذها التّيّارات فحسب

70
00:05:53,390 --> 00:05:56,510
.لذلك فإنّ مناداتها بالتّخاطر لن تنفع

71
00:05:56,510 --> 00:05:57,860
.قناديل-ديل-ديل

72
00:05:58,160 --> 00:06:00,170
أهكذا تضحك؟

73
00:06:06,570 --> 00:06:11,670
أعيش حياتي منجرفة من مكان لآخر
.لأكون مثالاً لقناديل البحر

74
00:06:12,060 --> 00:06:15,300
.لا أعتقد أنّ ذلك له أيّ تأثير عليها

75
00:06:16,890 --> 00:06:20,060
.أستطيع جعل قناديل البحر تتوهّج أيضًا

76
00:06:20,370 --> 00:06:23,410
!تتوهّج؟! أريد رؤية ذلك

77
00:06:23,410 --> 00:06:25,440
.لم أرَ أيّ شيء كهذا من قبل أيضًا

78
00:06:26,340 --> 00:06:28,450
.حسنًا، شاهدن

79
00:06:43,120 --> 00:06:45,960
.نسيت كيف أقوم بذلك

80
00:06:47,320 --> 00:06:49,190
!نسيت؟

81
00:06:49,190 --> 00:06:50,980
.ما كان عليّ تعليق آمالي على هذا

82
00:06:51,480 --> 00:06:54,620
ولكن في المقابل، بالنّسبة لتحريك
...قناديل البحر

83
00:06:54,620 --> 00:06:57,730
.تذكّرتُ أنّ ذلك قد يكون ممكنًا

84
00:06:58,010 --> 00:06:59,480
فعلاً؟

85
00:06:59,480 --> 00:07:05,480
سأطلب من روح الأمواج أن تغيّر
.التّيّارات لتتحرّك القناديل

86
00:07:06,720 --> 00:07:08,730
!افعلي ذلك رجاءً

87
00:07:09,280 --> 00:07:12,400
.لكن لديّ خدمة أطلبها منكنّ في المقابل

88
00:07:12,400 --> 00:07:15,890
هلاّ سمحتنّ لي برسم لوحات لكنّ؟

89
00:07:30,380 --> 00:07:34,080
.ذهبتُ إلى روح الشّلاّلات عن طريق الخطأ

90
00:07:34,520 --> 00:07:38,090
،ثمّ قدّمت لي الشّاي
.لذلك بقيت هناك لوقت طويل

91
00:07:38,090 --> 00:07:40,090
هل سينفع هذا؟

92
00:07:40,090 --> 00:07:44,110
.لكنّي طلبتُ المساعدة من روح الأمواج بالفعل

93
00:07:54,860 --> 00:07:56,640
!هذا مذهل

94
00:07:58,550 --> 00:08:01,120
.يمكنكنّ الذّهاب للسّباحة كما تشأن الآن

95
00:08:01,640 --> 00:08:06,000
حسنًا يا فتيات! لنستمتع بالبحر
!من أعماق قلوبنا

96
00:08:06,000 --> 00:08:09,500
!أجل! البحر

97
00:08:16,500 --> 00:08:19,020
...واحد، اثنان، ثلاثة، أربعة

98
00:08:36,810 --> 00:08:39,530
!البحر الجنوبيّ هو الأفضل بالفعل

99
00:08:39,870 --> 00:08:41,940
!شكرًا لك يا كورالينا

100
00:08:41,940 --> 00:08:44,920
!جعلتِ يومنا يومًا رائعًا

101
00:08:45,280 --> 00:08:49,430
.لم أقف أمام أيّ أحد ليرسمني من قبل
كيف كانت النّتيجة يا ترى؟

102
00:08:49,740 --> 00:08:53,970
،جيّدة. أحتاج لبعض الوقت لإنهائها

103
00:08:53,970 --> 00:08:56,170
.لكنّي أعتقد أنّ اللّوحات النّهائيّة ستكون رائعة

104
00:08:56,170 --> 00:08:58,000
!سرّني سماع ذلك

105
00:08:58,590 --> 00:09:04,430
هل يمكنني عرض اللّوحات
النّهائيّة لكنّ في معرضي؟

106
00:09:04,430 --> 00:09:05,380
ماذا؟

107
00:09:05,380 --> 00:09:06,800
...لوحاتنا

108
00:09:08,230 --> 00:09:09,690
!يبدو ذلك رائعًا

109
00:09:09,690 --> 00:09:11,700
...أكيد، لا بأس

110
00:09:11,700 --> 00:09:15,050
لكن هل يمكننا الحضور لرؤيته أيضًا؟

111
00:09:15,050 --> 00:09:19,120
.نعم. سأعطيكنّ بعض التّذاكر

112
00:09:19,120 --> 00:09:21,040
،مع أخرى إضافيّة أيضًا

113
00:09:21,040 --> 00:09:24,590
لذلك إن كنت تعرفين أيّ أحد
.مهتمّ بالحضور، ادعيه أيضًا

114
00:09:24,590 --> 00:09:26,200
!شكرًا جزيلاً لك

115
00:09:26,650 --> 00:09:28,700
...أتساءل من يمكننا دعوته

116
00:09:28,970 --> 00:09:33,100
ماذا عن الشّياطين؟
.يبدون على معرفة بالفنون

117
00:09:33,100 --> 00:09:34,090
!أجل

118
00:09:39,950 --> 00:09:41,850
.تذكّرتُ الآن

119
00:09:41,850 --> 00:09:42,810
ماذا؟

120
00:09:52,910 --> 00:09:54,160
...قناديل البحر

121
00:09:54,160 --> 00:09:55,360
!تتوهّج

122
00:09:55,360 --> 00:09:57,020
!كم هي جميلة

123
00:09:59,480 --> 00:10:03,660
قد تكون قناديل البحر كائنات
،صغيرة غير مهمّة

124
00:10:04,100 --> 00:10:07,370
.لكن آمل أن تتذكّرنها من وقت لآخر

125
00:10:19,840 --> 00:10:22,400
.قالت كورالينا أنّه منزلها

126
00:10:22,400 --> 00:10:26,140
.يبدو أنّ العيش هنا يعزّز دوافعها الإبداعيّة

127
00:10:26,140 --> 00:10:28,320
.تتكلّمين كفنّانة

128
00:10:28,320 --> 00:10:31,150
.أرى أنّكنّ وصلتنّ سلفًا

129
00:10:31,150 --> 00:10:34,160
!من الرّائع رؤيتكما ثانية يا ابنتيّ

130
00:10:34,160 --> 00:10:35,330
!مرحبًا

131
00:10:35,330 --> 00:10:36,780
!أزوسا

132
00:10:36,780 --> 00:10:42,770
يا أختي العزيزة، شكرًا على دعوتي
!في موعد المتحف الفنّيّ هذا

133
00:10:42,770 --> 00:10:45,540
.كلاّ، إنّه ليس موعدًا

134
00:10:46,930 --> 00:10:49,480
!معرض فنّيّ

135
00:10:49,480 --> 00:10:52,030
يبدو رائعًا! أتعتقدن أنّه يجني الكثير من المال؟

136
00:10:52,320 --> 00:10:55,050
حسنًا، ما قولكنّ أن ندخل فحسب؟

137
00:10:55,050 --> 00:10:58,820
ماما، أتعتقدين أنّنا سنبدو
ظريفات في اللّوحات؟

138
00:10:58,820 --> 00:11:00,480
.يساورني الفضول أيضًا

139
00:11:03,920 --> 00:11:06,540
!هذا مخيف

140
00:11:06,540 --> 00:11:07,930
.ماتت عيوننا

141
00:11:09,840 --> 00:11:12,070
!هالكارا؟! ما الخطب؟

142
00:11:17,020 --> 00:11:20,150
...مهلاً... أليس الشّبح

143
00:11:24,500 --> 00:11:27,370
!ماذا؟! أهو أنا؟

144
00:11:37,800 --> 00:11:40,480
.قناديل البحر شفّافة كما تعلمن

145
00:11:40,480 --> 00:11:44,270
.ثمّة أشياء يمكن رؤيتها فقط لأنّها شفّافة

146
00:11:44,270 --> 00:11:45,090
...نعم

147
00:11:45,430 --> 00:11:48,930
سيّدتي أزوسا، ما هي الحياة بالضّبط؟

148
00:11:48,930 --> 00:11:51,180
!لايكا! تماسكي

149
00:11:51,180 --> 00:11:55,060
.يا أختي العزيزة... لن أظلّ ملك الشّياطين

150
00:11:55,060 --> 00:11:57,480
!ماذا؟! أنت أيضًا؟

151
00:11:57,810 --> 00:12:01,730
...كورالينا، أنا أسألك عن هذا بكلّ صدق

152
00:12:01,730 --> 00:12:04,110
لماذا لوحاتك كئيبة هكذا؟

153
00:12:04,990 --> 00:12:10,740
أنا أرسم الظّلام المخفيّ والفراغ
.اللاّمحدود داخل النّاس

154
00:12:10,740 --> 00:12:11,660
...حسنًا

155
00:12:12,100 --> 00:12:17,880
لذلك سأواصل الانجراف بحثًا
.عن الظّلام، مثل قناديل البحر

156
00:12:17,880 --> 00:12:19,410
.قناديل-ديل-ديل

157
00:12:20,000 --> 00:12:21,470
.ها هي تفعلها ثانية

158
00:12:21,470 --> 00:12:23,090
كيف يعقل هذا؟

159
00:12:24,080 --> 00:12:25,260
ما الأمر؟

160
00:12:26,420 --> 00:12:28,650
.صار الأمر جدّيًّا كثيرًا

161
00:12:29,020 --> 00:12:32,150
.إنّها تبدو مثل أهرامات

162
00:12:32,150 --> 00:12:34,050
...سيّدي بيلزيبب

163
00:12:34,050 --> 00:12:35,300
...هذه

164
00:12:35,300 --> 00:12:38,410
.يا لها من لوحة لا تصدّق عثرنا عليها هنا

165
00:12:38,410 --> 00:12:43,910
عانيتُ في تمثيل جوّ الأطلال
.المنسيّة في تلك اللّوحة

166
00:12:44,430 --> 00:12:46,610
أين رسمتها؟

167
00:12:46,610 --> 00:12:50,650
.في الغابة أسفل جبال غرب نوستومريا

168
00:12:50,650 --> 00:12:53,230
.لا أذكر المكان بالضّبط

169
00:12:53,230 --> 00:12:55,160
بيلزيبب، ما الأمر؟

170
00:12:55,560 --> 00:12:59,110
،هذا هو قبر الحاكمة الأسطوريّة لحضارة قديمة

171
00:12:59,110 --> 00:13:01,880
.مملكة ثارسا ثارسا

172
00:13:07,210 --> 00:13:09,350
إنّ مملكة ثارسا ثارسا

173
00:13:09,350 --> 00:13:12,930
.هي حضارة قديمة ازدهرت قبل 5000 سنة

174
00:13:13,660 --> 00:13:17,360
انطلق العديد من المغامرين بحثًا
،عن هذه الأطلال

175
00:13:17,360 --> 00:13:19,680
.لكن لم يعد أيّ أحد منهم

176
00:13:20,060 --> 00:13:21,800
فعلاً؟

177
00:13:21,800 --> 00:13:25,310
لكن لماذا يأخذ الشّياطين هذا الأمر بجدّيّة؟

178
00:13:25,750 --> 00:13:31,360
إنّ الحضارات القديمة عبارة عن عرائن
،لوحوش مجهولة وأرواح شرّيرة على الأرجح

179
00:13:31,360 --> 00:13:33,830
.لذلك لا بدّ أن يتحرّى الشّياطين أمرها

180
00:13:33,830 --> 00:13:36,700
!ماذا؟! ستتحرّين أرواح شرّيرة؟

181
00:13:36,700 --> 00:13:41,300
نعم. أريدك أن تساعدينا
.في بحثنا هذا يا أزوسا

182
00:13:41,300 --> 00:13:44,810
!كلاّ، كلاّ، كلاّ
!لا يمكنني تحمّل الأشياء المخيفة

183
00:13:44,810 --> 00:13:47,840
!أعرف أنّي لا أستطيع التّعامل مع تلك الأشياء

184
00:13:47,840 --> 00:13:50,350
.فهمت... يا لها من مشكلة

185
00:13:50,690 --> 00:13:55,850
إن كنت معنا، أعلم أنّنا سنكون بأمان
.إن ظهرت أيّ وحوش مجهولة

186
00:13:57,100 --> 00:13:59,360
...لكنّ الأرواح الشّرّيرة

187
00:13:59,360 --> 00:14:01,440
.يمكن اعتبار هذا كتدريب

188
00:14:01,440 --> 00:14:04,530
.سأذهب بدلاً من سيّدتي أزوسا

189
00:14:04,530 --> 00:14:08,540
لايكا... أقدّر لك هذا، لكن لا يمكنك
.الذّهاب هذه المرّة

190
00:14:08,540 --> 00:14:10,950
.هناك احتمال لأن تتعرّضي للعنة

191
00:14:10,950 --> 00:14:12,610
...هكذا إذًا

192
00:14:12,610 --> 00:14:16,840
ماذا؟ ألستِ قلقة عليّ؟

193
00:14:16,840 --> 00:14:18,870
.لأنّي أعلم أنّك ستكونين بخير

194
00:14:20,270 --> 00:14:24,010
.حسنًا، مفهوم. سأذهب
هل أسعدك هذا الآن؟

195
00:14:24,280 --> 00:14:26,120
.هذا يكفيني ما دمتِ تفهمين

196
00:14:26,410 --> 00:14:29,260
أيمكنني الذّهاب أيضًا يا أختي؟

197
00:14:29,550 --> 00:14:31,430
ماذا؟ أنت أيضًا يا روزالي؟

198
00:14:31,430 --> 00:14:35,630
!نعم! أنا شبح، لذلك لا يمكن أن أتعرّض للعنة

199
00:14:35,630 --> 00:14:38,540
!صحيح! ستكونين بخير إذًا

200
00:14:38,540 --> 00:14:40,450
!سأقدّر لك ذلك كثيرًا

201
00:14:49,770 --> 00:14:54,530
يا أختي العزيزة، رافقيني
للحرص ألاّ أضيع، مفهوم؟

202
00:14:54,530 --> 00:14:58,540
...لم يخبرني أحد أنّك سترافقيننا

203
00:14:58,540 --> 00:14:59,550
...وأيضًا

204
00:14:59,550 --> 00:15:02,430
!أليس هذا ممتعًا؟

205
00:15:02,840 --> 00:15:06,160
سنصير غنيّات بسرعة بفضل
!هذه الأطلال القديمة

206
00:15:06,380 --> 00:15:08,920
.لا توفّت أيّ فرصة لجني المال

207
00:15:10,670 --> 00:15:12,050
!ثمّة شيء ما هناك

208
00:15:17,410 --> 00:15:19,810
!أختي العزيزة! أنا خائفة

209
00:15:19,810 --> 00:15:22,060
.وأنا خائفة منك

210
00:15:22,270 --> 00:15:25,070
!ابقين متأهّبات! ثمّة المزيد منهم

211
00:15:27,300 --> 00:15:31,320
!حسنًا، سيكون هذا سهلاً! دعن الأمر لي

212
00:15:31,320 --> 00:15:48,830
!ركلة منخفضة ثقيلة

213
00:15:34,080 --> 00:15:39,130
يا بيلزيبب... تستعمل مُقاسلا
.الركّلة المنخفضة الثّقيلة كثيرًا

214
00:15:39,130 --> 00:15:42,060
أنت معلّمتها، فهل علّمتها ذلك؟

215
00:15:42,060 --> 00:15:48,830
لا، علّمتها فقط كيف تتفادى دفع
.الضّرائب على جوائزها في المنافسات

216
00:15:56,160 --> 00:15:58,850
!أجل! هكذا يُجنى المال

217
00:15:58,850 --> 00:16:02,010
.إنّها كالكتاب المفتوح بالفعل

218
00:16:02,360 --> 00:16:06,380
.آسفة لأنّي لم أكن ذات عون

219
00:16:06,380 --> 00:16:07,770
.لا فائدة منّي

220
00:16:08,150 --> 00:16:09,510
...روزالي

221
00:16:09,510 --> 00:16:11,790
.ليس عليك القلق حيال ذلك

222
00:16:12,060 --> 00:16:15,290
.لا، أنا الوحيدة الّتي لم تستطع فعل أيّ شيء

223
00:16:15,290 --> 00:16:17,870
...لا حول ولا قوّة للأشباح بالفعل

224
00:16:22,710 --> 00:16:23,800
ماذا؟

225
00:16:23,800 --> 00:16:28,080
.بيلزيبب، ثمّة شيء ما غريب في هذه المنطقة

226
00:16:28,080 --> 00:16:31,290
.نعم. يبدو أنّ هذا هو المدخل

227
00:16:31,290 --> 00:16:33,290
.لكنّي لا أرى أيّ شيء

228
00:16:33,590 --> 00:16:35,510
.إنّه حاجز سحريّ

229
00:16:35,510 --> 00:16:37,510
.على الأرجح أنّه من الحضارة القديمة

230
00:16:37,800 --> 00:16:41,400
!في تلك الحالة، لنُبطله في الحال

231
00:16:41,400 --> 00:16:43,050
يمكنك ذلك؟

232
00:16:44,580 --> 00:16:48,990
يا أختي العزيزة، رغم ما هو ظاهر
.عليّ، فأنا أظلّ ملك الشّياطين

233
00:16:49,320 --> 00:16:53,680
...سيلفي لافانا نرولو شوجيلي إيارتشيغ

234
00:16:54,470 --> 00:16:55,690
!يا

235
00:17:00,030 --> 00:17:02,380
.تمّ تطهير الظّلام

236
00:17:03,700 --> 00:17:05,750
.لا شكّ في الأمر الآن

237
00:17:05,750 --> 00:17:07,760
.وجدناها أخيرًا

238
00:17:08,220 --> 00:17:10,970
!إنّها تمامًا كما في لوحة كورالينا

239
00:17:10,970 --> 00:17:13,720
.لكنّها مفعمة بالنّشاط

240
00:17:13,720 --> 00:17:16,050
!ما-ماذا؟! لا تخيفيني

241
00:17:16,050 --> 00:17:18,220
!لا يوجد أحد هنا على الإطلاق

242
00:17:18,220 --> 00:17:21,720
...مهلاً... إن قالت روزالي ذلك

243
00:17:22,080 --> 00:17:23,440
...عدن

244
00:17:23,440 --> 00:17:25,040
...أدراجكنّ

245
00:17:25,040 --> 00:17:27,730
...هذا ليس مكانًا مناسبًا لكنّ

246
00:17:29,600 --> 00:17:31,980
!ثمّة العديد منها هناك بالفعل

247
00:17:31,980 --> 00:17:33,640
!أرواح شرّيرة

248
00:17:33,640 --> 00:17:36,590
.إنّها تتكلّم مباشرة في أذهاننا

249
00:17:36,590 --> 00:17:38,490
!ا-اخرسي

250
00:17:38,490 --> 00:17:41,910
!كلاّ! كلاّ! لا أسمعك! لا أسمعك

251
00:17:41,910 --> 00:17:44,500
!لا أسمع أيّ شيء

252
00:17:44,790 --> 00:17:46,780
!مرحبًا، سررت بلقائك

253
00:17:46,780 --> 00:17:49,490
.أنا شبح واسمي روزالي

254
00:17:49,790 --> 00:17:54,000
.لا داعي للقلق. لا خوف من هؤلاء الفتيات

255
00:17:54,000 --> 00:17:55,550
روزالي؟

256
00:17:55,870 --> 00:17:57,790
!ماذا؟ فعلاً؟

257
00:17:57,790 --> 00:17:59,830
،حسنًا، آسفة على السّؤال
ولكن هلاّ سمحت؟

258
00:18:00,580 --> 00:18:03,550
،تحدّثت مع إحدى الأرواح الشّرّيرة للتّوّ

259
00:18:03,550 --> 00:18:06,300
.وذهبت لإحضار من تمثّلها

260
00:18:06,300 --> 00:18:09,630
ماذا؟ استطعت التّواصل معها؟

261
00:18:09,630 --> 00:18:12,570
.ممتاز، يبدو أنّ هذا سيكون مسالمًا
.هذا جيّد جدًّا

262
00:18:12,840 --> 00:18:16,080
أنت من تمثّلين الأرواح هنا إذًا؟

263
00:18:16,410 --> 00:18:17,420
...نعم

264
00:18:18,450 --> 00:18:20,510
.فهمت، فهمت

265
00:18:20,510 --> 00:18:24,590
،ما دمنا لسنا هنا لسرقة القبور
.فستظهر نفسها

266
00:18:24,590 --> 00:18:27,220
—بالطّبع ما كنّا لنقوم بأيّ شيء كـ

267
00:18:27,220 --> 00:18:29,570
...عفوًا، لن أسرق أيّ شيء، لكن

268
00:18:29,570 --> 00:18:33,220
إن أعطتني شيئًا بإمكاني بيعه
.مقابل ثورة، فسيكون ذلك رائعًا

269
00:18:33,220 --> 00:18:35,090
!ولا كلمة أخرى

270
00:18:35,090 --> 00:18:38,580
.يبدو أنّها تدرك أنّنا لسنا أشخاصًا سيّئين

271
00:18:38,580 --> 00:18:40,890
.قالت أنّها ستكشف عن نفسها الآن

272
00:18:40,890 --> 00:18:42,460
تكشف عن نفسها؟

273
00:18:52,200 --> 00:18:53,820
.حسنًا، إنّ أعدادها كثيرة بالفعل

274
00:18:53,820 --> 00:18:56,740
!لا أستطيع! أريد العودة للمنزل

275
00:18:56,740 --> 00:18:58,540
.ألتمس منكنّ العذر

276
00:18:58,540 --> 00:19:01,940
أنا رئيسة الخادمات ووزيرة
،صاحبة الجلالة موم موم

277
00:19:01,940 --> 00:19:04,340
.حاكمة مملكة ثارسا ثارسا

278
00:19:04,340 --> 00:19:06,250
.اسمي نانا نانا

279
00:19:06,700 --> 00:19:08,050
خادمات؟

280
00:19:08,050 --> 00:19:09,750
،منذ نحو خمسة آلاف عام

281
00:19:09,750 --> 00:19:13,670
،اجتاح وباء مملكة ثارسا ثارسا

282
00:19:13,670 --> 00:19:16,250
.وقضى على جميع سكّانها

283
00:19:16,750 --> 00:19:21,010
تحوّل أولئك الّذين لم يتقبّلوا
،هذا المصير إلى أرواح شرّيرة

284
00:19:21,330 --> 00:19:25,710
ونحن الآن نستمتع بقضاء الأبديّة
.في هذه المملكة الميتة

285
00:19:26,840 --> 00:19:32,140
ولكن لماذا وضعتنّ حاجزًا لإخفاء أنفسكنّ؟

286
00:19:32,140 --> 00:19:36,490
كما يُقال، العزلة ليست سبيلاً
.لبقاء أيّ أمّة في هذا العصر

287
00:19:37,000 --> 00:19:41,150
...أودّ فتح البلاد أكثر، ولكن

288
00:19:41,150 --> 00:19:45,400
لماذا لا نبدأ بإقامة علاقات
دبلوماسيّة مع مملكة الشّياطين؟

289
00:19:45,650 --> 00:19:48,490
،أقدّر عرضكنّ القيّم هذا

290
00:19:49,310 --> 00:19:51,170
...ولكنّ صاحبة الجلالة موم موم

291
00:19:51,170 --> 00:19:53,910
لا تحبّ هذه الفكرة؟

292
00:19:54,180 --> 00:19:56,350
...لا، في الحقيقة

293
00:19:57,290 --> 00:19:58,920
!إنّها منعزلة؟

294
00:19:59,440 --> 00:20:00,600
.نعم

295
00:20:00,600 --> 00:20:05,570
ظلّت جلالتها منعزلة في غرفتها
.طوال 2000 عام الآن

296
00:20:06,280 --> 00:20:10,190
ولهذا السّبب لا يمكنكنّ الحصول
على إذن لإقامة علاقات دبلوماسيّة؟

297
00:20:10,550 --> 00:20:12,190
.بالضّبط

298
00:20:12,190 --> 00:20:14,390
ولكن لماذا؟

299
00:20:14,390 --> 00:20:17,580
.تواجه صاحبة الجلالة مشكلة كبيرة

300
00:20:17,580 --> 00:20:20,230
.إنّها ما يُسمّى الدّوران في حلقة مفرغة

301
00:20:23,380 --> 00:20:26,890
!لا واحدة منكنّ تعرف معنى المرح
!أشعر بالملل

302
00:20:26,890 --> 00:20:29,370
لا أريد رؤية وجوهكنّ حتّى
!تعرفن ما هو المرح

303
00:20:31,110 --> 00:20:34,750
قالت أنّ لا أصدقاء لها
يتشاركونها نفس الاهتمامات

304
00:20:34,750 --> 00:20:37,870
.وحبست نفسها داخل قبرها

305
00:20:37,870 --> 00:20:39,890
ذلك هو السّبب؟

306
00:20:39,890 --> 00:20:43,750
.لم يدخل أيّ أحد قبرها مذّاك الحين

307
00:20:43,750 --> 00:20:49,900
.لا يمكننا الاقتراب لأنّها تهاجمنا بسحرها

308
00:20:49,900 --> 00:20:53,830
فهمت! إذًا نحتاج لرؤيتها
والتّحدّث إليها فحسب، صحيح؟

309
00:20:53,830 --> 00:20:56,160
!سنقوم بذلك إذًا

310
00:20:56,160 --> 00:20:58,460
.لكنّ ذلك سيكون خطيرًا

311
00:20:58,460 --> 00:20:59,910
!سنكون بخير

312
00:20:59,910 --> 00:21:02,040
توافقن على هذا، صحيح؟

313
00:21:02,390 --> 00:21:05,610
حسنًا، سيكون كلّ شيء
.بلا فائدة الآن إن عدنا أدراجنا

314
00:21:06,160 --> 00:21:08,190
ستذهبن بالفعل؟

315
00:21:08,190 --> 00:21:10,790
!نعم! لا داعي للقلق

316
00:21:11,160 --> 00:21:17,920
قد نتمكّن أيضًا من حلّ مشكلة عدم
.وجود أصدقاء يشاركونها اهتماماتها

317
00:21:17,920 --> 00:21:18,540
صحيح؟

318
00:21:18,540 --> 00:21:20,420
ماذا؟ تقصدينني أنا؟

319
00:21:20,810 --> 00:21:21,910
!نعم

320
00:21:24,640 --> 00:21:28,520
.في تلك الحالة، سأذهب لتحضير قبوركنّ

321
00:21:28,520 --> 00:21:30,770
.لا تتهاونّ على الإطلاق

322
00:21:30,770 --> 00:21:32,930
!كلامك هذا شديد التّشاؤم

323
00:21:34,040 --> 00:21:35,950
!حسنًا، هيّا بنا جميعًا

324
00:21:36,320 --> 00:21:38,820
!لرؤية صاحبة الجلالة

325
00:23:10,430 --> 00:23:12,400
!أيّام في المرتفعات

326
00:23:12,690 --> 00:23:14,160
!البحر

327
00:23:14,160 --> 00:23:15,900
!الشّمس

328
00:23:17,660 --> 00:23:19,670
!رمال الشّاطئ

329
00:23:19,670 --> 00:23:21,670
!أزياء السّباحة

330
00:23:21,670 --> 00:23:24,170
!كلاّ! لا تخلعيها

331
00:23:24,470 --> 00:23:25,910
!الجزء 2

332
00:23:27,910 --> 00:23:29,940
متجر هدايا؟

333
00:23:30,610 --> 00:23:33,430
!هذه ظريفة

334
00:23:36,390 --> 00:23:38,320
هل منحتك مشاعر سلبيّة؟

335
00:23:38,320 --> 00:23:39,510
!أليس ذلك واضحًا؟