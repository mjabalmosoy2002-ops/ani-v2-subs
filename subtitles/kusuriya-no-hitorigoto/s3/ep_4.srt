1
00:00:06,400 --> 00:00:13,530
مُذكّرات الصّيدلانيّة

2
00:00:06,400 --> 00:00:13,530
مُذكّرات الصّيدلانيّة

3
00:01:30,990 --> 00:01:33,990
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

4
00:01:51,570 --> 00:01:53,470
انتظرنا وصولك بلهفة

5
00:02:06,480 --> 00:02:10,480
الحلقة 52: المُجلّد الأخير

6
00:02:08,980 --> 00:02:10,940
هل انتهيت من تبديل ملابسكِ؟

7
00:02:11,240 --> 00:02:12,140
أجل

8
00:02:15,160 --> 00:02:16,200
تفضّلي من هنا

9
00:02:21,510 --> 00:02:23,590
مُدهش. كان هذا قصر الإمبراطور
في نهاية المطاف

10
00:02:23,590 --> 00:02:27,800
إنّه الآن منزل لعضوة سابقة
من السّيّدات الأربع

11
00:02:29,910 --> 00:02:31,280
لقد جاءت

12
00:02:32,610 --> 00:02:33,630
أهلاً وسهلاً

13
00:02:33,960 --> 00:02:36,180
لم أركِ منذ وقت طويل، مولاتي آدو

14
00:02:36,710 --> 00:02:39,170
إذاً لديكِ عمل معها اليوم؟

15
00:02:39,170 --> 00:02:39,890
أجل

16
00:02:40,350 --> 00:02:44,780
،سويري هي حفيدة الإمبراطور الرّاحل
لكنّها قريبةٌ من عشيرة شي أيضاً

17
00:02:45,570 --> 00:02:48,260
لم تعُد قادرة على الظّهور للعلَن بعد الآن

18
00:02:48,260 --> 00:02:51,320
غالباً ستعيش بقيّة حياتها في الأسر

19
00:02:51,900 --> 00:02:54,070
ماذا تنوي أن تفعل من الآن فصاعداً؟

20
00:02:54,070 --> 00:02:56,270
ماذا سيفعل الإمبراطور معها؟

21
00:02:56,270 --> 00:02:59,760
،لا أملك فكرة، لكن نظراً إلى مهارتها كصيدلانيّة

22
00:02:59,760 --> 00:03:02,550
سيكون من الهدر بقاؤها مُتوارية
عن الأنظار هكذا

23
00:03:02,550 --> 00:03:06,500
،سأبقى هنا، لكن تجاهليني
وأكملا الحديث بينكما

24
00:03:06,500 --> 00:03:08,190
عُلِم. شكراً لكِ

25
00:03:12,400 --> 00:03:15,940
...من الصّعب تجاهلها، لكن

26
00:03:19,520 --> 00:03:21,880
هل تتذكّرين هذه؟

27
00:03:24,700 --> 00:03:26,850
تمّ استخدامها بواسطة مُعلّمي

28
00:03:27,310 --> 00:03:28,730
أهذه هي السّلسلة بأكملها

29
00:03:29,380 --> 00:03:30,860
هناك واحدٌ ناقص

30
00:03:31,220 --> 00:03:34,110
أعتقد كانوا خمسة عشر كِتاباً

31
00:03:34,620 --> 00:03:37,490
هل تملكين فكرة عن مكان المُجلّد الأخير المُتبقّي؟

32
00:03:38,860 --> 00:03:39,990
لا، لا فكرة لديّ

33
00:03:40,520 --> 00:03:42,740
لا يبدو أنّها تكذب

34
00:03:42,740 --> 00:03:45,380
بصرف النّظر، لا تملك سبباً لذلك

35
00:03:45,380 --> 00:03:49,430
إذاً "مُعلّمكِ" هذا، أين هو الآن؟

36
00:03:51,260 --> 00:03:53,250
إنّه حيّ، أليس كذلك؟

37
00:03:55,510 --> 00:03:58,260
...جرعة الانبعاث الّتي استخدمتِها

38
00:03:58,260 --> 00:04:01,730
اختبرَها على نفسه، أليس كذلك؟

39
00:04:03,550 --> 00:04:05,060
هذا صحيح

40
00:04:05,430 --> 00:04:09,720
لو لم يفعل، لما تمكّنَ أبداً
أن يهرب من ذلك الحصن

41
00:04:10,310 --> 00:04:14,940
لكن غالباً ما كان ليستطيع الإجابة عن أسئلتكِ

42
00:04:15,260 --> 00:04:17,040
ماذا تقصدين؟

43
00:04:17,040 --> 00:04:21,070
كيو-يو... أقصد. اسمه الجديد
تشو-يو على ما أعتقد

44
00:04:21,510 --> 00:04:25,920
فقدَ ذاكرته وهو مشلول من طرف واحد

45
00:04:25,920 --> 00:04:27,920
هل هذا يمنحكِ أي لمحة؟

46
00:04:27,920 --> 00:04:30,580
تقولين بأنّه فقدَ ذاكرته؟

47
00:04:31,100 --> 00:04:34,000
هذا مُختلف قليلاً، لكنّه مُشابه

48
00:04:34,590 --> 00:04:38,240
في الواقع، لعلّكِ مررتِ بجانبه دون مُلاحَظة

49
00:04:38,640 --> 00:04:40,510
ماذا تقصدين؟

50
00:04:41,170 --> 00:04:43,390
هل تتذكّرين مُنتجع النّبع السّاخن؟

51
00:04:44,180 --> 00:04:45,260
أجل

52
00:04:45,780 --> 00:04:48,960
القرية المخفيّة الّتي تعبد الثّعلب

53
00:04:49,640 --> 00:04:53,900
مُعلّمي هو أحد العجائز طريحي
الفِراش المُتواجدين هناك

54
00:04:54,980 --> 00:04:57,780
كان ذلك المكان يُستخدَم كمصحّة
نبع ساخن للاستشفاء

55
00:04:58,080 --> 00:05:02,720
،أدخلَتْه إلى هناك خِلسة كأحد المرضى
لإخفائه عن شينمي

56
00:05:03,360 --> 00:05:07,200
إنّه لا يتذكّر مَن يكون بعد الآن

57
00:05:07,200 --> 00:05:08,870
،لو كان بحالٍ جيّدة

58
00:05:10,140 --> 00:05:15,400
لما كانت قد فكّرتْ أن تدعكِ تتدخّلين في الحادثة

59
00:05:16,210 --> 00:05:18,210
لا بُدّ أنّ سويري قد لاحظتْ

60
00:05:19,010 --> 00:05:21,030
فعلتْ شيسوي كُلّ ذلك للعمل مع والدها

61
00:05:21,030 --> 00:05:24,350
للكشف عن الشّرور المخفيّ في هذه الدّولة

62
00:05:24,640 --> 00:05:28,600
ولتحرير أختها من أمّها

63
00:05:29,520 --> 00:05:32,150
،لو كان مُعلّم سويري مُتاحاً

64
00:05:32,150 --> 00:05:36,270
لما اضطرّتا أن تأخذاني إلى ذلك الحصن

65
00:05:37,110 --> 00:05:39,610
لا طرف خيط على ما أعتقد

66
00:05:39,610 --> 00:05:42,740
وأنا الّتي ظننتُ بأنّني حصلتُ
على شيء أخيراً

67
00:05:43,130 --> 00:05:48,080
في تلك الحالة، هل تعرفين شيئاً
عن الجراد الّذي كان يدرسه؟

68
00:05:48,870 --> 00:05:51,860
لم أكن مُشارِكة في ذلك البحث

69
00:05:51,860 --> 00:05:53,620
...لستُ عليمة بالحشرات

70
00:05:53,620 --> 00:05:57,040
كان ذلك مجال اختصاصها هي

71
00:05:58,630 --> 00:06:00,170
فهمت

72
00:06:00,590 --> 00:06:03,720
و"هي" لم تعُد معنا

73
00:06:05,540 --> 00:06:08,390
،عندما أُمِرنا بصنع جرعة الخلود

74
00:06:08,690 --> 00:06:12,420
دمّروا مُعظم مواد البحث

75
00:06:12,420 --> 00:06:15,400
مُحتويات تلك الغرفة هي تقريباً كُلّ ما تبقّى

76
00:06:15,820 --> 00:06:18,850
،لكن المُعلّم، رغبةً منه في مُتابعة دراساته

77
00:06:18,850 --> 00:06:24,900
استخدمَ حارسه سازين لإجراء البحث. فهمت

78
00:06:25,320 --> 00:06:29,120
،هذه الفتاة الّتي تتحدّثين عنها باستمرار
لا بُدّ أنّها كانت ذكيّة جدّاً

79
00:06:30,010 --> 00:06:33,330
مهما كانت ذكيّة... لم تعُد معنا

80
00:06:37,640 --> 00:06:42,210
إذاً، إن كانت ذكيّة، فهل كانت لتذهب
دون ترك أثَر خلفها؟

81
00:06:47,670 --> 00:06:49,580
أ-أنا آسفة

82
00:06:49,580 --> 00:06:51,930
لا تقلقي. استرخي

83
00:06:51,930 --> 00:06:53,940
لا أحبُّ الرّسميّات على أيّ حال

84
00:06:54,520 --> 00:06:59,190
انظري إليها. إنّها غارقة في التّفكير، دون
إلقاء اعتبار لآداب السّلوك

85
00:06:59,520 --> 00:07:03,070
لا، أتفهّم بأنّه كان يُفترض بي
أن أعتذر حينها

86
00:07:03,500 --> 00:07:07,750
...إذا تركتْ شيسوي أثراً خلفها
فأين سيكون؟

87
00:07:11,870 --> 00:07:12,660
الحصن؟

88
00:07:13,700 --> 00:07:14,540
القصر الخلفيّ؟

89
00:07:15,730 --> 00:07:16,670
المكتب الطبّيّ؟

90
00:07:18,030 --> 00:07:19,340
لا

91
00:07:20,990 --> 00:07:22,170
...هذه

92
00:07:28,200 --> 00:07:29,470
...العيادة

93
00:07:29,700 --> 00:07:30,930
!العيادة

94
00:07:32,640 --> 00:07:34,900
،قُبيل الاختطاف من القصر الخلفيّ

95
00:07:34,900 --> 00:07:37,600
رأيتُ كِتابَ الحشرات هناك

96
00:07:37,600 --> 00:07:40,110
...شيسوي، أنتِ

97
00:07:43,760 --> 00:07:45,740
!ماكرة جدّاً

98
00:07:49,090 --> 00:07:50,240
هذا هو، صحيح؟

99
00:07:50,980 --> 00:07:52,200
شكراً لك

100
00:07:52,830 --> 00:07:57,800
عندما اختُطِفتِ، صادرنا كُلَّ شيء في العيادة

101
00:07:58,110 --> 00:07:59,800
وكان هذا جزءاً ممّا صادرناه

102
00:07:59,800 --> 00:08:00,710
فهمت

103
00:08:01,510 --> 00:08:04,370
كانت العيادة قد أُغلِقَتْ بشكل مُؤقّت

104
00:08:04,700 --> 00:08:08,220
شينلو، العامِلة الّتي ساهمت
،في الهرب من القصر الخلفيّ

105
00:08:08,220 --> 00:08:14,900
حاولت الانتحار ونجت، وسُجِنت لجرائمها الخطيرة

106
00:08:22,030 --> 00:08:23,320
هذا هو

107
00:08:25,310 --> 00:08:27,530
هل كُلّ هذه رسوم لجنادِب؟

108
00:08:27,530 --> 00:08:29,720
أجل، صحيح

109
00:08:29,720 --> 00:08:31,720
،وفقاً للأوصاف في الصُّور

110
00:08:31,720 --> 00:08:35,490
،يمكن فصلها إلى نوعين رئيسيّين
أو ثلاثة أنواع فرعيّة

111
00:08:35,900 --> 00:08:39,140
هذه جنادِب عاديّة

112
00:08:39,140 --> 00:08:40,710
،تُوضّحها الرّسوم على شكل أجزاء

113
00:08:40,710 --> 00:08:43,340
لكن يبدو أنّ هذا لديه أجنحة أقصر

114
00:08:43,820 --> 00:08:47,780
وهذا هو النّوع الّذي نتوقّع رؤيته
أكثر في هذا العام

115
00:08:47,780 --> 00:08:50,740
يبدو أنّ هذا هو النّوع الّذي
يُسبّب وباءَ الجراد

116
00:08:51,650 --> 00:08:55,350
اللّون بنّي بدلاً من أخضر

117
00:08:55,990 --> 00:08:57,680
لدى هذا أجنحة أطول أيضاً

118
00:08:59,030 --> 00:09:04,150
وهذا هو النّوع الّذي سبّبَ وباءَ الجراد
الصّغير في العام الماضي

119
00:09:04,570 --> 00:09:09,150
إذاً، إنّها تتحوّل إلى هذه الجنادِب
البنّية تدريجيّاً مع الوقت

120
00:09:09,620 --> 00:09:11,070
هكذا يبدو

121
00:09:13,070 --> 00:09:18,080
تُغيّر الجنادبُ لونَ جسدها وشكلها
عندما تُستوفَى شروط مُعيّنة

122
00:09:18,410 --> 00:09:22,480
،تطرأ التغيُّرات على مدى أجيال عديدة
وتتزايد أعدادها مع تغيّرها

123
00:09:22,960 --> 00:09:25,500
،هل التّكاثر يُسبّب تغيُّر الشّكل

124
00:09:25,500 --> 00:09:28,160
أم أنّ تغيُّر الشّكل يُسبّب التّكاثُر

125
00:09:28,560 --> 00:09:32,590
وفقاً للكتاب، الاحتمال الأوّل هو الأرجح

126
00:09:32,890 --> 00:09:39,040
بعبارة أُخرى، وباء جراد صغير يسبق
وباءَ جراد أكبر

127
00:09:40,170 --> 00:09:44,350
لذا ينبغي أن نتوقّع وباءَ جراد أكبر
في هذا العام

128
00:09:44,950 --> 00:09:48,320
أجل. لا أعرف كم سيكون حجمه بالضّبط

129
00:09:48,790 --> 00:09:52,320
هل موصوف في مكان ما كيفيّة درء ذلك؟

130
00:09:55,320 --> 00:09:57,070
لا

131
00:09:57,070 --> 00:10:01,650
،مكتوب أنّه حالما تُلاحَظ الأضرار
،يجب علينا القضاء على اليرقة

132
00:10:01,650 --> 00:10:03,700
لكن الطّريقة الوحيدة تتطلّب الكثير
من الأيدي العاملة

133
00:10:03,700 --> 00:10:08,190
،مكتوب أيضاً أنّهم إذا نموا حتّى مرحلة النّضوج
...فينبغي أن نضرم ناراً، لكن

134
00:10:08,630 --> 00:10:10,920
هذه هي الطّريقة التّقليديّة فحسب

135
00:10:11,520 --> 00:10:15,220
هناك أيضاً وصفة لمُبيد حشرات

136
00:10:17,390 --> 00:10:21,480
أنا آسفة. لا يوجد الكثير من الفائدة هنا

137
00:10:21,480 --> 00:10:25,400
لا، معلومات مُبيد الحشرات كانت قيّمة

138
00:10:26,110 --> 00:10:28,360
لنجمع المُكوّنات الآن

139
00:10:29,920 --> 00:10:34,240
هذه هي خريطة المنطقة الّتي
تقع فيها أوبئة الجراد

140
00:10:35,250 --> 00:10:37,030
هل تلاحظين شيئاً؟

141
00:10:37,480 --> 00:10:39,330
ألاحظ شيئاً؟

142
00:10:40,070 --> 00:10:44,330
هل هناك ضرر أكبر في السُّهول لأنّ
الجنادِب تنمو بشكل أسهل هناك؟

143
00:10:44,330 --> 00:10:51,760
غالباً. لكن لم تشهد هذه المنطقة
وباء جراد خطير منذ عقود

144
00:10:53,990 --> 00:10:55,340
...الغابة

145
00:10:55,620 --> 00:10:59,350
،كنتُ لأعتقد أنّه لو كانت توجد غابة قريبة
لأكلت الطّيورُ الجنادب

146
00:10:59,860 --> 00:11:03,970
كانت منطقة شيهوكو-شو مشهورة
،بغاباتها الكثيفة

147
00:11:03,970 --> 00:11:06,980
لكن هذه المنطقة قاحلة غالباً الآن

148
00:11:07,910 --> 00:11:11,440
في فترة الإمبراطور الرّاحل، تمّ فرض
قيود صارمة على تقطيع الأشجار

149
00:11:12,010 --> 00:11:16,200
بعد وفاته، بدأتْ عشيرةُ شي
بتجاهُل تلك القيود

150
00:11:16,950 --> 00:11:22,080
فترة الإمبراطور الرّاحل... لا بُدّ أنّ
الإمبراطورة مَن حظرتْ ذلك

151
00:11:22,400 --> 00:11:25,440
رُبّما هناك حشرات أكثر نظراً لقلّة الطّيور

152
00:11:25,440 --> 00:11:26,920
بسبب تقطيع الأشجار؟

153
00:11:27,570 --> 00:11:29,640
هذا مُمكنٌ جدّاً

154
00:11:30,420 --> 00:11:34,130
كنتُ قد عقدتُ آمالاً كبيرة على موارد
...غابة شيهوكو-شو

155
00:11:34,700 --> 00:11:35,980
فهمت

156
00:11:35,980 --> 00:11:38,140
كان يحاول التّعويض عن نقص الحبوب

157
00:11:38,140 --> 00:11:41,470
ببيع خشب وشراء طعام

158
00:11:41,840 --> 00:11:46,150
قد تنفد المُكوّنات لدينا لأجل المُبيد
الحشريّ المذكور في الكتاب

159
00:11:46,150 --> 00:11:48,480
سأحضّر وصفات أُخرى كذلك، من باب الحيطة

160
00:11:48,880 --> 00:11:50,270
أجل، من فضلكِ

161
00:11:50,840 --> 00:11:55,930
هل يمكننا حرق المناطق الّتي
رُصِدتْ فيها يرقات؟

162
00:11:55,930 --> 00:11:57,460
بحسب المنطقة

163
00:11:57,880 --> 00:12:01,990
أيضاً... منع صيد العصافير سيُساهم قليلاً

164
00:12:02,240 --> 00:12:04,570
العصافير هي مصدر طعام شائع

165
00:12:05,000 --> 00:12:07,660
إذا حظرناه فجأة، فسوف نلقى
ردود فعل سلبيّة

166
00:12:07,660 --> 00:12:09,100
...إن كان هناك طريقة بديلة

167
00:12:10,110 --> 00:12:15,010
ما رأيك أن نبتكر وصفة جنادب ونطلق
عليها اسم طعام ملكيّ؟

168
00:12:17,150 --> 00:12:21,100
سيصطاد مزيدٌ من النّاس الجنادبَ
،لتسليمه للقصر

169
00:12:21,100 --> 00:12:23,680
...وسينتشر من القصر إلى العامّة أيضاً

170
00:12:25,240 --> 00:12:28,980
هذا الشّخص... هل ينبغي أن أطعمه
بقايا الجندُب المشويّ؟

171
00:12:31,560 --> 00:12:34,660
هل يمكننا ترك ذلك كملاذ أخير؟

172
00:12:34,660 --> 00:12:37,610
حسناً، لن نُواجه مُشكلة إذا لم نرَ
عدداً كبيراً منه

173
00:12:39,310 --> 00:12:40,320
معكِ حقّ

174
00:12:41,190 --> 00:12:43,640
يبدو أكثر تفاؤلاً الآن

175
00:12:43,640 --> 00:12:46,920
لكن هل مذاقه سيّئ إلى هذا الحدّ حقّاً؟

176
00:12:49,500 --> 00:12:51,040
المعذرة يا مولايّ جينشي

177
00:12:51,330 --> 00:12:52,580
ما-ماذا؟

178
00:12:53,010 --> 00:12:57,090
هل ترغب في تناول وجبة معنا
قبل أن تُغادر؟

179
00:13:11,600 --> 00:13:13,900
استمتع من فضلك يا مولايّ جينشي

180
00:13:24,740 --> 00:13:27,310
افتح فمك

181
00:13:28,630 --> 00:13:30,210
أعتقد بأنّ هذا يكفي

182
00:13:36,190 --> 00:13:41,610
كنتُ سأدعه وشأنه لو شعرتُ بأنّه
...مستاء ولو قليلاً، لكن هذا الرّجل

183
00:13:44,390 --> 00:13:45,430
عصيدة

184
00:13:45,840 --> 00:13:46,660
حسناً

185
00:13:50,320 --> 00:13:51,350
من فضلك

186
00:13:53,340 --> 00:13:54,860
لِمَ لا يتناوله؟

187
00:13:55,710 --> 00:13:57,980
ألا يُعجبه مُحتواه؟

188
00:14:24,900 --> 00:14:27,470
...ربّما كان ذلك صادماً جدّاً بالنّسبة لأطفال

189
00:14:29,170 --> 00:14:31,680
نمش، سآخذ زولين بعيداً

190
00:14:32,340 --> 00:14:35,690
وأيضاً يا رجل، يجب عليك تحمُّل
مسؤوليّة تصرّفاتك

191
00:14:39,290 --> 00:14:41,100
أعتقد كانت تلك غلطتي

192
00:14:51,410 --> 00:14:52,260
هيّا

193
00:14:53,760 --> 00:14:56,000
هل هو طفل رضيع؟

194
00:15:03,820 --> 00:15:05,750
نمش

195
00:15:07,070 --> 00:15:08,440
من أين حصلت على هذه الورقة؟

196
00:15:08,440 --> 00:15:11,060
أعطتْني إيّاها العجوز

197
00:15:11,060 --> 00:15:13,430
تلك البخيلة أعطتْك شيئاً بالمجّان؟

198
00:15:13,770 --> 00:15:15,890
ما الّذي تخطِّط له الآن؟

199
00:15:16,220 --> 00:15:18,340
على أيّ حال، اجلسي

200
00:15:18,340 --> 00:15:19,400
لماذا؟|

201
00:15:19,400 --> 00:15:22,230
ماوماو! استمعي إلى ما لدى تشو-يو من قول

202
00:15:22,580 --> 00:15:24,490
وستنامين هنا اللّيلة

203
00:15:24,490 --> 00:15:27,210
أعدننا لكِ سريراً بالفعل في تلك
الغرفة الأُخرى

204
00:15:27,210 --> 00:15:28,860
ما الخطب يا عجوز؟

205
00:15:28,860 --> 00:15:31,860
هل ذلك العرض الغريب الّذي قدّمتُه
قبل قليل دفعكِ للجنون؟

206
00:15:31,860 --> 00:15:32,580
!مؤلم

207
00:15:32,580 --> 00:15:34,450
!اصمتي وافعلي ما أُمليه عليكِ فحسب

208
00:15:35,080 --> 00:15:36,960
...مُريبٌ جدّاً

209
00:15:47,010 --> 00:15:48,810
...هذا مُريبٌ للغاية

210
00:15:49,600 --> 00:15:52,340
نمش، صِفي نوعيّة الشّاب الّذي تحبّينه

211
00:15:52,340 --> 00:15:55,060
مثلاً "طويل"، "مفتول العضلات". وما شابه

212
00:15:55,510 --> 00:15:56,940
!يا للإزعاج

213
00:15:57,350 --> 00:15:58,140
ماذا؟

214
00:15:59,700 --> 00:16:01,730
لا أحبّه ضخماً جدّاً

215
00:16:04,160 --> 00:16:06,950
مليء أفضل من نحيل

216
00:16:06,950 --> 00:16:08,130
لحية؟

217
00:16:08,130 --> 00:16:09,540
لا أعارض ذلك

218
00:16:09,540 --> 00:16:10,820
شكل الوجه؟

219
00:16:11,190 --> 00:16:13,910
ناعم أفضل من حادّ

220
00:16:14,510 --> 00:16:16,640
ولا أتمنّى عينَين ماكرتين كعينَي الثّعلب

221
00:16:16,640 --> 00:16:18,640
!ماوماو

222
00:16:18,640 --> 00:16:19,710
امسح ذلك

223
00:16:19,710 --> 00:16:22,240
حاجبان هابطان رُبّما؟

224
00:16:22,240 --> 00:16:23,380
أجل، الأمر عائد لك

225
00:16:25,880 --> 00:16:27,440
أعتقد هذا هو إذاً

226
00:16:29,930 --> 00:16:32,420
يبدو شاحباً بعض الشّيء

227
00:16:32,420 --> 00:16:34,710
يبدو ساذجاً بالنّسبة لي

228
00:16:34,710 --> 00:16:36,510
مُقرف! أرفض هذا تماماً

229
00:16:37,820 --> 00:16:39,320
ما الخطب؟

230
00:16:39,320 --> 00:16:42,030
يبدو كشخص أعرفه

231
00:16:42,030 --> 00:16:43,190
ماذا كان شكله؟

232
00:16:43,700 --> 00:16:45,810
يُشبه طبيب القصر الخلفيّ

233
00:16:47,190 --> 00:16:49,100
هذا مُملّ

234
00:16:49,100 --> 00:16:50,880
هيّا، لنذهب

235
00:16:50,880 --> 00:16:52,820
حان وقت الاستحمام

236
00:17:09,640 --> 00:17:12,890
أتفهّم مشاعركِ بطريقة ما

237
00:17:13,340 --> 00:17:14,690
جوكا

238
00:17:16,010 --> 00:17:19,930
الرّجال كائنات مُتقلّبة، لا تعلمين
متى يتغيّرون

239
00:17:20,860 --> 00:17:24,260
هذا صحيحٌ بالذّات بالنّسبة للرّجال
ذوي النّفوذ

240
00:17:28,990 --> 00:17:32,530
لو كنت تمتلكين شخصيّة بايرين، لما منعتُكِ

241
00:17:32,530 --> 00:17:34,660
إنّها فاتنة حقيقيّة

242
00:17:35,390 --> 00:17:38,540
لكنّكِ يا ماوماو مُختلفة

243
00:17:38,540 --> 00:17:41,540
،فإن كان عليّ إجراء مُقارنة
فأنتِ أقرب إليّ

244
00:17:43,750 --> 00:17:46,700
كُلّ رجلٍ يتغيّر ميوله بين الحين والآخر

245
00:17:46,700 --> 00:17:49,750
خلال فترة عملي هنا، أمسى
هذا واضحاً بصورة مُؤلمة

246
00:17:49,750 --> 00:17:51,880
ما الجدوى من التّصديق؟

247
00:17:57,510 --> 00:18:01,430
في نهاية المطاف، أنا مومس، وأنتِ ابنة مومس

248
00:18:03,870 --> 00:18:05,560
ألا تُسرفين في التّدخين؟

249
00:18:05,850 --> 00:18:07,610
لا مُشكلة، نادراً ما أفعل هذا

250
00:18:07,610 --> 00:18:12,570
فأولئك البيروقراطيّون المُحافِظون
يكرهون رؤية النّساء يُدخنَّ الغليون

251
00:18:21,790 --> 00:18:24,790
سمعتُ من زبون في الأمس بأنّ هناك
فتاة تشبه السّاحرات

252
00:18:25,130 --> 00:18:30,090
أكثر ندرة من أميرات بيت الزنجار الثّلاث

253
00:18:30,520 --> 00:18:34,720
أولئك المسؤولون رفيعو الشّأن يحبّون
الغريبات المُميّزات حقّاً

254
00:18:34,720 --> 00:18:38,260
أجل، أجل، نحن كبِرنا ولم نعُد ذوات قيمة

255
00:18:38,620 --> 00:18:42,040
!لا أصدِّق بأنّهم كانوا يُعاملوننا كمُجوهرات

256
00:18:42,040 --> 00:18:43,280
أجل، أجل

257
00:18:43,860 --> 00:18:46,730
خطأ. بل أكثر من مُجوهرات{?}

258
00:18:53,480 --> 00:18:57,760
برؤيتهن هكذا، أشعر وكأنّهن
ما زلنَ في قمّة أدائهن

259
00:18:57,760 --> 00:19:01,910
وفقاً للرّوايات، تتمتّع السّاحرة بشعر أبيض نقيّ

260
00:19:01,910 --> 00:19:03,330
وعينين حمراوتين أيضاً

261
00:19:03,710 --> 00:19:05,460
هذا نادرٌ جدّاً

262
00:19:05,460 --> 00:19:07,420
مهقاء إذاً

263
00:19:07,820 --> 00:19:09,380
غالباً

264
00:19:14,580 --> 00:19:18,640
هو شخص نادر جدّاً يمكن أن يُولَد بلا لون

265
00:19:18,970 --> 00:19:21,130
عيناه حمراوتان أيضاً لأنّه يمكنك
رؤية الدّم حتّى

266
00:19:21,130 --> 00:19:23,100
—يُطلَق عليها بالمهقاء

267
00:19:23,660 --> 00:19:26,960
،شعرهم وبشرتهم بيضاء ناصعة
لكنّهم وُلِدوا بهذا الشّكل

268
00:19:26,960 --> 00:19:29,100
إنّهم يُشبهوننا من الدّاخل

269
00:19:29,100 --> 00:19:31,150
هذا ما علّمني إيّاه أبي

270
00:19:31,830 --> 00:19:33,810
ساحرة بيضاء؟

271
00:19:33,810 --> 00:19:37,700
ويُقال بأنّها تُمارس سحراً حقيقيّاً

272
00:19:39,420 --> 00:19:42,060
،كانت تؤدّي في خيمة استعراض

273
00:19:42,060 --> 00:19:45,000
لكن يمكنك الآن رؤيتها في مسرح المدينة

274
00:19:45,630 --> 00:19:46,710
تذكّرت

275
00:19:47,150 --> 00:19:50,940
كانت العجوز تشتكي بأنّ المبيعات في بيت
الزنجار انخفضتْ بنسبة 20 بالمئة

276
00:19:50,940 --> 00:19:53,800
أعتقد بأنّ النّاس يُغادرون حيّ الملذّات
للذّهاب إلى المسرح

277
00:19:54,700 --> 00:19:57,850
من يُشاهد نفس العرض أكثر من مرّة؟

278
00:19:57,850 --> 00:19:59,430
من الطّبيعيّ أن تتفاجئي

279
00:20:01,600 --> 00:20:03,440
شكراً

280
00:20:07,300 --> 00:20:09,150
هل سمعتِ يوماً بـ لياندان-شو؟

281
00:20:09,460 --> 00:20:10,900
ما الّذي جعلَك تذكر ذلك؟

282
00:20:11,670 --> 00:20:15,080
الفنّ الّذي يزعم بأنّه يخلق سحَرة
خالِدين من خلال الطّبّ

283
00:20:15,080 --> 00:20:19,530
،حذّرَني أبي من مُحاولة تطبيقه
لأنّه مُريب جدّاً

284
00:20:19,530 --> 00:20:23,520
،يُقال أنّه بالإضافة إلى مظهرها النّادر

285
00:20:23,520 --> 00:20:26,450
تستطيع السّاحرة قراءة عقول
النّاس وصنع الذّهب

286
00:20:28,190 --> 00:20:30,460
لو كنتِ مسؤولة رفيعة المرتبة
،كثيرة الشّكوك

287
00:20:30,460 --> 00:20:33,130
لكن تمّت قراءة عقلكِ فوراً، فكيف
سيكون شعوركِ؟

288
00:20:33,130 --> 00:20:34,750
هكذا إذاً

289
00:20:35,180 --> 00:20:37,210
،إذا دخلتُ يُساورني الشكّ وأسخر منها

290
00:20:37,210 --> 00:20:40,840
فإنّ الشّعور ينقلب رأساً على عقب
إلى عِبادة

291
00:20:41,300 --> 00:20:46,600
هذا سيُسهّل عمليّة تصديق خدعة الخلود أيضاً

292
00:20:46,890 --> 00:20:49,500
يا لها من كومة هائلة من الحماقة

293
00:20:49,500 --> 00:20:55,190
إذاً هذه السّاحرة المزعومة تجمع جمهوراً
باستخدام خدعة الخلود؟

294
00:20:55,510 --> 00:20:57,460
لا أعرف هذه التّفاصيل

295
00:20:57,460 --> 00:21:01,070
سمعتُ القصّةَ بالصّدفة من أحد أتباع مسؤول

296
00:21:01,690 --> 00:21:06,370
وأن يُنهك مولايّ جينشي تفكيره
...في وباء الجراد

297
00:21:06,370 --> 00:21:09,470
المسؤولون الآخرون لديهم كثير
من أوقات الفراغ

298
00:21:10,580 --> 00:21:13,850
إن كان يراودكِ فضول، بوسعكِ
الذّهاب وتفقّدها بنفسكِ

299
00:21:13,850 --> 00:21:16,550
لا أتحمّل نفقات العرض باهظ الثّمن

300
00:21:16,550 --> 00:21:19,220
بوسعكِ أن تسألي فحسب

301
00:21:19,840 --> 00:21:23,980
أسأل من؟ من لديه وقت لذلك؟

302
00:23:45,070 --> 00:24:00,000
الحلقة القادمة

303
00:23:53,540 --> 00:23:56,080
:الحلقة القادمة
"الخالدة الأفعى البيضاء"

304
00:23:53,620 --> 00:24:00,000
الحلقة 53: الخالدة الأفعى البيضاء