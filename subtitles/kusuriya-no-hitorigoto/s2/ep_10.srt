1
00:01:31,520 --> 00:01:34,490
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

2
00:01:33,490 --> 00:01:35,810
ماوماو، اسمحي لي بالتّعريف

3
00:01:35,810 --> 00:01:38,650
هؤلاء هُنّ الوصيفات الجديدات اللّواتي
انضممنَ لمقصورة اليشم

4
00:01:38,650 --> 00:01:39,910
جميعهن أخوات

5
00:01:40,750 --> 00:01:42,200
أنا هاكو-يو

6
00:01:42,200 --> 00:01:43,610
أنا كوكو-يو

7
00:01:43,610 --> 00:01:44,660
أنا سيكي-يو

8
00:01:45,240 --> 00:01:47,160
جميعهن مُتشابهات تماماً

9
00:01:47,990 --> 00:01:49,760
كيف حالكِ؟

10
00:01:49,760 --> 00:01:51,710
بخير، لم أركِ منذ وقت طويل

11
00:01:53,170 --> 00:01:54,720
هل تعرفنَ بعضكن الآخر؟

12
00:01:54,720 --> 00:01:58,080
أجل، جميعنا من نفس الموطن
ونعرف بعضنا الآخر

13
00:01:58,080 --> 00:02:01,720
هاكو-يو، الكبرى، هي من عمر
مولاتي غيويكويو

14
00:02:02,860 --> 00:02:06,060
تحديد الطّاقم ضمن أشخاص
من نفس الموطن حسبما أرى

15
00:02:06,060 --> 00:02:09,040
هذه طريقة أكثر أماناً، لا سيّما
،بالنّسبة لمولاتي غيوكويو

16
00:02:09,040 --> 00:02:10,980
الّتي كادت تُغتال من قبل

17
00:02:11,630 --> 00:02:12,670
ومن أنتِ؟

18
00:02:13,210 --> 00:02:15,820
أنا ماوماو، المُتذوِّقة، يا آنسة كوكو-يو

19
00:02:16,450 --> 00:02:18,740
لستُ كوكو-يو

20
00:02:18,740 --> 00:02:21,370
ماذا؟ إذاً آنسة سيكي-يو؟

21
00:02:21,760 --> 00:02:22,830
أنا هاكو-يو

22
00:02:27,510 --> 00:02:31,420
من الآن فصاعداً، سنرتدي ربطات شعر
،تتطابق مع الألوان في أسمائنا

23
00:02:31,420 --> 00:02:32,820
وذلك كي تتعرّفي علينا

24
00:02:32,820 --> 00:02:34,380
أجل، عُلِم

25
00:02:35,350 --> 00:02:37,660
لا أستطيع التّمييز بينهن إطلاقاً

26
00:02:38,160 --> 00:02:40,640
أظنّني سأحتاج كثيراً من الوقت لأتعلّم

27
00:02:41,490 --> 00:02:43,680
...المُشكلة الأهمّ الآن هي

28
00:02:43,680 --> 00:02:46,970
!ماوماو! عودي إلى غرفتكِ فحسب

29
00:02:47,240 --> 00:02:49,980
لا، أنا مرتاحة تماماً في سقيفة المخزن

30
00:02:49,980 --> 00:02:53,080
مولاتي هونيان قالت أيضاً بأنّ
هذه غرفتي الآن

31
00:02:53,080 --> 00:02:55,440
!سأستمرّ في استخدامها

32
00:02:55,440 --> 00:02:57,370
!مُحال أن ينطلي ذلك عليّ

33
00:02:57,370 --> 00:02:59,690
!اتّخذتِ النّكتة بصورة حرفيّة

34
00:03:00,670 --> 00:03:04,660
...لكن نقلتُ بالفعل كافّة أغراضي إلى السّقيفة

35
00:03:04,660 --> 00:03:08,160
!أنتِ تضربين مثالاً سيّئاً للوصيفات الجديدات

36
00:03:11,250 --> 00:03:14,080
!ماذا تعتقدان بأنّكما تفعلان؟

37
00:03:26,060 --> 00:03:30,310
إذاً سقيفة المخزن هي وكر ماوماو الآن؟

38
00:03:31,130 --> 00:03:33,060
يمكنكِ فعل ما تشائين في تلك السّقيفة

39
00:03:33,840 --> 00:03:37,470
لكن نامي في غرفتكِ الأصليّة رجاء

40
00:03:38,020 --> 00:03:39,030
عُلِم

41
00:03:40,440 --> 00:03:42,450
يا لهُن من رئيسات جيّدات

42
00:03:46,750 --> 00:03:48,460
،بانضمام الوصيفات الجديدات

43
00:03:48,460 --> 00:03:51,400
فإنّ مقدار العمل المُترتّب على كلّ
شخص قد انخفض بشكل كبير

44
00:03:52,430 --> 00:03:58,340
نظراً لحمل مولاتي غيوكويو، تحتاج مقصورة
اليشم عُمّالاً أكثر من أي وقت سبق

45
00:03:58,340 --> 00:04:01,340
...لذا، هؤلاء الوافدات الجديدات مُفيدات، لكن

46
00:04:02,160 --> 00:04:04,940
هذا أيضاً لمُوازنة الأمور

47
00:04:04,940 --> 00:04:09,240
مع مقصورة العقيق الأحمر الخاصّة بالمَحظيّة
روران، والّتي لديه عدد ضخم

48
00:04:11,410 --> 00:04:12,560
شكراً لكُن جميعاً

49
00:04:13,330 --> 00:04:15,310
...حسناً، سأغادر إلى السّقيفة الآن

50
00:04:15,910 --> 00:04:17,350
!ماوماو

51
00:04:18,440 --> 00:04:23,340
،إنفا، هل تعيش ماوماو في السّقيفة
وليس في غرفتها؟

52
00:04:23,340 --> 00:04:26,570
حقّاً؟ رغم أنّها وصيفة مولاتي غيوكويو؟

53
00:04:26,570 --> 00:04:30,290
...لا، في الواقع

54
00:04:42,620 --> 00:04:47,170
أنا مستاءة من قيام الآنسة إنفا
،بشدّي وإخراجي من السّقيفة

55
00:04:47,170 --> 00:04:49,890
لكن أعلم بأنّها فعلتْ ذلك من باب الإحسان

56
00:04:49,890 --> 00:04:53,220
تريدني أن أنسجم بسرعة مع الوصيفات الجديدات

57
00:04:53,220 --> 00:04:54,890
هذا لطف منها كالعادة

58
00:05:00,820 --> 00:05:03,490
أنا آسفة لأنانيّتي طوال الوقت

59
00:05:03,490 --> 00:05:05,450
لا عليك، لا توجد مُشكلة

60
00:05:05,450 --> 00:05:08,510
ماوماو. هل تندمين على ما فعلتِه
ولو قليلاً؟

61
00:05:08,510 --> 00:05:10,290
ماذا؟ أجل، بالطّبع

62
00:05:10,290 --> 00:05:12,720
حقّاً؟ تشعرين إذاً وكأنّكِ مَدينة لي؟

63
00:05:12,720 --> 00:05:14,460
...أجل، بالتّأكيد

64
00:05:14,780 --> 00:05:16,170
أحقّاً ذلك؟

65
00:05:16,490 --> 00:05:19,670
!في هذه الحالة، سوف تُرافقينني اللّيلة

66
00:05:19,670 --> 00:05:20,280
ماذا؟

67
00:05:20,280 --> 00:05:23,920
أنتِ وأنا الوحيدتان المُتفرّغتان هذا المساء

68
00:05:24,250 --> 00:05:26,170
!الوقت المثاليّ

69
00:05:29,030 --> 00:05:30,540
...نالَتْ منّي

70
00:05:35,880 --> 00:05:39,000
المعذرة، هل تعلم مولاتي هونيان
بنزهتنا القصيرة اللّيلة؟

71
00:05:39,000 --> 00:05:42,020
لا تقلقي. حصلتُ على إذن

72
00:05:42,610 --> 00:05:44,720
...الطّرف الشّماليّ من القصر الخلفيّ

73
00:05:46,260 --> 00:05:49,410
ينبغي أن تتواجد مبانٍ قديمة فقط هنا

74
00:05:51,950 --> 00:05:55,910
ماوماو، ضعي هذه. بهذا الشّكل

75
00:05:57,790 --> 00:05:59,210
ألا يُشعرك هذا بالحرّ؟

76
00:05:59,520 --> 00:06:01,790
لا تقلقي، سيبرد قريباً

77
00:06:08,030 --> 00:06:08,960
ها أنا ذي

78
00:06:13,910 --> 00:06:16,680
مرحباً. هل ستنضمّان أنتما الاثنتان لنا؟

79
00:06:17,050 --> 00:06:19,270
أجل، شكراً لكِ

80
00:06:19,760 --> 00:06:21,170
شكراً لكِ

81
00:06:21,170 --> 00:06:24,540
أطفئي مصباحكِ وخذي هذه
بدلاً من ذلك

82
00:06:28,790 --> 00:06:32,490
إنّها جميلة، لكن كبيرة على
أن تكون فتاة بلاط

83
00:06:32,990 --> 00:06:34,700
والآن، فلنذهب

84
00:06:37,700 --> 00:06:41,460
استُخدِم هذا المكان أثناء عصر
الإمبراطور الرّاحل

85
00:06:42,010 --> 00:06:45,530
مُقارنة بذلك الوقت، عدد فتيات البلاط
انخفض بشكل ملحوظ

86
00:06:47,720 --> 00:06:49,970
لكن لمُناسبات كهذه، هذا المكان مثاليّ

87
00:06:54,510 --> 00:06:56,890
اجلسا في مكان شاغر

88
00:07:02,770 --> 00:07:04,230
جميعنا هنا

89
00:07:05,430 --> 00:07:10,070
،اِثنا عشر شخصاً في يوم حارّ
...وفي غرفة مُغلَقة

90
00:07:10,500 --> 00:07:14,780
هل أتى الجميع مُحضّرين قصصهم؟

91
00:07:15,270 --> 00:07:20,290
اللّيلة، لنستمتع بالرّوايات المُرعبة الثّلاثة عشر

92
00:07:20,840 --> 00:07:22,760
ثلاثة عشر رواية؟

93
00:07:25,850 --> 00:07:27,920
...ومنذ تلك اللّحظة

94
00:07:28,410 --> 00:07:30,670
،في كلّ ليلة، في خندق البوّابة الشّماليّة

95
00:07:30,670 --> 00:07:33,560
تُشاهَد الخادمة وهي ترمي بنفسها
في الماء مراراً وتكراراً

96
00:07:34,320 --> 00:07:38,200
عندما أتت فتاةُ بلاط أشفقَتْ عليها
،لنثر الزّهور في الخندق

97
00:07:38,200 --> 00:07:40,730
سَمِعَتْ صوتاً من مكان ما

98
00:07:41,330 --> 00:07:44,000
...وعندما حدّقتْ بالخندق بحثاً عن المصدر

99
00:07:44,000 --> 00:07:46,580
...ظهرَ الوجه الشّاحب للخادمة عائماً

100
00:07:46,580 --> 00:07:51,240
،عندما حاولت فتاة البلاط الهرب
!أمسك شيء بقدميها فجأة

101
00:07:52,930 --> 00:07:56,270
...صعدت الخادمة من الماء وقالت

102
00:07:56,900 --> 00:08:01,740
...الشّخص الّذي دفعني في ذلك اليوم"

103
00:08:04,250 --> 00:08:06,380
"!كان أنت

104
00:08:09,850 --> 00:08:12,660
يبدو هذا مألوفاً بعض الشّيء

105
00:08:13,950 --> 00:08:17,180
إذاً، الآنسة إنفا سريعة الخوف
ومع ذلك تستمتع بهذه القصص

106
00:08:22,020 --> 00:08:25,820
يبدو أنّ هذا الحدث يتضمّن التّناوب
،على رِواء قصص أشباح

107
00:08:25,820 --> 00:08:29,270
ثمّ نفخ الشّمعة عند الانتهاء

108
00:08:29,790 --> 00:08:34,040
لكن القصص هي أقرب إلى إشاعات
سُمِعت في القصر الخلفيّ

109
00:08:34,040 --> 00:08:36,030
ليست مُرعبة إلى حدٍّ كافٍ

110
00:08:39,670 --> 00:08:42,720
من الصّعب إيجاد التّرفيه في القصر الخلفيّ

111
00:08:42,720 --> 00:08:45,690
يبدو أنّ الحديث معاً هكذا مسموح

112
00:08:48,050 --> 00:08:49,530
!مساء الخير

113
00:08:49,530 --> 00:08:50,650
شيسوي

114
00:08:50,650 --> 00:08:51,420
أتريدين لقمة؟

115
00:08:51,710 --> 00:08:52,600
شكراً

116
00:08:58,060 --> 00:08:59,150
حسناً

117
00:09:00,250 --> 00:09:03,640
هذه القصّة من موطني

118
00:09:05,180 --> 00:09:07,250
،كانت هناك غابة قريبة من القرية

119
00:09:07,250 --> 00:09:10,660
وكان يتمّ تحذير أهل القرية باستمرار
من عدم دخولها

120
00:09:11,220 --> 00:09:15,620
من يدخل، سوف يُلعَن، وسوف
تلتهِم الشّياطين روحه

121
00:09:16,430 --> 00:09:21,460
لكن ذات يوم، انتهك طفلٌ القاعدة

122
00:09:22,180 --> 00:09:24,500
في ذلك العام، كان المحصول مُنخفضاً

123
00:09:24,500 --> 00:09:30,350
كان الطّفل جائعاً جدّاً، دخل
إلى الغابة بحثاً عن طعام

124
00:09:32,890 --> 00:09:35,420
،أخبر الطّفلُ أمَّه

125
00:09:35,930 --> 00:09:40,580
دعيني أخبرك بسرّ جيّد. هناك كثير"
"من الطّعام في تلك الغابة

126
00:09:41,810 --> 00:09:45,790
لكن عندما اكتشفَ القرويّون الآخرون
،بأنّه قد دخل الغابة

127
00:09:45,790 --> 00:09:48,190
نبذوا الفتى وأُمّه

128
00:09:48,860 --> 00:09:54,030
الاثنان اللّذان أصبحا وحيدين الآن، لم يكن
،لديهما ما يأكلانه وازدادا نحالة كلّ يوم

129
00:09:54,030 --> 00:09:56,860
لكن لم يحاول أحدٌ مُساعدتهما

130
00:09:58,120 --> 00:10:05,480
ذات ليلة، رأى شخصٌ نوراً
يتسلّل إلى منزل العائلة

131
00:10:06,150 --> 00:10:11,000
في اليوم التّالي، سمعَ شيخُ القرية
الأنباء ودخل للزيارة

132
00:10:11,950 --> 00:10:16,210
كان الطّفل ميّتاً بالفعل، والأمّ
كانت على حافّة الموت

133
00:10:17,230 --> 00:10:19,220
،قالت الأمُّ للشّيخ

134
00:10:20,490 --> 00:10:23,720
"دعني أخبرك بسرّ جيّد"

135
00:10:24,200 --> 00:10:27,740
لكن في تلك اللّحظة، ماتت

136
00:10:28,690 --> 00:10:32,620
وابتسمتْ ابتسامة غريبة عندما تُوفّيت

137
00:10:33,580 --> 00:10:37,740
وهكذا، لم يعرف أحدٌ ما الّذي
كانت تحاول قوله

138
00:10:37,740 --> 00:10:41,020
،ما زال السّكّان المحلّيون يخشون الغابة
معتبرين إيّاها أرضاً مُحرَّمة

139
00:10:41,020 --> 00:10:44,660
أيّ شخص يدخل الغابة سوف
،يُهاجَم بواسطة شيطان في منزله

140
00:10:44,660 --> 00:10:47,230
وسيتمّ التهام روحه

141
00:10:50,490 --> 00:10:52,290
لقد فهمت

142
00:10:52,290 --> 00:10:54,290
فهمتِ ماذا؟

143
00:10:54,290 --> 00:10:55,770
سأخبركِ لاحقاً

144
00:10:57,930 --> 00:10:59,560
أنا نعسانة لسبب ما

145
00:11:00,040 --> 00:11:02,340
هناك كثير من النّاس في مساحة ضيّقة

146
00:11:02,340 --> 00:11:04,680
ربّما أشعر بدُوار بسبب وجود
أشخاص كُثُر حولي

147
00:11:05,020 --> 00:11:06,720
حان دوركِ الآن

148
00:11:07,790 --> 00:11:09,130
حسناً

149
00:11:11,670 --> 00:11:16,260
هذه قصّة من بلاد بعيدة، في أقاصي الشّرق

150
00:11:18,100 --> 00:11:23,780
أنهى راهبٌ من بلد أجنبيّ أداء
طقوس الجنازة في بلد بعيدة

151
00:11:23,780 --> 00:11:26,540
في طريق عودته إلى المنزل، أدرك
بأنّ الشّمس قد غربت في لحظة ما

152
00:11:27,410 --> 00:11:33,210
كان مُحاطاً بواسطة عشب طويل
وقد تكون هناك كلاب برّية قريبة

153
00:11:33,980 --> 00:11:37,050
كان الرّاهب مُتلهّفاً للخروج
،من دائرة الخطر، وفجأة

154
00:11:37,050 --> 00:11:39,550
ظهرَ منزل قديم أمامه

155
00:11:42,120 --> 00:11:44,840
المعذرة، آسف لإزعاجك في
هذا الوقت المُتأخّر من اللّيل

156
00:11:46,350 --> 00:11:48,700
ما الأمر أيّها المُوقّر؟

157
00:11:48,700 --> 00:11:52,080
كنتُ أحاول عبور الجبال لكن لم أستطع
الوصول قبل أن يُخيّم اللّيل

158
00:11:52,080 --> 00:11:56,270
هلّا سمحتُما لي بالإقامة هنا اللّيلة؟
مجرّد زاوية من منزلكما ستكون كافية

159
00:11:56,560 --> 00:12:00,570
لا بدّ أنّك مُرهَق تماماً

160
00:12:02,290 --> 00:12:07,330
رحّبت الزوجةُ بالرّاهب بالطّعام والمنامة

161
00:12:08,090 --> 00:12:13,180
،كان الرّاهب مُمتنّاً على التّرهيب الحار
لكن لم يكن لديه ما يُقدّمه بالمقابل

162
00:12:13,180 --> 00:12:17,040
ظنَّ بأنّ أقلّ ما يستطيع فعله
هو ترتيل سوترا لأجلها

163
00:12:23,010 --> 00:12:24,590
هل هذا صوت جرس...؟

164
00:12:25,370 --> 00:12:31,220
لا، يبدو هذا كجرس، لكن هل
هو صوت إنسان في الواقع؟

165
00:12:31,620 --> 00:12:34,420
وماذا تنوي أن تفعل؟

166
00:12:34,420 --> 00:12:36,480
لا شيء. لا تقلقي

167
00:12:36,480 --> 00:12:41,070
لا يمكنك. هيّا. لا أريد أن أُترَك وحيدة

168
00:12:41,480 --> 00:12:43,360
ماذا تقترحين أن نفعل إذاً؟

169
00:12:43,960 --> 00:12:45,780
لم أعد قادرة على تحمُّل المزيد

170
00:12:47,000 --> 00:12:51,080
هل يتجادلان؟ هل ينبغي أن أتدخّل؟

171
00:12:51,360 --> 00:12:55,350
لا، ثمّة شيء يخبرني بأنّني يجب
ألّا أتوقّف عن ترتيل السّوترا

172
00:12:55,350 --> 00:12:57,400
لنستخدم ذاك الرّاهب كبديل

173
00:12:57,400 --> 00:12:58,920
إنّها الطّريقة الوحيدة

174
00:13:00,440 --> 00:13:03,490
هيّا، لنفعل هذا

175
00:13:05,940 --> 00:13:08,580
أين ذلك الرّاهب؟

176
00:13:20,290 --> 00:13:21,820
هل هرب؟

177
00:13:24,260 --> 00:13:26,780
!إنّه ليس هنا... إنّه ليس هنا

178
00:13:26,780 --> 00:13:30,380
...يجب أن أجده، وإلّا أنا

179
00:13:30,700 --> 00:13:35,210
!يجب أن آخذك بدلاً من ذلك

180
00:13:38,810 --> 00:13:44,180
استمرّ الرّاهب في التّرتيل حتّى
توقّف صوت المضغ

181
00:13:45,290 --> 00:13:49,120
حالما عمّ الهدوء، همَّ الرّاهب بالخروج

182
00:13:50,010 --> 00:13:53,770
...اختفى الزّوجان الشّابان، وبدلاً من ذلك

183
00:13:54,860 --> 00:13:57,310
كلّ ما وجدَه كان أجنحة حشرات

184
00:13:57,790 --> 00:14:01,570
شبكَ الرّاهبُ يديه ببعضهما
،واستمرّ في المشي

185
00:14:02,580 --> 00:14:05,030
مُرتِّلاً السّوترا، حتّى الفجر

186
00:14:06,060 --> 00:14:10,530
يا لكِ من راوية جيّدة. وكأنّها شخص مُختلف

187
00:14:11,720 --> 00:14:17,540
...ماذا؟ وجهها نحو هذه الزّاوية
لماذا يبدو هذا مألوفاً؟

188
00:14:20,030 --> 00:14:21,840
ماوماو، أنتِ التّالية

189
00:14:21,840 --> 00:14:23,670
ماذا؟ حسناً

190
00:14:24,130 --> 00:14:26,180
عمّاذا يجب أن أتكلّم؟

191
00:14:27,870 --> 00:14:30,320
سمعتُ هذا من أبي بالتبنّي

192
00:14:30,320 --> 00:14:33,620
انتشرتْ إشاعات عن أنّ أرواح عائمة
شوهِدَتْ في مقبرة

193
00:14:35,420 --> 00:14:40,770
شرعتْ مجموعةٌ مُريبةٌ من الشّباب
الشُّجعان في التحرّي

194
00:14:42,040 --> 00:14:42,770
...ثمّ

195
00:14:48,750 --> 00:14:53,740
كان مجرّد رجل آخر من نفس البلدة
يمشي ومعه شعلة

196
00:14:55,810 --> 00:14:56,870
هذه هي فقط؟

197
00:14:57,160 --> 00:14:58,190
أجل

198
00:14:58,190 --> 00:15:02,710
كان الرّجل نبّاش قبور. نشأ لديه
،اهتمام غير سليم بلعنة غريبة

199
00:15:02,710 --> 00:15:05,710
وأخذ يحفر قبوراً لتقطيع الجثث

200
00:15:06,060 --> 00:15:08,820
وحصد أكباد البشر والّتي كان
—يعتقد بأنّها عِلاج لـ

201
00:15:08,820 --> 00:15:10,300
!يكفي

202
00:15:11,490 --> 00:15:12,960
هذا كلّ شيء

203
00:15:15,810 --> 00:15:18,000
أنتِ التّالية يا آنسة إنفا

204
00:15:18,000 --> 00:15:22,310
...ماذا؟ المعذرة

205
00:15:22,780 --> 00:15:25,930
...في قديم الزّمان، كان هناك رجل

206
00:15:25,930 --> 00:15:28,820
أو... كان امرأة عجوز؟

207
00:15:29,140 --> 00:15:30,240
...المعذرة

208
00:15:37,380 --> 00:15:39,720
إذاً، سأتكلّم أنا تالياً

209
00:15:40,830 --> 00:15:45,590
"على ذكر الأمر، قالتْ "ثلاثة عشر قصّة
في البداية

210
00:15:46,270 --> 00:15:49,980
.هناك اِثنا عشر واحدة منّا هنا فقط
ما معنى هذا؟

211
00:15:49,980 --> 00:15:52,590
،حدث هذا أثناء حكم الإمبراطور الرّاحل

212
00:15:53,020 --> 00:15:58,610
آنذاك، كان القصر الخلفيّ يتوسّع
دوماً، لتُضاف أقسام جديدة له

213
00:15:59,380 --> 00:16:00,830
ما السّبب؟

214
00:16:01,600 --> 00:16:07,550
،في ذلك الوقت، الأرملة الإمبراطورة العظيمة
والمعروفة بالإمبراطورة أيضاً، امتلكت قوّة هائلة

215
00:16:07,550 --> 00:16:11,660
كانت تحاول البحث عن فتيات يُلائمنَ
ذوق الإمبراطور الرّاحل

216
00:16:14,050 --> 00:16:15,420
ما هذا...؟

217
00:16:16,060 --> 00:16:21,250
اختار الإمبراطور الرّاحل الفتيات الأصغر
سنّاً، ليأخذ عذريّتهن الواحدة تلو الأُخرى

218
00:16:22,150 --> 00:16:28,940
،قضت الفتياتُ أيّامهن في القصر الخلفيّ
ممنوعات حتّى من المُغادرة

219
00:16:29,870 --> 00:16:33,760
أصبحت إحدى هذه الفتيات حاملاً

220
00:16:34,370 --> 00:16:36,760
...ناشدت الإمبراطور الرّاحل، لكن

221
00:16:37,560 --> 00:16:41,270
لم يُسمَح لها أبداً بمُغادرة القصر الخلفيّ

222
00:16:41,610 --> 00:16:43,950
...قُبيل موتها، قالت

223
00:16:46,110 --> 00:16:48,830
"!إنّه دورك"

224
00:16:50,900 --> 00:16:51,820
!ماوماو؟

225
00:16:54,700 --> 00:16:57,280
!لا عجب في أنّني كنتُ أدوخ

226
00:16:57,280 --> 00:16:58,910
!آنسة إنفا! شيسوي

227
00:16:58,910 --> 00:17:01,870
انقلنَ الفتيات فاقدات الوعي
!إلى جوار الباب والنّوافذ

228
00:17:02,220 --> 00:17:04,000
ماذا؟ ما الأمر؟

229
00:17:04,000 --> 00:17:10,050
!بسرعة! النّار المُتأجّجة تملأ الغرفة بهواء ضارّ

230
00:17:10,400 --> 00:17:12,150
!فـ-فهمت

231
00:17:17,370 --> 00:17:19,480
استغرقتُ وقتاً طويلاً حتّى أدركتُ ذلك

232
00:17:21,890 --> 00:17:24,430
...كنتُ وشيكة جدّاً

233
00:17:28,180 --> 00:17:29,900
...فتاة البلاط تلك

234
00:17:35,390 --> 00:17:40,180
يا لها من ليلة. اختفت المُنظِّمة أيضاً

235
00:17:40,860 --> 00:17:42,040
ماوماو

236
00:17:42,850 --> 00:17:44,280
أنتِ تلك...؟

237
00:17:44,280 --> 00:17:46,250
إنّها إحدى معارفي

238
00:17:46,610 --> 00:17:49,710
ماوماو. ماذا كانت تلك القصّة؟

239
00:17:50,130 --> 00:17:51,180
القصّة؟

240
00:17:51,180 --> 00:17:53,800
أقصد الغابة المُحرّمة

241
00:17:54,610 --> 00:17:55,340
أجل

242
00:17:56,120 --> 00:17:59,300
،الغابة المُحرّمة" هي غالباً مجرّد خُرافة"

243
00:17:59,300 --> 00:18:03,870
لكن بعض الأشياء تُصبح مُحرّمة
لسبب، وقد تكون هذه إحداها

244
00:18:03,870 --> 00:18:04,970
ماذا؟

245
00:18:05,260 --> 00:18:09,940
الغابات مليئة بالأطعمة، لكن أيضاً
مليئة بالأشياء غير الصّالحة للأكل

246
00:18:11,030 --> 00:18:16,780
إذا دخلَ شخصٌ من الخارج الغابةَ
وأكل شيئاً ومَرِض

247
00:18:17,420 --> 00:18:21,050
فمن الطّبيعيّ أن تنتشر أقاويل
بأنّه يجب على المرء توخّي الحذر

248
00:18:21,050 --> 00:18:22,780
عند أكل أشياء من الغابة

249
00:18:23,230 --> 00:18:27,330
هذا، على مدار سنوات طويلة، قد يتحوّل
"إلى شيء "مُحرّم

250
00:18:27,330 --> 00:18:29,790
،لاحقاً، بالتّزامن مع تفشّي المجاعة

251
00:18:30,060 --> 00:18:34,340
لم يعُد يعرف النّاس ما يمكن
وما لا يمكن أكله

252
00:18:34,970 --> 00:18:39,310
الأمّ والابن في تلك القصّة كانا يتضوّران
جوعاً نتيجة الحصاد السيّئ

253
00:18:39,310 --> 00:18:43,600
،لا بدّ أنّهما دخلا الغابة مع بدء تخييم الظّلام
بما أنّهما كانا ينتهكان القواعد

254
00:18:43,600 --> 00:18:47,850
ثمّ أخذا يبحثان عن طعام، وعادا
إلى المنزل عندما حلَّ اللّيل

255
00:18:48,570 --> 00:18:52,640
هناك نوع من الفطور يُدعى بفطر ضوء القمر

256
00:18:53,010 --> 00:18:55,640
،تُشبه فطور المحّار وتبدو لذيذة

257
00:18:55,640 --> 00:18:58,110
لكنّها سامّة وتتوهّج في الظّلام

258
00:18:59,010 --> 00:19:02,920
إذا رأى قرويٌّ شخصاً يحمل هذه
،الفطور من بعيد في الظّلام

259
00:19:02,920 --> 00:19:05,120
فقد تبدو كروح عائمة

260
00:19:05,940 --> 00:19:12,000
إنّه ليس سُمّاً قويّاً، لكن إذا أُكِل
...بواسطة شخص ضعيف جائع

261
00:19:15,750 --> 00:19:20,000
ربّما بينما الأمّ تحتضر، كانت
...تحاول أن تقول

262
00:19:21,370 --> 00:19:25,220
هناك فطور شهيّة في الغابة

263
00:19:26,730 --> 00:19:31,140
كطريقة للثّأر من القرويّين الّذين
تخلّوا عنها وعن ابنها

264
00:19:31,750 --> 00:19:33,970
!هذه هي حقيقة الأمر إذاً

265
00:19:33,970 --> 00:19:35,880
!عظيم، توضّح كلُّ شيء الآن

266
00:19:35,880 --> 00:19:37,960
!حسناً، سأذهب من هنا، وداعاً

267
00:19:40,020 --> 00:19:43,780
،الآن بعد أن عرفتُ الحقيقة
!لم تعُد مُخيفة إطلاقاً

268
00:19:44,540 --> 00:19:47,990
أنا واثقة بأنّ كافّة القصص لديها خلفيّة كهذه

269
00:19:49,160 --> 00:19:51,460
حسناً... من يدري؟

270
00:19:51,460 --> 00:19:53,920
!سلّيني فقط هذه المرّة

271
00:19:56,180 --> 00:19:57,610
عُدن

272
00:19:57,610 --> 00:20:00,610
ماذا؟ عدتُما أبكر ممّا توقّعت

273
00:20:00,610 --> 00:20:02,960
حدثت بعض الفوضى

274
00:20:02,960 --> 00:20:04,680
توقّعتُ هذا

275
00:20:05,050 --> 00:20:08,740
أعتقد قد تحدث بعض الأمور عندما
يكون المُنظِّم شخصاً جديداً

276
00:20:08,740 --> 00:20:10,180
مُنظِّم جديد؟

277
00:20:10,180 --> 00:20:13,180
فتاة البلاط الّتي نظّمت ذلك
الحدث تُوفّيت في العام الماضي

278
00:20:13,180 --> 00:20:16,480
كنتُ قلقة بعض الشّيء بشأن
مَن سيتولّى الأمر هذا العام

279
00:20:16,480 --> 00:20:17,720
ماذا؟

280
00:20:17,720 --> 00:20:21,530
.كانت شخصاً لطيفاً ومُفيداً جدّاً
استفدتُ منها كثيراً أيضاً

281
00:20:21,530 --> 00:20:24,490
أعتقد لم تتمكّن من مُغادرة القصر الخلفيّ أبداً

282
00:20:24,960 --> 00:20:28,490
كانت تجمعها علاقة مع الإمبراطور الرّاحل

283
00:20:28,490 --> 00:20:31,700
قالت بأنّ التجمُّع كان المتعة
الوحيدة الّتي حَظيَتْ بها

284
00:20:32,620 --> 00:20:37,840
كان من السيّئ أن ينتهي الحدث في العام
،المُوالي مُباشرة لوفاتها

285
00:20:38,420 --> 00:20:41,340
لذا يسرّني أنّ شخصاً قد تولّى عنها

286
00:20:43,830 --> 00:20:45,390
...تـ-تلك القصّة

287
00:20:47,810 --> 00:20:53,340
اختار الإمبراطور الرّاحل الفتيات الأصغر
سنّاً، ليأخذ عذريّتهن الواحدة تلو الأُخرى

288
00:20:53,340 --> 00:20:57,360
،قضت الفتياتُ أيّامهن في القصر الخلفيّ
ممنوعات حتّى من المُغادرة

289
00:20:59,020 --> 00:21:03,110
قصّة فتاة البلاط تلك كانت تجربتها الخاصّة

290
00:21:03,660 --> 00:21:07,520
أم أنّه كان مقلباً قام به شخص تعرفه؟

291
00:21:10,590 --> 00:21:14,620
العالم مليء بأشياء لا أستطيع فهمها تماماً

292
00:21:15,540 --> 00:21:20,630
اللّيلة، لنستمتع بالرّوايات المُرعبة الثّلاثة عشر

293
00:21:21,870 --> 00:21:27,640
بمن فيهن هي، كان هناك اثني
عشر شخصاً فقط

294
00:21:28,100 --> 00:21:32,970
يسرّني بأنّنا لم نصبح في النّهاية
قصّة الأشباح الثّالثة عشر

295
00:21:33,430 --> 00:21:35,490
...مـ-ماوماو

296
00:21:35,490 --> 00:21:36,140
نعم؟

297
00:21:36,600 --> 00:21:40,020
!نامي معي اللّيلة اليوم رجاء

298
00:21:45,470 --> 00:21:50,580
بدلاً من أن تصبح ليلة مُخيفة، تحوّلتْ
إلى ليلة خانقة وحارّة

299
00:21:51,740 --> 00:21:53,030
...حرّ شديد

300
00:23:45,110 --> 00:24:00,040
الحلقة القادمة

301
00:23:57,160 --> 00:23:59,160
"الحلقة القادمة: "الصّيد