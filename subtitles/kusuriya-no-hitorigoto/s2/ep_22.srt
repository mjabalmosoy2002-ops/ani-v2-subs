1
00:01:30,980 --> 00:01:33,980
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

2
00:01:31,910 --> 00:01:34,990
لم أكن أنوي اللّقاء بأمّي أبداً

3
00:01:35,970 --> 00:01:38,950
كان عليّ التّظاهر بأنّكِ الصّيدلانيّة
الجديدة للخروج من هذا الوضع

4
00:01:39,930 --> 00:01:44,450
يقول أبي بأنّ أمي لم تكن
،هكذا في الماضي

5
00:01:45,370 --> 00:01:46,590
لكن من يدري؟

6
00:01:47,470 --> 00:01:51,000
كانت هكذا منذ ولادتي

7
00:01:51,380 --> 00:01:55,140
تتنمّر على أختي، وتتنمّر على الوصيفات الصّغيرات

8
00:01:55,140 --> 00:01:57,510
...لتُفسد النّساء الأُخريات المُرتبطات بها

9
00:01:58,260 --> 00:02:01,970
لم يقل أبي شيئاً. ولا يستطيع

10
00:02:01,970 --> 00:02:03,220
لا يستطيع صدّها

11
00:02:03,570 --> 00:02:06,910
ينتظر للأبد فحسب كي تُسامحه

12
00:02:08,410 --> 00:02:11,190
...التِهام زوجها بعد إنجاب طفلة

13
00:02:11,650 --> 00:02:13,340
إنّها أشبه بحشرة

14
00:02:13,340 --> 00:02:15,940
لا، بل الحشرات أفضل بكثير

15
00:02:16,860 --> 00:02:19,680
يفعلون ذلك فقط كي يسمحوا
لأطفالهم بالعيش

16
00:02:21,080 --> 00:02:23,680
لا أريد أن أكون مثل أمّي

17
00:02:24,810 --> 00:02:30,170
رفضتْ شيسوي أن تصبح أُمّاً لدرجة
الاستعداد لتناول دواء إجهاض

18
00:02:30,530 --> 00:02:36,600
لدى شيسوي أمّ واحدة فقط. لكن
لا تريد أن تكون مثل شيسوي

19
00:02:36,600 --> 00:02:38,420
...هذا هو دافعها الرّئيسيّ

20
00:02:38,980 --> 00:02:42,340
أجريتُ بحثاً حولكِ يا ماوماو

21
00:02:42,850 --> 00:02:46,250
والدكِ هو مسؤول رفيع الشّأن، وتمّت
تربيتكِ بواسطة طبيب سابق

22
00:02:46,690 --> 00:02:48,920
أنتِ شبيهة بأختي

23
00:02:48,920 --> 00:02:53,030
لا أملك والداً ولا والدة. مُجرّد أب

24
00:02:53,810 --> 00:02:56,190
أجل، هذا يُشبه ما قالته أختي

25
00:02:57,050 --> 00:02:59,690
أجل، معكِ حقّ

26
00:02:59,690 --> 00:03:03,060
أختي ليست أختي فعليّاً غالباً أيضاً

27
00:03:04,360 --> 00:03:06,280
أبي تانوكيّ ماكر في نهاية المطاف

28
00:03:06,680 --> 00:03:09,880
لا بُدّ أنّه كان يخطّط لشيء
،بوضع أختي

29
00:03:09,880 --> 00:03:12,110
،الّتي يجري في عروقها دمٌ إمبراطوريّ
تحت سيطرته

30
00:03:12,700 --> 00:03:17,800
لذلك، أختي لا علاقة لها بعشيرة شي

31
00:03:18,210 --> 00:03:19,430
كذِب

32
00:03:20,490 --> 00:03:23,090
عندما يصبح وجهها هكذا، فإنّهما تتشابهان

33
00:03:23,570 --> 00:03:26,700
شيسوي تحبّ أختها سويري حُبّاً جمّاً

34
00:03:27,450 --> 00:03:29,490
،لهذا السّبب، حتّى بعد كلّ ما حدث

35
00:03:29,490 --> 00:03:31,390
تدّعي بأنّهما غير مُرتبطتين، كي تحميها

36
00:03:32,110 --> 00:03:34,950
لكن هذا المنطق لن يفلح إطلاقاً

37
00:03:34,950 --> 00:03:38,480
سويري مُتوغِّلة كثيراً في كافّة الحوادث
الّتي حدثت حتّى الآن

38
00:03:44,530 --> 00:03:45,940
...ماوماو

39
00:03:47,810 --> 00:03:49,930
،لو كان هؤلاء الأطفال حشرات

40
00:03:50,540 --> 00:03:52,460
لنجوا في الشّتاء، ألا تعتقدين ذلك؟

41
00:03:52,460 --> 00:03:54,420
لو كانوا حشرات...؟

42
00:03:55,150 --> 00:03:59,630
.لا تنجوا الحشرات أبداً من الشّتاء
تترك أطفالها خلفها فحسب

43
00:04:00,910 --> 00:04:02,860
فهمتُ الآن

44
00:04:02,860 --> 00:04:05,710
لهذا أحضرَتْني إلى هنا

45
00:04:06,310 --> 00:04:07,720
...شيسوي لن

46
00:04:08,460 --> 00:04:12,010
لن تعود شيسوي بعد الآن

47
00:04:14,980 --> 00:04:16,230
...شيسوي

48
00:04:19,410 --> 00:04:21,400
ينبغي أن تهربي فحسب

49
00:04:22,190 --> 00:04:26,660
ارمي كلّ شيء جانباً واهربي مع سويري

50
00:04:27,280 --> 00:04:32,970
.السّياسة، والداكِ، والعشيرة
ارمي كلّ شيء فحسب

51
00:04:34,180 --> 00:04:38,970
لا أُبالي للآخرين أيضاً. أنا هي
الأهمّ في نظري

52
00:04:39,630 --> 00:04:43,230
هل تدركين كم عانيتُ بعد
إحضاري إلى هنا؟

53
00:04:44,800 --> 00:04:45,930
...لكن رغم ذلك

54
00:04:52,980 --> 00:04:57,560
لِمَ لا أستطيع ردع نفسي
عن مدّ يد العون لها؟

55
00:05:00,340 --> 00:05:01,190
!لا تمنعيني

56
00:05:03,170 --> 00:05:07,110
لديّ واجباتي

57
00:05:07,410 --> 00:05:08,570
ما الفرق الّذي سيُحدثه ذلك؟

58
00:05:09,420 --> 00:05:11,540
لديّ كبريائي الخاصّ

59
00:05:11,810 --> 00:05:14,290
اطرحي ذلك جانباً فحسب

60
00:05:18,910 --> 00:05:20,240
...ماوماو

61
00:05:20,790 --> 00:05:24,490
،إن وجدتِ سُمّاً مجهولاً أمامكِ

62
00:05:24,490 --> 00:05:27,140
وقيل لكِ أنّ أمامكِ فُرصة
،واحدة فقط لتجرّعه

63
00:05:27,140 --> 00:05:28,140
ماذا ستفعلين؟

64
00:05:28,140 --> 00:05:29,370
أتجرّعه دُفعة واحدة

65
00:05:30,480 --> 00:05:31,390
حقّاً؟

66
00:05:35,240 --> 00:05:36,480
...إنّها

67
00:05:37,030 --> 00:05:37,850
...لكن

68
00:05:38,660 --> 00:05:41,990
!لا أعرف ماذا أقول لها

69
00:05:45,740 --> 00:05:46,890
!شيسوي

70
00:05:47,700 --> 00:05:50,790
دعيني أتمنّى لك حظّاً طيّباً على الأقلّ

71
00:05:52,990 --> 00:05:54,320
حظّاً طيّباً؟

72
00:05:55,720 --> 00:05:57,500
هذا ليس من طباعكِ

73
00:05:57,810 --> 00:06:00,500
...أجل، هذا نادر. فعلاً

74
00:06:02,130 --> 00:06:05,230
أعيدي هذا لي يوماً ما. كان هديّة

75
00:06:05,230 --> 00:06:08,340
هذا غير عقلانيّ. قد أبيعه

76
00:06:08,340 --> 00:06:10,310
إن فعلتِ، فلا مُشكلة

77
00:06:15,660 --> 00:06:17,880
في ياقتي؟ ليس في شعري؟

78
00:06:17,880 --> 00:06:20,850
ستكون زينكِ مُبهرَجة جدّاً إذا
وضعتِ مزيداً في شعركِ

79
00:06:23,320 --> 00:06:26,150
هناك شُحّار على وجهكِ وشعركِ أيضاً

80
00:06:27,930 --> 00:06:30,800
معكِ حقّ، أبدو كتانوكيّ

81
00:06:31,610 --> 00:06:33,870
شكراً لكِ يا ماوماو

82
00:06:42,990 --> 00:06:44,580
تولّي الباقي من فضلكِ

83
00:06:53,320 --> 00:06:55,990
تولّي الباقي". أجل"

84
00:07:04,060 --> 00:07:07,290
سنعود بالزّمن للوراء لبُرهة

85
00:07:09,640 --> 00:07:12,080
!الوقت يُداهمنا

86
00:07:12,080 --> 00:07:17,240
!لو تأخّرتَ أكثر قليلاً، لسحبتُك بالقوّة

87
00:07:17,240 --> 00:07:21,580
أبي، نظريّاً، إذا عاملتَ فرداً من العائلة
،الملكيّة بهذه الطّريقة

88
00:07:21,580 --> 00:07:24,590
فهل ستكون الوحيد الّذي يُعاقَب على ذلك؟

89
00:07:26,670 --> 00:07:27,440
لاهان

90
00:07:28,020 --> 00:07:29,170
أجل، ما الأمر؟

91
00:07:29,690 --> 00:07:34,150
هل كنتَ تدرك بأنّني وجينشي نفس الشّخص؟

92
00:07:34,830 --> 00:07:39,710
...أجل. الطّول والوزن والصّدر والخصر

93
00:07:39,710 --> 00:07:43,350
نادراً ما يمتلك شخصان نفس
القياسات الجسديّة تماماً

94
00:07:43,730 --> 00:07:47,940
أنت جميل جدّاً. من المُؤسف
أنّك لم تُولَد كامرأة

95
00:07:48,620 --> 00:07:52,320
والآن اشرح لنا خطّة السّيطرة
على ذلك الحصن

96
00:07:53,260 --> 00:07:55,920
هذه المنطقة معروفة بمواردها الحراجيّة الغنيّة

97
00:07:55,920 --> 00:07:59,200
وكانت تحت سيطرة عشيرة شي
لأجيال مُتعاقِبة

98
00:07:59,600 --> 00:08:04,660
وفقاً لتحقيقاتنا، كان مخزون من المعدن
يتدفّق إلى شيشو

99
00:08:05,620 --> 00:08:10,670
بالإضافة إلى ذلك، توفّر الينابيع السّاخنة
القريبة كمّيات كبيرة من الكبريت

100
00:08:11,710 --> 00:08:14,930
وهناك كهوف أيضاً والّتي تُوفّر الملح الصّخريّ

101
00:08:15,260 --> 00:08:19,750
الكبريت والملح الصّخريّ... يمكن
صنع بارود من خلالهما

102
00:08:20,150 --> 00:08:24,650
يمكننا أن نتوقّع من شيشو أن يمتلك
أسلحة بارود جاهزة للحرب

103
00:08:25,080 --> 00:08:25,950
الفيفا؟

104
00:08:25,950 --> 00:08:28,880
ليست مُلائمة للقتال الدّفاعيّة

105
00:08:28,880 --> 00:08:32,530
للقضاء على مجموعة أعداء
...من أعلى سور

106
00:08:33,410 --> 00:08:34,660
المدافع

107
00:08:37,640 --> 00:08:42,230
يمكننا أن نتوقّع سقوط الكثير من الضّحايا
بمُجرّد محاولة الاقتراب من الحصن

108
00:08:42,230 --> 00:08:43,460
هذه مُشكلة

109
00:08:43,860 --> 00:08:45,000
،نظريّاً، لكن

110
00:08:45,000 --> 00:08:48,680
من المُمكن تحييدهم دون السّماح
لهم باستخدام المدافع

111
00:08:49,130 --> 00:08:51,380
أو هذا ما يُفكّر فيه ذو العقل الرّياضيّ

112
00:08:51,740 --> 00:08:52,840
ماذا تقترح؟

113
00:08:53,300 --> 00:08:57,590
أوّلاً، نتخلّص من مخزون البارود لديهم
لمنعهم من استخدام مدافعهم

114
00:08:58,220 --> 00:09:01,220
...إنّها طريقة غريبة بعض الشّيء، لكن

115
00:09:02,930 --> 00:09:03,890
هكذا إذاً

116
00:09:04,490 --> 00:09:06,840
هذه طريقة اقتصاديّة جدّاً

117
00:09:06,840 --> 00:09:07,630
...لكن

118
00:09:08,270 --> 00:09:09,780
هناك مُشكلة واحدة

119
00:09:09,780 --> 00:09:11,440
ما هي هذه المُشكلة؟

120
00:09:12,260 --> 00:09:15,050
الحرس الملكيّ، يشنّ هجوماً مُفاجئاً؟

121
00:09:15,900 --> 00:09:17,030
الحرس الملكيّ

122
00:09:17,490 --> 00:09:19,610
أقوى جنود الإمبراطور

123
00:09:19,610 --> 00:09:23,880
يجب أن نُقاتل بكرامة، بما
يتلاءم مع تلك المكانة

124
00:09:27,890 --> 00:09:29,590
أتّفق مع الآمر العسكريّ العظيم

125
00:09:30,180 --> 00:09:32,070
أريد تقليص الأضرار

126
00:09:32,760 --> 00:09:33,880
عُلِم

127
00:09:34,370 --> 00:09:35,730
حسناً يا لاهان

128
00:09:35,730 --> 00:09:36,380
حاضر

129
00:09:38,510 --> 00:09:42,990
عليك أن تتعامل مع تلك الفتاة
بصورة مُختلفة من الآن

130
00:09:43,890 --> 00:09:45,000
أعلم

131
00:09:47,750 --> 00:09:50,860
مولايّ لاكان، لديّ تقرير من الكشّافة

132
00:09:51,630 --> 00:09:53,620
سيتوقّف تساقُط الثّلوج مع حلول اللّيل

133
00:09:53,620 --> 00:09:55,870
ينبغي أن نتمكّن من شنّ هجومنا حينها

134
00:09:55,870 --> 00:09:58,180
دع رمّاحي النّار يتمركزون في مواقعهم

135
00:09:58,180 --> 00:09:58,880
!حاضر

136
00:10:00,820 --> 00:10:05,950
!انتظري فحسب يا ماوماو. والدكِ قادم لإنقاذكِ

137
00:10:10,610 --> 00:10:12,060
لا أستطيع النّوم

138
00:10:12,920 --> 00:10:16,760
ما زال هناك بعض الوقت قبل أن يشنّ
...الحرس الملكيّ هجومه، لكن

139
00:10:18,730 --> 00:10:22,800
إنّها تتلذّذ بشهواتها أمامي عمداً

140
00:10:23,620 --> 00:10:28,490
،تجمع زوجات فاضلات وأمّهات مُربّيات عمداً

141
00:10:28,490 --> 00:10:32,480
لتُشاهدهن يغرقنَ في وحل الانحلال
مع ذكور البغاء

142
00:10:34,820 --> 00:10:37,770
لم تكن هكذا دوماً

143
00:10:46,430 --> 00:10:48,580
لم يبدأ الحرس الملكيّ بتحرّكاته بعد

144
00:10:48,580 --> 00:10:50,670
ماذا كان ذلك الاهتزاز إذاً؟

145
00:10:54,630 --> 00:10:57,040
!ورشة البارود في القبو؟

146
00:10:58,140 --> 00:10:59,760
!يجب أن أفعل شيئاً

147
00:11:02,410 --> 00:11:07,220
.أعلم هذا، ومع ذلك لا أفعل شيئاً
كم أنا مُثير للشّفقة

148
00:11:08,190 --> 00:11:11,260
لم أنم جيّداً لعقدين من الزّمن

149
00:11:12,230 --> 00:11:15,270
كان ذلك عندما بدأ كلّ ألمي

150
00:11:16,250 --> 00:11:18,280
يجب أن أطلب منك فعل شيء لأجلي

151
00:11:19,310 --> 00:11:23,530
أريدك أن تتّخذ ابنتي زوجة لك

152
00:11:24,090 --> 00:11:27,510
كنتُ قد نفيتُها كابنة وُلِدت نتيجة

153
00:11:28,150 --> 00:11:30,310
زنا بين تايهو والطّبيب

154
00:11:30,570 --> 00:11:33,360
جعلتُها تعيش حياة صعبة

155
00:11:34,140 --> 00:11:38,050
رغم أنّها كانت تستحقّ أن تُرعَى
،كأميرة في القصر

156
00:11:38,050 --> 00:11:39,900
بلا قلق أو مخاوف

157
00:11:40,870 --> 00:11:43,300
لم أكن أنوي اتّخاذ زوجة

158
00:11:43,850 --> 00:11:48,810
لكن لم أستطع رفض طلب من الإمبراطور
الّتي تتدهور حالته سريعاً

159
00:11:49,180 --> 00:11:53,150
شيشو، أنت أكثر الدّاعمين ولاء لي

160
00:11:53,930 --> 00:11:58,310
إذا قبلتَ بهذا، فسوف أمنحك أيّ أُمنية

161
00:11:59,740 --> 00:12:04,300
كان لديّ خطيبة دخلت القصرَ الخلفيّ

162
00:12:06,440 --> 00:12:08,490
...إن كنتَ ستُحقّق أي أُمنية حقّاً

163
00:12:09,070 --> 00:12:14,580
قبلتُ ابنة الإمبراطور الرّاحل زوجة
لي، ووُلِدت سويري

164
00:12:14,880 --> 00:12:19,690
،ثمّ عادتْ خطيبتي شينمي من القصر الخلفيّ

165
00:12:19,690 --> 00:12:21,800
وهذا ما آلت إليه الأمور

166
00:12:31,470 --> 00:12:33,490
ماذا كان ذلك الضّجيج؟

167
00:12:33,490 --> 00:12:35,900
سأكتشف حالاً

168
00:12:39,730 --> 00:12:43,070
!ما هذا يا روران؟! أنتِ قذرة تماماً

169
00:12:43,070 --> 00:12:45,930
لا أقبل هذا الكلام منكِ يا أمّي

170
00:12:45,930 --> 00:12:49,160
،ولا من أحد منكن يا مَن انحدرتُن للحضيض

171
00:12:49,460 --> 00:12:51,180
مُتخلّيات عن أطفالكن

172
00:12:57,100 --> 00:12:57,670
!روران؟

173
00:12:58,330 --> 00:13:01,290
هل هذه... ابنتي حقّاً؟

174
00:13:01,870 --> 00:13:04,880
ظننتُها كانت مجرّد دُمية، ومُطيعة دوماً لشينمي

175
00:13:04,880 --> 00:13:07,590
وتلبس كما تأمرها شينمي

176
00:13:09,390 --> 00:13:11,940
أنا آسفة يا أختي العزيزة. تأخّرت

177
00:13:14,300 --> 00:13:17,000
وكأنّها فعلَتْ هذا عشرات المرّات من قبل

178
00:13:17,810 --> 00:13:20,900
كنتُ أعلم بأنّ شينمي تكره سويري

179
00:13:20,900 --> 00:13:25,190
لكن هل كان هذا المستوى من الاعتداء شائع؟

180
00:13:26,190 --> 00:13:29,510
...بينما كنتُ أخدم في القصر

181
00:13:30,220 --> 00:13:32,830
يا لي من أب مُثير للشّفقة

182
00:13:34,510 --> 00:13:35,670
أبي

183
00:13:37,380 --> 00:13:40,790
كتصرُّف أخير، تحمّل المسؤوليّة
ولو لمرّة في حياتك

184
00:13:42,310 --> 00:13:43,260
...روران

185
00:13:44,250 --> 00:13:47,340
أنت مُعلّم تانوكيّ لقرية ثعالب

186
00:13:48,280 --> 00:13:50,630
لنُنفّذ خدعة أخيرة

187
00:14:07,000 --> 00:14:07,740
!ما هذا؟

188
00:14:18,980 --> 00:14:19,990
!انهيار ثلجيّ؟

189
00:14:20,740 --> 00:14:22,210
...مستودع الأسلحة

190
00:14:22,210 --> 00:14:24,090
!لا يمكننا القتال من دونه

191
00:14:24,090 --> 00:14:27,050
لا بارود أيضاً. أحرقتُه كلّه

192
00:14:27,380 --> 00:14:28,930
—روران، أنتِ

193
00:14:28,930 --> 00:14:31,260
كنتِ تعلمين بأنّ لا فُرصة لنا للنّصر

194
00:14:31,810 --> 00:14:33,270
أبي

195
00:14:33,270 --> 00:14:35,690
سأودّع أمّي

196
00:14:37,780 --> 00:14:40,400
...تحمُّل المسؤوليّة

197
00:14:42,260 --> 00:14:43,400
معها حقّ

198
00:14:44,330 --> 00:14:46,200
إنّها مسؤوليّتي

199
00:14:47,170 --> 00:14:49,290
!دُفِن مُستودع الأسلحة تحت الثّلج

200
00:14:49,290 --> 00:14:50,610
!أحضروا مزيداً من الرّجال إلى هنا

201
00:14:50,990 --> 00:14:53,410
!لا وقت قبل وصول الحرس الملكيّ

202
00:14:58,280 --> 00:15:00,320
!نحن نتعرّض لهجوم

203
00:15:05,000 --> 00:15:07,150
!الحرس الملكيّ؟! متى؟

204
00:15:07,150 --> 00:15:08,880
!تصدّوا لهم

205
00:15:17,220 --> 00:15:20,600
!العدوّ في حالة اضطراب! هاجموهم حالاً

206
00:15:26,500 --> 00:15:30,110
لا تقتلوا أولئك الّذين لا يملكون إرادة
!القتال. اِئسروهم

207
00:15:31,240 --> 00:15:32,900
هناك عدد أقلّ ممّا توقّعتُ من الجنود

208
00:15:33,300 --> 00:15:36,860
معظم الجنود الّذين كانوا من المُفترض
أن يُدافعوا عن الجبهة

209
00:15:36,860 --> 00:15:39,030
عادوا إلى البناء لإخماد الحريق

210
00:15:39,030 --> 00:15:40,340
سنضغط ونتقدّم

211
00:15:40,340 --> 00:15:40,870
!حاضر

212
00:15:41,260 --> 00:15:44,160
...من كان يتوقّع أن يسير هذا التّكتيك بسلاسة

213
00:15:45,620 --> 00:15:49,170
،وأيضاً، مَن كان يتوقّع من شيشو
،المعروف بخدعه في القصر

214
00:15:49,170 --> 00:15:53,640
أن يرتكب خطأ التّقوقع في مكان كهذا

215
00:15:54,450 --> 00:15:55,510
...بالإضافة إلى ذلك

216
00:15:56,230 --> 00:15:59,770
،الزّعيم المخصيّ الّذي يتمتّع بجمال إلَهة سماويّة

217
00:15:59,770 --> 00:16:03,190
...أن يظهر كقائد للحرس الملكيّ

218
00:16:03,190 --> 00:16:05,380
الجميع مصدومون

219
00:16:06,410 --> 00:16:09,550
قد يعتقد البعض أنّ هذه ليست الإستراتيجيّة
،المُلائمة للحرس الملكيّ

220
00:16:09,550 --> 00:16:11,870
جيش معتزّ بقيادة عضو في عائلة إمبراطوريّة

221
00:16:12,550 --> 00:16:17,550
غير أنّ هذه هي الإستراتيجيّة المثلى
لتقليص عدد الضّحايا

222
00:16:18,410 --> 00:16:24,170
هذا هو قراري. سأقبل بأي نقد
!يُشير إلى أنّه هجوم مُباغت

223
00:16:24,930 --> 00:16:27,540
عجباً! ما الّذي يدور في رؤوسهم؟

224
00:16:28,010 --> 00:16:32,420
،أولئك الّذين يرسمون مثل هذه الخطط
وأولئك الّذين يقبلونها

225
00:16:34,840 --> 00:16:37,980
أنت! ما الّذي يجري في الدّاخل؟

226
00:16:37,980 --> 00:16:42,160
يجب عليّ إخماد الحريق، وإلّا
...فإنّ مولاتي سوف

227
00:16:45,150 --> 00:16:46,260
!انتظر من فضلك

228
00:16:47,710 --> 00:16:49,000
أتريد أن تتكلّم؟

229
00:16:49,000 --> 00:16:49,630
أجل

230
00:16:50,050 --> 00:16:51,250
سأسمح بذلك

231
00:16:51,250 --> 00:16:53,280
شكراً لك

232
00:16:53,880 --> 00:16:56,910
هذا الدُّخان يعني أنّنا لا ينبغي أن نبقى هنا

233
00:16:57,620 --> 00:17:01,080
سيخرج الجميع في الدّاخل عمّا قريب

234
00:17:01,380 --> 00:17:02,700
أعلم

235
00:17:02,700 --> 00:17:06,050
ربّما لا يزال هناك بعض العالقين في الدّاخل

236
00:17:06,050 --> 00:17:08,880
سندخل للبحث بدلاً عنك إذاً

237
00:17:08,880 --> 00:17:10,420
أريد التدخُّل بنفسي

238
00:17:11,240 --> 00:17:15,220
سيكون من العظيم أن تبقى بجلالة
...قدرك في مكان آمن

239
00:17:16,120 --> 00:17:19,480
ابنة الآمر العسكريّ العظيم مُحتجزة هنا

240
00:17:19,940 --> 00:17:21,320
!هنا؟

241
00:17:21,320 --> 00:17:22,060
أجل

242
00:17:22,490 --> 00:17:26,920
إذا تركتها تموت... ستصنع لنفسك
عدوّاً سياسيّاً جديداً

243
00:17:26,920 --> 00:17:29,000
أجل، صحيح

244
00:17:32,120 --> 00:17:35,660
سأقوم بعملي فحسب إذاً

245
00:17:41,770 --> 00:17:42,950
هل هذا...؟

246
00:17:44,020 --> 00:17:48,040
مستحيل. مُحال أن يكون هنا

247
00:17:51,630 --> 00:17:54,130
سيصل الحرس الملكيّ في أيّ لحظة الآن

248
00:17:54,130 --> 00:17:57,800
قد يخلطون بيني وبين عضو في عشيرة
شي إذا بقيتُ هنا

249
00:17:58,530 --> 00:17:59,390
...لكن

250
00:18:00,360 --> 00:18:02,140
تولّي الباقي من فضلكِ

251
00:18:02,790 --> 00:18:04,890
كان ينبغي أن أهرب

252
00:18:04,890 --> 00:18:09,020
يا لي من غبيّة. لستُ في موقف
يسمح لي بانتقاد شيسوي

253
00:18:13,240 --> 00:18:16,400
آمل ألّا يكون الشّخص الّذي سيُداهم
!هذا المكان قويّاً

254
00:18:33,740 --> 00:18:37,940
آسفة إزعاجك، لكن هلّا حميتني
يا مولايّ جينشي؟

255
00:18:37,940 --> 00:18:40,180
...هل تأذّيتِ؟ هذا الدّم

256
00:18:40,180 --> 00:18:42,430
لا تقلق. إنّه ليس دمي

257
00:18:42,990 --> 00:18:44,350
!كيف لي ألّا أقلق؟

258
00:18:44,350 --> 00:18:45,910
إنّه مجرّد دماء أفعى

259
00:18:45,910 --> 00:18:46,640
أفعى؟

260
00:18:47,540 --> 00:18:50,400
افتقدتُ لهذه الأجواء

261
00:18:50,400 --> 00:18:51,990
...هل هذا

262
00:18:54,450 --> 00:18:55,070
!وليّ العهد

263
00:18:56,470 --> 00:19:01,080
لم أعُد وليّ العهد. السيّدة غيوكويو
أنجبتْ أميراً

264
00:19:01,550 --> 00:19:02,940
...وليّ العهد

265
00:19:04,090 --> 00:19:06,910
إذاً هذه هي حقيقة مولايّ جينشي

266
00:19:07,210 --> 00:19:09,230
الأخ الأصغر للإمبراطور عمره 19 عاماً

267
00:19:09,230 --> 00:19:13,540
ظننتُ أنّ مولايّ جينشي يُفترض
...أن يكون بعمر 25، لكن

268
00:19:14,390 --> 00:19:16,990
مولايّ جينشي، أنت أصغر ممّا تبدو

269
00:19:20,010 --> 00:19:21,450
!ليهاكو! هل أنت هنا؟

270
00:19:21,450 --> 00:19:22,050
!حاضر

271
00:19:22,630 --> 00:19:23,960
سأدع هذا الأمر لك

272
00:19:29,800 --> 00:19:31,100
لديّ سؤال لكِ

273
00:19:32,060 --> 00:19:36,680
تشبهين فتاة تعمل في القصر تُدعى ماوماو

274
00:19:36,680 --> 00:19:38,090
هذه أنا

275
00:19:38,090 --> 00:19:39,860
ماذا تفعلين هنا؟

276
00:19:39,860 --> 00:19:41,070
اختُطِفت

277
00:19:41,620 --> 00:19:43,410
...لحظة، إذاً هل أبوكِ

278
00:19:43,410 --> 00:19:47,370
لا تلفظ اسمه من فضلك. قُل فقط
ذلك العجوز" وكفى"

279
00:19:48,530 --> 00:19:49,750
فهمت

280
00:19:50,210 --> 00:19:51,370
!حسناً، آسف بشأن ذلك

281
00:19:51,940 --> 00:19:53,960
بما أنّكِ تقولين ذلك، أصبحت الأمور واضحة

282
00:19:54,690 --> 00:19:58,510
أنتِ في حالة يُرثى لها. انظري
إلى كلّ هذه الدّماء

283
00:19:58,510 --> 00:20:00,430
إنّها دماء أفعى

284
00:20:00,430 --> 00:20:02,780
حاولي ألّا تتأذّي، مفهوم؟

285
00:20:02,780 --> 00:20:08,560
.انفعل ذلك العجوز فجأة فآلمه ظهره
لا يستطيع التحرّك

286
00:20:08,960 --> 00:20:14,260
هل كان تزامُن الهجوم المُباغت
مع الانهيار الثّلجيّ خطّته أيضاً؟

287
00:20:14,260 --> 00:20:15,120
أجل

288
00:20:17,750 --> 00:20:19,780
هل يوجد أحدٌ نائم هنا؟

289
00:20:20,250 --> 00:20:23,700
أطفال. لكنّهم لا يتنفّسون

290
00:20:23,700 --> 00:20:25,340
أعتقد تجرّعوا سُمّاً

291
00:20:25,860 --> 00:20:30,660
فهمت. حتّى لو نجوا، سيُعدَمون جميعاً

292
00:20:31,320 --> 00:20:33,160
نساء، أطفال، غير مهمّ

293
00:20:33,890 --> 00:20:35,420
لا يروقني ذلك

294
00:20:36,050 --> 00:20:40,210
هل بقايا المعدومين تُرِكوا ليتعفّنوا؟

295
00:20:40,210 --> 00:20:43,610
لا، أُحرِقوا ثمّ دُفِنوا

296
00:20:43,610 --> 00:20:47,760
هل يمكن أن يُسمَح لهم على الأقلّ
بالرّاحة مع أمّهاتهم؟

297
00:20:47,760 --> 00:20:50,640
هذا ليس عملي

298
00:20:55,160 --> 00:20:57,610
وكأنّهم نائمون

299
00:20:58,180 --> 00:21:00,200
!أنتم! أحتاج مُساعدة هنا

300
00:21:00,200 --> 00:21:00,610
!حاضر

301
00:21:00,610 --> 00:21:01,820
سيّد ليهاكو؟

302
00:21:03,230 --> 00:21:05,660
لا يمكننا تركهم هنا فحسب، صحيح؟

303
00:21:06,130 --> 00:21:11,780
لا أستطيع منحهم دفناً لائقاً، لكن
يمكنني دفنهم في مكان قريب سرّاً

304
00:21:11,780 --> 00:21:13,930
ألن تُعاقَب على ذلك؟

305
00:21:13,930 --> 00:21:17,420
لا أدري. إذا أصابني مكروه، فساعديني، حسناً؟

306
00:21:18,210 --> 00:21:20,300
...أنا، أُساعدك؟ كيف

307
00:21:20,810 --> 00:21:26,800
لديّ فكرة! اقتربي من ذلك العجوز
وناديه "بابا" فحسب

308
00:21:26,800 --> 00:21:28,520
—سيدعكِ

309
00:21:29,050 --> 00:21:31,400
آسف، انسي الأمر

310
00:21:37,060 --> 00:21:38,310
ما الغرض من هذا الصّفير؟

311
00:21:38,750 --> 00:21:41,320
للإشارة إلى أنّني نفّذتُ أمراً

312
00:21:46,600 --> 00:21:48,070
هيّا بنا

313
00:21:48,070 --> 00:21:50,430
فإخراجكِ بأمان

314
00:21:52,230 --> 00:21:53,710
هو عملي

315
00:22:07,820 --> 00:22:11,710
سأفعل ما ائتمنتني عليه شيسوي

316
00:22:12,500 --> 00:22:13,560
هذا كلّ شيء

317
00:23:45,060 --> 00:24:00,000
الحلقة القادمة

318
00:23:56,710 --> 00:23:59,820
"الحلقة القادمة: "عشيرة شي