1
00:01:30,980 --> 00:01:33,980
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

2
00:01:35,690 --> 00:01:36,780
آنسة روران

3
00:01:49,250 --> 00:01:52,840
يبدو أنّ جرعة الانبعاث كانت تجربة

4
00:01:52,840 --> 00:01:55,210
أُجريَتْ أثناء تطوير جرعة الخلود

5
00:01:56,100 --> 00:01:59,680
عادتْ سويري إلى الحياة باستخدامها

6
00:02:00,250 --> 00:02:02,810
كان الصّيدلانيّ السّابق ماهراً حقّاً

7
00:02:04,150 --> 00:02:06,590
لكن ما تريده شينمي هو شيء

8
00:02:06,590 --> 00:02:10,760
يجعلها أصغر بعشر سنوات
برشفة من فنجان

9
00:02:15,570 --> 00:02:17,650
عانيتم أيضاً

10
00:02:19,580 --> 00:02:23,800
...ذلك الدّواء مستحيل. أعلم هذا، لكن

11
00:02:25,070 --> 00:02:27,960
!أنا أيضاً أعتزّ بعملي كصيدلانيّة

12
00:02:50,150 --> 00:02:52,570
...تمضي الأيّام بهدوء

13
00:02:55,110 --> 00:02:56,690
!انتظر

14
00:02:57,090 --> 00:03:00,540
!سيّدي الصّغير! لا يجوز أن تسلك هذا الطّريق
!قلتُ هذا مراراً

15
00:03:00,540 --> 00:03:02,070
من يأبه؟

16
00:03:04,100 --> 00:03:06,350
يتلقّى توبيخاً من جديد

17
00:03:06,350 --> 00:03:09,780
سيُعاد إلى المنزل بالقوّة ثانية. لماذا
يُواظب على فعل ذلك؟

18
00:03:12,390 --> 00:03:14,750
...رغم ذلك، هذه الرّائحة

19
00:03:14,750 --> 00:03:17,250
هل توجد ورشة تحت هذا؟

20
00:03:17,250 --> 00:03:19,130
كالورشة الّتي في القرية؟

21
00:03:22,660 --> 00:03:24,920
...آمل ألّا تنفجر

22
00:03:30,040 --> 00:03:31,060
ما هذا؟

23
00:03:34,290 --> 00:03:35,470
برقيّة؟

24
00:03:36,030 --> 00:03:39,030
"اهربي، سأصرف انتباه الحارس"

25
00:03:39,470 --> 00:03:42,140
أهرب؟ أهرب إلى أين بالضّبط؟

26
00:03:45,110 --> 00:03:46,510
!دعني

27
00:03:45,240 --> 00:03:46,520
!من فضلك يا سيّدي

28
00:03:48,540 --> 00:03:50,290
!هل شجّعتِه على هذا؟

29
00:03:52,700 --> 00:03:55,310
صرف انتباه الحُرّاس؟

30
00:04:00,270 --> 00:04:02,580
ما الّذي كنتَ تُفكّر فيه؟

31
00:04:03,010 --> 00:04:04,640
لا أعرف ما تقصدينه

32
00:04:05,560 --> 00:04:07,050
هل أنتِ من جعلتِه يفعل هذا؟

33
00:04:07,880 --> 00:04:09,470
لا أعرف مقصدكِ

34
00:04:10,990 --> 00:04:14,140
أعتقد حاول إنقاذي

35
00:04:14,770 --> 00:04:19,440
حتّى لو كانت خطّة طفل سخيفة، سيكون
من السيّئ أن ينكشف أمره

36
00:04:22,670 --> 00:04:24,840
!كنتُ ألعب فحسب، هذا كلّ شيء

37
00:04:24,840 --> 00:04:27,380
وأيضاً، كنتُ أتحقّق من أنّ الحارس
!لم يكن يتكاسل

38
00:04:27,380 --> 00:04:28,470
!ماذا؟

39
00:04:28,870 --> 00:04:30,340
هل هذا صحيح؟

40
00:04:30,340 --> 00:04:30,870
أجل

41
00:04:32,750 --> 00:04:35,000
لا تتصرّف بشكل يُثير الرّيبة
من الآن فصاعداً

42
00:04:35,610 --> 00:04:36,460
!حسناً

43
00:04:36,460 --> 00:04:38,540
—لحظة، صدّقيني رأيتُ

44
00:04:39,000 --> 00:04:42,590
لا تُهوِّل الأمر. تعلم ما أعنيه، صحيح؟

45
00:04:44,380 --> 00:04:45,640
...حسناً، فهمت

46
00:04:48,330 --> 00:04:52,500
—يسرّني أنّ سويري كانت موجودة. حُسِم الأمر الآن

47
00:04:52,500 --> 00:04:53,400
ماذا؟

48
00:04:59,060 --> 00:05:01,530
لِمَ كلّ هذا الضّجيج؟

49
00:05:01,530 --> 00:05:03,280
!أمّي

50
00:05:09,250 --> 00:05:10,510
أمّي...؟

51
00:05:11,200 --> 00:05:13,220
هذا ليس بالأمر الجلل

52
00:05:13,220 --> 00:05:18,970
حقّاً؟ أتساءل عن سبب وجود
الصّيدلانيّة خارج الغرفة

53
00:05:18,970 --> 00:05:23,210
،كان كيو-يو يلعب خارج غرفة الصّيدلانيّة
ويُشوّش الحارس

54
00:05:23,810 --> 00:05:25,780
—كنتُ أسأل عمّا كان يجري فحسب

55
00:05:25,780 --> 00:05:30,210
يا للهول! هل كنتَ مُشاكساً؟

56
00:05:30,210 --> 00:05:34,520
هذا سيّئ. أنا مُضطرّة لمُعاقبتك الآن

57
00:05:34,850 --> 00:05:39,740
ربّما بضع ضربات على مؤخّرتك
ستفي بالغرض؟

58
00:05:42,610 --> 00:05:44,400
—مولاتي شينمي، في الواقع

59
00:05:44,890 --> 00:05:45,690
ماذا؟

60
00:05:47,510 --> 00:05:49,630
لا يزال كيو-يو طفلاً

61
00:05:49,630 --> 00:05:53,200
...فضلاً عن ذلك، لم يفعل شيئاً يتطلّب

62
00:06:00,180 --> 00:06:01,720
هكذا إذاً

63
00:06:01,720 --> 00:06:06,920
إذاً أحدهم هوّل الأمر، أليس كذلك؟

64
00:06:06,920 --> 00:06:08,720
!لا! أبداً

65
00:06:10,280 --> 00:06:12,780
لكن أليست هذه هي النّتيجة
المنطقيّة الوحيدة؟

66
00:06:12,780 --> 00:06:15,790
ربّما إقامة في غرفة مائيّة ستُلقّنك درساً

67
00:06:15,790 --> 00:06:17,060
!لا، من فضلكِ

68
00:06:17,060 --> 00:06:18,060
هذا غير عقلانيّ

69
00:06:18,440 --> 00:06:20,850
إنّها لا تحتاج سبباً

70
00:06:21,470 --> 00:06:25,530
.تريد أن يُعاني الآخرون فحسب
حتّى أنّها تتلذّذ بذلك

71
00:06:26,300 --> 00:06:27,900
هذا لا يعنيني

72
00:06:27,900 --> 00:06:31,280
ينبغي أن أدع كيو-يو والحارس
يتلقّيان ما يستحقّانه فحسب

73
00:06:33,140 --> 00:06:33,780
...لكن

74
00:06:34,790 --> 00:06:36,290
هذا يستفزّني

75
00:06:36,290 --> 00:06:42,400
حسناً. أعتقد يجب أن أعاقبكما معاً إذاً

76
00:06:41,010 --> 00:06:42,400
العجوز الشّمطاء المجنونة

77
00:06:43,720 --> 00:06:44,560
ماذا؟

78
00:06:48,340 --> 00:06:49,470
!فتاة صغيرة وقحة

79
00:06:51,530 --> 00:06:54,100
أجل، أنا حمقاء بالتّأكيد

80
00:06:58,510 --> 00:07:00,190
أنا من طلب منه القيام بذلك

81
00:07:00,500 --> 00:07:01,310
ماذا؟

82
00:07:03,740 --> 00:07:08,980
طلبتُ من الفتى أن يُساعدني
في الهرب من هذا الحصن

83
00:07:08,980 --> 00:07:09,650
ماذا؟

84
00:07:09,650 --> 00:07:10,450
!أنتِ

85
00:07:12,740 --> 00:07:15,290
هذه الصّيدلانيّة عديمة القيمة

86
00:07:15,290 --> 00:07:17,590
دعوها تتعلّم درسها

87
00:07:18,060 --> 00:07:19,800
!ارموها في الغرفة المائيّة

88
00:07:20,850 --> 00:07:23,320
ماء! هل هو بارد؟

89
00:07:23,320 --> 00:07:25,630
كان يجدر بي أن أبقى صامتة فحسب

90
00:07:25,630 --> 00:07:29,160
سيترتّب علينا البحث عن صيدلانيّة
أُخرى من جديد

91
00:07:29,990 --> 00:07:35,350
سويري؟ هل سمعتُ شيئاً؟
سأعتبر نفسي لم أسمع

92
00:07:35,350 --> 00:07:36,590
—مولاتي شينمي

93
00:07:37,010 --> 00:07:38,920
لا تتحرّكي من دون إذن

94
00:07:40,130 --> 00:07:41,940
المعذرة

95
00:07:42,650 --> 00:07:43,610
—لكن

96
00:07:54,460 --> 00:08:00,580
يبدو حتّى أنقى الدّماء تتلوّث
عندما يُخلَط معها قطرة قذرة

97
00:08:03,780 --> 00:08:07,790
لعلّ سويري تشعر بالمسؤوليّة
على طريقتها الخاصّة

98
00:08:08,050 --> 00:08:11,840
لم أُرِد إحضاركِ كلّ الطّريق إلى هنا

99
00:08:12,900 --> 00:08:14,710
لدينا حمقاء أُخرى هنا

100
00:08:15,720 --> 00:08:20,140
أمّي، أريد استخدام ذلك الشّيء

101
00:08:20,140 --> 00:08:20,980
ذلك الشّيء؟

102
00:08:22,020 --> 00:08:25,160
تقصدين التّايبون

103
00:08:27,150 --> 00:08:31,990
تايبون؟ ما هو هذا؟ سمعتُ بالاسم من قبل

104
00:08:32,350 --> 00:08:33,820
يا لها من فكرة سديدة

105
00:08:33,820 --> 00:08:37,820
،في آخر مرّة استخدمناه فيها
حقّق نجاحاً باهراً

106
00:08:43,200 --> 00:08:44,320
ماذا تقصد؟

107
00:08:45,240 --> 00:08:47,790
خُذ الصّيدلانيّة إلى هناك

108
00:09:00,460 --> 00:09:01,430
هنا

109
00:09:07,790 --> 00:09:10,310
ما هذه الغرفة؟

110
00:09:12,170 --> 00:09:13,870
لا تكرهيني على ما أفعله

111
00:09:14,360 --> 00:09:18,490
أنا مَدين لكِ على إنقاذي، لكنّني
تحت أمرة مولاتي شينمي

112
00:09:28,950 --> 00:09:30,020
تايبون

113
00:09:30,810 --> 00:09:33,260
صحيح، تذكّرت

114
00:09:37,900 --> 00:09:41,310
إنّها عقوبة إعدام اخترعها ملك
مجنون في العصور القديمة

115
00:09:42,420 --> 00:09:45,520
،حبس سجين في حفرة

116
00:09:46,030 --> 00:09:47,380
...ثمّ رمي مجموعة من

117
00:09:50,020 --> 00:09:53,530
لا عجب في أنّ سويري تخشى الأفاعي

118
00:09:59,880 --> 00:10:05,190
!كم هي ظريفة

119
00:10:10,130 --> 00:10:12,520
لماذا أنا؟

120
00:10:13,660 --> 00:10:16,590
ماذا؟ ما هذه الرّائحة؟

121
00:10:17,100 --> 00:10:18,640
إنّها رائحة... حُلوة؟

122
00:10:27,890 --> 00:10:29,020
ماذا تفعلين؟

123
00:10:32,040 --> 00:10:34,090
هل لديك ملح؟

124
00:10:34,090 --> 00:10:35,890
!بالطّبع لا

125
00:10:35,890 --> 00:10:37,620
...لحظة، هل هذه

126
00:10:37,620 --> 00:10:38,320
أفعى

127
00:10:40,320 --> 00:10:44,540
لنتظاهر بأنّه سمك فحسب

128
00:10:44,540 --> 00:10:46,630
...لكن رغم ذلك، كيف

129
00:10:47,670 --> 00:10:50,890
استخدمتُ عود شعري لتقطيعها
وطبختُها عبر الشّعلة

130
00:10:50,890 --> 00:10:53,290
كيف لكِ أن تكوني بهذا الهدوء؟

131
00:10:53,290 --> 00:10:56,800
،الأفاعي والحشرات كانت كلّها بطيئة
بما أنّ فترة سُباتها اقتربت

132
00:10:57,370 --> 00:11:00,670
،تحسُّباً، قضيتُ على السّامّة أوّلاً

133
00:11:00,670 --> 00:11:04,110
واستخدمتُ الأعشاب الّتي لديّ
لصنع طارد الحشرات

134
00:11:04,110 --> 00:11:06,520
ماذا كانت الفائدة من مجيئي إلى هنا؟

135
00:11:07,700 --> 00:11:10,230
حسناً، لماذا أتيت إلى هنا؟

136
00:11:11,080 --> 00:11:13,360
سويري والطّفل طلبا منّي تفقّدكِ

137
00:11:14,130 --> 00:11:16,360
أرادا مُساعدتكِ

138
00:11:16,850 --> 00:11:20,740
وحتّى أنّ الطّفل أعطاني زينة يشم

139
00:11:21,420 --> 00:11:25,410
نجونا بفضلكِ على أيّ حال

140
00:11:26,440 --> 00:11:27,620
...ذلكما الاثنان

141
00:11:28,840 --> 00:11:31,690
سئمتُ من هذا المكان

142
00:11:31,690 --> 00:11:33,420
تلقّينا إشارة دخانيّة من الخارج

143
00:11:34,260 --> 00:11:37,050
قالوا بأنّها تعني أنّ قوّة تأديبيّة
قادمة من المدينة

144
00:11:37,490 --> 00:11:39,300
الحصن بأكمله في حالة جنون

145
00:11:39,910 --> 00:11:42,260
...هذه الرّائحة

146
00:11:39,910 --> 00:11:42,260
لهذا تمكّنتُ من الدّخول إلى هنا
دون أن يلاحظني أحد

147
00:11:42,670 --> 00:11:44,200
سأغادر الآن

148
00:11:44,770 --> 00:11:48,180
إذا كنتِ ستهربين أيضاً، فلا تستعملي
الدّرج في النّاحية الأُخرى

149
00:11:48,560 --> 00:11:50,990
سمعتُ أنّهم يصنعون البارود في القبو

150
00:11:50,990 --> 00:11:52,100
البارود؟

151
00:11:52,410 --> 00:11:55,980
يوجد كثير من النّاس هناك أيضاً. إذا
—وقع انفجار، سيطالكِ

152
00:11:55,980 --> 00:11:59,480
شكراً لك. الدّرج في النّاحية الأُخرى، صحيح؟

153
00:11:59,480 --> 00:12:02,610
!مهلاً، حذّرتُكِ

154
00:12:21,430 --> 00:12:23,720
لا بُدّ أنّ هذا مصدر الرّائحة

155
00:12:24,450 --> 00:12:27,220
...يبدو أنّهم يصنعون البارود، لكن

156
00:12:28,120 --> 00:12:31,750
هذا الدُّخان سيُسمّمهم جميعاً

157
00:12:32,180 --> 00:12:35,990
...فضلاً عن ذلك، استخدام نار بالقرب من البارود

158
00:12:37,180 --> 00:12:38,190
!يا للهول

159
00:12:40,370 --> 00:12:41,150
...هل هذه

160
00:12:45,330 --> 00:12:47,280
!ستُغادرون هذا المكان فوراً

161
00:12:48,520 --> 00:12:50,240
...مولاتي، لماذا

162
00:12:50,710 --> 00:12:53,400
الجيش قادم لمُهاجمتنا قريباً

163
00:12:53,400 --> 00:12:56,360
سيصبح هذا الحصن ساحة معركة وسيسقط

164
00:12:56,360 --> 00:12:57,580
!اهربوا بما أنّ الفُرصة سانحة

165
00:13:00,750 --> 00:13:01,700
!فضّة

166
00:13:11,710 --> 00:13:13,650
مـ-مولاتي؟

167
00:13:13,650 --> 00:13:14,890
أنت أيضاً. بسرعة

168
00:13:19,270 --> 00:13:20,570
!بالتّوفيق لكم في الهرب

169
00:13:22,100 --> 00:13:23,710
!اهربوا

170
00:13:27,800 --> 00:13:29,540
!هل هي جادّة؟

171
00:13:50,760 --> 00:13:51,430
!هذا سيّئ

172
00:13:53,590 --> 00:13:54,560
...روران

173
00:14:00,650 --> 00:14:01,700
!روران

174
00:14:02,760 --> 00:14:06,070
ماذا؟! ماوماو، لماذا أنتِ هنا؟

175
00:14:06,490 --> 00:14:08,240
أطرح عليك نفس السّؤال

176
00:14:08,860 --> 00:14:10,540
هل تأذّيتِ؟

177
00:14:10,540 --> 00:14:14,220
عرفتُ بأنّكِ ستكونين بخير في التّايبون

178
00:14:14,650 --> 00:14:15,760
توقّعت

179
00:14:17,400 --> 00:14:19,330
أجل، كانت شهيّة

180
00:14:21,060 --> 00:14:23,170
هذا جنون حقيقيّ

181
00:14:23,690 --> 00:14:26,460
انظروا من يتكلّم! شخص يأكل الحشرات طوعاً

182
00:14:30,460 --> 00:14:31,800
لنخرج من هنا

183
00:14:32,330 --> 00:14:35,100
الجيش قادم. من الأفضل أن نسرع

184
00:14:40,620 --> 00:14:41,860
لن أذهب

185
00:14:43,390 --> 00:14:45,180
ما زالت هناك عليّ القيام بها

186
00:14:58,110 --> 00:15:01,880
هل ستأتين معي؟ الآن هي الفُرصة
المثلى للهرب

187
00:15:02,350 --> 00:15:03,880
أعي بأنّني حمقاء

188
00:15:04,260 --> 00:15:06,750
إذا اكتشفتْ أمّي، ستصبح الأمور مُرعبة

189
00:15:06,750 --> 00:15:09,220
ستكون أقلّ عقوبة هي الجَلد

190
00:15:09,720 --> 00:15:13,220
ظننتُها تهتمّ بكِ يا روران

191
00:15:17,850 --> 00:15:22,280
بالكاد تتذكّر أمّي وجهي

192
00:15:23,250 --> 00:15:28,350
كنتُ لا أعرف شيئاً عندما بدؤوا
بوضع مُستحضرات على وجهي

193
00:15:29,370 --> 00:15:32,320
روران" هي مُجرّد دُمية لأمّي"

194
00:15:33,510 --> 00:15:37,450
دُمية مُطيعة وحسناء

195
00:15:38,300 --> 00:15:39,200
...لذا

196
00:15:40,580 --> 00:15:42,480
!أختي العزيزة

197
00:15:42,480 --> 00:15:44,060
أنتِ هنا ثانية؟

198
00:15:44,060 --> 00:15:47,190
!دعيني أساعدكِ! سأعمل معكِ

199
00:15:47,810 --> 00:15:49,540
لماذا تتكاسلين؟

200
00:15:51,760 --> 00:15:52,720
—أُمّي

201
00:15:55,370 --> 00:15:57,100
!أحضري لي الشّاي بسرعة

202
00:15:58,710 --> 00:16:02,600
،لم تعرفني أمّي بلباس الخادمة

203
00:16:02,900 --> 00:16:04,710
وضربتني بمروحتها

204
00:16:05,150 --> 00:16:09,360
إذا ارتديتُ ثياب خادمة، فأكون خادمة

205
00:16:10,170 --> 00:16:12,800
مع ذلك رحتِ لرؤية سويري

206
00:16:13,480 --> 00:16:16,280
أردتُ أن أكون على علاقة جيّدة معها

207
00:16:18,180 --> 00:16:22,060
كانت أمّي تتنمّر عليها دوماً

208
00:16:22,600 --> 00:16:27,550
أنا واثقة بأنّ أمّ أختي كانت تتعرّض لتنمُّر
بواسطة أمّي أيضاً، فأدّى ذلك إلى مقتلها

209
00:16:29,930 --> 00:16:32,500
،عندما أدخلَ أبي أُختي إلى كنف العائلة

210
00:16:33,170 --> 00:16:36,990
جُنّ جنون أمّي وأخذت تشدّ شعرها

211
00:16:37,710 --> 00:16:40,890
"!كُلّاً من الأمّ والابنة تجرؤان على إهانتي؟"

212
00:16:40,890 --> 00:16:43,890
"!ساقطة! من يدري ما قد تفعل؟"

213
00:16:45,690 --> 00:16:47,270
ظننتُ نفسي هالكة

214
00:16:48,350 --> 00:16:49,850
...الأمّ والابنة

215
00:16:51,030 --> 00:16:55,570
،عندما أُعيدَتْ لاحقاً كهديّة

216
00:16:55,970 --> 00:16:59,080
كنتُ أنا وأمّي بالفعل مع أبي

217
00:16:59,080 --> 00:17:05,080
يبدو حتّى أنقى الدّماء تتلوّث
عندما يُخلَط معها قطرة قذرة

218
00:17:06,440 --> 00:17:08,460
!لحظة، هل سويري...؟

219
00:17:09,660 --> 00:17:14,260
هل سمعتِ بإشاعة الضحيّة الأولى
للإمبراطور الرّاحل؟

220
00:17:14,890 --> 00:17:17,090
،فتاة البلاط الّتي أنجبتْ ابنةَ الإمبراطور

221
00:17:17,090 --> 00:17:19,180
لتنفصل عنها لاحقاً؟

222
00:17:19,980 --> 00:17:22,350
الّتي تُوفّيتْ في العام الماضي؟

223
00:17:22,760 --> 00:17:25,980
أجل. كانت تلك المرأة جدّة أختي

224
00:17:26,520 --> 00:17:27,980
كان اسمها تايهو

225
00:17:28,550 --> 00:17:31,860
كانت وصيفة أمّي عندما كانت في القصر الخلفيّ

226
00:17:33,460 --> 00:17:34,540
توقّعت

227
00:17:35,330 --> 00:17:40,190
الطّبيبة تايهو وابنتها طُرِدتا من القصر الخلفيّ

228
00:17:40,540 --> 00:17:42,210
تلك الابنة هي أمّ أختي

229
00:17:44,070 --> 00:17:48,150
...تجري في عروق سويري دماء إمبراطوريّة

230
00:17:49,460 --> 00:17:52,300
سمعتُ أنّها تُحبّ قصص الأشباح

231
00:17:53,150 --> 00:17:55,910
كدتُ أختنق بسبب ذلك ذات مرّة

232
00:17:55,910 --> 00:17:58,570
لعلّ ذلك كان من صنيع تلك الجدّة

233
00:18:02,090 --> 00:18:04,310
فأنا ابنة أمّي في نهاية المطاف

234
00:18:04,910 --> 00:18:06,890
أنا متأكّدة بأنّها كرهتْني كثيراً

235
00:18:07,690 --> 00:18:10,220
لدرجة كافية لقتلي كشبح

236
00:18:10,750 --> 00:18:13,700
من يدري إن كانت الأشباح موجودة؟

237
00:18:14,430 --> 00:18:16,070
ماوماو المعتادة

238
00:18:19,770 --> 00:18:24,680
"أمّي تزوّجتْ أبي لإنجاب "روران

239
00:18:25,750 --> 00:18:28,120
من أجل تحقيق انتقامها فقط

240
00:18:29,410 --> 00:18:32,390
كان أبي يحمل دماً غربيّاً كجزء من نسبه

241
00:18:32,820 --> 00:18:35,240
يعود ذلك النّسب إلى الملكيّة الأُمّ

242
00:18:36,550 --> 00:18:40,040
...لهذا بصر روران أيضاً

243
00:18:44,030 --> 00:18:49,350
"يمكنكِ أن تكوني الملكة الأمّ الجديدة"
كانت أمّي تقول ذلك دوماً

244
00:18:50,810 --> 00:18:51,660
...المعذرة

245
00:18:53,450 --> 00:18:56,310
روران؟ شيسوي؟

246
00:18:57,320 --> 00:19:00,110
لا أعرف ماذا أُناديها

247
00:19:01,220 --> 00:19:01,820
...لكن

248
00:19:07,830 --> 00:19:08,500
...لكن

249
00:19:10,530 --> 00:19:11,670
شيسوي

250
00:19:21,010 --> 00:19:22,260
ما الأمر؟

251
00:19:24,980 --> 00:19:29,770
عندما كان دواء الإجهاض مُتداولاً في القصر
الخلفيّ، هل كان لديكِ منه أيضاً؟

252
00:19:30,430 --> 00:19:32,100
لاستخدامه على نفسكِ؟

253
00:19:33,390 --> 00:19:39,320
،عندما رويتِ قصّة الأشباح تلك
...عن زوجة الجُدجُد الّتي تلتهم زوجها

254
00:19:40,440 --> 00:19:42,950
هل كنتِ تتكلّمين عن نفسكِ؟

255
00:19:43,740 --> 00:19:47,640
مُقارنة نفسكِ بحشرة، للإنجاب في القفص
،الّذي هو القصر الخلفيّ

256
00:19:48,030 --> 00:19:50,970
لالتهام الإمبراطور لاحقاً؟

257
00:19:51,880 --> 00:19:55,420
لكن لم تُرِد شيسوي أن يحدث ذلك

258
00:19:56,750 --> 00:19:58,040
...نبات الفانوس هو

259
00:19:58,950 --> 00:19:59,960
أعلم

260
00:20:01,370 --> 00:20:03,890
أنتِ ذكيّة حقّاً يا ماوماو

261
00:20:05,700 --> 00:20:07,640
يسرّني أنّني أحضرتُكِ إلى هنا

262
00:20:13,180 --> 00:20:15,440
—يا له من نوم عبثيّ

263
00:20:25,650 --> 00:20:27,830
إنّهم لا يتنفّسون

264
00:20:28,230 --> 00:20:29,450
—ما الّذي

265
00:20:34,610 --> 00:20:37,510
!جعلتِهم يتجرّعون سُمّاً؟

266
00:20:53,080 --> 00:20:54,140
كان دواء

267
00:20:58,010 --> 00:21:03,190
،بعد كلّ ما فعلناه، سنُقتل أجمعين
بمن في ذلك النّساء والأطفال

268
00:21:03,190 --> 00:21:04,700
أنتِ مُدرِكة لذلك جيّداً أيضاً، صحيح؟

269
00:21:07,330 --> 00:21:09,800
خلطتُه مع عصير حُلو

270
00:21:10,840 --> 00:21:13,080
...بعد قراءة لفيفة مُصوّرة معاً

271
00:21:14,650 --> 00:21:17,880
أراد بعض الأطفال النّوم مع أمّهاتهم

272
00:21:18,530 --> 00:21:20,190
لكن لم أستطع أن أدعهم

273
00:21:20,700 --> 00:21:26,010
فأمّهاتهم مُقرّبات جدّاً من أمّي

274
00:21:29,300 --> 00:21:34,980
وصلَ كيو-يو متأخّراً لأنّه كان يحاول
إنقاذ ماوماو على ما أعتقد

275
00:21:37,020 --> 00:21:39,650
ربّما كان يعلم

276
00:21:48,530 --> 00:21:51,580
...التزم الصّمت، لكن

277
00:21:52,430 --> 00:21:54,410
تجرّعَه دُفعة واحدة

278
00:22:03,070 --> 00:22:05,260
لماذا أحضرتِني إلى هنا؟

279
00:23:45,060 --> 00:24:00,000
الحلقة القادمة

280
00:23:56,870 --> 00:23:59,440
"الحلقة القادمة: "الحرس الملكيّ