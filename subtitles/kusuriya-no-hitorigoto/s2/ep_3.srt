1
00:01:30,980 --> 00:01:33,980
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

2
00:01:36,490 --> 00:01:37,950
سأذهب إلى مقصورة اليشم

3
00:01:38,530 --> 00:01:39,240
حسناً

4
00:01:41,870 --> 00:01:43,330
تُوفّيت؟

5
00:01:44,370 --> 00:01:47,040
المَحظيّة جين... هكذا إذاً

6
00:01:47,410 --> 00:01:50,500
.قيل لي بأنّه كان تسمُّماً غذائيّاً
وصلت الأنباء للتو

7
00:01:51,630 --> 00:01:55,380
قيل لي بأنّها كانت طريحة الفراش
منذ حوالي العام

8
00:01:58,970 --> 00:02:01,010
جاء مولايّ جينشي

9
00:02:01,800 --> 00:02:03,010
دعيه يدخل

10
00:02:04,850 --> 00:02:06,230
شكراً لكُن مُقدّماً

11
00:02:06,230 --> 00:02:07,230
العفو

12
00:02:12,060 --> 00:02:13,650
ينبغي أن أدعها تُركّز

13
00:02:14,480 --> 00:02:16,530
سيّدة بلاط مفقودة؟

14
00:02:16,530 --> 00:02:19,450
أجل. اسمها هو تاو

15
00:02:19,450 --> 00:02:22,320
كانت فتاة طيّبة ومُجدّة في العمل

16
00:02:22,320 --> 00:02:26,580
كادت مدّة خدمتها تنتهي، وكان
من المُزعم أن تتزوّج قريباً

17
00:02:27,120 --> 00:02:28,460
تتزوّج؟

18
00:02:28,460 --> 00:02:31,500
سمعتُ بأنّها مُنِحت دبّوس شعر
في حفلة الحديقة

19
00:02:31,500 --> 00:02:35,460
وكان ذلك من بيروقراطيّ واعد

20
00:02:36,050 --> 00:02:38,510
لكن أرادتها العقيلة أن تبقى

21
00:02:40,510 --> 00:02:46,100
إذاً سيّدة بلاط ماهرة كهذه تختفي
دون أن تقول وداعاً حتّى

22
00:02:48,310 --> 00:02:50,850
هل لديك أدنى فكرة إلى أين ذهبت؟

23
00:02:50,850 --> 00:02:53,230
إطلاقاً مع الأسف

24
00:02:53,230 --> 00:02:56,150
رغم ذلك، هذا ليس بالأمر النّادر

25
00:02:56,690 --> 00:02:59,990
فكثير من النّساء لديهن مشاكل داخليّة

26
00:02:59,990 --> 00:03:00,910
فهمت

27
00:03:03,370 --> 00:03:06,330
،أنسى أحياناً

28
00:03:06,990 --> 00:03:08,830
،لكن نحن في القصر الخلفيّ

29
00:03:08,830 --> 00:03:11,710
حديقة زهور مكتظّة بألفَي امرأة

30
00:03:15,000 --> 00:03:16,090
هكذا إذاً

31
00:03:16,090 --> 00:03:17,760
ثمّة حفلة شاي في الهواء الطّلق اليوم

32
00:03:18,300 --> 00:03:21,010
،أعتقد إذا بقيتْ في الدّاخل
فسيشكّ النّاس بأنّها حامل

33
00:03:23,930 --> 00:03:26,890
لكن أنا متأكّدة بأنّ البعض قد لاحظ الآن

34
00:03:26,890 --> 00:03:31,730
السّؤال هو فيما إذا كان أولئك
البعض نواياهم طيّبة أم لا

35
00:03:31,730 --> 00:03:33,350
أراكِ قد عُدتِ

36
00:03:36,110 --> 00:03:37,900
تعالي إلى هنا يا ماوماو

37
00:03:42,200 --> 00:03:43,660
بما يمكنني خدمتكِ؟

38
00:03:43,660 --> 00:03:45,200
خدمته في الواقع

39
00:03:46,870 --> 00:03:49,080
حسناً، لننتقل إلى مكان آخر

40
00:03:49,950 --> 00:03:53,870
لا أمانع. لِمَ لا تتكلّم هنا؟

41
00:03:54,380 --> 00:03:58,800
لا، يجب ألّا أقضي الكثير من الوقت
مع المَحظيّة المحبوبة لدى الإمبراطور

42
00:03:58,800 --> 00:04:00,210
...فضلاً عن ذلك

43
00:04:02,680 --> 00:04:03,510
ماذا؟

44
00:04:03,510 --> 00:04:06,470
مولاتي غيوكويو، من فضلكِ

45
00:04:09,770 --> 00:04:12,180
حسناً، ماذا أردت؟

46
00:04:12,770 --> 00:04:17,900
سمعتِ بأنّ الإمبراطور يوزّع روايات
على المَحظيّات، صحيح؟

47
00:04:17,900 --> 00:04:21,940
أجل. بعد أن تقرأها المَحظيّات، تُقرَأ
بواسطة وصيفاتهن

48
00:04:21,940 --> 00:04:25,570
وأيضاً فتيات البلاط الأُخريات

49
00:04:25,990 --> 00:04:29,740
تُستخرَج منها نُسخ، وهذا يُشجّع
البعض على القراءة والكتابة

50
00:04:30,040 --> 00:04:31,160
هكذا إذاً

51
00:04:32,370 --> 00:04:34,710
،ما زال هذا في بداية مرحلة التّخطيط

52
00:04:34,710 --> 00:04:37,380
لكن كنتُ أفكّر في بناء شيء كهذا

53
00:04:37,750 --> 00:04:41,010
أعتقد يُدعى هذا مدرسة فنّ
الخطّ بين العامّة

54
00:04:41,380 --> 00:04:43,670
مدرسة للخادمات

55
00:04:43,670 --> 00:04:48,010
،عرفتُ بأنّه كان يسعى لشيء
لكنّه يتصرّف أسرع ممّا توقّعت

56
00:04:49,310 --> 00:04:50,350
أظنّها فكرة سديدة

57
00:04:52,180 --> 00:04:53,980
!ماذا عن نظراتكِ المُميّزة؟

58
00:04:53,980 --> 00:04:56,400
!هل أنتِ على ما يُرام؟

59
00:04:56,400 --> 00:04:58,190
لماذا تتصرّفان بهذه الطّريقة؟

60
00:04:58,690 --> 00:05:01,440
هذا لأنّه أمر مُقلِق بعض الشّيء

61
00:05:05,240 --> 00:05:06,240
مازوخيّ

62
00:05:08,950 --> 00:05:10,910
حسناً، ما رأيكِ؟

63
00:05:10,910 --> 00:05:14,710
،هناك بالفعل أشخاص يحاولون التعلُّم
لذا أراها فكرة سديدة

64
00:05:15,460 --> 00:05:18,670
ستساهم في إيجاد البعض عملاً
جديداً بعد انتهاء مدّة خدمتهم أيضاً

65
00:05:18,670 --> 00:05:19,460
هكذا إذاً

66
00:05:20,130 --> 00:05:21,170
...لكن

67
00:05:21,590 --> 00:05:22,420
أخبريني

68
00:05:27,430 --> 00:05:28,800
لكنّه قريب من البوّابة الرّئيسيّة

69
00:05:31,890 --> 00:05:34,180
البعض منهن مُتعاليات

70
00:05:34,180 --> 00:05:38,650
قد لا تُسعدهن فكرة تعليم الخادمات

71
00:05:39,940 --> 00:05:42,150
قد نضطرّ لبنائها في الطّرف الشّماليّ

72
00:05:42,480 --> 00:05:45,740
أجل. سمعتُ بأنّ الطّرف الشّماليّ
،لم يُصَن بشكل جيّد

73
00:05:45,740 --> 00:05:48,360
ويوجد عدد من المباني المهجورة هناك

74
00:05:48,780 --> 00:05:51,120
ينبغي أن يكون إعادة ترميمها كافياً

75
00:05:51,740 --> 00:05:56,290
وأيضاً يمكنك أن تُسمّيه تدريباً مِهنيّاً

76
00:05:56,290 --> 00:05:59,420
يمكنك جمع أشخاص أكثر بتأطيره
ضمن نِطاق كسب لقمة العيش

77
00:06:00,420 --> 00:06:01,750
أوتظنّين ذلك؟

78
00:06:02,130 --> 00:06:04,670
وقد يكون طعاماً خفيفاً بين الحين
والآخر فكرة جيّدة أيضاً

79
00:06:04,670 --> 00:06:05,710
بين الحين والآخر فقط؟

80
00:06:05,710 --> 00:06:09,260
أجل. لا أحد يُدمن على رِهان
يُثمِر في كلّ مرّة

81
00:06:10,220 --> 00:06:11,680
حقّاً؟

82
00:06:12,600 --> 00:06:15,390
،أفكاره صائبة لكنّه لا يخطّط للأمور كما ينبغي

83
00:06:15,390 --> 00:06:17,350
ربّما بسبب تنشئته في بيئة رفيعة المستوى

84
00:06:17,350 --> 00:06:20,190
أعتقد بأنّه يسألني لأنّه مُدرك لهذا الأمر

85
00:06:20,650 --> 00:06:22,650
هذا رأيي الشّخصيّ فحسب

86
00:06:23,820 --> 00:06:25,570
أهذا كلّ شيء؟

87
00:06:25,900 --> 00:06:28,070
وثمّة أمر آخر

88
00:06:28,070 --> 00:06:30,410
هل تعرفين الكثير عن الفطور؟

89
00:06:31,410 --> 00:06:36,160
،في الواقع، تُستخدَم كطعام ودواء
لذا أجل، تقريباً

90
00:06:36,500 --> 00:06:39,540
،في هذه الفترة من العام
بعض فتيات البلاط

91
00:06:39,540 --> 00:06:42,380
يُفتّشن عن فطور دون إذن فيتسمّمن

92
00:06:42,380 --> 00:06:45,460
أعتقد يوجد بضعة شرِهين في كلّ مكان

93
00:06:45,800 --> 00:06:50,510
بالفعل. إحداهن كانت تأكل فطر
ماتسوتاكي مع الطّبيب في العيادة

94
00:06:51,010 --> 00:06:53,510
سمعتُ بأنّ الفواكه قد اختفت
من البستان أيضاً

95
00:06:54,050 --> 00:06:56,140
تلك ليست فطوراً سامّة

96
00:06:56,470 --> 00:06:59,810
وكنتُ أشذب البستان قليلاً

97
00:06:59,810 --> 00:07:04,190
لذا أودّ منكِ أن تجدي وتتخلّصي
من أيّ شيء قد يُؤكَل بالخطأ

98
00:07:04,190 --> 00:07:07,570
وأيضاً انتبهي لأنواع الفطور السّامّة
الّتي تعثرين عليها

99
00:07:08,280 --> 00:07:09,780
سأطلب منكِ أخذ استراحة

100
00:07:09,780 --> 00:07:12,450
من كافّة مهام مقصورة اليشم
الأخرى غير التذوُّق

101
00:07:12,910 --> 00:07:13,530
هكذا إذاً

102
00:07:14,240 --> 00:07:19,040
لا أرى ما يمنع شرح هذا أمام مولاتي غيوكويو

103
00:07:21,080 --> 00:07:23,380
لماذا يحدِّق بي هكذا؟

104
00:07:24,630 --> 00:07:25,630
أعتمد عليكِ

105
00:07:26,710 --> 00:07:27,920
عُلِم

106
00:07:28,670 --> 00:07:31,300
...لعلّ شيئاً ما يجري

107
00:07:31,300 --> 00:07:32,720
لكن بغضّ النّظر، يبدو هذا مُمتعاً

108
00:07:34,510 --> 00:07:37,100
حسناً، إلى أين ينبغي أن أذهب...؟

109
00:07:37,640 --> 00:07:40,230
...الحدائق والبساتين وأشجار الصّنوبر

110
00:07:40,600 --> 00:07:43,600
هناك أماكن كثيرة يمكن للفطور أن تنمو فيها

111
00:07:43,600 --> 00:07:46,020
إنّه بداية موسم الفطور أيضاً

112
00:07:46,820 --> 00:07:48,690
،إذا كانت فتيات البلاط يُفتّشن سرّاً

113
00:07:48,690 --> 00:07:53,610
فيمكنني شطب الأماكن الّتي يتجمّع فيها
كثير من النّاس والطّرف الجنوبيّ عموماً

114
00:07:54,990 --> 00:07:56,160
...في هذه الحالة

115
00:07:56,490 --> 00:07:58,160
الطّرف الشّماليّ

116
00:08:10,130 --> 00:08:11,970
ما هذه الرّائحة؟

117
00:08:11,970 --> 00:08:14,680
...إنّها لاذعة قليلاً

118
00:08:16,800 --> 00:08:19,850
هل هذه هي الرّائحة الغريبة
الّتي ذكرَتْها شيسوي من قبل؟

119
00:08:20,600 --> 00:08:25,100
ربّما التسرُّب من المجارير هو
ما يُغذّي الفطور

120
00:08:27,060 --> 00:08:28,570
عُدت

121
00:08:29,190 --> 00:08:31,440
!أهلاً بعودتك... يا للهول

122
00:08:33,530 --> 00:08:35,700
!لا تدخلي هكذا. أنتِ بحالة رثّة

123
00:08:35,700 --> 00:08:36,530
...رثّة

124
00:08:36,530 --> 00:08:40,160
ماوماو، رائحتكِ غريبة. ماذا كنتِ
تفعلين طوال اليوم؟

125
00:08:40,990 --> 00:08:44,120
كان يوماً مُرضياً

126
00:08:44,750 --> 00:08:47,630
وحتّى أنّني حصلتُ على فطور دوائيّة

127
00:08:48,210 --> 00:08:52,460
أخبرتُه بأنّ جميعها سامّة، لذا
حتّى ذلك الدجّال لن يأكلها

128
00:08:48,710 --> 00:08:53,300
هل هي سامّة حقّاً؟ ربّما
...إذا جرّبتُ واحدة، سأعرف

129
00:08:53,800 --> 00:08:58,220
بدّلي ملابسكِ بسرعة. اقترب
عشاء مولاتي غيوكويو

130
00:08:58,220 --> 00:08:59,140
حسناً

131
00:09:02,140 --> 00:09:04,690
أعتذر على تأخُّري

132
00:09:07,100 --> 00:09:08,900
آسفة لأنّنا استعجلناكِ

133
00:09:09,440 --> 00:09:10,270
لا عليكِ

134
00:09:10,860 --> 00:09:13,740
...حبل أسود حول مِعصميهما

135
00:09:15,110 --> 00:09:17,240
سأخرج بعد العشاء

136
00:09:17,240 --> 00:09:19,700
رافقيني من فضلكِ

137
00:09:19,700 --> 00:09:20,660
عُلِم

138
00:09:21,740 --> 00:09:26,160
...إذاً تُوفّيت نبيلة داخل القصر الخلفيّ

139
00:09:29,670 --> 00:09:32,300
،كانت مَحظيّة تُدعى جين

140
00:09:32,300 --> 00:09:36,760
مَحظيّة بمرتبة فوق المُتوسّط
وابنة مسؤول رفيع المرتبة

141
00:09:37,340 --> 00:09:41,680
كانت مريضة لعام كامل وتلزم غرفتها دوماً

142
00:09:41,680 --> 00:09:44,600
يبدو أنّها تسمّمتْ غذائيّاً ولم تتعافَ أبداً

143
00:09:45,600 --> 00:09:50,980
لم يكن الإمبراطور يزورها. كان
ينبغي أن تعود إلى المنزل

144
00:09:52,480 --> 00:09:56,490
نادراً ما تتكلّمين عن شخص بهذه الطّريقة

145
00:10:00,450 --> 00:10:05,330
...كانت المَحظيّة جين صعبة المراس
بعض الشّيء، من حيث الطّبع

146
00:10:05,330 --> 00:10:08,170
كانت تغار كثيراً من المَحظيّات
وفتيات البلاط الأُخريات

147
00:10:08,750 --> 00:10:12,540
كانت تهاجمهن شفهيّاً وأحياناً جسديّاً
إذا كُنّ من فئة أدنى

148
00:10:12,960 --> 00:10:18,680
،وتزامنَ ذلك مع تسمُّم مولاتي غيوكويو
بينما كانت حاملاً بالأميرة

149
00:10:21,180 --> 00:10:26,140
بالطّبع، لم تكن تُهاجم المَحظيّات
رفيعات المرتبة بشكلٍ علنيّ

150
00:10:26,560 --> 00:10:33,140
لكن نظراً لشخصيّتها، فتح مولايّ جينشي
تحقيقاً حول الأمر على الأقلّ

151
00:10:33,650 --> 00:10:34,430
...لكن

152
00:10:36,400 --> 00:10:39,240
هل لديك أي دليل؟

153
00:10:40,780 --> 00:10:44,200
لذا بقيت المسألة ضمن دائرة الشكّ فقط

154
00:10:44,200 --> 00:10:46,330
،سمعتُ أنّه وقعت اضطرابات داخليّة كثيرة

155
00:10:46,330 --> 00:10:50,960
وحتّى وصيفاتها واجهنَ وقتاً عصيباً

156
00:10:50,960 --> 00:10:54,800
بصراحة، أنا مُطمئنّة قليلاً لحدوث هذا

157
00:10:54,800 --> 00:10:57,210
...فلو أصابَ مولاتي غيوكويو مكروه ثانية

158
00:11:00,180 --> 00:11:03,890
أعتقد بأنّ هذا رأي صادق
من السيّدة هونيان

159
00:11:04,930 --> 00:11:07,680
يبدو أنّها تسمّمتْ غذائيّاً ولم تتعافَ أبداً

160
00:11:08,060 --> 00:11:11,100
وأيضاً انتبهي لأنواع الفطور السّامّة
الّتي تعثرين عليها

161
00:11:11,980 --> 00:11:16,070
لماذا طلب مولايّ جينشي منّي
التّحقيق بشأن الفطور؟

162
00:11:16,820 --> 00:11:21,240
،لماذا رفض مُناقشة الأمر في مقصورة اليشم
أمام مولاتي غيوكويو؟

163
00:11:21,740 --> 00:11:26,080
لا يمكن أن يفعل هذا إلّا إذا كان يشكّ
ببعض الأشخاص في مقصورة اليشم

164
00:11:26,830 --> 00:11:29,830
وبأنّ إحدانا قتلت المَحظيّة جين بفطر سامّ

165
00:11:30,580 --> 00:11:34,040
ظننتُ بأنّه كان ربّما مُتحيّزاً
جدّاً لمولاتي غيوكويو

166
00:11:34,040 --> 00:11:36,590
لكنّه يُعامل الجميع سواسية في نهاية المطاف

167
00:11:37,300 --> 00:11:42,590
،أعتقد لو كان مسار تفكيره واضحاً
لأثّر ذلك على الثِّقة

168
00:11:43,390 --> 00:11:47,180
على أيّ حال، لا يمكن أن تكون
مولاتي غيوكويو الجانية

169
00:11:47,180 --> 00:11:49,430
،التّسميم صعب للغاية

170
00:11:49,430 --> 00:11:53,060
وهناك سُبُل أسهل بكثير لطرد
مَحظيّة متوسّطة المرتبة

171
00:11:53,060 --> 00:11:56,730
الوصيفات الأُخريات غير مُؤهّلات
لمثل لهذا العمل المُراوغ

172
00:11:56,730 --> 00:11:59,150
...لذا المُتّهم الرّئيسيّ هو

173
00:12:00,240 --> 00:12:01,110
أنا

174
00:12:01,950 --> 00:12:06,950
إذا كان يتقصّى ردّة فعلي بينما يُموّه
،ذلك كطلب للتّحقيق حول الفطور

175
00:12:06,950 --> 00:12:09,620
فأنا مُندهشة حقّاً. هذا غير مُخيِّب إطلاقاً

176
00:12:10,410 --> 00:12:11,460
من فضلكِ

177
00:12:13,170 --> 00:12:16,380
ماذا؟ هل هي وصيفة المَحظيّة جين؟

178
00:12:16,840 --> 00:12:18,210
هل أُصيبتْ بطفح جلديّ جرّاء شيء ما؟

179
00:12:18,800 --> 00:12:19,340
من فضلكِ

180
00:12:19,340 --> 00:12:21,170
...لكن هذا الالتهاب

181
00:12:26,850 --> 00:12:31,310
...لو علمتُ على الأقلّ بأعراضها قبل وفاتها

182
00:12:43,320 --> 00:12:46,030
!المَحظيّة سون! توقّفي رجاء

183
00:13:01,550 --> 00:13:03,590
!نلتِ ما تستحقّينه

184
00:13:05,720 --> 00:13:07,430
...الالتهاب في وجهها

185
00:13:07,730 --> 00:13:09,760
هل تعرفين الكثير عن الفطور؟

186
00:13:09,760 --> 00:13:13,310
وحتّى وصيفاتها واجهنَ وقتاً عصيباً

187
00:13:15,140 --> 00:13:17,100
فهمتُ الآن

188
00:13:18,560 --> 00:13:21,320
هذا ما كان مولايّ جينشي يحاول إيجاده

189
00:13:25,900 --> 00:13:27,950
قيل لي بأنّ المرأة الّتي أحدثتْ
جلبة في اللّيلة الماضية

190
00:13:27,950 --> 00:13:30,910
هي مَحظيّة مُتدنّية المرتبة تُدعى سون

191
00:13:30,910 --> 00:13:33,910
إنّها من عائلة تجاريّة ثريّة
وتتمتّع بشخصيّة رائعة

192
00:13:33,910 --> 00:13:36,790
وحتّى أنّ الإمبراطور زارها من وقت لآخر

193
00:13:37,210 --> 00:13:40,210
...لكن قبل قرابة العامين

194
00:13:42,170 --> 00:13:45,090
!لماذا... لماذا يحدث هذا؟

195
00:13:45,920 --> 00:13:47,680
،أُصيبت بمرض غامض

196
00:13:47,680 --> 00:13:50,140
وانتشرت أقاويل عن عزلها كمَحظيّة

197
00:13:50,550 --> 00:13:54,640
،لكن حتّى لو عادت إلى المنزل
لن تتمكّن من الزّواج

198
00:13:55,180 --> 00:13:57,060
،سُمِح لها بالبقاء في القصر الخلفيّ

199
00:13:57,060 --> 00:13:58,650
بدافع الشّفقة بواسطة الإمبراطور غالباً

200
00:14:00,650 --> 00:14:05,650
إذاً، لماذا تصرّفتْ بتلك الطّريقة
في جنازة المَحظيّة جين؟

201
00:14:06,070 --> 00:14:11,410
ببساطة. اعتقدتْ بأنّ جين كانت
المسؤولة عن مرضها

202
00:14:15,370 --> 00:14:16,410
وجدتُه

203
00:14:20,830 --> 00:14:22,460
مولايّ جينشي، ارتدِ هذا رجاء

204
00:14:23,130 --> 00:14:25,010
يا له من إجراء وقائيّ

205
00:14:25,010 --> 00:14:26,970
أجل، فهو شديد السّمِّية

206
00:14:39,600 --> 00:14:41,690
هذا... أين وجدتِه؟

207
00:14:42,060 --> 00:14:44,110
في الغابة في الطّرف الشّماليّ

208
00:14:44,110 --> 00:14:46,780
،لم تكن المنطقة مأهولة

209
00:14:46,780 --> 00:14:49,700
ما خلقَ البيئة الأمثل لهذا الفطر

210
00:14:49,700 --> 00:14:54,990
إنّه نادر جدّاً وبالغ الخطورة

211
00:14:54,990 --> 00:15:00,210
،إنّ تناول قطعة واحدة فقط تكفي للقتل
—ويمكن أن يُسبّب ضرراً بمجرّد اللّمس

212
00:15:00,210 --> 00:15:02,540
من فضلك لا تقترب أكثر

213
00:15:02,540 --> 00:15:05,170
سينتهي المطاف بك مثل المَحظيّة
جين وسون. هكذا تماماً

214
00:15:08,760 --> 00:15:11,760
،صادفتُ نفس الفطر في الماضي

215
00:15:11,760 --> 00:15:13,720
عندما كنتُ أفتّش عن أعشاب رفقة أبي

216
00:15:13,720 --> 00:15:14,930
لمستِه؟

217
00:15:14,930 --> 00:15:18,520
أجل. غسلتُها فوراً، لكن هذه هي النّتيجة

218
00:15:19,520 --> 00:15:22,770
هل هناك مزيد من النُّدب تحت هذه الضمادات؟

219
00:15:22,770 --> 00:15:26,400
لا، الأُخرى هي نتاج تجارب
أجريتُها على نفسي

220
00:15:26,400 --> 00:15:28,070
لحظة، أي تجارب؟

221
00:15:28,070 --> 00:15:28,780
هواية

222
00:15:28,780 --> 00:15:30,400
!ماذا تقصدين بـ"هواية"؟

223
00:15:30,900 --> 00:15:33,410
أعتقد لم أُرِه حتّى الآن

224
00:15:33,410 --> 00:15:35,740
على أيّ حال، هذا غير مهمّ إطلاقاً

225
00:15:35,740 --> 00:15:37,040
حقّاً؟

226
00:15:38,200 --> 00:15:43,170
كانت جثّة المَحظيّة جين مليئة بالطّفح
الجلديّ، وفقدت الكثير من الشّعر

227
00:15:43,750 --> 00:15:47,630
مولايّ جينشي، هل كنتَ تبحث
عن مصدر هذا السُّمّ؟

228
00:15:48,340 --> 00:15:50,260
إنّها ذكيّة كالعادة

229
00:15:53,050 --> 00:15:56,760
قبل عامين، أُصيبت المَحظيّة سون
،بمرض غامض فجأة

230
00:15:56,760 --> 00:15:59,020
واشتُبِه بأنّ السُّمّ هو السّبب

231
00:15:59,470 --> 00:16:01,560
...وأُشيع بأنّ الجاني هو

232
00:16:02,310 --> 00:16:03,350
المَحظيّة جين

233
00:16:03,690 --> 00:16:09,690
أجل. لكن لم نستطع الإثبات
بأنّها كانت هي

234
00:16:09,690 --> 00:16:15,120
ثمّ قبل عام، ظهرت نفس الأعراض
على المَحظيّة جين كذلك

235
00:16:15,620 --> 00:16:19,370
لا بدّ أنّها حاولت استخدام نفس السّمّ
على شخصٍ ما ولمسته بالخطأ

236
00:16:20,040 --> 00:16:21,960
ومنذ ذلك الحين، أُصيبت المَحظيّة
،جين بحالة اكتئاب

237
00:16:21,960 --> 00:16:23,830
كما لو أنّها شخص مختلف

238
00:16:25,000 --> 00:16:30,090
،ذهبتُ لرؤيتها مرّة في الشّهر على الأقلّ
لكن كانت بالكاد تستطيع التكلُّم

239
00:16:30,960 --> 00:16:33,260
كانت امرأة معتزّة جدّاً بنفسها

240
00:16:33,800 --> 00:16:36,260
،عاجزةً عن تحمُّل الأمر أكثر من ذلك
تجرّعت السُّمّ لتنتحر

241
00:16:36,680 --> 00:16:40,060
هذه شهادة النّساء اللّواتي خدمنَها على أيّ حال

242
00:16:40,770 --> 00:16:44,230
...إنّها منطقيّة كقصّة. لكن

243
00:16:45,100 --> 00:16:48,230
تُوفّيت المَحظيّة جين جرّاء أكل
الفطر السّامّ، أليس كذلك؟

244
00:16:48,610 --> 00:16:49,520
صحيح

245
00:16:49,520 --> 00:16:51,480
هناك تناقُضات

246
00:16:52,030 --> 00:16:53,450
ماذا تقصدين؟

247
00:16:54,360 --> 00:16:59,280
يُسبِّب هذا الفطر ألماً في المعدة
وإقياء وشلل عند تناوله

248
00:16:59,620 --> 00:17:02,200
،كان ليُسبّب التهاباً داخل الفم

249
00:17:02,200 --> 00:17:04,870
لكن لم أسمع من قبل بأنّه ينتشر
إلى بقيّة أنحاء الوجه

250
00:17:05,330 --> 00:17:06,120
حقّاً؟

251
00:17:06,580 --> 00:17:11,710
أجل. ظهرت الالتهابات في وجهها
حديثاً بعض الشّيء

252
00:17:11,710 --> 00:17:15,300
وكأنّ شخصاً فركَ وجهها بالفطر السّامّ

253
00:17:15,300 --> 00:17:18,260
بينما كانت يداها نظيفتين جدّاً

254
00:17:18,260 --> 00:17:19,600
...كان الالتهاب على

255
00:17:24,520 --> 00:17:26,440
إن كان لديكِ ما تقولينه، فقوليه

256
00:17:32,150 --> 00:17:33,780
هل يمكنك أن تُمهلني بضعة أيّام؟

257
00:17:34,400 --> 00:17:38,870
وأيضاً، سأحتاج بضعة مخصيّين يكتمون
السرّ ويؤدّون بعض الأعمال الشّاقّة

258
00:17:40,870 --> 00:17:42,540
لا يمكنني الجزم

259
00:17:43,120 --> 00:17:44,120
افعليها على أيّ حال

260
00:17:45,830 --> 00:17:49,130
أعتقد بأنّ اعتباره "أمر" يُسهّل
العمل بالنّسبة لي

261
00:17:50,210 --> 00:17:51,710
عُلِم

262
00:17:54,510 --> 00:17:59,050
ما الّذي تحاول شاوماو اكتشافه يا تُرى؟

263
00:17:59,050 --> 00:18:01,300
...لا أعلم أيضاً. لكن

264
00:18:01,760 --> 00:18:05,850
عندما تتصرّف الصّيدلانيّة بهذا الشّكل، فهي
تبحث عن آخر قطعة من الدّليل

265
00:18:26,250 --> 00:18:27,410
وصلنا

266
00:18:29,580 --> 00:18:30,580
...فطور

267
00:18:31,420 --> 00:18:33,750
هل يمكنكم الحفر هنا؟

268
00:18:33,750 --> 00:18:34,590
عُلِم

269
00:18:46,720 --> 00:18:47,930
...هذه الرّائحة

270
00:19:00,610 --> 00:19:02,780
هذا هو دليلكِ إذاً

271
00:19:03,530 --> 00:19:06,950
لكن لم أتوقّع أن أجده من أوّل مُحاولة

272
00:19:09,040 --> 00:19:12,580
تحقَّقوا من أنّ الجثّة كانت بالفعل
جثّة المَحظيّة جين

273
00:19:12,580 --> 00:19:14,790
كان شِعارها موجوداً في الزّينة الّتي ترتديها

274
00:19:15,250 --> 00:19:17,960
،لا أعلم ما إن كانت جريمة قتل أو حادثة

275
00:19:17,960 --> 00:19:20,180
لكن لا بدّ أنّها ماتت منذ عام

276
00:19:20,720 --> 00:19:22,970
عقب مرضها مُباشرة؟

277
00:19:22,970 --> 00:19:25,640
أجل. المَحظيّة جين الحقيقيّة
،كانت مدفونة في الغابة

278
00:19:26,060 --> 00:19:28,600
وحلّتْ مكانها مُنتحلة

279
00:19:28,980 --> 00:19:31,140
...إذاً، الجثّة في الجنازة كانت

280
00:19:32,520 --> 00:19:34,770
هل سمعتُما بسيّدة البلاد المفقودة؟

281
00:19:35,520 --> 00:19:39,610
امرأة تُدعى تاو، اختفتْ قبل زواجها

282
00:19:40,530 --> 00:19:42,780
ألا تعتقدان بأنّها تُشبه المَحظيّة جين؟

283
00:19:43,910 --> 00:19:47,290
سألتُ في الأرجاء، ويبدو أنّ قوامهما مُتشابهان

284
00:19:47,870 --> 00:19:51,080
،بتغطية وجهها، لن يتمكّن أحدٌ من تمييزها

285
00:19:51,080 --> 00:19:52,790
باستثناء خادماتها المُباشرات ربّما

286
00:19:53,210 --> 00:19:56,920
لن يكون من الصّعب خِداع زائر
يأتي مرّة في الشّهر

287
00:19:57,380 --> 00:20:02,680
إذاً، كانت تاو هذه تتآمر مع وصيفات
المَحظيّة جين؟

288
00:20:03,050 --> 00:20:06,390
هذا ما أعتقده، لكن لا أعرف أي تفاصيل

289
00:20:09,850 --> 00:20:11,770
لديّ حدس شخصيّ بالطّبع

290
00:20:12,390 --> 00:20:14,020
لعلّ ذلك حُفِّز بواسطة الغيرة

291
00:20:14,310 --> 00:20:16,440
ربّما لم تكن المَحظيّة جين مسرورة بحقيقة

292
00:20:16,440 --> 00:20:19,190
أنّ سيّدة بلاط تُشبهها عثرت على الحُبّ

293
00:20:20,400 --> 00:20:24,030
في حالتها، لم يكن الإمبراطور يزورها أصلاً

294
00:20:24,490 --> 00:20:27,830
كانت تاو غالباً تتلقّى مُعاملة
سيّئة بشكل دائم

295
00:20:27,830 --> 00:20:30,290
ثمّ وقع جِدال ما

296
00:20:30,290 --> 00:20:33,040
حادثة ما أدّت إلى وفاة المَحظيّة جين

297
00:20:33,620 --> 00:20:36,830
والوصيفات، ربّما للحِفاظ على أنفسهن
،وتعاطُفاً مع تاو

298
00:20:36,830 --> 00:20:39,460
اقترحنَ التستُّر على وفاة المَحظيّة جين

299
00:20:39,800 --> 00:20:42,300
لم تستطع تاو الرّفض بالطّبع

300
00:20:43,840 --> 00:20:46,140
،لكن مع ازدياد الأحاديث عن زواجها جدّية

301
00:20:46,140 --> 00:20:49,260
فقد أمسى الحِفاظ على انتحالها صعباً

302
00:20:52,640 --> 00:20:57,360
سأكتفي بهذا القدر. يستطيع المسؤولون
تلفيق أيّ دافع يريدونه

303
00:20:57,940 --> 00:21:01,820
لكن كيف اكتشفتِ مكان دفن الجثّة؟

304
00:21:01,820 --> 00:21:04,240
تُرِك دليل

305
00:21:04,240 --> 00:21:05,320
دليل؟

306
00:21:07,320 --> 00:21:08,320
!فطور

307
00:21:08,740 --> 00:21:10,410
الفطور في المنطِقة

308
00:21:10,410 --> 00:21:13,580
!تنمو على جِيَف الحيوانات وبرازها

309
00:21:13,580 --> 00:21:16,420
لا عجب في أنّه كانت هناك
رائحة عفِنة وغريبة

310
00:21:16,420 --> 00:21:20,550
من كان يتوقّع أن أستمتع بالبحث
!عن فطور تنمو على جثّة؟

311
00:21:23,090 --> 00:21:25,300
ماذا ستفعلين بالفطور؟

312
00:21:28,300 --> 00:21:30,850
هذه فطور مُثيرة جدّاً للاهتمام

313
00:21:30,850 --> 00:21:32,640
فطور تنمو على الجثث؟

314
00:21:32,640 --> 00:21:36,060
،إنّها لا تنمو بشكل مُباشر على الجثث
...مثل فطور اليسروع

315
00:21:37,560 --> 00:21:40,650
،بـ-بالإضافة إلى هذا، لو كانت كذلك
—لسُمّيت بفطور الجثّة بدلاً

316
00:21:40,650 --> 00:21:41,730
!صادرها

317
00:21:49,200 --> 00:21:51,740
...إنّه مجرّد فضول بريء

318
00:21:59,580 --> 00:22:02,590
...فطر ينمو على جثّة

319
00:22:05,130 --> 00:22:06,670
،إن كان يوجد شيء كهذا

320
00:22:07,880 --> 00:22:09,470
،فكيف سيكون شكله

321
00:22:10,220 --> 00:22:12,640
وماذا ستكون آثاره؟

322
00:23:45,020 --> 00:23:59,950
الحلقة القادمة

323
00:23:56,370 --> 00:23:59,030
"الحلقة القادمة: "مرايا