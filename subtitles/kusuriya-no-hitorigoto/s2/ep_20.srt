1
00:01:30,980 --> 00:01:33,980
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

2
00:01:39,770 --> 00:01:41,000
سويري

3
00:01:41,000 --> 00:01:41,990
—نعم

4
00:01:45,000 --> 00:01:48,330
اضبطي جرذانك

5
00:01:48,330 --> 00:01:49,780
أعتذر

6
00:01:50,550 --> 00:01:51,420
ماذا؟

7
00:01:52,570 --> 00:01:54,920
رأيتُ هذا الطّفل من قبل

8
00:01:56,490 --> 00:01:59,720
...مـ-مولاتي شينمي، أنا آسف

9
00:02:00,110 --> 00:02:02,240
إنّه ابن شيرو الوقور

10
00:02:03,550 --> 00:02:05,310
مُجرّد أطفال يلعبون

11
00:02:10,900 --> 00:02:13,980
لنذهب بسرعة يا أمّي

12
00:02:14,660 --> 00:02:15,750
روران

13
00:02:18,330 --> 00:02:21,280
إذاً، كما توقّعت

14
00:02:21,620 --> 00:02:25,830
معك حقّ. لنُؤنّب هذه الفتاة بالعصا إذاً

15
00:02:26,410 --> 00:02:29,150
هل ينبغي أن تكون مئة ضربة كافية؟

16
00:02:29,150 --> 00:02:31,880
ابحثوا لي عن عمود متين لربطها به

17
00:02:32,250 --> 00:02:34,060
—مولاتي شينمي، هذا

18
00:02:38,240 --> 00:02:39,380
هذا سيّئ

19
00:02:39,690 --> 00:02:41,530
هذه المرأة مُزعجة

20
00:02:41,530 --> 00:02:44,470
دخلتُ خلسة دون إذن ورأيتُ الفيفا

21
00:02:44,980 --> 00:02:47,630
"سيتمّ إعدامي غالباً عن طريق "الخطأ

22
00:02:47,630 --> 00:02:49,310
بسرعة

23
00:02:49,310 --> 00:02:50,400
أُمّي

24
00:02:50,860 --> 00:02:55,410
ذكرتِ من قبل أنّكِ أردتِ صيدلانيّة جديدة

25
00:02:55,410 --> 00:02:57,150
هذه هي الفتاة

26
00:03:00,330 --> 00:03:02,770
لا تبدو كصيدلانيّة

27
00:03:02,770 --> 00:03:07,370
لا. لكن عمرها أكثر من 30 سنة

28
00:03:08,810 --> 00:03:13,540
،يبدو أنّه بعد تجربة عقاقير على نفسها
لم تعُد تشيخ

29
00:03:14,110 --> 00:03:15,540
ماذا؟

30
00:03:15,540 --> 00:03:18,350
،لم نستطع تحديد العقّار بعد

31
00:03:18,350 --> 00:03:21,780
لكن تستطيع حتماً صنع شيء
قريب من جرعة خلود

32
00:03:22,500 --> 00:03:25,940
إذا فَشِلَتْ، فستموت فحسب كالرّجل السّابق

33
00:03:25,940 --> 00:03:28,680
جرعة خلود؟ من هو "الرّجل السّابق"؟

34
00:03:29,110 --> 00:03:31,660
فهمت. هكذا إذاً

35
00:03:32,100 --> 00:03:35,440
سيّدة آيلا، لنُتابع نقاشنا لاحقاً

36
00:03:36,180 --> 00:03:37,100
حسناً

37
00:03:40,740 --> 00:03:42,030
بالمُناسبة

38
00:03:42,670 --> 00:03:45,530
لا بُدّ أنّه من الصّعب إنجاز
أي عمل حقيقيّ هنا

39
00:03:46,230 --> 00:03:48,790
،لنأخذ الصّيدلانيّة معنا

40
00:03:49,410 --> 00:03:51,640
إلى حصننا

41
00:03:56,600 --> 00:04:00,390
كانت هويّة شيسوي الحقيقيّة
هي المَحظيّة روران

42
00:04:01,140 --> 00:04:05,660
يا لها من مُمثّلة. أو رُبّما هي
أقرب إلى تانوكي

43
00:04:06,590 --> 00:04:09,200
عندما ألقيتُ تلك المُحاضرة
،على المَحظيّات الأربع

44
00:04:09,600 --> 00:04:13,350
كانت ترتدي ذلك الزيّ المُبهرج
وأصغتْ بتعابير جامدة تماماً

45
00:04:14,140 --> 00:04:19,150
اختبأتْ من الأرملة الإمبراطورة وتجنّبت
المحظيّة ريشو في الحمّامات

46
00:04:19,510 --> 00:04:22,900
وذلك كي لا تُعرَف على أنّها المَحظيّة روران

47
00:04:23,790 --> 00:04:25,910
،لم تختبئ منّي

48
00:04:25,910 --> 00:04:30,450
بما أنّني لم أعرفها على أنّها المَحظيّة
روران عندما أمسكنا بالقطّة ماوماو

49
00:04:31,270 --> 00:04:33,520
...كنتُ قد بدأتُ أشعر، كن

50
00:04:34,320 --> 00:04:40,300
مُجرّد فتاة مُحبّة للحشرات ثرثارة
غريبة أطوار

51
00:04:41,820 --> 00:04:45,690
تلاعبَتْ شيسوي بنا جميعاً

52
00:04:53,800 --> 00:04:56,350
هذه هي الغرفة الّتي استخدمها
الصّيدلانيّ السّابق

53
00:05:01,450 --> 00:05:04,990
لم أُرِد إحضارك كلّ الطّريق إلى هنا

54
00:05:06,040 --> 00:05:10,330
هل أنتِ الأخت غير الشّقيقة لشيسوي؟

55
00:05:11,620 --> 00:05:15,820
إنّها الوحيدة الّتي تُعاملني كأخت

56
00:05:15,820 --> 00:05:16,920
توقّعت

57
00:05:17,960 --> 00:05:21,250
،سمعتُ بأنّ روران هي الابنة الوحيدة لشيشو

58
00:05:21,250 --> 00:05:24,420
لكن إذا كان لديه ابنة أُخرى
...من امرأة مُختلفة

59
00:05:25,160 --> 00:05:29,930
فسيكون ذلك لا يُغتفَر بالنّسبة
لزوجته المُرعبة شينمي

60
00:05:30,700 --> 00:05:35,020
مولاتي شينمي تكرهني أكثر من أيّ شيء آخر

61
00:05:35,940 --> 00:05:40,810
أبي، شيشو، هو في الأصل من العائلات
الفرعيّة لعشيرة شي

62
00:05:41,220 --> 00:05:46,700
غير أنّ العائلة الرّئيسيّة، عائلة مولاتي
شينمي، اكتشفَتْ مواهبه وتبنّتْه

63
00:05:47,150 --> 00:05:51,440
مُنِح اسم "شيشو" وخطبَها

64
00:05:52,210 --> 00:05:53,880
،لكن أثناء حكم الإمبراطور الرّاحل

65
00:05:53,880 --> 00:05:56,490
نُقِلَتْ مولاتي شينمي إلى القصر الخلفيّ

66
00:05:57,130 --> 00:06:01,260
،عندما أُعيدَتْ لاحقاً كهديّة

67
00:06:01,260 --> 00:06:04,050
كنتُ أنا وأمّي بالفعل مع أبي

68
00:06:04,710 --> 00:06:08,460
مولاتي شينمي طردَتْني أنا وأمّي
،إلى خارج القصر

69
00:06:08,460 --> 00:06:10,600
واستخدمَتْنا كخادمتين

70
00:06:11,140 --> 00:06:13,430
وحتّى أنّها كانت تكره حقيقة

71
00:06:13,430 --> 00:06:17,310
أنّ اسمي يحتوي على حرف
يُشير إلى اسم عشيرتنا

72
00:06:18,030 --> 00:06:20,230
...لحظة، إذاً "شيسوي" هو

73
00:06:21,250 --> 00:06:24,530
أجل. كان اسمي في الأصل

74
00:06:24,530 --> 00:06:27,490
يبدو أنّ روران تُحبّ هذا الاسم

75
00:06:28,020 --> 00:06:32,950
كان بمقدورها اختيار أي اسم آخر
كاسم مستعار لخادمة

76
00:06:35,700 --> 00:06:37,410
هكذا هو طبعها

77
00:06:38,740 --> 00:06:41,520
،رغم أنّهما وُلِدتا من نفس الأب

78
00:06:41,520 --> 00:06:43,420
،فقط لكون اختلاف والدتيهما

79
00:06:43,990 --> 00:06:49,150
عومِلَتْ واحدة كأميرة ثمينة
لتُمنَح للإمبراطور

80
00:06:50,210 --> 00:06:55,260
بينما أُرسِلَت الأُخرى كفتاة بلاط لحياكة
مُؤامرات في ظلال القصر الخلفيّ

81
00:06:57,400 --> 00:07:02,350
كانت سويري جزءاً من مُحاولة اغتيال
لمولايّ جينشي في تلك المراسم

82
00:07:03,450 --> 00:07:06,110
استخدمَتِ الانفجارَ في المخزن كغطاء

83
00:07:06,110 --> 00:07:07,610
،لسرقة بعض الأدوات الاحتفاليّة

84
00:07:07,610 --> 00:07:10,280
وعندما كُشِفَ أمرها، هربَتْ مُتظاهرة بالموت

85
00:07:11,180 --> 00:07:17,610
لا بُدّ أنّ شيشو كان العقل المُدبّر
لهجوم الفيفا قبل أيّام

86
00:07:18,200 --> 00:07:23,550
،مولايّ جينشي، مُدير القصر الخلفيّ
كان يُحاول إجراء تغييرات

87
00:07:23,550 --> 00:07:25,670
لم يتوافق ذلك مع ما كان يفعله شيشو

88
00:07:26,580 --> 00:07:28,940
لكن أهذا كلّ شيء؟

89
00:07:30,670 --> 00:07:35,430
شيسوي... أقصد، قالت روران
بأنّ عود الشّعر هذا قيّم

90
00:07:36,050 --> 00:07:37,310
إنّه ليس مُجرّد مسؤول

91
00:07:37,850 --> 00:07:40,430
بالأحرى، لم يكن مخصيّاً حتّى

92
00:07:40,980 --> 00:07:42,030
ما المُشكلة؟

93
00:07:43,170 --> 00:07:46,130
عندما عدتِ إلى القصر الخلفيّ
،مُتظاهرة بأنّك شخص مخصيّ

94
00:07:46,130 --> 00:07:47,820
كيف فتّشوكِ؟

95
00:07:49,110 --> 00:07:50,650
لِمَ هذا السّؤال فجأة؟

96
00:07:52,330 --> 00:07:53,950
كان باللّمس

97
00:07:54,360 --> 00:07:56,530
هل كان يُسمَح لرجل غير مخصيّ بالدّخول؟

98
00:07:57,030 --> 00:07:59,240
يتمّ التّفتيش الجسديّ بواسطة ثلاثة مسؤولين

99
00:07:59,960 --> 00:08:02,110
سيكون من الصّعب خداعهم جميعاً

100
00:08:03,030 --> 00:08:05,960
إذاً كيف دخل مولايّ جينشي؟

101
00:08:06,840 --> 00:08:09,230
الرّجال الوحيدون القادرون على الدّخول
والخروج من القصر الخلفيّ متى أرادوا

102
00:08:09,230 --> 00:08:11,440
هُم الإمبراطور بنفسه وأقرباؤه المُقرَّبون

103
00:08:12,120 --> 00:08:15,640
القريب الذّكر المُقرّب الوحيد للإمبراطور
هو أخوه الأصغر

104
00:08:15,940 --> 00:08:19,970
فكّرتُ في ذلك، لكن العمر غير مُتوافق

105
00:08:20,460 --> 00:08:26,480
لكن ماذا لو كان ذلك الجانب الفتيّ الّذي يُبرزه
مولايّ جينشي أحياناً هو طبيعته الحقيقيّة؟

106
00:08:28,210 --> 00:08:29,480
،على ذكر الأمر

107
00:08:30,210 --> 00:08:34,530
كان يحاول أن يخبرني بشيء
...مُهمّ أثناء ذلك الصّيد

108
00:08:34,530 --> 00:08:35,770
!بازهر الثّور

109
00:08:35,770 --> 00:08:39,280
يستطيع بازهر الثّور إثارة جنون
شخص. كم هذا مُريع

110
00:08:39,280 --> 00:08:40,580
ما الأمر؟

111
00:08:40,580 --> 00:08:42,120
لا شيء

112
00:08:44,350 --> 00:08:45,240
!حسناً

113
00:08:45,240 --> 00:08:46,790
لنضع هذا جانباً حاليّاً

114
00:08:47,400 --> 00:08:49,800
أحتاج الآن لفهم ما يجري

115
00:08:53,400 --> 00:08:54,510
...ثلج

116
00:08:54,510 --> 00:08:58,150
أجل، سوف تتساقط الثّلوج بغزارة قريباً

117
00:08:58,950 --> 00:09:00,970
...المُرتفعات الشّماليّة

118
00:09:01,570 --> 00:09:04,020
"أطلقتْ شينمي على هذا بـ"الحصن

119
00:09:04,490 --> 00:09:07,850
مُحاط بأسوار متينة مدعومة بمُنحدر

120
00:09:08,780 --> 00:09:10,860
ماذا تفعل شينمي هنا؟

121
00:09:12,070 --> 00:09:15,110
اشتبه السيّد غاوشون بأنّ المبعوثة الخاصّة

122
00:09:15,110 --> 00:09:18,120
تسلّلتْ للخارج ليلاً لتلتقي
بشخص بشكل سرّي

123
00:09:18,790 --> 00:09:23,370
كانت تلك الورشة تصنع سلاحاً
...مُتطوّراً من الغرب، الفيفا

124
00:09:24,740 --> 00:09:27,370
هل تُحاولون جميعاً إشعال حرب؟

125
00:09:33,240 --> 00:09:35,670
لستُ من يُقرّر

126
00:09:38,900 --> 00:09:43,300
لأنّ السيّدة روران قالت ما قالَتْه، أريدكِ
أن تتظاهري بصنع الدّواء على الأقلّ

127
00:09:43,300 --> 00:09:44,910
ليس عليكِ أن تطلبي ذلك حتّى

128
00:09:45,450 --> 00:09:46,860
سيتمّ تأمين طعامكِ

129
00:09:47,340 --> 00:09:51,100
احرصي فقط على ألّا تُغضبي مولاتي شينمي

130
00:09:55,000 --> 00:09:58,390
حرب؟ يُخطّطون على نطاق واسع

131
00:09:58,390 --> 00:10:00,750
حسناً، ماذا الآن؟

132
00:10:01,620 --> 00:10:03,220
هذا هو الطّابق الثّالث

133
00:10:03,220 --> 00:10:07,640
بتساقُط الثُّلوج في الخارج، غالباً
لن أتمكّن من العودة إلى القرية

134
00:10:08,890 --> 00:10:12,600
هل كان هكذا قد حُبِس الصّيدلانيّ السّابق؟

135
00:10:13,380 --> 00:10:16,380
...بدا وكأنّه تُوفّي أثناء تجربة أدوية

136
00:10:18,260 --> 00:10:19,290
ماذا؟

137
00:10:19,290 --> 00:10:20,140
!ماذا؟

138
00:10:20,140 --> 00:10:23,830
!كومة من الكنوز تركَها الصّيدلانيّ السّابق؟

139
00:10:32,690 --> 00:10:35,470
سينتهي موسم الزّراعة قريباً

140
00:10:36,050 --> 00:10:40,860
سمعتُ في مكان ما أنّ الحروب تندلع
عندما لا يكون المُزراعين مشغولين

141
00:10:41,720 --> 00:10:43,990
...بفرض أنّ هذه شيهوكو-شو، المنطقة الشّماليّة

142
00:10:44,420 --> 00:10:46,760
،عشرة أيّام بالقارب من القصر الخلفيّ

143
00:10:46,760 --> 00:10:49,410
ثمّ إلى قرية الينابيع السّاخنة
،سيراً على الأقدام

144
00:10:49,410 --> 00:10:50,970
...ثمّ عربة خصان

145
00:10:51,470 --> 00:10:54,000
...أيّ جبل يقع ضمن هذا النّطاق

146
00:10:54,750 --> 00:10:57,950
كان ينبغي أن أدرس بجدّ أكبر

147
00:10:58,600 --> 00:11:02,010
!سيّدي الصّغير، لا ينبغي أن تلعب هناك

148
00:11:02,330 --> 00:11:06,390
!بربّكِ! لم أستكشف ذلك المكان بعد

149
00:11:08,230 --> 00:11:11,060
هناك أطفال آخرون غير كيو-يو كذلك؟

150
00:11:12,900 --> 00:11:15,470
،عندما أُحضِرتُ إلى هنا من القرية

151
00:11:15,470 --> 00:11:19,640
،أصرَّ كيو-يو على المجيء أيضاً
لكن بدتْ سويري مُتردّدة

152
00:11:20,050 --> 00:11:22,990
لعلّها أرادت أن يبقى في القرية

153
00:11:23,720 --> 00:11:30,990
إذا تمرّدتْ عشيرة شي، فإنّ العقوبة
سوف تطال العشيرة بأكملها

154
00:11:31,460 --> 00:11:35,250
لن يُعفَى أحد. ولا حتّى النّساء
والأطفال والرُّضَّع

155
00:11:37,770 --> 00:11:40,010
هل يعلم الأطفال؟

156
00:11:40,450 --> 00:11:43,240
هل أخبرهم البالغون؟

157
00:11:45,990 --> 00:11:49,530
كان ينبغي أن أعتبر هذه
...كمُشكلة شخص آخر

158
00:11:54,190 --> 00:11:56,010
أمّي تضحك

159
00:12:02,440 --> 00:12:04,230
هنا يجب أن أضحك

160
00:12:05,260 --> 00:12:07,450
أمّي غاضبة من أبي

161
00:12:08,250 --> 00:12:10,380
هنا يجب أن أغضب معها

162
00:12:11,170 --> 00:12:12,960
أُمّي تُعاقِب

163
00:12:13,570 --> 00:12:15,800
هنا يجب أن أُراقب فحسب

164
00:12:15,800 --> 00:12:16,960
هكذا فهمتُ الأمر

165
00:12:18,010 --> 00:12:20,300
عندما تضحك أُمّي، أضحك

166
00:12:20,300 --> 00:12:21,920
عندما تحزن، أحزن

167
00:12:22,470 --> 00:12:26,460
ما دمتُ دُميتها، فلن تغضب منّي

168
00:12:26,460 --> 00:12:28,480
حينئذ تتوقّف القباحة

169
00:12:29,050 --> 00:12:33,480
كان ذلك خانقاً وغير مُريح، لكن
كان لِزاماً عليّ تقبُّله

170
00:12:33,480 --> 00:12:34,410
...لكن

171
00:12:36,020 --> 00:12:39,980
!قذرة! أنتِ وتلك المرأة أيضاً

172
00:12:39,980 --> 00:12:42,600
!ما كان ينبغي أن تُوَدي أبداً

173
00:12:43,130 --> 00:12:44,950
كنتُ على خطأ

174
00:12:45,380 --> 00:12:47,660
ستستمرّ أُمّي في كونها قبيحة

175
00:12:48,430 --> 00:12:52,710
التصرُّف كدُمية لأُمّي لن يوقفها

176
00:12:58,370 --> 00:13:00,670
لا جدوى من كلّ ذلك

177
00:13:01,990 --> 00:13:06,680
لاحظتُ ذلك مُتأخِّرة

178
00:13:12,630 --> 00:13:13,510
أنتِ

179
00:13:15,100 --> 00:13:17,100
تريد مولاتي شينمي التكلّم معكِ

180
00:13:19,380 --> 00:13:21,120
أحضرتُ الصّيدلانيّة

181
00:13:21,590 --> 00:13:22,690
المعذرة

182
00:13:24,850 --> 00:13:26,630
...رائحة مِسك

183
00:13:33,900 --> 00:13:36,220
خلطَتْ شيئاً ما

184
00:13:36,620 --> 00:13:38,040
وبعد؟

185
00:13:42,750 --> 00:13:45,470
أين جرعة خلودي؟

186
00:13:45,960 --> 00:13:47,760
قد يستغرق ذلك بعض الوقت

187
00:13:48,330 --> 00:13:49,440
هكذا إذاً

188
00:13:51,550 --> 00:13:53,720
إنّهما كسيّدة وخادمتها

189
00:13:54,160 --> 00:13:56,430
في الخارج، إنّهما أختان مُقرّبتان

190
00:13:56,430 --> 00:13:59,060
أتوقّع سماع نتيجة ما غداً

191
00:14:00,410 --> 00:14:01,110
حاضرة

192
00:14:04,530 --> 00:14:05,520
سنعود

193
00:14:06,840 --> 00:14:11,160
،يُسمَح لي بمُغادرة الغرفة مرّة في اليوم
وذلك لتسليم تقريري

194
00:14:11,720 --> 00:14:13,980
،هذا الوضع الّذي أنا فيه مُزعج للغاية

195
00:14:13,980 --> 00:14:15,750
،لكن لا أكره العمل الفعليّ

196
00:14:16,710 --> 00:14:18,660
،كثير من الأدوية هنا قديمة

197
00:14:18,660 --> 00:14:21,660
لكن البضاعة مُدهشة مُقارنة بمكتب الطّبيب

198
00:14:21,660 --> 00:14:23,590
والكثير من الكُتُب أيضاً

199
00:14:24,000 --> 00:14:27,850
لا بُدّ أنّ الصّيدلانيّ السّابق كان ماهراً

200
00:14:28,550 --> 00:14:30,260
!أيّتها الصّيدلانيّة

201
00:14:33,550 --> 00:14:35,640
نعم يا مولايّ كيو-يو؟

202
00:14:35,640 --> 00:14:37,480
!هذا مُخيف جدّاً

203
00:14:37,480 --> 00:14:40,020
!مُؤلم! هذا مُؤلم أيّتها الصّيدلانيّة

204
00:14:37,960 --> 00:14:39,530
أجل، أريد أن أضربه

205
00:14:40,330 --> 00:14:41,460
من هذه؟

206
00:14:41,460 --> 00:14:43,650
الصّيدلانيّة الجديدة

207
00:14:43,650 --> 00:14:48,160
اسمعي، هل رأيتِ امرأة أُخرى
في غرفة مولاتي شينمي؟

208
00:14:48,770 --> 00:14:50,250
أجل

209
00:14:50,250 --> 00:14:54,740
حقّاً؟! يُفترَض أن تكون أُمّي
هناك. كيف حالها؟

210
00:14:55,320 --> 00:14:58,500
كانت أُمّ كيو-يو بينهن؟

211
00:15:01,580 --> 00:15:04,550
لا أعرف شكلها، لذا لا أستطيع الإجابة

212
00:15:04,850 --> 00:15:06,270
هكذا إذاً

213
00:15:06,970 --> 00:15:08,560
!هذا مُؤسف جدّاً

214
00:15:08,560 --> 00:15:11,250
يُقال بأنّ أُمّي مشغولة جدّاً بالعمل

215
00:15:11,250 --> 00:15:14,140
ربّما كان ينبغي أن أنتظر في القرية

216
00:15:14,630 --> 00:15:19,440
لا بُدّ أنّهم أبقوه في قرية الينابيع
السّاخنة لإبعاده عن أُمّه

217
00:15:19,440 --> 00:15:22,100
...أو ربّما أُمّه

218
00:15:23,650 --> 00:15:25,680
حسناً، أستأذن بالانصراف

219
00:15:28,730 --> 00:15:29,900
!أنتِ

220
00:15:36,420 --> 00:15:37,790
!لا شيء

221
00:15:48,750 --> 00:15:50,920
هذا ما في الأمر إذاً يا لاهان

222
00:15:51,340 --> 00:15:55,800
أجل. إنّه مُجرّد حدس، استناداً
...إلى الأرقام. لكن

223
00:15:56,250 --> 00:16:00,940
الحصن في الشّمال، والمحكوم
بواسطة شيشو، يتوسّع

224
00:16:00,940 --> 00:16:04,570
أجل. كان مهجوراً في الأصل

225
00:16:04,970 --> 00:16:08,360
لم يُذكَر لنا أنّه سوف يتوسّع

226
00:16:08,360 --> 00:16:09,860
...بصيغة أُخرى

227
00:16:10,580 --> 00:16:12,400
تمرُّد

228
00:16:12,830 --> 00:16:16,410
حتّى لو أقسمتْ عشيرةُ شي بالولاء
،منذ فترة الأُمّ الملِكة

229
00:16:16,410 --> 00:16:19,260
ولو كان شيشو بحدّ ذاته هو المُستشار
،الأقرب للأرملة الإمبراطورة

230
00:16:19,260 --> 00:16:21,370
هذا لا يُغتفَر

231
00:16:21,700 --> 00:16:23,300
إلى أي حدّ وصلوا؟

232
00:16:27,380 --> 00:16:30,510
فلا بُدّ أنّهم أحرزوا تقدُّماً
كبيراً في تحضيراتهم

233
00:16:30,510 --> 00:16:32,180
—أنصح بتصرُّف عاجل

234
00:16:32,840 --> 00:16:35,340
،ماذا تفعل بالضّبط

235
00:16:35,640 --> 00:16:37,010
يا لاهان؟

236
00:16:37,280 --> 00:16:39,350
...أ-أبي

237
00:16:39,880 --> 00:16:41,220
الخبير الاستراتيجيّ

238
00:16:41,690 --> 00:16:45,940
لا يجوز أن تزور هذا النّبيل الثّمين كثيراً

239
00:16:46,390 --> 00:16:48,830
فقد تُثير بعض التّساؤلات

240
00:16:51,150 --> 00:16:56,360
لا سيّما لأنّه من الصّعب التّمييز فيما
إذا كان هذا النّبيل رجلاً أو امرأة

241
00:16:56,360 --> 00:16:57,440
!ماذا؟

242
00:16:57,440 --> 00:16:58,100
!باسين

243
00:16:58,100 --> 00:16:59,200
...لكن يا أبي

244
00:17:00,340 --> 00:17:01,560
سيّد غاوشون

245
00:17:05,390 --> 00:17:07,960
الخبير الاستراتيجيّ، أفهم ما تُحاول قوله

246
00:17:08,520 --> 00:17:10,960
أنت مستاء من جبني وقلّة حيلتي

247
00:17:10,960 --> 00:17:12,510
تماماً

248
00:17:13,830 --> 00:17:16,750
،نظراً إلى ولعه بابنته

249
00:17:16,750 --> 00:17:18,760
من المُفاجئ أن يتأخّر كثيراً في الظّهور

250
00:17:19,530 --> 00:17:20,810
،طريق الهرب السرّي

251
00:17:21,620 --> 00:17:23,380
،والمخصيّ المفقود

252
00:17:24,010 --> 00:17:26,940
...والخادمة غير الموجودة شيسوي

253
00:17:27,770 --> 00:17:32,200
.كنّا مُتخلّفين خطوة من كلّ ناحية
ما أدّى إلى اختطاف ماوماو

254
00:17:33,530 --> 00:17:34,950
أنا المسؤول عن هذا

255
00:17:35,500 --> 00:17:38,730
على الرّغم من حضور شخص

256
00:17:38,730 --> 00:17:41,160
يستطيع الدّخول والخروج من القصر
،الخلفيّ متى شاء

257
00:17:41,160 --> 00:17:43,240
!اختُطِفت ابنتي

258
00:17:43,240 --> 00:17:49,210
وذلك الشّخص يستغرق وقته
بترف في مُعاملاته الورقيّة

259
00:17:49,650 --> 00:17:54,840
هل يمكنني أن أفترض بأنّك لا تُبالي
لحياة امرأة واحدة؟

260
00:17:55,450 --> 00:17:57,070
سأسمح لك بالتّنفيس عن غضبك

261
00:17:57,660 --> 00:18:00,720
لكن عدوّنا هو شيشو، لستُ أنا

262
00:18:02,980 --> 00:18:05,570
ما أقصده هو أنّك الآن كشفتَ كلّ شيء

263
00:18:05,570 --> 00:18:08,350
فلماذا ما زلتَ تجلس هنا؟

264
00:18:11,990 --> 00:18:14,120
إنّه يعرف كلّ شيء

265
00:18:14,900 --> 00:18:18,470
يعرف أنّني أفتقر للثِّقة بتولّي منصبي الشّرعيّ

266
00:18:18,930 --> 00:18:22,780
يعلم كيف هربتُ من منصبي
لقضاء وقتي هنا بدلاً من ذلك

267
00:18:23,830 --> 00:18:28,330
مظهرك، عملك... كلّ شيء ناقص

268
00:18:28,890 --> 00:18:31,770
وتعتقد بأنّ كلّ شيء سيفلح بطريقة ما؟

269
00:18:36,450 --> 00:18:42,800
ما الّذي يمكنك أن تُنجزه بالتصرُّف
!كمخصيّ بائس؟

270
00:18:51,240 --> 00:18:52,620
...أنا

271
00:18:53,420 --> 00:18:55,820
أعتذر

272
00:18:57,780 --> 00:18:59,610
!عـ-عمّي؟

273
00:19:06,870 --> 00:19:11,420
لم أعلم بأنّك تعتبرني هكذا

274
00:19:11,720 --> 00:19:16,050
ليس وكأنّني أردتُ أن أصبح مخصيّاً بإرادتي

275
00:19:16,050 --> 00:19:19,840
—لـ-لا! لم أكن أقصدك أنت

276
00:19:19,840 --> 00:19:25,140
.أنا "المخصيّ البائس" بالفعل
لا أستطيع حتّى المشي جيّداً

277
00:19:25,530 --> 00:19:29,600
نُقِلتُ إلى هنا بعربة. كم أنا باذخ

278
00:19:29,890 --> 00:19:37,250
أنا مسؤول أيضاً عن عدم الانتباه لماوماو

279
00:19:37,250 --> 00:19:41,610
...لـ-لا، لا ألومك إطلاقاً يا عمّي

280
00:19:44,440 --> 00:19:45,490
لقد وصل

281
00:19:45,840 --> 00:19:49,870
سرعان ما تصبح عدوانيّاً عندما تغضب

282
00:19:49,870 --> 00:19:54,760
ينبغي أن تُفكّر في ظروف الآخرين أيضاً

283
00:19:54,760 --> 00:19:57,050
أعلم يا عمّي

284
00:19:57,050 --> 00:19:59,720
كلّ ما في الأمر أنّ المُحادثة اتّخذتْ
منحى غير مُتوقَّع

285
00:19:59,720 --> 00:20:03,220
!لم أقصد قول ذلك الكلام، البتّة

286
00:20:03,660 --> 00:20:06,970
...مُحادثة"؟! لم أقل شيئاً"

287
00:20:06,970 --> 00:20:09,600
ربّما ينبغي لك أن تقول كلاماً مُهذّباً

288
00:20:09,600 --> 00:20:13,900
قبل البدء بشجار، أليس كذلك؟

289
00:20:46,250 --> 00:20:48,180
أتيتُ لألتمس إليك

290
00:20:48,950 --> 00:20:53,900
أطلب منك وبكلّ تواضُع أن تحشد
!الجيش لهزيمة شيشو، الخائن

291
00:21:02,990 --> 00:21:05,150
يبدو أنّ عشيرة شي كانت تُصنّع

292
00:21:05,150 --> 00:21:08,240
نموذجاً مُتطوِّراً من فيفا منذ عدّة سنوات

293
00:21:08,540 --> 00:21:10,950
وهناك أيضاً مُحاولة الاغتيال
،باستخدام الفيفا المذكور

294
00:21:11,420 --> 00:21:14,160
وكذلك قضيّة هرب روران

295
00:21:14,160 --> 00:21:17,350
لدينا كلّ الأدلّة الّتي تُثبِت بأنّ هذا تمرُّد

296
00:21:17,350 --> 00:21:19,630
يجب أن تُعالَج هذه المُشكلة على وجه السّرعة

297
00:21:21,800 --> 00:21:26,040
،هذا التّهذيب لا يشمل جينشي المخصيّ

298
00:21:27,240 --> 00:21:30,910
إذا كان شيشو سيُسقَط كعقوبة
،على التمرُّد

299
00:21:31,640 --> 00:21:37,160
فيجب أن يتمّ حشد الجيش المُحرَّم
الّذي تحت أمرة الإمبراطور مُباشرة

300
00:21:38,020 --> 00:21:43,290
لن يكون تحت قيادة الآمر العسكريّ
...العظيم لاكان، لكن

301
00:21:44,010 --> 00:21:51,870
إلى متى تنوي خداع الجميع
بدورك المُزيّف يا سيّد جينشي؟

302
00:21:52,300 --> 00:21:53,410
...أو بالأحرى

303
00:21:53,990 --> 00:21:55,440
يا أمير القمر؟

304
00:21:58,810 --> 00:22:03,250
.عرفتُ بأنّ هذا اليوم كان محتوماً
يبدو أنّه اليوم

305
00:22:11,110 --> 00:22:13,540
يبدو أنّه حان الوقت لأتولّى زمام الأمور

306
00:23:45,020 --> 00:23:59,950
الحلقة القادمة

307
00:23:56,680 --> 00:23:59,260
"الحلقة القادمة: "تايبون