1
00:01:31,020 --> 00:01:33,980
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

2
00:01:36,980 --> 00:01:39,910
سيُهدَم ذلك البناء قريباً

3
00:01:40,690 --> 00:01:43,240
نريدكِ أن تتحرّي قبل حدوث ذلك

4
00:01:43,580 --> 00:01:45,700
من فضلكِ حدّدي الطّبيعة الحقيقيّة
"لما تُسمّيه مولاتي آنشي بـ"اللّعنة

5
00:01:46,210 --> 00:01:51,800
السّبب وراء بقاء جثّة الإمبراطور الرّاحل
سليمة بعد الموت

6
00:01:54,280 --> 00:01:56,430
مضى ستّ سنوات منذ وفاة الإمبراطور الرّاحل

7
00:01:56,900 --> 00:01:59,340
،حالما يُهدَم البناء الّذي يُقيم فيه

8
00:01:59,340 --> 00:02:01,720
فإنّ الذّكرى الوحيدة له ستكون
قبره على ما أعتقد

9
00:02:02,140 --> 00:02:06,110
،إذا بقي اللّغز من دون حلّ
فلن تتحسّن مولاتي آنشي أبداً

10
00:02:06,570 --> 00:02:07,980
عُلِم

11
00:02:07,980 --> 00:02:10,310
لكن لديّ طلب واحد فقط

12
00:02:10,620 --> 00:02:11,650
طلب؟

13
00:02:11,650 --> 00:02:16,420
هل من المُمكن لنا أن ندخل الغرفة
الّتي أقام فيها الإمبراطور الرّاحل؟

14
00:02:18,140 --> 00:02:19,870
سأطلب الإذن

15
00:02:22,660 --> 00:02:25,460
لا ينبغي أن يكون الحصول على
،إذن من الإمبراطور صعباً

16
00:02:25,460 --> 00:02:29,080
ما دامت الأرملة الإمبراطورة
هي الّتي ستطلب ذلك

17
00:02:29,390 --> 00:02:33,370
ماوماو، سريرك جاهز

18
00:02:33,370 --> 00:02:37,820
شكراً لكِ يا سيّدة سويرين، على
السّماح لي باستخدام هذه الغرفة

19
00:02:37,820 --> 00:02:39,970
لا تقلقي بشأن ذلك

20
00:02:40,680 --> 00:02:42,970
ذوقها أظرف ممّا توقّعت

21
00:02:42,970 --> 00:02:44,930
الأريكة كانت لتكون جيّدة بالمُناسبة

22
00:02:45,330 --> 00:02:47,530
ستكون غير مُريحة بالنّسبة لي

23
00:02:47,530 --> 00:02:49,690
مضى وقت طويل منذ زرتِ
هذا البناء آخر مرّة

24
00:02:49,940 --> 00:02:52,140
ارتاحي جيّداً من فضلكِ

25
00:02:52,140 --> 00:02:52,910
شكراً

26
00:02:53,870 --> 00:02:57,100
أجل، قضيتُ مُعظم وقتي في مقصورة
اليشم مؤخّراً

27
00:02:57,100 --> 00:03:00,200
بصراحة، يسرّني أنّني لم أضطرّ
للعودة إلى هناك اللّيلة

28
00:03:00,670 --> 00:03:04,300
لا أريد أن أفكّر في كيفيّة ردّة فعل
...السيّدة هونيان عندما أعود

29
00:03:04,300 --> 00:03:07,120
أعتقد كانت مُتساهلة جدّاً حتّى اللّحظة

30
00:03:07,660 --> 00:03:09,950
العامل الّذي لا يكون جزءاً واضحاً
،من أي مقصورة مُحدّدة

31
00:03:09,950 --> 00:03:12,760
الّذي يزور المقصورات الأخرى بشكل مُتردّد؟

32
00:03:12,760 --> 00:03:15,960
لا يمكن أن يكون من المُريح وجود شخص
كهذا بالنّسبة لرئيسة وصيفات

33
00:03:20,680 --> 00:03:24,960
على ذكر الأمر، حتّى أنا لا أعرف
ماهيّة منصبي بالضّبط أحياناً

34
00:03:26,660 --> 00:03:29,430
القراءة على ضوء الشّمع؟
هذا مُترَف

35
00:03:30,420 --> 00:03:32,490
هل ترغبين في قراءة شيء أيضاً يا ماوماو؟

36
00:03:32,490 --> 00:03:35,480
يمكنكِ دخول الغرفة الخلفيّة والبحث عن شيء

37
00:03:38,630 --> 00:03:42,730
الكُتُب ثمينة. ينبغي أن أقرأها
متى سنحت لي الفُرصة

38
00:03:42,730 --> 00:03:45,020
لكن آمل أن أجد شيئاً يُلائم ذوقي

39
00:03:46,380 --> 00:03:47,990
!انتظريني

40
00:03:49,880 --> 00:03:52,460
ذوق السيّدة سويرين يافع جدّاً

41
00:03:58,650 --> 00:03:59,760
هل ينتابكِ فضول؟

42
00:04:00,120 --> 00:04:03,380
!لا تقلقي رجاء! أنا لا أحاول سرقة شيء

43
00:04:03,380 --> 00:04:04,760
أعلم ذلك

44
00:04:06,570 --> 00:04:08,390
دُمى الأطفال؟

45
00:04:08,390 --> 00:04:12,440
أجل. المُفضّلة لدى مولايّ جينشي

46
00:04:12,440 --> 00:04:15,480
ماوماو، ما رأيك بمولايّ جينشي؟

47
00:04:16,460 --> 00:04:18,400
أعتقد بأنّه مُدير جيّد

48
00:04:18,940 --> 00:04:21,150
ما دام مستمرّاً في توفير الأدوية النّادرة

49
00:04:21,640 --> 00:04:23,750
هل لاحظتُ نيّة خفيّة ما هناك؟

50
00:04:24,540 --> 00:04:25,900
حسناً، على أيّ حال

51
00:04:26,310 --> 00:04:28,410
هذه هي السّلع الّتي أخفيتُها عن مولايّ جينشي

52
00:04:28,410 --> 00:04:31,880
لأنّه ظلّ يلعب بها طوال الوقت

53
00:04:31,880 --> 00:04:35,880
،لكن كنتُ متى فعلتُ ذلك
كان يجهش البُكاء

54
00:04:37,630 --> 00:04:39,630
!هناك دُمى أخرى يا سيّدة

55
00:04:39,980 --> 00:04:44,260
!لا! أريد تلك الدّمية! أريد تلك الدّمية

56
00:04:45,340 --> 00:04:51,960
لطالما كان غاوشون يواجه وقتاً عصيباً
في مُحاولة إيجاد دُمى جديدة لاسترضائه

57
00:04:51,960 --> 00:04:53,640
لماذا أخذت دُماه المُفضّلة؟

58
00:04:54,110 --> 00:04:58,360
،إذا ركّز شخصٌ على شيء واحد كثيراً
فإنّه لا يعود يرى الأشياء الأخرى

59
00:04:58,910 --> 00:05:02,860
وُلِدَ في منصب لا يسمح بذلك

60
00:05:03,400 --> 00:05:07,660
مهما كان الأمر صعباً، كان عليه
أن يمضي قُدماً ويصبح راشداً

61
00:05:08,130 --> 00:05:12,160
كان هذا ما أرادتْه أمُّ مولايّ جينشي

62
00:05:12,890 --> 00:05:14,340
...أمّه

63
00:05:14,940 --> 00:05:17,250
سمعتُ أنّه عندما يترعرع المرء
،في بيئة قمعيّة

64
00:05:17,250 --> 00:05:19,170
فيمكن أن يؤثّر ذلك على عقله

65
00:05:20,220 --> 00:05:23,130
...الميول الطّفوليّة الّتي بدأ يُظهرها أمامي

66
00:05:23,730 --> 00:05:27,180
فلا بدّ أنّها جزء من شخصيّته الحقيقيّة أيضاً

67
00:05:28,270 --> 00:05:32,000
،ومع ذلك، بواسطة الآخرين المُحيطين به
"تمّت مُعاملته كـ"المخصيّ الأنيق

68
00:05:32,000 --> 00:05:33,590
يا له من تحوُّل غريب للأحداث

69
00:05:39,400 --> 00:05:40,510
هذه اللّوحة...؟

70
00:05:40,510 --> 00:05:42,790
ها هي ذي

71
00:05:43,590 --> 00:05:45,860
طُلِبَ منّي التخلّص منها

72
00:05:46,350 --> 00:05:47,850
ماذا كانت؟

73
00:05:49,890 --> 00:05:51,240
هل يمكنني لمسها؟

74
00:05:52,390 --> 00:05:53,590
بكلّ تأكيد

75
00:05:59,870 --> 00:06:04,760
إنّها مجرّد حصاة. أتساءل أين وجدها؟

76
00:06:04,760 --> 00:06:06,750
هل حصلتِ عليها منه مباشرة؟

77
00:06:06,750 --> 00:06:10,430
،أجل. فلو التقطتُ حصاة من الأرض
لا يمكن أن تكون نظيفة، صحيح؟

78
00:06:11,050 --> 00:06:12,430
قرار حكيم

79
00:06:14,410 --> 00:06:15,560
هذا سُمّ

80
00:06:16,040 --> 00:06:17,330
!ماذا تقولين؟

81
00:06:17,330 --> 00:06:21,610
أودّ لو أعرف بحدّ ذاتي. لِمَ يتواجد شيء كهذا؟

82
00:06:26,310 --> 00:06:30,260
هل زار مولايّ جينشي البلاط الدّاخلي
عندما كان صغيراً؟

83
00:06:31,100 --> 00:06:36,180
.أجل، كان يزوره أحياناً
لكن لماذا تسألين؟

84
00:06:36,180 --> 00:06:37,960
لا أستطيع الجزم حاليّاً

85
00:06:38,540 --> 00:06:42,460
لديّ فرضيّة واحدة، لكن بلا دليل

86
00:06:43,110 --> 00:06:47,420
سيّدة سويرين، "اللّعنة" كما وُصِفت
...بواسطة أرملة الإمبراطور

87
00:06:47,950 --> 00:06:51,430
السّبب وراء عدم تعفّن جثمان الإمبراطور
الرّاحل... يمكنني توضيح ذلك غداً

88
00:06:51,820 --> 00:06:54,010
هل يمكنكِ الانتظار ريثما أفعل ذلك؟

89
00:06:59,970 --> 00:07:02,440
مولايّ جينشي هنا أيضاً؟

90
00:07:02,880 --> 00:07:05,940
لم أرِد أن أهوّل الأمر

91
00:07:14,370 --> 00:07:18,330
هذه الرّائحة اللّاذعة... لا يمكن أن تكون مجرّد عفن

92
00:07:24,120 --> 00:07:28,590
فرشاة برأس مقطوع لجعلها
مستوية... توقّعتُ ذلك

93
00:07:29,140 --> 00:07:32,470
هل اتّخذ الإمبراطور الرّاحل الرّسم كهواية؟

94
00:07:34,280 --> 00:07:37,510
لمرّة واحدة فقط، رسمَ لوحة لي

95
00:07:38,700 --> 00:07:45,310
قال بأنّ الأمر سرّي. لأنّه إذا عَلِم
الآخرون بالأمر، فسوف يأخذونها

96
00:07:47,060 --> 00:07:49,860
هل هو مُتوتّر؟ هذه اختلاجات عصبيّة
يفعلها مولايّ جينشي عادة

97
00:07:50,290 --> 00:07:53,320
أنا متأكّدة بأنّه يعتقد بأنّه يتصرّف بهدوء

98
00:07:54,020 --> 00:07:58,330
لا أعرف ولا أريد أن أعرف
الكثير عن الإمبراطور الرّاحل

99
00:07:58,330 --> 00:08:00,490
،"لكن من أجل اكتشاف طبيعة "اللّعنة

100
00:08:00,490 --> 00:08:01,760
أحتاج دليلاً

101
00:08:07,020 --> 00:08:10,340
هل كان الإمبراطور الرّاحل لا يرسم
إلّا في هذه الغرفة دائماً؟

102
00:08:10,340 --> 00:08:15,440
لستُ متأكّدة، لكن منذ بدأ الإمبراطور ينطوي
،على نفسه في هذه الغرفة

103
00:08:15,440 --> 00:08:17,350
كان يخدمه خادم واحد فقط

104
00:08:17,350 --> 00:08:19,310
هل يمكنكِ إحضاره إلى هنا؟

105
00:08:19,560 --> 00:08:22,610
أعتقد ما زال يعمل هنا

106
00:08:22,610 --> 00:08:23,630
ابحثي عنه

107
00:08:26,930 --> 00:08:28,590
هل يمكنني لمس هذه؟

108
00:08:28,590 --> 00:08:29,530
بالتّأكيد

109
00:08:33,010 --> 00:08:34,710
إنّها أقسى ممّا توقّعت

110
00:08:35,810 --> 00:08:38,010
ولها رائحة غريبة أيضاً

111
00:08:38,690 --> 00:08:41,120
شظايا شفّافة على الأرض

112
00:08:41,120 --> 00:08:44,310
بعض العلامات كمُحاولة شخص
تنظيف شيء بشكل مسعور

113
00:08:44,310 --> 00:08:46,330
...وتلك العلامات

114
00:08:46,330 --> 00:08:48,980
يزداد عددها كلّما اقتربنا من الجدار

115
00:08:53,020 --> 00:08:57,240
إنّها ناعمة. لا بدّ أنّ له طبقات
من الورق الثّخين

116
00:08:58,200 --> 00:09:01,810
يوجد طلاء على السّطح لجعله أقسى

117
00:09:02,310 --> 00:09:05,260
حصلتُ على فكرة جيّدة حول
،"ماهيّة "اللّعنة

118
00:09:05,260 --> 00:09:08,310
لكن أعتقد اكتشفتُ اكتشافاً عديم الجدوى آخر

119
00:09:08,730 --> 00:09:10,270
أحضرتُه

120
00:09:12,220 --> 00:09:13,280
...أنت

121
00:09:17,640 --> 00:09:22,520
يبدو كبيراً جدّاً بالنّسبة لشخص
...مُكلّف بالعناية بأنبل النّاس

122
00:09:23,110 --> 00:09:24,870
أردتُ طرح بضعة أسئلة عليك

123
00:09:25,950 --> 00:09:28,040
هذا الشّخص هو عبد سابق

124
00:09:28,040 --> 00:09:29,710
وأيضاً، إنّه عاجز عن الكلام

125
00:09:30,060 --> 00:09:31,070
فهمت

126
00:09:31,550 --> 00:09:32,920
هكذا إذاً

127
00:09:33,770 --> 00:09:37,690
ليس من الغريب اختيار شخص
أخرس كخادم

128
00:09:38,170 --> 00:09:42,430
،وينطبق هذا بالتّحديد على أنبل شخص
والّذي يكون تحت رقابة النّاس دوماً

129
00:09:42,690 --> 00:09:45,500
في هذه الحالة، فأومئ برأسك
أو هزّ رأسك فحسب من فضلك

130
00:09:45,500 --> 00:09:48,300
هل كانت هناك أي لوحات في هذه الغرفة؟

131
00:09:50,150 --> 00:09:52,230
أنا متأكّدة بأنّه كان يوجد شيء هنا

132
00:09:53,150 --> 00:09:56,990
هل يرفض التكلّم مع فتاة عشوائيّة فحسب؟

133
00:09:58,690 --> 00:09:59,990
لا، الأمر ليس كذلك

134
00:10:00,910 --> 00:10:02,570
هل يُخفي شيئاً؟

135
00:10:05,730 --> 00:10:07,330
ماذا يوجد في هذا الجدار؟

136
00:10:11,370 --> 00:10:13,630
هل يمكنني تمزيق ورق الجدار هذا؟

137
00:10:15,730 --> 00:10:17,840
وكأنّه يستصرخني لأتوقّف

138
00:10:19,110 --> 00:10:20,050
افعلي ذلك

139
00:10:20,970 --> 00:10:23,020
سيُهدَم هذا البناء بأكمله على أيّ حال

140
00:10:23,500 --> 00:10:25,770
...لذا إذا كان هذا سيُساهم في إيجاد شيء

141
00:10:34,450 --> 00:10:36,330
...بحرص

142
00:10:51,370 --> 00:10:52,540
...هذه اللّوحة

143
00:10:52,960 --> 00:10:54,250
ما هذه؟

144
00:10:54,660 --> 00:10:57,330
لا بدّ أنّها رُسِمت بواسطة الإمبراطور الرّاحل

145
00:10:57,330 --> 00:11:00,170
لا أبالي لشخصيّة الإمبراطور الرّاحل

146
00:11:00,170 --> 00:11:02,880
لكنّه رحلَ دون أن يتمكّن من تسليط
،الضّوء على مواهبه الحقيقيّة

147
00:11:02,880 --> 00:11:05,760
كلّ هذا لأنّه انتهى المطاف به
قائداً لهذه الدّولة على ما يبدو

148
00:11:06,970 --> 00:11:09,770
هذه اللّوحة قويّة بما يكفي لإقناعي

149
00:11:10,550 --> 00:11:14,480
الطّلاء المُستخدَم لصنع لون الثّوب
الّذي ترتديه هذه المرأة هنا

150
00:11:14,480 --> 00:11:18,030
قد شُكِّل بسحق معدن يُدعى الرّهج الأصفر

151
00:11:20,420 --> 00:11:23,370
الرّهج الأصفر لديه نفس سُمّية الزّرنيخ

152
00:11:23,960 --> 00:11:28,250
والزّرنيخ يجعل الأشياء أقلّ تعرُّضاً للتفسُّخ

153
00:11:30,680 --> 00:11:35,960
في البداية، ظننتُ أنّه يوجد رهج أصفر
،في ورق الجدران أو ما شابه

154
00:11:35,960 --> 00:11:39,130
وامتصّه جثمان الإمبراطور الرّاحل
بطريقة مجهولة ما

155
00:11:39,650 --> 00:11:42,930
لكن عندما رأيتُ شكل الفرشاة
،في هذه الغرفة

156
00:11:42,930 --> 00:11:45,510
فكّرتُ في احتمال مختلف

157
00:11:45,970 --> 00:11:49,060
كان يستخدم صبغة مصنوعة
من الرّهج الأصفر

158
00:11:49,790 --> 00:11:55,450
لا بدّ أنّ الإمبراطور الرّاحل قد امتصّ
تدريجيّاً الرّهج الأصفر بجسده

159
00:11:56,150 --> 00:11:59,960
أنا متأكّدة بأنّ المادّة كانت قد انتشرت
في كلّ أنحاء جسده عندما تُوفّي

160
00:12:01,460 --> 00:12:05,430
في هذه الغرفة، حيث كان يرسم بشكل سرّي

161
00:12:06,670 --> 00:12:10,620
سيكون من غير المقبول بالنّسبة لإمبراطور
أن يقضي وقته في رسم اللّوحات

162
00:12:10,920 --> 00:12:13,120
على الأقلّ، هذا ما كان ليعتقده
النّاس المُحيطون به

163
00:12:13,900 --> 00:12:18,630
لهذا لم يكشف عن ذلك أبداً، حتّى
عندما كان يُلقّب بالإمبراطور الغبيّ

164
00:12:19,010 --> 00:12:24,130
لهذا أيضاً عيّنَ عبداً أخرس
لإدارة الغرفة غالباً

165
00:12:24,620 --> 00:12:26,340
ما زالت هناك بعض اللّيونة

166
00:12:26,340 --> 00:12:29,040
كم طبقة يوجد تحت هذا؟

167
00:12:30,040 --> 00:12:34,350
،أن يكون قادراً على رسم كلّ هذه اللّوحات
...فلا بدّ للشّخص أن يحصل على الأدوات

168
00:12:34,900 --> 00:12:36,990
ربّما أمّه، الإمبراطورة المزعومة

169
00:12:37,460 --> 00:12:39,860
المرأة الّتي في اللّوحة كانت تعلم

170
00:12:40,590 --> 00:12:44,860
بأنّ ابنها ليس مؤهّلاً ليكون إمبراطوراً

171
00:12:45,380 --> 00:12:49,640
لذا، عندما أصبح ابنها في نهاية
،المطاف إمبراطوراً بالمُصادفة

172
00:12:49,640 --> 00:12:51,870
استجمعتْ قِواها، لتحمي ابنها

173
00:12:52,350 --> 00:12:55,960
حتّى لو نجم عن ذلك مُناداة
النّاس لها بالإمبراطورة

174
00:12:57,000 --> 00:12:58,930
فعلت الإمبراطورة كلّ ما بوسعها
من أجل ابنها

175
00:12:58,930 --> 00:13:03,840
،كان هديّتها الأخيرة له هذا المكان
والأشياء الّتي احتاجَها للرّسم

176
00:13:04,680 --> 00:13:06,350
...دون أن تعلم بأنّها كانت سامّة

177
00:13:07,800 --> 00:13:09,630
!يا لسخرية القدر

178
00:13:11,930 --> 00:13:14,060
هذا كلّ ما يمكنني قوله

179
00:13:15,010 --> 00:13:17,790
أجل. أبليتِ حسناً

180
00:13:30,320 --> 00:13:35,250
وكأنّها تحاول إرسال أسئلة
إلى شخص وراء السّماوات

181
00:13:36,220 --> 00:13:39,000
ها أنا ذي أتأثّر عاطفيّاً

182
00:13:50,940 --> 00:13:53,620
كم هذا مُغيظ

183
00:13:58,340 --> 00:14:03,740
ولو أنّها تتلاشى، حضور تلك
الشّخصيّة قويّ

184
00:14:05,630 --> 00:14:08,610
أتساءل ما إن كنتُ جزءاً
من هذه اللّوحة حتّى؟

185
00:14:09,390 --> 00:14:14,700
لا، لا بدّ أنّني كنتُ مجرّد
فكرة عابرة بالنّسبة له

186
00:14:17,020 --> 00:14:19,700
هذه النّدبة في جسدي هي الشّيء الوحيد

187
00:14:19,700 --> 00:14:22,350
الّذي يسمح لي بأن أُعامَل كأمّ لهذه الدّولة

188
00:14:24,170 --> 00:14:28,950
فتاة صغيرة وقعَتْ بالخطأ ضحيّة للإمبراطور
الرّاحل وأصبحت حاملاً

189
00:14:29,550 --> 00:14:31,780
سيصِفني أحدهم بهذا الوصف ويشفق عليّ

190
00:14:32,290 --> 00:14:34,260
توجد فتاةٌ كهذه فعلاً وهي أنا

191
00:14:35,250 --> 00:14:39,270
لكن كنتُ أعلم بذوق الإمبراطور سلفاً

192
00:14:40,210 --> 00:14:43,360
كان أبي بيروقراطيّاً، وأمّي مَحظيّته

193
00:14:43,810 --> 00:14:48,040
كان وجهي جميلاً، لكن جاءني الطّمث باكراً

194
00:14:48,660 --> 00:14:51,930
استغلَّ أبي ذلك لتحقيق فائدة سياسيّة

195
00:14:55,780 --> 00:14:59,210
دخلتُ القصر الخلفيّ كوصيفة
ومَحظيّة متوسّطة التّصنيف

196
00:14:59,720 --> 00:15:02,230
المَحظيّة الّتي خدمتُها كانت
أختي من أمّ مختلفة

197
00:15:02,230 --> 00:15:05,230
،أختي، والّتي ترعرعت كأميرة

198
00:15:05,230 --> 00:15:08,090
لم تكن تعرف ما الّذي خطّط له أبونا

199
00:15:08,090 --> 00:15:11,220
!آنشي! ضعي لي تلك الإكسسوارات بسرعة

200
00:15:11,540 --> 00:15:13,470
عُلِم يا أختي العزيزة

201
00:15:16,660 --> 00:15:19,780
!إنّها اللّيلة أخيراً! الإمبراطور قادم

202
00:15:19,780 --> 00:15:22,020
رأيتُه من بعيد قبل أيّام

203
00:15:22,440 --> 00:15:24,700
!إنّه وسيم جدّاً

204
00:15:25,480 --> 00:15:27,030
هكذا إذاً

205
00:15:29,540 --> 00:15:31,280
انتظرتُ وصولك بلهفة

206
00:15:38,850 --> 00:15:41,410
...تفضّل بالدّخول

207
00:15:42,370 --> 00:15:43,700
!لا تلمسيني

208
00:15:46,420 --> 00:15:47,630
!جلالتك

209
00:15:53,880 --> 00:15:59,020
لم ينجح كقائد لدولة إطلاقاً

210
00:15:59,480 --> 00:16:01,770
كوصيفة، كان بوسعي مُواساة
،المَحظيّة الّتي خدمتُها

211
00:16:02,170 --> 00:16:05,270
أو الاعتذار من الإمبراطور

212
00:16:05,800 --> 00:16:06,710
...لكن بدلاً من ذلك

213
00:16:20,580 --> 00:16:22,430
هل أنت بخير؟

214
00:16:26,580 --> 00:16:31,100
في تلك اللّحظة، حدّق وتأمّل عينَي

215
00:16:31,980 --> 00:16:35,300
عينا فتاة، مليئتان بالطّموح

216
00:16:41,480 --> 00:16:46,710
حملتُ بطفل الإمبراطور، وتعرّضتْ
حياتي لخطر عدداً لا يُحصى من المرّات

217
00:16:46,710 --> 00:16:49,330
،لحسن الحظّ، كان الطّفل صبيّاً

218
00:16:49,330 --> 00:16:52,470
وقَبِلَتْه الإمبراطورة بشكل رسميّ كحفيد لها

219
00:16:54,510 --> 00:16:57,290
اهدأ، اهدأ

220
00:16:59,720 --> 00:17:02,200
في الماضي أنجبتْ فتاةٌ ابنة

221
00:17:02,810 --> 00:17:05,480
،ادّعتْ بأنّ الفتاة كانت ابنة الإمبراطور الرّاحل

222
00:17:05,480 --> 00:17:07,640
لكن أنكر ذلك، قائلاً بأنّ لا علم له بالأمر

223
00:17:07,640 --> 00:17:11,960
تمّ نسب الأبوّة لطبيب ونُفي مع الرّضيعة

224
00:17:12,690 --> 00:17:16,950
آنذاك، كان الأطبّاء الوحيدين الّذين يُسمَح
لهم بدخول القصر الخلفيّ دون إخصاء

225
00:17:16,950 --> 00:17:20,470
عقب ذلك، بات الأطبّاء مُطالبين
بأن يكونوا مخصيّين كذلك

226
00:17:20,950 --> 00:17:23,600
الشّخص المسؤول عن هذه العمليّة
...في رحِمي كذلك

227
00:17:24,270 --> 00:17:26,480
!يا له من مسكين

228
00:17:27,300 --> 00:17:31,920
الفتاة الّتي أنجبت الابنة تُرِكت
في القصر الخلفيّ

229
00:17:32,350 --> 00:17:35,490
غالباً لن تُغادر القصر الخلفيّ أبداً

230
00:17:36,250 --> 00:17:38,600
...ثمّ مضى الوقت

231
00:17:39,940 --> 00:17:42,730
،عندما لم أعُد أملك مظهر فتاة صغيرة

232
00:17:42,730 --> 00:17:45,000
توقّفَ الإمبراطور الرّاحل عن زيارتي

233
00:17:45,750 --> 00:17:48,640
سمعتُ بأنّ القصر الخلفيّ يتوسّع ثانية

234
00:17:48,640 --> 00:17:51,680
أجل. سمعتُ بأنّ مولايّ شيشو
هو من اقترح ذلك

235
00:17:52,870 --> 00:17:53,760
هكذا إذاً

236
00:17:54,110 --> 00:18:00,020
،استمرّ القصر الخلفيّ في التوسُّع
،ووصلتْ فتيات صغيرات كثيرات

237
00:18:00,020 --> 00:18:01,510
مُكلّفات بنفس مهمّتي

238
00:18:13,690 --> 00:18:22,590
،رجل مُثير للشّفقة، دُمية للإمبراطورة
لا يستطيع التكلّم إلّا مع فتيات صغيرات

239
00:18:37,380 --> 00:18:41,890
أن ينساني رجلٌ كهذا، كان أمراً غير مقبول

240
00:18:45,380 --> 00:18:47,140
هل أخيفك؟

241
00:18:49,890 --> 00:18:52,360
هل هذا لأنّني امرأة بالغة الآن؟

242
00:18:53,500 --> 00:18:56,900
أم أنّها النّدبة في بطني؟

243
00:18:57,690 --> 00:19:02,780
في غرفة النّوم، وبينما يتوسّل إليّ
أن أغفر له، عذّبتُه

244
00:19:02,780 --> 00:19:06,020
الفتيات الصّغيرات اللّواتي وقعنَ ضحيّة له

245
00:19:06,660 --> 00:19:08,710
الإمبراطورة المجيدة، أمّه

246
00:19:09,660 --> 00:19:12,210
أردتُه أن يتذكّرني بوضوح أكثر
من أيّ واحدة منهن

247
00:19:13,710 --> 00:19:15,210
،بعد ذلك

248
00:19:15,700 --> 00:19:18,810
،دُمِّر عقل الإمبراطور الرّاحل تماماً
فعزلَ نفسه في ذلك البناء

249
00:19:18,810 --> 00:19:21,840
لا أريد حتّى أن أفكّر وأعرف
مَن السّبب وراء ذلك

250
00:19:24,570 --> 00:19:27,890
،في النّهاية، لا بدّ أنّه بقي في تلك الغرفة

251
00:19:27,890 --> 00:19:33,280
ولا يُفكّر سوى بأمّه، وبالإمبراطورة، وبالفتيات
الأُخريات اللّواتي بلا طموح

252
00:19:36,200 --> 00:19:39,610
رسمَني أنا، ولو لمرّة واحدة

253
00:19:40,810 --> 00:19:46,750
ثمّنتُ تلك اللّوحة، لكن طلبتُ
من سويرين التخلّص منها

254
00:19:47,190 --> 00:19:48,870
لم أكن أحتاجها

255
00:19:49,620 --> 00:19:52,600
مثلما كان الإمبراطور الرّاحل لا يحتاجني

256
00:20:00,760 --> 00:20:04,840
زارنا مرّة واحدة في الماضي

257
00:20:05,370 --> 00:20:08,260
أجل. كم سنة مضى على ذلك؟

258
00:20:08,950 --> 00:20:11,780
وجدتُ هذا آنذاك

259
00:20:12,470 --> 00:20:14,520
هذا هو الرّهج الأصفر الّذي ذُكِر اليوم

260
00:20:15,340 --> 00:20:16,800
...هذا الحجر

261
00:20:17,570 --> 00:20:20,550
أعادتْه سويرين لي أخيراً اليوم

262
00:20:22,510 --> 00:20:23,320
...هكذا إذاً

263
00:20:28,440 --> 00:20:32,890
طفل الخلود. طفل الخطيئة

264
00:20:32,890 --> 00:20:35,050
مهما قالوا، إنّه طفل ثمين رغم ذلك

265
00:20:35,530 --> 00:20:39,050
أظنّني رأيتُ تلك اللّوحة من قبل أيضاً

266
00:20:39,500 --> 00:20:43,550
كانت لوحة لفتاة صغيرة بألوان فاتحة

267
00:20:44,290 --> 00:20:48,050
لا بدّ أنّني التقطتُ هذا الحجر
لأنّني تذكّرتُ تلك اللّوحة

268
00:20:48,650 --> 00:20:50,970
أذكر بأنّني طلبتُ منها التخلّص منها

269
00:20:51,430 --> 00:20:55,480
كنتِ تُفضّلين الملابس بهذا
اللّون في الماضي

270
00:21:15,580 --> 00:21:16,580
مُجرّد صدفة

271
00:21:17,550 --> 00:21:21,000
هل تلك المرأة في اللّوحة
هي الإمبراطورة فعلاً؟

272
00:21:21,940 --> 00:21:25,970
ماذا حاول أن يخبرنا آنذاك؟

273
00:21:31,350 --> 00:21:32,790
لا أعلم

274
00:21:35,820 --> 00:21:38,440
فضّلتُ عدم المعرفة

275
00:21:39,030 --> 00:21:44,270
على أيّ حال، يبدو أنّك مُتحيّز
لفتاة مُثيرة للاهتمام حقّاً

276
00:21:46,340 --> 00:21:48,610
إنّها نافعة جدّاً

277
00:21:49,140 --> 00:21:51,430
...فهمت. لكن

278
00:21:52,680 --> 00:21:55,410
حتّى أنا أرى بأنّ الأمر أكثر من مجرّد ذلك

279
00:22:00,750 --> 00:22:02,960
كنتُ أراقبك لسنوات طِوال الآن

280
00:22:06,760 --> 00:22:09,140
يجدر بك أن تُخفي مُفضَّلاتك

281
00:22:09,780 --> 00:22:12,270
وإلّا قام شخصٌ آخر بإخفائها عنك

282
00:23:45,110 --> 00:24:00,040
الحلقة القادمة

283
00:23:56,530 --> 00:23:59,180
"الحلقة القادمة: "قصّة شبح