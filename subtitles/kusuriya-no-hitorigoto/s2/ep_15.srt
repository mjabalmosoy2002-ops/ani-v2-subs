1
00:01:31,020 --> 00:01:33,980
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

2
00:01:35,970 --> 00:01:37,820
،اصطدمت تلك الفتاة بالمخصيّ

3
00:01:37,820 --> 00:01:40,050
فسقط منه الثّلج الّذي كان
يحمله لمحظيّة

4
00:01:40,050 --> 00:01:41,740
أشفق عليها

5
00:01:41,740 --> 00:01:45,410
ألا ينبغي أن تشفقي على المخصيّ
الّذي كان يحمل الثّلج؟

6
00:01:45,870 --> 00:01:48,240
لنأمل أن يفلت بمجرّد عقوبة
ضرب بالعصا فحسب

7
00:01:50,170 --> 00:01:53,170
—أ-أنا آسفة

8
00:01:53,170 --> 00:01:55,880
!المعذرة، لم نكن ننتبه

9
00:01:55,880 --> 00:01:58,670
!أتعتقدين بأنّ الاعتذار سيَفي بالغرض؟

10
00:01:58,670 --> 00:02:01,340
لا أستطيع تنظيف هذا والتّظاهر
!بأنّ شيئاً لم يحدث

11
00:02:01,340 --> 00:02:02,930
!ليس لدينا أي بديل

12
00:02:06,330 --> 00:02:08,850
!تبّاً... ماذا أفعل؟

13
00:02:10,110 --> 00:02:12,320
الثّلج ثمين في هذه الفترة من العام

14
00:02:12,320 --> 00:02:14,480
يمكن شراء شخص به

15
00:02:20,150 --> 00:02:22,530
لِمَن كان هذا الثّلج؟

16
00:02:22,920 --> 00:02:26,790
المحظيّة روران! أرادتْ بعض الحلويّات
!المُثلّجة لترطيب نفسها بعد الظّهر

17
00:02:28,430 --> 00:02:30,960
من بينهن جميعاً، إنّها المحظيّة
الّتي لا أملك علاقة وطيدة معها

18
00:02:33,480 --> 00:02:36,320
ماذا نفعل؟ لا يمكننا دفع ثمنه

19
00:02:36,320 --> 00:02:38,970
سيكون من السيّئ إغضاب
محظيّة رفيعة التّصنيف

20
00:02:39,720 --> 00:02:42,580
لو نستطيع على الأقلّ إيجاد
...شيء لاستبداله به

21
00:02:44,410 --> 00:02:46,350
هل يمكننا أخذ هذا الثّلج؟

22
00:02:46,610 --> 00:02:47,850
!افعلي ما تشائين به

23
00:02:48,420 --> 00:02:52,370
في هذه الحالة، سأستخدم هذا
لصنع شيء آخر

24
00:02:52,370 --> 00:02:55,610
هل يمكنك إيصاله إلى المحظيّة روران؟

25
00:02:56,550 --> 00:03:00,280
جرّبي ذلك إن استطعتِ. أمامكِ
!أقلّ من ساعة

26
00:03:01,050 --> 00:03:02,140
عُلِم

27
00:03:02,650 --> 00:03:04,330
أمتلك ما يكفي من وقت بالتّحديد

28
00:03:04,330 --> 00:03:07,480
لكن لا أعلم حتّى ما إن كانت
المُكوّنات الأُخرى مُتوفّرة

29
00:03:07,480 --> 00:03:10,200
—يجب أن أستخدم ما يمكنني أن

30
00:03:14,210 --> 00:03:16,640
لـ-لماذا هو هنا؟

31
00:03:18,340 --> 00:03:20,540
!لا وقت للانشغال بذلك

32
00:03:32,310 --> 00:03:35,130
!ماذا أفعل يا ماوماو؟

33
00:03:37,020 --> 00:03:39,490
فتاة مسكينة

34
00:03:43,320 --> 00:03:45,800
،أعطتْها محظيّةٌ دبّوس شعرها

35
00:03:45,800 --> 00:03:48,700
لذا كانت سعيدة به أثناء
...سيرها، ثمّ

36
00:03:48,700 --> 00:03:53,210
!أتساءل ما إن كانت تلك المحظيّة تُحبّني

37
00:03:53,540 --> 00:03:56,420
تريدني أن أدلّك جسدها مرّة
!أُخرى في وقت لاحق

38
00:03:57,160 --> 00:03:58,310
أنا مسرورة لأجلك

39
00:03:59,820 --> 00:04:03,090
بعد المرّة السّابقة، استمرّت شاولان
في السّعي بناء علاقات

40
00:04:03,430 --> 00:04:07,030
كانت تخبرني فحسب كيف لبّتْ طلباً
مُباشراً من محظيّة مُتدنّية التّصنيف

41
00:04:07,730 --> 00:04:10,090
،سمعتُ بأنّها بيعت بواسطة والديها

42
00:04:10,090 --> 00:04:12,410
لكن لم أرها حزينة يوماً

43
00:04:13,960 --> 00:04:15,940
لا بدّ أنّها كانت سعيدة جدّاً

44
00:04:18,980 --> 00:04:23,620
لا بدّ أنّ الصُّراخ في وجهها هكذا
أخافَها. حتّى عجزت عن الحركة

45
00:04:34,740 --> 00:04:36,210
هل تحتاجين شيئاً؟

46
00:04:36,210 --> 00:04:39,210
هل يمكنني استعارة مطبخ
وبعض المُكوّنات؟

47
00:04:39,210 --> 00:04:43,220
كم هذا غريب! وعلى ماذا
سأحصل بالمُقابل؟

48
00:04:44,770 --> 00:04:48,060
!لا تعبث معي، الوقت يُداهمني

49
00:04:49,390 --> 00:04:52,810
ليس لديّ ما أُقدّمه لك بالمُقابل

50
00:04:53,370 --> 00:04:54,730
!لكن أنا مُضطرّة على هذا الطّلب

51
00:04:55,810 --> 00:04:59,730
أعلم بأنّ سلوكي غير لائق، لكن
الوقت غير مُناسب للقلق بشأن ذلك

52
00:05:01,810 --> 00:05:04,240
لستِ من سبّب هذه المُشكلة، صحيح؟

53
00:05:06,150 --> 00:05:07,490
معك حقّ

54
00:05:08,770 --> 00:05:13,410
كانت في الأصل مصدراً دسماً
للثّرثرة والإشاعات

55
00:05:13,900 --> 00:05:18,420
رغم ذلك، قدّمتُ لها أكلات خفيفة
بالمُقابل، لذا لسنا مَدينتين لبعضنا الآخر

56
00:05:21,690 --> 00:05:23,310
لستُ مُلزمة بمُساعدتها

57
00:05:24,760 --> 00:05:25,660
...لكن

58
00:05:26,870 --> 00:05:29,300
لن أنام بهناء إذا لم أُقدّم المُساعدة

59
00:05:36,260 --> 00:05:38,850
فهمت. لن تنامي بهناء فقط إذاً؟

60
00:05:38,850 --> 00:05:41,940
أجل. سيؤثّر ذلك على عملي
في اليوم التّالي

61
00:05:42,320 --> 00:05:43,980
لا نقبل بذلك بالتّأكيد

62
00:05:47,340 --> 00:05:49,410
حسناً، لكن هناك شرط واحد

63
00:05:54,770 --> 00:05:58,250
عندما يتكلّم معكِ أحد، فدعيه
يُكمل كلامه وأصغِ إليه جيّداً

64
00:06:01,080 --> 00:06:03,000
هذا كلّ شيء؟

65
00:06:04,630 --> 00:06:07,090
لا يمكنكِ حتّى القيام بذلك

66
00:06:09,120 --> 00:06:14,060
انسي الأمر إذاً، سأفكّر في شيء
آخر. ماذا ينبغي أن يكون؟

67
00:06:15,310 --> 00:06:16,810
!يراودني شعور سيّئ حيال هذا

68
00:06:17,290 --> 00:06:19,560
هل أعتمد على مولاتي غيوكويو بدلاً من ذلك؟

69
00:06:19,900 --> 00:06:23,480
لا، لا أستطيع طلب مُساعدتها في شيء
له صِلة بالمحظيّة روران

70
00:06:32,380 --> 00:06:34,260
شكراً لك

71
00:06:34,260 --> 00:06:37,130
ألا ترتدين دبّوس شعر؟

72
00:06:37,130 --> 00:06:40,120
وصيفات مقصورة اليشم الأُخريات
مُتأنّقات أكثر منكِ

73
00:06:40,440 --> 00:06:43,380
قد يكون كلامك صحيحاً، لكن
لا أملك أي زينة

74
00:06:43,860 --> 00:06:46,200
أعطيتُكِ واحداً في حفلة الحديقة، أنسيتِ؟

75
00:06:47,290 --> 00:06:49,780
لا تقولي لي بأنّكِ بعته

76
00:06:49,780 --> 00:06:51,240
لم أفعل

77
00:06:51,240 --> 00:06:52,260
ليس بعد على أيّ حال

78
00:06:55,850 --> 00:06:57,890
ضعيه إذاً

79
00:06:59,100 --> 00:07:00,640
أهذا كلّ شيء؟

80
00:07:01,140 --> 00:07:02,230
هل من اعتراض؟

81
00:07:05,140 --> 00:07:08,750
عندما ترتدينه، سأخبركِ

82
00:07:11,390 --> 00:07:13,820
مطبخ، صحيح؟ سأطلب من شخص يُحضّره

83
00:07:25,260 --> 00:07:26,210
!أحضرتُه

84
00:07:27,830 --> 00:07:29,300
ضعه هنا من فضلك

85
00:07:29,700 --> 00:07:30,550
حسناً

86
00:07:32,050 --> 00:07:33,680
...ماوماو، هل هذا

87
00:07:36,430 --> 00:07:40,140
سكّر وفواكه... وحليب بقر؟

88
00:07:40,850 --> 00:07:45,350
،يسرّني أنّ لديهم حليب طازج
إنّه يفسد بسرعة

89
00:07:45,810 --> 00:07:50,080
هل يمكنكِ حقّاً إعداد شيء
كتحلية مُثلّجة من هذه؟

90
00:07:50,080 --> 00:07:51,120
هذا ما أعتقده

91
00:07:51,850 --> 00:07:54,590
لكن رأيتُ كيفيّة تحضيرها مرّة واحدة فقط

92
00:07:55,180 --> 00:07:57,380
!أعتمد عليكِ، بجدّية

93
00:07:57,380 --> 00:07:59,200
سأناديك عندما تجهز

94
00:08:07,950 --> 00:08:09,450
حرّكي هذا

95
00:08:09,450 --> 00:08:10,960
!حـ-حاضرة

96
00:08:16,010 --> 00:08:17,140
!ماذا تفعلين؟

97
00:08:17,530 --> 00:08:18,890
أسحق الثّلج

98
00:08:18,890 --> 00:08:21,350
...إنّه صغير للغاية

99
00:08:21,690 --> 00:08:22,600
لا تقلقي

100
00:08:29,100 --> 00:08:30,760
جيّد

101
00:08:30,760 --> 00:08:31,570
ملح؟

102
00:08:32,030 --> 00:08:34,530
شاولان، ضعي وعاءكِ هنا

103
00:08:34,960 --> 00:08:35,900
!حاضرة

104
00:08:46,910 --> 00:08:48,480
ماذا؟ مستحيل

105
00:08:50,670 --> 00:08:52,380
!بدأ يتصلّب

106
00:08:52,380 --> 00:08:55,040
.شاولان، قطّعي الفاكهة
قطع صغيرة، اتّفقنا؟

107
00:08:55,040 --> 00:08:56,430
!حـ-حسناً

108
00:08:58,660 --> 00:09:04,160
،أضيفي الفواكه، وتابعي الخلط
...وضعيها في الوعاء

109
00:09:08,120 --> 00:09:09,340
!هل انتهت؟

110
00:09:09,730 --> 00:09:11,470
...هل هذه

111
00:09:11,470 --> 00:09:13,770
أجل، إنّها مُثلّجات

112
00:09:15,740 --> 00:09:17,860
ينبغي أن تكون كافية

113
00:09:17,860 --> 00:09:22,740
لو كنتُ أمتلك وقتاً أطول، لاستطعتُ
إضافة بيض أو تعطيرها ببعض الأعشاب

114
00:09:23,190 --> 00:09:24,730
لنُقدّم لها هذه فوراً

115
00:09:24,730 --> 00:09:26,830
...أجل، لكن

116
00:09:27,180 --> 00:09:29,840
ألا ينبغي أن نتذوّقها أوّلاً؟

117
00:09:30,590 --> 00:09:33,090
عادت إلى طبيعتها المعتادة

118
00:09:36,380 --> 00:09:37,920
هناك بعض البقايا

119
00:09:39,990 --> 00:09:43,060
!شهيّة

120
00:09:43,380 --> 00:09:45,850
!ماذا؟ هل هي جاهزة؟

121
00:09:46,540 --> 00:09:47,980
سلّمها من فضلك

122
00:09:49,800 --> 00:09:51,900
—هل أنتِ متأكّدة من أنّها ستكون مُناسبة

123
00:09:55,230 --> 00:09:56,780
هل ترى أي مُشكلة فيها؟

124
00:09:59,140 --> 00:10:00,770
إلى المحظيّة روران، بسرعة من فضلك

125
00:10:00,770 --> 00:10:02,070
!عُـ-عُلِم

126
00:10:04,910 --> 00:10:08,790
!أنا مُطمئنّة! شكراً يا ماوماو

127
00:10:09,160 --> 00:10:12,840
لا أعلم. آمل أن تُعجب المحظيّة روران

128
00:10:13,640 --> 00:10:15,670
!لا تكوني لئيمة

129
00:10:16,180 --> 00:10:19,690
أخبرني مولايّ جينشي عمّا تُحبّ وتكره

130
00:10:19,690 --> 00:10:21,640
أنا متأكّدة بأنّها سوف تتذوّقها على الأقلّ

131
00:10:22,060 --> 00:10:26,020
عجباً! على أيّ حال، لنأكل الباقي
قبل أن يذوب

132
00:10:26,020 --> 00:10:28,020
!أجل، لنفعل ذلك

133
00:10:28,330 --> 00:10:29,540
!شيسوي

134
00:10:29,540 --> 00:10:30,900
ماذا تفعلين هنا؟

135
00:10:30,900 --> 00:10:35,790
سمعتُ بالجلبة، لذا تركتُ العمل وأتيت

136
00:10:35,790 --> 00:10:37,400
!أنتِ شقيّة جدّاً

137
00:10:40,490 --> 00:10:42,590
!هذا شهيّ

138
00:10:43,020 --> 00:10:47,120
مهلاً، لا تأكلي القسمَ الأشهى

139
00:10:53,610 --> 00:10:55,600
!هذه لي

140
00:10:54,370 --> 00:10:59,690
!هيّا! لا تأخذيها كلّها

141
00:10:57,010 --> 00:10:59,690
!إنّها لي، كلّها لي

142
00:11:00,540 --> 00:11:02,520
سأحتاج مزيداً من هذا

143
00:11:02,520 --> 00:11:04,350
!بربّكِ

144
00:11:04,350 --> 00:11:06,600
!أمسكتِني

145
00:11:06,940 --> 00:11:08,910
!أو ربّما لا

146
00:11:06,940 --> 00:11:09,670
ربّما لديّ ما يكفي لدفعة إضافيّة

147
00:11:10,100 --> 00:11:11,310
!انتظري

148
00:11:11,310 --> 00:11:12,850
!حسناً، افتحي فمكِ

149
00:11:13,630 --> 00:11:16,680
!شهيّة للغاية

150
00:11:17,610 --> 00:11:21,180
!دوركِ تالياً يا شيسوي. افتحي فمكِ

151
00:11:31,290 --> 00:11:34,600
إنّه يتحرّك

152
00:11:43,870 --> 00:11:46,180
لينغلي، هل تريدين أن تلمسي؟

153
00:12:01,780 --> 00:12:04,280
سوف تَلِد قريباً

154
00:12:13,890 --> 00:12:16,130
يبدو كلّ شيء على ما يُرام حاليّاً

155
00:12:17,190 --> 00:12:18,630
هذا غريب

156
00:12:18,630 --> 00:12:22,170
بخلاف لينغلي، هذا الجنين
يركل في الجهة السّفليّة فقط

157
00:12:23,400 --> 00:12:24,180
السّفليّة؟

158
00:12:24,610 --> 00:12:27,550
أعتقد أنّ التّصرّفات المُميّزة
تتجلّى في هذا الوقت المُبكّر

159
00:12:34,670 --> 00:12:37,940
هل لي أن ألمس، ولو قليلاً؟

160
00:12:38,660 --> 00:12:40,590
بالتّأكيد

161
00:12:41,260 --> 00:12:42,500
المعذرة

162
00:12:54,570 --> 00:12:57,630
كيف كانت عمليّة إنجاب الأميرة لينغلي؟

163
00:12:57,630 --> 00:13:01,130
كانت سهلة للغاية رغم أنّها
كانت ولادتها الأُولى

164
00:13:01,420 --> 00:13:05,390
ربّما ما ساهمَ في ذلك هو
أنّ جسدها كان صغيراً جدّاً

165
00:13:05,390 --> 00:13:07,010
من ساهمَ في عمليّة التّوليد؟

166
00:13:07,010 --> 00:13:09,080
أنا

167
00:13:09,080 --> 00:13:11,380
،لا أثق بالأطبّاء هنا

168
00:13:11,380 --> 00:13:15,630
وفتاة البلاط الّتي وظّفناها
لعمليّة التّوليد قد مرضتْ

169
00:13:16,200 --> 00:13:18,770
درستُ كثيراً سلفاً، لذا نجح الأمر

170
00:13:19,210 --> 00:13:22,060
إذاً، هل ستقدّمين طلباً لفتاة
البلاط تلك ثانية؟

171
00:13:22,060 --> 00:13:26,360
لا، لا أُريدها أن تمرض في الوقت
غير المُناسب ثانية

172
00:13:27,090 --> 00:13:30,730
سمعتُ أنّ المحظيّة ريفا قد جاءها
شخص آخر عندما كانت تَلِد أيضاً

173
00:13:30,730 --> 00:13:34,370
زوجة في مُنتصف العمر دخلتْ
القصرَ الخلفيّ مؤقّتاً من الأساس

174
00:13:34,900 --> 00:13:36,360
...هكذا إذاً

175
00:13:37,410 --> 00:13:41,010
هل يحضرون شخصاً من خارج
القصر الخلفيّ ثانية؟

176
00:13:41,010 --> 00:13:43,000
حتّى لو ساهمت السيّدة هونيان
،في الأمر في المرّة السّابقة

177
00:13:43,000 --> 00:13:45,670
إنّها ليست مُحترفة في المجال

178
00:13:47,540 --> 00:13:49,800
إن كانت لديكِ مُشكلة، فاذكريها رجاء

179
00:13:53,560 --> 00:13:58,020
لا يمكنني الجزم، لكن قد تكون
هذه ولادة مقعديّة

180
00:13:59,650 --> 00:14:00,810
ولادة مقعديّة؟

181
00:14:01,190 --> 00:14:05,610
أجل، إنّ الرّكل نحو جهة الأسفل
هو من مُؤشّرات ذلك

182
00:14:06,050 --> 00:14:11,120
،فلو كانت الأميرة لينغلي تركل للأعلى
فلا بدّ أنّ رأسها كان في الأسفل

183
00:14:11,730 --> 00:14:16,880
تكون عمليّة الولادة سلِسة جدّاً عندما
يخرج الرّأس، الجزء الأكبر، أوّلاً

184
00:14:17,300 --> 00:14:20,420
،بالمقابل، عندما تخرج القدمان
،الجزء الأصغر، أوّلاً

185
00:14:20,420 --> 00:14:23,880
فهذا يُعزّز بشكل كبير من المخاطر
المُرتبطة بعمليّة الولادة

186
00:14:28,130 --> 00:14:30,140
هل أنتِ متأكّدة بأنّها ستكون
ولادة مقعديّة؟

187
00:14:30,980 --> 00:14:33,310
هذا مُجرّد احتمال

188
00:14:33,310 --> 00:14:37,270
،إذا استطعتُ الفحص بشموليّة أكبر
فقد أتأكّد أكثر

189
00:14:37,910 --> 00:14:39,070
هل يمكنكِ ذلك؟

190
00:14:41,560 --> 00:14:46,780
لا يمكنني الجزم. أبي علّمني الطبَّ فقط

191
00:14:47,460 --> 00:14:49,480
بينما أيّ شيء آخر كنتُ أُراقبه فحسب

192
00:14:50,740 --> 00:14:51,870
افعليها من فضلكِ

193
00:14:58,040 --> 00:15:00,260
...بالمناسبة، بـ"الفحص"، أقصد

194
00:15:02,540 --> 00:15:04,290
حقّاً؟

195
00:15:06,620 --> 00:15:10,320
هذا لا شيء مُقارنة بإنجابها هي

196
00:15:12,100 --> 00:15:14,480
الأُمّهات قويّات على ما أعتقد

197
00:15:18,570 --> 00:15:19,740
عُلِم

198
00:15:33,290 --> 00:15:34,720
إلى ماذا توصّلتِ؟

199
00:15:34,720 --> 00:15:36,740
...يؤلمني قول هذا، لكن

200
00:15:38,250 --> 00:15:40,960
يبدو الأمر مُرجّحاً

201
00:15:42,100 --> 00:15:45,440
أحياناً يُغيّر الجنينُ جهته
،من تلقاء نفسه قبل الولادة

202
00:15:45,440 --> 00:15:47,990
...لكن نظراً إلى قصر الوقت المُتبقّي

203
00:15:50,290 --> 00:15:51,800
ماذا عسانا نفعل؟

204
00:15:52,140 --> 00:15:57,310
في حيّ الملذّات، سمعتُ أنّ كَيّ
الجلد والتّمرين الجيّد مُفيدان

205
00:15:58,790 --> 00:16:00,480
يمكنني المُساعدة بكَيّ الجلد

206
00:16:00,480 --> 00:16:02,120
من فضلكِ

207
00:16:02,120 --> 00:16:06,230
سأسأل خارج القصر الخلفيّ
عن أيّ شيء آخر قد يُفيد

208
00:16:06,890 --> 00:16:07,980
أجل

209
00:16:10,280 --> 00:16:15,030
ماذا سيحدث إذا انتهى المطاف بها
ولادة مقعديّة؟

210
00:16:16,730 --> 00:16:19,370
قد نضطرّ لشقّ بطنكِ

211
00:16:20,420 --> 00:16:21,380
هكذا إذاً

212
00:16:21,960 --> 00:16:23,370
...مولاتي غيوكويو

213
00:16:24,190 --> 00:16:27,860
لكن إذا فعلنا ذلك، فستكون حياة
مولاتي غيوكويو في خطر

214
00:16:28,350 --> 00:16:31,630
إنّه خطير بما يكفي حتّى بالنّسبة
لزوجة في مُنتصف العمر

215
00:16:32,420 --> 00:16:35,410
...ليت الدّجّال كان طبيباً حقيقيّاً

216
00:16:35,410 --> 00:16:37,890
لكن مَن يستطيع غيره أن يحلّ مكانه؟

217
00:16:40,890 --> 00:16:44,660
لدخول القصر الخلفيّ، يجب
على الطّبيب أن يُخصَى

218
00:16:45,170 --> 00:16:48,300
لكن أين يمكننا أن نجد طبيباً
—جيّداً ليس مخصيّاً أيضاً

219
00:16:49,100 --> 00:16:52,150
يوجد. إنّه المُرشّح المثاليّ

220
00:16:52,860 --> 00:16:53,910
...لكن

221
00:16:55,180 --> 00:16:56,410
ماوماو؟

222
00:16:58,370 --> 00:17:00,910
أعرف شخصاً

223
00:17:01,770 --> 00:17:02,910
تعرفين؟

224
00:17:02,910 --> 00:17:05,580
،شخصاً بمهارات استثنائيّة كطبيب

225
00:17:05,580 --> 00:17:08,560
ولديه خبرة أيضاً في توليد الأطفال بالشّقّ

226
00:17:10,180 --> 00:17:12,550
أحقّاً ذلك؟

227
00:17:12,900 --> 00:17:16,540
...هل يُعقَل... وصيفة لمولايّ جينشي

228
00:17:16,540 --> 00:17:18,620
لا. إنّه طبيب

229
00:17:20,770 --> 00:17:23,770
ماذا فعلت السيّدة سويرين بالضّبط؟

230
00:17:24,280 --> 00:17:25,770
من هو هذا الشّخص؟

231
00:17:26,250 --> 00:17:30,030
نُفي سابقاً من القصر الخلفيّ

232
00:17:30,990 --> 00:17:32,030
مُجرم

233
00:17:34,280 --> 00:17:35,860
!هذا غير مقبول

234
00:17:35,860 --> 00:17:39,130
حياة مولاتي غيوكويو والرّضيع على المحكّ

235
00:17:39,130 --> 00:17:41,030
!يجب أن يكون شخصاً موثوقاً

236
00:17:41,030 --> 00:17:44,290
إنّه موثوق! إنّه أفضل طبيب
!في هذه الدّولة

237
00:17:47,240 --> 00:17:51,330
هذا كلام جريء ونادر أن أسمعه منكِ

238
00:17:51,330 --> 00:17:52,630
لكن هذا لا يمنع بأنّه مُجرم، صحيح؟

239
00:17:54,260 --> 00:17:55,840
هذا غير مقبول بتاتاً

240
00:17:55,840 --> 00:17:56,700
—لكن

241
00:17:56,700 --> 00:17:58,340
انتظرا

242
00:17:58,690 --> 00:18:01,630
هونيان، لا تُقاطعيها قبل أن تنتهي

243
00:18:01,630 --> 00:18:04,350
ماوماو، اهدئي من فضلكِ واشرحي

244
00:18:09,030 --> 00:18:11,280
ما الجريمة الّتي ارتكبها؟

245
00:18:11,890 --> 00:18:15,650
هذا الشّخص مخصيّ. وكان طبيباً
في القصر الخلفيّ

246
00:18:16,950 --> 00:18:20,530
،في الماضي، ساهمَ في توليد الإمبراطور
وليّ العهد الحاليّ

247
00:18:20,530 --> 00:18:24,100
ورضيع المحظيّة آدو

248
00:18:24,900 --> 00:18:30,160
وبالنّسبة لسبب نفيه، جُلّ ما أعرفه
هو أنّ السّبب مُرتبط بالمحظيّة آدو

249
00:18:31,210 --> 00:18:36,260
،ليس وكأنّه أخبرني في الواقع
أو أنّني أعرف كافّة الحقائق بدقّة

250
00:18:37,190 --> 00:18:40,540
هناك بعض السجلّات، لكن معظمها تخمينات

251
00:18:41,850 --> 00:18:45,220
ما صِلته بكِ يا ماوماو؟

252
00:18:45,810 --> 00:18:49,640
إنّه أبي بالتبنّي، والشّخص الّذي
علّمني الصّيدلة

253
00:18:54,150 --> 00:18:55,420
فهمت

254
00:18:55,420 --> 00:18:58,780
لنسأل السيّد جينشي ما إن كان
يستطيع إحضار ذلك الشّخص

255
00:18:59,700 --> 00:19:00,910
!مولاتي غيوكويو

256
00:19:01,220 --> 00:19:04,910
هونيان، أريد استشارة شخص
يكون مُحترفاً حقيقيّاً

257
00:19:05,550 --> 00:19:07,780
سيكون من الأفضل إن كان
شخصاً نستطيع الوثوق به

258
00:19:08,700 --> 00:19:11,540
فضلاً عن ذلك، لا أُعتقد بأنّه شخص سيّئ

259
00:19:11,980 --> 00:19:15,040
انظري كيف تحترمه هذه القطّة الضّالّة

260
00:19:15,830 --> 00:19:16,800
قطّة ضالّة...؟

261
00:19:16,800 --> 00:19:18,440
!لكنّه مُجرم

262
00:19:18,440 --> 00:19:19,050
،هونيان

263
00:19:19,880 --> 00:19:23,780
أنا متأكّدة بأنّكِ سمعتِ قصص
القصر الخلفيّ آنذاك

264
00:19:24,590 --> 00:19:29,060
الكثير من الأشخاص قد ظُلِموا بسبب
حكم الإمبراطورة العظيمة

265
00:19:29,970 --> 00:19:33,820
لا يمكننا تصنيف "الجرائم" على
أنّها كذلك فعليّاً في ذلك الزّمن

266
00:19:37,620 --> 00:19:38,780
عُلِم

267
00:19:39,310 --> 00:19:44,280
في هذه الحالة، سأكتب رسالة

268
00:19:44,610 --> 00:19:46,280
هذا ما أُطلِق عليه بالوقار

269
00:19:46,910 --> 00:19:50,510
أعتقد هكذا تكون المحظيّة الّتي
أصبحتْ أُمّاً

270
00:19:53,180 --> 00:19:55,920
...بعد يومين من التكلّم مع مولاتي غيوكويو

271
00:19:59,270 --> 00:20:00,760
شكراً لك

272
00:20:01,720 --> 00:20:04,760
كنّا ننتظر وصولك بلهفة يا سيّد لومين

273
00:20:17,390 --> 00:20:23,430
حسناً، حسناً. من كان يتوقّع
!أن أعود إلى هنا؟

274
00:20:23,430 --> 00:20:27,580
،رجل، بدا مظهره كامرأة مُسنّة
وصل إلى القصر الخلفيّ

275
00:20:30,930 --> 00:20:32,960
أنا لومين

276
00:20:33,510 --> 00:20:39,090
سأخدم بشكل مُؤقّت في المكتب
الطّبّي التّابع للقصر الخلفيّ

277
00:20:39,090 --> 00:20:43,090
سمعتُ من ماوماو. شكراً على مُساعدتك

278
00:20:43,470 --> 00:20:44,840
العفو

279
00:20:48,100 --> 00:20:52,600
مُؤقّتاً؟ حسناً، هذا ليس غريباً على ما أعتقد

280
00:20:53,150 --> 00:20:56,480
كنتُ قلقة بعض الشّيء
من طرد الدّجّال

281
00:20:56,480 --> 00:20:58,360
يسرّني أن أعلم بأنّني ليس
عليّ القلق بشأن ذلك

282
00:20:58,740 --> 00:21:00,940
حسناً إذاً، أستأذن بالانصراف

283
00:21:03,540 --> 00:21:04,270
من فضلك

284
00:21:04,270 --> 00:21:05,150
حسناً

285
00:21:10,870 --> 00:21:15,250
هذا والد ماوماو، صحيح؟

286
00:21:15,250 --> 00:21:17,090
أجل، تقريباً

287
00:21:17,090 --> 00:21:19,750
فعليّاً، إنّه أخو جدّي

288
00:21:19,750 --> 00:21:23,440
إنّه ليس كما تخيّلناه إطلاقاً

289
00:21:24,150 --> 00:21:27,340
يبدو لطيفاً وهادئاً

290
00:21:27,340 --> 00:21:29,840
أجل، كشخص عاديّ

291
00:21:29,840 --> 00:21:33,140
هل هو من ربّى ماوماو فعلاً؟

292
00:21:33,140 --> 00:21:34,930
نفس تفكيري تماماً

293
00:21:38,490 --> 00:21:40,190
!توقّفن عن ذلك

294
00:21:40,190 --> 00:21:41,110
...أقصد

295
00:21:41,570 --> 00:21:43,570
ما الّذي كنتِ تتخيّلنَه؟

296
00:21:43,950 --> 00:21:47,740
...في الواقع

297
00:21:48,120 --> 00:21:49,870
يبدو وكأنّه شخص طبيعيّ

298
00:21:49,870 --> 00:21:51,590
تماماً

299
00:21:53,960 --> 00:21:55,190
لستُ أفهمكن

300
00:23:45,020 --> 00:23:59,950
الحلقة القادمة

301
00:23:56,220 --> 00:23:59,100
:الحلقة القادمة
"استياء مُتفاقم"