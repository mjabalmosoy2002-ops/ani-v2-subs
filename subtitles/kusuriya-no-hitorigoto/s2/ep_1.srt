1
00:01:30,480 --> 00:01:33,480
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

2
00:01:40,370 --> 00:01:41,240
هل هذا حقيقيّ؟

3
00:01:41,240 --> 00:01:41,870
بالطّبع

4
00:01:44,250 --> 00:01:46,410
!ما أجملكِ

5
00:02:22,030 --> 00:02:25,120
ما هذه الكومة الكبيرة يا جدّة؟

6
00:02:25,120 --> 00:02:27,000
طلبتها ماوماو على ما يبدو

7
00:02:27,000 --> 00:02:27,910
من جديد؟

8
00:02:29,420 --> 00:02:31,710
سيكون هذا عملاً مُربِحاً

9
00:02:31,710 --> 00:02:33,960
سلّمه كما طُلِب منك فحسب

10
00:02:33,960 --> 00:02:34,920
عُلِم

11
00:02:44,390 --> 00:02:45,760
!إنّها جميلة

12
00:02:46,270 --> 00:02:48,310
أفكّر في الاحتفاظ ببعضها في غرفتي

13
00:02:49,730 --> 00:02:51,190
هل يسير كلّ شيء على ما يُرام؟

14
00:02:51,190 --> 00:02:52,810
أ-أجل

15
00:03:22,300 --> 00:03:26,640
بعد حفلة الحديقة، طلبَ مولايّ شيشو
مزيداً من الوصيفات لأجلها

16
00:03:26,640 --> 00:03:29,020
...لكن يبدو العدد مُبالغاً به

17
00:03:29,020 --> 00:03:33,310
أجل. هذا سيؤثّر سلباً على السيّدات الأُخريات

18
00:03:34,020 --> 00:03:37,200
تحياتي أيّتها المحظيّة روران

19
00:03:46,160 --> 00:03:48,120
أتبحث عن شيء؟

20
00:03:48,120 --> 00:03:49,540
لـ-لا

21
00:03:49,540 --> 00:03:51,290
ماوماو في العيادة

22
00:04:01,010 --> 00:04:02,510
إنّه الرّبيع حقّاً

23
00:04:14,850 --> 00:04:16,400
ماذا تفعلين؟

24
00:04:16,690 --> 00:04:18,520
لماذا تسأل بهذه الطّريقة؟

25
00:04:18,980 --> 00:04:20,990
أصنع زيتاً عطريّاً

26
00:04:20,990 --> 00:04:24,910
أثناء تنظيفي للعيادة، وجدتُ مِقطرة

27
00:04:24,910 --> 00:04:29,030
أستخدم بعضاً من بقايا الورود الزّرقاء
الّتي زرعناها قبل أيّام

28
00:04:29,330 --> 00:04:30,910
الرّائحة فوّاحة حقّاً

29
00:04:30,910 --> 00:04:33,620
تبقى أضعف من الورود البرّية

30
00:04:34,120 --> 00:04:35,370
بما يمكنني خدمتك؟

31
00:04:37,170 --> 00:04:40,420
أيّ شخص كان ليقلق نظراً
إلى شدّة هذه الرّائحة

32
00:04:41,510 --> 00:04:45,260
هل تصنعينه هنا لأنّكِ لا تستطيعين
فعل ذلك في مقصورة اليشم؟

33
00:04:45,260 --> 00:04:46,720
...هذا أيضاً، لكن

34
00:04:47,260 --> 00:04:50,930
بعض الزّيوت المُعطّرة قد تُسبّب إجهاضاً

35
00:04:50,930 --> 00:04:54,350
لا ينبغي أن يكون خطيراً إلّا إذا
...كان شديد التّركيز، لكن

36
00:04:54,350 --> 00:04:58,900
إذاً لا داعي لحصر العطور وأشياء
كهذه في القصر الخلفيّ؟

37
00:04:58,900 --> 00:05:00,690
أجل. لا ينبغي أن تكون مُشكلة

38
00:05:01,150 --> 00:05:04,110
،الطّبيب الدجّال شخص لطيف
لكن لا يسكت أبداً

39
00:05:04,110 --> 00:05:07,530
لا ينبغي أن يعلم بحمل المَحظيّة غيوكويو بعد

40
00:05:07,530 --> 00:05:08,410
ما هذا؟

41
00:05:09,950 --> 00:05:12,200
أُقطِّر الكحول

42
00:05:12,200 --> 00:05:15,660
بالتّقطير بشكل مُتكرّر، يمكنني
صنع كحول قويّ جدّاً

43
00:05:17,710 --> 00:05:19,000
!ستشربين هذا؟

44
00:05:19,000 --> 00:05:20,750
إنّه للتّطهير من الجراثيم

45
00:05:20,750 --> 00:05:22,760
أريد أن تكون مقصورة اليشم
،نظيفة قدر الإمكان

46
00:05:22,760 --> 00:05:25,340
بما أنّ لدينا أميرة صغيرة هناك

47
00:05:25,340 --> 00:05:27,300
يمكنك فعل ذلك؟

48
00:05:27,300 --> 00:05:33,180
ننقع قماشة به ونسمح السّطوح
وغيرها من الأشياء

49
00:05:33,470 --> 00:05:35,020
أنتِ واسعة الاطِّلاع

50
00:05:35,020 --> 00:05:37,190
سمعتُ أنّ هذا ما يفعلونه في الغرب

51
00:05:37,190 --> 00:05:40,440
...صحيح. أبوكِ بالتبنّي هو

52
00:05:40,730 --> 00:05:42,690
أحضرنا طردك

53
00:05:48,990 --> 00:05:50,490
ما هذا؟

54
00:05:50,490 --> 00:05:52,700
—إنّ الآنسة الصّغيرة

55
00:05:54,200 --> 00:05:58,040
.سيّدي جينشي، سأعدّ الشّاي
تفضّل بالجلوس

56
00:05:58,040 --> 00:05:59,290
ما محتواه؟

57
00:05:59,880 --> 00:06:03,250
!هذا طردٌ من عائلتي. لا شيء صدّقني

58
00:06:03,750 --> 00:06:06,090
من عائلتكِ؟

59
00:06:06,090 --> 00:06:07,380
!ما مُشكلة هذا الرّجل؟

60
00:06:07,380 --> 00:06:11,390
يـ-يوجد... ملابس داخليّة

61
00:06:12,510 --> 00:06:14,430
هـ-هكذا إذاً

62
00:06:15,310 --> 00:06:20,980
لكن ممّا صُنِعت هذه الملابس الدّاخليّة
إذا كانت تحتاج رجلين ليحملها؟

63
00:06:25,190 --> 00:06:27,150
مُشكلة القصر الخلفيّ هي

64
00:06:27,150 --> 00:06:30,660
أنّه يُؤمَل من النّساء أن يكنّ
بريئات جدّاً في مسائل الجنس

65
00:06:30,950 --> 00:06:34,660
معظم الوصيفات المُجتمعات هنا عذراوات

66
00:06:35,160 --> 00:06:37,330
،ماذا لو أُعجِبَ الإمبراطور بفتاة

67
00:06:37,330 --> 00:06:40,670
فتفشل في أدائها نظراً إلى جهلها؟

68
00:06:41,080 --> 00:06:43,960
لهذا ارتأيتُ بأنّه يجب تثقيفهن سلفاً

69
00:06:43,960 --> 00:06:46,800
لذا... طلبتِ إحضار هذه؟

70
00:06:47,550 --> 00:06:50,840
.كُتُب كتلك الّتي في ذلك الوقت
كما تعلم، آنذاك

71
00:06:52,590 --> 00:06:55,390
بعد كلّ العناء الّذي تكبّدتُه
،لتوصيلهم إلى العيادة

72
00:06:55,390 --> 00:06:57,100
...بعيداً عن أنظار السيّدة هونيان

73
00:06:57,680 --> 00:07:00,600
كنتُ أطلب إيصالها للإمبراطور
،الّذي يحبّ هذه الأشياء

74
00:07:00,600 --> 00:07:04,570
لكن عزّزتُ الطّلبات من أجل تحسين العمل

75
00:07:04,570 --> 00:07:06,320
في الوقت غير المناسب

76
00:07:09,320 --> 00:07:10,610
...هذه الكُتُب

77
00:07:10,990 --> 00:07:13,530
مُتقَنة جدّاً

78
00:07:13,530 --> 00:07:15,490
الورق بجودة عالية

79
00:07:15,490 --> 00:07:19,540
هذا ما لاحظه؟ ظننتُه مُنحرفاً بالسرّ

80
00:07:19,540 --> 00:07:22,710
تُستخدَم هذه الكُتُب أحياناً
،كجزء من طرد عروس جديدة

81
00:07:22,710 --> 00:07:26,630
وهي شهيرة لأنّ الصُّور بحدّ ذاتها
مُمتعة، حتّى لو كنت لا تُجيد القراءة

82
00:07:26,630 --> 00:07:27,750
طباعة

83
00:07:27,750 --> 00:07:31,590
ليست طباعة خشبيّة، بل طباعة
تستخدم صفائحَ معدنيّة

84
00:07:31,590 --> 00:07:32,930
هذا مُبهر

85
00:07:32,930 --> 00:07:37,640
أجل. لأنّه مُتقَن، أردتُ من أكبر
عدد من النّاس رؤيته

86
00:07:38,140 --> 00:07:40,560
هذه مسألة مُنفصلة

87
00:07:44,940 --> 00:07:47,900
إذا لفت اهتمامك، فيمكنك الاحتفاظ بنسخة

88
00:07:48,530 --> 00:07:51,030
!لـ-لا! هذا غير صحيح على الإطلاق

89
00:07:53,160 --> 00:07:55,910
أعتقد يمكنني أن أدعك وشأنك هذه المرّة فقط

90
00:07:55,910 --> 00:07:57,410
!حقّاً؟

91
00:07:57,740 --> 00:08:00,250
أخبريني ما المتجر الّذي يبيع هذه

92
00:08:02,620 --> 00:08:05,790
!لا! أريد فقط معرفة تقنيّاتهم في الطّباعة

93
00:08:07,420 --> 00:08:11,300
أجل، بالطّبع. المتجر، فهمت

94
00:08:14,260 --> 00:08:15,550
شاوماو

95
00:08:15,550 --> 00:08:16,350
ما الأمر؟

96
00:08:17,180 --> 00:08:20,600
ربّما هناك المزيد من الأشياء
الفاضحة بحاجة لرقابة

97
00:08:21,060 --> 00:08:25,020
لكن قال الإمبراطور بأنّ النّسخ السّابقة
—لم تكن مُشوِّقة بما يكفي، لذا

98
00:08:25,020 --> 00:08:26,230
لا

99
00:08:29,400 --> 00:08:33,320
بعد أن طلبتُ من الجدّة القيام بكلّ ذلك
...العمل في انتقاء الأفضل

100
00:08:41,830 --> 00:08:48,340
...ما الّذي أبحث عنه، تحت تلك الزّهور الجميلة

101
00:08:52,090 --> 00:08:55,130
ما الّذي دُفِنَ هناك برأيك؟

102
00:08:57,390 --> 00:08:58,300
سماد؟

103
00:08:59,560 --> 00:09:01,270
أكلتِ بسرعة فائقة

104
00:09:01,270 --> 00:09:02,770
!لا، هذه غلطتكِ

105
00:09:02,770 --> 00:09:05,350
!هذه الرّواية مشهورة حقّاً

106
00:09:05,350 --> 00:09:07,560
هل تُجيدين القراءة يا شاولان؟

107
00:09:07,560 --> 00:09:12,190
لا! لكن إحدى الفتيات تجيد القِراءة
وتفعل ذلك بصوتٍ عالٍ لأجلنا

108
00:09:12,190 --> 00:09:14,700
!أريد معرفة الباقي

109
00:09:15,400 --> 00:09:19,620
،إذا كانت حتّى الخادمات الأُمّيات يعرفنَ القصّة

110
00:09:19,620 --> 00:09:21,540
فهذا يعني أنّ الكتاب مشهور جدّاً حقّاً

111
00:09:26,620 --> 00:09:28,080
عُدت

112
00:09:28,630 --> 00:09:29,840
ما هذا؟

113
00:09:29,840 --> 00:09:33,260
وزّعه الإمبراطور على كافّة المَحظيّات

114
00:09:33,260 --> 00:09:36,760
،قال أنّه حالما ينتهين من قراءته
سيوزّعون التّكملة

115
00:09:36,760 --> 00:09:38,430
هل تريدين قراءته أيضاً يا ماوماو؟

116
00:09:39,470 --> 00:09:44,850
يبدو أنّه مثل الّذي تحدّثت عنه
شاولان. رواية شهيرة

117
00:09:44,850 --> 00:09:50,610
تُعَدُّ هذه من طبقة مُتدنّية في المُجتمع
...الرّفيع. لذا أتساءل عن السّبب

118
00:09:50,610 --> 00:09:53,110
...هذا الطّابع

119
00:09:53,110 --> 00:09:55,740
إنّه من المكان الّذي أخبرتُ سيّد
جينشي عنه قبل أيّام

120
00:09:56,110 --> 00:10:00,160
،قد تكون رواية، لكنّها ذات جودة عالية
ملائمة كهديّة من الإمبراطور

121
00:10:00,160 --> 00:10:04,910
،إذا وزّعها على كافّة المَحظيّات
فلا بدّ أنّ هناك مئة نسخة على الأقلّ

122
00:10:04,910 --> 00:10:08,000
لا بدّ أنّ السيّد جينشي طلب
من الإمبراطور فعل ذلك

123
00:10:08,000 --> 00:10:12,000
!كم هي مُمتعة! لا أستطيع التوقُّف

124
00:10:08,460 --> 00:10:11,170
!كان ينبغي أن أفرض عمولة

125
00:10:12,000 --> 00:10:15,710
لكن لماذا؟ تُعتبَر الرّوايات شيء وضيع

126
00:10:15,710 --> 00:10:19,130
...لِمَ توزيعها على مَحظيّات ذوات عِرق نبيل

127
00:10:22,720 --> 00:10:28,440
.عرفتُ بأنّه كان للأمر علاقة بالسّياسة
كان يخطّط لشيء فعلاً

128
00:10:28,440 --> 00:10:30,520
!لا، أنهيتُها

129
00:10:30,900 --> 00:10:33,110
!أريد قراءة الباقي

130
00:10:33,110 --> 00:10:37,820
قال السيّد غاوشون بأنّه سيوزّع
النّسخة الجديدة عندما تجهز

131
00:10:37,820 --> 00:10:39,200
هل من مُشكلة؟

132
00:10:40,780 --> 00:10:44,080
حسناً، نحن الوصيفات الوحيدات
في مقصورة اليشم، صحيح؟

133
00:10:44,080 --> 00:10:50,170
أشعر أنّه من الهدر أن نكون نحن الوحيدات
اللّواتي نستمتع بهديّة كهذه من السيّدة غيوكويو

134
00:10:50,170 --> 00:10:54,590
لكن لا يمكننا إعطاءها لفتيات من خارج
المقصورة. إنّها ثمينة جدّاً

135
00:10:54,590 --> 00:10:56,510
ماذا لو أضعنَها؟

136
00:10:56,960 --> 00:10:58,720
معكِ حقّ

137
00:11:00,760 --> 00:11:05,640
بدلاً من توزيع النّسخ الأصليّة، يمكنك
إنشاء نسخ بنفسكِ

138
00:11:06,600 --> 00:11:11,480
قد تكون الصّور صعبة للغاية، لكن
يا سيّدة آيلان، فنّ الخطّ لديكِ ممتاز

139
00:11:11,900 --> 00:11:14,440
لا ينبغي أن يكون صنع نُسَخ صعباً بالنّسبة لكِ

140
00:11:14,440 --> 00:11:16,360
أ-أوتظنّين ذلك؟

141
00:11:16,360 --> 00:11:19,110
!بئساً، يبدو هذا شاقّاً للغاية

142
00:11:19,110 --> 00:11:21,780
!إنفا، لا تقولي ذلك

143
00:11:21,780 --> 00:11:26,240
هذا هو غالباً التّفسير الصّحيح
لفكرة السيّد جينشي

144
00:11:22,240 --> 00:11:23,700
لنجرّب ذلك

145
00:11:23,700 --> 00:11:25,370
من أين ينبغي أن نبدأ؟

146
00:11:26,740 --> 00:11:29,000
،إذا اشتهرت الكُتُب في القصر الخلفيّ

147
00:11:29,290 --> 00:11:32,120
،فسيرغب الكثيرون في مُحاولة تعلُّم القراءة

148
00:11:32,120 --> 00:11:35,380
لا سيّما إذا كان الكتاب رواية شهيرة

149
00:11:36,250 --> 00:11:41,090
آنذاك عندما كنتُ خادمة السيّد
...جينشي، طرح عليّ سؤالاً

150
00:11:41,510 --> 00:11:45,600
أيّتها الصّيدلانيّة، ما الّذي يمكننا فعله برأيك
لمحو الأُمّية بين سيّدات البلاط؟

151
00:11:46,470 --> 00:11:50,180
رغم ذلك، اختارَ طريقة التفافيّة للقيام بذلك

152
00:11:53,100 --> 00:11:54,600
!ماوماو

153
00:11:54,600 --> 00:11:56,900
!أرجوكِ علّميني القراءة والكتابة

154
00:11:56,900 --> 00:11:57,980
ما هذا الطّلب فجأة؟

155
00:11:58,480 --> 00:12:03,780
الفتاة الّتي تقرأ الرّوايات بصوتٍ عالٍ لنا
ضَعُفَ صوتها من شدّة القراءة

156
00:12:03,780 --> 00:12:08,700
بدلاً من ذلك، استخرجَتْ نُسخاً
من الكُتُب لأجلنا، لكن لا أجيد القراءة

157
00:12:08,700 --> 00:12:10,000
—إذاً يمكنني قراءتها لكِ

158
00:12:10,000 --> 00:12:11,200
!لا

159
00:12:12,960 --> 00:12:17,960
قضتْ تلك الفتاة الكثير من الوقت وهي
تصنع نُسخاً لي. لا يجوز أن أغشّ هكذا

160
00:12:20,840 --> 00:12:22,090
فتاة طيّبة

161
00:12:21,130 --> 00:12:23,880
!ما هذا الّذي تفعلينه فجأة؟

162
00:12:24,840 --> 00:12:28,510
هذا هو اسمكِ. حاولي أن تكتبيه بنفسكِ

163
00:12:28,510 --> 00:12:29,390
!عُلِم

164
00:12:32,270 --> 00:12:35,980
لم أكن أعلم أنّ اسمي مُعقّد هكذا

165
00:12:35,980 --> 00:12:39,980
،إنّ الكتابة تساعدكِ في تعلُّم القراءة أيضاً
لكن هل تريدين التّركيز على القراءة فقط؟

166
00:12:39,980 --> 00:12:43,150
!لا، قد أتعلّم الكتابة أيضاً

167
00:12:43,490 --> 00:12:47,120
،حالما أغادر القصر الخلفيّ
يجب أن أمارس عملاً مستقلّاً

168
00:12:47,120 --> 00:12:49,160
القدرة على القراءة والكتابة مُفيدة، صحيح؟

169
00:12:52,120 --> 00:12:53,540
!ما هذا؟

170
00:12:52,620 --> 00:12:56,210
شاولان تفكّر في مستقبلها على طريقتها الخاصّة

171
00:12:56,750 --> 00:12:59,130
لنسرع أكثر قليلاً إذاً

172
00:12:59,130 --> 00:13:00,670
!أجل، شكراً لكِ

173
00:13:01,340 --> 00:13:02,880
ماذا تعني هذه؟

174
00:13:02,880 --> 00:13:04,300
فطريّات

175
00:13:04,300 --> 00:13:05,220
وهذه؟

176
00:13:05,630 --> 00:13:06,890
داتورة شائكة

177
00:13:07,510 --> 00:13:08,600
وهذه؟

178
00:13:08,600 --> 00:13:09,760
جذر كودزو

179
00:13:10,560 --> 00:13:14,940
هل هذه كلمات شائعة الاستخدام؟

180
00:13:16,020 --> 00:13:17,810
ينبغي أن نبدأ بالتّحيات

181
00:13:17,810 --> 00:13:18,980
فكرة سديدة

182
00:13:47,090 --> 00:13:50,100
هل يُسمَح للأميرة لينغلي بالتمشّي الآن؟

183
00:13:50,100 --> 00:13:55,520
أجل. أصبحت المقصورة ضيّقة جدّاً
عليها، لذا طلبتُ ذلك

184
00:13:56,140 --> 00:13:58,850
تحبّ حقّاً الجري في كلّ أرجاء المكان

185
00:13:58,850 --> 00:14:00,190
ما رأيكِ يا ماوماو؟

186
00:14:00,810 --> 00:14:06,650
أتّفق. لأجل صحّة الأميرة، سيكون
من الأفضل لها أن تخرج أكثر

187
00:14:07,240 --> 00:14:10,410
سيتبعها مخصيّان كحارسين

188
00:14:10,410 --> 00:14:13,490
هل يمكنك وهونيان مُرافقتها؟

189
00:14:13,790 --> 00:14:15,000
عُلِم

190
00:14:15,410 --> 00:14:19,250
كلّ أطفال الإمبراطور السّابقين قد توفّوا
عن عمر صغير جدّاً

191
00:14:19,250 --> 00:14:21,880
تبدو هذه كردّة فعل مُبالغ فيها
،بالنّسبة لمجرّد مشي

192
00:14:21,880 --> 00:14:23,590
لكن أعتقد هذا مُبرَّر

193
00:14:24,130 --> 00:14:27,010
ماوماو، معلوماتكِ واسعة حول
الزّهور والمخلوقات

194
00:14:27,010 --> 00:14:29,470
هل يمكنكِ تعليم لينغلي أثناء وجودنا في الخارج؟

195
00:14:30,340 --> 00:14:34,810
كلّا يا مولاتي غيوكويو، ستُعلّم
الأميرة أشياء سيّئة

196
00:14:35,220 --> 00:14:38,730
ماذا؟ أعتقد بأنّ هذا مُفيد

197
00:14:38,730 --> 00:14:41,690
لا أحد يعلم مِمَّن ستتزوّج

198
00:14:41,690 --> 00:14:47,070
ما زالت الأميرة طفلة، لكن بعد عقد
من الزّمن، قد تبدأ مُفاوضات زواجها

199
00:14:47,860 --> 00:14:52,570
إذا سافرت إلى بلد أجنبيّة، فليس
من الضّرورة أن يُرحَّب بها

200
00:14:54,580 --> 00:14:58,830
لا يمكن ألّا تكون المعرفة بشأن
الأدوية والسّموم غير مُفيدة

201
00:14:58,830 --> 00:15:00,580
إنّها فعلاً مَحظيّة ذكيّة

202
00:15:07,670 --> 00:15:10,430
تتفاوت ردود الأفعال على رؤية الأميرة

203
00:15:12,050 --> 00:15:15,310
هذا يُمثّل اختلاف الآراء حولها

204
00:15:15,970 --> 00:15:19,810
لعلّها قريباً ستُدرك معنى تلك النّظرات

205
00:15:22,900 --> 00:15:24,810
هذه زهرة الرّبيع

206
00:15:31,240 --> 00:15:33,200
!سعادة الأميرة

207
00:15:35,410 --> 00:15:36,740
!سعادة الأميرة

208
00:15:38,830 --> 00:15:40,750
!سعادة الأميرة! لا يجوز لكِ ذلك

209
00:15:40,750 --> 00:15:41,710
سأذهب لإلقاء نظرة

210
00:15:47,590 --> 00:15:48,880
هرّة؟

211
00:15:57,060 --> 00:15:58,470
!سعادة الأميرة

212
00:16:02,100 --> 00:16:03,940
يجب أن أمسك بها؟

213
00:16:03,940 --> 00:16:05,310
حسناً

214
00:16:13,950 --> 00:16:14,910
!وجدتُكِ

215
00:16:20,830 --> 00:16:22,210
أتريدين هذه؟

216
00:16:28,500 --> 00:16:33,380
.ظننتُ بأنّكِ كنتِ تحاولين الإمساك بها
هل كنتُ على خطأ؟

217
00:16:34,340 --> 00:16:36,010
شكراً لكِ

218
00:16:36,010 --> 00:16:36,750
تفضّلي

219
00:16:37,680 --> 00:16:41,390
!لا بدّ أنّها جائعة. سأدعها لكِ

220
00:16:42,100 --> 00:16:42,980
!إلى اللّقاء

221
00:16:48,020 --> 00:16:49,820
...ماوماو، هل هذه

222
00:16:49,820 --> 00:16:51,650
أجل، قطّة

223
00:16:53,110 --> 00:16:57,490
إنّها قذرة. لا ينبغي للأميرة لمسها حالياً

224
00:16:58,620 --> 00:17:00,240
...أ-أجل

225
00:17:04,000 --> 00:17:08,590
لنحتفظ بها حالياً. سأبلغ الإدارة

226
00:17:08,590 --> 00:17:09,130
حسناً

227
00:17:09,500 --> 00:17:12,300
كم هذا نادر. هرّة

228
00:17:12,610 --> 00:17:13,840
أنا وجدتُها

229
00:17:13,840 --> 00:17:16,340
المسكينة! إنّها ترتجف

230
00:17:16,340 --> 00:17:20,060
غليتُ بعض الماء للتو. مهلاً لحظة

231
00:17:21,600 --> 00:17:23,850
لكن هذا غريب

232
00:17:24,680 --> 00:17:28,350
لا يوجد حيوانات أليفة في القصر الخلفيّ

233
00:17:28,350 --> 00:17:30,860
،يتطلّب الاحتفاظ بحيوان رخصة

234
00:17:30,860 --> 00:17:33,570
والقطط والكِلاب يتمّ إخصاؤهم

235
00:17:33,860 --> 00:17:36,650
أين وُلِدت هذه الهرّة؟

236
00:17:37,740 --> 00:17:42,870
نلفّ قنينة من الماء السّاخن بقطعة
قماش، ثمّ نضعها بجانبها

237
00:17:42,870 --> 00:17:44,830
يبدو أنّك تألف هذا

238
00:17:44,830 --> 00:17:47,120
وجدتُ قطّة من قبل أيضاً

239
00:17:47,120 --> 00:17:49,080
كانت مُرقّطة ظريفة جدّاً

240
00:17:49,080 --> 00:17:50,040
هكذا إذاً

241
00:17:53,130 --> 00:17:57,380
إنّها نحيلة. هل لدينا حليب ماشية؟

242
00:17:57,380 --> 00:17:59,890
أكيد، سأسأل المطبخ

243
00:17:59,890 --> 00:18:01,510
وأيضاً أمعاء ماشية

244
00:18:01,810 --> 00:18:03,470
!أ-أمعاء؟

245
00:18:03,470 --> 00:18:06,310
كنتُ أفكّر في استخدامها كبديل لحلمة أمّها

246
00:18:06,310 --> 00:18:09,690
تناولنا سجق بضع مرّات، لعلّه
...يوجد بقايا في المطبخ

247
00:18:09,690 --> 00:18:11,820
أكيد، سأذهب وأسأل

248
00:18:14,530 --> 00:18:18,110
،كان من الأفضل تحميمها بماء دافئ

249
00:18:18,110 --> 00:18:20,740
لكن بحالتها الرّاهنة، لن تعيش

250
00:18:21,660 --> 00:18:25,500
،بدلاً من ذلك، سأمسح الأوساخ بقماش

251
00:18:26,000 --> 00:18:28,750
وأقتل أيّ براغيث بالزّيت

252
00:18:30,380 --> 00:18:33,210
!آنستي الصّغيرة، أحضرتُ بعض حليب الماعز

253
00:18:33,550 --> 00:18:34,920
وبعض الأمعاء كذلك

254
00:18:34,920 --> 00:18:36,550
شكراً لك

255
00:18:43,510 --> 00:18:46,520
!ما أظرفها، ما أظرفها

256
00:18:48,060 --> 00:18:51,350
في تلك اللّيلة، زار الإمبراطور مقصورةَ اليشم

257
00:18:52,860 --> 00:18:55,070
قرّرنا الاحتفاظ بالقطّة

258
00:18:56,280 --> 00:18:58,570
استمرّي في الاعتناء بها

259
00:18:59,150 --> 00:19:01,910
الإمبراطور يمكن أن يكون أباً شغوفاً أيضاً

260
00:19:01,910 --> 00:19:06,410
ماوماو تعتني بقطّة. هذا يلائم اسمكِ أيضاً

261
00:19:09,790 --> 00:19:12,380
،عندما تعافت الهرّة

262
00:19:12,380 --> 00:19:15,550
غسلتُها بمادّة تنظيف مُكوَّنة
من بذور صابون مسحوقة

263
00:19:15,550 --> 00:19:17,760
أصبح الماء رماديّاً

264
00:19:18,300 --> 00:19:21,970
،أطعمتُها حليباً لبعض الوقت
،لكن مع تعافيها

265
00:19:21,970 --> 00:19:24,760
بدأتْ تُصبح قادرة على أكل دجاج مفروم

266
00:19:24,760 --> 00:19:29,520
،عندما وضعنا صندوقاً مليئاً بالرّمل
فقد قضَتْ حاجتها بنفسها

267
00:19:33,650 --> 00:19:36,400
لا نريدكِ أن تجرحي الأميرة بأظافرك

268
00:19:36,400 --> 00:19:38,150
ما أخبار تربية الطّفلة؟

269
00:19:40,030 --> 00:19:43,240
أظنّها جاهزة لتُقدَّم للأميرة

270
00:19:43,240 --> 00:19:44,370
جيّد

271
00:19:45,490 --> 00:19:49,790
.سمك صغير؟ قد يكون قاسياً وهو نيئ
هل أغليه قليلاً؟

272
00:19:49,790 --> 00:19:51,660
بـ-بالطّبع

273
00:19:52,040 --> 00:19:53,210
إنّها أنثى

274
00:19:53,210 --> 00:19:56,170
—أجل. يسرّني بأنّنا لن نضطرّ لإخصاء

275
00:19:56,960 --> 00:19:58,340
المعذرة

276
00:19:58,340 --> 00:20:01,010
لا، لا تقلقي بشأن ذلك

277
00:20:01,010 --> 00:20:03,010
...دعني أحضر لك طعاماً خفيفاً كاعتذار

278
00:20:05,050 --> 00:20:07,390
لا يمكنني إخراج هذه على ما أعتقد

279
00:20:10,680 --> 00:20:12,190
أتريدين التّجربة؟

280
00:20:12,190 --> 00:20:14,480
لا أحبّ القطط في الواقع

281
00:20:14,480 --> 00:20:15,860
واسمك كذلك؟

282
00:20:15,860 --> 00:20:17,270
كثيراً ما يقولون لي ذلك

283
00:20:17,270 --> 00:20:20,030
سيّدي جينشي، يبدو أنّك تحبّ القطط

284
00:20:22,030 --> 00:20:24,240
ليس بقدرهما

285
00:20:24,740 --> 00:20:27,240
لا أفهم سبب هذا الولع

286
00:20:27,240 --> 00:20:31,000
،أتّفق. لكن وفقاً لعشّاق القطط

287
00:20:31,000 --> 00:20:34,460
حقيقة أنّك لا تستطيع أن تعرف ما الّذي
تفكّر فيه القطط هو جزء من جاذبيّتها

288
00:20:35,500 --> 00:20:38,710
من المُسلّي مُشاهدتها، لا يمكنك
أن تشيح بنظرك عنها

289
00:20:38,710 --> 00:20:40,960
بعد مدّة، تبدأ برغبة في لمسها

290
00:20:42,170 --> 00:20:44,180
،تتصرّف ببرود في العادة

291
00:20:44,180 --> 00:20:48,680
لكن تصبح فجأة ودودة عندما
تُطعمها، وهو أمر مُزعج

292
00:20:48,680 --> 00:20:49,970
...أ-أجل

293
00:20:50,430 --> 00:20:54,270
في تلك المرحلة، يُقال بأنّك ترضخ تماماً

294
00:20:55,560 --> 00:21:00,900
...الوخز على كفّها، تقبيلها
يبدو هذا غير صحّي إطلاقاً

295
00:21:06,860 --> 00:21:09,080
ما الخطب سيّدي جينشي؟

296
00:21:12,700 --> 00:21:14,790
بدأتُ أتخيّل ذلك أيضاً

297
00:21:18,080 --> 00:21:19,250
هكذا إذاً

298
00:21:19,840 --> 00:21:23,840
،لم يكتشفوا من أين أتت الهرّة بالضّبط

299
00:21:23,840 --> 00:21:28,340
لذا افترضوا بأنّها تسلّلتْ إلى داخل
عربة أمتعة

300
00:21:29,050 --> 00:21:30,850
...في وقت لاحق، الهرّة

301
00:21:32,970 --> 00:21:38,230
مُنِحتْ لقب "مُنذِرة اللّصوص" بواسطة الإمبراطور

302
00:21:38,730 --> 00:21:43,990
بصيغة أخرى، كُلِّفَتْ بمهمّة مُطاردة
الجرذان الّذين يهدّدون احتياطي العيادة

303
00:21:45,860 --> 00:21:47,280
...لكن

304
00:21:47,610 --> 00:21:52,660
لن أفهم أبداً سبب قرارهم
بتسميتها ماوماو

305
00:21:55,500 --> 00:21:58,120
لنتكفّل بهذا بسرعة

306
00:21:58,120 --> 00:22:00,880
أجل. القافلة قادمة قريباً

307
00:22:02,340 --> 00:22:03,760
القافلة...؟

308
00:23:45,020 --> 00:23:59,950
الحلقة القادمة

309
00:23:55,740 --> 00:23:58,080
"الحلقة القادمة: "القافلة