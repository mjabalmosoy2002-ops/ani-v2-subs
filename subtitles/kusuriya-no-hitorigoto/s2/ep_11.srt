1
00:01:30,480 --> 00:01:33,480
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

2
00:01:38,240 --> 00:01:43,790
إن أردت تنويع النّسل، فما رأيك بضمّها؟

3
00:01:43,790 --> 00:01:46,330
ينبغي أن تُخفي أشياءك المُفضّلة

4
00:01:46,330 --> 00:01:48,330
وإلّا أخفاها شخصٌ آخر عنك

5
00:01:51,960 --> 00:01:54,310
صباح الخير يا مولايّ جينشي

6
00:01:55,260 --> 00:01:57,630
هل أنت جاهز ليوم غد؟

7
00:01:57,630 --> 00:01:59,450
أجل، كلّ شيء في مكانه

8
00:01:59,450 --> 00:02:02,360
...إذاً، كلّ ما بقي هو تلك الفتاة

9
00:02:02,360 --> 00:02:04,680
،إن كنتَ ستدعها تُرافقك في هذه البعثة

10
00:02:05,020 --> 00:02:07,310
فأشكّ بأنّه سيكون من المُمكن
إخفاء الأمر عنها

11
00:02:07,600 --> 00:02:08,890
أعلم

12
00:02:09,570 --> 00:02:13,690
أنوي إخبار الصّيدلانيّة بالحقيقة
بنفسي أثناء هذه البعثة

13
00:02:14,230 --> 00:02:15,850
عن مكانتي الحقيقيّة

14
00:02:20,330 --> 00:02:22,480
ماوماو، تمّ استدعاؤكِ

15
00:02:24,290 --> 00:02:25,370
المعذرة

16
00:02:25,720 --> 00:02:28,750
مولاتي غيوكويو، بما يمكنني خدمتك؟

17
00:02:29,400 --> 00:02:31,880
في الواقع لستُ أنا من استدعاكِ

18
00:02:32,180 --> 00:02:33,340
إنّه أنا

19
00:02:35,050 --> 00:02:36,840
كيف يمكنني خدمتك؟

20
00:02:38,410 --> 00:02:42,220
أرغب منكِ أن تُعيدي هذه لي لبضعة أيّام

21
00:02:42,980 --> 00:02:43,970
أُعيدها"؟"

22
00:02:45,380 --> 00:02:48,580
أعتقد، عمليّاً، أنا موجودة في مقصورة اليشم

23
00:02:48,580 --> 00:02:52,440
بمهمّة خاصّة محدودة ضمن مدّة
حمل مولاتي غيوكويو فقط

24
00:02:52,840 --> 00:02:56,920
يا إلهي. من سيتذوّق طعامي أثناء تلك الفترة؟

25
00:02:56,920 --> 00:02:58,990
سأعيركِ خادمتي

26
00:02:58,990 --> 00:03:01,090
هل هي موثوقة؟

27
00:03:01,090 --> 00:03:01,950
بالطّبع

28
00:03:02,440 --> 00:03:06,280
لكن لبضعة أيّام فقط... هل أنت
ذاهب إلى مكان ما؟

29
00:03:06,280 --> 00:03:09,530
دُعيتُ إلى رحلة صيد بواسطة
شخص لا أستطيع رفض طلبه

30
00:03:09,530 --> 00:03:10,960
شخص لا تستطيع رفض طلبه؟

31
00:03:11,300 --> 00:03:13,610
دعوة من السيّد شيشو

32
00:03:13,610 --> 00:03:16,150
لا بدّ أنّه من الصّعب مُواكبة كلّ ذلك

33
00:03:16,150 --> 00:03:19,970
إذاً لهذا السّبب تريد أن تستعير
ماوماو خاصّتي

34
00:03:19,970 --> 00:03:23,090
أجل، أرغب في إعادتها

35
00:03:23,420 --> 00:03:28,370
وهل يجب أن تكون ماوماو؟
لديّ فتيات أُخريات

36
00:03:28,370 --> 00:03:32,770
لا، مُجرّد إعادة تلك الفتاة لي
سيكون مُناسباً

37
00:03:33,020 --> 00:03:36,170
أي فتاة هي يا ترى؟

38
00:03:36,170 --> 00:03:38,340
أقصد تلك الفتاة

39
00:03:39,020 --> 00:03:41,990
"تظلّ تقول "تلك الفتاة

40
00:03:43,580 --> 00:03:44,990
هل هناك مُشكلة؟

41
00:03:47,370 --> 00:03:48,460
غاوشون؟

42
00:03:48,460 --> 00:03:49,210
أمرك؟

43
00:03:49,690 --> 00:03:53,020
بماذا تُنادي ماوماو؟

44
00:03:53,020 --> 00:03:54,960
"أناديها بـ"شاوماو

45
00:03:55,770 --> 00:03:59,510
حسناً، بماذا تُنادي ماوماو؟

46
00:04:04,070 --> 00:04:09,090
على ذكر الأمر، لم ينادِني باسمي
من قبل. ليس وكأنّني أُبالي

47
00:04:09,090 --> 00:04:11,680
لماذا مولايّ جينشي مُتوتّر؟

48
00:04:15,620 --> 00:04:20,480
استغرق الحصول على إذن مولاتي
غيوكويو ثلاثين دقيقة

49
00:04:32,730 --> 00:04:36,080
الحرف المُستخدَم لكتابة اسم
"دولتنا "لي

50
00:04:36,080 --> 00:04:38,190
يُشير أيضاً إلى قصّة تأسيسها

51
00:04:38,700 --> 00:04:41,090
ثلاثة سيوف تحت العشب

52
00:04:41,090 --> 00:04:45,550
العشب" الّذي يعني "زهرة" أيضاً يُمثّل"
الأمّ الملكيّة، سلف الإمبراطور

53
00:04:45,550 --> 00:04:50,320
و"السّيوف" الثّلاثة تحتها تُمثّل المُحاربين
الثّلاثة الّذين ساعدوها

54
00:04:50,830 --> 00:04:57,800
من بين السّيوف الثّلاثة، السّيف الأكبر
يُمثّل شيهوكو-شو، البلاد الشّماليّة

55
00:04:58,340 --> 00:05:02,060
تلك المنطقة برمّتها تزرع السّرغوم والقمح

56
00:05:02,060 --> 00:05:05,140
إذا ذهبنا شمالاً، فإنّنا ندخل
...منطقة جبليّة

57
00:05:05,140 --> 00:05:06,910
!هل تسمعينني؟

58
00:05:08,830 --> 00:05:10,870
أنا آسفة يا سيّد باسين

59
00:05:11,550 --> 00:05:14,410
أنا أشرح المكان الّذي نذهب إليه

60
00:05:15,020 --> 00:05:16,560
...الشّماليّة

61
00:05:16,560 --> 00:05:18,280
!شيهوكو-شو

62
00:05:18,280 --> 00:05:20,080
،تحكمها عشيرة الحاكم شيشو

63
00:05:20,080 --> 00:05:22,640
وهو من دعا مولايّ جينشي
إلى رحلة الصّيد

64
00:05:23,900 --> 00:05:28,280
يستخدم الصّيد كعذر لإحضاره
إلى منطقته الخاصّة

65
00:05:28,700 --> 00:05:33,310
لم يستطع إحضار الإمبراطور، لكن
مع ذلك استطاع دعوة شخصيّة مرموقة

66
00:05:33,310 --> 00:05:36,510
لماذا يهتمّ أبي بمثل هذه الفتاة كثيراً؟

67
00:05:36,510 --> 00:05:38,930
أبي"؟"

68
00:05:38,930 --> 00:05:41,690
السيّد باسين هو ابن السيّد غاوشون على ما يبدو

69
00:05:42,770 --> 00:05:46,330
السيّد غاوشون دُعي إلى هذه الرّحلة
كضيف قائم بذاته

70
00:05:46,330 --> 00:05:49,700
لذا السيّد باسين سيؤدّي دور مُرافق
مولايّ جينشي بدلاً من ذلك

71
00:05:50,260 --> 00:05:53,660
،المخصيّون لا يُولَدون هكذا

72
00:05:53,660 --> 00:05:56,860
لذا ليس من الغريب له أن يملك
ابناً، بالنّظر إلى سنّه

73
00:05:59,180 --> 00:06:00,460
شارفنا على الوصول

74
00:06:05,720 --> 00:06:08,590
،بارتفاعها الشّاهق وطقسها البارد

75
00:06:08,590 --> 00:06:12,100
كانت هذه المنطِقة الملاذ الصّيفيّ المُفضَّل
للإمبراطور الرّاحل، وكان يزورها سنويّاً

76
00:06:13,190 --> 00:06:16,840
أعضاء العائلة الإمبراطوريّة لم يزوروها
،أثناء حكم الإمبراطور الحاليّ

77
00:06:16,840 --> 00:06:19,780
لكن تستمرّ عشيرة مولايّ شيشو
في إدارة المنطقة

78
00:06:27,370 --> 00:06:29,680
...إذاً سوف نُقيم هنا

79
00:06:37,300 --> 00:06:40,080
هذه الغرفة دافئة بشكل غريب

80
00:06:40,570 --> 00:06:44,420
وبغضّ النّظر عن ذلك، ما خطب
طريقة استرخاء هذا الرّجل؟

81
00:06:45,070 --> 00:06:48,640
لعلّه مُرهَق أكثر من المعتاد، لكن
مع ذلك، لا بدّ من وجود حدود

82
00:06:49,930 --> 00:06:51,430
هل هذا قناع وجه؟

83
00:06:51,960 --> 00:06:56,310
هل عليه إخفاء جماله كلّما غادر الغرفة؟

84
00:06:57,910 --> 00:06:59,890
بماذا ينبغي أن أُناديك أثناء وجودنا هنا؟

85
00:07:00,310 --> 00:07:02,770
في الأماكن المُغلَقة، يمكنك
مُناداتي بالاسم المعتاد

86
00:07:02,770 --> 00:07:04,850
"في الخارج، نادِني "كوسين

87
00:07:04,850 --> 00:07:07,070
عُلِم يا مولايّ كوسين

88
00:07:07,410 --> 00:07:08,400
ماذا؟

89
00:07:08,940 --> 00:07:10,900
هل هذه قاعدة غريبة ما؟

90
00:07:11,660 --> 00:07:13,300
...بخصوص ذلك

91
00:07:19,010 --> 00:07:23,340
دُعي السيّد غاوشون كضيف اليوم، صحيح؟

92
00:07:23,700 --> 00:07:24,960
...أجل، لكن

93
00:07:25,320 --> 00:07:29,260
في هذه الحالة، لماذا وُضِع في نفس المبنى؟

94
00:07:29,260 --> 00:07:32,940
يبدو أنّ هناك اختلافاً أكبر قليلاً
...في المرتبة بين هذين الشّخصين

95
00:07:32,940 --> 00:07:37,120
نحن، عشيرة ما، خدمنا عائلة مولايّ
كوسين لأجيال عديدة

96
00:07:37,120 --> 00:07:39,280
من الطبيعيّ أن نُوضَع في نفس البناء

97
00:07:39,710 --> 00:07:40,930
هكذا إذاً

98
00:07:41,400 --> 00:07:44,620
إذاً مولايّ جينشي من عائلة
مرموقة كما توقّعت

99
00:07:46,620 --> 00:07:51,270
...أبي، ما الّذي يجري؟ هل يُعقَل أنّها

100
00:07:58,210 --> 00:08:00,960
شاوماو لا تعرف شيئاً عن الأمر

101
00:08:03,990 --> 00:08:06,820
سيخبرها مولايّ جينشي قريباً

102
00:08:07,220 --> 00:08:09,220
إلى ذلك الحين، تكتّم على الأمر

103
00:08:09,220 --> 00:08:11,420
...لكن رغم ذلك، من بين كلّ الأشياء

104
00:08:13,500 --> 00:08:15,260
ماذا يفعلان؟

105
00:08:16,230 --> 00:08:19,530
على أيّ حال، عليّ تفريغ الأغراض والتّنظيف

106
00:08:19,530 --> 00:08:22,920
يجب أن أؤدّي عملاً ما وإلّا السيّدة
سويرين سوف تغضب منّي لاحقاً

107
00:08:33,330 --> 00:08:36,090
الأجواء حيويّة جدّاً في الخارج
مع كلّ هذه الاحتفالات

108
00:08:36,090 --> 00:08:39,350
لماذا يختبئ في هذه الغرفة المُغلقة؟

109
00:08:40,620 --> 00:08:44,350
المعذرة، هل ينبغي أن نفتح النّوافذ؟

110
00:08:44,350 --> 00:08:48,360
لا، لا تفعلي. فقط تذوّقي الطّعام حاليّاً

111
00:08:49,420 --> 00:08:50,750
ستفهمين عندما تفعلين ذلك

112
00:08:52,170 --> 00:08:54,650
هل هذه... سُلحفاة رخوة الصّدفة؟

113
00:08:54,650 --> 00:08:56,060
على ما يبدو

114
00:09:00,490 --> 00:09:05,190
المشروب المُقبِّل ثقيل أيضاً، رغم أنّهم
يحاولون تخفيفه بعصير الفاكهة

115
00:09:05,880 --> 00:09:08,690
...كلّ شيء، من الأطباق الجانبيّة إلى الحلويّات

116
00:09:09,450 --> 00:09:13,150
كلّها تبدو مُنعشة

117
00:09:13,480 --> 00:09:14,920
هكذا إذاً

118
00:09:17,030 --> 00:09:18,550
طعام محفوظ؟

119
00:09:19,270 --> 00:09:22,350
ألن تأكل هذا؟ إنّه غير مسموم

120
00:09:22,350 --> 00:09:24,790
حتّى لو لم يكن كذلك، إنّه
ليس شيئاً ينبغي أن آكله

121
00:09:25,390 --> 00:09:27,890
،حسناً، سيبدو الأمر مُريباً إذا لم يُؤكَل

122
00:09:27,890 --> 00:09:29,960
لذا هل آكله بدلاً عنك؟

123
00:09:30,690 --> 00:09:31,960
افعلي ما يحلو لكِ

124
00:09:40,180 --> 00:09:41,750
هل هو لذيذ؟

125
00:09:42,170 --> 00:09:43,660
إنّه شهيّ

126
00:09:43,660 --> 00:09:46,380
الأطباق الأُخرى رائعة غالباً أيضاً

127
00:09:46,380 --> 00:09:48,760
هل أنت متأكّد من أنّك لا تريد الأكل؟

128
00:09:49,550 --> 00:09:50,890
هل أنتِ متأكّدة بأنّني أستطيع أكلها؟

129
00:09:51,290 --> 00:09:54,450
حسناً، إنّه طعامك في نهاية المطاف

130
00:09:54,450 --> 00:09:56,340
هل أنتِ متأكّدة فعلاً؟

131
00:09:56,340 --> 00:09:57,490
ما مُشكلته؟

132
00:10:00,360 --> 00:10:03,690
لن أفعل. باسين، يمكنك أكله

133
00:10:03,690 --> 00:10:05,080
هل أنت متأكّد؟

134
00:10:05,080 --> 00:10:06,880
أجل. في الواقع، آمرك بذلك

135
00:10:07,450 --> 00:10:08,330
...في هذه الحالة

136
00:10:16,510 --> 00:10:17,540
إنّه شهيّ

137
00:10:17,540 --> 00:10:19,090
هذا جيّد

138
00:10:19,090 --> 00:10:19,940
...لكن

139
00:10:19,940 --> 00:10:20,590
لكن؟

140
00:10:23,230 --> 00:10:25,780
!كيف لم تتأثّر هذه الفتاة؟

141
00:10:25,780 --> 00:10:29,060
كلّ ما يمكنني قوله هو أنّ
هذه هي طبيعة تنشئتي

142
00:10:29,330 --> 00:10:33,230
...ا-المعذرة. سأذهب إلى غرفتي

143
00:10:33,230 --> 00:10:35,350
ليس من السّهل أن يكون المرء
يافعاً ومُفعماً بالحيويّة

144
00:10:38,140 --> 00:10:39,320
ماذا يجدر بنا أن نفعل؟

145
00:10:39,320 --> 00:10:43,060
لندعه ينام هنا. سأنام في غرفته

146
00:10:43,060 --> 00:10:45,080
سأحمله إلى غرفته

147
00:10:45,080 --> 00:10:46,590
لا بُدّ أنّك مُتعب

148
00:10:47,540 --> 00:10:49,140
...حسنٌ إن كانت هذه رغبتك

149
00:10:50,900 --> 00:10:56,370
سيستخدم الحُرّاس غرفتي، لذا استخدمي
هذه الغرفة رجاء يا شاوماو

150
00:10:56,370 --> 00:10:56,960
حاضرة

151
00:11:00,750 --> 00:11:04,640
!حمّام أيضاً؟ يا للتّرف

152
00:11:07,920 --> 00:11:09,890
يبدأ الصّيد غداً

153
00:11:10,940 --> 00:11:13,500
آمل ألّا تقع حوادث

154
00:11:19,380 --> 00:11:22,530
أهذا هو؟ إنّه صغير جدّاً

155
00:11:22,530 --> 00:11:26,850
إنّه النّموذج الأحدث. لديه
مدى ودقّة مُحسّنين أيضاً

156
00:11:26,850 --> 00:11:29,210
بهذا، يمكننا استخدامهم في الغابة أيضاً

157
00:11:30,280 --> 00:11:33,720
سيكون هذا هو مكان موتهم

158
00:11:43,260 --> 00:11:46,820
ثمّ ساعة لصعود الجبل سيراً على الأقدام

159
00:11:47,220 --> 00:11:48,920
يبدو أنّ جوهر الحدث هو

160
00:11:48,920 --> 00:11:51,630
طبخ الفريسة الّتي يتمّ اصطيادها
بواسطة النُّبلاء بشكل فوريّ

161
00:12:01,590 --> 00:12:05,700
لا شيء أفعله. ربّما سأتمشّى

162
00:12:09,710 --> 00:12:11,820
هذه غابة جميلة جدّاً

163
00:12:11,820 --> 00:12:15,630
...تبدو مكاناً وافراً بالأعشاب والفطور

164
00:12:19,470 --> 00:12:21,760
هل هناك شلّال ضخم قريب؟

165
00:12:22,530 --> 00:12:24,940
!كلب مُطيع

166
00:12:24,940 --> 00:12:26,500
!كلب مُطيع، كلب مُطيع

167
00:12:24,940 --> 00:12:26,970
...ماذا؟ هل هذا

168
00:12:29,510 --> 00:12:30,640
مرحباً

169
00:12:30,640 --> 00:12:32,170
مرحباً؟

170
00:12:33,140 --> 00:12:37,140
الآنسة الصّغيرة! ماذا تفعلين
في هذا المكان؟

171
00:12:37,140 --> 00:12:39,400
طُلِبَ منّي الانضمام

172
00:12:39,400 --> 00:12:40,310
حقّاً؟

173
00:12:41,000 --> 00:12:42,450
حسناً، كذلك أنا

174
00:12:42,450 --> 00:12:47,320
دُعيتُ للانضمام للحُرّاس، لكن جعلوني
أتولّى أمر الكلب بدلاً من ذلك

175
00:12:47,800 --> 00:12:50,580
،دُعي السيّد ليهاكو للانضمام أيضاً

176
00:12:50,580 --> 00:12:52,650
لكنّه من الرّيف

177
00:12:52,650 --> 00:12:56,830
لا بُدّ أنّ الحُرّاس المُعتزّون الآخرون
أجبروه على الخروج

178
00:12:57,300 --> 00:13:00,250
،يبدو أنّه يصعد سُلّم التّرتيب مؤخّراً

179
00:13:00,250 --> 00:13:02,840
لكن يُقابَل ذلك ببعض المُقاومة

180
00:13:03,180 --> 00:13:04,760
أنت سيّئ في التّصفير

181
00:13:04,760 --> 00:13:05,930
اسكتي أنتِ

182
00:13:06,430 --> 00:13:08,700
لا مُشكلة. لديّ هذه

183
00:13:14,530 --> 00:13:16,020
إنّه ذكيّ

184
00:13:16,490 --> 00:13:21,080
،أليس كذلك؟ سمعتُ أنّه في بعض الحالات
يُمكن استدعاؤه من مسافة أميال

185
00:13:24,890 --> 00:13:27,470
...الكلب يُداعب كلباً

186
00:13:35,340 --> 00:13:37,060
،ينبغي أن تكون المُنتجعات الصّيفيّة رائعة

187
00:13:37,060 --> 00:13:39,250
لكن السّماء صافية اليوم، والحرّ شديد

188
00:13:39,810 --> 00:13:42,670
الرّاحة ليست سهلة

189
00:13:45,590 --> 00:13:51,600
،حتّى وسط هذه الحرارة، لن يخلع قِناعه
ولن يأكل الطّعام

190
00:13:53,560 --> 00:13:56,370
،بالرّغم من قِناعه المُريب

191
00:13:56,370 --> 00:14:01,390
نظراً إلى مكان جلوسه، من الواضح
أنّه أهمّ شخص في هذه الحفلة

192
00:14:02,970 --> 00:14:06,590
هذا مولايّ شيشو، والد المَحظيّة روران

193
00:14:06,590 --> 00:14:09,780
إنّه قائد منطقة شيهوكو-شو
ومُنظِّم حدث الصّيد هذا

194
00:14:10,860 --> 00:14:13,290
ماذا؟ هل قال شيئاً له؟

195
00:14:14,670 --> 00:14:20,960
هل كان ينبغي لهذا المخصيّ حسن السّلوك
أن يتصرّف تصرُّفاً مكشوفاً كهذا؟

196
00:14:22,070 --> 00:14:24,960
...لحظة، هل يُعقَل أنّه بسبب الحرارة

197
00:14:26,730 --> 00:14:28,800
أيقول لي ألّا أفعل شيئاً؟

198
00:14:39,330 --> 00:14:40,390
شاوماو

199
00:14:40,390 --> 00:14:41,110
حاضرة

200
00:14:43,440 --> 00:14:45,550
هل يمكنني أخذ هذه؟

201
00:14:45,550 --> 00:14:46,900
أجل، أكيد

202
00:14:57,780 --> 00:14:58,550
—مولايّ جيـ

203
00:14:59,060 --> 00:15:00,000
!مولايّ كوسين

204
00:15:02,760 --> 00:15:03,850
هذه أنتِ

205
00:15:04,250 --> 00:15:06,020
اخلع هذا من فضلك

206
00:15:06,020 --> 00:15:07,070
لا أستطيع

207
00:15:08,390 --> 00:15:10,010
لا يوجد أحدٌ في الأرجاء

208
00:15:10,270 --> 00:15:11,970
قد يأتي شخصٌ ما

209
00:15:12,340 --> 00:15:14,110
!كم هذا مُزعج

210
00:15:14,940 --> 00:15:19,270
،إذا كنتَ مُلحّاً على ألّا يراك أحد
فلننتقل إلى مكانٍ لا ينكشف أمرنا فيه

211
00:15:27,190 --> 00:15:29,950
المعذرة. دعني أمسح وجهك

212
00:15:31,150 --> 00:15:34,140
إنّه ساخن. أنا واثقة بأنّه مُصاب بدُوار

213
00:15:34,140 --> 00:15:36,000
...يجب أن أجعله يشرب الماء الّذي أحضرتُه

214
00:15:36,000 --> 00:15:39,410
أيّتها الصّيدلانيّة، أريد أن أخبرك بشيء

215
00:15:39,710 --> 00:15:40,830
الآن؟

216
00:15:42,020 --> 00:15:44,420
كنتُ سأخبركِ في فترة ما

217
00:15:45,620 --> 00:15:48,670
...أنا... أنا في الواقع

218
00:15:50,130 --> 00:15:51,170
ماذا كان ذلك؟

219
00:15:55,140 --> 00:15:56,600
رائحة كبريت؟

220
00:15:56,970 --> 00:15:57,850
!فيفا؟

221
00:15:59,940 --> 00:16:00,810
!آسف

222
00:16:00,810 --> 00:16:01,890
!قد يخيفكِ هذا قليلاً

223
00:16:06,610 --> 00:16:08,860
!أتعتبر هذا "قليلاً"؟

224
00:16:13,610 --> 00:16:15,470
هل نبحث تحت الشلّال؟

225
00:16:15,470 --> 00:16:18,210
مُحال أن ينجو من هذا الارتفاع

226
00:16:18,210 --> 00:16:20,620
الأهمّ، أخبئوا الفيفا

227
00:16:42,730 --> 00:16:44,910
أنا آسف إن كنتِ لا تُجيدين السّباحة

228
00:16:45,350 --> 00:16:49,400
لا يهمّ إن كنتِ أستطيع السّباحة
...أو لا في ذلك الظّرف

229
00:16:50,380 --> 00:16:55,120
.كان ارتفاع المُنحدر 50 متراً
كان القفز منه ضرباً من الجنون

230
00:16:55,590 --> 00:16:57,740
ظننتُك قد فقدتَ صوابك

231
00:16:58,220 --> 00:17:00,800
حوض الشلّال هذا عميق جدّاً

232
00:17:00,800 --> 00:17:04,290
بالقفز بشكل صحيح، لن تموتي
غالباً، ما لم تغرقي

233
00:17:04,290 --> 00:17:06,790
أكيد، ما لم أغرق

234
00:17:13,880 --> 00:17:15,050
!ماذا تفعلين؟

235
00:17:15,310 --> 00:17:20,390
أعتذر على عدم الاحتشام، لكن
لا أريد أن أُصاب بنزلة برد

236
00:17:23,990 --> 00:17:26,880
سأحافظ على ملابسي الدّاخليّة على ما أعتقد

237
00:17:26,880 --> 00:17:30,550
رغم أنّها مجرّد مجموعة من الأضلاع
النّحيلة، أرغب في إخفاء ما أمكن

238
00:17:32,280 --> 00:17:35,940
سأعصر ملابسك أيضاً إن خلعتها

239
00:17:44,070 --> 00:17:45,370
سأفعلها بنفسي

240
00:17:45,750 --> 00:17:49,180
أعطيني ملابسكِ أيضاً. فأنا أقوى منكِ

241
00:17:49,180 --> 00:17:49,970
حسناً

242
00:17:52,360 --> 00:17:55,910
جيّد، يبدو سليماً أكثر من السّابق

243
00:17:56,470 --> 00:17:58,460
لكن يبدو أنّ مزاجه يسوء

244
00:17:59,820 --> 00:18:01,900
هذه الأعشاب عديمة الجدوى الآن

245
00:18:02,350 --> 00:18:04,040
هل من شيء آخر؟

246
00:18:08,900 --> 00:18:09,940
مولايّ جينشي

247
00:18:11,260 --> 00:18:12,410
ماذا؟

248
00:18:12,410 --> 00:18:16,600
،أعلم بأنّ هذا ليس بالكثير
لكن هل ترغب في أكل هذا؟

249
00:18:17,000 --> 00:18:18,780
هل هذا دواء ما؟

250
00:18:19,190 --> 00:18:21,380
إنّه نبات القبّعة، من فطورنا

251
00:18:21,380 --> 00:18:27,790
أحضرتُه كطعام خفيف، لكن أعتقد
تحتاج ملحاً الآن

252
00:18:27,790 --> 00:18:28,540
ملح؟

253
00:18:29,210 --> 00:18:34,030
عندما كنتُ أطاردك، أحضرتُ بعض الماء
الّذي يحتوي على معجون الصّويا والسكّر

254
00:18:34,030 --> 00:18:36,350
لكن تركتُه أعلى الشلّال

255
00:18:36,800 --> 00:18:40,110
على أيّ حال، بما أنّك خرجتَ
،للصّيد مُرتدياً قِناعك

256
00:18:40,110 --> 00:18:43,880
ورفضتَ الأكل أو الشّرب، فلا بُدّ
أنّك في حالة يُرثى لها

257
00:18:43,880 --> 00:18:47,780
ألستَ مُصاباً بصُداع نتيجة
الحرّ وقلّة الارتواء؟

258
00:18:57,710 --> 00:19:02,370
،يبدو أنّ الحُمّى لديك قد انخفضت
لكن تناول بعض الملح رجاء، من باب الحيطة

259
00:19:03,110 --> 00:19:04,970
...كما تشائين

260
00:19:07,780 --> 00:19:09,630
إنّه ليس سيّئاً بالشّكل الّذي توقّعتُه

261
00:19:14,670 --> 00:19:15,860
كُلي بعضاً أيضاً

262
00:19:18,610 --> 00:19:19,880
شكراً لك

263
00:19:24,970 --> 00:19:27,400
ماذا كان الّذي حدث هناك على أيّ حال؟

264
00:19:28,330 --> 00:19:29,640
فيفا

265
00:19:29,640 --> 00:19:30,560
فيفا؟

266
00:19:31,110 --> 00:19:34,080
إنّه سلاح حربيّ يستخدم البارود

267
00:19:34,510 --> 00:19:37,200
يتطلّب تحضيراً قبل الإطلاق

268
00:19:37,200 --> 00:19:39,990
لكنّه يُطلق مرّتين مُتتاليتين بصورة سريعة

269
00:19:41,780 --> 00:19:44,700
إذاً هل هذا يعني أنّه كان هناك
العديد من المُعتدين؟

270
00:19:44,700 --> 00:19:49,450
أجل، اثنان على الأقلّ. وربّما أكثر

271
00:19:50,770 --> 00:19:53,960
من يضمر ضغينة تجاهه؟ ولماذا؟

272
00:20:02,390 --> 00:20:06,430
مولايّ جينشي، هل تعرف كيفيّة
الخروج من هذا المكان؟

273
00:20:06,430 --> 00:20:09,140
غير السّباحة بالطّبع

274
00:20:09,140 --> 00:20:10,810
هناك حفرة في عمق السّقف

275
00:20:11,340 --> 00:20:14,210
هل يعلم السيّد غاوشون بذلك؟

276
00:20:14,210 --> 00:20:19,780
،لعلّه لا يعلم. كان باسين ليعلم
...لكن لا أدري إن كان سيُلاحظ فوراً

277
00:20:28,830 --> 00:20:32,600
هل يمكننا الصُّراخ من هنا طلباً للمُساعدة؟

278
00:20:32,600 --> 00:20:34,920
عليهم أن يكونوا قريبين جدّاً كي يسمعوا

279
00:20:35,410 --> 00:20:39,670
،ربّما إذا ظللنا نصرخ طوال اليوم
...فقد يُلاحظ أحد، لكن

280
00:20:41,590 --> 00:20:42,610
ماذا؟

281
00:20:42,610 --> 00:20:44,010
لا، لا شيء

282
00:20:44,920 --> 00:20:48,430
،إنّه مُرتفع، لكن إذا وقف أحدنا على الآخر
فقد نتمكّن من الوصول

283
00:20:49,690 --> 00:20:53,270
إذا عَلِمت السيّدة سويرين بأنّني
...دستُ على مولايّ جينشي

284
00:20:56,050 --> 00:20:58,300
سأسحقكِ إذا وقفتُ عليكِ

285
00:20:58,300 --> 00:20:59,270
...لكن

286
00:20:59,530 --> 00:21:00,250
افعليها

287
00:21:05,030 --> 00:21:07,390
ينبغي أن تسمني قليلاً

288
00:21:07,390 --> 00:21:09,240
الوقت غير مُناسب لذلك

289
00:21:12,260 --> 00:21:15,940
إنّه مُبتلّ وزَلِق، لكن ما دمتُ
...أستطيع التشبُّث بأصابعي

290
00:21:15,940 --> 00:21:16,880
سأقف

291
00:21:16,880 --> 00:21:17,710
!حسناً

292
00:21:30,420 --> 00:21:31,900
ضفدع

293
00:21:34,770 --> 00:21:35,820
!مهلاً

294
00:21:43,410 --> 00:21:46,320
هذا... غير مُؤلم

295
00:21:58,870 --> 00:22:00,920
—المعذرة، مولايّ جينشي

296
00:23:45,020 --> 00:23:59,950
الحلقة القادمة

297
00:23:56,530 --> 00:23:59,450
"الحلقة القادمة: "كا زويغيتسو