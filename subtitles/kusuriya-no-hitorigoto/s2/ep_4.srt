1
00:01:30,980 --> 00:01:33,980
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

2
00:01:47,640 --> 00:01:49,540
!انظري يا ماوماو

3
00:01:49,540 --> 00:01:51,840
هذا مُبهر

4
00:01:51,840 --> 00:01:53,480
أليس كذلك؟

5
00:01:53,480 --> 00:01:56,670
فهمت، لهذا تكبّدنَ عناء استدعائي

6
00:01:56,670 --> 00:01:58,940
إنّها مرآة رائعة، أليس كذلك؟

7
00:01:58,940 --> 00:02:01,100
هل يمكنكِ أن تعرفي ممّا صُنِعت؟

8
00:02:02,230 --> 00:02:05,270
هذا الانعكاس... هل هو زُجاج؟

9
00:02:06,290 --> 00:02:07,180
صحيح

10
00:02:07,520 --> 00:02:10,060
بالفعل، كأنّه يوجد اثنتان من مولاتي غيوكويو

11
00:02:10,700 --> 00:02:13,500
إنّ صنع مرايا من الزُجاج صعب

12
00:02:13,500 --> 00:02:15,800
الطّريقة الوحيدة للحصول عليها
هو من خلال التّجارة مع الغرب

13
00:02:15,800 --> 00:02:17,570
ما يعني بأنّها باهظة الثّمن

14
00:02:18,250 --> 00:02:22,070
إذا كسرتُ هذه بالخطأ، فقد تُقطَع رؤوس

15
00:02:22,070 --> 00:02:26,510
،كان لدينا مرآة زجاجيّة يدويّة من قبل
لكن كسرَتْها إنفا

16
00:02:26,510 --> 00:02:28,950
!من فضلكِ لا تذكّريني بذلك

17
00:02:28,950 --> 00:02:31,670
...يسرّني أنّ السيّدة غيوكويو كريمة

18
00:02:35,390 --> 00:02:37,320
هل تجذب اهتمامكِ يا ماوماو؟

19
00:02:37,320 --> 00:02:40,470
أجل. أتساءل كيف صُنِعت بهذا الشّكل؟

20
00:02:44,940 --> 00:02:46,410
أجل، صحيح

21
00:02:47,160 --> 00:02:51,480
هذه المرآة هي هديّة من مبعوث أجنبيّ خاصّ

22
00:02:51,480 --> 00:02:52,980
مبعوث خاصّ؟

23
00:02:53,400 --> 00:02:55,930
ذكرَ الطبيبُ الدجّال شيئاً من هذا القبيل

24
00:02:56,430 --> 00:03:01,990
القافِلة الضّخمة كانت مجموعة استطلاعيّة
للمبعوث الخاصّ أو ما شابه

25
00:03:01,990 --> 00:03:05,390
لكن أعتقد بأنّهم قدّموا مرآة لجميع
المَحظيات ذوات التّصنيف الرّفيع

26
00:03:05,390 --> 00:03:07,580
لا تصيغي الأمر بهذه الطّريقة

27
00:03:08,440 --> 00:03:11,420
،هناك أربع مَحظيّات رفيعات التّصنيف
بمن فيهن المَحظيّة غيوكويو

28
00:03:11,420 --> 00:03:14,750
من الطّبيعيّ أن يُعاملهن مبعوثٌ
خاصّ بشكل مُتكافئ

29
00:03:15,590 --> 00:03:19,020
لا بدّ أنّ نقل أربع مرايا ضخمة
،كهذه عمليّة صعبة

30
00:03:19,020 --> 00:03:22,760
سواء كان ذلك عبر الصّحراء أو البحر

31
00:03:23,610 --> 00:03:26,140
،أن يتكبّدوا كلّ هذا العناء لأجل المَحظيّات

32
00:03:26,140 --> 00:03:30,270
فهذا يعني أنّهم يحاولون عقد
صفقة عمل ضخمة مع دولتنا

33
00:03:31,350 --> 00:03:33,900
شاوماو، هل لي بلحظة؟

34
00:03:34,270 --> 00:03:36,860
سيّد غاوشون. ما الأمر؟

35
00:03:37,530 --> 00:03:41,340
أودُّ أخذ رأيكِ حول أمر ما

36
00:03:41,340 --> 00:03:43,610
مولاتي هونيان، هلّا استعرتُ هذه الغرفة؟

37
00:03:43,930 --> 00:03:47,790
أجل، لا مانع، لكن هل هو
موضوع شائك؟

38
00:03:51,940 --> 00:03:55,840
انضمّت لنا السيّدة هونيان قائلةً
،بأنّني لا ينبغي أن أكون بمفردي معه

39
00:03:55,840 --> 00:04:00,210
لكن فقدتْ كلَّ الاهتمام حالما عَلِمَتْ
بأنّ غاوشون لديه زوجة وطفل

40
00:04:01,570 --> 00:04:05,680
حسناً، لا أعلم ما إن كان بمقدوري تقديم
مساعدة، لكن أرني ما لديك؟

41
00:04:06,370 --> 00:04:09,400
في الواقع، أحد معارفي قلق جدّاً

42
00:04:10,190 --> 00:04:12,180
...إنّه وضع غريب جدّاً، لكن

43
00:04:13,400 --> 00:04:16,480
ثمّة عائلة ثريّة لديها ابنتان

44
00:04:16,780 --> 00:04:19,160
إنّهما مُتقاربتان في السنّ ومُتشابهتان

45
00:04:19,160 --> 00:04:23,070
،الفتاتان محبوبتان جدّاً بواسطة والديهما
لكن عندما بلغتا سنَّ الرّشد

46
00:04:23,070 --> 00:04:24,990
أصبح والداهما يُبالغان كثيراً
في الاعتناء بهما

47
00:04:25,740 --> 00:04:30,360
حيث لا يُسمَح لهما بمُغادرة
المنزل، ولو كانتا معاً

48
00:04:30,360 --> 00:04:32,450
،تمّ تعيين وصيفة لمُراقبتهما

49
00:04:32,450 --> 00:04:35,000
وهما تقضيان أيّامهما في منزلهما

50
00:04:36,030 --> 00:04:39,500
أشفقت عليهما الوصيفة فصارت
،تصطحبهما للخارج بين الحين والآخر

51
00:04:40,020 --> 00:04:42,010
لكن اكتشفَ الأبُ الأمر

52
00:04:42,640 --> 00:04:45,010
فعيّنَ خدماً ذكوراً خارج الغرفة
من أجل مُراقبتهما

53
00:04:46,180 --> 00:04:49,990
وأقفلَ الأبواب ليلاً وذلك
كي لا تتمكّنا من الخروج

54
00:04:51,150 --> 00:04:56,100
كانت الابنتان انطوائيّتين، لذا أخذتا
تقضيان كلّ يومهما في التّطريز

55
00:04:56,550 --> 00:04:57,680
...لكن ذات يوم

56
00:04:58,220 --> 00:04:59,940
...أبي، أختي الصّغيرة

57
00:05:00,570 --> 00:05:02,730
!إنّها حامل بطفل من ساحر

58
00:05:06,760 --> 00:05:08,060
...هذه

59
00:05:08,060 --> 00:05:10,220
قصّة غريبة

60
00:05:10,220 --> 00:05:13,080
ألم تأخذهما الوصيفة للخارج
خلسة مرّة أخرى؟

61
00:05:13,400 --> 00:05:17,850
لا، كانت الوصيفة قد طُرِدَتْ
بالفعل كتحذير للأُخريات

62
00:05:18,670 --> 00:05:21,880
الوصيفة الجديدة لم تتفاعل
كثيراً مع الابنتين

63
00:05:22,200 --> 00:05:28,470
حسناً... في هذه الحالة، رغم أنّ هذا قد يكون
غير لائق، لكن ماذا عن الخدَم الذّكور؟

64
00:05:28,740 --> 00:05:30,910
سيكون ذلك صعباً كذلك

65
00:05:30,910 --> 00:05:35,020
،لم يكُن يُسمَح لهم بالاقتراب من الغرفة
حتّى أثناء مُراقبتهم لهما

66
00:05:35,500 --> 00:05:40,150
هذه مُعضلة حقيقيّة، لكن يبدو
الأمر خارج نِطاق معرفتي

67
00:05:40,920 --> 00:05:45,340
على سبيل المثال، إذا كان السّؤال، "هل
"من المُمكن الحمل دون رؤية رجل؟

68
00:05:45,340 --> 00:05:46,920
فقد أستطيع تفسير ذلك

69
00:05:46,920 --> 00:05:48,780
هل هذا مُمكن الحدوث أصلاً؟

70
00:05:49,280 --> 00:05:51,640
يستطيع الجسدُ أن يخدع نفسه
بالاعتقاد بأنّه حامل

71
00:05:51,640 --> 00:05:54,410
دون أن يحدث الحمل في الواقع

72
00:05:55,480 --> 00:05:58,160
شهدتُ حالةً في بيت البغاء حيث زعمتْ

73
00:05:58,160 --> 00:06:01,420
مَحظيّة صغيرة بأنّها حامل
بطفل من الرّجل الّذي تُحبّه

74
00:06:01,420 --> 00:06:04,210
دون أن تحمل فعليّاً؟

75
00:06:04,210 --> 00:06:09,330
تماماً. بدأت تفوتها الدّورة الشّهريّة
وأصبح صدرها ومعدتها أكثر طراوة

76
00:06:09,330 --> 00:06:12,390
إنّ الاعتقاد شبه اليقينيّ يمكن
أن يؤثِّر بشكل فعّال على الجسد

77
00:06:13,830 --> 00:06:16,640
هل أنت متأكّد بأنّ الابنة كانت حاملاً؟

78
00:06:17,000 --> 00:06:19,100
...في الحقيقة، أجل

79
00:06:19,410 --> 00:06:21,610
لنفترض أنّها كذلك

80
00:06:22,940 --> 00:06:28,260
المُشكلة هي كيف تمكّنتْ من التسلّل
والخروج دون كشف أمرها؟

81
00:06:28,260 --> 00:06:32,520
حسناً، هل تعلم كيف كان يتمّ مُراقبتهما؟

82
00:06:32,520 --> 00:06:35,240
أجل. إليكِ مُخطَّط

83
00:06:37,540 --> 00:06:40,640
تُقيم الأختان في بناء مُنفصل
،كائن في الطّرف الشّماليّ

84
00:06:40,640 --> 00:06:44,380
مُتّصل بالمنزل الرّئيسيّ بواسطة
ممرّ من جهة الغرب

85
00:06:44,380 --> 00:06:45,950
أين تقع دورة المياه؟

86
00:06:45,950 --> 00:06:47,580
داخل البناء المُنفصل

87
00:06:48,120 --> 00:06:50,940
...إذا أرادت الابنة الصّغرى الهرب

88
00:06:50,940 --> 00:06:53,950
الطّريقة الوحيدة للدّخول أو الخروج
هي الممرّ في الجهة الغربيّة

89
00:06:53,950 --> 00:06:58,640
،هناك نوافذ في الجهتين الشّرقيّة والجنوبيّة
لكن الخدَم الذّكور كانوا يُراقبون هاتين الجهتين

90
00:06:59,710 --> 00:07:02,600
من أين كان يُراقب الخدمُ النّوافذ؟

91
00:07:03,120 --> 00:07:05,860
كانت النّافذة الجنوبيّة تُراقَب
،من الطّابق الثّالث للمنزل الرّئيسيّ

92
00:07:06,440 --> 00:07:09,860
في حين أنّ النّافذة الشّرقيّة كانت
تُراقب من الطّابق الأوّل

93
00:07:10,260 --> 00:07:14,210
يبدو أنّ الرّؤية لديهم كانت محدودة

94
00:07:14,210 --> 00:07:16,480
هل كانوا يستطيعون رؤية ما بداخل الغرفة؟

95
00:07:16,480 --> 00:07:22,370
ليس تماماً، لكن كانت الابنتين تقضيان
مُعظم وقتهما في التّطريز عند النّافذة

96
00:07:22,370 --> 00:07:25,340
هواية غريبة. التّطريز

97
00:07:25,740 --> 00:07:28,090
تربّيتا على ثقافة ريفيّة

98
00:07:28,940 --> 00:07:33,620
يبدو وكأنّه يُخفي شيئاً هامّاً

99
00:07:35,000 --> 00:07:38,990
يبدو أنّ النّافذتين في الجنوب والغرب
تقعان في نفس الغرفة

100
00:07:38,990 --> 00:07:42,100
وللابنتين غرفة نوم مُنفصِلة لكلّ منهما

101
00:07:42,620 --> 00:07:45,600
هل كان هذا البناء المُنفصِل للضّيوف أساساً؟

102
00:07:45,600 --> 00:07:47,420
أنا مُندهش من مُلاحظتكِ ذلك

103
00:07:47,420 --> 00:07:49,420
كم رجلاً كان يُراقب؟

104
00:07:54,690 --> 00:07:57,070
يعرف التّفاصيلَ جيّداً

105
00:07:57,070 --> 00:08:01,230
...مع ذلك، أشعر وكأنّه لا يخبرني بكلّ شيء

106
00:08:01,230 --> 00:08:04,420
هل يتكلّم عن أحد "معارفه" فعلاً؟

107
00:08:04,940 --> 00:08:08,250
...لا أعلم ما إن كنتُ أريد ذكر هذا

108
00:08:10,010 --> 00:08:11,530
بالمناسبة يا شاوماو

109
00:08:12,080 --> 00:08:14,030
أرسلَ مولايّ جينشي رسالة

110
00:08:14,030 --> 00:08:17,010
أراد الاعتذار على التأخُّر في تسليم
بازهر الثّور

111
00:08:18,510 --> 00:08:19,460
!البازهر

112
00:08:19,460 --> 00:08:21,180
هذا صحيح، لم يُسلّمه بعد

113
00:08:21,780 --> 00:08:25,690
لم أُرِد ضربة رأس أخرى، لذا ظللتُ
صامتة، لكنّه تأخّر فعلاً

114
00:08:26,030 --> 00:08:29,900
أنا آسف. يبدو أنّه وردَ طلبٌ عليه فجأة

115
00:08:30,440 --> 00:08:32,040
ولماذا فجأة؟

116
00:08:34,490 --> 00:08:36,800
سمعتُ مؤخّراً أنّ مولايّ جينشي

117
00:08:36,800 --> 00:08:40,080
قد مُنِح العديد من الأدوية النّادرة
من أشخاص مُختلفين

118
00:08:40,420 --> 00:08:43,580
تُفيد الإشاعة بأنّه يبحث عنها بشغف

119
00:08:43,580 --> 00:08:47,480
حـ-حسناً، على أيّ حال، خذي هذه رجاء

120
00:08:59,650 --> 00:09:01,390
ما هذه؟

121
00:09:01,790 --> 00:09:03,150
إنّها مرارة دُبّ

122
00:09:03,150 --> 00:09:04,820
إنّها مرارة دُبّ مُجفَّفة

123
00:09:04,820 --> 00:09:07,300
طعمها مُرّ، لكنّها مُكوّن ثمين

124
00:09:07,300 --> 00:09:08,920
!في الأدوية للجهاز الهضميّ

125
00:09:08,920 --> 00:09:11,310
يسرّني أنّها حازت على إعجابكِ

126
00:09:11,310 --> 00:09:14,440
أعتقد بأنّ مولايّ جينشي أراد
تسليمها لكِ شخصيّاً

127
00:09:17,100 --> 00:09:20,240
حسناً، هل لاحظتِ شيئاً؟

128
00:09:21,490 --> 00:09:24,980
أجل. هل يمكنك الانتظار قليلاً؟

129
00:09:32,270 --> 00:09:34,630
لنفترض هاتين الجوزتين هما الابنتان

130
00:09:38,510 --> 00:09:39,640
أجل

131
00:09:44,700 --> 00:09:45,640
...ماذا لو

132
00:09:45,640 --> 00:09:48,730
وضعتُ مرآةً هنا، هكذا

133
00:09:50,600 --> 00:09:53,370
يبدو وكأنّ هناك جوزة أخرى

134
00:09:53,370 --> 00:09:58,740
ماذا لو وُضِعت مرآة كبيرة هنا
بالقرب من النّافذة الشّرقيّة؟

135
00:09:59,230 --> 00:10:01,570
ستكون على مسافة بعيدة عن المُراقب

136
00:10:01,570 --> 00:10:04,040
،لذا سيكون من الصّعب التّمييز
حتّى لو بدت غير طبيعيّة قليلاً

137
00:10:04,490 --> 00:10:07,050
إذاً تقصدين بأنّه كانت هناك ابنة
،واحدة فقط في الغرفة

138
00:10:07,050 --> 00:10:10,210
والأخرى كانت انعكاساً في المرآة؟

139
00:10:11,880 --> 00:10:13,520
،إذا كانت الابنتان مُتشابهتين

140
00:10:13,520 --> 00:10:16,510
فقد يكون من الصّعب على المُراقبين
التّفريق بينهما

141
00:10:16,850 --> 00:10:19,720
لكن يا ماوماو، ماذا عن أعمال التّطريز؟

142
00:10:19,720 --> 00:10:23,050
كانتا تعملان على شيئين
مختلفين، أليس كذلك؟

143
00:10:23,050 --> 00:10:28,220
أجل، سمعتُ بأنّهما كانتا تُطرّزان
حيوانات، كطيور أو أرانب

144
00:10:28,220 --> 00:10:29,650
...على سبيل المثال

145
00:10:30,080 --> 00:10:32,220
لنأخذ صورة كهذه

146
00:10:34,860 --> 00:10:39,740
عندما أقلب هذه الصّورة، ألا تبدو
الابتسامة عُبوساً الآن؟

147
00:10:41,110 --> 00:10:44,030
تقصدين إذاً أنّ التّطريز كان
جزءاً من الخدعة أيضاً؟

148
00:10:45,010 --> 00:10:47,500
لعلّهما كانتا تعملان على تطريز

149
00:10:47,900 --> 00:10:52,040
يبدو بصورة مُختلفة عند
النّظر إليه من خلال مرآة

150
00:10:52,330 --> 00:10:55,550
إن كان كذلك، تستطيع إحداهما مُمارسة
،التّطريز عند النّافذة الجنوبيّة

151
00:10:55,550 --> 00:11:00,050
بينما تهرب الأُخرى عبر المخرج في الغرب

152
00:11:00,420 --> 00:11:01,550
هكذا إذاً

153
00:11:01,550 --> 00:11:06,170
أعتقد باستخدام هذه الطّريقة، سيكون
من المُمكن الخروج خِلسة واللّقاء بشخص

154
00:11:06,810 --> 00:11:11,860
كانت المرآة الكبيرة الّتي أحضرها المبعوث
الأجنبيّ جميلة جدّاً

155
00:11:11,860 --> 00:11:14,960
من بعيد، سيكون من الصّعب التّمييز
بين الانعكاس والحقيقة

156
00:11:15,480 --> 00:11:19,070
منذ زمن بعيد، عندما سافر أبي
،للدّراسة في الغرب

157
00:11:19,070 --> 00:11:22,800
أخبرني بأنّ أعمال التّطريز كانت
شائعة بين الفتيات رفيعات التّصنيف

158
00:11:23,490 --> 00:11:28,700
قال السيّد غاوشون بأنّ فتاة من عائلة ثريّة
،خرجتْ خِلسة من المنزل لتصبح حبلى

159
00:11:29,210 --> 00:11:32,080
لكن لا أعرف مدى دقّة تلك الرّواية

160
00:11:32,540 --> 00:11:36,710
لعلّها كانت تحمل سرّاً أكبر
بدلاً من طفل

161
00:11:37,750 --> 00:11:39,570
أعتقد بأنّ المرء أحياناً بحاجة

162
00:11:39,570 --> 00:11:42,220
لأن يقبل شخصاً مُشتبَه بأنّه
جاسوس على أنّه ضيف

163
00:11:42,810 --> 00:11:46,770
لكن لن أشكِّك في ذلك وأتوغّل
في القضيّة أكثر

164
00:11:46,770 --> 00:11:48,500
...الأهمّ الآن

165
00:11:51,160 --> 00:11:54,550
!ماذا يجدر بي أن أفعل بمرارة الدُبّ هذه؟

166
00:11:58,940 --> 00:12:02,780
حسناء من عالم آخر تذرف
لآلئ بدلاً من دموع؟

167
00:12:03,090 --> 00:12:06,950
أجل، أتى مسؤول رفيع المستوى مُكلَّف
بحفلة التّرحيب مُستنجداً

168
00:12:07,330 --> 00:12:10,700
مولايّ جينشي، لستَ مُضطرّاً
...لقبول مزيد من الأعمال

169
00:12:11,100 --> 00:12:12,700
أعلم

170
00:12:15,020 --> 00:12:19,950
.المسألة لا تقتصر على المرايا
ما الّذي يفكّر فيه المبعوثون؟

171
00:12:21,890 --> 00:12:24,570
أيّتها الصّيدلانيّة. هل سمعتِ يوماً رواية

172
00:12:24,570 --> 00:12:27,140
عن حسناء من عالم آخر تذرف
لآلئ بدلاً من دموع؟

173
00:12:29,220 --> 00:12:30,940
ماذا؟ ما الأمر؟

174
00:12:30,940 --> 00:12:32,640
،اسمح لي أن أقول

175
00:12:32,640 --> 00:12:35,350
هناك حسناء من عالم آخر"
"...تجلس أمامي مباشرة

176
00:12:37,020 --> 00:12:39,480
ماذا تقصد بـ"لآلئ بدلاً من دموع"؟

177
00:12:40,120 --> 00:12:42,070
...لا أعرف التّفاصيل، لكن

178
00:12:43,270 --> 00:12:45,670
كانت امرأة حسناء، كجنّية قمر

179
00:12:46,040 --> 00:12:49,620
عندما ترقص، فإنّ الأضواء ترقص
معها كما لو أنّها تُباركها

180
00:12:49,980 --> 00:12:53,290
وعندما تبكي، تتحوّل الدّموعُ
إلى لآلئ بينما تنهمر

181
00:12:54,290 --> 00:12:57,630
...أعتقد كانت مَحظيّة من حيّ الملذّات، لكن

182
00:12:57,630 --> 00:13:01,060
جنّية قمر؟ من أين جاء هذا اللّقب فجأة؟

183
00:13:01,060 --> 00:13:03,720
إنّه طلبٌ جادّ من المبعوث الخاصّ
الّذي لدينا الآن

184
00:13:04,280 --> 00:13:06,640
المبعوث الخاصّ؟ القادم من الغرب؟

185
00:13:07,040 --> 00:13:10,740
،أجل. عندما كان المبعوث صغيراً
كان جدُّ المبعوث يروي

186
00:13:10,740 --> 00:13:13,740
قصّة جنّية القمر، مراراً وتكراراً

187
00:13:14,640 --> 00:13:18,650
لذا يطلب منّي الآن أن أجدها
وذلك كي يتمكّن من لقائها

188
00:13:18,970 --> 00:13:22,440
جدّه؟ هذا يعني بأنّها قصّة قديمة جدّاً

189
00:13:22,800 --> 00:13:27,240
أجل. القضيّة مُعقّدة، لكنّه
شريك دبلوماسيّ مُهمّ

190
00:13:27,240 --> 00:13:28,910
أرغب في تلبيته بأقصى ما عندي

191
00:13:29,590 --> 00:13:32,040
هل يُذكّركِ هذا بشيء، ولو كإشاعة؟

192
00:13:33,480 --> 00:13:35,000
...قبل خمسين عاماً

193
00:13:35,660 --> 00:13:38,790
...راقصة من حيّ الملذّات... جنّية القمر

194
00:13:40,170 --> 00:13:44,800
،من الواضح أنّ هذا حدثَ قبل عقود
...لذا لا أحد يعلم إن كانت لا تزال حيّة

195
00:13:44,800 --> 00:13:46,170
إنّها حيّة تُرزَق

196
00:13:46,650 --> 00:13:47,640
!حقّاً؟

197
00:13:48,210 --> 00:13:53,060
حقّاً، ففي الواقع، التقيتَ بها
من قبل في حيّ الملذّات

198
00:13:53,400 --> 00:13:54,680
أنا؟

199
00:13:54,680 --> 00:13:55,230
أجل

200
00:13:55,570 --> 00:13:58,900
لا أتذكّر بأنّني التقيتُ بشخص
...يُطابِق الوصف

201
00:13:58,900 --> 00:14:02,020
ليس من المُفاجئ ألّا تتذكّرها فوراً

202
00:14:02,900 --> 00:14:04,010
أيُعقَل ذلك؟

203
00:14:04,010 --> 00:14:09,360
أجل، فهي السيّدة العجوز
مالكة بيت الزّنجار

204
00:14:11,320 --> 00:14:13,450
حدّثينا عنها

205
00:14:15,640 --> 00:14:20,340
ستأتي في أيّ وقت ما دمت
تدفع لها. ما رأيك؟

206
00:14:20,340 --> 00:14:22,380
...فـ-في الواقع، هذا

207
00:14:23,040 --> 00:14:27,920
لكن مضى على ذلك خمسون عاماً

208
00:14:27,920 --> 00:14:30,090
ألا يمكنك البحث عن حسناء أخرى فحسب؟

209
00:14:30,090 --> 00:14:35,020
في الحقيقة، أقمنا حفلة ترحيب
مع نساء حسناوات

210
00:14:35,800 --> 00:14:37,760
،ربّما لم يكُنّ جنّيات قمر

211
00:14:37,760 --> 00:14:40,350
لكن ما زلتُ أرى بأنّنا استقطبنا
بعضاً من حسناوات النّخب الأوّل

212
00:14:44,810 --> 00:14:49,700
،ولم يبدُ المبعوث مُقتنعاً. بل في الحقيقة
استخفَّ بالأمر

213
00:14:50,060 --> 00:14:52,100
من هو هذا المبعوث؟

214
00:14:52,100 --> 00:14:55,860
أنا آسفة، لكن هل قدّمتْ إحدى حسناوات
—النّخب الأوّل أولئك خدمة ليليّة

215
00:14:55,860 --> 00:14:57,250
!ماوماو

216
00:14:57,250 --> 00:14:59,660
لا، لم يكن ذلك مُمكناً

217
00:15:00,270 --> 00:15:02,170
المبعوث هو امرأة

218
00:15:02,540 --> 00:15:06,670
لهذا إذاً لجأتْ لمولايّ جينشي طلباً للمُساعدة

219
00:15:07,230 --> 00:15:11,340
،يتمتّع بجمال يُعجِب أيّ شخص
وهو ذكرٌ في الأصل

220
00:15:11,850 --> 00:15:15,550
لديه المُقوّمات الّتي تجعل امرأةً تُغرَم به

221
00:15:16,210 --> 00:15:18,880
لكن قد يُسبّب مُشكلة أيضاً

222
00:15:19,310 --> 00:15:22,440
ماذا لو تمكّن من إغوائها
وطلبتْ منه النّوم معها؟

223
00:15:22,440 --> 00:15:23,900
هناك قطعة مفقودة

224
00:15:24,360 --> 00:15:28,500
بالطّبع، باعتبار أنّ المبعوث هو
،امرأة وهي بهذا المنصب

225
00:15:28,500 --> 00:15:31,310
فلا يمكن أن تقوم بعمل طائش كهذا

226
00:15:31,310 --> 00:15:33,410
ستُفضّل عدم المُجازفة بذلك

227
00:15:34,420 --> 00:15:38,330
ما مدى أهمّية هذه المبعوثة؟

228
00:15:38,650 --> 00:15:42,790
لنقل أنّها تتحكّم كلّياً بالنّقاط
التّجاربّة الغربيّة والشّماليّة

229
00:15:43,120 --> 00:15:45,700
كانت القافلة السّابقة ضخمة

230
00:15:45,700 --> 00:15:48,920
لأنّ كلا البلدين يريدان الحديث
مُقدّماً عن صفقات تجاريّة جديدة

231
00:15:49,470 --> 00:15:50,970
هكذا إذاً

232
00:15:50,970 --> 00:15:54,140
سمعتُ أنّه في البلاد البعيدة، يتمّ تنسيق
،الزّواج عبر خطوط دوليّة

233
00:15:54,140 --> 00:15:57,220
ممّا يجعل الرّجال الوسيمين والنّساء
الحسناوات أمراً مألوفاً جدّاً

234
00:15:58,100 --> 00:16:01,730
أن يُلقّب شخصٌ من بلد كهذه
...أحداً بجنّية قمر

235
00:16:02,640 --> 00:16:05,570
هل وُضِعت مواد مُهلوِسة
في البخُّور أو ما شابه؟

236
00:16:05,570 --> 00:16:07,520
وهل يفعل النّاس ذلك؟

237
00:16:07,520 --> 00:16:09,820
ليس عادة، لكن ستكون هذه الطّريقة الأسرع

238
00:16:10,290 --> 00:16:12,950
كان ذلك ليُسبّب كارثة دبلوماسيّة

239
00:16:13,850 --> 00:16:17,950
.وصلتُ إلى طريق مسدود هنا
آمل أن أتذكّر شيئاً

240
00:16:18,360 --> 00:16:20,850
إنّه مضطرب تماماً

241
00:16:20,850 --> 00:16:23,460
حسناً، لنحاول فتح هذا الطّريق المسدود

242
00:16:25,460 --> 00:16:27,420
شكراً على قطع كلّ المسافة إلى هنا

243
00:16:30,360 --> 00:16:32,920
لا أعرف ماذا أفعل هنا

244
00:16:33,820 --> 00:16:37,820
يا له من مكان مُملّ. ولا حتّى كوب شاي؟

245
00:16:38,290 --> 00:16:40,930
هذه مجرّد غرفة زيارة

246
00:16:41,640 --> 00:16:46,150
أيّتها السيّدة العجوز، هل رحّبتِ
بمبعوث أجنبيّ في الماضي؟

247
00:16:46,150 --> 00:16:50,510
أجل، فعلت. لا بدّ أنّ ذلك كان
قبل أكثر من 50 عاماً

248
00:16:50,510 --> 00:16:53,030
كان ذلك في عصر الإمبراطور قبل السّابق

249
00:16:53,780 --> 00:16:56,980
كانت المدينة في الأصل بلدة
،مبنيّة على أطلال قديمة

250
00:16:56,980 --> 00:16:59,710
وكان يزورنا عدد كبير من السّائحين

251
00:17:00,290 --> 00:17:04,610
عندما قرّروا فجأة جعل هذه
،البقعة الشّهيرة عاصمة

252
00:17:04,610 --> 00:17:07,120
حدثتْ بعض الفوضى

253
00:17:07,630 --> 00:17:10,440
على أيّ حال، كانت العاصمة لا تزال
حديثة، لذا لم يكن لدينا قلعة ضخمة

254
00:17:10,440 --> 00:17:13,050
أو مكان للتّرحيب بالضّيوف

255
00:17:13,050 --> 00:17:18,890
نفدت أفكار المسؤولين الكِبار، لذا
استخدموا إحدى الأطلال المُتبقّية

256
00:17:20,730 --> 00:17:24,560
كان عبارة عن بركة جميلة ومبانٍ
بالقرب من بستان

257
00:17:24,980 --> 00:17:26,310
...هل هذا

258
00:17:26,990 --> 00:17:29,540
كان هناك بستاناً مهجوراً في الطّرف
الشّماليّ من القصر الخلفيّ

259
00:17:29,540 --> 00:17:31,480
زرتُه قبل أيّام

260
00:17:36,760 --> 00:17:42,660
تمّ اختياري كراقصة رئيسيّة في الاستعراض
باستخدام تلك الأطلال كمسرح

261
00:17:43,120 --> 00:17:44,580
ولماذا أنتِ؟

262
00:17:44,580 --> 00:17:46,380
لأنّني كنتُ المَحظيّة الأعلى مرتبة

263
00:17:46,380 --> 00:17:48,960
في حيّ الملذّات برمّته آنذاك

264
00:17:48,960 --> 00:17:51,670
كنتُ الرّاقصة الرّئيسيّة وحوالي
عشر راقصات أُخريات رقصنَ معي

265
00:17:52,380 --> 00:17:56,200
...تبدو كغصن شجرة ميّتة الآن، لكن

266
00:17:56,200 --> 00:17:59,640
من ناحية، أعتقد أنّ السّبب
الأهمّ كان قوام جسدي

267
00:18:01,260 --> 00:18:05,180
كنتُ طويلة وبمُنحنيات جسد جميلة

268
00:18:05,690 --> 00:18:10,640
من المنطقيّ تعيين شخص بجسد
أضخم كراقصة رئيسيّة

269
00:18:10,640 --> 00:18:11,680
...لكن

270
00:18:12,020 --> 00:18:15,990
كان مُعظم الحدث مُرتجَلاً، لذا
واجهنا صعوبة في التّحضير

271
00:18:16,650 --> 00:18:19,160
،ترتّب علينا تخطيط كلّ شيء
،كأطوار القمر

272
00:18:19,160 --> 00:18:23,490
وإزالة العقبات منحَ الضّيوف إطلالة أفضل

273
00:18:24,270 --> 00:18:27,220
كان يعني وجود البستان في الجوار
،الكثير من الحشرات

274
00:18:27,220 --> 00:18:31,000
لذا دخلناه وأزلنا كلّ يرقة
من بين أوراق الشّجر

275
00:18:31,730 --> 00:18:36,080
لكن انتهى المطاف باقتراب
الحشرات من شعلات النّار

276
00:18:36,780 --> 00:18:42,350
حتّى بعد كلّ ذلك الجهد، بعض الأغبياء
قد عبثوا بملابسي في تلك اللّيلة

277
00:18:42,940 --> 00:18:45,720
حكّوا بها بقايا حشرات ميّتة

278
00:18:46,440 --> 00:18:49,230
لكن كنتُ أقوى منهم

279
00:18:49,230 --> 00:18:52,130
استخدمتُ لِباسي بمهارة لإخفاء ذلك

280
00:18:52,130 --> 00:18:57,020
انطلى ذلك على الجمهور
وبدا الأغبياء غاضبين للغاية

281
00:18:57,020 --> 00:19:00,490
.سمعتُ تلك الرّواية كثيراً
هل لديكِ شيء آخر؟

282
00:19:00,780 --> 00:19:02,810
!أظهري بعض الاحترام

283
00:19:10,130 --> 00:19:13,570
.يا لها من لوحة جميلة
لم أرَها من قبل

284
00:19:13,570 --> 00:19:16,050
لا بدّ أنّها ثمينة بالنّسبة
للمرأة العجوز كذلك

285
00:19:17,310 --> 00:19:22,590
من يتوقّع أن تصبح هذه الحسناء
...الفاتنة بخيلة هكذا

286
00:19:24,660 --> 00:19:30,410
طُلِبت هذه اللّوحة بواسطة المبعوث
بعد عودته إلى الدّيار

287
00:19:30,410 --> 00:19:32,560
قائلاً بأنّه رأى "إلَهة قمر" أو ما شابه

288
00:19:32,850 --> 00:19:36,360
فهمت. تمّ تجميل هذه اللّوحة كذلك

289
00:19:36,360 --> 00:19:38,020
ماذا قلتِ؟

290
00:19:38,020 --> 00:19:39,270
لا شيء

291
00:19:40,250 --> 00:19:43,630
فيما بعد، لم تطأ قدمُ المبعوث
،أرضنا من جديد

292
00:19:44,580 --> 00:19:47,590
لكن أرسلَ لي هذه من خلال القافلة

293
00:19:48,680 --> 00:19:52,560
لكن يا عجوز، كنتِ تؤدّين عملكِ
فحسب كالعادة، صحيح؟

294
00:19:52,560 --> 00:19:54,330
لماذا أحبّكِ حبّاً جمّاً؟

295
00:19:54,330 --> 00:19:57,060
وما أدراني؟

296
00:20:00,170 --> 00:20:03,090
ترى العجوز الأمور من منظور موضوعيّ

297
00:20:03,970 --> 00:20:05,600
إنّها لا تُبالغ غالباً

298
00:20:06,090 --> 00:20:07,180
...لكن

299
00:20:07,180 --> 00:20:10,520
،حتّى لو كانت العجوز حسناء آنذاك

300
00:20:11,500 --> 00:20:14,950
ما الّذي دفعَ بالمبعوثة بتلقيبها بالإلَهة؟

301
00:20:17,320 --> 00:20:19,970
لا أعلم

302
00:20:19,970 --> 00:20:23,830
هل ينبغي أن نبحث عن شخص يُشبه
الشّخص الّذي في اللّوحة؟

303
00:20:23,830 --> 00:20:26,240
هذا كلّ ما يمكنني التّفكير فيه

304
00:20:26,660 --> 00:20:31,800
بصراحة، سيكون من الصّعب إيجاد امرأة
طويلة تُطابِق هذه الأوصاف

305
00:20:32,200 --> 00:20:36,580
لِمَ لا نبحث عن امرأة طويلة فحسب
دون الحاجة لأن تكون شبيهة بهذه؟

306
00:20:37,140 --> 00:20:42,760
انكمشت كثيراً الآن، لكن قالت بأنّ
طولها كان 175 سنتيمتراً آنذاك

307
00:20:42,760 --> 00:20:44,510
إنّها طويلة جدّاً

308
00:20:44,930 --> 00:20:50,470
أجل. كانت راقصة ماهرة، وساقاها
الطّويلتان جعلتا رقصها يبدو أجمل حتّى

309
00:20:50,730 --> 00:20:56,180
لكن سيكون من الصّعب إيجاد
امرأة طويلة بمثل جمالها

310
00:20:56,180 --> 00:20:59,250
المبعوثتان بنفس ذلك الطّول تقريباً

311
00:20:59,250 --> 00:21:02,570
،إذا عثرنا على شخص قصير
فقد يبدو كطفل

312
00:21:03,700 --> 00:21:07,660
المبعوثتان"؟ هناك أكثر من مبعوث؟"

313
00:21:08,150 --> 00:21:11,370
أجل. ابنتا عمّ من نفس الجدّ

314
00:21:12,380 --> 00:21:16,870
حسب وصفهما، لا بدّ أنّ المبعوثتين
تتمتّعان بجمال أخّاذ كذلك

315
00:21:17,270 --> 00:21:21,290
لذا يترتّب علينا إيجاد شخص
،أطول من 175 سنتيمتراً

316
00:21:21,290 --> 00:21:25,400
...يُبهِر حُسنُه حسناءً أُخرى

317
00:21:28,380 --> 00:21:31,760
وجدتُ شخصاً. إنّه مُرشَّح مُلائم جدّاً

318
00:21:31,760 --> 00:21:35,480
شخص جميل وأطول من 175 سنتيمتراً، صحيح؟

319
00:21:40,290 --> 00:21:40,820
ماذا؟

320
00:21:42,060 --> 00:21:43,780
ما الّذي ترمين إليه؟

321
00:23:44,980 --> 00:23:59,910
الحلقة القادمة

322
00:23:56,580 --> 00:23:58,950
"الحلقة القادمة: "جنّية القمر