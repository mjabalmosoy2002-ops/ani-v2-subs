1
00:01:30,980 --> 00:01:33,980
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

2
00:01:36,260 --> 00:01:38,660
يبدو كحشرات تُغنّي

3
00:01:39,380 --> 00:01:43,760
.ماوماو، عليكِ أن تضعي قناعَ ثعلب أيضاً
استخدمتِ القناع الّذي طليتِه

4
00:01:43,760 --> 00:01:44,620
حسناً

5
00:01:49,070 --> 00:01:54,580
.في العادة يطلي النّاسُ زوايا العين بالأحمر
الأخضر يبدو خياراً غريباً

6
00:01:55,670 --> 00:01:57,380
تُشبهين التّانوكيّ بعض الشّيء

7
00:01:57,380 --> 00:02:00,890
ماذا؟ وأنتِ تبدين كقطّة يا ماوماو

8
00:02:03,210 --> 00:02:04,650
شعري يضايقني

9
00:02:06,600 --> 00:02:10,020
دعيني أربطه لكِ ثانية. اجلسي

10
00:02:15,110 --> 00:02:17,390
أشعر أنّ شيئاً ما مفقود

11
00:02:17,390 --> 00:02:19,660
مُجرّد شريطة لا تكفي، صحيح؟

12
00:02:19,660 --> 00:02:21,220
لا أُمانع

13
00:02:21,220 --> 00:02:23,370
يمكنك استعارة إحدى عيدان الشّعر خاصّتي

14
00:02:23,370 --> 00:02:26,570
إنّها بهيئة شبكة عنكبوت! ظريفة جدّاً

15
00:02:27,700 --> 00:02:31,420
لدي عود شعر في الواقع. استخدمي هذا

16
00:02:32,300 --> 00:02:35,710
مُذهل يا ماوماو. إنّه جميل حقّاً

17
00:02:35,710 --> 00:02:37,530
كان هديّة

18
00:02:38,070 --> 00:02:38,860
،المعذرة

19
00:02:40,250 --> 00:02:42,550
إن طلبتُه، فهل ستعطيني إيّاه؟

20
00:02:47,560 --> 00:02:48,400
لا

21
00:02:48,860 --> 00:02:49,890
بئساً

22
00:02:50,530 --> 00:02:52,590
،لا أستطيع ذِكر ذلك فحسب

23
00:02:52,590 --> 00:02:56,650
لكن مولايّ جينشي ماهر بشكل مُخيف
في قراءة تعابير الوجه

24
00:02:57,530 --> 00:03:03,620
رغم ذلك، لا أعلم حتّى ما إن كنتُ
أستطيع العودة إلى العاصمة

25
00:03:06,220 --> 00:03:07,800
حسناً، انتهيت

26
00:03:07,800 --> 00:03:08,810
شكراً لكِ

27
00:03:09,400 --> 00:03:12,460
يُقام المهرجان في مزار خارج القرية

28
00:03:13,000 --> 00:03:14,440
هيّا بنا

29
00:03:31,110 --> 00:03:35,800
ربّما بسبب ضوء الشّعلة، يبدون
كمجموعة من الثّعالب

30
00:03:40,290 --> 00:03:42,440
يبدو وكأنّنا في عالم مُختلف، صحيح؟

31
00:03:42,440 --> 00:03:43,200
أجل

32
00:03:43,590 --> 00:03:45,040
مُخيف، أليس كذلك؟

33
00:03:45,040 --> 00:03:46,100
أجل

34
00:03:46,850 --> 00:03:49,890
رغم أنّ تانوكيّاً أخضر يُرافقني

35
00:03:50,890 --> 00:03:55,970
هناك آخرون مثل شيسوي يستخدمون
الأخضر حول العينين

36
00:03:55,970 --> 00:03:59,210
غالباً من الرّجال. أتساءل ما إن
كان هناك معنى وراء ذلك؟

37
00:04:02,980 --> 00:04:05,210
الكثير من الجنادب في هذا
العام على ما يبدو

38
00:04:05,210 --> 00:04:09,180
سمعتُ أنّ لهذا السّبب علينا أن نحتفل
بصخب في مهرجان هذا العام

39
00:04:09,180 --> 00:04:10,640
هكذا إذاً

40
00:04:10,640 --> 00:04:13,230
لطرد الأرواح الشرّيرة على ما أعتقد

41
00:04:17,170 --> 00:04:19,790
توت نبات الفانوس ليس لذيذاً

42
00:04:19,790 --> 00:04:21,240
صحيح

43
00:04:21,240 --> 00:04:23,950
—إنّه سامّ. في حيّ الملذّات، المَحظيّات

44
00:04:23,950 --> 00:04:25,370
أعلم

45
00:04:27,650 --> 00:04:28,580
مُقرف

46
00:04:28,960 --> 00:04:30,220
!آسفة

47
00:04:33,590 --> 00:04:35,980
المزار في أعلى هذا الدّرج

48
00:04:36,540 --> 00:04:42,840
أتعلمين لماذا الإله المعبود هنا هو ثعلب
ويُعَدّ إله الحصاد الوفير؟

49
00:04:43,190 --> 00:04:44,470
لا

50
00:04:44,770 --> 00:04:49,000
كانت هذه المنطقة مأهولة بواسطة
مجموعة مُعيّنة من النّاس

51
00:04:51,030 --> 00:04:54,480
ثمّ أتتْ مجموعة أُخرى من دولة
مُختلفة، من الغرب

52
00:04:55,660 --> 00:04:59,420
،مُعظم القرى طردوا هؤلاء الوافدين الجدُد

53
00:04:59,420 --> 00:05:02,740
لكن قَبِلَهم عددٌ صغير

54
00:05:03,370 --> 00:05:06,700
كان أهل الغرب يتمتّعون بمعرفة قيّمة

55
00:05:07,150 --> 00:05:09,500
كيفيّة إثراء الحقول

56
00:05:09,500 --> 00:05:11,520
كيفيّة التخلّص من الآفات

57
00:05:12,060 --> 00:05:15,370
أعتقد أنّ بعض القرويّين أدركوا قيمة ذلك

58
00:05:16,500 --> 00:05:21,530
آنذاك، اجتاحَ آخرون مُحاولين سرقة
الأراضي الزّراعيّة الغنيّة

59
00:05:22,860 --> 00:05:28,260
مع تكرار العمليّة، بدؤوا بنقل قُراهم
إلى أماكن أعمق في الغابة

60
00:05:29,730 --> 00:05:32,250
بهدوء، كما لو أنّهم يتسلّلون بعيداً

61
00:05:39,190 --> 00:05:41,610
ماذا عن إله الثّعلب هذا؟

62
00:05:41,970 --> 00:05:45,310
،يُمثّل الثّعلبُ أهل الغرب الّذين جلبوا المعرفة

63
00:05:45,310 --> 00:05:47,200
وأجداد هذه القرية

64
00:05:47,940 --> 00:05:50,780
سمعتُ بأنّ الثّعالب هنا بيضاء

65
00:05:50,780 --> 00:05:52,660
كانت الأقنعة بيضاء في البداية، صحيح؟

66
00:05:53,400 --> 00:05:55,050
ألوان الطّلاء في الأقنعة

67
00:05:55,050 --> 00:05:58,460
تُمثّل استقرار الوافدين الجدُد
وتبنّي ألوان المنطقة

68
00:05:59,170 --> 00:06:00,570
هكذا إذاً

69
00:06:01,690 --> 00:06:06,070
هل الثّعلب الأبيض يُمثّل البشرة الشّاحبة؟

70
00:06:06,610 --> 00:06:09,350
...ومن خلال التّزاوج بين الأعراق، يتغيّر اللّون

71
00:06:12,340 --> 00:06:14,950
أين سمعتُ ذلك من قبل

72
00:06:15,270 --> 00:06:20,210
كثير من الرّجال هنا واجهوا صعوبة
في التّمييز بين الألوان

73
00:06:20,210 --> 00:06:21,070
ماذا؟

74
00:06:21,070 --> 00:06:23,260
بينما هذا نادر مع النّساء

75
00:06:24,660 --> 00:06:29,910
إذاً لهذا يطلون حول عيونهم باللّون
الأخضر بدلاً من الأحمر

76
00:06:31,510 --> 00:06:32,670
شيسوي أيضاً

77
00:06:33,790 --> 00:06:36,210
الأمّ الملكيّة، الّتي أتت إلى المدينة

78
00:06:36,210 --> 00:06:41,420
شعب الثّعلب الأبيض، الّذي بنى قرية
خفيّة في أعماق الغابة

79
00:06:42,620 --> 00:06:47,340
لا بُدّ أنّ كليهما ينحدران من نفس مجموعة
...الأشخاص الّذين أتوا من الغرب

80
00:06:54,270 --> 00:06:57,180
ماوماو، يمكنكِ ترك قناعكِ هنا

81
00:06:57,960 --> 00:06:59,810
ماذا يفعلون بهذه الأقنعة؟

82
00:06:59,810 --> 00:07:02,100
يتمّ عبادتها لمدّة عام ثمّ نحرقها

83
00:07:03,650 --> 00:07:05,610
!من هنا، هيّا

84
00:07:14,260 --> 00:07:17,790
!تعالي وكُلوا بعض الطّعام

85
00:07:18,220 --> 00:07:20,000
هناك أكشاك طعام أيضاً

86
00:07:19,400 --> 00:07:21,520
!حسناً، شكراً

87
00:07:20,000 --> 00:07:22,570
أجل. أتريدين أكل شيء؟

88
00:07:22,570 --> 00:07:24,130
إن كنتِ ستشترين، فلا أُمانع

89
00:07:24,490 --> 00:07:26,670
ما رأيكِ بأسياخ لحم إذاً؟

90
00:07:27,900 --> 00:07:30,360
...ضفادع وجراد

91
00:07:30,920 --> 00:07:32,820
أيُّهما تُريدين يا ماوماو؟

92
00:07:32,820 --> 00:07:34,360
!سأطلب جراداً

93
00:07:34,360 --> 00:07:37,060
الجراد في هذه الفترة من العام
!مُمتلئ ولذيذ

94
00:07:38,550 --> 00:07:40,390
سأطلب دجاجاً

95
00:07:40,390 --> 00:07:41,390
ليس ضفدعاً؟

96
00:07:41,910 --> 00:07:44,380
...لا أريد رؤية ضفادع لبعض الوقت

97
00:07:46,310 --> 00:07:47,940
!بسرعة

98
00:07:48,900 --> 00:07:51,420
ألم تأكلي حشرات من قبل؟

99
00:07:51,420 --> 00:07:53,840
لم أرَها تُباع في أكشاك الطّعام
الخاصّة بحي الملذّات

100
00:07:58,570 --> 00:08:00,120
كما قلت، هذا مُقرف

101
00:08:00,590 --> 00:08:04,090
!مُقزّز، كان ذلك جُندُباً

102
00:08:04,090 --> 00:08:05,780
جميعها مُتشابهة بالنّسبة لي

103
00:08:05,780 --> 00:08:07,660
!إنّهما مُختلفان تماماً

104
00:08:08,660 --> 00:08:10,260
هذه لذيذة

105
00:08:11,530 --> 00:08:13,160
...لا أستطيع تمييز الفرق

106
00:08:15,530 --> 00:08:17,690
!انظري، داخل المزار

107
00:08:19,170 --> 00:08:20,140
طفل؟

108
00:08:20,640 --> 00:08:21,960
لا بُدّ أنّه كيو-يو

109
00:08:21,960 --> 00:08:25,240
في كلّ عام، يلعب طفلٌ دور الإله هكذا

110
00:08:25,240 --> 00:08:26,020
هكذا إذاً

111
00:08:26,570 --> 00:08:31,220
على ذكر الأمر، طلى ذلك الطّفل
قناعاً جميلاً جدّاً

112
00:08:32,180 --> 00:08:35,610
لكن أنا مُندهشة من قدرته
على الجلوس بثبات هكذا

113
00:08:35,610 --> 00:08:39,850
يتناوبون طوال اللّيل هكذا. الجميع
يريدون أن يتطوّعوا

114
00:08:40,730 --> 00:08:42,680
هذا مُناسب لصنع ذكريات أيضاً

115
00:08:43,740 --> 00:08:46,250
أعتقد حان الوقت تقريباً لعمليّة التّبادُل

116
00:08:46,250 --> 00:08:48,000
لننتظره في الخارج

117
00:08:50,420 --> 00:08:52,460
!انظري إلى هذا

118
00:08:53,490 --> 00:08:55,400
ما هذا؟

119
00:08:55,400 --> 00:08:56,550
ما المُشكلة؟

120
00:08:57,310 --> 00:09:01,010
سُنبلة القمح هذه فارغة. إنّها الّتي
أعطانا إيّاها كبير القرية

121
00:09:01,010 --> 00:09:04,980
لا ينمو محصول ذلك الحقل جيّداً

122
00:09:04,980 --> 00:09:08,680
وكبير القرية لا يعطينا أرزّاً سوى
!من الحقل. يا للبخل

123
00:09:08,680 --> 00:09:09,480
بئساً

124
00:09:09,480 --> 00:09:11,850
حسناً، حظّاً أوفر في العام المُقبل

125
00:09:12,830 --> 00:09:14,410
هل ستفي هذه بالغرض؟

126
00:09:15,000 --> 00:09:16,740
ماذا؟ هل أنتِ متأكّدة؟

127
00:09:17,830 --> 00:09:19,910
!مرحى, شكراً

128
00:09:21,450 --> 00:09:22,480
!هذا ليس عدلاً

129
00:09:22,480 --> 00:09:24,580
أنتِ لطيفة يا ماوماو

130
00:09:24,580 --> 00:09:27,620
ليس تماماً. لا جدوى من الاحتفاظ بها

131
00:09:28,190 --> 00:09:29,080
!أختي

132
00:09:30,840 --> 00:09:32,140
ما رأيكِ بي؟

133
00:09:32,140 --> 00:09:34,180
!أبليت حسناً

134
00:09:35,910 --> 00:09:38,860
ليت تستطيع أمّي رؤية ذلك

135
00:09:41,680 --> 00:09:44,560
لا يعيش مع أمّه؟

136
00:09:45,180 --> 00:09:49,150
هيّا، لنذهب ونُشاهدهم بينما
يحرقون أقنعة العام الماضي

137
00:10:02,240 --> 00:10:04,990
أخبريني، ماذا تمنّيتِ؟

138
00:10:04,990 --> 00:10:06,320
أُمنيتي؟

139
00:10:06,320 --> 00:10:08,760
،يُقال أنّه عندما تكتبين أمنيتكِ على قِناع

140
00:10:08,760 --> 00:10:12,250
،فإنّ الأُمنية تتحقّق مع احتراق القِناع
وترتقي الأُمنية إلى السّماء

141
00:10:12,250 --> 00:10:13,720
لم تكتبي أُمنية؟

142
00:10:13,720 --> 00:10:14,830
أدركتُ هذا للتو

143
00:10:14,830 --> 00:10:18,510
توقّعتُ ألّا تؤمني بخُرافات كهذه يا ماوماو

144
00:10:18,890 --> 00:10:22,400
!إنّها ليست خُرافة! الأُمنيات تتحقّق فعلاً

145
00:10:22,400 --> 00:10:26,520
لهذا قضيتُ كثيراً من الوقت والجهد
أطلي قِناعي وأكتب أُمنيتي

146
00:10:26,900 --> 00:10:28,140
ماذا كتبت أنت؟

147
00:10:28,550 --> 00:10:30,170
!لن أقول أبداً

148
00:10:30,170 --> 00:10:31,610
أيّاً يكن

149
00:10:31,610 --> 00:10:33,020
!انظري، ها هُم

150
00:10:42,060 --> 00:10:44,940
كيو-يو، ألم تُرِد أن تلعب ذلك الدّور؟

151
00:10:45,930 --> 00:10:49,930
!لستُ طفلاً، لذا سأدع الآخرين يفعلونها

152
00:10:49,930 --> 00:10:51,500
كم أنت ناضج

153
00:10:51,500 --> 00:10:53,090
يُحاول جاهداً

154
00:11:24,980 --> 00:11:27,140
هل كان قناعك هناك يا كيو-يو؟

155
00:11:27,140 --> 00:11:28,540
لا أدري

156
00:11:29,810 --> 00:11:32,020
آمل أن يحترق بشكل مُلائم

157
00:11:47,210 --> 00:11:52,310
الأُمنيات غير المُحقّقة تغرق في الأسفل
لتغذية الحصاد المُقبل

158
00:11:54,450 --> 00:11:59,480
.لا تنجو الحشرات من الشّتاء أبداً
تترك أطفالها قبل رحيلها فحسب

159
00:12:09,530 --> 00:12:11,160
!عُدت

160
00:12:16,570 --> 00:12:19,420
أهلاً بعودتك. هل تريدين عشاء؟

161
00:12:19,420 --> 00:12:20,720
!أجل

162
00:12:26,970 --> 00:12:28,660
كيف كان المهرجان؟

163
00:12:29,060 --> 00:12:33,310
،في الواقع، عندما وصلنا إلى هناك
...كان كيو-يو في الدّاخل، و

164
00:12:33,810 --> 00:12:34,990
ماذا؟

165
00:12:36,250 --> 00:12:39,060
وعدتِني بشيء

166
00:12:39,500 --> 00:12:41,920
جرعة الانبعاث

167
00:12:41,920 --> 00:12:42,820
أجل

168
00:12:43,120 --> 00:12:45,780
هل تعين وضعكِ الآن؟

169
00:12:47,370 --> 00:12:52,670
أنا رهينة من حيث المبدأ، لكن
!لستُ مُقيّدة إطلاقاً

170
00:12:52,670 --> 00:12:56,750
هل يعتقدان بأنّه لا جدوى من مُحاولتي
الهرب؟ أم أنّه يوجد سبب آخر؟

171
00:12:57,510 --> 00:13:00,530
طريقة تصرّفهما تستدعي كثيراً من الأسئلة

172
00:13:00,530 --> 00:13:03,170
...لكن ما يُؤرق أكثر الآن هو

173
00:13:04,330 --> 00:13:05,180
حسناً

174
00:13:05,180 --> 00:13:07,790
!هل هي داتورة شائكة أم سمكة منفوخة؟
!بأي مُعدّل؟

175
00:13:08,460 --> 00:13:09,760
!هل من شيء آخر؟

176
00:13:09,760 --> 00:13:11,770
!ما الكمّية الصّحيحة؟

177
00:13:11,770 --> 00:13:14,750
وأيضاً كيف كانت حالة جسدكِ بعد
!العودة إلى الحياة؟

178
00:13:14,750 --> 00:13:17,650
كم استغرقتِ من وقت حتّى استعدتِ وعيكِ؟
!هل استطعتِ التحرُّك فوراً؟

179
00:13:18,940 --> 00:13:20,940
لا أعتقد بأنّ الدّاتورة الشّائكة مطلوبة

180
00:13:20,940 --> 00:13:21,780
ليست كذلك؟

181
00:13:22,190 --> 00:13:26,990
،كانت مُدرَجة في الوصفة الأجنبيّة
لكنّها لإطالة حالة شبه الموت

182
00:13:26,990 --> 00:13:31,920
،غالباً أضافوها لإغماء النّاس عن الوعي
وذلك ليغدو استعبادهم أسهل

183
00:13:31,920 --> 00:13:34,040
هذا ما استُعمِلت لأجله في الأصل

184
00:13:34,900 --> 00:13:39,790
.كنتُ قادرة على الإفلات بهذه الآثار فقط
لكن إن فشلتِ، ستفقدين ذاكرتكِ

185
00:13:39,790 --> 00:13:43,390
ما زال المجال مُتاحاً لمزيد من التّحسينات
—قبل تجربة هذا على البشر

186
00:13:43,390 --> 00:13:44,710
!استخدميني رجاء

187
00:13:44,710 --> 00:13:46,360
لن أُجرّبها عليكِ

188
00:13:46,360 --> 00:13:48,420
!لِمَ لا؟! أنا جاهزة

189
00:13:48,420 --> 00:13:49,760
...أنتِ رهينة

190
00:13:51,190 --> 00:13:53,100
يسرّني أنّكما مُنسجمتين

191
00:13:53,710 --> 00:13:56,990
كلتاكما لا تملكان كثيراً من الأصدقاء

192
00:13:56,990 --> 00:13:57,860
اصمتي

193
00:13:57,860 --> 00:13:58,790
اخرسي

194
00:14:03,250 --> 00:14:05,450
أنتِ وشيسوي مُقرّبتان

195
00:14:05,450 --> 00:14:06,850
أهذا ما يبدو؟

196
00:14:06,850 --> 00:14:07,530
أجل

197
00:14:08,200 --> 00:14:11,070
...لدي أسئلة كثيرة لشيسوي

198
00:14:11,520 --> 00:14:16,250
لماذا أحضرَتْني إلى هنا؟ ما هو
الهدف النّهائيّ لكلّ هذا؟

199
00:14:17,770 --> 00:14:20,890
و... مَن هما بالضّبط؟

200
00:14:29,220 --> 00:14:32,180
!كلّ هذه عن الأعشاب...؟

201
00:14:32,550 --> 00:14:34,810
أجل. سأغيب لبعض الوقت

202
00:14:34,810 --> 00:14:38,360
يوجد حُرّاس في الخارج. إيّاك
والتّفكير في الهرب

203
00:14:40,990 --> 00:14:43,510
!أشكّ في أنّها ستُحاول

204
00:14:43,510 --> 00:14:47,050
لماذا تُراقبانكِ؟ ماذا فعلتِ؟

205
00:14:50,660 --> 00:14:53,710
ماوماو، فطوركِ يبرد

206
00:14:53,710 --> 00:14:54,810
سأتناوله لاحقاً

207
00:14:56,760 --> 00:14:59,210
!هيّا، يجب أن تأكلي

208
00:14:59,560 --> 00:15:02,830
هيّا، بدّلي ملابسكِ. سأساعدكِ

209
00:15:02,830 --> 00:15:07,200
!يا للكسل! كم هي مُتعجرفة

210
00:15:07,200 --> 00:15:08,420
إنّها مثل السيّدة شينمي

211
00:15:09,230 --> 00:15:10,400
شينمي؟

212
00:15:12,590 --> 00:15:13,890
!حسناً، انتهيت

213
00:15:14,500 --> 00:15:17,740
كيو-يو، نظّف الصُّحون

214
00:15:17,740 --> 00:15:19,390
!ماذا؟

215
00:15:21,590 --> 00:15:24,060
أليس هو من عائلة ثريّة؟

216
00:15:24,710 --> 00:15:29,600
الجميع مصيرهم الموت. لا أحد
يدري ما إن كان سيبقى هكذا

217
00:15:29,600 --> 00:15:31,190
معكِ حقّ

218
00:15:32,200 --> 00:15:35,010
ماوماو، أين عود الشّعر ذاك من الأمس؟

219
00:15:35,010 --> 00:15:36,670
عند سريري

220
00:15:36,670 --> 00:15:39,680
تُعاملينه بعدم مُبالاة

221
00:15:41,070 --> 00:15:46,320
هذا عود شعر جميل حقّاً. يجب أن
تتوخّي الحذر، وإلّا سُرِق منكِ

222
00:15:46,320 --> 00:15:48,130
هل تعتقدين بأنّه سيُباع بسعر جيّد؟

223
00:15:48,130 --> 00:15:49,910
...رُبّما، لكن

224
00:15:49,910 --> 00:15:53,870
الأشكال المُعقّدة وكلّ شيء تجعله
غاية في الجمال

225
00:15:53,870 --> 00:15:57,920
أعتقد بأنّ الشّخص ذا العين الثّاقبة يستطيع
مُلاحظته ومعرفة الشّخص الّذي طلبَه

226
00:15:58,380 --> 00:16:00,300
لا أستطيع بيعه إذاً

227
00:16:01,080 --> 00:16:05,000
،نظراً إلى طبيعة ذلك الشّخص العنيدة
قد يتمّ استرداده فوراً

228
00:16:05,650 --> 00:16:08,620
سيترتّب عليكِ سحقها حتّى
تصبح مُجرّد معدن

229
00:16:08,620 --> 00:16:10,710
يبدو هذا إسرافاً

230
00:16:12,340 --> 00:16:14,670
يحتاج المزيد

231
00:16:18,870 --> 00:16:20,410
حسناً، هذا جيّد

232
00:16:21,420 --> 00:16:23,180
أنتِ ماهرة في هذا

233
00:16:23,180 --> 00:16:26,240
أجل. سأُضرَب إذا كنتُ بطيئة جدّاً

234
00:16:26,860 --> 00:16:27,790
تُضرَبين؟

235
00:16:28,190 --> 00:16:32,220
،يجب عليّ تقديم خدمة تدليك جيّدة أيضاً
وإلّا سيُرمَى ماء ساخن عليّ

236
00:16:32,220 --> 00:16:34,250
لهذا تعلّمتُ بسرعة

237
00:16:34,250 --> 00:16:37,610
هذا مُخيف. كان لديك مُعلّمة صارمة

238
00:16:38,310 --> 00:16:42,140
ليست مُعلّمة. كانت أُمّي

239
00:16:44,940 --> 00:16:49,480
،لا أريدكِ أن تقعي في مُشكلة يا ماوماو
لذا ابقي مكانكِ، حسناً؟

240
00:16:50,430 --> 00:16:52,400
يجب عليّ المُغادرة لبعض الوقت اليوم أيضاً

241
00:17:16,760 --> 00:17:18,930
!هل مضى حوالي ستّ ساعات الآن؟

242
00:17:23,470 --> 00:17:27,270
مُبهر. يمكنني رؤية آفاق بعيدة خارج القرية

243
00:17:30,280 --> 00:17:33,780
الأرزّ غير محصود في ذلك القسم فقط

244
00:17:34,260 --> 00:17:36,520
في الواقع، ما زال أخضر؟

245
00:17:36,940 --> 00:17:39,410
هل ذلك الّذي بجانبه هو مخزن للأرزّ؟

246
00:17:40,030 --> 00:17:41,280
...على ذكر الأمر

247
00:17:41,280 --> 00:17:45,210
لا ينمو محصول ذلك الحقل جيّداً

248
00:17:45,640 --> 00:17:49,580
أذلك هو الحقل الّذي كان يتكلّم عنه؟

249
00:17:49,580 --> 00:17:51,710
يا له من شكل مُربَّع مثاليّ أيضاً

250
00:17:52,200 --> 00:17:53,160
...هل يُعقَل

251
00:17:53,160 --> 00:17:54,300
!أختي

252
00:17:56,930 --> 00:17:58,820
ماذا تفعلين؟

253
00:18:00,100 --> 00:18:03,290
افتح الباب برفق أكبر

254
00:18:00,520 --> 00:18:02,680
!مؤلم

255
00:18:04,560 --> 00:18:06,280
على أيّ حال، أين أختي الكبرى؟

256
00:18:06,280 --> 00:18:06,980
لا أعلم

257
00:18:08,040 --> 00:18:10,980
أخبرني، هل تعرف ما هو ذلك البناء؟

258
00:18:10,980 --> 00:18:14,930
ماذا؟ إنّه المخزن القديم لكبير القرية

259
00:18:14,930 --> 00:18:19,460
شيّدوا مخزناً قديماً بأرضيّة مُرتفعة
،لإبقاء الجرذان بعيدة

260
00:18:19,460 --> 00:18:20,950
لذا لا أعتقد بأنّهم ما زالوا يستخدمونه

261
00:18:21,770 --> 00:18:22,680
هكذا إذاً

262
00:18:23,720 --> 00:18:25,590
هل من المُمكن الذّهاب إلى هناك؟

263
00:18:26,050 --> 00:18:28,410
لكنّهما تُراقبانكِ، صحيح؟

264
00:18:29,050 --> 00:18:31,160
...أقصد، هذا مُمكن، لكن

265
00:18:31,160 --> 00:18:32,880
حقّاً؟! كيف؟

266
00:18:33,590 --> 00:18:36,880
حسناً. سأدلّكِ

267
00:18:36,880 --> 00:18:40,890
معبري السرّي الّذي أستخدمه
!للهرب من الدّراسة

268
00:18:41,390 --> 00:18:43,080
إنّه وغد حقّاً

269
00:18:56,790 --> 00:18:58,110
ماذا تفعلين؟

270
00:18:58,110 --> 00:19:00,860
أريد تفقُّد شيء

271
00:19:01,210 --> 00:19:03,740
ألا يحصل هذا القسم على غذاء كافٍ؟

272
00:19:03,740 --> 00:19:04,780
لا أظنّ ذلك

273
00:19:04,780 --> 00:19:06,240
ما أدراكِ؟

274
00:19:07,240 --> 00:19:12,080
عرض هذه النّافذة وقسم الأرزّ غير
النّاضج هذا مُتطابقان تقريباً

275
00:19:12,740 --> 00:19:17,840
،يتسلّط الضّوء على هذا القسم طوال اللّيل
والّذي يأتي من تلك النّافذة

276
00:19:18,200 --> 00:19:21,090
هل يمنع الضّوء النموّ؟

277
00:19:21,090 --> 00:19:24,690
في العادة، يُقال بأنّ النّباتات تنمو
بشكل أفضل تحت أشعّة الشّمس

278
00:19:24,690 --> 00:19:27,160
لكن عندما تتعرّض النّباتات لضوء
،ساطع بشكل مُستمرّ

279
00:19:27,160 --> 00:19:29,220
فإنّ ذلك يُفسد نموّها أحياناً

280
00:19:29,220 --> 00:19:30,690
هكذا إذاً

281
00:19:31,020 --> 00:19:32,980
،مثلما فعلتُ عندما عبثتُ بالبيئة

282
00:19:32,980 --> 00:19:36,480
استطعتُ جعل الزُّهور تتفتّح في غير موسمها

283
00:19:37,910 --> 00:19:40,170
قلت بأنّه يوجد جرذان هنا، صحيح؟

284
00:19:40,170 --> 00:19:43,890
أجل. سمعتُ أنّه حتّى نصب كثير
من الفِخاخ لم يفلح

285
00:19:43,890 --> 00:19:46,780
أي مخزون لا ينضب من الجرذان

286
00:19:46,780 --> 00:19:52,710
قالت سويري بأنّ العقّار بحاجة لتحسينات
قبل أن يتمّ اختباره على البشر

287
00:19:53,630 --> 00:19:58,220
لذا أعتقد بأنّها جرّبَتْه على حيوانات
صغيرة من السّهل اصطيادها

288
00:20:03,160 --> 00:20:04,670
يا له من طفل مُشاكس

289
00:20:06,610 --> 00:20:08,780
ماذا يوجد في الدّاخل برأيكِ؟

290
00:20:08,780 --> 00:20:11,640
حسناً، لدي بضع تخمينات

291
00:20:21,190 --> 00:20:23,070
جرذان

292
00:20:23,420 --> 00:20:26,280
لا بُدّ أنّ هذا هو المكان الّذي
أجرتْ فيه تجاربها كما توقّعت

293
00:20:26,280 --> 00:20:29,680
!كم أتمنّى أن آخذ كلّ هذه معي

294
00:20:29,680 --> 00:20:32,100
!لا، الوقت غير مُناسب لذلك الآن

295
00:20:32,100 --> 00:20:33,410
ما هذا؟

296
00:20:35,170 --> 00:20:38,410
أنابيب معدنيّة؟ هناك الكثير منها أيضاً

297
00:20:42,010 --> 00:20:43,380
ماذا يفعل هذا هنا؟

298
00:20:46,590 --> 00:20:48,510
لم أتوقّع هذا إطلاقاً

299
00:20:49,170 --> 00:20:51,390
...بئساً. هذا أشبه

300
00:20:53,080 --> 00:20:55,300
بورشة فيفا مُكتملة

301
00:20:57,830 --> 00:21:02,720
نفس السّلاح الّذي استخدمه المُغتالون
...على مولايّ جينشي

302
00:21:10,160 --> 00:21:14,160
ماذا؟ لماذا لم يكُن الباب مُقفَلاً يا ترى؟

303
00:21:14,710 --> 00:21:17,070
هل نسي أحدٌ قفله؟

304
00:21:17,070 --> 00:21:18,850
لا، هذا مستحيل

305
00:21:18,850 --> 00:21:22,880
ومع ذلك لم يكُن مُقفَلاً. من كان
المسؤول عن إقفاله؟

306
00:21:23,270 --> 00:21:26,010
...يا للهول! إنّها السيّدة شينمي

307
00:21:26,510 --> 00:21:28,470
كم هذا غريب

308
00:21:29,700 --> 00:21:32,280
هل من مُشكلة؟

309
00:21:32,280 --> 00:21:34,860
إنّها تلك المبعوثة الخاصّة

310
00:21:34,860 --> 00:21:38,350
أبداً يا مولاتي آيلا. لا شيء

311
00:21:38,760 --> 00:21:40,490
كنتُ أتوهّم فحسب

312
00:21:54,040 --> 00:21:59,370
رغم أنّه دخلَ جرذان قذِران على ما يبدو

313
00:22:00,660 --> 00:22:04,990
...سـ-سيّدة شينمي

314
00:22:06,770 --> 00:22:08,010
...إذاً هذه

315
00:22:09,720 --> 00:22:10,930
هي شينمي

316
00:23:45,060 --> 00:24:00,000
الحلقة القادمة

317
00:23:57,290 --> 00:23:59,550
"الحلقة القادمة: "الحصن