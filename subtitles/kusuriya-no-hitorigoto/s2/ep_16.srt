1
00:01:31,360 --> 00:01:34,360
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

2
00:01:31,930 --> 00:01:32,780
ها هو

3
00:01:34,910 --> 00:01:37,610
ألا ترتدين دبّوس شعر؟

4
00:01:38,010 --> 00:01:39,990
ضعي هذا إذاً

5
00:01:40,410 --> 00:01:43,470
يبقى الوعد وعداً على ما أعتقد

6
00:01:46,130 --> 00:01:47,960
انظر يا لومين

7
00:01:48,350 --> 00:01:52,800
إنّها ذكيّة جدّاً، لن تأكل رأس
أو ذيل أو أحشاء السّمكة

8
00:01:53,150 --> 00:01:56,510
شخصيّاً، أُحبّ المذاق المُرّ

9
00:01:56,860 --> 00:01:59,800
،علّمني ألّا أهدر الطّعام

10
00:01:59,800 --> 00:02:02,470
لكن من كان يتوقّع أن يُنظّف
...بقايا من قطّة

11
00:02:03,470 --> 00:02:05,690
تعلّم عشرة أشياء من نصيحة واحدة

12
00:02:05,690 --> 00:02:08,730
أبي هو أفضل طبيب في هذا
البلد على ما أعتقد

13
00:02:09,020 --> 00:02:11,820
لكن رغم ذلك، يعيش في فقر
في حيّ الملذّات

14
00:02:11,820 --> 00:02:14,730
لماذا؟ لأنّه ليس طمّاعاً

15
00:02:15,250 --> 00:02:18,270
ماذا تصنعين أيّتها الآنسة الصّغيرة؟

16
00:02:18,270 --> 00:02:20,990
حبَق الرّاعي من أجل كَي جلد
مولاتي غيوكويو

17
00:02:20,990 --> 00:02:25,710
ماوماو، اطلبي إذن غوين قبل
استخدام أي شيء

18
00:02:25,710 --> 00:02:26,910
حاضرة

19
00:02:29,070 --> 00:02:30,920
هل ستكتب طوال هذا اليوم يا أبي؟

20
00:02:31,240 --> 00:02:34,590
أجل. لا يبدو أنّ أحداً بحاجة لخدماتي اليوم

21
00:02:35,070 --> 00:02:39,090
،تمّ تعيين أبي في مكتب الطّبيب
وليس في مقصورة اليشم مباشرة

22
00:02:39,690 --> 00:02:42,090
كانت غالباً خطّة مولايّ جينشي

23
00:02:42,560 --> 00:02:47,600
على الأقلّ شخص واحد آخر يحمل
طفل الإمبراطور في القصر الخلفيّ

24
00:02:48,250 --> 00:02:49,640
مولاتي ريفا

25
00:02:50,450 --> 00:02:52,880
آمل أن ينمو طفلها التّالي بصحّة سليمة

26
00:02:53,720 --> 00:02:56,690
لأجل ذلك، يجب عليها أوّلاً
أن تنجب طفلها بسلامة

27
00:02:57,310 --> 00:03:00,500
،إذا استطاع أبي العناية بهما
فسأكون مُطمئنّة

28
00:03:01,240 --> 00:03:05,830
هل سمعت كيف ضمّت المقصورة البلُّوريّة
دُفعة من الوصيفات الجديدات؟

29
00:03:06,130 --> 00:03:09,420
وذلك بعد أن غادرتْ رئيسةُ
الوصيفات السّابقة؟

30
00:03:09,420 --> 00:03:10,430
...أجل

31
00:03:10,430 --> 00:03:15,040
،سمعتُ أنّ كثيراً منهن أكبر سنّاً
لذا فالأجواء هناك أصبحت أهدأ بكثير

32
00:03:15,040 --> 00:03:18,800
من الجيّد ضمّ العديد من الوصيفات الخبيرات

33
00:03:19,190 --> 00:03:21,890
الكثير من العاملين في القصر
الخلفيّ صغار في السنّ

34
00:03:21,890 --> 00:03:24,180
النّساء الكبيرات في السنّ نادرات جدّاً

35
00:03:24,780 --> 00:03:26,880
القصر الخلفيّ هو لإنجاب وتربية

36
00:03:26,880 --> 00:03:28,010
أطفال الإمبراطور

37
00:03:28,470 --> 00:03:30,600
إنّه لا يعمل كما ينبغي الآن

38
00:03:31,130 --> 00:03:35,670
،نظراً لعدد أطفال الإمبراطور الآن
يجب العمل على تحسين آليّة العمل

39
00:03:35,670 --> 00:03:39,490
أنا متأكّدة بأنّ أبي يعي
...هذه المُشكلة الآن، لكن

40
00:03:39,490 --> 00:03:41,980
ينبغي أن يفي هذا بالغرض

41
00:03:41,980 --> 00:03:43,200
ما هذا يا أبي؟

42
00:03:43,710 --> 00:03:47,930
دوّنتُ الأشياء الّتي وجدتُها تتعلّق
بالقصر الخلفيّ الآن

43
00:03:47,930 --> 00:03:48,950
...لنرَ

44
00:03:49,710 --> 00:03:51,910
رائع يا لومين، خطُّ يدك جميل جدّاً

45
00:03:52,600 --> 00:03:53,620
أهذا ما تلاحظه؟

46
00:03:53,970 --> 00:03:56,620
لكن أسلوب الكتابة طفوليّ

47
00:03:56,620 --> 00:03:59,020
ربّما يجب أن تبدو حازماً أكثر؟

48
00:03:59,020 --> 00:04:00,540
لا مُشكلة

49
00:04:00,540 --> 00:04:04,760
الكثير من الأشخاص هنا ما زالوا لا يُجيدون
سوى قراءة أحرف وعبارات بسيطة

50
00:04:05,430 --> 00:04:09,220
فهمت. يريد أن تقرأ الخادمات والعمّال هذا

51
00:04:09,610 --> 00:04:12,460
ما رأيكِ؟ هل أغفلتُ شيئاً؟

52
00:04:12,460 --> 00:04:14,020
...أعتقد غطّيتَ مُعظم الجوانب، لكن

53
00:04:14,760 --> 00:04:19,480
غوين، هل ما زالت عائلتك
بيع ورقاً بهذا المقاس؟

54
00:04:19,980 --> 00:04:24,410
يمكن إذابة قصاصة كهذه لصنع
المزيد من الورق الجديد

55
00:04:25,010 --> 00:04:29,060
في هذه الحالة، هل يمكن الحصول
على المزيد بسعر مُنخفض؟

56
00:04:29,060 --> 00:04:30,910
أجل، ربّما

57
00:04:31,540 --> 00:04:34,840
ماوماو، يُشيّدون مدرسة هنا مؤخّراً، صحيح؟

58
00:04:34,840 --> 00:04:35,420
أجل

59
00:04:35,740 --> 00:04:38,890
في هذه الحالة، هل يمكنكِ الذّهاب والسّؤال
فيما إذا كانوا يستطيعون استخدام هذا

60
00:04:38,890 --> 00:04:40,900
كمثال للتّمرين على الكتابة؟

61
00:04:45,720 --> 00:04:47,480
سأذهب وأسأل اليوم

62
00:04:47,480 --> 00:04:49,430
شكراً لكِ

63
00:04:49,860 --> 00:04:54,440
يفكّر بعقليّة تاجر، حيث لا يهدر
أي قوّة عاملة أو مواد

64
00:04:55,250 --> 00:04:59,490
لماذا لا يُسخّر هذا الذّكاء
لتحسين نمط حياته؟

65
00:05:00,900 --> 00:05:03,610
،حسناً، حبَق الرّاعي خاصّتي جاهزة
لذا سأذهب الآن

66
00:05:04,350 --> 00:05:08,010
وسآخذ بعضَ الكحول المُطهّرة لمقصورة اليشم

67
00:05:08,010 --> 00:05:08,870
حسناً

68
00:05:10,410 --> 00:05:13,830
...أيضاً بالنّسبة للإعياء

69
00:05:14,690 --> 00:05:18,540
قالت مولاتي غيوكويو بأنّها
تشعر بالإرهاق كثيراً مؤخّراً

70
00:05:21,200 --> 00:05:22,860
توقّفي، ستُمزّقينها

71
00:05:22,860 --> 00:05:25,420
ما الأمر يا ماوماو؟ أنتِ تُحدثين جلبة

72
00:05:25,990 --> 00:05:27,430
ربّما هذا

73
00:05:29,390 --> 00:05:30,920
لا يمكنك ذلك

74
00:05:32,440 --> 00:05:35,260
حسناً، ماذا يجب أن أفعل تالياً؟

75
00:05:35,700 --> 00:05:37,900
هل ينبغي أن أذهب إلى المدرسة أوّلاً؟

76
00:05:38,620 --> 00:05:42,780
إنّ مُناقشة مولايّ جينشي أوّلاً
سوف تستغرق وقتاً

77
00:05:45,420 --> 00:05:50,200
إنّني أحمله معي، لكن آخر مرّة
...وضعتُه فيها

78
00:05:50,530 --> 00:05:55,020
أليس هذا دبّوس الشّعر الّذي حصلتِ عليه
!من مولايّ جينشي في حفلة الحديقة؟

79
00:05:55,020 --> 00:05:56,710
!لماذا قرّرت وضعه فجأة؟

80
00:05:57,970 --> 00:05:59,320
ربّما لاحقاً

81
00:06:01,490 --> 00:06:05,210
هذا خطّ لومين

82
00:06:05,210 --> 00:06:06,730
ميّزت ذلك؟

83
00:06:07,230 --> 00:06:11,220
آنذاك، كنّا نقول بأنّ نسخ خطّه

84
00:06:11,220 --> 00:06:15,100
سهّلَ عمليّة اجتياز امتحانات الخدمة
المدنيّة، لذا تمّ تطبيقه

85
00:06:15,610 --> 00:06:18,090
،كان لديه الموهبة ليصبح موظّفاً حكوميّاً

86
00:06:18,090 --> 00:06:24,190
لكن أصبح طبيباً بدلاً من ذلك، لأنّه
أشفق على الأطفال المُشرّدين المرضى

87
00:06:24,440 --> 00:06:27,880
إنّه في القصر الخلفيّ الآن

88
00:06:27,880 --> 00:06:30,460
هذه معلومة جديدة بالنّسبة لي

89
00:06:31,470 --> 00:06:34,080
أليست شاولان هنا اليوم؟

90
00:06:34,490 --> 00:06:39,490
إنّها مشغولة قليلاً مؤخّراً بسبب
،انتهاء مدّة خدمتها

91
00:06:39,490 --> 00:06:41,040
وبسبب ذلك المخصيّ الصّغير

92
00:06:41,420 --> 00:06:43,540
...المخصيّ الصّغير

93
00:06:44,100 --> 00:06:49,840
أعلم بأنّ الحماس نادر هنا، لكن هل يستحقّ
ذلك كلّ هذه الجلبة حقّاً؟

94
00:06:49,840 --> 00:06:51,050
ماذا تقصد؟

95
00:06:51,530 --> 00:06:55,440
في الواقع، قيل بأنّ وجود مخصيّين
شباب في الطّرف الجنوبيّ

96
00:06:55,440 --> 00:06:58,670
جعلَ فتيات البلاط يفقدنَ التّركيز على العمل

97
00:06:58,670 --> 00:07:01,310
لذا أرسلوا عدداً قليلاً من المخصيّين
إلى الطّرف الشّماليّ

98
00:07:01,650 --> 00:07:06,280
سمعتُ بأنّ فتيات البلاط في العيادة
مُمتنّات لمُساعدة الذّكور

99
00:07:06,280 --> 00:07:07,860
...العيادة

100
00:07:08,990 --> 00:07:12,640
أعتقد بأنّ السيّدة شينلو سيكون لديها
الكثير من العمل للمخصيّين الصّغار

101
00:07:13,240 --> 00:07:15,230
حسناً، ماذا أردتِ اليوم؟

102
00:07:15,230 --> 00:07:16,160
صحيح

103
00:07:16,670 --> 00:07:19,130
أراد أبي بالتبنّي استخدام هذه
الرّسالة الّتي كتبها

104
00:07:19,130 --> 00:07:22,370
كمثال للتّلاميذ كي يتمرّنوا به على الكتابة

105
00:07:22,720 --> 00:07:24,610
سوف يُوفّر الورق

106
00:07:25,460 --> 00:07:29,760
يريد صنع نُسَخ لنشرها في كلّ مكان

107
00:07:29,760 --> 00:07:30,380
أجل

108
00:07:30,920 --> 00:07:34,620
كان يكتب أشياء مُشابهة في الماضي

109
00:07:34,620 --> 00:07:39,930
كتبَها كلّها بمفرده آنذاك، لذا
انتهى المطاف بمُساعدتي له

110
00:07:40,600 --> 00:07:44,440
قضينا وقتنا نحن الاثنان في الكتابة
...لنشر هذه في كلّ أرجاء القصر الخلفيّ

111
00:07:45,180 --> 00:07:50,600
أعتقد، مع التقدُّم في العمر، تعلّمَ كيف
يُسخّر الآخرين للعمل بذكاء

112
00:07:51,890 --> 00:07:55,650
إذاً كنتَ تنشر إشعارات
ورقيّة في الماضي أيضاً

113
00:07:55,650 --> 00:07:59,240
أجل، كان ذلك عندما كان
،لومين طبيباً هنا

114
00:07:59,240 --> 00:08:01,210
لذا حدث ذلك منذ أكثر من 20 عاماً

115
00:08:02,060 --> 00:08:04,960
كانت مُنتشرة في كلّ أرجاء القصر الخلفيّ

116
00:08:05,720 --> 00:08:08,540
لا تستخدموا مسحوق التّبييض"
،الّذي يحتوي على رصاص

117
00:08:08,540 --> 00:08:13,630
وتجنّبوا الرّوائح الفوّاحة، ولا تقطفوا النّباتات
"...في القصر الخلفيّ دون إذن

118
00:08:13,630 --> 00:08:17,430
أجل، المُحتوى هو واحد تقريباً

119
00:08:18,380 --> 00:08:22,110
شبيه بهذا المُحتوى؟ ما هذا
الإحساس بالقلق؟

120
00:08:23,160 --> 00:08:25,020
!سأحضر ورقاً لاحقاً

121
00:08:26,050 --> 00:08:26,770
حسناً

122
00:08:28,480 --> 00:08:31,530
لا بُدّ أنّ أبي نشر التّحذيرات
عن نيّة طيّبة

123
00:08:32,280 --> 00:08:37,540
لكن هذا يُساعد أولئك ذوي النيّة
الشرّيرة معرفة المواد الضّارّة

124
00:08:38,170 --> 00:08:42,190
مُعظم الأيدي العاملة في القصر الخلفيّ
تُستبدَل كلّ عامين

125
00:08:42,190 --> 00:08:45,460
عندما تُوفّي الإمبراطور السّابق، تمّ
استبدال المحظيّات أيضاً

126
00:08:45,900 --> 00:08:49,950
من يعلم بشأن التّحذيرات المنشورة
...سابقاً؟ لا بُدّ أن يكون

127
00:08:50,700 --> 00:08:51,710
المعذرة

128
00:08:52,770 --> 00:08:53,620
ماذا؟

129
00:08:54,870 --> 00:08:56,640
أنتِ من مقصورة اليشم

130
00:08:56,970 --> 00:08:58,300
سيّدة شينلو

131
00:08:58,840 --> 00:09:00,460
هل أنتِ مُتوعّكة؟

132
00:09:00,460 --> 00:09:01,520
...لا

133
00:09:01,950 --> 00:09:05,450
...هل ينبغي أن أذكر ذلك؟ لكن كيف

134
00:09:07,590 --> 00:09:11,610
المعذرة، هذه كحول. مُستخلَصة وثقيلة جدّاً

135
00:09:11,890 --> 00:09:13,490
لذا ينبغي أن تعمل كمُطهّر جيّد

136
00:09:13,490 --> 00:09:15,900
هل أنتِ متأكّدة بأنّنا يمكننا استعمالها؟

137
00:09:15,900 --> 00:09:18,680
أجل، أعددتُ الكثير منها

138
00:09:18,680 --> 00:09:21,710
شكراً لكِ. سأعدّ بعض الشّاي

139
00:09:25,930 --> 00:09:30,600
بالمناسبة، يبدو الأشخاص في هذه
العيادة ماهرون جدّاً

140
00:09:30,600 --> 00:09:31,840
ماذا تقصدين؟

141
00:09:32,220 --> 00:09:35,390
مدّة خدمة العُمّال في القصر الخلفيّ
،تكون عامين عادة

142
00:09:35,390 --> 00:09:37,760
لكن يبدو أنّ كافّة العاملات هنا
قد خدمنَ لمدّة أطول

143
00:09:38,300 --> 00:09:40,470
جميعنا كبار في السنّ فحسب

144
00:09:41,130 --> 00:09:43,500
بفرض أنّهن انضممنَ في فترة
...المُراهقة أو العشرينيّات

145
00:09:43,500 --> 00:09:48,400
فلا بدّ من وجود سبب دفعهن للبقاء
في القصر الخلفيّ لأكثر من عشرين عاماً

146
00:09:49,990 --> 00:09:52,420
كنّا صغيرات

147
00:09:52,900 --> 00:09:55,600
انضممتُ للقصر الخلفيّ عن عمر العاشرة

148
00:09:56,310 --> 00:10:00,370
انضمّت فتيات البلاط الأُخريات في سنّ مُماثل

149
00:10:01,330 --> 00:10:06,010
في القصر الخلفيّ الحاليّ، لا يُوظّفون
فتيات بعمر صغير كهذا

150
00:10:06,010 --> 00:10:08,370
...لكن في أيّام الإمبراطور الرّاحل

151
00:10:08,850 --> 00:10:14,370
،كان الإمبراطور الرّاحل يختار أصغر الفتيات
ليسلبهن عذريّتهن الواحدة تلو الأُخرى

152
00:10:14,370 --> 00:10:19,090
،قضت الفتيات أيّامهن في القصر الخلفيّ
ممنوعات من المُغادرة

153
00:10:19,460 --> 00:10:21,380
،حالما يمسّك الإمبراطور

154
00:10:21,380 --> 00:10:24,310
،فلا يمكن مُغادرة القصر الخلفيّ
حتّى لو كنت فتاة بلاط

155
00:10:25,080 --> 00:10:28,510
لا أحد في الخارج ينتظر التّرحيب بعودتنا

156
00:10:28,510 --> 00:10:32,310
لا من قبل ولا من بعد

157
00:10:33,000 --> 00:10:35,570
فهمتُ الآن

158
00:10:36,710 --> 00:10:39,290
القصر الخلفيّ. الإمبراطور

159
00:10:39,290 --> 00:10:43,050
والمحظيّات اللّواتي تلقّين حُبّ الإمبراطور

160
00:10:43,590 --> 00:10:46,280
من هنا تتفاقم الكراهية تجاههن

161
00:10:48,050 --> 00:10:52,750
في السّابق، كانت شينلو قلقة بشأن الخادمة
،الّتي مرضتْ في المقصورة البلُّوريّة

162
00:10:52,750 --> 00:10:54,400
وطلبت منّي تفقُّد حالتها

163
00:10:54,920 --> 00:10:58,370
ظننتُ فقط بأنّها كانت سيّدة
بلاط لطيفة وشديدة الاهتمام

164
00:10:58,370 --> 00:10:59,340
...لكن

165
00:10:59,840 --> 00:11:05,000
لعلّ شينلو هي من علّمتْ شين، رئيسة
الوصيفات، في المقصورة البلُّوريّة

166
00:11:05,000 --> 00:11:06,350
كيفيّة صنع عقاقير مُجهِضة

167
00:11:07,130 --> 00:11:11,980
،ماذا لو تلقَّتِ الرّسالةَ بشكل غير مُباشر
...من خلال تلك الخادمة المريضة

168
00:11:14,550 --> 00:11:17,230
السُّعال لا يتوقّف

169
00:11:17,230 --> 00:11:18,570
دعيني أرى

170
00:11:19,020 --> 00:11:21,950
المعذرة، هل هو مُعدٍ؟

171
00:11:21,950 --> 00:11:23,780
هل من مُشكلة؟

172
00:11:24,080 --> 00:11:26,740
لا أريد أن تنتقل العدوى إلى مولاتي ريفا

173
00:11:27,390 --> 00:11:31,550
هناك احتمال أن تكون حاملاً

174
00:11:31,550 --> 00:11:32,420
هكذا إذاً

175
00:11:32,780 --> 00:11:35,680
أعطي هذه للسيّدة شين، رئيسة الوصيفات

176
00:11:35,680 --> 00:11:37,090
ما هي؟

177
00:11:37,410 --> 00:11:39,620
أشياء مُضرّة بالنّساء الحوامل

178
00:11:39,620 --> 00:11:42,590
وبعضها حتّى تُحرّض على الإجهاض

179
00:11:43,510 --> 00:11:46,160
ستكون هذه المعلومات نافعة لمولاتي ريفا

180
00:11:47,370 --> 00:11:50,760
إنّ مُشاركة المعلومات حول أشياء
يجب تجنُّبها يمكن أن تؤدّي أيضاً

181
00:11:50,760 --> 00:11:53,460
بذوي النّوايا السيّئة لمعرفة ما هو سامّ

182
00:11:54,710 --> 00:11:59,030
إذا وصلت قافلةُ في الوقت المُناسب
،لتوفير تلك الأشياء

183
00:12:00,010 --> 00:12:01,940
فمن الطّبيعيّ أن يسعينَ للحصول عليها

184
00:12:03,160 --> 00:12:05,090
لماذا باعوها؟

185
00:12:05,090 --> 00:12:10,660
ربّما فتيات البلاط في العيادة أخبرنَ
التُجّار ما الرّوائح الّتي يُردنَها

186
00:12:11,220 --> 00:12:14,910
لا أعلم ما إن كانت مُتورّطة
في كافّة الحوادث حتّى الآن

187
00:12:14,910 --> 00:12:17,280
حتّى وإن لم يتحوّل الأمر
،إلى نيّة قتل صريحة

188
00:12:17,280 --> 00:12:21,480
،لا بُدّ أنّ الكراهية تفاقمت تدريجيّاً
على مدى زمن طويل، داخل القصر الخلفيّ

189
00:12:24,550 --> 00:12:26,600
هل ينبغي أن أسألها...؟

190
00:12:27,340 --> 00:12:28,780
هل من مُشكلة؟

191
00:12:29,280 --> 00:12:31,080
لا شيء

192
00:12:31,080 --> 00:12:33,520
فهمت. حسناً إذاً

193
00:12:34,350 --> 00:12:36,440
لا، لا ينبغي لي ذلك

194
00:12:36,440 --> 00:12:38,360
لا يوجد دليل، ولا حتّى شهادة

195
00:12:38,360 --> 00:12:40,570
لا أريد أن أطلق اتّهامات باطلة

196
00:12:40,570 --> 00:12:45,080
هذا هو المكان الوحيد الّذي تستطيع فيه عاملة
مريضة الحصول على علاج مُناسب

197
00:12:45,080 --> 00:12:46,360
لا أريد أن يتأثّر هذا المكان سلباً

198
00:12:46,890 --> 00:12:50,270
أعتقد أقصى ما يمكنني فعله هو
اقتلاع جذر الكراهية

199
00:12:50,270 --> 00:12:53,220
المُتفاقم في العيادة قبل أن
ينتشر في كلّ مكان

200
00:12:53,220 --> 00:12:53,790
...المعذرة

201
00:12:54,850 --> 00:12:57,210
آسفة للاقتطاع من وقتك

202
00:12:59,470 --> 00:13:02,600
،إذا أردتِ قراءة أي كتاب من هذه الكُتب
فيمكنكِ أن تأخذيه

203
00:13:02,600 --> 00:13:04,320
احرصي على إعادته فحسب

204
00:13:05,160 --> 00:13:06,890
يوجد الكثير منها

205
00:13:07,470 --> 00:13:11,060
أحياناً يُضيف النّاسُ الكُتبَ إلى ذلك الرفّ

206
00:13:11,450 --> 00:13:13,560
كُلّ ما عليهم هو إعادة الكُتُب فحسب

207
00:13:14,230 --> 00:13:16,890
هذا كتاب ممتاز عن الحشرات

208
00:13:16,890 --> 00:13:20,070
أجل، كان ذلك كتاباً أُضيف
دون أن أشعر

209
00:13:20,610 --> 00:13:22,820
منذ حوالي شهر

210
00:13:26,380 --> 00:13:27,280
...هذا

211
00:13:27,900 --> 00:13:31,540
قبل شهر، أي بالتّزامن مع حفلة
المبعوثين الخاصّين

212
00:13:32,040 --> 00:13:33,300
...على ذكر الأمر

213
00:13:33,300 --> 00:13:35,490
!هذا المكان رائع حقّاً

214
00:13:35,490 --> 00:13:38,290
توجد كثير من الحشرات هنا
!لم أرها إلّا في الكُتُب

215
00:13:38,700 --> 00:13:42,050
هذا الكتاب... هل أحضرَتْه شيسوي؟

216
00:13:42,430 --> 00:13:46,550
لكن كيف لخادمة أن تمتلك كتاباً
باهظ الثّمن كهذا؟

217
00:13:48,040 --> 00:13:53,090
،عندما كانت شيسوي ترسم صوراً للحشرات
استخدمتْ دفتراً مصنوعاً من الورق

218
00:13:53,090 --> 00:13:57,560
.تُجيد القراءة والكتابة أيضاً
لماذا هي خادمة؟

219
00:13:59,430 --> 00:14:02,680
شينلو، عليكِ أن تتعاملي مع هذا بحذر

220
00:14:03,020 --> 00:14:07,680
،صوت عالي النّبرة بالنّسبة لرجل
لكنّه ليس أُنثويّاً بما يكفي

221
00:14:08,340 --> 00:14:10,530
،أقصر من رجل مُتوسّط الطّول

222
00:14:11,230 --> 00:14:13,290
لكن أطول من امرأة مُتوسطة الطّول

223
00:14:13,830 --> 00:14:19,790
...شخص جميل يجذب انتباه فتيات البلاط

224
00:14:21,790 --> 00:14:23,120
...سويري

225
00:14:25,580 --> 00:14:29,970
شينلو، اكتشفتْ ما فعلتِه
من خلال مُحادثتكِ السّابقة

226
00:14:31,960 --> 00:14:33,970
أنتِ ذكيّة كالعادة

227
00:14:34,400 --> 00:14:37,010
كما في تلك المرّة عندما منعتِني
من أن أصبح جثّة

228
00:14:37,010 --> 00:14:41,900
هل ينبغي أن أصرخ؟ أم أرمي
قنينة الكحول وأهرب؟

229
00:14:41,900 --> 00:14:45,280
إيّاك وفعل أي شيء. سأطعنكِ إن تحرّكتِ

230
00:14:45,640 --> 00:14:49,150
إذا قتلتِني هنا، سيكشفونكِ فوراً

231
00:14:49,570 --> 00:14:51,960
أريد إنهاء هذا بسلام إن أمكن

232
00:14:54,250 --> 00:14:56,620
هل لهذا أثرٌ جانبيّ لدواء الانبعاث؟

233
00:14:57,750 --> 00:14:59,960
،بعد مُحاولة الاغتيال في المراسم

234
00:14:59,960 --> 00:15:04,400
تظاهرتِ بتجرُّع السُّمّ والموت

235
00:15:05,500 --> 00:15:10,350
لا بُدّ أنّ كونكِ في حالة شبه ميّتة لبعض
الوقت قد أثّر عليكِ سلباً

236
00:15:11,020 --> 00:15:14,720
فليكُن. هل تريدين أن تعرفي ما هو هدفي؟

237
00:15:15,130 --> 00:15:16,510
أتعتقدين بأنّني سأُصغي؟

238
00:15:16,820 --> 00:15:17,720
!ستفعلين

239
00:15:20,480 --> 00:15:21,700
!شيسوي

240
00:15:21,700 --> 00:15:24,520
توقّعت. كان ذلك الكتاب لشيسوي

241
00:15:25,080 --> 00:15:26,900
...آسفة يا ماوماو

242
00:15:27,260 --> 00:15:29,530
هل تكترثين لحياة هذه الفتاة؟

243
00:15:30,400 --> 00:15:31,920
ماذا تريدين؟

244
00:15:31,920 --> 00:15:34,370
أريدكِ أن تأتي معي إلى خارج القصر الخلفيّ

245
00:15:34,370 --> 00:15:37,540
...نُغادر القصر الخلفيّ؟ هذا

246
00:15:37,540 --> 00:15:42,210
مُمكن. وأعلم بأنّكِ ستتبعينني

247
00:15:44,650 --> 00:15:49,170
ألا تريدين أن تعرفي كيفيّة
صنع دواء الانبعاث؟

248
00:15:52,580 --> 00:15:55,140
هذا لا يُصدّق

249
00:15:56,060 --> 00:15:58,700
يجب ألّا أستهين بها

250
00:16:02,910 --> 00:16:06,780
هناك وحشان في القصر، في الشّرق والغرب

251
00:16:06,780 --> 00:16:10,320
في مقرّ الجيش شرقاً، يوجد وحش

252
00:16:10,840 --> 00:16:14,030
،وفي الطّرف الغربيّ، مُمثَّلاً بالبيروقراطيّة
وحش آخر

253
00:16:14,600 --> 00:16:16,590
...بعبارة أُخرى، الآمر العسكريّ العظيم

254
00:16:16,590 --> 00:16:20,440
لاكان، ضابط رفيع الشّأن، ثعلب الشّرق

255
00:16:20,440 --> 00:16:22,740
والشّخصيّة السّياسيّة البارزة
،من فترة الإمبراطور الرّاحل

256
00:16:22,740 --> 00:16:27,040
،حاكم شيهوكو-شو، شيشو
تانوكيّ الغرب

257
00:16:27,500 --> 00:16:28,800
كيف يمكننا خدمتك؟

258
00:16:29,180 --> 00:16:32,490
كلّ ما في الأمر أنّ الأخ الإمبراطوريّ الأصغر

259
00:16:32,490 --> 00:16:34,780
قد انضمّ لمجلس البلاط لأوّل مرّة منذ شهر

260
00:16:34,780 --> 00:16:37,470
كنتُ آمل احتساء الشّاي بعد ذلك

261
00:16:37,960 --> 00:16:42,380
ارتأيتُ أيضاً أنّ هذه قد تكون فُرصة
مُناسبة لدعوة السيّد شيشو

262
00:16:42,380 --> 00:16:44,980
أنا أيضاً؟

263
00:16:45,630 --> 00:16:49,150
يؤسفني القول بأنّني لا أملك
أي رواية مُثيرة أرويها

264
00:16:51,470 --> 00:16:53,860
سوف ينضمّ لك

265
00:16:53,860 --> 00:16:57,390
في هذه الحالة، لنذهب إلى الفناء الأوسط

266
00:16:59,610 --> 00:17:02,830
الخريف واضح هنا

267
00:17:03,470 --> 00:17:08,080
أحضرتُ فناجينَ فضّية. لا حاجة لمُتذوّق

268
00:17:15,950 --> 00:17:17,720
يقول بأنّه لذيذ

269
00:17:19,470 --> 00:17:22,990
سيّد لاكان، ظننتُ بأنّ لديك أمر لمُناقشته

270
00:17:23,670 --> 00:17:25,920
أتتذكّر مُحاولة اغتيال

271
00:17:25,920 --> 00:17:28,740
الأخ الإمبراطوريّ الأصغر قبل أيّام
في شيهوكو-شو؟

272
00:17:28,740 --> 00:17:33,150
توصّلتْ تحقيقاتنا إلى أمر مُثير للاهتمام

273
00:17:35,010 --> 00:17:37,410
هل هذا... رسم تخطيطيّ لفيفا؟

274
00:17:37,980 --> 00:17:42,120
هل تعرف ما هذا يا سيّد شيشو؟

275
00:17:43,400 --> 00:17:45,460
ما هذا؟

276
00:17:45,880 --> 00:17:50,170
هذا هو السّلاح الّذي كان المغتالون
يحملونه. صحيح؟

277
00:17:52,730 --> 00:17:54,960
المعذرة، تابع لو سمحت

278
00:17:54,960 --> 00:17:58,700
فكّكناه ورسمنا المُخطّط

279
00:17:58,700 --> 00:18:01,090
يبدو أنّه أحدث نموذج طُوِّرَ في الغرب

280
00:18:01,090 --> 00:18:06,230
،هنا، في رأس المِطرقة، بدلاً من صاعق
يوجد قطعة صوّان

281
00:18:06,540 --> 00:18:10,400
إنّه أدقّ في إصابة الهدف، والتّصميم
أبسط من المُتوقّع

282
00:18:10,400 --> 00:18:13,520
هذا مُدهش حقّاً

283
00:18:13,520 --> 00:18:19,650
أجل. إذا صُنِع بكمّيات كبيرة، فسوف
يُغيّر شكل الحرب

284
00:18:19,650 --> 00:18:22,870
وسيُتيح ذلك إمكانيّة وضع تشكيلات أكثر
تماسُكاً، وجعل السّفر أسهل

285
00:18:23,180 --> 00:18:25,770
إنّ حمل سلاح كهذا بواسطة أوغاد

286
00:18:25,770 --> 00:18:28,860
...يسعون لاغتيال الأخ الإمبراطوريّ الأصغر

287
00:18:28,860 --> 00:18:33,130
أتساءل كيف وصل هذا إلى أيديهم

288
00:18:36,750 --> 00:18:38,860
من يدري؟

289
00:18:41,180 --> 00:18:44,680
أنت من عليه اكتشاف ذلك، صحيح؟

290
00:18:44,680 --> 00:18:49,760
صحيح، لكنّنا في مأزق بسيط

291
00:18:49,760 --> 00:18:52,970
،المُتحرّي المسؤول تحمّس زيادة عن اللُّزوم

292
00:18:52,970 --> 00:18:55,320
ودخلَ المُشتبه به في صمت مُطبِق

293
00:18:56,360 --> 00:19:00,080
لا ينبغي التّساهل مع مسألة مُحاولة
،اغتيال الأخ الإمبراطوريّ الأصغر

294
00:19:00,080 --> 00:19:03,620
لكن رغم ذلك، إفساد مسار
التّحقيق خسارة حقيقيّة

295
00:19:03,620 --> 00:19:09,750
،لذا كنتُ أتساءل يا سيّد شيشو
ما إن سمعتَ شيئاً عن هذا

296
00:19:10,260 --> 00:19:13,500
لو كنتُ قد سمعت، لأبلغتُ عن الأمر فوراً

297
00:19:14,270 --> 00:19:16,500
حقّاً؟ هذا مُؤسف

298
00:19:17,230 --> 00:19:19,980
حسناً، لننتقل إلى الموضوع التّالي

299
00:19:20,930 --> 00:19:24,850
هذا سجلّ لعبة غو الّتي لعبتُها
!مع زوجتي في الأمس

300
00:19:25,500 --> 00:19:27,560
ز-زوجتك؟

301
00:19:27,840 --> 00:19:31,970
أجل، سمعتُ بأنّك تزوّجت يا سيّد لاكان

302
00:19:31,970 --> 00:19:33,020
!أجل

303
00:19:33,420 --> 00:19:37,480
قيل بأنّ الاحتفالات دامت لأسبوع كامل

304
00:19:37,480 --> 00:19:40,770
!سمعت بذلك إذاً

305
00:19:40,770 --> 00:19:43,970
أجل، وهي امرأة ذكيّة جدّاً. أقصد زوجتي

306
00:19:43,970 --> 00:19:46,810
انظر إلى هذه النّقلات. إنّها
!حادّة كنصل مشحوذ

307
00:19:46,810 --> 00:19:50,000
شعرتُ بقشعريرة عندما
!قامت بهذه النّقلات

308
00:19:50,000 --> 00:19:54,670
،كهذه النّقلة! تجنّبتُها بصعوبة
!لكنّها تَبِعتها بهذه

309
00:19:55,380 --> 00:19:58,090
إلى متى سيستمرّ هذا؟

310
00:19:55,630 --> 00:19:58,570
...أجل، أُقرّ بأنّ هذا أمر مُبهج

311
00:19:58,570 --> 00:20:02,680
،المعذرة، لكن لديّ عمل أقوم به
لذا أستأذن بالانصراف

312
00:20:02,680 --> 00:20:04,460
شكراً لك على المشروبات

313
00:20:04,460 --> 00:20:06,180
مع الأسف الشّديد

314
00:20:06,770 --> 00:20:08,860
سأحرص على إرسال نسخة لك
،عن سجلّ اللّعبة

315
00:20:08,860 --> 00:20:11,880
مع كتاب يُفصّل المشهد

316
00:20:11,880 --> 00:20:13,810
...ليس عليك ذلك

317
00:20:14,170 --> 00:20:19,610
.من فضلك، لا حاجة للتّواضُع
ما رأيك بعصير عنب كذلك؟

318
00:20:20,140 --> 00:20:24,610
يُقدّم بكأس زُجاجيّ الّذي
يُبرز اللّون الأحمر بوضوح

319
00:20:26,740 --> 00:20:29,990
هذا جميل بحقّ، أجل

320
00:20:30,650 --> 00:20:32,000
أليس كذلك؟

321
00:20:32,550 --> 00:20:34,830
أعتقد أنا وأنت سننسجم جيّداً معاً

322
00:20:34,830 --> 00:20:37,690
أرغب أن أُحدّثك عن زوجتي

323
00:20:37,690 --> 00:20:40,000
...في وقت لاحق. المعذرة

324
00:20:43,870 --> 00:20:47,680
يتمتّع هذا الشّراب بلون فريد، أليس كذلك؟

325
00:20:48,490 --> 00:20:52,390
هناك نوع من العنب في العالم لونه أخضر

326
00:20:53,050 --> 00:20:55,830
هذا أخضر، وليس أحمر، كيفما نظرت إليه

327
00:20:55,830 --> 00:21:00,650
لماذا لم يستجب السيّد شيشو
عندما قال "أحمر"؟

328
00:21:01,770 --> 00:21:03,950
كما قال عمّي

329
00:21:08,880 --> 00:21:11,510
هل يمكنني فرد شعري؟

330
00:21:11,510 --> 00:21:15,960
أجل. سأستمرّ في المُراقبة للحرص
على عدم دخول أحد

331
00:21:16,370 --> 00:21:18,670
أستطيع إزالة قناعي أخيراً

332
00:21:25,570 --> 00:21:28,620
أحذية المنصّة تلك مُرهِقة حقّاً

333
00:21:29,100 --> 00:21:31,310
أعتذر على طلبي منكِ القيام بهذا

334
00:21:31,690 --> 00:21:33,840
لا تقلق. التّظاهر بأنّني وليّ العهد

335
00:21:33,840 --> 00:21:37,020
هو تجربة نادرة. استمتعتُ بها

336
00:21:37,850 --> 00:21:41,440
تبدو كبيروقراطيّ وسيم

337
00:21:41,440 --> 00:21:45,530
،من يتوقّع أن تكون هذه مولاتي آدو
المحظيّة الرّفيعة السّابقة؟

338
00:21:45,840 --> 00:21:49,320
كان الثّعلب غريب أطوار لدرجة
جعلت التّانوكيّ يبدو طبيعيّاً

339
00:21:49,320 --> 00:21:51,990
قلّ من النّاس يُقارَنون بالاستراتيجيّ

340
00:21:52,570 --> 00:21:54,450
يبدو مهووساً بزوجته

341
00:21:54,800 --> 00:21:56,960
سمعتُ بأنّه كذلك تجاه ابنته أيضاً

342
00:21:56,960 --> 00:21:59,710
من كان يتوقّع أن تكون هي ابنته؟

343
00:22:00,220 --> 00:22:05,510
وتلك الابنة هي سبب انشغال السيّد
جينشي المخصيّ، صحيح؟

344
00:22:07,350 --> 00:22:11,010
...لا أصدّق أنّها فُقِدت

345
00:23:45,020 --> 00:23:59,950
الحلقة القادمة

346
00:23:56,450 --> 00:23:59,220
"الحلقة القادمة: "قرية الثّعلب