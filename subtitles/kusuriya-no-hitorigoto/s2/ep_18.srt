1
00:01:30,440 --> 00:01:33,440
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

2
00:01:42,170 --> 00:01:43,460
المعذرة

3
00:01:43,460 --> 00:01:44,540
مولايّ جينشي

4
00:01:45,100 --> 00:01:47,510
سمعتُ أنّ المحظيّة غيوكويو قد جاءها المخاض

5
00:01:47,510 --> 00:01:49,750
أجل، في صباح اليوم

6
00:01:49,750 --> 00:01:54,090
نتوقّع أن تحدث الولادة الفعليّة بعد
فترة قصيرة، لكنّنا نتجهّز على أيّ حال

7
00:01:54,790 --> 00:01:55,760
تفضّل

8
00:02:06,950 --> 00:02:08,060
كيف حالها؟

9
00:02:08,360 --> 00:02:10,650
حالتها مُستقرّة

10
00:02:11,030 --> 00:02:14,720
انحسرتْ انقباضاتها، ولا يبدو
أنّها في حالة إرهاق

11
00:02:15,690 --> 00:02:16,560
هكذا إذاً

12
00:02:17,210 --> 00:02:20,570
ما زال من غير الواضح متى ستحدث
الولادة الفعليّة

13
00:02:21,150 --> 00:02:22,950
كيف حال الرّضيع؟

14
00:02:22,950 --> 00:02:26,340
،إذا كنت تقصد الولادة المقعديّة
فلم يعُد هذا مصدر قلق

15
00:02:26,340 --> 00:02:29,930
يبدو أنّ علاج ماوماو قد نجح

16
00:02:31,670 --> 00:02:32,730
...ماوماو

17
00:02:34,630 --> 00:02:37,700
مضى عشرة أيّام منذ اختفائها

18
00:02:38,490 --> 00:02:39,690
هل هي بخير؟

19
00:02:46,860 --> 00:02:50,840
لـ-لومين، ما الّذي يمكنني فعله لمُساعدتك؟

20
00:02:50,840 --> 00:02:52,850
!ابتعد عن طريقي يا طبيب

21
00:02:52,850 --> 00:02:55,460
!لا تقف عند الباب من فضلك

22
00:02:56,650 --> 00:02:58,420
اعتنِ بالقطّة فحسب

23
00:02:58,420 --> 00:02:59,470
!حاضر

24
00:03:04,810 --> 00:03:08,870
من المُطمئن قليلاً وجود شخص آخر
حولي مُرتعد أكثر منّي

25
00:03:13,470 --> 00:03:17,750
سأغادر حاليّاً. من فضلكِ أبلغيني
إذا ما استجدّ أي شيء

26
00:03:18,900 --> 00:03:19,920
!مولايّ جينشي

27
00:03:20,390 --> 00:03:21,220
ما الأمر؟

28
00:03:22,740 --> 00:03:25,080
بخصوص المخصيّ المفقود

29
00:03:29,190 --> 00:03:31,310
حسناً، ماذا وجدت؟

30
00:03:31,900 --> 00:03:33,890
المخصيّ يُدعى تيين

31
00:03:33,890 --> 00:03:36,910
،كان يُفترض أن يكون عبداً من دولة أجنبيّة

32
00:03:36,910 --> 00:03:40,820
لكن لا أحد من الآخرين الّذين وصلوا
معه قد تعرّفوا عليه

33
00:03:40,820 --> 00:03:43,950
لا بدّ أنّه تسلّل إلى الدّاخل من مكان ما

34
00:03:45,720 --> 00:03:47,950
من أجل اختراق القصر الخلفيّ

35
00:03:49,210 --> 00:03:53,130
غالباً تحاشى الآخرين حفاظاً على ذلك السرّ

36
00:03:53,130 --> 00:03:56,110
بسبب ذلك، لا نملك أي معلومات عنه

37
00:03:58,310 --> 00:03:59,130
هل من شيء آخر؟

38
00:03:59,130 --> 00:04:02,390
شوهِد يُصلّي في مزار

39
00:04:02,830 --> 00:04:05,660
هذا ليس غريباً. ربّما كان مُتديّناً فحسب

40
00:04:06,510 --> 00:04:07,850
...في الواقع

41
00:04:12,860 --> 00:04:15,850
المقبرة في الطّرف الشّماليّ؟

42
00:04:15,850 --> 00:04:16,310
أجل

43
00:04:16,940 --> 00:04:21,940
قبور أولئك اللّواتي فقدنَ عذريّتهن بواسطة الإمبراطور
الرّاحل، واللّواتي متنَ في القصر الخلفيّ

44
00:04:25,560 --> 00:04:30,260
شوهِد تيين يُقدّم عزاءه لإحدى القبور هناك

45
00:04:35,080 --> 00:04:39,740
أولئك اللّواتي فقدنَ عذريّتهن بواسطة
الإمبراطور الرّاحل عن عمر صغير

46
00:04:40,150 --> 00:04:42,940
لم يكن يُسمَح لهن بمُغادرة القصر
الخلفيّ أبداً، حتّى بعد الوفاة

47
00:04:48,090 --> 00:04:53,800
اختفينَ في هذه الحديقة حتّى
من دون تدوين أسمائهم

48
00:05:01,910 --> 00:05:03,530
هل هذه عاملة من العيادة؟

49
00:05:04,940 --> 00:05:06,940
ا-المعذرة

50
00:05:12,330 --> 00:05:13,580
...هذه الرّائحة

51
00:05:22,050 --> 00:05:23,420
!إلى أين ذهبت ماوماو؟

52
00:05:29,320 --> 00:05:33,060
اهدأ! أنا "جينشي المخصيّ" الآن

53
00:05:33,060 --> 00:05:34,560
...يجب أن أكون على طبيعتي المعتادة

54
00:05:37,980 --> 00:05:39,960
،أبحث عن الوصيفة ذات النّمش

55
00:05:39,960 --> 00:05:42,580
الفتاة الّتي تعمل في مقصورة اليشم

56
00:05:43,060 --> 00:05:44,750
هل تعرف ين عمّن أتكلّم؟

57
00:05:54,690 --> 00:05:56,040
أنتِ تعرفين شيئاً

58
00:05:57,320 --> 00:06:02,420
تذكّرتُ... ذكرى قديمة

59
00:06:06,420 --> 00:06:09,320
ناداني باسمي بصوت رقيق كهذا

60
00:06:10,500 --> 00:06:14,240
أعطاني حلويّات من بلد أجنبيّ

61
00:06:27,800 --> 00:06:29,150
عمّاذا تتكلّمين؟

62
00:06:29,780 --> 00:06:34,330
أعتقد لا أحد يعلم كيف كان شكله
عندما كان صغيراً

63
00:06:35,050 --> 00:06:38,410
سمعتُ بأنّه كان مختلفاً تماماً
خلال سنواته الأخيرة

64
00:06:39,010 --> 00:06:42,860
،لم يأتِ لرؤيتي أبداً بعد أن كبرت

65
00:06:42,860 --> 00:06:45,220
لذا كلّ ما أعرفه عنه هو من خلال الإشاعات

66
00:06:45,940 --> 00:06:47,650
من تقصدين؟

67
00:06:47,650 --> 00:06:49,930
أنت تشبهه تماماً

68
00:06:49,930 --> 00:06:51,300
!ما الّذي تتحدّثين عنه؟

69
00:06:51,770 --> 00:06:57,620
،كان لديه صوت حلو كالعسل

70
00:06:57,620 --> 00:07:01,100
ووجه كإلَهة حسناء

71
00:07:02,090 --> 00:07:07,880
لماذا يتظاهر شخصٌ بمكانتك بأنّه مخصيّ؟

72
00:07:11,910 --> 00:07:13,100
!اعتقلوها

73
00:07:13,780 --> 00:07:14,970
!دعوني

74
00:07:14,970 --> 00:07:16,120
!كفّي عن المُقاومة

75
00:07:17,640 --> 00:07:19,800
مولايّ جينشي، ماذا يجدر بنا أن نفعل؟

76
00:07:22,380 --> 00:07:23,560
!مولايّ جينشي؟

77
00:07:31,630 --> 00:07:33,470
!ماذا كان ذلك؟ سُمّ؟

78
00:07:35,050 --> 00:07:36,090
!أحضر ماء

79
00:07:36,090 --> 00:07:36,810
Yes!

80
00:07:38,220 --> 00:07:40,180
!مولايّ جينشي، تعليماتك

81
00:07:42,690 --> 00:07:43,600
!مولايّ جينشي

82
00:07:48,600 --> 00:07:52,780
.خذوا هذه المرأة إلى مكتب الطّبيب
!احرصوا على ألّا تفعل ذلك ثانية

83
00:07:52,780 --> 00:07:53,520
!حاضر

84
00:07:56,970 --> 00:07:58,650
!استفق من فضلك

85
00:07:58,650 --> 00:08:01,240
!لا تدع مُجرّد إهانة عفويّة من خادمة تهزّك

86
00:08:02,600 --> 00:08:03,920
عفويّة؟

87
00:08:05,090 --> 00:08:07,530
تجرعّتْ سُمّاً. يبدو الأمر أخطر من ذلك

88
00:08:10,760 --> 00:08:14,510
شَحُبَ وجهها عندما رأتني أبتسم لها

89
00:08:15,040 --> 00:08:16,760
...هو أيضاً

90
00:08:18,200 --> 00:08:22,230
غاوشون، هل أشبهه؟

91
00:08:22,670 --> 00:08:25,780
لدرجة كافية لجعل شخص يتجرّع
سُمّاً بدافع الخوف؟

92
00:08:28,050 --> 00:08:32,810
في ذاكرتي، كان عجوزاً واهناً بالفعل

93
00:08:34,940 --> 00:08:38,120
لم أشبه أمّي أو أخي

94
00:08:38,930 --> 00:08:39,760
...لذا

95
00:08:40,930 --> 00:08:42,460
لذا صدّقت

96
00:08:43,950 --> 00:08:46,250
أتساءل من أين استمدّ مظهره هذا؟

97
00:08:46,250 --> 00:08:51,140
بالنّظر إلى ذوق الإمبراطور، لا يمكن أن
تكون الإمبراطورة، ليس بمثل سنّها

98
00:08:53,000 --> 00:08:56,660
لهذا يقول الجميع بأنّه ابن غير شرعيّ

99
00:09:04,350 --> 00:09:07,510
صدّقتُ الإشاعات الّتي قالت بأنّني
لا أملك أي ارتباط به

100
00:09:07,950 --> 00:09:10,520
حاولتُ التهرُّب من منصب وليّ العهد

101
00:09:11,570 --> 00:09:14,280
توسّلتُ أخي، الإمبراطور، بأن يدعني
،أنتحل هويّة مخصيّ

102
00:09:14,280 --> 00:09:18,350
.ودسّ نفسي في حديقة النّساء
كلّ هذا لأجل ماذا؟

103
00:09:19,990 --> 00:09:21,880
!يا للسّخافة

104
00:09:51,610 --> 00:09:54,440
...لكن لا يمكنني أن أفعل

105
00:09:55,230 --> 00:09:56,630
سوى ما أستطيع فعله...

106
00:09:58,360 --> 00:09:59,760
صحيح

107
00:09:59,760 --> 00:10:01,580
يمكنني أن أسخر من نفسي لاحقاً

108
00:10:01,980 --> 00:10:03,710
حاليّاً، لديّ أمور أقوم بها

109
00:10:05,270 --> 00:10:08,790
كانت تلك المرأة تُقدّم عزاءها لهذا القبر، صحيح؟

110
00:10:08,790 --> 00:10:09,560
أجل

111
00:10:11,970 --> 00:10:14,630
نبات الفانوس؟ هذا ليس في موسمه

112
00:10:16,680 --> 00:10:18,190
...تايهو

113
00:10:18,830 --> 00:10:21,060
اسم فتاة البلاط الّتي تُوفّيت في العام الماضي

114
00:10:21,850 --> 00:10:26,230
أجل. كانت تجمع نساء حولها
لتروي قصص أشباح

115
00:10:27,730 --> 00:10:30,700
كانت وصيفة إحدى المحظيّات

116
00:10:37,960 --> 00:10:39,310
...كان قريباتها

117
00:10:43,490 --> 00:10:46,240
شخص واحد فقط مُرتبط بتايهو بالدّم

118
00:10:46,780 --> 00:10:48,370
،أثناء حكم الإمبراطور الرّاحل

119
00:10:48,370 --> 00:10:50,990
أنجبتْ ابنة بعد علاقة مع طبيب

120
00:10:53,690 --> 00:10:56,070
...إن كانت تلك الابنة لا تزال حيّة

121
00:11:02,290 --> 00:11:03,560
إلى أين أنت ذاهب؟

122
00:11:03,560 --> 00:11:04,670
مقصورة العقيق الأحمر

123
00:11:13,890 --> 00:11:17,770
المَحظيّة الّتي كانت تايهو تخدمها
أُعطيتْ لشيشو لاحقاً

124
00:11:17,770 --> 00:11:19,100
أنجبَتْ ابنة

125
00:11:19,790 --> 00:11:21,950
تلك الابنة هي المحظيّة روران

126
00:11:22,610 --> 00:11:26,810
،بالنّسبة لابنة تايهو والطّبيب

127
00:11:27,790 --> 00:11:30,540
لا يوجد سحلّ حول ما حدث
،لها أو للطّبيب

128
00:11:31,200 --> 00:11:33,100
الّذي طُرِد من القصر الخلفيّ

129
00:11:42,980 --> 00:11:47,880
ربّما تعلم المحظيّة روران إلى أين
ذهب الطّبيب والابنة

130
00:11:49,640 --> 00:11:54,340
إنّه مُجرّد حدس. لا يمكن معرفة
ما إن كان يوجد رابط

131
00:11:55,050 --> 00:11:56,060
...لكن رغم ذلك

132
00:11:58,510 --> 00:11:59,360
من فضلك

133
00:12:00,670 --> 00:12:04,170
سأفعل كلّ ما يمكنني فعله

134
00:12:10,450 --> 00:12:12,810
أعتذر على الزّيارة المُفاجئة

135
00:12:16,840 --> 00:12:19,300
تقول بأنّها لا تُمانع

136
00:12:19,890 --> 00:12:21,360
شكراً لكِ

137
00:12:22,690 --> 00:12:25,290
غريب، كالعادة

138
00:12:25,290 --> 00:12:29,560
ملابس مُبهرَجة ومكياج مُتطابق مع نقاط
...حادّة في زوايا العين

139
00:12:30,870 --> 00:12:32,560
هذا يجعلهن كثعالب

140
00:12:33,660 --> 00:12:36,690
—لدي سؤال لكِ

141
00:12:40,200 --> 00:12:40,940
مولايّ جينشي؟

142
00:12:43,480 --> 00:12:44,360
ماذا تفعل؟

143
00:12:47,730 --> 00:12:50,330
كان لديكِ سبع وصيفات

144
00:12:50,820 --> 00:12:52,590
أين اختفت الأخيرة؟

145
00:12:54,020 --> 00:12:58,950
أراقب وجوه وأسماء كلّ الوصيفات
العاملات في هذا المكان

146
00:12:59,870 --> 00:13:03,820
تُبدّل مجموعتكِ لباسها ومكياجها
،في كلّ يوم تقريباً

147
00:13:04,340 --> 00:13:07,390
لذا لاحظتُ السّمات الّتي يسهل تعقّبها

148
00:13:07,710 --> 00:13:11,910
،على سبيل المثال، شكل شفاهكن أو عيونكن

149
00:13:12,820 --> 00:13:14,250
...وأيضاً

150
00:13:16,200 --> 00:13:17,740
أماكن وجود الشّامات

151
00:13:19,380 --> 00:13:22,860
سورين... لا، رينبو، صحيح؟

152
00:13:23,430 --> 00:13:24,810
هذا هو اسمكِ

153
00:13:27,750 --> 00:13:30,040
كان هذا مُخطّطاً منذ البداية، أليس كذلك؟

154
00:13:30,670 --> 00:13:32,940
،إحضار عدد كبير من الخادمات

155
00:13:32,940 --> 00:13:35,540
...واختيار نساء مُتشابهات لخدمتها

156
00:13:35,990 --> 00:13:39,350
المكياج والملابس الغريبة

157
00:13:39,990 --> 00:13:42,590
كلّ ذلك لأجل هذا

158
00:13:43,610 --> 00:13:44,500
—مـ-مولايّ جينشي

159
00:13:44,500 --> 00:13:45,130
!تكلّمي

160
00:13:45,860 --> 00:13:47,990
أين هي؟

161
00:13:50,580 --> 00:13:52,460
إلى أين ذهبت؟

162
00:13:56,350 --> 00:13:58,310
!إلى أين ذهبت المحظيّة روران؟

163
00:13:59,190 --> 00:14:01,060
!سامحها أرجوك

164
00:14:01,330 --> 00:14:04,320
رينبو لا تعلم شيئاً حقّاً

165
00:14:05,720 --> 00:14:08,940
...سامحها أرجوك

166
00:14:17,990 --> 00:14:20,410
تبّاً. اهدأ

167
00:14:23,580 --> 00:14:26,550
إذاً، لم تخبركِ إلى أين كانت ذاهبة؟

168
00:14:27,080 --> 00:14:29,980
لا. قالت فقط أنّها لن تعود

169
00:14:30,580 --> 00:14:34,780
محظيّة رفيعة التّصنيف غادرت القصر
الخلفيّ بمحض إرادتها

170
00:14:50,290 --> 00:14:52,720
إذاً لا جدوى من الاستمرار في سؤالهن

171
00:14:56,660 --> 00:14:58,650
،فتّشنا جميع الأشخاص المُتاحين

172
00:15:01,950 --> 00:15:04,260
لا حاجة لتسميتها بـ"المحظيّة" بعد الآن

173
00:15:05,950 --> 00:15:08,380
إنّ مُغادرة القصر الخلفيّ جريمة خطيرة

174
00:15:08,780 --> 00:15:10,940
لا سيّما بالنّسبة لمحظيّة رفيعة التّصنيف

175
00:15:12,310 --> 00:15:14,640
لا بدّ أنّها خطّطت لهذا وهي على علم بالأمر

176
00:15:15,050 --> 00:15:16,000
...أجل

177
00:15:17,190 --> 00:15:20,440
إنّ إدخال ابنة مسؤول رفيع الشّأن
إلى القصر الخلفيّ

178
00:15:20,780 --> 00:15:23,060
هو صفقة تُفيد الإمبراطور كذلك

179
00:15:23,910 --> 00:15:28,540
يمكنه حبسهن في القصر الخلفيّ
كرهينة كعصفور في قفص

180
00:15:30,020 --> 00:15:33,780
بدا شيشو قلقاً على ابنته كثيراً

181
00:15:34,140 --> 00:15:37,310
لكن لا أحد يعرف شعوره فعليّاً

182
00:15:40,530 --> 00:15:43,170
أتساءل كيف كان الأمر بالنّسبة لماوماو؟

183
00:15:44,250 --> 00:15:47,980
قالت ذات مرّة أنّ الأمر أشبه
بمُحاولة محظيّة الاعتزال

184
00:15:49,490 --> 00:15:51,530
هل ذهبتْ معهم طوعاً؟

185
00:15:52,230 --> 00:15:55,300
لا، لو فعلتْ، لما تركتْ رسالة كتلك

186
00:15:56,260 --> 00:15:59,390
إلى أين ذهبتْ ولماذا؟

187
00:16:05,340 --> 00:16:06,520
ماذا؟

188
00:16:06,900 --> 00:16:08,720
...ماوماو

189
00:16:08,720 --> 00:16:10,650
مفقودة...؟

190
00:16:16,590 --> 00:16:19,450
!انتظريني يا ماوماو

191
00:16:20,370 --> 00:16:24,900
!أبوك قادم لإنقاذكِ

192
00:16:27,100 --> 00:16:29,750
!مولايّ راكان

193
00:16:31,390 --> 00:16:33,300
كيف عَلِم بالأمر؟

194
00:16:33,300 --> 00:16:35,760
يبدو أنّ المعلومة تسرّبت من مكان ما

195
00:16:38,090 --> 00:16:41,610
وأيضاً، شيشو مفقود حاليّاً أيضاً

196
00:16:42,440 --> 00:16:44,850
هل كان يتواطأ مع روران؟

197
00:16:45,150 --> 00:16:50,140
لا أعلم. لكنّه والد محظيّة هاربة

198
00:16:50,140 --> 00:16:53,900
سيُدان بجرائم ضدّ الإمبراطور

199
00:16:54,790 --> 00:16:56,490
فهمت

200
00:16:57,050 --> 00:17:00,580
وبخصوص سيّدة البلاط في الأمس... شينلو

201
00:17:01,160 --> 00:17:03,070
خرجت من دائرة الخطر

202
00:17:04,360 --> 00:17:05,390
هل استيقظت؟

203
00:17:06,110 --> 00:17:07,670
لا، ليس بعد

204
00:17:09,220 --> 00:17:13,280
لكن تأكّدنا من أنّ كان لديها
ارتباطات مع تايهو

205
00:17:13,870 --> 00:17:16,730
لهذا شاركتْ في هذا التمرُّد غالباً

206
00:17:17,660 --> 00:17:19,350
هل الجميع في العيادة طرف في هذا؟

207
00:17:20,220 --> 00:17:21,140
،لا

208
00:17:22,380 --> 00:17:26,260
،لا أحد من الآخرين يعلمون بالأمر

209
00:17:29,710 --> 00:17:35,110
مع ذلك ساعدوها، غالباً لأنّ جميعهم
يشاركون شينلو الامتعاض الّذي ضمرَتْه

210
00:17:36,360 --> 00:17:38,300
،مع رحيل الإمبراطور السّابق

211
00:17:38,300 --> 00:17:42,490
انصبَّ غضبهم على القصر الخلفيّ بحدّ ذاته

212
00:17:46,450 --> 00:17:51,160
يجب أن أجد روران فوراً، لكن لا يوجد
ما يكفي من معلومات

213
00:17:51,650 --> 00:17:53,820
هل ينبغي أن أستهدف شيشو أوّلاً؟

214
00:17:54,920 --> 00:17:57,800
لا، ثمّة شخص آخر يفعل ذلك

215
00:18:03,870 --> 00:18:04,970
من قد يكون؟

216
00:18:05,780 --> 00:18:06,390
ادخل

217
00:18:08,330 --> 00:18:09,940
المعذرة

218
00:18:20,690 --> 00:18:21,950
مِعداد؟

219
00:18:22,460 --> 00:18:23,520
ماذا تريد؟

220
00:18:26,140 --> 00:18:28,360
من دواعي سروري أن أتعرّف عليك

221
00:18:28,360 --> 00:18:30,500
اسمي كان لاهان

222
00:18:31,880 --> 00:18:37,300
هناك شخصان فقط باسم "لا" في البلاط
الخارجيّ: لاكان ولاهان

223
00:18:37,970 --> 00:18:40,960
إنّه اسم شرفيّ مُنِحَ تاريخيّاً
بواسطة العائلة الإمبراطوريّة

224
00:18:42,420 --> 00:18:46,070
عضو في عائلة لا. من المُؤكّد أنّك ابن
الاستراتيجيّ بالتبنّي

225
00:18:46,070 --> 00:18:47,160
ماذا تريد؟

226
00:18:48,440 --> 00:18:50,980
أردتُ أن أريك هذا

227
00:18:59,000 --> 00:19:00,080
...هذا

228
00:19:00,680 --> 00:19:02,240
ما رأيك؟

229
00:19:03,720 --> 00:19:05,660
دفتر مقبوضات للخزينة الوطنيّة

230
00:19:06,080 --> 00:19:10,280
أجل. طلب منّي أبي أن أدقّقه

231
00:19:10,280 --> 00:19:14,350
لم يتقبّل مسألة عدم معرفتنا
بالمصدر الّذي جاء منه الفيفا

232
00:19:14,760 --> 00:19:16,460
كيف أدّى ذلك إلى الخزينة الوطنيّة؟

233
00:19:16,910 --> 00:19:21,820
حدثَ ذلك بصورة طبيعيّة بعد التحرّي
عن المسؤولين المُعاقَبين مُؤخّراً

234
00:19:22,600 --> 00:19:28,160
،أردتُك أن تطّلع على الوثائق الرّسميّة
لكنّها طويلة بعض الشّيء

235
00:19:28,890 --> 00:19:31,630
لكن استخرجتُ نسخة مُختصرة
تحتوي على أبرز النّقاط

236
00:19:32,860 --> 00:19:37,190
ارتفع سعر الحبوب بشكل ملحوظ
على مدى السّنوات القليلة الماضية

237
00:19:37,190 --> 00:19:39,160
هذا مُثير للاهتمام، أليس كذلك؟

238
00:19:39,160 --> 00:19:41,930
لم نُواجه جفافاً ولا أوبئة حشرات

239
00:19:42,440 --> 00:19:46,660
وثمّة أمر آخر. لسبب ما، ارتفع
سعر الحديد كذلك

240
00:19:47,310 --> 00:19:49,990
مثل أسعار كافّة المعادن في البلد

241
00:19:52,270 --> 00:19:56,430
هل تُشيّد حكومتنا بناء ضخماً في مكان ما؟

242
00:19:56,850 --> 00:20:01,260
لم أعثر على أي مُخطّطات لمشروع
كهذا في الأماكن الّتي بحثتُ فيها

243
00:20:01,900 --> 00:20:05,040
إنّه يُشبه أباه بالتبنّي من حيث الدّهاء والفطنة

244
00:20:06,120 --> 00:20:07,760
أتفهّم ما تحاول قوله

245
00:20:08,300 --> 00:20:11,050
،سعر الحبوب ليس كبيراً بحدّ ذاته

246
00:20:11,050 --> 00:20:15,830
لكن نظراً لحجم التّجارة، فإنّ هذه الزّيادة
الضّئيلة في السّعر تتحوّل إلى فارق كبير

247
00:20:16,510 --> 00:20:19,530
أحدٌ ما يسرق هذا الفارق

248
00:20:20,100 --> 00:20:25,510
وأيضاً سعر المعادن يعني أنّ شخصاً
يشتري كمّيات كبيرة منها

249
00:20:26,460 --> 00:20:28,030
هذا ما تُشير إليه، صحيح؟

250
00:20:28,540 --> 00:20:34,380
أجل. حسبما أعتقد، كلاهما يؤدّيان
إلى النّتيجة ذاتها

251
00:20:34,380 --> 00:20:39,200
وقلّ من النّاس الّذين يستطيعون
القيام بشيء كهذا

252
00:20:41,660 --> 00:20:45,760
يمكنني التقصّي حول مزيد من التّفاصيل

253
00:20:47,100 --> 00:20:52,510
ألست مُتحمّساً لمعرفة العقل المُدبّر؟

254
00:21:00,100 --> 00:21:02,070
وماذا تريد بالمقابل؟

255
00:21:04,550 --> 00:21:07,850
مُحال أن تكون قد أحضرت لي هذا
دون طلب شيء بالمُقابل

256
00:21:07,850 --> 00:21:08,740
!مولايّ جينشي

257
00:21:10,880 --> 00:21:17,020
هل يمكنك أن تمنحنا خصماً
صغيراً على هذه الفاتورة؟

258
00:21:17,020 --> 00:21:17,830
ما هي؟

259
00:21:18,110 --> 00:21:22,270
إنّها فاتورة إصلاحات بوّابة القصر الخلفيّ
الّتي دمّرها أبي

260
00:21:23,460 --> 00:21:25,630
...ينبغي أن يحصد ما يزرع

261
00:21:26,010 --> 00:21:26,930
حسناً

262
00:21:26,930 --> 00:21:28,390
!متأكّد؟

263
00:21:31,110 --> 00:21:33,840
بالمقابل، أتوقّع منك أن تكون دقيقاً

264
00:21:33,840 --> 00:21:38,340
اكتشف ما الّذي يجري في وجهة
هذه الأموال والمعادن

265
00:21:42,710 --> 00:21:44,650
أمرك

266
00:21:46,650 --> 00:21:50,110
سأسخّر كافّة إمكانيّاتي

267
00:23:45,060 --> 00:24:00,000
الحلقة القادمة

268
00:23:56,660 --> 00:23:59,220
"الحلقة القادمة: "مهرجان