1
00:00:19,220 --> 00:00:20,840
.قل شيئًا

2
00:00:20,840 --> 00:00:24,690
.اعتذر! ابك واعتذر كما تفعل دائمًا

3
00:00:25,280 --> 00:00:27,030
!أسرع

4
00:00:27,030 --> 00:00:29,530
أيّها الوغد، هل تحسبني غبيًّا؟

5
00:00:29,530 --> 00:00:31,040
.انتظر مكانك فحسب

6
00:00:37,020 --> 00:00:38,870
!افتح الباب اللّعين! حالًا

7
00:00:39,620 --> 00:00:41,330
!افتح الباب واخرج إلى هنا

8
00:00:42,300 --> 00:00:45,170
.إن دخل، سأضطرّ لقتله

9
00:00:47,480 --> 00:00:49,800
سأقتلك عندما أراك المرّة القادمة، مفهوم؟

10
00:01:01,600 --> 00:01:03,060
.ما زال دافئًا

11
00:01:03,600 --> 00:01:05,800
.لم يمض على مقتله طويلًا

12
00:01:11,540 --> 00:01:12,910
.كيمبر بولتز

13
00:01:17,240 --> 00:01:22,250
.لن يستغرقوا طويلًا لاكتشاف الجثّة في هذه الحرارة

14
00:01:22,540 --> 00:01:26,420
وسيتمّ استدعائي كشاهد على الجريمة

15
00:01:26,420 --> 00:01:28,750
.ولن أستطيع الذّهاب في المهمّة غدًا

16
00:01:29,680 --> 00:01:32,740
،لن يستطيع رؤسائي إخراجي من أمر الاستدعاء

17
00:01:33,400 --> 00:01:34,430
.لذا لن أسأل حتّى

18
00:01:35,760 --> 00:01:39,320
.يمكنني الذّهاب في المهمّة إن أخفيتُ الجثّة

19
00:01:39,320 --> 00:01:44,230
.لا، إن فشلت المهمّة، لن أستطيع العودة إلى الشّرطة العسكريّة

20
00:01:44,560 --> 00:01:49,540
إلّم أكن هنا، فهناك احتمال أن
.يبحثوا عن هويّتي الحقيقيّة في التّحقيق

21
00:01:49,540 --> 00:01:51,490
.حتّى أنّ ذلك قد يعرّض الاثنين الآخرين للخطر

22
00:01:52,360 --> 00:01:53,820
.لا يمكنني أن أسمح بذلك

23
00:01:57,300 --> 00:02:02,460
.يجب أن أجد كارلي لكي أدّعي أنّني لم آتِ إلى هذا البيت قطّ

24
00:02:02,460 --> 00:02:07,340
.وبعد أن تُحلّ قضيّتها، سأبلّغ عن موت كيمبر من قبل مجهول

25
00:02:08,560 --> 00:02:10,380
.هذه الطّريقة الوحيدة

26
00:02:27,680 --> 00:02:29,070
ماذا تفعلين يا آني؟

27
00:02:29,340 --> 00:02:30,500
.لا يمكنك أن تتوقّفي الآن

28
00:02:30,500 --> 00:02:33,280
كيف تتوقّعين أن تفين بقدرك هكذا؟

29
00:02:33,740 --> 00:02:35,860
هل تنصتين أم لا يا آني؟

30
00:02:55,340 --> 00:02:56,760
،وفقًا للطّبيب

31
00:02:57,340 --> 00:03:00,680
.لن تشفى ساقي تمامًا أبدًا

32
00:03:07,520 --> 00:03:09,400
.أحسنت يا آني

33
00:03:10,040 --> 00:03:12,380
.أنا واثق أنّك ستصبحين أقوى فأقوى

34
00:03:21,940 --> 00:03:24,160
هل نام أخيرًا؟

35
00:03:27,260 --> 00:03:31,500
...أتساءل إن كان أحدهم قتل كيمبر واختطف كارلي

36
00:03:31,940 --> 00:03:33,260
.لا، هذا لا يمكن

37
00:03:33,260 --> 00:03:37,260
.في تلك الحالة، كان القاتل ليقفل الباب ليؤخّر اكتشاف الجثّة

38
00:03:37,980 --> 00:03:41,100
.لذا كان يسعى خلف الكودروين وليس كارلي

39
00:03:41,760 --> 00:03:43,300
.لا، هذا خاطئ أيضًا

40
00:03:43,300 --> 00:03:46,840
.لم يكن مخبّئًا جيّدًا أيضًا

41
00:03:46,840 --> 00:03:48,270
.كان ليجده بسهولة

42
00:03:49,520 --> 00:03:52,060
.الكودروين هو مخدّر الشّارع الجديد

43
00:03:52,440 --> 00:03:56,400
.إنّه باهظ، لكنّ تأثيره قويّ ومدمن للغاية

44
00:03:56,400 --> 00:03:58,570
،ظهر في العاصمة قبل عامين

45
00:03:59,140 --> 00:04:02,700
.وقد شقّ طريقه أخيرًا إلى شوارع ستوهيس

46
00:04:04,000 --> 00:04:06,750
.كانت هناك ثلاثة صناديق في غرفة كيمبر

47
00:04:07,820 --> 00:04:10,290
،إن كانا كيمبر وكارلي يتاجران به

48
00:04:10,940 --> 00:04:13,960
أين حصلا على هذه المؤونة الكاملة؟

49
00:04:14,380 --> 00:04:20,720
.على أيّ حال، أنا بحاجة لجعل ستراتمان يخبرني ما كانت تدرسه ابنته

50
00:04:21,820 --> 00:04:24,220
.ذلك دليلي الوحيد لمكانها

51
00:04:25,920 --> 00:04:26,980
.شكرًا على الانتظار

52
00:04:26,980 --> 00:04:27,940
.نعم

53
00:04:32,380 --> 00:04:34,100
.قلّني إلى قصر ستراتمان

54
00:04:38,720 --> 00:04:42,200
.لا تتحرّكي. لا أنوي قتلك هنا

55
00:04:43,340 --> 00:04:45,620
.لا تدفعيني لفعل شيء قبيح

56
00:04:47,320 --> 00:04:51,740
.كان يرتدي بذلة باهظة ويملك عينًا مزيّفة

57
00:04:51,740 --> 00:04:55,340
.كانت تلك العين حمراء بالكامل. ستتعرّفين عليه في طرفة عين

58
00:04:58,120 --> 00:04:59,100
.أنت

59
00:05:05,500 --> 00:05:07,970
.مذهل، هذه غنيمة كبيرة

60
00:05:08,400 --> 00:05:09,220
.يا زعيم

61
00:05:19,440 --> 00:05:23,070
.أرى أنّك تأخذين عملك محمل الجدّ

62
00:05:23,900 --> 00:05:26,320
إلى أين نحن متّجهون؟

63
00:05:26,320 --> 00:05:28,080
.المنطقة الصّناعيّة

64
00:05:28,080 --> 00:05:33,340
.ينتهي المطاف بكلّ الأشياء في قاع مياه الصّرف الصّناعيّ

65
00:05:33,340 --> 00:05:36,840
.وكلّ ما يغرق في تلك المياه يصبح جزءًا من الوحل

66
00:05:37,460 --> 00:05:40,630
أرى أنّك أوقعت دماغك هناك في مرحلة ما؟

67
00:05:44,640 --> 00:05:46,640
!لا تقدمي على أيّ شيء تندمين عليه يا آنسة

68
00:05:47,020 --> 00:05:49,810
.لو، لا تكن همجيًّا

69
00:05:53,560 --> 00:05:57,310
.أغضبتكما إذًا

70
00:05:57,780 --> 00:05:59,540
،لسنا غاضبين

71
00:05:59,540 --> 00:06:03,820
.لكنّك تدخّلت في عملنا

72
00:06:04,560 --> 00:06:09,330
كنت أبحث عن كارلي ستراتمان، لكن
.أفترض أنّكما تعرفان أين هي بالفعل

73
00:06:09,330 --> 00:06:11,520
.ربّما تقاطعت سبلنا من قبل

74
00:06:12,160 --> 00:06:16,260
.إن كنتُ لا أستطيع البحث عنها، فسيحاول أحد آخر إنهاء المهمّة

75
00:06:16,260 --> 00:06:17,880
.لا داعي للكذب

76
00:06:19,080 --> 00:06:21,240
أخبرنا ستراتمان عنك بالفعل

77
00:06:21,240 --> 00:06:24,240
.وكيف أنّك تعملين لوحدك

78
00:06:24,240 --> 00:06:25,660
،في ذلك الوقت، أجل

79
00:06:25,660 --> 00:06:28,560
.لكنّني تواصلت مع رؤسائي بعد ذلك بفترة وجيزة

80
00:06:28,560 --> 00:06:31,140
.ستتّخذ الشّرطة العسكريّة التّدابير إن اختفيت

81
00:06:31,400 --> 00:06:34,390
.واثق أنّك وجدت جثّة كيمبر بالفعل

82
00:06:35,160 --> 00:06:37,920
.لكنّك أمضيت وقتًا طويلًا في غرفته

83
00:06:37,920 --> 00:06:41,560
،لكنّك طلبت من سائق العربة أن يقلّك إلى بيت ستراتمان

84
00:06:41,560 --> 00:06:43,400
.لا الشّرطة العسكريّة

85
00:06:43,800 --> 00:06:48,400
.لا بدّ أنّك تملكين سببًا لإخفاء مثل ذلك الاكتشاف عن رؤساءك

86
00:06:48,400 --> 00:06:50,910
.أخبريني إن كنتُ على خطأ

87
00:06:51,960 --> 00:06:54,560
هل قتلتما كيمبر؟

88
00:06:54,560 --> 00:06:57,420
.ما كنّا لنقدم على فعل بذيء كذاك

89
00:06:57,880 --> 00:07:01,670
.كان متهوّرًا أكثر من اللّازم فحسب

90
00:07:01,670 --> 00:07:05,670
.وصل إلى مرحلة حيث أصبحت مسألة وقت فقط قبل أن يقتله أحد

91
00:07:07,420 --> 00:07:11,020
.قبل أن نصل إلى محطّة المياه، أملك طلبًا

92
00:07:11,020 --> 00:07:11,930
.بادري

93
00:07:12,800 --> 00:07:16,760
هلّا جعلت السّيّد الّذي بجانبي يرجع لي الخاتم الّذي أخذ؟

94
00:07:16,760 --> 00:07:18,270
.مستحيل

95
00:07:19,020 --> 00:07:20,640
.صمتًا يا لو

96
00:07:21,500 --> 00:07:22,270
الخاتم؟

97
00:07:22,820 --> 00:07:26,460
.أعطاني إيّاه والدي عندما تركتُ موطني

98
00:07:26,460 --> 00:07:29,780
.سأكون قادرة على أن أرقد بسلام إن كان معي

99
00:07:34,140 --> 00:07:36,140
.سلّمه يا لو

100
00:07:36,140 --> 00:07:37,410
!مستحيل يا والد

101
00:07:37,880 --> 00:07:39,060
.سلّمه

102
00:07:41,480 --> 00:07:42,600
!حسنًا

103
00:07:42,600 --> 00:07:43,920
.لا

104
00:07:46,240 --> 00:07:47,170
.لي

105
00:07:55,280 --> 00:07:56,600
عجبًا، ما ذلك؟

106
00:07:56,940 --> 00:07:59,720
أهناك سمّ من نوع ما هنا؟

107
00:07:59,720 --> 00:08:01,420
ما رأيك أن تجرّبه وترى؟

108
00:08:05,060 --> 00:08:05,650
،لا

109
00:08:06,280 --> 00:08:07,500
.من الأفضل ألّا أفعل

110
00:08:07,500 --> 00:08:09,300
.أنت هادئة للغاية

111
00:08:09,300 --> 00:08:12,780
.إن كان مسمومًا بالفعل، ما كنت لتستفزّيني هكذا

112
00:08:12,780 --> 00:08:15,160
.إلّا إن كان لديك دافع خفيّ

113
00:08:16,980 --> 00:08:19,920
أتظنّين أنّنا غبيّان ما يكفي لتنطلي علينا حيلة كهذه؟

114
00:08:20,860 --> 00:08:21,380
.أجل

115
00:08:25,100 --> 00:08:27,040
!أيّتها الحقيرة

116
00:08:31,800 --> 00:08:33,050
.يا لك من غبيّ

117
00:09:18,920 --> 00:09:21,310
أين هي كارلي ستراتمان؟

118
00:09:24,660 --> 00:09:26,940
.أنت كعملاق

119
00:09:26,940 --> 00:09:30,300
.تظهرين من العدم وتفسدين كلّ شيء

120
00:09:33,340 --> 00:09:34,120
—إنّ كارلي

121
00:09:43,660 --> 00:09:46,180
هل أخفيت قنبلة ما هناك؟

122
00:09:46,180 --> 00:09:48,340
يا زعيم، أما زلت تستطيع الوقوف؟

123
00:09:48,340 --> 00:09:49,820
.سأتدبّر أمري

124
00:09:49,820 --> 00:09:51,970
.هذا ليس جيّدًا

125
00:09:53,260 --> 00:09:55,090
.النّوم أفضل لك الآن

126
00:09:58,920 --> 00:10:02,300
إذًا أنت من قتل كيمبر؟

127
00:10:02,300 --> 00:10:04,040
.لا أدري عمّ تتحدّث

128
00:10:17,360 --> 00:10:18,720
ما زلت حيًّا، أليس كذلك؟

129
00:10:22,740 --> 00:10:24,750
أين هي كارلي؟

130
00:10:30,500 --> 00:10:34,260
.‏197 طريق بانغالتر

131
00:10:34,720 --> 00:10:36,880
من تكونون؟

132
00:10:36,880 --> 00:10:39,240
.نحن ما تدعينه بحلّالي المشاكل

133
00:10:39,240 --> 00:10:44,780
.قبل بضعة أيّام، قام ستراتمان بتعييننا للبحث عن ابنته

134
00:10:44,780 --> 00:10:48,660
.لم نستغرق طويلًا لتعقّب كيمبر

135
00:10:48,660 --> 00:10:57,200
.قال أنّه سيفشي أسرار كارلي ومكان اختبائها إن ساعدناه في عمل ما

136
00:10:58,040 --> 00:10:59,940
أيّ عمل؟

137
00:10:59,940 --> 00:11:01,030
.ابتزاز

138
00:11:01,760 --> 00:11:05,200
طلب منّا ابتزاز ستراتمان بأسرار ابنته

139
00:11:05,200 --> 00:11:08,500
.ونستخلص منه أكبر قدر ممكن من المال

140
00:11:08,500 --> 00:11:10,040
.فوافقنا

141
00:11:10,780 --> 00:11:15,300
.ما كان علينا سوى أن نخفي الفتاة ونجمع المال بعد يومين

142
00:11:15,940 --> 00:11:19,550
.حينها سنستطيع غسل أيدينا من هذه الفوضى

143
00:11:20,460 --> 00:11:23,080
،لو أنّ الأمور سارت بسلاسة قليلًا بعدها فقط

144
00:11:23,800 --> 00:11:26,020
.لنجحنا في ذلك

145
00:11:27,820 --> 00:11:30,140
.كان الأمر سيّان قبل خمس سنوات

146
00:11:32,500 --> 00:11:36,240
،لو أنّ ذلك الهجوم حدث بعد يوم واحد فقط

147
00:11:36,240 --> 00:11:39,030
.كنتُ أنا وابني لنكون في هذه المدينة بدلًا من ذلك

148
00:11:39,740 --> 00:11:41,760
.الأمر هكذا دائمًا

149
00:11:41,760 --> 00:11:45,000
.فقط عندما يكون الهدف في المتناول، يحدث خطب ما

150
00:11:45,000 --> 00:11:46,940
.وتفقد كلّ شيء

151
00:11:48,520 --> 00:11:51,780
.هكذا حالي

152
00:12:13,360 --> 00:12:17,280
إنّه يوم جميل ورائع، أليس كذلك؟

153
00:12:21,240 --> 00:12:24,030
،إيدا، أبي

154
00:12:25,520 --> 00:12:27,180
.لقد عدت

155
00:12:33,600 --> 00:12:34,540
!أنت

156
00:12:36,580 --> 00:12:38,180
!ا-اقتلها

157
00:12:39,120 --> 00:12:40,300
!فلتموتي أيّتها الحقيرة

158
00:12:47,420 --> 00:12:48,980
!سحقًا

159
00:13:05,400 --> 00:13:07,120
هل كارلي هنا؟

160
00:13:08,800 --> 00:13:11,000
.لم أكن هنا أبدًا

161
00:13:11,000 --> 00:13:13,460
.ولم ألتق بك أو بوالد

162
00:13:13,460 --> 00:13:15,130
مفهوم؟

163
00:13:15,940 --> 00:13:21,060
...إن اكتشفت أنّك همست باسمي لجرذ

164
00:13:24,100 --> 00:13:24,890
!بووم

165
00:13:34,540 --> 00:13:35,620
هل انتهى الأمر؟

166
00:13:37,720 --> 00:13:39,980
أفترض أنّك كارلي ستراتمان؟

167
00:13:39,980 --> 00:13:41,740
.أبوك ينتظرك

168
00:13:42,180 --> 00:13:43,740
.لنعدك إلى البيت

169
00:13:47,780 --> 00:13:50,940
ما رأيك أن نجلس ونتشارك شرابًا أوّلًا؟

170
00:14:03,740 --> 00:14:06,360
...فهمت، مات

171
00:14:06,360 --> 00:14:08,020
.يا لكيمبر المسكين

172
00:14:08,680 --> 00:14:12,000
ما هذا السّرّ الّذي كنت تخفينه عن أبيك؟

173
00:14:13,000 --> 00:14:14,600
.السّرّ لصنع الكودروين

174
00:14:15,440 --> 00:14:18,040
أنت من يصنعه؟

175
00:14:18,040 --> 00:14:20,320
.ذلك سهل للغاية في الواقع

176
00:14:20,320 --> 00:14:24,320
.استخدمنا نفس نوع المسكّنات الّتي تُزوّدُ بها الشّرطة العسكريّة

177
00:14:25,120 --> 00:14:27,520
.كان كيمبر مجرّد تاجر

178
00:14:27,520 --> 00:14:28,830
.بابا هو المسؤول

179
00:14:29,520 --> 00:14:31,120
ستارتمان-سان؟

180
00:14:31,120 --> 00:14:35,580
.لكن سمعت أنّ الكودروين مخدّر جديد من العاصمة

181
00:14:36,060 --> 00:14:37,620
.بالطّبع سمعت ذلك

182
00:14:37,620 --> 00:14:42,340
،عندما بدأتُ في صناعة الكودروين
.جعلته يعدني بألّا يبيعه في هذه البلدة

183
00:14:43,540 --> 00:14:46,590
.لكنّ أباك نكث بذلك الوعد

184
00:14:47,200 --> 00:14:50,920
.لهذا غضبت بعد رؤيتك للكودروين في الحانة

185
00:14:54,260 --> 00:14:57,020
.كنت أخطّط لترك هذه المدينة رفقة كيمبر

186
00:14:57,480 --> 00:15:02,820
.لكنّه لم يرد بدأ حياة جديدة فقيرة في مكان غير معتاد معي

187
00:15:03,700 --> 00:15:05,900
.حينها ظهر ذلكما الاثنان

188
00:15:06,660 --> 00:15:09,660
،لكن إن كان ما قلته صحيحًا

189
00:15:09,660 --> 00:15:11,700
.لا بدّ أنّ لو خان كليهما

190
00:15:12,460 --> 00:15:14,540
.كيمبر الغبيّ

191
00:15:15,280 --> 00:15:18,660
اسمعي، هلّا أسديتني معروفًا وادّعيت أنّك لم تقابليني قطّ؟

192
00:15:20,200 --> 00:15:22,500
لمَ بدأت في صنع الكودروين؟

193
00:15:24,480 --> 00:15:27,240
.خسر بابا كلّ شيء قبل خمس سنوات

194
00:15:28,720 --> 00:15:31,140
.أراد استرجاع ما خسر فحسب

195
00:15:38,720 --> 00:15:40,980
!كارلي، بربّك، ارقصي معي

196
00:15:41,280 --> 00:15:43,480
.أتساءل إن كانت فكرة جيّدة

197
00:15:46,000 --> 00:15:48,500
.آسفة يا فتيان، طرأ شيء ما

198
00:15:55,060 --> 00:15:56,120
.شكرًا على الانتظار

199
00:15:58,560 --> 00:15:59,420
.جرّبي هذا

200
00:15:59,860 --> 00:16:01,200
.إنّه لذيذ

201
00:16:01,200 --> 00:16:02,340
ما هو؟

202
00:16:02,340 --> 00:16:03,460
.دونوت

203
00:16:04,320 --> 00:16:05,940
.لم أتناول واحدًا قطّ

204
00:16:10,380 --> 00:16:11,340
.وهذا أيضًا

205
00:16:15,820 --> 00:16:18,480
.أظنّني سأودّع هذه المدينة

206
00:16:18,480 --> 00:16:20,720
.لست مضطرّة للرّحيل

207
00:16:20,720 --> 00:16:23,520
.ما عليك سوى أن تتوقّفي عن صنع الكودروين

208
00:16:23,840 --> 00:16:26,400
...أودّ ذلك، ولكن

209
00:16:26,400 --> 00:16:29,800
.إن بقيت هنا مع بابا، سأرغب في مساعدته ثانيةً

210
00:16:32,040 --> 00:16:35,540
.كما هو موعود، إليك إذنًا بالرّحيل إلى سور روز

211
00:16:36,260 --> 00:16:38,100
.لكن بإمكانك تمزيقه إن أردت

212
00:16:40,540 --> 00:16:41,920
.شكرًا

213
00:16:42,440 --> 00:16:43,920
.لكنّي سأذهب

214
00:16:45,320 --> 00:16:46,920
.تروّي أنت أيضًا

215
00:16:47,600 --> 00:16:52,430
.أودّ ذلك، لكن هناك أمر آخر عليّ فعله

216
00:16:56,680 --> 00:16:58,500
.الرّائحة جميلة هنا

217
00:16:58,500 --> 00:17:01,300
أذلك نوع نادر من التّبغ؟

218
00:17:01,300 --> 00:17:02,820
.أنت حذقة

219
00:17:02,820 --> 00:17:06,530
.كان يُصنع قرب سور ماريا

220
00:17:06,900 --> 00:17:09,780
.وأنا الشّخص الوحيد غالبًا الّذي يستطيع التكّفل بسعره الآن

221
00:17:10,040 --> 00:17:12,660
.خسرت كلّ شيء جيّد حدث لي

222
00:17:14,260 --> 00:17:17,080
قتلت كيمبر بولتز، أليس كذلك؟

223
00:17:18,260 --> 00:17:21,080
ما هذا الهراء؟ لمَ فكّرت ذلك؟

224
00:17:21,520 --> 00:17:27,090
.في هذا الصّباح، عندما كنّا نتحدّث، سلّم لك كبير خدمك رسالةً

225
00:17:27,600 --> 00:17:29,920
.كانت من كيمبر

226
00:17:30,340 --> 00:17:31,680
هل أنا مخطئة؟

227
00:17:32,940 --> 00:17:38,580
.كان يراقبك ورآني أدخل المبنى

228
00:17:38,580 --> 00:17:41,270
،عندما رأى أنّ الشّرطة العسكريّة معنيّة بالأمر

229
00:17:41,270 --> 00:17:44,150
.قرّر تسريع خططه

230
00:17:44,900 --> 00:17:46,860
.سأعيد لك ابنتك على الفور"

231
00:17:46,860 --> 00:17:48,440
".أحضر المال إلى مسكني

232
00:17:49,120 --> 00:17:51,440
.ينبغي أن يكون ذلك ما ذُكر في الرّسالة

233
00:17:52,320 --> 00:17:55,700
،عندما قرأتها، ذهبت لرؤية كيمبر

234
00:17:55,700 --> 00:17:58,580
.حيث تشاركتما شرابًا ومحادثة

235
00:17:59,080 --> 00:18:03,790
.لكنّ خطبًا ما حدث وقتلته

236
00:18:05,540 --> 00:18:07,780
.هذه قصّة مثيرة للاهتمام

237
00:18:09,680 --> 00:18:12,560
.وجدت هذه في منفضة السّجائر في شقّة كيمبر

238
00:18:14,520 --> 00:18:16,800
أنت الوحيد الّذي يستطيع تحمّل سعر هذه، صحيح؟

239
00:18:17,240 --> 00:18:20,860
،إن شنّت الشّرطة العسكريّة تحقيقًا شاملًا

240
00:18:20,860 --> 00:18:23,360
.أظنّ أنّ النّتيجة واضحة

241
00:18:28,940 --> 00:18:30,900
.كان حادثًا

242
00:18:30,900 --> 00:18:35,240
.لم يكن ذلك الحثالة ينوي إعادة ابنتي لي

243
00:18:35,740 --> 00:18:39,080
.أراد جعلي أثمل فحسب لكي يسرق مالي

244
00:18:39,080 --> 00:18:41,410
.هذا لا يهمّ بالنّسبة لي

245
00:18:41,780 --> 00:18:45,170
في الواقع، هلّا توقّفت عن التّدخين؟

246
00:18:47,140 --> 00:18:50,920
.لا أنوي تلقّي الأوامر منك

247
00:18:51,240 --> 00:18:53,700
.هذا بيتي

248
00:18:53,700 --> 00:18:58,680
.تعاملتُ مع رائحة التّبغ والكحول طوال اليوم

249
00:19:00,020 --> 00:19:02,520
.سئمت منها

250
00:19:05,000 --> 00:19:07,440
ما الّذي أربكك هكذا؟

251
00:19:07,700 --> 00:19:09,960
.لستُ مربكة

252
00:19:09,960 --> 00:19:12,320
.أنا متعبة فحسب

253
00:19:12,320 --> 00:19:14,190
.أريد الانتهاء من هذا بسرعة

254
00:19:14,580 --> 00:19:15,940
.هذا كلّ شيء

255
00:19:16,580 --> 00:19:20,940
.يا للحسرة. أشكّ أنّ التّبغ لن يكون جيّدًا هكذا في السّجن

256
00:19:21,880 --> 00:19:23,500
.لن تذهب للسّجن

257
00:19:33,960 --> 00:19:36,000
لمَ تساعدينني؟

258
00:19:36,000 --> 00:19:37,760
.لست أساعدك

259
00:19:38,360 --> 00:19:40,200
.أفعل هذا من أجل نفسي

260
00:19:41,500 --> 00:19:44,220
.هناك ما أحتاج إلى فعله

261
00:19:44,220 --> 00:19:47,860
.وسأنجزه مهما كان الثّمن

262
00:19:52,380 --> 00:19:55,940
.لك أن تأتي للزّيارتي متى شئت

263
00:19:56,440 --> 00:19:58,620
.سأعدّ بعض الطّعام الجيّد لك

264
00:19:58,620 --> 00:20:00,200
.شكرًا

265
00:20:00,540 --> 00:20:04,420
.لكنّي قد لا أطوّل في هذه المدينة

266
00:20:04,420 --> 00:20:06,160
هل تنوين السّفر؟

267
00:20:08,300 --> 00:20:11,290
.قد أعود إلى موطني قريبًا

268
00:20:12,500 --> 00:20:15,200
وماذا ستفعلين إن كان العدوّ يفوقك عددًا؟

269
00:20:15,200 --> 00:20:18,520
.سأتخلّص من الأقوى بينهم أوّلًا لأضعف إرادتهم في القتال

270
00:20:18,520 --> 00:20:21,140
.صحيح. أنت تبلين جيّدًا يا آني

271
00:20:22,540 --> 00:20:27,270
.يجب أن تقومي بما يقع على عاتقك، مهما كان الثّمن

272
00:20:27,720 --> 00:20:30,780
.عليك أن تستغلّي كلّ ما لديك لتحقيق أهدافك

273
00:20:30,780 --> 00:20:32,040
مفهوم يا آني؟

274
00:20:38,940 --> 00:20:40,660
:تقرير الاستطلاع"

275
00:20:41,100 --> 00:20:48,830
يُعتقد أنّ كارلي ستراتمان المفقودة وحبيبها
.كيمبر بولتز غادرا إلى العاصمة قبل ثلاثة أيّام

276
00:20:49,240 --> 00:20:52,800
،بعد مزيد من التّحقيق

277
00:20:52,800 --> 00:20:56,300
من المرجّح أنّ الاثنين كانا يستخدمان
.جوازَي سفر زائفان واسمين زائفين

278
00:20:57,400 --> 00:21:05,000
،ما زال اسماهما المزيّفان غير معلومين
.وكذلك من زوّر جوازَي سفرهما

279
00:21:05,720 --> 00:21:09,160
".من المرجّح أنّ المزيد من التّحقيق سيكون بلا فائدة

280
00:21:17,080 --> 00:21:21,280
لم تذهبي للبحث عن تلك الفتاة الهاربة حقًّا، أليس كذلك؟"

281
00:21:21,680 --> 00:21:24,120
.حسنًا، لا أهتمّ في كلتا الأحوال

282
00:21:24,120 --> 00:21:28,320
،على أيّ حال، إن كنت ستذهبين في موعد، جرّبي ارتداء هذا

283
00:21:29,340 --> 00:21:32,290
.طريقة لبسك غير ظريفة لدرجة تدفعني للبكاء

284
00:21:32,290 --> 00:21:33,780
.من طرف هيتش دريس

285
00:21:40,980 --> 00:21:42,050
،آني

286
00:21:42,960 --> 00:21:44,620
.كنت مخطئًا طوال هذا الوقت

287
00:21:45,350 --> 00:21:47,900
.لن أطلب منك مسامحتي

288
00:21:48,940 --> 00:21:53,100
.لكن عديني بشيء واحد رجاءً

289
00:21:54,260 --> 00:22:01,610
،حتّى إن نبذك العالم بأسره وكرهك

290
00:22:02,180 --> 00:22:05,110
.سيكون والدك بجانبك دائمًا

291
00:22:05,460 --> 00:22:07,620
لذا، عديني

292
00:22:09,440 --> 00:22:11,260
.أنّك ستعودين

293
00:22:17,660 --> 00:22:22,170
،مهمّة اليوم، البعثة الاستطلاعيّة الـ57 خلف الأسوار

294
00:22:23,460 --> 00:22:26,050
.ستنتهي بالقبض على إرين ييغر