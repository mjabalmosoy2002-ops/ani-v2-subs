1
00:01:30,030 --> 00:01:39,510
هذه حكاية تدوم 10 أيّام لآيدولز مُكافحات
يصارعن لملء صالة حفل غنائي تتّسع لمئة مقعد

2
00:01:39,930 --> 00:01:41,350
نعسانة جداً

3
00:01:43,200 --> 00:01:45,660
حسناً؟ هل تلقّينا أي تعليقات؟

4
00:01:45,660 --> 00:01:47,280
انتظر لحظة

5
00:01:48,250 --> 00:01:49,680
ماذا؟

6
00:01:50,040 --> 00:01:54,100
تعليقات؟ يقصد على حساب التويتر الرّسمي الخاص بنا؟

7
00:01:54,100 --> 00:01:56,280
أجل. غرّدنا قبل أيّام، أتذكرين؟

8
00:01:56,280 --> 00:01:59,530
سألنا عمّا يريده النّاس كهديّة خاصّة
مقابل شراء تذاكر الحفل الغنائي

9
00:01:59,530 --> 00:02:03,070
نستخدم الهدايا كطعم لبيع التّذاكر

10
00:02:04,060 --> 00:02:09,010
لكن لسبب ما، هذا لا يُظهر لي التّعليقات
التي كتبها النّاس

11
00:02:09,240 --> 00:02:11,480
ماذا؟ هل هذا ممكن؟

12
00:02:11,480 --> 00:02:12,250
هل السّبب هو الواي فاي؟

13
00:02:12,250 --> 00:02:13,010
دعيني أرى

14
00:02:17,750 --> 00:02:19,250
...في الواقع يا آمي

15
00:02:19,610 --> 00:02:23,630
.المشكلة ليست أنّ التّعليقات لا تظهر
بل لا يوجد تعليقات في الأساس

16
00:02:24,140 --> 00:02:25,950
لم يترك أحدٌ تعليق

17
00:02:26,360 --> 00:02:29,290
تجاهلنا العالم بأسره

18
00:02:30,920 --> 00:02:32,410
حقّاً؟

19
00:02:36,180 --> 00:02:38,900
نحن نتكلّم مع أنفسنا فحسب إذاً

20
00:02:38,900 --> 00:02:40,420
هذا ما يعنيه إذاً، أجل

21
00:02:42,060 --> 00:02:45,780
إذاً، سيترتّب علينا التفيكر بهديّة بأنفسنا

22
00:02:50,180 --> 00:02:51,870
!لديّ فكرة

23
00:02:51,870 --> 00:02:53,030
تفضّلي يا آينا

24
00:02:53,430 --> 00:02:55,290
ما رأيكم بتذاكر لحدث استقبال وترحيب؟

25
00:02:55,290 --> 00:02:59,060
ماذا؟ هل سيوفّر لنا ذلك مُعجبين جدُد؟

26
00:02:59,060 --> 00:03:03,500
أعتقد أنّ ما يحفّز جشع النّاس سينجح أكثر

27
00:03:05,190 --> 00:03:06,780
...جشع

28
00:03:08,900 --> 00:03:13,930
ماذا عن هديّة رأس السنة الجديدة؟
رأيتُ ذلك مؤخراً كثيراً

29
00:03:14,940 --> 00:03:18,860
مثل يانصيب على جائزة نقديّة للأشخاص
الذين يحضرون الحفل؟

30
00:03:18,860 --> 00:03:19,350
أجل

31
00:03:19,350 --> 00:03:22,160
!أجل، قد ينجح ذلك! وهو بمثابة روك أند رول

32
00:03:22,540 --> 00:03:25,610
أنا واثقة أنّ جائزة 50.000 ين ستكفي لجذب النّاس

33
00:03:25,610 --> 00:03:28,790
فكرة سديدة. يمكننا أن نعطيهم إيّاها
على شكل خمسين ورقة بقيمة 1.000 ين

34
00:03:28,790 --> 00:03:30,510
!فكرة ممتازة

35
00:03:30,510 --> 00:03:31,650
!مرحى

36
00:03:31,650 --> 00:03:32,740
!نعم

37
00:03:33,560 --> 00:03:34,890
!مرحى

38
00:03:36,310 --> 00:03:40,660
حسناً، من سيدفع الخمسين ورقة من فئة 1.000 ين؟

39
00:03:40,660 --> 00:03:43,120
سنتقاسمها، صحيح؟

40
00:03:43,120 --> 00:03:46,320
...إذا تقاسمناها، تدفع كلّ فتاة 10.000

41
00:03:45,620 --> 00:03:46,770
أينا

42
00:03:48,350 --> 00:03:55,280
أعتقد من المحرج الاعتماد على جشع النّاس

43
00:03:55,440 --> 00:03:57,290
—ماذا؟ لكن ألم تقولي قبل قليل

44
00:03:57,290 --> 00:04:01,760
أينا، لا أعتقد أنّ هذا روك أند رول

45
00:04:01,760 --> 00:04:02,680
—ماذا؟ لكن قلتِ

46
00:04:02,680 --> 00:04:07,830
أينا، لستُ مستعدّة لدفع رشوة بغيضة للناس

47
00:04:13,730 --> 00:04:14,940
معك حقّ

48
00:04:17,490 --> 00:04:18,380
آسفة

49
00:04:27,040 --> 00:04:29,130
...ا-المعذرة

50
00:04:30,380 --> 00:04:34,520
ما رأيكن إذاً بإدراج أسطوانة مُنتجة ذاتياً لأغنية جديدة؟

51
00:04:38,640 --> 00:04:43,530
أشكّ في أنّ الناس الذي يحفّزهم الجشع
سيبقون معنا على أي حال

52
00:04:44,010 --> 00:04:48,100
والأهمّ، أعتقد أنّ الناس سيكونون أسعد

53
00:04:48,100 --> 00:04:51,220
إذا تلقّوا شيئاً كرّسنا قلوبنا فيه

54
00:04:54,120 --> 00:04:59,240
لكن ماذا نفعل بشأن الأغنية؟ المُؤلّفون
لا يقبلون بأسعار رخيصة

55
00:05:00,820 --> 00:05:01,670
حسناً

56
00:05:03,210 --> 00:05:05,920
سألحّن الموسيقى بنفسي

57
00:05:06,480 --> 00:05:07,630
آمي

58
00:05:07,630 --> 00:05:08,430
حسناً

59
00:05:10,060 --> 00:05:11,610
سأؤلّف كلمات الأغنية

60
00:05:12,160 --> 00:05:13,380
روكا

61
00:05:13,380 --> 00:05:14,200
حسناً

62
00:05:15,490 --> 00:05:17,280
سأتولّى هندسة الرّقص

63
00:05:17,670 --> 00:05:18,990
شيوري

64
00:05:20,240 --> 00:05:21,150
!حسناً

65
00:05:23,340 --> 00:05:24,510
...سوف

66
00:05:25,600 --> 00:05:26,650
!أبذل قصارى جهدي...

67
00:05:27,140 --> 00:05:28,700
من فضلك

68
00:05:30,640 --> 00:05:33,650
بعد ساعة

69
00:05:38,020 --> 00:05:45,790
حياة
شاقّة

70
00:05:38,020 --> 00:05:45,790
كلمات الأغنية: روكا

71
00:05:38,020 --> 00:05:45,790
الموسيقى: آمي

72
00:05:43,390 --> 00:05:45,310
...واحد، اثنان، ثلاثة

73
00:05:45,790 --> 00:05:49,530
بسكويت تشينسوكو
على الغداء كذلك

74
00:05:49,530 --> 00:05:57,240
إنّها حياة صعبة وشاقّة
حياة صعبة وشاقّة

75
00:05:57,240 --> 00:06:01,270
،ظننتُها حزاماً
لكن تبيّن أنّها ثعبان

76
00:06:01,270 --> 00:06:08,410
إنّها حياة صعبة وشاقّة
حياة صعبة وشاقّة

77
00:06:08,410 --> 00:06:12,450
لكمتني ابنة عمّي
بلا سبب

78
00:06:12,450 --> 00:06:18,920
إنّها حياة صعبة وشاقّة
حياة صعبة وشاقّة

79
00:06:26,640 --> 00:06:27,730
...هديّتنا الخاصّة هي

80
00:06:28,530 --> 00:06:30,110
!أسطوانة لهذه الأغنية...

81
00:06:30,100 --> 00:06:34,340
‏‏‏83

82
00:06:30,100 --> 00:06:34,340
تذكرة متبقّية متاحة للبيع