1
00:00:00,400 --> 00:00:04,980
إذًا هذه هي الأراضي الملعونة وبحر
الأشجار الملعون الّذي يصدّ الحياة؟

2
00:00:05,420 --> 00:00:06,280
.لنذهب

3
00:00:06,280 --> 00:00:07,060
.حاضر

4
00:00:11,330 --> 00:00:12,880
فتاة يافعة؟

5
00:00:12,880 --> 00:00:14,860
!توقّفي مكانك أيّتها الفتاة

6
00:00:14,860 --> 00:00:16,370
!من تكونين؟

7
00:00:17,840 --> 00:00:21,120
.أنا إلف مظلمة هربت إلى هذه الغابة للنّجاة

8
00:00:21,670 --> 00:00:23,810
.يتعلّق شأننا بهذه الغابة

9
00:00:23,810 --> 00:00:25,610
سندخلها، ولن تمانعون ذلك، صحيح؟

10
00:00:25,610 --> 00:00:26,630
.لا أنصحكم بذلك

11
00:00:26,630 --> 00:00:28,460
.أرجو منكم الامتناع عن ذلك

12
00:00:32,910 --> 00:00:33,800
.سنغادر

13
00:00:35,330 --> 00:00:36,650
!ما الّذي تفعله؟

14
00:00:36,650 --> 00:00:38,680
.قالت أنّهم يريدون أن يعيشوا بسلام فحسب

15
00:00:39,000 --> 00:00:40,840
.لذلك لا مشكلة هنا

16
00:00:41,720 --> 00:00:44,850
.لا توجد مشكلة هنا
.تلك هي نتيجة تحقيقنا

17
00:00:46,240 --> 00:00:49,020
!سأتولّى القيادة من الآن فصاعدًا

18
00:00:50,450 --> 00:00:53,340
سندخل الآن الأراضي الملعونة
!ونُجري تحقيقنا

19
00:00:53,340 --> 00:00:55,440
!علينا الكشف عن حقيقة هذه الكارثة

20
00:00:56,080 --> 00:00:57,200
.كما تقول يا رجل

21
00:00:57,610 --> 00:00:58,660
!توقّف يا بارغو

22
00:01:03,380 --> 00:01:05,000
.يبدو أنّ الحوار قد فشل

23
00:01:06,820 --> 00:01:08,420
ما الّذي حدث؟

24
00:01:08,420 --> 00:01:09,530
!إنّها مشعوذة

25
00:01:09,530 --> 00:01:10,750
!عثرنا على مشعوذة لعينة

26
00:01:11,860 --> 00:01:15,300
.كان كلّ شيء يسير على ما يرام أيضًا

27
00:01:16,520 --> 00:01:20,000
الحياة ليست شيئًا يسير دائمًا
على ما يُرام، أليس كذلك؟

28
00:01:25,560 --> 00:01:27,280
.ذلك صحيح تمامًا

29
00:03:06,190 --> 00:03:07,040
!بارغو

30
00:03:07,460 --> 00:03:09,710
لا يهمّني مَن يفعلها، فقط
!أرسلوا مبعوثًا إلى الوطن

31
00:03:10,090 --> 00:03:11,790
!يجب أن يعلموا بما حدث

32
00:03:11,790 --> 00:03:14,090
.آسف يا رجل

33
00:03:14,090 --> 00:03:16,770
.لقد قضت عليهم جميعًا بذلك الهجوم

34
00:03:18,180 --> 00:03:21,470
.هيّا، أنا الوحش الّذي كنتم تبحثون عنه

35
00:03:21,770 --> 00:03:25,180
.حلّت عليكم الكارثة الّتي كنتم تتحرّون أمرها

36
00:03:27,850 --> 00:03:29,230
!سيّد فيردل

37
00:03:29,520 --> 00:03:31,270
!لا تفقد أعصابك الآن

38
00:03:31,270 --> 00:03:33,150
!لم يعد أمامنا خيار سوى القتال

39
00:03:33,640 --> 00:03:35,400
!فلتأخذوا وضعية القتال جميعًا

40
00:03:36,770 --> 00:03:38,080
!جهّزوا أسلحتكم

41
00:03:38,080 --> 00:03:40,290
!سنقضي على هذه الكارثة الآن

42
00:03:40,290 --> 00:03:41,380
!أجل

43
00:03:41,380 --> 00:03:43,950
فعلاً؟ هل قرّرتم مهاجمتي؟

44
00:03:48,600 --> 00:03:49,660
!أطلقوا

45
00:03:54,750 --> 00:03:57,960
!بلا أيّ رحمة! هذا رائع

46
00:03:57,960 --> 00:03:59,560
!أعجبني هذا كثيرًا

47
00:03:59,560 --> 00:04:01,220
!في الواقع... أعشقه

48
00:04:01,580 --> 00:04:02,680
!مستحيل

49
00:04:02,680 --> 00:04:05,750
!تبًّا! هذا مروّع

50
00:04:05,750 --> 00:04:07,680
وكان كلّ شيء على وشك
!أن يسير على ما يرام

51
00:04:07,680 --> 00:04:10,160
.أوافقك تمامًا

52
00:04:10,160 --> 00:04:13,390
وأنا أيضًا أندم على أنّ الأمر
.انتهى إلى هذا الحال

53
00:04:15,360 --> 00:04:19,980
رغم أنّ الذّنب يقع على ذلك الأحمق

54
00:04:19,980 --> 00:04:22,490
الّذي لوّح بتقواه السّاذجة

55
00:04:22,490 --> 00:04:25,820
.وحشر أنفه فيما لا يعنيه

56
00:04:25,820 --> 00:04:29,790
سيّد فيردل... ما معنى "مشعوذة" بالضّبط؟

57
00:04:30,080 --> 00:04:33,640
،أُمِرتُ من قبل رؤسائي أن أبقي الأمر سرّيًّا

58
00:04:33,640 --> 00:04:35,250
.لكن يبدو أنّه كان يجب أن أخبرك

59
00:04:35,930 --> 00:04:39,650
حين تتلقّى القدّيسة وحيًا
،ويتمّ تأكيده من قبل الرّؤساء

60
00:04:39,650 --> 00:04:43,340
يتمّ تصنيف ذلك الكائن ككارثة
."ويُطلَق عليه اسم "مشعوذ

61
00:04:43,340 --> 00:04:45,800
الفوضى الّتي حدثت في الشّمال
!سببها مشعوذة أيضًا

62
00:04:49,520 --> 00:04:52,310
!وعلى الأرجح أنّ هذه المرأة مشعوذة مثلها

63
00:04:52,310 --> 00:04:55,060
هل تُدرك خطورة الموقف
!الّذي نحن فيه الآن؟

64
00:04:55,380 --> 00:04:56,060
!نعم

65
00:04:56,060 --> 00:04:57,570
...هل انتهيتما

66
00:04:58,300 --> 00:05:01,860
من الحديث؟

67
00:05:01,860 --> 00:05:05,450
!تراجعوا أيّها المرتزقة! نحن سنواجهها

68
00:05:05,450 --> 00:05:07,410
!اتبعني يا لونيوس

69
00:05:07,410 --> 00:05:11,830
!أيّها الإله! امنحني القوّة لأقضي على الشّرّ

70
00:05:18,080 --> 00:05:20,750
.بطيئان. وضعيفان أيضًا

71
00:05:20,750 --> 00:05:24,220
!كلاّ، ليس بالضّرورة

72
00:05:30,900 --> 00:05:33,060
في البداية، سنقضي على تلك
!المجسّات المقزّزة

73
00:05:33,450 --> 00:05:34,910
!سنقطعها جميعها

74
00:05:34,910 --> 00:05:35,890
!حاضر

75
00:05:37,460 --> 00:05:40,600
تستخدمان بركة إلهيّة لتنفيذ ضربة مقدّسة؟

76
00:05:40,600 --> 00:05:45,240
يبدو أنّ لها تأثيرًا إضافيًا ضدّ
.الكائنات الشّرّيرة حسب ما أرى

77
00:05:45,240 --> 00:05:48,360
هذه مشكلة الوحدات القادمة
.من حضارة موالية للخير

78
00:05:50,990 --> 00:05:52,580
!بقيت ثلاثة فقط

79
00:05:52,580 --> 00:05:54,080
!تبًّا

80
00:05:59,510 --> 00:06:01,000
!أحسنت عملاً

81
00:06:01,330 --> 00:06:02,230
!ماذا؟

82
00:06:02,230 --> 00:06:02,840
!كلاّ

83
00:06:05,890 --> 00:06:06,790
!سُحقًا

84
00:06:07,280 --> 00:06:08,340
!سيّد فيردل

85
00:06:08,340 --> 00:06:09,530
.المعذرة

86
00:06:09,530 --> 00:06:12,620
يبدو أنّني استهنت بكما
.أيّها الفرسان المقدّسان كثيرًا

87
00:06:12,620 --> 00:06:18,240
.أثبتّما أنّكما أقوى ممّا توقّعت
لكن، ما رأيكما بهذا؟

88
00:06:18,240 --> 00:06:21,570
أيمكنكما أن تهاجما الآن؟
لا تستطيعان، أليس كذلك؟

89
00:06:21,570 --> 00:06:23,900
.لهذا السّبب أحبّ البشر

90
00:06:23,900 --> 00:06:27,980
تهتمّون بأمر بعضكم كثيرًا لدرجة
.أنّ ذلك يجعلكم دروعًا مثاليّة

91
00:06:27,980 --> 00:06:29,860
!ا-النّجدة

92
00:06:29,860 --> 00:06:31,570
!يا لك من شيطانة

93
00:06:31,570 --> 00:06:33,080
!تمالك نفسك يا لونيوس

94
00:06:33,650 --> 00:06:35,020
.تبقّى اثنان فقط

95
00:06:35,020 --> 00:06:38,040
.إن قطعناهما، سنفوز

96
00:06:39,040 --> 00:06:40,750
—لكن حينها

97
00:06:41,120 --> 00:06:44,320
،إن تمكّنّا من هزيمة تلك الشّيطانة
.سنطهّر الكارثة

98
00:06:44,320 --> 00:06:46,680
.لن يصيب موطننا أيّ ضرر

99
00:06:47,210 --> 00:06:49,260
!فكّر في الصّورة الأوسع الآن

100
00:06:49,260 --> 00:06:50,490
.فهمت

101
00:06:52,590 --> 00:06:54,300
!ماذا؟! لِمَ تهاجمان؟

102
00:06:56,560 --> 00:06:58,020
!حتّى الرّهائن أيضًا؟

103
00:06:58,020 --> 00:07:00,030
—آسف، ولكن

104
00:07:00,030 --> 00:07:00,850
—هذا

105
00:07:12,400 --> 00:07:13,030
ماذا؟

106
00:07:15,220 --> 00:07:16,490
!اهرب

107
00:07:17,250 --> 00:07:19,120
—اهرب يا لونيـ

108
00:07:24,860 --> 00:07:26,720
!سـ-سيّد فيردل

109
00:07:33,820 --> 00:07:34,590
كيف؟

110
00:07:35,310 --> 00:07:37,100
!قطعنا كلّ المجسّات

111
00:07:37,340 --> 00:07:40,060
هل قلتُ أنّي أملك ستّة فحسب؟

112
00:07:40,330 --> 00:07:43,410
.أستطيع استبدالها بقدر ما أشاء

113
00:07:43,410 --> 00:07:44,180
!ماذا؟

114
00:07:45,280 --> 00:07:48,060
!كانت تعبث معنا منذ البداية؟

115
00:07:51,360 --> 00:07:52,570
...والآن

116
00:07:55,550 --> 00:07:56,270
!اهربوا

117
00:07:56,270 --> 00:07:57,030
ماذا؟

118
00:07:57,030 --> 00:07:59,860
!تفرّقوا واهربوا كلٌّ في اتجاه

119
00:07:59,860 --> 00:08:03,670
!يجب أن ينجو أحدنا على الأقلّ ليحذّر الوطن

120
00:08:08,120 --> 00:08:09,710
هل كان لا بدّ أن تفعل ذلك؟

121
00:08:14,470 --> 00:08:15,930
...كيف لك أن

122
00:08:15,930 --> 00:08:19,180
تقصد كيف يمكنني استعمال فنون السّيف المقدّس؟

123
00:08:23,270 --> 00:08:25,020
.لقد سرقتها

124
00:08:25,020 --> 00:08:26,980
.من ذلك الرّجل هناك

125
00:08:27,490 --> 00:08:28,720
سرقتِها؟

126
00:08:28,720 --> 00:08:29,440
.نعم

127
00:08:29,440 --> 00:08:31,980
،كلّ ما بذَله من جهد

128
00:08:31,980 --> 00:08:34,080
،وكلّ ما أتقنَه من مهارات

129
00:08:34,080 --> 00:08:35,950
!صار لي حين قتلتُه

130
00:08:39,000 --> 00:08:40,660
!يا للمهارة خلف هذه التّقنية

131
00:08:41,200 --> 00:08:43,290
يبدو أنّ الفارس المقدّس فيردل

132
00:08:43,290 --> 00:08:47,330
.كان جديرًا بأن يوصف بمقاتل قويّ

133
00:08:47,330 --> 00:08:49,920
!مع أنّه لقي حتفه بسبب تهوّرك

134
00:08:50,580 --> 00:08:53,640
اسم زوجتك هو مارشا، وابنتك مينا؟

135
00:08:55,360 --> 00:08:58,210
...كيف عرفت ذلك؟! هل قمتِ أيضًا بـ

136
00:08:58,210 --> 00:09:00,000
!نعم، سرقتها

137
00:09:00,000 --> 00:09:02,780
!مشاعره، ذكرياته، كلّ شيء

138
00:09:02,780 --> 00:09:04,600
!مـ-مستحيل

139
00:09:05,140 --> 00:09:07,120
...المهارات... الذّكريات

140
00:09:07,120 --> 00:09:09,450
!هل تسرق كلّ شيء ممّن تقتلهم؟

141
00:09:10,050 --> 00:09:14,070
!أي أنّها تزداد قوّة كلّما قتلت أكثر؟

142
00:09:14,400 --> 00:09:19,780
"إن متّ هنا، ماذا سيحلّ بلونيوس وعائلته؟"

143
00:09:20,140 --> 00:09:24,970
...المرتزقة، وأنا أيضًا"
".لدينا جميعًا من ينتظر عودتنا

144
00:09:26,000 --> 00:09:27,700
.يا له من موقف بطوليّ

145
00:09:27,700 --> 00:09:29,860
.لا عجب أنّه كان فارسًا مقدّسًا أعلى

146
00:09:29,860 --> 00:09:34,050
ظلّ يقلق عليكم جميعًا
.حتّى آخر لحظة من حياته

147
00:09:34,050 --> 00:09:39,320
ما الّذي تشعر به الآن بعد أن عرفتَ
!ذلك أيّها الفارس المقدّس لونيوس؟

148
00:09:42,480 --> 00:09:45,430
!إ-إرادته لا تزال حيّة

149
00:09:45,430 --> 00:09:48,290
،طالما أنّني أُبقيك منشغلة هنا

150
00:09:48,290 --> 00:09:50,120
!سيتمكّن المرتزقة من الفرار

151
00:09:52,360 --> 00:09:53,610
!ماذا؟

152
00:09:53,610 --> 00:09:56,570
.صحيح، إنّهم الإلف المظلمون

153
00:09:56,570 --> 00:09:59,840
.أمرتهم ألاّ يَدَعوا رجلاً واحدًا يفرّ

154
00:10:00,410 --> 00:10:01,720
ماذا؟

155
00:10:01,720 --> 00:10:05,620
هل سبق وقلتُ إنّني وحدي؟

156
00:10:17,280 --> 00:10:20,050
لِمَ لا نتحدّث عن مستقبلٍ
كان من الممكن أن يحدث؟

157
00:10:20,790 --> 00:10:25,940
هذا ما كان سيحدث لو أنّك أنصتّ
:للفارس المقدّس فيردل

158
00:10:27,060 --> 00:10:29,090
،كنتَ ستعود إلى وطنك سالمًا

159
00:10:29,090 --> 00:10:31,360
.وتلتقي مجدّدًا بعائلتك المحبوبة

160
00:10:31,360 --> 00:10:34,690
،كنتَ ستنعم بسعادة الحياة العاديّة الهادئة

161
00:10:35,170 --> 00:10:38,700
.وتواصل تقديم صلوات الشّكر لإلهك

162
00:10:38,700 --> 00:10:42,570
،بينما كنّا سننعم نحن أيضًا بالسّلام

163
00:10:42,890 --> 00:10:44,800
،وكانت الغابة ستبقى ساكنة

164
00:10:44,800 --> 00:10:49,570
.وكنتُ سأنام على أمل أن يدوم هذا إلى الأبد

165
00:10:51,260 --> 00:10:54,540
أمّا الآن، فلنتحدّث عن المستقبل
.الّذي اخترتَه أنت

166
00:10:54,870 --> 00:10:56,400
.ستموت

167
00:10:56,400 --> 00:10:59,460
.ثمّ ستموت عائلتك من بعدك

168
00:10:59,460 --> 00:11:02,290
.سأطاردهم وأقتلهم لاحقًا

169
00:11:03,220 --> 00:11:05,620
،سأعذّبهم، وأعذّبهم أكثر

170
00:11:05,620 --> 00:11:09,600
،وأواصل تعذيبهم حتّى يتوسّلوا الموت
.وعندها فقط سأُجهز عليهم

171
00:11:09,980 --> 00:11:14,520
ثمّ سأذهب إلى كلّ قرية ومدينة
،مررتم بها في طريقكم إلى هنا

172
00:11:14,520 --> 00:11:16,880
.وسأقتل كلّ حيٍّ فيها

173
00:11:16,880 --> 00:11:19,030
،لن يكون لذلك معنى أو غاية

174
00:11:19,030 --> 00:11:21,200
.لكن لا بأس، سأقتلهم فحسب

175
00:11:21,590 --> 00:11:23,740
،وإن سألوني عن السّبب

176
00:11:23,740 --> 00:11:27,520
،سأخبرهم أنّه بسبب أفعالك الحمقاء

177
00:11:27,520 --> 00:11:28,700
.ثمّ سأقتلهم

178
00:11:29,030 --> 00:11:30,180
!توقّفي

179
00:11:30,880 --> 00:11:33,700
.حين يتجاهلك النّاس، تكون نهايتك قد حلّت

180
00:11:33,700 --> 00:11:36,510
.لذا عليك أن تقتلهم إذا ما فعلوا ذلك

181
00:11:36,510 --> 00:11:39,090
.هذا ما علّمني إيّاه شخص عزيز عليّ

182
00:11:39,570 --> 00:11:41,460
.لذا سأقتلهم

183
00:11:41,460 --> 00:11:43,220
،سأقتلهم دون استثناء

184
00:11:43,220 --> 00:11:45,730
،لأتأكّد أنّ لا أحد سيستخفّ بي مجدّدًا

185
00:11:45,730 --> 00:11:53,100
حتّى لو كانت أعدادهم بالمائات
.أو الآلاف أو الملايين

186
00:11:53,100 --> 00:11:56,320
.هذا هو المصير الّذي اخترتَه أنت

187
00:11:57,520 --> 00:11:59,100
!تـ-توقّفي

188
00:11:59,650 --> 00:12:02,030
!أرجوك، أوقفي هذا

189
00:12:02,270 --> 00:12:05,260
!واثقة أنّك كنت شخصًا طيّبًا

190
00:12:05,260 --> 00:12:06,460
،كنتَ تؤمن بإلهك

191
00:12:06,460 --> 00:12:07,740
،وتفني ذاتك من أجل وطنك

192
00:12:07,740 --> 00:12:09,690
!وتحبّ عائلتك

193
00:12:09,690 --> 00:12:11,250
!كم أنّ هذا جدير بالثّناء

194
00:12:11,560 --> 00:12:16,250
ولهذا بالذّات، أكره أولئك
.الّذين يظنّون أنفسهم أبرارًا

195
00:12:19,470 --> 00:12:22,590
.الوداع أيّها الفارس المقدّس لونيوس

196
00:12:24,010 --> 00:12:27,810
.راقب من مقعدك المميّز في السّماء

197
00:12:27,810 --> 00:12:35,440
راقب كيف يتعذّب أحبّاؤك وأولئك
.الأبرياء، حتّى يلقوا حتفهم بأبشع صورة

198
00:13:04,710 --> 00:13:05,690
.سيّدتي أتو

199
00:13:06,800 --> 00:13:08,090
نعم يا غيا؟

200
00:13:08,400 --> 00:13:11,290
.أنهينا أمر الجميع، كما أمرتِ

201
00:13:11,290 --> 00:13:15,560
.واثقة أنّ ملكنا سيسعد بسماع ذلك أيضًا

202
00:13:15,560 --> 00:13:18,100
.سأعود الآن إذًا

203
00:13:18,100 --> 00:13:20,820
.تولّ أمر التّخلّص من الجثث

204
00:13:21,060 --> 00:13:21,950
...عفوًا

205
00:13:23,930 --> 00:13:25,110
ماذا هنالك؟

206
00:13:25,110 --> 00:13:29,570
هل تنوين حقًّا تنفيذ ما قلتِه له قبل قليل؟

207
00:13:32,910 --> 00:13:34,390
!بالطّبع لا

208
00:13:34,390 --> 00:13:36,590
!مستحيل أن أُقدِم على فعل شيء كهذا

209
00:13:36,590 --> 00:13:37,250
ماذا؟

210
00:13:37,370 --> 00:13:39,620
!أنا مسالمة

211
00:13:39,620 --> 00:13:41,950
!كنتُ أعبث معه فحسب

212
00:13:41,950 --> 00:13:43,340
!أعبث معه فحسب

213
00:13:44,710 --> 00:13:45,970
!كلاّ

214
00:13:45,970 --> 00:13:48,290
.لا وقت لدي لأُضيّعه هنا

215
00:13:48,290 --> 00:13:50,550
!عليّ أن أسرع وأعود إلى ملكنا

216
00:13:51,480 --> 00:13:53,180
هل هناك ما يُقلقك؟

217
00:13:53,450 --> 00:13:54,350
.نعم

218
00:13:56,320 --> 00:13:59,830
.ثمّة أمر يجب أن أبلّغ به ملكنا في الحال

219
00:14:12,820 --> 00:14:14,330
...مشعوذين

220
00:14:14,640 --> 00:14:18,780
لم يكن هناك وحدة كهذه
في "الأمم الأبديّة"، صحيح؟

221
00:14:18,780 --> 00:14:19,540
.لم تكن موجودة

222
00:14:19,980 --> 00:14:23,890
يبدو أنّ هذا العالم
.ليس عالم اللّعبة بالتّأكيد

223
00:14:23,890 --> 00:14:25,590
.فهمت

224
00:14:27,800 --> 00:14:30,670
،كنت أشكّ في ذلك

225
00:14:31,200 --> 00:14:34,390
لكن يبدو أنّنا قد انتقلنا
.إلى عالم آخر بالفعل

226
00:14:34,770 --> 00:14:38,110
لا تزال ميكانيكيّات اللّعبة قابلة
،للتّطبيق جزئيًّا هنا

227
00:14:38,110 --> 00:14:43,010
لكن علينا أن نُسلّم بأنّ هذا
.العالم يعمل بشكلٍ مختلف

228
00:14:43,010 --> 00:14:44,980
.هذا مزعج

229
00:14:44,980 --> 00:14:49,200
مع ذلك، هناك جوانب إيجابيّة
.في اختلافه عن عالم اللّعبة

230
00:14:50,240 --> 00:14:52,640
تقصدين قدرتك؟

231
00:14:52,640 --> 00:14:53,410
.نعم

232
00:14:55,020 --> 00:14:57,870
كانت القدرة الخاصّة
الّتي امتلكتها أتو في اللّعبة

233
00:14:58,330 --> 00:15:04,000
تمنحها احتمالاً معيّنًا لسرقة
.قدرة الوحدة المهزومة

234
00:15:04,640 --> 00:15:05,960
...لكن

235
00:15:06,480 --> 00:15:10,340
يمكنني أيضًا سرقة ذكريات
.خصومي المهزومين إلى حدٍّ ما

236
00:15:10,900 --> 00:15:14,080
.وهذا سيكون سلاحًا فعّالاً في ترسانتنا

237
00:15:14,080 --> 00:15:17,190
صحيح. بفضل ذلك، عرفنا ما يحدث في كواليا

238
00:15:17,190 --> 00:15:18,730
.دون أن نضطرّ لإرسال أيّ أحد للتّحرّي

239
00:15:19,030 --> 00:15:20,160
.نعم

240
00:15:20,160 --> 00:15:23,440
من حسن حظّنا أنّ كواليا
لا تملك قوّات احتياط كافية

241
00:15:23,440 --> 00:15:26,320
بسبب الكارثة الّتي حلّت فيما
.يسمّونه الإقليم الشّماليّ

242
00:15:26,580 --> 00:15:29,870
.ممتاز، يمكننا أن نأخذ قسطًا من الرّاحة إذًا

243
00:15:31,170 --> 00:15:36,330
لكن على الأرجح أنّهم سيبدؤون التّحرّك
.بطريقة ما بعد أن أبدناهم

244
00:15:36,660 --> 00:15:40,620
.لكنّهم لا يملكون أيّ معلومات عنّا

245
00:15:40,620 --> 00:15:43,790
.لذا حتّى إن تحرّكوا، فسيفعلون ذلك بحذر

246
00:15:44,090 --> 00:15:48,510
.ما يقلقني أكثر هو سبب تلك الكارثة

247
00:15:48,840 --> 00:15:50,990
...الاضطرابات الشّماليّة

248
00:15:50,990 --> 00:15:53,740
كانت بسبب مشعوذة، صحيح؟

249
00:15:53,740 --> 00:15:56,600
.نعم، بحسب الذّكريات الّتي سرقتُها

250
00:15:57,160 --> 00:15:58,720
هل تعرفين أيّ شيء آخر؟

251
00:16:01,080 --> 00:16:03,170
.ليس كثيرًا للأسف

252
00:16:03,630 --> 00:16:07,070
يبدو أنّ كواليا نفسها لا تعرف
.الكثير عن المشعوذة

253
00:16:07,420 --> 00:16:08,860
...وما يعرفونه

254
00:16:08,860 --> 00:16:13,150
هو أنّها تسبّب في دمار يعادل دمار
،الجيوش في مدن الإقليم الشّماليّ

255
00:16:13,510 --> 00:16:15,620
.وما هو اسمها

256
00:16:16,580 --> 00:16:17,590
.أخبريني به

257
00:16:18,080 --> 00:16:22,220
يبدو أنّها تُدعى
."المشعوذة الملتهمة إراكينو"

258
00:16:22,220 --> 00:16:30,840
...طق، طق، طق، طق

259
00:16:31,550 --> 00:16:34,330
.طنين ودوران، طنين ودوران

260
00:16:34,330 --> 00:16:37,120
.لا تُقامر الآلهة أبدًا

261
00:16:37,120 --> 00:16:39,570
.لا وجود للأحلام أو الأمل

262
00:16:39,570 --> 00:16:43,120
.ما الحياة سوى مضيعة للوقت

263
00:16:43,120 --> 00:16:45,980
!حسنًا إذًا، إلى المدينة التّالية

264
00:16:45,980 --> 00:16:50,770
!إلى جميع مُعجبيَّ، هيّا بنا

265
00:17:00,520 --> 00:17:01,830
،أتو

266
00:17:01,830 --> 00:17:07,330
حدثت تلك الاضطرابات في الشّمال
مؤخّرًا، أليس كذلك؟

267
00:17:07,330 --> 00:17:08,290
.نعم

268
00:17:08,590 --> 00:17:10,470
إذًا فقد ظهر وحش

269
00:17:10,470 --> 00:17:15,030
قادر على التّسبّب بدمار يعادل
دمار الجيوش خلال وقت قصير؟

270
00:17:16,880 --> 00:17:21,110
ربّما من الممكن أنّهم جاؤوا
إلى هذا العالم مثلما جئنا نحن؟

271
00:17:23,550 --> 00:17:28,820
على أيّ حال، من الواضح أنّهم
.يملكون قوّة تعادل وحدات الأبطال

272
00:17:29,400 --> 00:17:32,150
.هذا تطوّر مقلق للغاية

273
00:17:34,680 --> 00:17:36,400
ماذا سنفعل حيال ذلك؟

274
00:17:36,800 --> 00:17:40,870
من خلال تصرّفاتهم، أعتقد
،أنّهم أيضًا موالين للشّرّ

275
00:17:41,210 --> 00:17:43,230
لكن هل ترغب في محاولة التّواصل معهم؟

276
00:17:44,980 --> 00:17:47,440
.لا أعتقد أن علينا فعل ذلك

277
00:17:47,440 --> 00:17:49,130
.لن ننسجم أبدًا على أيّة حال

278
00:17:49,130 --> 00:17:51,390
.خصوصًا ونحن كلانا موالين للشّرّ

279
00:17:51,390 --> 00:17:52,960
.معك حقّ

280
00:17:55,260 --> 00:17:58,260
.كان كلّ شيء يسير على ما يرام

281
00:17:58,260 --> 00:18:01,600
لماذا علينا مواجهة مشكلة تلو الأخرى؟

282
00:18:01,600 --> 00:18:04,640
حسنًا، على الأقلّ يحدث الأمر
.في أقصى الشّمال

283
00:18:04,640 --> 00:18:07,970
.وكوننا نملك وقتًا للتّعامل معه هو نعمة

284
00:18:07,970 --> 00:18:09,060
.نعم

285
00:18:09,840 --> 00:18:14,010
أتو، بما أنّنا نعلم أنّ لديهم
،قوّة قتاليّة تساوي وحدة بطل

286
00:18:14,010 --> 00:18:16,490
.هناك شيء واحد يجب علينا فعله

287
00:18:19,450 --> 00:18:21,060
.بالضّبط

288
00:18:24,400 --> 00:18:27,160
.لكن ربّما عليّ إعادة النّظر في ذلك الآن

289
00:18:27,160 --> 00:18:29,770
ربّما سيكون من الأفضل التّركيز
.على القوّة القتاليّة

290
00:18:29,770 --> 00:18:31,290
.فكرة جيّدة

291
00:18:36,800 --> 00:18:40,510
سأقدّم المساعدة قدر استطاعتي
!أيّها الملك تاكُتو

292
00:18:40,510 --> 00:18:42,390
.شكرًا يا أتو

293
00:18:42,800 --> 00:18:46,640
رغم أنّ إيسلا ليست الشّيء الوحيد
.الّذي عليّ إعادة التّفكير فيه

294
00:18:46,640 --> 00:18:47,770
ماذا تقصد؟

295
00:18:48,410 --> 00:18:51,270
.أفكّر في تعديل بعض سياساتنا

296
00:18:51,820 --> 00:18:53,290
سياساتنا؟

297
00:18:54,360 --> 00:18:56,560
.لنقم بتكوين تحالف

298
00:18:56,560 --> 00:18:57,810
!ماذا؟

299
00:18:59,120 --> 00:19:02,390
،لدينا عدوّ واضح وهو كواليا

300
00:19:02,390 --> 00:19:05,190
.وهناك عنصر مجهول وهو المشعوذة

301
00:19:05,190 --> 00:19:07,580
لذلك أريد أن تكون هناك
.أمّة أخرى إلى جانبنا

302
00:19:07,580 --> 00:19:09,490
،أفهم منطقك

303
00:19:09,490 --> 00:19:10,810
لكن هل هذا ممكن؟

304
00:19:10,810 --> 00:19:13,130
.نحن موالين للشّرّ كما تعلم

305
00:19:13,130 --> 00:19:15,860
سيكون ذلك ممكنًا إذا كانت
.هناك فائدة للطّرف الآخر

306
00:19:15,860 --> 00:19:19,250
.بشرط أن تكون الأمّة محايدة بطبيعة الحال

307
00:19:19,250 --> 00:19:21,640
...أمّة محايدة

308
00:19:21,640 --> 00:19:23,940
تقصد الأمّة الّتي تقع شرقنا؟

309
00:19:23,940 --> 00:19:24,850
!نعم

310
00:19:25,140 --> 00:19:26,980
،بمجرّد أن ينتهي بناء القصر

311
00:19:26,980 --> 00:19:31,570
أريد أن أستكشف تلك الأمّة
.بينما نعزّز من قوّاتنا

312
00:19:31,570 --> 00:19:34,860
نحتاج إلى معرفة إن كانوا
.على استعداد للتّحالف معنا

313
00:19:47,000 --> 00:19:48,800
!هذا هو المتوقّع من حاملة العصا

314
00:19:48,800 --> 00:19:51,080
!هزمتْ العديد من البرابرة بسهولة

315
00:19:51,080 --> 00:19:54,190
!توقّفوا عن تمجيد شيوخكم

316
00:19:54,190 --> 00:19:57,170
أسرعوا ونظّفوا الجثث
!قبل أن تبدؤوا بالاحتفال

317
00:19:57,450 --> 00:19:58,420
!حاضر

318
00:20:01,130 --> 00:20:02,840
!ما-ما هذا؟

319
00:20:03,920 --> 00:20:04,840
!ماذا؟

320
00:20:09,050 --> 00:20:10,500
!هذا لا يُعقل

321
00:20:10,500 --> 00:20:13,190
!لم أرَ أعدادًا كهذه من قبل

322
00:20:13,190 --> 00:20:15,230
!توقّفوا عن التّحديق فحسب

323
00:20:15,230 --> 00:20:16,820
!جهّزوا أسلحتكم

324
00:20:16,820 --> 00:20:18,230
!والمبعوثين أيضًا

325
00:20:18,230 --> 00:20:19,710
!اذهبوا لطلب التّعزيزات

326
00:20:19,710 --> 00:20:20,620
!حاضر

327
00:20:25,200 --> 00:20:28,350
ما الّذي يحدث هنا؟

328
00:20:39,680 --> 00:20:43,340
عفوًا أيّها الملك تاكُتو؟

329
00:20:43,340 --> 00:20:45,300
نعم، ماذا هنالك؟

330
00:20:47,250 --> 00:20:49,470
...حسنًا، إنّ الأمر

331
00:20:50,270 --> 00:20:51,340
...لقد

332
00:20:53,940 --> 00:21:01,690
.شعرت أنّني قد أكون قد عكّرتُ مزاجك

333
00:21:02,000 --> 00:21:02,910
ماذا؟

334
00:21:03,400 --> 00:21:05,120
...لذلك قلتُ لنفسي

335
00:21:05,120 --> 00:21:12,370
ربّما كنتُ عنيفة أكثر من اللاّزم مع
...ذلكما الفارسين المقدّسين

336
00:21:12,770 --> 00:21:14,000
ماذا في ذلك؟

337
00:21:14,320 --> 00:21:15,250
ماذا؟

338
00:21:26,370 --> 00:21:28,180
.لا بأس

339
00:21:28,180 --> 00:21:32,140
.ما كنتُ لأغضب على أيّ شيء تفعلينه يا أتو

340
00:21:32,560 --> 00:21:36,120
،أنا أعتمد عليك كثيرًا يا أتو

341
00:21:36,120 --> 00:21:37,850
.لذا لا تقلقي حيال ذلك

342
00:21:38,420 --> 00:21:41,180
.واصلي دعمي فحسب

343
00:21:41,720 --> 00:21:43,860
!أيّها الملك تاكُتو

344
00:21:44,780 --> 00:21:46,380
!بالطّبع

345
00:21:46,380 --> 00:21:51,280
سأدعمك بكلّ شبر من كياني
!أيّها الملك تاكُتو

346
00:21:51,280 --> 00:21:54,230
!والآن، أعطني أيّ أمر تريده

347
00:21:54,230 --> 00:21:55,370
!هيّا