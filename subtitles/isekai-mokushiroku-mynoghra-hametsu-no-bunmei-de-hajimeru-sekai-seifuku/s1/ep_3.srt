1
00:00:13,500 --> 00:00:17,070
،سمعتُ أنّ القدّيسة تملك قوّى خاصّة

2
00:00:17,070 --> 00:00:19,300
.لكنّ الأمر لا يبدو لي كذلك على الإطلاق

3
00:00:19,900 --> 00:00:20,830
.ستفهم قريبًا

4
00:00:34,200 --> 00:00:36,210
!بسرعة يا سيّدتي القدّيسة

5
00:00:38,120 --> 00:00:42,390
.لقد فات أوان التّوبة الآن

6
00:00:42,390 --> 00:00:46,100
لقاءَ جريمة الإخلال بسِلم
،مملكة كواليا المقدّسة

7
00:00:46,100 --> 00:00:49,190
،وبخطيئة التّنكّر للإله المقدّس أرلوس

8
00:00:49,190 --> 00:00:50,930
.حُكم عليكم بدفنٍ مزهر

9
00:01:00,950 --> 00:01:03,380
.يا لها من قدّيسة

10
00:01:03,380 --> 00:01:05,290
.بل هي أشبه بسلاحٍ فتّاك

11
00:01:14,960 --> 00:01:17,120
!كـ-كيف حدث هذا؟

12
00:01:18,820 --> 00:01:21,150
هذه القوّة هي أحد الأسباب الّتي بفضلها

13
00:01:21,150 --> 00:01:25,560
نستطيع صدّ الشّرّ والحفاظ على علاقة مستقرّة

14
00:01:25,560 --> 00:01:27,650
.مع مملكة الإلف

15
00:01:28,380 --> 00:01:29,840
إنّها تدفن أعداءها باللّهب

16
00:01:29,840 --> 00:01:31,320
.وتودّعهم بالأزهار

17
00:01:32,010 --> 00:01:35,900
إنّها واحدة من القدّيسات المنقذات
،العظيمات السّبع لقارّة إيدوراغيا

18
00:01:36,340 --> 00:01:39,220
.القدّيسة سوالينا، سيّدة الدّفن المزهر

19
00:01:41,320 --> 00:01:44,830
.أرسلتُ الفرسان المقدّسين إلى القرى المجاورة

20
00:01:45,390 --> 00:01:49,680
وماذا عن الأمر الّذي ناقشته معك
في طريقنا إلى هنا أيّها الكاردينال؟

21
00:01:49,680 --> 00:01:52,040
أيّ أمر تقصدين؟

22
00:01:52,350 --> 00:01:55,940
العلامات الّتي تُنذر بنهاية العالم
،في الأراضي الملعونة

23
00:01:55,940 --> 00:01:59,010
وضرورة إرسال فرسان مقدّسين
.للتّحقّق من الأمر

24
00:02:00,350 --> 00:02:02,220
.لا يمكنني الموافقة على ذلك

25
00:02:02,980 --> 00:02:07,980
من غير المعقول أن نُظهر اهتمامًا بالأراضي
.الملعونة في القارة المظلمة البعيدة جنوبًا

26
00:02:08,430 --> 00:02:12,590
ما كانت القيادة المركزيّة لتسمح
.باستخدام الفرسان لهذا الغرض

27
00:02:12,590 --> 00:02:15,190
.إذًا ربّما سأذهب بنفسي

28
00:02:15,190 --> 00:02:18,700
يا سيّدتي القدّيسة، إنّك لا تدركين
!المكانة الّتي تشغلينها الآن

29
00:02:18,700 --> 00:02:21,740
!لم تعودي تلك الفتاة القرويّة البسيطة

30
00:02:25,230 --> 00:02:26,000
.تبًّا

31
00:02:26,500 --> 00:02:29,710
.سأرسل أولئك الّذين هم تحت أمري المباشر

32
00:02:34,860 --> 00:02:36,700
.يا لها من فلاّحة لعينة

33
00:02:41,020 --> 00:02:43,930
.عليّ إنقاذهم

34
00:04:20,320 --> 00:04:24,240
!اسمعوا جميعًا
!حان وقت البناء الممتع للغاية

35
00:04:24,240 --> 00:04:26,530
!أجل

36
00:04:34,330 --> 00:04:36,630
ما الأمر أيّها الملك تاكُتو؟

37
00:04:36,630 --> 00:04:38,000
أليس هذا رائعًا؟

38
00:04:38,460 --> 00:04:43,340
عمِل الإلف المظلمين بسرعة فائقة
.لبناء هذا العرش وغرفة المجلس

39
00:04:44,810 --> 00:04:46,550
.ونحن بالكاد بدأنا للتّوّ

40
00:04:47,020 --> 00:04:52,160
لنبنِ حضارة قويةً تهيمن
!على الأرض وتشقّ السّماء

41
00:04:53,810 --> 00:04:58,730
.اجتمع كلّ إداريّي مملكتك بأمرك

42
00:04:59,850 --> 00:05:02,080
.لنبدأ المجلس

43
00:05:02,080 --> 00:05:03,410
...قبل ذلك

44
00:05:04,250 --> 00:05:07,500
،أيّها الملك العظيم الجبّار
.اقبل هديّتنا هذه

45
00:05:07,500 --> 00:05:09,280
!ماذا؟! أتممتموه بهذه السّرعة؟

46
00:05:11,740 --> 00:05:13,090
!نعم

47
00:05:13,090 --> 00:05:14,960
!أستطيع أخير خلع ملابس النّوم

48
00:05:14,960 --> 00:05:20,460
عملنا جميعًا بكلّ جهدنا لخياطة
.زيّ ترتديه يليق بك كملك

49
00:05:20,460 --> 00:05:22,880
!يبدو رائعًا عليك أيّها الملك تاكُتو

50
00:05:26,850 --> 00:05:29,340
.ملكنا في غاية السّعادة

51
00:05:29,340 --> 00:05:32,440
.يشرّفنا سماع أنّ الزّيّ نال إعجابه

52
00:05:33,900 --> 00:05:34,580
!نعم

53
00:05:34,580 --> 00:05:38,550
والآن، حلّ أخيرًا وقت الشّؤون
!الدّاخليّة المنتظر

54
00:05:46,000 --> 00:05:51,830
كبداية، سنبدأ اجتماعنا بينما نستشير
.مع الملك كلّما دعت الحاجة

55
00:05:52,190 --> 00:05:54,290
.نعم، أعتمد عليكم

56
00:05:54,670 --> 00:05:59,610
حسنًا يا سيّدتي أتو، ما المباني
الّتي علينا البدء بإنشائها أوّلاً؟

57
00:05:59,610 --> 00:06:04,130
شرعنا سلفًا باستعدادات مثل
.تسوية الأرض وقطع الأغصان

58
00:06:06,970 --> 00:06:09,470
.لا يمكن لأحد أن يخوض حربًا ومعدته فارغة

59
00:06:09,470 --> 00:06:12,220
.مع أنّنا لا نخطّط لخوض أيّة حروب

60
00:06:17,940 --> 00:06:21,140
وإلى متى تنوي أن تُثقل كاهل
ملكنا بمثل هذا العمل؟

61
00:06:21,140 --> 00:06:25,320
وفوق ذلك، ستظهر مشكلات
.في التّوزيع مع توسّع أراضينا

62
00:06:25,700 --> 00:06:27,440
.أنت على حقّ تمامًا

63
00:06:27,440 --> 00:06:30,570
.أرجو أن تسامحيني على قِصَر نظري

64
00:06:30,570 --> 00:06:32,700
.طالما أنّك فهمت، فلا بأس

65
00:06:33,040 --> 00:06:34,150
.تفضّلوا

66
00:06:34,150 --> 00:06:36,370
!تشرّفت بلقائكم

67
00:06:37,750 --> 00:06:40,210
ما هذا يا سيّدتي أتو؟

68
00:06:41,240 --> 00:06:43,090
!شجرة لحم

69
00:06:43,810 --> 00:06:44,550
ماذا؟

70
00:06:44,550 --> 00:06:47,260
!إنّها شجرة لحم

71
00:06:49,200 --> 00:06:52,720
أيمكنك أن توضّحي الأمر أكثر قليلاً؟

72
00:06:57,090 --> 00:07:00,650
.إنّها شجرة تُنتج لحمًا غامضًا بطعم لحم البشر

73
00:07:00,650 --> 00:07:02,340
،إنّها توفّر محصولاً وفيرًا

74
00:07:02,340 --> 00:07:03,550
،والمحصول لحم حقيقيّ

75
00:07:03,550 --> 00:07:05,770
.ممّا يجعله مغذٍّ للغاية

76
00:07:06,080 --> 00:07:08,150
.يبدو هذا شرّيرًا

77
00:07:08,530 --> 00:07:10,160
.نتفهّم ذلك

78
00:07:10,160 --> 00:07:14,160
.لكن هناك من قد يستاء من فكرة أكل لحم بشر

79
00:07:14,490 --> 00:07:16,990
.سنزرعها مؤقّتًا كبداية فحسب

80
00:07:17,400 --> 00:07:19,460
.لكلّ شخص أشياء يحبّها وأخرى يكرهها

81
00:07:24,080 --> 00:07:26,080
،سنحتاج أيضًا إلى كوخٍ لإدارتها

82
00:07:26,080 --> 00:07:29,260
.ومبنى لتخزين الطّعام

83
00:07:29,260 --> 00:07:31,970
.سأتولّى مسؤوليّة ذلك

84
00:07:31,970 --> 00:07:35,180
.أرجو أن تعتني بي جيّدًا

85
00:07:40,360 --> 00:07:43,060
.البند التّالي في جدول الأعمال: البحوث

86
00:07:43,520 --> 00:07:46,060
،بما أنّنا لا نزال أمّة صغيرة

87
00:07:46,060 --> 00:07:48,940
.فنحن بحاجة ماسّة لاكتساب أحدث تكنولوجيا

88
00:07:49,440 --> 00:07:51,170
،عفوًا يا سيّدتي أتو

89
00:07:51,170 --> 00:07:53,700
ما التّكنولوجيا الّتي علينا
إعطاؤها الأولويّة؟

90
00:07:54,080 --> 00:07:57,450
!تكنولوجيا السّحر بالطّبع

91
00:07:57,450 --> 00:07:59,200
!يا للحماسة

92
00:08:00,420 --> 00:08:03,060
.يبدو أنّ ملكي متحمّس

93
00:08:03,060 --> 00:08:08,190
،أنا باحث في مجال السّحر أيضًا
.لذا أنا متحمّس مثلك

94
00:08:08,190 --> 00:08:11,670
ما نوع السّحر الّذي سنبحث فيه؟

95
00:08:12,060 --> 00:08:13,880
!السّحر العسكريّ

96
00:08:14,300 --> 00:08:19,920
لا يمكن للسّحر العاديّ أن يستهدف
إلاّ بضع عشرات من الأشخاص، صحيح؟

97
00:08:19,920 --> 00:08:24,660
إن سمحتم لي بالقول، فأنا
.أستطيع فعل ذلك بسهولة

98
00:08:24,660 --> 00:08:28,800
بالطّبع، لكنّ السّحر العسكريّ يسمح
،لك بمهاجمة جيوش قوامها الآلاف

99
00:08:28,800 --> 00:08:32,100
بل ويتيح لك حتّى تغيير
،تضاريس الأرض لصالحك

100
00:08:32,100 --> 00:08:34,110
.إلى جانب استخدامات استراتيجيّة أخرى

101
00:08:34,720 --> 00:08:38,330
أيوجد سحر قادر على تحقيق مثل
!هذه المعجزات؟

102
00:08:38,630 --> 00:08:45,460
لذا، علينا اختيار بعض الأشخاص الموهوبين
.في السّحر ليقودوا هذه البحوث

103
00:08:45,780 --> 00:08:47,960
،ليست تكنولوجيا معقّدة كثيرًا

104
00:08:47,960 --> 00:08:49,550
.لذا سنتمكّن من تطويرها سريعًا

105
00:08:50,240 --> 00:08:52,880
...عالم السّحر الّذي يعرفه ملكنا

106
00:08:52,880 --> 00:08:56,510
!إنّه يُشعل الحماسة في عروقي

107
00:09:02,070 --> 00:09:05,310
.والآن، سننتقل إلى التّخطيط العسكريّ

108
00:09:05,600 --> 00:09:07,310
!حان دوري الآن

109
00:09:07,310 --> 00:09:09,720
.أوّلاً، علينا تنظيم جيش

110
00:09:10,810 --> 00:09:15,150
في الوقت الحالي، لن نُفرِط كثيرًا
.في التّركيز على ذلك

111
00:09:16,150 --> 00:09:18,120
...فهمت

112
00:09:18,120 --> 00:09:23,450
إنّ الجيوش لا تنتج أيّ شيء، بل تستهلك
.الموارد والطّاقة السّحريّة فحسب

113
00:09:23,850 --> 00:09:25,000
،عذرًا على صراحتي

114
00:09:25,000 --> 00:09:29,410
لكنّ فرقة المحاربين الحاليّة
.لا تملك القوّة الكافية لحماية ملكنا

115
00:09:30,500 --> 00:09:33,990
،والأسوأ من ذلك، وأقولها على مضض

116
00:09:33,990 --> 00:09:39,510
توجد على رأسينا أنا وغيا مكافآت
.بسبب كوننا قادة للإلف المظلمين

117
00:09:39,810 --> 00:09:42,310
.إذًا أنتم قلقون من أن يلاحقكم أحد

118
00:09:48,910 --> 00:09:51,400
.لنُنتج بطلاً إذًا

119
00:09:51,400 --> 00:09:52,850
!فكرة ممتازة

120
00:09:55,490 --> 00:09:58,570
،لكنّه بالكاد يتطلّب أيّ صيانة
!ما يجعله خيارًا مثاليًّا

121
00:09:58,890 --> 00:10:01,950
سيّدتي أتو، ما هو البطل؟

122
00:10:02,700 --> 00:10:07,290
في ماينوغورا، ثمّة عدّة أبطال
.يخدمون تحت إمرة ملكنا

123
00:10:07,750 --> 00:10:10,730
،جميعهم أقوياء ويمتلكون قدرات خاصّة

124
00:10:10,730 --> 00:10:13,800
.مع أنّهم جميعًا وحوش مجانين لحدّ ما

125
00:10:15,680 --> 00:10:18,640
،هناك عدّة شروط يجب تحقيقها لاستدعائهم

126
00:10:18,640 --> 00:10:21,600
لكن يجب أن نتمكّن من استدعاء
.واحد على الأقلّ

127
00:10:21,600 --> 00:10:25,120
،إلا جانب احتياج الجيوش لموارد دائمة
...فإنّها تجلب الأنظار أيضًا

128
00:10:25,120 --> 00:10:28,720
بينما يمكن للبطل مساعدتنا
.في الحفاظ على تكتّمنا

129
00:10:28,720 --> 00:10:32,110
.لذلك سننتج بطلاً، ويمكنكم أن ترتاحوا بعدها

130
00:10:32,110 --> 00:10:34,510
.أ-أنا ممتنّ كثيرًا

131
00:10:34,980 --> 00:10:35,840
!أكيد

132
00:10:35,840 --> 00:10:37,990
!إدارة الشّؤون الدّاخليّة ممتعة للغاية

133
00:10:38,330 --> 00:10:40,990
!هي كذلك بالفعل يا ملكي تاكُتو

134
00:10:41,510 --> 00:10:45,520
،إنّنا نجمع أيضًا الطّاقة السّحريّة من مواطنينا

135
00:10:45,520 --> 00:10:47,540
.لذلك فإنّ طاقتنا السّحريّة الوطنيّة في نموّ ملحوظ

136
00:10:47,880 --> 00:10:51,430
إنّ الكمّيّة الّتي نجمعها لها علاقة
،بسعادة مواطنينا

137
00:10:51,430 --> 00:10:54,940
،لذلك كلّما كان شعبنا سعيدًا
.تطوّرت أمّتنا أكثر وأكثر

138
00:10:55,860 --> 00:10:56,960
!حسنًا

139
00:10:57,550 --> 00:11:01,920
!سأقود الجميع للوصول إلى قمّة السّعادة

140
00:11:14,160 --> 00:11:16,510
!يا لونيوس! ما الّذي تفعله؟

141
00:11:17,470 --> 00:11:19,770
.لا وقت لدينا لنضيّعه

142
00:11:19,770 --> 00:11:22,340
.هذا مكان نتضرّع فيه إلى الإله

143
00:11:22,340 --> 00:11:24,620
.الزم الصّمت رجاءً يا سيّد فيردل

144
00:11:25,870 --> 00:11:28,180
تضرّعتَ بما يكفي، صحيح؟

145
00:11:28,180 --> 00:11:29,110
—نحتاج لـ

146
00:11:29,110 --> 00:11:30,870
ماذا؟ ما هذا؟

147
00:11:33,960 --> 00:11:36,290
تستعمل خاتم زواجك كتميمة حماية؟

148
00:11:36,290 --> 00:11:38,700
لديك ابنة أيضًا، صحيح؟

149
00:11:38,700 --> 00:11:41,260
ما كان اسمك زوجتك وابنتك؟

150
00:11:41,620 --> 00:11:44,160
.لا علاقة لذلك بمهمّتنا

151
00:11:44,160 --> 00:11:46,000
.لا تتصرّف كأنّنا غرباء

152
00:11:46,000 --> 00:11:48,390
.إنّ فارسًا مقدّسًا أعلى يسألك سؤالاً هنا

153
00:11:49,820 --> 00:11:52,850
.زوجتي هي مارشا، وابنتي مينا

154
00:11:54,420 --> 00:11:56,900
.حسنًا، سنسافر معًا لبضعة أيّام

155
00:11:56,900 --> 00:12:02,310
سأضايقك إن سمعتك تردّد اسم
.زوجتك أو ابنتك في نومك

156
00:12:04,050 --> 00:12:05,280
.لا تتجهّم هكذا

157
00:12:05,700 --> 00:12:09,520
تقول الكثير من الشّائعات
.أنّه فظّ وغير مهذّب

158
00:12:10,140 --> 00:12:12,960
.ومع ذلك، فإنّ مهاراته وإنجازاته حقيقيّة

159
00:12:13,300 --> 00:12:16,920
ولكن لماذا يرسلونني إلى القارّة المظلمة؟

160
00:12:16,920 --> 00:12:21,680
.للتّحقيق في رؤيا رأتها القدّيسة سوالينا

161
00:12:21,680 --> 00:12:23,020
،إذا نجحنا

162
00:12:23,020 --> 00:12:26,150
فسنكون محلّ تقدير من قِبل
.مؤتمر المقاطعات الجنوبيّة

163
00:12:26,150 --> 00:12:31,270
وإذا فشلنا، سيتمّ تحميلي
.المسؤوليّة كفارس مقدّس مساعد

164
00:12:32,590 --> 00:12:36,320
هذه قوّات ضعيفة جدًّا للتّحقيق
.في رؤيا للقدّيسة

165
00:12:36,320 --> 00:12:38,330
،أنا وأنت الفارسان المقدّسان الوحيدان

166
00:12:38,330 --> 00:12:40,520
وقالوا لنا أن نُكمل العدد
.باستخدام المرتزقة

167
00:12:40,520 --> 00:12:43,430
من النّادر جدًّا إجراء تحقيق
،خارج الحدود الوطنيّة

168
00:12:43,430 --> 00:12:45,840
وليس هناك معايير واضحة لحجم
.القوّات الّتي تمّ نشرها

169
00:12:45,840 --> 00:12:48,910
.أتساءل ما الّذي يفكّر فيه الرّؤساء

170
00:12:49,520 --> 00:12:51,290
،حتّى مع الكهنوت والفُرسان المقدّسين

171
00:12:51,290 --> 00:12:55,120
من الصّعب معرفة ما الّذي يدور في ذهن
.الرّؤساء وهم يعملون وراء الكواليس

172
00:12:55,120 --> 00:13:00,160
لا بدّ أنّ لديهم سببًا ما لإجباره على
.الانضمام إليّ قبل رحلتي مباشرة

173
00:13:00,160 --> 00:13:00,880
...ولكن

174
00:13:02,520 --> 00:13:06,260
.يا لونيوس، كنّا في انتظارك يا رجل

175
00:13:06,620 --> 00:13:09,940
!عجبًا! هل هؤلاء هم المرتزقة الّذين جنّدتهم؟

176
00:13:09,940 --> 00:13:11,130
!أحسنت عملاً

177
00:13:11,800 --> 00:13:14,390
!حسنًا! لننهِ هذه المسألة

178
00:13:15,100 --> 00:13:17,840
.رغم سلوكه، فهو لا يزال فارسًا مقدّسًا أعلى

179
00:13:17,840 --> 00:13:20,930
أظنّ أنّه سيزيد من فرص نجاتنا
.في هذه المهمّة

180
00:13:23,070 --> 00:13:24,320
،أيّها الملك الجليل والعظيم

181
00:13:24,320 --> 00:13:28,780
.نشعر بامتنانٍ بالغ لقيامك بتفقّدنا اليوم

182
00:13:29,840 --> 00:13:31,620
!هذا مذهل

183
00:13:39,340 --> 00:13:41,780
لطالما رأيت بدايات حضارتنا في اللّعبة

184
00:13:41,780 --> 00:13:45,180
،وهي تتطوّر شيئًا فشيئًا مرّات عدّة من قبل

185
00:13:46,490 --> 00:13:49,510
لكن أن أراها تنبض بالحياة على
.أرض الواقع هو شعور مختلف

186
00:13:50,010 --> 00:13:51,690
.تلك هي منطقتنا السّكنيّة

187
00:13:51,690 --> 00:13:54,720
،إنّنا نتخصّص في بناء المنازل فوق الأشجار

188
00:13:54,720 --> 00:13:57,480
،لكن بما أنّنا نُعطي الأولويّة حاليًّا لأشجار اللّحم

189
00:13:57,480 --> 00:13:59,810
.لم نُحرز تقدّمًا كبيرًا في بناء البيوت

190
00:14:00,200 --> 00:14:03,200
،كما أنّ أشجار اللّحم تنمو بوتيرة جيّدة

191
00:14:03,200 --> 00:14:05,320
.وسننتهي قريبًا من مستودع الطّعام

192
00:14:06,090 --> 00:14:09,450
ويقود الشّيخ مولتار في معهد أبحاث السّحر

193
00:14:09,450 --> 00:14:14,160
العديد ممّن يملكون موهبة
.في السّحر لبدء البحوث فورًا

194
00:14:14,660 --> 00:14:18,340
استطعنا اكتشاف نبع ماء قريبًا
،لتأمين مصدر دائم

195
00:14:18,340 --> 00:14:20,670
.ونُجري حاليًّا دراسة لإنشاء قناة مائيّة

196
00:14:21,090 --> 00:14:23,600
،أمّا هذا المبنى حيث يقيم ملكنا

197
00:14:23,600 --> 00:14:26,270
فهو أيضًا مقرّ الإدارة العامّة
.لتقديم المعاملات الورقيّة

198
00:14:26,270 --> 00:14:30,680
أعلم أنّ نظام حكم ماينوغورا
،يستحقّ مقرًّا أكثر مهابة

199
00:14:31,360 --> 00:14:34,930
،لكنّ هذا أقصى ما يمكننا إنجازه
.لذلك هو بهذا الحجم حاليًّا

200
00:14:34,930 --> 00:14:36,720
.قرار حكيم للغاية

201
00:14:36,720 --> 00:14:38,780
،كما أنّها أنجزت مهامًا لم أُصدر بها أوامر

202
00:14:38,780 --> 00:14:42,370
،مثل تأمين مصدر للمياه
.وهذا أمر أقدّره بشدّة

203
00:14:42,370 --> 00:14:43,570
...لكنّ الأهم من ذلك

204
00:14:44,220 --> 00:14:47,860
هؤلاء الإلف المظلمين الّذين
كانوا هزيلين حين التقيتهم

205
00:14:47,860 --> 00:14:50,020
.صاروا اليوم مفعمين بالحياة

206
00:14:50,020 --> 00:14:52,420
،صحيح أنّني منحتهم تلك الفرصة

207
00:14:53,470 --> 00:14:55,830
.لكنّ رؤيتهم على هذا النّحو تُسعدني كثيرًا

208
00:14:55,830 --> 00:14:58,390
عفوًا، ما رأيك؟

209
00:14:58,390 --> 00:15:02,060
نحن ننفّذ أوامرك بدافع رغبتنا في ردّ الجميل

210
00:15:02,060 --> 00:15:03,960
.لقاء الرّحمة العظيمة الّتي أظهرتها لنا

211
00:15:04,610 --> 00:15:06,220
.نعم، إنّه أمر مذهل

212
00:15:06,220 --> 00:15:07,740
.مذهل بحقّ

213
00:15:07,740 --> 00:15:10,630
.أنا سعيد لأنّني رحّبت بكم جميعًا كمواطنين

214
00:15:12,180 --> 00:15:15,180
!شـ-شكرًا جزيلاً لك

215
00:15:16,120 --> 00:15:18,390
.لا-لا تبكي

216
00:15:18,700 --> 00:15:22,000
.يا إلهي. لكنّني أتفهّم مشاعرها تمامًا

217
00:15:24,970 --> 00:15:27,880
.أرجو المعذرة على انفعالي السّابق

218
00:15:27,880 --> 00:15:30,360
اسمح لي أن أواصل إرشادك
.في جولتك التّفقّديّة

219
00:15:30,880 --> 00:15:33,560
.سعيد لأنّها استعادت رباطة جأشها

220
00:15:33,560 --> 00:15:35,790
،لم يسبق لفتاة أن بَكَت بسببي من قبل

221
00:15:35,790 --> 00:15:37,330
.لذلك أربكني الأمر فعلاً

222
00:15:37,900 --> 00:15:41,750
أوشكت أشجار اللّحم هنا
.على أن تكون جاهزة للحصاد

223
00:15:42,110 --> 00:15:45,710
،أعلم أنّنا كنّا نعتمد عليك فيها
لكنّ كلّ شيء يسير بسلاسة

224
00:15:45,710 --> 00:15:48,960
بفضل الأدوات والمعدّات الزّراعيّة
.عالية الجودة الّتي وفّرتها لنا

225
00:15:49,330 --> 00:15:51,490
سأواصل تزويدكم بالأدوات
.في الوقت الحاليّ

226
00:15:51,490 --> 00:15:54,220
يقلقني أن تكون جودتها سيّئة
.إن صنعوها بأنفسهم

227
00:15:54,220 --> 00:15:56,940
.سيساعد ذلك على التّقدّم بسرعة

228
00:15:56,940 --> 00:15:58,570
.إنّه أشبه بالغشّ

229
00:15:58,570 --> 00:16:02,000
استعمال قدرات تبدو كالغشّ
!لفرض السّيطرة ممتع للغاية

230
00:16:02,000 --> 00:16:04,440
!يا لشرّك أيّها الملك تاكُتو

231
00:16:07,110 --> 00:16:09,940
.أشعر أنّي نضجتُ بما يكفي للأكل

232
00:16:16,510 --> 00:16:17,250
!نعم

233
00:16:17,250 --> 00:16:20,410
.سـ-سأرافقكما الآن إلى مصدر المياه

234
00:16:21,150 --> 00:16:23,330
ماذا؟ ما الّذي يحدث؟

235
00:16:23,330 --> 00:16:24,930
تبدو الغابة غريبة؟

236
00:16:24,930 --> 00:16:26,960
...مهلاً، هذا هو

237
00:16:30,520 --> 00:16:33,520
...النّبع الّذي وجدناه أخيرًا قد

238
00:16:33,520 --> 00:16:35,590
ما الخطب يا إيمل؟

239
00:16:35,590 --> 00:16:40,800
يا لها من مفاجأة أن تشرّفنا
.بتفقُّد شخصيّ يا ملكنا

240
00:16:40,800 --> 00:16:45,130
أتيتُ لأرى إمكانيّة بناء قناة ماء
...بعد أن أخبرتني إيمل، ولكن

241
00:16:45,130 --> 00:16:48,110
.هذه المياه... لم تَعُد صالحة

242
00:16:48,640 --> 00:16:49,670
.سألقي نظرة

243
00:16:50,620 --> 00:16:53,520
...ليس وهي بهذا اللّون

244
00:16:53,520 --> 00:16:55,360
.لا، إنّها صالحة

245
00:17:00,740 --> 00:17:01,750
!لذيذة جدًّا

246
00:17:02,110 --> 00:17:02,790
!ماذا؟

247
00:17:03,120 --> 00:17:04,500
!ما-ماذا؟

248
00:17:04,830 --> 00:17:07,150
،"يُسمّى هذا "المجال الملعون

249
00:17:07,150 --> 00:17:10,520
وهذا دليل على أنّ هذه الأرض
.صارت جزءًا من أراضي ماينوغورا

250
00:17:11,180 --> 00:17:12,510
.جرّبوا أن تأخذوا نفسًا عميقًا

251
00:17:16,320 --> 00:17:19,590
.أشعر بأنّ ذهني قد أصبح أكثر صفاءً

252
00:17:19,590 --> 00:17:21,600
!وأنا أشعر بقوّةٍ تتدفّق في جسدي

253
00:17:22,030 --> 00:17:25,020
!أشعر بانتعاشٍ شديد

254
00:17:25,020 --> 00:17:28,700
يمنح المجال الملعون مزايا للكائنات الشّرّيرة

255
00:17:28,700 --> 00:17:32,280
.ويفرض عوائق على المحايدين والخيّرين

256
00:17:32,800 --> 00:17:35,770
،وبما أنّكم أصبحتم مواطنين في ماينوغورا

257
00:17:35,770 --> 00:17:38,740
.فقد تحوّلتم من محايدين إلى أشرار

258
00:17:38,740 --> 00:17:41,310
،أي أنّكِ تقولين أنّها ليست آمنة فقط

259
00:17:41,310 --> 00:17:44,710
بل وتُهيِّئ لنا بيئة أكثر راحةً للعيش أيضًا؟

260
00:17:44,710 --> 00:17:46,480
...إذًا هذه المياه أيضًا

261
00:17:48,770 --> 00:17:51,160
!أستطيع شربها بشكل طبيعيّ

262
00:17:52,140 --> 00:17:55,940
.المجال الملعون مثاليّ تمامًا للدّفاع

263
00:17:55,940 --> 00:17:58,790
وقريبًا، ستتحوّل كلّ أراضي
.مملكتنا إلى هذا الشّكل

264
00:17:58,790 --> 00:18:01,550
.وهذا أيضًا من ثمار قوّة ملكنا

265
00:18:01,550 --> 00:18:06,180
،كما هو متوقّع من ملكنا العظيم
.إنّها قوّة مذهلة حقًّا

266
00:18:06,180 --> 00:18:08,690
.لكنّها تنطوي على مشكلةٍ واحدة فقط

267
00:18:09,870 --> 00:18:13,360
.إنّها تجلب الأنظار إليها بشكل واضح

268
00:18:14,330 --> 00:18:18,570
في الوقت الحالي، يكفينا أن نوفّر
،مراقبةً دقيقةً على المنطقة المحيطة

269
00:18:18,570 --> 00:18:20,560
،لكن إن أصبحت المنطقة بأسرها هكذا

270
00:18:20,560 --> 00:18:23,370
.فسيُصبح من السّهل على أعدائنا اكتشافنا

271
00:18:23,760 --> 00:18:25,830
.علينا أن نبدأ في تشكيل جيش

272
00:18:26,140 --> 00:18:28,170
.يا لقلقكم الشّديد

273
00:18:28,170 --> 00:18:31,460
.سيُنتج ملكنا بطلاً، لذا لا داعي للقلق

274
00:18:31,460 --> 00:18:33,200
،مع كلّ احترامي

275
00:18:33,200 --> 00:18:37,590
ما زلنا لا نفهم ما هو البطل
.رغم ما شرحته لنا ذلك اليوم

276
00:18:38,070 --> 00:18:40,660
.سيكون من الأسرع أن تروا بأمّ أعينكم

277
00:18:40,660 --> 00:18:43,520
.مرّت عدّة أيّام منذ وصولنا إلى هنا

278
00:18:43,520 --> 00:18:45,350
.وهو وقت كافٍ لهذا

279
00:19:00,910 --> 00:19:04,550
.نسيت أن أخبركم، لكنّني أنا أيضًا بطلة

280
00:19:08,380 --> 00:19:11,900
ما رأيتموه لم يكن سوى جزء من
،المائة ممّا يمكنني فعله في أوجي

281
00:19:11,900 --> 00:19:17,340
لكن أولئك الّذين يُطلق عليهم الأبطال
.يملكون قوّة تخوّلهم محو جيوش كاملة

282
00:19:17,690 --> 00:19:19,290
.قوّة الأبطال خارقة

283
00:19:19,290 --> 00:19:20,400
،إنّهم لا يجلبون الأنظار

284
00:19:20,400 --> 00:19:24,100
ويواصلون اكتساب القوّة مع مرور
.الوقت حتّى من دون أن يفعلوا شيئًا

285
00:19:24,530 --> 00:19:27,940
يزدادون قوّةً فقط مع مرور الوقت؟

286
00:19:27,940 --> 00:19:32,560
أيّ أنّ السّيّدة أتو ستُصبح
!أقوى من هذا في المستقبل؟

287
00:19:32,560 --> 00:19:34,110
.هذا صحيح

288
00:19:34,110 --> 00:19:35,930
،طالما نحن نخطّط للبقاء في عزلة

289
00:19:35,930 --> 00:19:39,610
.فقوّتي كافية لاحتياجاتنا الحاليّة

290
00:19:41,170 --> 00:19:42,240
.أتو

291
00:19:42,240 --> 00:19:44,030
!نعم يا ملكي؟

292
00:19:44,030 --> 00:19:48,420
لم يكن عليك تدمير الغابة لمجرّد
استعراض قوّتك، صحيح؟

293
00:19:48,420 --> 00:19:50,370
يمكنك تأجيل الأمر، لكن احرصي
.على تنظيفها لاحقًا

294
00:19:52,890 --> 00:19:54,040
.حاضرة

295
00:19:54,040 --> 00:19:56,880
!سـ-سنساعدك أيضًا

296
00:19:56,880 --> 00:19:59,680
!كان ذلك مدهشًا حقًّا

297
00:19:59,680 --> 00:20:03,280
ومرّة أخرى، أنا مجبور على الاعتراف
،بعظمة قوّتك يا سيّدتي أتو

298
00:20:03,280 --> 00:20:06,590
!وبقوّة الملك إيرا تاكُتو العظيمة كذلك

299
00:20:06,590 --> 00:20:10,850
أعتقد أنّه من الضّروريّ
!أن نبني قصرًا يليق بملكنا

300
00:20:11,260 --> 00:20:13,760
.لا، لا نحتاج لقصر

301
00:20:13,760 --> 00:20:15,400
.أنا مرتاح في منزلٍ يشبه منازل الآخرين

302
00:20:15,400 --> 00:20:17,560
!هذا لا يليق بك

303
00:20:17,560 --> 00:20:19,790
هل تظنّ أنّ بإمكاننا قبول فكرة
أن يعيش ملكنا

304
00:20:19,790 --> 00:20:21,900
!في منزلٍ كمنزل أيٍّ منّا؟

305
00:20:22,270 --> 00:20:24,610
!لن نتمكّن من النّوم بسبب شعورنا بالذّنب

306
00:20:25,060 --> 00:20:31,830
أعلم أنّ من الوقاحة الاعتراض على رأيك
!السّامي، لكن أرجو أن تعيد النّظر

307
00:20:33,130 --> 00:20:35,310
،عفوًا أيّها الملك تاكُتو

308
00:20:35,310 --> 00:20:38,720
،قد تكون كلفة بناء القصر كبيرة
،لكنّه يُنتِج الموارد

309
00:20:38,720 --> 00:20:41,840
.ويبدو أنّه يزيد من سعادة المواطنين أيضًا

310
00:20:42,220 --> 00:20:43,970
.في هذه الحالة، فلنقم ببنائه

311
00:20:45,510 --> 00:20:46,680
!أجل

312
00:20:47,140 --> 00:20:49,730
أرغب في الحصول على القلعة
،الطّافية يومًا ما

313
00:20:49,730 --> 00:20:52,020
.لذا قد يكون من الجيّد أن نبدأ مبكّرًا

314
00:20:52,540 --> 00:20:55,720
الإرث الوطنيّ الّذي يُمكن بناؤه
عند بلوغ المدينة أقصى مستوى؟

315
00:20:55,720 --> 00:20:57,480
إنّه حلم الجميع بالفعل، أليس كذلك؟

316
00:20:57,480 --> 00:20:59,550
قلعة طافية؟

317
00:20:59,550 --> 00:21:01,820
.إنّها مدينةٌ تُحلّق في السّماء

318
00:21:01,820 --> 00:21:04,720
!مدينة... في السّماء؟

319
00:21:04,720 --> 00:21:07,910
.أمرٌ يفوق خيالنا، لا أستطيع حتّى تصوّره

320
00:21:08,300 --> 00:21:12,920
...لكنّ ملكنا حقّق كلّ ما وعد به حتّى الآن

321
00:21:12,920 --> 00:21:14,960
...وهذا يعني أنّه حتّى المدينة الطّافية

322
00:21:17,140 --> 00:21:19,350
جميعنا نحن الإلف المظلمين

323
00:21:19,350 --> 00:21:24,170
!نجدّد عهدنا لملكنا بكلّ شبر فينا

324
00:21:24,170 --> 00:21:26,380
!المجد للملك إيرا تاكُتو

325
00:21:26,380 --> 00:21:29,100
!عسى أن تزدهر ماينوغورا إلى الأبد

326
00:21:32,900 --> 00:21:34,980
...أيّها الملك تاكُتو، في الوقت الحاليّ

327
00:21:35,410 --> 00:21:36,380
.نعم

328
00:21:36,380 --> 00:21:38,550
،تسير عملية تأسيس أمّتنا بسلاسة

329
00:21:38,550 --> 00:21:40,850
!فلنواصل على هذا النّحو

330
00:21:46,580 --> 00:21:48,110
هل انتهيت من القضاء عليهم؟

331
00:21:49,270 --> 00:21:50,450
.انتهيت

332
00:21:50,450 --> 00:21:52,880
.جيّد! لنسارع بالمضيّ قدمًا

333
00:21:54,230 --> 00:21:57,080
.لا حاجة لتدخّلنا من الأساس

334
00:21:57,810 --> 00:22:00,920
.حسنًا، ما هذه إلاّ البداية

335
00:22:04,800 --> 00:22:08,740
آمل أن يستمرّ تقدّمنا بهذه
.الوتيرة في القارّة المظلمة