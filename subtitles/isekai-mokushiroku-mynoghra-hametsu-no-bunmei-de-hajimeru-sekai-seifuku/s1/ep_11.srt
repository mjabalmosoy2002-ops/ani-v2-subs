1
00:00:01,680 --> 00:00:06,020
...يحيا... ملك الشّياطين

2
00:00:08,270 --> 00:00:10,400
!يا لها من فوضى مخزية

3
00:00:10,720 --> 00:00:13,340
!يفترض أن أكون بطلة الملك تاكُتو

4
00:00:16,260 --> 00:00:19,550
!في كلّ الأحوال، حان وقت إرسال تقرير

5
00:00:19,550 --> 00:00:21,540
!أيّها الملك تاكُتو، لقد انتهيت

6
00:00:21,540 --> 00:00:23,370
،كان العدوّ واحدًا من الجنرالات الأربعة

7
00:00:23,370 --> 00:00:25,690
،ومع أنّي تكبّدتُ إصابة خفيفة

8
00:00:25,690 --> 00:00:26,880
—قضيتُ عليه بالكامل

9
00:00:27,280 --> 00:00:28,090
!ماذا؟

10
00:00:35,260 --> 00:00:38,060
!ثمّة عدوّ في ماينوغورا؟

11
00:01:12,760 --> 00:01:16,010
.يا لها من أرض جميلة ورائعة

12
00:01:17,000 --> 00:01:18,700
...كلّ هذا

13
00:02:58,450 --> 00:02:59,490
!يا ملكي

14
00:03:00,450 --> 00:03:02,570
!دخلت قوّات العدوّ للأراضي الملعونة

15
00:03:02,940 --> 00:03:04,910
.نعم، أعلم ذلك

16
00:03:05,530 --> 00:03:07,170
.اعذرني رجاءً

17
00:03:07,170 --> 00:03:11,120
.نظرًا للوضع، ظننتُ أنّ عليّ التّبليغ عنه

18
00:03:11,120 --> 00:03:16,500
لا بأس، يملك ملكنا القوّة لمعرفة
.كلّ شيء يحدث في منطقته

19
00:03:16,920 --> 00:03:21,210
،إنّ قوّاتنا الرّئيسيّة، إضافة إلى غيا
.قد انطلقوا سلفًا

20
00:03:21,210 --> 00:03:24,240
،سننتقل إلى المنطقة السّكنيّة أيضًا

21
00:03:27,220 --> 00:03:29,650
!حاضر! مفهوم

22
00:03:30,680 --> 00:03:32,080
...أيّها الملك

23
00:03:32,560 --> 00:03:33,650
هل الأوضاع خطيرة؟

24
00:03:33,970 --> 00:03:36,110
.لا، نحن بخير

25
00:03:36,110 --> 00:03:39,270
.أنا هنا مع السّيّد قبل كلّ شيء

26
00:03:39,270 --> 00:03:42,070
.لا يوجد ما يدعو للقلق

27
00:03:42,400 --> 00:03:45,910
.لكنّ الوضع غير سارّ نوعًا ما

28
00:03:45,910 --> 00:03:47,040
.نعم

29
00:03:47,040 --> 00:03:50,040
.لم أعتقد أبدًا أنّهم سيهاجموننا هنا

30
00:03:50,040 --> 00:03:51,540
ماذا علينا أن نفعله؟

31
00:03:51,920 --> 00:03:54,160
،هناك فرصة بأن يكون قائد العدوّ

32
00:03:54,160 --> 00:03:58,560
،المدعوّ ملك الشّياطين هذا
.لاعبًا آخر مثلك يا سيّدي

33
00:03:58,560 --> 00:04:00,490
وماذا إن كان كذلك؟

34
00:04:01,130 --> 00:04:04,380
.لا يهمّ إن كان لاعبًا أم لا

35
00:04:04,380 --> 00:04:07,040
.سيكون السّلام بيننا صعبًا في هذه المرحلة

36
00:04:07,040 --> 00:04:10,770
.سبق وأطاحت أتو بأحد جنرالاتهم أيضًا

37
00:04:11,580 --> 00:04:14,560
.سنسحقهم بكلّ قوّتنا يا إيسلا

38
00:04:14,990 --> 00:04:18,400
.سمعًا وطاعة يا ملكي

39
00:04:19,000 --> 00:04:22,230
.حسنًا، لنُطلق هجومنا المضاد

40
00:04:26,240 --> 00:04:28,450
.لنتأكّد من قوّاتنا

41
00:04:29,270 --> 00:04:31,500
.أوّلاً، لدينا أنت يا إيسلا

42
00:04:31,500 --> 00:04:36,790
.نعم. لن ألحق العار بلقبي كبطلة الدّفاع

43
00:04:37,900 --> 00:04:41,330
ولدينا أيضًا محاربو الإلف
.المظلمين بقيادة غيا

44
00:04:41,330 --> 00:04:44,090
،لا يوجد الكثير منهم
.لكنّ معنويّاتهم في أوجها

45
00:04:44,600 --> 00:04:47,730
.كما لدينا آكلي الأدمغة أيضًا

46
00:04:47,730 --> 00:04:49,410
،لدينا ثلاثة منهم فقط

47
00:04:49,410 --> 00:04:52,440
.لكنّهم يملكون قدرات شافية

48
00:04:52,440 --> 00:04:55,480
أعتقد أنّهم سيُثبتون أنّه يُعتمد
.عليهم في هذا الوضع

49
00:04:55,480 --> 00:04:56,950
!بشر

50
00:04:56,950 --> 00:05:00,540
.وفي النّهاية، لدينا اليرقات الّتي أنجبتِها

51
00:05:00,540 --> 00:05:02,660
،أنجبتُ يرقات مخصّصة للعمل

52
00:05:02,660 --> 00:05:05,670
لكن يفترض أن تكون قادرة
.على القتال لحدّ ما

53
00:05:05,670 --> 00:05:09,780
كما أنّ وجودي هنا
.يعزّز قدراتها قبل كلّ شيء

54
00:05:11,430 --> 00:05:17,500
ربّما كان عليّ توقّع هذا
.وإنجاب بعض اليرقات المقاتلة

55
00:05:17,500 --> 00:05:20,210
.لا فائدة من التّفكير في ذلك الآن

56
00:05:20,210 --> 00:05:21,590
!هذا صحيح

57
00:05:21,590 --> 00:05:24,100
!الجميع ممتنّ لليرقات

58
00:05:24,100 --> 00:05:25,170
!نعم، نعم

59
00:05:25,170 --> 00:05:27,530
.عجبًا، شكرًا لكما

60
00:05:27,530 --> 00:05:30,430
!دعاني أحضنكما تعبيرًا عن شكري

61
00:05:36,100 --> 00:05:36,920
.يا ملكي

62
00:05:36,920 --> 00:05:37,870
إميل؟

63
00:05:38,820 --> 00:05:39,860
ماذا هنالك؟

64
00:05:40,160 --> 00:05:44,280
انتهينا من عمليّة إخلاء المنطقة
.ممّن لا يستطيعون القتال

65
00:05:44,280 --> 00:05:45,530
.أحسنت عملاً

66
00:05:45,530 --> 00:05:48,860
،سنتّجه إلى هناك أيضًا
.لذلك سننضمّ إليكم لاحقًا

67
00:05:49,310 --> 00:05:52,150
!عُلم. سأكون بانتظاركم

68
00:05:52,150 --> 00:05:53,090
.حاضر

69
00:05:53,090 --> 00:05:54,290
.ملكي

70
00:05:54,290 --> 00:05:55,160
غيا؟

71
00:05:55,160 --> 00:05:59,330
لديّ تقدير تقريبي لعدد الأعداء
.الّذين دخلوا الأراضي الملعونة

72
00:06:00,950 --> 00:06:06,540
كلّ من إميل وغيا قادران على التّفكير
.بنفسيهما والتّصرّف بلا أوامر منّي

73
00:06:06,540 --> 00:06:08,890
.ما كان هذا ليحدث في اللّعبة أبدًا

74
00:06:08,890 --> 00:06:11,680
.لديّ أشخاص يُعتمد عليهم تحت إمرتي

75
00:06:11,680 --> 00:06:12,510
يا ملكي؟

76
00:06:13,070 --> 00:06:14,560
.أنا آسف

77
00:06:14,560 --> 00:06:15,560
كم عددهم؟

78
00:06:15,560 --> 00:06:20,820
حاضر، أستطيع أن أرى ما يقرب
.من ألف عدوّ غزوا الأراضي الملعونة

79
00:06:20,820 --> 00:06:22,820
،إضافة للغوبلين والأورك

80
00:06:22,820 --> 00:06:26,220
.يمكنني أيضًا رؤية كائنات غير مألوفة وبشعة

81
00:06:26,220 --> 00:06:28,400
.أحسنت عملاً. شكرًا لك

82
00:06:28,800 --> 00:06:31,890
واصل التّركيز على الدّفاع
.عن المنطقة حول العاصمة

83
00:06:31,890 --> 00:06:33,990
.سأتولّى أمر العدوّ

84
00:06:33,990 --> 00:06:35,260
.هذا مفهوم

85
00:06:36,020 --> 00:06:38,000
ألف عدوّ؟

86
00:06:38,000 --> 00:06:39,750
.هذا كثير بالفعل

87
00:06:39,750 --> 00:06:41,870
على الأرجح أنّ أحد الجنرالات
.الأربعة بينهم أيضًا

88
00:06:41,870 --> 00:06:45,000
.بدأت هذه تبدو كمعركة صعبة

89
00:06:47,250 --> 00:06:50,710
،ولكن يا ملكي العظيم والجبّار

90
00:06:50,710 --> 00:06:53,390
سبق وحدّدتَ استراتيجيّتنا، صحيح؟

91
00:06:54,170 --> 00:06:57,840
إنّ موارد الطّاقة السّحريّة خاصّتنا
.هي لمثل هذه اللّحظات بالضّبط

92
00:06:57,840 --> 00:06:59,760
.إنّنا نواجه لعبة تقمّص أدوار

93
00:06:59,760 --> 00:07:03,690
حان الوقت لنظر لهم قوّة
.لعبة محاكاة قيادة دول

94
00:07:08,840 --> 00:07:12,900
إن استعملتَ ذلك، بإمكانك
.بسهولة عكس الفرق في التّعداد

95
00:07:16,670 --> 00:07:18,960
.هي آليّة مفيدة للغاية بالنّسبة لنا

96
00:07:18,960 --> 00:07:19,990
.إيسلا

97
00:07:23,090 --> 00:07:28,500
أنا أمنحك كامل احتياطيّات
.الطّاقة السّحريّة لماينوغورا

98
00:07:30,640 --> 00:07:31,540
ماذا؟

99
00:07:36,990 --> 00:07:41,580
:احرصي على الحصول على مهارَتَيْ
.الافتراس والبيض الطّفيليّ

100
00:07:42,670 --> 00:07:46,860
...ثمّ استعملي تلك القوّة للتّفوّق

101
00:07:50,130 --> 00:07:51,840
!على كلّ أعدائنا

102
00:08:00,820 --> 00:08:02,610
!عجبًا، عجبًا، عجبًا

103
00:08:02,610 --> 00:08:05,470
!يا لك من شخص قاس وحاقد الآن

104
00:08:05,470 --> 00:08:09,210
!تعهد لي بكلّ شيء في مثل هذه الأزمة

105
00:08:09,610 --> 00:08:14,320
لديّ نظرة عامّة سلفًا عن قوّات
.عدوّنا من معركة دراغونتان

106
00:08:14,320 --> 00:08:16,270
،حتّى إن كان أحد الجنرالات الأربعة هناك

107
00:08:16,270 --> 00:08:19,310
فستكونين أكثر من قادرة
.على التّعامل معه الآن

108
00:08:19,810 --> 00:08:25,560
هلاّ أريتني لماذا تُعرفين ببطلة دفاعنا؟

109
00:08:25,840 --> 00:08:28,270
.نعم، بكلّ سرور

110
00:08:29,710 --> 00:08:32,320
،أنا ملكة الحشرات إيسلا

111
00:08:32,320 --> 00:08:35,920
سأرتقي إلى تطلّعاتك

112
00:08:35,920 --> 00:08:38,910
.وسأهزم كلّ أعدائنا من أجلك

113
00:08:42,560 --> 00:08:44,540
،واثق أنّك ستكونين بخير

114
00:08:44,540 --> 00:08:48,320
لكن احذري من أيّ هجمات شائعة
.في آليّات لعبة تقمّص الأدوار

115
00:08:49,840 --> 00:08:53,880
بالتّفكير في ذلك، لقد أخذوا
أتو على حين غرّة، صحيح؟

116
00:08:53,880 --> 00:08:55,440
.مفهوم

117
00:08:55,440 --> 00:08:57,550
.سأكون حذرة

118
00:08:58,010 --> 00:08:59,680
...أمّي

119
00:08:59,680 --> 00:09:02,000
.لا تنظرا إليّ هكذا

120
00:09:02,000 --> 00:09:04,120
.سأحرص على العودة للمنزل

121
00:09:04,120 --> 00:09:05,520
قطعتُ وعدًا لكما، صحيح؟

122
00:09:05,820 --> 00:09:06,590
!نعم

123
00:09:06,590 --> 00:09:09,480
!سنهتمّ بأمر الملك وسننتظرك

124
00:09:10,370 --> 00:09:11,490
.شكرًا لكما

125
00:09:11,490 --> 00:09:12,410
!العفو

126
00:09:17,560 --> 00:09:19,950
!والآن، سأذهب

127
00:09:32,940 --> 00:09:35,550
.يا لها من غابة مريبة

128
00:09:35,550 --> 00:09:41,920
لماذا كان علينا الانفصال عن السّيّد
أيس روك وغزو هذا المكان وحدنا؟

129
00:09:41,920 --> 00:09:43,780
...بخصوص ذلك

130
00:09:43,780 --> 00:09:44,520
ماذا؟

131
00:09:44,990 --> 00:09:49,610
ثمّة فرصة كبيرة بأنّ هذه العمليّة
.لا تحدث بموافقة من ملك الشّياطين

132
00:09:49,610 --> 00:09:50,860
!ماذا؟

133
00:09:51,150 --> 00:09:54,610
.ربّما يخطّط الزّعيم لخيانة ملك الشّياطين

134
00:09:54,610 --> 00:09:57,610
فعلاً؟! لماذا قد يفعل ذلك؟

135
00:09:57,610 --> 00:10:01,330
هل تذكر مجيئنا إلى هذا العالم أوّل مرّة؟

136
00:10:01,330 --> 00:10:02,490
.نعم

137
00:10:02,490 --> 00:10:06,290
كنّا جميعًا في نفس المكان خلال لحظة، صحيح؟

138
00:10:07,060 --> 00:10:10,280
يبدو أنّ الأمر كان مختلفًا بالنّسبة
.للزّعيم وملك الشّياطين

139
00:10:10,280 --> 00:10:11,130
ماذا؟

140
00:10:15,870 --> 00:10:17,640
مستطلعون؟

141
00:10:17,640 --> 00:10:20,140
.مهلاً! ثمّة شيء ما ليس في محلّه

142
00:10:23,510 --> 00:10:27,430
ما-ما الّذي يحدث لي؟

143
00:10:29,650 --> 00:10:32,110
!ما الّذي يجري لك؟

144
00:10:32,540 --> 00:10:35,010
...أ-أنا

145
00:10:37,210 --> 00:10:38,800
!قف مكانك

146
00:10:42,740 --> 00:10:44,440
!ما هذه الأشياء؟

147
00:10:51,390 --> 00:10:52,940
!سُحقًا! تراجعوا

148
00:10:52,940 --> 00:10:54,800
!تراجعوا ورتّبوا صفوفكم

149
00:10:54,800 --> 00:10:56,250
!حا-حاضر

150
00:10:56,250 --> 00:10:59,590
.عجبًا، كم هذا مثير للشّفقة

151
00:10:59,590 --> 00:11:00,550
!من هناك؟

152
00:11:01,430 --> 00:11:03,700
تتراجعون لهذا السّبب الصّغير؟

153
00:11:03,700 --> 00:11:08,020
،جميعكم جزء من جيش ملك الشّياطين
قوّات الظّلام، أليس كذلك؟

154
00:11:08,020 --> 00:11:09,520
!أين أنت؟

155
00:11:09,520 --> 00:11:11,400
!أظهري نفسك

156
00:11:12,380 --> 00:11:14,190
،إن كنتم قوّات ظلام

157
00:11:20,800 --> 00:11:26,700
.فعليكم أن تكونوا أكثر جمالاً وقسوة وشمولاً

158
00:11:38,940 --> 00:11:41,540
إنّهم ليسوا مغذّين، صحيح؟

159
00:11:41,540 --> 00:11:44,310
.أعتقد أنّي سأقدّم لهم ثلاثين

160
00:11:45,770 --> 00:11:48,350
.أتحدّث عن أتباعك

161
00:11:50,680 --> 00:11:54,150
نعم، نعم. هذا كلام فظيع
.لتقولينه عنهم

162
00:12:01,140 --> 00:12:03,280
.قدّمي نفسك أيّتها الوحش

163
00:12:03,280 --> 00:12:09,140
أنا أخدم مملكة ماينوغورا الّتي يحكمها
.ملك الخراب العظيم، الملك إيرا تاكُتو

164
00:12:09,140 --> 00:12:14,250
.أنا إحدى أبطاله، ملكة الحشرات إيسلا

165
00:12:15,000 --> 00:12:16,040
ومن أنت؟

166
00:12:16,380 --> 00:12:21,090
واحد من جنرالات جيش ملك الشّياطين
.الأربعة، شيطان اللّهب

167
00:12:24,010 --> 00:12:25,860
!الجنرالات الأربعة

168
00:12:25,860 --> 00:12:27,970
!كان هنالك أحدكم هنا بالفعل

169
00:12:28,450 --> 00:12:29,350
ماذا؟

170
00:12:29,690 --> 00:12:36,080
توقّعتُ وجود أحد القادة هنا
.مع جيش بهذا الحجم

171
00:12:36,080 --> 00:12:39,230
.تمامًا مثل أيس روك في دراغونتان

172
00:12:41,120 --> 00:12:43,990
وماذا في ذلك؟ هل تمّت الإطاحة به؟

173
00:12:44,310 --> 00:12:46,160
.لستُ متفاجئًا

174
00:12:46,160 --> 00:12:48,800
.كان مجرّد مغفّل مفتول العضلات

175
00:12:48,800 --> 00:12:51,360
عجبًا، ألم يكن أحد حلفائك؟

176
00:12:51,360 --> 00:12:53,660
.طريقة تحدّثك عنه فظيعة

177
00:12:55,120 --> 00:12:57,950
.كان الأضعف بيننا نحن الجنرالات الأربعة

178
00:12:57,950 --> 00:13:00,850
.وأنا أفوقه بدرجتين

179
00:13:00,850 --> 00:13:04,630
لذلك إن اعتقدتِ أنّي سأُهزم
.بسهولة مثله، فأنت مخطئة

180
00:13:04,630 --> 00:13:08,890
.عجبًا، تبدو واثقًا جدًّا من نفسك

181
00:13:12,230 --> 00:13:13,550
.أكيد

182
00:13:13,550 --> 00:13:19,270
سيكون من السّهل بالنّسبة لي أن أقتلك
.وأجرّ ذلك الملك خلفك من عرشه

183
00:13:19,270 --> 00:13:21,390
بماذا ناديته؟

184
00:13:21,390 --> 00:13:23,740
الملك إيرا تاكُتو، صحيح؟

185
00:13:27,280 --> 00:13:30,870
.هذا كلام كبير على حثالة مثلك

186
00:13:30,870 --> 00:13:33,990
.لا تغترّي بنفسك أيّتها الذّبابة

187
00:13:54,740 --> 00:13:56,350
هل بدأ الأمر إذًا؟

188
00:13:56,990 --> 00:14:01,310
.تخوض إيسلا قتالاً مع شيطان اللّهب فليماين

189
00:14:01,950 --> 00:14:05,530
عندما تواجه شخصيّةُ لعبةِ تقمّص أدوار
،مع شخصيّات لعبةِ محاكاة قيادة دول

190
00:14:05,850 --> 00:14:09,950
فإنّ شخصيّات لعبة المحاكاة تكون
.أقوى بشكل كبير في القتال

191
00:14:10,260 --> 00:14:13,490
.سبق وتأكّدنا من ذلك في معركة دراغونتان

192
00:14:13,490 --> 00:14:15,700
.إنّها مسألة وقت فحسب قبل أن تهزمه

193
00:14:16,590 --> 00:14:19,850
اليرقات الّتي لا تشارك في القتال ضدّ فليماين

194
00:14:19,850 --> 00:14:24,120
تقوم بدوريّات في الأراضي
.الملعونة وتهزم الغزاة

195
00:14:24,710 --> 00:14:29,130
غيا والمحاربين منتشرون
.في تشكيلات دفاعيّة حول العاصمة

196
00:14:29,130 --> 00:14:32,940
تتولّى إميل أمر الإلف المظلمين
.الّذين أخلوا المنطقة

197
00:14:33,460 --> 00:14:38,030
.آكلو الأدمغة مستعدّون على مقربة

198
00:14:38,030 --> 00:14:42,020
...يسير كلّ شيء بسلاسة
.بشكل نظريّ على الأقلّ

199
00:14:45,320 --> 00:14:46,800
يا ملكي؟

200
00:14:46,800 --> 00:14:48,950
ما الّذي تفكّر فيه؟

201
00:14:48,950 --> 00:14:51,580
أتساءل ما الأمر؟

202
00:14:51,580 --> 00:14:54,840
...ثمّة شيء يزعجني

203
00:14:55,550 --> 00:14:59,290
هل هنالك ما يلفت انتباهكما؟

204
00:15:12,440 --> 00:15:13,740
!سُحقًا

205
00:15:13,740 --> 00:15:15,190
!هذا جنونيّ

206
00:15:15,190 --> 00:15:19,430
لم أكن أعلم أنّ هنالك وحوشًا
!مثلك في هذا العالم

207
00:15:22,390 --> 00:15:24,850
.إنّ وصفي بالوحش فظّ للغاية

208
00:15:30,530 --> 00:15:33,720
إنّه بكلّ تأكيد ليس مصطلحًا
.قد تصف به امرأة

209
00:15:34,210 --> 00:15:34,950
ألا توافقني؟

210
00:15:44,630 --> 00:15:46,850
!يا لك من حقيرة

211
00:15:48,860 --> 00:15:52,760
ليس من العادل أن تكوني الوحيدة
!الّتي لديها أتباع

212
00:15:56,880 --> 00:15:59,360
تستدعيهم بلا أيّ مقابل؟

213
00:15:59,360 --> 00:16:01,430
.هذا ما أصفه بالغشّ

214
00:16:02,310 --> 00:16:05,450
هل يمكنني طرح سؤال عليك؟

215
00:16:05,450 --> 00:16:08,570
.ماذا؟ إنّنا نحاول قتل بعضنا هنا

216
00:16:12,520 --> 00:16:14,850
.لا داعي لتتصرّف هذا

217
00:16:14,850 --> 00:16:17,140
.يودّ سيّدي معرفة ذلك

218
00:16:21,010 --> 00:16:24,320
لماذا هاجمتمونا؟

219
00:16:31,590 --> 00:16:33,760
!مهلاً، مهلاً! ما هذا؟

220
00:16:33,760 --> 00:16:35,180
!ليس لديك أيّ معايير؟

221
00:16:40,210 --> 00:16:45,100
إنّ فصل قوّاتك بعيدًا عن دراغونتان لمهاجمتنا

222
00:16:45,100 --> 00:16:47,970
يبدو كاستراتيجيّة غبيّة، أليس كذلك؟

223
00:16:48,930 --> 00:16:50,350
!تريدين معرفة السّبب؟

224
00:16:51,150 --> 00:16:53,070
ألا تعرفين؟

225
00:16:53,070 --> 00:16:56,630
أم أنّ سيّدك يُخفي الأمر عنكم فحسب؟

226
00:16:56,630 --> 00:16:59,620
!في كلّ الأحوال، أشعر بالأسف عليكم

227
00:16:59,620 --> 00:17:01,650
.شكرًا على التّحذير

228
00:17:01,650 --> 00:17:06,370
ولكن، لن تستطيع كلمات كهذه
.أن تخلخل ولائي له

229
00:17:06,370 --> 00:17:08,700
!تعرفين سلفًا

230
00:17:09,480 --> 00:17:12,840
وأنت؟ ما رأيك في نفسك؟

231
00:17:13,360 --> 00:17:16,480
،أنا لا أفهم تمامًا مقصد سؤالك

232
00:17:16,480 --> 00:17:19,100
ولكنّني أفترض أنّك تحمل شكوكًا
حول حالتك وحقيقتك؟

233
00:17:19,100 --> 00:17:21,430
!أجيبي على السّؤال فحسب

234
00:17:23,660 --> 00:17:26,390
،أنا بطلة ماينوغورا

235
00:17:26,390 --> 00:17:30,210
.والخادمة المخلصة لملكنا إيرا تاكُتو

236
00:17:30,210 --> 00:17:33,190
.لا شيء أكثر ولا شيء أقلّ

237
00:17:35,360 --> 00:17:37,610
!أكره هذا بشدّة

238
00:17:37,980 --> 00:17:42,080
عجبًا، ما الّذي تكرهه حيال هذا؟

239
00:17:42,080 --> 00:17:44,160
،إنّك تصفين نفسك بخادمته

240
00:17:44,160 --> 00:17:47,790
!لكنّك مليئة بالفخر والقناعة

241
00:17:48,210 --> 00:17:50,880
.ماذا؟ هكذا إذًا

242
00:17:50,880 --> 00:17:54,180
.لهذا السّبب أنا غاضب جدًّا

243
00:17:54,730 --> 00:17:56,700
.هذا لأنّكم جميعًا أحرار

244
00:17:56,700 --> 00:17:58,650
،إنّك تخدمين ملكك بمحض إرادتك

245
00:17:58,650 --> 00:18:01,180
.وتفانيك في إخلاصك له هو خيارك أنت

246
00:18:02,640 --> 00:18:05,430
أخبريني، بماذا يُشعرك ذلك على أيّ حال؟

247
00:18:05,430 --> 00:18:08,140
أقصد خدمة شخص بإرادتك الخاصّة؟

248
00:18:08,750 --> 00:18:12,090
.عجبًا، هذه هي مشكلتك إذًا

249
00:18:12,090 --> 00:18:16,810
.أظنّ أنّ "سرور" تلخّص الأمر بشكل جيّد

250
00:18:16,810 --> 00:18:22,470
لا شيء يُشعرني بفرحة أكبر
.من أن أكون مفيدة لسيّدي

251
00:18:22,470 --> 00:18:23,620
...والآن

252
00:18:24,370 --> 00:18:26,290
...ماذا عنك

253
00:18:26,290 --> 00:18:32,990
أيّها المُجبر على الرّقص وفق
أنغام الدّور الّذي فُرض عليك؟

254
00:18:33,890 --> 00:18:36,560
!مثل جحيم ملعون

255
00:18:37,510 --> 00:18:38,950
!ولكن

256
00:18:38,950 --> 00:18:40,200
—وبمجرّد قتلك

257
00:18:40,200 --> 00:18:42,120
!قتلكم جميعًا

258
00:18:42,120 --> 00:18:44,000
!فسأحصل عليها أيضًا

259
00:18:44,000 --> 00:18:46,000
!سأحصل على حرّيّتي

260
00:18:50,160 --> 00:18:53,780
.فهمت. تلك هي نواياك إذًا

261
00:18:53,780 --> 00:18:56,350
!حسنًا... كم هذا جميل

262
00:18:56,350 --> 00:18:59,240
!إنّك تبدو جذّابًا جدًّا الآن

263
00:18:59,520 --> 00:19:01,360
!اخرسي أيّتها الذّبابة

264
00:19:01,360 --> 00:19:05,230
!احترقي وصيري رمادًا

265
00:19:12,170 --> 00:19:13,890
!نلت منك

266
00:19:31,090 --> 00:19:33,100
أهذا كلّ شيء؟

267
00:19:33,100 --> 00:19:35,940
أهذه هي حدود تعطّشك للحرّيّة؟

268
00:19:35,940 --> 00:19:37,070
!ماذا؟

269
00:19:37,590 --> 00:19:39,890
!إيّاك أن تجرئي على السّخرية منّي

270
00:19:45,360 --> 00:19:46,700
.ذلك ليس كافيًا

271
00:19:46,700 --> 00:19:48,700
،إن كنت تريد قتلي فعلاً

272
00:19:48,700 --> 00:19:52,040
عليك أن تتجهّز لذلك بخمسة
.أضعاف هذا على الأقلّ

273
00:19:58,760 --> 00:20:01,130
نفدت منك القوّة السّحريّة، صحيح؟

274
00:20:09,390 --> 00:20:12,960
.لديّ رسالة واحدة أخيرة لك من سيّدي

275
00:20:14,530 --> 00:20:18,230
."قال، "لقد استهنتم بنا كثيرًا

276
00:20:22,780 --> 00:20:24,940
أذلك صحيح؟

277
00:20:25,910 --> 00:20:29,000
سنحصل فعلاً على السّلام والحرّيّة؟

278
00:20:30,420 --> 00:20:32,770
لو ضحّينا بهذا العالم؟

279
00:20:36,150 --> 00:20:38,700
...حسنًا، وفي النّهاية

280
00:20:39,200 --> 00:20:41,670
أعتقد أنّي كنت مجرّد دمية؟

281
00:20:42,240 --> 00:20:43,630
...في تلك الحالة

282
00:20:43,630 --> 00:20:47,140
!سأؤدّي دوري حتّى النّهاية

283
00:21:02,670 --> 00:21:03,850
.حسنًا

284
00:21:03,850 --> 00:21:05,660
.أحسنت عملاً يا إيسلا

285
00:21:06,300 --> 00:21:08,440
!عجبًا يا سيّدي

286
00:21:08,440 --> 00:21:10,540
،إن كنت تتحدّث معي

287
00:21:10,540 --> 00:21:12,820
فذلك يعني أنّك كنت تشاهد، صحيح؟

288
00:21:12,820 --> 00:21:14,620
.نعم، أبليتِ حسنًا

289
00:21:14,960 --> 00:21:16,970
.شكرًا جزيلاً لك

290
00:21:16,970 --> 00:21:20,580
تقدّمتُ لمستوى آخر
.من هذه المعركة أيضًا

291
00:21:20,580 --> 00:21:22,800
—أفكّر في الحصول على مهارة جديدة

292
00:21:27,230 --> 00:21:29,010
!ماذا؟

293
00:21:40,880 --> 00:21:42,070
ما الّذي يحدث؟

294
00:21:42,070 --> 00:21:43,070
ماذا؟

295
00:21:43,070 --> 00:21:44,610
أمّي؟

296
00:21:45,200 --> 00:21:47,610
!ما الّذي تفعلانه هنا؟

297
00:21:47,610 --> 00:21:48,890
!لا ندري

298
00:21:48,890 --> 00:21:51,520
،كنّا مع الملك قبل قليل

299
00:21:51,520 --> 00:21:53,330
فـ-فلماذا نحن هنا؟

300
00:21:54,850 --> 00:21:56,130
!يا أطفالي

301
00:21:56,130 --> 00:21:58,190
!احموا الفتاتان