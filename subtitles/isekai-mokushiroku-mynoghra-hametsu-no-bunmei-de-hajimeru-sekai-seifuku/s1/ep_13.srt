1
00:00:17,950 --> 00:00:23,010
لا أصدّق أنّ طفلتين رقيقتين
.ستكونان قادرتين على الوصول إليّ

2
00:00:23,010 --> 00:00:27,290
.يبدو أنّ القدر يجبّ بشدّة التّلاعب معي

3
00:00:28,130 --> 00:00:32,590
وفي تلك الحالة، هذا يعني
.أنّ عليكما الموت هنا

4
00:00:34,260 --> 00:00:36,240
بمجرّد أن أدمّر كلّ شيء

5
00:00:36,240 --> 00:00:38,220
،وأضحّي بهذا العالم

6
00:00:38,220 --> 00:00:40,190
.سأحصل على حرّيّتي

7
00:00:40,190 --> 00:00:43,000
.هذا هو الاتّفاق الّذي عقدتُه مع الإله

8
00:00:46,320 --> 00:00:49,480
.أودّ التّأكّد من شيء قبل أن نبدأ القتال

9
00:00:50,050 --> 00:00:54,200
هل تؤمنان بوجود الإله؟

10
00:00:55,700 --> 00:00:59,030
.لا وجود لشيء كهذا

11
00:02:38,290 --> 00:02:43,180
،لا أدري كيف استطعتما القضاء على أتباعي

12
00:02:47,260 --> 00:02:50,190
.لكنّكما لن تلحقا بي ولو حتّى خدشًا واحدًا

13
00:03:00,560 --> 00:03:04,820
إنّ حاجزي المظلم يمنع
.كلّ الهجمات السّحريّة والجسديّة

14
00:03:04,820 --> 00:03:07,450
!وحده البطل بإمكانه إبطاله

15
00:03:08,000 --> 00:03:09,410
ما الّذي يحدث هنا؟

16
00:03:09,870 --> 00:03:14,040
.وُعدتُ أنّه لا يوجد بطل في هذا العالم

17
00:03:20,840 --> 00:03:23,640
لا نيّة لديكما للحديث إذًا؟

18
00:03:24,550 --> 00:03:25,970
،بالتّفكير في الأمر

19
00:03:25,970 --> 00:03:29,230
.البطل الّذي عرفتُه كان رجلاً صامتًا أيضًا

20
00:03:42,030 --> 00:03:45,630
هل من الغريب جدًّا عليّ أن أتحوّل من البداية؟

21
00:03:45,630 --> 00:03:48,780
إنّ العديد من محدّداتي
،قد فُقدت في هذا العالم

22
00:03:48,780 --> 00:03:52,920
لذلك فإنّ قتالكما حسب مراحل كما
.فعلتُ في اللّعبة سيكون أمرًا غير لائق

23
00:03:52,920 --> 00:03:57,190
إنّ هزيمة كليكما يجب أن تكون
.محنة قد فُرضت عليّ

24
00:03:57,190 --> 00:04:01,390
.يُنبئني حدسي بأنّه ليس عليّ الاستخفاف بكما

25
00:04:01,390 --> 00:04:05,690
!والآن أيّتها السّيوف، اضمني لي موتهما

26
00:04:09,950 --> 00:04:11,180
!إنّها جميلة

27
00:04:17,360 --> 00:04:18,320
!كاريا

28
00:04:18,320 --> 00:04:19,240
!نعم

29
00:04:24,780 --> 00:04:26,240
!وقاحة

30
00:04:38,650 --> 00:04:40,500
!ما هذا العبث؟

31
00:04:40,500 --> 00:04:43,090
!لكنّ هذا هو ما يجعل الأمر محنة لي

32
00:05:04,140 --> 00:05:05,640
!لن أُهزَم

33
00:05:05,640 --> 00:05:08,040
.الإله إلى جانبي

34
00:05:08,570 --> 00:05:13,830
سأحقّق اتّفاقي مع الإله
.وأحصل على سلامي وحرّيّتي

35
00:05:17,090 --> 00:05:19,080
.لا يوجد إله

36
00:05:19,080 --> 00:05:20,380
.ما عادوا موجودين

37
00:05:20,780 --> 00:05:23,720
،إن آمنتَ أنّ شيئًا ما سيأتي لنجدتك

38
00:05:23,720 --> 00:05:25,840
.فلن تواجه حينها إلاّ المعاناة لاحقًا

39
00:05:25,840 --> 00:05:28,160
.لم يكن علينا أن نؤمن بذلك أبدًا

40
00:05:28,160 --> 00:05:30,850
فقدنا كلّ شيء لأنّنا تجرّأنا
.على أن نؤمن بذلك

41
00:05:33,160 --> 00:05:35,120
!لن أموت

42
00:05:35,120 --> 00:05:37,370
،ما دامت إرادتي باقية

43
00:05:37,370 --> 00:05:39,760
،فأنا أقسم باسم الإله

44
00:05:39,760 --> 00:05:41,750
!أنّي لن أموت

45
00:05:46,130 --> 00:05:50,000
!عرفتُ أنّ الإله كان يرعاني

46
00:05:50,000 --> 00:05:51,660
!اسمعا الآن

47
00:05:51,660 --> 00:05:56,710
...اسم الإله الّذي سيمنحني النّصر هو

48
00:06:11,000 --> 00:06:12,320
من أنت؟

49
00:06:13,280 --> 00:06:15,810
ماذا؟ هل اقترفتُ خطأ ما؟

50
00:06:16,710 --> 00:06:18,680
لماذا تدخّلت؟

51
00:06:18,680 --> 00:06:20,050
...إنّ ذلك

52
00:06:20,050 --> 00:06:21,820
،لقد كنتُما تتعرّضان للهجوم

53
00:06:21,820 --> 00:06:23,520
لذلك فكّرتُ في إنقاذكما؟

54
00:06:23,830 --> 00:06:26,240
هل نبدو لك كأنّنا في حاجة للإنقاذ؟

55
00:06:26,550 --> 00:06:29,600
لا أدري ماذا أقول... كان الأمر حادثًا؟

56
00:06:29,600 --> 00:06:31,570
!نعم، كان حادثًا! صدّقاني

57
00:06:31,960 --> 00:06:37,910
على مهلكما، تلك النّظرات الغاضبة
لا تناسب فتاتين ظريفتين مثلكما، صحيح؟

58
00:06:38,360 --> 00:06:40,790
هل تدخّلتَ لتحقيق هدف ما؟

59
00:06:41,280 --> 00:06:42,130
!توقّفا

60
00:06:42,510 --> 00:06:44,340
،بالقوّة الّتي تملكانه الآن

61
00:06:45,040 --> 00:06:46,590
.لن تتمكّنا من هزيمتي

62
00:06:47,260 --> 00:06:49,420
.هذا الفتى غريب

63
00:06:49,420 --> 00:06:51,450
.إنّ كلّ شيء يقوله يبدو ككذبة

64
00:06:51,450 --> 00:06:53,680
.لكنّ ذلك لا يهمّ أبدًا

65
00:06:53,680 --> 00:06:56,600
.لقد دنّس هذا الفتى معركتنا

66
00:06:57,010 --> 00:07:00,440
.لقد خرّب كفّارتنا المقدّمة لأمّي

67
00:07:03,780 --> 00:07:04,900
.هذا يكفي

68
00:07:09,950 --> 00:07:12,000
...قطع الرّأس الجليديّ

69
00:07:12,000 --> 00:07:14,080
.إنّ ضمان إصابة الهدف ليس إلاّ النّتيجة

70
00:07:14,080 --> 00:07:16,790
هل تكمن حقيقته في تعطيل كلّ الظّواهر؟

71
00:07:17,530 --> 00:07:20,870
أدهشني أنّه يستطيع فرض نفسه
.حتّى في الأفعال الّتي بدأت بالفعل

72
00:07:20,870 --> 00:07:22,750
امرأة أخرى؟

73
00:07:25,280 --> 00:07:27,650
.أصدر ملكنا أمرًا بالعودة

74
00:07:27,650 --> 00:07:30,000
حقّقتما هدفكما، صحيح؟
—لذلك

75
00:07:30,000 --> 00:07:31,680
!لقد تدخّل ذلك الفتى

76
00:07:39,880 --> 00:07:42,480
.لا أعتقد أنّكما تفهمانني

77
00:07:42,970 --> 00:07:46,270
.أبلغتُكما بأوامر ملكنا

78
00:07:46,270 --> 00:07:48,900
.لا نريدك أن تقفي في طريقنا

79
00:07:49,440 --> 00:07:52,000
!يا لك من شقيّة صغيرة

80
00:07:52,000 --> 00:07:54,320
!أقد غرّتك القوّة حتّى صرت متكبّرة؟

81
00:07:56,130 --> 00:07:58,650
.لا يمكنني الاستخفاف بقوّة التّوأمتين

82
00:07:58,650 --> 00:08:00,450
.مع أنّ ذلك ليس مشكلة

83
00:08:00,980 --> 00:08:04,330
إنّ استعمال تلك التّقنية يمنعني
،من التّحرّك لبعض الوقت

84
00:08:04,580 --> 00:08:07,670
.لكنّي تحقّقتُ سلفًا أنّه يمكنني التّحرّك ثانية

85
00:08:08,250 --> 00:08:10,050
،ما دمتُ لن أقتلهما

86
00:08:10,050 --> 00:08:12,090
.فسيسامحني الملك تاكُتو

87
00:08:16,050 --> 00:08:19,230
.لن نسمح لك بالتّدخّل أيضًا يا أتو

88
00:08:19,230 --> 00:08:22,250
فقبل كلّ شيء، سبق وأخبرَنا ملكنا

89
00:08:22,250 --> 00:08:24,020
.أنّ بإمكاننا القيام بأيّ شيء

90
00:08:24,720 --> 00:08:26,850
،أنتما حُرّتان لفعل أيّ شيء

91
00:08:26,850 --> 00:08:30,320
.ولستما بحاجة لفعل أيّ شيء طلبًا للغفران

92
00:08:35,200 --> 00:08:38,490
طالما تتصرّفان بما
،كان ليجعل أمّكما تفخر بكما

93
00:08:38,490 --> 00:08:41,330
.فسأمدحكما على كلّ ما تفعلانه

94
00:08:43,080 --> 00:08:45,190
!عجبًا

95
00:08:45,190 --> 00:08:47,710
!يا لكما من فتاتين صغيرتين ظريفتين

96
00:08:47,990 --> 00:08:51,170
...طالما نتصرّف بما كان ليجعل أمّنا فخورة

97
00:08:51,740 --> 00:08:53,770
.اطمئنّا إذًا

98
00:08:53,770 --> 00:08:58,220
والآن، تعالا لتناما بين ذراعي
.إيسلا يا صغيرتَيّ

99
00:08:59,220 --> 00:09:01,930
ما الّذي كانت أمّنا لتظنّه بهذا؟

100
00:09:17,360 --> 00:09:19,700
.كاريا، لنتوقّف الآن

101
00:09:20,130 --> 00:09:21,790
...يا أختي الكبيرة

102
00:09:26,020 --> 00:09:28,330
.نحن آسفتان يا أتو

103
00:09:28,330 --> 00:09:31,340
.أنا آسفة لأنّي قلتُ أشياء فظّة من قبل

104
00:09:32,670 --> 00:09:34,720
،نظرًا للوضع الحاليّ

105
00:09:34,720 --> 00:09:38,200
سأتظاهر أنّ نوبة غضبكما هذه
.لم تحدث أبدًا إن اتّبعتما الأوامر

106
00:09:38,200 --> 00:09:41,350
!آسف على التّدخّل! مع السّلامة

107
00:09:44,800 --> 00:09:46,800
زيّ مدرسيّ؟

108
00:09:46,800 --> 00:09:50,250
،إن كان الكيانَ الّذي توقّعه الملك تاكُتو

109
00:09:50,250 --> 00:09:52,470
.فعلينا تجاهله فحسب في الوقت الحاليّ

110
00:09:52,470 --> 00:09:53,900
أتو؟

111
00:09:54,320 --> 00:09:56,170
...هل من الممكن إعادة أمّي إيسلا

112
00:09:56,170 --> 00:09:57,860
للحياة ثانية؟

113
00:10:01,130 --> 00:10:04,380
.لسوء الحظّ، ماتت إيسلا

114
00:10:26,000 --> 00:10:27,910
.نعم، فهمت

115
00:10:27,910 --> 00:10:29,870
،يجدر أن يكون كلّ شيء بخير الآن

116
00:10:29,870 --> 00:10:31,100
.لكن كنّ حذرات في طريق العودة

117
00:10:31,770 --> 00:10:34,590
.مفهوم. سأراك لاحقًا إذًا

118
00:10:36,530 --> 00:10:38,070
هل انتهى الأمر؟

119
00:10:38,420 --> 00:10:42,640
إنّ آليّات لعبة استراتيجيّات إدارة
.الدّول طُبّقت في هذا العالم

120
00:10:42,640 --> 00:10:45,290
ظننتُ أنّ ذلك خُدعة غشّ لي
!أنا بشكل حصريّ

121
00:10:45,980 --> 00:10:51,000
لكنّنا الآن واجهنا عدوًّا بخُدعة لعب
.مختلفة، آليّات لعبة تقمّص أدوار

122
00:10:51,870 --> 00:10:55,420
.ثمّة عدّة أنواع من الألعاب أيضًا

123
00:11:00,010 --> 00:11:02,890
!كا-كان ذلك مخيفًا

124
00:11:03,350 --> 00:11:06,640
ما الّذي قصده بـ"ثمّة فتاتان
.ظريفتان بريئتان في خطر

125
00:11:06,640 --> 00:11:09,780
."أريد الذّهاب لإنقاذهما في الحال

126
00:11:09,780 --> 00:11:11,190
!إله غبيّ

127
00:11:11,190 --> 00:11:13,310
!يا سيّدي

128
00:11:14,040 --> 00:11:16,000
...مرحبًا يا

129
00:11:16,000 --> 00:11:19,190
...نعم! أنا فتاتك العبدة

130
00:11:19,600 --> 00:11:21,100
لم تتأذّي، صحيح؟

131
00:11:21,100 --> 00:11:22,580
!أنا بخير

132
00:11:22,580 --> 00:11:26,640
!قوّة الإله الغامضة تحميني قبل كلّ شيء

133
00:11:26,640 --> 00:11:30,330
.لذلك... تلقّيتُ رسالة من أجلك

134
00:11:30,760 --> 00:11:33,980
"!تقول "أنا آسف

135
00:11:34,960 --> 00:11:36,880
!إنّه يسخر منّي

136
00:11:36,880 --> 00:11:41,680
قبل كلّ شيء، نقلني ذلك الإله
!إلى هنا بنزوة منه

137
00:11:44,330 --> 00:11:46,720
.حسنًا، تسنّت لي فرصة لقائك

138
00:11:48,220 --> 00:11:50,100
!سيّدي

139
00:11:53,000 --> 00:11:55,820
كما أنّه قدّم لي خدعة الغشّ
،الّتي وعدني بها

140
00:11:55,820 --> 00:11:57,570
.لذلك فأنا ممتنّ

141
00:11:57,570 --> 00:12:00,530
!أ-أنت مذهل يا سيّدي

142
00:12:00,900 --> 00:12:02,280
.يا إلهي

143
00:12:02,280 --> 00:12:05,240
أعتقد أنّ الأمور لا تسير بسلاسة
.كما في الأنمي والرّوايات

144
00:12:05,700 --> 00:12:09,010
!ولكن مع ذلك، أعتقد أنّي سأنقذ العالم

145
00:12:09,010 --> 00:12:12,830
!أجل! يا سيّدي الحصريّ

146
00:12:16,710 --> 00:12:18,000
!يا إلهي

147
00:12:18,000 --> 00:12:19,670
!سررت بلقائك، ولم أرك منذ مدّة

148
00:12:19,670 --> 00:12:22,380
هل أنت بخير أيّتها القدّيسة الصّغيرة؟

149
00:12:22,690 --> 00:12:26,340
.سأكشف عن سرّك اليوم أخيرًا

150
00:12:26,340 --> 00:12:29,810
يا إلهي، هذه معركتنا التّذكاريّة
التّاسعة عشرة، صحيح؟

151
00:12:29,810 --> 00:12:33,770
حرصتُ على دفنها في كلّ المرّات
.الثّمانية عشر من قبل

152
00:12:34,530 --> 00:12:36,980
،حتّى بعد حرقي لجثّتها بالكامل

153
00:12:36,980 --> 00:12:39,160
،وحتّى بعد أن ألقيت ختمًا عليها

154
00:12:39,160 --> 00:12:41,110
.تعود للحياة دائمًا وكأنّ شيئًا لم يحدث

155
00:12:41,580 --> 00:12:44,550
.لن تنتهي هذه الكارثة إلى أن أكشف عن لغزها

156
00:12:44,550 --> 00:12:47,570
!تفتقرين للمرونة
لماذا لا نسترخي بعض الشّيء؟

157
00:12:47,990 --> 00:12:52,110
أنا هنا ببساطة للقضاء
.على الشّرّ باسم الإله

158
00:12:52,110 --> 00:12:56,390
وبصراحة، سأغضب كثيرًا
.إن لم أفز قريبًا أيضًا

159
00:12:56,390 --> 00:12:57,540
...لذلك

160
00:12:57,920 --> 00:13:00,500
.حان الوقت لإلقاء النّرد ثانية

161
00:13:14,990 --> 00:13:16,770
...عفوًا

162
00:13:17,730 --> 00:13:19,940
هل كانت ضربة حاسمة؟

163
00:13:20,070 --> 00:13:21,870
!أجل

164
00:13:21,870 --> 00:13:23,610
!حصلتُ على ضربة حاسمة

165
00:13:24,000 --> 00:13:25,590
!لقد نجحت المحاولة التّاسعة عشرة

166
00:13:25,590 --> 00:13:28,210
،بعد تعديلات كثيرة على جدولي

167
00:13:28,210 --> 00:13:31,620
!صارت إراكينو الشّخصيّة الأقوى أخيرًا

168
00:13:31,620 --> 00:13:33,790
!يا سيّدي! هل تشاهدني؟

169
00:13:33,790 --> 00:13:35,290
!لقد فعلتُها

170
00:13:35,290 --> 00:13:36,750
!اثنِ عليّ! اثنِ عليّ

171
00:13:37,760 --> 00:13:41,500
!صحيح، إنّه طلبٌ من الإله قبل كلّ شيء

172
00:13:41,500 --> 00:13:43,170
!حاضرة! حاضرة

173
00:13:43,170 --> 00:13:45,220
!يا سيّد لعبتي

174
00:13:46,970 --> 00:13:49,050
ماينوغورا إذًا؟

175
00:13:49,050 --> 00:13:52,510
!والآن يا إراكينو، حان وقت العمل

176
00:13:53,150 --> 00:13:55,890
!كما يريد إله النّرد

177
00:13:55,890 --> 00:13:58,980
!وكما يتطلّبه رمي النّرد

178
00:14:02,210 --> 00:14:07,840
في المستقبل، قد أضطرّ إلى محاربة أعداء
.آخرين باستخدام آليّات لعب أخرى

179
00:14:07,840 --> 00:14:09,660
،إن كرّرنا أداءنا هنا هذه المرّة

180
00:14:10,000 --> 00:14:12,710
.فسيُقضى علينا في المرّة التّالية

181
00:14:14,420 --> 00:14:15,360
!يا ملكي

182
00:14:15,360 --> 00:14:17,460
،أعتذر لقدومي إليك مباشرة

183
00:14:17,460 --> 00:14:20,040
!لكنّي لم أستطيع الوصول إليك بالتّخاطر

184
00:14:20,330 --> 00:14:23,540
،أعدنا الحرس حول القصر
!لذلك يمكن العودة إليه

185
00:14:23,540 --> 00:14:24,630
.دعني وحدي الآن

186
00:14:25,000 --> 00:14:26,980
!ا-المعذرة

187
00:14:29,410 --> 00:14:31,090
.أنا أتصرّف بسوء

188
00:14:31,680 --> 00:14:34,440
فقدتُ إيسلا بسبب تكبّري

189
00:14:34,440 --> 00:14:37,060
.وانتهى بي المطاف بخيانة ثقة التّوأمتين

190
00:14:37,360 --> 00:14:40,560
.تسبّبت سذاجتي بكلّ هذا

191
00:14:42,110 --> 00:14:43,270
!سُحقًا

192
00:14:48,240 --> 00:14:49,000
ماذا؟

193
00:14:52,840 --> 00:14:54,870
هذا مستحيل، صحيح؟

194
00:15:09,710 --> 00:15:12,400
.هذه ليست لعبة أتحكّم بها من الخارج

195
00:15:12,400 --> 00:15:15,850
،بما أنّي جزء من هذا العالم
هذا يعني أنّي وحدة أيضًا، صحيح؟

196
00:15:16,330 --> 00:15:18,310
لماذا لم ألاحظ ذلك من قبل؟

197
00:15:18,680 --> 00:15:21,310
!لماذا لم أختبر ذلك من البداية؟

198
00:15:21,310 --> 00:15:24,530
،لو أنّي علمتُ ذلك
!ما كان عليها لتموت

199
00:15:30,990 --> 00:15:33,070
.سنقيم اجتماعًا طارئًا

200
00:15:33,460 --> 00:15:38,660
أوّلاً، أودّ أن أطلب حُكما على
.عصيان الأختين إلفور

201
00:15:39,250 --> 00:15:40,500
.لن تُعاقبا

202
00:15:41,000 --> 00:15:42,710
.لن تُوجَّه لهما أيّ جريمة

203
00:15:42,710 --> 00:15:44,040
!أيّها الملك تاكُتو

204
00:15:44,040 --> 00:15:46,920
إن قمت بذلك، فلن نستطيع
!الالتزام بقوانين البلاد

205
00:15:46,920 --> 00:15:49,630
،وخاصّة في حالات طارئة مثل هذه

206
00:15:49,630 --> 00:15:51,520
—لا يمكننا السّماح باستثناءات بدون سبب

207
00:15:51,520 --> 00:15:53,800
حالات طارئة؟

208
00:15:54,170 --> 00:15:58,220
.عليّ الاعتذار لكم جميعًا بخصوص ذلك

209
00:16:01,280 --> 00:16:03,210
.أنا جدّ آسف

210
00:16:03,210 --> 00:16:05,900
.حدث كلّ هذا بسبب غطرستي وإهمالي

211
00:16:05,900 --> 00:16:08,220
!تـ-توقّف عن هذا رجاءً

212
00:16:08,220 --> 00:16:10,570
!لا يجدر بالملك أن يعتذر أبدًا

213
00:16:10,570 --> 00:16:13,030
!حدث كلّ هذا لأنّنا لم نكن أقوياء بما يكفي

214
00:16:13,780 --> 00:16:15,820
.أعدكم بهذا أيضًا

215
00:16:15,820 --> 00:16:17,490
.سأعيد إيسلا للحياة

216
00:16:19,750 --> 00:16:21,540
هـ-هل أنت جادّ في هذا؟

217
00:16:21,960 --> 00:16:23,460
بإمكانك إعادتها للحياة؟

218
00:16:23,460 --> 00:16:25,030
!تمهّل لحظة

219
00:16:25,030 --> 00:16:29,360
أرجو المعذرة، ولكن في وضعنا
!الحاليّ، إحياء أبطالنا ليس خيارًا

220
00:16:29,360 --> 00:16:31,850
،سيُستقبل قومهم في السّماوات"

221
00:16:31,850 --> 00:16:36,470
وسيحيَون أبدًا في انسجام
.لا ينقطع ومنتهى السّعادة

222
00:16:36,470 --> 00:16:39,170
،لن يكون هناك ألم ولا عذاب

223
00:16:39,170 --> 00:16:43,100
وسيعود الموتى إلى الحياة
".ليجتمعوا بأحبّتهم من جديد

224
00:16:43,990 --> 00:16:47,640
نصر الارتقاء— النّصر الّذي ترتقي
.فيه حضارة إلى مستوى أسمى

225
00:16:47,640 --> 00:16:51,400
إن كان هذا العالم يستلهم
،من آليّات لعبة الأمم الأبديّة

226
00:16:51,400 --> 00:16:54,640
.فأنا أعهد لكم بتحقيق ذلك النّصر

227
00:16:54,640 --> 00:16:56,780
.لإعادة كلّ من فقدناهم

228
00:16:57,190 --> 00:16:59,740
!لـ-لكنّ شروط تحقيق ذلك النّصر صارمة للغاية

229
00:16:59,740 --> 00:17:03,210
إنّ نصر الارتقاء يعني في جوهره
!إعادة خلق العالم نفسه

230
00:17:03,210 --> 00:17:05,200
في اللّحظة الّتي يعرف الآخرون
،أنّنا نسعى خلفه

231
00:17:05,200 --> 00:17:06,830
!سينقلب العالم بأسره علينا

232
00:17:07,170 --> 00:17:08,430
!لا بأس بذلك

233
00:17:08,430 --> 00:17:10,840
!على أيّ أساس تبني استنتاجك ذلك؟

234
00:17:11,360 --> 00:17:15,320
.لأنّنا سنقتل كلّ من سيعترض طريقنا فحسب

235
00:17:20,680 --> 00:17:23,940
!والآن، لنغزُ العالم

236
00:17:25,170 --> 00:17:28,060
بصراحة، أعتقد أنّ هذا سيكون
!فيه تحدّيًّا لكم جميعًا

237
00:17:28,060 --> 00:17:30,520
!لكنّي أعلم أنّ بإمكاننا النّجاح في هذا معًا

238
00:17:30,910 --> 00:17:34,400
احرصوا فقط على الاستماع لما
أخبركم به من الآن فصاعدًا، مفهوم؟

239
00:17:40,050 --> 00:17:42,240
.لن تكون الأسلحة المعاصرة جيّدة وحدها

240
00:17:42,660 --> 00:17:44,820
،إن كنّا نريد تحقيق نصر الارتقاء

241
00:17:44,820 --> 00:17:47,710
.فعليّ التّفكير في استراتيجيّة معقّدة

242
00:17:48,140 --> 00:17:52,080
سأضطرّ إلى إدارة كلّ تفاصيل
.تصرّفات وحداتي بنفسي

243
00:17:53,350 --> 00:17:56,610
.عليّ التّحقّق من حالة حضارتنا مرّة أخرى

244
00:17:58,480 --> 00:18:01,490
كلّ الإلف المظلمين مجتمعين في نقطة واحدة؟

245
00:18:03,510 --> 00:18:05,140
ما هذا؟

246
00:18:11,560 --> 00:18:17,030
سنطلب من السّيّدة إيسلا
.أن تراقب مستقبل أمّتنا من هنا

247
00:18:17,540 --> 00:18:20,490
.عسى أن ترقدي بسلام يا بطلة ماينوغورا

248
00:18:20,790 --> 00:18:22,430
.إنّه ليس قبرًا

249
00:18:22,430 --> 00:18:26,870
.سترتاح أمّي هنا لبعض الوقت فحسب

250
00:18:27,200 --> 00:18:29,120
أخبرَنا ملكنا

251
00:18:29,120 --> 00:18:31,610
.أنّه سيعيد أمّنا للحياة

252
00:18:31,610 --> 00:18:35,090
!لذلك أنا واثقة أنّ أمّنا ستعود للحياة

253
00:18:37,310 --> 00:18:41,510
هل نعتقد أنّ بإمكاننا تحقيق
النّتائج الّتي يترقّبها منّا ملكنا؟

254
00:18:41,860 --> 00:18:43,550
.كان مرعبًا

255
00:18:43,550 --> 00:18:48,180
كان ملكنا اليوم أكثر رهبة بكثير ممّا
.كان عليه عندما تحدّثت إليه لأوّل مرّة

256
00:18:48,180 --> 00:18:51,400
لستُ واثقة أنّ بإمكاننا مجاراة
...خطط ملكنا

257
00:18:55,360 --> 00:18:58,140
.إنّكم تتصرّفون بشكل طفوليّ

258
00:18:58,140 --> 00:19:00,660
وحدهم الأطفال يشعرون
،بالخوف ويفقدون الثّقة

259
00:19:00,660 --> 00:19:04,370
.ويصيرون عاجزين عن فعل ما يجدر بهم فعله

260
00:19:04,370 --> 00:19:06,620
هل عليّ التّربيت على رؤوسكم؟

261
00:19:10,080 --> 00:19:12,540
!من المدهش أنّ الأطفال هم من يوبّخوننا

262
00:19:13,930 --> 00:19:15,250
.لكنّهما على حقّ

263
00:19:15,250 --> 00:19:17,840
.الخذلان والخوف بهذا الشّكل أمر غير ناضج

264
00:19:18,110 --> 00:19:20,170
حتّى أطفالنا

265
00:19:20,170 --> 00:19:22,060
.لا يتردّدون لخدمة ملكنا

266
00:19:22,830 --> 00:19:26,680
أتعهّد مرّة أخرى باتّباع ملكنا حتّى
،النّهاية، مهما كان الأمر مرعبًا

267
00:19:26,680 --> 00:19:29,270
.وحتّى لو انقلب العالم بأسره ضدّنا

268
00:19:29,650 --> 00:19:33,880
لطالما وضع ملكنا ثقته بنا
.وأحسن استعمالنا على خير وجه

269
00:19:33,880 --> 00:19:36,230
.والآن حان دورنا لنثق بملكنا

270
00:19:36,230 --> 00:19:38,800
،وإن كانت حكمة ناقصة
فسأجمع ما أستطيع منها

271
00:19:38,800 --> 00:19:41,170
!وأضع استراتيجيّات لتقديمها لملكنا

272
00:19:41,170 --> 00:19:42,220
!هيّا بنا

273
00:19:42,220 --> 00:19:43,200
!أجل

274
00:20:12,460 --> 00:20:15,940
.كدت أن أختار أسوأ استراتيجيّة على الإطلاق

275
00:20:16,570 --> 00:20:19,220
،ولولا وجود الجميع معي هنا

276
00:20:20,130 --> 00:20:21,840
،لما أصبحنا هذه الأمّة

277
00:20:21,840 --> 00:20:23,110
.هذه الأمّة الّتي تختلف عن اللّعبة

278
00:20:24,310 --> 00:20:27,400
.لما أصبحنا ماينوغورا. أمّتنا نحن

279
00:20:43,050 --> 00:20:47,680
انعزلتُ بعيدًا بعدما عجزت البارحة عن إيجاد
...الكلمات المناسبة لأقولها للملك تاكُتو

280
00:20:48,730 --> 00:20:50,720
.لكنّ اليوم مختلف

281
00:20:51,240 --> 00:20:53,920
،مهما تغيّر الملك تاكُتو

282
00:20:53,920 --> 00:20:56,310
!لن يتغيّر ولائي له أبدًا

283
00:20:56,940 --> 00:20:59,650
!ملكي العظيم والجبّار، الملك إيرا تاكُتو

284
00:20:59,650 --> 00:21:02,110
!أتو الحمأة هنا من أجلك

285
00:21:02,720 --> 00:21:04,110
.على مهلك

286
00:21:04,110 --> 00:21:06,820
.نريدك أن تبتهج يا ملكي

287
00:21:09,520 --> 00:21:13,120
!ا-الملك تاكُتو؟

288
00:21:14,250 --> 00:21:18,330
...تهوّرتُ كثيرًا في الأمس وأخفت الجميع

289
00:21:18,330 --> 00:21:21,210
!لا-لا بأس! لا بأس

290
00:21:21,560 --> 00:21:24,300
لم يكن ينبغي أن أقول ذلك
...بتلك الطّريقة

291
00:21:24,300 --> 00:21:27,590
ما-ماذا لو أعدتَ صياغة كلامك الآن؟

292
00:21:27,590 --> 00:21:28,930
أعدت صياغته؟

293
00:21:31,860 --> 00:21:35,850
لن أسمح للأشخاص الّذين وضعوا
.ثقتهم بي أن يعانوا مرّة أخرى

294
00:21:36,330 --> 00:21:38,480
فلنعمل جميعًا معًا

295
00:21:39,280 --> 00:21:41,980
!لتحقيق نصر الارتقاء

296
00:21:43,020 --> 00:21:44,690
.سأتبعك إلى أيّ مكان تذهب إليه

297
00:21:45,050 --> 00:21:46,150
!ونحن سنساعد

298
00:21:46,540 --> 00:21:48,360
!يمكنك النّجاح يا ملكي

299
00:21:49,440 --> 00:21:50,830
.إنّه أمر لا يستطيع فعله إلاّ أنا

300
00:21:51,490 --> 00:21:54,490
.بصفتي اللاّعب الأفضل في الأمم الأبديّة

301
00:21:56,000 --> 00:21:59,010
.سأحقّق لنا النّصر في هذه الظّروف