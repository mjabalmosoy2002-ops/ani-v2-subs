1
00:01:55,280 --> 00:01:56,490
هاجيمي-كون

2
00:02:03,870 --> 00:02:06,160
كاوري حريصة جدًّا

3
00:02:06,160 --> 00:02:10,290
يبدو أنّها لا تستطيع ببساطة أن تشيح نظرها حين يتعلّق الأمر بالمرض والإصابة

4
00:02:10,290 --> 00:02:12,500
كما هو متوقّع من كاوري-سان

5
00:02:12,500 --> 00:02:14,880
أختي الكبرى كاوري طيّبة جدًّا

6
00:02:18,430 --> 00:02:20,550
إنّها معالجة، بالتّالي هذا أمر طبيعيّ

7
00:02:20,550 --> 00:02:26,270
لو أستطيع فقط استعمال السّحر مثل كاوري-سان

8
00:02:28,730 --> 00:02:30,770
ما-ماذا؟

9
00:02:35,440 --> 00:02:36,990
نصائح عن كيفيّة استعمال السّحر؟

10
00:02:36,990 --> 00:02:41,360
نعم، لو أتلقّى نصائح من يوي-سان العبقريّة

11
00:02:41,360 --> 00:02:45,910
حتّى أنا الّتي قدرتها معدومة في السّحر

12
00:02:45,910 --> 00:02:49,160
قد تكون قادرة على استعمال تعويذة أو تعويذتين سحريّتين

13
00:02:50,040 --> 00:02:54,590
حسنًا سأعلّمكِ، كلّما كانتْ لدينا فائدة منه كان أفضل

14
00:02:54,590 --> 00:03:00,800
حقًّا؟
أنا سعيدة جدًّا يا يوي-سان، شكرًا لكِ

15
00:03:00,800 --> 00:03:04,140
أخيرًا سأقوم بظهوري الأوّل بالسّحر

16
00:03:04,140 --> 00:03:08,810
تعلّم يوي السّحر؟
يبدو هذا مثيرًا للاهتمام

17
00:03:08,810 --> 00:03:11,270
أيمكنني الاستماع إليكِ يا يوي؟

18
00:03:11,270 --> 00:03:12,690
ميو أيضًا

19
00:03:12,690 --> 00:03:17,900
لا مانع عندي
...أنْ أعلّم سليلة تنّين

20
00:03:17,900 --> 00:03:20,070
إنّها لحظة مؤثّرة

21
00:03:20,070 --> 00:03:22,570
ألن تنضمّ إلينا يا سيّدي؟

22
00:03:22,570 --> 00:03:24,070
كلا

23
00:03:24,070 --> 00:03:25,580
ما الخطب؟

24
00:03:25,580 --> 00:03:33,500
أأنتَ خائف يا هاجيمي-سان من أنّكَ لن تقدرَ على القيام به؟

25
00:03:33,500 --> 00:03:35,920
لا، ليس هذا السّبب

26
00:03:35,920 --> 00:03:39,510
لنتعلّم معًا إذًا

27
00:03:39,510 --> 00:03:40,920
بابا أيضًا

28
00:03:40,920 --> 00:03:45,800
سأتجاوزه، في الحقيقة كنتُ لأنصحكنّ بتجاوزه جميعًا أيضًا

29
00:03:47,010 --> 00:03:49,520
أنا أقول هذا لمساعدتكنّ، لا تتعلّمنه

30
00:03:49,520 --> 00:03:53,650
هذا فظيع يا هاجيمي
أتظنّ أنّني بلا كفاءة؟

31
00:03:53,650 --> 00:03:56,520
لا يمكن أن يكون الجميع جيّدين في كلّ شيء

32
00:03:56,520 --> 00:04:02,860
ماذا؟
لا يُمكن وجود شخص مناسب أكثر لتعليم السّحر من يوي يا هاجيمي-سان

33
00:04:03,610 --> 00:04:09,870
عشتُ حياةً طويلة، لكنّني لم يسبق لي أن رأيتُ أحدًا بمهاراتٍ عالية جدًّا

34
00:04:09,870 --> 00:04:12,500
أظنّ أنّ يوي أفضل معلّمة قد يمكن وجودها

35
00:04:13,620 --> 00:04:14,920
بابا

36
00:04:14,920 --> 00:04:16,580
هاجيمي

37
00:04:19,420 --> 00:04:21,590
حذّرتكنّ

38
00:04:28,140 --> 00:04:33,310
"إذًا هنا حيث تبدأن "جيوم

39
00:04:33,310 --> 00:04:35,980
"بالسّحر وتكون هكذا "رام رام

40
00:04:35,980 --> 00:04:41,230
كلّ ما عليكنّ فعله الآن هو فعل "غرر" وسوي، هذا كلّ شيء

41
00:04:44,070 --> 00:04:46,110
أتريّن؟
بسيط جدًّا

42
00:04:46,110 --> 00:04:48,070
هكذا إذًا، لم أفهم شيئًا

43
00:04:48,910 --> 00:04:50,540
ما هو "جيوم"؟

44
00:04:50,540 --> 00:04:52,660
ماذا تقصدين بـ"رام رام"؟

45
00:04:52,660 --> 00:04:57,670
"ذلك حيث تنطلق القوّة السّحريّة من حالة "الضّغط

46
00:04:57,670 --> 00:05:01,170
"إلى حالة "شووب

47
00:05:01,170 --> 00:05:06,550
والّتي تعني بالضّرورة أنّها ستكون "كواه" تاليًّا

48
00:05:06,550 --> 00:05:12,220
هذا غير مفهوم، كم معنًى تضعينه في "جيوم"؟

49
00:05:13,930 --> 00:05:18,270
علّمينا أرجوكِ بلغة نفهمها

50
00:05:18,270 --> 00:05:19,440
ميو

51
00:05:21,020 --> 00:05:26,910
نودّ يا يوي شرحًا نظريًّا أكثر

52
00:05:28,370 --> 00:05:34,580
حالة "الجيوم" هي الحالة الّتي يكون فيها معدّل تسارع السّحر 2.25 مرّة

53
00:05:34,580 --> 00:05:38,460
يمكن أن تتراوح الحالة الثّابتة بين 2.25 و2.277 حسبَ

54
00:05:38,460 --> 00:05:41,420
ميزة وعنصر السّحر

55
00:05:41,420 --> 00:05:45,920
بتطبيق مقاومة لهذا عند معامل 3.95

56
00:05:45,920 --> 00:05:48,590
بإمكانك الحصول تقريبًا وآليًّا على القيم النّهائيّة

57
00:05:48,590 --> 00:05:50,350
لمعدّل التّركيز والتردّد بعد التّحرير

58
00:05:50,350 --> 00:05:52,600
بلغة البشر رجاءً

59
00:05:54,310 --> 00:05:56,560
لهذا منحتكنّ شرحًا بسيطًا

60
00:05:56,560 --> 00:05:59,400
ليسمح لكنّ بفهمه طبيعيًّا

61
00:05:59,400 --> 00:06:01,770
لمَ لا تفهمنَ؟

62
00:06:01,770 --> 00:06:02,900
ميو

63
00:06:07,780 --> 00:06:10,780
أ-أأنا مجرّد غبيّة؟

64
00:06:10,780 --> 00:06:15,120
أأنا غبيّة مخجلة، بالتّفكير أنّني بارعة في السّحر

65
00:06:15,120 --> 00:06:17,960
رغم أنّني لا أفهم الأساسيّات حتّى؟

66
00:06:17,960 --> 00:06:20,380
أأنتِ بخير يا أختي الكبرى تيو؟

67
00:06:21,710 --> 00:06:25,460
كبرياء تيو-سان قريب بالفعل على أن يُحطّم

68
00:06:25,460 --> 00:06:30,800
التدريب فقط ما يمكنكنّ من إتقانه، لا تقلقن، افعلن كما أقول وستكنّ بخير

69
00:06:30,800 --> 00:06:34,390
قِفن، قِفن الآن، أسرعنَ وقِفن

70
00:06:34,390 --> 00:06:37,100
هيّا ردِّدنَ ورائي

71
00:06:37,100 --> 00:06:40,770
جيوم، بار بار بار، سوي

72
00:06:40,770 --> 00:06:44,190
إنّه مختلف عمّا قلتِه سابقًا

73
00:06:44,190 --> 00:06:48,900
هيّا أرينّني الجيوم خاصّتكنّ، أسرعن بالجيوم، هيّا، هيّا

74
00:06:48,900 --> 00:06:50,490
الآن

75
00:06:50,490 --> 00:06:51,610
وجيوم

76
00:06:51,610 --> 00:06:53,070
جيوم؟

77
00:06:55,040 --> 00:06:59,870
جـ-جيوم--
جـ-جيوم--

78
00:07:00,620 --> 00:07:01,500
جيوم

79
00:07:01,500 --> 00:07:03,210
ثمّ روم روم

80
00:07:03,210 --> 00:07:06,210
روم روم--
روم روم--

81
00:07:06,210 --> 00:07:09,130
والآن بإحساس، سوي

82
00:07:09,130 --> 00:07:12,430
سوي--
سوي--

83
00:07:12,430 --> 00:07:15,060
لهذا قلتُ ألّا تتعلّمنه

84
00:07:15,060 --> 00:07:18,810
أتحدّث عن تجربة حين أقدّم هذه التّحذيرات

85
00:07:20,940 --> 00:07:24,270
قفا يا شيا وتيو، هيّا قفا

86
00:07:24,270 --> 00:07:28,190
أنهيتُ العلاج
ماذا يجري؟

87
00:07:28,190 --> 00:07:30,610
لا شيء من هذا يعنيكِ

88
00:07:30,610 --> 00:07:34,870
كانتْ يوي-سان تعلّمنا كيفيّة استعمال السّحر

89
00:07:34,870 --> 00:07:38,410
ماذا؟
أريد أن أتعلّمه أيضًا

90
00:07:38,410 --> 00:07:42,870
عليّ تحذيركِ يا كاوري-سان
لا تتعلّميه رجاءً

91
00:07:42,870 --> 00:07:44,580
لماذا؟

92
00:07:44,580 --> 00:07:46,920
...السّبب هو

93
00:07:46,920 --> 00:07:51,300
أنّ يوي-سان لا تملك أيّ موهبة في التّعليم

94
00:07:52,090 --> 00:07:54,720
وهي أيضًا عبقريّة حين يتعلّق الأمر بتحطيم إرادة المرء

95
00:07:58,600 --> 00:08:04,270
إن أردتِ التّعلّم يا كاوري فاطلبي من تيو، فهي معلّمة بارعة

96
00:08:06,650 --> 00:08:08,190
أحمق

97
00:08:10,070 --> 00:08:12,070
يوي-سينسي

98
00:08:12,070 --> 00:08:13,320
اهلكي يا كاوري

99
00:08:13,320 --> 00:08:18,580
لا تكوني لئيمة جدًّا، لهذا قلنَ إنّكِ لا تملكين موهبة التّعليم

100
00:08:18,580 --> 00:08:22,710
وأنتِ عبقريّة حين يتعلّق الأمر بتحطيم إرادة المرء

101
00:08:22,710 --> 00:08:28,880
"جرّبي تعليمي، وجدتّها، علّميني سحر الدّفاع "هيريم

102
00:08:28,880 --> 00:08:30,510
رجاءً، رجاءً

103
00:08:31,630 --> 00:08:34,760
ستقولين فقط إنّه غير مفهوم وتضحكين عليّ

104
00:08:36,260 --> 00:08:38,430
أوّلًا تمسكينه

105
00:08:38,430 --> 00:08:44,810
ثمّ تهزّينه تهزّينه وبعدها سينطلق شووب، لذا أخيرًا سوي

106
00:08:46,230 --> 00:08:48,400
لنرَ

107
00:08:48,400 --> 00:08:52,860
...أمسكه... أهزّه أهزّه

108
00:08:52,860 --> 00:08:56,530
انطلق شووب، ثمّ سوي

109
00:09:00,160 --> 00:09:02,620
ماذا؟

110
00:09:04,120 --> 00:09:06,750
أنتِ مذهلة يا أختي الكبرى كاوري

111
00:09:06,750 --> 00:09:12,210
يوي ليستْ معلّمة سيّئة، تعلّمته بلمح البصر

112
00:09:12,210 --> 00:09:15,380
حـ-حقًّا؟
أفهمته؟

113
00:09:15,380 --> 00:09:16,720
طبعًا

114
00:09:16,720 --> 00:09:22,350
أمسكه، أهزّه أهزّه، شووب وسوي

115
00:09:23,730 --> 00:09:26,390
تمامًا--
تمامًا--

116
00:09:26,390 --> 00:09:29,560
هيّا يا شيا وتيو، قفا

117
00:09:29,560 --> 00:09:31,440
قفا

118
00:09:33,490 --> 00:09:35,610
ردّدا ورائي

119
00:09:35,610 --> 00:09:38,990
أمسكه، أهزّه أهزّه، شووب وسوي

120
00:09:38,990 --> 00:09:42,950
هيّا ردّداها، أمسكه، أمسكه، هيّا

121
00:09:42,950 --> 00:09:44,200
أمسكه

122
00:09:44,580 --> 00:09:46,620
أ-أمسكه

123
00:09:46,620 --> 00:09:47,710
أمسكه

124
00:09:51,340 --> 00:09:55,970
أمسكه، أهزّه أهزّه، شووب وسوي

125
00:09:55,970 --> 00:10:00,390
سوي، سوي، سوي

126
00:10:00,390 --> 00:10:05,060
مـ-ميو، دعينا لا نفعل هذا الآن

127
00:10:08,350 --> 00:10:12,480
هذه البلدة نشيطة بلا ريب

128
00:10:12,480 --> 00:10:16,740
الكثير من الملابس
لم أرَ قطّ شيئًا كهذا

129
00:10:16,740 --> 00:10:22,240
تختصّ هذه البلدة بالأقمشة المصبوغة
يرتدي المواطنون أزياء ملوّنة أيضًا

130
00:10:22,240 --> 00:10:24,870
أجل، يبدو الحرفيّون ماهرين جدًّا أيضًا

131
00:10:24,870 --> 00:10:27,080
أجل، إنّه مبهر جدًّا

132
00:10:27,080 --> 00:10:28,920
يسرّني أنّنا أخذنا هذا المنعطف

133
00:10:29,620 --> 00:10:30,750
ميو

134
00:10:30,750 --> 00:10:31,750
ميو؟

135
00:10:31,750 --> 00:10:36,720
ما نوع الملابس الّتي يرتديها شعب البحر عادةً؟

136
00:10:36,720 --> 00:10:38,380
ننزعها في الغالب

137
00:10:38,380 --> 00:10:41,340
ماذا؟
عراة؟

138
00:10:43,050 --> 00:10:45,600
هذا جريء جدًّا--
عراة--

139
00:10:45,600 --> 00:10:48,940
لعلّي لا أستطيع العيش في إيريسن

140
00:10:48,940 --> 00:10:52,060
إذًا يا هاجيمي أينبغي لكلينا أن نعيش في إيريسن مع ميو؟

141
00:10:52,060 --> 00:10:53,650
ثلاثتنا فقط؟

142
00:10:53,650 --> 00:10:57,490
ما-ماذا؟
سأعيش معكم

143
00:10:57,490 --> 00:10:58,780
أنا أيضًا

144
00:10:58,780 --> 00:11:00,450
أنا كذلك

145
00:11:00,450 --> 00:11:02,240
...أنتنّ

146
00:11:03,070 --> 00:11:04,370
!عجبًا

147
00:11:08,200 --> 00:11:11,330
أثمّة ما ترغبين فيه يا ميو هنا؟

148
00:11:11,330 --> 00:11:12,330
بابا؟

149
00:11:12,330 --> 00:11:16,340
بما أنّنا هنا سأشتري لكِ واحدًا إن كان لديكِ ثوب مفضّل

150
00:11:16,340 --> 00:11:17,630
حقًّا؟

151
00:11:19,260 --> 00:11:20,590
عجبًا

152
00:11:20,590 --> 00:11:22,760
اختاري أيّما تريدينه

153
00:11:26,970 --> 00:11:29,640
يـ-يمكنكنّ جميعًا شراء خاصّتكنّ

154
00:11:29,640 --> 00:11:32,400
ليستْ هذه المشكلة يا هاجيمي

155
00:11:33,810 --> 00:11:35,900
ما الأمر يا ميو؟

156
00:11:35,900 --> 00:11:40,320
أريد تجربة ثياب أختي الكبرى يوي

157
00:11:40,320 --> 00:11:41,780
ثيابي؟

158
00:11:41,780 --> 00:11:43,160
نعم

159
00:11:43,160 --> 00:11:47,080
لكن توجد هنا الكثير من الأزياء الأجمل من ثيابي

160
00:11:47,080 --> 00:11:51,620
أتعلمين؟
الأخت الكبرى يوي هي أروع أختٍ كبرى

161
00:11:51,620 --> 00:11:53,120
ماذا؟

162
00:11:53,120 --> 00:11:59,460
حين تستعملين السّحر وتقاتلين بجانب بابا، أنتِ رائعة جدًّا

163
00:11:59,460 --> 00:12:01,880
لا

164
00:12:01,880 --> 00:12:05,930
أنا ابنة بابا، لكنّني ضعيفة

165
00:12:05,930 --> 00:12:12,600
لذلك أريد أن أصبح مثل أختي الكبرى يوي، لكي أكون أقوى قليلًا

166
00:12:12,600 --> 00:12:15,150
ميو

167
00:12:15,150 --> 00:12:18,480
!يا لك من مَلاك يا ميو
لا أستطيع كبح نفسي

168
00:12:19,980 --> 00:12:26,030
ألستُ رائعة يا ميو-تشان؟
أستطيع سحق أيّ عدوّ بضربة واحدة

169
00:12:26,030 --> 00:12:29,290
منتجة كتلة قطع من اللّحم

170
00:12:29,290 --> 00:12:33,670
الأخت الكبرى كاوري يا ميو-تشان أيضًا بارعة جدًّا في تقييد الأعداء

171
00:12:33,670 --> 00:12:36,710
أتريدين رؤية نصول تقييد الضّوء السّريعة خاصّتي؟

172
00:12:37,500 --> 00:12:44,300
سأريكِ هجوم نفَسي
ستتلألأ عيناكِ من روعتي

173
00:12:49,510 --> 00:12:51,810
أخواتي الكبرى

174
00:12:51,810 --> 00:12:57,860
أنتِ لستِ رائعة يا أختي الكبرى شيا، أنتِ تقريبًا... مهملة

175
00:12:59,070 --> 00:13:03,900
أختي الكبرى كاوري... ضعيفة قليلًا

176
00:13:03,900 --> 00:13:05,360
لا

177
00:13:05,360 --> 00:13:08,870
لا بأس بكِ يا أختي الكبرى تيو

178
00:13:08,870 --> 00:13:11,620
ماذا يعني هذا؟

179
00:13:14,290 --> 00:13:18,040
لا، هذا غير مقبول تمامًا

180
00:13:18,040 --> 00:13:22,210
ما هذا التّصرّف الغريب يا يوي؟

181
00:13:23,630 --> 00:13:28,800
يبدو وكأنّ أحدهم بحاجة إلى أن يتعلّم ما يعنيه أن تتخطّى تنينًا

182
00:13:33,930 --> 00:13:39,560
أظنّ أنّ ملابسكنّ جميعًا رائعة

183
00:13:39,560 --> 00:13:42,320
يا أخواتي الكبرى شيا وتيو وكاوري

184
00:13:43,280 --> 00:13:45,860
...لذا

185
00:13:45,860 --> 00:13:49,820
وجدتها، لنتبادل الملابس

186
00:13:49,820 --> 00:13:51,490
نتبادل الملابس؟

187
00:13:51,490 --> 00:13:55,710
هذا صحيح، إن تبادلنا ملابسنا فيمكننا ارتداء ملابس بعضنا البعض جميعًا

188
00:13:55,710 --> 00:13:58,210
سيكون مسليًّا

189
00:13:59,920 --> 00:14:04,010
لمَ لا تُسايرن اقتراح ميو؟

190
00:14:04,010 --> 00:14:07,430
عن طريق القرعة أو ما شابه واخترن عشوائيًّا

191
00:14:07,430 --> 00:14:08,840
هاجيمي--
هاجيمي-سان--
هاجيمي-كون--
سيّدي--

192
00:14:08,840 --> 00:14:14,770
أنا متأكّد أنّه بإمكانكن الحصول على تعديل حجم سريع في أيّ مكان داخل هذه البلدة

193
00:14:16,350 --> 00:14:18,400
حُسمَ الأمر

194
00:14:23,690 --> 00:14:26,240
اُنظر، اُنظر يا بابا

195
00:14:33,120 --> 00:14:37,290
هذا جميل يا ميو
تبدين بالغة أكثر قليلًا

196
00:14:38,580 --> 00:14:41,500
لا يمكنكِ فتحه فجأة يا ميو

197
00:14:55,180 --> 00:14:57,310
أنتِ جميلة جدًّا يا أختي الكبرى يوي

198
00:14:57,310 --> 00:14:58,770
أشكركِ

199
00:15:02,400 --> 00:15:08,320
لم أرتدِ قطّ شيئًا كهذا سابقًا، هذا إحساس جديد

200
00:15:11,110 --> 00:15:17,200
زيّ كاوري-سان فيه طبقات كثيرة، من الصّعب التّحرّك داخله

201
00:15:17,200 --> 00:15:19,960
إنّه يناسبكِ يا تيو

202
00:15:22,170 --> 00:15:24,420
وأنتِ أيضًا يا شيا

203
00:15:24,420 --> 00:15:26,590
أشكركَ

204
00:15:26,590 --> 00:15:30,010
أختاي الكبريتان تيو وشيا ظريفتان جدًّا

205
00:15:32,970 --> 00:15:35,180
ماذا عن كاوري؟
أين هي؟

206
00:15:35,180 --> 00:15:37,430
سأسحبها للخارج

207
00:15:38,390 --> 00:15:39,520
يوي؟

208
00:15:40,730 --> 00:15:45,400
لا، يستحيل أن أخرج بزيّ شيا، إنّه فاضح

209
00:15:45,400 --> 00:15:47,690
كفّي عن هذا، كفّي عن هذا

210
00:15:47,690 --> 00:15:50,400
لا أستطيع، لا أستطيع

211
00:15:50,400 --> 00:15:52,820
لا تكوني هكذا

212
00:16:04,580 --> 00:16:09,960
...هذا فاضح جدًّا، لا تحدّق رجاءً يا هاجيمي-كون

213
00:16:34,450 --> 00:16:38,280
...فتاة بحريّة تكوّرتْ مثل هرّة، ظرافتها خارج التّوقّعات

214
00:16:38,280 --> 00:16:40,500
لنربّتْ عليها

215
00:16:42,960 --> 00:16:49,840
سأربّتُ عليها باستخدام مهارات الملاطفة القصوى خاصّتي محترزة ألّا أوقظها

216
00:16:53,760 --> 00:16:57,510
لم أستطع تمالك نفسي

217
00:16:58,220 --> 00:17:02,560
!يا لها من مهارة مرعبة
إنّها بارعة

218
00:17:05,480 --> 00:17:08,940
وجهكِ في حالة فوضى يا يوي-سان

219
00:17:08,940 --> 00:17:11,030
تصرّفتِ بلطف للغاية، ذِبتِ أساسًا

220
00:17:11,030 --> 00:17:13,950
تبدين كمنحرفة خطيرة

221
00:17:13,950 --> 00:17:18,370
دعتني منحرفة حقيقيّة بمنحرفة خطيرة، عارٌ لا يُطاق

222
00:17:20,410 --> 00:17:25,120
ثمين جدًّا، ثمين إلى أقصى درجة

223
00:17:25,120 --> 00:17:31,130
يقول هاجيمي أحيانًا لفظًا غريبًا، إلى أقصى درجة، ماذا؟

224
00:17:32,590 --> 00:17:35,340
...حسنًا، على كلّ حال

225
00:17:35,340 --> 00:17:39,510
...قالتْ أمس إنّني أروع أختٍ كبرى، لكن

226
00:17:39,510 --> 00:17:45,600
عندي شكوى واحدة، لن تناديني بماما

227
00:17:45,600 --> 00:17:46,520
لماذا؟

228
00:17:46,520 --> 00:17:49,190
لمَ لا يا ميو؟

229
00:17:49,190 --> 00:17:55,200
...أفترض أنّه بالنّسبة لميو أمّها الحقيقيّة هي الماما خاصّتها، لا بأس بهذا، لكن

230
00:17:55,200 --> 00:18:01,530
تظنّ يوي-سان أنّه بمقدوركِ أن تحظي بأكثر من ماما واحدة

231
00:18:01,530 --> 00:18:05,580
في الواقع أن تكون لكِ أمّانِ صفقة رائعة--
هاها، ماما وماما--

232
00:18:05,580 --> 00:18:10,380
هذه ليست صفقة اشترِ واحدًا واحصل على الثّاني مجانًا يا يوي-سان

233
00:18:10,380 --> 00:18:13,880
صوتكِ الداخليّ يتسرّب كثيرًا للخارج

234
00:18:13,880 --> 00:18:15,720
أيقظتِ ميو-تشان

235
00:18:16,800 --> 00:18:19,260
ماذا؟

236
00:18:21,470 --> 00:18:22,560
ميو

237
00:18:22,560 --> 00:18:24,970
نـ-نعم

238
00:18:24,970 --> 00:18:31,190
لا تقلقي، أختكِ الكبرى يوي مُرضيّة جدًّا كثيرًا

239
00:18:33,360 --> 00:18:38,860
هذا لا يُحتمل، يُصنّف هذا في أسوإ ثلاث لحظات في حياتي

240
00:18:38,860 --> 00:18:40,990
أريد أن أجد هاوية وأختبئ داخلها

241
00:18:41,870 --> 00:18:47,870
أظنّ أنّ هذا ما كانتْ لتفعله ماما

242
00:18:48,920 --> 00:18:51,500
أحبّكِ يا أختي الكبرى يوي

243
00:18:52,960 --> 00:18:58,300
أنتِ قويّة جدًّا ورائعة وجميلة ولطيفة

244
00:18:58,300 --> 00:19:00,430
مـ-ميو

245
00:19:00,430 --> 00:19:03,930
ما هذا؟

246
00:19:03,930 --> 00:19:07,850
هذه السّكينة، كما لو أنّني أُحضنُ من قِبل أمّ

247
00:19:07,850 --> 00:19:12,150
طاقتي تُستنزف

248
00:19:12,150 --> 00:19:17,740
لو كنتُ أملكُ ماما كأختي الكبرى يوي لكان أمرًا رائعًا

249
00:19:17,740 --> 00:19:23,320
لكنّني أملك أمًّا بالفعل، وهي ماما الوحيدة

250
00:19:24,660 --> 00:19:28,330
...لكنّني لا أملكُ أختًا كبرى، لذا

251
00:19:32,580 --> 00:19:35,880
أجل، ستكون يوي-سان أختكِ الكبرى

252
00:19:38,760 --> 00:19:41,050
أنا أختكِ الكبرى

253
00:19:41,680 --> 00:19:45,180
أشكركِ يا أختي الكبرى يوي

254
00:19:45,890 --> 00:19:51,140
!تربّتُ ميو عليّ، يا لها من تجربة شافية

255
00:19:51,140 --> 00:19:53,520
العزّة للأخت الكبرى

256
00:19:53,520 --> 00:19:55,770
أذابتْ يوي؟

257
00:19:55,770 --> 00:19:58,570
مواهب ميو-تشان مرعبة

258
00:19:58,570 --> 00:20:03,870
أشعر بحضور أموميّ من ميو، وهل رجعتْ يوي إلى حالة طفوليّة؟

259
00:20:05,030 --> 00:20:10,790
مستحيل، حصلتِ الظّاهرة بين ميو ويوي

260
00:20:10,790 --> 00:20:14,500
أتعلم بشأن هذا يا سيّدي؟

261
00:20:14,500 --> 00:20:17,590
دعيني أشرح، يُسمّى هذا في عالمي

262
00:20:17,590 --> 00:20:20,170
"الشّعور بالأمومة والشّروع في البكاء"

263
00:20:20,170 --> 00:20:21,800
ما معناه؟

264
00:20:21,800 --> 00:20:25,930
ماذا حدث لميو ويوي-تشان؟

265
00:20:25,930 --> 00:20:31,810
بشكل واضح طبيعة ميو الأموميّة ولطفها يجعل يوي

266
00:20:31,810 --> 00:20:35,400
ترغب في أن تُحضن كطفل

267
00:20:37,610 --> 00:20:41,240
ثمين جدًّا... ثمين بشكل لا نهائيّ جدًّا

268
00:20:41,240 --> 00:20:44,030
عكس الأدوار ثمين أيضًا

269
00:20:44,030 --> 00:20:48,870
أنا أراقب انهيار سيّدي--
ثمين... ثمين... ثمين جدًّا--

270
00:20:48,870 --> 00:20:55,380
أظنّ أنّ هاجيمي يملك فعلًا النّزعة ليفقد السّيطرة حول يوي--
ثمين... ثمين... ثمين جدًّا--

271
00:20:55,380 --> 00:20:59,750
تذهب يوي من حضور أموميّ كامل إلى رجوع طفوليّ

272
00:20:59,750 --> 00:21:05,930
في المقابل تملك ميو-تشان حضورًا أموميًّا كاملًا

273
00:21:05,930 --> 00:21:11,640
فهمت، حتّى سيّدي لا يستطيع تحمّل هذه القوّة المدمّرة

274
00:21:12,930 --> 00:21:18,360
أتقبّل المنطق خلف كوني أختًا كبرى، لكنّ الأمومة مغرية مع ذلك

275
00:21:18,360 --> 00:21:21,070
...إلّم أستطع أن أكون ماما ميو

276
00:21:23,900 --> 00:21:28,530
...فأودّ أن أعيد التّفكير في فكرة أن أنجب طفلي

277
00:21:28,530 --> 00:21:30,450
لا تزال الرّحلة مستمرّة

278
00:21:30,450 --> 00:21:37,460
لا يمكنني الهجوم... أعني أن أبدأ خطة أسرتي السّعيدة مع هاجيمي الآن

279
00:21:37,460 --> 00:21:39,920
أملك ما يكفي من التّحكّم بالنّفس لفهم ذلك

280
00:21:39,920 --> 00:21:46,430
لكن حينها لا يمكنني مواصلة مضايقة ميو هكذا

281
00:21:47,050 --> 00:21:48,260
هاجيمي

282
00:21:50,760 --> 00:21:52,060
أتريد أن تشرع في البكاء؟

283
00:21:57,100 --> 00:22:01,980
تريدينني أن أكون الطّفل؟
ليس إلى هذه الدّرجة