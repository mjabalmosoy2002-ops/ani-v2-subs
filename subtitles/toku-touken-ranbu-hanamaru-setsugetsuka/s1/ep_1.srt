1
00:00:32,550 --> 00:00:33,400
!هذا لا يكفي

2
00:00:33,920 --> 00:00:36,430
!عندما أقفز، فستكون ضمن نطاقي

3
00:00:48,420 --> 00:00:50,940
ابتسم لأجلي، طريقة نيكّاري

4
00:00:58,590 --> 00:00:59,530
سوف أسحقكم

5
00:01:05,330 --> 00:01:07,050
!الآن يا كينشين

6
00:01:08,380 --> 00:01:11,170
!ما-ما رأيك بهذا؟

7
00:01:19,130 --> 00:01:20,350
أنا مُرهَق

8
00:01:22,160 --> 00:01:24,670
أبليتَ حسناً يا كينشين

9
00:01:26,430 --> 00:01:29,730
هل نلنا منهم جميعاً؟

10
00:01:29,730 --> 00:01:33,200
،أجل. مايدا وأنا تفقّدنا المنطقة

11
00:01:33,200 --> 00:01:35,320
ولم نعُد نشعر بالعدوّ

12
00:01:35,710 --> 00:01:37,360
اكتملت تلك المهمّة

13
00:01:37,360 --> 00:01:39,360
لنعُد إذاً

14
00:01:39,360 --> 00:01:40,570
أجل

15
00:01:39,570 --> 00:01:40,100
حسناً

16
00:01:44,940 --> 00:01:45,920
مهلاً

17
00:01:45,920 --> 00:01:47,060
هل أنت بخير؟

18
00:01:47,060 --> 00:01:48,740
لم تتأذّ، أليس كذلك؟

19
00:01:48,740 --> 00:01:50,420
أ-أنا بخير

20
00:01:50,780 --> 00:01:52,340
شكراً يا أزوكي

21
00:01:53,380 --> 00:01:57,090
أخبرني، ما هذا الّذي بين قدميك؟

22
00:01:58,550 --> 00:01:59,800
ما هذا بالفعل؟

23
00:02:02,530 --> 00:02:05,470
يبدو فولاذاً خاماً

24
00:02:05,470 --> 00:02:07,120
فولاذ خام؟

25
00:02:07,120 --> 00:02:08,820
يا له من اكتشاف

26
00:02:08,820 --> 00:02:11,100
يمكننا أخذه إلى سيّدي كتذكار

27
00:02:12,440 --> 00:02:14,150
أنا متأكّد بأنّه سيُحبّه

28
00:02:15,190 --> 00:02:16,310
معك حقّ

29
00:02:17,900 --> 00:02:21,620
يبدو ذلك الشّيء غريباً بالنّسبة لي

30
00:02:22,890 --> 00:02:28,210
على ذكرِك للأمر، يبدو مختلفاً عن
الفولاذ الخام المعتاد

31
00:02:28,210 --> 00:02:31,500
لكن الفولاذ الخام هو مورد قيّم

32
00:02:31,500 --> 00:02:35,220
سأسأل سيّدي فيما إذا كان
يجدر بنا إعادته إذاً

33
00:02:35,220 --> 00:02:37,170
حسناً، من فضلك

34
00:02:41,140 --> 00:02:43,150
آمل ألّا يكون أمراً جللاً

35
00:02:43,690 --> 00:02:46,900
لكن لماذا يوجد فولاذ خامّ في هذا
المكان من الأساس؟

36
00:02:47,320 --> 00:02:50,020
ربّما يوجد مشغل حدادة قريب؟

37
00:02:51,410 --> 00:02:52,470
نيكّاري-سان؟

38
00:02:53,410 --> 00:02:55,030
هل من مُشكلة؟

39
00:02:55,030 --> 00:02:56,030
...لا

40
00:02:58,590 --> 00:02:59,960
ماذا قال؟

41
00:02:59,960 --> 00:03:00,490
...في الواقع

42
00:03:00,920 --> 00:03:05,980
طلب سيّدي أن نُعيده معنا وذلك كي يتفقّده

43
00:03:05,980 --> 00:03:08,910
إن كان سيّدي يقول ذلك، فهذا
ما يجب علينا فعله

44
00:03:09,320 --> 00:03:11,960
لنعُد جميعاً إلى الحصن

45
00:03:11,960 --> 00:03:13,040
أجل

46
00:03:20,940 --> 00:03:23,930
يحكي هذا الأنمي عن قصص"
أيّام هانامارو المُبهِجة

47
00:03:23,930 --> 00:03:28,760
لمجموعة ما من مُحاربي السّيف
"في حصن ما

48
00:03:32,850 --> 00:03:35,770
!يراودني شعور رائع

49
00:03:36,250 --> 00:03:40,990
ربحتُ نِزالاً ضدّ ياسوسادا، وحظيتُ بحمّام جيّد

50
00:03:41,390 --> 00:03:45,870
لم يكن ذلك عادلاً. انقضضت نحوي
قبل أن نعطي إشارة للبدء حتّى

51
00:03:46,400 --> 00:03:49,250
لن ينتظرك العدوّ في المعركة

52
00:03:49,740 --> 00:03:51,710
...حسناً، أجل، لكن

53
00:03:52,090 --> 00:03:55,840
يجب أن تبقى يقظاً منذ لحظة دخولك للدوجو

54
00:03:59,870 --> 00:04:01,840
ما-ماذا؟

55
00:04:06,430 --> 00:04:08,890
هذا غريب. إنّها لا تعمل

56
00:04:09,260 --> 00:04:11,100
هل تعطّلت؟

57
00:04:11,490 --> 00:04:16,060
لكن هل يُعقَل أن تتعطّل الستّة
خاصّتنا في نفس الوقت؟

58
00:04:16,060 --> 00:04:18,770
هذا غير منطقيّ

59
00:04:26,120 --> 00:04:29,120
اهدآ. ستكسران الآلة

60
00:04:29,120 --> 00:04:30,910
!لنفعل ذلك في وقت لاحق

61
00:04:30,910 --> 00:04:35,210
يجب أن نعود في الحال ونبلغ
!سيّدي عن هذا الشّذوذ

62
00:04:35,520 --> 00:04:37,850
إنّ الضّغط على هذا ينبغي أن يُعيدنا

63
00:04:37,850 --> 00:04:39,570
!يُفترض أن يُعيدنا إلى المنزل

64
00:04:39,570 --> 00:04:43,920
لكن نفس تلك الأداة هي
الّتي ترفض العمل

65
00:04:43,920 --> 00:04:47,340
كم هذا مُزعج. لم يحدث هذا من قبل

66
00:04:48,550 --> 00:04:51,270
ماذا؟ أزهار كرز الجبل؟

67
00:04:52,270 --> 00:04:56,980
إنّها جميلة من ناحية مختلفة مُقارنة
بأزهار الكرز في الحصن

68
00:04:57,310 --> 00:05:00,050
لا حاجة للارتعاد

69
00:05:00,050 --> 00:05:03,940
لا بدّ أنّ أصدقاءنا في الحصن
قد فهموا الوضع بالفعل

70
00:05:05,530 --> 00:05:06,820
معك حقّ

71
00:05:07,770 --> 00:05:11,760
عـ-عرفتُ ذلك من دون أن تخبرني

72
00:05:12,740 --> 00:05:16,420
سامحوني. فقدتُ هدوئي

73
00:05:16,840 --> 00:05:19,770
لنُراجع الوضع أوّلاً

74
00:05:25,630 --> 00:05:27,590
استكشفنا المنطقة

75
00:05:27,590 --> 00:05:29,080
هل وجدتُما شيئاً؟

76
00:05:29,080 --> 00:05:33,060
لا شيء يُعرقل سفرنا الزّمكانيّ

77
00:05:33,340 --> 00:05:37,370
إذاً جيش الانحسار الزمنيّ لا يقف وراء ذلك

78
00:05:37,370 --> 00:05:38,520
هكذا يبدو

79
00:05:38,800 --> 00:05:42,680
جوهريّاً، نحن في وضع لا نستطيع
،فيه الاتّصال بالحصن

80
00:05:42,680 --> 00:05:47,360
ولا نعلم متى سنتمكّن من العودة
إلى المنزل من هذا العصر

81
00:05:47,360 --> 00:05:48,870
أهكذا هو الأمر؟

82
00:05:50,740 --> 00:05:54,580
في هذه الحالة، لنفكّر كيف سوف نقضي
وقتنا في هذا العصر

83
00:05:55,980 --> 00:06:00,590
،إذا لم نستطع الرّجوع أو التقدُّم للأمام
فكلّ ما يمكننا فعله هو الانتظار

84
00:06:00,590 --> 00:06:03,570
،ليس وكأنّني غير مُتفاجئ بواسطة هذا الوضع

85
00:06:03,570 --> 00:06:08,990
لكن إذا كان هناك ما يجري، فحصننا
سوف يبحث عن حلّ

86
00:06:09,250 --> 00:06:11,550
أجل، سيُصلحون هذا الأمر

87
00:06:11,880 --> 00:06:15,520
إذاً لنحاول اكتشاف ما نحتاجه الآن

88
00:06:16,000 --> 00:06:19,040
أوّلاً، علينا تأمين قاعدة

89
00:06:19,040 --> 00:06:20,520
سنحتاج مكاناً ننام فيه

90
00:06:20,940 --> 00:06:24,620
رأينا بيتاً مهجوراً على ما يبدو من قبل

91
00:06:24,620 --> 00:06:26,240
يبدو هذا مُناسباً

92
00:06:26,680 --> 00:06:29,310
يجب علينا تبديل ملابسنا أيضاً

93
00:06:29,310 --> 00:06:31,950
سنُلفت الكثير من الأنظار بلباس كهذا

94
00:06:32,220 --> 00:06:37,410
والطّعام. لا يمكن القتال بمعدة خاوية

95
00:06:37,660 --> 00:06:43,420
باختصار، نحتاج مواردَ قبل القيام بأيّ شيء

96
00:06:43,770 --> 00:06:45,050
،لذا، في الوقت الرّاهن

97
00:06:45,460 --> 00:06:47,780
لنذهب إلى البلدة

98
00:06:54,820 --> 00:06:56,390
...أداة النّقل الآنيّ

99
00:06:58,340 --> 00:06:59,310
إيشيكيريمارو؟

100
00:06:59,310 --> 00:07:00,570
هل من مُشكلة؟

101
00:07:00,570 --> 00:07:04,790
لا أعلم، لكن أشعر بهالة
!مُريعة عند المدخل

102
00:07:13,790 --> 00:07:15,700
!لدينا مُصيبة

103
00:07:20,550 --> 00:07:21,580
!رِفاق

104
00:07:22,600 --> 00:07:23,710
ما الأمر؟

105
00:07:23,710 --> 00:07:25,000
لا أعلم

106
00:07:25,000 --> 00:07:28,840
حدث سقوط ضخم بينما كنّا ننتقل آنيّاً

107
00:07:29,190 --> 00:07:30,540
تمالك نفسك

108
00:07:30,540 --> 00:07:33,080
...رأيتُ ذلك لوهلة

109
00:07:34,350 --> 00:07:37,970
كانت هناك هالة ظلاميّة تترشّح
من ذلك الفولاذ الخام

110
00:07:39,640 --> 00:07:41,160
رأيتُ ذلك أيضاً

111
00:07:42,250 --> 00:07:44,770
لا أعرف ما كان، لكن كان شرّيراً

112
00:07:45,590 --> 00:07:48,280
يجب أن نُبلغ سيّدي عنه حالاً

113
00:07:48,280 --> 00:07:51,170
لا تضغط على نفسك. سأذهب وأبلغ سيّدي

114
00:07:51,170 --> 00:07:53,160
!لدينا مُشكلة كبيرة جميعاً

115
00:07:57,210 --> 00:07:59,310
السّـ-سّانيوا

116
00:08:00,080 --> 00:08:02,290
!السّانيوا قد سقط

117
00:08:07,640 --> 00:08:09,710
ما رأيكِ بمُبادلته مع قطعة القماش هذه؟

118
00:08:10,530 --> 00:08:12,220
ماذا نفعل؟

119
00:08:12,790 --> 00:08:15,740
...مُعظم ما سنحتاجه موجود هنا، لكن

120
00:08:18,680 --> 00:08:21,690
أسمع موسيقى من نوع ما

121
00:08:21,690 --> 00:08:22,600
أنا أيضاً

122
00:08:24,390 --> 00:08:26,560
موسيقى؟

123
00:08:27,220 --> 00:08:29,860
أصغوا جيّداً جميعاً

124
00:08:30,320 --> 00:08:31,690
!ماذا؟

125
00:08:31,690 --> 00:08:32,600
صه

126
00:08:33,220 --> 00:08:35,020
هل أنت جادّ؟

127
00:08:35,020 --> 00:08:38,450
أجل. أظهِروا للجميع ما تمرّنتُم لأجله

128
00:08:38,780 --> 00:08:40,250
أعتقد سيترتّب علينا ذلك

129
00:08:40,250 --> 00:08:42,260
...أجل

130
00:08:42,260 --> 00:08:44,490
ليس وكأنّنا نملك خياراً آخر

131
00:08:44,490 --> 00:08:48,170
إذا كنتُ سأفعل هذا، فسأفعله بإتقان

132
00:08:48,480 --> 00:08:53,620
سأحضر الجمهور. هيوغا، تولّ أمر المُفاوضات

133
00:08:53,620 --> 00:08:54,630
عُلِم

134
00:08:54,630 --> 00:08:56,900
حسناً، لنفعل هذا

135
00:08:56,900 --> 00:08:57,740
أجل

136
00:09:18,710 --> 00:09:21,540
!تعالوا جميعاً

137
00:09:21,860 --> 00:09:25,500
ستشهدون رقصة نادرة جدّاً

138
00:09:25,500 --> 00:09:30,010
!لا يمكنكم رؤيتها إلّا هنا، مُفاجأة لكافّة العصور

139
00:09:30,010 --> 00:09:33,630
!إذا فوّتُم هذا العرض، ستندمون على ذلك للأبد

140
00:09:34,010 --> 00:09:36,740
!لذا أطلب منكم جميعاً الاجتماع هنا

141
00:09:38,230 --> 00:09:41,100
من فضلكم، تابعوا أداءكم

142
00:09:41,570 --> 00:09:43,810
...ماذا؟ حـ-حسناً

143
00:09:44,380 --> 00:09:47,020
مُذهل! هناك الكثير من النّاس

144
00:09:48,390 --> 00:09:50,330
بدأتُ أشعر بالتوتُّر

145
00:09:50,330 --> 00:09:53,380
لا تقلق. يمكننا فعلها

146
00:09:53,380 --> 00:09:56,190
لنبقَ هادئين ونفعل هذا كالمعتاد

147
00:09:56,190 --> 00:09:57,770
ستفلح الأمور

148
00:09:57,770 --> 00:10:00,740
معك حقّ... أجل

149
00:10:01,810 --> 00:10:05,190
!حسناً، تمّ تهيئة المسرح

150
00:10:10,530 --> 00:10:12,880
هذه هي إطلالتنا الأولى

151
00:10:13,370 --> 00:10:15,510
!احفروا هذا في عقولكم

152
00:11:39,070 --> 00:11:41,660
كـ-كيف كان ذلك؟

153
00:11:44,980 --> 00:11:45,970
!أحسنتم

154
00:11:45,970 --> 00:11:46,970
!يا فتيان

155
00:11:47,360 --> 00:11:49,260
يا له من تصفيق حارّ

156
00:11:49,260 --> 00:11:51,410
!فـ-فعلناها

157
00:11:51,410 --> 00:11:53,420
هذا شعور مُذهل

158
00:11:53,420 --> 00:11:55,350
غليان حقيقيّ للدّماء

159
00:11:55,690 --> 00:11:59,280
!يمكنكم الدّفع للعرض بأي طريقة ترغبونها

160
00:11:59,280 --> 00:12:03,710
!حبوب، دُخن، فاصولياء، قماش... أيّ شيء

161
00:12:04,410 --> 00:12:05,520
!ها نحن أولاء

162
00:12:05,000 --> 00:12:06,510
شكراً لك

163
00:12:05,520 --> 00:12:06,460
!كان ذلك مُسلّياً

164
00:12:06,460 --> 00:12:07,450
!خذوا هذه

165
00:12:06,910 --> 00:12:08,290
!شكراً لكم

166
00:12:08,290 --> 00:12:10,210
أبليتُم بلاء حسناً أيضاً

167
00:12:10,210 --> 00:12:11,780
كان أداء ممتازاً

168
00:12:11,070 --> 00:12:13,070
قدّموا عرضاً لنا ثانية يوماً ما

169
00:12:14,740 --> 00:12:17,210
آسف بشأن تلك المُفاجأة الكريهة

170
00:12:21,200 --> 00:12:23,880
آسف، لكن سنأخذ حصّتنا

171
00:12:24,280 --> 00:12:27,200
بالطّبع. خذوا ما تحتاجون

172
00:12:27,200 --> 00:12:28,350
أشكرك

173
00:12:28,700 --> 00:12:32,160
لم نؤدّ أبداً أمام جمهور كبير كهذا من قبل

174
00:12:32,160 --> 00:12:34,100
!تعال وانظر إلى هذا

175
00:12:34,100 --> 00:12:34,740
قادم

176
00:12:35,290 --> 00:12:37,650
...بالمناسبة، هل يمكنكم الانضمام لنا غداً

177
00:12:39,390 --> 00:12:40,220
ماذا؟

178
00:12:49,640 --> 00:12:52,620
تبدون رائعين جميعكم

179
00:12:53,090 --> 00:12:57,580
هذا حماسيّ. هذه أوّل مرّة أرتدي
فيها ثياباً من هذا العصر

180
00:12:58,040 --> 00:13:01,550
والآن يمكننا دخول البلدة من دون لفت انتباه

181
00:13:02,040 --> 00:13:06,890
هذا المكان قديم بعض الشّيء، لكنّه
سوف يُبقينا آمنين من العناصر

182
00:13:07,230 --> 00:13:09,850
ولدينا ما يكفي من طعام للصّمود حاليّاً

183
00:13:10,270 --> 00:13:14,520
يوجد بئر في الخلف، لذا سيكون
لدينا ماء أيضاً

184
00:13:14,520 --> 00:13:16,810
لدينا الكثير بما يكفي للاختباء لفترة

185
00:13:17,160 --> 00:13:21,710
رغم أنّنا رجعنا للتو من القيام بعكس الاختباء

186
00:13:21,710 --> 00:13:23,030
معك حقّ

187
00:13:23,030 --> 00:13:27,490
بالمناسبة يا تسورومارو، رآنا
كثير من النّاس للتو

188
00:13:28,100 --> 00:13:31,400
ألن يعني هذا بأنّنا أثّرنا على التّاريخ؟

189
00:13:31,400 --> 00:13:32,700
لا مُشكلة

190
00:13:33,310 --> 00:13:39,250
المُؤدّون العشوائيّون من غير المُرجّح
أن يُشكّلوا أثراً في التّاريخ

191
00:13:39,970 --> 00:13:44,380
ما لم يحاول شخصٌ باستماتة الحِفاظ
،على سجلّات اليوم للمُستقبل

192
00:13:44,670 --> 00:13:48,810
ما فعلناه لن يُدوَّن غالباً في كُتُب التّاريخ

193
00:13:49,760 --> 00:13:51,390
هكذا إذاً

194
00:13:51,390 --> 00:13:55,150
التّاريخ مُقدّس أكثر ممّا نُدرك

195
00:13:56,140 --> 00:14:00,580
التّاريخ هو ما يمنحنا نحن مُحاربي السّيف شكلاً

196
00:14:00,580 --> 00:14:04,650
هذا مُمكن فقط لأنّ النّاس
بذلوا قصارى جهدهم

197
00:14:05,190 --> 00:14:08,140
لترك سجلّات عن تاريخنا وقصصنا

198
00:14:08,140 --> 00:14:10,620
لهذا ما زالوا على قيد الحياة

199
00:14:11,680 --> 00:14:15,120
صُنِعتُ بواسطة ماساموني، صانع
سيوف كاماكورا

200
00:14:16,020 --> 00:14:21,500
،لقرون منذ ذلك الحين، كاتادا هيروزومي-ساما
،وإيشيدا ميتسوناري-ساما

201
00:14:22,010 --> 00:14:24,870
ثمّ توكوغاوا ميتسوسادا-ساما
...من عائلة كيشو توكوغاوا

202
00:14:25,630 --> 00:14:28,420
كانوا من بين القليل من النّاس
والعائلات الّتي توارثَتْني

203
00:14:31,210 --> 00:14:33,680
وأنا هذا السّيف الصّغير فحسب

204
00:14:34,440 --> 00:14:40,550
بفضل الأشخاص الّذين قدّروني
واستمرّوا في الحديث عنّي

205
00:14:41,130 --> 00:14:42,900
أقف هنا الآن

206
00:14:43,420 --> 00:14:44,790
...أجل

207
00:14:45,110 --> 00:14:46,340
!حسناً

208
00:14:46,340 --> 00:14:52,180
،ليس لأجل سيّدنا والحصن فحسب
،بل لأجل كلّ شخص يهتمّ لأمرنا

209
00:14:52,180 --> 00:14:54,970
لنبذل قصارى جهدنا لنتجاوز
هذا الوضع الشّاذ بأمان

210
00:14:54,970 --> 00:14:56,010
أجل

211
00:14:55,250 --> 00:14:56,010
!حسناً

212
00:15:24,010 --> 00:15:26,590
كيف حال سيّدي؟

213
00:15:26,590 --> 00:15:28,030
سيّئ. إنّه لا يستيقظ

214
00:15:28,400 --> 00:15:31,030
يصلّي أخي ويطرد الأرواح
،الشرّيرة بكامل قوّته

215
00:15:31,450 --> 00:15:33,780
لكن لا يُظهِر أي دلالة على الاستيقاظ

216
00:15:34,420 --> 00:15:35,270
!اللّعنة

217
00:15:40,980 --> 00:15:45,380
لعلّ هذا الفولاذ الخام يحتاج
مُعاينة عن كثب

218
00:15:45,760 --> 00:15:48,100
هلّا ذهبتُ معك؟

219
00:15:48,100 --> 00:15:51,970
إذا كان تعويذة أو لعنة ما، فقد
أتمكّن من تقديم المُساعدة

220
00:15:51,970 --> 00:15:52,880
بالطّبع

221
00:15:53,340 --> 00:15:54,780
كم سيستغرق ذلك من وقت؟

222
00:15:55,230 --> 00:15:56,350
...في الواقع

223
00:15:56,820 --> 00:15:59,140
سيستغرق بضع ساعات على الأقلّ

224
00:15:59,140 --> 00:16:00,810
...بضع ساعات

225
00:16:01,210 --> 00:16:03,520
سأبلغك حالما أعثر على شيء

226
00:16:04,230 --> 00:16:09,130
سوف أنعزل في غرفتي. هلّا أخبرتماني
إذا استجدّ شيء مع سيّدي؟

227
00:16:09,130 --> 00:16:10,210
عُلِم

228
00:16:10,210 --> 00:16:10,980
نانكاي

229
00:16:12,580 --> 00:16:13,700
نعتمد عليك

230
00:16:13,700 --> 00:16:16,010
أعلم. لن أخذلكما

231
00:16:20,730 --> 00:16:23,460
إيدو بلدة كبيرة حقّاً

232
00:16:23,460 --> 00:16:25,040
أليس كذلك؟

233
00:16:25,550 --> 00:16:29,300
إنّها مُفعمة بالطّاقة. مُجرّد المشي مُمتع

234
00:16:29,830 --> 00:16:34,660
توجد أمور كثيرة هنا ما كنّا
لنراها أبداً في ريوكيو

235
00:16:34,660 --> 00:16:39,360
ريوكيو... الجزُر الاستوائيّة في الجنوب؟

236
00:16:39,360 --> 00:16:41,670
كم أودّ زيارتها يوماً ما

237
00:16:41,670 --> 00:16:45,110
سمعتُ بأنّ المطاعم واللّغة مختلفان تماماً

238
00:16:45,550 --> 00:16:48,860
رغم أنّ موتسونوكامي وعصابته
لديهم لهجة قويّة جدّاً أيضاً

239
00:16:49,310 --> 00:16:52,400
أحبُّ اللّهجات بكافّة الأشكال

240
00:16:52,400 --> 00:16:57,320
أستمتع بالسّفر وأحبّ سماع اللّهجات
المحلّية أينما ذهبت

241
00:16:58,510 --> 00:17:00,860
هل تعرف الكثير عن اللّهجات يا كوريو؟

242
00:17:01,350 --> 00:17:02,510
إطلاقاً

243
00:17:03,980 --> 00:17:07,420
أتعلم كيف يسحرك طائرٌ
بزقزقته في بعض الأحيان؟

244
00:17:07,420 --> 00:17:09,160
نفس الأمر هنا

245
00:17:09,160 --> 00:17:13,760
حتّى لو كنتُ لا أفهم الكلمات، سماع
الأصوات يبقى له معنى

246
00:17:14,120 --> 00:17:16,120
هكذا إذاً

247
00:17:16,120 --> 00:17:17,540
انظروا

248
00:17:18,300 --> 00:17:19,760
يبيعون فطائر ورق تشيماكي

249
00:17:21,560 --> 00:17:23,270
يبدو هذا رائعاً

250
00:17:23,740 --> 00:17:26,140
،أحبّ الموتشي الأوكيناويّة خاصّتي
لكن هذه لذيذة أيضاً

251
00:17:26,140 --> 00:17:28,480
لنُعدّ بعضاً منها حالما نعود إلى الحصن

252
00:17:28,820 --> 00:17:30,150
يجدر بنا ذلك

253
00:17:31,250 --> 00:17:35,340
بجدّية، كيف لهم أن يكونوا بهذا
الاستهتار في وضع كهذا؟

254
00:17:35,340 --> 00:17:38,760
حسناً، التوتُّر سوف يُرهقك ليس إلّا

255
00:17:40,930 --> 00:17:45,620
لا أرى أي شذوذ هنا. ما الّذي يجري بالتّحديد؟

256
00:17:47,190 --> 00:17:49,500
هذه أوّل حالة في نهاية المطاف

257
00:17:49,500 --> 00:17:50,410
!بئساً

258
00:17:50,960 --> 00:17:54,060
!ملح! نسينا أن نشتري الملح

259
00:17:54,060 --> 00:17:57,800
كانوا يبيعون ملحاً عند الزّاوية
الّتي مررنا بها للتو

260
00:17:58,900 --> 00:18:00,260
إنّها بعيدة قليلاً

261
00:18:00,690 --> 00:18:01,940
سأذهب لشرائه

262
00:18:01,940 --> 00:18:03,890
سأحتفظ بأغراضك

263
00:18:03,890 --> 00:18:04,760
شكراً

264
00:18:07,050 --> 00:18:09,110
اسبقوني إلى القاعدة

265
00:18:10,270 --> 00:18:11,860
بالتّوفيق

266
00:18:25,620 --> 00:18:27,750
أجل، لطيف جدّاً

267
00:18:28,260 --> 00:18:29,500
كيف تسير الأمور هناك؟

268
00:18:30,750 --> 00:18:33,560
!لِمَ أنتما مُسترخيان هكذا؟

269
00:18:33,560 --> 00:18:39,050
،لم يمضِ على وجودنا في المطبخ كثيراً
لذا لا نُجيد العمل فيه

270
00:18:41,830 --> 00:18:43,220
أحضرنا الحطب

271
00:18:43,570 --> 00:18:46,170
ينبغي لهذا أن يجعلنا نصمد بضعة أيّام

272
00:18:46,170 --> 00:18:48,310
!تعلّما منهما

273
00:18:48,590 --> 00:18:52,440
يجب علينا تجاوز هذا الأمر بقلّتنا

274
00:18:52,440 --> 00:18:56,530
!فكّرنا فيما يمكنكما فعله، وافعلاه

275
00:18:56,830 --> 00:18:59,880
أحسنت صنعاً. خذ استراحة

276
00:18:59,880 --> 00:19:01,240
لكن ليس لدينا أطعمة خفيفة

277
00:19:01,240 --> 00:19:02,080
حسناً

278
00:19:02,080 --> 00:19:03,040
شكراً على الشّاي

279
00:19:03,040 --> 00:19:04,620
!هل تسمعانني؟

280
00:19:06,190 --> 00:19:11,500
لا أحد يعلم ما قد يحدث. يجب
علينا أن نحفظ طاقتنا

281
00:19:11,500 --> 00:19:15,380
لكن إن كان يوجد شيء يُناسبنا
فعله، فسوف نفعله

282
00:19:15,380 --> 00:19:18,530
ومع ذلك لم تفعلا شيئاً على الإطلاق

283
00:19:18,530 --> 00:19:20,240
اهدأ يا هاسيبي-كن

284
00:19:20,810 --> 00:19:23,750
!يا للهول! القِدر يطفح

285
00:19:23,750 --> 00:19:24,390
!ماذا؟

286
00:19:24,390 --> 00:19:25,690
!أبعده عن النّار

287
00:19:25,690 --> 00:19:27,250
هذا سيّئ

288
00:19:28,670 --> 00:19:32,040
يبدو أنّنا مُقبِلون على طقس عاصف

289
00:19:37,030 --> 00:19:39,250
أعددتُ طبقي الخاصّ

290
00:19:39,250 --> 00:19:40,750
يبدو هذا لذيذاً

291
00:19:40,750 --> 00:19:43,240
سويشينشي يستغرق وقتاً

292
00:19:43,240 --> 00:19:45,000
...إنّه

293
00:19:45,000 --> 00:19:47,490
تحدث أمور كثيرة في ريوكيو

294
00:19:47,850 --> 00:19:53,750
صانع السّيوف سويشينشي ماساهيدي
كان يتدرّب في إيدو، صحيح؟

295
00:19:53,750 --> 00:19:57,390
لعلّه يتنزّه حول هذا المكان القديم المألوف

296
00:19:57,390 --> 00:20:00,040
أوتظنّ ذلك؟

297
00:20:00,040 --> 00:20:02,470
أتفهّم تفكير سويشينشي

298
00:20:02,820 --> 00:20:06,190
،السّفر إلى أماكن جديدة بعيدة لطيف

299
00:20:06,190 --> 00:20:09,090
لكن العودة إلى الدّيار يمكن أن تكون
رائعة أيضاً في بعض الأحيان

300
00:20:09,090 --> 00:20:14,810
إنّ رؤية الأشياء بأمّ عينيه قد يُسلّط
ضوءاً جديداً على الأماكن المألوفة

301
00:20:15,230 --> 00:20:20,780
لكن وُلِد صانع السّيوف سويشينشي
ماساهيدي بعد هذه الفترة

302
00:20:20,780 --> 00:20:24,910
لا دلالة على وجود جيش الانحسار
الزّمنيّ. ينبغي أن يكون بخير، صحيح؟

303
00:20:26,340 --> 00:20:27,210
...على ما أعتقد

304
00:20:29,860 --> 00:20:34,200
رغم ذلك، لا يمكننا السّماح بحدوث
شيء لعضونا في الفريق

305
00:20:34,890 --> 00:20:38,040
هلّا ذهبت وتفقّدت الأمور لأجلنا يا كيومارو؟

306
00:20:39,180 --> 00:20:40,030
حسناً

307
00:21:01,900 --> 00:21:02,500
—سويشين

308
00:21:02,500 --> 00:21:05,150
أجل، أنت ماهر جدّاً

309
00:21:05,710 --> 00:21:07,120
أين تعلّمت؟

310
00:21:07,540 --> 00:21:11,370
في الواقع... أ-أبي صانع سيوف

311
00:21:11,370 --> 00:21:12,700
هكذا إذاً

312
00:21:13,100 --> 00:21:15,820
كنّا صانعي سيوف لأجيال أيضاً

313
00:21:15,820 --> 00:21:20,300
نحن ننتهج التّقاليد هنا بخلاف
الحدّادين الآخرين

314
00:21:20,680 --> 00:21:24,760
لكن لا أحد يحتاج سيوفاً في هذا
،الزّمن المُسالم الهادئ

315
00:21:25,230 --> 00:21:27,720
لذا نصنع سكاكين مطبخيّة الآن

316
00:21:29,470 --> 00:21:30,430
...أنا

317
00:21:31,170 --> 00:21:33,690
أعتقد بأنّ سكّين المطبخ هذا
هو سيف جيّد بحدّ ذاته

318
00:21:34,760 --> 00:21:38,580
الفولاذ جيّد ونقيّ، وصُنِع بشكل مُتقَن

319
00:21:38,580 --> 00:21:41,860
يمكنني الشّعور بروح الحِرفيّ... بروحك

320
00:21:42,900 --> 00:21:46,960
في العصر المُناسب، كنتَ لتصبح
صانع سيوف ذا صيت عظيم

321
00:21:48,450 --> 00:21:51,240
أنت تُحرجني الآن

322
00:21:51,800 --> 00:21:57,700
،جُلّ ما أريده هو صنع شيء يُقدّره المالك

323
00:21:57,700 --> 00:22:00,990
لذا لم أصنع سيفاً رديئاً في حياتي

324
00:22:02,190 --> 00:22:05,420
لا بدّ أنّ هذه السّيوف سعيدة

325
00:22:06,930 --> 00:22:10,510
هذا كلام طريف يُقال عن الأدوات يا فتى

326
00:22:13,560 --> 00:22:15,810
لكن شكراً

327
00:22:19,810 --> 00:22:21,480
أتريد صنع المزيد؟

328
00:22:21,480 --> 00:22:22,230
أكيد

329
00:22:25,770 --> 00:22:28,610
تعلّمتُ الكثير. أشكرك جزيل الشّكر

330
00:22:28,990 --> 00:22:32,360
لا عليك. عُد في أي وقت تريد

331
00:22:32,360 --> 00:22:33,200
حسناً

332
00:22:38,030 --> 00:22:38,920
!تبّاً

333
00:22:39,410 --> 00:22:41,420
كم مضى على وجودي هنا؟

334
00:22:42,440 --> 00:22:44,110
كيف أشرح هذا للجميع؟

335
00:22:44,670 --> 00:22:45,770
سويشينشي

336
00:22:47,500 --> 00:22:48,670
...كيومارو

337
00:22:49,040 --> 00:22:50,510
...ا-المعذرة

338
00:22:51,170 --> 00:22:55,030
أنا آسف! الوقت غير مناسب
!للاستسلام لنزواتي

339
00:23:01,330 --> 00:23:06,220
صُنِعتَ بواسطة حدّاد توسّل
،عودة الحِرفيّة التّقليديّة

340
00:23:06,220 --> 00:23:09,280
،مُؤسّس أسلوب السّيف شينشينتو
سويشينشي ماساهيدي

341
00:23:10,130 --> 00:23:14,750
ومن الطبيعيّ أن تكون مهتمّاً بحِرفيّة هذا
العصر، عندما كان ذلك التّقليد لا يزال حيّاً

342
00:23:14,750 --> 00:23:15,740
هذا طبيعيّ فحسب

343
00:23:16,820 --> 00:23:20,080
لكن فشلتُ كمُحارب سيف

344
00:23:20,600 --> 00:23:23,000
تصرّفتُ بناء على المصلحة الشّخصيّة فقط

345
00:23:25,890 --> 00:23:29,260
بالتّأكيد، التصرّف من تلقاء نفسك
هكذا ليس مقبولاً

346
00:23:29,660 --> 00:23:31,810
حريّ بك أن تعتذر للجميع

347
00:23:31,810 --> 00:23:33,550
أجل، أعلم

348
00:23:33,930 --> 00:23:38,770
،أنا مُذنب بنفس الدّرجة لعدم التدخُّل
لذا سأعتذر معك

349
00:23:39,730 --> 00:23:40,900
...كيومارو

350
00:23:41,690 --> 00:23:43,980
أنا أعزّ صديق لك، أتتذكّر؟

351
00:23:46,220 --> 00:23:47,350
شكراً

352
00:23:48,590 --> 00:23:49,960
والآن، هيّا بنا نعود

353
00:23:49,960 --> 00:23:50,740
أجل

354
00:23:53,770 --> 00:23:54,780
!الملح

355
00:23:55,900 --> 00:23:57,550
!ا-انتظر لحظة

356
00:23:57,550 --> 00:23:59,580
!نريد بعض الملح

357
00:23:59,970 --> 00:24:02,330
!هل اكتشفتم ماهيّة الفولاذ الخام؟

358
00:24:02,700 --> 00:24:06,970
أجل، رغم أنّ جزءاً منه هو مجرّد
فرضيّة بواسطة إيشيكيريمارو-سان وأنا

359
00:24:06,970 --> 00:24:08,250
أخبرنا بسرعة

360
00:24:09,030 --> 00:24:12,260
هل تعرف ماذا يعني "إله الكلب"؟

361
00:24:12,570 --> 00:24:14,720
سمعتُ عنه على الأقلّ

362
00:24:15,180 --> 00:24:17,930
إنّه سحر حُظِرَ في فترة هيان

363
00:24:18,300 --> 00:24:23,900
يتضمّن نصب كمين لكلب وقطع رأسه
،عندما تبلغ كراهيّته ذروتها

364
00:24:24,220 --> 00:24:29,220
دفن الرّأس في الأرض، وجعل
النّاس يدوسون عليه

365
00:24:29,220 --> 00:24:33,100
لاستدعاء كراهيّة أكبر حتّى
وخلق شيء ملعون

366
00:24:36,380 --> 00:24:39,040
لكن ما علاقة هذا بذاك؟

367
00:24:39,530 --> 00:24:43,410
هذا "الفولاذ الخام" يبدو أداة ملعونة
صُنِعت بنفس الطّريقة

368
00:24:43,720 --> 00:24:45,070
...أداة ملعونة

369
00:24:45,070 --> 00:24:47,290
سألتُ أوي-سان قبل قليل

370
00:24:48,920 --> 00:24:50,600
كان يوجد مزار؟

371
00:24:50,600 --> 00:24:51,420
أجل

372
00:24:51,740 --> 00:24:55,840
كان ذلك الفولاذ الخام مدفوناً
في مُنتصف طريق

373
00:24:57,670 --> 00:25:01,080
وكان يوجد مزار صغير في نهاية ذلك الطّريق

374
00:25:01,570 --> 00:25:05,000
لكن كانت الظّلال مُظلِمة جدّاً
لدرجة تصعب الرّؤية

375
00:25:06,460 --> 00:25:12,570
كثير مِمّن يزورون المزارات الشّنتويّة للصّلاة
،للآلهة تدفعهم عواطف جيّاشة

376
00:25:13,080 --> 00:25:15,280
سواء كانت إيجابيّة أو سلبيّة

377
00:25:15,720 --> 00:25:21,260
لعلّ تلك العواطف أشبعَتْ هذا الفولاذ
الخام بلعنة من نوع ما

378
00:25:21,970 --> 00:25:24,660
كيف أدّى هذا بسيّدي والآخرين بالانهيار؟

379
00:25:25,900 --> 00:25:27,960
أداة الانتقال الآنيّ الزّمكانيّة

380
00:25:28,540 --> 00:25:35,840
سيّدي يُغذّي تلك الأداة وذلك كي يستطيع الأشخاص
الّذين خرجوا لأداء مهام العودة في أيّ وقت

381
00:25:36,290 --> 00:25:42,000
،قوّتهم والقوّة الملعونة للفولاذ معاً
،خرجت عن السّيطرة

382
00:25:42,470 --> 00:25:46,850
وخلّفتْ أثراً ما على سيّدي. هذه
هي القصّة المُرجَّحة

383
00:25:47,100 --> 00:25:52,910
والأشخاص الّذين ينتقلون آنيّاً عائدين
آنذاك تأثّروا أيضاً

384
00:25:52,910 --> 00:25:53,940
هكذا إذاً

385
00:25:54,280 --> 00:25:58,030
نعرف السّبب الآن، لكن ليس الحلّ

386
00:25:59,180 --> 00:26:03,240
إذاً إن لم تعُد قوّة سيّدي، فالأشخاص
...الّذين خرجوا في مهمّة الآن

387
00:26:03,580 --> 00:26:06,460
أجل. غالباً لا يستطيعون العودة

388
00:26:07,210 --> 00:26:08,610
مستحيل

389
00:26:08,610 --> 00:26:11,040
ما نوع التّأثيرات الّتي تُخلّفها اللّعنات؟

390
00:26:11,490 --> 00:26:15,640
يعتمد الأمر على الحجم والأهداف
،والمشاعر المعنيّة

391
00:26:15,640 --> 00:26:17,510
لذا من الصّعب تعميم الأمر

392
00:26:17,970 --> 00:26:23,760
هناك لعنات تقتل النّاس وتُسبّب
...حوادث وتبليهم بأمراض

393
00:26:23,760 --> 00:26:27,040
وحتّى أنّ بعضها يُسبّب الكوابيس

394
00:26:27,690 --> 00:26:33,130
لا تبدو حياة سيّدي مُعرّضة لخطر
...من هذه اللّعنة، لكن

395
00:26:33,750 --> 00:26:37,190
لديّ شيء لأخبرك به. اتبعني رجاء

396
00:26:38,700 --> 00:26:41,250
قد تحتوي هذه الوثائق على معلومات نحتاجها

397
00:26:41,250 --> 00:26:44,410
ربّما. دعني أرى كذلك

398
00:26:45,190 --> 00:26:47,120
إلى أين نحن ذاهبان؟

399
00:26:48,900 --> 00:26:49,870
إلى هنا

400
00:26:53,830 --> 00:26:55,370
ما هذا؟

401
00:26:56,110 --> 00:26:59,970
...شيء لم أخبر أحداً عنه. غرفتي

402
00:27:00,330 --> 00:27:01,920
!السرّية الخاصّة

403
00:27:03,130 --> 00:27:04,910
حـ-حقّاً؟

404
00:27:04,910 --> 00:27:07,390
أطلب منك أن تحتفظ بهذا لنفسك

405
00:27:07,390 --> 00:27:09,650
صحيح، لم أخبر أحداً

406
00:27:09,650 --> 00:27:10,270
ماذا؟

407
00:27:11,340 --> 00:27:13,160
!أقصد لن أخبر أحداً

408
00:27:28,190 --> 00:27:29,210
تفضّل

409
00:27:32,170 --> 00:27:34,920
أعتقد كان... وجدتُه

410
00:27:35,980 --> 00:27:37,060
حلم؟

411
00:27:37,060 --> 00:27:41,760
أجل. بحسب ما قاله نانكايتارو تشوسون
،وإيشيكيريمارو

412
00:27:41,760 --> 00:27:46,490
تؤثّر اللّعنة غالباً على حلم سانيوا

413
00:27:46,490 --> 00:27:49,140
أحلام؟ تلك الّتي نراها عند النّوم؟

414
00:27:49,140 --> 00:27:52,350
إنّ "حلم" في هذا السّياق، تشير
إلى العالم العقليّ

415
00:27:52,810 --> 00:27:55,970
تقصد ما بداخل عقل سيّدي؟

416
00:27:55,970 --> 00:27:57,570
شيء من هذا القبيل

417
00:27:58,070 --> 00:28:01,030
اللّعنات هي تجلّي للأفكار الشرّيرة

418
00:28:01,990 --> 00:28:07,750
لا بدّ أنّهم نشروا أحلام سانيوا
وأدخلوها إلى منطقة اللّاوعي

419
00:28:08,450 --> 00:28:14,600
غالباً يمرّون بحلقة لا نهائيّة
من الكوابيس المُروّعة

420
00:28:16,340 --> 00:28:18,880
هناك أمور كثيرة لا نعرفها عن الأحلام بعد

421
00:28:19,860 --> 00:28:21,840
،إذا استمرّ هذا

422
00:28:21,840 --> 00:28:27,460
،فقد يؤذي السّانيوا، سيف المُحاربين
وهذا الحصن بحدّ ذاته

423
00:28:28,680 --> 00:28:30,060
!مستحيل

424
00:28:30,490 --> 00:28:34,370
،لكن إذا تمكنّا من إيقاظ السّانيوا قريباً

425
00:28:34,370 --> 00:28:37,110
قد نتمكّن من الخروج من هذا

426
00:28:37,110 --> 00:28:38,250
ماذا يجدر بنا أن نفعل؟

427
00:28:38,730 --> 00:28:41,870
المعذرة... هنا

428
00:28:42,820 --> 00:28:46,950
ادخل حلم السّانيوا من الخارج
وادخل إلى نُواة عقلهم

429
00:28:49,320 --> 00:28:56,290
حرّر عقله من القلق واليأس
المجبول بواسطة الكابوس

430
00:28:56,770 --> 00:29:02,300
لكن دخول حلم شخص آخر يعني
إدخال عناصر غريبة

431
00:29:03,100 --> 00:29:07,800
إذا مُتّ في الحلم، فسوف تختفي فوراً

432
00:29:08,520 --> 00:29:11,810
بالإضافة إلى ذلك، سوف تُرفَض
،كشخص غريب في الحلم

433
00:29:12,410 --> 00:29:15,220
ولا أحد يعلم فيما إذا كنت ستتمكّن
من فعل أيّ شيء

434
00:29:15,860 --> 00:29:16,900
...لكن

435
00:29:17,380 --> 00:29:22,020
،إذا كانوا مُحاربي سيف هذا الحصن
،الّذين وُلِدوا من قوّة سانيوا

436
00:29:22,020 --> 00:29:24,950
فينبغي أن يخفّ الرّفض بطريقة ما

437
00:29:27,150 --> 00:29:32,370
كاشو كيوميتسو، أطلب منك هذا لأنّك
كنت السّيف الأوّل هنا

438
00:29:32,840 --> 00:29:36,490
هلّا تولّيت هذه المهمّة لأجلنا؟

439
00:29:37,150 --> 00:29:38,780
بالطّبع

440
00:29:39,610 --> 00:29:42,960
سأفعل أيّ شيء لإنقاذ سيّدي

441
00:29:42,960 --> 00:29:46,670
أيّ مُحارب سيف في هذا الحصن
كان ليقول نفس الكلام

442
00:29:47,910 --> 00:29:49,470
!شكراً لك

443
00:29:51,070 --> 00:29:55,270
وفقاً للدّليل، يستطيع دخول
الحلم سيفان كحدّ أقصى

444
00:29:55,880 --> 00:30:00,730
أي شيء يمكن أن يحدث، لذا
يجدر بك أن تأخذ شخصاً معك

445
00:30:01,250 --> 00:30:04,870
هناك سيف واحد فقط يخطر
على الذّهن في أوقات كهذه

446
00:30:09,190 --> 00:30:11,780
هل نذهب يا كيوميتسو؟

447
00:30:12,130 --> 00:30:14,510
ركّز يا ياسوسادا

448
00:30:15,670 --> 00:30:18,450
أوّلاً، أمسكا بكرة اليد هذه

449
00:30:18,450 --> 00:30:20,000
حـ-حسناً

450
00:30:20,000 --> 00:30:22,730
كلاكما، مُدّا يديكما للأمام

451
00:30:23,210 --> 00:30:24,320
هكذا؟

452
00:30:24,320 --> 00:30:26,340
!دوران، دوران، دوران، دوران

453
00:30:26,340 --> 00:30:27,260
ما-ما هذا؟

454
00:30:27,750 --> 00:30:31,720
تمائم بتعويذة لإدخالك إلى حلم السّانيوا

455
00:30:32,110 --> 00:30:36,180
إنّها تعمل مع كُرة اليد البلُّوريّة لتوجيهك إلى الدّاخل

456
00:30:36,660 --> 00:30:41,880
تلك الّتي على معصمك الأيسر هي الّتي
ستدخل. سوف تتفكّك حالما تدخل

457
00:30:42,390 --> 00:30:45,760
وتلك الّتي على مِعصمك الأيمن
هي الّتي ستعود

458
00:30:45,760 --> 00:30:50,450
إن تعرّضت لخطر، فتمنّ بشدّة العودة
إلى هذا العالم

459
00:30:50,850 --> 00:30:55,680
التّمائم لديها أيضاً قوّة دعم جهودك داخل الحلم

460
00:30:57,380 --> 00:31:00,960
كاشو كيوميتسو، ياماتونوكامي ياسوسادا

461
00:31:00,960 --> 00:31:03,090
أرجوكما أنقذا السّانيوا

462
00:31:03,430 --> 00:31:05,100
اعتمد علينا

463
00:31:05,100 --> 00:31:06,590
سوف نُنقذه بكلّ تأكيد

464
00:31:06,930 --> 00:31:08,480
كونا حذرين

465
00:31:08,480 --> 00:31:10,180
لا تُقدِما على أيّ تصرُّف طائش

466
00:31:10,180 --> 00:31:13,720
إن أصابكما مكروه، فذلك أكثر ما سيُحزِن سيّدي

467
00:31:13,720 --> 00:31:14,530
أجل

468
00:31:14,530 --> 00:31:15,930
نعي ذلك

469
00:31:16,540 --> 00:31:19,760
!حسناً، جاري إرسالكما إلى داخل عالم الحلم

470
00:31:20,440 --> 00:31:24,990
!ها نحن أولاء! ركّزا على أفكاركما عن السّانيوا

471
00:31:25,820 --> 00:31:26,830
!سيّدي

472
00:31:36,010 --> 00:31:37,700
!سيدخلان الحلم

473
00:31:41,810 --> 00:31:42,710
مهلاً

474
00:31:43,720 --> 00:31:45,750
نعتمد عليك يا كاشو

475
00:31:46,500 --> 00:31:48,460
ندع الأمر كلّه على عاتقك يا ياسوسادا

476
00:31:48,460 --> 00:31:49,640
أنقذ سيّدي

477
00:32:10,170 --> 00:32:12,380
...هذا عقل سيّدي

478
00:32:13,500 --> 00:32:14,160
!الضّوء

479
00:32:14,770 --> 00:32:16,100
إنّه يتلاشى

480
00:32:17,370 --> 00:32:19,340
نحن في طريقنا

481
00:32:19,340 --> 00:32:21,070
انتظرنا يا سيّدي

482
00:32:35,530 --> 00:32:38,140
أ-أين أنا؟

483
00:32:38,770 --> 00:32:40,220
الحصن؟

484
00:32:41,030 --> 00:32:42,020
حقّاً؟

485
00:32:44,920 --> 00:32:46,590
غالباً

486
00:32:46,590 --> 00:32:47,480
كيوميتسو

487
00:32:47,940 --> 00:32:50,970
لكن لا أريد تخيّله بهذه الحالة حتّى

488
00:32:53,480 --> 00:32:54,470
...التّميمة

489
00:32:58,750 --> 00:33:01,660
أعتقد هذا يعني بأنّنا تمكّنّا
من دخول حلم سيّدي

490
00:33:02,360 --> 00:33:03,540
أجل

491
00:33:03,810 --> 00:33:06,980
لنُسرع ونبحث عن نُواة عقله أو أيّاً كانت

492
00:33:06,980 --> 00:33:07,710
حسناً

493
00:33:10,170 --> 00:33:12,280
...هذا كابوس سيّدي

494
00:33:13,240 --> 00:33:14,170
كم هذا مأساويّ

495
00:33:14,900 --> 00:33:15,800
أجل

496
00:33:19,150 --> 00:33:21,050
ما الأمر يا ياسوسادا؟

497
00:33:21,650 --> 00:33:25,840
لا أدري، لكن رأسي يؤلمني

498
00:33:27,160 --> 00:33:29,360
كان الأمر نفسه عندما وصلتُ إلى هنا أيضاً

499
00:33:30,210 --> 00:33:34,340
أهذا هو الرّفض الّذي ذكرَه كونّوسكي؟

500
00:33:34,660 --> 00:33:40,140
غالباً. قال بأنّه يشتدّ قوّة
كلّما بقينا هنا فترة أطول

501
00:33:40,630 --> 00:33:42,020
هكذا إذاً

502
00:33:45,320 --> 00:33:46,250
ما الأمر؟

503
00:33:47,630 --> 00:33:48,590
لا شيء

504
00:33:49,640 --> 00:33:51,760
آسف. أنا بخير الآن

505
00:33:52,700 --> 00:33:53,540
هيّا بنا

506
00:34:03,340 --> 00:34:04,430
!سيّدي

507
00:34:07,560 --> 00:34:08,650
ظلام؟

508
00:34:09,100 --> 00:34:10,920
لا يوجد شيء هنا

509
00:34:11,300 --> 00:34:13,350
ياسوسادا، انظر

510
00:34:19,030 --> 00:34:20,030
الجميع؟

511
00:34:20,510 --> 00:34:21,620
لماذا؟

512
00:34:24,270 --> 00:34:25,620
!إنّه يميل

513
00:34:25,620 --> 00:34:27,770
!ما الّذي يجري؟

514
00:34:33,650 --> 00:34:35,960
!ما هذا الإحساس بالعوم؟

515
00:34:36,660 --> 00:34:38,640
وكأنّنا في الماء

516
00:34:38,990 --> 00:34:40,660
في تلك الغرفة؟

517
00:34:40,660 --> 00:34:41,450
أجل

518
00:34:52,390 --> 00:34:53,660
ما الّذي يجري هنا؟

519
00:34:55,320 --> 00:34:57,660
أتعرف ما الّذي فعله غوتو؟

520
00:34:57,660 --> 00:34:59,410
!لا تخبره

521
00:34:59,410 --> 00:35:00,280
يا إلهي

522
00:35:00,280 --> 00:35:01,910
!هنا

523
00:35:11,080 --> 00:35:12,840
ر-رفاق؟

524
00:35:12,840 --> 00:35:14,550
!لا... مستحيل

525
00:35:17,720 --> 00:35:18,910
ما هذا؟

526
00:35:19,290 --> 00:35:19,760
ماذا؟

527
00:35:20,170 --> 00:35:21,600
ثمّة شيء قادم إلى هنا

528
00:35:24,090 --> 00:35:24,860
!العدوّ؟

529
00:35:24,860 --> 00:35:26,060
!كيوميتسو

530
00:35:26,360 --> 00:35:27,070
!قادم

531
00:35:32,850 --> 00:35:34,150
ما هذه الأشياء؟

532
00:35:34,530 --> 00:35:36,150
لم أرَهم من قبل

533
00:35:39,650 --> 00:35:42,070
...نحن في الخارج؟ لكن انظر

534
00:35:42,070 --> 00:35:43,110
إنّه عائم؟

535
00:35:46,540 --> 00:35:47,560
ما هذا؟

536
00:35:47,560 --> 00:35:48,790
ما الّذي يجري؟

537
00:35:49,800 --> 00:35:50,960
!الحصن

538
00:35:57,460 --> 00:35:59,330
تبّاً لأولئك الأشخاص

539
00:35:59,330 --> 00:36:01,110
إنّهم يفعلون ما يحلو لهم

540
00:36:11,870 --> 00:36:13,030
رِفاق؟

541
00:36:15,220 --> 00:36:16,940
!توقّفوا

542
00:36:23,590 --> 00:36:26,080
لا يهمّني من تكونون. سوف أقتلكم

543
00:36:27,570 --> 00:36:32,500
أجل. أيّ شخص يؤذي سيّدي
!وحلمه يجب أن يدفع الثّمن

544
00:36:34,680 --> 00:36:36,890
!سأقتلكم

545
00:36:55,230 --> 00:36:57,940
أصبح التحرُّك أسهل بكثير حالما
بدأت التّميمة بالتوهُّج

546
00:36:57,940 --> 00:36:59,850
هذه هي القوّة المُعينة إذاً؟

547
00:37:05,220 --> 00:37:06,490
...الفناء

548
00:37:14,410 --> 00:37:18,130
مَن يزور في مثل هذا الوقت المُتأخّر
من اللّيل؟ يا للوقاحة

549
00:37:18,600 --> 00:37:21,430
لا وقت للمُزاح

550
00:37:21,980 --> 00:37:25,880
الكثير في فرقتنا غير مُلائمين
للمعارك اللّيليّة

551
00:37:26,630 --> 00:37:28,880
هذا تقلُّب سيّئ للأحداث

552
00:37:28,880 --> 00:37:30,490
قد تكون على حقّ

553
00:37:35,970 --> 00:37:37,190
سيكون هذا مُؤلماً

554
00:37:37,190 --> 00:37:38,160
!خذ

555
00:37:41,270 --> 00:37:45,790
فلتمُت، لسبب وحيد وهو أنّك
!عصيت سيّدنا

556
00:37:45,790 --> 00:37:49,950
،إذا ظللتُ أسمح لك بسرقة العرض
!فسوف أخجل من نفسي

557
00:37:56,060 --> 00:37:58,310
أوكانيهيرا، ولا حركة

558
00:38:00,330 --> 00:38:02,240
قدِّر حياتك

559
00:38:04,610 --> 00:38:07,010
شكراً على مدّ يد العون لي

560
00:38:08,550 --> 00:38:10,970
!سأحصد القتلَ في المرّة المُقبلة

561
00:38:14,810 --> 00:38:16,070
!ابتعد عن طريقي

562
00:38:20,940 --> 00:38:23,000
أشكرك على اهتمامك

563
00:38:23,000 --> 00:38:25,470
فعلتُ ذلك من أجل القتل فقط

564
00:38:30,910 --> 00:38:32,300
شكراً

565
00:38:32,300 --> 00:38:35,920
لم أكن أفعل شيئاً يُذكَر، أنسيت؟

566
00:38:35,920 --> 00:38:39,210
لذا ارتأيتُ أنّ الوقت حان لبذل بعض الجهد

567
00:38:39,210 --> 00:38:40,370
هل أنتما بخير؟

568
00:38:40,370 --> 00:38:41,610
بالطّبع

569
00:38:41,610 --> 00:38:43,420
لكن عددهم لا ينتهي

570
00:38:44,010 --> 00:38:47,340
،أشعر نفسي وكأنّني الأميرة كاغويا
تستقبل جيشاً من الخاطبين

571
00:38:48,180 --> 00:38:52,270
لكن لا ننوي إطلاقاً تعديل التّاريخ

572
00:38:52,270 --> 00:38:55,470
حسناً، لا يبدو أنّهم مُستعدّون للإصغاء

573
00:38:57,730 --> 00:38:59,020
!اصمدوا

574
00:38:59,020 --> 00:39:03,540
!لن أقبل بانكسار أي أحد منكم
!يجب أن نعود جميعنا سالمين

575
00:39:03,540 --> 00:39:04,630
!أجل

576
00:39:05,960 --> 00:39:06,780
!اللّعنة

577
00:39:07,120 --> 00:39:10,770
أكره الوقوف مكتوف اليدين والانتظار فحسب

578
00:39:10,770 --> 00:39:12,240
اهدأ

579
00:39:12,240 --> 00:39:13,780
ستؤذي يدك

580
00:39:14,230 --> 00:39:18,620
لم أندم على ضعفي أكثر ممّا أنا الآن

581
00:39:18,620 --> 00:39:22,040
هذا لأنّها حالة خاصّة

582
00:39:22,320 --> 00:39:26,880
لكن أتفهّم الإحباط، لأنّ نفس
الشّعور يُراودني

583
00:39:27,240 --> 00:39:31,470
قلقتُ على سيّدي والجميع الّذين
خرجوا لأداء المهام

584
00:39:31,470 --> 00:39:36,450
بئساً! أما من شيء يمكننا فعله؟

585
00:39:36,450 --> 00:39:39,350
ليتنا نستطيع فعل شيء
بقدر ما تفعل أنت

586
00:39:40,410 --> 00:39:41,690
...لنُصلِّ

587
00:39:42,050 --> 00:39:46,400
مُتمنّيين سلامة سيّدي والجميع في هذا الحصن

588
00:39:46,820 --> 00:39:47,840
...تمنّي

589
00:39:48,370 --> 00:39:54,620
يذكّرني هذا بالأيّام الّتي وضعنا فيها تمائم
بأُمنيات على شجرة الكرز

590
00:39:54,620 --> 00:39:55,490
أجل

591
00:39:55,490 --> 00:39:58,690
تقصد الشّجرة أعلى التلّة؟

592
00:39:58,690 --> 00:40:00,080
لماذا؟

593
00:40:00,080 --> 00:40:04,510
جاءت فترة لم تعُد فيها تلك الشّجرة تزهر

594
00:40:05,340 --> 00:40:11,220
لذا وضعنا تمائم مُتمنّيين
أن تزهر شجرة الكرز

595
00:40:11,650 --> 00:40:18,720
فهمت. هذا يُفسّر تسمية النّاس
"لها بـ"ساكورا الأُمنيات

596
00:40:19,080 --> 00:40:21,690
ساكورا... الأُمنيات؟

597
00:40:22,350 --> 00:40:26,230
وجدتُها! ما رأيكم أن نكتب أُمنياتنا على شمعات؟

598
00:40:26,980 --> 00:40:28,330
شمعات؟

599
00:40:28,330 --> 00:40:30,990
قرأتُ عن ذلك في كتاب من قبل

600
00:40:31,570 --> 00:40:35,870
كان يُقام مهرجان حيث يُشعل النّاس
شمعاً دُوّنت عليه أُمنيات

601
00:40:36,850 --> 00:40:38,980
!يبدو هذا رائعاً

602
00:40:38,980 --> 00:40:42,460
نحن ننتظر بقلق دون فعل
شيء على أيّ حال

603
00:40:45,060 --> 00:40:50,010
كلّ أُمنية من أُمنياتنا سوف تتشكّل
!لتحقيق أُمنية عظيمة واحدة

604
00:40:50,610 --> 00:40:55,410
مشاعرنا الدّافئة ستحقّق أشياء طيّبة بالتّأكيد

605
00:40:55,410 --> 00:40:56,600
أجل

606
00:40:57,020 --> 00:40:58,560
لنُجهّز الأمور

607
00:40:58,560 --> 00:41:01,360
!أجل

608
00:41:03,290 --> 00:41:04,860
!الباحة

609
00:41:04,860 --> 00:41:06,410
هناك هالة مشؤومة

610
00:41:06,730 --> 00:41:08,330
احذر يا كيوميتسو

611
00:41:11,150 --> 00:41:12,380
ها نحن أولاء

612
00:41:12,380 --> 00:41:13,750
!سأُقطّعك

613
00:41:18,120 --> 00:41:18,910
!كيوميتسو

614
00:41:21,900 --> 00:41:22,870
!ثمّة شيء هنا

615
00:41:23,660 --> 00:41:25,420
!لحظة، مهلاً

616
00:41:39,580 --> 00:41:40,760
أمزح فحسب

617
00:41:50,760 --> 00:41:54,990
أعداء سيّدي جميعهم أعدائي أيضاً

618
00:41:58,380 --> 00:41:59,200
حسناً

619
00:42:07,710 --> 00:42:10,200
!هاجموني بأقصى ما عندكم

620
00:42:10,200 --> 00:42:11,710
،سأقتل، سأقتل

621
00:42:11,710 --> 00:42:16,240
سأقتل، سأقتلكم جميعاً

622
00:42:18,360 --> 00:42:21,480
بئساً. أنت ضمن النّطاق

623
00:42:22,570 --> 00:42:24,020
ماذا بعد؟

624
00:42:24,340 --> 00:42:25,300
...حاليّاً

625
00:42:27,140 --> 00:42:30,750
سوف نقضي على هؤلاء ثمّ
نتفرّق ونبحث عن سيّدي

626
00:42:30,750 --> 00:42:31,800
فكرة سديدة

627
00:42:31,800 --> 00:42:33,710
حسناً، هيّا بنا

628
00:42:33,710 --> 00:42:34,730
!أجل

629
00:42:35,210 --> 00:42:37,040
!فلتتقطّع

630
00:42:37,980 --> 00:42:39,390
!هجوم

631
00:42:41,010 --> 00:42:42,730
تولَّ ذلك الجانب

632
00:42:42,730 --> 00:42:43,470
حسناً

633
00:42:46,420 --> 00:42:47,290
!سيّدي

634
00:42:47,930 --> 00:42:49,290
أين أنت؟

635
00:42:54,160 --> 00:42:54,970
—ما

636
00:42:54,970 --> 00:42:56,200
!سيّدي

637
00:42:58,290 --> 00:43:00,670
...اللّعنة! نحن نستغرق الكثير من الوقت

638
00:43:09,480 --> 00:43:10,730
هل ذلك الانفجار هو ما فعل هذا؟

639
00:43:12,860 --> 00:43:13,480
!ياسوسادا

640
00:43:14,130 --> 00:43:15,060
هل أنت بخير؟

641
00:43:15,720 --> 00:43:16,950
بعض الشّيء

642
00:43:29,580 --> 00:43:31,610
ما هذا؟

643
00:43:31,610 --> 00:43:33,790
...لا أدري، لكن

644
00:43:34,430 --> 00:43:37,450
إنّه أقوى بأضعاف من الّذين قضينا عليهم

645
00:43:47,350 --> 00:43:49,300
إنّه يعيث فساداً

646
00:43:50,050 --> 00:43:54,770
!سيدفع ثمن تدمير حصننا

647
00:43:55,230 --> 00:43:56,900
هيّا بنا يا كيوميتسو

648
00:43:57,250 --> 00:43:59,650
لا تعيقني يا ياسوسادا

649
00:44:00,190 --> 00:44:03,690
!حسناً، حان الوقت لبعض الحُبّ

650
00:44:03,690 --> 00:44:05,030
!وقت القتل

651
00:44:14,360 --> 00:44:17,340
سأُواجهك

652
00:44:21,150 --> 00:44:22,800
!لم أنتهِ

653
00:44:27,100 --> 00:44:28,890
!فلتمُت

654
00:44:29,830 --> 00:44:31,480
من جديد؟

655
00:44:35,160 --> 00:44:38,460
أنا مُرهَق تماماً هنا

656
00:44:39,430 --> 00:44:40,880
كذلك أنا

657
00:44:40,880 --> 00:44:42,440
سوف نقضي عليه حالاً

658
00:44:42,440 --> 00:44:43,240
حسناً

659
00:44:49,620 --> 00:44:52,620
!والآن إمّا أن أقتل أو أموت من الآن فصاعداً

660
00:44:52,620 --> 00:44:53,940
!سأقتلك

661
00:44:58,590 --> 00:45:03,380
!هيّا، هيّا، هيّا

662
00:45:18,050 --> 00:45:20,290
!نصر لأجل سيّدي

663
00:45:20,290 --> 00:45:24,720
!نتّخذ موقفاً جدّياً الآن

664
00:45:41,100 --> 00:45:42,410
...ربحنا

665
00:45:42,930 --> 00:45:45,480
حسناً، ماذا بعد؟

666
00:45:47,180 --> 00:45:48,820
...في الواقع

667
00:45:53,380 --> 00:45:54,180
رِفاق

668
00:45:54,570 --> 00:45:56,260
جاهزون؟

669
00:45:56,260 --> 00:45:57,940
أجل

670
00:45:58,320 --> 00:46:01,690
والآن صلّوا، بنار لن تخسر أمام مطر

671
00:46:02,510 --> 00:46:05,140
عسى أن يستيقظ سيّدي

672
00:46:05,140 --> 00:46:09,840
عسى أن يعود كلُّ شخص خرج لأداء
!مهمّة سالماً غانماً

673
00:46:09,840 --> 00:46:13,690
عسى أن يكون كاشو وياماتانوكامي بخير

674
00:46:14,440 --> 00:46:17,860
عسى أن يعود السّلام إلى حصننا

675
00:46:21,970 --> 00:46:24,520
يصبح الجوّ بارداً حقّاً في اللّيل

676
00:46:34,100 --> 00:46:35,530
يا رِفاق

677
00:46:37,220 --> 00:46:39,660
ماذا تريدون أن تفعلوا حالما
تعودون إلى الحصن؟

678
00:46:41,960 --> 00:46:44,320
...في الواقع

679
00:46:45,010 --> 00:46:48,590
أريد أن آخذ دروسَ رقص

680
00:46:48,590 --> 00:46:52,530
بعد ذلك الأداء، شعرتُ برغبة
في التحسُّن والتطوُّر

681
00:46:52,860 --> 00:46:55,450
حقّاً؟ وأنت يا بوزين؟

682
00:46:55,450 --> 00:46:56,040
ماذا؟

683
00:46:56,290 --> 00:47:00,240
أ... أريد المُنافسة مع أوكانيهيرا

684
00:47:00,240 --> 00:47:04,040
سأثبت له بأنّني لن أخسر أمام
أحد عندما يتعلّق الأمر بالسّرعة

685
00:47:04,040 --> 00:47:05,130
جميل

686
00:47:05,530 --> 00:47:06,540
كووانا؟

687
00:47:07,330 --> 00:47:10,220
،البطاطا الحُلوة ناضجة الآن

688
00:47:10,220 --> 00:47:13,100
لذا أُريد شَي بعضها مع تونبوكيري-ساما

689
00:47:14,590 --> 00:47:17,850
أريد من سيّدي أن يأكل خوخي المُجفّف المخلّل

690
00:47:17,850 --> 00:47:19,540
فكرة سديدة

691
00:47:19,540 --> 00:47:22,810
أرغب في الذّهاب والتدرّب
مع يامابوشي والمجموعة

692
00:47:23,690 --> 00:47:24,730
لم تبدُ من هذا النّوع

693
00:47:25,880 --> 00:47:28,840
سمعتُ بأنّ التّدريب هو ما يجعل دمك يغلي

694
00:47:28,840 --> 00:47:31,660
أنا متأكّد بأنّ دمك سيغلي، أجل

695
00:47:32,100 --> 00:47:34,560
ماذا عنك يا تسورومارو-سان؟

696
00:47:34,560 --> 00:47:35,370
ماذا؟

697
00:47:35,710 --> 00:47:40,250
في الواقع، أخطّط لشيء مع الفتى سادا

698
00:47:43,340 --> 00:47:44,500
سرّ

699
00:47:44,840 --> 00:47:46,640
!ماذا؟

700
00:47:48,750 --> 00:47:51,800
!لن تكون مُفاجأة إذا أخبرتُكم

701
00:47:51,800 --> 00:47:53,580
!لا يجوز أن تفعل ذلك

702
00:47:53,580 --> 00:47:54,800
!التّشويق

703
00:47:55,180 --> 00:47:58,620
وجدتُها. ما رأيكم أن نخطّط لشيء أيضاً؟

704
00:47:58,620 --> 00:48:00,080
فكرة جيّدة

705
00:48:00,080 --> 00:48:01,020
يبدو هذا مُمتعاً

706
00:48:01,410 --> 00:48:03,230
ماذا يجدر بنا أن نفعل؟

707
00:48:04,040 --> 00:48:05,600
تروقني تعابير وجوهكم الآن

708
00:48:06,740 --> 00:48:09,950
يُقال بأنّ في التّفاؤل خير

709
00:48:09,950 --> 00:48:14,270
عندما تستطيع الحِفاظ على ابتسامتك في الأوقات
العصيبة، فسيبتسم لك الحظّ

710
00:48:15,210 --> 00:48:16,430
معك حقّ

711
00:48:16,430 --> 00:48:18,620
أجل، يجب علينا أن نبقى مُتفائلين

712
00:48:19,140 --> 00:48:21,580
لنتمنّ من تلك النّجوم إذاً

713
00:48:22,380 --> 00:48:25,390
عسى أن يكون صباحنا غداً سعيداً

714
00:48:34,610 --> 00:48:35,560
!ياسوسادا

715
00:48:42,920 --> 00:48:45,310
قُضي على هذا المكان أيضاً

716
00:48:50,180 --> 00:48:52,320
...عسى أن يكون الجميع... بخير

717
00:48:53,690 --> 00:48:55,660
سمعتُ صوتاً للتو

718
00:48:56,440 --> 00:48:58,780
...كاشو وياماتونوكامي

719
00:48:57,260 --> 00:49:00,170
...أؤمن بكم جميعاً...

720
00:49:01,000 --> 00:49:02,040
...هذا

721
00:49:02,780 --> 00:49:04,480
عسى أن يستيقظ سيّدي

722
00:49:03,400 --> 00:49:06,000
!عسى أن يعود الجميع بأمان

723
00:49:04,480 --> 00:49:05,730
...كاشو

724
00:49:05,730 --> 00:49:06,800
...ياماتونوكامي

725
00:49:06,000 --> 00:49:07,040
...سيّدي

726
00:49:08,340 --> 00:49:09,880
هيّا بنا يا كيوميتسو

727
00:49:09,880 --> 00:49:11,210
!ستكونان بخير

728
00:49:11,210 --> 00:49:12,560
استيقظا

729
00:49:12,560 --> 00:49:13,940
!نحن ننتظركما

730
00:49:13,940 --> 00:49:15,770
...كاشو-سان... ياماتونوكامي-سان

731
00:49:32,110 --> 00:49:33,420
لا يمكنك النّوم؟

732
00:49:35,230 --> 00:49:38,640
القلق يؤرقني

733
00:49:38,640 --> 00:49:42,280
أجل... ما كنتُ لأستطيع النّوم أيضاً

734
00:49:42,280 --> 00:49:43,990
هذا ما في الأمر

735
00:49:54,860 --> 00:50:02,000
قد نفترق

736
00:50:02,000 --> 00:50:06,580
لكن سنبقى عائلة للأبد

737
00:50:06,580 --> 00:50:11,470
عسى أن يمدّك الطّريق من وإلى الدّيار

738
00:50:11,470 --> 00:50:17,060
بالطّاقة والقوّة

739
00:50:17,060 --> 00:50:21,900
نحن أخوة منذ اليوم الّذي التقينا فيه

740
00:50:21,900 --> 00:50:27,100
لذا نُغنّي لأجل السّعادة الآن

741
00:50:27,100 --> 00:50:31,370
لا تبكِ، من فضلك لا تبكِ

742
00:50:31,370 --> 00:50:35,760
استمرّ دوماً بالابتسام

743
00:50:36,410 --> 00:50:39,470
كثيراً ما تُغنّي هذه الأغنية

744
00:50:39,470 --> 00:50:41,550
إنّها أغنية تمنّي

745
00:50:42,520 --> 00:50:49,560
حيث تتمنّى لأحبّائك أن يبقوا سليمين
صحّياً أو يعودوا إلى الدّيار آمنين

746
00:50:49,940 --> 00:50:53,860
علّمني هذه الأغنية أيضاً

747
00:50:54,290 --> 00:50:55,280
حسناً

748
00:50:55,280 --> 00:50:56,920
هل يمكنكم تعليمنا كذلك؟

749
00:50:59,620 --> 00:51:01,660
...دعونا نتمنّى أيضاً

750
00:51:02,350 --> 00:51:05,110
أن يكون الجميع والحصن بأمان

751
00:51:13,640 --> 00:51:14,400
ياماتونوكامي

752
00:51:14,400 --> 00:51:16,290
كاشو

753
00:51:14,930 --> 00:51:15,660
!تماسكا

754
00:51:16,290 --> 00:51:17,760
!عودا بأمان

755
00:51:20,120 --> 00:51:25,240
لا شكّ بالنّسبة لسيّدي، لكن
يبدو أنّ الجميع يحبّوننا أيضاً

756
00:51:25,970 --> 00:51:26,970
بالفعل

757
00:51:30,910 --> 00:51:32,850
ماذا نفعل؟

758
00:51:32,850 --> 00:51:34,150
لا أدري

759
00:51:34,510 --> 00:51:37,860
يمكننا العودة إلى المنزل، لكن لن نفعل ذلك

760
00:51:37,860 --> 00:51:38,860
...أجل

761
00:51:49,820 --> 00:51:54,670
لم يبقَ شيء من حصننا بعد الآن

762
00:51:55,250 --> 00:51:56,100
أجل

763
00:51:57,350 --> 00:52:00,800
خسارة المكان حيث يعيشون معنا ومع الآخرين

764
00:52:01,350 --> 00:52:03,760
هو أكثر شيء مؤلم؟

765
00:52:04,620 --> 00:52:06,220
هكذا هو طبع سيّدي

766
00:52:06,770 --> 00:52:08,680
لكن هذا سيّئ، حتّى بالنّسبة لحلم

767
00:52:09,320 --> 00:52:13,110
أريد إيقاظهم من هذا الكابوس بسرعة

768
00:52:14,860 --> 00:52:15,400
...أنت

769
00:52:16,120 --> 00:52:20,400
،إن كنتِ شجرة ساكورا تُحقّق الأُمنيات فعلاً

770
00:52:21,640 --> 00:52:26,830
فأرجوكِ حرّري سيّدي من هذا الكابوس بسرعة

771
00:52:27,380 --> 00:52:29,790
أبعدي سيّدنا من هنا

772
00:52:30,670 --> 00:52:31,770
!أرجوكِ

773
00:52:43,900 --> 00:52:44,980
...أيُعقَل أنّ هذا

774
00:52:46,460 --> 00:52:48,810
نُواة عقل سيّدي؟

775
00:52:52,060 --> 00:52:56,060
هل أوصلَتْك أصواتهم إلى هنا أيضاً يا سيّدي؟

776
00:52:56,060 --> 00:52:59,190
!لا تُقلقنا هكذا

777
00:52:59,700 --> 00:53:03,560
انظر كم يقلق عليك الجميع

778
00:53:03,560 --> 00:53:05,660
لذا أسرع واستيقظ

779
00:53:06,220 --> 00:53:11,620
أريدك أن تستيقظ وتكون بحالٍ جيّدة

780
00:53:12,040 --> 00:53:15,580
فنحن نُحبّك

781
00:53:16,100 --> 00:53:19,880
لذا ابتسم كما تفعل دوماً

782
00:53:26,030 --> 00:53:27,540
!ما هذا؟

783
00:53:28,360 --> 00:53:29,640
مُذهل

784
00:53:32,120 --> 00:53:36,810
وأُمنياتنا تمنح شجرة الكرز هذه قوّة؟

785
00:53:37,640 --> 00:53:40,460
تمنّوا بشدّة أكبر يا رِفاق

786
00:54:06,610 --> 00:54:08,410
ما الّذي يحدث؟

787
00:54:08,790 --> 00:54:12,730
لا أدري، لكن هذا دافئ بالفعل

788
00:54:13,090 --> 00:54:13,870
أجل

789
00:54:17,490 --> 00:54:18,650
...إنّه يتوهّج

790
00:54:19,030 --> 00:54:22,180
لعلّه يستجيب لمشاعر الجميع

791
00:54:23,030 --> 00:54:24,570
لا بدّ أنّ السّبب هو هذا

792
00:54:25,380 --> 00:54:29,850
رأيت؟ لا تدع كابوساً يُثير قلقك

793
00:54:31,620 --> 00:54:34,000
...سنبقى معك دوماً

794
00:54:34,370 --> 00:54:36,460
وهنا لأجلك...

795
00:54:37,450 --> 00:54:40,890
...لذا أعد المكان الّذي التقينا فيه

796
00:54:40,890 --> 00:54:42,920
وذكريات أوقاتنا السّعيدة معاً...

797
00:54:45,450 --> 00:54:46,380
لا تمسحها

798
00:55:12,480 --> 00:55:13,230
...ماذا

799
00:55:16,210 --> 00:55:17,330
!أفلح الأمر

800
00:55:19,570 --> 00:55:20,590
...أيُعقَل أنّ

801
00:55:28,450 --> 00:55:29,120
...حـ

802
00:55:30,630 --> 00:55:31,430
...حصننا

803
00:55:33,650 --> 00:55:34,960
عاد؟

804
00:55:45,610 --> 00:55:48,580
!أنا مسرور... مسرور جدّاً

805
00:55:53,080 --> 00:55:57,450
إنّ رؤية الحصن من هنا تُسكّنني فعلاً

806
00:55:58,020 --> 00:56:00,020
أجل. أنا أيضاً

807
00:56:01,520 --> 00:56:04,730
يمكنك أن تسمع النّاس وهم يستمتعون

808
00:56:04,730 --> 00:56:08,330
سيظلّ حصننا في نظري لطيفاً ودافئاً

809
00:56:08,330 --> 00:56:09,550
تماماً

810
00:56:11,690 --> 00:56:15,930
!كم أنا مُرهَق

811
00:56:16,630 --> 00:56:19,680
لا أريد أن أخوض مهمّة كهذه ثانية

812
00:56:20,220 --> 00:56:21,230
أتّفق

813
00:56:21,960 --> 00:56:27,390
...أنا... مُنهَك... تماماً... أيضاً

814
00:56:48,730 --> 00:56:49,640
!سيّدي؟

815
00:56:53,880 --> 00:56:55,550
!ياسوسادا

816
00:56:57,340 --> 00:57:00,190
ماذا؟ ما الأمر؟

817
00:57:00,190 --> 00:57:02,490
!كُفّ عن الكلام في منامك

818
00:57:03,190 --> 00:57:05,120
هيّا، انهض على قدميك

819
00:57:05,120 --> 00:57:07,210
!كاشو-سان، ياماتونوكامي-سان

820
00:57:07,210 --> 00:57:09,060
صباح الخير أيُّها النّعسانان

821
00:57:09,060 --> 00:57:10,680
هل أنتما بحال جيّدة؟

822
00:57:10,680 --> 00:57:12,070
نحن بخير

823
00:57:12,460 --> 00:57:14,620
ماذا عن سيّدي والآخرين؟

824
00:57:17,780 --> 00:57:19,630
كان ذلك عجيباً

825
00:57:18,690 --> 00:57:20,260
...كما قلتُ

826
00:57:34,930 --> 00:57:36,860
!أنتما

827
00:57:36,860 --> 00:57:38,100
استيقظتما؟

828
00:57:38,510 --> 00:57:39,720
!أجل

829
00:57:39,720 --> 00:57:40,850
!نتكلّم معكم لاحقاً

830
00:57:40,850 --> 00:57:43,080
هـ-هذا مُطمئن

831
00:57:45,750 --> 00:57:46,430
مهلاً

832
00:57:46,430 --> 00:57:47,400
آسف

833
00:57:47,970 --> 00:57:50,070
هل ينبغي أن تكونا مستيقظين هكذا؟

834
00:57:50,070 --> 00:57:51,280
!نحن بخير

835
00:57:53,150 --> 00:57:55,490
...خمسة، ستّة، سبعة، ثمانية

836
00:58:06,920 --> 00:58:08,280
مهلاً

837
00:58:11,510 --> 00:58:12,630
أنتما

838
00:58:13,100 --> 00:58:14,760
أقلقتماني

839
00:58:14,760 --> 00:58:15,720
!شكراً

840
00:58:29,770 --> 00:58:32,180
!صباح الخير يا سيّدي