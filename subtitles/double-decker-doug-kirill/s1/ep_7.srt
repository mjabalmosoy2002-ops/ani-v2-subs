.لذلك سأغلق الخطّ

198
00:12:44,430 --> 00:12:45,850
.انتظر يا دوغ

199
00:12:45,850 --> 00:12:50,110
.أعتقد أنّ هنالك سوء فهم بيننا

200
00:12:50,760 --> 00:12:54,760
أنا مشغول أيضًا ولا أريد إضافة المزيد
.من العمل الّذي ليس عليّ التّعامل معه

201
00:12:54,760 --> 00:12:57,500
.لذلك دعنا نتحدّث

202
00:12:57,500 --> 00:13:00,130
لا داعي لنتحدّث، صحيح؟

203
00:13:00,830 --> 00:13:02,650
.قال إنّه قادم

204
00:13:03,430 --> 00:13:05,770
!كلاّ! لا تأتي يا دوغ

205
00:13:06,750 --> 00:13:08,970
سمعتَه. ماذا ستفعل؟

206
00:13:08,970 --> 00:13:11,600
كم رجلاً لديك؟

207
00:13:12,480 --> 00:13:14,720
.أحضر القدر الّذي تستطيعه

208
00:13:14,720 --> 00:13:17,840
.سيجعل هذا مسألة الدّفاع عن النّفس أسهل

209
00:13:19,020 --> 00:13:20,560
تريدني أن أعمل في مناوبتك؟

210
00:13:20,560 --> 00:13:21,890
.هذا نادر

211
00:13:21,890 --> 00:13:24,240
.نعم، عليّ الذّهاب لمكان ما

212
00:13:25,030 --> 00:13:28,040
ستذهب للقاء جو الوسيم، صحيح؟

213
00:13:37,320 --> 00:13:40,450
.لا تحاول الانتقام يا دوغ

214
00:13:40,450 --> 00:13:42,580
.سأذهب فقط لأنّه طلب منّي ذلك

215
00:13:44,760 --> 00:13:46,850
ما هذا إذًا؟

216
00:13:47,210 --> 00:13:48,600
.لا تقلق

217
00:13:48,600 --> 00:13:51,720
.لديّ إذن بحمله وأنا لست أعمل

218
00:13:52,130 --> 00:13:54,370
.ذلك ليس ما كنت أتحدّث عنه

219
00:13:55,470 --> 00:13:58,020
ما هذا؟

220
00:13:58,020 --> 00:14:01,860
.تمّ إخباري بأنّه مهدّئ طوّره الدّكتور

221
00:14:06,820 --> 00:14:08,810
.حان الوقت أخيرًا لإنهاء الأمور

222
00:14:09,590 --> 00:14:11,770
.سأستعير هذا

223
00:14:14,330 --> 00:14:15,410
...دوغ

224
00:14:16,720 --> 00:14:18,920
!خذني إلى جو

225
00:14:21,410 --> 00:14:23,130
!مهلاً، مهلاً

226
00:14:23,130 --> 00:14:24,550
يسعى دوغ للانتقام؟

227
00:14:24,550 --> 00:14:25,920
.أنا واثق من ذلك

228
00:14:25,920 --> 00:14:27,480
لماذا لم توقفه؟

229
00:14:27,480 --> 00:14:31,510
ذلك لأنّني لم أعلم أنّ الأمور
.ستصل إلى هذا الحدّ

230
00:14:31,510 --> 00:14:33,620
!قد يقتل أحدًا ما

231
00:14:34,490 --> 00:14:38,060
هل كان عليّ إذًا أن أخبره
بالتّخلّي عن القضيّة؟

232
00:14:38,060 --> 00:14:39,310
...هذا

233
00:14:39,310 --> 00:14:41,280
كم نسبة الانتقام في هذه القضيّة؟

234
00:14:41,280 --> 00:14:43,350
من يتّخذ ذلك القرار؟

235
00:14:43,790 --> 00:14:45,150
أنا؟

236
00:14:45,150 --> 00:14:46,380
أنت؟

237
00:14:48,710 --> 00:14:50,990
أعتقد أنّ كلّ محقّقيّ أشخاص
.تحكمهم أخلاقهم

238
00:14:51,820 --> 00:14:54,240
!أخبرتك للتّوّ أنّني أثق بمحقّقيّ

239
00:14:54,240 --> 00:14:55,300
!اخرس

240
00:14:55,300 --> 00:14:58,150
!كنت على وشك إقناعي بالتخلّي عن الأمر

241
00:15:02,390 --> 00:15:04,010
.مرحبًا

242
00:15:10,730 --> 00:15:12,270
أين دنيس؟

243
00:15:16,040 --> 00:15:18,940
.ارمِ سلاحك وضع يديك خلف رأسك

244
00:15:25,990 --> 00:15:27,790
.ما الخطب؟ هيّا

245
00:15:29,350 --> 00:15:31,560
.لقد نسيت

246
00:15:31,560 --> 00:15:34,660
.إنّه أحد زبائني المعتادين

247
00:15:35,250 --> 00:15:40,180
لذلك عرفتُ كلّ شيء عليّ
.أن أعرفه عنك وعن بول

248
00:15:41,140 --> 00:15:42,420
.يا لسخرية القدر

249
00:15:42,760 --> 00:15:46,240
.رئيسك السّابق مدمن مخدّرات الآن

250
00:15:46,750 --> 00:15:49,140
.أنا آسف يا دوغ

251
00:15:49,140 --> 00:15:50,280
.كلاّ

252
00:15:50,280 --> 00:15:52,560
.كان عليّ أن ألاحظ ذلك

253
00:15:55,090 --> 00:15:58,120
.لنتحدّث عنك الآن يا دوغ بيلينغهام

254
00:15:58,680 --> 00:16:04,860
سمعتُ أنّك تسعى خلفي لأنّني قتلت
.وسيط معلومات يُدعى بات مورينو

255
00:16:04,860 --> 00:16:08,020
.لكنّني لا أعرف حتّى من يكون

256
00:16:08,800 --> 00:16:10,560
من يكون؟

257
00:16:11,580 --> 00:16:13,020
ملمّع أحذية؟

258
00:16:13,020 --> 00:16:13,840
.صحيح

259
00:16:13,840 --> 00:16:17,460
.كان يلمّع الأحذية ويبيع المعلومات

260
00:16:18,350 --> 00:16:20,920
عندما كان دوغ لا يزال محقّقًا
،جديدًا قبل ثمان سنوات

261
00:16:21,310 --> 00:16:25,670
.كانت إسبرانزا جماعة أكثر عنفًا ممّا هم الآن

262
00:16:25,670 --> 00:16:30,640
كان الكثير من أعضائها مجانين فحسب
.وكانت هنالك نزاعات داخليّة دائمًا

263
00:16:31,330 --> 00:16:37,360
.قُتل بات عندما كان يلمّع الأحذية

264
00:16:37,970 --> 00:16:41,380
.تلقّى ثلاثة عشر رصاصة

265
00:16:41,380 --> 00:16:44,120
وكانت مِن جو؟

266
00:16:44,120 --> 00:16:46,300
.لكن لم يكن هنالك أيّ دليل

267
00:16:47,160 --> 00:16:50,520
.اختفى جو بعد ذلك

268
00:16:51,060 --> 00:16:55,870
.لهذا السّبب هو مهووس بإسبرانزا

269
00:16:56,460 --> 00:16:58,300
!تذكّرتُ أخيرًا

270
00:16:58,300 --> 00:17:00,490
!تذكّرت كلّ شيء

271
00:17:00,490 --> 00:17:02,450
.أخبرني بأمر واحد فقط

272
00:17:02,450 --> 00:17:03,780
لماذا قتلته؟

273
00:17:04,450 --> 00:17:06,920
.لم يكن هنالك داعٍ لذلك

274
00:17:07,850 --> 00:17:09,390
.ملمّع الأحذية

275
00:17:10,570 --> 00:17:14,320
!استعمل اللّون الخطأ لتلميع حذائي

276
00:17:15,940 --> 00:17:17,730
لهذا السّبب؟

277
00:17:18,650 --> 00:17:23,850
قتلت طفلاً في الثّانية عشر
من عمره لذلك السّبب؟

278
00:17:27,460 --> 00:17:28,770
.بات مورينو

279
00:17:29,620 --> 00:17:34,060
.كانت باتريشيا مورينو في الثّانية عشر حينها

280
00:17:34,540 --> 00:17:36,370
لكانت في العشرين من عمرها
لو عاشت حتّى الآن؟

281
00:17:36,370 --> 00:17:40,290
.حسنًا، لم يكن لها مستقبل من الأساس

282
00:17:40,740 --> 00:17:44,250
قمتُ بعمل نبيل، ألا تظنّ ذلك
يا دوغ بيلينغهام؟

283
00:17:45,120 --> 00:17:50,530
.لقد أراحتني معرفة أنّك رجل أسوأ ممّا ظننت

284
00:17:51,270 --> 00:17:54,110
.حسنًا، كفانا كلامًا

285
00:17:55,710 --> 00:18:00,520
إذًا فقد قتل يتيمة في الثّانية عشر من عمرها؟

286
00:18:00,890 --> 00:18:06,510
حينها بدأ دوغ يكره الفقر
.والاختلافات الطّبقيّة

287
00:18:06,510 --> 00:18:07,810
.ذلك ما أعتقد على الأقلّ

288
00:18:09,270 --> 00:18:11,810
.لن تنقذك الأرقام

289
00:18:11,810 --> 00:18:14,200
.عليك التّفكير بذكاء لتنجو

290
00:18:14,200 --> 00:18:15,910
.أنت من طلبها

291
00:18:16,710 --> 00:18:19,330
.إنّه أمر تعلّمته في السّنوات الثّمانية السّابقة

292
00:18:22,200 --> 00:18:24,590
.كنت تحمل هذا في معطفك

293
00:18:24,590 --> 00:18:25,980
عمّ تتحدّث؟

294
00:18:26,720 --> 00:18:30,390
مسدّس ليدي جوكر برصاص ذي رأس فارغ؟

295
00:18:31,470 --> 00:18:35,960
إنّها رصاصات وحشيّة بالنّسبة
.لمسدّس ظريف كهذا

296
00:18:36,890 --> 00:18:41,490
.لكنّ دوغ لم يبتع أيّ معلومات من بات

297
00:18:42,270 --> 00:18:47,480
لم ينفكّ عن إخبارها بالتّوقّف عن ذلك
.بسبب خطورة الأمر

298
00:18:47,960 --> 00:18:50,380
،لكنّها لم تستمع له على الإطلاق

299
00:18:50,380 --> 00:18:55,190
.لذلك منحها سرًا مسدّسًا لحماية نفسها

300
00:18:55,190 --> 00:18:56,790
دوغ فعل ذلك؟

301
00:18:56,790 --> 00:18:57,710
.نعم

302
00:18:57,710 --> 00:19:01,080
لقد أعطاها مسدّس ليدي جوكر
.من باب الحيطة

303
00:19:02,520 --> 00:19:07,090
.عرفتُ أنّ جبانًا مثلك سيفعل ذلك

304
00:19:07,090 --> 00:19:08,370
.وداعًا

305
00:19:08,370 --> 00:19:09,740
.لقد فزت

306
00:19:12,580 --> 00:19:14,120
.تلك الرّصاصات مزيّفة

307
00:19:14,990 --> 00:19:17,410
،فيما عدا الرّصاصة الرّابعة
.فهي رصاصة ضوئيّة

308
00:19:22,980 --> 00:19:25,770
رفضت أخذ المسدّس؟

309
00:19:25,770 --> 00:19:27,870
.نعم، ذلك ما سمعت

310
00:19:27,870 --> 00:19:29,050
لماذا؟

311
00:19:29,050 --> 00:19:30,170
.لا أدري

312
00:19:30,510 --> 00:19:32,350
.لا يمكنني إخبارك بذلك

313
00:19:34,090 --> 00:19:38,260
.دوغ... لا يجب على شرطيّ خرق القانون

314
00:19:40,570 --> 00:19:42,390
.لكنّ الأمر بدأ حينها

315
00:19:44,890 --> 00:19:51,960
.بدأ حينها يهتمّ بالقانون والأنظمة في العمل

316
00:19:51,960 --> 00:19:53,540
.ذلك ما أظنّ على أيّ حال

317
00:19:57,350 --> 00:20:01,470
إنّ أيّ أحد يعتمد على الأعداد الكثيرة
سيترك دائمًا ثغرات في دفاعه؟

318
00:20:01,470 --> 00:20:07,390
سيعتمد الجبناء من ذلك النّوع دائمًا على
.السّلاح الأقوى الّذي يمكنهم العثور عليه

319
00:20:07,390 --> 00:20:10,010
!مـ-مـ-مهلاً

320
00:20:10,010 --> 00:20:12,440
أنت محقّق، صحيح؟

321
00:20:12,440 --> 00:20:14,520
.نعم، أنا محقّق

322
00:20:14,520 --> 00:20:17,860
.لديّ أخبار جيّدة وأخرى سيّئة

323
00:20:17,860 --> 00:20:19,480
أيّها تريد أن تسمع أوّلاً؟

324
00:20:20,380 --> 00:20:25,040
الأخبار الجيّدة هي أنّ بإمكاني تفجير
.رأسك الآن وسيكون دفاعًا عن النّفس

325
00:20:26,000 --> 00:20:29,710
!مهلاً! تلك أخبار جيّدة بالنّسبة لك، وليس لي

326
00:20:29,710 --> 00:20:31,020
.ربّما

327
00:20:31,020 --> 00:20:38,010
والأخبار السّيّئة هي أنّك ستكون ميتًا
.قبل أن تتمكّن من الشّكوى بشأن ذلك

328
00:20:39,530 --> 00:20:43,660
اعتذر لباتريشيا في الحياة الأخرى
.يا جو الوسيم

329
00:20:53,360 --> 00:20:54,440
!دوغ

330
00:20:54,440 --> 00:20:56,200
.لا تفهم الأمر بشكل خاطئ

331
00:20:56,200 --> 00:20:58,330
.لقد تمّ اعتقالهم جميعًا

332
00:21:00,300 --> 00:21:01,440
خلل في الإطلاق؟

333
00:21:01,440 --> 00:21:03,330
.كان أنبوب المسدّس سيّئًا

334
00:21:03,330 --> 00:21:05,540
كم من الوقت في اعتقادك كان ذلك
الشّيء موضوع على رفّ ما؟

335
00:21:05,970 --> 00:21:07,980
.لا يمكنه إطلاق الكثير من الرّصاصات

336
00:21:07,980 --> 00:21:09,240
ماذا؟

337
00:21:10,150 --> 00:21:12,430
.الانتقام أمر قديم الطّراز

338
00:21:13,080 --> 00:21:14,250
أليس كذلك؟

339
00:21:19,380 --> 00:21:21,350
.هيّا، أسرع

340
00:21:25,390 --> 00:21:27,760
.استيقظ بول

341
00:21:27,760 --> 00:21:30,330
.بلغني اتّصال من المشفى

342
00:21:30,330 --> 00:21:31,710
.هكذا إذًا

343
00:21:31,710 --> 00:21:32,870
.هذا جيّد

344
00:21:32,870 --> 00:21:34,890
.دعني أسألك يا دوغ

345
00:21:34,890 --> 00:21:39,310
عرفتَ أنّ ذلك المسدسّ سيخطئ أثناء
الضّغط على الزّناد، صحيح؟

346
00:21:40,210 --> 00:21:41,460
...أنا

347
00:21:44,020 --> 00:21:48,370
أعتقد إذًا أنّ شريكتك لم ترغب
في الانتقام بالفعل، صحيح؟

348
00:21:49,200 --> 00:21:52,630
،إن كان قد حدث خلل في الإطلاق
فذلك هو السّبب، صحيح؟

349
00:21:57,380 --> 00:21:59,570
.نعم. عرفتُ ذلك

350
00:21:59,570 --> 00:22:01,630
!حسنًا، كلّ شيء على ما يرام إذًا

351
00:22:09,710 --> 00:22:17,690
أخبرني شريكي أنّ فتاة ستحبّ هذا أكثر
.من المسدّسات أو الويسكي

352
00:22:20,200 --> 00:22:23,890
.لكنتما قد أصبحتما صديقين جيّدين

353
00:23:55,760 --> 00:23:57,640
!تقع حادثة في إحدى الثّانويّات

354
00:23:57,640 --> 00:24:00,040
!ينكشف ماضي ماكس حينها

355
00:24:00,040 --> 00:24:02,840
!كيف أصبحت ماكسين ماكس؟

356
00:24:02,840 --> 00:24:04,620
:"في الحلقة الثّامنة من "دوبل دكّر

357
00:24:04,620 --> 00:24:06,410
!الرّقص! تحقيق أكاديميّة

358
00:24:06,410 --> 00:24:09,690
!ممنوع الرّقص في غرفة الاجتماعات
!إنّها للاجتماعات