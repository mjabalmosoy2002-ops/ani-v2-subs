1
00:00:04,590 --> 00:00:05,760
.لا تقلق

2
00:00:05,760 --> 00:00:07,690
.يمكننا أن نثق بمورغان

3
00:00:07,690 --> 00:00:09,780
.أنا لا أقول أنّني لا أصدّقك

4
00:00:09,780 --> 00:00:10,470
.لنذهب

5
00:00:12,770 --> 00:00:15,360
!يمكنني الآن أن أكون بطلاً

6
00:00:16,880 --> 00:00:18,000
!"هذه "سفن-أو

7
00:00:18,960 --> 00:00:22,250
!اسمحوا لي أوّلاً أن أشرح للمشاهدين لأوّل مرّة

8
00:00:22,250 --> 00:00:23,790
!إنّه امرأة

9
00:00:23,790 --> 00:00:25,900
!أمزح فحسب! إنّه رجل

10
00:00:25,900 --> 00:00:28,600
...وهذه قصّة عن الأبطال

11
00:00:28,600 --> 00:00:29,920
!فيما عدا أنّها ليست كذلك

12
00:00:29,920 --> 00:00:34,220
إنّها قصّة عن محقّقَين تدفعون لهما
!من أموال ضرائبكم

13
00:02:06,510 --> 00:02:09,350
...حوالي أسبوع قبل ما شاهدتموه للتّوّ

14
00:02:09,780 --> 00:02:11,690
،"أصبحت محقّقًا للتّوّ واسمي الرّمزيّ هو "المبتدئ

15
00:02:11,690 --> 00:02:13,320
."لكنّه تغيّر بسرعة ليصبح "أوكابّا

16
00:02:16,700 --> 00:02:20,260
لقد خطوتُ أولى خطواتي
...لأصبح بطلاً، عندما

17
00:02:21,030 --> 00:02:22,650
.أنا آسف يا أوكابّا

18
00:02:22,650 --> 00:02:23,900
.أنت مطرود

19
00:02:24,850 --> 00:02:27,880
.في اليوم التّالي، أخبروني أنّني مطرود

20
00:02:29,570 --> 00:02:32,590
.مهلاً... أنا لا أفهم

21
00:02:32,590 --> 00:02:34,130
.اقترفتُ خطأ

22
00:02:34,130 --> 00:02:36,080
.كان لدينا مكان شاغر فقط، وليس اثنين

23
00:02:36,080 --> 00:02:38,890
.وذلك المكان الشّاغر كان يفترض أن يعود لكاي

24
00:02:38,890 --> 00:02:41,360
.نعم. لم يكن يُفترض بك أن تكون هنا من الأساس

25
00:02:42,280 --> 00:02:43,580
.آسف يا أوكابّا

26
00:02:43,580 --> 00:02:46,750
.عد إلى عملك السّابق

27
00:02:46,750 --> 00:02:50,200
!مستحيل! لقد بدأت العمل للتّوّ

28
00:02:49,090 --> 00:02:51,370
...لكنّني سأخبرك من هو الضّحيّة الحقيقيّة

29
00:02:51,810 --> 00:02:56,640
.إنّه أنا. على الأرجح أنّ هذا سيكلّفني ترقية

30
00:02:57,080 --> 00:02:58,440
!أنا آسف

31
00:03:00,710 --> 00:03:04,390
بعد سماعه للكلمات الّتي كان على
،رئيسه أن يفكّر بها أكثر قبل قولها

32
00:03:04,390 --> 00:03:05,900
،قال كيريل لنفسه

33
00:03:05,900 --> 00:03:11,220
فهمت! هذا اختبار وُضع أمامي
"!من طرف إله الأبطال

34
00:03:12,230 --> 00:03:13,750
...هكذا إذًا

35
00:03:14,530 --> 00:03:16,520
.امنحني أسبوعًا إذًا

36
00:03:16,520 --> 00:03:19,840
،إن لم أستطع تحقيق أيّ شيء في ذلك الوقت

37
00:03:19,840 --> 00:03:21,420
.فسأغادر بكلّ سرور

38
00:03:21,420 --> 00:03:26,770
لكن إن استطعت، وغيّرت رأيك
،وقرّرت أنّك بحاجتي

39
00:03:26,770 --> 00:03:29,220
.تحدّث إلى رؤسائك ثانية

40
00:03:32,050 --> 00:03:34,890
!صحيح! إنّه مجرّد غبيّ

41
00:03:37,940 --> 00:03:40,560
...لكنّ كيريل أدرك حينها

42
00:03:40,560 --> 00:03:42,680
!من المستحيل أن يقبل مديره بذلك

43
00:03:42,680 --> 00:03:45,860
!لم يكن لترافيس ما يربحه من كلّ هذا

44
00:03:46,150 --> 00:03:47,150
!...ولكن

45
00:03:47,150 --> 00:03:51,110
.جيّد. إن استطعتَ ذلك، سأعيد التّفكير في الأمر

46
00:03:51,430 --> 00:03:54,990
!صحيح! إنّه مجرّد غبيّ أيضًا

47
00:03:54,990 --> 00:03:57,380
.أنت، لدينا غبيّ آخر لنتعامل معه الآن

48
00:03:57,380 --> 00:03:58,420
ألا يمكنك فعل أيّ شيء؟

49
00:03:58,790 --> 00:04:01,040
يبدو أنّ من الممتع التّواجد برفقته، صحيح؟

50
00:04:01,630 --> 00:04:05,320
ما دامت هنالك جريمة تحدث، فسأكون
.قادرًا على تنفيذ جانبي من الصّفقة

51
00:04:05,320 --> 00:04:07,740
.ذلك ما ظننته حينها

52
00:04:07,740 --> 00:04:08,910
...لكن

53
00:04:11,370 --> 00:04:13,750
!لا توجد جرائم

54
00:04:14,940 --> 00:04:17,380
...اجتماعات ومعاملات ورقيّة

55
00:04:17,380 --> 00:04:19,610
...تدريب إضافيّ وعمل إضافيّ في المساء

56
00:04:19,960 --> 00:04:23,340
لم يكن هذا يشبه أيّ شيء ممّا تخيّلته
...عن عمل المحقّقين

57
00:04:23,340 --> 00:04:26,290
.كان مجرّد عمل مكتبيّ مملّ فحسب

58
00:04:26,290 --> 00:04:27,660
...وعندما تمّ الاتّصال بنا

59
00:04:27,660 --> 00:04:30,100
!يا إلهي، أنت غبيّ جدًّا

60
00:04:30,100 --> 00:04:32,220
أعرف أنّك غبيّ، لكن لماذا أنا غبيّ؟

61
00:04:32,220 --> 00:04:36,950
كانت مجرّد مهمّة تحقيق سرّيّة
...لمسألة المرحلة 1 تلك

62
00:04:37,700 --> 00:04:39,810
...وهذا المدعوّ دوغ

63
00:04:39,810 --> 00:04:43,750
.لا أستطيع أن أفهم ما يدور في باله فحسب

64
00:04:44,940 --> 00:04:47,460
هل هو فعلاً نفس ذلك الشّخص؟

65
00:04:48,160 --> 00:04:51,860
.إنّهما مجرّد حبيبين يصرخان على بعضهما

66
00:04:51,860 --> 00:04:53,220
هل هنالك أيّ هدف من مراقبة هذا؟

67
00:04:53,220 --> 00:04:56,750
فعلاً؟ أعتقد أنّ الوقت قد حان
.لإزالتهما من اللاّئحة إذًا

68
00:04:57,360 --> 00:05:00,450
!لحظة، إنّه يبدو خطيرًا

69
00:05:00,450 --> 00:05:02,030
أتريد أن نحقّق في أمره؟

70
00:05:02,030 --> 00:05:04,230
.دينا ستتولّى أمره

71
00:05:07,400 --> 00:05:10,570
...لا أتوقّع الكثير من هذه المهمة أيضًا

72
00:05:11,780 --> 00:05:13,900
!لم يتبقّ لي إلاّ يومان

73
00:05:13,900 --> 00:05:18,800
،عندما يكون المرء راغبًا بشدّة في الفوز
.فإنّه يبدأ بالتّصرّف بتهاون

74
00:05:18,800 --> 00:05:19,750
من أنت؟

75
00:05:19,750 --> 00:05:22,460
هل سبق ولعبت بكلّ الأوراق الّتي بين يديك؟

76
00:05:22,460 --> 00:05:23,550
مهلاً، من أنت؟

77
00:05:24,220 --> 00:05:25,210
...كلاّ

78
00:05:26,360 --> 00:05:29,050
!صحيح! كان ذلك ما أردتُ سماعه تمامًا

79
00:05:29,050 --> 00:05:30,860
!شكرًا لك أيّها الرّجل الّذي لم أقابله من قبل

80
00:05:31,550 --> 00:05:34,260
،بمساعدة تلميح من رجل لم أقابله من قبل

81
00:05:34,260 --> 00:05:36,580
.ذهبت لمقابلة المخبر مورغان

82
00:05:36,970 --> 00:05:37,990
...مرحبًا

83
00:05:37,990 --> 00:05:39,670
.لم أرك منذ مدّة

84
00:05:41,110 --> 00:05:43,670
أنت محقّق الآن، صحيح يا فتى؟

85
00:05:43,670 --> 00:05:46,070
نعم. هل لديك أيّ معلومات جيّدة لي؟

86
00:05:46,070 --> 00:05:49,120
،نعم. هل تتذكّر بيلي جامع العُملات

87
00:05:49,120 --> 00:05:52,000
اللّصّ المثير للشّفقة الّذي اعتقلتَه منذ مدّة؟

88
00:05:52,940 --> 00:05:55,370
لقد خرج للتّوّ، وهو يدور في الأرجاء

89
00:05:55,370 --> 00:05:57,880
.ويتفاخر بشأن عمليّة كبيرة يخطّط لها

90
00:05:57,880 --> 00:05:59,760
عمليّة كبيرة؟ ما هي؟

91
00:05:59,760 --> 00:06:01,200
.هذه على حسابي

92
00:06:01,200 --> 00:06:04,220
.تقول الإشاعة أنّ للأمر علاقة بأنثيم

93
00:06:07,260 --> 00:06:10,430
تهريب أنثيم؟ هل أنت واثق من هذا؟

94
00:06:10,430 --> 00:06:14,710
!نعم. لم يعطني مورغان معلومات سيّئة من قبل

95
00:06:15,480 --> 00:06:17,040
.عرفت هذا

96
00:06:17,040 --> 00:06:19,320
.أستطيع معرفة ما يفكّر به

97
00:06:19,320 --> 00:06:23,390
تعلو وجهه نظرة من يحاول التّفكير
.في طريقة للتّملّص من هذا الأمر

98
00:06:23,390 --> 00:06:25,560
—لكنّني لن أتراجع

99
00:06:24,610 --> 00:06:27,780
.أتعلم؟ يبدو وجهك كوجه فتاة

100
00:06:29,700 --> 00:06:31,200
.أكيد. لنذهب

101
00:06:32,130 --> 00:06:33,150
!مهلاً

102
00:06:35,030 --> 00:06:39,420
وهكذا، حصلت على الأرجح على
.فرصتي الأخيرة لأكون بطلاً

103
00:06:42,550 --> 00:06:45,300
.بدأ بيلي كلصّ مثير متدنّي المستوى لا أقرباء له

104
00:06:45,300 --> 00:06:48,770
.لم تكن لديه أيّ علاقات عندما خرج من السّجن

105
00:06:48,770 --> 00:06:50,630
،إن أراد جني الكثير من المال

106
00:06:50,630 --> 00:06:52,850
فإنّ تهريب أنثيم سيكون الطّريقة
.الوحيدة لفعل ذلك

107
00:06:52,850 --> 00:06:55,000
.فهمت. هذا مثير للاهتمام

108
00:06:55,000 --> 00:06:57,090
.الأنثيم مادّة خطيرة

109
00:06:57,090 --> 00:06:59,200
يمكن بيعه مقابل الكثير من المال
للمشتري المناسب، صحيح؟

110
00:06:59,200 --> 00:07:00,560
.نعم، أظنّ ذلك

111
00:07:00,560 --> 00:07:01,840
.لا تقلق

112
00:07:01,840 --> 00:07:03,440
.يمكننا أن نثق بمورغان

113
00:07:03,440 --> 00:07:05,520
.أنا لا أقول أنّني لا أصدّقك

114
00:07:16,150 --> 00:07:17,120
أهذا...؟

115
00:07:17,700 --> 00:07:19,760
لا يمكنك الدّخول إلى هناك دون سلاح، صحيح؟

116
00:07:27,960 --> 00:07:29,060
.ديريك

117
00:07:29,410 --> 00:07:30,220
.لنذهب

118
00:07:31,650 --> 00:07:32,880
!"هذه "سفن-أو

119
00:07:32,880 --> 00:07:36,610
،ليضع الجميع أيديهم خلف رؤوسهم
!وأيديهم على الأرض

120
00:07:37,990 --> 00:07:39,360
أيدينا خلف رؤوسنا...؟

121
00:07:39,360 --> 00:07:40,770
ثمّ على الأرض؟

122
00:07:40,770 --> 00:07:43,310
.إنّك تطلب منهم الكثير
.إنّهم غير واثقين ممّا عليهم فعله

123
00:07:47,060 --> 00:07:48,020
هكذا؟

124
00:07:48,020 --> 00:07:49,170
.لا، هكذا

125
00:07:49,500 --> 00:07:51,070
هذا أنثيم، صحيح؟

126
00:07:58,510 --> 00:07:59,490
قرود؟

127
00:08:03,910 --> 00:08:06,720
.شكرًا جميعًا على تعاونكم

128
00:08:06,720 --> 00:08:08,210
.لا تقلقوا

129
00:08:08,210 --> 00:08:09,940
.كانت هذه حصّة تدريبيّة فقط

130
00:08:22,810 --> 00:08:24,390
أليس لديك ما تقوله؟

131
00:08:25,330 --> 00:08:26,830
."مثل "لا تدع ذلك يحبطك

132
00:08:26,830 --> 00:08:29,050
".يقترف الجميع الأخطاء"

133
00:08:29,350 --> 00:08:31,220
ذلك ما يفترض أن يحدث الآن، صحيح؟

134
00:08:31,220 --> 00:08:35,980
نعم... فكرتك عن أنّ الأمر له
.علاقة بتهريب الأنثيم كانت جيّدة

135
00:08:39,680 --> 00:08:43,030
،أصبح الأنثيم شائعًا للغاية في السّنوات القليلة الماضية

136
00:08:43,030 --> 00:08:46,010
وبما أنّ التّعامل معه أكثر خطورة
،من المخدّرات الأخرى

137
00:08:46,010 --> 00:08:48,710
.يمكن للتّجّار جني الكثير من المال منه

138
00:08:48,710 --> 00:08:52,040
أمسى من الشّائع مؤخرًا أن يحاول النّاس
الّذين لم يحالفهم الحظّ في حياتهم

139
00:08:52,040 --> 00:08:57,060
المتاجرة بالأنثيم ليصبحوا أغنياء، فقط
.ليتحوّل ذلك إلى سبب في إفساد حياتهم

140
00:09:04,790 --> 00:09:08,160
.ربّما كان يمكن أن يكون ذلك حالي

141
00:09:08,930 --> 00:09:11,380
.كنّا أيتامًا

142
00:09:11,380 --> 00:09:12,320
كنّا"؟"

143
00:09:12,670 --> 00:09:14,580
.كان لديّ أخت كبرى

144
00:09:14,580 --> 00:09:19,030
،لكنّها اختفت قبل عقد من الزّمان
.وكانت تلك آخر مرّة رأيتها فيها

145
00:09:20,060 --> 00:09:23,850
.لهذا السّبب أصبحت شرطيًّا، للبحث عن أختي

146
00:09:23,850 --> 00:09:25,590
.أردت الحصول على معلومات

147
00:09:25,590 --> 00:09:27,470
.وقابلت حينها مورغان

148
00:09:31,980 --> 00:09:34,880
،لكن بما أنّني أصبحت شرطيًّا الآن

149
00:09:34,880 --> 00:09:37,000
.لم يعد الأمر كما تخيّلته

150
00:09:37,460 --> 00:09:41,800
ظننتُ أنّه سيكون لديّ حرّيّة أكثر
...إن أصبحت محقّقًا، لكن

151
00:09:42,540 --> 00:09:43,680
.لا أدري

152
00:09:44,170 --> 00:09:47,930
أخبرني، لماذا أصبحتَ شرطيًّا؟

153
00:09:47,930 --> 00:09:50,860
ليس عليك إخباري إن لم ترغب
.في ذلك، لكنّني أودّ أن أعرف

154
00:09:53,930 --> 00:09:55,660
هل كنّا نتحدّث عن القردة؟

155
00:09:55,660 --> 00:09:58,210
!لم نكن نتحدّث عن القردة؟

156
00:09:58,210 --> 00:10:00,230
إذًا عمّ كنّا نتحدّث؟

157
00:10:00,230 --> 00:10:03,460
!عن السّبب الّذي دفعك لتصبح محقّقًا

158
00:10:03,460 --> 00:10:05,610
.لا يوجد سبب معيّن

159
00:10:05,610 --> 00:10:06,960
.فهمت

160
00:10:07,490 --> 00:10:09,090
.ربّما هكذا هو الأمر

161
00:10:09,090 --> 00:10:10,170
.كلاّ، هنالك سبب

162
00:10:10,170 --> 00:10:11,290
!هنالك سبب؟

163
00:10:11,290 --> 00:10:13,700
،لا أدري إن كان السّبب الّذي دفعني لأصبح شرطيًّا

164
00:10:13,700 --> 00:10:15,950
.لكن هنالك شيء أريد تخليص العالم منه

165
00:10:16,480 --> 00:10:18,480
أتعني الأنثيم؟

166
00:10:21,540 --> 00:10:25,440
!مقرّ "سفن-أو" الرّسمي، إلى كلّ الوحدات

167
00:10:25,440 --> 00:10:29,540
اندلعت أعمال شغب في سجن
.دسبراتيو في قاعدة إغنيس

168
00:10:29,540 --> 00:10:31,290
.لقد أصيب حارس واحد

169
00:10:31,290 --> 00:10:36,200
يُرجّح أنّ الرّجل المسؤول عن أعمال
،الشّغب هو هنري غلين

170
00:10:36,190 --> 00:10:41,140
.السّجين الّذي حُكم عليه بالسّجن المؤبّد

171
00:10:41,590 --> 00:10:46,800
يحاول هو وعدّة سجناء آخرين الاستفادة
.من الفوضى والهروب

172
00:10:46,800 --> 00:10:49,530
،تعتقد الشّرطة أنّ الهاربين ما زالوا على الجزيرة

173
00:10:49,530 --> 00:10:51,900
،وقد أغلقوا جسر سانكتس
.طريق الدّخول والخروج الوحيد

174
00:10:51,900 --> 00:10:56,090
على كلّ الضّبّاط أن يتأهّبوا للمزيد
...من المعلومات، و

175
00:10:56,090 --> 00:10:57,160
.معكم بيلينغهام

176
00:10:57,160 --> 00:10:57,950
أتسمعينني يا دينا؟

177
00:10:57,950 --> 00:10:59,870
دوغ، أين أنت؟

178
00:10:59,870 --> 00:11:02,070
دينا، أهو نفس الحارس؟

179
00:11:02,070 --> 00:11:04,240
.نعم. روب لوتز

180
00:11:04,240 --> 00:11:05,390
.أنا في طريقي للقبض عليه

181
00:11:05,390 --> 00:11:06,460
روب لوتز؟

182
00:11:06,460 --> 00:11:09,760
.نعم. كانت دينا تحقّق في أمره

183
00:11:24,180 --> 00:11:26,590
ألا يجدر بنا أن نذهب إلى السّجن؟

184
00:11:26,590 --> 00:11:29,120
.اهدأ. إنّه ليس ضمن حدود سلطتنا بعد

185
00:11:29,120 --> 00:11:30,000
بعد؟

186
00:11:30,000 --> 00:11:32,050
—لا. إن كان تخميني صحيحًا

187
00:11:32,050 --> 00:11:34,370
.دوغ! لقد أفصح روب عمّا لديه

188
00:11:34,370 --> 00:11:38,580
أعطى ذلك الوغد الأنثيم لذلك السّجين
.المدعوّ هنري الّذي بدأ أعمال الشّغب

189
00:11:38,580 --> 00:11:39,570
!عُلم

190
00:11:42,680 --> 00:11:44,600
ما علاقة هذا بأعمال الشّغب؟

191
00:11:44,960 --> 00:11:47,810
أليس أنثيم مجرّد مخدّر؟

192
00:11:47,810 --> 00:11:49,300
أهو خطير لتلك الدّرجة؟

193
00:11:49,300 --> 00:11:53,470
نعم. كأيّ مخدّر آخر، فإنّه يمنح المرء
،إحساسًا بالقوّة والمتعة

194
00:11:53,470 --> 00:11:57,770
ولكن ما يجعله سيئًا بشكل خاصّ
.هو أنّه يزيل جميع قيود المرء الطّبيعيّة

195
00:11:57,770 --> 00:11:59,860
أذلك ما يسمّى الاستياق المفرط؟

196
00:11:59,860 --> 00:12:02,350
.كلاّ، ذلك شيء آخر

197
00:12:02,350 --> 00:12:04,530
مهلاً، إلى أين سنذهب؟

198
00:12:05,760 --> 00:12:06,700
.لمكان الجريمة

199
00:12:06,700 --> 00:12:08,650
أليس ذلك الجسر؟

200
00:12:08,650 --> 00:12:12,380
.على الأرجح أنّ الهاربين قد غادروا الجزيرة الآن

201
00:12:12,380 --> 00:12:13,750
.لقد سبحوا

202
00:12:14,300 --> 00:12:15,990
ماذا تعني؟

203
00:12:16,520 --> 00:12:21,910
لقد حسبتُ أين يمكن أن ينتهي بهم المطاف
.إن سبحوا وفقًا لتيّارات المدّ والجزر

204
00:12:22,670 --> 00:12:26,060
إنّ التيارات قادرة على دفع المرء مباشرة
.إلى ذلك المستودع الّذي أخبرك عن المخبر

205
00:12:27,000 --> 00:12:29,550
قال أنّ للأمر علاقة بالأنثيم، صحيح؟

206
00:12:31,450 --> 00:12:39,840
إن كان محقًّا، فإنّ تلك الحاويات
.قد وُضعت هناك للسّماح للسّجناء بالهرب

207
00:12:40,480 --> 00:12:44,150
،قال فعلاً إنّ للأمر علاقة بالأنثيم
...لكن ألا نحتاج لأكثر من مجرّد

208
00:12:44,150 --> 00:12:45,290
.نعم، حدس

209
00:12:45,290 --> 00:12:46,200
!حدس؟

210
00:12:46,200 --> 00:12:49,280
.لكن كان هنالك شيء ما يزعجني

211
00:12:49,840 --> 00:12:50,940
.القردة

212
00:12:51,710 --> 00:12:52,620
القردة؟

213
00:12:52,620 --> 00:12:56,440
كانت هنالك قنّينات بلاستيكيّة مليئة
.بالماء في تلك الحاوية

214
00:12:57,550 --> 00:13:01,680
هل تستطيع القردة فتح قنّينة بلاستيكيّة؟

215
00:13:01,680 --> 00:13:05,170
.حسنًا، ربّما تستطيع

216
00:13:05,170 --> 00:13:07,020
لكن ما رأيك؟

217
00:13:07,020 --> 00:13:10,730
ربّما يمكنها ذلك؟

218
00:13:10,730 --> 00:13:12,590
.فهمت. لا تهتمّ للأمر إذًا

219
00:13:12,590 --> 00:13:15,850
!كلاّ، أنت على حقّ! الأمر غريب

220
00:13:15,850 --> 00:13:16,850
صحيح؟

221
00:13:18,020 --> 00:13:20,750
!هـ-هذا لا يعقل

222
00:13:21,340 --> 00:13:22,860
...مُفجّر

223
00:13:23,730 --> 00:13:25,230
!سارق

224
00:13:25,970 --> 00:13:28,290
!وهذا قاتل متسلسل

225
00:13:28,290 --> 00:13:32,040
!جميعهم مجرمون معروفون

226
00:13:32,570 --> 00:13:34,530
من هذا الشّخص؟

227
00:13:35,860 --> 00:13:38,650
،لكن إن كان هذا ما سأقابله في آخر يوم لي

228
00:13:38,650 --> 00:13:40,860
!هذا يعني أنّ الحظّ يقف إلى جانبي

229
00:13:40,860 --> 00:13:42,240
...هذه المرّة، سوف

230
00:13:42,240 --> 00:13:43,460
.سنعود للسّيّارة

231
00:13:43,460 --> 00:13:44,930
!سوف أعود إلى السّيّارة

232
00:13:45,820 --> 00:13:47,260
.هنري ليس هنا

233
00:13:48,610 --> 00:13:49,930
.هذا سيّئ

234
00:13:52,580 --> 00:13:55,850
لماذا سنتركهم هناك بهذه البساطة؟

235
00:13:56,130 --> 00:13:58,860
.اتّصلتُ بالمقرّ الرّئيسيّ للشّركة، فلا تقلق

236
00:13:58,860 --> 00:14:00,500
.سيتعاملون مع الوضع

237
00:14:00,500 --> 00:14:01,930
...لا، أعني

238
00:14:01,930 --> 00:14:04,320
.يقتصر عملنا على التّعامل مع حالات الأنثيم

239
00:14:04,680 --> 00:14:06,920
أعطيني الطّرق الّتي تسلكها سيّارات
.الإسعاف إلى المستشفى

240
00:14:06,920 --> 00:14:09,590
يجب أن تكون إحداها تحمل
.المصابين في السّجن

241
00:14:09,590 --> 00:14:10,720
.عُلم

242
00:14:11,300 --> 00:14:14,700
على الأرجح أنّ هنري استعمل العصابة
،في المستودع كطُعم

243
00:14:14,700 --> 00:14:17,840
.واختار طريقًا أبسط ومضمونًا أكثر للهروب

244
00:14:20,870 --> 00:14:22,510
.آسف على إزعاجك

245
00:14:23,960 --> 00:14:26,290
.المصابون حرّاس بكلّ تأكيد

246
00:14:26,290 --> 00:14:29,670
.تحقّقتُ من هويّاتهم وطابقت بصماتهم

247
00:14:29,670 --> 00:14:34,400
،وطبعًا إن تحوّل هنري إلى شخص آخر
.فقد يفلت من قبضتنا

248
00:14:34,400 --> 00:14:36,570
المعذرة، هل يمكنني الذّهاب؟

249
00:14:36,570 --> 00:14:38,200
.أكيد، لا مشكلة

250
00:14:38,200 --> 00:14:39,050
.مهلاً

251
00:14:39,990 --> 00:14:41,810
.أنت رجل وسيم

252
00:14:42,480 --> 00:14:44,730
مع من أنت؟ في أيّ دائرة؟

253
00:14:44,730 --> 00:14:46,090
.أعطني هويّتك

254
00:14:46,090 --> 00:14:47,160
—مـ-مـ-مهلاً

255
00:14:47,160 --> 00:14:48,780
ما خطبكما؟

256
00:14:48,780 --> 00:14:51,450
،إن لم تكن لديك واحدة
فهلاّ سمحت لي برؤية ياقتك؟

257
00:14:54,880 --> 00:14:55,900
!انتظر

258
00:14:55,900 --> 00:14:56,770
.لنتبعه

259
00:14:59,360 --> 00:15:03,010
يتّجه المُدان الهارب جنوبًا
.على طريق غرب ماغنالوبوس

260
00:15:03,010 --> 00:15:04,080
.أطلب الدّعم

261
00:15:04,080 --> 00:15:06,180
ما الّذي يحدث؟

262
00:15:06,180 --> 00:15:07,500
.استياق مفرط

263
00:15:07,500 --> 00:15:12,120
تعرّض هنري لاستياق مفرط ناجم عن
.أنثيم للحصول على ذلك الوجه الوسيم

264
00:15:12,120 --> 00:15:14,440
!ذلك السّائق هو هنري؟

265
00:15:14,440 --> 00:15:16,300
!لا أفهم أيّ شيء

266
00:15:16,300 --> 00:15:18,350
،بما أنّ هنري يبدو كشخص آخر

267
00:15:18,350 --> 00:15:21,820
.فكّر في أأمن طريقة ممكنة للهروب من السّجن

268
00:15:23,180 --> 00:15:25,510
!وسيم

269
00:15:33,360 --> 00:15:33,940
!سُحقًا

270
00:15:53,270 --> 00:15:54,470
!أوقف السّيّارة! أوقف السّيّارة

271
00:15:54,470 --> 00:15:57,830
.يتلاعب الأنثيم بالمجين البشريّ

272
00:15:57,830 --> 00:16:00,960
.لذلك يستطيع أحيانًا إظهار تطوّر سريع

273
00:16:00,960 --> 00:16:02,270
.ذلك هو الاستياق المفرط

274
00:16:02,270 --> 00:16:03,680
تقوم بالشّرح؟ الآن؟

275
00:16:07,030 --> 00:16:08,460
.سنتحركّ بسرعة أكبر

276
00:16:23,670 --> 00:16:29,050
يمكننا أن نفترض أنّ الوجه الوسيم الّذي حصل
.عليه كان يفترض أن يمنحه أفضليّة ثوريّة

277
00:16:29,050 --> 00:16:30,680
!ماذا؟! ماذا؟

278
00:16:47,850 --> 00:16:52,090
.بشكل مختصر، تمّ اختياره

279
00:16:53,540 --> 00:16:54,490
...لكن

280
00:16:54,490 --> 00:16:57,080
.يمكن للتّطوّر أن يكون غريبًا أحيانًا

281
00:16:58,620 --> 00:17:00,660
!أنقذوني

282
00:17:14,190 --> 00:17:15,850
.حان وقت دوائك

283
00:17:21,050 --> 00:17:22,130
أأنت بخير؟

284
00:17:23,010 --> 00:17:24,170
أهذه المستشفى؟

285
00:17:24,170 --> 00:17:26,310
.هنالك سيّارة إسعاف أخرى قادمة

286
00:17:26,310 --> 00:17:27,970
.ليأتي إلى هنا كلّ من يمكنه المشي

287
00:17:27,970 --> 00:17:29,700
.سأساعدك

288
00:17:30,320 --> 00:17:33,430
من يكون هذا الشّخص؟

289
00:17:36,540 --> 00:17:37,980
.سُحقًا

290
00:17:37,980 --> 00:17:40,450
.في النّهاية، اعتقلنا رجلاً واحدًا

291
00:17:40,450 --> 00:17:43,620
.وبالكاد قمت بأيّ عمل

292
00:17:43,620 --> 00:17:45,500
.لا تسمح لذلك بإحباطك

293
00:17:46,780 --> 00:17:48,250
.سأدعوك لاحتساء شراب

294
00:17:49,030 --> 00:17:53,540
!لماذا سمحت للرّجال في المستودع بالهرب؟

295
00:17:53,540 --> 00:17:54,840
ما زلت تفكّر بشأن ذلك، صحيح؟

296
00:17:55,230 --> 00:17:57,360
!بالطّبع ما زلت

297
00:17:57,360 --> 00:17:59,350
.كانت تلك فرصتي لأصبح بطلاً

298
00:17:59,350 --> 00:18:02,590
.يقتصر عملنا على التّعامل مع حالات الأنثيم

299
00:18:02,590 --> 00:18:03,420
.أخبرتك بذلك

300
00:18:03,420 --> 00:18:05,910
.ذلك مجرّد عذر للهرب

301
00:18:05,910 --> 00:18:07,590
.كنتَ خائفًا فحسب

302
00:18:07,590 --> 00:18:08,430
.ذلك جزء من الحقيقة

303
00:18:09,560 --> 00:18:12,020
.بالطّبع كنتُ خائفًا من أولئك الرّجال

304
00:18:12,470 --> 00:18:14,370
هل أنت هكذا دائمًا عندما تثمل؟

305
00:18:14,370 --> 00:18:16,980
...تمّ اعتقال كلّ المساجين الهاربين

306
00:18:16,260 --> 00:18:19,610
.اسمع، أنا لست مثلك

307
00:18:19,610 --> 00:18:22,050
!سأصبح بطلاً

308
00:18:22,050 --> 00:18:23,910
.لحوالي ربع ساعة فقط

309
00:18:24,820 --> 00:18:28,160
.يمكن لأيّ أحد أن يصبح بطلاً لحوالي ربع ساعة

310
00:18:29,310 --> 00:18:31,500
!سننتقل الآن لخبر البطل الكلب

311
00:18:31,500 --> 00:18:33,950
.وفي اليوم التّالي، ينساهم الجميع

312
00:18:37,500 --> 00:18:40,510
.لا أقول أنّ من الخطأ أن نكون أبطالاً

313
00:18:41,260 --> 00:18:45,000
.لكن... الأكثر دراماتيكيّة يموتون أوّلاً

314
00:18:46,940 --> 00:18:51,850
تعرّض أحد ضبّاطنا للخداع
.أثناء تحقيق سرّيّ له

315
00:18:53,080 --> 00:18:56,030
.هنالك شيء أريد تخليص العالم منه

316
00:18:57,730 --> 00:18:58,700
.مع السّلامة

317
00:19:05,600 --> 00:19:06,460
!دوغ

318
00:19:07,810 --> 00:19:11,000
تريد تخليص العالم من الأنثيم، صحيح؟

319
00:19:11,000 --> 00:19:13,390
!اسمح لي أن أساعدك

320
00:19:14,360 --> 00:19:16,550
.لن نتخلّص من الأنثيم أبدًا

321
00:19:16,550 --> 00:19:18,870
ووجود شخص آخر يحاول وضع حدّ
.لذلك لن يغيّر أيّ شيء

322
00:19:18,870 --> 00:19:22,580
،قد لا أكون قادرًا على أخذ مكان ديريك

323
00:19:22,580 --> 00:19:24,690
!لكنّني أعرف أنّ بإمكاني أن أكون مفيدًا أحيانًا

324
00:19:24,690 --> 00:19:28,300
لهذا السّبب أوصيتَ بي لأجل
هذه الوظيفة، صحيح؟

325
00:19:30,500 --> 00:19:33,780
!"دعني أكون شريكك في ثنائي "دوبل دكّر

326
00:19:36,010 --> 00:19:38,420
.لا تقل ذلك بصوت مرتفع

327
00:19:38,420 --> 00:19:39,580
.إنّه محرج

328
00:19:42,670 --> 00:19:45,260
.يبدو أنّك أسأت فهمي بطريقة ما

329
00:19:45,260 --> 00:19:49,130
.ليس الأنثيم ما أحاول تخليص العالم منه

330
00:19:50,120 --> 00:19:51,690
هل هو الجريمة إذًا؟

331
00:19:51,690 --> 00:19:52,680
.كلاّ

332
00:19:52,680 --> 00:19:54,610
ماذا إذًا؟

333
00:19:54,610 --> 00:19:56,060
!أخبرني

334
00:19:56,060 --> 00:19:59,480
ما الشّيء الّذي تريد تخليص العالم منه؟

335
00:19:59,720 --> 00:20:01,050
.إنّهما شيئان

336
00:20:01,050 --> 00:20:01,810
شيئان؟

337
00:20:02,510 --> 00:20:03,510
.الأوّل هو الفقر

338
00:20:03,860 --> 00:20:05,300
...الفقر

339
00:20:06,720 --> 00:20:08,180
.والثّاني هو الطّبقيّة

340
00:20:09,670 --> 00:20:12,930
.هذان هما الشّيئان اللّذان أريد تخليص العالم منهما

341
00:20:18,470 --> 00:20:21,290
...الفقر والطّبقيّة

342
00:20:23,360 --> 00:20:27,030
!مذهل. لديه طموحات مدهشة

343
00:20:30,560 --> 00:20:33,660
.وهكذا، انتهى أسبوعي

344
00:20:35,790 --> 00:20:38,450
،لم أحقّق أيّ شيء يُذكر

345
00:20:38,450 --> 00:20:40,040
.لذلك سأُطرد على الأرجح

346
00:20:40,040 --> 00:20:42,500
،يتمنّي جزء منّي لو أستطيع البقاء أكثر

347
00:20:42,500 --> 00:20:44,220
.لكنّني لا أشعر بأيّ ندم بطريقة ما

348
00:20:47,200 --> 00:20:48,360
أين دوغ؟

349
00:20:48,360 --> 00:20:51,170
.صحيح، لم أره اليوم

350
00:20:51,590 --> 00:20:52,790
.هكذا إذًا

351
00:20:52,790 --> 00:20:53,550
.نعم

352
00:20:54,060 --> 00:20:58,670
مجرّد مقابلة هذا الرّجل المدعوّ دوغ
.جعل المجيء إلى هنا يستحقّ ذلك

353
00:21:00,950 --> 00:21:02,790
.يا أوكابّا

354
00:21:03,200 --> 00:21:04,730
.ترافيس يناديك

355
00:21:05,630 --> 00:21:06,550
.حسنًا

356
00:21:07,360 --> 00:21:10,700
...كما أنّه يذكّرني أكثر من أيّ شيء آخر

357
00:21:11,250 --> 00:21:14,840
،أنّني لا أريد أن أكون بطلاً لربع ساعة فقط

358
00:21:15,320 --> 00:21:18,200
.بل بطلاً قادرًا على حماية أختي الكبرى

359
00:21:24,740 --> 00:21:26,220
ما هذا؟

360
00:21:26,220 --> 00:21:29,760
.إنّه زيّك الرّسميّ وما إلى ذلك

361
00:21:30,440 --> 00:21:33,470
.لكنّني بالكاد حقّقت أيّ شيء

362
00:21:36,380 --> 00:21:38,760
.نعم، معك حقّ

363
00:21:38,760 --> 00:21:41,900
.لكن... أعتقد أنّ لا بأس بذلك

364
00:21:42,600 --> 00:21:46,950
حدثت أمور كثيرة، وأعتقد أنّ لا بأس
.بذلك في نهاية المطاف

365
00:21:52,170 --> 00:21:56,030
سيعتقد النّاس على الأرجح أنّك فتاة
.إن واصلنا مناداتك أوكابّا

366
00:21:57,110 --> 00:21:58,340
...حسنًا

367
00:21:58,340 --> 00:22:01,850
،بما أنّ شعرك قصير من الخلف
!"فاسمك من الآن هو "كارياغي

368
00:22:02,650 --> 00:22:05,020
.تبدو رائعًا يا كارياغي

369
00:22:08,490 --> 00:22:11,690
،وأيضًا، كان لا بأس بذلك في نظر كيريل

370
00:22:11,970 --> 00:22:16,180
هذا لأنّه الآن عضو رسميّ في قوّات
!تحقيقات الجرائم الخاصّة

371
00:22:17,700 --> 00:22:24,360
وبالتّالي، أخذ خطوة أخرى
!في درب تحقيق حلمه ليصبح بطلاً

372
00:23:55,940 --> 00:23:59,720
!بدأ كيريل حياته الثّانية بصفته المحقّق كارياغي

373
00:23:59,720 --> 00:24:02,310
ولأوّل مرّة في حياته، يواجه كيريل
.احتمال دخوله في قصّة رومانسيّة

374
00:24:02,310 --> 00:24:04,400
!في الحقيقة، ربّما لن يحدث ذلك

375
00:24:04,400 --> 00:24:07,880
:"في الحلقة الثّالثة من "دوبل دكّر
!"ندّك هو شريك شريكك"

376
00:24:07,880 --> 00:24:09,100
!لا تفوّتوها