00:12:44,100 --> 00:12:45,890
!إنني أحاول مساعدتك

192
00:12:45,970 --> 00:12:49,940
يا لتفكيرك البدائي، أتظن أنني سأستسلم لك؟

193
00:12:50,020 --> 00:12:53,520
.لن أعترف بالهزيمة لأن هذه الحرب لن تنتهي

194
00:12:54,820 --> 00:12:58,440
هل نسيت أن ذاتي المستقبلية
.تستطيع مواصلة القتال

195
00:12:58,530 --> 00:13:01,860
أستطيع العبث بالزمن لأرجع وأهزمك
.في المعركة القادمة

196
00:13:01,950 --> 00:13:04,240
.الزمن إلى جانبي في هذا القتال

197
00:13:05,990 --> 00:13:09,710
.عزيمتي ستبقى راسخة، من المستحيل إيقافي

198
00:13:09,790 --> 00:13:12,540
.سيقف الزمن في صالحي دوماً

199
00:13:13,500 --> 00:13:16,170
.لن يسلم مني الـ"أفينجرز" أبداً

200
00:13:16,710 --> 00:13:18,710
.أظن أني سأراكَ لاحقاً، إذاً

201
00:13:33,230 --> 00:13:36,230
!"أعدك أنني لن أستسلم أبداً يا "توني ستارك

202
00:13:36,320 --> 00:13:38,570
!المعركة التي بيننا لا تزال في بدايتها

203
00:13:38,650 --> 00:13:41,780
!سترى، سوف نلتقي مجدداً

204
00:13:50,450 --> 00:13:54,420
يبدو لنا أن حقبة "كونكيرور كانغ" الإرهابية
.على المدينة قد وصلت إلى نهايتها

205
00:13:54,500 --> 00:13:58,920
واستجابة لذلك المسؤولون والسكان السابقون
.قد عادوا إلى عملية إعادة البناء

206
00:13:59,000 --> 00:14:02,090
وعقب ما يحدث، علينا توجيه الشكر
."إلى الـ"أفينجرز

207
00:14:02,170 --> 00:14:03,930
...فريق الأبطال الخارقين

208
00:14:04,010 --> 00:14:07,510
ما الذي سنفعله تالياً؟
.الجلوس يصيبني بالملل الشديد

209
00:14:07,600 --> 00:14:12,350
،ستجد شيئاً لتقوم به بنفسك
.الأشخاص المملين هم من يصابون بالملل

210
00:14:12,430 --> 00:14:13,810
.هذا لا يساعدني إطلاقاً

211
00:14:13,890 --> 00:14:16,560
.بدلاً من التذمر، عليك أن تشعر بالامتنان

212
00:14:16,650 --> 00:14:19,320
نعم، وعليك أن تعطي جسدك وعقلك
.بعض الوقت للتعافي

213
00:14:20,280 --> 00:14:22,400
لوكي"! أين "لوكي"؟"

214
00:14:22,490 --> 00:14:24,610
.لقد رأيته للتو في الغرفة الأخرى

215
00:14:24,700 --> 00:14:26,320
.لقد بحثت عنه في كل مكان

216
00:14:26,410 --> 00:14:27,780
.تريث

217
00:14:27,870 --> 00:14:30,120
.لقد غادر، وهذا لا يبشر بالخير

218
00:14:39,300 --> 00:14:40,420
،إنه مسبب للمشاكل

219
00:14:40,500 --> 00:14:44,470
،وأنا المسؤول عن الحفاظ على سلامته
!وحفظ سلامة الجميع منه

220
00:14:44,550 --> 00:14:46,300
أأنت الحارس على أخيك؟

221
00:14:46,800 --> 00:14:48,220
.نعم، أنا كذلك

222
00:14:51,470 --> 00:14:54,060
.إنها مهمتي دائماً وأبداً

223
00:14:54,140 --> 00:14:55,600
هذا هو العبء الملقى على عاتقي

224
00:14:59,230 --> 00:15:00,570
أين "برونو"؟

225
00:15:14,960 --> 00:15:16,330
.ها أنت ذا

226
00:15:18,250 --> 00:15:19,540
.سعيد أنني وجدتك

227
00:15:19,630 --> 00:15:20,960
لماذا؟ ما الذي تريده؟

228
00:15:21,050 --> 00:15:22,090
.لا شيء

229
00:15:24,170 --> 00:15:26,760
إذاً ما الذي أتى بك إلى السطح؟

230
00:15:28,300 --> 00:15:30,800
أردت أن ألقي نظرة على المدينة
.التي قمنا بإنقاذها

231
00:15:32,010 --> 00:15:33,640
.يا له من منظر بديع

232
00:15:33,720 --> 00:15:36,850
."تدربنا كل يوم لنصبح أحد الـ"أفينجرز

233
00:15:36,940 --> 00:15:38,900
،لم أبذل هذا الجهد من قبل

234
00:15:38,980 --> 00:15:41,650
.كي أتعلم كيف أحمي هذا المكان وسكانه

235
00:15:41,730 --> 00:15:43,190
،عندما تنظر للأمر هكذا

236
00:15:43,280 --> 00:15:45,690
أظن أننا استحقينا هذه العطلة، أليس كذلك؟

237
00:15:45,780 --> 00:15:49,660
ولكن عندما نعود للتدريب
.أريد تعلم كيفية العبث بالزمن

238
00:15:51,780 --> 00:15:52,950
."برونو"

239
00:15:53,580 --> 00:15:54,580
ما الخطب؟

240
00:15:56,120 --> 00:15:57,750
هل سنتمكن من السير على خطاهم؟

241
00:15:59,170 --> 00:16:01,670
هل هذا ما يجعلك حزيناً ومكتئباً؟

242
00:16:01,750 --> 00:16:03,340
.لا تكترث لهذا

243
00:16:03,420 --> 00:16:06,420
سنتمكن بسهولة
.من السير على خُطى الأبطال الخارقين

244
00:16:06,510 --> 00:16:07,720
،كنا رائعين لحد الآن

245
00:16:07,800 --> 00:16:10,180
.وفي المستقبل سنكون عظيمين كلياً

246
00:16:10,260 --> 00:16:11,430
.ربما أنتَ على حق

247
00:16:11,510 --> 00:16:14,640
ما الذي تعني بـ"ربما"؟
ألا تؤمن بما نستطيع فعله؟

248
00:16:15,390 --> 00:16:18,270
."لطالما حظيت بتفكير إيجابي يا "ماكوتو

249
00:16:19,100 --> 00:16:21,980
.تمسك بهذه الخصلة، إنها أحد أعظم نقاط قوتك

250
00:16:23,020 --> 00:16:26,530
،إنني أحسدك
.أتمنى لو أمكنني التفكير بهذه الطريقة

251
00:16:27,900 --> 00:16:29,910
.ولكن عليّ تقبل ما أنا عليه

252
00:16:31,030 --> 00:16:34,330
ربما هذا التحدي الذي عليّ أن أواجهه
."كأحد الـ"فيوتشر أفينجرز

253
00:16:35,540 --> 00:16:36,540
."برونو"

254
00:16:37,200 --> 00:16:40,120
.جهاز التنقل الآلي هذا يثبت كفاءته

255
00:16:40,250 --> 00:16:44,130
لقد مكنني من التسلل
.إلى أكثر أبنية العالم أمناً

256
00:16:44,750 --> 00:16:46,800
،والآن، لنرى ماذا لدينا هنا

257
00:16:46,880 --> 00:16:50,340
على أيّ من هذين المزعجين مسببي المشاكل
سوف أقضي أولاً؟

258
00:16:50,430 --> 00:16:54,140
...سيقع اختياري على

259
00:16:56,430 --> 00:16:58,640
.أنت ترى الجانب المشرق في أيّ شيء

260
00:16:58,730 --> 00:16:59,890
،عندما نعمل سوياً

261
00:16:59,980 --> 00:17:02,150
.تجعلني أرغب في رؤية الأمور من منظورك

262
00:17:03,230 --> 00:17:05,360
لم لا نتفق على أن نبقى إيجابيين؟

263
00:17:05,440 --> 00:17:07,320
،وبينما نكبر ونزداد قوة

264
00:17:07,400 --> 00:17:10,570
لنقطع وعدأ لبعضنا
.أننا لن نسأم من هذا العالم

265
00:17:11,360 --> 00:17:13,950
ما رأيك بهذا يا "ماكوتو"؟ هل اتفقنا؟

266
00:17:31,930 --> 00:17:33,340
.محاولة جيدة

267
00:17:34,550 --> 00:17:35,680
!أنت

268
00:17:47,980 --> 00:17:49,280
!"وينتر سولدجير"

269
00:17:50,610 --> 00:17:54,490
،أنتما الاثنان تملكان رابطة مميزة
.لذا احرصا على إبقاء صداقتكما قوية

270
00:17:56,200 --> 00:17:59,580
،توجب عليّ الهرب من ماضيّ
.وانتهى بي المطاف وحيداً دوماً

271
00:18:01,290 --> 00:18:02,660
،ولكن خذوا بنصيحتي

272
00:18:02,870 --> 00:18:06,000
امتلاك الأصدقاء
.هي قوة أعظم من أيّ قدرة خارقة

273
00:18:08,920 --> 00:18:10,090
."برونو"

274
00:18:11,590 --> 00:18:13,630
.وينتر سولدجير" محق"

275
00:18:13,720 --> 00:18:15,840
.تكلمت مع "كابتن" بخصوص ذلك، وقد وافق

276
00:18:15,930 --> 00:18:19,060
،أنا وأنتَ سنشكل فريقاً، وسنبقى سوياً
أهذا مفهوم؟

277
00:18:19,140 --> 00:18:21,810
!ولا تضحك عليّ بسبب مشاعري الجياشة

278
00:18:26,110 --> 00:18:27,980
ما الذي تتفوه به؟

279
00:18:28,070 --> 00:18:31,110
.تبدوا سخيفاً، أوقف هذا

280
00:18:31,190 --> 00:18:32,900
!لكنني لا أستطيع

281
00:18:43,330 --> 00:18:45,290
."حسناً يا "ماكوتو

282
00:18:46,880 --> 00:18:49,130
هل سنبقى سوياً كفريق واحد؟

283
00:18:50,170 --> 00:18:51,260
.أجل

284
00:18:52,210 --> 00:18:54,050
هل تعدني بذلك؟

285
00:18:54,130 --> 00:18:55,380
.أعدك

286
00:19:27,120 --> 00:19:28,880
.لديّ أخبار مهمة

287
00:19:28,960 --> 00:19:33,380
الكريستالة الزمردية
متواجدة في العالم العلويّ

288
00:19:33,460 --> 00:19:36,260
"أعتقد أن الـ"أفينجرز
.قاموا بنقلها أو تدميرها

289
00:19:36,340 --> 00:19:38,680
.إنها لا تشكل تهديداً في الوقت الحالي

290
00:19:38,760 --> 00:19:42,060
ومن غير الواضح
،إن كان هؤلاء البشر على علم بطبيعتها

291
00:19:42,140 --> 00:19:45,930
ولكن حين يأتي الوقت
.سوف يتم اكتشاف القوة الحقيقية للكريستالة

292
00:19:47,980 --> 00:19:49,560
ما الذي علينا فعله؟

293
00:19:49,650 --> 00:19:52,400
"لا استطيع جزم إن كان الـ"أفينجرز
...سيصبحون أصدقاء لنا

294
00:19:53,900 --> 00:19:55,320
.أم أعداء لنا

295
00:20:00,870 --> 00:20:02,330
تفحصوا هذا يا رفاق؟

296
00:20:02,410 --> 00:20:04,750
ما رأيكم باللون الجديد لدرعي؟

297
00:20:04,830 --> 00:20:05,950
أليس رائعاً؟

298
00:20:06,040 --> 00:20:08,920
.بدلته تبدو مشابهة تماما لبدلتي

299
00:20:09,000 --> 00:20:10,000
.نحن لسنا توأم

300
00:20:10,080 --> 00:20:13,090
،هو محق
ولماذا "برونو" يحصل على بدلة جديدة؟

301
00:20:13,170 --> 00:20:16,470
.أخبرني "برونو" أن بدلته القديمة لم تعجبه

302
00:20:16,550 --> 00:20:18,630
بالإضافة إلى أنني عضو دائم في الفريق الآن

303
00:20:19,550 --> 00:20:22,220
.تمهلوا، لا أتذكر أنني وافقت على هذا الجزء

304
00:20:22,300 --> 00:20:24,930
.لا تقلق، يا "برونو" أنتَ تبدو رائعاً

305
00:20:25,020 --> 00:20:26,020
.شكراً لكِ

306
00:20:26,100 --> 00:20:29,020
.أظن أنها محقة، تبدوا رائعاً

307
00:20:29,100 --> 00:20:30,810
.حسناً، تبدو البدلة جيدة

308
00:20:30,900 --> 00:20:34,480
،ولكن ينقصك شيء واحد
ما هو لقبك كأحد الـ"فيوتشر أفينجرز"؟

309
00:20:34,570 --> 00:20:37,360
.هو محق، أنت تحتاج لاسم بطولي لمهامك

310
00:20:37,440 --> 00:20:38,450
.أجل

311
00:20:38,530 --> 00:20:40,240
أسم بطولي؟

312
00:20:40,320 --> 00:20:41,950
حسناً، من لديه اقتراحات؟

313
00:20:42,030 --> 00:20:43,080
.أنا أعرف

314
00:20:43,160 --> 00:20:45,290
اسمك هو برونو، ما رأيك بـ"برونو مان"؟

315
00:20:45,370 --> 00:20:46,540
.كلا

316
00:20:46,620 --> 00:20:47,870
ماذا عن "عين الشرير"؟

317
00:20:47,960 --> 00:20:49,920
.شرير؟ يبدو هذا شريراً

318
00:20:50,750 --> 00:20:52,040
.إنه قرار صعب

319
00:20:54,130 --> 00:20:55,960
ماذا لديك يا "ماكوتو"؟

320
00:20:56,550 --> 00:20:57,760
حقاً؟

321
00:20:58,970 --> 00:21:00,510
.لنرى

322
00:21:01,390 --> 00:21:03,430
ما رأيك بـ"تويستر"؟

323
00:21:04,010 --> 00:21:05,310
تويستر"؟"

324
00:21:06,350 --> 00:21:08,520
.ليس سيئاً، ربما سأختاره

325
00:21:08,600 --> 00:21:12,690
هل أنت واثق بأنه أعجبك؟ هل تجده رائعاً؟

326
00:21:12,770 --> 00:21:14,230
.بالطبع إنه رائع

327
00:21:14,310 --> 00:21:16,820
ما الذي قد يكون أروع من "تويستر"؟ -
.صحيح -

328
00:21:16,900 --> 00:21:19,650
ولكن إن خرجت عن السيطرة
"سندعوكَ بـ"الدوران المغفل

329
00:21:27,950 --> 00:21:29,200
،"هوريكين"

330
00:21:29,290 --> 00:21:31,160
،"كوديك"

331
00:21:31,250 --> 00:21:33,210
،"شوريد"

332
00:21:33,290 --> 00:21:34,790
،"تويستر"

333
00:21:34,880 --> 00:21:36,170
هل أنتم جاهزون؟

334
00:21:38,590 --> 00:21:39,840
..."فيوتشر أفينجرز"

335
00:21:41,090 --> 00:21:42,720
!اجتمعوا

336
00:21:53,400 --> 00:21:55,770
(أفينجرز)"

337
00:22:01,030 --> 00:22:03,320
(أفينجرز)

338
00:22:08,040 --> 00:22:10,870
(فيوتشر أفينجرز)

339
00:22:16,080 --> 00:22:18,460
(أفينجرز)

340
00:22:23,840 --> 00:22:26,350
(أفينجرز)

341
00:22:26,430 --> 00:22:29,430
(فيوتشر أفينجرز)

342
00:22:34,690 --> 00:22:37,060
(أفينجرز)

343
00:22:41,570 --> 00:22:44,910
"(فيوتشر أفينجرز)

344
00:22:50,040 --> 00:22:53,460
الـ"أفينجرز" و"ماكوتو" نجحوا بهزيمة
.كونكيرور كانغ"، في نهاية المطاف"

345
00:22:53,540 --> 00:22:57,250
،بعد كل الجهد الذي بذلوه
.استحق أبطالنا القليل من الراحة

346
00:22:57,330 --> 00:22:58,540
.ليس بهذه السرعة

347
00:22:58,630 --> 00:23:01,590
،إن كنت تعتقد أنه هناك وقت للراحة
.فأنت مخطئ كلياً

348
00:23:01,670 --> 00:23:04,260
.هناك عدو جديد يدب الزعر في المدينة

349
00:23:04,340 --> 00:23:06,550
اسمه هو..."فيسكو"؟

350
00:23:06,640 --> 00:23:09,550
ماذا حصل مع مخلوق "توني" الأخضر اللطيف؟

351
00:23:09,640 --> 00:23:12,270
في الحلقة القادمة من
."مارفل فيوتشر أفينجرز"

352
00:23:12,350 --> 00:23:13,730
."فيسكو المتمرد"

353
00:23:13,810 --> 00:23:14,810
.معاً نحو المستقبل