274
00:19:15,400 --> 00:19:16,410
."كلوي"

275
00:19:17,320 --> 00:19:19,950
.طفلة حمقاء تتدخل في خططي

276
00:19:22,580 --> 00:19:23,950
.لقد انتهى الأمر

277
00:19:25,580 --> 00:19:26,580
!المدفع الشعاعي

278
00:19:27,330 --> 00:19:28,960
كلوي"، هل أنت بخير؟"

279
00:19:31,170 --> 00:19:32,340
