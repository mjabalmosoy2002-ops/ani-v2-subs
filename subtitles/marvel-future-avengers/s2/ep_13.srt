1
00:00:05,300 --> 00:00:07,340
.كل ما أردته هو أن أكون بطلاً

2
00:00:07,720 --> 00:00:09,010
.هذا فقط

3
00:00:09,090 --> 00:00:11,510
.إنه حلمي الوحيد

4
00:00:11,590 --> 00:00:14,100
وقد أكتشفت منذ فترة أنني مجرد

5
00:00:14,180 --> 00:00:16,220
،بيدقاً في منظمة من الأشرار

6
00:00:16,310 --> 00:00:18,180
.لكن هذا لم يُنسيني حلمي

7
00:00:18,270 --> 00:00:22,400
.ثم أحبطني الأبطال الذين طالما كانوا قدوتي

8
00:00:22,480 --> 00:00:23,480
.وهذا أغضبني

9
00:00:23,570 --> 00:00:25,570
.لكنّه لم يثني عزيمتي

10
00:00:25,650 --> 00:00:27,820
.أن أكون بطلاً هو هدف حياتي

11
00:00:32,320 --> 00:00:34,240
.وكل هذا قادني إلى هذه اللّحظة

12
00:00:34,330 --> 00:00:35,580
.لنفعل ذلك

13
00:01:08,440 --> 00:01:11,320
.لم يعد يهمّني أن أستولي على العرش

14
00:01:11,400 --> 00:01:15,240
"لكنني لن أتوقّف حتى يغدوا "بلاك بولت
.مجرّد ذكرى سيئة

15
00:01:15,990 --> 00:01:18,120
."إنّه أعلى برج الـ"أفينجرز

16
00:01:21,830 --> 00:01:25,040
.سنهِزمه مهما كلّف الأمر

17
00:01:25,130 --> 00:01:28,250
.ولن نرحم أي شخص يقف في طريقنا

18
00:01:42,310 --> 00:01:43,850
.كما تريد

19
00:01:48,230 --> 00:01:49,690
."ضربة فلاش"

20
00:01:57,700 --> 00:01:58,830
.دعي هذا لي

21
00:01:58,910 --> 00:01:59,910
.دمرهم

22
00:01:59,990 --> 00:02:01,000
.لكِ هذا

23
00:02:11,260 --> 00:02:13,130
.هذه الأشياء مزعجة

24
00:02:17,640 --> 00:02:19,720
.إنها تُهاجمني من كِلا الاتجاهين

25
00:02:24,440 --> 00:02:25,560
.ها نحن ذا

26
00:02:27,270 --> 00:02:28,440
.سأبتعد من هنا

27
00:02:33,780 --> 00:02:35,610
.هكذا تتمّ الأمور

28
00:02:35,700 --> 00:02:38,160
.من الأفضل التفكير مليّاً قبل العبث معي

29
00:02:40,790 --> 00:02:42,910
.المزيد منهم؟ بحقّك

30
00:02:51,300 --> 00:02:53,380
.اهجموا

31
00:03:01,760 --> 00:03:03,180
.يا له من منظر

32
00:03:03,270 --> 00:03:05,850
ليسوا أشخاصاً لبقين، أليس كذلك؟

33
00:03:05,940 --> 00:03:07,730
.نستطيع تولّي أمرهم

34
00:03:07,810 --> 00:03:10,020
،يؤسِفُني أنّ الأمور وصلت إلى هنا

35
00:03:10,110 --> 00:03:13,030
،لكن يسرّني أننا نواجهها سويّاً
.جنباً إلى جنب

36
00:03:23,950 --> 00:03:26,290
.أسلوب مذهل

37
00:03:26,370 --> 00:03:28,630
بعد انتهاء المعركة، ما رأيك أن تريني

38
00:03:28,710 --> 00:03:30,670
بعض حركاتك المميزة؟

39
00:03:31,290 --> 00:03:32,880
.سيسعدني هذا

40
00:03:34,550 --> 00:03:35,630
.والآن الجولة الثانية

41
00:03:36,800 --> 00:03:38,720
."القبضة المشعّة"

42
00:03:39,720 --> 00:03:41,220
."التأثير العنيف"

43
00:03:44,810 --> 00:03:46,640
.إنّهم لا ينتهون

44
00:03:46,730 --> 00:03:47,730
ماذا كنت تتوقع؟

45
00:03:47,810 --> 00:03:48,940
.أعِد التلقيم واستعدّ

46
00:03:49,020 --> 00:03:50,020
.أنا مستعدّ دوماً

47
00:03:56,110 --> 00:03:57,320
.تصويب جميل

48
00:03:57,400 --> 00:03:59,320
.سننتهي منهم قريباً

49
00:04:00,700 --> 00:04:01,820
.سأنهي هذا

50
00:04:06,660 --> 00:04:07,830
.هذا ليس جيداً

51
00:04:08,580 --> 00:04:09,620
.بالطبع

52
00:04:09,710 --> 00:04:10,750
هل لديك أي فكرة؟

53
00:04:11,380 --> 00:04:12,380
.نُقاتل حتى ننجو

54
00:04:21,050 --> 00:04:22,260
.قنّاص

55
00:04:22,350 --> 00:04:23,350
أجل، لكن من هو؟

56
00:04:45,410 --> 00:04:47,450
.لا تقف متفرجاً وافعل شيء ما

57
00:04:47,540 --> 00:04:49,620
.شكراً، أنا مَدِينٌ لك

58
00:05:00,550 --> 00:05:02,680
."تحطيم هالك"

59
00:05:14,020 --> 00:05:15,440
كيف تسير الأمور، جلالتُك؟

60
00:05:16,190 --> 00:05:17,650
،أتَعلَم، عندما تنتهي المعركة

61
00:05:17,730 --> 00:05:19,530
كنت أفكّر في أخذ إجازة

62
00:05:19,610 --> 00:05:20,650
.لأخذ قسطٍ من الراحة

63
00:05:20,740 --> 00:05:23,160
.وقد سمعت أن "واكاندا" جميلة في هذا الوقت

64
00:05:23,240 --> 00:05:24,740
أيمكنك تأمين رحلة لعنكبوت؟

65
00:05:24,820 --> 00:05:25,910
.أشكّ في ذلك

66
00:05:26,160 --> 00:05:27,580
.جديّ دوماً كالعادة

67
00:05:30,040 --> 00:05:33,750
."الموجة المتحرّكة"

68
00:05:35,630 --> 00:05:37,960
."ضربة البرق"

69
00:05:41,800 --> 00:05:43,010
.انصتوا جيداً

70
00:05:43,090 --> 00:05:45,720
...هذا البرج تحت حماية "ثور" و

71
00:05:45,800 --> 00:05:48,310
."غورغون"، محارب "أتيلان"

72
00:05:48,390 --> 00:05:49,970
.وأقترح أن تتراجعوا

73
00:05:51,060 --> 00:05:53,020
،لكن إن لم تصدقوا ما يُقال عنّا

74
00:05:53,100 --> 00:05:54,480
.فهاجِمونا بكل ما لديكم

75
00:05:54,560 --> 00:05:56,900
.أشفَقُ على كل من سيفعل ذلك

76
00:05:56,980 --> 00:05:58,570
.لن نرحمهم

77
00:05:58,650 --> 00:06:00,610
."إليك "لسعة واسب

78
00:06:08,200 --> 00:06:10,330
.أخيراً، لقد انتهوا

79
00:06:10,410 --> 00:06:11,450
.اتبعوني

80
00:06:11,540 --> 00:06:13,410
.من هنا، بسرعة

81
00:06:13,620 --> 00:06:14,620
شكراً لكٍ

82
00:06:14,710 --> 00:06:15,790
.شكراً على إنقاذنا

83
00:06:17,380 --> 00:06:20,000
.أرجوا أن نكون قد أخرجنا الجميع

84
00:06:23,470 --> 00:06:26,800
."هذا كلّه ذنب أولئك "المتطورين

85
00:06:35,940 --> 00:06:37,310
.ستدفع ثمن هذا

86
00:06:46,860 --> 00:06:47,910
ماذا؟

87
00:06:47,990 --> 00:06:49,080
لكن لماذا؟

88
00:06:49,910 --> 00:06:51,160
.ليس بهذه السرعة

89
00:07:00,130 --> 00:07:02,260
.لا يمكنك الاستمرار بهذا

90
00:07:02,340 --> 00:07:04,470
،إن لم تمنح جسدك فرصة للتعافي

91
00:07:04,550 --> 00:07:05,590
.قد يقتلك هذا

92
00:07:06,050 --> 00:07:08,090
.الآن عُدْ وخذ قسطاً من الراحة في البرج

93
00:07:08,180 --> 00:07:09,850
.هناك أناس يعتمدون عليك

94
00:07:11,430 --> 00:07:15,520
أليس من 'المتطورين"؟

95
00:07:18,810 --> 00:07:20,360
.كما توقعت

96
00:07:20,440 --> 00:07:22,980
.لكن هذا لا يهم، فقد صمد وأنقذ حياتنا

97
00:07:23,070 --> 00:07:24,780
.لا يمكننا شكرك كفايةً، يا سيّدي

98
00:07:24,860 --> 00:07:26,530
."دعنا نوصلك إلى برج الـ"أفينجرز

99
00:07:28,570 --> 00:07:30,030
.هذا أقلّ ما يمكننا فعله

100
00:07:32,910 --> 00:07:34,040
.حسناً، هيا بنا

101
00:07:34,120 --> 00:07:35,200
.من هنا

102
00:07:41,210 --> 00:07:43,000
.هيا، يا "كلوي". اسحبي بقوّة أكبر

103
00:07:43,090 --> 00:07:46,880
لن نستطيع العودة إلى الأرض إن لم
.نُخرِج هذا المفتاح

104
00:07:52,050 --> 00:07:54,220
.كان هذا جميلاً

105
00:07:54,310 --> 00:07:56,020
،أعلم أنّكما تودّان المساعدة

106
00:07:56,100 --> 00:07:59,150
.لكن قد تكون الأمور بخير حتى لو لم نذهب

107
00:07:59,230 --> 00:08:01,060
.أجل، لكن هذا غير مضمون

108
00:08:01,150 --> 00:08:03,860
استخدمتُ "فيسكو" لمحاولة الاتصال
،بالآخرين منذ ساعة

109
00:08:03,940 --> 00:08:05,820
.لكن لا أحد يجيب

110
00:08:05,900 --> 00:08:08,650
لا يمكننا البقاء دون عمل
.بينما جميع الآخرين يقاتلون

111
00:08:08,740 --> 00:08:09,820
.ليس بتصرّفٍ صحيح

112
00:08:09,910 --> 00:08:11,320
،هذه معركة الأرض الأخيرة

113
00:08:11,410 --> 00:08:13,200
...وعدم مشاركتنا بها

114
00:08:13,280 --> 00:08:14,620
.غير ممكن

115
00:08:21,210 --> 00:08:22,420
ما الأمر؟

116
00:08:30,260 --> 00:08:32,090
."أحسنت، يا "لوكجو

117
00:08:36,270 --> 00:08:38,060
."لوكجو"

118
00:08:38,520 --> 00:08:40,350
.اصمد يا عزيزي

119
00:08:40,440 --> 00:08:43,150
.هيا، عليكَ إعادتنا إلى الأرض

120
00:08:43,230 --> 00:08:45,900
.أرجوك، يا "لوكجو"، إننا بحاجتك

121
00:08:45,980 --> 00:08:48,190
.أنتِ أيضاً، يا "كريستال". فلنتحرّك

122
00:08:48,280 --> 00:08:49,490
.ليس لدينا وقت لنضيّعه

123
00:08:49,570 --> 00:08:51,530
... لست متأكّدة إذا

124
00:08:51,610 --> 00:08:53,120
.لا، اذهبي معهم

125
00:08:53,200 --> 00:08:54,200
...ماذا عنكِ

126
00:08:55,160 --> 00:08:57,450
.سأكون بخير هنا لوحدي

127
00:08:57,540 --> 00:09:01,710
،"وجدتِ أصدقاء نادرين، يا "كريستال
.وهم بحاجتك

128
00:09:02,460 --> 00:09:03,460
.حسناً

129
00:09:13,800 --> 00:09:15,510
."أنتَ الأفضل، يا "لوكجو

130
00:09:15,600 --> 00:09:17,640
.أين العدو؟ سأقضي عليه

131
00:09:17,720 --> 00:09:19,430
.احذري مما تتمنّيه

132
00:09:23,310 --> 00:09:24,480
.سهل جداً

133
00:09:24,560 --> 00:09:25,570
.لنفعل هذا

134
00:09:25,650 --> 00:09:27,900
!صحيح. "فيوتشر أفينجرز"، تجمّعوا

135
00:09:27,980 --> 00:09:30,240
.لقد سرقتي جملتي، هذا ليس عادلاً

136
00:09:30,320 --> 00:09:33,410
بالإضافة لذلك، أنتِ لستِ عضواً
.في الـ"فيوتشر أفينجرز" بَعد

137
00:09:33,490 --> 00:09:34,530
.عذراً

138
00:09:34,620 --> 00:09:36,200
.أردتُ أن أقول تلك الجملة لمرّة

139
00:09:36,280 --> 00:09:38,830
.وأنا مثلك. لا أحصل على فرصة لأقولها

140
00:09:45,170 --> 00:09:47,590
"يبدو أن شخصاً ما يستعير بدلة "هالك باستر

141
00:09:47,670 --> 00:09:48,750
.بدون أذن مجدّداً

142
00:09:48,840 --> 00:09:49,960
.آسف لهذا

143
00:09:50,050 --> 00:09:51,220
.لم أستطِع طلبها منك

144
00:09:51,300 --> 00:09:52,720
كيف تسير الأمور عندَك؟

145
00:09:52,800 --> 00:09:54,840
.تبدو جيّدة. على وشك أن ننتهي

146
00:09:59,770 --> 00:10:00,810
كيف؟

147
00:10:00,890 --> 00:10:03,600
كيف يتمكن الأرضيّون من هزيمتنا
على كل جبهة؟

148
00:10:04,230 --> 00:10:05,480
."المدفع الشعاعيّ"

149
00:10:10,440 --> 00:10:11,860
.لقد اكتفيت منك

150
00:10:14,360 --> 00:10:15,910
أتودّ المناورة؟

151
00:10:15,990 --> 00:10:17,660
.لا، فقط شقّي لي طريقاً مباشراً

152
00:10:17,740 --> 00:10:19,200
."السيفَان الشعاعيّان"

153
00:10:28,880 --> 00:10:30,130
.حان وقت الاستسلام

154
00:10:30,210 --> 00:10:31,710
أَلديك راية بيضاء؟

155
00:10:36,140 --> 00:10:37,470
ما الذي يحصل؟

156
00:10:39,720 --> 00:10:41,430
.فرايدي"، أجيبيني"

157
00:10:41,520 --> 00:10:42,640
.جميع الأنظمة سليمة

158
00:10:42,730 --> 00:10:43,980
هل يمكنك التحققّ من هذا؟

159
00:10:49,360 --> 00:10:50,610
.تقرير النظام

160
00:10:50,730 --> 00:10:51,780
.جميع الأنظمة سليمة

161
00:10:54,570 --> 00:10:55,570
.مهلاً

162
00:10:55,660 --> 00:10:57,740
."انتقلي إلى النظام الذاتي، يا "فرايدي

163
00:11:08,380 --> 00:11:10,460
.لقد جعلني أتخيل الأمر بأكمله

164
00:11:25,390 --> 00:11:26,850
.نِلنا منك الآن

165
00:11:26,940 --> 00:11:28,810
."أيها الـ"أفينجرز"، أنا "هوريكين

166
00:11:28,900 --> 00:11:30,560
."أنا و"تويستر" نُطارد "ماكسيموس

167
00:11:30,650 --> 00:11:32,020
.نحن خلفه مباشرة

168
00:11:32,110 --> 00:11:34,530
."عُلِم هذا. لا تدعه يهرب، يا "هوريكين

169
00:11:34,610 --> 00:11:36,450
عجباً. أهذه أنتِ، يا "كلوي"؟

170
00:11:36,530 --> 00:11:37,700
عُدتي من القمر؟

171
00:11:37,780 --> 00:11:39,450
.أجل. و"كمالا" هنا أيضاً

172
00:11:39,530 --> 00:11:41,580
.نحن نعتمد عليكم يا رفاق، لا تخفقوا

173
00:11:41,660 --> 00:11:42,700
.لن نفعل

174
00:11:42,790 --> 00:11:44,290
.وفّروا الثرثرة لوقت لاحق

175
00:11:44,370 --> 00:11:45,410
."أمسكوا بـ"ماكسيموس

176
00:11:45,500 --> 00:11:46,870
.دَع الأمر لنا

177
00:11:46,960 --> 00:11:50,960
.لأحيطكم علماً، "ماكسيموس" لديه هجوم نفسي

178
00:11:51,040 --> 00:11:53,050
...هجوم ماذا؟ ما الذي تتحدث عنه

179
00:11:57,340 --> 00:12:01,010
،مهما كان شخصان قريبان من بعضهما

180
00:12:01,100 --> 00:12:05,310
.يمكن زرع بذرة العداء بينهما

181
00:12:07,140 --> 00:12:09,310
.أنتَ أعظم

182
00:12:09,520 --> 00:12:11,360
.أنتَ أقوى

183
00:12:13,150 --> 00:12:16,070
.حان وقت أن تحصل على الاحترام الذي تستحقه

184
00:12:24,410 --> 00:12:25,450
.هذه هي

185
00:12:25,540 --> 00:12:28,330
الآن أروني كيف ينتقل شخصان من كونهما أخوة

186
00:12:28,410 --> 00:12:29,920
.إلى تدمير بعضهما

187
00:12:43,890 --> 00:12:44,930
."كلا، يا "هوريكين

188
00:12:45,010 --> 00:12:47,480
."ذلك المسخ يحاول العبث بعقلك، يا "تويستر

189
00:12:47,560 --> 00:12:48,850
.لا تسمح له بذلك

190
00:12:48,930 --> 00:12:50,100
.كل هذا وَهْم

191
00:12:50,190 --> 00:12:51,230
.قاوِماه

192
00:12:51,310 --> 00:12:52,610
.ابقيا مركزين

193
00:12:52,690 --> 00:12:55,110
.المعركة في مخيّلتكما فقط

194
00:12:55,190 --> 00:12:57,860
.عليكما أن تكونا قويّان وتنتصران سويّةً

195
00:12:58,610 --> 00:13:00,740
.هذه ليست أول مرّة تُختَبر فيها صداقتكما

196
00:13:00,820 --> 00:13:02,820
.ولطالما تجاوزتما الأمر

197
00:13:02,910 --> 00:13:04,490
.أنتما أكثر قوّة معاً

198
00:13:04,580 --> 00:13:06,450
.ثقا ببعضكما الآن

199
00:13:06,990 --> 00:13:09,960
."أنتَ تعلم أنهم على حق، يا "ماكوتو

200
00:13:10,040 --> 00:13:12,120
."تجاوزت الكثير لتصل إلى هنا، يا "برونو

201
00:13:12,210 --> 00:13:13,330
.قاوِم

202
00:13:38,400 --> 00:13:39,900
مَن منّا الأقوى؟

203
00:13:40,030 --> 00:13:42,490
مَن منّا الأكثر قوة؟

204
00:13:43,490 --> 00:13:45,030
.هذا سؤال غبيّ

205
00:13:45,120 --> 00:13:47,910
.سبق وفكّرنا بهذا ووجدنا أنّه لا يهم

206
00:13:55,540 --> 00:13:58,880
أنا أُرسِل إحداثيات
