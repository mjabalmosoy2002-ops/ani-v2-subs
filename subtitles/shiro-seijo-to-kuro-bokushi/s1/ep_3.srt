1
00:00:09,570 --> 00:00:12,360
.بدأت تُمطر بغزارة أكثر الآن

2
00:00:12,870 --> 00:00:15,360
.أتساءل إن كانت ستتواصل هكذا حتّى اللّيل

3
00:00:15,930 --> 00:00:18,750
لم يعد أبيل بعد، صحيح؟

4
00:00:21,240 --> 00:00:23,040
.لديّ ما أخبركما به

5
00:00:23,360 --> 00:00:24,600
!تبلّلت بالكامل

6
00:00:24,600 --> 00:00:26,000
!ذلك واضح

7
00:00:32,140 --> 00:00:33,630
.يبدو أنّي مصاب بالحمّى

8
00:00:33,630 --> 00:00:35,960
!لا تقل ذلك وكأنّه لا شيء

9
00:00:35,960 --> 00:00:38,430
.هذا لأنّك تقوم بأشياء مثل النّوم أمام المدفئة

10
00:00:38,430 --> 00:00:40,540
،علينا القيام بخدماتنا الآن

11
00:00:40,540 --> 00:00:43,110
لكنّي سأكون قلقة قليلاً
.إن لم يوجد أحد للاعتناء بك

12
00:00:43,110 --> 00:00:46,470
.لا، لا. سأكون بخير وحدي

13
00:00:46,470 --> 00:00:48,360
.لستُ طفلاً كما تعلمان

14
00:00:48,360 --> 00:00:52,560
!ليس من الجيّد ترك شخص مريض وحده

15
00:00:52,560 --> 00:00:54,440
.صـ-صحيح

16
00:02:40,630 --> 00:02:42,280
أيّها القسّ لورنس؟

17
00:02:42,280 --> 00:02:45,260
أين هي سيّدتنا القدّيسة والقسّ أبيل؟

18
00:02:45,260 --> 00:02:46,420
...بخصوص ذلك

19
00:02:46,420 --> 00:02:51,200
.أصيب أبيل بالزّكام وقرّرت القدّيسة الاعتناء به

20
00:02:51,200 --> 00:02:52,190
ماذا؟

21
00:02:52,190 --> 00:02:53,640
وحدهما؟

22
00:02:53,640 --> 00:02:55,360
ألن تكون تلك مشكلة؟

23
00:02:55,360 --> 00:03:00,350
،أعددت لهما الغداء قبل حضوري إلى هنا
.وتركت لهما كتبًا لينشغلا بها

24
00:03:00,350 --> 00:03:03,360
.ذلك ليس ما يُقلقنا

25
00:03:05,870 --> 00:03:08,810
.أتساءل إن كانا يحسنان التّصرّف

26
00:03:08,810 --> 00:03:12,380
،على أبيل البقاء هادئًا لمصلحته
...لكنّ القدّيسة

27
00:03:12,380 --> 00:03:15,120
!سأعتني به

28
00:03:19,420 --> 00:03:20,650
أنا قلق؟

29
00:03:21,860 --> 00:03:24,760
كيف حال أبيل يا سيّدتي القدّيسة؟

30
00:03:28,770 --> 00:03:31,900
.هذا ليس وقورًا يا سيّدتي القدّيسة

31
00:03:32,800 --> 00:03:34,680
.استيقظي رجاءً

32
00:03:35,920 --> 00:03:37,440
...كعك مدوّر

33
00:03:38,520 --> 00:03:41,570
،بالتّفكير في الأمر
لم أقم بخبزها مؤخّرًا، صحيح؟

34
00:03:42,200 --> 00:03:43,820
...ومع ذلك

35
00:03:43,820 --> 00:03:47,320
.تبدو بلا حول ولا قوّة بالكامل في وضعها هذا

36
00:03:48,370 --> 00:03:49,830
قلق

37
00:03:55,060 --> 00:03:57,840
.لن يكون بقاؤها هكذا جيّدًا لصحّتها

38
00:03:57,840 --> 00:04:02,840
سيّدتي القدّيسة، هناك أعضاء
.من أتباع الكنيسة على مقربة

39
00:04:06,380 --> 00:04:07,840
هل يسألون عنّي؟

40
00:04:07,840 --> 00:04:09,000
.كذبت

41
00:04:09,530 --> 00:04:11,980
!ليست كدبة جيّدة

42
00:04:11,980 --> 00:04:15,110
.لا يسعني سوى ذلك في بعض الظّروف المعيّنة

43
00:04:15,110 --> 00:04:18,880
إذًا هل مسموح لي الكذب عندما
لا يسعني غلاّ ذلك؟

44
00:04:18,880 --> 00:04:20,110
هل يمكنني؟

45
00:04:20,110 --> 00:04:23,690
لست بارعة كفاية لتكذبي
يا سيّدتي القدّيسة، صحيح؟

46
00:04:27,050 --> 00:04:28,760
...لورن، أنت اليوم

47
00:04:29,860 --> 00:04:31,660
...تبدو

48
00:04:34,480 --> 00:04:35,960
.أكثر صرامة من المعتاد

49
00:04:37,800 --> 00:04:40,550
!أنا آسف! لم تكن تلك نيّتي

50
00:04:41,740 --> 00:04:44,470
هناك شيء غريب حيالي اليوم، صحيح؟

51
00:04:44,470 --> 00:04:46,790
لماذا تصرّفتُ هكذا مع القدّيسة؟

52
00:04:47,200 --> 00:04:49,400
هل يعقل أنّك مصاب بالزّكام أيضًا؟

53
00:04:49,400 --> 00:04:52,080
.لا يوجد أن خطب بصحّتي

54
00:04:52,080 --> 00:04:53,130
،على أيّ حال

55
00:04:53,130 --> 00:04:56,760
يمكنني أن أعدك أنّي لن أفعل
.أو أقول شيئًا كهذا ثانية

56
00:04:56,760 --> 00:04:59,350
هل أنت بخير بالفعل؟

57
00:04:59,350 --> 00:05:00,280
.نعم

58
00:05:02,400 --> 00:05:05,620
،بما أنّ الكنيسة مقفلة إذًا

59
00:05:05,620 --> 00:05:07,820
.لا بأس إن غيّرت ملابسي

60
00:05:07,820 --> 00:05:09,650
.سأعود إلى غرفتي الآن

61
00:05:15,640 --> 00:05:17,040
.كان ذلك خطأ

62
00:05:17,040 --> 00:05:18,920
كنتَ مستيقظًا كلّ هذا الوقت؟

63
00:05:19,360 --> 00:05:21,500
لماذا فعلت ذلك؟

64
00:05:21,500 --> 00:05:25,750
،أعتقد أنّ لورنس لا يفهم الكثير عن نفسه

65
00:05:25,750 --> 00:05:27,980
.لكنّ هذا خطئي أنا

66
00:05:28,380 --> 00:05:30,640
ما قد يكون السّبب؟

67
00:05:30,640 --> 00:05:32,120
أتظنّ أنّه الزّكام؟

68
00:05:32,120 --> 00:05:33,390
.على الأرجح لا

69
00:05:35,810 --> 00:05:37,680
!خبزت كعكًا مدوّرًا

70
00:05:37,680 --> 00:05:39,060
!كعك

71
00:05:39,060 --> 00:05:40,690
.وخبزت بسكويتًا أيضًا

72
00:05:40,690 --> 00:05:41,940
!بسكويت

73
00:05:41,940 --> 00:05:43,610
!هناك كعك مادلين أيضًا

74
00:05:43,610 --> 00:05:45,340
!مادلين

75
00:05:45,340 --> 00:05:46,350
.مهلاً

76
00:05:46,350 --> 00:05:58,620
.كنت سببًا لبكاء القدّيسة

77
00:05:48,360 --> 00:05:50,800
.هذا كثير لآكله وحدي

78
00:05:50,800 --> 00:05:52,520
.كله رجاءً

79
00:05:52,520 --> 00:05:55,320
بالنّسبة له الآن، فهو يختنق
.بسبب ذلك الشّعور بالذّنب

80
00:05:55,320 --> 00:05:56,920
ذنب؟

81
00:05:56,920 --> 00:05:58,620
بشأن ماذا؟

82
00:05:58,830 --> 00:06:01,640
.كلاهما ثخينا الرّأس

83
00:06:03,490 --> 00:06:04,740
.لورنس

84
00:06:05,390 --> 00:06:07,770
.وصلتك رسالة من زميل دراسة لنا

85
00:06:08,170 --> 00:06:09,360
شكرًا لك

86
00:06:10,540 --> 00:06:12,900
.يذكّرني ذلك الاسم بالكثير

87
00:06:12,900 --> 00:06:16,100
،بما أنّك لا تأتي للاجتماعات
.فربّما يكون هذا شعورك أنت وحدك

88
00:06:16,100 --> 00:06:18,520
ماذا؟ تقصد أنّ الجميع يحضرون؟

89
00:06:18,520 --> 00:06:21,170
.نعم، ونخوض في مناقشات عاديّة وما إلى ذلك

90
00:06:21,170 --> 00:06:22,370
.أشعر بالغيرة

91
00:06:23,150 --> 00:06:25,170
،كم أودّ حضور الاجتماعات

92
00:06:25,170 --> 00:06:27,650
.لكنّي لا أستطيع ترك القدّيسة وحدها

93
00:06:27,650 --> 00:06:29,820
لماذا لا تحضر السّيّدة سيسيليا معك؟

94
00:06:29,820 --> 00:06:32,280
.وعدتَ ألاّ تخبر أيّ أحد عنها

95
00:06:32,280 --> 00:06:34,310
.لا تخبر أحدًا أنّها قدّيسة فحسب

96
00:06:34,310 --> 00:06:36,870
كيف أقدّمها لهم إذًا؟

97
00:06:37,740 --> 00:06:38,570
.كأختك الصّغيرة

98
00:06:38,570 --> 00:06:40,530
.يعرف الجميع أنّ لا أخت لديّ

99
00:06:40,530 --> 00:06:41,960
.ابنة صديق لك

100
00:06:41,960 --> 00:06:43,210
.هذه علاقة بعيدة

101
00:06:43,210 --> 00:06:45,400
فتاة وجدتها على قارعة الطّريق
.لأنّها كانت ضائعة

102
00:06:45,400 --> 00:06:47,320
.سيسيء الكثير من النّاس الفهم هكذا

103
00:06:47,320 --> 00:06:50,550
عفوًا، ألا يمكنك القول أنّي شخص تقيم معه؟

104
00:06:50,550 --> 00:06:54,250
حسنًا، أشعر أنّ ذلك سيجعلهم
.يعاملونها بشكل أقلّ رسميّة

105
00:06:54,250 --> 00:06:58,690
.بصراحة، هنالك طريقة بسيطة جدًّا لشرح الأمور

106
00:06:59,520 --> 00:07:03,520
...لكن إن كنتما لا تستطيعان التّفكير بها

107
00:07:03,520 --> 00:07:04,780
!فسأخبركما أنا

108
00:07:04,780 --> 00:07:06,520
ماذا تقصد؟

109
00:07:07,220 --> 00:07:08,210
ماذا؟

110
00:07:08,210 --> 00:07:10,280
.هناك رسالة لك أيضًا يا أبيل

111
00:07:10,280 --> 00:07:11,990
.شكرًا لك

112
00:07:11,990 --> 00:07:12,930
.حسنًا

113
00:07:12,930 --> 00:07:14,320
!مهلاً، مهلاً، مهلاً

114
00:07:14,320 --> 00:07:15,840
!لماذا تحرقها؟

115
00:07:15,840 --> 00:07:17,310
!أطفئها في الحال

116
00:07:17,310 --> 00:07:22,460
،أبيل، عليك معاملة رسائل الدّيون بعناية
.حتّى إن كنت لا تستطيع تسديدها

117
00:07:22,460 --> 00:07:24,330
!أسأت فهمي

118
00:07:24,330 --> 00:07:26,880
.هذه مجرّد رسالة من صديق

119
00:07:26,880 --> 00:07:28,290
.سأذهب لأخبّئها

120
00:07:28,510 --> 00:07:32,300
.لا فكرة لديّ عمّا يكفّر به كالعادة

121
00:07:33,220 --> 00:07:36,970
لديك الكثير من الأصدقاء، صحيح يا لورن؟

122
00:07:38,360 --> 00:07:40,080
أهي الرّسالة؟

123
00:07:40,080 --> 00:07:42,770
،لا بدّ أنّ للقدّيسة مسقط رأس

124
00:07:42,770 --> 00:07:44,850
.لذلك لا بدّ من وصول رسائل لها يومًا ما

125
00:07:45,350 --> 00:07:49,070
...إن كان خطئي البارحة جعلها تكره هذا المكان

126
00:07:49,070 --> 00:07:51,860
...وجعلها تريد العودة لمنزلها

127
00:07:52,120 --> 00:07:53,000
.لا

128
00:07:53,000 --> 00:07:55,200
!لن أسبّب لها المشاكل ثانية أبدًا

129
00:07:55,200 --> 00:07:56,280
لورن؟

130
00:07:56,990 --> 00:08:00,950
ماذا نفعل بكلّ هذه الحلويّات؟

131
00:08:00,950 --> 00:08:02,920
!تسبّبت لها بالمشاكل ثانية اليوم

132
00:08:04,120 --> 00:08:05,410
لورن؟

133
00:08:06,620 --> 00:08:08,100
.أنا آسف

134
00:08:08,100 --> 00:08:11,430
كلّ ما فعلته البارحة واليوم هو إظهار
.أكثر جانب بشع من نفسي لك

135
00:08:11,430 --> 00:08:15,010
،عندما ظننتُ أنّك ربّما بدأت تكرهين العيش هنا

136
00:08:15,010 --> 00:08:16,320
.أقلقني ذلك كثيرًا

137
00:08:16,320 --> 00:08:16,980
ماذا؟

138
00:08:16,980 --> 00:08:19,190
!ما كنتُ لأكره العيش هنا أبدًا

139
00:08:19,190 --> 00:08:20,140
...لكن

140
00:08:20,140 --> 00:08:23,820
.يريحني العيش هنا أكثر من أيّ مكان آخر

141
00:08:24,600 --> 00:08:27,940
تراودني الأفكار السّعيدة كلّ يوم
...عن حياتي في هذا المكان

142
00:08:27,940 --> 00:08:29,780
.حيث لا يظلّ هناك متّسع لأكرهه

143
00:08:29,780 --> 00:08:32,890
هل جعلتك تشعرين بهذا اليأس في حياتك اليوميّة؟

144
00:08:32,890 --> 00:08:35,990
!ذلك ليس ما قصدت

145
00:08:36,290 --> 00:08:40,420
"،أحبّ العيش هكذا، وأنت تعتني بي"

146
00:08:40,420 --> 00:08:42,700
".لذلك لا تقل أشياء كهذه رجاءً"

147
00:08:42,700 --> 00:08:44,000
.هذا ما قصدت

148
00:08:45,000 --> 00:08:46,580
.فهمت

149
00:08:46,900 --> 00:08:47,890
ماذا؟

150
00:08:47,890 --> 00:08:51,250
.اختفى ذلك الشّعور بالقلق لسبب ما

151
00:08:51,250 --> 00:08:53,830
هل كنت تعاني من حرقة؟

152
00:08:53,830 --> 00:08:55,540
.ربّما

153
00:09:00,270 --> 00:09:02,760
.ما زالت تمطر

154
00:09:04,630 --> 00:09:08,020
.نسيه أحد ما هنا

155
00:09:08,360 --> 00:09:11,510
.يبرد الجوّ كثيرًا في اللّيل
.ربّما سيكون فقدان هذا مشكلة

156
00:09:11,510 --> 00:09:13,900
.ربّما عليّ الذّهاب لتسليمه أثناء تسوّقي

157
00:09:13,900 --> 00:09:15,790
ستذهب للقرية؟ وحدك؟

158
00:09:15,790 --> 00:09:16,680
،لا

159
00:09:16,680 --> 00:09:19,440
.أعتقد أنّ القدّيسة سترغب في الذّهاب أيضًا

160
00:09:19,440 --> 00:09:21,520
.سأكون هنا وحدي إذًا

161
00:09:21,520 --> 00:09:24,620
.الاعتناء بالأمور مملّ. ربّما سأرافقكما أيضًا

162
00:09:24,620 --> 00:09:27,750
،بالتّفكير في الأمر
!لم أزر القرية بالكامل بعد

163
00:09:27,750 --> 00:09:30,840
أخبرني، متى ستغادر؟

164
00:09:30,840 --> 00:09:32,840
هل أنت ذاهب للقرية؟

165
00:09:33,710 --> 00:09:35,970
!أودّ مرافقتك

166
00:09:37,700 --> 00:09:40,000
حسنًا، هل نغادر الآن؟

167
00:09:40,000 --> 00:09:40,980
!نعم

168
00:09:41,870 --> 00:09:43,400
...مهلاً، هذا

169
00:09:43,830 --> 00:09:45,640
هل سأكون حاجزًا بينهما؟

170
00:09:46,040 --> 00:09:48,320
.لورنس، أظنّني سأظلّ هنا

171
00:09:48,320 --> 00:09:49,680
!ماذا؟ لا يمكنك

172
00:09:49,680 --> 00:09:52,280
!سبق وخطّطت أن تحمل كلّ شيء بدلاً منّا

173
00:09:52,280 --> 00:09:53,900
!يمكنني حمل الأغراض أيضًا

174
00:09:53,900 --> 00:09:54,640
.لا

175
00:09:54,640 --> 00:09:55,860
!يبدو أنّي لا أستطيع

176
00:09:55,860 --> 00:09:58,580
.نظرًا لهذا الوضع يا أبيل، عليك المجيء أيضًا

177
00:09:58,580 --> 00:10:01,710
لم تزر القرية بالكامل بعد، صحيح؟

178
00:10:03,890 --> 00:10:06,800
ألن أكون عقبة في طريقكما إن ذهبت؟

179
00:10:06,800 --> 00:10:08,640
لماذا قد أظنّ ذلك؟

180
00:10:09,120 --> 00:10:11,800
.ستقضين وقتًا أقلّ مع لورنس هكذا

181
00:10:11,800 --> 00:10:14,670
.أنا برفقة لورن دائمًا

182
00:10:14,670 --> 00:10:17,560
،كما أنّه عندما يكون لورن برفقتك مؤخّرًا

183
00:10:17,560 --> 00:10:19,830
.بدأت أرى جانبًا مختلفًا منه

184
00:10:19,830 --> 00:10:21,810
!ذلك ممتع للغاية

185
00:10:21,810 --> 00:10:23,070
.فهمت

186
00:10:23,070 --> 00:10:25,800
إذًا فهذه هي وجهة نظر
شخص يعاني جنونَ لورنس؟

187
00:10:26,390 --> 00:10:28,320
هل سنذهب؟

188
00:10:30,380 --> 00:10:32,400
.انظروا، إنّها السّيّدة القدّيسة

189
00:10:32,400 --> 00:10:34,570
.إنّها جميلة كالعادة

190
00:10:34,570 --> 00:10:37,210
.تجعلني أشعر وكأنّ قلبي صار نقيًّا

191
00:10:37,560 --> 00:10:39,280
...كعك مدوّر

192
00:10:39,280 --> 00:10:41,120
.والقسّ معها

193
00:10:41,120 --> 00:10:45,270
.إنّه لطيف دائمًا ويقابل الجميع بابتسامة

194
00:10:45,270 --> 00:10:47,700
فوّتّ عملك ثانية، صحيح؟

195
00:10:47,700 --> 00:10:51,720
.ربّما من الأفضل لو تظلاّ هنا في القرية

196
00:10:51,720 --> 00:10:52,740
ماذا؟

197
00:10:53,860 --> 00:10:56,960
أين ستوصل ذلك الوشاح؟

198
00:10:56,960 --> 00:10:59,380
.فكّرت في إيصاله لمنزل صاحبه مباشرة

199
00:10:59,380 --> 00:11:02,480
،إنّه في الجانب الآخر من النّهر
.لذلك علينا المشي طويلاً

200
00:11:02,480 --> 00:11:07,220
لم تأخذني للجانب الآخر من النّهر
من قبل، صحيح يا لورن؟

201
00:11:07,220 --> 00:11:10,480
.ذلك لأنّي لا أريدك أن تسيري كثيرًا

202
00:11:10,480 --> 00:11:13,370
.تحتاج السّيّدة سيسيليا لبعض التّمارين أيضًا

203
00:11:13,370 --> 00:11:14,970
.كما أنّه بإمكانك أخذ عربة

204
00:11:14,970 --> 00:11:16,160
!ذلك صحيح

205
00:11:16,160 --> 00:11:18,120
!يا سيّدتي القدّيسة

206
00:11:18,730 --> 00:11:20,720
هل تريدين منّي قراءة طالعك؟

207
00:11:20,720 --> 00:11:22,830
...ماذا؟ ذلك

208
00:11:22,830 --> 00:11:26,200
.أنا قارئة طالع بالكاد تجني قوتها في هذه القرية

209
00:11:26,200 --> 00:11:27,920
هل أنت مهتمّة بقراءة الطّالع؟

210
00:11:27,920 --> 00:11:30,200
قراءة الطّالع؟

211
00:11:30,200 --> 00:11:32,660
.أستطيع القيام بقراءات توافُق

212
00:11:32,660 --> 00:11:34,360
.أنا فضوليّة قليلاً الآن

213
00:11:34,360 --> 00:11:36,150
.هيّا بنا يا سيّدتي القدّيسة

214
00:11:36,150 --> 00:11:39,500
.لا تستجدي القدّيسة من بين كلّ النّاس رجاءً

215
00:11:39,500 --> 00:11:41,370
!لكنّي أقدّم خدمات للنّاس

216
00:11:41,370 --> 00:11:43,470
!عليّ أن أسأل الجميع، سواء كانوا القدّيسة أم لا

217
00:11:43,470 --> 00:11:46,270
.تبدين عنيدة جدًّا، لكنّنا سنرفض عرضك

218
00:11:46,270 --> 00:11:49,140
!كم أنت قاس أيّها القسّ

219
00:11:49,960 --> 00:11:55,450
!بالكاد جنيت أيّ مال اليوم أيضًا
!يا ويلي، ويلي، ويلي

220
00:11:55,450 --> 00:11:56,950
...لـ-لورن

221
00:11:57,420 --> 00:11:59,640
...بعد سماعنا لهذا

222
00:12:00,070 --> 00:12:02,280
.إنّهما لطيفان للغاية

223
00:12:02,670 --> 00:12:04,590
لماذا أنا؟

224
00:12:04,590 --> 00:12:07,200
.لا أحبّ قراءة الطّالع كثيرًا

225
00:12:07,200 --> 00:12:08,640
!لا داعي للقلق

226
00:12:08,640 --> 00:12:10,650
.اعتبر الأمر كشيء تقوم به ليريح بالك

227
00:12:11,560 --> 00:12:15,000
هل حدث أمر ما مؤخّرًا
حسّن حياتك بشكل عامّ؟

228
00:12:15,920 --> 00:12:18,520
،حماية شيء ما كي لا ينكسر أمر جيّد

229
00:12:18,520 --> 00:12:21,510
،لكن عليك الاعتناء بنفسك أيضًا
ألا توافقني الرّأي؟

230
00:12:21,510 --> 00:12:24,520
ينكسر؟ هل تصنع شيئًا ما؟

231
00:12:24,520 --> 00:12:26,210
.يبدو هذا عملاً صعبًا

232
00:12:26,210 --> 00:12:27,680
أتظنّين؟

233
00:12:27,840 --> 00:12:29,610
.دور القدّيسة الآن

234
00:12:29,610 --> 00:12:30,840
.حاضرة

235
00:12:31,360 --> 00:12:32,850
.لن يأتي من تنتظرين

236
00:12:33,970 --> 00:12:36,610
.عليك الانتظار بصبر شديد

237
00:12:37,720 --> 00:12:39,360
...ولقاء جديد سوف

238
00:12:39,360 --> 00:12:41,530
.توقّفي. أوامر الطّبيب

239
00:12:41,530 --> 00:12:44,150
.يبدو أنّ من أنتظرن لن يأتي

240
00:12:44,150 --> 00:12:45,620
...مـ-مهلاً

241
00:12:45,620 --> 00:12:49,410
.واثق أنّ وضعك الحاليّ وضع جيّد

242
00:12:49,730 --> 00:12:53,420
.وربّما لهذا السّبب لن يأتي أيّ أحد آخر تنتظرينه

243
00:12:53,420 --> 00:12:55,040
.فهمت

244
00:12:55,040 --> 00:12:58,710
من الممكن أنّ الشّخص الّذي
.أنتظره قد وصل منذ مدّة

245
00:13:00,700 --> 00:13:03,160
...والآن حان دور القسّ أخيرًا

246
00:13:03,800 --> 00:13:06,800
.لكن يبدو أنّ في حياتك الكثير التّقلّبات

247
00:13:06,800 --> 00:13:08,920
.لستُ واثقًا أنّي أفهم

248
00:13:08,920 --> 00:13:11,050
هل سيحدث شيء ما سيّئ إن استمرّ هذا؟

249
00:13:12,470 --> 00:13:15,180
ربّما عليك أن تلقي نظرة أعمق
.على من هم عزيزون على قلبك

250
00:13:15,180 --> 00:13:17,020
من قد يكونون يا ترى؟

251
00:13:17,810 --> 00:13:22,660
ربّما عليك مواجهة مشاعر
.من حولك ومشاعرك أنت مباشرة

252
00:13:22,660 --> 00:13:24,670
ألا أفعل ذلك مسبقًا؟

253
00:13:24,670 --> 00:13:25,800
.على الإطلاق

254
00:13:26,570 --> 00:13:29,570
!شكرًا لكم! عودوا ثانية في وقت لاحق

255
00:13:29,810 --> 00:13:33,700
أطلب ألاّ تكون قراءتك اللاّحقة
.سببًا في قلق عاطفيّ

256
00:13:33,700 --> 00:13:35,480
.يا سيّدتي القدّيسة

257
00:13:37,600 --> 00:13:40,120
ألا تريدين قراءة طالع عن التّوافق؟

258
00:13:43,270 --> 00:13:44,610
.لا حاجة لذلك

259
00:13:44,610 --> 00:13:50,120
لا أريد لقرارات كهذه أن تكون
.في يد شخص آخر غيري

260
00:13:53,250 --> 00:13:55,350
ما الّذي تحدّثتما عنه؟

261
00:13:57,870 --> 00:14:00,110
.تحدّثنا عن عزيمتي الثّابتة

262
00:14:00,110 --> 00:14:02,920
.سيّدتي القدّيسة؟ نحن ذاهبون من هنا

263
00:14:09,640 --> 00:14:11,870
هل من خطب يا سيّدتي القدّيسة؟

264
00:14:11,870 --> 00:14:14,790
.تمزّق ردائي

265
00:14:15,590 --> 00:14:17,660
.يا إلهي

266
00:14:17,660 --> 00:14:18,720
،لو سمحت لي

267
00:14:18,720 --> 00:14:21,630
يمكنك المجيء معي لمحلّي
.واختيار شيء آخر لارتدائه

268
00:14:21,630 --> 00:14:24,680
.ماذا؟ لكن علينا الذّهاب لمكان ما

269
00:14:24,680 --> 00:14:26,260
!سنكون شاكرين لهذا

270
00:14:26,260 --> 00:14:29,420
،وبينما تقومين بذلك
!سنذهب ونوصل الوشاح لصاحبه

271
00:14:29,420 --> 00:14:30,430
ماذا؟

272
00:14:32,670 --> 00:14:37,050
.لم أتخيّل أبدًا أنّي سأذهب وحدي

273
00:14:39,070 --> 00:14:40,960
!إنّها السّيّدة القدّيسة بنفسها

274
00:14:40,960 --> 00:14:43,320
مرحبًا! كيف أساعدك؟

275
00:14:43,320 --> 00:14:44,480
.مرحبًا

276
00:14:44,480 --> 00:14:47,810
.أودّ من القدّيسة أن تختار شيء ما لارتدائه

277
00:14:47,810 --> 00:14:50,160
.تمزّقت ثيابها قليلاً

278
00:14:50,160 --> 00:14:52,290
هكذا إذًا؟

279
00:14:52,290 --> 00:14:55,530
مهلاً، هل الرّاهـ— أقصد القسّ ليس معك؟

280
00:14:55,530 --> 00:14:58,320
.تركني وذهب

281
00:14:58,320 --> 00:15:00,080
.فهمت

282
00:15:00,080 --> 00:15:01,340
فهمت"؟"

283
00:15:01,340 --> 00:15:03,540
!هيّا بنا يا سيّدتي القدّيسة

284
00:15:05,290 --> 00:15:07,100
ما رأيك بهذه الملابس؟

285
00:15:07,100 --> 00:15:08,390
...بدل ما ترتدين

286
00:15:10,130 --> 00:15:12,440
!أعتقد أنّ هذه ستلائمك أكثر يا سيّدتي القدّيسة

287
00:15:12,440 --> 00:15:14,390
!لا شيء من ذلك يلائمها

288
00:15:16,150 --> 00:15:17,260
.هذه أفضل بكثير

289
00:15:17,260 --> 00:15:18,660
ما الّذي تقولينه؟

290
00:15:18,660 --> 00:15:21,060
.واثقة أنّها تفضّل الملابس الظّريفة

291
00:15:21,060 --> 00:15:23,270
إذًا فهذه تتوافق مع ذلك تمامًا، صحيح؟

292
00:15:23,270 --> 00:15:27,070
يجب أن تكون ملابس السّيّدة
!القدّيسة مرتّبة ونظيفة

293
00:15:27,070 --> 00:15:28,190
!مهلاً لحظة

294
00:15:28,190 --> 00:15:29,690
...على ملابس السّيّدة القدّيسة أن

295
00:15:29,690 --> 00:15:33,690
!بصراحة! لا، كانت الملابس الّتي اخترتُ أفضل

296
00:15:30,400 --> 00:15:33,690
.يبدو أني بدأت حربًا

297
00:15:35,400 --> 00:15:39,450
أهكذا يجب أن ألبس هذا؟

298
00:15:41,700 --> 00:15:43,420
!أحسنتنّ جميعًا

299
00:15:43,420 --> 00:15:44,890
!هذا نصر للصّداقة

300
00:15:44,890 --> 00:15:45,890
...بالفعل

301
00:15:45,890 --> 00:15:48,700
.انضمّ كلّ زبائني لهذا

302
00:15:48,700 --> 00:15:51,090
.تحبّ النّساء مثل هذه الأمور

303
00:15:51,090 --> 00:15:52,700
...عفوًا

304
00:15:53,130 --> 00:15:55,430
لا يبدو غريبًا؟

305
00:15:55,430 --> 00:15:58,180
.بالطّبع لا! يبدو مناسبًا جدًّا لك

306
00:15:59,400 --> 00:16:00,720
...بالتّفكير في الأمر

307
00:16:00,720 --> 00:16:04,440
لماذا لم تتفاجئي لأنّ لورن ليس معي؟

308
00:16:04,440 --> 00:16:08,120
.نرى هذه الظّاهرة كثيرًا في محلاّت الملابس

309
00:16:08,120 --> 00:16:09,310
ظاهرة؟

310
00:16:09,310 --> 00:16:12,220
حاولي أن تسأليه عن ذلك بنفسك
.إن كنت تريدين معرفة الجواب

311
00:16:12,220 --> 00:16:14,320
.اسأليه عن رأيه بشأن الملابس أيضًا

312
00:16:14,540 --> 00:16:16,830
.حـ-حسنًا

313
00:16:17,610 --> 00:16:21,820
هل أنت واثق من ترك السّيّدة سيسيليا وحدها؟

314
00:16:23,680 --> 00:16:28,090
هل سبق ودخلت في وضع كذاك وحدك من قبل؟

315
00:16:28,090 --> 00:16:29,340
لا. لماذا؟

316
00:16:30,930 --> 00:16:35,280
سبق وجرّبته من قبل عندما
.ذهبت لشراء ملابس للقدّيسة

317
00:16:35,280 --> 00:16:37,230
.لم يكن ذلك مكاني

318
00:16:38,350 --> 00:16:42,300
ومع ذلك، هذا ليس سببًا لإجبارها
.على البقاء في الخلف هكذا

319
00:16:42,300 --> 00:16:43,500
ما الّذي ستفعله؟

320
00:16:43,500 --> 00:16:45,930
ماذا إن تجوّلت في القرية وحدها

321
00:16:45,930 --> 00:16:48,360
"!وأتت لتقول "وجدت رجلاً وسيمًا

322
00:16:48,870 --> 00:16:50,360
...إن حدث ذلك

323
00:16:51,770 --> 00:16:54,760
.سيكون عليّ تحديد إن كان الرّجل جديرًا بها

324
00:16:54,760 --> 00:16:56,400
هل أنت والدها؟

325
00:16:58,020 --> 00:17:00,920
أهذا هو فستان الزّفاف السّابق؟

326
00:17:00,920 --> 00:17:02,200
.نعم، إنّه هو

327
00:17:02,200 --> 00:17:04,810
أتساءل متى سيتسنّى لي خياطة
.فستانك يا سيّدتي القدّيسة

328
00:17:04,810 --> 00:17:06,790
!لـ-ليس بعد

329
00:17:06,790 --> 00:17:08,170
أقلت "ليس بعد"؟

330
00:17:08,170 --> 00:17:10,050
...لا، أعني

331
00:17:10,050 --> 00:17:13,140
.ضايقتني هكذا سابقًا أيضًا

332
00:17:13,960 --> 00:17:15,280
.أنا آسفة

333
00:17:15,280 --> 00:17:17,920
.تبدوان لي سعيدين ولا أستطيع منع نفسي

334
00:17:19,240 --> 00:17:20,300
تبدوان"؟"

335
00:17:20,300 --> 00:17:23,800
.ذلك الفتى القسّ. إنّه يبدو سعيدًا أيضًا

336
00:17:24,340 --> 00:17:28,070
.بدا وحيدًا نوعًا ما دائمًا قبل مجيئك

337
00:17:28,070 --> 00:17:30,710
،كان يُظهر للجميع أنّه ناضح وراضٍ

338
00:17:30,850 --> 00:17:33,400
.لكن ربّما كان يتوق للحصول على عائلة عاديّة

339
00:17:33,730 --> 00:17:38,160
.لكنّه لم يعد كذلك الآن، لذلك قلّ قلقي عليه

340
00:17:38,160 --> 00:17:40,240
عائلة عاديّة؟

341
00:17:40,240 --> 00:17:44,270
.لم يكن لديه والدان وربّاه جدّه

342
00:17:44,270 --> 00:17:47,550
.لذلك كان وحيدًا منذ وفاة جدّه

343
00:17:47,930 --> 00:17:49,290
.وحيدًا

344
00:17:50,450 --> 00:17:53,290
.كنت وحيدة أيضًا

345
00:17:55,470 --> 00:17:56,900
.فهمت

346
00:17:56,900 --> 00:17:58,800
.لا بدّ أنّ كلاكما سعيدان إذًا

347
00:17:59,800 --> 00:18:00,960
.نعم

348
00:18:00,960 --> 00:18:02,180
.أمّي

349
00:18:02,680 --> 00:18:04,180
.قمت بتوصيل كلّ شيء

350
00:18:04,440 --> 00:18:06,480
لماذا يوجد الكثير من النّاس هنا؟

351
00:18:06,480 --> 00:18:07,930
!شكرًا على ذلك

352
00:18:08,200 --> 00:18:11,440
هذا هو ابني الّذي أخبرتك عنه
.من قبل يا سيّدتي القدّيسة

353
00:18:11,970 --> 00:18:13,600
!سررت بلقائك

354
00:18:14,420 --> 00:18:15,360
.مرحبًا

355
00:18:16,360 --> 00:18:19,370
!تعال! عرّف عن نفسك جيّدًا

356
00:18:19,370 --> 00:18:21,580
أهذه عائلة عاديّة؟

357
00:18:25,280 --> 00:18:27,240
.ها قد غادرت القدّيسة

358
00:18:27,240 --> 00:18:29,180
.علينا المغادرة أيضًا

359
00:18:29,180 --> 00:18:31,830
.يمكنكنّ شراء شيء ما أوّلاً

360
00:18:39,850 --> 00:18:41,240
،بالتّفكير في الأمر

361
00:18:41,240 --> 00:18:44,840
.لا أعرف أين المنزل الّذي سيذهل إليه لورن وأبيل

362
00:18:44,840 --> 00:18:46,840
...أذكر أنّه قابل في الجانب الآخر من النّهر

363
00:18:50,110 --> 00:18:53,360
هل يعقل أنّ ذلك هو النّهر؟

364
00:18:53,360 --> 00:18:56,610
...إن اقتربت من هناك، فإنّ لورن

365
00:18:59,360 --> 00:19:01,860
مهلاً! هل أنت بخير؟

366
00:19:02,100 --> 00:19:04,660
.أشعر أنّ ساقي قد تتشنّج

367
00:19:07,380 --> 00:19:09,280
.شكرًا لك

368
00:19:09,280 --> 00:19:11,420
لم تتأذّي بسبب ذلك، صحيح؟

369
00:19:11,420 --> 00:19:13,660
!لا، أنا بخير

370
00:19:14,750 --> 00:19:17,430
هل أتيت من قرية أخرى؟

371
00:19:17,430 --> 00:19:20,430
.نعم، أتيت إلى هنا بحثًا عن أحد ما

372
00:19:20,430 --> 00:19:23,810
...إذًا، إن كان هنالك ما أساعدك به

373
00:19:23,810 --> 00:19:26,240
.لديّ فكرة واضحة أين أبحث

374
00:19:26,240 --> 00:19:28,640
.أعتقد أنّ بحثي سيكون قصيرًا

375
00:19:28,640 --> 00:19:30,490
.فهمت

376
00:19:30,490 --> 00:19:32,840
.آسفة لأنّي لم أستطع المساعدة

377
00:19:32,840 --> 00:19:36,900
،إن كنتِ من هذه القرية
.فربّما سنلتقي ثانية

378
00:19:36,900 --> 00:19:38,040
.مع السّلامة

379
00:19:39,060 --> 00:19:41,280
انتبهي لخطواتك، مفهوم؟

380
00:19:41,910 --> 00:19:43,380
.حسنًا

381
00:19:45,200 --> 00:19:47,990
.إنّها في رحلة إذًا

382
00:19:48,350 --> 00:19:51,180
.بدت أنيقة جدًّا

383
00:19:51,180 --> 00:19:53,950
.أتساءل كيف هو الشّخص الّذي تبحث عنه

384
00:19:53,950 --> 00:19:55,200
سيّدتي القديسة؟

385
00:19:55,760 --> 00:19:56,960
!لورن

386
00:19:57,380 --> 00:19:59,910
هل أوصلت الوشاح؟

387
00:19:59,910 --> 00:20:00,790
.نعم

388
00:20:00,790 --> 00:20:02,970
.كان بإمكانك انتظارنا في المحلّ

389
00:20:02,970 --> 00:20:06,200
!اختار الجميع هذه الملابس لي

390
00:20:06,200 --> 00:20:07,280
ما رأيك؟

391
00:20:07,280 --> 00:20:09,230
...حسنًا

392
00:20:09,230 --> 00:20:10,610
.ستشعرين بالبرد

393
00:20:11,220 --> 00:20:14,290
لماذا؟ لماذا حدث هذا؟

394
00:20:15,230 --> 00:20:18,040
!تبدين رائعة يا سيّدتي سيسيليا

395
00:20:18,040 --> 00:20:19,250
أليس كذلك يا لورنس؟

396
00:20:19,250 --> 00:20:20,240
!أبيل

397
00:20:20,240 --> 00:20:22,380
!لا بدّ أنّ من اختار الملابس لديه حسّ أناقة رائع

398
00:20:22,380 --> 00:20:24,240
!أبيل

399
00:20:25,160 --> 00:20:26,650
!نعم، بالطّبع

400
00:20:26,650 --> 00:20:28,550
.تبدين جميلة جدًّا يا سيّدتي القدّيسة

401
00:20:28,990 --> 00:20:33,250
لكنّها لا تبدو دافئة، لذلك علينا الانتهاء
.من التّسوّق بسرعة

402
00:20:37,160 --> 00:20:41,170
.يكون لورن بعيدًا جدًّا في أوقات كهذه

403
00:20:41,170 --> 00:20:43,600
!أريد... المزيد

404
00:20:46,650 --> 00:20:48,050
سيّدتي القدّيسة؟

405
00:20:49,230 --> 00:20:53,560
تـ-تبدو جميلة... فحسب؟

406
00:20:58,070 --> 00:21:01,160
.أ-أظنّ أنّك تبدين ظريفة

407
00:21:02,030 --> 00:21:03,380
فعلاً؟

408
00:21:03,380 --> 00:21:04,780
.فعلاً

409
00:21:04,780 --> 00:21:07,160
هل يمكنك ترك يدي الآن؟

410
00:21:07,560 --> 00:21:09,120
!نعم

411
00:21:12,530 --> 00:21:17,500
إنّ سعي القدّيسة لمعرفة
...رأي أحد ما بهذه الحماسة

412
00:21:17,500 --> 00:21:19,790
.هو أمر لا أظنّها تقوم به كثيرًا

413
00:21:19,790 --> 00:21:23,550
.قول أشياء كهذه بصوت عالٍ صعب

414
00:21:23,550 --> 00:21:25,390
،إنّه من النّوع الصّريح

415
00:21:25,390 --> 00:21:28,800
.لكنّه لا يستطيع قول ما يفكّر به فعلاً

416
00:21:29,640 --> 00:21:32,520
.إنّها فوق التّلّة هناك إن كنت تقصدين الكنيسة

417
00:21:33,050 --> 00:21:35,320
هناك. يمكن رؤيتها من هنا، صحيح؟

418
00:21:35,320 --> 00:21:39,230
هل صحيح أنّه توجد قدّيسة هناك؟

419
00:21:39,230 --> 00:21:40,430
.نعم

420
00:21:40,430 --> 00:21:42,360
.إنّها تعيش مع القسّ

421
00:21:42,360 --> 00:21:43,450
.فهمت

422
00:21:43,450 --> 00:21:45,380
.شكرًا على لطفك

423
00:21:45,920 --> 00:21:48,220
.أفكّر في الذّهاب إليها

424
00:21:48,880 --> 00:21:51,790
أريد رؤية أيّ نوع من الأشخاص
.تكون قدّيسة هذه القرية

425
00:23:23,280 --> 00:23:25,300
.وشاح ضائع في الكنيسة

426
00:23:25,300 --> 00:23:27,620
.هذه خامس مرّة يحدث فيها هذا منذ قدومي

427
00:23:27,620 --> 00:23:31,100
.إنّه وشاح العجوز الّتي تعيش في الجانب الآخر من النّهر

428
00:23:31,100 --> 00:23:34,020
.وهذه خامس مرّة عرفتَ فيها لمن يعود

429
00:23:34,020 --> 00:23:37,830
لماذا لا تستعمل قوى الملاحظة تلك
لتلاحظ السّيّدة سيسيليا؟

430
00:23:37,830 --> 00:23:39,490
هل قلت شيئًا ما؟