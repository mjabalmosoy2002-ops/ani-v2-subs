1
00:00:01,850 --> 00:00:03,020
!مرحبًا

2
00:00:03,020 --> 00:00:03,970
ما لدينا هنا؟

3
00:00:04,220 --> 00:00:06,080
!مرحبًا بكما

4
00:00:06,080 --> 00:00:07,090
.شكرًا

5
00:00:08,810 --> 00:00:11,120
لماذا أتت السّيّدة القدّيسة أيضًا؟

6
00:00:11,640 --> 00:00:14,480
!إنّه مجرّد سؤال من إريك

7
00:00:14,480 --> 00:00:17,320
.لا تقل أشياء فظّة كهذه

8
00:00:17,320 --> 00:00:21,520
.لكنّنا طلبنا من القسّ فقط أن يدرّسني

9
00:00:18,760 --> 00:00:19,690
...اسمع

10
00:00:21,520 --> 00:00:24,200
.لا يوجد أيّ شيء تقوم به القدّيسة هنا

11
00:00:24,200 --> 00:00:27,170
.قالت أنّها سترافقني إن كنت سآتي إليك

12
00:00:27,170 --> 00:00:29,630
!سأحرص ألاّ أكون عقبة في طريقكم

13
00:00:29,630 --> 00:00:32,150
.لا بأس، فأنا لا أمانع أو ما شابه

14
00:00:32,150 --> 00:00:35,180
.اذهبا أنتما للدّراسة

15
00:00:35,180 --> 00:00:37,760
.ستبقى القدّيسة هنا معي في المتجر

16
00:00:37,760 --> 00:00:39,010
أليس كذلك؟

17
00:00:39,010 --> 00:00:40,560
!حـ-حسنًا

18
00:00:40,560 --> 00:00:43,770
.لا تستعملي سيّدتي القدّيسة لجلب الزّبائن رجاءً

19
00:00:43,770 --> 00:00:45,160
.بربّك

20
00:00:45,160 --> 00:00:49,280
ليس بيدي حيلة إن بدأ الزّبائن بالظّهور، صحيح؟

21
00:00:53,440 --> 00:00:55,650
.آسف بشأن أمّي

22
00:00:56,040 --> 00:00:59,370
على الأرجح أنّها تطلب من القدّيسة
.القيام بالكثير من الأمور الآن

23
00:00:59,370 --> 00:01:02,280
واثق أنّ القدّيسة ستكون بخير
.بما أنها برفقة السيّدة ريبيكا

24
00:01:02,280 --> 00:01:03,660
أأنت واثق؟

25
00:01:03,660 --> 00:01:06,240
أشعر أنّها ستعاملها كدمية
.وتجعلها ترتدي ملابس مختلفة

26
00:01:06,240 --> 00:01:08,290
.معك حقّ

27
00:01:10,300 --> 00:01:14,330
.لا أفهم تمامًا ما هنّ القدّيسات

28
00:01:14,330 --> 00:01:18,430
أيّ نوع من الأشخاص تلك القدّيسة
بالنّسبة لك أيّها القسّ؟

29
00:01:18,430 --> 00:01:20,680
أيّ نوع؟

30
00:01:21,640 --> 00:01:25,370
،إنّها شخص أريد إسعاده
،شخص أريد حمايته

31
00:01:25,370 --> 00:01:26,520
...وأيضًا

32
00:01:28,470 --> 00:01:29,690
أيّها القسّ؟

33
00:01:30,550 --> 00:01:32,800
...حسنًا

34
00:01:34,380 --> 00:01:36,820
.لستُ واثقًا

35
00:01:37,200 --> 00:01:39,090
،حتّى عندما ذهبنا إلى المدينة الغربيّة

36
00:01:39,090 --> 00:01:43,120
.لم أكن واثقًا كيف أقدّمها للآخرين

37
00:01:43,120 --> 00:01:46,000
...بدا قول أنّها شريكة سكن بسيطًا، لكن

38
00:01:47,360 --> 00:01:49,880
أليست "فرد من العائلة" عبارة مناسبة أكثر؟

39
00:01:50,080 --> 00:01:51,580
عائلة؟

40
00:01:51,580 --> 00:01:54,940
،تبدو القدّيسة سعيدة جدًّا وهي برفقتك

41
00:01:54,940 --> 00:01:59,020
.وأنت قلق حيال سلامتها دائمًا

42
00:01:59,400 --> 00:02:00,470
...لذلك

43
00:02:00,470 --> 00:02:03,200
أعتقد أنّ هذا هو ما ندعوه بـ"العائلة"، صحيح؟

44
00:02:03,200 --> 00:02:04,640
...عائلة

45
00:03:40,810 --> 00:03:43,000
هلاّ أخذنا استراحة قصيرة؟

46
00:03:43,320 --> 00:03:46,040
.سأذهب لأرى ما تفعله القدّيسة

47
00:03:46,040 --> 00:03:47,880
.سأذهب أيضًا

48
00:03:50,520 --> 00:03:52,060
.عائلة

49
00:03:52,060 --> 00:03:53,830
عائلة؟

50
00:03:54,250 --> 00:03:57,120
.جدّي الّذي ربّاني فرد من العائلة

51
00:03:57,680 --> 00:04:00,880
.لكن لا تربطني بالقدّيسة أيّ صلة قرابة

52
00:04:01,410 --> 00:04:04,750
ما الّذي يجعل النّاس عائلة؟

53
00:04:05,520 --> 00:04:08,510
!كم هذا ظريف
...كلاهما يبدو جميلاً، ماذا عن

54
00:04:09,140 --> 00:04:11,910
.إنّها محاطة بالكثير من النّاس

55
00:04:12,640 --> 00:04:14,150
!لورن

56
00:04:14,150 --> 00:04:15,070
!أيّها القسّ

57
00:04:15,070 --> 00:04:17,830
أيّ فستان يناسب القدّيسة أكثر؟

58
00:04:17,830 --> 00:04:18,650
ماذا؟

59
00:04:19,220 --> 00:04:21,570
أعتقد أنّ هذا أفضل. ما رأيك؟

60
00:04:19,230 --> 00:04:21,580
...حتّى إن سألتنّني، فأنا لا

61
00:04:21,570 --> 00:04:22,760
.هيّا

62
00:04:21,570 --> 00:04:24,580
هذا جميل أيضًا، صحيح؟

63
00:04:22,760 --> 00:04:26,320
،هربت في آخر مرّة
.لذلك عليك مواجهة الأمر كما يجب الآن

64
00:04:30,410 --> 00:04:33,580
.تبدو القدّيسة جميلة في أيّ شيء

65
00:04:33,580 --> 00:04:36,360
أنت لا تفهم، صحيح؟

66
00:04:36,360 --> 00:04:39,080
.ليس من الجيّد طلب الكثير منه

67
00:04:39,840 --> 00:04:42,590
.سيضع ذلك لورن في وضع محرج

68
00:04:44,480 --> 00:04:45,790
،إن كنّا عائلة

69
00:04:45,790 --> 00:04:48,600
فعل سأكون قادرًا على قول أشياء
كهذه بطريقة عاديّة؟

70
00:04:50,600 --> 00:04:52,990
!آ-آنسة ميل! لم أعلم انّك هنا

71
00:04:52,990 --> 00:04:54,640
.نعم، أنا هنا

72
00:04:57,230 --> 00:04:59,240
ما-ماذا هنالك؟

73
00:04:59,240 --> 00:05:01,860
.فكّرتُ في أنّك قد تكون قلقًا حيال أمر ما

74
00:05:02,270 --> 00:05:03,860
أتريد الحديث عن الأمر؟

75
00:05:06,760 --> 00:05:09,780
أقلت عائلة؟

76
00:05:09,780 --> 00:05:12,280
لـ-لم تنظرين إليّ هكذا؟

77
00:05:12,280 --> 00:05:16,010
.حسنًا، هناك أنواع وأشكال مختلفة من العائلات

78
00:05:16,010 --> 00:05:18,450
.لكنّ الكلمة تناسب وضعكما بشكل مثاليّ

79
00:05:18,450 --> 00:05:19,880
.أحسنت يا إريك

80
00:05:19,880 --> 00:05:22,290
.نعم، صحيح

81
00:05:22,290 --> 00:05:26,040
أعلم بالطّبع أنّ هنالك أنواعًا
.مختلفة من العائلات في العالم

82
00:05:26,320 --> 00:05:27,790
لكن... كيف أفسّر الأمر؟

83
00:05:27,790 --> 00:05:31,880
.في حالتي، أشعر أنّ ذلك قلّة احترام للقدّيسة

84
00:05:31,880 --> 00:05:34,430
.إنّها وقاحة من ناحية معيّنة، صحيح

85
00:05:35,460 --> 00:05:37,020
من ناحية معيّنة؟

86
00:05:37,020 --> 00:05:40,120
ما معنى وجودها بالنّسبة لك؟

87
00:05:40,120 --> 00:05:42,700
.في النّهاية، أنت من يقرّر ويعيّن ذلك المعنى بنفسك

88
00:05:42,960 --> 00:05:44,060
،في حالتك

89
00:05:44,060 --> 00:05:46,780
إنّ حقيقة أنّك تفكّر حيال الأمر
.خطوة كبيرة للأمام

90
00:05:46,790 --> 00:05:47,900
ماذا؟

91
00:05:47,900 --> 00:05:49,660
.رغم أنّك قسّ

92
00:05:49,660 --> 00:05:52,750
.آسف لأنّي طلبت النّصيحة منك هكذا

93
00:05:52,750 --> 00:05:54,580
.أجعل ما العمل في مثل هذه الأمور

94
00:05:54,580 --> 00:05:56,450
...بالمناسبة

95
00:05:56,960 --> 00:06:00,670
.هناك شخص تصدر منه هالة منذرة لوقت طويل

96
00:06:01,710 --> 00:06:03,570
!سيّدتي القدّيسة

97
00:06:03,570 --> 00:06:05,220
!كان عليك قول شيء ما رجاءً

98
00:06:05,220 --> 00:06:09,720
.لـ-لورن، أنت وقارئة الطّالع مقرّبان من بعض

99
00:06:09,720 --> 00:06:12,450
.ماذا؟ لسنا مقرّبين لذلك الحدّ

100
00:06:12,450 --> 00:06:15,640
.يتصرّف القسّ ببرود نحوي من وقت لآخر

101
00:06:15,640 --> 00:06:18,160
.أيّها القسّ، علينا أن نواصل دروسنا

102
00:06:18,160 --> 00:06:20,360
.نعم، هذا صحيح! أنا آسف

103
00:06:20,360 --> 00:06:23,730
هـ-هل يمكنني المراقبة بينما تساعده على الدّراسة؟

104
00:06:23,730 --> 00:06:26,280
!لن أسبّب أيّ مشاكل

105
00:06:26,280 --> 00:06:29,370
.لا أمانع إن كنت ستظلّين هادئة

106
00:06:29,370 --> 00:06:31,660
!شكرًا لك يا إريك

107
00:06:31,660 --> 00:06:33,560
.حسنًا، أظنّني سأذهب الآن

108
00:06:33,560 --> 00:06:35,450
.شكرًا لك يا آنسة ميل

109
00:06:36,280 --> 00:06:37,440
!يا قارئة الطّالع

110
00:06:37,440 --> 00:06:39,800
—علينا أن ندردش معًا طويلاً في

111
00:06:40,420 --> 00:06:42,220
!على مهلك يا سيّدتي القدّيسة

112
00:06:42,220 --> 00:06:44,290
.أ-أنا آسفة

113
00:06:44,290 --> 00:06:48,510
لا بأس لأنّي أستطيع المساعدة في دعمك
...وأنا قريب منك، لكن

114
00:06:53,570 --> 00:06:55,690
ماذا هنالك؟

115
00:06:55,690 --> 00:06:57,020
.لا شيء

116
00:06:57,460 --> 00:07:00,010
عفوًا يا سيّدتي القدّيسة؟

117
00:07:02,480 --> 00:07:05,140
.شكرًا لك أيّها القسّ

118
00:07:05,140 --> 00:07:07,600
.احرص على مراجعة ما درسناه اليوم

119
00:07:07,600 --> 00:07:08,440
.نعم

120
00:07:08,440 --> 00:07:10,080
!بالمناسبة

121
00:07:10,080 --> 00:07:12,160
.سيكون لي كشك في السّوق الشّتويّ

122
00:07:12,160 --> 00:07:14,470
.آمل أن تمرّا عليه كلاكما

123
00:07:14,470 --> 00:07:16,830
السّوق الشّتويّ؟

124
00:07:16,830 --> 00:07:19,750
صحيح، هذه أوّل مرّة لك، صحيح يا سيّدتي القدّيسة؟

125
00:07:19,750 --> 00:07:22,620
.إنّه مهرجان يقام في مواقع مختلفة

126
00:07:22,620 --> 00:07:26,800
تفتح الكثير من المتاجر أكشاكًا
.في السّاحة ويزورها الجميع

127
00:07:26,800 --> 00:07:29,120
.إنّه مجيد ومفعم بالنّشاط

128
00:07:30,640 --> 00:07:33,400
.يبني الجميع برجًا معًا

129
00:07:34,130 --> 00:07:35,460
!أريد الذّهاب

130
00:07:35,460 --> 00:07:38,190
!لورن، لنذهب مع أبيل وهيزليتّا

131
00:07:38,190 --> 00:07:39,050
.أكيد

132
00:07:39,310 --> 00:07:40,840
!سنكون بالانتظار

133
00:07:43,720 --> 00:07:45,440
.هيّا، اتركيني

134
00:07:49,690 --> 00:07:53,210
!أتطلّع قدمًا للسّوق الشّتويّ

135
00:07:53,210 --> 00:07:56,310
!أودّ المساعدة في التّحضيرات أيضًا

136
00:07:57,000 --> 00:07:59,200
عفوًا يا سيّدتي القدّيسة؟

137
00:08:00,460 --> 00:08:04,590
ما هي العائلة في رأيك؟

138
00:08:04,590 --> 00:08:06,360
العائلة؟

139
00:08:06,840 --> 00:08:08,970
لماذا تسأل عن هذا فجأة؟

140
00:08:08,970 --> 00:08:12,660
.كنت أفكّر في أنّ حياة إريك المنزليّة لطيفة لا غير

141
00:08:13,960 --> 00:08:18,090
.أجد أنّ منزل إريك لطيف أيضًا

142
00:08:18,090 --> 00:08:20,200
...لنرَ

143
00:08:21,410 --> 00:08:23,600
،تأكل العائلة الطّعام معًا

144
00:08:24,000 --> 00:08:26,610
،وتقول لهم "تصبحون على خير" قبل النّوم

145
00:08:26,610 --> 00:08:29,760
.وهم أوّل من تقول لهم "مرحبًا" في الصّباح

146
00:08:29,760 --> 00:08:30,980
.هذه هي العائلة

147
00:08:30,980 --> 00:08:33,610
.هذا ما أعتقده على أيّ حال

148
00:08:36,610 --> 00:08:39,540
.لكنّه رأيي أنا فحسب

149
00:08:41,270 --> 00:08:44,720
.ربّما أكون قد جعلت الأمر أكثر تعقيدًا

150
00:08:45,680 --> 00:08:48,910
.لقد منحتني إجابة من السّهل فهمها

151
00:08:49,830 --> 00:08:51,880
!أنا قدّيسة قبل كلّ شيء

152
00:08:53,760 --> 00:08:56,030
.حسنًا، هذا جيّد. ببطء هناك

153
00:08:56,030 --> 00:08:57,270
!هيّا. هذا جيّد

154
00:08:57,280 --> 00:08:59,310
!أنت بارعة في هذا

155
00:08:59,310 --> 00:09:02,650
إنّها جميلة! ماذا إن أضفنا زهورًا هناك؟

156
00:09:01,700 --> 00:09:03,970
.هذا ما حدث إذًا

157
00:09:02,650 --> 00:09:03,970
!سيكون ذلك لطيفًا! نعم

158
00:09:05,720 --> 00:09:09,480
.يبدو أنّ القدّيسة وأنا أشبه بالعائلة

159
00:09:11,600 --> 00:09:14,880
ماذا تقول؟

160
00:09:14,880 --> 00:09:15,740
ماذا؟

161
00:09:15,740 --> 00:09:19,020
،هذه طريقة طويلة للنّظر للأمر
لكن لا بأس، صحيح؟

162
00:09:19,020 --> 00:09:21,800
.لا داعي لتحرير رغبتك في القتل هكذا يا آنستي

163
00:09:21,800 --> 00:09:24,120
!أنت متساهل جدًّا مع لورنس يا أبيل

164
00:09:24,120 --> 00:09:25,610
.إنّه صديقي

165
00:09:25,610 --> 00:09:27,920
.وأعلم مسبقًا أنّه بليد

166
00:09:27,920 --> 00:09:28,610
،إضافة لذلك

167
00:09:28,610 --> 00:09:33,600
الاعتراف بأنّها عائلة يعني أنّه لا يستهين بها، صحيح؟

168
00:09:34,700 --> 00:09:36,660
.إن نظرت للأمر هكذا

169
00:09:36,660 --> 00:09:39,520
،إن لم تظهر أنّكما عائلة بطريقة ما

170
00:09:39,520 --> 00:09:41,620
.فسأشعر بالسّوء حيال سيسيليا

171
00:09:41,620 --> 00:09:43,600
أ-أظهر أنّنا عائلة؟

172
00:09:43,840 --> 00:09:45,840
كيف؟

173
00:09:45,840 --> 00:09:46,850
...ما

174
00:09:51,470 --> 00:09:53,040
!ماذا؟

175
00:10:00,550 --> 00:10:01,950
.تحديق

176
00:10:04,090 --> 00:10:06,580
!لورن! أسرع! أسرع

177
00:10:06,580 --> 00:10:09,580
!لا تركضي رجاءً يا سيّدتي القدّيسة

178
00:10:18,080 --> 00:10:20,630
!لورن، إنّه البرج الّذي يتحدّث الجميع عنه

179
00:10:20,630 --> 00:10:21,480
!إنّه مذهل

180
00:10:21,480 --> 00:10:22,490
.نعم

181
00:10:22,490 --> 00:10:24,330
من أين نبدأ؟

182
00:10:24,330 --> 00:10:26,970
ماذا تريدين أن تري يا سيسيليا؟

183
00:10:26,970 --> 00:10:27,750
!كلّ شيء

184
00:10:27,750 --> 00:10:29,010
كلّ شيء؟

185
00:10:29,010 --> 00:10:31,440
!علينا الإسراع وإلاّ فلن نرى كلّ شيء

186
00:10:31,440 --> 00:10:33,480
!هيّا بنا

187
00:10:33,480 --> 00:10:36,410
!سيّدتي القدّيسة! انتظريني رجاءً

188
00:10:36,410 --> 00:10:38,330
.هيّا، لنذهب

189
00:10:38,330 --> 00:10:39,810
.نعم، نعم

190
00:11:12,730 --> 00:11:16,060
.أتساءل أين ذهب أبيل وهيزليتّا

191
00:11:16,060 --> 00:11:17,920
.انفصلنا عنهم بطريقة ما

192
00:11:17,920 --> 00:11:21,030
!سيّدتي القدّيسة! سيّدي القسّ

193
00:11:22,440 --> 00:11:23,680
!ليلي

194
00:11:23,680 --> 00:11:24,820
.مرحبًا

195
00:11:24,820 --> 00:11:27,950
!أنت ظريفة جدًّا اليوم يا سيّدتي القدّيسة

196
00:11:27,950 --> 00:11:28,790
ماذا؟

197
00:11:28,790 --> 00:11:30,880
...أ-أنا لستُ

198
00:11:33,790 --> 00:11:35,420
.توقّعت هذا

199
00:11:35,420 --> 00:11:36,360
ماذا؟

200
00:11:36,360 --> 00:11:37,840
!مع السّلامة

201
00:11:40,880 --> 00:11:42,280
!أيّها القسّ

202
00:11:43,400 --> 00:11:44,490
ماذا؟

203
00:11:44,490 --> 00:11:46,180
!تعاليا وتسوّقا منّا

204
00:11:46,180 --> 00:11:48,440
!إذًا فأنت هنا

205
00:11:48,440 --> 00:11:49,380
.هذا صحيح

206
00:11:49,380 --> 00:11:53,120
هلاّ أعرتني القدّيسة لاستدراج
بعض الزّبائن يا سيّدي القسّ؟

207
00:11:53,120 --> 00:11:53,880
ماذا؟

208
00:11:53,880 --> 00:11:55,430
.لن أقوم بذلك

209
00:11:56,190 --> 00:11:56,950
.أمزح فحسب

210
00:11:56,950 --> 00:11:59,360
.أنا أبلي حسنًا اليوم

211
00:11:59,360 --> 00:12:00,770
.أنا في استراحة الآن

212
00:12:00,770 --> 00:12:02,750
.هكذا إذًا

213
00:12:02,750 --> 00:12:04,210
.سيّدتي القدّيسة

214
00:12:04,950 --> 00:12:06,310
.تعالي للحظة

215
00:12:07,110 --> 00:12:10,450
.هذا فستان جديد أكملته للتّوّ

216
00:12:10,450 --> 00:12:12,800
!إنّه رائع

217
00:12:12,800 --> 00:12:15,600
هل تظنّ أنّه يناسب القدّيسة أيّها القسّ؟

218
00:12:16,680 --> 00:12:19,360
.أ-أعتقد أنّه سيبدو جميلاً عليها

219
00:12:22,690 --> 00:12:25,340
لماذا تضربيني هكذا؟

220
00:12:25,840 --> 00:12:27,840
...سيّدتي القدّيسة

221
00:12:28,960 --> 00:12:31,720
—أيّها القسّ، هل يُعقل أنّ

222
00:12:31,720 --> 00:12:34,850
.هذا أمر لا يجب أن يُقال

223
00:12:36,060 --> 00:12:37,600
لم لا؟

224
00:12:37,600 --> 00:12:39,400
يعلم الجميع به، صحيح؟

225
00:12:39,400 --> 00:12:41,360
...حسنًا

226
00:12:41,360 --> 00:12:45,000
...إنّ سبب امتناع الجميع عن قوله

227
00:12:45,000 --> 00:12:47,490
...هو أنّ لحظة الإدراك  والوصول إلى تلك الحقيقة

228
00:12:47,490 --> 00:12:51,120
.مهمّان جدًّا للطّرفين المعنيّين بالأمر

229
00:12:51,120 --> 00:12:53,490
،عدم السّماح لهما باكتشاف تلك الأشياء بنفسيهما

230
00:12:53,490 --> 00:12:57,280
،ومحاولة دفع علاقتهما للأمام
.هو طموحنا الّذي علينا إن نوقفه

231
00:12:57,600 --> 00:12:58,370
...لكن

232
00:12:58,740 --> 00:13:01,680
ربّما هذا أمر لا يمكنك فهمه بعد؟

233
00:13:02,560 --> 00:13:04,000
.أنا أفهم

234
00:13:04,000 --> 00:13:07,680
إنّك تخبريني بأن أكون مراعيًا لمشاعرهما، صحيح؟

235
00:13:07,680 --> 00:13:09,180
!أنت ذكيّ

236
00:13:09,680 --> 00:13:12,930
.لا تعامليني كطفل رجاءً

237
00:13:13,320 --> 00:13:16,180
لماذا تقولين شيئًا كهذا؟

238
00:13:16,180 --> 00:13:18,100
هل فقدت السّيطرة على نفسك؟

239
00:13:18,100 --> 00:13:21,740
.لأنّي لم أستطع التّفكير في أيّ شيء آخر

240
00:13:21,740 --> 00:13:24,180
.ومع ذلك، تقولين هذا دون سواه

241
00:13:24,180 --> 00:13:27,570
لا تقومان أنت وغيزلبرت بذلك كثيرًا، صحيح؟

242
00:13:27,570 --> 00:13:29,570
لماذا قد أقوم بذلك معه؟

243
00:13:33,280 --> 00:13:35,150
.بدأ الثّلج بالتّساقط

244
00:13:40,460 --> 00:13:45,590
.ألست سعيدًا؟ هذا ظريف

245
00:13:50,010 --> 00:13:53,080
الأمور حافلة اليوم، صحيح يا فريديريكا؟

246
00:13:53,790 --> 00:13:56,360
.آمل أنّ تجد تلك القدّيسة السّعادة

247
00:13:56,800 --> 00:13:58,860
.اعتني بها رجاءً

248
00:14:07,050 --> 00:14:10,450
لورن، إلى أين سنذهب؟

249
00:14:10,450 --> 00:14:12,120
.بقي القليل فحسب

250
00:14:17,330 --> 00:14:19,160
.سيحدث الأمر قريبًا

251
00:14:31,410 --> 00:14:34,010
!هذا جميل يا لورن

252
00:14:34,520 --> 00:14:37,010
!جميل جدًّا

253
00:14:41,000 --> 00:14:43,140
،سيّدتي القدّيسة

254
00:14:43,140 --> 00:14:46,210
هل مسموح لي أن أعتبرك
وأفكّر فيك كفرد من العائلة أيضًا؟

255
00:14:46,210 --> 00:14:48,900
!لـ-لماذا تقول هذا فجأة؟

256
00:14:48,900 --> 00:14:50,120
!بالطّبع

257
00:14:50,120 --> 00:14:53,230
يمكنك القول أنّنا عائلة
!أو أنّي أوّد أن أصير فردًا من عائلتك

258
00:14:53,230 --> 00:14:56,150
،قلتِ يومها أنّ النّاس الّذين نأكل معهم

259
00:14:56,150 --> 00:14:58,250
،والنّاس الّذين نقول لهم تصبحون على خير

260
00:14:58,250 --> 00:15:02,920
والنّاس الّذين نقول لهم مرحبًا
...في الصّباح هم العائلة، لذلك

261
00:15:02,920 --> 00:15:06,420
.تقصد بتلك الطّريقة

262
00:15:06,790 --> 00:15:08,760
.نعم

263
00:15:09,240 --> 00:15:13,520
.أعتبرك كعائلتي بالفعل

264
00:15:20,020 --> 00:15:21,890
!لـ-لـ-لورن؟

265
00:15:21,890 --> 00:15:25,030
.إن كنتِ عائلتي، فعليك فعل أشياء كهذه

266
00:15:25,030 --> 00:15:27,400
.هذا ما قالته لي الآنسة هيزليتّا

267
00:15:27,410 --> 00:15:31,320
.إ-إن كنّا عائلة، فنعم
.يمكننا فعل أشياء كهذه

268
00:15:31,780 --> 00:15:33,230
.أنا آسف

269
00:15:33,230 --> 00:15:35,040
جعلتك غير مرتاحة هكذا، صحيح؟

270
00:15:35,040 --> 00:15:36,110
ماذا؟

271
00:15:36,110 --> 00:15:37,400
!كـ-كلاّ، على العكس تمامًا

272
00:15:37,400 --> 00:15:38,850
...فعلاً؟ لكن

273
00:15:38,850 --> 00:15:39,960
...في الحقيقة

274
00:15:39,960 --> 00:15:43,310
...بل أسعـ

275
00:15:44,450 --> 00:15:46,080
!أنا جدّ آسف

276
00:15:46,080 --> 00:15:47,150
!لن أفعل ذلك ثانية

277
00:15:47,150 --> 00:15:48,650
!لن أقبل بذلك

278
00:15:48,650 --> 00:15:49,580
ماذا؟

279
00:15:49,580 --> 00:15:53,470
.ا-الأمر ليس أنّي لم أحبّ ذلك

280
00:15:53,470 --> 00:15:55,720
...لذلك

281
00:15:57,510 --> 00:16:00,100
...إن فعلتها ثانية

282
00:16:02,150 --> 00:16:04,970
.أنت صريح جدًّا

283
00:16:10,590 --> 00:16:12,110
...لورن

284
00:16:12,110 --> 00:16:17,280
يبدو الأمر كما لو أنّك تتخبّط
.وتجرّب طرقًا للتّصرّف كعائلة

285
00:16:17,750 --> 00:16:22,120
.تقول أنّك تعتبرني عائلتك، لكنّك تبدو قلقًا

286
00:16:22,630 --> 00:16:28,030
هل هناك أمر معيّن تسعى للعثور
عليه في العائلة؟

287
00:16:30,300 --> 00:16:32,260
،لورنس

288
00:16:32,260 --> 00:16:35,880
.الموت ليس أمرًا يجب أن نخشاه

289
00:16:35,880 --> 00:16:39,800
.المغادرة في رحلة أمر يجب أن نسعد به

290
00:16:39,800 --> 00:16:44,140
...لكن إن كان هنالك ما أندم عليه

291
00:16:44,140 --> 00:16:50,840
.فسيكون تركك هنا وحيدًا في هذا المنزل الكبير

292
00:16:52,680 --> 00:16:57,010
.كنتُ وحيدًا منذ وفاة جدّي

293
00:16:57,640 --> 00:17:01,940
ولكن منذ اليوم الّذي أتيت فيه
...يا سيّدتي القدّيسة

294
00:17:03,450 --> 00:17:09,200
.عشت معك... وكنتُ سعيدًا كلّ يوم

295
00:17:09,520 --> 00:17:13,600
،ظننتُ أنّنا إن كنّا عائلة
.فستظلّين إلى جانبي دائمًا

296
00:17:14,160 --> 00:17:16,630
.ووجدت نفسي أفكّر في الأمر تلقائيًّا

297
00:17:19,970 --> 00:17:21,520
.أنا هنا

298
00:17:23,100 --> 00:17:25,070
.سأكون هنا دائمًا

299
00:17:25,890 --> 00:17:28,020
!لأنّنا عائلة

300
00:17:40,650 --> 00:17:42,460
لـ-لورن؟

301
00:17:42,460 --> 00:17:44,530
.أ-أنا آسف

302
00:17:44,840 --> 00:17:49,620
عفوًا، ولكن اعترتني هذه الرّغبة
.الغامرة بالرّكض بعيدًا فجأة

303
00:17:52,640 --> 00:17:54,000
!سيّدتي القدّيسة؟

304
00:17:54,000 --> 00:17:55,560
،لورن

305
00:17:55,560 --> 00:17:59,000
لا أعتقد أنّك تعرف كيف تطلب
...من عائلتك أن يحضنوك

306
00:17:59,000 --> 00:18:01,880
.لذلك فأنا أريك كيف

307
00:18:05,640 --> 00:18:09,230
ليس مسموحًا لك أن تنسى الآن، مفهوم؟

308
00:18:09,740 --> 00:18:11,080
.حاضر

309
00:18:18,760 --> 00:18:19,860
!هذا مؤلم

310
00:18:21,120 --> 00:18:24,200
سمعتُ ضجّة عالية! هل أنت بخير؟

311
00:18:24,200 --> 00:18:26,610
.صباح الخير يا لورن

312
00:18:26,610 --> 00:18:30,190
.كنت لا أزال شبه نائمة ودخلت في الحائط

313
00:18:30,190 --> 00:18:31,880
.صباح الخير

314
00:18:31,880 --> 00:18:34,050
إلى أيّ حدّ أنت شبه نائمة؟

315
00:18:34,050 --> 00:18:36,150
.ظننتُ أنّ الجدار كان أنت

316
00:18:36,150 --> 00:18:38,800
إلى أيّ مدى لا تزالين نائمة بالفعل؟

317
00:18:38,800 --> 00:18:40,290
لورن؟

318
00:18:40,290 --> 00:18:41,780
هل كنت تطبخ؟

319
00:18:43,330 --> 00:18:45,300
.أعتقد أنّي أحضرت هذه معي

320
00:18:45,300 --> 00:18:46,940
!أ-أنا آسفة

321
00:18:46,940 --> 00:18:48,690
لقد سبّبت لك الإزعاج، صحيح؟

322
00:18:48,690 --> 00:18:51,600
من الطّبيعيّ لي أن آتي راكضًا
.عندما يحدث شيء ما لك

323
00:18:51,600 --> 00:18:53,360
!لأنّنا عائلة

324
00:18:55,080 --> 00:18:56,860
...عائلة

325
00:19:01,120 --> 00:19:02,700
،رغم كلّ ما تقولينه

326
00:19:02,700 --> 00:19:05,410
ينتهي بنا الأمر بأكل ثلاث وجبات
في اليوم هنا، صحيح؟

327
00:19:05,410 --> 00:19:08,760
.هذا لأنّني قرّرت القبول بعرضهما

328
00:19:08,760 --> 00:19:10,660
.إنّها تتصرّف بجرأة

329
00:19:10,660 --> 00:19:13,840
!أفضّل لو تعيشان هنا معنا كما في السّابق

330
00:19:13,840 --> 00:19:14,920
ما رأيكما؟

331
00:19:14,920 --> 00:19:16,610
.سيكون ذلك لطيفًا

332
00:19:16,610 --> 00:19:18,290
عمّ تتكلّم؟

333
00:19:18,290 --> 00:19:20,290
.لا يمكننا ذلك على الإطلاق

334
00:19:20,290 --> 00:19:21,430
.سمعتِها

335
00:19:21,430 --> 00:19:23,160
.فهمت

336
00:19:23,160 --> 00:19:26,070
.لكنّنا نرى بعضنا كلّ يوم هكذا

337
00:19:26,070 --> 00:19:27,860
!هذا صحيح

338
00:19:27,860 --> 00:19:28,850
...عفوًا

339
00:19:29,560 --> 00:19:32,440
أليس هذا البيض محروقًا؟

340
00:19:32,440 --> 00:19:34,490
.هذا على غير العادة

341
00:19:34,490 --> 00:19:36,980
.لا أصدّق أنّ لورنس قد يخطئ هكذا

342
00:19:37,910 --> 00:19:40,560
!إنّها غلطتي

343
00:19:40,560 --> 00:19:41,360
ماذا؟

344
00:19:41,360 --> 00:19:43,620
.ليست غلطتك يا سيّدتي القدّيسة

345
00:19:43,620 --> 00:19:45,730
.لم أكن منتبهًا

346
00:19:45,730 --> 00:19:48,080
.لا، بل غلطتي

347
00:19:48,080 --> 00:19:48,880
.لا

348
00:19:48,880 --> 00:19:51,700
.إنّها غلطتي لأنّي لم أنقص من الحرارة

349
00:19:51,700 --> 00:19:54,940
لا، بل أنا السّبب لأنّي اصطدمت
.بالحائط وأنا شبه نائمة

350
00:19:54,940 --> 00:19:57,960
.لا، ليست غلطتك يا سيّدتي القدّيسة

351
00:19:57,960 --> 00:20:01,230
!وليست غلطتك أيضًا يا لورن

352
00:20:01,230 --> 00:20:03,090
!القدّيسات لا يكذبن

353
00:20:03,090 --> 00:20:05,640
...الأمر لا يتعلّق بالكذب، بل

354
00:20:05,640 --> 00:20:07,870
!هيّا. أسرعا وكُلا فطوركما

355
00:20:07,870 --> 00:20:09,520
.حاضر

356
00:20:09,520 --> 00:20:13,110
يا إلهي. إنّهما متوافقان جدًّا مع بعضهما، صحيح؟

357
00:21:46,310 --> 00:21:48,100
!أنا ليلي

358
00:21:48,100 --> 00:21:50,860
!أنا أزور الكنيسة دائمًا للّعب

359
00:21:51,500 --> 00:21:55,410
...في السّابق، عندما قلتُ أنّي سأتزوّج بالقسّ

360
00:21:55,410 --> 00:21:58,500
.علت ملامح غريبة وجه القدّيسة

361
00:21:58,500 --> 00:22:02,000
،أخبرتني أشياء كثيرة عن القسّ

362
00:22:02,000 --> 00:22:05,000
.لكنّي لا أفهم فعلاً ما كانت تقوله

363
00:22:05,480 --> 00:22:06,760
ولكن أتعلمون؟

364
00:22:07,670 --> 00:22:10,260
!سيّدي القسّ! صباح الخير

365
00:22:10,260 --> 00:22:12,430
!صباح الخير يا ليلي

366
00:22:12,430 --> 00:22:15,350
هل أحضرت لنا أزهارًا اليوم أيضًا؟

367
00:22:15,350 --> 00:22:16,240
!نعم

368
00:22:16,240 --> 00:22:18,760
!سأعطيها للسّيّدة القدّيسة لاحقًا

369
00:22:18,760 --> 00:22:19,510
!مهلاً

370
00:22:19,510 --> 00:22:22,260
!صار المقعد إلى جانب القدّيسة شاغرًا الآن

371
00:22:22,260 --> 00:22:23,880
.سأذهب

372
00:22:26,030 --> 00:22:27,700
!سيّدتي القدّيسة

373
00:22:27,700 --> 00:22:29,280
!ليلي

374
00:22:30,060 --> 00:22:32,880
.إنّ القدّيسة جميلة وتتألّق دائمًا

375
00:22:32,880 --> 00:22:35,280
.إنّها مذهلة

376
00:22:35,640 --> 00:22:37,420
الجوّ لطيف اليوم، صحيح؟

377
00:22:37,420 --> 00:22:39,020
!معك حقّ

378
00:22:39,020 --> 00:22:42,260
.أنا مسرورة لأنّك لم تتبلّلي بالمطر يا ليلي

379
00:22:42,260 --> 00:22:45,460
.يبدو أنّك ستأتين إلى هنا حتّى في الأيّام الماطرة

380
00:22:45,460 --> 00:22:47,440
ماذا؟ ألا يمكنني المجيء؟

381
00:22:47,440 --> 00:22:48,920
سيّدتي القدّيسة؟

382
00:22:49,310 --> 00:22:51,370
.آسف يا ليلي. سيأخذ الأمر لحظة فحسب

383
00:22:51,370 --> 00:22:52,920
ماذا هنالك؟

384
00:22:52,920 --> 00:22:54,810
.أنا أعلم

385
00:22:54,810 --> 00:22:58,810
...عندما تكون القدّيسة قريبة من القسّ

386
00:22:58,810 --> 00:23:01,360
!تصير ظريفة للغاية

387
00:23:02,070 --> 00:23:04,320
.ربّما سنراكما الأسبوع القادم أيضًا

388
00:23:04,320 --> 00:23:06,610
.نعم، سنكون في الانتظار

389
00:23:07,560 --> 00:23:09,610
!تفضّلي! هذه أزهار

390
00:23:09,870 --> 00:23:12,120
!كِلا الزّهرتين لي أنا؟

391
00:23:12,120 --> 00:23:14,680
...نعم! وأيضًا

392
00:23:17,510 --> 00:23:21,090
.سأسمح لك بأخذ القسّ يا سيّدتي القدّيسة

393
00:23:22,380 --> 00:23:24,100
!مع السّلامة