1
00:00:01,740 --> 00:00:05,230
،تحمي القدّيسات النّاس

2
00:00:05,640 --> 00:00:10,990
.ونحمي نحن أولئك الّذين يحموننا

3
00:00:10,990 --> 00:00:12,990
هل تفهم يا لورنس؟

4
00:00:13,660 --> 00:00:19,240
.لا يجدر بك نسيان ذلك إذا ما قابلتَ قدّيسة

5
00:00:19,240 --> 00:00:23,160
.فقبل كلّ شيء، أنت مختلف قليلاً عن البقيّة

6
00:00:32,760 --> 00:00:34,640
!سيّدي القسّ

7
00:00:37,520 --> 00:00:39,520
.مرحبًا بك

8
00:00:39,520 --> 00:00:41,880
.آسفة على الإزعاج بالنّظر لانشغالاتك

9
00:00:41,880 --> 00:00:46,390
هنالك أمر يودّ ابني أن يتحدّث
.به مع القدّيسة وحدها

10
00:00:47,270 --> 00:00:50,150
ما الخطب الّذي جعل وجهك كئيبًا هكذا؟

11
00:00:50,490 --> 00:00:51,810
.لا بأس

12
00:00:51,810 --> 00:00:53,900
.ليس لديها أيّ مواعيد الآن

13
00:00:54,280 --> 00:00:56,900
.القدّيسة في الدّاخل

14
00:00:56,900 --> 00:00:57,910
!سيّدتي القدّيسة

15
00:00:59,160 --> 00:01:00,080
ماذا؟

16
00:01:05,420 --> 00:01:07,770
أهنالك أمر تودّان الحديث عنه معي؟

17
00:01:10,240 --> 00:01:14,250
.هكذا انتهت الأمور بيني وبين صديقي بعد خصامنا

18
00:01:14,250 --> 00:01:16,800
.سيكون من الصّعب رؤيته ثانية غدًا

19
00:01:16,800 --> 00:01:19,680
ماذا أفعل يا سيّدتي القدّيسة؟

20
00:01:19,960 --> 00:01:23,510
حسنًا، ما الذي قد يجعل رؤيته ثانية مؤلمة أقلّ؟

21
00:01:23,510 --> 00:01:24,390
ماذا؟

22
00:01:24,390 --> 00:01:25,600
...عفوًا

23
00:01:25,600 --> 00:01:28,900
ربّما العودة لسابق عهدنا قبل الشّجار؟

24
00:01:28,900 --> 00:01:32,850
هل يمكنك استعمال قوّتك للعودة بالزّمن للوراء؟

25
00:01:32,850 --> 00:01:34,300
.لا يمكنني

26
00:01:35,290 --> 00:01:40,410
كلّ ما يمكنني فعله هو إرشاد النّاس
.بينما يسلكون دروبهم في الحياة

27
00:01:40,410 --> 00:01:44,410
إن لم يستجمع النّاس شجاعتهم
...ويسيروا عليها بأنفسهم، فحينها

28
00:01:44,770 --> 00:01:48,530
كما أنّك تعرف سلفًا ماذا يجب عليك فعله، صحيح؟

29
00:01:48,530 --> 00:01:53,020
.لا تقلق. هذا هو الدّرب الصّحيح

30
00:01:53,020 --> 00:01:56,990
هل كانت زيارتنا هذه لطلب
نصيحة القدّيسة فيها قلّة احترام؟

31
00:01:56,990 --> 00:01:58,240
.على الإطلاق

32
00:01:58,240 --> 00:02:02,040
.القدّيسة مستعدّة لسماع إلى كلّ ما يقلق الآخرين

33
00:02:02,300 --> 00:02:05,180
.إنّها تقبل شكوك النّاس تردّدهم وتقدّم يد العون

34
00:02:05,840 --> 00:02:08,480
.فهذا هو واجب القدّيسات جميعًا

35
00:03:45,670 --> 00:03:47,990
.أبليت حسنًا يا سيّدتي القدّيسة

36
00:03:47,990 --> 00:03:49,490
...كنتُ أتساءل

37
00:03:49,490 --> 00:03:51,540
...استرخاء

38
00:03:51,540 --> 00:03:56,470
ألا تعتقدين أنّ هنالك تباينًا كبيرًا بين
سلوكك السّابق ومظهرك الحاليّ؟

39
00:03:56,470 --> 00:03:58,350
ذلك لا يهمّ، صحيح؟

40
00:03:58,350 --> 00:04:00,870
.فقبل كلّ شيء، لا يوجد غيرك هنا يا لورنس

41
00:04:00,870 --> 00:04:01,960
فعلاً؟

42
00:04:01,960 --> 00:04:03,840
.لا تقلق يا لورن

43
00:04:03,840 --> 00:04:06,530
.سأجلس باعتدال في الحال إن أتى أحد ما

44
00:04:06,530 --> 00:04:08,520
—تلك ليست المشكلة الّتي كنتُ

45
00:04:08,520 --> 00:04:10,050
!سيّدي القسّ

46
00:04:10,050 --> 00:04:13,290
!هنالك أمر شيء أريد منحه للقدّيسة

47
00:04:11,190 --> 00:04:13,290
!تمهّلي لحظة رجاءً

48
00:04:17,220 --> 00:04:22,040
.تبدين رائعة يا سيّدتي القدّيسة

49
00:04:20,160 --> 00:04:24,450
.تتصرّف القدّيسة بتكاسل أمامي أنا فقط لسبب ما

50
00:04:22,040 --> 00:04:24,440
.شكرًا على المجاملة

51
00:04:24,730 --> 00:04:27,050
...تكاسل

52
00:04:27,050 --> 00:04:30,460
سبق وسألتك، ولكن لماذا تتصرّفين هكذا؟

53
00:04:30,460 --> 00:04:32,920
.لأنّه لا يوجد أحد غيرنا هنا

54
00:04:32,920 --> 00:04:35,330
—وأنا سبق وأخبرتك أنّ هذه ليست المشكلة

55
00:04:35,330 --> 00:04:37,460
!سيّدتي القدّيسة

56
00:04:40,480 --> 00:04:42,210
!مرحبًا بالجميع

57
00:04:43,610 --> 00:04:46,800
لماذا تتصرّف بتكاسل أمامي أنا فقط؟

58
00:04:47,220 --> 00:04:52,290
!مع السّلامة يا سيّدتي القدّيسة ويا سيّدي القسّ

59
00:04:54,220 --> 00:04:56,030
...استرخاء

60
00:04:56,030 --> 00:04:57,730
!سيّدتي القدّيسة

61
00:04:58,970 --> 00:05:01,830
.اعتقد أنّك تبالغين كثيرًا بتكاسلك

62
00:05:01,830 --> 00:05:02,960
تكاسلي؟

63
00:05:02,960 --> 00:05:03,780
.نعم

64
00:05:03,780 --> 00:05:07,060
لماذا تتكاسلين هكذا بعدما
لا يوجد غيري في الجوار؟

65
00:05:07,060 --> 00:05:09,160
...عفوًا، ذلك

66
00:05:09,160 --> 00:05:13,360
تسألني عن هذا مع أنّك أنت
.من لا يسمح لي بالقيام بأيّ شيء

67
00:05:13,360 --> 00:05:15,960
.لا تسمح لي بالحفر بالفأس

68
00:05:15,960 --> 00:05:18,600
.لأنّك قد تقعين وتؤذين نفسك

69
00:05:18,600 --> 00:05:20,800
.ولا تسمح لي بالطّبخ أيضًا

70
00:05:21,070 --> 00:05:23,800
.لأنّك قد تخرقين نفسك

71
00:05:27,130 --> 00:05:28,160
!حسنًا

72
00:05:28,160 --> 00:05:31,270
.سأذهب للقيام بجولتي وأزور كلّ المنازل

73
00:05:31,270 --> 00:05:32,420
—وأنت يا سيّدتي القدّيسة

74
00:05:32,420 --> 00:05:33,180
!سأرافقك

75
00:05:33,180 --> 00:05:33,890
ماذا؟

76
00:05:33,890 --> 00:05:35,890
.لكنّك ستضطرّين للسّير كثيرًا

77
00:05:35,890 --> 00:05:37,210
.قلتُ سأرافقك

78
00:05:37,210 --> 00:05:38,790
.حسنًا

79
00:05:38,790 --> 00:05:41,790
،لكن إن طلبوا أن تريهم معجزة ما

80
00:05:41,790 --> 00:05:43,860
.احرصي على تفادي ذلك الموضوع بمهارة

81
00:05:44,260 --> 00:05:48,920
قواك الغامضة ليست أمرًا يمكن
.رؤيته بالعيون قبل كلّ شيء

82
00:05:48,920 --> 00:05:50,360
.مفهوم

83
00:05:50,360 --> 00:05:52,370
هل ستكونين بخير بالفعل؟

84
00:05:52,370 --> 00:05:54,040
.لا تتصرّف بفظاظة

85
00:05:54,040 --> 00:05:56,600
.سأثبت لك الآن في تلك الحالة

86
00:05:56,600 --> 00:05:58,620
.حسنًا، لو سمحت

87
00:05:58,620 --> 00:06:00,560
...لديّ هنا مجموعة بطاقات لعب

88
00:06:00,560 --> 00:06:01,880
!ستبقين هنا

89
00:06:01,880 --> 00:06:03,670
!سـ-سأكون بخير

90
00:06:03,670 --> 00:06:06,320
!أعد ألاّ أفعل أيّ شيء غريب

91
00:06:06,320 --> 00:06:08,170
.حسنًا

92
00:06:08,170 --> 00:06:10,320
.في تلك الحالة، سأقوم بالتّحضيرات اللاّزمة

93
00:06:10,320 --> 00:06:11,480
!حسنًا

94
00:06:13,460 --> 00:06:17,560
سـ-سأخرج مع لورن؟

95
00:06:18,880 --> 00:06:20,580
!أنا سعيدة جدًّا

96
00:06:20,580 --> 00:06:22,820
...ولكن قبل ذلك

97
00:06:22,820 --> 00:06:25,430
!اجتمعي هنا يا ملائكة الكنيسة

98
00:06:30,360 --> 00:06:31,930
.أيّتها الملائكة

99
00:06:31,930 --> 00:06:34,830
هل كنت تتبعين لورن ثانية؟

100
00:06:36,840 --> 00:06:39,760
،أفهم تمامًا أنّه من المريح التّواجد إلى جواره

101
00:06:39,760 --> 00:06:42,330
ولكن ألا يمكنك التّوقّف عن ذلك ولو قليلاً؟

102
00:06:42,330 --> 00:06:45,720
،أنا أشعر بالغيرة في الحقيقة
.لذلك كفّي عن ذلك رجاءً

103
00:06:46,200 --> 00:06:47,890
.آسف لجعلك تنتظرين

104
00:06:49,550 --> 00:06:51,210
هل من خطب ما؟

105
00:06:51,210 --> 00:06:53,640
...ذلك... ليس

106
00:06:53,640 --> 00:06:56,050
!هيّا بنا، علينا أن نسرع

107
00:06:56,050 --> 00:06:57,150
.انتظريني رجاءً

108
00:06:57,150 --> 00:06:59,220
!قد تتعثّرين وتقعين إن أسرعتِ

109
00:07:02,790 --> 00:07:04,740
.إنّك في مزاج جيّد جدًّا

110
00:07:05,990 --> 00:07:09,150
!مرحبًا بكما يا سيّدي القسّ وسيّدتي القدّيسة

111
00:07:09,600 --> 00:07:10,920
!مرحبًا

112
00:07:11,400 --> 00:07:12,690
.أنا جادّ

113
00:07:12,690 --> 00:07:15,640
لماذا لا تتظاهر هكذا عندما نكون بمفردنا؟

114
00:07:17,720 --> 00:07:21,320
لنقم إذًا بنفس الشّيء الأسبوع القادم
.إن لم تكن لديك اعتراضات

115
00:07:21,320 --> 00:07:23,110
!إنّها القدّيسة

116
00:07:23,110 --> 00:07:24,170
!سيّدتي القدّيسة

117
00:07:24,170 --> 00:07:26,550
!أرنا معجزة رجاءً

118
00:07:26,970 --> 00:07:29,720
!معجزة! معجزة

119
00:07:29,720 --> 00:07:33,840
،أعرف أنّنا في منتصف محادثة
لكن هلاّ أذنت لي بدقيقة؟

120
00:07:33,960 --> 00:07:37,070
،لم أستطع إبعادهم عن ذلك الموضوع

121
00:07:37,070 --> 00:07:39,600
.لذلك لم يسعني سوى التزام الصّمت

122
00:07:39,600 --> 00:07:42,680
.بدوت لي تائهة وقتها بالفعل

123
00:07:43,340 --> 00:07:44,360
...إنّني

124
00:07:44,360 --> 00:07:48,860
...حاليًّا، علينا إيجاد طريقة لإقناع الأطفال

125
00:07:53,270 --> 00:07:55,600
!أنت مذهلة يا سيّدتي القدّيسة

126
00:07:55,600 --> 00:07:57,550
.وفى ذلك بالغرض

127
00:07:58,820 --> 00:08:00,360
،يا سيّدتي القدّيسة

128
00:08:00,360 --> 00:08:02,660
.أودّ التّوقّف هنا لبعض الوقت

129
00:08:02,660 --> 00:08:04,350
هل ستشتري شيئًا ما؟

130
00:08:04,350 --> 00:08:05,080
.لا

131
00:08:05,080 --> 00:08:07,740
.بما أنّنا هنا، فكّرت في إلقاء التّحيّة على مالك المحلّ

132
00:08:07,740 --> 00:08:09,840
هل تمانعين أخذت بعض الوقت لفعل ذلك؟

133
00:08:09,840 --> 00:08:12,390
.لا، تفضّل بذلك

134
00:08:13,470 --> 00:08:15,240
...تحديق

135
00:08:17,980 --> 00:08:20,240
!آسفة لإخافتك

136
00:08:20,240 --> 00:08:21,180
.مرحبًا

137
00:08:21,180 --> 00:08:24,000
.مرّ وقت طويل مذ زرتني آخر مرّة أيّها القسّ

138
00:08:23,140 --> 00:08:25,280
محلّ ملابس؟

139
00:08:24,010 --> 00:08:25,680
.أنا آسف لأنّني لا أمرّ عليك كثيرًا

140
00:08:25,960 --> 00:08:28,650
يمكنك التّجوّل في المحلّ
!إن أردت يا سيّدتي القدّيسة

141
00:08:30,820 --> 00:08:34,690
.في تلك الحالة، سأقبل عرضك وأستمتع بوقتي

142
00:08:34,690 --> 00:08:38,700
.إنّها معتادة فعلاً على التّبديل بين حالتيها بسرعة

143
00:08:39,120 --> 00:08:40,900
كيف حال إريك؟

144
00:08:39,960 --> 00:08:43,200
.لديها أشياء كثيرة

145
00:08:40,900 --> 00:08:42,400
!إنّه بخير

146
00:08:42,400 --> 00:08:43,840
.سرّني سماع ذلك

147
00:08:48,600 --> 00:08:51,540
!كـ-كم هذا جميل

148
00:08:51,540 --> 00:08:54,080
هذا نادر! أظهرت طبيعتها
!الحقيقيّة أمام شخص آخر

149
00:08:54,080 --> 00:08:56,040
إنّه مذهل، صحيح؟

150
00:08:56,040 --> 00:08:59,960
.كلّ الفتيات اللاّتي تأتين إلى هنا تسعدن برؤيته

151
00:08:59,960 --> 00:09:03,870
!فستان الزّفاف ليس شيئًا يراه المرء كلّ يوم

152
00:09:03,870 --> 00:09:05,420
زفاف؟

153
00:09:05,420 --> 00:09:06,310
.نعم

154
00:09:06,310 --> 00:09:10,100
لا يقوم قسّ الكنيسة بأيّ حفلات زفاف، صحيح؟

155
00:09:10,100 --> 00:09:12,100
.لا تسنح لي الفرصة لفعل ذلك

156
00:09:12,110 --> 00:09:17,060
ستتزوّج ابنة أحد أصدقائي ممّن
،يعيشون بعيدًا قريبًا

157
00:09:17,060 --> 00:09:19,720
.وطُلب منّي إن أحضّر الفستان

158
00:09:19,720 --> 00:09:24,740
،أنهيته قبل الموعد المتّفق عليه
.لذلك سأعرضه هنا لبعض الوقت

159
00:09:24,740 --> 00:09:27,000
.هكذا إذًا

160
00:09:33,610 --> 00:09:35,980
...إنّ ارتداء شيء كهذا

161
00:09:36,800 --> 00:09:39,610
.لا بدّ أنّه سيُسعدها كثيرًا

162
00:09:40,130 --> 00:09:42,840
.كم هي ظريفة

163
00:09:42,840 --> 00:09:44,930
.أريد أن تكون لي ابنة بشدّة

164
00:09:44,930 --> 00:09:46,890
لماذا تنظرين إليّ؟

165
00:09:46,890 --> 00:09:49,620
ليس لديك ابنة؟

166
00:09:49,620 --> 00:09:52,150
.أطفالي كلّهم أولاد

167
00:09:52,150 --> 00:09:56,520
لذا لا يسعني سوى أن أعجب بالفتيات
!الظّريفات مثلك يا سيّدتي القدّيسة

168
00:09:56,520 --> 00:09:58,930
...كـ-كلاّ، أنا فعلاً لستُ

169
00:09:58,930 --> 00:10:00,690
عمّ تتكلّمين؟

170
00:10:00,690 --> 00:10:03,990
.يقول جميع من في القرية هذا عنك

171
00:10:03,990 --> 00:10:06,500
!لا-لا أعرف أيّ شيء عن هذا

172
00:10:07,920 --> 00:10:10,310
.أردتُ ابنة بالفعل

173
00:10:10,310 --> 00:10:13,000
ولكن لماذا تنظرين إليّ؟

174
00:10:13,000 --> 00:10:15,000
.حسنًا، أظنّ أنّ هذا كلّ شيء لليوم

175
00:10:15,000 --> 00:10:17,000
.تفضّلي يا سيّدتي القدّيسة

176
00:10:17,000 --> 00:10:18,190
ماذا؟

177
00:10:18,190 --> 00:10:21,320
،بما أنّك أتيت كلّ هذه المسافة إلى هنا
.قطعة الملابس تلك من أجلك

178
00:10:21,320 --> 00:10:23,830
.لا أستطيع. مجرّد تفكيرك في ذلك يكفيني

179
00:10:23,830 --> 00:10:25,470
ما الّذي تقولينه؟

180
00:10:25,470 --> 00:10:28,620
.إنّك تساعديننا دائمًا يا سيّدتي القدّيسة

181
00:10:28,620 --> 00:10:30,900
.اقبلي منّا أشياءً أيضًا رجاءً

182
00:10:32,080 --> 00:10:33,400
...دموع

183
00:10:33,400 --> 00:10:37,370
.يا إلهي. لم أتخيّل أبدًا أنّ هذا سيسعدك هكذا

184
00:10:37,370 --> 00:10:39,650
،ولكن بدل قطعة ملابس كهذه

185
00:10:40,240 --> 00:10:44,040
سأحضّر فستان زفاف من أجلك
في أيّ وقت، موافقة؟

186
00:10:45,200 --> 00:10:48,050
!لـ-لنذهب يا لورن

187
00:10:48,050 --> 00:10:50,120
!لا تندفعي للخارج هكذا رجاءً

188
00:10:50,120 --> 00:10:51,390
.أستأذن

189
00:10:53,840 --> 00:10:56,130
!انتظري رجاءً يا سيّدتي القدّيسة

190
00:10:56,130 --> 00:10:58,340
هل تشعرين بتوعّك ما؟

191
00:10:58,340 --> 00:11:01,240
.كـ-كلاّ، أنا بخير

192
00:11:05,350 --> 00:11:09,100
!انظر يا لورن! إنّه قطّ

193
00:11:16,280 --> 00:11:20,690
تهرب الحيوانات منّي دائمًا
.لمجرّد محاولة الاقتراب منها

194
00:11:20,690 --> 00:11:23,960
.أتمنّى لو أستطيع لمس إحداها ولو لمرّة

195
00:11:24,600 --> 00:11:28,720
.آمل أن تتحقّق أمنيته يومًا ما

196
00:11:31,390 --> 00:11:33,290
—سيّدتي القدّيسة، ادخلي أوّلاً و

197
00:11:33,290 --> 00:11:34,710
!انتظر رجاءً

198
00:11:35,950 --> 00:11:40,210
.تقومين بهذا من أجلي دائمًا كلّما عدت للكنيسة

199
00:11:40,210 --> 00:11:41,380
لماذا تفعلين ذلك؟

200
00:11:41,940 --> 00:11:44,120
.هناك غبار على ملابسك فحسب

201
00:11:44,120 --> 00:11:46,140
!سيّدي القسّ

202
00:11:47,570 --> 00:11:49,560
!إليك أزهارًا يا سيّدي القسّ

203
00:11:49,560 --> 00:11:52,320
!شكرًا جزيلاً لك

204
00:11:54,280 --> 00:11:55,480
.أنا جدّ آسفة

205
00:11:55,480 --> 00:11:58,640
.أصرّت ليلي على القدوم لمنحك إيّاها

206
00:11:58,640 --> 00:12:00,190
.لا بأس. أسعدني هذا جدًّا

207
00:12:00,190 --> 00:12:02,990
.سأعيد السّلّة الّتي استعرتُها

208
00:12:02,990 --> 00:12:04,110
.تفضّلي

209
00:12:04,110 --> 00:12:05,860
.سأعتني بليلي الصّغيرة

210
00:12:05,860 --> 00:12:07,960
.فعلاً؟ شكرًا لك

211
00:12:09,490 --> 00:12:10,860
ماذا هنالك؟

212
00:12:10,860 --> 00:12:17,270
!أتعلمين؟ أريد الزّواج من القسّ عندما أكبر

213
00:12:18,560 --> 00:12:19,640
...لا

214
00:12:19,640 --> 00:12:21,320
.لا، لا يجب عليك ذلك

215
00:12:21,320 --> 00:12:25,640
،صحيح أنّه يتصرّف بشكل جيّد
!لكنّه يبالغ في ذلك كثيرًا

216
00:12:25,640 --> 00:12:28,770
إنّه متزمّت وصارم ومهووس بالنّظافة

217
00:12:28,770 --> 00:12:31,390
!ومخيف جدًّا عندما يكون غاضبًا

218
00:12:31,390 --> 00:12:34,140
ما الأفكار الّذي تزرعينها في راسها؟

219
00:12:34,830 --> 00:12:37,150
.أنت قدّيسة

220
00:12:37,150 --> 00:12:40,040
ما الّذي تفعلينه بتحدّثك عن عيوب شخص آخر؟

221
00:12:40,040 --> 00:12:42,430
بل ومع طفلة بريئة أيضًا؟

222
00:12:42,430 --> 00:12:44,150
.أنا جدّ آسفة

223
00:12:45,170 --> 00:12:49,660
لكن لا يستطيع القدّيسون
.الكذب بصفتهم عملاء للرّبّ

224
00:12:49,660 --> 00:12:53,240
،إن كنت غير راضية
.كان عليك ذكر ذلك لي فحسب

225
00:12:55,960 --> 00:12:58,540
!ا-انتظر رجاءً

226
00:12:58,540 --> 00:12:59,730
—ما الّذي

227
00:12:59,730 --> 00:13:03,660
،صحيح أنّي أقسم بالرّبّ أنّي لم أكذب أبدًا

228
00:13:03,660 --> 00:13:06,260
...لـ-لكن مقابل كلّ ما قلتُه

229
00:13:06,260 --> 00:13:10,180
هنالك الكثير من الأشياء الأخرى
!الّتي أحبّها فيك يا لورن

230
00:13:12,890 --> 00:13:15,880
إذًا، هل تريدين كعكات مدوّرة
وشايًا أسودًا اليوم أيضًا؟

231
00:13:15,880 --> 00:13:17,660
هل ستخبزها بنفسك لي؟

232
00:13:17,660 --> 00:13:20,470
.نعم، لذلك اتركيني رجاءً

233
00:13:30,850 --> 00:13:34,930
.ظهرت القدّيسة في قريتنا فجأة من العدم

234
00:13:36,540 --> 00:13:39,380
،كانت تجول الطّرقات وحيدة

235
00:13:39,380 --> 00:13:42,700
.لذلك طلبت منها المجيء لكنيستنا الصّغيرة

236
00:13:46,330 --> 00:13:51,300
وبصفتها قدّيسة، واثق أنّ هنالك
،أماكن مناسبة أكثر لها

237
00:13:51,300 --> 00:13:53,130
.لكنّها قرّرت الاستقرار هنا

238
00:13:53,640 --> 00:13:56,270
...ولكن، إضافة لتلك الظّروف المعقّدة

239
00:13:59,950 --> 00:14:04,150
أجد أنّ عليّ الاعتناء بها هي
.كشخص أكثر من أيّ شيء آخر

240
00:14:04,690 --> 00:14:06,630
.كوني حذرة رجاءً

241
00:14:06,630 --> 00:14:08,370
.آسفة

242
00:14:17,530 --> 00:14:19,460
سيّدتي القدّيسة؟

243
00:14:19,460 --> 00:14:21,200
!حلّ الصّباح

244
00:14:21,200 --> 00:14:24,830
!سيبرد فطورك إن لم تستيقظي قريبًا

245
00:14:25,140 --> 00:14:28,900
،ما زال وعيي وشوّشًا قليلاً
.لذلك ادخل وأيقظني رجاءً

246
00:14:28,900 --> 00:14:31,720
.يبدو لي أنّك تردّين بوضوح تامّ

247
00:14:31,720 --> 00:14:34,460
.ذلك غير ممكن. لا يمكنني الاستيقاظ

248
00:14:34,460 --> 00:14:36,780
!ادخل رجاءً وأيقظني

249
00:14:36,780 --> 00:14:38,500
.حسنًا، حسنًا

250
00:14:38,500 --> 00:14:40,350
!سوف أدخل

251
00:14:44,060 --> 00:14:45,590
!انظر

252
00:14:45,590 --> 00:14:47,840
!هذه هي ملابس النّوم الّتي حصلت عليها البارحة

253
00:14:47,840 --> 00:14:48,980
فعلاً؟

254
00:14:50,150 --> 00:14:51,480
ما رأيك؟

255
00:14:51,480 --> 00:14:52,990
...كم هي ظريفة

256
00:14:53,740 --> 00:14:54,960
.هذه المنامة

257
00:14:55,240 --> 00:14:57,450
.إنّها جيّدة الصّنع

258
00:14:57,450 --> 00:14:58,650
سيّدتي القدّيسة؟

259
00:14:59,160 --> 00:15:02,260
.اخرج رجاءً لأغيّر ملابسي

260
00:15:02,260 --> 00:15:03,600
.حسنًا، حسنًا

261
00:15:03,600 --> 00:15:05,490
هل أنتظر في الخارج؟

262
00:15:05,490 --> 00:15:06,300
ماذا؟

263
00:15:06,960 --> 00:15:11,210
سيكون لورن خارج الغرفة بينما أغيّر ملابسي؟

264
00:15:11,450 --> 00:15:14,620
،أعتقد أنّي سأذهب وحدي
.لذلك لا داعي لانتظاري

265
00:15:14,620 --> 00:15:16,080
ما الخطب؟

266
00:15:18,730 --> 00:15:21,120
.يوجد الكثير من الخضروات اليوم

267
00:15:21,120 --> 00:15:24,450
.كان لتفسد إن لم ناكلها قريبًا

268
00:15:26,220 --> 00:15:27,350
،بالتّفكير في الأمر

269
00:15:27,350 --> 00:15:32,110
لم تذكري أبدًا أنّك لا تحبّين طعامًا
.ما يا سيّدتي القدّيسة

270
00:15:32,110 --> 00:15:33,510
!بالطّبع لا

271
00:15:33,510 --> 00:15:37,740
!على القدّيسين إظهار امتنانهم لكلّ الطّعام

272
00:15:37,980 --> 00:15:42,040
لكن أشعر بأنّ هالتك توحي لي
.أنّك لا تحبّين الفلفل الأخضر والجزر

273
00:15:42,040 --> 00:15:43,960
.هذا ما تراه أنت فحسب

274
00:15:43,960 --> 00:15:45,880
.لا طعام لا أحبّه

275
00:15:45,880 --> 00:15:47,470
،بما أنّك ذكرت الأمر يا لورنس

276
00:15:47,470 --> 00:15:49,600
.لا تبدو لي أنّك تكره طعامًا ما أيضًا

277
00:15:49,600 --> 00:15:50,400
ماذا؟

278
00:15:53,880 --> 00:15:56,060
!بالطّبع

279
00:15:59,200 --> 00:16:04,020
.القدّيسون هم أشخاص يتلقّون إلهامات مقدّسة

280
00:16:04,020 --> 00:16:06,190
.لذلك ليس عليهم الكذب

281
00:16:06,190 --> 00:16:09,430
،ومع ذلك، رغم أنّي لا أكذب

282
00:16:09,430 --> 00:16:12,200
...إلاّ أنّك إن كذبت وأنت معي

283
00:16:12,200 --> 00:16:15,200
.أشعر أنّ ذلك غير عادل

284
00:16:15,590 --> 00:16:17,850
.أنا المخطئ

285
00:16:19,080 --> 00:16:22,720
.لا أستطيع أكل المحّار في الحقيقة

286
00:16:22,720 --> 00:16:23,830
المحّار؟

287
00:16:23,830 --> 00:16:25,040
،عندما كنت صغيرًا

288
00:16:25,040 --> 00:16:28,250
،ذهبنا في عطلة إلى جزيرة
.وأكلت المحار هناك لأوّل مرّة

289
00:16:28,250 --> 00:16:29,880
...وبعدها

290
00:16:30,960 --> 00:16:32,630
!إنّه لذيذ

291
00:16:32,630 --> 00:16:34,520
!يمكنني أكله للأبد

292
00:16:35,580 --> 00:16:37,550
فعلاً؟

293
00:16:37,920 --> 00:16:40,130
.أكلت الكثير لدرجة أنّي مرضت

294
00:16:40,130 --> 00:16:42,130
.ولم أتمكّن من أكله مذّاك الحين

295
00:16:42,130 --> 00:16:44,130
!كم هذا ظريف

296
00:16:44,130 --> 00:16:47,720
،السّبب وراء ذلك مجرّد قصّة سخيفة
.وذلك يجعلني أرغب بالهرب والاختباء

297
00:16:47,720 --> 00:16:50,060
لذلك هلاّ أبقيت الأمر سرًّا لو سمحت؟

298
00:16:50,730 --> 00:16:53,930
!سرّ عن لورنس لا يعرف أحد سواي

299
00:16:54,320 --> 00:16:55,670
!سأحفظه بحياتي

300
00:16:55,670 --> 00:16:57,750
!ليس عليك المبالغة لذلك الحدّ

301
00:16:57,750 --> 00:17:01,180
والآن، عليّ الذّهاب للتّسوّق
.بمجرّد الانتهاء من الأكل

302
00:17:01,690 --> 00:17:03,310
!سأرافقك أيضًا

303
00:17:08,100 --> 00:17:11,240
.من الخطير أن تتشتّتي هكذا يا سيّدتي القدّيسة

304
00:17:12,200 --> 00:17:13,800
!ألم أحذّرك للتّوّ؟

305
00:17:13,800 --> 00:17:15,380
هل أنت بخير؟

306
00:17:15,380 --> 00:17:17,270
لم تصب قدمك، صحيح؟

307
00:17:18,010 --> 00:17:19,230
سيّدتي القدّيسة؟

308
00:17:19,230 --> 00:17:21,390
!أ-أنا بخير

309
00:17:22,120 --> 00:17:23,290
—مـ-مهلاً

310
00:17:23,290 --> 00:17:24,390
!آسفة يا لورن

311
00:17:24,990 --> 00:17:26,590
لم تصب، صحيح؟

312
00:17:26,590 --> 00:17:28,820
ماذا عنك يا سيّدتي القدّيسة؟
هل أنت بخير؟

313
00:17:28,820 --> 00:17:31,610
!أنا قلقة عليك أنت أكثر الآن يا لورن

314
00:17:31,610 --> 00:17:33,400
.لا، أنت أكثر أهمّيّة يا سيّدتي القدّيسة

315
00:17:33,400 --> 00:17:35,370
.لا، بل أنت يا لورن

316
00:17:35,370 --> 00:17:36,640
.أنتِ الأهمّ

317
00:17:36,640 --> 00:17:38,770
!لا، أنت أكثر أهمّيّة

318
00:17:36,640 --> 00:17:39,920
إنّهما متوافقان معًا جيّدًا، صحيح؟

319
00:17:54,850 --> 00:17:58,690
حسنًا. الشّيء الوحيد المتبقّي
...الّذي علينا شراؤه

320
00:17:58,690 --> 00:18:00,840
،مكوّنات للحلويّات

321
00:18:00,840 --> 00:18:03,680
،لكنّنا اشترينا حلويّات لك قبل قليل

322
00:18:03,680 --> 00:18:06,040
.لذلك ربّما ليس علينا شراء الكثير هذه المرّة

323
00:18:06,620 --> 00:18:09,280
لن تستطيعي أكلها كلّها في كلّ
الأحوال، صحيح يا سيّدتي القدّيسة؟

324
00:18:09,280 --> 00:18:11,920
!يـ-يمكنك القول أنّ لديّ معدة ثانية للحلويّات

325
00:18:11,920 --> 00:18:13,110
...لكن

326
00:18:13,110 --> 00:18:16,650
!لا تسلب المرح من حياتي رجاءً

327
00:18:20,660 --> 00:18:24,010
.هناك أمور أخرى للتّطلّع إليها في الحياة

328
00:18:24,010 --> 00:18:26,080
!بالطّبع هناك

329
00:18:26,080 --> 00:18:26,830
فعلاً؟

330
00:18:27,050 --> 00:18:28,330
...ولكنّك

331
00:18:29,960 --> 00:18:33,960
...على سبيل المثال، الطّعام الّذي تعدّه

332
00:18:34,680 --> 00:18:37,880
...أو النّظر إلى الزّهور الّتي تزرعها

333
00:18:38,440 --> 00:18:41,970
...أو مجيئك لإيقاظي في الصّباح

334
00:18:42,440 --> 00:18:45,120
!لا أريد فقدان أيّ من هذه الأشياء

335
00:18:45,470 --> 00:18:47,250
...سيّدتي القدّيسة

336
00:18:47,720 --> 00:18:50,650
ألم يمكنك قول "الأعمال المنزليّة" فحسب؟

337
00:18:59,660 --> 00:19:01,730
.بدأت تُمطر بغزارة فجأة

338
00:19:01,730 --> 00:19:03,570
هل أنت بخير يا سيّدتي القدّيسة؟

339
00:19:03,570 --> 00:19:05,360
.صارت ملابسي ثقيلة

340
00:19:05,360 --> 00:19:07,290
!لزخارف ملابسها آثار جانبيّة مؤذية

341
00:19:09,040 --> 00:19:11,420
لكن هل أنت يا لورن؟

342
00:19:11,420 --> 00:19:15,420
.وضعك أسوأ بكثير من وضعي

343
00:19:15,420 --> 00:19:17,160
.هذا سيّئ

344
00:19:17,160 --> 00:19:20,230
،إن انتظرنا حتّى توقّف المطر
.قد تصاب القدّيسة بالزّكام

345
00:19:20,230 --> 00:19:22,040
!سيّدي القسّ وسيّدتي القدّيسة

346
00:19:22,040 --> 00:19:24,170
لا تحملان مظلّة معكما؟

347
00:19:24,170 --> 00:19:25,060
.صحيح

348
00:19:25,060 --> 00:19:27,180
.لم أتوقّع أنّها ستمطر

349
00:19:27,180 --> 00:19:30,630
!ستصابين بالزّكام! خذي مظلّتي رجاءً

350
00:19:30,630 --> 00:19:32,350
...ماذا؟ لكن

351
00:19:32,350 --> 00:19:33,720
.لا بأس

352
00:19:33,720 --> 00:19:35,720
.سأطلب منه أن يشارك مظلّته معي

353
00:19:35,720 --> 00:19:36,680
!مع السّلامة

354
00:19:39,730 --> 00:19:41,280
.أنا شاكر لهما

355
00:19:41,280 --> 00:19:43,700
.حسنًا، عليك أخذها

356
00:19:43,700 --> 00:19:44,740
ماذا؟

357
00:19:44,740 --> 00:19:46,600
.لا تقلقي حيالي. سأكون بخير

358
00:19:46,600 --> 00:19:47,500
.خذيها

359
00:19:50,750 --> 00:19:54,990
،لكنّك ستصاب بالزّكام يا لورن
!لذلك سنستعملها معًا

360
00:19:54,990 --> 00:19:56,630
!أنت حازمة جدًّا

361
00:19:56,630 --> 00:19:58,760
.لكن هناك فرق في الطّول بيننا

362
00:19:58,760 --> 00:20:01,390
.ستتبلّلين هكذا

363
00:20:01,390 --> 00:20:03,880
،لماذا لا نصف الأمر هكذا

364
00:20:03,880 --> 00:20:06,030
تبدو القدّيسة رائعة حتّى وهي مبلّلة"؟"

365
00:20:06,030 --> 00:20:07,680
هل تريدين أن تتبلّلي؟

366
00:20:07,680 --> 00:20:09,390
،إن ارتديتُ غطاء رأسي

367
00:20:09,390 --> 00:20:12,490
!فسأغطّي نفسي من المطر المتساقط من الجانب

368
00:20:13,480 --> 00:20:16,610
.لا بأس إن كنت مصرّة لهذه الدّرجة

369
00:20:16,610 --> 00:20:19,790
،لكن إن بدأت تتبلّلين

370
00:20:19,790 --> 00:20:21,540
.فسأجبرك حينها على أخذ المظلّة

371
00:20:21,540 --> 00:20:23,360
!حـ-حسنًا

372
00:20:32,650 --> 00:20:35,220
.توقّف المطر

373
00:20:36,360 --> 00:20:37,900
...كيف

374
00:20:37,900 --> 00:20:41,110
كيف للطّقس أن يكون متقلّبًا هكذا؟

375
00:20:41,480 --> 00:20:43,040
!سيّدتي القدّيسة

376
00:20:43,040 --> 00:20:44,940
هـ-هل أنت بخير؟

377
00:20:44,940 --> 00:20:45,880
.نعم

378
00:20:45,880 --> 00:20:48,480
.لا يهمّ كثيرًا إن تبلّلت الآن

379
00:20:48,770 --> 00:20:50,210
.كلاّ! اعذري وقاحتي رجاءً

380
00:20:51,220 --> 00:20:52,840
!لـ-لـ-لورن؟

381
00:20:52,840 --> 00:20:54,160
.أنا آسف

382
00:20:54,160 --> 00:20:56,250
.تحمّلي رجاءً لبعض الوقت

383
00:20:57,240 --> 00:21:00,490
.لا يجب أن تصابي بالزّكام. سنسرع للمنزل

384
00:21:00,490 --> 00:21:04,260
.أفضّل لو تبطئ قليلاً

385
00:21:04,260 --> 00:21:06,720
!قلت لك أنّك قد تصابين بالزّكام

386
00:21:10,640 --> 00:21:12,530
.عليك الاستحمام أيضًا يا لورن

387
00:21:16,220 --> 00:21:19,190
.ليس من عادته النّوم هكذا

388
00:21:19,190 --> 00:21:21,500
.إنّ لورن في لحظة عفويّة بالكامل الآن

389
00:21:32,790 --> 00:21:38,690
.كقدّيسة، لديّ واجب حماية سكّان هذه القرية

390
00:21:39,380 --> 00:21:40,860
...لكن يا لورن

391
00:21:41,430 --> 00:21:45,570
.أنا برفقتك الآن لأنانيّتي بالكامل

392
00:21:46,490 --> 00:21:49,970
.سأحميك للأبد

393
00:23:21,960 --> 00:23:32,050
!تتصرّف القدّيسة بتكاسل

394
00:23:21,970 --> 00:23:24,150
...استرخاء

395
00:23:26,640 --> 00:23:32,050
...استرخاء

396
00:23:36,400 --> 00:23:38,280
!ما عاد بإمكاني المواصلة