1
00:00:06,140 --> 00:00:07,770
.أخبرني يا أبيل

2
00:00:08,360 --> 00:00:10,900
هل أنت واثق بالفعل أنّك لا تريد العودة؟

3
00:00:10,900 --> 00:00:13,760
،حتّى إن كان هنالك رهبان بما يكفي في كنيسة كبيرة

4
00:00:13,760 --> 00:00:15,400
لكن لا بدّ من وجود عمل لك، صحيح؟

5
00:00:15,400 --> 00:00:18,660
.ليس هنالك الكثير من العمل في ذلك المكان

6
00:00:18,660 --> 00:00:22,410
.من الممكن القول أنّي مشغول أكثر بالعمل الآخر

7
00:00:23,100 --> 00:00:24,920
العمل الآخر"؟"

8
00:00:29,990 --> 00:00:31,850
هل أتى أحد ما للصّلاة؟

9
00:00:31,850 --> 00:00:33,150
هل يمكنك فتح الباب؟

10
00:00:33,150 --> 00:00:35,800
.أكيد. ها أنا ذا

11
00:00:38,450 --> 00:00:40,800
...الباب ليس مغلقًا

12
00:00:43,400 --> 00:00:45,520
مهلاً! ما الّذي تفعله؟

13
00:00:45,520 --> 00:00:46,990
—افتح الباب بسرعة

14
00:00:46,990 --> 00:00:48,960
تقفل الباب بمجرّد رؤية وجه الطّارق؟

15
00:00:48,960 --> 00:00:50,560
ما هذه الفظاظة؟

16
00:00:53,570 --> 00:00:55,030
...الباب

17
00:02:32,360 --> 00:02:34,400
.المعذرة

18
00:02:34,400 --> 00:02:37,500
أتصرّف بعنف دون تفكير عندما
.أواجه شيئًا غير متوقّع

19
00:02:37,660 --> 00:02:39,270
.سأعوّضكم عن الأضرار

20
00:02:39,270 --> 00:02:41,880
هل يمكنني أن أطلب ألاّ تتعاملوا
مع هذه المسألة حتّى ذلك الحين؟

21
00:02:41,880 --> 00:02:44,520
.واثق أنّ مفاصل المعدنية صارت قديمة لا غير

22
00:02:44,520 --> 00:02:48,520
.هذا خطأ فادح من جهتي

23
00:02:46,010 --> 00:02:48,520
.إنّها ليست من هذه القرية

24
00:02:48,520 --> 00:02:52,570
هل أتيت كلّ هذه المسافة للقاء القدّيسة؟

25
00:02:52,570 --> 00:02:54,440
.لا، ليس صحيحًا

26
00:02:54,440 --> 00:02:56,530
.الشّخص الّذي لديّ شأن معه هو ذاك النّائم هناك

27
00:02:56,530 --> 00:02:58,840
.أنا هنا من أجل أبيل

28
00:02:58,840 --> 00:03:00,520
ماذا؟ أبيل؟

29
00:03:01,430 --> 00:03:04,960
يا إلهي، لا أصدّق أنّ من عليها
.البحث عنه من بين الجميع

30
00:03:04,960 --> 00:03:07,440
،بعد تخلّيه عن عمله كمدرّس منزليّ

31
00:03:07,440 --> 00:03:09,080
فما الّذي كان يفعله؟

32
00:03:09,080 --> 00:03:11,200
مدرّس منزليّ"؟"

33
00:03:11,480 --> 00:03:12,410
!اسمع

34
00:03:12,410 --> 00:03:13,780
أنت مستيقظ، صحيح؟

35
00:03:13,780 --> 00:03:16,630
يُحتمل أنّ طريقة إيقاظي هذه
.ستؤثّر على فروة شعري

36
00:03:16,630 --> 00:03:19,970
.كنت تحصل على علامات سيّئة دائمًا
هل صحيح أنّك مدرّس منزليّ؟

37
00:03:19,970 --> 00:03:22,720
.استطعتُ التّخرّج في كلّ الأحوال

38
00:03:22,720 --> 00:03:24,920
ومن تلك الفتاة؟

39
00:03:24,920 --> 00:03:27,630
نظرًا للباسها، فلا بدّ أنّها من عائلة مرموقة، صحيح؟

40
00:03:27,630 --> 00:03:31,570
المكان الّذي أعيش فيه
،الّذي هو غرب هذه البلدة

41
00:03:31,570 --> 00:03:33,190
.هو مدينة كبيرة

42
00:03:33,190 --> 00:03:35,830
.إنّها تعجّ بالعائلات المرموقة

43
00:03:35,830 --> 00:03:38,070
.إذًا فهي شابّة راقية المنشأ

44
00:03:38,800 --> 00:03:40,540
.آسفة لأنّي لم أعرّف على نفسي

45
00:03:40,540 --> 00:03:43,770
.اسمي هيزليتا ألدريدج

46
00:03:43,770 --> 00:03:45,590
،كما سبق وذكرت

47
00:03:45,590 --> 00:03:48,320
.جئت للتّأكّد من مكان تواجد هذا

48
00:03:48,320 --> 00:03:50,200
هل صار سحب شعري موضة الآن؟

49
00:03:50,200 --> 00:03:51,690
!اسمع يا هذا

50
00:03:51,690 --> 00:03:54,080
لماذا لن تردّ على الرّسالة؟

51
00:03:54,080 --> 00:03:55,790
هل وصلتني رسالة؟

52
00:03:57,160 --> 00:04:00,120
بسبب ذلك، اضطررت لقطع كلّ هذه
...المسافة إلى هنا

53
00:03:58,120 --> 00:03:59,540
...الرّسالة

54
00:04:00,420 --> 00:04:01,680
.عفوًا

55
00:04:02,430 --> 00:04:06,050
.أنا ممثّل هذه الكنيسة واسمي لورنس

56
00:04:06,250 --> 00:04:09,040
...فهمت. إذًا فأنت

57
00:04:10,320 --> 00:04:14,050
.سمعتُ أنّ هنالك قدّيسة تقيم في هذه الكنيسة

58
00:04:14,050 --> 00:04:14,970
.نعم

59
00:04:14,970 --> 00:04:19,220
.أعتقد الآن أنّها تبحث عن نبتة نفل رباعيّة الأوراق

60
00:04:19,220 --> 00:04:20,320
...رباعيّة الأوراق

61
00:04:20,770 --> 00:04:22,120
!لورن

62
00:04:22,120 --> 00:04:23,780
...كنّا في سيرتها للتّوّ

63
00:04:25,880 --> 00:04:27,280
ماذا؟

64
00:04:27,280 --> 00:04:28,430
...أنت

65
00:04:28,430 --> 00:04:30,280
!أنت من التقيتها قبل قليل

66
00:04:30,920 --> 00:04:33,360
.أنا القدّيسة سيسيليا

67
00:04:33,360 --> 00:04:35,360
.سررت بلقائك ثانية

68
00:04:35,360 --> 00:04:38,970
،بدوتِ شاردة الذّهن أكثر وقتها
.لذلك لم أتخيّل أن تكوني القدّيسة

69
00:04:38,970 --> 00:04:41,550
!أقسم أنّي لا أكذب

70
00:04:41,550 --> 00:04:44,870
هل قابلت السّيّدة سيسيليا من قبل يا آنستي؟

71
00:04:44,870 --> 00:04:45,800
.نعم

72
00:04:45,800 --> 00:04:49,040
قابلتها في البلدة عندما كادت
.تسقط من درج ما

73
00:04:49,490 --> 00:04:50,970
فعلاً؟

74
00:04:51,800 --> 00:04:55,310
هل وجدت أيّ نباتات نفل رباعيّة
الأوراق يا سيّدة سيسيليا؟

75
00:04:55,310 --> 00:04:59,480
لم أجد أيًّا منها، لكن كانت هناك
!الكثير من الزّهور المتفتّحة

76
00:04:59,480 --> 00:05:02,800
.لذلك قرّرت صنع تاج زهور

77
00:05:02,800 --> 00:05:05,320
يمكن صنع أشياء كهذه يا سيّدتي القدّيسة؟

78
00:05:05,320 --> 00:05:07,570
.تعلّمت ذلك وأنا صغيرة

79
00:05:07,570 --> 00:05:10,780
.لكنّي نسيت كيف أقوم بذلك تقريبًا

80
00:05:10,780 --> 00:05:11,880
—ظننتُ أنّك قد تعرف

81
00:05:11,880 --> 00:05:13,990
.لا، لا أعرف كيف أيضًا

82
00:05:13,990 --> 00:05:17,710
.ربّما تعرف الآنسة كيف تصنع تاج زهور

83
00:05:24,500 --> 00:05:26,590
...إن قمت بهذا و

84
00:05:27,190 --> 00:05:29,210
!هذا مذهل يا هيزليتا

85
00:05:29,480 --> 00:05:31,420
ربّما تكون هذه فرصة

86
00:05:31,420 --> 00:05:33,990
.لتتعلّم كيف تصنع تاج زهور أيضًا يا لورن

87
00:05:33,990 --> 00:05:36,760
...لن يكون لديّ أيّ سبب لصنعها

88
00:05:36,760 --> 00:05:39,850
.ظننتُ أنّه سيكون من الممتع صنعها معًا

89
00:05:39,850 --> 00:05:43,350
.لن يكون من الملائم أن أنضمّ إليك في هذا

90
00:05:43,680 --> 00:05:47,030
.إذًا فأنت شخص يرفض تحقيق طلب امرأة

91
00:05:47,030 --> 00:05:49,030
...أنا... عفوًا

92
00:05:49,030 --> 00:05:52,400
بالمناسبة يا آنستي، هل أحضرت أيّ هدايا لي؟

93
00:05:52,400 --> 00:05:54,770
!ما هذه الوقاحة؟! بالطّبع فعلت

94
00:05:54,770 --> 00:05:56,080
فعلاً؟

95
00:05:58,080 --> 00:06:02,320
إذًا فأبيل هو الشّخص الّذي كنت تبحثين عنه؟

96
00:06:02,320 --> 00:06:05,400
،نعم، وبما أنّي كنتُ هنا سلفًا للبحث عنه

97
00:06:05,400 --> 00:06:08,920
.خطّطتُ أيضًا للقاء القدّيسة الّتي تقيم في الكنيسة

98
00:06:08,920 --> 00:06:12,680
،إنّ لقاء قدّيسة أمر نادر على معظم النّاس

99
00:06:12,680 --> 00:06:16,610
لذلك يأتي الكثير منهم لرؤيتها
.هنا كما فعلت يا آنسة هيزليتا

100
00:06:16,610 --> 00:06:17,850
فعلاً؟

101
00:06:18,080 --> 00:06:20,610
،في هذه المنطقة، من يُدعون بالقدّيسات

102
00:06:20,610 --> 00:06:24,320
.بمن فيهنّ القدّيسة العظيمة وأنا، قليلات جدًّا

103
00:06:24,580 --> 00:06:30,310
تعيش القدّيسة العظيمة في جزيرة ميشيلا
.في الخليج، لذلك من الصّعب زيارتها

104
00:06:30,310 --> 00:06:34,450
ولا توجد الكثير من المناسبات
.للقائها من المقام الأوّل

105
00:06:34,450 --> 00:06:39,520
من السّهل لقاؤنا نحن القدّيسات بما
.أنّنا ننسجم مع الحياة اليوميّة للنّاس

106
00:06:40,140 --> 00:06:41,670
،بالتّفكير في الأمر

107
00:06:41,670 --> 00:06:46,410
ظننتُ أنّي سمعت أنّ هنالك قدّيسة
.في البلدة الغربيّة أيضًا

108
00:06:46,410 --> 00:06:47,970
.لورنس

109
00:06:47,970 --> 00:06:50,470
.يبدو أنّ الآنسة متعبة من رحلتها الطّويلة

110
00:06:50,470 --> 00:06:52,560
هل من الممكن السّماح لها بالمبيت هنا اللّيلة؟

111
00:06:52,560 --> 00:06:54,370
.هذا مفاجئ

112
00:06:54,370 --> 00:06:56,220
مهلاً. أبيل؟

113
00:06:56,790 --> 00:06:58,050
رجاءً؟

114
00:06:59,680 --> 00:07:01,000
.مفهوم

115
00:07:09,480 --> 00:07:11,690
.استعملي هذه الغرفة رجاءً

116
00:07:11,920 --> 00:07:14,050
.أخبريني إن احتجت أيّ شيء

117
00:07:17,960 --> 00:07:20,500
.لكنّي لستُ متعبة لهذه الدّرجة

118
00:07:28,520 --> 00:07:30,210
.تاج زهور

119
00:07:30,920 --> 00:07:34,710
هل سبق وصنعتُ واحدًا لشخص آخر عداها؟

120
00:07:35,350 --> 00:07:36,710
!هيزليتا

121
00:07:39,750 --> 00:07:44,600
!صرتِ بارعة جدًّا في صنع تيجان الزّهور بالفعل

122
00:07:44,600 --> 00:07:47,900
.تداعى تاجي بينما كنت لا أزال أصنعه

123
00:07:47,900 --> 00:07:50,530
،إ-إن أعدت ربطه ببعضه ثانية
!فسيمكن إصلاحه

124
00:07:50,530 --> 00:07:54,540
سأنهي صنع ذاك، لذلك ارتدي
!هذا يا سيّدتي القدّيسة

125
00:07:55,950 --> 00:07:58,650
.شكرًا لك يا هزليتا

126
00:07:59,280 --> 00:08:01,610
.أنت فتاة طيّبة جدًّا

127
00:08:07,820 --> 00:08:09,110
!سيّدتي القدّيسة

128
00:08:09,110 --> 00:08:10,170
!هيزليتا

129
00:08:10,170 --> 00:08:11,260
!أخي

130
00:08:11,260 --> 00:08:12,840
!القدّيسة تتألّم

131
00:08:12,840 --> 00:08:14,800
!علينا إحضار طبيب لها بسرعة

132
00:08:15,200 --> 00:08:18,120
لماذا لا أحد آخر قلق عليها؟

133
00:08:18,120 --> 00:08:19,800
!قد تموت سيّدتي القدّيسة

134
00:08:19,800 --> 00:08:21,400
!أخي

135
00:08:21,400 --> 00:08:23,320
أيّتها الآنسة الصّغيرة من عائلة ألدريدج؟

136
00:08:24,060 --> 00:08:26,070
عمّ تتحدّثين؟

137
00:08:26,360 --> 00:08:28,730
.إنّها قدّيسة

138
00:08:28,730 --> 00:08:32,430
.ستكون غطرسة منّا أن نعاملها كبشريّة عاديّة

139
00:08:33,280 --> 00:08:36,000
،إنّهنّ يأتين للعيش بيننا لإنقاذ النّاس

140
00:08:36,000 --> 00:08:38,530
.وهنّ أقرب للإله من أيّ أحد آخر

141
00:08:39,090 --> 00:08:42,040
كيف يُعقل أن يصبن بالمرض؟

142
00:08:50,540 --> 00:08:53,270
...إنّ كلّ المسؤولين عن الاعتناء بالقدّيسات

143
00:08:53,620 --> 00:08:58,180
.يُعميهم الطّمع والحاجة للشّهرة

144
00:08:58,180 --> 00:09:00,180
...القدّيسة هنا أيضًا

145
00:09:02,180 --> 00:09:04,230
.آسف لإزعاجك وأنت ترتاحين

146
00:09:04,230 --> 00:09:06,430
.الأمر يخصّ عشاء اللّيلة

147
00:09:06,930 --> 00:09:07,930
...عفوًا

148
00:09:10,880 --> 00:09:13,690
إنّ وجهك شاحب... هل أنت بخير؟

149
00:09:13,690 --> 00:09:15,120
أين القدّيسة؟

150
00:09:15,120 --> 00:09:17,580
.في الأسفل برفقة أبيل

151
00:09:17,580 --> 00:09:18,490
.هكذا إذًا

152
00:09:18,920 --> 00:09:23,580
.أنت الشّخص الّذي أريد أن أطرح عليه سؤالي

153
00:09:24,660 --> 00:09:29,040
ما رأيك في القدّيسة الّتي تعيش معها هكذا؟

154
00:09:29,040 --> 00:09:30,080
ماذا؟

155
00:09:30,080 --> 00:09:31,650
لا بدّ أنّ لديك رأيك، صحيح؟

156
00:09:31,650 --> 00:09:32,730
،على سبيل المثال

157
00:09:32,730 --> 00:09:35,960
.ربّما تظنّ أنّ وجود القدّيسة سيفيدك

158
00:09:37,000 --> 00:09:40,980
.صحيح أنّ وجودها له بعض الفوائد

159
00:09:41,420 --> 00:09:45,980
.كنتُ أعيش هنا وحدي قبل مجيء القدّيسة

160
00:09:46,230 --> 00:09:49,980
لذلك هناك أمور مثل عدم شعوري
!بالوحدة أثناء الأكل بعد الآن

161
00:09:49,980 --> 00:09:50,880
ماذا؟

162
00:09:51,520 --> 00:09:54,250
،الطّبخ واحدة من هواياتي

163
00:09:54,250 --> 00:09:57,840
.لذلك فوجود شخص يأكل بحماسة مثلها مفيد جدًّا

164
00:09:57,840 --> 00:09:59,070
!لا، لا

165
00:09:59,070 --> 00:10:01,530
!لم أقصد ذلك النّوع من الفوائد

166
00:10:01,530 --> 00:10:04,280
...أقصد استغلال القدّيسة لزيادة مدخولك

167
00:10:04,550 --> 00:10:09,750
أو استعمال عُذر أنّها مبعوثة
.من الإله لدفعها على مواصلة العمل

168
00:10:10,290 --> 00:10:13,290
.سمعتُ قصصًا كهذه

169
00:10:13,800 --> 00:10:15,000
...لكن

170
00:10:15,290 --> 00:10:19,160
أوّل شيء شعرت به عندما رأيت
...القدّيسة لأوّل مرّة كان

171
00:10:19,160 --> 00:10:23,510
."إنّها شخص عليّ تقديره بشدّة"

172
00:10:23,510 --> 00:10:27,970
.أريد من القدّيسة أن تواصل الابتسام

173
00:10:29,500 --> 00:10:35,820
أتساءل إن كانت القدّيسة ستبتسم
.إن صنعت لها تاج زهور

174
00:10:36,360 --> 00:10:39,160
.تمامًا كما حدث مقتها

175
00:10:39,980 --> 00:10:43,240
.هكذا إذًا. أنا أفهم الآن

176
00:10:43,480 --> 00:10:46,420
.أعتذر على طرح سؤال غريب كهذا فجأة

177
00:10:46,420 --> 00:10:48,520
إنّها مهمّة جدًّا بالنّسبة لك، صحيح؟

178
00:10:48,520 --> 00:10:51,400
.نعم، إنّها شريكة سكن عزيزة عليّ

179
00:10:51,400 --> 00:10:52,530
شريكة سكن"؟"

180
00:10:52,530 --> 00:10:53,700
.نعم

181
00:10:57,760 --> 00:11:00,250
فعلتَ ذلك عن قصد، صحيح يا أبيل؟

182
00:11:00,250 --> 00:11:01,580
فعلتُ ماذا؟

183
00:11:01,580 --> 00:11:06,560
جهّزت الأمور حتّى تضطرّ هيزليتا
.للمجيء إلى هنا لرؤية لورن

184
00:11:07,690 --> 00:11:11,300
واضح بمجرّد النّظر إلى هيزليتا
.أنّها تحمل عبئًا ثقيلاً

185
00:11:11,300 --> 00:11:16,820
ولا بدّ أنّ له علاقة بالقدّيسة
.في البلدة الغربيّة الّتي ذكرها لورن

186
00:11:17,080 --> 00:11:20,570
أفترض أنّ السّيّدة سيسيليا
.ستتمكّن من ملاحظة الأمر

187
00:11:20,570 --> 00:11:22,270
،سيّدتي سيسيليا

188
00:11:22,270 --> 00:11:26,080
هل سمعت قصصًا من تلك البلدة
عن قدّيسة العطف؟

189
00:11:26,800 --> 00:11:30,970
عاملها النّاس من حولها
.وكأنّها ارتقت عن باقي البشريّة

190
00:11:30,970 --> 00:11:34,480
ماتت جرّاء مرض كان من الممكن
.علاجه إن فحصها طبيب

191
00:11:34,480 --> 00:11:38,590
.بعبارات أخرى، القدّيسات مجرّد بشر

192
00:11:38,880 --> 00:11:41,640
.كانت صديقة الآنسة

193
00:11:41,880 --> 00:11:43,640
صديقتها؟

194
00:11:43,640 --> 00:11:46,820
،وبسبب تلك الأحداث
،صارت تحيّزاتها أقوى بكثير

195
00:11:46,820 --> 00:11:50,320
وذلك هو سبب قلقها من لورنس
.الّذي يعيش معك

196
00:11:50,320 --> 00:11:56,500
لذلك ظننتَ أنّه إن أتت هيزليتا
إلى هنا، فقد يتغيّر شيء ما؟

197
00:11:56,500 --> 00:11:59,360
...لن يكون من السّهل لمشاعر حزن كهذه

198
00:11:59,360 --> 00:12:02,490
.إنّ مجرّد رؤيتها لهذا الوضع هو أكثر من كافٍ

199
00:12:02,490 --> 00:12:04,200
،حتّى من خلال النّظر من الخارج

200
00:12:04,200 --> 00:12:08,600
سيكون من الواضح أنّكما أنت
.ولورنس تهتمّان بشدّة لبعضهما

201
00:12:08,600 --> 00:12:09,490
ماذا؟

202
00:12:09,490 --> 00:12:14,230
لكن سيكون من اللّطيف إن عاملك
كفتاة عاديّة، صحيح؟

203
00:12:20,310 --> 00:12:24,000
.ناعم ولامع. ناعم ولامع

204
00:12:31,390 --> 00:12:32,910
.هذا لذيذ

205
00:12:32,910 --> 00:12:34,020
أليس كذلك؟

206
00:12:34,020 --> 00:12:35,620
مذاقها ممتاز، صحيح؟

207
00:12:35,620 --> 00:12:38,020
.تبدين مصرّة جدًّا

208
00:12:38,320 --> 00:12:41,480
.آسفة لأنّي جعلتك تقدّم لي وليمة كهذه

209
00:12:41,480 --> 00:12:42,420
.على الإطلاق

210
00:12:42,420 --> 00:12:45,440
أنا مسرور لأنّك لست صعبة الإرضاء
.بخصوص الأكل يا آنسة هيزليتا

211
00:12:45,440 --> 00:12:49,610
إن كنت كذلك، فلن أتمكّن
.من حضور حفلات الآخرين

212
00:12:49,880 --> 00:12:52,600
ومع ذلك، هناك شخص معيّن
...رافقني لمرّات عديدة

213
00:12:52,600 --> 00:12:55,060
.اكتشف أشياء لا يستطيع أكلها

214
00:12:55,060 --> 00:12:57,930
.لا أستطيع أكل الجزر إن تمّ طهيه

215
00:12:57,930 --> 00:12:59,160
.إنّه حلو جدًّا

216
00:12:59,160 --> 00:13:00,430
.يا إلهي

217
00:13:00,430 --> 00:13:03,360
هذه طباعك بينما تأكل القدّيسة
.أيّ شيء نقدّمه لها

218
00:13:03,360 --> 00:13:05,880
،"مع أنّك محقّ بقولك "أيّ شيء

219
00:13:05,880 --> 00:13:09,880
.لكنّ كلّ ما تطبخه من أجلي لذيذ يا لورن

220
00:13:09,880 --> 00:13:12,320
!لذلك ما من طريقة تجعلني أكره أيّ شيء

221
00:13:12,320 --> 00:13:14,200
.ماذا؟ نـ-نعم

222
00:13:14,200 --> 00:13:18,540
،الكعك المدوّر والمادلين والبسكويت
!كلّها لذيذة

223
00:13:16,060 --> 00:13:19,540
.تتدفّق العاطفة من القدّيسة

224
00:13:18,540 --> 00:13:21,370
!أرجوك لا تبالغي كثيرًا

225
00:13:19,540 --> 00:13:22,620
لا يبدو أنّها تُعامَل بشكل فظيع، صحيح؟

226
00:13:22,050 --> 00:13:24,320
...أقول الحقيقة فحسب! وأيضًا

227
00:13:23,210 --> 00:13:25,480
.كنتُ عمياء تمامًا

228
00:13:27,860 --> 00:13:29,240
الأمر صحيح إذًا؟

229
00:13:29,240 --> 00:13:32,310
تعيشان هنا وحدكما في العادة؟

230
00:13:32,310 --> 00:13:33,690
.نعم، هذا صحيح

231
00:13:33,690 --> 00:13:36,410
أنت ورجل لا صلة قرابة تجمع بينكما وحدكما؟

232
00:13:39,560 --> 00:13:42,600
ويمكن لأيّ شيء أن يحدث، صحيح؟

233
00:13:42,600 --> 00:13:44,050
.على رسلك يا آنستي

234
00:13:44,050 --> 00:13:46,150
!لم أكن أقصد أيّ شيء خبيث

235
00:13:46,150 --> 00:13:48,920
.الحقيقة هي أنّ لا شيء حدث

236
00:13:49,240 --> 00:13:52,840
يعيش مع فتاة بهذا الجمال ولم يحدث أيّ شيء؟

237
00:13:52,840 --> 00:13:54,940
هل يعاني من خطب ما؟

238
00:13:54,940 --> 00:13:57,480
.حاولي تخفيف كلماتك يا آنستي

239
00:13:58,710 --> 00:14:02,600
.مرّت أكثر من سنة الآن مذ بدأنا نعيش معًا

240
00:14:02,600 --> 00:14:04,620
.أنا جدّ آسفة

241
00:14:05,870 --> 00:14:07,980
!من أبكى القدّيسة؟

242
00:14:07,980 --> 00:14:08,870
!أنت

243
00:14:08,870 --> 00:14:11,240
ماذا؟

244
00:14:09,320 --> 00:14:10,480
!إنّه أنت

245
00:14:12,370 --> 00:14:14,470
.إنّك تعانين صعوبة كبيرة حيال هذا

246
00:14:14,470 --> 00:14:17,750
صحيح... يا سيّدتي القدّيسة؟

247
00:14:18,720 --> 00:14:21,110
.نادني سيسيليا رجاءً

248
00:14:21,110 --> 00:14:23,440
ذلك أسهل، صحيح؟

249
00:14:24,760 --> 00:14:26,830
...سي... سيسي

250
00:14:27,330 --> 00:14:29,510
!لا تضحك

251
00:14:29,510 --> 00:14:33,920
على مهلك. إنّ حقيقة محاولتك مناداتها
.بذلك جيّدة كفاية على الأرجح يا آنستي

252
00:14:34,410 --> 00:14:36,520
...لا-لا يعقل

253
00:14:37,100 --> 00:14:38,770
!هذا قاس جدًّا

254
00:14:38,770 --> 00:14:40,720
لماذا يعاملني الجميع هكذا؟

255
00:14:40,720 --> 00:14:44,780
لأنّك بليد للغاية بشأن الأمور
.الّتي تتعلّق بك يا لورن

256
00:14:44,780 --> 00:14:47,100
.لكنّك حصلت على علامات جيّدة في الاختبارات

257
00:14:47,100 --> 00:14:51,280
،ويمكنك تحقيق أيّ شيء تريده
.لكنّك تتكاسل فحسب

258
00:14:51,690 --> 00:14:55,040
!هذا صحيح! قم بعملك كمدرّس منزليّ

259
00:14:55,040 --> 00:14:56,240
...لكن

260
00:14:56,240 --> 00:14:58,120
.بكون لكن

261
00:14:58,120 --> 00:15:00,120
.سأذهب لإحضار كلّ شيء تحتاجه

262
00:15:00,120 --> 00:15:01,640
...لا بأس

263
00:15:05,270 --> 00:15:08,380
ألم يكن مصدر إزعاج منذ مجيئه إلى هنا؟

264
00:15:08,380 --> 00:15:10,590
!لا، على الإطلاق

265
00:15:10,590 --> 00:15:15,080
.لا بدّ أنّك عيشكما معًا يسبّب المشاكل أحيانًا

266
00:15:15,080 --> 00:15:18,600
.إن حدث أيّ شيء، يمكنك أن تُحدّثيني في أيّ وقت

267
00:15:19,570 --> 00:15:20,910
.سيسيليا

268
00:15:22,770 --> 00:15:25,500
سيكون من اللّطيف إن أتى يوم

269
00:15:25,500 --> 00:15:28,350
يناديك فيه أحد آخر بذلك، صحيح؟

270
00:15:28,350 --> 00:15:30,690
.نـ... نعم

271
00:15:30,690 --> 00:15:32,780
.تمّت كلّ التّحضيرات

272
00:15:32,780 --> 00:15:34,300
.شكرًا لك

273
00:15:36,220 --> 00:15:40,370
والآن، لماذا تفتقر للحماسة هكذا؟

274
00:15:41,330 --> 00:15:44,970
،إن علّمك لورنس بدلاً منّي

275
00:15:44,970 --> 00:15:47,630
فربّما ستتعلّمين بشكل أحسن، صحيح؟

276
00:15:47,940 --> 00:15:49,880
عمّ تتكلّم؟

277
00:15:50,120 --> 00:15:54,100
.هذا أمر عليك أنت فعله، ولا أحد غيرك

278
00:15:54,100 --> 00:15:58,640
وإن تهاونتَ فقط لأنّ هنالك من
هم أفضل، فما الّذي ستحقّقه؟

279
00:15:58,640 --> 00:16:01,860
.أنت من طلبتُ منه أن يقوم بهذا

280
00:16:04,400 --> 00:16:07,120
.أنت مبهرة كالعادة

281
00:16:07,490 --> 00:16:08,500
ماذا؟

282
00:16:08,500 --> 00:16:09,670
.لا شيء

283
00:16:09,670 --> 00:16:13,740
كلّ ما في الأمر هو أنّه عندما تسير آنستي
.الصّغيرة في طريقها الخاصّ تبدو مذهلة

284
00:16:14,530 --> 00:16:16,190
!تسخر منّي، صحيح؟

285
00:16:16,190 --> 00:16:18,150
.لا. على الإطلاق

286
00:16:18,150 --> 00:16:20,090
.لكنّي أجدك مضحكة بالفعل

287
00:16:20,090 --> 00:16:21,160
!مهلاً

288
00:16:21,160 --> 00:16:22,880
صرتَ فظًّا أكثر بكثير، ألا تظنّ؟

289
00:16:22,880 --> 00:16:23,960
.يا للفظاظة

290
00:16:23,960 --> 00:16:25,730
.لم أحاول حتّى أن أبدأ بجدّ بعد

291
00:16:24,500 --> 00:16:26,820
نقاشهما مليء بالحيويّة، صحيح؟

292
00:16:25,730 --> 00:16:26,810
ماذا قلت؟

293
00:16:26,820 --> 00:16:29,200
.من الجيّد أنّ لهما الكثير من الطّاقة

294
00:16:29,200 --> 00:16:30,550
.أظنّ ذلك

295
00:16:30,880 --> 00:16:32,810
...الآنسة هيزليتا وقتها

296
00:16:33,370 --> 00:16:35,140
.بدت وكأنّها تعاني

297
00:16:36,120 --> 00:16:38,200
.قدّيسة البلدة الغربيّة

298
00:16:38,200 --> 00:16:42,680
.رثى جدّي موتها قبل عشر سنوات على ما أظنّ

299
00:16:42,940 --> 00:16:48,700
لا بدّ أنّه رأى الكثير من الطّرق
.الّتي لم تضطرّ القدّيسة هنا لسلكها

300
00:16:48,700 --> 00:16:49,900
لورن؟

301
00:16:52,380 --> 00:16:53,970
هل أنت متعب؟

302
00:16:53,970 --> 00:16:54,920
.لا

303
00:16:54,920 --> 00:16:57,580
كنت أفكّر في كمّ الأحداث
.الّتي وقعت اليوم

304
00:16:57,940 --> 00:16:59,930
،بالتّفكير في الأمر يا سيّدتي القدّيسة

305
00:16:59,930 --> 00:17:02,080
.كانت وضعيتك جيّدة جدًّا اليوم

306
00:17:03,280 --> 00:17:06,830
ذلك لأنّه... لأنّني شعرت
.أنّ عليّ أن أحسن التّصرّف اليوم

307
00:17:07,770 --> 00:17:11,090
،إذًا فقد كنت مراعية بطريقتك الخاصّة
صحيح يا سيّدتي القدّيسة؟

308
00:17:11,090 --> 00:17:15,000
ولكن الآن، يمكنك التّكاسل كما
!تفعلين في العادة

309
00:17:17,050 --> 00:17:20,430
هـ-هكذا؟

310
00:17:20,430 --> 00:17:21,890
.يبدو ذلك محرجًا قليلاً

311
00:17:21,890 --> 00:17:24,890
...عندما يقال لي أن أقوم بشيء، فحينها

312
00:17:28,140 --> 00:17:32,570
لطالما احترمتني كشخص، صحيح يا لورن؟

313
00:17:32,840 --> 00:17:35,480
.سمعت ما حدث لهيزليتا

314
00:17:35,760 --> 00:17:38,830
.كانت قصّة حزينة ووحيدة نوعًا ما

315
00:17:39,100 --> 00:17:41,820
.وجعلني ذلك أدرك شيئًا مرّة أخرى

316
00:17:42,160 --> 00:17:46,110
.شكرًا لمعاملتك لي بعناية ولطف

317
00:17:47,120 --> 00:17:48,660
.إنّه لشرف لي

318
00:17:48,660 --> 00:17:52,000
.شكرًا لسماحك لي بالاعتناء بك

319
00:17:53,490 --> 00:17:56,290
!مع أنّي أعتني بك أيضًا

320
00:18:05,710 --> 00:18:08,280
!إلى اللّقاء أيّها القسّ أبيل

321
00:18:08,280 --> 00:18:10,840
انتبهي لخطواتك، مفهوم؟

322
00:18:13,480 --> 00:18:14,280
...و

323
00:18:15,320 --> 00:18:16,670
ما الّذي تفعلينه؟

324
00:18:16,670 --> 00:18:21,040
كنتُ أتحرّى لاكتشاف إن كان هنالك
!أشخاص مثيرين للرّيبة حول سيسيليا

325
00:18:21,040 --> 00:18:22,920
.أنت الوحيدة المثيرة للرّيبة هنا

326
00:18:22,920 --> 00:18:25,200
،بما أنّ سوء فهمك حيال لورنس قد حُلّ الآن

327
00:18:25,200 --> 00:18:26,700
فكلّ شيء على ما يرام، صحيح؟

328
00:18:26,700 --> 00:18:29,250
،أفترض أنّه بإمكانك وصف ذلك بسوء الفهم

329
00:18:29,250 --> 00:18:32,460
لكن ألا يجب عليّ أن أصير أكثر اتّزانًا؟

330
00:18:32,910 --> 00:18:34,160
.حسنًا

331
00:18:34,160 --> 00:18:37,330
.سيكون هذا تدريبًا مناسبًا لتظلّي متوازنة

332
00:18:40,180 --> 00:18:41,920
...ما رأيك

333
00:18:41,920 --> 00:18:44,350
بعد أن قضيت وقتًا هنا؟

334
00:18:44,350 --> 00:18:45,680
ماذا تقصد بما هو رأيي؟

335
00:18:46,200 --> 00:18:49,680
،تبدو سيسيليا مسترخية دائمًا

336
00:18:49,680 --> 00:18:53,940
لكن يبدو لي أنّ لورنس مشغول
.دائمًا بالعمل والمهام المنزليّة

337
00:18:53,940 --> 00:18:56,500
،ومع ذلك، يبدو مستمتعًا بوقته

338
00:18:56,500 --> 00:18:59,070
.ويحبّه القرويّون

339
00:18:59,070 --> 00:19:02,190
.صديق قدوة يُحتذى بها بالفعل

340
00:19:02,190 --> 00:19:05,240
.ولكنّه بليد للغاية

341
00:19:05,240 --> 00:19:06,830
وبشكل لا يصدّق، صحيح؟

342
00:19:06,830 --> 00:19:07,990
،أعترف

343
00:19:07,990 --> 00:19:12,120
استمتعت بمشاهدة تعاملاتك المحرجة
.مع السّيّدة سيسيليا يا آنستي

344
00:19:12,620 --> 00:19:14,260
!تعلم أنّه ليس بيدي حيلة

345
00:19:14,260 --> 00:19:17,680
!بالكاد قضيت وقتًا مع فتاة في مثل سنّي

346
00:19:19,550 --> 00:19:21,930
!لا تضحك

347
00:19:23,300 --> 00:19:26,230
لورن، ما ذلك الصّندوق؟

348
00:19:26,230 --> 00:19:27,180
.صحيح

349
00:19:27,180 --> 00:19:30,830
وجدت شيئًا يبعث على الحنين
.عندما كنت أرتّب المخزن

350
00:19:30,830 --> 00:19:32,880
يبعث على الحنين"؟"

351
00:19:32,880 --> 00:19:34,440
ما هو يا ترى؟

352
00:19:40,180 --> 00:19:41,970
!أنتما

353
00:19:42,940 --> 00:19:44,700
!انظرا لهذا

354
00:19:44,700 --> 00:19:47,440
سـ-سيسيليا، ما هذا؟

355
00:19:47,440 --> 00:19:49,710
أليس ظريفًا؟

356
00:19:49,710 --> 00:19:51,120
ماذا؟ ظريف؟

357
00:19:51,120 --> 00:19:54,720
،بما أنّ السّيّدة سيسيليا من قالت هذا
.فلا بدّ أنّه بدافع غريزيّ

358
00:19:54,720 --> 00:19:56,950
!أنا من صنعه

359
00:19:56,950 --> 00:20:00,380
،كان ذلك عندما كنتُ تلميذًا
.لذلك مرّ قوت طويل على ذلك

360
00:20:08,290 --> 00:20:12,480
.يبدو أنّ الشّعور التّعيش عالق في ظهره اليوم

361
00:20:13,640 --> 00:20:15,220
.لا خيار أمامي

362
00:20:15,220 --> 00:20:16,180
!خذ

363
00:20:19,650 --> 00:20:21,330
.مهلاً يا أبيل

364
00:20:21,330 --> 00:20:23,530
أيمكنك ألاّ تفزعني هذا من بداية الصّباح؟

365
00:20:23,530 --> 00:20:26,390
.آسف بشأن ذلك

366
00:20:26,390 --> 00:20:27,530
.مهلاً

367
00:20:27,530 --> 00:20:31,160
ما هذه الأشياء الّتي تبدو
وكأنّها وُلدت من الجحيم؟

368
00:20:31,160 --> 00:20:34,180
.ما هذا الوصف؟ إنّها فريدة من نوعها

369
00:20:34,180 --> 00:20:39,190
،يقيم جدّي حدثًا في الكنيسة
!وفكّرت في تزيينها بهذه

370
00:20:39,190 --> 00:20:40,590
!أنا من صنعها

371
00:20:40,590 --> 00:20:42,430
أليست ظريفة؟

372
00:20:43,920 --> 00:20:48,050
.أردت أن أريها للجميع بما أنّها بهذه الظّرافة

373
00:20:48,050 --> 00:20:49,930
ظرافة"؟"

374
00:20:49,930 --> 00:20:50,830
!نعم

375
00:20:50,830 --> 00:20:53,890
!أخبرني جدّي أن أصنع شيئًا ظريفًا

376
00:20:53,890 --> 00:20:57,350
ألا يعقل أنّه قصد أشياءً تشبه الكلاب أو القطط؟

377
00:20:58,440 --> 00:21:01,170
!لكنّ هذه ظريفة بنفس القدر أيضًا

378
00:21:01,170 --> 00:21:03,320
من أين تأتيك كلّ هذه الثّقة؟

379
00:21:03,600 --> 00:21:07,560
.وفي الحقيقة، إنّها لا تبدو ظريفة جدًّا

380
00:21:07,560 --> 00:21:08,580
!ماذا؟

381
00:21:08,580 --> 00:21:10,300
!لا تقل لي ذلك الآن

382
00:21:10,300 --> 00:21:12,680
.لكنّ القدّيسة قالت أنّها ظريفة

383
00:21:12,680 --> 00:21:14,160
أليس كذلك يا سيّدتي القدّيسة؟

384
00:21:14,160 --> 00:21:16,680
.يا-يا للظّرافة

385
00:21:16,680 --> 00:21:17,720
أرأيت؟

386
00:21:17,720 --> 00:21:18,210
.لا

387
00:21:18,210 --> 00:21:21,800
كانت كلمات السّيّدة القدّيسة الآن
.تصف شيئًا آخر بالكامل

388
00:21:21,800 --> 00:21:23,440
.فهمت

389
00:21:23,440 --> 00:21:25,680
.لا داعي للشّعور باليأس

390
00:21:25,680 --> 00:21:29,920
لنحاول التّفكير في طريقة
!قد تسمح لهما بقبول أنّها ظريفة

391
00:21:29,920 --> 00:21:32,180
.سيّدتي القدّيسة

392
00:21:32,180 --> 00:21:34,710
ماذا إن أضفنا لها صفات أكثر ظرافة؟

393
00:21:34,710 --> 00:21:37,440
فهمت. صفات قطط؟

394
00:21:37,440 --> 00:21:40,160
!نعم! لا يوجد ما هو أظرف من القطط

395
00:21:38,020 --> 00:21:43,030
كلاهما بليد، والطّريقة الّتي لا يتوافقان
.بها معًا أبدًا مطمئنة قليلاً

396
00:21:40,160 --> 00:21:43,480
.صحيح! لكنّهما لا يسمحان لي بلمسها

397
00:21:43,030 --> 00:21:46,080
.لكنّه تبدئين بتجاهل الأمر مع الوقت

398
00:21:45,250 --> 00:21:48,030
!ولكن ما دامت ستصير أظرف، فلا بأس

399
00:23:18,490 --> 00:23:20,000
...أخبرني يا لورنس

400
00:23:20,000 --> 00:23:22,800
ما هذا الشّيء الغامق فوقها؟

401
00:23:23,370 --> 00:23:24,750
.يا لسخافتك يا أبيل

402
00:23:24,750 --> 00:23:27,500
واضح أنّها شكولاطة، صحيح؟

403
00:23:27,500 --> 00:23:30,130
!سرّني أنّك عرفت ذلك يا سيّدتي القدّيسة

404
00:23:30,130 --> 00:23:33,920
.أنت تحبّ إعداد الحلويّات وذلك ساعدني

405
00:23:30,440 --> 00:23:32,630
،إن بقينا هنا لوقت طويل

406
00:23:32,630 --> 00:23:35,520
فهل سنبدأ بالحصول على حساسيّات مثل لورنس؟

407
00:23:33,920 --> 00:23:35,520
.محقّ تمامًا

408
00:23:35,520 --> 00:23:39,400
ظننتُ أنّ الشّكولاطة الذّائبة
!فوقها ستجعلها أكثر ظرافة

409
00:23:35,520 --> 00:23:39,400
.ربّما علينا المغادرة في أقرب وقت ممكن