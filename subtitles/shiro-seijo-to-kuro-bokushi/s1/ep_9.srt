1
00:00:00,280 --> 00:00:02,220
!لقد ضعت

2
00:00:02,220 --> 00:00:05,770
.الحديقة هنا في منزل هيزليتا كبيرة جدًّا

3
00:00:05,770 --> 00:00:09,560
أنت من قلت أنّك تريدين التّجوال فيها
...بينما تأخذ هيزليتا دروسها

4
00:00:09,560 --> 00:00:11,450
أليس كذلك يا سيّدتي القدّيسة؟

5
00:00:12,640 --> 00:00:14,210
.لا داعي للقلق

6
00:00:14,210 --> 00:00:16,840
.حرصت على أن أتذكّر طريق العودة

7
00:00:18,200 --> 00:00:19,640
سيّد غيزلبرت؟

8
00:00:19,640 --> 00:00:21,490
.مرحبًا بكما

9
00:00:21,490 --> 00:00:23,610
ماذا تفعل هنا؟

10
00:00:23,610 --> 00:00:25,340
.ماذا؟ صحيح

11
00:00:25,340 --> 00:00:28,620
مجرّد أمر تافه يخصّ رسائل عروض
.الزّواج من هيزليتا

12
00:00:30,590 --> 00:00:32,960
أليس من السّيّئ القيام بهذا؟

13
00:00:32,960 --> 00:00:34,190
.لا بأس

14
00:00:34,190 --> 00:00:36,480
.لا أحد منهم جادّ في هذه المسألة

15
00:00:37,220 --> 00:00:39,470
كم مرّة طلبت منك ألاّ تحرقها؟

16
00:00:40,790 --> 00:00:42,600
.لم تكتب أيّ ردود لها أيضًا

17
00:00:42,600 --> 00:00:44,340
.خذها معك رجاءً

18
00:00:46,120 --> 00:00:49,570
هلاّ ساعدتماني في حملها؟

19
00:02:25,650 --> 00:02:27,990
.ضع الكيس في أيّ مكان

20
00:02:28,300 --> 00:02:30,750
!هناك كتب كثيرة هنا

21
00:02:32,060 --> 00:02:35,260
هيزليتا وامرأة شقراء؟

22
00:02:35,260 --> 00:02:38,510
هل هذه هي القدّيسة فريديريكا؟

23
00:02:39,190 --> 00:02:42,600
يمكنك رؤية حمايتها المقدّسة
ولا يمكنك رؤية شكلها؟

24
00:02:43,080 --> 00:02:47,260
أرى فقط شعرًا أشقر بدا
.وكأنّ أشعة الشّمس تشرق عليه

25
00:02:47,260 --> 00:02:49,300
هكذا هو الأمر إذًا؟

26
00:02:49,300 --> 00:02:50,500
.المعذرة

27
00:02:50,890 --> 00:02:53,520
ما هي الحماية المقدّسة من الأساس؟

28
00:02:54,870 --> 00:02:58,480
أعني، سمعتُ أشياء مبهمة عنها
...من جدّي سابقًا، ولكن

29
00:02:58,480 --> 00:03:00,040
،سيّدة سيسيليا

30
00:03:00,040 --> 00:03:02,500
إنّه شخص يفترض أن تشرحي
له ذلك الأمر، صحيح؟

31
00:03:03,160 --> 00:03:06,670
وإذا كنت ستظلّ إلى جانب
،السّيّدة سيسيليا يا لورنس

32
00:03:06,670 --> 00:03:08,990
فمن الأفضل أن تكون ملمًّا جيّدًا بهذا، صحيح؟

33
00:03:08,990 --> 00:03:10,410
.بالطّبع

34
00:03:10,410 --> 00:03:12,570
،إن كان الأمر يخصّ القدّيسة
.فأريد معرفة كلّ التّفاصيل

35
00:03:14,580 --> 00:03:16,460
.وها هي الجملة الّتي قتلت سيسيليا

36
00:03:17,900 --> 00:03:19,960
،في البداية

37
00:03:19,960 --> 00:03:23,050
إنّ هدف القدّيسات هو جعل هذا
.العالم ومن يعيشون فيها أغنى

38
00:03:23,050 --> 00:03:25,720
إنّهنّ نساء تلقّين إلهامًا مقدّسًا
.من أجل ذلك الغرض

39
00:03:26,180 --> 00:03:30,400
.هناك سجلاّت عن وجودهنّ في كلّ حقبة

40
00:03:30,400 --> 00:03:32,560
وحتّى الآن هنالك قدّيسات أخريات

41
00:03:32,560 --> 00:03:34,600
غيرك يعشن في أماكن متفرّقة، صحيح؟

42
00:03:34,600 --> 00:03:37,440
.نعم، لكنّي لم أقابل أيّ واحدة منهنّ

43
00:03:37,830 --> 00:03:42,400
،كانت تُعامل القدّيسات كآلهة فيما سبق

44
00:03:42,400 --> 00:03:47,460
لكنّ معظمهنّ الآن يعشن حياة
.لا تختلف عن باقي النّاس

45
00:03:47,960 --> 00:03:51,880
.آمل فعلاً أنّهنّ يعشن حياة كتلك

46
00:03:53,280 --> 00:03:57,420
لكن عندما يتعلّق الأمر بالقدّيسة
.العظيمة، ذلك ليس كلّ شيء

47
00:03:57,880 --> 00:04:00,670
،تثمّل القدّيسة العظيمة كلّ القدّيسات

48
00:04:00,670 --> 00:04:04,610
وبصفتها شخصًا تحمي القدّيسات
،أيضًا وليس النّاس فقط

49
00:04:04,610 --> 00:04:09,400
فهي تعيش أرض جزيرة ميشيلا
.المقدّسة وتصلّي للجميع كلّ يوم

50
00:04:09,400 --> 00:04:11,020
هل سبق وزرت ذلك المكان؟

51
00:04:11,020 --> 00:04:14,140
.إنّه جميل ويطلّ على محيط واسع

52
00:04:14,140 --> 00:04:15,900
محيط؟

53
00:04:15,900 --> 00:04:19,850
.تنعم تلك الجزيرة بالحماية المقدّسة للقدّيسة العظيمة

54
00:04:20,520 --> 00:04:24,320
الحماية المقدّسة هي إحدى المعجزات
.الّتي تستطيع القدّيسات أداءها

55
00:04:24,810 --> 00:04:28,480
عندما تصلّي قدّيسة من أجل حماية
...شخص آخر أو غرض ما

56
00:04:28,480 --> 00:04:31,830
.يقال أنّ صلواتهنّ تغدو حقيقة كما يتمنّين تمامًا

57
00:04:31,830 --> 00:04:33,120
،على سبيل المثال

58
00:04:33,120 --> 00:04:36,500
إن صلّت إحداهنّ راغبة ألاّ يمرض
...شخص ما أو يتأذّى... فسوف

59
00:04:37,250 --> 00:04:40,500
.هذا ما حدث معك تمامًا يا سيّد غيزلبرت

60
00:04:40,500 --> 00:04:43,640
،وبالطّبع التّأثير ليس مطلقًا

61
00:04:43,640 --> 00:04:45,760
.وهناك أمور لا نستطيع فعلها

62
00:04:45,760 --> 00:04:49,390
الحماية المقدّسة الّتي منحتها
...القدّيسة فريديريكا عليهما

63
00:04:49,390 --> 00:04:52,140
.هو ليس أمرًا يمكننا فعله في العادة

64
00:04:52,140 --> 00:04:53,420
.ذلك ما ظننت

65
00:04:53,420 --> 00:04:55,260
،إن كان من السّهل القيام بشيء كهذا

66
00:04:55,260 --> 00:04:58,400
فسيكون من الصّعب على القدّيسات
.أن يعشن حياة عاديّة

67
00:04:58,400 --> 00:05:01,130
أعتقد أنّ أيّ أحد يتقرّب بشدّة

68
00:05:01,130 --> 00:05:03,640
.من قدّيسة يُعهد لهم بالكثير

69
00:05:03,640 --> 00:05:05,150
.مذهل

70
00:05:05,150 --> 00:05:09,310
هل هناك شيء ما تقومين بحمايته
يا سيّدتي القدّيسة؟

71
00:05:09,310 --> 00:05:11,210
.الكنيسة على سبيل المثال

72
00:05:11,210 --> 00:05:17,290
.و-وأحميك أنت أيضًا يا لورن

73
00:05:17,290 --> 00:05:20,760
!فعلاً؟ شكرًا جزيلاً لك

74
00:05:20,760 --> 00:05:24,300
مع أنّ ذلك أصعب من الطّريقة
!الّتي أحمي بها الآخرين

75
00:05:24,300 --> 00:05:26,680
...كلّ ما هنالك

76
00:05:26,680 --> 00:05:30,240
هو أنّ تأثير الحماية المقدّسة
.معقّد بعض الشّيء

77
00:05:30,240 --> 00:05:32,400
سبب ألم رأس لورن البارحة

78
00:05:32,400 --> 00:05:35,850
هو تراكم حمايتي المقدّسة
،وحماية القدّيسة فريديريكا

79
00:05:35,850 --> 00:05:38,990
وهو في اعتقادي ما جعل
.التّأثير الشّامل أقوى بكثير

80
00:05:39,630 --> 00:05:41,160
.فهمت

81
00:05:41,730 --> 00:05:43,890
...هذا يعني أنّ الصّلاة لحماية شيء ما

82
00:05:43,890 --> 00:05:46,690
أمر قويّ للغاية، صحيح؟

83
00:05:48,350 --> 00:05:49,440
!نعم

84
00:05:49,440 --> 00:05:50,570
،بالتّفكير في الأمر

85
00:05:50,570 --> 00:05:52,040
،في الوقت الّذي قضيناه معًا

86
00:05:52,040 --> 00:05:54,940
.لم تتكلّمي عن أيّ شيء بالتّفصيل معي

87
00:05:54,940 --> 00:05:56,830
...ذ-ذلك لأنّ

88
00:05:56,830 --> 00:06:01,190
في البداية، ظننتُ أنّ بإمكاني
،إخبارك بكلّ التّفاصيل لاحقًا

89
00:06:01,190 --> 00:06:03,280
...لكن كلّما طال الوقت

90
00:06:03,280 --> 00:06:05,400
إنّ إظهار جانب القدّيسة فيّ

91
00:06:05,400 --> 00:06:08,420
.سيزيد من المسافة بيننا وهو ما لا أريده

92
00:06:08,420 --> 00:06:09,990
،وبعد كلّ هذا الوقت
أنت قلقة حيال ذلك؟

93
00:06:10,550 --> 00:06:14,160
.أعلم أنّك مميّزة يا سيّدتي القدّيسة

94
00:06:14,160 --> 00:06:19,060
،وأنا لا أنظر إليك كقدّيسة فحسب
.بل وكشخص أيضًا

95
00:06:19,060 --> 00:06:21,590
،كونك قدّيسة هو جزء واحد منك فقط

96
00:06:21,590 --> 00:06:24,400
لكنّ لا أحد سيضع مسافية
.بينه وبين شخص عزيز عليه

97
00:06:24,400 --> 00:06:25,770
.محقّ تمامًا

98
00:06:25,770 --> 00:06:26,400
صحيح؟

99
00:06:27,180 --> 00:06:28,650
...لـ-لكن

100
00:06:28,650 --> 00:06:32,570
.إنّك تناديني "سيّدتي القدّيسة" دائمًا يا لورن

101
00:06:32,570 --> 00:06:35,620
ألستَ هكذا تضع مسافة بيننا لأنّني قدّيسة؟

102
00:06:35,620 --> 00:06:36,390
ماذا؟

103
00:06:36,390 --> 00:06:39,550
أخبرتك أنّني سأعمل على ذلك، صحيح؟

104
00:06:40,650 --> 00:06:43,320
،إذًا فيما عدى طريقة مناداتك لها

105
00:06:43,320 --> 00:06:46,060
فأنت تعاملها كفتاة عاديّة؟

106
00:06:46,690 --> 00:06:50,140
.ذ-ذلك صحيح

107
00:06:51,170 --> 00:06:52,690
.أنا راضية

108
00:06:52,690 --> 00:06:53,920
لماذا؟

109
00:06:54,250 --> 00:06:58,200
،لا أعرف الكثير عن القدّيسة العظيمة

110
00:06:58,200 --> 00:07:01,720
لكنّك تبدو أنت تعرف الكثير عنها
.يا سيّد غيزلبرت

111
00:07:01,720 --> 00:07:06,100
حتّى الآن، ما زالت تجمعني علاقة
.بالقدّيسة العظيمة

112
00:07:06,730 --> 00:07:09,000
.أنا أقوم ببعض الأعمال من أجلها

113
00:07:09,000 --> 00:07:13,050
إنّي أجري تحقيقًا إن كانت القدّيسات
.في أماكن مختلفة تعشن حياة مسالمة

114
00:07:13,050 --> 00:07:15,060
.وهكذا عرفتُ بأمركما

115
00:07:15,060 --> 00:07:16,740
.فهمت

116
00:07:17,470 --> 00:07:22,410
.لا أريد أن تكون هناك حالات مشابه لفريديريكا

117
00:07:23,920 --> 00:07:25,930
...هذا العمل الّذي تقوم به

118
00:07:25,930 --> 00:07:28,440
لم تخبر الآنسة هيزليتا عنه، صحيح؟

119
00:07:28,440 --> 00:07:31,260
هل أنت واثق أنّ لا بأس من إخبارنا؟

120
00:07:31,740 --> 00:07:33,760
...لا أدري ما السّبب

121
00:07:33,760 --> 00:07:35,680
،ولكن عندما أراكما

122
00:07:35,680 --> 00:07:39,060
.قد يبدو شرحي للأمور مخادعًا لكما

123
00:07:39,060 --> 00:07:41,130
.يمكن القول أنّكما تبهرانني

124
00:07:41,130 --> 00:07:43,760
أعتقد أنّ تقرّبكما من بعضكما
.قد بدأ يؤثّر فيّ

125
00:07:44,770 --> 00:07:48,360
!لورن، إنّنا نبدو مقرّبين من بعضنا

126
00:07:48,360 --> 00:07:50,160
فعلاً؟

127
00:07:50,160 --> 00:07:55,280
فقبل كلّ شيء، عندما أتكلّم مع السّيّدة
.سيسيليا مباشرة، يزداد حذرك منّي

128
00:07:55,280 --> 00:07:58,200
،لا أقصد القيام بذلك

129
00:07:58,200 --> 00:08:01,290
.لكن صحيح أنّي أشعر ببعض القلق لسبب ما

130
00:08:01,290 --> 00:08:04,910
،لو لم ألمس السّيّدة سيسيليا في لقائنا الأوّل

131
00:08:04,910 --> 00:08:06,960
!ما كنت لتشعر هكذا حيالي

132
00:08:06,970 --> 00:08:08,190
فعلاً؟

133
00:08:08,190 --> 00:08:12,040
...حتّى بعد قول كلّ هذا
ما زلت لا تدرك الآمر؟

134
00:08:12,770 --> 00:08:14,040
.حسنًا

135
00:08:14,040 --> 00:08:17,600
.ماذا أفعل بكلّ رسائل عروض الزّواج هذه

136
00:08:19,090 --> 00:08:20,930
!هـ-هيزليتا؟

137
00:08:20,930 --> 00:08:23,070
هـ-هل انتهت دروسك؟

138
00:08:23,070 --> 00:08:25,460
—لا علاقة لهذه الرّسائل بك، لذا

139
00:08:25,460 --> 00:08:26,580
...أخي العزيز

140
00:08:26,580 --> 00:08:29,940
.رأيت سيسيليا ولورنس يخرجان من هنا

141
00:08:30,250 --> 00:08:32,600
لم تقل أيّ شيء غريب لهما، صحيح؟

142
00:08:32,600 --> 00:08:34,520
لماذا قد تسأليني عن شيء كهذا؟

143
00:08:34,520 --> 00:08:39,260
.لأنّك دائمًا تقول أكثر الأشياء الفظيعة

144
00:08:39,260 --> 00:08:42,370
لماذا أنت قلقة جدًّا عليهما؟

145
00:08:42,370 --> 00:08:46,620
.لقد اعتنيا جيّدًا بي عندما كنت في ضيافتهما

146
00:08:46,620 --> 00:08:48,130
...إضافة لذلك

147
00:08:48,130 --> 00:08:50,090
،بالنّسبة لنا نحن الاثنين

148
00:08:50,090 --> 00:08:53,350
سعادة القدّيسة أكثر أهمّيّة
من أيّ شيء آخر، صحيح؟

149
00:08:53,630 --> 00:08:56,060
.نعم، ذلك صحيح

150
00:08:56,960 --> 00:08:58,650
.يراودني نفس الشّعور أيضًا

151
00:08:59,180 --> 00:09:03,010
بالمناسبة، هل كلّ تلك الرّسائل موجّهة لك؟

152
00:09:03,010 --> 00:09:05,510
ألا تنظر أنّك جعلتها تتراكم كثيرًا؟

153
00:09:05,510 --> 00:09:07,580
.نعم... صحيح

154
00:09:09,250 --> 00:09:11,130
.ممنوع إشعال النّار

155
00:09:12,560 --> 00:09:16,030
...تكاسل

156
00:09:16,760 --> 00:09:18,920
...عندما قلتُ أنّنا سنغادر غدًا

157
00:09:18,920 --> 00:09:20,670
...فلم يُقيموا حفلة فحسب

158
00:09:20,780 --> 00:09:23,920
.فقد جهّزوا كلّ هذا الطّعام
هل سنتمكّن من أكله كلّه؟

159
00:09:23,920 --> 00:09:26,980
،يدفعني هذا لتركه لك يا إريك
.فأنت لا زلت تكبر

160
00:09:26,980 --> 00:09:28,580
.أنا لا آكل الكثير

161
00:09:28,580 --> 00:09:30,220
!هذا جيّد

162
00:09:30,220 --> 00:09:31,330
.وصلتُ في الوقت المناسب

163
00:09:31,330 --> 00:09:32,260
هاين؟

164
00:09:32,260 --> 00:09:33,990
!شكرًا على الحضور

165
00:09:33,990 --> 00:09:35,950
!سررت بالدّعوة

166
00:09:35,950 --> 00:09:40,480
لكن هل كان عليّ ارتداء ملابس أفضل؟

167
00:09:40,480 --> 00:09:43,720
.لا، لقد أجبرتُ على ارتداء هذا فحسب

168
00:09:43,720 --> 00:09:44,840
،قالت الخادمة

169
00:09:44,840 --> 00:09:47,200
"لماذا الفتيات فقط هم المتأنّقات؟"

170
00:09:47,200 --> 00:09:48,890
.لهذا السّبب نحن متأنّقون هكذا

171
00:09:48,890 --> 00:09:51,380
هل ما زالت كلّ الفتيات تتحضّرن؟

172
00:09:51,380 --> 00:09:54,440
.لا تحبّ الآنسة ارتداء ملابس فخمة

173
00:09:54,440 --> 00:09:56,400
لكنّ الخادمات رغبن بهذا بشدّة

174
00:09:56,400 --> 00:09:58,070
.بعد أن مرّ وقت طويل على قيامهنّ بذلك

175
00:09:59,070 --> 00:10:03,800
هذا فقط لأنّ ذوق الخادمات
.لا يتناسب مع ذوقي

176
00:10:03,800 --> 00:10:05,830
كلاّ. متى وصلتِ إلى هنا؟

177
00:10:06,280 --> 00:10:07,520
ما هذا؟

178
00:10:07,520 --> 00:10:10,200
.آنسة هيزليتا، تبدين متحمّسة كثيرًا بهذا

179
00:10:10,200 --> 00:10:12,760
إنّها تبدو هكذا في العادة عندما
.يكون هنالك حدث ما

180
00:10:12,760 --> 00:10:14,010
.يا إلهي

181
00:10:14,590 --> 00:10:17,800
فستان جميل يتماشى جيّدًا مع لون
شعرها، وهذا كلّ ما لديك لتقوله؟

182
00:10:17,800 --> 00:10:19,630
أبيل، ألست تبالغ كثيرًا؟

183
00:10:19,630 --> 00:10:21,370
!كاميلا، يوري

184
00:10:21,370 --> 00:10:22,250
...وأيضًا

185
00:10:23,240 --> 00:10:25,400
لماذا تختبئين؟

186
00:10:28,180 --> 00:10:32,100
!سـ-سرّح لورن شعره بطريقة مختلفة

187
00:10:32,420 --> 00:10:33,550
ما الخطب؟

188
00:10:33,550 --> 00:10:34,860
!لا-لا شيء

189
00:10:37,840 --> 00:10:39,910
...عفوًا

190
00:10:39,910 --> 00:10:43,440
هناك طعام لذيذ من كلّ الأنواع هنا، صحيح؟

191
00:10:45,450 --> 00:10:47,270
.يبدو خفيفًا

192
00:10:47,950 --> 00:10:50,000
تقصد شعري؟

193
00:10:50,000 --> 00:10:52,200
.سرّحته الخادمات من أجلي

194
00:10:52,200 --> 00:10:55,760
،إنّه ليس أسلوبًا يمكنني اعتماده دائمًا
لذلك يبدو منعشًا عليّ، صحيح؟

195
00:10:55,760 --> 00:10:57,920
.نعم، إنّه جميل

196
00:10:59,170 --> 00:11:01,680
!كلاّ! لقد زلّ لساني

197
00:11:01,680 --> 00:11:03,000
أهذا حلم؟

198
00:11:03,000 --> 00:11:05,430
.لا يبدو أنّها قادرة على تحمّل الأمر

199
00:11:05,430 --> 00:11:08,560
!يبدو أنّي رأيت حلمًا جميلاً للتّوّ

200
00:11:12,690 --> 00:11:14,430
!اسمعي يا آنسة سيسيليا

201
00:11:14,430 --> 00:11:15,970
هل نذهب للدّردشة هناك؟

202
00:11:15,970 --> 00:11:16,810
ماذا؟

203
00:11:16,810 --> 00:11:17,570
!مهلاً

204
00:11:17,570 --> 00:11:19,400
إلى أين تأخذين ضيفة شرف الحفلة؟

205
00:11:19,400 --> 00:11:20,650
...إذًا

206
00:11:21,120 --> 00:11:22,820
هل تريدين المجيء معنا؟

207
00:11:22,820 --> 00:11:23,650
!ماذا؟

208
00:11:23,650 --> 00:11:25,160
ما-ماذا يحدث؟

209
00:11:25,160 --> 00:11:26,710
.لن نأخذ الكثير من الوقت

210
00:11:27,660 --> 00:11:28,790
.هيّا

211
00:11:28,790 --> 00:11:31,860
ما الّذي أردت الحديث عنه؟

212
00:11:31,860 --> 00:11:34,480
!سنكمل حديثنا السّابق بالتّأكيد

213
00:11:34,480 --> 00:11:38,800
لم تخبريني عن علاقتك بلورنس بعد، صحيح؟

214
00:11:38,800 --> 00:11:40,300
،بشأن ذلك

215
00:11:40,300 --> 00:11:42,840
.يمكنك القول أنّه ليس لديّ ما أقوله

216
00:11:42,840 --> 00:11:45,300
.لا تستطيع سيسيليا الكذب

217
00:11:45,300 --> 00:11:49,310
سيكون عليّ مساعدتها في الحديث
!وإخفاء حقيقة أنّها قدّيسة

218
00:11:49,310 --> 00:11:51,310
...حسنًا

219
00:11:51,310 --> 00:11:53,150
ما حقيقة العلاقة بينكما؟

220
00:11:53,150 --> 00:11:54,960
لستما مجرّد صديقين، صحيح؟

221
00:11:54,960 --> 00:11:56,520
هل تعيشان على مقربة من بعضكما؟

222
00:11:56,520 --> 00:11:58,490
.عفوًا... إنّنا نعيش معًا

223
00:11:58,490 --> 00:12:00,360
تعيشان معًا؟

224
00:12:00,360 --> 00:12:02,560
لكنّكما لستُما متزوّجان؟

225
00:12:02,560 --> 00:12:03,810
لماذا تعيشان معًا؟

226
00:12:03,810 --> 00:12:05,560
—هذا لأنّ... لأنّي

227
00:12:05,560 --> 00:12:09,370
أنت تحبّين طبخ لورنس كثيرًا، لدرجة
أنّك انتقلت للعيش معه، صحيح؟

228
00:12:09,370 --> 00:12:10,070
ماذا؟

229
00:12:10,070 --> 00:12:13,000
لكنّك تحبّين لورنس، صحيح؟

230
00:12:14,000 --> 00:12:15,850
.ذلك واضح وضوح الشّمس

231
00:12:15,850 --> 00:12:19,720
،إن كنتما تعيشان تحت نفس السّقف
.فلا بدّ من حدوث أمر ما

232
00:12:19,720 --> 00:12:20,760
.لم يحدث شيء

233
00:12:20,760 --> 00:12:21,760
ماذا؟

234
00:12:21,760 --> 00:12:23,160
.لم يحدث أيّ شيء

235
00:12:24,260 --> 00:12:25,520
.يا إلهي

236
00:12:25,520 --> 00:12:28,220
إنّ لورنس بليد جدًّا بالفعل، صحيح؟

237
00:12:28,220 --> 00:12:31,180
.أتساءل إن كان يعتبرك أختًا صغيرة له

238
00:12:31,180 --> 00:12:32,000
!مهلاً

239
00:12:32,000 --> 00:12:33,520
...لكن

240
00:12:33,520 --> 00:12:38,020
!لقد أخبرني أنّه سيحاول مناداتي باسمي

241
00:12:38,020 --> 00:12:39,010
ماذا؟

242
00:12:39,610 --> 00:12:43,980
هل تطوّرت علاقتهما دون أن أعلم؟

243
00:12:45,400 --> 00:12:48,920
.صحيح. عليّ طرح سؤال مهمّ جدًّا

244
00:12:48,920 --> 00:12:52,420
ما أكثر شيء تحبّينه في لورنس يا آنسة سيسيليا؟

245
00:12:52,420 --> 00:12:53,160
—كلّ

246
00:12:53,160 --> 00:12:54,480
.كلّ شيء" ليس ردًّا مقبولاً"

247
00:12:54,480 --> 00:12:56,580
ماذا تقصدين؟

248
00:12:56,580 --> 00:12:58,610
أكثر شيء؟

249
00:12:58,610 --> 00:13:01,050
...هل هو طبخه اللّذيذ

250
00:13:01,050 --> 00:13:02,840
...أم لطفه الشّديد

251
00:13:05,090 --> 00:13:06,390
.آنسة كاميلا

252
00:13:07,090 --> 00:13:10,850
هل هناك فعلاً حاجة لتعرفي كلّ هذا عنهما؟

253
00:13:10,850 --> 00:13:14,000
.هذه الفتاة الظّريفة قلقة

254
00:13:14,000 --> 00:13:15,600
كيف لي أن أتركها وحدها؟

255
00:13:17,530 --> 00:13:18,480
!المعذرة

256
00:13:19,330 --> 00:13:21,730
.قلّلت خياراتي لشيء واحد

257
00:13:22,320 --> 00:13:26,000
.ينقذني لورن دائمًا

258
00:13:26,000 --> 00:13:28,730
.إنّه يمدّ يده لي دائمًا

259
00:13:28,990 --> 00:13:32,120
.يثق بي كثيرًا

260
00:13:32,120 --> 00:13:36,170
—أعتقد أنّ ذلك هو أكثر شيء... أحـ

261
00:13:38,120 --> 00:13:39,620
!لا تستطيع قولها

262
00:13:39,620 --> 00:13:42,350
هل تصدّقين أنّ لورن لا يمكنه فهم هذا؟

263
00:13:42,350 --> 00:13:44,520
.إنّ كلّ ما يفعله مؤسف بالفعل

264
00:13:44,520 --> 00:13:46,210
...لـ-لهذا السّبب

265
00:13:46,210 --> 00:13:49,540
.سيفهم يومًا ما كيف أشعر حياله

266
00:13:49,540 --> 00:13:53,080
،أعتقد ذلك بشدّة
.لذلك لا أرى أيّ حاجة للقلق

267
00:13:53,080 --> 00:13:54,440
فعلاً؟

268
00:13:54,970 --> 00:13:57,770
لن تتخلّي عن لورنس يومًا ما؟

269
00:13:57,770 --> 00:13:58,850
أتخلّى عنه...؟

270
00:13:58,850 --> 00:14:01,520
.لورنس بليد جدًّا فحسب

271
00:14:01,520 --> 00:14:04,650
.أنا قلقة أنّك ستسأمين منه يا آنسة سيسيليا

272
00:14:04,650 --> 00:14:07,860
.لهذا السّبب كانت تسأل كلّ هذه الأسئلة

273
00:14:07,860 --> 00:14:09,760
!لن يحلّ يوم كهذا أبدًا

274
00:14:10,280 --> 00:14:12,450
!إنّك ظريفة جدًّا بالفعل

275
00:14:12,450 --> 00:14:14,240
.تجعلينني أرغب في أخذك معي للمنزل

276
00:14:14,240 --> 00:14:17,200
هلا تصرّفت باحترام أكثر مع سيسيليا؟

277
00:14:18,690 --> 00:14:21,010
هل أنت قلق على السّيّدة سيسيليا؟

278
00:14:22,000 --> 00:14:26,340
،الآنسة هيزليتا معها
...لذلك أظنّ أنّها ستكون بخير

279
00:14:26,340 --> 00:14:29,520
.بالمناسبة، شكرًا على هذا اليوم

280
00:14:29,520 --> 00:14:31,740
.أنتما من ساعدتمانا

281
00:14:31,740 --> 00:14:34,550
وكنتما شريكَيّ في الحديث أيضًا

282
00:14:34,550 --> 00:14:35,470
.ذلك لا شيء

283
00:14:35,800 --> 00:14:39,350
.ربّما لأنّكما في نفس وضعي

284
00:14:39,350 --> 00:14:41,480
لهذا السّبب انتهى بي المطاف
.أتشارك الكثير معكما

285
00:14:41,880 --> 00:14:45,410
.آمل أن تستطلع سيّدتك القدّيسة العيش بسعادة

286
00:14:45,410 --> 00:14:46,980
.إنّها ليست "سيّدتي" فقط

287
00:14:49,000 --> 00:14:50,740
.هذا صحيح

288
00:14:51,040 --> 00:14:53,740
واثق أنّ القدّيسة ستكون بخير

289
00:14:53,740 --> 00:14:58,630
.لأنّها تعرف أنّ من حولها يحبّونها

290
00:15:00,870 --> 00:15:02,810
!لورن

291
00:15:03,660 --> 00:15:05,320
.لا بدّ أنّك جائعة

292
00:15:05,320 --> 00:15:07,920
.اخترت بعض الأشياء الّتي قد تحبّينها

293
00:15:09,050 --> 00:15:10,880
!وهناك مشروبات أيضًا

294
00:15:10,880 --> 00:15:12,190
!شكرًا لك

295
00:15:13,380 --> 00:15:16,220
الآنسة سيسيليا جميلة جدًّا، صحيح؟

296
00:15:16,220 --> 00:15:19,640
.لا يتوجد فتاة يسهل فهمها مثلها

297
00:15:19,640 --> 00:15:21,160
يسهل فهمها؟

298
00:15:21,160 --> 00:15:23,870
هل أنت هكذا دائمًا؟

299
00:15:23,870 --> 00:15:25,230
كيف؟

300
00:15:25,230 --> 00:15:29,270
ألم تفكّر أبدًا كم أنّها ظريفة؟

301
00:15:29,270 --> 00:15:30,120
ماذا؟

302
00:15:32,580 --> 00:15:34,340
!كم هذا لذيذ

303
00:15:34,340 --> 00:15:38,080
.سيسيليا، أعلم أنّك تحبّين طبخ لورنس أكثر

304
00:15:38,080 --> 00:15:41,510
.لكن صحيح أنّ هذا لذيذ أيضًا

305
00:15:41,510 --> 00:15:45,960
بدءًا من الغد، ستأكلين من طبخه
.المنزليّ ثانية بكلّ سعادة

306
00:15:47,160 --> 00:15:50,840
.هيزليتا، يمكنك أكله معي أيضًا

307
00:15:50,840 --> 00:15:52,960
ماذا؟

308
00:15:53,340 --> 00:15:54,590
!ماذا؟

309
00:15:54,590 --> 00:15:57,920
لن تعودي معنا غدًا يا هيزليتا؟

310
00:15:57,920 --> 00:15:59,180
.هذا مفاجئ

311
00:15:59,180 --> 00:16:02,360
بعد التّفكير في الأمر، أظنّني لم أخبرك بهذا، صحيح؟

312
00:16:02,360 --> 00:16:05,420
.افترضتُ فقط أنّك ستظلّين معنا دائمًا

313
00:16:05,420 --> 00:16:08,150
.صحيح أنّي كنت مرتاحة جدًّا هناك

314
00:16:08,150 --> 00:16:09,900
...هيزليتا

315
00:16:09,900 --> 00:16:12,500
.أنا أيضًا لن أعود

316
00:16:12,500 --> 00:16:15,360
أبيل، تبدو لي أنّك ستمرّ على المنزل
...في أيّ لحظة، لذلك

317
00:16:15,360 --> 00:16:16,500
ماذا؟

318
00:16:16,500 --> 00:16:18,800
.هذا ليس أمرًا محزنًا

319
00:16:18,800 --> 00:16:21,910
واثقة أنّنا كنّا نعترض طريقكما أثناء
.إقامتنا معكما فحسب

320
00:16:21,910 --> 00:16:24,590
!كلاّ! لم تكونا كذلك أبدًا

321
00:16:24,590 --> 00:16:27,300
لقد استمتعنا نحن الأربعة معًا، صحيح؟

322
00:16:30,130 --> 00:16:31,800
.نعم

323
00:16:33,300 --> 00:16:35,750
توديع الأصدقاء يُشعر المرء بالوحدة، صحيح؟

324
00:16:35,750 --> 00:16:37,880
.لا يسعنا سوى الشّعور بالحزن

325
00:16:37,880 --> 00:16:40,560
!لديّ فكرة ممتازة

326
00:16:40,560 --> 00:16:43,320
!ربّما عليكما الانتقال لهذه المدينة

327
00:16:43,320 --> 00:16:45,880
.هذا اقتراح غير مسؤول على الإطلاق

328
00:16:45,880 --> 00:16:47,290
لكنّها فكرة ممتازة، صحيح؟

329
00:16:47,290 --> 00:16:49,540
.صحيح؟ لنقم بذلك

330
00:16:49,850 --> 00:16:52,110
...عـ-عفوًا، ذلك

331
00:16:52,110 --> 00:16:53,150
.لن ينفع

332
00:16:54,400 --> 00:16:58,530
لا تستطيع قريتنا المواصلة
.بدون القسّ أو السّيّدة سيسيليا

333
00:16:58,530 --> 00:16:59,780
.إريك

334
00:16:59,780 --> 00:17:00,810
.معك حقّ

335
00:17:00,810 --> 00:17:03,430
ماذا إن بقيت الآنسة سيسيليا وحدها هنا؟

336
00:17:03,430 --> 00:17:04,410
كاميلا؟

337
00:17:04,620 --> 00:17:07,780
كفّي عن ذلك إن أردتِ أن يظلّ
.لورنس وجودًا هكذا

338
00:17:07,780 --> 00:17:08,920
.يا إلهي

339
00:17:09,990 --> 00:17:12,920
.تبدين غارقة في التّفكير

340
00:17:12,920 --> 00:17:16,180
.ها انت ذا تتحدّث وكأنّك تفهم كيف يشعر الآخرون

341
00:17:16,180 --> 00:17:18,910
.كنتِ كالكتاب المفتوح هذه المرّة

342
00:17:20,200 --> 00:17:24,900
.كرهت التّقرّب من الآخرين منذ ما حدث

343
00:17:24,900 --> 00:17:28,400
.كرّست نفسي لأشياء مثل دروسي وما شابه

344
00:17:28,400 --> 00:17:33,320
.كبرت دون قضاء الوقت مع أقراني

345
00:17:33,320 --> 00:17:39,200
لذلك السّبب فإنّ كلّ يوم أقضيه
.مع سيسيليا والبقيّة كان ممتعًا

346
00:17:40,060 --> 00:17:43,490
.كلّ ما فعلتِه هو إظهار تحفّظك يا آنستي

347
00:17:43,490 --> 00:17:48,290
.أعتقد أنّه يُسمح لك بطلب أنانيّ واحد

348
00:17:48,290 --> 00:17:50,640
.لا تقل ذلك وكأنّه أمر بسيط

349
00:17:50,640 --> 00:17:52,750
،في غياب والديك الآن

350
00:17:52,750 --> 00:17:55,510
من هو المسؤول عن هذا المنزل؟

351
00:17:57,360 --> 00:17:59,820
.نعم... صحيح

352
00:18:02,320 --> 00:18:05,960
،كان الطّعام لذيذًا
واستمتعنا بوقتنا أيضًا، صحيح؟

353
00:18:05,960 --> 00:18:07,020
.نعم

354
00:18:08,840 --> 00:18:11,890
هل تمكّنت من الحديث مع هيزليتا كثيرًا؟

355
00:18:11,890 --> 00:18:16,480
.نعم، لكنّ ذلك لا يغيّر شعوري هذا بالوحدة

356
00:18:16,480 --> 00:18:21,750
،لو كنتُ أنانيّة أكثر
.لوددت أن أبقى هنا أكثر

357
00:18:22,210 --> 00:18:23,750
.نعم

358
00:18:31,530 --> 00:18:33,160
هيزليتا؟

359
00:18:33,160 --> 00:18:37,850
أخي، هل أستطيع أن أطلب منك طلبًا أنانيًّا؟

360
00:18:39,010 --> 00:18:42,000
تريدين البقاء معهما؟

361
00:18:43,260 --> 00:18:45,200
...ولكن يا هيزليتا

362
00:18:45,200 --> 00:18:48,720
.حان الوقت لتبدئي بالتّفكير بمستقبلك

363
00:18:48,720 --> 00:18:51,720
هل يمكنك القيام بأمر كذاك الآن؟

364
00:18:52,140 --> 00:18:56,980
.عرفتُ ما أريده منذ وقت طويل

365
00:18:57,530 --> 00:19:01,480
.أريد أن أقوم بما فيه مصلحة للقدّيسات

366
00:19:03,440 --> 00:19:05,990
.أنت أختي الصّغيرة بالفعل

367
00:19:06,360 --> 00:19:08,370
.لديّ شرط واحد

368
00:19:08,370 --> 00:19:10,840
.الدّراسات الأكاديميّة. الآداب المجتمعيّة

369
00:19:10,840 --> 00:19:13,110
ستخوضين امتحانات في هذين
،الموضوعين إضافة لمواضيع أخرى

370
00:19:13,110 --> 00:19:16,290
وعليك الحصول على علامات أعلى
.ممّا حصلتُ عليه أنا

371
00:19:16,290 --> 00:19:19,130
.سيكون ذلك ضروريًّا لإقناع من حولنا

372
00:19:19,130 --> 00:19:20,480
يمكنك ذلك، صحيح؟

373
00:19:21,140 --> 00:19:22,340
!بالطّبع

374
00:19:22,340 --> 00:19:24,440
يمكنني حتّى الحصول
.على علامة مثاليّة إن أردت

375
00:19:24,440 --> 00:19:25,980
.سرّني سماع هذا

376
00:19:25,980 --> 00:19:28,080
،لن تجهز في الوقت المناسب قبل رحيلهما

377
00:19:28,080 --> 00:19:30,220
.لكنّي سأحضّر الامتحانات في أسرع وقت ممكن

378
00:19:30,220 --> 00:19:31,710
...وأيضًا

379
00:19:31,710 --> 00:19:34,570
.عليك أن تعبّري عن امتنانك للورنس

380
00:19:35,650 --> 00:19:37,000
.حاضرة

381
00:19:37,000 --> 00:19:38,690
.وشكرًا لك أيضًا يا أخي

382
00:19:40,680 --> 00:19:45,450
آسف لأنّي لم أتمكّن من تركك تقولين
.ما تريدينه قبل الآن أكثر فأكثر يا هيزليتا

383
00:19:48,270 --> 00:19:51,520
.بالمناسبة يا لورنس، أريد نصيحتك في أمر ما

384
00:19:51,520 --> 00:19:52,590
ما هو؟

385
00:19:52,590 --> 00:19:56,130
.إن كان أمرًا خبيثًا، فسأخبر أختك به

386
00:19:56,130 --> 00:19:58,540
كيف يمكنك قول ذلك للشّخص الّذي يدفع راتبك؟

387
00:19:58,800 --> 00:20:02,090
.إنّه أمر يعني الكثير لهيزليتا

388
00:20:03,060 --> 00:20:05,720
.أردت نصيحة بشان أمر ما أيضًا

389
00:20:05,720 --> 00:20:09,090
.ما يعني أنّ لهذا الأمر علاقة بالسّيّدة سيسيليا

390
00:20:09,720 --> 00:20:11,230
.فهمت

391
00:20:11,710 --> 00:20:17,000
.ربّما نفكّر جميعنا بنفس الشّيء

392
00:20:19,600 --> 00:20:21,110
أين سيسيليا؟

393
00:20:21,110 --> 00:20:23,700
.أوصلتها إلى غرفتها للتّوّ

394
00:20:23,700 --> 00:20:25,010
.فهمت

395
00:20:25,010 --> 00:20:27,340
.عفوًا يا آنسة هيزليتا

396
00:20:27,950 --> 00:20:31,030
.في الحقيقة، تشعر القدّيسة بالوحدة

397
00:20:31,030 --> 00:20:34,410
.تكلّمنا عن افتراقها عن أوّل صديقة لها على الإطلاق

398
00:20:34,730 --> 00:20:36,160
،لذلك أن كنت لا تمانعين

399
00:20:36,160 --> 00:20:39,320
هل يمكنك البقاء مع القدّيسة لبعض الوقت؟

400
00:20:41,920 --> 00:20:43,910
.كنتُ سأطلب منك نفس الشّيء

401
00:20:49,300 --> 00:20:53,720
أليس من الرّائع أنّ الآنسة هيزليتا
ستتمكّن من زيارتنا ثانية؟

402
00:20:53,720 --> 00:20:54,780
.وأبيل أيضًا

403
00:20:54,780 --> 00:20:55,890
!نعم

404
00:20:55,890 --> 00:20:59,070
،لم أستطع النّوم جيّدًا البارحة

405
00:20:59,070 --> 00:21:01,440
.لكنّي سأنام بهناء الآن

406
00:21:01,440 --> 00:21:03,440
سـ-سيّدتي القدّيسة؟

407
00:21:03,760 --> 00:21:05,690
...بعد زيارتنا لهذه المدينة

408
00:21:05,790 --> 00:21:07,820
.حدث أمور عدّة

409
00:21:08,610 --> 00:21:10,450
...أكثر من السّابق

410
00:21:10,910 --> 00:21:15,560
.أشعر أنّ المسافة بيننا صارت أقصر الآن

411
00:21:20,720 --> 00:21:22,190
.القدّيسات

412
00:21:22,190 --> 00:21:24,030
.أولئك اللاّتي يجب حمايتهنّ

413
00:21:24,500 --> 00:21:27,270
...أخبرني جدّي بأمور عديدة، ولكن

414
00:21:27,600 --> 00:21:30,680
.احرص على ألاّ تخسرها

415
00:21:30,890 --> 00:21:34,560
.و-وأحميك أنت أيضًا يا لورن

416
00:21:34,990 --> 00:21:40,070
.من الممكن أنّي لا أفهم القدّيسات جيّدًا بعد

417
00:21:40,160 --> 00:21:43,730
ألم تفكّر أبدًا كم أنّها ظريفة؟

418
00:21:48,120 --> 00:21:51,080
سـ-سيّدتي القدّيسة؟

419
00:23:24,280 --> 00:23:27,450
!ابذلي جهدك في امتحان الآداب المجتمعيّة

420
00:23:27,450 --> 00:23:28,710
.سأشجّعك

421
00:23:29,080 --> 00:23:32,100
.سأشجّعك في امتحان الرّقص من بعيد أيضًا

422
00:23:32,720 --> 00:23:33,880
...وفي امتحان الكفاءة الأكاديميّة أيضًا

423
00:23:34,310 --> 00:23:37,920
أنت مدرّس، أليس كذلك؟

424
00:23:37,920 --> 00:23:39,600
.لقد لاحظت