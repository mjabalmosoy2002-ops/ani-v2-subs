1
00:00:04,590 --> 00:00:06,020
ما كان ذلك؟

2
00:00:07,030 --> 00:00:10,470
لورن؟ هل أنت هناك؟

3
00:00:11,960 --> 00:00:13,280
لورن؟

4
00:00:15,560 --> 00:00:16,530
...أهذا

5
00:00:16,840 --> 00:00:19,790
—صباح الخير يا سيّدتي القـ

6
00:00:20,490 --> 00:00:22,490
كان ذلك لئيمًا، ألا تظنّ؟

7
00:00:22,490 --> 00:00:26,250
.كنتُ أطرق الباب طوال اللّيل

8
00:00:26,250 --> 00:00:28,080
مهلاً. ماذا؟

9
00:00:30,120 --> 00:00:31,760
.سبق واعتذرت

10
00:00:31,760 --> 00:00:34,360
لورن، من هذا الرّجل؟

11
00:00:34,360 --> 00:00:36,000
.أنا أعتذر

12
00:00:36,000 --> 00:00:38,770
.أعرفه من أيّام دراستي

13
00:00:38,770 --> 00:00:41,290
!أسمي أبيل

14
00:02:16,760 --> 00:02:18,870
...بصراحة

15
00:02:18,870 --> 00:02:20,960
.كان بإمكانك على الأقلّ أنّ تخبرنا مقدّمًا أنّك قادم

16
00:02:20,960 --> 00:02:23,400
لا نحتاج لذلك بما أنّنا صديقان قديمان، صحيح؟

17
00:02:23,400 --> 00:02:25,570
أرى أنّك لم تتغيّر على الإطلاق، صحيح؟

18
00:02:25,570 --> 00:02:27,360
.يمكنني قول نفس الشّيء عنك

19
00:02:27,360 --> 00:02:28,520
.أحسده

20
00:02:29,100 --> 00:02:32,080
هذه هي القدّيسة، صحيح؟

21
00:02:32,080 --> 00:02:34,550
كيف تعرف بشأن القدّيسة؟

22
00:02:35,420 --> 00:02:37,300
.فهمت، فهمت

23
00:02:37,300 --> 00:02:38,120
!أنت قريب جدًّا

24
00:02:38,120 --> 00:02:39,040
!هذا مؤلم

25
00:02:39,300 --> 00:02:42,160
.إيّاك أن تقوم بأيّ شيء يخيف القدّيسة

26
00:02:42,160 --> 00:02:44,200
أخبرني، لماذا أنت هنا؟

27
00:02:44,200 --> 00:02:45,220
...في الحقيقة

28
00:02:45,220 --> 00:02:49,360
فكّرت في العمل هنا معك
!في كنيستك لبعض الوقت

29
00:02:51,530 --> 00:02:52,340
ماذا؟

30
00:02:52,680 --> 00:02:54,110
،لورن

31
00:02:54,110 --> 00:02:58,200
،حتّى أنا أستطيع رؤية أنّ ما خفي أعظم بينكما

32
00:02:58,200 --> 00:03:03,080
...لكنّ إهمال صديق هكذا قد يكون

33
00:03:07,800 --> 00:03:11,240
ما الّذي جعلك تفكّر في العمل هنا من الأساس؟

34
00:03:11,240 --> 00:03:14,660
كنتَ جزءًا من كنيسة في مدينة
أكبر بكثير، أليس كذلك؟

35
00:03:15,450 --> 00:03:16,430
هل طُردت؟

36
00:03:16,430 --> 00:03:19,000
.لا تقل مثل هذه الأشياء المحزنة

37
00:03:19,250 --> 00:03:22,960
.تعبت من التّعامل مع كلّ النّاس

38
00:03:22,960 --> 00:03:24,560
!لورن

39
00:03:24,930 --> 00:03:27,810
ستبقى لبعض الوقت فقط، صحيح؟

40
00:03:28,220 --> 00:03:30,990
.حسنًا! سأذهب لإحضار أغراضي

41
00:03:33,190 --> 00:03:35,260
.آسفة يا سيّدتي القدّيسة

42
00:03:35,260 --> 00:03:37,990
.لا عليك. لا بدّ أنّ الوضع صعب

43
00:03:37,990 --> 00:03:39,580
.نعم

44
00:03:39,580 --> 00:03:43,370
.وإلاّ، فإنّي سأضطرّ لأكون صارمًا معه

45
00:03:43,970 --> 00:03:47,370
إنّي"؟"

46
00:03:47,680 --> 00:03:50,250
!"قال "إنّي

47
00:03:52,750 --> 00:03:54,250
.أخبرني يا لورنس

48
00:03:54,250 --> 00:03:56,960
ما اسم القدّيسة؟

49
00:03:56,960 --> 00:03:59,250
...ماذا؟ ذلك

50
00:04:04,420 --> 00:04:05,200
.تفضّل

51
00:04:05,200 --> 00:04:06,960
لماذا كتبته؟

52
00:04:07,560 --> 00:04:08,750
!سيّدتي القدّيسة

53
00:04:08,750 --> 00:04:12,070
هل يمكنني مناداتك سيّدتي سيسيليا
لأُظهر أنّنا صديقان؟

54
00:04:14,680 --> 00:04:16,140
ما الخطب؟

55
00:04:16,140 --> 00:04:19,930
...لم ينادني أيّ حد باسمي من قبل

56
00:04:19,930 --> 00:04:20,760
ماذا؟

57
00:04:21,260 --> 00:04:22,150
فعلاً؟

58
00:04:22,150 --> 00:04:23,660
ماذا هنالك؟

59
00:04:23,660 --> 00:04:27,470
لديها اسم جميل كهذا لم تنادها به أبدًا؟

60
00:04:27,470 --> 00:04:28,930
هل أنت غبيّ؟

61
00:04:29,280 --> 00:04:34,440
!عندما سألته عن اسمك، قام بكتابته

62
00:04:35,160 --> 00:04:37,890
أبيل، أفترض أنّك تريد تفويت
.الوجبات الثّلاثة التّالية

63
00:04:37,890 --> 00:04:39,370
.أنا آسف

64
00:04:41,270 --> 00:04:45,920
،لديّ بعض المعاملات الورقيّة لإنجازها
لذلك هلاّ انتظرتما قليلاً؟

65
00:04:45,920 --> 00:04:47,160
!أكيد

66
00:04:45,920 --> 00:04:47,160
!طبعًا

67
00:04:50,610 --> 00:04:52,840
...أخبرني يا سيّد أبيل

68
00:04:52,840 --> 00:04:54,300
.نادني أبيل فحسب

69
00:04:54,840 --> 00:04:59,030
.سمعتُ أنّك تعرف لورن منذ أيّام الدّراسة

70
00:04:59,030 --> 00:05:00,440
.تمامًا

71
00:05:00,750 --> 00:05:06,610
عفوًا، هل يملك لورن حـ-حبيبة؟

72
00:05:07,840 --> 00:05:08,960
.نعم

73
00:05:14,030 --> 00:05:17,780
.لطالما كان النّصّ المقدّس كحبيبة له

74
00:05:17,780 --> 00:05:19,210
النّصّ المقدّس؟

75
00:05:19,210 --> 00:05:20,040
.نعم

76
00:05:21,890 --> 00:05:24,180
أبيل، أنت من النّوع الّذي يحبّ
الخدع اللّئيمة، صحيح؟

77
00:05:24,180 --> 00:05:26,590
.سأعطيك هذه كاعتذار

78
00:05:26,590 --> 00:05:27,890
ما هي؟

79
00:05:27,890 --> 00:05:31,220
.الورقة الّتي كتب لورن اسمك عليها يا سيّدتي سيسيليا

80
00:05:31,220 --> 00:05:32,680
!أقبل بكلّ تواضع

81
00:05:32,990 --> 00:05:36,040
.ربّما ليس شخصًا سيّئًا في نهاية المطاف

82
00:05:36,040 --> 00:05:38,640
.لا بدّ أنّ النّاس يصفونك بالمرهفة دائمًا

83
00:05:38,960 --> 00:05:40,650
.آسف على التّأخير

84
00:05:40,900 --> 00:05:43,310
هل نذهب إلى الكنيسة الآن؟

85
00:05:44,190 --> 00:05:46,150
!انتظر لحظة يا لورن

86
00:05:52,410 --> 00:05:54,480
.تفضّل. أنت مستعدّ الآن

87
00:05:54,480 --> 00:05:56,170
.شكرًا لك

88
00:05:58,850 --> 00:06:01,880
.صحيح. قمر اللّيلة في مرحلة المحاق

89
00:06:01,880 --> 00:06:02,670
ماذا؟

90
00:06:02,940 --> 00:06:05,000
.لا تعرني انتباهًا

91
00:06:06,160 --> 00:06:08,280
،بالتّفكير في الأمر ونحن في المدرسة

92
00:06:08,280 --> 00:06:12,450
كان أبيل يأتي إلى زيارتي خلال
.المحاق في العادة

93
00:06:15,000 --> 00:06:17,680
!أشعر بالحنين

94
00:06:17,680 --> 00:06:20,850
إذًا فقد أتيت إلى هنا سابقًا يا أبيل؟

95
00:06:20,850 --> 00:06:21,680
.نعم

96
00:06:21,680 --> 00:06:23,950
،كان بعيدًا عن مسكن المدرسة

97
00:06:23,950 --> 00:06:26,230
.لذلك كان يأتي لقضاء اللّيلة هنا

98
00:06:26,230 --> 00:06:29,040
.كانت الأوضاع مليئة بالحياة
وُبّخنا طوال الوقت، أليس كذلك؟

99
00:06:29,040 --> 00:06:31,860
.ذلك لأنّك شخص نشيط جدًّا

100
00:06:31,860 --> 00:06:33,200
.أحسده

101
00:06:33,220 --> 00:06:34,870
.من السّهل قراءة أفكارك

102
00:06:35,070 --> 00:06:38,870
.يبدو أنّ الغبار يغطّي كلّ شيء. عليّ التّنظيف

103
00:06:38,870 --> 00:06:44,080
من السّهل قراءة أفكارك، ومع ذلك لم يلاحظ؟

104
00:06:44,080 --> 00:06:48,390
.أعتقد أنّه يظنّ أنّه يتصرّف بطبيعة أموميّة نوعًا ما

105
00:06:48,390 --> 00:06:52,230
.عدم ملاحظة الأمور هي إحدى خصاله المؤسفة

106
00:06:52,230 --> 00:06:55,620
.حتّى أنّك تقومين بالكثير لمساعدته

107
00:06:56,260 --> 00:06:57,540
أبيل؟

108
00:06:57,540 --> 00:07:01,840
.حسنًا! أظنّني سأخرج لأتمشّى قليلاً

109
00:07:02,760 --> 00:07:06,450
سيّدتي القدّيسة، يمكنك التّكاسل
.في الأرجاء كعادتك

110
00:07:06,450 --> 00:07:09,480
!لورن! ذلك سرّ

111
00:07:09,480 --> 00:07:11,660
.لا داعي للقلق كثيرًا هكذا

112
00:07:11,660 --> 00:07:15,880
إذًا هل ستقلّلين من التّكاسل يا سيّدتي القدّيسة؟

113
00:07:16,650 --> 00:07:20,360
.سيكون ذلك صعبًا. أودّ فعلاً أنّ أسترخي فحسب

114
00:07:20,360 --> 00:07:21,960
أنت صريحة جدًّا، صحيح؟

115
00:07:21,960 --> 00:07:23,960
.يا لها من معضلة

116
00:07:23,960 --> 00:07:26,190
ماذا أفعل؟

117
00:07:26,190 --> 00:07:28,180
.تعلم أنّي لا أستطيع الكذب

118
00:07:28,440 --> 00:07:30,430
.ما باليد حيلة

119
00:07:30,430 --> 00:07:33,360
عليك في الوقت الحاليّ إيجاد وقت
.لا يوجد فيه أبيل في الأرجاء للتّكاسل

120
00:07:33,360 --> 00:07:34,840
.أفترض ذلك

121
00:07:35,060 --> 00:07:39,800
لكن ليس من العادة أن تقلقي
.حيال كيف قد يراك الآخرون

122
00:07:40,280 --> 00:07:42,820
.لا تُقلقين نفسك أبدًا عندما يتعلّق الأمر لي

123
00:07:45,180 --> 00:07:47,060
ما-ماذا تفعل؟

124
00:07:47,630 --> 00:07:52,320
سبب تكاسلي بدون أن أقلق
...حيال كيف تراني أنت

125
00:07:52,660 --> 00:07:55,900
.هو أنّك تتقبّلني كما أنا يا لورن

126
00:07:57,050 --> 00:08:00,840
.ما كنتُ لأقول أنّني أعير اهتمامًا للآخرين

127
00:08:01,110 --> 00:08:04,800
.أنت مميّز فحسب

128
00:08:04,800 --> 00:08:07,800
.طبعًا، فقد كنّا نعيش معًا لمدّة طويلة الآن

129
00:08:07,800 --> 00:08:09,800
.نعم، ذلك صحيح

130
00:08:09,800 --> 00:08:12,090
.لكنّي أشعر بتحسّن بالفعل

131
00:08:12,090 --> 00:08:13,050
ماذا؟

132
00:08:13,050 --> 00:08:15,190
،قد يكون أبيل صديقي

133
00:08:15,190 --> 00:08:18,380
لكن إن تكاسلت في وجود
،شخص قابلته للتّوّ

134
00:08:18,380 --> 00:08:21,230
فسيكون حينها هنالك أمور أقلّ
،حيالك لا يعرفها سواي

135
00:08:21,230 --> 00:08:22,900
.وسيحزنني ذلك

136
00:08:24,480 --> 00:08:27,230
.والآن، عليّ تجهيز الأمور

137
00:08:27,230 --> 00:08:29,100
.المعذرة يا سيّدتي القدّيسة

138
00:08:33,300 --> 00:08:37,240
إنّ لورن صريح جدًّا لدرجة تخيفني
!بشكل من الأشكال

139
00:08:37,550 --> 00:08:42,280
...إنّه صريح وصادق وذكيّ

140
00:08:42,280 --> 00:08:43,750
.ولطيف

141
00:08:44,640 --> 00:08:48,710
.إنّه أوّل شخص وجدني

142
00:08:59,850 --> 00:09:01,520
!قم بشيء ما للمساعدة

143
00:09:01,520 --> 00:09:04,020
.كنتَ منغمسًا جدًّا وظننت أنّ لا حاجة لي

144
00:09:06,720 --> 00:09:09,920
هل نبدأ التحضيرات؟

145
00:09:09,920 --> 00:09:12,150
هل تهتمّ الجولات في الخارج يا أبيل؟

146
00:09:12,150 --> 00:09:13,820
.أنا مشغول الآن

147
00:09:13,820 --> 00:09:14,960
.اذهب

148
00:09:14,960 --> 00:09:16,530
.حاضر

149
00:09:20,850 --> 00:09:22,610
ما-ماذا؟

150
00:09:22,610 --> 00:09:26,480
.كنت أفكّر فقط في أنّك صارم قليلاً مع صديقك

151
00:09:27,730 --> 00:09:30,100
.إنّه تأثير جدّي عليّ

152
00:09:30,100 --> 00:09:32,540
.كان شخصًا مستقيمًا

153
00:09:34,680 --> 00:09:36,180
لورن؟

154
00:09:36,180 --> 00:09:37,680
هل أنت بخير؟

155
00:09:38,040 --> 00:09:40,480
.أنا آسف. أعاني صداعًا

156
00:09:40,480 --> 00:09:42,560
.سأستلقي قليلاً لبعض الوقت

157
00:09:43,820 --> 00:09:46,560
لماذا يصاب بصداع فجأة هكذا؟

158
00:09:47,560 --> 00:09:49,780
!عـ-عليّ استعداء أحد ما

159
00:09:49,780 --> 00:09:52,100
!انتهيت من الجولات

160
00:09:52,100 --> 00:09:53,570
مهلاً، ما هذا؟

161
00:09:53,570 --> 00:09:55,610
!أبيل! الوضع خطير

162
00:09:55,610 --> 00:09:58,950
ساءت حالة لورن فجأة... ما العمل؟

163
00:09:58,950 --> 00:10:01,120
...أيعقل أنّ هذا

164
00:10:01,760 --> 00:10:03,330
،سيّدتي سيسيليا

165
00:10:03,330 --> 00:10:05,360
هل أنعمت عليه بالكثير من حمايتك المقدّسة؟

166
00:10:10,980 --> 00:10:13,120
.هكذا يتمّ إزالتها غذًا

167
00:10:16,640 --> 00:10:18,560
.أشعر بتحسّن

168
00:10:18,560 --> 00:10:21,180
!لورن! أنا مسرورة للغاية

169
00:10:21,180 --> 00:10:23,060
!...لا، لورن

170
00:10:23,060 --> 00:10:25,840
.واثق أنّه مجرّد ألم جسديّ الآن

171
00:10:26,720 --> 00:10:28,680
.آسف لأنّي لم أقل أي شيء

172
00:10:28,680 --> 00:10:31,770
.لطالما استطعتُ إدراك الكثير من الأمور

173
00:10:31,770 --> 00:10:33,930
لهذا السّبب تمكّنت من رؤية

174
00:10:33,930 --> 00:10:36,750
أنّني أنعمت عليه بالكثير
من حمايتي المقدّسة؟

175
00:10:36,750 --> 00:10:40,280
.لا، لا. ذلك أكثر تقدّمًا ممّا يمكنني رؤيته

176
00:10:40,680 --> 00:10:43,150
.ولكنّي عرفتُ بالفعل أنّها موجودة

177
00:10:43,550 --> 00:10:45,340
،حتّى في الظّروف العاديّة

178
00:10:45,650 --> 00:10:52,160
واضح أنّ هنالك شخصًا معيّنًا
.يحميه أكثر من غيره

179
00:10:53,320 --> 00:10:54,880
،سيّدتي سيسيليا

180
00:10:54,880 --> 00:10:58,170
كم طبقة من الحماية وضعتِ على لورنس؟

181
00:10:58,840 --> 00:11:02,490
.أكثر ممّا يمكنني عدّه

182
00:11:03,790 --> 00:11:07,110
إنّ حقيقة أنّ لا شيء حدث للرون
،من قبل أن نلتقي

183
00:11:07,110 --> 00:11:09,110
كانت بفضلك أنت، صحيح؟

184
00:11:09,110 --> 00:11:10,950
.إنّك تعطين الأمور أكثر من قدرها

185
00:11:10,950 --> 00:11:15,570
فعلتُ ما أمكنني فعله بمعرفتي
.المتواضعة لا غير

186
00:11:12,350 --> 00:11:16,460
،خذ، خذ، خذ، خذ، خذ
...خذ، خذ، خذ

187
00:11:16,460 --> 00:11:20,400
وخلال كلّ ذلك، كانت الأيّام الّتي كان
...القمر محاقًا في لياليها بالأخصّ

188
00:11:21,230 --> 00:11:26,360
تحدث الأشياء السّيّئة بسهولة أكثر
.في اللّيالي الّتي لا نور قمر فيها

189
00:11:26,360 --> 00:11:30,240
ولكنّ الأمور المعاكسة تمامًا
.لذلك تنجذب إليه أيضًا

190
00:11:30,540 --> 00:11:32,740
...الملائكة والشّياطين معًا

191
00:11:32,740 --> 00:11:35,230
.يبدو أنّها تفضّل الأشخاص من أمثاله

192
00:11:40,280 --> 00:11:42,080
هل تستمع لي؟

193
00:11:42,080 --> 00:11:43,130
.آسف

194
00:11:49,010 --> 00:11:53,380
!تعثّرت هنا ثانية! لا أتحمّل هذا

195
00:11:54,330 --> 00:11:59,100
هذا لأنّ هذا هو المكان الوحيد الّذي لا يمكنك
.فيه القراءة مسبقًا في الموسيقى

196
00:11:59,660 --> 00:12:05,080
جدّي، هل حقيقة أنّ اكتشاف
قدّيسة جديدة أمر مهمّ؟

197
00:12:05,080 --> 00:12:06,650
.إنّه كذلك

198
00:12:06,960 --> 00:12:11,040
لأنّ هنالك الآن قدّيسة أخرى
.يسعى إليها الكثيرون

199
00:12:11,040 --> 00:12:13,790
.الجميع سعداء حيال هذا بالطّبع

200
00:12:15,620 --> 00:12:20,000
.لا تملك هذه القرية حماية قدّيسة مقدّسة بعد

201
00:12:20,230 --> 00:12:21,240
حماية مقدّسة؟

202
00:12:21,560 --> 00:12:25,140
.تحمي القدّيسات النّاس

203
00:12:25,140 --> 00:12:28,190
إنّها تحميهم، سواء كان من الضّعف الّذي في قلوبهم

204
00:12:28,190 --> 00:12:29,920
.أو من الشّرّ الّذي في الخارج

205
00:12:29,920 --> 00:12:33,220
.وهناك قصص عنهنّ يحمين الآخرين من كوارث طبيعيّة

206
00:12:33,220 --> 00:12:36,040
كوارث؟ كيف؟

207
00:12:36,040 --> 00:12:37,610
.لا فكرة لديّ

208
00:12:37,610 --> 00:12:40,610
.تملك القدّيسات الإرادة لحماية بقيّتنا

209
00:12:40,610 --> 00:12:46,570
والمعجزات الّتي يأتين بها
.تُسمّى أحيانًا حمايتهنّ المقدّسة

210
00:12:46,570 --> 00:12:52,320
.ولأنّنا نحميهنّ يواصلن هنّ حمايتنا بدورهنّ

211
00:12:52,560 --> 00:12:54,200
هل تفهم يا لورنس؟

212
00:12:55,030 --> 00:13:00,590
.لا يجدر بك نسيان ذلك إذا ما قابلتَ قدّيسة

213
00:13:00,590 --> 00:13:04,570
.فقبل كلّ شيء، أنت مختلف قليلاً عن البقيّة

214
00:13:07,160 --> 00:13:10,150
،الملائكة والشّياطين، كما الجنّيّات

215
00:13:10,150 --> 00:13:13,520
.لا يمكن رؤيتها بالعين المجرّدة
.وهو عرضة لهجمات منها جميعها

216
00:13:13,780 --> 00:13:17,260
وحقيقة أنّه غير مدرك تمامًا لهذا
.هي المشكلة الأكبر

217
00:13:17,260 --> 00:13:22,770
إنّ جذب أشياء لا يمكنه رؤيتها
.سيثقل كاهله فحسب

218
00:13:22,770 --> 00:13:27,870
ليته يستطيع رؤيتها، سيكون هنالك
.طرق لحماية نفسه منها حينها

219
00:13:27,870 --> 00:13:32,910
،إن طلب أيّ أحد من القرية مساعدته
.فسيذهب إليه حتّى ليلاً

220
00:13:33,200 --> 00:13:36,670
حتّى إن وضعت زهور إبرة الرّاعي
...في غرفته لإبعاد الشّرّ عنه

221
00:13:36,830 --> 00:13:37,930
.إنّها جميلة

222
00:13:37,930 --> 00:13:40,410
سأتركها في مكان تستطيع
.حتّى القدّيسة رؤيتها فيه

223
00:13:40,800 --> 00:13:44,000
.وهكذا انتهى المطاف بها هناك

224
00:13:46,760 --> 00:13:48,780
،بما أنّك موجودة لحمايته يا سيّدتي سيسيليا

225
00:13:48,780 --> 00:13:50,380
فلا داعي للقلق، صحيح؟

226
00:13:50,380 --> 00:13:52,730
.ذلك ليس صحيحًا على الإطلاق

227
00:13:52,730 --> 00:13:56,930
كلّما كانت هنالك أمور تحمي
.لورن، زاد اطمئناني عليه

228
00:13:56,930 --> 00:14:00,460
رغم أنّ هذا المكان هو ملاذك
،المقدّس يا سيّدتي سيسيليا

229
00:14:00,460 --> 00:14:03,370
إلاّ أنّك أضفت حمايتك المقدّسة
فوق ذلك، صحيح؟

230
00:14:04,300 --> 00:14:10,650
سمعت أنّ منح الكثير من ذلك النّوع من
...القوّة لشخص ما قد يكون مؤذيًا

231
00:14:10,650 --> 00:14:12,780
!أنا جدّ آسفة

232
00:14:12,780 --> 00:14:14,160
إنّها تركع؟

233
00:14:14,160 --> 00:14:17,130
.تسبّبت بالألم لرون بينما كنت أريد حمايته

234
00:14:17,130 --> 00:14:18,810
!أنا فاشلة كقدّيسة

235
00:14:18,810 --> 00:14:20,170
.على رسلك

236
00:14:20,170 --> 00:14:23,560
،ليته كانت لديّ قوّة أكثر من هذه

237
00:14:23,560 --> 00:14:26,880
.لكنتُ قادرة على توسيع منطقة الحماية أكثر

238
00:14:26,880 --> 00:14:29,610
أتمنّى لم أستطيع جهل المنطقة كلّها

239
00:14:29,610 --> 00:14:31,980
.حيث يعيش لورن أرضًا مقدّسة

240
00:14:31,980 --> 00:14:33,900
.حماية مبالغ فيها

241
00:14:33,900 --> 00:14:37,900
إنّه يبالغ في الحماية أيضًا، لكن يبدو
.أنّهما متساويان بشكل متطابق

242
00:14:38,640 --> 00:14:41,920
لم تناقشي أيًّا من هذا مع لورنس، صحيح؟

243
00:14:41,920 --> 00:14:42,940
.لا

244
00:14:42,940 --> 00:14:47,160
.فأدراك مدى تفرّدك أمر مخيف

245
00:14:47,160 --> 00:14:50,200
،لم أكلّمه عن ذلك أيضًا
.لذلك لا داعي لتلومي نفسك

246
00:14:50,500 --> 00:14:53,600
بالتّفكير في الأمر، هناك شيء ما
في الكنيسة أيضًا، صحيح؟

247
00:14:53,600 --> 00:14:54,460
.نعم

248
00:14:54,460 --> 00:14:58,280
.هناك أربعة ملائكة والعديد من الجنّيّات

249
00:14:58,280 --> 00:15:01,270
ستتدهور صحّته ثانية إن تعلّقت به، صحيح؟

250
00:15:01,270 --> 00:15:02,280
.نعم

251
00:15:02,280 --> 00:15:06,080
،تنجذب الملائكة إلى لورن

252
00:15:06,080 --> 00:15:08,680
.لذلك تجدني أتنافس معها أحيانًا

253
00:15:08,680 --> 00:15:10,300
.لا بدّ أنّها معركة حامية

254
00:15:10,300 --> 00:15:13,490
إذًا فسبب قدومك للزّيارة

255
00:15:13,490 --> 00:15:16,320
هو الحرص أنّ لورن بخير، صحيح؟

256
00:15:16,320 --> 00:15:17,720
.هذا صحيح

257
00:15:17,720 --> 00:15:22,160
تساءلتُ عن حالته بما أنّه لم
.يكتب لي عن صحّته في رسائله

258
00:15:22,160 --> 00:15:23,830
هل كتب أيّ شيء عنّي؟

259
00:15:23,830 --> 00:15:25,350
.لم يكتب عنك

260
00:15:25,350 --> 00:15:26,150
ماذا؟

261
00:15:26,150 --> 00:15:29,190
.كتب عن شخص يعيش معه بالتّحديد

262
00:15:29,190 --> 00:15:31,300
،كتب عن تأخّره في الاستيقاظ صباحًا

263
00:15:31,300 --> 00:15:34,260
.وعن تكاسله وجعله يقوم بأشياء كثيرة

264
00:15:34,260 --> 00:15:35,920
!لورن

265
00:15:36,840 --> 00:15:38,320
...لكن

266
00:15:39,280 --> 00:15:44,320
لكنّه قال أنّ كلّ يوم كان مختلفًا
.بسبب ذلك الشّخص وأنّه مستمتع بوقته

267
00:15:46,930 --> 00:15:50,240
لم أكن قلقًا كثيرًا لأنّه كتب عن أمور كهذه

268
00:15:50,240 --> 00:15:52,630
.ويبدو أنّ ما كان يقلقني لم يكن هناك داعٍ لها

269
00:15:52,630 --> 00:15:54,630
،فبدل غبيّ مثلي

270
00:15:54,630 --> 00:15:57,340
.لديه أنت يا سيّدتي القدّيسة سيسيليا

271
00:15:57,340 --> 00:15:59,720
.سيكون لورنس في أمان

272
00:15:59,720 --> 00:16:02,060
.ليس عليك قول أشياء كهذه

273
00:16:02,950 --> 00:16:04,500
سيّدتي سيسيليا؟

274
00:16:04,770 --> 00:16:10,190
،طبيعة لورن غير عاديّة
.لذلك يصعب التّعامل معها جيّدًا

275
00:16:10,190 --> 00:16:14,980
ومع ذلك، تمكُّن شخص عاديّ
...من النّجاح في ذلك الأمر

276
00:16:14,980 --> 00:16:18,700
.لتطلّب ذلك منه الكثير من الجهد والموهبة

277
00:16:19,130 --> 00:16:23,720
،لو لم تكن تقف إلى جانبه
.ما كان لورن ليتواجد هنا

278
00:16:25,010 --> 00:16:28,630
.أبيل، أنت شخص مذهل

279
00:16:30,440 --> 00:16:34,640
،حتّى إن كنت شنيعًا وتصرّفاتك غير منطقيّة

280
00:16:34,640 --> 00:16:37,320
.وتتّصف بالتّعجرف بسرعة

281
00:16:37,320 --> 00:16:40,810
،يبدو كلامك وكأنّه مجاملة
.لكنّك تهاجميني بشدّة لا غير، صحيح؟

282
00:16:40,810 --> 00:16:42,430
!لم تكن تلك غايتي

283
00:16:42,430 --> 00:16:46,300
!لم أكن أتكلّم بالسّوء عنك
...كنتُ أقول ما أفكّر به فحسب

284
00:16:44,330 --> 00:16:48,510
.سيّدتي سيسيليا قدّيسة حقيقيّة

285
00:16:48,920 --> 00:16:51,560
!على أيّ حال، ذلك ليس عدلاً يا أبيل

286
00:16:51,560 --> 00:16:54,530
!أريد رؤية لورن في أيّام دراسته أيضًا

287
00:16:54,530 --> 00:16:56,790
.لديّ صور إن أردت رؤيتها

288
00:16:56,790 --> 00:16:58,330
.سأحضرها في المرّة القادمة

289
00:16:58,330 --> 00:17:01,080
!فعلا؟ أحضرها بكلّ تأكيد

290
00:17:01,400 --> 00:17:06,590
.تبدو مثل فتاة مغرمة بلورنس بالنّظر إليها هكذا

291
00:17:09,750 --> 00:17:12,590
هل يمكنك الطّبخ يا سيّدتي سيسيليا؟

292
00:17:12,590 --> 00:17:13,800
.لا

293
00:17:19,800 --> 00:17:22,320
سيّدتي القدّيسة؟ أبيل؟

294
00:17:25,710 --> 00:17:28,950
.ظننّا أنّ بإمكاننا طبخ شيء ما بدلاً منك يا لورن

295
00:17:28,950 --> 00:17:30,480
أنت سيّدتي القدّيسة؟

296
00:17:30,710 --> 00:17:35,320
.تعلّمت بسبب هذا ثانية كم أنّك مهمّ في حياتي

297
00:17:35,920 --> 00:17:37,060
.تفضّل

298
00:17:37,690 --> 00:17:40,030
!أبيل

299
00:17:40,030 --> 00:17:43,690
!هـ-هذا... لـ-لا يصلح حتّى للنّظر إليه

300
00:17:43,690 --> 00:17:46,040
.هكذا تكون محاولات الآخرين الأولى

301
00:17:46,580 --> 00:17:48,300
.سأتناوله بامتنان

302
00:17:57,420 --> 00:17:59,860
!ماذا؟ إنّه لذيذ

303
00:17:59,860 --> 00:18:02,020
فـ-فعلاً؟

304
00:18:09,760 --> 00:18:11,600
!هذا خطير يا أبيل

305
00:18:11,600 --> 00:18:13,520
هل أنت بخير يا سيّدتي القدّيسة؟

306
00:18:15,510 --> 00:18:18,030
.أ-أنا بخير

307
00:18:18,030 --> 00:18:20,280
!دعيني أطمئنّ من باب الحيطة

308
00:18:20,280 --> 00:18:22,410
!أ-أنا بخير بالفعل

309
00:18:22,410 --> 00:18:24,790
ماذا إن جُرحت شفتك؟

310
00:18:24,790 --> 00:18:26,860
!لـ-لم تُجرح

311
00:18:26,860 --> 00:18:29,880
!أخبرتك أنّها لم تُجرح

312
00:18:27,190 --> 00:18:29,880
.يبدو أنّه يعذّب السّيّدة سيسيليا

313
00:18:29,880 --> 00:18:32,320
!سـ-سأذهب لتغيير ملابسي

314
00:18:34,480 --> 00:18:36,240
.حسنًا يا أبيل

315
00:18:37,010 --> 00:18:40,130
ما سبب مجيئك الفعليّ إلى هنا؟

316
00:18:41,030 --> 00:18:44,380
إنت قلق بشأني، صحيح؟

317
00:18:44,380 --> 00:18:46,100
.لا داعي للقلق

318
00:18:46,100 --> 00:18:50,140
.لن أخبر أيًّا من النّبلاء الخبيثين عن السّيّدة سيسيليا

319
00:18:50,490 --> 00:18:52,960
.ولا أنوي القيام بأيّ شيء متهوّر لكشف أمرها

320
00:18:52,960 --> 00:18:55,400
فقبل كلّ شيء، تأثير القدّيسة

321
00:18:55,400 --> 00:18:57,400
أعظم بكثير ممّا نظنّ، صحيح؟

322
00:18:58,920 --> 00:19:01,660
.معك حقّ. أنا آسف

323
00:19:01,970 --> 00:19:04,360
،ربّما السّبب هو شدّة صداعي اليوم

324
00:19:04,360 --> 00:19:06,200
.لا يمكنني أن أسترخي لسبب ما

325
00:19:06,750 --> 00:19:08,340
...أخبرني يا أبيل

326
00:19:08,340 --> 00:19:10,230
،عندما أشعر بتوعّك في مثل هذه الأيّام

327
00:19:10,230 --> 00:19:13,910
.أشفى بسرعة عندما تظلّ القدّيسة قربي

328
00:19:13,910 --> 00:19:16,080
،عندما أفكّر في الأمر

329
00:19:16,440 --> 00:19:20,220
أشعر وكأنّ نفس الشّيء حدث عندما
.قضيت الوقت معك في المدرسة

330
00:19:20,220 --> 00:19:23,120
هل تربطك أيّ علامة مع القدّسية؟

331
00:19:23,490 --> 00:19:25,550
.لا، مجرّد مصادفة لا غير

332
00:19:25,550 --> 00:19:27,460
فعلاً؟

333
00:19:27,460 --> 00:19:30,220
كنت لأشعر بالسّوء إن جعلتكما
.تقومان بأمور من أجلي

334
00:19:30,690 --> 00:19:34,160
إذًا فلا يعطي الأولويّة لصحّته؟

335
00:19:34,160 --> 00:19:38,040
ليس ممكنًا لي امتلاك القوّة
لحماية النّاس، صحيح؟

336
00:19:38,040 --> 00:19:39,890
.وإليك سؤالاً أكثر أهمّيّة

337
00:19:39,890 --> 00:19:42,390
ما رأيك في السّيّدة سيسيليا؟

338
00:19:42,390 --> 00:19:43,360
ماذا؟

339
00:19:43,360 --> 00:19:46,830
.رأيي... أنا أحترمها

340
00:19:46,830 --> 00:19:48,560
.إنّها لا تحبّ الصّباح

341
00:19:48,560 --> 00:19:51,220
.كما أنّها تتكاسل عندما لا يوجد أحد في الجوار

342
00:19:51,220 --> 00:19:54,710
.يتغيّر مزاجها بشكل متردّد من سيّئ إلى حسن

343
00:19:54,710 --> 00:19:58,120
لكن هنالك جزء منها يحاول
.جاهدًا كما فعلت اليوم

344
00:19:58,120 --> 00:20:00,880
.إنّها شخص طيّب يعمل من أجل الآخرين

345
00:20:00,880 --> 00:20:03,080
.أنا أحترم وأثق بها

346
00:20:03,080 --> 00:20:04,470
هذا طبيعيّ، أليس كذلك؟

347
00:20:06,480 --> 00:20:07,980
.فهمت

348
00:20:10,230 --> 00:20:11,380
لورن؟

349
00:20:11,380 --> 00:20:12,990
هل من خطب ما؟

350
00:20:12,990 --> 00:20:15,720
.هناك زائر بثمانية أرجل في غرفتي

351
00:20:15,720 --> 00:20:18,900
.عنكبوت؟ سأذهب لطرده

352
00:20:18,900 --> 00:20:22,240
.وأثناء ذلك، نظّف المطبخ يا أبيل

353
00:20:22,240 --> 00:20:23,320
ماذا؟

354
00:20:23,320 --> 00:20:27,880
!لنسرع يا لورن
!قد يختبئ في مكان ما إن تأخّرنا

355
00:20:27,880 --> 00:20:31,680
،كلمة "احترام" في حقّ القدّيسة

356
00:20:31,680 --> 00:20:33,910
.لا يوفيها حقّها

357
00:20:34,230 --> 00:20:36,340
،أنا أحترمها بالفعل

358
00:20:36,660 --> 00:20:39,280
.لكنّ ذلك لا يلخّص كلّ شيء

359
00:20:40,030 --> 00:20:41,840
...منذ أن قابلتها

360
00:20:47,000 --> 00:20:49,670
.كانت دائمًا السّيّدة القدّيسة في نظري

361
00:20:51,400 --> 00:20:53,600
!لـ-لورن

362
00:20:53,600 --> 00:20:55,800
!وجدته! هذا هو

363
00:20:55,800 --> 00:20:58,360
.نعم. سأطارده

364
00:21:00,150 --> 00:21:02,300
.صار كلّ شيء بخير الآن

365
00:21:02,790 --> 00:21:06,280
.شكرًا لك... على هذا وعلى طبخك لي

366
00:21:06,760 --> 00:21:08,530
...يبدو أنّني

367
00:21:09,380 --> 00:21:12,880
.لا يمكنني العيش بدونك يا لورن

368
00:21:18,840 --> 00:21:23,040
،عندما تصف الأمر هكذا
.يبدو وكأنّها بحاجتي

369
00:21:23,640 --> 00:21:27,070
...ولكن بفضل القدّيسة، فإنّ كلّ يوم

370
00:21:28,400 --> 00:21:33,800
.ولأنّنا نحميهنّ يواصلن هنّ حمايتنا بدورهنّ

371
00:21:34,310 --> 00:21:37,420
إذًا فإنّك تقترف مثل هذه الأخطاء أيضًا يا لورن؟

372
00:21:37,420 --> 00:21:39,040
.مثلي تمامًا

373
00:21:40,210 --> 00:21:44,070
جدّي، هل هذا ما كنت تحاول إخباري به؟

374
00:21:45,400 --> 00:21:47,950
...هذا ما نصحتني أنّه لا يجدر بي نسيانه

375
00:21:48,430 --> 00:21:52,500
.لقد قابلتُ قدّيسة أريد حمايتها

376
00:23:25,860 --> 00:23:27,520
.التّنظيف

377
00:23:29,690 --> 00:23:30,350
.يا ويحي

378
00:23:32,070 --> 00:23:32,880
.يا ويحي

379
00:23:36,400 --> 00:23:39,210
الأعمال المنزليّة صعبة، صحيح؟