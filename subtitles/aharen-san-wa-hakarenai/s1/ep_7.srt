1
00:00:04,280 --> 00:00:06,760
أجاهزة للأكل يا أهارن-سان؟

2
00:00:12,890 --> 00:00:15,030
...أهارن-سان، أيُعقل

3
00:00:15,430 --> 00:00:16,990
أنّك نسيت غداءك؟

4
00:00:21,730 --> 00:00:23,710
!هل أنت بخير يا أهارن-سان؟

5
00:00:24,490 --> 00:00:27,260
...أعددته بالفعل، لكنّي تركته في المنزل

6
00:00:27,260 --> 00:00:29,170
.هذا مؤسف

7
00:00:30,770 --> 00:00:34,300
.سأذهب إلى متجر المدرسة. انتظرني

8
00:00:35,170 --> 00:00:36,420
متجر المدرسة؟

9
00:00:36,840 --> 00:00:38,650
!لا تفعلي يا أهارن-سان

10
00:00:38,650 --> 00:00:40,060
...متجر المدرسة

11
00:00:40,550 --> 00:00:42,500
!أشبه بوكر للوحشيّة

12
00:00:42,500 --> 00:00:45,770
إنّه مكان يتّصف بالفوضى الخالصة حيث
!يتسارع الكلّ لأخذ كلّ لقمة بجنون

13
00:00:46,050 --> 00:00:48,930
!لا يوجد ما هو أخطر من زيارته

14
00:00:49,900 --> 00:00:53,670
!لن أسمح لأهارن-سان بمواجهة ذلك وحدها

15
00:02:25,960 --> 00:02:27,210
!أحتاج كرة أرزّ يا سيّدتي

16
00:02:27,210 --> 00:02:28,280
!أريد علبة غداء الياكينيكو

17
00:02:27,660 --> 00:02:29,290
!دجاج مقليّ

18
00:02:28,280 --> 00:02:29,290
!خبز، خبز، خبز

19
00:02:30,650 --> 00:02:32,710
...إنّه مزدحم كما توقّعت

20
00:02:33,230 --> 00:02:34,600
.سأذهب

21
00:02:34,600 --> 00:02:36,560
ماذا؟ أأنت واثقة؟

22
00:02:39,440 --> 00:02:42,390
...ربّما تستطيع أهارن-سان رؤيته بطريقة ما

23
00:02:42,910 --> 00:02:47,270
،طريق لامع متوفّر لها وحدها
،نظرًا لجسدها الصّغير

24
00:02:47,270 --> 00:02:48,850
!بين كلّ أولئك النّاس

25
00:02:51,150 --> 00:02:53,400
أأنت بخير يا أهارن-سان؟

26
00:02:53,400 --> 00:02:55,270
.عرفت أنّها فكرة سيّئة

27
00:02:55,760 --> 00:02:57,980
.لننتظر حتّى يخفّ الازدحام

28
00:02:58,460 --> 00:03:01,740
...علب الغداء... ستُباع كلّها

29
00:03:01,740 --> 00:03:05,560
صحيح أنّ علب الغداء لديهم ستباع
،كلّها على هذا المعدّل

30
00:03:05,560 --> 00:03:07,270
.ولن يبقى سوى الخبز

31
00:03:07,270 --> 00:03:10,450
.تحتاج أهارن-سان للأرزّ كغذاء

32
00:03:11,340 --> 00:03:15,460
وهنالك طريقة واحدة فقط
.لتستطيع للتّخلّص من هذه الحشود

33
00:03:15,860 --> 00:03:17,000
...أهارن-سان

34
00:03:17,820 --> 00:03:18,820
.لنذهب

35
00:03:23,450 --> 00:03:24,850
أتمسكين بي جيّدًا؟

36
00:03:25,580 --> 00:03:26,710
.حسنًا، لنذهب

37
00:03:27,770 --> 00:03:30,110
.المعذرة. دعونا نمرّ رجاءً

38
00:03:30,610 --> 00:03:34,060
.حسنًا. هيّا يا أهارن-سان، اطلبي ما تريدين

39
00:03:34,730 --> 00:03:36,220
!يا سيّدتي، أريد هذه

40
00:03:36,220 --> 00:03:37,340
!أريد خبزًا

41
00:03:37,340 --> 00:03:38,720
!أريد علبة غداء طحالب رجاءً

42
00:03:39,480 --> 00:03:41,450
لا يستطيع أحد سماعها تطلب؟

43
00:03:41,730 --> 00:03:44,780
.ما باليد حيلة. لنتراجع ونعد التّفكير

44
00:03:43,340 --> 00:03:45,030
!أريد لفائف ياكيسوبا

45
00:03:45,030 --> 00:03:46,630
!أريد شطيرة لحم رجاءً

46
00:03:52,240 --> 00:03:53,960
!لقد دُفعت

47
00:03:54,290 --> 00:03:55,290
!أهارن-سان

48
00:03:57,380 --> 00:03:58,690
...أهذه

49
00:03:58,690 --> 00:03:59,840
!أيُعقل؟

50
00:04:00,310 --> 00:04:01,750
!إنّها تتزحلق على الحشود

51
00:04:01,750 --> 00:04:04,410
تمامًا كما يحدث في الحفلات
!الموسيقيّة مع الجماهير

52
00:04:05,800 --> 00:04:07,510
حسنًا، بماذا أخدمك؟

53
00:04:11,480 --> 00:04:13,060
...أهارن-سان

54
00:04:15,100 --> 00:04:16,310
!أمسكتك

55
00:04:16,680 --> 00:04:18,940
هل أنت بخير؟ هل حصلت على شيء؟

56
00:04:18,940 --> 00:04:21,420
.بيعت كلّ علب الغداء

57
00:04:21,420 --> 00:04:24,070
.كلّ ما حصلت عليه هو خبز الشّمّام

58
00:04:24,070 --> 00:04:26,750
.فهمت. هذا مؤسف

59
00:04:26,750 --> 00:04:28,030
هل سيكون كافيًا لك؟

60
00:04:28,740 --> 00:04:30,480
...سأكون بخير

61
00:04:30,940 --> 00:04:33,290
.لا تبدين بخير لي على الإطلاق

62
00:04:33,290 --> 00:04:34,320
!شيرورين

63
00:04:34,320 --> 00:04:36,330
.ما باليد حيلة يا أهارن-سان

64
00:04:36,330 --> 00:04:37,390
.تفضّلي

65
00:04:37,940 --> 00:04:39,040
ماذا؟

66
00:04:39,370 --> 00:04:42,510
.إنّها مقايضة. غدائي مقابل خبز الشّمّام

67
00:04:42,510 --> 00:04:46,050
.لن يكون لديك ما يكفي لتأكل هكذا

68
00:04:46,050 --> 00:04:49,220
.لا بأس. لستُ جائعًا جدًّا

69
00:04:49,220 --> 00:04:55,190
.كما أنّك تشاركينني غداءك دائمًا
.اعتبريني أردّ لك الجميل

70
00:04:55,500 --> 00:04:57,030
.سأقدّر لك هذا

71
00:04:59,260 --> 00:05:00,550
.شكرًا لك

72
00:05:01,190 --> 00:05:02,810
.لنتبادل إذًا

73
00:05:04,150 --> 00:05:05,910
.حسنًا، لنتّجه إلى السّطح

74
00:05:07,680 --> 00:05:10,080
...لنأخذ طريقًا مختصرًا عبر الممر

75
00:05:14,030 --> 00:05:15,790
!مستحيل! كيف؟

76
00:05:16,160 --> 00:05:19,750
لماذا الوحش من منزل
!أهارن-سان هنا في المدرسة؟

77
00:05:22,870 --> 00:05:25,970
.لقد أوصل غدائي

78
00:05:25,970 --> 00:05:28,930
.فـ-فعلاً؟ هذا جيّد

79
00:05:31,430 --> 00:05:34,930
.شكرًا لك يا يون. عد للمنزل الآن

80
00:05:35,900 --> 00:05:38,080
.ذلك الكلب ذكيّ جدًّا

81
00:05:40,080 --> 00:05:47,300
،حصلت على غدائي الآن
لكن ألا تمانع إن لم نتبادل؟

82
00:05:47,300 --> 00:05:48,910
.بالطّبع لا أمانع

83
00:05:53,280 --> 00:05:55,120
.شكرًا على الطّعام

84
00:05:56,140 --> 00:05:57,710
...أعرف أنّي تأخّرت في قول هذا

85
00:05:58,450 --> 00:06:02,470
.لكنّ علب غداء أهارن-سان كبيرة بالفعل

86
00:06:06,310 --> 00:06:08,300
.أكلت حتّى التّخمة

87
00:06:09,020 --> 00:06:10,190
.مرحبًا يا رايدو

88
00:06:10,190 --> 00:06:11,330
إيشيكاوا؟

89
00:06:11,330 --> 00:06:14,140
ما الخطب؟ أتؤلمك معدتك؟

90
00:06:14,140 --> 00:06:15,390
.لا، ليس تمامًا

91
00:06:15,780 --> 00:06:17,390
.ما زال هنالك وقت قبل الفصل

92
00:06:17,390 --> 00:06:18,770
أتريد الانضمام لنا؟

93
00:06:20,980 --> 00:06:24,110
.أحضرت ساتو-سان أوراق لعب معها

94
00:06:24,110 --> 00:06:26,700
.اللّعب بها ممتع أكثر مع لاعبين أكثر

95
00:06:27,220 --> 00:06:29,150
.حسنًا، لنلعب لعبة الخادمة العجوز

96
00:06:29,150 --> 00:06:30,760
!لا بأس

97
00:06:30,760 --> 00:06:32,020
.سأوزّع الأوراق إذًا

98
00:06:32,020 --> 00:06:33,410
.شكرًا لك

99
00:06:35,650 --> 00:06:39,460
آسف يا رفاق، لكنّي واثق تمامًا
.من مهاراتي في لعب هذه اللّعبة

100
00:06:40,270 --> 00:06:43,940
،قد تبدو كلعبة حظّ أو مفاوضات في البداية

101
00:06:43,940 --> 00:06:46,460
.لكن هنالك استراتيجيّة مؤكّدة للفوز

102
00:06:46,850 --> 00:06:48,470
...وقبل كلّ شيء

103
00:06:48,840 --> 00:06:53,600
أنتم جميعًا تحت تأثيري حتّى
!قبل أن أبدأ توزيع الأوراق

104
00:06:54,560 --> 00:06:59,500
يُقال أنّه إن بقي معك عدد زوجيّ
،من الأوراق في النّهاية

105
00:06:59,500 --> 00:07:02,440
.فاحتمالات الفوز بجولة تتضاعف في هذه اللّعبة

106
00:07:02,850 --> 00:07:06,330
والسّبب هو إنّك إن حصلت
،على عدد زوجيّ من الأوراق

107
00:07:06,330 --> 00:07:08,780
.فلديك فرصتين لإنشاء ثنائيّ

108
00:07:09,240 --> 00:07:13,500
.بينما بعدد فرديّ، فلديك فرصة واحدة

109
00:07:10,740 --> 00:07:14,030
ورقة واحدة فقط
لإنشاء ثنائيّ

110
00:07:14,530 --> 00:07:16,380
،سيحصل ثلاثة منّا على 13 ورقة

111
00:07:16,380 --> 00:07:18,080
.والرّابع على 14 ورقة

112
00:07:18,080 --> 00:07:22,120
،بما أنّ البدء بعدد أقل أفضل
.فسأحرص على الحصول على 13

113
00:07:22,800 --> 00:07:24,760
!المفتاح الأوّل للفوز

114
00:07:24,760 --> 00:07:26,090
...سأقترح بشكل عرضيّ

115
00:07:26,370 --> 00:07:28,670
،حسنًا، بما أنّني وزّعتُ الأوراق

116
00:07:28,670 --> 00:07:31,740
فلماذا لا تقومين بالسّحب منّي
أوّلا يا ساتو-سان؟

117
00:07:33,420 --> 00:07:36,580
سأطلب من شخص آخر السّحب أوّلاً
.لأضمن أنّ لديّ عددًا زوجيًّا من الأوراق

118
00:07:37,340 --> 00:07:38,940
.جيّد! نجح الأمر تمامًا

119
00:07:39,510 --> 00:07:42,300
!الكرة في ملعبي الآن. لنبدأ اللّعبة

120
00:07:44,980 --> 00:07:46,870
.ما عادت لي أوراق

121
00:07:46,870 --> 00:07:48,290
!مذهل

122
00:07:48,290 --> 00:07:49,780
بهذه السّرعة؟

123
00:07:52,020 --> 00:07:54,410
الخادمة العجوز لعبة حظّ؟

124
00:07:55,320 --> 00:07:56,650
!ما عادت لي أوراق

125
00:07:56,650 --> 00:07:57,660
!وأنا أيضًا

126
00:08:00,000 --> 00:08:03,710
...ومع ذلك، هنالك أكثر من طريقة للفوز

127
00:08:03,710 --> 00:08:05,550
.حسنًا، لنبدأ بالجولة الثّانية

128
00:08:05,550 --> 00:08:07,670
.لا يمكن الاعتماد على الحظّ

129
00:08:07,670 --> 00:08:09,470
!مفتاح الفوز الثّاني

130
00:08:10,120 --> 00:08:13,970
.سأسحب الورقة الّتي اختارتها أهارن-سان

131
00:08:14,260 --> 00:08:17,300
،إن لم تنشئ ثنائيًّا بها

132
00:08:17,810 --> 00:08:20,390
.فلا بدّ أنّها ستكون كذلك بالنّسبة لي أو لساتو-سان

133
00:08:21,090 --> 00:08:22,680
!حسنًا

134
00:08:31,470 --> 00:08:32,800
حصلت على الخادمة العجوز؟

135
00:08:33,390 --> 00:08:36,200
تنجح أهارن-سان دائمًا في عدم
،إظهار ما تشعر به على وجهها

136
00:08:36,540 --> 00:08:39,410
.لكن في أوقات كهذه، من السّهل قراءتها

137
00:08:39,830 --> 00:08:43,810
...لنتفادى الطُّعم الواضح وأختار ورقة أخرى

138
00:08:44,830 --> 00:08:47,280
.مهلاً! فكّر في الأمر مليًّا

139
00:08:47,790 --> 00:08:50,780
.تفوز أهارن-سان بشكل دائم في مواجهتي

140
00:08:51,710 --> 00:08:54,930
،قد يكون هذا فخًّا من فخاخها
!وتوقّعت حركتي التّالية

141
00:08:55,870 --> 00:08:57,640
.كان ذلك وشيكًا

142
00:08:58,850 --> 00:09:01,520
!لكنّني أسبقك بخطوة

143
00:09:06,950 --> 00:09:09,130
.تمكّنتْ من توقّع ما توقّعتُه

144
00:09:09,130 --> 00:09:12,650
.لكنّ امتلاك الخادمة العجوز الآن في صالحي

145
00:09:12,650 --> 00:09:14,690
!مفتاح الفوز الثّالث

146
00:09:15,510 --> 00:09:19,270
سأحتفظ بالخادمة العجوز بينما
،ما زال للجميع الكثير من الأوراق

147
00:09:19,270 --> 00:09:23,280
ثمّ سأسلّمها للآخرين في النّصف الأخير
.من اللّعبة بينما الأوراق أقلّ عددًا

148
00:09:20,790 --> 00:09:21,720
!هذه

149
00:09:23,280 --> 00:09:26,840
بتلك الطّريقة، ستبقى في يدَيْ
.اللاّعبين الآخرين

150
00:09:26,840 --> 00:09:29,370
،بينما تدور بينهم وصولاً إليّ

151
00:09:29,370 --> 00:09:31,920
.مؤمّنة لي فترة مطوّلة من الأمان

152
00:09:31,920 --> 00:09:35,130
.بالإمكان التّحكّم بالأوراق الّتي يختارون الآخرون أيضًا

153
00:09:35,130 --> 00:09:36,980
يميل النّاس إلى الاختيار

154
00:09:36,980 --> 00:09:40,680
من الجانب المعاكس ليدهم
.المهيمنة في لحظات توتّرهم

155
00:09:38,880 --> 00:09:40,680
أيّها أختار...؟

156
00:09:41,180 --> 00:09:42,310
ربّما هذه؟

157
00:09:41,810 --> 00:09:44,120
جيّد. سأحتفظ بها حتّى وقت متأخّر من اللّعبة

158
00:09:44,120 --> 00:09:45,850
.قبل أن أرسلها لتدور بينهم

159
00:09:55,290 --> 00:09:56,670
!جيّد! هذا هو الوقت المناسب

160
00:09:56,670 --> 00:09:58,360
!انطلق أيّها الجوكر

161
00:10:03,830 --> 00:10:06,060
.أجل! ما عادت لي أوراق

162
00:10:08,040 --> 00:10:09,790
!ولا أنا

163
00:10:10,560 --> 00:10:13,500
!عليّ شكر الآلهة على هذه الفرصة

164
00:10:13,930 --> 00:10:19,220
هذا هو نزال واحد ضدّ واحد
!المثاليّ ضدّ أهارن-سان

165
00:10:19,220 --> 00:10:22,380
!مفتاح النّصر الرّابع: الملاحظة

166
00:10:22,380 --> 00:10:26,390
.يقال أنّه لا وجود لمؤشّر نفسيّ أكثر من العيون

167
00:10:35,150 --> 00:10:36,110
!ها هي ذي

168
00:10:36,110 --> 00:10:37,040
!هذه

169
00:10:38,930 --> 00:10:40,030
.نجحت

170
00:10:40,630 --> 00:10:41,690
!فزت

171
00:10:50,970 --> 00:10:53,100
!فازت أهارن-سان

172
00:10:53,100 --> 00:10:54,540
!تهانينا

173
00:10:55,160 --> 00:10:57,950
...أهارن-سان... أنا

174
00:10:59,070 --> 00:11:02,530
!لا أدري إن كان بإمكاني أن أثق بك ثانية

175
00:11:03,560 --> 00:11:07,600
...كيف وقع هذا؟ رأيتك تشيحين نظرك

176
00:11:08,410 --> 00:11:11,670
...شعرت بالحرج لأنّك كنت تحدّق بي

177
00:11:12,310 --> 00:11:16,150
.ماذا؟ هذا ما هنالك؟ أنا آسف

178
00:11:23,900 --> 00:11:26,230
...لم أستطع هزيمة أهارن-سان ثانية

179
00:11:28,310 --> 00:11:30,820
!كلّ ذلك وهي عازمة على الاقتراب منّي أكثر

180
00:11:34,370 --> 00:11:35,970
،وبسبب هذا

181
00:11:35,970 --> 00:11:38,590
.هذه هي النّتيجة النّهائيّة

182
00:11:38,590 --> 00:11:43,220
،ستكون هذه الصّيغة في الامتحان
.لذلك احرصوا على تدوينها

183
00:11:40,870 --> 00:11:43,220
.هذا وضع نوم فخم

184
00:11:44,550 --> 00:11:46,680
.حسنًا، هذا كلّ شيء لهذا اليوم

185
00:11:46,680 --> 00:11:49,190
فصلنا التّالي في قسم آخر، صحيح؟

186
00:11:49,190 --> 00:11:50,140
.نعم

187
00:11:52,860 --> 00:11:55,860
.أهارن-سان، علينا الذّهاب لقسم آخر

188
00:12:00,090 --> 00:12:01,040
أأنت مستيقظة؟

189
00:12:02,800 --> 00:12:05,700
.فصل العلوم هو التّالي
.لنستعدّ ونذهب إليه

190
00:12:12,330 --> 00:12:14,620
.أهارن-سان لا تتحرّك

191
00:12:14,620 --> 00:12:16,420
لكن لماذا؟

192
00:12:16,420 --> 00:12:19,880
.لكنّي أفهم يا أهارن-سان

193
00:12:20,360 --> 00:12:21,890
.هذه سنّ حسّاسة

194
00:12:21,890 --> 00:12:23,920
يشعر الأطفال في المرحلة الإعداديّة والثّانويّة

195
00:12:23,920 --> 00:12:27,350
بالرّغبة في التّغيّب عن الفصول
.أحيانًا بدون سبب محدّد

196
00:12:27,350 --> 00:12:32,320
.وها هي أهارن-سان تعترض بصمت
لا تتحرّك. لا تتفوّه بكلمة

197
00:12:32,320 --> 00:12:33,810
.صمتها أصخب من أيّ كلام

198
00:12:34,220 --> 00:12:36,750
...إنّها لا تندفع نحو الدّمار أو إساءة التّصرّف

199
00:12:36,750 --> 00:12:38,810
.إنّها قويّة وفخورة جدًّا

200
00:12:39,850 --> 00:12:41,070
...كنتُ

201
00:12:42,130 --> 00:12:44,850
...كنتُ نائمة في نفس الوضع لوقت طويل

202
00:12:45,490 --> 00:12:47,700
.والآن صار جسدي خدرًا ولا يمكنني التّحرّك

203
00:12:51,140 --> 00:12:53,830
.نعم، هذا منطقيّ. عرفتُ ذلك

204
00:12:54,360 --> 00:12:56,000
.تشعرين بالخدر فحسب

205
00:12:56,450 --> 00:12:57,950
ما العمل حيال هذا؟

206
00:12:58,620 --> 00:12:59,750
!حسنًا

207
00:13:02,160 --> 00:13:04,190
.لنتّجه إلى مختبر العلوم هكذا

208
00:13:04,690 --> 00:13:06,280
.شكرًا لك

209
00:13:06,280 --> 00:13:07,480
!شيرورين

210
00:13:09,210 --> 00:13:11,670
كيف حالك الآن؟ أيمكنك الشّعور بجسديك ثانية؟

211
00:13:11,670 --> 00:13:13,060
.نعم

212
00:13:13,060 --> 00:13:16,340
.جيّد. تولّينا ذلك الأمر

213
00:13:17,370 --> 00:13:19,480
.حسنًا، هذه نهاية الفصل

214
00:13:20,810 --> 00:13:22,630
...لنذهب يا أهارن-سان

215
00:13:24,290 --> 00:13:26,600
.أهارن-سان، انتهى الفصل

216
00:13:29,530 --> 00:13:31,410
.جسدي خدر ثانية

217
00:13:31,840 --> 00:13:33,500
.نعم، ذلك منطقيّ

218
00:13:34,030 --> 00:13:36,750
،إن واصلت الغطّ في النّوم

219
00:13:37,080 --> 00:13:40,490
!قد لا تتمكّن أبدًا من مغادرة المدرسة

220
00:13:41,460 --> 00:13:46,930
اهدأ! أنت تتسرّع دائمًا في الوصول
!إلى تفسيرات مبالغ فيها

221
00:13:47,380 --> 00:13:50,390
لكن عليّ توقّع مختلف السّيناريوهات

222
00:13:50,390 --> 00:13:53,300
وإلاّ فلن أعرف ما العمل
.إن حدث شيء غير متوقّع

223
00:13:53,300 --> 00:13:54,300
...ومع ذلك

224
00:13:54,830 --> 00:13:59,770
هل ساكون قادرًا على حملها
على ظهري لبقيّة حياتي بالفعل؟

225
00:14:03,610 --> 00:14:04,680
.أهارن-سان

226
00:14:05,440 --> 00:14:07,950
لماذا أنت متعبة جدًّا اليوم؟

227
00:14:13,340 --> 00:14:18,680
سهرت لوقت متأخّر أفكّر في أيّ نوع
.من الأطباق الجانبيّة تحبّ مع غدائك

228
00:14:19,620 --> 00:14:20,960
!من أجلي؟

229
00:14:21,500 --> 00:14:24,920
.لم تُنهي كلّ شيء البارحة

230
00:14:24,920 --> 00:14:27,360
.فهمتِ الأمر خطأ. كان طعامك لذيذًا

231
00:14:27,850 --> 00:14:30,710
.كان أكثر ممّا تستطيع معدتي تحمّله فحسب

232
00:14:31,360 --> 00:14:34,330
.لكنّني اتّخذت قراري يا أهارن-سان

233
00:14:34,910 --> 00:14:37,020
...أنا مستعدّ لحملك بقيّة حياتي على

234
00:14:37,960 --> 00:14:39,840
ماذا؟ تشعرين بتحسّن؟

235
00:14:40,720 --> 00:14:42,690
.حسنًا. هذا جيّد

236
00:14:46,340 --> 00:14:48,770
!غدًا هو يوم الرّحلة المدرسيّة أخيرًا

237
00:14:49,150 --> 00:14:54,490
سأطعم أكّون غداءً معدًّا في المنزل
!وسأستولي على معدته

238
00:14:55,660 --> 00:14:59,680
!قمت بتجربة اليوم، لذلك من الأفضل أن أختبرها

239
00:15:01,630 --> 00:15:05,090
آسفة، نسيت أنّ لدينا فصولاً
.لنصف يوم فقط

240
00:15:05,090 --> 00:15:06,090
.لا بأس

241
00:15:06,090 --> 00:15:08,690
.أعتقد أنّه من اللّطيف منك إعداد الغداء

242
00:15:08,690 --> 00:15:11,570
.ومن اللّطيف الأكل في الحديقة أحيانًا

243
00:15:11,570 --> 00:15:13,420
!لا أصدّق هذا

244
00:15:13,420 --> 00:15:18,480
أعدّت الغداء بنفسها لتنصب
!فخًّا لأكّون أيضًا

245
00:15:18,790 --> 00:15:20,190
!لن اسمح لها بذلك

246
00:15:20,740 --> 00:15:22,520
!أهارن رينا

247
00:15:22,520 --> 00:15:24,300
فوتابا-تشان؟

248
00:15:24,300 --> 00:15:26,730
!أنا أتحدّاك في نزال غداء

249
00:15:27,100 --> 00:15:28,530
.ربّما هذه فكرة سيّئة

250
00:15:29,800 --> 00:15:31,210
.حسنًا. أنا آسف

251
00:15:31,610 --> 00:15:34,930
أعددتِ غداءً لأكّون أيضًا، صحيح؟

252
00:15:35,450 --> 00:15:39,410
!حسنًا، طعامي أفضل من طعامك على أيّ حال

253
00:15:39,410 --> 00:15:41,990
مذهل، أعددت غداءً أيضًا؟

254
00:15:41,990 --> 00:15:43,880
!قومي بتجربته

255
00:15:52,300 --> 00:15:56,090
لإنّه مثير للاهتمام... لم أتذوّق لفائف
.بيض يكلّ هذه النّكهات من قبل

256
00:15:56,710 --> 00:16:00,810
...إنّها حلوة... مالحة... حامضة... مرّة

257
00:15:56,710 --> 00:16:00,810
!ما رأيك؟ أضفت إليها لمستي الخاصّة

258
00:16:01,250 --> 00:16:03,870
.سأجرّب طعامك الآن

259
00:16:03,870 --> 00:16:07,060
.مع أنّه مستحيل أن يكون لذيذًا كطعامي

260
00:16:10,830 --> 00:16:12,330
...هذا لذيذ

261
00:16:14,440 --> 00:16:18,660
.لـ-لكن يستطيع أيّ أحد إعداد لفائف البيض

262
00:16:18,660 --> 00:16:21,510
.لنجرّب كرات اللّحم هذه

263
00:16:22,180 --> 00:16:25,700
واضح أنّها معدّة في المنزل
...لأنّها ليست متجانسة

264
00:16:25,700 --> 00:16:27,640
...مستحيل أن تكون

265
00:16:30,230 --> 00:16:33,300
!إنّها لذيذة! هذا ما أفضّله تمامًا

266
00:16:33,740 --> 00:16:37,260
!أكره الاعتراف بهذا، لكنّها طبّاخة ماهرة

267
00:16:37,260 --> 00:16:42,670
مقارنة بطعامها، فإنّ مذاق غدائي
...غريب ولا يبدو مظهره جيّدًا

268
00:16:43,230 --> 00:16:46,690
.أ-أهارن رينا

269
00:16:46,690 --> 00:16:52,150
عفوًا، هل يمكنك... تعليمي الطّبخ رجاءً؟

270
00:16:53,580 --> 00:16:55,290
!كفّا عن التّصرف أنّكما متفاجئان هكذا

271
00:16:55,290 --> 00:16:59,280
أعرف متى أتصرّف بأدب عند
!طلب المساعدة، مفهوم؟

272
00:16:59,280 --> 00:17:04,500
أريد أن أكون قادرة على إعداد
...غداء مثلك، لذا

273
00:17:06,240 --> 00:17:07,430
!شيرورين

274
00:17:10,190 --> 00:17:13,120
من الجيّد أنّهم سمحوا لنا باستعمال
.قسم الاقتصاد المنزليّ

275
00:17:13,120 --> 00:17:15,540
.حتّى أنّهم سمحوا لنا باستعمال بقايا المكوّنات

276
00:17:16,380 --> 00:17:19,990
.حسنًا، لنغسل أيدينا ونبدأ بالطّبخ

277
00:17:19,990 --> 00:17:21,350
.حـ-حسنًا

278
00:17:23,310 --> 00:17:24,600
!اكتملت

279
00:17:25,270 --> 00:17:26,770
...أعددت ذلك بنفسي

280
00:17:32,890 --> 00:17:34,150
!إنّه لذيذ

281
00:17:34,150 --> 00:17:37,020
.أبليت حسنًا يا فوتابا-تشان

282
00:17:37,020 --> 00:17:39,870
.أنا واثقة أنّه سيحبّ هذا

283
00:17:41,020 --> 00:17:44,790
!أ-أعلم ذلك! لا داعي لتقولي لي ذلك

284
00:17:45,910 --> 00:17:47,580
...أهارن رينا

285
00:17:47,580 --> 00:17:50,150
...ما فعلتِ اليوم

286
00:17:50,150 --> 00:17:52,360
...أ-أنت حقًّا

287
00:17:53,550 --> 00:17:57,070
!أنت حقًّا غبيّة جدًّا! خدعتك تمامًا

288
00:17:57,780 --> 00:18:00,720
!صرتُ الآن طبّاخة أفضل منك

289
00:18:00,720 --> 00:18:03,840
ما مدى سذاجتك لتقعي ضحيّة خدعة عدوّتك؟

290
00:18:03,840 --> 00:18:05,470
!إلى اللّقاء

291
00:18:08,010 --> 00:18:09,650
.إنّها فتاة صعبة المراس

292
00:18:13,030 --> 00:18:15,680
...لم أشكرها ثانية

293
00:18:26,170 --> 00:18:28,100
.اختاروا الموضوع الّذي تحبّونه

294
00:18:28,100 --> 00:18:30,040
.آخر أجل هو نهاية الأسبوع القادم

295
00:18:30,040 --> 00:18:32,830
لكم حرّيّة استعمال أيّ أدوات
.أو موادّ في قسم الفنون

296
00:18:32,830 --> 00:18:33,840
.حسنًا

297
00:18:33,840 --> 00:18:36,830
امتلاك كلّ تلك الحرّيّة يجعل أخر
...القرار أصعب بشكل غريب

298
00:18:36,830 --> 00:18:38,320
.أعلم ما تعنيه

299
00:18:39,410 --> 00:18:41,210
ألا يمكنك التّقرير أيضًا يا أهارن-سان؟

300
00:18:42,210 --> 00:18:44,140
.لنفكّر إذًا في شيء ما معًا

301
00:18:44,470 --> 00:18:46,810
ربّما نقوم برسمة لمنظر طبيعيّ؟

302
00:18:46,810 --> 00:18:48,680
...منظر طبيعيّ

303
00:18:48,680 --> 00:18:51,250
.هذا شائع. قد تكون فكرة جيّدة

304
00:18:54,430 --> 00:18:55,890
مفتاح النّجاح هم منحا عمقًا

305
00:18:55,890 --> 00:18:58,360
.وإنشاء حسّ صحيح للمقاييس بين الأشياء

306
00:18:59,400 --> 00:19:01,660
رسم المناظر الطّبيعيّة صعب؟

307
00:19:01,990 --> 00:19:04,120
!ما الّذي تفعلانه؟

308
00:19:04,550 --> 00:19:06,080
.فوتابا-تشان

309
00:19:06,080 --> 00:19:07,950
كيف كان الغداء؟

310
00:19:07,950 --> 00:19:10,870
!لم يُجدي أيّ نفع

311
00:19:10,870 --> 00:19:12,580
!أهارن رينا

312
00:19:12,880 --> 00:19:15,750
...كيف تجرئين... كيف تجرئين

313
00:19:15,750 --> 00:19:18,550
!كيف تجرئين على تسميم ذلك الغداء؟

314
00:19:20,190 --> 00:19:21,010
تسميم؟

315
00:19:21,010 --> 00:19:24,170
!مرضت معدة أكّون بعد تناوله

316
00:19:25,320 --> 00:19:30,050
مهلاً، هل أخذت الغداء الّذي أعددناه ذلك اليوم؟

317
00:19:30,560 --> 00:19:32,490
أ-أتلك مشكلة؟

318
00:19:32,490 --> 00:19:33,660
!مشكلة كبيرة

319
00:19:33,660 --> 00:19:36,710
.عليك إعداد غداء طازج في الصّباح وإلاّ فسيفسد

320
00:19:40,020 --> 00:19:42,860
.أعتقد أنّ الرّسمات الشّخصيّة تناسبنا أكثر

321
00:19:42,860 --> 00:19:46,450
الخطوة الأولى المهمّة هي ملاحظة
.موضوع الرّسم بشكل جيّد

322
00:19:52,250 --> 00:19:53,190
...عفوًا

323
00:19:53,810 --> 00:19:56,910
أعتقد أنّ طريقة الملاحظة هذه
.قد تكون مبالغًا فيها قليلاً

324
00:19:57,740 --> 00:20:00,120
.ستكونين موضوع الرّسم لي يا أهارن-سان

325
00:20:04,660 --> 00:20:07,970
.عفوًا، لا يجب عليك التّحرّك كثيرًا

326
00:20:07,970 --> 00:20:10,460
...أشعر بالحرج إذا ما نظرت لي

327
00:20:10,460 --> 00:20:13,560
.فهمت. آسف. لنجرّب شيئًا آخر

328
00:20:15,620 --> 00:20:18,790
الطّين هو أحد أكثر الوسائط
.الأساسيّة لإنشاء فنون ثلاثيّة الأبعاد

329
00:20:18,790 --> 00:20:21,070
.الأمر المهمّ هو إنشاء حسّ للحجم

330
00:20:22,240 --> 00:20:24,340
...ربّما أستطيع صنع تمثال لأختي

331
00:20:24,950 --> 00:20:26,700
.حسنًا. انتهيت

332
00:20:29,370 --> 00:20:31,660
.من الصّعب استعمال الطّين

333
00:20:32,250 --> 00:20:33,620
ماذا عنك يا أهارن-سان؟

334
00:20:36,080 --> 00:20:38,810
كم سيتطلّب إنهاء ذلك من الوقت؟

335
00:20:38,810 --> 00:20:40,550
.حوالي شهرين

336
00:20:40,900 --> 00:20:42,840
.ستتجاوز المهلة المحدّدة

337
00:20:48,200 --> 00:20:50,610
.القيام برسمة شخصيّة كان أفضل خيار

338
00:20:50,610 --> 00:20:54,470
آخر أجل لتقديمها هو اليوم، لكنّ
أهارن-سان منفردة بنفسها في ورشتها

339
00:20:54,470 --> 00:20:55,770
...ولم تخرج أبدًا

340
00:20:57,870 --> 00:21:00,570
كيف تسير الأمور يا أهارن-سان؟
هل انتهيت؟

341
00:21:01,160 --> 00:21:04,640
لا أرى أيّ شيء... ماذا صنعت يا أهارن-سان؟

342
00:21:06,100 --> 00:21:07,530
أهارن-سان؟

343
00:21:08,220 --> 00:21:09,490
هل أنت بخير؟

344
00:21:14,570 --> 00:21:15,960
!أهارن-سان؟

345
00:21:15,960 --> 00:21:17,880
هـ-هل نمت؟

346
00:21:18,810 --> 00:21:20,350
...اعذريني

347
00:21:20,350 --> 00:21:23,510
!إنّها لا تتنفّس! قلبها لا ينبض

348
00:21:24,750 --> 00:21:27,050
!هل قتلتُها؟

349
00:21:28,170 --> 00:21:29,190
!حافظ على هدوئك

350
00:21:29,190 --> 00:21:32,520
في أوقات كهذه، أفضل خيار هو القيام
!بإسعافات أوّليّة بعد طلب المساعدة

351
00:21:32,520 --> 00:21:33,890
!ليساعدني أحد ما

352
00:21:35,530 --> 00:21:36,510
ماذا هنالك؟

353
00:21:39,530 --> 00:21:41,650
!نادي معلّمًا! احضري جهاز إنعاش

354
00:21:41,650 --> 00:21:43,420
...اتّصلي بالطّوارئ

355
00:21:45,820 --> 00:21:48,680
ماذا؟! هنالك اثنان من أهارن-سان؟

356
00:21:48,680 --> 00:21:50,820
صحيح، هذه؟

357
00:21:51,530 --> 00:21:54,130
.إنّها دمية صنعتها بنفسي

358
00:21:55,000 --> 00:21:58,020
صنعت دمية بنفس حجمها؟

359
00:21:59,220 --> 00:22:00,990
!إنّها واقعيّة للغاية

360
00:23:35,250 --> 00:23:37,400
أنا سعيدة لأنّك حصلت
.على علامة جيّدة مقابل هذه

361
00:23:38,760 --> 00:23:40,550
.إنّها مثيرة للإعجاب بالفعل

362
00:23:41,560 --> 00:23:43,810
.يمكنك أخذها إن أعجبتك لهذه الدّرجة

363
00:23:43,810 --> 00:23:46,120
.مستحيل أن أقبل بهذا

364
00:23:46,120 --> 00:23:48,530
.ليس بعد أن صنعتِها بنفسك

365
00:23:54,820 --> 00:23:56,240
لن أتمكّن من النّوم، صحيح؟