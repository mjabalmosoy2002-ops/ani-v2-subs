1
00:00:10,530 --> 00:00:16,940
تسمّى الفترة الزّمنيّة الّتي سبقت روايات
.التّاريخِ المكتوب عصورَ ما قبل التّاريخ

2
00:00:13,640 --> 00:00:16,940
...الفتاة الّتي تجلس بجواري، أهارن رينا-سان

3
00:00:18,530 --> 00:00:20,540
...وتُقدّر عصور ما قبل التّاريخ

4
00:00:20,540 --> 00:00:22,400
.تبدو بعيدة لسبب ما

5
00:01:58,520 --> 00:02:01,970
.تهانينا على التحاقكم بهذه المدرسة

6
00:02:02,310 --> 00:02:05,310
.أنا معلّمتكم الأساسيّة واسمي مياهيرا

7
00:02:05,970 --> 00:02:07,820
.أنا أدرّس التّربية الجسديّة

8
00:02:08,700 --> 00:02:10,500
.سررت بلقائكم

9
00:02:11,410 --> 00:02:15,030
والآن، لماذا لا تقدّمون أنفسكم جميعًا؟

10
00:02:15,890 --> 00:02:17,610
.اسمي رايدو

11
00:02:17,610 --> 00:02:19,490
.سررت بلقائكم

12
00:02:20,480 --> 00:02:23,060
...كنت في غاية التّوتّر وبالكاد استطعت الكلام

13
00:02:24,290 --> 00:02:27,290
.ستكون المدرسة الثّانويّة مختلفة

14
00:02:28,980 --> 00:02:33,970
لم أنسجم مع البقيّة في المدرسة
.الإعداديّة بسبب مظهري غير الودود

15
00:02:35,770 --> 00:02:38,310
.لكنّ ذلك انتهى الآن

16
00:02:35,770 --> 00:02:38,310
.التّالي

17
00:02:38,310 --> 00:02:42,400
.الخطوة الأولى هي التّعرّف على من يجلس بجواري

18
00:02:42,400 --> 00:02:45,500
...أوّلاً، عليّ لمعرفة اسمها

19
00:02:51,370 --> 00:02:54,280
هل فوّتُّ لحظة تقديمها لنفسها؟

20
00:02:56,700 --> 00:02:58,020
!جيّد

21
00:02:58,020 --> 00:03:00,200
.صباح الخير يا أهارن-سان

22
00:03:05,800 --> 00:03:08,140
.أتمنّى أن نصير رفيقَيْ جلوس جيّدين

23
00:03:13,610 --> 00:03:15,860
رفضت عرضي؟

24
00:03:17,300 --> 00:03:20,510
.فهمت. لا بدّ أنّها خائفة من مظهري

25
00:03:20,510 --> 00:03:23,760
.تدرّبت على هذا... ابتسم. ابتسم

26
00:03:24,690 --> 00:03:26,580
.ابتسم! جيّد

27
00:03:27,640 --> 00:03:30,020
الطّقس جميل هذا اليوم، صحيح يا أهارن-سان؟

28
00:03:33,760 --> 00:03:34,920
لا فائدة؟

29
00:03:35,840 --> 00:03:37,920
.لكن لا يمكنني الاستسلام

30
00:03:37,920 --> 00:03:44,190
حياتي كتلميذ مدرسة ثانويّة
.تعتمد على هذه الخطوة الأولى

31
00:03:46,810 --> 00:03:48,620
الحرم المدرسيّ كبير جدًّا، صحيح؟

32
00:03:48,620 --> 00:03:50,700
.يفترض أنّ الخبز في متجر المدرسة جيّد جدًّا

33
00:03:50,700 --> 00:03:53,000
ألديك فكرة عن النّوادي الّتي ستنضمّين لها؟
أليس الاختيار بينها صعبًا؟

34
00:03:56,170 --> 00:03:58,840
.ولا إجابة واحدة حتّى الآن

35
00:03:59,680 --> 00:04:01,450
!لن أسمح لهذا بالتّأثير عليّ

36
00:04:01,970 --> 00:04:05,050
سأتخلّى عن الحصول على حياة
...مبهجة في المدرسة الثّانويّة

37
00:04:05,680 --> 00:04:08,690
.أريدها أن تكلّمني فحسب. ولو لمرّة

38
00:04:14,760 --> 00:04:17,400
...لم تنطق بكلمة واحدة

39
00:04:18,340 --> 00:04:20,140
.من الأفضل أن أعود للمنزل

40
00:04:22,780 --> 00:04:24,610
.مع السّلامة يا أهارن-سان

41
00:04:26,190 --> 00:04:27,730
.ألقاكِ غدًا

42
00:04:34,680 --> 00:04:36,260
...لا بدّ أنّني كنت أتخيّل

43
00:04:44,200 --> 00:04:48,180
.إنّها تبدو بعيدة بالفعل
...وكأنّها ليس قربي على الإطلاق

44
00:04:49,120 --> 00:04:50,740
.رغم أنّها تجلس بجواري

45
00:04:52,330 --> 00:04:55,280
.إنّها صغيرة البنية أيضًا

46
00:04:55,280 --> 00:04:58,490
.ربّما يعبث ذلك بإدراكي العميق

47
00:05:10,530 --> 00:05:13,170
ألا.... أروق لها فحسب؟

48
00:05:14,360 --> 00:05:16,290
.تفضّلي. أوقعتِ هذه

49
00:05:19,340 --> 00:05:21,960
.ما زال الصّمت ردّها الوحيد

50
00:05:25,590 --> 00:05:27,550
.حسنًا، هذا كلّ شيء لهذا اليوم

51
00:05:27,550 --> 00:05:29,510
.لا تنسوا واجباتكم المنزليّة

52
00:05:28,400 --> 00:05:30,620
...الفصل التّالي هو

53
00:05:32,770 --> 00:05:34,240
ما-ماذا هنالك؟

54
00:05:36,990 --> 00:05:38,470
أتحتاجين لشيء ما؟

55
00:05:41,220 --> 00:05:43,280
هل تقولين شيئًا...؟

56
00:05:44,420 --> 00:05:45,740
!إنّها تتكلّم بالفعل

57
00:05:46,120 --> 00:05:48,450
،إنّها تقف أمام وجهي مباشرة
!لكن ما زالت تبدو بعيدة

58
00:05:49,720 --> 00:05:50,950
...هل يُعقل

59
00:05:51,760 --> 00:05:53,000
...ربّما حينها

60
00:05:54,060 --> 00:05:55,620
هل قالت شيئًا ما بالفعل؟

61
00:05:58,770 --> 00:06:00,500
لكن أليس هذا قريبًا جدًّا؟

62
00:06:01,990 --> 00:06:04,260
ماذا؟ نسيتِ كتابك؟

63
00:06:04,840 --> 00:06:09,030
يسمى التّعبير الّذي يتكوّن من عدّة
.حدود بمتعدّد الحدود

64
00:06:09,030 --> 00:06:12,100
والأحاديّات الّتي تكوّن متعدّد
.الحدود تسمّى حدوده

65
00:06:12,100 --> 00:06:14,380
ما الّذي يدور في بالها؟

66
00:06:14,380 --> 00:06:15,720
.حسنًا، لا بأس

67
00:06:16,910 --> 00:06:21,260
.يا لصغر وجهها ويديها. إنّها تشبه دمية

68
00:06:25,000 --> 00:06:27,190
ولكن أليس هذا قريبًا جدًّا؟

69
00:06:27,190 --> 00:06:29,330
ماذا؟ هل تحتاجين لشيء آخر؟

70
00:06:32,400 --> 00:06:35,770
.أعتقد أنّها تريد تناول الغداء معًا

71
00:06:35,770 --> 00:06:37,660
!وما زالت قريبة

72
00:06:39,120 --> 00:06:41,000
أليست علبة الغداء هذه كبيرة؟

73
00:06:43,990 --> 00:06:46,570
.يـ-يبدو غداؤك جيّدًا

74
00:06:49,500 --> 00:06:51,380
هل تُطعمني؟

75
00:06:51,380 --> 00:06:52,970
...لا داعي لذلك

76
00:06:53,710 --> 00:06:56,750
.حسنًا، سأجرّبه، لذا توقّفي

77
00:07:01,510 --> 00:07:03,230
.أكلتْ كلّ شيء

78
00:07:03,230 --> 00:07:05,460
.لديها شهيّة أكبر ممّا تخيّلت

79
00:07:11,500 --> 00:07:13,460
.أعتقد أنّنا سنذهب للمنزل معًا أيضًا

80
00:07:19,370 --> 00:07:23,330
ألعاب وبولينغ

81
00:07:20,090 --> 00:07:22,810
تريدين الدّخول إلى هناك؟

82
00:07:23,330 --> 00:07:25,630
نظام التّصوير الجميل

83
00:07:26,450 --> 00:07:27,920
أرادت استعمال كشك التّصوير؟

84
00:07:29,150 --> 00:07:30,520
ماذا الآن؟

85
00:07:34,560 --> 00:07:35,890
كارايوكي؟

86
00:07:37,360 --> 00:07:39,890
لا يلتقط الميكروفون صوتها؟

87
00:07:42,260 --> 00:07:44,810
.أتساءل لماذا صارت ودودة فجأة

88
00:07:54,440 --> 00:07:56,490
.صباح الخير يا أهارن-سان

89
00:08:08,460 --> 00:08:11,460
.ومع ذلك، لا أحصل على جواب عندما أحيّيها

90
00:08:11,460 --> 00:08:13,330
.يصعب معرفة ما يدوره في ذهنها بالفعل

91
00:08:13,940 --> 00:08:15,200
!شيرورين

92
00:08:15,200 --> 00:08:17,930
أكانت تتصرّف بغرابة البارحة فحسب؟

93
00:08:18,490 --> 00:08:20,290
.لا بأس بذلك أيضًا

94
00:08:21,240 --> 00:08:23,320
.ستعود الأمور لمجراها الطّبيعيّ فحسب

95
00:08:25,500 --> 00:08:26,810
...ولكن

96
00:08:34,620 --> 00:08:37,570
،إن كنتِ نسيتِ كتابك
فهل تريدين مشاركة كتابي؟

97
00:08:40,930 --> 00:08:44,330
...ولكنّي... لا أريد إزعاجك

98
00:08:44,330 --> 00:08:46,730
.لا بأس. لا يزعجني هذا

99
00:08:47,330 --> 00:08:48,570
...أنا

100
00:08:49,770 --> 00:08:53,310
...لم أُجد يومًا التّعامل مع الآخرين

101
00:08:54,050 --> 00:08:57,260
.لا أعرف إلى أيّ حدّ عليّ الاقتراب منهم

102
00:08:59,360 --> 00:09:05,210
أصير ودودة للغاية عندما يتصرّف
،الآخرون بلطف طفيف معي

103
00:09:05,210 --> 00:09:10,530
...ولا يروق لهم ذلك
.لذلك يضعون مسافة بينهم وبيني

104
00:09:11,540 --> 00:09:16,000
أردتُ الكفّ عن التّصرّف كذلك
.بما أنّي في الثّانويّة الآن

105
00:09:16,590 --> 00:09:18,740
...كنتُ أحاول أن أكون حذرة، ولكن

106
00:09:19,340 --> 00:09:27,950
التقطتَ ممحاتي البارحة وتكلّمتَ
...معي يا رايدو-كُن

107
00:09:29,220 --> 00:09:30,960
.وأسعدني ذلك كثيرًا

108
00:09:32,970 --> 00:09:37,520
،لكن عندما عدت للمنزل
.قلتُ لنفسي أنّني بالغتُ كثيرًا ثانية

109
00:09:38,280 --> 00:09:42,500
—أنا آسف. لن أكرّر ذلك ثا

110
00:09:42,500 --> 00:09:45,920
.لا أشغل بالي كثيرًا بمثل تلك الأمور

111
00:09:45,920 --> 00:09:49,100
.وما دمتِ لن تبالغي كثيرًا، فلا أمانع

112
00:09:58,980 --> 00:10:00,320
.شكرًا لك

113
00:10:01,990 --> 00:10:06,830
.حـ-حسنًا، لكن هلاّ تركتني؟ سيبدأ الدّرس

114
00:10:07,990 --> 00:10:08,910
.نعم

115
00:10:09,330 --> 00:10:11,680
...حسنًا، إن قلبتم الصّفحة

116
00:10:11,680 --> 00:10:15,670
،لدينا الجزء المسجّل من الماضي
،أو ما يسمّى بالتّاريخ

117
00:10:13,110 --> 00:10:14,660
.لم تتركني

118
00:10:15,670 --> 00:10:17,560
،ثمّ هناك عصور ما قبل التّاريخ
.وهي ما يسبق هذه السّجلاّت

119
00:10:17,560 --> 00:10:21,820
...كم يصعب فهم أهارن-سان

120
00:10:23,480 --> 00:10:25,070
.بطرق شتّى

121
00:10:34,400 --> 00:10:36,300
أهارن-سان؟

122
00:10:36,300 --> 00:10:38,230
ما-ما الخطب؟

123
00:10:40,360 --> 00:10:43,270
هل كنتِ تنادينني ولم أسمعك؟

124
00:10:43,270 --> 00:10:44,410
.آسف

125
00:10:45,620 --> 00:10:47,200
ما كان ذلك؟

126
00:10:48,080 --> 00:10:53,650
صوت أهارن-سان خافت للغاية
...ويفوتني ما تقول، وهذا صعب

127
00:10:53,650 --> 00:10:55,790
هل هنالك حلّ لهذه المسألة؟

128
00:10:59,770 --> 00:11:01,910
...تعلّم طريقة تفسير حركات الفم

129
00:11:01,910 --> 00:11:03,100
.قراءة الشّفاه

130
00:11:03,850 --> 00:11:08,310
إن استطعتُ إتقان هذا، سأتمكّن من
.الحديث معها مهما كان صوتها خافتًا

131
00:11:08,860 --> 00:11:12,900
.وأيضًا... أحتاج للتّدرّب على ذلك معك يا أختي

132
00:11:12,900 --> 00:11:15,090
.ماذا؟ هذا مزعج

133
00:11:15,090 --> 00:11:16,230
.حسنًا، لنبدأ

134
00:11:16,230 --> 00:11:18,380
!أنت غبيّ يا أخي

135
00:11:18,380 --> 00:11:20,200
أنت غنيّ يا جدّي؟

136
00:11:20,200 --> 00:11:22,960
.حبّار، أخطبوط، مجسّات. يا لك من فاشل

137
00:11:22,960 --> 00:11:26,270
غبار مربوط محلاّت... بالك شاغل؟

138
00:11:26,620 --> 00:11:28,500
.صباح الخير

139
00:11:32,080 --> 00:11:35,990
.حسنًا، لقد أتقنت قراءة الشّفاه

140
00:11:35,990 --> 00:11:37,560
.حاولي قول شيء ما

141
00:11:50,370 --> 00:11:53,400
.بالكاد تتحرّك شفتاها

142
00:11:57,100 --> 00:11:59,400
...لا بدّ من طريقة أخرى

143
00:12:06,890 --> 00:12:07,940
!هذه هي

144
00:12:10,200 --> 00:12:12,420
،عندما تحتاجين للكلام معي

145
00:12:12,420 --> 00:12:15,510
.اكتبي ملاحظة على قصاصة ورق وارمها لي

146
00:12:21,480 --> 00:12:24,650
.حسنًا، هذا جيّد. واصلي يا أهارن-سان

147
00:12:34,560 --> 00:12:37,440
أتدرين ماذا يا أهارن-سان؟
.لنتوقّف هنا

148
00:12:40,880 --> 00:12:41,900
...مهلاً

149
00:12:42,590 --> 00:12:46,780
.عندما أمسكتْ بي، استطعتُ سماعها بوضوح

150
00:12:46,780 --> 00:12:48,220
هل لأنّها كانت قريبة جدًّا؟

151
00:12:49,020 --> 00:12:49,870
!لا

152
00:12:50,420 --> 00:12:52,030
ماذا إن كان توصيلاً عظميًّا؟

153
00:12:53,210 --> 00:12:56,280
!فهمت يا أهارن-سان. إنّه توصيل عظميّ

154
00:12:56,280 --> 00:12:57,790
.لنجرّب ذلك لاحقًا

155
00:12:59,140 --> 00:13:00,610
!شيرورين

156
00:13:01,730 --> 00:13:03,220
—صباح الخير يا أها

157
00:13:03,680 --> 00:13:04,930
—نسيت

158
00:13:05,430 --> 00:13:06,720
—الغدا

159
00:13:08,320 --> 00:13:12,430
،لا فائدة. تسبّب لي هذا بصفير أذن
.إنّه لا يساعدني على الاستماع

160
00:13:14,010 --> 00:13:16,660
!لكنّني لن أستسلم يا أهارن-سان

161
00:13:20,360 --> 00:13:22,490
.عليّ تجربة خيارات أخرى

162
00:13:24,510 --> 00:13:25,650
.أنا مغادر

163
00:13:25,650 --> 00:13:27,190
!أخي؟

164
00:13:27,610 --> 00:13:33,080
بدايات التّخاطر
الذّهنيّ

165
00:13:28,210 --> 00:13:31,180
ماذا هنالك؟ ستأخذ كلّ هذا للمدرسة؟

166
00:13:34,280 --> 00:13:35,530
.تخاطر ذهنيّ

167
00:13:36,260 --> 00:13:37,480
.الحمام الزّاجل

168
00:13:38,410 --> 00:13:39,850
.شيفرة مورس

169
00:13:40,670 --> 00:13:41,900
.إشارات الأيدي

170
00:13:42,930 --> 00:13:44,170
.رسائل بالسّهام

171
00:13:45,170 --> 00:13:46,290
.إشارات دخانيّة

172
00:13:49,540 --> 00:13:51,600
.نفدت منّي الأفكار

173
00:13:54,600 --> 00:13:56,040
.أنا آسفة

174
00:13:57,000 --> 00:14:01,180
.جرّبتَ أشياء عدّة من أجلي. شكرًا لك

175
00:14:01,180 --> 00:14:06,240
.لكن يبدو أنّ لا شيء ينفع... أنا آسفة

176
00:14:06,240 --> 00:14:08,700
.لا، أنا من عليه الاعتذار

177
00:14:09,140 --> 00:14:12,870
.يبدو أنّك تريدين الحديث معي كثيرًا يا أهارن-سان

178
00:14:13,500 --> 00:14:17,860
.وأشعر بالسّوء لعجزي عن سماعك كلّ الوقت

179
00:14:19,770 --> 00:14:22,190
.لا، لا بأس

180
00:14:23,310 --> 00:14:24,730
.شكرًا لك

181
00:14:25,830 --> 00:14:28,680
.كما أعتذر عن جعلك تضغطين على نفسك

182
00:14:28,680 --> 00:14:29,680
أضغط على نفسي؟

183
00:14:29,680 --> 00:14:33,350
أقصد أنّك تتكلّمين بصوت أعلى
من المعتاد الآن، صحيح؟

184
00:14:33,350 --> 00:14:36,910
.ليس تمامًا. أتكلّم هكذا دائمًا

185
00:14:36,910 --> 00:14:39,320
.لا أتكلّم بصوت أعلى على الإطلاق

186
00:14:42,050 --> 00:14:44,770
.إ-إن كان هذا ما تظنّين

187
00:14:50,620 --> 00:14:53,700
.صار الذّهاب للمنزل معًا جزءًا من روتيننا

188
00:14:54,520 --> 00:14:58,640
لكن ما كان ذلك قبل قليل؟

189
00:14:58,640 --> 00:15:00,670
!عملة 10 ينّ وعملة 50 ينّ

190
00:15:01,340 --> 00:15:02,380
...على رسلك

191
00:15:02,380 --> 00:15:04,090
ما الّذي تفعله؟

192
00:15:04,090 --> 00:15:05,340
.يا إلهي

193
00:15:05,340 --> 00:15:08,210
هل صار سمعي أفضل؟

194
00:15:08,210 --> 00:15:09,440
.فهمت

195
00:15:09,440 --> 00:15:15,220
جعلني التّحدّث مع أهارن-سان
...حسّاسًا لأخفض الأصوات

196
00:15:22,650 --> 00:15:24,610
هل من اللاّزم أن تتشبّث بها هكذا؟

197
00:15:25,320 --> 00:15:27,530
.ربّما تريد تلك الدّمى

198
00:15:28,460 --> 00:15:29,660
!حسنًا

199
00:15:29,660 --> 00:15:31,340
.سألتقط واحدة

200
00:15:58,670 --> 00:16:01,640
...ر-ربّما علينا الرّحيل يا أهارن-سان

201
00:16:02,130 --> 00:16:04,280
...لـ-لعبنا كثيرًا بالفعل، لذا

202
00:16:05,460 --> 00:16:06,660
أهارن-سان؟

203
00:16:08,410 --> 00:16:09,940
!تبدأ بـ500 ينّ؟

204
00:16:11,120 --> 00:16:12,650
.إنّها عازمة فعلاً على الحصول عليها

205
00:16:13,620 --> 00:16:16,870
...لكنّها لا تستطيع الرّؤية من الأعلى

206
00:16:21,500 --> 00:16:22,680
كرسيّ؟

207
00:16:24,380 --> 00:16:27,630
هل أهارن-سان زبونة منتظمة هنا؟

208
00:16:30,950 --> 00:16:34,440
.تتطلّب ألعاب الرّافعات وعيًا مكانيًّا دقيقًا

209
00:16:35,490 --> 00:16:38,370
أليس هذا صعبًا عليها بسبب مشاكلها
في الحكم على المسافات؟

210
00:16:40,850 --> 00:16:42,810
!من المحاولة الأولى

211
00:16:43,290 --> 00:16:45,560
.تهانينا. كان ذلك مذهلاً

212
00:16:45,980 --> 00:16:48,260
.أهارن-سان بارعة بهذا

213
00:16:48,810 --> 00:16:49,610
!مهلاً

214
00:16:50,970 --> 00:16:54,080
.كانت تقوم بذلك لقياس مكانها

215
00:16:54,990 --> 00:16:58,880
.حصلت على واحدة من أوّل محاولة
.بقي لديها رصيد إضافيّ

216
00:16:59,360 --> 00:17:01,200
...أتساءل أين ستذهب تاليًا

217
00:17:02,970 --> 00:17:04,510
نفس اللّعبة؟

218
00:17:20,370 --> 00:17:22,700
أليس هذا كثيرًا؟

219
00:17:22,700 --> 00:17:24,760
.وجميعها من نفس النّوع

220
00:17:25,140 --> 00:17:29,350
،بما أنّك حصلت على الكثير منها
لماذا لا نعود للمنزل يا أهارن-سان؟

221
00:17:36,420 --> 00:17:38,820
أما زالت تريد المزيد؟

222
00:17:38,820 --> 00:17:40,990
هل تحاول الحصول على كلّ جائزة هنا؟

223
00:17:40,990 --> 00:17:42,360
!كم هذا مرعب

224
00:17:43,640 --> 00:17:44,950
من أجلي؟

225
00:17:44,950 --> 00:17:47,710
.بدوتَ أنّك تريدها يا رايدو-كُن

226
00:17:48,140 --> 00:17:51,080
.إذًا فلم تكن تريدها من أجلها

227
00:17:52,650 --> 00:17:58,760
...كما أنّك فعلت الكثير من أجلي
.لذلك أردت أن أشكرك

228
00:18:00,060 --> 00:18:01,180
.شكرًا لك

229
00:18:02,860 --> 00:18:04,430
.لم أكن أتوقّعها جميعها

230
00:18:05,620 --> 00:18:08,160
.احتفظي بهذه إذًا يا أهارن-سان

231
00:18:10,790 --> 00:18:12,490
.كشكر على فوزك بها

232
00:18:15,290 --> 00:18:16,610
.شكرًا لك

233
00:18:19,210 --> 00:18:20,320
.لقد عدت

234
00:18:20,320 --> 00:18:21,950
.مرحبًا بك يا أخي

235
00:18:22,330 --> 00:18:25,220
بالمناسبة، ستغادر أمّي في رحلة
.عمل ابتداءً من الغد

236
00:18:25,220 --> 00:18:26,340
.مفهوم

237
00:18:27,630 --> 00:18:29,480
!من أين حصلت على هذه؟

238
00:18:29,480 --> 00:18:32,070
هل يمكنني أخذ واحدة
بما أنّ لديك الكثير منها؟

239
00:18:32,070 --> 00:18:33,220
.لا يمكنك

240
00:18:33,220 --> 00:18:34,750
.فهي هدايا قبل كلّ شيء

241
00:18:34,750 --> 00:18:36,050
ماذا؟

242
00:18:50,100 --> 00:18:54,440
هذا قريب جدًّا بالفعل، صحيح؟
.وكأنّها تقترب منّي أكثر فأكثر

243
00:18:55,240 --> 00:18:57,900
هل كنت تحملينها معك يا أهارن-سان؟

244
00:19:01,490 --> 00:19:10,920
خبز
البطّيخ

245
00:19:02,600 --> 00:19:03,970
أين غداؤك؟

246
00:19:03,970 --> 00:19:08,410
.أمّي في رحلة عمل
.لذا سأشتري غدائي في هذه الفترة

247
00:19:10,920 --> 00:19:12,610
.افتح فمك

248
00:19:12,610 --> 00:19:14,880
.لا، لا بأس

249
00:19:16,410 --> 00:19:21,030
.فهمت... رذلك قدّمي كلّ طبق على حدى رجاءً

250
00:19:32,030 --> 00:19:34,100
أيّ نوع من المخلوقات هذا؟

251
00:19:35,400 --> 00:19:37,400
.إنّها أهارن-سان

252
00:19:39,030 --> 00:19:41,710
هل أنت بخير؟ هل أنت متوعّكة؟

253
00:19:49,150 --> 00:19:51,330
مهلاً... أ-أهارن-سان؟

254
00:19:52,180 --> 00:19:55,200
...استيقظتُ باكرًا، لذلك أنا متعبة

255
00:19:56,480 --> 00:19:59,840
أهذا كلّ شيء؟ ظننتُ أنّها
.قد تكون مريضة أو ما شابه

256
00:20:02,800 --> 00:20:06,130
.هيّا. يوشك الدّرس أن يبدأ. استيقظي

257
00:20:06,130 --> 00:20:07,330
!شيرورين

258
00:20:10,740 --> 00:20:12,160
.ستكون بخير

259
00:20:17,040 --> 00:20:18,940
.أنا منبهر لأنّك بقيت مستيقظة

260
00:20:24,420 --> 00:20:26,470
!إنّها نائمة وعيناها مفتوحتان

261
00:20:28,800 --> 00:20:31,370
.أعتقد أنّ لا مفرّ من هذا

262
00:20:32,600 --> 00:20:35,300
.إنّها استراحة الغداء يا أهارن-سان

263
00:20:37,480 --> 00:20:39,130
...لا إجابة

264
00:20:39,130 --> 00:20:41,590
.أظنّني سأذهب لشراء بعض الخبز إذًا

265
00:20:51,820 --> 00:20:55,420
!مفهوم، مفهوم، لذلك كفّي عن التّشبّث بي

266
00:21:01,660 --> 00:21:02,790
ما هذا؟

267
00:21:05,350 --> 00:21:07,040
علبة غداء لي؟

268
00:21:08,130 --> 00:21:10,190
هل أعددتِها بنفسك؟

269
00:21:12,620 --> 00:21:15,400
...كنتُ آمل أن تعجبك

270
00:21:15,400 --> 00:21:18,780
.استيقظت باكرًا وعملتُ جاهدة عليها

271
00:21:18,780 --> 00:21:21,830
.لكنّني كنت متعبة جدًّا، وتسبّبت بالإزعاج ثانية

272
00:21:23,850 --> 00:21:25,320
.أنا آسفة

273
00:21:26,270 --> 00:21:27,140
.لا عليك

274
00:21:27,780 --> 00:21:30,300
.ذلك ليس بالأمر المهمّ

275
00:21:30,300 --> 00:21:33,640
.يمكنك الاتّكاء عليّ إن كنتِ متعبة

276
00:21:33,640 --> 00:21:36,350
.كان الغداء لذيذًا أيضًا. شكرًا لك

277
00:21:38,030 --> 00:21:39,920
...شـ-شكرًا لك

278
00:21:42,240 --> 00:21:46,400
...حسنًا... أظنّني سوف

279
00:21:46,400 --> 00:21:47,760
.حـ-حسنًا

280
00:21:52,090 --> 00:21:54,490
."أعتقد أنّ هذا يتجاوز "الاتّكاء

281
00:21:55,740 --> 00:22:00,050
.توقّع أهارن-سان مستحيل بالفعل

282
00:22:01,390 --> 00:22:06,280
.من الصّعب فهمها بالفعل... وبطرق شتّى

283
00:23:40,080 --> 00:23:43,510
...أهارن-سان... عفوًا

284
00:23:44,560 --> 00:23:48,150
.أظنّ أنّ عليك الاستيقاظ. سيبدأ الدّرس