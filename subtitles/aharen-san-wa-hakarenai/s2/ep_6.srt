1
00:00:12,410 --> 00:00:14,870
!لقد تأخّرت بما أنّه كان لديّ واجب فصل

2
00:00:14,870 --> 00:00:17,330
.أتساءل إن كان أكّون لا يزال في حديقة الألعاب

3
00:00:21,640 --> 00:00:23,210
!أمسكتك

4
00:00:23,210 --> 00:00:25,920
!من تلك الفتاة المنحرفة؟

5
00:00:25,920 --> 00:00:28,650
،استطعتُ أخيرًا هزيمة أهارن رينا

6
00:00:28,650 --> 00:00:31,080
لكن ظهرت فتاة ماكرة أخرى
!ووضعت براثنها حوله

7
00:00:31,390 --> 00:00:34,720
!اسمعي أيّتها المنحرفة
!ما الّذي تظنّين أنّك فاعلة؟

8
00:00:34,720 --> 00:00:35,940
!فوتابا

9
00:00:35,940 --> 00:00:38,680
.دعيني أقدّم إلى إيداتن-ساما

10
00:00:38,680 --> 00:00:39,970
إيداتن-ساما؟

11
00:00:39,970 --> 00:00:40,930
!إنّها سريعة جدًّا

12
00:00:40,930 --> 00:00:42,350
!إنّها مذهلة ورائعة

13
00:00:42,350 --> 00:00:44,590
—عندما لعبنا الشّرطة واللّصوص، قامت

14
00:00:43,710 --> 00:00:45,320
.اخرس يا أكّون

15
00:00:45,320 --> 00:00:49,400
!أسمعي أيّتها الشّوتاكون المنحرفة
!سنلعب أنا وأنت اللّصوص والشّرطة

16
00:00:49,660 --> 00:00:51,450
شوتا؟ منحرفة؟

17
00:00:51,450 --> 00:00:52,310
.اسمها الشّرطة واللّصوص

18
00:00:52,310 --> 00:00:53,740
.أخبرتك أن تخرس يا أكّون

19
00:00:53,740 --> 00:00:56,050
!حسنًا، هل تقبلين التّحدّي أم لا؟

20
00:00:56,050 --> 00:00:59,700
!أكيد. لكنّي سأمسك بك بسرعة

21
00:00:59,700 --> 00:01:01,310
!سنرى حيال ذلك

22
00:01:01,310 --> 00:01:02,580
...حسنًا

23
00:01:02,580 --> 00:01:05,540
!لنبدأ إذًا

24
00:01:12,760 --> 00:01:13,670
!فوتابا

25
00:01:17,640 --> 00:01:20,580
...أنت بارعة بالفعل

26
00:01:20,580 --> 00:01:22,350
.أنت أيضًا أيّتها المنحرفة

27
00:01:26,590 --> 00:01:30,150
.اسمي ريكو. تاماناها ريكو

28
00:01:35,200 --> 00:01:37,790
!أنا فوتابا. سررت بلقائك

29
00:01:37,790 --> 00:01:40,750
.نعم! وأنا أيضًا يا فوتابا-تشين

30
00:01:41,230 --> 00:01:43,830
!إنّهما أها-تشان والسّيّد حبيبها

31
00:01:43,830 --> 00:01:47,010
هل كنت تلعبين مع أكّون والبقيّة؟

32
00:01:47,010 --> 00:01:48,300
.أقدّر لك ذلك

33
00:01:49,040 --> 00:01:50,220
!الملك أها

34
00:01:50,220 --> 00:01:51,530
!لقد أتيت

35
00:01:51,530 --> 00:01:53,380
أتريدين لعب الشّرطة واللّصوص؟

36
00:01:53,380 --> 00:01:54,770
تعرفون بعضكم؟

37
00:01:55,880 --> 00:01:58,140
.تعالي والعبي معنا يا تاما-تشان

38
00:01:59,070 --> 00:02:00,170
!أكيد

39
00:02:00,640 --> 00:02:02,320
!اهربوا

40
00:02:05,940 --> 00:02:07,630
!أمسكتك يا أكّون

41
00:02:08,190 --> 00:02:11,450
!هذه المنحرفة عدوّتي بالفعل

42
00:03:44,730 --> 00:03:47,120
!أنا متأخّرة لأنّه كان دوري ثانية

43
00:03:47,120 --> 00:03:49,580
.أتساءل إن كان أكّون لا يزال هنا

44
00:03:53,550 --> 00:03:56,920
!هذه المرّة، لا مجال للشّكّ

45
00:03:57,260 --> 00:04:01,600
أهارن رينا... تقوم بالتّقرّب
!من أكّون أخيرًا

46
00:04:02,510 --> 00:04:04,970
!أهارن رينا

47
00:04:06,270 --> 00:04:09,550
...ماذا؟ أنت لست أهارن رينا

48
00:04:09,550 --> 00:04:12,860
هل تعرفين أختي رينا أيضًا؟

49
00:04:12,860 --> 00:04:15,570
...نـ-نعم، نوعًا ما

50
00:04:15,860 --> 00:04:20,000
ناديتها بأختي، فهل هي أختك بالفعل؟

51
00:04:20,000 --> 00:04:22,140
.نعم! هي كذلك

52
00:04:22,140 --> 00:04:25,100
.فوتابا، هذا هو الملك السّرّيّ أها

53
00:04:25,100 --> 00:04:26,790
الملك السّرّيّ أها"؟"

54
00:04:26,790 --> 00:04:29,700
!إنّه جانب منفصل للملك أها

55
00:04:29,700 --> 00:04:31,750
!وبالتّالي يعادلها في المرتبة

56
00:04:31,750 --> 00:04:34,730
!كما أنّه بارع في بطاقات الهوكي

57
00:04:34,730 --> 00:04:36,680
.أنا أقوم بمراجعة مجموعة بطاقاتي

58
00:04:36,680 --> 00:04:40,100
.فعلاً؟ شكرًا على ذلك

59
00:04:40,100 --> 00:04:42,470
اسمك فوتابا-تشان؟

60
00:04:43,030 --> 00:04:44,780
!تعالي والعبي معنا

61
00:04:46,130 --> 00:04:47,890
.أعتقد أنّي لا أمانع

62
00:04:47,890 --> 00:04:50,050
!فعلاً؟! مرحى

63
00:04:50,050 --> 00:04:52,150
!شكرًا يا فوتابا-تشان

64
00:04:52,150 --> 00:04:55,110
!يا لشدّة الإلحاح

65
00:04:55,490 --> 00:04:58,240
!لن أسمح بأن يتمّ إغوائي

66
00:04:58,240 --> 00:05:00,020
ما الّذي علينا أن نلعبه؟

67
00:05:01,110 --> 00:05:03,070
!مهلاً

68
00:05:03,070 --> 00:05:05,910
!لا أحد يستطيع الإمساك بي

69
00:05:06,790 --> 00:05:08,540
!أمسكتك

70
00:05:10,080 --> 00:05:11,130
...نعم

71
00:05:11,960 --> 00:05:15,050
.كم كان هذا ممتعًا

72
00:05:15,050 --> 00:05:16,910
.نـ-نعم

73
00:05:18,900 --> 00:05:21,630
!أختي رينا! أخي رايدو

74
00:05:21,630 --> 00:05:23,320
!الملك أها

75
00:05:23,320 --> 00:05:26,220
!كنت ألعب مع فوتابا-تشان وأكّون والبقيّة

76
00:05:27,950 --> 00:05:32,660
.شكرًا لأنّكم لعبتهم مع أخي الصّغير

77
00:05:32,660 --> 00:05:34,480
أ-أقلتِ أخي؟

78
00:05:34,480 --> 00:05:37,290
هل أنت ولد بالفعل؟

79
00:05:37,290 --> 00:05:39,070
.نعم، ذلك صحيح

80
00:05:39,070 --> 00:05:42,440
!هـ-هكذا إذًا

81
00:05:42,440 --> 00:05:44,530
!ما كان عليّ القلق حيال أكّون إذًا

82
00:05:44,530 --> 00:05:46,490
!شكرًا على اليوم

83
00:05:46,490 --> 00:05:47,950
!عناق

84
00:05:47,950 --> 00:05:49,960
!لنلعب ثانية في وقت لاحق

85
00:05:49,960 --> 00:05:52,210
.أ-أكيد، بالطّبع

86
00:05:53,780 --> 00:05:56,550
.إلى لقاء آخر يا أكّون

87
00:05:56,550 --> 00:05:58,420
...نـ-نعم

88
00:05:58,960 --> 00:06:00,450
...أهارن رن

89
00:06:00,960 --> 00:06:02,590
!نحن عدوّان بالفعل

90
00:06:05,080 --> 00:06:07,940
!إنّه جواد الملك

91
00:06:08,850 --> 00:06:10,470
!لم أرك منذ مدّة

92
00:06:10,470 --> 00:06:12,880
أجل، أجل، أجل! كيف حالك؟

93
00:06:12,880 --> 00:06:14,560
أين الملك أها؟

94
00:06:14,890 --> 00:06:16,280
!الملك أها؟

95
00:06:17,150 --> 00:06:18,550
...إنّها مختلفة نوعًا ما

96
00:06:18,550 --> 00:06:20,190
!تبدو أكثر حدّة من المعتاد

97
00:06:20,190 --> 00:06:22,440
!اجتماع طارئ

98
00:06:22,440 --> 00:06:24,490
أيّها الرّئيس، ما الوضع الحاليّ؟

99
00:06:24,490 --> 00:06:25,410
.لا فكرة لديّ

100
00:06:25,410 --> 00:06:27,000
—المعذرة، أنا

101
00:06:27,000 --> 00:06:28,860
!آسفون! نحن في اجتماع

102
00:06:28,860 --> 00:06:29,540
.حسنًا

103
00:06:29,540 --> 00:06:30,420
!شيرورين

104
00:06:30,420 --> 00:06:32,960
.نعتذر على التّأخير أيّتها الملك الحقيقيّ أها

105
00:06:32,960 --> 00:06:34,610
الملك الحقيقيّ أها...؟

106
00:06:34,610 --> 00:06:35,870
—لا، أنا

107
00:06:35,870 --> 00:06:37,590
.ليس عليك قول أيّ شيء يا جلالتك

108
00:06:37,590 --> 00:06:41,120
نالت منك المنظّمة، لذلك تبدين
!أصغر في معظم الأحيان

109
00:06:41,120 --> 00:06:43,170
!لكنّ هذه هي هيئتك الحقيقيّة

110
00:06:43,480 --> 00:06:46,680
.إنّهم أطفال الابتدائيّة الّتي ذكرتهم رينا

111
00:06:47,310 --> 00:06:48,380
.مع السّلامة

112
00:06:48,380 --> 00:06:50,310
!مهلاً أيّتها الملك الحقيقيّ أها

113
00:06:50,580 --> 00:06:54,020
!علّمينا كيف نتزلّج رجاءً

114
00:06:54,020 --> 00:06:55,270
كيف تتزلّجون؟

115
00:06:55,270 --> 00:06:57,600
...نعم. نحن لسنا جيّدين

116
00:06:57,600 --> 00:07:01,750
.لا يمكنني رفض طلبهم
.سيؤثّر ذلك سلبًا على رينا

117
00:07:04,080 --> 00:07:05,530
لبعض الوقت فحسب، مفهوم؟

118
00:07:05,530 --> 00:07:07,040
!شكرًا جزيلاً

119
00:07:07,040 --> 00:07:08,230
!شيرورين

120
00:07:12,240 --> 00:07:13,290
...والآن

121
00:07:18,880 --> 00:07:22,340
،كما رأيتم، إن قفزتم فحسب
.فهذا ما سيحدث

122
00:07:22,590 --> 00:07:26,050
لذلك في البداية، من الأفضل استعمال
.القضبان الحديديّة لتعتادوا على التّوازن

123
00:07:26,300 --> 00:07:27,220
...ثمّ

124
00:07:33,250 --> 00:07:36,350
،إن تحرّكتم فجأة للأمام
.سيكون ذلك خطيرًا كما أظهرتُ لكم

125
00:07:38,590 --> 00:07:41,880
من الأفضل أن تبدؤوا بالتّدرّب
.على كيفية الوقوف على اللّوح

126
00:07:41,880 --> 00:07:45,540
.في العجلة النّدامة، لذا احرصوا أن تُبطئوا

127
00:07:45,540 --> 00:07:46,780
!حاضر

128
00:07:47,470 --> 00:07:49,450
.سنواصل الدّروس في وقت آخر

129
00:07:49,940 --> 00:07:51,740
.واصلوا التّدرّب حتّى ذلك الحين

130
00:07:51,740 --> 00:07:53,990
!حاضر أيّتها الملك الحقيقيّ أها

131
00:07:53,990 --> 00:07:55,700
!مع السّلامة

132
00:08:01,490 --> 00:08:03,210
...فشلت ثانية

133
00:08:03,210 --> 00:08:06,720
.ربّما لا أستطيع أخذ مكان رينا في النّهاية

134
00:08:08,460 --> 00:08:13,320
.لا! عليّ ذلكَ للحرص على ألاّ تتلطّخ سمعة رينا

135
00:08:14,430 --> 00:08:17,340
إرو؟ هل تتزلّجين الآن؟

136
00:08:17,340 --> 00:08:19,410
.حسنًا... نعم

137
00:08:19,410 --> 00:08:21,590
أتريدين منّي أن أساعدك على التّدرّب؟

138
00:08:21,590 --> 00:08:24,270
!وأنا أيضًا! لنقم بذلك معًا

139
00:08:26,250 --> 00:08:28,110
.شكرًا لكما

140
00:08:50,600 --> 00:08:53,370
.وأخيرًا بإمكاني ركوب اللّوح ولو قليلاً

141
00:08:53,370 --> 00:08:55,100
!أيّها الملك الحقيقيّ أها

142
00:08:55,450 --> 00:08:57,850
أيمكنك تعليمنا لعبة خيوط الأصابع هذه المرّة؟

143
00:09:01,770 --> 00:09:06,650
سمعتُ أنّ أكّون والبقيّة يلعبون
.لعبة خيوط الأصابع مؤخّرًا

144
00:09:06,650 --> 00:09:09,240
!حتّى أنا بإمكاني ذلك

145
00:09:09,610 --> 00:09:14,490
،سأتفاخر بتقنياتي أمامهم
!وسيتوسّل إليّ لتعليمه

146
00:09:20,280 --> 00:09:21,710
...ثانية

147
00:09:21,980 --> 00:09:25,590
!أهارن رينا، تحاولين التّقرّب من أكّون ثانية

148
00:09:25,590 --> 00:09:27,970
!أنت عدوّتي بالفعل

149
00:09:27,970 --> 00:09:30,470
!أهارن رينا

150
00:09:31,280 --> 00:09:33,260
ماذا؟ من أنت؟

151
00:09:33,680 --> 00:09:36,380
.هذه ليست أهارن رينا

152
00:09:36,380 --> 00:09:40,330
...زيادة على ذلك، فإنّ هالتها

153
00:09:40,980 --> 00:09:43,440
!إنّ رينا المزيّفة لا يستهان بها

154
00:09:43,440 --> 00:09:47,460
فوتابا؟ هل أتيت للتّعلّم من
الملك الحقيقيّ أها أيضًا؟

155
00:09:48,730 --> 00:09:50,570
.ليس تمامًا

156
00:09:51,360 --> 00:09:54,030
أهذه الفتاة من أصدقاء رينا أيضًا؟

157
00:09:54,030 --> 00:09:55,640
ماذا تفعلين هنا إذًا؟

158
00:09:54,510 --> 00:09:57,110
...إنّها تعرف الكثير من الأشخاص

159
00:09:55,640 --> 00:09:59,160
!أتيت للّعب بخيوط الأصابع فحسب

160
00:09:58,510 --> 00:10:00,790
هل أعلّمك أنت أيضًا؟

161
00:10:03,970 --> 00:10:05,290
...من الواضح

162
00:10:05,290 --> 00:10:07,250
!أنّ بإمكاني القيام بذلك بنفسي

163
00:10:14,810 --> 00:10:16,600
.هذا صعب

164
00:10:16,600 --> 00:10:17,570
ماذا؟

165
00:10:17,970 --> 00:10:19,930
.أنت الفتاة الّتي قابلتُ البارحة

166
00:10:19,930 --> 00:10:22,230
ما-ما الّذي تريدينه؟

167
00:10:24,150 --> 00:10:25,970
...إن قمتِ بهذا هكذا

168
00:10:27,360 --> 00:10:29,760
!أنا لم أطلب مساعدتك

169
00:10:32,870 --> 00:10:36,350
.ر-ربّما عليك أن تريني كيف في نهاية المطاف

170
00:10:37,460 --> 00:10:38,520
...حسنًا

171
00:10:39,620 --> 00:10:42,750
.تقومين بهذا هكذا، ثمّ هذا

172
00:10:42,750 --> 00:10:43,580
.نعم

173
00:10:48,040 --> 00:10:49,550
!نجح الأمر

174
00:10:51,040 --> 00:10:54,470
.أعتقد أنّ بإمكانك إتقان تصاميم أكثر تعقيدًا

175
00:11:17,020 --> 00:11:19,780
.أتيتُ باكرًا نوعًا ما. أتساءل إن كانت هنا

176
00:11:20,600 --> 00:11:21,740
!ها هي ذي

177
00:11:22,020 --> 00:11:25,210
هل... تتدرّبين؟

178
00:11:25,790 --> 00:11:27,290
.فوتابا-سان

179
00:11:27,290 --> 00:11:31,470
.نعم، ما زال أمامي الكثير لأتعلّمه

180
00:11:31,470 --> 00:11:32,750
.هكذا إذًا

181
00:11:33,080 --> 00:11:34,760
...أخبريني يا رينا المزيّفة

182
00:11:35,380 --> 00:11:37,480
ألم يحن الوقت بعد لتخبريني باسمك؟

183
00:11:40,350 --> 00:11:43,300
.أنا آسفة. لا بدّ أنّ أملك قد خاب

184
00:11:43,300 --> 00:11:44,390
بشأن ماذا؟

185
00:11:45,180 --> 00:11:50,400
أنا لستُ جديرة لأكون بديلة
.لأختي الكبيرة رينا

186
00:11:50,400 --> 00:11:52,010
بديلة؟

187
00:11:52,010 --> 00:11:52,980
.نعم

188
00:11:52,980 --> 00:11:56,040
!بالطّبع لست كذلك

189
00:11:56,820 --> 00:12:00,410
.رينا هي رينا، وأنت هي أنت

190
00:12:03,580 --> 00:12:06,410
.لا أحتاج لبديلة لرينا

191
00:12:06,730 --> 00:12:08,490
.أنا صديقتك أنت

192
00:12:09,880 --> 00:12:12,560
!لذلك أخبريني باسمك بسرعة

193
00:12:13,550 --> 00:12:17,490
.أنا أهارن إرو. نادني إرو لو سمحت

194
00:12:17,490 --> 00:12:19,590
!سررت بالتّعرّف إليك يا إرو

195
00:12:21,300 --> 00:12:25,140
...لـ-لم أقصد أيّ شيء غريب بذلك

196
00:12:26,170 --> 00:12:27,370
.شكرًا لك

197
00:12:27,370 --> 00:12:28,610
...إضافة لذلك

198
00:12:28,610 --> 00:12:30,050
!مرحبًا

199
00:12:30,770 --> 00:12:32,480
!أيّها الملك الحقيقيّ أها

200
00:12:32,890 --> 00:12:35,190
هلاّ علّمتنا كيف نقفز على الحبل اليوم؟

201
00:12:35,480 --> 00:12:37,290
فوتابا؟

202
00:12:37,290 --> 00:12:39,970
هل تحصلين على تدريب فرديّ
من الملك الحقيقيّ؟

203
00:12:39,970 --> 00:12:41,240
أيمكنني ذلك أيضًا لو سمحت؟

204
00:12:41,240 --> 00:12:41,920
!وأنا أيضًا

205
00:12:41,920 --> 00:12:42,660
!وأنا

206
00:12:42,990 --> 00:12:46,370
.لستُ الوحيدة. ذلك ما يظنّونه جميعًا أيضًا

207
00:12:47,870 --> 00:12:50,700
.حسنًا، لنقفز جميعًا على الحبل

208
00:12:50,700 --> 00:12:51,830
!حاضر

209
00:12:52,610 --> 00:12:56,760
.كما ترون، البدء بشكل مفاجئ خطير للغاية

210
00:13:00,970 --> 00:13:03,010
...أهارن إرو

211
00:13:03,010 --> 00:13:04,810
!أنت عدوّتي أيضًا

212
00:13:11,050 --> 00:13:13,960
.صباح الخير يا أختي إرو

213
00:13:13,960 --> 00:13:15,940
.صباح الخير يا رن

214
00:13:17,900 --> 00:13:20,280
.صباح الخير يا رينا

215
00:13:20,280 --> 00:13:22,180
.صباح الخير لكما

216
00:13:22,180 --> 00:13:23,490
...صباح الخير

217
00:13:27,160 --> 00:13:30,120
.فطور اليوم وليمة حقيقيّة

218
00:13:30,430 --> 00:13:33,580
.لا داعي للقلق. كنتُ أعدّ الغداء على أيّ حال

219
00:13:33,580 --> 00:13:34,810
.فهمت

220
00:13:36,290 --> 00:13:39,010
.جهّزت ملابس إضافيّة لك يا رن

221
00:13:39,550 --> 00:13:42,470
.كما كويتُ زيّك المدرسيّ يا إرو

222
00:13:43,100 --> 00:13:45,320
...شكرًا لك. لكن

223
00:13:46,020 --> 00:13:47,020
.إرو

224
00:13:49,950 --> 00:13:51,850
.شعرك منكوش من النّوم

225
00:13:52,480 --> 00:13:54,310
...شـ-شكرًا لك

226
00:13:54,790 --> 00:13:56,730
.سأمشّط شعرك تاليًا يا رن

227
00:13:56,730 --> 00:13:57,730
.حاضر

228
00:13:58,620 --> 00:14:01,340
.أختي رينا مبهرة دائمًا

229
00:14:01,340 --> 00:14:02,280
.نعم

230
00:14:02,280 --> 00:14:05,530
!وجدتها! لماذا لا نظهر لها امتناننا؟

231
00:14:05,530 --> 00:14:07,240
امتناننا؟

232
00:14:08,480 --> 00:14:09,700
.هذا مثاليّ

233
00:14:10,100 --> 00:14:13,370
،عليّ أن أظهر لرينا كم صرتُ مستقلّة

234
00:14:13,370 --> 00:14:15,710
!لكي لا تضطرّ للقلق عليّ كثيرًا

235
00:14:15,990 --> 00:14:18,730
.فكرة جيّدة، بالنّظر لكلّ ما تفعله لأجلنا

236
00:14:18,730 --> 00:14:20,170
!مرحى

237
00:14:24,920 --> 00:14:27,610
!ما الّذي تفعله هنا؟

238
00:14:27,610 --> 00:14:29,450
.أنا طلبتُ منه المجيء

239
00:14:29,450 --> 00:14:33,150
،يعرف أخي رايدو أمورًا تحبّها أختي رينا

240
00:14:33,150 --> 00:14:35,810
!لذلك بإمكانه تقديم أفكار عن كيف نشكرها

241
00:14:35,810 --> 00:14:40,780
يبدو أنّهما يريدان إظهار امتنانهما
.لأهارن-سان لقاء كلّ ما تفعله لأجلهما

242
00:14:40,780 --> 00:14:42,690
...مهلاً، أيعقل أنّ هذا

243
00:14:43,130 --> 00:14:44,610
عهد دم؟

244
00:14:44,610 --> 00:14:49,540
قانون الصّمت لدى المافيا الأوروبّيّة
،الّذي قد ينتج عنه ظهور بينتيتو

245
00:14:49,540 --> 00:14:52,450
.حيث يُعاقَب من يخرقه بعنف شديد

246
00:14:52,450 --> 00:14:57,540
،ربّما هذا ما فعلته أهارن-سان
!"وتريد عائلتها "إظهار امتنانها

247
00:14:57,540 --> 00:15:01,250
.كلاّ. إنّ هذه مسألة تخصّ العائلة

248
00:15:01,250 --> 00:15:05,590
.أفضّل ألاّ يتدخّل غرباء مثلك

249
00:15:05,970 --> 00:15:10,690
لا يمكنني أن أثبت لرينا كم صرت
!مستقلّة إلاّ هكذا

250
00:15:10,690 --> 00:15:12,350
.مهلاً، مهلاً. على رسلك

251
00:15:12,350 --> 00:15:14,580
!يكفي يا أختي إرو

252
00:15:14,580 --> 00:15:16,280
،إن قام بمساعدتنا

253
00:15:16,280 --> 00:15:19,020
فبإمكاننا أن نحرص أنّ أختي
!رينا ستستمع كثيرًا بالأمر

254
00:15:21,010 --> 00:15:23,990
.معك حقّ. لا بأس إذًا

255
00:15:28,160 --> 00:15:31,210
!شكرًا لك على مساعدتنا في التّسوّق

256
00:15:31,210 --> 00:15:33,780
.الأغراض ثقيلة، لذلك سأحملها حتّى نقترب أكثر

257
00:15:34,620 --> 00:15:36,690
.ذلك ليس ضروريًّا

258
00:15:36,690 --> 00:15:38,460
.يمكنك الذّهاب للمنزل الآن

259
00:15:38,460 --> 00:15:40,440
.شكرًا على المساعدة

260
00:15:40,440 --> 00:15:45,460
!أختي إرو! قال أخي أنّه سيحملها

261
00:15:45,460 --> 00:15:47,080
.لا، لا بأس يا رن-كُن

262
00:15:47,080 --> 00:15:48,300
!...لكن

263
00:15:48,930 --> 00:15:50,430
...إن سمحتُ له بالمساعدة أكثر

264
00:15:50,890 --> 00:15:52,850
!بدون لكن

265
00:15:52,850 --> 00:15:55,930
.أختي إرو، إنّك تتصرّفين بغرابة

266
00:15:55,930 --> 00:15:59,150
!لا يجب أن أسمح له بمساعدتنا أكثر

267
00:16:06,190 --> 00:16:09,040
!يا إلهي، لا أصدّقك يا أختي إرو

268
00:16:09,040 --> 00:16:10,660
!سأذهب للمنزل

269
00:16:09,900 --> 00:16:10,660
!انتظر يا رن

270
00:16:10,660 --> 00:16:12,620
!لا تذهب وحدك

271
00:16:12,620 --> 00:16:14,590
!يمكنني الذّهاب وحدي

272
00:16:21,250 --> 00:16:22,610
.أنا آسفة

273
00:16:24,570 --> 00:16:28,340
.أنا... أشعر بالغيرة منك

274
00:16:28,950 --> 00:16:31,090
.بما أنّك المفضّل لدى رينا

275
00:16:32,040 --> 00:16:36,300
ولا يوجد ما يمكنني فعله لأكون
.المفضّلة عندها بعد الآن

276
00:16:37,280 --> 00:16:38,500
...ربّما

277
00:16:41,460 --> 00:16:44,690
يكون صحيحًا أنّك لا يمكنك
.أخذ مكاني يا إرو-سان

278
00:16:45,290 --> 00:16:47,670
.لكنّي لا أستطيع أخذ مكانك أيضًا

279
00:16:49,770 --> 00:16:52,200
.أخبرني أحد ما بذلك من قبل

280
00:16:53,360 --> 00:16:56,870
.رينا هي رينا، وأنت هي أنت

281
00:16:57,260 --> 00:17:00,280
.لا أحتاج لبديلة لرينا

282
00:17:00,280 --> 00:17:02,120
.أنا صديقتك أنت

283
00:17:02,710 --> 00:17:06,010
،وجب أن أكون قد تعلّمت
.لكنّي أقترف نفس الأخطاء

284
00:17:06,640 --> 00:17:10,010
.لا أصدّق أنّي ظننتُ أنّي صرت مستقلّة

285
00:17:10,400 --> 00:17:14,550
.لا عجب أنّ رينا تعتقد أنّ عليها الاعتناء بي

286
00:17:15,380 --> 00:17:16,970
.شكرًا لك

287
00:17:17,690 --> 00:17:18,710
.العفو

288
00:17:23,860 --> 00:17:24,950
إرو؟

289
00:17:25,500 --> 00:17:27,480
ألم يكن رن معك؟

290
00:17:28,120 --> 00:17:30,150
.لم يعد للمنزل بعد

291
00:17:30,150 --> 00:17:31,220
هل اتّصلت به؟

292
00:17:31,220 --> 00:17:33,250
.هاتفه مطفأ

293
00:17:33,250 --> 00:17:35,490
كلاّ... هل هرب من المنزل؟

294
00:17:36,260 --> 00:17:38,830
...بسببي أنا... رن قد

295
00:17:38,830 --> 00:17:42,570
.اهدئي. لا يمكننا الجزم بأنّه هرب من المنزل

296
00:17:42,870 --> 00:17:45,580
.ربّما لا يريد العودة للمنزل بعد فحسب

297
00:17:45,580 --> 00:17:48,960
يمرّ الجميع بلحظات يحتاجون فيها
.إلى بعض الوقت لأنفسهم

298
00:17:49,430 --> 00:17:51,270
.لننتظر بعض الوقت

299
00:17:55,760 --> 00:17:57,010
...رينا

300
00:17:58,040 --> 00:17:59,440
.مفهوم

301
00:18:07,520 --> 00:18:09,480
.ماذا؟ إنّه الأخ الصّغير

302
00:18:09,480 --> 00:18:12,320
.لكنّ الوقت قد تأخّر ليكون في الخارج وحده

303
00:18:12,830 --> 00:18:13,780
...أيُعقل أنّه

304
00:18:13,860 --> 00:18:15,350
!هرب من المنزل؟

305
00:18:16,320 --> 00:18:18,050
،في تلك الحالة، إن أعدته للمنزل

306
00:18:18,050 --> 00:18:20,390
!فسأكتسب الكثير من استحسان أها-تشان

307
00:18:20,390 --> 00:18:22,190
—مرحبًا أيّها الأخ الصّـ

308
00:18:22,820 --> 00:18:25,930
...لا، مهلاً. إذا ما انتقيتُه فجأة

309
00:18:25,930 --> 00:18:28,800
فذلك من الأمور الّتي تجعلني
!أبدو كمطارِدة مريبة

310
00:18:30,570 --> 00:18:33,770
.ماذا أفعل؟ ربّما عليّ تركه وشأنه فحسب

311
00:18:33,770 --> 00:18:35,470
...ولكن

312
00:18:36,060 --> 00:18:40,430
لماذا غضبت أختي إرو كثيرًا؟

313
00:18:42,130 --> 00:18:46,310
من الأفضل أن أعود للمنزل
.بسرعة وإلاّ قلق الجميع عليّ

314
00:18:48,230 --> 00:18:49,840
أختي ريكو؟

315
00:18:51,630 --> 00:18:54,650
...مـ-مرحبًا، لم أتوقّع رؤيتك هنا

316
00:18:54,650 --> 00:18:58,620
...أختي ريكو

317
00:18:59,710 --> 00:19:02,160
!مهلاً، لم أفعل أيّ شيء حتّى

318
00:19:03,460 --> 00:19:05,120
.هكذا إذًا

319
00:19:05,120 --> 00:19:07,550
تريدان إظهار امتنانكما لأختكما الكبيرة؟

320
00:19:07,550 --> 00:19:12,090
...لكنّ أختي إرو كانت لئيمة مع أخي رايدو

321
00:19:12,090 --> 00:19:14,980
.لا فكرة لديّ ما النّصيحة الّتي عليّ تقديمها

322
00:19:15,550 --> 00:19:17,050
!أنا متفاجئة قليلاً

323
00:19:17,320 --> 00:19:21,640
.لم أدرك أنّه كان لأها-تشان شقيقان
.ظننتك أخاها الوحيد

324
00:19:21,990 --> 00:19:25,100
.مهلاً، لستُ وحدي... نحن اثنان

325
00:19:27,100 --> 00:19:32,370
أيُعقل أنّ أختي إرو أرادت
أن نقوم أنا وهي فقط بهذا؟

326
00:19:33,020 --> 00:19:37,540
.في تلك الحالة... فقد تصرّفتُ بسوء شديد

327
00:19:37,540 --> 00:19:41,220
،حسنًا، إن كان هذا ما تشعر به
.فأفضل ما يمكنك فعله هو الاعتذار

328
00:19:42,000 --> 00:19:47,200
،قد يتطلّب الأمر بعض الشّجاعة
.لكن أراهن أنّ بإمكانك ذلك يا رن-كُن

329
00:19:50,840 --> 00:19:54,300
!حسنًا! شكرًا لك يا أختي ريكو

330
00:19:54,800 --> 00:19:56,280
.أ-أكيد

331
00:19:56,760 --> 00:19:59,050
!حسنًا، من الأفضل أن أذهب

332
00:19:59,050 --> 00:20:00,220
!مع السّلامة

333
00:20:00,220 --> 00:20:02,180
!كم فاجأني ذلك

334
00:20:02,180 --> 00:20:05,720
العناق من طفل في الابتدائيّة منفتح
!اجتماعيًّا بدرجة كبيرة شيءٌ لا يُصدَّق

335
00:20:06,180 --> 00:20:09,030
!حظًّا سعيدًا أيّها الشّابّ الصّغير

336
00:20:23,790 --> 00:20:26,030
!أنا آسف يا أختي إرو

337
00:20:26,030 --> 00:20:28,710
!لم أدرك كيف تشعرين

338
00:20:28,710 --> 00:20:30,320
.لا بأس

339
00:20:30,820 --> 00:20:33,000
.أنا آسفة أيضًا

340
00:20:33,000 --> 00:20:37,160
كنتَ تفكّر في رينا عندما
.طلبتَ مساعدة رايدو-سان

341
00:20:37,160 --> 00:20:42,070
،إن كنّا نريد إظهار امتناننا لها
!من الأفضل أن نفعل شيئًا معًا

342
00:20:42,720 --> 00:20:45,680
!لأنّ كلينا يحبّ أختي رينا

343
00:20:47,070 --> 00:20:49,270
.هذا لأجل رينا الّتي نحبّها

344
00:21:02,480 --> 00:21:04,160
.شكرًا على الطّعام

345
00:21:04,160 --> 00:21:06,130
.العفو، تفضّلي

346
00:21:11,190 --> 00:21:12,580
.إنّه لذيذ

347
00:21:12,580 --> 00:21:16,670
.إنّه يحتوي على البطاطس الّتي أحبّ

348
00:21:19,530 --> 00:21:22,760
.والحلوة منها هي المفضّلة لديّ

349
00:21:22,760 --> 00:21:25,630
!أنا أعددتُ البيض

350
00:21:25,630 --> 00:21:27,430
.مذاقها رائع

351
00:21:27,770 --> 00:21:29,290
ما رأيك يا رينا؟

352
00:21:29,290 --> 00:21:32,540
.بإمكاننا فعل كلّ شيء بأنفسنا الآن

353
00:21:32,540 --> 00:21:36,020
لذلك لا بأس إن كنت تريدين
.وقتًا أكثر لنفسك

354
00:21:36,020 --> 00:21:37,860
وقت لنفسي...؟

355
00:21:40,320 --> 00:21:42,390
.ذلك ما أظنّه على الأقلّ

356
00:21:42,390 --> 00:21:45,280
.لكنّي أدركتُ أنّه ما زلت لم أنضج بما يكفي

357
00:21:45,590 --> 00:21:49,750
.لذلك السّبب سأواصل الاعتماد عليك يا رينا

358
00:21:50,600 --> 00:21:53,960
.لكنّنا نريدك أن تعتمدي علينا أكثر أيضًا

359
00:22:01,380 --> 00:22:05,030
.شكرًا لكما. أنا أحبّكما حبًّا جمًّا

360
00:22:05,780 --> 00:22:09,210
.نحن عائلة في النّهاية. هذا لا شيء

361
00:22:09,210 --> 00:22:10,350
!صحيح

362
00:22:14,520 --> 00:22:15,600
ما هذا؟

363
00:22:15,600 --> 00:22:19,980
،بما أنّنا نظهر الامتنان للأخوات الكبيرات
!فهذا لأجلك يا أختي إرو

364
00:22:22,650 --> 00:22:25,380
!أنا أختنق