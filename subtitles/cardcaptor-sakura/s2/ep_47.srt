1
00:00:08,250 --> 00:00:13,260
‫"(كارد كابتور ساكورا)"‬

2
00:01:28,580 --> 00:01:30,590
‫كاد الصيف أن ينتهي.‬

3
00:01:34,300 --> 00:01:36,430
‫- مرحباً "ساكورا".‬
‫- ماذا؟‬

4
00:01:37,260 --> 00:01:40,180
‫هل من الطبيعي أن نحظى بهذا القدر ‬
‫من وقت الفراغ؟‬

5
00:01:40,300 --> 00:01:41,600
‫عم تتحدثين؟‬

6
00:01:41,930 --> 00:01:43,350
‫لهذا السبب،‬

7
00:01:43,470 --> 00:01:45,270
‫حظينا بوقت كثير لللعب، لا؟‬

8
00:01:45,600 --> 00:01:47,600
‫أجل ولكن...‬

9
00:01:49,360 --> 00:01:50,610
‫ماذا تفعلين؟‬

10
00:01:51,070 --> 00:01:53,190
‫تلقيت رسالة من الآنسة "ميزوكي"،‬

11
00:01:53,360 --> 00:01:54,360
‫وأنا أرد عليها.‬

12
00:01:54,610 --> 00:01:58,860
‫سافرت السيدة لتدرس في الخارج، لا؟‬

13
00:01:59,530 --> 00:02:00,700
‫هل هي بخير؟‬

14
00:02:01,160 --> 00:02:03,870
‫أجل، قالت إنها تجتهد في الدرس.‬

15
00:02:07,410 --> 00:02:10,210
‫ولكن بفضلها،‬

16
00:02:10,630 --> 00:02:13,550
‫أصبحتِ رسمياً "سيدة بطاقات (كلو)"‬

17
00:02:13,630 --> 00:02:14,960
‫أنا سعيد بذلك.‬

18
00:02:15,630 --> 00:02:18,430
‫- لماذا؟‬
‫- أليس واضحاً؟‬

19
00:02:18,630 --> 00:02:21,640
‫لو أصبح ذلك الوغد السيد،‬

20
00:02:21,970 --> 00:02:24,180
‫لفقدت كل ثقتي بالعيش.‬

21
00:02:24,640 --> 00:02:25,640
‫لا تقل هذا!‬

22
00:02:25,720 --> 00:02:27,480
‫عمل "لي" جاهداً على الأمر!‬

23
00:02:29,650 --> 00:02:31,900
‫على فكرة، ماذا سيفعل؟‬

24
00:02:32,650 --> 00:02:34,280
‫هل عاد إلى "هونغ كونغ"؟‬

25
00:02:34,440 --> 00:02:35,650
‫ليس بعد...‬

26
00:02:36,070 --> 00:02:39,780
‫ولكن قال إنه سيعود قريباً.‬

27
00:02:43,160 --> 00:02:45,660
‫بوجود وقت الفراغ هذا كل يوم،‬

28
00:02:45,910 --> 00:02:47,160
‫بدأت أشعر بالملل!‬

29
00:02:47,660 --> 00:02:48,960
‫ليس لديّ وقت فراغ‬

30
00:02:49,670 --> 00:02:51,460
‫لأنه لديّ مدرسة غداً.‬

31
00:02:55,170 --> 00:02:56,260
‫ما الأمر؟‬

32
00:02:58,670 --> 00:03:01,840
‫فروض العطلة الصيفية ‬
‫لا تزال في حقيبة المدرسة!‬

33
00:03:02,010 --> 00:03:03,050
‫ماذا؟‬

34
00:03:06,430 --> 00:03:07,680
‫يجب أن أنهي الرياضيات،‬

35
00:03:07,770 --> 00:03:08,770
‫واللغة اليابانية،‬

36
00:03:08,890 --> 00:03:10,100
‫وصورة مذكراتي.‬

37
00:03:10,520 --> 00:03:14,320
‫وهناك بحث مستقل و...‬

38
00:03:14,820 --> 00:03:17,110
‫هل يمكنك إنهائها في ليلة واحدة؟‬

39
00:03:18,690 --> 00:03:20,030
‫ستصطلح الأمور!‬

40
00:03:20,400 --> 00:03:22,070
‫ستكون بخير حتماً.‬

41
00:03:24,700 --> 00:03:26,120
‫هذه مشكلة.‬

42
00:03:27,700 --> 00:03:29,710
‫"كيرو"، ساعدني من فضلك!‬

43
00:03:29,790 --> 00:03:32,420
‫ساعدتك العام الفائت وغضبت مني!‬

44
00:03:32,710 --> 00:03:33,790
‫أجل ولكن الآن...‬

45
00:03:34,710 --> 00:03:36,920
‫على فكرة، لديّ خدمة غداً!‬

46
00:03:37,250 --> 00:03:39,720
‫لا! يجب أن أنهض باكراً صباح الغد!‬

47
00:03:40,720 --> 00:03:43,220
‫ستكونين بخير! أنا واثق من أنك ستنجزينها.‬

48
00:03:45,930 --> 00:03:49,890
‫"(ساكورا) والتلميذ الجديد الغامض"‬

49
00:03:57,730 --> 00:03:59,110
‫صباح الخير!‬

50
00:03:59,320 --> 00:04:01,700
‫- هل أنهيت فروضك؟‬
‫- أجل.‬

51
00:04:02,740 --> 00:04:04,030
‫صباح الخير يا أمي.‬

52
00:04:10,160 --> 00:04:11,750
‫هل أنت بخير يا "ساكورا"؟‬

53
00:04:17,420 --> 00:04:18,590
‫صباح الخير يا أبي!‬

54
00:04:19,050 --> 00:04:20,130
‫صباح الخير.‬

55
00:04:20,880 --> 00:04:23,760
‫إنه اليوم الدراسي الأول‬
‫وقد استيقظت باكراً.‬

56
00:04:24,760 --> 00:04:26,050
‫لديّ خدمة اليوم.‬

57
00:04:26,510 --> 00:04:27,390
‫فهمت.‬

58
00:04:28,760 --> 00:04:29,930
‫إنه الفصل الثاني.‬

59
00:04:30,390 --> 00:04:31,520
‫اعملي جيداً، حسناً؟‬

60
00:04:33,770 --> 00:04:34,770
‫شكراً لك على الطعام.‬

61
00:04:36,770 --> 00:04:37,860
‫حتى لو أبكرت بالذهاب،‬

62
00:04:37,940 --> 00:04:39,070
‫لن يكون "يوكي" هناك.‬

63
00:04:39,780 --> 00:04:41,240
‫الأمر ليس كذلك!‬

64
00:04:44,780 --> 00:04:45,910
‫سأذهب الآن.‬

65
00:04:51,790 --> 00:04:53,790
‫أكره الرياضيات!‬

66
00:04:57,790 --> 00:04:58,630
‫إن فكرت بالأمر،‬

67
00:04:58,710 --> 00:05:01,340
‫من سيخدم معي اليوم؟‬

68
00:05:09,510 --> 00:05:10,810
‫"يوكيتو"!‬

69
00:05:11,520 --> 00:05:13,810
‫- "ساكورا"!‬
‫- صباح الخير!‬

70
00:05:14,390 --> 00:05:17,600
‫صباح الخير! لقد أبكرت اليوم.‬

71
00:05:18,110 --> 00:05:20,980
‫لديّ خدمة لذا...‬

72
00:05:22,070 --> 00:05:24,360
‫ولكنك أبكرت أيضاً.‬

73
00:05:25,780 --> 00:05:27,820
‫استيقظت باكراً لشراء الفطور.‬

74
00:05:28,450 --> 00:05:29,740
‫لأنه مؤخراً،‬

75
00:05:29,830 --> 00:05:31,450
‫مهما أكلت، أشعر بجوع دائم.‬

76
00:05:32,200 --> 00:05:33,830
‫ربما أكثرت من شراء الطعام.‬

77
00:05:34,500 --> 00:05:35,620
‫لا، أبداً!‬

78
00:05:36,000 --> 00:05:37,500
‫أن تتمكن من الأكل كثيراً‬

79
00:05:38,170 --> 00:05:39,630
‫يعني أنك بصحة جيدة، لا؟‬

80
00:05:40,590 --> 00:05:41,590
‫أجل!‬

81
00:05:43,550 --> 00:05:45,760
‫يجب أن أذهب الآن.‬

82
00:05:45,840 --> 00:05:47,300
‫حسناً، إلى اللقاء.‬

83
00:05:53,850 --> 00:05:57,850
‫"يوكيتو" هو الشكل الكاذب لـ"يو".‬

84
00:05:59,860 --> 00:06:00,860
‫"ساكورا"!‬

85
00:06:17,120 --> 00:06:18,420
‫ولكن،‬

86
00:06:18,870 --> 00:06:20,880
‫"يوكيتو" لا يتغير أبداً.‬

87
00:06:28,880 --> 00:06:29,890
‫صباح الخير!‬

88
00:06:30,890 --> 00:06:32,220
‫ولكن لم يصل أحد بعد.‬

89
00:06:35,680 --> 00:06:38,600
‫في الخدمة!‬

90
00:06:38,770 --> 00:06:42,150
‫لقد أنهيت فروض العطلة الصيفية‬

91
00:06:42,230 --> 00:06:43,940
‫نوعاً ما،‬

92
00:06:44,900 --> 00:06:46,820
‫وكتبت على دفتر الصف،‬

93
00:06:46,900 --> 00:06:49,450
‫وغيّرت الأزهار.‬

94
00:06:49,910 --> 00:06:52,830
‫لننظف طاولات الجميع!‬

95
00:06:52,910 --> 00:06:54,950
‫أنا في الخدمة...‬

96
00:06:58,910 --> 00:07:00,250
‫صباح الخير "لي".‬

97
00:07:00,920 --> 00:07:01,920
‫صباح الخير.‬

98
00:07:02,920 --> 00:07:03,920
‫سمعتني إذاً.‬

99
00:07:05,920 --> 00:07:09,550
‫فهمت، أنا في الخدمة مع "لي" اليوم.‬

100
00:07:13,050 --> 00:07:15,930
‫لأنه تم التقاط بطاقات "كلو" كلها‬
‫قبل عطلة الصيف،‬

101
00:07:16,470 --> 00:07:18,680
‫ولم نر بعضنا بعضاً لفترة.‬

102
00:07:18,930 --> 00:07:20,020
‫أجل.‬

103
00:07:20,390 --> 00:07:21,940
‫كيف كانت عطلة الصيف؟‬

104
00:07:22,020 --> 00:07:23,860
‫- هل ذهبت لمكان ما؟‬
‫- لا.‬

105
00:07:23,940 --> 00:07:26,280
‫- ماذا عن الشاطئ؟‬
‫- لم أذهب.‬

106
00:07:29,240 --> 00:07:31,740
‫إذاً، هل ستعود فعلاً إلى "هونغ كونغ"؟‬

107
00:07:32,570 --> 00:07:33,570
‫أجل.‬

108
00:07:33,700 --> 00:07:35,950
‫بما أن هناك سيدة جديدة لبطاقات "كلو"،‬

109
00:07:36,240 --> 00:07:38,540
‫يجب أن أبلغ أمي.‬

110
00:07:39,960 --> 00:07:41,120
‫فهمت.‬

111
00:07:49,970 --> 00:07:52,890
‫لا أعتقد بأننا لن نرى بعضنا ثانية.‬

112
00:07:54,470 --> 00:07:55,470
‫هذا صحيح.‬

113
00:07:56,560 --> 00:07:57,560
‫حمداً لله.‬

114
00:08:08,980 --> 00:08:11,610
‫- صباح الخير.‬
‫- صباح الخير "تومويو"!‬

115
00:08:16,990 --> 00:08:17,870
‫ما الأمر؟‬

116
00:08:18,620 --> 00:08:22,920
‫مؤخراً، لم تتسن الفرصة‬

117
00:08:23,000 --> 00:08:25,330
‫لترتدي أزيائي الخاصة.‬

118
00:08:26,670 --> 00:08:28,130
‫لا يزال لديّ أزياء كثيرة‬

119
00:08:28,340 --> 00:08:30,420
‫أريد أن ترتديها من أجلي.‬

120
00:08:32,010 --> 00:08:35,010
‫ومن ثم سأصورك بهذه الأزياء...‬

121
00:08:37,010 --> 00:08:39,520
‫لكان الأمر رائعاً!‬

122
00:08:41,020 --> 00:08:43,560
‫- "تومويو"...‬
‫- رائعاً جداً.‬

123
00:08:44,020 --> 00:08:48,020
‫- صباح الخير!‬
‫- صباح الخير!‬

124
00:08:48,360 --> 00:08:50,230
‫شكراً على الرسالة.‬

125
00:08:50,650 --> 00:08:52,030
‫هل وصلك ردي؟‬

126
00:08:52,360 --> 00:08:54,030
‫أجل، وصلني الرد من الجميع.‬

127
00:08:54,860 --> 00:08:55,860
‫أجل،‬

128
00:08:56,110 --> 00:08:58,950
‫وصلتني رسالة من الآنسة "ميزوكي" أيضاً.‬

129
00:08:59,030 --> 00:09:01,040
‫أجابت، "أنت أيضاً."‬

130
00:09:02,040 --> 00:09:03,960
‫هل هي بخير؟‬

131
00:09:04,210 --> 00:09:07,040
‫أجل، قالت إنها تجتهد في "إنكلترا". ‬

132
00:09:09,040 --> 00:09:10,960
‫هل تعلمين من هو معلم الصف‬

133
00:09:11,050 --> 00:09:12,050
‫للفصل الثاني؟‬

134
00:09:12,340 --> 00:09:14,050
‫بعد التفكير بالأمر، من سيكون؟‬

135
00:09:14,470 --> 00:09:16,050
‫"تومويو"، هل تعرفين؟‬

136
00:09:17,050 --> 00:09:19,050
‫أجل، رأيت معلم الصف للتو.‬

137
00:09:19,140 --> 00:09:22,390
‫- من هو؟‬
‫- وصل المعلم.‬

138
00:09:24,180 --> 00:09:25,190
‫اجلسوا في مقاعدكم!‬

139
00:09:26,060 --> 00:09:27,150
‫إنه السيد "تيرادا"!‬

140
00:09:32,400 --> 00:09:33,320
‫إذاً...‬

141
00:09:33,900 --> 00:09:36,070
‫انتهت عطلة الصيف البارحة،‬

142
00:09:37,160 --> 00:09:39,070
‫هل أحضر الجميع واجباته المدرسية؟‬

143
00:09:39,160 --> 00:09:40,280
‫أجل!‬

144
00:09:42,080 --> 00:09:45,000
‫اليوم سأعرفكم على تلميذ جديد‬

145
00:09:45,080 --> 00:09:46,670
‫سيدرس معنا.‬

146
00:09:47,500 --> 00:09:48,830
‫تفضل.‬

147
00:10:05,730 --> 00:10:07,520
‫يبدو لطيفاً.‬

148
00:10:18,910 --> 00:10:20,490
‫هذا "إريول هيراغيزاوا"‬

149
00:10:21,120 --> 00:10:22,240
‫من "إنكلترا".‬

150
00:10:22,910 --> 00:10:24,120
‫أتمنى أن تتفقوا جيداً.‬

151
00:10:24,790 --> 00:10:26,120
‫أنا "إريول هيراغيزاوا".‬

152
00:10:26,710 --> 00:10:28,120
‫سرني لقاؤكم.‬

153
00:10:30,960 --> 00:10:32,130
‫مقعدك...لنر.‬

154
00:10:33,130 --> 00:10:34,000
‫وجدته.‬

155
00:10:34,840 --> 00:10:36,170
‫ما عن المقعد قرب "لي"؟‬

156
00:10:45,060 --> 00:10:46,060
‫مرحباً.‬

157
00:10:51,150 --> 00:10:52,150
‫ما هذا؟‬

158
00:10:52,400 --> 00:10:55,150
‫هل رأيته من قبل؟‬

159
00:11:03,080 --> 00:11:04,160
‫آنسة "كاهو"،‬

160
00:11:04,870 --> 00:11:07,950
‫هناك تلميذ جديد في الصف الخامس اليوم.‬

161
00:11:08,790 --> 00:11:11,880
‫إنه فتى يدعى "إريول هيراغيزاوا".‬

162
00:11:12,540 --> 00:11:13,840
‫يبدو لطيفاً.‬

163
00:11:14,800 --> 00:11:15,630
‫ولكن...‬

164
00:11:20,010 --> 00:11:22,470
‫لسبب ما، أشعر بأن هذه‬

165
00:11:22,890 --> 00:11:24,180
‫ليست أول مرة أراه فيها.‬

166
00:11:24,810 --> 00:11:25,760
‫وأنا أيضاً.‬

167
00:11:30,190 --> 00:11:31,520
‫"هيراغيزاوا"؟‬

168
00:11:32,230 --> 00:11:33,520
‫آسف إن كنت قد أخفتك.‬

169
00:11:37,980 --> 00:11:38,820
‫حمداً لله.‬

170
00:11:39,650 --> 00:11:41,660
‫هل تمانعي إن جلست بقربك؟‬

171
00:11:56,710 --> 00:11:58,670
‫أشعر نوعاً ما‬

172
00:11:58,760 --> 00:12:00,470
‫بأن هذا ليس لقاؤنا الأول.‬

173
00:12:00,630 --> 00:12:02,220
‫أمر غريب، أليس كذلك؟‬

174
00:12:07,220 --> 00:12:08,930
‫ربما التقينا من قبل.‬

175
00:12:14,020 --> 00:12:15,060
‫ربما التقينا من قبل‬

176
00:12:15,230 --> 00:12:16,770
‫في حياتنا السابقة.‬

177
00:12:25,570 --> 00:12:27,240
‫هلا قلت لي اسمك؟‬

178
00:12:28,240 --> 00:12:30,290
‫اسمي "ساكورا كينوموتو".‬

179
00:12:31,870 --> 00:12:33,250
‫يا له من اسم جميل، اسم زهرة‬

180
00:12:33,330 --> 00:12:34,620
‫تتفتح في الربيع.‬

181
00:12:36,590 --> 00:12:38,550
‫هل يمكنني مناداتك "ساكورا"؟‬

182
00:12:39,590 --> 00:12:41,590
‫أجل، "هيراغيزاوا".‬

183
00:12:44,550 --> 00:12:46,260
‫أرجوك، نايني "إريول"،‬

184
00:12:46,470 --> 00:12:47,300
‫"ساكورا".‬

185
00:12:57,270 --> 00:12:59,730
‫هذا أشبه بتطور واعد في‬

186
00:12:59,820 --> 00:13:00,780
‫قصة هزلية للفتيات.‬

187
00:13:02,240 --> 00:13:04,820
‫أن نراقب "ساكورا" بهذه الطريقة.‬

188
00:13:16,080 --> 00:13:18,080
‫"لي"، هل حدث أمر ما؟‬

189
00:13:18,830 --> 00:13:21,080
‫أنت متجهم طوال النهار.‬

190
00:13:21,790 --> 00:13:26,090
‫لدى "لي" أمر جديد يقلق بشأنه، لا؟‬

191
00:13:26,420 --> 00:13:28,510
‫ماذا؟ هذا ليس...‬

192
00:13:29,340 --> 00:13:32,760
‫إن أردت مساعدتي أعلمني بذلك.‬

193
00:13:33,640 --> 00:13:36,140
‫ساعدتني كثيراً‬

194
00:13:37,100 --> 00:13:38,600
‫عندما كنا نجمع بطاقات "كلو".‬

195
00:13:39,100 --> 00:13:41,770
‫هذه اليوم أريد أن أساعدك.‬

196
00:13:46,360 --> 00:13:47,570
‫ولكن‬

197
00:13:47,860 --> 00:13:49,780
‫ستعود إلى "هونغ كونغ" قريباً.‬

198
00:13:52,660 --> 00:13:53,660
‫لن أذهب الآن.‬

199
00:13:55,910 --> 00:13:57,120
‫سأبقى هنا.‬

200
00:13:57,620 --> 00:13:59,290
‫- حقاً؟‬
‫- أجل.‬

201
00:14:03,670 --> 00:14:05,130
‫فهمت الآن!‬

202
00:14:06,130 --> 00:14:07,290
‫حمداً لله.‬

203
00:14:12,680 --> 00:14:15,140
‫المثلجات هناك لذيذة جداً.‬

204
00:14:15,550 --> 00:14:16,640
‫سأشتري البعض منها.‬

205
00:14:24,730 --> 00:14:27,610
‫بما أن منافساً جديداً قد ظهر.‬

206
00:14:28,020 --> 00:14:29,280
‫إن عدت إلى "هونغ كونغ"،‬

207
00:14:29,360 --> 00:14:30,940
‫فهذا يعني أنك تتخلى عنها، لا؟‬

208
00:14:31,280 --> 00:14:33,150
‫قلت لك إن الأمر ليس كذلك!‬

209
00:14:35,030 --> 00:14:36,160
‫شكراً على الانتظار.‬

210
00:14:38,330 --> 00:14:40,040
‫تفضلا، "تومويو"، "لي".‬

211
00:14:40,290 --> 00:14:42,790
‫- شكراً جزيلاً.‬
‫- شكراً.‬

212
00:14:48,290 --> 00:14:49,880
‫أخي الكبير!‬

213
00:14:51,260 --> 00:14:52,460
‫لا تفعل هذا يا "تويا"!‬

214
00:14:53,220 --> 00:14:54,430
‫أتريد البعض يا "يوكي"؟‬

215
00:15:00,180 --> 00:15:02,100
‫سأشتري لك قطعة أخرى، حسناً؟‬

216
00:15:03,180 --> 00:15:05,190
‫لا بأس، لا داعي لذلك.‬

217
00:15:07,650 --> 00:15:08,900
‫ما الأمر يا أخي الكبير؟‬

218
00:15:10,190 --> 00:15:12,990
‫جاء تلميذ جديد إلى صفنا اليوم.‬

219
00:15:13,570 --> 00:15:14,740
‫ونحن أيضاً.‬

220
00:15:15,280 --> 00:15:16,990
‫ماذا عن الأمر؟‬

221
00:15:20,080 --> 00:15:23,500
‫"تويا"، كنت أبحث عنك!‬

222
00:15:31,840 --> 00:15:34,670
‫لا بد من أنك أخت "تويا" الصغرى!‬

223
00:15:35,220 --> 00:15:37,640
‫أجل، أنا "ساكورا كينوموتو".‬

224
00:15:38,140 --> 00:15:39,140
‫أنا "ناكورو".‬

225
00:15:39,600 --> 00:15:40,970
‫"ناكورو أكيزوكي."‬

226
00:15:47,060 --> 00:15:49,310
‫تماماً كما ظننت، أنت ظريفة جداً!‬

227
00:15:49,610 --> 00:15:51,900
‫مهلاً، لا تكوني...‬

228
00:15:58,240 --> 00:16:01,450
‫لاحقاً "تويا"، أراك غداً!‬

229
00:16:04,540 --> 00:16:07,540
‫- مثلجات.‬
‫- لقد أخذتها...‬

230
00:16:09,670 --> 00:16:12,210
‫- هل من خطب ما؟‬
‫- لا شيء.‬

231
00:16:12,710 --> 00:16:15,010
‫شكراً لك على المثلجات!‬

232
00:16:28,060 --> 00:16:28,980
‫إنها تمطر.‬

233
00:16:30,020 --> 00:16:31,860
‫لا! الغسيل!‬

234
00:16:39,030 --> 00:16:40,110
‫إنها السلة الأخيرة.‬

235
00:16:40,280 --> 00:16:41,280
‫اتركها هناك.‬

236
00:16:41,820 --> 00:16:43,280
‫سأضعها لاحقاً.‬

237
00:16:43,620 --> 00:16:44,450
‫شكراً لك.‬

238
00:16:44,990 --> 00:16:46,290
‫سأذهب إلى عملي الجزئي.‬

239
00:16:47,830 --> 00:16:49,290
‫عليك أن تعمل اليوم؟‬

240
00:16:49,370 --> 00:16:50,750
‫إنه مكتوب على اللوح.‬

241
00:16:51,380 --> 00:16:53,920
‫- ماذا عن العشاء إذاً؟‬
‫- لا، شكراً.‬

242
00:16:55,420 --> 00:16:57,340
‫لا، اشتريت طعاماً لثلاثة أشخاص.‬

243
00:16:59,680 --> 00:17:00,930
‫تلميذ جديد؟‬

244
00:17:01,340 --> 00:17:03,300
‫أي نوع من الأشخاص هو؟‬

245
00:17:03,720 --> 00:17:05,970
‫اسمه "إريول هيراغيزاوا".‬

246
00:17:06,140 --> 00:17:09,100
‫"إريول"، أي حرف يستخدم لاسمه؟‬

247
00:17:09,690 --> 00:17:13,190
‫ليس حرفاً بل "إريول".‬

248
00:17:14,020 --> 00:17:16,730
‫- إنه من "إنكلترا".‬
‫- "إنكلترا"؟‬

249
00:17:17,690 --> 00:17:18,690
‫لا!‬

250
00:17:21,910 --> 00:17:22,740
‫"انتهت اللعبة"‬

251
00:17:25,410 --> 00:17:28,040
‫إذا، أي حرف هذا؟‬

252
00:17:28,580 --> 00:17:30,040
‫انس الأمر.‬

253
00:17:30,370 --> 00:17:32,670
‫أنت لا تصغي لما أٌقوله.‬

254
00:17:40,970 --> 00:17:42,930
‫والآن حال الطقس المحلي.‬

255
00:17:46,810 --> 00:17:48,720
‫يا له من مطر شديد.‬

256
00:17:49,310 --> 00:17:51,640
‫وكان الجو مشمساً في العصر.‬

257
00:17:56,820 --> 00:17:57,650
‫ماذا؟‬

258
00:18:00,780 --> 00:18:02,650
‫ماذا في ذلك الجارور؟‬

259
00:18:03,700 --> 00:18:05,370
‫كتاب بطاقات "كلو"!‬

260
00:18:09,370 --> 00:18:10,200
‫ماذا؟‬

261
00:18:19,880 --> 00:18:20,840
‫"كيرو"!‬

262
00:18:29,850 --> 00:18:31,390
‫ربما أزعجك‬

263
00:18:31,560 --> 00:18:33,810
‫من الآن وصاعداً‬

264
00:18:34,440 --> 00:18:35,810
‫ولكن إن كنت أنت،‬

265
00:18:35,980 --> 00:18:37,440
‫سيكون الأمر بخير حتماً.‬

266
00:18:39,400 --> 00:18:40,400
‫هذا الصوت...‬

267
00:18:42,400 --> 00:18:43,700
‫أهو صوت "كلو"؟‬

268
00:18:51,750 --> 00:18:52,580
‫"ساكورا"!‬

269
00:18:52,870 --> 00:18:53,710
‫"كيرو"...‬

270
00:18:54,290 --> 00:18:56,630
‫جاء صوت "كلو" من الكتاب.‬

271
00:18:57,130 --> 00:18:58,420
‫صوت "كلو"؟‬

272
00:19:00,590 --> 00:19:01,460
‫ما هذا؟‬

273
00:19:02,260 --> 00:19:04,880
‫"ساكورا"؟‬

274
00:19:05,880 --> 00:19:07,010
‫اسمي؟‬

275
00:19:07,180 --> 00:19:09,180
‫"ساكورا"‬

276
00:19:10,140 --> 00:19:11,310
‫ما معنى ذلك؟‬

277
00:19:19,190 --> 00:19:20,860
‫"كيرو"، هل شعرت بهذا الآن؟‬

278
00:19:22,150 --> 00:19:23,150
‫أجل، شعرت به أيضاً.‬

279
00:19:23,820 --> 00:19:24,990
‫ما هذه الهالة؟‬

280
00:19:26,410 --> 00:19:28,370
‫المطر في "تومويدا"‬

281
00:19:28,450 --> 00:19:29,740
‫سيستمر بالهطول.‬

282
00:19:30,450 --> 00:19:34,000
‫المطر محصور في منطقة محددة‬
‫والمناطق المحيطة غائمة.‬

283
00:19:34,450 --> 00:19:35,830
‫مناطق أخرى‬

284
00:19:36,000 --> 00:19:37,880
‫ستسطع فيها الشمس ليوم آخر.‬

285
00:19:39,710 --> 00:19:42,460
‫هذا ليس مطراً طبيعياً.‬

286
00:19:52,390 --> 00:19:53,850
‫لماذا هذا؟‬

287
00:19:54,600 --> 00:19:56,690
‫مطر غامض في "تومويدا"!‬

288
00:19:57,100 --> 00:20:00,480
‫وهذا أيضاً نداء "كارد كابتور"، لا؟‬

289
00:20:03,360 --> 00:20:05,490
‫لم أفعل هذا منذ فترة طويلة!‬

290
00:20:10,120 --> 00:20:11,120
‫"كيرو"؟‬

291
00:20:11,780 --> 00:20:12,700
‫انتبهي.‬

292
00:20:13,120 --> 00:20:15,200
‫أشعر بهالة قوية.‬

293
00:20:18,960 --> 00:20:22,130
‫ولكن تم جمع بطاقات "كلو" كلها.‬

294
00:20:39,650 --> 00:20:40,650
‫ما هذا؟‬

295
00:20:52,030 --> 00:20:54,740
‫- "كيرو"! سأترك لك "تومويو"!‬
‫- حسناً!‬

296
00:21:01,670 --> 00:21:02,500
‫"ساكورا"!‬

297
00:21:19,390 --> 00:21:21,060
‫"ساكورا"! لماذا تلعبين؟‬

298
00:21:21,350 --> 00:21:22,190
‫استخدمي السحر!‬

299
00:21:30,280 --> 00:21:32,200
‫أيها المفتاح الذي يخفي قوى الظلام،‬

300
00:21:32,990 --> 00:21:35,200
‫اكشف عن الحقيقة أمامي.‬

301
00:21:36,120 --> 00:21:38,330
‫أنا "ساكورا"، أمرك بموجب العقد.‬

302
00:21:39,040 --> 00:21:40,870
‫أطلق!‬

303
00:21:46,590 --> 00:21:47,630
‫أطلق!‬

304
00:21:50,220 --> 00:21:51,050
‫أطلق!‬

305
00:21:55,140 --> 00:21:58,180
‫أطلق!‬

306
00:22:15,660 --> 00:22:16,660
‫لماذا؟‬

307
00:22:18,240 --> 00:22:19,160
‫احترسي!‬

308
00:22:24,250 --> 00:22:25,630
‫هل أنت بخير "ساكورا"؟‬

309
00:22:26,250 --> 00:22:27,630
‫"كيرو"، المفتاح...‬

310
00:22:33,260 --> 00:22:34,260
‫هذه الهالة...‬

311
00:22:35,390 --> 00:22:37,140
‫مستحيل، لا أصدق.‬

312
00:22:38,350 --> 00:22:39,180
‫ولكن...‬

313
00:22:39,930 --> 00:22:40,890
‫"ساكورا"!‬

314
00:22:42,520 --> 00:22:44,020
‫هل أنت بخير؟‬

315
00:22:45,690 --> 00:22:46,560
‫"ساكورا"...‬

316
00:22:47,690 --> 00:22:50,280
‫ادعي "يوكيتو" غداً.‬

317
00:22:51,280 --> 00:22:52,280
‫"يوكيتو"؟‬

318
00:22:52,650 --> 00:22:53,990
‫لماذا، "تسوكيشيرو"؟‬

319
00:22:54,860 --> 00:22:56,990
‫"يو" هو من أحتاج إلى التحدث إليه.‬

320
00:22:57,450 --> 00:22:58,370
‫"يو"...‬

321
00:22:59,240 --> 00:23:00,830
‫أريد التحقق من أمر معه.‬

322
00:23:01,950 --> 00:23:04,000
‫لماذا لا يتحول المفتاح الجديد إلى عصا؟‬

323
00:23:05,370 --> 00:23:06,250
‫و...‬

324
00:23:09,500 --> 00:23:10,460
‫هذا الوجود.‬

325
00:24:30,000 --> 00:24:32,000
‫"سابقاً"‬

326
00:24:32,630 --> 00:24:36,920
‫سيستمر المطر الغامض بالهطول في "تومويدا".‬

327
00:24:37,340 --> 00:24:38,880
‫هذا غريب فعلاً!‬

328
00:24:39,760 --> 00:24:44,430
‫أريد أن أفعل شيئاً ولكن المفتاح ‬
‫لا يتحول إلى عصا ولا يمكنني استخدام السحر.‬

329
00:24:44,970 --> 00:24:46,350
‫ماذا أفعل؟‬

330
00:24:46,980 --> 00:24:48,600
‫لاحقاً في "كارد كابتور ساكورا"،‬

331
00:24:48,980 --> 00:24:50,980
‫"(ساكورا) ومفتاح النجمة المستيقظ."‬

332
00:24:51,440 --> 00:24:53,400
‫في الحلقة القادمة مع "ساكورا"!‬

333
00:24:53,770 --> 00:24:55,190
‫أطلق!‬