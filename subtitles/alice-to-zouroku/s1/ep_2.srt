ووضعوا الكثير من الأشياء
.الصلبة على جسدي

221
00:14:14,800 --> 00:14:16,910
.واجهي الجانب الآخر الآن

222
00:14:18,140 --> 00:14:21,010
،لم أفهم الكلمات

223
00:14:21,010 --> 00:14:23,270
.ولكنّي لم أحتجها

224
00:14:23,690 --> 00:14:25,960
يمكنني الاندماج مع وعي الآخرين

225
00:14:25,960 --> 00:14:27,630
.وأصبح واحدةً معهم

226
00:14:28,860 --> 00:14:33,890
.الحدود بيني وبين الآخرين لم تكن واضحة

227
00:14:35,250 --> 00:14:36,270
،ولكن في أحد الأيّام

228
00:14:36,720 --> 00:14:39,220
.ظهرت اثنتان بدتا مشابهتين تمامًا

229
00:14:40,890 --> 00:14:45,090
.لذا حاولت أن أصبح واحدًا معهم كالعادة

230
00:14:47,660 --> 00:14:48,580
.لا يمكنك

231
00:14:49,950 --> 00:14:52,780
.أنتِ ونحن كائنان مختلفان

232
00:14:53,950 --> 00:14:55,370
.أنا هي أنا

233
00:14:55,370 --> 00:14:57,080
.وأنتِ هي أنتِ

234
00:14:57,890 --> 00:15:00,010
.أنا هي أنا

235
00:15:01,810 --> 00:15:06,170
كانت تلك المرّة هي التي
".تعلّمت فيها ما هي "اللغة

236
00:15:06,870 --> 00:15:08,890
أنتِ هي أنتِ؟

237
00:15:08,890 --> 00:15:10,010
.نعم

238
00:15:10,010 --> 00:15:12,480
ستتعلّمين أيضًا تمييز

239
00:15:12,480 --> 00:15:15,050
.الحدود بينك وبين الآخرين

240
00:15:15,770 --> 00:15:17,650
.أنا هيناغيري يوناغا

241
00:15:17,650 --> 00:15:19,170
.التوأم الصغرى

242
00:15:19,170 --> 00:15:22,060
.أنا هيناغيري أساهي، الكبرى

243
00:15:22,650 --> 00:15:24,220
ما اسمك؟

244
00:15:24,930 --> 00:15:25,900
.لا أعلم

245
00:15:26,230 --> 00:15:29,760
.سنعطيك اسمًا إذًا

246
00:15:29,760 --> 00:15:32,060
.فكّرنا بواحدٍ معًا

247
00:15:32,560 --> 00:15:35,920
.الملكة الحمراء تحب السمك

248
00:15:35,920 --> 00:15:37,730
.اسمك سانا إذًا

249
00:15:39,150 --> 00:15:40,340
...سانا

250
00:15:42,520 --> 00:15:45,550
.هكذا أصبحت سانا

251
00:15:46,540 --> 00:15:49,060
.علّمني التوأم أشياء عديدة

252
00:15:49,590 --> 00:15:52,300
.لغة وملابس أنثويّة وظريفة

253
00:15:52,300 --> 00:15:55,870
.العد، العديد من الأغاني، كتبًا مصوّرة، وقصائد

254
00:16:01,080 --> 00:16:04,110
.كنت سعيدة كلّ يوم هناك

255
00:16:09,550 --> 00:16:11,490
.ولكن رأيتها بعدها

256
00:16:14,140 --> 00:16:17,270
...في أسفل منشأة الأبحاث

257
00:16:19,240 --> 00:16:21,520
.فعلوا شيئًا لأحدهم هناك

258
00:16:21,790 --> 00:16:23,710
.وجعلوه شيئًا غير بشري

259
00:16:26,150 --> 00:16:28,310
...كنت خائفة للغاية

260
00:16:28,310 --> 00:16:30,750
!وهربت من المنشأة

261
00:16:30,750 --> 00:16:33,630
...ولكن العالم الخارجي كان مخيفًا أيضًا

262
00:16:34,060 --> 00:16:36,090
.لم أعرف شيئًا

263
00:16:36,090 --> 00:16:37,210
.كنت خائفة

264
00:16:48,770 --> 00:16:50,480
أتعلمين؟

265
00:16:50,480 --> 00:16:53,500
.أعتقد أنّنا متشابهتان

266
00:16:55,150 --> 00:16:57,300
.أنتِ وأنا

267
00:16:57,300 --> 00:16:58,520
أسماؤنا؟

268
00:17:00,270 --> 00:17:01,440
.لا بأس

269
00:17:02,000 --> 00:17:03,700
.سيكون الأمر على ما يرام

270
00:17:05,700 --> 00:17:08,370
.طريقة أكلك قذرة يا نايتو-سان

271
00:17:08,900 --> 00:17:11,380
!لا بأس! كنتُ أتضوّر جوعًا

272
00:17:11,380 --> 00:17:13,970
.لا توسخ المقعد

273
00:17:14,250 --> 00:17:16,960
!أنا من سيغضب عليه المدير

274
00:17:16,960 --> 00:17:19,800
.هيّا، لا تكوني شديدة الحساسيّة

275
00:17:19,800 --> 00:17:22,240
كم عمرك ثانيةً يا إتشيجو-كن؟

276
00:17:22,240 --> 00:17:23,440
.عمري 26

277
00:17:23,660 --> 00:17:24,690
مذهلّ حقًّا؟

278
00:17:24,690 --> 00:17:26,200
!إنّك يافعة

279
00:17:26,200 --> 00:17:28,130
.هذا تحرشٌ جنسي

280
00:17:28,130 --> 00:17:30,240
...ماذا؟ إطلاقًا

281
00:17:30,240 --> 00:17:33,280
حسنًا، هل سمعتِ بمجموعات
رقص تاكينوكو-زوكو من قبل؟

282
00:17:33,280 --> 00:17:35,400
.أعرف معنى الكلمة فحسب

283
00:17:35,400 --> 00:17:38,150
.آه، إنّك ذكيّة حقًّا

284
00:17:39,950 --> 00:17:43,950
حسنًا، كنت ما أزال تابعًا في
.المكتب الرئيسي في ذلك الوقت

285
00:17:44,510 --> 00:17:48,330
كانوا يجعلونني أعمل كضابط أمن في المناطق
.المخصّصة للمشاة فقط كلّ نهاية أسبوع

286
00:17:48,330 --> 00:17:53,740
وفي أحد المرّات، رأيت رجلًا ناضجًا
!يتشاجر مع أطفال غريبين

287
00:17:53,740 --> 00:17:56,080
".قلت "لا بدّ وأنّه غبي

288
00:17:56,080 --> 00:17:58,990
"!كان يصرخ "أكره الأمور الملتوية

289
00:17:59,890 --> 00:18:04,860
ومنذ ذلك الوقت، أصبحنا أصدقاءً
.لثلاثين سنة بطريقةٍ ما

290
00:18:04,860 --> 00:18:07,060
.ولكن مرّت خمس سنوات منذ آخر مرّة رأيته

291
00:18:07,720 --> 00:18:12,020
.هذه أوّل مرّة أسمعك تتحدّث عن صديق

292
00:18:12,020 --> 00:18:13,780
.لا بدّ وأنّكما قريبان

293
00:18:13,780 --> 00:18:15,360
.لا، على الإطلاق

294
00:18:15,360 --> 00:18:19,950
.إنّه عنيد، قديم الطراز، نحن عكس بعضنا تمامًا

295
00:18:19,950 --> 00:18:21,060
...انظري لهذا

296
00:18:23,120 --> 00:18:25,450
".مكتوبٌ أنّه "منسّق زهور

297
00:18:25,450 --> 00:18:27,880
.يبدو لي أنّكما مقرّبان بالفعل

298
00:18:31,320 --> 00:18:33,250
...كان هذا لذيذًا

299
00:18:35,400 --> 00:18:37,760
.لنذهب إلى منشأة الأبحاث يا ساناي

300
00:18:37,760 --> 00:18:38,950
ماذا؟

301
00:18:38,950 --> 00:18:41,960
أكلت الكثير من الطعام
!اللذيذ، لذا أنا بخير الآن

302
00:18:41,960 --> 00:18:43,720
.سأسحقها هذه المرّة

303
00:18:44,900 --> 00:18:45,880
...ولكن

304
00:18:45,880 --> 00:18:47,170
.لا تقلقي

305
00:18:47,170 --> 00:18:48,920
!أنتِ... صحيح

306
00:18:48,920 --> 00:18:51,170
!أحضري العديد من الحلويّات وتعالي معي

307
00:18:51,170 --> 00:18:53,950
بالمناسبة، أين ذهب زوروكو؟

308
00:18:53,950 --> 00:18:56,190
.أعتقد أنّه يعمل الآن

309
00:18:56,190 --> 00:18:57,920
يعمل؟ مع الورد؟

310
00:18:57,920 --> 00:18:58,700
!أعلم

311
00:18:59,190 --> 00:19:00,290
...مذهل

312
00:18:59,560 --> 00:19:01,020
!إنّه وغدٌ حقًّا لتركي

313
00:19:00,290 --> 00:19:03,940
،بعد كلّ هذا النوم والحلويّات
.أصبحت أكثر حيويّة

314
00:19:01,020 --> 00:19:03,820
!مع أنّه يفترض أن يكون خادمي

315
00:19:04,360 --> 00:19:05,020
ماذا؟

316
00:19:05,020 --> 00:19:07,290
...لا شيء، ولكن

317
00:19:07,290 --> 00:19:09,550
.انتظري قليلًا، حسنًا؟ عليّ التنظيف

318
00:19:09,550 --> 00:19:11,120
!حسنًا، لنذهب إليه

319
00:19:15,340 --> 00:19:17,720
!نحن نسقط! نحن نسقط

320
00:19:15,690 --> 00:19:17,270
ما هذا؟

321
00:19:17,270 --> 00:19:19,390
!لم أفعل هذا عن قصد! ليس عن قصد

322
00:19:19,860 --> 00:19:21,170
ما الذي يجري؟

323
00:19:20,480 --> 00:19:24,200
!النجدة! النجدة

324
00:19:32,380 --> 00:19:33,910
ما هذا؟

325
00:19:33,910 --> 00:19:35,290
!النجدة

326
00:19:40,530 --> 00:19:44,250
!يا للظرافة! بطاريق

327
00:19:44,250 --> 00:19:44,820
ماذا؟

328
00:19:44,820 --> 00:19:47,350
.إنّها بطاريق. بطاريق

329
00:19:47,350 --> 00:19:49,980
!مذهل! الجوّ باردٌ للغاية

330
00:19:49,980 --> 00:19:53,640
هل هذا القطب الجنوبي؟
.لم آتِ إلى هنا من قبل

331
00:19:55,900 --> 00:19:57,780
.وأنا أيضًا

332
00:19:59,210 --> 00:20:00,670
.مثلي

333
00:20:02,630 --> 00:20:04,230
.إنّه صغير

334
00:20:04,230 --> 00:20:05,980
.إنّه طفل

335
00:20:05,980 --> 00:20:07,710
أليس ظريفًا؟

336
00:20:08,080 --> 00:20:09,310
!إنّه ظريف

337
00:20:09,750 --> 00:20:11,910
...ظريفٌ للغاية

338
00:20:14,520 --> 00:20:15,980
...جاري الاتّصال
كاشيمورا ساناي

339
00:20:18,050 --> 00:20:20,940
أيّ أسطوانة ثانيةً أيّها الرئيس؟

340
00:20:25,170 --> 00:20:27,340
.إنّك مذهلة يا سانا-تشان

341
00:20:27,340 --> 00:20:29,120
أيمكنك الذهاب إلى أيّ مكان؟

342
00:20:29,120 --> 00:20:31,760
.نـ-نعم، يمكنني

343
00:20:31,760 --> 00:20:33,170
أين نذهب تاليًا؟

344
00:20:33,170 --> 00:20:35,880
ماذا عن المنزل؟

345
00:20:37,120 --> 00:20:41,200
.سيقلق جدّي إن اختفينا فجأة

346
00:20:41,830 --> 00:20:43,710
زوروكو سيغضب؟

347
00:20:43,710 --> 00:20:47,160
.لا، ولكنّه سيقلق

348
00:20:48,100 --> 00:20:49,220
حقًّا؟

349
00:20:49,520 --> 00:20:51,040
.نعم

350
00:20:51,040 --> 00:20:52,810
لنرجع إلى المنزل، حسنًا؟

351
00:20:54,500 --> 00:20:55,370
.حسنًا

352
00:20:58,520 --> 00:21:00,940
!سحقًا! نسيت

353
00:21:01,810 --> 00:21:02,830
ماذا؟

354
00:21:08,760 --> 00:21:10,190
!خنازير! يوجد خنازير هنا

355
00:21:11,540 --> 00:21:13,040
لمَ يوجد خنازير؟

356
00:21:13,040 --> 00:21:15,430
لأنّي أكلت لحم خنزير البارحة؟

357
00:21:23,560 --> 00:21:26,130
.أنا هنا يا روكو-سان

358
00:21:28,260 --> 00:21:29,360
!لن أعرف شيئًا بالبكاء

359
00:21:29,360 --> 00:21:32,050
...آ-آه، جدّي، كان هذا

360
00:21:33,500 --> 00:21:34,630
—كما قلت يا جدّي

361
00:21:34,630 --> 00:21:36,480
!إنّي أسألك ما الذي تقولينه

362
00:21:37,020 --> 00:21:38,480
.حسنًا، لنرجع

363
00:21:38,880 --> 00:21:40,670
.تماسك يا نايتو-سان

364
00:21:40,670 --> 00:21:41,980
.هذا عمل

365
00:23:15,860 --> 00:23:16,960
فجأة؟

366
00:23:16,960 --> 00:23:18,720
...ولكن لا يمكنني

367
00:23:21,240 --> 00:23:22,240
.نعم

368
00:23:22,240 --> 00:23:24,280
.سأرتب الاستعدادات حالًا

369
00:23:31,950 --> 00:23:34,410
.اتّصلي بميني سي

370
00:23:36,320 --> 00:23:37,380
.بطاقات