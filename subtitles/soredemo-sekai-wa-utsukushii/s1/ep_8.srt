1
00:00:02,140 --> 00:00:03,230
.نيكي

2
00:00:05,730 --> 00:00:06,690
.نيكي

3
00:00:08,420 --> 00:00:10,150
.انظري إليّ فقط

4
00:00:10,580 --> 00:00:12,060
هل تسمعينَني؟

5
00:00:13,040 --> 00:00:13,870
.هيّا

6
00:00:18,120 --> 00:00:19,050
!أيتها الحمقاء

7
00:00:19,050 --> 00:00:21,670
!كيفَ تجرؤينَ على استغلالِ تواضعي أمامكِ

8
00:00:21,670 --> 00:00:24,380
!ماذا؟ ومتى كنتَ متواضعًا؟

9
00:00:24,380 --> 00:00:27,170
!فعلتُ ذلك للتوّ! ألا تعترفين؟

10
00:00:27,170 --> 00:00:28,530
!لن أعترف

11
00:00:30,640 --> 00:00:31,960
.تبًّا

12
00:00:32,900 --> 00:00:36,300
...فعلتُ هذا لأنَّني اعتقدتُ بأنَّني قد أعرفُ منكِ ما حدثَ بدقةٍ أكبر

13
00:00:36,840 --> 00:00:37,630
!اكتفيتُ من هذا

14
00:00:38,050 --> 00:00:39,970
مـ... ماذا بك؟

15
00:00:40,740 --> 00:00:41,650
.أخبريني

16
00:00:41,650 --> 00:00:42,620
!أخبرُكَ ماذا؟

17
00:00:42,620 --> 00:00:44,750
!كلَّ ما فعلَهُ لكِ

18
00:00:44,750 --> 00:00:45,580
!ماذا؟

19
00:00:45,580 --> 00:00:47,390
وماذا ستفعل إن أخبرتُك؟

20
00:00:47,390 --> 00:00:51,600
!أليسَ واضحًا؟ سأفعلُ أكثر حتى مما يتطلبهُ الأمر

21
00:00:51,600 --> 00:00:53,750
.هل أنتَ غبيّ؟ لم يفعل أيَّ شيءٍ لي

22
00:00:53,750 --> 00:00:55,000
.لقد جعلني أستلقي فحسب

23
00:00:55,000 --> 00:00:56,110
!إذن قامَ بشيءٍ ما

24
00:00:56,570 --> 00:00:58,500
!هذا لأنَّهُ رأى فيكِ ثغرةً

25
00:00:58,500 --> 00:01:00,240
!ماذا؟! يكفي هذا

26
00:01:00,240 --> 00:01:03,240
!عندما يتعلَّقُ الأمر به، فإنَّكَ تتصرف بغرابة

27
00:01:04,670 --> 00:01:06,710
أينَ ذهبَ هدوءك المعتاد؟

28
00:01:11,740 --> 00:01:15,380
.انتهت الحفلة، سأعودُ إلى العمل

29
00:01:17,280 --> 00:01:20,640
.الهدوء؟ لا يمكنُني تحمّلُ هذا

30
00:01:21,300 --> 00:01:22,970
.بالنسبة له خاصّةً

31
00:01:23,860 --> 00:01:25,430
...إنَّكَ

32
00:01:25,860 --> 00:01:28,260
.خذي قسطًا من الراحةِ لفترة

33
00:01:38,080 --> 00:01:41,110
من منّا يحتاج للراحةِ بالضبط؟

34
00:01:42,100 --> 00:01:45,330
والآن، ما الذي عليَّ فعله؟

35
00:03:04,100 --> 00:03:06,010
.يمكنكما المغاردة الآن

36
00:03:06,010 --> 00:03:06,790
!حاضر

37
00:03:08,460 --> 00:03:09,970
هل أنتَ متأكدٌ من ذلك؟

38
00:03:10,620 --> 00:03:13,230
...حتى لو أبقيتُ الحرس وغلَّقتُ الباب

39
00:03:13,230 --> 00:03:15,130
.إذا أرادت الخروج بجديّة، فلن يوقفَها شيء

40
00:03:15,460 --> 00:03:16,750
.هذا صحيح

41
00:03:17,460 --> 00:03:19,170
على كلٍ، ماذا هناك؟

42
00:03:19,570 --> 00:03:22,950
.هنالكَ استدعاءٌ طارئٌ من مجلس الحكماء

43
00:03:23,520 --> 00:03:26,400
ما الذي يخطط لهُ أولئك العجائز؟

44
00:03:37,040 --> 00:03:40,000
.أعتقد أنَّهُ لن يأتي

45
00:03:40,000 --> 00:03:42,990
.ما باليدِ حيلة

46
00:03:43,520 --> 00:03:47,820
...أعتقدُ أنَّ الأميرة نيكي قد

47
00:03:48,160 --> 00:03:54,080
.لا تكن سخيفًا، لقد وضعنا العديد من الاحتمالات بما يخص الأميرة نيكي

48
00:03:54,080 --> 00:03:58,460
.بالنسبة لي... لديَّ بعض الاحتمالاتِ أيضًا

49
00:04:07,540 --> 00:04:09,100
أنت؟ ملك الشمس؟

50
00:04:09,840 --> 00:04:11,690
من قال هذا؟

51
00:04:11,690 --> 00:04:13,430
.الناسُ في القصر

52
00:04:14,780 --> 00:04:16,800
...لأنَّكَ تضغط على نفسكَ كثيرًا

53
00:04:16,800 --> 00:04:19,300
.ولم تُظهِر أبدًا ما في قلبك

54
00:04:19,300 --> 00:04:22,160
.أعتقد لأنَّ هذا ما يتوقعهُ منّي الجميع

55
00:04:22,160 --> 00:04:26,450
...أخذ الأمور بهذا المنظار مفيدٌ لي أيضًا، ولكن

56
00:04:26,960 --> 00:04:28,410
.إنَّني أختنق

57
00:04:29,710 --> 00:04:31,990
.أعتقدُ خلافَ ذلك

58
00:04:32,510 --> 00:04:33,550
ماذا؟

59
00:04:33,550 --> 00:04:37,710
.تبدو لي في هذا الأمر هادئ ومتحفّظ

60
00:04:38,820 --> 00:04:42,260
.أتصوّركَ شيئًا أكبر من هذا

61
00:04:48,280 --> 00:04:49,260
هل أنا مخطئة؟

62
00:04:54,120 --> 00:04:54,930
...كلا

63
00:04:55,680 --> 00:04:59,900
.لذلكَ يمكنُني التنفس بعمق، عندما أكونُ معكِ

64
00:05:01,010 --> 00:05:03,310
.يبدو العالم بألوان

65
00:05:06,700 --> 00:05:07,620
.شيلا

66
00:05:09,440 --> 00:05:12,670
.أنا... أحبّكِ

67
00:05:19,010 --> 00:05:23,710
،مضت فترة طويلة على هذا
...ولكنَّهُ ما يزالُ يسببُ لي مقدارًا من الألم في صدري

68
00:05:31,140 --> 00:05:33,510
.هيّا، من هنا

69
00:05:33,840 --> 00:05:34,970
!نيكي-تشان

70
00:05:34,970 --> 00:05:36,980
.صه! ابقَ هادئًا

71
00:05:37,320 --> 00:05:41,080
ما الذي أتى بكِ إلى هنا؟
وهل أنتِ من قطعَ هذه القضبان؟

72
00:05:41,080 --> 00:05:44,070
.أردتُ الحديث معكَ قليلًا، فلتخرج

73
00:05:45,130 --> 00:05:51,110
.لا تقلق، أعتقدُ أنَّني إن توسَّطتُ بينكما الآن، سيسمعُ منك

74
00:05:51,630 --> 00:05:55,640
.إذا كنتَ ما تزال قلقًا، يمكنُكَ العودةُ إلى هنا دومًا

75
00:05:55,640 --> 00:05:58,380
.كلّا، أعتقد بأنَّني سأتجاوز هذا

76
00:06:00,830 --> 00:06:01,700
...في المرّة القادمة

77
00:06:01,700 --> 00:06:04,610
.قد يقوم بحبسي طيلةَ حياتي، ولن أتمكن من المغادرة

78
00:06:04,610 --> 00:06:09,940
.لأنَّهُ يلقي بالناس في السجن، كالألعاب في صندوقها

79
00:06:09,940 --> 00:06:11,090
تدركينَ ذلك إذن؟

80
00:06:12,230 --> 00:06:14,430
!انظر يا باردو

81
00:06:15,210 --> 00:06:16,850
!يا له من قمرٍ جميل

82
00:06:18,880 --> 00:06:23,270
.كانَ مستترًا بالغيومِ قبل قليل، وكأنَّهُ ظهرَ ليراك

83
00:06:25,230 --> 00:06:27,110
.لا أريد رؤيته

84
00:06:27,520 --> 00:06:30,570
.رؤية القمر مؤلمةٌ جدًا بالنسبة لي

85
00:06:31,920 --> 00:06:32,910
.أعتذر

86
00:07:07,270 --> 00:07:09,610
كيف تشعر الآن؟ أفضل؟

87
00:07:13,920 --> 00:07:16,530
.هذا لطفٌ منكِ، شكرًا لكِ

88
00:07:18,300 --> 00:07:22,610
أخبرني، عودتكَ كانت... لأجل ليفي، صحيح؟

89
00:07:23,580 --> 00:07:25,580
...لقد عُدتَ للبلد الذي غادرته

90
00:07:25,580 --> 00:07:27,830
...عارفًا حجم المشاكل الممكن حدوثها

91
00:07:27,830 --> 00:07:30,290
...لكونِكَ كنتَ قلقًا بخصوص خطوبة ليفي

92
00:07:30,290 --> 00:07:32,610
.لأنَّكَ أردتَ معرفة حقيقة شعوري

93
00:07:33,660 --> 00:07:35,130
.لا يمكنُني مجاراتكِ

94
00:07:35,690 --> 00:07:40,060
...منذ أن كنّا صغارًا، أنا وليفي لم نكن مع بعض أبدًا

95
00:07:40,420 --> 00:07:42,960
.لولا أنَّنا أردنا حماية نفس الشخص

96
00:07:42,960 --> 00:07:45,020
...هل تعني والدة

97
00:07:46,060 --> 00:07:49,110
.المشاعر لم تكُن متبادلة بالطبع

98
00:07:50,820 --> 00:07:52,180
...شعرنا أنا وليفي

99
00:07:52,420 --> 00:07:55,200
.بنفس الألم، حيالَ عدم قدرتِنا على حماية الشخص الذي أردنا حمايته

100
00:07:55,620 --> 00:08:00,450
،بالرغم من ذلك، لطالما كانت وما تزال المسؤوليات على عاتقنا
.استطعنا نسيان ذلك الألم

101
00:08:01,120 --> 00:08:02,890
...بعد أن غزونا العالم

102
00:08:02,890 --> 00:08:06,200
.كنتُ الشخص الذي لم يستطِع مواجهة القادم

103
00:08:11,750 --> 00:08:15,880
.هربتُ... من ليفي ومن الذكريات

104
00:08:17,490 --> 00:08:22,220
.ولكن لسببٍ ما، عندما سمعتُ بأنَّهُ قابلَ أنثى، انتابَني الفضول

105
00:08:22,800 --> 00:08:25,250
...إذا ظهر بأنَّكِ مُخادعة، وأنثى تسعى للسلطة

106
00:08:25,250 --> 00:08:28,530
!اعتقدتُ بأنَّني عندها سأحصل على متعتي منكِ وأتسببُ بطردكِ

107
00:08:30,680 --> 00:08:31,900
...هذا ليسَ ممتعًا

108
00:08:32,500 --> 00:08:36,240
.لكنَّ مخاوفي تبددت، فلا تقلقي

109
00:08:39,300 --> 00:08:43,950
...بالرغم من صغر سنّه، لكنَّهُ ذو إرادةٍ صلبة

110
00:08:43,950 --> 00:08:48,500
.ولكنَّ الإرادة الصلبة هذه، يمكن أن تجعلَهُ أحيانًا متقلّبًا بشكلٍ خطير

111
00:08:49,130 --> 00:08:51,710
.أريدُ منكِ البقاء بجانبه ومساندته

112
00:08:52,130 --> 00:08:55,350
.سأعودُ لرحلتي من الآن

113
00:08:55,810 --> 00:08:56,800
!لماذا؟

114
00:08:57,180 --> 00:08:59,800
لِمَ لا تُحاول مواجهته؟

115
00:09:00,250 --> 00:09:05,350
!إذا كنتَ تدرك بأنَّهُ خطير، وتعرف ذلك، فعليكَ إذن البقاء معه

116
00:09:11,100 --> 00:09:13,630
.لن يسمحَ ليفي بذلك

117
00:09:29,910 --> 00:09:31,380
!نيكي-ساما

118
00:09:31,380 --> 00:09:33,070
أينَ كنتِ؟

119
00:09:33,070 --> 00:09:36,300
!اختفى باردو-ساما من زنزانته، والجميعُ في حالة ذعر

120
00:09:37,590 --> 00:09:38,690
نيكي-ساما؟

121
00:09:38,690 --> 00:09:40,390
.هذا ليس جيدًا

122
00:09:40,390 --> 00:09:44,720
...أعلمُ أنَّ هذا ليسَ من شأني، لكنَّني لا أستطيع

123
00:09:46,160 --> 00:09:47,350
.لا يمكنُني قبول ذلك

124
00:09:47,910 --> 00:09:48,390
...نيكي-ساما

125
00:09:48,390 --> 00:09:50,060
.ساعدني يا نيل

126
00:09:51,210 --> 00:09:55,280
!سأجعلُ رؤوس هذين العنيدين الأحمقينِ مُتفتحين

127
00:10:00,760 --> 00:10:03,700
.لا يمكنُني مسامحة هذا العالم

128
00:10:04,070 --> 00:10:06,980
.ما يزال يدور وكأنَّ شيئًا لم يتغير

129
00:10:07,480 --> 00:10:09,600
.بالرغم من اختفاء شيلا

130
00:10:10,120 --> 00:10:14,040
.من المحتمل أن يبتلعني ويدمرني في المرة القادمة

131
00:10:14,350 --> 00:10:15,750
.كفى عبثًا معي

132
00:10:16,690 --> 00:10:21,240
!إذا شاء القدر على قتلي، فسأحكم قبضتي على القدر

133
00:10:21,240 --> 00:10:24,720
!لا شيء... لا أحد... سيلعب معي مرةً أخرى

134
00:10:26,410 --> 00:10:28,310
!تحالف معي يا باردوين

135
00:10:30,080 --> 00:10:31,770
...في عالمنا

136
00:10:34,080 --> 00:10:36,480
.لن تشرق الشمسُ ثانيةً

137
00:10:47,590 --> 00:10:49,860
...ذلك الحلم يعيد لي الذكريات بلا شكّ

138
00:10:50,410 --> 00:10:54,160
.أعتقدُ أنَّها المرة الوحيدةُ التي رأيتُهُ يبكي فيها

139
00:10:54,900 --> 00:10:56,190
هل أيقضتُك؟

140
00:10:57,920 --> 00:10:59,750
ستذهبين؟

141
00:10:59,750 --> 00:11:05,020
.بالطبع، فالصباح هو أكثر وقتٍ ينشغلُ فيه صاحبُ النُزُل

142
00:11:05,020 --> 00:11:06,510
.يا للأسف

143
00:11:06,510 --> 00:11:10,570
.جميلٌ منك هذا الكلام، إنَّهم يتكلَّمونَ عنك

144
00:11:10,990 --> 00:11:12,670
...يقولون بأنَّكَ تعدَّيتَ على الأميرة نيكي

145
00:11:12,670 --> 00:11:14,480
.وأثرتَ غضب جلالته

146
00:11:15,980 --> 00:11:22,650
.لذلك... أود أن تكوني أكثرَ كرمًا وتريحيني

147
00:11:23,670 --> 00:11:25,620
.اذهب إلى الجحيم

148
00:11:25,620 --> 00:11:26,900
!أختي

149
00:11:28,940 --> 00:11:29,920
!ما الأمر؟

150
00:11:29,920 --> 00:11:34,210
.هنالك زائرٌ على عجلة من أمره، يريدُ هذا الرجل المنحرف

151
00:11:37,100 --> 00:11:40,370
...أعتذر، علينا أن نتحدَّث

152
00:11:40,370 --> 00:11:41,760
.يا باردو-ساما

153
00:11:44,640 --> 00:11:46,300
أقابلكِ؟

154
00:11:46,300 --> 00:11:49,840
.أ... أرغبُ بمقابلتكَ في الخارج، الآن

155
00:11:49,840 --> 00:11:52,270
!كالأزواج في المدينة

156
00:11:52,580 --> 00:11:54,970
وعليَّ القيامُ بذلك الآن؟

157
00:11:54,970 --> 00:11:58,480
هل تعتقدينَ أنَّكِ في موقفٍ يسمحُ لكِ بطلبِ شيءٍ منّي الآن؟

158
00:11:58,480 --> 00:11:59,940
ماذا تقصد؟

159
00:12:00,500 --> 00:12:04,070
أتساءل، من الذي هرَّبَ باردو من سجنه؟

160
00:12:04,070 --> 00:12:05,050
.تبًّا

161
00:12:05,400 --> 00:12:09,590
.يبدو وكأنَّهُ شيءٌ وحشي شبيه بالمرّةِ التي كسرَ فيها شخصٌ ما قضبان سجنه

162
00:12:10,000 --> 00:12:12,500
.حسنًا، لا تهتمّي، سأتغاضى عن الأمر

163
00:12:13,140 --> 00:12:15,670
.لا أهتمّ بما يحدث لشخصٍ عندما يذهب

164
00:12:16,310 --> 00:12:19,750
ذلك يعني أنَّكَ لستَ نادمًا على ذلك؟

165
00:12:20,210 --> 00:12:21,210
...نيكي

166
00:12:21,690 --> 00:12:23,670
...المقصورة التي في الحديقة الواقعة خلف القصر

167
00:12:24,150 --> 00:12:25,190
.سأنتظركَ هناك

168
00:12:33,060 --> 00:12:36,660
نيكي هذه، لماذا تريدُ مقابلتي هكذا فجأة؟

169
00:12:37,480 --> 00:12:40,890
ذلك يعني أنَّكَ لستَ نادمًا على ذلك؟

170
00:12:43,850 --> 00:12:46,190
لماذا أندمُ على شيء؟

171
00:12:51,600 --> 00:12:53,120
...إنَّها

172
00:12:59,090 --> 00:13:03,910
...نيكي! دعوتِني لهذا المكان، ما الذي تحاولينَ

173
00:13:13,470 --> 00:13:16,600
!نيكي-ساما! لقد دخلَ جلالتهُ للتو

174
00:13:17,410 --> 00:13:19,940
!يا إلهي! إنَّهُ غاضبٌ جدًا، سيغادر

175
00:13:20,340 --> 00:13:21,840
!أكثري من كميّة المطر

176
00:13:23,030 --> 00:13:25,680
!أجل، هكذا! هكذا

177
00:13:31,970 --> 00:13:35,630
ماذا؟ ألم تجلِب معطفَك؟

178
00:13:37,600 --> 00:13:38,340
.خذ

179
00:13:38,340 --> 00:13:39,760
!لا أريد

180
00:13:39,760 --> 00:13:41,770
!لا أحتاجُ منكَ شيئًا

181
00:13:41,770 --> 00:13:45,340
.إذا لم تلبسه، سأحضنُكَ من الخلف وأدفئك

182
00:13:50,220 --> 00:13:51,340
ماذا؟

183
00:13:51,660 --> 00:13:57,680
عذرًا، كانت مزحة، هل هذه أولَ مرةٍ أمازحكَ فيها؟

184
00:13:59,310 --> 00:14:00,880
من يعلم؟

185
00:14:01,360 --> 00:14:03,770
.لن أقتربَ من شخصٍ يتركني

186
00:14:04,290 --> 00:14:06,670
كيفَ يمكنُني تبادل المزاح بالحديث معك؟

187
00:14:11,810 --> 00:14:15,600
هذا هو المطر إذن، هذه هي قوَّتُها؟

188
00:14:16,240 --> 00:14:19,040
لِمَ لا تُحاول مواجهته؟

189
00:14:19,540 --> 00:14:21,840
إنَّها تمنحني الفرصة لذلك؟

190
00:14:22,900 --> 00:14:26,050
.إذن، لنتحدَّث عن الأمور التي ليست مزاحًا

191
00:14:27,980 --> 00:14:31,400
...منذ مقتلِ شيلا وأنا أفكّر

192
00:14:32,100 --> 00:14:34,700
"ما هي أفضل طريقةٍ لحمايتك؟"

193
00:14:37,170 --> 00:14:41,230
.أوثقُ جوابٍ تمكنتُ من الوصول إليه، هو بالتنازلِ لكَ عن العرش

194
00:14:41,670 --> 00:14:45,870
.لحسن الحظ، لم أكُن طموحًا وكنتُ ذا مكانةٍ مرموقة

195
00:14:46,410 --> 00:14:48,940
.إضافةً إلى أنَّك أردتَ العرشَ للانتقام

196
00:14:49,680 --> 00:14:53,300
...أعتقدُ أنه من المحزنِ قليلًا، تعشيقُ اثنينِ من المسنناتِ بصورةٍ سيئة

197
00:14:53,300 --> 00:14:55,160
...لكي تجتمع سويةً، للمرة الأولى

198
00:14:55,960 --> 00:14:57,840
...أيّ شخصٍ نراه كعدوّ، نقاتلهُ بلا تمييز

199
00:14:57,840 --> 00:14:59,510
.سواءٌ من داخل البلد أو خارجها

200
00:14:59,510 --> 00:15:03,170
.حتى بعدمِ وجود أعداء قريبين، لم يتوقَّف الأمر

201
00:15:03,170 --> 00:15:06,360
!إرسال القوّات إلى أقاليم الحكم الذاتيّ؟

202
00:15:06,360 --> 00:15:08,220
!ولكن لدينا معهم معاهدة سلام

203
00:15:08,220 --> 00:15:11,380
.لديهم بشكلٍ سري عددٌ كبير من القوات هناك

204
00:15:11,380 --> 00:15:13,350
!لم يتم تأكيد هذه المعلومات

205
00:15:13,350 --> 00:15:14,760
!اخرس

206
00:15:16,550 --> 00:15:20,400
...في مرحلةٍ ما، أصبحتَ الطفل المُحطَّم الذي

207
00:15:20,400 --> 00:15:22,520
.لا يمكنُهُ حتّى رؤية الجمال في الأزهار

208
00:15:23,070 --> 00:15:26,510
.لا أريدُ أعذارًا، سأسحقُهم جميعًا

209
00:15:27,590 --> 00:15:29,770
...اعتقدتُ بأنَّك طالما أردتَ العيش

210
00:15:29,770 --> 00:15:32,870
.عليَّ أن لا أهتمّ بتغذيتكَ للكراهيةِ للقيام بذلك

211
00:15:33,570 --> 00:15:36,620
.تلكَ هي الطريقة التي قصدتُها لحمايتك

212
00:15:37,390 --> 00:15:39,270
.لكنَّني كنتُ مخطئًا

213
00:15:39,270 --> 00:15:42,590
لذا خفتَ وهربتَ، أليسَ كذلك؟

214
00:15:42,590 --> 00:15:45,830
.هذا صحيح، ولكن هنالكَ سببٌ آخر أيضًا

215
00:15:45,830 --> 00:15:48,840
.الارتحال كان مغامرةً

216
00:15:50,520 --> 00:15:54,860
.لرؤية فيما إذا كانَ العالم الذي عاشت فيه شيلا، ليسَ الحزن فقط

217
00:15:55,630 --> 00:15:58,800
.أردتُ استعادة ذاتي

218
00:16:01,990 --> 00:16:03,770
.هذا ليسَ ممتعًا جدًا

219
00:16:03,770 --> 00:16:08,700
.هذا صحيح، ربّما يجب علينا التوقف عن الحديث عن الماضي

220
00:16:08,700 --> 00:16:12,090
.لم تتحدث أبدًا عن الشيء الأهم

221
00:16:12,090 --> 00:16:12,990
...ليفي

222
00:16:12,990 --> 00:16:18,700
.ما تحاول قوله "كلّ شيء كانَ من أجلك"، لا تمزح معي

223
00:16:19,200 --> 00:16:23,790
.أنت لم تدرك أبدًا ما شعرتُ به بعد مغادرتك

224
00:16:24,930 --> 00:16:27,030
...ليفي؟ أنا

225
00:16:28,250 --> 00:16:29,310
.باردو

226
00:16:31,200 --> 00:16:33,190
.توقَّفَ المطر عن الهطول

227
00:16:35,590 --> 00:16:38,560
.كلا، لقد عادَ للهطول فجأة

228
00:16:38,560 --> 00:16:39,930
ما الذي يجري؟

229
00:16:40,930 --> 00:16:43,640
كم من الوقتِ مضى لنا ونحنُ هنا؟

230
00:16:44,200 --> 00:16:46,590
أعتقد أنَّها بحدود ساعة؟

231
00:16:47,010 --> 00:16:50,620
لقد جعلَتْ المطر يهطل كلَّ هذه المدة، أليسَ كذلك؟

232
00:16:56,410 --> 00:16:57,500
!اتبع صوت الأغنية

233
00:16:57,500 --> 00:16:58,740
!بأي اتجاه؟

234
00:16:58,740 --> 00:16:59,990
!إنَّهُ يختفي

235
00:17:03,990 --> 00:17:06,420
.لقد ذبُلَتْ

236
00:17:09,360 --> 00:17:11,680
.استدعي سيد الأطباء يا نيل

237
00:17:11,680 --> 00:17:12,400
.حاضر

238
00:17:12,870 --> 00:17:16,090
لا تقلقي، هل تستطيعينَ الوقوف يا نيكي؟

239
00:17:19,310 --> 00:17:20,090
أخبرتَه؟...

240
00:17:21,300 --> 00:17:23,420
.ماذا؟ لا اسمعُكِ

241
00:17:23,420 --> 00:17:28,650
هل... أخبرتَهُ عن شعورك؟

242
00:17:30,270 --> 00:17:34,420
...ما زلتَ... قادرًا على التواصل معه

243
00:17:35,420 --> 00:17:40,310
.إذا كانَ يؤلمكَ فقدانه... الآن... كُن صادقًا

244
00:17:51,740 --> 00:17:52,590
.باردو

245
00:17:53,020 --> 00:17:54,550
.سأقولها هذه المرة فقط

246
00:17:56,230 --> 00:17:59,010
.إنَّني أعيد تعيينكَ كرئيسٍ للوزراء

247
00:17:59,800 --> 00:18:03,220
.ابقَ هنا واعمل معي ثانيةً

248
00:18:04,480 --> 00:18:07,060
.ابقَ هنا، من فضلك

249
00:18:11,810 --> 00:18:13,360
.طلباتكَ أوامر

250
00:18:15,530 --> 00:18:19,570
.مليكي، سأبني مرةً أخرى، العالم الذي تريده

251
00:18:20,930 --> 00:18:22,530
.معك

252
00:18:27,550 --> 00:18:28,350
!نيكي

253
00:18:30,170 --> 00:18:33,280
انظرا! لقد فعلتها نيكي-تشان، أليسَ كذلك؟

254
00:18:33,280 --> 00:18:36,780
ومن كان يشك بذلك؟

255
00:18:39,120 --> 00:18:44,490
.لا أرغبُ في الاعترافِ بهذا مع خبرتي بهذا العمر

256
00:18:53,460 --> 00:18:54,790
...ثقيلٌ جدًّا

257
00:19:10,950 --> 00:19:12,530
.دعيهِ ينام

258
00:19:12,530 --> 00:19:14,880
.كانَ بجانبكِ طيلةَ الوقت

259
00:19:15,540 --> 00:19:16,890
كيفَ تشعرين؟

260
00:19:16,890 --> 00:19:18,590
.أشعرُ بخيرٍ الآن

261
00:19:20,350 --> 00:19:21,740
!باردو-ساما

262
00:19:21,740 --> 00:19:22,950
.يا إلهي

263
00:19:23,450 --> 00:19:25,180
.شعبيتُكَ جيّدة كالعادة

264
00:19:25,570 --> 00:19:29,210
...أمضى كلَّ الوقتِ معكِ وأهمل عمله

265
00:19:29,210 --> 00:19:30,640
.لذا كانَ عليَّ انجازه بدلًا عنه

266
00:19:30,640 --> 00:19:33,950
.هذا هو رئيسُ وزرائنا

267
00:19:33,950 --> 00:19:36,480
.كلا، أنا رئيسُ وزراءٍ سيئ

268
00:19:36,480 --> 00:19:40,880
.عندما يخص الأمر ليفي، فكلّ ما أفعله هو الإساءة له والقيام بالأخطاء

269
00:19:43,330 --> 00:19:47,740
.ولكن بسبب ذلك، قامَ بمراجعة نفسه قليلًا

270
00:19:47,740 --> 00:19:49,430
.لم يكن خطأً

271
00:19:49,840 --> 00:19:51,180
.شكرًا لكِ

272
00:19:51,180 --> 00:19:53,500
.أنتِ فعلًا عظيمة

273
00:19:53,950 --> 00:19:55,350
ما مصدر هذا؟

274
00:19:56,960 --> 00:20:02,130
!ولكن، بجانبِ هذا كله، فأنتِ رائعة يا نيكي-تشان

275
00:20:02,130 --> 00:20:04,660
أخبريني، هل لديكِ أيّ اهتمامٍ بالرجال الأكبر سنًّا؟

276
00:20:04,660 --> 00:20:07,500
!أعتقدُ بأنَّني سأنفردُ بغرامكِ

277
00:20:08,430 --> 00:20:11,340
أنتَ تريدُ الموت حقًّا، أليسَ كذلك؟

278
00:20:11,340 --> 00:20:15,470
!إذا كنتَ تحب الفتيات كثيرًا، فانظر لوجهِكَ في المرآة أيُّها البنّوتي

279
00:20:18,360 --> 00:20:21,050
...تمَّ إعادة تعييني كرئيس وزراء الآن

280
00:20:21,050 --> 00:20:23,870
!عليكَ مراقبة فمكَ الوقح ذاك

281
00:20:23,870 --> 00:20:25,780
ماذا؟ هل تريدُ المشاجرة؟

282
00:20:25,780 --> 00:20:28,370
!خطأُ من هذا برأيكَ كوني أعزب لحد الآن؟

283
00:20:25,970 --> 00:20:27,570
...اهدئا

284
00:20:28,370 --> 00:20:32,040
!هل يسوؤك لهذا الحدّ، أنَّ فتاتُكَ لا تُشبه شيلا؟

285
00:20:31,110 --> 00:20:34,460
...أنتما... أنهيا كلَّ هذا

286
00:20:32,040 --> 00:20:34,460
!لا تتفوه بالتفاهات

287
00:20:34,460 --> 00:20:37,960
!من الأفضلِ عليكما دفعَ ثمن جهدي

288
00:20:38,670 --> 00:20:40,290
...حتّى لو تشاجرتم

289
00:20:40,290 --> 00:20:44,530
.رُبما تحاولون تخطي الامر، مؤمنين بما يُخفيه القدر

290
00:20:44,530 --> 00:20:49,790
.ربّما يأتي الفجر بعد ليلةٍ طويلة، طويلة جدًا، معلنًا عن شروقِ النهار

291
00:20:55,730 --> 00:20:59,700
.لن أستسلمَ أبدًا يا نيكي

292
00:22:34,950 --> 00:22:49,970
استعراض

293
00:22:35,030 --> 00:22:37,200
.شكرًا لقدومك

294
00:22:37,200 --> 00:22:39,830
.هذه فرصة طيّبة، استمتع بإقامتك

295
00:22:43,540 --> 00:22:47,050
.هذا سيئ، النجوم وكلَّ شيء بغاية الجمال

296
00:22:47,710 --> 00:22:48,820
.هذا سيئ