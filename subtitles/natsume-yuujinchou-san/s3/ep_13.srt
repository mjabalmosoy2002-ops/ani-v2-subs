114
00:07:07,790 --> 00:07:08,450
.أعتقد ذلك

115
00:07:08,450 --> 00:07:09,140
.فهمت

116
00:07:09,140 --> 00:07:10,230
.أحسنت

117
00:07:10,820 --> 00:07:12,840
.سأقوم بإعداد التيمبورا اليوم

118
00:07:13,340 --> 00:07:14,720
