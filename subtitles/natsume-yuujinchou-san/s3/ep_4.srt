319
00:21:49,650 --> 00:21:51,030
.صديق قديم

320
00:21:51,030 --> 00:21:52,950
.لا أعلم إذا كان بإمكاني رؤيتهم

321
00:21:54,360 --> 00:21:55,640
.اذهب واستمتع

322
00:21:55,640 --> 00:21:56,960
.سوف نعود إلى المنزل

323
00:21:56,960 --> 00:21:57,920
.هذا صحيح

324
00:21:57,920 --> 00:21:59,010
.نراك لاحقاً

325
00:21:59,010 --> 00:22:00,140
!وداعا

326
00:22:03,010 --> 00:22:04,840
!مهلا، مهلاً

327
00:22:05,800 --> 00:22:07,250
!مع السلامة

328
00:22:07,250 --> 00:22:09,020
!وقتا ممتعا

329
00:22:09,020 --> 00:22:11,810
!مع السلامة

330
00:22:19,140 --> 00:22:20,570
.لقد فهمت الآن

331
00:22:21,390 --> 00:22:23,950
