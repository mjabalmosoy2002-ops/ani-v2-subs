186
00:12:57,690 --> 00:13:01,090
.كل ما عليّ هو صدها من الأعلى

187
00:13:01,450 --> 00:13:04,290
!السينبوكين... قد قُمعـت

188
00:13:04,680 --> 00:13:06,310
...السينبوكيــن قد

189
00:13:06,760 --> 00:13:08,480
...لا حيلة لي أمامه

190
00:13:12,780 --> 00:13:14,400
.هذه النهاية

191
00:13:14,400 --> 00:13:15,650
!يا للهول

192
00:13:16,110 --> 00:13:17,690
!تسوبـامي غـايشي

193
00:13:25,430 --> 00:13:27,540
...فات الأوان

194
00:13:35,540 --> 00:13:37,710
!ما كان ذلك؟

195
00:13:38,090 --> 00:13:39,670
!لـن تفــــــــــــرّ

196
00:13:39,670 --> 00:13:41,680
!!سحقًـــــــــــا

197
00:13:42,390 --> 00:13:44,850
!فـلتهلـــــــك

198
00:13:45,660 --> 00:13:47,530
!...إنّي لـمقتول

199
00:13:50,460 --> 00:13:51,560
-مـا

200
00:13:57,520 --> 00:14:00,320
!!يــــــايــــبــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــا

201
00:14:19,260 --> 00:14:20,230
هذا المكان...؟

202
00:14:20,230 --> 00:14:23,010
...يا ابن الـ
!من تكون؟

203
00:14:24,770 --> 00:14:29,480
!أتجاسرُ على هذه الجريمةِ وأنتَ تعلمُ أنَّ هذا الرجلَ هو السيد آيناغا، والي سيتسو؟

204
00:14:31,020 --> 00:14:34,240
!ايـن هـذا المكـان بحقٍّ؟

205
00:14:35,470 --> 00:14:37,460
!ما الّذي حدث لساياكا والبقيّة؟

206
00:14:37,460 --> 00:14:39,330
وماذا عن كوجيرو؟

207
00:14:39,330 --> 00:14:41,110
!ايـ- أيـن نحـن؟

208
00:14:41,950 --> 00:14:43,560
!كفـى! فلتقطعوه

209
00:14:43,560 --> 00:14:44,700
!حـاضر

210
00:14:45,720 --> 00:14:47,600
سيفٌ حقيقي...؟

211
00:14:47,600 --> 00:14:49,790
أتُراكم أتباع أونيمارو؟

212
00:14:53,190 --> 00:14:54,210
!ايّـاكم

213
00:14:56,870 --> 00:14:59,190
.لا يزال غلامًا

214
00:14:59,190 --> 00:15:01,630
اين فخر الساموراي الّذي لديكم؟

215
00:15:01,630 --> 00:15:04,170
!ايّها الوغد! هاتِ اسمك

216
00:15:05,110 --> 00:15:07,010
...رونين متشرّد من ساكوشو

217
00:15:08,760 --> 00:15:10,760
.ميـاموتـو موسـاشـي

218
00:15:11,290 --> 00:15:12,720
موساشي؟

219
00:15:12,720 --> 00:15:15,660
!مياموتو موساشي...؟

220
00:15:15,660 --> 00:15:20,020
!...ذاك المُبارز الأسطوريُّ الذي هزم المئات بمفرده

221
00:15:20,540 --> 00:15:23,070
.عظيمًا كنتُ أم لا، لستُ أدري

222
00:15:24,240 --> 00:15:26,780
.فينا إلي مكفينا

223
00:15:26,780 --> 00:15:29,250
!لـنتراجع

224
00:15:32,700 --> 00:15:33,870
...أأنت

225
00:15:34,380 --> 00:15:35,950
حقًّا موساشي؟

226
00:15:37,490 --> 00:15:40,540
أتعرفني؟

227
00:15:40,980 --> 00:15:43,210
...أعرفك حسن المعرفة

228
00:15:45,440 --> 00:15:48,470
!أ- أي عامٍ نحن فيه؟

229
00:15:48,870 --> 00:15:51,140
.السنة السابعة عشرة مِن عصر كييتشو

230
00:15:51,140 --> 00:15:53,230
!مـــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــاذا؟

231
00:15:53,230 --> 00:15:53,850
ما بك؟

232
00:15:54,560 --> 00:15:59,980
!بالمختصر، نحن عدنـا بالزمن إلى عصر إيدو أي قبل 400 سنةٍ

233
00:15:59,980 --> 00:16:02,360
!مـــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــاذا؟

234
00:16:03,710 --> 00:16:06,450
مهلًا... ماذا تقصد بعدنا بالزمن؟

235
00:16:07,780 --> 00:16:09,780
غوكونيجين، آوياما غونوسوكي

236
00:16:11,630 --> 00:16:12,490
...اذن

237
00:16:12,490 --> 00:16:15,530
تقول أنّكما أتيتما من المستقبل؟

238
00:16:15,530 --> 00:16:16,810
.وهو كذلك

239
00:16:16,810 --> 00:16:18,670
...هذا صعب التصديق

240
00:16:19,350 --> 00:16:23,200
كيف آل بنا الأمر في الماضي أصلًا؟

241
00:16:23,200 --> 00:16:25,690
،علينا الإسراع في العودة
...أو أنّهم

242
00:16:26,120 --> 00:16:31,760
.ذكر أونيمارو إنَّ سيفَ مونوهوشيزاو الشيطانيَّ يستطيع اختراق الزمان والمكان

243
00:16:32,130 --> 00:16:36,020
لابد أنَّ ذاك الرجل العنكبوت استخدم تلك القوة لفتح ثُقبٍ زمنيٍّ

244
00:16:36,020 --> 00:16:39,390
.فجلب كوجيرو إلى عصرنا

245
00:16:39,390 --> 00:16:43,390
...ونحن سُقنا في ذلك الثُّقب

246
00:16:43,390 --> 00:16:46,860
اذن كوجيرو لم يعد هنا؟

247
00:16:47,170 --> 00:16:49,070
.ما ذاك بصحيح

248
00:16:49,070 --> 00:16:53,080
.لديّ مبارزة مع كوجيرو بعد 7 أيّام

249
00:16:53,080 --> 00:16:54,630
سأغلبه وأظفر

250
00:16:54,630 --> 00:16:56,400
،بلقب أعظم ساموراي في اليابان

251
00:16:56,400 --> 00:16:57,240
—انـا مياموتو

252
00:16:57,240 --> 00:16:59,750
!لا أحسب موساشي شيئًا

253
00:17:00,790 --> 00:17:03,690
!ها هو عظيم اليابان كوجيرو هنا

254
00:17:03,690 --> 00:17:05,450
~كلّنا يقينٌ بذلك

255
00:17:05,450 --> 00:17:07,220
~أليـــــــس كذلـــــك؟

256
00:17:09,120 --> 00:17:11,000
...كـ- كوجيرو

257
00:17:13,250 --> 00:17:15,330
أليس ذاك كوجيرو؟

258
00:17:15,330 --> 00:17:17,810
!اذن ذلك الملتحي هو موساشي؟

259
00:17:18,300 --> 00:17:21,060
!سيبدأ سفك الدماء

260
00:17:21,060 --> 00:17:22,770
!مبــــارزة

261
00:17:31,570 --> 00:17:33,100
!القِ نظرة

262
00:17:35,030 --> 00:17:36,900
!اِ- إنتبهــــــــــــــــا

263
00:17:48,220 --> 00:17:50,970
!عجبًـا... تلك الخشبة تحولت إلى عيدان أكلٍ

264
00:17:50,970 --> 00:17:52,400
مياموتو موساشي - ساساكي كوجيرو
وقد نقشا اسميهما

265
00:17:52,400 --> 00:17:53,930
مياموتو موساشي - ساساكي كوجيرو
!عليها أيضًا

266
00:17:53,930 --> 00:17:56,700
...وعددها متساوٍ أيضًا
.عشر آلافٍ لكلٍّ منهما

267
00:17:56,700 --> 00:17:58,570
...تعادل

268
00:18:00,330 --> 00:18:02,670
.اراك تطورت يا موساشي

269
00:18:02,670 --> 00:18:03,850
.ذات الأمر أراه عليك

270
00:18:04,540 --> 00:18:07,940
.لـنطلق العنان حين نزالنا بعد 7 أيّامٍ

271
00:18:08,340 --> 00:18:09,740
.لا حاجة لإخباري

272
00:18:10,800 --> 00:18:12,340
.تحت شرف الساموراي

273
00:18:13,590 --> 00:18:15,660
!ثمّة كوجيرو هنا أيضًا

274
00:18:16,390 --> 00:18:21,150
.اذكر أنّ أونيمارو سبق وأن قال أنّ الجثمانُ لا يزالُ صالحًا

275
00:18:21,150 --> 00:18:25,570
.حين ظهر كوجيرو في الزمن الحاضر، كان قريبًا مِن قبره

276
00:18:26,880 --> 00:18:28,800
لعلَّ الرجل العنكبوت

277
00:18:28,800 --> 00:18:31,710
فتحَ الثُّقبَ الزمنيَّ عند النقطةِ ذاتِها التي مات فيها

278
00:18:31,710 --> 00:18:33,470
...فانتزعَ روحَهُ وحدَها

279
00:18:34,020 --> 00:18:39,430
...ثم حبسَها في الجثمانِ المُحنَّطِ داخل التابوت، وأعادَ إحياءَه

280
00:18:40,240 --> 00:18:43,760
ان صحّ هذا، فاندفاعُنا العنيفُ في الثُّقبِ قذفَ

281
00:18:43,760 --> 00:18:46,860
...بنا إلى ماضٍ أبعد

282
00:18:47,320 --> 00:18:48,980
،ان صحّ قولك

283
00:18:48,980 --> 00:18:52,020
.إذا هزمَ موساشي خصمَهُ مرَّةً أخرى، فربما ينفتحُ الثُّقبُ مِن جديد

284
00:18:52,020 --> 00:18:55,820
!عندها، سنعبرُهُ عائدينَ إلى ساياكا والآخرين

285
00:18:56,140 --> 00:18:58,970
!حســنٌ! انتظرنـي يـا كوجيرو

286
00:18:58,970 --> 00:19:03,580
من الآن إلى حينها سأصبح أقوى
!وسأهزمك فور عودتي

287
00:19:09,140 --> 00:19:10,930
!السيّـد موسـاشي

288
00:19:12,220 --> 00:19:13,840
أتُراكم ضيوفًا؟

289
00:19:14,260 --> 00:19:16,010
.اُدعى أوتسو

290
00:19:16,400 --> 00:19:17,720
وأنتما؟

291
00:19:20,200 --> 00:19:23,810
اذن تقول أنّكما لستما من هذا العصر؟

292
00:19:24,190 --> 00:19:25,290
.صحيح

293
00:19:25,290 --> 00:19:27,180
.هذا ما بان

294
00:19:28,700 --> 00:19:31,270
أدائمًا يتمرّن؟

295
00:19:31,620 --> 00:19:33,360
.نعم، كلّ يومٍ

296
00:19:33,360 --> 00:19:37,950
.ما مرّ يومٌ دون أن يحمل السيد موساشي سيفه

297
00:19:37,950 --> 00:19:42,370
.انّه جِدّ حـازمٍ
كيف آل به الأمر إلى ما عليه الآن؟

298
00:19:45,610 --> 00:19:49,460
.خلافًا لذلك، فهو يتدرّب تجهيزًا لمبارزته القادمة مع كوجيرو

299
00:19:49,870 --> 00:19:51,420
.فهمـت

300
00:19:52,630 --> 00:19:55,730
آل النصر لموساشي، صحيح؟

301
00:19:57,320 --> 00:19:58,650
!اقول يا موساشي

302
00:19:59,490 --> 00:20:03,240
لـكوجيرو تقنية رائعة، صحيح؟

303
00:20:03,240 --> 00:20:05,590
أتتحدّث على التسوبامي غايشي؟

304
00:20:06,340 --> 00:20:08,480
أبوسعك قهرها؟

305
00:20:09,220 --> 00:20:13,320
...تقنية تسوبامي غايشي
،اوّلًا، يضرب بسيفه من الأعلى

306
00:20:13,320 --> 00:20:16,800
فإذا تفاداها الخصم إذ به
.ينقضُّ عليه بضربةٍ خاطفةٍ من الأسفل

307
00:20:17,190 --> 00:20:21,450
،حركةٌ تُنجز في طرفة عين
.كَسُنونو يقلبُ جناحيهِ في الهواء

308
00:20:22,120 --> 00:20:24,430
.وكوجيرو متقنٌ لهـا

309
00:20:24,430 --> 00:20:27,780
،ان تلقيّتها
.ستشعرُ كأنما انقسمَ جسدُكَ إلى نصفين

310
00:20:28,300 --> 00:20:30,920
اذن كيف تنوي قمعها؟

311
00:20:32,210 --> 00:20:34,130
!عبر المضيّ بلا خشيةٍ

312
00:20:35,140 --> 00:20:37,110
.ذاك الدرب الحقّ للـنصر

313
00:20:37,110 --> 00:20:38,420
فقط؟

314
00:20:38,420 --> 00:20:39,470
.نعـم

315
00:20:39,910 --> 00:20:43,310
لكن لسيفه ميزة التمدّد، أليس كذلك؟

316
00:20:43,910 --> 00:20:47,840
،من يعتقد أنّ إصابة الخصم من بُعدٍ تعطيه الأفضليّة

317
00:20:47,840 --> 00:20:50,720
.فـهو ضعيـف الروح

318
00:20:51,120 --> 00:20:53,430
،أمّا اقترابك من عدوِّكَ في أي موقفٍ كان

319
00:20:53,430 --> 00:20:55,290
.يمنحكَ فرصةَ الانتصار

320
00:20:55,290 --> 00:20:56,610
،علاوةً

321
00:20:56,610 --> 00:21:00,300
...مَن يخطو إلى ساحةِ المُبارزةِ وهو يَستشعِرُ الهزيمةَ

322
00:21:00,300 --> 00:21:02,320
.ليسَ بِساموراي...

323
00:21:02,920 --> 00:21:04,700
ألست خائفًا؟

324
00:21:04,700 --> 00:21:07,380
...ان تسرّب الخوف إليّ

325
00:21:07,880 --> 00:21:10,530
.فذاكَ دليلُ نقصٍ في تدريبي

326
00:21:10,920 --> 00:21:15,260
.أدِمِ التدريب بإتقان، تَنمُ ثقتك في نفسك

327
00:21:15,260 --> 00:21:18,130
...وإذا نمَت سريتْ إلى سيفـك

328
00:21:18,660 --> 00:21:20,880
.فـتُنير دربـك إلى النصـر

329
00:21:22,450 --> 00:21:26,140
.رُكنـك الأهمّ هو الإيمـان بـحدّ سيفـك

330
00:21:27,880 --> 00:21:29,940
،واظب على التدريب كلّ يومٍ

331
00:21:29,940 --> 00:21:33,290
.حتّى يأتي اليوم الّذي تُدرك فيه

332
00:21:33,730 --> 00:21:37,570
اذن، ألك بالتدريب معي حتى يوم النزال؟

333
00:21:38,700 --> 00:21:40,580
!طبعًـا

334
00:21:41,010 --> 00:21:42,280
...اذن هيّـا

335
00:21:43,120 --> 00:21:44,450
!هـاجمنـي

336
00:21:53,440 --> 00:21:58,300
!في المبارزة، عليـك دائمًا بالمبادرة والهجوم

337
00:21:59,010 --> 00:22:01,830
،وللتتّخذ وضعيّةً للضرب

338
00:22:01,830 --> 00:22:04,210
.وسيفك سيتبع ذلك بدوره

339
00:22:08,200 --> 00:22:10,410
!لن تخونك تدريباتك أبدًا

340
00:22:10,770 --> 00:22:14,690
!فبتراكمها تنكشف قوّتك الحقيقيّة

341
00:22:19,260 --> 00:22:21,820
.حسنٌ، انتهينا لليوم

342
00:22:21,820 --> 00:22:24,110
إنتهينا بالفعل؟

343
00:22:24,910 --> 00:22:27,060
.لنا 6 أيّامٍ منذ بدأنا التمرين

344
00:22:27,060 --> 00:22:29,640
.غدًا يوم النزال الموعود

345
00:22:30,130 --> 00:22:33,730
.تلويحك بالسيف ليس نوع التمرين الوحيد

346
00:22:33,730 --> 00:22:37,090
...انا قلقةٌ إن كان بإمكان السيّد موساشي الفوز

347
00:22:37,440 --> 00:22:41,550
،لا حاجة للقلق
.فأنا أدري النتيجة

348
00:22:41,550 --> 00:22:43,480
يفوز موساشي عبر التأخّر عمدًا

349
00:22:43,480 --> 00:22:47,170
.إذا يجد كوجيرو مرخيًا دفاعه فينقضّ عليه

350
00:22:47,710 --> 00:22:50,980
!حاشا للسيّد موساشي أن ينحطّ لمكر الجبناء

351
00:22:51,770 --> 00:22:55,620
"لكنّه قال أنّها "استراتيجيّة مشروعة

352
00:22:55,620 --> 00:22:56,980
أليس كذلك يا موساشي؟

353
00:22:57,730 --> 00:23:00,800
انّ التأخّر عن النزال
!لعارٌ على الساموراي

354
00:23:00,800 --> 00:23:03,900
!ما كنت أنا موساشي أن أفعل شيئًا كهذا

355
00:23:04,750 --> 00:23:06,570
هل استوعبت؟

356
00:23:09,490 --> 00:23:13,050
،هذه مصيبة! إن آل الحدث بالتغيّر في التاريخ

357
00:23:13,050 --> 00:23:16,240
!فمآل النزال قد يتغيّر أيضًا

358
00:23:16,240 --> 00:23:18,810
...ان انتهى الأمر بخسارة موساشي

359
00:23:19,310 --> 00:23:22,840
...قد لا نعود إلى عصرنا

360
00:23:23,340 --> 00:23:24,710
...محال

361
00:23:25,170 --> 00:23:27,220
،ان صحّ قولك
،اذن ساياكا والبقيّة

362
00:23:28,320 --> 00:23:31,900
!ما الّذي سيحدث لهم؟

363
00:23:35,560 --> 00:23:40,270
!محال! أتقول إنّ يايبا قد عاد بالزمن؟

364
00:23:40,270 --> 00:23:42,480
!فلتعد بسرعة يا يايبـــا

365
00:23:42,480 --> 00:23:44,570
...ان استمرّ الوضع هكذا فجميعنا سـ

366
00:23:44,950 --> 00:23:47,050
"قادمًا، "معركة جزيرة غانريو

367
00:23:47,050 --> 00:23:47,910
!انّـه نزالٌ يـا كوجيرو