201
00:12:36,200 --> 00:12:39,240
...فليمدّ لي أحدٌ ما يد العون

202
00:12:40,030 --> 00:12:43,080
أجدّةٌ هي...؟

203
00:12:44,960 --> 00:12:47,500
...تمثّل عجوزًا إذن

204
00:12:48,460 --> 00:12:52,210
!قد يفلح الأمر مع ذلك

205
00:12:52,590 --> 00:12:55,050
!عليك بهـما يا سرعـوف

206
00:12:56,470 --> 00:12:58,720
ما بكِ يا جدّة؟

207
00:13:00,260 --> 00:13:02,810
.اصبت ساقي

208
00:13:03,430 --> 00:13:05,690
ألي بالاتكاء على كتفك...؟

209
00:13:05,890 --> 00:13:09,190
.كتفًا تقولين؟ لكنكِ جِدّ ضخمة

210
00:13:09,400 --> 00:13:12,030
!ويا لأعينٍ كبيرة تمتلكينها

211
00:13:12,360 --> 00:13:17,820
...حتى أستطيع رؤيتك جيّدًا

212
00:13:17,910 --> 00:13:18,570
ماذا؟

213
00:13:18,910 --> 00:13:21,370
...اقترب أكثر

214
00:13:21,740 --> 00:13:23,540
...سمعت ذلك من قبل

215
00:13:23,700 --> 00:13:25,290
ذات الرداء الأحمر؟

216
00:13:27,540 --> 00:13:28,540
ما هذه؟

217
00:13:28,790 --> 00:13:30,590
...هذه

218
00:13:30,920 --> 00:13:34,050
!نصـولٌ لـتقطيعك إربًـا

219
00:13:34,590 --> 00:13:37,470
،ما بمقدورك أن تستل سيفك
!فلا حيلة لك

220
00:13:37,890 --> 00:13:39,970
!نجحت خطّتـــي

221
00:13:41,760 --> 00:13:43,770
!...ويحـك يـا يايبـا

222
00:13:45,350 --> 00:13:47,850
.ما بكِ يا ساياكا؟ لم أخرجه من الغمد

223
00:13:48,440 --> 00:13:51,020
!لا يجوز ضرب عجوزٍ مسكينة

224
00:13:51,770 --> 00:13:53,270
.نحن جِدّ آسفان

225
00:13:53,610 --> 00:13:54,900
أبخيرٍ أنتِ؟

226
00:13:55,820 --> 00:13:57,490
!حمدًا

227
00:13:57,860 --> 00:13:59,490
.هيّا نمضِ يا يايبا

228
00:13:59,530 --> 00:14:01,830
لكن ما الّذي أخطأت بشأنه؟

229
00:14:02,620 --> 00:14:05,080
!...ضربك بكلّ قوته ومع ذلك صمدت

230
00:14:05,160 --> 00:14:06,910
!كما هو متوقّعٌ من السيد سرعوف

231
00:14:07,460 --> 00:14:09,630
...فشلت الخطة ولكن

232
00:14:11,590 --> 00:14:15,670
!!الـسيّـد سـرعــــــــــــــــــــــــــــــــــوف

233
00:14:17,130 --> 00:14:18,880
...وثمّة أيضًا

234
00:14:18,970 --> 00:14:21,090
.خيار البحر، نقيق

235
00:14:21,220 --> 00:14:24,510
،انّه ألطف الوحوش الثمانية
~لو رأيت كم هو ظريف

236
00:14:24,770 --> 00:14:27,850
ولكن ما بمقدور خيار البحر فعله؟

237
00:14:29,310 --> 00:14:30,810
مـا هذه؟

238
00:14:31,350 --> 00:14:32,900
"ألسنة الشياطين"

239
00:14:33,020 --> 00:14:35,780
...يُفترض أنهم لإخافة الناس ولكن

240
00:14:37,650 --> 00:14:40,700
.علقوها بشكلٍ هش حتى تسقط بسهولة

241
00:14:41,320 --> 00:14:43,410
.اظنّ أنّي دست على أحدها منذ برهة

242
00:14:43,580 --> 00:14:45,990
...وأنا أيضًا

243
00:14:47,660 --> 00:14:48,620
...فهمت

244
00:14:49,040 --> 00:14:52,170
...اختفى هو أيضًا

245
00:14:52,580 --> 00:14:54,790
...فـعندما يمرون

246
00:14:55,750 --> 00:14:59,880
...فلترهم أنّك لست مجرد كتلة

247
00:14:59,970 --> 00:15:01,380
!يـا خيار البحر

248
00:15:07,140 --> 00:15:11,770
!!الـسيّد خيـــــــــــــــــار البحـــــــــــــــــــر

249
00:15:13,350 --> 00:15:16,650
.وثمّة نجم البحر أيضًا

250
00:15:16,770 --> 00:15:18,780
.وهو أكثرنا حماسًا

251
00:15:18,990 --> 00:15:21,150
...نجم بحرٍ تقول

252
00:15:24,660 --> 00:15:27,490
...لا أكاد أصدق أنهم هُزموا

253
00:15:28,200 --> 00:15:31,460
.لكن خطتي النهائية منيعة

254
00:15:31,710 --> 00:15:35,710
!سيسلموننا سيف الرايجين طوعًا

255
00:15:38,800 --> 00:15:44,140
ادخل سيفك هنا لـيظهر الحمام السري"؟"

256
00:15:45,260 --> 00:15:47,510
اين يقصد؟

257
00:15:47,850 --> 00:15:48,720
هنـا؟

258
00:15:48,770 --> 00:15:51,480
!مهـلًا، لا يُفترض بك أن تستل سيفك

259
00:15:53,650 --> 00:15:56,650
!كاصطياد السمك

260
00:15:57,020 --> 00:15:58,900
!انت ذاك العامل في الفندق

261
00:15:59,070 --> 00:16:01,450
!لسـتُ كذلـك

262
00:16:04,410 --> 00:16:07,580
!بل أحد الوحوش الثمانية الخادمين للسيد أونيمارو

263
00:16:08,240 --> 00:16:09,910
!نجـم الـبحر

264
00:16:10,620 --> 00:16:11,710
!احد الوحوش؟

265
00:16:12,000 --> 00:16:14,540
~لا عجب أنّه بدا مضحكًا

266
00:16:14,830 --> 00:16:16,330
مضحكـ-؟

267
00:16:17,210 --> 00:16:20,250
!لن تطول إهانتكِ لي بعد قليل

268
00:16:20,420 --> 00:16:21,710
!-ايّـها الـ

269
00:16:24,050 --> 00:16:25,720
!ماذا؟ لا أستطيع سحبه

270
00:16:25,840 --> 00:16:26,470
!ماذا؟

271
00:16:28,260 --> 00:16:32,730
!حشوت الشق بصمغٍ منيع

272
00:16:33,140 --> 00:16:34,190
!ما الّذي قلت؟

273
00:16:34,520 --> 00:16:38,520
!لا فائدة لـسيف الرايجين الآن

274
00:16:39,270 --> 00:16:40,730
!استـعدّ

275
00:16:41,070 --> 00:16:44,570
،بدون سيفك العزيز
!يمكنني الإطاحة بك بنفسي

276
00:16:44,820 --> 00:16:46,490
!لسـت وحـدك

277
00:16:48,280 --> 00:16:51,830
!انا أحد الوحوش الثمانية، السرعـوف

278
00:16:52,450 --> 00:16:55,040
!وأنـا خيـار البـحر -زورا

279
00:16:55,120 --> 00:16:56,580
!يا جماعة

280
00:16:56,830 --> 00:16:58,880
!انت من حاول إخافتنا آنفًا

281
00:16:59,170 --> 00:17:00,950
!أجميعكم مع أونيمارو؟

282
00:17:01,800 --> 00:17:04,630
!والآن، يستحيل نصركم

283
00:17:04,880 --> 00:17:05,920
...لذا فلـ

284
00:17:07,840 --> 00:17:09,550
!على رسلك يا يايبا

285
00:17:10,810 --> 00:17:12,520
!عقيمةٌ هي محاولاتك

286
00:17:12,710 --> 00:17:14,140
،ان لم تود تسليمه بطواعية

287
00:17:14,890 --> 00:17:17,180
!فسيتوجب علينا أخذه قسـرًا

288
00:17:25,150 --> 00:17:28,240
!!الـسيّد نجــــــــــــــــــــم البحـــــــــــــــــــــــــر

289
00:17:36,710 --> 00:17:39,750
...ارى أنّ الأدريلانين عنده مرتفع

290
00:17:41,170 --> 00:17:42,550
!سحـب سيف الرايجين

291
00:17:42,920 --> 00:17:46,800
.باءت خطّتي العبقرية... بالفشل

292
00:17:47,430 --> 00:17:48,430
...انصتوا يا رفقة

293
00:17:48,720 --> 00:17:50,550
...لا خيار لدينا الآن

294
00:17:51,010 --> 00:17:54,270
!ان عدنا خالي الوفاض ليقطعنّ السيد أونيمارو رؤوسنا

295
00:17:54,560 --> 00:17:59,230
!لذا لـنتحد ثلاثتنـا ولـنطح بهمـا

296
00:17:59,600 --> 00:18:03,190
!فلـنريهما ممّا نحن مصنوعون حقًّا

297
00:18:06,650 --> 00:18:09,320
!استعد لتنال حتفك يا يايبـا
ما خطب الأرض فجأةً؟-

298
00:18:09,450 --> 00:18:10,280
زلزال؟

299
00:18:31,510 --> 00:18:32,760
!مـا هذا يا تُرى؟

300
00:18:33,260 --> 00:18:35,640
!قصة الينبوع السري صحيحة

301
00:18:37,600 --> 00:18:39,140
ايـن اختفوا أولئك؟

302
00:18:42,940 --> 00:18:44,940
.الدنيا دوارة، نقيق

303
00:18:45,730 --> 00:18:48,690
...محالٌ أن يخاف ساموراي عظيم مثلي من هكذا

304
00:18:49,240 --> 00:18:52,160
~احـدٌ قادم

305
00:18:56,910 --> 00:18:59,040
أهذا الشيء يُدعى خيار بحر؟

306
00:18:59,120 --> 00:19:01,170
!كُـفّ عن ذلك

307
00:19:05,210 --> 00:19:06,510
...هذا

308
00:19:08,630 --> 00:19:09,880
.افقت إذن

309
00:19:15,260 --> 00:19:16,970
!انّى لكم مهاجمتنا في نومنـا؟

310
00:19:17,270 --> 00:19:19,810
...عمّ تتحدث؟ لقد أغثناكم

311
00:19:22,150 --> 00:19:23,350
إلى ما ترمي؟

312
00:19:23,480 --> 00:19:24,770
ما الّذي حدث؟

313
00:19:25,150 --> 00:19:28,030
...اصحاب الفندق أخبرونا بأنّكم أسرتموهم

314
00:19:28,650 --> 00:19:31,820
.بـاغين سرقـة سيف الرايجين

315
00:19:33,490 --> 00:19:35,240
اذن لمَ...؟

316
00:19:35,570 --> 00:19:37,200
تقول لمَ؟

317
00:19:37,620 --> 00:19:40,040
...لا يمكننا ترككم في تلك حالة حتى لو كنتم أعداءنا

318
00:19:40,080 --> 00:19:43,620
حسنٌ، كان تحدي الكيموداميشي ممتعًا قليلًا

319
00:19:43,960 --> 00:19:48,510
.علاوةً، أشاد غيروزايمون بطيبة قلبكم

320
00:19:48,670 --> 00:19:49,550
!نقيـق

321
00:19:53,010 --> 00:19:54,510
...يـا لـ

322
00:19:54,590 --> 00:19:56,680
!يــا لـطيبـة قلـبـكم

323
00:19:57,010 --> 00:19:59,430
!مضى الكثير منذ حظينا بهكذا لطف

324
00:19:59,520 --> 00:20:02,020
!فـأونيمارو جِدّ لئيم

325
00:20:02,350 --> 00:20:04,770
!ولا يعطينا فلسًـا

326
00:20:05,980 --> 00:20:07,610
،لقد أنقذتموننا

327
00:20:08,270 --> 00:20:11,650
لكن فور عودتنا سيفعل
!النقيض تمامًا

328
00:20:12,150 --> 00:20:14,660
.لا حاجة لكم بالعودة إذن

329
00:20:16,120 --> 00:20:19,620
.لكم حرية فعل ما تبتغونه

330
00:20:20,250 --> 00:20:22,040
.هذا ما فعلته

331
00:20:22,660 --> 00:20:26,750
ولكن إن عبثتم معنا ثانيةً
بنتعشاكم، تمام؟

332
00:20:28,340 --> 00:20:30,050
...ما أبتغي

333
00:20:31,590 --> 00:20:35,340
...اعود إلى موطني على ما أظن

334
00:20:35,840 --> 00:20:37,010
.وأنا أيضًا

335
00:20:37,430 --> 00:20:40,810
...سأعود لزوجتي في كيوشو
.وأعيش حياةً هنيئةً

336
00:20:41,140 --> 00:20:42,640
أقلت كيوشو؟

337
00:20:43,020 --> 00:20:45,480
.نحن متجهون إلى جزيرة غانريو

338
00:20:45,650 --> 00:20:46,350
!جزيرة غانريو؟

339
00:20:46,980 --> 00:20:50,770
أتلك الّتي تقع بين هونشو وكيوشو؟

340
00:20:51,230 --> 00:20:53,190
...صحيح

341
00:20:53,280 --> 00:20:55,150
!لطالما وددت الذهاب إليها

342
00:20:55,570 --> 00:20:58,200
أيمكنني مرافقتكم؟

343
00:20:59,490 --> 00:21:02,750
...كنت عدوًّا قبل قليل

344
00:21:07,000 --> 00:21:09,840
!ليس الأمر كما يبدو
!كلٌّ يجري وفقًا لخطتي

345
00:21:10,000 --> 00:21:11,210
!اخـــرس

346
00:21:12,130 --> 00:21:14,930
...السيد أونيمارو

347
00:21:19,970 --> 00:21:24,390
...لم يتبق إليّ إلا الاعتماد على أقواهم

348
00:21:37,320 --> 00:21:40,030
أناديتني يا سيدي أونيمارو؟

349
00:21:40,740 --> 00:21:42,330
!كفـانا لهـوًا

350
00:21:42,700 --> 00:21:43,620
قلتنتزع سيف الرايجين

351
00:21:43,620 --> 00:21:45,370
...من يدي كوروغاني يايبا

352
00:21:45,910 --> 00:21:47,410
!ولتسلمني إيّاه

353
00:21:48,460 --> 00:21:50,330
.تحت أمرك

354
00:23:35,810 --> 00:23:38,730
!مهلًا، فلتعد إليّ الكوشيكاتسو خاصتي

355
00:23:38,820 --> 00:23:42,320
.هذا الوحش يبدو كالمهرج

356
00:23:42,530 --> 00:23:44,070
أهو قويٌّ حقًّا؟

357
00:23:44,620 --> 00:23:46,280
،في المرة القادمة
"دراكولا"

358
00:23:46,480 --> 00:23:49,050
!انّه أقوى الوحوش الثمانية، نقيق