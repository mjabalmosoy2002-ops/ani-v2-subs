1
00:01:40,410 --> 00:01:45,120
أزهار الكرز متفتّحة سلفاً
في حديقة أوينو في طوكيو

2
00:01:45,120 --> 00:01:47,330
وتستقطب الكثير من الزوّار

3
00:01:45,610 --> 00:01:47,330
أزهار الكرز؟

4
00:01:49,890 --> 00:01:52,170
،رغم أنّ الجوّ أصبح دافئاً لحدٍّ ما

5
00:01:53,960 --> 00:01:57,220
لا يزال الربيع في هوكّايدو بارداً

6
00:01:58,520 --> 00:02:00,310
حسناً، سأخرج الآن

7
00:02:00,310 --> 00:02:02,520
رافقتك السلامة، أراك لاحقاً

8
00:02:10,360 --> 00:02:11,770
!أسرع

9
00:02:13,190 --> 00:02:15,210
لعلّي في السنة الثانية الآن

10
00:02:16,010 --> 00:02:20,070
عندما أتيت لهوكّايدو، أدهشتني الطرق المكسوّة بالثلوج

11
00:02:20,070 --> 00:02:22,790
لكن ربما مضى شهران بالفعل

12
00:02:23,320 --> 00:02:25,080
الوقت يمرّ يلمح البصر

13
00:02:31,350 --> 00:02:33,040
إنّها فويوكي-سان

14
00:02:33,040 --> 00:02:36,670
لكن أليس هذا بعيداً عن طريق
مغادرتها لمنزلها؟

15
00:02:38,590 --> 00:02:40,390
!تسوباسا

16
00:02:40,390 --> 00:02:42,010
صباح الخير يا فويوكي-سان

17
00:02:42,010 --> 00:02:43,510
!وصلت أخيراً

18
00:02:43,510 --> 00:02:45,290
ماذا؟ أخيراً؟

19
00:02:46,680 --> 00:02:50,440
كنت بانتظارك كي نمشي للمدرسة معاً

20
00:02:51,070 --> 00:02:53,440
،رغم أنّ الجوّ أصبح أدفأ

21
00:02:53,440 --> 00:02:56,660
تجعل فتاةً شابة تنتظر بمفردها
...في البرد هكذا

22
00:02:56,660 --> 00:02:58,360
!يا لك من رجلٍ قاسٍ

23
00:02:58,360 --> 00:03:02,830
أ-أنا آسف، كنت لأغادر أبكر لو أخبرتِني

24
00:03:02,830 --> 00:03:05,280
!ماذا؟ مستحيل

25
00:03:05,280 --> 00:03:08,690
أردت رؤية الدهشة المرتسمة على وجهك

26
00:03:08,690 --> 00:03:10,380
حـ-حسناً

27
00:03:11,350 --> 00:03:15,620
فويوكي-سان هجوميّة اليوم لسببٍ ما

28
00:03:15,620 --> 00:03:17,910
هل تحسّن زكامك الآن؟

29
00:03:18,450 --> 00:03:21,580
أجل، أنا بخيرٍ تماماً

30
00:03:22,100 --> 00:03:27,970
لكنّ جدّتي شعرت بالقلق بعدما حصل
وأخبرتني بالخلود للنوم بحلول التاسعة

31
00:03:28,660 --> 00:03:32,750
لذا كنت أعيش نظاماً صحّياً
للنصف الثاني من عطلة الربيع

32
00:03:32,750 --> 00:03:35,460
لكنّي لم أستطع الخروج في أيّة
رحلات كبيرة أو ما شابه

33
00:03:35,460 --> 00:03:37,980
أشعر بالأسى عليك

34
00:03:38,200 --> 00:03:40,880
لكن يجب أن تصغي لجدّتك

35
00:03:40,880 --> 00:03:43,570
أجل، عليّ الامتنان لها

36
00:03:45,690 --> 00:03:49,450
مرّت عطلتي الربيعيّة بلمح البصر أيضاً

37
00:03:49,780 --> 00:03:51,030
أكنتِ مشغولة لذاك الحدّ؟

38
00:03:51,030 --> 00:03:52,180
أجل

39
00:03:52,180 --> 00:03:55,150
،لكن بصراحة، خلال عطلة الربيع

40
00:03:57,160 --> 00:04:00,300
تمنّيت لو أمضيتٌ وقتاً أكثر
معك يا تسوباسا

41
00:04:01,550 --> 00:04:06,200
!ارتجف قلبك للتوّ، صحيح؟ تسهل قراءتك جدّاً

42
00:04:06,200 --> 00:04:08,590
...حسناً... أنا

43
00:04:08,590 --> 00:04:11,560
!أوّل يوم في الفصل الدراسيّ، وهي تضغط بشدّة

44
00:04:13,690 --> 00:04:16,470
لكنّ هوكّايدو مذهلة حقّاً

45
00:04:16,470 --> 00:04:17,450
ما قصدك؟

46
00:04:17,450 --> 00:04:20,530
أصبحنا في أبريل، لكن لا تزال الثلوج
على أطراف الطرق

47
00:04:20,960 --> 00:04:24,780
الجميع في طوكيو يرون أبريل
عن أزهار الكرز

48
00:04:25,050 --> 00:04:28,840
طوكيو في إزهارٍ كامل الآن، صحيح؟
رأيت ذلك على التلفاز صباح اليوم

49
00:04:29,460 --> 00:04:32,460
تتفتّح أزهار الكرز هنا في شهر مايو

50
00:04:32,460 --> 00:04:34,790
لذا لا نراها جزءاً من العام الدراسيّ الجديد

51
00:04:34,790 --> 00:04:35,950
هكذا إذاً

52
00:04:35,950 --> 00:04:39,830
لكن بالمقابل، تزهر الكرز والبرقوق والخوخ
!في الآن ذاته معاً

53
00:04:39,830 --> 00:04:41,610
!ماذا؟ ذلك مبهر

54
00:04:41,610 --> 00:04:44,300
!يحلّ الربيع فجأةً ثمّ ينتهي فجأة

55
00:04:44,840 --> 00:04:48,520
نشعر أنّ الصيف يستقبلنا
فورما ينتهي الشتاء

56
00:04:49,810 --> 00:04:53,210
لست متأكّداً ما إن كان ذلك
حميداً أم مذموماً

57
00:04:53,620 --> 00:04:58,120
بالنسبة لي، أفضّل الربيع
بين جميع الفصول

58
00:04:58,430 --> 00:05:02,940
أعتقد أنّي أحبّ الشتاء، يحتوي الكثير من الفعاليّات

59
00:05:03,360 --> 00:05:07,320
التزلّج، صحيح؟ مهرجان ياكينيكو الشتويّ، صحيح؟

60
00:05:07,320 --> 00:05:13,330
،ثمّ الكريسماس، عيد رأس السنة
!ثمّ حتّى الفالينتاين

61
00:05:13,330 --> 00:05:15,850
أجل، معكِ حقّ

62
00:05:21,990 --> 00:05:25,190
لكنّي أريد رؤية تفتّح أزهار
كرز هوكّايدو عمَّ قريب

63
00:05:28,560 --> 00:05:30,210
بالمناسبة

64
00:05:30,210 --> 00:05:34,100
،سيتمّ توزيعنا على فصول جديدة اليوم
آمل أن نكون في الفصل نفسه من جديد

65
00:05:34,520 --> 00:05:35,720
أنا كذلك

66
00:05:36,220 --> 00:05:39,530
ماذا؟ تبدو فويوكي-سان حزينة فجأةً

67
00:05:39,900 --> 00:05:43,480
سمعت شائعةً عن توزيع الفصول في مدرستنا

68
00:05:43,480 --> 00:05:47,770
بحيث يتفادون وضع التلاميذ ذوي العلامات العالية
في الفصل نفسه مع ذوي العلامات المتدنيّة

69
00:05:47,770 --> 00:05:49,590
ماذا؟ حقّاً؟

70
00:05:49,590 --> 00:05:50,410
أجل

71
00:05:50,410 --> 00:05:54,570
لكنّهم لم يخبروني بذلك أثناء العرض
التوضيحيّ عندما انتقلت

72
00:05:54,570 --> 00:05:57,760
إنّها محض شائعة، فلست متيقّنة من صحّتها

73
00:05:58,570 --> 00:06:00,820
...لكن إن كانت صحيحة

74
00:06:01,290 --> 00:06:05,420
فقد لا أكون في نفس فصلك

75
00:06:06,810 --> 00:06:08,090
...فويوكي-سان

76
00:06:10,680 --> 00:06:14,680
،إذا أصبحنا في فصلين مختلفين
فلن نتقابل بذاك القدر

77
00:06:15,110 --> 00:06:18,290
سنكوّن صداقات جديدة في فصلينا
على الأرجح أيضاً

78
00:06:19,000 --> 00:06:23,780
عندما بدأت أفكّر بذلك، أشعرني الأمر بالحزن نوعاً ما

79
00:06:24,700 --> 00:06:29,860
لذا أردت المشي للمدرسة معك اليوم

80
00:06:33,790 --> 00:06:36,290
،حتّى لو أصبحنا في فصلين مختلفين

81
00:06:37,200 --> 00:06:39,040
!سآتي لزيارتكِ يا فويوكي-سان

82
00:06:40,960 --> 00:06:44,750
...لذا، أنا... كيف أقولها

83
00:06:44,750 --> 00:06:46,710
يمكنكِ الاطمئنان

84
00:06:48,810 --> 00:06:52,660
أو ربما ليس الاطمئنان، لكنّي
لن أجعلكِ تقلقين

85
00:06:52,660 --> 00:06:56,520
!كلّ ما يصدر من فمي يبدو محرجاً

86
00:06:59,210 --> 00:07:01,900
تسوباسا، أنت تحاول أداء
!دور الرائع بوضوح

87
00:07:01,900 --> 00:07:05,360
!وتتسبّب بإحراج نفسك! طريف

88
00:07:05,360 --> 00:07:09,710
!معها حقّ! تبّاً

89
00:07:11,520 --> 00:07:13,330
لكن، شكراً لك

90
00:07:13,330 --> 00:07:17,290
!بفضلك يا تسوباسا، لم أعد أشعر بالحزن

91
00:07:20,080 --> 00:07:21,540
لنسرع بالذهاب للمدرسة

92
00:07:21,540 --> 00:07:22,360
!أجل

93
00:07:25,450 --> 00:07:29,420
...حسناً... أ، كا، سا، شي

94
00:07:29,420 --> 00:07:30,840
أين شيكي؟

95
00:07:30,840 --> 00:07:32,810
...فويوكي، فويوكي

96
00:07:34,600 --> 00:07:35,660
!ها أنا

97
00:07:35,660 --> 00:07:37,260
!السنة الثانية الفصل 4

98
00:07:37,770 --> 00:07:40,250
!ماذا؟ الفصل نفسه؟

99
00:07:40,250 --> 00:07:41,840
!رائع يا فويوكي-سان

100
00:07:41,840 --> 00:07:43,150
!مرحى

101
00:07:43,150 --> 00:07:45,360
!كانت تلك الشائعة مخطئة إذاً

102
00:07:45,610 --> 00:07:47,270
!ليكن فصلنا رائعاً معاً

103
00:07:47,270 --> 00:07:48,620
!بالطبع، بالطبع

104
00:07:48,620 --> 00:07:50,250
!شيكي! فويوكي

105
00:07:51,200 --> 00:07:52,950
نحن في الفصل نفسه من جديد

106
00:07:52,950 --> 00:07:54,280
أنتِ أيضاً يا أكينو-سان؟

107
00:07:54,280 --> 00:07:55,620
الفصل 4؟

108
00:07:55,620 --> 00:08:01,500
!أنا في نفس فصل سايورين
!إنّي بغاية الدهشة والسعادة

109
00:08:01,500 --> 00:08:05,170
حسناً، لطالما ظننت أنّنا سنكون
في الفصل نفسه مجدّداً

110
00:08:05,170 --> 00:08:07,780
مذهل، أأنتِ وسيطة روحيّة أو ما شابه؟

111
00:08:07,780 --> 00:08:11,520
بينما كنت قلقة حيال الأمر

112
00:08:11,520 --> 00:08:12,170
قلقة؟

113
00:08:12,170 --> 00:08:13,090
أجل

114
00:08:13,090 --> 00:08:17,100
كانت هناك شائعة بضمّ التلامذة معاً
بناءً على علامات الاختبارات

115
00:08:17,100 --> 00:08:19,140
أجل، سمعت بذلك

116
00:08:19,140 --> 00:08:20,680
حقّاً؟

117
00:08:20,680 --> 00:08:24,940
،لكن لو كانوا سيوزّعون التلامذة بعلاماتهم
لفعلوا ذلك منذ البداية

118
00:08:24,940 --> 00:08:28,320
يا إلهي، كيف لكِ إبداء هذا الهدوء
حيال الأمر يا سايورين؟

119
00:08:29,410 --> 00:08:30,440
ماذا؟

120
00:08:30,440 --> 00:08:32,110
هل قصصتِ شعركِ يا سايورين؟

121
00:08:32,110 --> 00:08:34,660
ماذا؟ أجل

122
00:08:35,390 --> 00:08:37,210
لجعله أخفّ قليلاً وحسب

123
00:08:39,910 --> 00:08:41,560
!إنّه مثاليّ للربيع

124
00:08:41,560 --> 00:08:43,430
ألا تظنّ ذلك يا تسوباسا؟

125
00:08:43,430 --> 00:08:44,210
بلى

126
00:08:44,210 --> 00:08:47,130
أرى أنّكِ تبدين رائعة جدّاً يا أكينو-سان

127
00:08:50,340 --> 00:08:53,090
آسف، هل تفوّهت بأمر غريب؟

128
00:08:53,090 --> 00:08:54,320
...كـ-كلّا، أنا

129
00:08:54,320 --> 00:08:55,360
!أنتم

130
00:08:55,960 --> 00:08:57,130
!ماتسون

131
00:08:59,130 --> 00:09:03,680
!أنا في الفصل 2-4 أيضاً، لنحظِ بعام دراسيّ رائع

132
00:09:03,680 --> 00:09:06,370
أنت في الفصل نفسه؟

133
00:09:06,370 --> 00:09:09,940
أنا مسرور لاجتماعي بعدد من أصدقائي من جديد

134
00:09:09,940 --> 00:09:12,320
سيكون من المريع لو كنت
وحيداً منذ البداية

135
00:09:12,320 --> 00:09:13,300
!أجل

136
00:09:13,300 --> 00:09:14,730
أشعر بالارتياح أيضاً

137
00:09:15,750 --> 00:09:17,470
!لنذهب للفصل

138
00:09:21,620 --> 00:09:24,490
يمكنني تعليمك المزيد من الألعاب
الآن يا شيكي

139
00:09:24,490 --> 00:09:27,870
!أجل يا معلّمة! أتطلّع لمواصلة التعلّم منك

140
00:09:28,430 --> 00:09:32,610
،سمعت عن التحديثات الجديدة لتوّي
يجب أن نستغلّها

141
00:09:32,610 --> 00:09:34,720
ماذا؟ أنتِ تلعبين ألعاب الفيديو يا أكينو-سان؟

142
00:09:36,140 --> 00:09:38,640
ما قصدك بألعبها بالضبط؟

143
00:09:38,640 --> 00:09:41,760
!لا، لا! أنا أحبّ الألعاب أيضاً وحسب

144
00:09:43,980 --> 00:09:50,270
ألعب أيّ شيء، من ألعاب رماية المنظور الأوّل
"الجماعيّة إلى ألعاب الإيقاع، وحتّى "معاً الوحوش

145
00:09:50,650 --> 00:09:52,650
تلك تشكيلة فريدة

146
00:09:52,650 --> 00:09:55,630
تراودك رغبة بتناول شيء مالح
بعد تذوّق شيء حلو، أليس كذلك؟

147
00:09:55,630 --> 00:09:56,700
صحيح

148
00:09:56,700 --> 00:10:00,370
تفهم قصدها؟ أنتما مقرّبان حقّاً

149
00:10:00,370 --> 00:10:02,530
حسناً إذاً، أتلعبين "سيس-بلس"؟

150
00:10:01,680 --> 00:10:02,530
فويوكي-سان

151
00:10:02,530 --> 00:10:03,830
ألعبها كثيراً

152
00:10:04,210 --> 00:10:04,950
هيّا بنا

153
00:10:09,190 --> 00:10:09,910
!أجل

154
00:10:17,370 --> 00:10:19,880
مرحباً بكم جميعاً للعام الدراسيّ الجديد

155
00:10:20,290 --> 00:10:23,600
سأكون معلّمة فصلكم، توغوتشي ميسا

156
00:10:23,600 --> 00:10:26,220
!لنحظِ بعامٍ دراسيّ رائع

157
00:10:27,010 --> 00:10:29,910
حسناً إذاً، بالنسبة لحصّتنا الافتتاحيّة الأولى

158
00:10:29,910 --> 00:10:33,520
أودّ أن نختار رئيس فصل ونائباً له

159
00:10:33,520 --> 00:10:36,690
بدايةً، هل هناك من يودّ التطوّع للترشّح؟

160
00:10:36,690 --> 00:10:38,610
يمكنكم ترشيح أحد آخر إن أردتم أيضاً

161
00:10:40,030 --> 00:10:41,630
!أنا يا سينسي

162
00:10:41,630 --> 00:10:43,200
أجل يا ماتسو-كن

163
00:10:43,200 --> 00:10:46,370
بالنسبة لرئيس الفصل، أرى أنّ
!الدور يلائم شيكي

164
00:10:46,370 --> 00:10:47,160
!ماذا؟

165
00:10:47,160 --> 00:10:49,610
هلّا شرحت سبب ترشيحك له؟

166
00:10:49,610 --> 00:10:54,190
حسناً، شيكي بغاية الذكاء ويحمل
حسّاً عالياً بالمسؤوليّة

167
00:10:54,190 --> 00:10:56,670
!وفوق كلّ شيء، هو شابٌ رائع يهتمّ كثيراً برفاقه

168
00:10:56,890 --> 00:11:00,610
لكنّي انتقلت إلى هنا
قبل نصف عامٍ وحسب

169
00:11:00,610 --> 00:11:02,340
!ذلك لا يهمّ

170
00:11:02,790 --> 00:11:07,220
إن أصبح شيكي رئيساً، فأنا متأكّد من عدم
محاولته إدارة كلّ شيءٍ بمفرده

171
00:11:07,220 --> 00:11:11,690
سيصغي لآراء الجميع بإمعان ويجعل
من هذا فصلاً رائعاً

172
00:11:11,990 --> 00:11:15,440
أهكذا تراني يا ماتسو-كن؟

173
00:11:15,440 --> 00:11:17,240
أنا أتّفق معه

174
00:11:17,240 --> 00:11:18,150
كذلك أنا

175
00:11:18,150 --> 00:11:20,450
!صوتان مساندان آخران

176
00:11:22,430 --> 00:11:24,600
!بالإضافة، إنّه من طوكيو

177
00:11:24,600 --> 00:11:27,540
أ-أذلك سببٌ لترشيحي؟

178
00:11:27,540 --> 00:11:31,770
حسناً يا شيكي-كن، ما رأيك في ذلك؟

179
00:11:31,770 --> 00:11:34,290
أأنت مهتمٌّ بأن تكون رئيساً؟

180
00:11:34,290 --> 00:11:35,700
...حسناً

181
00:11:37,040 --> 00:11:41,670
،إن كان ذلك يعني مساعدتي للجميع
فربما يمكنني المحاولة

182
00:11:41,670 --> 00:11:43,180
!أجل

183
00:11:43,510 --> 00:11:47,840
،إذا لم يكن هناك مرشّحون آخرون
فسنعيّن شيكي-كن

184
00:11:47,840 --> 00:11:49,690
أهنالك أيّ أحد؟

185
00:11:49,690 --> 00:11:51,690
!لا

186
00:11:51,690 --> 00:11:54,700
حسناً يا شيكي، الدور من نصيبك

187
00:11:54,700 --> 00:11:56,130
أ-أجل

188
00:11:56,130 --> 00:11:58,600
!قرّروا سريعاً

189
00:11:58,600 --> 00:12:00,340
...تالياً، بالنسبة لنائب الرئيس

190
00:12:00,340 --> 00:12:01,780
!أنا! أنا! أنا

191
00:12:01,780 --> 00:12:03,940
!سأفعلها أنا

192
00:12:03,940 --> 00:12:05,200
!حقّاً؟

193
00:12:07,230 --> 00:12:08,810
لدينا متطوّعة

194
00:12:08,810 --> 00:12:10,650
ما رأيكم جميعاً؟

195
00:12:10,650 --> 00:12:13,540
هل ستكونين بخير يا فيومينا؟

196
00:12:13,540 --> 00:12:15,130
!بالطبع

197
00:12:15,130 --> 00:12:17,960
!فأنا شديدة المسؤوليّة بخلاف ما يبدو عليّ

198
00:12:17,960 --> 00:12:19,980
لا أستطيع تصوّركِ سوى فتاة غارو

199
00:12:19,980 --> 00:12:22,210
!أجل، فتاة غارو بمسؤوليّة

200
00:12:24,100 --> 00:12:28,020
وابل من التصفيق لرئيس الفصل الجديد ونائبته رجاءً

201
00:12:30,330 --> 00:12:34,140
يسرّني أنّنا حدّدنا الأمر بسلاسة، يٌسعدني ذلك كثيراً

202
00:12:34,140 --> 00:12:36,090
!أنا بغاية السعادة حيال الأمر أيضاً

203
00:12:48,280 --> 00:12:49,330
!إنّه هو

204
00:12:49,330 --> 00:12:51,710
أتسمعينني يا أكينو-سان؟

205
00:12:51,710 --> 00:12:53,390
أجل، أسمعك

206
00:12:53,390 --> 00:12:55,750
جيّد، أي أنّ هذا يعمل

207
00:12:55,750 --> 00:12:59,040
ألم تقل أنّ هذه أوّل مرّة تلعب فيها
على الإنترنت يا شيكي؟

208
00:12:59,040 --> 00:13:01,510
!بلى، كنت أتطلّع لهذا بحماس

209
00:13:01,850 --> 00:13:03,840
...حسناً، اسم اللعبة

210
00:13:03,840 --> 00:13:06,090
"معاً! تسلّق الوحوش"

211
00:13:06,090 --> 00:13:07,770
"أو باختصار، "معاً الوحوش

212
00:13:08,090 --> 00:13:12,330
لكنّك لم تمتلك جهاز ألعاب
حتّى مؤخراً، صحيح؟

213
00:13:12,330 --> 00:13:13,360
ما الذي حصل؟

214
00:13:13,360 --> 00:13:16,300
ادّخرت من مصروفي واشتريت واحداً

215
00:13:17,120 --> 00:13:19,180
!يا إلهي، أنا آسفة حقّاً

216
00:13:19,180 --> 00:13:22,580
ظننت أنّ الجميع في العالم
يمتلكون أجهزة ألعاب سلفاً

217
00:13:22,580 --> 00:13:24,230
فدعوتك دون التفكير بالأمر

218
00:13:24,230 --> 00:13:25,710
لا تقلقي

219
00:13:30,200 --> 00:13:34,490
لا ترفض الآخرين أبداً يا شيكي عندما
يقومون بدعوتك، لمَ ذلك؟

220
00:13:36,890 --> 00:13:41,210
لا يمكنك أن تعرف ما إن كان شيء
مثيراً أم مسليّاً ما لم تجرّب

221
00:13:41,670 --> 00:13:43,510
لذا أنا مسرورٌ لدعوتكِ لي للعب

222
00:13:47,900 --> 00:13:51,960
،أريد دعوتك إلى جبلي يا شيكي
ما اسم شخصيّتك؟

223
00:13:51,960 --> 00:13:53,650
هانيكوتو

224
00:13:53,650 --> 00:13:55,160
هاني"، أي ريش؟"

225
00:13:55,160 --> 00:13:57,270
!فهمت، لأنّ اسمك يعني الأجنحة

226
00:13:57,270 --> 00:13:58,540
ماذا عنكِ؟

227
00:14:00,350 --> 00:14:01,260
تامو-سان

228
00:14:01,260 --> 00:14:03,330
تامو-سان؟ لمَ؟

229
00:14:03,330 --> 00:14:06,880
!شيكي، ممنوعٌ سؤالك لأحد عن مصدر اسم شخصيّته

230
00:14:06,880 --> 00:14:08,200
!آ-آسف

231
00:14:08,200 --> 00:14:11,460
أ-أنتِ محقّة، أراه اسماً ظريفاً

232
00:14:12,820 --> 00:14:14,700
هل أقوم بهذا كما يجب؟

233
00:14:14,700 --> 00:14:17,540
أنت تبلي حسناً، هذا منزلي

234
00:14:17,540 --> 00:14:21,040
!ماذا؟ منزلكِ مذهلٌ يا تامو-سان

235
00:14:21,040 --> 00:14:23,130
هـ-هل ترى ذلك؟

236
00:14:24,160 --> 00:14:26,590
!هذا رائع

237
00:14:26,590 --> 00:14:30,530
ألم يتطلّب الحصول على كلّ قطعة
أثاث الكثير من العمل؟

238
00:14:31,450 --> 00:14:35,770
حسناً، هذا ما يحصل عندما ألعب بجدّية

239
00:14:36,750 --> 00:14:39,270
لـ-لكن عليّ إخبارك بأمر

240
00:14:39,530 --> 00:14:41,530
لم يأتِ أحدٌ لمنزلي من قبل

241
00:14:41,530 --> 00:14:44,370
أنت الأوّل يا شيـ—، يا هانيكوتو

242
00:14:45,770 --> 00:14:49,300
حقّاً؟ هذا شرفٌ لي إذاً

243
00:14:49,300 --> 00:14:50,740
!شكراً لكِ على الدعوة

244
00:14:50,740 --> 00:14:54,090
إنّها محض لعبة، لكنّي أشعر بالتوتّر! لمَ؟

245
00:14:54,090 --> 00:14:56,790
حـ-حسناً، هل تريدين زيارة منزلي أيضاً؟

246
00:14:57,480 --> 00:14:59,580
أ-أجل، لا بأس

247
00:15:01,250 --> 00:15:04,370
لحظة... هذه الإعدادات الافتراضيّة تقريباً، أليس كذلك؟

248
00:15:04,370 --> 00:15:06,250
أعتذر على كونه مملاً هكذا

249
00:15:06,500 --> 00:15:11,180
لكنّي حصلت على إضافة خاصّة عندما اشتريته
أعطتني جالب الحظّ الغريب هذا

250
00:15:11,180 --> 00:15:15,100
لا بأس، إنّه يناسبني طالما يروقك يا هانيكوتو، أجل

251
00:15:15,100 --> 00:15:20,440
فكّرت بتغيير الأشياء، لكنّي لا أمتلك
المواد الكافية بعد

252
00:15:20,440 --> 00:15:22,270
أو أيّة مهارات في التصميم

253
00:15:22,650 --> 00:15:25,990
لمَ لا تأتي لجبلي لجمع المواد إذاً؟

254
00:15:25,990 --> 00:15:27,850
ماذا؟ أيمكنني؟

255
00:15:27,850 --> 00:15:29,600
!شكراً لكِ يا تامو-سان

256
00:15:34,700 --> 00:15:36,700
جبل تايسيتسو؟

257
00:15:36,700 --> 00:15:38,410
هذا اسمٌ ظريف

258
00:15:38,410 --> 00:15:42,000
أجل، إنّه اسم جبلٍ في هوكّايدو

259
00:15:42,410 --> 00:15:43,900
يُدعى تايسيتسو-سان

260
00:15:45,610 --> 00:15:48,590
من تكتبينه برموز "جبل ثقيل"، صحيح؟

261
00:15:48,590 --> 00:15:51,010
"لطالما ظننته يُقرأ "دايستسو-زان

262
00:15:51,010 --> 00:15:53,680
إنّه "تايسيتسو" لأنّه مهمٌّ لكِ كما
يوحي الاسم يا تامو-سان، صحيح؟

263
00:15:55,430 --> 00:15:58,300
حسناً، ربما يمكنك نطقه بالطريقتين

264
00:16:28,490 --> 00:16:32,000
!حصلنا على الكثير بهذه السرعة
!هذا بفضلكِ يا تامو-سان

265
00:16:32,000 --> 00:16:34,930
أنت بارعٌ بدورك بالنسبة لمبتدئ يا هانيكوتو

266
00:16:46,040 --> 00:16:48,590
علينا الآن انتظار انتهائه وحسب

267
00:16:48,590 --> 00:16:52,280
،لكنّي قمت بعدّة أشياء من طرفي
آمل أنّك لا تمانع

268
00:16:52,280 --> 00:16:55,210
أنا ممتنّ على مساعدتكِ في الواقع

269
00:16:55,210 --> 00:16:57,690
كنت لأتعب في المنتصف لو قمت بالأمر بمفردي

270
00:16:57,690 --> 00:16:59,940
حقّاً؟ تسرّني المساعدة إذاً

271
00:16:59,940 --> 00:17:02,200
أنتِ مذهلة حقّاً يا تامو-سان

272
00:17:02,450 --> 00:17:03,370
شكراً لكِ

273
00:17:06,350 --> 00:17:07,050
لا

274
00:17:07,830 --> 00:17:10,070
أنت وفويوكي مذهلان أكثر

275
00:17:11,130 --> 00:17:12,240
كذلك ماتسو

276
00:17:12,680 --> 00:17:16,260
كانت مرّته الأولى في فصلنا اليوم، وامتلك
الشجاعة لترشيحك رئيساً؟

277
00:17:16,470 --> 00:17:19,530
ماتسو-كن اجتماعيّ حقّاً

278
00:17:19,530 --> 00:17:22,380
كان من الرائع قبولك لترشيحك

279
00:17:22,380 --> 00:17:25,110
كما تطوّع فويوكي لنائبة الرئيس بتلك البساطة

280
00:17:25,660 --> 00:17:28,230
دُهِشت عندما فعلت فويوكي-سان ذلك أيضاً

281
00:17:30,330 --> 00:17:31,300
أكينو-سان؟

282
00:17:32,470 --> 00:17:34,650
كلّكم رائعون جدّاً

283
00:17:35,530 --> 00:17:39,470
بينما ها أنا ذي، لم أتغيّر أبداً

284
00:17:39,470 --> 00:17:42,200
أتظنّين ذلك؟ أراكِ قد تغيّرتِ

285
00:17:43,360 --> 00:17:48,500
كنتِ تعزلين نفسكِ دوماً، لكنّك تكلّمتِ معي

286
00:17:48,750 --> 00:17:52,090
وعندما قرّرتِ تجربة التزلّج من أعلى
الجبل في الدرس

287
00:17:52,090 --> 00:17:55,840
أعتقد أنّ تلك الأشياء تظهر تغيّركِ كثيراً

288
00:17:55,840 --> 00:17:57,150
...كانت مجرّد

289
00:17:57,150 --> 00:17:58,800
هناك أشياء أخرى كثيرة أيضاً

290
00:17:59,200 --> 00:18:03,010
،عندما كنت وفويوكي-سان مُبتدئين كلّياً
علّمتِنا كيفيّة لعب الألعاب

291
00:18:03,500 --> 00:18:07,140
وعندما تكلّم ماتسو-كن بقسوة مع
فويوكي-سان، غضبتِ منه

292
00:18:10,500 --> 00:18:13,820
...حسناً، إن تغيّرت، فذلك بفضل

293
00:18:14,480 --> 00:18:15,860
!انتهى

294
00:18:20,300 --> 00:18:24,120
آسف، كنتِ على وشك قول شيء
يا أكينو-سان، صحيح؟

295
00:18:25,090 --> 00:18:25,910
لا

296
00:18:26,420 --> 00:18:28,080
بالتوفيق لك في رئاسة الفصل

297
00:18:29,420 --> 00:18:30,970
سأهتف لك

298
00:18:46,490 --> 00:18:49,220
سننتهي بعد تنظيمنا لهذه المنشورات

299
00:18:49,580 --> 00:18:52,090
بدأ الظلام يخيم في الخارج

300
00:18:52,090 --> 00:18:53,560
معك حقّ

301
00:18:53,560 --> 00:18:56,250
أليس من المسلّي التواجد في المدرسة
في الليل هكذا؟

302
00:18:56,250 --> 00:18:59,650
ماذا؟ لا أظنّ ذلك يلائمني

303
00:18:59,650 --> 00:19:03,760
ماذا؟ أتخاف الأشباح أو ما شابه
يا تسوبا-تشا؟

304
00:19:03,760 --> 00:19:08,690
...لا، لم أقصد ذلك، أعني
المكان مظلم وهادئ

305
00:19:08,690 --> 00:19:11,500
وعند عدم وجود أحد، يُشعرني بالوحدة

306
00:19:11,500 --> 00:19:12,960
ذلك ما يعجبني

307
00:19:12,960 --> 00:19:13,700
ماذا؟

308
00:19:13,700 --> 00:19:17,670
كأنّنا الوحيدان في هذا العالم الآن

309
00:19:17,670 --> 00:19:19,630
ألا يثير هذا تسارع نبضاتك؟

310
00:19:33,700 --> 00:19:36,620
!نـ-نسيت شيئاً! كنت أنوي شكرك

311
00:19:36,620 --> 00:19:38,340
شكري؟ لمَ؟

312
00:19:38,340 --> 00:19:41,150
على تطوّعكِ لتكوني النائبة

313
00:19:41,670 --> 00:19:44,240
فاجأني الأمر، لكنّكِ تساعدينني كثيراً

314
00:19:44,240 --> 00:19:48,590
صحيح، الجميع يخبرونني أنّه كان مُفاجئاً

315
00:19:48,590 --> 00:19:50,830
هل أبدو غير جديرة بالاعتماد
لتلك الدرجة لك؟

316
00:19:50,830 --> 00:19:53,420
لا، لا، لم أقصد أنّه لا يُعتمد عليك

317
00:19:53,680 --> 00:19:57,190
بدا كشيء قد لا يثير اهتمامكِ وحسب

318
00:19:57,190 --> 00:20:01,380
حسناً، ربما لم أقم بالأمر من قبل حقّاً

319
00:20:01,380 --> 00:20:04,140
لطالما ظننت أنّ فعل هذه الأشياء لا يستهويني

320
00:20:04,140 --> 00:20:06,920
ما الذي غيّر رأيكِ إذاً؟

321
00:20:09,870 --> 00:20:15,030
لأنّي أردت إمضاء أكبر قدر ممكن
من الوقت معك

322
00:20:18,360 --> 00:20:22,940
أ-أنتِ تكثرين التلاعب معي اليوم
حقّاً يا فويوكي-سان

323
00:20:22,940 --> 00:20:27,050
فترة بدايتي هنا، كانت هذه الجملة لتقضي عليّ

324
00:20:27,050 --> 00:20:27,850
ماذا؟

325
00:20:28,190 --> 00:20:30,500
لم أتلاعب معك بأيّ شيءٍ اليوم

326
00:20:33,290 --> 00:20:35,570
كنت جادة تماماً

327
00:20:41,850 --> 00:20:42,620
...فويوكي

328
00:20:42,620 --> 00:20:46,140
مرحباً أنتما، أأوشكتما على الانتهاء؟

329
00:20:46,450 --> 00:20:49,860
إن كنتما ستستغرقان وقتاً أطول، يمكنني مساعدتكما

330
00:20:49,860 --> 00:20:52,390
لا بأس، انتهينا للتوّ

331
00:20:52,630 --> 00:20:55,010
!ذلك رائع

332
00:20:55,930 --> 00:20:57,440
ليس شيئاً يُذكر

333
00:20:59,210 --> 00:21:03,980
أنا مسرورة لكونكما ممثليّ الفصل
يا شيكي-كن وفويوكي-سان

334
00:21:03,980 --> 00:21:05,030
!شكراً على عملكما

335
00:21:05,030 --> 00:21:06,300
!شكراً لكِ أيضاً

336
00:21:06,300 --> 00:21:08,280
!إلى اللقاء يا سينسي

337
00:21:13,540 --> 00:21:16,270
الجوّ باردٌ ليلاً حقّاً

338
00:21:16,270 --> 00:21:18,670
كأنّه لا يزال يحمل بعضاً من الشتاء

339
00:21:18,670 --> 00:21:19,590
أجل

340
00:21:32,210 --> 00:21:36,050
...تبدو مُحبطة، بعد تلاعبها المستمرّ اليوم

341
00:21:36,050 --> 00:21:38,220
ما الذي حلّ بها يا ترى؟

342
00:21:40,380 --> 00:21:41,400
تسوباسا

343
00:21:42,130 --> 00:21:42,940
أجل

344
00:21:43,940 --> 00:21:45,980
الأسبوع الذهبيّ في الشهر القادم

345
00:21:46,700 --> 00:21:49,850
لا يهمّ متى، لكن هلّا أفرغت يوماً منه لي؟

346
00:21:51,480 --> 00:21:54,570
لديّ ما أريد إخبارك به

347
00:22:00,320 --> 00:22:02,060
حسنٌ، أراك لاحقاً

348
00:22:11,320 --> 00:22:15,400
لم يسبق وأن رأيت فويوكي-سان بتلك الجدّية

349
00:22:17,360 --> 00:22:18,750
حلّ الربيع

350
00:22:19,530 --> 00:22:22,560
،وبينما بدأ شتاء هوكّايدو بالذوبان

351
00:22:23,710 --> 00:22:25,540
لا يزال كلّ شيء داخل رأسي

352
00:22:26,140 --> 00:22:27,330
أبيضاً مشوّشاً