.مجموعة كاملة

215
00:13:32,320 --> 00:13:35,570
,من الآن فصاعداً, حياتي المدرسية الرائعة

216
00:13:35,570 --> 00:13:39,640
.أسطورة لورا لامر البراقة على وشك أن تبدأ

217
00:13:41,120 --> 00:13:43,910
!سأعطي هذا كل ما لديّ

218
00:13:46,580 --> 00:13:47,170
هاه؟

219
00:13:50,920 --> 00:13:52,070
!سامر

220
00:13:54,070 --> 00:13:58,570
.لا أريد أن أفعل شيئاً -
.كل شيء ذهب -

221
00:13:59,050 --> 00:13:59,970
.يا إلهي

222
00:14:01,180 --> 00:14:03,600
لماذا أتيتِ الآن؟

223
00:14:05,430 --> 00:14:07,190
.أنتِ متأخرة جداً

224
00:14:11,770 --> 00:14:15,220
.كنت على وشك أن أصبح نجمة

225
00:14:15,220 --> 00:14:17,430
!أنظري إلى ما فعلتِ

226
00:14:17,430 --> 00:14:19,790
.ليس لديّ خيار آخر

227
00:14:19,790 --> 00:14:23,060
.كان هناك الكثير من قوة الحماسة هنا

228
00:14:27,830 --> 00:14:31,690
.سأنهي أمرك في أيّ وقت

229
00:14:35,010 --> 00:14:37,450
!تغيير البريكور الاستوائي

230
00:14:40,300 --> 00:14:42,640
!لنضع مكياجاً! مبالغاً به

231
00:14:45,180 --> 00:14:45,890
!الوجه

232
00:15:01,490 --> 00:15:02,010
!الأظافر

233
00:15:10,190 --> 00:15:10,710
!الملابس

234
00:15:25,970 --> 00:15:27,160
!محيط متأرجح

235
00:15:27,770 --> 00:15:28,980
!كيور لامر

236
00:15:32,060 --> 00:15:35,360
.سآخذ قوة هذه الحماسة منك

237
00:15:35,730 --> 00:15:37,710
.ياراني-دا

238
00:15:50,500 --> 00:15:52,250
.شكراً لك يا لامر

239
00:15:52,710 --> 00:15:54,630
.لم يكن ذلك شيئاُ يذكر

240
00:15:55,290 --> 00:15:58,780
.على أيّ حال, علينا أن نستعيد حماسة الجميع

241
00:15:59,460 --> 00:16:02,360
.عليّ السباحة بعد هذا

242
00:16:02,360 --> 00:16:04,240
.نعم, أنتِ محقة

243
00:16:04,510 --> 00:16:06,100
.ياراني-دا

244
00:16:15,650 --> 00:16:17,360
.ياراني-دا

245
00:16:19,230 --> 00:16:20,500
!قوي جداً

246
00:16:20,500 --> 00:16:23,590
.أنت, اعمل بإنسجام

247
00:16:39,920 --> 00:16:41,920
.ياراني-دا

248
00:16:43,680 --> 00:16:44,410
!سامر

249
00:16:44,410 --> 00:16:45,840
نعم

250
00:16:49,970 --> 00:16:51,310
!عصا قلب أحمر الشفاه

251
00:16:57,460 --> 00:17:03,190
!ضربة صيف البريكور المشمس

252
00:17:04,340 --> 00:17:06,570
...ياراني-دا

253
00:17:07,070 --> 00:17:07,890
!لامر

254
00:17:08,280 --> 00:17:09,220
!حسناً

255
00:17:09,700 --> 00:17:11,440
!وعاء ماء حورية البحر

256
00:17:11,440 --> 00:17:12,580
!بحث

257
00:17:17,330 --> 00:17:18,360
.برتقالي

258
00:17:18,790 --> 00:17:20,800
!ارجعي يا قوة الحماسة

259
00:17:30,640 --> 00:17:32,160
.القتال التالي

260
00:17:40,900 --> 00:17:44,190
!اعصار تيار بحر البريكور

261
00:17:50,330 --> 00:17:51,160
!إنتصار

262
00:17:58,580 --> 00:18:01,280
.أوه حسناً, الأشياء تحدث

263
00:18:01,280 --> 00:18:03,150
.لا يُمكن لذلك أن يساعد

264
00:18:03,550 --> 00:18:05,210
.هم, أنا متعبة جداً

265
00:18:05,210 --> 00:18:07,880
.سأتراجع اليوم

266
00:18:09,590 --> 00:18:10,740
.حسناً

267
00:18:11,010 --> 00:18:15,850
حان الوقت لإظهار سباحتي الجميلة و الرائعة

268
00:18:16,230 --> 00:18:17,100
.نعم

269
00:18:19,100 --> 00:18:21,960
!حسناً يا رفاق, أعطوا هذا كل ما لديكم

270
00:18:21,960 --> 00:18:23,300
.نعم

271
00:18:23,570 --> 00:18:25,880
!لورا, قاتلي

272
00:18:26,190 --> 00:18:27,800
.كورورون

273
00:18:29,820 --> 00:18:31,160
.على علاماتكم

274
00:18:31,780 --> 00:18:32,780
!استعدوا

275
00:19:11,820 --> 00:19:13,580
.بداية الغوص رائعة

276
00:19:13,580 --> 00:19:17,180
.كما هو متوقع من ملكة السباحة

277
00:19:17,580 --> 00:19:19,270
.متألق جداً

278
00:19:26,550 --> 00:19:27,130
هاه؟

279
00:19:30,470 --> 00:19:31,990
!ساعدوني

280
00:19:32,300 --> 00:19:33,090
أوه؟

281
00:19:33,090 --> 00:19:34,180
ماذا!؟

282
00:19:34,870 --> 00:19:37,060
!كورورون

283
00:19:40,600 --> 00:19:44,500
,آسفة
.يبدو أنني أسأت الفهم

284
00:19:45,150 --> 00:19:47,960
.أشعر بالسوء لوضعك في هذا الموقف

285
00:19:48,280 --> 00:19:51,760
.همف, لا تنظري لي بشفقة

286
00:19:51,760 --> 00:19:54,000
.يمكنني السباحة حقاً

287
00:19:54,000 --> 00:19:56,510
!أنا جيدة جداً فيها

288
00:19:57,830 --> 00:20:00,140
.الأمر فقط أنني لست معتادة على هاتين الساقين

289
00:20:00,410 --> 00:20:01,070
ماذا؟

290
00:20:01,070 --> 00:20:03,480
.أنظري, يمكنني أن أريك

291
00:20:03,880 --> 00:20:08,210
,إذا كنت بشكلي الطبيعي
.فيمكنني السباحة بسرعة فائقة

292
00:20:10,420 --> 00:20:12,780
.أخبرتك أن تتوقفي

293
00:20:14,800 --> 00:20:15,560
.أيتها الرئيسة

294
00:20:15,560 --> 00:20:16,310
نعم؟

295
00:20:16,310 --> 00:20:18,770
.حان وقت لقائنا

296
00:20:18,770 --> 00:20:19,810
.فهمت

297
00:20:20,220 --> 00:20:21,370
...أُم

298
00:20:21,370 --> 00:20:23,230
!دعوني أذهب

299
00:20:23,600 --> 00:20:25,610
.لا يمكنني العودة هكذا

300
00:20:26,310 --> 00:20:27,380
.لا تهتمي لها

301
00:20:27,730 --> 00:20:29,440
.حسناً, شكراً لك

302
00:20:30,280 --> 00:20:32,650
.أنا لا أصدق ذلك

303
00:20:32,950 --> 00:20:36,020
.لقد فشلت في أول يوم لي في المدرسة

304
00:20:36,020 --> 00:20:38,510
.إنه ليس فشلاً على الإطلاق

305
00:20:38,950 --> 00:20:42,040
لقد كان من الممتع المجيء إلى المدرسة معك

306
00:20:42,040 --> 00:20:45,580
.و التسكع معاً

307
00:20:45,880 --> 00:20:49,480
.كان اليوم متألقاً بشكل مذهل

308
00:20:50,760 --> 00:20:52,090
...ماناتسو

309
00:20:54,300 --> 00:20:56,410
.ستكون المدرسة ممتعة غداً أيضاً

310
00:20:59,640 --> 00:21:00,560
.بالتأكيد

311
00:21:00,970 --> 00:21:03,600
ماذا بشأن النادي الآن؟

312
00:21:04,020 --> 00:21:07,780
.نعم, يمكنني الإنضمام إلى نادي السباحة لو أرادوا

313
00:21:07,780 --> 00:21:10,160
.أنا متأكدة بأنهم لا يريدون ذلك

314
00:21:10,160 --> 00:21:11,090
.نعم

315
00:21:11,570 --> 00:21:14,930
.انضمي إلى النادي الاستوائي إذاً يا لورا

316
00:21:17,450 --> 00:21:19,150
.حسناً

317
00:21:19,150 --> 00:21:22,100
.بما أنكم طلبتم فسأنضم لكم إذاً

318
00:21:22,410 --> 00:21:25,020
لماذا تتصرف بتعالي؟

319
00:21:25,020 --> 00:21:26,360
.بالضبط

320
00:21:26,360 --> 00:21:27,750
.لأنها لورا

321
00:21:29,210 --> 00:21:30,940
!هذا مذهل, مرحى

322
00:21:32,260 --> 00:21:34,040
.هذا فمك أنتِ

323
00:21:34,040 --> 00:21:38,490
لقد قلتِ كل هذا و لكنكِ أردتِ الإنضمام إلينا, صحيح؟

324
00:21:38,850 --> 00:21:41,010
,أصمتِ

325
00:21:41,510 --> 00:21:43,590
ما نشاط النادي التالي؟

326
00:21:43,590 --> 00:21:47,060
.نعم, هناك الكثير من الأشياء لفعلها

327
00:21:47,060 --> 00:21:50,600
.لقد خططت مسبقاً و خرجت بقائمة

328
00:21:50,600 --> 00:21:52,570
.لنفعلها يا لورا

329
00:21:52,570 --> 00:21:54,060
.متألق جداً

330
00:21:54,060 --> 00:21:57,790
.إذاً فأنتِ تنوين الإنضمام إلى النادي الاستوائي

331
00:21:57,790 --> 00:21:58,730
.يبدو ذلك

332
00:21:58,730 --> 00:22:00,940
.أنتِ متحمسة للغاية يا لورا

333
00:22:00,940 --> 00:22:03,490
!أنتم تتكلمون كثيراً

334
00:22:06,250 --> 00:22:09,080
.جميعاً, سترقصون معي اليوم

335
00:22:13,630 --> 00:22:15,530
.لنفعل ذلك بشكل جميل

336
00:23:46,640 --> 00:23:47,810
قصص الأشباح في المدرسة؟

337
00:23:47,930 --> 00:23:49,080
.يبدو ذلك مخيفاً

338
00:23:49,350 --> 00:23:52,040
...حورية بحر تتحدث عند الجبال

339
00:23:52,040 --> 00:23:53,530
.سوف ألعنك

340
00:23:56,320 --> 00:23:57,970
.أحمر شفاه استوائي! بريكور

341
00:23:57,970 --> 00:24:00,930
!ذعر ماناتسو
!أساطير المدرسة السبع

342
00:24:01,280 --> 00:24:03,030
!دعونا نتألق جميعاً