1
00:00:06,570 --> 00:00:08,610
أهذا ما يعجبك؟

2
00:00:08,610 --> 00:00:09,890
.نعم

3
00:00:09,890 --> 00:00:14,240
يعجبكِ هذا النّوع من الشباب إذًا؟

4
00:00:18,860 --> 00:00:20,490
.تُعجبني الأغنية

5
00:00:22,510 --> 00:00:24,110
.أتفهمك

6
00:00:24,110 --> 00:00:26,430
لِم يقول الأهل مثل ذلك الكلام؟

7
00:00:26,430 --> 00:00:29,240
.ليس وكأنّنا نتخيل مواعدتهم

8
00:00:29,240 --> 00:00:30,620
صحيح؟

9
00:00:30,620 --> 00:00:33,270
تعلمين أنّني مهتمة بالفتيات
أكثر؟ مثل النجمات؟

10
00:00:33,270 --> 00:00:37,010
يبدو أنّ والديّ يظنان أنّني
.أريد أن أصبح نجمة

11
00:00:37,010 --> 00:00:38,530
!محال

12
00:00:38,530 --> 00:00:40,520
.لا يفهمان الأمر إطلاقًا

13
00:00:40,520 --> 00:00:42,260
.كلّهم تناقضات

14
00:00:42,260 --> 00:00:43,870
.أقصد أهلنا ومعلّمينا

15
00:00:43,870 --> 00:00:44,960
.صحيح

16
00:00:44,960 --> 00:00:45,640
.آسا

17
00:00:46,210 --> 00:00:48,850
.يمكنكِ فعل ما تشائين

18
00:00:49,500 --> 00:00:51,510
.اصبحي ما تشائين

19
00:00:52,220 --> 00:00:54,210
.آمل ألّا أصبح بالغة مثلهم

20
00:00:54,210 --> 00:00:55,280
!أكيد

21
00:00:55,750 --> 00:00:58,620
.سأكون إلى جانبك دائمًا

22
00:00:59,170 --> 00:01:00,990
اتفقنا يا آسا؟

23
00:01:08,880 --> 00:01:12,900
بالمناسبة، هلّا تشترين ورق
مرحاض أثناء عودتكِ؟

24
00:01:12,900 --> 00:01:14,250
.حسنًا

25
00:01:17,720 --> 00:01:19,940
.كانت أمّي تفعل هذا أيضًا

26
00:01:19,940 --> 00:01:22,410
.كانت تقف هكذا دائمًا عندما أغادر

27
00:01:24,910 --> 00:01:27,370
.ربّما ورثنا العادة من أمّنا

28
00:01:27,370 --> 00:01:29,500
هل أستطيع صبغ شعري؟

29
00:01:29,500 --> 00:01:31,190
لماذا؟

30
00:01:31,190 --> 00:01:33,530
.نصحتني إيميري بذلك

31
00:01:33,530 --> 00:01:38,710
.لا، هذا ليس قصدي
.قصدتُ أنّك لا تحتاجين موافقتي

32
00:01:39,090 --> 00:01:41,500
.لا مانع ما دامت مدرستك تسمح

33
00:01:48,610 --> 00:01:52,400
تاكومي-سان، صحيح؟
.نحن في نفس الفصل

34
00:01:52,400 --> 00:01:55,130
.موري-سان. يمكنك مناداتي آسا

35
00:01:55,130 --> 00:01:57,930
.حسنًا. نادِني موري إذًا

36
00:01:57,930 --> 00:01:59,160
هل قررتِ؟

37
00:01:59,710 --> 00:02:01,890
لا. ماذا عنك؟

38
00:02:01,890 --> 00:02:03,060
.لا أدري

39
00:02:03,560 --> 00:02:05,820
أكنتِ في نادٍ بالمدرسة الإعدادية؟

40
00:02:05,820 --> 00:02:06,860
.نادي الجوقة

41
00:02:06,860 --> 00:02:08,480
لِم لا تنضمين إليه؟

42
00:02:08,480 --> 00:02:10,320
.نادي الجوقة هنا ممتاز على ما يبدو

43
00:02:11,260 --> 00:02:13,300
هل قررت؟

44
00:02:13,300 --> 00:02:14,480
.ليس بعد

45
00:02:14,480 --> 00:02:17,010
...لا يهمني الأمر حقًا

46
00:02:17,010 --> 00:02:18,410
.أنا أيضًا

47
00:02:20,590 --> 00:02:23,490
.أتساءل كيف يقرر الآخرون

48
00:02:23,490 --> 00:02:25,190
ألستِ مهتمة بأيّ شيء؟

49
00:02:27,040 --> 00:02:29,990
.كنتُ في نادي كرة الريشة

50
00:02:29,990 --> 00:02:31,470
.ليس هذا

51
00:02:31,470 --> 00:02:32,920
...حسنًا إذًا

52
00:02:33,850 --> 00:02:35,830
ماذا عن الجوقة الغنائية؟

53
00:02:35,830 --> 00:02:37,750
أنت تُحبّين الغناء، صحيح يا آسا؟

54
00:02:37,750 --> 00:02:40,410
هل تتذكرين مسابقة الجوقة في الصف الرابع؟

55
00:02:40,410 --> 00:02:42,110
.اجتهدتِ كثيرًا من أجلها

56
00:02:42,110 --> 00:02:43,760
الجوقة إذًا؟

57
00:02:43,760 --> 00:02:45,060
.تقرر الأمر

58
00:02:45,060 --> 00:02:47,770
.الأم أدرى دائمًا

59
00:02:49,510 --> 00:02:51,160
.أقول القميص ذو المربعات

60
00:02:51,650 --> 00:02:54,910
.لا، أكلنا طماطم أمس

61
00:02:55,360 --> 00:02:59,310
.ألم تقرري بعد؟ سأختار لكِ إذًا

62
00:02:59,980 --> 00:03:01,680
.ليس هناك يا آسا

63
00:03:02,520 --> 00:03:05,680
.عليك أن تتعلّمي اتخاذ قراراتكِ بنفسك

64
00:03:06,440 --> 00:03:09,170
يا إلهي. ماذا فعلتِ بشعرك؟

65
00:03:09,430 --> 00:03:11,360
.تبدين مثل صبي

66
00:03:12,980 --> 00:03:14,660
!هذا جميل جدًا

67
00:03:14,660 --> 00:03:16,530
!تبدين جميلة يا آسا

68
00:03:16,530 --> 00:03:19,170
.أنت الوحيدة التي أعجبها هذا

69
00:03:19,170 --> 00:03:21,830
ماذا؟ أتقصدين أنّه لا يعجب والداكِ؟

70
00:03:21,830 --> 00:03:25,170
.لا أظن. سأضطر لإقناعهما

71
00:03:25,920 --> 00:03:27,240
كيف؟

72
00:03:27,240 --> 00:03:30,180
...حسنًا، ربّما في عطلة الربيع، سوف

73
00:03:34,710 --> 00:03:35,440
!حادث سيارة

74
00:03:35,440 --> 00:03:37,180
هل نتصل بالشرطة؟ بالإسعاف؟

75
00:03:37,180 --> 00:03:37,990
ماذا حدث؟

76
00:03:37,400 --> 00:03:38,930
...لا يبدو هذا جيدًا

77
00:03:38,040 --> 00:03:40,160
!أحضروا موظفًا هنا

78
00:03:41,560 --> 00:03:44,940
لا يمكن أن نقرر في الحال، صحيح؟

79
00:03:44,940 --> 00:03:46,840
.إلى اللقاء

80
00:03:46,840 --> 00:03:48,460
...نعم، حسنًا

81
00:03:49,170 --> 00:03:52,330
ما هذا الشعور؟
.أجهل السبب لكنّني منزعجة

82
00:03:52,830 --> 00:03:53,830
لكن، من ماذا؟

83
00:03:54,790 --> 00:03:56,020
...لا أعرف

84
00:03:57,450 --> 00:03:59,460
!تصاعد الدخان من ماكينة خياطتها

85
00:03:59,990 --> 00:04:01,960
كيف يعقل ذلك؟

86
00:04:01,960 --> 00:04:02,710
!إيميري

87
00:04:02,710 --> 00:04:03,900
!أنا جادّة

88
00:04:10,230 --> 00:04:12,480
.لكنّها... لم تعد هنا، صحيح؟ أقصد أمك

89
00:04:13,590 --> 00:04:14,860
.آسا

90
00:04:15,980 --> 00:04:18,240
.اصبحي ما تشائين

91
00:04:19,760 --> 00:04:21,120
.كاذبة

92
00:04:21,500 --> 00:04:23,330
...سأكون دائمًا

93
00:04:23,330 --> 00:04:24,970
.متناقضة

94
00:04:26,580 --> 00:04:28,010
.أنا مستاءة

95
00:06:05,020 --> 00:06:07,170
...ماكيو كوداي

96
00:06:23,460 --> 00:06:24,330
ماذا؟

97
00:06:24,680 --> 00:06:27,150
.إلى منزل جدتي. السبت القادم

98
00:06:27,150 --> 00:06:28,400
هل تريدين الذهاب؟

99
00:06:28,400 --> 00:06:31,800
،بدت قلقة عندما اتصلتُ بها

100
00:06:31,800 --> 00:06:34,510
.وكنتُ أزورها مع أمّي دائمًا

101
00:06:34,970 --> 00:06:37,200
.ربّما لم أعُد إلى المنزل منذ أكثر من 5 سنوات

102
00:06:37,200 --> 00:06:38,640
لماذا؟

103
00:06:38,640 --> 00:06:40,850
.بلا سبب

104
00:06:41,590 --> 00:06:43,530
.موافقة، لنذهب

105
00:06:44,510 --> 00:06:48,330
.أهلًا وسهلًا يا آسا-تشان

106
00:06:48,330 --> 00:06:50,410
هل كنتِ تعتنين بها؟

107
00:06:50,410 --> 00:06:51,630
.أظنّ ذلك

108
00:06:51,630 --> 00:06:55,020
.هيّا لنشرب الشاي
.لدي بعض الكعك

109
00:06:55,020 --> 00:06:56,610
.شكرًا لاستضافتي

110
00:06:57,520 --> 00:07:00,050
.سأذهبُ لأرتب أغراضي أولًا

111
00:07:00,860 --> 00:07:03,920
.اجلسي لشرب كوب شاي على الأقل

112
00:07:03,920 --> 00:07:05,850
.كوب الشاي ذاك يستغرق وقتًا طويلًا

113
00:07:05,850 --> 00:07:08,920
.سأعدّه بنفسي إن عطشت

114
00:07:08,920 --> 00:07:09,670
.يا للعجب

115
00:07:09,670 --> 00:07:11,670
أليست قاسية؟

116
00:07:11,670 --> 00:07:13,320
.لا تكوني مثلها

117
00:07:13,320 --> 00:07:15,490
.والآن، ادخلي إلى هنا

118
00:07:28,060 --> 00:07:31,590
ما زلتِ تقرئين كتب أطفال كهذه؟

119
00:07:31,950 --> 00:07:34,760
.كنتِ تقرئينها أيضًا

120
00:07:34,760 --> 00:07:37,010
.لم أعد أقرأها

121
00:07:37,920 --> 00:07:39,690
!لن أعيرك كتبي مجددًا إذًا

122
00:07:39,690 --> 00:07:41,210
!لا مشكلة

123
00:07:51,650 --> 00:07:54,930
.لا أحبّ أن تنهال عليّ كلّ هذه الذكريات

124
00:07:58,810 --> 00:08:00,260
ألا يجب أن تنعطفي يمينًا هنا؟

125
00:08:00,260 --> 00:08:02,360
.يوجد طريق مخفي بلا شك

126
00:08:03,000 --> 00:08:05,000
!انتبهي! إنّهم قادمون

127
00:08:05,000 --> 00:08:07,370
!اصمتي يا أختي

128
00:08:05,000 --> 00:08:08,670
!انعطفي يمينًا! سيمسكون بك

129
00:08:06,720 --> 00:08:09,810
!كلاكما! اجلسا بعيدًا عن التلفاز

130
00:08:11,580 --> 00:08:13,000
ماذا عن الجامعة؟

131
00:08:13,000 --> 00:08:14,620
هل قررت؟

132
00:08:15,070 --> 00:08:17,730
.بدأت الثانوية للتو يا جدّتي

133
00:08:17,730 --> 00:08:20,870
.صحيح. بالطبع

134
00:08:20,870 --> 00:08:23,850
مينوري وماكيو اختارا مبكرًا
لذا سألتك تلقائيًا

135
00:08:24,540 --> 00:08:25,920
أمّي فعلت؟

136
00:08:25,920 --> 00:08:31,410
.نعم. كانت مينوري دائمًا أفضل من يُصغي إليّ

137
00:08:31,410 --> 00:08:33,640
.كنّا نتحدث معًا طيلة اليوم

138
00:08:34,060 --> 00:08:36,030
...عكس الأخرى

139
00:08:40,180 --> 00:08:42,000
.سأذهب لأساعد ماكيو-تشان

140
00:08:43,000 --> 00:08:45,150
ألا تريدين أن ترتاحي قليلًا بعد؟

141
00:08:45,150 --> 00:08:46,760
.سأعود حالًا

142
00:08:51,310 --> 00:08:53,030
ماكيو-تشان؟

143
00:08:59,550 --> 00:09:00,310
...أمّي

144
00:09:00,710 --> 00:09:02,050
آسا؟

145
00:09:02,050 --> 00:09:03,180
أمن خطب ما؟

146
00:09:03,810 --> 00:09:06,810
دخلتِ غرفة أختي من قبل، صحيح؟

147
00:09:07,220 --> 00:09:09,850
لِم لا تأخذين شيئًا معك إن أردتِ؟

148
00:09:13,560 --> 00:09:16,880
هل حدث شيء مع أمّي؟

149
00:09:16,880 --> 00:09:17,960
.لا شيء يذكر

150
00:09:17,960 --> 00:09:18,960
.حسنًا

151
00:09:19,310 --> 00:09:22,910
هل تكرهين جدّتي أيضًا يا ماكيو-تشان؟

152
00:09:23,420 --> 00:09:25,960
...أنا لا أكره الجميع لعلمك

153
00:09:26,690 --> 00:09:33,220
...لكن عليّ الاعتراف
.أنّها صارت بليدة وظالمة

154
00:09:33,560 --> 00:09:36,660
،ربّما لأنّنا غادرنا المنزل، مات أبي

155
00:09:36,660 --> 00:09:39,680
.وبدأت تقضي وقتًا أطول وحدها

156
00:09:40,580 --> 00:09:42,980
...بليدة وظالمة

157
00:09:43,220 --> 00:09:46,840
.كانت تمدحنا سابقًا

158
00:09:46,840 --> 00:09:50,090
كانت تقول أنّ مينوري
عطوفة وأنا معتمدة على نفسي

159
00:09:50,090 --> 00:09:51,980
،لكن مع الوقت

160
00:09:51,980 --> 00:09:56,480
صار الأمر أنّ مينوري تفتقر
.للاستقلالية وأنا قاسية

161
00:09:57,150 --> 00:10:00,110
.وذلك أحزنني

162
00:10:00,470 --> 00:10:02,490
...لكن أتذكر أنّ جدتي قالت

163
00:10:02,490 --> 00:10:06,210
كيف تموتين قبل أمك؟

164
00:10:06,210 --> 00:10:08,280
.بكت بحرقة

165
00:10:08,280 --> 00:10:12,640
.شعرتُ أنّها كانت تهتم لأمر أختي كثيرًا

166
00:10:13,700 --> 00:10:16,480
.إن شعرتِ بذلك فهذا هو المهم

167
00:10:17,250 --> 00:10:20,970
.أتساءل كيف كانت أمّي حقًا

168
00:10:22,210 --> 00:10:24,930
...ما الذي كانت تفكّر فيه

169
00:10:25,960 --> 00:10:30,420
.هذا أمر لن تعرفيه حتّى لو كانت حيّة

170
00:10:31,000 --> 00:10:33,670
لأنّنا شخصان مختلفان؟

171
00:10:35,060 --> 00:10:36,150
...آسا

172
00:10:37,460 --> 00:10:40,610
.تذكّريها كالأم التي تحبينها

173
00:10:41,940 --> 00:10:46,160
.لهذا السبب لا أشاركك رأيي الشخصي عنها

174
00:10:49,320 --> 00:10:51,110
.أظنني سأذهب لشرب بعض الشاي

175
00:10:57,050 --> 00:11:00,410
.هذا ما كان يعجبها إذًا

176
00:11:01,360 --> 00:11:02,540
.آسا

177
00:11:02,540 --> 00:11:04,940
.اصبحي ما تشائين

178
00:11:07,500 --> 00:11:10,560
.سأصبح الشخص الذي أريده

179
00:11:11,870 --> 00:11:13,060
.شئتِ أم أبيتِ

180
00:11:18,240 --> 00:11:21,850
!خذي هذا معك للمنزل. هيّا

181
00:11:21,010 --> 00:11:23,310
.ليس لدي مكان أضعه فيه

182
00:11:23,310 --> 00:11:25,030
.خذيه فقط

183
00:11:23,930 --> 00:11:26,310
.لا بأس حقًا. حقًا

184
00:11:26,670 --> 00:11:28,620
.أنتِ هكذا دائمًا

185
00:11:30,570 --> 00:11:33,120
.بكت بحرقة

186
00:11:32,700 --> 00:11:35,940
.اعتني بنفسك يا آسا-تشان

187
00:11:35,940 --> 00:11:36,710
.أنا ذاهبة

188
00:11:36,710 --> 00:11:38,600
.أنا ذاهبة أيضًا

189
00:11:38,600 --> 00:11:40,170
.رافقتكما السلامة

190
00:11:40,170 --> 00:11:42,650
.انتبها للسيارات

191
00:11:43,470 --> 00:11:44,730
.أنتِ أيضًا يا ماكيو

192
00:11:45,030 --> 00:11:47,010
لا تنس العادات الصحية

193
00:11:48,590 --> 00:11:49,850
...أمّي

194
00:11:51,410 --> 00:11:53,340
...أنا وأختي

195
00:11:53,340 --> 00:11:55,590
.كان ميؤوسًا منّا

196
00:11:56,550 --> 00:12:01,110
.لذا لا أستطيع مشاركتك حزنك

197
00:12:01,550 --> 00:12:06,790
لكنّني أستطيع الإصغاء إليك
.على الأقل إن احتجتِ

198
00:12:08,110 --> 00:12:11,420
.تضيفين تعليقًا غير ضروري دائمًا

199
00:12:12,120 --> 00:12:15,080
لا أظنّ أنّ من يترنح بنفسه

200
00:12:15,080 --> 00:12:18,630
قادر على تحمل هموم غيره

201
00:12:19,210 --> 00:12:23,170
تعاوني مع آسا-تشان وعيشي حياة صحية

202
00:12:23,660 --> 00:12:25,630
هل الأمر واضح لهذه الدرجة؟

203
00:12:26,030 --> 00:12:28,930
من ربّاكِ برأيك؟

204
00:12:39,770 --> 00:12:41,240
ألن تجيبي؟

205
00:12:41,240 --> 00:12:43,300
.إنّه رقم لا أعرفه

206
00:12:54,700 --> 00:12:55,730
!آسا

207
00:12:56,290 --> 00:12:58,960
.صباح الخير

208
00:12:58,960 --> 00:13:00,800
هل لديك حصّة رياضة اليوم؟

209
00:13:00,800 --> 00:13:02,970
لماذا؟ هل نسيتِ قميص الرياضة؟

210
00:13:02,970 --> 00:13:04,290
.أصبتِ

211
00:13:04,290 --> 00:13:05,420
.سأعطيك إيّاه

212
00:13:05,420 --> 00:13:07,130
.شكرًا

213
00:13:07,130 --> 00:13:09,450
هل اخترتِ ناديًا؟

214
00:13:11,210 --> 00:13:13,300
.صباح الخير يا نارا-سان

215
00:13:13,300 --> 00:13:14,040
.صباح الخير

216
00:13:14,040 --> 00:13:14,880
أهذه صديقتك؟

217
00:13:14,880 --> 00:13:15,820
.نعم، إنّها في الفصل ب

218
00:13:15,820 --> 00:13:17,250
.أنا تاكومي

219
00:13:17,250 --> 00:13:19,090
.أنا ساكوراي

220
00:13:19,090 --> 00:13:20,250
.أراك لاحقًا

221
00:13:23,200 --> 00:13:27,490
اعترف لكِ أوزاوا يوم التخرج، صحيح؟

222
00:13:27,490 --> 00:13:29,120
ماذا؟ كيف علمتِ بهذا؟

223
00:13:29,120 --> 00:13:30,580
.أخبرتني تاكا-تشان

224
00:13:31,250 --> 00:13:33,070
ألا تريدين خليلًا؟

225
00:13:33,070 --> 00:13:36,090
.لستُ متأكدة

226
00:13:37,510 --> 00:13:40,260
هل ذهبتِ إلى مكان ما
خلال أسبوع العطلة الذهبي؟

227
00:13:40,260 --> 00:13:42,490
لا. ماذا عنك يا كوداي-سان؟

228
00:13:42,490 --> 00:13:44,520
.لا، أنا أيضًا لم أفعل

229
00:13:44,520 --> 00:13:46,260
وماذا عن ابنة أختك الصغيرة؟

230
00:13:46,260 --> 00:13:50,590
بخصوص ذلك... أعتذر لأنّني
.اضطررتُ لأخذ إجازة

231
00:13:50,590 --> 00:13:51,900
!لا بأس

232
00:13:51,900 --> 00:13:54,650
كان جميلًا أن أحصل على
.بعض الراحة أنا أيضًا

233
00:13:55,320 --> 00:13:57,780
...لذا بخصوص غلاف المجلّد 2

234
00:13:57,780 --> 00:13:59,090
هل لديك أيّ أفكار؟

235
00:13:59,090 --> 00:14:02,900
.في الواقع، لدي فكرة تصميم بالفعل

236
00:14:02,900 --> 00:14:04,380
.أودّ سماعها

237
00:14:04,380 --> 00:14:06,400
.لا تهتمّا إن لم تعجبكما

238
00:14:06,400 --> 00:14:09,510
تعرفان المشهد الذين ينظر فيه
تول وسايكا إلى الخريطة؟

239
00:14:09,510 --> 00:14:10,570
نعم، ذلك المشهد؟

240
00:14:10,570 --> 00:14:11,670
.ها هي فكرتي

241
00:14:11,950 --> 00:14:13,490
.ها هُو قميصي يا إيميري

242
00:14:13,490 --> 00:14:15,280
!نعم، شكرًا

243
00:14:15,280 --> 00:14:16,670
هل أغسله في المنزل وأعيده؟

244
00:14:16,670 --> 00:14:18,070
.لا، أحتاجه في الحصة الخامسة

245
00:14:18,070 --> 00:14:19,450
.أنقذتِني

246
00:14:19,450 --> 00:14:22,030
.مرحبًا

247
00:14:22,030 --> 00:14:23,530
نلتقي وقت الغداء؟

248
00:14:23,530 --> 00:14:24,300
.نعم

249
00:14:24,790 --> 00:14:26,330
.آسفة على التأخير

250
00:14:26,780 --> 00:14:29,070
إنّهم يلفتون الأنظار حقًا، صحيح؟

251
00:14:29,070 --> 00:14:33,550
نعم. غريب. بما أنّ تاماشيرو-سان كانت
.تتعرض للتنمر في الإعدادية

252
00:14:33,550 --> 00:14:35,050
مهلًا، من؟

253
00:14:35,050 --> 00:14:36,190
.قصيرة الشعر

254
00:14:37,810 --> 00:14:39,480
.أصبحت ضمن المجموعة الرائجة إذًا

255
00:14:39,480 --> 00:14:40,890
.ستكون بخير الآن

256
00:14:40,890 --> 00:14:45,880
اسمعي، لو كان وجهي مثلها
.لتقبّلتُ التنمر بلا اعتراض

257
00:14:45,880 --> 00:14:47,310
هل أنت جادّة؟

258
00:14:49,990 --> 00:14:51,370
!آسا

259
00:14:53,160 --> 00:14:54,810
.تضعين مكياجًا

260
00:14:54,810 --> 00:14:58,360
كان لديّ اجتماع. بعدها
شربت قهوة مع أصدقاء

261
00:14:58,360 --> 00:14:59,800
.تبدين متعبة قليلًا

262
00:14:59,800 --> 00:15:02,790
.هل يظهر ذلك؟ تكلّمت كثيرًا

263
00:15:02,790 --> 00:15:05,640
سيأتي كاساماشي-كن لذا
.لنشتري ما نحتاجه أثناء عودتنا

264
00:15:05,640 --> 00:15:07,350
!رائع

265
00:15:08,200 --> 00:15:10,450
لحظة، تايوان؟ وهل ستذهبين؟

266
00:15:10,450 --> 00:15:11,340
.كانت فكرة دايغو

267
00:15:11,670 --> 00:15:14,520
.لا توجد خطط فعلية بعد. مجرد كلام

268
00:15:17,140 --> 00:15:18,340
.كوداي-سان

269
00:15:18,850 --> 00:15:19,870
نعم...؟

270
00:15:21,820 --> 00:15:24,080
.أنا تونو. أشرف على الوصاية

271
00:15:24,550 --> 00:15:28,100
.التقينا مرّة عند مراجعة أوراق التأمين

272
00:15:28,100 --> 00:15:30,640
حقًا؟

273
00:15:30,640 --> 00:15:33,340
.أعتذر لأنّني لا أتذكّر

274
00:15:37,310 --> 00:15:38,930
.لا تشغلي بالكِ بي

275
00:15:38,930 --> 00:15:42,860
.والأهم، اتصلتُ بك عدّة مرات

276
00:15:42,860 --> 00:15:44,370
هل كنتِ مشغولة؟

277
00:15:44,370 --> 00:15:47,740
.حسنًا... لم أتعرف على الرقم

278
00:15:48,170 --> 00:15:49,960
...وكنتُ منشغلة بالعمل لذا

279
00:15:49,960 --> 00:15:53,640
...فهمت، لندخل في صلب الموضوع الآن

280
00:15:53,640 --> 00:15:54,940
.حسنًا

281
00:15:56,020 --> 00:16:00,270
بخصوص نسخة دفتر حساب آسا-سان
...التي سلّمتِها مؤخرًا

282
00:16:00,270 --> 00:16:03,790
.أعتذر عن الرد المتأخر بخصوص ذلك

283
00:16:03,790 --> 00:16:06,260
...لا بأس. لكن بخصوص المستند

284
00:16:06,960 --> 00:16:11,530
في 30 أبريل، كان هناك
.سحب بمبلغ 300 ألف ين

285
00:16:12,480 --> 00:16:15,030
هل يمكنك أن تفسري ما كان الغرض منه؟

286
00:16:15,030 --> 00:16:17,280
!ثـ-ثلاثمائة ألف ين؟

287
00:16:17,280 --> 00:16:18,930
نقدًا؟

288
00:16:18,930 --> 00:16:20,000
.نعم

289
00:16:20,000 --> 00:16:23,030
مـ-من تركة أختي وزوجها؟

290
00:16:23,030 --> 00:16:25,920
.نعم، كما قلتُ للتو

291
00:16:26,550 --> 00:16:29,710
هل لديك إيصال لعملية السحب هذه؟

292
00:16:29,710 --> 00:16:30,800
...لا

293
00:16:30,800 --> 00:16:33,630
.أيّ سجل في دفتر الحساب المنزلي سيفي بالغرض

294
00:16:34,290 --> 00:16:37,840
...كما شرحتُ من قبل، يا كوداي-سان

295
00:16:37,840 --> 00:16:39,700
بصفتك الوصية، ستكونين ملزمة

296
00:16:39,700 --> 00:16:42,560
بتقديم تقارير الدخل والمصروفات
.من الآن فصاعدًا

297
00:16:42,560 --> 00:16:44,370
...آ-آسفة، لم أستطع بعد أن

298
00:16:44,370 --> 00:16:49,990
توقعتُ أنّك كنتِ على علم بهذا القيد
عندما سلّمتِني دفتر الحساب

299
00:16:49,990 --> 00:16:51,970
أم لم تكوني كذلك؟

300
00:16:50,760 --> 00:16:54,690
مـ-مهلًا. هـ-هل يمكنك التحدث ببطء؟

301
00:16:56,020 --> 00:16:59,190
.كلّ هذا دفعة واحدة يخيفني

302
00:17:00,250 --> 00:17:01,440
يخيفك؟

303
00:17:02,430 --> 00:17:03,600
.آسفة بشأن هذا

304
00:17:04,340 --> 00:17:09,670
لم أستخدم هذا الحساب
.إلّا لمصاريف المدرسة ومصروفها

305
00:17:09,670 --> 00:17:12,240
.كلّ مصاريفنا اليومية تأتي من حسابي

306
00:17:12,570 --> 00:17:17,330
.وأنشأتُ تحويلًا تلقائيًا لمصروفها

307
00:17:17,330 --> 00:17:18,730
.وإلّا كنتُ سأنسى

308
00:17:19,370 --> 00:17:20,920
...لذا للرد على كلامك

309
00:17:20,920 --> 00:17:24,870
أعتذر. لم ألاحظ هذا عندما
.أرسلتُ نسخة من دفتر الحساب

310
00:17:25,450 --> 00:17:29,230
...لذا ليس لديّ فكرة عن مبلغ 300 ألف ين هذا

311
00:17:31,200 --> 00:17:32,740
.اعذريني

312
00:17:32,740 --> 00:17:35,620
.تعاملتُ معك بحدّة

313
00:17:35,620 --> 00:17:41,220
كنتُ مركزًا على حقوق الطفلة
حتّى أنّني انفعلتُ

314
00:17:41,730 --> 00:17:43,640
،وبما أنّك لم تردي على مكالماتي

315
00:17:43,640 --> 00:17:45,350
.ظننتُكِ من النوع الوقح

316
00:17:46,330 --> 00:17:49,920
...أعتذر لكوني وقحة

317
00:17:49,920 --> 00:17:52,430
!لم أقصد هذا! أعتذر

318
00:17:52,430 --> 00:17:56,740
لا، لا بأس. لا أجيد فعل أمور
.عادية مثل شخص عادي

319
00:17:56,740 --> 00:17:57,960
.حاسوب

320
00:17:58,960 --> 00:18:02,600
.اشتريتُ حاسوبًا. حاسوب ماك محمول

321
00:18:02,600 --> 00:18:03,420
!ماذا؟

322
00:18:03,420 --> 00:18:05,810
أكان شيئًا احتجتهِ للمدرسة؟

323
00:18:05,810 --> 00:18:06,940
.لا

324
00:18:07,320 --> 00:18:10,260
هل أخبركِ أحد بشرائه؟

325
00:18:10,900 --> 00:18:12,230
.لا

326
00:18:12,660 --> 00:18:13,790
آسا؟

327
00:18:15,040 --> 00:18:16,260
ما الخطب؟

328
00:18:18,730 --> 00:18:23,370
حسبتُ أنّ بوسعي تأليف موسيقى
.بنفسي باستخدام حاسوب محمول

329
00:18:23,940 --> 00:18:27,090
خشيت أن تكوني معارضة
.لانضمامي لنادي الفرقة الموسيقية

330
00:18:27,490 --> 00:18:29,120
...ماذا؟ لكنّني أخبرتكِ

331
00:18:29,500 --> 00:18:34,730
هل سبق أن قيّدت كوداي-سان أفعالك يا آسا-سان؟

332
00:18:35,450 --> 00:18:36,710
.لا

333
00:18:36,710 --> 00:18:40,560
.مشاعرك شأنكِ وحدك

334
00:18:41,240 --> 00:18:44,770
.لا يحق لأحد لومك عليها

335
00:18:44,770 --> 00:18:45,720
.مهما حدث

336
00:18:46,240 --> 00:18:48,150
.لا. ولا قليلًا

337
00:18:48,760 --> 00:18:51,140
...لكنّها بالغة لذا

338
00:18:51,510 --> 00:18:54,050
.ظننتُ أنّها قد ترفض

339
00:18:54,690 --> 00:18:56,480
.اصبحي ما تشائين

340
00:18:57,490 --> 00:19:00,840
...شعرتُ... بحيرة

341
00:19:02,170 --> 00:19:04,050
...أنا آسفة

342
00:19:04,850 --> 00:19:09,650
علينا أن نتحدث عن هذا يا آسا
.لكن في وقت آخر

343
00:19:09,650 --> 00:19:10,880
لِم لا تذهبي لغسل وجهك؟

344
00:19:17,620 --> 00:19:22,210
أخبرتها أنّها تستطيع الانضمام
.إلى نادي الفرقة إن أرادت

345
00:19:22,900 --> 00:19:25,650
.لكنّها ذكرت أن والديها لن يُعجبهما الأمر

346
00:19:26,190 --> 00:19:29,030
.يبدو أنّها في مرحلة البحث عن ذاتها

347
00:19:29,800 --> 00:19:33,190
هذا أمر طبيعي في عمرها
حتّى مع الظروف

348
00:19:36,090 --> 00:19:38,960
إن احتجتِ يومًا التحدث مع شخص
غير كوداي-سان أو معلّم

349
00:19:38,960 --> 00:19:40,440
.فلا تترددي في التواصل معي رجاء

350
00:19:40,440 --> 00:19:42,000
.حسنًا

351
00:19:42,370 --> 00:19:44,390
.أبلغيني إن كان ما بوسعي مساعدتكما به

352
00:19:44,930 --> 00:19:46,960
،ليس لدي خبرة كثيرة

353
00:19:46,960 --> 00:19:51,260
.لذا هذه أول مرة ألتقي بشخص مثلك

354
00:19:51,820 --> 00:19:54,380
...شخص مثلي

355
00:19:54,380 --> 00:19:57,160
!مهلًا، أنا آسف! قصدتُ عملك فقط

356
00:19:57,760 --> 00:20:02,100
شخص لا يرد على المكالمات
...وبالكاد يلتزم بالمواعيد النهائية

357
00:20:02,100 --> 00:20:04,550
!أنا هنا لدعمكم ودعم حياتكما معًا

358
00:20:04,970 --> 00:20:06,210
...لذا رجاء

359
00:20:07,630 --> 00:20:11,180
.اسمحي لي بالمساعدة من الآن فصاعدًا

360
00:20:12,840 --> 00:20:16,180
.نعم، شكرًا

361
00:20:19,030 --> 00:20:21,320
.أهلًا كاساماشي-كن. تفضل بالدخول

362
00:20:21,320 --> 00:20:24,370
.مرحبًا... أحضرت بعض المحار

363
00:20:24,370 --> 00:20:25,850
.تشرفت بلقائك

364
00:20:25,850 --> 00:20:27,820
.أنا تومو، محامٍ

365
00:20:28,210 --> 00:20:31,010
هل أنت خليل كوداي-سان؟

366
00:20:33,850 --> 00:20:35,840
ماك إذًا؟

367
00:20:35,840 --> 00:20:38,090
.سأشتريه إن أردتِ

368
00:20:38,090 --> 00:20:41,440
.هذا سيُعقد الأمور أكثر

369
00:20:41,440 --> 00:20:42,710
.معك حق

370
00:20:44,110 --> 00:20:47,210
لكن محامي إذًا؟

371
00:20:48,830 --> 00:20:50,070
تعبتِ؟

372
00:20:50,070 --> 00:20:53,590
.نعم... يمكنك قول ذلك

373
00:20:56,260 --> 00:20:59,160
.تخيلي أنّك بين ذراعي كلب ضخم فقط

374
00:21:00,260 --> 00:21:01,860
.كلب بيرنبيس الجبلي

375
00:21:01,860 --> 00:21:03,250
بهذه الضخامة؟

376
00:21:03,670 --> 00:21:07,160
تذكرت، فعلتُ الشيء نفسه
.مع آسا قبل أيام

377
00:21:07,550 --> 00:21:09,630
.لا بدّ أنّني تعلّمته منك

378
00:21:13,630 --> 00:21:16,280
.أعتقد أنّ آسا تحبّ هذه الأغنية

379
00:21:16,280 --> 00:21:17,970
.تُغنّيها أحيانًا

380
00:21:17,970 --> 00:21:19,380
!آسا

381
00:21:19,380 --> 00:21:20,850
!آسا-سان

382
00:21:21,750 --> 00:21:24,420
.إنّها الفرقة التي تعجبك
.إنّهم على التلفاز

383
00:21:26,510 --> 00:21:28,600
.هل تريدن المشاهدة؟ تعالي

384
00:21:33,300 --> 00:21:34,620
.نحن متلاصقون

385
00:21:34,620 --> 00:21:35,810
هل يعجبك هذا؟

386
00:21:35,810 --> 00:21:39,950
.نعم، أحبّ نغمة الباس هذه

387
00:21:39,950 --> 00:21:42,890
.ذوق رائع. أذنك حساسة للموسيقى

388
00:21:42,890 --> 00:21:44,290
.صحيح

389
00:21:46,320 --> 00:21:47,730
...ماكيو-تشان

390
00:21:48,840 --> 00:21:52,110
هل أستطيع الانضمام لنادي الفرقة الموسيقية؟

391
00:21:52,720 --> 00:21:56,550
.بالطبع. افعلي ما تريدين فعله

392
00:21:57,680 --> 00:21:59,970
.نعم، سأفعل

393
00:22:00,770 --> 00:22:03,740
!هنا! عزف الباس هذا

394
00:22:04,570 --> 00:22:06,430
.رائع جدًا