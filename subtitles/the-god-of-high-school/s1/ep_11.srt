1
00:00:06,280 --> 00:00:08,270
،في غابر الأزمان الخرافيّة

2
00:00:08,270 --> 00:00:13,660
سكن في النّعيم ثعلب ذو تسعة
ذيول كسب قوّةً هائلة

3
00:00:13,660 --> 00:00:15,000
.بعد تدريبات دامت ألف سنة

4
00:00:16,010 --> 00:00:19,210
ليُعيّن إثر ذلك حارسًا على الإله
،الّذي حكم النّعيم

5
00:00:19,210 --> 00:00:21,620
.حيث قام بصدّ أزمات لا حصر لها

6
00:00:22,150 --> 00:00:26,060
،لكن، حتّى الإله بدأ يخاف من الرّوح الثّعلب

7
00:00:26,060 --> 00:00:30,090
.إلى أن أمر بإعدامه في الأخير

8
00:00:32,320 --> 00:00:34,430
،بعد أن اعتراه غضب الخيانة

9
00:00:34,430 --> 00:00:38,700
،سخّر الرّوح الثّعلب قوّته لتدمير نصف النّعيم

10
00:00:38,700 --> 00:00:40,350
.ثمّ نزل إلى الأرض

11
00:00:44,490 --> 00:00:47,560
،وبعد أن خارت كلّ قواه

12
00:00:47,560 --> 00:00:50,490
،أقسم الرّوح الثّعلب على الثّأر من الإله

13
00:00:50,490 --> 00:00:51,990
.ليخلد بعد ذلك في سبات عميق

14
00:02:41,790 --> 00:02:44,170
مـ-ما هذا الشّعور؟

15
00:02:44,170 --> 00:02:47,180
...وكأنّ شيئًا بداخلي يرتعش

16
00:02:53,870 --> 00:02:56,430
.التشاريوك خاصّتي تهتزّ

17
00:02:56,880 --> 00:02:58,580
أهو المفتاح؟

18
00:03:09,320 --> 00:03:10,740
.لا مجال للشّكّ

19
00:03:10,740 --> 00:03:14,490
هذه طاقة الرّوح الثّعلب ذي التّسعة ذيول

20
00:03:14,490 --> 00:03:16,450
!الّذي دمّر نصف النّعيم في غابر الأزمان

21
00:03:17,410 --> 00:03:19,710
...القوّة الّتي تتحدّى الإله

22
00:03:19,710 --> 00:03:23,210
.سأحرص أن ترقد أبد الدّهر هذه المرّة

23
00:03:25,650 --> 00:03:27,970
أتظنّ أنّني سأدعك تهرب؟

24
00:03:33,560 --> 00:03:35,970
.أنا واثق أنّ ذلك لن يكون سهلاً

25
00:03:40,730 --> 00:03:42,480
ماذا؟ سونغا؟

26
00:03:42,480 --> 00:03:44,700
!مهلاً، مهلاً، مهلاً، مهلاً، مهلاً! سونغا؟

27
00:03:44,700 --> 00:03:46,230
!أنفك ينزف؟

28
00:03:47,800 --> 00:03:50,610
.ما هذه إلاّ البداية يا جين موري

29
00:03:51,520 --> 00:03:53,010
!يبدو هذا ممتعًا

30
00:03:53,720 --> 00:03:54,750
.ابقَ هادئًا

31
00:03:54,750 --> 00:03:56,870
.اكتشف ما هي قدراته

32
00:04:02,130 --> 00:04:05,880
.لم تهاجم بتهوّر. قرار جيّد

33
00:04:12,340 --> 00:04:14,700
.تايكيون: عابريّة الحياة

34
00:04:39,460 --> 00:04:40,710
...إنّه قويّ

35
00:04:40,710 --> 00:04:41,830
...أجل

36
00:04:41,830 --> 00:04:44,930
...سحقًا... لن

37
00:04:47,590 --> 00:04:49,090
.أخسر

38
00:04:51,970 --> 00:04:53,100
!ها أنا ذا

39
00:04:58,470 --> 00:04:59,770
!تايكيون

40
00:04:59,770 --> 00:05:01,340
!عابريّة الحياة

41
00:05:03,350 --> 00:05:05,500
!إعصار التّنّين الأزرق

42
00:05:15,280 --> 00:05:16,660
.لن ينفعك ذلك ثانيةً

43
00:05:17,280 --> 00:05:19,080
—ما

44
00:05:24,230 --> 00:05:25,370
...إنّه قويّ

45
00:05:25,850 --> 00:05:27,710
...كيف لي

46
00:05:33,720 --> 00:05:37,350
.ما الخطب؟ يبدو وكأنّك متألّم جدًّا

47
00:05:37,850 --> 00:05:40,350
.لا شيء يدعو للقلق

48
00:06:11,400 --> 00:06:12,930
.هذه هي إذًا

49
00:06:12,930 --> 00:06:17,430
.لا تتعلّق التشاريوك باستعارة قوّة أحد آخر

50
00:06:22,140 --> 00:06:23,650
...ويحي

51
00:06:24,170 --> 00:06:28,100
.في الأخير، أنت تقاتل بعقلك وجسدك

52
00:06:28,100 --> 00:06:29,230
...ما يعني

53
00:06:29,900 --> 00:06:32,030
.نحن الاثنان سيّان

54
00:06:36,310 --> 00:06:37,200
...إنّه

55
00:06:37,860 --> 00:06:39,570
.لم يستسلم بعد

56
00:07:07,650 --> 00:07:09,060
.لننهِ هذا

57
00:07:20,260 --> 00:07:23,080
،كنتَ قويًّا بحقّ

58
00:07:24,580 --> 00:07:26,450
.يا جين موري

59
00:08:29,680 --> 00:08:31,170
ما ذلك؟

60
00:08:31,170 --> 00:08:32,690
هل كلّ شيء بخير؟

61
00:08:47,320 --> 00:08:50,220
ماذا... تكون؟

62
00:08:58,660 --> 00:09:01,090
!مسيرة 100 شيطان اللّيليّة

63
00:09:59,850 --> 00:10:02,430
!سقط بارك إيلبيو

64
00:10:02,430 --> 00:10:05,200
!الفائز: جين موري

65
00:10:09,910 --> 00:10:12,480
!أحسنت صنعًا يا موري

66
00:10:12,480 --> 00:10:13,660
...مهلاً

67
00:10:13,660 --> 00:10:14,790
!تهانينا

68
00:10:16,450 --> 00:10:17,630
!إنّي أثني عليك

69
00:10:18,190 --> 00:10:20,920
ما كان ذلك؟ تشاريوك؟

70
00:10:22,120 --> 00:10:24,920
ما كان ذلك بالضّبط؟

71
00:10:25,450 --> 00:10:27,980
!إيلبيو! إيلبيو

72
00:10:28,550 --> 00:10:29,800
!إيلبيو

73
00:10:34,260 --> 00:10:37,300
...ماذا؟ هل

74
00:10:41,980 --> 00:10:43,160
...فهمت

75
00:10:43,820 --> 00:10:46,820
خسر ذو الذّيول التّسعة؟

76
00:10:47,290 --> 00:10:50,450
ما كانت تلك الطّاقة قبل لحظات؟

77
00:10:54,120 --> 00:10:57,600
.يبدو أنّه سيكون من الحكمة توخّي الحذر

78
00:10:59,540 --> 00:11:00,670
!تبًّا

79
00:11:06,020 --> 00:11:08,240
.سأستأذن نفسي الآن

80
00:11:20,390 --> 00:11:21,080
مرحبًا؟

81
00:11:21,080 --> 00:11:22,460
هل انتهى؟

82
00:11:22,460 --> 00:11:23,730
.نعم

83
00:11:23,730 --> 00:11:26,760
.إذًا احموا المفتاح على الفور

84
00:11:27,240 --> 00:11:30,740
،حسنًا... يحتاج إلى فحص طبّيّ وعلاج أوّلاً

85
00:11:30,740 --> 00:11:33,250
.لذا سنأخذه إلى جناح المشفى ونوفّر له الأمن

86
00:11:33,990 --> 00:11:35,200
.فهمت

87
00:11:51,550 --> 00:11:53,540
،يبدو أنّه تمّ الاعتناء بكلّ شيء

88
00:11:53,540 --> 00:11:55,510
.لذا يجدر أن نستطيع التّحرّك قريبًا

89
00:11:59,090 --> 00:12:01,490
.ما زال مانداك يخطّط لشيء

90
00:12:19,020 --> 00:12:21,030
!شكرًا

91
00:12:25,370 --> 00:12:27,560
.آسف لأنّي خسرت

92
00:12:28,280 --> 00:12:30,490
.لم تكن قوّتي كافية

93
00:12:30,490 --> 00:12:31,860
!ذلك ليس صحيحًا

94
00:12:31,860 --> 00:12:33,060
!أجل

95
00:12:33,060 --> 00:12:35,350
!أبليت جيّدًا وأكثر

96
00:12:35,350 --> 00:12:37,170
!كانت تلك التشاريوك، صحيح؟

97
00:12:38,090 --> 00:12:39,300
.على الأرجح

98
00:12:40,500 --> 00:12:42,170
.أنا متفاجئ أيضًا

99
00:12:42,850 --> 00:12:45,630
إذًا... هل استطعت الوفاء بوعدك؟

100
00:12:47,520 --> 00:12:50,390
.جزئيًّا على ما أظنّ

101
00:12:50,860 --> 00:12:55,140
الوعد الّذي قطعته ليس بوعدٍ
.يمكن الوفاء به على الفور

102
00:12:55,570 --> 00:12:58,060
.أدركت ذلك بينما أقاتله

103
00:12:59,900 --> 00:13:01,270
.فهمت

104
00:13:06,530 --> 00:13:07,500
ماذا؟

105
00:13:08,720 --> 00:13:09,910
!أهلاً

106
00:13:10,910 --> 00:13:12,160
كيف الحال؟

107
00:13:12,940 --> 00:13:16,000
.يا إلهي... تحدّثنا عنه فألقت به الرّياح

108
00:13:16,000 --> 00:13:17,590
.إنّه شديد

109
00:13:21,280 --> 00:13:22,670
كيف حالك الآن؟

110
00:13:22,670 --> 00:13:24,420
.أنا بخير

111
00:13:24,870 --> 00:13:25,920
وأنت؟

112
00:13:25,920 --> 00:13:29,180
.حالي أفضل من حالك بكثير كما ترى

113
00:13:29,180 --> 00:13:33,180
.لا، إنّما أفعل ما طلبته منّي الممرّضات

114
00:13:33,180 --> 00:13:35,930
.أنا أفضل صحّة منّك

115
00:13:35,930 --> 00:13:37,680
.لا تحاول جاهدًا يا صاح

116
00:13:37,680 --> 00:13:39,620
.أظنّك من يحاول جاهدًا

117
00:13:39,620 --> 00:13:40,820
!أنا بأفضل حال

118
00:13:40,820 --> 00:13:43,050
.كلاّ، ما زال عليك أن تكون حذرًا

119
00:13:42,260 --> 00:13:45,110
!توقّفا كلاكما! لستما طفلين

120
00:13:43,050 --> 00:13:44,570
!لا، لا

121
00:13:44,570 --> 00:13:47,950
!لا، لا، لا

122
00:13:45,110 --> 00:13:47,950
يا جين موري، أكان ما استخدمته
في المباراة تشاريوك؟

123
00:13:47,950 --> 00:13:50,820
.ماذا؟ لست واثقًا في الواقع

124
00:13:50,820 --> 00:13:52,200
.لقد فوجئت بدوري

125
00:13:52,200 --> 00:13:54,450
!هذا نفس جواب إيلبيو

126
00:13:57,050 --> 00:14:00,460
!كلاكما لن تتحسّنا أبدًا إن تصرّفتما هكذا

127
00:14:00,460 --> 00:14:01,890
.آسف

128
00:14:02,460 --> 00:14:04,510
.إنّها مخيفة كميرا

129
00:14:04,510 --> 00:14:05,700
!يمكنني سماعك

130
00:14:05,700 --> 00:14:06,270
!ويحي

131
00:14:06,270 --> 00:14:09,050
.سونغا محقّة مع ذلك

132
00:14:09,050 --> 00:14:10,970
.عليك أن ترتاح أيضًا

133
00:14:11,890 --> 00:14:13,860
.استنزفت قوّتك كثيرًا

134
00:14:17,840 --> 00:14:20,480
.نعم، ربّما. أظنّني سأرجع

135
00:14:21,600 --> 00:14:22,980
.في الواقع، انتظر لحظة

136
00:14:24,230 --> 00:14:26,140
...بما أنّك أتيت

137
00:14:26,760 --> 00:14:30,200
هلاّ ذهبتما لاقتناء أشياء نتناولها مع هذه؟

138
00:14:30,670 --> 00:14:33,390
.يمكنني الاعتناء بذلك لوحدي

139
00:14:33,390 --> 00:14:34,950
.كلاّ، سأذهب معك

140
00:14:34,950 --> 00:14:36,740
.ماذا؟ سأكون بخير لوحدي

141
00:14:36,740 --> 00:14:38,750
.سأرافقك. هيّا، سر

142
00:14:38,350 --> 00:14:41,230
!لكن يا سونغا، عليك أن تبقي وتستريحي

143
00:14:41,230 --> 00:14:42,490
.تقدّم فحسب

144
00:14:42,490 --> 00:14:43,760
—لكنّك من قال

145
00:14:43,760 --> 00:14:44,740
!تحرّك

146
00:14:45,720 --> 00:14:48,400
أتيت لتحدّثني عن شيء، صحيح؟

147
00:14:48,400 --> 00:14:50,190
...أ-أجل

148
00:14:52,450 --> 00:14:54,110
.بشأن جدّي

149
00:14:55,010 --> 00:14:57,080
جين تيجين؟

150
00:14:58,480 --> 00:15:01,680
...إذًا ما زال جين تيجين

151
00:15:01,680 --> 00:15:03,770
.لا أدري أين هو

152
00:15:04,240 --> 00:15:07,920
،لهذا عليّ أن أفوز وأحصل على تلك المعلومات

153
00:15:07,920 --> 00:15:09,780
.لكي أنقذه

154
00:15:10,180 --> 00:15:11,860
.هذا ما يحثّك قُدمًا إذًا

155
00:15:12,600 --> 00:15:16,030
.سيكون جيغال تيك، خصمك في النّهائيّ صعبًا

156
00:15:24,080 --> 00:15:27,340
.لكن إن كان أيّ أحد يستطيع هزيمته فهو أنت

157
00:15:27,650 --> 00:15:31,230
،إن واصلت إبداء هذا التّعبير
.سيضحك عليك تيجين

158
00:15:32,770 --> 00:15:34,010
...صحيح

159
00:15:41,430 --> 00:15:45,230
!أريد أن أقاتلك مجدّدًا بعد انتهاء إله الثّانويّة

160
00:15:45,980 --> 00:15:47,730
.يا أخي الكبير إيلبيو

161
00:15:47,730 --> 00:15:48,720
ماذا؟

162
00:15:49,230 --> 00:15:54,490
أنا أكبر منك، لذا يجب أن تناديني
."بـ"أخي الكبير إيلبيو

163
00:15:57,400 --> 00:15:59,740
...أخي الكبير... إيلبيو

164
00:15:59,740 --> 00:16:02,500
!جيّد! علينا أن نقاتل ثانيةً بالتّأكيد

165
00:16:10,590 --> 00:16:12,000
...مولاي

166
00:16:15,590 --> 00:16:18,200
...أنا... لم

167
00:16:19,510 --> 00:16:21,960
...أخسر... بعد

168
00:16:25,600 --> 00:16:28,110
.لمستهُ طاقته

169
00:16:31,080 --> 00:16:33,090
!لن... أخسر

170
00:16:33,090 --> 00:16:35,110
...دو، ري، مي، فا

171
00:16:42,120 --> 00:16:47,060
—جدّي... أنا... سوف... أفو

172
00:16:47,880 --> 00:16:50,880
.آسف، لكن لا أملك وقتًا أضيّعه معك

173
00:16:50,880 --> 00:16:56,210
!سو... لا... تي... دو

174
00:17:02,890 --> 00:17:03,850
!مولاي

175
00:17:32,700 --> 00:17:35,730
...مو... لاي

176
00:17:36,300 --> 00:17:39,030
...هياندان

177
00:17:39,400 --> 00:17:41,550
...أصبحي

178
00:17:42,020 --> 00:17:43,520
...قوّتي

179
00:17:46,020 --> 00:17:48,020
.أظنّنا اشترينا الكثير

180
00:17:48,330 --> 00:17:50,520
—ظننّا أنّ جين موري سيكون هنا

181
00:17:52,220 --> 00:17:52,860
!ماذا؟

182
00:18:05,040 --> 00:18:06,310
.ذاك الوغد

183
00:18:09,460 --> 00:18:11,280
!سونغا! هيونبوك

184
00:18:13,090 --> 00:18:15,410
...جدّي

185
00:18:16,120 --> 00:18:18,840
...أنا... قويّ

186
00:18:19,330 --> 00:18:20,840
!لن أخسر

187
00:18:21,160 --> 00:18:23,100
أذلك جون جوغوك؟

188
00:18:26,570 --> 00:18:29,070
!هذا المقرّ! حوّل يا ألفا

189
00:18:29,070 --> 00:18:30,940
—حوّل! حـ

190
00:18:32,860 --> 00:18:34,840
امتصّ أولئك النّاس؟

191
00:18:37,840 --> 00:18:40,070
.لا يمكنني أن أدع هذا يطول

192
00:18:51,750 --> 00:18:54,210
.أبعد يداك عن فريستي

193
00:19:35,670 --> 00:19:37,540
!سونغا! هيونبوك

194
00:19:39,050 --> 00:19:40,760
!توقّف

195
00:19:44,000 --> 00:19:45,790
...مولاي

196
00:19:46,900 --> 00:19:52,020
...مولاي، رجاءً... حافظ على رباطة جأشك

197
00:19:52,020 --> 00:19:56,020
...هيان... دان

198
00:19:56,020 --> 00:19:57,450
.لا بأس

199
00:19:58,530 --> 00:20:00,030
.أنا بخير

200
00:20:10,520 --> 00:20:13,040
.انقلع من هنا أيّها القمامة

201
00:20:15,280 --> 00:20:18,420
...مو... لاي

202
00:20:22,130 --> 00:20:24,140
!سونغا! هيونبوك

203
00:20:24,780 --> 00:20:26,860
...هذا مؤلم

204
00:20:30,730 --> 00:20:31,640
...ذراعي

205
00:20:39,650 --> 00:20:42,780
...سـ-ساقي

206
00:20:46,280 --> 00:20:50,410
!لا

207
00:21:02,800 --> 00:21:05,800
!يا إلهي، إنّ المفتاح ماثل أمامك

208
00:21:05,800 --> 00:21:08,050
!آنت ساعة التّطهير

209
00:21:16,180 --> 00:21:19,210
.يقدّر ثمن كلّ واحد منهم عشرة ملايين ين

210
00:21:24,970 --> 00:21:27,030
.سأقتلك

211
00:21:27,030 --> 00:21:30,100
!هذا يشبه ما حدث سابقًا

212
00:21:30,160 --> 00:21:34,430
!اعتذر! اعتذر

213
00:21:34,470 --> 00:21:35,950
...لكن

214
00:21:35,950 --> 00:21:38,210
