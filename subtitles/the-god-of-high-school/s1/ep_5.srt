1
00:00:10,900 --> 00:00:14,370
.ما عدتُ أذكر لِمَ حدث ذلك

2
00:00:17,090 --> 00:00:18,830
،لسببٍ مجرّد من المنطق

3
00:00:19,620 --> 00:00:20,880
...أنا وهو

4
00:00:28,550 --> 00:00:30,260
!هان دي

5
00:00:30,260 --> 00:00:32,060
!وو سونتي

6
00:00:33,460 --> 00:00:35,860
.كنّا نتقاتل أنا وهو على الدّوام

7
00:00:40,370 --> 00:00:43,380
.سحقًا، أبرحتني ضربًا

8
00:00:44,330 --> 00:00:46,110
وما الّذي يضحكك؟

9
00:00:47,060 --> 00:00:51,250
هل أنت جادّ؟ ألا تعلم حقًّا؟

10
00:00:55,490 --> 00:00:57,580
...لماذا... أنت

11
00:02:56,020 --> 00:03:02,470
ترى من سيكون المقاتل الآخر الّذي سيتأهّل
إلى الجولة النّهائيّة من أدوار سول التّمهيديّة؟

12
00:03:02,470 --> 00:03:04,590
قتال نصف نهائيّ المجموعة ب
...الحامي سيجمع بين

13
00:03:04,590 --> 00:03:06,710
ممارس التّايكوندو جين موري

14
00:03:06,710 --> 00:03:09,490
!وممارس الجوجوتسو البرازيليّة بيون جيهي

15
00:03:09,930 --> 00:03:13,980
شاهدتُ الحركة الّتي استخدمت
!للإطاحة بكانغ مانسوك

16
00:03:13,980 --> 00:03:16,250
!لن تفيدك معي

17
00:03:18,980 --> 00:03:20,850
!هذه الضّربة القاضية

18
00:03:34,090 --> 00:03:36,100
!ضـ-ضربة قاضية

19
00:03:36,340 --> 00:03:38,600
!الفائز: جين موري

20
00:03:38,810 --> 00:03:41,480
!أظهر لنا للتّوّ قوّته الفتّاكة

21
00:03:41,480 --> 00:03:44,060
سيجمع النّهائيّ بين جين موري

22
00:03:44,060 --> 00:03:45,730
!وهان دي

23
00:03:45,730 --> 00:03:48,860
،أيّهما سيفوز بالتّذكرة المؤدّية إلى المستقبل

24
00:03:48,860 --> 00:03:52,970
!أي الحقّ للمشاركة في بطولة إله الثّانويّة الوطنيّة؟

25
00:03:55,780 --> 00:03:58,830
.قالوا أنّه يُمكن تسريحي غدًا على الأغلب

26
00:03:59,090 --> 00:04:01,080
هذا جامح جدًّا، صحيح؟

27
00:04:01,080 --> 00:04:04,250
لا أملك أدنى فكرة عن هذه
...الآليات النّانويّة، لكن

28
00:04:05,900 --> 00:04:09,630
وبّخوني لأنّي لم آتِ إلى هنا
.لأخضع للعلاج عندما تأذّيت

29
00:04:10,430 --> 00:04:13,570
لم أعلم أنّه يمكن علاج حتّى
الإصابات الّتي أُلحِقت بنا

30
00:04:13,570 --> 00:04:14,890
.خارج البطولة

31
00:04:14,890 --> 00:04:17,010
.كان يجب أن يخبروني

32
00:04:18,990 --> 00:04:21,270
.لا تشغل بالك بالتّفاهات

33
00:04:22,090 --> 00:04:25,230
ليس من النّوع الّذي يمكنك
.هزيمته بالتّفكير كثيرًا

34
00:04:25,670 --> 00:04:30,870
.خسرتُ لأنّني كنتُ أضعف منه، هذا كلّ شيء

35
00:04:30,870 --> 00:04:33,110
.لكنّك كنتِ مصابة

36
00:04:33,420 --> 00:04:35,840
.هذا جزءٌ ممّا أقصد

37
00:04:36,470 --> 00:04:38,820
.عليّ أن أسعى للفوز مهما كانت الظّروف

38
00:04:40,650 --> 00:04:42,960
.ما زلتُ غير جيّدة كفاية

39
00:04:44,270 --> 00:04:47,300
لم أتخيّل أنّه من النّوع الّذي يلجأ
.لذلك الأسلوب القتاليّ

40
00:04:48,020 --> 00:04:50,280
.ذلك جزءٌ من هويّته بلا أدنى شكّ

41
00:04:50,810 --> 00:04:52,840
.القبضات لا تعرف الكذب

42
00:04:53,770 --> 00:04:59,140
لكن بالطّبع، لا نعرف كيف
...آل به الأمر هكذا

43
00:05:03,030 --> 00:05:04,680
...حالته

44
00:05:04,680 --> 00:05:07,230
.لم تتغيّر. أظنّ أنّ هذا كلّ ما أستطيع قوله

45
00:05:08,210 --> 00:05:10,820
.استيقظ لبرهة فقط هذا الصّباح

46
00:05:11,660 --> 00:05:13,890
.وأراد رؤيتك بشدّة

47
00:05:37,820 --> 00:05:41,220
!حان الوقت أخيرًا

48
00:05:41,220 --> 00:05:47,020
الجولة النّهائيّة من أدوار سول
!التّمهيديّة لبطولة إله الثّانويّة

49
00:05:48,090 --> 00:05:51,000
.أوّل الواصلين للحلبة هو جين موري

50
00:05:53,990 --> 00:05:56,880
!والآن نستقبل هان دي

51
00:05:59,430 --> 00:06:02,650
هل سيستيقظ صغير النّمر؟

52
00:06:05,550 --> 00:06:07,000
...استعداد

53
00:06:07,000 --> 00:06:08,140
!ابدآ

54
00:06:33,710 --> 00:06:35,920
!مذهل

55
00:06:35,920 --> 00:06:40,800
بدأ القتال للتّوّ، إلاّ أنّ المقاتلين
!لا يملكان أيّ نيّة للتّراجع

56
00:07:21,090 --> 00:07:23,370
...إنّهما متساويان؟ لا

57
00:07:23,860 --> 00:07:26,970
ما زال هناك اختلاف بسيط
.في المهارات الخام بينهما

58
00:07:26,970 --> 00:07:30,000
إن استمرّ الوضع هكذا، من
...سيكون في موقفٍ ضعيف

59
00:07:30,000 --> 00:07:33,250
.أنا واثق أنّه مدرك لذلك تمامًا

60
00:07:40,590 --> 00:07:41,360
نعم؟

61
00:08:14,730 --> 00:08:15,880
...ستدفع الثّمن

62
00:08:16,520 --> 00:08:18,840
.لفعلك ذلك بصديقتنا

63
00:08:35,430 --> 00:08:37,520
:التّايكوندو المطوّر

64
00:08:38,310 --> 00:08:41,150
!الرّكلة الثّلاثيّة

65
00:09:00,170 --> 00:09:01,130
.انهض

66
00:09:04,620 --> 00:09:07,110
آسف، لكنّي لم أعتبركما يومًا

67
00:09:07,110 --> 00:09:10,100
!صديقَيّ

68
00:09:13,660 --> 00:09:16,950
الفنّ السّرّيّ: هيئة الآلهة الأربعة
:الحارسة، الوضعيّة الأولى

69
00:09:18,470 --> 00:09:19,570
!السّلحفاة السّوداء

70
00:09:22,970 --> 00:09:26,990
صِدقًا يا سومي، يمكنني حمل
.تلك الأغراض بنفسي

71
00:09:26,990 --> 00:09:32,000
!كلاّ! سأعتني بك إلى أن تصيري بخير

72
00:09:32,000 --> 00:09:34,140
.سأذهب لتجهيز تسريحك

73
00:09:34,140 --> 00:09:35,250
.انتظراني في الرّدهة

74
00:09:35,250 --> 00:09:37,920
.حسنًا! من هنا يا ميرا

75
00:09:37,920 --> 00:09:39,890
.كلاّ، من هذا الاتّجاه

76
00:09:41,470 --> 00:09:44,860
احرصي أن تظلّي خلفي، اتّفقنا؟

77
00:09:44,860 --> 00:09:45,830
.أكيد، أكيد

78
00:09:45,830 --> 00:09:48,530
.هذه المستشفى كبيرة

79
00:09:48,530 --> 00:09:50,280
.لا يجب أن تتوهي

80
00:09:50,280 --> 00:09:52,380
!لذا سأدّلك على الطّريق

81
00:09:50,280 --> 00:09:54,820
أثمّة أحد آخر يخضع لعلاج الآليّات
النّانويّة في هذه المستشفى؟

82
00:09:53,670 --> 00:09:55,730
،نظرتُ إلى خريطة لهذه المستشفى سابقًا

83
00:09:56,060 --> 00:09:58,500
!لذا أعرف أين توجد الرّدهة

84
00:09:59,690 --> 00:10:01,850
ميرا؟ هل أنت خلفي؟

85
00:10:03,030 --> 00:10:03,650
!نعم

86
00:10:12,270 --> 00:10:14,250
...سونتي

87
00:10:14,780 --> 00:10:16,960
!كلاّ! استيقظ رجاءً

88
00:10:17,420 --> 00:10:21,130
أنت... تريد تسوية الأمر
!مع دي، أليس كذلك؟

89
00:10:22,100 --> 00:10:23,630
!سونتي

90
00:10:29,640 --> 00:10:32,940
،هيئة الآلهة الأربعة الحارسة
:الوضعيّة الأولى

91
00:10:35,250 --> 00:10:36,390
!السّلحفاة السّوداء

92
00:10:38,460 --> 00:10:39,810
:الوضعيّة الثّانية

93
00:10:41,980 --> 00:10:42,780
!الطّائر القرمزيّ

94
00:10:45,770 --> 00:10:47,880
.سمعتُ بأمنيّتك

95
00:10:48,490 --> 00:10:51,880
،إن فزت ببطولة إله الثّانويّة الوطنيّة

96
00:10:51,880 --> 00:10:56,290
سنعالج صديقك المريض
.بواسطة الآليات النّانويّة

97
00:10:56,290 --> 00:10:58,650
.سيكون الأوان فات حينها

98
00:11:01,840 --> 00:11:03,090
:الوضعيّة الثّالثة

99
00:11:03,090 --> 00:11:03,720
!النّمر الأبيض

100
00:11:08,970 --> 00:11:11,300
.حسنًا. سنبرم عقدًا

101
00:11:13,590 --> 00:11:17,060
،إن حقّقتَ فوزًا ساحقًا في نصف نهائيّ الغد

102
00:11:17,730 --> 00:11:20,310
،والنّهائي بعد ذلك

103
00:11:20,310 --> 00:11:22,740
...ما سيضمن تأهّلك من أدوار سول التّمهيديّة

104
00:11:33,830 --> 00:11:35,970
!ما هذا إلاّ إحماء

105
00:11:37,770 --> 00:11:39,580
!انتهى الأمر الآن

106
00:11:40,140 --> 00:11:41,750
:الوضعيّة الأخيرة

107
00:11:49,740 --> 00:11:51,060
!التّنّين اللّازورديّ

108
00:12:16,700 --> 00:12:19,890
!سقط جين موري

109
00:12:21,060 --> 00:12:25,430
!عشرة! تسعة! ثمانية

110
00:12:25,430 --> 00:12:32,530
!سبعة! ستّة! خمسة! أربعة! ثلاثة

111
00:12:27,150 --> 00:12:30,340
،وصلني خبر أنّ صديقك، وو سونتي

112
00:12:30,340 --> 00:12:32,840
.لفظ أنفاسه الأخيرة

113
00:12:33,130 --> 00:12:35,170
—اثنان! واحـ

114
00:12:35,170 --> 00:12:36,810
!لقد نهض

115
00:12:36,810 --> 00:12:41,450
تمكّن من النّهوض قبل انتهاء
!العدّ التّنازليّ تمامًا

116
00:12:49,350 --> 00:12:50,620
!إنّه هان دي

117
00:12:50,620 --> 00:12:54,220
سمعتُ أنّه أبرح أولئك الأشخاص
.من "الغرب الأوسط" ضربًا ثانيةً

118
00:12:55,340 --> 00:12:57,910
.حتّى أنّه هزم طلاّب ثانويّتهم أجمعين

119
00:12:57,910 --> 00:13:00,800
.إنّه خطير يا صاح. من الأفضل أن نبتعد عنه

120
00:13:02,740 --> 00:13:04,420
!ابتعد عن طريقي أيّها المعتوه

121
00:13:05,660 --> 00:13:06,680
.آسف

122
00:13:13,490 --> 00:13:18,490
.يا لك من طفلٍ مسكين
.لقد هرب كلّ أصدقائك خوفًا

123
00:13:18,490 --> 00:13:22,070
!أظنّ أنّ هذا أفضل ما لديك

124
00:13:24,610 --> 00:13:27,610
—عمّاذا تثرثر أيّها الـ

125
00:13:33,420 --> 00:13:34,620
...أنت

126
00:13:34,620 --> 00:13:40,280
سمعتُ أنّك اقتحمت المكان
.لوحدك لتحاول إنقاذ صديقك

127
00:13:40,280 --> 00:13:42,550
لديك جانبٌ مخلص بشدّة إذًا؟

128
00:13:43,550 --> 00:13:45,420
هل أنت صديقه أيضًا؟

129
00:13:46,330 --> 00:13:48,960
!سنوسعكما ضربًا أنتما الاثنان

130
00:13:51,210 --> 00:13:53,360
...هذا مؤلم

131
00:13:54,700 --> 00:13:58,730
.أبكيناهم في الأخير مع ذلك

132
00:13:59,420 --> 00:14:02,770
.لن يصدّق أصدقاؤك هذا

133
00:14:03,470 --> 00:14:04,840
.ليسوا أصدقائي

134
00:14:06,260 --> 00:14:09,410
.فهم يرحلون فور أن تنتهي مصلحتهم

135
00:14:09,410 --> 00:14:13,660
.لذا أستغلّهم عند مصلحتي أيضًا

136
00:14:13,660 --> 00:14:14,730
.هذا كلّ شيء

137
00:14:15,700 --> 00:14:17,240
.ثق بهم

138
00:14:17,660 --> 00:14:21,570
.كلّما وثقت بأحدهم، سيبادلك الثّقة أيضًا

139
00:14:23,170 --> 00:14:24,370
!دائمًا

140
00:14:34,140 --> 00:14:36,220
!سقط هان دي

141
00:14:36,220 --> 00:14:40,050
!عشرة! تسعة! ثمانية

142
00:14:40,570 --> 00:14:42,690
!سبعة! ستّة

143
00:14:43,390 --> 00:14:45,440
!خمسة! أربعة

144
00:14:45,440 --> 00:14:47,530
!نهض هان دي مجدّدًا

145
00:14:47,530 --> 00:14:48,810
!تُستكمل المباراة

146
00:14:50,250 --> 00:14:52,300
،بعد استخدامه لفنّه السّرّيّ العظيم

147
00:14:52,710 --> 00:14:55,050
!هان دي في وضعيّة الدّفاع

148
00:14:55,050 --> 00:14:58,370
!هل سيستطيع العودة للمنافسة؟

149
00:15:02,880 --> 00:15:05,510
!التّايكوندو المُطوّر

150
00:15:05,510 --> 00:15:07,460
!الرّكلة الدّائريّة

151
00:15:08,180 --> 00:15:11,090
.كان وضعه مشكوكًا فيه بالفعل

152
00:15:11,830 --> 00:15:14,820
،بدؤوا علاجه بالآليات النّانويّة

153
00:15:14,820 --> 00:15:16,180
.لكن كان الأوان قد فات

154
00:15:17,550 --> 00:15:19,100
.عقدنا ملغيّ

155
00:15:19,700 --> 00:15:22,980
.يمكنك أن تفعل ما يحلو لك الآن

156
00:15:24,940 --> 00:15:27,030
.لم تنته المباراة بعد

157
00:15:27,450 --> 00:15:29,900
فلمَ أخبرته الآن؟

158
00:15:30,590 --> 00:15:32,570
،عندما يكون المرء في الحضيض

159
00:15:33,750 --> 00:15:36,490
.يكشف عن طبيعته الحقيقيّة

160
00:15:37,040 --> 00:15:40,060
.هان دي ليس مركّزًا

161
00:15:40,060 --> 00:15:43,250
.يجدر به أن ينسحب

162
00:15:43,250 --> 00:15:46,090
!اصمد يا هان دي

163
00:15:51,930 --> 00:15:52,930
،آسف

164
00:15:53,710 --> 00:15:54,800
...لكنّي لم أعتبركما

165
00:16:00,470 --> 00:16:01,480
...يومًا

166
00:16:02,850 --> 00:16:04,600
.صديقَيّ

167
00:16:05,890 --> 00:16:07,360
.ثق بهم

168
00:16:14,500 --> 00:16:16,370
.يا لي من غبيّ

169
00:16:16,570 --> 00:16:19,180
!اجمع شتاتك يا هان دي

170
00:16:21,060 --> 00:16:22,870
ما خطبك بالضّبط؟

171
00:16:22,870 --> 00:16:24,870
كنت أقوى بمئتي ضعف على الأقلّ

172
00:16:24,870 --> 00:16:27,340
!عندما واجهتني

173
00:16:29,140 --> 00:16:31,050
يو... ميرا؟

174
00:16:33,940 --> 00:16:35,970
!مهلاً، مهلاً، مهلاً، مهلاً

175
00:16:35,970 --> 00:16:39,350
!حسنًا، قاتلا! لا توقفا المباراة

176
00:16:41,300 --> 00:16:44,010
.طلب منّي صديقك أن أمنحك هذه

177
00:16:41,860 --> 00:16:44,010
!تابعا القتال

178
00:16:47,110 --> 00:16:48,100
!قاتل

179
00:16:49,320 --> 00:16:51,070
!ارجع للقتال

180
00:16:51,070 --> 00:16:53,850
!تابع القتال الآن يا جين موري

181
00:16:53,850 --> 00:16:55,990
!هل أنت أصمّ؟! قاتل

182
00:16:57,860 --> 00:16:58,450
!قاتل

183
00:16:58,900 --> 00:17:00,900
هلاّ احتفظت بها قليلاً بعد؟

184
00:17:02,130 --> 00:17:04,750
حسنًا، لكن لا تخبره، مفهوم؟

185
00:17:04,950 --> 00:17:08,010
.إن عرف، فسيوقف القتال

186
00:17:06,150 --> 00:17:08,010
!أسرع وعد إلى القتال

187
00:17:08,010 --> 00:17:09,410
!ماذا تفعل يا جين موري؟

188
00:17:09,410 --> 00:17:11,410
!توقّف

189
00:17:11,950 --> 00:17:13,730
.إنّه غبيّ حقًّا

190
00:17:15,210 --> 00:17:17,580
!جميعكم

191
00:17:16,590 --> 00:17:18,870
!ضربة جزاء! بطاقة صفراء

192
00:17:18,870 --> 00:17:21,000
!قاتل، سحقًا

193
00:17:21,500 --> 00:17:23,220
!حسنًا... تُستكمل المباراة

194
00:17:24,260 --> 00:17:25,420
.أخيرًا

195
00:17:26,230 --> 00:17:27,850
!كان الأمر يستحقّ الانتظار

196
00:17:30,620 --> 00:17:31,970
.والآن، أرني

197
00:17:33,020 --> 00:17:38,010
أهذه النّهاية؟ أم أنّك ستصبح نمرًا أيضًا؟

198
00:17:38,790 --> 00:17:42,160
،أردتُ أن أخبرك هذا مباشرةً

199
00:17:42,500 --> 00:17:45,500
.لكن لا يبدو أنّني سأنجو، لذا أكتبُ لك رسالة

200
00:17:46,710 --> 00:17:49,570
سمعتُ أنّك مشارك في بطولة ما؟

201
00:17:50,150 --> 00:17:52,500
أتى عندي رجلٌ ذو ندبةٍ على جبهته

202
00:17:52,500 --> 00:17:55,920
،وجرّب عليّ علاجًا جديدًا ما

203
00:17:55,920 --> 00:17:58,020
.لكن يبدو أنّ الأوان كان قد فات

204
00:17:58,660 --> 00:18:02,060
.لكن أوتدري؟ أنا سعيد

205
00:18:02,660 --> 00:18:06,920
.لديّ صديق يخاطر بحياته ويقاتل من أجلي

206
00:18:07,580 --> 00:18:10,040
.لستُ نادمًا على شيء

207
00:18:10,500 --> 00:18:11,920
.ولا أريدك أن تندم على شيء

208
00:18:13,150 --> 00:18:16,240
.لست بحاجة لفعل هذا من أجلي بعد الآن

209
00:18:17,980 --> 00:18:21,410
.قاتل لأجل نفسك

210
00:18:38,100 --> 00:18:40,250
!كان ذلك رائعًا

211
00:18:40,250 --> 00:18:41,550
!وأنت أيضًا

212
00:18:59,070 --> 00:19:01,090
!الرّكلة الثّلاثيّة

213
00:19:02,390 --> 00:19:04,490
!السّلحفاة السّوداء: المرحلة الثّالثة

214
00:19:17,010 --> 00:19:18,120
التّنين اللّازورديّ

215
00:19:19,990 --> 00:19:20,940
!المعكوس

216
00:19:28,020 --> 00:19:30,850
.أنت الأفضل حقًّا

217
00:19:35,500 --> 00:19:37,320
!فهمت الآن

218
00:19:38,030 --> 00:19:40,330
:مهارة جين موري الأصليّة

219
00:19:41,330 --> 00:19:43,250
!ركلة التّنين الأزرق

220
00:19:56,750 --> 00:19:58,840
لدينا صغيرا نمر إذًا؟

221
00:20:06,180 --> 00:20:07,810
!سقط هان دي

222
00:20:07,810 --> 00:20:09,660
!تقلّصت نقاط تحمّله إلى الصّفر

223
00:20:09,660 --> 00:20:13,190
الفائز بأدوار سول التّمهيديّة لإله الثّانويّة هو

224
00:20:13,190 --> 00:20:15,150
!جين موري

225
00:20:16,470 --> 00:20:19,320
.فعلتُ كلّ ما أستطيع

226
00:20:20,330 --> 00:20:24,150
،عندما أحاول بكلّ ما لديّ
.يمكنني تقبّل الهزيمة كرجل

227
00:20:24,150 --> 00:20:25,280
ألا يدعو هذا للإعجاب؟

228
00:20:26,230 --> 00:20:29,690
.وقد فزت، لذا ابتسم قليلاً على الأقلّ

229
00:20:30,260 --> 00:20:32,480
ماذا سيحدث إن ابتسمت؟

230
00:20:33,750 --> 00:20:35,800
وما غيره؟

231
00:20:39,890 --> 00:20:41,210
...أصبحنا الآن

232
00:20:42,030 --> 00:20:43,500
!أصدقاء

233
00:20:52,290 --> 00:20:53,850
...صِدقًا

234
00:20:54,940 --> 00:20:58,370
.لا حول لي أمامكم أيّها الأغبياء

235
00:21:11,100 --> 00:21:13,150
!لن أخسر في المرّة القادمة

236
00:21:13,150 --> 00:21:16,030
!أكيد، لكن عليك قتالي أوّلاً

237
00:21:16,030 --> 00:21:17,570
!يستحيل أن أخسر أمامك

238
00:21:17,570 --> 00:21:20,160
ماذا؟ عمّ تتحدّث أيّها القرد البرّيّ؟

239
00:21:20,160 --> 00:21:22,800
.لا يحقّ لك قول ذلك يا أنثى الغوريلاّ

240
00:21:22,800 --> 00:21:24,360
!من تدعو بأنثى الغوريلاّ؟

241
00:21:24,360 --> 00:21:25,760
!أنت بالطّبع

242
00:21:25,760 --> 00:21:27,460
!لا أريد أن أسمع ذلك من قرد برّيّ

243
00:21:27,460 --> 00:21:28,630
!حسنًا يا أنثى الغوريلاّ

244
00:21:28,630 --> 00:21:31,080
.صدقًا، أنتما غبيّان

245
00:21:33,890 --> 00:21:36,480
أهذا كلّ ما لدى سول؟

246
00:21:37,030 --> 00:21:39,310
.يا للملل

247
00:21:41,150 --> 00:21:43,030
وبهذا تنتهي أدوار سول التّمهيديّة لإله الثّانوية

248
00:21:43,030 --> 00:21:47,030
...وسط تشجيعات حارّة

249
00:23:18,330 --> 00:23:21,840
،ملاحظة، أعرف أنّك أخرق

250
00:23:21,840 --> 00:23:24,460
لذا أراهن أنّك لا تملك أيّ أصدقاء عداي، صحيح؟

251
00:23:25,220 --> 00:23:27,260
.ذلك الشّيء الوحيد الّذي يُقلقني

252
00:23:29,370 --> 00:23:30,420
.إلى اللّقاء