1
00:00:05,650 --> 00:00:08,610
!يا إلهي، إنّ المفتاح ماثل أمامك

2
00:00:08,850 --> 00:00:10,620
!آنت ساعة التّطهير

3
00:00:13,490 --> 00:00:14,750
،اعتبارًا من الآن

4
00:00:15,370 --> 00:00:18,420
.انتهت بطولة إله الثّانويّة

5
00:00:22,960 --> 00:00:24,910
ما... ذلك؟

6
00:00:28,130 --> 00:00:31,010
...إلهنا في الماضي والحاضر

7
00:00:31,010 --> 00:00:33,070
...والمستقبل

8
00:00:34,030 --> 00:00:37,640
!سينزل إلهنا وملكنا القدير أخيرًا

9
00:00:37,640 --> 00:00:40,880
!قد آنت بداية النّهاية

10
00:00:57,790 --> 00:01:01,680
!إلهنا، نلتمس منك أن تقبلنا

11
00:01:14,820 --> 00:01:16,520
...حفيدي

12
00:01:17,140 --> 00:01:20,500
،سأثأر لك

13
00:01:21,540 --> 00:01:23,980
.وإن كلّفني ذلك حياتي

14
00:03:06,490 --> 00:03:07,880
...يا أمّي

15
00:03:08,930 --> 00:03:10,800
ألن تذهبي؟

16
00:03:12,900 --> 00:03:13,930
...تيك

17
00:03:14,710 --> 00:03:17,440
.عِش حياةً طيّبة

18
00:03:20,650 --> 00:03:22,160
.حسنًا، مفهوم

19
00:03:23,430 --> 00:03:25,390
.تمّ الإيداع للتّوّ

20
00:03:25,900 --> 00:03:28,540
.روابط الدّم لا تساوي شيئًا

21
00:03:29,090 --> 00:03:33,390
.لا أؤمن سوى بقدرات المرء الفرديّة

22
00:03:33,390 --> 00:03:35,740
إنّك تتمتّع بكلّ المؤهّلات

23
00:03:35,740 --> 00:03:39,390
.لتصبح وريثي الّذي سيرث كلّ ما عملتُ لأجله

24
00:03:40,090 --> 00:03:42,450
.تذكّر هذا جيّدًا

25
00:03:42,450 --> 00:03:45,970
."أمثالها هم من ندعوهم بـ"الخاسرين

26
00:03:47,530 --> 00:03:50,110
!اعتذر! اعتذر

27
00:03:50,110 --> 00:03:51,090
!اعتذر

28
00:03:51,090 --> 00:03:52,410
!أنت! ما الّذي يجري هنا؟

29
00:03:53,530 --> 00:03:54,770
!اهدأ

30
00:03:53,790 --> 00:03:54,770
!أفلتاني

31
00:03:54,770 --> 00:03:55,710
!تعال معنا

32
00:04:00,750 --> 00:04:04,570
.يختلق الخاسر حجّةً لخسارته

33
00:04:05,250 --> 00:04:07,210
.بينما المنتصر لا يفعل ذلك

34
00:04:07,210 --> 00:04:11,290
،بل يؤمن بانتصاره من البداية

35
00:04:11,290 --> 00:04:12,560
.ويحرص على تحقيقه

36
00:04:17,340 --> 00:04:20,730
.مهما تطلّب الأمر

37
00:04:22,880 --> 00:04:26,320
.أعلم كلّ هذا يا أبي

38
00:04:26,810 --> 00:04:29,320
.لن أكون خاسرًا

39
00:04:30,130 --> 00:04:35,330
من سيرث قوّتك ومالك والعالم بأجمعه

40
00:04:36,290 --> 00:04:37,330
!هو أنا

41
00:05:24,040 --> 00:05:25,880
.نحن سيّان

42
00:05:25,880 --> 00:05:27,880
،في النّهاية

43
00:05:27,880 --> 00:05:29,240
.أنت حيوان أيضًا

44
00:05:32,820 --> 00:05:33,940
!سونغا

45
00:05:35,010 --> 00:05:36,170
ماذا حدث؟

46
00:05:38,080 --> 00:05:39,720
...إيلبيو

47
00:05:40,070 --> 00:05:41,780
...إيلبيو... إنّه

48
00:05:48,690 --> 00:05:50,190
!خمسون مليون

49
00:05:50,480 --> 00:05:51,650
!ستّون مليون

50
00:05:51,650 --> 00:05:53,400
!سبعون مليون! ثمانون مليون

51
00:05:53,980 --> 00:05:56,060
!أجل، توافدوا

52
00:05:57,000 --> 00:05:57,990
!تشانشيك

53
00:06:13,830 --> 00:06:14,760
ما ذلك؟

54
00:06:24,770 --> 00:06:26,780
.هذا صحيح يا موجين

55
00:06:27,320 --> 00:06:29,650
!أتيت متأخّرًا مجدّدًا

56
00:06:30,200 --> 00:06:32,780
،إن حصلت على المفتاح الآن

57
00:06:33,290 --> 00:06:35,970
.لن يظلّ في هذا العالم شبرٌ واحد

58
00:06:35,970 --> 00:06:37,910
!سيُدمّر كلّ شيء

59
00:06:40,190 --> 00:06:43,410
.ذلك مرادنا تمامًا

60
00:06:46,280 --> 00:06:47,870
ما ذلك؟

61
00:06:48,820 --> 00:06:50,570
التشاريوك الخاصّ بأحدهم؟

62
00:07:18,590 --> 00:07:20,940
.تذكّر هذا جيّدًا

63
00:07:20,940 --> 00:07:24,560
."أمثالها هم من ندعوهم بـ"الخاسرين

64
00:07:26,100 --> 00:07:27,040
...أنا

65
00:07:34,140 --> 00:07:36,130
.لستُ خاسرًا

66
00:07:36,400 --> 00:07:37,510
!إيلبيو

67
00:07:54,100 --> 00:07:55,110
...قد استيقظ

68
00:07:55,720 --> 00:07:57,110
...المفتاح

69
00:08:18,300 --> 00:08:20,760
!سيكون المفتاح لي

70
00:08:24,780 --> 00:08:25,680
!تبًّا

71
00:08:47,910 --> 00:08:48,890
...المفتاح

72
00:08:49,290 --> 00:08:50,500
...أخيرًا

73
00:08:57,030 --> 00:08:59,350
أهذا ما كانوا يسعون إليه؟

74
00:09:00,130 --> 00:09:01,230
!أنت

75
00:09:01,230 --> 00:09:02,590
!تماسك

76
00:09:04,010 --> 00:09:05,870
.إنّه يفقد الكثير من الدّم

77
00:09:05,870 --> 00:09:08,010
ألا يمكن للآليات النّانويّة أن تواكب؟

78
00:09:21,500 --> 00:09:24,200
.لم يعد لدينا خيار سوى إلغاء تحالفنا

79
00:09:24,200 --> 00:09:26,700
.إنّها لخسارة يا عضو الجمعيّة، بارك موجين

80
00:09:26,930 --> 00:09:29,970
.لا يمكننا الاستسلام عن طيب خاطر

81
00:09:31,160 --> 00:09:35,170
أمام العلم البشريّ، قوّة إله
.قديم لا تساوي شيئًا

82
00:09:35,450 --> 00:09:38,590
.وسأثبت مدى تفاهتها

83
00:09:43,430 --> 00:09:49,510
.هذه مهمّتنا كحماة هذا العالم

84
00:09:51,890 --> 00:09:53,720
!تمّ تأكيد إطلاق الصّاروخ النّوويّ

85
00:09:53,720 --> 00:09:56,850
عددها 567 وهي تستهدف
!المجال الجويّ فوق سول

86
00:09:56,850 --> 00:09:59,820
نقدّر هبوط الصّواريخ المقذافيّة
!بعد 40 دقيقة

87
00:10:01,820 --> 00:10:06,050
هل تحاول مسح هذه الدّولة
من الخريطة يا بارك موجين؟

88
00:10:06,050 --> 00:10:08,320
.سيّدتي الرّئيسة، علينا الذّهاب إلى المحصن

89
00:10:08,320 --> 00:10:11,310
ما الّذي يجري بالضّبط؟

90
00:10:11,310 --> 00:10:15,130
سحقًا! لو أنّني أستطيع كسر
...هذه القيود، سوف

91
00:10:16,010 --> 00:10:18,320
!لكنّي بحاجة للمفتاح لفعل ذلك

92
00:10:18,320 --> 00:10:21,670
.هذا نظام دعم الاستجابة للطّوارئ
أيمكنك سماعي؟

93
00:10:22,240 --> 00:10:24,170
تأكّدنا للتّوّ أنّ الجيش الأمريكيّ

94
00:10:24,170 --> 00:10:27,140
.أطلق توًّا عددًا هائلاً من الصّواريخ النّوويّة

95
00:10:27,690 --> 00:10:29,730
.الوضع في غاية الخطورة

96
00:10:30,230 --> 00:10:31,060
!سحقًا

97
00:10:36,400 --> 00:10:38,480
عليكم أن تلعبوا في الدّاخل يا أطفال

98
00:10:38,480 --> 00:10:40,440
!إلى أن أنظّف هذه القذارة

99
00:10:44,130 --> 00:10:45,210
ما الّذي يجري؟

100
00:11:11,990 --> 00:11:15,070
!دي! ميرا! إيلبيو

101
00:11:15,800 --> 00:11:17,840
أين الجميع؟

102
00:11:18,370 --> 00:11:20,330
وما هذا المكان؟

103
00:11:20,330 --> 00:11:22,340
!إيلبيو! إيلبيو

104
00:11:23,650 --> 00:11:28,010
،ثمّ علقنا في هجوم جيغال

105
00:11:28,830 --> 00:11:31,130
...وإيلبيو قد

106
00:11:31,130 --> 00:11:32,570
...هل إيلبيو

107
00:11:32,570 --> 00:11:34,140
هل إيلبيو بخير؟

108
00:11:34,140 --> 00:11:35,740
.لا أدري

109
00:11:35,740 --> 00:11:38,950
.أظنّ أنّ الجميع أُرسلوا إلى هنا

110
00:11:40,200 --> 00:11:42,990
...رجاءً... أنقذوا إيلبيو

111
00:11:43,480 --> 00:11:44,800
!سونغا

112
00:11:45,650 --> 00:11:47,930
.تشاريوك: هايتاي

113
00:11:53,820 --> 00:11:56,570
.ذلك الماء مشبّع بقوّة شفائيّة

114
00:11:56,570 --> 00:11:58,420
.يجب أن تصمد لفترة وجيزة على الأقلّ

115
00:11:58,830 --> 00:12:00,760
أهذه هي التشاريوك خاصّتك؟

116
00:12:01,590 --> 00:12:05,630
.كانت نيّتي أن أخفيها إلى أن أتقنها تمامًا

117
00:12:07,660 --> 00:12:09,420
كم ستدوم هذه "الفترة الوجيزة"؟

118
00:12:09,420 --> 00:12:12,580
.لأصدقك القول، لا أدري بالضّبط

119
00:12:13,150 --> 00:12:14,970
،علينا أن نجد موري والبقيّة

120
00:12:14,970 --> 00:12:16,930
.ثمّ نذهب من هنا بسرعة

121
00:12:16,930 --> 00:12:18,420
.معك حقّ

122
00:12:18,420 --> 00:12:21,280
...إن بُعث الجميع إلى هنا، فبالتّأكيد

123
00:12:21,280 --> 00:12:23,350
.يجدر أن يكون هنا أيضًا

124
00:12:26,220 --> 00:12:31,580
،الخزانة المركزيّة، بحر من الدّماء
...أعلى البطن، بوّابة السّحب

125
00:12:32,990 --> 00:12:35,030
.يجدر بهذا أن يوقف النّزيف على الأقلّ

126
00:12:35,940 --> 00:12:37,890
أكلّ هذا من فعل جيغال؟

127
00:12:37,890 --> 00:12:40,730
أفعل هذا بإيلبيو وبفريقه... وبك؟

128
00:12:41,040 --> 00:12:43,020
.إنّه خطير

129
00:12:43,020 --> 00:12:45,080
...كان يراقبه إيلبيو طوال هذا الوقت

130
00:12:46,000 --> 00:12:47,010
.ويراقبك أيضًا

131
00:12:47,930 --> 00:12:48,500
أنا؟

132
00:12:48,720 --> 00:12:52,320
قال أنّه يريدك أن تصبح
.قويًّا كفايةً لتهزم جيغال

133
00:12:52,940 --> 00:12:55,920
!هذا جيّد... لكن ليس كافيًا

134
00:12:56,010 --> 00:12:58,300
!ما زال بإمكانك أن تصبح أقوى

135
00:12:59,360 --> 00:13:02,310
.وعدتني... بصون ذلك السّرّ

136
00:13:02,310 --> 00:13:03,480
!إيلبيو

137
00:13:04,270 --> 00:13:05,490
هل أنت بخير؟

138
00:13:10,630 --> 00:13:11,610
أين هو؟

139
00:13:13,570 --> 00:13:18,550
...لا أدري ما هذا ولِمَ كان بداخلي

140
00:13:19,050 --> 00:13:21,470
.لكنّي أستشعر قوّةً مذهلةً فيه

141
00:13:22,520 --> 00:13:23,580
.أريدك أن تحتفظ به

142
00:13:24,370 --> 00:13:26,210
لكن... أليس لك؟

143
00:13:26,690 --> 00:13:29,020
.لا تدع جيغال يحصل عليه مهما كان

144
00:13:29,800 --> 00:13:31,590
،إن استحوذ على هذه القوّة

145
00:13:32,110 --> 00:13:34,050
.سيحدث شيء فظيع

146
00:13:40,150 --> 00:13:41,660
.هذا بيان عاجل

147
00:13:41,660 --> 00:13:47,380
أعلنت هيئة الأركان المشتركة أنّ عدّة
.أجسام طائرة مجهولة تقترب من سول

148
00:13:47,380 --> 00:13:50,730
هذا وقد ذُكر أنّها ستصل إلى سول
.في ظرف 40 دقيقة أو نحوها

149
00:13:47,400 --> 00:13:51,120
!أسرعوا! ثمّة محطّة مترو الأنفاق قريبة

150
00:13:51,120 --> 00:13:52,160
!أسرعوا

151
00:13:51,120 --> 00:13:56,770
ننصح كلّ من في الخارج أن يحتموا
.داخل مبنى متين أو في مترو الأنفاق

152
00:13:52,160 --> 00:13:53,180
!تحرّكوا

153
00:13:54,460 --> 00:13:56,760
.لا يمكننا إيواء كلّ هذا العدد من النّاس

154
00:13:56,760 --> 00:13:58,740
.إنّ الملجأ يعجّ بالمدنيّين بالفعل

155
00:13:58,950 --> 00:14:00,790
أيوجد ملاذ آخر؟

156
00:14:25,260 --> 00:14:26,730
!ثمانمئة مليون

157
00:14:26,730 --> 00:14:28,160
!ثمانمئة وعشرة ملايين

158
00:14:28,390 --> 00:14:30,270
!ثمانمئة وعشرون مليون

159
00:14:31,510 --> 00:14:33,360
لِمَ لا تقرّ بهزيمتك فحسب؟

160
00:14:35,620 --> 00:14:38,740
.لا أمل لكم أيّها النّاس في تحدّي الإله

161
00:14:38,740 --> 00:14:40,760
.ولو بعد مئة مليون سنة

162
00:14:50,970 --> 00:14:52,650
أين المفتاح؟

163
00:14:53,840 --> 00:14:57,620
.لا أدري عمّ تتحدّث

164
00:14:57,620 --> 00:15:00,310
،إن أردت أن تسأل النّاس

165
00:15:00,310 --> 00:15:02,600
!فعليك أن تسأل باحترام أكثر

166
00:15:02,600 --> 00:15:06,100
سأسألكما مرّةً أخيرة. أين هو المفتاح؟

167
00:15:06,100 --> 00:15:10,100
هل "المفتاح" هو ذلك الشّيء
الّذي خرج من إيلبيو سابقًا؟

168
00:15:10,100 --> 00:15:14,110
،إن عثر عليه هذا الشّخص
.سيقتله هذه المرّة لا محالة

169
00:15:16,590 --> 00:15:17,860
.غيّرتُ رأيي

170
00:15:19,170 --> 00:15:20,130
.موتا

171
00:15:25,080 --> 00:15:26,980
!مطرد السّماء المربّع المزيّن

172
00:15:28,580 --> 00:15:30,860
!تشاريوك: هايتاي

173
00:15:40,820 --> 00:15:43,140
!دي! ميرا

174
00:15:43,140 --> 00:15:44,910
!أين أنتما؟

175
00:15:47,850 --> 00:15:49,570
!دي! ميرا

176
00:15:50,910 --> 00:15:52,730
أين المفتاح؟

177
00:15:54,230 --> 00:15:55,720
.ها هو ذا

178
00:15:56,300 --> 00:15:58,230
.إخفاؤه لن ينفع. يمكنني معرفته

179
00:15:58,440 --> 00:16:00,290
...اهرب يا موري

180
00:16:01,190 --> 00:16:04,240
.لقد... فقد صوابه

181
00:16:04,820 --> 00:16:06,120
لماذا؟

182
00:16:06,780 --> 00:16:11,720
!لِمَ فعلت هذا بدي وميرا وإيلبيو والبقيّة؟

183
00:16:11,720 --> 00:16:13,120
.إنّهم خاسرون

184
00:16:13,120 --> 00:16:17,120
.يمكنني أن أفعل أيّ ما أريد. أنا منتصر

185
00:16:17,120 --> 00:16:19,590
.وسأصبح منتصرًا مثاليًّا

186
00:16:20,220 --> 00:16:24,550
.أجل... سأستولي على كلّ شيء

187
00:16:24,930 --> 00:16:26,650
.أعطني المفتاح

188
00:16:42,950 --> 00:16:45,430
.سيجعلك هذا تقبل بالإله

189
00:16:45,950 --> 00:16:48,410
!توقّف

190
00:16:56,900 --> 00:16:58,670
!ما هذه القوّة؟

191
00:17:02,380 --> 00:17:04,960
...لا... أستطيع

192
00:17:10,850 --> 00:17:14,320
إلهنا، في الماضي والحاضر

193
00:17:14,320 --> 00:17:16,600
...والمستقبل

194
00:17:16,600 --> 00:17:20,310
!سينزل إلهنا وملكنا القدير أخيرًا

195
00:17:20,310 --> 00:17:23,290
!قد آنت بداية النّهاية

196
00:17:23,290 --> 00:17:25,550
...بالجناح في يدي اليمنى

197
00:17:25,550 --> 00:17:27,530
،ارحلي بعيدًا من هنا

198
00:17:27,530 --> 00:17:30,360
!يا مئات آلاف الأرواح النقيّة

199
00:17:42,740 --> 00:17:44,660
!سحقًا

200
00:17:48,590 --> 00:17:51,560
!أعطني المفتاح

201
00:17:56,790 --> 00:17:58,760
:مهارة جين موري الأصليّة

202
00:17:59,390 --> 00:18:01,340
!ركلة التّنّين الأزرق

203
00:18:06,110 --> 00:18:08,200
!أعطني المفتاح

204
00:18:13,700 --> 00:18:15,780
أين نحن؟

205
00:18:18,620 --> 00:18:22,100
...انتقلنا آنيًّا؟ لا يعقل

206
00:18:22,100 --> 00:18:24,140
كلّ ساكنة سول موجودة هنا؟

207
00:18:24,140 --> 00:18:26,090
...الوحيد القادر على فعل هذا

208
00:18:26,910 --> 00:18:29,090
.ذاك الوغد جيسان

209
00:18:30,500 --> 00:18:31,730
!انظرا لذلك

210
00:18:40,400 --> 00:18:44,090
هل نقلت كلّ شخص في سول آنيًّا؟

211
00:18:44,090 --> 00:18:45,900
...هذا مذهل بحقّ

212
00:18:45,900 --> 00:18:48,410
.جون جيسان من السّتّة

213
00:18:48,980 --> 00:18:51,290
...بالخيمياء في يدي اليسرى

214
00:18:51,290 --> 00:18:54,120
،ابنِ باسم الحقيقة

215
00:18:54,120 --> 00:18:57,620
الإسفين المقدّس الّذي يستطيع
!اختراق الإله نفسه

216
00:18:58,040 --> 00:18:58,980
!ماذا؟

217
00:19:12,730 --> 00:19:14,870
...باسم جون جيسان

218
00:19:14,870 --> 00:19:17,180
!تقدّم أيّها الغبار النّجميّ

219
00:19:20,810 --> 00:19:22,560
...تـ-توقّف

220
00:19:31,280 --> 00:19:33,270
.سأنتقم لأجل حفيدي

221
00:19:33,270 --> 00:19:35,240
.وسأسحبك معي إلى الهلاك

222
00:20:16,500 --> 00:20:20,360
ما الّذي... حدث للتّوّ؟

223
00:20:22,910 --> 00:20:25,170
مـ-ما ذلك؟

224
00:20:39,060 --> 00:20:41,930
أين هو... المفتاح؟

225
00:20:43,850 --> 00:20:44,670
!موري

226
00:20:51,610 --> 00:20:53,850
.هذا يكفي

227
00:20:54,910 --> 00:20:55,690
!موري

228
00:21:00,210 --> 00:21:02,040
!سحقًا

229
00:21:02,040 --> 00:21:03,520
.خذه

230
00:21:10,470 --> 00:21:12,970
.تطلّب هذا الكثير من العمل

231
00:21:12,970 --> 00:21:14,970
...المفتاح

232
00:21:16,290 --> 00:21:17,960
!سحقًا

233
00:21:18,390 --> 00:21:21,890
...والآن سأتفوّق على كلّ شيء

234
00:21:21,890 --> 00:21:24,730
!حتّى الإله

235
00:21:48,870 --> 00:21:50,420
ما ذلك؟

236
00:22:00,000 --> 00:22:01,770
...ستموتون

237
00:22:02,980 --> 00:22:03,950
.أيّها الخاسرون