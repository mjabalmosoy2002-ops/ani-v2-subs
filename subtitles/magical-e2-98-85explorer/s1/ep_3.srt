.لكن معرفتها هي بالتحديد ما تجعلني أسرع

210
00:12:05,450 --> 00:12:06,660
.تاكيوتو

211
00:12:07,410 --> 00:12:09,870
لماذا تعرف الطريق؟

212
00:12:09,870 --> 00:12:12,410
هل لودي بالأمام حقًا؟

213
00:12:13,290 --> 00:12:15,000
ماذا تعرف؟

214
00:12:15,000 --> 00:12:16,590
.آسف

215
00:12:16,590 --> 00:12:17,960
.لا أستطيع إخبارك الآن

216
00:12:17,960 --> 00:12:21,470
.أعتقد أيضًا أنه لا يجب على لودي التواجد هنا

217
00:12:21,470 --> 00:12:23,220
،لكن إن كانت هنا

218
00:12:23,220 --> 00:12:24,930
...وكانت تتعرض للهجوم

219
00:12:25,260 --> 00:12:26,890
.فالخيار الوحيد هو مواصلة التقدّم

220
00:12:28,310 --> 00:12:31,600
.آسف على فعل هذا بعد أن طلبت منك مرافقتي

221
00:12:34,060 --> 00:12:35,150
...الأمر

222
00:12:38,020 --> 00:12:38,900
.لا

223
00:12:38,900 --> 00:12:40,280
.أعتذر

224
00:12:40,730 --> 00:12:41,940
سينباي؟

225
00:12:41,940 --> 00:12:43,900
.لقد قاطعتك

226
00:12:43,900 --> 00:12:44,700
.هيّا بنا

227
00:12:45,030 --> 00:12:45,990
...في المرة القادمة

228
00:12:49,330 --> 00:12:51,120
.دعيني أقاتل أيضًا من فضلك

229
00:12:59,040 --> 00:13:00,340
،مثلما توقعت

230
00:13:00,340 --> 00:13:03,090
.سهّلت عليّ "عين العقل" القتال كثيرًا

231
00:13:09,600 --> 00:13:11,640
ما هذه القوة؟

232
00:13:11,640 --> 00:13:14,600
وتعلم مهارة "عين العقل" مسبقًا؟

233
00:13:17,480 --> 00:13:18,440
!غول

234
00:13:18,440 --> 00:13:19,400
.هذا سيئ

235
00:13:19,400 --> 00:13:20,320
.يجب أن نسرع

236
00:13:23,190 --> 00:13:24,150
.آسف

237
00:13:24,150 --> 00:13:25,650
!تولي أمر هؤلاء رجاءً

238
00:13:30,160 --> 00:13:31,950
!تاكيوتو، من الخطير أن تذهب بمفردك

239
00:13:32,330 --> 00:13:33,330
!عُد إلى هنا

240
00:13:40,790 --> 00:13:41,670
!سحقًا

241
00:13:41,670 --> 00:13:42,590
!آمل ألا أكون قد تأخرت

242
00:13:42,920 --> 00:13:44,090
!لودي

243
00:13:49,640 --> 00:13:51,970
!أفلتها

244
00:14:04,990 --> 00:14:06,280
!لن أسمح لك

245
00:14:14,080 --> 00:14:14,910
...كوسكي

246
00:14:33,890 --> 00:14:35,220
!تنحّ يا كوسكي

247
00:14:39,140 --> 00:14:40,350
!نجحت

248
00:14:48,110 --> 00:14:49,450
...لكن

249
00:14:50,240 --> 00:14:51,820
...الغول عديم الرحمة

250
00:14:52,160 --> 00:14:55,040
في العادة، يفترض أن يكون زعيم سرداب
.تقاتله في منتصف اللعبة

251
00:14:55,490 --> 00:14:58,080
بما أننا أنا ولودي لا نملك
،سوى قدرات بداية اللعبة

252
00:14:58,080 --> 00:14:59,410
.فالنصر مستحيل

253
00:15:02,540 --> 00:15:04,380
.وحش نهاية سيئة

254
00:15:06,000 --> 00:15:06,880
!لودي

255
00:15:06,880 --> 00:15:08,760
.لا تلحقي بي مهما حدث

256
00:15:14,050 --> 00:15:16,100
.لم أتوقع أن أستخدم هذا هنا بهذه الطريقة

257
00:15:18,890 --> 00:15:20,770
،لو كنتُ أقوى

258
00:15:20,770 --> 00:15:23,360
!لما اضطررت للجوء لهذا

259
00:15:29,860 --> 00:15:32,280
!كوسكي

260
00:15:40,160 --> 00:15:44,460
لماذا نحن من سقط هنا؟

261
00:15:45,630 --> 00:15:46,800
،في اللعبة الأصلية

262
00:15:46,800 --> 00:15:50,760
.هذا فخّ مثير يحفّز مشهدًا مثيرًا

263
00:15:50,760 --> 00:15:53,510
،يمتصّ سلايم لزج المانا خاصتهم

264
00:15:53,510 --> 00:15:56,680
.تغلب الإثارة على البطلات

265
00:15:57,680 --> 00:15:59,390
هل كنت تعلم؟

266
00:15:59,890 --> 00:16:06,820
أن 99 بالمائة من ألعاب تقمّص أدوار الإيروغي
.مليئة بفخاخ سخيفة تمامًا

267
00:16:09,190 --> 00:16:12,530
.لنرَ ما الذي سينفد أولًا

268
00:16:12,530 --> 00:16:14,530
حياتك؟ أو المانا خاصتي؟

269
00:16:15,370 --> 00:16:17,450
!لنواجه بعضنا

270
00:16:46,730 --> 00:16:47,440
.مرحبًا

271
00:16:47,810 --> 00:16:48,360
.آسف على التأخير

272
00:16:49,730 --> 00:16:50,820
!كوسكي

273
00:16:51,150 --> 00:16:53,900
فيما كنت تفكر؟

274
00:16:56,530 --> 00:16:58,780
.أنت لزج

275
00:16:59,370 --> 00:17:00,740
.يسرّني أنك على ما يرام

276
00:17:01,540 --> 00:17:03,040
.شكرًا لك

277
00:17:03,040 --> 00:17:03,710
.طبعًا

278
00:17:07,580 --> 00:17:09,630
لماذا تركتني خلفك؟

279
00:17:09,630 --> 00:17:11,130
.آسف

280
00:17:11,130 --> 00:17:13,090
.لم أستطع منع نفسي

281
00:17:13,090 --> 00:17:15,840
.يسرّني أنكما على ما يرام

282
00:17:15,840 --> 00:17:18,470
.شكرًا جزيلًا لك يا يوكيني-سان

283
00:17:18,470 --> 00:17:19,550
...حسنًا إذًا

284
00:17:19,550 --> 00:17:22,180
،أريد الخروج من هنا في أقرب وقت

285
00:17:22,680 --> 00:17:25,440
لكن يبدو أننا لا نملك
.حجر ختم هروب سحري

286
00:17:25,730 --> 00:17:29,560
.في الواقع، أعرف طريقة

287
00:17:33,230 --> 00:17:35,530
لماذا أنت عابس؟

288
00:17:35,530 --> 00:17:39,280
،الطريقة سهلة، لكنها أيضًا

289
00:17:39,280 --> 00:17:40,370
لكنها صعبة أيضًا؟

290
00:17:44,870 --> 00:17:45,830
.هنا

291
00:17:47,000 --> 00:17:48,750
.لغة قديمة

292
00:17:50,750 --> 00:17:53,710
،إن وضعت هذا الأنبوب في تلك الفتحة

293
00:17:53,710 --> 00:17:56,970
.سيُظهر ظلًا بشريًا هناك

294
00:17:56,970 --> 00:17:58,340
.ذلك الشيء

295
00:17:59,010 --> 00:18:01,430
،إن اتخذت نفس هيئة الظلّ

296
00:18:01,760 --> 00:18:05,640
سيُرسل الختم الذي على المنصة
،مانا من نوع مميّز إلى الأنبوب

297
00:18:05,640 --> 00:18:08,850
.ما سيطفئ مصدر الطاقة هذا

298
00:18:08,850 --> 00:18:10,560
وهذا كل ما علينا فعله؟

299
00:18:11,440 --> 00:18:12,820
.يبدو هذا سهلًا

300
00:18:12,820 --> 00:18:14,820
!هذا سرداب إيروغي

301
00:18:15,320 --> 00:18:17,860
!كأن الأمر سيتوقف هناك

302
00:18:18,150 --> 00:18:18,950
ماذا؟

303
00:18:18,950 --> 00:18:21,320
.أخبرنا بسرعة

304
00:18:21,620 --> 00:18:25,950
يبدو أن الظلّ الذي سيظهر
.سيتخذ وضعيات مثيرة

305
00:18:27,790 --> 00:18:31,040
ولن يفلح الأمر ما لم ترتديا
!ثياب السباحة تلك

306
00:18:33,290 --> 00:18:35,510
لماذا عليّ القيام بأمر كهذا؟

307
00:18:35,800 --> 00:18:37,840
!هذه هي الطريقة الوحيدة

308
00:18:37,840 --> 00:18:39,760
!كفاك عبثًا

309
00:18:39,760 --> 00:18:41,180
،إن اتخذت الوضعية المثيرة

310
00:18:41,180 --> 00:18:42,970
!ستتراكم المانا سريعًا

311
00:18:42,970 --> 00:18:44,680
!هذه ليست غلطتي

312
00:18:45,520 --> 00:18:47,390
تقصد ثياب السباحة هذه؟

313
00:18:48,810 --> 00:18:49,640
،بالمناسبة

314
00:18:49,640 --> 00:18:52,770
.يجب أن تعلما أمرًا ما

315
00:18:53,230 --> 00:18:54,820
هناك المزيد؟

316
00:18:54,820 --> 00:18:55,690
.هذا صحيح

317
00:18:55,690 --> 00:18:58,320
.سيتفعّل شرط آخر مبالغ فيه

318
00:18:58,860 --> 00:19:00,950
."هذه هي "ماجيكال إكسبلورار

319
00:19:00,950 --> 00:19:02,950
،إن أخطأتما في الوضعية

320
00:19:02,950 --> 00:19:05,910
.سينبعث غاز يجعلكما أكثر شبقًا

321
00:19:07,580 --> 00:19:10,170
،لكن من المفترض، بعد أن تفعلا ذلك

322
00:19:10,170 --> 00:19:11,710
،ستشعران بشعور دافئ ورائع

323
00:19:11,710 --> 00:19:12,580
،قاوما البرودة

324
00:19:12,580 --> 00:19:13,500
،أرخيا كتفيكما

325
00:19:13,500 --> 00:19:14,790
.وستتحسن دورتكما الدموية

326
00:19:14,790 --> 00:19:17,380
!لا حاجة لي بتأثيرات حمام الينابيع الساخنة الآن

327
00:19:17,380 --> 00:19:21,260
!أيّ شيء يجعلك شبقًا فهو سيئ

328
00:19:21,260 --> 00:19:22,260
!أنت محقة

329
00:19:22,260 --> 00:19:24,390
.لكنها الطريقة الوحيدة حقًا

330
00:19:24,720 --> 00:19:26,720
لِم لا تقوم بذلك إذًا؟

331
00:19:26,720 --> 00:19:28,600
كيف يفترض بي ارتداء ثوب السباحة ذاك؟

332
00:19:28,600 --> 00:19:29,980
!سأفقد كرامتي

333
00:19:29,980 --> 00:19:32,060
!اخلع ثيابك فحسب إذًا

334
00:19:32,060 --> 00:19:33,440
!هذا مبالغ فيه

335
00:19:33,440 --> 00:19:35,270
لِم لا أفعل ذلك بثيابي إذًا؟

336
00:19:35,270 --> 00:19:36,860
!اخلعها فحسب

337
00:19:36,860 --> 00:19:37,730
!مهلًا

338
00:19:37,730 --> 00:19:38,740
!أفلتي ذلك

339
00:19:38,740 --> 00:19:39,610
!لن أفعل

340
00:19:39,610 --> 00:19:42,280
!دعي لي ثيابي الداخلية على الأقل

341
00:19:42,280 --> 00:19:44,370
.أنا مستعدة لأثق بتاكيوتو

342
00:19:44,370 --> 00:19:45,030
!سينباي

343
00:19:45,030 --> 00:19:49,410
أجل، أعترف أنه ينظر إلينا أحيانًا بطريقة

344
00:19:49,410 --> 00:19:51,290
...لا أعرف كيف أصفها

345
00:19:51,290 --> 00:19:53,040
.لكن أحيانًا... ينظر إلينا بشهوة

346
00:19:53,040 --> 00:19:54,540
.لاحظت ذلك إذًا

347
00:19:55,290 --> 00:19:57,550
.لكنّي سألتُ نفسي

348
00:19:57,550 --> 00:20:00,880
هل سيكذب تاكيوتو هنا؟

349
00:20:00,880 --> 00:20:04,050
.لا، لا خيار آخر أمامنا على الأرجح

350
00:20:09,180 --> 00:20:10,890
.لا بأس

351
00:20:11,230 --> 00:20:14,190
.لكن هذه المرة فقط

352
00:20:15,730 --> 00:20:16,650
.شكرًا لك

353
00:20:16,980 --> 00:20:19,610
.هناك ثلاثة أنواع من ثياب السباحة إذًا

354
00:20:19,610 --> 00:20:21,990
!لا أكترث أيّ نوع أرتدي

355
00:20:23,950 --> 00:20:27,740
...إن حدقت بنا كثيرًا، فهذا

356
00:20:27,740 --> 00:20:31,330
.بالضبط، هذا محرج جدًا

357
00:20:33,210 --> 00:20:33,750
.آسف

358
00:20:34,670 --> 00:20:36,130
.لنبدأ على الفور

359
00:21:08,160 --> 00:21:10,120
!أجل، نجحنا

360
00:21:10,120 --> 00:21:11,330
لماذا؟

361
00:21:11,330 --> 00:21:12,080
!مهلًا

362
00:21:12,080 --> 00:21:13,500
!هذا غير منطقي

363
00:21:16,500 --> 00:21:17,960
!بسرعة يا لودي

364
00:21:17,960 --> 00:21:19,250
،كما قال تاكيوتو

365
00:21:19,250 --> 00:21:23,670
!سينبعث الغاز الذي... سيجعلنا أكثر شبقًا

366
00:21:23,670 --> 00:21:26,050
!لا أستطيع اتخاذ وضعية كهذه

367
00:21:49,070 --> 00:21:50,240
.جيد

368
00:21:50,240 --> 00:21:52,160
.لقد امتلأ

369
00:21:57,170 --> 00:21:58,670
لم يُقبض على من تبقى من كنيسة

370
00:21:58,670 --> 00:22:00,130
.السيد الشرير بعد

371
00:22:00,130 --> 00:22:02,460
هل تدركين أنك مستهدفة؟

372
00:22:02,460 --> 00:22:04,340
لا تدركين، صحيح؟

373
00:22:05,510 --> 00:22:08,470
...اعتدت الجلوس بهذه الوضعية

374
00:22:08,840 --> 00:22:11,180
هل تنصت إليّ يا كو-تشان؟

375
00:22:14,640 --> 00:22:17,350
.جعلني الحادثة الأخيرة أدرك ذلك

376
00:22:17,350 --> 00:22:20,810
."أحب "ماجيكال إكسبلورار

377
00:22:20,810 --> 00:22:24,860
...لودي، سينباي، ني-تشان، مارينو-سان، كلاريس-سان

378
00:22:24,860 --> 00:22:27,740
.أحب كل من التقيتهم في هذا العالم

379
00:22:27,740 --> 00:22:30,490
.كما أحب اللاتي لم ألتقهنّ بعد

380
00:22:36,080 --> 00:22:39,710
.لذا أتمنى السعادة لجميع البطلات

381
00:22:39,710 --> 00:22:41,670
.بل يجب أن يكنّ سعيدات

382
00:22:43,090 --> 00:22:48,590
أتساءل إن كان بطل هذا العالم
سينقذهن جميعًا؟

383
00:22:48,590 --> 00:22:51,090
،إن حدث الأسوء

384
00:22:51,090 --> 00:22:53,050
هل سأستطيع مسامحة نفسي؟

385
00:22:53,810 --> 00:22:55,720
.لستُ البطل

386
00:22:55,720 --> 00:22:56,930
...لهذا السبب بالتحديد

387
00:22:56,930 --> 00:22:58,890
!يجب أن أصبح أقوى

388
00:22:59,230 --> 00:23:00,480
.لأستطيع حماية الجميع

389
00:23:01,600 --> 00:23:04,400
!لأستطيع تفادي النهايات السيئة

390
00:23:09,400 --> 00:23:12,450
،بطل "ماجيكال إكسبلورار" هو هيجيري يوري

391
00:23:12,450 --> 00:23:16,040
شخص قادر على التغلّب
.على سيد الشياطين بنفسه

392
00:23:17,290 --> 00:23:20,830
.سأتجاوزه وأصبح الأقوى

393
00:23:23,040 --> 00:23:28,670
،وعند تحقيقي لذلك
.سأقود الجميع إلى نهاية سعيدة

394
00:23:29,050 --> 00:23:32,640
!لتحقيق ذلك، عليّ الذهاب لإحضارها قريبًا