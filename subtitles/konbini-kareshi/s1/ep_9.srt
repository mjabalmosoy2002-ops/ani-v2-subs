1
00:00:08,900 --> 00:00:10,750
الهالوين إذًا؟

2
00:00:10,750 --> 00:00:12,460
هل تريد أن نتنكّر معًا؟

3
00:00:12,460 --> 00:00:14,170
.كفاك أحاديث تافهة

4
00:00:14,170 --> 00:00:15,030
.خذ

5
00:00:16,030 --> 00:00:17,660
!أجل، عيد الميلاد

6
00:00:17,660 --> 00:00:19,350
...ساكاموتو، في تلك الحالة

7
00:00:21,730 --> 00:00:23,350
.حسنًا، حسنًا

8
00:02:27,600 --> 00:02:28,570
.هاشيموتو

9
00:02:28,570 --> 00:02:29,290
.حاضرة

10
00:02:29,700 --> 00:02:30,920
.هيراباياشي

11
00:02:30,920 --> 00:02:33,790
.حاضر

12
00:02:32,010 --> 00:02:33,180
.فوجيموتو

13
00:02:34,400 --> 00:02:35,480
.هوندا

14
00:02:38,770 --> 00:02:40,180
!هوندا

15
00:02:40,850 --> 00:02:42,680
!نـ-نعم، حاضر

16
00:02:45,550 --> 00:02:46,310
ما الخطب؟

17
00:03:19,940 --> 00:03:20,780
.تفضّل

18
00:03:20,780 --> 00:03:21,840
.شكرًا لك

19
00:03:23,540 --> 00:03:24,800
.إنّه دافئ

20
00:03:24,800 --> 00:03:26,140
.الجوّ بارد في الخارج

21
00:03:26,140 --> 00:03:26,850
.نعم

22
00:03:29,140 --> 00:03:34,100
ألم تسر الأمور على ما يرام بين
ميهاشي-سان وهوندا-كُن؟

23
00:03:35,220 --> 00:03:36,600
من يدري؟

24
00:03:36,600 --> 00:03:40,410
...بدت وكأنّها تسير على ما يرام، لكن الآن

25
00:03:41,490 --> 00:03:43,910
هل يبتعدان عن بعض فحسب؟

26
00:03:44,320 --> 00:03:45,870
...ذلك

27
00:03:46,560 --> 00:03:48,840
.أتمنّى أن تُحلّ مشاكلهما

28
00:03:52,370 --> 00:03:53,210
.نعم

29
00:03:59,190 --> 00:04:01,000
هل بوسعنا فعل أيّ شيء؟

30
00:04:02,420 --> 00:04:04,360
.من أجل ميهاشي-سان وهوندا-كُن

31
00:04:05,040 --> 00:04:06,810
مثل ماذا؟

32
00:04:06,810 --> 00:04:08,140
...مثل

33
00:05:05,080 --> 00:05:07,200
ماذا تريد؟

34
00:05:07,200 --> 00:05:09,150
هل لديك وقت؟

35
00:05:09,150 --> 00:05:10,340
ماذا؟

36
00:05:10,340 --> 00:05:13,750
...حسنًا، في الحقيقة

37
00:05:14,820 --> 00:05:16,190
ماذا؟

38
00:05:16,190 --> 00:05:18,810
هل أنت متفرّغ في الرّابع والعشرين؟

39
00:05:18,810 --> 00:05:20,110
.إنّها ليلة مراسم الاختتام

40
00:05:20,110 --> 00:05:21,760
عشيّة عيد الميلاد؟

41
00:05:21,760 --> 00:05:23,920
ماذا تفعل بطلبك من رجل الخروج معك؟

42
00:05:23,920 --> 00:05:26,840
.غبيّ، تكلّمت مع ماشيكي اليوم

43
00:05:26,840 --> 00:05:30,570
ماذا؟ تريدني أن أذهب معك
في موعدكما يا هاروكي-كُن؟

44
00:05:30,570 --> 00:05:31,930
.كلاّ

45
00:05:31,930 --> 00:05:35,310
.فكّرنا في إقامة حفلة

46
00:05:35,310 --> 00:05:37,820
حفلة عيد ميلاد؟

47
00:05:37,820 --> 00:05:40,360
.قالت أنّها تريدك أن تأتي

48
00:05:43,440 --> 00:05:45,690
دعوت ممثّلة القسم أيضًا، صحيح؟

49
00:05:47,450 --> 00:05:50,360
.حسنًا. فهمت

50
00:05:50,360 --> 00:05:51,450
.توا

51
00:05:52,240 --> 00:05:53,420
.لن تأتي

52
00:05:54,720 --> 00:05:57,830
.أعتقد أنّها كانت تتجنّبني في المدرسة مؤخّرًا

53
00:05:57,830 --> 00:06:00,330
.لم أستطع التّحدّث إليها

54
00:06:01,860 --> 00:06:03,960
.كما أنّ عائلتها تراقبها أيضًا

55
00:06:15,220 --> 00:06:16,620
.لا أدري

56
00:06:16,620 --> 00:06:19,240
...قالت ماشيكي أنّها ستحاول دعوتها، لكن

57
00:06:20,310 --> 00:06:21,040
توا؟

58
00:06:21,040 --> 00:06:23,340
.آسف. أنا مشغول ذلك اليوم

59
00:06:23,340 --> 00:06:24,610
ماذا؟ فعلاً؟

60
00:06:25,060 --> 00:06:28,380
.فعلاً. الأمر متعلّق بعائلتي

61
00:06:28,380 --> 00:06:29,610
.فهمت

62
00:06:31,490 --> 00:06:34,460
.سيكون الأمر صعبًا إذًا

63
00:06:35,200 --> 00:06:37,240
هل أنت واثق أنّك لا تستطيع المرور ولو للحظة؟

64
00:06:39,320 --> 00:06:40,640
توا؟

65
00:06:40,640 --> 00:06:42,430
.أنا خائف

66
00:06:44,280 --> 00:06:47,420
.أنا خائف من الحديث مع ممثّلة القسم

67
00:06:47,420 --> 00:06:48,630
لماذا؟

68
00:06:56,770 --> 00:06:58,930
.لا تهتمّ. لا شيء

69
00:06:58,930 --> 00:07:01,020
.سأحضر بمجرّد أن أنتهي

70
00:07:01,310 --> 00:07:02,750
.حـ-حسنًا

71
00:07:02,750 --> 00:07:05,050
.لكنّي لا أعرف في أيّ ساعة سيكون ذلك

72
00:07:05,050 --> 00:07:06,000
!توا

73
00:07:06,000 --> 00:07:06,750
.إلى اللّقاء

74
00:07:08,200 --> 00:07:09,480
.كلاّ

75
00:07:11,910 --> 00:07:13,960
.طبعًا أنا خائف

76
00:07:15,080 --> 00:07:17,540
.قد تكون علاقتنا قد انتهت

77
00:07:34,390 --> 00:07:35,370
.تفضّل

78
00:07:35,370 --> 00:07:37,050
.سآخذ هذه

79
00:08:27,940 --> 00:08:30,610
.تبدأ عطلة الشّتاء ابتداءً من الغد

80
00:08:31,120 --> 00:08:37,120
رغم أنّ هذا الموسم مليء بالأحداث
،مثل عيد الميلاد ورأس السّنة

81
00:08:37,470 --> 00:08:41,310
فعلى التّلاميذ الّذين تنتظرهم
امتحانات أن يهتمّوا جيّدًا بأنفسهم

82
00:08:41,310 --> 00:08:45,900
ويدرسون أكثر من أيّ وقت آخر
.بينما يدخلون دورتهم الأخيرة

83
00:09:00,630 --> 00:09:02,020
.ميشيما-كُن

84
00:09:04,240 --> 00:09:05,830
.شـ-شكرًا على استضافتي

85
00:09:06,630 --> 00:09:07,560
.تفضّل

86
00:09:08,020 --> 00:09:09,360
.خذي

87
00:09:10,870 --> 00:09:11,780
.شكرًا

88
00:09:13,510 --> 00:09:14,780
.مرحبًا

89
00:09:15,200 --> 00:09:16,590
.شكرًا على استضافتي

90
00:09:16,590 --> 00:09:18,190
.اعتبر المنزل منزلك

91
00:09:18,190 --> 00:09:19,360
.حا-حاضر

92
00:09:19,360 --> 00:09:20,720
.مع السّلامة يا ميهارو

93
00:09:20,720 --> 00:09:22,540
.إلى اللّقاء

94
00:09:26,070 --> 00:09:28,750
.سوف يخرج والداي

95
00:09:28,750 --> 00:09:29,900
فعلاً؟

96
00:09:30,920 --> 00:09:33,640
،لم أدعُ أصدقائي للاحتفال في المنزل من قبل

97
00:09:33,640 --> 00:09:35,550
.لذلك أعتقد أنّهما كانا يراعيان مشاعري

98
00:09:35,960 --> 00:09:37,360
.مساء الخير

99
00:09:37,360 --> 00:09:39,470
.ميهاشي، لقد أتيتِ

100
00:09:39,470 --> 00:09:42,060
.لم أستطع إخبار والداي حتّى آخر لحظة

101
00:09:42,400 --> 00:09:43,500
.آسفة

102
00:09:43,500 --> 00:09:45,370
.لا بأس. أنا سعيدة لحضورك

103
00:09:45,370 --> 00:09:47,790
يمكنك البقاء لساعة أخرى، صحيح؟

104
00:09:47,790 --> 00:09:49,080
ساعة؟

105
00:09:49,080 --> 00:09:51,580
.نعم. عليّ العودة باكرًا

106
00:09:54,630 --> 00:09:57,030
هل سيصل هوندا-كُن في الوقت المناسب؟

107
00:09:57,920 --> 00:09:59,570
.لستُ واثقًا

108
00:10:02,660 --> 00:10:04,120
.لنبدأ الحفلة

109
00:10:04,120 --> 00:10:05,870
هل يمكنكما مساعدتي لإحضار الأغراض؟

110
00:10:05,870 --> 00:10:06,940
.حسنًا

111
00:10:06,940 --> 00:10:07,710
.أكيد

112
00:10:31,730 --> 00:10:32,960
هل كنت متوتّرًا؟

113
00:10:33,730 --> 00:10:38,460
.أظنّ ذلك. لم أكن أراه كثيرًا

114
00:10:38,460 --> 00:10:39,840
.معك حقّ

115
00:10:39,840 --> 00:10:42,880
متى كانت آخر مرّة أكلنا فيها معًا نحن الثّلاثة؟

116
00:10:42,880 --> 00:10:45,240
.لم نتحدّث عن العائلة

117
00:10:45,240 --> 00:10:47,860
.زوج أمّك متوتّر أيضًا

118
00:10:47,860 --> 00:10:49,540
.من الصّعب عليه فتح الموضوع

119
00:10:50,150 --> 00:10:52,080
.أعتقد أنّه يراعي مشاعر الآخرين كثيرًا

120
00:10:52,080 --> 00:10:53,610
.كلاكما كذلك

121
00:10:56,480 --> 00:10:57,740
.أخبرني يا توا

122
00:10:59,250 --> 00:11:02,470
هل كنت تعارض زواجي ثانية؟

123
00:11:02,900 --> 00:11:04,980
.بالطّبع كنت أعارضه

124
00:11:06,340 --> 00:11:09,720
.رغم أنّه كان أمرًا واقعًا، إلاّ أنّي واصلت الهرب

125
00:11:12,630 --> 00:11:14,430
.لم أكن إلاّ مصدرًا للمشاكل

126
00:11:14,430 --> 00:11:16,710
.آسف. وعلى ما حدث ذلك اليوم أيضًا

127
00:11:17,520 --> 00:11:20,420
.أنت أهمّ شيء عندي

128
00:11:20,880 --> 00:11:23,500
.يفهم زوج أمّك ذلك أيضًا

129
00:11:23,500 --> 00:11:26,080
.أتمنّى لو تقدّر مشاعرك الخاصّة أكثر

130
00:11:26,080 --> 00:11:27,540
.لا أستحقّ هذا

131
00:11:32,760 --> 00:11:38,050
.أفّكر دائمًا بنفسيّ، لكنّي جبان بلا فائدة

132
00:11:38,630 --> 00:11:40,450
.أعرف ذلك

133
00:11:40,450 --> 00:11:41,550
توا؟

134
00:11:51,560 --> 00:11:56,420
،أريد أن أكون لطيفًا معها
.لكنّي أغضب بسبب أشياء تافهة

135
00:12:01,010 --> 00:12:02,840
...أعلم، ولكنّي

136
00:12:03,700 --> 00:12:04,940
...أنا

137
00:12:20,130 --> 00:12:21,740
.أنا أقطّع الكعكة

138
00:12:23,130 --> 00:12:24,840
.سأحضر الأطباق

139
00:12:41,320 --> 00:12:42,360
توا؟

140
00:12:42,360 --> 00:12:44,360
.آسف. عليّ الذّهاب

141
00:13:11,060 --> 00:13:14,250
.أنا خائف، لكن لا أستطيع مواصلة الهرب

142
00:13:15,040 --> 00:13:17,140
.أعرف أنّها تشعر بنفس الشّيء الآن

143
00:13:19,730 --> 00:13:22,160
.أبلغيه السّلام عنّي عندما يعود

144
00:13:22,160 --> 00:13:24,740
.أخبريه أنّنا سنتحدّث في وقت لاحق

145
00:13:25,280 --> 00:13:26,620
.لن أهرب بعد الآن

146
00:13:36,640 --> 00:13:39,900
.آسفة لأنّي لم أستطع البقاء طويلاً

147
00:13:39,900 --> 00:13:42,500
.لا عليك. أنا سعيدة بقدومك

148
00:13:42,500 --> 00:13:44,270
.لقد استمتعت

149
00:13:44,270 --> 00:13:45,520
.شكرًا لك

150
00:13:45,520 --> 00:13:47,820
.تمنّيت لو حضر هوندا-كُن

151
00:13:47,820 --> 00:13:49,640
.ما باليد حيلة

152
00:13:49,640 --> 00:13:50,510
...كما أنّ

153
00:13:55,640 --> 00:13:58,170
.المعذرة. إلى اللّقاء

154
00:14:02,530 --> 00:14:03,540
مرحبًا؟

155
00:14:04,030 --> 00:14:06,530
يا ممثّلة القسم، أما زلت في منزل ماشيكي؟

156
00:14:06,530 --> 00:14:07,640
!أريد رؤيتك

157
00:14:08,550 --> 00:14:09,530
...أريد

158
00:14:09,530 --> 00:14:10,950
.التّحدّث إليك مباشرة

159
00:14:11,490 --> 00:14:13,630
.لا تقولي أنّك لا تستطيعين

160
00:14:13,630 --> 00:14:14,540
.انتظريني

161
00:14:14,540 --> 00:14:16,540
.دقيقة واحدة فقط، أو حتّى ثانية

162
00:14:16,540 --> 00:14:17,590
!يا ممثّلة القسم

163
00:14:22,040 --> 00:14:23,430
ميهاشي-سان؟

164
00:14:28,490 --> 00:14:29,550
ميهاشي؟

165
00:16:08,930 --> 00:16:12,400
.آسفة، لكن لا أستطيع المغادرة الآن

166
00:16:13,520 --> 00:16:15,050
.سأبقى لوقت أطول

167
00:16:15,720 --> 00:16:17,240
.كلاّ

168
00:16:17,240 --> 00:16:19,960
.رجاءً، هذا مهمّ

169
00:16:19,960 --> 00:16:21,910
!هذا أهمّ شيء بالنّسبة لي

170
00:16:23,970 --> 00:16:26,170
!لهذا الأولويّة عندي

171
00:16:30,020 --> 00:16:32,980
.حسنًا، سأفعل

172
00:16:44,640 --> 00:16:46,440
.كان بإمكانك الانتظار

173
00:16:47,810 --> 00:16:50,820
هل كنتِ يائسة لذلك الحدّ لرؤيتي؟

174
00:17:13,830 --> 00:17:14,680
.خذي

175
00:17:15,220 --> 00:17:16,280
.شكرًا

176
00:17:19,670 --> 00:17:21,060
هل أنا قريب جدًّا؟

177
00:17:21,060 --> 00:17:21,720
.ربّما

178
00:17:26,450 --> 00:17:27,790
...في ذلك اليوم

179
00:17:29,090 --> 00:17:31,960
في ذلك اليوم، كنت أنفّس عن إحباطي
.في وجهك فحسب

180
00:17:31,960 --> 00:17:34,330
.أنا جدّ آسف. كان ذلك تصرّفًا فظيعًا منّي

181
00:17:38,290 --> 00:17:42,040
.أردتُ الاعتراف بي

182
00:17:43,600 --> 00:17:47,710
.حاولتُ دائمًا البقاء بعيدة عن المشاكل

183
00:17:47,710 --> 00:17:49,630
.كنتَ على حقّ تمامًا

184
00:17:49,630 --> 00:17:50,790
—أنا

185
00:17:51,270 --> 00:17:53,380
.لكن هذه أنا

186
00:17:53,840 --> 00:17:55,900
.أريد هذا لأنّه مهمّ عندي

187
00:17:56,470 --> 00:17:59,580
من الغريب أن يكون المرؤ مقيّدًا
بين عائلته، صحيح؟

188
00:17:59,580 --> 00:18:01,050
!ليس غريبًا أبدًا

189
00:18:01,050 --> 00:18:03,570
!تقلقين بشأنهم لأنّهم عائلتك

190
00:18:05,760 --> 00:18:07,240
.نفس الشّيء ينطبق عليّ

191
00:18:07,750 --> 00:18:12,740
.حتّى الأشياء الصّغيرة كانت صعبة عليّ

192
00:18:12,740 --> 00:18:14,250
.واصلت الهرب منها

193
00:18:14,870 --> 00:18:16,570
.هذا سخيف للغاية

194
00:18:17,250 --> 00:18:19,030
.ليس سخيفًا

195
00:18:19,460 --> 00:18:20,730
.شكرًا لك

196
00:18:21,550 --> 00:18:23,620
.كلّ هذا بفضلك يا ممثّلة القسم

197
00:18:24,280 --> 00:18:27,050
.كنتُ أفكّر فيك كثيرًا

198
00:18:27,410 --> 00:18:31,540
،سواء كنتِ ستغضبن منّي أو تبتسمين

199
00:18:32,320 --> 00:18:35,540
.فكلّ ذلك مهمّ عندي

200
00:18:37,960 --> 00:18:42,860
أنت الّتي ساعدتني على إدراك
.ما الأهمّ لديّ يا ممثّلة القسم

201
00:18:43,810 --> 00:18:45,420
.أنت يا ميهاشي

202
00:18:49,430 --> 00:18:53,810
.أدركتُ ذلك أيضًا بسببك أنت

203
00:18:53,810 --> 00:18:55,350
.لقد ساعدتني على التّغيّر

204
00:18:55,350 --> 00:18:57,290
.قد نتغيّر أكثر

205
00:18:57,290 --> 00:18:58,150
.نعم

206
00:18:59,750 --> 00:19:02,810
.سأنضج خطوةً خطوة

207
00:19:02,810 --> 00:19:03,560
.نعم

208
00:19:04,340 --> 00:19:05,420
.سأبذل ما بوسعي

209
00:19:06,070 --> 00:19:08,470
.نعم. وأنا أيضًا

210
00:19:14,460 --> 00:19:16,750
.يا للإزعاج

211
00:19:16,750 --> 00:19:19,990
.لكنّ هذا من طباع هوندا-كُن
