1
00:00:11,360 --> 00:00:17,540
.هذه قصّة أمير صغير من ممكلة حوريّات البحر

2
00:00:19,490 --> 00:00:25,670
في أحد الأيّام، أخرج الأمير الخيلان رأسه من المحيط

3
00:00:26,440 --> 00:00:32,170
.لأنّه كانت هنالك فتاة بشريّة تقف على قمّة جرف

4
00:00:35,630 --> 00:00:38,010
ماشيكي ميـ

5
00:00:36,610 --> 00:00:40,380
.كانت رحلة طويلةً طويلة

6
00:01:17,080 --> 00:01:18,470
...كان حلمًا

7
00:01:21,240 --> 00:01:22,410
!أيّها الوغد

8
00:02:59,550 --> 00:03:01,080
لماذا هذا التّعبير على وجهك؟

9
00:03:01,860 --> 00:03:02,730
ماذا؟

10
00:03:02,730 --> 00:03:03,620
.أنت وقح

11
00:03:04,840 --> 00:03:06,420
.أنت سعيد للغاية

12
00:03:06,420 --> 00:03:07,700
.ذلك صحيح

13
00:03:20,620 --> 00:03:22,240
.هذا جيّد

14
00:03:22,810 --> 00:03:23,910
.أخبرني

15
00:03:23,910 --> 00:03:24,850
ماذا؟

16
00:03:25,520 --> 00:03:27,100
.عليك أن تحاول أيضًا

17
00:03:28,700 --> 00:03:29,650
!اخرس

18
00:03:29,650 --> 00:03:30,230
.هذا مؤلم

19
00:03:30,490 --> 00:03:32,000
.لا تقلق بشأني

20
00:03:32,000 --> 00:03:34,230
على أيّ حال، أليس مهرجان أوزورا وشيكًا؟

21
00:03:34,550 --> 00:03:37,170
.نعم، هذا المكان يعجّ بالحيويّة

22
00:03:37,170 --> 00:03:38,410
.هنالك الكثير للنحضّره

23
00:03:38,410 --> 00:03:39,800
!نعم، التّحضيرات

24
00:03:39,800 --> 00:03:42,740
لهذا السّبب سنتمكّن من قضاء
!وقت معًا بعد المدرسة

25
00:03:43,330 --> 00:03:44,750
.لا يهمّ

26
00:03:53,120 --> 00:03:57,130
مهرجان أوزورا الثّاني والثّلاثون

27
00:03:53,120 --> 00:03:57,130
سيقام حدث سبتمبر السّنويّ
!ثانية هذه السّنة أيضًا

28
00:03:53,120 --> 00:03:57,130
‫16 ~ 17 / 9 (السّبت والأحد)

29
00:04:38,510 --> 00:04:40,740
.ميهاشي-سان، لم أرك منذ مدّة

30
00:04:41,830 --> 00:04:43,560
فـ-فعلاً؟

31
00:04:43,560 --> 00:04:46,070
...هل مرّ وقت طويل بالفعل؟ أنا

32
00:04:46,070 --> 00:04:47,800
!يا ممثّلة القسم

33
00:04:48,250 --> 00:04:49,810
.ها أنت ذي

34
00:04:50,450 --> 00:04:53,300
.أخبريني يا ممثّلة القسم
هل أنت متفرّغة بعد هذا؟

35
00:04:53,300 --> 00:04:54,870
!بالطّبع لا

36
00:04:54,870 --> 00:04:57,430
لماذا؟ لست متفرّغة؟

37
00:04:57,430 --> 00:04:59,820
.هوندا-كُن، أخفض صوتك

38
00:05:01,170 --> 00:05:02,600
.يا ممثّلة القسم

39
00:05:02,600 --> 00:05:03,940
ما الّذي تريده؟

40
00:05:05,630 --> 00:05:07,460
ما-ما الّذي تعنينه؟

41
00:05:07,460 --> 00:05:10,360
.علينا مناقشة أمر مهرجان أوزورا

42
00:05:10,360 --> 00:05:13,140
ظننتُ أنّ بإمكاننا الحديث بشأنه
.بينما نسير للمنزل معًا

43
00:05:14,400 --> 00:05:16,630
.حسنًا، من الأفضل أن أذهب

44
00:05:16,630 --> 00:05:17,520
.مهلاً

45
00:05:18,250 --> 00:05:19,750
.ليس لديّ وقت لك

46
00:05:19,750 --> 00:05:21,990
.لقد وعدتُ ماشيكي-سان أن ألقاها بعد هذا

47
00:05:22,710 --> 00:05:23,430
.لنذهب

48
00:05:23,430 --> 00:05:24,730
!مهلاً

49
00:05:24,730 --> 00:05:27,990
!يا ممثّلة القسم؟ انتظري يا ممثّلة القسم

50
00:05:38,160 --> 00:05:41,700
ميهاشي-سان، لماذا كذبت عليه؟

51
00:05:45,620 --> 00:05:49,920
هل حدث أمر ما مع هوندا-كُن
في عرض الألعاب النّاريّة؟

52
00:05:56,030 --> 00:05:57,210
.مستحيل

53
00:05:57,210 --> 00:05:59,660
!كـ-كلاّ يا ماشيكي-سان

54
00:05:59,660 --> 00:06:01,940
...لقد كان

55
00:06:02,530 --> 00:06:04,710
.كنتُ متفاجئة فحسب على ما أظنّ

56
00:06:04,710 --> 00:06:06,090
ميهاشي-سان؟

57
00:06:06,420 --> 00:06:09,890
.لا بدّ أنّ على وجهي نظرة غريبة

58
00:06:10,330 --> 00:06:14,470
...أنا لا أفهم مثل هذه الأمور، لذلك

59
00:06:21,820 --> 00:06:24,530
.هكذا إذًا؟ هذا جيّد

60
00:06:24,990 --> 00:06:26,280
هل هو جيّد بالفعل؟

61
00:06:26,280 --> 00:06:28,530
.نعم، هذا ممتاز

62
00:06:29,760 --> 00:06:33,550
.فعلاً؟ شكرًا يا ماشيكي-سان

63
00:06:35,740 --> 00:06:37,200
ماذا عنك؟

64
00:06:39,520 --> 00:06:42,280
أليس لديك شخص ما يحوز على اهتمامك؟

65
00:06:47,250 --> 00:06:50,130
شخص يحوز على اهتمامي؟

66
00:06:56,510 --> 00:06:57,750
.لستُ واثقة

67
00:06:59,500 --> 00:07:00,580
فعلاً؟

68
00:07:01,890 --> 00:07:03,310
.من الأفضل أن أذهب

69
00:07:04,160 --> 00:07:05,770
.ادرسي بجدّ في المدرسة المتخصّصة

70
00:07:05,770 --> 00:07:06,620
.إلى اللّقاء

71
00:07:06,620 --> 00:07:07,430
.مع السّلامة

72
00:07:21,460 --> 00:07:22,830
.شكرًا لك

73
00:07:28,640 --> 00:07:30,470
.شكرًا لكما

74
00:07:32,130 --> 00:07:33,620
.إنّه الرّبيع

75
00:07:33,620 --> 00:07:35,640
.لكنّ الصّيف في نهايته

76
00:07:35,640 --> 00:07:38,700
.كلاّ، قصدت ربيع شبابهما

77
00:07:38,700 --> 00:07:41,040
.ركّز على عملك رجاءً

78
00:07:49,070 --> 00:07:50,920
.كنت تعرف بشأنهما

79
00:07:52,040 --> 00:07:53,730
.نعم، نوعًا ما

80
00:07:54,360 --> 00:07:55,910
.لقد تفاجأت

81
00:07:56,480 --> 00:08:00,070
.حسنًا، أنا سعيد لأنّ الأمر مرّ بخير

82
00:08:03,100 --> 00:08:05,380
.نعم، معك حقّ

83
00:08:21,290 --> 00:08:22,640
.ميشيما-كُن

84
00:08:31,360 --> 00:08:35,180
ما هو شعور أن نهتمّ بشأن شخص آخر؟

85
00:08:36,910 --> 00:08:38,740
ما-ما الّذي تعنينه؟

86
00:08:40,170 --> 00:08:42,890
.عفوًا... ما سمعته بالتّحديد

87
00:08:42,890 --> 00:08:43,960
.مثلهما كما تعلم

88
00:08:43,960 --> 00:08:46,280
.ذلك النّوع من الاهتمام

89
00:08:48,170 --> 00:08:51,560
ميشيما-كُن، هل هنالك من يحوز على اهتمامك؟

90
00:08:56,480 --> 00:09:00,830
أنا... لـ-لماذا قد تسألينني ذلك؟

91
00:09:08,690 --> 00:09:10,730
هل أنت غبيّ؟

92
00:09:11,680 --> 00:09:14,200
،كنتما معًا في الحديقة بعد المدرسة

93
00:09:14,200 --> 00:09:16,410
وسألتك إن كنت مهتمًّا بأحد ما؟

94
00:09:16,410 --> 00:09:18,550
!كان عليك إخبارها بحقيقة مشاعرك

95
00:09:18,550 --> 00:09:19,740
!كلاّ، ما كان عليّ ذلك

96
00:09:20,140 --> 00:09:24,790
هاروكي-كُن، سيأتي صبيان من مدارس
.أخرى في المهرجان الثّقافيّ

97
00:09:25,260 --> 00:09:28,150
.قد ينتهي المطاف بماشيكي-سان مع أحد آخر

98
00:09:28,150 --> 00:09:28,920
...ذ-ذلك سيكون

99
00:09:29,260 --> 00:09:30,960
سيّئًا، صحيح؟

100
00:09:30,960 --> 00:09:32,200
!اخرس

101
00:09:32,200 --> 00:09:33,730
!هذا ليس من شأنك

102
00:09:33,730 --> 00:09:35,760
!اقلق على نفسك فحسب

103
00:09:38,340 --> 00:09:39,460
ما الخطب؟

104
00:09:40,210 --> 00:09:41,540
.لقد هربت منّي

105
00:09:42,680 --> 00:09:46,470
.توا، تريد أن تعرف أمّي ما ستفعله اليوم

106
00:09:46,470 --> 00:09:49,690
كنتُ سأذهب للمنزل، لكنّي
.سأبقى هنا كما هو واضح

107
00:09:49,690 --> 00:09:51,140
!كلاّ، عد للمنزل

108
00:09:51,140 --> 00:09:53,080
!لا تقل ذلك

109
00:09:53,080 --> 00:09:54,820
!ترأّف بي، أنا مكتئب

110
00:09:54,820 --> 00:09:55,570
!ليست مشكلتي

111
00:09:55,570 --> 00:09:57,110
إذًا ستبقى معنا؟

112
00:09:57,110 --> 00:09:57,900
!أنا باقٍ

113
00:09:57,900 --> 00:09:58,790
!أنت لا تُصدّق

114
00:09:58,790 --> 00:09:59,880
!قلت أنّي باقٍ

115
00:09:59,880 --> 00:10:01,990
!عد لمنزلك

116
00:10:00,690 --> 00:10:01,330
!أنا باقٍ

117
00:10:01,990 --> 00:10:02,700
!كلاّ

118
00:10:02,700 --> 00:10:06,930
.قالت أمّي أن تستحمّا قبل العشاء

119
00:10:20,160 --> 00:10:21,760
.مرحبًا

120
00:10:24,160 --> 00:10:26,600
.هذا كلّ ما بقي لنا

121
00:10:26,600 --> 00:10:28,410
.لا بأس. أقدّر لك هذا

122
00:10:28,410 --> 00:10:30,600
.يتمّ التّنازع عليها كثيرًا كلّ سنة

123
00:10:30,600 --> 00:10:32,420
ما الّذي سيفعله قسمكم؟

124
00:10:32,420 --> 00:10:34,090
.منزلاً مسكونًا بالأشباح

125
00:10:34,090 --> 00:10:39,500
إذًا ستكدّسون الطّاولات لتشكّلوا
.جدرانًا وستصنعون قبورًا

126
00:10:39,500 --> 00:10:40,470
.نعم

127
00:10:41,230 --> 00:10:45,410
أعتقد أنّ الصّيدليّة الّتي قرب المحطّة
.لديها صناديق كرتونيّة كبيرة

128
00:10:45,410 --> 00:10:47,640
.حسنًا! شكرًا لك

129
00:10:57,020 --> 00:10:58,930
هل ستفي هذه بالغرض؟

130
00:10:58,930 --> 00:11:01,090
.نعم، شكرًا لك

131
00:11:14,650 --> 00:11:15,910
.ميشيما-كُن

132
00:11:31,120 --> 00:11:33,960
بياض الثّلج

133
00:11:32,410 --> 00:11:33,960
لا أقزام؟

134
00:11:33,960 --> 00:11:37,210
."نعم، إنّها مسرحيّة عصريّة مقتبسة من "بياض الثّلج

135
00:11:37,660 --> 00:11:38,980
عصريّة؟

136
00:11:38,980 --> 00:11:42,260
إذًا فبدل الأقزام السّبعة، لدينا الأطبّاء السّبعة؟

137
00:11:42,260 --> 00:11:44,450
.عملنا على الفكرة كقسم

138
00:11:44,450 --> 00:11:46,330
.قمنا بالكثير من التّعديلات

139
00:11:46,330 --> 00:11:49,380
.فعلاً؟ أنا مندهش لتفكيركم في ذلك

140
00:11:49,990 --> 00:11:52,730
.كان من الممتع الاستماع لكلّ الأفكار

141
00:11:52,730 --> 00:11:54,130
.لا يخطر شيء في بالي

142
00:11:55,250 --> 00:11:56,510
.أنت رائعة يا ماشيكي

143
00:11:56,940 --> 00:11:58,520
أتظنّ ذلك؟

144
00:11:58,520 --> 00:12:00,280
.نعم، أنت رائعة

145
00:12:07,530 --> 00:12:12,410
.أحببتُ كتُب الصّور مثل هذه منذ صغري

146
00:12:12,410 --> 00:12:14,050
.أستطيع قراءتها على الدّوام

147
00:12:14,560 --> 00:12:15,890
فعلاً؟

148
00:12:15,890 --> 00:12:18,470
.أعتقد أنّي قد أؤلّف واحدًا بنفسي يومًا ما

149
00:12:18,470 --> 00:12:20,210
...فعلاً؟ في تلك الحالة

150
00:12:26,480 --> 00:12:28,810
هل لديك كتاب مفضّل؟

151
00:12:31,040 --> 00:12:33,170
.يمكنك إخباري بثاني أفضل كتاب لديك

152
00:12:34,030 --> 00:12:36,800
...حسنًا

153
00:12:37,230 --> 00:12:38,820
ماذا عنك أنت؟

154
00:12:38,820 --> 00:12:39,990
ماذا؟ أنا؟

155
00:12:40,480 --> 00:12:41,530
ألديك؟

156
00:12:42,650 --> 00:12:45,070
.حسنًا، لستُ واثقًا

157
00:12:46,200 --> 00:12:48,160
...أنا

158
00:12:50,750 --> 00:12:51,410
.نعم

159
00:12:51,410 --> 00:12:53,990
فعلاً؟ ما عنوانه؟

160
00:12:55,580 --> 00:12:58,120
".الأمير الخيلان"

161
00:12:58,120 --> 00:13:00,870
.فعلاً؟ كان لديّ ذلك الكتاب أيضًا

162
00:13:02,520 --> 00:13:05,550
.كانت الصّور ظريفة. أذكرها جميعها

163
00:13:10,570 --> 00:13:11,600
.ماشيكي

164
00:13:13,680 --> 00:13:14,960
...ذلك الكتاب

165
00:13:19,440 --> 00:13:21,820
...ذ-ذلك الكتاب

166
00:13:23,440 --> 00:13:24,930
.سُحقًا

167
00:13:25,690 --> 00:13:27,290
.كلاّ

168
00:13:29,020 --> 00:13:30,340
.لا تهتمّي

169
00:13:30,970 --> 00:13:32,580
.لا يمكنني فعل هذا

170
00:13:32,580 --> 00:13:33,660
.آسف يا ماشيكي

171
00:13:33,660 --> 00:13:35,390
.عليّ العودة للمدرسة

172
00:13:36,210 --> 00:13:37,910
.حسنًا، أراك لاحقًا

173
00:13:40,380 --> 00:13:42,170
!سُحقًا

174
00:14:11,200 --> 00:14:14,200
الأمير الخيلان

175
00:14:11,200 --> 00:14:14,200
ماشيكي ميـ

176
00:14:54,840 --> 00:14:56,730
.حسنًا، تبدو جيّدة

177
00:14:56,730 --> 00:14:58,660
...والآن، بقي لدينا

178
00:15:04,220 --> 00:15:07,920
.هذا إعلان من مجلس التّلاميذ

179
00:15:07,920 --> 00:15:11,450
مع انطلاق المهرجان غدًا، فإنّ تجهيزاتكم
،قد بلغت أوجها على الأرجح

180
00:15:11,450 --> 00:15:12,950
لكن سيُسمح لكم

181
00:15:12,950 --> 00:15:14,930
.العمل في المدرسة حتّى السّادسة مساءً

182
00:15:16,080 --> 00:15:19,250
إنّ على الأقسام والنّوادي الّتي تنوي
مواصلة العمل بعد ذلك الوقت

183
00:15:19,250 --> 00:15:22,440
.أن تقدّم طلبًا لتمديد المدّة لمجلس التّلاميذ

184
00:15:23,090 --> 00:15:27,730
وفي كلّ الأحوال، ستمتدّ أقصى
.مدّة حتّى إلى التّاسعة ليلاً

185
00:15:30,560 --> 00:15:32,100
كيف كان ذلك؟

186
00:15:32,860 --> 00:15:34,180
.جيّد

187
00:15:34,180 --> 00:15:36,340
لماذا عليّ أنا أن أقوم بالإعلان؟

188
00:15:37,050 --> 00:15:39,310
.تنقصنا يد العون. آسف

189
00:15:40,010 --> 00:15:42,110
.سأقبل ببعض خبز البطّيخ كمقابل

190
00:15:48,860 --> 00:15:50,370
هل سننتهي في الوقت المحدّد؟

191
00:15:50,370 --> 00:15:52,470
.سنضطرّ لتقديم طلب

192
00:15:52,470 --> 00:15:55,160
ما زالت أمامنا أربع ساعات فقط
.في كلّ الأحوال

193
00:15:55,160 --> 00:15:56,340
.سأساعدكم

194
00:15:56,890 --> 00:15:59,730
!فعلاً؟ شكرًا لك يا ماشيكي-سان

195
00:15:59,730 --> 00:16:01,190
!نقدّر لك ذلك بالفعل

196
00:16:01,850 --> 00:16:03,190
.هيّا لنبدأ

197
00:16:13,170 --> 00:16:15,390
.أنا متحمّس للغد

198
00:16:17,100 --> 00:16:19,010
.سأسير معك للمنزل

199
00:16:19,010 --> 00:16:20,940
.هنالك من سيُقلّني

200
00:16:20,940 --> 00:16:22,650
—لكنّي قلق بشأن

201
00:16:22,650 --> 00:16:25,600
.ما زال جيراننا يعملون

202
00:16:30,410 --> 00:16:32,340
.سيفي ذلك بالغرض

203
00:16:33,010 --> 00:16:35,480
علينا فقط القيام ببعض التّعديلات
.غدًا، وسنكون قد انتهينا

204
00:16:35,480 --> 00:16:37,890
!أنا سعيدة لأنّك كنت هنا يا ماشيكي-سان

205
00:16:38,460 --> 00:16:39,930
.آسفون على تأخيرك

206
00:16:39,930 --> 00:16:41,030
أتريدين منّي أن أوصلك للمنزل؟

207
00:16:41,650 --> 00:16:44,190
.شكرًا، لكن سأكون بخير

208
00:16:46,750 --> 00:16:48,900
.يا ممثّلة القسم، انتظري

209
00:16:48,900 --> 00:16:51,240
.لا تعودي للمنزل وحدك

210
00:16:51,240 --> 00:16:53,320
.انتظري هنا

211
00:16:56,530 --> 00:17:00,020
.إلى اللّقاء

212
00:17:01,170 --> 00:17:02,500
.نراك غدًا

213
00:17:02,500 --> 00:17:03,310
.نعم

214
00:17:06,690 --> 00:17:08,650
يعمل القسم 2 لوقت متأخّر أيضًا؟

215
00:17:08,650 --> 00:17:10,190
.نعم

216
00:17:12,350 --> 00:17:14,300
!ماشيكي-تشان، مرحبًا

217
00:17:15,010 --> 00:17:16,900
.لقد قال أنّه سيوصلك للمنزل

218
00:17:16,900 --> 00:17:18,590
.أيّها الغبيّ، إيّاك

219
00:17:21,010 --> 00:17:25,060
لا يمكنك السّماح لفتاة بالذّهاب
.للمنزل وحدها ليلاً

220
00:17:25,730 --> 00:17:28,250
.سأسير للمنزل مع ممثّلة القسم

221
00:17:29,370 --> 00:17:30,880
.اذهب أنت معها

222
00:17:31,650 --> 00:17:32,950
.لنذهب

223
00:17:32,950 --> 00:17:34,280
...مهلاً

224
00:17:48,960 --> 00:17:50,530
ما مشكلته؟

225
00:17:50,530 --> 00:17:52,820
.لقد أُجبرنا على السّير بوتيرة هوندا-كُن

226
00:17:57,120 --> 00:17:59,430
حـ-حسنًا، هل نذهب؟

227
00:18:02,140 --> 00:18:03,120
ماشيكي؟

228
00:18:03,920 --> 00:18:05,810
هل أنت في عجلة من أمرك يا ميشيما-كُن؟

229
00:18:11,360 --> 00:18:13,250
.أريد أن أتمشّى في الأرجاء

230
00:18:14,350 --> 00:18:17,780
.تعلم، بما أنّي لن أحظى بوقت غدًا

231
00:18:18,620 --> 00:18:19,570
.صحيح

232
00:18:29,580 --> 00:18:33,750
.واحد، اثنان، ثلاثة، أربعة

233
00:18:32,700 --> 00:18:33,590
أليس هذا لطيفًا؟

234
00:18:33,590 --> 00:18:36,970
.ستكون هذه الذّكريات مميّزة للأبد

235
00:18:39,230 --> 00:18:42,030
.سيتمّ نقلنا إلى أقسام مختلفة وسنتخرّج

236
00:18:42,430 --> 00:18:45,350
،وحتّى إن لم نستطع رؤية بعضنا ثانية يومًا ما

237
00:18:45,690 --> 00:18:48,430
فسنكون ما نزال قادرين على العودة
.لذكرياتنا ما دمنا نتذكّرها

238
00:18:49,170 --> 00:18:50,420
ماشيكي؟

239
00:18:53,260 --> 00:18:56,740
لذلك أريد أن أحظى بالكثير من
.المرح بقدر المستطاع

240
00:18:59,020 --> 00:18:59,910
.نعم

241
00:19:02,310 --> 00:19:04,360
.هذا ما أردتُ رؤيته

242
00:19:05,890 --> 00:19:07,410
.بقيت أمامنا عشر دقائق فقط

243
00:19:07,410 --> 00:19:08,530
.من الأفضل أن نسرع

244
00:19:23,280 --> 00:19:25,380
.أعرف هذا

245
00:19:26,300 --> 00:19:29,390
!وهذا أيضًا. يا للحنين

246
00:19:34,650 --> 00:19:35,740
ماذا؟

247
00:19:35,740 --> 00:19:37,010
.لا شيء

248
00:19:37,840 --> 00:19:39,730
.أنت تحبّين الكتب حقًّا

249
00:19:41,600 --> 00:19:43,650
.نعم، أحبّها

250
00:19:44,160 --> 00:19:47,170
.ولم أرَ الكثير منها هكذا من قبل

251
00:19:49,040 --> 00:19:50,680
.أعرف هذا أيضًا

252
00:19:50,680 --> 00:19:52,020
.إنّها تعيد الذّكريات

253
00:20:00,590 --> 00:20:02,470
..."الأمير الخيلان"

254
00:20:14,850 --> 00:20:15,750
...أنا

255
00:20:17,550 --> 00:20:20,410
.بدأتُ بالسّباحة بعد قراءتي له

256
00:20:27,390 --> 00:20:30,570
لا يستسلم الأمير في وجه المحن

257
00:20:30,570 --> 00:20:32,260
.ويواصل السّباحة

258
00:20:32,850 --> 00:20:35,300
.بدا لي ذلك في غاية الرّوعة

259
00:20:36,980 --> 00:20:38,870
.المياه مثيرة للاهتمام

260
00:20:38,870 --> 00:20:40,280
،تبدو ثقيلة في البداية

261
00:20:40,280 --> 00:20:43,380
لكن إن واصلنا المحاولة، فإنّ أجسادنا
.وقلوبنا ستغدو أخفّ

262
00:20:45,130 --> 00:20:46,950
.السّباحة ممتعة

263
00:20:46,950 --> 00:20:48,470
.شعور المياه لا يوصف

264
00:20:48,990 --> 00:20:53,390
.أنا جدّ سعيد لأنّي وجدت ذلك الكتاب في الحضانة

265
00:20:54,730 --> 00:20:55,590
.ماشيكي

266
00:21:02,280 --> 00:21:05,440
ارتدتِ حضانة واكابا أيضًا، صحيح؟

267
00:21:06,030 --> 00:21:07,370
أنت أيضًا؟

268
00:21:07,690 --> 00:21:08,830
.إلى اللّقاء

269
00:21:14,490 --> 00:21:18,240
.لم يكن ذلك كتابي

270
00:21:18,240 --> 00:21:21,970
.كانت هنالك فتاة قرأته لي وأعطتنيه

271
00:21:30,730 --> 00:21:33,730
.إنّه ذكرى مهمّة

272
00:21:34,310 --> 00:21:37,640
.إنّها جدّ مميّزة عندي أيضًا

273
00:21:39,460 --> 00:21:41,870
...أيعقل يا ماشيكي

274
00:21:47,570 --> 00:21:48,720
ماشيكي؟

275
00:23:40,090 --> 00:24:10,090
الحلقة القادمة

276
00:23:42,050 --> 00:23:47,310
أكتوبر، حينما تبدأ التّغيّرات الصّغيرة
.بالظّهور بين تراتب الفصلين

277
00:23:47,660 --> 00:23:49,320
.ظنّوا أنّها لن تتغيّر

278
00:23:49,730 --> 00:23:51,890
.كان من المستحيل أن تستطيع ذلك

279
00:23:52,320 --> 00:23:55,700
.القصّة الأخرى له ولها

280
00:23:55,700 --> 00:24:01,190
ذلك الخطّ الّذي لا يمكنهما تجاوزه
.مؤلم ومهمّ وغالٍ

281
00:24:01,790 --> 00:24:05,880
."في الحلقة القادمة من "كونبيني كاريشي
."الحلقة الخامسة: "أكتوبر

282
00:24:06,420 --> 00:24:10,090
.ها هنا كُتبت الحروف الأولى لقصّتهما