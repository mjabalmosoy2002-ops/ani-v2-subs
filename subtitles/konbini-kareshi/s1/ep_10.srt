1
00:00:04,160 --> 00:00:06,310
تنظر إليها ثانية؟

2
00:00:06,570 --> 00:00:07,940
.على الإطلاق

3
00:00:12,950 --> 00:00:15,670
.كانت زيارة الضّريح في يوم رأس السّنة ممتعة

4
00:00:17,860 --> 00:00:18,680
.انظر

5
00:00:20,820 --> 00:00:22,500
رائعة، صحيح؟

6
00:00:22,500 --> 00:00:25,210
.سأقدّرها لبقيّة حياتي

7
00:00:25,210 --> 00:00:27,120
.سبق وقلتَ ذلك

8
00:00:27,120 --> 00:00:29,690
.كان عليكما التقاط واحدة أيضًا

9
00:00:29,690 --> 00:00:30,960
لماذا؟

10
00:00:31,460 --> 00:00:32,970
.جبان

11
00:00:35,600 --> 00:00:37,160
.ما كنتُ لأريد إزعاجها

12
00:00:37,160 --> 00:00:40,010
.ماذا؟ اعتقدتُ أنّ الأمور تسير على ما يرام

13
00:00:41,330 --> 00:00:43,760
.لم يكن هنالك أيّ سبب معيّن لإعطائي ذاك

14
00:00:43,760 --> 00:00:45,680
لا سبب معيّن؟

15
00:00:45,680 --> 00:00:48,360
.أعتقد أنّه كان لديها سبب وجيه

16
00:00:49,750 --> 00:00:51,230
مثل ماذا؟

17
00:00:52,020 --> 00:00:54,460
—إنّكما بالفعل

18
00:00:57,040 --> 00:00:58,180
.إنّها ممثّلة القسم

19
00:00:58,740 --> 00:01:01,620
.آسف. أراك غدًا في المدرسة

20
00:01:08,130 --> 00:01:09,500
.يبدو أنّ الأمور تسير على ما يرام

21
00:01:10,160 --> 00:01:11,110
.نعم

22
00:02:56,180 --> 00:02:58,320
!البرد قارس

23
00:02:58,320 --> 00:03:01,150
!أكره الشّتاء. تعال بسرعة أيّها الرّبيع

24
00:03:01,150 --> 00:03:03,180
.لقد حلّ الرّبيع بالنّسبة لك سلفًا

25
00:03:03,890 --> 00:03:04,950
هل لديكما تدريب اليوم؟

26
00:03:05,600 --> 00:03:08,760
.يا ممثّلة القسم، لا أعتقد أنّ بإمكاني الاستمرار

27
00:03:08,760 --> 00:03:10,580
!لا أريد الخروج

28
00:03:11,520 --> 00:03:12,990
.تمالك نفسك

29
00:03:12,990 --> 00:03:15,360
.لكنّ الجوّ بارد

30
00:03:15,360 --> 00:03:16,630
.أنت لا تصدّق

31
00:03:20,070 --> 00:03:21,800
.لا أمل منك

32
00:03:22,920 --> 00:03:24,600
ماذا؟ يمكنني أخذها؟

33
00:03:24,600 --> 00:03:26,410
.لديّ اثنتان

34
00:03:27,520 --> 00:03:29,600
!شكرًا

35
00:03:30,150 --> 00:03:31,600
.تمرّن بجدّ

36
00:03:31,600 --> 00:03:34,340
كيف لي ألاّ أفعل بعد أن أعطيتني هذه؟

37
00:03:36,120 --> 00:03:38,230
.غبيّ، ضعها جانبًا

38
00:03:38,520 --> 00:03:40,620
.حسنًا، من الأفضل أن أذهب

39
00:03:40,620 --> 00:03:42,500
.تمرّن بجدّ أيضًا

40
00:03:45,720 --> 00:03:47,490
هل تتمرّنون بجدّ؟

41
00:03:47,490 --> 00:03:48,720
!نعم

42
00:03:48,720 --> 00:03:50,920
سينباي، ألا يجدر بك الدّراسة لامتحانات الولوج؟

43
00:03:50,920 --> 00:03:53,150
.أتيت لأحمّسكم يا رفاق

44
00:03:53,150 --> 00:03:54,800
أليست المنافسة قريبة؟

45
00:03:54,800 --> 00:03:56,240
.حظًّا سعيدًا يا ميشيما

46
00:03:57,150 --> 00:03:58,560
.أتوقّع أمورًا كبيرة منك

47
00:03:58,560 --> 00:04:00,800
سينباي، ماذا عنّا؟

48
00:04:00,800 --> 00:04:01,760
من يهتمّ؟

49
00:04:01,760 --> 00:04:04,090
.اطلب من حبيبتك أن تتمنّى لك حظًّا سعيدًا

50
00:04:04,090 --> 00:04:05,560
ماذا؟ أكنت تراقبنا؟

51
00:04:05,560 --> 00:04:08,220
فعلاً؟ لديك حبيبة؟

52
00:04:08,220 --> 00:04:09,950
.لا، ليس لديّ

53
00:04:09,950 --> 00:04:14,790
لكنّ تمنّي الفتاة الّتي أعجب بها الحظّ
السّعيد لي محفّز نوعًا ما، صحيح؟

54
00:04:16,320 --> 00:04:17,530
.حظًّا سعيدًا

55
00:04:26,230 --> 00:04:27,960
.أفكّر في المغادرة قريبًا

56
00:04:27,960 --> 00:04:29,160
ماذا عنك؟

57
00:04:29,590 --> 00:04:31,590
.سأظلّ لوقت أطول

58
00:04:34,360 --> 00:04:35,830
هل ستلتقيان لاحقًا؟

59
00:04:36,530 --> 00:04:37,350
.نعم

60
00:04:37,910 --> 00:04:39,210
.محظوظة

61
00:04:39,210 --> 00:04:40,380
.الأمر ليس كذلك

62
00:04:40,870 --> 00:04:42,780
.لن يكفّ عن الكلام إن غادرت من دونه

63
00:04:44,080 --> 00:04:46,580
سمعت أنّ ميشيما-كُن لديه
.منافسة سباحة وشيكة

64
00:04:47,620 --> 00:04:49,220
فعلاً؟

65
00:04:49,220 --> 00:04:50,680
لم تكوني تعلمين؟

66
00:04:50,680 --> 00:04:51,520
.نعم

67
00:04:51,910 --> 00:04:53,390
.كم هذا غير ودود منه

68
00:04:53,390 --> 00:04:56,770
.ظننتُ أنّك ستكونين أوّل شخص يخبره

69
00:04:56,770 --> 00:05:01,900
لا أصدّق أنّ ميشيما-كُن لم يخبرك
.بعد أن أهديته ذلك الوشاح

70
00:05:00,900 --> 00:05:01,900
...معذرة

71
00:05:01,900 --> 00:05:03,240
.إنّه لا يفهم

72
00:05:03,240 --> 00:05:05,290
.يمكن للفتيان أن يكونوا أغبياء

73
00:05:10,160 --> 00:05:11,720
...آسفتان

74
00:05:20,040 --> 00:05:21,610
.مرحبًا

75
00:05:26,050 --> 00:05:28,520
.إنّهما هنا اليوم أيضًا

76
00:05:28,520 --> 00:05:30,640
.لا تمعن النّظر إلى الزّبائن

77
00:05:30,640 --> 00:05:32,100
.حسنًا، حسنًا

78
00:05:33,620 --> 00:05:35,560
.لا بدّ أنّ التّمرّن لوقت متأخّر صعب

79
00:05:36,070 --> 00:05:38,080
.هنالك منافسة وشيكة

80
00:05:38,080 --> 00:05:39,990
.لقد أخبرتني ميهاشي-سان بذلك

81
00:05:40,420 --> 00:05:41,420
.هكذا إذًا

82
00:05:41,970 --> 00:05:45,370
لكنّي ما أزال غير واثق أنّهم سيختارونني
.لأكون عضوًا رئيسيًّا

83
00:05:45,370 --> 00:05:46,650
.حظًّا سعيدًا

84
00:05:46,820 --> 00:05:47,930
...نعم

85
00:05:48,220 --> 00:05:49,460
.شكرًا لك

86
00:05:51,970 --> 00:05:55,160
.عليّ أن أبلي أفضل بقليل

87
00:05:55,160 --> 00:05:56,270
.ربّما السّبب هو هيئتي

88
00:05:56,270 --> 00:05:58,250
...أستطيع تحريك ذراعي أكثر و

89
00:05:58,790 --> 00:05:59,740
ما الخطب؟

90
00:06:00,770 --> 00:06:02,960
.هنالك شيء ليس في محلّه

91
00:06:02,960 --> 00:06:04,320
ليس في محلّه؟

92
00:06:04,320 --> 00:06:06,660
.لستُ واثقًا أيضًا

93
00:06:11,310 --> 00:06:13,970
.نعم. نعم

94
00:06:13,970 --> 00:06:16,440
.فهمت. سأكون هناك في الحال

95
00:06:17,730 --> 00:06:18,480
.ماشيكي

96
00:06:19,010 --> 00:06:20,310
هل ستغادرين الآن؟

97
00:06:21,330 --> 00:06:23,670
نعم. هل أنهيتَ تدريبك؟

98
00:06:24,160 --> 00:06:25,350
.أظنّ ذلك

99
00:06:27,990 --> 00:06:29,360
هل من خطب ما؟

100
00:06:33,480 --> 00:06:34,740
.آسفة

101
00:06:37,500 --> 00:06:38,670
...أنا

102
00:06:38,670 --> 00:06:41,180
.لا بأس. آسف لإزعاجك

103
00:06:41,630 --> 00:06:44,180
.على العكس. أراك لاحقًا

104
00:06:50,680 --> 00:06:52,640
!هاروكي-كُن

105
00:06:55,700 --> 00:06:57,580
ما الّذي تفعله؟

106
00:06:57,580 --> 00:06:59,880
—الأمر ليس كذلك. أنا فقط

107
00:06:59,880 --> 00:07:01,760
.لا بأس. لا بأس

108
00:07:01,760 --> 00:07:04,160
.هذا يعني أنّك بدأت أخيرًا تشعر بالرّغبة

109
00:07:04,160 --> 00:07:06,010
ما الّذي تقصده بالرّغبة؟

110
00:07:06,010 --> 00:07:10,390
.رغم أنّها جزء من المشكلة الّتي لا تدركها بنفسك

111
00:07:13,960 --> 00:07:15,280
.هذا جيّد

112
00:07:15,990 --> 00:07:18,880
هنالك ضغط كبير عليك لتبلي حسنًا
في المنافسة، صحيح؟

113
00:07:18,880 --> 00:07:20,300
هل أخبرتها؟

114
00:07:20,300 --> 00:07:22,040
.ماذا؟ لا

115
00:07:22,040 --> 00:07:25,040
.لكنّها فرصتك لتتباهى أمامها

116
00:07:25,570 --> 00:07:27,040
أيّ فرصة؟

117
00:07:27,040 --> 00:07:30,170
من لا يريد أن تشجّعه الفتاة الّتي يُعجب بها؟

118
00:07:30,980 --> 00:07:33,640
.أ-أنا لا أريد

119
00:07:36,370 --> 00:07:37,560
.اتّصل بها

120
00:07:41,600 --> 00:07:43,480
!لقد عدت

121
00:07:54,070 --> 00:07:56,390
.حسنًا. لقد فهمت

122
00:08:01,940 --> 00:08:03,990
.هذا لا يصدّق

123
00:08:23,160 --> 00:08:24,840
.المعذرة

124
00:08:30,450 --> 00:08:31,360
ليست هنا؟

125
00:08:31,360 --> 00:08:33,530
ألم تسمع شيئًا؟

126
00:08:33,530 --> 00:08:35,900
.لقد أخبرتك أن تتّصل بها

127
00:08:35,900 --> 00:08:38,060
...نعم، ولكن

128
00:08:38,060 --> 00:08:40,570
.حسنًا، ربّما الأمر مجرّد زكام

129
00:08:41,110 --> 00:08:42,230
.هكذا إذًا

130
00:08:43,080 --> 00:08:44,870
لماذا لا تتّصل بها؟

131
00:08:46,080 --> 00:08:49,610
.كلاّ. أنا واثق أنّي سأراها غدًا

132
00:08:54,580 --> 00:08:56,260
مضت خمسة أيّام؟

133
00:08:56,260 --> 00:08:58,600
.لا أصدّق أنّها مريضة لذلك الحدّ

134
00:08:58,600 --> 00:09:00,190
.أنا قلقة

135
00:09:00,190 --> 00:09:01,210
.نعم

136
00:09:02,440 --> 00:09:04,380
—لهذا يا هاروكي عليك أن

137
00:09:04,380 --> 00:09:05,290
.مهلاً

138
00:09:05,770 --> 00:09:07,790
.سأتّصل بها

139
00:09:07,790 --> 00:09:10,150
.أعتقد أنّه من الأفضل أن تكون فتاة

140
00:09:10,150 --> 00:09:11,770
.معك حقّ

141
00:09:11,770 --> 00:09:17,130
أخبريها أنّ هاروكي قلق بشأنها
.ويريدها أن تتّصل به

142
00:09:17,660 --> 00:09:20,260
...أ-أنا

143
00:09:20,780 --> 00:09:25,660
.في كلّ الأحوال، سأخبرها أنّك قلق بشأنها

144
00:09:26,800 --> 00:09:27,740
.شكرًا

145
00:10:08,390 --> 00:10:09,210
.أخبريني

146
00:10:10,830 --> 00:10:14,960
هل لديكم مريضة باسم ماشيكي-سان؟

147
00:10:14,960 --> 00:10:16,900
.لا أستطيع إخبارك بذلك

148
00:10:17,970 --> 00:10:19,620
.صحيح

149
00:10:21,460 --> 00:10:23,510
.هذا الحساء رائع

150
00:10:25,720 --> 00:10:27,230
هل هي صديقة لك؟

151
00:10:53,220 --> 00:10:54,750
.لقد مرّ أسبوع

152
00:10:55,200 --> 00:10:57,960
.أنا أفكّر في زيارتها في منزلها

153
00:10:57,960 --> 00:11:00,730
.قالت أنّها بخير، لكنّي قلقة

154
00:11:03,200 --> 00:11:04,220
هوندا-كُن؟

155
00:11:05,160 --> 00:11:07,220
...يا ممثّلة القسم، اسمعي

156
00:11:08,950 --> 00:11:11,180
رأيتَ ماشيكي-سان في المستشفى؟

157
00:11:11,960 --> 00:11:14,490
عليّ إخبار هاروكي، صحيح؟

158
00:11:14,490 --> 00:11:18,860
.لكنّنا لا نعرف إن حدث لها شيء ما

159
00:11:18,860 --> 00:11:21,030
...نعم، ولكن

160
00:11:55,620 --> 00:11:56,940
هل ستقابل أحدًا؟

161
00:11:57,820 --> 00:11:59,240
.كلاّ

162
00:12:19,480 --> 00:12:20,840
.مرحبًا

163
00:12:42,960 --> 00:12:43,750
.أهلاً

164
00:12:45,990 --> 00:12:48,240
.يراودني شعور غريب مؤخّرًا

165
00:12:48,820 --> 00:12:51,400
.ليس وكأنّي لستُ على طبيعتي

166
00:12:51,890 --> 00:12:56,680
يصعب وصف الأمر، لكنّي لا أستطيع
.التّركيز في السّباحة

167
00:12:57,590 --> 00:12:59,670
.لا أستطيع الإحساس حتّى بالماء

168
00:13:02,070 --> 00:13:04,270
هل تمر بحالة إحباط؟

169
00:13:04,270 --> 00:13:06,070
.لا أدري

170
00:13:07,700 --> 00:13:09,480
.لقد حدث لي هذا من قبل

171
00:13:09,480 --> 00:13:12,500
.كنتُ مشتّت الانتباه بأشياء أخرى ولم أستطع التّركيز

172
00:13:12,920 --> 00:13:14,270
أشياء أخرى؟

173
00:13:19,570 --> 00:13:21,710
هل تعدني ألاّ تسخر منّي؟

174
00:13:21,710 --> 00:13:23,270
.بالطّبع

175
00:13:29,160 --> 00:13:31,540
.أنا قلق على ماشيكي

176
00:13:31,940 --> 00:13:34,040
.أنا قلق أيضًا

177
00:13:34,040 --> 00:13:39,040
.نعم، لكنّي لا أعتقد أنّ هذا كلّ شيء

178
00:13:40,960 --> 00:13:42,810
.قبل حتّى أن تبدأ بالتّغيّب عن المدرسة

179
00:13:42,810 --> 00:13:44,220
.ربّما منذ فترة طويلة

180
00:13:46,880 --> 00:13:48,900
.لا أستطيع شرح الأمر

181
00:13:49,590 --> 00:13:54,560
لم تتغيّر ماشيكي أبدًا، لكن هنالك
.أمر مختلف بشأنها

182
00:13:57,800 --> 00:13:59,480
.لا يبدو كلامي منطقيًّا

183
00:14:00,040 --> 00:14:02,890
.الأمر ليس سيّان عندما أبوح به

184
00:14:07,200 --> 00:14:09,020
ما خطبي؟

185
00:14:10,920 --> 00:14:13,330
.لقد تقدّمت للأمام

186
00:14:13,330 --> 00:14:14,860
تقدّمت للأمام؟

187
00:14:14,860 --> 00:14:17,900
.إن أعطتني ماشيكي ذلك، لكان مجرّد وشاح

188
00:14:17,900 --> 00:14:21,380
،لكن إن أعطتني إيّاه ممثّلة القسم
.فسيكون أمرًا مختلفًا تمامًا

189
00:14:24,380 --> 00:14:26,460
.إنّه يشبه هذه بالنّسبة لي

190
00:14:29,000 --> 00:14:32,650
.سأتشبّث بها للأبد على الأرجح

191
00:14:33,680 --> 00:14:35,350
.هكذا هو الأمر

192
00:14:35,610 --> 00:14:39,440
.لكنّ وشاحي مختلف

193
00:14:39,440 --> 00:14:40,480
—إنّ ماشيكي

194
00:14:40,480 --> 00:14:42,480
هل أخبرتك بذلك؟

195
00:14:44,540 --> 00:14:47,480
.ربّما يراود ماشيكي نفس الشّعور

196
00:14:47,480 --> 00:14:52,330
،بما أنّك لا تريد قول أيّ شيء
.فقد تعتقد أنّك تراها كصديقة فحسب

197
00:14:52,330 --> 00:14:54,540
—ذلك ليس صحيحًا! أنا

198
00:14:54,540 --> 00:14:55,750
.مهلاً

199
00:14:56,240 --> 00:14:58,620
لماذا تخبرني أنا بذلك؟

200
00:15:01,160 --> 00:15:03,430
ربّما عليك توضيح الأمور

201
00:15:04,050 --> 00:15:06,540
.قبل أن ينتهي بك المطاق تقلق كثيرًا

202
00:15:09,010 --> 00:15:09,850
.نعم

203
00:15:24,820 --> 00:15:27,100
.ستحصلين على نتائجك الأسبوع القادم

204
00:15:27,640 --> 00:15:29,740
هل يمكنني أن أعود للمدرسة؟

205
00:15:29,740 --> 00:15:31,110
.بالطّبع

206
00:15:38,150 --> 00:15:41,910
ما دمنا هنا، ألا تريدين الذّهاب لمكان ما؟

207
00:16:03,910 --> 00:16:05,100
.ميشيما-كُن

208
00:16:15,700 --> 00:16:18,030
.عرفتُ أنّي سأجدك هنا

209
00:16:18,030 --> 00:16:19,620
هل تشعرين بتحسّن؟

210
00:16:19,620 --> 00:16:22,010
.آسفة لجعلك تقلق

211
00:16:22,010 --> 00:16:23,390
.لقد أراحني هذا

212
00:16:23,390 --> 00:16:27,640
.أشعر براحة كبيرة في هذا المكان

213
00:16:27,640 --> 00:16:29,130
في متجر البقالة؟

214
00:16:29,400 --> 00:16:30,230
.نعم

215
00:16:31,460 --> 00:16:33,380
،إنّه ليس مجرّد متجر

216
00:16:34,600 --> 00:16:37,040
.لكن لا يسعني إلاّ أن أشرد بخيالي

217
00:16:37,040 --> 00:16:38,430
تشردين بخيالك؟

218
00:16:38,430 --> 00:16:39,210
.نعم

219
00:16:41,490 --> 00:16:46,730
رغم أنّه مجرّد متجر عاديّ
،لا يملك أيّ شيء يميّزه

220
00:16:46,730 --> 00:16:50,570
.فلا بدّ أنّه شهد قصصًا كثيرة

221
00:16:53,490 --> 00:16:55,830
.هذا ما أتخيّله فحسب

222
00:16:59,300 --> 00:17:03,580
.لكنّه يجعل كلّ شيء يبدو لامعًا

223
00:17:04,180 --> 00:17:08,170
.يبدو كلّ شيء لامعًا للغاية لدرجة إسعادي

224
00:17:09,540 --> 00:17:11,140
ألهذا السّبب تحبّين الكتب؟

225
00:17:12,310 --> 00:17:13,100
.نعم

226
00:17:16,010 --> 00:17:20,700
.ذلك المتجر مكان مميّز لديّ

227
00:17:56,870 --> 00:18:03,350
أتساءل إن كان هذا هو شعور
.الوقوف أمام شخص نحبّه

228
00:18:09,480 --> 00:18:11,850
.أستطيع رؤيته في المتجر فحسب

229
00:18:11,850 --> 00:18:16,220
.لا يعرف أحد بشأن حبيبي السّرّيّ

230
00:18:17,480 --> 00:18:19,160
.حبيبي من المتجر

231
00:18:19,160 --> 00:18:22,970
.أشرد بخيالي لوهلة

232
00:18:22,970 --> 00:18:26,010
...كان ذلك كلّ ما يجب أن يكون، لكن

233
00:18:29,360 --> 00:18:32,630
ربّما أُعاقب

234
00:18:32,970 --> 00:18:36,890
...لاختيارك كحبيب لي، لكن

235
00:18:52,800 --> 00:18:54,340
.كنتُ متفاجئة

236
00:18:54,770 --> 00:18:59,030
،في العادة يظلّ ما أتخيّله خيالاً

237
00:18:59,670 --> 00:19:02,220
.لكن أحيانًا أخرى لا

238
00:19:04,020 --> 00:19:08,680
.كنتُ متوتّرة كثيرًا حينها

239
00:19:11,820 --> 00:19:13,080
...أنت

240
00:19:15,540 --> 00:19:18,170
.قفزت خارج خيالي

241
00:19:19,890 --> 00:19:23,420
.وكأنّك حبيبي الحقيقيّ

242
00:19:26,840 --> 00:19:28,410
هذا غريب، صحيح؟

243
00:19:30,180 --> 00:19:31,520
.ليس غريبًا

244
00:19:44,850 --> 00:19:46,700
هل علينا العودة؟

245
00:19:54,030 --> 00:19:54,670
!ماشيكي

246
00:19:57,530 --> 00:20:00,490
هل يمكننا البقاء لوقت أطول؟

247
00:20:00,490 --> 00:20:01,290
.أكيد

248
00:20:01,780 --> 00:20:03,240
.اسمعي

249
00:20:03,240 --> 00:20:04,030
نعم؟

250
00:20:04,920 --> 00:20:07,750
...في الحقيقة

251
00:20:09,510 --> 00:20:10,430
...أنا

252
00:20:20,550 --> 00:20:21,690
!انظر

253
00:20:27,160 --> 00:20:29,900
.هذا المكان رائع

254
00:20:31,320 --> 00:20:32,310
.هذا المكان

255
00:20:32,840 --> 00:20:33,710
.نعم

256
00:20:35,160 --> 00:20:37,260
...ما-ماشيكي

257
00:20:38,150 --> 00:20:39,060
.نعم

258
00:20:40,320 --> 00:20:40,970
—أنا

259
00:20:40,970 --> 00:20:41,910
.مهلاً

260
00:20:44,500 --> 00:20:45,590
.أرجوك

261
00:20:46,410 --> 00:20:47,750
.استمعي لي

262
00:20:50,040 --> 00:20:56,060
كان من الصّعب عليّ جدًّا ألاّ أتمكّن
.من رؤيتك لبضعة أيّام

263
00:20:57,270 --> 00:20:59,660
.أفكّر فيك دون أن أدرك ذلك

264
00:20:59,660 --> 00:21:01,160
.تخطرين على بالي فجأة

265
00:21:02,800 --> 00:21:03,820
.أنت

266
00:21:05,220 --> 00:21:06,360
.لم أعرف لماذا

267
00:21:06,800 --> 00:21:11,020
.لم أفهم، لذلك فكّرت في الأمر مرارًا

268
00:21:11,880 --> 00:21:14,300
.وحينها عثرت على الإجابة

269
00:21:15,970 --> 00:21:17,380
.لقد فهمت

270
00:21:36,820 --> 00:21:38,890
—ماشيكي، أنا

271
00:21:54,320 --> 00:21:55,340
ماشيكي؟

272
00:22:00,400 --> 00:22:01,530
!ماشيكي

273
00:23:40,140 --> 00:24:10,130
الحلقة القادمة

274
00:23:41,360 --> 00:23:44,940
.فبراير، عندما يداعب الصّفاء البشرة

275
00:23:44,940 --> 00:23:47,150
.دفء ذلك اليوم المليء بالحنين

276
00:23:47,150 --> 00:23:48,650
.السّحب في السّماء

277
00:23:48,650 --> 00:23:49,960
.غروب الشّمس الأحمر

278
00:23:49,960 --> 00:23:51,400
.أربطة الشّعر المتمايلة

279
00:23:51,400 --> 00:23:53,960
.تمّ الإمساك بكتاب الصّور بكلتا اليدين

280
00:23:54,410 --> 00:23:58,160
أجزاء الذّاكرة هذه لتلك الفتاة الصّغيرة

281
00:23:58,160 --> 00:24:01,190
.أمست بعيدة الآن

282
00:24:02,050 --> 00:24:05,840
."في الحلقة القادمة من "كونبيني كاريشي
."الحلقة الحادية عشر: "فبراير

283
00:24:06,390 --> 00:24:10,130
.ها هنا كُتبت الحروف الأولى لقصّتهما