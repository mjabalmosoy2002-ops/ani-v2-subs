1
00:00:12,880 --> 00:00:16,200
هـ-هل قرّرتم ماذا ستشربون؟

2
00:00:21,250 --> 00:00:23,320
.لا تتصرّف بكآبة هكذا

3
00:00:23,320 --> 00:00:24,990
.لستُ مكتئبًا

4
00:00:24,990 --> 00:00:26,540
.تسهل قراءتك كالكتاب المفتوح

5
00:00:26,840 --> 00:00:27,610
!هذا مؤلم

6
00:00:27,610 --> 00:00:29,540
هل تُنفّس عن إحباطك فيّ؟

7
00:00:31,240 --> 00:00:33,100
ماشيكي ليست هنا، صحيح؟

8
00:00:33,100 --> 00:00:33,940
.نعم

9
00:00:34,680 --> 00:00:37,600
.هذا لسوء حظّك. إنّه يوم المهرجان

10
00:00:37,600 --> 00:00:38,680
هل أصيبت بزكام أو ما شابه؟

11
00:00:39,030 --> 00:00:40,150
زكام؟

12
00:00:43,960 --> 00:00:46,440
...أيعقل يا ماشيكي

13
00:00:47,640 --> 00:00:49,670
يا ماشيكي؟

14
00:00:50,740 --> 00:00:51,280
—هل من

15
00:00:51,280 --> 00:00:52,390
.أنا آسفة

16
00:01:00,990 --> 00:01:02,750
.لا بدّ أنّي أفسدت الأمر هذه المرّة

17
00:01:02,750 --> 00:01:03,950
!أفسدته...؟

18
00:01:03,950 --> 00:01:06,410
تقصد مع ماشيكي؟

19
00:01:07,460 --> 00:01:09,360
.لم تخبرني بذلك

20
00:01:09,360 --> 00:01:12,000
،أفهم شعورك بصفتي رجلاً أيضًا

21
00:01:12,000 --> 00:01:14,010
لكن ليس من المفترض بك
.أن تفعل ذلك دون موافقة

22
00:01:14,010 --> 00:01:15,340
ما-ماذا؟

23
00:01:17,890 --> 00:01:20,720
كلاّ أيّها الغبيّ! ما الّذي كنت تفكّر به؟

24
00:01:21,780 --> 00:01:23,280
ما الّذي فعلته إذًا؟

25
00:01:23,280 --> 00:01:26,750
.أظنّ أنّها تتجنّبني

26
00:01:26,750 --> 00:01:28,060
لأنك اعترفت بمشاعرك لها؟

27
00:01:28,060 --> 00:01:31,150
.لم... أخبرها

28
00:01:33,780 --> 00:01:34,570
!هذا مؤلم

29
00:01:34,570 --> 00:01:36,060
.هذا يكفي

30
00:01:37,030 --> 00:01:39,020
.أنتما مليئان بالحيويّة دائمًا

31
00:01:39,020 --> 00:01:40,300
.آسفان

32
00:01:42,080 --> 00:01:44,030
.لا ضرر من كون المرء مليئًا بالحيويّة

33
00:01:44,030 --> 00:01:46,120
.لقد ساعدتمانا كثيرًا

34
00:01:46,530 --> 00:01:47,660
.نقدّر لكما ذلك

35
00:01:47,660 --> 00:01:50,350
.جيّد يا سينباي. عرفت أنّك ستفهم الأمر

36
00:01:50,350 --> 00:01:52,600
.اسمع، لا تدع هذا يدفعك للغرور

37
00:01:52,600 --> 00:01:53,720
.لحظة

38
00:01:57,010 --> 00:01:58,010
أهو وقت مناوبتك؟

39
00:01:58,010 --> 00:02:00,920
.نعم. هنالك من سيقوم بذلك بدلاً منّي

40
00:02:00,920 --> 00:02:04,100
.لا بأس. حان وقت مناوبتي أيضًا

41
00:02:06,160 --> 00:02:07,780
.نستأذن

42
00:02:16,780 --> 00:02:20,280
أنا أغار من كلّ شيء يمرّ به تلاميذ
.السّنة الأولى هؤلاء

43
00:02:20,710 --> 00:02:22,460
.يكاد هذا يثلج الصّدر

44
00:02:23,380 --> 00:02:25,600
.لا أظنّ ذلك

45
00:02:25,600 --> 00:02:26,540
ماذا؟

46
00:02:28,100 --> 00:02:33,910
.لا تبلغ مشاعر النّاس غايتها أبدًا في بعض الأحيان

47
00:02:42,600 --> 00:02:44,410
.أخي

48
00:02:45,680 --> 00:02:47,120
.أسرع

49
00:02:47,120 --> 00:02:48,180
.سوف تتعثّرين

50
00:02:51,810 --> 00:02:53,080
ما الّذي قلته لك للتّوّ؟

51
00:02:53,080 --> 00:02:54,590
.آسفة

52
00:02:54,590 --> 00:02:57,950
،بمجرّد أن تدخلي الثّانويّة
.سيكون عليك الاعتماد على نفسك

53
00:02:57,950 --> 00:02:59,110
.حاضرة

54
00:03:00,690 --> 00:03:03,120
سوف نرتاد نفس الثّانويّة ابتداءً
.من هذا الرّبيع

55
00:03:03,120 --> 00:03:04,120
.نعم

56
00:03:11,000 --> 00:03:11,980
ما الأمر؟

57
00:03:11,980 --> 00:03:13,750
.إنّه مجمّد

58
00:03:13,750 --> 00:03:15,380
هل يمكننا عبوره؟

59
00:03:15,380 --> 00:03:16,840
.إنّه خطير

60
00:03:16,840 --> 00:03:19,900
.يبدو أنّ هنالك قصّة عن ماضي هذا الجسر

61
00:03:23,010 --> 00:03:24,460
.يا إلهي

62
00:03:24,460 --> 00:03:26,960
.هنالك إشاعة غريبة تحيط به

63
00:03:26,960 --> 00:03:30,840
."إنه يسمّى في مدرستي بـ"جسر الأحبّة

64
00:03:31,520 --> 00:03:33,740
جسر الأحبّة"؟"

65
00:03:34,200 --> 00:03:35,930
.لقد أعجبني الاسم

66
00:03:36,770 --> 00:03:38,220
أتظنّين ذلك؟

67
00:05:31,250 --> 00:05:33,140
انتخابات مجلس التّلاميذ إذًا؟

68
00:05:33,720 --> 00:05:36,390
.حسنًا، الأمر لا يهمّني من الأساس

69
00:05:37,040 --> 00:05:41,400
مشاهدة ناكاجيما-سينباي تجعل كون
.المرء في مجلس التّلاميذ أمرًا متعبًا

70
00:05:41,400 --> 00:05:43,450
.لن أقوم بذلك حتّى ولو طلبوه منّي

71
00:05:43,900 --> 00:05:48,420
.في الحقيقة، لا يمكنني قول "لا" للآخرين أبدًا

72
00:05:49,860 --> 00:05:52,910
...أنت! هل تستمع لي

73
00:06:21,730 --> 00:06:23,050
هل حصل الجميع على واحدة؟

74
00:06:23,050 --> 00:06:24,690
من لم يحصل على واحدة؟

75
00:06:29,560 --> 00:06:32,660
عفوًا، هل يملك أحدكم أيّة أسئلة؟

76
00:06:51,990 --> 00:06:52,930
.تفضّلوا

77
00:06:53,440 --> 00:06:55,430
.عذرًا على الإزعاج

78
00:06:55,720 --> 00:06:58,380
.يا لها من فوضى

79
00:06:58,380 --> 00:07:01,690
.يحدث هذا دائمًا عندما تكون مشغولاً

80
00:07:02,440 --> 00:07:04,800
هل تصغي إليّ يا أخي؟

81
00:07:04,800 --> 00:07:06,360
.يمكنك تركها هناك

82
00:07:06,360 --> 00:07:09,240
.لن أكون قادرًا على العثور عليها لاحقًا

83
00:07:09,240 --> 00:07:12,280
هل يمكنك العثور على أيّ شيء الآن؟

84
00:07:12,280 --> 00:07:13,580
.أنت غريب للغاية

85
00:07:13,580 --> 00:07:16,000
.آسف لأنّي غريب. لا تلمسي شيئًا

86
00:07:16,000 --> 00:07:21,310
.حسنًا. ساكوراكوجي-سينباي مذهل

87
00:07:21,310 --> 00:07:24,430
.لا أصدّق أنّ بإمكانه تحمّل التّواجد قربك

88
00:07:24,430 --> 00:07:27,210
.نعم، لا يمكنني فعل شيء من دونه

89
00:07:27,210 --> 00:07:28,720
.أنا جادّة

90
00:07:28,720 --> 00:07:32,470
.عليك أن تشكرني وساكوراكوجي-سينباي

91
00:07:33,560 --> 00:07:34,940
.ليس أنت يا واكا

92
00:07:34,940 --> 00:07:36,700
.هذا لئيم

93
00:07:42,600 --> 00:07:46,520
هل أنت مشغول في التّحضير للانتخابات؟

94
00:07:46,980 --> 00:07:48,610
.نوعًا ما

95
00:07:48,610 --> 00:07:52,190
يأخذ التّحضير لخليفتي الكثير من وقتي
.أكثر من الانتخابات بحدّ ذاتها

96
00:07:52,190 --> 00:07:55,620
عليّ أن أحرص أنّ الرّئيس التّالي
.ليس لديه أيّ مشاكل

97
00:07:55,620 --> 00:07:57,990
أنت الرّئيس الأفضل، صحيح؟

98
00:07:59,200 --> 00:08:01,110
.أنت مذهل حقًّا

99
00:08:01,570 --> 00:08:03,620
.أنا فخورة بك يا أخي

100
00:08:04,920 --> 00:08:07,380
أخي" إذًا؟"

101
00:08:09,480 --> 00:08:14,050
.مرحبًا. شكرًا على مساعدتك

102
00:08:14,050 --> 00:08:15,830
.لا بأس

103
00:08:18,010 --> 00:08:20,600
هل أنت هنا لمقابلة ميكادو؟
هل عليّ المغادرة؟

104
00:08:20,600 --> 00:08:25,510
كلاّ، ظننتُ فقط أنّ بإمكاننا العودة للمنزل
.معًا إن كان سينتهي قريبًا

105
00:08:26,020 --> 00:08:28,190
.آسف. لن أنتهي في وقت قريب

106
00:08:28,190 --> 00:08:31,280
.فهمت. أردت أن أطلب منك شيئًا أيضًا

107
00:08:31,720 --> 00:08:34,780
.حسنًا. سأتّصل بك عندما أعود للمنزل

108
00:08:34,780 --> 00:08:37,320
.جيّد. أراك لاحقًا إذًا

109
00:08:41,160 --> 00:08:44,220
.إلى اللّقاء يا ساكوراكوجي-سينباي

110
00:08:49,170 --> 00:08:51,080
.مع السّلامة

111
00:08:55,510 --> 00:08:57,410
.إنها فتاة لطيفة

112
00:08:57,410 --> 00:08:58,750
.معك حقّ

113
00:08:58,750 --> 00:09:01,910
.يبدو أنّ تلاميذ قسمها يحبّونها ويبجّلونها

114
00:09:02,530 --> 00:09:04,910
.أتساءل ما شعور ذلك

115
00:09:04,910 --> 00:09:06,440
.لا بدّ أنّ ذلك يشكّل ضغطًا عليها

116
00:09:06,760 --> 00:09:11,440
.ربّما. على الأرجح أنّها ممتنّة لوجودك معها

117
00:09:12,840 --> 00:09:14,190
.أتمنّى ذلك

118
00:09:39,080 --> 00:09:41,470
ألم تنسَ شيئًا؟

119
00:11:00,530 --> 00:11:02,930
.أنا فخورة بك يا أخي

120
00:11:10,810 --> 00:11:14,190
.يبدو وكأنّهما قد عادا للرّبيع ثانية

121
00:11:15,370 --> 00:11:16,940
.أقصد ماشيكي-سان وصديقك

122
00:11:16,940 --> 00:11:18,300
.نعم

123
00:11:19,570 --> 00:11:21,100
ألم يتغيّر شيء؟

124
00:11:21,100 --> 00:11:24,980
كلاّ. هل قالت ماشيكي أيّ شيء لك؟

125
00:11:27,170 --> 00:11:33,890
فهمت. تعتقدين أنّها غلطتي لتدخّلي
في المسألة هكذا؟

126
00:11:33,890 --> 00:11:37,590
.إنّها الوحيدة الّتي تعرف الحقيقة

127
00:11:38,290 --> 00:11:41,720
.يا ممثّلة القسم، بدا ذلك رائعًا نوعًا ما

128
00:11:41,720 --> 00:11:43,220
.كن جادًّا

129
00:11:43,220 --> 00:11:48,030
حسنًا. لكن ألا تريدين للأمر أن ينجح؟

130
00:11:48,030 --> 00:11:49,720
.وإن عنى ذلك أن نتدخّل في شؤونهما

131
00:11:49,720 --> 00:11:53,510
.لا أتدخّل في شؤونهما، فأنا يراودني نفس الشّعور

132
00:11:54,470 --> 00:11:56,320
.لذلك ابتهج

133
00:11:56,320 --> 00:11:58,480
.لنكمل هذه

134
00:11:59,030 --> 00:12:01,490
.قد أبتهج إن خرجت في موعد معي

135
00:12:03,520 --> 00:12:04,650
.لا تغترّ بنفسك

136
00:12:04,650 --> 00:12:05,940
.كان ذلك وشيكًا

137
00:12:25,860 --> 00:12:27,240
هل طلب منك ميكادو المجيء؟

138
00:12:27,240 --> 00:12:28,510
.كلاّ

139
00:12:28,510 --> 00:12:30,380
.لقد أغلقت الغرفة

140
00:12:30,380 --> 00:12:34,560
عفوًا، كنت أتساءل فحسب إن كان
.بمقدوري المساعدة في شيء ما

141
00:12:34,560 --> 00:12:39,020
حسنًا، أكثر ما يمكنك فعله لمساعدة ميكادو

142
00:12:39,020 --> 00:12:41,530
.هو أن ترشّح نفسك للانتخابات

143
00:12:41,530 --> 00:12:44,270
.أنا؟ لا أستطيع

144
00:12:44,270 --> 00:12:46,960
.كيساكي هي المرشّحة الأنسب في فصلي

145
00:12:46,960 --> 00:12:48,160
كيساكي؟

146
00:12:48,740 --> 00:12:52,140
إنّها في فصلك إذًا؟

147
00:12:52,140 --> 00:12:54,280
،لا أعرف كيف تشعر حيال الأمر

148
00:12:54,280 --> 00:12:57,300
لكنّ مسؤولي الانتخابات يحاولون
.جاهدين إقناعها

149
00:12:58,040 --> 00:13:00,390
.وهنالك ناكاجيما-سينباي

150
00:13:01,220 --> 00:13:03,190
...كلاهما

151
00:13:03,190 --> 00:13:07,220
حسنًا، إنّهما... معًا، صحيح؟

152
00:13:11,830 --> 00:13:12,860
هل يبدو الأمر هكذا لك؟

153
00:13:13,670 --> 00:13:15,060
.نعم

154
00:13:15,060 --> 00:13:16,920
.هو كذلك بالطّبع

155
00:13:17,460 --> 00:13:19,060
.معك حقّ

156
00:13:22,070 --> 00:13:23,900
!أرجوك، أتوسّل إليك

157
00:13:24,630 --> 00:13:26,120
.آسفة

158
00:13:26,120 --> 00:13:28,880
.كيساكي-سان، أنت المرشّحة المثلى

159
00:13:28,880 --> 00:13:31,450
أولست مقرّبة من ناكاجيما-سينباي؟

160
00:13:31,450 --> 00:13:36,670
أنا خجولة. ما كنت لأستطيع
.ترشيح نفسي للانتخابات

161
00:13:36,670 --> 00:13:39,450
.فعلاً؟ هذا مؤسف

162
00:13:39,450 --> 00:13:42,920
.حسنًا، لا يمكنني إجبارك على ذلك

163
00:13:42,920 --> 00:13:44,110
.آسفة

164
00:13:44,110 --> 00:13:46,300
.كلاّ، أنا هي الآسفة

165
00:13:46,300 --> 00:13:48,700
.توقّعتُ فقط أنّه إن رُشّحتِ

166
00:13:48,700 --> 00:13:51,290
فسيستطيع ناكاجيما-سينباي ترك
.المدرسة وهو مطمئنّ

167
00:13:51,290 --> 00:13:53,100
.كما لن يتسنّى لكما رؤية بعضكما بعد الآن

168
00:14:04,820 --> 00:14:06,320
!أخي

169
00:14:43,910 --> 00:14:46,720
،لا أدري من أخبرك

170
00:14:46,720 --> 00:14:49,040
.لكن كان عليّ إخبارهم ألاّ يقولوا لك

171
00:14:49,040 --> 00:14:50,230
لماذا؟

172
00:14:50,950 --> 00:14:53,020
لماذا لم تقل شيئًا؟

173
00:14:53,020 --> 00:14:54,820
.هذا أمر مهمّ

174
00:14:55,780 --> 00:14:56,830
.آسف

175
00:14:56,830 --> 00:14:59,210
.لا أطلب منك أن تعتذر

176
00:14:59,210 --> 00:15:00,840
...هوكّايدو

177
00:15:01,670 --> 00:15:04,210
هل ستنتقل يا أخي؟

178
00:15:04,960 --> 00:15:07,550
.لطالما عزمتُ على ذلك

179
00:15:08,520 --> 00:15:11,300
لا يمكنك العيش في طوكيو؟ مهما كان؟

180
00:15:11,610 --> 00:15:13,280
.لن نكون قادرين على رؤية بعضنا

181
00:15:13,280 --> 00:15:15,150
.لن أكون قادرة على زيارتك في منزلك

182
00:15:15,150 --> 00:15:16,750
لن نكون قادرين على الحديث عمّا يقلقنا

183
00:15:16,750 --> 00:15:19,930
.أو شراء وجبات خفيفة وأكلها معًا بعد الآن

184
00:15:20,660 --> 00:15:22,220
.لا أدري ذلك

185
00:15:23,120 --> 00:15:24,980
.ابق معي

186
00:15:29,300 --> 00:15:31,130
.أتمنّى لو أمكنني ذلك أيضًا

187
00:15:32,360 --> 00:15:34,010
.لقد راقبتك طوال هذا الوقت

188
00:15:34,010 --> 00:15:36,060
.وقفت إلى جانبك وحميتك

189
00:15:36,060 --> 00:15:37,860
.لكنّك لا تفهمين

190
00:15:38,750 --> 00:15:39,610
أخي؟

191
00:15:39,610 --> 00:15:40,330
!لست كذلك

192
00:15:40,830 --> 00:15:43,060
.أنا لستُ أخاك

193
00:15:43,060 --> 00:15:46,270
!ما عدتُ أستطيع رؤيتك كذلك
...فلطالما كنت

194
00:16:00,720 --> 00:16:01,900
.أنا أحبّك

195
00:16:51,400 --> 00:16:52,900
هل أنت بخير؟

196
00:16:54,200 --> 00:16:58,160
.نعم. لم أنم بما يكفي فحسب

197
00:16:58,160 --> 00:16:59,610
لم تنم بما يكفي؟

198
00:16:59,610 --> 00:17:01,400
أليس لديك تدريب؟

199
00:17:01,400 --> 00:17:04,200
.شكرًا لك. يمكنك الذّهاب الآن

200
00:17:04,910 --> 00:17:06,430
.أنا قلق عليك

201
00:17:06,430 --> 00:17:09,830
،لا أدري إن كنتُ أساعد بهذا
.لكنّي سأبذل جهدي

202
00:17:12,160 --> 00:17:16,550
أنا واثق أنّ الأمور ستنجح
.إن كنتُ صريحًا مثلك

203
00:17:18,000 --> 00:17:20,810
هل سمعت عن ذلك الجسر؟

204
00:17:20,810 --> 00:17:22,170
سمعت ماذا؟

205
00:17:22,170 --> 00:17:26,060
،عندما كنتُ في السّنة الأولى
.كانت هنالك إشاعة حوله

206
00:17:26,680 --> 00:17:29,450
،إن عبر فتى وفتاة الجسر معًا خلال الغسق

207
00:17:29,450 --> 00:17:31,540
.فسيكونان معًا للأبد

208
00:17:32,440 --> 00:17:34,910
،كانت مجرّد إشاعة

209
00:17:34,910 --> 00:17:40,140
،لكن إن كنت صريحًا مثلك
.لكان الإله قد ابتسم في وجهي

210
00:17:40,740 --> 00:17:43,880
أنت لا تصدّق تلك الإشاعة؟

211
00:17:44,860 --> 00:17:48,330
.تخلّى عنّى الإله منذ مدّة

212
00:18:01,840 --> 00:18:03,100
.كيساكي

213
00:18:04,210 --> 00:18:05,960
.ميشيما-كُن

214
00:18:09,560 --> 00:18:10,780
.شكرًا على الطّعام

215
00:18:10,780 --> 00:18:13,110
هل أنت واثقة بالفعل؟

216
00:18:13,110 --> 00:18:15,520
.لا داعي لتتردّد. تفضّل

217
00:18:15,520 --> 00:18:16,610
.شكرًا

218
00:18:23,510 --> 00:18:27,250
.عذرًا، آسف لأنّي اعترضت الطّريق

219
00:18:27,250 --> 00:18:28,190
اعترضتَ الطّريق؟

220
00:18:28,190 --> 00:18:29,320
...قصدت

221
00:18:30,020 --> 00:18:31,760
.أنت لست في طريقي

222
00:18:31,760 --> 00:18:33,880
أنت تساعدني، صحيح؟

223
00:18:35,130 --> 00:18:36,780
.نعم. أحيانًا

224
00:18:37,360 --> 00:18:41,140
.أنا واثقة أنّه يقدّر لك ذلك. إنّه مشغول الآن

225
00:18:41,140 --> 00:18:43,160
.نعم، بالفعل

226
00:18:43,160 --> 00:18:45,640
تقصدين بسبب الانتخابات وامتحانات القبول؟

227
00:18:45,640 --> 00:18:47,050
.لستُ واثقة

228
00:18:48,070 --> 00:18:51,830
.لا يخبرني الكثير عن تلك الأمور

229
00:18:55,470 --> 00:18:57,590
.إنّه مثاليّ دائمًا

230
00:18:58,230 --> 00:19:00,730
.يبدو أحيانًا كشخص يخفي مشاعره

231
00:19:01,510 --> 00:19:05,400
إن أطلقها يومًا ما، فقد تكون شيئًا
.كبيرًا للغاية قد يخلّ توازنه

232
00:19:07,350 --> 00:19:08,570
.أنا آسف

233
00:19:08,570 --> 00:19:11,480
.أنا واثق أنّك تعرفين أكثر منّي عن ذلك

234
00:19:47,640 --> 00:19:48,490
.مرحبًا

235
00:19:49,280 --> 00:19:50,490
.صباح الخير

236
00:19:50,490 --> 00:19:53,100
.تسير ببطء اليوم أيّها الرّئيس

237
00:19:53,100 --> 00:19:56,500
.أفعل ذلك أحيانًا. لا يجب أن أسمح لنفسي بالانهيار

238
00:19:56,790 --> 00:19:58,200
.معك حقّ بالكامل

239
00:20:04,510 --> 00:20:06,940
!صوّتوا من أجلي

240
00:20:07,350 --> 00:20:08,560
!شكرًا لكم

241
00:20:08,560 --> 00:20:10,270
.لقد بدؤوا حملاتهم الانتخابيّة

242
00:20:11,040 --> 00:20:12,040
.ميكادو

243
00:20:20,630 --> 00:20:23,280
.هذا تطوّر مفاجئ

244
00:20:34,040 --> 00:20:40,550
.خطابات انتخابات القسم 1-1 ستبدأ الآن

245
00:20:40,860 --> 00:20:45,300
.أنا المرشّحة لمنصب نائبة الرّئيس كيساكي واكا

246
00:20:45,970 --> 00:20:48,090
.تفعل هذا من أجلك

247
00:20:50,040 --> 00:20:53,550
أنوي أن أواصل حمل إرادة الرّئيس الحاليّ

248
00:20:53,550 --> 00:20:56,650
ودعم رئيس مجلس التّلاميذ الجديد

249
00:20:56,650 --> 00:21:00,380
...بينما أقود تلاميذ المستقبل لمستويات أسمى

250
00:20:57,110 --> 00:20:59,630
.سينباي، لقد تفاجأت

251
00:20:59,630 --> 00:21:01,900
.تمّ إعلامنا فجأة في رسالة إلكترونيّة ليلة البارحة

252
00:21:02,440 --> 00:21:04,490
.أتمنّى أن تصوّتا لها

253
00:21:15,880 --> 00:21:18,760
!يا ميشيما! كفاك تكاسلاً

254
00:21:19,420 --> 00:21:21,020
.المعذرة

255
00:21:37,060 --> 00:21:38,710
.صوّتا لكيساكي

256
00:21:52,390 --> 00:21:53,260
.المعذرة

257
00:21:56,260 --> 00:21:57,340
.صباح الخير

258
00:21:59,750 --> 00:22:01,040
.صباح الخير

259
00:23:40,060 --> 00:24:10,050
الحلقة القادمة

260
00:23:41,400 --> 00:23:44,320
نوفمبر، عندما تغطّي أوراق الجنكة

261
00:23:44,320 --> 00:23:46,940
.الأرض كأنّها بساط من ألوان الشّمس

262
00:23:47,320 --> 00:23:50,320
.تقترب خطى الشّتاء الخافتة

263
00:23:50,320 --> 00:23:52,740
.وبينما يقتربان إلى بعضهما، يبتعد قلباهما

264
00:23:52,740 --> 00:23:55,530
.رسالات من كلمة واحدة تعبر بينهما

265
00:23:55,530 --> 00:23:57,240
.يريد رؤيتها، لكن لا يستطيع

266
00:23:57,240 --> 00:23:59,330
.لقد آذاها. قلبه يتألّم

267
00:23:59,330 --> 00:24:01,610
.لا يستطيع حتّى طلب السّماح

268
00:24:02,280 --> 00:24:05,910
."في الحلقة القادمة من "كونبيني كاريشي
."الحلقة الخامسة: "نوفمبر

269
00:24:06,420 --> 00:24:10,050
.ها هنا كُتبت الحروف الأولى لقصّتهما