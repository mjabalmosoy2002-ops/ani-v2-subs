3
00:04:20,630 --> 00:04:23,710
!حلّ الصّباح! تعال لتفطر

4
00:04:23,710 --> 00:04:25,800
.صباح الخير

5
00:04:28,320 --> 00:04:31,340
!توا هنا ثانية

6
00:04:37,460 --> 00:04:40,020
.سوف نغادر

7
00:04:41,230 --> 00:04:43,670
.عنقي يؤلمني

8
00:04:43,670 --> 00:04:45,550
.هذا لأنّك نمت على الأرض

9
00:04:45,550 --> 00:04:48,510
هل ستسمح لي بالنّوم على سريرك إذًا؟

10
00:04:48,510 --> 00:04:49,820
هل أنت غبيّ؟

11
00:04:49,820 --> 00:04:51,190
.يا لبخلك

12
00:05:04,230 --> 00:05:06,320
.ستلعب البرازيل اليوم

13
00:05:06,600 --> 00:05:08,560
.من الأفضل أن أحجز موعدًا مع أكيرا

14
00:05:08,560 --> 00:05:09,580
ستشاهد المباراة في منزلي؟

15
00:05:09,580 --> 00:05:12,320
كما أنّ الدّوريّ الأوروبّيّ سيُبثّ
.على "سي إس" في منتصف اللّيل

16
00:05:12,320 --> 00:05:13,850
ستبيت معي ثانية؟

17
00:05:13,850 --> 00:05:16,120
.احرص على إخبار والدتك

18
00:05:16,120 --> 00:05:17,000
.سأخبرها

19
00:05:31,170 --> 00:05:34,100
.هنالك الكثير من التّلاميذ في يوم الأحد هذا

20
00:05:34,450 --> 00:05:36,390
...صحيح، فاليوم

21
00:05:45,170 --> 00:05:46,490
.رائع

22
00:05:46,490 --> 00:05:50,870
تبذل نوادي الثّانويّة جهدًا كبيرًا
.بالفعل لضمّ أعضاء جدد

23
00:05:51,490 --> 00:05:53,490
.وكأنّنا في مهرجان. يبدو هذا ممتعًا

24
00:05:53,490 --> 00:05:54,750
هل ستنضمّ لنادي كرة القدم؟

25
00:05:54,750 --> 00:05:56,280
.سأذهب إلى المسبح

26
00:05:56,280 --> 00:05:58,250
.على رسلك

27
00:05:58,250 --> 00:06:00,360
.أنت لستَ ممتعًا

28
00:06:00,360 --> 00:06:01,220
ماذا؟

29
00:06:05,090 --> 00:06:06,720
.أيّها الفتيان

30
00:06:06,720 --> 00:06:09,590
ما رأيكما بالانضمام لنادي الحرف؟

31
00:06:09,590 --> 00:06:11,280
نادي الحرف؟

32
00:06:11,280 --> 00:06:13,470
.لا... لا أظنّه مناسبًا لي

33
00:06:13,470 --> 00:06:16,730
.ستكونان بخير. لا تخافا

34
00:06:16,730 --> 00:06:20,060
.هنالك رجلان قادمان

35
00:06:20,060 --> 00:06:20,780
.مهلاً

36
00:06:20,780 --> 00:06:22,270
.يا فتاة الحرف

37
00:06:23,150 --> 00:06:25,520
.ساكوراكوجي-سينباي

38
00:06:25,520 --> 00:06:28,390
تصرّفات الضّمّ المخادِعة ستجعل
.ناديك يدفع غرامة

39
00:06:28,390 --> 00:06:29,490
.إليك بطاقة صفراء

40
00:06:32,370 --> 00:06:33,490
مساعِد

41
00:06:33,490 --> 00:06:35,040
.انتبها

42
00:06:35,040 --> 00:06:36,960
،إن لم تتمالكا نفسيكما أيّها الفتيان الجديدان

43
00:06:36,960 --> 00:06:40,500
.فسينتهي بكما المطاف منضمّين لثلاثة أو أربعة نوادٍ

44
00:06:40,900 --> 00:06:42,060
.حسنًا

45
00:06:42,470 --> 00:06:44,880
.لا تخفهما

46
00:06:44,880 --> 00:06:46,090
.ميكادو

47
00:06:46,090 --> 00:06:47,630
هل أنتما مهتمّان بنوادي الفنون الحرّة؟

48
00:06:47,630 --> 00:06:51,390
إن لم تكونا، فعليكما زيارة ملاعب
.المدرسة أو صالاتها الرّياضيّة

49
00:06:51,690 --> 00:06:55,050
.ثمّة نوادٍ كثيرة عدائيّة، لذلك احذرا

50
00:06:53,010 --> 00:06:54,010
رئيس مجلس التّلاميذ

51
00:07:01,200 --> 00:07:02,600
.إنّهما مجنونان

52
00:07:02,600 --> 00:07:04,640
.أتمنّى ألاّ أحوز على اهتمامهما

53
00:07:04,640 --> 00:07:06,570
.ستكون بخير

54
00:07:06,570 --> 00:07:08,680
.على أيّ حال، سأذهب إلى المسبح

55
00:07:08,680 --> 00:07:11,070
.كان نادي الحرف مخيفًا أكثر

56
00:07:11,070 --> 00:07:12,360
.نعم

57
00:07:15,660 --> 00:07:22,830
نادي الحرف  مرحبًا في

58
00:07:17,560 --> 00:07:19,050
توا، ستنضمّ لفريق كرة القدم، صحيح؟

59
00:07:19,050 --> 00:07:19,820
.نعم

60
00:07:19,820 --> 00:07:21,680
.أظنّ أنّنا سنفترق إذًا

61
00:07:21,680 --> 00:07:23,950
.لنتقابل في متجر البقالة في طريق العودة

62
00:07:23,950 --> 00:07:26,420
فعلاً؟ سنذهب للمنزل معًا؟

63
00:07:29,250 --> 00:07:30,340
.مرحبًا

64
00:07:34,930 --> 00:07:41,940
سأعلمك عندما أنتهي

65
00:07:34,930 --> 00:07:41,940
!لقد أكملتُ تسجيلي

66
00:07:34,930 --> 00:07:41,940
لم أنتهِ بعد. هنالك الكثير من
...الأشخاص في نادي كرة القدم

67
00:08:47,510 --> 00:08:49,130
.أنا آسفة

68
00:08:53,630 --> 00:08:56,650
هل أنت بخير؟ هل تأذّيت؟

69
00:08:56,650 --> 00:08:58,650
.لا، أنا بخير

70
00:08:58,650 --> 00:09:00,430
.أنا آسف

71
00:09:00,430 --> 00:09:02,460
.كلاّ، أنا لم أكن منتبهة

72
00:09:02,460 --> 00:09:03,140
.أنا آسفة

73
00:09:04,160 --> 00:09:05,450
...تنّورتك

74
00:09:05,450 --> 00:09:07,070
.سأحضر شيئًا لمسحها به

75
00:09:07,070 --> 00:09:08,260
.انتظري هنا رجاءً

76
00:09:29,750 --> 00:09:31,670
.شكرًا لك

77
00:09:42,430 --> 00:09:44,270
.نحن آسفان

78
00:09:44,270 --> 00:09:45,710
.لا داعي لذلك

79
00:09:45,710 --> 00:09:47,850
.لم أكن أنظر إلى أين أنا ذاهبة

80
00:09:48,370 --> 00:09:51,030
.عليّ الذّهاب

81
00:09:51,490 --> 00:09:53,580
.شكرًا لك

82
00:09:53,580 --> 00:09:54,730
.لا بأس

83
00:09:56,660 --> 00:09:59,700
هل يمكنك منحنا بيانات الاتّصال بك؟

84
00:10:06,400 --> 00:10:10,490
.معذرة، هذه من أجلك

85
00:10:14,280 --> 00:10:15,160
.شكرًا لك

86
00:10:15,160 --> 00:10:16,340
.مع السّلامة

87
00:10:20,370 --> 00:10:22,100
.حسنًا، كانت تلك ماشيكي

88
00:10:33,920 --> 00:10:35,360
لماذا لا تخبرها بحقيقة مشاعرك؟

89
00:10:37,190 --> 00:10:40,360
.سئمتُ رؤية ردّة فعلك تلك

90
00:10:40,360 --> 00:10:42,410
.ماشيكي ليست كذلك

91
00:10:42,410 --> 00:10:44,520
.سئمتُ سماع ذلك أيضًا

92
00:10:45,400 --> 00:10:47,270
.يمكنني قول نفس الشّيء

93
00:10:47,720 --> 00:10:52,650
سأكون جادًّا عندما أقول أنّي أعرف
،أنّك تأخذ مثل هذه الأمور بجدّيّة

94
00:10:52,650 --> 00:10:56,700
لكن إن لم تستعمله، فلن تكون
.قادرًا على ذلك عندما يحين الوقت

95
00:10:56,700 --> 00:10:57,910
مزحة عن القضيب؟

96
00:10:58,380 --> 00:11:01,850
.كلاّ، أنا أقصد قلبك

97
00:11:03,360 --> 00:11:06,890
لقد اجتمعتَ أخيرًا بأميرتك، صحيح؟

98
00:11:07,250 --> 00:11:09,590
.أنت لا تستسلم

99
00:11:17,900 --> 00:11:20,900
فائز

100
00:11:59,330 --> 00:12:00,780
!حلّ الصّباح

101
00:12:01,330 --> 00:12:02,640
.صباح الخير

102
00:12:02,640 --> 00:12:06,280
!اسمع يا توا! استيقظ

103
00:12:13,880 --> 00:12:16,290
.سنغادر

104
00:12:16,290 --> 00:12:18,550
.سُحقًا لك يا أكيرا

105
00:12:18,940 --> 00:12:20,480
.نمتَ بشكل خاطئ فحسب

106
00:12:20,480 --> 00:12:21,920
.صحيح

107
00:12:22,370 --> 00:12:24,030
.دعني أستعمل السّرير

108
00:12:24,030 --> 00:12:25,970
.اذهب لمنزلك إن أردتَ النّوم على سرير

109
00:12:25,970 --> 00:12:27,180
.على رسلك

110
00:12:27,180 --> 00:12:28,680
ألا تتصرّف بقسوة تجاهي مؤخّرًا؟

111
00:12:28,680 --> 00:12:29,930
.ليس تمامًا

112
00:12:37,090 --> 00:12:39,610
.مرحبًا

113
00:12:40,610 --> 00:12:42,940
.الغداء، الغداء

114
00:13:08,200 --> 00:13:09,720
إلى من تنظر؟

115
00:13:17,330 --> 00:13:18,400
.يا إلهي

116
00:13:19,000 --> 00:13:21,100
.أنت مثابر بالفعل

117
00:13:23,030 --> 00:13:25,060
.كنّا أطفالاً حينها

118
00:13:25,060 --> 00:13:28,190
.لستُ طفلاً يتشبّث بالماضي للأبد

119
00:13:28,190 --> 00:13:30,560
.ها أنت ذا ثانية يا هاروكي-تشان

120
00:13:30,560 --> 00:13:32,620
.أعرف أنّك رومانسيّ في الواقع

121
00:13:32,620 --> 00:13:33,320
.أنعم علينا بسكوتك

122
00:13:33,320 --> 00:13:35,040
.كلاّ، لقد غضبت

123
00:13:35,420 --> 00:13:36,540
.سبق وأخبرتك

124
00:13:37,860 --> 00:13:40,750
،أعرف أنّك تريد الحديث دائمًا عن العلاقات

125
00:13:41,560 --> 00:13:44,900
.لكنّي لستُ مهتمًّا بذلك مثلك

126
00:13:44,900 --> 00:13:48,260
.يا لإزعاج الفتيان غير المحبوبين

127
00:13:49,390 --> 00:13:52,650
!كيف تجرؤ على ضرب ساقِ مهاجم؟

128
00:14:02,360 --> 00:14:04,330
هوندا، أأنت متفرّغ اليوم؟

129
00:14:04,330 --> 00:14:06,360
ماذا؟ بعد المدرسة؟

130
00:14:06,790 --> 00:14:08,110
.لديّ تمارين

131
00:14:08,710 --> 00:14:10,250
.أنت جدّ مجتهد

132
00:14:10,250 --> 00:14:12,540
.يا ممثّلة الفصل

133
00:14:12,990 --> 00:14:14,810
هل توزّعين تلك؟

134
00:14:14,810 --> 00:14:16,790
.ذهبتُ لأحصل عليها

135
00:14:18,210 --> 00:14:19,580
.وكأنّي سأصدّقك

136
00:14:19,580 --> 00:14:22,000
لقد نسيتَ أمر اجتماع اللّجنة
خلال الغداء، صحيح؟

137
00:14:27,380 --> 00:14:30,390
كيف أصبحت ممثّل الفصل؟

138
00:14:30,960 --> 00:14:33,560
.ركبت الموجة فحسب

139
00:14:33,560 --> 00:14:35,390
.إن كنتَ ستقوم بالعمل، فكن مسؤولاً

140
00:14:36,280 --> 00:14:39,040
.أنت ظريفة عندما تغضبين

141
00:14:41,560 --> 00:14:42,800
.سلّم هذه

142
00:14:46,030 --> 00:14:47,500
.آسف

143
00:15:11,300 --> 00:15:12,060
.هذا مؤلم

144
00:15:12,060 --> 00:15:14,010
أنا آسفة. هل أنت بخير؟

145
00:15:15,190 --> 00:15:19,140
.أنا آسفة. أنا أصطدم بالآخرين دائمًا

146
00:15:19,770 --> 00:15:22,490
هل أنت بخير يا ميهاشي مامي-سان؟

147
00:15:22,490 --> 00:15:26,360
كيف تعرفين اسمي يا ماشيكي ميهارو-سان؟

148
00:15:32,230 --> 00:15:36,340
لقد رأيتُك في ذلك اليوم وقلتُ
."لنفسي "تلك هي ميهاشي-سان

149
00:15:36,930 --> 00:15:38,950
.رأيتُك في مكتب هيئة التّدريس

150
00:15:39,400 --> 00:15:42,250
كنتِ مع والدتك، صحيح؟

151
00:15:42,250 --> 00:15:43,610
.نعم

152
00:15:44,040 --> 00:15:46,320
.تحبّين الكتب

153
00:15:46,320 --> 00:15:47,680
.وكذلك أنت

154
00:15:47,680 --> 00:15:50,620
.لقد استعرتِ رواية مونتغومري مرّات عدّة

155
00:15:50,620 --> 00:15:51,680
."آن من غرين غايبلز"

156
00:15:51,680 --> 00:15:53,070
.أغاثا كريستي

157
00:15:53,070 --> 00:15:54,360
."بواروت وماربل"

158
00:15:54,360 --> 00:15:55,550
.ميشائيل إندي

159
00:15:55,550 --> 00:15:57,270
."قصّة بلا نهاية"

160
00:16:06,050 --> 00:16:07,900
لماذا أنت في عجلة من أمرك؟

161
00:16:08,540 --> 00:16:13,000
.كنتِ كسيندريلاّ الهاربة من الحفلة

162
00:16:13,700 --> 00:16:15,180
.أنت رومانسيّة

163
00:16:15,600 --> 00:16:19,320
.ماذا؟ أعلم أنّي شخص حالم

164
00:16:19,320 --> 00:16:22,760
.ذلك لطيف، لكنّك مخطئة

165
00:16:22,760 --> 00:16:26,760
.كنتُ أهرب من غبيّ سطحيّ

166
00:16:26,760 --> 00:16:27,980
سطحيّ؟

167
00:16:27,980 --> 00:16:30,250
.زميل في الفصل يدعى هوندا

168
00:16:30,250 --> 00:16:32,200
.إنّه لا يدعني وشأني أبدًا

169
00:16:32,200 --> 00:16:34,720
.إنّه يستمتع بإغاظة أشخاص مثلي

170
00:16:34,720 --> 00:16:37,020
تعرفين أنّ ذلك هو حال الفتيان، صحيح؟

171
00:16:37,620 --> 00:16:39,710
.ربّما في الحضانة

172
00:16:39,710 --> 00:16:41,580
.صحيح، إنّه طفل

173
00:16:41,580 --> 00:16:43,480
.طفل مزعج

174
00:16:47,410 --> 00:16:48,980
.اصمتا

175
00:16:48,980 --> 00:16:50,590
.آسفتان

176
00:16:57,740 --> 00:17:00,310
.ماشيكي-سان، أوقعتك في المشاكل أيضًا

177
00:17:00,880 --> 00:17:03,070
.لا بأس. لقد استمتعت

178
00:17:03,070 --> 00:17:06,000
.وأنا أيضًا. لطالما أردتُ إخبار أحد

179
00:17:06,660 --> 00:17:08,840
.لا فائدة من إخباره

180
00:17:10,340 --> 00:17:12,010
.شكرًا على إصغائك

181
00:17:12,500 --> 00:17:16,410
هل تحتاجين للمساعدة إن كان يزعجك كثيرًا؟

182
00:17:17,800 --> 00:17:21,100
هوندا-كُن من الفصل 2 في فريق
كرة القدم، صحيح؟

183
00:17:21,100 --> 00:17:22,270
أتعرفينه؟

184
00:17:22,270 --> 00:17:25,000
.نعم، ذهبنا لنفس المدرسة الإعداديّة

185
00:17:25,000 --> 00:17:27,020
.هوندا-كُن يجلب الانتباه

186
00:17:27,020 --> 00:17:29,900
.صحيح، من كلّ النّواحي

187
00:17:32,100 --> 00:17:34,990
هنالك فتى من الفصل 1 في فريق السّباحة

188
00:17:34,990 --> 00:17:39,480
،أراه دائمًا رفقة هوندا-كُن
.لكنّه لطيف للغاية

189
00:17:39,910 --> 00:17:42,280
أتريدينني أن أرى إن كان بإمكانه المساعدة؟

190
00:17:42,280 --> 00:17:44,480
.ماذا؟ لا، أنا بخير

191
00:17:44,480 --> 00:17:46,660
.فهو لا يتصرّف بعنف أو ما شابه

192
00:17:47,300 --> 00:17:50,410
.لكن شكرًا على قلقك

193
00:17:50,410 --> 00:17:52,940
.سأعلمك إن احتجت لأيّ شيء

194
00:17:52,940 --> 00:17:53,560
.حسنًا

195
00:17:56,170 --> 00:17:59,590
.واحد، اثنان. واحد، اثنان. واحد، اثنان

196
00:17:57,510 --> 00:17:59,590
!لا تسمحوا لفريق السّباحة أن يهزموكم

197
00:18:01,540 --> 00:18:03,100
.أهلاً

198
00:18:03,370 --> 00:18:04,730
أراك لا تسبح؟

199
00:18:04,730 --> 00:18:07,390
يركّز تلاميذ السّنة الأولى على تحسين
.قدرتهم على التّحمّل

200
00:18:07,390 --> 00:18:09,430
.سنسبح لاحقًا

201
00:18:10,450 --> 00:18:12,270
.أنت سمكة خارج المياه

202
00:18:12,270 --> 00:18:16,910
على أيّ حال، متى سيصبح مهاجم
ثانويّة أوُكي أساسيًّا في الفريق؟

203
00:18:16,910 --> 00:18:21,210
.فقط بمجرّد أن يشهدوا على مهاراتي

204
00:18:21,210 --> 00:18:23,130
.أتطلّع شوقًا لذلك

205
00:18:23,130 --> 00:18:26,090
.أنت لا تقصد ذلك

206
00:18:26,710 --> 00:18:27,520
أكان ذلك واضحًا؟

207
00:18:27,520 --> 00:18:28,920
.وضوح الشّمس

208
00:18:29,320 --> 00:18:30,540
.لا يهمّ

209
00:18:31,170 --> 00:18:34,170
على أيّ حال، هل حصلت على ذلك
الغرض الّذي ذكرته ذلك اليوم؟

210
00:18:34,450 --> 00:18:35,500
أيّ غرض؟

211
00:18:35,500 --> 00:18:37,640
.الغرض الّذي أراده أكيرا

212
00:18:37,640 --> 00:18:39,840
.اللّعبة

213
00:18:39,840 --> 00:18:42,140
.نعم، لكنّي لم أتمكّن من لعبها

214
00:18:42,140 --> 00:18:43,390
.أخذها أكيرا منّي

215
00:18:43,390 --> 00:18:45,840
.جيّد. سألعبها أيضًا

216
00:18:45,840 --> 00:18:49,400
مهلاً، مهلاً. هل يعني ذلك
أنّك قادم معي ثانية؟

217
00:18:49,400 --> 00:18:53,280
.نعم. لا يمكن لأكيرا أن يتقدّم من دوني

218
00:18:53,280 --> 00:18:54,980
.أنت في منزلنا أكثر من أبي

219
00:18:56,760 --> 00:19:00,060
.على أيّ حال، لنعد للمنزل معًا بعد التّمرين

220
00:19:00,060 --> 00:19:02,360
.لكن لديّ واجب مدرسيّ اليوم

221
00:19:02,360 --> 00:19:04,480
.سنتقابل في متجر البقالة إذًا

222
00:19:04,480 --> 00:19:05,980
.كفّ عن التّخطيط لمواعيد دون استشارتي

223
00:19:05,980 --> 00:19:07,720
.كلاّ. الزّملاء الأكبر قادمون

224
00:19:07,720 --> 00:19:09,240
!أنت، مهلاً

225
00:19:12,630 --> 00:19:16,960
آسف. سأذهب للمنزل
بما أنّ لديّ واجبًا مدرسيًّا

226
00:19:12,630 --> 00:19:19,630
أنت لئيم للغاية

227
00:19:17,050 --> 00:19:19,630
.سأمرّ على متجر البقالة
أتريد شيئًا؟

228
00:19:40,570 --> 00:19:42,730
تقرئين هكذا أشياء يا ممثّلة الفصل؟

229
00:19:42,730 --> 00:19:43,830
.فاجأني هذا

230
00:19:51,320 --> 00:19:53,220
.شكرًا لك

231
00:19:56,130 --> 00:19:57,550
يا ممثّلة الفصل؟

232
00:19:57,550 --> 00:19:59,930
لماذا تهربين؟

233
00:20:00,610 --> 00:20:03,300
.تجعلين الأمر يبدو وكأنّي قدمتُ بشيء غريب

234
00:20:04,690 --> 00:20:05,800
.بالفعل

235
00:20:06,960 --> 00:20:10,310
.اتركني. أنت تحرجني

236
00:20:10,310 --> 00:20:13,140
أحرجك؟ كيف؟

237
00:20:13,560 --> 00:20:16,310
.لأنّ هذا غير منطقيّ

238
00:20:17,140 --> 00:20:21,030
ظننتَ أنّ مانغا الفتيات لا تناسبني، صحيح؟

239
00:20:22,310 --> 00:20:26,540
.الأشياء الظّريقة من حقّ الفتيات الظّريفات

240
00:20:29,560 --> 00:20:33,110
.لا شيء منها يناسبني

241
00:20:39,720 --> 00:20:42,090
.يا ممثّلة الفصل، أنت ظريفة

242
00:20:43,000 --> 00:20:47,230
لا أفهم. لماذا تشعرين بالحرج؟

243
00:20:47,230 --> 00:20:50,810
.أخبرك دائمًا أنّك ظريفة

244
00:20:51,970 --> 00:20:53,030
...لذلك

245
00:20:55,990 --> 00:20:58,730
!لا تقل ذلك وكأنّه شيء عابر

246
00:21:05,000 --> 00:21:07,160
.أنا جادّ

247
00:21:12,120 --> 00:21:13,240
.أنت ظريفة

248
00:21:19,110 --> 00:21:19,740
!غبيّ

249
00:21:19,740 --> 00:21:21,220
!يا ممثّلة الفصل

250
00:23:40,060 --> 00:24:10,090
الحلقة القادمة

251
00:23:42,720 --> 00:23:46,320
.ماي، شهر النّسائم الخفيفة وأوراق الشّجر الجديدة

252
00:23:46,320 --> 00:23:49,940
.بدأ قلب فتى يافع بالنّبض

253
00:23:49,940 --> 00:23:53,870
.الخطوة الأولى تقرّبهما من بعضهما

254
00:23:54,400 --> 00:23:57,200
.مكان مميّز ووقت مميّز

255
00:23:57,590 --> 00:24:00,830
.كلّ لحظة لا تعوّض

256
00:24:01,430 --> 00:24:05,920
."في الحلقة القادمة من "كونبيني كاريشي
."الحلقة الثّانية: "ماي

257
00:24:05,920 --> 00:24:09,960
.ها هنا كُتبت الحروف الأولى لقصّتهما