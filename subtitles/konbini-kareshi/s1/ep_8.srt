1
00:00:12,050 --> 00:00:14,870
كيف تعرف هذا المكان يا هوندا-كُن؟

2
00:00:15,680 --> 00:00:17,660
كنتِ ترغبين بزيارته، صحيح؟

3
00:00:22,840 --> 00:00:24,890
تحبّين مثل هذه الأمور، صحيح؟

4
00:00:26,580 --> 00:00:27,710
عرفتَ حينها؟

5
00:00:27,710 --> 00:00:28,630
.نعم

6
00:00:30,720 --> 00:00:32,400
.أنا سعيد لأنّنا استطعنا المجيء

7
00:00:32,400 --> 00:00:33,420
.لنأكل

8
00:00:34,740 --> 00:00:35,800
.حسنًا

9
00:00:46,710 --> 00:00:48,440
.شكرًا لكم

10
00:00:49,490 --> 00:00:50,660
هل كان لذيذًا؟

11
00:00:51,270 --> 00:00:51,820
.نعم

12
00:00:51,820 --> 00:00:53,190
!أجل

13
00:00:54,070 --> 00:00:57,680
.لكنّي تمنّيتُ لو شاركتني كعكتك

14
00:00:57,680 --> 00:00:59,470
.لم تسمحي لي ولو بقضمة واحدة

15
00:00:59,470 --> 00:01:00,580
.طبعًا لا

16
00:01:00,920 --> 00:01:02,220
وما السّبب؟

17
00:01:03,110 --> 00:01:04,330
تسأل عن السّبب؟

18
00:01:05,090 --> 00:01:06,580
لا يمكنك ذلك فحسب، مفهوم؟

19
00:01:08,420 --> 00:01:10,890
.أردتُ بعضًا من كعكتك

20
00:01:11,880 --> 00:01:13,840
.أنت تقول أمورًا كهذه دائمًا

21
00:01:27,520 --> 00:01:30,580
.عليّ العودة باكرًا. آسفة، عليّ الذّهاب

22
00:01:31,860 --> 00:01:33,050
.سأترك هذا هنا

23
00:01:35,320 --> 00:01:36,140
.مع السّلامة

24
00:01:36,140 --> 00:01:38,190
.مهلاً! سأوصلك للمنزل

25
00:01:38,190 --> 00:01:40,230
.لا بأس. إلى اللّقاء

26
00:01:41,220 --> 00:01:42,990
.شكرًا على اليوم

27
00:01:48,690 --> 00:01:51,750
.آسفة، لقد داهمني الوقت

28
00:01:52,320 --> 00:01:55,000
.أعلم. أكاد أصل

29
00:03:41,520 --> 00:03:42,590
كعكة؟

30
00:03:42,590 --> 00:03:44,620
.كانت لذيذة للغاية

31
00:03:44,620 --> 00:03:45,750
.هذه هي

32
00:03:46,930 --> 00:03:48,320
هل أنت فتاة؟

33
00:03:48,320 --> 00:03:50,090
من يهتمّ؟

34
00:03:50,930 --> 00:03:52,990
.أتمنّى لو بمقدورنا قضاء وقت أكثر معًا

35
00:03:52,990 --> 00:03:54,000
فعلاً؟

36
00:03:54,320 --> 00:03:56,300
.هذه ليست ردّة فعل مناسبة

37
00:03:56,300 --> 00:03:59,420
.اسمع، أريد قضاء كلّ وقتي معها

38
00:03:59,420 --> 00:04:02,320
.لقد بدأت تردّ على رسائلي في الحال أيضًا

39
00:04:02,320 --> 00:04:03,380
.نعم، نعم

40
00:04:03,780 --> 00:04:05,260
أتشعر بالغيرة؟

41
00:04:05,260 --> 00:04:06,330
.اخرس

42
00:04:08,050 --> 00:04:09,240
كعكة؟

43
00:04:09,240 --> 00:04:10,140
.نعم

44
00:04:10,680 --> 00:04:12,720
.يبدو ذلك لطيفًا

45
00:04:12,720 --> 00:04:14,120
أتظنّين ذلك؟

46
00:04:14,120 --> 00:04:15,150
.بالطّبع

47
00:04:16,200 --> 00:04:17,480
.فهمت

48
00:04:18,530 --> 00:04:22,400
يا ممثّلة القسم، هل لديك وقت
لاحتساء الشّاي اليوم؟

49
00:04:23,590 --> 00:04:25,710
.كنتُ أنوي المرور على متجر الكتب اليوم

50
00:04:25,710 --> 00:04:27,660
.سأوصلك إلى هناك إذًا

51
00:04:28,440 --> 00:04:29,800
.لا بأس بذلك

52
00:04:32,850 --> 00:04:35,020
!أنا آسفة في الحقيقة. عليّ الذّهاب

53
00:05:15,510 --> 00:05:17,110
.صباح الخير يا ممثّلة القسم

54
00:05:18,720 --> 00:05:19,920
.صباح الخير

55
00:05:20,600 --> 00:05:22,670
...المعذرة

56
00:05:22,670 --> 00:05:23,660
.آسفة

57
00:05:23,660 --> 00:05:24,670
.لا بأس

58
00:05:25,410 --> 00:05:27,370
...رسالة البارحة

59
00:05:27,840 --> 00:05:28,680
.إنّه أخي

60
00:05:29,170 --> 00:05:31,100
.لقد مرّ من هناك صدفة

61
00:05:31,720 --> 00:05:33,430
هل قال شيئًا لك؟

62
00:05:34,040 --> 00:05:37,440
.كلاّ، الأمر ليس خطيرًا لذلك الحدّ

63
00:05:38,790 --> 00:05:39,790
...لكن

64
00:05:41,430 --> 00:05:44,070
.قالت أنّه لا يمكنني أن أوصلها للمنزل لفترة

65
00:05:44,380 --> 00:05:46,240
.لا عجب أنّهم قلقون

66
00:05:46,240 --> 00:05:47,640
.فهي تقضي وقتًا معك

67
00:05:49,040 --> 00:05:52,200
.تعمل عائلة ميهاشي-سان في تنسيق الزّهور

68
00:05:52,200 --> 00:05:53,830
.يبدو أنّهم صارمون

69
00:05:53,830 --> 00:05:56,520
تنسيق الزّهور؟

70
00:05:56,520 --> 00:05:57,460
.نعم

71
00:05:57,790 --> 00:05:59,790
.والدها محامٍ

72
00:05:59,790 --> 00:06:02,380
.وسيصبح أخوها محاميًا أيضًا

73
00:06:02,380 --> 00:06:03,820
...محامين

74
00:06:05,440 --> 00:06:09,920
وبسبب ذلك، تسمح لها عائلتها بالتّأخير ليلاً

75
00:06:09,920 --> 00:06:11,760
.فقط إن كان الأمر متعلّقًا بالمدرسة

76
00:06:15,610 --> 00:06:17,440
.يبدو ذلك صعبًا

77
00:06:17,440 --> 00:06:18,250
.نعم

78
00:06:18,800 --> 00:06:20,250
.فهمت

79
00:06:20,250 --> 00:06:22,860
.تبدو ميهاشي منضبطة بالفعل

80
00:06:23,400 --> 00:06:24,730
.أعلم

81
00:06:26,120 --> 00:06:30,870
.أعلم ذلك، لكن لم تكن لي أدنى فكرة عن عائلتها

82
00:06:32,530 --> 00:06:35,340
.هذا سخيف

83
00:06:43,080 --> 00:06:44,700
أراك هنا يا ميهاشي-سان؟

84
00:06:45,640 --> 00:06:47,210
.لم أعتقد أنّك ستأتين اليوم

85
00:06:47,730 --> 00:06:50,110
.سوف آخذ دروسًا أكثر لبعض الوقت

86
00:06:50,110 --> 00:06:52,060
.فعلاً؟ أنت تدرسين بجدّ

87
00:07:07,230 --> 00:07:08,550
هوندا-كُن؟

88
00:07:10,930 --> 00:07:12,540
هل يمكننا السّير معًا؟

89
00:07:13,450 --> 00:07:16,340
.لا-لا أستطيع. هنالك من سيأتي ليوصلني

90
00:07:21,040 --> 00:07:22,560
!هوندا-كُن، يدي

91
00:07:23,500 --> 00:07:24,680
.آسف

92
00:07:25,610 --> 00:07:27,050
.لقد فاجأتني

93
00:07:27,880 --> 00:07:30,060
.آسف على كلّ شيء

94
00:07:32,260 --> 00:07:35,750
لم تكن لي أدنى فكرة أنّك
.تضغطين على نفسك كثيرًا

95
00:07:36,640 --> 00:07:37,510
.كلاّ

96
00:07:39,160 --> 00:07:42,120
.إنّها غلطتي لأنّي لم أخبرك بأيّ شيء

97
00:07:43,520 --> 00:07:46,070
هل هنالك ما أستطيع فعله؟

98
00:07:47,250 --> 00:07:50,920
.شكرًا، لكنّه شيء عليّ أنا فعله

99
00:07:51,990 --> 00:07:53,300
.كنتُ أفكّر في الأمر

100
00:07:53,800 --> 00:07:56,830
،إن تحسّنت علاماتي

101
00:07:56,830 --> 00:08:01,540
.فقد يوافقون على هذا

102
00:08:02,880 --> 00:08:04,230
...يا ممثّلة القسم

103
00:08:07,190 --> 00:08:11,760
هل يعني ذلك أنّك ستكونين
مشغولة أكثر من الآن فصاعدًا؟

104
00:08:11,760 --> 00:08:13,010
.نعم

105
00:08:13,010 --> 00:08:14,490
.فهمت

106
00:08:15,280 --> 00:08:16,600
.حظًّا سعيدًا

107
00:08:17,200 --> 00:08:18,810
هوندا-كُن؟

108
00:08:19,490 --> 00:08:22,310
.سأعدمك إن كان هذا قرارك

109
00:08:22,870 --> 00:08:25,110
.لكن لا تضغطي على نفسك كثيرًا

110
00:08:25,730 --> 00:08:27,310
.فأنت تميلين للجدّ في شؤونك

111
00:08:30,340 --> 00:08:31,580
.شكرًا

112
00:08:49,510 --> 00:08:50,910
.لقد عدت

113
00:08:50,910 --> 00:08:52,210
!أهلا بك

114
00:08:52,620 --> 00:08:55,720
.هذا جيّد. ظننتُني سأخرج دون لقائك

115
00:08:55,720 --> 00:08:56,910
ماذا؟

116
00:08:56,910 --> 00:08:58,720
.كان بإمكانك مراسلتي إن احتجتِ لشيء

117
00:08:59,120 --> 00:09:01,470
.ظننتُ أنّه من الأفضل إخبارك شخصيًّا

118
00:09:08,790 --> 00:09:10,200
ما الّذي تفعله هنا؟

119
00:09:11,650 --> 00:09:12,760
.لقد أتيت

120
00:09:12,760 --> 00:09:14,890
.لا تتصرّف بتفاهة

121
00:09:14,890 --> 00:09:15,950
هل تعشّيت؟

122
00:09:15,950 --> 00:09:17,240
.نعم

123
00:09:17,240 --> 00:09:19,540
يا أكيرا! هل أنت هناك؟

124
00:09:23,370 --> 00:09:26,420
!توا، الوحش قادم! النّجدة

125
00:09:26,420 --> 00:09:28,040
.دع أمره لي

126
00:09:28,040 --> 00:09:30,460
.إليك قاذفة قنابلي الأعجوبة

127
00:09:31,920 --> 00:09:34,890
!أجل! لقد هزمناه

128
00:09:34,890 --> 00:09:37,210
!أجل! أحسنتُ عملاً

129
00:09:37,210 --> 00:09:39,460
.لننجز المهمّة التّالية

130
00:09:47,830 --> 00:09:49,400
تدريب صباحيّ مع نادي كرة القدم؟

131
00:09:49,400 --> 00:09:51,440
.إنّه اختياريّ

132
00:09:51,440 --> 00:09:55,390
،لا أستطيع لقاء ممثّلة القسم
.ولا أشعر برغبة بالذّهاب للمنزل

133
00:09:55,390 --> 00:09:57,640
ماذا بقي لأفعله غير الرّكض؟

134
00:09:57,640 --> 00:09:59,160
أهكذا الأمر إذًا؟

135
00:09:59,480 --> 00:10:01,580
.لا تتصرّف وكأنّ الأمر ليس جادًّا

136
00:10:04,260 --> 00:10:06,410
.بدأ الجوّ يبرد

137
00:10:07,330 --> 00:10:09,920
.ربّما عليّ طلب المزيد من كعك البخار

138
00:10:11,240 --> 00:10:13,210
ما رأيك يا ناسا-كُن؟

139
00:10:13,210 --> 00:10:15,320
.نعم، سيكون ذلك قريبًا

140
00:10:58,660 --> 00:11:00,180
.المعذرة

141
00:11:02,740 --> 00:11:04,600
!آسفة يا هوندا-كُن

142
00:11:06,040 --> 00:11:07,480
.جعلتُك تفعل كلّ هذا بمفردك

143
00:11:07,480 --> 00:11:09,440
.يمكنني تدبّر الأمر وحدي

144
00:11:09,440 --> 00:11:10,350
...لكن

145
00:11:10,350 --> 00:11:13,110
.لا بأس. دعيني أقوم بهذا على الأقلّ

146
00:11:14,290 --> 00:11:15,670
.شكرًا

147
00:11:17,200 --> 00:11:18,090
.العفو

148
00:11:20,280 --> 00:11:23,330
أخذ هوندا-كُن الدّفاتر لمكتب
المدرّسين من أجلك؟

149
00:11:23,330 --> 00:11:26,840
.نعم. أنا سعيدة لأنّه لاحظ ذلك

150
00:11:26,840 --> 00:11:30,370
.كنت مشغولة بما كان يحدث أمامي

151
00:11:31,600 --> 00:11:33,420
.لذلك بادر بالعمل عنك

152
00:11:33,420 --> 00:11:35,620
.هذا لطف من هوندا-كُن

153
00:11:38,680 --> 00:11:40,440
!ماشيكي-سان

154
00:11:40,440 --> 00:11:44,390
.لكنّي لا أصدّق أنّك نسيتِ واجبات ممثّلة القسم

155
00:11:44,770 --> 00:11:46,890
.لا تضغطي على نفسك كثيرًا

156
00:11:47,680 --> 00:11:48,540
.حسنًا

157
00:11:57,900 --> 00:11:59,260
ماذا تفعل؟

158
00:11:59,260 --> 00:12:01,100
.لا أريد العودة للمنزل

159
00:12:01,100 --> 00:12:02,150
ثانية؟

160
00:12:02,150 --> 00:12:05,240
اخرس. أنا مهموم كثيرًا، مفهوم؟

161
00:12:05,240 --> 00:12:06,900
أقلتَ كثيرًا؟

162
00:12:07,800 --> 00:12:09,430
أتريد المجيء معي؟

163
00:12:09,430 --> 00:12:10,540
هل يمكنني ذلك؟

164
00:12:10,830 --> 00:12:12,950
أنت مزعج للغاية، صحيح؟

165
00:12:14,670 --> 00:12:16,760
!يا صديقي العزيز

166
00:12:15,000 --> 00:12:16,760
.توقّف عن هذا

167
00:12:17,720 --> 00:12:20,420
.المعذرة... عن إذنكما

168
00:12:21,510 --> 00:12:23,340
.نون-تشان، إنّهما هنا

169
00:12:23,340 --> 00:12:24,930
فعلاً؟

170
00:12:25,370 --> 00:12:26,930
!ممتاز

171
00:12:27,240 --> 00:12:29,810
لماذا ترتديان هذه الملابس؟

172
00:12:31,560 --> 00:12:32,940
هل أنتما متفرّغان؟

173
00:12:32,940 --> 00:12:34,810
هل يمكنكما مساعدتي في شيء؟

174
00:12:42,390 --> 00:12:44,310
.شكرًا يا إيتوكاوا-سان

175
00:12:45,000 --> 00:12:46,580
.وأنت أيضًا

176
00:12:48,690 --> 00:12:50,080
.ماشيكي

177
00:12:50,410 --> 00:12:52,960
.لنبدأ بجمع ثمار الجنكة

178
00:12:52,960 --> 00:12:54,120
ثمار الجنكة؟

179
00:12:59,060 --> 00:13:02,520
ماذا؟ كيف يمكنكم فعل هذا؟

180
00:13:02,520 --> 00:13:04,780
!نحن مجموعة الطّبخ

181
00:13:04,780 --> 00:13:06,490
فكيف لنا ألاّ نجمع ثمار الجنكة؟

182
00:13:07,280 --> 00:13:09,400
!انظر يا ناسا-كُن

183
00:13:09,400 --> 00:13:11,540
.هذا رائع يا إيتوكاوا-سان

184
00:13:12,840 --> 00:13:14,760
.يمكنك إعداد التشاوانموشي بهذه

185
00:13:14,760 --> 00:13:15,600
.أكيد

186
00:13:16,120 --> 00:13:18,320
.أريد بعد التشاوانموشي أيضًا

187
00:13:18,320 --> 00:13:20,360
ذلك ما حاز على انتباهك؟

188
00:13:20,360 --> 00:13:22,610
.لكنّ التشاوانموشي لذيذ للغاية

189
00:13:23,090 --> 00:13:25,020
.ثمّة واحدة هناك

190
00:13:25,020 --> 00:13:25,960
أين؟

191
00:13:25,960 --> 00:13:27,460
.تحت الأوراق

192
00:13:27,890 --> 00:13:28,870
أرأيتها؟

193
00:13:29,780 --> 00:13:31,220
.معك حقّ

194
00:13:31,220 --> 00:13:33,130
.ميشيما-كُن، استعدّ

195
00:13:33,130 --> 00:13:34,370
.حاضر

196
00:13:53,880 --> 00:13:54,840
ما الخطب؟

197
00:13:56,000 --> 00:13:58,810
.رائحتها ليست جذّابة، لكنّها جميلة

198
00:13:58,810 --> 00:14:01,210
ظننتُ أنّ ممثّلة القسم ستحبّ
.الأمر إن أرسلت لها صورة

199
00:14:06,520 --> 00:14:07,750
ألن ترسلها؟

200
00:14:08,520 --> 00:14:09,780
.ليس الآن

201
00:14:10,840 --> 00:14:12,470
.ربّما في وقت آخر

202
00:14:12,470 --> 00:14:14,790
.لا أريد أن أقاطعها إن كانت تدرس

203
00:14:15,190 --> 00:14:16,760
.هكذا إذًا

204
00:14:16,760 --> 00:14:18,060
.هوندا-كُن

205
00:14:21,650 --> 00:14:24,220
.أتمنّى لو كانت ممثّلة القسم هنا

206
00:14:30,360 --> 00:14:32,620
.ما زالت رائحتي كريهة

207
00:14:32,620 --> 00:14:34,620
.سنستحمّ عند عودتنا للمنزل

208
00:14:34,620 --> 00:14:36,270
.كان ذلك ممتعًا

209
00:14:36,270 --> 00:14:37,320
.نعم

210
00:14:37,320 --> 00:14:39,640
!أريد التشاوانموشي

211
00:14:39,640 --> 00:14:41,240
.لا تبالغ

212
00:14:45,680 --> 00:14:47,080
ما الخطب؟

213
00:14:47,080 --> 00:14:48,320
.آسف يا هاروكي

214
00:14:49,220 --> 00:14:50,580
.عليّ العودة للمنزل

215
00:14:53,480 --> 00:14:54,710
.أهلاً بك

216
00:14:56,440 --> 00:14:58,310
