1
00:00:01,630 --> 00:00:04,190
ننتقل إلى آخر موضوعٍ للرياضة لليوم، المباراة الإحترافيّة

2
00:00:03,800 --> 00:00:06,980
:موفِّر الراو
Taxfour

3
00:00:04,670 --> 00:00:06,940
أثناء مباراة فئة وزن الديك ذات العشرة جولات لليوم

4
00:00:07,020 --> 00:00:09,060
،بين نانغو كوجي ويابوكي جو

5
00:00:09,100 --> 00:00:11,590
،لقد تقيّأ يابوكي في الحلبة مجددًا

6
00:00:11,640 --> 00:00:15,270
مثلما فعل في مباراته السابقة ضدّ
هاراجيما، وخسر بضربةٍ قاضية

7
00:00:15,560 --> 00:00:19,260
لقد بدا يابوكي مرةً كمن لا يُمكن إيقافه بعد عودته
،للملاكمة مع انتصاراتٍ متتاليةٍ متعددة

8
00:00:19,430 --> 00:00:23,780
لكن بسبب وضعه الغير مُسبوق بتقيّؤه
،في الحلبة، ليس مرةً، بل مرّتين الآن

9
00:00:23,950 --> 00:00:30,110
تناقلت شائعات بأنّه يحتملُ بأن تنتهي
مهنته كمُلاكم بين مُحلليّ مجال المُلاكمة

10
00:00:30,260 --> 00:00:34,510
بالإضافة، ملاكمٌ فينزويليّ مُصنّف عالميًّا
كارلوس ريفيرا- وصل اليوم إلى اليابان-

11
00:00:34,540 --> 00:00:38,570
إنهُ يُعرف بـ"الإمبراطور الغير متوَّج"، لقد
قُدِّم إلى حشدٍ قبل المباراة الآنف ذكرها

12
00:00:38,860 --> 00:00:41,340
بالرغم من أن ريفيرا لا يملك أيّ
،مباريات مُحددة في اليابان بعد

13
00:00:41,460 --> 00:00:45,660
لكن معجبيّ الملاكمة مُتلهّفين لرؤية أداء المصنّف
سادسًا على العالم ضدّ ملاكمٍ يابانيّ

14
00:00:50,480 --> 00:00:53,260
هل بإمكاني التحدّث مع الرئيس ناكامورا من فضلك؟

15
00:00:56,300 --> 00:00:58,050
معك شيراكي، من نادي شيراكي

16
00:00:58,100 --> 00:01:01,670
أحسنتَ عملًا في الليلة الماضية كمُساند لنانغو

17
00:01:02,920 --> 00:01:05,300
في الواقع، اتصلتُ اليوم بخصوص نانغو

18
00:01:05,630 --> 00:01:08,650
هل تحدّدت مباراته التالية بالفعل؟

19
00:01:09,890 --> 00:01:11,910
فهمت. يُسعدني سماع ذلك

20
00:01:11,940 --> 00:01:15,920
في تلك الحالة، هل بإمكاني أن أرعى
وأروّج لمباراة نانغو المُقبلة؟

21
00:01:16,030 --> 00:01:18,630
نقود القِتال سوف تُنافس مباراة آسيوية على اللقب

22
00:01:20,240 --> 00:01:21,150
خصمه؟

23
00:01:21,730 --> 00:01:23,990
بالطبع، نحن سنُقرر ذلك من طرفنا

24
00:01:25,420 --> 00:01:26,900
نعم، ذلك صحيح

25
00:01:27,500 --> 00:01:29,580
سوف نُناقش التفاصيل لاحقًا

26
00:01:31,760 --> 00:01:33,400
لقد تقرر الأمر يا روبرت

27
00:01:34,050 --> 00:01:36,100
مباراة كارلوس الأولى في اليابان

28
00:01:36,270 --> 00:01:39,150
ستكونُ ضدّ نانغو كوجي، الذي قاتل
يابوكي جو في الليلة الماضية

29
00:01:40,220 --> 00:01:43,160
.لقد سمعتها يا كارلوس
هل لديك أيّ أسئلة؟

30
00:01:46,630 --> 00:01:47,940
حسنٌ

31
00:02:22,080 --> 00:02:23,280
ما الأمر يا جو؟

32
00:02:23,740 --> 00:02:25,840
عليَّ التبوّل

33
00:03:14,080 --> 00:03:16,070
يا لطول مدّة ذلك "التبّول" الذي أنت تقوم به

34
00:03:16,120 --> 00:03:18,050
"أعتقد بأنّك سوف "تتبوّل
لساعةٍ أخرى إضافيّة أو نحوها؟

35
00:03:18,360 --> 00:03:20,280
نعم، سأقوم به طوال الليل

36
00:03:25,260 --> 00:03:26,920
أيها المسنّ

37
00:03:31,760 --> 00:03:33,170
!أيها المسنّ

38
00:03:33,320 --> 00:03:34,950
أنت تقوم بتنظيمها، صحيح؟

39
00:03:35,760 --> 00:03:37,360
أنظّم ماذا؟

40
00:03:38,370 --> 00:03:41,160
تدّعي الغباء. أقصد مباراتي المُقبلة، بالطبع

41
00:03:41,330 --> 00:03:42,330
هل تمَّ تنظيمها؟

42
00:03:47,170 --> 00:03:48,510
!أيها المسنّ

43
00:03:56,530 --> 00:03:58,330
!ما الأمر؟! زلزال؟

44
00:03:58,380 --> 00:03:59,800
!كفَّ عن ادّعاء النوم

45
00:03:59,840 --> 00:04:01,190
!أجبني أيها المسنّ

46
00:04:03,160 --> 00:04:04,570
هيّا، أخبرني

47
00:04:04,720 --> 00:04:06,320
لقد ذهبتَ اليوم إلى جمعيَّة المُلاكمة، صحيح؟

48
00:04:07,360 --> 00:04:09,280
لقد خسرتَ ضدّ البطل

49
00:04:09,740 --> 00:04:11,230
لقد خسرتَ ضدّ الملاكم الأول على وزن الديك

50
00:04:11,740 --> 00:04:13,570
ولقد خسرتَ ضدّ الملاكم الثاني على وزن الديك

51
00:04:13,850 --> 00:04:16,430
ليس ذلك فحسب، لقد تقيّأتَ كثيرًا في كافّة أرجاء الحلَبة

52
00:04:16,980 --> 00:04:21,400
أمقتُ إخبارك بهذا، لكن لا أحد مستعدّ لقتالك بعد الآن

53
00:04:22,610 --> 00:04:26,810
قالوا جميع رؤساء النوادي بأنهم لن يحددوا مباراةً مع يابوكي جو

54
00:04:26,870 --> 00:04:30,800
لقد قالوا بأن ملاكمًا لا يستطيع إحراز لكماتٍ
على الوجه وينهار على الحلبة للتقيّؤ

55
00:04:30,860 --> 00:04:32,870
ليس مُرضِيًا للجماهير

56
00:04:33,140 --> 00:04:37,360
بطريقةٍ ما، نالوا رؤساء النوادي أمنيتهم

57
00:04:37,380 --> 00:04:40,880
عن طريق جعلك تواجه سلسلة من
المُلاكمين الأقوياء، واحدًا تلو الآخر

58
00:04:42,010 --> 00:04:45,200
لكن حتى ولو لم يتآمروا بهذه
،الطريقة، لكانت النتيجة نفسها

59
00:04:45,630 --> 00:04:49,350
ما دُمتَ ممسوسًا بشبح ريكيشي-كن

60
00:04:49,470 --> 00:04:53,810
على الأرجح بأنّك مستعدٌّ للموت في
الحلبة سويًّا مع شبح ريكيشي-كن

61
00:04:54,630 --> 00:04:58,680
لكن بالنسبة لي، أنت قد مُتَّ سلفًا مع ريكيشي-كن

62
00:04:58,740 --> 00:05:01,790
لأن يابوكي جو -المُلاكم- قد مات بالفعل

63
00:05:02,900 --> 00:05:05,300
كُفَّ عن ذلك. لا زلتُ حيًّا

64
00:05:05,530 --> 00:05:08,240
بالإضافة، لا زلتُ أملك رخصتي كملاكم مُحترف

65
00:05:08,540 --> 00:05:10,200
!استسلم يا جو

66
00:05:10,300 --> 00:05:14,000
ملاكمٌ لا يستطيع اعتلاء الحلبة
!هو بمثابة شخصٍ ميّت

67
00:05:32,570 --> 00:05:33,730
...أيها المسنّ

68
00:05:33,770 --> 00:05:35,700
أصغِ أيها المسنّ. دعني أوضِّح شيئًا

69
00:05:35,970 --> 00:05:37,280
!أنا لم أمت بعد

70
00:05:37,570 --> 00:05:41,750
ما دام هناك شيءٌ يحترق
...ويُصدر دخانًا في داخلي

71
00:05:41,830 --> 00:05:45,130
،كلا، حتى لو كان ذلك أصغر جمرة

72
00:05:45,210 --> 00:05:48,600
!فأنا لم أمت بعد، ولا أنا متُّ مع ريكيشي

73
00:06:05,880 --> 00:06:06,840
...أيها المسنّ

74
00:06:06,910 --> 00:06:09,290
إذا لم تكن تستطيع النوم، فلمَ
لا تشرب بضعة مشروبات؟

75
00:06:09,660 --> 00:06:12,670
لو شئتْ، فسأجلب لك قارورةً من المطبخ

76
00:06:13,160 --> 00:06:16,000
لن يكون ذلك ضروريًّا. لن تجعلني
بضعة مشروبات أخلد إلى النوم

77
00:06:16,060 --> 00:06:16,830
...حسنٌ

78
00:06:23,570 --> 00:06:28,800
أيها المسنّ؟ أنت لا تفكّر في إغلاق النادي، صحيح؟

79
00:06:30,730 --> 00:06:31,400
!أيها المسنّ

80
00:06:31,640 --> 00:06:34,470
.لا تكن سخيفًا يا نيشي
.أنتَ لا زلتَ هنا

81
00:06:34,520 --> 00:06:38,890
ما دمتُ أملك ماموث نيشي المُنتمي إلى فئة
الوزن الخفيف الوسط، فلن أغلق هذا النادي

82
00:06:39,820 --> 00:06:40,710
...شكرًا

83
00:06:41,390 --> 00:06:44,660
اذهب إلى الفراش. مباراتك ستكون بعد أقل من أسبوع

84
00:06:44,700 --> 00:06:45,960
...صحيح

85
00:06:57,700 --> 00:06:59,840
آسفان على ابقائك تنتظر يا جو. فلنذهب

86
00:07:01,250 --> 00:07:01,840
...نعم

87
00:07:03,700 --> 00:07:06,940
،إذا.. إذا لم تكن ترغب في الذهاب
فابقَ هنا في النادي فحسب

88
00:07:07,020 --> 00:07:08,820
بإمكاني مُساندة نيشي بمفردي

89
00:07:13,080 --> 00:07:14,100
فلنذهب يا نيشي

90
00:07:14,260 --> 00:07:15,080
حاضر

91
00:07:45,360 --> 00:07:46,300
...لقد تأخرا

92
00:07:46,790 --> 00:07:48,380
!أيها المسنّ! نيشي

93
00:07:48,450 --> 00:07:49,480
ما الذي يستغرقكما كل هذا الوقت؟

94
00:07:51,160 --> 00:07:52,080
!يابوكي-كن

95
00:07:53,360 --> 00:07:54,550
...نوري-تشان

96
00:07:55,450 --> 00:07:57,640
لقد صادفتُ للتو نيشي-سان ودامبي-سان

97
00:07:57,810 --> 00:08:01,040
لقد طلبا منّي إعداد العشاء لك لأنّك تخلَّفتَ عنهما

98
00:08:01,380 --> 00:08:03,400
ألن تذهب إلى مباراة نيشي-سان؟

99
00:08:03,600 --> 00:08:05,300
!ماذا؟ مُحال

100
00:08:05,960 --> 00:08:08,000
!لقد تركاني في الخلف

101
00:08:08,170 --> 00:08:09,300
أقفلي النادي من أجلي، موافقة؟

102
00:08:09,980 --> 00:08:11,350
!ذانك الوغدين

103
00:08:11,700 --> 00:08:14,370
!جعلاني أنتظر وغادرا من غير قول كلمة

104
00:08:18,820 --> 00:08:19,850
...أيها المسنّ

105
00:08:19,870 --> 00:08:22,590
من الصعب مشاهدة الطريقة التي
...كان جو يتصرَّف بها مؤخرًا

106
00:08:23,250 --> 00:08:28,750
إمَّا أن يشرد ذهنه وهو يفكّر في شيء
أو أن يلكم كيس الرمل كأنّه ممسوس

107
00:08:28,960 --> 00:08:30,850
...ذلك هو ما يُسمّى باليأس يا نيشي

108
00:08:31,420 --> 00:08:34,370
،حتى يتقبَّل ذلك

109
00:08:34,420 --> 00:08:38,120
فتقريبًا من المُستحيل أن يعثر على الأمل للمضيّ قدمًا

110
00:08:38,600 --> 00:08:43,670
إن ذلك اللقيط يعرف ذلك، لكنه يرفضُ تقبّله

111
00:08:47,120 --> 00:08:49,090
!سيارة أجرة! سيارة أجرة

112
00:08:51,580 --> 00:08:53,840
إلى قاعة كوراكوين. عليَّ الوصول إلى هناك بسرعة

113
00:09:03,820 --> 00:09:09,100
لكمة يابوكي له على صدغه أثناء الجولة السادسة

114
00:09:09,140 --> 00:09:14,280
...ساهمتْ في وفاة ريكيشي تورو

115
00:09:26,900 --> 00:09:28,850
!أوقِف السيارة! توقّف

116
00:09:35,780 --> 00:09:39,000
ماذا؟ تريد مباراة أخرى ضدّ تايغر؟

117
00:09:39,220 --> 00:09:42,200
،أعرف بأنني أطلب الكثير
.لكن أسدني معروفًا

118
00:09:42,280 --> 00:09:43,810
بإمكانك الاحتفاظ بنقود القِتال

119
00:09:44,280 --> 00:09:47,370
لا يبدو عليك بأنّك تعي الوضع
الذي أنت فيه يا يابوكي-كن

120
00:09:47,660 --> 00:09:50,810
الملاكمة في الأساس، هي رياضة حيث تلكمان وجهيّ بعضيكما

121
00:09:50,820 --> 00:09:52,400
وذلك هو ما يأتي الجمهور لرؤيته

122
00:09:52,970 --> 00:09:57,360
أي أنّ، ملاكم مثلك غير قادر على فعل
ذلك، لم يعد يملكُ مكانًا في الحلبة

123
00:09:57,880 --> 00:09:59,300
لا داعٍ للقلق

124
00:09:59,360 --> 00:10:01,840
!هذه المرّة، سألكمُ تايغر على وجهه تمامًا

125
00:10:02,260 --> 00:10:04,400
أثناء تقيّؤك في كافة أرجاء الحلَبة؟

126
00:10:06,440 --> 00:10:11,460
لو كنت أحد ملاكميّ، لكنتُ حثثتُك
بلا ريبٍ على التقاعد

127
00:10:12,700 --> 00:10:13,620
ماذا؟

128
00:10:13,810 --> 00:10:15,150
!أريدك أن تغادر

129
00:10:15,500 --> 00:10:18,190
!أنا مشغولٌ بالترويج لمباراتنا المُقبلة

130
00:10:18,820 --> 00:10:19,420
لا حاجة للصراخ

131
00:10:19,440 --> 00:10:23,310
!حسنٌ، أفهم الأمر! سأغرب عن وجهك لليوم

132
00:10:24,040 --> 00:10:24,990
أراك لاحقًا

133
00:10:26,900 --> 00:10:29,790
أهلًا يا تايغر. لقد مضت فترة

134
00:10:29,860 --> 00:10:30,760
ذلك يكفي

135
00:10:40,220 --> 00:10:42,140
عندما أشاهدك من هنا، فعلًا أنت تتحرك كبطل

136
00:10:42,200 --> 00:10:43,240
إنك تملك بعض الحركات الجيّدة

137
00:10:44,260 --> 00:10:47,970
هيّا، خُض مباراةً تدريبةً معي لبعض الوقت

138
00:10:48,240 --> 00:10:50,080
!ارموه خارجًا! إنه يشتت انتباهي عن تمريني

139
00:10:50,780 --> 00:10:53,430
هيّا، ابتهج. لا تكن قاسيًا كثيرًا

140
00:10:53,540 --> 00:10:56,090
نحن رفيقان حلبة الآن، ألسنا كذلك؟

141
00:10:56,380 --> 00:10:57,590
اغرب يا يابوكي

142
00:10:57,960 --> 00:11:02,130
لدى البطل مباراة دفاعٍ عن اللقب قادمة، لذا فهو متوتر

143
00:11:02,580 --> 00:11:03,440
اتركني

144
00:11:03,610 --> 00:11:06,100
إن تايغر ليس الشخص الوحيد المتوتر

145
00:11:13,310 --> 00:11:14,170
!لقيط

146
00:11:14,210 --> 00:11:15,140
!اقتلوه

147
00:11:44,280 --> 00:11:45,140
!مقزز

148
00:11:52,730 --> 00:11:55,270
!ارموه خارجًا
!لا أريده أن يوسخ ناديَّ

149
00:12:17,520 --> 00:12:19,580
يابوكي-سان، لم أرك منذ زمنٍ طويل

150
00:12:19,880 --> 00:12:21,060
...جوروماكي

151
00:12:21,120 --> 00:12:22,080
...جوروماكي جوندو

152
00:12:22,620 --> 00:12:23,320
استخدم هذا

153
00:12:23,440 --> 00:12:25,080
الدمُّ يغطّي جسدك

154
00:12:28,100 --> 00:12:30,060
لقد كانت عودةً متألّقة

155
00:12:30,120 --> 00:12:32,740
لقد شاهدتُ معظم مبارياتك

156
00:12:32,880 --> 00:12:33,840
لقد سُررتُ برؤية عودتك

157
00:12:34,620 --> 00:12:36,480
لقد رأيتَ مبارياتي الحديثة إذن؟

158
00:12:37,180 --> 00:12:37,770
أجل

159
00:12:38,340 --> 00:12:40,450
...ثلاثة خسائر متتالية

160
00:12:41,300 --> 00:12:44,570
أنا لا أشاهد القِتالات لرؤية من ينتصر أو يخسر

161
00:12:44,960 --> 00:12:47,440
أنا أذهب لرؤية الروح القِتاليّة للمُلاكمين

162
00:12:47,760 --> 00:12:51,860
لا يهمّ ما هو نوع المباراة، إنّ
روحك القِتاليّة من الدرجة الأولى

163
00:12:51,980 --> 00:12:53,240
ذلك هو ما أظنّه

164
00:13:00,740 --> 00:13:02,450
هل أنتَ ذاهبٌ إلى مكانٍ ما؟

165
00:13:02,860 --> 00:13:05,130
نعم، أنا واقعٌ في بعض المتاعب

166
00:13:05,160 --> 00:13:06,330
لقد كنتُ للتوّ على وشك المُغادرة في رحلة

167
00:13:07,180 --> 00:13:07,890
...رحلة

168
00:13:08,880 --> 00:13:10,930
هل ترغب في الانضمام لي؟

169
00:13:18,200 --> 00:13:20,560
لقد عدتُ للتوّ

170
00:13:22,040 --> 00:13:22,810
...صحيح

171
00:13:24,700 --> 00:13:29,360
يابوكي-سان، لعلّي لا أكون الشخص
الأنسب لقول هذا، لكن ابذل ما بوسعك

172
00:13:33,200 --> 00:13:35,410
حسنٌ، آمل بأن تتقاطع طُرقنا مجددًا

173
00:13:35,500 --> 00:13:36,680
أراك لاحقًا

174
00:13:50,240 --> 00:13:53,140
!يبدو بأن الجميع هنا

175
00:13:53,540 --> 00:13:54,340
!جو

176
00:13:54,660 --> 00:13:55,940
!أهلًا يا نيشي

177
00:13:56,000 --> 00:13:58,060
أنا آسف لأنني لم أستطِع حضور مباراتك

178
00:13:58,320 --> 00:14:00,260
إذن؟ هل انتصرت؟

179
00:14:01,080 --> 00:14:04,400
!نعم، لقد انتصرت! لقد أفقدتُه وعيه في الجولة الأخيرة

180
00:14:04,580 --> 00:14:06,570
فهمت. ذلك عظيم

181
00:14:06,680 --> 00:14:12,740
إذن، آن الأوان لكي ترتقي من ذوات الثمانية
!جولات إلى ذوات العشرة جولات

182
00:14:13,100 --> 00:14:17,410
فهمت.. آسفٌ لأنني فوتُّ ذلك. ليتني
تمكنّتُ من رؤية لكمتك القاضية القويّة

183
00:14:17,720 --> 00:14:20,560
،نعم، ليتك تمكنت من رؤيتها أيضًا

184
00:14:20,620 --> 00:14:22,840
بما أنه آل بها المآل إلى أن تصبح آخر مباراةٍ لي

185
00:14:25,220 --> 00:14:27,570
آل بها المآل إلى أن تصبح.. آخر مباراةٍ لك؟

186
00:14:30,480 --> 00:14:34,920
لقد قرر نيشي أن يتقاعد بعد مباراة اليوم

187
00:14:36,060 --> 00:14:38,290
لقد اتخذَ قراره

188
00:14:38,480 --> 00:14:42,980
،لقد كانت يده اليُمنى مُتضررة بالفعل
لكنّه حطّمها بالكامل أثناء مباراة اليوم

189
00:14:43,140 --> 00:14:46,900
لقد قال الطبيب الذي في المشفى بأنه كسرٌ معقّدٌ سيئ

190
00:14:46,960 --> 00:14:48,900
وبأنه لن يكون قادرًا على المُلاكمة بعد الآن

191
00:14:49,080 --> 00:14:53,020
،نيشي، إذا تخلّيتَ عن المُلاكمة
!فما الذي سوف يتبقَّ لك؟

192
00:14:53,340 --> 00:14:56,860
يستحيلُ ذلك أيها المسنّ! لا بدَّ من
وجود شيءٍ يسعنا القيام به، صح؟

193
00:14:56,920 --> 00:14:57,850
!ذلك ليس عادلًا

194
00:14:58,060 --> 00:15:00,850
أعرف يا نيشي! فلنقُم بزيارة
!بضع مُستشفيات سويًّا

195
00:15:00,880 --> 00:15:04,340
لعلّنا نعثر على طبيبٍ قادرٍ على إجراء
،عمليةٍ جراحيَّةٍ عليك أو شيئًا ما

196
00:15:04,380 --> 00:15:05,820
!لكي يكون في وسعك أن تُلاكم مُجددًا

197
00:15:06,980 --> 00:15:09,050
!موافق يا نيشي؟! اترك كلّ شيءٍ لي

198
00:15:09,080 --> 00:15:13,600
أقسمُ بأنني لن أدعك تُقاسي ألم عدم
!القدرة على المُلاكمة بعد الآن

199
00:15:14,780 --> 00:15:17,640
!نيشي ليس الوحيد
!أنت ستتقاعد أيضًا

200
00:15:22,720 --> 00:15:23,760
ماذا؟

201
00:15:23,820 --> 00:15:26,060
ما الذي قلته للتوّ أيها المسنّ؟

202
00:15:26,280 --> 00:15:28,100
سأقولها بعدد المرات التي يكون فيها ذلك ضروريًّا

203
00:15:28,440 --> 00:15:30,960
أنت سوف تتقاعد سويًّا مع نيشي

204
00:15:31,180 --> 00:15:33,640
لقد قررتُ سلفًا

205
00:15:33,700 --> 00:15:36,080
سأغلق نادي تانجي للمُلاكمة للأبد. مفهوم؟

206
00:15:38,340 --> 00:15:41,770
كنتُ سأُبقي النادي مفتوحًا ما دام بإمكان
نيشي أن يُلاكم، لكن انتهى الأمر الآن

207
00:15:41,800 --> 00:15:45,780
آن الأوان للـ" المُلاكم المسنّ من الأحياء
الفقيرة" أن يرمي المنشفة أيضًا

208
00:15:47,460 --> 00:15:48,900
استسلم يا جو

209
00:15:49,100 --> 00:15:51,640
تتخطَّى بعض الأشياء سيطرة الإنسان

210
00:15:51,900 --> 00:15:56,010
لأكون صريحًا، لا أطيقُ الاستمرار
!بمشاهدتك على هذه الحال أيضًا

211
00:16:06,420 --> 00:16:09,850
...بالنسبة لمستقبلك أنت ونيشي

212
00:16:10,140 --> 00:16:13,780
لحسن الحظّ، هاياشي-سان قد عرض
أن يعتني بكما أنتما الاثنان

213
00:16:14,360 --> 00:16:17,940
إنه مستعدٌّ لتوظيف كلاكما بدوامٍ كامل

214
00:16:18,580 --> 00:16:24,280
يابوكي-كن! أنا أخططُ لتوسيع متجري وتحويله
إلى ما يشابه السوق التجاريَّة يومًا ما

215
00:16:24,340 --> 00:16:26,700
لهذا السبب أرغبُ بتوظيف الأشخاص الآن

216
00:16:26,940 --> 00:16:28,320
!أرجوك تعال واعمل لصالحنا

217
00:16:28,380 --> 00:16:30,580
إننا نعرف بالفعل بأن كلاكما جديران بالثقة

218
00:16:35,440 --> 00:16:37,480
يتوجّب علينا الذهاب

219
00:16:37,520 --> 00:16:39,140
علينا التجهيز لتوصيلات الغدّ

220
00:16:39,860 --> 00:16:41,260
شكرًا على كلّ شيء

221
00:16:41,280 --> 00:16:44,820
إطلاقًا. لا يزالان يملكان حياتهما بأكملها أمامهما

222
00:16:44,860 --> 00:16:46,060
...في أحد الأيّام، أنا متأكدٌ بأن يابوكي-كن سوف

223
00:16:48,600 --> 00:16:50,930
فلنذهب يا نوريكو-
حاضر-

224
00:16:52,220 --> 00:16:54,450
...أنا شاكرٌ لما فعلَته نوري-تشان، لكن

225
00:16:55,140 --> 00:16:58,960
بإمكان نيشي أن يقوم بما يشاء، لكن
أنا لن أذهب إلى متجر هاياشي

226
00:16:59,000 --> 00:17:01,040
هل تسمعني؟ يستحيل ذلك

227
00:17:01,780 --> 00:17:03,080
...وأيها المسنّ

228
00:17:03,420 --> 00:17:08,130
لقد كان ذلك الكلام عن إغلاق النادي
،وتقاعدي دعابة مزعجة قليلًا

229
00:17:08,180 --> 00:17:11,330
لكن سأتغاضى عنها لليلة

230
00:17:11,360 --> 00:17:12,300
سأذهب إلى الفراش

231
00:17:13,840 --> 00:17:15,370
لقد كان يومًا طويلًا

232
00:17:25,400 --> 00:17:26,760
نادي شيراكي للمُلاكمة؟

233
00:17:26,760 --> 00:17:27,760
أتساءل ما هي؟

234
00:17:33,180 --> 00:17:34,860
...كارلوس ريفيرا

235
00:17:35,940 --> 00:17:37,830
صحيح. إنه الرجل الذي جلبته يوكو

236
00:17:41,300 --> 00:17:42,840
مساء الخير يا جماهير المُلاكمة

237
00:17:43,220 --> 00:17:45,470
تعقد الليلة المُباراة المُرتقبة بحماس

238
00:17:45,500 --> 00:17:48,310
والتي هي المباراة الأولى للمُلاكم المُصنّف
عالميًّا منذ وصوله إلى اليابان

239
00:17:48,380 --> 00:17:51,840
،خصمه هو المصنّف ثانيًا على اليابان في فئة وزن الديك

240
00:17:51,880 --> 00:17:54,630
سيُقاتِل نانغو كوجي في الحلبة وهو في أفضل حالاته

241
00:17:54,680 --> 00:17:57,920
إنها مُباراةٌ بِيعتْ كافّة تذاكرها والحشد ينتظر ظهور الملاكمان الاثنان

242
00:17:58,400 --> 00:18:00,130
كارلوس، هل أنت مستعدّ؟

243
00:18:00,200 --> 00:18:01,730
نعم يا روبرت

244
00:18:01,800 --> 00:18:03,140
!حسنٌ، فلنذهب

245
00:18:14,500 --> 00:18:17,460
حدَث اليوم الرئيسي على وشك أن يبدأ. أرجوكم أسرعوا

246
00:18:30,920 --> 00:18:32,600
شكرًا على الدعوة

247
00:18:32,640 --> 00:18:34,050
لقد كنتُ متفرّغًا، لذا أتيتُ للمشاهدة

248
00:18:35,560 --> 00:18:39,720
في الزاوية الحمراء، المصنَّف سادسًا
،على العالم في فئة وزن الديك

249
00:18:39,780 --> 00:18:42,170
!كارلوس ريفيرا

250
00:18:44,820 --> 00:18:49,170
بخصوص كارلوس ريفيرا، الرجل
...الذي جلبتِه من جنوب أمريكا

251
00:18:49,640 --> 00:18:51,060
ثمة شيءٌ ما أرغب بسؤالكِ عنه

252
00:18:52,060 --> 00:18:52,860
هل هو قويّ؟

253
00:18:53,720 --> 00:18:54,380
نعم، إنّه قويّ

254
00:18:55,720 --> 00:18:57,280
مثل ريكيشي؟

255
00:18:58,420 --> 00:18:59,280
لا أدري

256
00:19:10,720 --> 00:19:12,700
لقد بدأتْ الجولة الأولى

257
00:19:13,000 --> 00:19:16,680
تونو-سان، هل تتفق معي بأن أكثر جزءٍ
مثيرٍ للاهتمام في مباراة الليلة

258
00:19:16,760 --> 00:19:18,650
هو معرفة مقدار المدى الذي سيقطعه
نانغو ضدّ ملاكمٍ مصنَّف عالميًا؟

259
00:19:18,820 --> 00:19:20,410
ذلك صحيحٌ تمامًا

260
00:19:27,380 --> 00:19:28,400
ماذا—؟

261
00:19:28,480 --> 00:19:31,000
بالنسبة لملاكم مصنَّف عالميًّا، إنه لا يُقاوم كثيرًا

262
00:19:33,060 --> 00:19:35,620
هل هو جادّ؟
لكماته ليست سريعة

263
00:19:38,180 --> 00:19:38,850
!حسنٌ

264
00:19:41,460 --> 00:19:44,220
،ينهال نانغو على كارلوس باللكمات
!يُهيمن عليه ويدفعه إلى الحِبال

265
00:19:49,860 --> 00:19:51,800
!أحسنت يا نانغو! تابع على هذا المنوال

266
00:19:51,860 --> 00:19:52,400
!اذهب! اذهب

267
00:19:55,220 --> 00:19:56,500
...هذا بالأحرى

268
00:19:56,520 --> 00:20:00,300
،"إنه معروفٌ بكونه "الإمبراطور الغير متوَّج
لكنني بدأتُ أشكُّ في ذلك

269
00:20:02,060 --> 00:20:04,250
!كلا يا كارلوس! كلا

270
00:20:04,500 --> 00:20:06,760
ما الذي يجري؟ كيف يكون يملك تصنيفًا عالميًّا؟

271
00:20:06,820 --> 00:20:08,400
!أحسنت يا نانغو

272
00:20:08,460 --> 00:20:09,760
!سوف تصبح ذا تصنيفٍ عالميّ

273
00:20:15,800 --> 00:20:16,650
!توقفا

274
00:20:16,960 --> 00:20:18,160
!أحسنتَ عملًا

275
00:20:19,700 --> 00:20:22,690
حسنٌ يا نانغو. أنهِ أمره في الجولة القادمة

276
00:20:22,760 --> 00:20:25,010
نفدت قدرة تحمّله

277
00:20:25,600 --> 00:20:27,010
!أصغِ، هذه فرصتك

278
00:20:27,040 --> 00:20:30,580
إذا حصلت على تصنيفٍ عالميّ، فسيصبح حُلمك
!بأن تُصبح حامِل لقب قريبًا من المُنال

279
00:20:35,460 --> 00:20:38,700
!حسنٌ يا كارلوس. اذهب في الجولة القادمة

280
00:21:02,360 --> 00:21:05,060
ما الذي حدث للتوّ يا تونو-سان؟

281
00:21:05,300 --> 00:21:07,040
...حـ - حظّ

282
00:21:07,100 --> 00:21:10,280
...بإمكاني فقط بأن أصِفها بلكمة حظّ

283
00:21:11,580 --> 00:21:14,610
!يا لحظّي! محظوظ! محظوظ

284
00:21:15,340 --> 00:21:18,290
!مُحالٌ أن يكون ذلك حظًّا
.لقد رأيتُ ما حصل

285
00:21:18,700 --> 00:21:20,180
،بعدَ تلك اللكمة المبدئيّة

286
00:21:20,220 --> 00:21:24,760
جعلَ ذراعه تنساب إلى الداخل و وجّهَ ضربة
أخرى على البقعة ذاتها بواسطة مرفقه

287
00:21:25,820 --> 00:21:27,330
كارلوس ريفيرا؟

288
00:21:31,860 --> 00:21:33,330
!ذلك اللقيط