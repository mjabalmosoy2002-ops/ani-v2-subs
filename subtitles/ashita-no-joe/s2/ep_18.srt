1
00:00:05,300 --> 00:00:06,960
ما تلك يا جو؟

2
00:00:08,840 --> 00:00:11,550
ما تلك الكدمات التي على كتفيك؟

3
00:00:59,010 --> 00:01:00,520
...فهمت

4
00:01:00,520 --> 00:01:03,980
يبدو بأن خوسي ميندوزا قد تركَ لي هديّة

5
00:01:05,310 --> 00:01:08,400
حتمًا بأن بطل العالم يعرف
كيف يترك انطباعًا

6
00:01:11,860 --> 00:01:13,400
إن تلك الكدمات استثنائيّة

7
00:01:13,400 --> 00:01:14,570
...ذلك مذهل

8
00:01:14,570 --> 00:01:20,080
،بدا كما لو كأنّه لمس كتفيك بخفّة
لكنّه جعلك مليئًا بالكدمات

9
00:01:20,080 --> 00:01:24,540
يبدو بأن ذلك الرجل المدعوّ بخوسي
ليس ملاكمًا عاديًّا

10
00:01:33,470 --> 00:01:38,180
،على الأغلب، إنه رجلٌ ذو كبرياء
...ذلك الخوسي ميندوزا

11
00:01:39,220 --> 00:01:41,930
،عندما غلبَ كارلوس ريفيرا

12
00:01:41,930 --> 00:01:46,850
الجميع ركزوا على أنّ كارلوس قد كان مُحطّمًا
مُسبقًا جرَّاء مباراته الآنفة ضدّك

13
00:01:46,850 --> 00:01:48,190
أنا متأكدٌ بأنّ ذلك لم يرق له

14
00:01:48,690 --> 00:01:53,150
لعل ذلك هو سبب قطعه
طريقًا طويلًا من أجل رؤيتك

15
00:01:53,990 --> 00:01:56,240
لكي يُقيِّمني كـمُلاكم؟

16
00:01:56,240 --> 00:01:57,490
نعم

17
00:01:57,490 --> 00:02:00,330
لو كان لديّ وقتٌ أكثر، لكنتُ جعلتُه يرى

18
00:02:04,160 --> 00:02:05,540
حظًّا طيبًا

19
00:02:22,300 --> 00:02:25,480
لو كنتُ أنا، لما كنتُ تكبّدتُ عناء ترك
علامة على الكتف

20
00:02:25,480 --> 00:02:29,440
بل لكنتُ لكمتُه على أنفه مباشرةً

21
00:02:31,480 --> 00:02:32,770
حسنٌ أيها المسنّ

22
00:02:32,780 --> 00:02:34,360
طابت ليلتك

23
00:02:40,100 --> 00:02:42,740
هل هناك أيّ أخبار عن مكان تواجد البطل حاليًّا؟

24
00:02:42,740 --> 00:02:44,040
نعم

25
00:02:44,040 --> 00:02:46,910
لقد كان محروسًا بواسطة موظفين
تابعين للسفارة المكسيكية

26
00:02:46,910 --> 00:02:50,000
وتخلّص من الصحفيين عن طريق
تبديل السيارات عدّة مرّات

27
00:02:50,000 --> 00:02:54,590
أخشى بأننا قد فقدنا أثره كليًّا

28
00:02:54,590 --> 00:02:57,950
،نحن الآن في المطار برفقة الصحفيين

29
00:02:57,950 --> 00:03:00,110
لكن ليس هناك أيّ أثرٌ لمجيئه

30
00:03:00,590 --> 00:03:02,600
فهمت. شكرًا لك

31
00:03:02,600 --> 00:03:04,970
لو تغيّر أي شيء، فأرجوك بلغّني حالا

32
00:03:04,970 --> 00:03:06,470
مفهوم

33
00:03:22,660 --> 00:03:23,660
...أنت

34
00:03:29,160 --> 00:03:31,250
جيّدٌ جدًا. أقبل بذلك

35
00:03:32,000 --> 00:03:33,710
حسنٌ، اركبي

36
00:03:34,650 --> 00:03:35,710
إننا لا نملك متسعًا من الوقت

37
00:03:40,930 --> 00:03:42,550
لماذا؟

38
00:03:42,550 --> 00:03:46,260
لأن خوسي سيغادر مطار ناريتا
عند الساعة 2:15 مساءًا

39
00:03:46,270 --> 00:03:50,730
في الوقت الحالي، إنه يستمتع بإقامته في اليابان
برفقة عائلته في فندقٍ بالقرب من المطار

40
00:03:50,730 --> 00:03:52,270
إذن فأنت مخطئ

41
00:03:52,270 --> 00:03:54,440
لقد قمتُ مسبقًا بإرسال
عدّة أشخاص إلى المطار

42
00:03:54,440 --> 00:03:59,190
،لقد تحققوا بالفعل من قوائم جميع الركّاب
لكنّهم لم يعثروا على اسمه

43
00:04:01,990 --> 00:04:04,620
خوسي ميندوزا هو بطل المكسيك القوميّ

44
00:04:04,620 --> 00:04:08,110
بدلا من رحلة إعلانية، فإنه سيغادر على
متن طيّارة خاصة أعدّتها له السفارة

45
00:04:08,150 --> 00:04:10,390
...طيّارة خاصّة.. فهمت

46
00:04:10,390 --> 00:04:15,840
شيراكي-سان، تحاجين إلى ما هو أكثر من المال
والسلطة لاكتشاف الحقيقة في بعض الأحيان

47
00:04:15,840 --> 00:04:18,460
القليل من الخبرة والذكاء يقطعان طريقًا طويلا

48
00:04:26,850 --> 00:04:29,720
يقيم خوسي وعائلته
في الغرفة رقم 2501

49
00:04:29,720 --> 00:04:31,350
إنها جناحٌ ملكيّ على الطابق الأعلى

50
00:04:31,770 --> 00:04:34,100
هذا أبعد ما يمكنني قطعه

51
00:04:34,100 --> 00:04:37,320
رؤية خوسي من عدمها سوف تعتمد عليكِ

52
00:04:37,320 --> 00:04:43,280
ففي النهاية، حتى أنا لا أستطيع اقتحام غرفةٍ
للشخصيّات الهامّة يحرسونها موظفيّ السفارة

53
00:05:16,400 --> 00:05:19,360
!تشيلسي! أحسن التصرّف! كلا

54
00:05:45,880 --> 00:05:47,340
شكرًا يا آنسة

55
00:05:47,340 --> 00:05:48,890
أنت على الرحب والسعة

56
00:05:48,890 --> 00:05:50,610
أنا يوكو شيراكي

57
00:05:50,610 --> 00:05:52,570
يوكو شيراكي؟

58
00:05:52,570 --> 00:05:55,030
نعم، وأنت؟

59
00:05:56,600 --> 00:05:57,900
أنا تشيلسي

60
00:05:58,690 --> 00:06:01,130
!يوكو! تعالي معي

61
00:06:01,130 --> 00:06:02,110
هذا أبي

62
00:06:02,110 --> 00:06:03,940
إنه بطل العالم

63
00:06:06,110 --> 00:06:07,570
نعم، أعرف

64
00:06:07,570 --> 00:06:09,890
إن والدك بطلٌ قويٌّ بحقّ

65
00:06:11,740 --> 00:06:14,660
سيّد ميندوزا، أنا سعيدةٌ بلقائك

66
00:06:15,210 --> 00:06:17,710
سيّدة ميندوزا، مرحبًا بكِ في اليابان

67
00:06:17,710 --> 00:06:19,130
كيف حالكِ؟

68
00:06:36,600 --> 00:06:37,940
إنه يحبّ عائلته كثيرًا

69
00:06:38,270 --> 00:06:40,900
إنه رجلٌ هادئ مع سلوكٌ لطيف

70
00:06:40,900 --> 00:06:44,360
،استنادًا على سلوكه اللطيف وذكائه
فلن تحزر أبدًا بأنه ملاكم

71
00:06:44,360 --> 00:06:49,360
إنه يحاول أن يغدو الرجل المثاليّ
بينما هو البطل المثاليّ

72
00:06:51,950 --> 00:06:56,500
ولقد قطعَ ذلك البطل المثالي المحيط
فقط لرؤية ملاكم دمويّ

73
00:06:56,500 --> 00:06:57,360
لماذا؟

74
00:06:57,410 --> 00:07:01,380
لقد سألته السؤال ذاته

75
00:07:01,930 --> 00:07:04,840
لكنه لم يُجِب

76
00:07:05,250 --> 00:07:07,800
لقد ابتسم بهدوءٍ فحسب

77
00:07:07,800 --> 00:07:10,800
،ثمّ، عندما اقترب وقت رحلتهم

78
00:07:10,800 --> 00:07:15,220
،وتمامًا عندما كانوا عائدين إلى غرفتهم
:قال لي التالي

79
00:07:15,220 --> 00:07:20,190
،جو يابوكي، من أين أتى
وإلى أين هو ذاهب؟

80
00:07:23,150 --> 00:07:26,610
من أين أتى، وإلى"
"أين هو ذاهب؟

81
00:07:26,610 --> 00:07:29,740
نعم، ذلك ما قاله بالضبط

82
00:07:29,740 --> 00:07:31,490
فهمت

83
00:07:31,490 --> 00:07:33,490
ذلك يجعلكِ تتساءلين، أليس كذلك؟

84
00:07:39,490 --> 00:07:40,930
!حسنٌ! مرّة واحدة أخرى

85
00:07:40,960 --> 00:07:42,330
!حسنٌ

86
00:07:44,970 --> 00:07:46,610
!انعطِف

87
00:07:51,760 --> 00:07:52,930
!حافظ على سرعتك

88
00:07:54,820 --> 00:07:57,280
!جيّد! توجّه يسارًا ثمّ يمينًا

89
00:08:14,700 --> 00:08:16,120
...بالمناسبة أيها المسنّ

90
00:08:18,250 --> 00:08:20,040
ماذا حصل مع المفاوضات مع بطل
الملاكمة الشرقية؟

91
00:08:20,620 --> 00:08:22,620
غلبتُ الملاكم المصنّف ثالثًا على
الملاكمة الشرقية في اليوم الآنف

92
00:08:22,620 --> 00:08:25,000
لديّ المؤهلات التي تسمح لي
بتحدّيه الآن، صحيح؟

93
00:08:25,000 --> 00:08:27,460
لقد قلتُ لك بالفعل

94
00:08:27,460 --> 00:08:31,420
.لقد غلبتَ أولئك الرجال بسهولة شديدة
لذلك البطل خائفٌ منك

95
00:08:32,180 --> 00:08:35,890
إنه يهرب جرَّاء الخوف، لذا لا يمكنني
أن أقابله حتّى لكي أتفاوض بشأن المباراة

96
00:08:35,890 --> 00:08:39,430
لكنني تلقيتُ ردًّا إيجابيًّا من المصنّف
ثانيًا على الملاكمة الشرقيّة

97
00:08:39,430 --> 00:08:41,390
!المصنّف الثاني؟ لا بدّ بأنك تمازحني

98
00:08:41,390 --> 00:08:44,770
ماذا ستفعل لو تقاعد خوسي بينما أنا
أضيِّع وقتي في هزيمة الصعاليك؟

99
00:08:44,770 --> 00:08:47,190
!أنا أقول لك! ثمّة ترتيبٌ للأمور

100
00:08:47,190 --> 00:08:49,320
!إنني أتفهّمُ شعورك. أنا حقًّا أفهمك

101
00:08:49,320 --> 00:08:50,860
لكنك بحاجةٍ إلى بناء مقوّماتك"، صح؟"

102
00:08:50,860 --> 00:08:53,450
،ذلك صحيح! إذا كنتَ تعرف ذلك
!فإذن اخرس واركض

103
00:08:53,450 --> 00:08:54,790
!هيّا! واحد، اثنان

104
00:09:04,540 --> 00:09:05,790
!جو

105
00:09:06,000 --> 00:09:07,290
نعم، ماذا؟

106
00:09:07,290 --> 00:09:09,500
!أنا خارج

107
00:09:09,500 --> 00:09:10,690
!نعم، حسنٌ

108
00:09:23,190 --> 00:09:28,310
،جو يابوكي، من أين أتى"
"وإلى أين هو ذاهب؟

109
00:09:28,970 --> 00:09:29,830
ماذا قلت؟

110
00:09:30,610 --> 00:09:33,030
ذلك ما قاله خوسي قبل مغادرته اليابان

111
00:09:33,030 --> 00:09:41,870
،جو يابوكي، من أين أتى"
"وإلى أين هو ذاهب؟

112
00:09:46,960 --> 00:09:49,380
إن البطل رجلٌ مذهل

113
00:09:50,670 --> 00:09:54,920
لقد اكتشفَ مزاياك كمُلاكم
بمحض لمحة واحدة

114
00:09:54,930 --> 00:09:56,840
مزايايّ؟

115
00:09:56,840 --> 00:09:58,850
حتى أنا لا أعرف ما هي مزايايّ

116
00:09:58,850 --> 00:10:00,140
مع أنني أودّ بكلّ تأكيد معرفتها

117
00:10:00,140 --> 00:10:05,390
،جو يابوكي، من أين أتى"
"وإلى أين هو ذاهب؟

118
00:10:05,390 --> 00:10:07,940
من أين أتيت وإلى أين أنت ذاهب؟

119
00:10:07,940 --> 00:10:12,110
بمعنًى آخر، إنه يقول، "منشأك
"ووجهتك لغز

120
00:10:12,110 --> 00:10:15,280
بمعنًى آخر، إنه يقول بأنك رجلٌ
من دون أصول

121
00:10:15,280 --> 00:10:19,240
،إنك لا تملك مكانًا حقيقيًّا تدعوه بالمنزل
ولا أنتَ تملك أيّ عائلة

122
00:10:21,350 --> 00:10:23,010
لقد اكتشفَ كلّ ذلك

123
00:10:24,050 --> 00:10:26,330
إذن؟ وماذا إن فعل؟

124
00:10:26,330 --> 00:10:29,290
لهذا السبب إنه يتساءل
إلى أين أنت ذاهب

125
00:10:29,290 --> 00:10:32,300
"رجلٌ مثلك سوف يتحدّاني؟"

126
00:10:32,300 --> 00:10:35,470
"من أجل ماذا؟ لا تضيِّع وقتك"

127
00:10:35,470 --> 00:10:38,050
على الأرجح بأن ذلك ما عناه
عندما قال ذلك

128
00:10:39,180 --> 00:10:42,010
هل تقول بأنه لن يقبل تحدي من رجل
لا يعرف أصوله؟

129
00:10:42,470 --> 00:10:45,970
كلا، كلامه نابعٌ من ثقته بنفسه. بأنّه لن يخسر
ضد رجل لا يعرف أصوله

130
00:10:45,980 --> 00:10:50,310
فهو ليس فقط بطل، لكنه أيضًا يحب
عائلته وبلاده

131
00:10:50,310 --> 00:10:53,480
بناءً على انطباعي عنه، إنه محبّ
للكمال من كافّة النواحي

132
00:10:53,900 --> 00:10:59,280
إن رجلا يملك ذلك النوع من الثقة بالنفس
أشبه بجبلٍ كبيرٍ منيع

133
00:11:00,070 --> 00:11:01,910
لا تُضحكني

134
00:11:01,910 --> 00:11:04,540
أنا أماثله بالثقة بالنفس

135
00:11:04,540 --> 00:11:08,580
!أيضًا، باستطاعة رجل بدون أصول أن يذهب إلى أي مكان

136
00:11:08,580 --> 00:11:10,580
!حتى أنه بإمكاني الذهاب إلى المكسيك الآن

137
00:11:13,920 --> 00:11:16,050
لكنني أظن بأن ذلك لا يهمّ

138
00:11:16,920 --> 00:11:19,970
على كلٍّ، أولا علي إنهاء
المُهمّة الراهنة

139
00:11:22,510 --> 00:11:24,310
بصراحة، أنا محبطٌ قليلا

140
00:11:24,310 --> 00:11:27,850
إن بطل الملاكمة الشرقيّة يخشى
قتالي، لذا فهو يرفضُ قبول تحديَّ

141
00:11:28,440 --> 00:11:30,480
أول مرة أسمع بهذا

142
00:11:30,510 --> 00:11:32,820
هل نحن نتحدث عن بطل الملاكمة
الشرقية، كيم ريوهي؟

143
00:11:32,820 --> 00:11:36,280
نعم، لا أعرف اسمه، لكن على
الأرجح بأن ذلك هو

144
00:11:36,280 --> 00:11:38,280
هذا غير منطقيّ

145
00:11:38,280 --> 00:11:40,990
البطل كيم ريوهي ليس جبانًا

146
00:11:42,620 --> 00:11:45,950
في الواقع، إنه حاليا في اليابان من أجل مباراة

147
00:11:45,950 --> 00:11:48,080
إنه يقيم جلسة مباراة تدريبية
علنية اليوم

148
00:11:49,290 --> 00:11:50,010
ماذا؟

149
00:12:43,450 --> 00:12:45,110
!كيم! تبقّت ثلاث ثوانٍ

150
00:12:51,930 --> 00:12:52,990
!حسنٌ يا كيم

151
00:13:03,450 --> 00:13:05,660
!أحضر نقّالة أخرى، بسرعة

152
00:13:05,660 --> 00:13:07,080
أحسنتَ عملا يا كيم

153
00:13:07,080 --> 00:13:10,410
ملاكمٌ من مستواه يتطلّب
فقط بضع لكمات

154
00:13:10,410 --> 00:13:12,790
على الأرجح بأنه كان في وسعك قمع قوتك أكثر حتّى

155
00:13:12,790 --> 00:13:13,630
نعم

156
00:13:19,190 --> 00:13:21,550
...اعذرني يا جودال هيون

157
00:13:21,550 --> 00:13:22,300
نعم؟

158
00:13:22,300 --> 00:13:24,970
هذا ثاني ملاكمٍ من ملاكميني يؤول
به المآل على نقّالة

159
00:13:24,990 --> 00:13:27,470
هل باستطاعتك التساهل معهم قليلا؟

160
00:13:27,470 --> 00:13:30,020
فكّر أكثر قليلا بشأن رجالي

161
00:13:30,020 --> 00:13:32,310
...نحن نتساهل معهم، لكن

162
00:13:32,350 --> 00:13:34,710
حسنٌ يا أوتاكا-سان. سوف نتساهل
معهم أكثر حتى

163
00:13:34,730 --> 00:13:37,690
جيّد، ما دمتَ تعي الأمر

164
00:13:37,690 --> 00:13:39,900
حسنٌ إذن، أرجوك جهّز خصمه المُقبل
للمباراة التدريبية حالا

165
00:13:41,280 --> 00:13:42,110
...طبعًا

166
00:13:50,750 --> 00:13:53,250
...لديه نظرة غريبة في عينيه

167
00:13:53,830 --> 00:13:55,710
كأنما عينيه مثبّته على شيءٍ ما

168
00:13:56,420 --> 00:13:59,170
عينيه لا تملكان لا نارٍ ولا دفء

169
00:13:59,170 --> 00:14:01,170
...يا لها من تحديقةٍ غير مُريحة

170
00:14:03,050 --> 00:14:04,510
الآن فهمت

171
00:14:04,510 --> 00:14:06,640
إنه يملك عينيّ دُمية

172
00:14:06,640 --> 00:14:10,560
،إنه يملك عينان تتحرّكان ميكانيكيًّا
لكن ليس هناك مشاعر خلفهما

173
00:14:11,300 --> 00:14:12,320
...صحيح

174
00:14:12,640 --> 00:14:15,560
إنه يملك عينان زجاجيّتان كدُمية

175
00:14:19,970 --> 00:14:23,430
...يبدو بأن حدسي قد كان مُصيبًا

176
00:14:34,790 --> 00:14:36,770
!هيون! أرجوك حافظ على وعدك

177
00:14:49,990 --> 00:14:51,250
!أيها المسنّ

178
00:14:52,470 --> 00:14:53,210
!جو

179
00:14:55,270 --> 00:14:56,930
!ما معنى هذا؟

180
00:14:56,950 --> 00:14:59,170
واصلت الحديث عن أنك لا تستطيع
،التواصل مع بطل الملاكمة الشرقيّة

181
00:14:59,170 --> 00:15:01,750
!لكن ما الذي يفعله في اليابان إذن؟

182
00:15:01,770 --> 00:15:05,710
حتى بأنك ذهبت لرؤية مباراته
!التدريبيّة العلَنيّة من دون إخباري؟

183
00:15:06,450 --> 00:15:08,170
!هيّا، أخبرني بما يحصل

184
00:15:12,650 --> 00:15:13,890
!انتظر يا جو

185
00:15:14,130 --> 00:15:16,930
لقد انتهت! لقد انتهت مباراة كيم
!ريوهي التدريبيّة بالفعل

186
00:15:16,930 --> 00:15:18,190
!اتركني

187
00:15:18,190 --> 00:15:19,910
!لا أكترث بشأن مباراته التدريبيّة

188
00:15:19,930 --> 00:15:22,030
!أريد التحدّث مع ذلك الجبان

189
00:15:22,030 --> 00:15:23,490
!إنه ليس هناك يا جو

190
00:15:23,490 --> 00:15:25,990
لقد ذهبَ كيم بالفعل إلى مهجع
!الرياضيين! إنه ليس هنا

191
00:15:25,990 --> 00:15:28,490
!يُستحسن بك ألا تكون تكذب-
!ذلك صحيح! أنا لا أكذب-

192
00:15:29,170 --> 00:15:30,790
إنهما الرئيس تانجي ويابوكي

193
00:15:30,830 --> 00:15:31,990
ما الذي يفعلانه؟

194
00:15:31,990 --> 00:15:33,710
على كلٍّ، اهدئ يا جو

195
00:15:33,750 --> 00:15:38,490
فلنُناقش الأمر. هيا، فلنذهب
لشرب بعض القهوة.. هيا

196
00:15:40,470 --> 00:15:42,510
!هنا! فلندخل هنا

197
00:15:42,510 --> 00:15:43,950
!كلا، لا أريد قهوة

198
00:15:43,950 --> 00:15:45,790
إذن ما رأيك بتناول شيء؟

199
00:15:45,790 --> 00:15:47,530
إنك لم تأكل بعد، صح؟

200
00:15:47,530 --> 00:15:48,170
!أنا لست جائعًا

201
00:15:48,170 --> 00:15:51,310
على كلٍّ، اهدئ وفلنُناقش هذا

202
00:15:51,310 --> 00:15:52,810
لقد سمعت شيئًا مثيرًا للاهتمام

203
00:15:52,810 --> 00:15:57,410
ذلك البطل كيم ريوهي ليس من صنف
الرجال الذين قد يرفضون تحديّ

204
00:15:58,570 --> 00:16:00,870
من قال لك ذلك الهُراء؟

205
00:16:00,870 --> 00:16:02,290
،لا أعرف من قال لك ذلك

206
00:16:02,310 --> 00:16:05,610
لكن هل سيقول من في كامل صوابه
بأنه يتفاداك بصوتٍ عالٍ؟

207
00:16:06,950 --> 00:16:07,910
...فقط قبل قليل يا جو

208
00:16:07,950 --> 00:16:11,270
فقط قبل قليل، تحدّثتُ لمدير أعمال كيم

209
00:16:11,270 --> 00:16:14,030
لقد رفضَ مجددًا. أنا أقول لك الحقيقة

210
00:16:14,030 --> 00:16:17,030
لقد أخافته سمعتك بحقّ

211
00:16:18,550 --> 00:16:23,330
لكن لعلنا سنتمكن من تغيير رأيه
أثناء مكوثه في اليابان

212
00:16:23,330 --> 00:16:25,830
فقط اترك كل شيءٍ لي، حسنٌ؟

213
00:16:27,170 --> 00:16:29,970
حسنٌ إذن، سأزور مكان إقامته وأحاول
التفاوض على صفقةٍ مجددًا

214
00:16:29,970 --> 00:16:31,890
سألقاك في المنزل

215
00:16:31,890 --> 00:16:34,470
اجلب معك أنباءً جيدة، حسنٌ؟-
نعم، سأبذل قصارى جهدي-

216
00:16:38,550 --> 00:16:43,070
لقد قِيل لنا بأنك نادرًا ما تُغادر كوريا
الجنوبيّة من أجل خوض مباراة

217
00:16:43,070 --> 00:16:46,230
لذا ما الذي يميّز هذه المباراة وجلبكَ
هنا إلى اليابان؟

218
00:16:46,230 --> 00:16:48,810
لا يوجد سبب معيّن

219
00:16:48,810 --> 00:16:51,850
خصمك، كينموتشي، هو ملاكمٌ
ينتمي لفئة الوزن الخفيف

220
00:16:51,850 --> 00:16:54,570
لماذا اخترت قتال ملاكم
يفوقك بدرجتيّ وزن؟

221
00:16:54,570 --> 00:16:56,470
الأمر بسيط

222
00:16:56,470 --> 00:16:59,570
لأنّ لكمة كيم تُماثِل ثُقل لكمة
ملاكم ينتمي للوزن الخفيف

223
00:17:00,630 --> 00:17:02,030
لقد كانت مفاجئة كُليّة

224
00:17:02,030 --> 00:17:06,010
لم أتخيل قطّ بأن كيم ريوهي
سيأتي إلى اليابان

225
00:17:07,130 --> 00:17:09,010
والآن أنا متورّط

226
00:17:09,010 --> 00:17:14,470
دعيني أشرح سبب تفاديَّ لمباراة بين جو
وكيم ريوهي، بطل الملاكمة الشرقيّة

227
00:17:15,150 --> 00:17:19,930
عدا عن حقيقة أنّه لا يزال الوقت مبكّرا
...كثيرًا على تحدّي بطل الملاكمة الشرقيّة

228
00:17:20,970 --> 00:17:23,570
لكن هذا هو السبب الحقيقيّ

229
00:17:23,630 --> 00:17:25,970
لم أُري جو هذه الرسالة بعد

230
00:17:26,490 --> 00:17:29,970
لكنها تنصّ على أن كيم مستعدٌّ لقبول
تحدّي يابوكي جو في أيّ وقت

231
00:17:30,090 --> 00:17:31,970
لقد أُرسلتْ من طرف فريق كيم

232
00:17:33,080 --> 00:17:39,460
حقيقةً، لقد تلقّيتُ هذه الرسالة قبل أن
يمضي أسبوعٌ حتى على مباراته ضدّ كارلوس

233
00:17:39,540 --> 00:17:41,460
فهمت، إذن قبل ثلاثة أشهر؟

234
00:17:41,460 --> 00:17:46,620
لذا، تقصيّتُ خفيةً عن هويّة
المُلاكِم كيم ريوهي

235
00:17:46,780 --> 00:17:48,620
وأصابني ما توصّلتُ إليه بالقشعريرة

236
00:17:48,700 --> 00:17:52,520
لأنني مهما بحثتُ بجدّ، لم أستطِع
معرفة شيءٍ عنه

237
00:17:52,520 --> 00:17:56,000
لكن ما عرفتُه هو بأنه انتصر بكافة
مبارياته الخمسة باللكمة القاضية

238
00:17:56,000 --> 00:17:58,260
وبأنّ اثنين من خصومه متوفيين

239
00:18:00,620 --> 00:18:03,780
الأمر لا يتعلّق بفوز أو خسارة جو

240
00:18:03,780 --> 00:18:10,600
إنني فقط لم أُرِد أن أجعل جو
يقاتِل ملاكمًا يملك ماضيًا مظلمًا مثله

241
00:18:10,860 --> 00:18:17,480
لقد وصل جو أخيرًا إلى نقطةٍ حيث
يتوجّب عليه أن يُثبتْ ويُحسِّن من نفسه

242
00:18:17,480 --> 00:18:19,780
لقد تملَّكني شعورٌ سيّئٌ حيال هذا
فحسب أيتها الآنسة

243
00:18:19,780 --> 00:18:24,540
أخشى بأن يهوي جو إلى هاوية مظلمة مجددًا

244
00:18:25,400 --> 00:18:29,240
وبعدما رأيتُ اليوم كيم
،ريوهي بأمّ عينيّ

245
00:18:29,240 --> 00:18:31,880
عرفتُ حينها بأنّ حدسي كان صائِبًا

246
00:18:32,950 --> 00:18:35,010
...لقد كانت نظرته مُريعة

247
00:18:36,370 --> 00:18:38,050
!إنني بحاجةٍ إلى طلب معروفٍ منكِ يا آنسة

248
00:18:38,050 --> 00:18:42,210
سأبذل ما بوسعي لتحاشي مباراةٍ بينهما

249
00:18:42,210 --> 00:18:43,890
...لكن ما دامَ موجودًا في اليابان

250
00:18:43,890 --> 00:18:46,210
...كلا، ما دام قتال جو هو هدفه

251
00:18:46,210 --> 00:18:48,750
فإنني أحتاج إلى تحاشي هذا القتال
!بطريقةٍ ما مهما كلّف الأمر

252
00:18:49,410 --> 00:18:53,130
ومن أجل فعل ذلك، فإنني بحاجة إلى
،إلى معرفة معلومات أكثر عن كيم ريوهي

253
00:18:53,130 --> 00:18:55,490
!لئلا أخفق

254
00:18:57,410 --> 00:18:59,410
...أعرفُ بأنني أُطلب منكِ الكثير

255
00:19:00,210 --> 00:19:02,830
فهمت. أرجوك دع الأمر لي

256
00:19:02,830 --> 00:19:04,370
فهمت. شكرًا لكِ

257
00:19:15,010 --> 00:19:16,750
استغرقت وقتًا طويلًا أيها المسنّ

258
00:19:16,750 --> 00:19:18,090
هل فشلتْ المفاوضات مجددًّا؟

259
00:19:21,890 --> 00:19:24,550
لقد جمعتُ بعض المعلومات عن كيم أيضًا

260
00:19:24,550 --> 00:19:26,850
إنه يقاتل ضدّ ملاكمًا ينتمي لفئة
الوزن الخفيف يدعى بكينموتشي

261
00:19:26,890 --> 00:19:28,750
أليس شخصًا شجاعًا؟

262
00:19:28,750 --> 00:19:31,250
سوف يقاتل ملاكمًًا أثقل منه بفئتيّ وزن

263
00:19:31,250 --> 00:19:33,750
ذلك لا يبدو منطقيًّا، صحيح؟

264
00:19:33,750 --> 00:19:36,810
لماذا سيتحاشى رجلٌ مثله قتالي؟

265
00:19:36,810 --> 00:19:41,790
لقد قاتل كيم أيضًا ملاكمين ينتمون لفئة الوزن الأقل
من المتوسط في الماضي، وليس فقط ملاكمي الوزن الخفيف

266
00:19:44,210 --> 00:19:45,750
-لقد عدت

267
00:19:54,690 --> 00:19:56,470
لدينا ضيوف أيها المسنّ

268
00:19:56,470 --> 00:19:58,190
هل تعرف من هم؟
لأنني بكل تأكيدٍ لا أعرف

269
00:19:58,630 --> 00:20:00,810
لا تكتفي بالوقوف هناك واعرض لهم بعض الشاي

270
00:20:03,450 --> 00:20:08,690
تانجي-سان، لقد سمعنا بأنك كنت تنشر إشاعات
مفادها أن كيم يتحاشى يابوكي؟

271
00:20:08,690 --> 00:20:10,610
...حسنٌ

272
00:20:10,610 --> 00:20:12,870
كيم ريوهي ليس جبانًا

273
00:20:12,870 --> 00:20:16,230
حتّى أنه مستعدٌّ لقتال يابوكي غدًا

274
00:20:16,230 --> 00:20:17,690
أليس ذلك صحيحًا يا كيم؟

275
00:20:17,690 --> 00:20:20,110
نعم أيها العقيد

276
00:20:20,110 --> 00:20:22,450
في الواقع، بإمكاني قتاله
اليوم لو شاء ذلك

277
00:20:23,150 --> 00:20:25,910
يبدو بأن الأوضاع تتغيّر أيها المسنّ

278
00:20:27,090 --> 00:20:29,030
!اخرجا! غادرا

279
00:20:29,030 --> 00:20:31,490
!لن أسمح بهذه المباراة

280
00:20:31,490 --> 00:20:34,930
!غادر

281
00:20:32,210 --> 00:20:35,890
لا تلمسني

282
00:20:39,390 --> 00:20:40,210
!كيم

283
00:20:40,550 --> 00:20:41,510
!أيها المسنّ

284
00:20:46,270 --> 00:20:47,510
تعال يا كيم. سنغادر

285
00:20:51,150 --> 00:20:52,390
مهلا

286
00:20:52,390 --> 00:20:54,830
بطبيعة الحال، المباراة مؤكدة

287
00:20:54,830 --> 00:20:58,030
سأتحدى بسرور من أجل نيل لقب بطل
الملاكمة الشرقيّة الخاص بك

288
00:20:58,030 --> 00:21:00,490
...أيضًا، بخصوص لكمك للمسنّ

289
00:21:00,810 --> 00:21:02,450
!فسأُسوّي هذا الحساب الآن

290
00:21:04,070 --> 00:21:05,070
!تنحّ عن طريقي

291
00:21:09,730 --> 00:21:10,730
!أيها العقيد

292
00:21:11,350 --> 00:21:14,670
إننا نقبل تحدّيك يا يابوكي

293
00:21:14,670 --> 00:21:16,370
حسنٌ إذن، حتى حينئذٍ

294
00:21:16,730 --> 00:21:18,030
هيا يا كيم. سنغادر

295
00:21:18,070 --> 00:21:18,730
نعم

296
00:21:21,770 --> 00:21:23,010
!جو

297
00:21:23,770 --> 00:21:25,530
فات الأوان الآن أيها المسنّ

298
00:21:25,530 --> 00:21:28,170
لقد تأكّدتْ المباراة للتوّ