1
00:00:33,930 --> 00:00:36,720
جيّد، ينبغي أن يعودوا
في أيّ وقتٍ الآن

2
00:00:44,190 --> 00:00:46,190
!حسنٌ يا جو! اركض بأقصى سرعة

3
00:00:46,690 --> 00:00:47,900
!حاضر

4
00:01:14,390 --> 00:01:15,930
...إنه حقًّا مذهل

5
00:01:15,930 --> 00:01:17,850
يعطي شعورًا كأنّ المبنى يهتزّ
في كلّ مرةٍ يلكمُ فيها

6
00:01:22,100 --> 00:01:23,770
أيها البطل! انتهى الوقت

7
00:01:31,750 --> 00:01:32,950
تبدو بخير

8
00:01:32,950 --> 00:01:35,160
أنت بحالةٍ جيّدة كعادتك

9
00:01:35,910 --> 00:01:39,700
بإمكانك حتّى اعتلاء الحلبة الآن
وتستمرّ لعشرين جولة كاملة

10
00:01:50,760 --> 00:01:53,720
هلا انضممت لنا على العشاء في منزلي؟

11
00:01:54,180 --> 00:01:56,100
قال جدي بأنه يودّ لقائك

12
00:01:56,810 --> 00:01:57,850
سوف يسرّني ذلك

13
00:01:58,890 --> 00:02:00,310
،بالمناسبة، طبيب كينينسكي

14
00:02:01,060 --> 00:02:03,060
!لماذا لم تقل أي شيءٍ عنه؟

15
00:02:05,560 --> 00:02:10,690
أعي بأنك أتيت إلى اليابان بصفتك
،طبيب خوسي ميندوزا

16
00:02:10,690 --> 00:02:16,530
لكنك وعدتَ أيضًا بإعطائي إجابة
أكيدة بخصوص طلبي الآخر

17
00:02:17,080 --> 00:02:19,490
لقد مضى أسبوعين بالفعل منذ وصولك

18
00:02:19,490 --> 00:02:22,660
لماذا لم تقل شيئًا بعد؟

19
00:02:22,660 --> 00:02:27,460
.آنسة يوكو، أخبرتكِ عدّة مرات بالفعل
لم أصل بعد إلى استنتاجٍ أكيد

20
00:02:27,790 --> 00:02:31,590
لا أستطيع التأكد إلى أن أفحصه

21
00:02:32,760 --> 00:02:36,390
يستحيل عليّ أن أقوم بتشخيصٍ
بناءً على التوقّعات وحدها

22
00:02:37,100 --> 00:02:38,510
فهمت

23
00:02:38,510 --> 00:02:42,140
،لكنني بحاجة إلى أن أعرف على أي حال
حتّى ولو كان مجرّد توقّع

24
00:02:49,570 --> 00:02:51,150
!أرجوك يا طبيب

25
00:02:51,150 --> 00:02:54,360
إنّك لم تقُل شيئًا بشأنه منذّ
وصولك إلى اليابان

26
00:02:54,360 --> 00:02:58,990
ذلك وحده كافٍ لكي أعرف معنى ذلك

27
00:02:58,990 --> 00:03:01,410
حتّى ولو، لا زلتُ بحاجةٍ لسماعك تلفظها

28
00:03:01,590 --> 00:03:04,660
لكي أستطيع مواجهة هذه الحقيقة الكئيبة

29
00:03:04,660 --> 00:03:05,960
أنا أترجّاك أيها الطبيب

30
00:03:05,960 --> 00:03:08,170
أرجوك أخبرني بما تعرفه

31
00:03:09,040 --> 00:03:10,910
آنسة يوكو

32
00:03:10,970 --> 00:03:14,130
ما طبيعة علاقتكِ بجو يابوكي؟

33
00:03:19,220 --> 00:03:21,220
...فهمت

34
00:03:21,220 --> 00:03:23,520
لم أكُن أعرف ذلك

35
00:03:23,870 --> 00:03:25,140
سأُخبركِ إذن

36
00:03:25,140 --> 00:03:28,310
لكن أرجوكِ تفهّمي بأن هذا
مبنيٌّ على محض توقّعات

37
00:03:28,310 --> 00:03:34,990
،%حتّى لو كنتُ متيقّنًا بنسبة 99
فنسبة 1% المتبقية يمكن أن تغيّر كل شيء

38
00:03:37,450 --> 00:03:41,580
أنا متيقّنٌ بنسبة 99% بأنه
مصابٌ بمتلازمة اللكمة الثملة

39
00:03:41,580 --> 00:03:43,410
وإذا كان فعلا مصابٌ بها، فهي في
مرحلة متقدِّمة

40
00:03:53,590 --> 00:03:55,840
شكرًا لك أيها الطبيب

41
00:04:00,720 --> 00:04:05,720
أرجوك أخبرني بما يُمكنني القيام به
لأجل نسبة الـ1% المتبقية إذن

42
00:04:05,730 --> 00:04:07,020
ثمّة فقط شيءٌ واحد

43
00:04:07,020 --> 00:04:10,440
وذلك هو بأن تُتيحي لي فرصة
لكي أقوم بفحصه

44
00:04:10,440 --> 00:04:11,440
حسنٌ

45
00:04:21,950 --> 00:04:24,280
مرحبًا، نادي تانجي للملاكمة

46
00:04:24,330 --> 00:04:26,620
!مرحبًا

47
00:04:26,620 --> 00:04:27,750
نعم، إنه هنا

48
00:04:33,550 --> 00:04:36,630
!جو! لديك مكالمة من آنسة شيراكي

49
00:04:37,050 --> 00:04:38,170
حاضر

50
00:04:48,480 --> 00:04:49,520
ما الذي تفعلينه هنا؟

51
00:04:49,520 --> 00:04:52,310
،كان ينبغي عليكِ المجيء إلى النادي فقط
إذا كنتِ سوف تنتظرين هنا

52
00:04:52,310 --> 00:04:55,020
ما هو جدولك التدريبيّ بعد هذا؟

53
00:04:55,030 --> 00:04:57,230
النهاية" الشيء الوحيد المتبقي هو النوم"

54
00:04:57,240 --> 00:04:59,780
جيّد، يسرّني ذلك. أرجوك اركب

55
00:04:59,780 --> 00:05:02,070
هل تريدين الذهاب في نزهة أم شيءٌ من هذا القبيل؟

56
00:05:02,070 --> 00:05:04,030
أعتقد بأنه يمكنك قول ذلك. أرجوك اركب

57
00:05:05,730 --> 00:05:06,500
تفضّل

58
00:05:06,500 --> 00:05:10,460
حسنٌ، فلنذهب في نزهةٍ على الطريق
السريع ونحظى ببعض الهواء النقيّ

59
00:05:10,460 --> 00:05:11,670
طبعًا

60
00:05:19,190 --> 00:05:22,020
يتدرّب خوسي في ناديكِ، صح؟

61
00:05:22,430 --> 00:05:23,640
نعم

62
00:05:23,640 --> 00:05:25,640
هل كان هو الشخص الذي قال
بأنه يريد رؤيتي؟

63
00:05:25,640 --> 00:05:26,290
ماذا؟

64
00:05:26,970 --> 00:05:29,930
خوسي ينتظرني، صح؟

65
00:05:31,270 --> 00:05:32,230
إنه لا ينتظرني؟

66
00:05:32,230 --> 00:05:34,440
كلا، لقد طلبتُ منك أن ترافقني
في نزهة ذلك كل ما في الأمر

67
00:05:35,070 --> 00:05:36,900
كفّي عن المزاح

68
00:05:37,570 --> 00:05:40,360
ألا يمكنني أن أطلبُ منك مرافقتي
في نزهةٍ من دون سبب؟

69
00:05:46,330 --> 00:05:48,620
هل تدريبك يسير جيّدًا؟

70
00:05:52,750 --> 00:05:54,420
أرجوك، اشرب قهوتك

71
00:05:55,000 --> 00:05:55,920
نعم

72
00:05:56,380 --> 00:05:58,210
!عجبًا! يا لها من صدفة

73
00:05:58,210 --> 00:05:59,340
!الطبيب كينينسكي

74
00:05:59,340 --> 00:06:00,970
!آنسة يوكو

75
00:06:00,970 --> 00:06:02,340
لم أرك منذ زمنٍ طويل

76
00:06:02,340 --> 00:06:04,510
.آخر مرة التقينا كانت في لاس فيغاس
هل كنتَ بخير؟

77
00:06:04,510 --> 00:06:06,600
نعم، وأنا سعيدٌ لرؤيتكِ أيضًا يا آنسة يوكو

78
00:06:06,600 --> 00:06:08,220
أيها الطبيب، أنت تذكره، صح؟

79
00:06:08,220 --> 00:06:11,680
لقد عرّفتكما أنتما الاثنان ببعض في
مباراة خوسي ضد غوميز. إنه يابوكي

80
00:06:12,100 --> 00:06:14,150
!جو يابوكي

81
00:06:14,690 --> 00:06:19,610
دكتور كينينسكي متواجدٌ في اليابان من
أجل مرافقة البطل يا يابوكي-كن

82
00:06:19,610 --> 00:06:22,450
يسرّني لقاؤك ثانيةً

83
00:06:23,160 --> 00:06:24,570
طبيب خوسي، صح؟

84
00:06:24,570 --> 00:06:29,910
نعم، لقد كان أيضًا طبيب عدّة
أبطال آخرين قبل خوسي

85
00:06:30,410 --> 00:06:32,620
...فيما يخصّ المسائل التي تتعلّق بصحّة الملاكمين

86
00:06:32,620 --> 00:06:34,750
لديه سلطةٌ رائدةٌ على العالم، صح؟

87
00:06:34,750 --> 00:06:36,000
أتذكّر

88
00:06:36,000 --> 00:06:39,250
لقد ذكرتِه أيضًا أثناء لمّ شملي
بكارلوس بعد آخر مباراة

89
00:06:40,340 --> 00:06:45,260
كارلوس يعاني من الأضرار التي تلقّاها
كملاكِم جرَّاء اللكم المتكرر

90
00:06:45,640 --> 00:06:49,010
لديهِ الأعراض النموذجيّة لشخصٍ
مصاب بمتلازمة اللكمة الثملة

91
00:06:49,890 --> 00:06:53,100
لحسن الحظّ، أعرف الطبيب كينينسكي
،من جامعـة هاواي

92
00:06:53,100 --> 00:06:55,900
الذي يمثِّل سلطة رائدة في أبحاث
متلازمة اللكمة الثملة

93
00:06:55,900 --> 00:07:01,570
لو فحصَ كارلوس، فلربما لا يزال
هناك بعض الأمل في علاجه

94
00:07:04,070 --> 00:07:06,570
لذا ما الذي يريده الطبيب كينينسكي مني؟

95
00:07:06,570 --> 00:07:08,370
...لا شيء، لقد كانت هذه محض مصادفة

96
00:07:08,370 --> 00:07:10,410
"صحيح، بالطبع. "صدفة

97
00:07:10,410 --> 00:07:11,830
...صدفة، بالتأكيد

98
00:07:11,830 --> 00:07:14,910
عليّ الاستيقاظ في الخامسة صباحًا
للقيام بالركض، لذا سأغادر الآن

99
00:07:15,540 --> 00:07:16,870
!انتظر يا يابوكي-كن

100
00:07:17,830 --> 00:07:20,340
هلا بقيت وتحدّثتَ مع الطبيب كينينسكي قليلا؟

101
00:07:20,340 --> 00:07:25,300
ثمّة شيئين أكره تجربتهما: نبات الهليون والأطبّاء

102
00:07:25,880 --> 00:07:27,890
أراكِ لاحقًا. لقد كانت تلك نزهة مسلية

103
00:07:27,930 --> 00:07:29,850
!انتظر يا يابوكي-كن

104
00:07:34,770 --> 00:07:37,730
ما حصل قد حصل.دعينا
نأمل بفرصة أخرى

105
00:07:38,360 --> 00:07:39,730
اعتذاراتي

106
00:07:40,860 --> 00:07:42,480
!سأوصِلك إلى المنزل يا يابوكي-كن

107
00:07:42,480 --> 00:07:44,490
توجه إلى جسر الدموع في سينيا

108
00:08:12,120 --> 00:08:14,180
تبقّت فقط 5 كلم لتقطعها

109
00:08:31,030 --> 00:08:34,740
!كلا، إنه يتناول إفطاره الآن
لن يُقابل البطل أحدًا

110
00:08:34,750 --> 00:08:36,910
أخبره بأن سوجا هنا

111
00:08:36,910 --> 00:08:39,420
لقد طلبتُ مقابلةً معه
عبر الآنسة يوكو

112
00:08:41,960 --> 00:08:43,590
دعوه يدخل

113
00:08:46,050 --> 00:08:47,470
المعذرة

114
00:08:47,470 --> 00:08:48,970
هل بإمكاني مواصلة الأكل؟

115
00:08:48,970 --> 00:08:49,880
أرجوك، تفضّل

116
00:08:50,550 --> 00:08:53,850
ثمّة سؤالَين أود أن أسألك عنهما

117
00:08:54,390 --> 00:08:56,310
اسمح لي بأن أكون صريحًا

118
00:08:56,310 --> 00:08:59,140
،أحدُ السؤالَين يخصُّ إشاعة

119
00:08:59,140 --> 00:09:02,060
عن أنك كنتَ تتفادى تحدّي الإمبراطور
الغير متوّج- كارلوس ريفيرا

120
00:09:02,060 --> 00:09:05,480
والسؤال الآخر هو عن أنّك كنت فقط قادرًا
،على هزيمة كارلوس باللكمة القاضية

121
00:09:05,480 --> 00:09:09,320
لأنّ يابوكي قد تسبّبَ في إقعاده
بالفعل في طوكيو

122
00:09:09,700 --> 00:09:13,660
أرغبُ بمعرفة رأيك بتلك الشائعتين

123
00:09:16,410 --> 00:09:20,870
لا بدّ وأن تلك الشائعتَين قد أضّرتا فعلا بكبريائك

124
00:09:21,790 --> 00:09:26,840
أنت مخطئ. يتطلّب الأمر أكثر من
إشاعات غبيّة للإضرار بكبريائي

125
00:09:33,100 --> 00:09:36,600
حسنٌ أيها البطل. أتطلّع قدمًا
لرؤية مباراتك المُقبلة

126
00:09:36,960 --> 00:09:37,840
شكرًا لك

127
00:09:46,470 --> 00:09:47,970
،لأكون صريحًا

128
00:09:47,970 --> 00:09:54,270
لقد تطلّب مني الأمر وقتًا لكي أستنتج
أنه على الأرجح مصابٌ باللكمة الثملة

129
00:09:58,520 --> 00:10:02,070
السبب وراء ذلك لأن تحرّكاته بدتْ
طبيعيّة كليًّا أثناء المباراة

130
00:10:02,070 --> 00:10:05,200
ولقد كان من الصعب إيجاد
شيءٍ يثيرُ ريبتي

131
00:10:05,910 --> 00:10:08,240
خاصّية أخرى من ملاكمٍ مصاب
باللكمة الثملة

132
00:10:08,740 --> 00:10:14,960
هو بأنه نادرًا ما تظهر الأعراض للعيان
عندما يكونُ الملاكم متوترًا ومركزًا

133
00:10:15,790 --> 00:10:20,000
لاسيّما عندما يكونُ الملاكم يافعًا
وصاعِدًا، مثل جو يابوكي

134
00:10:23,670 --> 00:10:28,470
مع ذلك، تبدأ الأعراض بالظهور للعيان
سرعانَ ما يسترخي الملاكم

135
00:10:29,390 --> 00:10:31,460
،تصبحُ الآلام حادّةً بشكلٍ متزايد

136
00:10:31,580 --> 00:10:35,060
عندما يعتلي الحلبة ويُكرر العمليّة

137
00:10:40,610 --> 00:10:44,280
آنسة يوكو، يجب أن أفحصهُ حالا

138
00:10:44,280 --> 00:10:45,800
نعم، أعرف

139
00:10:46,110 --> 00:10:49,200
مع ذلك، أغلبُ الظنّ بأن الشيء الوحيد
،الذي سيتغيّر هو النسبة

140
00:10:49,200 --> 00:10:52,530
من احتمال يبلغ 99%، إلى
%يقينٍ يبلغ 100

141
00:10:52,540 --> 00:10:55,410
أيضًا، لقد اكتشفتُ شيئًا جديدًا

142
00:10:55,410 --> 00:10:58,750
هذه أشعّة كارلوس ريفيرا

143
00:11:06,520 --> 00:11:08,230
نعم؟ مرحبًا؟

144
00:11:08,230 --> 00:11:09,520
!نعم! لحظة أخرى من فضلك

145
00:11:11,020 --> 00:11:12,740
!أيها الرئيس! لديك مكالمة

146
00:11:12,800 --> 00:11:14,150
سأخرج بعد دقيقة

147
00:11:14,150 --> 00:11:15,230
حاضر

148
00:11:16,820 --> 00:11:19,490
مكالمة من أجل المسنّ؟ من المتصل؟

149
00:11:19,490 --> 00:11:21,820
إنها الآنسة شيراكي من نادي شيراكي

150
00:11:24,740 --> 00:11:27,620
هل هذا الرئيس تانجي؟ معك شيراكي

151
00:11:27,620 --> 00:11:30,500
عذرًا، المسنّ ليس هنا حاليًّا

152
00:11:30,540 --> 00:11:31,620
يابوكي-كن؟

153
00:11:31,620 --> 00:11:34,170
أخبريني بسبب اتّصالكِ وسوف أبلغُه بالأمر

154
00:11:34,630 --> 00:11:38,000
فهمت. لقد كنت أتّصل لأسأله عنك

155
00:11:38,010 --> 00:11:39,710
لكن على الأرجح أنه من الأسرع
لو سألتُك بدلا عنه

156
00:11:39,720 --> 00:11:41,840
هل بإمكانك تخصيص الوقت لرؤيتي من فضلك؟

157
00:11:41,840 --> 00:11:44,140
ثمة شخصٌ يود لقائك
والتحدّث معك

158
00:11:44,600 --> 00:11:46,600
من يكون؟

159
00:11:46,970 --> 00:11:50,060
إنه الطبيب كينينسكي. لقد التقيتَه
في المطار في اليوم المنصرِم

160
00:11:52,100 --> 00:11:55,360
أنا أتذكّر قولي في اليوم المُنصرِم بأنني
لا أحبذ ذلك النوع من الأشخاص

161
00:11:55,900 --> 00:11:58,320
.شكرًا لكِ على أي حال
وداعًا الآن

162
00:11:59,120 --> 00:12:00,260
!يابوكي-كن

163
00:12:00,280 --> 00:12:03,240
هل كانت تحتاجُني في شيء يا جو؟

164
00:12:03,240 --> 00:12:06,120
كلا، لا شيء. لقد تكفّلت بالأمر

165
00:12:06,120 --> 00:12:08,450
أنت فعلت؟ شكرًا على ذلك

166
00:12:08,450 --> 00:12:10,000
طبعًا، لا مشكلة

167
00:12:10,580 --> 00:12:13,380
!كونو! اعتلِ الحلبة! فلنخض مباراة تدريبيّة

168
00:12:50,080 --> 00:12:51,660
مرحبًا بعودتكِ يا يوكو

169
00:12:52,250 --> 00:12:54,120
أنا آسفة على تأخري

170
00:12:54,120 --> 00:12:55,300
تبدين متعبة

171
00:12:56,170 --> 00:12:58,020
لمَ لا تنضمين لي على شراب؟

172
00:12:58,480 --> 00:13:00,280
...نعم، أظنني سأفعل

173
00:13:21,420 --> 00:13:22,820
،لقد حصل الأمر قبل فترة

174
00:13:22,820 --> 00:13:27,160
لكن هل تتذكّر عندما قلتُ لك بأنّ
يابوكي-كن قد فقدَ روحه الجامحة؟

175
00:13:28,450 --> 00:13:29,620
نعم

176
00:13:30,080 --> 00:13:31,870
بطريقةٍ ما لم يكُن حيويًّا كما كان سابقًا

177
00:13:31,870 --> 00:13:36,210
،ولقد كانت طاقتُه تُهدر بلا داعٍ
لذا افترضتُ ذلك

178
00:13:36,750 --> 00:13:41,590
روحه الجائعة وتنافسُه النهِم قد
جعلاه بطل الملاكمة الشرقيّة

179
00:13:41,590 --> 00:13:44,090
لقد احتشدوا حوله الإعلاميين، وشيئًا فشيئًا

180
00:13:44,090 --> 00:13:47,050
شعرتُ بأنه كان يتوجّه نحو منعطفٍ مُنحدِر

181
00:13:47,140 --> 00:13:49,320
لكنني كنتُ مخطئة

182
00:13:49,350 --> 00:13:53,810
لقد تسبّبتْ متلازمة اللكمة الثملة التي
أصيبَ بها بذلك، هو ما تقولينه؟

183
00:13:53,810 --> 00:13:54,680
نعم

184
00:13:55,520 --> 00:13:59,020
لماذا لم أستطِع إدراك الأمر أبكر؟

185
00:13:59,020 --> 00:14:01,270
...حتّى بأنني جعلتُه يقاتِل هاريماو

186
00:14:01,270 --> 00:14:04,780
!لقد هيّجتُ مرضه فحسب

187
00:14:04,780 --> 00:14:06,820
لا يمكن إبطال ما حصل يا يوكو

188
00:14:06,820 --> 00:14:11,030
يجب ألا تلومي نفسكِ. لقد فعلتِ
ما ظننتهِ الأفضل له

189
00:14:11,030 --> 00:14:15,250
ما تفعلينه الآن فصاعدًا هو ما يهمّ

190
00:14:15,250 --> 00:14:16,540
...أعرف

191
00:14:16,540 --> 00:14:18,250
...أعرف يا جدي

192
00:14:19,670 --> 00:14:21,250
...ثمة أيضًا شيءٌ آخر إضافيّ

193
00:14:21,250 --> 00:14:24,880
ثمة شيءٌ آخر لا بدّ أن أقوله له

194
00:14:24,880 --> 00:14:27,760
...إنه شيءٌ في غاية الأهميّة

195
00:14:44,690 --> 00:14:46,230
مرحبًا، نادي تانجي

196
00:14:46,780 --> 00:14:47,760
!نـ - نعم

197
00:14:47,760 --> 00:14:49,060
!أرجوكِ انتظري لحظة

198
00:14:50,720 --> 00:14:51,950
هل الاتصال لي؟

199
00:14:51,950 --> 00:14:57,000
كلا، لقد طلبتْ التحدّث مع يابوكي، لكنها
طلبتْ محادثتكْ إذا لم يكن موجودًا

200
00:14:57,000 --> 00:14:57,950
من المتصل؟

201
00:14:58,920 --> 00:15:00,920
إنها الآنسة شيراكي

202
00:15:01,500 --> 00:15:02,830
أسدني معروفًا يا كونو

203
00:15:02,840 --> 00:15:05,880
أخبرها بأن كلانا خرجنا
للتمرّن ولسنا هنا

204
00:15:09,130 --> 00:15:11,550
...أنا آسف. إنهما في الواقع

205
00:15:12,050 --> 00:15:13,890
.هيّا أيها المسنّ
!فلنعد إلى التمرين

206
00:15:14,350 --> 00:15:17,850
هل أنت متأكد؟
ماذا لو كان الأمر مهمًّا؟

207
00:15:17,850 --> 00:15:19,980
فكِّر بالأمر أيها المسنّ

208
00:15:19,980 --> 00:15:22,230
خوسي يتدرّب في نادي يوكو

209
00:15:22,230 --> 00:15:24,820
لا ينبغي أن نختلط مع أشخاصٍ
،ينتمون لمخيّم العدوّ

210
00:15:24,900 --> 00:15:27,220
والثرثرة على الهاتف

211
00:15:27,400 --> 00:15:29,360
!فكِّر بالأمر، إنها في جانب العدوّ

212
00:15:29,360 --> 00:15:31,280
!إنه منطقٌ سليم

213
00:15:31,280 --> 00:15:33,450
...أفهمُ ما تعنيه، لكن

214
00:15:33,450 --> 00:15:34,870
فهمت؟

215
00:15:34,870 --> 00:15:40,290
لذا إلى أن تنقضي المباراة، لا أريدك
أن تُجيب على مكالماتها الهاتفيّة

216
00:15:40,360 --> 00:15:42,710
...لكننا قد عرفناها لزمنٍ طويل

217
00:15:42,710 --> 00:15:43,710
!فقط اخرس

218
00:15:43,710 --> 00:15:45,130
هل تفهم بأن ذلك إلهاء؟

219
00:15:45,130 --> 00:15:46,590
!لدي مباراةٌ قادمةٌ ضدّ خوسي

220
00:15:47,130 --> 00:15:48,710
حسنٌ يا جو

221
00:15:48,710 --> 00:15:52,550
،إذا كنتَ تصرُّ على ذلك كثيرًا
فلن أُجيبَ على مكالماتها

222
00:15:52,550 --> 00:15:55,260
جيّد، ما دمتَ تعي الأمر

223
00:16:06,110 --> 00:16:08,200
!سينباي! الهاتف

224
00:16:08,400 --> 00:16:09,060
ممن؟

225
00:16:09,360 --> 00:16:10,860
إنها مكالمةٌ من نادي شيراكي

226
00:16:10,860 --> 00:16:13,360
هل ينبغي أن أخبرها بأنك لا تزال خارجًا؟

227
00:16:15,370 --> 00:16:17,530
!أحمق! لا تسأل إذا كنتَ تعرف الإجابة مسبقًا

228
00:16:17,540 --> 00:16:19,330
...لكنها المرة الثالثة التي اتصلت فيها اليوم بالفعل

229
00:16:19,620 --> 00:16:21,620
!اخرس! أنا مشغولٌ بالتمرين

230
00:16:21,620 --> 00:16:22,290
!حـ - حاضر

231
00:16:22,710 --> 00:16:27,340
أنا آسف فهما ليسا هنا، لكن
!سيسرُّني أخذ رسالة

232
00:16:36,100 --> 00:16:38,100
انظر. لقد أتت مجددا اليوم

233
00:16:38,100 --> 00:16:39,680
...المطر يهطل بغزارة في الخارج

234
00:16:42,390 --> 00:16:47,400
،أعرف بأن خوسي في نادي شيراكي
...لكن لا يزال

235
00:16:47,980 --> 00:16:51,360
لا أظنّ بأن هذا صائب

236
00:16:51,650 --> 00:16:52,740
لا بأس

237
00:16:52,740 --> 00:16:55,320
.لم يطلب منها أحد الوقوف في الخارج
ليس لديّ شيءٌ لأقوله لها

238
00:16:55,320 --> 00:16:57,120
لكن على الأقل بإمكانك الإصغاء
...إلى ما لديها لتقوله

239
00:16:57,120 --> 00:16:58,490
أنت أيضًا أيها المسنّ

240
00:16:59,080 --> 00:17:02,870
بصفتك مُساندي، لا أريدك أن
تتدخّل في ما لا يعنيك

241
00:17:02,870 --> 00:17:04,580
حتّى ولو أردتُ ذلك، فكيف أستطيعُ ذلك الآن؟

242
00:17:04,620 --> 00:17:07,500
أنا عالقٌ بتفاديها بسببك

243
00:17:07,500 --> 00:17:08,790
!لا أستطيعُ رؤيتها الآن

244
00:17:22,350 --> 00:17:26,900
سمعتُ بأنه ليس من الجيّد لآنسةٍ
أن تخرج أثناء البرد

245
00:17:28,620 --> 00:17:29,580
شكرًا لكِ

246
00:17:36,780 --> 00:17:39,450
حسنٌ، حان الوقت للتمرّن

247
00:17:39,450 --> 00:17:43,450
حمدًا للربّ على ذهابها. لا أستطيع التدرّب
كيفما شئت أثناء تواجدها في الأرجاء

248
00:18:10,400 --> 00:18:11,610
يوكو

249
00:18:12,610 --> 00:18:14,570
هل تمكنتِ من رؤية يابوكي-كن؟

250
00:18:14,570 --> 00:18:15,540
كلا

251
00:18:16,500 --> 00:18:17,740
الأوضاع المُخيفة تستدعيّ تدابير جذريّة

252
00:18:17,740 --> 00:18:21,490
إذا لم يكن الدفع ينفع، فبإمكاني
التحدّث مع مفوّض الملاكمة

253
00:18:22,030 --> 00:18:27,000
لو شرحتُ الوضع، فأنا متيقّنٌ بأنه
سيعثر على حلٍّ ما

254
00:18:27,080 --> 00:18:28,620
كلا يا جدي

255
00:18:28,620 --> 00:18:30,170
لا بدّ أن أتكفّل بهذا بنفسي

256
00:18:30,750 --> 00:18:36,550
لأنه ما لم يتقبّلْ الأمر، فلن أكونَ
قادرةً على تقبّل الأمر بذاتي

257
00:18:38,510 --> 00:18:40,260
...على الأرجح

258
00:18:41,820 --> 00:18:43,350
...لا كارلوس سيتقبّل ذلك

259
00:18:43,350 --> 00:18:45,430
...ولا ريكيشي-كن

260
00:18:47,890 --> 00:18:50,480
كونو! جو! أين جو؟

261
00:18:50,480 --> 00:18:52,860
ينبغي أن يكون هنا. لعلّه في دورة المياه؟

262
00:18:56,040 --> 00:18:57,160
ها أنت ذا

263
00:18:59,910 --> 00:19:02,740
،بما أنّك رفضتَ بعنادٍ مقابلتها

264
00:19:03,490 --> 00:19:06,080
أرسلتْ هذا عوضًا عن ذلك بواسطة البريد السريع

265
00:19:06,830 --> 00:19:10,710
لقد كان موجّها لكلينا، لذا سبقتُكَ بقراءته

266
00:19:10,760 --> 00:19:12,140
لن تُصدّق الأمر

267
00:19:13,210 --> 00:19:16,050
لأنّ شيئًا لا يُصدّق قد كان هنا

268
00:19:21,340 --> 00:19:26,430
أرجوك اسمح لي بسرد الحقائق"
"الملموسة التي توصّلتُ إليها

269
00:19:27,700 --> 00:19:29,230
،"النظريّة التي صدّقها الجميع"

270
00:19:29,350 --> 00:19:34,270
فيما يتضمّنني وعلى الأرجح أنت"
"أيضًا، قد ثبتَ أنها خطأ

271
00:19:35,360 --> 00:19:39,780
هذه الأشعّة التي صوّرها الطبيب"
"كينينسكي قد خالفتْ النظرية لوحدها

272
00:19:39,780 --> 00:19:45,580
بأنّ جو يابوكي قد كان الشخص الذي"
"قد أقعدَ كارلوس ريفيرا

273
00:19:45,580 --> 00:19:49,580
كما تستطيع أن ترى في الأشعّة، لقد تعرّضتْ"
"منطقة صدغه لعدّة كسور معقّدة

274
00:19:49,580 --> 00:19:53,710
يستحيلُ على لكمةٍ قد تمّ إطلاقها باستقامة"
"أن تسبب هذا النوع من الضرر المميزّ

275
00:19:54,250 --> 00:19:56,250
"بلا ريبٍّ لقد تسبّبتْ بها لكمةٌ لولبيّة"

276
00:19:56,630 --> 00:19:59,090
،"وهي تقنية لكم رفيعة المستوى"

277
00:19:59,090 --> 00:20:01,930
حيث تلتوي القبضة مثل"
"لولبٍ وتُضاعِف الضرر

278
00:20:01,930 --> 00:20:04,050
تلك الكسور هي علامة مميّزة"
"تُخلّفها تلك اللكمة ورائها

279
00:20:04,050 --> 00:20:06,600
أنا متيقنةٌ بأنك تعرف بالفعل"
"ما أنا على وشك قوله

280
00:20:06,600 --> 00:20:09,600
لقد راجعتُ فيديو مباراتك ضدّ كارلوس"
،"ريفيرا عدّة مرات لكي أتيقّن

281
00:20:09,600 --> 00:20:15,860
لكنّك لم تلكم صدغ كارلوس ولو لمرّة"
"أو استخدمتَ لكمةً لولبيّة

282
00:20:16,220 --> 00:20:19,620
على النقيض، اللكمة التي استخدمها ميندوزا"
"لختم انتصاره بالضربة القاضية ضدّ كارلوس

283
00:20:19,620 --> 00:20:23,960
كانت بلا شكٍّ لكمةً لولبيّة"
"هبطتْ على صدغه تمامًا

284
00:20:28,140 --> 00:20:29,760
هل تعرف ماذا يعني هذا يا جو؟

285
00:20:29,760 --> 00:20:35,720
تفوّقنا النفسي، الذي كان يمثّل أملنا
!الوحيد في هزيمة خوسي قد ذهب

286
00:20:35,720 --> 00:20:37,340
!لم يكُن أنت

287
00:20:37,340 --> 00:20:40,440
!بل كان خوسي من أقعدَ كارلوس

288
00:20:40,440 --> 00:20:42,440
تفوّق نفسيّ؟

289
00:20:42,440 --> 00:20:45,020
لم يسبق وأن امتلكتُ ذلك منذ البداية

290
00:20:52,360 --> 00:20:53,040
!جو

291
00:20:53,680 --> 00:20:55,340
!قُل شيئًا يا جو

292
00:20:56,320 --> 00:20:57,860
"أيضًا، يابوكي-كن"

293
00:20:57,900 --> 00:21:01,080
"ثمّة حقيقة إضافيّة أريدك أن تعرفها"

294
00:21:01,300 --> 00:21:05,120
"هذا شيءٌ أتمنّى إخبارك به شخصيًّا"

295
00:21:05,120 --> 00:21:06,360
"أتوسّل إليك"

296
00:21:06,360 --> 00:21:09,840
"أرجوك قابلني بأسرع ما يُمكنك"

297
00:21:13,920 --> 00:21:15,760
!سينباي! إنها الآنسة شيراكي

298
00:21:17,940 --> 00:21:18,920
اقطع المُكالمة