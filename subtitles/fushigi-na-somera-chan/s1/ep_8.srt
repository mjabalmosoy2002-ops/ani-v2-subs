1
00:00:00,550 --> 00:00:02,500
."المينوسو تصيح "مينوسو

2
00:00:02,480 --> 00:00:09,190
."إنّها كلمة وُوتانية قديمة تعني "ثورة لا دمويّة

3
00:00:37,470 --> 00:00:40,100
عائلة نونوموتو

4
00:00:37,800 --> 00:00:40,100
أونيتشان، هل تريدين أن تقفي نموذجًا
لرسوماتي البشريّة؟

5
00:00:40,100 --> 00:00:42,350
.أكيد. ألف ين للسّاعة

6
00:00:42,730 --> 00:00:44,980
.أنا أطلب مالاً خصوصًا من عائلتي

7
00:00:44,980 --> 00:00:46,150
.أنتِ شيطانة

8
00:00:46,150 --> 00:00:48,940
أونيتشان

9
00:00:46,690 --> 00:00:48,940
.يا لسوئك يا كوكورو

10
00:00:48,940 --> 00:00:51,480
.كنت لتحصلي على علامات أفضل لو سلّمت ورقة فارغة

11
00:00:51,480 --> 00:00:52,990
.أتساءل عن ذلك

12
00:00:54,240 --> 00:00:56,950
.رؤيتها تجعلني أودّ تمزيقها مع أنّها رسمة لي

13
00:00:56,950 --> 00:00:57,990
.سأرسمها بشكل أفضل المرّة المقبلة

14
00:00:57,990 --> 00:00:59,870
!أنا آسفة يا كوكورو

15
00:00:59,870 --> 00:01:00,990
.لا بأس

16
00:01:00,990 --> 00:01:03,120
.وهنا يأتي دوركما

17
00:01:03,120 --> 00:01:05,080
.بالطّبع، دعي الأمر لنا

18
00:01:05,080 --> 00:01:06,790
.أنا أجيد تمزيق الأشياء

19
00:01:06,790 --> 00:01:08,130
.ليس هذا ما أريده

20
00:01:08,380 --> 00:01:09,460
نموذج؟

21
00:01:09,460 --> 00:01:10,880
هل ستدفعين لي؟

22
00:01:10,880 --> 00:01:12,960
!كيف أمكنك طلب المال من صديقة لك؟ أنت فظيعة

23
00:01:12,960 --> 00:01:13,840
.أونيتشان

24
00:01:13,840 --> 00:01:16,220
ماتسوشيما أي-تشان

25
00:01:13,840 --> 00:01:16,220
من رسم نونوموتو كوكورو

26
00:01:13,840 --> 00:01:16,220
.لكنّك سيّئة حقًّا

27
00:01:16,220 --> 00:01:18,220
.قد تُطرَدين إن سلّمتها

28
00:01:18,220 --> 00:01:19,090
.لا يمكن

29
00:01:19,090 --> 00:01:22,220
.قد يكون من الأسهل جعلك تحبّين الرّسمة

30
00:01:22,220 --> 00:01:26,100
ما رأيكنّ أن نجعل المشاهدين ثملين؟

31
00:01:26,100 --> 00:01:28,100
تخدير المعلمة

32
00:01:28,100 --> 00:01:30,900
.لمساعدة أختٍ للحصول على علامة جيّدة في واجبها

33
00:01:30,900 --> 00:01:31,860
.إنّه أمر إنسانيّ

34
00:01:31,860 --> 00:01:32,820
!بل جنون

35
00:01:32,980 --> 00:01:34,110
هنا إذًا؟

36
00:01:34,570 --> 00:01:36,530
.سنتسلل أولاً إلى منزل المعلمة

37
00:01:36,530 --> 00:01:37,320
هل هذه فكرة جيّدة؟

38
00:01:37,320 --> 00:01:38,660
.بالطّبع لا

39
00:01:38,660 --> 00:01:41,740
.والآن سننتظر الهدف

40
00:01:42,790 --> 00:01:43,490
.ها قد وصلت

41
00:01:43,740 --> 00:01:45,750
.أنا مرهقة

42
00:01:45,750 --> 00:01:47,870
.حسنًا، لنشجّع أنفسنا أوّلاً

43
00:01:51,210 --> 00:01:53,340
هل من أحدٍ هناك؟

44
00:01:54,050 --> 00:01:55,760
.لـ-لربّما لاحظت وجودنا

45
00:01:55,760 --> 00:01:57,010
ماذا كنت تتوقّعين من هتافنا؟

46
00:01:57,010 --> 00:01:58,430
.لقد كانت فكرتكِ يا سوميرا-سان

47
00:01:59,380 --> 00:02:01,220
من هناك؟ هل هذا أنت؟

48
00:02:01,220 --> 00:02:02,100
.هذا سيّئ

49
00:02:02,640 --> 00:02:05,180
الخالق دومونبيرغ-ساما؟

50
00:02:05,180 --> 00:02:07,310
دو-دو-دومونبيرغ-ساما؟

51
00:02:07,310 --> 00:02:09,560
.لربّما كان إلهًا اخترعَتْه

52
00:02:09,560 --> 00:02:11,980
.أظنّها مجنونة سلفًا

53
00:02:11,560 --> 00:02:21,910
!دومونبيرغ! دومونبيرغ! دومونبيرغ

54
00:02:15,980 --> 00:02:17,440
ما العمل؟

55
00:02:18,030 --> 00:02:19,110
...حسنًا إذًا

56
00:02:20,530 --> 00:02:21,990
!صمتًا

57
00:02:23,240 --> 00:02:24,450
.ذلك الصّوت

58
00:02:24,450 --> 00:02:25,620
...لا

59
00:02:26,200 --> 00:02:30,000
!سألتقي دومونبيرغ-ساما أخيرًا

60
00:02:30,750 --> 00:02:32,250
.لقد أتيت

61
00:02:34,880 --> 00:02:39,680
.إنّه أنا، الخالق دومونبيرغ

62
00:02:40,550 --> 00:02:47,980
هل تكترثين لتعاليمي؟

63
00:02:47,980 --> 00:02:48,810
!أجل

64
00:02:48,810 --> 00:02:52,020
.لا أفوّت انحنائي بالمظلة تُجاهَ الأرض المقدّسة يوم الجمعة

65
00:02:52,020 --> 00:02:53,610
!إلى أي حدّ تتعبّدينه؟

66
00:02:53,860 --> 00:02:56,480
.يجب عليكِ زيارة طبيب

67
00:02:56,820 --> 00:02:58,110
.سأعود أدراجي الآن

68
00:02:58,110 --> 00:03:02,450
.دخلت مياموتو ماري المستشفى مباشرةً

69
00:03:02,450 --> 00:03:05,080
وقد تمّت مساعدتها على التّحسّن من قِبَل واجبِ

70
00:03:05,080 --> 00:03:10,120
.نونوموتو كوكورو المنزليّ الّذي كان معروفًا لها وحدها

71
00:03:08,120 --> 00:03:15,250
دومونبيرغ

72
00:03:08,120 --> 00:03:15,250
من رسم نونوموتو كوكورو

73
00:03:08,540 --> 00:03:15,250
!دومونبيرغ! دومونبيرغ! دومونبيرغ

74
00:03:15,250 --> 00:03:18,010
الكثير من التّضخم سيعيدكم إلى البداية

75
00:03:18,260 --> 00:03:21,010
جوزتان وحبّارٌ يَرعيّ

76
00:03:21,260 --> 00:03:24,090
ناماستي، نيهاو، تشاو، ساوادي

77
00:03:24,220 --> 00:03:27,100
العالم بأسره سعيد جدًّا

78
00:03:27,220 --> 00:03:30,350
!اقلبوها وستحصلون على أنغكور وات