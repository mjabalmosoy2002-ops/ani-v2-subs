204
00:17:48,280 --> 00:17:49,050
.أجل

205
00:17:58,060 --> 00:17:59,390
.ابقَ مكانك

206
00:17:59,390 --> 00:18:01,300
.مهلًا

207
00:18:01,300 --> 00:18:02,860
!لا يجب أن تخرج

208
00:18:05,030 --> 00:18:05,970
!بو-تشان

209
00:18:15,780 --> 00:18:18,350
.يبدو أنّهم يستمتعون بوقتهم

210
00:18:18,350 --> 00:18:19,250
