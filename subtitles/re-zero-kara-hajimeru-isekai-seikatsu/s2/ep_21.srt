1
00:00:06,320 --> 00:00:09,990
،تبًّا... أردتُ إيقاف الإغارة على القصر

2
00:00:09,990 --> 00:00:12,400
لكن أظنّني جعلتُ الأمر حتميًّا فحسب

3
00:00:12,580 --> 00:00:15,970
حسنًا، أشعرَني ذلك الكلام بالسّعادة

4
00:00:15,970 --> 00:00:19,000
،لو لم تكن تلك مفاوضات لحلّ الأمور سلميًّا

5
00:00:19,000 --> 00:00:21,080
لكنتُ قد اتّفقتُ معك

6
00:00:21,400 --> 00:00:25,090
!يجب أن أصل للقصر في أسرع وقت ممكن

7
00:00:25,090 --> 00:00:26,750
...وها أنا ما زلتُ هنا

8
00:00:26,750 --> 00:00:30,010
من الاستخفاف أن نقول أنّه ينقصنا العدد الآن

9
00:00:30,010 --> 00:00:32,160
سأذهب معك إذًا

10
00:00:33,840 --> 00:00:34,840
ماذا؟

11
00:00:35,220 --> 00:00:36,860
هل أنت متأكّد أنّك فهمت؟

12
00:00:36,860 --> 00:00:40,870
الذهاب إلى القصر يعني مُغادرة المأوى

13
00:00:40,870 --> 00:00:42,950
ألن يوقفك الحاجز؟

14
00:00:42,950 --> 00:00:44,250
الحاجز؟

15
00:00:44,250 --> 00:00:45,440
هذا ليس بمشكلة

16
00:00:45,700 --> 00:00:46,680
!ماذا؟

17
00:00:46,680 --> 00:00:51,900
مثل أختي، أحمل دم أبي المخلوط ودم أمّي البشريّة

18
00:00:52,690 --> 00:00:54,860
نسبة دمي المخلوط قليلة جدًا فلا تكفي لمنعي

19
00:00:55,210 --> 00:00:59,370
!لكن سمعتُ أنّك وفريدريكا من أبوين مختلفين

20
00:00:59,780 --> 00:01:02,080
...ماذا؟ في الواقع

21
00:01:02,580 --> 00:01:07,340
كان حظّ أمّي وذوقها في الرّجال سيّئين جدًّا

22
00:01:07,340 --> 00:01:08,590
!حلّل الأمر بنفسك

23
00:01:10,840 --> 00:01:13,630
!كان ينبغي أن تخبرني من قبل

24
00:01:17,590 --> 00:01:21,330
،أنا الأقوى بالفعل، لكن بوجود هذه

25
00:01:21,330 --> 00:01:23,390
!سأصبح أقوى حتّى

26
00:01:23,650 --> 00:01:27,440
!أثبِت لنا كم أنت قويّ فعليًّا

27
00:01:28,210 --> 00:01:29,700
يمكنك الاعتماد عليّ

28
00:01:29,700 --> 00:01:33,170
لا أحد يستطيع الهرب من راينهارد، كما يقولون

29
00:01:33,170 --> 00:01:36,600
ما زال حيًّا وتمّ تأليف مقولة عنه من الآن؟

30
00:01:36,600 --> 00:01:37,670
معقول؟

31
00:01:38,360 --> 00:01:40,070
كلّ شيء جاهز هنا أيضًا

32
00:01:40,710 --> 00:01:44,060
والآن كلّ ما علينا تأمّله هو ألّا
تصل إلزا وشريكتها باكرًا

33
00:01:44,510 --> 00:01:47,260
!أعتمد عليكما وعلى عدوّنا

34
00:01:47,260 --> 00:01:49,520
!هذا هو فنّ الحرب، أسلوب ناتسكي سوبارو

35
00:01:49,520 --> 00:01:51,590
!الفورينكازان العكسيّة خاصّتي

36
00:01:52,470 --> 00:01:54,130
!هـ-هذا رائع للغاية

37
00:01:54,520 --> 00:01:57,230
!شكرًا على المساعدة أيّها الأحمقان

38
00:01:57,230 --> 00:02:00,610
!ألا يمكنك شكر الناس بشكل طبيعي أيها الأحمق؟

39
00:02:00,610 --> 00:02:01,640
...على أي حال يا رام

40
00:02:02,100 --> 00:02:03,760
أترك الباقي لكِ

41
00:02:03,760 --> 00:02:05,830
حسنًا. افعل ما تشاء

42
00:02:05,830 --> 00:02:08,600
سأفعل ما يحلو لي اعتبارًا من هذه اللّحظة

43
00:02:16,770 --> 00:02:17,400
...رام

44
00:02:19,700 --> 00:02:21,200
لا تتصرّفي بتهوّر

45
00:02:22,080 --> 00:02:23,790
أأنت من يقول ذلك يا باروسو؟

46
00:02:23,790 --> 00:02:24,660
لا تثرني على الضّحك

47
00:02:27,760 --> 00:02:28,410
!حسنًا يا جماعة

48
00:02:28,830 --> 00:02:31,180
...آسف على غرابة كلّ ما حدث، لكن

49
00:02:31,600 --> 00:02:32,880
،سوبارو-ساما

50
00:02:32,880 --> 00:02:35,050
عليك ألّا تقلق بشأننا

51
00:02:35,480 --> 00:02:39,700
شرطيّنا الداخليّ أخبرنا بكلّ شيء

52
00:02:42,290 --> 00:02:43,940
!هيّا، انطلق

53
00:02:43,940 --> 00:02:46,710
لكن ينبغي أن تمسح أنفك عندما ينزف

54
00:02:46,710 --> 00:02:48,620
!فأنت لا تريد أن يخيب أمل بيترا بالتأكيد

55
00:02:49,010 --> 00:02:50,880
!شكرًا لكم جميعًا

56
00:02:50,880 --> 00:02:51,480
...لكن

57
00:02:51,740 --> 00:02:55,230
!سوبارو-ساما، استسلم فحسب ودعنا نساعدك

58
00:02:55,600 --> 00:02:57,440
—المعذرة! من هو شرطيّكم الداخـ

59
00:02:57,440 --> 00:02:59,030
!لننطلق

60
00:04:29,880 --> 00:04:33,880
لذا قام الأغبياء الثّلاثة بربط العربة
بتنّينتهم البرّية فائقة الذكاء

61
00:04:33,880 --> 00:04:35,620
وانطلقوا نحو القصر

62
00:04:36,450 --> 00:04:38,330
حسنًا، فهمت

63
00:04:38,330 --> 00:04:41,120
عجبًا، ماذا عسايّ أن أفعل معه؟

64
00:04:41,120 --> 00:04:42,260
أهذا كلّ شيء؟

65
00:04:42,620 --> 00:04:44,920
أظنّني ما زلتُ غاضبة قليلًا

66
00:04:45,400 --> 00:04:48,960
هل قصد سوبارو ما قاله عندما قال أنّه يحبّني؟

67
00:04:49,600 --> 00:04:52,980
باروسو يهتمّ بك أكثر من أي شخص آخر

68
00:04:53,330 --> 00:04:55,290
حسنًا. شكرًا لك

69
00:04:55,290 --> 00:04:59,070
...إيميليا-ساما، هل عودتك تعني أنّ

70
00:04:59,070 --> 00:05:00,190
المِحنة؟

71
00:05:00,810 --> 00:05:04,840
،أجل. تمكّنتُ من مجابهة ماضيّ

72
00:05:04,840 --> 00:05:06,570
لكن يبدو أنّه بقي مِحنتان اثنتان

73
00:05:07,090 --> 00:05:10,920
لذا سيتوجّب عليّ دخول المقبرة ثانية لاحقًا

74
00:05:15,070 --> 00:05:17,990
أصبحتِ أقوى فعلًا

75
00:05:20,200 --> 00:05:22,960
إيميليا-ساما، أنا آسفة حقًّا

76
00:05:23,600 --> 00:05:25,120
لمَ تعتذرين فجأة؟

77
00:05:25,820 --> 00:05:29,450
هذه أوّل مرّة أحني فيها رأسي بجدّية

78
00:05:31,220 --> 00:05:35,620
حتّى الآن، لم أعتقد أنّكِ ستعودين
للنهوض على قدميكِ

79
00:05:36,780 --> 00:05:40,010
،لكن ها أنتِ ذي الآن، تقفين أمامي

80
00:05:40,010 --> 00:05:41,950
بصدرٍ مشدود ورأس مرفوع

81
00:05:42,500 --> 00:05:45,900
فقدتِ بضع نقاط فقط نظرًا لآثار
الدّموع التي على وجنتيك

82
00:05:46,230 --> 00:05:48,860
!يا للهول

83
00:05:49,730 --> 00:05:55,460
إذًا هل ساعدتِ سوبارو وأوتّو-كن لأنّكِ
ارتأيتِ أنني مجرّد بكّاءة؟

84
00:05:55,460 --> 00:05:58,120
،لا تكوني سخيفة. ساعدتكِ أنتِ فقط

85
00:05:58,120 --> 00:06:01,210
وأنتِ من حدّد أنّ تلك المساعدة تستحقّ وقتي

86
00:06:01,700 --> 00:06:05,360
حقًّا؟ لكن لماذا؟

87
00:06:05,360 --> 00:06:08,590
ما الذي جعلكِ تقرّرين مساعدتي؟

88
00:06:09,360 --> 00:06:13,960
على المرء أن يكون صادقًا عندما يُسأل عن شيء

89
00:06:19,290 --> 00:06:21,230
أتوسّل إليكِ يا إيميليا-ساما

90
00:06:21,720 --> 00:06:25,030
أنقذي سيّدي روزوال-ساما أرجوكِ

91
00:06:25,470 --> 00:06:26,740
روزوال؟

92
00:06:27,400 --> 00:06:30,490
لقد استحوذت عليه الأوهام

93
00:06:31,130 --> 00:06:35,700
أوهام قيّدت روحه كلعنة منذ مدّة طويلة جدًّا

94
00:06:36,690 --> 00:06:39,270
ما كنتُ لأكترث بشأن ذلك

95
00:06:39,700 --> 00:06:41,980
،حتّى لو كان لا ينظر إليّ

96
00:06:41,980 --> 00:06:44,480
...حتّى لو كان يعتبرني مجرّد أداة

97
00:06:45,710 --> 00:06:46,430
...رام

98
00:06:47,280 --> 00:06:51,260
لكن أوهامه قد ضلّت بالفعل عن المسار نحو نتيجة لائقة

99
00:06:51,870 --> 00:06:53,970
،فقدت أمنيته مسارها

100
00:06:53,970 --> 00:06:56,890
وبات يتشبّث بكلمات مكتوبة لأغراض حسّية جمالية فقط

101
00:06:57,720 --> 00:07:00,350
أرجوكِ حلّي هذه المشكلة

102
00:07:01,680 --> 00:07:04,310
ماذا عساي أن أفعل؟

103
00:07:04,680 --> 00:07:07,030
تولّي العرش الملكيّ

104
00:07:09,780 --> 00:07:12,830
،حالما تتولّين عرش لوغونيكا

105
00:07:12,830 --> 00:07:15,100
ستتحقّق أمنية روزوال-ساما

106
00:07:15,660 --> 00:07:17,810
،حتّى لو انحرف عن دربِه لفترة طويلة

107
00:07:17,810 --> 00:07:20,210
سيأتي اليوم الذي تتحقّق فيه أمنيته

108
00:07:20,580 --> 00:07:24,350
أخبري روزوال-ساما بذلك أرجوكِ

109
00:07:24,850 --> 00:07:28,660
امنحيه سببًا ليعيش الحاضر والمستقبل

110
00:07:30,480 --> 00:07:32,630
أرجوكِ يا إيميليا-ساما

111
00:07:35,040 --> 00:07:37,600
أنقذيه أرجوكِ

112
00:07:49,490 --> 00:07:55,490
لا أفهم تمامًا ما علاقة أن أصبح
الحاكمة بإنقاذ روزوال

113
00:07:56,240 --> 00:08:01,340
لا أظنّني سأفهم أمنيتكِ تمامًا بعد أيضًا

114
00:08:02,210 --> 00:08:02,830
...لكن

115
00:08:03,460 --> 00:08:07,790
هذه أوّل مرّة تطلبين فيها شيئًا منّي

116
00:08:09,500 --> 00:08:10,590
حسنًا يا رام

117
00:08:11,140 --> 00:08:14,870
آمنتِ بي، وأنا أريد أن أردّ لكِ هذا المعروف

118
00:08:15,250 --> 00:08:19,350
أنا متأكّدة أنّ هذا شيئًا عليّ أن أبدأه بنفسي الآن

119
00:08:32,530 --> 00:08:34,610
...هل تمانعين

120
00:08:34,610 --> 00:08:38,700
أن أقدّم تهانيّ لكِ أيضًا؟

121
00:08:45,670 --> 00:08:46,810
لا تقترب أكثر

122
00:08:47,880 --> 00:08:50,050
...عجبًا، عجبًا

123
00:08:50,050 --> 00:08:53,620
يا له من ترحيب حسن يا إيميليا-ساما

124
00:08:53,620 --> 00:08:57,890
بخلاف مظهري، قلقي عليكِ صادق

125
00:08:57,890 --> 00:09:00,820
يمكنكِ القول حتّى أنّي أشفق عليكِ

126
00:09:00,820 --> 00:09:02,800
تشفق... عليّ؟

127
00:09:02,800 --> 00:09:06,600
أجل، أشفق عليكِ من أعماق قلبي

128
00:09:06,600 --> 00:09:10,990
فأنتِ لا تملكين أدنى فكرة عن كيفيّة كسب
،حبّ الناس لكِ سوى بفعل ما يتأمّلونه منكِ

129
00:09:10,990 --> 00:09:14,860
مع ذلك اضطررتِ لمُجابهة ماضٍ لم ترغبيه قطّ

130
00:09:16,210 --> 00:09:18,820
،اسمحي لي أن أهنّئكِ

131
00:09:19,320 --> 00:09:23,170
بكامل الشّفقة والعطف اللّذين أمنحهما لكِ

132
00:09:23,170 --> 00:09:25,810
!أحسنتِ صنعًا في التغلّب على المِحنة

133
00:09:25,810 --> 00:09:28,830
كنتُ مقتنعًا أنّكِ لستِ مؤهّلة لذلك

134
00:09:29,570 --> 00:09:32,560
من الصّعب أن أشكرك وأنت تهنّئني بهذه الطريقة

135
00:09:33,090 --> 00:09:36,180
قلتَ أنّك لم تعتقد أنّني أستطيع فعلها

136
00:09:36,180 --> 00:09:37,800
هل غيّرت رأيك الآن؟

137
00:09:39,400 --> 00:09:42,310
معك حقّ. أعلم أنّني أقلقتُك كثيرًا

138
00:09:43,290 --> 00:09:45,660
لم أقوَ سوى على فقدان شجاعتي

139
00:09:46,080 --> 00:09:50,270
سبّبتُ الكثير من المتاعب لباك وسوبارو... والجميع

140
00:09:50,850 --> 00:09:53,580
لكنّهم أنقذوني جميعًا

141
00:09:53,970 --> 00:09:55,770
،كنتُ عديمة الفائدة كلّيًا

142
00:09:55,770 --> 00:09:57,340
ومدّوا يد العون لي

143
00:09:57,770 --> 00:10:01,550
جعلني ذلك أدرك أنّني لا يجوز
أن أستمرّ في كوني جبانة

144
00:10:04,520 --> 00:10:07,400
تقولين نفس الكلام الذي قاله سوبارو-كن

145
00:10:07,400 --> 00:10:09,950
هل تردّدين كلامه ببساطة فحسب؟

146
00:10:09,950 --> 00:10:10,790
!روزوال-ساما

147
00:10:11,090 --> 00:10:14,360
كلماتكِ المُستعارة والمكان الذي حُضّر لكِ

148
00:10:14,360 --> 00:10:19,010
وحتّى مُحاولاتكِ في المِحنة كانت قرارات
اتُّخذت فقط بعد أن تمّ إعداد المسرح لذلك

149
00:10:19,010 --> 00:10:22,980
ورغم معرفته بذلك، حثّكِ سوبارو-كن
على فعل أشياء فظيعة

150
00:10:22,980 --> 00:10:25,140
—هذا غير صحيح! يريد سوبارو

151
00:10:25,140 --> 00:10:26,490
كلانا نعرفه

152
00:10:26,490 --> 00:10:28,590
،لم يكن يتكلّم بمنطق أو عقلانيّة

153
00:10:28,590 --> 00:10:31,730
لكن كان يلقي عليكِ خطابًا عاطفيًّا
استثنائيًا، أليس كذلك؟

154
00:10:32,160 --> 00:10:34,010
،فرض أنانيّته عليكِ

155
00:10:34,010 --> 00:10:38,130
ليجبركِ على التّماشي مع مُثُله بالتأكيد
العاطفيّ على أنكِ تستطيعين فعلها

156
00:10:38,130 --> 00:10:40,840
أفهم. أفهم ذلك بحقّ

157
00:10:40,840 --> 00:10:42,700
...فأساسًا، هو وأنا

158
00:10:43,050 --> 00:10:45,660
متشابهان

159
00:10:46,420 --> 00:10:49,350
أنت وسوبارو متشابهان؟

160
00:10:49,350 --> 00:10:50,750
ما معنى هذا؟

161
00:10:50,750 --> 00:10:54,800
كلانا نفرض مُثُلنا على النّساء اللّواتي نحبّهن

162
00:10:56,350 --> 00:10:58,370
أنا متأكّد أنّه دلّلكِ

163
00:10:58,370 --> 00:11:01,220
وعاملكِ بأقصى عناية وحنان

164
00:11:01,220 --> 00:11:05,740
لم يعتبر يومًا أنكِ فتاة عاديّة، أليس كذلك؟

165
00:11:05,740 --> 00:11:10,390
أنتِ التي يحبّها هي النسخة المثاليّة
منكِ التي تعيش في عقله

166
00:11:11,200 --> 00:11:12,350
هل أنا مخطئ؟

167
00:11:19,970 --> 00:11:21,030
أهذا كلّ شيء؟

168
00:11:21,860 --> 00:11:26,600
أهذا الشيء الوحيد الذي يجعلك تعتقد أنّك تشبهه؟

169
00:11:27,530 --> 00:11:29,600
...إذا كان هذا كلّ ما تريد قوله

170
00:11:30,150 --> 00:11:33,470
فأنت وسوبارو لستما متشابهين إطلاقًا

171
00:11:34,740 --> 00:11:39,130
أخبرني سوبارو أنّني مزعجة

172
00:11:39,540 --> 00:11:40,340
ماذا؟

173
00:11:40,630 --> 00:11:45,050
سألني من أعتقد نفسي بعد أن سبّبتُ له
المتاعب بينما قدّم الكثير والكثير

174
00:11:46,580 --> 00:11:49,860
طلب منّي ألّا أشغل تفكيري كثيرًا بما مضى

175
00:11:50,750 --> 00:11:54,150
قال أنّني أجيد الكلام فقط لا الأفعال
وأنّه لم يعد يتحمّل ذلك

176
00:11:55,010 --> 00:11:57,570
وكلّ ما قاله كان صحيحًا

177
00:11:57,980 --> 00:12:02,610
كنتُ ضعيفة وعاجزة ولا أجيد سوى الكلام

178
00:12:03,280 --> 00:12:06,110
سوبارو يراني على حقيقتي فعلًا

179
00:12:06,660 --> 00:12:10,180
لذا أنا متأكّدة أنّك وسوبارو غير متشابهين

180
00:12:13,140 --> 00:12:14,790
،عندما أريد فعل شيء

181
00:12:15,230 --> 00:12:17,260
،عندما أتمنّى أن أتغيّر

182
00:12:17,260 --> 00:12:20,240
يمسك بيدي ويساعدني

183
00:12:20,240 --> 00:12:23,010
علّمني أنّ هناك أشخاص سيقولون لي ذلك الكلام

184
00:12:23,010 --> 00:12:25,570
ألا تعتقدين أنّه كان يخدعكِ فحسب؟

185
00:12:25,570 --> 00:12:28,210
كلّ هذا ليدعكِ تنهضين على قدميكِ ببراعة؟

186
00:12:28,210 --> 00:12:30,480
لا. لم يكن يكذب

187
00:12:30,880 --> 00:12:34,580
ما شعر به سوبارو عندما قال أنّه يؤمن
بي لن يتحوّل إلى كذبة

188
00:12:35,060 --> 00:12:36,190
لن أسمح بذلك

189
00:12:36,630 --> 00:12:38,060
سأحوّل الأكاذيب إلى أُمنيات

190
00:12:38,620 --> 00:12:42,770
هذا ما عليّ فعله الآن وما أريد فعله

191
00:12:50,100 --> 00:12:52,720
تستمرّين في التغيّر

192
00:12:54,530 --> 00:12:58,670
من العسير عليّ حقًّا أن أتقبّل ذلك

193
00:13:02,290 --> 00:13:03,470
روزوال؟

194
00:13:04,360 --> 00:13:06,210
،قراركِ لا يُقدّر بثمن

195
00:13:06,210 --> 00:13:08,430
وإرادتكِ في المضيّ قدمًا نبيلة

196
00:13:08,930 --> 00:13:12,100
لهذا تحديدًا أشفق عليكِ

197
00:13:12,850 --> 00:13:16,100
القرار الذي اتّخذتِه الذي يبرّر تأذّيكِ

198
00:13:16,100 --> 00:13:19,270
لا معنى له بالفعل في هذا العالم
الذي سوف يفنى قريبًا

199
00:13:19,270 --> 00:13:21,280
العالم... سيفنى؟

200
00:13:21,280 --> 00:13:24,570
بعبارة أدقّ، إنّه يتّجه نحو حتفه

201
00:13:24,930 --> 00:13:27,170
انحرف هذا العالم عن المسار الصحيح

202
00:13:27,170 --> 00:13:30,290
وهو الآن يمضي نحو الوجهة الخاطئة

203
00:13:30,290 --> 00:13:33,620
المأوى والانتخابات الملكيّة لم يعودا مُجديين

204
00:13:34,030 --> 00:13:35,100
روزوال؟

205
00:13:35,610 --> 00:13:37,710
لماذا تبدو وكأنّك تستسلم؟

206
00:13:38,090 --> 00:13:41,570
ألم تكن أنت... ألم تكن أنت وأنا من بدأنا بهذا؟

207
00:13:41,570 --> 00:13:44,630
!فتستسلم قبل أن ينتهي ذلك؟ لن أسمح بهذا

208
00:13:45,480 --> 00:13:48,340
ماذا تريدين أن تفعلي إذًا؟

209
00:13:48,570 --> 00:13:50,330
!لا أعلم

210
00:13:50,330 --> 00:13:52,520
!لكن الخطأ يبقى خطأ

211
00:13:52,520 --> 00:13:53,800
!لا تستسلم

212
00:13:53,800 --> 00:13:55,600
!فهذه أنانيّة شديدة

213
00:13:56,480 --> 00:14:00,140
تبدين حقًّا مثل سوبارو-كن

214
00:14:01,670 --> 00:14:07,180
كم سيتحقّق من كلامكِ المتبجّح هذا يا تُرى؟

215
00:14:07,550 --> 00:14:11,060
هذا ما سأريك إيّاه

216
00:14:11,060 --> 00:14:15,000
في المقبرة... لا، خارج المأوى أيضًا

217
00:14:16,860 --> 00:14:18,180
...إيميليا-ساما

218
00:14:18,180 --> 00:14:20,000
سأذهب الآن يا رام

219
00:14:20,000 --> 00:14:23,960
أعدكِ أنّني سأهتمّ بالمعروف الذي طلبتِه منّي

220
00:14:33,350 --> 00:14:36,320
كنتُ أنا ومعلّمتي من بدأنا بذلك

221
00:14:36,320 --> 00:14:39,820
هذا الشيء الوحيد الذي أخطأتِه يا إيميليا-ساما

222
00:14:51,620 --> 00:14:56,510
يبدو أنّ عزيمتها أقوى بكثير مما توقّعت

223
00:14:56,990 --> 00:15:00,960
روزوال-ساما، كم سمعت من محادثتنا؟

224
00:15:00,960 --> 00:15:04,300
رأيتكِ تركعين أمامها

225
00:15:04,300 --> 00:15:06,170
يا لبراعتكِ في التّمثيل

226
00:15:06,770 --> 00:15:11,470
سمعتُ أنكِ ساعدتهم مع غارفيل

227
00:15:11,470 --> 00:15:14,890
بالطبع، أعلم أنكِ اعتقدتِ أنه كان التصرّف الصائب

228
00:15:15,690 --> 00:15:19,560
ماذا تنوي أن تفعل الآن يا روزوال-ساما؟

229
00:15:20,100 --> 00:15:23,430
،لم تتغيّر رغبتي

230
00:15:23,810 --> 00:15:26,740
رغم أنّي مضطرّ الآن لمضاعفة جهودي لأجل ذلك

231
00:15:26,740 --> 00:15:27,490
...ما الذي عليّ

232
00:15:27,490 --> 00:15:30,530
ابقي هنا وانتظري عودة إيميليا-ساما

233
00:15:30,980 --> 00:15:34,040
،إن لم يكن هنا أحد للترحيب بعودة روحها الباسلة

234
00:15:34,040 --> 00:15:38,370
فحتّى قلبي سيتألّم لأجلها

235
00:15:48,640 --> 00:15:54,320
سبب قبولي بهذه المجازفة كان لأنّها بدت
وكأنّها فرصتي الأمثل لتحقيق أمنيتي

236
00:15:55,620 --> 00:15:57,040
مرحبًا يا رام-سان

237
00:15:57,670 --> 00:16:00,770
إنّها أمسية جميلة، أليس كذلك؟
يبدو النسيم عليلًا

238
00:16:01,580 --> 00:16:03,730
أنت الفتى الذي كان رفقة باروسو

239
00:16:03,730 --> 00:16:07,840
يبدو أنّ ناتسكي-سان لا يعتبركِ عدوّة

240
00:16:07,840 --> 00:16:08,820
،إن كان محقًّا

241
00:16:09,200 --> 00:16:14,200
فأعتقد يمكننا مساعدتكِ في تحقيق ما تريدينه حقًّا

242
00:16:15,730 --> 00:16:16,700
مزعج للغاية

243
00:16:17,760 --> 00:16:20,160
قلتُ أنّك مزعج

244
00:16:21,200 --> 00:16:22,700
أعطِني مزيدًا من التّفاصيل

245
00:16:24,740 --> 00:16:26,380
هذه فكرتي

246
00:16:26,380 --> 00:16:27,740
ما رأيكِ؟

247
00:16:31,020 --> 00:16:33,970
إن أردت مساعدتي، لديّ ثلاثة شروط

248
00:16:34,510 --> 00:16:38,560
أوّلًا، أؤيّد بشدّة خدش كبرياء غارفيل

249
00:16:38,560 --> 00:16:42,630
لكن بعد أن تفعلا ذلك، يجب أن تدعاه لي

250
00:16:43,070 --> 00:16:43,980
عُلِم

251
00:16:44,700 --> 00:16:46,320
ثمّ هناك إيميليا-ساما

252
00:16:46,870 --> 00:16:48,900
دع باروسو يفعل شيئًا بشأنها

253
00:16:48,900 --> 00:16:52,360
أعتقد سيكون هذا الأمر عائدًا
لناتسكي-سان وإيميليا-ساما

254
00:16:52,870 --> 00:16:56,110
لذا... أشعر وكأنّ الشرط الثّالث
سيكون فريدًا من نوعه

255
00:16:56,470 --> 00:16:57,570
أحمق

256
00:16:57,570 --> 00:17:01,870
لا تخبر باروسو عن سبب قبولي
بهذه المجازفة فحسب

257
00:17:02,580 --> 00:17:04,890
لا أريد أن أستسلم في مرحلتي النهائيّة

258
00:17:18,440 --> 00:17:24,030
أعتقد سيكون من السّهل الوصول إلى هنا
إذا استخدم المرء الاستبصار

259
00:17:24,760 --> 00:17:29,010
ألم آمركِ بانتظار إيميليا-ساما؟

260
00:17:29,010 --> 00:17:31,130
أجل، أمرتني

261
00:17:31,130 --> 00:17:32,570
أخبريني إذًا

262
00:17:32,900 --> 00:17:36,780
ما الذي دفعكِ للمجيء إلى هنا؟

263
00:17:37,260 --> 00:17:38,530
الجواب بسيط

264
00:17:39,140 --> 00:17:40,710
...أتيتُ لإبعادك

265
00:17:42,030 --> 00:17:44,870
عن أوهام السّاحرة

266
00:17:46,240 --> 00:17:49,030
أوهام؟

267
00:17:49,030 --> 00:17:52,200
،مضت سنوات منذ أشهرتِ عصاكِ في وجهي

268
00:17:52,200 --> 00:17:56,270
لكن خسارة أن تفعلي ذلك هنا وأن
"تطلقي عليها "أوهام

269
00:17:56,270 --> 00:17:59,580
لطالما اعتبرتُها كذلك. لكن لم أكن أصرّح علنًا

270
00:17:59,580 --> 00:18:00,930
أليس هذا واضحًا؟

271
00:18:01,140 --> 00:18:02,410
...واضح

272
00:18:02,930 --> 00:18:08,440
حسنًا، من وجهة نظرك، كانت أيّامكِ المُهينة
التي قضيتِها مُطيعة لي طويلة

273
00:18:09,220 --> 00:18:13,110
اعتبرتُ سلوككِ هو طريقتكِ في التعبير عن إخلاصكِ

274
00:18:14,830 --> 00:18:18,250
،ضرب غارف أدّى غرضين: تحقيق هدفي

275
00:18:18,250 --> 00:18:21,200
ومحاولة لتصحيح غبائه

276
00:18:21,720 --> 00:18:25,410
لا أعلم ماذا خطّطا لفعله لو لم أكن موجودة

277
00:18:25,800 --> 00:18:30,300
لا أنكر أنّ كلّ ذلك قد سار بسلاسة في النّهاية

278
00:18:30,300 --> 00:18:35,140
سيختار سوبارو-كن وبشكل طبيعي سلوك
طريق سويّ في المجابهة الأخيرة

279
00:18:39,020 --> 00:18:42,970
لم يكن من الخطأ المُراهنة على ميزته الجيّدة تلك

280
00:18:45,380 --> 00:18:47,730
لديك الكتاب، صحيح؟

281
00:18:50,490 --> 00:18:52,980
،في المكان المُخصّص للمواجهة الأخيرة

282
00:18:52,980 --> 00:18:55,910
،في المسرح الذي تتصرّف فيه بمفردك

283
00:18:56,290 --> 00:19:01,410
من المستحيل ألّا تحمل مجلّد الحكمة الذي
تعتمد عليه أكثر من أي شيء آخر

284
00:19:03,300 --> 00:19:05,730
لم أنسَ بتاتًا

285
00:19:05,730 --> 00:19:10,120
العهد الوحيد الذي تبادلناه أنا وأنتِ

286
00:19:10,580 --> 00:19:12,720
،من يشهرون السّيف ينبغي أن يموتوا بالسّيف

287
00:19:12,720 --> 00:19:14,720
،ومن يعتمدون على السّحر ينبغي أن يموتوا بالسّحر

288
00:19:14,720 --> 00:19:17,090
ومن يسلّمون أنفسهم للنار ينبغي أن يموتوا بالنّار

289
00:19:17,650 --> 00:19:20,840
ومن يطلبون معروفًا من شيطان ينبغي
أن يموتوا على يد ذلك الشّيطان

290
00:19:21,350 --> 00:19:25,680
ما يعتمد عليه المرء ينبغي أن يكون نفس
الشيء الذي يؤدّي إلى حتفه

291
00:19:26,710 --> 00:19:28,960
والآن قد حان الوقت

292
00:19:28,960 --> 00:19:33,650
الآن بعد أن فقدتُ ما أرغبه، أقدّم نفسي لكِ

293
00:19:34,130 --> 00:19:36,450
،إن لم تمانعي كَوني مجرّد قشرة فارغة

294
00:19:36,450 --> 00:19:40,000
.يمكنكِ أن تفعلي ما يحلو لكِ بي
ذلك هو عهدنا

295
00:19:40,000 --> 00:19:42,070
سواء تركتُك تعيش أو قتلتُك فهذا عائد لي

296
00:19:42,540 --> 00:19:45,600
يمكنكِ أن تنفّذي القصاص أخيرًا

297
00:19:48,480 --> 00:19:49,700
...فأساسًا

298
00:19:50,280 --> 00:19:53,230
لم تملكي خيارًا سوى القسَم بالولاء رغمًا عنكِ

299
00:19:53,230 --> 00:19:57,220
لأحد الرّجال الذين دمّروا موطنكِ وتعيشين معه

300
00:19:57,220 --> 00:20:02,910
رغم أنكِ اضطررتِ لفعل ذلك بعد فقدانكِ قرنكِ
،وقدرتكِ في الحفاظ على هيئتك

301
00:20:02,910 --> 00:20:05,260
معاناة بهذه الدرجة نادرة جدًا

302
00:20:06,020 --> 00:20:09,010
لا يوجد بيدق أكثر فائدة منكِ

303
00:20:09,010 --> 00:20:11,370
...لهذا السبب أقول أنها خسارة

304
00:20:11,370 --> 00:20:13,390
...كان قراركِ نوعًا ما

305
00:20:13,730 --> 00:20:15,520
يفتقر للنضج...

306
00:20:15,520 --> 00:20:20,720
من المدهش أنّكِ خلقتِ وضعًا أضطرّ فيه
لحمل مُجلّد الحكمة

307
00:20:20,720 --> 00:20:25,650
كان ينبغي أن تتجاهلي هذه الخطوة الأخيرة
تجاه التصرّف الذي كنتُ أنوي اتّخاذه

308
00:20:25,650 --> 00:20:27,530
!ذلك وحده هو الخسارة الحقيقيّة

309
00:20:31,950 --> 00:20:33,990
هذه هي الفتاة الصغيرة الثّمينة التي وهبت حياتها

310
00:20:33,990 --> 00:20:37,340
لإنقاذ صديقتها بواسطة لعِب وظيفة نُواة المأوى

311
00:20:37,990 --> 00:20:40,840
لكن هدفي لا يشملها هي

312
00:20:41,830 --> 00:20:45,760
تنوي استخدام هذه البلّورة السحريّة
لإطلاق سحر عظيم؟

313
00:20:46,050 --> 00:20:48,780
عظيم لدرجة تغيير الطقس

314
00:20:48,780 --> 00:20:52,720
بموجب المُجلّد، سأجعل الثّلج يتساقط في المأوى

315
00:20:52,720 --> 00:20:55,060
،لاستخدام هذا السّحر

316
00:20:55,940 --> 00:21:00,370
أحتاج لتركيز هائل واستعمال دقيق جدًّا للمانا

317
00:21:00,370 --> 00:21:03,770
إذا كنتُ منشغلًا بذلك، فبمقدوركِ حتمًا

318
00:21:03,770 --> 00:21:05,450
أن تطلقي عليّ

319
00:21:06,400 --> 00:21:09,160
لن يكون هناك أي معنى من ذلك

320
00:21:09,450 --> 00:21:13,650
وهل هناك معنى من استدراجي نحو الخنوع
عندما أكون في أفضل حالاتي؟

321
00:21:13,650 --> 00:21:17,170
أم أنّكِ أردتِ ببساطة تدميري في أسرع وقت؟

322
00:21:17,510 --> 00:21:21,500
لا. أنت حقًّا لا تفهم شيئًا على الإطلاق

323
00:21:25,840 --> 00:21:27,920
لن أسمح بتحقيق أمنيتك

324
00:21:28,330 --> 00:21:32,970
أن تقدّم نفسك كقشرة فارغة بعد أن تتحقّق
أمنيتك لن تعني شيئًا

325
00:21:33,540 --> 00:21:36,940
حصولي عليك وأنت بحالة مُحطّمة لن ترضيني

326
00:21:37,240 --> 00:21:39,980
عجبًا، عجبًا، كم أنتِ طمّاعة

327
00:21:40,370 --> 00:21:43,070
لكن هل تعتقدين أنكِ تستطيعين هزيمتي الآن؟

328
00:21:43,490 --> 00:21:45,480
لا، أنا متأكّدة أنّني لا أستطيع

329
00:21:45,480 --> 00:21:49,810
أنا الأدرى بقوّتك بعد معلّمتك يا روزوال-ساما

330
00:21:49,810 --> 00:21:54,910
إذًا كيف تنوين بالضبط تحقيق هدفكِ؟

331
00:21:57,200 --> 00:21:58,620
لا يمكنني الفوز بمفردي

332
00:21:58,990 --> 00:22:01,600
...هذا واضح. لذا

333
00:22:04,760 --> 00:22:07,970
،إذا كانت معركة اثنين ضدّ واحد
فأعتقد لدينا الأفضليّة؟

334
00:22:09,240 --> 00:22:13,810
إذًا هذا هو السّبب الرئيسي الذي جعلكِ
!توافقين على خطّة سوبارو-كن؟

335
00:22:13,810 --> 00:22:16,060
أخبرتُك يا روزوال-ساما

336
00:22:16,840 --> 00:22:20,480
سوف أنتزعك من أوهام السّاحرة

337
00:22:23,070 --> 00:22:26,850
وأنا مجرّد روح ضالّة عابرة

338
00:22:27,630 --> 00:22:31,470
!حسنًا، حان وقت البدء من حيث توقّفنا سابقًا

339
00:22:34,770 --> 00:22:35,790
!تعاليا

340
00:22:37,590 --> 00:22:38,920
!كما تشاء

341
00:22:49,140 --> 00:22:51,340
!عليّ أن أهرب... عليّ أن أهرب

342
00:22:55,110 --> 00:22:56,560
ريم-سان؟

343
00:22:57,460 --> 00:23:00,270
...لكن... لكن، لكن... هذا لا يمكن

344
00:23:00,880 --> 00:23:03,270
...لكن... ريم-سان

345
00:23:07,140 --> 00:23:10,140
!لكن... أنا واثقة أنّ هذا ما كان سوبارو ليفعله

346
00:23:11,120 --> 00:23:11,980
...لذا

347
00:23:18,180 --> 00:23:19,210
...ريم-سان

348
00:23:24,420 --> 00:23:26,670
يا لكِ من فتاة صغيرة ظريفة

349
00:23:33,200 --> 00:23:35,890
لا بدّ أنكِ الخادمة الأصغر إذًا؟

350
00:23:37,210 --> 00:23:38,670
هل ترتجفين؟

351
00:23:39,570 --> 00:23:40,720
لا تقلقي

352
00:23:41,290 --> 00:23:45,090
أنا متأكّدة أنّ أمعاءكِ جميلة للغاية

353
00:23:47,160 --> 00:23:48,170
فتاة مُطيعة

354
00:23:49,180 --> 00:23:51,030
سأرسلكِ لملاقاة الملائكة

355
00:23:51,900 --> 00:23:52,660
!بيترا

356
00:23:53,860 --> 00:23:55,410
!فريدريكا-نيساما

357
00:23:55,410 --> 00:23:57,200
!أنتِ فتاة سيّئة يا بيترا

358
00:23:57,580 --> 00:23:59,250
قلتُ لكِ اهربي

359
00:23:59,250 --> 00:24:00,710
!ستُعاقبين لاحقًا

360
00:24:01,920 --> 00:24:03,670
!حسنًا... حسنًا

361
00:24:04,030 --> 00:24:05,420
كم هذا جميل

362
00:24:05,920 --> 00:24:08,510
لا بدّ أنكِ الخادمة الأكبر إذًا

363
00:24:08,980 --> 00:24:13,310
يسرّني أنّكما معًا وتجمعكما علاقة صداقة أيضًا

364
00:24:13,680 --> 00:24:15,820
سأضع أمعاءكما جنبًا إلى جنب

365
00:24:15,820 --> 00:24:18,310
وأرى ما إن كانت متوافقة مع بعضها الآخر

366
00:24:18,530 --> 00:24:22,830
من البداية حتّى النهاية، ولا كلمة قلتِها
إلى الآن تبدو منطقيّة

367
00:24:22,830 --> 00:24:24,760
هذه ليست طريقة لائقة للتفكير

368
00:24:24,760 --> 00:24:26,360
دماء شبه بشريّة حسبما أرى

369
00:24:26,360 --> 00:24:31,680
لكنّ مهاراتي تحسّنت بعد خوضي لتجربة
كادت تودي بحياتي في العاصمة الملكيّة

370
00:24:31,680 --> 00:24:33,110
لا يمكنكِ مجاراتي

371
00:24:33,540 --> 00:24:37,530
آمل لو ألقي اللّوم على الشخص
الذي فشل في القضاء عليكِ حينها

372
00:24:40,970 --> 00:24:43,620
بيترا، اخرجي من القصر حالًا

373
00:24:44,120 --> 00:24:46,960
...لـ-لكن... ني-ساما

374
00:24:49,620 --> 00:24:51,950
،لا أعلم من أرسلكِ

375
00:24:51,950 --> 00:24:54,340
لكن يبدو أنّ هدفكِ هو أنا وبيترا

376
00:24:54,690 --> 00:24:55,300
أجل

377
00:24:56,300 --> 00:24:58,800
خادمتان وفتاة روح صغيرة

378
00:24:59,230 --> 00:25:02,430
لم أقطع روحًا من قبل، لذا أنا متحمّسة للغاية

379
00:24:59,840 --> 00:25:00,390
!اذهبي

380
00:25:00,800 --> 00:25:01,470
!حسنًا

381
00:25:05,600 --> 00:25:07,740
شخصيّتكِ أسوأ من ذوقكِ

382
00:25:08,120 --> 00:25:09,180
إنها فتاة مُطيعة

383
00:25:09,180 --> 00:25:10,690
!أنا فخورة جدًا بها

384
00:25:19,700 --> 00:25:20,730
...ني-ساما

385
00:25:22,000 --> 00:25:24,720
!ربما تستطيع بياتريس-ساما فعل شيء ما

386
00:25:25,430 --> 00:25:26,200
!هنا

387
00:25:27,020 --> 00:25:27,790
...لا

388
00:25:27,790 --> 00:25:29,290
...هنا؟! لا

389
00:25:29,650 --> 00:25:30,460
!ليس هنا أيضًا

390
00:25:30,770 --> 00:25:31,500
...ليس هنا

391
00:25:33,780 --> 00:25:35,420
ليست هنا أيضًا

392
00:25:37,820 --> 00:25:38,890
...إنّ ني-ساما

393
00:25:40,440 --> 00:25:41,750
...إنّ ريم-سان

394
00:25:55,870 --> 00:25:57,260
...سوبارو

395
00:25:58,200 --> 00:25:59,970
!ساعدني

396
00:26:04,460 --> 00:26:07,370
حسنًا. لكِ ذلك يا بيترا

397
00:26:10,580 --> 00:26:14,530
آسف لتأخّري، لكن أتيتُ للمساعدة

398
00:26:15,260 --> 00:26:17,630
أنا مسرور لأنكِ بخير يا بيترا

399
00:26:19,280 --> 00:26:23,470
أهذا أنت يا سوبارو؟ أتيتَ لأجلنا؟

400
00:26:23,910 --> 00:26:25,500
هذا أنا، أتيتُ لأجلكن

401
00:26:25,500 --> 00:26:27,600
—سوبارو، إنّ فريدريكا-نيساما

402
00:26:27,600 --> 00:26:29,120
!دعي الأمر لي فحسب

403
00:26:29,120 --> 00:26:33,940
هذا ما كنتُ أودّ قوله، لكن لو انقضضتُ
هناك، لمتُّ في طرفة عين

404
00:26:34,180 --> 00:26:38,760
لذا أرسلتُ تعزيزات قوية جدًا بدلًا من ذلك

405
00:26:38,760 --> 00:26:40,680
،في ليلة لمّ الشمل

406
00:26:40,680 --> 00:26:43,530
الأشخاص الذين يعترضون طريقنا لم يعودوا عائقًا

407
00:26:45,340 --> 00:26:49,090
لماذا تصرّين على التصويب نحو أسفل صدري في كلّ مرّة؟

408
00:26:49,090 --> 00:26:51,370
يمكنكِ القول أنها هوايتي فحسب

409
00:26:51,370 --> 00:26:53,090
فأنا صيّادة الأمعاء

410
00:26:53,090 --> 00:26:54,880
!هوايتي هي شقّ البطون

411
00:26:54,880 --> 00:26:56,890
...يقول الزعيم

412
00:26:58,920 --> 00:27:02,550
أنّ الدّفاع خير وسيلة للهجوم

413
00:27:02,550 --> 00:27:07,270
لذا إذا استخدمتُ درعًا مخصّصًا
...للدفاع للهجوم بدلًا من ذلك

414
00:27:08,180 --> 00:27:11,890
،فيمكن أن يجتمع أفضل دفاع وأفضل هجوم معًا

415
00:27:11,890 --> 00:27:15,570
!ما يجعلني الشخص الأقوى هنا، صحيح؟

416
00:27:15,810 --> 00:27:18,820
ألا تعتقدين ذلك يا أختي؟

417
00:27:18,820 --> 00:27:20,480
!أنتِ ضخمة

418
00:27:21,100 --> 00:27:23,080
!لحظة، هل أنتِ أختي؟

419
00:27:23,080 --> 00:27:25,790
ربما ينبغي أن أدعوكِ "أخي الكبير" بدلًا من ذلك

420
00:27:26,820 --> 00:27:29,950
!لا تكن وقحًا في لحظة لقائنا ببعضنا الآخر

421
00:27:34,820 --> 00:27:37,550
غارف، نضجتَ كثيرًا

422
00:27:37,810 --> 00:27:40,530
!يبدو هذا تهكّمًا

423
00:27:40,530 --> 00:27:43,430
!أنتِ من صار ضخمًا جدًا

424
00:27:43,890 --> 00:27:44,890
...حسنًا

425
00:27:45,440 --> 00:27:48,980
هل يمكنني مقاطعة لقائكما السّعيد الآن؟

426
00:27:48,980 --> 00:27:51,560
لطفًا منكِ أن تنتظرينا

427
00:27:51,860 --> 00:27:53,430
—اسمعي يا أختي

428
00:27:53,430 --> 00:27:56,640
أختي، هل تعرفين فتاة تُدعى ريم؟

429
00:27:57,650 --> 00:27:59,620
أجل، إنها في القصر

430
00:27:59,620 --> 00:28:01,780
قال سوبارو-ساما أنها أخت رام

431
00:28:02,210 --> 00:28:05,490
أخرجي ريم من هنا حالما تحظين بفرصة

432
00:28:05,490 --> 00:28:08,500
فأنا سأكون منشغلًا مع هذه الساقطة

433
00:28:08,860 --> 00:28:09,830
ماذا تقول؟

434
00:28:10,400 --> 00:28:11,840
آسف يا أختي

435
00:28:12,220 --> 00:28:16,420
إنها ليست من النوع الذي أستطيع مواجهته
بينما أقلق على من يقف خلفي

436
00:28:17,020 --> 00:28:17,970
...غارف

437
00:28:18,580 --> 00:28:21,050
ترين ذراعي، أليس كذلك؟

438
00:28:21,450 --> 00:28:26,000
هذا هو الدرع الذي كنّا أنا وأنتِ
نلعب به في طفولتنا

439
00:28:26,400 --> 00:28:31,790
كان الجري معكِ هو ما جعلني الأقوى

440
00:28:38,900 --> 00:28:41,420
!تعالي إليّ أيتها الساقطة بالرداء الأسود

441
00:28:41,420 --> 00:28:43,650
!سنحتفل بخروجي من المأوى

442
00:28:43,990 --> 00:28:50,570
!أول شيء سأفعله هو ضرب أوّل جدار في طريقي

443
00:29:03,250 --> 00:29:07,020
لماذا أنت هنا؟ لم أستدعك

444
00:29:07,020 --> 00:29:11,270
آسف، لكن أنا شخص يأتي سواء
استُدعي أم لم يُستدعَ

445
00:29:11,530 --> 00:29:13,990
أنانيّ كعادتك، على ما أفترض

446
00:29:13,990 --> 00:29:15,980
هذا صحيح. أنا أنانيّ

447
00:29:16,820 --> 00:29:19,120
سأخرجكِ من هنا يا بياتريس

448
00:29:19,730 --> 00:29:24,240
هذه المرّة، ستدعينني أخرجكِ إلى ضوء الشمس

449
00:29:24,520 --> 00:29:28,940
ثمّ سنلعب حتّى يسوَدّ فستانكِ من الوحل