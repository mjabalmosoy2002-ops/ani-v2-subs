1
00:00:17,080 --> 00:00:18,160
لا، لا

2
00:02:18,370 --> 00:02:20,160
صباح الخير يا آي-آي

3
00:02:20,160 --> 00:02:24,350
صباح الخير

4
00:02:36,510 --> 00:02:39,310
لنناقش التفاصيل بعد الدوام المدرسي

5
00:02:39,310 --> 00:02:40,380
حسناً

6
00:02:40,380 --> 00:02:41,760
أحسنتُم صنعاً جميعاً

7
00:02:41,760 --> 00:02:43,140
أحسنتُم صنعاً

8
00:02:47,880 --> 00:02:51,900
هل سيوافقُ رؤساء الأندية على هذا الاقتراح؟

9
00:02:52,330 --> 00:02:55,840
أظنُّهم سيُوافقون حالما يلمسون استعدادنا لأداء

10
00:02:55,840 --> 00:02:57,720
كلّ المهام المتنوِّعة

11
00:02:58,060 --> 00:03:03,160
ما يهمُّ الآن هو كم نستطيعُ أن نوهمهم بأنَّنا قد توصّلنا إلى حلّ تسوية

12
00:03:04,330 --> 00:03:07,290
تقصدين كي لا يظنّوا أنَّنا نتنازل؟

13
00:03:07,290 --> 00:03:08,280
نعم

14
00:03:11,390 --> 00:03:12,980
المعذرة

15
00:03:15,260 --> 00:03:17,520
كيف سنخبرهم؟

16
00:03:25,750 --> 00:03:28,700
أما زلت تفكِّرُ بمهمّة ذلك اليوم؟

17
00:03:28,700 --> 00:03:31,820
حدّثتُكِ عن جرح كونوي-سان

18
00:03:32,120 --> 00:03:33,260
إنها صدفة

19
00:03:33,260 --> 00:03:35,310
حتّى لو كانَتْ كذلك، لا أكفُّ عن التفكير في الأمر

20
00:03:35,310 --> 00:03:37,920
لا بدّ وأنَّ سوزوكي-سان تخفي شيئاً

21
00:03:38,970 --> 00:03:40,680
،يمكنُك أن تدّعي أنَّك محقِّق ما تشاء

22
00:03:40,680 --> 00:03:42,840
لكن أريدُك أن تعمل على الحفلة الثانوية

23
00:03:42,840 --> 00:03:46,780
لكنّكِ أنتِ من قال أنّها أرادت القيام بحفلة ثانوية يا رينا-سينباي

24
00:03:50,060 --> 00:03:51,420
أعتمدُ عليك

25
00:03:56,260 --> 00:03:58,670
إيزومي-سينباي، صباح الخير

26
00:03:58,670 --> 00:04:03,470
صباح الخير

27
00:03:59,960 --> 00:04:01,070
صباح النُّور

28
00:04:03,470 --> 00:04:05,900
إيزومي-سينباي رائعة حقاً

29
00:04:05,900 --> 00:04:07,470
أنا مُعجبة بها

30
00:04:07,470 --> 00:04:09,590
،خلال حكم أحد الأباطِرة

31
00:04:09,590 --> 00:04:13,000
،عندما كان عددٌ من سيّدات البلاط والعمّال يخدمون الامبراطور

32
00:04:13,000 --> 00:04:15,800
كانَتْ هنالِك سيّدة واحدة ليسَتْ من طبقة نبيلة معيّنة

33
00:04:15,800 --> 00:04:17,730
...اكتسبَتْ استحسان الامبراطور

34
00:04:41,340 --> 00:04:42,760
هل لي بخدمتك؟

35
00:04:44,920 --> 00:04:48,760
يبدو أنّكِ متوجِّهة إلى مكانٍ مهجور لتناول الغداء

36
00:04:49,120 --> 00:04:50,370
أنا ذاهبة صوبَ حجرة مستودع الرياضة

37
00:04:50,660 --> 00:04:52,770
طُلِبَ منِّي التحضُّر لحصّة الرياضة عصر اليوم

38
00:04:53,600 --> 00:04:55,460
حقاً؟

39
00:04:55,760 --> 00:04:57,650
هل أنتَ مهتمٌّ بي؟

40
00:04:57,650 --> 00:04:58,270
ماذا؟

41
00:05:01,070 --> 00:05:02,920
نعم، أنا مهتمٌّ جداً

42
00:05:02,920 --> 00:05:04,180
أيعترف لها؟

43
00:05:04,180 --> 00:05:06,030
لا، إنّه يردُّ على اعترافِها

44
00:05:07,380 --> 00:05:08,200
بالحبّ

45
00:05:08,600 --> 00:05:11,230
كلّا! الأمرُ ليس كذلك

46
00:05:11,230 --> 00:05:12,400
صدّقاني

47
00:05:12,400 --> 00:05:13,240
المعذرة

48
00:05:13,240 --> 00:05:14,270
لا يبدو لي كذلك

49
00:05:14,270 --> 00:05:15,710
!قولي شيئاً

50
00:05:16,610 --> 00:05:17,960
ماذا تريدُني أن أقول؟

51
00:05:17,960 --> 00:05:19,500
...ماذا؟ قولي

52
00:05:19,500 --> 00:05:21,410
!انتظري

53
00:05:21,730 --> 00:05:22,720
لقد رفضَتْه

54
00:05:22,720 --> 00:05:23,920
رفضَتْه

55
00:05:23,920 --> 00:05:26,470
أنتُما منسجمتان أكثر من المعتاد اليوم

56
00:05:26,980 --> 00:05:28,040
،على أي حال

57
00:05:28,040 --> 00:05:32,190
فكّرتُ بطريقةٍ لتوزيع مُقترح الحفلة الثانويّة

58
00:05:32,190 --> 00:05:33,220
إنّه يتهرّبُ من المسألة

59
00:05:33,840 --> 00:05:35,800
...هوّنا عليكما

60
00:05:38,620 --> 00:05:42,700
سيديرُ مجلسُ الطلبة وينفّذُ كلّ شيء إذاً

61
00:05:43,000 --> 00:05:45,220
أرجوك، فكِّر بالأمر على الأقلّ

62
00:05:45,500 --> 00:05:49,030
كابتن، يُساعدُنا إتسكي طوال الوقت

63
00:05:49,030 --> 00:05:50,960
...نعم، لكن

64
00:05:50,960 --> 00:05:52,240
أرجوك

65
00:05:53,100 --> 00:05:56,040
...ماذا؟ لا يا حضرة الرئيس أرجوكِ

66
00:05:56,040 --> 00:05:58,170
هل سنحظى بدعمك إذاً؟

67
00:06:00,130 --> 00:06:02,670
...في تِلك الحالة، أنا

68
00:06:02,670 --> 00:06:05,000
سأتكلّمُ مع المدير

69
00:06:05,620 --> 00:06:06,670
...وأحاول أن أكون إيجابياً

70
00:06:06,670 --> 00:06:08,250
شكراً لك

71
00:06:11,400 --> 00:06:12,320
أرجوك

72
00:06:12,320 --> 00:06:13,680
لا، شكراً لكِ

73
00:06:33,080 --> 00:06:34,450
شكراً لك

74
00:06:40,560 --> 00:06:43,830
هل القيامُ بهذا مراراً وتكراراً سيَفي بالغرض؟

75
00:06:43,830 --> 00:06:45,880
يبدو أنَّ الأمور تسيرُ على ما يُرام حتّى الآن

76
00:06:46,400 --> 00:06:49,800
،أنتِ مشهورة أصلاً

77
00:06:49,800 --> 00:06:51,630
لهذا سيصغي إليكِ الناس إن تحدّثتِ إليهم

78
00:06:51,630 --> 00:06:53,140
!انتظر لحظة

79
00:06:53,140 --> 00:06:54,230
كوتا؟

80
00:06:54,230 --> 00:06:57,720
سمعتُ أنَّ رينا-سينباي تتجوّلُ بين رُؤساء الأندية لإقناعهم

81
00:06:57,720 --> 00:06:58,640
نعم

82
00:06:58,960 --> 00:07:03,680
وهل هي مستعدّة لفعلِ أي شيء علاوة على ذرفِها الدموع

83
00:07:04,110 --> 00:07:07,920
وتوسّلها من النّاس؟

84
00:07:07,920 --> 00:07:09,650
من قال لك ذلك؟

85
00:07:10,000 --> 00:07:11,960
لماذا لم تأتيا إلى نادي الكاراتيه؟

86
00:07:11,960 --> 00:07:14,540
لكنّك كنتَ موافقاً منذُ البداية

87
00:07:14,860 --> 00:07:17,160
قد أغيِّر رأيي إذاً

88
00:07:17,660 --> 00:07:18,910
كوتا-كُن

89
00:07:19,660 --> 00:07:22,900
أرجوك

90
00:07:22,900 --> 00:07:24,060
هذا مُريب

91
00:07:25,000 --> 00:07:27,140
لقد كان مزاجك غريباً مؤخّراً

92
00:07:27,140 --> 00:07:30,670
هل لأنَّك أفصحتَ عن مشاعرِك لأيكا-تشان؟

93
00:07:30,670 --> 00:07:31,480
ماذا؟

94
00:07:31,480 --> 00:07:32,580
أفصحت؟

95
00:07:32,580 --> 00:07:33,540
!لا

96
00:07:33,540 --> 00:07:34,930
يبدو أنّه فعل

97
00:07:34,930 --> 00:07:39,860
يجدرُ بهما أن يكونا رئيسين تشريفيين في الحفلةِ الثانويّة فحسب

98
00:07:39,860 --> 00:07:41,030
!لن نكون كذلك

99
00:07:41,960 --> 00:07:44,280
المسألة ليسَتْ كذلك، قلتُ لك في هذا الصّباح

100
00:07:44,280 --> 00:07:45,120
...إنَّ سوزوكي-سان

101
00:07:45,120 --> 00:07:46,270
لِمَ لا تفعل إذاً؟

102
00:07:46,270 --> 00:07:46,940
ماذا؟

103
00:07:47,390 --> 00:07:49,570
كُن الرئيس التشريفيّ برفقةِ أيكا-سان

104
00:07:51,420 --> 00:07:53,160
لن أفعل ذلك

105
00:07:53,160 --> 00:07:54,990
ما الذي يجري؟

106
00:07:57,390 --> 00:07:58,380
انتظار الزبائن؟

107
00:07:58,380 --> 00:08:00,500
نعم، في مقهى النّادِلات الذي يديرُه صفُّنا

108
00:08:01,110 --> 00:08:03,920
أي-أي، هل ستنتظرين الزبائن معنا؟

109
00:08:03,920 --> 00:08:05,380
لديكِ جسدٌ جميل

110
00:08:05,380 --> 00:08:07,260
أنا متأكِّدة أنّكِ ستكونين جميلة بالزيّ الرسميّ

111
00:08:07,260 --> 00:08:09,330
سنحقّقُ نجاحاً باهراً

112
00:08:10,040 --> 00:08:12,780
هل أحتاجُ إلى هذه الشريطة لانتظارِ الزبائن؟

113
00:08:11,380 --> 00:08:15,390
شريطة من الخلف

114
00:08:11,380 --> 00:08:15,390
أطراف أربِطة

115
00:08:12,780 --> 00:08:14,310
الشريطة مهمّة

116
00:08:16,230 --> 00:08:17,390
لن تفعلي؟

117
00:08:17,820 --> 00:08:18,920
لا أمانع

118
00:08:18,920 --> 00:08:20,140
حقّاً؟

119
00:08:20,140 --> 00:08:24,510
بصِفتي طالبة في هذا الصفّ، مُساعدتكم هي مسؤولية على عاتقي

120
00:08:24,510 --> 00:08:26,150
شكراً يا أي أي

121
00:08:27,470 --> 00:08:29,150
هذا رائع

122
00:08:31,320 --> 00:08:32,900
المعذرة

123
00:08:35,420 --> 00:08:39,200
إن حصَلنا على موافقة من كافّة رؤساء
الأندية وعُرفاء الصفّ

124
00:08:39,200 --> 00:08:40,420
فسنكونُ على أهبةِ الاستعداد

125
00:08:43,280 --> 00:08:44,410
هل تريدُ القيام بذلك بهذا الإلحاح؟

126
00:08:46,660 --> 00:08:48,170
أن تكون رئيساً تشريفياً للحفلة الثانوية

127
00:08:49,900 --> 00:08:51,170
...قلتُ لكِ

128
00:08:51,800 --> 00:08:55,180
أنتِ من قال أنّها تريدُ أن تقيم حفلةً ثانوية

129
00:08:55,510 --> 00:08:57,540
هل اختفى شخصٌ مجدداً؟

130
00:08:57,860 --> 00:09:01,610
لقد ازدادوا نشاطاً مؤخّراً

131
00:09:01,610 --> 00:09:02,740
فهمت

132
00:09:03,010 --> 00:09:05,470
سأجمعُ المعلومات غداً

133
00:09:05,470 --> 00:09:07,190
لقد أصبح الوضعُ متوتِّراً

134
00:09:07,820 --> 00:09:09,830
...لا أظنُّني بحاجةٍ للتأكيد على هذا، لكن

135
00:09:09,830 --> 00:09:10,690
ماذا؟

136
00:09:11,120 --> 00:09:15,680
لا تنسي أنّكِ مُوكَّلة بمهمّةٍ هناك أيضاً

137
00:09:16,760 --> 00:09:17,360
حاضر

138
00:09:38,680 --> 00:09:41,200
إنّها مستدعية شقراء

139
00:09:41,720 --> 00:09:43,560
مستدعية؟

140
00:09:43,560 --> 00:09:45,560
لا أدري

141
00:09:46,220 --> 00:09:47,620
هل حدث شيء؟

142
00:09:47,950 --> 00:09:48,810
جيّد

143
00:09:49,370 --> 00:09:50,760
هل ستُساعدينني؟

144
00:09:50,760 --> 00:09:54,360
أنا أسألُ الناسَ ما إن كانوا قد رأوا سوزوكي-سان في اللّعبة

145
00:09:55,740 --> 00:09:56,840
هل من مُشكلة؟

146
00:09:57,140 --> 00:10:01,020
أنتَ مفتونٌ بها في الحياة الواقعيّة وفي اللّعبة أيضاً

147
00:10:03,250 --> 00:10:04,080
ماذا؟

148
00:10:04,080 --> 00:10:06,090
هل أنتِ غاضبة من شيء ما؟

149
00:10:06,400 --> 00:10:07,430
ليس تماماً

150
00:10:07,860 --> 00:10:10,250
كيد، سيلفر

151
00:10:13,460 --> 00:10:14,640
أيكا؟

152
00:10:14,640 --> 00:10:16,340
إنّها مستدعية شقراء

153
00:10:16,800 --> 00:10:19,460
ترتدي قلنسوة مستديرة وشريطة في صدرها

154
00:10:19,770 --> 00:10:21,550
أنتَ تعرفُ أدقّ تفاصيلها

155
00:10:22,700 --> 00:10:25,900
هنالِك كثيرٌ من أعضاءِ آركس بهذه المُواصفات

156
00:10:25,900 --> 00:10:28,020
أبلغني إن رأيتها

157
00:10:30,280 --> 00:10:34,870
كم استغرقَتْ عودة تِلك الفتاة بعدما اختفَتْ؟

158
00:10:34,870 --> 00:10:35,610
ماذا؟

159
00:10:35,610 --> 00:10:37,260
أتقصدين كونوي-سان؟

160
00:10:37,580 --> 00:10:38,290
نعم

161
00:10:38,290 --> 00:10:41,620
عادَتْ بعد يومين، لماذا؟

162
00:10:45,240 --> 00:10:48,580
اختفَتْ طالبة جامعيّة في المنطِقة

163
00:10:49,440 --> 00:10:51,580
باتَ ذلك يتكرّرُ كثيراً، صحيح؟

164
00:10:54,070 --> 00:10:57,980
ويبدو أنّ كادراً ما قد اختفى في مهرجان
محبِّي آركس

165
00:10:58,250 --> 00:11:01,340
الذي أقيمَ قبل أيّام

166
00:11:01,340 --> 00:11:04,570
سيلفر، ما هي أشكال الأشخاص المفقودين؟

167
00:11:04,890 --> 00:11:06,200
لماذا تسأل؟

168
00:11:06,480 --> 00:11:08,610
قد يكونوا في حقلٍ ما

169
00:11:08,610 --> 00:11:11,350
هذا مستحيل، إنّهم بشر حقيقيّون

170
00:11:11,350 --> 00:11:15,310
ألا تزالُ تعتقدُ أنَّ ميكا كانت هنا؟

171
00:11:15,560 --> 00:11:17,860
،إن عثرنا على الطالبة الجامعيّة المفقودة

172
00:11:17,860 --> 00:11:20,640
فقد نجد سوزوكي-سان هناك مجدداً

173
00:11:20,980 --> 00:11:21,960
لنبحث عنهما

174
00:11:22,240 --> 00:11:23,620
ابحث بنفسِك

175
00:11:23,620 --> 00:11:24,480
ماذا؟

176
00:11:24,820 --> 00:11:26,120
حالة طارئة

177
00:11:26,440 --> 00:11:30,080
تتعرّضُ مدينة السفينة أركس لهجوم بواسطة الظلاميين

178
00:11:30,180 --> 00:11:32,750
!انتظري، تمهّلي قليلاً

179
00:11:30,400 --> 00:11:33,630
فليتفضَّل كافّة أعضاء آركس إلى أقرب نافذة مهمّات على الفور رجاء

180
00:11:42,940 --> 00:11:44,390
إتسكي-كُن

181
00:11:44,970 --> 00:11:49,260
...تِلك الأداة النادرة محدودة الكمّية التي كنتَ تبحثُ عنها موجودة في لعبة

182
00:11:52,360 --> 00:11:54,980
أليس لدينا اجتماع مع الرّئيس؟

183
00:12:32,480 --> 00:12:34,980
لا جدوى من اللّحاق بي بهذه الطريقة الرّديئة

184
00:12:37,640 --> 00:12:39,260
لم تشعري بي حتّى الآن

185
00:12:39,260 --> 00:12:40,890
شعرتُ بك من البداية

186
00:12:41,230 --> 00:12:44,530
كنتَ مكشوفاً تماماً لدرجة أنّني لم أشعر برغبة
في التملُّصِ منك

187
00:12:44,890 --> 00:12:48,740
إن كان الفضول ينتابُك فتعالَ إليّ علَناً
بدلاً من التسلُّلِ ورائي

188
00:12:51,700 --> 00:12:53,580
ما الذي تفعلينه هُنا بالضبط؟

189
00:12:53,880 --> 00:12:55,710
لستُ مُضطرّة للإجابة

190
00:12:56,950 --> 00:13:01,600
هذا البرج الشّاهق الطّويل بما يكفي لينطح السّحاب
يُدعى برج إيسكا

191
00:13:02,140 --> 00:13:06,640
إلى جانبِ تزايُد شعبيّة الاتِّصالات اللاسلكيّة فائقة السرعة

192
00:13:04,060 --> 00:13:06,640
لم أره عن كثب من قبل

193
00:13:06,640 --> 00:13:11,390
،والمعروفة بـ"الاتِّصالات الإيثيريّة" والتزام دوليّ

194
00:13:07,120 --> 00:13:09,690
إنّه أضخم ممّا تخيّلت

195
00:13:11,390 --> 00:13:14,640
بدأ بناء الأبراج المذكورة في العالم في عام 2016

196
00:13:15,010 --> 00:13:16,480
...لا يُسمَح لأحد بالدخول

197
00:13:16,480 --> 00:13:17,770
إتسكي؟

198
00:13:18,100 --> 00:13:19,130
سيلفر

199
00:13:19,610 --> 00:13:21,780
موعد غرامي؟ أحسنت

200
00:13:21,780 --> 00:13:23,780
في الواقع، لا

201
00:13:24,090 --> 00:13:25,930
ماذا تفعلين هنا؟

202
00:13:25,930 --> 00:13:28,030
بيتي على مقربة من هنا

203
00:13:28,030 --> 00:13:30,140
ماذا؟ حقّاً؟

204
00:13:31,200 --> 00:13:33,040
هل أنت متوجِّه إلى هناك؟

205
00:13:33,500 --> 00:13:36,820
إنه مكانٌ مشهورٌ بالمقاهي وما شابه

206
00:13:36,820 --> 00:13:38,160
لكن هذا سيئ للغاية

207
00:13:38,540 --> 00:13:39,940
هل حدثَ شيء؟

208
00:13:40,220 --> 00:13:44,360
أتذكرُ التلميذةَ الجامعيةَ المفقودة التي حدّثتُك عنها؟

209
00:13:44,710 --> 00:13:46,550
اختفَتْ في الدّاخل هناك

210
00:13:49,600 --> 00:13:52,400
هل كنتِ متوجِّهة إلى هناك؟

211
00:13:52,400 --> 00:13:55,240
وهل هذه طريقة تتكلّمُ معها بها؟

212
00:13:55,240 --> 00:13:57,120
!انتظري

213
00:13:57,120 --> 00:13:59,100
انظر، لقد أثرتَ غضبها

214
00:13:59,100 --> 00:14:00,410
المسألة ليسَتْ كذلك

215
00:14:00,410 --> 00:14:03,900
حسناً إذاً، أتريدُني أن أكون رفيقتك في هذا الموعد بدلاً من ذلك؟

216
00:14:04,310 --> 00:14:05,400
ماذا؟

217
00:14:05,400 --> 00:14:07,310
أريدُ آيس كريم

218
00:14:07,310 --> 00:14:08,910
!انتظري

219
00:14:12,190 --> 00:14:15,410
تبّاً! كان ذلك عنيفاً

220
00:14:18,020 --> 00:14:20,540
...هل سوزوكي أيكا-سان

221
00:14:20,890 --> 00:14:22,140
لقد عادَتْ

222
00:14:22,140 --> 00:14:23,540
حقّاً؟

223
00:14:26,800 --> 00:14:30,180
عـ-عدتُ للتو

224
00:14:32,160 --> 00:14:36,760
لا يهمّني أينما ذهبت أو برفقةِ من تذهب
في أيّام السبت

225
00:14:36,760 --> 00:14:38,350
حتّى لو كنتَ مع سوزوكي-سان

226
00:14:38,350 --> 00:14:40,560
لم نخرج معاً

227
00:14:40,560 --> 00:14:41,190
!لكن

228
00:14:41,570 --> 00:14:45,300
تختلِف الحكاية عندما تتغيّبُ عن اجتماعِات الحفلة الثانوية
لأجلِ مواعيدك فقط

229
00:14:45,300 --> 00:14:46,690
ولم تجب على هاتفك

230
00:14:47,240 --> 00:14:49,630
نـ-نسيتُ هاتفي في المنزل

231
00:14:49,630 --> 00:14:50,700
لا أعذار

232
00:14:51,260 --> 00:14:52,140
...حسناً

233
00:14:52,520 --> 00:14:56,130
على أي حال، أعتقدُ أنّ حوادث الاختفاء
...طالَتْ سوزوكي-سان أيضاً بعد

234
00:14:56,130 --> 00:14:57,590
لا تغيِّر الموضوع

235
00:14:58,000 --> 00:14:58,960
آسف

236
00:14:59,410 --> 00:15:02,800
أشعرُ بالغيرة قليلاً، لكن أشفقُ عليه في ذات الوقت

237
00:15:06,720 --> 00:15:08,170
لم أرها

238
00:15:09,940 --> 00:15:10,930
ماذا عنك؟

239
00:15:10,930 --> 00:15:12,300
لا أدري

240
00:15:12,820 --> 00:15:14,220
هكذا إذاً

241
00:15:15,250 --> 00:15:17,760
أين سوزوكي-سان؟

242
00:15:17,760 --> 00:15:18,690
إتسكي

243
00:15:19,420 --> 00:15:21,600
شكراً على الغداء

244
00:15:21,600 --> 00:15:22,560
العفو

245
00:15:22,560 --> 00:15:25,110
ماذا؟ سيلفر، هل التقيتِ بإتسكي-كُن؟

246
00:15:25,530 --> 00:15:26,860
عندما كان مع رفيقته

247
00:15:27,790 --> 00:15:29,360
هكذا إذاً

248
00:15:29,690 --> 00:15:31,740
أ-أستأذن

249
00:15:33,940 --> 00:15:34,820
إتسكي

250
00:15:35,800 --> 00:15:37,870
رأيتُ عضوَتَيّ آركس اللّتَين كنتَ تتحدّثُ عنهما

251
00:15:38,220 --> 00:15:40,060
حقاً؟ أين؟

252
00:15:47,250 --> 00:15:48,700
!اقتل

253
00:16:04,260 --> 00:16:05,520
سأساعدكِ

254
00:16:06,440 --> 00:16:07,400
لا حاجة لذلك

255
00:16:38,080 --> 00:16:41,430
!فوميلغيون

256
00:16:54,870 --> 00:16:56,050
رائع

257
00:16:58,780 --> 00:17:00,040
لم يمُت

258
00:17:00,040 --> 00:17:01,160
!اتركيه لي

259
00:17:05,390 --> 00:17:06,710
!لا تفعل يا إتسكي

260
00:17:18,940 --> 00:17:20,010
هذا سيئ

261
00:17:26,200 --> 00:17:27,270
!إتسكي

262
00:17:56,230 --> 00:17:58,800
...هذا قرص أوفر إيند

263
00:18:24,440 --> 00:18:25,330
هل أنت بخير؟

264
00:18:25,330 --> 00:18:28,830
سوزوكي-سان، من أنتِ بالضبط؟

265
00:18:28,830 --> 00:18:29,800
...ما الذي

266
00:18:29,800 --> 00:18:30,960
أخبريني

267
00:18:32,700 --> 00:18:33,840
حاميّة

268
00:18:33,840 --> 00:18:36,710
حاميّة؟ حاميّة ماذا؟

269
00:18:36,710 --> 00:18:39,340
إتسكي، ألم تُلاحظ مظهرك بعد؟

270
00:18:41,360 --> 00:18:42,890
ما-ما هذا؟

271
00:18:42,890 --> 00:18:44,600
لماذا تغيّرت؟

272
00:18:44,970 --> 00:18:46,260
ستعرفُ الإجابة في نهاية المطاف

273
00:18:47,120 --> 00:18:49,600
ماذا؟ لحظة، لم أنتهِ من الكلام

274
00:18:54,200 --> 00:18:57,610
يبدو أنّهم قد لاحظوا أيضاً

275
00:18:58,220 --> 00:18:59,640
تعلمين ما يعنيه هذا

276
00:18:59,640 --> 00:19:00,650
عُلِم

277
00:19:01,000 --> 00:19:03,120
سأغادرُ للقضاءِ على المزيد من الظلاميين

278
00:19:16,160 --> 00:19:17,260
!انتظر

279
00:19:24,440 --> 00:19:25,580
لا داعي

280
00:19:30,900 --> 00:19:34,690
أتذكّرُ أيّامي في المدرسة الثانوية أيضاً

281
00:19:34,690 --> 00:19:38,000
وقعتُ في حبِّ فتاة وتصرّفتُ دون تفكير

282
00:19:38,000 --> 00:19:40,830
هذا جزءٌ من حياةِ الشباب

283
00:19:40,830 --> 00:19:44,520
لكن هذا لا يعني ألّا تتبع القواعد

284
00:19:41,660 --> 00:19:43,720
هل أي-أي في إحدى الغرف الفارغة؟

285
00:19:43,720 --> 00:19:44,520
لا

286
00:19:45,520 --> 00:19:49,260
...حتّى أنا كسرتُ قاعدةً أو اثنتين، لكن

287
00:19:49,700 --> 00:19:51,930
ماذا سنفعل؟

288
00:19:51,930 --> 00:19:53,710
سوزوكي-سان ليسَتْ في غرفتها؟

289
00:19:54,280 --> 00:19:58,210
لا، كنّا سنتكلّمُ معها عن زيّ مقهى النادِلات الخاصّ بها

290
00:19:58,650 --> 00:20:01,620
!لم أنتهِ من الكلام معك

291
00:20:04,500 --> 00:20:05,780
ما الأمر؟

292
00:20:05,780 --> 00:20:08,060
لا شيء، آسف لإزعاجك

293
00:20:08,470 --> 00:20:09,570
!انتظر

294
00:20:09,910 --> 00:20:12,980
كنتُ على وشك أن أوصِلَ لك رِسالة فيها عبرة رجوليّة

295
00:20:22,980 --> 00:20:24,020
لماذا؟

296
00:20:27,620 --> 00:20:28,680
ماذا؟

297
00:20:40,660 --> 00:20:42,180
ما-ما هذا؟

298
00:20:42,510 --> 00:20:43,760
!ما هذا الهُراء؟

299
00:20:57,520 --> 00:20:59,160
سوزوكي-سان؟

300
00:21:00,470 --> 00:21:01,690
ما هذا؟

301
00:21:01,960 --> 00:21:03,110
ما الذي يجري؟

302
00:21:09,030 --> 00:21:09,810
اهرب

303
00:21:09,810 --> 00:21:10,410
ماذا؟

304
00:21:10,410 --> 00:21:11,440
!هيّا

305
00:21:31,830 --> 00:21:32,430
ماذا؟

306
00:21:38,810 --> 00:21:40,190
لقد استيقظ

307
00:23:39,520 --> 00:23:42,010
في الحلقة القادمة

308
00:23:43,100 --> 00:23:44,910
ألا تعتقدين أنّنا نفتقرُ لقوّةِ الحضور؟

309
00:23:44,910 --> 00:23:46,560
نعم، نحنُ بسيطان جدّاً

310
00:23:46,810 --> 00:23:48,720
هل من فُرصةٍ لنا لنبرُز أكثر من ذلك؟

311
00:23:48,720 --> 00:23:50,140
لا تقلّديني

312
00:23:50,140 --> 00:23:51,260
لا تقلّدني

313
00:23:51,550 --> 00:23:53,840
ابتداء من الأسبوع المقبل، سنتحضّرُ للمهرجانِ المدرسي

314
00:23:53,840 --> 00:23:56,750
أنا متأكّدٌ أننا سنحظى بفُرصتِنا للتألُّقِ أيضاً

315
00:23:56,750 --> 00:23:58,180
حاول ألّا تختطف الأضواء

316
00:23:56,750 --> 00:23:58,180
حاولي ألّا تختطفي الأضواء

317
00:23:58,450 --> 00:23:59,740
قلّدتِني مجدداً

318
00:23:59,740 --> 00:24:01,570
لا، أنت من قلّدَني

319
00:24:01,570 --> 00:24:03,000
،إن كنتُما مُستميتَين إلى هذا الحدّ لِلَفت الأنظار

320
00:24:03,000 --> 00:24:05,890
فأنصحكما بالاستمرارِ في الكلام معاً في آن واحد

321
00:24:06,190 --> 00:24:07,310
!معك حقّ