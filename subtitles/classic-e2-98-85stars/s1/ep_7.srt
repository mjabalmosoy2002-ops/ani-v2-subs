1
00:00:02,630 --> 00:00:05,560
كان ذلك رائعاً، أليس كذلك؟
!اختطاف أداء مُباشر

2
00:00:05,560 --> 00:00:09,360
كيف ينبغي أن نلعب معهم تالياً؟

3
00:00:09,840 --> 00:00:14,010
مرفوض. لسنا هنا لنلعب الألعاب

4
00:00:14,370 --> 00:00:17,160
بئساً، أعلم ذلك

5
00:00:17,160 --> 00:00:21,000
لكن ينبغي أن نستمتع في نفس
الوقت، أليس كذلك؟

6
00:00:21,520 --> 00:00:24,670
مسرحنا قد بدأ للتو

7
00:00:25,280 --> 00:00:27,800
مسرح يُدعى بالانتقام

8
00:00:29,300 --> 00:00:34,590
أجل! أستطيع استخدام قوّة
!هذه الموهبة بكاملها أخيراً

9
00:00:34,590 --> 00:00:37,920
!سأُريه مدى روعتي فحسب

10
00:00:38,560 --> 00:00:41,520
الكراهية والحزن

11
00:00:41,520 --> 00:00:44,860
هذا ما يجعلنا ما نحن عليه

12
00:00:45,380 --> 00:00:47,600
،العدالة ليست صحيحة بالضّرورة

13
00:00:48,170 --> 00:00:51,530
ولا مُبرّر الشرّ بلا أمل

14
00:00:51,530 --> 00:00:58,040
أجل. سوف نضرب بمِطرقة التمرُّد
على أولئك البالغين الأنانيّين القذرين

15
00:01:01,670 --> 00:01:03,980
نحن ديس=كورد

16
00:01:03,980 --> 00:01:09,060
سنُدمّر مشروع الموهبة الّذي يستغلّ
نقاط الضّعف والمشاعر

17
00:01:09,060 --> 00:01:11,580
ولو عنى ذلك عصيان القدر

18
00:01:25,450 --> 00:01:27,910
...أجل، هذه هي

19
00:01:28,590 --> 00:01:31,590
أليس كذلك يا موزارت؟

20
00:03:03,320 --> 00:03:07,330
لا أُصدّق بأنّهم كانوا نشطين طوال هذا الوقت

21
00:03:07,330 --> 00:03:09,460
ما الّذي يُفكّرون فيه بالضّبط؟

22
00:03:09,460 --> 00:03:12,340
هل ينوون زعزعة المشروع؟

23
00:03:12,340 --> 00:03:15,310
لنرَ كيف يسير الأمر أوّلاً، حسناً؟

24
00:03:15,310 --> 00:03:17,240
إنّهم مُجرّد أطفال في نهاية المطاف

25
00:03:17,240 --> 00:03:18,840
لا ينبغي أن تكون هذه مُشكلة

26
00:03:18,840 --> 00:03:20,480
هذا صحيح

27
00:03:20,480 --> 00:03:23,770
...الآن بعد أن بدأ ذلك، لنسخّره في منفعتنا

28
00:03:24,220 --> 00:03:26,890
...بئساً، يا لقلّة النّزاهة

29
00:03:26,890 --> 00:03:28,840
هل قلت شيئاً؟

30
00:03:28,840 --> 00:03:31,020
لا. لا شيء إطلاقاً

31
00:03:31,020 --> 00:03:34,020
تفهم دورك، أليس كذلك؟

32
00:03:34,020 --> 00:03:36,030
...يجب عليك مُراقبة غراند مايستر و

33
00:03:36,030 --> 00:03:39,750
أجل، اعتمدوا عليّ رجاء

34
00:03:41,160 --> 00:03:45,160
!وهكذا، شرف لي أن أجمعكم هنا اليوم

35
00:03:45,160 --> 00:03:47,510
ماذا تقصد بـ"وهكذا"؟

36
00:03:47,510 --> 00:03:49,440
لم تخبرنا بسبب استدعائك لنا إلى هنا

37
00:03:49,440 --> 00:03:52,870
حسناً، نحن الخاسرون الّذين فشلنا
في جولة التّصفيات

38
00:03:52,870 --> 00:03:55,270
ولا نستطيع فعل شيء آخر على أيّ حال

39
00:03:55,270 --> 00:03:56,960
هذا صحيح

40
00:03:56,960 --> 00:03:59,550
!لماذا تتكلّمون وكأنّه ليس بالأمر الجلل؟

41
00:04:00,020 --> 00:04:07,010
هُم... جماعة ديس=كورد أولئك
...دمّروا مسرحي وحلبتي الجديدة

42
00:04:07,790 --> 00:04:12,630
لهذا ظننتُ بأنّ هذا اجتماع تخطيطيّ
...لتخطيط حركتنا المُضادّة

43
00:04:12,630 --> 00:04:14,850
—أجل، بالطّبع، هذا

44
00:04:14,850 --> 00:04:17,040
حتّى لو كانت لديك خطّة، ماذا بعد؟

45
00:04:17,990 --> 00:04:19,940
انتهى الأمر بالفعل بالنّسبة لنا

46
00:04:19,940 --> 00:04:20,740
!ماذا قلت؟

47
00:04:20,740 --> 00:04:23,800
أجل، وبوضوح تامّ أيضاً

48
00:04:23,800 --> 00:04:25,540
كما هو مُتوقَّع من أخوتنا

49
00:04:25,540 --> 00:04:28,330
مُناداتهم بأخوتك مُلائم جدّاً

50
00:04:28,330 --> 00:04:30,570
—ماذا؟ ما الّذي

51
00:04:30,570 --> 00:04:32,030
"إنّهم "أرقام مفقودة

52
00:04:32,470 --> 00:04:37,380
كانوا هم من تلقّوا عنصر الموهبة
...في هذه المدرسة قبلنا

53
00:04:37,970 --> 00:04:39,760
بصيغة أُخرى، إنّهم سينباي

54
00:04:40,080 --> 00:04:42,000
...سينباي

55
00:04:42,550 --> 00:04:45,170
،لستُ مُتيقّناً من التّفاصيل

56
00:04:45,650 --> 00:04:48,790
لكن يبدو أنّهم يضمرون ضغينة ضدّ المدرسة

57
00:04:48,790 --> 00:04:50,600
ضغينة؟

58
00:04:50,600 --> 00:04:51,710
أجل

59
00:04:51,710 --> 00:04:55,150
بغضّ النّظر عن الوقت الرّاهن، هناك إشاعات
تُفيد بأنّ مآسي مُختلفة قد وقعت

60
00:04:55,150 --> 00:04:58,150
أثناء المراحل الأولى من تجربة عنصر الموهبة

61
00:04:58,150 --> 00:04:59,940
!هذا غير مُهمّ

62
00:04:59,940 --> 00:05:03,410
،إذا كنتم تعلمون من يكونون
—فينبغي لنا أن نُعيد النّزال

63
00:05:03,410 --> 00:05:05,290
"لهذا أسأل، "كيف؟

64
00:05:05,620 --> 00:05:08,880
تمّ إقصاؤنا من المسرح

65
00:05:08,880 --> 00:05:11,980
لوصف الأمر على طريقتك، فقدنا حقّ المُنافسة

66
00:05:11,980 --> 00:05:13,210
!رغم ذلك

67
00:05:14,030 --> 00:05:17,020
أساساً، مجموعتنا قد تأسّستْ بعُجالة

68
00:05:17,020 --> 00:05:23,050
هل تعلم؟ تورتة الفواكه حديثة التّحضير
لا تُوضَع على الرّفّ فوراً

69
00:05:23,850 --> 00:05:26,310
يجب وضع الفاكهة والتّورتة معاً
حتّى يختلطا جيّداً

70
00:05:28,180 --> 00:05:30,390
آسف، لكن أرفُض أيضاً

71
00:05:30,390 --> 00:05:34,290
فأثناء مرحلة التّصفيات، جعلتُ
الجميع يشعرون بالوحشة

72
00:05:34,590 --> 00:05:37,170
لدي كثير من المواعيد اليوم

73
00:05:38,330 --> 00:05:39,400
خمس فتيات؟

74
00:05:39,400 --> 00:05:42,030
لا، ثلاثة عشر

75
00:05:42,030 --> 00:05:44,680
—ثـ-ثلاثـ

76
00:05:45,280 --> 00:05:47,380
خطفتَ الحُبّ بمخالبك كذلك؟

77
00:05:47,380 --> 00:05:49,290
كما هو مُتوقَّع منك يا ليست

78
00:05:49,560 --> 00:05:51,860
ليس عليك أن تعبس هكذا

79
00:05:51,860 --> 00:05:54,120
سأخصّص وقتاً لأجلك أيضاً

80
00:05:54,120 --> 00:05:55,890
!قريب جدّاً! لا تُسئ فهمي

81
00:05:56,940 --> 00:05:59,170
!حسناً، إلى اللّقاء

82
00:06:00,360 --> 00:06:02,190
سوف أغادر أيضاً

83
00:06:02,190 --> 00:06:04,180
أنت أيضاً؟

84
00:06:09,930 --> 00:06:11,920
ا-الجميع؟

85
00:06:11,920 --> 00:06:16,160
ماذا حدث للوحدة الّتي كانت بيننا؟

86
00:06:16,420 --> 00:06:18,380
...عجيب أمرهم

87
00:06:40,190 --> 00:06:42,590
،أنقذني أولئك الأشخاص

88
00:06:43,050 --> 00:06:45,650
ثمّ تخلّوا عنّي في الجحيم

89
00:06:50,100 --> 00:06:51,270
!اللّعنة

90
00:06:56,230 --> 00:07:00,380
هل أنا الوحيد المستاء بشأن الخسارة؟

91
00:07:24,380 --> 00:07:26,620
أنا مُرهَق

92
00:07:34,650 --> 00:07:36,020
نعم، مرحباً؟

93
00:07:37,850 --> 00:07:38,960
دكتور؟

94
00:07:41,150 --> 00:07:42,350
!أمريكا؟

95
00:07:43,030 --> 00:07:46,030
أتلك العمليّة الجراحيّة الّتي ذكرتها من قبل؟

96
00:07:46,750 --> 00:07:49,820
هل ستُعالج عيني؟

97
00:07:54,660 --> 00:07:57,470
قد تكون هذه فُرصتي الأخيرة

98
00:07:57,950 --> 00:08:02,460
...لكن أنا... بالفعل

99
00:08:08,680 --> 00:08:11,290
!يا للهول، تأخّرت

100
00:08:11,290 --> 00:08:15,180
ألا يفكّر ذلك الوغد ولو لوهلة في إيقاظي؟

101
00:08:15,180 --> 00:08:17,060
!صباح الخير

102
00:08:17,350 --> 00:08:18,310
—المعذرة

103
00:08:18,310 --> 00:08:20,410
!أجّل ذلك! سوف أتأخّر

104
00:08:20,410 --> 00:08:23,170
!اليوم هو يوم عطلة خاص

105
00:08:23,170 --> 00:08:24,150
ماذا؟

106
00:08:24,150 --> 00:08:26,150
:ميهاراغي يُقدّم

107
00:08:26,150 --> 00:08:31,290
رحلة ينابيع ساخنة عنوانها "أحسنتم صنعاً
!"في التّصفيات، ومن المُؤسف أن تخسروا

108
00:08:38,410 --> 00:08:41,010
حسناً جميعاً، لنلعب جولة من الشّيريتوري

109
00:08:41,010 --> 00:08:46,450
!سأبدأ أنا: ينابيع ساخنة، لذا "أونسين" هيّا

110
00:08:46,450 --> 00:08:48,550
"ندجامينا"

111
00:08:48,550 --> 00:08:51,250
لماذا نذهب إلى نبع ساخن على أيّ حال؟

112
00:08:55,560 --> 00:08:58,640
مُحبطون؟

113
00:08:59,060 --> 00:09:01,630
بعد قليل انعطف يميناً

114
00:09:02,400 --> 00:09:04,320
من فضلك التزم بتعليمات الملاحة

115
00:09:04,320 --> 00:09:08,320
على رسلك. يبدو هذا الطّريق بإطلالة أجمل

116
00:09:08,320 --> 00:09:12,150
إعادة توجيه. انعطف يساراً بعد قليل

117
00:09:14,140 --> 00:09:16,830
...من فضلك قُد ببطء أكبر

118
00:09:25,690 --> 00:09:27,270
هل أُصِبت بدوار الحركة؟

119
00:09:27,270 --> 00:09:29,550
أجل، قليلاً

120
00:09:29,550 --> 00:09:31,780
قد تحتاج لتنفّس بعض الهواء

121
00:09:31,780 --> 00:09:33,050
لنتبادل المقاعد

122
00:09:33,050 --> 00:09:34,990
شكراً لك

123
00:09:35,470 --> 00:09:37,670
هذا ما يُعجبني فيك

124
00:09:42,690 --> 00:09:46,360
...هذا الوغد لم ينظر إليّ ولو لمرّة اليوم أيضاً

125
00:09:49,640 --> 00:09:51,320
هذا غريب

126
00:09:51,320 --> 00:09:54,710
فحصتُ السيّارة مؤخّراً أيضاً

127
00:09:54,710 --> 00:09:58,760
من الطّبيعيّ أن تتعطّل إذا ظللت
تقود في طُرُقات كهذه

128
00:09:58,760 --> 00:10:02,330
لهذا قلتُ لك أن تلتزم بتوجيهات الملاحة

129
00:10:02,330 --> 00:10:04,150
تبّاً

130
00:10:04,150 --> 00:10:07,340
تماسكي يا قنواتي الهلاليّة

131
00:10:07,790 --> 00:10:09,430
هل ينبغي أن نستدعي أحداً؟

132
00:10:09,430 --> 00:10:11,560
النُّزُل ليس بعيداً جدّاً من هنا، صحيح؟

133
00:10:13,680 --> 00:10:14,880
!أنت

134
00:10:16,920 --> 00:10:18,020
سئمتُ من هذا

135
00:10:18,020 --> 00:10:18,890
!أنت

136
00:10:20,060 --> 00:10:21,610
!انتظر

137
00:10:22,910 --> 00:10:24,800
!ما الّذي تُفكّران فيه؟

138
00:10:24,800 --> 00:10:27,400
!ستتوهان في هذه الجبال

139
00:10:29,130 --> 00:10:30,570
...لا أستطيع... المُتابعة

140
00:10:30,570 --> 00:10:32,320
تـ-تمالك نفسك، حسناً؟

141
00:10:32,760 --> 00:10:35,320
...أعتقد كان يوجد كيس للإقياء في مكان ما

142
00:10:35,900 --> 00:10:37,710
عظيم

143
00:10:44,060 --> 00:10:45,840
!قلتُ انتظر

144
00:10:46,830 --> 00:10:49,530
المكان خطير بمفردك! ماذا
لو أصابك مكروه؟

145
00:10:51,860 --> 00:10:53,690
!لماذا تتجاهلني؟

146
00:10:53,690 --> 00:10:55,740
!كنتَ هكذا منذ مرحلة التّصفيات

147
00:10:57,870 --> 00:10:59,260
هل جُنِنت؟

148
00:11:02,350 --> 00:11:04,090
لأنّنا خسرنا؟

149
00:11:04,090 --> 00:11:07,170
لأنّني انضممتُ لكم فجأة وعرقلتكم؟

150
00:11:07,170 --> 00:11:09,030
!لِمَ لا تقولها علناً إذاً؟

151
00:11:09,030 --> 00:11:10,490
أنّها غلطتي فحسب

152
00:11:11,150 --> 00:11:13,420
!إن لم تقل شيئاً، فلن أفهم ما يجري

153
00:11:16,030 --> 00:11:17,240
—أيّها الوغد، إن لم تفعل

154
00:11:17,240 --> 00:11:18,990
سوف تجري تلك العمليّة الجراحيّة، صحيح؟

155
00:11:21,130 --> 00:11:23,720
...حالما تُشفى عيناك، فإنّك سوف

156
00:11:24,360 --> 00:11:26,030
سمعت ذلك؟

157
00:11:27,280 --> 00:11:29,220
لا تهتمّ لأمري بعد الآن

158
00:11:29,220 --> 00:11:30,720
عُد إلى الملاكمة

159
00:11:45,120 --> 00:11:46,560
لم يصلا بعد؟

160
00:11:46,560 --> 00:11:47,610
ليس بعد

161
00:11:47,610 --> 00:11:49,860
كما خشيتُ فحسب

162
00:11:49,860 --> 00:11:53,210
رُبّما يختبئان من المطر في مكان ما؟

163
00:11:53,210 --> 00:11:55,810
...وجباتكم جاهزة، لكن

164
00:11:55,810 --> 00:11:58,860
أجل. سنتناول وجباتنا

165
00:11:59,130 --> 00:12:01,160
ماذا لو حدث شيء؟

166
00:12:01,160 --> 00:12:04,340
إن لم نسمع شيئاً، فسوف نُقدّم
شكوى عن شخص مفقود

167
00:12:04,340 --> 00:12:06,440
لكن قد يُذاع هذا عبر الأخبار

168
00:12:08,260 --> 00:12:09,680
أتساءل ما إن كانا بخير

169
00:12:09,680 --> 00:12:12,010
سيترتّب علينا الانتظار حاليّاً فحسب

170
00:12:12,010 --> 00:12:14,960
لا نريد أن ينتهي المطاف بفقداننا أيضاً

171
00:12:25,620 --> 00:12:27,160
عُد إلى المُلاكمة

172
00:12:28,750 --> 00:12:32,020
في الوقت الّذي ظننتُ فيه بأنّنا
سنتحادث، تقول ذلك؟

173
00:12:37,980 --> 00:12:40,330
هل يعتقد بأنّني سأغادر؟

174
00:12:41,720 --> 00:12:45,340
لا، كان الأمر هكذا منذ انتهت التّصفيات

175
00:12:46,930 --> 00:12:50,000
لماذا لا يهمّ نفسه بالنّظر إليّ؟

176
00:12:53,760 --> 00:12:55,390
أين المُعلّم ميهاراغي؟

177
00:12:55,390 --> 00:12:57,260
قال بأنّه يحظى بتدليك أقدام

178
00:12:57,260 --> 00:12:59,930
أهذه لعشيقاتك الثّلاثة عشر؟

179
00:12:59,930 --> 00:13:01,590
أجل! أجل، أجل

180
00:13:01,590 --> 00:13:04,140
طلبنَ منّي إرسال صور

181
00:13:04,140 --> 00:13:05,910
لِمَ لا ترتدي اليوكاتا خاصّتك أيضاً؟

182
00:13:05,910 --> 00:13:07,770
سأرتديه بعد الاستحمام

183
00:13:08,770 --> 00:13:11,020
لا تلتقط صوراً لي دون استئذان

184
00:13:11,570 --> 00:13:13,150
هل أنت قلق عليهما؟

185
00:13:15,000 --> 00:13:17,100
أتأمّل الغيوم فحسب

186
00:13:18,920 --> 00:13:21,360
بئساً، هذ مُقلِق

187
00:13:21,360 --> 00:13:24,420
بيتهوفن شقيّ كذلك

188
00:13:24,420 --> 00:13:28,790
المعذرة! هناك شخصان قد وصلا للتو

189
00:13:33,620 --> 00:13:36,980
ألم تفكّرا حتّى بالالتجاء من المطر؟

190
00:13:36,980 --> 00:13:38,430
!اصمت

191
00:13:40,550 --> 00:13:43,360
حاليّاً، ادخلا ودفّئا نفسيكما
في النّبع السّاخن

192
00:13:43,360 --> 00:13:44,700
لا أحتاج ذلك

193
00:13:59,690 --> 00:14:02,480
هل كانت النّزهة تحت المطر
مُمتعة إلى هذا الحدّ؟

194
00:14:02,480 --> 00:14:04,700
أم أنّ المطاف انتهى بكما بالقتال؟

195
00:14:04,700 --> 00:14:07,590
من الأفضل لو أنّه كان قتالاً

196
00:14:07,590 --> 00:14:09,660
ممنوع غمس رأسك

197
00:14:10,790 --> 00:14:14,790
ألا تعلم حتّى آداب السّلوك الأساسيّة
في نبع ساخن؟

198
00:14:15,460 --> 00:14:18,660
أطرح عليك نفس السّؤال. إلى متى ستبقى
ملفوفاً بهذه المنشفة؟

199
00:14:18,660 --> 00:14:20,820
أنا أستمتع بغسل قدمَي

200
00:14:20,820 --> 00:14:23,970
ألا تعتقد بأنّ لدي الحرّية في اختيار طريقة
الاستحمام في النّبع السّاخن؟

201
00:14:24,460 --> 00:14:28,430
لحظة، هل أنت من الأشخاص
الّذين لا يشعرون براحة في الحمّام؟

202
00:14:28,430 --> 00:14:30,300
عمّاذا تتكلّم؟

203
00:14:30,300 --> 00:14:31,650
،سواء استحممنا معاً أم لا

204
00:14:31,650 --> 00:14:36,190
لا أعتقد بأنّ الطّريقة الّتي نتواصل فيها
مع بعضنا الآخر تتغيّر البتّة

205
00:14:39,320 --> 00:14:40,360
!اخلع ذلك الشّيء

206
00:14:40,360 --> 00:14:41,330
!عُلِم

207
00:14:50,200 --> 00:14:52,990
رأيت؟ لا شيء يدعو للإحراج

208
00:14:52,990 --> 00:14:55,610
!اصمت! أنتما عنيفان

209
00:14:55,610 --> 00:14:58,080
مهلاً، مهلاً. ألا تشعر بالاسترخاء؟

210
00:14:58,920 --> 00:15:02,600
لكن ليتني أتيتُ إلى هنا عندما
...كنتُ بمزاج أفضل

211
00:15:03,090 --> 00:15:04,910
يراودني نفس الشّعور

212
00:15:04,910 --> 00:15:07,690
عجباً! هذه الخطّة مُهينة حقّاً

213
00:15:07,690 --> 00:15:09,620
حفلة مُثيرة للشّفقة؟

214
00:15:10,830 --> 00:15:14,720
أنتما... هل كنتما مُستائين حقّاً
من أنّنا قد خسرنا؟

215
00:15:14,720 --> 00:15:16,060
كنّا كذلك بالطّبع

216
00:15:16,060 --> 00:15:19,730
،لكن تصرّفتم جميعاً بصورة طبيعيّة
...وكنتُ أنا المُنزعج، ثمّ

217
00:15:19,730 --> 00:15:23,420
كنّا غاضبين بالطّبع، لا سيّما بعد
الخسارة بالطّريقة الّتي خسرنا بها

218
00:15:23,420 --> 00:15:25,950
!قولوا ذلك إذاً! قولوا بأنّكم مُستاؤون

219
00:15:26,350 --> 00:15:29,210
هل ستتغيّر النّتائج إذا فعلنا؟

220
00:15:29,210 --> 00:15:33,760
أم أنّك أردتني أن أشارك في شيء
غير مُثمِر كلعق الجراح؟

221
00:15:36,060 --> 00:15:38,110
...هكذا كانت مشاعركم إذاً

222
00:15:40,330 --> 00:15:42,850
كنتُ أُفضّل أن يتمّ طردي

223
00:15:42,850 --> 00:15:45,030
تحطّم كبريائي تماماً

224
00:15:45,030 --> 00:15:47,800
كُلّ ما عليك هو تعديل مزاجك
وتأخذ بثأرك في المرّة المُقبلة

225
00:15:47,800 --> 00:15:50,100
تقول ذلك وكأنّ المسألة سهلة

226
00:15:50,100 --> 00:15:52,380
لا تحظى إلّا بفُرصة واحدة للأداء على مسرح

227
00:15:52,380 --> 00:15:55,830
إذا فشلت، فإنّك تُرمَى في الهاوية
وتكون حينئذ النّهاية

228
00:15:55,830 --> 00:15:56,940
!ماذا؟

229
00:15:57,460 --> 00:16:00,940
لماذا تلك هي نهاية الأمر؟
لماذا تستسلمان بهذه السّهولة؟

230
00:16:01,340 --> 00:16:05,000
خرجنا من المسرح دون حتّى
أن نترك أسماءنا خلفنا

231
00:16:05,000 --> 00:16:06,130
،ألا ينطبق هذا على المُلاكمة

232
00:16:06,130 --> 00:16:08,070
حيث يتوجّب على الخاسر النّزول عن الحلبة؟

233
00:16:09,980 --> 00:16:13,830
!حتّى لو خسرت، أقرع الجرس التّالي

234
00:16:14,280 --> 00:16:16,330
!هكذا كنتُ أفعلها دوماً

235
00:16:16,330 --> 00:16:19,580
!حتّى لو أُسدِل السّتار، يمكننا فتحه ثانية فحسب

236
00:16:23,590 --> 00:16:27,330
!لا أريد أن أستسلم... هنالك دوماً فُرصة جديدة

237
00:16:28,140 --> 00:16:30,400
هل تقصد بأنّ هناك فصل ثانٍ؟

238
00:16:30,400 --> 00:16:32,440
...أتفهّم شعورك، لكن

239
00:16:32,440 --> 00:16:34,990
ما رأيك أن تجلس أوّلاً؟

240
00:16:39,520 --> 00:16:43,480
!لكن أكثر شخص لا أفهمه هو ذلك الرّجل

241
00:16:43,760 --> 00:16:45,010
تقصد موزارت؟

242
00:16:45,010 --> 00:16:47,520
إنّه لا ينظر إليّ حتّى

243
00:16:47,520 --> 00:16:48,800
...لا يقول شيئاً

244
00:16:48,800 --> 00:16:50,240
...لماذا هو

245
00:16:52,740 --> 00:16:55,490
حسناً، لديه أسبابه الخاصّة

246
00:16:56,000 --> 00:16:57,000
تريد أن تعرف؟

247
00:17:01,830 --> 00:17:04,750
يبدو من الخطأ سماع ذلك منكم

248
00:17:05,750 --> 00:17:09,760
لن يروقه ذلك، ولا أنا أيضاً

249
00:17:09,760 --> 00:17:11,360
سأسأله بنفسي

250
00:17:21,850 --> 00:17:22,680
!أنت

251
00:17:27,640 --> 00:17:29,010
أريد أن أتكلّم

252
00:17:29,730 --> 00:17:31,020
أنا لا أريد

253
00:17:31,020 --> 00:17:32,160
بل عليك ذلك

254
00:17:34,940 --> 00:17:36,160
لا أريد

255
00:17:38,560 --> 00:17:39,910
...إذاً

256
00:17:41,000 --> 00:17:42,280
!سأجعلك تتكلّم

257
00:17:47,310 --> 00:17:49,140
إذا ربحتُ، فسوف تتكلّم

258
00:17:50,800 --> 00:17:52,810
...إذاً إن ربحتُ

259
00:17:56,140 --> 00:17:57,760
نقطة لي

260
00:18:09,070 --> 00:18:11,280
إرسالك مُربِك

261
00:18:12,020 --> 00:18:13,740
إنّه مثلك فحسب

262
00:18:20,250 --> 00:18:21,870
!لا فُرصة لك

263
00:18:28,690 --> 00:18:30,510
نظرت إليّ أخيراً

264
00:18:36,370 --> 00:18:37,480
!تعال إليّ

265
00:18:44,020 --> 00:18:44,770
...لماذا

266
00:18:44,770 --> 00:18:45,530
!ماذا؟

267
00:18:45,530 --> 00:18:47,360
!لماذا ظهرت أمامي؟

268
00:18:48,020 --> 00:18:50,620
!حتّى لو قلتَ ذلك، أنا هنا بالفعل

269
00:18:51,230 --> 00:18:53,700
!كان ينبغي أن تبقى في المُلاكمة فحسب

270
00:18:53,700 --> 00:18:55,740
!أنا مهتمّ بالموسيقى الآن

271
00:18:56,220 --> 00:18:58,320
!لهذا أقول لك أن تعود إليها

272
00:18:58,320 --> 00:18:59,950
...كُفّ عن إخباري

273
00:18:59,950 --> 00:19:01,700
!بما يجب عليّ فعله

274
00:19:05,100 --> 00:19:08,110
...أقصد، أجل، لم أفهم في البداية

275
00:19:09,480 --> 00:19:10,750
...لكن الآن

276
00:19:12,380 --> 00:19:17,280
!اخترتُ حلبتي الجديدة بمحض إرادتي

277
00:19:17,890 --> 00:19:22,500
!الموسيقى هي حلبة قدري

278
00:19:24,680 --> 00:19:27,790
عندما قلتَ بأنّك ستسأله، هذا ما قصدته؟

279
00:19:27,790 --> 00:19:29,520
مهووسو القوّة لا يعرفون سوى طريقة واحدة

280
00:19:29,520 --> 00:19:31,280
حسناً، أعتقد هذا يلائم طبعه

281
00:19:31,610 --> 00:19:33,690
...لا تتدخّل بي

282
00:19:33,690 --> 00:19:35,570
!سوف تختفي فحسب على أي حال

283
00:19:35,570 --> 00:19:36,950
!ماذا؟

284
00:19:36,950 --> 00:19:38,450
!لن أختفي

285
00:19:38,450 --> 00:19:39,890
...لا تُظهِر نفسك

286
00:19:40,320 --> 00:19:41,730
...من البداية، أنت

287
00:19:47,550 --> 00:19:48,960
إلى من تنظر؟

288
00:19:51,510 --> 00:19:54,720
لا أريد أن أنظر إلى شيء بعد الآن

289
00:19:56,250 --> 00:19:57,760
...ولا أنت أيضاً

290
00:19:58,910 --> 00:20:00,170
!جرّبني

291
00:20:02,260 --> 00:20:03,320
،لكن

292
00:20:05,350 --> 00:20:07,010
لن أهرب

293
00:20:09,270 --> 00:20:12,820
!هنا، سوف أطمح للقمّة بالموسيقى

294
00:20:12,820 --> 00:20:15,360
!الجولة الثّانية قد بدأت بالفعل

295
00:20:19,680 --> 00:20:21,370
!أبقِ عينيك عليّ

296
00:20:21,630 --> 00:20:23,370
!لا تنظر إلّا إليّ

297
00:20:41,230 --> 00:20:43,040
مَن ربح؟

298
00:20:43,040 --> 00:20:45,130
...كانت الكُرة سريعة جدّاً في مُنتصف مسيرتها

299
00:20:45,130 --> 00:20:49,730
يبدو هذا مختلفاً قليلاً عن كتاب
القواعد الّذي هنا

300
00:20:51,110 --> 00:20:54,420
لوف-لوف. فلتكُن تعادُلاً فحسب

301
00:20:57,340 --> 00:20:59,220
لا تتجاهلني بعد الآن

302
00:21:00,740 --> 00:21:04,940
،لا أعرف ما القدر الّذي جعلَ ذلك يحصل
لكنّنا هنا معاً الآن

303
00:21:10,260 --> 00:21:13,390
أهكذا يكون الأمر عندما تُصلّب المطرُ الأرض؟

304
00:21:13,390 --> 00:21:15,610
...الأمر ليس بتلك السّهولة

305
00:21:16,000 --> 00:21:18,880
!أنباء هامّة! لدي أنباء هامّة

306
00:21:19,520 --> 00:21:24,390
إنّها عاجلة. إحدى المجموعات الّتي
!نجحت في التّصفيات قد انسحبت

307
00:21:24,390 --> 00:21:26,170
!ماذا؟

308
00:21:26,170 --> 00:21:30,010
!لذا أنتم، بصفتكم الوصيف، قد تمّت ترقيتكم الآن

309
00:21:30,010 --> 00:21:31,520
هل يمكن ذلك حقّاً؟

310
00:21:31,750 --> 00:21:36,900
!تمّ اختيار غراند مايستر للتأهّل إلى النّهائي

311
00:21:38,370 --> 00:21:39,830
يمكننا أن نُغنّي

312
00:21:40,590 --> 00:21:43,380
!من جديد، على نفس مسرح أولئك الأشخاص

313
00:23:36,940 --> 00:23:39,900
"الحلقة القادمة، "الحُبّ حُرّية