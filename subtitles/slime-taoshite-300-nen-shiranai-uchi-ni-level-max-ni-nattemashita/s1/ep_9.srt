1
00:00:07,590 --> 00:00:09,200
!أمّي! ثمّة مشكلة

2
00:00:10,080 --> 00:00:12,180
شالشا؟ ما الخطب؟

3
00:00:12,700 --> 00:00:13,680
...أختي

4
00:00:14,230 --> 00:00:15,630
...إنّ أختي

5
00:00:17,340 --> 00:00:18,390
!فالفا

6
00:00:22,310 --> 00:00:24,670
ما الّذي يفعله هذا السلايم هنا؟

7
00:00:24,890 --> 00:00:25,780
—من الأفضل أن أقتـ

8
00:00:25,780 --> 00:00:26,670
!أمّي

9
00:00:26,670 --> 00:00:27,520
!إيّاك

10
00:00:28,150 --> 00:00:29,860
.لِمَ لا؟ إنّه سلايم

11
00:00:30,070 --> 00:00:32,610
!تلك هي أختي

12
00:00:33,820 --> 00:00:35,150
فالفا؟

13
00:00:37,520 --> 00:00:40,160
...لا أفهم ما الّذي يحدث

14
00:00:40,160 --> 00:00:43,990
.عندما استيقظنا هذا الصّباح، كانت أختي سلايم

15
00:00:43,990 --> 00:00:45,350
...غير معقول

16
00:00:45,350 --> 00:00:47,180
،كانت نافذة غرفتنا مغلقة

17
00:00:47,180 --> 00:00:49,980
لذلك كان من المستحيل
.أن يدخل أحد ما من الخارج

18
00:00:49,980 --> 00:00:53,540
لذلك لا يمكن أن يكون هذا السلايم
.أيّ أحد آخر سوى أختي

19
00:00:53,850 --> 00:00:56,540
هل أنت فالفا بالفعل؟

20
00:00:59,560 --> 00:01:01,560
!إنّها فالفا بالفعل

21
00:02:36,180 --> 00:02:37,460
...هذه

22
00:02:37,460 --> 00:02:38,930
هي فالفا؟

23
00:02:40,090 --> 00:02:41,170
أهذا معقول؟

24
00:02:41,390 --> 00:02:43,820
.لا أريد تصديق هذا أيضًا

25
00:02:44,130 --> 00:02:46,850
هل تعرف أيّ واحدة منكنّ
كيف نعيدها لشكلها السّابق؟

26
00:02:49,120 --> 00:02:51,010
...لا أظنّ ذلك

27
00:02:57,630 --> 00:02:59,280
...لم أسمع بذلك من قبل

28
00:02:59,560 --> 00:03:00,620
...ولكن

29
00:03:00,820 --> 00:03:03,730
ألا يمكنك فعل أيّ شيء بواسطة سحرك يا أختي؟

30
00:03:04,030 --> 00:03:08,200
أعتقد أنّه سيكون من الصّعب ابتكار
.تعويذة جديدة لحالة محدّدة كهذه

31
00:03:08,200 --> 00:03:11,790
،إن كان لديك سؤال عن الوحوش
!فيمكنك سؤال الشّياطين

32
00:03:12,300 --> 00:03:13,590
شياطين؟

33
00:03:15,420 --> 00:03:19,510
!فوسانوسانون أوجيشيداو فياني إنريلا

34
00:03:23,920 --> 00:03:26,510
!بيلزيبب! تحوّلت فالفا إلى سلايم

35
00:03:27,750 --> 00:03:28,980
...فعلتِ

36
00:03:28,980 --> 00:03:32,470
هذا بي بسبب عذر سيّئ
!من أجل مزحة كهذه؟

37
00:03:32,750 --> 00:03:34,990
!لا، إنّها الحقيقة

38
00:03:35,230 --> 00:03:36,340
!كلاّ

39
00:03:36,990 --> 00:03:41,510
...يا فالفا... لا أصدّق ما أصبحتِ عليه

40
00:03:41,870 --> 00:03:44,380
.استيقظت هذا الصّباح هكذا

41
00:03:44,380 --> 00:03:46,810
هل تعرفين طريقة لتحويلها لشكلها السّابق؟

42
00:03:47,960 --> 00:03:51,040
،حسنًا، يُقال أن نعطي الخبز للخبّاز

43
00:03:51,040 --> 00:03:53,750
.لذلك علينا سؤال سلايم عن مسائل السلايم

44
00:03:53,750 --> 00:03:54,850
نسأل سلايم؟

45
00:03:55,270 --> 00:04:00,400
سمعتُ بوجود سلايم مميّز يُعرف
.بالسلايم الذّكيّ في قلعة فانزلد

46
00:04:00,400 --> 00:04:02,580
.ستجدين أجابتك هناك على الأرجح

47
00:04:02,580 --> 00:04:04,510
.عاصمة الشّياطين ثانية

48
00:04:04,510 --> 00:04:07,230
ما هو اسم السلايم الذّكيّ هذا؟

49
00:04:07,750 --> 00:04:09,970
.أخبرتك، إنّه السلايم الذّكيّ

50
00:04:10,390 --> 00:04:13,770
...لا يبدو لي ذلك ذكيًّا جدًّا

51
00:04:14,700 --> 00:04:17,550
.حسنًا، سأذهب لزيارة قلعة فانزلد

52
00:04:17,550 --> 00:04:18,490
...أمّي

53
00:04:18,880 --> 00:04:20,720
أيمكنني الذّهاب معك؟

54
00:04:20,720 --> 00:04:23,670
.بالطّبع. أعرف أنّك قلقة أيضًا

55
00:04:23,670 --> 00:04:25,830
.لا داعي لهذه الجدّيّة

56
00:04:26,220 --> 00:04:28,770
.سنهتمّ أنا وأزوسا بكلّ شيء

57
00:04:38,520 --> 00:04:41,660
،يحبّ السلايم الذّكيّ الأماكن الهادئة

58
00:04:41,660 --> 00:04:43,960
.لذلك فهو يقطن في أسفل مستويات القلعة

59
00:04:44,260 --> 00:04:48,020
أنا منبهرة لأنّك لا تضيعين
.في كلّ هذه الطّرق المعقّدة

60
00:04:50,630 --> 00:04:52,230
أكان هذا الطّريق هنا من قبل؟

61
00:04:52,230 --> 00:04:53,540
!كنتِ ضائعة بالفعل؟

62
00:04:54,940 --> 00:04:56,840
،توقّعت حدوث هذا

63
00:04:56,840 --> 00:04:59,560
.لذلك كنت أترك فتات خبز خلفنا

64
00:04:59,560 --> 00:05:02,740
.أختي، لا يجب عليك أكل طعام من الأرض

65
00:05:05,340 --> 00:05:07,710
!مهلاً، كيف عدنا إلى السّطح؟

66
00:05:07,710 --> 00:05:11,070
!كلاّ! هذه القلعة مربكة

67
00:05:11,070 --> 00:05:12,950
ألا تعملين هنا؟

68
00:05:12,950 --> 00:05:14,320
!حسنًا، حسنًا

69
00:05:14,640 --> 00:05:18,840
!إنّ السّعادة تغمرني برؤيتك ثانية يا أختي العزيزة

70
00:05:18,840 --> 00:05:19,960
...اقتراب، اقتراب، اقتراب

71
00:05:19,960 --> 00:05:22,430
.رحّبي بي رجاءً بقبلة على الخدّ

72
00:05:22,430 --> 00:05:24,450
!تعلمين أنّني لن أفعل ذلك

73
00:05:24,450 --> 00:05:27,040
أنت تبحثين عن السلايم الذّكيّ، صحيح؟

74
00:05:27,040 --> 00:05:29,170
هل تريدين معرفة كيف تجدينه؟

75
00:05:29,620 --> 00:05:32,640
وهل ستخبريني بالفعل؟

76
00:05:32,640 --> 00:05:34,360
!بالطّبع

77
00:05:38,580 --> 00:05:39,550
.قُبلة

78
00:05:39,550 --> 00:05:41,240
...رفرفة

79
00:05:41,240 --> 00:05:44,430
!إنّ قُبلةً من أختي العزيزة لَتجربةٌ رائعة

80
00:05:44,430 --> 00:05:47,510
!إنّني منتشية الآن لدرجة الموت

81
00:05:47,510 --> 00:05:51,210
هذا مفهوم! أخبريني فقط
!أين هو السلايم الذّكيّ بسرعة

82
00:05:51,420 --> 00:05:54,210
.تفقّدي ذلك الكوخ هناك

83
00:05:57,450 --> 00:06:00,400
.إنّه يبدو مثل أيّ كوخ عاديّ لي

84
00:06:03,260 --> 00:06:04,330
.ها هو ذا

85
00:06:04,330 --> 00:06:06,590
!ما كنّا أبدًا لنجد هذا

86
00:06:13,400 --> 00:06:16,860
.ثمّة الكثير من الكتابات على الجدار
ما الّذي كُتب هنا؟

87
00:06:18,090 --> 00:06:19,240
...انت

88
00:06:19,530 --> 00:06:21,290
السلايم الذّكيّ، صحيح؟

89
00:06:23,100 --> 00:06:25,260
."لقد أصاب كلمة "نعم

90
00:06:25,260 --> 00:06:28,720
.مفهوم. إنّه يستعمل هذه للتّواصل

91
00:06:28,720 --> 00:06:30,750
لهذا السّبب هي هو أسود بالكامل؟

92
00:06:31,240 --> 00:06:37,720
أيّها السلايم الذّكيّ، تحوّلت روح السلايم
.اليافعة هذه إلى سلايم فجأة

93
00:06:37,720 --> 00:06:39,990
هل تعرف كيف تستعيد شكلها السّابق؟

94
00:06:40,660 --> 00:06:42,870
...مقا... طعت

95
00:06:43,400 --> 00:06:44,680
...حذف

96
00:06:44,680 --> 00:06:46,290
.لا بدّ أنّ ارتكب خطأ

97
00:06:47,440 --> 00:06:48,770
.هذا عمل كثير

98
00:06:49,340 --> 00:06:53,270
...في أعلى جبال مقاطعة توموريانا

99
00:06:53,270 --> 00:06:56,750
.سلنَ السّاحرة السلايم الّتي تعيش هناك

100
00:06:56,750 --> 00:06:59,260
ثمّة ساحرة سلايم الآن؟

101
00:06:59,510 --> 00:07:02,310
أعلى جبل في مقاطعة توموريانا؟

102
00:07:02,310 --> 00:07:04,740
.سنحتاج لبعض الوقت للبحث في الأمر

103
00:07:04,740 --> 00:07:07,270
أزوسا، لماذا لا نكمل غدًا؟

104
00:07:07,270 --> 00:07:11,030
نعم، أعتقد أنّ جميعنا متعبات
.على أيّ حال. لنقم بذلك

105
00:07:11,030 --> 00:07:13,430
.يا سلاذكيّ، شكرًا جزيلاً لك

106
00:07:13,430 --> 00:07:14,770
سلاذكيّ؟

107
00:07:14,770 --> 00:07:18,270
!السلايم الذّكيّ... أو سلاذكيّ كاختصار

108
00:07:18,270 --> 00:07:20,410
.حسّب بالمسمّيات بسيط للغاية

109
00:07:28,260 --> 00:07:30,120
.لا يجب أن يكون طعامًا بالتّحديد

110
00:07:30,120 --> 00:07:33,510
بإمكاننا الحصول على المغذّيات من التّربة
،أو النّباتات الّتي نجدها في كلّ مكان

111
00:07:33,910 --> 00:07:35,940
.لكنّني أريدها أن تأكل طعامًا حقيقيًّا

112
00:07:38,710 --> 00:07:41,910
...يا لها من فترة استراحة

113
00:07:41,910 --> 00:07:42,970
...أمّي

114
00:07:43,240 --> 00:07:44,370
ما الأمر؟

115
00:07:44,730 --> 00:07:48,940
أتظنّين أنّنا سنجد طريقة لإعادة شكل أختي السّابق؟

116
00:07:48,940 --> 00:07:51,750
.لا تقلقي. دعي الأمر لأمّك فحسب

117
00:07:52,190 --> 00:07:56,740
،لكن حتّى إن كانت في شكل مختلف
.تظلّ فالفا هي فالفا

118
00:07:57,330 --> 00:08:00,000
،حتّى إن كانت بين عشرات السلايم الأخرى

119
00:08:00,000 --> 00:08:01,970
.فسأجدها في رمشة عين

120
00:08:06,660 --> 00:08:07,980
.هذا هو

121
00:08:09,560 --> 00:08:10,990
!مرحبًا

122
00:08:12,510 --> 00:08:14,840
ماذا؟ من تكونين؟

123
00:08:14,840 --> 00:08:18,600
هنا تعيش السّاحرة السلايم، صحيح؟

124
00:08:18,810 --> 00:08:21,730
.آسفة لإرباكك

125
00:08:21,730 --> 00:08:23,610
.أنا سلايم

126
00:08:23,790 --> 00:08:25,040
!أنت سلايم؟

127
00:08:25,410 --> 00:08:29,120
.أنا على هذه الهيئة لأنّني استعملت سحر التّحوّل

128
00:08:29,120 --> 00:08:30,780
...هكذا الأمر إذًا

129
00:08:30,780 --> 00:08:33,350
.هذا ليس مكان للحديث. تفضّلن

130
00:08:33,750 --> 00:08:36,960
.أنا آسفة لأنّني لا أملك أيّ كراسي للضّيوف

131
00:08:36,960 --> 00:08:40,120
.لا أحتاج لأيّ أثاث أو تجهيزات حمّام بما أنّي سلايم

132
00:08:40,740 --> 00:08:42,860
بالمناسبة، ما هو اسمك؟

133
00:08:43,260 --> 00:08:44,920
.السّاحرة السلايم

134
00:08:44,920 --> 00:08:48,880
بالطّبع! هل أستطيع مناداتك ساسلا كاختصار؟

135
00:08:49,390 --> 00:08:50,380
ساسلا؟

136
00:08:50,720 --> 00:08:52,640
.نعم، لا بأس بذلك

137
00:08:52,640 --> 00:08:55,110
إذًا ما الّذي أردت أن تسأليني عنه؟

138
00:08:55,390 --> 00:08:58,930
تريدين إعادة هذه السلايم لشكلها السّابق؟

139
00:08:58,930 --> 00:08:59,890
.هذا صحيح

140
00:09:00,390 --> 00:09:02,650
هل لي أن أحملها للحظة؟

141
00:09:02,990 --> 00:09:05,160
.نعم، نعم... فهمت

142
00:09:05,160 --> 00:09:08,020
.مرونتها مختلفة عن مرونة السلايم العاديّ

143
00:09:08,280 --> 00:09:10,790
!إنّها سلايم مميّزة بالفعل

144
00:09:11,520 --> 00:09:14,160
...فهمت، فهمت

145
00:09:14,160 --> 00:09:15,920
...هكذا إذًا... نعم، نعم

146
00:09:15,920 --> 00:09:19,020
...أنت من ذلك النّوع؟ أنت من ذلك النّوع

147
00:09:18,220 --> 00:09:19,280
!أيّ نوع؟

148
00:09:20,390 --> 00:09:21,830
!لديّ الجواب

149
00:09:21,830 --> 00:09:25,300
إنّ سبب تحوّل هذه السلايم
...لهذا الشّكل هو

150
00:09:25,680 --> 00:09:26,540
!هو...؟

151
00:09:26,850 --> 00:09:27,910
...هو

152
00:09:30,330 --> 00:09:31,700
.وضعية نومها

153
00:09:31,700 --> 00:09:32,660
!وضعية نومها؟

154
00:09:33,000 --> 00:09:36,590
بإمكاني الشّعور بأنّ جسدها
.متشنّج عن طريق لمسها

155
00:09:36,590 --> 00:09:39,760
.أنا واثقة أنّها ألحقت ضررًا بعضلة ما أثناء نومها

156
00:09:39,760 --> 00:09:42,870
وجعل ذلك من الصّعب عليها
،الحفاظ على شكلها البشريّ

157
00:09:42,870 --> 00:09:45,430
.لذلك اتّخذت شكل سلايم

158
00:09:45,640 --> 00:09:48,940
ألا يمكنك إعادتها باستعمال سحر التّحوّل خاصّتك؟

159
00:09:49,190 --> 00:09:52,130
.يعمل السّحر لوقت قصير فحسب

160
00:09:52,130 --> 00:09:54,390
.إنّه لا يحلّ المشكلة بحدّ ذاتها

161
00:09:54,390 --> 00:09:56,190
ماذا بإمكاننا فعله إذًا؟

162
00:09:56,370 --> 00:10:01,500
أسرع طريقة هي أن تدرك هذه السلايم
.طريقة لتغيير نفسها لشكلها السّابق

163
00:10:01,500 --> 00:10:05,130
أعتقد أنّ عليكم سؤال المقاتلة
.السلايم للمساعدة في ذلك

164
00:10:05,130 --> 00:10:06,450
!المقاتلة السلايم؟

165
00:10:06,810 --> 00:10:12,370
على عكسي، تحافظ المقاتلة السلايم على
،شكلها البشريّ عن طريق الحركات الجسديّة

166
00:10:12,370 --> 00:10:15,210
.لذلك أعتقد أنّ الحلّ هو تعلّم نفس التّقنية

167
00:10:15,400 --> 00:10:17,920
وأين يمكننا العثور على المقاتلة السلايم؟

168
00:10:17,920 --> 00:10:20,390
أعتقد أنّها في بلدة جنوبيّة تُدعى كِلني

169
00:10:20,390 --> 00:10:22,720
.للمشاركة في منافسة قتاليّة

170
00:10:22,980 --> 00:10:24,550
منافسة قتاليّة؟

171
00:10:24,550 --> 00:10:29,290
تقول الشّائعات أنّها مقاتلة فرديّة
.تسعى للقوّة فحسب

172
00:10:29,290 --> 00:10:31,570
...فهمت. إذًا

173
00:10:32,160 --> 00:10:34,910
!سأشارك في المنافسة القتاليّة أيضًا

174
00:10:34,910 --> 00:10:36,150
لماذا؟

175
00:10:36,150 --> 00:10:40,330
،إن شاركت وأثبتّ أنّني أقوى من المقاتلة السلايم

176
00:10:40,330 --> 00:10:42,590
!أراهن أنّها ستستمع لي

177
00:10:42,590 --> 00:10:44,330
...نعم، فكرة وجيهة

178
00:10:44,700 --> 00:10:47,690
وما هو اسم هذه المقاتلة السلايم؟

179
00:10:47,690 --> 00:10:48,400
...بالطّبع هو

180
00:10:48,910 --> 00:10:50,470
!مقاسلا

181
00:10:52,080 --> 00:10:53,550
...مقاسلا

182
00:10:53,550 --> 00:10:56,120
!نفس طريقة التّسمية الّتي أستعملها

183
00:11:06,230 --> 00:11:09,530
.ثمّة أعداد من الرّجال أكثر بكثير من النّساء بالفعل

184
00:11:10,000 --> 00:11:11,660
...مهلاً، ذلك الزّيّ

185
00:11:12,250 --> 00:11:13,560
.كنتُ في انتظاركنّ

186
00:11:13,560 --> 00:11:17,560
سيفقد الجميع في الحلبة صوابهم
.إن عرفوا أنّ شيطانة دخلت المنافسة

187
00:11:17,560 --> 00:11:19,080
.سيكون كلّ شيء بخير

188
00:11:19,080 --> 00:11:23,090
."أخفيت قروني، وأشارك باسم "بيلزي

189
00:11:23,090 --> 00:11:24,380
!اختيار رديء للاسم

190
00:11:24,380 --> 00:11:26,160
!انظروا من يتحدّث

191
00:11:26,390 --> 00:11:30,670
استعمال السّحر ممنوع في هذه
.المنافسة، لذلك احذري

192
00:11:30,940 --> 00:11:33,550
سأبدو في غاية الغباء إن استُبعدت، صحيح؟

193
00:11:37,400 --> 00:11:39,050
!سيّدتي أزوسا

194
00:11:40,950 --> 00:11:43,010
!نالي منه يا سيّدتي

195
00:11:43,510 --> 00:11:44,640
!فالفا

196
00:11:44,640 --> 00:11:47,090
!أعد أنّني سأعيدك لشكلك السّابق

197
00:11:47,090 --> 00:11:49,470
—أيّتها الصّغيرة! إن كنت لا تريدين أن تتأ

198
00:11:50,460 --> 00:11:52,960
!لن أخسر

199
00:11:52,960 --> 00:11:54,970
!الفوز للمشاركة أزوسا

200
00:11:57,280 --> 00:11:58,860
!أختي رائعة

201
00:12:05,130 --> 00:12:07,500
.إنّنا في نصف النّهاية بالفعل

202
00:12:10,920 --> 00:12:12,700
أصلع آخر؟

203
00:12:12,700 --> 00:12:16,590
درّبت هذا الجسد ليكون قويًّا
—كفاية لصدّ أيّ

204
00:12:17,280 --> 00:12:19,330
!الفوز للمشاركة أزوسا

205
00:12:19,590 --> 00:12:21,760
!إنّها تسحقهم جميعًا

206
00:12:21,760 --> 00:12:23,980
!سيّدتي أزوسا، أنت مذهلة

207
00:12:23,980 --> 00:12:25,460
!أمّي.. نجحت

208
00:12:25,700 --> 00:12:29,500
حسنًا. أحتاج الآن لهزيمة مقاسلا
.في النّهائيّ فحسب

209
00:12:29,500 --> 00:12:31,610
.المباراة الثّانية في النّصف النّهائيّ

210
00:12:31,610 --> 00:12:33,990
.مقاسلا، اصعدي الحلبة رجاء

211
00:12:34,380 --> 00:12:35,860
إنّها على الحلبة المجاورة؟

212
00:12:36,110 --> 00:12:37,850
...هذه هي مقاسلا

213
00:12:37,850 --> 00:12:39,870
.بيلزي، تقدّمي رجاءً

214
00:12:44,420 --> 00:12:46,720
!الفوز للمشاركة بيلزي

215
00:12:46,720 --> 00:12:48,420
!مهلاً، هزمتها

216
00:12:49,780 --> 00:12:53,240
!لم تكن مقاسلا هذه بالشّيء الّذي يُذكر

217
00:12:53,240 --> 00:12:55,440
!بيلزيبب، لماذا هزمتها؟

218
00:12:55,440 --> 00:12:58,050
!لم تعد لي أيّ طريقة للقائها الآن

219
00:12:58,050 --> 00:12:59,340
.لا تقلقي

220
00:12:59,670 --> 00:13:02,150
.لديّ نفس هدفك

221
00:13:02,150 --> 00:13:04,870
.بإمكانك الاعتماد عليّ للتّفاوض مع مقاسلا

222
00:13:04,870 --> 00:13:06,580
أيمكنني ذلك فعلاً؟

223
00:13:06,580 --> 00:13:08,410
.دعي الأمر لي فحسب

224
00:13:08,410 --> 00:13:10,010
...لذلك يا أزوسا

225
00:13:10,280 --> 00:13:13,070
،أنت حرّة بالتّقدّم للجولة النّهائيّة الآن

226
00:13:13,070 --> 00:13:15,100
.وثمّ بإمكانك قتالي

227
00:13:15,330 --> 00:13:18,360
.بصراحة، ما عدت أهتمّ بالجولة النّهائيّة الآن

228
00:13:18,360 --> 00:13:19,350
!للأسف

229
00:13:19,590 --> 00:13:23,360
أريد قتالك في الجولة النّهائيّة
.وتصفية الحساب الّذي بيننا

230
00:13:23,360 --> 00:13:26,930
.مفهوم؟ عليك التّأهّل للجولة النّهائيّة

231
00:13:32,530 --> 00:13:33,370
ما هذا؟

232
00:13:33,370 --> 00:13:36,880
.هذا وقتك لتتألّقي وأنت عبوسة هكذا

233
00:13:36,880 --> 00:13:38,480
ماذا توقّعتِ؟

234
00:13:38,480 --> 00:13:41,130
!لم أحلّ مشكلة فالفا بعد

235
00:13:42,520 --> 00:13:44,250
.مهلاً لحظة

236
00:13:44,250 --> 00:13:47,060
!ماما! عدت لشكلي السّابق

237
00:13:47,250 --> 00:13:50,420
!فالفا! عدتِ إلى شكلك السّابق

238
00:13:50,420 --> 00:13:51,880
!كم سرّني هذا

239
00:13:51,880 --> 00:13:54,640
!نعم! والفضل يعود لبيلزيبب

240
00:13:54,640 --> 00:13:57,820
ماذا تظنّين؟ مفاجأة كبيرة، صحيح؟

241
00:13:58,160 --> 00:14:01,740
...مهلاً، عرفتنّ جميعًا بهذا؟ يا إلهي

242
00:14:02,090 --> 00:14:05,580
!بإمكانك النّجاح يا ماما! سأشجّعك

243
00:14:05,580 --> 00:14:07,950
!شكرًا لك! ستبذل ماما جهدها

244
00:14:08,560 --> 00:14:11,450
.بإمكاننا الآن التّركيز على قتالنا

245
00:14:11,640 --> 00:14:13,960
،يا ساحرة المرتفعات أزوسا

246
00:14:13,960 --> 00:14:16,450
.نتيجة قتالنا لم تُحدّد بعد

247
00:14:16,640 --> 00:14:19,300
.سنقاتل بلا حواجز هذه المرّة

248
00:14:19,300 --> 00:14:22,840
من المستحيل معرفة النّتيجة
.إن تقاتلنا بعدل وإنصاف

249
00:14:23,110 --> 00:14:25,350
!فأنا قويّة قبل كلّ شيء

250
00:14:25,590 --> 00:14:29,250
.إنّها محقّة. لم ننهِ معركتنا أبدًا

251
00:14:29,610 --> 00:14:32,920
حسنًا! لنقم بهذا، موافقة؟

252
00:14:33,610 --> 00:14:36,980
هذه المرّة، سأريك ما بإمكاني
!فعله عندما أصبح جادّة

253
00:14:38,010 --> 00:14:39,690
!ابدآ

254
00:14:48,590 --> 00:14:50,130
!ستطيرين؟

255
00:14:50,130 --> 00:14:51,730
!انظروا، إنّها تطير

256
00:14:51,940 --> 00:14:53,870
!مهلاً، لديها قرون أيضًا

257
00:14:53,870 --> 00:14:56,190
أهذا هو الرّائج في المدن الكبرى الآن؟

258
00:14:56,190 --> 00:14:57,320
!سُحقًا

259
00:14:57,320 --> 00:15:00,810
!هذا أنيق جدًّا لنفهمه نحن سكّان البوادي

260
00:14:59,870 --> 00:15:03,320
.أعتقد أنّ لا أحد سيكتشف أنّها شيطانة

261
00:15:03,320 --> 00:15:05,450
.حسنًا، هذه مشكلة

262
00:15:05,450 --> 00:15:05,750
ماذا؟

263
00:15:06,020 --> 00:15:09,250
.لا يمكنني مجاراة سرعتك بالهجوم مباشرة

264
00:15:09,450 --> 00:15:12,780
فكّرتُ في أن أحاول العثور على
...نقطة ضعفك واستغلالها

265
00:15:12,780 --> 00:15:15,520
مهلاً، ليست لديّ أيّ نقاط ضعف بالفعل؟

266
00:15:15,950 --> 00:15:17,960
.كلاّ، لديك العديد منها

267
00:15:18,360 --> 00:15:20,560
!هاجميني مباشرة إذًا فحسب

268
00:15:20,560 --> 00:15:24,470
تُستهدف نقاط الضّعف فقط
!عندما يتمّ العثور عليها

269
00:15:24,470 --> 00:15:27,240
،وعندما تكون لديك العديد منها
!يصعب اختيار أيّ واحدة سأستغلّ

270
00:15:27,240 --> 00:15:30,200
.لكن لا يمكننا القتال إلاّ إن هاجمتني

271
00:15:30,200 --> 00:15:32,800
.لا يمكننا استعمال السّحر، لذلك لا يمكنني الطّيران

272
00:15:32,800 --> 00:15:34,660
...أعلم ذلك، ولكن

273
00:15:35,310 --> 00:15:38,250
لا بأس. أعلميني فقط عندما
ستقرّرين مهاجمتي، مفهوم؟

274
00:15:38,250 --> 00:15:39,970
.سأنتظر هنا حتّى ذلك الحين

275
00:15:39,970 --> 00:15:42,430
...واحد، اثنان، ثلاثة، أربعة

276
00:15:43,030 --> 00:15:44,430
!أنت تسخرين منّي

277
00:15:44,660 --> 00:15:46,070
!لا بأس! ها أنا ذي

278
00:15:47,400 --> 00:15:49,940
!سأوسعك ضربًا

279
00:15:52,210 --> 00:15:54,040
!يا لها من صدمة

280
00:15:54,040 --> 00:15:54,970
!ماما

281
00:15:54,970 --> 00:15:56,000
...أمّي

282
00:15:58,920 --> 00:16:00,690
...لا تضغطي على وجهي

283
00:16:00,690 --> 00:16:03,380
.إنّها غلطتك أنت لمهاجمتي بوجهك مباشرة

284
00:16:05,530 --> 00:16:07,650
!أوقفي هذا حالاً

285
00:16:09,280 --> 00:16:10,080
!حسنًا

286
00:16:10,440 --> 00:16:12,070
!سأهاجم بدوري

287
00:16:16,820 --> 00:16:18,570
...يا لها من قوّة مذهلة

288
00:16:19,090 --> 00:16:20,660
!ما زال لديّ المزيد

289
00:16:20,870 --> 00:16:22,310
!لا أمانع ذلك البتّة

290
00:16:25,110 --> 00:16:27,890
!إنّهما سريعتان، لا يمكنني مجاراتهما

291
00:16:27,890 --> 00:16:29,350
...لا يمكنني ذلك أيضًا

292
00:16:29,650 --> 00:16:33,440
!هذه أوّل مرّة أخوض فيها قتالاً لمدّة طويلة كهذه

293
00:16:33,440 --> 00:16:35,760
!إنّك قويّة للغاية أيضًا يا بيلزيبب، صحيح؟

294
00:16:35,760 --> 00:16:38,470
!بالطّبع! فأنا من قادة الشّياطين

295
00:16:38,720 --> 00:16:42,100
الأغرب أكثر في الأمر هو استطاعة
!بشريّة مقاتلتي من الأساس

296
00:16:42,100 --> 00:16:42,930
...وأيضًا

297
00:16:44,680 --> 00:16:47,730
،لقد تدرّبتُ كلّ يوم

298
00:16:47,730 --> 00:16:51,110
،رغم الرّياح والأمطار، بعد وقبل العمل

299
00:16:51,110 --> 00:16:52,780
!من أجل هذا اليوم

300
00:16:54,000 --> 00:16:59,140
بيلزيبب... لم تكن لديّ أدنى فكرة
،أنّك ترينني كغريمة جديرة

301
00:16:59,140 --> 00:17:01,360
.لكنّ ذلك يسعدني نوعًا ما

302
00:17:03,500 --> 00:17:05,900
.لكنّها قوّاها تخور بالفعل

303
00:17:06,720 --> 00:17:09,400
ما الّذي يمكنني فعله لإنهاء هذا؟

304
00:17:09,400 --> 00:17:10,670
!ماما

305
00:17:10,940 --> 00:17:12,300
!يمكنك النّجاح

306
00:17:12,500 --> 00:17:15,970
!كنتُ أشاهدك بينما كنتُ سلايم أيضًا

307
00:17:15,970 --> 00:17:19,420
!قمتِ لكلّ ذلك التّرحال من أجلي

308
00:17:19,420 --> 00:17:22,240
!لقد أسعدني ذلك كثيرًا

309
00:17:22,240 --> 00:17:24,070
!لذلك سأواصل تشجيعك للنّهاية

310
00:17:24,520 --> 00:17:25,970
!بإمكانك النّجاح

311
00:17:26,750 --> 00:17:28,910
.آسفة يا بيلزيبب

312
00:17:28,910 --> 00:17:33,070
،بما أنّ ابنتي تشاهدني
.فعليّ أن أبدو جيّدة من أجلها

313
00:17:33,530 --> 00:17:36,580
!لقد تطوّرت لحوالي مستويين آخرين

314
00:17:36,770 --> 00:17:38,960
!ما هذا الهراء الّذي تتفوّهين به؟

315
00:17:39,530 --> 00:17:42,490
!سأكون أنا من ستفوز في النّهاية

316
00:17:55,320 --> 00:17:58,680
!الفوز للمشاركة أزوسا

317
00:18:00,120 --> 00:18:01,840
!نجحتِ يا ماما

318
00:18:01,840 --> 00:18:03,610
!تهانينا يا أمّي

319
00:18:04,270 --> 00:18:07,250
هل أنت بخير يا بيلزيبب؟

320
00:18:07,250 --> 00:18:07,980
...نعم

321
00:18:07,980 --> 00:18:10,350
.لكنّ ذلك آلمني قليلاً

322
00:18:11,620 --> 00:18:12,730
.حسنًا

323
00:18:12,730 --> 00:18:16,420
!مهلاً! سأكون بخير بمجرّد أن أرتاح

324
00:18:16,420 --> 00:18:18,280
...وثمّة العديد من النّاس يشاهدوننا

325
00:18:18,520 --> 00:18:21,270
.أنت مصابة، فلا تشتكين

326
00:18:23,960 --> 00:18:26,040
!أنا أشكرك يا بيلزيبب

327
00:18:26,040 --> 00:18:27,300
.وأنا أيضًا

328
00:18:27,300 --> 00:18:28,670
.لا داعي لشكري

329
00:18:29,530 --> 00:18:32,210
.يبدو أنّني خسرت أمامك ثانية

330
00:18:32,210 --> 00:18:33,650
.كانت هزيمة نكراء

331
00:18:33,650 --> 00:18:36,880
.سأقاتلك ثانية إن كنت ما زلت تريدين القتال

332
00:18:36,880 --> 00:18:40,170
.لكنّ الأمر مزعج نوعًا ما
.لذلك سيكون عليك الانتظار لمدّة

333
00:18:40,350 --> 00:18:43,540
.أنت قويّة جدًّا، ومع ذلك لا حماس لك لهذا

334
00:18:43,540 --> 00:18:47,310
.لكنّ هذا قد يفسد حياتك الهادئة

335
00:18:47,700 --> 00:18:49,270
ماذا؟ ماذا تقصدين؟

336
00:18:49,270 --> 00:18:52,320
،إنّ قوّتك صارت معروفة الآن في الجنوب أيضًا

337
00:18:52,320 --> 00:18:54,940
.حيث لم تكن معروفة كثيرًا من قبل

338
00:18:55,120 --> 00:18:56,540
!ساحرة المرتفعات

339
00:18:56,540 --> 00:18:57,370
!أزوسا

340
00:18:57,370 --> 00:19:01,200
!أزوسا! أزوسا! أزوسا

341
00:18:57,590 --> 00:19:00,310
!السّاحرة العظمى! أزوسا

342
00:18:59,640 --> 00:19:01,190
!سُحقًا

343
00:19:03,440 --> 00:19:04,540
!يا مقاسلا

344
00:19:04,760 --> 00:19:07,680
!شكرًا لإعادة ابنتي لشكلها السّابق

345
00:19:07,680 --> 00:19:08,700
.لا داعي لشكري

346
00:19:09,350 --> 00:19:12,870
.أنا سعيدة لتمكّني من مساعدة سلايم أخرى

347
00:19:12,870 --> 00:19:16,460
لكن من المؤسف أنّني لم أفز بالمنافسة
.وأحصل على الجائزة الماليّة

348
00:19:16,680 --> 00:19:21,190
،لكنّني سأجني المال ثانية
!إن كان ذلك قطعة ذهبيّة  كلّ مرّة

349
00:19:21,190 --> 00:19:23,730
...نعم، المال مهمّ بالفعل

350
00:19:23,730 --> 00:19:27,990
إن كنت تعرفين أيّ أحداث لفنون قتاليّة حيث
!يمكنني الحصول على مال، فأعلميني

351
00:19:27,990 --> 00:19:31,480
!لكنّني كنتُ أرغب في تلك الجائزة الماليّة بالفعل

352
00:19:31,480 --> 00:19:33,520
...إنّك مهووسة بالمال قليلاً

353
00:19:33,790 --> 00:19:37,490
.في الحقيقة، أردت أن أطلب منك خدمة أيضًا

354
00:19:37,710 --> 00:19:38,940
ما هي؟

355
00:19:38,940 --> 00:19:41,940
!آنسة أزوسا، اقبليني كتلميذة رجاءً

356
00:19:41,940 --> 00:19:44,360
ماذا؟ تقصدين كتلميذة فنون قتاليّة؟

357
00:19:44,580 --> 00:19:48,140
نعم! لم أرَ من قبل وضعيّة
بالكثير نقاط الضّعف

358
00:19:48,140 --> 00:19:50,220
!ومع ذلك تتفادى كلّ الضّربات

359
00:19:50,220 --> 00:19:54,500
أنت الأقوى في شكلك الطّبيعي! ذلك
!هو مثلي الأعلى كممارسة فنون قتاليّة

360
00:19:54,750 --> 00:19:58,660
.اسمعي، لم تكن تلك وضعيّة أو ما شابه
.لديّ الكثير من نقاط الضّعف بالفعل

361
00:19:58,920 --> 00:20:01,810
.لذلك لا يوجد ما يمكنني تعليمك

362
00:20:01,810 --> 00:20:03,180
!أتفهّم ذلك

363
00:20:03,180 --> 00:20:05,810
!في تلك الحالة، دعيني أقاتلك ولو مرّة

364
00:20:05,810 --> 00:20:09,140
يمكنك تحديد إن كنتُ قويّة كفاية
!أم لا لأكون تلميذتك

365
00:20:10,210 --> 00:20:12,140
هل كنت تستمعين لي من الأساس؟

366
00:20:15,700 --> 00:20:17,510
!حسنًا، ها أنا ذي

367
00:20:17,770 --> 00:20:20,150
!قبضة السلايم بأسلوب مقاسلا

368
00:20:22,400 --> 00:20:23,100
!ارتعاد

369
00:20:23,970 --> 00:20:25,270
...هـ-هذه

370
00:20:25,670 --> 00:20:30,460
هالة يمكن فقط لمن قتلوا عددًا
!لا يُحصى من السلايم إطلاقها

371
00:20:30,460 --> 00:20:33,890
!صراخ العديد من الأرواح

372
00:20:33,890 --> 00:20:35,880
ما الخطب يا مقاسلا؟

373
00:20:37,130 --> 00:20:38,330
—الـ-النّجدة

374
00:20:44,230 --> 00:20:45,610
هل أنت مستيقظة الآن؟

375
00:20:45,610 --> 00:20:48,970
.لم أتوقّع أنّ ذلك القتال سينتهي قبل أن يبدأ

376
00:20:49,170 --> 00:20:51,940
لكن هل أقنعك ذلك بالعدول
عن سعيك لتكوني تلميذتي؟

377
00:20:51,940 --> 00:20:52,850
...نعم

378
00:20:53,290 --> 00:20:56,740
.إذًا فجميعكنّ هنا

379
00:20:56,740 --> 00:20:58,280
.حان الوقت للمغادرة

380
00:20:58,770 --> 00:21:00,720
!يا آنسة بيلزي

381
00:21:00,720 --> 00:21:04,070
!أدركت للتّوّ أنّ قوّتك أشبه بقوّة الشّياطين

382
00:21:04,070 --> 00:21:05,020
...أشبه

383
00:21:05,020 --> 00:21:06,140
!لمعان

384
00:21:05,260 --> 00:21:06,820
!اقبلي بي كتلميذة لديك

385
00:21:06,820 --> 00:21:08,480
.لا تتمتّع هذه الفتاة بأيّ نزاهة

386
00:21:08,480 --> 00:21:11,900
لماذا أقبل بك كتلميذة لديّ؟

387
00:21:11,900 --> 00:21:13,070
.لا، لن أفعل

388
00:21:13,070 --> 00:21:14,780
!رجاءً! أتوسّل إليك

389
00:21:14,780 --> 00:21:16,340
.لا أتّخذ تلاميذ

390
00:21:16,340 --> 00:21:18,320
.لكنّ ذلك قد ينجح

391
00:21:18,860 --> 00:21:21,000
،إن كنّا نعلم أين نجدها

392
00:21:21,000 --> 00:21:23,930
فسيكون من السّهل طلب مساعدتها
!إن تحوّلت ابني لسلايم ثانية

393
00:21:23,930 --> 00:21:24,820
!وميض

394
00:21:23,930 --> 00:21:26,050
!هل تحاولين أن تقومي برهني؟

395
00:21:26,050 --> 00:21:29,510
رجاءً! سأغسل أطباقك
!أو أفعل أيّ شيء تريدين

396
00:21:29,800 --> 00:21:32,370
.بيلزيبب، أتوسّل إليك أيضًا

397
00:21:32,370 --> 00:21:34,010
!وأنا أيضًا

398
00:21:34,010 --> 00:21:35,510
.وأنا

399
00:21:36,950 --> 00:21:39,570
!حسنًا، حسنًا! لا بأس

400
00:21:39,570 --> 00:21:43,340
!شكرًا لك

401
00:21:41,600 --> 00:21:44,520
.حسنًا، أظنّ أنّ القضيّة قد أقفلت بهذا

402
00:21:45,610 --> 00:21:47,080
!فالفا

403
00:21:47,080 --> 00:21:50,620
!سأدلّعك اليوم بقدر ما تشائين
ماذا تريدين أن تأكلي؟

404
00:21:50,890 --> 00:21:53,630
!ماما، أريد شيئًا حلوًا

405
00:21:53,820 --> 00:21:56,620
.حسنًا، ربّما سأعدّ كعكة أو ما شابه

406
00:21:56,620 --> 00:21:57,990
.سأساعد أيضًا

407
00:21:58,210 --> 00:22:00,510
!وسأساعد أنا أيضًا

408
00:22:01,290 --> 00:22:04,860
،وصلتُ لأقصى مستواي دون أن أدرك