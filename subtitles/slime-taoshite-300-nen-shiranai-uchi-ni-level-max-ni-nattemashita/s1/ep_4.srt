1
00:00:30,300 --> 00:00:31,160
.ليست لديّ

2
00:00:35,330 --> 00:00:36,640
.ليس لديّ كما قلت

3
00:00:40,620 --> 00:00:43,090
شابّة؟ كم عمرك على أيّ حال؟

4
00:00:43,270 --> 00:00:44,450
!لمعان

5
00:00:48,100 --> 00:00:49,990
!أي أنّ عمرك تجاوز 200 سنة

6
00:00:58,800 --> 00:01:00,530
!أحبّ ماما

7
00:01:00,530 --> 00:01:02,290
.إجابتي هي نفسها أيضًا

8
00:01:02,740 --> 00:01:04,790
!يا ابنتاي العزيزتان

9
00:01:07,920 --> 00:01:10,040
.المائدة جاهزة يا سيّداتي

10
00:01:12,200 --> 00:01:14,230
!شكرًا لك يا لايكا

11
00:01:14,230 --> 00:01:15,760
!حسنًا، لا داعي للانتظار

12
00:01:15,760 --> 00:01:17,300
!لنبدأ الأكل

13
00:01:16,640 --> 00:01:18,000
...عفوًا يا سيّدتي أزوسا

14
00:01:20,720 --> 00:01:23,070
.سوف أعود إلى منزلي

15
00:02:59,410 --> 00:03:01,460
!لكنّني سأفتقدك

16
00:03:01,460 --> 00:03:02,360
.وأنا أيضًا

17
00:03:02,660 --> 00:03:06,110
لايكا، أثمّة شيء يزعجك أو يقلقك
حيال الحياة الّتي نعيشها؟

18
00:03:06,460 --> 00:03:08,040
—لا، إنّ

19
00:03:08,040 --> 00:03:10,020
،أعرف أنّني معلّمتك وأنت تلميذتي

20
00:03:10,020 --> 00:03:12,240
!لكنّني أعتبر جميع من هنا عائلتي

21
00:03:12,240 --> 00:03:15,210
!لذلك لا تقولي أنّك ستغادرين

22
00:03:15,210 --> 00:03:17,500
.عفوًا، الأمر ليس هكذا بالضّبط

23
00:03:18,100 --> 00:03:20,780
،سأقوم بحضور زفاف أختي الكبيرة

24
00:03:20,780 --> 00:03:23,440
.لذلك عليّ العودة للمنزل لوقت قصير

25
00:03:23,440 --> 00:03:25,180
ماذا؟ زفاف؟

26
00:03:25,180 --> 00:03:28,420
هل تردن مرافقتي؟

27
00:03:36,490 --> 00:03:38,030
...وهكذا

28
00:03:39,470 --> 00:03:44,070
انطلقنا إلى جبل روكّو، البركان
.الّذي تعيش فيه عائلة لايكا

29
00:03:44,630 --> 00:03:47,320
يا له من منظر رائع، صحيح يا هالكارا؟

30
00:03:49,850 --> 00:03:52,940
.على مهلك، على مهلك. على مهلك

31
00:03:52,940 --> 00:03:55,970
.على مهلك. أخرجي كلّ ما في معدتك

32
00:04:01,010 --> 00:04:03,880
.هل أنت بخير؟ لا تضغطي على نفسك كثيرًا

33
00:04:11,330 --> 00:04:11,870
!لمعان

34
00:04:11,870 --> 00:04:13,130
.لن أفعل قطعًا

35
00:04:15,490 --> 00:04:17,860
.سنصل قريبًا يا سيّداتي

36
00:04:18,500 --> 00:04:20,540
.هذا جبل روكّو

37
00:04:23,270 --> 00:04:25,870
.هذا المكان المخصّص للحفلة الأولى

38
00:04:25,870 --> 00:04:28,630
!هذا مذهل! ثمّة تنانين كثيرة

39
00:04:29,010 --> 00:04:31,720
.من ناحية إحيائيّة، إنّها تنانين حمراء

40
00:04:31,720 --> 00:04:34,630
.إنّها تُصنّف كجزء من عشيرة التّنانين بدل وحوش

41
00:04:37,530 --> 00:04:40,250
.تحيّة طيّبة يا أختنا الكبيرة لايكا

42
00:04:40,470 --> 00:04:41,430
...مهلاً

43
00:04:42,220 --> 00:04:45,180
.يبدو جناحاك جميلين كالعادة اليوم

44
00:04:45,180 --> 00:04:48,820
.إنّ أكثر ما نحتاجه ليست الأجنحة الّتي ولدنا بها

45
00:04:48,820 --> 00:04:50,730
.بل المعرفة هي ما نحتاج لإغنائه

46
00:04:50,730 --> 00:04:53,180
!إنّك رائعة للغاية يا أختنا الكبيرة لايكا

47
00:04:53,360 --> 00:04:56,170
لماذا أشعر وكأنّني في مدرسة لفتيات غنيّات؟

48
00:04:56,380 --> 00:04:58,300
.المعذرة يا سيّدتي أزوسا

49
00:04:58,300 --> 00:05:00,680
.إنّهنّ زميلاتي الأصغر في مدرسة البنات

50
00:05:00,680 --> 00:05:03,100
!زميلات أصغر من مدرسة البنات؟

51
00:05:03,100 --> 00:05:05,400
!أختي الكبيرة

52
00:05:05,700 --> 00:05:08,940
.والآن، اسمحن لي أن أعرّفكنّ على عائلتي

53
00:05:10,440 --> 00:05:12,480
!يا للضّخامة

54
00:05:12,480 --> 00:05:14,200
.إنّها كائنات ضخمة بالفعل

55
00:05:14,650 --> 00:05:18,480
.احرصن ألاّ تدسن على أيّ صحن

56
00:05:26,310 --> 00:05:27,760
...لقد عدت

57
00:05:28,150 --> 00:05:30,070
.يا أبي وأمّي

58
00:05:30,070 --> 00:05:32,000
.أهلًا بعودتك يا لايكا

59
00:05:32,220 --> 00:05:35,410
!من الجيّد تواجدك في المنزل يا ابنتي

60
00:05:38,240 --> 00:05:40,270
.والدك مبتهج للغاية

61
00:05:40,270 --> 00:05:42,530
!يا أبي، ثمّة ضيوف هنا

62
00:05:42,530 --> 00:05:43,970
.عفوًا، أعتذر

63
00:05:45,830 --> 00:05:48,760
.أخبرتنا ابنتنا عنك

64
00:05:48,760 --> 00:05:51,020
لم تتسبّب في أيّ مشاكل، صحيح؟

65
00:05:51,330 --> 00:05:54,840
.على الإطلاق، بل إنّها عون كبير لنا

66
00:05:54,840 --> 00:05:56,040
!لايكا

67
00:05:56,820 --> 00:05:58,050
!أختي

68
00:05:58,570 --> 00:06:00,110
!تمكّنت من الحضور

69
00:06:00,370 --> 00:06:02,660
.هذان هما أختي الكبيرة وعريسها

70
00:06:02,660 --> 00:06:04,690
.أنا أخت لايكا الكبيرة، ليلى

71
00:06:04,690 --> 00:06:07,800
.تهانينا على زفافكما

72
00:06:10,550 --> 00:06:12,050
...إنّها منغمسة في هذا بالفعل

73
00:06:12,590 --> 00:06:15,060
،كنّا صديقين منذ الطّفولة

74
00:06:15,060 --> 00:06:19,030
لكن عندما رأينا بعضنا ثانية
.بعد 80 سنة، قرّرنا أن نتزوّج

75
00:06:19,030 --> 00:06:21,300
!إنّ 80 سنة لَفترةٌ طويلة

76
00:06:21,610 --> 00:06:24,540
.ولكنّني سعيد لأنّ اليوم يومٌ مسالم

77
00:06:24,540 --> 00:06:27,080
.أتمنّى أن ينتهي الاحتفال دون حوادث

78
00:06:27,290 --> 00:06:29,950
هل أنت قلق من حدوث أمر ما؟

79
00:06:30,430 --> 00:06:34,870
.نعم. لا تتوافق كلّ العشائر من التّنانين مع بعضها

80
00:06:34,870 --> 00:06:38,700
وأحيانًا، تأتي تنانين من عشائر
.أخرى لإفساد حفلات زفافنا

81
00:06:38,960 --> 00:06:41,290
...أنا واثقة أنّ ذلك كان نذيرًا

82
00:06:43,870 --> 00:06:45,960
...إذًا فقد أتيت بالفعل

83
00:06:46,350 --> 00:06:47,910
!أيّتها التّنانين الزّرقاء

84
00:06:53,520 --> 00:06:54,980
!زفير بارد؟

85
00:06:57,310 --> 00:06:58,880
...هذا بارد

86
00:06:58,240 --> 00:07:01,260
!إنّها التّنانين الزّرقاء من منطقة هاينت

87
00:07:01,530 --> 00:07:05,020
إنّها تنانين متوحّشة ووقحة تنفث
!زفيرها الجليديّ في كلّ مكان

88
00:07:06,260 --> 00:07:11,030
.أيّتها التّنانين الحمراء، سمعت أنّك تحتفلين بزفاف اليوم

89
00:07:12,740 --> 00:07:16,280
.إنّ ذلك يغضبني، لذلك جئنا لإقلاق راحتك

90
00:07:16,890 --> 00:07:19,500
.إنّها تُدعى فلاتورتي

91
00:07:19,500 --> 00:07:23,020
.إنّها تُعرف بملكة المُتنمّرين بين التّنانين الزّرقاء

92
00:07:23,020 --> 00:07:24,540
.تبدو مزعجة بالفعل

93
00:07:24,770 --> 00:07:28,170
ما هذه الجرأة الّتي سمحت لكما بالزّواج
!وبالكاد تجاوزتما 300 سنة

94
00:07:28,570 --> 00:07:31,970
!إنّني عزباء لأزيد من 400 سنة

95
00:07:31,970 --> 00:07:33,920
!هذا أكثر سبب مثير للشّفقة يمكن تقديمه

96
00:07:34,400 --> 00:07:37,910
.لن أقوم بمضايقة مكان الاحتفال هذا فحسب

97
00:07:38,350 --> 00:07:41,140
.أرسلت قوّة منفصلة إلى البركان

98
00:07:41,140 --> 00:07:42,940
!سنجمّده بالكامل أيضًا

99
00:07:43,200 --> 00:07:44,160
...أبي

100
00:07:44,160 --> 00:07:46,180
...لا خيار أمامنا. إنّ هذا يستدعي

101
00:07:46,450 --> 00:07:48,440
!مواجهة شاملة

102
00:07:50,910 --> 00:07:52,860
.أنا خائفة يا ماما

103
00:07:52,860 --> 00:07:54,920
.علينا مغادرة المكان

104
00:07:54,920 --> 00:07:57,590
.اسمعا، دعا هذا لأمّكما فحسب

105
00:07:57,590 --> 00:07:59,090
!هالكارا، سنهرب

106
00:07:59,090 --> 00:08:00,430
...صدمة

107
00:08:00,430 --> 00:08:01,880
!ما الّذي تفعلينه؟

108
00:08:16,350 --> 00:08:17,340
!ماما

109
00:08:19,400 --> 00:08:20,350
!انبطحن

110
00:08:24,520 --> 00:08:25,470
!لنذهب

111
00:08:26,140 --> 00:08:29,410
!فلاتورتي، لن أسمح بالمزيد من العنف

112
00:08:29,410 --> 00:08:30,960
!اخرسي يا لايكا

113
00:08:30,960 --> 00:08:34,750
لم تنسي مصير قبائل التّنانين، صحيح؟

114
00:08:34,860 --> 00:08:37,010
.آمل أن تكوني مستعدّة إذًا

115
00:08:37,010 --> 00:08:38,160
!أرني أفضل ما لديك

116
00:08:46,550 --> 00:08:48,410
.سنكون بخير هنا

117
00:08:51,260 --> 00:08:53,150
!هذا متوقّع من تلميذتي

118
00:08:54,520 --> 00:08:55,940
،هذا يزعجني بالفعل

119
00:08:56,250 --> 00:08:58,500
.لكنّ هذه مشكلة تخصّ عشيرتها

120
00:08:58,500 --> 00:09:01,060
.لا يجب على غريبة مثلي التّدخّل

121
00:09:04,060 --> 00:09:06,820
أنتنّ صديقات التّنانين الحمراء، صحيح؟

122
00:09:07,340 --> 00:09:09,560
وماذا إن كنّا صديقات لها؟

123
00:09:09,560 --> 00:09:13,830
!سنقوم بأذيّتكنّ وإفساد الزّفاف

124
00:09:14,140 --> 00:09:15,140
!ماما

125
00:09:15,140 --> 00:09:16,220
...أمّي

126
00:09:18,030 --> 00:09:22,050
...كفّ عن إخافة الصّغار هكذا

127
00:09:23,130 --> 00:09:25,040
!أيّها المتنمّر الكبير

128
00:09:29,120 --> 00:09:30,750
!أنت مذهلة يا ماما

129
00:09:30,750 --> 00:09:32,070
...لك كلّ احترامي

130
00:09:32,070 --> 00:09:35,790
.هالكارا، خذي فالفا وشالشا لمكان ما واختبئن

131
00:09:38,880 --> 00:09:42,180
،وصلتُ لأقصى مستواي دون أن أدرك

132
00:09:42,570 --> 00:09:45,940
...لكنّني سأستعمل هذه القوّة لحماية عائلتي

133
00:09:46,840 --> 00:09:49,010
!بأيّ طريقة أستطيع

134
00:09:50,050 --> 00:09:51,690
لايكا، أيمكننا تولّي أمرها؟

135
00:09:51,690 --> 00:09:54,830
.ثمّة الكثير منها، حتّى بالنّسبة لنا

136
00:09:58,330 --> 00:09:59,370
!ماذا؟

137
00:09:59,370 --> 00:10:00,190
...أهذه

138
00:10:05,010 --> 00:10:06,460
!سيّدتي أزوسا

139
00:10:06,910 --> 00:10:07,710
!اللّعنة

140
00:10:12,130 --> 00:10:13,100
!ما-ماذا؟

141
00:10:18,700 --> 00:10:20,860
!اهجموا جميعًا

142
00:10:22,840 --> 00:10:23,590
!انتبهي

143
00:10:29,960 --> 00:10:31,080
!ماذا؟

144
00:10:37,790 --> 00:10:39,940
أطاحت بالكثير منها وحدها؟

145
00:10:40,540 --> 00:10:43,110
!سيّدتي أزوسا! فلاتورتي خلفك

146
00:10:43,530 --> 00:10:45,990
من أنت يا هذه؟

147
00:10:46,350 --> 00:10:50,250
كيف؟ كيف تمكّنت بشريّةٌ مثلك
من هزيمة تنّين؟

148
00:10:51,570 --> 00:10:55,290
.لم تُبنَ روما في يوم واحد
.أعتقد أنّ هذا هو جوهر الأمر

149
00:10:55,620 --> 00:10:56,630
روما؟

150
00:10:56,630 --> 00:10:59,100
،هذا يعني أنّه مع مواصلة العمل الجيّد بثبات

151
00:10:59,100 --> 00:11:01,170
!فسيُؤتي ذلك أُكله

152
00:11:04,210 --> 00:11:05,090
.سُحقًا

153
00:11:05,670 --> 00:11:07,780
!سأجمّدك

154
00:11:08,280 --> 00:11:09,540
.بربّك

155
00:11:09,540 --> 00:11:11,640
!أذلك كلّ ما تجيدين فعله؟

156
00:11:11,860 --> 00:11:12,490
!خذي هذا

157
00:11:17,580 --> 00:11:18,980
!هذا ساخن

158
00:11:19,920 --> 00:11:21,410
...ركلة

159
00:11:22,540 --> 00:11:23,990
!فأس السّاحرة

160
00:11:30,260 --> 00:11:31,990
أما زلت تريدين القتال؟

161
00:11:33,310 --> 00:11:35,390
!نحن آسفون

162
00:11:35,780 --> 00:11:37,210
!سيّدتي أزوسا

163
00:11:38,720 --> 00:11:41,520
!أيّها الحضور! فازت سيّدتي أزوسا بالمعركة

164
00:11:42,050 --> 00:11:44,910
!هذه هي قوّة ساحرة المرتفعات

165
00:11:44,910 --> 00:11:47,450
!تحيا ساحرة المرتفعات

166
00:11:46,890 --> 00:11:48,020
!لايكا

167
00:11:48,170 --> 00:11:50,260
.ما زال الوقت باكرًا لنقول أنّنا انتهينا

168
00:11:50,550 --> 00:11:53,940
سبق وذكرت بالفعل أنّها أرسلت
.قوّة منفصلة إلى البركان

169
00:11:54,370 --> 00:11:57,100
.يا سيّدتي أزوسا، اركبي على ظهري رجاءً

170
00:11:57,100 --> 00:11:57,810
!حسنًا

171
00:12:06,670 --> 00:12:08,540
،ثمّة ينابيع ساخنة في هذه البلدة

172
00:12:08,850 --> 00:12:12,170
.لذلك أنا قلقة أن يتأذّى السّائحون الأبرياء

173
00:12:12,170 --> 00:12:16,170
.من أوّل وهلة، لا أرى أيّ علامات على القتال

174
00:12:16,170 --> 00:12:19,400
...إن كان لا يحدث شيئًا، فذلك أفضل، لكن

175
00:12:19,840 --> 00:12:24,270
.أردت فقط أن يكون زفاف أختي مناسبة سارّة

176
00:12:24,980 --> 00:12:27,690
،لا تقلقي. سينتهي هذا قريبًا

177
00:12:28,040 --> 00:12:30,890
.وسيستمرّ زفاف أختك بعدها

178
00:12:31,720 --> 00:12:32,660
.صحيح

179
00:12:34,650 --> 00:12:35,600
ما هذا؟

180
00:12:35,600 --> 00:12:36,710
...سيّدتي أزوسا

181
00:12:39,340 --> 00:12:40,190
!ما هذا؟

182
00:12:40,190 --> 00:12:41,320
تنانين زرقاء؟

183
00:12:42,230 --> 00:12:44,820
!إنّ هذا يمتصّ قواها ليضعفها

184
00:12:45,230 --> 00:12:47,830
.هذ سحر مخادع للغاية

185
00:12:47,830 --> 00:12:49,590
ما الّذي أتى بكما إلى هنا؟

186
00:12:49,890 --> 00:12:52,630
.يا لها من مفاجأة أن ألقاكما هنا

187
00:12:52,630 --> 00:12:53,570
!بيلزيبب

188
00:12:53,900 --> 00:12:55,910
ماذا تفعلين هنا؟

189
00:12:55,910 --> 00:12:59,410
.تخرج من هذا البركان ينابيع ساخنة ممتازة

190
00:12:59,410 --> 00:13:02,330
.آتي إلى هنا من حين لآخر لأسترخي وأستعيد نشاطي

191
00:13:02,580 --> 00:13:04,350
...فهذا يعني

192
00:13:04,500 --> 00:13:07,810
،صحيح، كنت أتجوّل في البلدة

193
00:13:07,810 --> 00:13:12,160
ووجدت هذه المخلوقات الحمقاء
،تقول أنّها هنا لمضايقة هذا المكان

194
00:13:12,160 --> 00:13:16,940
لذلك أريتها بعضًا من سحر الشّياطين
.يسبّب ضعفًا شديدًا لها

195
00:13:16,940 --> 00:13:20,350
هزمتِ خمسة من التّنانين الزّرقاء؟

196
00:13:20,590 --> 00:13:24,230
.أنا شيطانة سامية عاشت لـ3000 سنة

197
00:13:24,230 --> 00:13:25,610
.خسارتي ضرب من المحال

198
00:13:25,960 --> 00:13:28,860
وأنت يا أزوسا، لا يمكنك حتّى إدراك ما سيحدث

199
00:13:28,860 --> 00:13:30,950
في المرّة القادمة الّتي ستقاتلينني
.فيها بعدل وإنصاف

200
00:13:31,300 --> 00:13:33,660
...فأنا قويّة قبل

201
00:13:32,690 --> 00:13:34,120
!بيلزيبب

202
00:13:34,320 --> 00:13:38,440
!أنقذتِ للتّوّ التّنانين الحمراء من كارثة

203
00:13:38,440 --> 00:13:39,630
!شكرًا لك

204
00:13:39,630 --> 00:13:41,010
!لا تعانقيني

205
00:13:41,010 --> 00:13:42,710
!لم أفعل ذلك من أجلك

206
00:13:42,710 --> 00:13:45,620
أطحت بهذه التّنانين فقط
!لأنّها كانت تتصرّف بتعالٍ

207
00:13:45,990 --> 00:13:47,140
.شمّ، شمّ

208
00:13:47,550 --> 00:13:49,630
!رائحتك عطِرة

209
00:13:49,630 --> 00:13:52,260
.هذا لأنّني خرجت حديثًا من الحمّام

210
00:13:52,530 --> 00:13:55,840
!مهلاً، انسي ذلك! اتركيني بسرعة

211
00:14:01,780 --> 00:14:03,870
!كنت خائفة يا ماما

212
00:14:03,870 --> 00:14:04,770
...أمّي

213
00:14:06,970 --> 00:14:07,520
.نعم

214
00:14:07,730 --> 00:14:09,750
.كلّ ذلك بفضل بيلزبيب

215
00:14:09,750 --> 00:14:13,030
.يا إلهي. كنت هنا من أجل الحمّامات فحسب

216
00:14:13,470 --> 00:14:16,670
...حسنًا، أعتقد أنّ الوقت قد حان لننهي هذا

217
00:14:17,150 --> 00:14:18,380
.يا فطيرة الفلافل

218
00:14:18,380 --> 00:14:21,790
!اسمي فلاتورتي! تذكّري اسمي جيّدًا

219
00:14:21,790 --> 00:14:24,420
.فهمت. تغيّري إلى شكلك البشريّ بسرعة

220
00:14:24,420 --> 00:14:25,830
.دعينا نتحدّث

221
00:14:33,350 --> 00:14:35,050
أهذا ما تريدينه؟

222
00:14:35,610 --> 00:14:38,490
هذا هو المبلغ الّذي تدينين
.به لنا جرّاء أضرار اليوم

223
00:14:38,710 --> 00:14:40,370
.سيكون عليك دفعه

224
00:14:40,370 --> 00:14:40,970
!ماذا؟

225
00:14:41,150 --> 00:14:43,260
أ-أستجعلينني أدفع كلّ هذا؟

226
00:14:43,260 --> 00:14:44,810
،سيغطّي هذا كلّ النّفقات

227
00:14:44,810 --> 00:14:47,240
.بما في ذلك معالجة المصابين وتعويضات الإزعاج

228
00:14:47,400 --> 00:14:50,190
.إن رفضتِ، فلن تتحرّكي من هذا المكان أبدًا

229
00:14:50,340 --> 00:14:51,420
أهذا ما تريدينه؟

230
00:14:51,420 --> 00:14:53,440
...أ-أنا لا أريد ذلك أيضًا

231
00:14:54,370 --> 00:14:57,740
.حسنًا. سأقبل بشروطك

232
00:14:57,740 --> 00:14:59,960
.جيّد. تمّت المفاوضات

233
00:15:00,150 --> 00:15:03,960
،لكن بما أنّنا نتحدّث الآن
.ثمّة أمر آخر أريد مناقشتك فيه

234
00:15:04,480 --> 00:15:07,920
،أريدك أن توقّعي على معاهدة
.إضافة للأضرار الّتي ستعوِّضين عنها

235
00:15:07,920 --> 00:15:09,210
معاهدة؟

236
00:15:09,450 --> 00:15:13,980
.نعم. معاهدة عدم عدوان بين التّنانين الزّرقاء والحمراء

237
00:15:14,270 --> 00:15:17,880
.وبالطّبع، سيكون المجيء لمضايقتها جزءًا من ذلك

238
00:15:17,880 --> 00:15:20,980
!لـ-لكن لن يكون لديّ سبب آخر للعيش

239
00:15:21,150 --> 00:15:24,480
إن لم توافقي، فلن تتمكّني أبدًا
.من العودة لموطنك

240
00:15:24,860 --> 00:15:27,070
أتريدين أن تشعري وكأنّك عالقة في العمل

241
00:15:27,070 --> 00:15:29,520
لثلاثة أيّام متواصلة دون أيّ فرصة للعودة للمنزل؟

242
00:15:29,940 --> 00:15:31,490
!ابتسامتك تخيفني

243
00:15:31,940 --> 00:15:34,470
لذلك، لنوقّع هذه المعاهدة، موافقة؟

244
00:15:34,730 --> 00:15:37,120
!حسنًا، موافقة! أنا موافقة

245
00:15:37,460 --> 00:15:39,870
...لذلك سامحيني رجاءً

246
00:15:40,090 --> 00:15:42,860
.حسنًا، تمّت المعاهدة

247
00:15:42,860 --> 00:15:45,420
.سينعم جبل روكّو بالسّلام الآن

248
00:15:45,420 --> 00:15:46,620
...سيّدتي أزوسا

249
00:15:47,040 --> 00:15:50,540
!شكرًا لقيامك بهذا لموطني

250
00:15:51,690 --> 00:15:54,130
بيلزيبب، يمكنك تولّي الباقي، صحيح؟

251
00:15:54,130 --> 00:15:55,400
.أعلم

252
00:15:55,700 --> 00:15:56,380
.أحّم

253
00:15:56,600 --> 00:16:02,880
إنّنا أنا وساحرة المرتفعات كنّا شاهدتين
.على توقيع هذه المعاهدة

254
00:16:03,210 --> 00:16:06,440
...إن قام أحد الطّرفين فيها بنقضنا

255
00:16:06,440 --> 00:16:07,890
تعلمين ما سيحدث، صحيح؟

256
00:16:07,890 --> 00:16:08,700
!تذلّل

257
00:16:09,010 --> 00:16:11,650
...ما كان عليّ القيام بهذا أساسًا

258
00:16:11,830 --> 00:16:14,900
!بيلزيبب، شكرًا جزيلاً على كلّ شيء

259
00:16:14,900 --> 00:16:19,040
.لا أحد سواك قد يستغلّ سيّدة الذّباب هكذا

260
00:16:19,040 --> 00:16:22,410
!سأعتمد عليك أكثر من الآن فصاعدًا

261
00:16:22,410 --> 00:16:24,230
!كفّي عن معانقتي مقابل كلّ صغيرة وكبيرة

262
00:16:28,340 --> 00:16:31,390
يأخذ الجميع شكله البشريّ للحفلة الثّانية إذًا؟

263
00:16:31,390 --> 00:16:34,840
!صحيح، إنّنا نأكل حتّى الشّبع في الحفلة الثّانية

264
00:16:35,310 --> 00:16:37,090
.شبعت سلفًا

265
00:16:37,800 --> 00:16:40,130
.شالشا، عليك أن ترتاحي قليلاً

266
00:16:40,130 --> 00:16:41,050
.شكرًا لك

267
00:16:41,360 --> 00:16:45,520
.فالفا، إنّك تتصرّفين كأخت كبيرة جيّدة

268
00:16:51,850 --> 00:16:56,070
.هالكارا، أكلتِ الكثير قبل الشّرب
.من الأفضل أن تكوني حذرة

269
00:17:01,780 --> 00:17:02,580
!ذلك هو قصدي

270
00:17:04,870 --> 00:17:10,430
يا إلهي إنّ تلك الإلف لا تجيد
.إلاّ صناعة الخمر المغذّي

271
00:17:10,430 --> 00:17:11,720
.سيّدة أزوسا

272
00:17:13,520 --> 00:17:14,340
...مذهلة

273
00:17:14,760 --> 00:17:16,470
!تبدين رائعة يا ليلى

274
00:17:16,920 --> 00:17:21,340
.تمكّنّا من مواصلة المراسم بفضلكنّ جميعًا

275
00:17:21,340 --> 00:17:22,340
.نحن ممتنّان لكنّ

276
00:17:22,340 --> 00:17:25,990
.لا، لا... كلّ ما فعلت هو المساعدة قليلاً

277
00:17:25,990 --> 00:17:28,530
.من الجيّد معرفة أنّك تعرف مقامك

278
00:17:28,750 --> 00:17:31,060
،إن واصلت تبجيلي بهذه الطّريقة

279
00:17:31,060 --> 00:17:33,770
.فسأكون مسرورة لتقديم مساعدتي ثانية

280
00:17:33,990 --> 00:17:36,200
.بيلزيبب، لا تتصرّفي بقوّة وسموّ هكذا

281
00:17:36,200 --> 00:17:39,340
.وهل يمكنك لومي؟ أنا قويّة وسامية بالفعل

282
00:17:40,640 --> 00:17:42,860
.أنا سعيدة من أجلك يا لايكا

283
00:17:43,460 --> 00:17:46,640
.صار لديك صديقات رائعات

284
00:17:47,000 --> 00:17:50,220
.لن تكوني وحيدة الآن عندما لن أكون في الجوار

285
00:17:50,680 --> 00:17:51,880
...أختي

286
00:17:54,240 --> 00:17:55,910
.أنا أهنّئك بالفعل

287
00:17:56,480 --> 00:17:58,670
.شكرًا لك يا لايكا

288
00:18:01,150 --> 00:18:01,870
—أختي

289
00:18:01,870 --> 00:18:03,390
ليلى، أتسمحين لي؟

290
00:18:03,840 --> 00:18:05,400
...بشأن خططنا بعد هذا

291
00:18:11,470 --> 00:18:13,800
...حسنًا... ليلى

292
00:18:13,800 --> 00:18:15,170
.تهانينا

293
00:18:15,170 --> 00:18:17,150
.من الأفضل أن تعيشي بسعادة

294
00:18:17,410 --> 00:18:19,090
...فلاتورتي

295
00:18:19,490 --> 00:18:21,400
.هُزمت هذه المرّة

296
00:18:22,070 --> 00:18:24,900
.وبعد خسارتي، أقدّم لك أصدق بركاتي

297
00:18:25,040 --> 00:18:28,660
لتلك التّنّينة الزّرقاء محاسنها أيضًا، صحيح؟

298
00:18:29,570 --> 00:18:30,410
.شكرًا لك

299
00:18:31,310 --> 00:18:33,680
،سأعيش بسعادة من أجلك أيضًا

300
00:18:33,680 --> 00:18:35,040
.بما أنّك لا تستطيعين الزّواج

301
00:18:35,040 --> 00:18:36,430
!لماذا كان عليك قول ذلك؟

302
00:18:36,650 --> 00:18:39,670
!الأمر ليس أنّني لا أستطيع! بل لن أفعل فحسب

303
00:18:39,670 --> 00:18:42,900
ماذا؟ ألم تأتين إلى هنا لتمنحيني بركاتك؟

304
00:18:42,900 --> 00:18:46,180
!لا يهمّ! آمل أن تتطلّقي في الحال

305
00:18:46,540 --> 00:18:49,930
.العلاقة بين التّنانين الحمراء والزّرقاء معقّدة

306
00:18:49,930 --> 00:18:52,630
.هذا هو الانطباع الّذي أخذته بعد ما حدث للتّوّ

307
00:18:56,110 --> 00:19:00,440
!لقد أكلت الكثير. وكان كلّ شيء لذيذًا

308
00:19:01,350 --> 00:19:05,520
.آمل أن تكون هالكارا بخير
.بدت لي أنّها شربت الكثير

309
00:19:05,520 --> 00:19:08,540
...عـ-عفوًا يا سيّدتي أزوسا

310
00:19:12,130 --> 00:19:16,120
.أودّ... طلب خدمة منك

311
00:19:19,590 --> 00:19:23,730
،لطالما كنتُ رياضيّة أكثر من أختي

312
00:19:23,730 --> 00:19:26,480
...وكنت مقاتلة أفضل أيضًا

313
00:19:27,220 --> 00:19:30,750
لكن عندما كان والدانا يصرخان
،في وجهي أو إن أزعجني شيء ما

314
00:19:31,710 --> 00:19:34,710
.كانت تقوم أختي الكبيرة بهذا لي دائمًا

315
00:19:38,410 --> 00:19:42,500
سيكون من الصّعب أن تطلبي هذا
منها الآن وقد تزوّجت، صحيح؟

316
00:19:42,500 --> 00:19:43,240
.نعم

317
00:19:45,320 --> 00:19:46,120
...حسنًا

318
00:19:46,760 --> 00:19:49,740
.لن أمانع من القيام بهذا من حين لآخر

319
00:19:50,180 --> 00:19:52,170
...كـ-كلاّ

320
00:19:53,080 --> 00:19:55,930
.يمكننا اعتبار هذه مناسبة خاصّة

321
00:20:00,190 --> 00:20:01,950
.شكرًا لك

322
00:20:05,110 --> 00:20:06,020
ماذا يحدث؟

323
00:20:06,730 --> 00:20:09,140
ما الّذي تفعله؟

324
00:20:09,420 --> 00:20:12,060
.يا هالكارا، استيقظي

325
00:20:12,060 --> 00:20:14,140
.لا يجب المبالغة في شرب الخمر

326
00:20:19,680 --> 00:20:22,910
.يا إلهي، لا تجلب هذه الإلف إلاّ المشاكل

327
00:20:23,690 --> 00:20:24,920
.حسنًا

328
00:20:27,310 --> 00:20:31,000
إن تقيّأتِ، سأمزّقك لأشلاء وسأشوي
.كلّ جزء منك، حتّى روحك

329
00:20:32,620 --> 00:20:34,680
!بيلزيبب! آسفة على هذا

330
00:20:35,050 --> 00:20:38,200
.أزوسا، أظنّ أنّها نالت كفايتها

331
00:20:38,200 --> 00:20:42,170
بما أنّكنّ هنا، لماذا لا تقضين اللّيلة
في منتجع ينابيع البركان السّاخنة؟

332
00:20:42,370 --> 00:20:44,520
.أنا مقيمة هناك أيضًا

333
00:20:44,520 --> 00:20:46,670
الينابيع السّاخنة؟ ما العمل؟

334
00:20:46,670 --> 00:20:48,930
!أريد الذّهاب للينابيع السّاخنة

335
00:20:49,180 --> 00:20:52,880
،يوجد في ينابيع روكّو السّاخنة سبعة أنواع منها

336
00:20:52,880 --> 00:20:54,950
.باستثناء الكبريتيّة والحمضيّة منها فحسب

337
00:20:54,950 --> 00:20:57,430
.إنّها جيّدة لمن لديهم حساسيّة أو ضغط دم مرتفع

338
00:20:58,010 --> 00:21:01,370
.إن أردت البقاء هناك، فسأقوم بالإجراءات

339
00:21:01,370 --> 00:21:04,200
...حسنًا، لا حاجة لنعود للمنزل اللّيلة، لذا

340
00:21:04,640 --> 00:21:06,080
!لنقم هناك

341
00:21:06,080 --> 00:21:07,340
!أجل

342
00:21:08,580 --> 00:21:10,470
نقر-نقر

343
00:21:10,470 --> 00:21:11,460
...صدقًا

344
00:21:11,640 --> 00:21:16,700
.أستمتع بوجودي مع بعض الرّفقة
.أعرف أنّنا سنستمتع بوقتنا دائمًا

345
00:21:17,350 --> 00:21:21,520
أوتعلمين يا بيلزيبب؟ إنّك تساعدينني
،كثيرًا عندما أطلب منك

346
00:21:21,520 --> 00:21:22,850
.وتحبّين الاعتناء بنا

347
00:21:23,120 --> 00:21:24,930
.إنّك أشبه بأخت كبرى

348
00:21:24,930 --> 00:21:26,830
أنا؟ أخت كبرى؟

349
00:21:27,160 --> 00:21:30,090
.يبدو لي أنّك تستغلّينني لراحة بالك فحسب

350
00:21:30,460 --> 00:21:32,350
...لديّ ابنتان

351
00:21:32,940 --> 00:21:34,790
...ولايكا هي أختي الصّغيرة

352
00:21:35,490 --> 00:21:37,400
.وبيلزيبب هي أختي الكبيرة

353
00:21:37,610 --> 00:21:39,770
تبدو لي كعائلة جيّدة بالفعل، صحيح؟

354
00:21:46,720 --> 00:21:48,480
.نعم، هذا صحيح

355
00:21:48,480 --> 00:21:51,780
...لحظة... هالكارا ستكون

356
00:21:51,780 --> 00:21:53,290
!الصّغيرة المثيرة للمشاكل

357
00:21:59,830 --> 00:22:01,570
!آسفة، آسفة