يكفي! اكتفيت

114
00:09:46,010 --> 00:09:48,330
توقّفي وحسب أيّتها المبتدئة

115
00:09:51,760 --> 00:09:52,730
حاضرة

116
00:09:55,270 --> 00:09:56,990
دعيه

117
00:10:02,310 --> 00:10:04,800
كنتِ في برنامج عدّاء النصل؟

118
00:10:06,440 --> 00:10:07,960
لا داعي للخجل

119
00:10:09,790 --> 00:10:12,340
مجرّد خوض الامتحان مدفعة للفخر

120
00:10:12,340 --> 00:10:15,670
نسبة الفشل في اليوم الأوّل
%تعادل 95

121
00:10:15,670 --> 00:10:17,460
بل 99.4

122
00:10:19,020 --> 00:10:20,590
لمَ فشلتِ؟

123
00:10:21,270 --> 00:10:23,420
مثل البقيّة

124
00:10:23,950 --> 00:10:25,450
حدسي

125
00:10:26,700 --> 00:10:28,840
أبلغتِ الرئيس إذاً

126
00:10:28,840 --> 00:10:30,180
ثمّ ماذا حدث؟

127
00:10:31,330 --> 00:10:33,130
أبعدني من التحقيق

128
00:10:34,870 --> 00:10:38,910
نشر الرئيس كافة قوّات الشرطة
لتفتيش المدينة وإيجاد اللوتس السوداء

129
00:10:40,080 --> 00:10:41,640
!توقّف مكانك

130
00:10:44,350 --> 00:10:45,670
!يكفي مقاومة

131
00:10:47,110 --> 00:10:49,570
فتاة، بوشم لوتس سوداء، هل رأيتها؟

132
00:10:53,860 --> 00:10:55,540
لكن لم يجدوا أثراً لها

133
00:10:56,840 --> 00:10:59,400
كانت الليلة التي قُتل فيها الرئيس غرانت

134
00:11:00,430 --> 00:11:02,070
وكنتِ في المسرح

135
00:11:03,880 --> 00:11:05,460
وصلت بعد ذلك بلحظات

136
00:11:05,460 --> 00:11:08,100
رغم أنّكِ قلتِ بنفسك أنّك
اُستبعدتِ من القضيّة

137
00:11:08,650 --> 00:11:10,060
كنتِ غاضبةً منه

138
00:11:10,360 --> 00:11:12,530
كان تحقيقي

139
00:11:12,530 --> 00:11:15,890
أجريت التحرّيات، تعرّفت على المشتبه بها

140
00:11:15,890 --> 00:11:17,780
،قمتُ بكلّ شيءٍ بشكلٍ سليم

141
00:11:18,400 --> 00:11:20,030
فلمَ يُشتبه بي؟

142
00:11:23,670 --> 00:11:26,690
أينما تظهر اللوتس السوداء، تكونين موجودة

143
00:11:26,920 --> 00:11:29,110
لا تبدو كمصادفة لي

144
00:11:30,370 --> 00:11:34,330
أظنّكِ متورّطة في مقتل الرئيس بشكلٍ ما

145
00:11:34,330 --> 00:11:36,710
،بداية سيرتك المهنيّة واعدة

146
00:11:37,360 --> 00:11:39,650
لكن هنالك آلاف الطرق لإنهائها

147
00:11:40,770 --> 00:11:42,500
ما الذي تريده منّي؟

148
00:11:42,790 --> 00:11:44,490
حقيقة ما تعرفينه

149
00:11:45,610 --> 00:11:48,130
،وإذا لم تنل إجاباتك إعجابي

150
00:11:48,130 --> 00:11:50,270
أو اكتشفت كذبك، فلن أرفق بك

151
00:11:50,650 --> 00:11:54,040
أتنوي تهديدي؟ لم أقترف شيئاً

152
00:11:54,600 --> 00:11:57,100
أنا من يحكم بذلك

153
00:12:04,710 --> 00:12:05,920
أخبريني

154
00:12:06,850 --> 00:12:09,420
بكلّ ما حدث في تلك الليلة

155
00:12:10,890 --> 00:12:13,920
تولّى الرئيس زمام تحقيق اللوتس السوداء

156
00:12:14,410 --> 00:12:16,370
بدا ذلك مثيراً للريبة بالنسبة لي

157
00:12:19,940 --> 00:12:23,340
وفوق ذلك، رأيته يخرج متعجّلاً

158
00:12:23,830 --> 00:12:26,100
بينما يُفترض أنّنا مشغولون بالتحقيق

159
00:12:33,290 --> 00:12:34,600
!عذراً، سيّدي الرئيس

160
00:12:35,010 --> 00:12:38,510
بدا لي سلوك الرئيس غريباً بوضوح

161
00:12:38,510 --> 00:12:41,240
فتبعته إلى منزله

162
00:12:47,650 --> 00:12:48,540
!مكانك

163
00:12:48,770 --> 00:12:52,840
ثمّ التقيتُها وجهاً لوجه أخيراً

164
00:12:53,930 --> 00:12:55,540
اللوتس السوداء

165
00:12:57,200 --> 00:12:59,850
ارمي سيفك فوراً

166
00:13:21,640 --> 00:13:23,680
!الشرطة! ارم سلاحك

167
00:13:24,580 --> 00:13:27,300
أنا عدّاء نصل، سأتولّى أمرها

168
00:13:30,270 --> 00:13:32,260
،قبيل قتله

169
00:13:32,260 --> 00:13:34,600
أظهرت السجّلات أنّ الرئيس
قد استدعى عدّاء نصل

170
00:13:45,390 --> 00:13:49,720
يستحيل أن استطاعت مقلّدة عاديّة
الصمود أمام عدّاء نصل

171
00:14:01,280 --> 00:14:05,240
لكنّ اللوتس السوداء ليست مقلّدةً عاديّة

172
00:14:27,710 --> 00:14:30,980
شهدتُ ذلك بأمّ عيني

173
00:14:32,620 --> 00:14:36,100
،عندما أخبرت الرئيس أنّها كانت مقلّدة
أزاحني من منصبي

174
00:14:38,140 --> 00:14:39,320
!كلا

175
00:14:49,850 --> 00:14:52,670
ثمّ قام باستدعاء عدّاء نصل؟

176
00:14:53,260 --> 00:14:55,480
،كذب الرئيس عليك

177
00:14:55,480 --> 00:14:57,480
أو كان يخفي شيئاً

178
00:14:58,160 --> 00:15:02,250
لكن لا يمكنني أن أسأله
حيال ذلك الآن

179
00:15:09,950 --> 00:15:11,800
لنقل أنّكِ مصيبة

180
00:15:12,170 --> 00:15:15,050
،عرف غرانت أنّها مقلّدة

181
00:15:15,650 --> 00:15:17,870
لمَ قد يخفي ذلك؟

182
00:15:19,660 --> 00:15:20,950
لا أدري

183
00:15:22,570 --> 00:15:28,060
تعلّم المقلّدين من طراز "نيكسس 8" النجاة
والعيش بالتواري عن الأنظار

184
00:15:28,700 --> 00:15:31,950
لكنّ اللوتس السوداء تتحرّك وتثير جلبة

185
00:15:31,950 --> 00:15:33,810
ولم تخش عدّاء نصل

186
00:15:39,610 --> 00:15:40,760
...لكن ماذا

187
00:15:41,970 --> 00:15:45,450
لو كان أحدهم يصنع نماذج جديدة؟

188
00:15:47,770 --> 00:15:50,000
كدتِ تتمكّنين منّي

189
00:15:48,720 --> 00:15:50,000
دعني أنهِ كلامي

190
00:15:50,000 --> 00:15:50,660
كلا

191
00:15:50,660 --> 00:15:53,390
كان هذا مسليّاً، لكن لا دليل لديك

192
00:15:55,470 --> 00:15:59,150
يوجد، ما أخبرتنه به اللوتس السوداء

193
00:15:59,770 --> 00:16:01,490
ما الذي قالته؟

194
00:16:04,370 --> 00:16:07,380
اكتفيتُ من اصطيادي كحيوان

195
00:16:10,550 --> 00:16:13,840
إذا لم تريدي أن تُصطادي، فربما
عليكِ ألّا تقتلي الناس

196
00:16:19,200 --> 00:16:21,120
لم أكن من بدأت

197
00:16:22,400 --> 00:16:24,270
ما الذي تتكلّمين عنه؟

198
00:16:25,660 --> 00:16:27,790
لم تكن جرائم قتل عشوائيّة

199
00:16:27,790 --> 00:16:30,240
استهدفت الضحايا لسبب

200
00:16:30,720 --> 00:16:34,040
وبناءً على نبرة صوتها، فقد بدا الأمر شخصيّاً

201
00:16:37,080 --> 00:16:40,010
راجعتُ القضيّة بأسرها من البداية

202
00:16:40,970 --> 00:16:44,330
وبدأتُ بصديق السيناتور، الصحفيّ هوبر

203
00:16:44,330 --> 00:16:47,790
كان قد استأجر طيّارةً قبل اختفائه

204
00:16:48,270 --> 00:16:50,580
...لا أثر

205
00:16:50,870 --> 00:16:52,910
،تغيّرت مخطّطات الرحلة

206
00:16:52,910 --> 00:16:55,190
لكنّي وجدتُ إحداثيات سجلّ الرحلة

207
00:16:55,820 --> 00:16:59,250
وكانت وجهته صحراء نيفادا

208
00:16:59,920 --> 00:17:02,000
الصحراء محظورة الحدود

209
00:17:03,910 --> 00:17:05,960
ليس إن كنت تمتلك صلات

210
00:17:05,960 --> 00:17:11,500
أخذ الرئيس غرانت وزوجته عطلةً
في نفس اليوم مع هوبر

211
00:17:12,190 --> 00:17:15,390
لا بدّ أنّ السيناتور بانيستر
قام بالأمر نفسه

212
00:17:15,790 --> 00:17:16,830
فهمت

213
00:17:19,350 --> 00:17:23,920
إذا كنتِ تعرفين أين تبحثين، فقد أستطيع
مساعدتك في إيجاد إجابات

214
00:18:04,730 --> 00:18:07,190
ما الذي حدث هنا؟

215
00:18:46,000 --> 00:18:48,090
طلبتُ فرقة تحقيق

216
00:18:48,090 --> 00:18:49,350
سيستخرجون الجثث

217
00:18:49,350 --> 00:18:50,670
ويحاولون التحقّق من هويّاتها

218
00:18:57,800 --> 00:19:00,590
لن أستغرب وجود هوبر بينهم

219
00:19:02,330 --> 00:19:05,540
لم يعد الموضوع متمحوراً حول
إيجاد مقلّدة قاتلة

220
00:19:06,630 --> 00:19:08,370
هل تصدّقني الآن؟

221
00:19:13,240 --> 00:19:15,480
اكتشافكِ كبير يا ديفيس

222
00:19:15,980 --> 00:19:17,970
سأبلغ رؤسائي به

223
00:19:19,370 --> 00:19:21,510
ستتغيّر مسيرتك المهنيّة بشكلٍ كبير

224
00:20:08,510 --> 00:20:09,950
ضابطة ديفيس

225
00:20:10,480 --> 00:20:14,210
بناءً على توصيات التحقيق، فقد تمّ تشخيص
امتلاكك لنزعات أوهام

226
00:20:14,210 --> 00:20:19,070
تؤثر على عملك كضابطة في الشرطة

227
00:20:19,640 --> 00:20:24,280
من هذه اللحظة، ستغادرين في عطلة
لا تقلّ عن 3 أشهر

228
00:20:24,280 --> 00:20:29,150
ارجعي لمنزلك وتعاملي مع حالتك

229
00:20:44,470 --> 00:20:49,020
إشاعات بإتاحة الحقوق الفكريّة
المملوكة لشركة تايرل

230
00:20:49,020 --> 00:20:54,320
مقابل مبلغ غير معلن عنه لشركة والاس

231
00:20:57,430 --> 00:21:01,020
أثق بسارقٍ صامت

232
00:21:01,020 --> 00:21:04,380
أكثر من ثقتي بقدومك عبر بابي

233
00:21:12,540 --> 00:21:14,250
كلّ شيءٍ متّصل

234
00:21:13,490 --> 00:21:16,740
أصغي لغريزتي فحسب

235
00:21:16,740 --> 00:21:19,780
إنّها الوحيدة التي تخبرني بالحقيقة

236
00:21:19,330 --> 00:21:22,070
سأجد اللوتس السوداء حتماً

237
00:21:21,580 --> 00:21:24,900
أصغي لغريزتي فحسب

238
00:21:24,900 --> 00:21:27,890
وتخبرني أنّك لا تروقها

239
