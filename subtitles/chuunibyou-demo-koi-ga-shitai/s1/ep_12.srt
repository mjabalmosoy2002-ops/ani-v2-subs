276
00:16:16,760 --> 00:16:19,410
!لا، أيتها العين المستبدة

277
00:16:19,950 --> 00:16:22,160
.هناك أمرٌ يجب أن تشاهديه

278
00:16:22,630 --> 00:16:23,670
...يووتا

279
00:16:34,370 --> 00:16:35,400
...ارتبطي

280
00:16:36,820 --> 00:16:38,680
!بعقدٍ معي

281
00:16:40,060 --> 00:16:40,970
من هناك !؟

282
00:16:40,970 --> 00:16:42,100
لص !؟

283
00:16:42,100 --> 00:16:43,730
ماذا تفعل !؟

284
00:16:43,730 --> 00:16:44,840
!اللعنة

285
00:16:44,150 --> 00:16:45,600
!أيتها الجدة، البندقية

286
00:16:45,600 --> 00:16:46,400
!أحضري بندقيتي

287
00:16:46,400 --> 00:16:47,540
!ريكا! تعالي

288
00:16:48,170 --> 00:16:48,770
...لكن

289
00:16:48,770 --> 00:16:50,820
أترغبين في البقاء بهذا الواقع المضجر !؟

290
00:16:50,820 --> 00:16:54,700
أو ترغبين في القدوم معي وتغيّر هذا الواقع !؟

291
00:16:58,250 --> 00:16:59,260
!يووتا

292
00:17:01,370 --> 00:17:02,260
!أيتها الجدة

293
00:17:02,260 --> 00:17:03,250
!ريكا

294
00:17:04,330 --> 00:17:05,170
!يووتا

295
00:17:05,170 --> 00:17:06,040
!ريكا

296
00:17:12,650 --> 00:17:14,010
!ريكا

297
00:17:19,610 --> 00:17:20,640
!رويدكما

298
00:17:20,640 --> 00:17:21,970
ماذا تفعلان ؟

299
00:17:21,970 --> 00:17:23,160
!هناك سوء فهم

300
00:17:23,160 --> 00:17:24,940
!إنه يحاول الاعتداء عليّ

301
00:17:28,030 --> 00:17:30,700
!هيّا، مثّل دورك! أنت المجرم

302
00:17:31,610 --> 00:17:32,570
أنا !؟

303
00:17:33,050 --> 00:17:35,740
!دعيني ألمسك

304
00:17:36,830 --> 00:17:39,040
!مكانك، لا تتحرّك

305
00:17:39,040 --> 00:17:40,030
!انتظر

306
00:17:40,030 --> 00:17:41,960
!هناك سببٌ لهذا

307
00:17:41,960 --> 00:17:43,180
لماذا هم هنا ؟

308
00:17:43,180 --> 00:17:44,750
!هيّا! أسرعا

309
00:17:45,190 --> 00:17:46,390
أنتن أيضًا !؟

310
00:17:46,390 --> 00:17:49,790
!عائلة ديكو - تشان أقرضتنا السيارة

311
00:17:50,170 --> 00:17:51,000
.تفضلي

312
00:17:55,250 --> 00:17:56,010
!انتظرا

313
00:18:01,310 --> 00:18:03,600
!رجلي متشنجة

314
00:18:03,600 --> 00:18:04,470
هل أحلُ محلك ؟

315
00:18:04,890 --> 00:18:06,680
.لا تقلقي

316
00:18:06,680 --> 00:18:08,960
،مع وجود قوة دارك فليم ماستر

317
00:18:09,990 --> 00:18:11,060
!هذا لا يعدُ شيئًا

318
00:18:18,390 --> 00:18:19,560
...الأضواء

319
00:18:20,030 --> 00:18:21,410
أوليست جميلة ؟

320
00:18:24,310 --> 00:18:26,290
.لكنها أضواء السفن فحسب

321
00:18:26,990 --> 00:18:29,290
.مجرد أضواء

322
00:18:32,170 --> 00:18:33,000
.انزلي

323
00:18:38,080 --> 00:18:39,780
.هذه هي قوة الظلمات

324
00:18:43,790 --> 00:18:45,390
.الفضاء اللحظي، انشطار

325
00:18:45,870 --> 00:18:47,420
.سنابز، تلاشي

326
00:18:49,430 --> 00:18:50,940
