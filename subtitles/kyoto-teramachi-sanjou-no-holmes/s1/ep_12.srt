1
00:00:02,320 --> 00:00:03,290
.إنه مارس

2
00:00:03,810 --> 00:00:08,480
.سيكتمل عام قريبًا على مجيئي لكورا

3
00:00:09,000 --> 00:00:12,740
دُعينا من قِبل والد ريكيو-كن
،الذي يعيش في طوكيو

4
00:00:13,270 --> 00:00:15,240
،كيريشيما ساكيو-سان

5
00:00:15,590 --> 00:00:19,370
لزيارة ممتلكات جدّ ريكيو-كن
التي تقع في إحدى المناطق السكنية

6
00:00:19,770 --> 00:00:22,720
الأكثر رُقيّ في كيوتو، تاكاغاميني

7
00:00:23,590 --> 00:00:26,760
،ساكيو-سان ويوشي-سان مُطلّقان

8
00:00:26,760 --> 00:00:28,740
،وسمعتُ أنّه كان زوجًا سيئًا

9
00:00:28,740 --> 00:00:31,200
.لكنّه يبدو مضحكًا وفاتنًا في الواقع

10
00:00:31,200 --> 00:00:34,060
.كيوتاكا-كن، آوي-سان

11
00:00:34,060 --> 00:00:36,140
.شكرًا على قدومكما اليوم

12
00:00:36,610 --> 00:00:37,730
.لا عليك

13
00:00:37,730 --> 00:00:40,890
كيف هو جدّ ريكيو-كن؟

14
00:00:41,150 --> 00:00:46,320
،لا أراه غالبًا أيضًا
...لكنّ عائلة سايتو فاحشة الثراء

15
00:00:46,320 --> 00:00:50,150
.قصرهم مليء بالقطع الفنية الباهظة وما جاور ذلك

16
00:00:50,360 --> 00:00:55,910
وهل تمّ استدعاء ساكيو-سان وجميع إخوته إلى هناك؟

17
00:00:56,150 --> 00:00:58,320
،ذُكِر في دعوة أبي

18
00:00:58,320 --> 00:01:04,660
،من لا يؤمن بعينيه"
".فليحضر مثمّنًا معه

19
00:01:05,150 --> 00:01:11,110
،أشاد ريكيو به
.لذا قرّرتُ أن أسأل كيوتاكا-كن أوّلًا

20
00:01:11,110 --> 00:01:12,920
.آسف يا كيو-ني

21
00:01:13,200 --> 00:01:14,680
.لا عليك

22
00:01:14,680 --> 00:01:16,840
.إنّه طلب كمثمّن في النهاية

23
00:01:16,840 --> 00:01:18,930
.ذلك يسرّني جدًّا

24
00:01:19,210 --> 00:01:20,680
...فهمت

25
00:01:20,680 --> 00:01:24,470
.وبالطبع، لم تحتج آوي-سان أن تأتي بدورها

26
00:01:25,290 --> 00:01:27,190
.أمكنك أن تدعها تعتني بالمحل

27
00:01:27,670 --> 00:01:31,400
...يبدو الأمر كأمرٍ عائليّ بالفعل

28
00:01:32,090 --> 00:01:36,560
.ستساعدك رؤية الأشياء الجميلة على شحذ عينيك

29
00:01:36,560 --> 00:01:39,950
واثق أنّها ستكون تجربةً تعليميّةً
.جيّدة لأجلك يا آوي-سان

30
00:01:40,500 --> 00:01:41,780
أشياء جميلة؟

31
00:01:42,980 --> 00:01:44,000
ماذا؟

32
00:01:45,040 --> 00:01:46,710
!لـ-لا شيء

33
00:01:47,520 --> 00:01:49,500
!سأبذل قصارى جهدي

34
00:02:01,550 --> 00:02:02,780
.من هنا رجاءً

35
00:02:07,480 --> 00:02:09,230
.تسوكاسا، كازوهيكو

36
00:02:09,500 --> 00:02:10,940
مضى وقتٌ طويل، صحيح؟

37
00:02:10,940 --> 00:02:12,900
.مرحبًا يا أخي الكبير

38
00:02:12,900 --> 00:02:14,480
.مضى وقت طويل

39
00:02:14,820 --> 00:02:16,890
،سمعتُ أنّهم إخوة

40
00:02:16,890 --> 00:02:19,350
...لكنّ لا يبدو هنالك شبه بين ثلاثتهم

41
00:02:19,840 --> 00:02:22,230
لا يوجد شبه بينهم حقًّا، أليس كذلك؟

42
00:02:22,880 --> 00:02:23,990
!هولمز-سان

43
00:02:24,320 --> 00:02:26,520
.لا يمكننا إخفاء الأمر حقًّا

44
00:02:26,520 --> 00:02:29,010
.جميعهم يملكون أُمًّا مختلفة

45
00:02:29,860 --> 00:02:31,440
.فهمت

46
00:02:31,440 --> 00:02:34,720
...أفترض أنّ لذلك الأمر علاقة بهذا الاجتماع اليوم

47
00:02:35,460 --> 00:02:37,620
!إنّه كيوتاكا شخصيًّا

48
00:02:38,220 --> 00:02:41,610
.كييكو-سان! مضى وقت طويل

49
00:02:41,610 --> 00:02:43,700
هل عدت إلى اليابان؟

50
00:02:43,700 --> 00:02:46,880
!أجل، وأنا سعيدة جدًّا لرؤيتك

51
00:02:54,220 --> 00:02:58,300
.آوي-سان، أُقدّم لكِ فوجيوارا كييكو-سان

52
00:02:58,300 --> 00:03:01,760
.إنّها أمينة متحف فنيّ في نيويورك

53
00:03:01,760 --> 00:03:03,030
أمينة؟

54
00:03:03,490 --> 00:03:06,290
.أشبه بمديرة المتحف

55
00:03:06,530 --> 00:03:11,580
فهمت. هذه المثمّنة التي أحضرت إذًا يا كازوهيكو؟

56
00:03:11,580 --> 00:03:12,920
ماذا عنك يا تسوكاسا؟

57
00:03:13,130 --> 00:03:15,400
.لقد تأخر قليلًا

58
00:03:15,400 --> 00:03:19,420
.لكنّي طلبتُ خبيرًا لا يقلّ شأنًا عن مثمّن

59
00:03:19,880 --> 00:03:22,480
خبير لا يقلّ شأنًا عن مثمّن؟

60
00:03:22,480 --> 00:03:24,320
...أتساءل من قد يكون

61
00:03:24,320 --> 00:03:25,430
ماذا؟

62
00:03:25,670 --> 00:03:26,920
!انظر إلى هذه

63
00:03:26,920 --> 00:03:28,460
ماذا هناك؟

64
00:03:31,680 --> 00:03:34,280
!شارة ويستيريا المعلّقة

65
00:03:34,280 --> 00:03:37,440
.أظنّ أنّها موجودة غالبًا في عائلتيْ فوجيوارا وسايتو

66
00:03:37,800 --> 00:03:41,200
.مبهر كما العادة
!شارة عائلتي هي نفسها

67
00:03:44,960 --> 00:03:45,810
.أبي

68
00:03:46,580 --> 00:03:50,740
.ساكيو، تسوكاسا، كازوهيكو، ريكيو

69
00:03:51,360 --> 00:03:53,210
.شكرًا على مجيئكم جميعًا

70
00:03:53,480 --> 00:03:54,850
.سعيد لمقابلتكم جميعًا أيضًا

71
00:03:54,850 --> 00:03:58,710
.أنا ربّ عائلة سايتو، سايتو أوكون

72
00:03:58,900 --> 00:04:00,870
...أيها المثمنان

73
00:04:02,520 --> 00:04:05,020
ماذا تفعلين هنا يا آنسة؟

74
00:04:05,500 --> 00:04:07,470
...في الواقع

75
00:04:07,690 --> 00:04:11,730
.أنا من دعوتها يا أبي

76
00:04:13,390 --> 00:04:17,330
الأشخاص الوحيدون الذين أريد
.رؤيتهم الآن هم أبنائي والمثمنّين

77
00:04:17,330 --> 00:04:19,370
.آسف يا آنسة

78
00:04:19,890 --> 00:04:22,240
.لا أعتقد أنّ لديك مكانًا هنا

79
00:04:23,980 --> 00:04:25,360
.سعيد لمقابلتك

80
00:04:25,360 --> 00:04:27,490
.أنا ياغاشيرا كيوتاكا

81
00:04:27,720 --> 00:04:30,560
...لا بدّ أنّك حفيد سيجي-سان

82
00:04:30,560 --> 00:04:34,040
.هذه ماشيرو آوي-سان، عضوة بطاقمي

83
00:04:34,040 --> 00:04:37,280
.وهي مثمّنة مبتدئة مثلي

84
00:04:37,280 --> 00:04:38,380
!تذكرت

85
00:04:38,790 --> 00:04:43,510
.إنّها الفائزة بمسابقة التثمين في حفل ياناغيهارا-سينسي

86
00:04:43,720 --> 00:04:46,260
!شاركتُ فيها أيضًا

87
00:04:47,760 --> 00:04:51,520
.أوكون-سان، تملك آوي-سان عينًا دقيقةً جدًّا

88
00:04:51,760 --> 00:04:55,770
.سيكون من الخاطئ القول أنّها لا تملك مكانًا هنا

89
00:04:56,200 --> 00:04:57,470
...هولمز-سان

90
00:05:01,280 --> 00:05:03,030
...إذًا يا آوي-سان

91
00:05:03,360 --> 00:05:06,340
.لنختبرك

92
00:05:12,840 --> 00:05:14,220
.المعذرة

93
00:05:16,250 --> 00:05:17,540
...هذه

94
00:05:19,790 --> 00:05:22,800
.زلابيات شاي راكو... مذهل

95
00:05:23,050 --> 00:05:28,850
واثق أنّك تعلمين أنّ هناك
.العديد من صانعي زلابيات راكو

96
00:05:28,850 --> 00:05:29,550
.أجل

97
00:05:29,850 --> 00:05:35,310
.إذًا، أخبريني من صنع كلًّا من هذه الزلابيات

98
00:05:35,580 --> 00:05:40,060
ربّما صنعت بعضها من قِبل
.أشخاص خارجين عن عائلة راكو

99
00:05:40,400 --> 00:05:41,580
.لا بأس

100
00:05:42,410 --> 00:05:44,620
.إن كانت سلعة راكو، بوسعي التعامل معها

101
00:05:50,410 --> 00:05:52,900
.حسنًا، سوف أبدأ

102
00:05:54,480 --> 00:05:59,020
أظنّ أنّ هاتين من الوريث
.التاسع لعائلة راكو، ريوني

103
00:05:59,900 --> 00:06:02,480
.وهذه من الوريث الرابع، إتشينيو

104
00:06:02,480 --> 00:06:04,440
.وهذه من الوريث الرابع عشر، كاكونيو

105
00:06:05,260 --> 00:06:08,380
.وهذه من الوريث الخامس عشر، كيتشيزايمون

106
00:06:09,690 --> 00:06:11,970
...والأخيرة

107
00:06:12,370 --> 00:06:17,230
مصنوعة من قبل الرّجل الذي لا يزال يُعرف
.بأعظم صانع فن، الوريث الثالث، دونيو

108
00:06:18,950 --> 00:06:21,230
...لا

109
00:06:21,820 --> 00:06:24,360
.آسفة، دعني أُعدّل إجابتي

110
00:06:25,380 --> 00:06:29,110
أهي... هونامي كويتسو؟

111
00:06:31,620 --> 00:06:34,590
هل... أخطأت؟

112
00:06:35,170 --> 00:06:37,620
...آسفة. سأتجهّز للمغادرة

113
00:06:39,050 --> 00:06:40,620
!مذهل

114
00:06:42,360 --> 00:06:45,710
.آوي-سان، اعذريني على فظاظتي السابقة

115
00:06:45,710 --> 00:06:47,880
.أنا آسف جدًّا

116
00:06:48,480 --> 00:06:50,630
!أنت رائعة حقًّا

117
00:06:50,880 --> 00:06:52,460
...لا

118
00:06:52,990 --> 00:06:55,420
،علّمني هولمز-سان كلّ ذلك

119
00:06:55,420 --> 00:06:57,640
...وكدتُ أخطئ في الأخيرة

120
00:06:58,390 --> 00:07:00,090
.لا يا آوي-سان

121
00:07:01,220 --> 00:07:04,770
قيل أنّ الوريث الثالث دونيو
عمل بالقرب من كويتسو

122
00:07:04,770 --> 00:07:07,400
.وتأثّر به إلى حدّ كبير

123
00:07:07,920 --> 00:07:09,850
حقيقة أنّك أخطأتها مع عمل دونيو

124
00:07:09,850 --> 00:07:11,800
ثمّ أدركتِ فورًا أنّها من عمل كويتسو

125
00:07:11,800 --> 00:07:13,540
.تُشيد بك حقًّا

126
00:07:13,540 --> 00:07:15,350
حقًّا؟

127
00:07:15,350 --> 00:07:18,420
.يا إلهي، إنها عظيمة

128
00:07:19,690 --> 00:07:21,420
.قد تصبح منافستك قريبًا يا كييكو-سان

129
00:07:22,880 --> 00:07:27,300
.على أيّ حال، أريد أن أعاملك كمثمّنة ملائمة

130
00:07:27,560 --> 00:07:29,930
ما رأيك أن تتعاوني مع ريكيو؟

131
00:07:29,930 --> 00:07:31,240
معي؟

132
00:07:31,240 --> 00:07:32,550
نتعاون؟

133
00:07:34,840 --> 00:07:38,010
...تسوكاسا، يبدو أنّ شريكك لم يأت بعد

134
00:07:38,010 --> 00:07:40,560
.أعتذر على وصولي المتأخر

135
00:07:43,810 --> 00:07:46,320
.دعاني تسوكاسا-سان

136
00:07:46,320 --> 00:07:48,570
.اسمي تاناكا هيروشي

137
00:07:48,830 --> 00:07:50,120
تاناكا؟

138
00:07:52,340 --> 00:07:55,570
لقد تأخرت يا تاناكا. ماذا كنت تفعل؟

139
00:07:56,000 --> 00:07:59,580
في الواقع، كانت لديكم تسلية جيدة هنا

140
00:08:00,080 --> 00:08:03,250
.لذا قررتُ أن أشاهد من الخارج

141
00:08:04,120 --> 00:08:08,780
.يبدو أنّ الآنسة الصغيرة تملك عينًا دقيقة

142
00:08:11,640 --> 00:08:14,720
.لا نملك متّسعًا من الوقت، لذا سأبادر

143
00:08:15,000 --> 00:08:18,010
:أحضرتكم جميعًا إلى هنا لسببٍ واحد

144
00:08:18,010 --> 00:08:20,720
.لأجل تحديد خلفٍ لعائلة سايتو

145
00:08:23,200 --> 00:08:25,730
،توفّيت زوجتي في سنّ مبكّر

146
00:08:26,070 --> 00:08:29,230
،لذا لأجل أن أمنع محارب عائلة سايتو من الموت

147
00:08:29,920 --> 00:08:33,050
أنبجتُ ثلاثتكم من أمّ مختلفة

148
00:08:33,050 --> 00:08:34,550
.وتركتهنّ يربّينكم

149
00:08:35,640 --> 00:08:38,640
،لكن لكلّ منكم مزاياه وعيوبه

150
00:08:38,640 --> 00:08:41,370
.لذا لا أعلم كيف أختار خلفًا لائقًا

151
00:08:41,630 --> 00:08:45,010
،لهذا، بدلًا من الاختيار على أساس ملائمة عائلة سايتو

152
00:08:45,010 --> 00:08:49,380
.قرّرت أن أختار الوريث الذي يفهم عائلة سايتو أكثر

153
00:08:49,830 --> 00:08:52,630
.ثمّة الكثير من الكنوز في هذا القصر

154
00:08:53,050 --> 00:08:59,140
والشخص الذي يُحدّد أيّهما الأعظم
.لعائلة سايتو سيصبح خلفي

155
00:08:59,340 --> 00:09:03,360
وبالنسبة للمثمّنين، لا تخبروهم
.أكثر ممّا هم بحاجةٍ لمعرفته

156
00:09:03,360 --> 00:09:07,150
.الأمر متروك لأبنائي للعثور على إجاباتهم الخاصة

157
00:09:07,450 --> 00:09:09,900
.هذه شروطي

158
00:09:10,220 --> 00:09:13,150
.أريد أن أسمع إجاباتكم على السّابعة مساءً

159
00:09:13,390 --> 00:09:15,530
!ابدؤوا الآن

160
00:09:17,800 --> 00:09:21,410
.في ذلك العصر، أخذنا نتجوّل ونثمّن كنوز عائلة سايتو

161
00:09:21,720 --> 00:09:23,180
،في الغرفة التقليدية في الطابق الأول

162
00:09:23,180 --> 00:09:26,670
رأيتُ لوحة مرسومة بالحبر القويّ
.لأشجار الصنوبر على شاشة منزلقة

163
00:09:27,020 --> 00:09:32,050
،بدا هولمز-سان مهتمًّا بها
.لكنّها لم تكن ممضيّة على ما يبدو

164
00:09:33,270 --> 00:09:36,090
.كانت هنالك ستارات مطويّة ومزهريات رائعة أيضًا

165
00:09:41,440 --> 00:09:45,430
ثمّ مررنا بمرآة كبيرة على مفترق الدرج

166
00:09:45,430 --> 00:09:47,190
في طريقنا إلى قاعة الطبق الثاني

167
00:09:47,190 --> 00:09:50,400
:حيث شاهدنا الأشياء المفترض كونها الأغلى في القصر

168
00:09:50,400 --> 00:09:52,960
،زهرية مُزخرفة لسلالة تشينغ الحاكمة

169
00:09:53,780 --> 00:09:56,570
،سيف بيزين أوسافوني تشيكاكاغي

170
00:09:57,000 --> 00:09:59,080
وزهرية جوسيون خزفية بيضاء

171
00:09:59,080 --> 00:10:00,850
.التي اهتمّ بها إينشو على الفور

172
00:10:02,320 --> 00:10:06,260
.هذه الأدوات فاقت بقوّة كلّ شيء آخر في القصر

173
00:10:11,790 --> 00:10:16,770
واثقة أنّ الجميع يُفكّرون أنّ إحدى قطع
...هذه القاعة هي أعظم كنزٍ لعائلة سايتو

174
00:10:18,730 --> 00:10:21,160
.هذا صعب حقًّا

175
00:10:21,160 --> 00:10:23,060
آوي-سان، صحيح؟

176
00:10:23,710 --> 00:10:25,030
.لا بدّ أنّك متعبة

177
00:10:25,720 --> 00:10:27,480
أيمكنني أن أجلس بجانبك؟

178
00:10:27,740 --> 00:10:28,780
.تفضلي

179
00:10:32,300 --> 00:10:35,340
.عينك المُثمّنة فاجأتني بحق

180
00:10:35,340 --> 00:10:37,360
.من الرائع أن تملكي هذه الموهبة في سنٍّ صغير

181
00:10:37,360 --> 00:10:41,990
...لا. فقط لأنّ هولمز-سان كان يُعلّمني

182
00:10:42,250 --> 00:10:44,990
ماذا؟ كيوتاكا؟

183
00:10:45,920 --> 00:10:48,520
هل أنتما مقرّبان؟

184
00:10:51,040 --> 00:10:53,000
.نحن نعرف بعضنا منذ عدّة سنين

185
00:10:53,550 --> 00:10:56,510
،التقينا أوّل مرّة عندما أتى سيجي-سان إلى نيويورك

186
00:10:56,510 --> 00:10:58,360
.وأصبحنا صديقين على الفور

187
00:10:58,360 --> 00:11:00,130
!حتّى أنّه أتى ليمضي الليلة معي

188
00:11:01,340 --> 00:11:03,010
يـ-يمضي اللّيلة؟

189
00:11:03,220 --> 00:11:05,920
...أجل. يا لكيوتاكا السخيف

190
00:11:05,920 --> 00:11:09,020
،لقد كان في منزلي الوقت كلّه
.بالكاد نِمنا

191
00:11:09,020 --> 00:11:13,910
!آ-آسفة. من الأفضل لي أن أرجع إلى ريكيو-كن

192
00:11:20,290 --> 00:11:22,220
لمَ أخبرتني بذلك؟

193
00:11:22,220 --> 00:11:25,030
أتريدني أن أبتعد عن هولمز-سان؟

194
00:11:25,450 --> 00:11:27,360
...فهمت

195
00:11:27,360 --> 00:11:29,620
.لقد وضعتُ حدًّا بالفعل

196
00:11:29,620 --> 00:11:33,370
.وقلتُ أنّني لن أقع أكثر في حبّ هولمز-سان

197
00:11:33,370 --> 00:11:35,540
آوي-سان، هل أنت بخير؟

198
00:11:38,280 --> 00:11:40,860
.فكّرتُ أن أحاول تقليده

199
00:11:40,860 --> 00:11:42,800
هل فعلتُ ذلك جيدًا؟

200
00:11:45,150 --> 00:11:48,060
هل من خطبٍ ما يا آوي-سان؟

201
00:11:48,060 --> 00:11:50,220
!ا-ابتعد عنّي

202
00:11:51,790 --> 00:11:55,320
بالمناسبة، أنت امرأة هولمز-هان، أليس كذلك؟

203
00:11:56,200 --> 00:11:58,940
...ما فعلته في رأس السنة كان مضحكًا حقًّا

204
00:11:59,310 --> 00:12:03,500
،خلتُ أنّك ستدافعين عنه

205
00:12:03,500 --> 00:12:06,830
.لكنّك وبّختنا نحن الاثنان

206
00:12:07,230 --> 00:12:11,580
،يا لك من فتاة عديمة الميزة
...تساءلت لمَ يرغب بك

207
00:12:11,580 --> 00:12:13,320
.لكنّك لستِ سيّئة إطلاقًا

208
00:12:13,320 --> 00:12:15,060
!أ-أسأت الفهم

209
00:12:15,060 --> 00:12:16,840
...لم نفعل أيّ شيء

210
00:12:17,870 --> 00:12:19,160
ما هذا الآن؟

211
00:12:19,160 --> 00:12:20,840
أما زلت عذراء؟

212
00:12:21,110 --> 00:12:22,650
مـ-ماذا؟

213
00:12:22,650 --> 00:12:27,390
إن لم يضع ذلك الرّجل
،المستفحل الشره يده عليك بعد

214
00:12:27,390 --> 00:12:30,100
.لا بدّ أنّه يُثمّنك حقًّا

215
00:12:30,610 --> 00:12:33,390
...أو ربّما تُقدّرين نفسك أكثر من اللازم

216
00:12:33,390 --> 00:12:35,100
.سيتخلّص منك قريبًا

217
00:12:43,920 --> 00:12:46,110
...تدعو نفسك تاناكا

218
00:12:46,110 --> 00:12:47,560
.أخفتي يا رجل

219
00:12:47,560 --> 00:12:49,740
.يا لك من شقيّ عنيف

220
00:12:50,750 --> 00:12:54,920
.قوّة فظاظتك الفظيعة جعلت رجلي تزلّ

221
00:12:54,920 --> 00:12:56,120
...هولمز-سان

222
00:12:56,340 --> 00:12:58,610
.يا لها من زلّة كبيرة

223
00:12:58,610 --> 00:13:02,130
.ويبدو أنّها تصبح أكثر قوّة بوجود تلك الفتاة

224
00:13:02,460 --> 00:13:04,990
.يبدو أنّك أخذت انطباعًا خاطئًا

225
00:13:04,990 --> 00:13:07,830
.أنا وآوي-سان لا نتواعد

226
00:13:07,830 --> 00:13:12,140
.لأنّه كما قلت، أنا رجلٌ مستفحل وشره

227
00:13:13,330 --> 00:13:15,890
.أجل، هذا منطقي تمامًا

228
00:13:16,310 --> 00:13:18,400
!تاناكا

229
00:13:18,400 --> 00:13:20,400
!لا تتجوّل من دوني

230
00:13:20,400 --> 00:13:24,150
،لقد دفعتُ لك بسخاء لأجل هذا
!لذا قم بعملك اللعين

231
00:13:21,060 --> 00:13:24,150
.يبدو أنّه تمّ استدعائي

232
00:13:26,280 --> 00:13:28,480
آوي-سان، هل أنت بخير؟

233
00:13:28,480 --> 00:13:30,860
هل فعل بك أيّ شيء؟

234
00:13:30,860 --> 00:13:32,540
...أ-أنا بخير

235
00:13:32,540 --> 00:13:34,990
.تفوّه ببعض الكلام الفظ، هذا كلّ شيء

236
00:13:36,640 --> 00:13:40,170
.خُبث ذلك الرّجل ليس له حدّ

237
00:13:40,920 --> 00:13:44,670
.لكنّه محقّ... في ما قاله

238
00:13:45,080 --> 00:13:46,460
محق؟

239
00:13:47,190 --> 00:13:50,430
...في الحقيقة، قبل انتقالي إلى كيوتو

240
00:13:54,400 --> 00:14:00,390
ربّما هجرني حبيبي القديم
.لأنّي محتشمة أكثر من اللّزوم

241
00:14:02,320 --> 00:14:05,730
...لقد أحببته، لذا تساءلت دائمًا

242
00:14:05,730 --> 00:14:10,530
لمَ تصرّفت كذلك؟

243
00:14:10,530 --> 00:14:12,020
.أنت مخطئة

244
00:14:13,520 --> 00:14:15,830
.لم تفعلي أيّ شيء خاطئ

245
00:14:17,550 --> 00:14:19,710
.علاقات البشر كلّها متعلّقة بالقدر

246
00:14:20,340 --> 00:14:23,170
.لم يكن بوسعك فعل أيّ شيء بشأن ذلك

247
00:14:23,780 --> 00:14:27,730
.لذا رجاءً... لا تلومي نفسك أكثر

248
00:14:33,300 --> 00:14:34,390
...هولمز-سان

249
00:14:37,120 --> 00:14:40,480
...آسف. ما كان يجب أن أعانقك هكذا

250
00:14:40,680 --> 00:14:42,890
...لـ-لا، لا بأس

251
00:14:44,840 --> 00:14:47,040
.أنا آسف حقًّا

252
00:14:47,040 --> 00:14:51,080
،عندما يصبح المرء يائسًا
...يمكنه أن يقترف أشياءً فظيعة على ما أظن

253
00:14:51,080 --> 00:14:52,240
يائس؟

254
00:14:52,450 --> 00:14:56,750
...أنا... لم أردك أن تبكي، لذا

255
00:15:01,900 --> 00:15:05,000
.سأتلقّى إجاباتكم الآن

256
00:15:05,190 --> 00:15:08,760
.لقد انسحبت، لذا أعفي نفسي

257
00:15:10,450 --> 00:15:13,260
كازوهيكو، هل اخترت الزهرية المزخرفة؟

258
00:15:13,530 --> 00:15:18,020
.أجل. لأنّي ظننتُ أنّها القطعة الأغلى في المنزل

259
00:15:18,560 --> 00:15:20,770
وتسوكاسا، هل اخترت السيف؟

260
00:15:21,010 --> 00:15:22,000
.أجل

261
00:15:22,000 --> 00:15:26,020
.يُجدر بالسّيف أن يكون فخر محارب عائلة سايتو

262
00:15:28,030 --> 00:15:30,780
ساكيو، الورقة فارغة. لماذا؟

263
00:15:32,240 --> 00:15:36,280
.المرآة في مفترق الدرج
...عندما نظرتُ إليها، أدركت

264
00:15:36,280 --> 00:15:41,290
،ربّما نحن المنعكسون على تلك المرأة
.هم الكنز الأغلى في عائلة سايتو

265
00:15:47,630 --> 00:15:50,550
.أخبرتك أن تبحث عن أداة وليس شخص

266
00:15:50,760 --> 00:15:52,870
!ليس شيئًا سخيفًا هكذا

267
00:15:53,600 --> 00:15:54,960
حقًّا؟

268
00:15:54,960 --> 00:15:56,550
!أنا مُحرج حقًّا

269
00:15:57,000 --> 00:15:58,560
...أبي

270
00:15:58,840 --> 00:15:59,650
...في تلك الحال

271
00:15:59,650 --> 00:16:00,430
أهو أنا؟

272
00:16:00,430 --> 00:16:02,070
!كلاكما غير كُفء

273
00:16:02,070 --> 00:16:05,000
!رسبتم جميعًا في اختبار خلَفي

274
00:16:07,050 --> 00:16:08,420
...الإجابة الصحيحة

275
00:16:10,880 --> 00:16:12,070
هولمز-سان؟

276
00:16:13,160 --> 00:16:16,470
.يبدو أنّ كيوتاكا-كن يعرف الإجابة

277
00:16:16,470 --> 00:16:18,080
هلّا أنرتنا بها؟

278
00:16:18,770 --> 00:16:20,580
...بالتأكيد. إن سمحت

279
00:16:21,180 --> 00:16:25,580
.كنز عائلة سايتو هو ما يرمز إليه السّيف

280
00:16:26,210 --> 00:16:28,890
.الشارة على غمده عبارة عن زهرة الجرس

281
00:16:28,890 --> 00:16:32,560
إنها مختلفة عن شارة ويستيريا
.المعلّقة الخاصّة بعشيرة سايتو

282
00:16:32,560 --> 00:16:36,340
.بعبارة أخرى، كان ذلك السّيف هديّةً

283
00:16:36,880 --> 00:16:41,040
شارة زهرة الجرس مرتبطة بالجنرال
.الشّهير أكيتشي ميتسوهيدي

284
00:16:41,590 --> 00:16:46,350
فكّرتُ أنّ سايتو قد يكونوا
،من سلالة سايتو توشيميتسو

285
00:16:46,350 --> 00:16:49,360
.الحارس المهمّ والمتفاني لميتسوهيدي

286
00:16:50,200 --> 00:16:52,980
،حتّى ميتسوهيدي، الذي اعتبره التّاريخ خائنًا

287
00:16:52,980 --> 00:16:55,330
.كان ربًّا مهمًّا لهذه العائلة

288
00:16:55,990 --> 00:16:57,890
يُجسّد ذلك السيّف مشاعر

289
00:16:57,890 --> 00:17:01,240
".ندين بوجودنا إلى الرّب ميتسوهيدي"

290
00:17:01,790 --> 00:17:07,750
.ما يجعله كنزًا فريدًا لعائلة سايتو

291
00:17:08,020 --> 00:17:10,170
.صحيح يا كيوتاكا-كن

292
00:17:10,900 --> 00:17:15,260
.إن كنتَ حفيدي، لاخترتك خلفًا لي دونما تردّد

293
00:17:15,600 --> 00:17:18,010
...لا، أنا بالكاد

294
00:17:24,480 --> 00:17:27,260
.شكرًا على مساعدتك اليوم يا آوي-سان

295
00:17:27,260 --> 00:17:30,120
.آسف لأنّي كنتُ لئيمًا معك

296
00:17:30,120 --> 00:17:32,190
...لا بأس

297
00:17:33,740 --> 00:17:39,530
.منذ أن التقيتك، شعرتُ وكأنّي فقدتُ مكاني في كورا

298
00:17:40,040 --> 00:17:44,040
.شعرتُ وكأنّك سرقتِ كلّ شيء ثمين لي

299
00:17:45,010 --> 00:17:46,270
...ريكيو-كن

300
00:17:47,130 --> 00:17:54,800
لكنّك أثبتّ لي اليوم أنّك تعملين
.بجدّ لتكسبي مكانك في كورا

301
00:17:55,290 --> 00:17:57,180
.لذا سأعترف بك

302
00:17:58,120 --> 00:17:59,800
تعترف بي؟

303
00:18:00,550 --> 00:18:02,490
.كخلَفي

304
00:18:04,970 --> 00:18:07,860
.شـ-شكرًا لك يا ريكيو-كن

305
00:18:10,870 --> 00:18:12,210
.هولمز

306
00:18:12,210 --> 00:18:17,320
ما هو الكنز الأكثر قيمةً في هذا القصر بظنّك؟

307
00:18:17,320 --> 00:18:19,320
.سؤال سديد

308
00:18:19,790 --> 00:18:21,820
الخزف الأبيض، صحيح؟

309
00:18:21,820 --> 00:18:23,560
.كلّا، ليس ذاك

310
00:18:23,560 --> 00:18:24,580
ماذا؟

311
00:18:25,020 --> 00:18:27,330
.لوحة الستار في الطابق الأول

312
00:18:27,740 --> 00:18:31,330
،أعتقد أنّها من عمل تاوارايا سوتاتسو

313
00:18:31,330 --> 00:18:33,410
.رسّام ستار إله الريح وكذلك إله الرّعد

314
00:18:33,410 --> 00:18:35,840
.أقيّمها على نفس مستوى كنز وطني

315
00:18:38,450 --> 00:18:40,150
...فهمت

316
00:18:40,970 --> 00:18:46,100
،أتيتُ إلى هنا اليوم لأغيضك قليلًا
.لكن يبدو أنّني فشلتُ بشكلٍ ذريع

317
00:18:46,490 --> 00:18:47,340
.أجل

318
00:18:47,950 --> 00:18:51,700
لأنّك غير قادر على فهم
.تاوارا سوتاتسو على ما أعتقد

319
00:18:52,720 --> 00:18:55,120
.كان سوتاتسو رسامًا يكتنفه الغموض

320
00:18:55,120 --> 00:18:59,990
صنع الكثير من الأعمال مثل ذلك
.الستار دون ترك أيّ طابعٍ أو إمضاء

321
00:19:00,410 --> 00:19:06,240
.كما لو أنّ سوتاتسو أراد أن يمحي أيّ أثر لنفسه

322
00:19:06,940 --> 00:19:11,370
،في نفس الأثناء، بينما تصنع أعمالًا مزيّفة في الظلال

323
00:19:11,370 --> 00:19:14,820
.في الحقيقة، تحترق بإرادة أن يُعترف بك

324
00:19:14,820 --> 00:19:16,800
.أنت نقيضه التّام

325
00:19:16,800 --> 00:19:18,880
.لا يمكنك أن تفهمه أبدًا

326
00:19:19,420 --> 00:19:21,240
لا تتغيّر أبدًا، أليس كذلك؟

327
00:19:21,240 --> 00:19:24,210
...ذلك الجزء منك يُزعجني بحق

328
00:19:24,920 --> 00:19:27,640
.أكرهك حتّى النخاع

329
00:19:28,030 --> 00:19:29,640
.مشاعرنا متبادلة

330
00:19:37,390 --> 00:19:40,020
آوي-سان، هل كنت تنصتين؟

331
00:19:41,910 --> 00:19:46,910
لمَ تتفوّه دائمًا بالأشياء التي تُزعج إينشو-سان؟

332
00:19:47,170 --> 00:19:50,160
.أردتُ أن تثور مشاعره

333
00:19:51,660 --> 00:19:57,170
فكّرتُ أنّ ذلك قد يساعد على
...إزالة السحابة التي تُغيّم فوقه

334
00:19:57,620 --> 00:19:59,120
.لكنّي فشلتُ على ما أظن

335
00:19:59,640 --> 00:20:00,900
...ذلك

336
00:20:03,010 --> 00:20:05,550
.لا، هذا مجرّد عذر

337
00:20:05,890 --> 00:20:10,060
.فقط أظنّ أنّ ذلك الرّجل بغيض تمامًا

338
00:20:10,440 --> 00:20:13,440
...إن كنتُ أملك موهبته

339
00:20:14,900 --> 00:20:17,550
هولمز-سان غيور من إينشو؟

340
00:20:18,730 --> 00:20:22,780
...إذًا، كلاهما غيور من الآخر

341
00:20:24,540 --> 00:20:26,880
...لا، ليس هنا فحسب

342
00:20:27,540 --> 00:20:29,620
،معذرةً، هولمز-سان

343
00:20:29,620 --> 00:20:31,500
...بالنّسبة لكييكو-سان

344
00:20:32,800 --> 00:20:35,050
هل كنتما تتواعدان؟

345
00:20:35,680 --> 00:20:39,210
...قالت أنّك أمضيت اللّيلة في بيتها

346
00:20:40,220 --> 00:20:43,720
.أجل... لكنّها كانت مجرّد سهرة لا أكثر

347
00:20:44,600 --> 00:20:48,790
سمعتُ حينها أنّها تملك
،مجموعةً من كتب الفنّ النّادرة

348
00:20:48,790 --> 00:20:52,120
.لذا أمضيتُ يومين على الأريكة أقرأها كلّها

349
00:20:53,040 --> 00:20:55,650
أ-أهذا كلّ شيء؟

350
00:20:57,010 --> 00:21:00,230
مهلًا، لمَ أشعر بالارتياح لمعرفة ذلك؟

351
00:21:00,680 --> 00:21:03,510
أيجب أن نذهب الآن يا آوي-سان؟

352
00:21:11,320 --> 00:21:13,250
.يبدو كالرّبيع حقًّا

353
00:21:13,530 --> 00:21:17,000
سوف تُكملين عامك الأوّل في كورا قريبًا، أليس كذلك؟

354
00:21:18,580 --> 00:21:21,040
...أجل، عام كامل منذئذٍ

355
00:21:22,290 --> 00:21:26,130
.مقابلتي لهولمز أزالت عنّي الحزن

356
00:21:26,870 --> 00:21:31,140
...قرّرتُ أن أرسم خطًّا بيننا وأبقي مشاعري سرًّا

357
00:21:31,880 --> 00:21:35,140
.لكنّي كنتُ أكذب على نفسي طوال هذا الوقت

358
00:21:35,140 --> 00:21:36,980
،لأنّي كنتُ قلقةً من أن أتعرّض للأذى

359
00:21:36,980 --> 00:21:39,190
...تحجّجتُ بالأعذار وابتعدت

360
00:21:40,650 --> 00:21:43,000
.كنتُ أكذب على قلبي

361
00:21:48,070 --> 00:21:49,280
!انتظر رجاءً

362
00:21:55,800 --> 00:21:57,980
!أحبّك يا كيوتاكا-سان

363
00:21:59,810 --> 00:22:00,760
!آوي-سان

364
00:22:02,740 --> 00:22:05,790
القمر جميلٌ اللّيلة، أليس كذلك؟

365
00:22:10,620 --> 00:22:11,360
...أجل

366
00:22:13,520 --> 00:22:15,180
.إنّه جميل للغاية

367
00:22:17,320 --> 00:22:22,070
.سأبقي هذا الشعور لنفسي في الوقت الرّاهن

368
00:22:22,990 --> 00:22:27,450
لأنّي أريد أن أُثمّن الوقت
،الذي أمضيه مع كيوتاكا-سان

369
00:22:28,130 --> 00:22:29,640
.وأُقدّر الأشياء الجميلة

370
00:22:36,180 --> 00:22:38,550
...لكن يومًا ما، أنا أيضًا

371
00:22:41,200 --> 00:22:45,800
مُغلق

372
00:22:42,360 --> 00:22:46,960
في محلّ تُحف يُدعى كورا
،على طول تيراماتشي سانجو

373
00:22:47,380 --> 00:22:50,970
.ستجدون صبيّ كيوتو غامض يُدعى هولمز

374
00:22:58,280 --> 00:23:00,730
!هولمز، عليك أن تساعدني

375
00:23:00,950 --> 00:23:04,240
،صديقي، الممثّل كابوكي
!قد تورّط في قضيّة

376
00:23:04,240 --> 00:23:06,580
.لستُ مُحقّقًا

377
00:23:06,580 --> 00:23:07,990
.أنا مُثمّن

378
00:23:07,990 --> 00:23:10,180
!أرجوك! عليك أن تساعدني

379
00:23:12,210 --> 00:23:13,880
.هيا بنا يا هولمز-سان

380
00:23:13,880 --> 00:23:14,330
.حسنًا

381
00:23:14,560 --> 00:23:16,490
!انتظر

382
00:23:16,690 --> 00:23:20,750
،هذه حكاية هولمز
...أو بالأحرى، ياغاشيرا كيوتاكا

383
00:23:20,750 --> 00:23:23,460
...وأنا، ماشيرو آوي

384
00:23:27,900 --> 00:23:30,780
وقصّة الحبّ الهادئة والجميلة

385
00:23:30,780 --> 00:23:32,170
.والقضايا التي قمنا بحلّها في كيوتو

386
00:23:37,200 --> 00:23:40,840
.كيوتاكا-سان، أريد أن أخبرك... عن مشاعري

387
00:23:40,840 --> 00:23:43,880
.آوي-سان... دعيني أقلها

388
00:23:44,600 --> 00:23:47,200
.هولمز كيوتو

389
00:23:47,200 --> 00:23:50,190
.هولمز-سان، أنت بذيء بحق