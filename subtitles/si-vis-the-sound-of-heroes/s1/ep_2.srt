1
00:00:01,170 --> 00:00:03,400
!سُررتُ بلقائكم جميعاً

2
00:00:03,690 --> 00:00:05,770
التّالي، مينامي-كن

3
00:00:06,150 --> 00:00:07,980
!اسمي هو مينامي كيويا

4
00:00:08,150 --> 00:00:11,730
،التحقتُ بثانويّة أكاديميّة سايغوسا هذه
في منهاج الفنون للدّراسة معكم جميعاً

5
00:00:11,900 --> 00:00:16,990
!أكاديميّاً! ورياضيّاً! وأنشطة وعروض
!سأبذل قصارى جهدي

6
00:00:17,240 --> 00:00:19,910
الفنّان الّذي وضعتُ نُصب عينَي
عليّ كهدف هو سي-فيس بالطّبع

7
00:00:20,160 --> 00:00:24,120
،لا سيّما أنّني مُعجب بالقائد، يوسكي-كن
--وآمل يوماً ما أن أتفوّق عليه

8
00:00:27,330 --> 00:00:28,330
مينامي-كن؟

9
00:00:28,880 --> 00:00:30,330
مينامي كيويا-كن؟

10
00:00:30,500 --> 00:00:32,970
ما الأمر؟ هل أنت مُتوعّك؟

11
00:00:34,510 --> 00:00:36,050
أنا بخير

12
00:00:36,220 --> 00:00:39,100
اسمي... مينامي كيويا

13
00:00:39,640 --> 00:00:43,730
المعذرة، غادرتُ مُحافظة أوموري
في هذا الرّبيع للتّواجد هنا

14
00:00:44,390 --> 00:00:47,020
سُرِرتُ بلقائكم

15
00:00:54,450 --> 00:00:58,570
ثمّة شيء يجب علينا
حمايته في هذا الكوكب

16
00:00:59,330 --> 00:01:03,910
نورّثه لندع التّاريخ يستمرّ

17
00:01:04,080 --> 00:01:08,250
الماضي الّذي أذاك وجعلك تبكي

18
00:01:08,710 --> 00:01:12,920
هذه الأغنية هنا لشفائه

19
00:01:13,090 --> 00:01:17,800
بعيداً... يجب ألّا ننسى أبداً

20
00:01:17,970 --> 00:01:22,390
بعيداً... الرّابط في قلوبنا

21
00:01:22,560 --> 00:01:27,980
بعيداً جدّاً... مهما كانت الذّكريات بعيدة

22
00:01:28,150 --> 00:01:31,600
سوف نجمعها معاً

23
00:01:31,770 --> 00:01:38,670
عانق المُستقبل المُشرق ولننطلق

24
00:01:41,660 --> 00:01:48,560
انظر إلى النّور الفائض، الّذي
ينزلق عبر السّراب

25
00:01:51,420 --> 00:01:58,320
استحوذ على الشّمس المشرقة ولننطلق

26
00:02:01,180 --> 00:02:08,080
نحو العالم الجديد، جالباً البسمات معك

27
00:02:16,720 --> 00:02:17,760
نجح في الفحص الطبّي

28
00:02:18,030 --> 00:02:19,530
MISSING SIGN
- نجح في الفحص الطبّي

29
00:02:19,700 --> 00:02:21,270
MISSING SIGN
- لا خلل جسدي

30
00:02:21,440 --> 00:02:22,490
MISSING SIGN

31
00:02:22,660 --> 00:02:24,370
MISSING SIGN
- ونتيجة تحليل ميتيس؟

32
00:02:24,540 --> 00:02:25,560
MISSING SIGN
- هل هو مؤهّل؟

33
00:02:25,730 --> 00:02:26,730
هل هو مؤهّل؟

34
00:02:26,900 --> 00:02:32,160
!عاديّ. عاديّ جدّاً. طبيعيّ، مُتوسّط، مُعتدل

35
00:02:32,330 --> 00:02:36,710
حسناً، كلّ ما في الأمر أنّه بنفس
مستوى المُتدرّبين الآخرين

36
00:02:36,880 --> 00:02:41,260
إذاً كيف تفسّرون ما حدث؟

37
00:02:41,430 --> 00:02:44,510
هل كان هذا ما يُطلق عليه بالكرّ والفرّ؟

38
00:02:44,680 --> 00:02:48,640
،يقول بأنّه مرتبط بيوسكي-كن
لذا ربّما هو موروث بالدّم؟

39
00:02:48,890 --> 00:02:51,020
رغم ذلك، هل جُننتِ؟

40
00:02:51,190 --> 00:02:53,480
أتدعينه يحلّ مكان شيبا؟

41
00:02:53,900 --> 00:02:57,060
!لم يذكر أحدٌ شيئاً عن بديل يوسكي

42
00:02:57,230 --> 00:02:59,360
إذاً لماذا أجريتِ اختبار ذكاء عليه؟

43
00:02:59,820 --> 00:03:03,360
نحن نفعل ما يمكننا فعله فحسب الآن

44
00:03:03,530 --> 00:03:05,910
وإلّا سنخسر تماماً

45
00:03:06,080 --> 00:03:10,210
فقد خسرنا العمود الفقريّ لسي-فيس

46
00:03:14,170 --> 00:03:16,250
يبدو أنّه استيقظ

47
00:03:16,670 --> 00:03:19,010
حسناً، سأذهب وأتكلّم معه

48
00:03:20,260 --> 00:03:22,210
انتهيتِ من الفحص الطبّي، صحيح؟

49
00:03:22,380 --> 00:03:27,010
بذلت جهداً أكبر من أيّ شخص آخر
في الأداء، لذا عليك أن ترتاح

50
00:03:29,310 --> 00:03:31,480
مُرهَق جدّاً على الكلام؟

51
00:03:34,230 --> 00:03:36,400
سُررت بلقائك يا مينامي كيويا-كن

52
00:03:36,730 --> 00:03:42,450
اسمي كاميزاتو روي، وأنا مُديرة
سي-فيس في هارمونيا للتّرفيه

53
00:03:43,490 --> 00:03:46,370
أعلم بأنّك من أقرباء يوسكي

54
00:03:49,330 --> 00:03:50,660
!أين يوسكي-كن؟

55
00:03:58,460 --> 00:04:00,920
جسديّاً، لا تُعاني من أي مُشكلة

56
00:04:01,090 --> 00:04:02,340
يمكنك الذّهاب إلى المنزل الآن

57
00:04:02,840 --> 00:04:05,590
ماذا كان ذلك بالضّبط؟

58
00:04:06,350 --> 00:04:12,390
بدأ حفل الفدائيّين الموسيقيّ، وسُحِبتُ
نحو مكان غريب وتعرّضتُ لهجوم

59
00:04:12,560 --> 00:04:15,560
نُطلق عليه زينوس

60
00:04:15,730 --> 00:04:18,400
إنّه يلتهم كلّ مدينة مُمكنة في العالم

61
00:04:18,570 --> 00:04:20,150
العدوّ اللّدو لهذا العالم

62
00:04:20,320 --> 00:04:21,650
عمّاذا تتكلّمين؟

63
00:04:22,240 --> 00:04:26,240
ما خضعت له في الأمس كان
حقيقة لا جدل حولها

64
00:04:26,410 --> 00:04:29,410
ظهر زينوس في هذا العالم
قبل 10 سنوات

65
00:04:29,580 --> 00:04:34,790
كإجراء مُضادّ، أسّستْ هارمونيا للتّرفيه
سي-فيس قبل خمس سنوات

66
00:04:35,170 --> 00:04:38,460
لِمَ استخدام فنّانين تمويهيّين في وكالة ترفيه؟

67
00:04:39,000 --> 00:04:43,300
ولماذا لا يعلم النّاس شيئاً عن الأمر؟

68
00:04:43,670 --> 00:04:45,050
هناك سببان

69
00:04:45,220 --> 00:04:48,350
الأوّل هو لأنّ الأسلحة العاديّة
لا تنجح ضدّ زينوس

70
00:04:49,510 --> 00:04:53,850
لا يمكن هزيمتهم إلّا بواسطة
بشر يتمتّعون بإيديا مُعمَّق

71
00:04:54,690 --> 00:05:00,770
إيديا هو نوع من طاقة الحياة المُكتسَبة
بواسطة تحريك قلوب النّاس

72
00:05:01,570 --> 00:05:03,610
...بالتّأثُّر والحماس والسّرور

73
00:05:03,780 --> 00:05:09,450
يمكن أن يخلق أداء الفنون مثل هذه العواطف
والّتي تُعَدّ فعّالة ضدّهم

74
00:05:10,580 --> 00:05:15,460
العواطف الّتي يُثيرها أداء سوف
ترتقي بالفنّانين بالمُقابل

75
00:05:15,910 --> 00:05:19,500
هذا هو الشّيء الوحيد الّذي يستطيع هزيمتهم

76
00:05:20,540 --> 00:05:22,340
لستُ أفهم حقّاً

77
00:05:22,840 --> 00:05:26,260
السّبب الآخر هو أكثر تعقيداً حتّى

78
00:05:27,050 --> 00:05:31,390
ليتنا نستطيع الاعتماد على مُنظّمات كبيرة
،مثل قوّات الدّفاع الذّاتيّ والشّرطة

79
00:05:31,560 --> 00:05:33,640
لكن لن يُصدّقنا أحد

80
00:05:33,810 --> 00:05:35,810
مثلما لم تُصدّقنا، حتّى يوم أمس

81
00:05:36,390 --> 00:05:39,360
كيف لي أن أُصدّق ذلك؟

82
00:05:39,810 --> 00:05:44,690
لأنّه لم يحدث شيء حتّى البارحة

83
00:05:45,150 --> 00:05:49,110
ابتداء من الغد، سيبدأ ذلك بالتسرُّب

84
00:05:49,740 --> 00:05:54,580
بأنّك الآن خارج عالم الأشخاص العاديّين

85
00:05:55,950 --> 00:05:59,460
يمكنك استخدام إحدى غرف حرمنا الشّاغرة

86
00:05:59,630 --> 00:06:02,920
يمكنك الذّهاب إلى المدرسة كما
خطّطتَ حالما تبدأ

87
00:06:03,090 --> 00:06:06,050
،سواء ستعود إلى أوموري أو تبقى في طوكيو

88
00:06:06,220 --> 00:06:08,090
أنا متأكّدة بأنّك بحاجة بعض الوقت للتّفكير

89
00:06:08,260 --> 00:06:09,970
ارتح حاليّاً

90
00:06:11,100 --> 00:06:16,310
ستبدو غرفتك فارغة، لذا دعني أعطيك
بعض الصّور الّتي كانت لدى يوسكي

91
00:06:16,810 --> 00:06:20,100
وواحدة من منزلك

92
00:06:20,270 --> 00:06:22,900
...التقطتُ الصّورة الأُخرى

93
00:06:43,210 --> 00:06:44,800
يوسكي-كن

94
00:07:18,250 --> 00:07:19,250
أنت

95
00:07:19,870 --> 00:07:20,990
مينامي-كن

96
00:07:21,160 --> 00:07:22,200
ماذا؟

97
00:07:22,370 --> 00:07:23,830
اسمي كيدو واتارو

98
00:07:24,000 --> 00:07:25,750
أنا أيضاً مُتدرّب في هارمونيا

99
00:07:25,920 --> 00:07:27,130
سُررتُ بلقائك

100
00:07:27,960 --> 00:07:29,670
وأنا أوساناي كانجي

101
00:07:29,840 --> 00:07:32,890
سنذهب إلى الكاراوكي الآن. أتريد المجيء؟

102
00:07:33,510 --> 00:07:36,470
...لستُ بمزاج لذلك

103
00:07:36,640 --> 00:07:38,320
لماذا أنت هنا؟

104
00:07:38,490 --> 00:07:39,560
ماذا؟

105
00:07:39,730 --> 00:07:41,930
لم تخبرنا بشيء في التّعريف الذّاتيّ

106
00:07:42,100 --> 00:07:43,850
،التحقتَ بصفّ أداء الفنون

107
00:07:44,020 --> 00:07:45,940
لكن تنوي قضاء السّنوات الثّلاثة المُقبلة
مُنطوياً اجتماعيّاً؟

108
00:07:46,110 --> 00:07:47,690
بربّك الآن يا توموياسو-كن

109
00:07:47,860 --> 00:07:49,530
أنا متأكّد بأنّه مُتوتّر فحسب

110
00:07:50,030 --> 00:07:53,400
مثلي، لديه تجربة أداء سي-فيس قريبة

111
00:07:53,570 --> 00:07:56,110
ماذا؟ هل ستذهب إلى سي-فيس؟

112
00:07:56,280 --> 00:07:59,490
لكن بسلوك كهذا، ستفشل في المُقابلة الأولى

113
00:07:59,660 --> 00:08:04,000
!...سي-فيس كانت... في الأمس، في محطّة شيبويا

114
00:08:04,370 --> 00:08:06,920
محطّة شيبويا؟ أين هذه؟

115
00:08:07,090 --> 00:08:08,210
ماذا؟

116
00:08:08,380 --> 00:08:10,550
أي خطّ؟ خطّ نفق؟

117
00:08:11,170 --> 00:08:13,010
هل سمعتُما به؟

118
00:08:13,180 --> 00:08:15,260
لا، أنا أستقلّ حافلة

119
00:08:15,720 --> 00:08:18,970
أقصد شيبويا. عمّاذا تتكلّمون؟

120
00:08:19,140 --> 00:08:20,430
هذا هو سؤالي

121
00:08:20,600 --> 00:08:23,250
!هناك جناح شيبويا أيضاً

122
00:08:23,420 --> 00:08:24,480
لا

123
00:08:24,650 --> 00:08:28,100
!عـ-على أيّ حال، سي-فيس في ورطة الآن

124
00:08:28,270 --> 00:08:29,940
!...قائدهم يوسكي -كن قد

125
00:08:30,110 --> 00:08:32,110
قائد؟ يوسكي؟

126
00:08:32,280 --> 00:08:33,650
عن أي سي-فيس تتحدّث؟

127
00:08:33,820 --> 00:08:37,360
!كفّوا عن العبث معي فقط لأنّني من الرّيف

128
00:08:37,530 --> 00:08:40,700
لا يوجد قائد في سي-فيس

129
00:08:43,620 --> 00:08:47,080
حسناً، أعتقد بأنّ سيرين تتصرّف كقائد

130
00:08:47,250 --> 00:08:49,630
لكن كلّ ما تفعله هو الغناء

131
00:08:49,800 --> 00:08:51,170
كلامها سطحيّ أيضاً

132
00:08:55,970 --> 00:08:57,090
!أقصد يوسكي-كن

133
00:08:57,260 --> 00:08:58,880
!إنّه نجم شهير جدّاً

134
00:08:59,050 --> 00:09:00,050
-ألا تتذكّر

135
00:09:00,680 --> 00:09:01,890
!تعال إلى هنا

136
00:09:03,520 --> 00:09:06,980
لحظة، ماذا؟ هل مينامي-كن
صديق سوجي-كن؟

137
00:09:07,150 --> 00:09:10,020
لديه معلومات كبيرة عنك بالفعل

138
00:09:11,530 --> 00:09:12,860
!كفّ عن تشويش النّاس

139
00:09:13,030 --> 00:09:14,780
!ماذا لو أحدثتَ جلبة؟

140
00:09:14,950 --> 00:09:18,160
مهلاً، مهلاً، لم يكن يعلم ما يفعله

141
00:09:18,490 --> 00:09:20,320
لماذا لا أحد يعلم؟

142
00:09:20,490 --> 00:09:22,790
!كانت حادثة جنونيّة

143
00:09:26,870 --> 00:09:28,460
ليست مسألة أنّهم لا يعلمون

144
00:09:28,630 --> 00:09:33,090
في عقولهم، الحادثة في شيبويا لم تقع

145
00:09:34,090 --> 00:09:40,510
.على العكس، شيبويا لم تختفِ فحسب
لم تتواجد من الأساس

146
00:09:41,140 --> 00:09:44,350
مهلاً، لستُ أفهم ما تقوله

147
00:09:44,520 --> 00:09:47,890
في الواقع، أعلم بأنّ كلّ هذا
مُربِك في بادئ الأمر

148
00:09:48,440 --> 00:09:52,070
كنّا نُقاتل زينوس لسنوات

149
00:09:52,690 --> 00:09:54,980
،نربح، وينتهي زوالهم

150
00:09:55,150 --> 00:09:58,650
وستبقى معركتنا كمقطع أرشيفيّ
لحفلنا الموسيقيّ الفدائيّ

151
00:09:58,820 --> 00:10:02,330
هل تقصد بأنّ كلّ الحفلات الفدائيّة
السّابقة كانت معارك؟

152
00:10:02,580 --> 00:10:05,080
لكن عندما نخسر، فستكون كارثة

153
00:10:05,330 --> 00:10:10,660
سيبتلعون المدينة، بما في ذلك تاريخ
المكان والشّعب الّذي فيه

154
00:10:10,830 --> 00:10:14,460
خسرنا بعضاً من أعضائنا بهذا الشّكل

155
00:10:14,630 --> 00:10:15,960
...مستحيل

156
00:10:16,130 --> 00:10:20,170
لم أعلم بأنّ أعضاء سي-فيس قد تغيّروا يوماً

157
00:10:20,340 --> 00:10:21,550
من الطّبيعيّ ألّا تعلم

158
00:10:21,720 --> 00:10:24,510
فقد كنتَ تنتمي للجانب الآخر، أنسيت؟

159
00:10:24,680 --> 00:10:26,720
الأماكن والنّاس الّذين اختفوا

160
00:10:26,890 --> 00:10:29,600
سيزولون عن ذكريات كلّ النّاس في العالم

161
00:10:30,100 --> 00:10:32,400
حرفيّاً، لم تكن موجودة أبداً

162
00:10:32,810 --> 00:10:34,020
إنّها لعنة

163
00:10:34,400 --> 00:10:36,690
ألقوا تلك اللّعنة على هذا العالم

164
00:10:36,990 --> 00:10:40,570
إ-إن كان هذا صحيحاً، فلماذا
!أتذكّر يوسكي-كن؟

165
00:10:40,740 --> 00:10:42,950
عقوبة على التّدخُّل

166
00:10:43,740 --> 00:10:48,540
أنت الآن في عالم الكوابيس معنا

167
00:10:49,540 --> 00:10:52,920
من الآن فصاعداً، لن تتمكّن من النّسيان

168
00:10:53,090 --> 00:10:57,710
حتّى لو اختفت طوكيو، أنت وأنا
سنتذكّر الحقيقة المُروّعة

169
00:10:59,800 --> 00:11:02,800
هذا هو مُفترق الطّرق الّذي أمامك الآن

170
00:11:02,970 --> 00:11:04,390
،إن كنت لا تريد أن تُعاني

171
00:11:04,970 --> 00:11:06,930
فعُد إلى موطنك إذاً

172
00:11:07,890 --> 00:11:10,930
يا للعجب! إذلال مُستجدّ من الآن؟

173
00:11:11,100 --> 00:11:12,850
أنت سخيف جدّاً يا سوجي

174
00:11:13,020 --> 00:11:15,020
!ميو-تشان! سنذهب

175
00:11:15,190 --> 00:11:18,400
!هيّا، انتظريني

176
00:11:21,860 --> 00:11:24,530
نانو-كين، إلم نصل إلى هناك بعد؟

177
00:11:25,030 --> 00:11:28,490
سيستغرق الخروج من هذا 30 دقيقة على الأقلّ

178
00:11:28,660 --> 00:11:31,750
!ماذا؟! لن يمنحني هذا وقتاً كافياً للتّعويض

179
00:11:32,000 --> 00:11:34,880
لم أظهر في برنامج تلفزيونيّ منذ مدّة

180
00:11:35,290 --> 00:11:37,580
صوتكِ مُزعج. ألا تعلمين معنى الصّمت؟

181
00:11:37,750 --> 00:11:41,460
وألا تعرف كيف تُخفي شخصيّتك
النّزقة أيّها الفاشل النّكد؟

182
00:11:41,630 --> 00:11:46,470
أنتِ أستاذة في إخفاء طبيعتكِ الحقيقيّة
أيّتها الفاشلة اللّئيمة

183
00:11:46,640 --> 00:11:51,390
لا تنقلب عليّ فقط لأنّ ليس لديك
أحد تفتعل شجاراً معه بعد الآن

184
00:11:51,560 --> 00:11:54,940
دعونا ألّا نكون غير ودودين مع بعضنا الآخر

185
00:11:56,060 --> 00:11:58,860
أنت غير ودود بحدّ ذاتك أيضاً يا جون

186
00:11:59,030 --> 00:12:02,200
كلاكما تكاثرتُما على ذلك المُستجدّ
الّذي لا يعرف شيئاً

187
00:12:02,530 --> 00:12:04,610
ماذا لو عاد إلى الدّيار فعلاً؟

188
00:12:05,070 --> 00:12:10,580
جزء منّي يخبرني بأنّه من الأفضل له
أن يعود إلى الدّيار الآن

189
00:12:10,750 --> 00:12:15,790
أينما ذهب، إن خسرنا، فقد يختفي كذلك

190
00:12:15,960 --> 00:12:19,550
إذاً يُفترض بي أن أعمل مع شخص
بلا مهارات؟ لا أُريد

191
00:12:20,840 --> 00:12:24,550
لا بُدّ أن يكون شخصاً يستطيع مُجاراتنا
ويتفاعل معنا كيميائيّاً

192
00:12:24,720 --> 00:12:28,470
ويطمح لما هو أعلى معنا، وإلّا
فلا يمكنه أن يكون جزءاً من سي-فيس

193
00:12:28,890 --> 00:12:29,970
أليس كذلك؟

194
00:12:30,470 --> 00:12:36,610
أعتقد بأنّ يوسكي-كن نفد صبره معك
حتّى كبرت لتصبح شخصاً كهذا

195
00:12:42,110 --> 00:12:44,150
!نـ-نحن قادمون فوراً

196
00:12:44,320 --> 00:12:47,070
!سيرين تنتظر في الأستوديو

197
00:12:48,160 --> 00:12:50,040
أجل. حسناً

198
00:12:51,160 --> 00:12:53,040
عُلِم. سأكون في الانتظار

199
00:12:53,370 --> 00:12:54,830
هل كانت شيوريكو-تشان؟

200
00:12:55,000 --> 00:12:58,040
أجل. سيصل الثّلاثة بعد عشر دقائق

201
00:12:58,540 --> 00:12:59,790
أنا آسفة جدّاً يا حضرة الرّئيسة

202
00:12:59,960 --> 00:13:03,530
طلبتُ منكِ المجيء إلى هنا، لكن تأخّرت
المواهب في الوصول

203
00:13:03,910 --> 00:13:04,920
لا مُشكلة

204
00:13:05,090 --> 00:13:07,550
مُجرّد الوصول إلى هنا جدير بالثّناء

205
00:13:07,930 --> 00:13:11,930
...لا سيّما بعد ما حصل لقائدهم والنّجم الأشهر

206
00:13:12,270 --> 00:13:15,140
،لكن يستمرّ العالم وكأنّ شيئاً لم يحدث

207
00:13:15,310 --> 00:13:19,730
ويستمرّ النّاس في التّشجيع في التّلفزيون
من دون ذرّة حزن

208
00:13:20,190 --> 00:13:23,570
أنا متأكّدة بأنّ يوسكي سيقول
بأنّ هذا أفضل

209
00:13:23,740 --> 00:13:26,950
من غرق العالم بأسره في حزن ويأس

210
00:13:27,240 --> 00:13:28,570
...حضرة الرّئيسة

211
00:13:32,870 --> 00:13:34,080
سيرين؟

212
00:13:34,250 --> 00:13:36,700
أتعتقدين بأنّها ستطرق الباب؟

213
00:13:36,870 --> 00:13:37,870
تفضّل

214
00:13:40,380 --> 00:13:42,750
أتيت إلى محطّة التّلفزيون بهذا الزيّ؟

215
00:13:42,920 --> 00:13:45,300
تعلم بأنّك نائب رئيس هذه الشّركة أيضاً

216
00:13:45,630 --> 00:13:47,340
لم يأتِ العضو الجديد إلى هنا بعد

217
00:13:47,510 --> 00:13:51,140
إذاً تقصدين التّعامل مع ميراج المُقبل
بواسطتهم هم الأربعة فقط؟

218
00:13:51,470 --> 00:13:55,560
،لم يستطيعوا أولئك الخمسة هزيمته
فتجعلينهم يُقاتلون بواحد أقلّ؟

219
00:13:55,730 --> 00:13:57,430
كيف أمكنني ذلك؟

220
00:13:57,600 --> 00:14:00,480
هل تعتقد بأنّني لا أعلم إلى أيّ
حدّ أضغط عليهم؟

221
00:14:00,860 --> 00:14:03,810
لكن لا يمكننا أن ندع الأمر مُعلّقاً هكذا

222
00:14:03,980 --> 00:14:06,530
يجب أن نصيغ استراتيجيّة فعّالة حول

223
00:14:06,700 --> 00:14:08,610
كيفيّة التّعامل مع الوضع بالمُعطيات الّتي لدينا

224
00:14:08,950 --> 00:14:14,410
كانت سي-فيس قادرة على الأداء
بفضل قيادة يوسكي الحكيمة

225
00:14:14,580 --> 00:14:16,950
،الآن بعد زوال عقلهم المُفكِّر

226
00:14:17,120 --> 00:14:20,420
لا نتحمّل فقدان واستنزاف مُمتلكاتنا الثّمينة

227
00:14:21,330 --> 00:14:24,210
إلى أن تصبح سي-فيس جاهزة
...للمُواجهة والتقدُّم

228
00:14:24,670 --> 00:14:26,290
سأنتظر

229
00:14:26,460 --> 00:14:29,470
إنّهم أمل العالم

230
00:14:32,100 --> 00:14:33,550
هنا كاميزاتو

231
00:14:33,720 --> 00:14:35,430
نعم، نعم

232
00:14:35,600 --> 00:14:38,560
!ماذا؟ سيرين اختفت؟

233
00:14:38,940 --> 00:14:42,980
!ماذا تعتقد نفسها أنّها تفعل؟

234
00:14:52,700 --> 00:14:55,160
سيرين... سان؟

235
00:14:55,330 --> 00:14:57,830
"لستُ بحاجة "سان

236
00:14:58,910 --> 00:15:00,870
هل هذه مُصادفة؟

237
00:15:01,540 --> 00:15:05,030
ما هي احتماليّة ذلك برأيك؟

238
00:15:05,200 --> 00:15:06,210
ماذا؟

239
00:15:06,380 --> 00:15:09,930
نحن نحمي سلام العالم

240
00:15:14,050 --> 00:15:15,590
هذا يُخيفني

241
00:15:15,760 --> 00:15:18,560
حسناً، ماذا أردتِ منّي؟

242
00:15:19,230 --> 00:15:22,890
في الواقع... كنتُ كذلك، لكن ليس بعد الآن

243
00:15:23,060 --> 00:15:24,690
ماذا تقصدين بذلك؟

244
00:15:26,980 --> 00:15:29,230
،ما كنتُ مُهتمّة به كان أنت في الفيديو

245
00:15:29,400 --> 00:15:34,620
ترقص وتحظى بأجمل وقت
في حياتك كالأحمق

246
00:15:36,030 --> 00:15:39,370
أنتِ... رأيتِ فيديو تجربة الأداء الخاص بي؟

247
00:15:39,540 --> 00:15:42,750
لذا لا أملك شأناً معك وأنت
بهذا البؤس والشّقاء

248
00:15:46,710 --> 00:15:51,300
المعذرة يا سيرين. هلّا طرحتُ عليكِ سؤالاً؟

249
00:15:51,470 --> 00:15:52,510
ما هو؟

250
00:15:52,930 --> 00:15:56,600
لماذا تستمرّون في القتال؟

251
00:15:57,390 --> 00:16:00,640
تُخاطرون بأرواحكم دون أن يعرفكم أحد

252
00:16:01,020 --> 00:16:02,100
لماذا؟

253
00:16:02,390 --> 00:16:05,310
لأنّه ثمّة شيء نريد حمايته

254
00:16:05,480 --> 00:16:06,560
مثلك

255
00:16:06,730 --> 00:16:08,780
...أجل، لكن

256
00:16:09,230 --> 00:16:13,320
في الواقع، بالنّسبة لأولئك الّذين
تركناهم، يبدو الأمر غير مفهوم

257
00:16:13,950 --> 00:16:18,620
لذا أنا واثقة بأنّ يوسكي لم يُرِد
تركك وترك ناغي خلفه

258
00:16:23,500 --> 00:16:25,040
...تلك الفتاة، ناغي

259
00:16:25,210 --> 00:16:27,580
أين هي؟

260
00:16:27,750 --> 00:16:29,750
أين يمكنني اللّقاء بها؟

261
00:16:30,170 --> 00:16:32,590
...في الواقع، لنرَ

262
00:16:33,260 --> 00:16:38,100
إنّها في كلّ مكان، وليست في مكان

263
00:16:38,510 --> 00:16:40,390
ما معنى هذا؟

264
00:16:40,560 --> 00:16:43,640
أوّلاً، من تكون بالتّحديد؟

265
00:16:44,060 --> 00:16:46,270
وجدتُها أمامي فجأة

266
00:16:47,400 --> 00:16:48,690
...اسمع يا

267
00:16:49,150 --> 00:16:50,190
اسمي كيويا

268
00:16:50,650 --> 00:16:52,570
اسمع يا كيويا

269
00:16:53,400 --> 00:16:55,360
أتريد أن تعرفها؟

270
00:16:55,530 --> 00:16:56,570
بالطّبع

271
00:16:56,740 --> 00:17:00,790
هل أنت مُستعدّ لتقبُّل كلّ ما تسمعه، مهما كان؟

272
00:17:20,140 --> 00:17:21,930
لديّ جلسة تصوير تلفزيونيّة عقب هذا

273
00:17:22,100 --> 00:17:23,100
...المعذرة

274
00:17:23,430 --> 00:17:27,850
لرؤيتها، يجب أن تمتلك ما يكفي من إيديا

275
00:17:31,690 --> 00:17:33,030
هل يمكنني استخدام غيثارتك؟

276
00:17:33,900 --> 00:17:36,240
ماذا؟ عمّاذا تتكلّمين؟

277
00:17:37,860 --> 00:17:39,280
من فضلك

278
00:17:39,450 --> 00:17:41,200
!سـ-سيرين؟

279
00:17:48,120 --> 00:17:49,330
!مُذهل

280
00:17:49,500 --> 00:17:50,520
هل هذا معقول؟

281
00:17:50,690 --> 00:17:53,330
!سيرين تؤدّي أداء حيّاً؟ هذا رهيب

282
00:17:58,180 --> 00:18:00,850
!كيويا! ارقص

283
00:18:01,220 --> 00:18:03,140
!زيّن أُغنيتي برقصك

284
00:18:03,770 --> 00:18:05,930
توارى العالم عن الرّؤية

285
00:18:06,100 --> 00:18:11,600
المس مرّة ولن تستيقظ من الكابوس أبداً

286
00:18:11,770 --> 00:18:15,070
الأيّام الّتي خلت

287
00:18:15,320 --> 00:18:16,820
اسمع يا كيويا

288
00:18:17,150 --> 00:18:19,320
أتريد أن تعرفها؟

289
00:18:21,030 --> 00:18:24,660
هل أنت مُستعدّ لتقبُّل كلّ ما تسمعه، مهما كان؟

290
00:18:26,250 --> 00:18:30,580
مهما أصبحت الحقيقيّة ضبابيّة

291
00:18:31,040 --> 00:18:34,170
أريد حماية هذه الأمنية الأبديّة

292
00:18:34,340 --> 00:18:35,690
بكلّ جزء من كياني

293
00:18:35,860 --> 00:18:36,920
دعه يصدح

294
00:18:37,090 --> 00:18:39,550
صوتي وصوتك

295
00:18:39,720 --> 00:18:41,880
لحظة تحوّله إلى أغنية

296
00:18:42,050 --> 00:18:46,930
تتوحّد قلوبنا معاً بفانتازيا مُتناغمة

297
00:18:47,100 --> 00:18:50,600
حتّى لو لم يأتِ يوم غد

298
00:18:50,770 --> 00:18:52,730
مع كلّ الأماني في قلبي

299
00:18:52,900 --> 00:18:59,570
سأقاتل ميلوديا

300
00:19:11,710 --> 00:19:12,830
...أنتِ

301
00:19:36,480 --> 00:19:39,110
هل رأيتها؟ رأيت ناغي؟

302
00:19:40,400 --> 00:19:42,660
أنا أكثر ارتباكاً الآن حتّى

303
00:19:43,620 --> 00:19:47,370
إذا أردت معرفة المزيد، فنادِها من جديد

304
00:19:48,330 --> 00:19:54,130
يبدو أنّها تحبّ رقصك

305
00:19:55,750 --> 00:19:59,840
لطالما اهتمّ يوسكي لأمرها

306
00:20:00,260 --> 00:20:03,590
لدرجة أنّه قد يعود من الموت

307
00:20:04,300 --> 00:20:06,720
أعتقد بأنّك التّالي

308
00:20:11,060 --> 00:20:18,050
ما الّذي يمكنني فعله لأجلها... ولأجل العالم؟

309
00:20:18,900 --> 00:20:22,570
عندما تعرف ماذا ستفعل، فهل ستفعل؟

310
00:20:25,110 --> 00:20:29,540
بفضلها، تعلّمتُ معنى الأداء أمام النّاس

311
00:20:30,250 --> 00:20:33,160
لذا أريد مُساعدتها

312
00:20:34,210 --> 00:20:35,750
أريد مُساعدة العالم

313
00:20:37,710 --> 00:20:40,380
لنقل تُراث يوسكي-كن

314
00:20:43,380 --> 00:20:45,640
!وجدتُ سيرين

315
00:20:45,890 --> 00:20:47,890
!أين هي بالضّبط؟

316
00:20:54,640 --> 00:21:00,570
كيويا، هل أنت مُستعدّ لتسخيري
بالكامل مثلما فعل يوسكي؟

317
00:21:01,230 --> 00:21:02,610
تسخيرك؟

318
00:21:02,780 --> 00:21:05,360
ظننتُ بأنّكِ تُسخّرين الجميع يا سيرين

319
00:21:05,530 --> 00:21:07,860
لستُ سوى مُجرّد رمح

320
00:21:08,030 --> 00:21:10,320
لكن أنا أفضل رمح موجود

321
00:21:10,490 --> 00:21:13,500
حالما نصعد على المسرح، سوف ترى

322
00:21:16,750 --> 00:21:19,670
...إن كنت تهتمّ بيوسكي حقّاً

323
00:21:20,500 --> 00:21:24,300
إن كنت لا تريد أن يزول وجود يوسكي
،عن هذا العالم

324
00:21:24,470 --> 00:21:26,550
فسيترتّب عليك هزيمة زينوس

325
00:21:27,720 --> 00:21:32,640
واستعد المدينة والذّكريات الّتي اختفت

326
00:21:33,980 --> 00:21:40,320
استرجع كلّ شيء. وحينئذ يمكننا
جميعاً... أن نبكي معاً

327
00:21:43,440 --> 00:21:48,110
لكن هل من المُناسب أن يُقاتل فنّان
بينما حياته على المحكّ؟

328
00:21:48,820 --> 00:21:51,700
عندما ترقص، فأنت تؤدّي بحياتك، أليس كذلك؟

329
00:21:51,870 --> 00:21:53,910
نفس الفرق

330
00:21:58,080 --> 00:22:00,120
!ماذا أفعل معكِ؟

331
00:22:00,290 --> 00:22:01,710
!كم مرّة يجب أن أخبركِ؟

332
00:22:01,880 --> 00:22:03,290
روي-سان، تمّ تأمينها من جديد

333
00:22:03,460 --> 00:22:05,460
!يُفترَض بك مُراقبتها جيّداً

334
00:22:05,630 --> 00:22:06,630
!بئساً

335
00:22:13,720 --> 00:22:17,750
أصدقاء وابتسامة

336
00:22:29,530 --> 00:22:31,890
كما جرت العادة

337
00:22:32,060 --> 00:22:36,210
نبكي على نفس الأشياء

338
00:22:36,380 --> 00:22:38,750
سرعان ما ننفعل

339
00:22:38,920 --> 00:22:43,180
نتجادل حول هذا وذاك

340
00:22:43,350 --> 00:22:45,620
نفهم بعضنا الآخر

341
00:22:45,790 --> 00:22:52,030
أكثر من أيّ أشخاص آخرين

342
00:22:53,210 --> 00:22:56,350
هذا تافه جدّاً

343
00:22:56,520 --> 00:22:59,950
لكن لا يمكننا التوقُّف عن الضّحك

344
00:23:00,120 --> 00:23:02,810
كقراءة أفكار بعضنا الآخر

345
00:23:02,980 --> 00:23:06,770
إنّه تناغُم غامض قليلاً

346
00:23:06,940 --> 00:23:09,910
أنت صادق جدّاً

347
00:23:10,080 --> 00:23:13,690
لذا لا أستطيع أن أدعك لوحدك

348
00:23:13,860 --> 00:23:16,510
أعتمد عليك، اعتمد عليّ

349
00:23:16,680 --> 00:23:18,760
يبدو هذا مناسباً فحسب

350
00:23:18,930 --> 00:23:19,930
أصدقاء وابتسامة