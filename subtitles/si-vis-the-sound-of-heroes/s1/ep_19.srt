1
00:00:10,610 --> 00:00:14,240
هل سيصبح وجود زينوس معروفاً
على العلن أخيراً؟

2
00:00:14,240 --> 00:00:16,760
آمل ألّا يُسبّب ذلك هلعاً

3
00:00:16,760 --> 00:00:20,620
،أنا قلق بشأن ردّة فعل النّاس
لكن هناك ما هو مُقلق أكثر

4
00:00:20,930 --> 00:00:23,040
أين كيويا وسوجي بالضّبط؟

5
00:00:23,040 --> 00:00:24,720
!أنا متأكّد بأنّهما بأمان

6
00:00:24,720 --> 00:00:27,470
!ليس هما فقط، لكن بقيّة سي-فيس أيضاً

7
00:02:13,480 --> 00:02:15,150
طاقم هارمونيا للتّرفيه

8
00:02:15,150 --> 00:02:18,420
وأعضاء سي-فيس يُزعَم أنّهم
كانوا داخل البناء

9
00:02:18,420 --> 00:02:22,140
لم نتأكّد من نجاة أولئك الأربع عشرة شخصاً بعد

10
00:02:22,140 --> 00:02:27,020
هنا في أكاديميّة سايغوسا، حيث
،حيث تعمل سايغوسا سينا كمُديرة

11
00:02:26,700 --> 00:02:30,160
أشعر بتأنيب ضمير حيال مُضايقة
التّلاميذ بهذا الشّكل

12
00:02:27,020 --> 00:02:29,730
أعضاء الطّاقم مشغولون بجمع معلومات

13
00:02:30,500 --> 00:02:35,130
لكن لا يمكننا إعادتك إلى العلن حاليّاً

14
00:02:35,660 --> 00:02:39,780
إن عدتِ، فإنّ الحكومات المحلّية والدّوليّة
وكذلك وسائل الإعلام

15
00:02:39,780 --> 00:02:41,700
،سيأتون إليكِ علاوة على زينوس

16
00:02:41,700 --> 00:02:44,850
ممّا يُسبّب عرقلة حقيقيّة لأنشطة سي-فيس

17
00:02:44,850 --> 00:02:49,370
لم أكن أعلم بأنّ هارمونيا لديها
قاعدة سرّية كهذه

18
00:02:49,370 --> 00:02:51,150
كانت فكرة الرّئيسة

19
00:02:51,150 --> 00:02:54,260
وهي أيضاً كمركز نسخ احتياطيّ لميتيس

20
00:02:54,260 --> 00:02:59,040
،فهمت. بما أنّها كائنة في الرّيف
فلا وجود تقريباً لخطر ميراج

21
00:02:59,040 --> 00:03:00,160
هذا ذكيّ

22
00:03:00,500 --> 00:03:02,830
نجونا بأعجوبة، أليس كذلك؟

23
00:03:02,830 --> 00:03:05,660
!ما زال بإمكاننا مُقاومة هجوم زينوس

24
00:03:05,660 --> 00:03:08,840
بالمناسبة، أين روي-سان وأعضاء سي-فيس؟

25
00:03:10,860 --> 00:03:14,100
يُرفّهون مُنقذنا

26
00:03:14,990 --> 00:03:19,550
لم يكن من المُفترض أن ننجو من تلك الهجمة

27
00:03:19,820 --> 00:03:22,560
لكن قالت ميو بأنّها رأتْ شيئاً

28
00:03:37,450 --> 00:03:39,450
أنقذتِ أرواحنا

29
00:03:40,010 --> 00:03:41,950
بقوّة غامضة

30
00:03:43,150 --> 00:03:44,700
تُدعى إيلبيس

31
00:03:45,580 --> 00:03:51,460
نحن الزّينوس وُهِبنا قوّتان من الكاهن آركون

32
00:03:51,790 --> 00:03:53,560
واحدة هي باندورا

33
00:03:53,560 --> 00:03:56,510
قوّة هائلة يتمّ تغذيتها بواسطة إيديا هائلة

34
00:03:56,510 --> 00:03:59,320
إنّها قوّة لغزو سكّان الأرض

35
00:03:59,800 --> 00:04:01,760
والأُخرى هي إيلبيس

36
00:04:02,160 --> 00:04:04,810
هذه لا تتطلّب الكثير من الإيديا لاستخدامها

37
00:04:05,440 --> 00:04:08,820
،كلّ ما نحتاجه هو تحرير كلّ ما بقي بداخلك

38
00:04:08,820 --> 00:04:11,360
لتُحقّق لك أُمنيتك الأخيرة

39
00:04:12,080 --> 00:04:14,440
!تقصدين بأنّها تقنيّة تدمير ذاتيّ؟

40
00:04:14,730 --> 00:04:16,940
أهذا ما استخدمه لوكوس؟

41
00:04:17,240 --> 00:04:21,450
أجل، ليتبادل الهجمات آنيّاً هو
وذلك الفارس هناك

42
00:04:22,030 --> 00:04:24,550
ليس وكأنّ ذلك قد نجح في نهاية المطاف

43
00:04:28,030 --> 00:04:30,100
!يا للهدوء والتّماسك

44
00:04:30,100 --> 00:04:32,000
أنتم مجموعة باردة الأعصاب

45
00:04:32,000 --> 00:04:37,150
أجل. استخدمتُ إيلبيس وأنا أعلم بأنّني سأختفي

46
00:04:37,150 --> 00:04:41,890
لذا ما كان ينبغي أن أنجو هكذا حقّاً

47
00:04:41,890 --> 00:04:46,020
لا يهمّنا سبب نجاتكِ

48
00:04:46,020 --> 00:04:47,450
مُخيف

49
00:04:47,450 --> 00:04:49,630
أنتِ السّبب لإخباركِ روي-سان

50
00:04:49,630 --> 00:04:52,100
!بأنّها ويوسكي جمعَتْهما علاقة مُعقّدة

51
00:04:54,430 --> 00:04:58,360
لماذا ساعدتنا؟ فأنتِ من زينوس

52
00:04:58,990 --> 00:05:00,540
وهل من داعٍ للسّؤال؟

53
00:05:00,540 --> 00:05:02,110
أنا متأكّدة بأنّكم تعرفون سلفاً

54
00:05:02,450 --> 00:05:06,670
بشأن زميلنا الّذي ضحّى بحياته
،لمُحاولة إنقاذكم

55
00:05:06,670 --> 00:05:08,580
رغم أنّه كان من نوع مُختلف

56
00:05:09,540 --> 00:05:11,240
!هجوم مُضادّ

57
00:05:11,240 --> 00:05:12,920
أليسا مُتشابهين بعض الشّيء؟

58
00:05:13,310 --> 00:05:15,580
في أيّ صفّ أنتِ؟

59
00:05:15,580 --> 00:05:18,960
...زينوس؟ سكّان الأرض؟ أم

60
00:05:19,310 --> 00:05:22,470
إن كنتِ في صفّ يوسكي-كن، فهذا
ما كلّ نحتاجه

61
00:05:22,970 --> 00:05:25,780
—ميديا-سان، صحيح؟ أنا

62
00:05:25,780 --> 00:05:28,030
رأيتكِ في ذاكرة أورفي

63
00:05:28,030 --> 00:05:30,600
الفارس الّذي يحمي النّجمة، كيويا

64
00:05:31,910 --> 00:05:36,480
أجل. أنا جناح يحمي ناغي، مركزنا

65
00:05:37,420 --> 00:05:40,430
مع أنّني فشلتُ في حمايتها

66
00:05:40,990 --> 00:05:42,490
لم يكن بوسعك فعل شيء

67
00:05:42,490 --> 00:05:46,490
لأنّك مُقارنة بأورفي، لستَ كافياً

68
00:05:47,030 --> 00:05:52,670
قوّتك الفرديّة وقيادتك وعزيمتك وأُمنياتك

69
00:05:52,670 --> 00:05:54,650
لا شيء فيك كافٍ

70
00:05:54,650 --> 00:05:56,050
—تمهّلي لحظة

71
00:05:56,050 --> 00:05:58,500
لا بأس يا روي-سان. معها حقّ

72
00:05:59,870 --> 00:06:04,220
.لذا يا ميديا-سان، ساعديني من فضلكِ
لستُ كافياً بمفردي

73
00:06:05,490 --> 00:06:08,170
ما الّذي كان يوسكي يحاول فعله؟

74
00:06:08,720 --> 00:06:13,080
ما الّذي أراد يوسكي-كن من زينوس
وسكّان الأرض؟

75
00:06:13,550 --> 00:06:14,760
أخبريني

76
00:06:15,620 --> 00:06:17,190
لستُ كافياً

77
00:06:17,190 --> 00:06:20,230
قد لا أبلغ مستوى يوسكي-كن طوال حياتي

78
00:06:20,580 --> 00:06:22,490
لكن مع ذلك، سأحمي ناغي

79
00:06:22,860 --> 00:06:25,440
يجب أن أكتشف ذاتي الحقيقيّة

80
00:06:30,150 --> 00:06:32,860
من فضلكِ مدّي لي يد العون يا ميديا-سان

81
00:06:38,720 --> 00:06:40,240
سيّد آركون

82
00:06:40,960 --> 00:06:43,850
ألقِ نظرة من فضلك يا سيّد أبّولو

83
00:06:43,850 --> 00:06:48,350
تبدو إيدين-ساما أكثر تجدُّداً ونشاطاً اليوم

84
00:06:48,350 --> 00:06:52,350
إذاً هذا ما يستطيع فعله الدّم

85
00:06:52,350 --> 00:06:53,100
ماذا؟

86
00:07:01,560 --> 00:07:04,700
هل هي نجمة زينوس؟

87
00:07:04,700 --> 00:07:08,380
أجل يا إيدين-ساما. قد تكون أمّكِ

88
00:07:08,740 --> 00:07:11,800
أمّي؟

89
00:07:12,240 --> 00:07:14,750
إ-إذاً هذه الفتاة...؟

90
00:07:17,740 --> 00:07:22,230
الفيديو الّذي سأعرضه عليكم
هو التّسجيل الّذي تركَه أورفي

91
00:07:23,910 --> 00:07:25,510
هذه ناغي؟

92
00:07:25,510 --> 00:07:26,860
!مهلاً لحظة

93
00:07:26,860 --> 00:07:29,790
...تقول "ابنة النّجمة"، لكن هذا

94
00:07:29,790 --> 00:07:36,360
،أجل. لم تكن ثمرة حُبّ إيدين-ساما
ولا طفلاً مُبارَكاً حتّى

95
00:07:36,360 --> 00:07:38,020
من يفعل شيئاً فظيعاً كهذا؟

96
00:07:40,060 --> 00:07:42,480
!ذلك الرّجل؟ فعل هذا بناغي؟

97
00:07:42,830 --> 00:07:47,060
أجل. نعرف الآن من يكون عدوّنا الجقيقيّ

98
00:07:49,330 --> 00:07:51,580
يوسكي فعل ذلك بي؟

99
00:07:51,900 --> 00:07:59,330
يُشاع بأنّ السّيّد أورفي ربّى طفلاً
رضيعاً كان قريباً نسيباً للنّجمة بشكل سرّيّ

100
00:07:59,330 --> 00:08:05,340
ليس "تربية". صنعه بطريقة غير أخلاقيّة

101
00:08:05,610 --> 00:08:08,340
،عندما اكتشف أبّولو-ساما ذلك

102
00:08:08,810 --> 00:08:11,360
أخذك السّيّد أورفي وغادر هذا البلد

103
00:08:12,500 --> 00:08:16,480
،في بلد غريب، لطالما كنتِ محرومة من الإيديا

104
00:08:16,480 --> 00:08:21,320
ممّا دفعكِ للتّمايل بين الحياة والموت

105
00:08:22,790 --> 00:08:24,730
هذا غير صحيح

106
00:08:25,630 --> 00:08:30,740
أورفي... يوسكي اعتنى بي حقّاً

107
00:08:31,310 --> 00:08:33,640
كان رجلاً قويّاً ولطيفاً

108
00:08:41,250 --> 00:08:44,980
تعتقد بأنّ أورفي من صنع تلك الفتاة؟

109
00:08:44,980 --> 00:08:46,510
من غيره قد يفعل؟

110
00:08:48,570 --> 00:08:51,120
مَن، بالفعل؟

111
00:08:52,480 --> 00:08:57,170
لا يمكنني القول بأنّ شكّي بك
قد تبدّد كلّياً

112
00:08:57,600 --> 00:09:01,180
،لكن بما أنّ الرّئيسة تقول بأنّها تُصدّقك

113
00:09:01,180 --> 00:09:03,110
لا أملك خياراً سوى السّماح
لك بالبقاء هنا

114
00:09:03,110 --> 00:09:05,220
ليس وكأنّني أُصدّقها

115
00:09:05,220 --> 00:09:07,860
قال كيويا-كن بأنّه احتاج مُساعدتها

116
00:09:08,180 --> 00:09:10,610
كالعادة، تتساهل هذه الشّركة مع المواهب

117
00:09:10,610 --> 00:09:11,610
!هاياما-سان

118
00:09:11,610 --> 00:09:13,540
وهذه كلّ التّفاصيل

119
00:09:13,540 --> 00:09:15,910
هلّا أعدتِ النّظر في مدّ يد العون لنا

120
00:09:15,910 --> 00:09:19,120
وذلك لأجل موهبتنا الثّمينة، ميديا-سان؟

121
00:09:21,150 --> 00:09:27,620
أنقذتُك. ستثقين بي بناء على ذلك وحده؟

122
00:09:27,620 --> 00:09:31,700
كنتُ فقط في معركة مُميتة ضدّك

123
00:09:32,390 --> 00:09:34,890
،الزّعيم الحقيقيّ لجماعتنا هو ذلك الفتى

124
00:09:35,470 --> 00:09:38,530
رغم أنّه قد لا يكون كافياً لعيون

125
00:09:39,200 --> 00:09:42,210
أنا متأكّدة بأنّه سيكون قراراً صعباً بالنّسبة لكِ

126
00:09:42,210 --> 00:09:44,310
الاختيار لخيانة موطنك

127
00:09:44,310 --> 00:09:48,180
،والشّخص الّذي خدمته طوال هذه السّنين

128
00:09:48,180 --> 00:09:49,080
—أنا متأكّدة بأنّكِ تحتاجين سببـ

129
00:09:49,080 --> 00:09:51,780
أنقذتِني ونجّيتِني

130
00:09:53,150 --> 00:09:57,620
بعد استخدام إيلبيس، الشّيء الوحيد
المُتبقّي لي هو أن أتعفّن

131
00:09:57,620 --> 00:10:00,440
لكن حملتموني إلى هنا وعالجتموني

132
00:10:01,630 --> 00:10:04,210
لا أملك سبباً لألّا أساعدكم

133
00:10:08,230 --> 00:10:10,840
"كنّا لنقول، "نحن في نفس المركب

134
00:10:13,220 --> 00:10:15,840
إذاً لنبذل نحن الاثنتان قصارى جهدنا

135
00:10:16,390 --> 00:10:18,350
،أورفي الخاصّ بكم أحبّ زينوس حُبّاً جمّاً

136
00:10:18,950 --> 00:10:21,490
ويوسكي الخاصّ بنا أحبّ الأرض كثيراً

137
00:10:22,100 --> 00:10:24,760
سوف نُنقذ كلا موطنيه

138
00:10:27,380 --> 00:10:30,360
!ليست الأرض فقط إذاً؟

139
00:10:31,390 --> 00:10:35,440
هل تقصدين بأنّكِ مُستعدّة لإنقاذ زينوس أيضاً؟

140
00:10:36,190 --> 00:10:39,370
لستُ كذلك، لكن موهبتي هي كذلك

141
00:10:42,250 --> 00:10:44,870
سأؤمن إذاً

142
00:10:45,230 --> 00:10:50,170
بموهبتكِ وبكِ، والّتي لا بدّ أنّكِ
دلّلتِ أورفي أيضاً

143
00:10:52,510 --> 00:10:56,510
ما رأيكم أن أكون الشّخصيّة المحوريّة
الفرديّة في المعركة التّالية

144
00:10:56,510 --> 00:10:57,640
لا تتمتّع ببريق

145
00:10:57,640 --> 00:10:58,740
مقامك مُنخفض جدّاً

146
00:10:58,740 --> 00:10:59,760
مُتخصِّص جدّاً؟

147
00:10:59,760 --> 00:11:00,900
!ما مُشكلتكم؟

148
00:11:00,900 --> 00:11:03,700
،لكن إذا لم يكن سوجي الجناح
—فالتّوازن يتزعزع

149
00:11:03,700 --> 00:11:07,520
يمكنني أن أكون الجناح أيضاً! أعلم
!بأنّني أستطيع فعل كليهما بصورة مثاليّة

150
00:11:07,520 --> 00:11:09,080
حمل بطّيختين بيد واحدة و...؟

151
00:11:09,080 --> 00:11:10,120
!ماذا تقولين؟

152
00:11:10,120 --> 00:11:14,240
حضورك الجسديّ ضروريّ لاختراق خطّ الجبهة

153
00:11:14,650 --> 00:11:17,050
أنت جناح مُرسَل من الرّبّ

154
00:11:17,050 --> 00:11:18,700
افهم ذلك أرجوك يا سوجي

155
00:11:19,670 --> 00:11:21,030
أجل، أعلم ذلك

156
00:11:21,030 --> 00:11:22,120
سهل للغاية

157
00:11:23,040 --> 00:11:24,120
!هنا

158
00:11:24,120 --> 00:11:26,940
!أنتِ! ماذا تفعلين؟ أتستغلّين الفوضى؟

159
00:11:26,940 --> 00:11:30,340
لكن عند التّفكير بالتّوازن، فهناك
خيار وحيد حاليّاً

160
00:11:30,740 --> 00:11:33,090
حصراً من عمليّة الإقصاء

161
00:11:33,090 --> 00:11:35,100
أتحاولين افتعال مُشكلة ما؟

162
00:11:35,100 --> 00:11:36,090
،ما يعني

163
00:11:36,090 --> 00:11:38,920
بأنّنا نستطيع وضع سوجي في الأمام
وكيويا وجون في كلا الطّرفين

164
00:11:38,920 --> 00:11:41,600
لمُحاصرة ميو في المِحور

165
00:11:41,600 --> 00:11:44,260
تبدو كأميرة شلّة أوتاكو

166
00:11:44,260 --> 00:11:48,240
لكن أتعلمون؟ إذا عَلِمَتْ سيرين بأنّني
،مِحور المجموعة

167
00:11:48,240 --> 00:11:49,780
فقد لا تبقى صامتة

168
00:11:49,780 --> 00:11:52,880
إمّا ستهزأ منكِ أو تضربكِ

169
00:11:52,880 --> 00:11:53,740
!ماذا قلت؟

170
00:11:53,740 --> 00:11:55,510
روي-سان، أين سيرين؟

171
00:11:55,510 --> 00:11:57,930
،خرّجتْ نفسها دون إذن

172
00:11:57,930 --> 00:12:01,810
ولا تردّ على مُكالماتي أو تتفقّد
رسائل عبر وسائل التّواصل

173
00:12:01,810 --> 00:12:04,240
لا أحد يعلم أين هي وماذا تفعل

174
00:12:05,090 --> 00:12:07,790
على أيّ حال، لا يمكننا الاعتماد
على سيرين الآن

175
00:12:07,790 --> 00:12:09,750
سيترتّب علينا اتّخاذ المُبادرة

176
00:12:10,050 --> 00:12:12,790
حاليّاً، أجل. أعلم ذلك

177
00:12:13,270 --> 00:12:16,720
لكن متى يمكننا البدء بالاعتماد عليها؟

178
00:12:17,840 --> 00:12:20,340
لن ينفع الإسهاب في ذلك الآن، أليس كذلك؟

179
00:12:20,620 --> 00:12:24,350
تماماً. الوقت ليس مُناسباً للوقوف عند ذلك الآن

180
00:12:24,740 --> 00:12:27,410
،حتّى لو لم يكن لدينا ناغي أو سيرين

181
00:12:27,410 --> 00:12:30,000
سوف نُقدّم أفضل أداء لدينا

182
00:12:30,000 --> 00:12:32,280
هذا هو هدف سي-فيس، صحيح؟

183
00:12:33,480 --> 00:12:34,900
لا أُبالي إذا كان هذا لن ينفع

184
00:12:35,510 --> 00:12:37,120
!أريد الإسهاب فيه

185
00:12:37,520 --> 00:12:40,460
!أريد التوقُّف عنده

186
00:12:41,160 --> 00:12:43,500
أيّها الطّفل المُدلّل الأنانيّ

187
00:12:43,500 --> 00:12:45,410
أنت جديدٌ بالفعل هنا

188
00:12:45,700 --> 00:12:48,220
لم أعُد أستغرب كلام ميديا

189
00:12:48,220 --> 00:12:49,630
...المعذرة

190
00:12:50,100 --> 00:12:53,130
المِحوران، سيرين وناغي

191
00:12:53,130 --> 00:12:55,290
هذا هو الشّكل النّهائيّ لسي-فيس

192
00:12:56,550 --> 00:12:59,170
لن أتخلّى عن ذلك الإصدار من سي-فيس

193
00:12:59,970 --> 00:13:03,300
!سوف أسترجع كلّاً من ناغي وسيرين

194
00:13:05,310 --> 00:13:07,570
لن تتخلّى عن كلتيهما؟

195
00:13:07,570 --> 00:13:09,810
أشتمّ رائحة أحمق حقيقيّ

196
00:13:10,550 --> 00:13:12,400
!أقصد كعضوتين

197
00:13:15,940 --> 00:13:18,920
هل ما زالت سي-فيس مفقودة؟

198
00:13:18,920 --> 00:13:21,070
كانت حادثة جنونيّة

199
00:13:21,070 --> 00:13:23,200
آمل أن يكون كيويا-كن بخير

200
00:13:24,150 --> 00:13:26,370
تأذّتْ سيرين أذى شديداً، صحيح؟

201
00:13:26,370 --> 00:13:29,640
حتّى المشاهير لا يستطيعون التغلُّب على جرح

202
00:13:32,950 --> 00:13:40,340
لأجلك يا عزيزي، سأغنّي أغنية أمل
تؤدّي إلى الخلود

203
00:13:41,880 --> 00:13:44,790
نِزاع بحثاً عن السّلام

204
00:13:44,790 --> 00:13:48,900
لهؤلاء الأبطال الّذين يُصلّون

205
00:13:48,900 --> 00:13:51,350
لا يمكن مسح هذه السّخرية

206
00:13:52,960 --> 00:13:55,920
تعلُّم تقدير العزلة

207
00:13:55,920 --> 00:14:03,210
الوجهان الأماميّ والخلفيّ من هذا
العالم يتقاطعان دوماً

208
00:14:08,320 --> 00:14:10,060
ما هذا؟

209
00:14:10,060 --> 00:14:11,290
سراب؟

210
00:14:14,010 --> 00:14:15,960
لكن لماذا هو هنا؟

211
00:14:22,420 --> 00:14:23,910
!ما هذا بالضّبط؟

212
00:14:23,910 --> 00:14:24,810
!مستحيل

213
00:14:25,420 --> 00:14:26,430
!ماذا حدث؟

214
00:14:26,980 --> 00:14:27,800
إنّه الميراج

215
00:14:27,800 --> 00:14:30,340
—أين؟! لنُجهّز سي-فيس

216
00:14:30,340 --> 00:14:31,060
هذا مستحيل

217
00:14:31,060 --> 00:14:32,660
!هذا ليس مستحيلاً

218
00:14:32,660 --> 00:14:35,270
—هُزِموا من قبل، لكن دافعهم ليس

219
00:14:35,270 --> 00:14:37,400
!المُشكلة ليست هنا

220
00:14:37,400 --> 00:14:39,060
ستّة مواقع في اليابان وحدها

221
00:14:39,060 --> 00:14:41,400
ثمانية وأربعون في كلّ أرجاء العالم

222
00:14:41,400 --> 00:14:45,860
هل تترشّح هذه الميراج في آن واحد الآن؟

223
00:14:46,120 --> 00:14:46,910
ما هذا؟

224
00:14:46,910 --> 00:14:48,290
أمطار غزيرة مُفاجئة؟

225
00:14:48,290 --> 00:14:51,410
هل للأمر علاقة بالكارثة في بناء
هارمونيا بالمُناسبة؟

226
00:14:51,410 --> 00:14:53,090
،لا سرعة ولا مدى التّرشيح

227
00:14:53,090 --> 00:14:55,170
لا شيء من القِيَم المُخمَّنة حتّى
!الآن نافعة هنا

228
00:14:58,130 --> 00:15:00,230
!بقي خمسة وثلاثون

229
00:15:00,230 --> 00:15:02,130
كيف حدث هذا؟

230
00:15:02,410 --> 00:15:05,010
لا بُدّ أنّ أبّولو اتّخذ قراره

231
00:15:05,010 --> 00:15:07,560
تقصدين بأنّه لم يكن جادّاً حتّى الآن؟

232
00:15:08,110 --> 00:15:11,720
يتطلّب ترشيح الميراج كثيراً من الإيديا

233
00:15:11,720 --> 00:15:14,390
إيديا بقيمة بضع ملايين من النّاس

234
00:15:14,870 --> 00:15:22,000
لا أستطيع حتّى تخيُّل مقدار الإيديا وأرواح
زينوس الّذين ضحّى بهم للقيام بهذا

235
00:15:26,530 --> 00:15:28,910
ستكون عمليّة عقيمة

236
00:15:29,930 --> 00:15:32,890
بعد السّماح لغزو سبعة وأربعين

237
00:15:32,890 --> 00:15:36,460
فما القيمة الإستراتيجيّة

238
00:15:39,750 --> 00:15:40,680
—كيف يمكنك أن

239
00:15:40,680 --> 00:15:43,460
لا، معها حقّ يا روي

240
00:15:43,460 --> 00:15:44,760
حضرة الرّئيسة؟

241
00:15:44,760 --> 00:15:46,760
لا أستطيع نشر سي-فيس الآن

242
00:15:47,090 --> 00:15:50,910
لاستعادة هذه البلاد الّتي
حاول أورفي حمايتها

243
00:15:56,470 --> 00:15:57,770
ميراج

244
00:15:58,710 --> 00:15:59,660
روي

245
00:16:02,390 --> 00:16:04,260
لم أحضر هاتفي

246
00:16:06,220 --> 00:16:09,980
إذاً سأضطرّ لفعلها من تلقاء نفسي

247
00:16:15,210 --> 00:16:17,450
توارى العالم عن الأنظار

248
00:16:17,450 --> 00:16:22,790
المس مرّة ولن تصحو من الكابوس أبداً

249
00:16:22,790 --> 00:16:26,090
الأيّام الّتي ابتُلِعتْ

250
00:16:26,090 --> 00:16:28,120
نسي الجميع

251
00:16:28,120 --> 00:16:33,160
ذِكراك. أنا أفيض بالسّيمفونيّات

252
00:16:33,470 --> 00:16:36,860
أطلق العنان

253
00:16:36,860 --> 00:16:41,230
مهما أمست الحقيقة مُبهَمة

254
00:16:41,510 --> 00:16:44,610
أريد حماية هذه الأُمنية الأبديّة

255
00:16:44,610 --> 00:16:46,250
بكلّ جزء من كياني

256
00:16:46,250 --> 00:16:47,190
دعه يصدح

257
00:16:47,190 --> 00:16:49,780
صوتي وصوتك

258
00:16:49,780 --> 00:16:52,020
حالما يتحوّلان إلى أغنية

259
00:16:52,020 --> 00:16:56,850
تتوحّد قلوبنا بفانتازيا مُتناغمة

260
00:16:56,090 --> 00:16:58,230
بئساً. ما هذا؟

261
00:16:56,850 --> 00:17:00,390
حتّى لو لم يأتِ يوم غد

262
00:16:58,920 --> 00:17:01,900
ألم يكن من المُفترَض أن أكون نجمة شهيرة؟

263
00:17:00,390 --> 00:17:02,500
بكلّ الأماني في قلبي

264
00:17:02,500 --> 00:17:08,470
سأقاتل في ميلوديا

265
00:17:03,840 --> 00:17:05,880
ليتك كنت هنا

266
00:17:07,690 --> 00:17:08,970
كيويا

267
00:17:15,400 --> 00:17:19,380
،لكسب إيديا 100 مليون من سكّان الأرض

268
00:17:19,380 --> 00:17:22,740
ضحّيت بإيديا 100 مليون من زينوس

269
00:17:23,150 --> 00:17:26,580
اخسر كلّ شيء أو اخسر 100 مليون

270
00:17:26,580 --> 00:17:29,200
لا بُدّ أن يتّخذ أحدٌ قراراً

271
00:17:29,200 --> 00:17:32,410
حسناً، أنا مُعجَب بحزمك

272
00:17:32,980 --> 00:17:38,140
لكن ألا تعتقد بأنّ ميولك لتحمّل
كلّ شيء بنفسك

273
00:17:38,140 --> 00:17:41,070
دون الاعتماد على أحد سبّبَ خللاً في ميديا؟

274
00:17:41,910 --> 00:17:45,900
بقي القليل منّا فقط، وبيننا خائن

275
00:17:45,900 --> 00:17:49,170
هذا من صنيع قائدنا المُوقَّر

276
00:17:49,170 --> 00:17:51,960
لا أبالي لكيفيّة تقييمك لي

277
00:17:51,960 --> 00:17:57,820
حالما يتمّ إحياء زينوس، أولئك الّذين تمّ استعادتهم
إلى الحياة يحقّ لهم أن يحكموا عليّ

278
00:17:58,570 --> 00:18:01,940
لا أنوي أن أشتكي

279
00:18:02,250 --> 00:18:08,190
لكن ألا يُحزنك أن تكون مكروهاً
بواسطة أولئك الّذين أنقذتهم؟

280
00:18:08,190 --> 00:18:11,530
ألهذا السّبب لم تقضِ على ميديا؟

281
00:18:12,530 --> 00:18:15,780
لا تتحمّل أن تُبغَض حتّى بواسطة خائن؟

282
00:18:16,790 --> 00:18:18,790
هل ستُطهّرني؟

283
00:18:18,790 --> 00:18:21,040
أستطيع فعل ذلك في أيّ وقت

284
00:18:21,340 --> 00:18:24,570
ما دمتَ تكشّر عن أنيابك أمام سكّان
الأرض، سأُبقيك حيّاً

285
00:18:27,460 --> 00:18:31,620
اسمعوا يا آدم ولوغوس وليليث

286
00:18:32,670 --> 00:18:38,220
هذا المكان أبرد من المكان الّذي
تنامون فيه غالباً

287
00:18:39,330 --> 00:18:42,060
لماذا أردتني؟

288
00:18:42,430 --> 00:18:46,030
الشّخص المدعو أبّولو قال
بأنّه غير مُهتمّ بي

289
00:18:46,530 --> 00:18:49,780
لكن قال بأنّك كنت تبحث عنّي

290
00:18:50,580 --> 00:18:54,100
،إن كنتِ من أقرباء إيدين-ساما

291
00:18:54,900 --> 00:19:00,310
،فارتأيتُ بأنّكِ إذا بقيتِ بجانبها
فقد لا تشعر بالوحدة

292
00:19:01,870 --> 00:19:04,330
لكنّني أشعر بالوحدة

293
00:19:05,330 --> 00:19:10,500
يُحزنني أن أكون بعيدة عن
الأشخاص الّذين أُحبّهم

294
00:19:11,440 --> 00:19:13,830
هكذا إذاً

295
00:19:16,210 --> 00:19:18,200
هل أنت...؟

296
00:19:18,730 --> 00:19:22,500
...كاهنها، أمينها، و

297
00:19:24,220 --> 00:19:26,770
هل تشعر بالوحدة؟

298
00:19:27,760 --> 00:19:31,770
ليست وحدة أقلّ ممّا تشعرين به الآن

299
00:19:32,230 --> 00:19:33,830
،مهما مضى من سنوات

300
00:19:33,830 --> 00:19:36,800
أقسم بأنّ وحدتكِ لن تصل لمستوى وحدتي

301
00:19:39,880 --> 00:19:44,450
،لكن أن يصدر هذا الكلام عنّي أنا
،الّذي سرق كلّ شيء منكِ

302
00:19:44,450 --> 00:19:47,290
فقد يكون من الصّعب تقبُّل ذلك

303
00:19:48,490 --> 00:19:50,700
ماذا سيحلّ بي؟

304
00:19:51,290 --> 00:19:53,920
ماذا سيحلّ بالأرض؟

305
00:19:55,790 --> 00:20:00,510
السّيّد أبّولو لا يفكّر سوى بإنقاذ زينوس

306
00:20:00,510 --> 00:20:03,920
سيُضحّي بكلّ شيء آخر

307
00:20:04,420 --> 00:20:07,800
،الأرض، والنّاس الّذين يعيشون هناك

308
00:20:08,190 --> 00:20:11,940
...قلب لحُبّ الآخرين، و

309
00:20:12,250 --> 00:20:14,530
كيف أمنعه؟

310
00:20:14,980 --> 00:20:20,530
،إذا كان يمكن إنقاذ الأرض وزينوس معاً
فهل ستدعني أرى كيويا ثانية؟

311
00:20:21,110 --> 00:20:22,950
أهذا ما أنتِ...؟

312
00:20:23,260 --> 00:20:24,870
تفهمني، صحيح؟

313
00:20:25,270 --> 00:20:28,710
تفهم وحدتي، أليس كذلك؟

314
00:20:31,220 --> 00:20:33,840
،إن كانت أُمنيتكِ شديدة بما يكفي

315
00:20:34,300 --> 00:20:39,470
إذا كانت أُمنيتكِ لإنقاذ كلّ شيء
...تستدعي مُعجزة

316
00:20:39,860 --> 00:20:41,300
لكن كيف؟

317
00:20:42,150 --> 00:20:43,750
اتبعيني

318
00:20:44,840 --> 00:20:48,830
إنّ 0.02% من سطح الأرض قد اختفى

319
00:20:48,830 --> 00:20:51,230
وعدد السّكّان أسوأ حتّى

320
00:20:51,230 --> 00:20:53,700
نسبة 3% من السّكّان قد اختفوا

321
00:20:53,700 --> 00:20:56,120
أكثر من 100 مليون شخص قد اختفوا

322
00:20:57,080 --> 00:20:58,430
!هذا مستحيل

323
00:20:58,430 --> 00:21:01,900
لكن... لكن لم يلحظ أحدٌ ذلك

324
00:21:02,310 --> 00:21:06,240
لم يرَ العالم نفس كابوسنا

325
00:21:06,530 --> 00:21:07,950
أنتِ

326
00:21:07,950 --> 00:21:10,900
قلتِ بأنّكِ ستتعاونين معنا

327
00:21:10,900 --> 00:21:13,500
إذاً أعيدي الأشخاص الّذين اختفوا

328
00:21:14,260 --> 00:21:17,340
!استرجعي الأرض

329
00:21:17,640 --> 00:21:18,720
هاياما-كن

330
00:21:19,590 --> 00:21:23,850
هل أُمنيتك هي رؤيتي أبكي والاعتذار؟

331
00:21:23,850 --> 00:21:29,040
تُنفّس عن غضبك برؤيتي أتألّم حسرة وندماً

332
00:21:29,580 --> 00:21:32,230
أهذا ما تريد؟

333
00:21:32,500 --> 00:21:37,500
ما نريده هو معرفتكِ ومهاراتكِ كزينوس

334
00:21:38,320 --> 00:21:40,420
أخبرينا يا ميديا

335
00:21:40,420 --> 00:21:42,240
ما الّذي تستطيعين فعله؟

336
00:21:42,810 --> 00:21:45,030
ما الّذي نستطيع فعله؟

337
00:21:48,270 --> 00:21:51,750
سأستدعي سي-فيس إلى مسرح خاصّ

338
00:21:52,060 --> 00:21:57,660
وستُقيمون حفلاً غنائيّاً حيّاً يشمل
العالمَ كُلّه في ذلك المسرح

339
00:21:58,100 --> 00:22:00,880
حفل حيّ؟ أين؟

340
00:22:01,870 --> 00:22:04,010
...في عالمنا الأُمّ

341
00:22:05,040 --> 00:22:07,640
حيث ينام سكّان زينوس