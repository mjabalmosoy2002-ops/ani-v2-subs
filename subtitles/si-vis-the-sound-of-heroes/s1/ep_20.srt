1
00:00:08,500 --> 00:00:10,700
هل أنا... حيّة؟

2
00:00:12,550 --> 00:00:13,990
كيويا؟

3
00:00:17,910 --> 00:00:19,170
!سيرين

4
00:00:20,310 --> 00:00:25,040
عُثِر عليكِ بالقرب من شينجوكو، الّتي اختفت

5
00:00:25,040 --> 00:00:26,760
صحيح

6
00:00:27,100 --> 00:00:30,010
انقضضتِ نحو الميراج، أليس كذلك؟

7
00:00:30,670 --> 00:00:32,640
لتحاولي مُقارعته بمفردكِ

8
00:00:35,880 --> 00:00:39,020
يبدو أنّني حيّة بطريقة ما

9
00:00:39,410 --> 00:00:41,770
!لِمَ تفعلين شيئاً بهذه الخطورة؟

10
00:00:42,090 --> 00:00:45,020
!مُحال أن تتمكّني من إيقاف الميراج هكذا

11
00:00:45,300 --> 00:00:47,530
!ألا تفهمين الوضع الّذي أنتِ فيه؟

12
00:02:24,870 --> 00:02:26,110
جيّد

13
00:02:26,110 --> 00:02:28,590
والآن نحن مُتّصلون بالخوادم حول العالم

14
00:02:33,740 --> 00:02:37,600
تتشكّل دموع إيديا في كلّ أرجاء العالم الآن

15
00:02:38,150 --> 00:02:42,500
كلّ شيء اختفى من هذا العالم
...كما لو أنّه لم يكن موجوداً

16
00:02:42,500 --> 00:02:46,600
المعلومات عنها سوف تتناثر من تلك
من تلك الدّموع وتغمر العالم

17
00:02:47,150 --> 00:02:51,610
والآن يعزو الأمر كلّه إلى كيفيّة تلقّي
النّاس لتلك المعلومات

18
00:02:51,610 --> 00:02:53,650
نؤمن بها ونُسبّب هلعاً

19
00:02:53,650 --> 00:02:57,360
أو نعتبرها نظريّة مُؤامرة ويتمّ غزونا

20
00:02:57,830 --> 00:02:59,810
النّتيجة جحيميّة في الحالتين

21
00:02:59,810 --> 00:03:01,870
لا يوجد ما هو أكثر حماساً من هذا

22
00:03:02,550 --> 00:03:08,580
هل يمكننا... هل يمكننا حقّاً الوثوق بميديا-سان؟

23
00:03:09,120 --> 00:03:14,680
اتّبعنا حكمها، فكدنا نخسر سيرين-سان

24
00:03:15,150 --> 00:03:21,850
رمتْ بنفسها نحو الميراج وهي
على علم بماهيّته

25
00:03:21,850 --> 00:03:26,850
ألا يُدعى هذا "انتحار" بلغة الأرض؟

26
00:03:26,850 --> 00:03:32,360
تلك الحمقاء قد تألّقتْ كثيراً في نُواة
!الميراج مرّات كثيرة من قبل

27
00:03:32,610 --> 00:03:37,360
أغنيتها أنقذَتِ العالمَ مهما
!كان الوضع مُتأزّماً

28
00:03:37,360 --> 00:03:40,370
إلى أن هزمها لوكوس

29
00:03:40,650 --> 00:03:43,780
كان ينبغي أن تحموها

30
00:03:43,780 --> 00:03:48,230
ما كان ينبغي أن تمنحوها الحرّية
بسبب قوّتها السّابقة

31
00:03:48,230 --> 00:03:55,590
لكن أتفهّم بأنّ ما حدث قد أضرّ بثقتك بي

32
00:03:56,050 --> 00:04:00,270
إن كنتِ لا ترجين هذا، فلنوقف هذه الخطّة

33
00:04:00,270 --> 00:04:01,850
سنمضي قُدماً بالخطّة

34
00:04:02,430 --> 00:04:07,350
سوف يتوحّد العالم، حتّى ولو سبّبَ
ذلك هلعاً غير مسبوق

35
00:04:10,100 --> 00:04:13,360
تغيّر كلُّ شيء بين ليلة وضُحاها

36
00:04:13,360 --> 00:04:16,380
سنحصل على ردّة فعل غاضبة
من كلّ أنحاء العالم

37
00:04:16,380 --> 00:04:19,860
أتمنّى لو أنّ إطلالتنا الأولى حول العالم
كانت أكثر إيجابيّة

38
00:04:19,860 --> 00:04:22,900
هكذا هو الوضع حاليّاً

39
00:04:22,900 --> 00:04:27,400
حقيقة قاسية كهذه من الصّعب تقبّلها

40
00:04:28,160 --> 00:04:32,640
لكن كما توقّعت ميديا-سان، بدأت
الدّموع تتشكّل

41
00:04:33,630 --> 00:04:34,890
!رأيتُ ذلك

42
00:04:34,890 --> 00:04:36,760
!بلدتي، وعائلتي، كلّها اختفت

43
00:04:36,760 --> 00:04:38,920
!أمام أنظاري

44
00:04:38,920 --> 00:04:41,760
!ذلك المقطع من اليابان لم يكن مُزيّفاً

45
00:04:42,150 --> 00:04:45,760
ذهبَ إلى عالم الكوابيس أيضاً

46
00:04:46,070 --> 00:04:52,170
من هنا فصاعداً، سيترتّب على الجميع
في الأرض اختيار كيفيّة مُواجهة زينوس

47
00:04:54,770 --> 00:04:55,660
مرحباً

48
00:04:56,230 --> 00:04:57,230
لم أركم منذ وقت طويل

49
00:04:57,230 --> 00:04:59,290
كيويا-كن؟ سوجي-كن؟

50
00:05:02,740 --> 00:05:05,150
نعلم كيف نتعامل مع الصّحافة

51
00:05:03,060 --> 00:05:05,450
!رِفاق! أغلقوا النّوافذ والسّتائر

52
00:05:07,200 --> 00:05:13,000
بالتّالي، سنغادر الأرض ونتوجّه
إلى معقل زينوس

53
00:05:13,550 --> 00:05:17,960
سوف نسحقهم بأدائنا وندعهم
!يعودون إلى رشدهم

54
00:05:18,590 --> 00:05:20,500
لا أعلم ما إن كنّا سنعود أحياء

55
00:05:20,920 --> 00:05:24,930
قد تكون هذه آخر مُحادثة نجريها

56
00:05:25,480 --> 00:05:28,560
...لكن أنا سوف... سي-فيس سوف

57
00:05:28,560 --> 00:05:30,890
ألم تتعلّم معنى الاسترخاء؟

58
00:05:30,890 --> 00:05:31,780
ماذا؟

59
00:05:31,780 --> 00:05:33,780
تبدو كرئيس لجنة

60
00:05:33,780 --> 00:05:35,380
أو أسوأ، كمُعلّم

61
00:05:35,380 --> 00:05:35,900
ماذا؟

62
00:05:40,260 --> 00:05:41,910
ماذا؟

63
00:05:41,910 --> 00:05:43,450
أليس كذلك؟

64
00:05:43,450 --> 00:05:47,280
أصرَّ على أنّ يلقي الخطاب، لذا
سمحتُ له، وهذا ما حصلنا عليه

65
00:05:47,280 --> 00:05:51,180
!كلامك عاطفيّ زيادة عن اللّزوم ولا أساس له

66
00:05:51,180 --> 00:05:52,520
معك حقّ

67
00:05:52,520 --> 00:05:55,320
سيكون التّحالف بيني وبينك مثاليّاً

68
00:05:56,690 --> 00:05:59,170
إذاً أكمل الخطاب أنت

69
00:05:59,170 --> 00:05:59,920
حسناً

70
00:06:00,670 --> 00:06:04,390
لذا هذا يعني بأنّنا سنودّعكم لمدّة من الزّمن

71
00:06:04,720 --> 00:06:06,840
كنّا نقاتل وأرواحنا على كفّنا حتّى الآن

72
00:06:07,280 --> 00:06:11,390
صحيح أنّني استمتعتُ بذلك، لكن
كنتُ خائفاً أيضاً

73
00:06:12,320 --> 00:06:17,170
لذا أعتقد بأنّني أحتاج فقط للقيام بهذه
الجولة كما الآخرين جميعهم

74
00:06:17,170 --> 00:06:21,800
لكن ما زلتُ أشعر بأنّني سأُسحَق بواسطة
خوف لم يراودني من قبل

75
00:06:22,790 --> 00:06:28,510
لأنّ الشّخص الّذي أُحبّه، والنّاس الّذين
أُحبّهم، يعتمدون عليّ لحمايتهم

76
00:06:29,570 --> 00:06:31,960
لا، هذا ليس كلّ شيء

77
00:06:32,790 --> 00:06:37,130
أريد إنقاذ أولئك الّذين لم ألتقِ بهم بعد

78
00:06:40,810 --> 00:06:44,300
...لأنّ ميديا-سان أظهرَ لي

79
00:06:44,760 --> 00:06:46,800
ما كان يوسكي-كن يحاول فعله

80
00:06:47,230 --> 00:06:49,480
أمنيته الكبرى لشعب الأرض

81
00:06:49,810 --> 00:06:52,770
أن يغنّي الجميع ويرقصوا ويضحكوا معاً

82
00:06:53,770 --> 00:06:56,990
المُستقبل حيث ينسجم سكّان
الأرض وزينوس مع بعضهم الآخر

83
00:06:56,990 --> 00:06:58,980
المُستقبل الّذي حلمَ به يوسكي-كن

84
00:06:59,520 --> 00:07:01,590
لن أتخلّى عنه حتّى الرّمق الأخير

85
00:07:02,910 --> 00:07:04,350
هكذا إذاً

86
00:07:05,920 --> 00:07:11,620
لا بُدّ أنّ يوسكي-كن هذا مُميّزاً
جدّاً بالنّسبة لك يا كيويا

87
00:07:15,890 --> 00:07:17,080
هذا صحيح

88
00:07:17,710 --> 00:07:19,960
لذا عليّ الذّهاب يا جدّة

89
00:07:21,250 --> 00:07:23,930
!كينجي، يوشيكازو، وساتومي

90
00:07:25,390 --> 00:07:28,890
قد يكون الجوّ بارداً هناك

91
00:07:29,240 --> 00:07:31,110
لا تنسَ أن تحضر كنزتك

92
00:07:31,390 --> 00:07:32,780
حـ-حسناً

93
00:07:32,780 --> 00:07:34,660
لا تقلقي يا جدّة

94
00:07:34,660 --> 00:07:36,440
سأحرص على أن يفعل ذلك

95
00:07:36,440 --> 00:07:38,920
أعتمد عليك يا سوجي-كن

96
00:07:38,920 --> 00:07:42,100
لطالما كان هذا الفتى ينام وبطنه مكشوف

97
00:07:43,190 --> 00:07:45,150
!سأغلق الخطّ يا جدّتي

98
00:08:06,790 --> 00:08:09,390
آسف جميعاً. يمكنكم أن تسبقوني

99
00:08:21,090 --> 00:08:24,510
هل أنت جاهز للذّهاب يا كيويا؟

100
00:08:24,510 --> 00:08:25,700
سيرين

101
00:08:25,700 --> 00:08:30,150
لنُرِ زينوس مدى روعة أداء سي-فيس

102
00:08:30,150 --> 00:08:31,270
سيرين

103
00:08:31,270 --> 00:08:33,950
—عندما تعود ناغي، يمكننا جميعاً

104
00:08:33,950 --> 00:08:35,200
!سيرين

105
00:08:35,910 --> 00:08:38,010
أتتذكّرين ما قالته ميديا-سان؟

106
00:08:38,010 --> 00:08:41,920
الإيديا خاصّتكِ لا يمكن إعادتها إلى وضعها
الطّبيعيّ بالقوّة البشريّة

107
00:08:42,580 --> 00:08:48,220
كانت لعنة قويّة أطلقتها زينوس مُقابل حياتها

108
00:08:48,500 --> 00:08:51,990
إنّها لا تؤثّر بي

109
00:08:57,860 --> 00:08:59,370
لا يروقني هذا

110
00:09:02,060 --> 00:09:03,720
لا تتركني هنا

111
00:09:09,150 --> 00:09:10,510
!لن أترككِ

112
00:09:10,510 --> 00:09:16,200
سوف نتصالح مع زينوس، ونسألهم
عن كيفيّة إعادتكِ إلى طبيعتكِ ثمّ نعود

113
00:09:16,940 --> 00:09:19,750
لذا انتظري حتّى ذلك الحين رجاء

114
00:09:19,750 --> 00:09:22,920
شجّعينا من هنا

115
00:09:24,190 --> 00:09:26,740
هل تعلم مدى  قسوة ذلك؟

116
00:09:27,710 --> 00:09:31,760
وُلِدتُ لأغنّي فقط، لا شيء آخر

117
00:09:32,620 --> 00:09:36,320
لم أُولَد لأحسد غناء الآخرين

118
00:09:38,680 --> 00:09:40,340
لا أُبالي إذا اختفيتُ

119
00:09:41,400 --> 00:09:43,870
قد تكون هذه هي نهايتي

120
00:09:43,870 --> 00:09:45,180
—ما زلتُ أريد أن

121
00:09:45,180 --> 00:09:46,060
!لا

122
00:09:46,650 --> 00:09:49,190
!لا أريد عالماً من دونك يا سيرين

123
00:09:50,150 --> 00:09:54,360
!أفعل هذا لحماية العالم الّذي أنتِ فيه

124
00:09:58,120 --> 00:10:03,160
أنتِ وناغي والجميع في سي-فيس، الجميع
...في هارمونيا، أصدقائي والعائلة

125
00:10:03,620 --> 00:10:07,910
سأذهب، وذلك كي أتمكّن من حماية هذا
!العالم حيث يعيش مَن أُحبّهم

126
00:10:10,180 --> 00:10:12,720
أنا مُمتنّة لذلك

127
00:10:13,940 --> 00:10:22,800
لكن مهما حدث لي أو مهما كانت
النّتائج الّتي نحظى بها، سأغنّي

128
00:10:24,240 --> 00:10:29,830
لا يستطيع أحدٌ إيقاف غنائي

129
00:10:32,900 --> 00:10:34,320
أعلم

130
00:10:35,030 --> 00:10:37,850
...أريد أن أسمع غناءكِ

131
00:10:40,220 --> 00:10:44,090
مرّة أُخرى أيضاً

132
00:11:10,680 --> 00:11:16,780
عُد ومعك ناغي مهما كلّف الأمر، مفهوم؟

133
00:11:24,830 --> 00:11:27,330
شكراً لك على الغلاف يا نائب الرّئيس

134
00:11:27,330 --> 00:11:30,630
،إذا كان يمكن أن يكون حِلية جالبة للحظّ
فلا شكر على واجب

135
00:11:30,630 --> 00:11:32,130
عُد على قيد الحياة

136
00:11:32,430 --> 00:11:33,460
!حسناً

137
00:11:33,460 --> 00:11:36,410
هل كان صيفاً في آخر مرّة أتينا
فيها إلى جزيرة تاتيكاشي؟

138
00:11:36,410 --> 00:11:39,230
أشعر وكأنّه مضى وقت طويل

139
00:11:39,230 --> 00:11:42,360
هذا لأنّه حدثت أمور كثيرة منذ ذلك الحين

140
00:11:45,850 --> 00:11:49,460
هذه الجزيرة مُتّصلة بكوكب زينوس؟

141
00:11:49,460 --> 00:11:56,180
عندما هرب أورفي إلى الأرض، استخدمَ
ميتيس لربط هذا المكان بزينوس

142
00:11:56,180 --> 00:11:58,320
باب في مكان عشوائيّ؟

143
00:11:58,830 --> 00:12:04,330
إنّها القوّة الّتي منحنا إيّاها آركون-ساما
للاستحواذ على الأرض

144
00:12:04,970 --> 00:12:08,010
استخدمها أورفي بطريقة مُعاكسة تماماً

145
00:12:08,590 --> 00:12:13,770
...ختمَ سامايل على البوّابة الّتي أنشأتُها، لكن هنا

146
00:12:16,670 --> 00:12:20,570
هذه البوّابة تسمح للمرء بتوفير الإيديا عن بُعد

147
00:12:21,350 --> 00:12:24,100
حتّى لو غادرت هذا الكوكب

148
00:12:24,770 --> 00:12:29,100
لكن لن يكون بمثل قوّة حفلاتكم الغنائيّة
الحيّة، لذا توخّوا الحذر

149
00:12:29,790 --> 00:12:34,570
يؤدّي هذا الطّريق إلى كوكب زينوس

150
00:12:35,060 --> 00:12:37,750
،لعلّه بقي القليل منّا فقط

151
00:12:37,750 --> 00:12:43,010
،لكن أبّولو، الّذي هزمكم بمفرده
ينتظركم في النّهاية

152
00:12:43,620 --> 00:12:44,620
—هل ما زلتم

153
00:12:44,620 --> 00:12:46,460
سنذهب بالطّبع

154
00:12:46,460 --> 00:12:50,120
،هذا هو ما سعيتِ أنتِ وزينوس آخرون
،والأهمّ من كلّ ذلك

155
00:12:50,530 --> 00:12:53,630
يوسكي-كن لتحقيقه قبل أكثر من عشر سنوات

156
00:13:01,340 --> 00:13:03,500
اتبعوني جميعكم

157
00:13:07,590 --> 00:13:10,510
أتعتقدون بأنّني سأدعكم تذهبون هكذا فحسب؟

158
00:13:13,190 --> 00:13:14,390
كريوس

159
00:13:15,260 --> 00:13:18,070
مضى وقت طويل يا جون

160
00:13:18,920 --> 00:13:21,990
ستذهب إلى كوكبنا، أليس كذلك؟

161
00:13:21,990 --> 00:13:26,580
سوف تُدمّرنا قبل أن نأخذ الأرض منكم

162
00:13:26,580 --> 00:13:29,580
—كريوس، اسمعني. نحن

163
00:13:29,580 --> 00:13:31,080
لا جدوى

164
00:13:31,080 --> 00:13:33,490
صوتك لن يصل كريوس

165
00:13:33,490 --> 00:13:35,260
!هذا غير صحيح

166
00:13:35,260 --> 00:13:36,090
...إنّ كريوس

167
00:13:36,590 --> 00:13:42,160
إنّه ألطف من الجميع. إنّه الطّفل الأخير
الأنقى والأكثر براءة من زينوس

168
00:13:42,160 --> 00:13:45,460
حادَ عن الطّريق قليلاً. هذا كلّ ما في الأمر

169
00:13:45,890 --> 00:13:47,150
—إذا تكلّمتُ معه

170
00:13:47,150 --> 00:13:49,590
لا تكمن المُشكلة هنا يا ميديا-سان

171
00:13:51,140 --> 00:13:53,590
إنّه لا يكرهكِ

172
00:13:53,990 --> 00:13:57,640
لهذا صوتكِ لا يصله

173
00:13:57,640 --> 00:13:58,440
ماذا؟

174
00:13:58,860 --> 00:14:03,120
الكلمات الوحيدة الّتي تصله هي
كلمات الشّخص الّذي يكرهه

175
00:14:03,790 --> 00:14:06,820
كلماتي فقط

176
00:14:07,890 --> 00:14:09,350
أجل، لا مُشكلة

177
00:14:09,960 --> 00:14:13,780
كلّ ما أريده هو الانتقام من جون

178
00:14:14,890 --> 00:14:17,530
كيويا-كن، سمعتني

179
00:14:17,530 --> 00:14:19,140
اسبقوني من فضلكم

180
00:14:19,140 --> 00:14:20,130
جون-كن

181
00:14:20,510 --> 00:14:24,760
هذا ثأر لا يحقّ لغيري مُواجهته

182
00:14:25,930 --> 00:14:28,710
يجب أن تنضمّ لاحقاً يا جون-كن

183
00:14:29,230 --> 00:14:31,020
مع كريوس إن أمكن

184
00:14:33,410 --> 00:14:37,270
أنت بائس، ومع ذلك أنانيّ جدّاً يا كيويا-كن

185
00:14:37,270 --> 00:14:38,110
...ما

186
00:14:38,110 --> 00:14:41,410
توقّف يا جون. لا تتفوّه بالحقيقة

187
00:14:41,410 --> 00:14:44,400
أحياناً الحقيقة تجرح النّاس

188
00:14:47,410 --> 00:14:50,770
حسناً إذاً. ميديا-سان، قودينا من فضلكِ

189
00:14:50,770 --> 00:14:53,910
—لكن من دوني، لا يستطيع فتح هذه البوّابة

190
00:14:53,910 --> 00:14:57,170
ألم أقلها؟ كريوس سوف يُساعده

191
00:15:03,140 --> 00:15:04,490
أنا أؤمن بك

192
00:15:06,180 --> 00:15:07,290
!كريوس

193
00:15:17,000 --> 00:15:18,800
مسرح؟

194
00:15:18,800 --> 00:15:23,700
إنّها المكان حيث منحتْ إيدين-ساما
البرَكة لشعب زينوس

195
00:15:23,700 --> 00:15:30,610
غنّتِ النّجمةُ لحنَ البرَكة واستمرّتْ
في توفير إيديا للشّعب

196
00:15:31,600 --> 00:15:35,880
من هذا المكان إلى الكوكب بأسرِه، لكلّ شخص

197
00:15:36,400 --> 00:15:42,160
إلى ما خلف الزّمان والمكان، ولأجيال
سبقتْ إيدين-ساما

198
00:15:43,160 --> 00:15:46,210
لكنّها قوطِعَتْ؟

199
00:15:46,210 --> 00:15:48,390
كان السّبب مجهولاً

200
00:15:48,910 --> 00:15:53,720
هل بدأت إيديا النّجوم تُستنزَف أم أنّ
دم النّجمة قد خفّ؟

201
00:15:54,250 --> 00:15:59,730
أم أنّ جسد إيدين-ساما أُنهِكَ تماماً؟

202
00:16:01,630 --> 00:16:04,950
هذا هو مسرح النّجمة

203
00:16:04,950 --> 00:16:10,740
المكان المُقدّس لمنح بركات
لزينوس، للنّاس

204
00:16:11,790 --> 00:16:13,240
في هذا المكان

205
00:16:20,510 --> 00:16:23,190
هل كانت تلك إيدين-ساما؟

206
00:16:24,150 --> 00:16:27,440
النّجمة الّتي في دمي

207
00:16:41,640 --> 00:16:44,700
إنّها هي

208
00:16:45,990 --> 00:16:48,900
هذه هي أمّي

209
00:16:50,120 --> 00:16:52,870
إيدين-ساما

210
00:17:00,510 --> 00:17:02,460
أخيراً، حان وقت الانتقام

211
00:17:03,000 --> 00:17:04,640
أنت لأجل جونّي

212
00:17:04,640 --> 00:17:06,970
وأنا لأجل لوكوس

213
00:17:07,990 --> 00:17:09,610
ما هي القاعدة؟

214
00:17:09,610 --> 00:17:12,140
هل تريدنا أن نقتل بعضنا الآخر؟
نضرب بعضنا الآخر؟

215
00:17:12,140 --> 00:17:15,090
أم... تريد أن تغنّي؟

216
00:17:16,590 --> 00:17:18,180
قواعد؟

217
00:17:19,100 --> 00:17:20,140
!لا أحتاج شيئاً كهذا

218
00:17:21,190 --> 00:17:24,440
!يتوجّه العالم نحو ما نريد

219
00:17:24,440 --> 00:17:26,980
زينوس وسكّان الأرض يكرهون بعضهم الآخر

220
00:17:26,980 --> 00:17:29,560
ويسحقون بعضهم للحفاظ على بقائهم

221
00:17:29,560 --> 00:17:31,490
!لا شيء يستطيع منع هذا

222
00:17:32,800 --> 00:17:33,940
هذا غير صحيح

223
00:17:33,940 --> 00:17:36,240
هذا ليس الاتّجاه الّذي أريده

224
00:17:36,240 --> 00:17:38,790
!وليس الاتّجاه الّذي تريده أيضاً

225
00:17:38,790 --> 00:17:40,330
!لكنّك أوقفتني

226
00:17:40,750 --> 00:17:44,380
!آنذاك، أبديتَ كرهاً تجاهي

227
00:17:44,380 --> 00:17:49,380
!حدّدتُ مكانك أخيراً، وفهمتُ شعورك

228
00:17:49,660 --> 00:17:53,590
!فلماذا تنكر مشاعري إذاً؟

229
00:17:56,210 --> 00:17:57,840
نحن مُتشابهان يا كريوس

230
00:17:58,300 --> 00:18:01,640
أنت مَن كنتُ عليه آنذاك

231
00:18:02,060 --> 00:18:04,700
الوحدة والحزن والإحباط

232
00:18:04,700 --> 00:18:09,320
كلّها تحوّلتْ إلى كره وخرجت عن السّيطرة

233
00:18:09,670 --> 00:18:14,200
في الواقع، لا يزال ذلك الكره يستقرّ في داخلي

234
00:18:14,200 --> 00:18:15,460
دعني

235
00:18:15,460 --> 00:18:19,080
لكن مع ذلك، أنا... نحن نختار الغناء

236
00:18:20,990 --> 00:18:25,930
عن عائلاتنا وأصدقائنا وعن الأشخاص
!العزيزين على قلوبنا

237
00:18:25,930 --> 00:18:27,790
!أفلتني

238
00:18:27,790 --> 00:18:29,800
!لا، ليس هُم فقط

239
00:18:30,240 --> 00:18:31,820
!الأشخاص الّذين ليسوا من العائلة

240
00:18:31,820 --> 00:18:33,700
!ليسوا من الأصدقاء

241
00:18:33,700 --> 00:18:35,980
!حتى أولئك الّذين كرهتُهم

242
00:18:36,760 --> 00:18:40,010
لأنّنا يوماً ما، سنفهم بعضنا الآخر

243
00:18:40,550 --> 00:18:43,190
قد لا يحدث هذا الآن

244
00:18:43,190 --> 00:18:46,270
لعلّ الطّريق ما زال طويلاً

245
00:18:46,580 --> 00:18:48,270
تـ-توقّف

246
00:18:48,270 --> 00:18:51,570
...لكن في نهاية المطاف، من المُؤكَّد

247
00:18:51,570 --> 00:18:53,120
توقّف

248
00:18:53,910 --> 00:18:55,990
!أغنية سي-فيس سوف تُحقّق ذلك

249
00:18:57,220 --> 00:19:02,080
!توقّف

250
00:19:19,040 --> 00:19:23,100
لماذا؟ لماذا لم تُراوغ؟

251
00:19:24,120 --> 00:19:27,880
هل كنت ستدعني أقتلك؟

252
00:19:29,000 --> 00:19:34,280
أهذه طريقتك في التّعويض عن خطاياك؟

253
00:19:36,170 --> 00:19:41,120
لا، آمنتُ بذلك

254
00:19:41,980 --> 00:19:44,660
آمنتَ بماذا؟

255
00:19:46,570 --> 00:19:50,630
لطفك

256
00:19:53,030 --> 00:19:56,590
ما رأيتُه لم يكن وهماً

257
00:19:58,060 --> 00:20:01,250
لم يكن افتراضاً اختلقتُه

258
00:20:04,060 --> 00:20:08,890
كنت في الواقع أنت من أنقذنا

259
00:20:10,340 --> 00:20:12,900
شكراً لك يا كريوس

260
00:20:13,350 --> 00:20:18,950
بفضلك، نجت الأرض وسكّانها

261
00:20:28,470 --> 00:20:31,790
لماذا؟ لماذا فعلتُ ذلك؟

262
00:20:31,790 --> 00:20:36,460
...أنتم... أنتم من مسحتم لوكوس، ومع ذلك

263
00:20:36,460 --> 00:20:40,820
أجل. وكنتم أنتم من مسح جونّي

264
00:20:41,730 --> 00:20:44,980
لذا كان من الممكن أن يكون هناك
مُستقبلاً حيث نقتل بعضنا الآخر

265
00:20:45,560 --> 00:20:47,630
أو مُستقبلاً حيث نكره بعضنا الآخر

266
00:20:48,340 --> 00:20:51,530
لكن لم تنتهِ الأمور بهذا الشّكل

267
00:20:52,100 --> 00:20:54,300
ألا يُجيب هذا عن السّؤال؟

268
00:20:57,010 --> 00:20:59,510
لنعِش معاً يا كريوس

269
00:21:00,190 --> 00:21:04,080
نحن الاثنان معاً، لأجل جونّي ولوكوس

270
00:21:16,990 --> 00:21:20,320
...بالطّبع. لم تكن هناك وسيلة

271
00:21:22,440 --> 00:21:25,470
كان بوسعي قتلك

272
00:21:27,230 --> 00:21:31,230
لم أتركك حتّى لتلقى حتفك

273
00:21:57,930 --> 00:22:01,760
يوسكي-كن، أنا ذاهب إلى ديارك

274
00:22:03,550 --> 00:22:08,770
إلى الكوكب الّذي حاولت إنقاذه مع الأرض