596
00:33:20,050 --> 00:33:23,990
وأنتم كذلك , عليكم قضاء هذه الليلة في القصر

597
00:33:24,060 --> 00:33:25,450
حمدًا لله

598
00:33:25,560 --> 00:33:29,290
هل من المُمكن أن تُطلعنا عن إسمك ؟

599
00:33:29,390 --> 00:33:33,490
أنا هارون الرشيد

600
00:33:33,570 --> 00:33:37,830
إذن , أنتَ الخليفة هارون الرشيد ؟

601
00:33:37,970 --> 00:33:40,400
لنتحرك

602
00:34:00,730 --> 00:34:03,420
هل إستطعتم النوم ليلة الأمس ؟

603
00:34:03,560 --> 00:34:07,700
نشكركَ كثيرًا على إنقاذنا من الخطر الذي كُنّا به

604
00:34:07,800 --> 00:34:10,770
كان لكم الفضل أيضًا

605
00:34:10,900 --> 00:34:13,740
فقد قبضنا غلى قاطعي الطريق بفضلكم

606
00:34:13,870 --> 00:34:16,600
بالمناسبة , من أيّ بلدٍ قدمتم ؟

607
00:34:16,710 --> 00:34:20,740
أنا تاجرٌ من اليابان
وأُدعى أبو دورا

608
00:34:20,880 --> 00:34:22,900
وهذا معاوني علي

609
00:34:23,010 --> 00:34:23,540
علي ؟

610
00:34:23,620 --> 00:34:25,010
صحيح , أُدعى علي

611
00:34:25,120 --> 00:34:29,450
وهذين الإثنين هما عبدين عندي
حسّان وكوما - سان

612
00:34:25,120 --> 00:34:29,450
كوما - سان تعني حيوان الدب

613
00:34:29,550 --> 00:34:31,040
أيها الوغد

614
00:34:31,120 --> 00:34:31,950
!اليابان ؟

615
00:34:32,060 --> 00:34:33,990
لم أسمع بهذه الدولة من قبل

616
00:34:34,090 --> 00:34:38,290
انها تقع قُرب الصين والهند
وهي تتجه إلى جِهة الشرق قريبًا

617
00:34:38,430 --> 00:34:39,330
! اوه

618
00:34:39,460 --> 00:34:41,690
انها أبعدُ حتى من الصين

619
00:34:41,800 --> 00:34:44,790
لقد قدمتم من بلادٍ بعيدة للغاية
ما الذي تَصبون إليه ؟

620
00:34:44,940 --> 00:34:48,300
في الحقيقة , أتينا إلى هنا بحثًا عن هذه الفتاة

621
00:34:50,410 --> 00:34:53,710
في أثناء حُلمي رأيتها على متنِ سفينة العبيد

622
00:34:53,810 --> 00:34:54,940
سفينة العبيد ؟

623
00:34:55,050 --> 00:34:56,170
حسنًا , هذا أمرٌ خطير

624
00:34:56,280 --> 00:35:00,500
عند نهر دجلة , يتواجد مرفأ لتوقف السفن

625
00:35:00,500 --> 00:35:02,300
وهو مرفأ البَصرة

626
00:35:00,500 --> 00:35:02,300
البصرة: هي مدينة تقع جنوب العراق وتتميز بأنها مركز اقتصادي هام

627
00:35:02,400 --> 00:35:05,250
إن ذهبنا هناك , بإمكاننا أن نجد بعض الأدلّة

628
00:35:05,360 --> 00:35:07,590
لنذهب ونحاول

629
00:35:07,660 --> 00:35:11,000
سوف أقوم بمنحكم توقيع الخليفة

630
00:35:11,000 --> 00:35:13,790
سوف يكون عونًا لكم فيما بعد

631
00:35:13,930 --> 00:35:17,100
سيدي الخليفة , أشكرك كثيرًا

632
00:35:52,400 --> 00:35:53,800
مرحبًا ... مرحبًا

633
00:35:53,910 --> 00:35:56,560
سِلعٌ رخيصة , سِلع رخيصة

634
00:35:56,670 --> 00:36:00,040
أوراق الشاي المُستوردة
أرجوكم فلتجربوها

635
00:36:00,150 --> 00:36:01,770
هذا حريرٌ من الصين

636
00:36:01,880 --> 00:36:05,210
حاول لمسه لتشعر كم هو فائق النعومه ياسيدي

637
00:36:06,350 --> 00:36:08,910
أرأيتَ هذه الفتاة من قبل ؟

638
00:36:09,500 --> 00:36:11,620
واو , كم هي لطيفة

639
00:36:11,720 --> 00:36:13,320
اليس كذلك ؟

640
00:36:13,420 --> 00:36:15,690
نعم , أعتقد ذلك

641
00:36:15,760 --> 00:36:18,620
أنا مُستعد لشرائها
كم هو ثمَنُها ؟

642
00:36:18,730 --> 00:36:20,890
انها ليست للبيع

643
00:36:21,030 --> 00:36:23,500
إذن , سأشتري الصورة

644
00:36:23,600 --> 00:36:26,230
! لم يسبق لي رأيتها من قبل

645
00:36:26,340 --> 00:36:28,310
! لا أعرفها

646
00:36:28,410 --> 00:36:33,210
كما إعتقدنا
شكرًا جزيلًا لك

647
00:36:34,350 --> 00:36:36,110
أعتقد أني رأيتها من قبل

648
00:36:36,210 --> 00:36:37,550
حقًا ؟

649
00:36:37,650 --> 00:36:40,210
أين ؟ ومتى ؟

650
00:36:40,290 --> 00:36:42,250
... حسب ما أذكر

651
00:36:42,320 --> 00:36:45,850
! قبل ثلاثين سنة

652
00:36:46,620 --> 00:36:48,180
نوبيتا - كن

653
00:37:05,880 --> 00:37:08,850
على هذا الحال
لن نعثر عليها أبدًا

654
00:37:08,950 --> 00:37:13,210
هل عندك حلولٌ أخرى كي نعثر عليها ؟

655
00:37:14,850 --> 00:37:16,220
... بالمناسبة

656
00:37:16,290 --> 00:37:18,810
حسّان وكوما - سان ؟

657
00:37:31,640 --> 00:37:34,300
ينبغي أن لا نُضيع الوقت لمشاهدة عرض الأفعى

658
00:37:34,370 --> 00:37:36,500
ولكني اُرهِقت

659
00:37:36,640 --> 00:37:41,300
قم بسؤال أي شخصٍ وستكون الإجابة
"لا أعرف" أو " لم أراها من قبل "

660
00:37:42,080 --> 00:37:42,340
أيها العجوز

661
00:37:42,450 --> 00:37:45,010
أنتَ لم ترى هذه الفتاة من قبل , صحيح ؟

662
00:37:45,150 --> 00:37:46,410
لقد رأيتها

663
00:37:46,520 --> 00:37:47,450
أرأيت

664
00:37:47,590 --> 00:37:49,820
دائمًا نفس الإجابة

665
00:37:49,920 --> 00:37:51,890
! " رأيتها "

666
00:37:51,990 --> 00:37:54,120
أين ؟

667
00:37:54,230 --> 00:37:55,590
قبل عشرةِ أيامٍ تقريبًا

668
00:37:55,690 --> 00:37:58,090
كانت على متنِ سفينة مُحملةٍ بالعبيد ومتجهة إلى الشرق

669
00:37:58,200 --> 00:38:00,720
أحد العبيد كانت هذه الفتاة

670
00:38:00,830 --> 00:38:02,130
!هي ؟

671
00:38:02,130 --> 00:38:03,500
لنتبعها

672
00:38:05,270 --> 00:38:06,970
ولكن كيف ؟

673
00:38:07,110 --> 00:38:10,200
أتريدون الإستماع إلى نصيحتي ؟

674
00:38:10,310 --> 00:38:14,180
عليكم أن تبتاعوا سفينة

675
00:38:14,280 --> 00:38:16,010
نبتاع سفينة ؟

676
00:38:16,150 --> 00:38:18,270
دورايمون

677
00:38:18,350 --> 00:38:21,610
... إذا لم نُسرع , فإن شيزوكا - تشان

678
00:38:21,720 --> 00:38:24,380
دورايمون , أتملك العملة الخاصة بهذا الزمن ؟

679
00:38:24,490 --> 00:38:27,480
أستطيع ذلك عن طريق بنك هيوا الفضائي

680
00:38:27,630 --> 00:38:29,180
مارأيكم ؟

681
00:38:29,290 --> 00:38:33,630
إن أردتم ذلك , فإني أملك سفينة للبيع
يُمكنكم أن ترونها

682
00:38:33,770 --> 00:38:36,890
إذن , من فضلك

683
00:38:42,770 --> 00:38:45,140
تبدو كسفينةِ أشباح

684
00:38:45,240 --> 00:38:47,580
أيُمكن إستعمالها ؟

685
00:38:47,710 --> 00:38:51,440
تبدو وأنها تُركت لفترة طويلة

686
00:38:51,550 --> 00:38:54,580
ولكن إن لم نُسرع , فلن نكون قادرين على الوصول إليها

687
00:38:54,720 --> 00:38:57,880
إنها سفينة لشحن البضائع
اتركوا هذا لي

688
00:38:57,960 --> 00:39:00,650
لنترحك الآن

689
00:39:00,760 --> 00:39:02,990
! أنتم

690
00:39:03,090 --> 00:39:06,960
لا يُمكنكم الإبحار بدون إذن

691
00:39:08,100 --> 00:39:09,860
أين هي وِجهتكم ؟

692
00:39:09,930 --> 00:39:10,800
وجهتنا ؟

693
00:39:10,900 --> 00:39:12,670
إنه , لاشيء مُحدد

694
00:39:12,770 --> 00:39:14,800
وما الأغراض التي تَملكونها ؟

695
00:39:14,910 --> 00:39:15,900
وأين هي قائمة البحّارة ؟

696
00:39:16,010 --> 00:39:19,270
... تسأل كل هذه الأسئلة فجأةً

697
00:39:19,380 --> 00:39:21,310
ها ؟ أين ذهب ذلك الرجل العجوز ؟

698
00:39:21,410 --> 00:39:22,400
إنكم مشبوهون ؟

699
00:39:22,510 --> 00:39:24,310
إتبعونا , يجب علينا أن نفحصكم

700
00:39:24,420 --> 00:39:26,750
! تمهّل

701
00:39:26,850 --> 00:39:29,010
أملك هذه

702
00:39:29,120 --> 00:39:30,590
ماهي ؟

703
00:39:30,720 --> 00:39:32,550
أهي لفيفة للإذن بالإبحار ؟

704
00:39:32,690 --> 00:39:35,920
إنها لفيفة من الخليفة هارون الرشيد

705
00:39:35,990 --> 00:39:37,360
أعتذر عن هذا

706
00:39:37,430 --> 00:39:42,990
هناك شائعات حول قاطعي طريق ذائعي الصيت
يترأسهم شخص يُدعى قاسم

707
00:39:43,100 --> 00:39:44,470
أعتذر عن هذا الخطأ

708
00:39:44,570 --> 00:39:45,560
لابأس

709
00:39:45,700 --> 00:39:49,270
يُمكنكم الإبحار الآن , تفضلوا

710
00:39:49,370 --> 00:39:51,210
المعذره

711
00:39:54,480 --> 00:39:56,910
ماذا يحدث ياترى ؟

712
00:39:56,980 --> 00:39:59,500
على ذكر هذا , أين العجوز ؟

713
00:39:59,500 --> 00:40:02,000
ها ! انه قادم

714
00:40:05,800 --> 00:40:06,500
أيها المالك

715
00:40:06,500 --> 00:40:10,000
لقد أحضرت بعض البحّاره

716
00:40:10,000 --> 00:40:12,290
نحن بحاجه أولًا إلى الطعام والشراب

717
00:40:12,400 --> 00:40:15,490
بعد ذلك , يُمكننا الإبحار

718
00:40:15,600 --> 00:40:18,800
إحساسي يقول أنه هناك خطرٌ يُحدق بنا

719
00:40:18,900 --> 00:40:20,870
لا نملك الوقت للإختيار

720
00:40:20,970 --> 00:40:21,800
حسنًا

721
00:40:21,910 --> 00:40:25,140
! جاهزون للسفر

722
00:40:33,500 --> 00:40:34,500
شيزوكا - تشان

723
00:40:34,500 --> 00:40:39,550
نحن قادمون لإنقاذكِ

724
00:40:40,500 --> 00:40:42,490
تمساكِ قليلًا ياشيزوكا - تشان

725
00:40:47,470 --> 00:40:50,560
هذه السفينة بطيئةٌ للغاية

726
00:40:52,300 --> 00:40:55,040
ألا يُمكنكم الإسراع أكثر من هذا ؟

727
00:40:55,140 --> 00:40:57,270
هذا الأمر يتعلّق بالرّياح

728
00:40:57,380 --> 00:41:00,210
إن كانت الرياح ضعيفة عندها لايُمكننا الإسراع

729
00:41:02,550 --> 00:41:04,340
أخرج شيئًا ما يادورايمون

730
00:41:04,450 --> 00:41:06,640
تُريد رياحًا قويةً ؟

731
00:41:07,550 --> 00:41:10,520
أداة الرياح

732
00:41:13,890 --> 00:41:16,960
أيها العملاق , إفعل ذلك

733
00:41:17,030 --> 00:41:19,550
دعه لي

734
00:41:23,330 --> 00:41:25,300
! قويةٌ جدًا

735
00:41:25,400 --> 00:41:27,390
السفينة ستتحطم

736
00:41:31,080 --> 00:41:32,910
كانت قوية ياعملاق

737
00:41:33,010 --> 00:41:36,470
لا تقم بتحريكها بهذه القوة

738
00:41:36,550 --> 00:41:40,540
يبدو أنهم يملكون بعض الأغراض السحريّة

739
00:41:52,000 --> 00:41:53,930
أين نحن في هذه اللحظة ؟

740
00:41:54,030 --> 00:41:57,400
أظن أننا في وسط الخليج العربي

741
00:41:58,100 --> 00:42:01,070
مازلنا لانرى السفينة التي على متنها شيزوكا - تشان

742
00:42:01,170 --> 00:42:03,700
لقد غادرت منذ عشرةِ أيام

743
00:42:03,840 --> 00:42:06,570
بالطبع لن نُدركهم بهذه السرعة

744
00:42:07,680 --> 00:42:09,440
دعونا نخلد للنوم

745
00:42:09,550 --> 00:42:11,880
نعم , صحيح

746
00:42:13,520 --> 00:42:16,350
هذه مقصورة السفينة

747
00:42:16,350 --> 00:42:18,000
... انها مُظلمه

748
00:42:18,000 --> 00:42:19,500
ألا بأس ؟

749
00:42:21,500 --> 00:42:23,000
أأنتم بخير ؟

750
00:42:25,500 --> 00:42:28,300
إنها قديمة ومُهترِئة

751
00:42:28,430 --> 00:42:30,800
من المُستحيل النوم في مكانٍ كهذا

752
00:42:31,000 --> 00:42:34,030
شرنقة حقيبة النوم

753
00:42:34,110 --> 00:42:36,130
لاخيار أمامنا , غير النوم في هذه

754
00:42:36,240 --> 00:42:37,260
تفضل يانوبيتا - كن

755
00:42:37,410 --> 00:42:38,640
نعم

756
00:42:38,740 --> 00:42:40,610
العملاق

757
00:42:42,050 --> 00:42:45,710
يبدو أن جيبه الذي يتواجد عند بطنه يحوي الكثير من الأغراض

758
00:43:07,840 --> 00:43:10,500
شيزوكا - تشان

759
00:43:12,910 --> 00:43:15,670
شيزوكا - تشان

760
00:43:16,850 --> 00:43:19,210
ماهذا ؟

761
00:43:23,000 --> 00:43:25,350
دورايمون

762
00:43:25,490 --> 00:43:26,150
نوبيتا - كن

763
00:43:26,220 --> 00:43:27,690
ما الذي يحدث ؟

764
00:43:27,790 --> 00:43:31,190
! لقد وقعنا في البحر

765
00:43:34,670 --> 00:43:38,830
هل أستيقظتم يا أعزائي المُلّاك

766
00:43:39,540 --> 00:43:40,970
أهذه من فِعلتك َ ؟

767
00:43:41,070 --> 00:43:43,800
ما الذي صنعناه لك ؟

768
00:43:43,940 --> 00:43:48,070
لم تُدركوا بعد , اليس كذلك ؟

769
00:43:49,010 --> 00:43:51,500
لقد تقابلنا من قبل

770
00:43:51,620 --> 00:43:53,350
! انه اللص قاسم

771
00:43:53,480 --> 00:43:59,000
بإمكاننا المُضِيّ الآن
وهذا بفضلكم

772
00:44:00,000 --> 00:44:03,530
ماذا تقول ؟

773
00:44:04,130 --> 00:44:06,320
أيها الوغد

774
00:44:06,460 --> 00:44:08,630
لقد صَفَح عنكم قاسم - ساما

775
00:44:08,700 --> 00:44:11,860
لذا كونوا مُمتنين لهذا

776
00:44:19,010 --> 00:44:21,140
ماذا نفعل الآن يادورايمون ؟

777
00:44:21,210 --> 00:44:24,200
لايُمكنني أن أُحرك ذراعي وقدمي

778
00:44:31,760 --> 00:44:35,660
هناك عاصفةٌ قادمة

779
00:44:41,870 --> 00:44:43,730
دورايمون

780
00:44:43,800 --> 00:44:45,600
نوبيتا - كن

781
00:44:45,700 --> 00:44:47,690
افعل شيئًا

782
00:44:49,740 --> 00:44:52,040
جميعكم ... لابأس

783
00:44:52,510 --> 00:44:53,940
لسنا بخير

784
00:44:54,080 --> 00:44:56,410
ماذا تقول ؟

785
00:44:57,050 --> 00:44:59,920
لا يُمكنني أن أتماسك أكثر من هذا

786
00:45:19,340 --> 00:45:22,330
عاصفة ليلة الأمس بدت كالحلم

787
00:45:22,440 --> 00:45:23,670
هذا حقيقي

788
00:45:23,770 --> 00:45:26,110
ذلك لم يكُن حُلمًا

789
00:45:27,000 --> 00:45:29,500
لقد كانت هناك كُرةٌ حمراء تطير

790
00:45:29,500 --> 00:45:34,480
عندها استطعنا العبور بنفس الوقت
وبعدها تم إحضارنا إلى هذا الشاطئ

791
00:45:34,620 --> 00:45:36,880
أتقول أن كُرة كانت تطير هي من أنقذتنا ؟

792
00:45:36,990 --> 00:45:40,420
! أشياء كهذه من المُحال وجودها

793
00:45:40,560 --> 00:45:42,360
لكني رأيتها بنفسي

794
00:45:42,460 --> 00:45:45,490
يالك من مُثابر

795
00:45:45,630 --> 00:45:48,760
الأهم هو أن جميعنا بخير

796
00:45:48,830 --> 00:45:50,800
كلا , لايمكن

797
00:45:50,900 --> 00:45:52,700
ما الذي تُفكر به يادورايمون ؟

798
00:45:52,800 --> 00:45:55,070
أعتقد أنه كان مُجرد وَهم

799
00:45:55,170 --> 00:45:56,500
! ولكن إن كان حقيقةً

800
00:45:56,640 --> 00:46:01,630
قد يكون الحد الفاصل بين العالم الحقيقي
والعالم الخيالي إختفى

