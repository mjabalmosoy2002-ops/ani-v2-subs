1
00:00:01,710 --> 00:00:04,480
أحيانًا عندما تكون كويزومي-سان
...قربي، أعتقد أنّ

2
00:00:06,440 --> 00:00:07,980
...الرّامن

3
00:00:09,560 --> 00:00:11,300
...الرّامن

4
00:00:13,830 --> 00:00:15,620
!أخي

5
00:00:15,620 --> 00:00:16,870
.يمكنك استعمال الحمّام الآن

6
00:00:19,030 --> 00:00:20,790
.حسنًا، سأستحمّ بعد هذا

7
00:00:20,790 --> 00:00:23,320
أليست لديك حصص غدًا في الصّباح الباكر؟

8
00:00:23,320 --> 00:00:25,400
.اذهب فحسب قبل أن يبرد الماء

9
00:00:25,400 --> 00:00:27,410
.لقد أُلغيت محاضرة حصّتي الأولى

10
00:00:31,660 --> 00:00:33,130
.تصبح على خير إذًا

11
00:00:33,360 --> 00:00:34,750
.تصبحين على خير

12
00:00:49,400 --> 00:00:51,210
.الثّالث من أكتوبر

13
00:00:51,880 --> 00:00:54,110
...كانت كويزومي-سان تأكل اليوم

14
00:00:55,070 --> 00:00:58,030
.نوعًا ما من الرّامن ذي اللّون الأزرق الشّاحب

15
00:02:28,700 --> 00:02:29,860
.مرحبًا

16
00:02:42,000 --> 00:02:43,760
.تفضّلي

17
00:02:45,000 --> 00:02:48,770
تذكّرني الألوان نوعًا ما بوحش
.من مسلسل كرتونيّ غربيّ

18
00:02:53,920 --> 00:02:56,300
لم يسعني إلاّ أن أشعر بالتّوتّر
.عندما نظرتُ إليه

19
00:02:57,900 --> 00:03:00,180
ما هو أساس هذا الحساء بالضّبط؟

20
00:03:00,180 --> 00:03:01,960
.السّمّ! إنّه السّمّ

21
00:03:01,960 --> 00:03:02,910
!ا-السّمّ؟

22
00:03:04,320 --> 00:03:05,510
.أنا أمزح

23
00:03:05,510 --> 00:03:08,690
.يا إلهي، لا تخفني هكذا

24
00:03:10,080 --> 00:03:12,500
،في منتصف تناولها للرّامن
.أضافت كويزومي-سان بعض الخلّ

25
00:03:13,250 --> 00:03:16,100
.حدث شيء غريب بعدما فعلت ذلك

26
00:03:16,100 --> 00:03:19,340
تحوّل لون الحساء الأزرق الشّاحب
.إلى حليب فراولة ورديّ اللّون

27
00:03:19,860 --> 00:03:22,110
.لم أفهم ما يجري

28
00:03:23,360 --> 00:03:24,140
...لكن

29
00:03:30,360 --> 00:03:33,600
.بدت سعيدة للغاية

30
00:03:35,200 --> 00:03:37,800
.لذلك أعتقد أنّه كان لذيذًا

31
00:03:38,960 --> 00:03:40,500
.شكرًا على الانتظار

32
00:03:41,550 --> 00:03:44,200
.بالمناسبة، لقد طلبت رامن كاكاو

33
00:03:49,660 --> 00:03:52,120
ربّما تعتقدون أنّه مجرّد شراب
،شكولاطة مع المعكرونة

34
00:03:52,600 --> 00:03:54,710
!لكن لم يكن هنالك مجال للشّكّ أنّه رامن

35
00:03:56,440 --> 00:03:59,130
.لكنّه كان يترك طعم كاكاو خفيف في الفم

36
00:03:59,720 --> 00:04:02,530
أخبريني، ما نكهة هذا الرّامن؟

37
00:04:02,530 --> 00:04:04,280
.قبل قليل، كان مذاقه أزرقًا خفيفًا

38
00:04:04,280 --> 00:04:05,720
.والآن مذاقه ورديّ

39
00:04:05,720 --> 00:04:08,600
ماذا؟ أيّ نوع من النّكهات هذه؟

40
00:04:08,600 --> 00:04:10,500
هل يمكنني تذوّق الحساء؟

41
00:04:11,800 --> 00:04:13,390
.لا تعيريني انتباهًا

42
00:04:14,100 --> 00:04:16,900
.مرّت محادثة اليوم بشكل جيّد

43
00:04:17,640 --> 00:04:22,190
أرجوك! أتمنّى منك أن تسمحي
!لي بمرافقتك

44
00:04:22,190 --> 00:04:24,080
!أرجوك! أنا أتوسّل إليك

45
00:04:24,080 --> 00:04:27,410
.كنتُ سعيدة للغاية أنّنا ذهبنا معًا

46
00:04:28,470 --> 00:04:33,160
،لكن أحيانًا وأنا مع كويزومي-سان
...أجد نفسي أفكّر في

47
00:04:35,360 --> 00:04:36,670
أصفر؟

48
00:04:36,670 --> 00:04:37,920
أزرق؟

49
00:04:38,240 --> 00:04:39,570
حليب صويا؟

50
00:04:39,570 --> 00:04:40,920
قهوة بالحليب؟

51
00:04:42,930 --> 00:04:44,430
!ألكالي؟

52
00:04:45,840 --> 00:04:47,550
...الرّامن

53
00:04:52,560 --> 00:04:54,500
.هو الكون

54
00:05:25,000 --> 00:05:25,970
ماذا؟

55
00:05:27,550 --> 00:05:31,140
.إنّها تدرس بجدّ بالفعل مؤخّرًا

56
00:05:33,960 --> 00:05:37,520
.ربّما عليّ أن آخذها لأكل شيء لذيذ

57
00:05:37,520 --> 00:05:39,360
.موعد قبض الرّاتب وشيك

58
00:05:54,730 --> 00:05:56,950
ما هو رامن ألكالي؟

59
00:05:56,950 --> 00:05:59,590
.يبدو أنّهم يضعون هذه في صلصة صويا الرّامن

60
00:05:59,590 --> 00:06:00,880
!بطّاريّات؟

61
00:06:01,190 --> 00:06:02,500
فعلاً؟

62
00:06:02,500 --> 00:06:03,810
.كانت مزحة

63
00:06:10,620 --> 00:06:13,220
...دجاج مقليّ وبطاطس مقليّة

64
00:06:13,710 --> 00:06:16,520
.سلطة بطارخ البلوق... وفطائر ألفيّة

65
00:06:18,360 --> 00:06:20,270
.حلوى مون بلان جيّدة أيضًا

66
00:06:21,110 --> 00:06:22,610
...اسمعي

67
00:06:23,940 --> 00:06:26,150
.عليك تناول السّوشي

68
00:06:26,730 --> 00:06:28,660
.هذا مطعم سوشي

69
00:06:31,600 --> 00:06:34,380
.قبض أخي راتبه اليوم

70
00:06:34,380 --> 00:06:37,910
لقد دعاني بشكل غير معهود
.لنتعشّى في الخارج

71
00:06:38,360 --> 00:06:40,690
.أنت من أوصى بهذا المكان

72
00:06:40,690 --> 00:06:43,670
الأمر ممتع لأنّ قائمة الطّعام
!تضمّ خيارات كثيرة مختلفة

73
00:06:43,960 --> 00:06:46,670
.يمكن تناول الكثير من الأشياء هنا

74
00:06:46,670 --> 00:06:49,490
.انظر، سوشي بيض

75
00:06:49,490 --> 00:06:51,390
!إنّه المفضّل لديّ

76
00:06:51,390 --> 00:06:52,800
.أنت طفلة

77
00:06:52,800 --> 00:06:54,190
عمّ تحدّث؟

78
00:06:54,190 --> 00:06:55,920
.أن نبدأ بالبيض هو الرّائج الآن

79
00:06:55,920 --> 00:06:57,720
.ذُكر هذا على الإنترنيت

80
00:06:57,720 --> 00:07:00,200
.اخرسي وتناولي بعض السّمك

81
00:07:01,090 --> 00:07:03,820
!هذا صادر من الرّجل الّذي طلب تونا ومايونيز

82
00:07:03,820 --> 00:07:07,610
.التّونة سمك أيضًا، وهي المفضّلة لديّ

83
00:07:07,920 --> 00:07:14,020
لكن ألا يفترض بك دعوة حبيبتك
للعشاء في يوم قبضك للرّاتب؟

84
00:07:14,020 --> 00:07:16,720
مهلاً، ليس لديك حبيبة الآن؟

85
00:07:16,720 --> 00:07:18,620
لم تكن لديك واحدة أبدًا؟

86
00:07:18,620 --> 00:07:20,740
.يكفي. سوف نتقاسم الفاتورة

87
00:07:20,740 --> 00:07:23,000
!أمزح فحسب! أنا آسفة

88
00:07:23,250 --> 00:07:27,300
حسنًا، لنتناول السّلمون لكي
.نعطي هذا المكان حقّه

89
00:07:30,410 --> 00:07:31,930
!كويزومي-سان؟

90
00:07:34,540 --> 00:07:35,480
هل تعرفينها؟

91
00:07:35,480 --> 00:07:37,390
!نـ-نعم! إنّها صديقتي

92
00:07:37,760 --> 00:07:40,560
!كلاّ، بل هي صديقتي المفضّلة
!صديقتي الحميمة

93
00:07:40,560 --> 00:07:44,520
اللّقاء في مكان كهذا يعني
.أنّنا قد نكون توأم روح حتّى

94
00:07:44,840 --> 00:07:49,380
لكن ما الّذي تفعله كويزومي-سان في مطعم
حزام متنقّل للسّوشي بدل مطعم رامن؟

95
00:07:53,610 --> 00:07:55,990
!ويبدو أنّها تعرف هذا المكان جيّدًا

96
00:07:59,890 --> 00:08:01,410
مجموعة طعام؟

97
00:08:03,920 --> 00:08:05,420
.وقت الأكل

98
00:08:08,030 --> 00:08:10,010
!طبقها الأساسيّ هو الرّامن

99
00:08:32,230 --> 00:08:34,990
...فهمت! إنّ كويزومي-سان

100
00:08:39,730 --> 00:08:44,990
تستمتع برامن خاصّ يمكنها
.تناوله هنا فحسب

101
00:08:45,480 --> 00:08:48,130
.أستطيع معرفة ذلك حتّى من الخلف

102
00:08:49,170 --> 00:08:51,400
،أريد الذّهاب والتّحدّث معها
،لكنّها ليست هنا لذلك

103
00:08:51,400 --> 00:08:53,510
.ومشاهدتها فقط تكفي

104
00:08:53,900 --> 00:08:56,460
...تحديق

105
00:08:59,140 --> 00:09:00,730
...تحديق

106
00:09:00,730 --> 00:09:01,770
!أخي؟

107
00:09:02,330 --> 00:09:05,890
...لا-لا-لا يعقل أنّه يظنّ أيضًا أنّ كويزومي-سان

108
00:09:06,350 --> 00:09:11,000
!كلاّ، لا أريد أن أنافس أخي على كويزومي-سان

109
00:09:11,000 --> 00:09:15,740
!هذا ليس منصفًا! كنتُ صديقتها أوّلاً

110
00:09:15,740 --> 00:09:17,440
!كنتُ صديقتها أوّلاً

111
00:09:17,440 --> 00:09:20,500
!أنا أوّلاً

112
00:09:20,500 --> 00:09:23,340
!اسمعي، أريد تناول رامن أيضًا

113
00:09:23,340 --> 00:09:24,440
ماذا عنك؟

114
00:09:24,440 --> 00:09:26,160
!نجوت

115
00:09:28,330 --> 00:09:30,300
.جميعها تبدو جيّدة

116
00:09:30,300 --> 00:09:31,550
!كما أنّها رخيصة

117
00:09:32,200 --> 00:09:33,720
.لنجرّبها كلّها

118
00:09:33,720 --> 00:09:36,140
،يمكننا إنهاؤها إن تقاسمناها
صحيح؟ صحيح؟

119
00:09:37,600 --> 00:09:40,970
.أنا سعيدة لأنّك أخي

120
00:09:41,340 --> 00:09:45,400
أنا سعيد لأنّك أدركتِ أخيرًا
.روعة أخيك

121
00:09:45,400 --> 00:09:47,690
.يمكنك تناول كلّ ما تريدين اليوم

122
00:09:49,440 --> 00:09:51,190
.سأفعل ذلك

123
00:09:57,880 --> 00:09:59,660
!وقت الأكل

124
00:10:39,610 --> 00:10:42,530
...رامن يمكنني تناوله هنا فقط

125
00:10:42,530 --> 00:10:46,290
!هذا رائع

126
00:10:47,180 --> 00:10:49,790
...مهلاً لحظة

127
00:10:49,790 --> 00:10:51,700
...بالنّظر إليها بتمعّن الآن

128
00:10:53,400 --> 00:10:55,050
!عرفتُ هذا

129
00:10:55,320 --> 00:10:56,790
.كويزومي-سان صديقتي

130
00:10:56,790 --> 00:10:57,840
...كويزومي-سان لي

131
00:10:57,840 --> 00:10:59,400
...لي، لي، لي، لي

132
00:10:59,400 --> 00:11:02,890
لقد أكلت تلك الفتاة ثلاثة
.زبديّات رامن وحدها

133
00:11:02,890 --> 00:11:04,180
!ذلك مذهل

134
00:11:07,520 --> 00:11:09,560
.نعم، معك حقّ

135
00:11:12,060 --> 00:11:14,160
.ذلك رائع بالفعل

136
00:11:17,960 --> 00:11:21,540
يستعمل الرّامن في مطاعم الحزام المتنقّل للسّوشي
،أساس حساء من المأكولات البحريّة أحيانًا

137
00:11:21,540 --> 00:11:23,500
.ممّا يعني أنّه يتماشى جيّدًا مع السّوشي

138
00:11:23,500 --> 00:11:25,990
.ستجعلكم اللّذّة ترقصون بشكل لا إراديّ

139
00:11:33,930 --> 00:11:35,990
!أخبريني يا كويزومي-سان

140
00:11:36,470 --> 00:11:38,510
!هل أنت متفرّغة اليوم؟ لنخرج معًا

141
00:11:38,510 --> 00:11:39,630
.كلاّ

142
00:11:39,630 --> 00:11:42,050
.لا تتصرّفي هكذا

143
00:11:42,050 --> 00:11:43,510
.لا أريد

144
00:11:44,600 --> 00:11:47,930
.أجل، هذه أظرف زاوية لالتقاط صوري

145
00:11:49,500 --> 00:11:52,140
لكنّ يو لا تستسلم أبدًا، صحيح؟

146
00:11:52,140 --> 00:11:53,400
.بالفعل

147
00:11:52,140 --> 00:11:54,590
!لنذهب يا كويزومي-سان

148
00:11:54,590 --> 00:11:55,400
.كلاّ

149
00:11:57,150 --> 00:11:58,650
أمّي؟

150
00:11:59,600 --> 00:12:01,170
مرحبًا؟

151
00:12:02,640 --> 00:12:05,650
ماذا؟ اليوم؟ في لحال؟

152
00:12:06,320 --> 00:12:07,200
.نعم

153
00:12:07,200 --> 00:12:10,440
،لقد قام القسم بالحجز
.لكنّي لا أستطيع الذّهاب الآن

154
00:12:10,440 --> 00:12:12,950
.ولا يمكن إلغاء الحجز أيضًا

155
00:12:12,950 --> 00:12:14,920
...لكن لا أستطيع أن

156
00:12:14,920 --> 00:12:17,560
.سأهتمّ بالفاتورة، لذلك شكرًا يا جون-تشان

157
00:12:17,560 --> 00:12:18,250
.إلى اللّقاء

158
00:12:18,250 --> 00:12:19,530
!أمّي؟

159
00:12:23,240 --> 00:12:24,590
ما الخطب؟

160
00:12:25,840 --> 00:12:29,310
هل يمكنني أن أتكلّم معكنّ لوهلة؟

161
00:12:29,610 --> 00:12:31,820
.وأنت أيضًا يا كويزومي-سان إن أمكن

162
00:12:34,920 --> 00:12:41,800
تقولين أنّك تريديننا جميعًا أن نساعدك
.على أكل العشاء الخاصّ الّذي طلبته أمّك

163
00:12:41,800 --> 00:12:45,950
آسفة... لكنّها قالت أنّه كلمّا كان
.عددنا أكثر، كان أفضل

164
00:12:46,710 --> 00:12:49,950
،إن كان هنالك شيء آخر تردنه
.فلا تتردّدن بطلبه

165
00:12:50,450 --> 00:12:54,280
الطّعام الصّينيّ هو الأفضل
.دائمًا عندما يتشاركه الجميع

166
00:12:55,360 --> 00:13:00,680
لكن من النّادر جدًّا أن نتناول
.الطّعام نحن الأربع معًا

167
00:13:00,680 --> 00:13:02,320
.معك حقّ

168
00:13:02,320 --> 00:13:08,920
،في الحقيقة، لقد رفضت دعوتي
...لكنّها قبلت عندما دعتها جون

169
00:13:08,920 --> 00:13:10,200
.هذا مزعج

170
00:13:10,200 --> 00:13:11,600
.آسفة، على ما أظنّ

171
00:13:12,110 --> 00:13:17,310
هذه دعوة لكلّ ما يمكن أكله من الرّامن على
.حساب ممثّلة الفصل. بالتّالي، سأطلب تانتانمن

172
00:13:17,310 --> 00:13:18,860
!كان ذلك سريعًا

173
00:13:18,860 --> 00:13:22,800
.صحيح! هذا من طبعك يا كويزومي-سان

174
00:13:22,800 --> 00:13:25,880
،عفوًا، لا أعرف ما الّذي سيحضرونه

175
00:13:25,880 --> 00:13:27,960
...لذلك فلنرَ ما الّذي سنحصل عليه أوّلاً

176
00:13:27,190 --> 00:13:28,670
.شكرًا على الانتظار

177
00:13:35,840 --> 00:13:37,860
.طبق غيوزا العملاقة الخاصّ بنا

178
00:13:38,500 --> 00:13:39,880
!ما هذا؟

179
00:13:39,880 --> 00:13:41,250
!إنّه ضخم

180
00:13:41,520 --> 00:13:43,100
!هذا ممتع للغاية

181
00:13:43,920 --> 00:13:46,630
.هذا رائع! إنّه يشبه وسادة

182
00:13:46,630 --> 00:13:50,140
مهلاً، هذا ما قصدته عندما قال "الخاصّ بهم"؟

183
00:13:50,420 --> 00:13:53,900
يفترض بهذا الطّبق أن يعادل مائة غيوزا
...من الحجم العاديّ، ممّا يعني

184
00:13:54,640 --> 00:13:58,200
،باستعمال حساب بسيط
!فسنتناول 25 غيوزا لكلّ واحدة

185
00:13:59,500 --> 00:14:02,480
.حسنًا... سنقوم بذلك بطريقة ما

186
00:14:02,480 --> 00:14:06,850
.لكن تبدو القشرة صلبة للغاية
...لذلك إن احتسبنا ذلك

187
00:14:06,850 --> 00:14:10,280
.كان عليّ إحضار المزيد من النّاس

188
00:14:10,870 --> 00:14:13,280
.المعذرة. أريد أن أطلب واحدًا من هذه

189
00:14:13,280 --> 00:14:15,340
مهلاً! ألا ترين ما يحدث أمامك؟

190
00:14:15,340 --> 00:14:17,400
لماذا تطلبين المزيد؟

191
00:14:17,400 --> 00:14:19,980
!لا يمكننا أكل الرّامن فوق هذا

192
00:14:19,980 --> 00:14:22,570
.سأتناول الرّامن وحدي

193
00:14:22,570 --> 00:14:24,790
.وبالطّبع، سأتناول بعض الغيوزا أيضًا

194
00:14:24,790 --> 00:14:26,050
هل أنت جادّة؟

195
00:14:26,050 --> 00:14:30,050
من الطّبيعيّ تناول الغيوزا
.والرّامن في مطعم صينيّ

196
00:14:31,860 --> 00:14:33,760
.حسنًا، هذه هي كويزومي-سان

197
00:14:33,760 --> 00:14:35,980
.إذًا، سوف أقوم بتقسيمه

198
00:14:35,980 --> 00:14:37,160
!بالتّوفيق يا يو

199
00:14:37,160 --> 00:14:38,270
.ها أنا ذي

200
00:14:40,950 --> 00:14:42,230
!بالطّبع

201
00:14:42,230 --> 00:14:45,150
إن طلبتُ من كويزومي-سان
...مساعدتي في هذا

202
00:14:55,000 --> 00:14:59,860
!ستكون فرصتنا لإكمال أوّل نشاط مشترك بيننا

203
00:15:04,200 --> 00:15:08,300
.في الحقيقة، يصعب تقطيع هذا وحدي

204
00:15:08,300 --> 00:15:12,450
آسفة، هل يمكنك مساعدتي يا كويزومي-سان؟

205
00:15:12,450 --> 00:15:13,350
.أكيد

206
00:15:15,250 --> 00:15:18,060
!نشاطنا المشترك الأوّل

207
00:15:23,450 --> 00:15:25,660
!انظرن لعصارة اللّحم تلك

208
00:15:25,660 --> 00:15:26,820
.تبدو شهيّة

209
00:15:30,150 --> 00:15:32,440
...لم يكن ذلك ما فكّرتُ به

210
00:15:32,440 --> 00:15:34,450
.شكرًا على الانتظار

211
00:15:34,700 --> 00:15:37,280
.زبديّة رامن عملاق واحدة وتانتانمن واحد

212
00:15:37,280 --> 00:15:38,680
رامن عملاق؟

213
00:15:38,680 --> 00:15:40,280
!ما الّذي طلبتِه؟

214
00:15:40,280 --> 00:15:41,440
.مذهل

215
00:15:41,440 --> 00:15:43,140
.طاولتنا تعمّها الفوضى

216
00:15:43,140 --> 00:15:45,590
.إنّها تعبث بإدراكي للعمق

217
00:15:46,600 --> 00:15:47,960
.وقت الأكل

218
00:15:55,800 --> 00:15:57,920
.عـ-علينا أن نبدأ بالأكل أيضًا فحسب

219
00:15:57,920 --> 00:15:59,720
.مـ-معك حقّ

220
00:15:59,720 --> 00:16:01,350
!وقت الأكل

221
00:16:02,530 --> 00:16:04,190
!إنّها تشبه كعكة غيوزا

222
00:16:04,480 --> 00:16:07,290
...في البداية، سأجرّبها مع القليل من الصّلصة

223
00:16:11,690 --> 00:16:15,200
!القشرة تشبه الخبز تقريبًا
!إنّها سميكة وكثيرة المضغ

224
00:16:18,850 --> 00:16:21,660
صحيح! هذا يشبه نسخة غيوزا
!عن الموتشي المشويّ

225
00:16:23,880 --> 00:16:26,790
هذا لذيذ للغاية، أعتقد
.أنّ بإمكاننا تناوله بالكامل

226
00:16:30,800 --> 00:16:32,820
هل تمانعين إن طلبتُ رامن شونغيكو؟

227
00:16:32,820 --> 00:16:35,510
...عـ-على الإطلاق، تفضّلي

228
00:16:37,790 --> 00:16:40,390
.سأغطّي قطعتي بزيت الفلفل الحارّ

229
00:16:41,260 --> 00:16:42,600
أليس ذلك كثيرًا؟

230
00:16:42,600 --> 00:16:45,240
.سأجرّب قطعتي مع الخلّ

231
00:16:45,240 --> 00:16:47,190
.شكرًا على الانتظار

232
00:16:47,650 --> 00:16:49,200
.ها هو رامن شونغيكو

233
00:16:50,920 --> 00:16:52,690
.الرّائحة زكيّة

234
00:16:52,690 --> 00:16:54,340
.بالفعل

235
00:16:54,850 --> 00:16:57,880
أخبريني يا كويزومي-سان، أيّ نوع من الرّامن هذا؟

236
00:16:58,420 --> 00:17:00,320
.طعمه بشبه الشّونغيكو

237
00:17:00,320 --> 00:17:01,950
يشبه الشّونغيكو؟

238
00:17:01,950 --> 00:17:03,910
.هذا ما يوحي إليه اسمه

239
00:17:03,910 --> 00:17:04,960
.يبدو شهيًّا

240
00:17:04,960 --> 00:17:07,810
.تتناسب رائحة الدّهون جيّدًا مع الحساء

241
00:17:07,810 --> 00:17:09,810
.إنّه رامن يشبه طعمه الشّونغيكو

242
00:17:09,810 --> 00:17:12,600
.يمكننا طلب المزيد إن ساوركنّ الفضول

243
00:17:12,600 --> 00:17:13,900
!نعم، لنفعل ذلك

244
00:17:13,900 --> 00:17:15,360
!ماذا؟ لا، لا

245
00:17:15,360 --> 00:17:17,720
!لن نستطيع إنهاء كلّ هذا إن طلبنا المزيد

246
00:17:20,450 --> 00:17:22,720
.بدأت أشبع

247
00:17:23,270 --> 00:17:25,480
.بدأنا نبطئ في أكلنا قليلاً

248
00:17:25,700 --> 00:17:27,380
.أستطيع أكل المزيد

249
00:17:27,380 --> 00:17:29,480
.فعلاً؟ هذا ليس من عادتك

250
00:17:29,840 --> 00:17:33,580
.كانت لديك شهيّة صغيرة
.انظري لنفسك الآن

251
00:17:33,580 --> 00:17:36,700
ربّما لأنّني كنت أخرج للأكل
.مع كويزومي-سان

252
00:17:37,950 --> 00:17:39,440
.أريد رامن تشار سيو، رجاءً

253
00:17:39,440 --> 00:17:41,200
ماذا؟ تطلبين المزيد؟

254
00:17:41,880 --> 00:17:43,520
.شكرًا على الانتظار

255
00:17:50,820 --> 00:17:52,340
.مذهل

256
00:17:53,260 --> 00:17:55,000
.سأطلب غوموكو صوبا

257
00:17:57,020 --> 00:17:58,480
.شكرًا على الانتظار

258
00:18:09,470 --> 00:18:11,360
.لا يمكننا الجلوس هنا والانبهار فحسب

259
00:18:11,360 --> 00:18:12,140
.نعم

260
00:18:17,440 --> 00:18:19,300
!أ-أنا أيضًا

261
00:18:49,920 --> 00:18:51,500
!أستسلم

262
00:18:51,500 --> 00:18:53,640
.لقد شبعت

263
00:18:53,640 --> 00:18:56,630
.أنا أيضًا. بلغت حدودي للاستمتاع بالطّعام

264
00:18:56,630 --> 00:18:58,000
.وأنا أيضًا

265
00:18:58,850 --> 00:19:01,160
.ربّما عليّ طلب مشروب ما

266
00:19:01,620 --> 00:19:05,090
!لديهم مسابقة تناول رامن عملاق هنا

267
00:19:05,090 --> 00:19:07,600
!كان على كويزومي-سان المشاركة

268
00:19:07,600 --> 00:19:08,870
.صحيح، صحيح

269
00:19:09,200 --> 00:19:12,830
أعتقد أنّ هذه الغيوزا أُعدّت من
.أجل مسابقة الأكل لديهم أيضًا

270
00:19:13,280 --> 00:19:16,170
من المؤسف أنّنا لاحظنا الأمر متأخّرًا يا كويزومي؟

271
00:19:16,740 --> 00:19:19,800
،كنت أعرف بأمر قائمة التّحدّيّات لديهم

272
00:19:19,800 --> 00:19:21,680
.لكنّني لا أحبّ منافسات الأكل

273
00:19:22,470 --> 00:19:23,480
لِمَ لا؟

274
00:19:23,480 --> 00:19:25,180
هل بسبب الوقت المحدّد؟

275
00:19:31,690 --> 00:19:35,940
أنا فقط لا أظنّ أنّ بإمكاني أكل ما
.يكفي لدخول حدث كهذا بكلّ ثقة

276
00:19:37,500 --> 00:19:39,470
...إنّها غير مدركة بنفسها

277
00:19:39,470 --> 00:19:41,420
...هذا مخيف

278
00:19:42,380 --> 00:19:45,760
يا ممثّلة الفصل، هل يمكنني
طلب رامن مابو أيضًا؟

279
00:19:45,760 --> 00:19:48,270
،وإن كان هنالك المزيد من الغيوزا
.فسأتناولها كذلك

280
00:19:48,270 --> 00:19:50,210
.نعم، أكيد

281
00:19:51,190 --> 00:19:53,170
!شكرًا لكنّ

282
00:19:54,720 --> 00:19:56,400
.كان ذلك لذيذًا

283
00:19:56,400 --> 00:19:58,540
.لذيذ لدرجة أنّني بالغت في الأكل

284
00:19:58,540 --> 00:20:01,590
.وأنا أيضًا. لا يمكنني تناول المزيد

285
00:20:05,670 --> 00:20:08,180
كويزومي-سان؟ ما الخطب؟

286
00:20:10,920 --> 00:20:11,730
ماذا؟

287
00:20:12,150 --> 00:20:13,520
ماذا هنالك؟

288
00:20:17,240 --> 00:20:18,930
.لا بأس بهذا أيضًا

289
00:20:20,270 --> 00:20:24,330
!لا أريد سماع حتّى كلمة غيوزا الآن

290
00:20:25,410 --> 00:20:29,160
سألتني أمّي وكلّها شكّ عن عدد
.النّاس الّذين اصطحبتهم

291
00:20:29,470 --> 00:20:30,870
.هذه هي كويزومي

292
00:20:31,240 --> 00:20:35,000
!هذه هي كويزومي-سان

293
00:22:10,660 --> 00:22:13,110
.تلك الغيوزا العملاقة كانت مميّزة بالفعل

294
00:22:13,110 --> 00:22:15,070
كان من المفترض أن تكون مائة
.حصّة من الغيوزا

295
00:22:15,070 --> 00:22:18,140
لقد شبعنا بسبب الغيوزا بشكل
،أساسيّ، أمّا أنت يا كويزومي-سان

296
00:22:18,140 --> 00:22:20,120
كم زبديّة رامن أكلت حتّى النّهاية؟

297
00:22:20,120 --> 00:22:23,840
صحيح! ليس منصفًا أنّ بإمكانك
!أكل الكثير دون أن يزداد وزنك

298
00:22:23,840 --> 00:22:25,970
!من الأفضل أن تبوحي بسرّك في الحال

299
00:22:25,970 --> 00:22:26,870
.لا أدري ماذا أقول

300
00:22:26,870 --> 00:22:29,510
!إنّها ملاك! لهذا السّبب لا يزيد وزنها