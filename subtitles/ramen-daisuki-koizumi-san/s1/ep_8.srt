1
00:00:07,080 --> 00:00:08,110
!انظري

2
00:00:08,110 --> 00:00:10,600
!اشتريتُ زيّ سباحة جديدًا

3
00:00:10,600 --> 00:00:12,740
أليس ظريفًا؟

4
00:00:13,160 --> 00:00:14,390
!خذي

5
00:00:16,920 --> 00:00:19,160
!ما بالك؟ تعالي، تعالي

6
00:00:19,160 --> 00:00:21,000
!أسرعي

7
00:00:22,060 --> 00:00:23,750
.لقد أطلتِ في ذلك

8
00:00:23,980 --> 00:00:24,760
ما رأيك؟

9
00:00:24,760 --> 00:00:26,440
أيبدو الزّيّ مناسبًا عليّ؟

10
00:00:26,440 --> 00:00:27,470
إنّه جيّد، صحيح؟

11
00:00:27,470 --> 00:00:28,960
.نعم، جميل للغاية

12
00:00:28,960 --> 00:00:31,960
.أنت ظريفة للغاية يا ميسا-تشان

13
00:00:33,420 --> 00:00:36,590
!تلك الفتاة! إنّها تبدو مثل كويزومي-سان

14
00:00:36,590 --> 00:00:38,680
مهلاً، لماذا تنظرين لها؟

15
00:00:38,960 --> 00:00:42,240
لكن أعتقد أنّها لا تصل
.إلى مستوى كويزومي-سان

16
00:00:42,240 --> 00:00:43,680
!هذا فظّ

17
00:00:44,210 --> 00:00:47,810
،على أيّ حال، لا أتوقّع أن تأتي كويزومي

18
00:00:47,810 --> 00:00:49,960
.لكن لا أصدّق أنّ جون ليست هنا

19
00:00:49,960 --> 00:00:52,440
.قالت أنّها محرجة للغاية من ارتداء زيّ سباحة

20
00:00:52,710 --> 00:00:56,730
يا إلهي، أردت رؤيتهما ترتديان
.أزياء سباحة بشدّة

21
00:00:56,730 --> 00:00:58,820
!كوني سعيدة لأنّك رأيتني أنا

22
00:01:02,650 --> 00:01:05,400
.أتساءل ما الّذي تفعلانه الآن

23
00:01:06,450 --> 00:01:10,200
.على الأرجح أنّ جون في المكتبة

24
00:01:10,200 --> 00:01:14,340
قالت أنّها تذهب للمكتبة كلّ يوم
.منذ بداية العطلة الصّيفيّة

25
00:01:14,620 --> 00:01:17,340
.تحبّ جون الكتب بالفعل

26
00:01:18,880 --> 00:01:22,760
قراءة أكثر من مائة رواية خلال
عطلة الصّيف؟ أذلك ممكن؟

27
00:01:22,760 --> 00:01:24,960
!ما كنتُ أبدًا لأفعل ذلك

28
00:01:24,960 --> 00:01:26,850
.معك حقّ

29
00:01:28,730 --> 00:01:31,690
.أتساءل ما الّذي تفعله كويزومي-سان

30
00:01:31,690 --> 00:01:33,110
ماذا؟ كويزومي؟

31
00:01:33,900 --> 00:01:37,420
أليس واضحًا أنّ للأمر علاقة بالرّامن؟

32
00:01:38,230 --> 00:01:39,400
.صحيح

33
00:01:40,400 --> 00:01:43,980
.تحبّ كويزومي-سان الرّامن كثيرًا

34
00:03:25,290 --> 00:03:29,440
هذا يزعجني. لا أستطيع
.الاستمتاع بالقراءة بالكامل

35
00:03:34,270 --> 00:03:35,500
.كويزومي-سان

36
00:03:41,240 --> 00:03:45,460
أليست مكتبة المدرسة جيّدة
للدّراسة في العطلة الصّيفيّة؟

37
00:03:45,460 --> 00:03:47,950
.مكتبة البلدة مزدحمة للغاية في الحقيقة

38
00:03:48,530 --> 00:03:51,840
هل تعملين على تقرير العطلة الصّيفيّة؟

39
00:03:51,840 --> 00:03:53,310
.ليس تمامًا في الحقيقة

40
00:03:53,310 --> 00:03:54,420
أنت أيضًا؟

41
00:03:54,420 --> 00:03:58,630
.أعني أنّ الأمر له علاقة بمستقبلك

42
00:03:58,630 --> 00:04:00,310
أخبرتنا المعلّمة أن نختار شيئًا نحبّه

43
00:04:00,310 --> 00:04:03,680
،أو نبرع به كمهنة لنا
.لكنّ القول أسهل من الفعل

44
00:04:03,680 --> 00:04:06,770
،لا أظنّ أنّ بإمكاني أن أصبح كاتبة
وحتّى إن كنت سأدخل

45
00:04:06,770 --> 00:04:12,560
مجال النّشر مثل أمّي، فلن ينتهي بي المطاف
.بالضّرورة في القسم الّذي أحبّ

46
00:04:12,560 --> 00:04:15,280
بالنّظر للعلامات، العلوم الطّبيعيّة
،ستكون مناسبة لي كثيرًا

47
00:04:15,280 --> 00:04:18,530
لكن لا توجد أعمال في ذلك
.المجال تروق لي

48
00:04:18,530 --> 00:04:19,940
.هذا صعب

49
00:04:20,280 --> 00:04:24,760
في الحقيقة، ما أريده بالفعل هو
،أن أقول أنّني لا أهتمّ بكلّ هذا

50
00:04:24,760 --> 00:04:28,700
وأدير محلّ بيع كتب أو أكون أمينة مكتبة لأستطيع
.النّظر لكلّ الكتب الّتي أحبّها طوال اليوم

51
00:04:29,010 --> 00:04:30,180
.وكأنّ ذلك ممكنٌ

52
00:04:31,180 --> 00:04:34,080
.أنا أفهم ذلك نوعًا ما

53
00:04:42,250 --> 00:04:45,720
على أيّ حال، ما هو حلمك للمستقبل؟

54
00:04:48,550 --> 00:04:49,720
.إنّه سرّ

55
00:04:49,720 --> 00:04:51,880
.فـ-فهمت

56
00:04:51,880 --> 00:04:54,230
أظنّ أنّه مرتبط بالرّامن، صحيح؟

57
00:04:54,510 --> 00:04:56,660
.سوف أغادر الآن

58
00:04:56,660 --> 00:04:58,360
هل ستذهبين لمكان ما بعد هذا؟

59
00:04:59,590 --> 00:05:00,460
.نعم

60
00:05:05,520 --> 00:05:07,700
.لأنظر للرّامن الّذي أحبّ

61
00:05:09,840 --> 00:05:10,890
هذا المكان؟

62
00:05:12,080 --> 00:05:15,370
.تقول اللاّفتة أنّه حانة

63
00:05:16,190 --> 00:05:20,160
مهلاً، هذه معكرونة فوريّة؟

64
00:05:20,160 --> 00:05:22,380
!جدار كامل منه

65
00:05:22,380 --> 00:05:26,360
.ماذا؟ لكن لا أظنّني رأيت الكثير من هذا

66
00:05:26,360 --> 00:05:27,860
لقد لاحظتِه إذًا؟

67
00:05:28,740 --> 00:05:32,010
الرّامن الّذي يملكونه هنا
هي معكرونة فوريّة محلّيّة

68
00:05:32,010 --> 00:05:33,640
.من كلّ حدب وصوب في اليابان

69
00:05:34,600 --> 00:05:35,270
!معك حقّ

70
00:05:35,270 --> 00:05:37,200
!إنّها مصنّفة حسب الجهات

71
00:05:37,200 --> 00:05:41,540
مؤخّرًا، يمكن الحصول على بعضها
.في المتاجر الكبرى أيضًا

72
00:05:42,730 --> 00:05:44,530
لم أكن أعلم بوجود الكثير
.من المعكرونة الفوريّة

73
00:05:45,360 --> 00:05:49,380
أنا آكلها في العادة عندما لا يكون
.والداي في المنزل على العشاء

74
00:05:49,380 --> 00:05:51,820
.ربّما سأعدّ بعضها اليوم في المنزل

75
00:05:51,820 --> 00:05:53,830
.سوف آكلها هنا

76
00:05:53,830 --> 00:05:55,290
ماذا؟ هنا؟

77
00:05:55,290 --> 00:05:57,830
ستأكلين المعكرونة الفوريّة في المتجر؟

78
00:05:58,100 --> 00:06:02,840
أنا أقترف الأخطاء في العادة
.عندما أعدّها بنفسي

79
00:06:05,080 --> 00:06:07,270
إضافة إلى ذلك، حتّى بالنّسبة
،للمعكرونة الفوريّة

80
00:06:07,270 --> 00:06:10,440
.فخطأ واحد قد يفسد النّكهة

81
00:06:11,350 --> 00:06:14,390
.تحضير المعكرونة والحساء بشكل منفصل

82
00:06:16,440 --> 00:06:19,480
.يمكن للمعكرونة أن تصبح قاسية وتلتصق ببعضها

83
00:06:20,980 --> 00:06:24,270
طهي المعكرونة بشكل متساو
.في الكثير من الماء

84
00:06:25,900 --> 00:06:28,950
أو العكس. إن طهوت المعكرونة
.أكثر من اللاّزم، ستتشبّع بالماء

85
00:06:30,710 --> 00:06:34,120
يمكن لوقت الطّهي أن يكون
.أقلّ من المشار إليه

86
00:06:35,910 --> 00:06:38,670
.لقد عانيت مرّات عدّة

87
00:06:38,670 --> 00:06:41,210
.أظنّ أنّها لا تجيد الطّهي

88
00:06:41,850 --> 00:06:46,210
حسنًا، أرى أنّه من الآمن ترك
.محترف يطهوها لك

89
00:06:47,690 --> 00:06:50,190
.ربّما سآكل هنا أيضًا

90
00:06:51,020 --> 00:06:55,000
نختار شيئًا ما من هنا ونطلب من العاملين
في المتجر أن يطهوه لنا، صحيح؟

91
00:06:55,000 --> 00:06:55,760
.نعم

92
00:06:55,760 --> 00:06:57,220
هل تنصحينني بأيّ شيء؟

93
00:06:57,930 --> 00:07:02,240
...لكلّ شخص شيء ما يفضّله

94
00:07:02,240 --> 00:07:06,110
لكن إن كان عليّ الاختيار، فسأقول
أنّ المنتجات من هوكّايدو

95
00:07:06,470 --> 00:07:09,210
.أفضل من البقيّة

96
00:07:09,210 --> 00:07:11,610
كما أنّ لديهم بعض الشّراكات
.مع مطاعم مشهورة أيضًا

97
00:07:11,610 --> 00:07:14,830
وإذا بدأنا برامن حديقة حيوانات
ماروياما، الرّامن الّذي ارتبط

98
00:07:14,830 --> 00:07:19,750
بحديقة حيوانات كلّ منطقة لديه
.أكياس ظريفة، لكنّ نكهته جيّدة أيضًا

99
00:07:19,750 --> 00:07:25,050
وثمّة نوع آخر مرتبط بالحيوانات وهي
.سلسلة رامن زرافة نيشيميكاوا من أيشي

100
00:07:25,050 --> 00:07:29,760
،إضافة لسلسلات حديقة الأسماك
.مثل البطريق أو الدّلفين أو الفقمة

101
00:07:29,760 --> 00:07:32,680
كما أنّها تملك نُسخًا صحّيّة بمعكرونة
.غير مقليّة تسمّى سلسلة الجمال

102
00:07:32,680 --> 00:07:35,710
كما أنّ هنالك رامن بونبوكو
،من منطقة هيغاشيميكاوا

103
00:07:35,710 --> 00:07:38,270
.لكنّ كلاهما لديه نكهة منزليّة خفيفة

104
00:07:38,270 --> 00:07:43,430
تضمّ الأنواع غير الاعتياديّة مكوّنات مختلفة
في المعكرونة تسمح بتجربة نكهة فريدة

105
00:07:43,430 --> 00:07:46,150
كالزّيتون أو جذور اللّوتس
.أو الفلفل الحارّ أو الطّحالب

106
00:07:46,490 --> 00:07:50,440
إضافة إلى ذلك، هناك رامن تشانبون من
.هيوغو، وهو قريب من التّانمن المالح

107
00:07:50,440 --> 00:07:54,090
لكن احذري، إنّه مختلف تمامًا عن
.تشانبون ناغاساكي من كيوشو

108
00:07:54,090 --> 00:07:56,160
.لسبب ما، إنّ له شعبيّة كبيرة في إيشيكاوا

109
00:07:56,520 --> 00:07:59,410
بالحديث عن كيوشو، فإنّها تتميّز بسلاسل
،أوماكاتشان المنكّهة بالتّونكوتسو

110
00:07:59,410 --> 00:08:04,150
،و"أفيك رامن" من كوماموتو
.الّذي يأتي مع مجعون حساء مالح خفيف

111
00:08:04,150 --> 00:08:07,130
يسمّونه "أفيك" لأنّه يفترض
.أكله "مع" شخص آخر

112
00:08:07,130 --> 00:08:10,240
.يشبه نوعًا ما الرّامن المزدوج في هوكّايدو

113
00:08:11,480 --> 00:08:12,690
...هذا كثير

114
00:08:12,690 --> 00:08:15,820
مهلاً لحظة، لماذا تعرف كلّ النّكهات مسبقًا؟

115
00:08:15,820 --> 00:08:17,680
هل تقصد أنّها جرّبت كلّ واحدة منها؟

116
00:08:18,320 --> 00:08:21,300
،إن كانت تقوم بهذا القدر من البحث
فهل يعني ذلك أنّها تنوي

117
00:08:22,790 --> 00:08:26,050
!الحصول على عمل في صناعة الرّامن؟

118
00:08:29,290 --> 00:08:33,950
لهذا السّبب اخترتُ رامن طحالب
.ريشيري من هوكّايدو

119
00:08:34,270 --> 00:08:38,490
،اخترتُ شيئًا من مقاطعة كاغوشيما
،رامن التّونا الخاصّ بإيشيكي كوشينو

120
00:08:38,490 --> 00:08:40,450
.مع مسحوق الواسابي

121
00:08:41,700 --> 00:08:43,730
.يبدو أنّهما طبقان من مطعم رامن حقيقيّ

122
00:08:43,730 --> 00:08:44,460
...حسنًا

123
00:08:45,380 --> 00:08:47,080
.وقت الأكل

124
00:09:00,450 --> 00:09:02,720
هنالك نكهة طحالب أقوى ممّا ظننت

125
00:09:03,230 --> 00:09:07,020
.وأومامي الطّحالب المقطّعة ينتشر أكثر فأكثر

126
00:09:08,060 --> 00:09:08,980
ماذا؟

127
00:09:09,750 --> 00:09:10,630
!ماذا؟

128
00:09:23,160 --> 00:09:28,260
لا أتذكّر أنّ نكهة الرّامن الفوريّ
.كانت لذيذة هكذا

129
00:09:34,800 --> 00:09:37,080
.دخل مسحوق الواسابي في أنفي

130
00:09:37,080 --> 00:09:38,890
.لكنّ ذلك هو الجزء الممتع

131
00:09:41,960 --> 00:09:48,150
كويزومي-سان، هل ستعملين
في مجال صناعة الرّامن؟

132
00:09:48,440 --> 00:09:51,840
لهذا السّبب أراك تدرّبين حاسّة
تذوّقك في كلّ مكان

133
00:09:51,840 --> 00:09:55,760
وتعتمدين على فهمك للرّامن، صحيح؟

134
00:09:55,760 --> 00:09:58,660
.أنا أتطلّع إليك نوعًا ما بسبب ذلك

135
00:10:00,750 --> 00:10:02,950
ماذا؟

136
00:10:04,160 --> 00:10:06,620
.لم أفكّر أبدًا في ذلك

137
00:10:06,620 --> 00:10:08,170
.فـ-فهمت

138
00:10:16,610 --> 00:10:23,410
في الحقيقة، لا يمكنني حتّى
...التّفكير في أيّ شيء

139
00:10:23,410 --> 00:10:26,200
.عندما آكل الرّامن

140
00:10:30,360 --> 00:10:34,180
.أنا أعرف ما تعنينه نوعًا ما

141
00:10:36,360 --> 00:10:37,820
.معك حقّ

142
00:10:38,260 --> 00:10:41,200
.هذا هو هذا، وذاك هو ذاك

143
00:10:41,200 --> 00:10:42,020
.صحيح

144
00:10:43,390 --> 00:10:46,580
ما هو حلمك في المستقبل إذًا؟

145
00:10:50,650 --> 00:10:51,960
.إنّه سرّ

146
00:10:52,960 --> 00:10:56,200
ما الّذي يجب فعله لنصبح رامن؟

147
00:10:56,200 --> 00:10:57,840
عمّ تتحدّثين؟

148
00:10:59,300 --> 00:11:01,720
...شمّ، شمّ

149
00:11:02,250 --> 00:11:07,680
رائحة المعكرونة الفوريّة الّتي أعطيتني
.إيّاها تشبه رائحة كويزومي-سان

150
00:11:07,680 --> 00:11:08,540
!ماذا؟

151
00:11:21,870 --> 00:11:24,320
.إضافات البيض ستكون مقابل 70 ينّ

152
00:11:25,620 --> 00:11:28,330
!شكرًا على الانتظار

153
00:11:29,980 --> 00:11:31,260
!الزّبون التّالي رجاءً

154
00:11:31,260 --> 00:11:34,130
!مرحبًا

155
00:11:34,660 --> 00:11:38,130
!ميسو الملفوف الحارّ مقابل 120 ينّ

156
00:11:39,420 --> 00:11:42,510
!شكرًا على الانتظار

157
00:12:13,990 --> 00:12:16,000
أخبروني، ماذا تريدون أن تأكلوا على الغداء؟

158
00:12:16,490 --> 00:12:17,970
.أريد رامن

159
00:12:17,970 --> 00:12:18,780
.أرزّ

160
00:12:18,780 --> 00:12:19,800
.طبق أرزّ

161
00:12:19,800 --> 00:12:21,010
.معكرونة أو ما شابه

162
00:12:21,650 --> 00:12:27,220
ما رأيكما أن تضعا الأرزّ خاصّتكما
في حساء الرّامن خاصّتنا بعد أن ننتهي؟

163
00:12:27,580 --> 00:12:29,500
.أعتقد أنّ ذلك ممكنٌ

164
00:12:29,500 --> 00:12:31,480
.سأختار الرّامن إذًا

165
00:12:31,480 --> 00:12:32,100
ماذا؟

166
00:12:32,680 --> 00:12:35,080
نضع الأرزّ في حساء الرّامن؟

167
00:12:35,080 --> 00:12:36,480
أليس ذلك مقرفًا نوعًا ما؟

168
00:12:37,650 --> 00:12:39,390
!هل أنت جادّ الآن؟

169
00:12:39,390 --> 00:12:42,680
يجعل غنى الحساء الكثيف إنهاءه
!مع الأرزّ أمرًا مسلّمًا به

170
00:12:42,680 --> 00:12:44,490
.لم أقم بشيء كهذا من قبل

171
00:12:44,490 --> 00:12:45,720
.كما أفضّل النّكهات الخفيفة

172
00:12:45,720 --> 00:12:47,440
...على رسلك

173
00:12:47,440 --> 00:12:49,880
اعتدتُ أن أكون غير مصدّق مثلك
.حتّى وقت قصير

174
00:12:49,880 --> 00:12:51,770
بقايا الحساء والأرزّ؟

175
00:12:51,770 --> 00:12:54,470
،إن كنت تريد الأرزّ بشدّة هكذا
.اطلب طبق أرزّ مقليّ صغير فحسب

176
00:12:54,470 --> 00:12:56,660
إن أردت قوامًا أكثر، اطلب المزيد
.من المعكرونة فحسب

177
00:12:56,660 --> 00:12:57,750
أتفهمون؟

178
00:12:58,040 --> 00:12:58,650
...لكن

179
00:12:58,650 --> 00:13:02,210
ذهبت لمطعم رامن ذات يوم مع
،حبيبتي وأوصانا الطّاهي بذلك

180
00:13:02,210 --> 00:13:04,290
.لذلك جرّبته لأوّل مرّة

181
00:13:04,290 --> 00:13:06,790
.والنّتيجة؟ رضىًا تامّ

182
00:13:06,790 --> 00:13:11,850
:كانت حبيبتي سعيدة للغاية أيضًا وقالت
"!لذيذ! إنّه مثل الرّيزوتّو الإيطاليّ"

183
00:13:12,200 --> 00:13:14,690
.أنا مؤمن بذلك بالكامل الآن

184
00:13:14,690 --> 00:13:17,250
.لم يطلب أحد منك أن تتباهى لامتلاكك لحبيبة

185
00:13:17,250 --> 00:13:19,770
!ما بالك؟ كنتُ أساندك

186
00:13:20,560 --> 00:13:24,150
.حساء الخضروات الكثيف يتناسب مع الأرزّ جيّدًا

187
00:13:24,610 --> 00:13:26,720
.والمأكولات البحريّة أيضًا

188
00:13:26,720 --> 00:13:28,870
.إضافة لكاتسورا تانتان أيضًا

189
00:13:28,870 --> 00:13:31,410
!أجل، مع بيضة فوقه

190
00:13:31,830 --> 00:13:34,940
لماذا إذًا لا نطلب عصيدة من البداية؟

191
00:13:34,940 --> 00:13:36,720
.أنت لا تفهم

192
00:13:36,720 --> 00:13:39,170
الأمر جيّد لأنّه يتسنّى لنا إنهاؤه
!بالأرزّ بعد إنهاء الرّامن

193
00:13:39,610 --> 00:13:43,120
.الأرزّ مع الرّامن عبارة عن كربوهيدرات مع كربوهيدرات

194
00:13:43,120 --> 00:13:48,050
عند أكل الأرزّ مع الرّامن، يصبح الرّامن
!كطبق جانبيّ وحساء

195
00:13:48,560 --> 00:13:51,760
لكن ألا يحتوي على الكثير من
المكوّنات ليكون حساءً؟

196
00:13:51,760 --> 00:13:53,650
!ما بالك؟

197
00:13:53,650 --> 00:13:57,490
لا أمانع الرّامن، لكن هلاّ اخترنا مكانًا ما؟

198
00:13:57,490 --> 00:13:59,200
.أنا جائع

199
00:13:59,200 --> 00:14:00,270
.حسنًا، آسف

200
00:14:01,000 --> 00:14:02,110
...دعوني أفكّر

201
00:14:02,110 --> 00:14:07,650
ما المطعم الّذي يقدّم رامن
يتماشى جيّدًا مع الأرزّ؟

202
00:14:10,760 --> 00:14:11,910
أُسريّ؟

203
00:14:12,350 --> 00:14:14,690
هل يعني ذلك أنّ طعمه كأنّه
معدّ في المنزل؟

204
00:14:14,690 --> 00:14:17,660
."كلاّ، إنّها "إييكي

205
00:14:17,660 --> 00:14:23,990
.إنّه يحتوي على سبانخ ونوري، وهو غنيّ
.يشبه التّونكوتسو لكنّه مثل الدّجاج أيضًا

206
00:14:23,990 --> 00:14:25,420
!إنّه لذيذ على أيّ حال

207
00:14:25,850 --> 00:14:27,940
.لم تشرح شيئًا بكلامك ذلك

208
00:14:26,440 --> 00:14:28,840
.يا رجل، الصّفّ طويل ثانية

209
00:14:27,940 --> 00:14:33,400
اخرس! على أيّ حال، إييكي
!هو أفضل مرافق للأرزّ

210
00:14:33,400 --> 00:14:38,520
إييكي هو شيء بدأ هنا
.في مطعم يوشيمورايا هذا

211
00:14:38,520 --> 00:14:43,460
كلّ المطاعم تقريبًا الّتي غرزت جذورها هنا
،لديها الكانجي "إيي" أو "يا" في أسمائها

212
00:14:43,460 --> 00:14:45,940
."لذلك تمّ جمعها معًا تحت اسم "إييكي

213
00:14:46,400 --> 00:14:48,440
.رغم أنّ التّعريف غير مؤكّد تمامًا

214
00:14:48,440 --> 00:14:49,320
!نعم، نعم

215
00:14:49,320 --> 00:14:52,970
.هذا صحيح. هنالك الكثير منها

216
00:14:52,970 --> 00:14:54,950
.لنقف في الصّفّ بسرعة

217
00:14:54,950 --> 00:14:57,700
!حسنًا، لنذهب

218
00:14:59,100 --> 00:15:01,130
.شكرًا على الانتظار

219
00:15:02,310 --> 00:15:04,550
!لا أستطيع التّحمّل، يبدو شهيًّا

220
00:15:04,550 --> 00:15:06,270
.عليّ إرسال هذا لحبيبتي

221
00:15:07,020 --> 00:15:09,550
ماذا؟ تتفقّد وسائل التّواصل الاجتماعيّ؟

222
00:15:09,000 --> 00:15:10,970
.لنأكل

223
00:15:09,550 --> 00:15:10,970
.كلاّ، هذا من أجل سجلّي فحسب

224
00:15:11,260 --> 00:15:14,770
أخبرني، أليس هذا كثيرًا؟
.لا أدري إن كنتُ أستطيع إنهاءه

225
00:15:14,770 --> 00:15:17,470
.من يهتمّ؟! لنأكل فحسب

226
00:15:17,970 --> 00:15:19,600
!وقت الأكل

227
00:15:29,450 --> 00:15:30,440
.نكهة ثابتة

228
00:15:30,440 --> 00:15:33,330
،هنالك تلميح لطعم لحم الطّرائد
.لكنّه قشديّ ويسهل بلعه

229
00:15:33,330 --> 00:15:35,870
إنّه لذيذ لدرجة أنّ المرء قد يموت
!إن لم يأكله بشكل دوريّ

230
00:15:36,590 --> 00:15:39,770
.نعم، هذا لذيذ بالفعل

231
00:15:39,770 --> 00:15:40,500
!أرأيت؟

232
00:15:41,500 --> 00:15:44,650
هل تريد بعض الثّوم؟ أم تفضّل الزّنجبيل؟

233
00:15:44,650 --> 00:15:46,010
سابورو؟

234
00:15:46,010 --> 00:15:48,580
،عليّ العودة للعمل بعد هذا
.حيث عليّ التّحدّث مع النّاس

235
00:15:48,580 --> 00:15:49,880
.لذلك سأختار الزّنجبيل

236
00:15:50,290 --> 00:15:53,430
.سآخذ الثّوم. أنا عائد للمنزل بعد هذا

237
00:15:53,430 --> 00:15:56,600
.أنا أحسدك. عليّ العودة للعمل أيضًا

238
00:15:56,600 --> 00:16:00,790
صحيح، متى ستأكلون السّبانخ؟

239
00:16:00,790 --> 00:16:02,000
.أنا آكلها في البداية

240
00:16:02,000 --> 00:16:03,730
.إن أردتَ رأيي، فأنا أفضّل أكلها في النّهاية

241
00:16:03,730 --> 00:16:05,720
.لم أفكّر أبدًا في ذلك

242
00:16:05,720 --> 00:16:07,770
.أنا آكلها مع الأرزّ

243
00:16:08,130 --> 00:16:10,070
ماذا عن النّوري إذًا؟ متى تأكلونه؟

244
00:16:11,250 --> 00:16:14,450
.لم أفهم أبدًا لماذا هنالك نوري مع الرّامن

245
00:16:15,030 --> 00:16:19,070
،ليس من الواضح متى يجب أكله
.كما أنّه يتشبّع بالماء إذا تركناه

246
00:16:19,070 --> 00:16:20,950
!هذا هو الجيّد فيه

247
00:16:21,330 --> 00:16:26,790
انظر، تلفّ السّبانخ بالنّوري
.المشبّع بالحساء هكذا

248
00:16:27,830 --> 00:16:29,800
!هذا هو المطلوب

249
00:16:34,760 --> 00:16:35,800
!لذيذ للغاية

250
00:16:36,520 --> 00:16:40,580
يمكن للنّوري مع الرّامن أن يبرز
.أكثر فقط إن كان هنالك أرزّ

251
00:16:40,580 --> 00:16:42,380
.هذا صحيح

252
00:16:46,010 --> 00:16:47,060
.هذا لذيذ

253
00:16:47,600 --> 00:16:50,320
.مجرّد أكله مع المعكرونة لذيذ أيضًا

254
00:16:50,890 --> 00:16:54,320
،إن تركت النّوري يتشبّع بالحساء
،وأكلته مع المعكرونة

255
00:16:54,810 --> 00:16:57,940
يمكنك الاستمتاع بالمعكرونة
.والحساء في نفس الوقت

256
00:16:59,380 --> 00:17:04,290
نعم. كلتا الطّريقتين جيّدة، لكنّني أرى
.الآن أنّه لا يوجد نوري بما يكفي

257
00:17:04,580 --> 00:17:08,120
.في تلك الحالة، اطلب المزيد من النّوري

258
00:17:08,120 --> 00:17:09,210
.فهمت

259
00:17:09,520 --> 00:17:12,170
!وبدلاً من ذلك... افعل هذا

260
00:17:12,770 --> 00:17:14,670
.هذا هو المطلوب

261
00:17:14,670 --> 00:17:16,250
.يبدو شهيًّا

262
00:17:16,250 --> 00:17:20,740
يبدو شهيًّا بالفعل، لكن ينتهي بك
.المطاف تشرب كلّ الحساء

263
00:17:21,560 --> 00:17:22,680
...الصّوديوم

264
00:17:23,150 --> 00:17:25,320
يا شباب، ما موقفكم من الخلّ في الرّامن؟

265
00:17:25,320 --> 00:17:26,440
مع أم ضدّ؟

266
00:17:26,700 --> 00:17:29,930
.أحبّ إضافته في النّهاية لتغيير النّكهة

267
00:17:29,930 --> 00:17:32,190
.مرحبًا

268
00:17:41,890 --> 00:17:43,160
!فتاةُ ثانويّة

269
00:17:43,530 --> 00:17:45,660
.لا تحدّقوا هكذا

270
00:17:47,040 --> 00:17:50,530
.ماذا؟ أظنّ أنّني رأيتها من قبل

271
00:17:50,530 --> 00:17:52,300
كيف تريدين أن تكون كثافة الحساء؟

272
00:17:53,640 --> 00:17:58,300
حساء كثيف وقليل الدّهون
.ومعكرونة متماسكة قليلاً

273
00:18:00,980 --> 00:18:01,900
...صوديوم

274
00:18:02,840 --> 00:18:04,680
!حسنًا، تفضّلي الرّامن والأرزّ

275
00:18:04,680 --> 00:18:06,500
.شكرًا على الانتظار

276
00:18:08,240 --> 00:18:09,560
.وقت الأكل

277
00:18:38,390 --> 00:18:41,020
!لقد ابتكرت طبقًا جديدًا نوعًا ما

278
00:18:41,020 --> 00:18:44,640
.فهمت، وضع الحساء في طبق الأرزّ ممكن أيضًا

279
00:19:08,390 --> 00:19:10,040
!إنّها المعلّمة

280
00:19:10,040 --> 00:19:14,750
فهمت، طلبت معكرونتها متماسكة
.لأنّها تأكل الأرزّ أوّلاً

281
00:19:44,200 --> 00:19:46,030
!شكرًا على الوجبة

282
00:19:51,160 --> 00:19:54,220
أعتقد أنّك على حقّ. رامن إييكي
.يتناسب جيّدًا مع الأرزّ

283
00:19:54,220 --> 00:19:55,540
!أرأيت؟

284
00:19:56,380 --> 00:19:58,660
!إييكي هو الأفضل

285
00:20:06,130 --> 00:20:10,310
كلّ من الزّنجبيل المقطّع والزّنجبيل المبشور
.متوفّر في العادة، وهذا مفيد

286
00:20:11,310 --> 00:20:14,000
في ذلك المطعم الّذي ذهبت إليه
ذلك اليوم، أضفتُ بصلاً مقطّعًا

287
00:20:14,000 --> 00:20:16,060
.وكان ذلك منعشًا لدرجة كبيرة أكثر ممّا تخيّلت

288
00:20:16,060 --> 00:20:20,790
لهذا السّبب أعتقد أنّ الإضافات المجّانيّة عنصر
،ضروريّ للاستمتاع برامن إييكي بالفعل

289
00:20:20,790 --> 00:20:21,980
...وهذا لدرجة

290
00:20:20,790 --> 00:20:23,900
.أصبح مهووسًا تمامًا بذلك

291
00:20:25,230 --> 00:20:27,750
إلى أيّ مطعم رامن ستذهبين اليوم؟

292
00:20:27,750 --> 00:20:29,560
.هنالك رواج على رامن إييكي مؤخّرًا

293
00:20:29,560 --> 00:20:32,960
ماذا؟ ما هو؟ هل طعمه مثل المعدّ في المنزل؟

294
00:20:32,960 --> 00:20:34,200
!إذًا تعالي إلى منزلي فحسب

295
00:20:34,200 --> 00:20:34,960
.لن أفعل

296
00:22:11,720 --> 00:22:14,930
يُعرف أنّ الملفوف كإضافة يميّع
الحساء، لكنّي أحبّ ذلك

297
00:22:14,930 --> 00:22:16,600
.لأنّه يجعل النّكهة أكثر اكتمالاً

298
00:22:16,600 --> 00:22:19,680
فعلاً؟ ملاحظتك لذلك تعني
!أنك تقدّمتَ كثيرًا

299
00:22:19,680 --> 00:22:21,900
.أضع أحيانًا النّاتّو كإضافة

300
00:22:21,900 --> 00:22:25,320
سمعتُ أنّ وضع مثلّجات الفانيلاّ مع صلصة
،الصّويا، وسلطة البطاطا مع التّونكوتسو

301
00:22:25,320 --> 00:22:27,350
.والعسل مع الميسو كلّها مقبولة أيضًا

302
00:22:27,350 --> 00:22:29,950
.هذا معقّد كثيرًا عليّ لأتخيّله