1
00:00:03,760 --> 00:00:04,880
!كويزومي-سان

2
00:00:06,300 --> 00:00:10,120
.أتريدين الذهاب إلى الكاريوكي معنا؟ على حسابنا

3
00:00:07,740 --> 00:00:10,860
لديّ تذكرتان لفيلم، أتريدين المجيء؟

4
00:00:10,120 --> 00:00:12,170
.هنالك مقهى لديه حلويّات لذيذة

5
00:00:10,860 --> 00:00:13,080
.لديّ تذاكر مجانيّة للمتنزّه الترفيهي

6
00:00:18,160 --> 00:00:22,320
.الشباب يسعون خلف كويزومي بشدّة مؤخرًا

7
00:00:22,320 --> 00:00:23,750
.هذا يزعجني

8
00:00:23,750 --> 00:00:28,300
،نعم، مرّت مدة منذ أن انتقلت
.ولكنّها ما زالت بلا حبيب

9
00:00:29,500 --> 00:00:31,560
.أولئك الشباب المساكين

10
00:00:31,560 --> 00:00:33,950
يمكنهم طلب الخروج معها قدر
.ما يريدون ولكن بلا جدوى

11
00:00:33,950 --> 00:00:36,920
!حبيب كويزومي-سان الوحيد هو الرامن

12
00:00:36,920 --> 00:00:38,980
.أعرف ذلك جيّدًا

13
00:00:39,490 --> 00:00:41,270
لمَ تبدين متنازلة للغاية؟

14
00:00:42,160 --> 00:00:44,630
أعتقد أنّ ما باليد حيلة. أتريدين المجيء يا ميسا-تشان؟

15
00:00:44,630 --> 00:00:45,640
!لا تعبث معي

16
00:00:45,640 --> 00:00:47,850
!ادعني أنا أولًا أو انسَ الأمر

17
00:00:47,850 --> 00:00:51,240
.لنعد إلى البيت معًا يا كويزومي-سان

18
00:00:51,240 --> 00:00:52,150
!معي

19
00:00:52,150 --> 00:00:53,670
.لا أريد

20
00:00:53,670 --> 00:00:55,180
.لديّ خطط

21
00:01:01,680 --> 00:01:04,420
.أرأيت؟ إنّها خجولة

22
00:01:04,420 --> 00:01:06,330
رأيت" ماذا تمامًا؟"

23
00:01:06,580 --> 00:01:09,260
أتعتقد أنّ لدى كويزومي-سان حبيب؟

24
00:01:09,260 --> 00:01:13,570
لا بدّ من ذلك، لا يمكن أن تكون
.فتاة بهذه الظرافة بلا حبيب

25
00:01:13,570 --> 00:01:15,340
.إنّهم لا يفهمون حقًّا

26
00:01:15,340 --> 00:01:18,180
.العلاقة الوحيدة التي تريدها هي مع الرامن

27
00:01:18,590 --> 00:01:21,060
!الرامن ولا شيء آخر

28
00:01:22,220 --> 00:01:25,940
.لديّ خطط

29
00:01:27,140 --> 00:01:33,480
.الرامن... ولا... شيء... آخر

30
00:01:34,680 --> 00:01:36,740
!آسفة! أنا عائدة للمنزل

31
00:01:36,740 --> 00:01:37,600
.كان ذلك سريعًا

32
00:03:18,960 --> 00:03:21,170
.الرامن ولا شيء آخر

33
00:03:21,170 --> 00:03:22,470
...الرامن

34
00:03:22,830 --> 00:03:25,510
أتعتقد أنّ لدى كويزومي-سان حبيب؟

35
00:03:25,510 --> 00:03:29,520
لا بدّ من ذلك، لا يمكن أن تكون
.فتاة بهذه الظرافة بلا حبيب

36
00:03:29,520 --> 00:03:32,940
.لا يمكن أن يكون لكويزومي-سان حبيب أبدًا

37
00:03:33,540 --> 00:03:36,440
.حبّها الوحيد هو الرامن

38
00:03:36,820 --> 00:03:40,190
...لا بدّ وأنّها أتت إلى منطقة الأعمال هذه من أجل

39
00:03:40,520 --> 00:03:43,450
!محلّ رامن

40
00:03:45,960 --> 00:03:49,830
!إ-إنّه ليس محلّ رامن؟

41
00:03:50,130 --> 00:03:53,010
كويزومي-سان ذاهبة إلى مطعم
غربي فاخر ذو أسلوب قديم؟

42
00:03:53,010 --> 00:03:54,720
!لقد تأخرت

43
00:03:53,010 --> 00:03:55,000
!هذا يشعرني بالغرابة

44
00:03:54,720 --> 00:03:56,580
آسف. هل انتظرتِ لوقت طويل؟

45
00:03:55,000 --> 00:03:56,590
ما الذي يجري هنا؟

46
00:03:57,420 --> 00:04:00,330
أيعقل أنّها ستلتقي بشاب حقًّا؟

47
00:04:00,760 --> 00:04:03,730
.تتحقق من الوقت باستمرار وتتلفت

48
00:04:06,360 --> 00:04:10,230
وما بال نظرة "العذراء المصعوقة بالحب" هذه؟

49
00:04:10,230 --> 00:04:11,700
!ظريفة

50
00:04:14,380 --> 00:04:15,400
!كلّا

51
00:04:15,710 --> 00:04:19,360
لأن تكون في منطقة مشاهير رفيعة
...المستوى كهذه يعني

52
00:04:19,360 --> 00:04:21,510
!أنّها ستلاقي رجلًا أكبر سنًّا

53
00:04:21,870 --> 00:04:23,000
.شكرًا لك على الانتظار

54
00:04:23,000 --> 00:04:26,480
.دعيني أقدّمك إلى شيء أفضل من الرامن

55
00:04:29,490 --> 00:04:31,040
.لن أسمح بذلك

56
00:04:31,040 --> 00:04:32,120
!لن أسمح به

57
00:04:32,520 --> 00:04:36,680
أبدًا، أبدًا، أبدًا، أبدًا، أبدًا
...أبدًا، أبدًا، أبدًا

58
00:04:36,680 --> 00:04:38,130
.شكرًا لك على الانتظار

59
00:04:43,460 --> 00:04:45,160
.آسف لتأخري

60
00:04:45,160 --> 00:04:46,220
.لا بأس

61
00:04:46,530 --> 00:04:48,850
!إنّه شاب حقًّا

62
00:04:50,490 --> 00:04:53,360
!لا، لا، لا، لا، لا، لا، لا، لا

63
00:04:53,360 --> 00:04:54,340
!مرحبًا

64
00:04:53,860 --> 00:04:55,300
.نعتذر على التأخر

65
00:04:54,920 --> 00:04:56,280
.نعتذر حقًّا

66
00:04:56,280 --> 00:04:58,730
!وليس واحد فقط، بل مجموعة من الشباب

67
00:04:59,720 --> 00:05:02,740
أيعقل أنّها تقابل العديد من الشبّان؟

68
00:05:03,420 --> 00:05:04,210
!لا

69
00:05:04,210 --> 00:05:05,940
!لا يمكنك فعل ذلك يا كويزومي-سان

70
00:05:05,940 --> 00:05:07,890
!كويزومي-سان! كويزومي-سان

71
00:05:08,620 --> 00:05:10,550
!كويزومي-سان

72
00:05:10,550 --> 00:05:13,450
!لا ينبغي لك ذلك

73
00:05:14,340 --> 00:05:19,210
!هذا خاطئ تمامًا يا كويزومي-سان

74
00:05:24,600 --> 00:05:26,620
.حسنًا إذًا، علينا الذهاب

75
00:05:26,620 --> 00:05:27,590
.نعم

76
00:05:27,800 --> 00:05:30,600
.آسفون لإبقائك منتظرة

77
00:05:28,940 --> 00:05:30,600
.ياه، أكلت كثيرًا

78
00:05:30,600 --> 00:05:31,330
.لا مشكلة

79
00:05:30,860 --> 00:05:32,860
.حسنًا، لنعد إلى العمل

80
00:05:32,860 --> 00:05:34,660
ماذا؟

81
00:05:34,660 --> 00:05:37,380
ألم تكوني هنا لرؤية هؤلاء؟

82
00:05:37,380 --> 00:05:39,100
ما الذي تتحدثين عنه؟

83
00:05:40,170 --> 00:05:44,030
.كنت أنتظر مغادرتهم مكانهم

84
00:05:44,860 --> 00:05:46,530
مكانهم؟

85
00:05:51,980 --> 00:05:57,960
أ-أتخبرينني أنّه يوجد كشك محلّ
!رامن خلف هذا المطعم الغربي؟

86
00:05:57,960 --> 00:05:59,250
!ما معنى هذا؟

87
00:06:00,580 --> 00:06:03,250
.كما يقول الاسم، إنّه ركن رامن

88
00:06:03,620 --> 00:06:06,750
.وصلت بنفس وقت تلك المجموعة من أربعة

89
00:06:06,750 --> 00:06:11,160
وبما أنّ لا يوجد إلّا أربعة
.أماكن في الداخل، تركتهم يسبقونني

90
00:06:11,620 --> 00:06:12,510
...حقًّا

91
00:06:13,370 --> 00:06:15,220
.هذا ما كان في الأمر إذًا

92
00:06:15,710 --> 00:06:16,640
...بالمناسبة

93
00:06:17,520 --> 00:06:20,090
لمَ أنتِ هنا على أيّ حال؟

94
00:06:23,140 --> 00:06:25,870
...حسنًا

95
00:06:29,740 --> 00:06:33,250
.سأتناول الرامن كما خطّطت

96
00:06:33,250 --> 00:06:34,240
ماذا عنك؟

97
00:06:34,240 --> 00:06:35,370
أنا أيضًا

98
00:06:43,810 --> 00:06:46,880
!يمكنك رؤية المطبخ بأكمله من مكان الحساب

99
00:06:49,860 --> 00:06:53,010
رامن تشاشو مع حساء برش وسلطة كرنب، صحيح؟

100
00:06:53,010 --> 00:06:55,240
مع حساء البرش وسلطة كرنب؟

101
00:06:55,240 --> 00:06:57,220
.سأطلب هذا أيضًا

102
00:07:00,090 --> 00:07:01,620
.أرجوك

103
00:07:03,320 --> 00:07:05,870
.تفضلي، حساء بروش وسلطة كرنب

104
00:07:06,710 --> 00:07:08,530
!يبدو الطعام غربيًّا للغاية

105
00:07:11,860 --> 00:07:13,310
!إنّه لذيذ

106
00:07:13,310 --> 00:07:16,480
إنّه لذيذ لدرجة أنّي لن أتفاجأ
!لو أنّ الثمن كان أعلى بكثير

107
00:07:16,480 --> 00:07:18,810
.دائمًا ما أطلب هذا حين آتي إلى هنا

108
00:07:20,290 --> 00:07:23,040
.يمكن رؤية ما داخل المطعم من هنا

109
00:07:23,040 --> 00:07:26,240
.يمكنك طلب الرامن من هناك أيضًا بالمناسبة

110
00:07:26,240 --> 00:07:30,360
لمَ انتظرت خارجًا للدخول إلى هنا إذًا؟

111
00:07:30,360 --> 00:07:31,520
...لأنّ

112
00:07:32,640 --> 00:07:35,120
.أفضّل الأجواء هنا

113
00:07:37,680 --> 00:07:40,130
.رامن زبدة ورامن تاشو

114
00:07:40,130 --> 00:07:43,400
!مذهل، يبدو لذيذًا للغاية

115
00:07:44,080 --> 00:07:45,770
.لنبدأ الأكل

116
00:08:08,270 --> 00:08:10,170
!لذيذ

117
00:08:12,940 --> 00:08:15,660
.تذوب الزبدة في الحساء

118
00:08:15,660 --> 00:08:19,790
.هذه أوّل مرة آكل واقفة، وذلك ليس سيّئًا أبدًا

119
00:08:23,960 --> 00:08:26,020
.تمكنت من أكل هذا أخيرًا

120
00:08:29,080 --> 00:08:32,180
أعتقد أنّ الرامن حبيبك حقًّا، صحيح؟

121
00:08:34,290 --> 00:08:35,990
ما الذي تتحدثين عنه؟

122
00:08:36,720 --> 00:08:37,860
!لا شيء

123
00:08:38,780 --> 00:08:41,700
لمَ أنت مبتعدة إلى هذا الحد بالمناسبة؟

124
00:08:41,700 --> 00:08:43,900
.ليس من الضروري أن نقف جانب بعضنا

125
00:08:43,900 --> 00:08:45,420
!ماذا؟

126
00:08:50,700 --> 00:08:51,800
...دهن الظهر

127
00:08:51,800 --> 00:08:53,160
...البصل الأخضر

128
00:08:53,160 --> 00:08:54,360
...تونكتسو

129
00:08:54,360 --> 00:08:56,800
!سأذهب معك يا كويزومي-سان

130
00:09:12,340 --> 00:09:13,840
كيف أبدو؟

131
00:09:13,840 --> 00:09:15,520
.يلائمك حقًّا

132
00:09:15,520 --> 00:09:19,360
،الأبيض يلائمني أكثر من اللازم
ألا تعتقدين أنّه يبدو بسيطًا للغاية؟

133
00:09:19,360 --> 00:09:22,080
.لا أعتقد ذلك. إنّه ممتاز

134
00:09:24,020 --> 00:09:25,350
ماذا عن هذا؟

135
00:09:25,350 --> 00:09:27,620
.هذا يلائمك أيضًا

136
00:09:27,620 --> 00:09:29,420
!الأحمر يلائمني أيضًا

137
00:09:29,420 --> 00:09:31,800
.ولكنّي أشعر أنّه عدواني قليلًا

138
00:09:31,800 --> 00:09:34,140
.نعم، إنّه ظريف

139
00:09:34,860 --> 00:09:36,980
...هذا الأحمر ظريف

140
00:09:36,980 --> 00:09:40,080
.ولكنّي أريد زيّ الصيف الأبيض أيضًا

141
00:09:40,080 --> 00:09:42,860
يا يو، أيّهما تفضلين؟

142
00:09:42,860 --> 00:09:45,730
.أعتقد أنّ كلاهما رائعان

143
00:09:45,730 --> 00:09:47,890
هل تنظرين حتّى يا يو؟

144
00:09:48,340 --> 00:09:50,650
.نعم

145
00:09:50,650 --> 00:09:54,010
.تمثال العرض هذه تبدو ككويزومي-سان

146
00:09:54,010 --> 00:09:56,150
!يا إلهي، يو

147
00:09:57,380 --> 00:09:58,160
...يا إلهي

148
00:09:58,540 --> 00:10:02,580
دعوتك للذهاب إلى التسوق
.لأنّك قلت أنّ كويزومي-سان هربت منك

149
00:10:02,580 --> 00:10:03,910
.هذا غير صحيح

150
00:10:05,600 --> 00:10:10,630
كنّا نمشي إلى البيت معًا، ولكنّي
.أضعتها فجأة فحسب

151
00:10:11,590 --> 00:10:13,060
.تعنين أنّها هربت

152
00:10:14,150 --> 00:10:18,270
،إذًا، أتينا كلّ هذا الطريق إلى هنا
لذا ستأتين إلى منزلي، صحيح؟

153
00:10:18,270 --> 00:10:19,760
.سأفعل ذلك

154
00:10:19,760 --> 00:10:22,050
.أمّي خارجة لمناسبة لم شمل فصلها

155
00:10:22,050 --> 00:10:24,390
ما زال الوقت باكرًا، ولكن أتريدين تناول العشاء أولًا؟

156
00:10:24,390 --> 00:10:25,590
.يبدو ذلك جيّدًا

157
00:10:25,590 --> 00:10:26,640
ماذا نأكل؟

158
00:10:26,900 --> 00:10:30,740
المحل الجديد قرب منطقة التسوق
.يحصل على مراجعات جيّدة

159
00:10:30,740 --> 00:10:33,380
يقولون أنّ كريب طحين الحنطة
!السوداء لذيذ للغاية

160
00:10:33,380 --> 00:10:34,500
أتريدين الذهاب؟

161
00:10:35,220 --> 00:10:37,990
...حسنًا

162
00:10:44,200 --> 00:10:46,940
سنتناول الرامن؟

163
00:10:46,940 --> 00:10:47,830
!نعم

164
00:10:48,170 --> 00:10:51,900
علامة تونكتسو رامن التي يضعونها
!بدت جيّدة للغاية

165
00:10:51,900 --> 00:10:54,860
.بحق يا يو، إنّك متسممة من كويزومي-سان تمامًا

166
00:10:54,860 --> 00:10:57,840
.لا يمكنني المقاومة إن ذكر أحدهم رامن تونكتسو

167
00:10:58,200 --> 00:11:00,450
.أنا أتبع نظامًا غذائيًا الآن

168
00:11:00,450 --> 00:11:02,960
.أردت شيئًا خفيفًا وعصريًّا أكثر

169
00:11:02,960 --> 00:11:06,970
ولكن أليس هذا المكان عصريًّا يا ميسا-سان؟

170
00:11:06,970 --> 00:11:09,350
.الموسيقى التي يضعونها عصريّة

171
00:11:09,640 --> 00:11:13,770
،وانظري، إنّهم لا يقدمون ماءً عاديًّا
.بل هذا الشاي طيب الرائحة

172
00:11:13,770 --> 00:11:15,360
!إنّه عصريٌ للغاية

173
00:11:15,360 --> 00:11:16,420
.أعتقد ذلك

174
00:11:16,420 --> 00:11:17,840
أتريدين كأسًا؟

175
00:11:17,840 --> 00:11:19,220
.شكرًا لك

176
00:11:19,220 --> 00:11:21,360
.هذا شاي المريمية

177
00:11:22,530 --> 00:11:24,320
ما الذي ستطلبينه إذًا؟

178
00:11:24,320 --> 00:11:26,780
!شيءٌ حار، حارٌ للغاية

179
00:11:26,780 --> 00:11:28,470
.كان ذلك سريعًا

180
00:11:28,470 --> 00:11:30,930
...أعتقد أنّي سأطلب

181
00:11:30,930 --> 00:11:32,540
أبيض أم أحمر؟

182
00:11:33,110 --> 00:11:37,420
".زبديّة الأصول" أو "زبديّة الابتداع"

183
00:11:37,420 --> 00:11:39,690
...لا يمكنني أخذ قراري بأشياء كهذه

184
00:11:39,690 --> 00:11:41,110
.أسرعي

185
00:11:41,110 --> 00:11:43,220
صحيح، ماذا قالت كويزومي-سان في المرة السابقة؟

186
00:11:43,830 --> 00:11:47,170
.أطلب الأشياء الأساسيّة عندما أذهب إلى مطعم جديد

187
00:11:47,170 --> 00:11:50,100
إن اتبعت نصيحتها، فعليّ طلب
.الأصول" مع حساء أبيض"

188
00:11:50,470 --> 00:11:52,500
...ولكنّها قالت أيضًا

189
00:11:52,500 --> 00:11:56,140
ولكن ليس خطأً بأن تهاجمي مباشرة
.لأكثر غرض يثير اهتمامك

190
00:11:56,140 --> 00:11:58,860
.إن اتبعت هذا، فإنّه "الابتداع" مع الحساء الأحمر

191
00:11:59,450 --> 00:12:00,490
الأصول؟

192
00:12:00,930 --> 00:12:02,110
أم الابتداع؟

193
00:12:03,210 --> 00:12:06,210
ماذا كانت كويزومي-سان لتختار؟

194
00:12:06,620 --> 00:12:09,480
.أتمنّى لو أنّك احترت هكذا بملابسي

195
00:12:09,920 --> 00:12:12,040
.أحمر على ما أعتقد

196
00:12:12,040 --> 00:12:15,540
.دائمًا ما أتّخذ وضعيّة الهجوم يا كويزومي-سان

197
00:12:15,540 --> 00:12:17,500
.حسنًا، حسنًا، تريدين الأحمر

198
00:12:17,500 --> 00:12:20,240
المعذرة! هل يمكننا الطلب من فضلك؟

199
00:12:20,240 --> 00:12:22,130
.نعم، سآتي

200
00:12:23,260 --> 00:12:26,560
أتعتقدين أنّ يمكننا أكل براعم الفاصوليا هذه؟

201
00:12:26,560 --> 00:12:27,930
.أعتقد ذلك

202
00:12:27,930 --> 00:12:30,270
!أيمكنك أكل قدر ما تريد من براعم الفاصوليا هذه؟

203
00:12:33,190 --> 00:12:34,930
!إنّها حارّة ولذيذة

204
00:12:34,930 --> 00:12:36,210
!أحبّ هذا

205
00:12:36,210 --> 00:12:38,480
!يمكن أن يكون هذا طبقًا جانبيًّا لوحده

206
00:12:38,480 --> 00:12:41,490
ولكن أليس من المفترض أن نضعها على الرامن؟

207
00:12:41,490 --> 00:12:44,210
لا أعتقد أنّ هنالك مشكلة بتناولها
.كوجبة خفيفة قليلًا

208
00:12:44,210 --> 00:12:47,010
،وأيضًا، يقولون إن أكلت براعم الفاصوليا قبل وجبة

209
00:12:47,010 --> 00:12:49,600
.فإنّه يساعد على امتصاص الدهون الزائدة

210
00:12:49,600 --> 00:12:51,950
".إنّه ما يدعى "نظام غذائي منخفض الأنسولين

211
00:12:51,950 --> 00:12:55,750
علاوة على ذلك، الكبسائسين في الفلفل
،الأحمر تساعد على تأييض الدهون بصورة أسرع

212
00:12:55,750 --> 00:12:58,230
.وشاي المريمية يمنع اختزان الدهون

213
00:12:58,230 --> 00:12:59,000
!إنّه مثالي

214
00:12:59,250 --> 00:13:02,630
.مذهل، إنّك خبيرة حقًّا بما يتعلّق بالجمال

215
00:13:02,630 --> 00:13:03,970
.اتركي الأمر لي

216
00:13:06,120 --> 00:13:07,800
.شكرًا لكما على الانتظار

217
00:13:07,800 --> 00:13:08,350
.ها هو

218
00:13:09,000 --> 00:13:11,100
.واحد رامن كاراكا وواحد رامن أكامارو

219
00:13:21,340 --> 00:13:22,980
!لنبدأ الأكل

220
00:13:48,390 --> 00:13:50,320
.يمكنك الحصول على معكرونة إضافيّة هنا

221
00:13:50,320 --> 00:13:51,680
.أعتقد أنّي سأطلبها

222
00:13:51,680 --> 00:13:55,450
.هذا خفيف على رغم أنّه تونكتسو
.أشعر أنّ بإمكاني تناول المزيد

223
00:13:55,450 --> 00:13:58,140
أتريدين طلب معكرونة إضافيّة وتقاسمها؟

224
00:13:58,140 --> 00:14:00,400
ألستِ تتبعين نظامًا غذائيًّا؟

225
00:14:00,400 --> 00:14:02,820
!تناولت براعم الفاصوليا، لذا لا بأس

226
00:14:02,820 --> 00:14:03,990
.صحيح

227
00:14:05,680 --> 00:14:07,360
.شكرًا على الطعام

228
00:14:07,360 --> 00:14:09,410
.كان ذلك لذيذًا

229
00:14:09,960 --> 00:14:11,210
.أشعر بالرضا

230
00:14:11,210 --> 00:14:14,510
ولكن تناول ذلك الطعام الحار
.جعلني أريد أكل شيء حلو

231
00:14:14,510 --> 00:14:16,070
ماذا عن نظامك الغذائي؟

232
00:14:16,070 --> 00:14:18,420
.شربت شاي المريمية لذا لا بأس

233
00:14:18,700 --> 00:14:21,250
أتريدين شراء الكعك من المحطة
وأخذه إلى المنزل إذًا؟

234
00:14:21,250 --> 00:14:22,610
!يبدو ذلك جيّدًا

235
00:14:34,250 --> 00:14:37,160
.واحد شيرومارو كلاسيكي ورز مينتايكو على الجانب

236
00:14:48,040 --> 00:14:49,280
.حان وقت الأكل

237
00:15:20,540 --> 00:15:21,850
.المعذرة

238
00:15:21,850 --> 00:15:24,500
.أريد معكرونة إضافيّة وطلب واحد من غيوزا

239
00:15:24,500 --> 00:15:26,480
!حسنًا

240
00:15:34,200 --> 00:15:36,830
.مصدر الطاقة

241
00:15:54,480 --> 00:15:57,100
.لم يكن الامتحان الوهمي جيّدًا اليوم

242
00:15:57,860 --> 00:16:02,850
كنت متوترة للغاية، لم أتناول شيئًا
.طوال اليوم، ولكنّي لا أشعر بالجوع إطلاقًا

243
00:16:04,720 --> 00:16:07,110
.سأشتري شرابًا وأرجع إلى المنزل

244
00:16:07,580 --> 00:16:09,660
،ما يزال ذلك بعيدًا

245
00:16:09,660 --> 00:16:14,000
ولكنّي أشعر بالاكتئاب منذ الآن
.بالتفكير بشأن اختبار القبول والتخطيط للمهنة

246
00:16:15,570 --> 00:16:16,990
!مرحبًا

247
00:16:17,360 --> 00:16:20,420
.ربّما أقلق أكثر من اللازم

248
00:16:22,760 --> 00:16:23,620
كويزومي-سان؟

249
00:16:24,060 --> 00:16:26,760
ما الذي تفعلينه هنا في يوم الأحد؟

250
00:16:26,760 --> 00:16:30,000
.أحبّ زاوية الأكل في الداخل خاصتهم

251
00:16:30,000 --> 00:16:32,350
.هذا لا يجيب سؤالي

252
00:16:32,350 --> 00:16:37,230
غيرت خطتي الاعتياديّة لليوم
.وأتيت للاستمتاع برامن محل البقالة

253
00:16:37,230 --> 00:16:38,150
.هذه قمامة الورق

254
00:16:38,150 --> 00:16:39,310
.إنّها الحقيقة

255
00:16:39,310 --> 00:16:41,390
.هناك بعض الأوعية الفارغة بالفعل

256
00:16:41,900 --> 00:16:43,740
...شهيّة غير متزعزعة للرامن

257
00:16:47,280 --> 00:16:49,430
ولا تزال تأكل المزيد؟

258
00:16:49,430 --> 00:16:51,040
.سأذهب الآن

259
00:16:51,040 --> 00:16:51,820
.نعم

260
00:16:52,220 --> 00:16:54,260
.جافّة كالعادة

261
00:16:54,920 --> 00:16:58,860
لم أتصور أن يمتلك محل بقالة
.تشكيلة اختيارات جيّدة من الرامن

262
00:16:58,860 --> 00:16:59,950
.لديهم

263
00:17:00,280 --> 00:17:03,190
يمكنك تقسيم رامن محل البقالة
.إلى ثلاثة أنواع تقريبًا

264
00:17:03,190 --> 00:17:05,200
.النوع المبرّد أولًا

265
00:17:05,200 --> 00:17:08,050
يمتد من التي يمكن تسخينها في الميكروويف
،مع الكثير من الإضافات

266
00:17:08,050 --> 00:17:11,100
إلى المعكرونة الغير مطبوخة
.لغرض إعدادها في المنزل

267
00:17:11,100 --> 00:17:11,890
...هذا سيّئ

268
00:17:11,890 --> 00:17:13,840
.يبدو أنّي فعّلت شيئًا

269
00:17:13,840 --> 00:17:17,160
.التالي، الرامن المثلج، المحبوب مؤخرًا

270
00:17:17,160 --> 00:17:21,050
بسبب تقدمات حديثة بالتكنولوجيا
فإنّ التثليج وذوبان الجليد لا يؤثران

271
00:17:21,050 --> 00:17:24,540
،على ملمس أو مذاق المعكرونة
.لذا يمكن الاستمتاع بها بكامل مذاقها

272
00:17:24,540 --> 00:17:27,440
.علاوة على ذلك، نسبة أداء أسعارهم مذهلة

273
00:17:27,860 --> 00:17:29,840
هذا ينطبق على رغم أنّ الماء القلوي

274
00:17:29,840 --> 00:17:32,320
.في المعكرونة حساس للتغيّرات الحراريّة

275
00:17:32,780 --> 00:17:34,710
ألا تعتقدين أنّ ذلك مذهل؟

276
00:17:34,710 --> 00:17:36,950
.لا أعتقد أنّي أفهم جيّدًا

277
00:17:37,240 --> 00:17:40,290
.وهذا غنيّ عن الذكر، ولكن هنالك أكواب أيضًا

278
00:17:40,290 --> 00:17:42,800
بصرف النظر عن المصنعين المعروفين
،وعلامات المحلات التجارية

279
00:17:42,800 --> 00:17:45,530
.هنالك أنواع كثيرة معدّة بالتعاون مع مطاعم شهيرة

280
00:17:45,530 --> 00:17:48,670
.دقّة نكهة حسائهم جيّدة جدًّا برأيي

281
00:17:49,520 --> 00:17:51,960
بما أنّك ذكرت ذلك، أعتقد أنّي
.رأيت بعضًا من هذه المحلات

282
00:17:52,490 --> 00:17:57,430
بالمناسبة، نكهتي المفضلة حاليًّا هي
.رامن السردين المجفف بصلصة الصويا البسيط هذا

283
00:17:57,430 --> 00:18:01,970
دائمًا ما أشتري بيض الينابيع الساخنة المسلوق
.ورزمة من رقائق التمبورا كإضافات

284
00:18:01,970 --> 00:18:05,990
عندما تضيفين البيض، فإنّه
،يخفف من مذاق الحساء قليلًا

285
00:18:05,990 --> 00:18:08,840
.لذا فإنّ الخدعة هي إضافة كميّة ماء أقل من الطبيعي

286
00:18:08,840 --> 00:18:12,320
الحساء المسكي ورقائق التمبورا
.تتماشيان بشكل مثالي معًا

287
00:18:12,320 --> 00:18:13,760
،بينما يبدو كطعام غير صحي

288
00:18:13,760 --> 00:18:16,930
.ولكنّه قريب من تجربة أودون تسوكيمي تانوكي

289
00:18:20,020 --> 00:18:24,520
المتعة الحقيقيّة في رامن
محل البقالة هي التخصيص

290
00:18:24,520 --> 00:18:27,710
الذي يمكنك إنجازه بالأغراض
.المحدودة الموجودة هنا

291
00:18:28,450 --> 00:18:30,330
!شكرًا جزيلًا لك

292
00:18:30,330 --> 00:18:31,670
.هذا غريب

293
00:18:31,670 --> 00:18:34,580
ما الذي يفعله كوب الرامن أمامي؟

294
00:18:34,580 --> 00:18:35,760
.حان وقت الأكل

295
00:18:35,760 --> 00:18:38,880
.كانت شهيتي منسدة قبل قليل

296
00:18:46,300 --> 00:18:49,770
أتقلقين حول ما ستفعلينه بعد
التخرج يا كويزومي-سان؟

297
00:18:59,240 --> 00:19:00,380
.شكرًا لك

298
00:19:01,200 --> 00:19:03,260
.حسنًا إذًا، لنأكل

299
00:19:22,930 --> 00:19:24,360
.حان وقت الأكل

300
00:20:11,000 --> 00:20:13,170
.سيكون هذا 165 ين

301
00:20:13,170 --> 00:20:14,760
.سأدفع من خلال هاتفي

302
00:20:14,760 --> 00:20:18,220
.غريب... الرامن يبيع كثيرًا اليوم

303
00:20:22,940 --> 00:20:25,240
.ستأكل المزيد كما توقعت

304
00:20:25,800 --> 00:20:27,720
.إنّها لا تتزعزع حقًّا

305
00:22:11,590 --> 00:22:16,640
.أتساءل أين كويزومي-سان اليوم

306
00:22:17,110 --> 00:22:18,790
.والآن، قصيدة

307
00:22:18,790 --> 00:22:20,220
.كويزومي-سان"

308
00:22:20,220 --> 00:22:22,160
.آه يا كويزومي-سان

309
00:22:22,160 --> 00:22:23,320
".كويزومي-سان

310
00:22:23,770 --> 00:22:25,850
!سحقًا! الـ"ن" في "سان" مقطع لفظي إضافي

311
00:22:25,850 --> 00:22:27,870
من يهتم بذلك؟

312
00:22:27,870 --> 00:22:29,990
.ليس لديّ الطاقة للتعليق حتّى