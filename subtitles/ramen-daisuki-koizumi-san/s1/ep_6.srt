1
00:00:22,970 --> 00:00:24,750
.مرحبًا

2
00:02:09,960 --> 00:02:11,480
.شكرًا على الانتظار

3
00:02:11,480 --> 00:02:13,890
.طبق رامن السّردين المجفّف الرّائع خاصّتنا

4
00:02:18,090 --> 00:02:19,240
.وقت الأكل

5
00:02:39,980 --> 00:02:41,180
.شكرًا لك

6
00:02:41,180 --> 00:02:43,260
!شكرًا جزيلاً

7
00:03:05,600 --> 00:03:06,940
.شكرًا على الطّعام

8
00:03:12,500 --> 00:03:14,210
.أشعر بالنّعاس

9
00:03:17,670 --> 00:03:18,920
ما الّذي تريده يو؟

10
00:03:20,090 --> 00:03:20,750
نعم؟

11
00:03:20,750 --> 00:03:23,190
مرحبًا يا أخي. أين أنت الآن؟

12
00:03:23,190 --> 00:03:26,640
ربّما تكون طالبًا جامعيًّا، لكن لا يعني
.ذلك أنّ بإمكانك الاحتفال طوال اللّيل

13
00:03:26,640 --> 00:03:27,870
.أنا أعذرك

14
00:03:27,870 --> 00:03:30,420
.لقد أنهيت للتّوّ دوريّة ليل في الحانة

15
00:03:30,420 --> 00:03:31,310
.هكذا إذًا

16
00:03:31,800 --> 00:03:33,980
حسنًا، أتريدني أن أترك لك بعض الطّعام؟

17
00:03:33,980 --> 00:03:35,830
لديك صفوف صباحيّة، صحيح؟

18
00:03:35,830 --> 00:03:37,800
.يا إلهي، أشعر بنعاس شديد

19
00:03:37,800 --> 00:03:39,740
.ربّما سأفوّت الحصّة الأولى

20
00:03:40,360 --> 00:03:41,240
ماذا؟

21
00:03:59,570 --> 00:04:01,680
مرحبًا يا أخي؟

22
00:04:01,680 --> 00:04:03,310
مرحبًا؟

23
00:04:03,310 --> 00:04:04,940
هل تسمعني يا أخي؟

24
00:04:05,420 --> 00:04:07,850
هل ما زلت على الخطّ؟

25
00:04:09,100 --> 00:04:14,060
،سأتناول الرّامن على الإفطار
.ثمّ سأحضر فصلي

26
00:04:14,870 --> 00:04:16,560
.أنا يقظ فجأة

27
00:04:17,710 --> 00:04:19,190
عمّ تحدّث؟

28
00:04:19,190 --> 00:04:21,570
هل هنالك أماكن مفتوحة في هذا
الوقت من الأساس؟

29
00:04:22,150 --> 00:04:23,170
.نعم

30
00:04:23,170 --> 00:04:27,130
لقد شممت رائحة سردين مجفّف
.من فتاة جميلة قبل قليل

31
00:04:29,920 --> 00:04:32,960
.أخي، أنت متعب كثيرًا

32
00:04:33,690 --> 00:04:35,780
.عليك أن ترتاح قليلاً

33
00:04:36,460 --> 00:04:37,550
هل تستمع لي؟

34
00:04:37,550 --> 00:04:38,520
—أخي

35
00:04:42,330 --> 00:04:43,750
.مرحبًا

36
00:04:45,730 --> 00:04:52,090
تناول الرّامن على الفطور شائع
.عند سكّان شيزوُكا وفوكوُكا

37
00:04:52,090 --> 00:04:54,600
والآن، أصبح رامن الصّباح
.يُصنّع كوجبة خفيفة أخيرًا

38
00:05:13,750 --> 00:05:15,620
.الجوّ حارّ

39
00:05:17,620 --> 00:05:18,500
!الجوّ حارّ جدًّا

40
00:05:18,500 --> 00:05:20,880
!هذا الجوّ حارّ للغاية

41
00:05:20,880 --> 00:05:22,520
!ماذا؟ تريدينني أن أخلع كلّ ملابسي؟

42
00:05:20,880 --> 00:05:22,680
!حارّ، حارّ، حارّ، حارّ، حارّ

43
00:05:22,520 --> 00:05:24,370
.اهدآ قليلاً

44
00:05:22,680 --> 00:05:25,630
!لا، لا، لا، لا، لا

45
00:05:24,370 --> 00:05:25,630
.أنتما تزيدان الأمر سوءًا فحسب

46
00:05:25,630 --> 00:05:28,270
.أريد بعض العصير أو المثلّجات

47
00:05:28,270 --> 00:05:29,640
.أوافقك الرّأي

48
00:05:30,360 --> 00:05:33,830
ألا يبدو أنّ كلّ ما أكلناه هو طعام بارد مؤخّرًا؟

49
00:05:33,830 --> 00:05:38,680
،"نعم، أكلنا البارحة في "ناينتي-أيس
...وأكلنا اليوم الّذي قبله

50
00:05:38,680 --> 00:05:41,000
عند عربة الزّبادي المثلّج، صحيح؟

51
00:05:41,000 --> 00:05:45,130
صحيح، صحيح. قبل ذلك... ماذا كان؟

52
00:05:45,130 --> 00:05:47,690
.في كلّ الأحوال، هذا غير متوازن على الإطلاق

53
00:05:47,690 --> 00:05:50,330
،لقد استنزفت الحرارة كلّ طاقتي
.لا أستطيع أن أمشي خطوة أخرى

54
00:05:50,330 --> 00:05:53,990
ولا أنا. ولا أرغب في أكل أيّ
.شيء آخر إلاّ إذا كان باردًا

55
00:05:53,990 --> 00:05:55,280
.صحيح

56
00:05:55,280 --> 00:05:56,620
إلى أين سنذهب اليوم إذًا؟

57
00:05:56,620 --> 00:05:58,410
...لنفكّر

58
00:06:04,000 --> 00:06:05,300
!كويزومي-سان

59
00:06:08,760 --> 00:06:10,800
!مرحبًا يا كويزومي-سان

60
00:06:11,200 --> 00:06:13,600
!لنذهب لتناول شيء بارد معًا

61
00:06:13,600 --> 00:06:14,350
موافقة؟ موافقة؟

62
00:06:14,350 --> 00:06:15,260
.هذا لا يُحتمل

63
00:06:15,260 --> 00:06:16,240
.لا أريد

64
00:06:17,820 --> 00:06:22,020
.سأذهب لتناول بعض الرّامن

65
00:06:23,800 --> 00:06:25,780
مع أنّ الجوّ ساخن هكذا؟

66
00:06:26,880 --> 00:06:29,260
،أعرف أنّك مهووسة بالرّامن
!لكنّ اليوم بالتّحديد لا يناسب ذلك

67
00:06:29,860 --> 00:06:31,910
.هذا مبهر جدًّا من ناحية ما

68
00:06:31,910 --> 00:06:34,500
أقصد تناول الرّامن رغم هذا
.الجوّ السّاخن الحارق

69
00:06:34,500 --> 00:06:36,680
!سأذهب لتناول الرّامن معك

70
00:06:36,680 --> 00:06:38,380
!سأذهب معك يا كويزومي-سان

71
00:06:38,380 --> 00:06:40,620
!إنّك تبكين وتتعرّقين من الآن

72
00:06:40,950 --> 00:06:41,960
.لا داعي لذلك

73
00:06:43,000 --> 00:06:46,410
،ولكي أوضّح سوء الفهم هذا فحسب

74
00:06:46,410 --> 00:06:48,460
.لن أتناول رامن عاديًّا هذا اليوم

75
00:06:48,460 --> 00:06:50,180
...سأتناول رامن معيّنًا

76
00:06:53,060 --> 00:06:54,970
.إنّه رامن هياشي

77
00:06:55,950 --> 00:06:58,480
رامن... هياشي؟

78
00:06:59,440 --> 00:07:01,730
ما هو بالتّحديد؟

79
00:07:03,920 --> 00:07:07,540
.أعتقد أنّ يو ذهبت مع كويزومي في نهاية المطاف

80
00:07:07,540 --> 00:07:10,990
يساورني الفضول في الحقيقة
.بشأن طبيعة رامن هياشي أيضًا

81
00:07:11,360 --> 00:07:13,480
.إضافة إلى أنّ نظّارتك لن تغطّى بالبخار

82
00:07:13,480 --> 00:07:14,490
.توقّفي

83
00:07:15,440 --> 00:07:17,330
،لكن عند تناول الطّعام في الخارج في الصّيف

84
00:07:17,330 --> 00:07:19,740
.فلا يوجد وجبات باردة كثيرة لنختار منها

85
00:07:19,740 --> 00:07:21,000
ماذا؟ لِمَ لا؟

86
00:07:21,000 --> 00:07:24,760
في العادة، تشغّل المطاعم مكيّفات
.الهواء بكامل طاقتها في الصّيف

87
00:07:24,760 --> 00:07:27,080
"عند الدّخول إلى محلّ "ستارباكس
،"لطلب كوب "فرابّوتشينو

88
00:07:27,080 --> 00:07:31,010
ينتهي بنا المطاف نطلب قهوة ساخنة عند
.نهاية صفّ الانتظار لأنّنا أصبحنا نشعر بالبرد

89
00:07:31,640 --> 00:07:33,890
.تبدو الحياة معقّدة بالنّسبة لك

90
00:07:34,280 --> 00:07:38,960
على أيّ حال، يبدو أنّ هنالك
.الكثير من أنواع رامن هياشي

91
00:07:38,960 --> 00:07:40,600
!ماذا؟ أريني، أريني

92
00:07:41,200 --> 00:07:44,000
،عندما أفكّر في المعكرونة الباردة
،فأنا أتوقّع شيئًا مثل الرّيمن

93
00:07:44,000 --> 00:07:45,750
.لكنّ هذا يبدو مختلفًا تمامًا

94
00:07:45,750 --> 00:07:47,280
ما هذه؟

95
00:07:47,280 --> 00:07:49,050
!إنّها تبدو كأطباق مثلّجات ناعمة

96
00:07:49,050 --> 00:07:51,320
...تبدو الزّبديّات الزّجاجيّة باردة جدًّا

97
00:07:51,320 --> 00:07:54,410
نعم، حتّى أنّهم يقدّمون نسخة باردة
!عن "تانتانمن"، طبقي المفضّل

98
00:07:54,410 --> 00:07:55,620
!أريد أكله

99
00:07:56,100 --> 00:07:57,690
لماذا لا تأكلين بعض الرّامن الحارّ أيضًا؟

100
00:07:57,690 --> 00:07:59,080
.إن أكلت شيئًا حارًّا فسترتفع درجة حرارة جسمك

101
00:07:59,080 --> 00:08:01,540
.معدتي ضعيفة، لذلك لا أستطيع

102
00:08:01,540 --> 00:08:04,440
،إن أكلت شيئًا حارًّا هكذا
...فإنّني في اليوم التّالي سأكون

103
00:08:04,440 --> 00:08:07,340
!انظري، لديهم رامن هياشي هنا أيضًا

104
00:08:09,130 --> 00:08:10,260
...أنجعل من هذا

105
00:08:10,260 --> 00:08:11,590
وجبة عشائنا؟

106
00:08:12,070 --> 00:08:16,640
لكن ألم تقولي أنّ مكيّف الهواء
يجعلك لا ترغبين في الطّعام البارد؟

107
00:08:16,640 --> 00:08:18,510
.لا تقلقي بشأن ذلك

108
00:08:19,430 --> 00:08:21,670
.سأرتدي هذا ابتداءً من هذه السّنة

109
00:08:21,670 --> 00:08:23,520
...إذًا فستأكلينه بالفعل

110
00:08:29,590 --> 00:08:33,530
أتى رامن هياشي في الأصل
.من مقاطعة ياماغاتا

111
00:08:33,530 --> 00:08:40,150
قُدّم هذا الطّبق قبل ستّين عامًا مضت
.في محلّ سوبا وليس في محلّ رامن

112
00:08:40,150 --> 00:08:41,290
فعلاً؟

113
00:08:41,290 --> 00:08:43,830
كانوا يعدّون الرّامن في محلاّت السّوبا؟

114
00:08:43,830 --> 00:08:46,260
.كما أنّه موجود منذ زمن طويل أيضًا

115
00:08:46,260 --> 00:08:48,000
!شكرًا على الانتظار

116
00:08:49,120 --> 00:08:53,130
لديّ طبق رامن مرّ بطماطم حمراء
.وطبق رامن تسوتّاي

117
00:08:54,120 --> 00:08:56,760
!مذهل، هنالك ثلج بداخله

118
00:08:58,880 --> 00:09:00,560
!الزّبديّة باردة للغاية

119
00:09:02,230 --> 00:09:05,140
.تبدو الرّائحة أخفّ من الرّامن العاديّ

120
00:09:05,490 --> 00:09:10,360
لكنّ رامن هياشي مختلف تمامًا
من تشوكا هياشي، صحيح؟

121
00:09:10,360 --> 00:09:13,150
،مثلاً، إنّه يُقدّم مع الكثير من الحساء
.كما لا تفوح منه رائحةٌ كالخلّ أبدًا

122
00:09:13,610 --> 00:09:17,510
"في هوكّايدو، يسمّون "رامن هياشي
."بـ"شوكا هياشي

123
00:09:17,510 --> 00:09:21,960
،وهكذا في منطقة كانساي
!"يسمّون "رامن هياشي" بـ"ريمن

124
00:09:21,960 --> 00:09:23,540
.هذا معقّد بشكل غير ضروريّ

125
00:09:24,220 --> 00:09:28,200
إذًا هل هذا الحساء عبارة عن
حساء ساخن تمّ تبريده؟

126
00:09:28,200 --> 00:09:31,690
يحتوي حساء الرّامن في العادة
،الكثير من دهن الحيوانات

127
00:09:31,690 --> 00:09:34,550
لذلك إن قمنا بتبريده، فسنحصل
.على الكثير من كتل الشّحم

128
00:09:34,550 --> 00:09:36,540
.صحيح

129
00:09:36,540 --> 00:09:39,240
.المكوّن الرّئيسيّ هو عظام الخنزير أو الدّجاج

130
00:09:39,240 --> 00:09:43,830
لهذا السّبب نستعمل الكثير من الدّهن المستخرج
من الخضروات للحفاظ على القوام

131
00:09:43,830 --> 00:09:49,350
وإعداد حصص منفصلة من الحساء والصّلصة من أجل
.رامن هياشي فقط لتحديد النّكهة بشكل جيّد

132
00:09:49,850 --> 00:09:52,000
،بما أنّ العمليّة معقّدة للغاية

133
00:09:52,000 --> 00:09:56,120
.يتمّ إعداد الطّبق في شهور الصّيف فحسب

134
00:09:56,120 --> 00:09:58,120
.يبدو هذا عملاً مضنيًا للغاية

135
00:09:58,120 --> 00:10:00,890
.إنّها لذّة موسميّة صيفيّة بشكل دقيق

136
00:10:00,890 --> 00:10:02,050
حسنًا، هل نأكل؟

137
00:10:02,050 --> 00:10:02,830
!نعم

138
00:10:04,390 --> 00:10:05,830
.وقت الأكل

139
00:10:12,460 --> 00:10:13,720
.هذا أشبه بردّة فعل

140
00:10:13,720 --> 00:10:16,340
.صحيح. إنّه بارد

141
00:10:17,140 --> 00:10:18,840
!شكرًا على الانتظار

142
00:10:19,830 --> 00:10:20,910
.يبدو هذا لذيذًا

143
00:10:20,910 --> 00:10:22,600
!هذا رائع

144
00:10:23,350 --> 00:10:25,180
!وقت الأكل

145
00:11:33,810 --> 00:11:35,890
!إنّه بارد

146
00:11:37,530 --> 00:11:39,790
!شكرًا على الطّعام

147
00:11:42,370 --> 00:11:46,600
ألا تشتهين الطّعام السّاخن بمجرّد
أكل الطّعام البارد؟

148
00:11:47,160 --> 00:11:49,200
...أين سأذهب بعد هذا

149
00:11:49,200 --> 00:11:51,980
!سأذهب معك يا كويزومي-سان

150
00:12:03,440 --> 00:12:05,540
!انظري لتلك الفتاة الّتي ترتدي اليوكاتا

151
00:12:05,540 --> 00:12:06,670
.إنّها ظريفة

152
00:12:06,670 --> 00:12:08,620
هل هنالك مهرجان ما اليوم؟

153
00:12:08,620 --> 00:12:12,000
.ليس على حدّ علمي

154
00:12:12,000 --> 00:12:15,980
إلى أين تعتقدين أنّها ذاهبة؟

155
00:13:26,470 --> 00:13:28,720
هل أنت تائهة أيّتها الصّغيرة؟

156
00:13:28,720 --> 00:13:30,700
هل أنت بخير؟

157
00:13:30,950 --> 00:13:33,370
!أمّي، أمّي

158
00:13:41,950 --> 00:13:43,050
!مرحبًا

159
00:13:43,410 --> 00:13:44,940
طاولة لشخصين، صحيح؟

160
00:13:46,050 --> 00:13:48,660
.كلاّ. أنا وحدي

161
00:13:51,600 --> 00:13:52,850
أمّي

162
00:13:53,790 --> 00:13:55,100
ألمانيّة؟

163
00:13:55,520 --> 00:13:58,100
.كلاّ، اسمي هو كويزومي

164
00:14:17,750 --> 00:14:19,330
ما هو اسمك؟

165
00:14:19,830 --> 00:14:20,670
.هانا

166
00:14:21,510 --> 00:14:24,590
.لقد افترقت عن أمّي

167
00:14:29,800 --> 00:14:31,030
...أمّي

168
00:14:31,030 --> 00:14:32,180
.لا تقلقي

169
00:14:32,640 --> 00:14:36,470
،سأخبر العاملين في المطعم
.سوف يبحثون عن أمّك

170
00:14:36,470 --> 00:14:38,290
!شكرًا على الانتظار

171
00:14:39,520 --> 00:14:41,020
.طبق رامن شويو

172
00:14:41,800 --> 00:14:43,470
...المعذرة، هذه الفتاة

173
00:14:43,470 --> 00:14:45,840
تحتاج طبقها الخاصّ؟

174
00:14:45,840 --> 00:14:46,810
.بالطّبع. لحظة واحدة

175
00:14:46,810 --> 00:14:48,930
—كلاّ، أعني أنّها

176
00:14:53,360 --> 00:14:54,360
.زبديّة أطفال

177
00:14:54,360 --> 00:14:55,440
.تفضّلي

178
00:14:55,440 --> 00:14:56,420
...المعذرة

179
00:14:58,460 --> 00:14:59,710
...أنا جائعة

180
00:15:03,660 --> 00:15:07,630
أعتقد أنّنا سنبحث عن أمّك بمجرّد
.أن ننتهي من الأكل

181
00:15:08,280 --> 00:15:09,900
.لنأكل معًا

182
00:15:11,710 --> 00:15:17,020
لو كنتُ أعرف، لطلبت نصف
.حصّة إضافيّة

183
