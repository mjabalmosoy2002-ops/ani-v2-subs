1
00:00:10,660 --> 00:00:12,860
.أشعر أنّه كان أحلى

2
00:00:13,400 --> 00:00:15,380
هل أضيف المزيد من السّكّر فحسب؟

3
00:00:15,380 --> 00:00:16,370
!مهلاً يا يو

4
00:00:16,620 --> 00:00:18,460
كم زبديّة تحاولين إطعامنا؟

5
00:00:18,460 --> 00:00:20,630
!لا نستطيع تناول المزيد

6
00:00:20,630 --> 00:00:23,630
ماذا؟ ألا يمكنكما تناول واحدة أخرى بعد؟

7
00:00:23,630 --> 00:00:24,360
.كلاّ

8
00:00:24,360 --> 00:00:25,500
.شكرًا على الطّعام

9
00:00:26,000 --> 00:00:29,000
.أعتقد أنّه رامن جيّد من الآن

10
00:00:29,500 --> 00:00:30,800
ما الّذي لا يرضيك فيه؟

11
00:00:30,800 --> 00:00:33,860
.كلاّ، إنّه مختلف تمامًا

12
00:00:34,490 --> 00:00:38,680
أتذكّر ذلك الرّامن اللّذيذ الّذي تناولتُه
.في أوساكا عندما كنت صغيرة

13
00:00:38,680 --> 00:00:42,040
أعتقد أنّ المطعم كان قريبًا
.من منزل جدّتي

14
00:00:42,040 --> 00:00:45,300
.تذكّرتُه البارحة بينما كنتُ أخلد للنّوم

15
00:00:48,920 --> 00:00:50,270
.شكرًا على الطّعام

16
00:01:02,070 --> 00:01:03,640
!إنّه لذيذ جدًّا

17
00:01:03,640 --> 00:01:04,910
!لذيذ

18
00:01:05,850 --> 00:01:10,840
كنتُ آمل أن أستطيع إعادة نسخ
.ذلك المذاق لإبهار كويزومي-سان

19
00:01:11,270 --> 00:01:14,290
من الرّائع أنك تستطيعين إعداد
.رامن لذيذ كهذا

20
00:01:14,290 --> 00:01:15,760
.لنكن صديقتين

21
00:01:15,760 --> 00:01:17,070
!أودّ ذلك

22
00:01:18,080 --> 00:01:19,580
...لِمَ يبدو هذا

23
00:01:19,580 --> 00:01:21,340
قولاً أسهل من الفعل؟

24
00:01:21,340 --> 00:01:25,540
لكنّني لا أستطيع تذكّر الرّامن
.بشكل واضح كفاية لأعيد نسخه

25
00:01:25,540 --> 00:01:28,930
هل تعرفين على الأقلّ اسم
المطعم أو قائمة طعامهم؟

26
00:01:28,930 --> 00:01:32,320
.كنت صغيرة جدًّا، لذلك لا أذكر

27
00:01:33,750 --> 00:01:37,880
كما أنّه في أوساكا، لذلك لا يمكننا
.اصطحابها إليه فحسب أيضًا

28
00:01:37,880 --> 00:01:40,960
لماذا لا تسألين شخصًا من
عائلتك عن الأمر إذًا؟

29
00:01:40,960 --> 00:01:42,160
أخوك على سبيل المثال؟

30
00:01:42,160 --> 00:01:44,620
!أحسنت يا جون! أنت ذكيّة للغاية

31
00:01:46,290 --> 00:01:47,630
.إنّها من يو

32
00:01:47,630 --> 00:01:49,240
شقيقتك؟

33
00:01:49,240 --> 00:01:52,800
."نعم... وتقول "أجبني في الحال يا أخي

34
00:01:53,250 --> 00:01:56,060
هل تتذكّر الرّامن الّذي أكلناه
في الماضي في أوساكا؟

35
00:01:56,060 --> 00:01:59,300
أقصد حين خرجنا جميعًا عندما
.كنت قد دخلتُ الحضانة حديثًا

36
00:01:59,610 --> 00:02:01,560
"أيّ نوع من الرّامن تناولنا حينها؟"

37
00:02:01,560 --> 00:02:03,030
".أخبرني رجاءً"

38
00:02:03,030 --> 00:02:06,310
.صحيح، نعم. أتذكّر ذلك الرّامن

39
00:02:07,850 --> 00:02:09,190
!لقد أجاب

40
00:02:09,190 --> 00:02:10,310
.توقّعت هذا من أخي

41
00:02:10,710 --> 00:02:12,360
...صحيح، لقد كان

42
00:02:12,360 --> 00:02:14,070
."رامن لذيذ"

43
00:02:16,920 --> 00:02:19,200
.لم أكن أسألك عن رأيك

44
00:02:19,560 --> 00:02:22,040
!ماذا؟! ما خطب يو؟

45
00:02:22,040 --> 00:02:24,170
لماذا يصرخ أوساوا؟

46
00:02:22,040 --> 00:02:26,200
!أخبرتها، وهكذا تعاملني؟

47
00:02:24,170 --> 00:02:26,200
من يدري؟ شجار أشقّة؟

48
00:02:26,560 --> 00:02:28,150
.لا يمكن الاعتماد عليه

49
00:02:28,150 --> 00:02:30,210
.عليّ تذكّره بنفسي

50
00:02:31,710 --> 00:02:35,530
كان يحتوي على خضار ورقيّ من
...نوع ما ولحم مقطّع

51
00:02:35,530 --> 00:02:40,880
.كان الحساء حلوًا قليلاً، مثل صلصة سوكياكي

52
00:02:40,880 --> 00:02:43,220
.لكنّها لم تكن نكهة خفيفة بشكل خاصّ

53
00:02:43,560 --> 00:02:45,850
.على أيّ حال، كان رامن لذيذًا

54
00:02:45,850 --> 00:02:47,480
.هذه ليست معلومة مضبوطة كفاية

55
00:02:47,480 --> 00:02:49,440
رامن لذيذ؟

56
00:02:49,440 --> 00:02:50,860
...تحديق

57
00:02:50,860 --> 00:02:52,190
!كـ-كويزومي-سان؟

58
00:02:52,510 --> 00:02:56,020
المعذرة. لا يكون لي أيّ شأن
،هنا في العادة

59
00:02:56,020 --> 00:02:59,430
لكن كنت أتمشّى في الرّواق
.عندما شممتُ رائحة رامن

60
00:02:59,430 --> 00:03:02,030
!نعم، حسنًا! تفضّلي

61
00:03:02,030 --> 00:03:04,960
.لا أصدّق أنّ هذا ينفع

62
00:03:02,360 --> 00:03:04,880
!تعالي، اجلسي

63
00:03:04,880 --> 00:03:06,370
.المعذرة

64
00:03:12,870 --> 00:03:15,540
.إنّه... لا يزال في مرحلة التّطوير

65
00:03:32,100 --> 00:03:33,690
.شكرًا على الطّعام

66
00:03:35,500 --> 00:03:41,670
بالمناسبة، كنتِ تتحدّثين عن رامن
.بنيتِ طبقك هذا عليه

67
00:03:41,670 --> 00:03:42,700
...أيعقل أن يكون

68
00:03:44,200 --> 00:03:46,200
رامن لذيذ"؟"

69
00:03:46,200 --> 00:03:50,580
.ماذا؟ نعم، لقد كان لذيذًا

70
00:03:50,820 --> 00:03:54,830
لأنّ فرعهم الرّئيسيّ موجود
،في دونبوري أوساكا

71
00:03:55,200 --> 00:03:57,120
.لكن ثمّة فرع في طوكيو أيضًا

72
00:03:57,120 --> 00:03:59,350
مهلاً، فعلاً؟! أين؟

73
00:03:59,350 --> 00:04:00,840
!أريد الذّهاب إليه

74
00:04:01,790 --> 00:04:03,000
...لا أظنّ أنّنا نستطيع

75
00:04:03,000 --> 00:04:05,200
.أكل المزيد من الرّامن اليوم

76
00:05:42,420 --> 00:05:46,290
.أعتقد أنّ هذا ما كنتِ تتحدّثين عنه

77
00:05:47,360 --> 00:05:47,990
ماذا؟

78
00:05:49,530 --> 00:05:51,300
!رامن لذيذ

79
00:05:53,700 --> 00:05:54,980
!مرحبًا

80
00:05:54,980 --> 00:05:56,820
.تفضّلا بالجلوس حيثما تريدان

81
00:05:56,820 --> 00:05:58,520
!دخلت زبونتان

82
00:05:58,520 --> 00:05:59,780
!مرحبًا

83
00:05:59,780 --> 00:06:03,880
أعتقد إذًا أنّ اسم الرّامن على القائمة
.هو "رامن لذيذ" حرفيًّا

84
00:06:04,420 --> 00:06:07,130
.عليّ أن أرسل اعتذارًا لأخي

85
00:06:08,380 --> 00:06:09,640
.المعذرة

86
00:06:10,120 --> 00:06:11,410
."ها هو طبق "رامن لذيذ

87
00:06:11,410 --> 00:06:13,890
.أضيفا بعض الثّوم المعمّر إن أردتما

88
00:06:18,220 --> 00:06:20,650
!نعم، هذه هي الرّائحة

89
00:06:22,010 --> 00:06:23,600
.وقت الأكل

90
00:06:39,800 --> 00:06:43,040
هذا هو! يضيف ملفوف نابا
.تلك الحلاوة الخفيفة

91
00:06:43,760 --> 00:06:47,550
لكن ربّما تكون كمّيّة النّكهة الزّيتيّة
هي ما يمنعه من أن يكون خفيفًا جدًّا؟

92
00:06:56,540 --> 00:06:59,020
.الحساء ساخن جدًّا هنا دائمًا

93
00:07:07,640 --> 00:07:09,950
أعتقد أنّ هذا هو الثّوم المعمّر؟

94
00:07:20,090 --> 00:07:22,460
.يمنحه الثّوم المعمّر نكهة أعمق بكثير

95
00:07:26,010 --> 00:07:27,800
.دخل بعض الزّبائن

96
00:07:27,800 --> 00:07:29,510
!مرحبًا

97
00:07:49,220 --> 00:07:54,380
!لقد كان ذلك رامن لذيذًا بالفعل

98
00:07:55,880 --> 00:07:58,080
.شكرًا على الطّعام

99
00:08:00,770 --> 00:08:03,440
.شربتُ ذلك الحساء بأكمله دون تفكير

100
00:08:03,440 --> 00:08:07,300
لم أفكّر أبدًا أنّني سأحظى برامن
.ذكرياتِ طفولتي هنا في طوكيو

101
00:08:07,300 --> 00:08:10,480
كنت واثقة أنّني قد أضطرّ للذّهاب
.حتّى أوساكا من أجل ذلك

102
00:08:12,300 --> 00:08:13,610
كويزومي-سان؟

103
00:08:15,050 --> 00:08:17,160
ما الخطب يا كويزومي-سان؟

104
00:08:40,140 --> 00:08:42,740
.مرّ وقت طويل مذ ذهبتُ غربًا

105
00:08:44,470 --> 00:08:46,070
."كان اسمه "رامن لذيذ

106
00:08:46,070 --> 00:08:47,920
كان "رامن لذيذ"، صحيح؟

107
00:08:49,610 --> 00:08:51,400
!لقد كان رامن لذيذًا

108
00:08:51,400 --> 00:08:54,010
!كان "رامن لذيذ"، صحيح؟

109
00:09:22,480 --> 00:09:23,800
.وقت الأكل

110
00:09:48,440 --> 00:09:50,560
!أهلاً، أهلاً أيّتها الصّغيرة! أهلاً، أهلاً

111
00:09:50,560 --> 00:09:51,790
إلى أين أنت ذاهبة؟

112
00:09:51,790 --> 00:09:53,520
أتريدين التّنزّه معنا إن كنتِ متفرّغة؟

113
00:09:53,520 --> 00:09:56,750
نحن نعرف بعض الأماكن الرّائعة، فما رأيك؟

114
00:09:56,750 --> 00:09:58,570
.لا يمكنني المواصلة

115
00:09:58,570 --> 00:09:59,950
!ها أنت هناك

116
00:10:00,540 --> 00:10:04,290
!آسفة لتأخّري يا شارلوت

117
00:10:05,410 --> 00:10:06,620
هل نذهب؟

118
00:10:06,620 --> 00:10:07,800
!مهلاً

119
00:10:07,800 --> 00:10:09,330
!اسمعينا فحسب

120
00:10:10,800 --> 00:10:13,550
المعذرة، لكن من هي شارلوت؟

121
00:10:14,080 --> 00:10:16,550
وأيضًا... من أنت؟

122
00:10:17,690 --> 00:10:20,480
.بدوتِ مثل فتاة قد تُدعى شارلوت

123
00:10:20,480 --> 00:10:23,960
لقد شعرتُ بالسّوء حيالك بما
.أنّهما كانا يتغزّلان بك

124
00:10:25,300 --> 00:10:28,360
.شكرًا لك على مساعدتي

125
00:10:28,360 --> 00:10:29,360
.سوف أرحل الآن

126
00:10:29,360 --> 00:10:31,000
!مهلاً، انتظري

127
00:10:31,000 --> 00:10:33,660
كنتِ في مطعم رامن في نانبا
ليلة البارحة، صحيح؟

128
00:10:34,570 --> 00:10:37,190
أستطيع أن أعرف من لهجتك
.أنّك من طوكيو

129
00:10:37,470 --> 00:10:39,070
...في المطعم ليلة البارحة

130
00:10:39,070 --> 00:10:40,790
.يا آنسة، يمكنك تركه هناك فحسب

131
00:10:40,790 --> 00:10:41,980
.آسفة، هذه هي العادة

132
00:10:41,980 --> 00:10:45,210
لقد وضعتِ زبديّتك على المنضدة
.بعد أن انتهيت

133
00:10:45,210 --> 00:10:47,950
.هذا ليس شيئًا يقوم به النّاس هنا

134
00:10:48,400 --> 00:10:50,210
أنت في الثّانويّة، صحيح؟

135
00:10:50,630 --> 00:10:52,560
تتجوّلين في أوساكا وحدك؟

136
00:10:53,660 --> 00:10:55,460
.أتيت إلى هنا لتناول الرّامن

137
00:10:57,160 --> 00:11:00,550
مهلاً، مهلاً... قد يكون من الغريب
،أن يقول شخص محلّيّ هذا

138
00:11:00,550 --> 00:11:03,720
.لكنّ رامن أوساكا ليس مشهورًا إلى ذلك الحدّ

139
00:11:03,720 --> 00:11:05,840
.لا يوجد أيّ شيء مميّز هنا أيضًا

140
00:11:05,840 --> 00:11:07,410
—لا أرى ما الّذي أتى بك من كانتو

141
00:11:07,410 --> 00:11:08,350
.غير صحيح

142
00:11:09,560 --> 00:11:13,190
.رامن أوساكا... مميّز بكلّ تأكيد الآن

143
00:11:14,270 --> 00:11:16,200
،بغضّ النّظر عن المطاعم الأساسيّة

144
00:11:16,200 --> 00:11:19,650
ثمّة أيضًا الكثير من المطاعم الجديدة
.بإمكانيّات قويّة تشقّ طريقها

145
00:11:20,420 --> 00:11:23,400
قلتِ للتّوّ أنّ هذه المنطقة لا تملك
،أسلوبها الخاصّ من المعكرونة

146
00:11:23,400 --> 00:11:26,040
."لكن هنالك النّوع المسمّى "تاكايدا

147
00:11:26,040 --> 00:11:28,560
كانت تشوكا صوبا البارحة
،مشتقّة من ذلك النّوع

148
00:11:28,560 --> 00:11:30,900
وتطويرًا إضافيًّا لحساء صلصة
الصّويا الغنيّ ذاك

149
00:11:30,900 --> 00:11:33,880
.هو "أوساكا الأسود"، من الأطباق المفضّلة لدي

150
00:11:35,830 --> 00:11:38,540
.على أيّ حال، هذا آخر يوم لي في أوساكا

151
00:11:38,540 --> 00:11:39,840
.ما زال عليّ تناول أربع زبديّات أخرى

152
00:11:38,910 --> 00:11:39,840
!انتظري

153
00:11:39,840 --> 00:11:41,460
مهلاً، مهلاً، أين أنت ذاهبة؟

154
00:11:41,460 --> 00:11:43,160
أخبرينا، أتريدين التّنزّه؟

155
00:11:43,160 --> 00:11:44,800
...أخبرينا

156
00:11:44,800 --> 00:11:46,600
.لقد قلتُ لك

157
00:11:48,130 --> 00:11:54,250
هذا مجرّد اقتراح، لكن يمكن
.أن أكون حارستك الشّخصيّة

158
00:11:54,250 --> 00:11:56,730
.لذلك دعيني أرافقك اليوم

159
00:11:56,730 --> 00:11:58,610
!مرحبًا

160
00:11:59,440 --> 00:12:00,920
.شكرًا لك

161
00:12:00,920 --> 00:12:01,860
!أجل

162
00:12:02,360 --> 00:12:06,370
اسمي أياني وأنا في الخامسة والعشرين من
!عمري، من برج العذراء وفصيلة دمي هي أو

163
00:12:06,370 --> 00:12:07,710
ماذا عنك؟

164
00:12:07,710 --> 00:12:09,060
.اسمي كويزومي

165
00:12:09,060 --> 00:12:10,480
!كويزومي-تشان

166
00:12:10,480 --> 00:12:14,250
!لنصبح صديقتين

167
00:12:14,810 --> 00:12:15,710
.شاهدت هذا من قبل

168
00:12:15,710 --> 00:12:17,960
.آسفة بشأن هذا

169
00:12:17,960 --> 00:12:23,380
،لكنّني أردت تجربة رامن أوساكا اللّذيذ
.وهو آخر يوم لي أيضًا

170
00:12:28,560 --> 00:12:29,860
!مرحبًا

171
00:12:30,700 --> 00:12:32,180
!شكرًا على الانتظار

172
00:12:32,180 --> 00:12:35,380
طبق توري بايتان واحد وطبق
.توري بايتان كثيف آخر

173
00:12:35,380 --> 00:12:37,020
إنّه أبيض! لماذا؟

174
00:12:37,020 --> 00:12:39,940
ألم تكوني تتحدّثين عن شيء
أسود قبل قليل؟

175
00:12:39,940 --> 00:12:44,380
لقد سبق وزرتُ كلّ المطاعم الّتي
.تقدّم حساء بصلصة الصّويا البارحة

176
00:12:44,380 --> 00:12:47,280
.أنا أركّز اليوم على المطاعم المفتوحة حديثًا

177
00:12:47,760 --> 00:12:52,040
مطاعم أوساكا للحساء الأبيض مثل
.توري بايتان ورامن الملح رائجة أيضًا

178
00:12:52,040 --> 00:12:55,540
لا أدري بشأن ذلك، لكن أعتقد
.أنّ هنالك أنواعًا عدّة من الرّامن

179
00:12:55,890 --> 00:12:59,280
.لم أقم بهذا مذ بدأت العمل

180
00:12:59,280 --> 00:13:00,880
!وقت الأكل

181
00:13:08,250 --> 00:13:09,600
!إنّه لذيذ للغاية

182
00:13:09,600 --> 00:13:10,810
ما هذا؟

183
00:13:10,810 --> 00:13:12,190
!إنّه غنيّ وقشديّ

184
00:13:12,190 --> 00:13:13,770
.كلي بصمت رجاءً

185
00:13:20,800 --> 00:13:22,980
!كان لذيذًا للغاية

186
00:13:26,500 --> 00:13:29,840
!رامن بايتان ذاك كان لبنيًّا جدًّا
.قد أدمنه بكلّ سهولة

187
00:13:29,840 --> 00:13:33,670
والغريب في الأمر أنّهم لا يستعملون
.اللّبن لجعله أبيضًا

188
00:13:33,670 --> 00:13:35,250
ماذا؟ فعلاً؟

189
00:13:35,490 --> 00:13:39,110
يتكوّن الحساء الأبيض نتيجة لعملية
.طبخ طويلة وساخنة تُدعى بايتان

190
00:13:39,870 --> 00:13:44,380
بينما الحساء الصّافي المعدّ على حرارة
.منخفضة يُدعى تشايتان

191
00:13:44,380 --> 00:13:46,130
.فهمت

192
00:13:46,130 --> 00:13:49,600
لم أكن أعرف أنّهم يعلّمون أشياء
.كهذه في ثانويّات طوكيو

193
00:13:49,600 --> 00:13:51,930
.لم أتعلّم هذا في المدرسة

194
00:14:02,160 --> 00:14:03,950
!انظري إلى حساء الملح المتألّق هذا

195
00:14:03,950 --> 00:14:05,860
نوعان من تشار سيو معدّان
.من دجاج محلّيّ

196
00:14:07,160 --> 00:14:08,320
.ممتاز

197
00:14:20,650 --> 00:14:22,040
.شكرًا على الانتظار

198
00:14:24,980 --> 00:14:28,510
!انظري إلى هذا الحساء الجميل

199
00:14:32,870 --> 00:14:37,270
أومامي الخضراوات والدّجاج
!يتخلّل جسدي بالكامل

200
00:14:39,520 --> 00:14:41,440
!لقد شبعتُ تمامًا

201
00:14:41,440 --> 00:14:43,770
.لا أصدّق أنّني أكلت أربع زبديّات على الغداء

202
00:14:44,100 --> 00:14:45,450
هل ستكونين بخير؟

203
00:14:45,450 --> 00:14:46,480
!نعم

204
00:14:46,480 --> 00:14:50,280
،أنا أنحدر من عائلة لها بطون كبيرة
.والفضل يعود لجدّتي

205
00:14:50,280 --> 00:14:53,780
لكن بعد كلّ ذلك، ما زلت ستتناولين تاكوياكي؟

206
00:14:53,780 --> 00:14:55,540
.هذا هو العرف في أوساكا

207
00:14:55,890 --> 00:14:59,920
يا إلهي، تناول ذلك الرّامن
.يدفعني للرّغبة في الشّرب

208
00:14:59,920 --> 00:15:01,930
لماذا لا تذهبين للحصول على شراب إذًا؟

209
00:15:01,930 --> 00:15:05,380
.لا يمكنني الانضمام لك بما أنّني قاصر

210
00:15:06,900 --> 00:15:07,800
.لن أفعل

211
00:15:08,750 --> 00:15:12,820
من الأفضل عدم تناول شيء
.نحبّه ونحن مكتئبين

212
00:15:14,460 --> 00:15:15,310
...في الواقع

213
00:15:16,520 --> 00:15:18,200
.لقد تركتُ عملي

214
00:15:19,660 --> 00:15:23,120
بعدها، سأذهب للعمل في وظيفة
.دبّرها لي أقاربي في طوكيو

215
00:15:23,120 --> 00:15:26,320
.لذلك فهو يومي الأخير في أوساكا

216
00:15:27,170 --> 00:15:29,990
،كنتُ أجني قوت يومي من شيء أحبّه

217
00:15:29,990 --> 00:15:32,240
.لكنّ الأمر أمسى مُوتّرًا للغاية

218
00:15:33,300 --> 00:15:37,380
البارحة، طلبت من أصدقائي
،الخروج معي لينسوني الأمر

219
00:15:39,010 --> 00:15:41,750
.لكنّني لم أستمتع بالمشروب بالفعل

220
00:15:42,400 --> 00:15:46,160
ثمّ تذكّرت مطعم رامن اعتدت ارتياده
.بعد للشّرب وأنا في طريقي للمنزل

221
00:15:46,160 --> 00:15:48,250
.لم أزر المكان منذ مدّة

222
00:15:48,590 --> 00:15:50,980
.لقد كان رائعًا

223
00:15:50,980 --> 00:15:54,740
لماذا يكون الرّامن الّذي نأكله
بعد الشّرب لذيذًا للغاية؟

224
00:15:55,900 --> 00:16:00,200
،رامن بايتان ورامن الملح كانا لذيذين أيضًا
.لكن أظنّني أفضّل رامن بحساء صلصة الصّويا

225
00:16:00,200 --> 00:16:02,390
النّوع البسيط الّذي يحتوي على
.ناروتو وما إلى ذلك

226
00:16:02,960 --> 00:16:06,520
عندما كنتُ في الجامعة، كنت أرتاد
.كثيرًا مطعمًا في تسورومي

227
00:16:06,520 --> 00:16:08,400
.لا يمكنني نسيان ذلك المذاق أبدًا

228
00:16:09,160 --> 00:16:13,460
.لكنّني نسيت اسم المطعم
ماذا كان يا ترى؟

229
00:16:13,890 --> 00:16:16,410
.لنذهب إلى هناك إذًا

230
00:16:16,720 --> 00:16:18,680
.أريد تجربته أنا أيضًا الآن

231
00:16:18,680 --> 00:16:19,430
ماذا؟

232
00:16:19,430 --> 00:16:21,490
هل ستأخذينني إلى هناك بالفعل؟

233
00:16:21,490 --> 00:16:22,910
!شكرًا لك

234
00:16:26,530 --> 00:16:29,160
.هذه ليست تسورومي

235
00:16:29,160 --> 00:16:29,840
.سوف أدخل

236
00:16:29,840 --> 00:16:32,130
!مهلاً يا كويزومي-تشان

237
00:16:32,370 --> 00:16:34,780
.المعذرة. إليكما تشوكا صوبا

238
00:16:34,780 --> 00:16:36,310
.شكرًا على الانتظار

239
00:16:37,360 --> 00:16:39,880
.يبدو هذا مثل ذلك الرّامن نوعًا ما

240
00:16:39,880 --> 00:16:41,100
.وقت الأكل

241
00:16:41,490 --> 00:16:42,980
!وقت الأكل

242
00:16:51,400 --> 00:16:52,600
!هذا هو

243
00:16:52,600 --> 00:16:55,430
!يا لتشوكا صوبا المتواضعة والبسيطة هذه

244
00:16:55,430 --> 00:16:59,180
انتقل المطعم الرّئيسيّ إلى هنا
.قبل عدّة سنوات

245
00:16:59,180 --> 00:17:01,660
.ما يوجد في تسورومي الآن هو فرع فحسب

246
00:17:01,660 --> 00:17:04,580
.لهذا السّبب نحن هنا إذًا

247
00:17:05,050 --> 00:17:08,980
،قد يكون المكان مختلفًا
.لكنّ الطّعم هو نفسه

248
00:17:08,980 --> 00:17:13,590
.بل أنّ مذاقه أفضل من السّابق

249
00:17:14,110 --> 00:17:18,970
،كلّما كان المطعم قديم العهد في الطّبخ
.إلاّ وكرّس حياته أكثر لتحسين الرّامن خاصّته

250
00:17:20,060 --> 00:17:22,220
،يبدو مثله

251
00:17:23,280 --> 00:17:25,670
.لكنّه يتغيّر بشكل مستمرّ

252
00:17:32,100 --> 00:17:35,610
،إن أكلتُ هذا بعد بعض المشروب
!فسيكون لذيذًا أكثر

253
00:17:39,060 --> 00:17:40,580
.هذا آخر مكان

254
00:17:40,580 --> 00:17:44,500
آخر مكان موجود في حيّ مكتبيّ؟
.هذا تصرّف قاس منك

255
00:17:44,500 --> 00:17:47,320
.تعرفين أنّني تركت عملي حديثًا

256
00:17:47,320 --> 00:17:50,580
أردتُ تناول هذا الرّامن الأسود
.بكلّ بساطة فحسب

257
00:17:50,580 --> 00:17:52,000
.لم يكن هنالك أيّ سبب آخر

258
00:17:52,360 --> 00:17:56,210
والأهمّ من ذلك، اعتقدتُ أنّه ليس
على المرء الشّرب وهو مكتئب؟

259
00:17:56,210 --> 00:17:58,670
!حسنًا، كان لديهم مشروب على القائمة

260
00:18:02,040 --> 00:18:04,890
.كلاّ، هذا ليس السّبب

261
00:18:14,930 --> 00:18:17,060
،في اليوم الّذي سبق رحلتي الجديدة

262
00:18:17,720 --> 00:18:20,300
كنتُ أتناول رامن لذيذًا مع فتاة ظريفة

263
00:18:20,300 --> 00:18:23,560
في كلّ أرجاء المدينة الّتي عشت فيها
.لخمسة وعشرين سنة

264
00:18:23,560 --> 00:18:29,700
.تركتُ الكآبة خلفي منذ مدّة
!أنا في مزاج ممتاز

265
00:18:32,440 --> 00:18:37,240
سبب تركي لشركتي هو لأنّني لم
.أكن أريد التّوقّف عن العمل

266
00:18:37,240 --> 00:18:39,010
أليس هذا تناقضًا؟

267
00:18:40,520 --> 00:18:43,880
.صحيح، التّناقضات هي جوهر حياة الرّاشدين

268
00:18:43,880 --> 00:18:45,010
.شكرًا على الانتظار

269
00:18:45,530 --> 00:18:47,020
.طبق كوروفوني

270
00:18:49,260 --> 00:18:50,860
!حسنًا، لنبدأ

271
00:18:50,860 --> 00:18:52,360
.وقت الأكل

272
00:19:09,250 --> 00:19:10,430
!لذيذ

273
00:19:10,430 --> 00:19:13,000
.الرّامن الأسود هو الأفضل بالفعل

274
00:19:13,460 --> 00:19:15,960
.ليس كلّ الرّامن الأسود يشبه بعضه

275
00:19:18,360 --> 00:19:20,590
.شكرًا لقضائك اليوم معي

276
00:19:20,590 --> 00:19:21,340
.تفضّلي

277
00:19:21,900 --> 00:19:23,560
.هذه معلومات الاتّصال بي

278
00:19:23,560 --> 00:19:25,050
.سأعتمد عليك في طوكيو

279
00:19:25,630 --> 00:19:27,830
علام بالضّبط؟

280
00:19:29,300 --> 00:19:33,860
صحيح! لديّ قريبة من نفس
.عمرك تعيش هناك

281
00:19:34,240 --> 00:19:35,510
—أنت تقصدين

282
00:19:35,510 --> 00:19:38,530
.إنّها قادمة اليوم لمساعدتي في الانتقال

283
00:19:38,530 --> 00:19:41,080
.سوف تصل قريبًا. سأعرّفكما على بعض

284
00:19:41,080 --> 00:19:42,640
...كلاّ... أنا

285
00:19:42,640 --> 00:19:44,200
!هيّا، لنذهب

286
00:19:46,950 --> 00:19:49,080
!كويزومي-سان

287
00:19:49,080 --> 00:19:50,180
!يو

288
00:19:50,180 --> 00:19:50,800
.عرفتُ هذا

289
00:19:50,800 --> 00:19:52,190
ماذا تفعلين في أوساكا؟

290
00:19:52,190 --> 00:19:53,290
!لقد تجاهلتِني؟

291
00:19:53,290 --> 00:19:55,440
.لم أتوقّع أبدًا أن ألقاك هنا

292
00:19:55,440 --> 00:19:57,990
ماذا تفعلان معًا على أيّ حال؟

293
00:19:57,990 --> 00:20:00,230
.كنتُ على وشك طرح نفس السّؤال عليك

294
00:20:00,230 --> 00:20:01,670
كيف تعرفان بعضكما؟

295
00:20:01,670 --> 00:20:05,000
لقد كانت كويزومي-تشان تفسّحني
.في الأرجاء طوال اليوم

296
00:20:05,000 --> 00:20:08,330
!ماذا؟! افعلي ذلك من أجلي أيضًا

297
00:20:08,330 --> 00:20:10,890
.حان موعد ركوب القطار

298
00:20:10,890 --> 00:20:13,420
!كويزومي-تشان! لنلتقي في طوكيو ثانية

299
00:20:13,420 --> 00:20:15,020
!مهلاً! انتظري

300
00:20:15,480 --> 00:20:17,430
.مرحبًا بك يا أختي أياني

301
00:20:17,430 --> 00:20:18,230
أين يو؟

302
00:20:18,230 --> 00:20:19,300
.هناك

303
00:20:20,280 --> 00:20:24,340
!كويزومي-تشان

304
00:20:25,690 --> 00:20:29,840
أختي أياني، ثمّة تنّين عالق
!في مطعم رامن

305
00:20:29,840 --> 00:20:32,640
.ذلك إله نانيوا الحارس

306
00:20:32,640 --> 00:20:34,410
.إله حارس

307
00:22:10,010 --> 00:22:30,030
ناغويا

308
00:22:10,010 --> 00:22:30,030
لقاء

309
00:22:11,820 --> 00:22:14,850
،يبدو أنّك معتادة على أوساكا
صحيح يا كويزومي-تشان؟

310
00:22:14,850 --> 00:22:16,680
.لقد زرتها مرّات عدّة

311
00:22:16,680 --> 00:22:19,760
حسنًا، لماذا لا تجرّبين الحديث
بلهجة أوساكا؟

312
00:22:19,760 --> 00:22:20,610
لماذا؟

313
00:22:20,610 --> 00:22:24,200
أريد سماع صوتك الظّريف
!وأنت تتحدّثين بلهجة أوساكا

314
00:22:24,200 --> 00:22:26,580
!هيّا، أنا أرجوك

315
00:22:26,580 --> 00:22:28,140
".لا أظنّ ذلك"

316
00:22:28,140 --> 00:22:29,540
!أنت متحدّثة ساذجة