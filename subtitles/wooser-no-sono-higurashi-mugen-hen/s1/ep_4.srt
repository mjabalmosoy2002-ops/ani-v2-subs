1
00:00:02,730 --> 00:00:04,860
ما خطبُ هذا الجوّ المُغبَرّ؟

2
00:00:04,860 --> 00:00:06,910
هل يُفترَضُ بي أن أتنفّسَ هذا؟

3
00:00:06,910 --> 00:00:09,200
آسف لاغبرارِه الشديد

4
00:00:09,980 --> 00:00:11,670
والآن أعيدي إليّ منزلي

5
00:00:44,980 --> 00:00:47,510
التقينا مجدّداً

6
00:00:47,510 --> 00:00:49,280
هل لاحظت بأنّ

7
00:00:49,280 --> 00:00:54,430
هذا هو البثُّ رقم 88.888 لهذه الحلقة؟

8
00:00:54,430 --> 00:01:00,670
لقد رأيت هذه الحلقة مُسبَقاً 88.887 مرّة

9
00:01:00,670 --> 00:01:02,600
ألا تتذكّرها؟

10
00:01:02,600 --> 00:01:06,800
"أنتَ الآن مُسافِرٌ عالِقٌ في طريقِ العَود الأبديّ لـ"نيتشه

11
00:01:06,800 --> 00:01:10,600
يتكرّرُ نفس اليوم مِراراً دون أن تُدرك ذلك

12
00:01:10,600 --> 00:01:12,050
،ولإثباتِ ذلك

13
00:01:12,050 --> 00:01:16,650
،حتّى لو كانت شخصيّات القصّة التي ستراها مختلِفة عن المعتاد

14
00:01:16,650 --> 00:01:18,470
لن تُدرِك ذلك

15
00:01:18,470 --> 00:01:19,580
هذا صحيح

16
00:01:20,190 --> 00:01:21,690
!حتَّى أنت

17
00:01:23,100 --> 00:01:25,220
حتّى لو فُسِّرَ العالَم على أنّه

18
00:01:25,220 --> 00:01:29,570
،مزيج من مادّة محدودة داخِل فترة زمنيّة غير محدودة

19
00:01:29,570 --> 00:01:36,440
فهذا يدلُّ إلى أنَّ احتِمال وجود العالم في فترةٍ ما من الماضي كما هو الآن هو احتِمال وارد

20
00:01:38,090 --> 00:01:40,440
كلّ شيء كما هو شأنه دائماً

21
00:01:40,440 --> 00:01:42,990
كوريكايسو (يكرِّر) وكريسماس يبدوان مُتشابِهَين

22
00:01:42,990 --> 00:01:45,370
ديجا فو هي كلمة فرنسيّة

23
00:01:45,690 --> 00:01:48,120
سيّدي، حان وقتُ الاستيقاظ

24
00:01:48,120 --> 00:01:50,990
إن لم تنهض فستتأخّرُ على الاقتراع

25
00:01:50,990 --> 00:01:53,880
التثاقُل هي كلِمة أخرى للكسل

26
00:01:53,880 --> 00:01:58,640
وأنا أستهلكُ كلّ طاقتي لأكون كسولاً الآن

27
00:01:58,640 --> 00:02:00,870
سأكونُ خصمك

28
00:02:02,580 --> 00:02:04,640
هيَّا للقتال

29
00:02:04,890 --> 00:02:06,000
المسألة بسيطة

30
00:02:06,000 --> 00:02:08,370
مبدأ الرّيبة لـ"هايزنبيرغ" يخبرنا أنَّ

31
00:02:08,370 --> 00:02:13,780
أوسَر النائم وأوسَر المُستيقِظ في حالةِ تراكُب

32
00:02:13,780 --> 00:02:14,780
،بمفهوم آخر

33
00:02:14,780 --> 00:02:19,500
،قبلَ أن تزول وظيفةُ الموجة في الغرفة وتُنهي التراكُب

34
00:02:19,500 --> 00:02:22,280
يبقى نِصف نائم

35
00:02:22,940 --> 00:02:25,290
خذ نصفاً أيُّها اللصّ

36
00:02:25,620 --> 00:02:27,160
أرنب شرودنغر

37
00:02:27,970 --> 00:02:29,490
...يا إلهي

38
00:02:29,490 --> 00:02:32,780
أتستعرض مراجع ميكانيكا الكمّ القديمة العفِنة؟

39
00:02:32,780 --> 00:02:35,910
هذه مُفارقةٌ تاريخيّة

40
00:02:36,830 --> 00:02:38,030
ما الذي يجري؟

41
00:02:38,030 --> 00:02:40,260
،يبدو بأنّهم يُوقِظون أوسَر

42
00:02:40,260 --> 00:02:42,290
لإثباتِ المستحيل على الأرجح

43
00:02:42,290 --> 00:02:44,310
اجعل المُمكِن مستحيلاً

44
00:02:44,500 --> 00:02:48,790
"أوّلاً، حدِّد ماذا تقصد بـ"نوم

45
00:02:49,300 --> 00:02:51,470
......النومُ هو بعبارة أخرى

46
00:02:51,980 --> 00:02:52,980
!فِراش

47
00:02:53,130 --> 00:02:54,320
!لِحاف

48
00:02:54,650 --> 00:02:55,790
!بطّانية

49
00:02:55,790 --> 00:02:56,480
!وِسادة

50
00:02:57,560 --> 00:03:01,700
السلام الذي تصنعُه هاته العناصِر الأربعة

51
00:03:01,700 --> 00:03:01,950
أرنب شرودنغر

52
00:03:02,030 --> 00:03:03,320
سريريّة فلسفيّة

53
00:03:03,320 --> 00:03:06,330
ولكن قد تُصبِح الوِسادة سِلاحاً في معارِك الوِسادات

54
00:03:06,330 --> 00:03:08,040
سريريّة فلسفيّة

55
00:03:11,280 --> 00:03:13,840
بعبارة أخرى، القِيَم الاجتماعيّة هي أشياءٌ نسبيّة

56
00:03:13,840 --> 00:03:16,340
ولا يوجدُ شيء يُدعى بالنوم المُطلَق

57
00:03:16,820 --> 00:03:19,720
المُقبِّلات لذيذة

58
00:03:19,720 --> 00:03:21,510
الحيوان هو مقياس كلّ شيء

59
00:03:24,930 --> 00:03:28,730
تقولُ الحكمةُ القديمةُ بأن لا شيء مُريح كالنوم

60
00:03:29,380 --> 00:03:32,340
هل سمِعتَ بديوجانس الكلبي؟

61
00:03:32,340 --> 00:03:35,320
تخلَّى عن ملذّاته الدنيويّة وعاشَ حياةَ زهد وتقشُّف

62
00:03:35,320 --> 00:03:37,340
وذلك داخِل برميل

63
00:03:37,340 --> 00:03:38,530
بمقدورِك أن تتعلّمَ شيئاً منه

64
00:03:38,530 --> 00:03:38,780
الحيوانُ هو مقياسُ كلّ شيء

65
00:03:38,860 --> 00:03:39,690
حياة ديوجانس داخل برميل

66
00:03:40,690 --> 00:03:44,220
إذاً أنا أيضاً سأعيشُ حياةَ زهد

67
00:03:44,220 --> 00:03:49,330
وتقشُّف بعدمِ مُغادرتي سريري أبداً

68
00:03:49,610 --> 00:03:52,580
هذا ليسَ تقشُّفاً على الإطلاق

69
00:03:52,580 --> 00:03:55,000
لماذا؟ لماذا تنام؟

70
00:03:55,000 --> 00:03:58,140
لماذا تنامُ طوالَ الوقت يا أوسَر؟

71
00:03:58,140 --> 00:04:00,390
لأحلم بالفتيات

72
00:04:00,390 --> 00:04:02,380
لماذا تحبُّ الفتيات؟

73
00:04:02,380 --> 00:04:04,580
لأنّها موجودة هناك

74
00:04:04,580 --> 00:04:06,960
لماذا أنتَ شديدُ الاصفرار؟

75
00:04:06,960 --> 00:04:08,140
!أنت أنت

76
00:04:08,140 --> 00:04:10,100
أسئلة كثيرة

77
00:04:10,760 --> 00:04:12,850
جهل سقراطي، صحيح؟

78
00:04:13,100 --> 00:04:15,600
فرقعة فُقاعات هوائيّة بلاستيكيّة أمر ممتع جداً

79
00:04:15,970 --> 00:04:20,020
هل النّوم طوال الوقت يُسعِدُك حقاً؟

80
00:04:20,020 --> 00:04:22,160
ألا يجعلك متوتّراً؟

81
00:04:23,500 --> 00:04:24,360
لقد استجاب

82
00:04:24,720 --> 00:04:27,870
ألستَ متوتّراً حقاً؟

83
00:04:27,870 --> 00:04:30,810
الجميع في صفِّك القديم في المدرسة يعمل

84
00:04:30,810 --> 00:04:33,000
لم يفت الأوان بعد

85
00:04:34,430 --> 00:04:39,400
فرضيّة سيّدي وتضادّ الفرضيّة الخاصّة بآجيبون تتصادمان بعنف

86
00:04:39,400 --> 00:04:41,880
هل ستتقاربان لتُصبِحا تركيبة جديدة؟

87
00:04:42,080 --> 00:04:44,410
تقولُ أمّك نفس الكلام

88
00:04:44,410 --> 00:04:45,630
!أنت أنت

89
00:04:45,940 --> 00:04:49,630
فرضيّة جديدة على وشك أن تُولَد أخيراً

90
00:04:49,920 --> 00:04:54,670
أنا نعسان، ولهذا أنام

91
00:04:54,670 --> 00:04:56,150
توقعتُ أن بحدث هذا

92
00:04:56,570 --> 00:04:59,090
أوَّل من يصِل من الطيور هو أوَّل من يحصل على الدودة

93
00:04:59,090 --> 00:05:03,620
وما الذي يُفترَضُ بي أن أفعلَه بدودة بالضبط؟

94
00:05:04,290 --> 00:05:06,160
إن لم تستيقظ بسرعة سيعمُّ المساء

95
00:05:06,160 --> 00:05:09,820
يدورُ العالمُ من حولي أنا، أوسَر

96
00:05:09,820 --> 00:05:12,640
وبالتالي، ما لم أستيقظ لن يطلعَ الصباح

97
00:05:12,640 --> 00:05:15,300
لماذا؟ لماذا؟

98
00:05:15,300 --> 00:05:18,000
سيتّسِخُ فِراشك إن ظللتَ نائماً

99
00:05:18,000 --> 00:05:19,770
انهض وقُم بتهويةِ فِراشك

100
00:05:19,770 --> 00:05:24,790
...صحيح أنني إذا قمتُ بتهويةِ الفراش سيُصبحُ دافئاً ولطيفاً ومنفوشاً

101
00:05:22,830 --> 00:05:25,520
انهض

102
00:05:25,280 --> 00:05:26,850
لكنني أرفض

103
00:05:27,740 --> 00:05:29,010
ما هذا؟

104
00:05:29,010 --> 00:05:31,390
الغرفة تذوب

105
00:05:34,220 --> 00:05:37,320
هل هذا يعني أنّ كل شيء يحقّق حالةَ توازُن ويختفي؟

106
00:05:37,320 --> 00:05:38,770
...بداية النِّهاية

107
00:05:38,770 --> 00:05:42,400
المُستقبل لا يسير في جهةٍ واحدة ببساطة

108
00:05:45,410 --> 00:05:47,780
ماذا؟ رائع

109
00:05:47,780 --> 00:05:50,840
هل هذا يعني بأنني سأتمكّنُ من النوم قدرَ ما أشاء دون أن يُضايقني أحد؟

110
00:05:50,840 --> 00:05:52,900
حان وقتُ العودة إلى النّوم للمرّة الخامسة

111
00:05:54,590 --> 00:05:57,120
التقينا من جديد

112
00:05:57,120 --> 00:06:01,920
...هل لاحظتَ بأنّ هذا هو البثّ رقم 88.889

113
00:07:38,810 --> 00:07:40,690
..أنتَ غايةٌ في السعادة

114
00:07:40,690 --> 00:07:43,980
أجل، فهذا العالمُ مليءٌ بالسعادة