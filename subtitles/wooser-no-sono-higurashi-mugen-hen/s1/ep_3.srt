1
00:00:32,150 --> 00:00:33,390
،عندما كنتُ صغيراً

2
00:00:33,860 --> 00:00:36,090
لطالما تساءلتُ عن سببِ عدم إطلاقهم

3
00:00:36,090 --> 00:00:39,620
شُعاع سبيسيوم أو استخدامهم لمُسدّس الحركة الموجيّة في البداية

4
00:00:40,020 --> 00:00:42,070
ولكن الآن قد فهمت

5
00:00:42,070 --> 00:00:45,640
لا أحد يبدأ بالعملِ على مدارِ اللّيل في اليوم الأول

6
00:00:47,130 --> 00:00:48,260
من مشروع

7
00:00:49,030 --> 00:00:53,820
أو هذا ما حدّثتُ نفسي به، ولكن حانَ الموعدُ النهائي في لحظةٍ ما

8
00:00:54,340 --> 00:00:58,820
من المُؤلم رؤية نصّ أبيض فارغ

9
00:01:00,430 --> 00:01:01,660
...مُؤلم

10
00:01:01,660 --> 00:01:03,910
لقد أحضرتُ الشاي يا سيّدي

11
00:01:11,340 --> 00:01:12,710
لا... لا أشعر براحة كبيرة

12
00:01:12,710 --> 00:01:14,220
صُداع كحول؟

13
00:01:14,220 --> 00:01:15,710
،أعلمُ بأنه ليسَ شيئاً جديداً بالنسبةِ لك

14
00:01:15,710 --> 00:01:18,640
ولكن هل أنتَ متأكّدٌ أنّه من المُناسِب أن تشربَ طوال الليلة التي تسبقُ موعداً نهائياً؟

15
00:01:18,640 --> 00:01:20,260
كانت اللّيلة الماضية استثنائيّة

16
00:01:20,490 --> 00:01:27,550
شهوة، أحلام، لحم

17
00:01:20,860 --> 00:01:23,710
،لقد نفذت ميزانيّتنا في النصف الثاني من الموسم

18
00:01:23,710 --> 00:01:28,110
لهذا رحتُ أشربُ حتَّى الفجر مع المُموِّلين

19
00:01:29,480 --> 00:01:31,320
حياة الرّاشد صعبة جداً

20
00:01:31,320 --> 00:01:33,830
لا تقل كلاماً خطيراً فعلاً عندما تكونُ ثملاً

21
00:01:33,830 --> 00:01:36,180
قد يتوقّف البرنامج عن العرض في الأسبوع المقبل

22
00:01:36,750 --> 00:01:38,820
رائع جداً

23
00:01:39,640 --> 00:01:42,060
لا عجب في شهرتِهم الكبيرة

24
00:01:42,060 --> 00:01:43,950
إنَّ أهمّ جزء في أجسامِ المشاهير هو أسنانهم

25
00:01:43,950 --> 00:01:46,250
إنّها تلمع، تلمع

26
00:01:46,250 --> 00:01:48,940
أخفِضن أصواتكن

27
00:01:48,940 --> 00:01:51,310
أحاولُ الالتزام بموعدٍ نهائي

28
00:01:50,150 --> 00:01:52,400
تِلك الابتسامة ظريفة جدّاً

29
00:01:52,400 --> 00:01:54,310
إنَّهم بارعون في الرقصِ أيضاً

30
00:01:54,310 --> 00:01:55,110
!نعم

31
00:01:55,110 --> 00:01:55,960
أتتجاهلنني؟

32
00:01:55,960 --> 00:01:58,430
أريدُ أن أكون شابّاً وسيماً أيضاً

33
00:01:58,430 --> 00:02:00,640
ستُصيبين كافّة الفتيات بالإغماء

34
00:02:01,120 --> 00:02:03,350
كافّة الفتيات بالإغماء؟

35
00:02:03,350 --> 00:02:05,610
رائع، ساقاه طويلتان أيضاً

36
00:02:05,610 --> 00:02:07,340
إنَّ حجمَ جسده أكبر من رأسه بعشر مرّات

37
00:02:07,340 --> 00:02:10,050
...ساقان طويلتان وجسد أكبر بعشر مرّات من رأسه

38
00:02:12,670 --> 00:02:16,150
،ساقا البطريق يُغطِّيهما ريشٌ ودهن

39
00:02:16,150 --> 00:02:17,740
ولكنّهما طويلتان جداً حسبما يقولون

40
00:02:17,740 --> 00:02:20,270
طويلتان... جدّاً؟

41
00:02:21,880 --> 00:02:25,050
لعقتُ ساقَ عنكبوت أوبليون ذي السِّيقان الطويلة وكانتْ مالِحة

42
00:02:25,050 --> 00:02:26,120
لعقتِ ساقاً؟

43
00:02:26,120 --> 00:02:27,620
أنتِ شُجاعة

44
00:02:28,370 --> 00:02:29,910
...لا، الناسُ العاديّون لا يفعلون ذلك

45
00:02:30,390 --> 00:02:31,290
...ولكن

46
00:02:32,200 --> 00:02:33,800
...إنِّي أتخيّله

47
00:02:34,480 --> 00:02:35,730
تصميم

48
00:02:36,640 --> 00:02:37,590
لبطل جديد

49
00:02:43,080 --> 00:02:44,930
يعيشُ ذو السِّيقان الطويلة أنا

50
00:02:45,210 --> 00:02:46,680
يعيشُ ذو الطُّول البالغ عشرة رؤوس

51
00:02:46,920 --> 00:02:48,100
مرحباً جميعاً

52
00:02:48,700 --> 00:02:50,190
،لقد كنتُ أُخفي الأمرَ حتّى اللحظة

53
00:02:50,190 --> 00:02:56,040
لكنّني حيوانٌ أصفرٌ لديه ساقان طويلتان جداً ووجه صغير

54
00:02:57,620 --> 00:02:59,330
أنتَ رائعٌ جداً يا أوسَر الوسيم

55
00:02:59,330 --> 00:03:00,500
ساقاك طويلتان جدّاً

56
00:03:00,500 --> 00:03:01,600
رائع جداً

57
00:03:01,600 --> 00:03:04,240
إنّهما طويلتان، ولكن هل هذا رائع فعلاً؟

58
00:03:04,530 --> 00:03:06,700
فالأطول لا يعني أفضل دوماً، أليس كذلك؟

59
00:03:06,700 --> 00:03:09,000
إنَّ ارتداء الأصفر يجعلُك تكسبُ مالاً أكثر

60
00:03:09,350 --> 00:03:11,350
حسناً، هذا ما نقومُ به

61
00:03:11,350 --> 00:03:13,710
،حيوان أصفر تحبُّه الفتيات

62
00:03:13,710 --> 00:03:15,540
بمفهوم آخر، أوسَر الوسيم

63
00:03:15,540 --> 00:03:17,250
سيكونُ بطل المانغا الجديدة خاصّتي

64
00:03:21,390 --> 00:03:24,690
تتنفّسن بشكلٍ أعمق مما توقَّعت

65
00:03:24,690 --> 00:03:27,010
أظنُّ أن هذا يعني أنني لذيذ

66
00:03:27,440 --> 00:03:32,600
هل تُرِدنَ لَعقي؟

67
00:03:35,070 --> 00:03:36,490
!ليسَ أنت

68
00:03:38,040 --> 00:03:39,990
لا، لا أريد هذا

69
00:03:39,990 --> 00:03:42,550
هذا حارٌّ بعض الشيء، أليس كذلك؟

70
00:03:42,550 --> 00:03:44,290
هذا حارّ

71
00:03:44,290 --> 00:03:47,400
توقّفَ مُؤقِّت مكيِّف الهواء

72
00:03:47,400 --> 00:03:49,750
هذا حارّ؟

73
00:03:50,610 --> 00:03:53,000
الحَرُّ شديد

74
00:03:53,910 --> 00:03:56,000
هذا حارٌّ بالفعل

75
00:03:56,730 --> 00:03:59,000
نشعرُ بالراحةِ إذا خلعنا ملابسنا

76
00:03:59,500 --> 00:04:02,010
يقولون أنَّ السُّلحفاة تطرحُ جلدَها أيضاً

77
00:04:04,320 --> 00:04:06,520
حسناً، أنا كذلك

78
00:04:06,520 --> 00:04:08,240
قليلاً فقط

79
00:04:12,580 --> 00:04:14,540
أنا آسف، كانَتْ هناك بعوضة

80
00:04:15,040 --> 00:04:16,910
بعدَ أن وصلتُ للإثارة

81
00:04:16,910 --> 00:04:18,520
حسناً، هل تُرِدنَ الذهاب إلى الشاطئ؟

82
00:04:18,840 --> 00:04:21,110
بالتأكيد، فالطقسُ جميلٌ أيضاً

83
00:04:21,110 --> 00:04:22,340
فكرة رائعة

84
00:04:22,340 --> 00:04:24,760
حسناً، حانَ وقتُ السباحة

85
00:04:30,820 --> 00:04:33,290
!مرحى! الشاطئ

86
00:04:33,630 --> 00:04:36,290
يا سلام! هيّا بنا

87
00:04:36,290 --> 00:04:40,170
لين! لنقم بحركاتِ الجمباز

88
00:04:40,170 --> 00:04:41,840
قفزة فتيّة رائعة

89
00:04:48,740 --> 00:04:50,600
رائعة، رائعة

90
00:04:50,600 --> 00:04:53,200
كم هي الفتوّة رائعة

91
00:04:55,930 --> 00:04:57,280
انتهَتْ

92
00:04:57,280 --> 00:05:01,120
دارث أوسَر، سأعطيك فُرصةً خاصّة لتُصبِح القارئ الأوَّل

93
00:05:01,120 --> 00:05:02,480
شكراً لك

94
00:05:07,380 --> 00:05:08,450
...هذا

95
00:05:09,920 --> 00:05:12,650
لا دعي للتكلّم، أعرف

96
00:05:12,650 --> 00:05:13,780
لا حاجة لأن تمدحني

97
00:05:13,780 --> 00:05:16,940
"من المُزعج أن يقول شخص "سيّدي، أنتَ رسّام مانغا عبقريّ

98
00:05:16,940 --> 00:05:22,130
"فأضطرّ للردّ "أوه أنتَ تحرجُني

99
00:05:22,130 --> 00:05:23,250
عُلِم

100
00:05:23,600 --> 00:05:24,820
أترميها في سلّة المهملات؟

101
00:05:24,820 --> 00:05:26,880
هل يُزعجُك ذلك؟

102
00:05:26,880 --> 00:05:29,930
ظننتُ ببساطة أنّ نشر عمل كهذا في العالم

103
00:05:29,930 --> 00:05:32,490
سيزيدُ كميّةَ النِّفايات في مكبِّ النفايات

104
00:05:33,800 --> 00:05:35,300
أنا آسف

105
00:05:35,300 --> 00:05:38,290
حسناً، لا مُشكلة

106
00:05:40,930 --> 00:05:41,900
...حسناً إذاً

107
00:05:42,280 --> 00:05:44,500
أأستسلِم أم أبدأ من الصفر؟

108
00:05:44,910 --> 00:05:46,900
هذا مُفترَقُ طرقٍ في حياتي

109
00:05:47,310 --> 00:05:49,630
مع أنّ لن يؤدّي أي منهما إلى مقتلي

110
00:05:50,140 --> 00:05:53,210
أودُّ أن أعيشَ حياتي باسترخاء

111
00:05:53,210 --> 00:05:54,160
أجل

112
00:05:54,160 --> 00:05:55,730
هل تستسلم إذاً؟

113
00:05:56,160 --> 00:05:58,420
من تظنُّني؟

114
00:05:59,250 --> 00:06:00,470
أنا أوسَر-ساما

115
00:07:32,640 --> 00:07:36,650
حسناً، حانَ الوقتُ لتنشيطِ ناغاريكاوا مجدّداً

116
00:07:37,510 --> 00:07:39,300
!أو! أو! أو

117
00:07:40,570 --> 00:07:41,980
كان أوسَر داخِل هذه في الواقع

118
00:07:43,980 --> 00:07:50,890
الرسم: كوسوغي كوتارو