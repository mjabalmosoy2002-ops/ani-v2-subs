1
00:00:04,970 --> 00:00:08,790
ما نوع التصاميم التي على ملابسك
التي ترتديها؟

2
00:00:08,790 --> 00:00:09,670
رسوم؟

3
00:00:09,670 --> 00:00:11,010
شعار من نوع ما؟

4
00:00:11,010 --> 00:00:14,400
هل ترتدي شيئاً كُتب عليه كلمات؟

5
00:00:14,400 --> 00:00:16,520
حسناً، عزائي لك

6
00:00:16,520 --> 00:00:20,360
آمل ألّا يقرأه أحد بصوتٍ عال

7
00:00:20,360 --> 00:00:22,290
الطقس حارّ جداً اليوم

8
00:00:22,290 --> 00:00:25,640
طوكيو مزدحمة بالناس أينما ذهبت

9
00:00:25,890 --> 00:00:29,790
انظرا إلى كلّ أولئك الناس الذين
يرتدون قمصاناً طريفة

10
00:00:29,790 --> 00:00:30,760
بالفعل

11
00:00:30,760 --> 00:00:32,420
هذا مشوّق جداً

12
00:00:32,420 --> 00:00:36,670
يبدون رائعين جداً بالشعارات الانجليزية

13
00:00:36,670 --> 00:00:39,010
ماذا كُتب في ذاك القميص؟

14
00:00:39,010 --> 00:00:41,140
"مكتوب "كرة قاعدة

15
00:00:41,140 --> 00:00:42,370
كرة قاعدة؟

16
00:00:42,370 --> 00:00:44,620
لمَ مكتوب عليه كرة قاعدة؟

17
00:00:44,620 --> 00:00:47,280
لا بدّ وأنه يحب كرة القاعدة

18
00:00:51,560 --> 00:00:54,150
قميص تلك الشخص عصريّ جداً

19
00:00:54,150 --> 00:00:55,900
أحبّ طوكيو" إذاً؟"

20
00:00:55,900 --> 00:00:59,290
تعبّر عن حبّها لطوكيو بملابسها

21
00:00:59,290 --> 00:01:02,720
طوكيو بلدة لطيفة، لكن لا أعتقد أنّي
سأبالغ إلى هذا الحدّ

22
00:01:02,720 --> 00:01:04,160
"أحبّ طوكيو"

23
00:01:07,660 --> 00:01:10,450
"انظرا! مكتوب "طريق خطير

24
00:01:10,450 --> 00:01:11,960
!"طريق خطير"

25
00:01:11,960 --> 00:01:13,250
"طريق خطير"

26
00:01:13,250 --> 00:01:15,340
!خطير

27
00:01:15,340 --> 00:01:16,800
طريق محفوف بالمخاطر

28
00:01:16,800 --> 00:01:19,940
أتساءل ما إذا كان يحاول التّعبير
بـ"طريق محفوف بالمخاطر" بقميصه

29
00:01:19,940 --> 00:01:20,920
هذا مُؤكّد

30
00:01:20,920 --> 00:01:24,550
يحاول القول أنّ حياته على طريق
محفوف بالمخاطر

31
00:01:28,560 --> 00:01:29,810
"يعمل"

32
00:01:29,810 --> 00:01:31,200
!يعمل

33
00:01:34,820 --> 00:01:38,170
"انظرا، مكتوب "غيرة

34
00:01:39,320 --> 00:01:40,320
...واحد، اثنان

35
00:01:40,320 --> 00:01:42,200
!"غيرة"

36
00:01:42,200 --> 00:01:43,820
!غيرة! غيرة

37
00:01:43,820 --> 00:01:46,570
لا بدّ وأنه معرّض للغيرة

38
00:01:46,570 --> 00:01:48,450
!لـ-لم تكن تلك نيّتي

39
00:01:51,350 --> 00:01:53,390
"!!ذاك مكتوب عليه "سعيد

40
00:01:53,740 --> 00:01:56,630
يحاول إقناع الناس بأنه سعيد

41
00:01:57,510 --> 00:02:00,380
إنه يغيظ الأشخاص غير السّعداء

42
00:02:00,380 --> 00:02:03,630
ربّما يغترّ بسعادته

43
00:02:03,630 --> 00:02:05,420
هذا مُؤكّد

44
00:02:05,420 --> 00:02:09,720
لا بدّ وأنه حقير إذاً

45
00:02:09,720 --> 00:02:11,120
!ا-اللّعنة

46
00:02:11,120 --> 00:02:12,360
!تبّاً

47
00:02:13,850 --> 00:02:16,750
!"انظرا هناك! مكتوب "هوت دوغ

48
00:02:16,750 --> 00:02:18,370
!هوت دوغ

49
00:02:18,370 --> 00:02:21,060
لا بدّ وأنّه يحبّ الهوت دوغ

50
00:02:21,060 --> 00:02:21,910
بالتأكيد

51
00:02:21,910 --> 00:02:24,860
وإلّا ما كان ليرتدي قميص الهوت دوغ هذا

52
00:02:26,280 --> 00:02:28,620
!هوت دوغ! هوت دوغ

53
00:02:28,620 --> 00:02:30,490
ماذا تفعلن أنتنّ الثلاثة؟

54
00:02:30,490 --> 00:02:31,660
كاهن الدغدغة

55
00:02:31,660 --> 00:02:34,500
الناس في طوكيو يرتدون مُختلَف
أنواع القمصان، صحيح؟

56
00:02:34,500 --> 00:02:39,020
لحظة. أنتنّ قاسيات، تقرأن الكلمات
المكتوبة على قمصانِ الناس

57
00:02:39,020 --> 00:02:40,100
لماذا؟

58
00:02:40,100 --> 00:02:43,150
نحن نقرأها لأنها رائعة

59
00:02:43,150 --> 00:02:44,330
...في الواقع

60
00:02:44,330 --> 00:02:45,480
لا أعلم

61
00:02:45,480 --> 00:02:47,130
إنها تحرج الناس الذين يرتدونها

62
00:02:47,130 --> 00:02:50,900
أنت ترتدي قميصاً جميلاً أيضاً
يا كاهن الدغدغة

63
00:02:50,900 --> 00:02:53,150
!توقّفن! لا تقرأنها

64
00:02:53,150 --> 00:02:54,770
!"أحبّك"

65
00:02:54,770 --> 00:02:58,020
!قلتُ لا تقرأنها، تبّاً

66
00:02:58,020 --> 00:02:59,900
!"أحبّك"

67
00:02:59,900 --> 00:03:01,280
ماذا تعني بـ"أحبّك"؟

68
00:03:01,280 --> 00:03:04,150
أجل، أيّها الكاهن الوغد. ماذا يُفترض
أن تعني "أحبّك"؟

69
00:03:04,150 --> 00:03:05,160
أعنيكن أنتن

70
00:03:05,780 --> 00:03:08,420
!أحبّكن أنتنّ الثلاثة

71
00:03:08,420 --> 00:03:11,540
هذا شعور جميل أيُّها الكاهن الوغد

72
00:03:11,540 --> 00:03:14,800
تعبّر عن حبّك لنا من خلال ملابسك

73
00:03:14,800 --> 00:03:15,630
هذا صحيح

74
00:03:15,630 --> 00:03:16,660
!أحبّكن

75
00:03:16,660 --> 00:03:18,430
أنت تحرجني أيّها الوغد

76
00:03:18,430 --> 00:03:24,610
!أحبّكن

77
00:03:23,260 --> 00:03:26,070
ماذا تفعلون؟