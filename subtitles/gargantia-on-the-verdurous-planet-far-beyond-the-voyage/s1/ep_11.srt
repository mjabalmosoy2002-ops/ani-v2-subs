1
00:00:04,390 --> 00:00:05,520
! بيلوز

2
00:00:06,770 --> 00:00:07,980
! لديّ تسليمٌ لك

3
00:00:07,980 --> 00:00:09,970
.آه، شكراً لك

4
00:00:09,970 --> 00:00:11,140
.واصلي عملكِ الدؤوب

5
00:00:11,140 --> 00:00:11,690
! سأفعل

6
00:00:12,730 --> 00:00:14,240
.يسعدني رؤيتكِ مبتهجة

7
00:00:14,970 --> 00:00:17,080
.حسناً، لا فائدة من أن يبقى المرء مكتئباً طوال الوقت

8
00:00:17,750 --> 00:00:21,310
.لقد وصلتنا أنباءٌ تقول أنّ فلانجي ببحر الضباب الآن

9
00:00:21,310 --> 00:00:23,450
.يبدو أنّ التيار المجري يجري نحو ذلك الاتجاه

10
00:00:23,450 --> 00:00:25,680
.لذا فقد ينتهي بنا المطاف نرسوا في مكانٍ بالقرب من هناك

11
00:00:25,680 --> 00:00:27,600
.لدينا فرصةٌ في معرفة ما يجري عندهم

12
00:00:27,600 --> 00:00:30,670
.أتمنى ألا يكون بينيون قد قام بحماقةٍ ما

13
00:00:30,960 --> 00:00:33,170
.لا يهمّ ذلك طالما أنهم على ما يرام

14
00:00:33,170 --> 00:00:34,130
! إلى اللقاء

15
00:00:42,760 --> 00:00:44,900
!مهلاً ! ما هذا ؟

16
00:00:47,900 --> 00:00:50,640
هذا الشيء ضخمٌ للغاية ! أَهم قراصنة ؟

17
00:00:51,250 --> 00:00:51,940
! أيها العميد

18
00:00:53,020 --> 00:00:56,320
! اجعل الأسطول بأكمله في تأهّبٍ لحالات الطوارئ

19
00:00:56,320 --> 00:00:58,800
.لا كن لا تقم بأيّ تصرّفٍ متهوّر

20
00:00:58,800 --> 00:01:00,010
.استدعي بينيون

21
00:01:00,930 --> 00:01:02,490
.أو سأذهب إليه بنفسي

22
00:01:07,810 --> 00:01:08,250
ليدو ؟

23
00:01:09,030 --> 00:01:11,710
العقيد كوغيل ؟ أَهذا أنت أيها العقيد ؟

24
00:01:13,250 --> 00:01:15,650
.مضى وقتٌ يا ليدو

25
00:01:15,650 --> 00:01:17,340
.يسعدني أن أراك تبلي حسناً

26
00:01:18,200 --> 00:01:19,600
.نفس الأمر بالنسبة لي

27
00:01:20,800 --> 00:01:24,260
.لقد تمكنتُ من التقاط إشارات الاستغاثة خاصتك

28
00:01:24,260 --> 00:01:27,190
.لكنني كنتُ بالطرف من هذا الكوكب آنذاك

29
00:01:27,580 --> 00:01:31,520
.لو أنك قد أخبرتني بذلك، لكنتُ قد أتيتُ إليك سيدي

30
00:01:31,930 --> 00:01:34,180
.كنتُ مضطراً لعدم تشغيل اللاسلكي

31
00:01:34,910 --> 00:01:36,400
هل تستطيع القدوم إلى هنا ؟

32
00:01:36,800 --> 00:01:37,490
.حاضر

33
00:01:37,490 --> 00:01:40,900
.الملازم ليدو سيعود الآن إلى سرب العقيد كوغيل

34
00:01:42,300 --> 00:01:43,790
ما الذي يحدث هنا ؟

35
00:01:44,590 --> 00:01:46,250
أَهم قراصنة ؟

36
00:01:46,250 --> 00:01:48,570
! إنها ضخمة للغاية ! هذا سيء

37
00:01:48,570 --> 00:01:50,850
أَلا يجدر بنا التراجع يا بينيون ؟

38
00:01:50,850 --> 00:01:53,210
التراجع ؟ إلى أين ؟

39
00:01:53,860 --> 00:01:57,430
! لا داعي القلق ! فلدينا هذا المدفع و ذلك الخردة بصفنا

40
00:01:58,220 --> 00:02:00,430
ما رأيكم أن نقوم بالتّرحيب بهم ؟

41
00:02:02,500 --> 00:02:03,640
.أجل

42
00:02:08,960 --> 00:02:10,060
! لقد تمّ تحديد الهدف

43
00:02:10,540 --> 00:02:12,020
! استعدوا لإطلاق النّار

44
00:02:12,930 --> 00:02:14,230
! أطلقوا النّار

45
00:02:14,700 --> 00:02:15,690
! سوف أطلق

46
00:02:23,330 --> 00:02:25,790
! ما رأيكم بهذا ؟ هيّا عودوا إلى أحضان أمكم

47
00:02:26,130 --> 00:02:26,790
ماذا ؟

48
00:02:44,000 --> 00:02:45,650
!ما قد كان هذا ؟

49
00:02:45,650 --> 00:02:47,020
! لقد كانت أشبه بصاعقة ضوئيّة

50
00:02:47,920 --> 00:02:50,230
! انظروا إلى ما قد فعلتوه بكنزي

51
00:02:52,400 --> 00:02:55,410
ما هذا ؟ ذلك الخردة ؟

52
00:02:55,410 --> 00:02:57,190
...كلا

53
00:02:57,190 --> 00:02:59,400
!ليدو ! أين أنت يا ليدو ؟

54
00:03:00,370 --> 00:03:02,260
.هنا الملازم ليدو

55
00:03:02,260 --> 00:03:05,780
.سوف أعود الآن إلى صفوف التحالف المجرّي للبشريّة

56
00:03:05,780 --> 00:03:08,250
!ماذا ؟ ما الذي تقصده ؟

57
00:03:09,010 --> 00:03:10,620
! ليدو ! أيها الخردة

58
00:03:22,850 --> 00:03:27,480
حلّق عالياً، إلى أقصى أحلامك

59
00:03:27,480 --> 00:03:31,030
هناك حيثُ يقبع مستقبلنا

60
00:03:31,030 --> 00:03:38,440
هذا العالم قد كان بانتظارنا

61
00:03:40,930 --> 00:03:46,610
أمنياتي الحقيقية لم يعد بالإمكان كبحها

62
00:03:46,610 --> 00:03:52,040
لذا سنمضي كما يحلو لنا

63
00:03:52,290 --> 00:03:56,650
ما مِن مكانِ بعيدٍ عن متناول أيدينا إِن كنت بجواري

64
00:03:56,650 --> 00:04:02,340
و لسوف نتجاوز هذا كلّه لأن قلوبنا حرّة

65
00:04:02,340 --> 00:04:08,600
إنها القوة التي أتمنى أن تقبع بداخلي

66
00:04:08,600 --> 00:04:14,360
ابتسامتك قد أخبرتني بهذا

67
00:04:14,360 --> 00:04:15,670
حلّق عالياً

68
00:04:15,670 --> 00:04:21,320
سوف نقترب من ذاك النور الذي تراه

69
00:04:21,320 --> 00:04:25,610
سماء اللّيل تشتعلُ بالأمل

70
00:04:25,610 --> 00:04:30,000
في أقاصي الحلم الذي روادني ذات مرّة

71
00:04:30,000 --> 00:04:33,600
سوف نجد مستقبلنا

72
00:04:33,600 --> 00:04:40,660
فهذا العالم كان بانتظارنا

73
00:04:54,650 --> 00:04:57,730
.لقد تمّ التعرّف على الإشارة التوجيهية. سيتمّ الهبوط

74
00:05:01,410 --> 00:05:02,960
ما الذي يفعلونه ؟

75
00:05:02,960 --> 00:05:04,050
.مجهول

76
00:05:04,050 --> 00:05:07,660
.يمكن افتراض أنّ هذا عملٌ جماعي للإبداء عن وحدة جماعتهم

77
00:05:08,190 --> 00:05:10,620
إذن فهوم من يتزعّم هؤلاء السكّان ؟

78
00:05:20,060 --> 00:05:22,340
،نحن نرحب بك لدينا

79
00:05:22,340 --> 00:05:25,510
.يا نذير السّماء، المكسو بهيئة عملاق الرّعد

80
00:05:26,060 --> 00:05:29,970
.باسم العناية الإلهيّة، نتمنى لك السلام و الازدهار

81
00:05:30,290 --> 00:05:32,080
ما الذي تقوله ؟

82
00:05:32,080 --> 00:05:37,020
.أعتقد أنّ هذا تحسّس ذاتي يقصد به آلات العيار و من يقودها

83
00:05:37,810 --> 00:05:39,900
أين هو العقيد كوغيل ؟

84
00:05:40,260 --> 00:05:41,270
.اتبعني

85
00:06:00,550 --> 00:06:01,340
.تعال

86
00:06:16,140 --> 00:06:18,140
.انتظر هنا من فضلك

87
00:06:28,800 --> 00:06:30,280
.أعذرني على استخدامي لصورة ثلاثية الأبعاد

88
00:06:30,640 --> 00:06:35,870
! أيها العقيد كوغيل ! يسعدني أن أراك حياً ترزق على هذا الكوكب

89
00:06:36,340 --> 00:06:37,570
.ليس إلا هذا الحد

90
00:06:37,570 --> 00:06:39,500
.لقد تعرّضتُ لأمراضٍ محليّة

91
00:06:39,500 --> 00:06:42,600
.و أنا الآن مجبرٌ على ملازمة قمرتي المعقّمة

92
00:06:43,250 --> 00:06:44,340
كيف حالك أنت ؟

93
00:06:44,960 --> 00:06:46,050
.لستُ أعاني من شيء

94
00:06:46,050 --> 00:06:50,260
.هكذا إذن، إنّ إصدار الأوامر من هنا لهو أمرٌ مزعج بحق

95
00:06:50,660 --> 00:06:52,080
.إنني أتفهّم ذلك

96
00:06:52,080 --> 00:06:53,930
.إنّ وجودك هنا سيساعدني

97
00:06:53,930 --> 00:06:57,190
ما رأيك ؟ هل ستتّبعني مرةً أخرى ؟

98
00:06:57,190 --> 00:06:58,480
! بالتأكيد سيادة العقيد

99
00:07:00,200 --> 00:07:05,570
:X3752 إلى سترايكر K6821 تشيمبر

100
00:07:06,310 --> 00:07:09,530
.أطلبُ معلوماتٍ بشأن المرض المستوطن الذي قد تمّ ذكره

101
00:07:10,130 --> 00:07:15,490
:K6821 إلى تشميبر X3752 سترايكر

102
00:07:16,020 --> 00:07:19,480
.لقد تمّ تصريح الطلب. يتمّ نقل البيانات

103
00:07:21,640 --> 00:07:23,840
.أنت، نحن محاصرون هنا

104
00:07:23,840 --> 00:07:25,650
.هذا سيء

105
00:07:25,650 --> 00:07:27,360
! لدينا الكنوز هنا

106
00:07:27,360 --> 00:07:28,860
أَستكون الأمور على ما يرام حقاً ؟

107
00:07:28,860 --> 00:07:30,180
.لا داعي للخوف

108
00:07:30,180 --> 00:07:31,800
...إن تدهورت الأوضاع، فأنّ ذلك الخردة سوف

109
00:07:31,800 --> 00:07:34,210
ألم يغادرا قبل قليل ؟

110
00:07:35,620 --> 00:07:36,390
.لقد انتهى أمرنا

111
00:07:36,390 --> 00:07:38,400
.على أيٍ، هدّئوا من روعكم

112
00:07:38,400 --> 00:07:40,640
.نحن لا نعرف مبتغاهم حتّى

113
00:07:40,640 --> 00:07:43,560
و ما الذي سيريدونه غير هذه الكنوز القديمة ؟

114
00:07:43,560 --> 00:07:45,350
و ما أدراهم بشأنها ؟

115
00:07:45,350 --> 00:07:47,290
! لقد قمتَ ببثٍ بشأنها و قد سمعها العالم بأسره

116
00:07:48,710 --> 00:07:49,780
و ما الذي ستفعله الآن ؟

117
00:07:50,230 --> 00:07:53,240
.أوه... آسف

118
00:07:53,550 --> 00:07:54,780
.هذا ليس بالوقت المناسب للشّجار

119
00:07:55,040 --> 00:07:56,490
.لا تتدخّل في هذا

120
00:07:56,820 --> 00:07:58,710
! انظروا من حولكم

121
00:07:58,710 --> 00:08:00,330
! هيّا عودوا إلى مواقعكم جميعاً

122
00:08:05,450 --> 00:08:06,860
.لقد أنقذتني

123
00:08:08,140 --> 00:08:11,820
.لقد سمعتُ أنّ صاحب هذا السلاح هو أحد رفاق ليدو

124
00:08:11,820 --> 00:08:12,260
.أجل

125
00:08:12,970 --> 00:08:16,240
إذن فهنالك أكثر من شخصٍ قادم من السماوات ؟

126
00:08:16,980 --> 00:08:21,780
لكن ما الذي من الممكن أن يكون يريد منّا ؟

127
00:08:23,620 --> 00:08:24,650
! رسالةٌ طارئة

128
00:08:26,720 --> 00:08:28,880
.لديك رسالة من الأسطول

129
00:08:30,350 --> 00:08:32,450
معك فلانجي، ما الأمر ؟

130
00:08:33,180 --> 00:08:36,170
.إنهم يطالبون بحضور ممثّلنا

131
00:08:36,840 --> 00:08:37,870
لماذا ؟

132
00:08:37,870 --> 00:08:39,690
.لم يحدّدوا أيّ سببٍ لذلك

133
00:08:39,690 --> 00:08:41,270
.لا شكّ أنهم هنا لأجل تلك الآثار

134
00:08:41,270 --> 00:08:42,140
.سوف أذهب

135
00:08:42,140 --> 00:08:43,250
! انتظر

136
00:08:43,250 --> 00:08:45,170
.أنا المسؤول عن هذه الجلبة هنا

137
00:08:45,170 --> 00:08:46,380
.سوف أقوم بتسوية الأمور

138
00:08:46,950 --> 00:08:51,200
.لا وقت لديّ لأوهام عظمتك، يستحيل أن نعهد لك بمفاوضاتٍ دبلوماسية

139
00:08:51,200 --> 00:08:53,010
...حسناً، يا سيدي

140
00:08:54,130 --> 00:08:58,350
.إنهم يطالبون ببينيون بحر الضباب كممثّل لنا

141
00:08:58,350 --> 00:09:00,560
.أَرأيت ؟ سوف أهتم بالأمر

142
00:09:00,560 --> 00:09:02,020
هل فقدت عقلك ؟

143
00:09:02,020 --> 00:09:07,480
إن تمّ أخذك كرهينة، فمن الذي سوف يحافظ على تماسك الأسطول هنا ؟

144
00:09:08,130 --> 00:09:09,690
...و إن يكن

145
00:09:09,960 --> 00:09:17,270
.لا داعي للقلق، حتى و إن بقيتُ هنا، فلن يتّبعني لكوني قد أنهيت الأمر هكذا

146
00:09:17,270 --> 00:09:18,660
.أنت تحصد ما زرعته

147
00:09:20,290 --> 00:09:23,620
.حسناً، كن حذراً وحسب

148
00:09:24,020 --> 00:09:26,610
.بالتأكيد، سوف أذهب الآن

149
00:09:35,140 --> 00:09:36,140
! بينيون

150
00:09:36,140 --> 00:09:36,760
ماذا ؟

151
00:09:37,410 --> 00:09:39,940
.انتظر هنا وحسب، لقد قالوا أنهم سيرسلون سفينةً ما

152
00:09:39,940 --> 00:09:40,720
.حسناً

153
00:09:42,490 --> 00:09:45,600
".لن يتّبعني أحدٌ بعد أن جعلت الأمور تنتهي هكذا"

154
00:09:45,940 --> 00:09:46,990
.اخرسي

155
00:09:46,990 --> 00:09:48,210
.أنت تبالغ

156
00:09:48,210 --> 00:09:49,590
.الأمر ليس هكذا

157
00:09:49,590 --> 00:09:50,850
حقاً ؟

158
00:09:50,850 --> 00:09:56,010
.لطالما قد كنتَ فاشلاً. لن يتخلّى عنك أحدٌ لسببٍ كهذا

159
00:09:56,660 --> 00:09:58,070
.أعتقد أنني مدينٌ لك بالشّكر

160
00:09:58,070 --> 00:09:59,090
.أوه، ها قد أتوا

161
00:10:03,020 --> 00:10:04,690
! أوه ؟! ألقِ نظرة

162
00:10:04,690 --> 00:10:05,700
...إنّ هذه

163
00:10:06,290 --> 00:10:08,220
! السّرطان المتزلّج

164
00:10:20,720 --> 00:10:24,390
أنت هو بينيون بحر الضباب، أليس كذلك ؟

165
00:10:24,770 --> 00:10:29,600
.أجل، إنه لمن المفاجئ رؤية راكيج، ملكة القراصنة العظيمة بحدّ ذاتها هنا

166
00:10:29,890 --> 00:10:33,060
.سيكون من الكافي قولك راكيج وحسب

167
00:10:33,060 --> 00:10:33,980
...و بالإضافة لذلك

168
00:10:35,630 --> 00:10:38,490
.من الأفضل لك أن تزن كلامك قبل أن تتفوّه به

169
00:10:39,260 --> 00:10:40,560
.حسناً، حسناً

170
00:10:56,790 --> 00:11:00,340
يبدو أنه يمرّون بوقتٍ عصيب، أَلا يملكون طعاماً أم ماذا ؟

171
00:11:01,440 --> 00:11:03,700
.الضعيف يخدم القوي

172
00:11:03,700 --> 00:11:07,600
.هذه هي العناية الإلهية كما ترى

173
00:11:10,260 --> 00:11:12,020
هل إلهكم ذاك... هو هذا ؟

174
00:11:13,780 --> 00:11:15,810
.إنّ هذا عملاق الرّعد

175
00:11:15,810 --> 00:11:19,040
.إنّ هذا خادم الإله الذي يفترض به أن يصدر الحكم الإلهي

176
00:11:20,570 --> 00:11:24,850
،في ذلك الوقت الذي يمضيه بشر هذا الكوكب في العيش ببيئة ترف

177
00:11:24,850 --> 00:11:27,410
.من المفترض أن يتسغلّوه في الحد من طغيان الهيديوس

178
00:11:28,170 --> 00:11:34,290
إنّ واجبنا هو أن نقوم بتعليمهم كيفية
.الدفاع عن أنفسهم و نصبح مبشّرين لمجد البشرية

179
00:11:34,910 --> 00:11:37,120
...بالنسبة لهذا الأخير يا سيدي

180
00:11:37,700 --> 00:11:39,040
...إنّ الهيديوس

181
00:11:41,240 --> 00:11:43,470
! إنهم بشر

182
00:11:44,870 --> 00:11:47,100
.تقصد بشراً سابقون

183
00:11:48,500 --> 00:11:50,560
!أنت تعلم بشأن هذا يا سيدي ؟

184
00:11:51,090 --> 00:11:53,880
.إنّ هذا لم يكن بالأمر الذي تتمّ مناقشته حتّى عند دوي المناصب العلياا

185
00:11:54,710 --> 00:11:58,360
أما بالنسبة إلينا نحن الذين نقاتل بالخطوط الأمامية، فما هي إلا معلومات لا أهمية لها

186
00:11:58,870 --> 00:12:00,070
لا أهمية لها ؟

187
00:12:00,070 --> 00:12:03,930
.إنّ الهيديوس لا يقودهم سوى الجوع و قاعدة من الغرائز

188
00:12:04,740 --> 00:12:06,280
.لذا فمن المستحيل أن ندعوهم بشراً

189
00:12:07,390 --> 00:12:07,990
.أجل

190
00:12:08,370 --> 00:12:12,350
.كلٌّ من القوي و الضعيف يساعدان بعضهما البعض لسببٍ وجيه

191
00:12:13,190 --> 00:12:17,180
.و بهذا فهم يُسهمون في تكوين المجتمع على طريقتهم

192
00:12:17,180 --> 00:12:19,460
.هذا ما يعنيه أن يكون المرء بشرياً

193
00:12:20,250 --> 00:12:21,920
...أجل، قد يكون هذا صحيحاً، لكن

194
00:12:22,660 --> 00:12:25,490
.لقد وضعتُ نظاماً بهذا الأسطول

195
00:12:25,490 --> 00:12:31,890
.و نتيجة لذلك، فإنّ متوسّط رفاهية هنا قد ارتفع

196
00:12:32,480 --> 00:12:36,110
.المرجو التعريف عن المقصود "بالرفاهية" في هذا السياق

197
00:12:36,520 --> 00:12:39,060
،استناداً على مبادئ التحالف المجرّي

198
00:12:39,060 --> 00:12:43,790
فإنّ "الرفاهية" تعرف بحالة أداء المنافع و التكاليف

199
00:12:43,790 --> 00:12:47,070
.التي يؤديها الفرد للمجتمع و تكون بأقصى حدودها

200
00:12:47,650 --> 00:12:51,540
.و بالتّالي، فإنّ الرفاهية مرتبطة باستقرار القيادة

201
00:12:52,010 --> 00:12:54,000
.أتفق معك بالتعريف و الاستنتاج

202
00:12:54,930 --> 00:12:57,350
أَهذا... صحيح ؟

203
00:12:58,390 --> 00:13:03,030
أخبرني يا ليدو، ألن تساعدني على تغيير هذا الكوكب ؟

204
00:13:16,250 --> 00:13:17,020
.تفضل من هنا

205
00:13:18,580 --> 00:13:20,650
ماذا، ما من أحدٍ هنا ؟

206
00:13:32,020 --> 00:13:33,120
ما هذا ؟

207
00:13:49,420 --> 00:13:50,640
! لكم هذا رائع

208
00:13:51,890 --> 00:13:55,600
ما رأيك بهذه إذن ؟

209
00:13:56,900 --> 00:13:58,070
.عظيم

210
00:13:58,070 --> 00:14:02,160
.بينيون بحر الضباب، نرحّب بك كضيفنا المميز

211
00:14:03,040 --> 00:14:05,460
ماذا ؟ أَهذا جهاز إرسال ؟

212
00:14:05,460 --> 00:14:10,070
.من الضروري أن يتمّ تحسين تكنولوجيا البشر على الأرض

213
00:14:10,420 --> 00:14:15,680
.لقد كان هذا اختباراً لمهارات بينيون بحر الضباب

214
00:14:15,680 --> 00:14:18,040
.لقد تمّ تصنيف كفائتك بكونها واعدة

215
00:14:18,740 --> 00:14:24,630
تبدو لي مألوفاً، هل أنت أحد أقارب ذلك الخردة ؟

216
00:14:28,290 --> 00:14:34,390
.X3752 أنا نظام مساعد الطيّار، سترايكر

217
00:14:34,920 --> 00:14:37,850
و ما الذي من الممكن أن تكون تريده مني يا سترايكر ؟

218
00:14:38,400 --> 00:14:43,840
.إنّ مقدرتك على إصلاح الأسلحة التي تتمّ استعادتها من قاع البحر جديرة بالإعجاب

219
00:14:43,840 --> 00:14:48,820
.لكن بالرغم من ذلك، فهي مجرّد تدبير مؤقّت يفتقر لفهم البنية الاساسية

220
00:14:48,820 --> 00:14:50,560
و ما أدراني بذلك ؟

221
00:14:50,560 --> 00:14:53,490
.لا فكرة لديّ عن طريقة عمل تلك الآليات القديمة

222
00:14:53,980 --> 00:14:59,460
.نحن على استعداد لتزويدك بالمعلومات بشأن هذا الأخير

223
00:14:59,460 --> 00:15:00,770
...إنّ هذا

224
00:15:00,770 --> 00:15:04,180
.مع مهاراتك هذه، فإنّ إصلاح الأسلحة سيكون الخطوة الأولى ليس إلا

225
00:15:04,180 --> 00:15:08,050
.طالما أنّ تصميم و تصنيع أسلحةٍ جديدة يندرج ضمن قدراتك

226
00:15:08,050 --> 00:15:10,630
.يبدو أنك تتوقّع الكثير مني

227
00:15:10,980 --> 00:15:15,070
.لقد تمّ اعتبارك قادراً على التعامل مع تكنولوجيا كهذه

228
00:15:15,070 --> 00:15:19,770
.إنّ مطلبنا الأخير منك هو أن تمثّل القيادة كضابطٍ مهندس

229
00:15:19,770 --> 00:15:21,450
ضابط ؟

230
00:15:22,090 --> 00:15:23,910
! أنا لستُ بجندي

231
00:15:23,910 --> 00:15:27,610
و الأهم من ذلك، هل بإمكانك أن تضمن سلامة أسطولي ؟

232
00:15:27,610 --> 00:15:32,570
.إنه موردٌ بشري صالح ينبغي ألا تتم إضاعته

233
00:15:32,570 --> 00:15:34,660
إضاعته ؟

234
00:15:34,660 --> 00:15:38,290
.حسناً، إن كنت تضمن سلامتنا، فأنا على استعداد للتعاون معكم

235
00:15:38,290 --> 00:15:41,020
.نتوقع الكثير منك

236
00:15:56,010 --> 00:15:58,020
.اقرأ هذا قبل أن تشرع بالأكل

237
00:15:59,640 --> 00:16:01,480
.كلما قد أسرعتَ بالحديث، كلما قد أسرعنا بالانتهاء

238
00:16:01,910 --> 00:16:04,260
...يالك من شخص مغرور يا هذا

239
00:16:06,250 --> 00:16:09,150
.اجلس مكانك و سينتهي الأمر سريعاً

240
00:16:10,640 --> 00:16:13,570
.هنا بينيون بحر الضباب يخاطبكم

241
00:16:13,570 --> 00:16:17,610
.إنّ التفاني و التعاون هو جوه النّاس

242
00:16:17,610 --> 00:16:24,250
.بانضمامنا إلى أسطول كوغيل، فإنّ أسطول فلانجي سيحقّق ازدهارا أكبر

243
00:16:25,190 --> 00:16:28,090
.و أنا واثقٌ من كونكم ستختار على نحوٍ حكيم

244
00:16:29,050 --> 00:16:30,260
.هذا كلّ ما لدي

245
00:16:30,750 --> 00:16:32,720
.ما هذه إلا طريقة مضلّلة ليطلبوا منا الاستسلام

246
00:16:33,300 --> 00:16:34,430
أيها العميد ؟

247
00:16:35,310 --> 00:16:38,140
.لكن مع ذلك فلا خيار لدينا سوى القبول بذلك

248
00:16:59,640 --> 00:17:01,450
.لقد قيل لي أنك قائد هذا الأسطول

249
00:17:01,450 --> 00:17:02,660
.هذا صحيح

250
00:17:03,590 --> 00:17:07,130
.لقد اتخذت القرار الصائب

251
00:17:07,130 --> 00:17:09,680
.أتمنى أن نحلّ هذا بشكلٍ سلمي

252
00:17:09,680 --> 00:17:11,590
ما الذي تحاولون فعله ؟

253
00:17:11,590 --> 00:17:14,520
! إنهم يحاولون تقطيع أسطولنا

254
00:17:14,520 --> 00:17:15,390
!ماذا ؟

255
00:17:16,060 --> 00:17:19,550
.سوف يتمّ اختيار السفن وفقاً لكفائتها

256
00:17:19,830 --> 00:17:21,300
.لا يمكنني القبول بهذا

257
00:17:21,300 --> 00:17:23,340
.إنّ أسطولنا كالعائلة

258
00:17:23,340 --> 00:17:26,020
.نحن لا نعمل إلا سويةً

259
00:17:26,690 --> 00:17:31,230
.من الآن فصاعداً، سوف تساهمون في بناء عائلة أكبر

260
00:17:31,230 --> 00:17:32,440
...لكن

261
00:17:32,930 --> 00:17:35,620
.إنّ السعادة سوف تصل أولئك الذين يتّبعون الرعاية الإلهية

262
00:17:36,240 --> 00:17:40,390
.لكنّ الحكم الإلهي سوف ينزل على أولئك الذي يعارضونها

263
00:17:45,370 --> 00:17:46,370
.فهمت

264
00:17:46,370 --> 00:17:50,050
.فلتركع إذن، علينا أن نباركك

265
00:17:52,430 --> 00:18:02,170
.قد تكرّس حياتك و قدرتك للعمل باسم الرعاية الإلهية

266
00:18:03,830 --> 00:18:06,220
.إنّ هذا المكان يبدو مختلفاً عن الآخر بكثير

267
00:18:06,220 --> 00:18:08,730
.لا شكّ أن هؤلاء الأشخاص فاحشوا الثراء

268
00:18:09,390 --> 00:18:12,070
.ليس هنالك مالٌ هنا

269
00:18:12,070 --> 00:18:13,850
أنّى لكم أن تعيشوا بدون مال ؟

270
00:18:13,850 --> 00:18:17,700
.إنّ الناس هنا يحصلون على حصصهم الغذائية بناءً على مساهمتهم بالأسطول

271
00:18:18,020 --> 00:18:20,380
.إنّ هذا مجتمهٌ عادلٌ للغاية

272
00:18:21,120 --> 00:18:22,580
عادلٌ إذن ؟

273
00:18:23,600 --> 00:18:27,410
.إنّ أماكن إقامتكم من هنا، سأطلعك على غرفتك

274
00:18:36,830 --> 00:18:38,430
ما خطب هؤلاء ؟

275
00:18:39,890 --> 00:18:40,930
أين هم رفاقي ؟

276
00:18:41,470 --> 00:18:45,250
.إنّ السفن قد تفرّقت و انظمت للأسطول كما قد أخبرناك

277
00:18:45,250 --> 00:18:45,890
!تفرّقت ؟

278
00:18:46,470 --> 00:18:52,110
بالتأكيد. أتعتقد أننا ساذجون بما فيه الكفاية حتى نجمع متمرّدين محتملين بمكانٍ واحد ؟

279
00:18:52,110 --> 00:18:55,320
!تطلبون منّا الانضمام في البداية، بعدها تعاملوننا كمتمرّدين ؟

280
00:18:56,420 --> 00:19:01,780
.في كلتا الحالتين. سيكون من الأفضل لك إن امتنعت عن الاتصال بأصدقائك حالياً

281
00:19:04,420 --> 00:19:06,160
...لقد انتهى الأمر

282
00:19:14,960 --> 00:19:17,470
.إنّ تحليل بيانات الفيروس قد اكتملت

283
00:19:17,470 --> 00:19:20,090
.يتمّ البدأ الآن بالفحص الطبّي

284
00:19:24,320 --> 00:19:26,120
.لقد انتهى الفحص الطبّي

285
00:19:26,120 --> 00:19:26,770
.ليست هنالك أيّ تشوّهات

286
00:19:28,520 --> 00:19:33,440
طوال هذا الوقت، كان العقيد كوغيل يقود هذا الأسطول الضخم بهذا الفضاء الضيّق ؟

287
00:19:34,590 --> 00:19:36,050
.لا يمكنني أن أرقى له

288
00:19:36,050 --> 00:19:40,360
أعتقد أنّ انسحاب العقيد كوغيل إلى قمرته كان له تأثير

289
00:19:40,360 --> 00:19:45,870
.في تحويل هيئته إلى رمزٍ و إثارة مشاعر الرهبة بين أعضاء الأسطول

290
00:19:45,870 --> 00:19:51,120
.يبدو أنّ هذا هو السبب المؤدي لامتلاكه هذه السلطة القويّة الآن

291
00:19:51,400 --> 00:19:54,320
أَيخاف النّاس ممَّ لا يرونه ؟

292
00:19:54,930 --> 00:19:58,890
لكن هل جعل الناس خائفين على الدوام أمرٌ صائب ؟

293
00:19:58,890 --> 00:20:03,470
.إنّ التكيّف مع الخوف هو أحد العوامل الأساسية في سلوك جميع الكائنات الحيّة

294
00:20:03,470 --> 00:20:07,540
،كما أنّ إبراز القوّة يهبّ الخوف لدى العدو

295
00:20:07,540 --> 00:20:11,060
.و مع ذلك فهو يمثّل السلام و السلامة لأولئك الذين يطيعونه

296
00:20:11,620 --> 00:20:13,270
...هذا صحيح، لكن بالرغم من ذلك

297
00:20:14,330 --> 00:20:22,480
.و قد تمّ استنتاج أنّ السيادة من خلال القوّة فعّال ضدّ الهيديوس

298
00:20:22,480 --> 00:20:25,180
و يمكنك من حشد عدد كبير من الموظفين

299
00:20:25,180 --> 00:20:29,350
.و الحفاظ على مجتمع مستقر و سريع الاستجابة

300
00:20:29,350 --> 00:20:30,000
...و بالإضافة

301
00:20:30,000 --> 00:20:31,120
.هذا يكيفي

302
00:20:32,750 --> 00:20:38,550
.أنا أيضاً... ما كان عليّ الخروج من قمرة القيادة

303
00:20:49,450 --> 00:20:51,660
.مرحباً بعودتك يا سيدتي

304
00:20:51,660 --> 00:20:52,770
.مساء الخير

305
00:20:54,260 --> 00:20:55,730
.لقد عدت

306
00:20:56,020 --> 00:20:58,440
كيف كان ذاك الرّجل المدعو بينيون ؟

307
00:20:59,380 --> 00:21:00,900
.ليس سوى سفيهاً

308
00:21:01,200 --> 00:21:02,160
! يا إلهي

309
00:21:02,160 --> 00:21:03,610
أَعلينا أن نتخلّص منه ؟

310
00:21:03,610 --> 00:21:04,990
.لا زال الوقت مبكراًَ على ذلك

311
00:21:07,030 --> 00:21:09,370
.إنه متفوّقٌ بما يتخصّص فيه

312
00:21:09,370 --> 00:21:13,180
.بالإضافة إلى ذلك، فالتسكّع بالأرجاء كلّ يومٍ صار أمراً مملاً

313
00:21:16,960 --> 00:21:19,710
.لقد اكتملت عملية الاستيقاظ

314
00:21:23,600 --> 00:21:25,840
.هنالك إرسال من العقيد كوغيل

315
00:21:29,680 --> 00:21:30,640
كيف تشعر ؟

316
00:21:31,180 --> 00:21:32,100
.أنا بخير

317
00:21:32,580 --> 00:21:35,060
.أنا بحاجةٍ لمساعدتك

318
00:21:35,650 --> 00:21:36,770
بخصوص الهيديوس ؟

319
00:21:37,220 --> 00:21:41,230
.كلا، إنها عمليّة تبشيرية بين شعب هذا الكوكب

320
00:21:41,780 --> 00:21:42,940
.كما تريد يا سيدي

321
00:21:43,380 --> 00:21:44,930
.جوابٌ رائع

322
00:21:44,930 --> 00:21:48,860
،الآن أنت هنا و بحوزتنا إثنتين من آلات العيار تحت تصرّفنا

323
00:21:48,860 --> 00:21:52,910
.بإمكاننا أن نمضي قدماً في العمل التبشيري بشكلٍ أوسع مما قد خطّطتُ له

324
00:21:53,160 --> 00:21:54,290
.هذا هو الهدف

325
00:21:57,720 --> 00:21:58,820
...إنّ هذا

326
00:22:05,960 --> 00:22:08,530
! غارغانتيا

327
00:22:14,900 --> 00:22:18,610
kimi no hitomi ni kono sekai wa

328
00:22:18,610 --> 00:22:22,350
donna fuu ni utsutterun darou

329
00:22:22,350 --> 00:22:27,420
kono umi de nani wo mitsuketeku no kana

330
00:22:29,680 --> 00:22:33,340
bukiyou na te de sukoshi zutsu

331
00:22:33,340 --> 00:22:37,080
kaze no yukue wo tsukamu you ni

332
00:22:37,080 --> 00:22:41,940
jibun no chikara de susunde yukun da

333
00:22:43,320 --> 00:22:50,550
kitto itsuka sono toki wa kuru yo

334
00:22:50,550 --> 00:22:54,660
sukoshi sabishii no wa

335
00:22:54,660 --> 00:22:58,980
kimi no sora ga mabushii kara dake

336
00:22:58,980 --> 00:23:05,740
ganbatteru sugata ga ureshikute ureshikute

337
00:23:05,740 --> 00:23:13,700
dakara watashi datte kawaranakuchatte kimeta no

338
00:23:13,700 --> 00:23:20,420
daijoubutte iwasete itsumademo itsumademo

339
00:23:20,420 --> 00:23:23,940
soba de miteru yo

340
00:23:23,940 --> 00:23:27,420
kimi rashii kyou no naka he

341
00:23:27,420 --> 00:23:31,160
ai ni yuku yo