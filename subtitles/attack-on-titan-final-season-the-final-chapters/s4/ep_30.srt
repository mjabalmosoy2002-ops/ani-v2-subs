620
00:51:26,600 --> 00:51:27,600
‫ميكاسا

621
00:51:28,310 --> 00:51:29,310
‫استيقظي

622
00:51:31,730 --> 00:51:32,860
‫ستصابين بالزكام

623
00:51:34,070 --> 00:51:35,070
‫إيرين؟

624
00:51:36,070 --> 00:51:37,070
‫ماذا؟

625
00:51:37,080 --> 00:51:38,080
‫منذ متى

626
00:51:39,280 --> 00:51:41,120
‫وانا نائمة؟

627
00:51:46,330 --> 00:51:48,970
‫لا بُد أنكّ منهكة

628
00:51:50,470 --> 00:51:54,010
‫أشعر وكأني حلمت حلم طويل

629
00:51:55,260 --> 00:51:58,850
‫لنأخذ بقية اليوم راحة

630
00:51:59,140 --> 00:52:01,470
‫اصطدتُ سمكة كبيرة اليوم

631
00:52:02,930 --> 00:52:04,060
‫ميكاسا؟

632
00:52:04,730 --> 00:52:06,020
‫لماذا تبكين؟

633
00:52:09,480 --> 00:52:10,940
‫أتسائل لماذا؟

634
00:52:12,150 --> 00:52:13,490
‫أنا

635
00:52:13,950 --> 00:52:16,660
‫أتسائل إن كان لا بأس من بقائي هنا

636
00:52:19,080 --> 00:52:20,080
‫حسنًا

637
00:52:20,490 --> 00:52:22,500
‫ليس بوسعنا فعل شيء حول ذلك

638
00:52:22,900 --> 00:52:23,370
‫ماذا؟

639
00:52:24,460 --> 00:52:28,630
‫نحن الأثنين هجرنا كل شيء وهربنا إلى هنا

640
00:52:29,000 --> 00:52:30,420
‫منذ ذلك اليوم

641
00:52:33,260 --> 00:52:35,800
‫مضى شهرين على انتهاء حرب مارلي

642
00:52:36,260 --> 00:52:38,760
‫والغزو على باراديس سيبدأ قريبًا

643
00:52:40,560 --> 00:52:42,720
‫الهرب هو السبيل الوحيد للنجاة

644
00:52:43,350 --> 00:52:46,850
‫لا شك أن آرمين يبحث عنّا بكل يأس الآن

645
00:52:48,870 --> 00:52:53,860
‫أنا لم أستطع جعل هيستوريا تخوض ذلك الجحيم
‫‫و الاستمرار في دوامة سفك الدماء

646
00:52:54,860 --> 00:52:58,110
‫ولم استطع ارتكاب ابادة جماعية على البشر خارج الجزيرة

647
00:52:59,990 --> 00:53:01,870
‫لذا

648
00:53:02,330 --> 00:53:05,080
‫سأعيش الأربع سنوات المتبقية لديّ في هدوءٍ وسلام

649
00:53:05,960 --> 00:53:09,000
‫حيث لا أحد آخر غيرنا، فقط نحن الإثنان

650
00:53:10,130 --> 00:53:14,160
‫فهذا ما اقترحتيه أنتِ، أليس كذلك يا ميكاسا؟

651
00:53:18,290 --> 00:53:18,660
‫أجل

652
00:53:23,390 --> 00:53:24,470
‫آسفة

653
00:53:25,230 --> 00:53:28,090
‫وعدتكَ بألَّا أتطرّق لهذا الموضوع

654
00:53:29,690 --> 00:53:32,520
‫هلّا قطعتِ لي وعدًا آخر؟

655
00:53:34,190 --> 00:53:35,610
‫عندما أموت

656
00:53:35,990 --> 00:53:37,820
‫ارمي بهذا الوشاح بعيدًا

657
00:53:39,160 --> 00:53:42,590
‫أمامكِ حياة طويلة لتعيشيها

658
00:53:44,410 --> 00:53:46,000
‫لذا عليكِ نسياني

659
00:53:46,960 --> 00:53:48,330
‫وتكونين حرة

660
00:53:53,960 --> 00:53:55,460
‫أرجوكِ يا ميكاسا

661
00:53:57,090 --> 00:53:58,300
‫انسيني

662
00:54:20,660 --> 00:54:21,700
‫آسفة

663
00:54:24,740 --> 00:54:25,870
‫لا يمكنني

664
00:54:28,040 --> 00:54:29,790
‫إيرين بداخل الفم!

665
00:54:31,670 --> 00:54:32,750
‫جميعكم

666
00:54:32,750 --> 00:54:34,040
‫ساندوني!

667
00:54:34,540 --> 00:54:36,340
‫عُلم يا ميكاسا!!

668
00:54:38,880 --> 00:54:40,800
‫إيرين!

669
00:55:48,790 --> 00:55:50,040
‫أراك لاحقًا

670
00:55:51,160 --> 00:55:52,210
‫إيرين

671
00:56:12,890 --> 00:56:22,930
‫ ‫الحلقة الأخيرة

672
00:56:12,890 --> 00:56:23,130
‫‫نـــــحــو الشـــــجــــرة على أعــــلـــــى التــــــــــل

673
00:56:27,280 --> 00:56:32,200
‫أعلم بأنك فعلتها لأجل المستقبل الذي رأيته بعملاقك المهاجم، ولكن...

674
00:56:33,000 --> 00:56:37,830
‫هل حقّا احتجتَ لإبراحي ضربًا؟

675
00:56:38,210 --> 00:56:40,630
‫هل كان من الضروري ركلك لي بذلك الشكل؟

676
00:56:40,920 --> 00:56:44,090
‫أردتُ إبعادكما عني بقدر الإمكان

677
00:56:44,090 --> 00:56:47,390
‫حتى أني وجدتُ نفسي متسائلًا عمّا أفعل،

678
00:56:48,510 --> 00:56:50,720
‫ثم تماشيتُ مع الأمر

679
00:56:52,470 --> 00:56:53,890
‫أنا آسف حقا

680
00:56:54,100 --> 00:56:57,270
‫اعتذر لميكاسا وليس لي

681
00:56:57,600 --> 00:56:59,940
‫ذلك الهراء الذي تفوهتَ به قد جرحها

682
00:57:00,690 --> 00:57:01,730
‫أجل

683
00:57:02,070 --> 00:57:03,690
‫أنت محق

684
00:57:05,400 --> 00:57:08,110
‫كل ذلك كان لأجل أن تبعدنا عنك

685
00:57:08,670 --> 00:57:14,350
‫ونقضي عليك لتجعل منا أبطال أنقذوا البشرية من الإنقراض؟

686
00:57:14,970 --> 00:57:15,790
‫أجل

687
00:57:16,290 --> 00:57:20,380
‫حينها سيتم وصفكم بأبطال الإنسانية الذين أنقذوا ما تبقى من البشر

688
00:57:20,960 --> 00:57:25,540
‫وعصيتُم جزيرة باراديس رغم أنكم شياطينها لمساعدة البشرية

689
00:57:27,550 --> 00:57:31,010
‫ذلك سيجعل منكم الكائنات الأكثر جدارة بالاحترام في هذا العالم

690
