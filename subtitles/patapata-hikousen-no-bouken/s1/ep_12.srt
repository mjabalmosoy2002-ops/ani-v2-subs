1
00:02:08,230 --> 00:02:09,540
!لقد أتوا

2
00:02:24,960 --> 00:02:27,960
!آنسة كاميل! لقد ظهروا

3
00:02:27,960 --> 00:02:29,100
!حسنٌ! لقد فهمت

4
00:02:30,880 --> 00:02:32,590
.يا عمّ، خُذ النساء إلى المقر

5
00:02:32,800 --> 00:02:34,420
.أجل -
!آنسة كاميل -

6
00:02:35,080 --> 00:02:37,670
متى سينتهي هذا الصراع؟

7
00:02:39,160 --> 00:02:39,710
...ساشا

8
00:02:41,440 --> 00:02:43,630
.أعدكِ أن أضع حدًا لهذا الصّراع مهما كلّف الأمر

9
00:02:44,120 --> 00:02:47,040
!ثقي بي -
!أجل، مفهوم -

10
00:02:47,040 --> 00:02:49,340
والآن يا ساشا، اذهبي إلى المقر الرئيسي

11
00:02:49,560 --> 00:02:50,670
!أجل

12
00:02:52,200 --> 00:02:53,230
!هيّا بنا -
!أجل -

13
00:02:54,800 --> 00:02:56,350
...آنسة كاميل

14
00:02:56,680 --> 00:02:57,510
...ساشا

15
00:03:16,000 --> 00:03:18,260
!يا رجال! سننهب كُل شيء اليوم مُجددًا

16
00:03:47,200 --> 00:03:49,120
!أطلقوا! أطلقوا

17
00:03:51,960 --> 00:03:53,180
!ابتعدوا عن الطريق

18
00:04:21,360 --> 00:04:22,580
!آنسة كاميل

19
00:04:33,200 --> 00:04:33,870
...ساشا

20
00:04:51,320 --> 00:04:52,480
!اللعنة

21
00:05:04,120 --> 00:05:06,750
إنّكِ حسناء المظهر، ألستِ كذلك؟

22
00:05:07,120 --> 00:05:09,310
ألا تريدين القدوم معي؟ هاه؟

23
00:05:09,520 --> 00:05:10,710
!توقّف

24
00:05:15,920 --> 00:05:17,060
!آنسة كاميل

25
00:05:24,680 --> 00:05:25,490
!حمقاء

26
00:05:41,110 --> 00:05:42,190
...لا تغتري بنفسك

27
00:05:56,560 --> 00:05:57,990
!آنسة كاميل

28
00:05:58,200 --> 00:05:59,590
!...تماسكي

29
00:06:01,000 --> 00:06:02,510
!أنتِ، انهضي

30
00:06:05,880 --> 00:06:08,490
.سوف نزوركم مُجددًا في ليلةٍ ذات قمرٍ مكتمل

31
00:06:09,640 --> 00:06:10,780
!أيّها الجبان

32
00:06:14,160 --> 00:06:16,310
!فلنغادر يا رجال

33
00:06:21,480 --> 00:06:22,990
هل أنتِ بخير؟

34
00:06:29,760 --> 00:06:31,550
.على هذا المُعدّل، فلن نرى نهايةً لهذا

35
00:06:46,560 --> 00:06:48,860
،باسمي أنا كاميل جين حنان

36
00:06:49,080 --> 00:06:53,480
!أعدكم هنا والآن أنّني سأسحق أولئك اللصوص الأوغاد

37
00:06:53,480 --> 00:06:55,910
.في المرّة القادمة، سنكون نحن من سيهاجم أولًا

38
00:06:56,120 --> 00:06:59,460
!أعيروني قوّتكم مرّة أُخرى جميعكم

39
00:07:31,520 --> 00:07:34,190
!حسنٌ، واصل ببطئ

40
00:07:43,760 --> 00:07:46,140
.إنّها سفينة ميكانيكيّة، لا بدّ وأنّها لهم

41
00:07:57,720 --> 00:07:58,990
!حسنٌ، هيّا بنا

42
00:08:04,840 --> 00:08:06,550
!سيّئ! توقّف في الحال

43
00:08:18,280 --> 00:08:20,690
...إنّني أشعر بالملل

44
00:08:20,690 --> 00:08:22,800
!إن لم يكن لديك شيئًا تفعله فساعدنا

45
00:08:26,320 --> 00:08:27,510
!أيّها الشقي

46
00:08:32,000 --> 00:08:37,000
بالمناسبة‏،‏ إنّ ذلك الرجل ليس مُرشدًا كفؤًا
حيث وضعنا في موقفٍ لا يحسد عليه هكذا‏، أليس كذلك؟

47
00:08:53,600 --> 00:08:55,030
ما الخطب؟

48
00:08:58,000 --> 00:08:59,860
ما الخطب؟ -
!انظر هناك -

49
00:09:11,280 --> 00:09:13,230
!فليستعد الجميع للقتال

50
00:09:14,800 --> 00:09:17,070
.آنستي، من الخطِر عليكِ البقاء هنا

51
00:09:17,070 --> 00:09:19,510
.علينا الإسراع بالدّخول

52
00:09:20,720 --> 00:09:21,940
...هذا غريب

53
00:09:22,160 --> 00:09:23,190
ماذا؟ ما الّذي تعنيه؟

54
00:09:23,960 --> 00:09:25,390
.إنّهم من قبيلة حنان

55
00:09:25,390 --> 00:09:27,560
.ليس من طبعهم مهاجمة الآخرين

56
00:09:27,560 --> 00:09:29,040
!إنّهم أناسٌ مُسالمون

57
00:09:29,440 --> 00:09:30,230
أأنت واثقٌ من ذلك؟

58
00:09:30,800 --> 00:09:33,510
!أنا لا أكذب! يُمكنكِ معرفة ذلك بمجرّد التحدّث معهم

59
00:09:39,320 --> 00:09:42,630
.إننا نتعرّض لهجوم. احتموا بداخل السّفينة

60
00:09:44,040 --> 00:09:46,280
.صبري، ساعدني

61
00:09:46,280 --> 00:09:47,670
.تشامبلان، أنتَ أيضًا

62
00:09:47,880 --> 00:09:50,470
أنا أيضًا؟ -
!هيّا بنا أيّها العجوز -

63
00:09:53,200 --> 00:09:55,530
.انتظروهم حتّى يقتربوا ومن ثمَّ أطلقوا عليهم

64
00:10:05,800 --> 00:10:06,660
!سيّد كايلب

65
00:10:07,560 --> 00:10:09,230
!أرجوك أعرنا قارب الاستكشاف

66
00:10:09,640 --> 00:10:12,300
مهلًا لحظة! ما الّذي يجري فجأةً؟

67
00:10:12,320 --> 00:10:14,070
!رجاءً، نحن على عجلة

68
00:10:15,720 --> 00:10:16,940
.حسنٌ، فهمت

69
00:10:19,600 --> 00:10:21,230
!حسنٌ

70
00:10:22,480 --> 00:10:23,750
!توقّفوا

71
00:10:25,440 --> 00:10:26,270
!جين

72
00:10:30,000 --> 00:10:31,080
!توقّفوا

73
00:10:31,840 --> 00:10:33,300
!توقّفوا رجاءً

74
00:10:33,720 --> 00:10:35,110
!!أيّها الجميع! توقّفوا

75
00:10:46,440 --> 00:10:47,660
!توقّفوا رجاءً

76
00:10:47,880 --> 00:10:49,250
من أنتم؟

77
00:11:11,820 --> 00:11:13,730
...لِمَ قبيلة حنان

78
00:11:14,500 --> 00:11:17,390
.على الرّغم من أننا كنّا جاهلون، إننا نعتذر لكم لما بذر منّا

79
00:11:17,940 --> 00:11:19,930
.لا بأس، ما منٍ داع للاعتذار

80
00:11:20,140 --> 00:11:23,340
بالمناسبة، من كُنتم تظنوننا؟

81
00:11:23,340 --> 00:11:24,080
!...هذا

82
00:11:25,410 --> 00:11:26,780
!"تلك العصبة من "نيو سيتي

83
00:11:26,780 --> 00:11:27,970
نيو سيتي؟

84
00:11:28,860 --> 00:11:30,840
...إنّهم مجموعة مخيفة من الأشخاص

85
00:11:30,840 --> 00:11:33,930
.هاجموا قريتنا على مزالج ميكانيكيّة تتحرّك بسرعة أكبر من سهامنا

86
00:11:34,300 --> 00:11:35,730
مزالج ميكانيكيّة؟

87
00:11:38,540 --> 00:11:41,580
.إنّهم ينهبون ما هو أمامهم ويخطفون النّاس

88
00:11:41,580 --> 00:11:44,460
أيّها القائد، أيعقل أن يكونوا عصابة قطّاع الطّرق الغامضة تلك؟

89
00:11:44,460 --> 00:11:45,810
.انتظر فحسب

90
00:11:46,020 --> 00:11:49,480
آنسة كاميل، أي نوع من الأماكن هي "نيو سيتي"؟

91
00:11:49,820 --> 00:11:50,960
.إنّها مدينتهم

92
00:11:51,660 --> 00:11:54,610
.طبقًا للاشاعات، إنّها تقع في أقصى الشّرق

93
00:11:55,300 --> 00:11:58,100
.ولكن، لم يذهب أحد إلى هناك من قبل قط

94
00:11:58,100 --> 00:11:59,580
لِمَ يواصلون اختطاف النّاس؟

95
00:12:00,740 --> 00:12:01,800
.لا أعلم

96
00:12:02,580 --> 00:12:04,540
...ولكن، كُل ما أعرفه هو

97
00:12:05,780 --> 00:12:08,660
...أنّهم ينهبون مؤن النّاس

98
00:12:08,660 --> 00:12:10,180
...ويختطفون فلذات أكبادهم

99
00:12:10,180 --> 00:12:12,710
.وإن قاوموا، فسيقتلونهم كذلك...

100
00:12:17,820 --> 00:12:19,300
.هاجموا الكثير من القُرى

101
00:12:23,580 --> 00:12:26,550
،نحن قبيلة حنان برفقة قائدنا العظيم

102
00:12:26,550 --> 00:12:28,680
.واصلنا القتال والدّفاع عن القرية...

103
00:12:37,180 --> 00:12:40,010
...لكن... ذلك القائد ذو الروح العظيمة

104
00:12:42,140 --> 00:12:44,440
...والدي، يوين جين حنان

105
00:12:45,940 --> 00:12:46,890
.استشهد في المعركة...

106
00:12:47,300 --> 00:12:54,880
!إذن فأنتِ... تحمين القرية... بدلًا عن والدكِ

107
00:12:55,260 --> 00:12:58,090
،أيّها القائد، إن لم نُساعدهم

108
00:12:58,090 --> 00:13:00,370
!فسنكون عارًا على بلادنا...

109
00:13:01,300 --> 00:13:02,650
.إنّهُ مُحق

110
00:13:02,860 --> 00:13:05,420
،آنسة كاميل، إن سمحتِ لنا

111
00:13:05,420 --> 00:13:06,890
.نرغب بمساعدتكم

112
00:13:07,740 --> 00:13:09,210
.يسرّني سماع ذلك

113
00:13:09,420 --> 00:13:11,690
.ولكنَّ هذه المعركة معركتنا

114
00:13:11,900 --> 00:13:16,660
.لا يُمكنني توريط أشخاصًا آخرين وتعريضهم للخطر

115
00:13:16,660 --> 00:13:22,590
.أتفهم كيف تشعرين ولكن لا يُمكنكِ تولّي أمر هذه المعضلة لوحدكِ

116
00:13:23,580 --> 00:13:26,730
،إن استمرّت هذه الجماعة بكسب القوّة والعدد

117
00:13:27,780 --> 00:13:30,610
.فإنّ كارثةً ستحّل على جميع من يسكن هذه المنطقة...

118
00:13:31,580 --> 00:13:36,020
.إنّ رجالي يضاهون رجالكِ شجاعة في القتال

119
00:13:36,020 --> 00:13:39,520
.أرجوكِ اسمحي لنا بمساعدتكم في القتال

120
00:13:41,620 --> 00:13:43,210
.أرغب بمناقشة هذا الأمر مع رفاقي

121
00:13:43,820 --> 00:13:45,390
أيُمكنكم أن تمنحوني بعضًا من الوقت؟

122
00:13:46,100 --> 00:13:47,490
.لقد فهمت

123
00:13:55,740 --> 00:13:57,770
ما الّذي تنوين فعله؟

124
00:13:58,100 --> 00:14:00,780
.أُفكّر في قبول مساعدتهم

125
00:14:00,780 --> 00:14:03,940
...لكنّهم يمتلكون سفينةً مُشابهة للتي لدى اللصوص

126
00:14:03,940 --> 00:14:06,180
.قد يكونون حُلفاءً لهم

127
00:14:06,180 --> 00:14:09,700
."لم يبدو أنّهم يعلمون شيئًا عن "نيو سيتي

128
00:14:09,700 --> 00:14:12,210
...بالإضافة لذلك، إن استطعنا الاستفادة من تلك الآلة الضّخمة

129
00:14:12,420 --> 00:14:14,260
.رُبّما نتمكّن من هزيمتهم...

130
00:14:14,260 --> 00:14:15,290
...ولكن

131
00:14:15,780 --> 00:14:18,460
.أريد الوثوق بهم

132
00:14:19,100 --> 00:14:23,660
.فهمت. سنوافق على قراركِ

133
00:14:23,660 --> 00:14:24,210
.شُكرًا لك

134
00:14:30,300 --> 00:14:31,890
أتُصدّق هذا؟

135
00:14:32,100 --> 00:14:33,050
.لا يُصدّق

136
00:14:33,260 --> 00:14:34,650
...في مثل هذه الأرض القاحلة

137
00:14:34,860 --> 00:14:35,770
!أنت مُحق

138
00:14:36,540 --> 00:14:39,330
.إن أمكن فأرغب بأخذها لموطننا

139
00:14:39,540 --> 00:14:41,230
!إنّها قائدة قبيلتهم

140
00:14:42,540 --> 00:14:43,890
...ما الّذي تُفكّر فيه

141
00:14:44,100 --> 00:14:45,590
.إنّني أتحدّث عن المزالج الميكانيكيّة

142
00:14:48,300 --> 00:14:50,370
.ولست أتحدّث عن الآنسة كاميل

143
00:14:51,060 --> 00:14:53,490
عجبًا، عجبًا، لِمَ أراك احمررتَ خجلًا؟

144
00:14:54,500 --> 00:14:56,300
!أنا لستُ خجلًا

145
00:14:56,700 --> 00:14:59,210
لقد وقعت في حبّها، صحيح؟

146
00:15:00,540 --> 00:15:02,290
!...أيّها الشّقي

147
00:15:05,540 --> 00:15:07,090
!انتظر فحسب

148
00:15:09,940 --> 00:15:10,570
أأنتَ بخير؟

149
00:15:14,180 --> 00:15:17,050
.لقد حسمنا أمرنا، فلنقاتل معًا

150
00:15:17,260 --> 00:15:19,900
.اسمحوا لنا أن نريكم قرية حنان

151
00:15:19,980 --> 00:15:22,090
.حقًا؟ هذا عظيم

152
00:15:42,780 --> 00:15:44,450
.لقد كُنتِ تنظرين للقمر طوال الوقت

153
00:15:45,420 --> 00:15:46,610
أتحبّين القمر؟

154
00:15:46,820 --> 00:15:49,900
،أجل، إنّ القمر بالتحديد يبدو جميلًا في الصّحراء

155
00:15:49,900 --> 00:15:51,660
.أحبّه كثيرًا

156
00:15:51,660 --> 00:15:53,330
.حقًا؟ أُحبّه أنا أيضًا

157
00:15:54,220 --> 00:15:57,310
أتمانعين إخباري عن موطنكِ؟

158
00:15:58,360 --> 00:15:59,530
!لـ-لا مانع

159
00:15:59,740 --> 00:16:02,820
.في موطني، النّهار تجري بين الحقول والجبال

160
00:16:02,820 --> 00:16:06,660
.وثمّة الكثير من الأشجار، والمدن مليئة بالمباني العملاقة

161
00:16:06,660 --> 00:16:09,580
.القطارات تتنقل من مدينة لمدينة أُخرى

162
00:16:09,580 --> 00:16:10,690
ما هي القطارات؟

163
00:16:10,900 --> 00:16:16,090
كهذه السّفينة الرّملية‏،‏ إنّها وسيلة نقل تستعمل قوّة الآلات لنقل الكثير النّاس دفعة واحدة‏.‏

164
00:16:16,300 --> 00:16:17,770
...قوّة الآلات

165
00:16:26,260 --> 00:16:28,850
.إنّ قوّة الآلات لهي أمرٌ مُخيف

166
00:16:29,460 --> 00:16:32,330
.لم تلبث أن صُنعت ونجد من يُسيئ استخدامها

167
00:16:33,740 --> 00:16:35,090
قُلتِ أنّ اسمكِ جين، صحيح؟

168
00:16:35,300 --> 00:16:38,010
.إنّكم مُختلفون عن أولئك اللصوص

169
00:16:38,700 --> 00:16:40,290
.وهذا يكفي

170
00:16:40,900 --> 00:16:43,130
.عليّ الاستيقاظ غدًا باكرًا، أستأذنكِ الآن

171
00:16:54,260 --> 00:16:57,290
!قرية! يُمكنني رؤية قرية حنان

172
00:17:23,420 --> 00:17:24,450
...هذا فظيع

173
00:17:24,660 --> 00:17:25,410
.أجل

174
00:17:26,060 --> 00:17:28,010
.هذا من فعل أولئك اللصوص

175
00:17:29,500 --> 00:17:31,880
كيف تجني هذه القرية أموالها؟

176
00:17:32,740 --> 00:17:33,740
.بالتجارة

177
00:17:33,740 --> 00:17:37,360
هذه القرية أصبحت غنيّة كونها حلقة الوصل بين الأجزاء الشرقية والغربيّة من هذه الصحراء‏.‏

178
00:17:38,140 --> 00:17:40,930
.وذلك جعلكم هدفًا للصوص

179
00:17:59,940 --> 00:18:00,770
!يا رفاق

180
00:18:01,580 --> 00:18:02,770
!آنسة كاميل

181
00:18:05,900 --> 00:18:08,200
!آنسة كاميل! يسرّنا أنّكِ بخير

182
00:18:08,420 --> 00:18:10,190
!لقد عُدت بسلامة

183
00:18:10,900 --> 00:18:13,250
ما الخطب؟ لِمَ يبدو عليكم الخوف؟

184
00:18:13,580 --> 00:18:15,490
.طاب يومكم أيّها السادة

185
00:18:20,460 --> 00:18:22,890
.قوّة الآلات شيءٌ مُخيف

186
00:18:23,980 --> 00:18:28,420
.اسمعوني جميعكم رجاءً. لقد عقدنا حلفًا مع هؤلاء الأشخاص

187
00:18:28,940 --> 00:18:30,370
.إنّهم أشخاصٌ جديرين بالثّقة

188
00:18:31,220 --> 00:18:32,830
.إنّ قوّة العدو جبّارة

189
00:18:33,500 --> 00:18:37,010
.لهزيمتهم، أردت استعارة قوّة هؤلاء الأشخاص

190
00:18:37,220 --> 00:18:38,530
!تفهّموا ذلك رجاءً أيّها الجميع

191
00:18:38,740 --> 00:18:42,340
!إن كان ذلك قراركِ فسوف أثقُ بكِ يا آنسة كاميل

192
00:18:42,340 --> 00:18:43,010
...ساشا

193
00:18:44,900 --> 00:18:47,890
.هذا صحيح. إنّ ساشا مُحقّة

194
00:18:48,580 --> 00:18:49,930
!آنسة كاميل

195
00:18:50,740 --> 00:18:51,880
.شُكرًا لكِ يا ساشا

196
00:18:52,460 --> 00:18:54,690
!آنسة كاميل، مرحبًا بعودتكِ

197
00:18:58,580 --> 00:19:01,140
.ساشا، جهّزي غُرفًا لهم

198
00:19:01,340 --> 00:19:02,130
!أجل

199
00:19:03,460 --> 00:19:04,370
من تكون؟

200
00:19:04,580 --> 00:19:07,290
.ساشا؟ إنّها تعمل لدي

201
00:19:07,900 --> 00:19:11,710
.والداها قد تمّ أخذهم لـ"نيو سيتي" أيضًا

202
00:19:12,340 --> 00:19:13,480
نيو سيتي؟

203
00:19:14,340 --> 00:19:14,890
...ساشا

204
00:19:17,500 --> 00:19:19,850
!لهو شعورٌ رائع أن تطأ أقدامنا الأرض مُجددًا

205
00:19:20,380 --> 00:19:21,890
!يُمكنني أن أتمدد أيضًا

206
00:19:24,580 --> 00:19:26,250
المعذرة... بعض الشاي؟

207
00:19:26,940 --> 00:19:28,290
!شُكرًا جزيلًا

208
00:19:31,660 --> 00:19:35,840
.كما أرى إنّ العدو يظهر عادة من الطّريق المؤدّي لتاريما فقط

209
00:19:36,420 --> 00:19:39,330
.ولهذا أقترح أن تتمركز الصفوف الأولى عند مدخل تاريما

210
00:19:40,020 --> 00:19:43,800
علينا أن نوزّع رجالنا والمعدّات حول المنطقة بأكملها لكي نتمكّن من الاستيلاء على مزالجهم الميكانيكيّة‏.‏

211
00:19:44,500 --> 00:19:46,140
وإن اخترقوا صفوفنا؟

212
00:19:47,100 --> 00:19:50,020
.سنرد بهجومٍ شامل بمدافع السّفينة

213
00:19:50,020 --> 00:19:53,060
سيكون ذلك ملجأنا الأخير. أهذا يكفي؟

214
00:19:53,660 --> 00:19:55,810
...إنّ العدو يتحرّك بسرعة عالية

215
00:19:56,340 --> 00:19:58,380
...حريٌّ بنا أن نُعزز من دفاعاتنا ومن ثمَّ

216
00:19:58,380 --> 00:20:00,210
.إنّهم سريعون جدًا وأقوياء

217
00:20:00,820 --> 00:20:03,090
.السيوف والسّهام لن تجدي نفعًا ضدّهم

218
00:20:03,860 --> 00:20:07,640
سيّد مارسيناي، هل يُمكنك تعليمنا كيفيّة استخدام البنادق؟

219
00:20:08,620 --> 00:20:09,840
!يسرّني ذلك

220
00:20:10,420 --> 00:20:12,660
.حسنٌ، سنبدأ التدريب في الصّباح

221
00:20:23,740 --> 00:20:27,340
.سكاي، يبدو أنّه مُستمتع
.لا بدّ وأنّه كان يشعر بالوحدة

222
00:20:27,340 --> 00:20:28,890
!يا لحياته السهلة

223
00:20:29,100 --> 00:20:30,930
!أُريد أن أكون كلبًا أيضًا

224
00:20:31,140 --> 00:20:32,700
.لا أرى الكثير من الفروقات

225
00:20:32,700 --> 00:20:33,790
ما الّذي تعنيه بذلك؟

226
00:20:35,620 --> 00:20:36,810
!اجتماع

227
00:20:40,900 --> 00:20:44,680
.يا سادة! سأقسّمكم إلى مجموعات وأمنحكم مهامكم

228
00:20:45,220 --> 00:20:47,620
.الفرقة الأولى، الفرقة الثانية، عليكم التجهيز للتصدي لهجمات العدو

229
00:20:47,620 --> 00:20:50,340
.ستقومون بإعداد الكمائن وتعزيز الدفاعات

230
00:20:50,340 --> 00:20:53,620
.الفرقة الثالثة ستقوم بتدريب الرجال كيفيّة استخدام الأسلحة

231
00:20:53,620 --> 00:20:56,380
!ابدأوا بالتّنفيذ فورًا. انصراف

232
00:20:56,500 --> 00:20:57,640
!عُلم

233
00:21:18,380 --> 00:21:20,130
!رائع -
!حسنٌ، تبديل -

234
00:21:23,180 --> 00:21:24,810
!جيّد! أنتم تُبلون حسنًا

235
00:21:25,020 --> 00:21:25,690
!أطلقوا

236
00:21:34,900 --> 00:21:36,120
!حسنٌ، التالي

237
00:21:42,820 --> 00:21:44,070
!لا تتردد

238
00:21:55,700 --> 00:21:59,300
!"إنّ هذا فنٌّ قتالي من الشرق يُدعى بـ"الجوجيتسو

239
00:22:00,170 --> 00:22:01,300
!رائع

240
00:22:01,300 --> 00:22:02,340
!مُذهل

241
00:22:02,860 --> 00:22:04,170
!هذا مُثيرٌ للاعجاب

242
00:22:04,580 --> 00:22:06,770
!التخطيط، المهارة والقيادة

243
00:22:07,100 --> 00:22:08,490
!ياله من مُحاربٌ مُذهل

244
00:22:09,740 --> 00:22:11,370
.لكنّهُ مُزعجٌ أحيانًا

245
00:22:12,060 --> 00:22:13,560
والآن، هل أنت بخير؟

246
00:22:14,700 --> 00:22:16,270
...لا تجري الأمور كما ينبغي

247
00:22:29,860 --> 00:22:32,240
.آنستي، لقد كنتُ أبحث عنكِ

248
00:22:33,140 --> 00:22:34,350
ما الخطب؟

249
00:22:35,180 --> 00:22:37,330
.إنّ حربًا على وشك أن تبدأ

250
00:22:38,100 --> 00:22:39,500
.على ما يبدو

251
00:22:40,300 --> 00:22:42,600
!...لا أصدّق أن الآلات يتمّ استخدامها في القتال

252
00:22:43,340 --> 00:22:46,880
.من المُفترض أن تُحقق الآلات أحلامنا وتجلب السعادة للجميع

253
00:22:47,380 --> 00:22:50,260
أخي جورج، ماذا ينبغي أن أفعل؟

254
00:23:02,620 --> 00:23:05,180
.قرية حنان تستعد للقتال

255
00:23:05,180 --> 00:23:08,620
.لا يُمكن أن أكون الوحيدة التي تختبئ

256
00:23:09,220 --> 00:23:09,770
:الحلقة القادمة

257
00:23:09,980 --> 00:23:11,850
لصوص الآلات - الجزء الثاني

258
00:23:12,060 --> 00:23:13,010
!نراكم لاحقًا