1
00:02:13,360 --> 00:02:16,430
!أخي! أخي ويليام! ألقي نظرة على هذه

2
00:02:20,200 --> 00:02:22,490
...علّه خرج للعمل اليوم

3
00:02:30,040 --> 00:02:30,690
...ليست هنا

4
00:02:31,420 --> 00:02:33,500
أين اختفت ساعتي؟

5
00:02:35,250 --> 00:02:37,630
...سيّد جورج، عليك أن تستعجل

6
00:02:39,380 --> 00:02:40,840
.إنني أبحث عن غرضٍ ما

7
00:02:41,050 --> 00:02:43,300
!لكنّك ستتأخر

8
00:02:43,840 --> 00:02:45,470
...أجل، لكن

9
00:02:46,680 --> 00:02:48,060
!أعي ذلك

10
00:03:03,410 --> 00:03:05,280
!هذا جيد، هذا جيد

11
00:03:12,460 --> 00:03:14,460
.اعتنِ بنفسك -
.أجل، أبي -

12
00:03:16,460 --> 00:03:17,900
.خُذ يا أخي

13
00:03:18,130 --> 00:03:19,000
من أجلي؟

14
00:03:19,210 --> 00:03:21,210
!أجل! سنُحلق في السماء بهذه

15
00:03:21,470 --> 00:03:23,240
!عُد سريعًا وطِر بي نحو السماء

16
00:03:23,760 --> 00:03:27,640
أعدكِ يا جين
.عندما أعود، سوف نطير معًا في السماء بهذه

17
00:03:48,160 --> 00:03:49,700
!أخي

18
00:03:51,580 --> 00:03:53,910
!رحلة سعيدة

19
00:04:02,670 --> 00:04:04,050
!أخي

20
00:04:05,550 --> 00:04:06,670
!جين

21
00:04:06,800 --> 00:04:08,290
!أخي

22
00:04:10,390 --> 00:04:11,930
!أخي

23
00:04:29,910 --> 00:04:31,740
.إنني لا أرى ويليام هنا

24
00:04:32,370 --> 00:04:34,470
.قال أنّهُ مُضطّرٌ للخروج في رحلة عمل طارئة اليوم

25
00:04:34,790 --> 00:04:37,120
.رحلة عمل؟ لم أسمع عن ذلك

26
00:04:41,750 --> 00:04:43,130
ما معنى هذا؟

27
00:04:43,340 --> 00:04:45,380
!لم أسمع عن شيءٍ يخص رحلة عملٍ طارئة لويليام

28
00:04:45,920 --> 00:04:48,180
أتساءل ماذا قد تكون يا ترى؟

29
00:05:15,450 --> 00:05:17,210
!خُذ هذه

30
00:05:17,410 --> 00:05:20,920
!هذه الساعة هي إرثٌ عائلي قد مرّ على أجيال عائلة باكوستون

31
00:05:35,270 --> 00:05:37,310
ما الأمر الذي يجعلك مُضطربًا هكذا؟

32
00:05:39,560 --> 00:05:41,610
!لقد اختفت -
ما هي؟ -

33
00:05:41,940 --> 00:05:44,710
!لقد اختفت... صورة مارجريت قد اختفت

34
00:05:51,320 --> 00:05:52,530
أين هو؟

35
00:05:57,830 --> 00:05:59,000
!ويليام

36
00:06:06,450 --> 00:06:07,770
ما الخطب؟

37
00:06:08,090 --> 00:06:11,260
السيّد ويليام ليس هُنا -
ماذا؟ ما الذي قُلته؟ -

38
00:06:15,140 --> 00:06:16,340
!سيدي

39
00:06:17,220 --> 00:06:18,640
!لقد عُدت

40
00:06:21,940 --> 00:06:24,860
أبي؟ -
هل حدث شيءٌ ما؟ -

41
00:06:27,320 --> 00:06:29,030
ما الذي حدث؟

42
00:06:29,860 --> 00:06:31,040
...السيّد ويليام

43
00:06:31,450 --> 00:06:33,870
ما خطب أخي ويليام؟

44
00:06:34,070 --> 00:06:35,870
.لقد غادر

45
00:06:36,080 --> 00:06:36,850
!لماذا؟

46
00:06:39,280 --> 00:06:40,750
!آنستي

47
00:06:47,630 --> 00:06:49,960
أخي ويليام... لماذا؟

48
00:06:51,130 --> 00:06:53,760
لِمَ غادرتَ دون أن تُخبرني بشيء؟

49
00:07:41,850 --> 00:07:44,770
أبي، أُنظر! أليست جميلة؟

50
00:07:44,980 --> 00:07:45,690
!إنّها أزهار القسموس

51
00:07:46,980 --> 00:07:48,230
أحقًا؟

52
00:07:55,160 --> 00:07:58,780
.ثمّة رسالة من البرلمان

53
00:07:58,990 --> 00:08:00,370
البرلمان؟

54
00:08:00,580 --> 00:08:02,940
.علّها أخبارٌ من السيّد جورج

55
00:08:03,520 --> 00:08:05,210
رسالةٌ من أخي جورج؟

56
00:08:05,370 --> 00:08:07,630
.فهمت، إنّها من جورج

57
00:08:15,760 --> 00:08:16,890
ما الخطب؟

58
00:08:17,590 --> 00:08:19,100
...جورج قد

59
00:08:19,680 --> 00:08:21,410
جورج قد تم إعدامه؟

60
00:08:34,110 --> 00:08:37,320
!مُستحيل
جورج قد تم إعدامه؟

61
00:08:38,240 --> 00:08:39,910
السيّد جورج تم إعدامه...؟

62
00:08:39,910 --> 00:08:41,120
!أخي

63
00:08:41,330 --> 00:08:44,700
!بسبب الخيانة... الخيانة يقولون

64
00:08:44,910 --> 00:08:46,850
!سيدي

65
00:08:49,380 --> 00:08:52,320
...جورج باكوستون تم إعدامه

66
00:08:53,090 --> 00:08:54,510
!لجريمة خيانة...

67
00:08:55,670 --> 00:08:58,260
!أخي قد تم... إعدامه؟

68
00:09:11,060 --> 00:09:12,900
...شامبلان

69
00:09:22,030 --> 00:09:24,870
!لِمَ... لِمَ يتركني الجميع؟

70
00:09:24,870 --> 00:09:27,160
!جورج... ويليام... أُمّي

71
00:11:26,450 --> 00:11:28,580
!كيف يُمكن لهذا أن يحدث؟

72
00:11:38,130 --> 00:11:40,760
!أبي، لقد حان الوقت

73
00:11:40,770 --> 00:11:43,290
!شُكرًا لكِ يا جين، لنغادر سويةً

74
00:11:50,480 --> 00:11:54,690
!نحن الشرطة... نحن نود أن نتحدث مع السيّد إدوارد باكوستون

75
00:11:54,690 --> 00:11:55,890
!بخصوص ماذا؟

76
00:11:56,430 --> 00:12:01,140
!مصرفك قد تم السطو عليه، علّكَ سمعتَ بذلك

77
00:12:01,380 --> 00:12:03,370
!ما الذي قُلته؟
البنك قد تمّ السطو عليه؟

78
00:12:03,540 --> 00:12:04,240
...أبي

79
00:12:04,800 --> 00:12:07,840
.كلا، لا تقلقي
.اذهبي للمدرسة يا جين

80
00:12:07,890 --> 00:12:08,700
!لكن

81
00:12:08,910 --> 00:12:10,960
.سيكون كل شيء على ما يُرام يا جين

82
00:12:10,970 --> 00:12:11,620
...حسنٌ

83
00:12:12,330 --> 00:12:14,790
.دعوني أستمع للقصة

84
00:12:19,840 --> 00:12:23,510
!هذا مُستحيل! لِمَ قد أقوم بسرقة مصرفي؟

85
00:12:23,790 --> 00:12:25,250
!ما الذي سأجنيه من ذلك؟

86
00:12:25,340 --> 00:12:26,920
!تأمين السرقة

87
00:12:27,130 --> 00:12:29,840
.تأمين السرقة؟ هذا سخيف

88
00:12:35,470 --> 00:12:36,180
!ما هذا؟

89
00:12:38,720 --> 00:12:39,480
!ه-هذه

90
00:12:40,270 --> 00:12:42,980
.وجدناها بداخل الخزنة

91
00:12:55,580 --> 00:12:57,160
!إنّها الحقيقة

92
00:12:57,370 --> 00:12:59,700
!لقد كانت هنالك غيمةً سوداء ضخمة في السماء

93
00:13:00,370 --> 00:13:02,000
!وكان هنالك أُناس بداخلها

94
00:13:05,500 --> 00:13:07,250
!لقد رأيتها بأُمّ عيني

95
00:13:11,920 --> 00:13:14,930
...لقد تمّ تفريغ الخزنة بالكامل

96
00:13:15,640 --> 00:13:17,350
أيعقل أنّ السيّد فعل هذا؟

97
00:13:22,770 --> 00:13:24,940
...الساعة الذهبيّة التي أعطيتُها لجورج

98
00:13:25,150 --> 00:13:26,770
.قد عُثر عليها بداخل الخزنة...

99
00:13:26,980 --> 00:13:28,990
!هذا غير صحيح! من المُستحيل أن يكون أخي هو الفاعل

100
00:13:30,190 --> 00:13:31,690
!بالطبع يا جين

101
00:13:31,900 --> 00:13:35,160
!...الفاعل ليس جورج ولستُ أنا ولكن

102
00:13:35,360 --> 00:13:38,240
!الشرطة تظُن أنّك الفاعل يا أبي، أليس كذلك؟

103
00:13:39,450 --> 00:13:42,620
.كلا، لا بأس. لا تقلقي بشأن ذلك يا جين

104
00:13:42,830 --> 00:13:43,920
.ثمّة حقيقةً واحدة فقط

105
00:13:51,880 --> 00:13:54,090
من فضلك؟ -
ماذا حدث؟ -

106
00:13:54,300 --> 00:13:55,130
!توقّفوا

107
00:13:59,760 --> 00:14:02,730
"السيد باكوستون ينفي الاتهامات"

108
00:14:13,240 --> 00:14:14,240
...نعتذر بشدّة

109
00:14:15,530 --> 00:14:16,780
.اذهبوا

110
00:14:16,990 --> 00:14:17,660
...سيّدي

111
00:14:19,950 --> 00:14:22,410
.اذهبوا قبل أن أُغيّر رأيي

112
00:14:22,620 --> 00:14:23,750
...أجل

113
00:14:30,670 --> 00:14:32,380
...نحن آسفون يا آنستي

114
00:14:33,720 --> 00:14:36,380
!بدءً من الغد لن تتمكّنين من ركوب عربة نقل أندي

115
00:14:38,050 --> 00:14:40,350
.شكرًا لك على كل ما فعلته
.اعتني بنفسك

116
00:14:49,810 --> 00:14:53,630
...لِمَ لا أحد منهم يفهم؟! في مثل هذا الوقت

117
00:14:53,960 --> 00:14:56,200
.ما باليد حيلة

118
00:14:56,400 --> 00:14:57,890
.إنّهُ أمرٌ مؤلم للجميع

119
00:14:58,780 --> 00:15:01,990
...ينبغي علينا حماية

120
00:15:02,580 --> 00:15:04,330
.السيّد والآنسة جين

121
00:15:06,500 --> 00:15:07,920
.أجل، مهما حدث

122
00:15:08,790 --> 00:15:09,710
.أجل

123
00:15:19,800 --> 00:15:21,010
!أبي

124
00:15:23,020 --> 00:15:23,770
!أبي

125
00:15:25,440 --> 00:15:27,440
!أبي، أبي

126
00:15:33,150 --> 00:15:34,530
...في الوقت الحالي

127
00:15:35,480 --> 00:15:37,070
.ينبغي عليه أن يحظى ببعض الراحة...

128
00:15:37,280 --> 00:15:38,280
.فهمت

129
00:15:38,280 --> 00:15:39,900
!شُكرًا جزيلًا لك

130
00:15:40,110 --> 00:15:45,340
.لا تقلقي، إنني مُتأكّدٌ من أنّهُ سيتعافى بإعتنائكِ به

131
00:15:45,540 --> 00:15:47,710
.أجل... شُكرًا جزيلًا لك

132
00:15:48,120 --> 00:15:50,210
!إنه رجلٌ شريف

133
00:15:50,420 --> 00:15:53,340
!لقد أرهق نفسه كثيرًا

134
00:16:56,150 --> 00:16:57,820
!رسالة للآنسة جين باكوستون

135
00:16:58,030 --> 00:16:58,730
رسالةٌ لي؟

136
00:17:01,780 --> 00:17:02,910
!شكرًا لك

137
00:17:09,250 --> 00:17:10,510
.مرحبًا بعودتك

138
00:17:11,580 --> 00:17:12,790
.قد عُدت

139
00:17:22,720 --> 00:17:25,010
.آنستي، ستُصابين بالبرد

140
00:17:25,590 --> 00:17:28,390
.لا بأس، أودُ البقاء مع أبي لفترة أطول قليلًا

141
00:18:10,780 --> 00:18:11,770
ما الخطب؟

142
00:18:11,970 --> 00:18:17,860
...توقيعك
!لقد قُمت برسم شيء كبير، إنه مُضحك "N" عند الحرف الأخير

143
00:18:19,900 --> 00:18:20,820
!...أخي

144
00:18:40,790 --> 00:18:41,630
حجر؟

145
00:19:54,200 --> 00:19:58,500
أعدكِ يا جين
.عندما أعود، سوف نطير معًا في السماء بهذه

146
00:20:10,090 --> 00:20:11,800
!أخي، كُن حيًا

147
00:20:12,930 --> 00:20:14,010
...كُن حيًّا

148
00:20:29,150 --> 00:20:31,280
!ما الذّي تتحدّثين عنه؟

149
00:20:31,780 --> 00:20:34,120
!ستذهبين إلى الشرق بنفسكِ؟

150
00:20:34,330 --> 00:20:35,830
ولِمَ تفعلين ذلك؟

151
00:20:36,410 --> 00:20:38,000
!سأذهب للبحث عن أخي

152
00:20:38,200 --> 00:20:41,290
!أتعين ما تقولينه؟

153
00:20:41,870 --> 00:20:43,830
!أخي ما يزال حيًّا! إنّهُ حيّ

154
00:20:44,630 --> 00:20:47,210
سيّدتي، أفقدتِ عقلكِ؟

155
00:20:47,420 --> 00:20:49,970
...السيّد جورج قد مات منذُ عدّة سنوات

156
00:20:50,050 --> 00:20:51,380
ماذا عن ساعة الجيب؟

157
00:20:51,970 --> 00:20:54,970
...ساعة الجيب التي أعطاها أبي لجورج

158
00:20:55,180 --> 00:20:56,600
كيف انتهى بها الأمر في الخزنة؟...

159
00:20:57,100 --> 00:20:58,390
...إنّ هذا

160
00:20:58,600 --> 00:21:02,980
!لن أُصدّق الأمر حتّى أتبيّن منه بأمّ عينيّ

161
00:21:04,440 --> 00:21:06,930
!هذا خطير. خطيرٌ جدًا

162
00:21:07,440 --> 00:21:11,030
إذن أتعتقد يا شامبلان أنّ أخي حاول التمّرد؟

163
00:21:12,450 --> 00:21:14,450
...لكن، في الرسالة من البرلمان

164
00:21:14,450 --> 00:21:15,030
.أُنظر لهذه

165
00:21:16,450 --> 00:21:17,030
ما هذه؟

166
00:21:18,580 --> 00:21:20,790
!ألا يبدو هذا الخط كخط أخي؟

167
00:21:23,540 --> 00:21:24,750
...يبدو كذلك

168
00:21:25,000 --> 00:21:27,250
!تشامبلان، أرجوك! دعني أذهب

169
00:21:28,000 --> 00:21:31,810
!سيتعافى أبي إن عاد أخي بالتأكيد

170
00:21:34,220 --> 00:21:38,080
...لكنني لا أستطيع ترككِ تذهبين لوحدكِ

171
00:21:38,130 --> 00:21:40,700
!تشامبلان، يجب أن أذهب

172
00:21:42,520 --> 00:21:46,610
!كلا، مهما قلتِ، لا يُمكنني السماح لكِ بالذهاب

173
00:21:46,810 --> 00:21:47,900
!تشامبلان

174
00:21:48,230 --> 00:21:49,860
!دعنا نثق بالآنسة

175
00:21:52,570 --> 00:21:53,900
...كايت! أنتِ

176
00:21:55,950 --> 00:21:57,660
!إنّكَ أحمق يا تشامبلان

177
00:21:57,870 --> 00:21:59,540
إنني موجودة هُنا، ألستَ كذلك؟

178
00:21:59,740 --> 00:22:02,290
!دع أمر السيّد لي

179
00:22:03,580 --> 00:22:05,580
...مهما حدث

180
00:22:05,680 --> 00:22:06,960
أليس كذلك؟

181
00:22:10,130 --> 00:22:11,880
...مهما حدث

182
00:22:14,590 --> 00:22:18,460
.عجبًا، عندما تُقررين شيئًا فلا رادع لكِ

183
00:22:19,280 --> 00:22:21,100
!سوف آتي أنا أيضًا

184
00:22:21,310 --> 00:22:25,410
!أينما ترتحلين، أنا شامبلان سأرتحل معك

185
00:22:28,560 --> 00:22:30,980
!شُكرًا لك يا شامبلان

186
00:22:32,940 --> 00:22:34,530
!شُكرًا لكِ يا كايت

187
00:22:50,630 --> 00:22:52,170
...أخي

188
00:23:02,310 --> 00:23:06,340
.تركتُ أبي في عناية كايت، وتوجّهنا للبحث عن أخي

189
00:23:06,390 --> 00:23:09,460
.أتساءل عمّا ينتظرنا في العالم المجهول

190
00:23:09,650 --> 00:23:12,010
الحلقة القادمة: رحلة البحر الأولى

191
00:23:12,020 --> 00:23:13,030
!نراكم قريبًا