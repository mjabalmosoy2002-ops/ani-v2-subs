1
00:01:50,040 --> 00:01:51,830
!إنّها جاهزة

2
00:02:08,120 --> 00:02:09,100
...جين

3
00:02:15,240 --> 00:02:17,430
.صباح الخير -
.صباح الخير -

4
00:02:17,880 --> 00:02:19,150
هل من خطب؟

5
00:02:19,360 --> 00:02:20,990
...آنستي

6
00:02:22,480 --> 00:02:24,630
.إن كنتَ تبحث عن جين فهي على الأغلب برفقة القائد

7
00:02:28,360 --> 00:02:31,150
!أيّها الناعِسون! تجهّزوا لشدّ الرحال

8
00:02:35,280 --> 00:02:37,150
...إنّكَ صاخبٌ للغاية في هذا الوقت الباكر من الصباح

9
00:02:37,480 --> 00:02:38,870
!ماذا؟

10
00:02:40,000 --> 00:02:40,550
!...انظر

11
00:02:45,480 --> 00:02:47,830
.سنصل لمدينة تارلميل عندما نتخطّى ذلك الجبل

12
00:02:48,840 --> 00:02:52,540
.جين، إنّكِ ترتحلين باحثةً عن أخيكِ

13
00:02:52,760 --> 00:02:55,750
.من الأفضل أن نفترق هنا

14
00:02:55,960 --> 00:02:57,230
لماذا؟

15
00:02:57,440 --> 00:03:00,390
أهذا بسبب أنّكَ تعلم أنّني أحد أفراد عائلة باكوستون؟

16
00:03:02,040 --> 00:03:03,670
.كلا، هذا ليس ما في الأمر

17
00:03:10,720 --> 00:03:14,500
.لقد أخبرتُكِ سلفًا بهدف رحلتنا

18
00:03:14,720 --> 00:03:18,790
.ينبغي عليّ أن أحصل على سائل العوم قبل أيّ أحد آخر

19
00:03:19,000 --> 00:03:20,670
تفهمين ذلك، صحيح؟

20
00:03:21,600 --> 00:03:23,870
.لكن، يبدو أنّنا قد تأخّرنا كثيرًا

21
00:03:24,080 --> 00:03:28,430
لهذا السبب‏،‏ ينبغي علينا الآن أكثر من أيّ وقت مضى أن نجد أولئك الأشخاص الّذين يتحكّمون بتلك الآلة الطّائرة‏.‏‏.‏‏.‏

22
00:03:28,800 --> 00:03:30,150
!ونقاتلهم...

23
00:03:31,200 --> 00:03:34,430
.لا بدَّ وأنّكِ تعين الآن مدى خطورة ذلك

24
00:03:34,640 --> 00:03:35,620
...لكن

25
00:03:35,840 --> 00:03:37,790
.إنّني قلقٌ عليكِ

26
00:03:38,000 --> 00:03:43,150
.سيزداد الأمر خطورةً عليكِ إن استمررتِ بالترحال معنا من هذه النقطة

27
00:03:47,560 --> 00:03:49,070
ما رأيكَ في ذلك... لأجل جين؟

28
00:03:55,280 --> 00:03:57,950
،كي أكون صريحًا معكِ، إنّ جورج باكوستون

29
00:03:58,400 --> 00:03:59,790
...أعني، إنَّ أخيكِ

30
00:04:00,160 --> 00:04:02,350
.له علاقة ما بتلك الآلة الطّائرة...

31
00:04:02,800 --> 00:04:04,790
.هذا هو رأيي في هذا الأمر

32
00:04:05,200 --> 00:04:07,150
.واثقٌ أنّكِ توافقينني الرّأي

33
00:04:07,360 --> 00:04:09,430
.إنّ أخي جورج على قيّد الحياة بلا شكّ

34
00:04:09,640 --> 00:04:11,830
.ولكنُّ قد يكون ميّتًا سلفًا

35
00:04:12,040 --> 00:04:14,110
.إنّ ذلك أمرٌ لسنا متيقّنين منه

36
00:04:14,320 --> 00:04:17,390
.لهذا السبب علينا أنّ نتحرّى الحقيقة

37
00:04:18,440 --> 00:04:19,950
!لا تسقط

38
00:04:24,320 --> 00:04:25,070
!حسنٌ

39
00:04:25,600 --> 00:04:33,190
.اذهبي لتارلميل
.وتحققي بنفسكِ ما إن كان جورج باكوستون مدفون حقًا أم لا

40
00:04:34,800 --> 00:04:36,620
.يومًا ما، سنطير في السماء معًا

41
00:04:50,240 --> 00:04:52,190
.عبور ذلك الجبل سيكون صعبًا

42
00:04:52,400 --> 00:04:55,070
.ولكنني واثقٌ من أنّكِ تستطيع تخطّيه يا جين

43
00:04:56,080 --> 00:04:58,150
.سنعبر ذلك الجبل بمفردنا

44
00:04:58,760 --> 00:05:01,350
!إن فعلنا ذلك، سنكتشف الحقيقة

45
00:05:02,640 --> 00:05:03,910
...سيّد بارزاك

46
00:05:05,560 --> 00:05:06,470
.لقد فهمت

47
00:05:06,680 --> 00:05:08,740
.سأذهب لتارلميل

48
00:05:10,080 --> 00:05:10,830
...فهمت

49
00:05:12,200 --> 00:05:14,310
.أحسنتُم عملًا -
...أجل -

50
00:05:16,760 --> 00:05:17,600
!عجبًا

51
00:05:20,680 --> 00:05:21,310
ما هذا؟

52
00:05:21,920 --> 00:05:23,710
.فكّرتُ أنّهُ سيكون مفيدًا لجين

53
00:05:23,800 --> 00:05:25,230
آه، حقًا؟

54
00:05:28,040 --> 00:05:28,990
...قائد

55
00:05:29,840 --> 00:05:31,190
جين، ما هذه؟

56
00:05:32,160 --> 00:05:33,830
...هذه

57
00:05:35,960 --> 00:05:38,340
.لقد صنعتُ هذه بنفسي

58
00:05:44,760 --> 00:05:46,170
صنّارة؟

59
00:05:48,640 --> 00:05:50,030
!آنستي

60
00:05:51,760 --> 00:05:53,410
أليس هذا رائعًا، أيّها المُسنّ؟

61
00:05:55,360 --> 00:05:58,040
.سأعتزّ بهذه السّنارة لبقيّة حياتي

62
00:05:59,800 --> 00:06:01,110
...تشامبلان، صبري

63
00:06:02,080 --> 00:06:05,190
.سنفترق هنا عن السيّد بارزاك والآخرين

64
00:06:12,360 --> 00:06:14,030
.سيكون هذا هديّة وداعٍ جيّدة

65
00:06:14,240 --> 00:06:16,620
.أمسكنا به نحن الثلاثة

66
00:06:38,520 --> 00:06:39,710
.اعتنوا بأنفسكم

67
00:06:39,920 --> 00:06:41,620
.أعتنوا أنتم بأنفسكم أيضًا

68
00:06:41,960 --> 00:06:43,510
...حسنٌ، أنتِ مُحقّة

69
00:06:47,040 --> 00:06:51,150
.جين، انتظرينا في تارلميل

70
00:06:51,360 --> 00:06:53,230
.سأحرص على لقائكِ هناك -
.أجل -

71
00:06:53,720 --> 00:06:55,030
...سيّد تشامبلان -
أجل -

72
00:06:55,240 --> 00:06:56,750
.توخّ الحذر

73
00:06:57,400 --> 00:07:00,690
...صبري -
.اعتمد عليّ، سأكون معهم -

74
00:07:01,000 --> 00:07:03,060
.لهذا السبب أنا قلق

75
00:07:03,160 --> 00:07:04,550
ماذا قُلت...؟

76
00:07:07,240 --> 00:07:08,570
.توخَّ الحذر

77
00:07:09,760 --> 00:07:10,700
.أنتَ كذلك

78
00:07:11,120 --> 00:07:13,270
.هيّا، اذهبوا -
.أجل -

79
00:07:23,160 --> 00:07:24,920
.لنشدَّ رحالنا

80
00:07:31,680 --> 00:07:33,750
...لقد افترقوا لفرقتين

81
00:07:38,800 --> 00:07:42,430
!الوداع

82
00:07:46,400 --> 00:07:48,700
.حسنٌ، لننطلق نحن أيضًا

83
00:07:54,120 --> 00:07:56,150
،لا بدَّ وأنّهم يخططون للذهاب لتارلميل

84
00:07:56,360 --> 00:07:57,910
.كما قال السيّد هاري بالضّبط

85
00:08:01,760 --> 00:08:04,030
!مهما فعلت، لا تسمح لتلك الفتاة بالاقتراب من القبر

86
00:08:07,640 --> 00:08:08,860
...سحقًا

87
00:08:09,670 --> 00:08:11,870
...لا أملك أيّ أدنى فكرة عمّا يجري

88
00:08:13,040 --> 00:08:14,910
.ولكن سيكون هذا مُزعجًا...

89
00:08:21,120 --> 00:08:24,230
أأنتَ واثقٌ من الاتّجاه الذي سلكته تلك الآلة الطائرة؟

90
00:08:24,640 --> 00:08:26,150
.أجل، لا داعي للقلق

91
00:08:27,200 --> 00:08:29,270
.آمل أن يكون هنالك قبرًا

92
00:08:29,800 --> 00:08:31,870
عفوًا؟ -
.كنتُ أشير لجين بحديثي -

93
00:08:32,560 --> 00:08:36,510
.سيكون من الأفضل إن كان قبر جورج باكوستون في تارلميل

94
00:08:37,040 --> 00:08:39,070
.أنا كذلك يا سيّدي

95
00:08:45,040 --> 00:08:47,950
.على كُل حال، سوف نتخطّى ذلك الجبل اليوم

96
00:08:48,160 --> 00:08:48,990
!أجل

97
00:08:51,880 --> 00:08:54,470
...أيّها المُسنّ، إنّ جين مُطيعة على غير العادة

98
00:08:55,160 --> 00:08:56,950
آنستي، هل أنتِ بخير؟

99
00:08:57,160 --> 00:08:58,070
!أجل

100
00:08:58,280 --> 00:09:00,710
!حسنٌ! في هذه الحالة لنبذل قصارى جهدنا

101
00:09:15,680 --> 00:09:18,190
!هل الجميع بخير؟ -
...سنحتاج لأخذ قسط من الراحة عمّا قريب -

102
00:09:18,800 --> 00:09:21,180
.أنا على ما يُرام -
...لكن -

103
00:09:21,640 --> 00:09:24,430
علينا أن نعبر الجبل اليوم، صحيح؟

104
00:09:24,640 --> 00:09:26,310
.لنستمر أكثر قليلًا

105
00:09:26,520 --> 00:09:27,950
.فهمت

106
00:09:35,440 --> 00:09:37,150
،حالما نعبر هذا المكان

107
00:09:37,360 --> 00:09:39,070
!سنصل لتارلميل...

108
00:09:45,960 --> 00:09:49,390
.هذا سيّئ! إنّ درجة الحرارة تنخفض

109
00:09:52,560 --> 00:09:55,070
!سأرى أخي مُجددًا بعدما نعبر هذا الجبل

110
00:09:56,720 --> 00:10:00,070
ينبغي أن يعبروا مُحيط الجبل عمّا قريب -
.هذا صحيح -

111
00:10:15,520 --> 00:10:17,780
.حسنٌ، حالما ننزل للأسفل سنصل لتارلميل

112
00:10:21,760 --> 00:10:22,510
...آنستي

113
00:10:23,560 --> 00:10:25,350
.هيّا، لنُسرع

114
00:10:47,080 --> 00:10:49,030
.إنّ جين تتصرّف بغرابة

115
00:10:49,240 --> 00:10:51,590
.من الأفضل أن نُعجّل في إيجاد مكانٍ نستريح فيه

116
00:10:52,120 --> 00:10:54,630
آنستي، أينبغي أن نأخذ قسطًا من الراحة؟

117
00:10:54,760 --> 00:10:56,110
.لستُ تعبة على الإطلاق

118
00:10:59,880 --> 00:11:01,100
!آ-آنستي

119
00:11:02,720 --> 00:11:05,830
.عليّ أن أستمر، لقد أوشكتُ على رؤية أخي

120
00:11:06,640 --> 00:11:09,100
...آنستي -
...أتفهم شعوركِ ولكن -

121
00:11:09,320 --> 00:11:11,990
.لن يحدث ذلك إن انهرتِ الآن

122
00:11:14,960 --> 00:11:16,180
!انتظري

123
00:11:17,560 --> 00:11:18,350
!جين

124
00:11:18,560 --> 00:11:19,910
!آنستي

125
00:11:27,000 --> 00:11:29,830
.لا ألومها. إنّنا قريبون جدًا من الهدف

126
00:11:31,520 --> 00:11:34,190
.على كُل حال، منذُ الآن فصاعدًا، ينبغي أن نكون مُستعدّين للأسوأ

127
00:11:34,400 --> 00:11:40,630
أجل، علينا ألا ندع المساعدة الّتي قدّموها
.السيّد برزاك والسيّد مارسيناي والآخرين تذهب أرجاء الريّاح

128
00:11:44,200 --> 00:11:46,470
،إنّني أغبط أخ جين

129
00:11:47,480 --> 00:11:51,870
.لديه عائلة... مستعدة لقطع المسافات للبحث عنه

130
00:11:53,000 --> 00:11:54,390
...صبري

131
00:12:01,520 --> 00:12:02,790
...تارلميل

132
00:12:03,520 --> 00:12:05,150
.انتهى بي الأمر هُنا مُجددًا

133
00:12:05,360 --> 00:12:07,430
يا جماعة، تعلمون ما عليكم فعله، صحيح؟

134
00:12:07,640 --> 00:12:09,070
.مهمّتكم هي إخراجهم من المدينة

135
00:12:10,160 --> 00:12:11,220
!أجل

136
00:12:29,680 --> 00:12:31,630
.هيّا، لنُسرع -
.أجل -

137
00:12:50,120 --> 00:12:51,590
أين المقبرة؟

138
00:12:52,140 --> 00:12:53,430
.إن لم تخنّي الذاكرة، إنّها من هذا الطريق

139
00:13:03,240 --> 00:13:05,270
ما الّذي تُريدونه؟ -
.استمعا جيّدًا -

140
00:13:07,720 --> 00:13:09,310
.سنأخذ العجوز

141
00:13:09,520 --> 00:13:12,370
.غادرا المدينة مع القافلة الأولى المغادرة غدًا صباحًا

142
00:13:12,960 --> 00:13:14,550
ماذا قُلت؟ -
!صبري -

143
00:13:15,240 --> 00:13:17,190
...إلّم تفعلا كما نأمركما

144
00:13:17,800 --> 00:13:18,550
!سنقتل العجوز

145
00:13:20,600 --> 00:13:21,150
!تشامبلان

146
00:13:23,000 --> 00:13:24,140
أفهمتما؟

147
00:13:27,000 --> 00:13:27,770
!انتظر

148
00:13:28,960 --> 00:13:32,390
.سنُعيد العجوز حالما تُغادروا هذه المدينة

149
00:13:41,880 --> 00:13:43,270
ماذا ينبغي علينا أن نفعله؟

150
00:13:43,480 --> 00:13:46,550
.لا يُمكننا الاستسلام الآن -
...لكن حياة تشامبلان على المحك -

151
00:13:47,280 --> 00:13:49,150
من يكون هؤلاء الأشخاص أصلًا؟

152
00:13:49,360 --> 00:13:50,310
.لا أعلم

153
00:13:50,880 --> 00:13:54,030
.هذا غريبٌ جدًا
ما سبب استهدافهم لنا؟

154
00:13:54,880 --> 00:13:56,350
.لا أعلم

155
00:13:57,040 --> 00:13:59,110
.ولكنّ لا بدَّ وأنّني السبب في ذلك

156
00:14:11,560 --> 00:14:12,950
...آنستي

157
00:14:27,090 --> 00:14:29,840
.جين، إنّهم على وشك المغادرة. علينا أن نُسرع

158
00:14:33,290 --> 00:14:35,280
.جين، ما باليد حيلة

159
00:14:36,370 --> 00:14:37,960
...جين

160
00:14:39,250 --> 00:14:40,600
.أنا بحاجة للتبوّل

161
00:14:56,850 --> 00:14:58,380
.حسنٌ، أعتمدُ عليك -
.أجل -

162
00:15:00,970 --> 00:15:03,120
.اترك الحِمار يذهب في حال سبيله حيثما أردت

163
00:15:03,120 --> 00:15:05,120
!حسنٌ

164
00:15:18,490 --> 00:15:20,790
.إنّهم يُطيعون أوامرنا كما توقّعنا

165
00:15:21,010 --> 00:15:23,040
.سيظلّ الأطفال أطفالًا في النهاية

166
00:15:23,250 --> 00:15:25,960
.أخفهم فقط وسيسهل ذلك الأمر

167
00:15:30,810 --> 00:15:32,120
.أعتقد أنّنا نجحنا في تضليلهم

168
00:16:31,570 --> 00:16:32,710
!لا فائدة

169
00:16:33,250 --> 00:16:34,160
.لم أتوصل لشيء

170
00:16:34,370 --> 00:16:35,480
ما الّذي تقوله؟

171
00:16:35,690 --> 00:16:38,070
.إن اكتشفوا خطّتنا، فسيُقتل تشامبلان

172
00:16:39,010 --> 00:16:41,280
أنتِ مُحقّة ولكن أين ينبغي علينا أن نبحث؟

173
00:16:49,170 --> 00:16:50,680
!هذه! من أين حصلت عليها؟

174
00:16:50,970 --> 00:16:52,800
.التقطتُها من هناك

175
00:17:03,410 --> 00:17:06,500
.أيّها المُسن، أولئك الطفلان ارتعدا خوفًا وهربا

176
00:17:09,090 --> 00:17:10,920
.يبدو أنّك نجوت بجلدك

177
00:17:43,330 --> 00:17:44,080
!آنستي

178
00:17:44,650 --> 00:17:45,870
!تشامبلان

179
00:17:53,210 --> 00:17:54,320
!...أيّها الوغد

180
00:18:01,450 --> 00:18:02,920
.تشامبلان، خُذ

181
00:18:04,850 --> 00:18:05,880
...آنستي

182
00:18:07,690 --> 00:18:08,790
.ليس لدينا وقتٌ نُضيّعه

183
00:18:13,330 --> 00:18:14,520
!من هذا المُنعطف

184
00:18:50,210 --> 00:18:51,680
!هيّا لنُسرع

185
00:18:59,250 --> 00:19:01,400
...هيّا -
!آنستي -

186
00:19:23,770 --> 00:19:24,400
...ماذا لو

187
00:19:29,810 --> 00:19:32,480
.إنّهُ ليسَ هُنا. من المُحتمل ألّا يكون هُنا

188
00:19:38,650 --> 00:19:39,790
...وجدتُه

189
00:19:48,370 --> 00:19:50,520
.لقد استعادوا العجوز

190
00:19:50,850 --> 00:19:51,580
ماذا تقول؟

191
00:19:51,930 --> 00:19:53,150
وأين ذهبوا؟

192
00:19:53,370 --> 00:19:55,240
.لقد هربوا -
هل تفقّدت القبر؟ -

193
00:19:55,450 --> 00:19:56,160
القبر؟

194
00:19:58,010 --> 00:19:59,120
...نسيتُ إخباره

195
00:20:00,090 --> 00:20:02,840
!مهما حدث لا تسمح لتلك الفتاة أن تقترب من القبر

196
00:20:04,490 --> 00:20:06,080
!لننطلق -
إلى أين؟ -

197
00:20:06,730 --> 00:20:08,120
!المقبرة. تحرّك

198
00:21:20,810 --> 00:21:22,000
!آ-آ-آنستي

199
00:21:31,730 --> 00:21:32,790
.سأقوم بفتحه

200
00:21:37,770 --> 00:21:39,600
!ما هذا؟ جين

201
00:21:39,810 --> 00:21:41,960
!كلا! لا أستطيع النّظر

202
00:21:42,170 --> 00:21:43,680
.لا بأس، افتحي عينيكِ

203
00:21:46,330 --> 00:21:46,880
!آنستي

204
00:21:57,050 --> 00:21:58,190
ما هذا...؟

205
00:22:12,050 --> 00:22:13,600
".هنا يرقد جورج باكوستون"

206
00:22:15,330 --> 00:22:16,600
...أخي جورج

207
00:22:25,090 --> 00:22:27,880
.أخي جورج، إنّهُ على قيد الحياة كما توقّعت

208
00:22:28,890 --> 00:22:29,760
!إنّهُ حيّ

209
00:22:45,010 --> 00:22:46,400
!أمسكوا بأولئك الثلاثة

210
00:22:47,090 --> 00:22:48,380
!إنّها آلةٌ طائرة

211
00:22:48,850 --> 00:22:50,120
!آنستي

212
00:22:51,450 --> 00:22:52,000
!لنهرب

213
00:23:01,650 --> 00:23:05,130
.لقد قبضت علينا آلةٌ طائرة غامضة

214
00:23:05,130 --> 00:23:08,400
...قد يكون أخي جورج في مكانٍ ما على هذه السّفينة

215
00:23:09,650 --> 00:23:11,330
الحلقة القادمة: أول رحلة طيران لي

216
00:23:11,330 --> 00:23:12,440
!نراكم لاحقًا