1
00:00:00,320 --> 00:00:02,590
مباركٌ لكِ يا كانان-ساما

2
00:00:00,550 --> 00:00:05,670
أكملتِ مسابقة جمع أختام الموافقة على الحبيب

3
00:00:01,070 --> 00:00:03,980
مباركٌ لكِ يا أختي الكبرى

4
00:00:04,420 --> 00:00:06,100
تليقان ببعضكما كثيرًا

5
00:00:05,670 --> 00:00:08,700
أصبحتِ أنتِ وكيوغي-كن حبيبين رسميًّا من الآن

6
00:00:08,700 --> 00:00:10,150
أتمنى لكما السعادة

7
00:00:10,000 --> 00:00:13,000
Arthur  :مراجعة

8
00:00:10,820 --> 00:00:12,490
مبارك لكِ يا سيدتي

9
00:00:15,940 --> 00:00:18,370
شكرًا على استضافتي يا سينباي

10
00:00:18,370 --> 00:00:19,500
...والآن

11
00:00:20,090 --> 00:00:23,460
أفتقر إلى الخبرة، لذا ارفقي بي رجاءً

12
00:00:29,470 --> 00:00:31,720
ففي النهاية، صرنا حبيبين رسميين الآن

13
00:00:32,100 --> 00:00:33,400
!رويدك، رويدك، رويدك

14
00:00:33,400 --> 00:00:34,970
!إنك تتعجل الأمور

15
00:00:35,330 --> 00:00:36,600
صرنا حبيبين رسميين الآن

16
00:00:38,350 --> 00:00:40,070
!مـ-ما العمل؟

17
00:00:40,070 --> 00:00:42,200
!هـ-هذا مفاجئ للغاية

18
00:00:43,270 --> 00:00:46,420
سأفعلها حقًّا إذن

19
00:00:46,420 --> 00:00:48,490
...لكن إن كنت سأفعلها مع كيوغي-كن

20
00:00:48,490 --> 00:00:50,110
!مهلًا، فيم أفكر؟

21
00:00:50,110 --> 00:00:50,980
!هذا حلم

22
00:00:50,980 --> 00:00:51,820
!حلم بلا شك

23
00:00:51,820 --> 00:00:53,470
!عليّ الاستيقاظ بسرعة

24
00:00:55,040 --> 00:00:58,650
يد كيوغي-كن صلبة ودافئة للغاية

25
00:00:58,650 --> 00:01:01,220
...إن كان حلمًا فلا ضير من مسايرته

26
00:01:02,300 --> 00:01:03,380
!لا، لا

27
00:01:03,380 --> 00:01:05,900
!علينا أن نتدرج في مثل هذه الأمور خطوةً خطوة

28
00:01:05,900 --> 00:01:07,760
!لا يمكنني الانجراف مع الأمر فحسب

29
00:01:07,760 --> 00:01:09,260
!استيقظي يا كانان

30
00:01:09,260 --> 00:01:10,760
!أفيقي يا كانان

31
00:01:10,760 --> 00:01:15,260
!أسرعي، أسرعي واستيقظي

32
00:01:23,100 --> 00:01:25,500
سينباي؟ هل أنتِ بخير؟

33
00:01:27,980 --> 00:01:28,990
لِم فعلتِ ذلك؟

34
00:01:28,990 --> 00:01:31,750
أتيتُ للاطمئنان عليكِ بعدما سمعتُكِ تصرخين

35
00:01:31,990 --> 00:01:35,180
ماذا عن مسابقة الأختام؟ أين وصلنا فيها؟

36
00:01:35,940 --> 00:01:38,300
لم يتبقّ سوى والدكِ

37
00:01:38,300 --> 00:01:41,160
سنغادر غدًا، لذا ينبغي أن نفعل شيئًا حيال هذا

38
00:01:41,830 --> 00:01:44,420
لن نفعلها حتى لو حصلنا على ختمه، اتفقنا؟

39
00:01:45,990 --> 00:01:46,920
نفعل ماذا؟

40
00:01:47,220 --> 00:01:49,960
علينا اتباع الخطوات بالترتيب أولًا

41
00:01:49,960 --> 00:01:51,460
عمَّ تتحدثين؟

42
00:01:55,990 --> 00:01:58,180
لم يبقَ سوى بابا إذن

43
00:01:58,180 --> 00:01:59,570
...ومع ذلك

44
00:01:59,890 --> 00:02:02,550
لنستمتع بوقتنا أيها الخنزير-سان

45
00:02:02,550 --> 00:02:05,400
لِمَ تلتصق به هكذا؟

46
00:02:05,840 --> 00:02:09,280
تتصرف ميل بغرابة منذ أن حصلنا على ختمها أيضًا

47
00:02:09,700 --> 00:02:10,480
!عجبًا

48
00:02:10,480 --> 00:02:14,280
لِمَ يخفق قلبي كلما نظرتُ إلى هذا الكائن الوضيع؟

49
00:02:14,650 --> 00:02:16,070
...أيُعقل أن

50
00:02:16,070 --> 00:02:19,790
!فكرة سرقة حبيب أختها الكبرى تُثيرني أيضًا؟

51
00:02:21,030 --> 00:02:23,790
هذا يدغدغ يا ميلتش-سان

52
00:02:23,790 --> 00:02:25,600
!لم أعد أحتمل

53
00:02:25,600 --> 00:02:30,300
!الخيانة، الخيانة، ما أروعها

54
00:02:31,390 --> 00:02:33,550
وجنتاك حساستان إذن

55
00:02:33,550 --> 00:02:36,900
ماذا عن هذا إذن؟

56
00:02:39,310 --> 00:02:40,870
!ميلتش

57
00:02:40,870 --> 00:02:44,250
ألا تظنين أنكِ تتقربين من كيوغي-كن أكثر من اللازم؟

58
00:02:45,650 --> 00:02:47,540
هذا طبيعي

59
00:02:47,870 --> 00:02:49,690
أليس كذلك يا أخي الأكبر؟

60
00:02:50,060 --> 00:02:52,070
أخي الأكبر؟

61
00:02:52,350 --> 00:02:55,690
إنها مسألة وقت فقط قبل أن يصبح زوجكِ، أليس كذلك؟

62
00:02:55,690 --> 00:02:58,070
لذا سيصبح أخي أيضًا

63
00:02:58,400 --> 00:02:59,580
!زوجها؟

64
00:02:58,400 --> 00:02:59,580
!زوجي؟

65
00:02:59,970 --> 00:03:02,920
!أتزوج كيوغي-كن؟

66
00:03:02,920 --> 00:03:05,180
!لا تذهبي يا أختي الكبرى

67
00:03:05,180 --> 00:03:06,640
بل اذهبي

68
00:03:06,900 --> 00:03:09,880
!يستحيل أن أتزوج بشريًّا

69
00:03:09,880 --> 00:03:12,950
إن لم تتزوجيه فربما أتزوجه أنا

70
00:03:14,660 --> 00:03:16,980
أصبحتُ محبوبًا، أليس كذلك؟

71
00:03:16,980 --> 00:03:19,860
!أزِل تلك الابتسامة عن وجهك أيها الكائن الوضيع

72
00:03:20,100 --> 00:03:21,870
أنا جادة

73
00:03:21,870 --> 00:03:24,640
ففي النهاية، أحبّ أخي الأكبر حبًّا جمًّا

74
00:03:26,870 --> 00:03:29,310
...ميلتش

75
00:03:29,310 --> 00:03:31,550
!عودي إلى هنا

76
00:03:31,550 --> 00:03:33,960
!أنتِ مخيفة للغاية يا أختي الكبرى

77
00:03:33,960 --> 00:03:36,310
إنهما مقربتان من بعضهما كثيرًا

78
00:03:33,960 --> 00:03:37,240
...أختي الكبرى... تتزوج

79
00:03:36,310 --> 00:03:38,480
صباح الخير يا يوجي-تشان

80
00:03:38,480 --> 00:03:39,570
!أماه؟

81
00:03:39,570 --> 00:03:43,690
ما هذه الجلبة في الصباح الباكر؟

82
00:03:43,690 --> 00:03:45,100
!أبتاه

83
00:03:45,100 --> 00:03:46,380
أعطنا ختمك رجاءً

84
00:03:45,890 --> 00:03:48,550
سأجعلكِ تندمين على هذا يومًا ما

85
00:03:46,380 --> 00:03:47,650
أرجوك

86
00:03:47,650 --> 00:03:49,580
بالتأكيد، سأختمها

87
00:03:51,000 --> 00:03:52,360
!صدقًا؟

88
00:03:52,360 --> 00:03:54,640
...هذا ما أود قوله، ولكن

89
00:03:55,780 --> 00:04:00,470
سيتعيّن عليك اجتياز اختباري

90
00:04:02,510 --> 00:04:03,720
...اختبارك

91
00:04:07,570 --> 00:04:08,650
...سينباي

92
00:04:08,650 --> 00:04:10,720
لنبذل قصارى جهدنا في كرة الطائرة الشاطئية

93
00:04:12,040 --> 00:04:15,920
عجبًا! سينباي، تبدين مختلفةً اليوم

94
00:04:15,920 --> 00:04:19,700
تتوهم ذلك

95
00:04:17,360 --> 00:04:18,440
—لكن

96
00:04:20,110 --> 00:04:23,120
لِمَ لا تغتنم هذه الفرصة لتشكيل فريق مع ميلتش؟

97
00:04:23,120 --> 00:04:26,420
ففي النهاية، تبدوان قريبين جدًّا من بعضكما

98
00:04:26,420 --> 00:04:27,670
أليس كذلك يا آمي-سان؟

99
00:04:27,670 --> 00:04:29,370
!أتُقحمينني في هذا؟

100
00:04:30,780 --> 00:04:32,880
أيبدو لكِ الأمر كذلك أيضًا يا سينباي؟

101
00:04:35,090 --> 00:04:37,930
!أنّى لك أن تبتسم هكذا بكلّ عفوية؟

102
00:04:37,930 --> 00:04:40,260
!ألا تُدرك ما فعلته؟

103
00:04:40,260 --> 00:04:42,180
!قبّلتْكَ على وجنتك

104
00:04:42,180 --> 00:04:44,760
،أسعدني الشعور بأن لديّ أختًا صغرى

105
00:04:44,760 --> 00:04:47,060
ومن الجميل أننا أصبحنا منسجمين الآن، أليس كذلك؟

106
00:04:47,060 --> 00:04:49,900
!شتّان ما بين الانسجام وذلك

107
00:04:49,900 --> 00:04:52,100
كيف تسمح لها بأن تسرق قبلةً من وجنتك هكذا؟

108
00:04:52,100 --> 00:04:55,320
إنها أقرب إلى فمك من قبلتي أنا

109
00:04:55,700 --> 00:04:56,860
يا آمي-سان

110
00:04:56,860 --> 00:04:58,490
لِمَ تقحمينني في هذا أصلًا؟

111
00:04:58,490 --> 00:05:02,700
ما رأيكِ في الرجال الذين يستمتعون بتلقّي القُبل من فتياتٍ أخريات؟

112
00:05:02,980 --> 00:05:05,150
...حـ-حسنٌ

113
00:05:05,150 --> 00:05:09,830
لو استطاع شخصٌ بعينه فعل الشيء
ذاته، لما خضنا هذا النقاش أصلًا

114
00:05:10,710 --> 00:05:12,920
!يُفترض أن تكوني في صفي

115
00:05:12,920 --> 00:05:16,840
...ليس وكأنني

116
00:05:21,150 --> 00:05:24,030
حان وقت حلواكِ المفضلة يا سيدتي

117
00:05:24,850 --> 00:05:26,120
اللعنة

118
00:05:26,120 --> 00:05:28,290
!انزلقت يدي

119
00:05:28,290 --> 00:05:29,600
!عيناي

120
00:05:32,030 --> 00:05:34,120
...أُزيل الكعكة

121
00:05:34,120 --> 00:05:35,700
...وأستغل هذه الفرصة

122
00:05:36,140 --> 00:05:38,110
لتقبيله؟

123
00:05:39,360 --> 00:05:41,820
!عيناي، عيناي

124
00:05:39,900 --> 00:05:42,920
...لا يستطيع كيوغي-كن الرؤية الآن، لذا

125
00:05:43,240 --> 00:05:45,240
حتى أنا يمكنني فعلها

126
00:05:43,240 --> 00:05:45,240
إ-إنها حلوة

127
00:05:45,620 --> 00:05:47,160
هل أنت بخير يا كيوغي-كن؟

128
00:05:47,160 --> 00:05:48,810
سأزيلها حالًا

129
00:05:47,160 --> 00:05:48,810
!سـ-سينباي

130
00:05:48,810 --> 00:05:50,500
!لا أرى شيئًا

131
00:05:50,780 --> 00:05:54,150
!يا للعجب، يوجد طبقٌ طائر في السماء

132
00:05:52,110 --> 00:05:54,150
!طبقٌ طائر؟

133
00:05:54,150 --> 00:05:56,250
استجمعي شجاعتكِ يا أنا

134
00:05:56,540 --> 00:05:58,040
سينباي؟

135
00:06:05,170 --> 00:06:07,270
!فعلتها، فعلتها

136
00:06:07,270 --> 00:06:11,050
اقتربتُ من فمه أكثر من ميلتش
بسنتيمترين، أليس هذا مذهلًا؟

137
00:06:11,050 --> 00:06:12,520
قبّليه على شفتيه فحسب

138
00:06:16,280 --> 00:06:20,880
أُعلن انطلاق مباراة كرة الطائرة الشاطئية لعائلة زيبول

139
00:06:20,880 --> 00:06:23,030
أول من يسجل خمس نقاط يفوز

140
00:06:23,440 --> 00:06:25,530
...سيواجه فريق الآنسة كانان

141
00:06:25,530 --> 00:06:27,280
...فريق السيدة ليليم

142
00:06:27,280 --> 00:06:29,040
فيما ستكون ميلتش-ساما لاعبةً بديلة

143
00:06:29,040 --> 00:06:30,660
شدّي همتكِ يا ميل

144
00:06:30,960 --> 00:06:33,900
عجبًا، ألن يشارك أبتي؟

145
00:06:33,900 --> 00:06:38,150
قال إن المشاهدين لن يستمتعوا برؤية رجلٍ بملابس السباحة

146
00:06:38,150 --> 00:06:39,170
المشاهدين؟

147
00:06:39,170 --> 00:06:41,500
،إن فاز فريق الآنسة كانان

148
00:06:41,500 --> 00:06:43,870
،فسيحصلون على ختم السيد

149
00:06:43,870 --> 00:06:47,230
ومعه اعتراف رسمي بعلاقتهما

150
00:06:47,230 --> 00:06:49,300
...سيدتي في علاقة

151
00:06:49,300 --> 00:06:50,730
!يا له من أمرٍ مقيت

152
00:06:50,730 --> 00:06:52,060
رئيسة الخدم؟

153
00:06:53,230 --> 00:06:56,760
أيعني هذا أن فريق الأخت الكبرى وحده سينال جائزة؟

154
00:06:56,760 --> 00:06:59,690
نحن نريد جائزةً إن فزنا أيضًا

155
00:07:00,160 --> 00:07:02,940
حسنٌ... أظنكِ محقة

156
00:07:02,940 --> 00:07:04,700
ماذا تُريدين إذن؟

157
00:07:06,670 --> 00:07:09,660
موعدًا مع أخي الأكبر

158
00:07:10,620 --> 00:07:12,080
!موعد؟

159
00:07:12,080 --> 00:07:15,090
...موعد خيانةٍ مع أخي الأكبر

160
00:07:15,090 --> 00:07:19,030
أيّ تعبيرٍ سيعتلي وجه أختي الكبرى
حين ترى ما سأفعله يا تُرى؟

161
00:07:20,020 --> 00:07:22,590
موعد خيانةٍ مع بشري؟

162
00:07:23,230 --> 00:07:25,610
،سرقة أختي الكبرى مني تثيرني

163
00:07:25,610 --> 00:07:28,620
،لكن سرقة من سرقها تثيرني أكثر

164
00:07:28,620 --> 00:07:30,910
،لذا إن سرقته بدوري

165
00:07:30,910 --> 00:07:36,020
فستكون خيانة ثلاثية، أليس كذلك؟

166
00:07:36,760 --> 00:07:39,020
!أيجوز أن أُثار بشيءٍ كهذا؟

167
00:07:39,460 --> 00:07:41,650
!ما خطبكما؟

168
00:07:42,360 --> 00:07:46,150
!كانان-تشان، يوجي-تشان، سأسدد

169
00:07:49,550 --> 00:07:50,870
خذا

170
00:07:54,340 --> 00:07:55,490
النقطة الأولى

171
00:07:55,700 --> 00:07:58,020
!تمالك نفسك يا كيوغي-كن

172
00:07:58,460 --> 00:07:59,670
الكلام أسهل من الفعل

173
00:07:59,950 --> 00:08:02,350
إن خسرنا فلن نحصل على الختم

174
00:08:02,350 --> 00:08:03,800
لذا تماسك

175
00:08:03,800 --> 00:08:06,560
...أعلم ذلك، ولكن

176
00:08:06,560 --> 00:08:08,300
...ملابس سباحة والدتكِ

177
00:08:08,300 --> 00:08:11,480
المثيرة تجعل غضَّ البصر عنها أمرًا صعبًا

178
00:08:11,700 --> 00:08:13,060
!فيمَ كنت تنظر؟

179
00:08:13,450 --> 00:08:14,880
...يوجي-تشان

180
00:08:14,880 --> 00:08:17,610
،أتفهم شعورك

181
00:08:17,610 --> 00:08:21,230
لكنك حبيب كانان-تشان

182
00:08:21,230 --> 00:08:23,070
غُضَّ بصرك

183
00:08:23,470 --> 00:08:25,850
بصفتي أمها، يجب أن أكون صارمة

184
00:08:26,410 --> 00:08:27,620
مهلًا، لحظة

185
00:08:27,620 --> 00:08:29,250
...وفقًا لهذه القواعد، إن فزتُ

186
00:08:29,250 --> 00:08:31,710
فسأحصل على موعدٍ معه، أليس كذلك؟

187
00:08:33,280 --> 00:08:35,290
!لا يجب أن نفعل هذا يا يوجي-تشان

188
00:08:35,290 --> 00:08:37,290
!لديك كانان-تشان بالفعل

189
00:08:37,660 --> 00:08:39,000
اعتبريه تدريبًا

190
00:08:39,390 --> 00:08:41,840
إنه مجرد تدريب لما سأفعله مع سينباي

191
00:08:42,170 --> 00:08:45,090
...لـ-لا يمكنني

192
00:08:45,420 --> 00:08:47,600
فعل ذلك

193
00:08:49,450 --> 00:08:50,800
كم نقطة تُحتسب هذه؟

194
00:08:51,190 --> 00:08:53,260
خرجت عن الخط

195
00:08:53,260 --> 00:08:54,650
من هنا، من هنا

196
00:08:53,260 --> 00:08:56,270
أين أنتِ أيتها البطيخة؟

197
00:08:54,650 --> 00:08:56,270
بالتوفيق يا بعلزبول-ساما

198
00:08:57,180 --> 00:08:58,060
كيوغي-كن

199
00:09:01,310 --> 00:09:03,270
!إلى أين يُفترض بي أن أنظر يا سينباي؟

200
00:09:03,270 --> 00:09:04,520
!إلى الكرة

201
00:09:04,840 --> 00:09:09,320
يا إلهي، إن كانت ملابسُ السباحة ستُشتّت
!انتباهك، فلتكن ملابس سباحتي أنا

202
00:09:09,620 --> 00:09:12,600
!أنا الوحيدة التي يُسمح لك بالنظر إليها

203
00:09:15,580 --> 00:09:16,660
!لا

204
00:09:16,660 --> 00:09:18,870
!لا تنظر

205
00:09:18,870 --> 00:09:21,210
!أختي الكبرى تُرمق بنظرات شهوانية

206
00:09:21,460 --> 00:09:22,590
!يا إلهي

207
00:09:22,590 --> 00:09:25,460
عليكِ مراعاة عمركِ عند اختيار
ملابس السباحة يا أمي

208
00:09:26,620 --> 00:09:27,460
!محال

209
00:09:27,460 --> 00:09:28,530
...أمكِ

210
00:09:28,530 --> 00:09:29,970
...أمكِ ما تزال

211
00:09:29,970 --> 00:09:33,120
في ريعان شبابها

212
00:09:34,670 --> 00:09:35,970
استقبال رائع

213
00:09:38,180 --> 00:09:42,980
...تعاونت أختي الكبرى والكائن الوضيع على إرسال هذه الكرة

214
00:09:43,410 --> 00:09:45,730
إنها ثمرة جهودهما وحبّهما

215
00:09:47,790 --> 00:09:48,860
آسفة يا ميل

216
00:09:48,860 --> 00:09:49,740
!هل أنتِ بخير؟

217
00:09:50,280 --> 00:09:52,220
ماذا؟ تبتسم؟

218
00:09:52,220 --> 00:09:54,620
...ضُربتُ في وجهي على يدِ من خنتُها

219
00:09:54,620 --> 00:09:55,990
!أنا في غاية الإثارة

220
00:09:56,350 --> 00:09:59,370
يا إلهي، أنتِ ميؤوسٌ منكِ يا ميل

221
00:09:59,920 --> 00:10:02,870
لا بأس، سأتولى الأمر من هنا

222
00:10:03,200 --> 00:10:06,710
مفاجأة، ملابس سباحة أختي الكبرى المدرسية

223
00:10:07,010 --> 00:10:08,890
!لا يمكنك غضّ البصر، أليس كذلك؟

224
00:10:08,890 --> 00:10:11,090
...إنها ملابس سباحة أختي الكبرى

225
00:10:11,090 --> 00:10:14,470
التي لن تريها لك أبدًا مهما توسلت

226
00:10:14,470 --> 00:10:17,880
،انظر إليَّ بنفس الشهوة التي تنظر بها إليها

227
00:10:17,880 --> 00:10:20,570
ولتكن هذه بوابتك إلى رغبةٍ جديدة وخطيرة

228
00:10:21,460 --> 00:10:23,950
!يا لك من فاشل منحرف

229
00:10:25,940 --> 00:10:26,400
ماذا؟

230
00:10:26,860 --> 00:10:29,110
!ألا ينظر إليَّ؟

231
00:10:29,400 --> 00:10:32,400
!تراجع فورًا بعد الاستقبال

232
00:10:31,780 --> 00:10:33,170
شكرًا جزيلا لكِ

233
00:10:33,170 --> 00:10:35,110
!يتغازلان في منتصف المباراة؟

234
00:10:35,110 --> 00:10:36,930
لا أزال في ريعان شبابي

235
00:10:36,930 --> 00:10:39,240
!لا تزال أمي مكتئبة

236
00:10:47,410 --> 00:10:49,200
نقطة الحسم

237
00:10:51,050 --> 00:10:53,760
لنحسم المباراة يا كيوغي-كن

238
00:10:53,760 --> 00:10:54,380
حاضر

239
00:10:54,730 --> 00:10:56,900
ليس سيئًا يا أختي الكبرى

240
00:10:56,900 --> 00:10:58,900
يبدو أننا سنخسر

241
00:10:58,900 --> 00:11:00,100
في الأحلام

242
00:11:00,100 --> 00:11:02,640
!الخاسران الوحيدان اليوم هما أنتما

243
00:11:03,020 --> 00:11:04,610
ها أنا ذي

244
00:11:05,560 --> 00:11:07,590
أخي الأكبر، انظر، انظر

245
00:11:15,050 --> 00:11:19,570
!إلام تظن نفسك تنظر؟

246
00:11:19,570 --> 00:11:21,580
شكرًا جزيلا لكِ

247
00:11:24,340 --> 00:11:27,030
فاز فريق الأنسة كانان

248
00:11:28,380 --> 00:11:29,330
خسرنا

249
00:11:29,330 --> 00:11:30,740
امحُ ذلك من ذاكرتك

250
00:11:30,740 --> 00:11:33,430
انس كلّ ما رأيته للتو

251
00:11:30,740 --> 00:11:34,420
...رأى يوجي-تشان... ثدييّ العاريين

252
00:11:34,420 --> 00:11:39,340
...شهدتُ لتوي... ذروة الخيانة

253
00:11:43,140 --> 00:11:44,180
...هذا

254
00:11:47,040 --> 00:11:49,700
صيدٌ كبير

255
00:11:56,900 --> 00:11:57,960
!أهي تلد؟

256
00:12:00,320 --> 00:12:01,700
أعرف خصلة الشعر تلك

257
00:12:01,970 --> 00:12:03,120
!جان-سان

258
00:12:04,330 --> 00:12:07,120
...التهمني الحبار

259
00:12:07,660 --> 00:12:09,470
هل تأذيتِ؟

260
00:12:14,220 --> 00:12:16,740
!كيوغي-سان

261
00:12:16,740 --> 00:12:19,530
!كنت خائفة للغاية

262
00:12:19,010 --> 00:12:20,050
!تفوح منكِ رائحة الحبار

263
00:12:20,050 --> 00:12:22,610
!مهلًا، ماذا تظنين نفسكِ— رائحة الحبار

264
00:12:22,610 --> 00:12:24,560
!رائحته كريهة للغاية

265
00:12:24,890 --> 00:12:29,480
!تفوح منكِ رائحة كريهة أيتها الخنزيرة

266
00:12:25,290 --> 00:12:26,760
!رائحتكِ كريهة

267
00:12:26,520 --> 00:12:27,690
!و-وأنا أيضًا؟

268
00:12:27,690 --> 00:12:28,910
!تفوح مني رائحة الحبار الآن أيضًا

269
00:12:28,910 --> 00:12:29,870
!رائحتكِ كريهة

270
00:12:37,380 --> 00:12:38,570
مرحى

271
00:12:39,860 --> 00:12:41,570
حان وقت الاستحمام

272
00:12:41,860 --> 00:12:44,580
القفز هكذا أمرٌ خطير يا أختي الكبيرة

273
00:12:44,860 --> 00:12:48,710
!لا، ليس الصابون

274
00:12:46,390 --> 00:12:48,710
يجب أن أزيل عنكِ رائحة الحبار تلك

275
00:12:49,430 --> 00:12:51,580
كان لعب كرة الطائرة
الشاطئية ممتعًا، أليس كذلك؟

276
00:12:51,580 --> 00:12:53,710
أجل، لم يكن سيئًا

277
00:12:54,730 --> 00:12:57,340
والآن سيمنحنا أبي ختمه أيضًا

278
00:12:58,280 --> 00:13:02,090
إذن سأغدو أخيرًا حبيبك بحق

279
00:13:03,400 --> 00:13:06,650
جمعنا لبعض الأختام لا يغيّر شيئًا

280
00:13:07,730 --> 00:13:09,780
ماذا تقصدين بذلك؟

281
00:13:09,780 --> 00:13:13,740
...أقصد، كيف أقولها

282
00:13:14,610 --> 00:13:16,680
اكتشف ذلك بنفسك

283
00:13:18,910 --> 00:13:20,610
انتظرني حالما تفرغ من الاستحمام

284
00:13:21,590 --> 00:13:23,490
أريد أن أريك شيئًا

285
00:13:26,600 --> 00:13:27,620
حاضر

286
00:13:33,600 --> 00:13:34,750
!أبتي

287
00:13:34,750 --> 00:13:36,120
أيها البشري

288
00:13:36,120 --> 00:13:38,470
هلّا ساعدتني؟

289
00:13:38,470 --> 00:13:41,680
يوجد سحاب في الخلف، ولكنه عالقٌ بشيءٍ ما

290
00:13:41,680 --> 00:13:43,010
سحاب؟

291
00:13:44,640 --> 00:13:45,950
إنه سحاب

292
00:13:56,090 --> 00:13:57,100
!خلعتُه

293
00:13:57,100 --> 00:13:58,280
شكرًا على المساعدة

294
00:13:58,280 --> 00:14:00,180
!هناك فتى صغير في الداخل؟

295
00:14:00,180 --> 00:14:02,170
...لا، بل أقصد

296
00:14:02,170 --> 00:14:03,880
!رجلٌ عظيم

297
00:14:04,410 --> 00:14:05,660
إلام تحدق؟

298
00:14:07,640 --> 00:14:09,480
الماء رائع، أليس كذلك؟

299
00:14:09,480 --> 00:14:11,400
أنت مذهلٌ بحق

300
00:14:11,400 --> 00:14:13,420
ظننتُك لن تكفَّ عن سؤالي عن الزيّ

301
00:14:15,110 --> 00:14:16,640
حسنٌ، لا بأس

302
00:14:16,640 --> 00:14:20,920
عادةً، لا أسمح للبشر بأن يروني هكذا

303
00:14:21,210 --> 00:14:24,140
لكنك جمعتَ كل الأختام، أليس كذلك؟

304
00:14:24,140 --> 00:14:27,220
أجل، عملنا أنا وكانان-سينباي بجدٍّ لنجمعها

305
00:14:27,220 --> 00:14:28,930
يسعدني سماع ذلك

306
00:14:30,020 --> 00:14:32,930
يسعدني أنكما تستمتعان بالتظاهر بأنكما حبيبان

307
00:14:33,370 --> 00:14:34,690
التظاهر؟

308
00:14:34,970 --> 00:14:37,460
إنه مجرد عقدٍ بينكما، أليس كذلك؟

309
00:14:37,460 --> 00:14:39,690
لذا فهو حبرٌ على ورقٍ فحسب

310
00:14:40,800 --> 00:14:42,410
...مستحيل، سينباي

311
00:14:43,710 --> 00:14:47,700
لم تقل قط إنها تحبني حقًّا؟

312
00:14:47,700 --> 00:14:52,000
لا يُمكن أن ينشأ حبٌّ صادق بين بشرٍ وشيطانةٍ أبدًا

313
00:14:53,550 --> 00:14:56,080
على كلٍّ، سأخرج قبل أن أصاب بالدوار

314
00:14:57,220 --> 00:14:58,840
...هذا يعني

315
00:15:00,750 --> 00:15:02,750
أنني رجلها الأول

316
00:15:03,970 --> 00:15:06,010
هل قلت ذلك لتثير حنقي؟

317
00:15:07,100 --> 00:15:12,550
أنا رجلها الأول، فقد كنتُ معها منذ ولادتها

318
00:15:12,680 --> 00:15:13,850
لكن العائلة لا تُحتسب

319
00:15:13,850 --> 00:15:15,420
!لِمَ لا تُحتسب؟

320
00:15:15,420 --> 00:15:21,070
"حتى إنها قالت: "أحبك يا بابا، سأتزوجك حين أكبر

321
00:15:21,780 --> 00:15:23,540
!ماذا؟

322
00:15:23,540 --> 00:15:24,820
أنا الفائز

323
00:15:24,820 --> 00:15:26,170
حظًّا أوفر لك

324
00:15:26,510 --> 00:15:28,570
بابا؟ كيوغي-كن؟

325
00:15:28,570 --> 00:15:32,170
لا أصدق كم كانت سينباي ظريفة في طفولتها! أحبها

326
00:15:32,170 --> 00:15:34,450
!أنا أحبّها أكثر

327
00:15:34,450 --> 00:15:36,200
!ما مشكلتك؟

328
00:15:36,200 --> 00:15:39,250
أتظنُّ أن بوسعك أن تتفوّق عليّ في ذكر محاسن كانان؟

329
00:15:40,460 --> 00:15:41,960
!قبلت التحدي

330
00:15:42,290 --> 00:15:44,340
أحبّ سخصيتُها الناضجة

331
00:15:44,340 --> 00:15:46,590
أحبّ شخصيتُها المشاغبة

332
00:15:46,890 --> 00:15:48,220
!ما ألطفها حين تحمر خجلًا

333
00:15:48,220 --> 00:15:50,970
!ما ألطفها حين تتظاهر بالقوة لتخفي خجلها

334
00:15:50,970 --> 00:15:54,080
!ما أظرفها حين تهتم بعائلتها

335
00:15:53,050 --> 00:15:55,350
أحبّ حين تطلب مني أن أُدلّلها

336
00:15:55,620 --> 00:15:57,890
!أحبّ تعابير وجهها حين تتناول طعامًا لذيذًا

337
00:15:57,890 --> 00:16:00,110
!مهلًا، كان دوري

338
00:16:01,580 --> 00:16:05,240
!هل تناولت الطعام مع كانان-تشان؟
لطالما أخبرتني أنها تفضّل تناول الطعام وحدها

339
00:16:05,700 --> 00:16:09,740
!تبدو في غاية الظرافة وهي تملأ خديها بالكروكيت

340
00:16:10,890 --> 00:16:15,540
...كنتُ أود أن أكون من يعلمها كم يحلو الطعام حين نتناوله معًا

341
00:16:19,210 --> 00:16:23,130
عانقتُها مراتٍ لا تُحصى على مرّ السنين

342
00:16:23,130 --> 00:16:25,480
!وأنا أيضًا حملتها كذلك

343
00:16:25,670 --> 00:16:27,720
استحممتُ معها أيضًا

344
00:16:27,720 --> 00:16:30,240
ارتديتُ ملابس سباحتها أيضًا

345
00:16:30,590 --> 00:16:31,590
ملابس سباحتها؟

346
00:16:31,720 --> 00:16:33,470
ما الذي كنتما تفعلانه؟

347
00:16:33,470 --> 00:16:35,660
أحبّ سهولة إخافتها

348
00:16:35,660 --> 00:16:37,100
أحبّ مدى حساسية أذنيها

349
00:16:37,100 --> 00:16:38,420
شعرها حريري للغاية

350
00:16:38,420 --> 00:16:39,930
ثدياها مذهلان

351
00:16:41,160 --> 00:16:43,080
ليس سيئًا أيها البشري

352
00:16:43,080 --> 00:16:46,080
!لم أنتهِ بعد

353
00:16:46,630 --> 00:16:49,450
...أحبّها حين

354
00:16:49,450 --> 00:16:50,750
...توقفا

355
00:16:50,750 --> 00:16:51,990
...تغار

356
00:16:52,390 --> 00:16:55,400
!فورًا

357
00:17:00,130 --> 00:17:03,080
سمعنا كلّ ما قلتماه

358
00:17:03,080 --> 00:17:04,770
...لم أشعر بهذا الإحراج

359
00:17:04,770 --> 00:17:05,500
...في حياتي

360
00:17:07,630 --> 00:17:09,380
!استدعينَ طبيبًا

361
00:17:14,930 --> 00:17:16,080
كيوغي-كن

362
00:17:17,270 --> 00:17:18,710
هل تشعر بتحسّن الآن؟

363
00:17:19,110 --> 00:17:20,890
أجل، بأتمّ عافية

364
00:17:21,210 --> 00:17:23,270
لا تُجهد نفسك، اتفقنا؟

365
00:17:23,270 --> 00:17:25,150
حسنٌ، لنذهب

366
00:17:31,440 --> 00:17:33,910
ما الذي تريدين أن تُريني إياه؟

367
00:17:34,370 --> 00:17:35,880
أنت قليلُ الصبر

368
00:17:35,880 --> 00:17:37,410
سترى قريبًا

369
00:17:39,420 --> 00:17:40,910
حسنٌ، وصلنا

370
00:17:41,190 --> 00:17:43,160
أثمّة شيءٌ هنا؟

371
00:17:43,160 --> 00:17:44,670
انظر إلى الأعلى

372
00:17:44,990 --> 00:17:45,850
الأعلى؟

373
00:17:48,650 --> 00:17:51,780
!مـ-مذهل، مذهلٌ بحق

374
00:17:51,780 --> 00:17:54,160
!لم أرَ شيئًا كهذا من قبل

375
00:17:54,670 --> 00:17:57,310
تتحمس كالأطفال

376
00:17:57,310 --> 00:17:59,140
!ما أجملها

377
00:18:01,260 --> 00:18:04,060
...اسمع يا كيوغي-كن

378
00:18:04,380 --> 00:18:08,780
هذه أول مرةٍ أحضر فيها فتًى إلى منزلي

379
00:18:09,770 --> 00:18:12,820
،وأعلم أنني أقحمتك في جمع الأختام

380
00:18:14,900 --> 00:18:16,570
لكن هل استمتعت بوقتك؟

381
00:18:17,690 --> 00:18:20,690
،في الحقيقة، عائلتك مرحةٌ للغاية

382
00:18:21,150 --> 00:18:23,210
،ويبدو أنهم يحبّونكِ كثيرًا

383
00:18:23,210 --> 00:18:25,250
لذا أسعدتني هذه الرحلة كثيرًا

384
00:18:26,630 --> 00:18:29,960
إنني في غاية السعادة لأنني أتيتُ إلى هنا

385
00:18:31,320 --> 00:18:32,950
صـ-صدقًا؟

386
00:18:32,950 --> 00:18:34,470
لا بأس إذن

387
00:18:34,910 --> 00:18:36,280
هلّا جلسنا؟

388
00:18:36,280 --> 00:18:37,170
بالطبع

389
00:18:40,110 --> 00:18:43,730
بالمناسبة، ماذا تحمل في ذلك الصندوق؟

390
00:18:44,650 --> 00:18:45,980
...هذا

391
00:18:46,260 --> 00:18:48,220
مفاجأة! إنه كروكيت

392
00:18:48,220 --> 00:18:50,360
أعددتُها في مطبخكم

393
00:18:51,320 --> 00:18:52,910
هل أعددتها بنفسك؟

394
00:18:52,910 --> 00:18:53,860
أجل

395
00:18:54,150 --> 00:18:56,330
لـ-لستَ سيئًا

396
00:18:56,330 --> 00:18:58,370
أصبحتُ أجيد إعدادها

397
00:19:00,170 --> 00:19:03,780
ففي النهاية، كانت الكروكيت أول أكلةٍ تناولناها معًا

398
00:19:06,590 --> 00:19:07,560
تفضّلي

399
00:19:11,820 --> 00:19:12,860
ما مذاقها؟

400
00:19:14,590 --> 00:19:16,010
!ما ألذّها

401
00:19:16,010 --> 00:19:17,420
ما هذا؟

402
00:19:17,420 --> 00:19:21,350
لِمَ أشعر بالرضا والخجل أكثر
مما شعرتُ به حينها يا ترى؟

403
00:19:21,800 --> 00:19:24,200
ألأنّ كيوغي هو من أعدها؟

404
00:19:28,000 --> 00:19:32,420
ألأنّ كيوغي-كن عزيزٌ عليّ؟

405
00:19:33,280 --> 00:19:35,630
أ-ألا توجد صلصة؟

406
00:19:36,500 --> 00:19:38,820
أتريدين إضافة الصلصة إلى الكروكيت؟

407
00:19:39,590 --> 00:19:40,790
أمزح

408
00:19:40,790 --> 00:19:41,990
إنها لذيذة للغاية

409
00:19:41,990 --> 00:19:43,460
شكرًا جزيلا لكِ

410
00:19:48,080 --> 00:19:49,780
شكرًا لك يا كيوغي-كن

411
00:19:50,530 --> 00:19:53,160
لانسجامك مع عائلتي

412
00:19:53,870 --> 00:19:56,390
ويسعدني حقًّا أنك استمتعت بوقتك هنا

413
00:19:58,630 --> 00:20:00,210
أتود المجيء مجددًا؟

414
00:20:01,610 --> 00:20:02,480
أجل

415
00:20:08,350 --> 00:20:10,000
ألستُما قريبين أكثر من اللازم؟

416
00:20:11,440 --> 00:20:13,580
ماذا تفعل هنا يا بابا؟

417
00:20:13,580 --> 00:20:15,500
لِمَ تقولين ذلك يا كانان-تشان؟

418
00:20:15,500 --> 00:20:19,140
لا يمكنني أن أدعكما تتغازلان دون إذني كما تعلمين

419
00:20:19,950 --> 00:20:22,500
لم أعطكما ختمي بعد

420
00:20:24,820 --> 00:20:26,150
!بابا

421
00:20:26,150 --> 00:20:31,040
بهذا العقد، نتعهد بدعمنا الكامل لكِ يا كانان-تشان

422
00:20:31,460 --> 00:20:33,080
حافظي عليه جيدًا

423
00:20:33,080 --> 00:20:34,590
عقد؟

424
00:20:34,850 --> 00:20:39,970
كما أنه ينصّ على أننا سنُنزل عليك أشدّ العقاب إن خنتها

425
00:20:40,360 --> 00:20:42,140
مفهوم يا يوجي-كن؟

426
00:20:42,140 --> 00:20:43,970
لا تقلق يا أبتي

427
00:20:45,390 --> 00:20:48,480
أنا أحبّها حبًّا جمًّا

428
00:20:50,350 --> 00:20:53,450
!أنّى لك قول ذلك أمام أبي؟

429
00:20:53,450 --> 00:20:55,230
!آهٍ منك

430
00:20:56,340 --> 00:20:57,740
...في هذه الحالة

431
00:21:04,640 --> 00:21:07,200
يجدر بك بذل قصارى جهدك
لتجعلني أقول إنني أحبّك أيضًا

432
00:21:12,740 --> 00:21:13,670
سأفعل

433
00:22:45,990 --> 00:22:48,560
أكاديمية هونو التابعة لبلدية تاما

434
00:22:49,150 --> 00:22:52,940
...مكانٌ هادئٌ للتعلم، يرتاده طلابٌ أصحاء

435
00:22:53,630 --> 00:22:55,180
...إلى أن

436
00:22:55,180 --> 00:22:59,520
نزلت شيطانة فاتنة إلى أروقتها

437
00:23:02,210 --> 00:23:03,530
أعجز عن الكلام

438
00:23:04,190 --> 00:23:07,410
أنّى لهم أن يصبحوا فاسدين هكذا خلال عطلة الصيف؟

439
00:23:08,430 --> 00:23:12,640
—يبدو أن هذه الماشية بحاجة ماسة إليّ لأحافظ على انضباطها ونقائها

440
00:23:11,410 --> 00:23:14,640
يا سينباي، حان وقت جولتنا

441
00:23:14,890 --> 00:23:17,090
!منذ متى وأنت هنا يا كيوغي-كن؟

442
00:23:17,090 --> 00:23:18,580
"منذ قولكِ "التابعة لبلدية تاما

443
00:23:18,580 --> 00:23:19,540
!منذ البداية إذن

444
00:23:20,180 --> 00:23:23,680
سينباي، هل تتنكرين بزي الشيطانة مجددًا؟

445
00:23:23,680 --> 00:23:25,930
أيمكنني الانضمام هذه المرّة؟

446
00:23:27,930 --> 00:23:29,310
...أيها

447
00:23:29,310 --> 00:23:31,850
...أيها، أيها، أيها، أيها، أيها، أيها

448
00:23:31,850 --> 00:23:34,970
أيها الكائن الوضيع

449
00:23:36,600 --> 00:23:39,630
!أريدكِ أن توبخيني أيضًا