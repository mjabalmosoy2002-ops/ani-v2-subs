223
00:15:54,140 --> 00:16:00,020
.كلام يصدر من مُعجبٍ آخر بماكوتو-سينباي

224
00:16:00,020 --> 00:16:01,340
!لستُ معجبًا

225
00:16:01,340 --> 00:16:02,490
لمِ عساني وأنا فتًى

226
00:16:02,490 --> 00:16:04,280
أن أُعجب به؟

227
00:16:05,760 --> 00:16:10,200
.احتفظت بهذه لأنّها صورة جيّدة

228
00:16:10,200 --> 00:16:11,040
.هذا ما في الأمر

229
00:16:12,970 --> 00:16:14,190
ما بال تلك النّظرة؟

230
00:16:14,190 --> 00:16:15,540
!أخبرتك إنّي لستُ معجبًا

231
00:16:16,640 --> 00:16:18,710
.أعطني إيّاها إذن

232
00:16:18,710 --> 00:16:20,150
...تلك الصّورة

233
00:16:20,150 --> 00:16:21,790
.أعطيتك ثلاثة

234
00:16:21,790 --> 00:16:23,590
.اسعدي بذلك يا شقيّة

235
00:16:24,830 --> 00:16:26,550
!سينباي هنا

236
00:16:26,550 --> 00:16:28,260
...ماكوتو-سينبا

237
00:16:29,440 --> 00:16:32,250
هل من شغفك أن تعترض درب حبّي؟

238
00:16:32,250 --> 00:16:33,560
!كلّا

239
00:16:41,010 --> 00:16:42,980
.رحل سينباي

240
00:16:43,290 --> 00:16:44,650
،لعلمك

241
00:16:44,650 --> 00:16:46,830
،قد يرتدي ماكوتو ملابس كتلك

242
00:16:46,830 --> 00:16:48,740
.لكنّه لا يريد أن يكون محطّ الأنظار

243
00:16:49,210 --> 00:16:51,140
،فإذا تحدّثتِ إليه حيث يكثر النّاس

244
00:16:51,140 --> 00:16:52,740
.فسيقلق عليك

245
00:16:53,370 --> 00:16:55,830
.سيرون أنّك غريبة أيضًا

246
00:16:56,890 --> 00:16:58,830
.فهمت

247
00:16:59,130 --> 00:17:00,100
!معلّمي

248
00:17:00,410 --> 00:17:01,490
معلّم؟

249
00:17:01,490 --> 00:17:05,050
!من الآن فصاعدًا، أنت معلّمي

250
00:17:06,660 --> 00:17:07,390
،معلّمي

251
00:17:07,390 --> 00:17:10,170
!أيّ الأوقات أنسب للتّحدّث مع سينباي؟

252
00:17:10,170 --> 00:17:12,970
في استراحة الغداء ربّما؟

253
00:17:12,970 --> 00:17:14,720
!عُلِم يا معلّمي

254
00:17:14,960 --> 00:17:17,980
لكن لِمَ تنادينني بالمعلّم؟

255
00:17:18,180 --> 00:17:20,980
.لأنّك تعلم الكثير عن سينباي

256
00:17:22,340 --> 00:17:24,090
.بديهيّ

257
00:17:24,090 --> 00:17:26,610
.فنحن صديقين منذ الرّوضة

258
00:17:28,010 --> 00:17:31,870
.أودّ سماع قصّة صداقتكما

259
00:17:33,020 --> 00:17:35,870
.ليس شيئًا أُخبرك به هكذا

260
00:17:36,410 --> 00:17:38,870
ولمَ لا؟

261
00:17:40,910 --> 00:17:43,190
.حدث الأمر في الرّوضة

262
00:17:43,190 --> 00:17:45,460
.ستخبرني إذن

263
00:17:48,570 --> 00:17:49,930
،لسبب ما

264
00:17:49,930 --> 00:17:52,640
.كنت أحاول إبكاءه كلّ يوم

265
00:17:57,490 --> 00:17:58,520
.نقيق

266
00:17:58,850 --> 00:18:01,020
.لكنّه لم يذرف دمعة

267
00:18:01,290 --> 00:18:04,520
.في إحدى المرّات، كنّا نلعب الغمّيضة

268
00:18:04,860 --> 00:18:07,280
،لكنّني لم أستطِع الخروج من مخبأي

269
00:18:07,540 --> 00:18:10,280
...فخفتُ وبكيت طالبًا النّجدة

270
00:18:11,280 --> 00:18:12,730
!ريوجي-كن

271
00:18:14,250 --> 00:18:15,820
!أنا مسرور

272
00:18:15,820 --> 00:18:17,290
!وجدتك

273
00:18:22,150 --> 00:18:25,050
.ومنذ ذلك الحين ونحن أعزّ الأصدقاء

274
00:18:25,050 --> 00:18:27,640
...معلّمي، إنّك تكنّ مشاعر لسينباي

275
00:18:28,410 --> 00:18:32,390
.لا يفهم أحدٌ ماكوتو كما أفهمه

276
00:18:33,290 --> 00:18:35,740
،فعندما يضايقه النّاس لمظهره

277
00:18:35,740 --> 00:18:37,320
.يثير ذلك غضبي

278
00:18:37,320 --> 00:18:38,930
.نحن أعزّ صديقين

279
00:18:39,850 --> 00:18:42,310
فعليّ حمايته، صحيح؟

280
00:18:43,850 --> 00:18:45,120
...معلّمي

281
00:18:52,570 --> 00:18:57,490
.أنا متيقّن أنّ آوي-سان ليست سيّئة

282
00:18:58,390 --> 00:19:01,040
.وكانت طيّبة مع ريوجي أيضًا

283
00:19:03,290 --> 00:19:06,090
...أتساءل ماذا ترى فيّ

284
00:19:06,090 --> 00:19:07,550
.بئسًا

285
00:19:07,810 --> 00:19:09,740
.نسيت إحضار الأدوات

286
00:19:10,230 --> 00:19:12,800
هل للفتى المناوب أن يُحضرها؟

287
00:19:13,250 --> 00:19:14,070
.نعم

288
00:19:16,510 --> 00:19:19,390
.حسنٌ

289
00:19:19,390 --> 00:19:20,960
...إنّه أنت

290
00:19:22,890 --> 00:19:25,320
!سيـ-ـنـ-ـباي

291
00:19:25,320 --> 00:19:27,150
!لنخرج في موعدٍ اليوم

292
00:19:27,150 --> 00:19:28,390
!ما رأيك؟

293
00:19:28,390 --> 00:19:29,650
!سينباي

294
00:19:29,950 --> 00:19:33,150
،أنا متيقّن أنّ آوي-سان ليست سيّئة

295
00:19:29,950 --> 00:19:33,150
!إنّنا في وسط الحصّة

296
00:19:33,150 --> 00:19:35,660
.بحقّك. لم يكن بالكثير

297
00:19:33,420 --> 00:19:35,660
...إنّما غريبة قليلًا

298
00:19:35,660 --> 00:19:37,220
...لِمَ أنت

299
00:19:36,220 --> 00:19:37,930
.لكنّها تختلف عنّي

300
00:19:38,730 --> 00:19:40,780
.عليك أن تكرّسي تلك الطّاقة في الحصّة

301
00:19:45,770 --> 00:19:48,260
.يا معلّم، سأذهب لإحضار الأدوات

302
00:19:48,930 --> 00:19:50,410
!واحد

303
00:19:50,410 --> 00:19:51,670
!اثنان

304
00:19:51,950 --> 00:19:53,440
!ثلاثة

305
00:19:53,440 --> 00:19:54,990
!أربعة

306
00:19:56,330 --> 00:19:58,480
،فإذا تحدّثت إليه حيث يكثر النّاس

307
00:19:58,480 --> 00:20:00,010
.فسيقلق عليك

308
00:20:02,780 --> 00:20:06,770
.أخبرني المعلّم ألّا أتحدّث إليه أمام النّاس

309
00:20:07,980 --> 00:20:09,960
.سأعتذر لاحقًا

310
00:20:19,470 --> 00:20:21,230
!سينباي

311
00:20:26,730 --> 00:20:28,070
.الشّمس ساطعة

312
00:20:37,120 --> 00:20:37,860
.إلى اللّقاء

313
00:20:38,280 --> 00:20:38,940
.نعم

314
00:21:07,560 --> 00:21:08,660
.أراكِ غدًا

315
00:21:16,450 --> 00:21:18,800
.عمتِ مساءً، يا أنا