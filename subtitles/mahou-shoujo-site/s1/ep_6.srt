1
00:00:09,000 --> 00:00:12,970
تلك إذاً شوي رينا

2
00:00:19,220 --> 00:00:22,560
يجب عليَّ فعلُ ذلك

3
00:02:09,070 --> 00:02:10,150
تسرّني رؤيتك

4
00:02:10,320 --> 00:02:13,320
أنا نيجيمين، صديقة آيا

5
00:02:13,950 --> 00:02:15,870
...نيجيمين

6
00:02:17,750 --> 00:02:19,000
.نيجيمين

7
00:02:19,160 --> 00:02:21,500
من تقابلين في هذا الوقت المتأخر

8
00:02:25,880 --> 00:02:29,380
خدعتني، بقولها أنها كانت صديقتي

9
00:02:29,550 --> 00:02:32,840
سأجعلها تدفع ثمن ذلك

10
00:02:33,470 --> 00:02:36,680
هل آيا بالمنزل؟

11
00:02:47,150 --> 00:02:48,530
.أنت هناك

12
00:02:59,160 --> 00:03:00,660
هل أنتٍ بخير؟

13
00:03:02,040 --> 00:03:05,960
م-مثير جداً

14
00:03:17,430 --> 00:03:19,560
!ن-نيجيمين

15
00:03:32,530 --> 00:03:33,950
.حسناً

16
00:03:34,110 --> 00:03:36,820
أنت ما تزالين بالمشفى؟

17
00:03:36,990 --> 00:03:38,240
.هذا صحيح

18
00:03:40,410 --> 00:03:42,580
.آسف لجعلك تنتظرين

19
00:03:42,790 --> 00:03:44,830
إذاً هذا بيتك؟

20
00:03:45,000 --> 00:03:46,330
أنت تأكل هنا كل يوم؟

21
00:03:46,540 --> 00:03:48,420
.نعم

22
00:03:48,920 --> 00:03:50,380
كان اسمك أنازاوا؟

23
00:03:50,550 --> 00:03:53,470
من فضلك نادني نيجيمين، أوني-ساما

24
00:03:55,390 --> 00:03:59,220
.تحدثت للتو مع أهلي بالمشفى، وستكون آيا بخير

25
00:04:01,020 --> 00:04:02,560
!رائع

26
00:04:02,770 --> 00:04:04,730
أنا مرتاح أيضاً

27
00:04:04,890 --> 00:04:08,190
لأنني لم أفقد كيس الملاكمة الثمين

28
00:04:08,360 --> 00:04:10,320
.حسناً، إذاً هي بخير

29
00:04:10,480 --> 00:04:12,940
لكنني سأجعلها تدفع الثمن لخيانتي

30
00:04:13,110 --> 00:04:16,280
.بِعصى سراولي السحري

31
00:04:21,830 --> 00:04:22,830
،بالمناسبة

32
00:04:23,000 --> 00:04:26,000
كيف لشخص مشهور مثلك أن يصبح صديق لآيا؟

33
00:04:26,250 --> 00:04:27,830
احم، أنا، مشهورة؟

34
00:04:28,000 --> 00:04:30,800
نعم صحيح. لقد اعتزلت الغناء، أليس كذلك؟

35
00:04:30,960 --> 00:04:33,380
صحيح، أردتُ التركيز على دراستي

36
00:04:33,550 --> 00:04:36,510
،وبعدها انتقلت إلى مدرسة جديدة

37
00:04:36,680 --> 00:04:38,970
!قابلت آيا، وأصبحنا أصدقاء بسرعة

38
00:04:39,180 --> 00:04:40,720
آه، حقاً؟

39
00:04:40,890 --> 00:04:45,140
.أنا غرت قليلاً لأن آيا أصبحت صديقة مع شخص لطيف جداً

40
00:04:45,310 --> 00:04:47,020
ل-لطيف؟

41
00:04:47,230 --> 00:04:48,520
.كانت كذبة

42
00:04:48,690 --> 00:04:51,020
ليس ممكن لقطعة من القمامة مثل آيا

43
00:04:51,190 --> 00:04:54,690
.بأن تصبح بهذه السرعة صديقة لأيقونة موسيقى البوب

44
00:04:54,900 --> 00:04:56,530
ل-لطيف؟

45
00:04:56,700 --> 00:04:59,620
.أوني-ساما قال أنني لطيفة

46
00:04:59,780 --> 00:05:02,540
!ما أريد فعله حقاً هو قتل أيابي

47
00:05:02,740 --> 00:05:06,410
!لكن، لكن، لكن، لكن

48
00:05:07,870 --> 00:05:12,460
.هذا ما جعلها رائعة، مثيرة، والقليل من ملامح أخيها

49
00:05:12,630 --> 00:05:16,090
أنا ضائعة. ماذا عليَّ أن أفعل؟

50
00:05:19,970 --> 00:05:22,470
صديقة آيا الجديدة

51
00:05:25,310 --> 00:05:27,390
هل يمكن أن تكون واحدة مهن؟

52
00:05:27,980 --> 00:05:31,310
ربّما أستطيع رؤيتها ثانيةً

53
00:05:34,230 --> 00:05:35,990
!إلى اللقاء

54
00:05:36,530 --> 00:05:38,320
لا مانع بأن تأخذي هذه؟

55
00:05:38,530 --> 00:05:41,070
هـ-هل هذه لك؟

56
00:05:41,280 --> 00:05:44,990
كونك متأخرة، سأعرض عليك السير معك إلى المنزل؟

57
00:05:45,200 --> 00:05:47,960
آه، لا، أنا بخير

58
00:05:50,120 --> 00:05:52,500
بسهولة

59
00:05:58,420 --> 00:06:02,640
الآن عندي عذر لرؤيتها مجدداً

60
00:06:03,550 --> 00:06:05,560
...لم يبقى شيء

61
00:06:05,770 --> 00:06:08,810
!كيف يجرأ بفعل هذا لملاكي

62
00:06:08,980 --> 00:06:11,730
لقد دنّسها

63
00:06:12,270 --> 00:06:14,770
دنس نيجيمين

64
00:06:20,240 --> 00:06:22,660
أليس هذا..؟

65
00:06:24,080 --> 00:06:27,330
ابنتك عانت من بعض التمزُّقات بيديها وساقيها

66
00:06:27,500 --> 00:06:29,000
لكن لا شيء يهدد حياتها

67
00:06:29,620 --> 00:06:32,880
من حظنا، أنّ صديقتها بصحة جيّدة أيضاً

68
00:06:33,790 --> 00:06:36,750
أنتم قادرون على التوجّه إلى المنزل الآن

69
00:07:05,200 --> 00:07:06,330
استيقظي

70
00:07:12,670 --> 00:07:16,420
ماذا حدث؟ رأسي يؤلمني

71
00:07:16,590 --> 00:07:19,010
أنت أخيراً مستيقظة

72
00:07:19,920 --> 00:07:20,760
!من أنتِ؟

73
00:07:23,340 --> 00:07:25,010
أماغاي كوسامي

74
00:07:25,180 --> 00:07:27,930
أكره صياغة مقدمات

75
00:07:28,140 --> 00:07:30,470
انتظري لحظة

76
00:07:31,140 --> 00:07:32,850
--لا أستطيع حتى الرؤية

77
00:07:33,270 --> 00:07:34,350
هذا صحيح

78
00:07:35,230 --> 00:07:37,270
بدأتُ أتذكر

79
00:07:37,860 --> 00:07:41,150
لقد كنتِ فاقدة للوعي منذ انهيارك

80
00:07:41,320 --> 00:07:44,450
بعد أن استعملتِ عصاكِ كثيراً

81
00:07:45,320 --> 00:07:47,450
لذلك عالجتُكِ

82
00:07:47,660 --> 00:07:49,620
عالجْتِني

83
00:07:50,080 --> 00:07:52,120
من أنت بحق الجحيم؟

84
00:07:52,290 --> 00:07:54,710
لقد أخبرتك أنا أماغاي كوسامي

85
00:07:54,870 --> 00:07:56,580
--لا تجعليني أكرر

86
00:07:56,790 --> 00:07:58,540
!أنا لا أسأل عن اسمكِ اللعين

87
00:07:58,710 --> 00:08:02,670
توقفي عن صراخك علي

88
00:08:03,510 --> 00:08:10,060
رجاءً، لا ترففي صوتك علي

89
00:08:27,780 --> 00:08:30,450
هذا صحيح، أتذكّر الآن

90
00:08:31,040 --> 00:08:34,080
هي أماغاي كوسامي

91
00:08:34,790 --> 00:08:36,750
...سلطتها هي

92
00:08:40,590 --> 00:08:45,590
أنا آسفة، أصبح طاغية قليلاً عندماً لا آخذ دوائي

93
00:08:45,760 --> 00:08:48,430
لا تخبريني، أنت فتاة سحرية أيضاً؟

94
00:08:53,270 --> 00:08:54,480
حرف أبجدي؟

95
00:08:54,640 --> 00:08:56,640
لم أرى أبداً شعاراً مثل هذا

96
00:08:56,850 --> 00:08:57,940
نعم

97
00:09:01,570 --> 00:09:03,190
...قوّة عصاي

98
00:09:04,190 --> 00:09:05,360
هي الشفاء

99
00:09:05,570 --> 00:09:07,360
الشفاء؟-
نعم-

100
00:09:07,530 --> 00:09:09,990
،عندما أستعمل عصاي لجرح نفسي

101
00:09:10,160 --> 00:09:15,660
أستطيع شفاء الشخص عن طريق تغذيته بدمي

102
00:09:18,040 --> 00:09:20,540
انتظري، هل سكبتِ دمك في فمي؟

103
00:09:20,710 --> 00:09:24,130
لحسن الحظ، كنتُ بالفعل أعاني من أذى نفسي

104
00:09:24,300 --> 00:09:27,590
لذلك استعمال العصى ليس صعبٌ عليَّ أبداً

105
00:09:27,800 --> 00:09:31,350
الشخص الطبيعي ربما كان سيتردّد

106
00:09:32,140 --> 00:09:34,520
قبل استعمال العصى مثل ذلك

107
00:09:35,930 --> 00:09:39,060
فقط لا تضعي شيئاً قذر في أفواه الناس

108
00:09:39,230 --> 00:09:40,480
يا فتاة الإيمو الصغيرة

109
00:09:43,610 --> 00:09:44,980
لماذا ساعدتني؟

110
00:09:45,150 --> 00:09:46,990
لماذا تعلمين بشأني؟

111
00:09:47,150 --> 00:09:48,570
ماذا ستفعلين بعد؟

112
00:09:49,410 --> 00:09:51,160
!هاي

113
00:09:53,330 --> 00:09:56,500
يا لكِ من تعيسة، يا لكِ من تعيسة

114
00:10:07,010 --> 00:10:07,970
فهمت

115
00:10:09,930 --> 00:10:12,470
أنا لم أمُت بعد

116
00:10:13,180 --> 00:10:14,720
عندما حصل ذلك

117
00:10:15,310 --> 00:10:18,180
ظننت بأنّي خسرت كل الأسباب لكي أعيش

118
00:10:18,810 --> 00:10:21,940
...لكنه إذا كان ممكناً

119
00:10:22,810 --> 00:10:24,650
...أظنُّ أنّني ربما

120
00:10:25,650 --> 00:10:28,490
أريد العيش أطول قليلاً فقط

121
00:10:28,650 --> 00:10:30,700
ياتسومورا-سان

122
00:10:32,070 --> 00:10:34,530
أنت مستيقظة

123
00:10:38,910 --> 00:10:41,170
لقد استقيظتُ للتو أيضاً

124
00:10:44,170 --> 00:10:45,460
فهمت

125
00:10:53,640 --> 00:10:55,810
أوه، أخيراً أنتما مستيقظات

126
00:10:58,560 --> 00:11:01,140
أردتُ شكركما على ذلك اليوم

127
00:11:01,310 --> 00:11:02,350
!شيوري-
!شيوري-سان-

128
00:11:03,020 --> 00:11:04,400
كيف؟

129
00:11:04,610 --> 00:11:06,820
أنا بتمام عافيتي، الفضل لها

130
00:11:06,980 --> 00:11:09,650
تلك الفتاة هنا عالجتني جيداً

131
00:11:11,200 --> 00:11:13,910
أماغاي كوسامي

132
00:11:14,950 --> 00:11:15,990
تسرُّني رؤيتك

133
00:11:16,160 --> 00:11:21,210
فتاة الإيمو الصغيرة هنا
ذهبت وأنقذتنا كلنا

134
00:11:21,370 --> 00:11:24,540
لا تنادني بفتاة الإيمو

135
00:11:26,170 --> 00:11:27,880
...إصاباتي

136
00:11:29,420 --> 00:11:31,340
لاشيء يؤلم

137
00:11:31,510 --> 00:11:33,590
سحر رائع، صحيح؟

138
00:11:33,760 --> 00:11:35,260
...سحر؟ مستحيل

139
00:11:35,430 --> 00:11:37,810
نعم، بالضبط

140
00:11:37,970 --> 00:11:40,720
يا لكِ من تعيسة، يا لكِ من تعيسة

141
00:11:45,480 --> 00:11:46,480
...مختلف

142
00:11:49,900 --> 00:11:53,490
أتيتُ لأطلب مساعدتكم

143
00:11:54,740 --> 00:11:56,910
نحن نتمنّى أن

144
00:11:57,320 --> 00:11:59,830
تنضمّوا لمعركتنا

145
00:12:00,290 --> 00:12:01,830
يا لكِ من تعيسة، يا لكِ من تعيسة

146
00:12:05,120 --> 00:12:07,630
لم أعلم مطلقاً أنه كان هناك مدراء آخرون

147
00:12:07,790 --> 00:12:10,800
صحيح؟ أنا أيضاً كنت متفاجئة للغاية

148
00:12:10,960 --> 00:12:14,260
ولم أتوقّع مطلقاً بأن تكون
عصاة تعمل بهذه الطريقة

149
00:12:14,430 --> 00:12:15,760
لقد كنّا ساذجات

150
00:12:20,180 --> 00:12:21,930
لكن هؤلاء الناس رائعون

151
00:12:22,100 --> 00:12:26,310
،هم ليسوا حتّى صائدون سحريين
وقد أكتشفوا ما هو التمبست بأنفسهم

152
00:12:27,520 --> 00:12:29,110
تمبست؟

153
00:12:32,110 --> 00:12:34,280
أن تعلم عنّنا؟

154
00:12:34,450 --> 00:12:38,820
،لا يهم مدى اختبائك
الأسرار ستكتشف تدريجياً

155
00:12:39,530 --> 00:12:44,000
أي أحد بإمكانه الاتصال بشخص ما لا يعرفه

156
00:12:44,160 --> 00:12:46,670
خصوصاً في هذا العصر والعمر

157
00:12:53,840 --> 00:12:55,880
،إلى جانب

158
00:12:56,050 --> 00:12:57,380
...لدينا

159
00:13:01,310 --> 00:13:04,480
...موالين يعلمون بأسرار بعضهم

160
00:13:04,980 --> 00:13:06,480
هل تودّين الخروج معي؟

161
00:13:06,640 --> 00:13:09,440
.لحظة فقط
!هاي، لا تتركيني هكذا

162
00:13:09,610 --> 00:13:11,770
وقاتلي ضد عدو واحد

163
00:13:13,900 --> 00:13:15,440
موالين؟

164
00:13:15,610 --> 00:13:18,950
إذاً هل تقولين بأن هناك فتيات سحرية أخرى؟
من يعلم عن هذا؟

165
00:13:19,110 --> 00:13:20,160
نعم

166
00:13:20,320 --> 00:13:23,330
هناك الكثير آخرون من الذين أصبحوا فتيات سحريات

167
00:13:31,670 --> 00:13:33,380
بل العديد منهم موجودين

168
00:13:33,550 --> 00:13:36,550
كلٌّ بمديره الخاص

169
00:13:43,260 --> 00:13:45,930
هذا هو الباب الخلفي

170
00:13:46,100 --> 00:13:49,900
اوه، ليس هناك

171
00:14:04,370 --> 00:14:07,450
إبحثي الآن بحذر

172
00:14:09,040 --> 00:14:13,340
هذه هي المعلومات التي أردتموها بشدّة

173
00:14:15,750 --> 00:14:20,970
عند 7:23 مساءً. في 11/أغسطس

174
00:14:21,590 --> 00:14:24,890
التمبست سوف يأتي

175
00:14:25,720 --> 00:14:31,100
التمبست سيجلب نهاية هذا العالم المزري

176
00:14:31,270 --> 00:14:35,610
وسيفتح الباب إلى عالم جديد

177
00:14:35,820 --> 00:14:37,990
،لكن خلال تلك العملية

178
00:14:38,150 --> 00:14:42,070
معظم البشرية ستكون قد أبيدت

179
00:14:42,530 --> 00:14:45,240
قدوم التمبست قد يكون عن طريق الدعوة

180
00:14:45,410 --> 00:14:49,540
لكن هناك طريقة واحدة تستطيع بها النجاة

181
00:14:49,710 --> 00:14:54,040
ذلك لإشباع جوع الملك

182
00:14:54,210 --> 00:14:57,880
الملك يطعم البشرية الطاقة السلبية

183
00:14:58,050 --> 00:15:00,130
ويقدمها لنفسه

184
00:15:00,300 --> 00:15:03,800
.ستجعلك تتجنّبين الموت خلال التمبست

185
00:15:03,970 --> 00:15:05,390
الطاقة السلبية

186
00:15:05,550 --> 00:15:10,140
بإمكاننا تجميعها وتخزينها داخل العصي السحرية

187
00:15:13,440 --> 00:15:15,980
فقط الذين يستعملون عصاهم

188
00:15:16,150 --> 00:15:22,490
لكي يجمعوا أكبر قدر من الطاقة السلبية لتقديمها

189
00:15:22,660 --> 00:15:26,780
لن يصابوا بأذىً عند مجيء التمبست

190
00:15:26,950 --> 00:15:28,660
،إذا كنت تتمنين العيش

191
00:15:28,830 --> 00:15:32,540
عليك بتقديم العصى السحرية مشحونة بكامل طاقتها السلية

192
00:15:38,960 --> 00:15:43,010
إلى حين
حدوث نهاية العالم الممتعة

193
00:15:47,220 --> 00:15:48,560
يا إلهي،

194
00:15:48,720 --> 00:15:51,980
ما هذه الفوضى التي أصبحنا عليها

195
00:15:52,140 --> 00:15:55,020
ربّما يا أصدقاء عليكم بالعمل بشكل أفضل

196
00:15:55,190 --> 00:15:59,320
حسناً، هُنَّ لسنَ أغبياء كما ظننتم

197
00:16:04,910 --> 00:16:06,530
نعم، هذا صحيح

198
00:16:06,700 --> 00:16:08,370
إذاً، ماذا علينا أن نفعل

199
00:16:09,080 --> 00:16:12,790
لا حاجة لقول ذلك، هؤلاء من يعرفون الكثير يجب أن يتم إعدامهم

200
00:16:17,580 --> 00:16:20,840
ذلك ما هو عليه التمبست؟

201
00:16:21,000 --> 00:16:22,010
نعم

202
00:16:22,760 --> 00:16:25,470
يبدو بأن هذه الطاقة السلبية

203
00:16:25,630 --> 00:16:28,180
تعني الحسد، الكراهية، والرغبة بالموت

204
00:16:28,600 --> 00:16:32,350
أو ربما الإنتقام الشّخصي

205
00:16:32,850 --> 00:16:36,400
أي شيء ربّما يعتبر اعتقاد سلبي

206
00:16:36,560 --> 00:16:38,020
هل هذا يعني؟

207
00:16:38,810 --> 00:16:41,530
لوضعها عموماً، سوء حظ

208
00:16:42,070 --> 00:16:43,320
سوء حظ؟

209
00:16:43,780 --> 00:16:48,240
أيديهم تعلق بالفتيات الذين قادوا الأرواح التعيسة

210
00:16:48,410 --> 00:16:51,240
و تجمع قواهم السلبية ليشرعوا بها

211
00:16:51,410 --> 00:16:53,660
،ثمّ يكشفون عن التمبست

212
00:16:53,830 --> 00:16:56,670
وليجعلوننا نقتل بعضنا الآخر في سبيل النجاة

213
00:16:56,830 --> 00:17:00,630
،كنتيجة، الفتيات مجبرات على استخدام العصى بين الحين والآخر

214
00:17:00,790 --> 00:17:04,510
ليكون باستطاعتهم جمع طاقة سلبية أكثر

215
00:17:09,090 --> 00:17:10,140
انتظري

216
00:17:10,300 --> 00:17:12,510
...كيف لنا أن نعيش إذ

217
00:17:12,680 --> 00:17:14,220
تماماً

218
00:17:14,390 --> 00:17:17,060
هذه الأحجية عن التمبست

219
00:17:17,560 --> 00:17:21,610
،كلما تزيد استخدامك للعصى لجمع الطاقة السلبية

220
00:17:21,770 --> 00:17:24,150
كلما تلتهم العصى حياة الفتاة السحرية

221
00:17:24,990 --> 00:17:27,820
هذا ما يفسّر كيف شيوي-سان انتهت هنا

222
00:17:40,670 --> 00:17:42,250
...لا
كيف؟

223
00:17:42,590 --> 00:17:45,130
فتيات فضوليات

224
00:17:45,300 --> 00:17:47,720
!أقتلوا أنفسكم

225
00:17:53,390 --> 00:17:57,730
هم لم ينوو مطلقاً أي منا لينجو

226
00:18:00,810 --> 00:18:03,650
ما هي الحقيقة وراء التمبست؟
ما أهدافهم؟

227
00:18:05,230 --> 00:18:08,280
...لا نعلم بعد. هذا لأننا

228
00:18:09,320 --> 00:18:11,990
نحتاج مساعدتكم

229
00:18:12,240 --> 00:18:14,830
مساعدتنا؟ ما هي تحديداً

230
00:18:14,990 --> 00:18:17,750
حسناً، قبل كل شيئ

231
00:18:20,420 --> 00:18:22,040
...التقاط

232
00:18:24,000 --> 00:18:27,170
سنعتقل واحد منهم ونجعلهم يفصحون عن التمبست

233
00:18:27,340 --> 00:18:29,470
ثم سنحاول باكتشاف طريقة للنجاة

234
00:18:29,680 --> 00:18:33,390
هذا السبب الوحيد لعدم قتلي كلاكما في نومه

235
00:18:33,550 --> 00:18:39,350
لقد دعونا كل فتاة سحرية نعرفها لقضيتنا

236
00:18:39,520 --> 00:18:42,810
نحتاج لقدر كبير من الموالين قدر الإمكان

237
00:18:42,980 --> 00:18:44,480
إذاً، ماذا سنفعل؟

238
00:18:44,650 --> 00:18:47,360
هل أنتم معنا أو لا؟

239
00:18:51,860 --> 00:18:54,280
نعم، أفكر قليلاً

240
00:18:57,290 --> 00:18:59,870
نحن معكم، طبعاً

241
00:19:00,160 --> 00:19:02,040
حسناً، هذا جيد

242
00:19:05,670 --> 00:19:10,010
ولا نستطيع فعل شيئ بدون العصي السحرية

243
00:19:10,170 --> 00:19:12,380
لماذا لا تساعدينا قليلاً؟

244
00:19:12,550 --> 00:19:16,140
أنتم من أضعتم كل العصي
تعبتُ بجمعها

245
00:19:16,310 --> 00:19:18,350
وذلك كتاب القتل خارق الإفادة

246
00:19:18,520 --> 00:19:20,180
إعملي إذاً

247
00:19:20,640 --> 00:19:23,770
يبدو أن السحر لا يستطيع علاج شخصيتها

248
00:19:23,940 --> 00:19:25,650
دعونا نمضي

249
00:19:27,320 --> 00:19:30,030
!حسناً، يبدو بأنكم اهتممتم بالأمر-
!انتظري-

250
00:19:30,190 --> 00:19:31,860
!أراك لاحقاً

251
00:19:32,280 --> 00:19:34,320
!عودي إلى هنا

252
00:19:39,290 --> 00:19:41,410
أنا مغلوبة

253
00:19:41,580 --> 00:19:43,870
لقد مررت بالكثير الليلة

254
00:19:44,040 --> 00:19:45,790
الكثير

255
00:19:50,420 --> 00:19:52,220
...تعلمين، ياتسومورا-سان

256
00:19:52,380 --> 00:19:53,970
ما الأمر؟

257
00:19:54,300 --> 00:19:57,100
عن الرجل الذي بغرفتك

258
00:19:57,260 --> 00:19:59,560
...ياتسومورا-سان، هل كنت؟

259
00:19:59,720 --> 00:20:02,560
نعم، أمسكته بقوّة عصاي

260
00:20:02,730 --> 00:20:05,440
وتركته مقيّد لأحقق انتقامي

261
00:20:06,770 --> 00:20:08,650
تمنّيتُ جعله يعاني

262
00:20:09,440 --> 00:20:11,280
القدر أسوء من الموت

263
00:20:12,150 --> 00:20:15,570
حتى اعترفَ بجرائمه

264
00:20:15,740 --> 00:20:18,200
هذا كان هدف حياتي

265
00:20:18,370 --> 00:20:20,040
كان على الأقل

266
00:20:22,450 --> 00:20:24,460
لكنّه الآن رحل

267
00:20:25,170 --> 00:20:26,960
ياتسومورا-سان

268
00:20:27,130 --> 00:20:29,340
شكرا لكِ، أساغيري-سان

269
00:20:34,930 --> 00:20:38,930
لحمايتي بحياتك عندما احتجت

270
00:20:44,060 --> 00:20:47,560
لم أتوقع أن تكوني بتلك الجرأة

271
00:20:47,730 --> 00:20:50,400
ماذا، كنتِ تسمعين؟

272
00:20:50,570 --> 00:20:52,480
نعم، سمعت

273
00:20:53,690 --> 00:20:55,530
جعلني هذا سعيداً

274
00:20:55,820 --> 00:20:57,610
شكراً لكِ

275
00:21:02,120 --> 00:21:04,910
إذا كنت ما أزال قادرة على الاستمرار بالعيش

276
00:21:05,080 --> 00:21:08,040
لن تكون حياتي من أجل الانتقام

277
00:21:08,380 --> 00:21:11,590
لن تكون طويلة الآن، ليست طويلة على الإطلاق

278
00:21:15,340 --> 00:21:17,130
أ-آيا؟

279
00:21:17,300 --> 00:21:20,010
كيف خرجتِ من المشفى؟

280
00:21:20,180 --> 00:21:23,430
...حسناً، اممم

281
00:21:23,600 --> 00:21:24,770
مرحباً

282
00:21:24,930 --> 00:21:26,810
وماذا عن إصاباتك؟

283
00:21:26,980 --> 00:21:28,650
كيف شفيتي منهم؟

284
00:21:28,810 --> 00:21:31,270
الجروح لا تختفي كالسحر بهذه البساطة

285
00:21:31,440 --> 00:21:34,480
أوه، لكن لديهم. هذا غريب جداً

286
00:21:34,650 --> 00:21:36,820
،إذاً، كما تعلمين

287
00:21:36,990 --> 00:21:39,570
،منذ أن فقدت ياتسومورا-سان منزلها

288
00:21:39,740 --> 00:21:42,870
ظننت أنها ربما تكون قادرة على البقاء معنا

289
00:21:43,040 --> 00:21:46,200
هل هذا جيد؟-
لا بأس، لكن-

290
00:21:48,370 --> 00:21:50,380
سحر، هاه؟

291
00:21:56,300 --> 00:21:59,800
لماذا أنت فضولية جداً؟

292
00:21:59,970 --> 00:22:01,510
بعد كل شيء قد فعلتُه

293
00:22:01,680 --> 00:22:04,180
لجعلكِ فتاة سحرية

294
00:22:04,680 --> 00:22:06,060
اوه، جيد

295
00:22:06,220 --> 00:22:07,850
...فتيات عديمات فائدة

296
00:22:14,570 --> 00:22:17,360
!هل عليها فقط أن تموت

297
00:22:17,530 --> 00:22:19,780
،كما تعلمين

298
00:22:19,950 --> 00:22:23,660
العالم مليء بالكثير من سيئين الحظ

299
00:23:58,910 --> 00:24:01,710
نيجيمي أنازاوا أتت إلى بيتنا اليوم

300
00:24:01,870 --> 00:24:04,420
ربما أنا قادر على استخدام هذه المتشردة الصغيرة

301
00:24:04,580 --> 00:24:06,420
أهلاً، نيجيمين

302
00:24:06,590 --> 00:24:10,130
سأرحّب بكِ بإبتسامتي الخاصة

303
00:24:10,840 --> 00:24:13,930
انظر، هي سقطت بحبي بالفعل

304
00:24:14,090 --> 00:24:15,930
لكنها ليست غلطتك

305
00:24:16,090 --> 00:24:17,760
أنت مطعمة-الأسفل

306
00:24:17,930 --> 00:24:20,600
وأنا قد باركني الرّب

307
00:24:20,770 --> 00:24:23,640
نحن بالأساس بمستويات مختلفة

308
00:24:23,980 --> 00:24:25,980
الحلقة القادمة "الاستراتيجية المشتركة

309
00:24:26,150 --> 00:24:27,560
أراكم لاحقاً