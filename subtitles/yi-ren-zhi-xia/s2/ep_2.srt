1
00:00:06,540 --> 00:00:08,810
...راتن تايشو

2
00:02:01,050 --> 00:02:03,140
.لكنّني لا أفهم

3
00:02:03,540 --> 00:02:09,570
،حتّى إن كان التّينشي يريد سورا-كن
لِمَ توّجب عليه دعوتُه إلى الرّاتن تايشو؟

4
00:02:09,940 --> 00:02:13,140
.ينبغي أن يكون لديه عدّة طرق أخرى ليحصل عليه

5
00:02:13,140 --> 00:02:14,470
من يدري؟

6
00:02:15,450 --> 00:02:18,950
.لكنّ التّينشي لم يتخّذ قراره بنفسه

7
00:02:19,810 --> 00:02:21,710
هل تظنّ أنّ للشّيوخ العشرة علاقة بالأمر؟

8
00:02:21,710 --> 00:02:23,260
.على الأرجح

9
00:02:23,260 --> 00:02:29,510
لا يمكن للتّينشي وحده اتّخاذ
.القرارات بشأن حدث كبير كهذا

10
00:02:29,510 --> 00:02:34,900
.إنّهم يتكّبدون عناءً كبيرًا من أجل سوران-كن فحسب

11
00:02:35,920 --> 00:02:38,640
.لا أحد يريد سوران

12
00:02:39,250 --> 00:02:46,570
جميعهم يريدون الأسلوب الّذي علّمه له
.جدّه تشو ساكورين، أسلوب كيتايغين

13
00:02:48,180 --> 00:02:52,030
.أيّها التّينشي، لديك قلب كريم جدًّا

14
00:02:52,030 --> 00:02:54,740
.أنا واثق أنّ للشّيوخ العشرة الكثير ليقولونه

15
00:02:55,160 --> 00:03:03,210
ريكوكين، نحن نسمح لدخيل بالمشاركة
.في اختيار التّينشي الموالي

16
00:03:03,780 --> 00:03:06,590
.لا يمكنك لومهم على اعتراضاتهم

17
00:03:06,950 --> 00:03:09,110
ألا تفهم أيّها التّينشي؟

18
00:03:09,590 --> 00:03:14,500
أرغموا تلاميذهم على المشاركة فقط كي

19
00:03:14,500 --> 00:03:17,200
.لا يصبح تشو سوران التّينشي الموالي

20
00:03:17,210 --> 00:03:19,090
أنا واثق أنّهم ينوون إقصاء تشو سوران

21
00:03:19,090 --> 00:03:21,590
.باستعمال جميع الأساليب الخبيثة

22
00:03:22,530 --> 00:03:26,110
.سيقرّر القدر كلّ شيء

23
00:03:26,110 --> 00:03:28,930
.لا يوجد شيء يمكنني فعله

24
00:03:29,250 --> 00:03:35,330
إن كنت تريد تشو سوران إلى جانبك، ألا تظنّ
أنّه سيكون من الأسرع أن تجعله تلميذًا لك؟

25
00:03:35,840 --> 00:03:37,860
.فأنت حرّ في اتّخاذ أيّ تلميذ تريد

26
00:03:38,210 --> 00:03:40,410
.لن يواقفك الشّيوخ الآخرون

27
00:03:40,660 --> 00:03:45,020
لِمَ أنتَ مصمّم هكذا على أن تجعله خليفةً لك؟

28
00:03:45,370 --> 00:03:47,620
.لا يمكنني إخبارك بذلك

29
00:03:48,040 --> 00:03:50,810
.الطّريق تتبع الأرض

30
00:03:51,700 --> 00:03:55,720
.وعلى النّاس اتّباع الطّبيعة

31
00:03:56,250 --> 00:04:00,400
.لكن على هذا المعدّل، لن تسير الأمور كما خطّطت

32
00:04:01,760 --> 00:04:07,050
.حتّى وإن رفضت التّصرّف، فأنا لا أنوي الصّمت

33
00:04:08,280 --> 00:04:09,680
.التّينشي

34
00:04:09,680 --> 00:04:12,430
.حسنًا، حسنًا. اجلسوا

35
00:04:12,940 --> 00:04:17,150
طلبت منكم الاجتماع لأنّ لدى
ريكوكين شيء يناقشه

36
00:04:17,150 --> 00:04:20,900
.بخصوص الرّاتن تايشو القادم

37
00:04:21,970 --> 00:04:25,200
ماذا بقي هناك لمناقشته؟

38
00:04:25,200 --> 00:04:33,430
أنا أيضًا كنت أتساءل إن كان هناك ما يمكنني
.فعله من أجل هذا الحدث مثلكم

39
00:04:34,230 --> 00:04:37,490
ما الّذي تحاول قوله يا ريكوكين؟

40
00:04:40,180 --> 00:04:41,790
ما الّذي تفعله يا ريكوكين؟

41
00:05:11,860 --> 00:05:14,450
.التّقنيّة السّرّيّة: تسوتينروكو

42
00:05:15,220 --> 00:05:20,840
تمتلك إحدى القوى الثّمان الّتي سبّبت حرب كوشين؟

43
00:05:20,840 --> 00:05:24,010
.الإشاعات صحيحة إذًا

44
00:05:24,260 --> 00:05:30,760
،لفت انتباهي أنّكم دعوتم عدّة دخلاء إلى الرّاتن تايشو

45
00:05:30,760 --> 00:05:33,100
.لكن تّمت دعوتهم فقط ليعطوكم صورة جيّدة

46
00:05:33,630 --> 00:05:38,010
.لا أحد منهم في الواقع يريد أن يكون التّينشي

47
00:05:38,870 --> 00:05:45,120
،لذا كمكافأة للفوز بالرّاتن تايشو القادم

48
00:05:45,760 --> 00:05:48,540
.سأهدي التسوتينروكو خاصّتي

49
00:05:48,790 --> 00:05:50,640
هل من معترض؟

50
00:05:52,360 --> 00:05:56,860
.لا عجب أنّهم يدعونك بالقدّيس ريكوكين

51
00:05:57,320 --> 00:06:03,000
.أرى أنّك أكثر من استفاد من الحرب

52
00:06:03,250 --> 00:06:07,420
.استفدت؟ لا تكن غبيًّا

53
00:06:07,710 --> 00:06:13,050
...حاولوا أخذ تسوتينروكو منّي

54
00:06:13,550 --> 00:06:18,280
...ريكوكين، أ-أرجوك

55
00:06:20,100 --> 00:06:22,630
...جو شيفو من مدرسة جوسي

56
00:06:23,680 --> 00:06:26,840
.لم أنسه أبدًا

57
00:06:28,030 --> 00:06:34,040
.أخبرني بأسماء الرّجال الّذين قتلوه في آخر لحظاته

58
00:06:34,490 --> 00:06:36,700
ألا تريدان معرفتهم؟

59
00:06:39,250 --> 00:06:43,080
.الماضي يتلاشى كالسّحب

60
00:06:43,790 --> 00:06:50,710
أنا واثق أنّ صديقك سيكون أكثر
.سعادة كلّما أسرعت بالنّسيان

61
00:06:53,770 --> 00:06:58,110
.لا أصدّق ما فعلته

62
00:06:58,420 --> 00:07:02,740
.سعيهم خلف التسوتينروكو سيثير فوضى في الحدث

63
00:07:03,160 --> 00:07:09,410
أبعدنا انتباهنا عن حرب كوشين
.بسبب إشفاقنا على أنفسنا

64
00:07:09,860 --> 00:07:14,870
.لكن لديّ أكثر من مائة سنة
.لم يبق لي الكثير من الوقت

65
00:07:15,340 --> 00:07:18,410
.هذه المّرة، لن أغفل شيئًا

66
00:07:18,830 --> 00:07:22,540
هناك الكثير من النّاس في هذا العالم
.يرغبون بقوّة تسوتينروكو

67
00:07:25,460 --> 00:07:28,120
.لا داعي لسرقتها منّي

68
00:07:28,640 --> 00:07:31,200
!إن أرادوها، فيمكنهم الحصول عليها

69
00:08:21,220 --> 00:08:22,930
.ليس سيّئًا

70
00:08:22,930 --> 00:08:26,080
!أظنّ أنّ بإمكاني التّوقّف عن كبح نفسي

71
00:08:26,400 --> 00:08:28,190
.لا بأس

72
00:08:32,770 --> 00:08:34,770
...هذا مؤلم

73
00:08:35,270 --> 00:08:36,970
!اسمعي يا هو-ني

74
00:08:36,970 --> 00:08:39,180
!تساهلي معي

75
00:08:39,770 --> 00:08:42,860
هل هذا حقًّا أفضل ما لديك؟

76
00:08:43,480 --> 00:08:47,030
.على الأقل تحسّنت قليلاً

77
00:08:48,330 --> 00:08:49,910
.بالطّبع

78
00:08:49,910 --> 00:08:52,720
.فأنت تدرّبينني كلّ يوم

79
00:08:53,300 --> 00:08:59,220
...على أيّة حال، أسلوب رونوكو الّذي علّمتنيه

80
00:08:59,220 --> 00:09:01,150
أليس تقنيّة من أسلوب كيتايغين؟

81
00:09:03,530 --> 00:09:04,560
.لا أدري

82
00:09:05,310 --> 00:09:06,560
لا تدرين؟

83
00:09:06,560 --> 00:09:12,030
،أجل. مات جدّك مباشرة بعدما علّمها لي

84
00:09:12,030 --> 00:09:14,450
.لذا لا أدري إن كانت كيتايغين أم لا

85
00:09:14,450 --> 00:09:18,460
.علّميني على الأقلّ إذًا سرّ استعمال رونوكو

86
00:09:18,460 --> 00:09:20,130
.لا بدّ أنّك تعرفين ذلك

87
00:09:20,130 --> 00:09:24,320
.لكنّني لم أتقن رونوكو

88
00:09:24,320 --> 00:09:25,720
.لذا لا أعرف أيّ أسرار

89
00:09:25,720 --> 00:09:30,680
ماذا؟ كيف لم تتقني رونوكو
وأنت من تمّ تعليمها لها؟

90
00:09:30,680 --> 00:09:35,620
.لأنّ جدّك قال لي أن أعطيها لك

91
00:09:35,620 --> 00:09:37,750
فلِمَ إذًا أزعج نفسي بإتقانها؟

92
00:09:37,750 --> 00:09:40,710
...ماذا؟ حسنًا

93
00:09:42,180 --> 00:09:45,480
،ما كنت لأقبل هذه الحجّة من أيّ أحد آخر

94
00:09:45,850 --> 00:09:49,560
.لكن لسبب ما، لا يمكنني المجادلة إن قلتها أنت

95
00:09:49,560 --> 00:09:52,770
.على أيّة حال، أنت قويّة جدًّا

96
00:09:52,770 --> 00:09:54,640
أيّ تدريب قمت به؟

97
00:09:54,910 --> 00:09:57,720
.من؟ أنا؟ ليس شيئًا مميزًا

98
00:09:57,720 --> 00:10:03,740
حتّى وإن جلست دون فعل شيء يتحرّك الكي
.خاصّتي بداخلي ويشكّل نفسه بنفسه

99
00:10:04,130 --> 00:10:07,510
لكنّه لا يتدفّق بشكل سلس عندما
.يكون انتباهي مشوّشًا

100
00:10:07,990 --> 00:10:11,250
،لكن بما أنّ لديك علامة شوكيوسا

101
00:10:11,250 --> 00:10:13,610
.فإنّ امتلاك أفكار بذيئة سخيفة يكون مؤلمًا

102
00:10:13,610 --> 00:10:16,180
.ينبغي أن تكون ماهرًا في كبح الأفكار السّخيفة

103
00:10:16,510 --> 00:10:18,960
.لهذا السّبب تتحسّن أسرع من الآخرين

104
00:10:19,320 --> 00:10:22,460
هل تحاولين إبهاجي؟

105
00:10:22,460 --> 00:10:23,730
.ثق بي

106
00:10:24,260 --> 00:10:29,590
.فحتّى الآن، لم تكن قادرًا حتّى على خدشي

107
00:10:30,090 --> 00:10:36,330
نعم، لكن كيف لك أن تكوني بهذه القوّة
وأنت لم تتعلّمي أيّ تقنيّة فنون قتال؟

108
00:10:36,330 --> 00:10:38,760
هل أنت واثقة أنّك لم تتقني شيئًا؟

109
00:10:38,760 --> 00:10:42,320
ولا حتّى تقنيّة خاصّة رائعة؟

110
00:10:45,960 --> 00:10:49,720
هناك تقنيّة فنون قتال تعلّمتها
.من جو يون قبل أيّام

111
00:10:49,720 --> 00:10:52,390
.سأجرّبها. هاجمني

112
00:10:52,390 --> 00:10:55,210
.حسنًا. ها أنا قادم

113
00:10:57,350 --> 00:11:00,760
.اضرب ثغرة خصمك بكفك

114
00:11:00,760 --> 00:11:03,540
."إنّها "رجل يدفع سيّارة باليد

115
00:11:05,110 --> 00:11:06,130
...وأيضًا

116
00:11:07,110 --> 00:11:09,360
".كانّون-ساما يجلس على لوتس"

117
00:11:11,380 --> 00:11:12,400
...وبعدها

118
00:11:13,010 --> 00:11:14,820
."ادخل التّنين السّامّ"

119
00:11:18,310 --> 00:11:22,330
.سمّى جو يون سكّيني أيضًا

120
00:11:22,850 --> 00:11:28,300
."لأنّه رقيق وحادّ، اسمه "أوكاموتو 0.01

121
00:11:28,700 --> 00:11:32,480
.علّمني جو يون ما مجموعه 48 تقنيّة

122
00:11:32,480 --> 00:11:36,510
اسمها تقنيّات أسلوب مونزيتسو
.الخاصّة الثّمانية والأربعين

123
00:11:37,410 --> 00:11:40,010
فهمت. كانت هوهو تستعمل تلك التّقنيّات؟

124
00:11:40,430 --> 00:11:42,210
.شكرًا يا سوران-كن

125
00:11:42,660 --> 00:11:44,170
هل حدث شيء ما؟

126
00:11:45,040 --> 00:11:46,650
!يكفي يا جو يون

127
00:11:46,650 --> 00:11:49,130
!توقّف عن تعليم هوهو تقنيّات فنون قتال فجّة

128
00:11:49,130 --> 00:11:52,270
.لا تغضب يا جو سان

129
00:11:52,270 --> 00:11:53,440
—كنت أمزح فحسب

130
00:11:53,440 --> 00:11:54,170
!اخرس

131
00:11:55,060 --> 00:11:59,400
.أنت رجل لا يملك أيّ حسّ فكاهيّ

132
00:12:01,410 --> 00:12:02,210
ما الأمر؟

133
00:12:03,370 --> 00:12:04,360
ماذا؟

134
00:12:06,380 --> 00:12:09,340
...رئيس شينشو وتلاميذ

135
00:12:09,340 --> 00:12:12,510
كيف لأحد أن يقتل ثلاثة دخلاء في وقت قصير؟

136
00:12:12,870 --> 00:12:14,830
.هذا لم يكن عمل شخصٍ مبتدئ

137
00:12:14,830 --> 00:12:16,680
...الوحيدون الّذين قد يفعلون شيئًا كهذا

138
00:12:17,120 --> 00:12:19,380
.لا بدّ أنّها تلك المنظّمة

139
00:12:20,090 --> 00:12:23,970
ما الّذي تخطّط زينسي له؟

140
00:12:25,720 --> 00:12:30,320
.جينتشو، لم أرَ زعيمنا مؤخّرًا

141
00:12:30,320 --> 00:12:32,190
.أنت لا تتغيّرين أبدًا يا ناتسكا

142
00:12:32,870 --> 00:12:35,280
.غادر زعيمنا منذ مدّة

143
00:12:35,700 --> 00:12:38,940
لِمَ لا تثقين به قليلاً؟

144
00:12:40,100 --> 00:12:45,310
.إنّه مجرّد زينة بديلة

145
00:12:46,980 --> 00:12:50,370
.سيصبح القائد الرّسميّ في النّهاية

146
00:12:50,640 --> 00:12:52,120
.لست واثقة من ذلك

147
00:12:52,120 --> 00:12:56,950
.ليس وكأنّ من يكون قائدنا يهمّني

148
00:12:52,120 --> 00:12:56,950
...يا ناتسكا-تشان، تعالي وامرحي معي

149
00:12:57,470 --> 00:13:01,210
على أيّة حال، أين ذهب كلبي؟

150
00:13:01,210 --> 00:13:03,600
.كو كيتسو في الخارج يصطاد

151
00:13:04,220 --> 00:13:06,400
.يبدو أنّه اصطاد ثلاثة بالفعل

152
00:13:06,400 --> 00:13:08,000
.إنّه فعّال جدًّا

153
00:13:09,430 --> 00:13:12,470
،منذ أن أبرم كوكيتسو عقدًا معك

154
00:13:12,470 --> 00:13:15,310
.يمكنه سرقة وعي ضحاياه

155
00:13:16,910 --> 00:13:18,910
.ما كنت لأريد أن يُربَط ذلك بي

156
00:13:18,910 --> 00:13:20,860
.أتمنّى أن يبقى ضمن الحدود

157
00:13:20,190 --> 00:13:23,330
...ناتسكا

158
00:13:23,740 --> 00:13:25,980
.أنا آسف. اقترفت خطأ

159
00:13:26,480 --> 00:13:28,630
.قتلت ثلاثة

160
00:13:29,110 --> 00:13:31,910
.لكنّه لم يكن رجلاً عاديًّا

161
00:13:32,690 --> 00:13:35,380
.أعدك ألاّ أخفق في المرّة القادمة

162
00:13:35,900 --> 00:13:37,040
!لا تتخلّي عنّي

163
00:13:37,470 --> 00:13:39,130
وهل سمعت؟

164
00:13:39,130 --> 00:13:43,130
.سيعطون التسوتينروكو للفائز بالرّاتن تايشو الموالي

165
00:13:43,130 --> 00:13:45,150
.سأحضرها لك

166
00:13:45,550 --> 00:13:47,130
أنت تريدينها، أليس كذلك؟

167
00:13:48,580 --> 00:13:50,390
.لقد أفسدت الأمر حقًّا

168
00:13:50,390 --> 00:13:53,570
ماذا إن علمت شركة التّوصيل السّريع بهذا؟

169
00:13:53,860 --> 00:13:55,920
.أنت عديم النّفع

170
00:13:55,920 --> 00:13:57,480
—لكنّني

171
00:13:57,480 --> 00:13:59,360
!أيّها الابن الغبيّ

172
00:13:59,360 --> 00:14:02,620
أبي! لم فعلت ذلك؟

173
00:14:02,620 --> 00:14:05,150
.قلت لك ألاّ تلمس عزيزتي ناتسكا

174
00:14:05,150 --> 00:14:06,480
كم مرّة عليّ أن أقول لك ذلك؟

175
00:14:06,910 --> 00:14:08,510
!تبًّا

176
00:14:08,510 --> 00:14:11,570
.كنت أريق الدّماء في الخارج من أجل ناتسكا

177
00:14:11,870 --> 00:14:14,260
!أنت مجرّد عجوز عديم النّفع

178
00:14:14,260 --> 00:14:17,550
!هذه ليست طريقة تتحدّث بها إلى والدك

179
00:14:18,550 --> 00:14:20,430
.تبًّا

180
00:14:21,010 --> 00:14:22,990
.أيّها الحقير

181
00:14:24,510 --> 00:14:28,310
!من المستحيل أن تُغرَم ناتسكا بعجوز مثلك

182
00:14:28,310 --> 00:14:33,260
!أيّها الوغد! سأقتلك الآن

183
00:14:31,690 --> 00:14:33,780
!أودّ أن أراك تحاول

184
00:14:32,800 --> 00:14:35,090
—هذا يكفي

185
00:14:35,090 --> 00:14:36,360
!اخرسي

186
00:14:37,880 --> 00:14:42,670
.ناتسكا، بمجرّد أن أقتله سيحين دورك

187
00:14:42,670 --> 00:14:47,000
.دائمًا تسخرين منّي

188
00:14:47,000 --> 00:14:49,630
هل أبطل مفعول تعويذة الشّهوة خاصّتي؟

189
00:14:48,570 --> 00:14:50,450
!أيّها الابن الغبيّ

190
00:14:50,450 --> 00:14:53,240
!سأقتلك أوّلاً

191
00:14:51,120 --> 00:14:53,240
!أغلق فمك أيّها العجوز

192
00:14:53,990 --> 00:14:55,980
...كوني من رايينهو

193
00:14:56,280 --> 00:14:58,130
.هذا من صنيعك إذًا

194
00:15:00,290 --> 00:15:01,950
.ألغي تعويذتك في الحال

195
00:15:11,830 --> 00:15:14,250
...كو كيتسو، أنت

196
00:15:29,230 --> 00:15:30,960
!قوّة

197
00:15:30,960 --> 00:15:34,660
!يمكنني الشّعور بالقوّة تدخل إلى جسدي

198
00:15:36,050 --> 00:15:41,120
.ليس مضطرًّا الآن للخروج للصّيد

199
00:15:45,120 --> 00:15:46,100
...كو كيتسو

200
00:15:50,780 --> 00:15:51,790
...اهرب

201
00:15:54,010 --> 00:15:55,240
...بسرعة

202
00:15:56,220 --> 00:16:00,790
...أسرع واهرب منهم

203
00:16:03,430 --> 00:16:04,710
...أبي

204
00:16:07,030 --> 00:16:10,380
...لقد... قتلت أبي

205
00:16:12,270 --> 00:16:13,570
...أبي

206
00:16:14,870 --> 00:16:17,850
ماذا فعلت؟

207
00:16:20,270 --> 00:16:22,310
.لا بدّ أنّ هذا صعب عليك يا فتى

208
00:16:22,890 --> 00:16:26,030
.فقد قتلت أباك

209
00:16:27,120 --> 00:16:33,660
.لكنّ جميع الجراح العاطفيّة تتلاشى مع الوقت

210
00:16:35,050 --> 00:16:38,980
.لا بأس. ستتحسّن قريبًا

211
00:16:42,830 --> 00:16:44,360
.بالمناسبة يا كو كيتسو

212
00:16:44,990 --> 00:16:47,150
من كان هدفك الرّابع؟

213
00:16:48,760 --> 00:16:51,410
...شوكاتسو سي

214
00:16:51,410 --> 00:16:52,290
ماذا؟

215
00:16:54,090 --> 00:16:56,780
لِمَ هو بالضّبط؟

216
00:16:57,280 --> 00:16:59,450
،سليل شوكاتسو كومي

217
00:16:59,990 --> 00:17:03,210
...أحد أكثر الدّخلاء البارزين، شوكاتسو سي

218
00:17:04,040 --> 00:17:05,570
.يا سي-ني

219
00:17:06,130 --> 00:17:09,630
.إن لم نسرع، فستغادر الرّحلة إلى كوسي

220
00:17:11,800 --> 00:17:14,240
.لا داعي للعجلة يا هاكو

221
00:17:14,240 --> 00:17:16,580
.فلن تذهب الرّاتن تايشو إلى أيّ مكان

222
00:17:16,580 --> 00:17:18,790
كيف لك أن تكون مسترخيًا هكذا؟

223
00:17:18,790 --> 00:17:21,100
!إن فوّتنا رحلتنا، فلن نصل في الوقت المناسب

224
00:17:21,100 --> 00:17:22,590
.حسنًا، حسنًا

225
00:17:38,670 --> 00:17:41,580
...حـ-حركة الكي تلك

226
00:17:41,970 --> 00:17:47,200
الكي المزروع بداخلي بالرّونوكو تغيّر بمفرده؟

227
00:17:48,570 --> 00:17:50,280
ما هذا بالضّبط؟

228
00:17:50,740 --> 00:17:53,680
يا سوران، هل أنت جاهز؟

229
00:17:53,680 --> 00:17:55,050
.سنغادر

230
00:17:55,790 --> 00:17:57,050
.حا-حاضر

231
00:17:59,120 --> 00:18:01,650
هو-ني ستشارك في الرّاتن تايشو؟

232
00:18:01,650 --> 00:18:05,240
.نعم. تغيّرت القواعد، وسُمِح لها الآن بالمشاركة

233
00:18:05,240 --> 00:18:08,220
أيّ دخيل أصغر من ثلاثين سنة
.مسموح له بالمشاركة

234
00:18:08,220 --> 00:18:09,600
حقًّا؟

235
00:18:09,600 --> 00:18:12,230
.لا أريد قتال كلّ أولئك الأشخاص

236
00:18:12,510 --> 00:18:14,410
.لا تقلق

237
00:18:14,410 --> 00:18:18,880
ستقضي هوهو-تشان على أيّ شخصٍ
.قد يقف في طريقك

238
00:18:19,370 --> 00:18:22,250
...لا أظنّ أنّ عليها فعل ذلك

239
00:18:22,900 --> 00:18:26,680
هل يمكنك رجاءً إزالة جميع الأغراض
المعدنيّة الّتي تحملينها؟

240
00:18:27,040 --> 00:18:27,670
.حسنًا

241
00:18:28,510 --> 00:18:30,160
—ماذا؟ مـ

242
00:18:30,160 --> 00:18:32,160
لِمَ تحملين ذلك؟

243
00:18:32,420 --> 00:18:33,890
!إنّه سوء فهم

244
00:18:32,540 --> 00:18:35,180
!الأمن! نادوا الأمن

245
00:18:33,890 --> 00:18:35,270
!لقد اختلط مع أغراضنا فحسب

246
00:18:35,270 --> 00:18:36,810
!لم تقصد شيئًا بذلك

247
00:18:35,380 --> 00:18:37,470
هل يمكنني الذّهاب الآن؟

248
00:18:40,370 --> 00:18:45,110
أنا واثق أنّه سيكون هنالك الكثير من
.الدّخلاء أقوى منّي في ذلك الحدث

249
00:18:45,110 --> 00:18:48,400
.أنت تستخفّ بقدراتك يا هاكو

250
00:18:48,980 --> 00:18:52,400
،لأنّك لم تتفاعل مع الدّخلاء الآخرين كثيرًا

251
00:18:52,400 --> 00:18:56,940
.فأنت لا تملك حسًّا دقيقًا بقدراتك

252
00:18:57,320 --> 00:19:00,730
.لكنّك قويّ ما يكفي للقتال

253
00:19:01,240 --> 00:19:04,670
.سمعت أنّ تشو ريغيوكو سيكون هناك

254
00:19:04,670 --> 00:19:08,970
.وتشو سوران وريث أسلوب شيء-غين

255
00:19:08,970 --> 00:19:10,700
.قد يكون قويًّا أيضًا

256
00:19:11,620 --> 00:19:13,440
أسلوب كيتايغين؟

257
00:19:13,440 --> 00:19:17,970
.سنرى إلى أيّ مدى سيكون فعّالاً ضدّ عائلة شوكاتسو

258
00:19:36,730 --> 00:19:38,600
!أيّها التّلميذ الغبيّ

259
00:19:39,330 --> 00:19:43,540
أيّ تلميذ ينام بينما معلّمه يتدرّب؟

260
00:19:44,770 --> 00:19:47,430
.لا تغضب يا معلّم

261
00:19:47,430 --> 00:19:48,920
.ربّما لا تحصل على ما يكفي من الكالسيوم

262
00:19:49,870 --> 00:19:53,450
!لن أظهر لك أيّ رحمة يا أويا

263
00:19:51,380 --> 00:19:53,450
!حسنًا، فهمت! فهمت

264
00:19:53,450 --> 00:19:55,760
!كنت مخطئًا يا معلّمي

265
00:19:55,220 --> 00:19:59,120
.أخي أويا، المعلّم الكبير يناديك

266
00:20:00,150 --> 00:20:02,120
...نـ-نجوت

267
00:20:02,730 --> 00:20:04,800
.آسف على التّأخّر أيّها المعلّم الكبير

268
00:20:05,180 --> 00:20:06,360
.سأدخل

269
00:20:06,950 --> 00:20:10,200
.أتيت يا أويا. تعال

270
00:20:10,200 --> 00:20:12,570
ما سبب مزاجك الجيّد؟

271
00:20:13,050 --> 00:20:14,510
.ألقِ نظرة

272
00:20:14,510 --> 00:20:18,440
.تعلّمت استعمال هذه الجهاز اللّوحيّ

273
00:20:19,400 --> 00:20:22,750
.مذهل أيّها المعلّم الكبير. أنت ذكيّ

274
00:20:22,750 --> 00:20:26,350
كما أنّني أتقنت الويتشات. أرأيت؟

275
00:20:27,620 --> 00:20:30,440
.كنت تتحدّث إلى التّينشي

276
00:20:31,140 --> 00:20:36,450
مذهل، لم أكن أعلم أن ريكوكين-ساما
.يملك التسوتينروكو

277
00:20:36,710 --> 00:20:40,540
.الوضع المحيط بالرّاتن تايشو تغيّر

278
00:20:40,540 --> 00:20:43,900
ألا تزال لا تريد المشاركة؟

279
00:20:43,900 --> 00:20:47,650
ألا تريد أن تعرف ما حدث حينها؟

280
00:20:48,280 --> 00:20:51,930
ألا يمكنك أن تخبرني؟

281
00:20:52,500 --> 00:20:54,440
.أنا آسف يا أويا

282
00:20:54,440 --> 00:20:57,420
.لا يمكنني

283
00:20:58,380 --> 00:21:01,100
.لا تعتذر أيّها المعلّم الكبير

284
00:21:01,630 --> 00:21:05,370
.فأنا لست مهتمًّا بمعرفة ما حدث في الماضي

285
00:21:05,960 --> 00:21:14,240
،أويا، يمكن للنّاس تغير المستقبل
.لكن لا يمكنهم تغيير القدر

286
00:21:15,290 --> 00:21:20,960
،قد يشعرون أنّ الأقدار تقيّدهم

287
00:21:21,510 --> 00:21:25,160
.لكن عليهم أن يتقبّلوا الأمر

288
00:21:26,010 --> 00:21:29,550
.أنت تملك إحدى القوى الثّمان

289
00:21:29,980 --> 00:21:36,100
.المشاركة في الرّاتن تايشو هو قدرك

290
00:21:37,690 --> 00:21:39,130
.سأفكّر في الأمر

291
00:23:11,300 --> 00:23:14,690
.أخي أويا، استيقظ

292
00:23:14,970 --> 00:23:17,330
.سيغضب منك المعلّم مرّة أخرى

293
00:23:17,900 --> 00:23:19,160
أخي؟

294
00:23:21,640 --> 00:23:24,100
!أخي! أنت تنزف

295
00:23:26,060 --> 00:23:29,070
...أخبر المعلّم الكبير

296
00:23:29,660 --> 00:23:34,090
.أنّني سأشارك في الرّاتن تايشو

297
00:23:35,060 --> 00:23:36,310
الحلقة القادمة