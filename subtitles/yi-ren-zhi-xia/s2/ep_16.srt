1
00:00:08,770 --> 00:00:09,730
.ريغيوكو

2
00:00:10,470 --> 00:00:15,120
.ورّطتُ العديد في هذا من أجل تشو سوران

3
00:00:15,540 --> 00:00:17,980
ألن تلومني؟

4
00:00:19,210 --> 00:00:22,670
.ما كنت لألومك أبدًا يا معلّمي

5
00:00:23,530 --> 00:00:28,880
،أنت حقًّا مثاليّ وبلا عيوب
.لكنّك جادّ أكثر من اللاّزم قليلاً

6
00:00:29,410 --> 00:00:33,790
لِمَ لا أعطيك نصيحة قبل مباراتك؟

7
00:00:34,240 --> 00:00:35,640
.اسمع جيّدًا

8
00:00:35,640 --> 00:00:39,360
.اذهب واهزم تشو سوران هزيمة نكراء

9
00:02:19,740 --> 00:02:32,670
!تُنشر مانغا "هيتوري نو شيتا: المنبوذ" في شونين جامب+ الآن

10
00:02:25,860 --> 00:02:31,040
من تظنّه سيفوز؟ ريغيوكو-ساما أم تشو سوران؟

11
00:02:31,890 --> 00:02:33,610
.الأمر لا يحتاج التّفكير

12
00:02:33,610 --> 00:02:37,590
على أيّ حال، أنا مندهش من تمكّن ذلك
.الوقح الغشّاش من الوصول إلى النّهائيّ

13
00:02:37,590 --> 00:02:40,700
أتساءل أيّ نوع من الخدع الدّنيئة
.سيستعمل هذه المرّة

14
00:02:41,420 --> 00:02:43,860
.ربّما سيقاتل ببسالة

15
00:02:43,860 --> 00:02:47,820
.لن يقع ريغيوكو-ساما ضحيّة خدع غبيّة

16
00:02:49,860 --> 00:02:52,760
هل هو هنا بالفعل؟

17
00:02:57,880 --> 00:02:59,250
.هذا ليس حلمًا

18
00:03:00,870 --> 00:03:04,020
.لا أصدّق أنّني وصلت إلى النّهائيّ حقًّا

19
00:03:06,600 --> 00:03:10,320
يدي ترتعش. هل أنا متحمّس؟

20
00:03:10,870 --> 00:03:14,830
أم هو التّرقّب؟ لا، الخوف؟

21
00:03:15,810 --> 00:03:17,670
.بالطّبع

22
00:03:18,400 --> 00:03:22,670
فأنا لن أتمكّن من هزيمة خصمي
.إلاّ باستعمال كلّ ما لديّ

23
00:03:23,930 --> 00:03:29,310
سيتوجّب عليّ استخدام القوّة الّتي كنت
.أخفيها حتّى الآن أمام كلّ هؤلاء النّاس

24
00:03:30,720 --> 00:03:34,610
.لقد أصبحت أقوى خلال الشّهر المنصرم

25
00:03:35,510 --> 00:03:38,000
لهذا اكتسبت حسًّا أقوى من ذي قبل

26
00:03:38,700 --> 00:03:40,570
.بقوّة ريغيوكو-ساما

27
00:03:41,090 --> 00:03:45,230
ماذا كان جو يون وجو سان
ليفكّرا لو كانا مكاني؟

28
00:03:45,820 --> 00:03:48,220
ماذا عن هو-ني؟

29
00:03:51,620 --> 00:03:55,300
.يا إلهي. أنا أبالغ في التّفكير بالأمر

30
00:03:57,110 --> 00:03:59,550
.لقد وجدت جوابي بالفعل

31
00:03:59,940 --> 00:04:02,450
.لا فائدة من القلق حيال الأمر بعد الآن

32
00:04:03,490 --> 00:04:07,150
.هو-ني قد لا تفكّر في شيء

33
00:04:07,760 --> 00:04:12,100
إنّها تملك الكثير من الخصائص
،الّتي لم أستوعبها في البداية

34
00:04:12,100 --> 00:04:14,470
لكنّني بدأت أفهم

35
00:04:15,140 --> 00:04:17,380
.مصدر قوّتها

36
00:04:18,750 --> 00:04:21,650
.إنّها تأكل وقت الأكل

37
00:04:22,010 --> 00:04:23,300
.تنام وقت النّوم

38
00:04:23,880 --> 00:04:26,070
.تقاتل وقت القتال

39
00:04:26,560 --> 00:04:30,150
.تستطيع هو-ني فعل شي واحد فقط في كلّ مرة

40
00:04:30,550 --> 00:04:33,050
.إنّها تفكّر في كلّ شيء على حدى

41
00:04:33,950 --> 00:04:36,920
.إنّها قوية لأنّها نقيّة

42
00:04:37,570 --> 00:04:43,710
ريغيوكو-ساما، اليوغوراي خاصّتي قويّة
.ما يكفي لإلغاء الإينغوراي الخاصّ بك

43
00:04:44,390 --> 00:04:48,240
.لكنّني لا أزال أضعف بكثير أساسًا

44
00:04:49,230 --> 00:04:53,350
...القوّة الغامرة والتّحرّكات الخارقة

45
00:04:54,030 --> 00:04:55,940
.ريغيوكو-ساما قويّ

46
00:04:56,380 --> 00:04:58,890
.وكذلك شوكاتسو سي وأويا-سان

47
00:04:59,370 --> 00:05:03,960
.لا يمكنني إيقاف الوحوش الّتي أمامي من التّطوّر

48
00:05:06,420 --> 00:05:08,400
.لا تفكّر في خصمك

49
00:05:08,880 --> 00:05:12,010
.الشّيء الوحيد الّذي يمكنك التّحكّم فيه هو نفسك

50
00:05:13,010 --> 00:05:16,790
.اقترب ما استطع من نقاء هو-ني

51
00:05:17,460 --> 00:05:18,630
.هذا صحيح

52
00:05:18,630 --> 00:05:21,570
الشّخص الّذي يقف أمامي الآن هو نسخة من نفسي

53
00:05:22,200 --> 00:05:24,720
.تخطّت حدودي

54
00:05:26,280 --> 00:05:31,130
!سأتخطّى حدودي وأصبح أقوى من ذي قبل

55
00:05:39,280 --> 00:05:40,680
!شوشينراي

56
00:05:52,350 --> 00:05:54,550
.مذهل يا تشو سوران

57
00:05:54,550 --> 00:05:58,760
.أنت شخص مختلف كلّيًّا اليوم

58
00:05:59,240 --> 00:06:03,560
هل قرّرت أن تظهر قوّتك الحقيقيّة
بما أنّك محاصر الآن؟

59
00:06:04,330 --> 00:06:10,210
ريغيوكو-ساما، التّقنية الّتي أنا على وشك
.استخدامها طوّرتها بنفسي

60
00:06:10,790 --> 00:06:14,300
لكنّها ليست مستقرّة بعد، لذا يمكنني
.استعمالها لخمس دقائق فقط

61
00:06:14,780 --> 00:06:16,950
.لا تقلق بشأن ذلك

62
00:06:16,950 --> 00:06:20,150
.لن أستغرق خمس دقائق لهزيمتك

63
00:06:20,670 --> 00:06:22,370
حقًّا؟

64
00:06:22,790 --> 00:06:23,850
!جينراي

65
00:07:01,310 --> 00:07:04,830
.عجبًا. لقد جاريتَ سرعتي

66
00:07:04,830 --> 00:07:10,100
وجّهت الشّوشينراي خاصّتك إلى الدّاخل
.لتنشيط قنوات الطّول خاصّتك

67
00:07:10,100 --> 00:07:12,150
.فكرة جيّدة

68
00:07:12,560 --> 00:07:13,800
جاريت؟

69
00:07:14,450 --> 00:07:16,920
!لا، أنت مخطئ

70
00:07:21,440 --> 00:07:23,850
!هذه أقصى قوّة للجينراي خاصّتي

71
00:07:32,490 --> 00:07:34,730
.ضربة مذهلة

72
00:07:34,730 --> 00:07:38,460
.اليوغوراي بداخل جسدي هائج للغاية

73
00:07:38,930 --> 00:07:39,650
...لكن

74
00:07:47,940 --> 00:07:51,120
ما هذا الشّعور الغريب؟

75
00:07:52,030 --> 00:07:56,270
.إنّه رطب ودبق وثقيل

76
00:07:57,190 --> 00:08:00,430
.وكأنّ عظامي ولحمي تذوب

77
00:08:01,300 --> 00:08:03,950
أهذه سويزوراي؟

78
00:08:04,880 --> 00:08:07,470
أهذا ما أخبرني به جدّي؟

79
00:08:08,890 --> 00:08:11,820
.جدّي، تعلّمت التّحكّم بشينكي وهايكي

80
00:08:11,820 --> 00:08:14,580
.نوعان من الكي

81
00:08:15,200 --> 00:08:22,390
إن تعلّمت استخدام جينكي
وكانكي أيضًا، فهل سأصبح أقوى؟

82
00:08:24,050 --> 00:08:26,780
.تفكير جيّد يا سوران

83
00:08:26,780 --> 00:08:31,700
لكن بما أنّك تعلّمت التّحكّم
،بشينكي وهايكي الآن

84
00:08:31,700 --> 00:08:36,830
.لا يمكنك تعلّم قوى جينكي وكانكي بعد الآن

85
00:08:37,160 --> 00:08:39,460
لِمَ لا؟

86
00:08:39,460 --> 00:08:42,940
.لقد أصبحت قردًا

87
00:08:43,350 --> 00:08:44,320
قرد؟

88
00:08:44,320 --> 00:08:46,490
من هو القرد؟

89
00:08:47,510 --> 00:08:49,970
.انس أمر جينكي وكانكي

90
00:08:50,730 --> 00:08:54,670
.من المستحيل أن تتعلّمهما بمستواك الحاليّ

91
00:08:54,670 --> 00:08:58,200
.أو بالأحرى، لا يجب عليك ذلك

92
00:08:59,540 --> 00:09:03,900
هل تذكر الحيوانات الّتي تُقابل
أنواع الكي الخمسة؟

93
00:09:04,150 --> 00:09:06,180
.نعم، أذكرها

94
00:09:06,580 --> 00:09:09,990
أيّ الحيوانات توافق شينكي وهايكي إذًا؟

95
00:09:11,610 --> 00:09:12,600
.القرد

96
00:09:12,970 --> 00:09:14,800
.هذا صحيح

97
00:09:14,800 --> 00:09:18,920
قارَن أسلافنا شينكي وهايكي المرتكزان على يوكي

98
00:09:18,920 --> 00:09:22,910
.بقرد وُلد من النّار

99
00:09:22,910 --> 00:09:29,910
لهذا السّبب نعتّك بالقرد بما أنّك
.تعلّمت التّحكّم باليوكي خاصّتك

100
00:09:30,800 --> 00:09:36,380
.الشّينكي عبارة عن وثب وقفز، مثل القلب

101
00:09:36,910 --> 00:09:42,710
.وعلى ذلك القرد أن يجتهد لتحقيق العدم

102
00:09:42,710 --> 00:09:45,300
.بمعنى آخر، مثل ووكونغ

103
00:09:46,810 --> 00:09:51,260
.ما زلت بعيدًا عن ذلك

104
00:09:52,430 --> 00:09:56,300
.ولليوكي عدوّ طبيعيّ

105
00:09:56,300 --> 00:10:00,320
.الإينكي التّابع لجينكي وكانكي

106
00:10:00,710 --> 00:10:05,650
.الحيوان الّذي يقابل الإينكي هو الخنزير البرّيّ

107
00:10:06,200 --> 00:10:11,100
.هذا الخنزير يترأّس مختلف رغبات البشريّة

108
00:10:11,710 --> 00:10:15,590
.المال والسّلطة والشّهيّة والشّهوة

109
00:10:16,100 --> 00:10:19,710
،لذا لكي نُخضِع هذا الخنزير

110
00:10:20,000 --> 00:10:22,100
.عليك أن تضع قيودًا على نفسك

111
00:10:22,500 --> 00:10:25,810
.تخلّ عن رغباتك واتّبع القوانين

112
00:10:25,810 --> 00:10:28,470
.بمعنى آخر، مثل باجي

113
00:10:28,770 --> 00:10:33,400
لكن مع ذلك عليك ألاّ تفترض
.أن جميع الرّغبات البشريّة شرّيرة

114
00:10:34,330 --> 00:10:40,280
.معرفة الفرق بين الخير والشّرّ هي هدف الخنزير

115
00:10:41,030 --> 00:10:46,780
ما هو هيكي إذًا؟ النّوع المتبقّي من الكي؟

116
00:10:47,150 --> 00:10:55,170
هيكي الّذي يقع تحت عنصر الأرض
.عبارة عن كي هادئ

117
00:10:55,170 --> 00:10:56,350
،بمعنى آخر

118
00:10:56,350 --> 00:10:59,250
.مثل شا ووجين

119
00:10:59,250 --> 00:11:01,820
،عندما يتنازع السّلبيّ والإيجابيّ

120
00:11:01,820 --> 00:11:04,840
.يصبح دوره التّوسّط بين الاثنين

121
00:11:05,490 --> 00:11:07,800
.تذكّر هذا يا سوران

122
00:11:08,320 --> 00:11:13,350
.عليك ألاّ توقظ خنزير الإينكي أبدًا

123
00:11:13,350 --> 00:11:17,120
.إن اهتاج الإينكي خاصّتك، سيتعطّل اليوكي خاصّتك

124
00:11:17,120 --> 00:11:21,990
.وسيكون تدريبك حتّى الآن من دون فائدة

125
00:11:21,990 --> 00:11:25,290
.القرد والخنزير متعارضان

126
00:11:25,290 --> 00:11:29,030
.لا يمكنهما أن يتواجدا معًا أبدًا

127
00:11:30,640 --> 00:11:34,250
.هذا صحيح. هذا ما أخبرني به جدّي

128
00:11:38,180 --> 00:11:39,860
...يوغوراي

129
00:11:39,860 --> 00:11:43,680
.القوّة الإيجابيّة الّتي تعارض قوّتي

130
00:11:54,170 --> 00:12:00,600
.جدّي، فهمت أخيرًا القوّة السّلبيّة الآن

131
00:12:27,980 --> 00:12:31,600
.يبدو هادئًا مع أنّني أبعدت السّويزوراي خاصّته

132
00:12:32,520 --> 00:12:33,710
.تشو سوران

133
00:12:34,210 --> 00:12:37,870
ما رأيك في السّويزوراي خاصّتي؟

134
00:12:38,230 --> 00:12:42,190
.خرجت قوّة الحياة هذه من داخل جسدي

135
00:12:42,700 --> 00:12:45,770
.إنّها دليل على عدم نقائي

136
00:12:46,180 --> 00:12:51,300
قد لا يكون تدفّق قوّة الحياة بالنّسبة
.لشخص عاديّ خارج جسده أمرًا مهمًّا

137
00:12:51,710 --> 00:12:55,700
.لكن عندما كنت صغيرًا، التحقت بمعبد

138
00:12:55,700 --> 00:12:59,720
.وتدرّبت كراهب

139
00:12:59,720 --> 00:13:05,000
.لكنّني تخلّيت عن نقائي بكلّ سهولة

140
00:13:05,340 --> 00:13:06,080
ماذا؟

141
00:13:06,080 --> 00:13:10,010
إشاعات امتلاك ريغيوكو-ساما
لحبيبة كانت صحيحة إذًا؟

142
00:13:10,010 --> 00:13:12,300
.لكنّه يبدو كراهب جادّ

143
00:13:12,300 --> 00:13:14,730
من كانت؟

144
00:13:14,730 --> 00:13:16,890
!هذا كابوس

145
00:13:17,440 --> 00:13:22,540
.هذا السّويزوراي القبيح هو ذنبي

146
00:13:22,540 --> 00:13:29,230
.لكن بدل مواجهة ذنبي، كذبت على نفسي

147
00:13:29,840 --> 00:13:34,090
.لدرجة أنّني ألقيت بغضبي عليك لأنّك كنت نقيًّا

148
00:13:35,450 --> 00:13:39,420
عندما علمت أنّ معلّمي كان يحاول
،أن يجعلك تلميذًا له

149
00:13:39,420 --> 00:13:42,630
.صرت أكرهك حقًّا

150
00:13:43,270 --> 00:13:50,210
وعندما علمت أنّك مؤهّل لخلافة
.التّينشي، حسدتك

151
00:13:53,160 --> 00:13:56,600
.تشو سوران، أنا آسف

152
00:13:57,260 --> 00:14:02,500
عاملتك بشكل سيّئ حتّى الآن
.لأنّني لم أكن ناضجًا

153
00:14:10,610 --> 00:14:13,410
.لا أقبل اعتذارك

154
00:14:15,390 --> 00:14:18,030
وضع الغير أفضل دائمًا، صحيح؟

155
00:14:18,470 --> 00:14:21,350
.لا أصدّق أنّك كنت قلقًا بشأن ذلك

156
00:14:22,380 --> 00:14:24,780
.لننهِ الأمر

157
00:14:25,280 --> 00:14:28,230
،يبدو أنّك بذلت الكثير من الطّاقة

158
00:14:28,230 --> 00:14:32,870
لكن يبدو أنّني أرهقت نفسي هربًا
.من السّويزوراي خاصّتك

159
00:14:33,720 --> 00:14:38,400
،بما أنّك كشفت لي عمّا في صدرك
.سأخبرك شيئًا أيضًا

160
00:14:38,400 --> 00:14:41,560
.عليك أن تغشّ أكثر يا ريغيوكو-ساما

161
00:14:46,310 --> 00:14:49,830
هل فكّرت في أن تكون صريحًا أكثر؟

162
00:15:52,840 --> 00:15:54,350
...مستحيل

163
00:15:54,350 --> 00:15:57,100
أهذا هو ذلك الوقح الغشاش؟

164
00:15:57,680 --> 00:16:00,640
أهذه هي قوّة سوران الحقيقيّة؟

165
00:16:01,500 --> 00:16:05,070
أبي، منذ متى وأنت تعرف طبيعته الحقيقيّة؟

166
00:16:05,600 --> 00:16:08,750
لِمَ تبالغون دائمًا؟

167
00:16:09,920 --> 00:16:14,670
لِمَ تفترضون أنّ سلوكه حتّى الآن
كان استعراضًا فحسب؟

168
00:16:15,240 --> 00:16:18,640
تشو سوران الّذي تنادونه بالوقح

169
00:16:19,170 --> 00:16:25,120
هو تشو سوران نفسه الّذي يقاتل
.تشو ريغيوكو بنزاهة الآن

170
00:16:25,120 --> 00:16:26,480
...لكن

171
00:16:26,480 --> 00:16:32,080
.لم أظنّ أبدًا أنّ سوران-كن كان يدّعي

172
00:16:32,660 --> 00:16:38,510
.لم يحاول أبدًا إخفاء جبنه ودناءته ووقاحته

173
00:16:38,760 --> 00:16:42,990
.افترض الجميع أنّ ذلك الجانب هو كلّ ما لديه

174
00:16:44,130 --> 00:16:46,550
.هذا تمامًا ما أراده على الأرجح

175
00:16:47,290 --> 00:16:48,640
.انظر حولك

176
00:16:49,670 --> 00:16:53,760
،بالكاد يعتبره أحد هنا تشو سوران

177
00:16:53,760 --> 00:16:58,540
.وريث فنّ كيتايغين الغامض السّرّيّ

178
00:16:59,010 --> 00:17:04,460
.لم يعد أحد يكترث ما إن كان الوريث بالفعل

179
00:17:05,320 --> 00:17:12,510
.يعلم تمامًا ما يحتاجه وما عليه التّخلّي عنه

180
00:17:13,060 --> 00:17:16,580
.ولديه القدرة على تحقيق ذلك

181
00:17:17,230 --> 00:17:21,610
.الصّبر والشّجاعة وقوّة العزيمة

182
00:17:21,610 --> 00:17:23,770
.هذا ما شدّني

183
00:17:24,510 --> 00:17:27,440
.لا يبدو أنّ سوران يمتلك كلّ تلك الصّفات

184
00:17:27,440 --> 00:17:30,760
،شينتون، عند حكمك على أحد ما

185
00:17:30,760 --> 00:17:35,120
.عليك أن تحكم عليهم استنادًا لأفعالهم، لا أقوالهم

186
00:17:35,790 --> 00:17:40,740
هل تذكر أوّل مرّة اشتريت لك فيها
حاسوبًا شخصيًّا؟

187
00:17:42,550 --> 00:17:44,610
عندما كنت في التّاسعة قلت

188
00:17:44,610 --> 00:17:47,480
إنّك لم تعد تريد استعارة حاسوب أختك

189
00:17:47,480 --> 00:17:50,340
.وأردت حاسوبًا خاصًّا بك

190
00:17:50,340 --> 00:17:54,970
حينها، كانت أسنانك تعاني من التّسوّس
.بسبب أكل الكثير من الحلوى

191
00:17:55,580 --> 00:17:57,540
حينها قلت لك

192
00:17:58,320 --> 00:18:02,350
إنّني سأشتري لك حاسوبًا إن توقّفت
.عن أكل الحلوى لأسبوع

193
00:18:03,430 --> 00:18:08,090
.وفي النّهاية استسلمت وأكلتها في اليوم الثّاني

194
00:18:10,160 --> 00:18:12,760
.لكنّك اشتريت لي حاسوبًا

195
00:18:12,760 --> 00:18:15,440
ما علاقة هذا بسوران؟

196
00:18:16,030 --> 00:18:21,580
،لم تكن صبورًا عندما كنت في التّاسعة
.لكنّ سوران-كن مختلف

197
00:18:21,880 --> 00:18:26,060
مذ ظهر سوران-كن في عالم
،الدّخلاء قبل بضعة أشهر

198
00:18:26,060 --> 00:18:28,700
.فعلنا الكثير للبحث في أمره

199
00:18:29,470 --> 00:18:36,540
لم نجد الكثير، لكنّكم فشلتم
.في رؤية السّرّ خلف ذلك

200
00:18:37,070 --> 00:18:40,880
،منذ أن مات تشو شاكورين
وضعت شركة التّوصيل السّريع

201
00:18:40,880 --> 00:18:43,170
.سوران-كن نصب أعينها

202
00:18:43,670 --> 00:18:47,040
،إلى أن لاحظت زينسي وجود سوران-كن

203
00:18:47,040 --> 00:18:51,010
.ظنّوا أنّه شخص عاديّ وليس دخيلاً

204
00:18:52,080 --> 00:18:55,750
لكنّ شركة التّوصيل السّريع
.لم تحكم عليه بتسرّع

205
00:18:56,810 --> 00:19:00,860
،مع أنّهم بقوا بعيدين

206
00:19:00,860 --> 00:19:04,670
إلاّ أنّني واثق أنّهم حقّقوا في أمره
.بعناية وخلال فترة طويلة

207
00:19:05,570 --> 00:19:09,100
إن كنت محقًّا، فقد تخلّى سوران-كن

208
00:19:09,100 --> 00:19:14,670
عمّا علّمه تشو شاكورين وعاش كشخصٍ عاديّ

209
00:19:15,020 --> 00:19:18,490
كي يخدع شركة التّوصيل السّريع
.لأكثر من عشر سنوات

210
00:19:19,750 --> 00:19:23,420
ما رأيك؟ هل أدركت مدى رعبه الآن؟

211
00:19:25,040 --> 00:19:30,710
نعم، الرّجل الّذي يواجه
تشو ريغيوكو أمامك الآن

212
00:19:31,780 --> 00:19:34,470
.لديه ثغرة تفوق العشر سنوات في تاريخه

213
00:19:35,970 --> 00:19:37,850
!سويزو يوِينراي

214
00:19:37,850 --> 00:19:39,430
!كوموشين الأبيض

215
00:19:41,840 --> 00:19:43,740
مـ-ما هذا؟

216
00:19:46,630 --> 00:19:50,600
.جسدي يحترق من الدّاخل

217
00:19:51,570 --> 00:19:55,830
.تبًّا. أشعر أن عظامي تتجمّد كليًّا

218
00:19:56,290 --> 00:19:59,470
.هذه القوّة تناقض قوّتي

219
00:19:59,890 --> 00:20:03,130
.تشو سوران، يبدو أنّك تفهم الآن أيضًا

220
00:20:03,450 --> 00:20:07,820
.نعم. تقنياتنا تبطل بعضها

221
00:20:07,820 --> 00:20:10,090
.إنّها متعاكسة

222
00:20:10,550 --> 00:20:13,140
.هذا القتال مسابقة تحمّل

223
00:20:13,480 --> 00:20:16,830
.لكنّني اقتربت من حدودي

224
00:20:16,830 --> 00:20:20,290
هلاّ تركتني أهاجم أوّلاً يا ريغيوكو-ساما؟

225
00:20:21,060 --> 00:20:23,690
.لا بأس. هاجم أوّلاً

226
00:20:23,690 --> 00:20:25,280
.حسنًا

227
00:20:25,280 --> 00:20:27,370
!هذا هجومي الأخير

228
00:20:37,010 --> 00:20:38,930
!ناغاموشي الأبيض

229
00:20:39,810 --> 00:20:41,010
!هيا

230
00:20:42,840 --> 00:20:43,680
.إنّه سريع

231
00:20:58,030 --> 00:21:00,920
يوغوراي يمكن التّحكّم فيه عن بعد؟

232
00:21:07,430 --> 00:21:09,420
.فهمت لم هذا الهجوم هو ورقته الرّابحة

233
00:21:09,420 --> 00:21:10,940
.إنّها تقنية يصعب التّعامل معها

234
00:21:26,560 --> 00:21:31,030
،مهما كانت ردود أفعالك سريعة
.لن تتصرّف في الوقت المناسب

235
00:21:35,980 --> 00:21:36,890
ماذا؟

236
00:21:38,160 --> 00:21:42,350
صحيح أنّني أستطيع التّحكّم
.بناغاموشي الأبيض عن بعد

237
00:21:42,900 --> 00:21:47,370
.لكنّ قوّتها الحقيقيّة تكمن في تتبّعها لخصومي

238
00:21:48,290 --> 00:21:51,780
!ولا تدع فريستها تهرب أبدًا

239
00:23:26,000 --> 00:23:28,620
هزمت ريغيوكو-ساما، صحيح؟

240
00:23:26,010 --> 00:23:27,260
الحلقة القادمة

241
00:23:28,620 --> 00:23:30,730
ما يعني أنّ فصل راتن تايشو قد انتهى؟

242
00:23:30,730 --> 00:23:33,760
.هذا صحيح. سيبدأ فصل زينسي الحلقة القادمة

243
00:23:33,760 --> 00:23:35,380
مهلاً، ما الّذي سيحدث؟

244
00:23:35,380 --> 00:23:37,960
:"في الحلقة القادمة من "هيتوري نو شيتا
."طرد الأرواح"

245
00:23:37,960 --> 00:23:39,290
.سأدفنكم إن لم تشاهدوها