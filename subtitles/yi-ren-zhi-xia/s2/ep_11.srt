1
00:00:10,310 --> 00:00:12,310
!كيمون كينزو شينبو

2
00:00:14,010 --> 00:00:19,980
سأرى بعينيّ الحقيقة المخبّأة
.وراء الكيمون تونكو الخاصّ بك

3
00:02:00,590 --> 00:02:02,420
.هيا يا أويا

4
00:02:02,420 --> 00:02:05,320
.سأكتشف حقيقة كيمون تونكو خاصّتك

5
00:02:17,770 --> 00:02:20,230
...سي-ني، توقّف

6
00:02:20,500 --> 00:02:21,910
!كان سويدان

7
00:02:31,630 --> 00:02:34,670
ما الّذي فعلته لي؟

8
00:02:43,220 --> 00:02:45,520
.أعقت نقطة الضّغط الّتي في صدرك

9
00:02:45,880 --> 00:02:46,860
.استسلم فحسب

10
00:02:55,760 --> 00:02:59,500
حتّى كيمون كينزو شينبو خاصّتي
.لن يسمح لي برؤية طريقة عمله

11
00:03:00,290 --> 00:03:01,810
.ما باليد حيلة إذًا

12
00:03:04,520 --> 00:03:06,830
—كان عليك الانسحاب عندما بد

13
00:03:07,960 --> 00:03:10,070
هل تحاول تكهّن تقنيتي؟

14
00:03:10,070 --> 00:03:11,990
!توقّف يا شوكاتسو سي

15
00:03:15,390 --> 00:03:16,660
...سي-ني

16
00:03:28,900 --> 00:03:31,310
!لا تكن غبيًّا

17
00:03:32,260 --> 00:03:35,470
.لقد تكهّنت فنّك السّرّيّ

18
00:03:36,070 --> 00:03:38,630
.لكنّني لم أتوقّع أن ينتهي الأمر بهذا السّوء

19
00:03:40,370 --> 00:03:44,600
.ليس وكأنّني لا أستطيع تقبّل الهزيمة

20
00:03:46,290 --> 00:03:51,650
لكن لا يمكنني أن أخسر دون
.اكتشاف الحقيقة فحسب

21
00:03:51,650 --> 00:03:54,050
.ليس دون أن أفهم فنونك السّرّيّة

22
00:03:58,210 --> 00:04:00,630
!يا لها من كلمات بذيئة

23
00:04:00,630 --> 00:04:03,620
!أنا آسف أيّها المعلّم الكبير! أنا آسف

24
00:04:03,620 --> 00:04:07,540
كيف تجرؤ على إرغام راهب محترم
!على التّفوّه بأشياء بذيئة؟

25
00:04:07,540 --> 00:04:09,020
...أ-أنت

26
00:04:10,050 --> 00:04:14,860
انس الأمر. ما كان عليّ المجيء
.إلى هنا أساسًا

27
00:04:17,230 --> 00:04:20,110
.انتهت حياتي الهادئة الآن

28
00:04:20,800 --> 00:04:25,010
شوكاتسو سي، ما زلت تستعمل
كيمون كينزو شينبو، أليس كذلك؟

29
00:04:25,010 --> 00:04:27,320
.ألق نظرة أخرى بعينيك

30
00:04:33,870 --> 00:04:38,530
لِمَ تركّز عليّ فقط وأنت تعلم
أنّني متقن أساليب؟

31
00:04:38,900 --> 00:04:40,880
.انظر جيّدًا إلى بوصلتي التّكهّنيّة

32
00:04:50,110 --> 00:04:52,440
...هذه بوصلة تكهّنيّة عاديّة

33
00:04:52,760 --> 00:04:53,430
!لا

34
00:04:57,610 --> 00:04:59,190
هل فهمت الآن؟

35
00:04:59,190 --> 00:05:02,160
إنّها ليست مثل أيّ كيمون تونكو عاديّة
تُستعمل لتكهّن الحظّ الجيّد أو العاثر

36
00:05:02,160 --> 00:05:04,080
.استنادًا إلى اتّجاه شيء ما

37
00:05:05,050 --> 00:05:08,340
.على هذه البوصلة التّكهّنيّة، أنا الاتّجاهات

38
00:05:08,340 --> 00:05:10,100
.أنا الحظّ الجيّد والعاثر

39
00:05:10,450 --> 00:05:15,860
.الوقت والمكان وعناصر تقنياتي أنا من أحدّدها

40
00:05:15,860 --> 00:05:19,240
لديك تحكّم كامل ببنية بوصلتك التّكهّنيّة؟

41
00:05:19,240 --> 00:05:22,250
.ينبغي أن يكون شيء غير منطقي كهذا مستحيلاً

42
00:05:22,620 --> 00:05:25,280
.البوصلات التّكهّنيّة يحكمها الوقت

43
00:05:25,770 --> 00:05:27,620
لذا تفترض أنّني لا أستطيع؟

44
00:05:27,960 --> 00:05:31,900
.الوقت ليس سوى طريقة لقياس تغيّرات الأشياء

45
00:05:32,600 --> 00:05:36,970
.تحكّم في الوقت وستتمكّن من التّحكّم في التّغيير

46
00:05:37,500 --> 00:05:41,240
تغيّرت الجاذبيّة هنا للتّوّ. إنّها الآن
.مختلفة عن الّتي خارج بوصلتي

47
00:05:42,540 --> 00:05:46,100
.ستستغرق هنا هذه الحصاة دقيقة لتسقط

48
00:05:46,380 --> 00:05:50,890
قلت أنّ متقني الأساليب يتجنّبون الحظّ
.العاثر ويسعون إلى الحظّ الجيّد

49
00:05:51,490 --> 00:05:53,960
بهذا السّلوك، لن تنجز أبدًا

50
00:05:53,960 --> 00:05:57,330
.ما فعله جدّك شوكاتسو كومي

51
00:05:57,880 --> 00:06:02,090
.كان يعرف على أنّه أعظم متقن أساليب

52
00:06:02,090 --> 00:06:05,850
.لا بدّ أنّه علم أنّ عائلة شو هان الملكيّة ستسقط

53
00:06:06,250 --> 00:06:09,770
،لكنّه تخلّى عن قضيّة متقني الأساليب

54
00:06:09,770 --> 00:06:13,300
.وقاوم تلك الأوقات ورمى بنفسه وسط النّزاع

55
00:06:13,800 --> 00:06:16,980
.كلّ ذلك لإنقاذ عالم لم يكن بالإمكان إنقاذه

56
00:06:18,390 --> 00:06:20,640
،مع أنّه علم أنّ ذلك مستحيل

57
00:06:20,640 --> 00:06:24,380
.اختار أن يقاتل السّماء من أجل النّاس

58
00:06:24,930 --> 00:06:29,510
ذلك هو الطّريق الّذي على متقن
.الأساليب العظيم اتّباعه

59
00:06:30,120 --> 00:06:33,390
إن تجنّبت الحظّ العاثر وسعيت
،إلى الحظّ الجيّد فقط

60
00:06:33,390 --> 00:06:38,410
،وبقت مقيّدًا بقوانين السّماء واتّبعت التّيّار

61
00:06:38,410 --> 00:06:41,030
.فلا معنى لفهم المنطق

62
00:06:41,950 --> 00:06:47,110
،حتّى وإن فهمت قوانين كلّ الأشياء
،إن كنت مقيّدًا بها

63
00:06:47,110 --> 00:06:49,320
.فلن تكون مختلفًا عن أيّ شخصٍ عاديّ

64
00:06:55,560 --> 00:06:58,310
.ما زال لديّ الكثير لأتعلّمه

65
00:07:01,350 --> 00:07:04,240
.أويا-دونو، أعترف بالهزيمة

66
00:07:05,250 --> 00:07:07,270
!أويا هو الفائز

67
00:07:09,160 --> 00:07:13,380
لم أظنّ أبدًا أنّ مستعمل كيمون تونكو
الخاصّة بأسلوب بوكو شوكاتسو سي

68
00:07:13,380 --> 00:07:15,540
.قد يعترف بالهزيمة بهذه السّهولة

69
00:07:15,960 --> 00:07:19,160
من يكون أويا ذاك بالضّبط؟

70
00:07:20,010 --> 00:07:24,120
ريكوكين، أنت تعرف الاسم "فوكو"، صحيح؟

71
00:07:24,610 --> 00:07:29,330
.المخطّط الأسطوريّ الّذي خلق كيمون تونكو

72
00:07:29,590 --> 00:07:33,280
.أويا-دونا، هناك شيء أودّ أن أسألك إيّاه

73
00:07:34,850 --> 00:07:37,210
ما اسم كيمون تونكو خاصّتك؟

74
00:07:39,360 --> 00:07:41,650
.تحدّثنا ما يكفي بالفعل

75
00:07:41,650 --> 00:07:45,020
.إن لم تقتنع بعد، فتكهّن بنفسك

76
00:07:48,450 --> 00:07:51,640
في المرّة المقبلة الّتي تكون فيها
.على شفا الموت، لن أوقفك

77
00:07:53,130 --> 00:07:58,110
لكن لا ينبغي أن يكون هناك كيمون تونكو
.يمكنها التّغلّب على أسلوب بوكو

78
00:07:58,810 --> 00:08:03,540
أسلوب بوكو ليس سوى أسلوب
.واحد لكيمون تونكو

79
00:08:03,540 --> 00:08:05,740
...أمّا بالنّسبة لمصدر كيمون تونكو

80
00:08:05,740 --> 00:08:08,860
.فلا أحد رآه أبدًا

81
00:08:08,860 --> 00:08:11,340
:أحد الفنون السّرّيّة الثّمانية

82
00:08:11,340 --> 00:08:14,550
."اسمه "فوكو كيمون

83
00:08:19,190 --> 00:08:22,900
!المباراة التّالية، فو ساين ضدّ جا سيريان

84
00:08:23,970 --> 00:08:27,790
.ساين، لم أنضمّ إلى الشّيوخ العشرة إلاّ مؤخّرًا

85
00:08:27,790 --> 00:08:31,030
.الآخرون لا يحترمون عائلة فو

86
00:08:31,030 --> 00:08:35,080
،أنا واثق أنّك تريدين أن تريهم كرامة عائلة فو

87
00:08:35,080 --> 00:08:38,590
.لكن حاولي التّساهل مع جا سيريان

88
00:08:39,280 --> 00:08:41,320
.فهناك حادثة أخيه أيضًا

89
00:08:41,320 --> 00:08:43,480
.لا أريد معاداة عائلة جا أكثر من هذا

90
00:08:44,080 --> 00:08:46,940
.أعلم يا أبي

91
00:08:48,450 --> 00:08:51,430
!ستبدأ المباراة الآن

92
00:08:52,540 --> 00:08:54,190
.بربك يا أمّي

93
00:08:54,190 --> 00:08:56,810
.فكّرت أنّ من الغريب ألاّ تتّصلي ليوم كامل

94
00:08:56,810 --> 00:08:59,550
لِمَ عليك الاتّصال الآن بالضّبط؟

95
00:09:00,310 --> 00:09:04,520
.أجل، أجل. أنا آكل كلّ خضاري يوميًّا

96
00:09:04,520 --> 00:09:07,100
المعذرة... هل يمكننا أن نبدأ؟

97
00:09:07,100 --> 00:09:09,640
.قلت لك أنّني لا آكل اللّحم فقط

98
00:09:09,640 --> 00:09:13,130
.يا إلهي، لم أعد طفلاً

99
00:09:13,130 --> 00:09:15,830
.أنظّف أسناني ثلاث مرّات في اليوم أيضًا

100
00:09:20,650 --> 00:09:22,700
.سألت إن كان بإمكاننا البدء

101
00:09:23,770 --> 00:09:26,660
كيف أمكنك فعل ذلك؟

102
00:09:26,930 --> 00:09:29,090
.لقد كسرت هاتفي

103
00:09:29,360 --> 00:09:32,250
!ستقلق أمّي لأنّ الاتّصال انقطع فجأة

104
00:09:32,250 --> 00:09:36,630
!ستظنّ أنّني أخفي شيئًا أو وقعت في ورطة ما

105
00:09:36,630 --> 00:09:38,890
!إنّها على الأرجح تتّصل بالشّرطة الآن

106
00:09:38,890 --> 00:09:41,420
.لذا دعيني أستعير هاتفك

107
00:09:41,660 --> 00:09:42,700
هل أنت غبيّ؟

108
00:09:42,700 --> 00:09:45,990
أيّ غبيّ يحضر هاتفه إلى مباراة؟

109
00:09:46,500 --> 00:09:48,290
!أحدكم

110
00:09:48,290 --> 00:09:50,020
!دعوني أستعير هاتفًا منكم

111
00:09:50,400 --> 00:09:51,650
.استخدم هذا

112
00:09:52,980 --> 00:09:54,890
.أنا مدين لك أيّها العجوز

113
00:09:54,890 --> 00:09:55,950
.لا بأس

114
00:09:58,850 --> 00:10:01,330
.أمّي، هذا أنا

115
00:10:01,330 --> 00:10:03,060
.لا تقلقي. لم يحدث شيء

116
00:10:03,060 --> 00:10:04,980
.أسقطت هاتفي فحسب

117
00:10:05,400 --> 00:10:07,510
ماذا؟ ألم نتحدّث ما يكفي؟

118
00:10:07,510 --> 00:10:10,300
.خصمي تنتظرني الآن

119
00:10:10,740 --> 00:10:12,080
.أجل، فتاة

120
00:10:12,430 --> 00:10:14,910
.تبدو قويّة جدًّا

121
00:10:14,910 --> 00:10:17,050
ماذا؟ تريدين التّحدّث إليها؟

122
00:10:17,050 --> 00:10:18,500
!لا يمكن

123
00:10:19,530 --> 00:10:21,270
.يا إلهي، أنت لا تصمتين أبدًا

124
00:10:22,750 --> 00:10:24,970
.تريد أمّي التّحدّث إليك

125
00:10:25,820 --> 00:10:29,100
مرحبًا؟ هل هذه والدة سيريان-كن؟

126
00:10:31,370 --> 00:10:36,220
.نعم. الأولاد لا ينضجون أبدًا

127
00:10:36,220 --> 00:10:40,710
.نعم، كانت تلك نيّتي من البداية. لا تقلقي

128
00:10:40,710 --> 00:10:42,700
.لا، على الرّحب والسّعة

129
00:10:44,600 --> 00:10:47,520
.قالت لي أن أهزمك وأرسلك إلى المنزل

130
00:10:48,380 --> 00:10:51,940
!كنت ستقاتل تلك الآنسة الفاتنة؟

131
00:10:51,940 --> 00:10:54,240
!دعها تضربك وعد إلى المنزل بسرعة

132
00:10:54,240 --> 00:10:56,660
!ابنة عمدة القرية تنتظرك

133
00:10:56,660 --> 00:10:57,250
هل فهمت؟

134
00:10:59,450 --> 00:11:00,800
هل يمكننا أن نبدأ الآن؟

135
00:11:01,400 --> 00:11:02,470
.نعم

136
00:11:09,850 --> 00:11:11,020
تفادتها؟

137
00:11:13,040 --> 00:11:14,360
الانتقال المكانيّ؟

138
00:11:14,800 --> 00:11:16,840
أهذا ما فعلته بقبضتيها قبل قليل؟

139
00:11:17,460 --> 00:11:20,280
.يمكن لأيّ منهما الفوز بهذه المباراة

140
00:11:20,280 --> 00:11:25,480
لكن ليس وكأنّني لا أملك فرصة
.لهزيمة أيّ منهما

141
00:11:26,560 --> 00:11:29,240
هو-ني، هل ستتمكّنين من الالتزام بالخطّة؟

142
00:11:30,450 --> 00:11:31,610
.لا مشكلة

143
00:11:31,610 --> 00:11:32,830
.لن يكتشف أحد الأمر

144
00:11:33,300 --> 00:11:35,440
.أعتمد عليك إذًا

145
00:11:35,440 --> 00:11:37,250
.ادفني أويا-سان من أجلي

146
00:11:37,590 --> 00:11:38,630
.يمكنك الاعتماد عليّ

147
00:11:39,190 --> 00:11:45,450
...عصا الكتف السّلس

148
00:11:45,450 --> 00:11:47,220
.لقد وصلنا إلى ريوكوسان

149
00:11:47,220 --> 00:11:50,670
.يبدو أنّك علمت أنّنا قادمون

150
00:11:51,660 --> 00:11:54,460
أنا متفاجئ لأنّكم أتيتم
.وأنتم تعلمون أنّنا ننتظركم

151
00:11:55,790 --> 00:11:59,480
.هناك شيء أريده بشدّة كافية للمجازفة

152
00:12:00,100 --> 00:12:03,840
.لعلمك، لم أعد مهتمًّا بك

153
00:12:06,700 --> 00:12:08,960
!هذا لا يعقل

154
00:12:08,960 --> 00:12:12,940
هذه كلّ المعلومات الّتي
.حصلت عليها من جدّك

155
00:12:12,940 --> 00:12:15,950
.تصديقك لها من عدمه راجع إليك

156
00:12:16,890 --> 00:12:17,830
.مهلاً يا رو ريو

157
00:12:18,940 --> 00:12:21,060
.أعطني رقم هاتفك

158
00:12:23,040 --> 00:12:24,730
.أنت تقول أشياء مثيرة للاهتمام

159
00:12:25,740 --> 00:12:29,690
هل أنت جادّ في البقاء على اتّصال
مع عضو في زينسي مثلي؟

160
00:12:30,800 --> 00:12:34,470
أريد أن أبقى على اتّصال
.مع الشّخص المدعوّ رو ريو

161
00:12:35,070 --> 00:12:36,740
.لا علاقة لزينسي بهذا

162
00:12:37,320 --> 00:12:40,650
.لا تقل لي أنّك لا تعرف مدى شرّنا

163
00:12:40,960 --> 00:12:44,490
.شرّ؟ أنتم لستم أشرارًا

164
00:12:45,870 --> 00:12:47,700
.القاتل يتاجر بأرواح النّاس

165
00:12:48,180 --> 00:12:50,540
.والمجرم الماليّ يتاجر بالعملة

166
00:12:50,760 --> 00:12:54,610
.لكنّكم تدمّرون نظام المجتمع

167
00:12:55,810 --> 00:12:59,510
.لقد دستم على كلّ جانب من جوانبها حتّى الآن

168
00:13:00,270 --> 00:13:04,210
تشو سوران، لِمَ لا تنضمّ إلى زينسي؟

169
00:13:04,590 --> 00:13:06,930
.يبدو وكأنّك ستكون مفيدًا جدًّا

170
00:13:07,330 --> 00:13:08,720
.لست مهتمًّا بذلك

171
00:13:09,360 --> 00:13:11,920
.أنا راضٍ عن حياتي الحاليّة

172
00:13:12,600 --> 00:13:16,870
.سنتبدل الرّسائل فحسب ولن نتّصل ببعضنا

173
00:13:17,380 --> 00:13:19,890
.امح رسائلي بمجرّد انتهائك من قراءتها

174
00:13:24,340 --> 00:13:27,010
.التقيت عائلتك قبل أيّام

175
00:13:27,370 --> 00:13:29,260
.قالوا أنّهم يريدون رؤيتك

176
00:13:30,960 --> 00:13:33,160
.تقصد رؤية جثّتي

177
00:13:33,720 --> 00:13:36,790
هل تعرف ما فعله رو ريو لعائلة رو؟

178
00:13:37,310 --> 00:13:41,420
.ذلك الحيوان قتل أختي الصّغرى

179
00:13:41,780 --> 00:13:43,510
!قتل عائلته

180
00:13:44,640 --> 00:13:47,770
هل ما قاله صحيح؟

181
00:13:49,640 --> 00:13:52,430
.لم أقم بذلك. تمّ تلفيق ذلك لي

182
00:13:53,460 --> 00:13:56,190
تلفيق؟ من الفاعل؟

183
00:13:59,190 --> 00:14:01,590
.أنت تدافع منذ مدّة

184
00:14:01,590 --> 00:14:03,570
لِمَ لا تعترف بالهزيمة؟

185
00:14:05,700 --> 00:14:08,810
.ستكون فو هوهو خصمي التّالي إن فزت

186
00:14:09,230 --> 00:14:11,210
.يمكنني الانتقام لأخي أخيرًا

187
00:14:12,450 --> 00:14:14,300
تلك المرأة الغريبة مجدّدًا؟

188
00:14:15,010 --> 00:14:18,920
.كنت هناك عندما هُزم أخوك

189
00:14:19,200 --> 00:14:23,440
لكن لِمَ لا تتوقّف عن اختلاق الأعذار؟

190
00:14:23,440 --> 00:14:27,580
.تريد فقط ألاّ تعيش وقفًا لقوانين أمّك

191
00:14:28,020 --> 00:14:32,520
،لو كنت تريد حقًّا الانتقام له
!لكنت تجازف بحياتك ضدّي

192
00:14:36,590 --> 00:14:42,290
من السّخيف حقًّا لشخص في سنّك
.أن يفعل ما يقوله والداه

193
00:14:42,690 --> 00:14:48,230
،لكنّ إنّ كان والداك استثنائيّين
.فتلك طريقة سهلة للعيش

194
00:14:49,120 --> 00:14:52,750
،إن كانوا أكثر خبرة وموهبة منّا

195
00:14:53,280 --> 00:14:57,380
فلِمَ إذًا لا نتّبع الطّريق الّذي وضعوه لنا؟

196
00:14:57,650 --> 00:15:00,600
.أصغ لأمّك وعد إلى المنزل

197
00:15:01,070 --> 00:15:04,220
.سأهزم فو هوهو من أجلك

198
00:15:04,670 --> 00:15:05,550
!لا

199
00:15:06,190 --> 00:15:08,330
.ساي-سان، استسلمي رجاءً

200
00:15:08,700 --> 00:15:11,720
.لا أريد أذيّة فتاة

201
00:15:12,200 --> 00:15:15,550
كانت قدرتك على الضّغط عليّ
،إلى هذا الحدّ مذهلة

202
00:15:16,160 --> 00:15:18,310
.لكنّني لا أستطيع التّراجع الآن

203
00:15:19,630 --> 00:15:22,820
!يجب أن أكون الشّخص الّذي يهزم فو هوهو

204
00:15:23,460 --> 00:15:25,470
!إنّها فريستي

205
00:15:31,070 --> 00:15:32,470
هل تلاحقني؟

206
00:15:33,150 --> 00:15:37,480
أنت أوّل شخص يرغمني على
.استعمال جميع سكاكيني

207
00:15:37,480 --> 00:15:40,290
—لكن بما أنّني استعملتها كلّها، فقد

208
00:15:44,000 --> 00:15:45,460
مِن الأرض؟

209
00:15:45,460 --> 00:15:47,000
!استهدفت نقطتي العمياء

210
00:15:47,370 --> 00:15:50,800
.يبدو أنّك ترفض الإصغاء لأمّك

211
00:15:53,630 --> 00:15:56,760
.لم أظنّ أنّك ستكونين بهذه القوّة

212
00:15:57,260 --> 00:15:59,890
.لم يكن عليّ تكبّد عناء تحذيرك سابقًا

213
00:16:00,270 --> 00:16:02,820
.لقد استهنت بك أيضًا

214
00:16:34,960 --> 00:16:38,050
.لم أتوقّع أن يكون أحد أبناء عائلة جا بهذه القوّة

215
00:16:39,000 --> 00:16:40,630
.لا تجهدي نفسك كثيرًا يا ساين

216
00:16:41,010 --> 00:16:45,060
.حياتك أكثر أهمّيّة من مكانة هائلة فو

217
00:16:49,880 --> 00:16:52,030
.ساين، ليس كثيرًا

218
00:16:56,540 --> 00:17:00,190
العجوز هو والدك إذًا؟

219
00:17:01,970 --> 00:17:05,780
.يبدو أنّني لست الوحيد المدلّل عند والديه

220
00:17:06,270 --> 00:17:09,310
،إن كنت تدّعين العيش وفقًا لرغبات والديك

221
00:17:09,310 --> 00:17:12,010
فلِمَ لا تغادرين هذه الحلبة إذًا؟

222
00:17:12,570 --> 00:17:16,710
.نعم، بالطّبع أصغي لأبي

223
00:17:17,220 --> 00:17:19,650
لكنّه لم يقل لي سوى أن أتجنّب ضرب وجهك

224
00:17:19,650 --> 00:17:24,220
!بقوّة حتّى لا تتمكّن أمّك من التّعرّف عليك

225
00:17:25,100 --> 00:17:29,020
ساين، لِمَ تصبّين كلّ اهتمامك
على هذه المباراة؟

226
00:17:29,330 --> 00:17:33,030
.تبًّا. استعملت الكثير من الكي تلك المرّة

227
00:17:33,030 --> 00:17:34,990
.عليّ أن أهزمها بهجومي الموالي

228
00:17:35,390 --> 00:17:37,690
.قدرة تحمّلي لن تدوم لوقت أطول

229
00:17:37,690 --> 00:17:39,900
.سيتوجّب عليّ استعمال تلك التّقنية

230
00:17:39,900 --> 00:17:42,630
...أردت أن أدّخرها لاستعمالها ضدّ فو هوهو

231
00:17:46,530 --> 00:17:49,930
.إنّها تمدّ الكي خاصّتها لمسافة بعيدة

232
00:17:49,930 --> 00:17:54,690
ستتمكّن من استشعار مناطق سكاكيني
.بدقّة من هذه المسافة

233
00:17:55,020 --> 00:17:59,170
في تلك الحالة، سأضع المزيد من
.الكي في زانسينتو خاصّتي

234
00:17:59,720 --> 00:18:02,900
سأقرّب الاحتكاك بينها وبين الهواء
.إلى الصّفر قدر المستطاع

235
00:18:03,590 --> 00:18:07,590
.مهما مدّت الكي خاصّتها، لن تتمكّن من تفاديها

236
00:18:08,150 --> 00:18:11,640
.ساين-سان، لديّ سؤال أخير

237
00:18:11,640 --> 00:18:13,560
هلاّ استسلمت؟

238
00:18:14,690 --> 00:18:20,500
التّقنية الّتي سأستعملها الآن تفوق
.متطلّبات هذه المباراة

239
00:18:20,900 --> 00:18:23,590
.اقلق حيال نفسك فحسب

240
00:18:23,970 --> 00:18:28,240
.فأنا لم أتقن بعد التّقنية الّتي سأستعملها الآن

241
00:18:28,240 --> 00:18:29,760
من يدري ما الّذي سيحدث؟

242
00:18:38,150 --> 00:18:39,590
!يكفي يا ساين

243
00:18:39,930 --> 00:18:42,120
!هذه المباراة لا تستحقّ المجازفة بحياتك

244
00:19:03,190 --> 00:19:04,450
تعادل؟

245
00:19:04,720 --> 00:19:05,280
!ساين

246
00:19:08,990 --> 00:19:11,260
.أنا بخير يا أبي

247
00:19:14,060 --> 00:19:17,050
يا إلهي. هكذا إذًا؟

248
00:19:18,380 --> 00:19:23,550
ظننت أنّك مددت الكي خاصّتك
.لترصدي سكاكيني

249
00:19:23,890 --> 00:19:29,430
لكنّك تمكّنت من ربط الحيز
.الّذي بداخل مداك

250
00:19:30,900 --> 00:19:32,620
.كان الأمر يستحقّ

251
00:19:32,930 --> 00:19:37,850
لو أنّك صنعت المخارج في مكان
.آخر لتعرضّت لجرح قاتل

252
00:19:38,360 --> 00:19:42,690
.أنت أيضًا. لم تستهدف نقاطي الحيويّة

253
00:19:43,750 --> 00:19:46,120
.كانت سكاكينك سريعة

254
00:19:46,120 --> 00:19:49,010
.لم أستطع نقلها جميعًا

255
00:19:49,370 --> 00:19:51,960
.لا أزال واقفة لأنّ جروحي لم تكن عميقة

256
00:19:52,410 --> 00:19:56,600
لكن ما الّذي كنت تفكّر فيه حين
تساهلت معي في النّهاية؟

257
00:19:57,120 --> 00:20:00,650
.لست واثقًا أيضًا

258
00:20:03,310 --> 00:20:05,780
لا أصدّق أنّني وصلت إلى هذا
.الحدّ فقط لأخسر

259
00:20:06,130 --> 00:20:08,550
.جسدي في حال يرثى لها أيضًا

260
00:20:10,040 --> 00:20:13,310
.كان عليك الإصغاء لأمّك

261
00:20:14,330 --> 00:20:16,640
.سيكون لديها الكثير لتقوله عندما أعود للمنزل

262
00:20:24,730 --> 00:20:26,560
هو-ني؟ كيف يجري الأمر؟

263
00:20:27,250 --> 00:20:30,530
.لا تتّصل بي. أنا أتعقّبه الآن

264
00:20:31,690 --> 00:20:35,370
لا تقلق. اليوم هو آخر يوم سنرى
.فيه ذلك الرّاهب الغريب

265
00:20:35,370 --> 00:20:37,130
!توقّف أيّها الوغد

266
00:20:35,820 --> 00:20:37,990
.أنا أنتظر اللّحظة المناسبة

267
00:20:39,250 --> 00:20:42,150
لن نتمكّن من رؤية أعمال
!سي-ساما البطوليّة بعد الآن

268
00:20:40,110 --> 00:20:41,900
!دعنني وشأني

269
00:20:42,150 --> 00:20:44,640
!أميرنا كان يبصق دمًا

270
00:20:44,640 --> 00:20:46,200
كيف ستعوّض عن ذلك؟

271
00:20:46,200 --> 00:20:47,880
!استمعن إليّ

272
00:20:47,880 --> 00:20:50,660
!هو من جعل نفسه يبصق دمًا

273
00:20:50,660 --> 00:20:52,090
!لا علاقة لي بالأمر

274
00:20:52,090 --> 00:20:53,510
!استمعن للمنطق

275
00:20:52,580 --> 00:20:54,310
!لا نكترث لمنطقك

276
00:20:54,310 --> 00:20:56,830
!سي-ساما هو الحقيقة الوحيدة في هذا العالم

277
00:20:56,200 --> 00:20:59,320
!سأفعل أيّ شيء! سامحنني فحسب

278
00:20:56,830 --> 00:20:58,640
!توقّف

279
00:20:59,320 --> 00:21:01,770
.ربّما ينبغي عليّ دفنهم جميعًا

280
00:21:06,270 --> 00:21:09,370
.لقد طاردنني طوال اليوم

281
00:21:09,370 --> 00:21:11,200
أيّ تدريب مررن به؟

282
00:21:12,330 --> 00:21:13,770
.لا يمكنني المتابعة أكثر من هذا

283
00:21:19,890 --> 00:21:22,410
.ينبغي أن أتمكّن من أخذ قسط من الرّاحة هنا

284
00:23:26,090 --> 00:23:27,340
الحلقة القادمة

285
00:23:26,290 --> 00:23:30,040
مرحبًا! معكم رو ريو، صاحب النّظّارات الأنيقة
.الموجود هنا منذ الموسم الأوّل

286
00:23:30,040 --> 00:23:32,000
.أنا على وشك لعب دور مهّم جدًّا في المسلسل

287
00:23:32,000 --> 00:23:34,800
ماذا؟ لن أكون في المسلسل بدءًا
من الأسبوع القادم مجدّدًا؟

288
00:23:35,230 --> 00:23:38,240
في الحلقة القادمة من
."هيتوري نو شيتا": "سيجوكيو"

289
00:23:38,240 --> 00:23:39,530
.لا تفوّتوها