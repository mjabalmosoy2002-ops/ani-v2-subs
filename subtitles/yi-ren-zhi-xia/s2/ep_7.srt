1
00:01:42,740 --> 00:01:44,820
!كان سويدان

2
00:01:45,380 --> 00:01:46,740
!لا يمكنك الهرب

3
00:01:49,120 --> 00:01:49,750
ماذا؟

4
00:01:52,170 --> 00:01:55,640
مستحيل! محا نيراني؟

5
00:01:55,990 --> 00:01:58,180
.لاحظ كوهين أخيرًا

6
00:01:58,180 --> 00:02:00,550
ماذا تقصد؟

7
00:02:00,850 --> 00:02:03,590
.فخّ كيمون تونكو لأسلوب بوكو

8
00:02:04,010 --> 00:02:08,060
،كلّما اقترب من شوكاتسو سي
.زادت صعوبة استعماله لقوّته

9
00:02:08,980 --> 00:02:15,700
يمكن لكوهين التّراجع الآن، لكنّه بداخل
.البوصلة الّتي خلقها شوكاتسو سي بالفعل

10
00:02:16,940 --> 00:02:21,740
.ستنتهي المباراة عندما يهاجم أخيرًا

11
00:02:36,380 --> 00:02:37,890
ما الخطب؟

12
00:02:40,140 --> 00:02:41,090
.تبًّا

13
00:02:41,940 --> 00:02:44,950
.ليس كافيًا. ليس كافيًا

14
00:02:44,950 --> 00:02:46,880
!حرارتي ليست عالية بما يكفي

15
00:02:49,010 --> 00:02:50,330
!شوكاتسو سي

16
00:02:50,680 --> 00:02:56,570
،مع أنّني أقاتل شخصًا بقوّتك
!إلاّ أنّ روحي بالكاد مشتعلة

17
00:02:56,920 --> 00:02:59,320
!قاتلني بكلّ ما لديك

18
00:02:59,320 --> 00:03:01,640
!لا تتهاون

19
00:03:04,170 --> 00:03:06,040
.آسف بشأن ذلك

20
00:03:10,580 --> 00:03:11,560
!رين

21
00:03:12,710 --> 00:03:16,360
هل يجرؤ على تحدّيّ بالنّار؟

22
00:03:16,700 --> 00:03:18,490
!لا تستهزئ بي

23
00:03:20,540 --> 00:03:22,460
!كينتشو باكوين

24
00:03:24,520 --> 00:03:25,680
!سيكيرين

25
00:03:41,560 --> 00:03:42,820
!المكان خطير جدًّا هنا

26
00:03:41,880 --> 00:03:42,910
!غادروا الحلبة

27
00:03:42,820 --> 00:03:44,300
!أخلوا المكان في الحال رجاءً

28
00:03:44,300 --> 00:03:45,440
!لا تتدافعوا

29
00:03:44,730 --> 00:03:46,450
!المكان خطير هنا

30
00:03:47,910 --> 00:03:50,500
ما كلّ هذه الضّجّة؟

31
00:03:50,500 --> 00:03:52,300
هل انتهت المباراة؟

32
00:03:57,960 --> 00:04:01,470
ماذا؟ يتفوّق عليّ وأنا مستعمل نار؟

33
00:04:01,470 --> 00:04:05,870
.وحده معلّمي ينبغي أن يتمكّن من هزيمة نيراني

34
00:04:07,660 --> 00:04:08,690
!تبًّا

35
00:04:25,820 --> 00:04:28,780
!من المستحيل أن أتمكّن من هزيمة ذلك الوحش

36
00:04:31,600 --> 00:04:34,920
.انتصار مذهل يا شوكاتسو سي-سان

37
00:04:34,920 --> 00:04:39,150
لكنّ النّيران غمرت الحلبة بعد
.مباراتك في حادث كارثيّ

38
00:04:39,150 --> 00:04:41,260
.هل لديك ما تقوله عن ذلك

39
00:04:42,210 --> 00:04:45,260
،كنت أفضّل ألاّ أتسبّب في أيّ أذى

40
00:04:45,260 --> 00:04:51,930
لكنّ غبيًّا سريع الغضب تخلّى عن المباراة
.وكاد يموت، لذا لم يكن لديّ خيار

41
00:04:53,340 --> 00:04:55,310
هل هناك شيء تودّ قوله؟

42
00:04:55,820 --> 00:05:02,120
أيّها الثّعلب. لو أنهيت أمري لما
.اشتعلت تلك النّار أبدًا

43
00:05:02,790 --> 00:05:05,060
.كنتُ مستعدًّا للموت

44
00:05:05,060 --> 00:05:07,560
.لكنّك تساهلت معي إلى آخر لحظة

45
00:05:08,070 --> 00:05:09,730
تساهلت؟

46
00:05:10,160 --> 00:05:13,650
،أنت أوّل خصم صعب أواجهه في هذه البطولة

47
00:05:13,650 --> 00:05:15,250
.وأنا لا أقول هذا لأنّني فزت فقط

48
00:05:15,540 --> 00:05:21,880
لو لم تقع ضحيّة تقنيّة كيمون تونكو خاصّتي
،وكانت مجرد منافسة بين تقنيّات النّار

49
00:05:21,880 --> 00:05:28,180
،لما كانت لي فرصة ضدّك
.حتّى وإن كان هناك اثنان منّي

50
00:05:29,880 --> 00:05:31,800
لما كانت لديك فرصة؟

51
00:05:34,010 --> 00:05:35,240
.بالطّبع لا

52
00:05:35,240 --> 00:05:38,610
.لولا حيلك لفزت أنا

53
00:05:38,880 --> 00:05:43,490
ستكون معركتنا التّالية أكثر
.سخونة يا شوكاتسو سي

54
00:05:43,840 --> 00:05:47,400
.ستحدّد المرّة القادمة من منّا أفضل حقًّا

55
00:05:49,270 --> 00:05:51,810
!أنت، انس المقابلة الّتي قمنا بها للتّوّ

56
00:05:51,810 --> 00:05:53,440
!لنعدها

57
00:05:53,810 --> 00:05:57,140
...هذا الرّجل مزعج نوعًا ما

58
00:05:57,140 --> 00:05:59,100
.بالمناسبة يا شوكاتسو سي-سان

59
00:06:00,070 --> 00:06:05,760
عائلة شوكاتسو ليست معروفة بلفت
.الانتباه لها في عالم الدّخلاء

60
00:06:05,760 --> 00:06:09,730
لِمَ قرّرت المشاركة في هذه البطولة؟

61
00:06:10,700 --> 00:06:13,050
.لا يوجد سبب محدّد

62
00:06:13,050 --> 00:06:16,720
.أردنا اختبار قوّتنا فحسب

63
00:06:17,250 --> 00:06:19,760
قوّتكم؟

64
00:06:19,770 --> 00:06:23,110
شوكاتسو سي-سان، يبدو لي أنّك تملك بالفعل

65
00:06:23,110 --> 00:06:26,720
.قوّة أكبر بكثير من أقرانك في مثل سنّك

66
00:06:26,720 --> 00:06:29,980
إلى أي سقف تهدف له؟

67
00:06:30,510 --> 00:06:33,190
أيمكن أن يكون ذلك؟

68
00:06:33,540 --> 00:06:35,960
أتقصد أوكا؟

69
00:06:36,460 --> 00:06:41,520
أتصدّق الخرافات الّتي تقول أنّ أجنحة
تنمو للرّجال ويصبحون كائنات خارقة؟

70
00:06:41,520 --> 00:06:43,800
!توقّفي يا هو-ني

71
00:06:44,300 --> 00:06:46,680
!لا داعي لدفن شوكاتسو سي

72
00:06:46,680 --> 00:06:48,390
!اهدئي يا هوهو

73
00:06:49,810 --> 00:06:53,110
سأبذل كلّ ما في وسعي، اتّفقنا؟

74
00:06:53,110 --> 00:06:55,000
أنت تشو سوران، صحيح؟

75
00:06:55,350 --> 00:06:58,350
،أنا مع شركة يوسي

76
00:06:58,350 --> 00:07:02,810
نحن مجموعة من الدّخلاء توفّر المساعدة
.والمعلومات للدّخلاء الآخرين

77
00:07:03,200 --> 00:07:06,330
هل تقبل عقد مقابلة معنا؟

78
00:07:06,330 --> 00:07:09,250
جوسان-ساما، سنقدّر لك الأمر
.إن وافقت أنت أيضًا

79
00:07:09,250 --> 00:07:12,320
.أخبرني عن شركة التّوصيل السّريع

80
00:07:23,070 --> 00:07:24,800
.إنّها حامضة

81
00:07:28,450 --> 00:07:32,090
هل تريدين برتقالة يا فو هوهو؟

82
00:07:36,550 --> 00:07:39,190
كيف يمكنك أكل شيء بهذه الحموضة؟

83
00:07:39,690 --> 00:07:42,710
.يجب أكل الطّعام بسرعة

84
00:07:42,710 --> 00:07:46,260
.وإلاّ ستشعر بالجوع عندما لا يكون هناك طعام

85
00:07:46,260 --> 00:07:49,530
.حقًّا؟ تفكير مثير للاهتمام

86
00:07:49,530 --> 00:07:52,790
.علّمني جدّ جوسان ذلك

87
00:07:52,790 --> 00:07:55,180
هل جدّه فقير؟

88
00:07:55,620 --> 00:07:58,540
.عليك دعمه إذًا

89
00:07:58,910 --> 00:08:01,910
لا بدّ أنّك تكسبين مالاً وفيرًا بالعمل
.مع شركة التّوصيل السّريع

90
00:08:02,850 --> 00:08:05,620
.مات قبل وقت طويل

91
00:08:06,030 --> 00:08:08,380
.كنّا جميعًا فقراء حينها

92
00:08:09,130 --> 00:08:12,010
فهمت. قبل وقت طويل؟

93
00:08:12,010 --> 00:08:13,710
—متى كان ذلـ

94
00:08:15,580 --> 00:08:17,020
.آسف، آسف

95
00:08:17,020 --> 00:08:19,390
.لدينا شيء نفعله، لذا من الأفضل أن نذهب

96
00:08:19,640 --> 00:08:21,110
!سنذهب الآن يا جوسان

97
00:08:21,110 --> 00:08:23,990
إلى أين أنت ذاهب يا سوران-كن؟

98
00:08:23,990 --> 00:08:26,190
!قال لنا جوسون أن نأتي لمشاهدة المباراة

99
00:08:26,870 --> 00:08:29,940
هل حصلت على أيّ معلومات منها؟

100
00:08:30,410 --> 00:08:32,180
.كدت أن أفعل

101
00:08:33,100 --> 00:08:37,180
.لكنّنا سنحلّ الغموض

102
00:08:42,320 --> 00:08:44,490
.يبدو أنّهما قد بدآ بالفعل

103
00:08:44,490 --> 00:08:47,220
أتيتم أنتم أيضًا؟

104
00:08:47,220 --> 00:08:49,000
.ستستحقّ هذه المباراة المشاهدة

105
00:08:49,390 --> 00:08:54,250
إنّها مباراة بين شوشو مستعمل الشّينكي
.وكومي مستعمل ريومون من أسلوب زينشين

106
00:09:05,850 --> 00:09:06,790
!غيو

107
00:09:11,060 --> 00:09:12,590
.مستحيل

108
00:09:12,590 --> 00:09:16,860
لم تُطرد روحه منه رغم كلّ
.الشّينكي الّذي تلقّاه

109
00:09:16,860 --> 00:09:20,150
.يواجه شوشو أسوأ خصمٍ له

110
00:09:20,150 --> 00:09:21,360
ماذا تقصد؟

111
00:09:21,700 --> 00:09:26,800
."الجسد المادّيّ الّذي نراه هو ما يسمّى بـ"مي

112
00:09:26,800 --> 00:09:33,240
."الأرواح الّتي لا شكلَ مادّيّ لها تسمّى بـ"سي

113
00:09:33,240 --> 00:09:36,550
.الفكرة وراء أسلوب زينشين هي سيمي ريوشو

114
00:09:36,910 --> 00:09:41,000
.بمعنى آخر، تدريب السّي والمي معًا

115
00:09:41,340 --> 00:09:48,340
يتخلّون عن جميع أفكار فنون القتال
.ويدرّبون أجسادهم وأرواحهم فقط

116
00:09:48,680 --> 00:09:54,850
يمكن لشوشو أن يحاول طرد روحه باستعمال
.شينكي، لكنّ ذلك لن يكون سهلاً

117
00:09:55,590 --> 00:09:59,600
.كومي، هذه ليست معركة حتّى الموت

118
00:10:00,080 --> 00:10:03,430
.الهدف منها أن تكون مسابقة ودّيّة

119
00:10:03,870 --> 00:10:06,460
.كنت أكبح نفسي

120
00:10:07,100 --> 00:10:10,130
.لكنّني لم أعد أستطيع ذلك

121
00:10:10,510 --> 00:10:13,800
.لن أتمكّن من هزيمتك إن فعلت

122
00:10:15,140 --> 00:10:17,380
.لا بأس يا شوشو-سان

123
00:10:17,380 --> 00:10:20,990
.لاحظت بالفعل أنّك كنت تكبح نفسك

124
00:10:21,470 --> 00:10:24,060
.لكنّني بدأت أقترب من حدّي

125
00:10:24,590 --> 00:10:27,140
.أنت مقاتل أقوى منّي بكثير

126
00:10:27,530 --> 00:10:31,850
.لذا سأستعمل تقنيّتي الخاصّة أيضًا

127
00:10:34,530 --> 00:10:40,370
.شوشو-سان، لستَ بحاجة لطرد روحي بعد الآن

128
00:10:41,320 --> 00:10:43,560
.سأطردها بنفسي

129
00:10:46,010 --> 00:10:46,840
ماذا؟

130
00:10:47,200 --> 00:10:47,910
!ها هي

131
00:10:47,910 --> 00:10:49,880
!شوتسويوجين

132
00:10:49,880 --> 00:10:51,540
.احترس

133
00:10:52,750 --> 00:10:57,810
.سأهاجم روحك من الآن فصاعدًا

134
00:11:03,640 --> 00:11:05,990
مـ-ما هذا؟

135
00:11:05,990 --> 00:11:08,300
!لقد تحوّل إلى شبح

136
00:11:08,640 --> 00:11:12,060
إنّها تقنيّة الكونغ فو الخاصّة بطائفة
زينشين الّتي تشمل فصل

137
00:11:12,060 --> 00:11:14,150
.الرّوح عن الجسد والتّحكّم بها

138
00:11:14,650 --> 00:11:20,200
محاربو طائفة زينشين المعتمد على سيمي
،ريوشو لا يملكون أجسادًا قويّة فحسب

139
00:11:20,530 --> 00:11:23,870
.بل أرواحًا قويّة بشكل لا يوصف أيضًا

140
00:11:25,120 --> 00:11:26,650
.إنّه سريع

141
00:11:27,130 --> 00:11:30,090
.لا أصدّق أنّ أسلوب الكونغ فو هذا موجود

142
00:11:30,590 --> 00:11:35,800
.لكن إن غادرت روحه جسده، فلا بدّ أنّه فارغ

143
00:11:36,160 --> 00:11:37,080
!أحمق

144
00:11:46,500 --> 00:11:48,200
...لـ-لا يمكنني التّنفّس

145
00:11:48,570 --> 00:11:51,770
ما هذا؟

146
00:11:53,430 --> 00:11:55,900
.أخبرتك يا شوشو-سان

147
00:11:55,900 --> 00:11:59,610
.بما أنّني روح الآن، فسأهاجم روحك

148
00:12:00,640 --> 00:12:05,300
بسرعتي الحاليّة، لن تحصل على
.فرصة لمهاجمة جسدي

149
00:12:06,950 --> 00:12:11,190
.وقد فهمت الشّينكي خاصّتك

150
00:12:16,170 --> 00:12:17,500
!بطيء جدًّا

151
00:12:18,880 --> 00:12:20,430
!الآن

152
00:12:22,320 --> 00:12:23,420
ماذا؟

153
00:12:31,610 --> 00:12:33,300
.آسف يا كومي

154
00:12:33,950 --> 00:12:37,450
.لقد بدّدت روحك لبعض الوقت

155
00:12:42,290 --> 00:12:46,360
!آسف للمتاعب الّتي سبّبها لك أخي الصّغير

156
00:12:47,110 --> 00:12:48,580
!أيّها الغبيّ

157
00:12:48,860 --> 00:12:52,160
كيف تجرؤ على استعمال شوتسويوجين
!دون تدريب كافٍ

158
00:12:51,150 --> 00:12:57,590
لم يصب بأيّ ضرر عندما استعملت
.الشّينكي خاصّتي ضدّ روحه

159
00:12:58,190 --> 00:13:01,660
هل المنتمون لطائفة زينشين بشر أصلاً؟

160
00:13:01,660 --> 00:13:02,870
!مهلاً أيّها المبتدئ

161
00:13:02,870 --> 00:13:04,750
!استسلم بسرعة

162
00:13:04,750 --> 00:13:05,630
!أنا آسف

163
00:13:05,630 --> 00:13:08,920
!معك حقّ يا أخي! أنا أستسلم

164
00:13:10,980 --> 00:13:12,850
من كان ذلك الرّجل صاحب اللّحية؟

165
00:13:12,850 --> 00:13:16,900
،ريو كويو من هاكونان
.المعبد الرّئيسيّ لطائفة زينشين

166
00:13:17,260 --> 00:13:19,550
.لم أعلم أنّه قويّ لهذه الدّرجة

167
00:13:19,550 --> 00:13:22,020
!وأنا لا أصدّق أنّه شبح

168
00:13:23,240 --> 00:13:25,450
.شوتسويوجين لم تصمّم للقتال

169
00:13:25,450 --> 00:13:33,370
إنّها ما يحدث طبيعيًّا عندما تصل
.روحك لقوّة معيّنة

170
00:13:33,770 --> 00:13:36,390
.الأرواح ضعيفة ويصعب تدريبها

171
00:13:36,840 --> 00:13:40,310
.إصلاح روح متضرّرة أمر صعب للغاية

172
00:13:40,750 --> 00:13:46,020
لكنّ ريو كويو أصيب بضربة مباشرة
.من الشّينكي الخاصّ بشوشو

173
00:13:47,300 --> 00:13:51,230
ذلك أصعب بمئات المرّات من الدّفاع
.ضدّ سيف بيديك العاريتين

174
00:13:51,950 --> 00:13:53,100
.هذا ليس عدلاً

175
00:13:53,100 --> 00:13:55,300
.لا بدّ أنّ كونه شبح يُعتبر غشًّا

176
00:13:55,300 --> 00:13:56,970
.يا شركة التّوصيل السّريع

177
00:13:57,220 --> 00:14:00,190
ريكو رينرون؟

178
00:14:00,190 --> 00:14:02,160
هل انتهت المباراة؟

179
00:14:02,730 --> 00:14:07,200
أنا جاهزة الآن. يمكنكم المجيء
.في أيّ وقت تريدون

180
00:14:09,470 --> 00:14:11,160
هل نذهب؟

181
00:14:11,780 --> 00:14:16,520
.هناك شيء علينا فعله غير الظّهور في البطولة

182
00:14:23,500 --> 00:14:27,650
نحن في طريقنا لرؤية التّينشي
وريكوكين-ساما، صحيح؟

183
00:14:27,650 --> 00:14:28,610
.هذا صحيح

184
00:14:29,010 --> 00:14:32,790
ألا يجدر بنا إذًا ألاّ نحضر هو-ني معنا؟

185
00:14:33,220 --> 00:14:37,610
.لكن لا يمكننا تركها بمفردها

186
00:14:37,610 --> 00:14:42,390
لكن إن كان ماضي هو-ني
...مرتبط بحرب كوشين

187
00:14:43,060 --> 00:14:45,590
.فقد شهد الشّيوخ العشرة تلك الحرب

188
00:14:45,970 --> 00:14:49,070
.قد يعرف أحدهم بشأن هو-ني

189
00:14:50,570 --> 00:14:53,400
ما الّذي تريد فعله يا سوران؟

190
00:14:53,400 --> 00:14:56,960
.أودّ تفادي لقاء هو-ني بالشّيوخ إن أمكن

191
00:14:57,790 --> 00:15:05,000
لهذا السّبب اتّصلت بك بدلاً منها
.عندما استدعاني رو جي وأو أي

192
00:15:05,550 --> 00:15:09,510
.لكن انتهى المطاف بلقائها لهما

193
00:15:11,240 --> 00:15:13,080
.ربّما أقلق أكثر من اللاّزم

194
00:15:13,080 --> 00:15:16,940
لقاء التّينشي ينبغي أن يكون أكثر
.أمانًا من رو جي وأو أي

195
00:15:17,420 --> 00:15:22,390
فكّرت فقط أنّ علينا أن نكون حذرين
.أكثر مع ظروف هو-ني

196
00:15:23,820 --> 00:15:27,820
.أبي، لقد رأيتَ كلّ شيء بالفعل

197
00:15:28,680 --> 00:15:33,980
بدأتُ أخيرًا أفهم لمَ ائتمنت
.سوران على هوهو

198
00:15:35,760 --> 00:15:36,920
.تفضّلوا إلى هنا

199
00:15:38,570 --> 00:15:42,350
.مضى وقت طويل يا جوسان وجويون

200
00:15:42,350 --> 00:15:44,110
.ادخل يا سوران

201
00:15:46,900 --> 00:15:50,080
.اطمئنّ يا سوران

202
00:15:50,340 --> 00:15:52,380
.هذا دين شينتشو

203
00:15:52,380 --> 00:15:56,080
.كان تلميذًا زميلاً لجدّك تشو كايغي

204
00:15:56,080 --> 00:15:58,640
.هذا يجعله معلمّك

205
00:15:59,370 --> 00:16:05,010
أنا وشينتشو وكايغي كنّا أصدقاءً
.مقرّبين فيما مضى

206
00:16:06,790 --> 00:16:09,690
!يا إلهي! المعلّم دين شينتشو

207
00:16:09,690 --> 00:16:12,080
!إنّه لشرف لي أن أقابلك

208
00:16:12,740 --> 00:16:15,100
.بدأ بالمبالغة بالفعل

209
00:16:15,100 --> 00:16:17,110
...إنّه وقح حقًّا

210
00:16:17,710 --> 00:16:19,940
!لا بدّ أنّ هذا المعلّم ريكوكين

211
00:16:19,940 --> 00:16:22,460
!كنت أتطلّع للقائك

212
00:16:23,360 --> 00:16:26,910
.لا أستحقّ ودّك

213
00:16:26,910 --> 00:16:28,550
.ها قد بدأت مجدّدًا

214
00:16:28,550 --> 00:16:31,670
.كنت أريد أن أشكرك يا ريكوكين-ساما

215
00:16:31,670 --> 00:16:35,680
ازداد عدد المشاركين في راتن تايشو
وسأتمكّن من مواجهة

216
00:16:35,680 --> 00:16:38,970
خصوم أقوياء لأنّك عرضت منح
.التسوتينروكو خاصّتك كجائزة

217
00:16:38,970 --> 00:16:40,400
.شكرًا لك

218
00:16:42,420 --> 00:16:46,360
.هل يتحدّث معي بتهكّم؟ يا للجرأة

219
00:16:47,610 --> 00:16:51,060
.بالطّبع، فهو حفيد كايغي

220
00:16:51,520 --> 00:16:52,820
.نلت منّي

221
00:16:53,350 --> 00:16:55,890
.آسف لتكليفك بالمزيد من المتاعب يا سوران

222
00:16:56,240 --> 00:17:01,080
.سأقوم بأيّ خدمة من أجلك في المقابل

223
00:17:02,050 --> 00:17:04,960
.شكرًا لك يا ريكوكين-ساما

224
00:17:06,700 --> 00:17:10,990
بالمناسبة، من تلك الفتاة الّتي خلفك؟

225
00:17:11,990 --> 00:17:14,960
.إنّها أحد موظّفينا

226
00:17:14,960 --> 00:17:17,390
.إنّها تشارك في البطولة أيضًا

227
00:17:35,490 --> 00:17:36,690
.ريكوكين

228
00:17:37,780 --> 00:17:39,770
.لنناقش ما أتينا إلى هنا لأجله

229
00:17:41,660 --> 00:17:43,110
.أحضروه

230
00:17:49,840 --> 00:17:52,830
!إنّه كوكيتسو من تونغوسو

231
00:17:54,750 --> 00:17:59,480
.كنّا نراقب كوكيتسو مذ أصبح عميلاً لزينسي

232
00:18:00,120 --> 00:18:03,760
.كنّا ندعه يفعل ما يحلو له لنتعقّب زينسي

233
00:18:03,760 --> 00:18:09,390
لكن بعد أن أصبح قاتلاً، بدأ كوكيتسو
.يطارد الدّخلاء هنا في ريوكوزان

234
00:18:09,390 --> 00:18:10,600
...لكن

235
00:18:15,050 --> 00:18:16,660
تو يوفوكو؟

236
00:18:17,080 --> 00:18:22,250
—نعم، تو يوفوكو، شامان هاكوتوزان

237
00:18:22,660 --> 00:18:26,750
،أو بشكل أدقّ، ريو كونسي
،عفريت يستحوذ على تو يوفوكو

238
00:18:26,750 --> 00:18:29,330
.قلبَ الموازين على كوكينسو

239
00:18:30,210 --> 00:18:33,600
هل تريد أن تموت يا فتى؟

240
00:18:35,460 --> 00:18:39,120
عفريت؟ هل هي موجودة حقًّا؟

241
00:18:39,490 --> 00:18:43,320
.جميع الكائنات الحيّة تملك كي

242
00:18:44,010 --> 00:18:47,560
.العفريت عبارة عن حيوان درّب الكي خاصّته

243
00:18:48,260 --> 00:18:52,810
لكن من غير الطّبيعيّ جدًّا أن يتمكّن
.حيوان من استعمال الكي خاصّته

244
00:18:53,190 --> 00:18:58,100
.تدريبها يتطلّب فتح أبواب القلب والعقل

245
00:18:58,100 --> 00:19:00,560
.وذلك صعب للغاية

246
00:19:00,570 --> 00:19:04,790
لكن عندما تتقن الحيوانات العاديّة
،استعمال الكي خاصّتها بشكلٍ طبيعيّ

247
00:19:04,790 --> 00:19:07,710
.تتطوّر أسرع من البشر

248
00:19:08,330 --> 00:19:11,460
تُعرف الحيوانات الّتي درّبت الكي
خاصّتها وأصبحت عفاريتًا

249
00:19:11,460 --> 00:19:15,050
.بالسّين من حيث أتى تو يوفوكو

250
00:19:16,000 --> 00:19:20,660
.والشّامان يملكون تقنيّة كونغ فو اسمها شوتسوبا

251
00:19:21,360 --> 00:19:26,350
.يشكّلون عقدًا مع السّين ويستعيرون قواهم

252
00:19:26,930 --> 00:19:29,470
.يوفوكو، أيّها الأحمق

253
00:19:29,470 --> 00:19:34,220
استدعيتني لقتال هذا الضّعيف؟

254
00:19:34,220 --> 00:19:38,050
.اهدأ، اهدأ. لا تغضب

255
00:19:38,450 --> 00:19:43,080
.لم أظنّ أبدًا أن أرى سين في سنّي هذه

256
00:19:43,510 --> 00:19:48,320
.ظننت أنّ الفنون الشّامانيّة لهاكوتوسان قد انتهت

257
00:19:48,320 --> 00:19:51,700
.تبدو ماهرًا نوعًا ما في الكونغ فو

258
00:19:52,050 --> 00:19:56,340
هل تودّ اللّهو معي؟

259
00:19:57,910 --> 00:19:59,710
.ما كنت لأحلم بذلك

260
00:19:59,710 --> 00:20:02,020
ما اسمك أيّها المعلّم؟

261
00:20:02,890 --> 00:20:05,400
.ريو كونسي من هاكوتوسان

262
00:20:09,180 --> 00:20:10,350
.فهمت

263
00:20:10,350 --> 00:20:15,810
هل تنوون قتالي أيّتها الحشرات؟

264
00:20:16,290 --> 00:20:18,990
.لا تسئ الفهم رجاءً يا ريو-سينسي

265
00:20:19,350 --> 00:20:24,250
.عملنا مع ذلك الرّجل الّذي أمسكته

266
00:20:26,230 --> 00:20:31,200
.أقنعناه بطريقة ما بإعطائنا كوكيتسو

267
00:20:31,620 --> 00:20:34,460
،نوينا استجوابه بشأن مخطّطات زينسي

268
00:20:34,460 --> 00:20:38,000
لكنّه لا يستطيع الكلام بشكل
.سليم حتّى في حالته هذه

269
00:20:38,540 --> 00:20:42,540
.أعاقته تقنيّته كلّيًّا تقريبًا

270
00:20:42,870 --> 00:20:45,320
هل هو بخير؟

271
00:20:45,320 --> 00:20:46,720
لن يهاجم فجأة، أليس كذلك؟

272
00:20:48,500 --> 00:20:50,310
.لا تقلق بذلك الشّأن

273
00:20:50,760 --> 00:20:52,520
.استعملت هذه عليه

274
00:20:53,010 --> 00:20:54,860
.إنّها هيغانباري

275
00:20:54,860 --> 00:21:00,020
خزّ وعاء شخصٍ ما الحاكم ولن يتمكّن
.من استعمال الكونغ فو خاصّته

276
00:21:00,990 --> 00:21:04,750
.أشكّ في أنّ هناك شيئًا تسألونه

277
00:21:04,750 --> 00:21:06,650
.فهو لا يعرف شيئًا على الأرجح

278
00:21:07,200 --> 00:21:12,040
ريكوكين-ساما، عندما أعلنت أنّك ستمنح
،التسوتينروكو خاصّتك كجائزة

279
00:21:12,040 --> 00:21:15,120
.اتّصلوا سرًّا بشركتنا

280
00:21:15,940 --> 00:21:19,740
.أتوا إلى هنا لنفس السّبب الّذي أتينا من أجله

281
00:21:20,380 --> 00:21:24,550
.نحن ننتظر زينسي في ريوكوزان

282
00:21:25,480 --> 00:21:27,450
ما الّذي تتحدّثون عنه؟

283
00:21:27,780 --> 00:21:30,140
.لم نخبرك بعد يا سوران-كن

284
00:21:30,140 --> 00:21:33,220
.تسلّل الكثير من موظّفينا إلى الجبل أيضًا

285
00:21:33,220 --> 00:21:33,860
ماذا؟

286
00:21:35,490 --> 00:21:41,700
كان أسلوب كيتايغين خاصّتك وتسوتينروكو
.خاصّتي طعمًا لاستدراج زينسي

287
00:21:41,690 --> 00:21:44,070
،وبمجرّد أن يأخذوا الطّعم

288
00:21:44,820 --> 00:21:49,530
.سنتمكّن من تطويقهم جميعًا هنا في ريوكوزان

289
00:23:22,420 --> 00:23:23,670
الحلقة القادمة

290
00:23:22,920 --> 00:23:26,420
جوسان. أيّ منظمة هي زينسي؟

291
00:23:26,420 --> 00:23:27,810
.سؤال جيّد يا سوران-كن

292
00:23:28,320 --> 00:23:29,880
...زينسي

293
00:23:29,880 --> 00:23:30,880
نعم؟

294
00:23:32,050 --> 00:23:34,110
.يبدو أنّ وقتنا قد انتهى

295
00:23:34,110 --> 00:23:34,730
ماذا؟

296
00:23:35,140 --> 00:23:37,940
."في الحلقة القادمة من "هيتوري نو شيتا": "36 لصًّا

297
00:23:37,940 --> 00:23:39,390
.ستتواصل القصّة الأسبوع القادم