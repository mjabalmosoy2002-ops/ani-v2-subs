1
00:01:44,710 --> 00:01:48,070
.بهذا تنتهي مباريات الجولة الثّانية

2
00:01:48,540 --> 00:01:52,350
.ستبدأ الآن مباريات المجموعة الثّالثة

3
00:01:52,800 --> 00:01:54,750
.ماري ضدّ جا سيريان

4
00:01:55,230 --> 00:01:57,370
.تو بونريو ضدّ تشو كيتسو

5
00:01:57,950 --> 00:02:00,010
.تو يوفوكو ضدّ روو

6
00:02:00,560 --> 00:02:02,780
.تشو سوران ضدّ زين شيدو

7
00:02:15,190 --> 00:02:17,150
!نل منه يا زين شيدو

8
00:02:17,150 --> 00:02:18,430
!أجل

9
00:02:18,430 --> 00:02:21,230
!لقّن ذلك الشّقيّ درسًا

10
00:02:22,480 --> 00:02:27,210
لا أصدّق أنّ مباريات المجموعة
.الثّانية انتهت بتلك السّرعة

11
00:02:27,210 --> 00:02:28,100
.أجل

12
00:02:28,100 --> 00:02:31,660
.فو هوهو وتشو ريغيوكو وفو شينتون

13
00:02:31,660 --> 00:02:33,410
.تأهّلهم متوقّع

14
00:02:34,170 --> 00:02:37,700
من قاتل في المباراة الأخيرة؟

15
00:02:37,700 --> 00:02:39,190
.أنا

16
00:02:39,460 --> 00:02:40,760
.يوكي-تشان

17
00:02:40,760 --> 00:02:42,090
.نعم، صحيح

18
00:02:42,090 --> 00:02:44,320
.كانت مباراتك

19
00:02:44,320 --> 00:02:48,230
ألم تقاتلي كوكيتسو التّابع لتوغوسو؟

20
00:02:48,230 --> 00:02:49,390
كيف سار الأمر؟

21
00:02:49,390 --> 00:02:50,510
.خسرت

22
00:02:50,870 --> 00:02:54,340
حقًّا؟ خسرت أمام كوكيتسو؟

23
00:02:54,340 --> 00:02:55,650
هل حدث شيء ما؟

24
00:02:55,970 --> 00:02:57,590
.كان ذلك سيّئًا

25
00:02:58,740 --> 00:03:01,850
.على أيّة حال، استدعي البقيّة

26
00:03:02,200 --> 00:03:04,420
.علينا إعلام ريكوكين في الحال

27
00:03:08,940 --> 00:03:11,090
.إنّهم متحمّسون للغاية

28
00:03:11,510 --> 00:03:15,360
.لم أظنّ أنّ سوران-كن مشهور لهذه الدّرجة

29
00:03:15,360 --> 00:03:17,960
.على العكس. إنّه محلّ الاهتمام

30
00:03:18,510 --> 00:03:22,750
.ذلك الفتى الوقح يغشّ في المباريات

31
00:03:23,520 --> 00:03:26,060
.مرحبًا يا أبي ويا أختي

32
00:03:27,040 --> 00:03:29,330
هل فزت أنت أيضًا يا شينتون؟

33
00:03:29,330 --> 00:03:30,950
.أنعم، على ما أظنّ

34
00:03:30,950 --> 00:03:33,370
أتيت لمشاهدة مباراة سوران؟

35
00:03:34,700 --> 00:03:38,660
.فكّرت في مشاهدة هزيمته المخزية

36
00:03:39,910 --> 00:03:42,610
.نعم، فهو سيواجه زين شيدو الأوكامي

37
00:03:43,710 --> 00:03:46,050
!زين شيدو! زين شيدو

38
00:03:46,050 --> 00:03:47,830
!ادخل إلى الحلبة في الحال

39
00:03:48,210 --> 00:03:50,500
!بدأت مباراتك بالفعل

40
00:03:50,500 --> 00:03:52,460
!ادخل إلى الحلبة في الحال

41
00:03:52,460 --> 00:03:54,340
!ما الّذي يفعله زين شيدو؟

42
00:03:54,340 --> 00:03:55,370
ماذا حدث له؟

43
00:03:55,370 --> 00:03:58,030
.ربّما غشّ تشو سوران مجدّدًا

44
00:03:58,030 --> 00:03:59,430
.لا بدّ أنّه السّبب

45
00:04:00,090 --> 00:04:02,040
.لا يمكننا إيجاد زين شيدو في أيّ مكان

46
00:04:02,040 --> 00:04:04,260
ماذا؟ لا يمكنكم إيجاده؟

47
00:04:04,660 --> 00:04:06,340
.لا خيار أمامنا إذًا

48
00:04:07,000 --> 00:04:13,760
بما أنّ زين شيدو فشل في الدّخول إلى الحلبة
.في الوقت المحدد لمباراته، فقد خسرها

49
00:04:13,760 --> 00:04:16,480
!الفائز هو تشو سوران

50
00:04:19,140 --> 00:04:21,600
!لقد غششت مجدّدًا يا تشو سوران

51
00:04:21,600 --> 00:04:23,560
!أيّ وريث لأسلوب كيتايغين هذا

52
00:04:23,560 --> 00:04:24,920
!قاتِل بشكل مناسب في مباراة ما

53
00:04:27,080 --> 00:04:28,830
!تشو سوران

54
00:04:31,170 --> 00:04:32,780
!انظروا، دخل أحدهم إلى الحلبة

55
00:04:33,420 --> 00:04:36,980
!إنّه الفتى الّذي خدعه تشو سوران في مباراته الأخيرة

56
00:04:37,990 --> 00:04:39,340
!تشو سوران

57
00:04:39,340 --> 00:04:41,830
!اليوم هو اليوم الّذي أمزّق فيه قناعك

58
00:04:42,090 --> 00:04:43,450
!جهّز نفسك

59
00:04:46,790 --> 00:04:49,300
.هذا ليس مكانًا للشّجار أيّها الشّاب

60
00:04:49,700 --> 00:04:50,830
!دعاني

61
00:04:50,830 --> 00:04:51,940
!عليّ أن أهزمه

62
00:04:52,460 --> 00:04:53,480
!تشو سوران

63
00:04:53,900 --> 00:04:57,680
!إن كنت رجلاً حقيقيًّا، فقاتلني بعدل

64
00:05:05,680 --> 00:05:06,820
.هيّا بنا

65
00:05:10,230 --> 00:05:12,210
.مذهل يا سوران-كن

66
00:05:12,210 --> 00:05:17,310
.لا أدري ما فعله، لكنّني مهتمّ به أكثر الآن

67
00:05:18,340 --> 00:05:21,760
أبي، هل يروقك سوران إلى هذا الحدّ؟

68
00:05:22,580 --> 00:05:26,430
.ستدركان يومًا ما الشّيء العظيم فيه

69
00:05:26,960 --> 00:05:30,250
.احرصا على أن تبقى علاقتكما جيّدة معه

70
00:05:33,850 --> 00:05:36,240
هل ذلك تشو سوران؟

71
00:05:36,240 --> 00:05:38,850
ما رأيك يا رو جي؟

72
00:05:39,490 --> 00:05:41,700
.إنّه مجرّد طفل

73
00:05:42,050 --> 00:05:43,660
ما رأيك يا أو أي؟

74
00:05:43,660 --> 00:05:45,970
هل نلتقي به؟

75
00:05:47,170 --> 00:05:49,520
دون مناقشة الأمر مع التّينشي أوّلاً؟

76
00:05:49,870 --> 00:05:53,520
.تشو سوران لا ينتمي إلى التّينشيفو بعد

77
00:05:53,520 --> 00:05:56,900
.لا رأي للتّينشي في هذا الأمر

78
00:05:58,820 --> 00:06:01,660
.إنّه فو تشونهان من التّينغيكو

79
00:06:01,660 --> 00:06:06,050
.لم أتوقّع أن يقف جنبًا إلى جنب مع يونداي سيكا

80
00:06:06,050 --> 00:06:08,300
.يا للعجرفة

81
00:06:09,780 --> 00:06:11,600
عمّاذا تتحدّث؟

82
00:06:11,600 --> 00:06:13,880
.التّينغيكاي لا يستحقّون اهتمامنا

83
00:06:13,880 --> 00:06:15,620
.إنّهم مجموعة من الأغبياء

84
00:06:20,870 --> 00:06:23,940
.شكرًا لقدومك يا ريكوكين-ساما

85
00:06:26,290 --> 00:06:30,430
.جمعنا كلّ شخص لا مباراة لديه حاليًّا

86
00:06:31,450 --> 00:06:34,380
هل أنت واثقة يا شيشي؟

87
00:06:34,380 --> 00:06:38,820
نعم، علمت مباشرة عندما أكلت
.الكي الخاصّ بكوكتسو

88
00:06:39,900 --> 00:06:45,170
.ذلك الطّعم المقزّز لتشينتشو من كاكونشا

89
00:06:45,460 --> 00:06:48,730
كان هناك كي يخصّ دخلاء
.آخرين ممزوجًا به أيضًا

90
00:06:49,210 --> 00:06:52,760
.لربّما ينتمي للدّخلاء الّذين قتلهم كوكيتسو

91
00:06:53,080 --> 00:06:57,380
.هذه قوّة تشينتشو بالتّأكيد: ياميكين

92
00:06:58,210 --> 00:07:02,140
.يمكن لتشينتشو أن يعير قوّته للآخرين

93
00:07:02,460 --> 00:07:08,260
يمكن للمستعير امتصاص الكي الخاصّ
.بالدّخلاء الآخرين عن طريق قتلهم

94
00:07:08,770 --> 00:07:13,720
مقابل قوّته، عليهم إعادة جزء
.من الكي إلى تشينتشو

95
00:07:14,740 --> 00:07:18,590
.لكن كلّما قتلوا، إلاّ وارتفعت فائدتهم

96
00:07:18,590 --> 00:07:21,760
.وترتفع حصّة تشينتشو من الكي

97
00:07:22,430 --> 00:07:25,130
.وينقص الكي الّذي يمتصّه المستعير

98
00:07:25,130 --> 00:07:29,320
.وفي النّهاية، يُجنّ ويصبح مجرّد قاتل

99
00:07:33,010 --> 00:07:37,230
.التّجوّل بمفردك تهوّر كبير يا سايروكو

100
00:07:43,360 --> 00:07:44,850
كوكيتسو؟

101
00:07:45,200 --> 00:07:50,320
يبدو أنّ ناتسكا وتشينتشو فشلا
.في ترويض كلبهما بشكلٍ جيّد

102
00:07:50,610 --> 00:07:52,580
ماذا؟ من أنت؟

103
00:07:54,150 --> 00:07:55,690
من تظنّني؟

104
00:07:56,210 --> 00:07:59,260
.افتح عينيك وألق نظرة عن كثب

105
00:08:00,570 --> 00:08:04,330
يـ-يوكو غادوكو صاحب المائة قناع؟

106
00:08:04,520 --> 00:08:08,750
.صه. لست وحدي هنا

107
00:08:11,170 --> 00:08:14,780
.حوّلتهم جميعًا باستعمال قوّتي

108
00:08:15,140 --> 00:08:19,030
لكن بخلافي، لا يمكنهم الحفاظ
.على تحوّلهم طوال الوقت

109
00:08:19,450 --> 00:08:22,970
.يتلاشى إن تشتّت انتباههم

110
00:08:22,970 --> 00:08:24,160
.اسمع جيّدًا

111
00:08:24,430 --> 00:08:27,130
.لا تتصرّف دون أمر منّا

112
00:08:27,130 --> 00:08:31,120
.وإلاّ سنضطرّ لإبادتك

113
00:08:47,350 --> 00:08:49,950
.أصبح لي الكثير من الأعداء

114
00:08:49,950 --> 00:08:53,090
على أيّة حال، أين هو-ني؟

115
00:08:53,760 --> 00:08:56,680
لا يمكن أن تكون في صدد
.دفن شخصٍ ما مجدّدًا

116
00:08:56,680 --> 00:08:58,220
.يا إلهي

117
00:09:00,950 --> 00:09:01,980
.تشو سوران-ساما

118
00:09:03,310 --> 00:09:08,350
.الشّيخان رو جي-ساما وأو أي-ساما يطلبان لقاءك

119
00:09:08,350 --> 00:09:12,260
.ماذا؟ لكنّني لم ألتق بهما من قبل

120
00:09:12,260 --> 00:09:15,580
.كانا يعرفان جدّك

121
00:09:16,530 --> 00:09:18,440
.تعال معنا

122
00:09:18,440 --> 00:09:21,660
.إنّهما في انتظارك

123
00:09:27,450 --> 00:09:28,800
.خذاني إليهما

124
00:09:31,680 --> 00:09:35,970
!التقينا مجدّدًا؟ لا بدّ أنّه القدر يا آنسة

125
00:09:35,970 --> 00:09:39,830
!دعيني أريك كنزًا مميّزًا للاحتفال بهذا اللّقاء

126
00:09:39,830 --> 00:09:40,850
!هذا

127
00:09:41,270 --> 00:09:43,910
ما زلت تعمل؟

128
00:09:43,910 --> 00:09:46,080
.هذا ليس عملاً

129
00:09:46,080 --> 00:09:49,680
أنا ببساطة أعطي هذه الكنوز
.لمن قُدِّر لهم الحصول عليها

130
00:09:50,310 --> 00:09:55,460
حصل معلّمي على هذا الخاتم بعد معركة
.دامت شهرًا مع ثعلب بمائة ذيل

131
00:09:55,460 --> 00:09:58,570
.معلّمك يقاتل الكثير من الوحوش

132
00:09:58,880 --> 00:10:01,540
!على أيّة حال، هذا الكنز فريد من نوعه

133
00:10:01,540 --> 00:10:04,120
!سأدعك تحصلين عليه بما أنّك مميّزة

134
00:10:04,120 --> 00:10:06,290
!بثمانية آلاف يوان، لا تخفيضات

135
00:10:06,650 --> 00:10:09,410
.لكنّني لا أملك ذلك القدر من المال

136
00:10:09,410 --> 00:10:12,210
!يمكنك الدّفع ببطاقة الائتمان أو التّحويل الإلكترونيّ

137
00:10:12,210 --> 00:10:15,940
أسرعي يا آنسة! من الأفضل
!أن تسرعي قبل أن ينتهي حظّك

138
00:10:15,940 --> 00:10:18,820
.مهلاً. لم أستعمل هذه منذ وقت طويل

139
00:10:18,820 --> 00:10:21,350
...حسنًا... رقمي السّرّيّ هو

140
00:10:21,350 --> 00:10:21,870
ماذا؟

141
00:10:22,260 --> 00:10:24,930
...66666

142
00:10:23,870 --> 00:10:27,310
هوهو، ألم تشاهدي مباراة سوران؟

143
00:10:27,310 --> 00:10:29,410
.أجل، لا بأس

144
00:10:30,050 --> 00:10:31,480
.أعلم أنّه سيفوز

145
00:10:35,800 --> 00:10:44,240
انظري... انظري... انظري... ألا تريدينه؟

146
00:10:35,940 --> 00:10:39,160
.لديّ سؤال لك يا آنسة

147
00:10:39,160 --> 00:10:41,260
من هو معلّمك؟

148
00:10:41,740 --> 00:10:44,240
معلّمي؟ ما هو المعلّم؟

149
00:10:44,510 --> 00:10:47,310
هل درّبك والداك إذًا؟

150
00:10:47,880 --> 00:10:49,750
ما هي أسماء والديك؟

151
00:10:51,540 --> 00:10:53,290
والديّ؟

152
00:10:55,910 --> 00:10:56,970
.نسيت

153
00:10:57,240 --> 00:10:58,840
ماذا؟ نسيت؟

154
00:10:58,840 --> 00:11:01,690
هل انتهت مباراة تشو سوران؟

155
00:11:01,690 --> 00:11:02,840
أين هو؟

156
00:11:03,350 --> 00:11:06,400
.ذهب سوران إلى مكانٍ ما بمفرده

157
00:11:06,400 --> 00:11:09,020
!لا! لقد ضاع تشو سوران

158
00:11:09,020 --> 00:11:10,770
!تشو سوران

159
00:11:11,210 --> 00:11:13,450
أنت. هل رأيت تشو سوران؟

160
00:11:13,450 --> 00:11:14,710
...لا

161
00:11:14,000 --> 00:11:15,530
.أنت يا سيّد

162
00:11:14,890 --> 00:11:17,320
تشو سوران، أين أنت؟

163
00:11:16,040 --> 00:11:19,280
هل تودّ شراء هذا الخاتم مقابل 0,8 يوان؟

164
00:11:19,280 --> 00:11:20,380
.لا، شكرًا لك

165
00:11:22,340 --> 00:11:24,400
.لقد أحضرنا تشو سوران

166
00:11:25,720 --> 00:11:26,740
.تفضّل

167
00:11:26,740 --> 00:11:30,470
.هذان هما الشّيخان أو أي-ساما ورو جي-ساما

168
00:11:32,500 --> 00:11:35,780
.التقينا أخيرًا يا تشو سوران

169
00:11:36,750 --> 00:11:39,840
.لا أحبّ اللّف والدّوران

170
00:11:39,840 --> 00:11:42,170
.أعطنا أسلوب كيتايغين

171
00:11:42,170 --> 00:11:45,720
.سنعطيك أيّ شيء تريده في المقابل

172
00:11:46,660 --> 00:11:50,020
.مهلاً، كفّا عن المزاح أيّها الجدّان

173
00:11:50,380 --> 00:11:53,340
.لا أعرف أسلوب كيتايغين

174
00:11:53,340 --> 00:11:59,140
،طلبت زينسي منّي نفس الشّيء ذات مرّة
.لكنّهم فشلوا في الحصول على أيّ شيء

175
00:11:59,140 --> 00:12:05,530
تشو سوران، سيتسبّب أسلوب كيتايغين
.في الأذى سواء أردت ذلك أم لا

176
00:12:05,910 --> 00:12:10,200
.لن يؤذيك أحد بعد الآن إن أعطيته لنا

177
00:12:11,480 --> 00:12:14,080
كيف لي أن أعطيكم شيئًا لا أملكه؟

178
00:12:14,910 --> 00:12:19,230
.أيّها الولد، نحن نحاول أن نكون مهذّبين

179
00:12:19,230 --> 00:12:23,160
...لكن إن رفضت إعطاءه لنا

180
00:12:23,610 --> 00:12:24,660
!رو كيو

181
00:12:26,550 --> 00:12:27,350
...هذا

182
00:12:28,410 --> 00:12:29,320
...هل يمكن

183
00:12:30,880 --> 00:12:32,280
!إنّها تقنيّة رو ريو

184
00:12:33,750 --> 00:12:36,500
.تعرف بشأن رو ريو إذًا

185
00:12:36,480 --> 00:12:37,820
.هذا صحيح

186
00:12:37,820 --> 00:12:42,820
.هذا فنّ سرّيّ يمكن فقط لعائلة رو تعلّمه: ميكون

187
00:12:42,820 --> 00:12:46,650
.يسمح لنا بالتّلاعب بروحك واستخراج ذكرياتك

188
00:12:46,650 --> 00:12:48,750
—ماذا؟ أنت ورو ريو

189
00:12:49,140 --> 00:12:54,040
.نعم، إنّه حفيدي وأخ رو كيو الأصغر

190
00:12:54,040 --> 00:12:57,450
.جدّي، إنّه ليس أخي

191
00:12:57,450 --> 00:12:59,400
.إنّه منحطّ ومشقّ

192
00:12:59,400 --> 00:13:02,770
ما الّذي يعنيه ذلك؟

193
00:13:03,190 --> 00:13:06,240
هل تعرف ما فعله رو ريو لعائلة رو؟

194
00:13:06,770 --> 00:13:10,970
.لقد آذى ذلك الحيوان أختي الصّغيرة

195
00:13:11,300 --> 00:13:13,480
!قتل أحد أفراد عائلته

196
00:13:13,810 --> 00:13:17,510
.تشو سوران، أريد أسلوب كيتايغين الخاصّ بك

197
00:13:17,860 --> 00:13:23,500
سأستعمل تلك القوّة لقتل
.المنشقّ رو ريو وأنتقم لأختي

198
00:13:24,720 --> 00:13:29,440
.سأتحقّق ما إن كنت تمتلك أسلوب كيتايغين أم لا

199
00:13:30,580 --> 00:13:32,400
.أرجوك يا أخي

200
00:13:32,400 --> 00:13:37,550
،حتّى وإن كنت أمتلك أسلوب كيتايغين
.فلا توجد طريقة لي لإعطاءه لك

201
00:13:38,160 --> 00:13:39,940
!ماذا؟ مهلاً لحظة

202
00:13:39,940 --> 00:13:41,700
هل ستستعمل الميكون خاصّتك حقًّا؟

203
00:13:41,700 --> 00:13:43,910
!أ-أيّ شيء إلاّ ذلك

204
00:13:43,910 --> 00:13:45,050
.لا تقلق

205
00:13:45,420 --> 00:13:48,950
سأستعمل الميكون خاصّتي على
.جسدك بلطف فحسب

206
00:13:48,950 --> 00:13:52,730
.سيخبرني ذلك ما إن كنت تكذب

207
00:13:53,590 --> 00:13:57,130
حقًّا؟ مجرّد كاشف للكذب إذًا؟

208
00:13:57,130 --> 00:13:58,860
!تشو سوران

209
00:13:57,960 --> 00:13:59,440
مهلاً، من أنتِ؟

210
00:13:59,440 --> 00:14:01,000
!عودي إلى هنا أيّتها الفتاة

211
00:14:01,000 --> 00:14:03,220
من تظنّين بالدّاخل؟

212
00:14:03,220 --> 00:14:04,510
.أعلم. تشو سوران

213
00:14:04,510 --> 00:14:05,470
!لا

214
00:14:05,470 --> 00:14:08,120
—رو جي-ساما وأو أي-ساما يستريحان في

215
00:14:12,660 --> 00:14:13,790
.هو-ني

216
00:14:13,130 --> 00:14:14,830
.ها أنت ذا

217
00:14:14,830 --> 00:14:17,330
.كان عليك أن تخبرني أنّك في ورطة

218
00:14:17,330 --> 00:14:19,340
من أنت؟

219
00:14:19,900 --> 00:14:21,410
لِمَ لم تتّصل بي؟

220
00:14:21,410 --> 00:14:23,330
كيف وجدتني؟

221
00:14:23,330 --> 00:14:24,590
من ذلكما العجوزان؟

222
00:14:26,770 --> 00:14:28,130
!يا للوقاحة

223
00:14:28,130 --> 00:14:30,510
كيف تجرئين على الحديث
!إلى الشّيخين بهذه الطّريقة؟

224
00:14:31,420 --> 00:14:32,620
!مهلاً

225
00:14:32,620 --> 00:14:35,640
.مهلاً، مهلاً. رو كيو-سان، اهدأ

226
00:14:36,730 --> 00:14:40,150
.هذه الغبيّة. إنّها تجعل الأمور أكثر سوءًا

227
00:14:40,150 --> 00:14:44,180
.حسنًا يا رو كيو-سان. سأخضع لاختبارك

228
00:14:52,040 --> 00:14:55,490
.لا تقلقي يا هو-ني. أنا بخير

229
00:14:56,010 --> 00:14:58,760
.تشو سوران، سأسألك سؤالاً

230
00:14:58,760 --> 00:15:00,670
.لا، لا حاجة لسؤالي

231
00:15:00,670 --> 00:15:01,910
.سأخبرك

232
00:15:03,170 --> 00:15:07,410
.لم يعلّمني جدّي أسلوب كيتايغين أبدًا

233
00:15:08,170 --> 00:15:14,230
.ولم يخبرني شيئًا عنه أيضًا

234
00:15:18,340 --> 00:15:19,950
.إنّها الحقيقة

235
00:15:21,320 --> 00:15:26,860
.حسنًا. شكرًا لقدومك يا تشو سوران

236
00:15:26,860 --> 00:15:28,610
.يمكنك المغادرة الآن

237
00:15:28,610 --> 00:15:30,990
.سأذهب إذًا

238
00:15:30,240 --> 00:15:30,990
.مهلاً

239
00:15:31,660 --> 00:15:33,580
.أتيت كلّ هذه المسافة

240
00:15:33,580 --> 00:15:36,620
.فلنتحدّث بصراحة

241
00:15:36,620 --> 00:15:39,850
.تبًّا، هذان العجوزان لا يستسلمان

242
00:15:39,850 --> 00:15:41,420
.لا يمكنني متابعة خداعهم

243
00:15:41,420 --> 00:15:45,130
.عجبًا، رو-سينسي وأو-سينسي

244
00:15:45,500 --> 00:15:50,100
ما الّذي يريده الشّيخان من عمّال شركتنا؟

245
00:15:51,520 --> 00:15:56,840
أردت التّحدّث إلى تشو سوران هذا
.الّذي يتحدّث عنه الجميع

246
00:15:56,840 --> 00:15:59,890
كيف تعقّباه إلى هنا؟

247
00:16:00,240 --> 00:16:04,910
.فهمت. إنّه مركز الاهتمام حاليًّا بالفعل

248
00:16:04,910 --> 00:16:06,760
استغرقتما وقتًا طويلاً للوصول
.إلى هنا يا جو يون

249
00:16:06,760 --> 00:16:09,980
.سنأخذهما معنا إن كنتم قد انتهيتم

250
00:16:09,980 --> 00:16:11,240
هل هذا كلّ شيء؟

251
00:16:11,480 --> 00:16:12,540
.مهلاً

252
00:16:14,820 --> 00:16:19,980
تشو سوران، ألا تريد أن تعرف سبب مغادرة

253
00:16:19,980 --> 00:16:26,570
جدّك للتّينشيفو ووصل به الحدّ لاستعمال
اسمٍ مزيّف ليخفي نفسه؟

254
00:16:27,560 --> 00:16:31,620
.كانت لديه علاقة مع منشقّي زينسي

255
00:16:34,500 --> 00:16:36,430
ما الّذي تتحدّث عنه يا روجي-سان؟

256
00:16:36,430 --> 00:16:37,570
!أخبرني

257
00:16:38,670 --> 00:16:41,380
.لا يمكنني إخبارك بالمزيد

258
00:16:41,380 --> 00:16:44,400
.إنّها فضيحة في تاريخ التّينشيفو

259
00:16:44,730 --> 00:16:51,270
.وحدّه التّينشي عليه إخبارك بهذا، وليس أنا

260
00:16:53,250 --> 00:16:54,740
.لا تفكّر كثيرًا في الأمر

261
00:16:54,740 --> 00:16:58,400
.يحاولان جعلك تعادي التّينشيفو

262
00:16:58,660 --> 00:17:03,400
.لا، تصرّف رو جي ذاك... لا بدّ أنّ هناك معنى لما قاله

263
00:17:04,270 --> 00:17:08,420
سيتوجّب عليك الفوز بالرّاتن تايشو
.لتعرف جميع الأجوبة

264
00:17:09,290 --> 00:17:12,890
.من الآن فصاعدًا، عليك التّفكير في خطط للفوز

265
00:17:13,670 --> 00:17:15,960
.جميع المنافسين المتبقّين أقوياء

266
00:17:21,610 --> 00:17:22,730
!خذ هذه

267
00:17:29,770 --> 00:17:33,960
.ذلك الرّجل كوهين مستعمل نار مذهل

268
00:17:33,960 --> 00:17:36,750
.لقد قلب الطّاولة على شوكاتسو سي

269
00:17:36,750 --> 00:17:38,210
.على العكس

270
00:17:39,330 --> 00:17:42,670
.لا يَعتبرُ شوكاتسو سي كوهين كخصمٍ له

271
00:17:43,130 --> 00:17:46,990
.لهذا السّبب يركض ويلهو معه

272
00:17:47,620 --> 00:17:51,940
.ستنتهي المباراة بمجرّد أن يهاجم

273
00:17:58,500 --> 00:18:00,750
.كلّ ما تفعله هو الرّكض

274
00:18:02,010 --> 00:18:04,910
.لا أريد أن أصبح فحمًا

275
00:18:07,930 --> 00:18:10,700
.أحببت هذا الزّيّ

276
00:18:10,700 --> 00:18:12,500
!كيف تجرؤ على الاستخفاف بي؟

277
00:18:12,500 --> 00:18:14,500
!خذ هذه! ريوكادان

278
00:18:15,650 --> 00:18:18,160
!غون دوباكو

279
00:18:22,620 --> 00:18:25,030
.إنّها كيمون تونكو من أسلوب بوكو

280
00:18:25,030 --> 00:18:26,080
.لم أرها من قبل

281
00:18:26,450 --> 00:18:28,130
كيمون تونكو؟

282
00:18:29,200 --> 00:18:31,930
!لن تنجح خدعك معي

283
00:18:40,020 --> 00:18:41,030
!خذ هذه

284
00:18:41,640 --> 00:18:42,830
!رينشو

285
00:18:43,040 --> 00:18:45,240
!سون كازيناوا

286
00:18:50,850 --> 00:18:52,770
.أنت بارع

287
00:18:52,770 --> 00:18:53,660
...لكن

288
00:19:00,290 --> 00:19:05,980
.غيّرت درجة حرارة جسدك لتخلّ بتدفّق رياحي

289
00:19:05,980 --> 00:19:07,210
.لست سيّئًا

290
00:19:08,130 --> 00:19:11,310
.اختصاصي الوحيد هو التّحكّم في النّار

291
00:19:11,310 --> 00:19:13,140
.لا أحد يستطيع التّغلّب عليّ في ذلك

292
00:19:14,300 --> 00:19:15,880
!ريتسوينشو

293
00:19:16,990 --> 00:19:18,930
.دا كوروروري

294
00:19:28,140 --> 00:19:29,920
!حوّلت ذراعيك إلى زجاج

295
00:19:30,440 --> 00:19:33,490
لكن إلى متى تستطيع تحمّل ريتسوينشو خاصّتي؟

296
00:19:33,490 --> 00:19:35,150
.إنّه ساخن حقًّا

297
00:19:35,150 --> 00:19:37,960
ما هي درجة حرارة يديه يا ترى؟

298
00:19:42,420 --> 00:19:43,950
!لا يمكنك الهرب

299
00:19:44,320 --> 00:19:46,070
!كان سويدان

300
00:19:48,630 --> 00:19:49,490
ماذا؟

301
00:19:51,920 --> 00:19:55,610
مستحيل! محا نيراني؟

302
00:19:56,440 --> 00:19:59,640
هل سهامه المائيّة قويّة لتلك الدّرجة؟

303
00:20:01,660 --> 00:20:02,960
ما الخطب؟

304
00:20:04,580 --> 00:20:05,850
...لا

305
00:20:06,370 --> 00:20:09,310
.يتمّ إضعافها نيراني

306
00:20:09,980 --> 00:20:12,350
.لاحظ كوهين الأمر أخيرًا

307
00:20:12,350 --> 00:20:14,740
ماذا تقصد؟

308
00:20:15,160 --> 00:20:17,720
.فخّ كيمون تونكو لأسلوب بوكو

309
00:20:18,100 --> 00:20:21,950
،كلّما اقترب من شوكاتسو سي
.زادت صعوبة استعماله لقوّته

310
00:20:21,950 --> 00:20:24,190
...إذًا، بمعنى آخر

311
00:20:24,420 --> 00:20:25,740
ألم تفهم؟

312
00:20:26,790 --> 00:20:28,040
...في الواقع

313
00:20:28,040 --> 00:20:30,420
ألم يعلّمك معلّمك الخطط الأساسيّة؟

314
00:20:31,890 --> 00:20:34,430
.أفهم النّظريّة الأساسيّة

315
00:20:34,430 --> 00:20:37,180
إنّه يستعمل صيغًا لتوقّع مستقبله، صحيح؟

316
00:20:37,180 --> 00:20:40,330
.لكنّ تموضعه في فوضى

317
00:20:41,060 --> 00:20:42,080
.صحيح

318
00:20:42,080 --> 00:20:46,820
.من النّظرة الأولى، تموضعه غير منطقيّ

319
00:20:47,630 --> 00:20:52,810
.مع كيمون تونكو العاديّة، يكون المركز هو العدوّ

320
00:20:52,810 --> 00:20:55,890
.بمعنى آخر، يكون مركز البوصلة

321
00:20:55,890 --> 00:20:59,310
يحدّد موضع خصمك التّقنيّات
.الّتي يمكنك استعمالها

322
00:20:59,800 --> 00:21:02,070
.هذا يخلق مشكلتين

323
00:21:02,490 --> 00:21:09,210
أوّلاً، تصبح مضطرًّا للقتال بشكل
.دفاعيّ لأنّ خصمك هو المركز

324
00:21:09,210 --> 00:21:13,160
،وثانيًا، عندما يحيط بك عدّة خصوم

325
00:21:13,160 --> 00:21:17,510
.يصعب كثيرًا الحكم على الاتجاه النّسبيّ لكلّ شخص

326
00:21:17,510 --> 00:21:22,470
لكنّ شوكاتسو سي قاتل ثلاثة خصوم
.دفعة واحد في مباراته السّابقة

327
00:21:22,780 --> 00:21:27,470
نعم. هذا ما يعجل كيمون تونكو
.لأسلوب بوكو مميّزة

328
00:21:27,950 --> 00:21:32,420
.يخلقون بوصلة يكونون هم مركزها

329
00:21:33,050 --> 00:21:39,490
يمكن لكوهين التّراجع الآن، لكنّه بداخل
.البوصلة الّتي خلقها شوكاتسو سي بالفعل

330
00:21:39,490 --> 00:21:42,860
.حركة خاطئة واحدة وينتهي كلّ شيء

331
00:23:19,290 --> 00:23:20,540
في الحلقة القادمة

332
00:23:19,290 --> 00:23:21,970
.كيمون تونكو مذهلة يا شوكاتسو-سينسي

333
00:23:21,970 --> 00:23:24,160
.عائلة شوكاتسو مقاتلون ماهرون

334
00:23:24,160 --> 00:23:26,250
هل يمكنك توقّع مستقبلي؟

335
00:23:26,250 --> 00:23:28,150
.لا مشكلة. دعني أرى

336
00:23:28,150 --> 00:23:28,880
!أنا أراه

337
00:23:28,880 --> 00:23:30,030
ماذا ترى؟

338
00:23:30,030 --> 00:23:31,960
.قد يحدث شيء جيّد غدًا

339
00:23:32,640 --> 00:23:33,710
.لكن قد لا يحدث

340
00:23:33,710 --> 00:23:34,350
ماذا؟

341
00:23:34,350 --> 00:23:36,220
.ثمن ذلك عشرة آلاف يوان

342
00:23:36,220 --> 00:23:38,320
."الحلقة القادمة من "هيتوري نو شيتا": "طعم

343
00:23:38,320 --> 00:23:39,550
.لا تفوّتوها