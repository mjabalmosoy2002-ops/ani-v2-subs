1
00:00:08,270 --> 00:00:11,790
أكان إحضار سوران وهوهو إلى هنا صوابًا؟

2
00:00:13,050 --> 00:00:14,440
.أنت تقلق كثيرًا

3
00:00:14,910 --> 00:00:17,590
.دعهما يفعلان ما يحلو لهما اللّيلة

4
00:00:18,370 --> 00:00:22,240
.أخفى سوران حقيقة أنّه دخيل حتّى الآن

5
00:00:22,640 --> 00:00:27,950
،مضى وقت طويل مذ التقيناه
.لكنّني لم أره أبدًا بهذه السّعادة

6
00:00:25,160 --> 00:00:26,460
.خذ المزيد

7
00:00:26,930 --> 00:00:28,610
!ما الّذي تفعله؟

8
00:00:28,980 --> 00:00:31,840
.على الأرجح كان يكبح نفسه لوقت طويل

9
00:00:32,460 --> 00:00:35,660
.لا بأس أن يطلق العنان لنفسه من حين لآخر

10
00:00:35,660 --> 00:00:37,670
!يا رفاق

11
00:00:38,930 --> 00:00:41,680
هل تريدون رؤية ****ي إلى هذا الحدّ؟

12
00:00:41,920 --> 00:00:43,780
!قم بذلك يا تشو سوران

13
00:00:43,780 --> 00:00:44,940
!أرنا

14
00:00:44,340 --> 00:00:45,710
!هيّا

15
00:00:45,710 --> 00:00:46,760
!يمكنك ذلك

16
00:00:47,930 --> 00:00:49,400
!هيّا

17
00:00:49,400 --> 00:00:50,560
.ها أنا ذا

18
00:00:50,790 --> 00:00:53,280
!هذا تشو سوران

19
00:00:55,910 --> 00:00:57,070
.أنا أراها

20
00:00:57,070 --> 00:01:00,070
.لديه رموز غامضة

21
00:01:00,070 --> 00:01:02,330
لكن لسوء الحظّ هذا النّور الغامض
!يجعل كلّ شيء ضبابيًّا

22
00:01:02,690 --> 00:01:04,160
نور غامض؟

23
00:01:05,660 --> 00:01:07,450
.هذا لا يهمّ

24
00:01:07,450 --> 00:01:10,470
!افتحوا عيون قلوبكم وسترون

25
00:01:14,530 --> 00:01:16,070
!يـ-يا للروعة

26
00:01:16,070 --> 00:01:19,340
إنّها مختلفة من تلك التّصاميم
!الحديثة والمبالغ فيها

27
00:01:19,780 --> 00:01:25,270
إنّها تُبقي بساطة كلاسيكيّة محدّدة
!مع وجود جمال فريد وغامض

28
00:01:26,390 --> 00:01:29,130
!مذهل! إنّها رائعة

29
00:01:30,750 --> 00:01:31,900
ما رأيكم؟

30
00:01:31,900 --> 00:01:33,970
تشو سوران رجل بحقّ، أليس كذلك؟

31
00:01:33,970 --> 00:01:35,380
!انظروا! انظروا

32
00:01:37,140 --> 00:01:40,110
.كان معلّمي مخطئًا

33
00:01:40,110 --> 00:01:43,570
ما كان ينبغي علينا السّماح بدخول
.هذا الغبيّ إلى ريوكوسان

34
00:01:46,180 --> 00:01:47,450
.يا إلهي

35
00:01:51,770 --> 00:01:56,540
...لقد رفضتني بسبب قصر طولي فقط

36
00:01:56,870 --> 00:01:59,220
.إنّها لئيمة

37
00:01:59,220 --> 00:02:00,560
.فو هوهو

38
00:02:02,070 --> 00:02:04,340
.لا بدّ أنّك تشعرين بالملل وحدك

39
00:02:04,340 --> 00:02:05,940
.تعالي واشربي معنا

40
00:02:08,030 --> 00:02:08,730
.حسنًا

41
00:04:00,510 --> 00:04:18,640
!تنُشر مانغا "هيتوري نو شيتا - المنبوذ" في شونين جامب الآن

42
00:04:01,390 --> 00:04:04,040
.لم يحدث شيء اللّيلة الماضية

43
00:04:04,040 --> 00:04:05,530
صحيح؟

44
00:04:06,450 --> 00:04:10,260
،شربت قليلاً فقط وأنا أنظر إلى القمر
.ثم ذهبت للنّوم

45
00:04:11,380 --> 00:04:12,990
صحيح يا رفاق؟

46
00:04:12,990 --> 00:04:18,020
.نعم، ورأينا سوران الصّغير في ضوء القمر

47
00:04:18,670 --> 00:04:21,650
.ثمّ تحوّل سوران الصّغير إلى عنقاء

48
00:04:21,970 --> 00:04:26,210
وفي النّهاية، تحوّلت عنقاؤك إلى نقّار
.خشب ونقر على بعض الأشجار

49
00:04:25,380 --> 00:04:28,230
!يكفي! لا أريد سماع المزيد

50
00:04:28,230 --> 00:04:31,240
.الجميع يرتكبون الأخطاء يا بنيّ

51
00:04:31,730 --> 00:04:36,280
مع أنّني لم أتوقّع رؤية عنقاء بعد المجيء
.كلّ هذه المسافة إلى ريوكوسان

52
00:04:40,440 --> 00:04:42,980
.سينسى الجميع الأمر بعد بضعة أيّام

53
00:04:42,980 --> 00:04:44,040
.ربّما

54
00:04:44,700 --> 00:04:47,750
!تشو سوران، أنت أسطورة بين الدّخلاء

55
00:04:50,620 --> 00:04:53,860
لم تلتقط صورًا، صحيح؟

56
00:04:54,340 --> 00:04:57,520
.لا تقلق. لم ألتقط أيّ صور

57
00:04:58,670 --> 00:05:00,090
.صوّرت فيديو

58
00:05:02,350 --> 00:05:04,190
ما العمل يا هانا-تشان؟

59
00:05:02,350 --> 00:05:05,630
!مهلاً، انتظر! قم بحذفه

60
00:05:04,190 --> 00:05:06,980
.لا يمكنني النّظر في وجه سوران بعد الآن

61
00:05:05,990 --> 00:05:07,490
.مستحيل

62
00:05:07,490 --> 00:05:08,750
!سأكسره إذًا

63
00:05:08,590 --> 00:05:10,230
إلامَ تنظرين؟

64
00:05:08,750 --> 00:05:10,010
!أعطني هاتفك

65
00:05:10,010 --> 00:05:12,410
.أنا أمزح. لم أصوّر شيئًا

66
00:05:12,410 --> 00:05:13,400
!لا تكذب عليّ

67
00:05:12,670 --> 00:05:14,370
.دعيها

68
00:05:14,710 --> 00:05:17,910
.نسخت هانا-تشان جميع الرّموز في ختمه

69
00:05:17,910 --> 00:05:21,180
.إنّها مهووسة بها تمامًا الآن

70
00:05:25,940 --> 00:05:29,300
!أنت! انزل إلى هنا أيّها الوغد

71
00:05:29,300 --> 00:05:31,250
.تسلّق أنت إلى هنا

72
00:05:31,250 --> 00:05:33,130
ألست نقّار خشب؟

73
00:05:33,130 --> 00:05:36,680
!أيّها الوغد! ستدفع الثّمن بمجرّد نزولك إلى هنا

74
00:05:37,030 --> 00:05:39,120
!هل فهمت؟ تذكّر ذلك

75
00:05:39,480 --> 00:05:42,080
!استمع إليّ يا هذا

76
00:05:42,080 --> 00:05:42,900
...أليس ذلك

77
00:05:44,400 --> 00:05:48,290
.يا تشو سوران. من الأفضل أن تعود إلى الحلبة

78
00:05:48,290 --> 00:05:51,060
.خصمك التّالي هناك

79
00:05:51,820 --> 00:05:53,320
...لا يمكنني أن أرى

80
00:05:53,980 --> 00:05:56,000
...خصمي هو

81
00:05:56,390 --> 00:05:58,040
تو بونريو؟

82
00:05:58,880 --> 00:06:05,170
حتّى وإن فزت بهذه الجولة، فخصمي التّالي
.سيكون إمّا شوكاتسو سي أو أويا-سان

83
00:06:05,810 --> 00:06:12,070
،قال الشّيوخ أنّهم سحبوا القرعة
.لكنّك سيّئ الحظّ حقًّا

84
00:06:12,070 --> 00:06:15,250
.لن تكون باقي مبارياتك سهلة

85
00:06:15,500 --> 00:06:20,060
تبًّا. كما أنّ الوقت قد فات لأطلب
...من هو-ني التّخلّص منهم

86
00:06:20,060 --> 00:06:21,450
ماذا أفعل؟

87
00:06:28,290 --> 00:06:30,240
.يا زوريو

88
00:06:30,740 --> 00:06:33,110
.لديّ عرض جيّد لك

89
00:06:33,110 --> 00:06:34,840
لِمَ لا تأتي معي؟

90
00:06:35,720 --> 00:06:39,900
فليدخل جميع المشاركين
.إلى الحلبة في الحال رجاءً

91
00:06:40,420 --> 00:06:42,860
.تشو سوران ضدّ تو بونريو

92
00:06:42,860 --> 00:06:44,980
.فو هوهو ضدّ شوشو

93
00:06:44,980 --> 00:06:46,600
.هذه أنا

94
00:06:47,040 --> 00:06:48,160
.فو هوهو

95
00:06:49,210 --> 00:06:52,140
.أنا لا أحبّ القتال

96
00:06:52,470 --> 00:06:55,600
.لا تغترّي بنفسك فقط لأنّك هزمتني

97
00:06:56,020 --> 00:07:01,870
الشّينكي الخاصّ بشوشو أقوى بكثير
.من ناغارينيجي خاصّتي

98
00:07:01,870 --> 00:07:03,850
.من الأفضل أن تكوني حذرة

99
00:07:04,590 --> 00:07:07,820
.سيهزمك بسهولة إن اقتربت منه بتهوّر

100
00:07:07,820 --> 00:07:11,250
،إن كنت لا تستطيعين استعمال قذائف
.فمن الأفضل أن تستسلمي

101
00:07:11,250 --> 00:07:12,060
!أنت

102
00:07:12,060 --> 00:07:14,360
هذا مؤلم! لِمَ فعلت ذلك؟

103
00:07:14,360 --> 00:07:16,360
إلى جانب من أنت؟

104
00:07:16,360 --> 00:07:18,460
لِمَ تكشف لها عن خططي؟

105
00:07:18,460 --> 00:07:20,880
.لم أكن أحاول ذلك

106
00:07:20,880 --> 00:07:25,490
غير معقول. أنت التّالي بمجرّد
.أن تنتهي هذه المباراة

107
00:07:29,340 --> 00:07:30,530
...فو هوهو

108
00:07:30,760 --> 00:07:32,470
.فتاة مسكينة

109
00:07:32,470 --> 00:07:36,540
.وقعت في مواجهة خصمٍ يهاجم الأرواح

110
00:07:37,990 --> 00:07:41,010
.لقد تعرضت روحها للأذى بما يكفي

111
00:07:42,510 --> 00:07:44,770
.سي-ني، أسرع

112
00:07:45,770 --> 00:07:48,000
.سنرى من هنا بشكل أفضل

113
00:07:48,580 --> 00:07:51,560
لكن لِمَ نشاهد هذه المباراة؟

114
00:07:51,560 --> 00:07:54,150
.أنا مهتمّ بمباراة تشو سوران أكثر

115
00:07:54,450 --> 00:07:57,950
هل تعرف شوشو وفو هوهو؟

116
00:07:59,550 --> 00:08:01,650
.لا أعرف أيًّا منهما

117
00:08:02,160 --> 00:08:03,500
لماذا إذًا؟

118
00:08:04,000 --> 00:08:06,610
.رأيتهم بالصّدفة

119
00:08:07,010 --> 00:08:09,110
.لذا تبعتهم

120
00:08:09,370 --> 00:08:12,290
مستحيل! ثلاثة من الشّيوخ؟

121
00:08:12,510 --> 00:08:14,850
لْمَ يتكبّدون عناء مشاهدة هذه المباراة؟

122
00:08:14,850 --> 00:08:16,840
.لهذا السّبب أشعر بالفضول

123
00:08:17,230 --> 00:08:20,840
أتوا لمشاهدة هذه المباراة
.وليس مباراة تشو سوران

124
00:08:21,250 --> 00:08:24,290
ما الّذي يجذبهم إلى هذه المباراة؟

125
00:08:25,140 --> 00:08:27,200
!تشو سوران! تشو سوران

126
00:08:27,200 --> 00:08:29,260
!ادخل إلى الحلبة في الحال

127
00:08:29,520 --> 00:08:33,690
.تشو سوران ينوي شيئًا ما مجدّدًا

128
00:08:33,690 --> 00:08:36,370
.لا، على الأرجح هرب هذه المرّة

129
00:08:36,370 --> 00:08:38,940
.فخصمه هو تو بونريو هذه المرّة

130
00:08:38,940 --> 00:08:41,050
!أعتمد عليك يا تو بونريو

131
00:08:41,050 --> 00:08:43,790
!لقّن ذلك الغشّاش الوقح درسًا

132
00:08:43,790 --> 00:08:45,680
!آمل أن تخسر يا تشو سوران

133
00:08:45,680 --> 00:08:47,470
!أيّها الغبيّ

134
00:08:47,470 --> 00:08:49,010
.اهدأ قليلاً

135
00:08:50,190 --> 00:08:51,720
.شاهد هذه المباراة عن كثب

136
00:08:53,030 --> 00:08:56,300
!تشو سوران! ادخل إلى الحلبة في الحال رجاءً

137
00:08:59,000 --> 00:09:00,940
.أتى أخيرًا

138
00:09:08,170 --> 00:09:09,460
...تشو سوران

139
00:09:09,460 --> 00:09:13,100
.خدعك لن تعمل مع تو بونريو

140
00:09:13,400 --> 00:09:18,250
!ستبدأ المباراة بين تشو سوران وتو بونريو الآن

141
00:09:20,320 --> 00:09:24,370
.تشو سوران، لديّ مباراة أخرى بعد هذه

142
00:09:24,760 --> 00:09:26,370
.لذا لنهِ هذه بسرعة

143
00:09:27,010 --> 00:09:29,270
.سررت بلقائك يا بونريو-سان

144
00:09:29,270 --> 00:09:32,370
!في تلك الحالة، لن أتساهل معك

145
00:09:34,450 --> 00:09:36,140
ما هذه السّرعة؟

146
00:09:36,870 --> 00:09:40,810
.تجنّبت ضربة حاسمة، لكنّه أصاب يدي اليسرى

147
00:09:58,960 --> 00:10:01,720
.لم أعلم أنّك كنت تخفي هذه القوّة

148
00:10:01,720 --> 00:10:03,000
.لست سيّئًا

149
00:10:03,710 --> 00:10:05,950
.لكنّ وقت اللّعب انتهى

150
00:10:07,420 --> 00:10:09,900
.سأهزمك بضبابي السّامّ

151
00:10:10,480 --> 00:10:11,920
!هيّا، تعال

152
00:10:12,670 --> 00:10:15,840
ستصاب بسمّ قويّ في المرّة التّالية
.الّتي تلمسني فيها

153
00:10:16,200 --> 00:10:17,730
.لا يمكنك أن تفوز

154
00:10:20,000 --> 00:10:21,730
مـ-ما هذا؟

155
00:10:28,480 --> 00:10:30,780
،إن كنت تحيط نفسك بضباب سامّ

156
00:10:31,360 --> 00:10:33,480
.فما عليّ سوى هزيمتك دون لمسك

157
00:10:36,770 --> 00:10:39,390
.تعال يا ريو تشوان. هنا

158
00:10:39,390 --> 00:10:41,480
ما الّذي أردت مناقشته؟

159
00:10:41,480 --> 00:10:43,450
!ستبدأ المباراة قريبًا

160
00:10:42,100 --> 00:10:45,650
.أريد معلومات عن تو بونريو

161
00:10:43,450 --> 00:10:45,780
!تشو سوران، ادخل الحلبة رجاءً

162
00:10:45,650 --> 00:10:48,910
نحن صديقان مقرّبان ما يكفي لتخبرني، صحيح؟

163
00:10:49,620 --> 00:10:52,570
هل تظنّ أنّي سأخبرك مجّانًا؟

164
00:10:52,910 --> 00:10:54,790
.اخرس وأخبرني

165
00:10:54,790 --> 00:10:57,670
.رأيت ختمي مجّانًا

166
00:10:57,670 --> 00:11:03,090
أم تريدني أن أستعمل رايهو خاصّتي
لتعود للضّمادات هذه المرّة؟

167
00:11:03,090 --> 00:11:04,810
!حسنًا، سأخبرك

168
00:11:05,510 --> 00:11:08,380
.تو بونريو مستخدم لتومون

169
00:11:08,790 --> 00:11:13,140
.احذر من الضّباب السّامّ الّذي يستعمله هؤلاء

170
00:11:13,140 --> 00:11:18,750
.ستتعرّض للسّمّ إن لمسته وهو محاط به

171
00:11:18,750 --> 00:11:22,030
.وبعد أن تصاب به، لن تكون لك أيّ فرصة للفوز

172
00:11:22,270 --> 00:11:25,020
.لذا لا تهاجمه بتهوّر

173
00:11:26,540 --> 00:11:30,070
يستعمل... تومون؟

174
00:11:30,640 --> 00:11:31,770
.هذا صحيح

175
00:11:31,770 --> 00:11:37,340
على أيّة حال، من المهمّ أن تراقب
.خصمك بهدوء بمجرد بدء المباراة

176
00:11:37,720 --> 00:11:41,860
.تشغيله لضبابه السّامّ يستهلك الكثير من الكي

177
00:11:41,860 --> 00:11:45,930
قد يكون الاشتباك معه في
.معركة تحمّل عن بعد فعّالاً

178
00:11:45,930 --> 00:11:46,980
...تومون

179
00:11:50,370 --> 00:11:53,160
...هم قتلوا جدّي

180
00:12:09,010 --> 00:12:14,460
لا عداوة لي مع هذه الفتى، لكن لا يمكنني
.التّساهل مع مستعمل تومون

181
00:12:15,160 --> 00:12:16,200
...جدّي

182
00:12:29,670 --> 00:12:35,370
.أيّها التّينشي، يبدو أنّ سوران يقاتل محارب تومون

183
00:12:35,370 --> 00:12:36,900
ألست بحاجة لمشاهدة مباراته؟

184
00:12:37,380 --> 00:12:40,940
.نتيجة المباراة سيحدّدها حظّه

185
00:12:40,940 --> 00:12:43,850
.ذهابي لن يغيّر شيئًا

186
00:12:44,260 --> 00:12:47,010
.على أيّة حال، هذه المباراة أكثر أهمّيّة الآن

187
00:12:48,240 --> 00:12:51,820
.يمكنك أن تلاحظ يا شينتشو

188
00:12:53,470 --> 00:12:59,870
أيّ مدرسة تنتمي لها تلك الفتاة
الّتي تقاتل، ومن يكون معلّمها؟

189
00:13:00,410 --> 00:13:04,420
.لا فكرة لديّ

190
00:13:04,420 --> 00:13:07,260
.إنّها تتحرّك بطريقة غريبة

191
00:13:08,590 --> 00:13:10,770
.حركاتها مليئة بالثّغرات

192
00:13:10,770 --> 00:13:13,760
.يجب أن تكون قد هُزمت الآن عادةً

193
00:13:14,230 --> 00:13:20,620
لكنّها تتمكّن دائمًا من تفادي
.الضّربات الحاسمة في آخر لحظة

194
00:13:22,220 --> 00:13:26,760
لا يمكنك رؤية الأمر لأنّ عينيك
.على سوران فقط

195
00:13:27,490 --> 00:13:28,860
ماذا تقصد؟

196
00:13:29,630 --> 00:13:33,630
ألم تلاحظ عندما قابلنا تلك الفتاة بالأمس؟

197
00:13:34,880 --> 00:13:36,570
.عيناها

198
00:13:36,570 --> 00:13:37,660
عيناها؟

199
00:13:38,850 --> 00:13:42,510
.يبدو أنّك لا تفهم ما يتحدّث ريكوكين عنه

200
00:13:42,510 --> 00:13:45,230
.انظر إلى عينيّ

201
00:13:46,340 --> 00:13:48,480
أين هي عيناك؟

202
00:13:48,480 --> 00:13:50,350
،لديك الكثير من التّجاعيد
.لذا لا يمكنني إيجادهما

203
00:13:50,350 --> 00:13:52,430
هل تريدني أن أدفعك من هنا؟

204
00:13:53,870 --> 00:13:57,850
.أنا أمزح. أعلم ما تحاول قوله

205
00:13:58,490 --> 00:14:02,640
.للنّاس العاديّين نور في أعينهم

206
00:14:03,400 --> 00:14:10,400
لكنّ ذلك النّور انطفأ من عينيك
.بعد مائة سنة من التّدريب

207
00:14:10,630 --> 00:14:17,740
لكنّ تلكما العينين الطّبيعيّتين الهامدتين
.دليل على قوّتك الإلهيّة

208
00:14:18,950 --> 00:14:20,460
...لكن أيّها التّينشي

209
00:14:21,030 --> 00:14:25,670
.يستغرق الوصول إلى مستواك مائة عام

210
00:14:25,670 --> 00:14:31,860
هل تريد القول أنّها وصلت إليه بالفعل؟

211
00:14:32,770 --> 00:14:35,680
.لا يمكن. ذلك مستحيل

212
00:14:36,180 --> 00:14:41,900
أنت محقّ. من الممكن أنّها لم تصل
.إلى ذلك المستوى

213
00:14:42,320 --> 00:14:47,320
تحرّكاتها عبارة عن ردود أفعال
.حدسيّة تستند على غريزتها

214
00:14:47,320 --> 00:14:52,590
.إنّها مناسبة للتّدريب على الأرجح فطريًّا

215
00:14:52,590 --> 00:14:56,770
الشّباب لا يمنع المرء من الحصول
.على القوّة الإلهيّة

216
00:14:57,350 --> 00:15:01,180
.لا تقل لي أنّك نسيت أمره أيّها التّينشي

217
00:15:04,180 --> 00:15:05,960
.لا، انس الأمر

218
00:15:06,450 --> 00:15:09,670
.سيضعك ذلك في مزاج سيّئ فحسب

219
00:15:11,450 --> 00:15:14,170
.لا تقلق بشأني يا ريكوكين

220
00:15:14,170 --> 00:15:15,980
.ليس للأمر علاقة بذلك الشّيطان

221
00:15:16,590 --> 00:15:20,760
.ينتابني الفضول حولها فحسب

222
00:15:21,500 --> 00:15:26,480
أنت دائمًا ما تريد تبنّي أيّ شخصٍ
،يملك الإمكانيّات كتلميذ

223
00:15:26,480 --> 00:15:29,080
.لكن ينبغي عليك أن تنسى أمرها

224
00:15:29,390 --> 00:15:31,190
.إنّها غامضة أكثر من اللاّزم

225
00:15:31,820 --> 00:15:37,280
حقًّا؟ أليست مجرّد موظّفة
في شركة التّوصيل السّريع؟

226
00:15:37,600 --> 00:15:43,320
،أرسلت أتباعي للبحث في خلفيّتها
.لكنّهم لم يجدوا إلاّ القليل

227
00:15:44,020 --> 00:15:50,020
كلّ ما علموه هو أنّها تعمل بدوام
.جزئيّ لشركة التّوصيل السّريع

228
00:15:50,730 --> 00:15:52,330
دوام جزئيّ؟

229
00:15:52,330 --> 00:15:55,540
هذا يجعل أمر استقطابها أسهل
.من استقطاب موظّف عاديّ

230
00:15:56,350 --> 00:15:59,480
،أشكّ في أنّك تعلم هذا

231
00:15:59,930 --> 00:16:04,980
لكنّ موظّفي الدّوام الجزئيّ مميّزون بشكل
.استثنائيّ في شركة التّوصيل السّريع

232
00:16:05,780 --> 00:16:07,730
!ماذا؟ مستحيل

233
00:16:06,880 --> 00:16:08,320
...كان ذلك سريعًا

234
00:16:09,380 --> 00:16:11,270
!بربكم

235
00:16:11,860 --> 00:16:13,250
.كان ذلك سريعًا جدًّا

236
00:16:13,510 --> 00:16:17,620
هل كان سوران دائمًا بهذه القوّة؟

237
00:16:17,620 --> 00:16:20,770
.لا أصدّق أنّه هزم تو بونريو في لحظة

238
00:16:20,770 --> 00:16:28,380
لا، اعتمادًا على هذه المباراة، لا أعتقد
.أنّ سوران-كن أقوى من تو بونريو

239
00:16:28,380 --> 00:16:30,170
.إنّهما متساويان على الأقلّ

240
00:16:31,230 --> 00:16:33,890
.استخفّ تو بونريو بسوران-كن

241
00:16:34,230 --> 00:16:40,840
،وبما أنّ سوران-كن قاتل بكلّ قوته من البداية
.فقد تحكّم بمجريات المباراة

242
00:16:42,390 --> 00:16:47,560
،لكن لو أنّ سوران-كن قاتل في المباريات السّابقة

243
00:16:47,860 --> 00:16:51,690
.لما ظنّ تو بونريو أنّه أضعف منه

244
00:16:52,700 --> 00:16:54,980
ربّما كانت جميع مباريات

245
00:16:54,980 --> 00:16:58,160
.هذه البطولة تسير وقف رغبة سوران-كن

246
00:16:59,740 --> 00:17:02,070
.إنّه فتى مثير للاهتمام حقًّا

247
00:17:03,010 --> 00:17:05,400
!هذا مستحيل

248
00:17:05,760 --> 00:17:08,540
كيف تمكّن ذلك الجبان من الفوز؟

249
00:17:09,150 --> 00:17:12,290
.أنت مخطئ في نقطة واحدة

250
00:17:13,210 --> 00:17:16,370
.الجبن لا يعني الضّعف دائمًا

251
00:17:16,370 --> 00:17:20,950
عجبًا! هل أنت زين شيدو الأوكامي؟

252
00:17:21,360 --> 00:17:23,270
لِمَ انسحبت من مباراتك في ذلك اليوم؟

253
00:17:23,630 --> 00:17:26,950
كيف لك أن تترك تشو سوران يفوز بتلك السّهولة؟

254
00:17:27,720 --> 00:17:32,040
.علمت مدى ضعفي في ذلك اليوم

255
00:17:41,010 --> 00:17:44,600
ما الخطب يا زين-سان؟
هل ستنسحب بهذه السّرعة؟

256
00:17:44,600 --> 00:17:47,030
.لكنّك تكاد تهزمني

257
00:17:47,030 --> 00:17:50,280
.إن هزمتني، ستتمكّن من الانتقام من هو-ني

258
00:17:50,890 --> 00:17:54,160
.لقد عطّلت تمائمك الكي في ذراعي

259
00:17:54,500 --> 00:17:57,010
.إنّها الفرصة المثاليّة لهزيمتي

260
00:17:57,010 --> 00:17:58,970
ما الّذي ترمي إليه؟

261
00:17:59,350 --> 00:18:03,440
.كنت تتجاهل فرصًا كثيرة لمهاجمتي عمدًا

262
00:18:04,180 --> 00:18:05,680
هل تهزأ بي؟

263
00:18:05,680 --> 00:18:09,120
.بـ-بالطّبع لا. هذا سوء فهم فقط

264
00:18:09,120 --> 00:18:13,390
.أردت فقط أن أقاتلك لأطول وقت ممكن

265
00:18:13,750 --> 00:18:15,890
.ذلك يفيدني أيضًا

266
00:18:15,890 --> 00:18:18,070
يفيدك؟ كيف؟

267
00:18:19,080 --> 00:18:24,740
في الحقيقة وبعكس البقيّة، لم تسنح لي
.الكثير من الفرص لقتال الدّخلاء

268
00:18:25,240 --> 00:18:29,780
لذا هذه فرصة مثاليّة جدًّا لي لأقاتل

269
00:18:29,780 --> 00:18:31,540
.مخضرمًا مثلك قبل مباراتي

270
00:18:32,090 --> 00:18:36,170
كما أنّ رغبتك في الانتقام من هو-ني

271
00:18:36,170 --> 00:18:38,800
.ستجعلك تقاتل بكلّ قوّتك لهزيمتي

272
00:18:39,810 --> 00:18:44,110
،وبما أنّها ليست مباراة رسميّة
.فلن يضرّني الفوز أو الخسارة

273
00:18:44,110 --> 00:18:45,130
.حالة مربحة من جميع الجوانب

274
00:18:45,700 --> 00:18:49,420
استعملتني للتّدريب إذًا؟

275
00:18:49,420 --> 00:18:50,240
.هذا صحيح

276
00:18:50,240 --> 00:18:51,270
!كيف تجرؤ؟

277
00:18:51,270 --> 00:18:54,670
.لكنّ الأمر لا يضرّك أيضًا

278
00:18:54,670 --> 00:18:55,560
ماذا؟

279
00:18:56,060 --> 00:18:59,160
ساعدك هذا القتال في إدراك
نقطة ضعفك، أليس كذلك؟

280
00:19:00,560 --> 00:19:03,700
.تمائمك مذهلة حقًّا

281
00:19:03,700 --> 00:19:06,390
.إنّها قويّة جدًّا لدرجة أنّك تعتمد عليها كثيرًا

282
00:19:07,390 --> 00:19:12,290
وعلى ما يبدو، تزداد قوّتها كلّما
.أضفت إليها المزيد من الكي

283
00:19:13,070 --> 00:19:17,080
،لكن عندما تشغّل تمائمك

284
00:19:17,080 --> 00:19:20,140
.تضع فيها الكثير من الكي لا شعوريًّا

285
00:19:20,360 --> 00:19:23,800
وفي تلك اللّحظة الّتي تمضيها بوضع
،الكثير من الكي في تمائمك

286
00:19:23,800 --> 00:19:26,470
.تمنح لخصمك فرصة لتجنّبها

287
00:19:27,060 --> 00:19:30,470
لذلك السّبب كنت تواجه صعوبة
.كبيرة في إصابتي بتمائمك

288
00:19:31,740 --> 00:19:37,190
،لو لم أرِد اختبار قوّتها
.لربّما ما تمكّنت من إصابتي ولو مرّة

289
00:19:38,650 --> 00:19:41,040
.على أيّة حال، لنتابع

290
00:19:41,040 --> 00:19:44,710
هذه المرّة، احرص على ألاّ
.تستجمع الكثير من الكي

291
00:19:45,860 --> 00:19:46,800
.هذا سخيف

292
00:19:47,480 --> 00:19:49,570
مهلاً يا زين-سان، إلى أين أنت ذاهب؟

293
00:19:50,130 --> 00:19:54,080
.سأغادر. لا نيّة لي في مساعدتك على التّدرّب

294
00:19:54,080 --> 00:19:57,000
.لا تكن هكذا. لنتابع القتال

295
00:19:57,000 --> 00:19:58,790
.لا يجدر بنا تضييع هذه الفرصة

296
00:19:59,430 --> 00:20:00,370
...تلك الفتاة

297
00:20:00,930 --> 00:20:02,290
.تلك الفتاة الّتي بجانبك

298
00:20:02,830 --> 00:20:07,140
أصحيح أنّها أقوى منك بكثير؟

299
00:20:07,540 --> 00:20:08,880
.بالطّبع

300
00:20:08,880 --> 00:20:15,110
ما رأيك أن نتوقّف عن قتال بعضنا
ونقاتل هو-ني بدلاً عن ذلك؟

301
00:20:15,110 --> 00:20:16,740
.أنا واثق أنّ ذلك سيكون تدريبًا رائعًا

302
00:20:17,520 --> 00:20:18,870
كلانا ضدّها؟

303
00:20:19,310 --> 00:20:22,490
.نعم، لا بأس. تعاليا

304
00:20:23,730 --> 00:20:26,000
.هذا يكفي. سوف أذهب

305
00:20:28,040 --> 00:20:29,200
...تشو سوران

306
00:20:29,770 --> 00:20:33,200
.أصبح أكثر قوّة من تلك اللّيلة

307
00:20:34,830 --> 00:20:39,530
.يبدو أنّ عليّ أن أبدأ تدريبي من البداية

308
00:20:41,840 --> 00:20:43,690
.جو سان، جو يون

309
00:20:45,210 --> 00:20:47,860
سوران-كن؟ ماذا عن مباراتك؟

310
00:20:48,140 --> 00:20:49,800
.لقد انتهت بالفعل

311
00:20:49,800 --> 00:20:52,100
ينبغي أن تنتهي هو-ني قريبًا، أليس كذلك؟

312
00:20:52,750 --> 00:20:55,480
.في الواقع، إنّها تعاني أكثر مما توقعنا

313
00:20:57,730 --> 00:21:00,110
.أشعر بالدّوار

314
00:21:00,720 --> 00:21:02,260
!أنت عرضة للهجوم

315
00:21:10,870 --> 00:21:13,950
.سيهزمك بسهولة إن اقتربت منه بتهوّر

316
00:21:13,950 --> 00:21:17,430
،إن كنت لا تستطيعين استعمال قذائف
.فمن الأفضل أن تستسلمي

317
00:21:17,430 --> 00:21:18,300
!أنت

318
00:21:18,300 --> 00:21:19,510
!هذا مؤلم

319
00:21:21,980 --> 00:21:24,680
.عليّ فقط أن أبقى بعيدة عنه إذًا

320
00:21:28,720 --> 00:21:31,610
.تقنيات قبضة مونزيتسو الثّمانية والأربعين المطلقة

321
00:21:32,540 --> 00:21:34,060
.بوكّاكي

322
00:23:05,020 --> 00:23:06,590
!سي-ني، سي-ني

323
00:23:05,030 --> 00:23:06,280
الحلقة القادمة

324
00:23:06,590 --> 00:23:07,830
!إنّه عرض الحلقة التّالية المسبق

325
00:23:07,830 --> 00:23:09,530
!عمّ علينا التّحدّث؟ أنا متحمّس جدًّا

326
00:23:09,530 --> 00:23:11,400
.اهدأ يا هاكو

327
00:23:11,400 --> 00:23:13,280
.لن يذهب العرض المسبق لأيّ مكان

328
00:23:13,280 --> 00:23:14,830
كيف يمكنك أن تكون بهذا الهدوء؟

329
00:23:14,830 --> 00:23:16,870
!سينتهي العرض المسبق إن لم نسرع

330
00:23:16,870 --> 00:23:18,370
.ماذا؟ هذا ليس جيّدًا

331
00:23:18,370 --> 00:23:20,040
،"في الحلقة القادمة من "هيتوري نو شيتا

332
00:23:20,040 --> 00:23:22,460
...المعركة الحامية بين فو هوهو وشوشو

333
00:23:22,460 --> 00:23:23,730
.ستتوّقف لبعض الوقت

334
00:23:23,730 --> 00:23:24,450
.لا أحد يهتمّ لذلك

335
00:23:24,450 --> 00:23:27,620
هذا صحيح. حلقة الأسبوع القادم سيكون
.فيها شوكاتسو سي ضدّ أويا

336
00:23:27,620 --> 00:23:29,220
!أنت جزء كبير من الحلقة

337
00:23:29,220 --> 00:23:31,100
الكيمون تونكو خاصّتك سيرنّ
!بصوت عالٍ وواضح

338
00:23:31,100 --> 00:23:33,170
وتقنيّة خاصّة جديد أيضًا؟

339
00:23:33,170 --> 00:23:36,060
:"في الحلقة القادمة من "هيتوري نو شيتا
."كيمون كينزو شينبو"

340
00:23:36,060 --> 00:23:39,350
.ستكون حلقة خاصّة لشوكاتسو سي