1
00:00:06,170 --> 00:00:09,230
.إنّها تتحرّك بطريقة غريبة

2
00:00:09,230 --> 00:00:11,740
.حركاتها مليئة بالثّغرات

3
00:00:11,740 --> 00:00:14,860
.يجب أن تكون قد هُزمت الآن عادةً

4
00:00:15,550 --> 00:00:21,330
،أرسلت أتباعي للبحث في خلفيّتها
.لكنّهم لم يجدوا إلاّ القليل

5
00:00:22,070 --> 00:00:28,420
كلّ ما علموه هو أنّها تعمل بدوام
.جزئيّ لشركة التّوصيل السّريع

6
00:00:28,420 --> 00:00:30,260
دوام جزئيّ؟

7
00:00:30,260 --> 00:00:33,460
هذا يجعل أمر استقطابها أسهل
.من استقطاب موظّف عاديّ

8
00:00:34,030 --> 00:00:37,180
،أشكّ في أنّك تعلم هذا

9
00:00:37,550 --> 00:00:42,550
لكنّ موظّفي الدّوام الجزئيّ مميّزون بشكل
.استثنائيّ في شركة التّوصيل السّريع

10
00:00:42,910 --> 00:00:44,380
.جو سان، جو يون

11
00:00:44,740 --> 00:00:47,580
سوران-كن؟ ماذا عن مباراتك؟

12
00:00:47,580 --> 00:00:49,350
.لقد انتهت بالفعل

13
00:00:49,350 --> 00:00:51,640
ينبغي أن تنتهي هو-ني قريبًا، أليس كذلك؟

14
00:00:51,640 --> 00:00:54,990
.في الواقع، إنّها تعاني أكثر مما توقعنا

15
00:00:57,140 --> 00:00:58,720
!أنت عرضة للهجوم

16
00:01:06,070 --> 00:01:10,130
،إن كنت لا تستطيعين استعمال قذائف
.فمن الأفضل أن تستسلمي

17
00:01:16,640 --> 00:01:19,470
تقنيات قبضة مونزيتسو
.الثّمانية والأربعين المطلقة

18
00:01:20,010 --> 00:01:21,540
.بوكّاكي

19
00:03:00,830 --> 00:03:02,010
!تبًّا

20
00:03:02,010 --> 00:03:04,610
!لقد خدعتني أيّها الوغد

21
00:03:04,610 --> 00:03:08,580
حقير! ما رأيك بهذا؟

22
00:03:09,290 --> 00:03:14,500
!لن تهزمني أبدًا

23
00:03:16,420 --> 00:03:17,490
!ماذا؟ مستحيل

24
00:03:17,490 --> 00:03:18,140
حقًّا؟

25
00:03:18,420 --> 00:03:19,490
!مهلاً

26
00:03:19,750 --> 00:03:21,930
!تبًّا، تبًّا، تبًّا

27
00:03:21,930 --> 00:03:22,950
!مهلاً، مهلاً

28
00:03:24,550 --> 00:03:26,110
!حقًّا؟

29
00:03:26,110 --> 00:03:28,370
!هذا ليس عدلاً

30
00:03:30,040 --> 00:03:31,450
.أنت سيّئ

31
00:03:31,450 --> 00:03:33,450
.إنّه خطأ جهاز التّحكم

32
00:03:33,450 --> 00:03:37,850
يبدو أنّنا دخلنا عصرًا يفضّل قتال
.المدى البعيد عن القريب

33
00:03:39,720 --> 00:03:45,280
هوهو، يمكنك توسيع ذخيرتك
.بتعلّم استعمال القذائف أيضًا

34
00:03:46,390 --> 00:03:47,480
.سأحاول

35
00:03:57,770 --> 00:03:59,970
هل ستجرّبين هذا حقًّا يا هوهو؟

36
00:04:00,290 --> 00:04:03,910
سيكون من المفيد أن أتعلّم
.لكم خصومي من بعيد

37
00:04:07,420 --> 00:04:09,210
...ها

38
00:04:09,210 --> 00:04:10,060
!هاهوكين

39
00:04:27,480 --> 00:04:29,670
.هذا غريب

40
00:04:30,020 --> 00:04:31,240
.قلت لك

41
00:04:31,240 --> 00:04:34,520
.إطلاق كرات من الكي ليس بتلك السّهولة

42
00:04:34,520 --> 00:04:39,250
لا يمكنك ذلك دون تعلّم طريقة
.خاصّة في إدارة تدفّق الكي خاصّتك

43
00:04:39,960 --> 00:04:44,350
،إن كنت تريدين تعلّم ذلك حقًّا
.فسأعرّفك على معلّم جيّد

44
00:04:44,980 --> 00:04:46,390
.هذا ليس ضروريًّا

45
00:04:46,390 --> 00:04:49,410
.أعرف سلفًا الخطأ الّذي أقوم به

46
00:04:50,620 --> 00:04:53,590
.لا أطلق ما يكفي من الكي

47
00:04:59,380 --> 00:05:00,730
...هـ-هذا

48
00:05:12,000 --> 00:05:16,210
ضربة واحدة من كرة كي ضخمة
.كتلك ستنهي أمري

49
00:05:28,020 --> 00:05:29,670
.للأسف

50
00:05:29,670 --> 00:05:33,210
.ليست سريعة ما يكفي لإصابتي

51
00:05:36,980 --> 00:05:38,180
.فهمت

52
00:05:44,190 --> 00:05:47,050
!بوكّاكي متكرّرة

53
00:05:48,450 --> 00:05:49,870
مـ-ماذا؟

54
00:05:56,560 --> 00:06:01,370
أشعر بالفضول تجاه تقنيّات قبضة مونزيتسو
.الثّمانية والأربعين المطلقة الأخرى

55
00:06:01,860 --> 00:06:07,770
قد تكون بذيئة، لكنّها ساعدت
.هوهو-تشان على الفوز

56
00:06:07,770 --> 00:06:09,210
.يمكنك شكري على ذلك

57
00:06:18,400 --> 00:06:19,900
لم أصب بأذى؟

58
00:06:19,900 --> 00:06:21,510
ما الّذي يجري؟

59
00:06:21,510 --> 00:06:24,440
ألم تكن تحاول إلحاق الضّرر بي؟

60
00:06:26,260 --> 00:06:30,640
أكان سمًّا؟ شلل؟ لا، وهم؟

61
00:06:30,640 --> 00:06:34,400
ما زالتْ قويّة بما يكفي لحزّ
.علبة فارغة فحسب

62
00:06:34,710 --> 00:06:35,800
علبة؟

63
00:06:39,980 --> 00:06:42,630
ما كان ذلك؟

64
00:06:42,630 --> 00:06:45,810
.لم أر فتاة مثيرة للاهتمام مثلها من قبل

65
00:06:46,550 --> 00:06:51,750
كنت أتوقّع تقنية خاصّة، لكنّها
.أطلقت كرات من الكي فحسب

66
00:06:53,420 --> 00:07:00,560
إن تصوّرت الكي كنقود، فعادة
.تستعمل النقود لشراء الأسلحة

67
00:07:00,560 --> 00:07:06,430
لكنّها كما لو كانت تضرب خصمها
.بتلك الفواتير بيأس

68
00:07:06,430 --> 00:07:13,880
كما أنّ استهلاك هذا الكمّ من الكي بتهوّر
.يطيح بالأشخاص العاديّين بسرعة

69
00:07:14,370 --> 00:07:17,040
.يبدو أنّ الإشاعات صحيحة

70
00:07:17,890 --> 00:07:21,730
موظّفو الدّوام الجزئيّ لدى شركة
.التّوصيل السّريع ليسوا عاديّين أبدًا

71
00:07:22,670 --> 00:07:25,450
!تبًّا! لقد خدعتني

72
00:07:25,450 --> 00:07:27,290
.يا هوهو

73
00:07:27,880 --> 00:07:30,870
ألا يمكنك جعل البوكّاكي أكثر قوّة؟

74
00:07:31,460 --> 00:07:32,640
.لا يمكنني

75
00:07:32,640 --> 00:07:34,670
لم أطلق على شيء سوى العلب
.الفارغة من قبل

76
00:07:35,250 --> 00:07:38,070
—إذًا استهدفي وجهه عندما

77
00:07:38,550 --> 00:07:40,320
!اخرس

78
00:07:40,320 --> 00:07:41,510
...رأسي

79
00:07:41,510 --> 00:07:43,310
.لا تقلق يا جو يون

80
00:07:43,310 --> 00:07:45,240
.لن أخسر

81
00:07:45,240 --> 00:07:47,360
.هجماته لن تنجح ضدّي بعد الآن

82
00:07:48,030 --> 00:07:49,040
ماذا؟

83
00:07:49,570 --> 00:07:52,090
هل اكتشفت أمر شينكي خاصّتي؟

84
00:07:52,920 --> 00:07:55,230
!لن أصدّق هذه الكذبة

85
00:07:55,230 --> 00:07:57,290
!لا فرصة لديك في الفوز

86
00:08:13,300 --> 00:08:14,290
هل تفادتها؟

87
00:08:23,460 --> 00:08:25,660
.لم تكن تكذب

88
00:08:25,940 --> 00:08:28,730
ينتشر الشّينكي خاصّتي في منطقة واسعة
،كلما زادت المسافة الّتي يقطعها

89
00:08:28,730 --> 00:08:30,530
.ما يجعل تفاديه صعبًا أكثر

90
00:08:30,970 --> 00:08:35,300
.وبينما هو قويّ عن قرب، إلاّ أنّ تفاديه أسهل

91
00:08:37,160 --> 00:08:41,290
سأعترف أنّ القفز إلى المدى القريب
...تطلب الجرأة، لكن

92
00:08:48,850 --> 00:08:50,970
!لا يمكنك الهرب من الشّينكي خاصّتي

93
00:08:57,220 --> 00:08:58,050
ماذا؟

94
00:09:12,430 --> 00:09:13,500
.انتهى الأمر

95
00:09:14,660 --> 00:09:20,080
كيف تعلّمت فو هوهو توقّع
الشّينكي الخاصّ بشوشو؟

96
00:09:20,540 --> 00:09:22,570
.لم تكن تتوقّعه

97
00:09:22,570 --> 00:09:25,560
.بل كانت تراقب أنفاس شوشو

98
00:09:26,160 --> 00:09:29,570
إنّ شينكي هو أسلوب كونغ فو يشمل جمع
.الكي في مركز الطّاقة الخاصّ بك وإطلاقه

99
00:09:30,080 --> 00:09:35,740
يجعل حنجرتك وصدرك ومعدتك تبدو
.مختلفة قليلاً عن التّنفّس العاديّ

100
00:09:36,430 --> 00:09:40,050
حتّى وإن فهمت الأمر، فما زال من الصّعب

101
00:09:40,050 --> 00:09:43,520
ملاحظة تلك التّغييرات الدّقيقة
.أثناء قتال خصم ما

102
00:09:43,990 --> 00:09:48,210
هل يمكن أن يكون لي ذلك التّركيز
الثّابت الّذي يتطلّبه فعل ذلك؟

103
00:09:48,470 --> 00:09:50,240
!انظروا إلى ذلك

104
00:09:50,520 --> 00:09:51,770
!هذا ليس جيّدًا

105
00:09:51,770 --> 00:09:55,570
لقد تحطّمت روحه بعد تلقّيه
!لضربة من الشّينكي الخاصّ به

106
00:09:57,460 --> 00:10:01,420
ألا يمكنه التّحكّم في قوّته الخاصّة؟

107
00:10:01,420 --> 00:10:04,370
.يبدو أنّني سأذهب لضبط الأمر

108
00:10:04,880 --> 00:10:06,790
.انتظر أيّها التّينشي

109
00:10:07,190 --> 00:10:10,160
.فلندع الشّباب يتولّون الأمر

110
00:10:10,730 --> 00:10:13,830
.أنا واثق أن هناك شيئًا يمكنهم فعله

111
00:10:33,930 --> 00:10:36,670
.إنّها تحاول امتصاص جميع بقايا روحه

112
00:10:36,670 --> 00:10:39,230
.تلك الفتاة غبيّة محبوبة حقًّا

113
00:10:39,230 --> 00:10:43,130
.لنر كم من الوقت يمكنها حبسها بداخلها

114
00:10:43,550 --> 00:10:45,990
هل هو-ني بخير؟

115
00:11:03,810 --> 00:11:06,770
.حان الوقت لأتدخّل

116
00:11:06,770 --> 00:11:09,320
.انتظر أيّها التّينشي

117
00:11:14,220 --> 00:11:15,930
.شيبان واغوجين

118
00:11:23,700 --> 00:11:25,400
ما الّذي يفعله؟

119
00:11:25,750 --> 00:11:30,300
.على الأرجح يضع حاجزًا كي لا تفرّ روح شوشو

120
00:11:33,690 --> 00:11:35,560
.لا بدّ أنّك بدأت تبلغين حدّك

121
00:11:36,370 --> 00:11:41,240
كيف سنجمع بقايا الرّوح المتبقيّة
داخل الحاجز الآن؟

122
00:11:41,240 --> 00:11:44,260
سيكون ذلك صعبًا حتّى بالنّسبة
.لكيمون تونكو خاصّتي

123
00:11:48,850 --> 00:11:49,950
.يا إلهي

124
00:11:50,380 --> 00:11:53,020
.أنت فتاة متهوّرة

125
00:12:03,640 --> 00:12:05,000
!فو هوهو

126
00:12:06,040 --> 00:12:08,740
.أعطني البقايا الّتي في فمك أيضًا

127
00:12:16,260 --> 00:12:17,910
!عودي الآن

128
00:12:28,580 --> 00:12:30,340
.ينبغي أن يكون بخير الآن

129
00:12:30,340 --> 00:12:31,300
.حسنًا

130
00:12:31,600 --> 00:12:35,520
.إنّه فاقد للوعي، لكنّ روحه عادت إلى جسده

131
00:12:38,620 --> 00:12:41,200
.أرأيت؟ كنت محقًّا

132
00:12:42,720 --> 00:12:46,650
.يستحق الشّباب احترامنا

133
00:12:47,650 --> 00:12:50,070
!فو هوهو هي الفائزة

134
00:12:50,890 --> 00:12:53,320
أويا وفو هوهو؟

135
00:12:54,040 --> 00:12:56,870
.كان ريغيوكو-دونو محقًّا

136
00:12:57,800 --> 00:13:03,210
يبدو أنّ عائلة شوكاتسو أصبحت منفصلة
.جدًّا عن العالم ولا تعرف شيئًا عنه

137
00:13:04,420 --> 00:13:06,340
.مهلاً يا أويا

138
00:13:08,370 --> 00:13:13,650
بما أنّكما هنا، لِمَ لا نبدأ مباراتكما؟

139
00:13:14,450 --> 00:13:17,090
.أظنّ ذلك

140
00:13:18,140 --> 00:13:22,750
!ستبدأ الآن المباراة بين أويا وشوكاتسو سي

141
00:13:27,680 --> 00:13:28,940
...أويا-سان

142
00:13:29,490 --> 00:13:32,700
،قد يكون متقنًا لتايكيوكوكين

143
00:13:32,700 --> 00:13:35,830
لكن من يدري إن كانت ستنجح أمام
.كيمون تونكو الخاصّة بشوكاتسو سي

144
00:13:36,550 --> 00:13:39,800
.أويا-دونو، أنا معجب بالكونغ فو الخاصّ بك

145
00:13:40,760 --> 00:13:45,510
.لكنّني أجد نقص حماسك للمباراة غير مرضٍ

146
00:13:45,790 --> 00:13:47,370
نقص حماس؟

147
00:13:47,850 --> 00:13:50,010
.قد تكون محقًّا

148
00:13:50,610 --> 00:13:52,660
.لكنّ الأمر يعتمد على خصمي

149
00:13:58,590 --> 00:13:59,680
.إنّه سريع

150
00:14:01,240 --> 00:14:03,010
.كفّاه قويّان للغاية

151
00:14:03,230 --> 00:14:07,270
إن سمحت لنفسي بالانجراف مع سير الكي
!خاصّته، فسيغمرني إيقاعه بالكامل

152
00:14:08,260 --> 00:14:09,110
!إينشو

153
00:14:12,030 --> 00:14:13,160
.أمسكتك

154
00:14:26,360 --> 00:14:28,170
هاكيوكوكين؟

155
00:14:28,440 --> 00:14:32,840
أويا-دونو، ألا ترى أنّك متسرّع جدًّا؟

156
00:14:33,930 --> 00:14:38,940
.لم أسئ الحكم على قوّة خصم من قبل

157
00:14:39,350 --> 00:14:43,660
.أتمنّى ألاّ تسيء الحكم على قوّتي

158
00:14:45,160 --> 00:14:47,630
كيمون تونكو الخاصّ بك هو التّالي؟

159
00:14:48,050 --> 00:14:51,330
.لقد تعلّمت حقًّا الكثير من التّقنيات

160
00:14:54,380 --> 00:14:54,880
...غون

161
00:14:56,240 --> 00:14:56,960
!كونرون

162
00:15:02,260 --> 00:15:04,130
!إنّه لا يتحرّك

163
00:15:05,340 --> 00:15:07,120
.لقد عزّزت نفسك

164
00:15:07,400 --> 00:15:12,710
لا تقل لي أنّك تظنّ أنّك قادر على هزيمتي
.بالتّايكيوكوكين خاصّتك فقط

165
00:15:15,100 --> 00:15:18,950
.في الحقيقة، لم أظنّ أنّني سأفوز بسهولة

166
00:15:18,950 --> 00:15:19,900
.مؤسف

167
00:15:20,300 --> 00:15:24,210
لا أصدّق أنّ التّايكيوكوكين
.خاصّتي غير فعّال أبدًا

168
00:15:24,210 --> 00:15:25,640
.هذا أمر محبط

169
00:15:26,150 --> 00:15:28,410
!كان سويدان

170
00:15:36,990 --> 00:15:41,590
.أويا-سان وشوكاتسو سي يهاجمان بشراسة

171
00:15:41,590 --> 00:15:43,390
ما الّذي يحاولان تحقيقه؟

172
00:15:45,440 --> 00:15:48,720
.لقد شتّت قذائفه المائيّة بجعلها تصدم بعضها

173
00:15:51,870 --> 00:15:53,300
صدّها بيديه فقط؟

174
00:15:54,920 --> 00:15:56,710
!تايكيوكو يوشو

175
00:16:00,010 --> 00:16:02,050
!كون كاواغوروما

176
00:16:04,550 --> 00:16:06,530
!كون ريوسيكي

177
00:16:13,150 --> 00:16:15,180
.شكرًا لك يا شوكاتسو سي

178
00:16:15,180 --> 00:16:20,200
.لو لم تكبح قوّتك، لقتلني ذلك الهجوم

179
00:16:21,300 --> 00:16:23,250
.لا داعي لشكري

180
00:16:23,250 --> 00:16:25,720
.يفترض بهذه المباريات أن تكون مسابقات ودّيّة

181
00:16:26,140 --> 00:16:29,870
.نحن لا نحاول قتل بعضنا بعضًا

182
00:16:29,870 --> 00:16:34,390
.لكن يبدو أنّك متساهل كثيرًا أيضًا

183
00:16:35,990 --> 00:16:39,550
.أنت متقن أساليب مثلي

184
00:16:40,190 --> 00:16:41,290
هل أنا مخطئ؟

185
00:16:42,660 --> 00:16:44,670
أويا-سان متقن أساليب أيضًا؟

186
00:16:46,100 --> 00:16:51,560
يعتبر النّاس العاديّون متقني الأساليب
.دخلاء غريبي الأطوار

187
00:16:51,560 --> 00:16:54,740
.يظنّوننا غير منطقيّين

188
00:16:54,740 --> 00:17:00,320
لكنّ ذلك لأنّهم لا يفهمون متقني
.الأساليب فحسب

189
00:17:00,610 --> 00:17:05,260
.متقنو الأساليب منطقيّون أكثر من أيّ أحد آخر

190
00:17:05,700 --> 00:17:11,470
نحن نبحث عن القوانين المخبّأة في كلّ الأشياء
.مع تفادي الحظّ العاثر والسّعي للحظّ الجيّد

191
00:17:12,790 --> 00:17:16,580
.أدركت شيئًا خلال مباراتك ضدّ تيتسو باريو

192
00:17:17,720 --> 00:17:24,170
كان الكونغ فو الخاصّ به قويًّا
.بما يكفي للتّغلّب عليك

193
00:17:24,780 --> 00:17:30,050
.لكنّك أوقفت الكونغ فو الخاصّ به بكلّ سهولة

194
00:17:31,180 --> 00:17:36,480
لأنّك كنت دائمًا تقف في وجهة
.الحظّ الجيّد لتلك اللّحظة

195
00:17:36,480 --> 00:17:40,340
.كان الحظّ إلى جانبك طوال الوقت

196
00:17:41,960 --> 00:17:46,740
.نعم، جميع حركاتك منطقيّة

197
00:17:48,780 --> 00:17:55,250
أشكّ في أنّني أستطيع أن أصبح صديقًا
.لشخصٍ يكتشف أمر الآخرين مثلك

198
00:17:55,820 --> 00:17:58,080
يمكنني أن أعتبر نفسي محقًّا إذًا؟

199
00:17:59,410 --> 00:18:04,430
أردت إنهاء الأمر قبل أن تستعمل
،كيمون تونكو خاصّتك

200
00:18:04,430 --> 00:18:06,890
.لكنّني كنت ساذجًا

201
00:18:07,840 --> 00:18:09,450
.أخبرني يا شوكاتسو سي

202
00:18:11,100 --> 00:18:13,500
هل سبق وخسرت من قبل؟

203
00:18:15,140 --> 00:18:17,830
.باستثناء مبارياتي مع معلّمي، لا

204
00:18:18,300 --> 00:18:20,560
هل يمكنك تقبّل الهزيمة؟

205
00:18:20,980 --> 00:18:24,700
هزيمة ساحقة لدرجة نكران حياتك
بأكملها حتّى هذه اللّحظة؟

206
00:18:27,980 --> 00:18:30,150
.كلانا متقن أساليب

207
00:18:30,150 --> 00:18:33,170
دعنا لا نضيّع الوقت في معارك
.سخيفة ونسوّي الأمر عقلانيًّا

208
00:18:35,520 --> 00:18:40,500
لمَ لا نتجنّب الحظّ العاثر ونسعى
للحظّ الجيّد كما قلت؟

209
00:18:41,670 --> 00:18:43,640
.سأمنحك بعض الوقت لتفكّر في الأمر

210
00:18:45,310 --> 00:18:48,400
.ما الّذي يجري؟ لقد توقّفا فجأة

211
00:18:48,400 --> 00:18:50,480
ما الّذي يناقشانه؟

212
00:18:52,510 --> 00:18:54,720
.هذا تطوّر غير متوقّع

213
00:19:03,270 --> 00:19:07,650
.على متقن الأساليب تسليم نفسه لمسار السّماء

214
00:19:08,180 --> 00:19:12,200
.شوكاتسو سي، أنا لا أحاول إهانتك

215
00:19:13,110 --> 00:19:18,050
لا أريد أن أكون ملحًّا جدًّا، لكن عد
.إلى ديارك يا شوكاتسو سي

216
00:19:18,860 --> 00:19:21,510
.ذاك هو خيارك الأفضل

217
00:19:28,480 --> 00:19:29,860
.أويا-دونو

218
00:19:31,620 --> 00:19:37,000
.توقّعت للتّوّ قدري وتوصّلت بالبيت التّالي

219
00:19:39,680 --> 00:19:42,590
".تطير حشرة الصّيف نحو النّار"

220
00:19:43,170 --> 00:19:45,570
!كون كاواغوروما

221
00:19:46,110 --> 00:19:48,240
.كون كاواغوروما

222
00:19:50,340 --> 00:19:51,270
!ماذا؟

223
00:20:01,690 --> 00:20:04,640
!كما أنّه أقوى من خاصّتي

224
00:20:05,300 --> 00:20:07,200
!ري سيكيرين

225
00:20:07,200 --> 00:20:09,660
!سون كادان كودوكو

226
00:20:11,630 --> 00:20:12,850
!مستحيل

227
00:20:13,080 --> 00:20:19,500
من المستحيل حتّى على أعظم مستعملي
!كيمون ألاّ يتّبعوا قوانين سيكوكو

228
00:20:20,150 --> 00:20:23,610
لا ينبغي على تقنية خشب هزيمة
!تقنية نار أبدًا

229
00:20:37,230 --> 00:20:41,010
ما هي الأسرار الّتي يخبّئها الكيمون
تونكو الخاصّ به؟

230
00:20:45,280 --> 00:20:47,100
ما جوابك يا شوكاتسو سي؟

231
00:20:47,100 --> 00:20:48,680
هل نتابع؟

232
00:20:49,760 --> 00:20:55,030
إن كنت قد خمّنت قدرك، فلا بدّ
.أنّك تعرف أنّ لا فائدة من هذا

233
00:20:56,150 --> 00:20:57,340
.معه حقّ

234
00:20:57,730 --> 00:21:02,810
سأتلقّى هزيمة ساحقة لدرجة
.أنّني سأفقد كلّ كرامتي بالتّأكيد

235
00:21:02,810 --> 00:21:07,870
لكن هناك شيء أهمّ بكثير من
.الكرامة بالنّسبة لمتقن أساليب

236
00:21:08,350 --> 00:21:09,530
...وهي

237
00:21:11,220 --> 00:21:12,500
!الحقيقة

238
00:21:16,480 --> 00:21:18,960
ما ذلك النّور؟

239
00:21:24,840 --> 00:21:26,980
!كيمون كينزو شينبو

240
00:21:33,650 --> 00:21:37,010
!سي-ني... توقّف

241
00:21:38,270 --> 00:21:45,920
حتّى وإن كنت غير قادر على تفادي
.الهزيمة، أريد أن أعرف كيف هُزمت

242
00:21:46,670 --> 00:21:52,880
سأرى بعينيّ الحقيقة المخبّأة
.وراء الكيمون تونكو الخاصّ بك

243
00:23:26,010 --> 00:23:27,260
الحلقة القادمة

244
00:23:26,020 --> 00:23:28,200
.هذا كيمون كينزو شينبو

245
00:23:28,200 --> 00:23:30,300
.كما لو أنّك ترى كلّ شيء بتلكما العينين

246
00:23:30,300 --> 00:23:33,250
أويا-دونو، أنت ترتدي سروالاً
.داخليًّا أزرق اليوم

247
00:23:33,250 --> 00:23:35,090
!كفّ عن النّظر عبر ملابسي

248
00:23:35,360 --> 00:23:38,120
:"في الحلقة القادمة من "هيتوري نو شيتا
."فوكو كيمون"

249
00:23:38,120 --> 00:23:39,320
.لا تفوتوها