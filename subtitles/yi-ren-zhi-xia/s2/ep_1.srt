1
00:00:07,310 --> 00:00:11,920
:انتهى الجزء الأوّل من "هيتوري نو شيتا
.المنبوذ" بالكثير من الأسرار

2
00:00:11,920 --> 00:00:14,210
ستركّز هذه الحلقة على كلّ أسرار

3
00:00:14,210 --> 00:00:16,450
.هيتوري نو شيتا" ولمَ ينبغي عليكم مشاهدته"

4
00:00:17,000 --> 00:00:21,990
هيتوري نو شيتا، حلقة فصل راتِن تايشو
.الخاصّة السابقة للعرض

5
00:01:37,660 --> 00:01:40,200
طالب الجامعة تشو سوران

6
00:01:40,200 --> 00:01:44,000
يتّجه إلى البلدة الّتي ترعرع
،فيها لزيارة قبر جدّه

7
00:01:44,000 --> 00:01:48,720
.لكنّه يكتشف أنّ أحدًا قدر سرق القبر

8
00:01:52,400 --> 00:01:57,590
لكنّ الإثم الّذي ارتكبتُه وضعك
...في هذه الظّروف

9
00:01:58,680 --> 00:01:59,970
...جدّي

10
00:02:00,830 --> 00:02:04,200
.نحن عائلة تشو رجال جيانغهو

11
00:02:04,540 --> 00:02:12,110
.كان جدّ سوران قد علّمه كيف يعيش

12
00:02:18,500 --> 00:02:26,830
أنا وأنت وجميع مخلّفات حرب كوشين
.علينا الذّهاب إلى الجحيم

13
00:02:27,360 --> 00:02:32,080
.علينا أن نترك عالمًا نقيًّا لجيل الشّباب

14
00:02:32,400 --> 00:02:37,090
.قاتَل جدّه أعداءً غامضين وفقد حياته

15
00:02:37,810 --> 00:02:41,130
وفي النّهاية، لم يعلم سوران شيئًا عن الأسرار

16
00:02:41,130 --> 00:02:43,910
الّتي تحيطه وعن حقيقة

17
00:02:43,910 --> 00:02:48,250
.لقاء جدّه بفتاة غامضة اسمها فو هوهو

18
00:02:52,430 --> 00:02:55,090
...أنتما الأخيران إذًا

19
00:02:58,450 --> 00:02:59,390
...فو

20
00:03:00,340 --> 00:03:02,290
هل هذه أنتِ يا فو هوهو؟

21
00:03:02,760 --> 00:03:06,290
ماذا؟ هل تعرف من أكون أيّها العجوز؟

22
00:03:06,290 --> 00:03:08,280
.هذه أنتِ حقًّا

23
00:03:08,690 --> 00:03:13,210
.حتّى بعد كلّ هذه العقود، لم تتغيّري أبدًا

24
00:03:14,530 --> 00:03:17,670
أرجوك أخبرني من أكون؟

25
00:03:17,670 --> 00:03:19,130
.أخبرني أرجوك

26
00:03:19,860 --> 00:03:21,920
أن تعرف بشأني، صحيح؟

27
00:03:21,920 --> 00:03:23,690
ماذا عن عائلتي؟

28
00:03:24,220 --> 00:03:27,140
لا يهمّ بمَ ستخبرني، فقط أخبرني
.بشيء عنّي أرجوك

29
00:03:28,410 --> 00:03:30,840
لا بدّ أنّ رؤيتك في وقت كهذا

30
00:03:30,840 --> 00:03:34,020
...هي مشيئة السّماء

31
00:03:34,410 --> 00:03:38,670
أنا آسف، لكنّي لا أستطيع
.إخبارك بكلّ شيء

32
00:03:38,670 --> 00:03:43,320
لكنّني أستطيع إخبارك بالطّريقة الّتي
...يمكنك الاقتراب بها من الجواب

33
00:03:44,320 --> 00:03:45,620
طريقة؟

34
00:03:45,620 --> 00:03:50,090
.احمي حفيدي، تشو سوران

35
00:03:50,890 --> 00:03:52,720
أحمي حفيدك؟

36
00:03:52,720 --> 00:03:56,750
.نعم، احمي سوران بدلاً عنّي رجاءً

37
00:03:57,520 --> 00:04:00,170
.ستنتهي حياتي قريبًا

38
00:04:00,470 --> 00:04:06,450
أرجوك يا فو هوهو، هل يمكنك
أن تضعي حدًّا لحياتي بيديك؟

39
00:04:07,070 --> 00:04:08,410
!لا يمكن أن تكون جادًّا

40
00:04:08,410 --> 00:04:13,500
إن فعلت ذلك، فهل سأتمكّن من استعادة ماضيّ؟

41
00:04:14,350 --> 00:04:15,270
!أمو

42
00:04:15,640 --> 00:04:17,270
.لست واثقًا

43
00:04:17,780 --> 00:04:23,040
إن لم يقترب أيّ غرباء من سوران
،حتّى وإن انتظرتهم

44
00:04:23,040 --> 00:04:25,670
.فقد ينتهي كلّ شيء هباءً

45
00:04:25,670 --> 00:04:33,030
لكن لا ينبغي على الانتظار أن يعنيَ
.شيئًا بالنّسبة لك يا فو هوهو

46
00:04:34,080 --> 00:04:36,760
.حسنًا، أعدك

47
00:04:37,780 --> 00:04:41,310
...انتظري يا أمو. حتّى وإن طلب ذلك

48
00:04:41,310 --> 00:04:43,710
.لن ينجو

49
00:04:42,820 --> 00:04:46,950
بكلماته الغامضة الأخيرة، ترك تشو شاكورين فو هوهو

50
00:04:43,710 --> 00:04:46,180
.يمكنني على الأقلّ أن أنهي معاناته

51
00:04:46,950 --> 00:04:51,800
.بقوّة سرّيّة وطلب منها حماية سوران

52
00:04:53,250 --> 00:04:57,150
،عندما يطأ سورن العالم الخارجيّ

53
00:04:57,150 --> 00:05:00,020
،إن كانت القوّة تنقصه

54
00:05:00,450 --> 00:05:03,400
.أعطه هذه رجاءً

55
00:05:03,950 --> 00:05:06,320
.أعتمد عليك يا فو هوهو

56
00:05:06,320 --> 00:05:08,150
.أنا أثق بك

57
00:05:12,050 --> 00:05:13,860
ما الّذي فعلته؟

58
00:05:18,710 --> 00:05:20,760
.كما أنّ ذلك مريب

59
00:05:21,590 --> 00:05:24,900
.لكنّني لا أصدّق أنّ أحدًا حفر قبر جدّي

60
00:05:24,900 --> 00:05:27,780
إلى أيّ مدى يكره أحد ما عائلتي؟

61
00:05:27,780 --> 00:05:30,380
.لكنّني واثق أنّ كل ذلك بسبب أبي

62
00:05:31,260 --> 00:05:32,010
ما هذا؟

63
00:05:33,420 --> 00:05:38,150
باتّجاهه نحو قبر شاكورين وإيجاده
.لفو هوهو وهي تحفره

64
00:05:38,980 --> 00:05:41,820
،ظنّ بالخطأ أنّها لصّ القبور

65
00:05:41,820 --> 00:05:45,790
.لكنّ هوهو أنقذته من جيشٍ من الزّومبي بعد ذلك

66
00:05:51,250 --> 00:05:53,000
هل يقوم بذلك بفرده؟

67
00:05:53,000 --> 00:05:54,290
أيّ رجل يكون؟

68
00:05:58,330 --> 00:05:59,430
امرأة؟

69
00:05:59,430 --> 00:06:02,710
.حسنًا... سوف ألتقط صورة من أجل الشّرطة

70
00:06:03,730 --> 00:06:04,630
.حسنًا

71
00:06:13,170 --> 00:06:14,810
!لقد رأتني! تبًّا

72
00:06:20,500 --> 00:06:22,310
.يبدو أنّها لم تتبعني

73
00:06:22,810 --> 00:06:26,860
...تبًّا للصّة القبور تلك على إخافتي هكذا

74
00:06:29,090 --> 00:06:31,320
.حسنًا، لديّ الدّليل

75
00:06:31,710 --> 00:06:34,480
!حاولي الهرب فحسب

76
00:06:42,500 --> 00:06:46,170
...هذا مؤلم... أشعر وكأنّ رأسي سينشقّ

77
00:06:48,270 --> 00:06:50,180
!ماذا... ماذا... ماذا؟

78
00:06:54,180 --> 00:06:55,560
!ما هذا؟

79
00:07:06,640 --> 00:07:10,070
،وعندما عاد سوران إلى المدرسة

80
00:07:10,070 --> 00:07:12,550
.كانت هوهو جالسةً بقربه لسبب ما

81
00:07:13,990 --> 00:07:17,790
.تساءل سوران من تكون

82
00:07:23,710 --> 00:07:26,710
...وبعد ذلك، لمناقشة

83
00:07:27,050 --> 00:07:30,020
.ماذا؟ لم أخبر أحدًا بشأنك

84
00:07:30,020 --> 00:07:32,030
.كما أنّي محوت صورتك من هاتفي

85
00:07:32,030 --> 00:07:33,860
!لا أريد أيّ مشاكل

86
00:07:34,260 --> 00:07:37,640
!إن كنت ستتبعينني رغم ذلك، فسأبلّغ عنك الشّرطة

87
00:07:38,030 --> 00:07:39,830
.افعل ما يحلو لك

88
00:07:39,830 --> 00:07:46,610
عندها هاجمت هوهو سوران بسكّين
.ومهاراتٍ فنونٍ قتاليةٍ مذهلة

89
00:07:47,040 --> 00:07:49,570
.لديك قوّة هائلة

90
00:07:49,940 --> 00:07:52,320
.أدركت ذلك عندما التقيت بك أوّل مرّة

91
00:07:58,450 --> 00:08:00,830
.سأقتلك إن لم ترِني

92
00:08:07,250 --> 00:08:08,170
...أنتِ

93
00:08:08,660 --> 00:08:10,250
!مجنونة

94
00:08:17,870 --> 00:08:20,220
كانت تلك اللّحظة الّتي قرّر فيها سوران

95
00:08:20,220 --> 00:08:25,210
.استعمال القوّة الّتي أخبره جدّه بإخفائها

96
00:08:25,740 --> 00:08:27,440
.اسمع جيّدًا يا سوران

97
00:08:27,440 --> 00:08:31,990
.عليك ألاّ تستعمل قواك أمام أيّ أحد تحت أيّ ظرف

98
00:08:31,990 --> 00:08:34,030
.تذكّر ذلك

99
00:08:34,740 --> 00:08:38,080
كانت تقنية اسمها كينكو يمكن
.استعمالها للهجوم والدّفاع

100
00:08:43,570 --> 00:08:49,010
...قال جدّي أنّه غير مسموح لي باستعمالها أبدًا

101
00:08:49,750 --> 00:08:52,360
.لكن أظنّ أنّ لا خيار أمامي الآن

102
00:08:53,210 --> 00:08:55,760
.أنت غير عاديّة كما هو واضح

103
00:08:55,760 --> 00:08:57,800
،امنح الاستقرار للكارثة

104
00:08:58,270 --> 00:09:00,310
!وأظهر قوّتي الإلهيّة

105
00:09:03,610 --> 00:09:04,980
...أخيرًا

106
00:09:07,690 --> 00:09:11,530
.هناك آخرون دخلاء مثلنا في هذا العالم

107
00:09:12,110 --> 00:09:17,160
،إن صادفت دخيلاً آخر

108
00:09:17,570 --> 00:09:21,660
،مهما كانوا ومهما كانت الظّروف

109
00:09:21,660 --> 00:09:25,790
.لا تتردّد في قتالهم بالكينكو خاصّتك

110
00:09:26,750 --> 00:09:30,840
.وإلاّ قد تخسر حياتك

111
00:09:36,220 --> 00:09:39,090
يمكن استعمال الكينكو خاصّتك للدّفاع أيضًا؟

112
00:09:39,090 --> 00:09:43,350
،إن أبقيت الكينكو خاصّتك قريبًا منك يمكن الدّفاع

113
00:09:44,220 --> 00:09:47,480
.وإن أطلقته يمكنك مهاجمة عدوّك

114
00:09:48,350 --> 00:09:50,810
...فهمت أخيرًا يا جدّي

115
00:09:51,440 --> 00:09:55,030
...لِمَ عملت بجهد لتعليمي الكونغ فو منذ صغري

116
00:09:55,400 --> 00:09:58,750
كان ذلك لكي أتمكّن من حماية
.نفسي من هؤلاء الدّخلاء الآخرين

117
00:10:11,050 --> 00:10:13,030
.هناك الكثير من المتاعب تحيط بالدّخلاء

118
00:10:13,030 --> 00:10:15,580
،نحن نحاول مساعدة الدّخلاء المحتاجين

119
00:10:15,580 --> 00:10:20,550
إضافة إلى إيقاف الدّخلاء الّذين يحاولون
،التّشويش على المجتمع

120
00:10:18,910 --> 00:10:21,230
تمّ الاعتراف بقدرات سوران وتمّت

121
00:10:20,550 --> 00:10:22,930
.ونحافظ على التّوازن في مجتمع الدّخلاء

122
00:10:21,230 --> 00:10:23,220
،دعوته للانضمام إلى شركة التّوصيل السّريع

123
00:10:23,220 --> 00:10:25,880
وهي شركة تتنكّر على أنّها شركة توصيل

124
00:10:25,880 --> 00:10:29,020
.لكن في الواقع تحافظ على النّظام بين الدّخلاء

125
00:10:30,360 --> 00:10:31,290
!سوران-كن

126
00:10:31,780 --> 00:10:34,360
هلاّ انضممت إلى شركتنا للتّوصيل السّريع؟

127
00:10:34,820 --> 00:10:37,490
.إنّه الشّخص الّذي يثير اهتمامي

128
00:10:37,490 --> 00:10:39,110
ماذا بك؟

129
00:10:39,110 --> 00:10:44,850
لم أظنّ أنّ وريث أسلوب كيتايغين
.هو شخص يبدو بهذا الضّعف

130
00:10:44,850 --> 00:10:48,290
ما هو أسلوب كيتايغين بالضّبط
الّذي تواصل ذكره؟

131
00:10:58,950 --> 00:11:01,050
.أنت من التّينغيكاي

132
00:11:01,810 --> 00:11:03,180
.أنا فو ساين

133
00:11:03,180 --> 00:11:05,900
.يقبل سوران دعوة التّينغيكاي ويزورهم

134
00:11:05,900 --> 00:11:08,890
تخبرهم رئيسة التّينغيكاي أنّ هذه المعركة

135
00:11:08,890 --> 00:11:12,400
.بين الدّخلاء عبارة عن معركة للظّفر بثمانِ قوى

136
00:11:12,990 --> 00:11:17,930
قيل له أنّ جدّه كان يملك أحد
.القوى الثّمان، أسلوب كيتايغين

137
00:11:17,930 --> 00:11:20,740
.كان سوران وريث تلك القوّة

138
00:11:21,750 --> 00:11:24,870
هل فاجأتك بما قلته من قبل؟

139
00:11:25,270 --> 00:11:27,330
.بالطّبع

140
00:11:27,330 --> 00:11:30,340
لكن ما تسعى إليه هو أسلوب كيتايغين، صحيح؟

141
00:11:30,340 --> 00:11:33,780
.لا أحد منكم يهتمّ لما عليه فعله للحصول عليه

142
00:11:33,780 --> 00:11:36,890
،سوران-كن، عندما كنت في الحادية عشر

143
00:11:36,890 --> 00:11:39,090
،قُتِل جدّك تشو شاكورين

144
00:11:39,090 --> 00:11:41,760
.واختفى والدك

145
00:11:41,760 --> 00:11:44,470
.عجبًا، لقد قمت ببحث عميق

146
00:11:44,810 --> 00:11:47,980
،بمجرّد معرفتنا بأنّك وريث أسلوب كيتايغين

147
00:11:47,980 --> 00:11:50,480
.بحثنا عن كلّ تفصيل عنك

148
00:11:51,290 --> 00:11:54,690
قواهم لم تكن قوى يمكن توريثها
.في أيّ كتاب أسرار

149
00:11:54,690 --> 00:11:57,720
.وُلِدوا بهذه القوى الّتي لا مثيل لها

150
00:11:57,720 --> 00:12:03,200
وإحدى هذه القوى هو أسلوب كيتايغين
،الّذي استعمله جدّك

151
00:12:03,200 --> 00:12:04,620
.تشو شاكورين

152
00:12:08,790 --> 00:12:10,310
.أتيت إلى هنا لرؤيتك

153
00:12:11,230 --> 00:12:14,020
.عد معي إلى المنزل يا تشو سوران

154
00:12:14,020 --> 00:12:16,100
ماذا؟ المنزل؟

155
00:12:16,980 --> 00:12:19,490
.لن عود بهذه السّهولة

156
00:12:19,490 --> 00:12:22,620
.لن أفعل ما تقولينه بهذه البساطة

157
00:12:23,140 --> 00:12:24,170
.أنا آسفة

158
00:12:25,800 --> 00:12:28,570
.تسبّبت لك بالكثير من الحزن

159
00:12:30,140 --> 00:12:33,120
.أنا آسفة يا تشو سوران-كن

160
00:12:33,120 --> 00:12:37,090
حينها أتت فو هوهو لتأخذه

161
00:12:37,090 --> 00:12:39,910
.من مقر التّينغيكاي بعد أن تجادلا

162
00:12:39,910 --> 00:12:45,630
.اتّبعت هوهو أوامر سوران وأصيبت بجروح عميقة

163
00:12:46,490 --> 00:12:50,520
!كيف تجرؤون على السّخريّة منّي؟

164
00:12:50,520 --> 00:12:53,790
!موتوا! ستموتون جميعًا

165
00:13:01,290 --> 00:13:04,970
هـ-هو-ني؟

166
00:13:13,970 --> 00:13:15,440
.كان ذلك وشيكًا

167
00:13:16,940 --> 00:13:21,500
.أنا سعيدة لأنّي لم أبتعد كما طلبت

168
00:13:23,760 --> 00:13:26,180
،لكن لسبب ما لم تمت فو هوهو

169
00:13:26,180 --> 00:13:30,650
رغم إصابته بجروح خطيرة لدرجة
.تقتل أيّ إنسان عاديّ

170
00:13:30,650 --> 00:13:33,600
.سرّها كان أنّها خالدة

171
00:13:34,550 --> 00:13:37,550
.لا تكبر في السّنّ ولا يمكنها الموت

172
00:13:37,550 --> 00:13:42,440
.وقد نسيت كيف أصبحت كذلك

173
00:13:43,340 --> 00:13:44,580
!أيّها الوغد

174
00:13:44,580 --> 00:13:46,630
.اهدأ يا سوران-كن

175
00:13:47,320 --> 00:13:48,970
.ستقلق راحتها

176
00:13:48,970 --> 00:13:51,890
!ماذا؟! ما الّذي تتحدّثون عنه؟

177
00:13:51,890 --> 00:13:54,030
.استمع جيّدًا

178
00:13:54,030 --> 00:13:56,900
.أنت مستعمل كي أيضًا. ينبغي أن تتمكّن من سماعه

179
00:13:56,900 --> 00:13:58,980
سماع ماذا؟

180
00:14:04,220 --> 00:14:06,490
...هـ-هذا الصّوت

181
00:14:07,140 --> 00:14:08,240
.مستحيل

182
00:14:08,240 --> 00:14:11,060
.هذا ليس نمط تنفّس شخصٍ يحتضر

183
00:14:12,840 --> 00:14:14,470
...مـ-مستحيل

184
00:14:15,520 --> 00:14:17,620
توقّف النّزيف؟

185
00:14:18,140 --> 00:14:21,110
مـ-ما الّذي يجري هنا؟

186
00:14:21,590 --> 00:14:24,770
من المستحيل أن تكون قد
...تعافت بهذه السّرعة

187
00:14:25,410 --> 00:14:26,880
ما الّذي يجري؟

188
00:14:27,210 --> 00:14:30,370
.هذا وقت مناسب لشرح كلّ شيء لي

189
00:14:30,370 --> 00:14:32,390
من تكون هو-نيتشان؟

190
00:14:32,390 --> 00:14:34,170
لِمَ هي قويّة إلى هذه الدّرجة؟

191
00:14:34,170 --> 00:14:36,350
!ينبغي أن تعرفوا كلّ هذا

192
00:14:36,640 --> 00:14:39,850
والأهمّ من ذلك، لم هي مهووسة
بي إلى هذه الدّرجة؟

193
00:14:39,850 --> 00:14:43,230
!لِمَ جازفت بحياتها لإيقافي؟

194
00:14:43,230 --> 00:14:47,150
في الحقيقة، لا توجد معلومات كثيرة
.يمكننا إعطاؤها لك

195
00:14:47,780 --> 00:14:54,370
لكنّنا نريدك أن تنضمّ إلى التّوصيل
.السّريع مهما كلّف الأمر

196
00:14:54,990 --> 00:14:58,660
.لأنّنا نعترف بعلاقتك مع التّينشيفو

197
00:14:59,670 --> 00:15:02,920
ونحن مستعدّون لدعمك تمامًا

198
00:15:02,920 --> 00:15:05,710
.كي تصبح التّينشي التّالي

199
00:15:06,760 --> 00:15:09,260
،وبمجرّد أن أصبح التّينشي التّالي

200
00:15:09,260 --> 00:15:11,930
.ستحاولون احتواء التّينشيفو

201
00:15:12,260 --> 00:15:15,060
.هذا مفيد لكم حقًّا

202
00:15:15,060 --> 00:15:20,390
كما أنّني لا أحبّ الطّريقة الّتي تستغلّون
.بها هو-نيتشان فحسب

203
00:15:20,390 --> 00:15:23,060
كيف تجعلونها تصغي إليكم؟

204
00:15:24,110 --> 00:15:27,440
.هذا مشابه لوضعك كثيرًا

205
00:15:28,110 --> 00:15:29,320
ماذا تقصد؟

206
00:15:29,740 --> 00:15:33,820
،مقابل عمل هوهو لأجلنا

207
00:15:34,370 --> 00:15:36,660
.نحن نحقّق في أمر ماضيها من أجلها

208
00:15:36,660 --> 00:15:37,750
ماضيها؟

209
00:15:38,620 --> 00:15:40,410
.ليس لها أيّ ذاكرة

210
00:15:40,870 --> 00:15:43,630
،لا تعرف متى وأين وُلدت

211
00:15:44,130 --> 00:15:45,880
.أو أيّ حياة كانت لها

212
00:15:46,840 --> 00:15:50,760
.بقي ماضيها سرًّا بسبب حادثة معيّنة

213
00:15:59,810 --> 00:16:03,090
،بمواصلته لقاء العديد من الدّخلاء

214
00:16:03,090 --> 00:16:05,820
،تلقّى دعوة من فتاة ظريفة

215
00:16:05,820 --> 00:16:08,750
.رغم أنّه ليس مشهورًا وفقير

216
00:16:09,520 --> 00:16:14,340
.شعر سوران بالغرور، لكن كان ذلك فخًّا بالطّبع

217
00:16:15,780 --> 00:16:19,290
.ما رأيك؟ أحضرت لك سوران كما وعدت

218
00:16:19,550 --> 00:16:22,970
!سأجعلك الآن تقبلني في زينسي كما وعدت

219
00:16:22,970 --> 00:16:26,900
.أمسكت إحدى منظّمات الدّخلاء زينسي بسوران

220
00:16:27,520 --> 00:16:33,640
كانت زينسي منظّمة شرّيرة مليئة
.بالدّخلاء الّذين فعلوا ما يحلو لهم

221
00:16:34,470 --> 00:16:36,000
،بسبب عنفهم

222
00:16:36,000 --> 00:16:40,330
اعتُبروا مجموعةً خطيرة والعديد
.من المنظّمات كانت ضدّهم

223
00:16:41,280 --> 00:16:44,690
،حينها كاد أن يصبح سوران دمية

224
00:16:44,690 --> 00:16:50,410
أزيلت ذكرياته واختبر العديد
.من قوى الدّخلاء في آن واحد

225
00:16:50,930 --> 00:16:54,200
.أنت حفيد تشو شاكورين بالتّأكيد

226
00:16:57,040 --> 00:16:58,990
.يا للرّوعة

227
00:16:58,990 --> 00:17:00,860
...أ-أنت

228
00:17:00,860 --> 00:17:07,330
.مع أنّك مقيّد، إلاّ أنّني أشعر بقوّة هائلة منك

229
00:17:08,490 --> 00:17:12,010
!إنّها مثاليّة! إنّها تتدفّق منك بشدّة

230
00:17:12,010 --> 00:17:14,760
.أنت تبدو لذيذًا للغاية

231
00:17:17,210 --> 00:17:18,680
...مـ-ماذا

232
00:17:22,060 --> 00:17:24,300
.كفّ عن الصّراخ

233
00:17:24,300 --> 00:17:28,610
.ليس وكأنّني سأستخرج روحك كلّيًّا

234
00:17:28,610 --> 00:17:32,110
.أريد فقط الجزء الّذي يحكم ذكرياتك

235
00:17:35,640 --> 00:17:37,310
!توقّف

236
00:17:37,820 --> 00:17:39,170
هل هذا مؤلم؟

237
00:17:39,170 --> 00:17:42,080
.سآخذ كلّ ذكرياتك إذًا

238
00:17:42,080 --> 00:17:44,680
.تعال إلى هنا يا سوران-كن

239
00:17:44,680 --> 00:17:47,120
،لم تكن زينسي خلف سوران فحسب

240
00:17:47,120 --> 00:17:51,630
.بل تلقّى دعوات كثيرة من التّينغيكاي والتّينشيفو

241
00:17:52,240 --> 00:17:55,880
كان أسلوب كيتايغين الخاصّ بتشو شاكورين قويًّا لدرجة

242
00:17:55,880 --> 00:17:59,550
.أنّ جميع المنظّمات أرادت سوران أن ينضمّ لها

243
00:18:00,360 --> 00:18:05,520
لكنّ سوران قال لهم أنّه لم يتعلّم
.أسلوب كيتايغين أبدًا

244
00:18:06,010 --> 00:18:10,740
ظلّ الغير يعبثون مع سوران رغم
.جهله بما فعلته تلك القوّة

245
00:18:11,920 --> 00:18:14,910
ألم تفهم بعد يا جو سان؟

246
00:18:14,910 --> 00:18:20,140
الكينكو الّذي علّمه تشو شاكورين
.ليس تقنيّة أسلوب كيتايغين

247
00:18:20,580 --> 00:18:24,880
.إنّها تقنيّة كوسي ريوكوسان شويتسوها تينشيفو

248
00:18:25,280 --> 00:18:27,180
.اسمها كينكوجو

249
00:18:27,580 --> 00:18:32,120
.سنظهر قوّتنا الإلهيّة بالتّغلّب على جميع المصائب

250
00:18:32,120 --> 00:18:34,090
!لـ-لا يمكن

251
00:18:48,600 --> 00:18:50,190
.ينبغي أن يكفي هذا

252
00:18:50,500 --> 00:18:54,110
.أحسنتما أنتما الاثنان. يمكنك التّراجع الآن

253
00:18:54,110 --> 00:18:55,730
.سأتولّى أمره الآن

254
00:18:56,200 --> 00:18:57,250
...ريغيوكو-ساما

255
00:18:58,650 --> 00:19:01,260
.لم أعد أفهم شيئًا بصراحة

256
00:19:01,260 --> 00:19:05,850
!لا أكترث بمعرفة من تكونون. افعلوا ما يحلو لكم

257
00:19:05,850 --> 00:19:08,660
.أنا واثق أنّكم ستأتون خلفي بالقوّة على أيّة حال

258
00:19:09,070 --> 00:19:11,790
!أسرع وقم بذلك فحسب

259
00:19:11,790 --> 00:19:14,710
.كفّ عن الصّراخ إن كانت هذه كلّ القوّة الّتي تملكها

260
00:19:15,230 --> 00:19:17,590
!لا تتعال عليّ

261
00:19:24,430 --> 00:19:26,780
مـ-ما هذا الكينكو؟

262
00:19:26,780 --> 00:19:28,310
!إنّه صلب جدًّا

263
00:19:35,940 --> 00:19:38,220
لِمَ لا تكفّ عن كبح نفسك؟

264
00:19:38,220 --> 00:19:40,930
،بعد التّعرّض للخشونة جرّاء الدّعوات المختلفة

265
00:19:40,930 --> 00:19:44,120
.أطلق سوران أخيرًا قواه كدخيل

266
00:19:44,570 --> 00:19:49,460
،لا يستعمل الكينكوجو فقط، بل يستعمل أيضًا الرّايهو

267
00:19:49,460 --> 00:19:51,540
.الّذي علّمه له جدّه أيضًا

268
00:19:52,830 --> 00:19:53,730
ماذا؟

269
00:19:54,460 --> 00:19:56,150
اسمك ريغيوكو، صحيح؟

270
00:19:56,750 --> 00:19:59,670
!سأريك كامل قوّتي

271
00:20:00,250 --> 00:20:02,950
.هذا الشّعور... مستحيل

272
00:20:02,950 --> 00:20:04,180
.لا يمكن

273
00:20:04,670 --> 00:20:07,580
...أخفيت هذا لوقت طويل

274
00:20:09,140 --> 00:20:13,390
...كُسر الكينكو خاصّتي بسهولة

275
00:20:14,930 --> 00:20:18,550
.هذه أوّل مرة أستعمله أمام شخص

276
00:20:20,370 --> 00:20:24,200
هل هذا شيء يمكن لشخصٍ إتقانه؟

277
00:20:26,520 --> 00:20:29,770
،كان الكينكو الدّفاعيّ خاصّتك قويًّا جدًّا

278
00:20:30,200 --> 00:20:33,340
لكن هل يمكنك صدّ هذه التّقنيّة؟

279
00:20:34,030 --> 00:20:36,670
.تحوّل الكينكو إلى نور أبيض

280
00:20:37,400 --> 00:20:38,740
.لا شكّ في الأمر

281
00:20:39,150 --> 00:20:40,550
...هذا التّقنيّة هي

282
00:20:40,890 --> 00:20:42,020
!رايهو

283
00:20:58,690 --> 00:21:00,690
بدا للحظة

284
00:21:00,690 --> 00:21:03,560
.أنّ لسوران الأفضليّة، لكن هجومه قد تبدّد

285
00:21:04,190 --> 00:21:08,240
.لم تعرف قوى ريغيوكو أيّ حدود

286
00:21:20,370 --> 00:21:21,940
.تشو سوران-كن

287
00:21:21,940 --> 00:21:25,090
،قلت أنّك غير كفؤ من قبل

288
00:21:25,090 --> 00:21:26,600
.لكن يبدو أنّي كنت مخطئًا

289
00:21:26,600 --> 00:21:29,980
اعترف تشو ريغيوكو بقوى سوران

290
00:21:29,980 --> 00:21:32,560
،وأخبره أنّه سيكون في انتظاره في راتن تايشو

291
00:21:32,560 --> 00:21:35,010
.حيث سيتّم اختيار التّينشي الموالي

292
00:21:35,750 --> 00:21:38,340
أريدك أن تشارك

293
00:21:38,340 --> 00:21:40,960
.في راتن تايشو الّتي ستقام في ريوكوسان

294
00:21:41,620 --> 00:21:45,780
.سيتم اختيار الوريث الموالي للتّينشي في هذا الحدث

295
00:21:45,780 --> 00:21:47,420
دعني أقول أنّك

296
00:21:47,420 --> 00:21:50,840
.أهل لأن تصبح وريث التّينشي يا تشو سوران-كن

297
00:21:51,770 --> 00:21:52,850
أنا؟

298
00:21:53,420 --> 00:21:55,160
وريث التّينشي؟

299
00:21:55,680 --> 00:22:00,120
.عاد سوران إلى هوهو وشركة التّوصيل السّريع

300
00:22:00,120 --> 00:22:05,040
وقرر سوران حينها أن يكتشف جميع الأسرار المحيطة

301
00:22:05,040 --> 00:22:12,270
،بحقيقة أسلوب كيتايغين الخاصّ به وسبب خلود هوهو

302
00:22:12,270 --> 00:22:14,380
.والّتي ترتبط بذلك

303
00:22:14,380 --> 00:22:18,190
،لكنّني الآن أعرف أنّ الكثير من النّاس كانوا يدعمونني

304
00:22:18,190 --> 00:22:21,430
.مثل جدّي وهو-ني وجو شو-سان

305
00:22:23,000 --> 00:22:25,200
،أريد معرفة الحقيقة أيضًا

306
00:22:25,200 --> 00:22:27,860
،لذا كي أفعل ما يريدني الجميع فعله

307
00:22:27,860 --> 00:22:29,450
.سأشارك في راتن تايشو

308
00:22:46,140 --> 00:22:50,140
المسابقة الّتي ستحدّد التّينشي
.الموالي للدّخلاء، راتن تايشو

309
00:22:50,140 --> 00:22:54,770
ستجتمع جميع منظّمات الدّخلاء وجميع الدّخلاء

310
00:22:54,770 --> 00:22:57,230
.لمقارنة مهاراتهم ضدّ بعضهم

311
00:22:57,230 --> 00:23:00,730
.معركة حامية بين القوى الخارقة

312
00:23:01,440 --> 00:23:06,360
!معركة لم تُرى من قبل ستعقد في أقاصي العالم

313
00:23:27,920 --> 00:23:35,760
.ووسطها يوجد كلّ شيء بالنّسبة لتشو سوران وفو هوهو