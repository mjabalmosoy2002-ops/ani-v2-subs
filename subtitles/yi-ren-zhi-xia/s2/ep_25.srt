1
00:01:45,400 --> 00:01:59,670
!تُنشر مانغا "هيتوري نو شيتا: المنبوذ" في شونين جامب+ الآن

2
00:01:49,310 --> 00:01:52,310
.هذه كلّ ذكريات دين شينتشو

3
00:01:52,310 --> 00:01:54,640
ماذا إذًا يا رو ريو؟

4
00:01:54,640 --> 00:01:58,130
هل كان هذا الصّغير محقًّا؟

5
00:01:58,930 --> 00:02:00,070
.على الأرجح

6
00:02:00,790 --> 00:02:03,710
،لم أنتهِ من فكّ ذكرياته بعد

7
00:02:03,710 --> 00:02:09,370
،لكنّ شكوك الزّعيم كانت في محلّها
.يعرف دين شينتشو شيئًا عن حرب كوشين

8
00:02:09,940 --> 00:02:15,530
.ينبغي أن يوضّح هذا ما حدث حينها

9
00:02:18,340 --> 00:02:24,100
لِمَ خاننا زعيمنا السّابق موكونسي؟

10
00:02:24,450 --> 00:02:29,590
.جميعنا اعترفنا به

11
00:02:30,250 --> 00:02:36,510
أيّها العجوز ريوسي، لا تدع أحدًا يعرف
.بشأن ذكريات دين شينتشو

12
00:02:36,510 --> 00:02:38,230
.مفهوم

13
00:02:39,420 --> 00:02:41,590
.لست سيّئًا يا صغير

14
00:02:41,590 --> 00:02:42,910
.حسنًا

15
00:02:42,910 --> 00:02:45,510
.لقد فزت هذه المرّة

16
00:02:45,510 --> 00:02:51,960
سنمنحك فرصة أخرى لإلقاء الأوامر
.علينا كما وعدناك

17
00:02:52,400 --> 00:02:56,000
.لن تضطرّ للمجازفة بحياتك هذه المرّة

18
00:02:56,440 --> 00:03:01,010
في تلك الحالة، بصفة الزّعيم الحاليّ
لزينسي، ألقي الأمر التّالي

19
00:03:01,510 --> 00:03:03,200
.ويجب تنفيذه في الحال

20
00:03:07,020 --> 00:03:10,920
.مهلاً. قاتلنا التّينشيفو للتّوّ

21
00:03:10,920 --> 00:03:12,770
هل تريد التّحرّك من جديد؟

22
00:03:12,770 --> 00:03:17,500
.أنت تعرف كم من الخسائر تكبّدناها هذه المرّة

23
00:03:18,020 --> 00:03:21,990
.أخبروا جميع الأفراد أنّ المعلّم الكبير دين قد مات

24
00:03:21,990 --> 00:03:23,940
.سنقيم حدادًا لسبعة أيّام

25
00:03:24,810 --> 00:03:26,360
هل سيتسبّب ذلك في أيّ خسائر؟

26
00:03:28,560 --> 00:03:30,070
هذا هو أمرك؟

27
00:03:30,600 --> 00:03:35,300
.إن رفض أيّ أحد فاقتلوه بدلاً منّي

28
00:03:35,910 --> 00:03:36,780
.هذا كلّ شيء

29
00:03:37,870 --> 00:03:39,460
.يا للإزعاج

30
00:03:39,460 --> 00:03:41,170
ماذا نفعل أيّها العجوز؟

31
00:03:41,940 --> 00:03:45,230
.أوامر الزّعيم مطلقة

32
00:03:46,690 --> 00:03:53,070
.إن رفضتها، فلن أمانع قتلك

33
00:03:54,330 --> 00:03:56,230
.لا بأس

34
00:03:56,230 --> 00:03:59,910
علينا الاختفاء عن الأنظار لأسبوع فقط، صحيح؟

35
00:03:59,910 --> 00:04:01,530
.هناك شيء آخر

36
00:04:02,610 --> 00:04:06,970
.سيستغرق فكّ الذّكريات المسروقة وقتًا

37
00:04:07,600 --> 00:04:12,100
.لا تتسبّبوا بأيّة مشاكل لبعض الوقت

38
00:04:12,530 --> 00:04:15,690
.لا أريد أن يتدخّل أحد

39
00:04:25,130 --> 00:04:27,110
...المعلّم دين

40
00:04:32,750 --> 00:04:33,860
.إيزان

41
00:04:34,780 --> 00:04:37,390
.لكلّ قدره

42
00:04:37,780 --> 00:04:40,690
.ليس هناك ما يمكننا فعله

43
00:04:43,800 --> 00:04:46,050
.قف يا إيزان

44
00:04:48,100 --> 00:04:49,260
.إيزان

45
00:04:49,830 --> 00:04:51,130
!إيزان

46
00:05:26,890 --> 00:05:28,090
—تشو سو

47
00:05:27,230 --> 00:05:28,090
.هوهو

48
00:05:29,850 --> 00:05:31,590
.لا تقولي شيئًا

49
00:05:33,060 --> 00:05:34,730
.دعيه

50
00:05:46,600 --> 00:05:47,390
ماذا؟

51
00:05:47,860 --> 00:05:49,030
بالأمس؟

52
00:05:49,430 --> 00:05:51,270
تعرّضت التّينشيفو للهجوم؟

53
00:05:54,370 --> 00:05:58,460
.فهمت. أنا مسرور لأنّني غادرت الجبل مبكّرًا

54
00:06:01,810 --> 00:06:03,330
.نعم يا معلّمي

55
00:06:03,330 --> 00:06:06,760
.مهلاً. لم يعد بإمكاني مناداتك بمعلّمي

56
00:06:06,760 --> 00:06:09,770
.فقد طُردت من بوتوسان

57
00:06:10,270 --> 00:06:14,240
.سأتحدّث مع المعلّم الكبير عن الأمر

58
00:06:14,240 --> 00:06:17,080
.على أيّة حال، عد إلى المنزل

59
00:06:17,080 --> 00:06:19,630
هل تستمع لي يا أويا؟

60
00:06:20,930 --> 00:06:23,080
.لا يُعقل

61
00:06:24,430 --> 00:06:26,160
.المعذرة أيّها المعلّم الكبير

62
00:06:27,270 --> 00:06:30,580
أونريو. ما الأمر؟

63
00:06:30,830 --> 00:06:34,210
لماذا طردت أويا أيّها المعلّم الكبير؟

64
00:06:34,210 --> 00:06:36,510
.إنّه تلميذي

65
00:06:36,510 --> 00:06:40,090
ألم يكن عليك التّحدّث إليّ أوّلاً؟

66
00:06:40,960 --> 00:06:45,190
.كلّ هذه الجلبة على شيء سخيف جدًّا

67
00:06:46,290 --> 00:06:52,220
أونريو، لماذا أرسلنا أويا إلى ريوكوسان؟

68
00:06:53,630 --> 00:07:01,010
.لتمثيل بوتوسان في الرّاتن تايشو ومساعدة التّينشي

69
00:07:01,010 --> 00:07:03,190
.هذا صحيح

70
00:07:03,190 --> 00:07:11,530
هل تعلّم إذًا التّقنية الّتي استعملها
لهزيمة الفتى شوكاتسو منك؟

71
00:07:12,390 --> 00:07:14,240
.لا، لم يتعلّمها منّي

72
00:07:14,840 --> 00:07:17,900
هل هي تقنية خاصّة ببوتوسان؟

73
00:07:18,290 --> 00:07:24,880
لا. هل طردته لاستعماله تقنية من مدرسة أخرى؟

74
00:07:24,880 --> 00:07:28,420
ينبغي على الأقلّ أن نعيده
—وندعه يشرح تصرّفه قبـ

75
00:07:31,690 --> 00:07:35,220
.أنا رئيس بوتوسان

76
00:07:35,220 --> 00:07:37,730
.لا تتدخّل في الأمر

77
00:07:39,490 --> 00:07:44,070
تذكّر هذا: لم تعد هناك أيّ علاقة
.تربط بين أويا وبوتوسان

78
00:07:44,730 --> 00:07:51,850
إن كنت لا تزال تريد أن تكون
.معلّمًا له، فغادر بوتوسان

79
00:07:52,380 --> 00:07:54,270
.أيّها المعلّم الكبير، لدينا حالة طارئة

80
00:07:54,620 --> 00:07:57,290
.لقد استفاق المعلّم الكبير رو

81
00:07:58,990 --> 00:08:04,260
.أونريو، هذا ليس وقت القلق على أويا

82
00:08:05,470 --> 00:08:08,730
.لم تعد بوتوسان آمنة

83
00:08:09,120 --> 00:08:12,750
.يحاول شخص ما التّسلل في كلّ ليلة

84
00:08:14,600 --> 00:08:20,070
.راقبهم مع الآخرين

85
00:08:20,690 --> 00:08:26,040
.دعوهم وشأنهم طالما لا يهاجمون

86
00:08:26,570 --> 00:08:31,180
أيّها المعلّم الكبير، هل لهذا علاقة بأويا؟

87
00:08:32,500 --> 00:08:34,850
.هذا ليس من شأنك

88
00:08:40,360 --> 00:08:43,660
.البداية تأتي بالنّهاية

89
00:08:43,660 --> 00:08:48,960
.والنّهاية تتغيّر، وأصبح أنا ملكًا

90
00:08:48,960 --> 00:08:51,990
.البداية تأتي بالنّهاية

91
00:08:52,420 --> 00:08:56,890
.والنّهاية تتغيّر، وأصبح أنا ملكًا

92
00:08:57,340 --> 00:09:00,430
.البداية تأتي بالنهّاية

93
00:09:01,330 --> 00:09:03,030
.رو شيكي

94
00:09:04,590 --> 00:09:07,650
.سنصل إلى بكين بعد قليل

95
00:09:08,450 --> 00:09:11,750
.تفقّدوا محيطكم رجاءً لأيّ أغراض شخصيّة

96
00:09:47,670 --> 00:09:50,030
ما كان ذلك؟ انقطاع في التّيار؟

97
00:09:52,040 --> 00:09:53,620
إلى أين ذهب؟

98
00:09:56,630 --> 00:09:59,980
.كنت أتساءل متى سيهاجمون

99
00:10:00,320 --> 00:10:04,930
توقّعوا على الأرجح أنّني سأسترخي
.بما أنّني اقتربت من الدّيار

100
00:10:04,930 --> 00:10:06,900
.للأسف

101
00:10:23,960 --> 00:10:26,730
.مرّ وقت طويل يا سيّدي الصّغير أويا

102
00:10:27,460 --> 00:10:29,580
.لا تنادني بذلك

103
00:10:29,580 --> 00:10:31,320
كم مرّة عليّ أن أقول لك هذا؟

104
00:10:31,670 --> 00:10:33,720
ماذا عن المعلّم أويا إذًا؟

105
00:10:33,720 --> 00:10:36,820
.هذا يكفي. شكرًا لأنّك ستقلّني

106
00:10:38,150 --> 00:10:39,980
.سمعت الإشاعات

107
00:10:39,980 --> 00:10:43,280
.طُرِدت من بوتوسان

108
00:10:43,780 --> 00:10:47,820
.أنت مضطر الآن للعمل في شركة أبيك

109
00:10:47,820 --> 00:10:49,190
.أنت تمزح

110
00:10:49,190 --> 00:10:50,950
انتشر الخبر بهذه السّرعة؟

111
00:10:51,300 --> 00:10:53,750
هل يعلم أبي؟

112
00:10:53,750 --> 00:10:56,290
.الرّئيس يعلم بالطّبع

113
00:10:56,920 --> 00:10:59,120
.عليك أن تسرع إلى المنزل

114
00:10:59,120 --> 00:11:01,830
.فهو ليس على ما يرام

115
00:11:24,900 --> 00:11:26,820
ما الّذي تفعله؟

116
00:11:27,600 --> 00:11:32,240
.لم تنطق ببنت شفة مذ عدنا من ريوكوسان

117
00:11:32,720 --> 00:11:35,210
.إنّها تصبح أسوأ وأسوأ

118
00:11:36,080 --> 00:11:38,550
.لم يعد بإمكاني تحمّل هذا

119
00:11:39,640 --> 00:11:43,360
المعذرة يا هو-ني؟

120
00:11:48,170 --> 00:11:50,990
!حسنًا، حسنًا! سأخبرك

121
00:11:50,990 --> 00:11:53,560
!سأخبرك بكلّ شيء ناقشته مع التّينشي

122
00:11:53,560 --> 00:11:55,920
!ضعي ذلك الشّيء

123
00:11:57,280 --> 00:12:00,590
.أخبرني جو سان ألاّ أتحدّث معك

124
00:12:01,010 --> 00:12:02,660
.وذلك ما كنت أفعله

125
00:12:04,020 --> 00:12:05,890
أنت حزين، أليس كذلك؟

126
00:12:06,720 --> 00:12:07,520
لماذا؟

127
00:12:10,550 --> 00:12:14,190
.من المحزن أن تموت العائلة

128
00:12:16,080 --> 00:12:19,590
.من المحزن عندما يمون الشّخص الّذي تحبّه

129
00:12:20,750 --> 00:12:25,930
،ذلك العجوز ليس فردًا من عائلتك
فلماذا أنت حزين؟

130
00:12:26,930 --> 00:12:29,000
هل تحبّه؟

131
00:12:29,730 --> 00:12:32,940
كيف لك أن تحبّ شخصًا لم تلتقِ
به سوى مرّة واحدة؟

132
00:12:34,300 --> 00:12:35,530
...هو-ني

133
00:12:37,850 --> 00:12:40,680
.قرّرت ألاّ أصبح التّينشي

134
00:12:41,910 --> 00:12:47,170
.لذا لم يخبرني بحقيقة حرب كوشين

135
00:12:48,680 --> 00:12:49,610
.أنا آسف

136
00:13:04,770 --> 00:13:05,850
هو-ني؟

137
00:13:10,850 --> 00:13:12,480
ماذا أفعل؟

138
00:13:13,970 --> 00:13:17,070
تحذير أويا-سان وكلمات التّينشي وأفعاله

139
00:13:17,070 --> 00:13:20,310
وضّحت أنّ محاولة معرفة المزيد عن حرب كوشين

140
00:13:20,790 --> 00:13:23,120
.ستجلب البلاء

141
00:13:23,860 --> 00:13:30,410
،لكنّني لا أعرف مدى خطورة الأمر
.كما أنّه مجرّد تخمين

142
00:13:30,950 --> 00:13:34,450
لكن لا شيء يضمن أنّ معرفة الحقيقة

143
00:13:34,450 --> 00:13:37,690
.عن حرب كوشين ستشرح ماضي هو-ني

144
00:13:38,470 --> 00:13:39,470
...في تلك الحالة

145
00:13:41,050 --> 00:13:42,330
.هو-ني

146
00:13:43,760 --> 00:13:47,530
.ربّما لست بحاجة للتّقيّد بماضيك بعد الآن

147
00:13:48,570 --> 00:13:52,140
.ربما لا تزال عائلتك موجودة في مكان ما

148
00:14:01,060 --> 00:14:02,230
!هو-ني

149
00:14:03,450 --> 00:14:06,330
.كفّي عن هذا يا هو-ني

150
00:14:07,290 --> 00:14:10,340
.لست الوحيدة الّتي لا تملكين مكانًا تعودين إليه

151
00:14:10,790 --> 00:14:12,780
.ليس لدي عائلة أنا أيضًا

152
00:14:15,220 --> 00:14:19,820
.هو-ني، سأواصل البقاء إلى جانبك

153
00:14:20,300 --> 00:14:24,430
.مثلما فعل جو شو-سان الّذي كان معك

154
00:14:24,770 --> 00:14:27,180
.سأفعل أكثر من مجرّد البقاء إلى جانبك

155
00:14:27,180 --> 00:14:29,000
.سأفعل أيّ شيء تريدينه

156
00:14:29,390 --> 00:14:30,320
—لذا

157
00:14:30,320 --> 00:14:31,130
.كاذب

158
00:14:32,750 --> 00:14:34,610
.لديك مكان

159
00:14:36,840 --> 00:14:37,950
.هنا

160
00:14:38,600 --> 00:14:39,810
.إنّه هنا

161
00:14:40,740 --> 00:14:45,460
.تملكون جميعًا مكانًا تعودون إليه هنا

162
00:15:00,130 --> 00:15:01,230
.هو-ني

163
00:15:03,560 --> 00:15:04,570
.أنا آسف

164
00:15:05,080 --> 00:15:07,940
.هناك شيء لم أستطع قوله لك من قبل

165
00:15:12,080 --> 00:15:13,830
هل يمكنك سماعي يا جو يون؟

166
00:15:13,830 --> 00:15:15,640
.نعم، بكلّ وضوح

167
00:15:15,890 --> 00:15:16,850
.جيّد

168
00:15:17,810 --> 00:15:22,490
.تعرفون جميعًا أنّني قرّرت عدم خلافة التّينشي

169
00:15:23,080 --> 00:15:27,070
،قد يبدو لنا أنّنا لم نستفد شيئًا من البطولة

170
00:15:27,760 --> 00:15:29,330
.لكنّ الأمر ليس كذلك

171
00:15:30,240 --> 00:15:33,270
سبب اعتقادنا بذلك

172
00:15:33,620 --> 00:15:39,330
هو أنّهّ تم تضليلنا مذ راقب
.جو شو-سان جدّي وهو يموت

173
00:15:39,730 --> 00:15:40,930
تمّ تضليلنا؟

174
00:15:41,600 --> 00:15:44,880
...قال جدّي وهو يحتضر

175
00:15:46,060 --> 00:15:48,570
جميع الأسرار المحيطة بفو هوهو

176
00:15:48,570 --> 00:15:51,130
.لها علاقة بحرب كوشين

177
00:15:52,340 --> 00:15:54,690
.احمي سوران رجاءً

178
00:15:54,690 --> 00:15:59,780
.عندها ستتمكّنين من استرجاع ماضيك

179
00:16:00,570 --> 00:16:02,110
.حرب كوشين

180
00:16:02,620 --> 00:16:06,630
جعل جدّي جو شو-سان يعتقد
،أنّه سيعرف ماضي هو-ني

181
00:16:06,630 --> 00:16:08,880
.إن كشف حقيقتها

182
00:16:09,690 --> 00:16:14,630
.وادّعى أنّ مفتاح معرفة حقيقة حرب كوشين هو أنا

183
00:16:15,330 --> 00:16:21,250
ما يعني أنّ هو-ني ستضطرّ لحمايتي
.إلى أن تُكشف الحقيقة

184
00:16:23,130 --> 00:16:27,170
لا بدّ أنّ جدّي ظنّ أنّ ما من
.طريقة لكِ لاكتشاف الحقيقة

185
00:16:27,950 --> 00:16:34,460
وطالما الأمر كذلك، فسيكون لي حارس
.شخصيّ قويّ في شخص هو-ني

186
00:16:36,190 --> 00:16:40,150
.استغلّ جدّي جو شو-سان وهو-ني

187
00:16:41,600 --> 00:16:44,480
.إذًا خدع تشو كايغي أبي

188
00:16:44,480 --> 00:16:47,750
.تشو كايغي لم يكذب

189
00:16:48,570 --> 00:16:52,570
.بل أنشأ ثغرة في قصّته

190
00:16:52,870 --> 00:16:53,850
.هذا صحيح

191
00:16:53,850 --> 00:16:59,770
كما قال جدّي تمامًا، لا بدّ أنّ لماضي
.هو-ني علاقة بحرب كوشين

192
00:17:00,550 --> 00:17:04,240
.لكنّه لا يتعلّق بها كلّها

193
00:17:05,380 --> 00:17:09,760
هل تذكرون لقاءنا الأوّل مع الشّيوخ؟

194
00:17:10,840 --> 00:17:14,150
.التّينشي وشينتشو-ساما وريكوكين-ساما

195
00:17:14,150 --> 00:17:17,300
.خلّفت كلماتهم وتصرّفاتهم دليلاً مهمًّا

196
00:17:18,200 --> 00:17:23,180
أخبرنا شينتشو-ساما وريكوكين-ساما
.بما يعرفانه في الحال

197
00:17:23,820 --> 00:17:27,830
.لكنّ التّينشي عاند ولم يقل شيئًا

198
00:17:28,520 --> 00:17:30,420
ألا تظنّون أنّ ذلك يعني شيئًا؟

199
00:17:31,050 --> 00:17:34,940
.يملك التّينشي معلومات جوهريّة إذًا

200
00:17:36,730 --> 00:17:42,110
،قال التّينشي أنّه سيخبرني عن حرب كوشين

201
00:17:42,950 --> 00:17:45,590
.إن وافقت على خلافته

202
00:17:46,950 --> 00:17:50,870
أيّ أنّ المرء لا يمكنه معرفة الحقيقة
.إلاّ إذا أصبح التّينشي

203
00:17:51,530 --> 00:17:56,330
.لا بدّ أنّ الحقيقة تكمن في أسلوب التّينشي

204
00:17:57,150 --> 00:18:01,030
ألم ينبغِ عليك إذًا الموافقة على خلافته؟

205
00:18:01,570 --> 00:18:06,350
كنت لتكشف حقيقة حرب كوشين
.إن أصبحت التّينشي

206
00:18:07,440 --> 00:18:11,770
عندما رأيت نور أسلوب التّينشي
،الّذي كان يحاول تعليمه لي

207
00:18:13,050 --> 00:18:16,850
.تذكّرت وضع جدّي للختم عليّ

208
00:18:17,740 --> 00:18:23,150
،لربّما كشف القبول بأسلوب التّينشي الحقيقة

209
00:18:23,580 --> 00:18:28,450
.لكنّني شعرت أنّه سيكبح شيئًا ما بداخلي

210
00:18:28,810 --> 00:18:34,710
ربما كنت لأفقد حتّى القدرة
.على مناقشة حرب كوشين

211
00:18:36,470 --> 00:18:38,980
.أخبرني رجاءً يا معلّمي

212
00:18:40,060 --> 00:18:41,930
.يجب أن أعرف

213
00:18:42,950 --> 00:18:47,750
ما الّذي سيحدث لك بعد أن تعطيني أسلوب التّينشي؟

214
00:18:50,990 --> 00:18:54,600
.الحفيد سرّ جدّه

215
00:18:54,600 --> 00:18:57,620
.أنتما تقلقان كثيرًا

216
00:18:58,680 --> 00:19:05,200
تأكّدت في تلك اللّحظة أنّ الرّاتن تايشو
.عُقِدت لتقييدي بالتّينشيفو

217
00:19:06,630 --> 00:19:10,490
.لهذا السّبب رفضت أن أصبح خليفة التّينشي

218
00:19:11,660 --> 00:19:15,780
.لا بدّ أنّ أسلوب التّينشي نوع من تعاويذ الكبح

219
00:19:16,270 --> 00:19:21,430
لست واثقًا، لكن أظنّ أنّ لها علاقة
.بالفنون السّرّيّة الثّمانية

220
00:19:23,720 --> 00:19:27,100
قام ثمانية أفراد من ستٍّ وثلاثين
عائلة متورّطة في حرب كوشين

221
00:19:27,100 --> 00:19:30,620
.بإنشاء فنون سرّيّة لا يمكن لأيّ شخص عاديّ إدراكها

222
00:19:31,100 --> 00:19:32,730
لكن كيف؟

223
00:19:33,430 --> 00:19:38,510
حتّى وإن تمكّن عبقريّ ما من إنشاء
،فنّ سرّيّ بفعل معجزة

224
00:19:38,510 --> 00:19:41,960
فمن غير الوارد أن يقوم ثمانية منهم
.بنفس الشّيء في آنٍ واحد

225
00:19:42,410 --> 00:19:43,220
.هذا صحيح

226
00:19:43,600 --> 00:19:46,570
.لا بدّ أنّ الجميع يريدون معرفة ذلك السّرّ

227
00:19:47,270 --> 00:19:52,140
.وربمّا ذلك السّرّ يكمن في أسلوب التّينشي

228
00:19:52,920 --> 00:19:58,410
لا، من الممكن أنّ الفنون السّرّيّة الثّمانية
.أُنشِئت من أسلوب التّينشي

229
00:20:00,380 --> 00:20:03,380
.هذا أمر سيّئ إن كان صحيحًا

230
00:20:03,820 --> 00:20:06,850
.لا يوجد دليل على ذلك. إنّه مجرد تخمين منّي

231
00:20:07,360 --> 00:20:13,230
لكن إن كان صحيحًا، فلا حاجة
.لتوريط أنفسنا أكثر من هذا

232
00:20:13,770 --> 00:20:18,780
.هدفنا هو ماضي هو-ني، وليس كشف سرّ حرب كوشين

233
00:20:21,840 --> 00:20:22,760
ما الأمر؟

234
00:20:24,170 --> 00:20:28,090
،هو-ني، إنّه مجرّد حدس فحسب

235
00:20:28,090 --> 00:20:32,430
.لكن لا أظنّ أنّ لماضيك علاقة بحرب كوشين

236
00:20:34,330 --> 00:20:41,080
لكن قد يعرف النّاجون من الحرب
.شيئًا عن ماضيك

237
00:20:41,750 --> 00:20:45,530
لحسن الحظّ أنّنا أنشأنا بعض
.العلاقات خلال الرّاتن تايشو

238
00:20:46,180 --> 00:20:50,810
يمكن القول أنّ ذلك هو أكبر نصر لنا
.في الرّاتن تايشو

239
00:20:51,300 --> 00:20:55,340
،بالتّفكير بالأمر، فقد أنقذت ريكو رينرون

240
00:20:55,340 --> 00:20:57,780
.وقال ريكوكين-ساما أنّ مدين لي بمعروف كبير

241
00:20:57,780 --> 00:20:59,740
.قد نحصل على شيء ما منه

242
00:21:00,730 --> 00:21:04,140
.لذا انتظري قليلاً بعد

243
00:21:04,950 --> 00:21:08,830
.أعدك أن نجد عائلتك

244
00:21:11,510 --> 00:21:12,710
.سوف أنتظر

245
00:21:13,310 --> 00:21:17,610
.جو يون، أحيانًا يكون أذكى منّي

246
00:21:17,610 --> 00:21:19,580
أحيانًا؟

247
00:21:20,210 --> 00:21:24,390
.سوران-كن، نحن نتّفق مع تحليلك

248
00:21:24,960 --> 00:21:29,470
.لكن لا تتّصل بريكوكين-ساما لبعض الوقت

249
00:21:30,080 --> 00:21:34,480
على الأرجح أنّ هناك الكثير لتولّي أمره
.بعد نتائج الرّاتن تايشو

250
00:21:35,020 --> 00:21:39,020
.كما أنّك توصّلت بمهمّة من المكتب

251
00:21:39,020 --> 00:21:40,580
ماذا؟ مهمّة؟

252
00:21:40,940 --> 00:21:44,270
.طلبك أحدهم شخصيًّا هذه المرّة

253
00:21:45,690 --> 00:21:48,070
.توجّه إلى بكين في الحال