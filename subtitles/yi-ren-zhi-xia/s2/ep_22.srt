1
00:01:43,280 --> 00:02:01,680
!تُنشر مانغا "هيتوري نو شيتا: المنبوذ" في شونين جامب+ الآن

2
00:01:45,470 --> 00:01:46,570
.تبًّا

3
00:01:46,570 --> 00:01:48,950
.يجدر بي أن أبحث عن هو-ني

4
00:01:49,870 --> 00:01:52,630
.لا يمكنني إنقاذهما الآن

5
00:01:53,450 --> 00:01:55,390
لمَ أنا متردّد؟

6
00:01:55,700 --> 00:01:57,730
.هذه حرب

7
00:01:57,730 --> 00:01:59,900
.من الطّبيعيّ أن يكون هناك ضحايا

8
00:02:04,030 --> 00:02:06,470
.إنّها فتاة قويّة

9
00:02:06,840 --> 00:02:08,450
.بالطّبع

10
00:02:08,450 --> 00:02:13,770
.لديها جسد وروح مستعمل أسلوب زينشين القويّين

11
00:02:14,420 --> 00:02:16,990
.لن تكون هزيمتها سهلة

12
00:02:17,790 --> 00:02:19,680
.سأدّعي أنّني لم أرهما

13
00:02:20,530 --> 00:02:23,810
،قد يغمرني تأنيب الضّمير لاحقًا

14
00:02:24,230 --> 00:02:27,430
.لكنّني واثق أنّني سأتخطّاه مع الوقت

15
00:02:31,450 --> 00:02:32,730
.عليّ أن أذهب

16
00:02:37,260 --> 00:02:39,620
.أنت فتاة متطلّبة جدًّا

17
00:02:44,360 --> 00:02:46,500
هل أنت تشو سوران؟

18
00:02:48,970 --> 00:02:50,030
!أمسكوا به

19
00:02:50,030 --> 00:02:51,390
!لن تهرب

20
00:02:51,390 --> 00:02:54,200
تبًّا! ما الّذي أفعله؟

21
00:03:07,400 --> 00:03:08,250
!تعالي

22
00:03:22,470 --> 00:03:24,630
!كيف تجرّأت يا سوران؟

23
00:03:24,940 --> 00:03:26,840
هل هناك أعداء آخرون في الجوار؟

24
00:03:26,840 --> 00:03:29,530
.أخبريني بما يجري بسرعة

25
00:03:30,270 --> 00:03:32,030
.ذاك هو عددهم الكامل

26
00:03:32,030 --> 00:03:36,600
.صادفتهم عندما حاصرت تلك المرأة

27
00:03:36,920 --> 00:03:38,140
...على أيّة حال

28
00:03:39,990 --> 00:03:42,320
لماذا تخلّيت عن هانا-تشان؟

29
00:03:43,530 --> 00:03:44,540
.اسمعي جيّدًا

30
00:03:44,540 --> 00:03:49,190
من الصّعب إنقاذكما معًا
.في آن وحد في هذه الظّروف

31
00:03:49,700 --> 00:03:53,200
.ذلك السّمين أقوى مما يبدو

32
00:03:53,200 --> 00:03:56,300
.لم أتوقّع أن يتفادى رايهو خاصّتي

33
00:03:56,850 --> 00:04:01,380
اضطرت لتغيير خطّتي في اللّحظة
.الّتي فشلت فيها في النّيل منه

34
00:04:02,210 --> 00:04:04,720
.لم يعد بإمكان تسو كينكا القتال

35
00:04:04,720 --> 00:04:07,970
.كان من الأفضل إنقاذك أوّلاً

36
00:04:08,340 --> 00:04:09,970
.هذا هو القرار الّذي  اتّخذته

37
00:04:11,250 --> 00:04:14,520
أتظنّان أنّكما قادران على الهرب منّا؟

38
00:04:17,900 --> 00:04:19,930
.اهدأ

39
00:04:19,930 --> 00:04:23,350
.اسمعوا! لديكم أربعة خيارات

40
00:04:24,860 --> 00:04:27,440
.الأوّل هو قتالنا

41
00:04:27,800 --> 00:04:30,780
.الثّاني هو المغادرة دون فعل أيّ شيء

42
00:04:31,130 --> 00:04:34,230
.والثّالث هو أخذها معكم والمغادرة

43
00:04:34,880 --> 00:04:38,070
.والرّابع هو قتلها والمغادرة

44
00:04:39,320 --> 00:04:41,660
!عمّاذا تتحدّث؟

45
00:04:41,660 --> 00:04:44,140
!أفلتيني! أنت تشدّين قميصي

46
00:04:44,140 --> 00:04:45,380
!أنا أحبّ هذا القميص

47
00:04:45,380 --> 00:04:46,310
!لا أهتمّ لذلك

48
00:04:47,040 --> 00:04:50,280
.أخبرتهم بخياراتهم فحسب

49
00:04:50,280 --> 00:04:54,190
.بدؤوا يفكّرون في إيجابيّات وسلبيّات كلّ منها

50
00:04:54,190 --> 00:04:54,880
ماذا؟

51
00:04:55,580 --> 00:05:01,330
قد نتمكّن من هزيمتهم جميعًا
.إن كنا مستعدّين للمجازفة بحياتنا

52
00:05:01,730 --> 00:05:05,550
.لكن من الممكن أن نُقتل أيضًا

53
00:05:06,920 --> 00:05:09,520
.أفضّل تجنّب القتال المباشر

54
00:05:10,110 --> 00:05:12,450
.وأنا واثق أنّهم يفضّلون ذلك أيضًا

55
00:05:13,830 --> 00:05:15,780
.يا له من فتى وقح

56
00:05:16,230 --> 00:05:19,530
.اسمع. خذ المرأة واذهب

57
00:05:20,050 --> 00:05:22,600
.سنبطئهما

58
00:05:23,470 --> 00:05:27,590
ماذا ستفعل الآن يا تشو سوران؟

59
00:05:30,030 --> 00:05:31,440
.لقد قلت لكم

60
00:05:33,390 --> 00:05:36,130
!لديكم أربعة خيارات فقط

61
00:05:40,830 --> 00:05:42,340
هل تفهمون الآن؟

62
00:05:42,820 --> 00:05:46,990
ناغاموشي الأبيض خاصّتي يسمح لي
بإنشاء هجمات بعيدة المدى

63
00:05:46,990 --> 00:05:49,210
.على شخص لديّ دمه

64
00:05:49,620 --> 00:05:54,070
.حصل على دم هانا-تشان في تلك المناوشة السّابقة

65
00:05:54,660 --> 00:05:57,670
،يمكنكم فعل ما يحلو لكم بها

66
00:05:58,180 --> 00:06:00,000
،لكن إن حاولتم أخذها

67
00:06:00,000 --> 00:06:03,220
.ستصابون بهجمات ناغاموشي الأبيض

68
00:06:04,150 --> 00:06:07,730
.إن كنتم عازمين على أخذها، فتفضّلوا

69
00:06:09,530 --> 00:06:15,100
،قلت لكم أنّ لديكم أربعة خيارات
.لكن في الحقيقة لديكم اثنان فقط

70
00:06:15,100 --> 00:06:18,680
.تكرها أو قتلها

71
00:06:19,060 --> 00:06:23,010
...لكن لمعلوماتكم، إن اخترتم الخيار الثّاني

72
00:06:23,990 --> 00:06:26,290
.فسأقتلكم أو أموت محاولاً ذلك

73
00:06:28,780 --> 00:06:30,520
إلى أين أنت ذاهب؟

74
00:06:30,520 --> 00:06:32,070
.سنغادر

75
00:06:32,570 --> 00:06:35,830
.تلك المرأة لا تستحقّ كلّ ذلك

76
00:06:35,830 --> 00:06:38,920
.إنّه مستعدّ لتركنا نرحل

77
00:06:38,920 --> 00:06:40,910
.سنقبل عرضه

78
00:06:40,910 --> 00:06:44,310
!تبًّا! لكنّنا أمسكنا أحدهم أخيرًا

79
00:06:45,780 --> 00:06:48,290
.أنت تريد المرأة فحسب

80
00:06:48,560 --> 00:06:53,800
.إن كنت مستعدًّا للموت من أجلها، فلن أوقفك

81
00:06:59,080 --> 00:07:00,760
!تبًّا

82
00:07:01,860 --> 00:07:03,130
!هانا-تشان

83
00:07:04,800 --> 00:07:06,250
.تماسكي

84
00:07:07,370 --> 00:07:09,950
ألم تستطع التّفكير في خطّة أفضل؟

85
00:07:10,690 --> 00:07:13,680
.لم أستطع التّفكير في أيّ شيء آخر

86
00:07:15,180 --> 00:07:17,980
.إنّهم شياطين حقيقيّون

87
00:07:19,030 --> 00:07:22,460
.لم يزعجهم موت أحد رفاقهم أبدًا

88
00:07:22,890 --> 00:07:26,390
.ما فعلته لا يُعَدّ شيئًا مقارنة بذلك

89
00:07:27,130 --> 00:07:28,250
.يرحلون

90
00:07:28,740 --> 00:07:32,020
.عندما يموت النّاس، يرحلون عن هذا العالم

91
00:07:33,440 --> 00:07:36,740
.لم أشكّ في وجودي من قبل

92
00:07:37,830 --> 00:07:39,860
.استخففت بالحياة

93
00:07:40,340 --> 00:07:42,290
.حتّى أنّني ظننتها مملّة

94
00:07:42,690 --> 00:07:47,490
.لذا تطلّعت لشيء مميّز، لمعجزة ما

95
00:07:48,490 --> 00:07:53,690
.لكن عندما واجهتها، أدركت شيئًا

96
00:07:54,480 --> 00:08:00,080
.ما أردته دائمًا شيء وصفُه تافه للغاية

97
00:08:00,900 --> 00:08:05,660
.وعندما اختفى، خسرت كلّ شيء

98
00:08:07,160 --> 00:08:11,140
.شعرت بالحياة لأوّل مرّة

99
00:08:11,590 --> 00:08:13,690
.الحياة معجزة في حدّ ذاتها

100
00:08:14,290 --> 00:08:18,040
.هناك إمكانيّات لا نهائيّة ما دمنا أحياءً

101
00:08:18,760 --> 00:08:22,440
،لكن في اللّحظة الّتي تنتهي فيها هذه المعجزة

102
00:08:22,440 --> 00:08:25,940
.تختفي تلك الإمكانيّات وكلّ شيء آخر

103
00:08:26,450 --> 00:08:27,550
.تختفي

104
00:08:32,310 --> 00:08:33,590
سوران؟

105
00:08:34,520 --> 00:08:38,180
.لم أكن أحاول أن ألومك

106
00:08:38,180 --> 00:08:40,950
.أنا ممتنّة حقًّا لأنّك أنقذتنا

107
00:08:42,600 --> 00:08:44,140
.هذا المكان خطير

108
00:08:44,520 --> 00:08:46,660
.علينا إيجاد البقيّة

109
00:08:47,210 --> 00:08:48,070
!اتبعيني

110
00:08:48,710 --> 00:08:50,650
!مهلاً، انتظر

111
00:08:51,480 --> 00:08:54,770
.آمل أن تكوني بخير يا هو-ني

112
00:09:09,790 --> 00:09:10,940
.مذهل

113
00:09:11,320 --> 00:09:15,010
.توقّفت عن الشّعور بنفَسه لحظة اختبائه

114
00:09:15,640 --> 00:09:17,650
.لم أقاتل أحدًا مثله من قبل

115
00:09:17,650 --> 00:09:19,120
.يا آنسة

116
00:09:19,520 --> 00:09:23,000
،أعلم أنّك لا تطيقين الانتظار للعودة إلى تشو سوران

117
00:09:23,000 --> 00:09:26,270
.لكن لا ينبغي عليك أن تشتّتي انتباهك حاليًّا

118
00:09:26,980 --> 00:09:31,070
.بارون يملك الأفضليّة في الغابة

119
00:09:31,570 --> 00:09:33,800
.إنّه مقاتل محترف

120
00:09:34,280 --> 00:09:37,680
.تشتيت انتباهك لن يكون في مصلحتك

121
00:09:38,350 --> 00:09:42,050
.ركّزي على هزيمة خصمك

122
00:09:43,100 --> 00:09:44,100
...حسنًا

123
00:09:44,430 --> 00:09:49,300
.ذلك العجوز... إنّه يساعد العدوّ

124
00:09:50,780 --> 00:09:52,590
أوقفت النّزيف؟

125
00:09:52,590 --> 00:09:55,240
.بدأ الجرح يلتئم بالفعل

126
00:09:55,890 --> 00:09:57,810
.يا لها من فتاة غريبة

127
00:09:58,670 --> 00:10:02,320
.كما قال ذلك المحارب بالضّبط

128
00:10:02,980 --> 00:10:06,870
.ما أريتكم إيّاه الآن كانت ذاكرة شخص معيّن

129
00:10:07,130 --> 00:10:14,590
،مظهر الفتاة الّتي بها، فو هوهو
.لم يتغيّر أبدًا منذ عشر سنوات

130
00:10:15,250 --> 00:10:18,630
ما رأيكما أيّها العجوز ريوسي ويا بارون-سان؟

131
00:10:18,630 --> 00:10:20,650
مثير للاهتمام، صحيح؟

132
00:10:21,370 --> 00:10:24,250
.إنّه أمر غامض حقًّا

133
00:10:24,250 --> 00:10:30,390
ما علاقة هذه الفتاة بحرب كوشين؟

134
00:10:30,910 --> 00:10:34,000
الذّكرى الّتي أريتكما إيّاها تنتمي

135
00:10:34,000 --> 00:10:38,020
.للشّخصيّة المركزيّة لحرب كوشين، تشو كايغي

136
00:10:38,340 --> 00:10:42,980
ماذا؟ تلك الفتاة قتلت تشو كايغي؟

137
00:10:44,940 --> 00:10:52,690
لكن إن قتلت تشو كايغي، فلست
.واثقًا أنّ بإمكاننا تولّي أمرها

138
00:10:53,060 --> 00:10:56,410
أنا واثق أيضًا أنّ شركة التّوصيل السّريع
.ستكون هناك أيضًا

139
00:10:56,970 --> 00:10:58,230
.لا تقلق

140
00:10:58,540 --> 00:11:03,140
سنأمر الآخرين بمهاجمة ريوكوسان
.وتشتيت انتباههم

141
00:11:03,680 --> 00:11:08,590
.أريدكما أن تحضرا لي فو هوهو

142
00:11:25,600 --> 00:11:28,150
،رغم تعرّضها لإصابة بليغة واضحة

143
00:11:28,710 --> 00:11:31,880
.شفي جسدها الغريب في وقت قصير

144
00:11:32,600 --> 00:11:34,620
.كما قال ذلك المحارب بالضّبط

145
00:11:35,480 --> 00:11:38,420
.ذلك الغموض مثير للاهتمام

146
00:11:39,450 --> 00:11:43,310
.لكن هناك شيء آخر عليّ التّحقّق منه

147
00:11:44,630 --> 00:11:48,690
ما الّذي يخطّط له؟

148
00:12:09,520 --> 00:12:11,270
ما الّذي  فعلته؟

149
00:12:11,270 --> 00:12:13,550
.كان ذلك سريعًا. لم أرَ شيئًا

150
00:12:14,820 --> 00:12:17,900
.ضربت عصبها المبهم

151
00:12:18,180 --> 00:12:24,130
بمصطلحات هذه البلاد، أصبت
.الدّاتشانغجين الخاصّ بها

152
00:12:28,350 --> 00:12:29,960
.ما زالت واعية

153
00:12:35,800 --> 00:12:37,950
.علمت أنّني شعرت بشيء ما

154
00:12:38,350 --> 00:12:40,170
.كنت محقًّا

155
00:12:41,570 --> 00:12:43,340
هل انتهيت؟

156
00:12:43,340 --> 00:12:46,060
.نعم. افعل ما يحلو لك بها

157
00:12:49,910 --> 00:12:53,900
.ما زالت مفعمة بالحيويّة

158
00:13:04,110 --> 00:13:06,810
.كنت تعاني كثيرًا قبل قليل

159
00:13:06,810 --> 00:13:09,740
.كان ذلك سهلاً هذه المرّة

160
00:13:11,300 --> 00:13:13,710
،أنا مهتمّ بشيئين

161
00:13:14,280 --> 00:13:18,100
.المجهول والتّهديد الّذي يحيطه المجهول

162
00:13:19,610 --> 00:13:22,750
.لفتت هذه الفتاة انتباهي بالفعل

163
00:13:23,280 --> 00:13:27,710
.لكنّني لم أرصد أيّ عدوانيّة منها

164
00:13:28,630 --> 00:13:31,950
.كنت جنديًّا كما تعلم

165
00:13:33,130 --> 00:13:37,590
.القضاء على العدوّ له الأولويّة القصوى في الحرب

166
00:13:38,190 --> 00:13:42,920
القدرة على تحديد ما إن كان

167
00:13:43,270 --> 00:13:47,900
.شخص ما عدوًّا في الحال مهارة جوهريّة

168
00:13:49,170 --> 00:13:53,150
،حتّى وإن تسبّبت هفوة في الحكم في خطأ قاتل

169
00:13:53,900 --> 00:13:56,990
لا ينبغي عليك أبدًا التّوقّف عن الحكم
.على عدوانيّة شخصٍ ما

170
00:13:59,090 --> 00:14:02,840
.بمجرّد تخطّي ذلك الخطّ، تصبح قاتلاً

171
00:14:03,190 --> 00:14:07,020
.وفي النّهاية، تصبح سفّاحًا

172
00:14:07,900 --> 00:14:11,130
.لم أشعر بأيّ عدوانيّة منها

173
00:14:12,030 --> 00:14:13,940
.ليست تهديدًا بالنّسبة لي

174
00:14:14,380 --> 00:14:17,040
.لا يمكنني اعتبارها عدوًّا لي

175
00:14:17,480 --> 00:14:22,510
ألا يُفترض بالجنود اتّباع الأوامر؟

176
00:14:23,450 --> 00:14:26,630
.أنا لم أصبح فردًا منكم بعد

177
00:14:27,510 --> 00:14:32,100
.أتيت إلى ريوكوسان لفهم زينسي

178
00:14:33,020 --> 00:14:37,270
.حرب كوشين مثيرة للاهتمام حقًّا

179
00:14:37,730 --> 00:14:43,860
كنت لأنضمّ إليكم لو كنتم تبحثون
.عن الحقيقة وراءها

180
00:14:44,660 --> 00:14:47,540
.لكنّكم تتمادون كثيرًا

181
00:14:48,760 --> 00:14:51,630
.لكن ينبغي عليّ أن أشكرك

182
00:14:51,630 --> 00:14:54,880
.التقيت بشخص مثير للاهتمام بفضلك

183
00:14:56,570 --> 00:14:58,200
.غير معقول

184
00:14:58,200 --> 00:15:00,720
.علمت أنّه لا يمكننا الاعتماد على دخيل

185
00:15:10,530 --> 00:15:12,140
.إنّها صرصور

186
00:15:13,270 --> 00:15:14,580
ألن تلحق بها؟

187
00:15:16,980 --> 00:15:18,720
...ربّما هيّ مخيّلتي فقط

188
00:15:19,790 --> 00:15:26,390
.لكنّك أصبحت سعيدًا منذ أن التقيناها

189
00:15:27,190 --> 00:15:29,860
.شيء بها يشعرني بالحنين

190
00:15:30,520 --> 00:15:35,910
.النّظر إليها يذكّرني بالماضي

191
00:15:38,180 --> 00:15:40,400
.سأحضر السّاكي لاحقًا

192
00:15:41,370 --> 00:15:43,290
.خسرت الرّهان

193
00:15:44,330 --> 00:15:48,110
.وُلدت تلك الصّرصور بتلك القوّة بالتّأكيد

194
00:15:57,260 --> 00:15:58,890
كيف الأحوال عندكم؟

195
00:15:59,480 --> 00:16:01,680
.خسرنا ما بين سبعين وثمانين بالمائة منّا

196
00:16:01,680 --> 00:16:03,930
.وأغلب الباقي هربوا

197
00:16:04,320 --> 00:16:07,290
هل حصلتم على تسوتينروكو؟

198
00:16:07,600 --> 00:16:09,050
.فشلنا

199
00:16:09,570 --> 00:16:11,780
.اعترض التّينشي طريقنا

200
00:16:12,150 --> 00:16:13,480
التّينشي؟

201
00:16:14,310 --> 00:16:15,960
.لست محظوظًا أبدًا

202
00:16:15,960 --> 00:16:16,400
.أنت

203
00:16:18,010 --> 00:16:20,020
لماذا تضحك؟

204
00:16:20,020 --> 00:16:22,630
ما الّذي أنجزته؟

205
00:16:25,800 --> 00:16:30,090
لِمَ أنت منفعل جدًّا يا إين-سان؟

206
00:16:30,090 --> 00:16:32,890
.ذلك لأنّه فشل في قتل ريكوكين

207
00:16:33,210 --> 00:16:37,230
.أجل، صحيح. كما أنّني كنت قريبًا من ذلك

208
00:16:54,090 --> 00:16:56,780
ما الّذي فعلته؟

209
00:16:57,900 --> 00:16:59,100
...بديّ هاتين

210
00:17:00,130 --> 00:17:01,640
...لقد

211
00:17:06,090 --> 00:17:07,820
.لا تبالغ في تقدير نفسك

212
00:17:09,850 --> 00:17:13,200
.لا يمكنك قتلي

213
00:17:14,150 --> 00:17:16,090
!لا تخفني هكذا

214
00:17:16,090 --> 00:17:18,290
!كان عليك أن تقول شيئًا إن كنت حيًّا

215
00:17:18,290 --> 00:17:20,550
.أنت من أخافني

216
00:17:20,550 --> 00:17:25,670
لماذا يبكي رجل تخطّى المائة سنة كطفل صغير؟

217
00:17:27,540 --> 00:17:31,000
.أنت لا تعرف قوّتك

218
00:17:31,000 --> 00:17:36,570
لم يكن من السّهل عليّ حماية نفسي
.بالكينكوجو أثناء إعادتك إلى صوابك

219
00:17:37,200 --> 00:17:42,980
ركّزت الكينكوجو على حماية أعضائي
.وأوعيتي الدّمويّة

220
00:17:43,500 --> 00:17:46,810
.لكنّك كسرت بعض العظام

221
00:17:48,190 --> 00:17:52,430
كيفّ ستردّ الدّين إذًا؟

222
00:17:55,170 --> 00:17:57,620
.أنا لست كالبشر العاديّين

223
00:17:58,160 --> 00:18:00,000
.أنا منحرف

224
00:18:01,460 --> 00:18:05,550
.يقتل النّاس بعضهم بعضًا عندما تُهَدَّد حياة المرء

225
00:18:06,360 --> 00:18:09,970
.لكنّني أقتل لأنّني أستمتع بذلك

226
00:18:11,870 --> 00:18:13,520
!اصفح عنّي أرجوك

227
00:18:13,810 --> 00:18:17,430
!اتّبعت الآخرين فقط

228
00:18:17,430 --> 00:18:20,280
!لا أعرف شيئًا عن زينسي

229
00:18:20,280 --> 00:18:22,770
!لا تقتلني أرجوك

230
00:18:23,980 --> 00:18:26,100
