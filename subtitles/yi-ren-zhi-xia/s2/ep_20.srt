1
00:00:16,190 --> 00:00:18,570
جو سان، كيف تجري الأمور عندك؟

2
00:00:18,980 --> 00:00:20,400
.هوهو مفقودة

3
00:00:20,770 --> 00:00:24,450
.ادخلا بسرع واشرحا الوضع للتّينشي

4
00:00:24,970 --> 00:00:26,080
.توقّف

5
00:00:33,190 --> 00:00:35,830
.وما يحدث الآن ليس اضطرابًا بسيطًا

6
00:00:36,280 --> 00:00:38,870
.لا بدّ أنّ التّينشي قد لاحظه

7
00:00:50,520 --> 00:00:51,710
...معلّمي

8
00:00:52,310 --> 00:00:55,010
.هذه المرّة الثّالثة

9
00:00:55,010 --> 00:00:56,480
ما الّذي يجري؟

10
00:00:57,130 --> 00:01:01,260
.لا أظنّني ارتكبت أيّ خطأ

11
00:01:01,820 --> 00:01:06,200
ألا تريد أن تصبح التّينشي؟

12
00:01:07,050 --> 00:01:12,400
،إن أردتني أن أصبح التّينشي حقًّا
.فأريدك أن تجيبني على سؤال

13
00:01:13,080 --> 00:01:16,540
.وسؤالي لا علاقة له بحرب كوشين

14
00:02:54,280 --> 00:02:55,350
.دعاني أمر

15
00:02:55,350 --> 00:02:57,570
.لا يمكنني الانتظار أكثر من هذا

16
00:02:56,900 --> 00:03:11,000
!تُنشر مانغا "هيتوري نو شيتا: المنبوذ" في شونين جامب+ الآن

17
00:02:57,570 --> 00:03:00,220
.اهدأ يا جو سان-سان

18
00:03:00,220 --> 00:03:02,130
.هذا ليس وقت الهدوء

19
00:03:02,130 --> 00:03:06,080
.إن لم تخرج التّينشي، فسأدخل بالقوّة

20
00:03:14,170 --> 00:03:15,230
سوران-كن؟

21
00:03:20,130 --> 00:03:23,470
.الولد سرّ جدّه

22
00:03:23,470 --> 00:03:25,850
.أنت مثير للسّخط حقًّا

23
00:03:26,140 --> 00:03:30,410
.معلّمي، لم أكن أحاول إغضابك عمدًا

24
00:03:32,190 --> 00:03:35,530
،سوران، بسببك

25
00:03:35,530 --> 00:03:41,520
ستسقط سمعة الرّاتن تايشو
.الّتي نشّطت مجتمع الدّخلاء بالتّأكيد

26
00:03:41,520 --> 00:03:42,650
،معلّمي

27
00:03:43,840 --> 00:03:46,790
.انتقادي الآن لن يساعد في شيء

28
00:03:46,790 --> 00:03:48,880
،كيفما نظرت إلى الأمر

29
00:03:48,880 --> 00:03:51,910
.فهذا ليس الوقت لتعليمي أسلوب التّينشي

30
00:03:52,610 --> 00:03:56,180
.التّينشيفو تحتاج قوّتك

31
00:03:57,620 --> 00:04:03,470
.تبًّا... الجميع يتسبّبون بالمشاكل دائمًا

32
00:04:08,150 --> 00:04:08,970
...مستحيل

33
00:04:09,250 --> 00:04:11,380
!انتظر رجاءً أيّها التّينشي

34
00:04:15,860 --> 00:04:17,470
هل أنت بخير يا سينباي؟

35
00:04:19,570 --> 00:04:23,310
.كينكوجو أسلوبِ شويتسو ليس بالشّيء الكثير

36
00:04:25,660 --> 00:04:28,220
يبدو أنّ قوانينكم تمنعكم

37
00:04:28,220 --> 00:04:31,750
،من إطلاق العنان لرغباتكم أو اختبار المتعة

38
00:04:32,170 --> 00:04:38,790
،لكن إن عشتم حياة مقيّدة كتلك
.فلن تصلوا إلى مستوانا

39
00:04:39,270 --> 00:04:45,060
،للوصول إلى إمكانيّاتكم القصوى
.عليكم مواجهة طبيعتكم الحقيقيّة

40
00:04:45,880 --> 00:04:50,200
يمكننا التّحسّن فقط بتجاهل ما يظنّه الغير

41
00:04:50,200 --> 00:04:55,350
.واتّباع طبيعتنا الحقيقيّة وفعل ما نريده

42
00:04:55,790 --> 00:05:00,650
.هذه هي تعاليم يوشو، مؤسّس زينسي

43
00:05:01,970 --> 00:05:03,420
ما الخطب؟

44
00:05:03,420 --> 00:05:05,800
هل كنت محقًّا لدرجة أنّكم لا تستطيعون الرّدّ؟

45
00:05:05,800 --> 00:05:10,990
.كلّ ما تجيده هو التّفوّه بحجج زائفة يا ولد

46
00:05:10,990 --> 00:05:12,250
!من أنت؟

47
00:05:20,270 --> 00:05:22,800
!تبًّا! إنّه لا يتحرّك

48
00:05:22,800 --> 00:05:29,510
حتّى وإن كان منح شعرة من شعرك
.يفيد العالم، فلا تفعل

49
00:05:30,070 --> 00:05:33,810
.هذا هو منطق مؤسّسكم يوشو

50
00:05:34,210 --> 00:05:38,900
.لكنّ هذا جانب واحد من تعاليم زينسي

51
00:05:39,750 --> 00:05:46,450
حتّى وإن كان أخذ شعرة من أحد
.ستؤذي العالم، فلا تفعل

52
00:05:47,190 --> 00:05:50,210
.هذا هو الجانب الآخر من تعاليمه

53
00:05:51,180 --> 00:05:55,400
.ترفضون إعطاء أو أخذ شعرة واحدة

54
00:05:56,170 --> 00:06:04,070
الرّجال العاديّون أمثالنا ندّعي
،أنّنا نجحنا بتخطّي إغراءات العالم

55
00:06:04,700 --> 00:06:10,550
.لكنّ طموح مؤسّسكم يوشي كان أعظم بكثير

56
00:06:11,110 --> 00:06:15,370
.إنّه التّخلّي عن كلّ شيء في هذا العالم

57
00:06:16,090 --> 00:06:19,710
.لكنّ هذا المبدأ متطرّف جدًّا

58
00:06:19,710 --> 00:06:22,990
،ربّما تمكّن يوشو بنفسه من تحقيقه

59
00:06:23,740 --> 00:06:27,610
لكن إن اتّبع رجال عاديّون مثلكم
،ومثلي ذلك الدّرب

60
00:06:28,000 --> 00:06:30,640
.فسننحرف عنه

61
00:06:31,030 --> 00:06:34,500
.مثلما أنتم الآن

62
00:06:35,540 --> 00:06:39,750
تؤمنون أنّ جانبًا واحدًا من تعاليم
.يوشو هو كلّ شيء

63
00:06:40,510 --> 00:06:46,970
.وأنّ زينسي تعني تقبّل السّجيّة الّتي ولدتم بها

64
00:06:47,750 --> 00:06:51,930
.أنتم تحت تحكّم رغباتكم فقط

65
00:06:52,520 --> 00:06:58,800
المنشقّون الّذين تستعبدهم رغباتهم
ويسبّبون المشاكل في كلّ مكان

66
00:06:59,360 --> 00:07:03,470
!لا يحقّ لهم أن ينادوا أنفسهم بزينسي

67
00:07:10,400 --> 00:07:12,520
،بعد العيش لأكثر من مائة سنة

68
00:07:12,520 --> 00:07:15,520
.لم أتوقّع أن تسنح لي فرصة قتال أحد ما

69
00:07:16,740 --> 00:07:21,120
.أفترض أنّ عليّ الذّهاب والتّرفيه عن نفسي

70
00:07:35,220 --> 00:07:37,140
أ-أيّها التّينشي؟

71
00:07:37,140 --> 00:07:40,130
.يا لقلّة انضباطكم

72
00:07:40,430 --> 00:07:44,260
.لا أصدّق أنّكم كنتم تذعرون بسبب هؤلاء الرّجال

73
00:07:46,180 --> 00:07:47,580
!فلتمت

74
00:07:50,720 --> 00:07:53,730
أهذه قوّة كينكوجو التّينشي؟

75
00:07:53,730 --> 00:07:56,110
لم تتمكّن نطحة ذلك الرّجل
!ذي الرّأس الصّلب كسره

76
00:07:57,740 --> 00:07:59,220
!أنت لي

77
00:07:59,700 --> 00:08:02,500
!لا أحد أسرع منّي

78
00:08:06,140 --> 00:08:07,840
.يا إلهي

79
00:08:09,390 --> 00:08:12,490
.الأطفال يستمتعون حقًّا بالرّكض في الأرجاء

80
00:08:13,140 --> 00:08:17,310
.لكن من الأفضل لهم أن ينتبهوا لخطواتهم

81
00:08:17,710 --> 00:08:19,280
...مـ-مذهل

82
00:08:19,280 --> 00:08:22,220
.لم أر التّينشي يقاتل من قبل

83
00:08:22,220 --> 00:08:24,180
أكان ذلك كينكوجو أيضًا؟

84
00:08:24,530 --> 00:08:27,970
!إنّه التّينشي الخامس والسّتّون، تشو جيي

85
00:08:28,270 --> 00:08:30,050
!بدأت أتحمّس

86
00:08:30,050 --> 00:08:33,270
!لا أهتمّ إن متّ إن عنى ذلك قتاله

87
00:08:33,940 --> 00:08:36,250
!سأقضي عليه

88
00:08:36,860 --> 00:08:40,030
!لا يمكنكم هزيمة التّينشي

89
00:08:40,030 --> 00:08:41,780
!لن نعرف إن لم نجرّب

90
00:08:41,780 --> 00:08:43,660
!استعدّ أيّها العجوز

91
00:08:45,180 --> 00:08:47,680
.أ-أنت، لنذهب من هنا

92
00:08:47,680 --> 00:08:50,030
!أجل. لا نملك فرصة أمامه

93
00:08:50,350 --> 00:08:53,300
!تبًّا، أرفض الموت هنا

94
00:09:15,850 --> 00:09:18,800
.غياكسي ساجو وتسوتينروكو

95
00:09:18,800 --> 00:09:21,450
.إنّه يستعمل تقنيات مثيرة للمتاعب

96
00:09:23,650 --> 00:09:25,460
.ريكوكين-سينباي

97
00:09:25,460 --> 00:09:28,640
هلاّ غادرت الآن؟

98
00:09:29,030 --> 00:09:31,650
.الجبل يعجّ بأفراد زينسي

99
00:09:32,050 --> 00:09:35,050
لِمَ لا تنفّس عن إحباطك عليّهم بدلاً منّا؟

100
00:09:35,590 --> 00:09:38,250
،أنوي ذلك بالطّبع

101
00:09:38,250 --> 00:09:41,800
.بعد أن أنتهي منك ومن ذلك الضّخم

102
00:09:41,800 --> 00:09:43,560
.يا إلهي

103
00:09:43,560 --> 00:09:47,770
،أعلم أنّ المجتمع لا يحبّ زينسي

104
00:09:47,770 --> 00:09:51,800
لكنّي لا أذكر فعل شيء يستحقّ
.كراهية عائلة ريكو

105
00:09:51,800 --> 00:09:56,950
هل للأمر علاقة بمعلّمك البخيل؟

106
00:09:57,400 --> 00:09:58,560
!أيّها الوغد

107
00:09:58,560 --> 00:10:01,220
!لن تفلت بإهانتك لمعلّمي

108
00:10:11,040 --> 00:10:15,370
.لا يمكن حتّى لمعوّذَيْن وسلاح دفاعيّ إيقافه

109
00:10:16,580 --> 00:10:18,840
.إنّه وحش لا يُصَدّق

110
00:10:19,520 --> 00:10:21,940
.اهدأ يا ريكوكين-ساما

111
00:10:21,940 --> 00:10:24,210
.لا يجب أن تدعه يغيظك

112
00:10:24,480 --> 00:10:27,050
!اخرس! لا تتدخّل أيّها الطّفل

113
00:10:27,680 --> 00:10:31,270
.لا تتحدّث إليّ بتلك الطّريقة أيّها العجوز القذر

114
00:10:31,270 --> 00:10:33,040
!كيف تجرؤ على مناداتي بذلك؟

115
00:10:33,040 --> 00:10:34,390
!سأبدأ بك

116
00:10:37,000 --> 00:10:39,650
وغد! ما الّذي فعلته؟

117
00:10:40,210 --> 00:10:44,640
ريغيوكو، احم الزّوجوين غانجينشو
.والشّوشاويين شينجينشو خاصّتك

118
00:10:45,630 --> 00:10:47,200
...ما الّذي

119
00:10:49,410 --> 00:10:54,170
.أشعر أنّني قلت شيئًا وقحًا جدًّا لك

120
00:10:54,490 --> 00:10:57,730
.تمّ تضخيم كراهيتنا

121
00:10:57,730 --> 00:11:02,000
.يبدو أنّنا وقعنا في فخّهما

122
00:11:03,030 --> 00:11:06,640
.أعطيتك فرصة للهرب

123
00:11:06,910 --> 00:11:11,940
،إن هُزمتَ هنا اليوم
.فأريدك أن تتذكّر شيئًا واحدًا

124
00:11:12,300 --> 00:11:15,430
.لم أكنّ لك أيّ نية سيئة

125
00:11:20,020 --> 00:11:21,170
.عرفت ذلك

126
00:11:21,170 --> 00:11:23,200
.كوني من رايّنهو

127
00:11:27,680 --> 00:11:30,050
!كيوروكو أونفوكيفو

128
00:11:31,990 --> 00:11:33,470
ما هذه التّمائم؟

129
00:11:33,470 --> 00:11:35,740
!نظام خطّي الطّوليّ يتمّ كبحه

130
00:11:36,780 --> 00:11:37,490
.تبًّا

131
00:11:37,920 --> 00:11:41,370
،عندما يكون ذلك الأصلع قريبًا منّي
.أشعر بالاكتئاب بشكل لا يقام

132
00:11:41,970 --> 00:11:43,330
!شيجو رايفو

133
00:11:49,450 --> 00:11:50,560
تو باي؟

134
00:11:54,640 --> 00:11:57,490
...يجب أن تعرف يا ريكوكين-سينباي

135
00:11:57,960 --> 00:12:00,820
ما يجعل سحرة زينسي الأربعة مرعبين

136
00:12:00,820 --> 00:12:03,370
.هو قدرتهم على سحق روح الشّخص

137
00:12:04,410 --> 00:12:10,550
الغياكسي سانجو والتسوتينروكو
.خاصّتاك لن ينجحا معهم

138
00:12:11,730 --> 00:12:13,820
.دعني أتولّى الأمر

139
00:12:14,410 --> 00:12:15,640
!انتشار

140
00:12:16,380 --> 00:12:18,040
.لا تفعل يا ريغيوكو

141
00:12:18,040 --> 00:12:21,160
.لا تشتّت انتباهك باستعمال الكونغ فو

142
00:12:21,160 --> 00:12:23,040
.اخرج من هنا

143
00:12:23,440 --> 00:12:26,110
.لا يمكنني أن أتركك هنا

144
00:12:32,080 --> 00:12:33,600
ريكوكين-ساما؟

145
00:12:33,600 --> 00:12:35,320
.دعني أتولّى الأمر

146
00:12:35,660 --> 00:12:39,280
.سحرة زينسي الأربعة أقوياء

147
00:12:39,770 --> 00:12:46,150
لكنّني سأقتل أولئك المنشقّين اليوم
،حتّى وإن كلّفني ذلك حياتي

148
00:12:47,780 --> 00:12:52,800
.أتمنّى لو استطعت القضاء على آخر السّحرة هنا

149
00:12:52,800 --> 00:12:55,630
هل تتحدّث عنّي؟

150
00:12:58,500 --> 00:13:05,870
.لم أهاجم لأنّك أكثر جاذبيّة من أن تُقتل

151
00:13:06,160 --> 00:13:07,420
ناتسكا؟

152
00:13:07,420 --> 00:13:10,510
.لم نرَ بعضنا منذ وقت طويل

153
00:13:10,810 --> 00:13:13,580
.لا تعبس هكذا

154
00:13:19,340 --> 00:13:21,120
ما الخطب يا جدّي؟

155
00:13:21,510 --> 00:13:23,980
.تبدو مرهقًا

156
00:13:24,420 --> 00:13:27,100
هل حدث شيء سيّئ ما؟

157
00:13:28,730 --> 00:13:31,110
ما الّذي تفعله يا أبي؟

158
00:13:31,630 --> 00:13:33,660
.أسرع يا جدّي

159
00:13:33,660 --> 00:13:35,800
.طعامك يبرد يا عمّي

160
00:13:35,800 --> 00:13:37,850
.لنأكل معًا

161
00:13:37,850 --> 00:13:40,140
.لا تقف هناك فحسب

162
00:13:40,750 --> 00:13:43,610
.تعال إلى هنا يا جدّي

163
00:13:44,030 --> 00:13:46,000
.لا حاجة لأن تجهد نفسك

164
00:13:47,190 --> 00:13:50,130
.الجميع في انتظارك

165
00:14:06,140 --> 00:14:07,530
.ريكوكين-سان

166
00:14:09,010 --> 00:14:11,640
.لا داعي للوصول لذلك الحدّ

167
00:14:12,840 --> 00:14:17,780
ما زلت مهووسًا بتدمير زينسي
.مع أنّك تجاوزت المائة سنة

168
00:14:18,710 --> 00:14:21,910
لِمَ لا تتوقّف؟

169
00:14:24,430 --> 00:14:26,800
.أنا عنيد كما تعلمين

170
00:14:27,280 --> 00:14:31,900
.لن أتوقّف حتّى أبيدكم جميعًا

171
00:14:32,400 --> 00:14:36,850
.أملك القوّة لمحو ألم النّاس

172
00:14:37,650 --> 00:14:40,380
.سأحرص على ألاّ يكون موتك مؤلمًا

173
00:14:42,050 --> 00:14:45,620
تو باي، ريكوكين-سينباي
.ليس ضعيفًا لتلك الدّرجة

174
00:14:46,390 --> 00:14:50,270
من الجنون أن تظنّي أنّك قادرة على
.التّحكّم به في هذه الفترة الوجيزة

175
00:14:51,020 --> 00:14:56,000
يجدر بنا إمساكه بدلاً عن ذلك
.وأخذ وقتنا في تعذيبه في الدّيار

176
00:15:00,220 --> 00:15:03,280
.تماسك يا ريكوكين-ساما

177
00:15:03,280 --> 00:15:05,060
.قلت لك أن تتراجع

178
00:15:05,060 --> 00:15:05,980
...لكن

179
00:15:07,330 --> 00:15:14,150
،الجوني روجوجين كوني الّتي تمّ إنشاؤها
.تؤثّر في الجينغماي لأيّ أحد يدخلها

180
00:15:15,020 --> 00:15:19,730
تتوافق الجينغماي الاثنا عشر مع
.مشاعرك الإجابيّة والسّلبيّة

181
00:15:20,810 --> 00:15:23,630
إنّه يتعب خصومه

182
00:15:23,630 --> 00:15:29,010
بالتّغيير بين مشاعرهم الإيجابيّة
.والسّلبيّة باستمرار

183
00:15:29,340 --> 00:15:34,710
،مثلما ينكسر السّلك إن لويته بما يكفي
.تُدَمّر الرّوح في النّهاية

184
00:15:35,710 --> 00:15:38,800
،تصبح غير قادر على الهروب من مشاعرك السّلبيّة

185
00:15:38,800 --> 00:15:42,700
.ويتضرّر العضو المسؤول عن تلك الجينغماي بشدّة

186
00:15:44,150 --> 00:15:50,340
تملك تلك المرأة تو باي القوّة على
.الهجوم على عقل الشّخص وإضعافه

187
00:15:51,220 --> 00:15:54,950
.قوّتاهما تعملان معًا بشكل جيّد

188
00:15:56,050 --> 00:15:58,640
.سأقولها لك لآخر مرّة يا ريغيوكو

189
00:15:59,420 --> 00:16:02,990
.نحن بداخل الجوني روجوجين

190
00:16:03,430 --> 00:16:08,910
وهم يركّزون أغلب قوّتهم عليّ
.ليمنعوني من التّحرّك

191
00:16:09,370 --> 00:16:11,700
.عليك الخروج من هنا

192
00:16:12,190 --> 00:16:13,780
...لكن يا ريكوكين-ساما

193
00:16:17,540 --> 00:16:20,910
.لا تنسيا أمري

194
00:16:28,480 --> 00:16:29,660
...حسنًا إذًا

195
00:16:30,140 --> 00:16:32,330
.دعوني أتولّى أمره

196
00:16:32,330 --> 00:16:35,380
.أنتم اقضوا على ذلك العجوز

197
00:16:36,540 --> 00:16:38,510
.تلك الوقحة

198
00:16:38,510 --> 00:16:41,900
تتصرّف بشكل عشوائيّ دائمًا
.عندما ترى الشّبّان اليافعين

199
00:16:46,170 --> 00:16:48,080
.هذا مطمئن

200
00:16:48,470 --> 00:16:51,790
.كنت أقترب من حدّي

201
00:16:52,530 --> 00:16:55,110
.لقد فزت يا كوني

202
00:16:55,870 --> 00:16:59,690
،إن كنت تريد أن يغوص قلبي في الظّلام

203
00:17:00,170 --> 00:17:02,800
!فسأفعل ذلك لأجلك

204
00:17:03,830 --> 00:17:07,030
.احترسوا جميعًا

205
00:17:08,160 --> 00:17:12,790
.مهلاً، من الأفضل أن نقضي عليه الآن

206
00:17:12,790 --> 00:17:14,660
.لن نجد فرصة أخرى كهذه

207
00:17:15,790 --> 00:17:20,440
.لا تقلق. نلنا منه تمامًا

208
00:17:20,970 --> 00:17:23,960
.القضاء عليه سيحتاج القليل من العمل فحسب

209
00:17:31,160 --> 00:17:33,830
.اتّخذ قرارًا جريئًا

210
00:17:33,860 --> 00:17:36,220
حصر

211
00:17:33,860 --> 00:17:39,780
غيظ

212
00:17:33,860 --> 00:17:39,780
حبّ

213
00:17:34,450 --> 00:17:39,780
استغلّ ما بقي له من تحكّم
.في النّفس لتعديل مشاعره

214
00:17:40,100 --> 00:17:43,920
باشتغال الغياكسي سانجو، أزال الحماية

215
00:17:43,920 --> 00:17:49,760
عن الزّوجوين غانجينشو والشّوشاويين
.شينجينشو لتضخيم غضبه

216
00:17:50,120 --> 00:17:55,870
استعمل الجوني روجوجين خاصّتي
.ليحوّل نفسه إلى سلاح قتل شامل

217
00:18:01,510 --> 00:18:04,590
.لكنّها أخطر طريقة أيضًا

218
00:18:06,100 --> 00:18:11,090
تخلّى عن جميع الأفكار العقلانيّة
والهادئة وغاص في الجنون

219
00:18:12,090 --> 00:18:15,620
.ليقتل الجميع هنا

220
00:18:22,470 --> 00:18:23,910
!ابتعدي يا ناتسكا

221
00:18:23,910 --> 00:18:26,130
!سوف أنقذ ريكوكين-ساما

222
00:18:26,130 --> 00:18:28,400
.توقّف عن ذلك

223
00:18:28,400 --> 00:18:32,160
.ستعترض طريقه فحسب

224
00:18:32,800 --> 00:18:35,090
وأيضًا، ألم تشعر بذلك؟

225
00:18:35,660 --> 00:18:42,230
لمن نية القتل الّتي شعرت بها
في لحظة مغادرتك في رأيك؟

226
00:18:42,620 --> 00:18:44,400
!كفّي عن تضييع وقتك

227
00:18:44,400 --> 00:18:46,990
—إن لم تبتعدي، سوف

228
00:18:47,350 --> 00:18:49,510
ماذا ستفعل؟

229
00:18:52,470 --> 00:18:54,020
هل زاد وزنك قليلاً؟

230
00:18:54,430 --> 00:18:56,970
!توقّفي! لا تلمسيني

231
00:18:56,970 --> 00:18:59,540
!لا أنوي تسوية حسابي معك اليوم

232
00:18:59,540 --> 00:19:00,610
!ابتعدي الآن

233
00:19:00,610 --> 00:19:01,980
.لا

234
00:19:03,440 --> 00:19:08,740
.عليك هزيمتي أوّلاً إن أردت إنقاذ ريكوكين

235
00:19:08,740 --> 00:19:10,570
!توقفي! أفلتيني

236
00:19:10,570 --> 00:19:14,280
!لن أرحمك إن أصررت على اعتراض طريقي

237
00:19:14,280 --> 00:19:15,840
هل ستقاتلني حقًّا؟

238
00:19:18,270 --> 00:19:20,210
...هذا الجسد المشدود

239
00:19:20,460 --> 00:19:21,730
...و

240
00:19:22,470 --> 00:19:24,360
!وهذه المؤخّرة حسنة الشّكل

241
00:19:24,360 --> 00:19:25,940
!تعيد الذّكريات

242
00:19:29,830 --> 00:19:33,200
.هيّا، اهزمني

243
00:19:34,150 --> 00:19:35,490
!أنوي ذلك

244
00:19:40,400 --> 00:19:43,500
!لا تضربني بالفعل أيّها الوغد

245
00:19:43,500 --> 00:19:44,380
!أفلتيني

246
00:19:44,380 --> 00:19:45,430
!لا

247
00:19:45,430 --> 00:19:46,190
!توقّفي

248
00:19:46,190 --> 00:19:47,820
!لا أملك الوقت للعبث معك

249
00:19:47,820 --> 00:19:49,040
!أيّها الوغد عديم الإحساس

250
00:19:57,670 --> 00:20:00,430
.أرجوك يا ناتسكا

251
00:20:00,920 --> 00:20:01,840
.غادري المكان

252
00:20:09,840 --> 00:20:11,890
.ما زال مذاقك كما كان

253
00:20:13,470 --> 00:20:15,920
.يبدو أنّك تريدين الموت حقًّا

254
00:20:22,050 --> 00:20:23,310
،في ذلك اليوم

255
00:20:24,780 --> 00:20:27,200
.تقبّلت نفسي

256
00:20:28,610 --> 00:20:34,570
.وفي نفس الوقت، ظننت أنّك اقترفت خطأ

257
00:20:36,250 --> 00:20:40,500
.كنت سعيدة عندما رأيتك تقاتل تشو سوران

258
00:20:41,330 --> 00:20:47,320
ظننت أنّك صفّيت ذهنك من الشّك
.وتقبّلت نفسك أخيرًا

259
00:20:48,430 --> 00:20:52,210
.لكن يبدو أنّني كنت مخطئة

260
00:20:54,230 --> 00:20:56,270
.يا لغبائي

261
00:20:57,360 --> 00:21:00,430
ما السّيّئ في الوقت الّذي قضيته معي؟

262
00:21:02,000 --> 00:21:05,160
لِمَ أنت عازم على جعل نفسك تعاني؟

263
00:21:08,150 --> 00:21:10,280
.لأنّك تغيّرتِ

264
00:21:10,910 --> 00:21:16,080
...أصبحت من منشقّي زينسي، و... و

265
00:21:16,080 --> 00:21:17,820
أصبحت صارخة؟

266
00:21:18,310 --> 00:21:20,450
أم ساقطة؟

267
00:21:24,310 --> 00:21:27,540
.أنت حقًّا راهب نبيل من التّينشيفو

268
00:21:28,630 --> 00:21:31,760
.لا يمكنك حتّى أن تقولها بصوت مرتفع

269
00:21:38,400 --> 00:21:39,870
...أنا

270
00:23:22,420 --> 00:23:23,670
الحلقة القادمة

271
00:23:23,050 --> 00:23:25,620
.وحدكما معًا في غابة خالية

272
00:23:25,620 --> 00:23:27,490
أيمكن أن تكون هذه حبيبتك المزعومة؟

273
00:23:27,490 --> 00:23:28,800
!لا يا معلّمي

274
00:23:28,800 --> 00:23:30,180
!إنّها غريبة

275
00:23:30,180 --> 00:23:32,560
ما الّذي كنت تفعله مع غريبة إذًا؟

276
00:23:32,560 --> 00:23:35,400
!أجرّب تقنية كونغ فو جديدة

277
00:23:35,400 --> 00:23:37,990
:"في الحلقة القادمة من "هيتوري نو شيتا
."نيّة للقتل"

278
00:23:37,990 --> 00:23:39,130
.لا تفوّتوها