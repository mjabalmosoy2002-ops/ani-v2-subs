1
00:01:49,120 --> 00:01:53,170
هذا هو الجبل الأسطوريّ المنعزل

2
00:01:53,170 --> 00:01:55,740
،حيث تدرّب العديد النّاسكين

3
00:01:55,740 --> 00:01:57,510
...معروف حتّى بين الدّخلاء

4
00:01:58,320 --> 00:02:00,130
ريوكوزان؟

5
00:02:05,840 --> 00:02:08,690
.إنّه مختلف عمّا تخيّلت

6
00:02:08,690 --> 00:02:11,090
.إنّه مكان مليء بالحيويّة

7
00:02:11,090 --> 00:02:12,890
.يبدو أنّ المدخل هناك

8
00:02:16,220 --> 00:02:17,860
هناك رسم للدّخول؟

9
00:02:17,860 --> 00:02:20,300
كما أنّها 260 يوان للشّخص الواحد؟

10
00:02:20,300 --> 00:02:21,660
.هذه سرقة

11
00:02:23,490 --> 00:02:25,510
.لا تغضب كثيرًا

12
00:02:25,510 --> 00:02:29,860
.ريوكوزان منطقة سياحيّة مهمّة الآن تديرها الحكومة

13
00:02:29,860 --> 00:02:33,650
ما كان التّينشيفو ليتمكّنوا من إدارة
.رقعة أرضٍ شاسعة كهذه

14
00:02:37,830 --> 00:02:40,660
.مئتان وستّون يوان ليست شيئًا

15
00:02:41,170 --> 00:02:44,300
.رسم الدّخول إلى بوتوسان خاصّتنا أسوأ بكثير

16
00:02:46,030 --> 00:02:49,550
.المعذرة. أنا أويا من طائفة بوتو

17
00:02:49,550 --> 00:02:50,430
وأنت؟

18
00:02:50,690 --> 00:02:53,060
.أنا تشو سوران. سررت بلقائك

19
00:02:53,910 --> 00:02:55,420
تشو سوران؟

20
00:02:58,180 --> 00:03:01,390
!عجبًا! تملكين كفّ حاكم

21
00:03:02,030 --> 00:03:04,120
.هذا خبر رائع أيّتها الشّابّة

22
00:03:04,120 --> 00:03:06,620
.سوف تعيشين سنين طويلة

23
00:03:06,620 --> 00:03:09,530
.أنا أشعر أنّني حيّة منذ وقت طويل جدًّا

24
00:03:10,830 --> 00:03:15,100
.على أيّة أحال، أنت تستحقّين امتلاك هذا

25
00:03:15,760 --> 00:03:19,000
!كنز السّماء المخفيّ، مسبحة أكاروريغيوكو

26
00:03:19,010 --> 00:03:23,640
حصل معلّمي على هذه الأداة القيّمة
بعد مقاتلة كيرين ينفث النّار

27
00:03:23,640 --> 00:03:25,430
!عشرة آلاف مرّة

28
00:03:26,590 --> 00:03:29,940
أتمنّى لو أستطيع طلب 98000 يوان
.لكنّي سأبيعها مقابل 9800 فقط

29
00:03:29,940 --> 00:03:32,220
لا، أنا مستعدّ لكي أدعك تأخذينها
—بالثّمن الزّهيد 1980

30
00:03:30,890 --> 00:03:32,970
!أريدها، أعطني إيّاها

31
00:03:32,220 --> 00:03:33,480
!مهلاً لحظة

32
00:03:33,480 --> 00:03:36,340
!هوهو، لا تدعي هذه التّرّهات تنطلي عليك

33
00:03:36,340 --> 00:03:38,660
!لكنّها أتت من كيرين ينفث النّار

34
00:03:38,660 --> 00:03:39,900
!كيرين

35
00:03:38,840 --> 00:03:40,480
!إنّها غير موجودة

36
00:03:41,050 --> 00:03:42,150
!لكنّي أريدها

37
00:03:42,150 --> 00:03:45,570
!إنها مقابل 1980 فقط! 1980 يوان

38
00:03:42,760 --> 00:03:47,580
تشو سوران، لِمَ قرّرت المشاركة في الرّاتن تايشو؟

39
00:03:45,570 --> 00:03:47,750
!لا يمكنك شراؤها رغم ذلك

40
00:03:48,660 --> 00:03:50,760
هل يعني هذا أنّك ستشارك أيضًا؟

41
00:03:51,930 --> 00:03:54,620
.لا بدّ أنّك تعرف من أكون إذًا

42
00:03:55,510 --> 00:03:58,910
.يعرف التّينشيفو شيئًا عن جدّي

43
00:03:59,530 --> 00:04:03,270
.يمكنني مقابلة التّينشي إن فزت بهذه البطولة

44
00:04:03,710 --> 00:04:07,240
.وسأتمكّن حينها من سؤاله أيّ شيء عن جدّي

45
00:04:08,300 --> 00:04:10,300
تلتقي بالتّينشي؟

46
00:04:10,300 --> 00:04:11,750
.هذا سهل

47
00:04:11,750 --> 00:04:12,560
حقًّا؟

48
00:04:12,560 --> 00:04:13,800
.اتبعني

49
00:04:16,220 --> 00:04:17,420
.سأعود في الحال

50
00:04:16,760 --> 00:04:19,890
!سأعطيك هذه القبّعة الرّائعة وهذا السّيف معها أيضًا

51
00:04:18,000 --> 00:04:19,300
!مذهل

52
00:04:18,350 --> 00:04:20,530
!هوهو، هذا يكفي

53
00:04:20,900 --> 00:04:23,860
.انظر، التّينشي هناك

54
00:04:26,200 --> 00:04:28,530
.ابتسم رجاءً أيّها التّينشي

55
00:04:28,530 --> 00:04:30,130
.مرحى

56
00:04:30,580 --> 00:04:31,680
...إنّه

57
00:04:32,550 --> 00:04:34,650
.تأتي الكثير من الأعمال الشّاقّة مع لقب التّينشي

58
00:04:34,650 --> 00:04:37,760
.لا بدّ أنّ شخصًا مهمًّا في زيارة للمكان مجدّدًا

59
00:04:36,120 --> 00:04:37,990
.هذا كلّ شيء بالنّسبة لمقابلة اليوم

60
00:04:38,290 --> 00:04:40,500
.شكرًا لك أيّها التّينشي

61
00:04:42,060 --> 00:04:43,580
.أراك لاحقًا

62
00:04:43,580 --> 00:04:44,680
!أيّها التّينشي

63
00:04:46,240 --> 00:04:48,610
.أنا أويا من طائفة بوتو

64
00:04:48,610 --> 00:04:50,260
.أحضرت صديقًا معي اليوم

65
00:04:50,540 --> 00:04:55,020
.أويا، أنا سعيد لرؤيتك بخير

66
00:04:57,360 --> 00:05:00,050
هل أنت تشو سوران؟

67
00:05:00,960 --> 00:05:02,180
...عفوًا

68
00:05:01,400 --> 00:05:05,330
."يمكنك مناداتي بـ"معلّم

69
00:05:05,710 --> 00:05:08,690
.كنت أنا وجدّك تلميذين زميلين

70
00:05:08,690 --> 00:05:12,950
.أنت كحفيد بالنّسبة لي

71
00:05:14,610 --> 00:05:16,390
!مـ-معلّم

72
00:05:21,560 --> 00:05:25,340
.ريغيوكو، أريد التّحدّث إلى سوران

73
00:05:25,340 --> 00:05:28,120
هل يمكنك التّكفّل بالضّيوف؟

74
00:05:28,460 --> 00:05:29,890
.بالتّأكيد

75
00:05:32,880 --> 00:05:35,230
هل نذهب إلى مكان آخر؟

76
00:05:33,930 --> 00:05:35,770
!إنّه تشو ريغيوكو-ساما

77
00:05:35,770 --> 00:05:37,880
!إنّه رائع جدًّا

78
00:05:53,700 --> 00:05:55,480
...المعذرة

79
00:06:00,700 --> 00:06:03,090
أ-أيّها معلم؟

80
00:06:03,090 --> 00:06:07,170
.أعرف ما تريد سؤاله يا سوران

81
00:06:07,530 --> 00:06:11,920
.اسم جدّك الحقيقيّ هو تشو كايغي

82
00:06:12,650 --> 00:06:14,770
تـ-تشو كايغي؟

83
00:06:14,770 --> 00:06:20,390
.تشو شاكورين اسم مزيّف استعمله لتجنّب الأذى

84
00:06:20,660 --> 00:06:23,350
.لن تعرف شيئًا بالبحث عن ذلك الاسم

85
00:06:24,460 --> 00:06:29,350
.لكنّ هذا كلّ ما يمكني قوله لك في الوقت الرّاهن

86
00:06:29,870 --> 00:06:34,590
.سأخبرك بالباقي بمجرّد أن تكسب الحقّ لتخلُفني

87
00:06:34,590 --> 00:06:39,810
لماذا؟ لن يتوجّب عليّ القتال
!في الرّاتن تايشو إن أخبرتني الآن

88
00:06:39,810 --> 00:06:42,290
.أريد معرفة الحقيقة لا غير

89
00:06:42,290 --> 00:06:44,830
—لا أريد في الواقع أن أقاتل أيّ

90
00:06:44,830 --> 00:06:45,870
.سوران

91
00:06:46,470 --> 00:06:51,480
.أفهم ما تقوله، لكنّني لا أستطيع الآن

92
00:06:51,480 --> 00:06:59,880
ما حدث لتشو كايغي ونظام خلافة
.التّينشي لهما علاقة كبيرة ببعضهما

93
00:07:04,460 --> 00:07:07,060
إلى متى سيتحدّثان؟

94
00:07:07,060 --> 00:07:09,570
.لا يمكنك التّدخين هنا

95
00:07:13,360 --> 00:07:17,480
ما علاقته بنظام خلافة التّينشي؟

96
00:07:17,480 --> 00:07:18,440
.يا سوران

97
00:07:19,220 --> 00:07:21,510
.ما الّذي تفعله؟ هيّا بنا

98
00:07:21,930 --> 00:07:23,750
.أجل، صحيح

99
00:07:24,700 --> 00:07:26,600
أين أويا-سان بالمناسبة؟

100
00:07:27,000 --> 00:07:29,030
.اتّجه نحو منطقة البطولة

101
00:07:29,030 --> 00:07:30,560
.من الأفضل أن نسرع نحن أيضًا

102
00:07:30,560 --> 00:07:31,510
.حسنًا

103
00:07:34,030 --> 00:07:37,300
!لا يوجد أيّ طريق حتّى

104
00:07:37,300 --> 00:07:38,630
.تحمّل الأمر

105
00:07:38,630 --> 00:07:42,410
.لا يأتي السّيّاح إلى هنا، لذا الطّريق مصونة

106
00:07:45,810 --> 00:07:48,100
...لا يوجد جسر

107
00:07:48,350 --> 00:07:50,090
.كنت في انتظاركم

108
00:07:50,090 --> 00:07:52,490
.ستُعقد البطولة في الجهة الأخرى من هذا الوادي

109
00:07:52,490 --> 00:07:54,480
.لا تقلقوا

110
00:07:54,480 --> 00:07:58,740
.لقد ربطنا خيوطًا لمن لا يملكون طرقًا أخرى للعبور

111
00:07:58,740 --> 00:08:00,290
هل أنت جادّ؟

112
00:08:00,600 --> 00:08:04,130
.التّينشيفو يحبّون ألعابهم الغبيّة حقًّا

113
00:08:04,130 --> 00:08:07,860
عزيزي، إنّه ساخن. احرص على
.أن تنفخ عليه قبل أن تأكله

114
00:08:06,590 --> 00:08:10,130
.يا إلهي، أنت جائع دائمًا

115
00:08:10,450 --> 00:08:13,950
.عجبًا، أنتما تو يوفوكو وتو يوساي

116
00:08:13,950 --> 00:08:16,420
.رؤيتكما أيّها الأخوان هنا مفاجأة

117
00:08:17,310 --> 00:08:19,870
.أنا لست تو يوفوكو. أنا سميث

118
00:08:19,870 --> 00:08:21,600
من سميث هذا؟

119
00:08:21,600 --> 00:08:24,330
تظنّ أنّك مهمّ فقط لأنّك درست
.في الخارج لبعض الوقت

120
00:08:24,330 --> 00:08:26,830
هل نسيت اسمك؟

121
00:08:28,660 --> 00:08:31,650
.سأذهب إلى المنزل إذًا

122
00:08:31,650 --> 00:08:33,850
.لم أريد المجيء على أيّة حال

123
00:08:33,850 --> 00:08:36,330
.حسنًا، حسنًا يا يوفوكو

124
00:08:37,190 --> 00:08:38,900
.هيّا، لنذهب

125
00:08:38,900 --> 00:08:42,690
.ينتظرنا والدانا لنُشهر اسمينا

126
00:08:42,690 --> 00:08:44,560
.أحبّك يا عزيزي

127
00:08:44,560 --> 00:08:46,000
!تمسّكي جيّدًا

128
00:08:54,760 --> 00:08:56,300
!جو سان، جو يون

129
00:08:56,300 --> 00:08:58,230
!سننتظركم

130
00:09:06,970 --> 00:09:08,140
ماذا؟

131
00:09:07,240 --> 00:09:10,910
!والدك قادم

132
00:09:15,580 --> 00:09:16,600
.لا يصدّق

133
00:09:17,110 --> 00:09:20,740
كم مرّة عليّ أن أقول له ألاّ يرمي ابنتنا؟

134
00:09:22,080 --> 00:09:24,880
هل يُفتَرض بي قتال هذه الوحوش؟

135
00:09:31,380 --> 00:09:34,560
.هيا

136
00:09:38,010 --> 00:09:40,640
.لا أكترث إن كان هذا يبدو سخيفًا

137
00:09:41,550 --> 00:09:45,650
.عليّ عبور هذا الوادي أوّلاً

138
00:09:47,430 --> 00:09:48,470
!ابتعدي عن الطّريق

139
00:09:49,570 --> 00:09:50,990
!احترسي

140
00:09:50,990 --> 00:09:52,540
!احترسي يا هو-ني

141
00:09:55,680 --> 00:09:57,320
.أنا أطير

142
00:09:58,910 --> 00:10:01,980
.أنا جا سيريو من سينسيشو

143
00:10:02,580 --> 00:10:03,980
...هذه الأزياء

144
00:10:04,410 --> 00:10:06,740
.أنتم مع شركة التّوصيل السّريع

145
00:10:07,500 --> 00:10:08,790
.يا للمصادفة

146
00:10:09,190 --> 00:10:12,250
.سمعت أنّكم اعتنيتم بأخي

147
00:10:12,670 --> 00:10:17,300
يفتَرض أن يكون شخصًا قذر المظهر
.بشعر طويل أشعث

148
00:10:17,300 --> 00:10:20,960
.شخص يشبه هذه المرأة تمامًا

149
00:10:21,320 --> 00:10:22,250
هل تعرفه؟

150
00:10:22,250 --> 00:10:25,660
ما الّذي تنوي فعله لهو-ني؟

151
00:10:31,240 --> 00:10:32,010
.لقد وصلت

152
00:10:32,960 --> 00:10:37,720
قد يكون أخي حثالة، لكنّنا أخوان
.نتشارك نفس القرابة الدّمويّة

153
00:10:38,090 --> 00:10:40,660
.استعدّي يا فو هوهو

154
00:10:46,940 --> 00:10:48,370
.يا إلهي

155
00:10:48,370 --> 00:10:51,550
.لقد ورّطت نفسك في مشكلة يا هوهو-تشان

156
00:11:00,980 --> 00:11:03,010
...هذا الحشد

157
00:11:03,010 --> 00:11:05,070
.المكان مثل مدينة ملاهي

158
00:11:05,070 --> 00:11:07,720
!لم أركم منذ مدّة يا شركة التّوصيل السّريع

159
00:11:07,720 --> 00:11:09,680
!أنا فو شينتون من تينغيكاي

160
00:11:09,680 --> 00:11:12,700
.الضّعيف الّذي كان مذعورًا من هوهو

161
00:11:13,360 --> 00:11:14,890
.لا تنعت نفسك بذلك

162
00:11:15,430 --> 00:11:17,310
ساين-سان، هل ستشاركان أنتما أيضًا؟

163
00:11:18,090 --> 00:11:21,580
.بالطّبع. سأشارك أنا وشينتون

164
00:11:24,450 --> 00:11:26,560
ألن تأتي ساين-سان معك؟

165
00:11:26,560 --> 00:11:28,830
.ستلتقي بصديق

166
00:11:30,020 --> 00:11:34,320
.نسيت أن أقول أنّنا هنا من أجل والدنا فحسب

167
00:11:34,320 --> 00:11:38,830
لسنا مهتمّان بالتّينشي أو بالتسوتينروكو
.بشكلٍ خاصّ، لذا لا تقلق

168
00:11:38,830 --> 00:11:41,540
.أنت النّجم هذه المرّة يا تشو سوران

169
00:11:42,010 --> 00:11:44,260
.جميع الدّخلاء يتحدّثون عنك

170
00:11:44,610 --> 00:11:49,010
،مع أنّك لم تتدرّب في ريوكوسان
.إلاّ أنّك أتقنت كينكوجو ورايهو

171
00:11:49,430 --> 00:11:52,120
.كما أنّك وريث أسلوب كيتايغين أيضًا

172
00:11:52,410 --> 00:11:54,340
.الجميع مهتمّون بك

173
00:11:57,030 --> 00:11:59,910
.هؤلاء الّذين مررنا من أمامهم للتّوّ تلاميذ بوزان

174
00:11:59,910 --> 00:12:01,150
...وأيضًا

175
00:12:01,150 --> 00:12:03,810
.ذلك الرّجل المبتسم هو شوشو

176
00:12:03,810 --> 00:12:05,830
.لديه قلب أسود رغم مظهره

177
00:12:06,330 --> 00:12:08,050
.تلك الفتاة هاكو شيشي

178
00:12:08,050 --> 00:12:13,450
.إنّها محبّة للمال، لذا ادفع لها عندما تقاتلها

179
00:12:13,960 --> 00:12:15,640
.تلك تسو كينكا

180
00:12:15,640 --> 00:12:19,290
.ليست مقاتلة تمامًا لكنّها قويّة

181
00:12:19,560 --> 00:12:22,690
.ستواجهها في نهاية المطاف

182
00:12:22,690 --> 00:12:25,310
.من اللّطيف أن تخبرني بكلّ هذا

183
00:12:26,040 --> 00:12:29,860
.قال لي أبي أن أساعدك

184
00:12:30,410 --> 00:12:33,940
.يبدو أنّه يحبّك فعلاً

185
00:12:34,340 --> 00:12:38,310
.كما أنّه لم يتخلّ عن فكرة زواجك من أختي

186
00:12:38,970 --> 00:12:43,520
.على أيّة حال، أكبر خصومك هما ذلكما الاثنين

187
00:12:44,740 --> 00:12:49,310
.سمعت الكثير عنك يا ريغيوكو شينجين

188
00:12:49,310 --> 00:12:50,960
.شرف لي أن ألتقيك

189
00:12:51,400 --> 00:12:53,790
.على الإطلاق يا شوكاتسو-سينسي

190
00:12:53,790 --> 00:12:56,160
.أنا كاهن ريفيّ بسيط

191
00:12:56,160 --> 00:12:58,660
.لا أستحقّ احترامك

192
00:12:58,660 --> 00:13:00,230
.يا لتواضعك

193
00:13:00,230 --> 00:13:03,720
.آمل أن نحظى بفرصة قتال بعضنا بعضًا

194
00:13:03,720 --> 00:13:05,050
.وأنا كذلك

195
00:13:05,050 --> 00:13:10,470
أتطلّع لرؤية فنون عائلة شوكاتسو السّرّيّة
.الّتي تمّ توارثها منذ مركيز وو من وي

196
00:13:12,070 --> 00:13:13,690
!ريغيوكو-ساما

197
00:13:16,230 --> 00:13:20,110
،شوكاتسو-سينسي، أقدّر لك اهتمامك

198
00:13:20,110 --> 00:13:24,530
لكن هناك مقاتلون أقوياء مثل التّنين
.والنّمر مختبئون في ريوكوسان الآن

199
00:13:25,120 --> 00:13:30,520
.سرعان ما ستلتقي شخصًا أعظم بكثير منّي

200
00:13:31,540 --> 00:13:33,500
.أتطلّع لذلك

201
00:13:33,900 --> 00:13:36,090
.مضى وقت طويل يا ريغيوكو-ساما

202
00:13:36,530 --> 00:13:38,110
فو شينتون، صحيح؟

203
00:13:38,110 --> 00:13:39,750
.مسرور لأنّك تبدو بخير

204
00:13:41,200 --> 00:13:43,000
.التقينا من جديد يا ريغيوكو-ساما

205
00:13:44,950 --> 00:13:48,040
.شوكاتسو-سينسي، دعني أريك المعبد

206
00:13:48,040 --> 00:13:50,080
.أقدّر لك ذلك

207
00:13:50,500 --> 00:13:51,630
!مهلاً

208
00:13:51,630 --> 00:13:54,990
!لماذا تتجاهلني يا ريغيوكو

209
00:13:52,670 --> 00:13:54,820
!مهلاً! اهدأ

210
00:13:55,440 --> 00:13:58,230
ما الّذي فعلته له؟

211
00:13:58,940 --> 00:14:01,340
.على أيّة حال، أنت مذهل

212
00:14:01,340 --> 00:14:03,560
.تعرف الكثير عن الدّخلاء

213
00:14:05,030 --> 00:14:09,740
أنا سيّئ في الكونغ فو، لكن واثق
.من قدرتي على جمع المعلومات

214
00:14:10,310 --> 00:14:13,430
.معلوماتك لا قيمة لها

215
00:14:16,450 --> 00:14:21,960
لا فائدة من جمع معلومات يعرفها
.الجميع يا ذا الرّأس الأبيض

216
00:14:22,270 --> 00:14:24,550
أنت هنا أيضًا؟

217
00:14:24,550 --> 00:14:25,560
أتعرفه؟

218
00:14:25,560 --> 00:14:26,640
.نوعًا ما

219
00:14:26,630 --> 00:14:29,130
،زوريو. إن كان هذا شعورك

220
00:14:29,130 --> 00:14:32,550
فلا بدّ أنّك تملك معلومات عن الفتى
الّذي يقف إلى جانبي، صحيح؟

221
00:14:33,020 --> 00:14:37,400
قلت لك من قبل أنّني أجمع المعلومات
.عن اللاّعبين المهمّين فقط

222
00:14:37,400 --> 00:14:40,050
.لست مهتمًّا بالأوباش

223
00:14:40,460 --> 00:14:41,920
.ينبغي إذًا أن يفاجئك هذا

224
00:14:41,920 --> 00:14:43,740
!إنّه تشو سوران

225
00:14:44,070 --> 00:14:45,200
تشو سوران؟

226
00:14:45,200 --> 00:14:46,040
!مستحيل

227
00:14:46,040 --> 00:14:48,650
ذاك هو وريث أسلوب كيتايغين؟

228
00:14:48,650 --> 00:14:49,730
تشو سوران؟

229
00:14:49,000 --> 00:14:50,830
.ما كان ينبغي عليك قول ذلك

230
00:14:51,430 --> 00:14:53,650
أنت هو تشو سوران العظيم إذًا؟

231
00:14:53,650 --> 00:14:56,570
.لم أظنّك ستكون عاديّ المظهر

232
00:14:56,570 --> 00:14:59,400
...هذا زيّ التّوصيل السّريع

233
00:15:00,890 --> 00:15:03,740
ما يعني أنّها صديقتك؟

234
00:15:03,740 --> 00:15:05,710
هل ستشاركان معًا؟

235
00:15:06,450 --> 00:15:09,600
.لم آتي لكي أصبح التّينشي

236
00:15:09,890 --> 00:15:12,250
.هو من سيصبح التّينشي الموالي

237
00:15:12,560 --> 00:15:16,930
.عملي هو أن أدفن أيّ شخصٍ يقف في وجهه

238
00:15:16,930 --> 00:15:19,050
!ماذا؟

239
00:15:20,240 --> 00:15:23,210
!هو-ني، أرجوك، لا... لا تقولي شيئًا

240
00:15:23,210 --> 00:15:25,470
هل تريدني أن أقتلهم دون أن أقول شيئًا؟

241
00:15:25,470 --> 00:15:26,900
!لا تقتلي أحدًا

242
00:15:28,980 --> 00:15:32,620
.الشّباب مفعمون بالحيويّة

243
00:15:33,110 --> 00:15:36,460
.يجعلني هذا أشعر أنّني شابّ من جديد

244
00:15:36,790 --> 00:15:39,410
.شكرًا لكم على الانتظار

245
00:15:39,410 --> 00:15:42,980
.لن أضيّع وقتكم بالحديث

246
00:15:42,980 --> 00:15:45,580
.أعلم ما تأملونه وتتوقّعونه

247
00:15:46,420 --> 00:15:52,660
.ستبدأ بطولة الاختيار الآن

248
00:15:54,640 --> 00:15:56,970
فليتناوب المتشاركون في سحب القرعة

249
00:15:57,260 --> 00:16:00,600
.لتحديد خصومكم وترتيب المنافسة

250
00:16:04,700 --> 00:16:07,950
.ذاك هو تشو سوران إذًا

251
00:16:07,950 --> 00:16:11,430
.لا يشبه كايغي كثيرًا

252
00:16:12,120 --> 00:16:13,410
.يا إلهي

253
00:16:13,810 --> 00:16:20,980
،لو أنّني وجدت كايغي حينها
...لما حدث لي هذا

254
00:16:20,980 --> 00:16:23,500
.لا تقل ذلك يا شينتشو

255
00:16:23,860 --> 00:16:26,610
.كان ذلك خطئي

256
00:16:26,610 --> 00:16:32,300
.لم يكن عليّ إرسالك للبحث عن كايغي بمفردك

257
00:16:32,700 --> 00:16:37,430
...ما كنت حينها لتفقد كلّ الكونغ فو خاصّتك

258
00:16:43,650 --> 00:16:45,600
النّمر الأبيض الثّاني؟

259
00:16:46,120 --> 00:16:49,460
.رمز البرج الّذي على ورقتكم يحدّد ترتيب قتالكم

260
00:16:49,800 --> 00:16:53,340
.الحيوان يحدّد خصمكم

261
00:16:53,730 --> 00:16:58,450
سيقاتل من يحملون نفس الحيوان
.على أوراقهم بعضهم

262
00:16:59,320 --> 00:17:02,440
ستتنافسون في مرحلة إقصائيّة
.في مجموعات من أربع متشاركين

263
00:17:02,840 --> 00:17:07,230
المنتصر الوحيد هو من سيتقدّم
.إلى المرحلة الموالية

264
00:17:09,660 --> 00:17:11,400
.حصلت على النّمر الأبيض الثّاني

265
00:17:11,400 --> 00:17:13,040
.حصلت على السّلحفاة السّوداء الثّالثة

266
00:17:13,630 --> 00:17:15,590
.أنا مسرور لأنّنا لم نحصل على نفس الحيوان

267
00:17:15,590 --> 00:17:16,440
.أجل

268
00:17:16,810 --> 00:17:19,630
...لكنّ هو-ني ستبدأ أوّلاً

269
00:17:19,880 --> 00:17:21,470
!فليدخل المقاتلون

270
00:17:24,390 --> 00:17:27,150
.هذا سيّئ

271
00:17:27,150 --> 00:17:29,080
هل خصمها قويّ إلى تلك الدّرجة؟

272
00:17:29,080 --> 00:17:30,980
.أولئك الثّلاثة فريق

273
00:17:31,290 --> 00:17:34,520
.يدعونهم إخوان توين من تينشين

274
00:17:34,770 --> 00:17:37,200
.القتال ثلاثة ضدّ واحد إذًا

275
00:17:37,200 --> 00:17:41,110
.لمعلوماتكم فقط، نحن لا نغشّ

276
00:17:41,110 --> 00:17:45,290
انتهى بنا المطاف في نفس المجموعة
.بالصّدفة فحسب

277
00:17:45,290 --> 00:17:49,080
.أجل. هذا ما نسمّيه بالقدر

278
00:17:49,080 --> 00:17:52,150
.تبًّا، هذا يضع هو-ني في وضع سيّئ جدًّا

279
00:17:52,150 --> 00:17:53,950
!فليدخل المقاتلون

280
00:17:56,880 --> 00:17:59,170
!ستبدأ المباراة الآن

281
00:17:59,770 --> 00:18:04,030
مهلاً، مهلاً! أهذه الفتاة الصّغيرة هي خصمنا؟

282
00:18:04,030 --> 00:18:05,660
.لا تخافي

283
00:18:05,660 --> 00:18:08,860
سنكون لطفاء، اتّفقنا أيّتها الصّغيرة؟

284
00:18:10,970 --> 00:18:13,290
!هـ-هوهو-نيسان؟

285
00:18:13,290 --> 00:18:16,630
مـ-ما الّذي تفعلينه هنا يا هوهو-نيسان؟

286
00:18:16,630 --> 00:18:18,450
.أتيت لدفنكم

287
00:18:19,020 --> 00:18:21,400
من أنتم بالمناسبة؟

288
00:18:22,580 --> 00:18:24,390
.أنا ريوهو

289
00:18:24,390 --> 00:18:25,760
.أنا كان ريجي

290
00:18:25,760 --> 00:18:27,080
.أنا تشوساي

291
00:18:27,330 --> 00:18:31,480
،ألا تذكرين؟ عندما تمادينا في مقالبنا

292
00:18:31,480 --> 00:18:33,800
.عاقبتنا بسوط الحبّ خاصّتك

293
00:18:36,760 --> 00:18:38,110
.تذكّرت الآن

294
00:18:38,750 --> 00:18:40,800
.ما زلتم أحياءً

295
00:18:40,800 --> 00:18:43,710
.صلابتنا هي نقطة قوّتنا

296
00:18:43,710 --> 00:18:46,990
...لكنّني لا أصدقّ أنّنا التقينا بك هنا

297
00:18:46,160 --> 00:18:47,510
!أنتم

298
00:18:48,010 --> 00:18:50,350
هل ستقاتلون أم لا؟

299
00:18:50,350 --> 00:18:52,030
!بالطّبع لا

300
00:18:52,030 --> 00:18:54,460
!إنّها أختنا

301
00:18:54,460 --> 00:18:56,310
ماذا ستفعلون إذًا؟

302
00:18:59,190 --> 00:19:01,190
!نعترف بالهزيمة

303
00:19:01,190 --> 00:19:02,700
!خسرنا

304
00:19:02,700 --> 00:19:05,300
!حقّقت هوهو-نيسان فوزًا كاسحًا

305
00:19:07,580 --> 00:19:10,600
كيف حال جو يون؟

306
00:19:09,910 --> 00:19:11,410
.اذهبوا وانظروا بأنفسكم

307
00:19:11,890 --> 00:19:15,120
.هوهو-نيسان، أنت جافّة كالعادة

308
00:19:16,520 --> 00:19:19,030
.ما كان عليّ أن أقلق

309
00:19:32,780 --> 00:19:35,460
.ريغيوكو شينجين مذهل كالعادة

310
00:19:35,820 --> 00:19:37,380
.لا فرصة لدينا أمامه

311
00:19:37,380 --> 00:19:39,020
.أ-أستسلم

312
00:19:40,280 --> 00:19:41,520
.جيّد

313
00:19:41,520 --> 00:19:43,370
!الفائز هو تشو ريغيوكو

314
00:19:43,580 --> 00:19:46,830
.لم يقدّموا أيّ فعاليّة، مع أنّهم شكّلوا فريقًا ضدّه

315
00:19:46,830 --> 00:19:49,390
.إنّه قويّ كالعادة

316
00:19:49,760 --> 00:19:51,830
.ومحبوب أيضًا

317
00:19:53,030 --> 00:19:58,370
.سيشكّل الآخرون فرقًا ضدّ أيّ مرشح للفوز

318
00:19:58,630 --> 00:20:01,130
.قد أكون في ورطة

319
00:20:01,130 --> 00:20:03,190
هل من شيء يمكنني فعله؟

320
00:20:11,250 --> 00:20:13,760
كيف سارت مباراتك يا أختي؟

321
00:20:14,700 --> 00:20:16,130
.مثيرة للشّفقة

322
00:20:16,130 --> 00:20:18,350
.كانوا ضعفاء جدًّا، لم يكن ذلك إحماءً حتّى

323
00:20:18,910 --> 00:20:22,230
.فهمت. عبرت هوهو الجولة الأولى أيضًا

324
00:20:22,500 --> 00:20:24,620
.أنا واثقة أنّها عانت

325
00:20:24,620 --> 00:20:27,960
.فالرّاتن تايشو ليست بتلك السّهولة

326
00:20:28,410 --> 00:20:29,590
عانت؟

327
00:20:29,590 --> 00:20:32,550
.ألقى خصومها نظرة واحدة عليها واستسلموا

328
00:20:33,520 --> 00:20:36,800
.ستبدأ مباراة النّمر الثّاني قريبًا

329
00:20:37,780 --> 00:20:39,530
.إنّها مباراة تشو سوران

330
00:20:39,530 --> 00:20:41,660
.لنذهب لمشاهدتها

331
00:20:52,780 --> 00:20:56,760
.تشو سوران ذاك خاف وهرب

332
00:20:56,760 --> 00:20:58,100
.لا يمكن

333
00:20:58,100 --> 00:21:00,490
.إنّه وريث أسلوب كيتايغين

334
00:21:01,110 --> 00:21:03,950
.تذكّرا، اتّبعا الخطّة

335
00:21:04,380 --> 00:21:05,630
.نحن نعلم

336
00:21:05,630 --> 00:21:08,430
.سنهزم تشو سوار معًا

337
00:21:08,430 --> 00:21:10,760
.بعدها سنسوّي الأمر مع بعضنا

338
00:21:11,300 --> 00:21:12,300
.إنّه هنا

339
00:21:17,210 --> 00:21:20,420
،ثلاثون سنة شرق النّهر

340
00:21:21,170 --> 00:21:24,170
.ثلاثون سنة غرب النّهر

341
00:21:25,000 --> 00:21:27,540
.للحياة حلوها ومرّها

342
00:21:29,210 --> 00:21:33,090
.حان الآن وقت الانتقام لجدّي

343
00:21:34,520 --> 00:21:40,270
:أنا وريث فنون أسلوب كيتايغين السّرّيّة

344
00:21:41,280 --> 00:21:42,530
!تشو سوران

345
00:23:19,960 --> 00:23:21,210
الحلقة القادمة

346
00:23:20,400 --> 00:23:22,580
...عفوًا، في الحلقة القادمة

347
00:23:22,580 --> 00:23:23,530
ماذا؟ هو-ني؟

348
00:23:23,530 --> 00:23:24,870
ما الّذي تفعلينه هنا؟

349
00:23:24,870 --> 00:23:26,380
.أقدّم عرض الحلقة القادمة المسبق

350
00:23:26,380 --> 00:23:28,430
أنت؟ هل يمكنك حقًّا التّكفّل بذلك؟

351
00:23:28,430 --> 00:23:31,420
.أنا أجيد الكلام أكثر ممّا يبدو عليّ

352
00:23:31,420 --> 00:23:33,550
..."في الحلقة القادمة من "هيتوري نو شيتا

353
00:23:33,890 --> 00:23:34,740
.انس الأمر

354
00:23:34,740 --> 00:23:36,060
!لا تستسلمي

355
00:23:36,060 --> 00:23:38,550
."في الحلقة القادمة من "هيتوري نو شيتا": "وقح

356
00:23:38,550 --> 00:23:39,620
!لا تفوّتوها