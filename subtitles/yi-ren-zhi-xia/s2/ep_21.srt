1
00:00:06,460 --> 00:00:08,080
ريكوكين-ساما؟

2
00:00:08,080 --> 00:00:09,940
.دعني أتولّى الأمر

3
00:00:10,390 --> 00:00:16,180
سأقتل أولئك المنشقّين اليوم
،حتّى وإن كلّفني ذلك حياتي

4
00:00:17,910 --> 00:00:22,910
.أتمنّى لو استطعت القضاء على آخر السّحرة هنا

5
00:00:22,910 --> 00:00:25,530
هل تتحدّث عنّي؟

6
00:00:27,250 --> 00:00:28,610
ناتسكا؟

7
00:00:37,440 --> 00:00:38,590
...حسنًا إذًا

8
00:00:38,930 --> 00:00:40,930
.أنتم اقضوا على ذلك العجوز

9
00:00:43,060 --> 00:00:45,030
.هذا مطمئن

10
00:00:45,530 --> 00:00:48,650
.كنت أقترب من حدّي

11
00:00:49,470 --> 00:00:52,140
.لقد فزت يا كوني

12
00:00:52,700 --> 00:00:56,370
،إن كنت تريد أن يغوص قلبي في الظّلام

13
00:00:56,630 --> 00:00:59,220
!فسأفعل ذلك لأجلك

14
00:02:52,310 --> 00:03:10,710
!تُنشر مانغا "هيتوري نو شيتا: المنبوذ" في شونين جامب+ الآن

15
00:02:52,460 --> 00:02:55,270
.أرجوك يا ناتسكا

16
00:02:55,810 --> 00:02:56,690
.غادري المكان

17
00:02:59,810 --> 00:03:03,120
ما السّيّئ في الوقت الّذي قضيته معي؟

18
00:03:04,490 --> 00:03:07,660
لمَ أنت عازم على جعل نفسك تعاني؟

19
00:03:10,630 --> 00:03:12,720
.لأنّك تغيّرتِ

20
00:03:13,300 --> 00:03:15,460
،أصبحت منشقّة من زينسي

21
00:03:16,070 --> 00:03:18,410
...و... و

22
00:03:28,270 --> 00:03:31,010
مـ-معلّمي، كيف وجدتنا؟

23
00:03:35,740 --> 00:03:37,090
.ريغيوكو

24
00:03:38,190 --> 00:03:40,410
...معلّمي، إنّها

25
00:03:43,020 --> 00:03:45,140
هل هي حبيبتك؟

26
00:03:45,140 --> 00:03:46,750
!توقّف يا معلّمي

27
00:03:47,240 --> 00:03:49,250
...إنّها ليست كذلك! إنّها

28
00:03:54,070 --> 00:03:55,970
.استسلمي يا ناتسكا

29
00:03:55,970 --> 00:03:59,210
استشعر معلّمي أنّ تلميذه
.في خطر وأتى لإنقاذي

30
00:03:59,640 --> 00:04:02,530
.لا تملكين أيّة فرصة أمامه

31
00:04:02,530 --> 00:04:04,750
!غادري الجبل في الحال

32
00:04:04,750 --> 00:04:07,900
.لا، صادف أنّني بالجوار فحسب

33
00:04:07,900 --> 00:04:09,180
!معلّمي

34
00:04:15,260 --> 00:04:17,220
ما الّذي تفعلينه يا ناتسكا؟

35
00:04:22,470 --> 00:04:27,950
.فهمت. هذه هي "ناتسكا مِسحَجة العظام" من زينسي

36
00:04:28,560 --> 00:04:32,750
ما رأيك؟ هل تظنّين أنّ تعويذة الشّهوة
خاصّتك ستعمل عليّ؟

37
00:04:41,460 --> 00:04:43,520
.أنا مندهشة أيّها التّينشي

38
00:04:43,520 --> 00:04:45,350
.لقد استخففت بك

39
00:04:45,630 --> 00:04:46,720
ناتسكا؟

40
00:04:46,720 --> 00:04:47,710
.ريغيوكو

41
00:04:47,710 --> 00:04:48,580
نعم؟

42
00:04:49,020 --> 00:04:54,070
اتّجه إلى الجهة الأخرى من الجبل
.وساعد التّلاميذ

43
00:04:54,680 --> 00:04:57,790
.لكنّ ريكوكين-ساما وقع في فخّ العدوّ

44
00:04:57,790 --> 00:04:59,200
.أعلم ذلك

45
00:05:00,080 --> 00:05:04,390
.أتيت إلى هنا لأننّي استشعرت نيّته للقتل

46
00:05:04,830 --> 00:05:06,730
—معلّمي، سوف

47
00:05:06,730 --> 00:05:08,570
.هذا يفوق قدراتك

48
00:05:09,010 --> 00:05:12,650
.دعني أتولّى الأمر

49
00:05:13,160 --> 00:05:14,450
.اذهب الآن

50
00:05:14,450 --> 00:05:15,900
.حـ-حاضر

51
00:05:17,930 --> 00:05:21,100
.أنت فتاة جريئة حقًّا

52
00:05:21,430 --> 00:05:25,970
ألن تحاولين الهرب منّي؟

53
00:05:27,910 --> 00:05:33,530
أشكّ في أنّني أستطيع الهرب
.إلاّ إذا سمحت أنت لي بذلك

54
00:05:35,250 --> 00:05:38,560
.تلك ساقاك

55
00:05:38,560 --> 00:05:43,150
اذهبي أو لا تذهبي؟ أيّ مسار ستسلكين؟

56
00:05:43,150 --> 00:05:45,890
.عليك أن تقرّري ذلك بنفسك

57
00:05:46,740 --> 00:05:51,490
أصبحي منشقّة أو عيشي كشخص مستقيم؟

58
00:05:52,160 --> 00:05:55,310
نفس الشّيء ينطبق على أيّ نوع
.من الأشخاص ستصبحين

59
00:05:59,260 --> 00:06:03,770
كنت أتساءل عن مدى ذكائك
.بما أنّك أصبحت التّينشي

60
00:06:04,210 --> 00:06:06,720
.أنت تتفوّه بأشياء غبيّة حقًّا

61
00:06:07,430 --> 00:06:12,380
.طريقة عيشنا يحدّدها الغير غالبًا

62
00:06:16,230 --> 00:06:17,680
.معك حقّ

63
00:06:18,150 --> 00:06:22,870
.لكن لا يمكنك سلوك المسار الّذي تريدين اتّباعه

64
00:06:22,870 --> 00:06:26,020
.لا يمكنك أن تصبحي الشّخص الّذي تريدين

65
00:06:26,540 --> 00:06:29,580
.لا شيء يجري كما تريدين

66
00:06:29,970 --> 00:06:32,350
.تبقين مقيّدة

67
00:06:33,790 --> 00:06:35,290
.ذلك غباء

68
00:06:36,330 --> 00:06:41,950
.عدم اتّباع قلبك لن يحرّر جسدك

69
00:06:42,930 --> 00:06:45,910
.عليك التّفكير في ذلك مليًّا

70
00:06:58,150 --> 00:06:59,590
...يا لها من قوّة

71
00:07:04,600 --> 00:07:06,730
.سوف يقتلنا على هذا المعدّل

72
00:07:15,640 --> 00:07:17,910
!جينتشو، جينتشو

73
00:07:24,290 --> 00:07:28,210
لا فائدة. لا فرصة لدينا أمام
.ريكوكين في حالته تلك

74
00:07:28,210 --> 00:07:30,940
ما الّذي ستفعله يا كوني؟

75
00:07:30,940 --> 00:07:35,940
لا يمكن أن تتوقّع منّا حقًّا أن ننتظر
.إلى أن يستنفد قوّته

76
00:07:36,250 --> 00:07:40,080
.إنّه خيارنا الوحيد في الوقت الرّاهن

77
00:07:40,980 --> 00:07:44,240
.لقد غمره غضبه

78
00:07:44,240 --> 00:07:48,640
.سيستغرق التّغيير إلى شعور آخر وقتًا

79
00:07:49,480 --> 00:07:52,810
.الانتظار بصبر هو خيارنا الأفضل

80
00:07:52,810 --> 00:07:56,910
هل نسيت أنّ الوقت ليس شيئًا نملكه؟

81
00:07:56,910 --> 00:07:58,120
.علينا أن نسرع

82
00:08:04,950 --> 00:08:07,210
.تبدو فظيعًا

83
00:08:10,680 --> 00:08:15,000
هل نلتقط صورة ذكرى لهذه اللّحظة يا ريكوكين؟

84
00:08:47,910 --> 00:08:51,120
.لا فائدة من الاختباء الآن

85
00:08:52,290 --> 00:08:58,070
في اللّحظة الّتي وصلت فيه شعرت بزعزعة
.في استقرار قنوات الطّول خاصّتي

86
00:08:58,400 --> 00:09:03,170
.لا بدّ أنّك السّبب في ذلك يا كوني من رايِّنهو

87
00:09:03,590 --> 00:09:08,550
هلّ تفهّمتم الوضع وغادرتم؟

88
00:09:08,550 --> 00:09:13,200
.سأستغرق بعض الوقت للتّعامل مع ريكوكين

89
00:09:13,790 --> 00:09:17,630
،لكن إنّ أصررتم على التّدخّل

90
00:09:18,610 --> 00:09:20,380
.فسأقتلكم

91
00:09:47,430 --> 00:09:48,760
!فليهرب الجميع

92
00:09:59,090 --> 00:10:01,970
.أتمنّى لو لم تفعل ذلك

93
00:10:02,340 --> 00:10:05,120
.لا يمكننا الانسحاب بخزي

94
00:10:05,420 --> 00:10:09,200
إن لم نقتل ريكوكين الآن، فمتى سنفعل؟

95
00:10:09,200 --> 00:10:13,880
.كان ليموت الجميع بخطوة خاطئة واحدة

96
00:10:14,400 --> 00:10:18,690
.لا يكنّ لنا التّينشي أيّة نيّة سيّئة

97
00:10:19,230 --> 00:10:24,340
.لكن إن تابعنا التّدخّل، فسوف يقتلنا بالتّأكيد

98
00:10:24,840 --> 00:10:30,250
نيّته في القتل لم تكن قويّة، لكنّها
.كانت خالصة لدرجة لا تُصَدّق

99
00:10:30,620 --> 00:10:35,080
.لم يكن هناك أيّ تردّد في مشاعره

100
00:10:36,580 --> 00:10:38,020
.أنت تبالغ

101
00:10:38,020 --> 00:10:40,010
.كلاّ

102
00:10:40,010 --> 00:10:45,560
يمكنني تدمير روح أيّ شخصٍ بداخل
.الجوني روجوجين خاصّتي

103
00:10:45,560 --> 00:10:47,950
.الأمر أشبه بليّ الأسلاك

104
00:10:48,530 --> 00:10:52,720
،كنت أستعمل تقنيتي على التّينشي طوال الوقت

105
00:10:52,720 --> 00:10:58,440
وشعرت أنّ روحه أشبه بعمود
.فولاذيّ منه إلى سلك

106
00:11:04,660 --> 00:11:06,010
.هذا سيّئ

107
00:11:06,010 --> 00:11:09,130
.بدأ قتال التّينشي وريكوكين

108
00:11:09,630 --> 00:11:11,330
.فلنخرج من هنا بسرعة

109
00:11:11,330 --> 00:11:13,730
.لن نحصل على التسوتينروكو

110
00:11:13,730 --> 00:11:15,640
.لا فائدة من بقائنا هنا

111
00:11:24,740 --> 00:11:26,760
.انتظر رجاءً

112
00:11:26,760 --> 00:11:29,800
.سنبدأ بعد أن ألتقط صورة

113
00:11:30,200 --> 00:11:35,560
...لا أصدّق أنّ ترمي بالتّمائم وكأنّها بذور

114
00:11:35,560 --> 00:11:39,980
ألن يُضعِف نشرها من قوّتها؟

115
00:11:40,900 --> 00:11:43,200
.أنت لا تنتمي لأسلوب فوروكو

116
00:11:43,200 --> 00:11:45,590
.إنّها مجرّد تقنية منسوخة

117
00:11:51,680 --> 00:11:55,140
.والآن تستعمل الغورايفو خاصّتك ضدّي

118
00:11:56,160 --> 00:11:59,690
ألا تظنّ أنّ هذه قسوة منك بعض
الشّيء يا ريكوكين؟

119
00:12:21,380 --> 00:12:23,040
.فهمت

120
00:12:23,290 --> 00:12:27,970
استسلمت الزّوجوين غانجينغشو
،والشّوشاويين شينجينشو خاصّته

121
00:12:27,970 --> 00:12:30,550
.ما تسبّب في ارتفاع الكي الشّرّير خاصّته

122
00:12:30,550 --> 00:12:35,270
.دخل إلى عقله من خلال قناتي الطّول

123
00:12:35,270 --> 00:12:39,890
.الكي الشّرّير يتحكّم بعقله، ما كسر روحه

124
00:12:40,750 --> 00:12:44,690
،كي أحرّره من الكي الشّرّير خاصّته دون أذيّته

125
00:12:44,690 --> 00:12:50,410
سيتعيّن عليّ استعمال تلك التّقنية
.المتوارثة من تينشي لآخر

126
00:12:51,890 --> 00:12:56,490
.أنا ممتنّ للأبد لمعرفة السّحرة الأسطوريين

127
00:12:57,680 --> 00:12:59,760
.تايجو دايسي

128
00:12:59,760 --> 00:13:01,720
.أوهين موتي

129
00:13:02,030 --> 00:13:03,820
.كوجا باكومي

130
00:13:04,130 --> 00:13:05,730
.هومي غوشين

131
00:13:06,070 --> 00:13:07,730
.تشيي ميوجو

132
00:13:07,730 --> 00:13:09,920
.شينشين أنمي

133
00:13:09,920 --> 00:13:12,040
.سانكون إيكيو

134
00:13:12,040 --> 00:13:14,230
.هاكومو سوكي

135
00:13:15,220 --> 00:13:20,140
،إن لم يُعِدكَ هذا الهجوم إلى صوابك

136
00:13:20,450 --> 00:13:23,180
.فلُم قدرك

137
00:13:24,120 --> 00:13:26,600
.هيّا تعال يا ريكوكين

138
00:13:28,440 --> 00:13:30,070
.تعال يا ريكوكين

139
00:13:30,940 --> 00:13:33,200
.أنا أنتظر هنا

140
00:13:33,200 --> 00:13:35,930
.تعال واقتلني

141
00:13:39,600 --> 00:13:44,880
!أوكونسي، سأقتلك بيديّ هاتين

142
00:13:55,930 --> 00:13:56,940
.سوران-كن

143
00:13:58,240 --> 00:14:01,890
هل قرّرت ألاّ تخلف التّينشي؟

144
00:14:02,780 --> 00:14:06,920
.وصلنا إلى هذا الحدّ، لكنّ الأمر كان هباءً

145
00:14:06,920 --> 00:14:10,620
.لا. سأشرح كلّ شيء بعد أن نعود

146
00:14:11,260 --> 00:14:13,500
.إيجاد هو-ني له الأولويّة الآن

147
00:14:14,810 --> 00:14:18,910
ألا يمكننا استدعاء بقيّة أفراد شركة
التّوصيل السّريع والبحث عنها معًا؟

148
00:14:19,730 --> 00:14:20,700
.لا يمكننا ذلك

149
00:14:21,640 --> 00:14:25,140
.قد يكتشفون سرّ خلود هوهو

150
00:14:25,550 --> 00:14:27,580
.علينا البحث عنها بمفردنا

151
00:14:27,800 --> 00:14:29,670
.لنفترق إذًا

152
00:14:30,040 --> 00:14:32,540
.البحث معًا ليس فعّالاً

153
00:14:33,110 --> 00:14:36,320
.لكنّ زينسي يستهدفونك

154
00:14:36,320 --> 00:14:37,210
.لا

155
00:14:37,950 --> 00:14:42,160
.إنّهم مهتمّون بهو-ني أكثر منّي على الأرجح

156
00:14:42,470 --> 00:14:43,800
.لقد استخففت بهم

157
00:14:44,200 --> 00:14:48,850
ليتني توقّعت هذا بعدما حصلوا
...على ذكرياتي عن جدّي

158
00:14:49,800 --> 00:14:51,590
.لا تقلق بشأني

159
00:14:51,980 --> 00:14:53,810
.يمكنني القتال بمفردي

160
00:14:54,980 --> 00:14:57,490
.لا تتردّد يا سوران-كن

161
00:14:58,330 --> 00:15:00,750
.وإلاّ ستُقتَل

162
00:15:01,370 --> 00:15:03,330
.نعم، أعرف ذلك

163
00:15:53,430 --> 00:15:54,560
!انتظر

164
00:15:54,560 --> 00:15:56,010
ماذا تظنّ نفسك فاعلاً؟

165
00:15:56,620 --> 00:15:58,470
.أنت تشو سوران

166
00:15:58,900 --> 00:16:01,970
.لنترك ذلك الفتى ونخرج من هنا

167
00:16:01,970 --> 00:16:04,350
هل تريد أن يضربك التّينشي مجدّدًا؟

168
00:16:05,090 --> 00:16:06,540
.هذا ممتاز

169
00:16:06,540 --> 00:16:09,360
.أردت ردّ الدّين لذلك العجوز

170
00:16:10,000 --> 00:16:13,060
.سأقتل التّلميذ الّذي يحبّه كثيرًا

171
00:16:14,270 --> 00:16:15,150
!كينكوجو

172
00:16:19,330 --> 00:16:21,420
لم أتمكّن من صدها بالكينكوجو خاصّتي؟

173
00:16:21,420 --> 00:16:23,310
.لكنّها بطيئة

174
00:16:23,850 --> 00:16:25,420
.يمكنني القتال بينما أتفاداها

175
00:16:29,080 --> 00:16:31,310
.إنّه يحاول قتلي بالفعل

176
00:16:33,120 --> 00:16:35,550
.ليس أقوى من أن أتكفّل به

177
00:16:36,510 --> 00:16:37,300
...يمكنني أن أستعمله

178
00:16:40,930 --> 00:16:43,020
.أنت طفل قويّ

179
00:16:43,520 --> 00:16:45,900
.لا فائدة. لا أظنّ أنّني قادر على فعلها

180
00:16:51,750 --> 00:16:52,950
.اهدأ

181
00:16:53,290 --> 00:16:55,720
.عليّ أن أضغط على نفسي أكثر

182
00:16:56,410 --> 00:16:59,240
!فلتسقط بسرعة

183
00:16:59,240 --> 00:17:00,240
!فلتمت

184
00:17:03,400 --> 00:17:06,680
.عليّ أن أضع نفسي على حافة الحياة والموت

185
00:17:14,210 --> 00:17:16,430
.أنا معتاد على القتال الآن

186
00:17:17,140 --> 00:17:18,160
...لكن

187
00:17:22,820 --> 00:17:25,830
ألا يمكنني فعلها؟

188
00:17:26,440 --> 00:17:28,120
.لقد تسارع نبضي

189
00:17:28,520 --> 00:17:31,980
،في اللّحظة الّتي حاولت قتله فيها
.أصبح رأسي فارغًا تمامًا

190
00:17:33,600 --> 00:17:35,580
.ما زالت يدي ترتجف

191
00:17:35,580 --> 00:17:41,530
قتل خصمي بهدوء بضربة واحدة
.ليس بتلك السّهولة

192
00:17:43,110 --> 00:17:46,970
،لكن من الآن فصاعدًا
.سأكون في معارك كثيرة كهذه

193
00:17:47,710 --> 00:17:53,200
عليّ أن أصبح مقاتلاً كاملاً وأعتاد
.على المعارك المهدّدة لحياتي

194
00:17:54,630 --> 00:17:57,320
.لا أملك وقتًا أضيّعه

195
00:18:00,160 --> 00:18:02,210
.مهلاً، لا تسئ الفهم

196
00:18:02,520 --> 00:18:04,780
.لا أريد قتالك

197
00:18:05,200 --> 00:18:07,380
.أريد حمله والعودة فحسب

198
00:18:07,930 --> 00:18:10,880
.يبدو أنّه لا يزال حيًّا

199
00:18:12,240 --> 00:18:13,400
.افعل ما شئت

200
00:18:18,490 --> 00:18:22,070
.لقد تردّدت في تلك المعركة

201
00:18:22,070 --> 00:18:29,840
إن قاتلت ندًّا لي، فسيضعني الفرق
.في حالتينا الذّهنيّتين في وضع سيّئ

202
00:18:30,740 --> 00:18:35,660
.نبضي يتسارع ويرتجف جسدي وأشعر بالغثيان

203
00:18:36,380 --> 00:18:38,600
.هذا ردّ فعل عاديّ

204
00:18:39,410 --> 00:18:40,840
...قتل الغير

205
00:18:42,400 --> 00:18:46,610
.لكن لا يمكنني قول ذلك

206
00:18:47,780 --> 00:18:51,780
عليّ أن أتغيّر مهما كلّف الأمر

207
00:18:52,810 --> 00:18:55,620
.من طالب عاديّ إلى محارب

208
00:19:03,450 --> 00:19:06,780
.تبًّا. زينسي في كلّ مكان

209
00:19:06,780 --> 00:19:09,100
أين أنت يا هو-ني؟

210
00:19:15,380 --> 00:19:16,540
...تلك

211
00:19:17,710 --> 00:19:19,160
ريكو رينرون؟

212
00:19:25,130 --> 00:19:27,700
لهذا السّبب حذّرتكم

213
00:19:28,220 --> 00:19:29,850
.ألاّ تلحقوا بنا

214
00:19:30,680 --> 00:19:33,690
.رفاقي في جميع أرجاء الجبل

215
00:19:34,350 --> 00:19:36,870
.اللّحاق بي كانت غلطتكما

216
00:19:37,820 --> 00:19:44,990
يبدو أنّ ريكوكين لم يتوقّع
.هجومنا بالكثير من الرّجال

217
00:19:45,390 --> 00:19:49,440
.لم نأتِ إلى هنا لسرقة شيء ما

218
00:19:51,120 --> 00:19:53,580
،عندما يعلم أنّ حفيدته مقبوض عليها

219
00:19:53,580 --> 00:19:55,500
ماذا سيفعل في رأيك؟

220
00:19:55,870 --> 00:19:59,880
أنا واثقة أنّه سيخبرنا بكيفية الحصول
.على تسوتينروكو حينها

221
00:20:00,550 --> 00:20:03,930
نقايض امرأتين بتسوتينروكو؟

222
00:20:02,970 --> 00:20:03,930
!توقّف

223
00:20:04,440 --> 00:20:06,700
.ليست مقايضة عادلة

224
00:20:06,700 --> 00:20:08,090
...النّجدة

225
00:20:10,780 --> 00:20:12,550
!لا! أفلتني

226
00:20:13,240 --> 00:20:14,690
!توقّف

227
00:20:14,690 --> 00:20:16,730
!ساعديني يا رينرون

228
00:20:17,230 --> 00:20:19,690
أليست صديقتك؟

229
00:20:19,690 --> 00:20:22,910
لا تريدين رؤيتها تعاني أكثر من هذا، صحيح؟

230
00:20:26,270 --> 00:20:31,290
.لن نؤذيها إن أتيت معنا بهدوء

231
00:20:31,290 --> 00:20:34,040
!رينرون، ساعديني! أرجوك

232
00:20:34,490 --> 00:20:35,860
!رينرون

233
00:20:37,480 --> 00:20:41,720
.اهدئي. أنا أعلم أنّك تفهمين يا هانا-تشان

234
00:20:43,100 --> 00:20:47,970
هل تظنين حقًّا أنّنا سننجو إن استسلمنا لهم؟

235
00:20:49,290 --> 00:20:52,950
.مهما كان الأمر مؤلمًا، تقبّلي الوضع وتحمّليه

236
00:20:54,300 --> 00:20:57,180
ألم نستعدّ لهذا

237
00:20:57,530 --> 00:21:01,360
منذ اليوم الّذي قرّرنا قتال زينسي؟

238
00:21:03,240 --> 00:21:05,780
.أنت صديقتي ومهمّة بالنّسبة لي

239
00:21:06,780 --> 00:21:12,280
.لكنّني لست قويّة ما يكفي لأعدك بإنقاذك

240
00:21:13,010 --> 00:21:15,400
...لكن هناك شيء واحد يمكنني قوله

241
00:21:16,300 --> 00:21:19,640
،إن حدث أيّ شيء لك

242
00:21:20,060 --> 00:21:25,420
.فسيكون ذلك بعد أن يهزموني ويقتلوني

243
00:21:27,570 --> 00:21:29,550
.لا بدّ أنّك فهمت الآن

244
00:21:29,550 --> 00:21:34,420
لو كان الإمساك بحفيدة ريكوكين
،سيمنحنا التسوتينروكو

245
00:21:34,420 --> 00:21:36,270
.لفعلنا ذلك منذ وقت طويل

246
00:21:37,110 --> 00:21:42,340
.كلمة مساومة لا توجد في قاموس عائلة ريكو

247
00:23:20,370 --> 00:23:22,000
الحلقة القادمة

248
00:23:22,790 --> 00:23:24,530
!فليساعدنا أحد

249
00:23:24,530 --> 00:23:27,830
.تبًّا. ريكو رينرون وتسو كينكا في ورطة

250
00:23:27,830 --> 00:23:30,460
.سأدّعي أنّني لم أرهما

251
00:23:30,460 --> 00:23:31,800
!ساعدنا أيّها الوغد

252
00:23:31,800 --> 00:23:33,070
!إلى اللّقاء

253
00:23:33,070 --> 00:23:34,050
!أنت

254
00:23:34,760 --> 00:23:37,200
."في الحلقة القادمة من هيتوري نو شيتا: "معجزة

255
00:23:37,200 --> 00:23:38,480
.لا تفوّتوها