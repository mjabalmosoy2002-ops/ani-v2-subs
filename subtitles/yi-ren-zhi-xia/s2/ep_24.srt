1
00:00:06,570 --> 00:00:08,210
!أيّها المعلّم الكبير دين-ساما

2
00:00:08,210 --> 00:00:09,530
!أيّها المعلّم إيزان-ساما

3
00:00:09,530 --> 00:00:10,680
!إنّها حالة طارئة

4
00:00:11,040 --> 00:00:12,460
ما الخطب يا هاني-تشان؟

5
00:00:12,460 --> 00:00:15,700
!تعرّض التّينشيفو للهجوم من قبل زينسي

6
00:00:16,010 --> 00:00:19,080
!أولئك الأوغاد! ما الّذي يسعون إليه؟

7
00:00:19,080 --> 00:00:20,780
!هذا ليس كلّ شيء

8
00:00:20,780 --> 00:00:23,350
!لقد توّرط التّينشي في القتال

9
00:00:23,350 --> 00:00:24,580
ماذا؟

10
00:00:24,580 --> 00:00:26,420
...هناك الكثير منهم

11
00:00:26,420 --> 00:00:28,950
!سيموت الجميع على هذه الحال

12
00:00:29,210 --> 00:00:30,820
.اذهب يا إيزان

13
00:00:31,150 --> 00:00:33,700
.أنقذ إخوانك

14
00:00:33,700 --> 00:00:35,960
...لكنّ حمايتك

15
00:00:36,500 --> 00:00:37,840
!هذا أمر

16
00:00:38,210 --> 00:00:39,720
.مفهوم

17
00:00:40,010 --> 00:00:43,900
.هاني-تشان، كي-تشان. اعتنيا بشينتشو-ساما

18
00:00:43,900 --> 00:00:45,730
.اعتمد علينا يا معلّم

19
00:00:47,880 --> 00:00:50,950
يمكنهم هزيمة زينسي، صحيح؟

20
00:00:50,950 --> 00:00:53,580
لن تُدَمّر التّينشيفو، صحيح؟

21
00:00:55,390 --> 00:00:57,330
...هاني، أنت

22
00:00:59,270 --> 00:01:00,760
.دعني أعرّفك بنفسي

23
00:01:01,160 --> 00:01:03,610
...أنا زعيم زينسي الحاليّ

24
00:01:05,040 --> 00:01:06,310
.كيوكي

25
00:02:45,350 --> 00:02:47,030
.دعني أعرّفك بنفسي

26
00:02:47,030 --> 00:02:50,970
.أنا زعيم زينسي الحاليّ، كيوكي

27
00:02:47,340 --> 00:03:01,610
!تُنشر مانغا "هيتوري نو شيتا: المنبوذ" في شونين جامب+ الآن

28
00:02:51,660 --> 00:02:54,180
ماذا؟ أنت؟

29
00:02:54,680 --> 00:02:57,310
هل الأمر مفاجئ لتلك الدّرجة؟

30
00:02:57,310 --> 00:03:01,280
ألا تعرف زينسي؟

31
00:03:02,000 --> 00:03:07,080
أظنّ أنّ باستطاعتك تخيّل تسلّل أفراد زينسي

32
00:03:07,080 --> 00:03:10,460
.إلى ريوكوسان ولعب دور التّلاميذ بسهولة

33
00:03:11,550 --> 00:03:14,420
ما الّذي تريده؟

34
00:03:15,120 --> 00:03:18,690
جئت إليك لسبب واحد

35
00:03:18,690 --> 00:03:21,850
.أريد أن أعرف بشأن حرب كوشين

36
00:03:22,660 --> 00:03:29,660
ولفعل ذلك، كان عليّ التّحقيق في أمر
.تشو كايغي، شخصيّة الحرب الرّئيسيّة

37
00:03:31,670 --> 00:03:36,230
بحث عنها أفراد زينسي الآخرون

38
00:03:36,230 --> 00:03:40,060
.واكتشفوا مكانه أخيرًا

39
00:03:40,490 --> 00:03:43,740
.لكنّه كان ميتًا بالفعل

40
00:03:45,020 --> 00:03:52,270
.قرّرت التّسلل لريوكوسان حيث تدرّب تشو كايغي

41
00:03:52,760 --> 00:03:59,680
لكنّكم ما كنتم لتخبروني بشأن
.حرب كوين حتّى وإن سألتكم عنها

42
00:04:00,210 --> 00:04:02,970
.كدت أستسلم

43
00:04:03,660 --> 00:04:09,200
.لكنّني وجدت دليلاً بالصّدفة

44
00:04:10,010 --> 00:04:14,300
.كنت أنتظر فرصة لاستعمال ذلك الدّليل

45
00:04:14,850 --> 00:04:19,730
،فرصة للتّحدّث إليك بفردنا، وجهًا لوجه

46
00:04:19,730 --> 00:04:22,320
.كما نفعل الآن

47
00:04:24,020 --> 00:04:26,030
ما الّذي تريد معرفته؟

48
00:04:26,860 --> 00:04:29,840
،عندما غادر تشو كايغي ريوكوسان

49
00:04:29,840 --> 00:04:34,480
،سلكت أنت والتّينشي الحاليّ تشو جيي

50
00:04:34,480 --> 00:04:39,010
.طريقين مختلفين نزولاً من الجبل لاستعادة تشو كايغي

51
00:04:39,960 --> 00:04:44,080
،لكن رغم عدم إيجادك لكايغي

52
00:04:44,080 --> 00:04:48,960
.تعرّضت للهجوم وانتهى بك المطاف في حالتك هذه

53
00:04:49,270 --> 00:04:50,430
أليس ذلك صحيحًا؟

54
00:04:51,720 --> 00:04:54,620
كيف تعرف ذلك؟

55
00:04:54,620 --> 00:05:01,350
صحيح أنّك والتّينشي وقلّة من الآخرين
.فقط تعرفون بشأن الأمر

56
00:05:01,870 --> 00:05:06,050
.لكن أليس الأمر واضحًا إن فكّرت مليًّا بالأمر

57
00:05:06,480 --> 00:05:09,760
سمعة شائعة تقول أنّك والتّينشي

58
00:05:09,760 --> 00:05:14,110
.ذهبتما خلف فتى شقيّ غادر التّينشيفو

59
00:05:14,780 --> 00:05:19,370
.من دون شكّ أنّ الفتى الشّقيّ هو تشو كايغي

60
00:05:19,770 --> 00:05:25,250
.ومن الواضح أنّ جروحك نتيجة للتّعذيب

61
00:05:25,700 --> 00:05:30,350
ما الّذي أراد معذّبوك معرفته بشدّة

62
00:05:30,680 --> 00:05:33,790
لدرجة حتّى أنّهم كانوا عازمين على
تعذيبك بشدّة هكذا؟

63
00:05:34,170 --> 00:05:37,190
.على الأرجح كانوا يريدون معرفة مكان تشو كايغي

64
00:05:38,020 --> 00:05:40,770
استنتاجي صحيح، أليس كذلك؟

65
00:05:43,160 --> 00:05:47,300
بالمناسبة، هذا الهجوم المباغت ضدّ ريوكوسان شُنّ

66
00:05:47,300 --> 00:05:50,250
.اعتمادًا على استنتاجي وحده

67
00:05:50,690 --> 00:05:54,210
.سيقتلني الآخرون إن كنت مخطئًا

68
00:05:55,020 --> 00:05:58,950
.لم أكن أعلم أنّك ذكيّ لهذه الدّرجة

69
00:05:59,410 --> 00:06:03,650
.لكن لا يمكنني أن أقول أنّك محقّ

70
00:06:04,090 --> 00:06:09,130
افترقت أنا والتّينشي بالفعل ونزلنا من الجبل

71
00:06:09,130 --> 00:06:14,090
.للبحث عن كايغي، وأنا الوحيد الّذي تعرّض للهجوم

72
00:06:14,530 --> 00:06:20,200
.عذّبوني كي أخبرهم بمكان كايغي

73
00:06:20,690 --> 00:06:25,600
.لكن لم تكون لديّ طريقة لمعرفة مكانه

74
00:06:26,590 --> 00:06:31,480
!ما زلت نادمًا لعدم تمكّني من إيجاده

75
00:06:34,670 --> 00:06:38,280
.أنت كتوم حقًّا

76
00:06:39,320 --> 00:06:40,840
.ادخل

77
00:06:57,360 --> 00:07:00,840
.إنّه رو ريو، مستعمل ميكون

78
00:07:00,840 --> 00:07:05,770
.يمكنه التّلاعب بروحك واستخراج ذكرياتك

79
00:07:06,380 --> 00:07:09,870
ما زلت لن تخبرني بالحقيقة؟

80
00:07:10,410 --> 00:07:14,060
أم تريد سماع المزيد ممّا استنتجت؟

81
00:07:14,750 --> 00:07:17,070
.حسن

82
00:07:17,640 --> 00:07:23,010
اعتنيت بك للسّنوات الثّلاث
.الّتي قضيتها في ريوكوسان

83
00:07:24,080 --> 00:07:26,630
وذات يوم رأيتك

84
00:07:27,670 --> 00:07:31,110
.تحاول يائسًا أن تبقى مستيقظًا

85
00:07:38,380 --> 00:07:44,330
أيّها المعلّم الكبير، أصحيح أنّ المعلّم الكبير
دين-ساما لا ينام أبدًا؟

86
00:07:45,300 --> 00:07:47,970
هل هو بخير دون النّوم؟

87
00:07:48,760 --> 00:07:56,230
أمثال شينتشو الّذين يملكون عزيمة
.قويّة لا يحتاجون النّوم

88
00:07:56,230 --> 00:07:59,520
هذا مذهل. منذ متى لم ينم؟

89
00:08:00,340 --> 00:08:03,440
.لوقت طويل الآن

90
00:08:03,980 --> 00:08:09,470
أعتقد أنّه لم ينم مذ أصبح
.على الحالة الّتي فيها الآن

91
00:08:10,470 --> 00:08:11,890
...مذهل

92
00:08:13,240 --> 00:08:16,250
.تحمّست لمعرفة ذلك

93
00:08:16,250 --> 00:08:21,150
.فقد قدّم لي ذلك احتمالية معيّنة

94
00:08:21,530 --> 00:08:24,490
.الأمر ليس أنّك لا تحتاج النّوم

95
00:08:25,040 --> 00:08:29,040
.بل لا يمكنك النّوم. أنت تخشى من أن تنام

96
00:08:29,650 --> 00:08:34,170
.نزلت من الجبل للبحث عن تشو كايغي

97
00:08:35,020 --> 00:08:40,470
والرّجال الّذين هاجموك كانوا يبحثون
.عن تشو كايغي أيضًا

98
00:08:41,490 --> 00:08:43,780
،مهما عّذبوك

99
00:08:43,780 --> 00:08:47,630
.فشلوا في استخراج مكان تشو كايغي منك

100
00:08:49,060 --> 00:08:53,440
.فافترضوا أنّك فشلت في إيجاد تشو كايغي

101
00:08:54,730 --> 00:08:58,210
.وإلّا ما كانوا ليتركوك على قيد الحياة

102
00:08:58,520 --> 00:09:00,170
أليس ذلك صحيحًا؟

103
00:09:00,170 --> 00:09:04,690
،إن علم شخص في ريوكوسان بمكان تشو كايغي

104
00:09:04,690 --> 00:09:07,570
.فسيعترضون طريقهم فحسب

105
00:09:08,330 --> 00:09:13,730
.ولم تتمكّن من النّوم منذ ذلك اليوم

106
00:09:14,010 --> 00:09:17,100
.كما لو أنّك تخشى شيئًا ما

107
00:09:18,010 --> 00:09:21,170
لِمَ تخشى النّوم لهذه الدّرجة؟

108
00:09:21,510 --> 00:09:23,850
.عندها خطر لي الأمر

109
00:09:24,260 --> 00:09:28,930
.النّوم يفقد النّاس التّحكّم في أنفسهم

110
00:09:30,160 --> 00:09:34,380
.نعم. ما كنت تخشاه هو التّحدّث في نومك

111
00:09:35,000 --> 00:09:41,070
منذ اليوم الّذي نزلت فيه من الجبل للبحث
،عن تشو كايغي وتعرّضك للتّعذيب

112
00:09:41,070 --> 00:09:44,270
.وأنت تخفي سرًّا لا يجب أن ينكشف أبدًا

113
00:09:44,770 --> 00:09:47,850
.لقد التقيت بتشو كايغي

114
00:09:48,500 --> 00:09:54,210
أجريت حديثًا معه اضطررت لإخفائه
،عن معلّمك وعن التّينشي

115
00:09:54,210 --> 00:09:55,800
.حتّى وإن عنى الأمر الكذب عليهم

116
00:09:57,600 --> 00:10:01,340
ما رأيك؟ هل استنتاجي خاطئ؟

117
00:10:02,760 --> 00:10:06,260
.فكّرت طويلاً وبشكل عميق في هذا الأمر يا فتى

118
00:10:06,860 --> 00:10:09,240
.لكنّك مخطئ

119
00:10:09,240 --> 00:10:11,960
.لم ألتق بكايغي

120
00:10:12,460 --> 00:10:17,760
،يمكنك قطع أطرافي أو سحق نظام الطّول خاصّتي

121
00:10:18,150 --> 00:10:21,590
!لكنّني لم أعثر عليه قطّ

122
00:10:22,080 --> 00:10:26,470
.أيًّا كان من يسأل، فهناك جواب واحد

123
00:10:27,380 --> 00:10:33,080
.أيّها المعلّم الكبير دين، أعلم كم أنت كتوم

124
00:10:33,520 --> 00:10:35,770
.لهذا السّبب أحضرته

125
00:10:36,500 --> 00:10:37,300
.قم بذلك

126
00:10:41,490 --> 00:10:42,330
.لا تفعل

127
00:10:42,330 --> 00:10:43,620
!لا تفعل هذا

128
00:10:43,620 --> 00:10:45,360
!أنا لا أعرف شيئًا

129
00:10:48,280 --> 00:10:51,960
.قد يعود التّينشيفو في أيّة لحظة

130
00:10:51,960 --> 00:10:54,870
.ابحث عن ذكرى ذلك اليوم بسرعة

131
00:10:56,300 --> 00:10:57,840
،بمجرد أن تجدها

132
00:10:57,840 --> 00:11:02,050
.لا تنس محو ذكريات الحادثة وذكريات هذا اليوم

133
00:11:02,600 --> 00:11:03,920
.لا يمكنني ذلك

134
00:11:04,570 --> 00:11:09,620
.روحه أقوى من أيّ شيء رأيته حتّى الآن

135
00:11:10,070 --> 00:11:12,780
.ولوج روحه وحده صعب

136
00:11:12,780 --> 00:11:17,850
لست واثقًا أنّ بإمكاني إيجاد ذكرى
.معيّنة حتّى لو كان لديّ بضعة أشهر

137
00:11:18,890 --> 00:11:22,480
.من المستحيل إيجادها في هذا الوقت القصير

138
00:11:23,210 --> 00:11:24,860
.تابع المراقبة

139
00:11:24,860 --> 00:11:28,860
سأنسخ كلّ ما استطعت من ذكرياته
.في الوقت الرّاهن

140
00:11:58,340 --> 00:12:00,270
.لقد نجحت بطريقة ما

141
00:12:01,040 --> 00:12:03,630
.نسخت جميع ذكرياته

142
00:12:04,420 --> 00:12:06,230
.لم يعد لدينا ما نفعله هنا

143
00:12:06,640 --> 00:12:08,490
.علينا الذّهاب

144
00:12:09,050 --> 00:12:11,160
.انتظر يا هاني

145
00:12:12,640 --> 00:12:14,730
.اتركه

146
00:12:15,110 --> 00:12:17,710
.انتهى الأمر الآن، هيّا بنا

147
00:12:20,890 --> 00:12:23,540
.هيّا، أسرع قبل أن يأتي أحد ما

148
00:12:23,970 --> 00:12:26,030
!افعل ما شئت إن كنت تريد الموت

149
00:12:26,030 --> 00:12:27,600
!أنا ذاهب

150
00:12:29,430 --> 00:12:30,210
.تبًّا

151
00:12:39,030 --> 00:12:40,350
...هاني

152
00:12:41,310 --> 00:12:43,200
.لست سيّئًا

153
00:12:43,200 --> 00:12:47,680
لا أصدّق أنّك كنت تخطّط لهذا
.للسّنوات الثّلاث الماضية

154
00:12:48,310 --> 00:12:53,860
.يبدو أنّ كلّ شيء جرى مثلما خطّطت له

155
00:12:54,350 --> 00:12:58,870
.لا يوجد ما يمكنني فعله لإيقافك الآن

156
00:12:59,860 --> 00:13:00,610
.نعم

157
00:13:01,670 --> 00:13:05,380
هل ستتركني هكذا وستذهب؟

158
00:13:06,200 --> 00:13:06,980
.نعم

159
00:13:11,560 --> 00:13:13,780
.زينسي مجرّد أضحوكة

160
00:13:13,780 --> 00:13:18,270
،تعلنون بكلّ عجرفة أنّكم تدافعون عن مصالحكم

161
00:13:18,270 --> 00:13:22,050
لكن كلّ ما تفعلونه هو فعل
.كلّ ما يحلو لكم بكلّ أنانيّة

162
00:13:22,050 --> 00:13:25,980
.أنتم لستم سوى مجموعة من الأوغاد

163
00:13:26,510 --> 00:13:30,720
تدمّرون كلّ شيء بينما لا تتحمّلون
.مسؤوليّة أيّ شيء

164
00:13:31,260 --> 00:13:33,530
!أنتم فاشلون

165
00:13:34,760 --> 00:13:37,600
.توقّف رجاءً أيّها المعلّم الكبير دين

166
00:13:37,600 --> 00:13:38,800
.هذه ليست طبيعتك

167
00:13:39,080 --> 00:13:42,040
!لا تنادني بمعلّم بهذه البساطة

168
00:13:42,040 --> 00:13:44,920
!لا تملك الحقّ في ذلك أيّها الحثالة

169
00:13:51,070 --> 00:13:53,110
.هذا يكفي. لقد فهمت

170
00:13:54,250 --> 00:13:58,330
.سأقوم بالشّيء المسؤول وأزهق روحك

171
00:14:01,030 --> 00:14:03,820
.لا يمكنك تولّي ذلك

172
00:14:03,820 --> 00:14:05,800
.أنا أحد الشّيوخ العشرة

173
00:14:06,450 --> 00:14:10,990
!لا يمكنك قتل شخص بمقامي أبدًا

174
00:14:12,160 --> 00:14:15,120
.لا تستفزّني أكثر من هذا رجاءً

175
00:14:36,480 --> 00:14:38,000
...أخيرًا

176
00:14:38,630 --> 00:14:40,450
هل هذا قرارك حقًّا؟

177
00:14:43,700 --> 00:14:47,430
هل أنت عازم على معرفة الأمر لتلك الدّرجة يا شينتشو؟

178
00:14:50,370 --> 00:14:54,030
.لن أستسلم حتّى أسمعك تقولها

179
00:15:01,200 --> 00:15:05,040
.هل تفهم الآن؟ هذا ما نفعله

180
00:15:05,540 --> 00:15:08,360
أما زلت تريد إعادتي؟

181
00:15:09,960 --> 00:15:12,960
.لا. لا يمكنك العودة إلى التّينشيفو

182
00:15:13,320 --> 00:15:15,020
.ولا يجب عليك لقاء معلّمنا أيضًا

183
00:15:15,620 --> 00:15:21,110
لكن إن كان ما قلته صحيحًا، فكيف لا تزال حيًّا؟

184
00:15:22,090 --> 00:15:25,070
.أن الأخ الرّابع الّذي أقسم

185
00:15:25,440 --> 00:15:28,480
.لقد فهمت شيئًا بعد أن تخطّيت قوّة موكونسي

186
00:15:29,320 --> 00:15:30,580
فهمت شيئًا؟

187
00:15:31,020 --> 00:15:32,080
ماذا فهمت؟

188
00:15:34,940 --> 00:15:38,480
.أعمق أسرار أسلوب كيتايغين

189
00:15:39,840 --> 00:15:41,300
أسلوب كيتايغين؟

190
00:15:41,680 --> 00:15:43,680
!يا كايغي-سان

191
00:15:44,660 --> 00:15:46,240
!هيّا بنا

192
00:15:47,660 --> 00:15:49,820
.تعال معي يا شينتشو

193
00:15:50,330 --> 00:15:52,640
.لا يمكنك العودة إلى ريوكوسان الآن

194
00:15:53,000 --> 00:15:57,820
.لا يمكنني ذلك. ينتظر معلّمي والآخرون عودتي

195
00:15:58,800 --> 00:16:02,370
.سيتوجّب عليك إخفاء هذا السّرّ إلى أن تموت

196
00:16:02,850 --> 00:16:05,290
.لا يمكنك إخبار حتّى معلّمك

197
00:16:05,950 --> 00:16:07,440
هل أنت مستعدّ لذلك؟

198
00:16:08,370 --> 00:16:11,070
.لا يمكنني توريطهم

199
00:16:13,260 --> 00:16:17,550
.ما كنت لأسأل لو أنّني علمت أنّ هذا هو الجواب

200
00:16:17,550 --> 00:16:19,940
.أخبرتك فقط لأنّه أنت يا شينتشو

201
00:16:21,220 --> 00:16:24,910
.أفضّل الموت على إخبار أيّ أحد آخر

202
00:16:25,630 --> 00:16:28,340
.الباقي عليك يا شينتشو

203
00:16:28,840 --> 00:16:29,840
.الوداع

204
00:16:33,160 --> 00:16:34,220
!شينتشو

205
00:16:35,180 --> 00:16:36,420
!استيقظ

206
00:16:36,420 --> 00:16:37,710
!شينتشو

207
00:16:37,710 --> 00:16:38,960
هل تعرف من نحن؟

208
00:16:40,060 --> 00:16:41,540
...معلّمي

209
00:16:42,790 --> 00:16:44,890
...جيي-سينباي

210
00:16:48,320 --> 00:16:52,860
.لم أستطع إيجاد كايغي

211
00:16:53,460 --> 00:16:58,060
.لكن مع ذلك استجوبوني حول مكانه

212
00:16:59,240 --> 00:17:01,100
.أنا آسف

213
00:17:01,570 --> 00:17:06,970
،لم أفشل في إعادة كايغي فحسب
.بل عدت في هذه الحالة أيضًا

214
00:17:07,460 --> 00:17:10,010
.هذا يكفي. لا تتحدّث يا شينتشو

215
00:17:10,610 --> 00:17:16,300
.أعدك أن أعرف من هاجموك

216
00:17:16,790 --> 00:17:18,960
.سأنتقم لك

217
00:17:20,050 --> 00:17:24,030
.أنا آسف يا معلّمي

218
00:17:29,340 --> 00:17:30,680
ما الّذي يجري؟

219
00:17:38,820 --> 00:17:40,030
!شينتشو

220
00:17:41,400 --> 00:17:42,820
ما الّذي تفعله؟

221
00:17:43,160 --> 00:17:46,200
.أرجوك يا معلّمي

222
00:17:46,620 --> 00:17:48,930
.دعني أموت

223
00:17:49,460 --> 00:17:53,000
.سأكون عبئًا لكم فحسب إن بقيت حيًّا

224
00:17:54,020 --> 00:17:56,000
!أرجوك

225
00:17:56,000 --> 00:17:57,380
!أيّها الأحمق

226
00:17:57,380 --> 00:18:00,320
!ما الّذي تعلّمته هنا؟

227
00:18:04,280 --> 00:18:05,340
.استمع إليّ

228
00:18:05,860 --> 00:18:10,860
.أنت مثلي، رجل يسعى للتّنوير

229
00:18:11,480 --> 00:18:16,600
عليك احترام الحياة وتخطّي جميع
.العقبات الّتي تواجهك

230
00:18:17,700 --> 00:18:20,860
!لا يمكنك إنهاء حياتك

231
00:18:22,350 --> 00:18:25,810
.مهما كانت صعبة، عليك تحمّلها ومتابعة الحياة

232
00:18:25,810 --> 00:18:27,840
...تذكّر هذا أيضًا

233
00:18:28,710 --> 00:18:33,720
في كلّ مرة تكون مستعدًّا للتّخلّي
.عن كلّ شيء، عليك أن تتدرّب

234
00:18:34,460 --> 00:18:37,820
.معلّمي، مفهوم

235
00:18:40,540 --> 00:18:43,340
.أقسم على أنّك ستفعل

236
00:18:43,340 --> 00:18:44,280
.نعم يا معلّمي

237
00:18:50,320 --> 00:18:52,340
.الفطور يا شينتشو

238
00:18:53,350 --> 00:18:57,570
.آسف لإزعاجك يا جيي-سينباي

239
00:18:58,690 --> 00:19:01,150
.لا تقل ذلك يا شينتشو

240
00:19:01,150 --> 00:19:04,280
.أُصبت أثناء عملك للتّينشيفو

241
00:19:05,520 --> 00:19:09,270
.لا يوجد شيء تأسف عليه

242
00:19:10,130 --> 00:19:14,990
كما أنّني أستطيع تفويت حصص
.التّدريب المملّة إن كنت أعتني بك

243
00:19:15,470 --> 00:19:17,580
.أنت تساعدني على حدّ علمي

244
00:19:18,230 --> 00:19:21,380
.لست آسفًا

245
00:19:21,380 --> 00:19:22,580
،هذا ما تقوله

246
00:19:22,930 --> 00:19:28,300
.لكنّك تابعت الاعتذار لي ولمعلّمنا أثناء نومك

247
00:19:52,480 --> 00:19:59,250
.هذا هو وقت التّدريب

248
00:20:00,100 --> 00:20:05,050
.أنا آسف يا كايغي. لم يكن عليّ أن أسأل

249
00:20:05,580 --> 00:20:08,350
.ما كان عليّ أن أعود لريوكوسان

250
00:20:09,530 --> 00:20:12,560
.فعلت هذا لنفسي

251
00:20:13,300 --> 00:20:15,720
.أنا آسف يا معلّمي

252
00:20:16,910 --> 00:20:19,890
.لقد انحبست من جميع الجوانب

253
00:20:19,890 --> 00:20:22,450
.لا أعرف أين أذهب

254
00:20:23,860 --> 00:20:26,420
.جميع من في ريوكوسان، أنا آسف

255
00:20:26,820 --> 00:20:29,610
.آسف لأنّ عليكم الاعتناء بي

256
00:20:31,280 --> 00:20:32,530
.أنا آسف

257
00:20:33,300 --> 00:20:35,860
.آسف يا رفاق

258
00:20:40,630 --> 00:20:45,330
كان عليّ اتّخاذ قراري عندما عرفت
.ما كان كايغي يفعله

259
00:20:46,940 --> 00:20:50,180
كان علي إنهاء حياتي مع أنّ ذلك يعني

260
00:20:50,180 --> 00:20:53,150
.نكث العهد الّذي أقسمته لمعلّمي

261
00:20:54,270 --> 00:20:55,610
.أنا آسف

262
00:21:03,600 --> 00:21:05,400
.أنا آسف

263
00:21:06,150 --> 00:21:09,970
.كان عليّ الموت حينها

264
00:21:12,750 --> 00:21:14,330
...أيّها المعلّم الكبير دين

265
00:21:16,220 --> 00:21:17,610
.نم جيّدًا

266
00:23:25,960 --> 00:23:27,210
الحلقة القادمة

267
00:23:27,210 --> 00:23:29,800
.الوداع أيّها المعلّم الكبير دين

268
00:23:30,210 --> 00:23:32,600
.فلترقد بسلام

269
00:23:33,970 --> 00:23:38,030
."في الحلقة القادمة من "هيتوري نو شيتا": "بكين

270
00:23:38,030 --> 00:23:39,210
.لا تفوّتوها