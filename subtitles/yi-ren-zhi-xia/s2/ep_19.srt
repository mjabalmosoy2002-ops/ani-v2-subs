1
00:01:45,070 --> 00:01:49,990
ريكوكين-ساما، أيّ نوعٍ من الكونغ فو يستخدم؟

2
00:01:47,500 --> 00:02:01,600
!تُنشر مانغا "هيتوري نو شيتا: المنبوذ" في شونين جامب+ الآن

3
00:01:50,290 --> 00:01:56,250
.قوّة سبحته هي ما يصدّ السّويزوراي خاصّتك

4
00:01:56,730 --> 00:01:59,070
.إين تو معوّذ تابع لزينسي

5
00:02:00,070 --> 00:02:06,500
.أغلب مختلف الأسلحة الأسطوريّة صنعها معوّذون

6
00:02:07,000 --> 00:02:10,270
.لكن للنّاس والأسلحة حدودها

7
00:02:10,810 --> 00:02:13,490
.أرنا ما يمكنك فعله

8
00:02:14,000 --> 00:02:18,070
.لا ينبغي عليك أن تستخفّ بي

9
00:02:24,410 --> 00:02:25,750
.إنّه سريع

10
00:02:34,290 --> 00:02:35,730
.ستار دخانيّ

11
00:02:35,960 --> 00:02:37,080
...في تلك الحالة

12
00:02:49,700 --> 00:02:51,380
!اقض عليه بضربة واحدة

13
00:02:57,130 --> 00:02:59,230
!كان لديه أكثر من جدار واحد؟

14
00:02:59,230 --> 00:03:02,650
.أهنّئك على كسر جدار التشيفونجو

15
00:03:02,650 --> 00:03:04,650
...لكن الآن

16
00:03:04,650 --> 00:03:07,310
!انتهى أمرك

17
00:03:20,790 --> 00:03:22,670
.تبًّا لك يا ريكوكين

18
00:03:22,670 --> 00:03:25,830
متى تعلّمت استعمال غوريكي شيفو؟

19
00:03:26,220 --> 00:03:29,070
.شكرًا لك يا ريكوكين-ساما

20
00:03:29,070 --> 00:03:30,730
.لا داعي لشكري

21
00:03:30,730 --> 00:03:34,560
لكنّي متفاجئ لأنّ إين تو طوّر
.مهاراته إلى هذه الدّرجة

22
00:03:34,970 --> 00:03:37,260
.أحسنت يا ريغيوكو

23
00:03:37,560 --> 00:03:39,370
.تراجع الآن

24
00:03:39,790 --> 00:03:42,370
.سأتولّى الباقي

25
00:03:45,190 --> 00:03:45,780
ماذا؟

26
00:03:47,840 --> 00:03:51,160
هل هذه تقنية غوراي فوجو من أسلوب شويتسو؟

27
00:03:51,770 --> 00:03:55,750
.يصبّ المعوّذون بقلوبهم في أسلحتهم

28
00:03:55,750 --> 00:03:59,250
هناك طريقة واحدة لتدميرها

29
00:03:59,570 --> 00:04:02,500
.وهي التّغلّب عليهم بقوّتك

30
00:04:04,750 --> 00:04:06,040
!تبًّا

31
00:04:13,190 --> 00:04:14,750
.مذهل

32
00:04:15,780 --> 00:04:17,600
هل هذا كلّ شيء؟

33
00:04:20,260 --> 00:04:22,390
.تقنية غوريكي شيفو من أسلوب جوسي

34
00:04:22,390 --> 00:04:24,250
.غوراي فوجو من أسلوب شويتسو

35
00:04:24,990 --> 00:04:27,960
.تواصل استخدام تقنيات من أساليب أخرى

36
00:04:29,670 --> 00:04:36,380
أليس لديك أيّ كبرياء بصفتك النّاجي
الأخير لأسلوب سانيتشيمون؟

37
00:04:37,220 --> 00:04:38,590
سانيتشيمون؟

38
00:04:41,930 --> 00:04:44,730
.لقد تمّ حلّ ذلك الأسلوب منذ وقت طويل

39
00:04:45,240 --> 00:04:48,050
مضت سنوات كثيرة منذ آخر
.مرّة سمعت فيها ذلك الاسم

40
00:04:48,740 --> 00:04:52,970
هل هذا تأثير للكي الّذي يتدفّق من ريكوكين-ساما؟

41
00:04:53,980 --> 00:04:56,400
.حتّى مظهره تغيّر

42
00:04:56,990 --> 00:05:00,620
والكي المحيط بجسده يختلف
.عن الكي المعتاد خاصّته أيضًا

43
00:05:03,320 --> 00:05:07,680
.لا يحقّ لك أن تعظني بشأن الكبرياء

44
00:05:09,770 --> 00:05:14,630
لم أظنّ أبدًا أنّني سأرى فنّ سانيتشيمون
!السّرّيّ مجدّدًا في سنّي

45
00:05:14,980 --> 00:05:16,120
!خذ هذه

46
00:05:21,550 --> 00:05:22,460
!يازوجو

47
00:05:31,830 --> 00:05:32,960
!التشيفونجو خاصّتي

48
00:05:33,580 --> 00:05:38,140
.أيّها الأحمق. لا بدّ أنّك تملك كرات دفاعيّة أخرى

49
00:05:40,960 --> 00:05:42,850
لِمَ لون دمه هكذا؟

50
00:05:43,870 --> 00:05:46,030
.جرحه ينغلق

51
00:05:46,540 --> 00:05:48,550
أيّ فنّ سرّيّ هذا؟

52
00:05:49,730 --> 00:05:53,660
.أنت رجل محظوظ يا ريغيوكو

53
00:05:53,660 --> 00:06:01,510
من النّادر جدًّا رؤية سلاحي أو غياكسي سانجو
.الّتي يستعملها ريكوكين-سينباي

54
00:06:02,320 --> 00:06:08,470
عندما يولد المرء، يتجسّد الكي
.الطّبيعيّ له ليشكّل جسده

55
00:06:09,110 --> 00:06:12,160
لكنّ المبدأ الجوهريّ لسانيتشيمون هو العودة

56
00:06:12,160 --> 00:06:17,020
.إلى ذلك الكي الطّبيعيّ مصدر كلّ الأشياء

57
00:06:17,310 --> 00:06:22,870
إن أتقنت غياكسي سانجو وأعدت
،الكي الخاصّ إلى حالته الطّبيعيّة تمامًا

58
00:06:22,870 --> 00:06:25,730
.فيمكنك حتّى أن تصبح ساحرًا أسطوريًّا حينها

59
00:06:27,970 --> 00:06:29,060
!كونسينفو

60
00:06:30,850 --> 00:06:31,540
!لا يمكنني التّحرّك

61
00:06:32,480 --> 00:06:33,410
!كان تان

62
00:06:33,610 --> 00:06:34,590
.قادم

63
00:06:36,230 --> 00:06:37,560
!سويزوراي

64
00:06:43,220 --> 00:06:44,960
!كان تان! استعمل مطرقتك

65
00:06:44,960 --> 00:06:46,300
.حسنًا

66
00:06:52,810 --> 00:06:55,680
.لا تهاجمهما يا ريغيوكو

67
00:06:56,100 --> 00:06:59,510
.ليس وكأنّني أستخفّ بقدراتك

68
00:07:00,300 --> 00:07:05,010
بل لأنّ لديهما الأفضليّة لأنّها أوّل
.مرة تقاتل فيها معوّذًا

69
00:07:05,370 --> 00:07:09,890
لو لم أكن هنا، لقُتِلتَ في قتالك
.مع إين تو قبل قليل

70
00:07:09,890 --> 00:07:13,700
لكنّ ذلك الضّخم ليس معوّذًا، أليس كذلك؟

71
00:07:13,700 --> 00:07:16,410
.كلاّ، الضّخم معوّذ أيضًا

72
00:07:18,630 --> 00:07:19,820
.لا أعرف ما إن كنّا محظوظين أم لا

73
00:07:19,820 --> 00:07:24,890
من النّادر جدًّا رؤية المعوّذين هذه
.الأيام، لكنّنا التقينا اثنين في يومٍ واحد

74
00:07:24,890 --> 00:07:27,350
.وهما بارعان في ذلك

75
00:07:28,340 --> 00:07:30,590
.مذهل يا ريكوكين-سينباي

76
00:07:30,590 --> 00:07:34,770
كيف عرفت أنّ كان تان معوّذ؟

77
00:07:35,130 --> 00:07:39,870
علمت مباشرة عندما رأيت مسدّس
.الماء غير المنطقيّ ذاك

78
00:07:41,200 --> 00:07:45,590
.وعلمت أنّه أقوى بكثير منك

79
00:07:46,620 --> 00:07:49,400
.أعرف مدى قوّتك يا إين تو

80
00:07:49,400 --> 00:07:55,170
لا بدّ أنّ إنشاء تلك الكرات السّخيفة
.استنفذ كمّيّة كي لعُمرٍ كامل

81
00:07:56,000 --> 00:07:58,300
لا يوجد معوّذ

82
00:07:58,300 --> 00:08:01,560
.لا يحبّ السّلاح الّذي أنشأه كما لو كان ابنًا له

83
00:08:02,100 --> 00:08:09,040
.رأيت معوّين يُنهون حياتهم لأنّ أسلحتهم دُمِّرت

84
00:08:09,610 --> 00:08:15,690
،لكن عندما دّمرّت التشينفونجو خاصّتك
.لم تطرف لك عين حتّى

85
00:08:16,300 --> 00:08:21,390
تصرّفت بتلك الطّريقة لأنّك تستطيع الحصول
.على سلاح آخر بكلّ سهولة

86
00:08:21,960 --> 00:08:26,130
.ذلك الضّخم يوفرها لك على الأرجح

87
00:08:27,850 --> 00:08:31,570
.تعلّمت شيئًا إذًا في سنّك الكبيرة

88
00:08:31,570 --> 00:08:33,720
.لديك نظرة جيّدة

89
00:08:33,720 --> 00:08:36,320
.لكنّك أخطأت في شيء واحد

90
00:08:37,110 --> 00:08:42,510
.تحفتي الفنّيّة هي كان تان وليس تلك الكرات

91
00:08:42,740 --> 00:08:43,770
ماذا؟

92
00:08:44,790 --> 00:08:47,120
!أسرع وأنتج أرنبك

93
00:08:48,490 --> 00:08:50,660
!الأرنب الوثّاب

94
00:08:51,490 --> 00:08:53,280
هل سنتوقّف عن اللّعب؟

95
00:08:53,280 --> 00:08:54,110
!أيّها الغبيّ

96
00:08:54,110 --> 00:08:56,080
!سنُقتَل على هذا المعدّل

97
00:08:56,520 --> 00:08:57,330
!لا يمكنكما الهرب

98
00:08:58,180 --> 00:08:59,890
!الأرنب الوثّاب

99
00:08:59,890 --> 00:09:00,990
!قفز

100
00:09:01,580 --> 00:09:03,150
.إنّـ-إنّهما سريعان

101
00:09:03,400 --> 00:09:05,250
!تاين تشوجو

102
00:09:07,510 --> 00:09:08,480
!خلفهما

103
00:09:09,890 --> 00:09:12,020
لِمَ أشعر أنّ جسدي خفيف جدًّا؟

104
00:09:12,020 --> 00:09:14,250
.لم أرَ تقنية كهذه من قبل

105
00:09:14,680 --> 00:09:17,950
...ريكوكين-ساما وذلك الرّجل إين تو

106
00:09:18,480 --> 00:09:23,210
هل هذه قوّة الدّخلاء
الّذين نجوا من حرب كوشين؟

107
00:09:24,320 --> 00:09:25,840
.أجل، هذا صحيح

108
00:09:26,190 --> 00:09:29,980
.ريكوكين وتشو ريغيوكو يتبعاننا

109
00:09:29,980 --> 00:09:33,970
كلّ ما كان علينا فعله هو سرقة
.التسوتينروكو، لكن ما باليد حيلة

110
00:09:34,240 --> 00:09:37,830
.أرسلوا جميع المنتظرين في قاع الجبل

111
00:09:37,830 --> 00:09:39,630
.كلّما كانت الجلبة أكبر، كانت أفضل

112
00:09:40,310 --> 00:09:44,380
.لن يعرفوا هدفنا الآن

113
00:10:00,750 --> 00:10:03,890
.تبًّا، إنّها سريعة

114
00:10:03,890 --> 00:10:05,990
.سأنال منها هذه المرّة

115
00:10:10,990 --> 00:10:13,080
حصاة؟

116
00:10:30,620 --> 00:10:33,360
.لا فائدة من الاختباء خلفة الشّجرة

117
00:10:37,080 --> 00:10:37,950
...ما

118
00:10:38,470 --> 00:10:39,730
ليست هناك؟

119
00:10:39,730 --> 00:10:40,960
!احترس

120
00:10:42,030 --> 00:10:42,660
!تبًّا

121
00:10:43,500 --> 00:10:45,200
...مستحيل

122
00:10:48,400 --> 00:10:49,410
.فقدتها

123
00:10:49,410 --> 00:10:52,150
أين؟ أين هي؟

124
00:10:53,100 --> 00:10:55,410
هيّا! ما هذا؟

125
00:10:55,720 --> 00:10:57,950
،كنّا نحاول توجيه هجوم مفاجئ لها

126
00:10:57,950 --> 00:11:01,580
فلمَ إذًا يبدو أنّنا من نتعرّض للهجوم المفاجئ؟

127
00:11:14,200 --> 00:11:16,680
.مبتدئون

128
00:11:16,680 --> 00:11:19,740
ألا يمكنهم التّربّص بشكلٍ أفضل؟

129
00:11:20,250 --> 00:11:26,340
إنّ كان لهذه الفتاة الأولويّة على
.التسوتينروكو، فلا بدّ أنّها قويّة

130
00:11:27,660 --> 00:11:30,860
.أنا الوحيد القادر على الإطاحة بها

131
00:11:30,860 --> 00:11:33,930
،سأنتظرها حتّى ترخي دفاعها

132
00:11:34,290 --> 00:11:36,130
.وبعدها أقضي عليها بضربة واحدة

133
00:11:36,590 --> 00:11:37,360
...ما

134
00:11:44,900 --> 00:11:47,720
.اسمعي جيّدًا يا هوهو

135
00:11:48,070 --> 00:11:52,630
يمكنك الافتراض أنّ أيّ شخص
.يهاجمكما أنت وسوران عدوّ

136
00:11:52,630 --> 00:11:54,740
.اهزميهم جميعًا

137
00:11:54,740 --> 00:11:56,670
.لا نعرف ما سيحدث

138
00:11:56,670 --> 00:11:58,010
.كن حذرًا

139
00:12:00,710 --> 00:12:03,580
.أهزمهم جميعًا

140
00:12:11,670 --> 00:12:13,320
.أنا مرهق

141
00:12:14,190 --> 00:12:16,810
.إنّها فتاة سريعة

142
00:12:16,810 --> 00:12:19,870
.كادت تمسك بي قبل أن تقع في الفخّ

143
00:12:20,660 --> 00:12:23,490
.سأُطرد الآن على الأرجح

144
00:12:33,640 --> 00:12:34,930
.مستحيل

145
00:12:35,330 --> 00:12:36,610
هزمت غو؟

146
00:12:37,690 --> 00:12:40,990
...ما يعني أنّ الآخرين أيضًا

147
00:12:41,900 --> 00:12:47,870
.لحظة... من الجيّد لقاؤك هنا يا هو-ني

148
00:12:52,850 --> 00:12:55,700
مـ-مهلاً يا هو-ني. إلى أين أنت ذاهبة؟

149
00:12:56,350 --> 00:12:57,440
سأعود

150
00:12:58,400 --> 00:13:00,410
.إلى تشو سوران

151
00:13:00,710 --> 00:13:03,590
كيف عرفت؟

152
00:13:04,880 --> 00:13:07,890
.أخبرتك يا يوكوغادوكو

153
00:13:08,630 --> 00:13:14,170
.تغيير مظهرك لا ينجح مع المعلّمين الحقيقيّين

154
00:13:14,870 --> 00:13:21,940
بالتّدريب الكافي، بدل رؤية
،مظهر المرء بالنّظر إليه

155
00:13:21,940 --> 00:13:25,740
.يمكنك أيضًا رؤية الكي بداخل جسمه

156
00:13:26,100 --> 00:13:30,690
حتّى وإن كنت قادرًا على اتّخاذ
،مظهر تشو سوران

157
00:13:31,090 --> 00:13:35,450
.لا يمكنك أن تزيف الكي خاصّته

158
00:13:36,370 --> 00:13:39,610
.لكنّني مندهش يا فتاة

159
00:13:39,990 --> 00:13:44,680
تحرّكاتك والكي الخاصّ بك تشبه
.الخاصّة بساحر أسطوريّ

160
00:14:03,400 --> 00:14:07,190
.لقد خلعت مفاصلها لتهرب من قبضتي

161
00:14:08,190 --> 00:14:12,600
.إنّها هادئة وغير متأثرّة بالهجمات القويّة

162
00:14:12,600 --> 00:14:14,950
.حركاتها دقيقة وفعّالة

163
00:14:15,950 --> 00:14:19,550
.إنّها جندي مدرّب بشكلّ جيّد

164
00:14:20,510 --> 00:14:22,500
.لا، لا

165
00:14:22,500 --> 00:14:25,670
ألم تسمع ما قلته قبل قليل؟

166
00:14:25,670 --> 00:14:27,750
.لهذا السّبب لا أحبّ الدّخلاء

167
00:14:28,690 --> 00:14:33,300
ينبغي أن يكون الأمر واضحًا
.بالنّظر إلى رفاقك المهزومين

168
00:14:33,300 --> 00:14:37,250
.لم تتدرّب من أجل قوّتها

169
00:14:37,250 --> 00:14:38,680
.بل وُلِدت بها

170
00:14:39,120 --> 00:14:41,060
.إنّها فطريّة

171
00:14:41,850 --> 00:14:44,550
.حقًّا؟ لنتراهن إذًا

172
00:14:45,150 --> 00:14:49,450
.إن فزت، سآخذ ذلك السّاكي الّذي تحبّه كثيرًا

173
00:14:52,130 --> 00:14:53,850
.لا بأس

174
00:14:53,850 --> 00:15:00,590
وإن فزت، سآخذ ذلك الويسكي
.الغالي الّذي تخبّئه

175
00:15:12,880 --> 00:15:15,720
ما الخطب؟ هل توقّفتما عن الهرب؟

176
00:15:17,270 --> 00:15:22,850
هل أنت واثق أنّ عليك ملاحقتنا كلّ
هذه المسافة يا ريكوكين-سينباي؟

177
00:15:23,460 --> 00:15:28,200
.ربّما يموت أولئك الأطفال الّذي تستخدمونهم الآن

178
00:15:29,230 --> 00:15:30,840
.لا تقلق بشأنهم

179
00:15:31,360 --> 00:15:34,490
.أعرف مدى قوّتهم

180
00:15:37,090 --> 00:15:42,490
كم رجلاً أحضرنا معنا برأيك؟

181
00:15:50,260 --> 00:15:52,380
!اقتلوهم

182
00:15:52,380 --> 00:15:54,970
!هذا هو اليوم الّذي نسقط في التّينشيفو

183
00:16:00,100 --> 00:16:02,180
!أوقفوهم بأيّة وسيلة

184
00:16:14,240 --> 00:16:17,280
ما الّذي يسعون إليه؟

185
00:16:22,280 --> 00:16:25,290
ما الّذي نسعى إليه؟

186
00:16:25,530 --> 00:16:32,250
لا أدري بشأن البقيّة، لكنّني أحبّ
.تحطيم ممتلكات الغير

187
00:16:32,250 --> 00:16:37,600
لا شيء أفضل من اللّحظة الّتي أدمّر
.فيها شيئًا دافع عنه شخص ما بيأس

188
00:16:38,110 --> 00:16:42,050
لا بدّ أنّ لهذا المبنى تاريخ طويل، صحيح؟

189
00:16:42,630 --> 00:16:43,470
!وغد

190
00:16:43,880 --> 00:16:46,750
.إنّه يستحق التّدمير

191
00:16:52,070 --> 00:16:53,570
مـ-ما الّذي يجري؟

192
00:17:01,330 --> 00:17:02,660
!إنّها شركة التّوصيل السّريع

193
00:17:03,250 --> 00:17:04,710
!لا تدعوهم يهربون

194
00:17:05,250 --> 00:17:07,070
!حثالة التّوصيل السّريع

195
00:17:07,320 --> 00:17:09,410
!سأواجهكم

196
00:17:12,150 --> 00:17:14,620
جو سان، كيف تجري الأمور عندك؟

197
00:17:15,150 --> 00:17:17,110
.إنّها سيّئة جدًّا

198
00:17:17,740 --> 00:17:20,040
.ليس من تسلّلوا إلى الجبل فحسب

199
00:17:20,480 --> 00:17:22,920
.لقد التقوا بمن كانوا في القاع

200
00:17:23,720 --> 00:17:28,050
وأنا أرى الكثير من الوجوه غير
.الموجودة في قاعدة بياناتنا

201
00:17:28,650 --> 00:17:33,330
يبدو أنّ زينسي جمعت الكثير من الأعضاء
.خلال السّنوات القليلة الماضية

202
00:17:33,330 --> 00:17:34,490
.تبًّا

203
00:17:34,490 --> 00:17:39,130
،أحضرنا عددًا من الرّجال أيضًا
.لكن بالكاد يمكننا تولّي أمرهم

204
00:17:39,620 --> 00:17:41,520
.علينا الاتّصال بهوهو في الحال

205
00:17:42,490 --> 00:17:44,650
.يساورني شعور سيّئ حيال الأمر

206
00:17:50,760 --> 00:17:52,310
.إنّها لا تجيب

207
00:17:54,080 --> 00:17:55,680
.ابقوا هنا

208
00:17:55,680 --> 00:17:57,220
.ابقوا متيقّظين

209
00:17:57,220 --> 00:17:57,960
.حاضر

210
00:17:59,070 --> 00:18:01,940
.لا أصدّق أنّنا أخطأنا

211
00:18:01,940 --> 00:18:04,210
،إنّهم لا يسعون خلف التسوتينروكو

212
00:18:04,650 --> 00:18:06,990
ما هو مسعاهم؟

213
00:18:07,720 --> 00:18:11,430
تبًّا. لمَ يساورني هذا الشّعور السّيّئ؟

214
00:18:21,800 --> 00:18:24,230
ما الّذي يجري يا جو سان-سان؟

215
00:18:24,750 --> 00:18:28,660
هل كانت هنا فتاة واقفة أمام ذلك الباب؟

216
00:18:30,750 --> 00:18:33,040
.فو هوهو، الفتاة الّتي كانت معنا

217
00:18:33,650 --> 00:18:35,430
فو هوهو؟

218
00:18:35,430 --> 00:18:38,210
.لم تكن هنا عندما وصلنا

219
00:18:40,440 --> 00:18:43,700
.جو يون، أرسل رجالاً إلى هنا في الحال

220
00:18:43,700 --> 00:18:45,090
.هوهو مفقودة

221
00:18:45,860 --> 00:18:46,910
.تبًّا

222
00:18:47,660 --> 00:18:51,400
.ادخلا بسرع واشرحا الوضع للتّينشي

223
00:18:51,400 --> 00:18:53,020
.توقّف

224
00:18:54,500 --> 00:18:56,030
ماذا تظنّان نفسيكما فاعلين؟

225
00:18:56,030 --> 00:18:58,860
هل أنتما جاسوسان لزينسي؟

226
00:18:59,220 --> 00:19:02,000
.لا تسئ الفهم يا جو سان-سان

227
00:19:02,000 --> 00:19:06,030
ألا ترى ذلك النّور الذّهبيّ الّذي يخرج من النّوافذ؟

228
00:19:12,080 --> 00:19:14,730
.وما يحدث الآن ليس اضطرابًا بسيطًا

229
00:19:15,570 --> 00:19:18,160
.لا بدّ أنّ التّينشي قد لاحظه

230
00:19:19,540 --> 00:19:25,730
أيّ أنه مهما كان، فما يفعله
.التّينشي الآن أهمّ بكثير

231
00:19:26,150 --> 00:19:31,200
أنا آسف، لكن لا يمكننا السّماح لك
.بالدّخول ومقاطعته

232
00:19:53,660 --> 00:19:57,040
هل نجح الأمر هذه المرّة يا معلّمي؟

233
00:19:57,520 --> 00:20:00,650
.لا، فشل الأمر مجدّدًا

234
00:20:01,220 --> 00:20:03,640
.هذه المرّة الثّالثة

235
00:20:03,640 --> 00:20:05,470
ما الّذي يجري؟

236
00:20:06,000 --> 00:20:10,140
.لا أظنّني ارتكبت أيّ خطأ

237
00:20:11,080 --> 00:20:15,970
.إن كانت هناك مشكلة ما، فهي أنت يا سوران

238
00:20:16,420 --> 00:20:23,510
إن كنت متردّدًا أو معارضًا لأسلوب
.التّينشي، فلا يمكنك تلقّيه

239
00:20:23,510 --> 00:20:25,490
.أظنّني أخبرتك بذلك

240
00:20:25,790 --> 00:20:30,120
ألا تريد أن تصبح التّينشي؟

241
00:20:30,500 --> 00:20:31,660
...معلّمي

242
00:20:32,290 --> 00:20:37,290
إن كنت تخشى أن تضطرّ للتّخلّي
على حياتك القديمة

243
00:20:37,290 --> 00:20:40,960
.بعد أن تصبح التّينشي، فلا تقلق

244
00:20:40,980 --> 00:20:44,730
.قوانين التّينشيفو ليست صارمة جدًّا

245
00:20:44,730 --> 00:20:48,040
.حتّى أنّك تستطيع الزّواج وإنجاب الأطفال

246
00:20:48,040 --> 00:20:52,180
.اللّحم والخمر والتّبغ ليست ممنوعة أيضًا

247
00:20:53,260 --> 00:20:56,190
،طالما أنت في الطّريق الصّحيح

248
00:20:56,190 --> 00:21:02,110
فلا قيمة للقوانين الّتي تتطلّب منك
.التّخلّي عن رغباتك لأسلوب شوتسو

249
00:21:02,950 --> 00:21:05,630
،إن كان العمل اليوميّ للتّينشيفو لا يهمّك

250
00:21:05,630 --> 00:21:09,150
فيمكنك أن تدع ريغيوكو
.أو الآخرين يتولّون أمره

251
00:21:09,550 --> 00:21:14,670
،المهمّ هنا هو أنّك بمجرّد أن تصبح التّينشي

252
00:21:14,670 --> 00:21:19,640
.لن يتمكّن أحد من لمسك

253
00:21:19,640 --> 00:21:24,290
.باستثناء المجرمين أمثال زينسي بالطّبع

254
00:21:24,580 --> 00:21:29,670
عليك أن تعرف أنّ هذه
.الرّاتن تايشو عُقِدت لأجلك

255
00:21:30,250 --> 00:21:33,900
فلمَ أنت متردّد الآن؟

256
00:21:34,840 --> 00:21:36,000
...معلّمي

257
00:21:37,650 --> 00:21:43,140
،إن أردتني أن أصبح التّينشي حقًّا
.فأريدك أن تجيبني على سؤال

258
00:21:43,890 --> 00:21:47,290
.وسؤالي لا علاقة له بحرب كوشين

259
00:23:19,000 --> 00:23:20,250
الحلقة القادمة

260
00:23:19,730 --> 00:23:23,630
،إن أردتني أن أصبح التّينشي حقًّا
.فأريدك أن تجيبني على سؤال

261
00:23:23,630 --> 00:23:26,730
.وسؤالي لا علاقة له بحرب كوشين

262
00:23:26,730 --> 00:23:29,270
.أكيد. سلني أيّ شيء

263
00:23:29,270 --> 00:23:31,970
ما هو الرّاتب الّذي سأحصل عليه
إن أصبحت التّينشي؟

264
00:23:31,970 --> 00:23:33,630
ما هي ساعات العمل؟
وما هي الفوائد الّتي أحصل عليها؟

265
00:23:33,630 --> 00:23:36,410
:"في الحلقة القادمة من "هيتوري نو شيتا
."جوني روجوجين"

266
00:23:36,410 --> 00:23:37,560
.لا تفوّتوها