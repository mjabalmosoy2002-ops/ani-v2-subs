1
00:00:06,630 --> 00:00:08,850
.هيّا بنا يا هو-ني

2
00:00:08,850 --> 00:00:10,010
.هلمّ إليّ

3
00:00:13,750 --> 00:00:16,530
!موتي يا فو هوهو

4
00:00:16,530 --> 00:00:21,680
!تشو سوران، سأسلبك حياتك

5
00:00:27,550 --> 00:00:29,800
!كلاّ

6
00:00:30,200 --> 00:00:32,990
.مذهل، تشو سوران مذهل

7
00:00:32,990 --> 00:00:35,580
...لقد خسرت. كلاّ

8
00:00:37,010 --> 00:00:39,180
!تشو سوران ضدّ فو هوهو

9
00:00:40,200 --> 00:00:42,630
!الفائز هو تشو سوران

10
00:00:42,630 --> 00:00:47,360
كيف لنا أن نبقى صامتين بعد هذه المهزلة؟

11
00:00:47,360 --> 00:00:50,310
!يا لوقاحتك

12
00:00:53,300 --> 00:00:56,610
.لا أصدّق أنّهم اكتشفوا تمثيليّتنا المتقنة

13
00:00:56,610 --> 00:00:58,530
كيف لذلك أن يكون متقنًا؟

14
00:00:58,530 --> 00:01:01,580
!سُحقًا! لقد أفسدتِ أدائي المذهل

15
00:01:02,100 --> 00:01:03,730
.انتهى الأمر

16
00:01:03,730 --> 00:01:07,150
...لقد أُفسدت سمعة شركتنا

17
00:01:08,070 --> 00:01:12,770
.لم تكن سمعتنا بتلك الجودة من البداية

18
00:01:12,770 --> 00:01:14,200
...على أيّ حال

19
00:01:14,750 --> 00:01:19,360
.لا أصدّق أنّ سوران وصل للنّهائيّ بالفعل

20
00:03:01,210 --> 00:03:02,870
...البرد قارس

21
00:03:01,820 --> 00:03:15,540
!تُنشر مانغا "هيتوري نو شيتا: المنبوذ" في شونين جامب+ الآن

22
00:03:03,380 --> 00:03:06,660
.لا ينبغي أن يجدونا هنا

23
00:03:08,170 --> 00:03:11,440
.لم يكن لديهم سبب ليغضبوا إلى تلك الدّرجة

24
00:03:11,440 --> 00:03:12,730
.تشو سوران

25
00:03:14,400 --> 00:03:17,770
.عليك أن تفوز في مباراة الغد

26
00:03:20,590 --> 00:03:21,860
.هو-ني

27
00:03:22,660 --> 00:03:26,150
...نحن لا نعرف بعضنا منذ وقت طويل

28
00:03:31,280 --> 00:03:36,940
.لكنّني لم أتوقّع أبدًا أن أسمع هذا منك

29
00:03:37,900 --> 00:03:39,800
هل حدث شيء ما؟

30
00:03:40,930 --> 00:03:41,940
...نعم

31
00:03:46,430 --> 00:03:51,370
.لم أعد أعرف ما عليّ فعله

32
00:03:51,900 --> 00:03:55,720
...الأمر مثل، ما في الأمر

33
00:03:55,720 --> 00:03:59,220
...في الواقع

34
00:04:00,480 --> 00:04:02,420
.لا يمكنني صياغة  الأمر بالكلمات

35
00:04:03,370 --> 00:04:05,770
.تقصدين أنّك لا تنتمين لمكان محدّد

36
00:04:07,280 --> 00:04:08,060
.نعم

37
00:04:08,470 --> 00:04:09,720
.هذا ما في الأمر

38
00:04:10,310 --> 00:04:14,000
.فكّرت كثيرًا، لكنّني لم أستطع أن أجد الكلمات

39
00:04:14,000 --> 00:04:15,440
.أنت مذهل

40
00:04:16,200 --> 00:04:19,430
.هذا صحيح. الجميع مذهلون

41
00:04:19,430 --> 00:04:23,300
.لا أملك مكانًا أنتمي إليه، لكنّ الجميع لديهم

42
00:04:23,900 --> 00:04:25,780
،جو سان وجو يون

43
00:04:25,780 --> 00:04:30,410
تلك المرأة الغريبة ذات الشّعر الأبيض الّتي
...تفتعل قتالات معي دائمًا والنّاسك الغريب

44
00:04:30,410 --> 00:04:34,760
.جميع من التقيت مذهلون أكثر منّي

45
00:04:35,310 --> 00:04:37,740
يعرفون ما عليهم فعله

46
00:04:38,130 --> 00:04:40,500
.وإلى أين عليهم الذّهاب

47
00:04:41,700 --> 00:04:43,950
.وأين يعودون

48
00:04:53,790 --> 00:04:57,960
.سأنتقم لشينتون يا أبي

49
00:04:57,960 --> 00:04:58,680
.ساين

50
00:05:00,480 --> 00:05:01,740
.انسي الأمر

51
00:05:02,300 --> 00:05:04,310
.انتهت معركتك

52
00:05:04,870 --> 00:05:06,280
.أحسنت عملاً

53
00:05:06,750 --> 00:05:08,400
.عليك أن تستريحي

54
00:05:17,080 --> 00:05:19,950
هل أخوك بخير؟

55
00:05:21,770 --> 00:05:23,100
ساين-سان؟

56
00:05:28,160 --> 00:05:29,130
!مهلاً

57
00:05:29,130 --> 00:05:31,180
ما خطبك؟

58
00:05:31,180 --> 00:05:32,590
إلى أين سنذهب؟

59
00:05:32,590 --> 00:05:34,110
.تعال معي

60
00:05:33,320 --> 00:05:34,340
!مهلاً

61
00:05:37,490 --> 00:05:39,280
.أحضرت لك بعض الماء

62
00:05:38,450 --> 00:05:40,010
!تبًّا

63
00:05:40,010 --> 00:05:41,640
!أنا آسفة

64
00:05:41,640 --> 00:05:45,370
ما خطب كوري كينشو الخاصّة بعائلة فو؟

65
00:05:45,370 --> 00:05:48,270
!لا حول لنا أمامها

66
00:05:48,270 --> 00:05:49,600
!تبًّا

67
00:05:49,600 --> 00:05:52,490
.ربّما علينا التّحدّث إلى جدّتنا

68
00:05:52,490 --> 00:05:53,950
ماذا؟ جدّتنا؟

69
00:05:53,950 --> 00:05:58,190
.بقيت بعيدة عن هذه الرّاتن تايشو

70
00:05:58,190 --> 00:06:00,720
.بقيت في منزلها طوال هذا الوقت

71
00:06:01,290 --> 00:06:03,000
،بالتّفكير بالأمر

72
00:06:03,000 --> 00:06:08,810
توقّفت عن الظّهور علنًا بعد
،أن أصبح فو تشونهاو شيخًا

73
00:06:09,310 --> 00:06:12,250
.كما لو أنّها استقالت من الشّيوخ العشرة

74
00:06:13,230 --> 00:06:16,330
.لا بدّ أنّها تعرف شيئًا

75
00:06:18,370 --> 00:06:22,390
.نعم يا سيدتي. كان المجيء إلى هنا يستحقّ العناء

76
00:06:22,830 --> 00:06:27,020
.علينا أن نراقب فو هوهو عن كثب بالتّأكيد

77
00:06:27,400 --> 00:06:32,690
حصلنا على معلومات كثيرة تخصّها
من التّحدّث إليها مباشرة

78
00:06:32,690 --> 00:06:35,580
.وإلى بقيّة أعضاء شركة التّوصيل السّريع

79
00:06:35,580 --> 00:06:39,600
.كما أنّنا استطعنا أخذ شعرة من شعراتها بعد مباراتها

80
00:06:41,230 --> 00:06:46,550
لكن من أين حصلت على المعلومات عن فو هوهو؟

81
00:06:48,710 --> 00:06:51,110
.لا يمكنني إخبارك بعد

82
00:06:51,110 --> 00:06:56,690
.كلّ ما عليكم فعله هو الصّمت واتّباع أوامري

83
00:06:58,970 --> 00:07:01,840
.أجل. آسف أيّها المعلّم الكبير

84
00:07:01,840 --> 00:07:04,680
.استعملت فوكو كيمون خلال إحدى المباريات

85
00:07:05,330 --> 00:07:07,360
.كنت أواجه خصمًا قويًّا

86
00:07:07,360 --> 00:07:09,740
.كان ليهزمني لو لم أستخدمها

87
00:07:10,580 --> 00:07:12,440
.لا بدّ أنّه القدر

88
00:07:12,960 --> 00:07:16,730
.لكنّني تمكّنت من الدّفاع عن شرف التّينشي

89
00:07:17,860 --> 00:07:22,460
.أجل. آسف للمتاعب الّتي سببتها لبوتوسان

90
00:07:30,960 --> 00:07:32,350
.أويا-دونو

91
00:07:35,000 --> 00:07:38,310
هل ستغادران الآن؟

92
00:07:38,310 --> 00:07:39,320
.نعم

93
00:07:39,320 --> 00:07:44,080
هاكو-تشان، حاول العمل على شجاعتك
بمجرّد وصولك للبيت، اتّفقنا؟

94
00:07:44,080 --> 00:07:47,160
.كي لا تجبن إن قاتلت شخصًا مخيفًا

95
00:07:47,160 --> 00:07:50,040
!اخرس! لا شيء يخيفني

96
00:07:50,970 --> 00:07:53,500
أويا-دونو، ستغادر اليوم أنت أيضًا، أليس كذلك؟

97
00:07:53,500 --> 00:07:56,500
لِم لا تأتي معنا إلى المطار؟

98
00:07:56,500 --> 00:08:00,700
.أتمنّى لو استطعت، لكنّني سأستقلّ القطار

99
00:08:00,700 --> 00:08:03,140
.أنا مفلس تمامًا الآن

100
00:08:04,810 --> 00:08:06,430
.للأسف

101
00:08:06,430 --> 00:08:09,880
كنت أودّ أن أطرح عليك الكثير
.من الأسئلة في طريق العودة

102
00:08:10,250 --> 00:08:12,960
.في تلك الحالة، سأغادر الآن

103
00:08:12,960 --> 00:08:14,590
.حسنًا. اعتنيا بنفسيكما

104
00:08:16,420 --> 00:08:18,170
...بالمناسبة يا أويا-دونو

105
00:08:18,640 --> 00:08:21,270
.كان لديّ شيء أخبرك به

106
00:08:22,240 --> 00:08:27,850
.أعطيتَ خيارًا لتشو سوران واتّخذ قراره

107
00:08:27,850 --> 00:08:35,060
ألم يكن مجيئك إلى ريوكوسان
وإعطاؤه الخيار قرارك؟

108
00:08:35,060 --> 00:08:39,360
!استعملت تعويذة للتّلصّص

109
00:08:39,980 --> 00:08:44,470
.كان قرارك. لا فائدة من النّدم عليه الآن

110
00:08:44,470 --> 00:08:46,880
.حاول ألاّ تقلق حيال الأمر كثيرًا

111
00:08:46,880 --> 00:08:48,870
!اهتمّ بشؤونك

112
00:08:48,870 --> 00:08:52,880
،لا أستمتع بالتّورّط في المسائل المعقّدة

113
00:08:52,880 --> 00:08:56,210
.لكنّني سأساعدك إن كنت في ورطة

114
00:08:56,610 --> 00:09:02,020
لن أتمادى لدرجة المجازفة بحياتي من
.أجلك، لكنّني سأبذل ما في وسعي

115
00:09:03,020 --> 00:09:05,890
من قد يطلب منك المساعدة أساسًا؟

116
00:09:05,890 --> 00:09:10,550
،أردت أن أكون شخصيّة غامضة
!لكن لا يمكنني إخفاء شيء بوجودك

117
00:09:12,600 --> 00:09:15,090
.سأزور بوتوسان قريبًا

118
00:09:15,090 --> 00:09:16,100
.تبّا لك

119
00:09:17,290 --> 00:09:19,320
.يا له من شخص غريب

120
00:09:27,830 --> 00:09:30,070
بوتوسان؟

121
00:09:37,640 --> 00:09:41,790
...المعلّم الكبير، معلّمي، جميع من في بوتوسان

122
00:09:42,370 --> 00:09:44,290
.شكرًا لكم على كلّ شيء

123
00:09:47,370 --> 00:09:48,930
،مثل ذلك الطّائر

124
00:09:50,150 --> 00:09:56,010
لو عرفت من أين أتيت، سأعرف
.إلى أين عليّ الذّهاب

125
00:09:56,580 --> 00:09:58,690
تريدين مكانًا تعودين إليه؟

126
00:09:59,350 --> 00:10:04,360
.أنت مذهل. أنت تعرف كلّ ما أفكّر به

127
00:10:06,600 --> 00:10:08,660
.بالطّبع

128
00:10:09,920 --> 00:10:13,120
.فأنا أيضًا لا أملك مكانًا أعود إليه

129
00:10:15,000 --> 00:10:16,580
.تعال يا ريغيوكو

130
00:10:16,580 --> 00:10:20,200
.عليك أن تتناول فطورًا لائقًا للاستعداد للنّهائيّ

131
00:10:20,200 --> 00:10:22,010
.نعم يا معلّمي

132
00:10:26,870 --> 00:10:28,260
.ريغيوكو

133
00:10:28,810 --> 00:10:34,100
.ورّطت العديد في هذا من أجل تشو سوران

134
00:10:34,100 --> 00:10:36,390
ألن تلومني؟

135
00:10:36,390 --> 00:10:37,510
.بالطّبع لا

136
00:10:37,510 --> 00:10:40,740
.ما كنت لألومك أبدًا يا معلّمي

137
00:10:41,190 --> 00:10:46,220
ما كنت لتفعل؟ أم أنّك لا تستطيع؟

138
00:10:46,940 --> 00:10:50,210
.أريد أن أعرف شعورك الحقيقيّ

139
00:10:54,970 --> 00:11:00,040
،معلّمي، صحيح أنّني مدين لك بالكثير

140
00:11:00,040 --> 00:11:05,610
.لكنّ ذلك ليس سبب احترامي لك الوحيد

141
00:11:06,010 --> 00:11:09,230
...سلوكك، انضباطك، روحك

142
00:11:09,800 --> 00:11:16,120
أنت معلّم يستحقّ أن أكرّس حياتي له
.من جميع الجوانب

143
00:11:16,810 --> 00:11:21,990
،إن كان هناك شيء لا يمكنك إخباري به
.فلا بدّ من وجود سبب

144
00:11:22,550 --> 00:11:25,910
.ما كنت لألومك أبدًا

145
00:11:28,900 --> 00:11:30,940
حتّى وإن فعلت هذا؟

146
00:11:30,940 --> 00:11:32,660
...أنا

147
00:11:33,450 --> 00:11:40,340
،أنت حقًّا مثاليّ ومن دون عيوب
.لكنّك جادّ أكثر من اللاّزم قليلاً

148
00:11:40,340 --> 00:11:41,840
.لكن لا يهمّ

149
00:11:41,840 --> 00:11:45,510
.اطمأنّ قلبي بعد أن سمعت ذلك

150
00:11:46,280 --> 00:11:52,060
لِمَ لا أعطيك نصيحة قبل مباراتك؟

151
00:11:52,430 --> 00:11:53,820
.اسمع جيّدًا

152
00:11:53,820 --> 00:11:57,670
.اذهب واهزم تشو سوران هزيمة نكراء

153
00:11:57,670 --> 00:12:00,100
.لا تقلق بشأني

154
00:12:02,010 --> 00:12:03,800
!أيّها المعلّم! ريغيوكو

155
00:12:07,260 --> 00:12:11,500
!صباح الخير يا معلّم ويا ريغيوكو-ساما

156
00:12:12,120 --> 00:12:13,210
.نعم

157
00:12:13,860 --> 00:12:18,000
أيّها المعلّم، هناك شيء نريد
.مناقشته مع ريغيوكو-ساما

158
00:12:18,000 --> 00:12:19,500
أيمكننا ذلك؟

159
00:12:19,880 --> 00:12:22,360
.أكيد. افعلوا ما تريدون

160
00:12:22,360 --> 00:12:24,440
ما الأمر يا سينباي؟

161
00:12:24,960 --> 00:12:27,000
.تعال معي فحسب

162
00:12:28,080 --> 00:12:31,060
ما الّذي أردت مناقشته؟

163
00:12:32,440 --> 00:12:33,650
...اسمع

164
00:12:34,010 --> 00:12:37,550
.اخسر أمام تشو سوران وستندم

165
00:12:37,550 --> 00:12:38,820
...حسنًا

166
00:12:38,820 --> 00:12:40,340
!لا تقل لي حسنًا

167
00:12:40,340 --> 00:12:44,700
إن فاز ذلك الفتى الوقح بمنصب
!التّينشي، فسينتهي أمر التّينشيفو

168
00:12:47,110 --> 00:12:48,780
.اسمع يا ريغيوكو

169
00:12:48,780 --> 00:12:51,820
.سأغادر ريوكوسان إن خسرت

170
00:12:51,820 --> 00:12:54,500
.سيتوجّب عليك الاعتناء بالتّينشي

171
00:12:54,500 --> 00:12:56,290
!اهزم تشو سوران

172
00:12:55,290 --> 00:12:57,500
.قاتل وكأنّ حياتك تعتمد على ذلك

173
00:12:56,290 --> 00:12:58,570
!يجب أن يفوز ريغيوكو

174
00:12:58,960 --> 00:13:00,790
!اهزم تشو سوران

175
00:13:00,790 --> 00:13:02,840
!يجب أن يفوز ريغيوكو

176
00:13:03,480 --> 00:13:05,560
!اهزم تشو سوران

177
00:13:05,560 --> 00:13:07,600
!يجب أن يفوز ريغيوكو

178
00:13:33,730 --> 00:13:36,150
!مباراة راتن تايشو النّهائيّة

179
00:13:36,150 --> 00:13:39,000
!تشو ريغيوكو ضدّ تشو سوران

180
00:13:39,720 --> 00:13:40,800
.اقترب الوقت

181
00:13:40,800 --> 00:13:42,160
.إنّه ريغيوكو-ساما

182
00:13:42,160 --> 00:13:43,170
!نحن نعتمد عليك

183
00:13:43,170 --> 00:13:44,250
!ريغيوكو-ساما

184
00:13:44,250 --> 00:13:46,030
!الفوز لك يا ريغيوكو-ساما

185
00:13:46,630 --> 00:13:48,410
!اهزم تشو سوران

186
00:13:54,680 --> 00:13:55,510
!نل منه

187
00:13:58,760 --> 00:14:01,430
!فليبدأ النّهائيّ

188
00:14:05,400 --> 00:14:09,490
...تينتشي غينشو

189
00:14:09,730 --> 00:14:11,380
...بانكي كونغين

190
00:14:11,380 --> 00:14:15,280
.أنزل النّظام على الكارثة وأظهر قوّتي الإلهيّة

191
00:14:15,680 --> 00:14:17,480
...سانغاي ناغاي

192
00:14:17,480 --> 00:14:19,180
...يويدو دوكسون

193
00:14:19,180 --> 00:14:20,730
...تايناي كينكو

194
00:14:21,120 --> 00:14:22,960
.احمني

195
00:14:40,470 --> 00:14:42,780
.تشو سوران يقاتل بشكل جيّد

196
00:14:43,550 --> 00:14:48,050
واضحٌ أنّ الكينكوجو الخاصّ بتشو سوران
.أضعف من الخاصّ بريغيوكو

197
00:14:48,610 --> 00:14:50,190
،لكن مع ذلك

198
00:14:50,640 --> 00:14:55,830
بتركيز الكينكو الخاصّ به في نقطة
،واحدة في لحظة هجومه أو دفاعه

199
00:15:00,530 --> 00:15:03,620
.لكنّها ليست تقنية حنيفة

200
00:15:08,000 --> 00:15:10,020
.ضرباته قويّة جدًّا

201
00:15:10,020 --> 00:15:11,740
.سيهزمني على هذا المنوال

202
00:15:23,140 --> 00:15:26,410
،تشو سوران، في شهر واحد

203
00:15:26,410 --> 00:15:30,740
أصبحت قويًّا ما يكفي لتبقى واقفًا بعد
.تلقّيك لضربة من الكينكوجو خاصّتي

204
00:15:31,070 --> 00:15:35,280
.كما أنّك تتحرّك كشخصٍ مختلف

205
00:15:35,280 --> 00:15:38,770
.ربّما لديك الموهبة بالفعل

206
00:15:39,810 --> 00:15:41,360
.هذا صحيح

207
00:15:41,880 --> 00:15:45,000
.ريغيوكو-ساما، أنت قويّ حقًّا

208
00:15:45,000 --> 00:15:52,090
لكنّ الشّخص الّذي ساعدني في التّدرّب
.الشّهر المنصرم أقوى منك

209
00:15:53,770 --> 00:15:57,070
.قمت حقًّا بتطوير تقنيتك القتاليّة

210
00:15:57,850 --> 00:16:01,490
.سأجرّب هذا الآن

211
00:16:01,940 --> 00:16:05,100
.لنرَ إلى أيّ مدى تطوّرت رايهو خاصّتك

212
00:16:07,480 --> 00:16:09,150
!إينغورايهو

213
00:16:09,150 --> 00:16:10,680
!يوغورايهو

214
00:16:11,110 --> 00:16:12,390
!شوشينراي

215
00:16:33,890 --> 00:16:37,710
لا أصدّق أنّه تطوّر إلى هذه الدّرجة
.في تلك الفترة الوجيزة

216
00:16:38,380 --> 00:16:41,930
.لا عجب أنّه لفت انتباه معلّمي

217
00:16:44,000 --> 00:16:45,520
...يوغوراي

218
00:16:45,520 --> 00:16:48,980
.ما زلت أحبّ هذا النّور

219
00:16:48,980 --> 00:16:52,510
...ذلك البريق الواضح الصّريح

220
00:16:53,010 --> 00:16:59,240
.تعطي نورًا واضحًا ولامعًا وبرّاقًا

221
00:16:59,240 --> 00:17:01,310
.إنّها يوغوراي

222
00:17:01,780 --> 00:17:06,390
ألا يزال ريغيوكو متعلّقًا بيوغوراي؟

223
00:17:06,390 --> 00:17:07,370
.نعم

224
00:17:08,020 --> 00:17:13,330
.ما زال غير قادرًا على تخطّي ذلك الحاجز

225
00:17:13,330 --> 00:17:18,420
يرفض بكلّ عناد استعمال الإينغوراي
.الخاصّة به في حضور الغير

226
00:17:18,970 --> 00:17:23,680
،مهما كانت صعوبة المعركة
.يحاول الفوز بشوشينراي فقط

227
00:17:24,130 --> 00:17:28,800
.لكنّ شوشينراي تقنية إيجابيّة

228
00:17:29,320 --> 00:17:33,900
بغضّ النّظر عن مدى حبّه للنّور
،الإيجابيّ الواضح الصّريح

229
00:17:33,900 --> 00:17:36,860
.يبقى السّلبيّ سلبيًّا

230
00:17:40,940 --> 00:17:42,580
.رايهو

231
00:17:42,580 --> 00:17:45,310
.تعرف أيضًا باسم غوراي سيهو

232
00:17:45,850 --> 00:17:51,680
،"تُكتب برموز تعني "الرّعود الخمسة
."إلاّ أنّها تعني في الواقع "الكي الخمسة

233
00:17:53,270 --> 00:17:59,090
.يولد النّاس بالكي في أجسادهم

234
00:17:59,090 --> 00:18:02,880
...يمكن أن ينقسم ذلك الكي إلى خمسة أنواع

235
00:18:03,290 --> 00:18:05,790
.شينكي، الّذي يحكم النّار

236
00:18:05,790 --> 00:18:08,390
.هايكي، الّذي يحكم المعادن

237
00:18:06,020 --> 00:18:18,160
هايكي

238
00:18:08,390 --> 00:18:11,250
.جينكي، الّذي يحكم الماء

239
00:18:11,250 --> 00:18:14,060
.كانكي، الّذي يحكم الخشب

240
00:18:14,060 --> 00:18:17,910
.وهيكي، الّذي يحكم الأرض

241
00:18:18,860 --> 00:18:25,840
تقنية دمج الكي الخمسة وإطلاقها
.كواحد تسمّى غوراي سيهو

242
00:18:26,740 --> 00:18:32,540
،وفي حالة الأفراد الأنقياء المحمودين
.يكون مليئًا بالحياة

243
00:18:32,540 --> 00:18:38,300
هايكي

244
00:18:33,030 --> 00:18:39,350
بين أنواع الكي الخمسة، يرشد شينكي
.هايكي، ما يطلق كي إيجابيّ

245
00:18:39,700 --> 00:18:41,530
.هذا هو اليوغوراي

246
00:18:41,530 --> 00:18:48,780
لكنّ أولئك الّذين تدنّسوا يفقدون
.الكي خاصّتهم ولا يمكنهم استعادته

247
00:18:48,780 --> 00:18:52,550
.ما يجعل تعلّم رايهو أمرًا صعبًا للغاية

248
00:18:52,550 --> 00:18:55,200
تعلّم أسلافنا عبر التّجارب

249
00:18:55,200 --> 00:18:57,960
،طريقة استعمال جينكي، نقيض الكي الإيجابي

250
00:18:57,960 --> 00:19:02,480
.لإرشاد كانكي، ما خلق رايهو يُحرّر كي سلبيًّا

251
00:19:03,220 --> 00:19:05,410
.هذا هو الإينغوراي

252
00:19:13,670 --> 00:19:15,530
ما هذا؟

253
00:19:15,530 --> 00:19:18,430
هل هي رايهو؟

254
00:19:18,430 --> 00:19:20,390
.إنّها مريبة نوعًا ما

255
00:19:20,750 --> 00:19:27,260
مع أنّه يبدو كالوحل، إلاّ أنّه بمجرّد
.تعلّم استعماله، يصبح مرنًا كالزّئبق

256
00:19:27,970 --> 00:19:32,410
.هذه هي هيئة الإينغوراي الحقيقيّة

257
00:19:36,260 --> 00:19:41,200
هل يؤلمك إظهار الإينغوراي
خاصّتك علنًا يا ريغيوكو؟

258
00:19:42,230 --> 00:19:46,740
.لكن تلك طبيعتك الحقيقيّة

259
00:19:47,920 --> 00:19:53,570
.تقبّل مظهرك البشع وقاتل دون خجل

260
00:20:23,650 --> 00:20:25,900
.هذه هي الإينغوراي الحقيقيّة

261
00:20:26,180 --> 00:20:28,410
.لمسها سيكون سيّئًا بالتّأكيد

262
00:20:28,410 --> 00:20:29,460
.تبًّا

263
00:20:29,460 --> 00:20:32,170
.إنّها في كلّ مكان. لا يوجد مفرّ

264
00:20:33,000 --> 00:20:34,450
!هوكيو سووين

265
00:20:41,500 --> 00:20:43,230
!كينكو غوشين

266
00:20:48,430 --> 00:20:50,310
...أشعر بالضّعف

267
00:20:51,500 --> 00:20:53,900
هل السّبب هو لمسي لهذا الكي الأسود؟

268
00:20:53,900 --> 00:20:56,320
.لا أصدّق أنّ الكينكو خاصّتي تعجز عن إيقافه

269
00:20:59,690 --> 00:21:01,070
!شوشينراي

270
00:21:16,710 --> 00:21:19,600
يبدو أنّك تفاديت ضربة مباشرة
.باستعمال شوشينراي

271
00:21:19,880 --> 00:21:21,020
...لكن

272
00:21:22,260 --> 00:21:28,190
لكنّ الّذين يلمسون هذه الإينغوراي
،تُكسر عظامهم وتُلوّث قلوبهم

273
00:21:28,190 --> 00:21:32,420
.وتُدَمّر أرواحهم

274
00:21:33,230 --> 00:21:38,110
:تشو سوران، هذه هي الإينغوراي الحقيقيّة

275
00:21:38,720 --> 00:21:40,770
.سويزوراي

276
00:23:22,960 --> 00:23:24,210
الحلقة القادمة

277
00:23:23,070 --> 00:23:26,380
سي-ني، ألا تشعر أنّنا نسينا شيئًا ما؟

278
00:23:26,380 --> 00:23:28,930
.أشعر أنّه لا ينبغي علينا المغادرة بعد

279
00:23:28,930 --> 00:23:31,020
...أشعر أنّنا فوّتنا شيئًا ما

280
00:23:31,020 --> 00:23:33,570
!مباراتي النّهائيّة ضدّ ريغيوكو-ساما

281
00:23:33,570 --> 00:23:35,170
!لقد نسينا

282
00:23:35,170 --> 00:23:37,680
."في الحلقة القادمة من هيتوري نو شيتا: "مقدام

283
00:23:37,680 --> 00:23:39,130
.لا تفوّتوها