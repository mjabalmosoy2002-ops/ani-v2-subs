1
00:01:38,450 --> 00:01:42,330
،اختار تشو سوران أن يشارك في الرّاتن تايشو

2
00:01:42,330 --> 00:01:45,410
.وهي بطولة لتحديد خليفة التّينشي

3
00:01:45,410 --> 00:01:48,410
.تدرّب بشدّة مع فو هوهو

4
00:01:48,410 --> 00:01:50,690
...هذا مؤلم

5
00:01:51,230 --> 00:01:52,910
!مهلاً يا هو-ني

6
00:01:52,910 --> 00:01:55,040
!تساهلي معي

7
00:01:55,040 --> 00:01:58,290
هل هذا حقًّا أفضل ما لديك؟

8
00:01:59,150 --> 00:02:02,800
.يسعى التّينشي الحاليّ لجعل سوران خليفة له

9
00:02:02,800 --> 00:02:05,760
.لكن في نفس الوقت، يخطّط الشّيوخ لإيقافه

10
00:02:06,290 --> 00:02:08,820
أعلن صديق التّينشي ريكوكين

11
00:02:08,820 --> 00:02:14,360
نيّته بمنح تقنيّة تسوتينروكو السّرّيّة
.الخاصّة به للفائز

12
00:02:14,980 --> 00:02:17,870
.كانت المشاكل تجتمع في الخفاء

13
00:02:18,530 --> 00:02:22,940
في تلك الأثناء، لاحظ جو سان وجو يون
من شركة التّوصيل السّريع

14
00:02:22,940 --> 00:02:27,820
تحرّكات مشبوهة من زينسي، وهي منظّمة تسعى
.خلف أسلوب كيتايغين الخاصّ بتشو سوران

15
00:02:28,620 --> 00:02:32,080
قاموا بغسل دماغ كوكيتسو من توغوسو سرًّا

16
00:02:32,080 --> 00:02:35,230
.وخطّطوا لإرساله إلى الرّاتن تايشو

17
00:02:41,280 --> 00:02:43,340
،حيث التقى بأويا من بوتوسان

18
00:02:43,920 --> 00:02:46,420
،وسليل شوكاتسو كومي، شوكاتسو سي

19
00:02:46,420 --> 00:02:49,910
.ودخلاء آخرين من جميع أنحاء العالم

20
00:02:56,570 --> 00:03:00,360
.ستبدأ بطولة الاختيار الآن

21
00:03:02,810 --> 00:03:08,560
هزم المرشّح بالفوز تشو ريغيوكو
.خصومه بقوّة غامرة

22
00:03:09,590 --> 00:03:12,290
.تخطّت هوهو معركتها الأولى بكلّ سهولة

23
00:03:12,820 --> 00:03:17,540
...والآن، معركة سوران على وشك أن تبدأ

24
00:03:18,010 --> 00:03:19,000
.ها قد أتى

25
00:03:23,150 --> 00:03:26,330
،ثلاثون سنة شرق النّهر

26
00:03:27,070 --> 00:03:30,180
.ثلاثون سنة غرب النّهر

27
00:03:30,980 --> 00:03:33,510
.للحياة حلوها ومرّها

28
00:03:35,070 --> 00:03:38,960
.حان الآن وقت الانتقام لجدّي

29
00:03:40,470 --> 00:03:46,120
:أنا وريث فنون أسلوب كيتايغين السّرّيّة

30
00:03:47,160 --> 00:03:48,370
!تشو سوران

31
00:04:10,330 --> 00:04:13,980
.كما هو مُتوقّع من وريث أسلوب كيتايغين

32
00:04:13,980 --> 00:04:16,060
.حضوره غامر

33
00:04:16,060 --> 00:04:18,040
ينتقم لجدّه؟

34
00:04:18,040 --> 00:04:19,220
ما الّذي يتحدّث عنه؟

35
00:04:19,530 --> 00:04:22,190
وما خطب هذه السّحب؟

36
00:04:33,260 --> 00:04:37,460
تشو سوران، جميع الدّخلاء يتحدّثون
.عن أسلوب كيتايغين الخاصّ بك

37
00:04:37,460 --> 00:04:40,060
.أرنا ما يمكن لقوّتك فعله

38
00:04:40,060 --> 00:04:41,940
.لا يمكنك لومنا على القتال ثلاثة ضدّ واحد

39
00:04:44,470 --> 00:04:46,560
ثلاثة ضدّ واحد؟

40
00:04:50,810 --> 00:04:52,260
ما المضحك في الأمر؟

41
00:04:52,850 --> 00:04:57,560
ثلاثة مبتدئين مثلكم يتحدّون
أسلوب كيتايغين خاصّتي؟

42
00:04:57,560 --> 00:04:58,600
.يا لها من مزحة

43
00:04:59,360 --> 00:05:02,590
الحشرات الّتي تختار التّعاون معًا ضدّي

44
00:05:02,590 --> 00:05:05,360
.لا تستحقّ تحدّي أسلوب كيتايغين

45
00:05:05,360 --> 00:05:07,090
حشرات؟

46
00:05:07,090 --> 00:05:11,250
نعم. الخصوم الوحيدون الجديرون
.بالنّسبة لي هم الشّيوخ العشرة

47
00:05:11,580 --> 00:05:13,860
.أعظم محاربي العالم

48
00:05:14,840 --> 00:05:15,850
!نعم

49
00:05:15,850 --> 00:05:21,630
!سأهزم كلّ محارب قويّ تحت هذه السّماء

50
00:05:23,590 --> 00:05:25,870
.إنّه واثق جدًّا

51
00:05:25,870 --> 00:05:28,140
.تحدّى الشّيوخ العشرة أيضًا

52
00:05:28,510 --> 00:05:31,630
.على أيّة حال، يمكننا نحن الثّلاثة أن نهزمه

53
00:05:31,630 --> 00:05:33,530
.فلننهِ هذا الأمر بسرعة

54
00:05:33,530 --> 00:05:34,210
.مهلاً

55
00:05:34,500 --> 00:05:36,120
.إنّه محقّ

56
00:05:36,120 --> 00:05:39,480
.علينا قتاله بشكلٍ عادل

57
00:05:39,480 --> 00:05:40,380
ماذا؟

58
00:05:40,910 --> 00:05:42,410
.شكرًا يا تشو سوران

59
00:05:42,830 --> 00:05:44,750
.لقد فتحت كلماتك عينيّ

60
00:05:45,220 --> 00:05:48,400
.لم آتي إلى هنا للفوز

61
00:05:48,400 --> 00:05:50,450
.أتيت لاختبار قوّتي

62
00:05:50,840 --> 00:05:53,260
.أريد أن أقاتلك بشكل عادل

63
00:05:54,790 --> 00:05:57,500
هل ستتحدّاني بمفردك إذًا؟

64
00:05:57,850 --> 00:05:59,850
و-وماذا في ذلك؟

65
00:06:02,650 --> 00:06:05,000
هل تظنّ أنّك قويّ بما يكفي لتتحدّاني؟

66
00:06:05,000 --> 00:06:05,950
.لا تضحكني

67
00:06:06,720 --> 00:06:09,050
ما الّذي تظنّ نفسك فاعلاً؟

68
00:06:09,860 --> 00:06:12,250
.لا تستخفّ بأسلوب كيتايغين

69
00:06:12,250 --> 00:06:16,480
،إن كنت تريد أن تتحدّاني
.فعليك أن تثبت جدارتك

70
00:06:16,910 --> 00:06:19,640
!أثبت قوّتك لي

71
00:06:21,940 --> 00:06:26,300
مَن مِن بينكم جدير بمواجهتي؟

72
00:06:26,580 --> 00:06:28,600
!أنا

73
00:06:38,280 --> 00:06:39,860
!نجح الأمر

74
00:06:41,560 --> 00:06:44,230
.لقد وقعوا ضحيّة لكلامه

75
00:06:44,230 --> 00:06:46,230
.إنّهم مجرّد حمقى

76
00:06:57,960 --> 00:06:59,730
أرأيت ذلك يا تشو سوران؟

77
00:06:59,730 --> 00:07:01,360
.أنا من سيتحدّاك

78
00:07:01,820 --> 00:07:06,800
سأحفر قوّة أسلوب كيتايغين
.الخاصّ بك في عينيّ

79
00:07:06,800 --> 00:07:08,140
.اجلس

80
00:07:09,160 --> 00:07:12,660
.تأمّل كي تهدّئ مشاعرك

81
00:07:12,660 --> 00:07:14,070
.سنقاتل بعضنا بعد ذلك

82
00:07:16,530 --> 00:07:20,200
.أريد قتالك وأنت في أفضل حالاتك

83
00:07:29,050 --> 00:07:30,890
.يا لك من رجل

84
00:07:31,400 --> 00:07:36,230
أنا فخور لأنّني سأتمكّن من قتال
.محارب مذهل مثلك

85
00:07:39,830 --> 00:07:41,570
...حسنًا إذًا

86
00:07:46,990 --> 00:07:50,430
مهلاً! ألا تملك أيّ كرامة كمحارب؟

87
00:07:50,430 --> 00:07:52,840
!الكرامة لا تساوي شيئًا

88
00:08:02,140 --> 00:08:04,140
!تشو سوران هو الفائز

89
00:08:05,120 --> 00:08:06,810
!أنت وقح

90
00:08:13,840 --> 00:08:15,210
.مرحبًا يا سوران

91
00:08:15,210 --> 00:08:17,810
.سمعت أنّك لجأت لخدع دنيئة للفوز

92
00:08:18,120 --> 00:08:19,450
.اضطررت لذلك

93
00:08:19,450 --> 00:08:21,050
.لا يمكنني قتال ثلاثة أشخاص في آن واحد

94
00:08:22,690 --> 00:08:24,980
.الفوز يبقى فوزًا

95
00:08:25,470 --> 00:08:29,140
لِمَ طلبت منّا المجيء إلى هنا على أيّة حال؟

96
00:08:29,950 --> 00:08:31,860
هل هذه مباراة هامّة؟

97
00:08:31,860 --> 00:08:36,280
.أجل. مباراة شوكاتسو سي على وشك أن تبدأ

98
00:08:36,280 --> 00:08:37,610
.عليك ألاّ تفوّتها

99
00:08:37,960 --> 00:08:41,750
هل شوكاتسو سي مذهل إلى هذا الحدّ؟

100
00:08:41,750 --> 00:08:44,430
.إنّه سليل شوكاتسو كومي

101
00:08:44,430 --> 00:08:46,660
.شئنا أم أبينا، لا بدّ أن يجذب الانتباه

102
00:08:46,660 --> 00:08:50,460
.لديّ اهتمام شخصيّ به أيضًا

103
00:08:50,820 --> 00:08:54,410
.عائلة شوكاتسو غامضة بالنّسبة للدّخلاء أيضًا

104
00:08:54,770 --> 00:08:59,050
.تمّ توارث أسلوب كيمونتونكو في عائلتهم لأجيال

105
00:08:59,050 --> 00:09:03,980
ويبدو أنّ شوكاتسو سي خبير يمارس
.جميع تقنيّات الأسلوب

106
00:09:05,620 --> 00:09:09,520
.ريغيوكو-ساما وحده صعب بما يكفي

107
00:09:09,520 --> 00:09:12,940
.ليسا الوحيدين

108
00:09:12,940 --> 00:09:16,180
.هذه البطولة مليئة بالمقاتلين الماهرين

109
00:09:16,860 --> 00:09:19,330
.هناك أوّلاً شوشو، مستخدم شينكي

110
00:09:21,540 --> 00:09:23,500
يشمل أسلوب الكونغ فو الخاصّ به إطلاق

111
00:09:23,500 --> 00:09:26,500
الكي الّذي بداخله لاقتلاع أرواح
.خصومه من أجسادهم

112
00:09:27,170 --> 00:09:29,630
،قيل أنّ إيرين وتشينكي طوّراها

113
00:09:29,630 --> 00:09:32,340
.معروفة أيضًا بكونغوريكيشي في البوذيّة

114
00:09:33,060 --> 00:09:36,560
.إصابةٌ واحدةٌ وستتحوّل إلى قشرة لا حول لها

115
00:09:36,560 --> 00:09:38,700
.لن تتمكّن من القتال

116
00:09:39,730 --> 00:09:42,670
.احترس من هاكو شيشي أيضًا

117
00:09:43,470 --> 00:09:45,660
.إنّها دخيلة بالفطرة

118
00:09:46,470 --> 00:09:50,000
.لديها القوّة لابتلاع كي الخصوم

119
00:09:50,680 --> 00:09:54,340
،إن ابتلعت الكي الخاصّ بك
.فستُستنزف طاقتك وستنهار

120
00:09:55,150 --> 00:09:59,380
.وهناك أيضًا كوكيتسو من توغوسو

121
00:10:00,990 --> 00:10:03,370
،سمعت أنّه كان يتسكّع بدل التّدريب

122
00:10:03,950 --> 00:10:05,870
.لكن هناك خطب ما به

123
00:10:07,450 --> 00:10:14,660
أردت الكي الخاصّ بك، لكن يبدو
.أنّني سأخسر إن قتلتك

124
00:10:15,160 --> 00:10:18,150
...بدأت أقلق حيال مسار الأمور

125
00:10:19,340 --> 00:10:20,340
.حسنًا

126
00:10:20,340 --> 00:10:22,510
.سأدفن هاكو شيشي هنا

127
00:10:23,580 --> 00:10:27,600
هو-ني، كم شخصًا تخطّطين لدفنه؟

128
00:10:27,600 --> 00:10:28,640
.جميعهم

129
00:10:29,070 --> 00:10:33,040
!ستبدأ مباراة الطّائر القرمزيّ الثّالث الآن

130
00:10:35,220 --> 00:10:36,130
.ها هم قادمون

131
00:10:46,690 --> 00:10:49,420
.يبدو أنّنا جميعًا متّفقون بالفعل

132
00:10:49,820 --> 00:10:51,760
هل نبدأ إذًا؟

133
00:11:02,800 --> 00:11:04,770
هل سيستعملون تقنيّاتهم الخاصّة من البداية؟

134
00:11:12,940 --> 00:11:15,560
.لقد شغّل شيئًا ما

135
00:11:16,180 --> 00:11:21,330
سأدعهما يقاتلان عن قرب بينما
.أستعمل أسلحة بعيدة المدى

136
00:11:32,070 --> 00:11:34,270
.تبًّا. إنّه يواصل التّحرك

137
00:11:35,310 --> 00:11:37,000
.أنت يا مستخدم الرّياح

138
00:11:37,000 --> 00:11:41,500
مهما فعل، لن يستطيع اختراق
.الكونغو أورين خاصّتي

139
00:11:41,790 --> 00:11:43,800
.سأهاجمه مباشرة. ادعمني برياحك

140
00:11:43,800 --> 00:11:44,340
.مفهوم

141
00:11:47,090 --> 00:11:48,710
!ريبّورين

142
00:11:52,180 --> 00:11:53,430
!الآن

143
00:11:58,560 --> 00:11:59,270
ماذا؟

144
00:12:01,030 --> 00:12:03,290
.يبدو ذلك مثل كيمونتونكو

145
00:12:03,290 --> 00:12:06,400
.أجل. لقد سحبتهم تقنيّته بالكامل

146
00:12:10,450 --> 00:12:15,480
مستحيل. كيف تمكّن من توقّع جميع هجماتنا؟

147
00:12:15,480 --> 00:12:17,740
لست محظوظًا، أليس كذلك؟

148
00:12:17,740 --> 00:12:22,520
.لو لم تكن هناك، لما أصابك سلاحه

149
00:12:23,170 --> 00:12:26,090
ماذا ستفعل؟ هل تريد متابعة القتال؟

150
00:12:26,330 --> 00:12:29,220
.أظنّ أن عليك إجراء فحصٍ قريبًا

151
00:12:29,220 --> 00:12:32,340
!تفاديت هجومي مرّة أيّها التّانوكي

152
00:12:32,340 --> 00:12:34,390
!لكنّني لن أخطئ هذه المرّة

153
00:12:39,520 --> 00:12:41,030
!ريبّو رانبي

154
00:12:44,190 --> 00:12:46,230
.ما كان عليك فعل ذلك

155
00:12:55,790 --> 00:12:57,590
مـ-ماذا حدث؟

156
00:12:58,420 --> 00:13:00,640
.لقد رمى به بعيدًا حقًّا

157
00:13:01,210 --> 00:13:04,020
هل فعل ذلك لنفسه؟

158
00:13:10,080 --> 00:13:11,350
ماذا ستفعل؟

159
00:13:17,250 --> 00:13:18,750
.أستسلم

160
00:13:19,980 --> 00:13:21,600
!انتهت المباراة

161
00:13:21,600 --> 00:13:23,940
!الفائز هو شوكاتسو سي

162
00:13:30,600 --> 00:13:32,080
!حظًّا موفّقًا

163
00:13:30,980 --> 00:13:32,080
!سي-ساما

164
00:13:32,650 --> 00:13:33,750
!إنّه جذّاب

165
00:13:33,750 --> 00:13:35,120
!مثير جدًّا

166
00:13:37,010 --> 00:13:39,140
!حظًّا طيّبًا في مباراتك التّالية

167
00:13:41,020 --> 00:13:41,970
.هاكو

168
00:13:43,190 --> 00:13:45,910
ما الّذي تفعله هنا؟

169
00:13:45,910 --> 00:13:47,480
هل أنهيت مباراتك؟

170
00:13:48,990 --> 00:13:50,400
...سي-ني

171
00:13:50,400 --> 00:13:53,360
!لـ-لقد خسرت

172
00:13:54,760 --> 00:13:56,050
خسرت؟

173
00:13:56,640 --> 00:13:57,770
.هذا غير ممكن

174
00:13:58,030 --> 00:14:00,100
.كان ريغوكو في مجموعة أخرى

175
00:14:00,100 --> 00:14:02,330
.لا ينبغي لأحد أن يتمكّن من هزيمتك

176
00:14:02,330 --> 00:14:05,940
.كان وحش ريوتو، كينمو

177
00:14:05,940 --> 00:14:08,500
.لكن ينبغي أن تتمكّن من هزيمته

178
00:14:09,630 --> 00:14:11,380
!لا يمكنني

179
00:14:11,380 --> 00:14:14,650
.وجهه مخيف جدًّا

180
00:14:16,410 --> 00:14:17,330
.أنت

181
00:14:17,570 --> 00:14:20,190
!هل أنت أخ شوكاتسو سي؟

182
00:14:24,140 --> 00:14:29,150
.أردت تدمير ذلك الضّعيف، وليس هذا الصّغير

183
00:14:29,600 --> 00:14:30,740
.لكن لا يهمّ

184
00:14:31,210 --> 00:14:35,390
سأروّح عن نفسي بضرب هذا
.الطّفل بدلاً عن ذلك

185
00:14:35,390 --> 00:14:39,180
!لـ-لكنّني لم أفعل شيئًا خاطئًا

186
00:14:39,180 --> 00:14:40,660
!اخرس

187
00:14:41,150 --> 00:14:44,550
.خفت لدرجة أنّ عقلي أصبح فارغًا من الدّاخل

188
00:14:44,980 --> 00:14:48,620
.نسيت كلّ الكونغ فو الّذي تعلّمته

189
00:14:48,620 --> 00:14:51,220
.لم أستطع فعل شيء أمامه

190
00:14:51,680 --> 00:14:53,290
—لا أعرف ماذا أقو

191
00:14:53,290 --> 00:14:57,640
!سي-ني، أنا فاشل

192
00:14:59,200 --> 00:15:00,500
.اهدأ، اهدأ

193
00:15:01,360 --> 00:15:03,490
.لا تبكِ يا هاكو

194
00:15:03,490 --> 00:15:06,130
.ولا تمسح أنفك في ثيابي

195
00:15:06,370 --> 00:15:07,850
.ابتهج

196
00:15:07,850 --> 00:15:11,250
.سأنتقم لك في المباراة التّالية

197
00:15:11,250 --> 00:15:14,720
كيف يجرؤ على التّنمّر على أخي الصّغير؟

198
00:15:15,110 --> 00:15:18,680
.لكنّك لن تتمكّن من قتاله

199
00:15:19,370 --> 00:15:21,450
...عندما عدت إلى وعيي

200
00:15:27,900 --> 00:15:29,870
.أنا متعب

201
00:15:29,870 --> 00:15:33,110
.الجميع يأخذون هذا القتال على محمل الجدّ

202
00:15:33,860 --> 00:15:36,820
.أويا؟ لم أسمع بهذا الاسم من قبل

203
00:15:37,160 --> 00:15:39,410
.يبدو أنّه من بوتوسان

204
00:15:39,410 --> 00:15:43,750
.تصنيفه ليس عاليًا جدًّا، ولا أحد يعرف من يكون

205
00:15:43,750 --> 00:15:47,780
.لكنّه يمثّل بوتوسان في البطولة على أيّة حال

206
00:15:48,380 --> 00:15:51,590
.النّمور والببور تختبئ في أعماق الجبال

207
00:15:51,590 --> 00:15:54,540
.الكيرين تختبئ في المزارع والحقول

208
00:15:56,480 --> 00:15:59,320
.أويا؟ بدأ الأمر يصبح مثيرًا

209
00:16:02,760 --> 00:16:07,380
أخبروني، أيّ نوعٍ من الكونغ فو
يستعمله شوكاتسو سي؟

210
00:16:07,380 --> 00:16:09,570
.ردود أفعاله كانت سريعة جدًّا

211
00:16:09,990 --> 00:16:15,740
.يعرف متى وأين سيهاجم خصومه

212
00:16:15,740 --> 00:16:18,150
.ماذا؟ لا يمكن أن يكون ذلك ممكنًا

213
00:16:18,150 --> 00:16:19,450
.بل ممكن

214
00:16:19,450 --> 00:16:21,660
.نظريًّا على أيّة حال

215
00:16:22,850 --> 00:16:28,830
،لم أتدرّب أبدًا على تلك التّقنيّة
.لكنّني جرّبت الكيمونتونكو قليلاً

216
00:16:29,850 --> 00:16:33,670
.كلّ شيء في هذا العالم لديه قواعد

217
00:16:34,070 --> 00:16:36,620
.تُعرف القواعد بتيندو

218
00:16:37,370 --> 00:16:42,360
.تقنيّات القتال هدفها إيجاد ثغرات في التّيندو

219
00:16:43,000 --> 00:16:44,960
.الأمر أشبه بالاختراق

220
00:16:46,430 --> 00:16:52,570
ومن بينها، تبحث الكيمونتونكو عن ثغرات
.في التّيندو عبر الزّمان والمكان

221
00:16:52,570 --> 00:16:57,290
إذًا تكهّن مكان هجوم الخصوم؟

222
00:16:57,560 --> 00:17:02,060
،من الصّعب خلق الصّيغة الضّروريّة لتكهّن ذلك

223
00:17:02,060 --> 00:17:03,860
.وحلّها أصعب بكثير

224
00:17:04,120 --> 00:17:07,840
لكن شوكاتسو سي قام بحساباته خلال القتال

225
00:17:07,840 --> 00:17:10,340
.وتوقّع هجمات خصومه

226
00:17:10,990 --> 00:17:16,330
.لا بدّ أنّ تقنيّة سرّيّة لعائلة شوكاتسو وراء ذلك

227
00:17:17,550 --> 00:17:19,810
.أشكّ أنّني قادر على هزيمته

228
00:17:17,570 --> 00:17:20,970
.هيا، لنستمتع قليلاً

229
00:17:19,810 --> 00:17:21,770
.لا تدع ذلك يحبطك

230
00:17:20,970 --> 00:17:23,550
—سأريك تقنيّة الكونغ فو الخاصّـ

231
00:17:21,770 --> 00:17:23,940
.أنا واثق أنّك ستتدبّر أمرك

232
00:17:23,550 --> 00:17:24,990
!أيّها المنحرف

233
00:17:29,450 --> 00:17:32,190
!سأراهن على دينغاكو رينرون-تشان

234
00:17:32,190 --> 00:17:33,390
!أيّها الغبيّ

235
00:17:33,390 --> 00:17:35,860
!لا يمكن لتلك الفتاة الصّغيرة الفوز

236
00:17:36,190 --> 00:17:37,630
ماذا قلت؟

237
00:17:37,630 --> 00:17:39,430
ماذا؟ هل لديك مشكلة ما؟

238
00:17:39,430 --> 00:17:41,210
.يا زوريو

239
00:17:41,780 --> 00:17:43,790
.هذا أنت يا تشو سوران

240
00:17:44,220 --> 00:17:46,350
ما الّذي تفعله هنا؟

241
00:17:47,260 --> 00:17:49,230
.أنت هو تشو سوران إذًا

242
00:17:49,230 --> 00:17:51,620
هل تودّ المراهنة؟

243
00:17:51,620 --> 00:17:52,640
مراهنة؟

244
00:17:57,730 --> 00:18:00,390
.نحن نتوقّع الفائز بالبطولة استنادًا عليه

245
00:18:00,800 --> 00:18:02,980
.هذه هي الفرص

246
00:18:02,980 --> 00:18:05,490
.يمكنك المراهنة على نفسك بالطّبع

247
00:18:06,540 --> 00:18:08,890
فرصك أكبر بمائة مرّة؟

248
00:18:08,890 --> 00:18:11,090
إلى أيّ مدى يستخفّ بي النّاس؟

249
00:18:11,090 --> 00:18:14,680
.هذا طبيعيّ بعد مشاهدتهم لمباراتك الأولى

250
00:18:14,680 --> 00:18:18,790
تشو ريغيوكو وشوكاتسو سي لديهما أكبر الفرص؟

251
00:18:20,450 --> 00:18:21,990
.هذا الشّخص لديه أعلى الفرص أيضًا

252
00:18:22,780 --> 00:18:25,450
...جا سيريان؟ أليس

253
00:18:26,010 --> 00:18:29,330
.إنّه سيّد الأسلحة لعائلة جا

254
00:18:29,330 --> 00:18:31,990
.إنّه حصان هذه البطولة الأسود

255
00:18:31,990 --> 00:18:32,710
حقًّا؟

256
00:18:32,710 --> 00:18:35,790
.مباراته السّابقة كانت مذهلة

257
00:18:41,500 --> 00:18:43,590
.مرحبًا يا أمّي

258
00:18:44,280 --> 00:18:46,050
.أجل، أنا في مباراة الآن

259
00:18:46,470 --> 00:18:48,060
.لا

260
00:18:48,480 --> 00:18:50,800
.لست في قتال شوارع أو ما شابه

261
00:18:50,800 --> 00:18:52,770
.إنّها مباراة رسميّة

262
00:18:53,410 --> 00:18:55,640
.إنّها بطولة الشّيوخ العشرة

263
00:18:55,640 --> 00:18:57,990
.ما كنت لأكون هنا لولا ذلك

264
00:18:59,210 --> 00:19:01,640
.أعلم ما يجري مع أخي

265
00:19:01,640 --> 00:19:03,380
...قلت لك

266
00:19:05,940 --> 00:19:08,750
.لا أصدّق أنّ فتاة هزمته

267
00:19:08,750 --> 00:19:10,540
.لا بدّ أنّه غبيّ

268
00:19:13,580 --> 00:19:15,830
.أعلم يا أمّي

269
00:19:33,170 --> 00:19:34,610
.أنت، هناك

270
00:19:34,610 --> 00:19:35,630
ماذا؟

271
00:19:35,630 --> 00:19:36,310
.انظر

272
00:19:38,400 --> 00:19:40,150
.صاحب الشّعر الأحمر

273
00:19:40,150 --> 00:19:43,170
.مستعمل أسلحة؟ سيكون خصمًا صعبًا

274
00:19:43,170 --> 00:19:44,990
لِمَ لا نهزمه أوّلاً؟

275
00:19:44,990 --> 00:19:45,590
.أتّفق معك

276
00:19:48,650 --> 00:19:50,000
!نحن هنا للمساعدة

277
00:19:50,000 --> 00:19:51,410
!لننل منه معًا

278
00:19:52,010 --> 00:19:55,040
.كنت تجالسينه من قبل

279
00:19:55,040 --> 00:19:56,950
ألست قاسية معه الآن؟

280
00:20:00,660 --> 00:20:03,950
.مذهل. إنّه يتحكّم في ثلاثة في آنٍ واحد

281
00:20:03,950 --> 00:20:07,980
.لا أتوقّع أقلّ من هذا من سيّد أسلحة عائلة جا

282
00:20:07,980 --> 00:20:11,250
.أتيت للبحث عن الفتاة الّتي هزمت أخي

283
00:20:13,510 --> 00:20:14,350
!ليس بعد

284
00:20:15,470 --> 00:20:17,260
!يمكننا تولّي أمر ثلاثة

285
00:20:18,110 --> 00:20:19,590
.أنت مخطئة

286
00:20:19,980 --> 00:20:23,040
.ليس الأمر وكأنّني هربت بسبب لقاء الزّواج

287
00:20:24,890 --> 00:20:26,240
ستّة سكاكين؟

288
00:20:26,240 --> 00:20:28,040
.هذا صحيح

289
00:20:28,390 --> 00:20:32,010
وأيضًا لِمَ يجب أن تكون ابنة عمدة القرية؟

290
00:20:32,010 --> 00:20:38,010
كنت أقول لك دائمًا أنّني أفضّل الفتيات
.الجميلات في المدينة

291
00:20:38,010 --> 00:20:40,140
ما الّذي تفكّرين فيه حقًّا؟

292
00:20:49,110 --> 00:20:54,070
إن فزت بالبطولة، ستريد كلّ فتاة
.في البلاد أن تتعرّف إليّ

293
00:20:54,070 --> 00:20:56,190
.لا تقلقي بشأن زواجي

294
00:21:00,940 --> 00:21:02,920
.يكفي يا أمّي

295
00:21:02,920 --> 00:21:05,530
.اذهبي لزيارة أخي في المستشفى

296
00:21:05,530 --> 00:21:06,530
.إلى اللّقاء

297
00:21:12,160 --> 00:21:14,520
!الفائز هو جا سيريان

298
00:21:19,240 --> 00:21:22,300
أسرع وجد زوجة لك؟

299
00:21:27,470 --> 00:21:28,990
...فو هوهو

300
00:21:30,440 --> 00:21:32,960
.شعرها غير مرتّب وهي قذرة

301
00:21:32,960 --> 00:21:34,760
.ليست من النّوع الّذي أفضّله

302
00:21:34,760 --> 00:21:37,510
.لذا أظنّ أنّني سأنتقم لك يا أخي

303
00:23:09,910 --> 00:23:11,160
الحلقة القادمة

304
00:23:10,650 --> 00:23:12,330
.مرحبًا، معكم فو شينتون

305
00:23:12,330 --> 00:23:16,380
.أريد اليوم أن أسأل هذين الغامضين بعض الأسئلة

306
00:23:16,380 --> 00:23:17,800
.لنبدأ بشوكاتسو سي-سان

307
00:23:17,800 --> 00:23:19,130
ما هي هواياتك؟

308
00:23:19,370 --> 00:23:20,880
.معاشرة النّساء على ما أظنّ

309
00:23:20,880 --> 00:23:22,750
...تقول ذلك وكأنّه شيء عاديّ

310
00:23:22,750 --> 00:23:24,340
وأنت يا أويا-سان؟

311
00:23:24,340 --> 00:23:27,300
.النّوم، فالنّوم، ثمّ العودة إلى النّوم

312
00:23:27,300 --> 00:23:28,970
.يمكنك النّوم مدى حياتك

313
00:23:28,970 --> 00:23:31,540
."في الحلقة التّالية من "هيتوري نو شيتا": "32 رجلاً

314
00:23:31,540 --> 00:23:34,190
بالمناسبة، ما الّذي يرمز إليه "32 رجلاً"؟

315
00:23:34,190 --> 00:23:36,050
.إلى عدد الرّجال الّذين دفنتهم

316
00:23:36,050 --> 00:23:37,400
ماذا؟ حقًّا؟

317
00:23:37,400 --> 00:23:38,250
.حقًّا