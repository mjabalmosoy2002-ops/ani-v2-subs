1
00:01:37,490 --> 00:01:43,580
من المهمّ أخذ الكي الّتي ورثتَها
.وتعلّم كيفية استعمالها

2
00:01:47,330 --> 00:01:50,580
.أشعر كما لو سمعتُ شيئًا مهولاً للتّوّ

3
00:01:51,000 --> 00:01:56,300
،لكني لم أشعر بكي ورثتها داخلي من قبل

4
00:01:56,300 --> 00:01:58,760
...لذا أجهل تمامًا ما تتحدّث عنه

5
00:01:59,840 --> 00:02:03,970
صحيح، أعتقد أنّ فنّ الكينكو خاصّتك
.هو الكي الّتي ورثتها

6
00:02:04,680 --> 00:02:07,100
قلتَ أنّه فنّ عائلتك القتاليّ وفقما أذكر، صحيح؟

7
00:02:07,100 --> 00:02:10,440
،لكنّه شيء علّمنيه جدّي

8
00:02:10,440 --> 00:02:14,190
.لذا لا أظنّني اكتسبته منذ ولادتي

9
00:02:14,190 --> 00:02:15,230
...بالتّالي

10
00:02:15,230 --> 00:02:17,360
.حسنٌ، لنتحدّث أثناء مشينا

11
00:02:20,280 --> 00:02:22,660
،هنالك صنفان للدّخلاء

12
00:02:22,660 --> 00:02:25,040
.أولئك الّذين يرثون قدراتهم، وأولئك الّذين يكتسبونها

13
00:02:25,540 --> 00:02:27,450
.أنا ورثت قدراتي

14
00:02:27,450 --> 00:02:29,160
،بقدر ما أتذكّر

15
00:02:29,160 --> 00:02:31,250
.كنتُ قادرًا على فعل ما أريتُك للتّوّ

16
00:02:31,790 --> 00:02:33,630
،بناءً على حديثك

17
00:02:33,630 --> 00:02:36,050
.يبدو أنّك اكتسبت قدراتك

18
00:02:36,760 --> 00:02:39,260
فنّ الكينكو الّذي تعلّمته من جدّك

19
00:02:39,260 --> 00:02:41,470
.أيقظ الكي داخلك على الأرجح

20
00:02:41,930 --> 00:02:46,470
.هذا لا يعني أنّ الدّخلاء ذوي القدرات المتوارثة يفوقونك

21
00:02:46,470 --> 00:02:50,730
.بل معظم الدّخلاء البارعون اكتسبوا قدراتهم في الواقع

22
00:02:51,600 --> 00:02:52,900
،الأشخاص الّذين خطفوني

23
00:02:52,900 --> 00:02:55,110
من يُدعون بالزّينسي، ألم يكونوا دخلاء أيضًا؟

24
00:02:55,650 --> 00:02:58,360
ما الّذي يحاولون فعله؟

25
00:02:58,360 --> 00:03:01,030
.يبدو أنّ بينكما سجالٌ محتدم

26
00:03:01,030 --> 00:03:05,240
.لا نزال نجهل دوافع الزّينسي الحقيقيّة

27
00:03:06,370 --> 00:03:09,910
سوران-كن، هل سمعت بمدرسة
شوانجين وتشينغي داو؟

28
00:03:10,290 --> 00:03:12,120
أليستا فلفستان طاويّتان؟

29
00:03:12,580 --> 00:03:17,550
أتقصد أنّ كافّة الطاويّين حارقي البخور دخلاء أيضًا؟

30
00:03:17,550 --> 00:03:20,880
.كلاّ، ليس كافّة الطّاويّين بالطّبع

31
00:03:21,340 --> 00:03:25,760
أعدادهم قليلة، سواءً كانوا طاويّين يتّبعون
،مدرسة شوانجين أو تشينغي داو

32
00:03:25,760 --> 00:03:28,930
.أو المهايانا أو بوذيّة التّبت، جميعها مدارس

33
00:03:28,930 --> 00:03:32,730
.تتلمذ لديها الدّخلاء منذ القدم

34
00:03:32,730 --> 00:03:33,900
ما خطب هذا؟

35
00:03:33,900 --> 00:03:37,110
.نظرتي للعالم انقلبت رأسًا على عقب

36
00:03:37,110 --> 00:03:42,030
لكلّ مدرسةٍ ضوابطها الصّارمة لإبقاء
.دخلائها تحت السّيطرة

37
00:03:42,530 --> 00:03:44,740
،اعتمادًا على طريقة استعمال الدّخيل لقدراته

38
00:03:44,740 --> 00:03:46,580
.قد يكون صالحًا أو شرّيرًا

39
00:03:47,120 --> 00:03:49,620
.لكنّ الزّينسي مختلفون

40
00:03:49,620 --> 00:03:53,620
.يؤمنون بالشوان-زينغ باو-جين

41
00:03:55,210 --> 00:03:59,630
.ببساطة، يفعلون ما يحلو لهم، ويأبون التّقييد

42
00:03:59,630 --> 00:04:01,760
.حثالة حتّى النّخاع

43
00:04:03,220 --> 00:04:04,220
أين نحن؟

44
00:04:04,220 --> 00:04:07,970
سوران-كن، ألا تودّ معرفة سبب ملاحقتهم لك؟

45
00:04:13,480 --> 00:04:17,810
لِمَ لا نطلب الإجابة من المسؤول نفسه؟

46
00:04:25,780 --> 00:04:26,780
كينكين؟

47
00:04:29,330 --> 00:04:30,410
.ريو كينكين

48
00:04:30,910 --> 00:04:34,040
.الوريثة الوحيدة لعشيرة ريو

49
00:04:34,040 --> 00:04:36,500
.عجبًا، تعرفني سلفًا

50
00:04:36,500 --> 00:04:38,540
.أي أنّك قمت بأبحاثك حولي

51
00:04:39,130 --> 00:04:42,420
قالت عائلتك قبل بضعة أشهر أنّكِ اختفيتِ

52
00:04:42,420 --> 00:04:45,050
.وطلبوا منّا العثور عليك

53
00:04:45,050 --> 00:04:48,550
.لذا تعقّبتكِ شركتنا

54
00:04:48,550 --> 00:04:53,180
.رغم أنّه لم يخطر لنا سعيكِ للانضمام للزّينسي

55
00:04:53,600 --> 00:04:55,770
!يا لسذاجتك

56
00:04:55,770 --> 00:04:59,480
.تحاولين الانضمام إليهم بينما تجهلين حقيقتهم تمامًا

57
00:04:59,480 --> 00:05:03,070
أتدركين خطورة أفعالك؟

58
00:05:03,820 --> 00:05:05,990
ما الّذي يغضبك هكذا؟

59
00:05:05,990 --> 00:05:11,200
.لا تخصّكم معرفتي للزّينسي أو خلافها

60
00:05:11,580 --> 00:05:15,370
.رغم أنّي لم أعرف الكثير عنهم بالفعل

61
00:05:15,370 --> 00:05:19,210
في المقابل، أعرف الكثير عن شركة
.التّوصيل السّريع خاصّتكم

62
00:05:19,210 --> 00:05:21,550
،خدمة التّوصيل مجرّد قناع

63
00:05:21,550 --> 00:05:24,460
،بينما ما تفعلونه حقًّا هو تتّبع أخطاء الدّخلاء

64
00:05:24,460 --> 00:05:27,220
.ومحاولة تقييدهم بمنطقكم الخاصّ

65
00:05:27,220 --> 00:05:29,220
تنتشر شركتكم على نطاق البلاد

66
00:05:29,220 --> 00:05:33,350
.وتتصرّفون بتعالٍ يدفعني للتّقيّؤ

67
00:05:33,720 --> 00:05:38,100
.حتّى والدي لا يستطيع إلاّ أن يقول "نعم" أمامكم

68
00:05:39,310 --> 00:05:42,770
هل تحميكم الحكومة؟

69
00:05:42,770 --> 00:05:46,110
هل الحكومة من أسّست شركة
التّوصيل السّريع في الأصل؟

70
00:05:46,110 --> 00:05:48,490
أهذا صحيح؟

71
00:05:48,490 --> 00:05:51,240
.لم تخطئ بقدرٍ كبير

72
00:05:51,830 --> 00:05:57,160
.نحن منظّمةٌ تتدخّل عندما يسبّب الدّخلاء الحوادث

73
00:05:57,160 --> 00:06:00,170
صدقًا؟ هذا هو موقفكم؟

74
00:06:00,170 --> 00:06:02,920
.لنعقد صفقة يا ريو كينكين

75
00:06:02,920 --> 00:06:05,840
،إن أخبرتِنا بدوافع الزّينسي هذه المرّة

76
00:06:05,840 --> 00:06:07,840
.سنتساهل معك

77
00:06:07,840 --> 00:06:08,880
ما رأيك؟

78
00:06:10,300 --> 00:06:12,220
تتساهلون؟

79
00:06:12,720 --> 00:06:14,640
.كلاّ، لن أخبركم

80
00:06:14,640 --> 00:06:18,140
.ولو فعلت، لن تقدروا على فعل أيّ شيء

81
00:06:18,140 --> 00:06:21,560
لِمَ لا تسلّموني سريعًا للقانون وتنهون الأمر؟

82
00:06:21,560 --> 00:06:24,650
كلّ ما يمكنهم اتّهامي به هو تخريب
.الممتلكات فحسب

83
00:06:25,280 --> 00:06:27,780
.سيكون من المريب لو حصلوا على دليلٍ حتّى لهذا

84
00:06:27,780 --> 00:06:30,700
انضممتِ للزّينسي لتوّك، أليس كذلك؟

85
00:06:30,700 --> 00:06:32,700
لِمَ تحمينهم؟

86
00:06:33,240 --> 00:06:36,370
أنتِ وريثة عشيرة ريو ذائعة الصّيت

87
00:06:36,370 --> 00:06:39,120
.بين الدّخلاء من ممارسي الشّوسي غانشي المميّزين

88
00:06:39,120 --> 00:06:42,040
لا تمانعين تلطيخ اسم عائلتكِ هكذا؟

89
00:06:44,290 --> 00:06:48,050
،ممارسو الشّوسي غانشي ذائعو الصّيت
...عشيرة ريو

90
00:06:48,050 --> 00:06:49,720
!كلّ هذا مجرّد كذب

91
00:06:50,300 --> 00:06:52,680
.ربّما سأخبرك إذًا

92
00:06:54,140 --> 00:06:57,180
أظنّ بصراحة أنّ زوال فنون الشّوسي غانشي لعشيرة ريو

93
00:06:57,180 --> 00:07:00,690
.سيكون أمرًا حسنًا

94
00:07:01,400 --> 00:07:06,530
.لكنّ عائلتي أرغمتني لأكون الوريثة

95
00:07:09,780 --> 00:07:13,820
.لم أملك حيلةً لرفض ذلك في صغري

96
00:07:14,240 --> 00:07:19,450
.كنتُ محتجزةً في المنزل حتّى بلغت الخامسة عشر

97
00:07:19,450 --> 00:07:22,250
.أصدقائي الوحيدون كانوا جثثًا

98
00:07:22,250 --> 00:07:24,840
أُرغمت على استعمال التّعويذة
.على مختلف أصناف الجثث

99
00:07:25,210 --> 00:07:29,460
.لم أقابل إنسانًا حيًّا من خارج عشيرتي أبدًا

100
00:07:29,970 --> 00:07:33,180
كان عليّ التّدرّب على مختلف التّعويذات

101
00:07:33,180 --> 00:07:35,600
.على جثثٍ تواصل التّعفّن يوميًّا

102
00:07:35,930 --> 00:07:38,270
.إن رفضت، سيتمّ ضربي

103
00:07:38,270 --> 00:07:40,390
.لم أقدر على الهرب

104
00:07:40,390 --> 00:07:42,690
،لأنّي لا أملك أصدقاءً من البشر

105
00:07:43,350 --> 00:07:46,230
.أكشف عمّا داخلي للجثث فقط

106
00:07:46,230 --> 00:07:50,990
.لكن ما يحصل أنّ رائحتها تسوء وتبدأ بالتّحلّل

107
00:07:51,320 --> 00:07:54,200
،إن لم أتقن استعمال التّعويذات

108
00:07:54,200 --> 00:07:55,820
لن يُسمح لي بالخروج

109
00:07:55,820 --> 00:07:58,370
.لأنّ الكي السّيّئة ستنتقل للآخرين حسبما يبدو

110
00:07:58,740 --> 00:08:02,500
.بسبب هذا، بذلتُ قصارى جهدي

111
00:08:02,870 --> 00:08:04,960
ظننتُني سأقدر على الخروج حقًّا

112
00:08:04,960 --> 00:08:07,380
.لو تحكمتُ بالتّعويذات

113
00:08:07,750 --> 00:08:13,010
وبعدما بلغتُ الخامسة عشر، استطعتُ
.التّحكّم بكافّة التّعويذات

114
00:08:13,550 --> 00:08:17,390
.كنتُ بغاية السّعادة لأنّي سأصبح حرّةً أخيرًا

115
00:08:17,390 --> 00:08:24,230
.ثمّ... أخبروني بالعيش بهدوءٍ كبقيّة البشر الطبيعيّين

116
00:08:24,230 --> 00:08:28,270
.لم يُسمح لي باستعمال التّعويذات للتّحكّم بالجثث

117
00:08:28,270 --> 00:08:30,030
...ليخبرني أحدكم

118
00:08:30,030 --> 00:08:33,150
ما كان هدف السّنوات الخمسة عشر تلك من حياتي؟

119
00:08:33,150 --> 00:08:35,990
أتقصدون أنّ لا معنى لحياتي؟

120
00:08:36,410 --> 00:08:38,950
!طالبتهم بإجابة

121
00:08:38,950 --> 00:08:42,290
وماذا تظنّون كان رأيهم؟

122
00:08:43,000 --> 00:08:46,420
.قالوا أنّ كلّ ذلك لأجلي

123
00:08:46,710 --> 00:08:50,880
ماذا؟ ماذا؟ لأجلي؟

124
00:08:50,880 --> 00:08:53,260
...لم يكفّوا عن أمري بمختلف الأمور

125
00:08:53,260 --> 00:08:57,340
!هذا يجعلني في مقام الجثث مسلوبة الإرادة

126
00:08:57,340 --> 00:08:58,600
!أخبرني

127
00:08:58,600 --> 00:09:01,220
!أين السّوء في استعمال الدّخلاء لقدراتهم؟

128
00:09:01,220 --> 00:09:03,730
!سبب انضمامي للزّينسي واحدٌ فحسب

129
00:09:03,730 --> 00:09:06,850
!الحرّيّة، أردتُ الشّعور بالحرّيّة فقط

130
00:09:06,850 --> 00:09:09,610
!لا أكترث أيّ منظمةٍ هي الزّينسي

131
00:09:11,980 --> 00:09:15,610
.يا إلهي، لا أطيق رؤية هذا

132
00:09:16,150 --> 00:09:18,990
.لم تتغيّر يا جو سان

133
00:09:18,990 --> 00:09:22,740
.لا يمكنك التّكفّل حتّى بفتاةٍ صغيرةٍ

134
00:09:22,740 --> 00:09:25,250
جو يون، لِمَ أنت هنا؟

135
00:09:25,250 --> 00:09:26,540
لِمَ؟

136
00:09:26,540 --> 00:09:30,500
.لأنّي علمتُ أنّك ستعجز عن التّكفّل بالأمر، فأتيت

137
00:09:31,380 --> 00:09:33,670
هوهو-تشان، أأنتِ على ما يرام؟

138
00:09:33,670 --> 00:09:34,880
.ليس تمامًا

139
00:09:36,170 --> 00:09:37,510
!جو يون، توقف

140
00:09:37,510 --> 00:09:38,760
!تنحّ

141
00:09:38,760 --> 00:09:40,350
.أيّتها الصّغيرة

142
00:09:40,350 --> 00:09:42,760
.ستخبرينا بكلّ ما تعرفينه

143
00:09:42,760 --> 00:09:45,890
.أكره إهدار وقتي

144
00:09:46,890 --> 00:09:49,650
.أنا أكره ذلك أيضًا

145
00:09:52,260 --> 00:09:53,530
!أيّها الأحمق

146
00:09:52,270 --> 00:09:53,530
!ماذا؟

147
00:09:53,530 --> 00:09:54,570
!جو يون، توقّف

148
00:09:54,570 --> 00:09:56,030
!لا تقترب يا جو سان

149
00:09:56,030 --> 00:09:57,990
.أنا المسؤول الآن

150
00:09:57,990 --> 00:10:02,410
أيّتها الصّغيرة، نحن لسنا جزءًا
!من النّظام القضائيّ كما قلتِ

151
00:10:03,330 --> 00:10:06,410
.لذا لا سبب لاتّباع القانون

152
00:10:06,410 --> 00:10:09,540
تلك التّقاليد والقواعد

153
00:10:09,540 --> 00:10:12,880
.تحمي النّاس بينما تقيّدهم في الواقع

154
00:10:13,300 --> 00:10:14,590
.يا صغيرة

155
00:10:14,590 --> 00:10:17,220
قلتِ أنّكِ تريدين الحرّيّة؟

156
00:10:17,550 --> 00:10:21,850
.سأحرّركِ الآن

157
00:10:23,220 --> 00:10:24,600
،لكن قبل ذلك

158
00:10:24,600 --> 00:10:28,230
.ستدفعين ثمن الحرّيّة

159
00:10:30,850 --> 00:10:35,940
قلتِ أنّكِ انضممتِ للزّينسي سعيًا للحرّيّة؟

160
00:10:36,440 --> 00:10:41,910
.لكنّكِ لا تدركين مفهومهم عن الحرّيّة

161
00:10:41,910 --> 00:10:44,200
.يفعلون ما يحلو لهم وحسب

162
00:10:44,200 --> 00:10:46,330
،إن لم يتّبعوا القواعد

163
00:10:46,330 --> 00:10:51,670
.هذا يعني أنّ البقيّة ليس عليهم اتّباع القواعد أيضًا

164
00:10:51,670 --> 00:10:55,920
.يمكننا فعل ما نريد للزّينسي

165
00:10:55,920 --> 00:10:57,840
.لن يتذمّر أحد

166
00:10:58,210 --> 00:11:00,630
،لو حوّلتكِ لعاجزةٍ اليوم

167
00:11:00,630 --> 00:11:03,350
.لن أتحمّل أيّ مسؤوليّة

168
00:11:03,350 --> 00:11:05,560
!ابتعد

169
00:11:06,140 --> 00:11:10,230
.لن يحصل ذلك، سأقوم بما يحلو لي أيضًا

170
00:11:13,560 --> 00:11:17,230
يا صبيّ... ما الّذي تفعله؟

171
00:11:18,070 --> 00:11:21,240
،إن مددت يدك عليها مرّةً أخرى

172
00:11:22,030 --> 00:11:24,120
.سوف تواجهني أنا

173
00:11:29,870 --> 00:11:32,000
.إنّك تملك الجرأة

174
00:11:42,510 --> 00:11:46,720
أتدرك ماذا تفعل الآن يا صبيّ؟

175
00:11:46,720 --> 00:11:48,850
،جو سان-سان، فيما يتعلّق بهذه الحادثة

176
00:11:48,850 --> 00:11:51,230
،جثّة جدّي هي ما سُرق

177
00:11:51,230 --> 00:11:52,810
.وأنا من اُختطف

178
00:11:52,810 --> 00:11:54,730
.أنا وحدي المتضرّر هنا

179
00:11:55,110 --> 00:11:56,770
.هذا يكفي

180
00:11:56,770 --> 00:11:59,400
.ارفقوا بها رجاءً

181
00:12:00,110 --> 00:12:03,240
أنتَ محقّ، إن غادرت الزّينسي

182
00:12:03,240 --> 00:12:05,620
،وتعهّدت بعدم اعتراض طريقنا

183
00:12:05,620 --> 00:12:07,370
.سأفكّر بالأمر

184
00:12:07,370 --> 00:12:09,290
تمهّل! ما الّذي تقوله؟

185
00:12:09,290 --> 00:12:11,040
.لا يحقّ لك اتّخاذ أيّ قرار

186
00:12:11,040 --> 00:12:12,410
!أنا المسؤول هنا

187
00:12:12,410 --> 00:12:14,080
.بالطّبع يحقّ لي

188
00:12:14,080 --> 00:12:17,170
!تمهّلا! أنا الضّحيّة، أنا المدّعي هنا

189
00:12:17,170 --> 00:12:19,250
!أسحب شكواي، يُفترض أنّ هذا سيحلّ كلّ شيء

190
00:12:19,250 --> 00:12:21,260
!لا تتفوه بالهراء أيّها الوغد

191
00:12:21,260 --> 00:12:23,930
!لسنا في محكمةً ولا ضبّاط شرطة، لا قيمة لكلامك

192
00:12:23,930 --> 00:12:26,010
.من تكون أصلاً؟ لقد ظهرت فجأةً

193
00:12:26,010 --> 00:12:27,510
ما علاقتك بكلّ هذا؟

194
00:12:27,850 --> 00:12:31,520
!بالطّبع لي علاقة أيّها الوغد المضيء

195
00:12:31,520 --> 00:12:34,520
!لن أتهاون حتّى تفتح فمها

196
00:12:34,520 --> 00:12:35,900
!لا تعبث معي

197
00:12:35,900 --> 00:12:37,560
!لن أدعك تفعل ما تريد لكينكين

198
00:12:37,560 --> 00:12:39,020
!سأحميها حتمًا

199
00:12:39,020 --> 00:12:42,240
!أيّها الصّبيّ الكريه، ابتعد عن ناظريّ

200
00:12:42,240 --> 00:12:44,950
!اخرج إذًا! لن يوقفك أحد

201
00:12:44,950 --> 00:12:47,240
!ماذا؟ تريد أن تُقتل؟

202
00:12:47,240 --> 00:12:49,030
!ماذا؟ تريد قتالي؟

203
00:12:49,030 --> 00:12:50,410
!تعال! لنتقاتل

204
00:12:50,410 --> 00:12:52,750
!أنا لا أخافك

205
00:12:52,750 --> 00:12:54,250
!ستندم على هذا أيّها الوغد

206
00:12:54,250 --> 00:12:55,080
.الإرث

207
00:12:55,080 --> 00:12:55,790
!ماذا؟

208
00:12:56,750 --> 00:12:59,290
.كنتُ أبحث عن إرث تشو شاكورين

209
00:12:59,290 --> 00:13:01,420
...حـ-حسنًا

210
00:13:01,420 --> 00:13:03,920
،وفقًا لما أخبروني

211
00:13:03,920 --> 00:13:08,470
،في الماضي، قاتل قرابة 12 محارب زينسي دخيلاً واحدًا

212
00:13:08,470 --> 00:13:11,890
.وسقط معظمهم

213
00:13:12,270 --> 00:13:16,600
،لكن يبدو أنّ الدّخيل بعد قتاله لذاك العدد

214
00:13:16,600 --> 00:13:18,810
.لم يُصب سوى ببضعة خدوش

215
00:13:19,310 --> 00:13:24,320
منذ ذاك الحين، تحاول الزّينسي
.تحديد مكان ذاك الدّخيل

216
00:13:24,650 --> 00:13:27,660
،ليس لأجل إعادته للحياة أو ما شابه

217
00:13:27,660 --> 00:13:30,830
.أظنّهم كانوا مهتمّين بقوّته فقط

218
00:13:31,580 --> 00:13:34,500
،قبل موت أحد المحاربين

219
00:13:34,500 --> 00:13:37,000
.أخبر أحد رفاقه باسم تلك القدرة

220
00:13:37,000 --> 00:13:39,080
.كانت أسلوب كيتايغين

221
00:13:39,580 --> 00:13:41,840
،جدّك تشو شاكورين

222
00:13:41,840 --> 00:13:44,170
كان من تمكن

223
00:13:44,170 --> 00:13:47,630
.من هزيمة 12 محارب زينسي دفعةً واحدة

224
00:13:52,260 --> 00:13:53,970
،نعرف هدفهم الآن

225
00:13:53,970 --> 00:13:56,100
لكن ماذا سنفعل بريو كينكين؟

226
00:13:56,100 --> 00:13:57,520
.إنّها مسألةٌ صعبة

227
00:13:57,980 --> 00:14:00,730
ما رأيك يا جو يون؟ نسأل رؤساءنا؟

228
00:14:00,730 --> 00:14:02,690
.لا تسألني أنا

229
00:14:02,690 --> 00:14:06,400
.انتهى دوري بعد معرفتنا لهدفهم

230
00:14:06,860 --> 00:14:09,530
.من أنا مهتمٌّ به الآن هو هذا الفتى

231
00:14:09,530 --> 00:14:11,120
ما خطبك؟

232
00:14:11,120 --> 00:14:14,540
من كان ليتصوّر أنّ وريث أسلوب كيتايغين

233
00:14:14,540 --> 00:14:16,870
.شخصٌ ضعيف مثله

234
00:14:16,870 --> 00:14:20,380
ما خطب أسلوب كيتايغين الّذي تذكرونه باستمرار؟

235
00:14:20,380 --> 00:14:23,040
.ما علّمني إياه جدّي هو ما أريتكم سابقًا فقط

236
00:14:23,040 --> 00:14:26,090
أتقصد هيئتك الذّهبيّة المضيئة؟

237
00:14:26,090 --> 00:14:29,550
...أشعر أنّي رأيت ذلك من قبل

238
00:14:29,550 --> 00:14:31,890
.لكنّه ليس أسلوب كيتايغين حتمًا

239
00:14:32,220 --> 00:14:35,390
أأنت واثق أنّ ذلك كلّ ما علّمك إيّاه؟

240
00:14:35,390 --> 00:14:38,940
.أجل، لم يدرّبني جدّي على غيره

241
00:14:38,940 --> 00:14:40,690
،إن لم يكن الكينكو

242
00:14:40,690 --> 00:14:44,150
.إذًا لا أملك أيّ فكرة عن أسلوب الكيتايغين ذاك

243
00:14:44,150 --> 00:14:47,400
.لا بدّ أنّ الزّينسي أخطؤوا في هويّة الشّخص

244
00:14:47,400 --> 00:14:51,240
.لا أملك ولا جدّي أيّ علاقةٍ بأسلوب الكيتايغين ذاك

245
00:14:51,240 --> 00:14:55,790
.حتّى لو صدقت في كلامك، لن يصدّقوك

246
00:14:56,120 --> 00:15:00,040
،ما داموا يظنّون أنّك وريث أسلوب الكيتايغين

247
00:15:00,040 --> 00:15:02,290
.لن يكفّوا عن ملاحقتك

248
00:15:02,580 --> 00:15:04,090
...حسنًا، لكن

249
00:15:04,090 --> 00:15:05,550
!امرأة

250
00:15:06,090 --> 00:15:07,960
!أشتمّ رائحة امرأة

251
00:15:09,050 --> 00:15:11,550
!لا شكّ في ذلك! إنّها امرأة

252
00:15:11,930 --> 00:15:14,050
أهو ذاك الشّخص من قبل؟

253
00:15:14,050 --> 00:15:16,470
.أجل، هو من أنقذك

254
00:15:16,470 --> 00:15:17,770
.يُدعى سارو

255
00:15:17,770 --> 00:15:20,480
أليس واحدًا منكم؟

256
00:15:20,480 --> 00:15:23,020
لِمَ تحتجزونه موثقًا في قفص؟

257
00:15:23,020 --> 00:15:25,820
وما خطبه أيضًا؟

258
00:15:25,820 --> 00:15:30,190
.هذا لأنّ سارو تلقّى هجمة ناتسوكا مكانك

259
00:15:30,610 --> 00:15:35,200
،إنّها إحدى مشعوذي الزّينسي الأربعة
.وهم في غاية الخطورة

260
00:15:36,030 --> 00:15:39,000
،كاشطة العظام ناتسوكا أحدهم

261
00:15:39,000 --> 00:15:42,000
.وهي دخيلة قادرة على التّحكّم برغبات الآخرين

262
00:15:42,000 --> 00:15:45,670
لا يروق القتل لناتسوكا، لكنّ من تصيبهم

263
00:15:45,210 --> 00:15:49,630
!امرأة! امرأة! أخرجوني من هنا

264
00:15:45,670 --> 00:15:49,630
.تتملّكهم الرّغبة، وينتهي بهم المطاف عاجزين

265
00:15:49,920 --> 00:15:54,510
هوهو، أتدركين الآن لِمَ منعتكِ من قتالها؟

266
00:15:55,050 --> 00:15:58,430
.لحسن الحظّ، يبدو أنّ إصابة سارو ليست بذاك السّوء

267
00:15:58,930 --> 00:16:01,140
.لم تكن ناتسوكا جادّةً أيضًا

268
00:16:01,140 --> 00:16:05,230
.إن احتجزناه لبضعة أيّامٍ هنا، سيعود لطبيعته على الأرجح

269
00:16:06,730 --> 00:16:07,770
!هوهو-تشان

270
00:16:07,770 --> 00:16:11,190
ما هو شعور وقوع شخصٍ في حبّك لأوّل مرّة؟

271
00:16:11,190 --> 00:16:13,070
.لا بدّ أنّ هذا يسعدكِ كامرأة

272
00:16:13,070 --> 00:16:14,450
.كلاّ، ليس تمامًا

273
00:16:15,780 --> 00:16:18,830
لا أنوثة حولكِ بالفعل، أليس كذلك؟

274
00:16:18,830 --> 00:16:21,120
.عليكِ أن تبدئي بالتّصرّف كامرأة

275
00:16:21,120 --> 00:16:22,500
.أضمن لك هذا

276
00:16:22,500 --> 00:16:26,670
،ستكونين أكثر جاذبيّةً من ناتسوكا إن حاولتِ
ألستُ محقًّا يا جو سان؟

277
00:16:26,660 --> 00:16:29,410
أنت! لا تخبر هوهو بأشياء غريبة

278
00:16:29,410 --> 00:16:30,980
!جو سان! جو سان

279
00:16:30,050 --> 00:16:32,510
!اخرس يا سارو! أغلق فمك

280
00:16:34,010 --> 00:16:36,760
.سوران-كن، لا يمكننا الحديث بهدوءٍ هنا

281
00:16:37,350 --> 00:16:39,180
.لنذهب لمكتبي

282
00:16:41,980 --> 00:16:47,560
سوران-كن، هدف شركتنا ليس التّحكّم
.بالدّخلاء أو معاقبتهم

283
00:16:47,560 --> 00:16:49,730
.هنالك مشاكل عديدة تحيط بالدّخلاء

284
00:16:49,730 --> 00:16:52,440
،نحن نحاول مساعدة الدّخلاء ذوي الحاجة

285
00:16:52,440 --> 00:16:57,280
،والتّصدّي للدّخلاء الّذين يحاولون زعزعة المجتمع أيضًا

286
00:16:57,280 --> 00:16:59,700
.والحفاظ على توازن مجتمع الدّخلاء

287
00:17:00,330 --> 00:17:01,950
.فكّر بالأمر

288
00:17:01,950 --> 00:17:06,830
!لا عمل آخر بأهمّيّة وضروريّة هذا

289
00:17:06,830 --> 00:17:07,960
!سوران-كن

290
00:17:08,500 --> 00:17:11,340
ألن تنضمّ لشركة التّوصيل السّريع هذه؟

291
00:17:11,340 --> 00:17:12,340
!لا

292
00:17:12,340 --> 00:17:15,260
.لِمَ؟ يمكنك التّفكير في الأمر على الأقلّ

293
00:17:15,260 --> 00:17:16,760
.لستُ مهتمًّا البتّة

294
00:17:16,760 --> 00:17:20,680
ألا تملك أحلامًا كبيرة مثل خدمة
المجتمع بالخير وما شابه؟

295
00:17:20,680 --> 00:17:24,980
.كلاّ، حلمي أن أصبح غنّيًّا دون فعل شيء

296
00:17:24,980 --> 00:17:27,270
.وعيش حياةٍ سهلة وهادئة

297
00:17:27,270 --> 00:17:29,810
...يا لشباب هذه الأيّام

298
00:17:29,810 --> 00:17:32,820
،وأيضًا، أظنّ أنّ ما تقوله رائع

299
00:17:32,820 --> 00:17:34,650
لكنّ هذا عملٌ يهدّد حياتك، أليس كذلك؟

300
00:17:34,650 --> 00:17:36,240
.لا، لن يحصل ذلك

301
00:17:36,240 --> 00:17:38,740
.لن أخفي شيئًا عنك

302
00:17:38,740 --> 00:17:41,410
،هنالك مخاطر في عملنا حقًّا

303
00:17:41,410 --> 00:17:44,370
.لكنّي أضمن لك مقابلاً مادّيًّا منصفًا

304
00:17:44,370 --> 00:17:48,620
.مهما بلغ المقابل، فهو لا يهمّ بعد موتك

305
00:17:48,880 --> 00:17:51,290
هل تسخر منّي؟

306
00:17:51,290 --> 00:17:53,880
.لن تخدعني بهذه السّهولة

307
00:17:53,880 --> 00:17:56,010
.كلاّ، لا أحاول خداعك

308
00:17:56,010 --> 00:17:58,260
.أريدك أن تفكّر بالأمر قليلاً

309
00:17:58,260 --> 00:18:00,600
.سئمت من سماع هذا

310
00:18:00,600 --> 00:18:03,140
.هوهو-تشان، أقنعي هذا الغبيّ

311
00:18:03,140 --> 00:18:04,350
.فهمت

312
00:18:07,640 --> 00:18:11,980
.إن ظننتَ أنّني مثل بقيّة الشّباب، فقد أخطأت

313
00:18:11,980 --> 00:18:14,980
...إن اعتقدت أنّ تلك الكلمات ستقنعني حقًّا

314
00:18:27,460 --> 00:18:29,540
!توقّفي يا هوهو-ساما

315
00:18:31,000 --> 00:18:32,420
!سيّدتي

316
00:18:32,420 --> 00:18:34,300
!توقّفي يا سيّدتي

317
00:18:34,300 --> 00:18:38,510
،حسنًا، حسنًا، سأفعل أيّ شيء
!لذا كفّي عن ضربي

318
00:18:38,510 --> 00:18:40,340
!سألتحق بالتّوصيل السّريع

319
00:18:40,340 --> 00:18:42,300
.هاك أوراق تعيينك

320
00:18:42,300 --> 00:18:43,720
.يمكنك المغادرة بعد تعبئتها

321
00:18:44,640 --> 00:18:47,270
.حسنًا، فهمت يا جو يون-سان

322
00:18:47,270 --> 00:18:48,940
.كما قال جو يون تمامًا

323
00:18:49,440 --> 00:18:51,650
.للقوّة الجسديّة مفعولٌ أفضل من الكلمات

324
00:18:51,650 --> 00:18:53,770
!جو يون، اذهب لمنزلك

325
00:18:53,770 --> 00:18:55,780
!لا أصدّق كيف ربّيتَ هوهو

326
00:18:55,780 --> 00:18:58,490
.ليس عليك الإصغاء لهم يا سوران-كن

327
00:18:59,860 --> 00:19:01,610
ما الّذي تقوله؟

328
00:19:01,610 --> 00:19:04,330
.تحدّث مع المسؤولين إن كانت لديك مشاكل

329
00:19:04,330 --> 00:19:08,370
.سأكون المسؤول عن هوهو-تشان وهذا الصّبيّ

330
00:19:09,750 --> 00:19:11,960
.لا تبدِ هذه التّعابير

331
00:19:11,960 --> 00:19:15,920
جو سان، ألستَ مكلّفًا بعملٍ آخر من المسؤولين؟

332
00:19:17,920 --> 00:19:20,130
،حسنًا يا تشو سوران-كن

333
00:19:20,420 --> 00:19:22,640
!مرحبًا بك في شركة التّوصيل السّريع

334
00:19:23,220 --> 00:19:26,680
.سررتُ بالانضمام لكم يا جو يون-سان

335
00:19:29,930 --> 00:19:35,940
يا إلهي... لِمَ حياتي فظيعةٌ هكذا؟

336
00:19:40,610 --> 00:19:41,450
من هناك؟

337
00:19:41,780 --> 00:19:43,780
أهي تلك المرأة من جديد؟

338
00:19:52,250 --> 00:19:53,830
.لا شيء بالفعل

339
00:19:53,830 --> 00:19:55,040
...كانت مخيّلتي فحسب

340
00:19:58,380 --> 00:20:00,970
!ماذا؟ ماذا؟ توقّف! ليس ثانية

341
00:20:00,970 --> 00:20:05,180
!دعني! من تكون أيّها الوغد؟ كفّ عن هذا

342
00:20:05,720 --> 00:20:08,430
جو يون، ما الّذي تخطّط له؟

343
00:20:08,430 --> 00:20:10,980
ما سبب هوسك بتشو سوران؟

344
00:20:10,980 --> 00:20:14,350
.لم يسبق أن اكترثتَ لمن نعيّنهم

345
00:20:14,770 --> 00:20:15,690
فلماذا؟

346
00:20:16,020 --> 00:20:20,070
أيعقل أنّك تسعى وراء أسلوب الكيتايغين أيضًا؟

347
00:20:20,320 --> 00:20:23,030
...لا يمكنني القول أنّ ذلك ليس سببًا أيضًا

348
00:20:23,030 --> 00:20:27,070
.لكنّي منبهرٌ أكثر بمن يحيطونه

349
00:20:27,450 --> 00:20:31,500
كنتُ مهتمًّا قليلاً عندما سمعت أنّ الزّينسي يبحثون

350
00:20:31,500 --> 00:20:33,080
.عن إرث تشو شاكورين

351
00:20:36,960 --> 00:20:40,000
لا يسعني سوى التّساؤل
عن أيّ صنفٍ من الأشخاص

352
00:20:40,000 --> 00:20:42,590
.ينتمي له من استحوذ على اهتمامهم

353
00:20:43,010 --> 00:20:45,680
ألا يثير الأمر اهتمامك أيضًا يا جو سان؟

354
00:20:47,300 --> 00:20:48,890
.ها قد أتى

355
00:20:48,890 --> 00:20:52,730
انظري يا تشو تو، أليس صغيري ماهرًا؟

356
00:20:52,730 --> 00:20:55,900
.فتىً صالح، أحسنت العمل

357
00:20:55,900 --> 00:20:57,860
أهو في الدّاخل؟

358
00:21:00,020 --> 00:21:02,740
.عملٌ موفّق، يمكنك العودة للمنزل قبلي

359
00:21:05,660 --> 00:21:08,740
.تشو سوران الّذي يتحدّث عنه الجميع هنا أيضًا

360
00:21:08,740 --> 00:21:11,120
.أيّ تعابيرٍ يحمل يا ترى

361
00:21:11,120 --> 00:21:12,200
!احترسي

362
00:21:17,290 --> 00:21:19,750
.كنتُ أعرف أنّكم لم تنتهوا بعد

363
00:21:19,750 --> 00:21:22,260
.أفراد الزّينسي عنيدون بحقّ

364
00:21:23,210 --> 00:21:27,550
!كلاّ! لا ننتمي للزّينسي

365
00:21:28,140 --> 00:21:30,260
.لا تغضب

366
00:21:30,260 --> 00:21:32,850
.فكّرتُ في أنّ هذا هو السّبيل الوحيد للقائك

367
00:21:33,720 --> 00:21:35,770
لستما من الزّينسي؟

368
00:21:35,770 --> 00:21:38,440
.الزّينسي مهتمّون به

369
00:21:38,440 --> 00:21:42,020
.هذا يعني أنّ بقيّة عالم الدّخلاء سيشاركونهم الأمر

370
00:21:42,650 --> 00:21:45,990
.كما ستقع حادثةٌ سيكون هو مركزها

371
00:21:45,990 --> 00:21:47,910
.هذا ما أشعر به

372
00:21:48,450 --> 00:21:54,500
.سيجلب تشو سوران تغييرًا كبيرًا لعالم الدّخلاء حتمًا

373
00:23:25,290 --> 00:23:27,760
،يظهر أمام سوران المختطف منظّمتان جديدتان

374
00:23:27,760 --> 00:23:31,470
.وهما تينغيكاي وتينشفتو

375
00:23:31,470 --> 00:23:35,350
.أساليبهما الإجباريّة تفجّر غضب سوران

376
00:23:35,350 --> 00:23:38,390
:"الحلقة القادمة من "هيتوري نو شيتا - المنبوذ

377
00:23:38,390 --> 00:23:40,720
."إله الرّعد"