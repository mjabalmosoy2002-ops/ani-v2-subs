1
00:02:21,440 --> 00:02:23,190
انتهيتُ تقريباً

2
00:02:23,190 --> 00:02:26,210
،ما إن تُدمَّر نقاط الوخز الحيويّة

3
00:02:26,210 --> 00:02:29,520
تتوقّف هذه الخطوط عن العمل

4
00:02:29,900 --> 00:02:34,210
بما أنّ زعيم الطّائفة لم يُوافق
،أبداً على هذا الوادي

5
00:02:34,210 --> 00:02:36,680
فسأُدمّره بنفسي

6
00:02:37,840 --> 00:02:40,260
هذه المِحنة بأكملها انتهت أخيراً

7
00:02:40,260 --> 00:02:41,580
من قال بأنّها انتهت؟

8
00:02:41,580 --> 00:02:42,470
ماذا؟

9
00:02:42,770 --> 00:02:47,240
لِمَ تعتقد بأنّني أعطيتُ زانغ تشولان
رقم هاتفي إذاً؟

10
00:02:47,240 --> 00:02:50,080
،حتّى لو لم يتواصل معي ذلك الفتى

11
00:02:50,080 --> 00:02:51,920
سوف أتّصل به بنفسي

12
00:02:51,920 --> 00:02:53,970
تتّصلين به؟ لماذا؟

13
00:03:03,740 --> 00:03:05,430
من أنتِ؟

14
00:03:05,970 --> 00:03:07,970
من هما والداك؟

15
00:03:10,060 --> 00:03:12,520
من هو سيّدك؟

16
00:03:13,800 --> 00:03:15,120
حرمَني سيّدي من الحديث عن ذلك

17
00:03:15,640 --> 00:03:20,210
صحيح، لطالما شعرتُ بأنّ فينغ
،باوباو بدت مألوفة

18
00:03:20,210 --> 00:03:22,390
لكن لا ينبغي أن أكون قد التقيتُ بها سابقاً

19
00:03:23,190 --> 00:03:26,060
أنت لم تلتقِ بها سابقاً فعلاً

20
00:03:26,800 --> 00:03:30,220
"لا يوجد كنوز في كهف "ما هو الإنسان

21
00:03:30,220 --> 00:03:35,350
إنّه لا يحتوي إلّا على أشياء
يُقيّمها زعيم الطّائفة

22
00:03:35,350 --> 00:03:40,440
العديد منّا في طائفة تشوان شينغ
قد رأوا بعضاً من تلك الأشياء من قبل

23
00:03:44,720 --> 00:03:46,350
...زانغ تشولان

24
00:03:50,600 --> 00:03:52,190
ماذا تفعل يا سان؟

25
00:03:53,310 --> 00:03:56,020
أخذت باوباو وشا ليوتشينغ من تشوان
،شينغ في مهمّة دون علمنا

26
00:03:56,020 --> 00:03:57,720
وتورّطت مع شخص مثل وانغ زينتشيو

27
00:03:57,720 --> 00:04:01,060
هل تعي حجم الخطر الّذي
عرّضت باوباو له؟

28
00:04:01,390 --> 00:04:03,230
هل فكّرت في العواقب؟

29
00:04:03,230 --> 00:04:04,560
ماذا تعتقد بأنّك تفعل؟

30
00:04:04,560 --> 00:04:05,640
...سان

31
00:04:07,750 --> 00:04:08,930
كان ذلك خطيراً بالفعل

32
00:04:13,950 --> 00:04:15,280
افتحه وألقِ نظرة

33
00:04:16,030 --> 00:04:16,970
...هذا

34
00:04:17,290 --> 00:04:19,090
كنز أو غينشينغ

35
00:04:19,930 --> 00:04:21,680
صادفَ وأن حصلتُ عليها

36
00:04:24,510 --> 00:04:25,490
...هذه

37
00:04:26,390 --> 00:04:27,500
باوباو؟

38
00:04:30,400 --> 00:04:33,110
،كنتُ أوّل من دخل آنذاك

39
00:04:33,930 --> 00:04:36,430
فوجدتُ أمامي هذه الصّورة

40
00:04:36,430 --> 00:04:38,720
،آنذاك، كان من المستحيل لي أن آخذها

41
00:04:38,720 --> 00:04:40,390
لذا التقطتُ صورة بهاتفي فقط

42
00:04:40,730 --> 00:04:42,500
كان نار الولّاعة ضعيفاً جدّاً

43
00:04:42,500 --> 00:04:45,560
كان عليّ الحرص على أن تُدمَّر
اللّوحة بأكملها، بما في ذلك الجنفاص

44
00:04:45,560 --> 00:04:49,770
كان عليّ إكراه نفسي على تحطيمها
بتقنيّة كفّ الرّعد

45
00:04:49,770 --> 00:04:53,140
عرفتُ بأنّ الرّماد الأسود على الأرض
،قد يُثير الشّكوك

46
00:04:53,140 --> 00:04:56,290
لكن لم أمتلك القوّة أو الوقت ببساطة
للتّعامل مع الأمر آنذاك

47
00:04:57,250 --> 00:05:00,060
حالما وصلتُ إلى المدينة، طبعتُ الصّورة وحذفتُها

48
00:05:02,800 --> 00:05:05,850
،بوجود شخص يُدعى إيرزهوانغ حولي
كان عليّ أن أتوخّى الحذر

49
00:05:07,680 --> 00:05:11,100
لكن... لماذا قلت بأنّه حتّى
نحن لا يمكن الوثوق بنا؟

50
00:05:12,190 --> 00:05:13,770
كان ليُراودني نفس الشّعور

51
00:05:13,770 --> 00:05:16,350
لم يعُد هناك مَن يُوثَق به فعلاً

52
00:05:16,350 --> 00:05:19,950
آسف، شكّي بكما يعتمد على المنطق فقط

53
00:05:19,950 --> 00:05:22,970
عاطفيّاً، أنتما جديران بثقة
باوباو أكثر منّي

54
00:05:23,350 --> 00:05:25,600
سان، ألا تفهم؟

55
00:05:25,600 --> 00:05:27,680
...الشّيء الّذي لطالما اهتمّ به أبي قد

56
00:05:27,680 --> 00:05:30,000
،كنز أو غينشينغ أُخِذَ منذ زمن بعيد

57
00:05:30,000 --> 00:05:32,150
مع ذلك تُرِكت هذه اللّوحة

58
00:05:32,150 --> 00:05:34,890
،إذا كان الشّخص في هذه اللّوحة هي باور فعلاً

59
00:05:35,430 --> 00:05:37,500
،فالشّخص الّذي كان يبحث عنه جدّي شو

60
00:05:39,350 --> 00:05:42,810
شخص كان يعرف باور، قد ظهرَ أخيراً

61
00:05:47,280 --> 00:05:50,970
إذا كانت هذه اللّوحة قد تُرِكت لي
،ولباور بشكل مُتعمَّد

62
00:05:51,320 --> 00:05:53,930
فكيف علموا بأنّنا سنذهب إلى هناك إذاً؟

63
00:05:55,210 --> 00:05:59,970
لو جين؟ ألم تقل بأنّ لو جين
ذكرَ الجدّة جينفينغ لك؟

64
00:05:59,970 --> 00:06:04,560
أجل، لكن الشّخص الّذي عرّفَني أوّلاً على الجدّة
جينفينغ لم يكن المُعلّم لو

65
00:06:04,560 --> 00:06:05,840
...كان

66
00:06:06,710 --> 00:06:08,250
...آنذاك

67
00:06:09,190 --> 00:06:10,300
في قرية بيو

68
00:06:10,970 --> 00:06:14,880
تشين دو بنفسها قالت بأنّها كانت
قد كُلِّفت فجأة بأسر جينفينغ

69
00:06:14,880 --> 00:06:18,270
تزامن التّوقيتُ بالضّبط مع قبضنا
على تشين دو

70
00:06:19,100 --> 00:06:23,310
بعد ذلك، أسر تشين دو سلّط
الضّوء على جينفينغ

71
00:06:23,310 --> 00:06:27,020
والمعلومات الّتي وفّرتها جينفينغ
"قادتنا إلى كهف "ما هو الإنسان

72
00:06:27,950 --> 00:06:31,990
ثمّ جهّزوا التّرتيبات لأولئك
،الغُرباء في وقت مُسبَق

73
00:06:31,990 --> 00:06:36,140
ومن بينهم، امرأة واحدة كان من الواضح
أنّها مُستعدّة للتّعامل مع باور

74
00:06:37,540 --> 00:06:38,500
ما الهدف؟

75
00:06:38,500 --> 00:06:39,430
ليس واضحاً بعد

76
00:06:40,190 --> 00:06:42,340
،إن كان تخميني صحيحاً

77
00:06:42,340 --> 00:06:44,390
فلا شيء من هذا صدفة

78
00:06:44,390 --> 00:06:46,650
هل تفهم الآن؟

79
00:06:46,650 --> 00:06:50,180
لتنسيق كلّ هذا، يجب أن يستوفوا شرطين

80
00:06:50,180 --> 00:06:53,330
أوّلاً، معرفة تحرُّكات باوباو وتشولان

81
00:06:53,820 --> 00:06:56,520
ثانياً، فهم الشّركة فهماً جيّداً

82
00:06:56,520 --> 00:06:58,880
كلانا نستوفي هذه الشّروط

83
00:06:58,880 --> 00:07:00,350
الوحيدون القادرون على فعل هذا

84
00:07:00,720 --> 00:07:04,060
هم الشّخصيّات البارزة القادرة على
نشر عاملين مُؤقّتين آنذاك

85
00:07:04,060 --> 00:07:05,640
المُشتبه بهم موجودون بينهم

86
00:07:06,030 --> 00:07:07,330
هل هذا وقت مُلائم؟

87
00:07:08,630 --> 00:07:11,760
إن أمكن، أودّ اللّقاء معك لمُناقشة هذا

88
00:07:14,200 --> 00:07:15,180
حسناً

89
00:07:16,720 --> 00:07:18,020
ما الأمر يا أختي؟

90
00:07:18,560 --> 00:07:20,260
...مُثير

91
00:07:20,260 --> 00:07:23,180
رئيس الشّركة، زاو فانغشو، يريد مُقابلتي

92
00:07:24,390 --> 00:07:26,250
ليس عليكِ القلق بشأن هذا

93
00:07:26,250 --> 00:07:27,310
كيف حال الأتون؟

94
00:07:27,810 --> 00:07:30,700
لديّ الخبرة الآن، لذا سيتمّ الأمر بسرعة

95
00:07:30,700 --> 00:07:31,890
...الأمر فقط

96
00:07:33,430 --> 00:07:34,770
تعال معي

97
00:07:37,180 --> 00:07:39,270
،،آنذاك عندما أسّستَ قرية بيو

98
00:07:39,270 --> 00:07:42,890
ألم يكن لجمع المنبوذين القادرين
على توفير عيّنات للأتون؟

99
00:07:43,210 --> 00:07:45,560
أنا لا أُعارض ما تفعله

100
00:07:45,560 --> 00:07:47,890
كلّ ما في الأمر هو أنّك
لم تكن حذراً بما يكفي

101
00:07:48,480 --> 00:07:50,580
أتتذكّر مُتحوّلي شانغينتشي الإثني عشر؟

102
00:07:50,580 --> 00:07:52,970
في النّهاية، كشفَتِ الشّركةُ أمرهم
رغم ذلك، صحيح؟

103
00:08:02,950 --> 00:08:06,400
هؤلاء الـ 15 شخصاً يُشكّلون أنواعَ
مُختلفة من قوى المنبوذين

104
00:08:06,400 --> 00:08:08,320
ينبغي أن يكفوا لسدّ حاجاتك

105
00:08:10,200 --> 00:08:12,940
،لا أحد يعلم بشأن ارتباطهم بنا

106
00:08:12,940 --> 00:08:14,920
لذا لن تُثار شكوكهم

107
00:08:18,700 --> 00:08:22,220
،لطالما شعرتُ بأنّكِ لو كنتِ أنتِ يا أختي

108
00:08:22,220 --> 00:08:24,700
لكان الأتون المثاليّ قد بُني منذ زمن بعيد

109
00:08:24,700 --> 00:08:26,320
انسَ الأمر

110
00:08:26,320 --> 00:08:31,380
،لا أستطيع إتقان تقنيّات عاديّة
ناهيك عن الحِرفيّة القدسيّة

111
00:08:31,380 --> 00:08:35,140
كلّ ما يمكنني فعله هو دعمك

112
00:08:35,140 --> 00:08:37,930
شيانهونغ، ثِق بي

113
00:08:37,930 --> 00:08:40,270
،ما دمت تستطيع بناء أتون التّنمية المثاليّة

114
00:08:40,270 --> 00:08:42,910
ستستعيد حتماً ذكرياتك المُجتزأة

115
00:08:43,560 --> 00:08:46,220
دعونا ألّا نُخمّن علاقة باوباو بأو غينشينغ حاليّاً

116
00:08:46,680 --> 00:08:47,890
،في الوضع الرّاهن

117
00:08:47,890 --> 00:08:49,840
يبدو أنّ الشّخص الّذي يقف وراء الكواليس

118
00:08:49,840 --> 00:08:52,680
يعرف حتّى الآن عن باوباو أكثر ممّا نعرف

119
00:08:52,680 --> 00:08:55,600
إذا عثرنا عليه، فسيتوضّح كلّ شيء

120
00:08:55,600 --> 00:08:56,960
الأمر ليس بتلك البساطة

121
00:08:56,960 --> 00:09:00,350
إذا كان عليه تكبُّد كلّ هذا العناء
،فقط لنقل بعض المعلومات

122
00:09:00,350 --> 00:09:02,560
فلا بُدّ أنّ لديه بعض التحفُّظات

123
00:09:02,560 --> 00:09:03,920
تحفُّظات؟

124
00:09:03,920 --> 00:09:05,360
تحفُّظات بشأن ماذا؟

125
00:09:05,360 --> 00:09:06,640
لا أعلم

126
00:09:06,640 --> 00:09:10,640
باوباو، رؤية هذه اللّوحة لا يحرّك
أي ذكريات إطلاقاً؟

127
00:09:15,200 --> 00:09:16,060
!لا

128
00:09:17,530 --> 00:09:19,530
،لا يهمّني ما هي تحفُّظاته

129
00:09:19,530 --> 00:09:23,490
!لكن وجود شخص كهذا يُصيبني بالتوتُّر الشّديد

130
00:09:23,490 --> 00:09:24,350
أنا أيضاً

131
00:09:24,350 --> 00:09:26,800
لذا هناك شيء آخر علينا التحدُّث حوله

132
00:09:27,780 --> 00:09:28,850
هل تعرف زانغ لينغيو؟

133
00:09:28,850 --> 00:09:31,570
الرّئيس زاو ذكرَه لنا

134
00:09:31,570 --> 00:09:33,680
يرديك أن تضمّه للشّركة

135
00:09:34,600 --> 00:09:37,480
ماذا؟ ندع زانغ لينغيو يعمل بجانب باوباو؟

136
00:09:37,480 --> 00:09:38,970
!مستحيل! قطعاً لا

137
00:09:38,970 --> 00:09:41,670
لِمَ ينبغي أن نضع غريباً مثل زانغ
لينغيو بجانب باوباو؟

138
00:09:41,670 --> 00:09:44,930
سان، ناقشتُ هذا مع باور، وقد وافقتْ

139
00:09:44,930 --> 00:09:46,570
ماذا تقصد بـ"وافقت"؟

140
00:09:46,570 --> 00:09:48,700
هل لديها الحكمة لتُقرّر هذا؟

141
00:09:48,700 --> 00:09:51,060
باوباو، هل تعرفين مدى خطورة هذا؟

142
00:09:51,060 --> 00:09:53,040
قال زانغ تشولان بأنّ الأمور ستكون بخير

143
00:09:53,040 --> 00:09:56,220
،كلّما قضى زانغ لينغيو وقتاً أطول معي
قلّتْ احتمالات أذيّته لي

144
00:09:56,220 --> 00:09:57,890
وماذا لو حدث شيء؟

145
00:09:57,890 --> 00:10:00,560
زانغ تشولان، هل تتعامل مع سلامة
باوباو كنكتة؟

146
00:10:01,160 --> 00:10:03,700
سان، لقد فكّرتُ في هذا

147
00:10:03,700 --> 00:10:07,470
تحتاج باوباو لقوّة معها والوقت
!للتّحضير لأي احتماليّة

148
00:10:07,470 --> 00:10:09,470
!سي وأنا نُمثّل القوّة خلف باوباو

149
00:10:09,470 --> 00:10:10,450
هذا لا يكفي

150
00:10:11,280 --> 00:10:12,100
!مع ذلك، لا

151
00:10:12,100 --> 00:10:13,640
زانغ لينغيو جدير بالمُخاطرة

152
00:10:13,640 --> 00:10:15,140
...لِمَ علينا المُجازفة أصلاً

153
00:10:15,460 --> 00:10:17,330
هذا يكفي يا سان

154
00:10:17,330 --> 00:10:18,640
اهدأ

155
00:10:18,640 --> 00:10:21,080
لِمَ علينا أن نُجازف؟

156
00:10:21,080 --> 00:10:23,680
!لأنّ الوضع فظيع

157
00:10:23,680 --> 00:10:26,500
لطالما كانت أفضليّتنا الكبرى
البقاء مُتخفّيين

158
00:10:26,500 --> 00:10:28,290
،لا أحد يعلم ما نفعله

159
00:10:28,290 --> 00:10:29,600
أو ما هو هدفنا

160
00:10:30,000 --> 00:10:32,470
لكن هذه اللّوحة كشفَتْنا الآن

161
00:10:32,470 --> 00:10:35,340
التخفّي بحذر لا جدوى منه في هذه اللّحظة

162
00:10:35,340 --> 00:10:36,180
،في هذه اللّحظة

163
00:10:36,180 --> 00:10:39,580
أين المُشكلة في المُجازفة لتشكيل
حليف" مُحتمَل؟"

164
00:10:40,620 --> 00:10:44,830
،سان، لولا طلب أبي

165
00:10:44,830 --> 00:10:46,810
هل كنت لتحمي باوباو مع ذلك؟

166
00:10:47,490 --> 00:10:48,160
!بالطّبع

167
00:10:48,160 --> 00:10:48,990
لماذا؟

168
00:10:48,990 --> 00:10:50,850
لـ-لماذا؟

169
00:10:51,990 --> 00:10:54,810
لأنّ هذه هي طبيعتنا كأشخاص

170
00:10:54,810 --> 00:10:57,440
هل كلّ الأخيار في العالم موجودون في عائلتنا؟

171
00:10:57,440 --> 00:11:00,060
هل أنت متأكّد بأنّ زانغ لينغيو
ليس ذلك النّوع من الأشخاص؟

172
00:11:02,350 --> 00:11:04,220
قد يكون هناك مُرشّحون آخرون

173
00:11:05,870 --> 00:11:09,140
ما زلتُ قلقاً بشأن تلك اليد
الّتي مُدَّتْ إلى باور

174
00:11:09,810 --> 00:11:12,180
سان، سي، هل تعرفان ما حدث
مع عشيرة ليو؟

175
00:11:12,510 --> 00:11:13,490
عشيرة ليو؟

176
00:11:15,380 --> 00:11:17,020
إنّها عشيرة مُزعجة حقّاً

177
00:11:17,020 --> 00:11:18,300
ماذا عن عشيرة ليو؟

178
00:11:18,850 --> 00:11:20,460
على ذكر الأمر، هذا غريب

179
00:11:20,460 --> 00:11:22,710
،خرجتْ مجموعةٌ منهم

180
00:11:22,710 --> 00:11:24,850
لكن جميعهم عادوا بسرعة إلى قريتهم

181
00:11:30,960 --> 00:11:33,950
أبي، ما زال ليو ليانغ لا يتكلّم

182
00:11:33,950 --> 00:11:35,040
ما رأيك؟

183
00:11:37,230 --> 00:11:39,440
،ما فعله كان مُنافياً للعقل

184
00:11:39,440 --> 00:11:41,650
لكن يبقى شخصاً شُجاعاً

185
00:11:41,650 --> 00:11:43,970
كما هو مُتوقَّع من عضو من عشيرة ليو

186
00:11:49,470 --> 00:11:52,080
،من بين كافّة عشائر المنبوذين الّذين قابلتُهم

187
00:11:52,080 --> 00:11:54,010
عشيرة ليو هي الأكثر عِناداً

188
00:11:54,010 --> 00:11:56,800
لديهم هوَسٌ غير عاديّ بالسّلالة والنّسب

189
00:11:56,800 --> 00:12:00,520
لكن أتفهّم ذلك، نظراً لقدرتهم
في التحكُّم بعقول الآخرين

190
00:12:00,950 --> 00:12:03,360
،إنّها قرية معزولة بشكل استثنائيّ

191
00:12:03,360 --> 00:12:06,050
حيث قِواك هي ما يُحدّد حالتك

192
00:12:06,050 --> 00:12:08,100
:عشيرة ليو تورّث مهارتين

193
00:12:08,100 --> 00:12:09,310
،ريوي جين المُكتسَبة

194
00:12:09,310 --> 00:12:11,430
ومهارة الرّوح المُشرِقة الفطريّة

195
00:12:11,430 --> 00:12:14,110
أولئك الّذين لا يستطيعون تنمية التشي
،يُديرون أعمال العشيرة

196
00:12:14,110 --> 00:12:16,840
لكن ليس لديهم أيّ رأي
في شؤون العشيرة

197
00:12:16,840 --> 00:12:19,410
حتّى لو غادر عضو عشيرة
،القرية وهو لا يملك قوى

198
00:12:19,410 --> 00:12:21,680
لا يستطيع قطع روابطه بالعشيرة

199
00:12:21,680 --> 00:12:26,380
،كلّ تصرّفاتهم مُراقبة بواسطة القرية
ولا سيّما مسألة الزّواج

200
00:12:27,120 --> 00:12:29,170
هذا غير إنسانيّ البتّة، أليس كذلك؟

201
00:12:29,170 --> 00:12:31,810
لا أعلم فيما إذا تمرّد أحد
أعضاء عشيرة ليو يوماً

202
00:12:31,810 --> 00:12:34,410
معظم النّاس في القرية يحملون لقب ليو

203
00:12:34,410 --> 00:12:36,560
وبالنّسبة للغُرباء القلّة، فجميعهم ذكور

204
00:12:37,460 --> 00:12:39,440
عشيرة ليو لا تقبل إلّا الأصهار

205
00:12:39,440 --> 00:12:42,510
،يتعاملون مع الأصهار بشكل جيّد

206
00:12:42,510 --> 00:12:46,290
لكن تبقى مكانتهم هي الأدنى في القرية

207
00:12:46,850 --> 00:12:49,100
ريوي جين لا تُنقَل إلّا للذّكور، لا للإناث

208
00:12:49,100 --> 00:12:51,440
،بالتحكُّم بهؤلاء الأصهار

209
00:12:51,440 --> 00:12:55,240
يضمنون بأنّ كافّة المُستخدمين الموقَظين ذوي
مهارة الرُّوح المُشرِقة يحملون لقبَ ليو

210
00:12:55,240 --> 00:12:59,050
من خلال هذه السُّبُل، يُحافظون على
،التحكُّم بقوى المنبوذين خاصّتهم

211
00:12:59,050 --> 00:13:00,510
ليعلوا فوق الآخرين

212
00:13:01,500 --> 00:13:06,690
الشّخص الّذي يتحكّم بالعشيرة بأكملها
حاليّاً هو قائد العشيرة، ليو تشي

213
00:13:26,020 --> 00:13:28,900
!أخي، أنت مُذهل حقّاً

214
00:13:28,900 --> 00:13:30,420
!إنّك تتحسّن

215
00:13:30,420 --> 00:13:33,100
لن أتمكّن من مُجاراة الريوي جين
في حياتي كلّها

216
00:13:34,180 --> 00:13:35,510
وما الفائدة؟

217
00:13:35,510 --> 00:13:37,000
كيف لي أن أُقارَن بك؟

218
00:13:37,000 --> 00:13:38,310
فأنت تفوز بصورة تلقائيّة

219
00:13:38,630 --> 00:13:41,590
!لا تكُن كذلك

220
00:13:41,590 --> 00:13:44,310
!الموهبة الفطريّة! لا أحد يعلم متى تمّ إيقاظها

221
00:13:44,310 --> 00:13:48,520
كفى هراء. على أيّ حال، لم أسمع بشخص
مرّ بحالة إيقاظ بعد سنّ 30

222
00:13:48,520 --> 00:13:51,560
حسناً، فليكُن

223
00:13:51,560 --> 00:13:53,390
هل هذا يعني بأنّك هالك؟

224
00:13:53,390 --> 00:13:56,020
،انظر، تحت والد جدّنا

225
00:13:56,020 --> 00:13:58,090
،هناك جدّنا زونغ، وعمّ والدنا الثّاني شياو

226
00:13:58,090 --> 00:13:59,900
وعمّة والدنا الثّالثة، وعمّ والدنا الرّابع إي

227
00:13:59,900 --> 00:14:01,470
جدّنا وعمّة والدنا الثّالثة قد تمّ إيقاظ قوّتهما

228
00:14:01,470 --> 00:14:03,350
بينما عمّ والدنا الثّاني والرّابع لم يفعلا

229
00:14:03,350 --> 00:14:05,890
لكن ريوي جين الخاصّة بعمّ والدنا
الثّاني قد نُقِلَتْ عن والد جدّنا

230
00:14:05,890 --> 00:14:07,990
عمّ والدنا الرّابع لم يكن ببساطة
مُؤهّلاً لتنمية التشي

231
00:14:07,990 --> 00:14:09,560
والد جدّنا لم يُفضّله ببساطة

232
00:14:09,560 --> 00:14:13,020
لذا آنذاك، قيل بأنّ الشّخص الّذي
نال استحسان والد جدّنا

233
00:14:13,020 --> 00:14:16,400
كان جدّنا، الّذي امتلكَ كلّاً من روي جين
!ومهارة الرُّوح المُشرِقة

234
00:14:18,930 --> 00:14:21,680
،لكن في الجيل الثّالث، جيل الأعمام
اتّخذت الأمور منحى غريباً

235
00:14:21,960 --> 00:14:25,760
الجيل بأكمله أنتجَ عدداً
،من مُنمّيي التشي الواعدين

236
00:14:25,760 --> 00:14:27,770
!لكن قلّة منهم مَن استيقظت قواهم

237
00:14:27,770 --> 00:14:31,150
وكان مستواهم بعيداً كلّ البُعد
عن جدّي وعمّة والدة الثّالثة

238
00:14:31,770 --> 00:14:34,440
لكن عليك أن تعترف، عندما يتعلّق
،الأمر بالتّنمية المُكتسَبة

239
00:14:34,440 --> 00:14:37,060
لا يوجد أحدٌ بالكاد في العشيرة
يعترف به والد جدّنا

240
00:14:37,060 --> 00:14:40,810
حتّى بمن فيهم والدنا، هل كان ليُعيد
النّظر بشأن هؤلاء الأعمام حقّاً؟

241
00:14:42,470 --> 00:14:44,520
،لكن من كان يتوقّع، أنّه في جيلنا

242
00:14:44,520 --> 00:14:46,180
سيوقظ الكثير منهم مهارة الرُّوح المُشرقة؟

243
00:14:46,180 --> 00:14:48,130
،أبناء العديد من العائلات قد استيقظت قواهم

244
00:14:48,130 --> 00:14:49,600
ومستواهم ليس بذلك السّوء

245
00:14:50,190 --> 00:14:52,220
بالطّبع، والد جدّنا سعيد

246
00:14:52,220 --> 00:14:56,020
،لكن إذا ما تحدّثنا عن الأقوى في هذا الجيل

247
00:14:56,020 --> 00:14:59,080
،فلا بُدّ أنّهم ابناء ابن وابنة عمّ والدنا الثّاني

248
00:14:59,080 --> 00:15:02,220
أبناء العمّ بينغ والعمّة فينغ

249
00:15:02,600 --> 00:15:05,100
العمّ بينغ أنجب الأخوين ليو غونغ وليو ليانغ

250
00:15:05,100 --> 00:15:08,890
لكن الأكثر تميُّزاً بينهم لا بُدّ أنّه
ابنة العمّة فينغ، ليو هوان

251
00:15:09,200 --> 00:15:11,820
كانت المُستخدمة الأقوى لمهارة
،الرُّوح المُشرِقة في العشيرة بأكملها

252
00:15:11,820 --> 00:15:14,270
وموهبتها تجاه التّنمية المُكتسَبة
كانت عالية جدّاً أيضاً

253
00:15:14,580 --> 00:15:17,750
والد جدّنا استثناها عن الآخرين
!وعلّمها ريوي جين

254
00:15:17,750 --> 00:15:20,430
وبهذا الشّكل، عمّ والدنا الثّاني
،الّذي لم يكن مُلفِتاً سابقاً

255
00:15:20,430 --> 00:15:23,810
مع كامل فروعه، شهِدوا ارتفاعاً
!كبيراً ومُفاجئاً في المكانة

256
00:15:24,140 --> 00:15:28,070
العمّ بينغ! من يكون؟ إنّه ببساطة
!غير مُؤهّل لتنمية التشي إطلاقاً

257
00:15:28,070 --> 00:15:31,000
لكن الآن، حتّى هو يستطيع التكلّم
في حضرة والد جدّنا بضع كلمات

258
00:15:31,000 --> 00:15:34,310
عمّ والدنا الثّاني أصبح ثاني أعلى
تصنيف في العشيرة بعد والد جدّنا

259
00:15:35,420 --> 00:15:36,770
لكن الآن؟

260
00:15:36,770 --> 00:15:38,300
!كلّ شيء قد تغيّر

261
00:15:39,070 --> 00:15:41,110
،القاتل هو ليو ليانغ

262
00:15:41,110 --> 00:15:42,930
وقد انتهى تماماً

263
00:15:43,350 --> 00:15:47,310
بصفته أخوه البيولوجيّ، لا يستطيع
ليو غونغ أن يعتزّ بالعشيرة أيضاً

264
00:15:47,310 --> 00:15:50,350
لم يبقَ لدى عمّ والدنا أي سليل بارز آخر

265
00:15:50,350 --> 00:15:52,000
،وسط الجيل الأصغر سنّاً

266
00:15:52,000 --> 00:15:55,020
،من ما زال يستطيع مُنافتنا نحن
سليلي جدّنا؟

267
00:15:55,020 --> 00:15:59,470
لذا كما ترى، كُلّ ما علينا فعله هو الجلوس
والضّحك على عمّ والدنا الثّاني

268
00:15:59,470 --> 00:16:02,940
جميعنا أخوة، فلِمَ نخلق صِراعاً بيننا؟

269
00:16:03,660 --> 00:16:07,520
لكن أخبرني، هل تعتقد فعلاً بأنّ ليو ليانغ
قد قتلَ هوان بالخطأ؟

270
00:16:08,030 --> 00:16:09,920
لم يعترف بذلك أبداً

271
00:16:09,920 --> 00:16:12,770
لو كنتُ مكانه، لاعترفتُ منذ زمن
!بعيد بهذا النّوع من الاستجواب

272
00:16:12,770 --> 00:16:16,170
طُلِبَ منّي أيضاً في الماضي
استجواب ذلك الفتى ليو ليانغ

273
00:16:16,170 --> 00:16:19,630
كانت كلّ ذكرياته مُختلطة. غريب، أليس كذلك؟

274
00:16:19,630 --> 00:16:21,390
!في الواقع استخدمَ قوّته على نفسه

275
00:16:21,890 --> 00:16:23,640
ا-استخدمها على نفسه؟

276
00:16:23,640 --> 00:16:26,720
أجل، يمكنك فعل مُختلف الأشياء
بمهارة الرُّوح المُشرِقة

277
00:16:26,720 --> 00:16:30,060
المسألة لا تتعلّق فقط باختبار أو النّظر
إلى ذكريات الآخرين

278
00:16:30,060 --> 00:16:33,360
وصلَ ليو ليانغ إلى مستوى يفوق استيعابي بالفعل

279
00:16:33,360 --> 00:16:36,960
وقيل بأنّ ليو هوان تفوق ليو ليانغ بكثير

280
00:16:39,320 --> 00:16:41,000
كُفّ عن التّفكير في الأمر

281
00:16:41,000 --> 00:16:43,100
ليو ليانغ قتلَ ليو هوان

282
00:16:43,680 --> 00:16:44,950
!كان هو

283
00:16:55,060 --> 00:16:56,140
كُل

284
00:16:59,770 --> 00:17:02,470
!هل تدّعي الموت أم ماذا؟ كُل

285
00:17:02,820 --> 00:17:05,850
،أتعتقد بأنّك إذا ادّعيت الصّلابة فحسب
فسوف أحترمك؟

286
00:17:06,250 --> 00:17:08,810
أتعتقد نفسك بأمان لأنّك تستطيع
تحمّل الضّرب؟

287
00:17:08,810 --> 00:17:12,060
أتعتقد أنّ بنكران ذلك، ستزول هذه المسألة؟

288
00:17:14,550 --> 00:17:16,150
!قُل شيئاً

289
00:17:16,150 --> 00:17:18,210
!أبي! جدّي

290
00:17:18,210 --> 00:17:20,970
!بسببك، فقدا اعتزازهما في القرية

291
00:17:21,810 --> 00:17:23,180
!ليس هناك ما هو أسوأ من ذلك

292
00:17:23,760 --> 00:17:26,490
الطّريقة الوحيدة الّتي يمكنك من خلالها
التّكفير عن خطاياك الآن

293
00:17:26,490 --> 00:17:29,850
!هي إخبار الجميع بما حدث في ذلك اليوم

294
00:17:30,280 --> 00:17:33,680
على الأقلّ أبلغ العشيرة كيف
!ماتت هوان فعليّاً

295
00:17:34,540 --> 00:17:39,180
ألم أخبركم بالفعل... بما حدث في ذلك اليوم؟

296
00:17:39,510 --> 00:17:40,800
أخبرتُكم

297
00:17:40,800 --> 00:17:43,100
أخبرتُكم منذ البداية

298
00:17:45,090 --> 00:17:47,280
أنت أحد المُوقَظين كذلك

299
00:17:47,280 --> 00:17:50,850
ينبغي لك أن تتمكّن على الأقلّ
من معرفة ما إن كنتُ أكذب، صحيح؟

300
00:17:51,300 --> 00:17:55,130
نسختَ ذكرياتي، أليس كذلك؟

301
00:17:58,870 --> 00:18:03,200
إذاً... هذا ما جعلَك صامداً
طوال هذا الوقت

302
00:18:04,980 --> 00:18:09,930
بعد موت ليو هوان، أصبحتَ المُستخدم
الأقوى لمهارة الرُّوح المُشرِقة

303
00:18:09,930 --> 00:18:14,700
تعرف تمام المعرفة بأنّه عندما يتعلّق الأمر
،بفحص ذكريات شخص بشكل شامل

304
00:18:14,700 --> 00:18:17,030
بمعزلٍ عنك، أنا الوحيد القادر على
فعلها، وبالكاد أيضاً

305
00:18:17,660 --> 00:18:20,060
لكن لا أملك فكرة كم سيستغرق ذلك من وقت

306
00:18:20,550 --> 00:18:25,200
إذاً على الأقلّ يمكنك التحقُّق
!من وضعي الحاليّ

307
00:18:25,200 --> 00:18:29,680
تمّ ختمي الآن، لذا لا أستطيع استخدام
!مهارة الرُّوح المُشرِقة لمُقاومتك

308
00:18:29,680 --> 00:18:33,400
!هيّا! تأكّد ما إن كنتُ أكذب

309
00:18:33,400 --> 00:18:34,770
!هيّا

310
00:18:38,640 --> 00:18:41,140
...قالت هوان لي ذات مرّة

311
00:18:41,760 --> 00:18:45,020
هوان! أليس أخاكِ ليو غونغ
فتى وسيماً؟

312
00:18:45,020 --> 00:18:46,430
بلى

313
00:18:46,430 --> 00:18:48,590
!إنّها الحقيقة

314
00:18:48,590 --> 00:18:50,430
!وقلتِ بأنّ بوسعكِ الكذب عليّ

315
00:18:52,030 --> 00:18:54,410
،ليس أخي ليو غونغ وسيماً فحسب

316
00:18:54,410 --> 00:18:58,000
،لديه أيضاً ثلاثة رؤوس وستّة أيدٍ وثمانية أقدام

317
00:18:58,000 --> 00:19:00,960
...وإثنا عشر أنفاً وعشرون عيناً، وثلاثون

318
00:19:00,960 --> 00:19:02,850
!انتظري

319
00:19:02,850 --> 00:19:04,570
ما الّذي يجري؟

320
00:19:04,570 --> 00:19:07,020
كيف... كيف فعلت ذلك؟

321
00:19:08,850 --> 00:19:13,460
من وجهة نظركِ للتو، لم يكن
هناك أي أثر للكذب

322
00:19:13,460 --> 00:19:16,970
ولم أشعر باستخدامكِ لمهارة الرُّوح
المُشرِقة لمُقاومتي أيضاً

323
00:19:16,970 --> 00:19:19,800
لم أُقاوم، ولم أكذب عليك

324
00:19:19,800 --> 00:19:22,520
من وجهة نظري، كلّ ما قلتُه للتو
كان الحقيقة

325
00:19:22,930 --> 00:19:24,470
أيُعقَل ذلك؟

326
00:19:24,470 --> 00:19:29,200
أتعلم؟ بدأتُ أدرك بأنّ استخراج الذّكريات

327
00:19:29,200 --> 00:19:31,480
وكشف الأكاذيب من خلال التقلُّبات العقليّة

328
00:19:31,480 --> 00:19:34,850
هي مُجرّد أساسيّات لما تستطيع
مهارات الرُّوح المُشرقة فعله

329
00:19:35,170 --> 00:19:39,260
هذه الأيادي الزّرقاء تزداد قوّة ورشاقة

330
00:19:39,260 --> 00:19:44,700
يمكن الآن لمس أماكن في العقل بسهولة
بعد أن كان يستحيل بلوغها

331
00:19:44,700 --> 00:19:48,470
مؤخّراً، وجدتُ طريقة حتّى لتعديل العواطف

332
00:19:49,130 --> 00:19:51,940
،قبل قليل، بينما كنتُ أكذب

333
00:19:51,940 --> 00:19:55,020
كيّفتُ عقلي على حالة الصّدق

334
00:19:55,020 --> 00:19:56,720
"أطلق على هذا بـ"العاطفة السّلبيّة

335
00:19:57,860 --> 00:20:00,640
يمكنك... فعل شيء كهذا؟

336
00:20:00,640 --> 00:20:02,390
!هذا مُذهل

337
00:20:02,680 --> 00:20:04,950
لا، هذا لا يكفي

338
00:20:04,950 --> 00:20:07,520
نقل العواطف بشكل سلبيّ لم يكتمل بعد

339
00:20:07,520 --> 00:20:11,640
هذا يعني جوهريّاً بأنّني خدعتُ نفسي
عندما يتطلّب الوضع ذلك

340
00:20:11,960 --> 00:20:14,530
،حالما يزول الوضع الّذي يتطلّب كذبة

341
00:20:14,530 --> 00:20:16,300
فالكذبة تبقى كذبة

342
00:20:16,890 --> 00:20:18,180
،إذا استطعتُ إيجاد هذا المكان

343
00:20:18,620 --> 00:20:21,390
إذا كنتُ أستطيع حتّى التحكُّم
،بإدراك النّاس

344
00:20:21,390 --> 00:20:24,220
فأستطيع حينها إنشاء واقع
داخل الوعي الذّاتيّ

345
00:20:24,220 --> 00:20:26,030
سيكون هذا الخداع الأكثر مثاليّة

346
00:20:27,350 --> 00:20:31,020
إنشاء إدراك واقعيّ داخل وعي شخص

347
00:20:31,020 --> 00:20:34,840
إذاً هذا ما كان يُحيّركِ طوال
الأيّام القليلة الماضية؟

348
00:20:34,840 --> 00:20:37,310
!لا تقلقي! ستتمكّنين من فعلها حتماً

349
00:20:37,730 --> 00:20:39,680
!لا أحد في القرية أكثر مهارة منكِ

350
00:20:39,680 --> 00:20:41,560
لا يقتصر الأمر على ذلك

351
00:20:41,560 --> 00:20:43,640
ماذا؟ ما الأمر إذاً؟

352
00:20:44,670 --> 00:20:48,010
،أخي، لو فعلتُها حقّاً

353
00:20:48,010 --> 00:20:50,850
ألن تعتبرني مُرعِبة حينها؟

354
00:20:52,600 --> 00:20:54,890
...كيف أعبّر عن الأمر

355
00:20:54,890 --> 00:20:56,280
لا أستطيع شرحه تماماً

356
00:20:56,880 --> 00:20:59,760
،أريد حقّاً أن أفهم آليّة عمل ذلك

357
00:20:59,760 --> 00:21:01,680
لكن أنا خائفة قليلاً

358
00:21:02,010 --> 00:21:04,800
ما الّذي يجعلكِ تجلدين ذاتكِ هكذا؟

359
00:21:04,800 --> 00:21:06,090
ليس وكأنّني أستطيع فعلها

360
00:21:06,090 --> 00:21:08,350
لو كنتُ أستطيع، لرأيتِني أضحك في منامي

361
00:21:08,350 --> 00:21:11,530
تخشين من استخدامكِ لقوّة
هائلة كهذه لغرض الشّرّ؟

362
00:21:11,530 --> 00:21:13,180
!مستحيل

363
00:21:13,680 --> 00:21:16,070
لو كان ذلك الغبيّ ليو ليانغ، لقلقتُ أيضاً

364
00:21:16,070 --> 00:21:17,470
!لكنّكِ هوان

365
00:21:17,930 --> 00:21:19,540
تبقى القوى قوى

366
00:21:19,540 --> 00:21:21,360
!القوى لا تُغيّر طبيعتكِ

367
00:21:21,360 --> 00:21:23,680
حقّاً؟ هل أُبالغ في التّفكير؟

368
00:21:26,680 --> 00:21:30,430
ليو ليانغ، من حيث القدرات فعلاً، أنا مُعجب بك

369
00:21:30,760 --> 00:21:33,080
أنا مُعجب بك حقّاً

370
00:21:33,080 --> 00:21:35,220
،كنتَ قادراً غلى بلوغ هذا المستوى أيضاً

371
00:21:35,220 --> 00:21:37,020
القدرة على تعديل إدراكك

372
00:21:40,090 --> 00:21:41,770
هل جُننت يا ليو غونغ؟

373
00:21:42,160 --> 00:21:44,960
هل هناك أيّ شيء آخر في عقلك
سوى مهارة الرُّوح المُشرِقة؟

374
00:21:44,960 --> 00:21:49,270
!أنا شخص، لا آلة تحلّ كلّ شيء بالقوى

375
00:21:49,270 --> 00:21:52,030
!ماذا تريد منّي أن أفعل حتّى تُصدّقني؟

376
00:21:57,850 --> 00:21:58,770
والد جدّنا

377
00:21:59,690 --> 00:22:00,980
شانصرِف

378
00:22:12,080 --> 00:22:15,180
...عمّ والدي، جدّي، عمّة والدي الثّالثة

379
00:22:15,640 --> 00:22:18,550
...هل قرّر والد جدّنا بالفعل

380
00:22:19,550 --> 00:22:21,060
كيفيّة التّعامل مع ليو ليانغ؟

381
00:22:44,610 --> 00:22:47,060
...والد جدّنا، أنت

382
00:22:47,060 --> 00:22:49,620
،وافق على شروطي الثّلاثة

383
00:22:49,620 --> 00:22:51,850
ويمكنك المُغادرة