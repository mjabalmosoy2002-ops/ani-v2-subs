1
00:02:17,770 --> 00:02:20,570
أخي، يتصرّف هؤلاء النّاس
بشكل غريب قليلاً

2
00:02:21,040 --> 00:02:23,180
يبدو أنّهم لا يريدون التسبُّب بمشاكل لنا

3
00:02:23,180 --> 00:02:24,640
يريدون حبسنا هنا فحسب

4
00:02:24,640 --> 00:02:27,030
هذا صحيح. قال المُدير بأنّ

5
00:02:27,030 --> 00:02:29,890
عشيرة لو لا تضمر ضغينة تجاه عشيرة
تانغ، لذا لا يمكننا أن نكون وقحين

6
00:02:29,890 --> 00:02:32,000
،ما دمتُما لا تتدخّلان

7
00:02:32,000 --> 00:02:34,240
فلن نُعقّد الأمور عليكما

8
00:02:34,240 --> 00:02:35,890
هذه المرّة، الوحيدون الّذين سوف نستهدفهم

9
00:02:35,890 --> 00:02:38,520
!هم زانغ تشولان ووانغ زينتشيو

10
00:02:38,520 --> 00:02:40,750
،آسفة، أشكرك على عرضك

11
00:02:40,750 --> 00:02:42,160
لكن لا أستطيع المُوافقة عليه

12
00:02:42,160 --> 00:02:44,610
أتينا لأنّ زانغ تشولان طلب منّا حمايته

13
00:02:44,610 --> 00:02:45,810
لا يمكننا الوقوف مكتوفي اليدين

14
00:02:45,810 --> 00:02:47,270
هكذا إذاً

15
00:02:47,850 --> 00:02:49,430
!كما هو مُتوقَّع من لينغلونغ

16
00:02:49,990 --> 00:02:51,480
،في الواقع، قال العجوز أيضاً

17
00:02:51,480 --> 00:02:53,190
ما دام أعضاء عشيرة تانغ
،يتّفقون مع عشيرة لو

18
00:02:53,190 --> 00:02:55,080
لا بأس أن يُحدِث أعضاء عشيرة
!لو بعض الجلبة هنا

19
00:02:55,080 --> 00:02:56,930
،لينغلونغ، أضيفيني على ويتشان فحسب

20
00:02:56,930 --> 00:02:58,680
وأستطيع مُساعدتكِ في إطلاق
!سراح زانغ تشولان

21
00:02:58,010 --> 00:02:58,680
ويتشان؟

22
00:02:58,680 --> 00:03:01,520
آنسة لو، لم يقل المُدير أيّاً من ذلك

23
00:03:01,520 --> 00:03:02,680
انقلع، انقلع

24
00:03:03,500 --> 00:03:06,090
لينغلونغ، لعلّكِ لم تسمعي
باسم تانغ شياوباو

25
00:03:06,090 --> 00:03:07,410
!شياوباو من مجموعة لونغ

26
00:03:07,410 --> 00:03:08,560
هل تتذكّرين الآن؟

27
00:03:08,560 --> 00:03:10,170
!نادي المُعجبين الخاص بكِ

28
00:03:10,170 --> 00:03:11,580
!أنا رئيس مجموعة لونغ

29
00:03:11,580 --> 00:03:13,600
ألم يذكرني ذلك الوغد كانغ لونغ لكِ؟

30
00:03:13,600 --> 00:03:15,820
!انقلع! لا تذكر اسمه أمامي

31
00:03:16,680 --> 00:03:18,740
يا صاح! ما رأيك أن نُضيف بعضنا أوّلاً؟

32
00:03:18,740 --> 00:03:19,430
لا

33
00:03:26,050 --> 00:03:27,200
ما الخطب؟

34
00:03:27,200 --> 00:03:30,270
لماذا توقّفتم عن القتال؟

35
00:03:31,700 --> 00:03:34,400
ستسقط مع عشيرة تانغ
!اليوم مهما كلّف الأمر

36
00:03:34,400 --> 00:03:36,410
لكنّنا نُهيّئ المسرح

37
00:03:36,410 --> 00:03:38,890
لسنا نحن من سيُرسلك بعيداً

38
00:03:44,390 --> 00:03:46,470
تانغ وينلونغ

39
00:03:46,470 --> 00:03:50,680
رأيتُ تلك الطّريقة وهي تعزيز القدرات الجسديّة
بشكل كبير خلال فترة قصيرة ثانية

40
00:03:51,750 --> 00:03:55,270
!هذا مُعاكس 180 درجة عن موقفك في الأمس

41
00:03:55,270 --> 00:03:56,350
ألن تتظاهر بعد الآن؟

42
00:03:56,350 --> 00:03:57,810
لم أكن أتظاهر

43
00:03:57,810 --> 00:03:59,810
،غضبي تجاهك من قبل كان حقيقيّاً

44
00:03:59,810 --> 00:04:01,680
وامتناني الآن حقيقيّ أيضاً

45
00:04:01,680 --> 00:04:05,180
من دونك، ما كنتُ لأرى عيوبي بهذه السّرعة

46
00:04:05,640 --> 00:04:06,600
هيّا

47
00:04:07,560 --> 00:04:09,100
!الجولة الثّانية

48
00:04:25,520 --> 00:04:27,020
كيف تسير الأمور؟

49
00:04:27,020 --> 00:04:30,310
!أنباء عاجلة: قُبِض على زانغ تشولان

50
00:04:30,310 --> 00:04:31,920
حقّاً؟

51
00:04:32,560 --> 00:04:33,590
جيّد

52
00:04:34,120 --> 00:04:34,850
حسناً

53
00:04:35,200 --> 00:04:36,950
نسيتُ إحضار غوانيان خاصّتي

54
00:04:36,950 --> 00:04:38,680
دعوني أرى خاصّتكم

55
00:04:41,410 --> 00:04:43,730
لا يهمّ. لا داعي

56
00:04:47,430 --> 00:04:49,270
يمكنكم تفاديها؟

57
00:04:49,270 --> 00:04:53,720
يبدو أنّ الّذين أتوا خلسة هذه
المرّة ليسوا ضُعفاء

58
00:04:56,810 --> 00:05:00,390
!شيا ليوتشينغ، شيطان الجثّة

59
00:05:27,810 --> 00:05:30,720
!الأكثر إزعاجاً

60
00:05:30,720 --> 00:05:35,180
ألم يُصبح ذلك الشّيطان الجثّة الطّفل
كسيحاً بواسطة السّيّد السّماويّ؟

61
00:05:48,250 --> 00:05:49,860
هل أفلح ذلك؟

62
00:05:49,860 --> 00:05:52,090
حتّى حاجز السُّمّ لم يُوقفه؟

63
00:05:52,090 --> 00:05:54,740
أجل. أنا أُهاجم الرُّوح فقط

64
00:05:54,740 --> 00:05:58,060
الشّيء الوحيد الّذي يستطيع مُقاومته
هو القوّة الرّوحانيّة الشّديدة من الرُّوح

65
00:05:58,060 --> 00:06:00,270
،حتّى لو كان مُعلّماً من عشيرة تانغ

66
00:06:00,270 --> 00:06:01,850
،التّعامل معكم أنتم الثّلاثة دُفعة واحدة

67
00:06:01,850 --> 00:06:05,030
ومع ذلك امتلاك طاقة روحانيّة كافية
مُتبقّية لمُقاومتي

68
00:06:05,030 --> 00:06:06,720
هو عملٌ صعبٌ جدّاً

69
00:06:06,720 --> 00:06:10,140
إذاً يا ليو ليانغ، تحتاج بعض
الوقت للقيام بعملك، صحيح؟

70
00:06:10,140 --> 00:06:11,650
المكان ليس آمناً هنا

71
00:06:11,650 --> 00:06:12,640
!خذوه بعيداً

72
00:06:12,640 --> 00:06:14,980
لا، لا ضرورة لذلك

73
00:06:14,980 --> 00:06:17,520
،روح هذا الشّيخ ليست بتلك القوّة

74
00:06:17,520 --> 00:06:20,050
ومهاراتي أقوى من قبل

75
00:06:20,050 --> 00:06:22,020
لا حاجة لاستعمال طريقة غبيّة كهذه

76
00:06:27,600 --> 00:06:30,060
!لا يمكننا البقاء هنا فترة طويلة! هيّا بنا

77
00:06:34,180 --> 00:06:35,810
...هذا الإحساس

78
00:06:43,120 --> 00:06:44,520
—متى قد

79
00:06:50,050 --> 00:06:51,720
!جينفينغ! لا

80
00:07:00,410 --> 00:07:02,680
اختفى! ما الّذي يجري؟

81
00:07:02,990 --> 00:07:04,560
!حاجز جسد الوهم

82
00:07:05,700 --> 00:07:07,560
ما الّذي يجري يا أخي تو؟

83
00:07:11,320 --> 00:07:15,720
من المؤسف جدّاً ألّا أستطيع القضاء
عليك أوّلاً يا شيطان الجثّة

84
00:07:16,110 --> 00:07:19,860
المُعلّم تانغ، إن كنت ستستخدم
،حاجز جسد الوهم ضدّي

85
00:07:19,860 --> 00:07:23,520
فمن الأفضل أن تهدأ أوّلاً

86
00:07:28,550 --> 00:07:33,000
أصبتُم زميلي وتتوقّعون أن أهدأ؟

87
00:07:33,000 --> 00:07:35,020
أنت تطلب أكثر ممّا ينبغي

88
00:07:35,360 --> 00:07:38,020
لن أجادلك اليوم

89
00:07:38,020 --> 00:07:39,990
،المُعلّم تشيوشان سليم

90
00:07:39,990 --> 00:07:42,140
!نستأذن بالانصراف الآن

91
00:07:53,920 --> 00:07:55,010
نُغادر؟

92
00:08:06,250 --> 00:08:08,210
كنتَ مُحقّاً

93
00:08:08,210 --> 00:08:11,020
!يوان تاو استهان بزانغ تشولان ذاك فعلاً

94
00:08:11,340 --> 00:08:14,810
أجل. يوان نال منّا حقّاً

95
00:08:15,090 --> 00:08:17,850
!إلى كافّة أعضاء عشيرة تانغ، اسمعوا

96
00:08:17,850 --> 00:08:21,430
عند مُواجهة هذا الرّجل، فالأولويّة
،ليست الفوز

97
00:08:21,770 --> 00:08:24,880
إنّما تجنُّب الاحتكاك مع سُمّ الجثّة الخاصّ به

98
00:08:26,970 --> 00:08:28,650
شيطان الجثّة؟

99
00:08:28,650 --> 00:08:30,960
تقصد الرّجل الّذي هزمَ عشرة منّا

100
00:08:30,960 --> 00:08:32,850
رغم تكاثرنا عليه؟

101
00:08:33,220 --> 00:08:36,000
يبدو كرجل مُرهَق في مُنتصف العمر

102
00:08:36,000 --> 00:08:37,370
إلى أيّ درجة هو قويّ؟

103
00:08:37,370 --> 00:08:39,800
أُستاذ ليو، هل تعرف هذا الرّجل؟

104
00:08:39,800 --> 00:08:42,780
لا، لكن بما أنّ المُدير يتّخذه
،على محمل الجدّ

105
00:08:42,780 --> 00:08:43,970
!فلا تعتبره مزحة

106
00:08:47,790 --> 00:08:49,640
لم نلتقِ من قبل

107
00:08:50,130 --> 00:08:52,640
تتكلّم وكأنّك تعرفني خير معرفة

108
00:08:52,910 --> 00:08:57,470
الحقيقة هي أنّ حِيَلي الصّغيرة وأنا
لسنا مُخيفين كما تُشير الإشاعات

109
00:08:57,470 --> 00:09:00,600
لنُناقش الأمر، ودعنا نذهب فحسب

110
00:09:01,080 --> 00:09:03,000
مُستحيل

111
00:09:03,000 --> 00:09:04,600
هذه فُرصة نادرة

112
00:09:04,600 --> 00:09:06,930
!دعني أرى ما لديك

113
00:09:42,300 --> 00:09:43,810
،أخبرتُك

114
00:09:43,810 --> 00:09:47,020
عليك أن تتحكّم بغضبك

115
00:09:47,520 --> 00:09:49,960
،وإلّا مهما اختبأت جيّداً

116
00:09:49,960 --> 00:09:52,610
سيشعرون بك

117
00:09:55,250 --> 00:09:57,680
ما هذه الأشياء؟ إنّها ظلاميّة وعكِرة

118
00:09:57,680 --> 00:09:59,680
!ويبدو أنّ المُدير مُدرك لذلك تماماً

119
00:10:00,610 --> 00:10:02,500
ابتعد عنه فحسب، اتّفقنا؟

120
00:10:15,120 --> 00:10:16,680
!هيّا

121
00:10:16,680 --> 00:10:20,030
،كلّ من لم يُتقِن حاجزَ السُّمّ
فليخرج من هنا

122
00:10:20,030 --> 00:10:22,120
!بقيّتكم، تعاملوا مع الآخرين

123
00:10:22,120 --> 00:10:23,600
!اتركوا شيطان الجثّة لي

124
00:10:26,220 --> 00:10:27,390
!ابتعد

125
00:10:30,990 --> 00:10:33,470
سريع للغاية! إنّه على وشك
!اختراق حاجز السُّمّ

126
00:10:38,100 --> 00:10:39,330
!وخزَني، وخزَني

127
00:10:40,720 --> 00:10:41,900
كيف حالك؟

128
00:10:42,350 --> 00:10:43,470
!لا أشعر بألم أو حكّة

129
00:10:43,790 --> 00:10:45,720
...لم أشعر بشيء

130
00:10:49,350 --> 00:10:50,350
!شيا

131
00:10:51,180 --> 00:10:52,060
!أنا بخير

132
00:11:02,190 --> 00:11:05,890
،ضغط الرّياح من الأنصال السّريعة
المُخصّصة أصلاً للاغتيالات

133
00:11:05,890 --> 00:11:08,520
يُطلَق باستمرار كما الرّشّاش

134
00:11:09,140 --> 00:11:11,650
لماذا أُصادف وحوشاً عجائز دوماً؟

135
00:11:18,790 --> 00:11:22,220
الكثير من النّاس ويبدون أقوياء جدّاً جميعهم

136
00:11:22,930 --> 00:11:24,790
هل أستطيع التّعامل مع هذا حقّاً؟

137
00:11:26,700 --> 00:11:27,350
حقّاً؟

138
00:11:28,380 --> 00:11:30,560
حسناً يا مُعلّم تاو. سنأتي حالاً

139
00:11:31,280 --> 00:11:32,830
كنتَ على حقّ

140
00:11:33,500 --> 00:11:35,100
لقد أتوا فعلاً

141
00:11:37,550 --> 00:11:38,890
أنت رهيب

142
00:11:38,890 --> 00:11:40,470
كيف تمكّنت من إقناع

143
00:11:40,470 --> 00:11:43,310
العجوز بالمُوافقة على تقديم
استعراض ضخم كهذا؟

144
00:11:48,880 --> 00:11:50,640
تكلّم يا زانغ تشولان

145
00:11:50,640 --> 00:11:52,220
لماذا أتيت؟

146
00:11:52,220 --> 00:11:54,270
...في الواقع، ليس بالأمر الجلل

147
00:11:54,270 --> 00:11:56,140
جماعة تشوان شينغ طلبوا منّي المجيء

148
00:11:56,450 --> 00:11:57,660
ماذا قلت؟

149
00:11:57,660 --> 00:11:59,350
تشوان شينغ طلبوا منك المجيء؟

150
00:12:00,240 --> 00:12:03,020
أجل. وليس هذا بيت القصيد

151
00:12:03,020 --> 00:12:04,810
بما أنّهم طلبوا منّي المجيء، فقد أتيت

152
00:12:04,810 --> 00:12:09,140
أتيتُ لأسألكم عن ماضي جدّي

153
00:12:09,500 --> 00:12:11,560
،ولأُبلغكم أيضاً

154
00:12:11,560 --> 00:12:13,220
بأنّ تشوان شينغ قد يظهروا كذلك

155
00:12:13,670 --> 00:12:15,220
تشوان شينغ قادمون أيضاً؟

156
00:12:15,540 --> 00:12:18,130
،إذا كان الفتى يقول الحقيقة

157
00:12:18,130 --> 00:12:20,430
فلماذا يُرسلونه تشوان شينغ إلى هنا؟

158
00:12:20,430 --> 00:12:23,770
تشيوشان، أليس هذا واضحاً؟

159
00:12:23,770 --> 00:12:27,600
أولئك النّاس يعلمون بشأن جدّه
وتاريخنا المُشترك

160
00:12:27,600 --> 00:12:32,560
الغاية من وصوله هي صرف انتباهنا

161
00:12:32,560 --> 00:12:36,720
تماماً.  إرساله إلى هنا أوّلاً
هو هديّة من النّاحية العمليّة

162
00:12:36,720 --> 00:12:42,470
لكن كلّ هذا يعتمد على قولك للحقيقة

163
00:12:42,800 --> 00:12:44,470
ولِمَ أكذب عليك؟

164
00:12:44,470 --> 00:12:47,310
،لا أعلم ما إن كنتَ تكذب عليّ

165
00:12:47,970 --> 00:12:49,470
لكن أعلم

166
00:12:49,470 --> 00:12:51,730
بأنّ كلّ ما قيل للتو

167
00:12:51,730 --> 00:12:55,890
يعتمد على فرضيّة وهي بأنّك كنتَ
!مُتواطئاً مع تشوان شينغ منذ زمن بعيد

168
00:12:56,240 --> 00:12:58,340
أنت مُوظّفٌ في الشّركة

169
00:12:58,340 --> 00:13:02,600
وأعلم أيضاً بأنّ تشوان شينغ استهدفك من قبل

170
00:13:02,970 --> 00:13:04,960
،إن كنتُما عدوّين لدودين فعلاً

171
00:13:04,960 --> 00:13:10,350
فحتّى أولئك المجانين لن يُفكِّروا
!في استخدامك بهذا الشّكل

172
00:13:10,350 --> 00:13:14,120
كيف تُفسّر ذلك؟

173
00:13:14,120 --> 00:13:14,840
...في الواقع

174
00:13:15,540 --> 00:13:17,320
لا يوجد شيء لأشرحه

175
00:13:17,320 --> 00:13:19,290
عملتُ مع تشوان شينغ من قبل

176
00:13:19,290 --> 00:13:21,220
وبصراحة، سار الأمر بسلاسة

177
00:13:21,220 --> 00:13:22,560
ماذا قلت؟

178
00:13:22,840 --> 00:13:25,040
!الجواب بسيط: كانت مهمّة مُشترَكة

179
00:13:25,640 --> 00:13:27,880
،شملتْ تلك المُهمّة أعضاء تشوان شينغ

180
00:13:27,880 --> 00:13:29,930
لكن الهدف لم يكن تشوان شينغ نفسهم

181
00:13:29,930 --> 00:13:34,240
عند القيام بالأمور، لا بُدّ من تصنيف
الصِّراعات وإعطاء أولويّة للعوائق

182
00:13:34,240 --> 00:13:38,650
لذا آنذاك، تعاون فريقنا مع تشوان
شينغ لإتمام المهمّة

183
00:13:38,650 --> 00:13:41,890
حينئذ إذاً احتككتُ مع تشوان شينغ

184
00:13:42,150 --> 00:13:45,890
زانغ تشولان، هل تعي ما تقوله؟

185
00:13:45,890 --> 00:13:50,060
أجل. التّواطؤ مع زنادِقة تشوان
شينغ هو جريمة لا تُغتفَر

186
00:13:50,060 --> 00:13:54,390
أليس هذا سبب إدانة جدّي والـ35
الآخرين آنذاك؟

187
00:13:54,390 --> 00:13:56,660
،بالطّبع، اصطففتُ مع جدّي من حيث المبدأ

188
00:13:56,660 --> 00:13:58,970
لكن أتفهّم أيضاً سبب تصرُّف
الجميع مثلما تصرّفوا

189
00:13:58,970 --> 00:14:00,320
كانت حقبة فوضويّة

190
00:14:00,320 --> 00:14:02,270
،كانت قد انهارت قوانين رسميّة

191
00:14:02,270 --> 00:14:04,610
لذا القوانين غير الرّسميّة كانت
كلّ ما احتفظ به النّاس

192
00:14:04,610 --> 00:14:06,310
لا يمكن أن يتواجد نِظام بلا قوانين، صحيح؟

193
00:14:06,310 --> 00:14:08,600
لكنّنا الآن نعيش في مُجتمع يحكمه القانون

194
00:14:08,600 --> 00:14:10,880
أنا منبوذ، لكنّني مُواطن أيضاً

195
00:14:10,880 --> 00:14:13,100
ما دام مُواطن لا ينتهك النّظام
،العامّ أو الأخلاقيّات

196
00:14:13,100 --> 00:14:16,100
فما الضّير من التّواصل مع مُواطن آخر؟

197
00:14:16,580 --> 00:14:19,600
بصراحة، فكرة إرسالي سلفاً
لم تكن ذكيّة جدّاً

198
00:14:19,600 --> 00:14:23,600
فهي تفترض أنّ أي تواصُل مع تشوان
،شينغ هي خطيئة جسيمة

199
00:14:23,600 --> 00:14:25,900
وبأنّني سأكون خائفاً جدّاً من إخباركم بالحقيقة

200
00:14:25,900 --> 00:14:28,500
لا بُدّ أنّ من خرج بتلك الفكرة قد خَرِف

201
00:14:28,500 --> 00:14:31,810
وحدها الأحفورة من تُفكّر في ذلك

202
00:14:32,180 --> 00:14:33,440
!لا أقصد أيّاً واحداً منكم

203
00:14:33,440 --> 00:14:35,390
!جميعكم شيوخ مُتنوِّرون

204
00:14:35,860 --> 00:14:39,380
ثمّة أمر آخر أودُّ إبلاغكم به

205
00:14:39,380 --> 00:14:42,220
أتى معي شخصٌ يُدعى وانغ
زينتشيو هذه المرّة

206
00:14:42,220 --> 00:14:44,200
،أثناء مهمّتنا السّابقة لدى الشّركة

207
00:14:44,200 --> 00:14:47,460
تمكنّا من التّعاون مع تشوان شينغ
بفضل هذا الشّخص

208
00:14:47,460 --> 00:14:49,680
الجسر بيننا وبين تشوان شينغ

209
00:14:49,680 --> 00:14:51,640
قد بُني بواسطة وانغ زينتشيو هذا

210
00:14:52,810 --> 00:14:53,980
!ذلك الفتى

211
00:14:53,980 --> 00:14:57,680
أجل. آنذاك، لم يُرِد سوى تقديسك
،وعدم الانضمام لعشيرة تانغ

212
00:14:57,680 --> 00:15:00,520
وكدتَ تُوافق على شرط سخيف كهذا

213
00:15:00,830 --> 00:15:03,100
لاحقاً، تحرّينا حول خلفيّته

214
00:15:03,100 --> 00:15:07,180
رغم صِغر سنّه، إلّا أنّ ماضيه مُعقَّد جدّاً

215
00:15:07,180 --> 00:15:10,890
هل تعرف إحدى تقنيّاته، قِناع الإله؟

216
00:15:10,890 --> 00:15:12,920
!المُمثِّل شيا ليوتشينغ

217
00:15:12,920 --> 00:15:14,600
أنا لا أدلي باستنتاجات، بل أُصرّح بحقائق

218
00:15:14,950 --> 00:15:17,010
بما أنّ المطاف انتهى بنا
،بمُقاتلة تشوان شينغ هذه المرّة

219
00:15:17,010 --> 00:15:18,640
،أحضرتُ بعض الدّعم

220
00:15:18,640 --> 00:15:20,220
ووانغ زينتشيو ليس واحداً منهم

221
00:15:20,490 --> 00:15:22,290
هو من ورّط نفسه

222
00:15:22,290 --> 00:15:24,060
كلّ ما يمكنني قوله هو أنّ هذا مُلفِت

223
00:15:24,420 --> 00:15:27,490
حسناً. جهة اتّصالي بتشوان
،تشينغ هي الجدّة جينفينغ

224
00:15:27,490 --> 00:15:29,440
ولديها روابط عميقة بشيا ليوتشينغ

225
00:15:29,440 --> 00:15:32,340
أنت ثرثار

226
00:15:32,340 --> 00:15:35,060
تتكلّم كثيراً

227
00:15:35,350 --> 00:15:37,930
يمكنكم التحقُّق من كلّ ما قلتُه

228
00:15:39,170 --> 00:15:44,110
مينغ، اذهب واكتشف العلاقة بين
زانغ زينتشيو وشيا ليوتشينغ

229
00:15:45,140 --> 00:15:49,220
،زانغ، إن كان كلّ ما قلتَه صحيحاً

230
00:15:49,220 --> 00:15:50,970
فماذا سنفعل برأيك؟

231
00:15:50,970 --> 00:15:52,860
!أنا هنا فقط لإيصال رسالة

232
00:15:52,860 --> 00:15:54,420
!أنتم من يُقرّر

233
00:15:54,420 --> 00:15:57,770
لا، لا. أودُّ سماع رأيك

234
00:15:57,770 --> 00:16:00,480
سواء أتوا أو لا، أو مهما كان
،السّبب الّذي يأتون لأجله

235
00:16:00,480 --> 00:16:04,310
.إرسالي الغاية منه افتعال مشاكل لكم
كلّما زادت الفوضى، كان أفضل

236
00:16:04,710 --> 00:16:07,680
إذا أرادوا فوضى، فلنمنحهم
بعض الفوضى المُناسبة

237
00:16:07,680 --> 00:16:10,470
الفوضى سببها أنت

238
00:16:10,730 --> 00:16:14,250
تماماً. إن فكّرتم في الأمر
،بطريقة مُتحذلقة

239
00:16:14,250 --> 00:16:16,600
فلن يكون من الخطأ القول بأنّنا نضمر ضغينة

240
00:16:16,600 --> 00:16:18,140
هذا ما يريدونه بالضّبط

241
00:16:18,960 --> 00:16:22,210
أخبروا مينغ أن يبلغ الأعضاء، واستعدّوا

242
00:16:22,210 --> 00:16:23,840
فليحضر الجميع غوانيان

243
00:16:23,840 --> 00:16:25,030
غوانيان؟

244
00:16:25,030 --> 00:16:27,470
أداة بسيطة خاصّة بعشيرتنا

245
00:16:27,880 --> 00:16:34,020
إذا ضغطناها، سيعرف الجميع المكانَ
الّذي يحدث فيه شيء غير مألوف

246
00:16:34,470 --> 00:16:36,760
حسناً، فهمت

247
00:16:36,760 --> 00:16:38,680
احرص على شرح كلّ شيء للجميع

248
00:16:38,680 --> 00:16:41,560
تعرف سلفاً ما يجب فعله

249
00:16:41,860 --> 00:16:43,650
أكّد شياو مينغ بأنّ

250
00:16:43,650 --> 00:16:47,600
وانغ زينتشيو وشيا ليوتشينغ مُقرّبان جدّاً

251
00:16:47,600 --> 00:16:49,680
لكن لا يزال جزءاً من الشّركة

252
00:16:49,680 --> 00:16:52,330
إذا حدث أيّ شيء فعلاً، فأقترح عزله

253
00:16:52,330 --> 00:16:53,350
دعنا ألّا نكون قُساة جدّاً

254
00:16:55,550 --> 00:16:57,560
المُدير تانغ، ما الأمر؟

255
00:16:58,240 --> 00:17:00,750
أشعر ببعض العاطفة

256
00:17:00,750 --> 00:17:06,310
المُناورة بشكل عفويّ بين تشوان
تشينغ وعشيرتنا تانغ

257
00:17:06,310 --> 00:17:09,640
أنت حقّاً حفيد زانغ هواي

258
00:17:09,640 --> 00:17:13,520
حضرة المُدير تانغ، حدّثني عن تعامُل
جدّي مع عشيرة تانغ

259
00:17:14,070 --> 00:17:16,240
،لا ضير من إخبارك

260
00:17:16,240 --> 00:17:19,900
لأنّنا حتّى الآن ما زلنا نجهل ما يحدث

261
00:17:20,520 --> 00:17:22,640
المسألة بسيطة جدّاً

262
00:17:22,640 --> 00:17:26,000
آنذاك، اقتحمَ جدُّك مقرّ
عشيرة تانغ ليلاً

263
00:17:26,000 --> 00:17:28,810
كان قد اكتُشِف بواسطة أخي
الأكبر، يانغ لي

264
00:17:28,810 --> 00:17:31,410
،أمرَنا بحراسة عشيرة تانغ

265
00:17:31,410 --> 00:17:33,140
بينما ذهبَ هو لاستهدافه

266
00:17:34,490 --> 00:17:36,140
،بعد بعض الوقت

267
00:17:36,140 --> 00:17:39,980
انتشت أنباء بأنّه هو ومُعلّمون عديدون آخرون

268
00:17:39,980 --> 00:17:44,540
قد هلَكوا بالإضافة إلى جدّك في الجبال

269
00:17:45,350 --> 00:17:49,140
لا نعرف التّفاصيل بالتّحديد

270
00:17:49,520 --> 00:17:51,890
إذاً لماذا داهمَ جدِّي مقرّ عشيرة تانغ ليلاً؟

271
00:17:52,210 --> 00:17:53,850
وما أدراني؟

272
00:17:54,540 --> 00:17:59,280
،بموت زانغ هواي وأخي الأكبر

273
00:17:59,280 --> 00:18:02,060
لن يتمكّن أحدٌ غالباً من إعطائك الجواب

274
00:18:02,320 --> 00:18:05,100
حسناً، حان الوقت

275
00:18:05,680 --> 00:18:08,720
زانغ، هل نتحرّك؟

276
00:18:08,720 --> 00:18:09,970
حسناً

277
00:18:09,970 --> 00:18:12,020
،باستعراض كبير كهذا

278
00:18:12,020 --> 00:18:14,420
إن أتوا، فلا مانع

279
00:18:14,420 --> 00:18:18,390
...لكن إن لم يأتوا يا زانغ تشولان

280
00:18:18,390 --> 00:18:21,310
إن لم يأتوا، فاستهدفني فعلاً

281
00:18:21,310 --> 00:18:24,170
هناك الكثير في عشيرتك يريدون إسقاطي

282
00:18:24,170 --> 00:18:27,060
،أخبرهم فقط أن يصفحوا عن حياتي
!لكن دعهم ينفّسون بعض الغضب

283
00:18:27,360 --> 00:18:29,660
حضرة المُدير تانغ، بما أنّ
،المُحادثات قد فشلت

284
00:18:29,660 --> 00:18:31,240
ما رأيك أن نجعل الأمر يبدو حقيقيّاً؟

285
00:18:31,240 --> 00:18:32,690
سبّب لي بعض الجروح الحقيقيّة

286
00:18:32,690 --> 00:18:33,810
بكلّ تأكيد

287
00:18:33,810 --> 00:18:35,860
!هيّا، اضرب أنفي

288
00:18:35,860 --> 00:18:37,890
!دعه ينزف! اجعل الأمر يبدو جادّاً

289
00:18:39,890 --> 00:18:41,840
لا حاجة لمثل هذه المسرحيّات

290
00:18:52,290 --> 00:18:55,240
ما طبيعة المهارة الّتي استخدمَها
مُديرك تانغ على أيّ حال؟

291
00:18:56,220 --> 00:18:57,470
نكاد نصل

292
00:18:57,470 --> 00:18:59,470
بحسب غوانيان، فإنّه هناك أمامنا

293
00:19:02,880 --> 00:19:03,960
!توقّف

294
00:19:14,360 --> 00:19:16,100
!هذا مُؤلم! مُؤلم جدّاً

295
00:19:20,270 --> 00:19:22,200
...أخي ليو، هذا

296
00:19:22,200 --> 00:19:24,890
!لا جدوى، لقد حاولت! لا تقترب

297
00:19:39,520 --> 00:19:41,640
شياوفينغ؟ هل تمّ تولّي أمره؟

298
00:19:43,020 --> 00:19:44,630
...لا يمكن تولّي أمره

299
00:19:44,630 --> 00:19:45,980
...هذا مُستحيل

300
00:19:50,950 --> 00:19:51,970
!شياوفينغ

301
00:20:13,090 --> 00:20:14,520
كيف حال شياوفينغ؟

302
00:20:14,520 --> 00:20:16,090
لا أدري بعد

303
00:20:16,090 --> 00:20:18,000
إنّه غائب عن الوعي فحسب

304
00:20:18,000 --> 00:20:20,290
...لكن قبل قليل، رأيتُ في جسده وبوضوح

305
00:20:20,290 --> 00:20:21,720
لا أعلم أيضاً

306
00:20:22,230 --> 00:20:23,920
اذهبوا جميعاً إلى المُدير

307
00:20:23,920 --> 00:20:25,270
سأُراقبه

308
00:20:34,540 --> 00:20:35,870
...ما الّذي

309
00:20:36,930 --> 00:20:38,020
!حضرة المُدير

310
00:20:45,560 --> 00:20:47,430
حضرة المُدير، ما الّذي يجري؟

311
00:20:48,360 --> 00:20:51,990
شيطان الجثّة... هذا ما في الأمر إذاً

312
00:20:53,360 --> 00:20:56,680
هذا يفوق استيعابي

313
00:21:01,040 --> 00:21:04,160
!لا، الأمر ليس كما تعتقدين

314
00:21:04,160 --> 00:21:06,350
!ابتعدي، كفّي عن التمسُّك بي! ابتعدي

315
00:21:07,730 --> 00:21:10,600
!شاشا! لم أقصدكِ أنتِ

316
00:21:10,600 --> 00:21:13,930
هذا... هذا من صنيع جثّة الشّيطان؟

317
00:21:14,360 --> 00:21:16,520
...أجل... ولا

318
00:21:17,240 --> 00:21:22,270
الأشياء على أجسادهم الآن سببها
بالفعل شيطان الجثّة

319
00:21:22,270 --> 00:21:26,210
لكن هذه الأشياء ليست مُلك شيطان الجثّة

320
00:21:26,720 --> 00:21:29,980
إنّها تجسيدٌ لجثثهم الخاصّة الثّلاثة

321
00:21:30,770 --> 00:21:32,950
هل تعرفون المجانين الأربعة؟

322
00:21:32,950 --> 00:21:35,230
!أجل، زنادِقة تشوان شينغ الأربعة

323
00:21:35,230 --> 00:21:37,310
،يُمثّلون الرّذائل الأربع: الكحول
والشّهوة والجشع والغطرسة

324
00:21:37,780 --> 00:21:40,170
لونغ، هل تشرب الكحول؟

325
00:21:40,850 --> 00:21:43,450
من دون كحول، لا آداب سلوك

326
00:21:43,450 --> 00:21:46,100
من دون شهوة، ينحرف طريق
الحياة شيئاً فشيئاً

327
00:21:46,100 --> 00:21:48,590
من دون جشع، من الصّعب الإبحار في العالم

328
00:21:48,590 --> 00:21:51,580
من دون غطرسة، ستتعرّض لتنمُّر

329
00:21:51,580 --> 00:21:54,280
لو كان المجانين الأربعة يُمثّلون
،فقط هذه الكلمات الأربع

330
00:21:54,280 --> 00:21:56,310
لما كان هناك ما يدعو للخوف

331
00:21:56,310 --> 00:21:58,440
،استخدام الثّمالة للهرب

332
00:21:58,440 --> 00:22:01,360
،والانغماس في أيّ شكل من الملذّات

333
00:22:01,360 --> 00:22:03,590
،والاستحواذ بلا قيود

334
00:22:03,590 --> 00:22:06,220
...وترك العواطف تُهيمن

335
00:22:06,750 --> 00:22:10,600
هذا ما يجعل الكحول والشّهوة
والجشع والغطرسة مُرعبين

336
00:22:10,880 --> 00:22:17,470
لكن هؤلاء الأربعة هم مُجرّد نتاج
إغراءات وتأثير العالم الفاتن

337
00:22:17,470 --> 00:22:19,840
الجثث الثّلاث مُختلفة

338
00:22:19,840 --> 00:22:23,930
إنّهم الخطايا الأصليّة الثّلاثة
الّتي فِطروا عليها منذ الولادة

339
00:22:24,400 --> 00:22:29,390
المُنمّون البارعون حقّاً يستطيعون
،مسح الجثث الثّلاثة خاصّتهم

340
00:22:29,390 --> 00:22:32,100
ليبقوا راسخين في وجه الإغراء

341
00:22:32,630 --> 00:22:38,100
لكن الشّيء الغريب في شيطان الجثّة
هذا هو أنّه لم يمسحهم

342
00:22:38,100 --> 00:22:40,340
،بدلاً من ذلك، تحكّمَ بجثثه الثّلاث

343
00:22:40,340 --> 00:22:43,470
ليُجلّيهم من أجل مآربه الخاصّة

344
00:22:44,080 --> 00:22:47,810
أولئك المُلوّثون بواسطة شيطان الجثّة
،يُجلّون أيضاً جثثهم الثّلاث

345
00:22:48,290 --> 00:22:50,400
لكن لا يستطيعون التحكُّم بهم

346
00:22:50,970 --> 00:22:55,050
يتبعونهم الشّخص كالظّلال ويحبسونه مدى الحياة

347
00:22:55,920 --> 00:22:58,490
،بالنّسبة لمُنمٍّ

348
00:22:58,490 --> 00:23:01,020
هذا يُدمِّر حياته بأكملها عمليّاً

349
00:23:01,020 --> 00:23:03,270
أما من طريقة لمسح الجثث الثّلاث كُلّياً؟

350
00:23:03,270 --> 00:23:06,910
أجل، وهي بسيطة جدّاً

351
00:23:07,460 --> 00:23:11,640
،كلّ ما تحتاجه هو قلب راسخ كالصّخرة
لا يميل أبداً

352
00:23:11,640 --> 00:23:14,170
بسيط جدّاً، أليس كذلك؟

353
00:23:14,170 --> 00:23:17,520
هل يمكنك أن تستوعب مدى صعوبة ذلك؟

354
00:23:17,850 --> 00:23:20,510
يكفي إزالتهم داخليّاً صعوبة

355
00:23:20,510 --> 00:23:24,560
،والآن تخيّلهم يتجلّون خارجيّاً
ليُضايقونك ليلاً نهاراً

356
00:23:26,290 --> 00:23:28,100
...لم أتخيّل أبداً أن يستطيع شيطانُ الجثّة

357
00:23:28,100 --> 00:23:32,140
لا، هذا ما فاقَ توقّعاتي بالضّبط

358
00:23:32,140 --> 00:23:34,200
،رغم أنّني لم أُواجهه من قبل

359
00:23:34,200 --> 00:23:38,350
حالما رأيتُه، حذّرتُ أعضاءنا
لاتّخاذ إجراءات احترازيّة

360
00:23:38,350 --> 00:23:41,690
،في حين أنّ البعض سقطوا ضحايا

361
00:23:41,690 --> 00:23:45,130
الجثث الثّلاث المُستخرَجة
،بواسطة شيطانُ الجثّة

362
00:23:45,130 --> 00:23:48,600
لا تمتلك قوّة التّأثير على الآخرين

363
00:23:49,160 --> 00:23:54,370
ما أخذني على حين غرّة فعلاً كان فتى آخر

364
00:23:54,370 --> 00:23:56,400
،لا أعرف خلفيّته

365
00:23:56,400 --> 00:23:58,850
،لكن ذلك الفتى، مثل تو جونفينغ

366
00:23:58,850 --> 00:24:02,220
لديه القدرة على التحكُّم بجثثه
!الثّلاث الخاصّة

367
00:24:03,100 --> 00:24:05,600
،رغم أنّ اثنتين قد تجلّتا فقط

368
00:24:05,930 --> 00:24:11,310
إلّا أنّها أكثر شراسة بكثير
!من جثث تو جونفانغ

369
00:24:13,850 --> 00:24:14,640
!هيّا

370
00:24:17,180 --> 00:24:19,310
ما-ما هذا؟

371
00:24:28,400 --> 00:24:29,390
!شيا

372
00:24:29,390 --> 00:24:31,010
لا، لا أستطيع الصُّمود

373
00:24:31,010 --> 00:24:33,820
!جينفينغ، اهربي! بسرعة

374
00:24:36,020 --> 00:24:38,890
!يا فتى! قُضي على شيا وجينفينع! تراجع

375
00:24:42,640 --> 00:24:43,860
!حضرة المُدير

376
00:24:47,240 --> 00:24:49,110
هذا ما حدث جوهريّاً

377
00:24:50,360 --> 00:24:53,340
شيطان جثّة أشدّ عدوانيّة من تو جونفانغ

378
00:24:53,340 --> 00:24:55,310
تشوان شينغ لديهم شخص كهذا؟

379
00:24:53,920 --> 00:24:55,310
!زانغ تشولان

380
00:24:57,930 --> 00:25:00,070
هل كان هذا الاستعراض الكبير مُجرّد طعم؟

381
00:25:00,070 --> 00:25:01,930
...لم تُنبّهنا حتّى

382
00:25:01,930 --> 00:25:05,850
خشيتُ ألّا يخدع ذلك تشوان شينغ
لو أخبرتُكم سلفاً

383
00:25:05,850 --> 00:25:08,390
على أيّ حال، لم تكن عشيرة
تانغ تستخدم كلّ قوّتها ضدّكم

384
00:25:08,390 --> 00:25:11,540
بالمُناسبة، هل رأيتِ باور في طريقكِ إلى هنا؟

385
00:25:11,540 --> 00:25:12,680
...لا