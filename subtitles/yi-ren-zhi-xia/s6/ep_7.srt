1
00:02:28,470 --> 00:02:31,880
أيّها الأحمق! الوقت غير مُناسب
!الآن لمُحاولة إيقافي

2
00:02:39,180 --> 00:02:40,270
!زانغ تشولان

3
00:02:40,270 --> 00:02:41,430
!يا لها من حركة ذكيّة

4
00:02:47,040 --> 00:02:48,320
!ابتعدوا عن طريقنا

5
00:02:48,320 --> 00:02:49,600
!لا يستطيع أحدٌ إيقافنا

6
00:03:01,760 --> 00:03:03,140
حسناً يا زانغ تشولان

7
00:03:03,430 --> 00:03:04,890
ربحت

8
00:03:04,890 --> 00:03:07,270
!أنت مُستعدّ لخيانة الشّركة كي تُحقّق هدفك

9
00:03:07,270 --> 00:03:09,010
!استهنتُ بك

10
00:03:20,350 --> 00:03:22,020
!إلى الأمام

11
00:04:16,700 --> 00:04:18,370
أين هو؟

12
00:04:18,370 --> 00:04:21,160
أخبرني! أين الكنز؟

13
00:04:21,720 --> 00:04:22,960
!أين هو؟

14
00:04:25,660 --> 00:04:27,500
لا يوجد شيء هنا

15
00:04:27,500 --> 00:04:29,220
أين الكنز؟

16
00:04:29,220 --> 00:04:30,430
أين هو؟

17
00:04:48,470 --> 00:04:50,470
...أعطني

18
00:04:51,370 --> 00:04:53,340
!كنزي

19
00:05:06,860 --> 00:05:08,400
ما زلت لا تعي الأمر

20
00:05:08,400 --> 00:05:10,270
!هذه لعبة إقصاء

21
00:05:10,270 --> 00:05:13,390
!في نهاية المطاف، أنا الشّخص المختار

22
00:05:16,720 --> 00:05:19,670
يبدو أنّك تألف هذا المكان جيّداً

23
00:05:19,670 --> 00:05:22,340
أخبرني! أين الكنز؟

24
00:05:22,340 --> 00:05:25,300
ما هذه القوّة الغامضة بالضّبط؟

25
00:05:37,690 --> 00:05:39,560
!جودي، لا تذهبي. هذا خطير

26
00:05:46,980 --> 00:05:47,600
!كانون

27
00:05:52,320 --> 00:05:53,140
!سريعة للغاية

28
00:07:17,420 --> 00:07:19,120
!لي

29
00:07:19,120 --> 00:07:21,680
!إنّه لي

30
00:07:21,680 --> 00:07:24,430
...أعطني إيّاه

31
00:08:11,450 --> 00:08:12,550
...ثمّة مُشكلة

32
00:08:13,100 --> 00:08:15,400
،منذ مدّة

33
00:08:16,330 --> 00:08:18,890
لم أسمع شيئاً

34
00:08:18,890 --> 00:08:20,390
عمَّ الصّمت

35
00:08:28,280 --> 00:08:29,260
باور؟

36
00:08:38,800 --> 00:08:41,020
باور، هل أنتِ بخير؟

37
00:08:41,020 --> 00:08:42,480
أنا بخير

38
00:08:42,480 --> 00:08:44,220
هل تستسلمون حقّاً؟

39
00:08:44,510 --> 00:08:48,140
أجل، لا سبب يدفعنا للبقاء هنا بعد الآن

40
00:08:48,460 --> 00:08:50,070
،نظراً للوضع الرّاهن

41
00:08:50,070 --> 00:08:53,020
لا نعلم فيما إذا نجحت المهمّة أم فشلت

42
00:08:53,020 --> 00:08:56,110
خُدِعنا بواسطة ليو من البداية

43
00:08:57,600 --> 00:09:00,050
لا، أنجزنا واجبنا

44
00:09:00,050 --> 00:09:02,600
...لا نأبه لأهداف ليو

45
00:09:02,970 --> 00:09:04,310
هذا غير مُهمّ

46
00:09:06,050 --> 00:09:06,990
!هيّا بنا

47
00:09:16,600 --> 00:09:18,840
هل سندعهم يغادرون هكذا فحسب؟

48
00:09:18,840 --> 00:09:19,890
ماذا عسانا نفعل غير ذلك؟

49
00:09:20,320 --> 00:09:22,490
هؤلاء النّاس قد تمّ استئجارهم فحسب

50
00:09:22,490 --> 00:09:25,040
الوحيد الّذي على دراية بالأمر هو الأقرع ليو

51
00:09:27,220 --> 00:09:29,220
لكن الأقرع ليو قد هرب

52
00:09:29,220 --> 00:09:31,430
!زانغ تشولان

53
00:09:31,430 --> 00:09:34,560
ألست مَديناً لنا بشرح؟

54
00:09:34,900 --> 00:09:35,560
!باور

55
00:09:35,560 --> 00:09:36,790
!وانغ زينتشيو! شا! بارون

56
00:09:36,790 --> 00:09:39,390
!إذا لمسَني أحدٌ من هؤلاء الثّلاثة، فأوسعيه ضرباً

57
00:09:39,390 --> 00:09:43,350
الآن ليس الوقت المناسب لتسوية
الأمور معي، صحيح يا جدّة؟

58
00:09:52,820 --> 00:09:54,980
أهذا هو المكان يا جينفينغ؟

59
00:09:54,980 --> 00:09:56,730
...لا يوجد شيء هنا

60
00:10:01,280 --> 00:10:04,720
اختفى. كلّ شيء اختفى

61
00:10:05,070 --> 00:10:07,850
حسناً، كان هذا مُتوقَّعاً

62
00:10:07,850 --> 00:10:10,780
كنّا قد احتسبنا لهذا الاحتمال من قبل

63
00:10:12,810 --> 00:10:13,600
!جدّة

64
00:10:14,040 --> 00:10:18,310
أعلم بأنّني ظلمتُكِ بالمجيء إلى هنا
!وحيداً قبل الآخرين

65
00:10:18,310 --> 00:10:20,060
!لكن لم أملك خياراً آخر صدّقيني

66
00:10:20,060 --> 00:10:22,850
ترتّب عليّ المجيء إلى هنا قبل أيّ شخص
!آخر لأتحقّق من شيء

67
00:10:23,400 --> 00:10:27,060
ممّا... أردت أن تتحقّق؟

68
00:10:29,490 --> 00:10:31,290
...تشي التّكوين

69
00:10:35,990 --> 00:10:37,910
تشي التّكوين؟

70
00:10:40,140 --> 00:10:42,120
علمتُ بتشي التّكوين فقط

71
00:10:42,120 --> 00:10:44,840
عندما أتيتم إليّ أنتم تشوان شينغ

72
00:10:44,840 --> 00:10:48,340
لطالما تظاهرتُ بأنّني مرفوض بواسطة
...الفنون السّرّية الثّمانية، لكن

73
00:10:49,180 --> 00:10:51,650
كان هذا شيئاً قد اكتشفَه جدّي زانغ هواي

74
00:10:51,650 --> 00:10:53,770
!إنّه ينتمي لعشيرة زانغ ومن حقّها

75
00:10:53,770 --> 00:10:57,160
!يجب أن أكتشف مكانه قبل أيّ أحد آخر

76
00:10:57,160 --> 00:10:59,520
في وقت لاحق، اكتشفتُ بأنّه صُنِع بعد

77
00:10:59,520 --> 00:11:02,550
أن أسّسَ قائد طائفتك، أو غينشينغ، أخويّة القسَم

78
00:11:02,550 --> 00:11:06,850
ظننتُ بأنّ هذه المسألة مُتّصلة
!وبشكل وثيق بهذا الأب الرّوحيّ

79
00:11:07,200 --> 00:11:10,970
في قرية بيو، اكتشفتُ بأنّك أقرب شخص له

80
00:11:10,970 --> 00:11:15,020
!لهذا السّبب أردتُ مُساعدتك

81
00:11:15,020 --> 00:11:19,420
أعتقد بأنّ مجموعة المقتنيات قد تحتوي
!على أسرار أخويّة القسَم

82
00:11:19,420 --> 00:11:22,680
قد تحتوي حتّى على أدلّة
!إلى الفنون السّرّية الثّمانية

83
00:11:22,680 --> 00:11:26,900
،ماذا؟ إذا كانت تحتوي على سرّ مُهمّ كهذا

84
00:11:26,900 --> 00:11:29,020
فكيف لم أكشفها أبداً؟

85
00:11:29,020 --> 00:11:31,040
،ربّما تتظاهرين بالجهل

86
00:11:31,040 --> 00:11:34,530
!لكن أعتقد بأنّكِ ما كنتِ لتُلاحظي ببساطة

87
00:11:34,530 --> 00:11:38,030
لأنّ أيّ شيء تُرِك بواسطة أو غينشينغ

88
00:11:38,030 --> 00:11:40,890
!كان ثميناً بما يكفي بالفعل بالنّسبة لك

89
00:11:40,890 --> 00:11:44,010
ما كنتِ لتهتمّي بالفنون السّرّية الثّمانية
أو اللّصوص الـ 36

90
00:11:44,010 --> 00:11:49,220
الشّيء الوحيد الّذي تكترثيه له
هو أو غينشينغ بنفسه، أليس كذلك؟

91
00:11:49,220 --> 00:11:52,280
أردتُ إجراء نقاش صريح ومُباشر معكِ

92
00:11:52,280 --> 00:11:56,020
!ثمّ تدخّل المُشاغب وانغ زينتشيو فجأة

93
00:11:56,440 --> 00:11:58,890
ما الّذي فعلتُه؟

94
00:11:58,890 --> 00:12:01,440
!كان هذا الرّجل يُراقبني منذ قرية بيو

95
00:12:01,440 --> 00:12:03,480
،كشفَ خطّتي للحصول على مجموعة المقتنيات

96
00:12:03,480 --> 00:12:05,100
لذا كان يُعقّد الأمر بالنّسبة لي

97
00:12:05,100 --> 00:12:06,640
لم أكن أملك خياراً يا جدّة

98
00:12:06,640 --> 00:12:09,890
أنا أثق بكِ، لكن لا أثق بوانغ زينتشيو وجماعته

99
00:12:09,890 --> 00:12:12,520
!ترتّب عليّ التسلّل والدّخول قبل أيّ شخص آخر

100
00:12:12,520 --> 00:12:14,820
!يا جدّة، أنا آسف

101
00:12:14,820 --> 00:12:18,680
انتهكتُ حرمة منطقتك ومنطقة أو غينشينغ

102
00:12:22,410 --> 00:12:26,320
لا يهمّ. لم تكن أنت من انتهك هذا المكان

103
00:12:26,320 --> 00:12:29,310
كان أولئك الّذين اختطفوني

104
00:12:29,310 --> 00:12:33,770
كانوا هم من أتوا إلى هنا لسرقة
!مجموعة مقتنيات زعيم الطّائفة

105
00:12:33,770 --> 00:12:37,310
دعيني أخبركِ بشيء واحد يا جينفينغ! ذلك
!الوغد هو ذلك النّوع من الأشخاص

106
00:12:37,310 --> 00:12:39,430
!كُفّ عن مُهاجمتي وانتقادي! حسناً يا زانغ

107
00:12:39,430 --> 00:12:41,600
!أنت تستهدفني! رجل قويّ

108
00:12:41,600 --> 00:12:42,850
!أنا هو الشّرّير الآن

109
00:12:42,850 --> 00:12:45,060
يا جدّة، الآن بعد أن وصلت الأمور
،إلى هذه المرحلة

110
00:12:45,340 --> 00:12:48,890
أخبريني من فضلكِ ماذا كانت
مجموعة مقتنيات زعيم الطّائفة؟

111
00:12:53,520 --> 00:12:58,720
الشّكل الصّلصاليّ زانغ، غلاف
الزّيز، صدفة المحّار، حجر

112
00:12:58,980 --> 00:13:00,150
حجر؟

113
00:13:00,150 --> 00:13:02,600
أجل، حجر

114
00:13:03,000 --> 00:13:06,060
حجر من ضفّة النّهر

115
00:13:07,760 --> 00:13:09,100
!انظري يا جينفينغ

116
00:13:09,400 --> 00:13:11,040
ألا تعتقدين بأنّها جميلة؟

117
00:13:11,040 --> 00:13:12,940
!إنّها مُنعشة للغاية وتبعث على الرّخاء

118
00:13:12,940 --> 00:13:14,880
مُنعشة وتبعث على الرّخاء؟

119
00:13:16,400 --> 00:13:18,930
أهي جميلة إلى هذا الحدّ؟ ألا يوجد
الكثير منها؟

120
00:13:20,700 --> 00:13:21,810
هذا صحيح

121
00:13:22,290 --> 00:13:24,430
،إنّها جميلة بمعاييري

122
00:13:24,800 --> 00:13:26,860
لكن ليس بمعايير العالم

123
00:13:29,830 --> 00:13:33,600
،ربّما قلّة منها قيّمة

124
00:13:33,600 --> 00:13:37,960
لكن بالنّسبة للمنبوذين، إنّها بلا معنى إطلاقاً

125
00:13:37,960 --> 00:13:39,720
هل قلت بأنّ هناك كُتُب أيضاً؟

126
00:13:40,090 --> 00:13:43,750
إنّها مُجرّد كُتُب عشوائيّة يمكن إيجادها في أيّ مكان

127
00:13:43,750 --> 00:13:45,680
"وحتّى أنّه كان لديه "اللّوتس الذّهبيّة

128
00:13:45,680 --> 00:13:49,350
وقال بأنّ الرّسوم فيه كانت جميلة جدّاً

129
00:13:49,350 --> 00:13:52,930
،ربّما هناك سرّ ما مخفيّ في الدّاخل

130
00:13:52,930 --> 00:13:55,520
لكن لا أعرف ما قد يكون

131
00:14:03,380 --> 00:14:08,000
هذا مُثير للاهتمام. الأشخاص الّذين خلف
،ما شيانهونغ أخذوا مجموعة المقتنيات سلفاً

132
00:14:08,000 --> 00:14:10,130
ومع ذلك استأجروا جماعة للانتظار هنا

133
00:14:10,130 --> 00:14:11,770
هل أرادوا رؤيتنا نتقاتل؟

134
00:14:11,770 --> 00:14:16,020
أم أرادوا مُراقبة كيف تغيّر أولئك النّاس؟

135
00:14:17,400 --> 00:14:20,770
زانغ، ما كلّ هذا الرّماد الأسود في الأرض؟

136
00:14:20,770 --> 00:14:22,800
كان الأمر هكذا عندما وصلتُ إلى هنا

137
00:14:22,800 --> 00:14:23,370
ماذا؟

138
00:14:23,370 --> 00:14:24,850
!جينفينغ! جينفينغ

139
00:14:24,850 --> 00:14:26,210
...هذا

140
00:14:26,210 --> 00:14:28,650
آثار الأقدام هذه؟

141
00:14:28,650 --> 00:14:31,210
...كانت هنا دوماً

142
00:14:31,210 --> 00:14:32,310
ماذا؟

143
00:14:32,310 --> 00:14:35,720
أتعتقد بأنّني لم أحاول فعل
ذلك كلّ هذه السّنين؟

144
00:14:37,150 --> 00:14:40,470
جميعكم، بما أنّنا لم نعثر على شيء، لنُغادر

145
00:14:42,850 --> 00:14:45,570
باور هي كنز حقّاً

146
00:14:45,570 --> 00:14:47,750
إنّها قويّة وعنيدة ومُطيعة

147
00:14:47,750 --> 00:14:52,430
،زانغ، ألا تشعر ولو بذرّة تأنيب ضمير\

148
00:14:52,430 --> 00:14:55,540
كونك تتحكّم بمثل هذا المخلوق عاقد العزم؟

149
00:14:56,360 --> 00:14:57,980
ولِمَ أشعر بتأنيب الضّمير؟

150
00:14:57,980 --> 00:15:01,850
إنّها تفعل أيّ شيء أطلبه منها
لأنّها تثق بي تماماً

151
00:15:02,540 --> 00:15:03,960
هل تغار؟

152
00:15:03,960 --> 00:15:06,810
هل هناك شخص يثق بك بهذا الشّكل؟

153
00:15:14,990 --> 00:15:16,310
!أنت غاضب

154
00:15:16,310 --> 00:15:17,850
لستُ غاضباً

155
00:15:18,540 --> 00:15:21,590
!أنت غاضب! هذه أوّل مرّة أراك فيها هكذا

156
00:15:21,590 --> 00:15:23,360
!أعتذر

157
00:15:21,590 --> 00:15:24,200
لستُ غاضباً! لماذا تعتذر؟

158
00:15:24,200 --> 00:15:26,020
ولِمَ أغضب من أخرق مثلك؟

159
00:15:26,020 --> 00:15:29,270
،وما يعنيني ذلك؟ نلت منّي هذه المرّة
!لكن سأردّ لك الاعتبار

160
00:15:28,750 --> 00:15:31,560
فتيان هذه الأيّام من الصّعب فهمهم

161
00:15:29,270 --> 00:15:31,560
!ابتعد! كفّ عن إزعاجي

162
00:15:31,560 --> 00:15:33,430
تجاهلني فحسب

163
00:15:39,970 --> 00:15:42,210
،ما عمل ما شيانهونغ جاهداً لتحقيقه

164
00:15:42,210 --> 00:15:43,470
يستطيع هذا الوادي إنجازه أيضاً

165
00:15:43,470 --> 00:15:47,060
بالفعل، التّغيُّرات الّتي طرأتْ على أولئك
الأشخاص كانت مُدهشة حقّاً

166
00:15:47,060 --> 00:15:49,020
أكثر شيء مُذهل في هذا المكان هو

167
00:15:49,020 --> 00:15:51,720
أنّه يجعل النّاس يمارسون تنمية زو تيان
من دون وعي

168
00:15:51,720 --> 00:15:53,730
،بما أنّه لا يتمّ التحكُّم بها عن وعي

169
00:15:53,730 --> 00:15:56,430
فإنّ بدء وإيقاف التّنمية هما خارج
نطاق سيطرتهم أيضاً

170
00:15:57,500 --> 00:15:59,680
لا عجب في أنّهم ماتوا جميعاً هكذا

171
00:15:59,680 --> 00:16:01,430
،بعد نقل طاقتهم

172
00:16:01,430 --> 00:16:03,940
كان هؤلاء الأشخاص كمُحرِّك لم يتوقّف عن العمل أبداً

173
00:16:03,940 --> 00:16:06,440
!إلى أن انتهى المطاف بتجاوز حدودهم

174
00:16:07,160 --> 00:16:10,760
مُعلّم هذا الوادي لا ينبغي أن يُعلّم
النّاس بدء التّنمية

175
00:16:10,760 --> 00:16:12,570
!دون أن يُعلّمهم كيفيّة التوقُّف

176
00:16:12,570 --> 00:16:14,020
إنّه زعيم الطّائفة

177
00:16:14,020 --> 00:16:17,560
زعيم الطّائفة عدّلَ الأشكال
،في هذا الجدار الحجريّ

178
00:16:17,560 --> 00:16:21,370
والّذي لا بُدّ أنّه هو ما يمنع
الإيقاف الطّبيعيّ للتّنمية

179
00:16:21,370 --> 00:16:25,560
لكن لماذا لم يتأثّروا بالأشكال المُعدَّلة؟

180
00:16:26,890 --> 00:16:28,060
إنّهما ذلكما الاثنان ثانية

181
00:16:28,060 --> 00:16:30,810
وحده زعيم الطّائفة يعرف السّبب

182
00:16:30,810 --> 00:16:34,390
لكن هؤلاء القِردة مُثيرون جدّاً للاهتمام

183
00:16:34,810 --> 00:16:37,730
عندما يستولي القرد الأقوى
،على هذا المكان

184
00:16:37,730 --> 00:16:41,220
فإنّه يطرد الآخرين من الوادي

185
00:16:41,220 --> 00:16:45,310
هذان الاثنان هما غالباً السّليلان الأقوى
من الجيل السّابق

186
00:16:45,310 --> 00:16:52,510
تتقاتل الذّريّة أحياناً حتّى الموت
من أجل السّيطرة على الوادي

187
00:16:52,510 --> 00:16:57,850
قِردة من الخارج يتوافدون إلى داخل الوادي
أحياناً، مُستغلّين أعدادهم

188
00:16:58,220 --> 00:17:03,970
إذا نجحوا، فإنّ قِرداً أقوى جديد
،ينبثق من بين صفوفهم

189
00:17:05,110 --> 00:17:08,320
وتبدأ الدّورة من جديد

190
00:17:11,910 --> 00:17:15,470
يتعلّم هؤلاء القِردة كيف يكونون
!كالبشر في هذا الوادي

191
00:17:22,220 --> 00:17:26,640
قُضي على هؤلاء بواسطة قِردة
الوادي، أليس كذلك؟

192
00:17:39,880 --> 00:17:41,970
!فإنّه هنا على الأغلب

193
00:17:47,920 --> 00:17:50,160
...كلّ ما يخطر على ذهنك، حسبتُ له بالفعل

194
00:17:51,840 --> 00:17:52,430
هذا صحيح

195
00:17:53,260 --> 00:17:55,430
لم تعثري عليها طوال هذه السّنين

196
00:17:55,430 --> 00:17:58,470
سيكون من غير المقبول أن أعثر عليه
!في زيارتي الأولى

197
00:18:08,800 --> 00:18:10,360
ماذا؟ زانغ؟

198
00:18:25,020 --> 00:18:27,430
ماذا؟ هل فقد هذا الفتى صوابه؟

199
00:18:29,820 --> 00:18:31,030
زانغ هواي

200
00:18:31,030 --> 00:18:33,130
،بما أنّك تشارك اسم جدّي

201
00:18:33,130 --> 00:18:34,560
سأسدي إليك بنصيحة ما اليوم

202
00:18:35,440 --> 00:18:37,740
لا بُدّ أنّك مررت بذلك الشّعور الغريب

203
00:18:37,740 --> 00:18:39,560
بأن تكون مهووساً بذلك المكان، صحيح؟

204
00:18:39,960 --> 00:18:42,680
العبور من هناك مرّة يكفي

205
00:18:43,190 --> 00:18:46,680
:ذلك الوادي يُعلّمك شيئاً واحداً فقط

206
00:18:46,680 --> 00:18:48,430
يُعلّمك كيف تكون إنساناً

207
00:18:48,720 --> 00:18:50,870
،يمكنك أن تتعلّم أن تكون إنساناً في الوادي

208
00:18:50,870 --> 00:18:52,880
أو يمكنك أن تكون هنا في البرّيّة

209
00:18:52,880 --> 00:18:54,600
لا حاجة للمُماطلة

210
00:18:54,600 --> 00:18:57,230
إنّها فقط مسألة اختيار الطّريقة
السّهلة أو الصّعبة

211
00:19:02,960 --> 00:19:05,270
أتتذكّر كيف كان الشّعور بكونك بشريّاً
في ذلك الوادي؟

212
00:19:06,380 --> 00:19:09,050
!قوّم عمودك الفقريّ، فقرة فقرة

213
00:19:10,020 --> 00:19:11,660
!خض تلك التّجربة ثانية

214
00:19:13,320 --> 00:19:15,430
،رغم أنّ الاستلقاء أكثر راحة

215
00:19:15,860 --> 00:19:17,850
،والتحرُّك على أربعة أطراف أسرع

216
00:19:17,850 --> 00:19:20,970
هناك مجموعة من غرباء الأطوار الّذين
يُصرّون على الوقوف مُنتصبي القامة

217
00:19:21,450 --> 00:19:22,870
ما هو الإنسان؟

218
00:19:23,870 --> 00:19:26,490
!وحش غريب يقف مُنتصب القامة

219
00:19:27,650 --> 00:19:29,600
هذا صعب، لكنّه يُشعرك بالرّضا

220
00:19:30,900 --> 00:19:32,680
هذا ما يعنيه أن تكون بشريّاً

221
00:19:33,120 --> 00:19:35,680
إذا لم يستهدف المرء سوى
،الأحاسيس المُمتعة

222
00:19:36,010 --> 00:19:39,220
فإنّ العودة إلى حالة حيوانيّة أمرٌ حتميّ

223
00:19:40,650 --> 00:19:43,640
فهمتَ الأمر بالفعل إذاً؟

224
00:19:43,640 --> 00:19:45,870
الجواب على "ما هو الإنسان؟" ليس صعباً

225
00:19:45,870 --> 00:19:48,020
،بالنّظر إلى هذا الوادي

226
00:19:48,020 --> 00:19:49,710
التّعريف واضح

227
00:19:49,710 --> 00:19:52,720
الشّخص الّذي لا يُجيد التّنمية لا يمكن
أن يُدعى ببشريّ كامل

228
00:19:52,990 --> 00:19:56,220
علّمني جدّي بأنّ الخطوة الأولى كانت

229
00:19:56,220 --> 00:19:59,790
تحقيق حالة استقامة في الوقفة والرّوح واللّحم

230
00:19:59,790 --> 00:20:02,200
،والّتي تُعرَف أيضاً بالوقوف مُنتصب القامة

231
00:20:02,200 --> 00:20:04,400
بعمود فقريّ مستقيم

232
00:20:04,400 --> 00:20:06,770
حينئذ فقط يستطيع التشي التدفُّق بسلاسة

233
00:20:07,200 --> 00:20:11,170
هذا الوادي والكهف يرمزان بوضوح
إلى العمود الفقريّ والجمجمة

234
00:20:11,170 --> 00:20:15,890
ونقاط الوخز المُتناظرة في الدّاخل تحتوي
غالباً على السّرّ الّذي تحدّث عنه أو غينشينغ

235
00:20:16,390 --> 00:20:19,850
عاينتَ المنطقة الّتي ترمز إلى بايهوي
في الكهف سابقاً، صحيح؟

236
00:20:21,150 --> 00:20:25,350
إذاً ينبغي للمدخل إلى هذا الوادي
أن يُمثّل العِجان

237
00:20:25,780 --> 00:20:27,720
لكن لا شيء مُهمّ هنا

238
00:20:28,290 --> 00:20:30,250
يبدو أنّنا لا نستطيع إيجاد سرّ هذا المكان

239
00:20:30,250 --> 00:20:32,270
"من دون اكتشاف معنى "الصّدق

240
00:20:33,110 --> 00:20:34,250
...الصّدق

241
00:20:34,820 --> 00:20:37,140
...لا أملك فكرة حول ذلك

242
00:20:37,790 --> 00:20:41,310
يا جدّة، أما من شيء هنا حقّاً
مُرتبط بالحرف المكتوب في "صدق"؟

243
00:20:41,660 --> 00:20:42,870
لا

244
00:20:42,870 --> 00:20:46,310
صدق؟ مثل "سلامة النّيّة"، "إخلاص"، و "صراحة"؟

245
00:20:46,310 --> 00:20:48,110
هل تشير إلى السّلوك؟

246
00:20:48,110 --> 00:20:50,310
السّلوك سلوك تجاه ماذا؟

247
00:20:50,310 --> 00:20:53,700
انسَ الأمر. إذا لم تستطع الجدّة
،حلّ هذا طوال السّنين

248
00:20:53,700 --> 00:20:55,720
فلا أحد آخر هنا لديه فُرصة

249
00:20:55,720 --> 00:20:57,510
زانغ زينتشيو مُزعج للغاية

250
00:20:57,510 --> 00:20:58,720
عليّ أن أسبقه إلى ذلك

251
00:20:59,550 --> 00:21:02,140
إذاً كنتم تقولون قبل قليل بأنّ

252
00:21:02,140 --> 00:21:06,220
الجواب على "ما هو الإنسان؟" هو
الوقوف مُنتصب القامة"؟"

253
00:21:06,220 --> 00:21:08,120
أجل. ما الخطب؟

254
00:21:08,120 --> 00:21:08,960
لماذا؟

255
00:21:08,960 --> 00:21:09,450
ماذا؟

256
00:21:09,450 --> 00:21:11,450
!يا آنسة، ألقي نظرة

257
00:21:11,450 --> 00:21:13,720
تُدعى هذه الوديان بالوديان السّماويّة الـ 24

258
00:21:13,720 --> 00:21:16,380
،عندما تربطينها بالكهف في النّهاية

259
00:21:16,380 --> 00:21:19,240
ألن تبدو كعمود فقريّ وجمجمة بشريّ؟

260
00:21:19,240 --> 00:21:20,390
أعلم ذلك

261
00:21:20,390 --> 00:21:22,350
ألا يقف البشر مُنتصبي القامة؟

262
00:21:22,350 --> 00:21:24,810
!هذا ما يُفرّقنا عن الحيوانات

263
00:21:25,280 --> 00:21:26,470
أعلم ذلك

264
00:21:26,820 --> 00:21:29,940
،حتّى لو سار بعض الحيوانات على ساقين

265
00:21:29,940 --> 00:21:33,060
لكن عمودهم الفقريّ ليس مستقيماً

266
00:21:33,580 --> 00:21:34,610
أعلم ذلك

267
00:21:34,610 --> 00:21:38,450
،"لذا، إذا كان السّؤال هو "ما هو الإنسان؟

268
00:21:38,450 --> 00:21:40,200
"...الجواب هو "الوقوف مُنتصب

269
00:21:40,200 --> 00:21:41,270
مُخطئ

270
00:21:42,350 --> 00:21:44,680
هذا الوادي لا يُطابق جوابك

271
00:21:45,100 --> 00:21:46,230
!باور

272
00:21:45,100 --> 00:21:47,190
،البشر يقفون مُنتصبي القامة

273
00:21:47,190 --> 00:21:49,100
"لكن هذا الوادي لا "يقف مُنتصب القامة

274
00:21:54,050 --> 00:21:56,920
"!هذا هو ما "يقف مُنتصب القامة