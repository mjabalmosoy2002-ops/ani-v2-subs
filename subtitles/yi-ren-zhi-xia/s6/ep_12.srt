1
00:02:27,010 --> 00:02:29,020
كان مُقدّر أن يأتي هذا اليوم في النّهاية

2
00:02:29,550 --> 00:02:30,590
!هيّا

3
00:02:31,480 --> 00:02:32,380
ماذا؟

4
00:02:33,410 --> 00:02:36,930
تذكّر، عُد فوراً حالما تتأكّد
من أنّ هذا مُزيّف

5
00:02:38,930 --> 00:02:41,390
هذه كلّ الأدوات الحِرفيّة السّحريّة
الّتي أعطيتني إيّاها من قبل

6
00:02:41,390 --> 00:02:43,720
خذها كلّها للدّفاع الذّاتيّ

7
00:02:47,490 --> 00:02:48,350
!أختي

8
00:02:48,690 --> 00:02:51,990
!ما... ما كان ينبغي أن أشكّك بكِ

9
00:02:51,990 --> 00:02:53,840
!لا أعرف السّبب

10
00:02:53,840 --> 00:02:56,970
!صدّقيني! لم أُرِد التّشكيك بكِ حقّاً

11
00:02:57,680 --> 00:02:58,700
حسناً

12
00:03:02,430 --> 00:03:03,890
فقط تذكّر أن تعود بسرعة

13
00:03:05,040 --> 00:03:06,310
!سأفعل

14
00:03:29,480 --> 00:03:31,610
آسفة لإزعاجكم أنتم الثّلاثة بهذا

15
00:03:34,400 --> 00:03:36,720
مضى ثلاثة أيّام منذ يوم الإعداد المزعوم

16
00:03:37,010 --> 00:03:40,060
لا أعتقد بأنّ ما شيانهونغ غبيّ
بما يكفي للوقوع في هذا الفخّ

17
00:03:41,450 --> 00:03:42,810
هل ما زال علينا الانتظار؟

18
00:03:46,370 --> 00:03:47,940
ما زلتُم تنتظرون؟

19
00:03:48,510 --> 00:03:49,890
بسبب الجاسوس؟

20
00:03:50,470 --> 00:03:53,740
المعلومات الّتي نُرسلها قد تصل
إلى القاتل وما شيانهونغ

21
00:03:53,740 --> 00:03:55,600
قد يرخون دفاعهم

22
00:03:55,600 --> 00:03:56,770
هذه هي الخطّة، صحيح؟

23
00:03:57,360 --> 00:03:59,930
وأيضاً خُذ بضعة أيّام كإجازة إضافيّة

24
00:03:59,930 --> 00:04:01,770
ماذا لو ظهرَ فعلاً؟

25
00:04:02,160 --> 00:04:03,700
ألن تكون في خطر؟

26
00:04:03,700 --> 00:04:07,470
زانغ، كنتَ مُصاباً بجروح بليغة، صحيح؟

27
00:04:07,820 --> 00:04:10,470
لهذا أحضرتُ مُعلّمين معي

28
00:04:10,470 --> 00:04:12,860
،لا تقلقوا، إذا أحضر معه أحداً

29
00:04:12,860 --> 00:04:15,100
فسأهرب عبر المعبر السّرّي في الملجأ

30
00:04:15,100 --> 00:04:18,520
فهمت... المهمّ أنّكم تعرفون ما تفعلونه

31
00:04:19,130 --> 00:04:20,220
بالتّوفيق

32
00:04:20,220 --> 00:04:22,180
!نتطلّع قُدماً لأنباء سارّة

33
00:04:22,910 --> 00:04:24,940
ما احتمالات فوزك بهذا الرّهان برأيك؟

34
00:04:25,820 --> 00:04:27,220
...ليست كبيرة

35
00:04:27,220 --> 00:04:31,550
احتمالات مجيء "ما" إلى هنا لتفقُّد
مُتحوّلي شينغينتشي ضئيلة جدّاً

36
00:04:31,550 --> 00:04:33,730
،لكن احتمالات مجيئه للبحث عنّي مُرتفعة جدّاً

37
00:04:33,730 --> 00:04:36,560
لأنّني أضفتُ بعض المعلومات الإضافيّة

38
00:04:36,560 --> 00:04:39,270
شيء لن يُلاحظه أحد سوى ما

39
00:04:39,580 --> 00:04:43,520
ما، أتتذكّر الدّمية السّوداء الّتي سُحِقت؟

40
00:04:43,520 --> 00:04:45,570
!أنا، زانغ تشولان، من فعل ذلك

41
00:04:45,570 --> 00:04:47,720
ما كان ينبغي للدّمية السّوداء أن
تكون موجودة هناك

42
00:04:47,720 --> 00:04:51,530
إضافة ذلك يُغيّر معنى الرّسالة بأكملها

43
00:04:52,140 --> 00:04:57,360
ما، هذا الفخّ الغبيّ قد نُصِب بواسطتي
أنا، زانغ تشولان

44
00:04:58,290 --> 00:05:02,890
تكبّدتُ كلّ هذا العناء فقط لترك رسالة
لا يستطيع سواك فهمها

45
00:05:03,310 --> 00:05:06,720
حسناً، سنُغادر بعد اليوم

46
00:05:07,060 --> 00:05:09,240
،قد لا تأتي إلى هنا

47
00:05:09,240 --> 00:05:12,790
لكن لا أظنّك ستجلس مكتوف
اليدين بعد رؤية تلك الرّسالة

48
00:05:12,790 --> 00:05:14,880
ما دمت على قيد الحياة

49
00:05:14,880 --> 00:05:16,810
،والجميع يبحثون عنك

50
00:05:16,810 --> 00:05:19,820
فمن الأفضل اللّقاء في هذا المكان المنبوذ

51
00:05:21,880 --> 00:05:26,140
زانغ تشولان، تريد رؤيتي، صحيح؟

52
00:05:26,140 --> 00:05:28,140
!لديّ أمر عليّ حسمه معك أيضاً

53
00:05:33,100 --> 00:05:34,060
...أنت

54
00:05:34,540 --> 00:05:38,410
تبّاً! إنّ رؤية هذا الوجه الآن يجعلني
!أرغب في إبراحه ضرباً

55
00:05:38,410 --> 00:05:39,590
!تحكّم بتعابير وجهي

56
00:05:39,590 --> 00:05:41,500
!تحكّم بتعابير وجهي بحرص

57
00:05:41,500 --> 00:05:42,640
لا يهمّ من أكون

58
00:05:42,640 --> 00:05:44,960
سمعتُ بأنّكم تصرّفتُم مع أصدقائي

59
00:05:44,960 --> 00:05:47,750
!أتيتُ إلى هنا لمعرفة السّبب فحسب

60
00:05:51,640 --> 00:05:53,480
،لا أستطيع إخبارك بالتّفاصيل

61
00:05:53,480 --> 00:05:55,670
!لكن يكفي القول بأنّ هذا مُجرّد تلفيق

62
00:05:55,670 --> 00:05:58,770
بعد أسبوع على الأكثر، ستتمكّن
من الاتّصال بأصدقائك

63
00:05:59,170 --> 00:06:01,740
إن لم تُصدّقني، فيمكنني أخذك
إلى الدّاخل لإلقاء نظرة

64
00:05:59,840 --> 00:06:01,740
لا يبدو أنّه يكذب

65
00:06:01,740 --> 00:06:03,600
هذا يجعلني مُطمئنّاً

66
00:06:03,600 --> 00:06:06,470
لكن أسرتموهم بسبب رجل يُدعى
ما شيانهونغ؟

67
00:06:06,470 --> 00:06:07,770
هل هذا صحيح؟

68
00:06:08,330 --> 00:06:09,720
من هو هذا ما شيانهونغ هذا؟

69
00:06:09,720 --> 00:06:12,110
...أصدقائي لم يذكروه أبداً

70
00:06:12,110 --> 00:06:14,020
هل أنت ميا شيانهونغ؟

71
00:06:14,020 --> 00:06:15,530
أقصد شخصاً أرسله هو؟

72
00:06:19,530 --> 00:06:20,570
!مُحال

73
00:06:21,100 --> 00:06:22,970
لم أسمع بهذا الشّخص أبداً

74
00:06:22,970 --> 00:06:24,480
!كان... كان ذلك وشيكاً

75
00:06:24,480 --> 00:06:25,770
!ظننتُه كشفَني

76
00:06:26,090 --> 00:06:29,280
لا؟ إن لم يكن كذلك، فلماذا تأتي فقط
بعد مضيّ يوم الإعدام؟

77
00:06:29,840 --> 00:06:32,660
،أيّاً يكن، إن لم يُرسلك ما

78
00:06:32,660 --> 00:06:34,350
فلا تلق بالاً لما سأقوله

79
00:06:34,810 --> 00:06:36,570
،لكن إن كنت تعرفه

80
00:06:36,570 --> 00:06:39,100
ولا تريد أن يُصيبه مكروه

81
00:06:39,100 --> 00:06:40,680
فأوصل له هذه الرّسالة

82
00:06:40,680 --> 00:06:42,960
إنّه في خطر محدق الآن

83
00:06:42,960 --> 00:06:44,820
،يحتاج للاتّصال بي

84
00:06:44,820 --> 00:06:47,180
بأيّ وسيلة يعتبرها آمنة

85
00:06:47,180 --> 00:06:48,600
لكن يجب أن يتّصل بي

86
00:06:49,200 --> 00:06:51,470
حسناً، لنأكل

87
00:06:54,370 --> 00:06:55,640
!شكراً

88
00:06:55,640 --> 00:06:57,310
...ما شيانهونغ، تفضّل

89
00:06:57,310 --> 00:06:58,600
لا، شكراً

90
00:07:00,950 --> 00:07:02,700
باور، بماذا ناديتِه للتو؟

91
00:07:02,700 --> 00:07:05,520
ما شيانهونغ، أليس هو الّذي كنت تنتظره؟

92
00:07:06,050 --> 00:07:08,540
...لا... لكن وجهه، طوله

93
00:07:08,540 --> 00:07:11,790
،أجل، بمعزل عن الوجه والطّول
لم يتغيّر شيء يُذكَر

94
00:07:11,790 --> 00:07:13,770
ما زال بنفس الرّائحة، قويّة ولاذعة

95
00:07:21,610 --> 00:07:23,160
!أخي

96
00:07:23,160 --> 00:07:26,180
!كنتُ أنتظر هذا منذ زمن طويل

97
00:07:27,090 --> 00:07:29,300
!زانغ تشولان! انهض

98
00:07:29,300 --> 00:07:31,020
ألست مُقرّباً من عائلتي؟

99
00:07:31,020 --> 00:07:32,560
!لا أستطيع قبول هذا

100
00:07:32,560 --> 00:07:35,200
!كنتُ أثرثر فحسب يا أخي

101
00:07:35,200 --> 00:07:37,520
!يجب مُسامحة أخيك الصّغير الشّقيّ

102
00:07:37,870 --> 00:07:41,110
باور! ألم أقل لكِ أن تهيّئي أخي
بحيث يستطيع أن يؤنّبنا؟

103
00:07:41,110 --> 00:07:42,600
!أعطيه إيّاه

104
00:07:44,950 --> 00:07:45,810
!تفضّل

105
00:07:46,940 --> 00:07:50,430
باور، هل تضمرين ضغينة تجاهي؟

106
00:07:53,200 --> 00:07:56,240
،أخي، لأجل شيوخنا

107
00:07:56,240 --> 00:07:57,850
!اعفُ عن حياتي أرجوك

108
00:07:57,850 --> 00:07:59,820
،إن استطعت إزالة الأشواك من العصا

109
00:07:59,820 --> 00:08:01,600
!فسأكون أكثر امتناناً

110
00:08:02,360 --> 00:08:04,520
...كان تعلُّم طلسم التّواصُل السّماويّ أسهل

111
00:08:04,520 --> 00:08:05,680
!استدر

112
00:08:06,000 --> 00:08:07,130
!حسناً يا أخي

113
00:08:07,130 --> 00:08:09,060
!قلتُ لك استدِر وانهض

114
00:08:09,060 --> 00:08:12,850
زانغ تشولان! إيّاك والظنّ بأنّني سأدعك
!تفلت بكونك عديم الخجل! انهض

115
00:08:12,850 --> 00:08:14,800
!يجب للمرء أن يتخطّى الحدود لتصحيح خطأ

116
00:08:14,800 --> 00:08:18,180
لا أعرف كيف إذاً أستطيع أقناعك
بأنّني لا أنوي لك أيّ ضرر

117
00:08:19,400 --> 00:08:20,970
انظر إلى هذا

118
00:08:24,780 --> 00:08:25,990
!أنا واثق بأنّه لن يأتي

119
00:08:25,990 --> 00:08:27,330
لا يمكن الجزم

120
00:08:28,630 --> 00:08:31,850
،ما شيانهونغ، إن لم تأتِ

121
00:08:31,850 --> 00:08:34,450
حسناً، فلن نعود هنا بعد الآن

122
00:08:34,450 --> 00:08:36,740
لم نفعل هذا للإمساك بك

123
00:08:36,740 --> 00:08:39,100
أراد زانغ تشولان رؤيتك فحسب

124
00:08:39,450 --> 00:08:41,880
إن كنت تسعى لحسم الأمور
،مع زانغ تشولان

125
00:08:41,880 --> 00:08:44,470
فاحرص على أن تُسجّل باور
فيديو لنا لنستمتع به

126
00:08:44,470 --> 00:08:47,200
،لكن الفتى ليس مَديناً لك بشيء حقّاً

127
00:08:47,200 --> 00:08:49,080
لا من حيث المبدأ ولا من حيث النّهج

128
00:08:49,080 --> 00:08:51,310
...إذا ضربته حقّاً

129
00:08:51,310 --> 00:08:53,600
لا يهمّ

130
00:08:53,600 --> 00:08:55,280
انسَ ما قلتُه

131
00:08:55,280 --> 00:08:57,760
لستُ بارعاً في تهديد النّاس

132
00:08:59,840 --> 00:09:02,960
زانغ تشولان، تكبّدت كلّ هذا العناء لرؤيتي فقط

133
00:09:02,960 --> 00:09:04,020
ماذا تريد بالتّحديد؟

134
00:09:07,050 --> 00:09:08,820
...أن نتحادث من القلب إلى القلب

135
00:09:08,820 --> 00:09:11,100
!أخي، سأنهض، سأنهض

136
00:09:12,970 --> 00:09:15,480
،هيّا. بما أنّك تريد الكلام

137
00:09:15,480 --> 00:09:16,930
فسأستمع إلى ما لديك

138
00:09:16,930 --> 00:09:19,780
مُحادثتنا في القرية لم تكتمل، صحيح؟

139
00:09:19,780 --> 00:09:22,520
أخبرتُك بروايتي، والآن أريد سماع روايتك

140
00:09:22,520 --> 00:09:24,390
هل تحاول سحب معلومات منّي؟

141
00:09:24,390 --> 00:09:27,500
،أريد فقط معرفة ماضيك مع عائلتك

142
00:09:27,500 --> 00:09:29,520
وكيف فقدت ذاكرتك

143
00:09:30,270 --> 00:09:32,240
قبل وفاة جدّي، قال بأنّه

144
00:09:32,240 --> 00:09:34,470
خطّط لتمرُّد جياشين

145
00:09:34,830 --> 00:09:38,730
لكن في ذاكرتي، لم يشتكِ أبداً من وضعه

146
00:09:38,730 --> 00:09:40,960
لم يعتبر نفسه ضحيّة

147
00:09:40,960 --> 00:09:43,080
شعرَ بأنّه استحقّ ذلك

148
00:09:43,080 --> 00:09:44,220
أليس هذا مُثيراً للاهتمام؟

149
00:09:46,070 --> 00:09:47,740
أنا أحسدك حقّاً

150
00:09:48,700 --> 00:09:51,070
على الأقلّ تمكّنت من قضاء بضع
سنوات مع المُعلّم زانغ

151
00:09:51,680 --> 00:09:53,600
،لم ألتقِ أبداً بوالد جدّي

152
00:09:53,600 --> 00:09:56,000
لكن كثيراً ما سمعتُ جدّي يتحدّث عنه

153
00:10:01,750 --> 00:10:04,220
شيانهونغ! أحلام يقظة من جديد؟

154
00:10:04,560 --> 00:10:07,270
لماذا كنتَ تُحدّق بذلك الشّيء كثيراً مُؤخّراً؟

155
00:10:08,000 --> 00:10:10,570
...أخي، ألم تلحظوا

156
00:10:12,880 --> 00:10:14,830
قلتُ لكم دعوا شيانهونغ وشأنه

157
00:10:14,830 --> 00:10:16,230
إنّه هكذا دوماً

158
00:10:16,230 --> 00:10:18,350
من في القرية يلعب معه أصلاً؟

159
00:10:18,660 --> 00:10:21,680
أعتقد بأنّ شيانهونغ لديه خلل في عقله
من شدّة الوحدة

160
00:10:21,680 --> 00:10:24,870
أيّها الشّقيّان، ماذا تقولان؟

161
00:10:24,870 --> 00:10:26,430
!جدّي

162
00:10:26,730 --> 00:10:30,390
أخبرني، ما مُشكلة شيانهونغ؟

163
00:10:31,140 --> 00:10:34,970
جدّي، ألم تصنع خرزة للجميع في العائلة؟

164
00:10:35,430 --> 00:10:39,510
قال شيانهونغ بأنّك إذا حدّقت بها
!لفترة طويلة، فإنّها تتوهّج

165
00:10:41,260 --> 00:10:44,180
ماذا؟ ماذا تقصد يا أبي؟

166
00:10:44,180 --> 00:10:45,930
تريد من شيانهونغ أن يتعلّم منك؟

167
00:10:49,700 --> 00:10:52,430
جدّي، هل أنت من صنع كلّ هذا؟

168
00:10:52,870 --> 00:10:57,560
هل تريد أن تتعلّم كيفيّة صنع هذه معي؟

169
00:10:57,560 --> 00:10:58,470
!أجل

170
00:10:58,930 --> 00:11:03,720
والد جدّك علّمني كيفيّة صنع هذه

171
00:11:04,500 --> 00:11:07,080
،آنذاك، قال

172
00:11:07,080 --> 00:11:09,710
أتعلم يا يوانلو؟

173
00:11:10,320 --> 00:11:12,710
لستُ مُؤهَّلاً لنقل هذا إليك

174
00:11:12,710 --> 00:11:14,220
!لستُ جديراً

175
00:11:15,180 --> 00:11:17,230
،وقال أيضاً

176
00:11:17,230 --> 00:11:21,240
،يوانلو، أفهم كلّ هذه المبادئ

177
00:11:21,240 --> 00:11:25,220
لكن ما زلتُ لا أستطيع تجاوز
هذا الحاجز العقليّ

178
00:11:25,540 --> 00:11:30,240
"،صُنِعت هذه المهارات بواسطتي"

179
00:11:30,240 --> 00:11:34,100
"لكن لا أريدها حقّاً أن تُخمَد بين يدَي"

180
00:11:34,100 --> 00:11:38,680
آنذاك، كنتُ صغيراً جدّاً على فهم"
"ما قصده والد جدّك

181
00:11:39,100 --> 00:11:42,930
"لم أُدرِك إلّا بعد أن ورثتُ تقنيّاته بشكل كامل"

182
00:11:43,280 --> 00:11:46,640
"!لا أستطيع السّماح لها بالضّياع أيضاً"

183
00:11:47,000 --> 00:11:48,760
،كنتُ طفلاً آنذاك فحسب

184
00:11:48,760 --> 00:11:51,270
كيف لي أن أفهم ما كان يتحدّث عنه؟

185
00:11:51,270 --> 00:11:56,220
ومنذ تلك اللّحظة، عشتُ مع جدّي وتعلّمتُ منه

186
00:11:57,210 --> 00:12:02,130
،بالنّظر للوراء، أظنّه كان يختبرني من كلّ ناحية

187
00:12:02,130 --> 00:12:03,920
لكنّه كان مُتردّداً أيضاً

188
00:12:03,920 --> 00:12:06,140
،لو لم تكن مُؤهّلاً لذلك فقط

189
00:12:06,140 --> 00:12:10,160
أو لو كان المُعلّم يوانلو عديم
،الرّحمة وتركها الإرث يُخمَد

190
00:12:10,160 --> 00:12:11,850
لما كنّا واجهنا كلّ هذه المشاكل اليوم

191
00:12:13,710 --> 00:12:17,380
زانغ تشولان، أعتقد بأنّك عديم الرّحمة

192
00:12:17,380 --> 00:12:18,750
عمّاذا تتكلّم؟

193
00:12:18,750 --> 00:12:20,850
!هيّا، تابع، تابع

194
00:12:22,790 --> 00:12:24,430
!جدّي! انظر إلى خاصّتي

195
00:12:24,430 --> 00:12:26,660
!ما رأيك؟ انظر إلى هذا العمل

196
00:12:26,660 --> 00:12:28,140
!لم أنتهِ بعد

197
00:12:28,140 --> 00:12:30,660
كنتُ أتعلّم من أبي منذ بضعة أيّام فقط

198
00:12:33,310 --> 00:12:34,380
ما رأيك؟

199
00:12:34,380 --> 00:12:35,670
أفضل من شيانهونغ، صحيح؟

200
00:12:35,670 --> 00:12:37,640
لِمَ لا تُعلّمني أيضاً؟

201
00:12:37,640 --> 00:12:40,810
!هيّا، اخرجا من هنا

202
00:12:41,500 --> 00:12:43,890
!مهارات أبيكما أكثر من كافية لتعليمكما

203
00:12:56,450 --> 00:12:59,680
شيانهونغ، الآخرون جميعهم قد انتهوا بالفعل

204
00:12:59,680 --> 00:13:01,970
لماذا ما زلت تهدر وقتك بهذا الجزء؟

205
00:13:02,650 --> 00:13:06,180
جدّي، ربّما لستُ مُؤهّلاً لهذا حقّاً؟

206
00:13:06,650 --> 00:13:09,210
كنتُ أُحاول مُنافسة شيانهي

207
00:13:09,210 --> 00:13:12,760
لكن الآن بعد أن بدأت، لا أستطيع
...ترك هذه المادّة

208
00:13:15,320 --> 00:13:17,140
ترك هذه المادّة؟

209
00:13:17,760 --> 00:13:19,770
،أجل. حالما تصبح هذه المادّة بين يدَي

210
00:13:19,770 --> 00:13:22,940
فما تصبح إليه هو أمر عائد إليّ تماماً

211
00:13:23,470 --> 00:13:25,340
رأيتُ أشياء جيّدة

212
00:13:25,340 --> 00:13:28,100
مُنتجاتك كلّها أشياء جيّدة. إنّها مُتوهّجة

213
00:13:28,710 --> 00:13:30,400
،أيّ شيء يمرّ من خلال أصابعي

214
00:13:30,400 --> 00:13:32,270
،حتّى أصغر مُكوّن

215
00:13:33,130 --> 00:13:36,220
إن لم أرَ ذلك الضّوء واللّمعان، فلن أُفلته

216
00:13:40,800 --> 00:13:42,430
،شيانهونغ

217
00:13:42,430 --> 00:13:45,450
طوال هذه السّنين، وأنا أراقبك

218
00:13:45,450 --> 00:13:49,310
اليوم، سأنقل إليك المهارات الحقيقيّة
الّتي علّمني إيّاها والد جدّك

219
00:13:49,790 --> 00:13:51,810
!لكن يجب أن تُقسم لي

220
00:13:51,810 --> 00:13:57,900
لا تُري أحداً الأدوات الحِرفيّة المصنوعة
!باستخدام الطّرُق الّتي علّمتُك إيّاها

221
00:13:57,900 --> 00:14:02,140
يمكنك استخدامها فقط عندما
!تتعرّض أنت وعائلتنا لخطر

222
00:14:02,960 --> 00:14:04,080
وبعد ذلك؟

223
00:14:04,080 --> 00:14:07,340
لم تلتزم بكلام المُعلّم يوانلو، وكشفت
عن الحِرفيّة القدسيّة؟

224
00:14:07,340 --> 00:14:08,430
لم أفعل

225
00:14:08,430 --> 00:14:10,420
،قبل مجيء أولئك الأشخاص لاستهدافنا

226
00:14:10,420 --> 00:14:12,850
التزمتُ بوعدي لجدّي على الدّوام

227
00:14:13,330 --> 00:14:14,480
جدّي، ماذا حدث؟

228
00:14:14,480 --> 00:14:16,890
!بترَ أحدٌ ساقَه

229
00:14:17,680 --> 00:14:18,740
!أبي

230
00:14:19,310 --> 00:14:21,560
جدّي، ما الأمر؟

231
00:14:21,560 --> 00:14:23,180
!أبي

232
00:14:24,180 --> 00:14:27,560
...شيانهونغ، اذهب وأحضر

233
00:14:27,560 --> 00:14:31,020
أدواتي وأدواتك. أحضرها إلى هنا

234
00:14:31,350 --> 00:14:33,460
ثمّ تعال إليّ

235
00:14:33,460 --> 00:14:35,340
!بقيّتكم، اخرجوا

236
00:14:35,340 --> 00:14:36,590
!اخرجوا جميعاً

237
00:14:39,020 --> 00:14:41,560
جدّي، أحضرتُ كلّ ما طلبته

238
00:14:41,560 --> 00:14:43,680
ما الّذي فعلَ بك هذا بالضّبط؟

239
00:14:43,680 --> 00:14:46,150
!لا أعرفهم

240
00:14:46,150 --> 00:14:49,280
!شيانهونغ، خُذ العائلة وغادروا

241
00:14:49,280 --> 00:14:52,160
اهربوا حالاً! لا تقلقوا بشأني

242
00:14:53,270 --> 00:14:54,540
...كيف لي أن

243
00:14:54,540 --> 00:14:56,020
!لن أتخلّى عنك أبداً يا جدّي

244
00:14:57,420 --> 00:14:58,300
!جدّي

245
00:14:59,130 --> 00:15:01,810
...اذهب! إنّهم قادمون

246
00:15:02,550 --> 00:15:04,890
إنّهم قادمون لسرقة الحِرفيّة القدسيّة

247
00:15:05,520 --> 00:15:08,730
والد جدّك بينزاي قد تُوفّي منذ
سنوات طويلة الآن

248
00:15:08,730 --> 00:15:12,510
!كنتُ مُستهتراً، ولم يستسلموا أبداً

249
00:15:12,510 --> 00:15:16,920
شيانهونغ، يجب أن تفهم مدى
!خطورة هذا بالنّسبة لنا

250
00:15:17,460 --> 00:15:20,090
لم يبدؤوا بخطوتهم التّالية بعد

251
00:15:20,090 --> 00:15:22,060
!إنّهم يمنحونني فُرصة

252
00:15:22,060 --> 00:15:25,090
!يريدونني أن أُسلّم حِرفيّتنا القدسيّة

253
00:15:26,230 --> 00:15:27,500
لا تقلق بشأني

254
00:15:27,500 --> 00:15:29,850
!اهربوا أنتم، لأبعد مسافة مُمكنة

255
00:15:30,370 --> 00:15:32,850
!أنا مُجرّد عبء عليكم الآن

256
00:15:32,850 --> 00:15:34,850
،مستحيل! إمّا أن نُغادر معاً

257
00:15:34,850 --> 00:15:37,300
!أو سأبقى وأُقاتلهم معك

258
00:15:37,300 --> 00:15:39,210
لن أدعك بمفردك هنا

259
00:15:41,830 --> 00:15:43,150
!عنيد جدّاً

260
00:15:46,550 --> 00:15:49,010
،أنت فتى صالح من كلّ ناحية

261
00:15:49,010 --> 00:15:50,620
!لكنّك عنيد جدّاً

262
00:15:50,620 --> 00:15:54,300
حسناً إذاً، لنذهب ونرَ الآخرين أوّلاً

263
00:15:54,300 --> 00:15:56,250
سيّدي، لماذا تنهض؟

264
00:15:56,250 --> 00:15:57,390
!لا يمكن تخريجك بعد

265
00:16:15,800 --> 00:16:16,900
وصلنا

266
00:16:18,500 --> 00:16:19,800
!جدّي، اهدأ

267
00:16:19,800 --> 00:16:20,880
!دعني أُساعدك

268
00:16:20,880 --> 00:16:21,810
!لا حاجة

269
00:16:21,810 --> 00:16:24,520
،إذا احتجتُ مُساعدة للمشي فقط

270
00:16:24,520 --> 00:16:26,470
!فأنا أُشكّل عبئاً عليك فعلاً

271
00:16:39,930 --> 00:16:41,470
ماذا حدث بعد ذلك؟

272
00:16:41,470 --> 00:16:43,350
أنت والمُعلّم يوانلو عدتُما إلى المنزل

273
00:16:43,350 --> 00:16:44,310
ماذا حدث بعد ذلك؟

274
00:16:45,380 --> 00:16:48,450
أخبرتُك بالفعل بما يمكنني إخبارك به

275
00:16:48,450 --> 00:16:49,680
،إذاً هذا يعني

276
00:16:49,680 --> 00:16:52,500
فقدت ذاكرتك عن عائلتك منذ تلك اللّحظة

277
00:16:52,500 --> 00:16:54,520
لا يمكنك أن تخبرني بما حدث بعد ذلك

278
00:16:55,650 --> 00:16:57,240
الذّكريات بعد ذلك

279
00:16:57,240 --> 00:16:59,930
لا بُدّ أنّها مُرتبطة بالأشخاص الّذين
نُواجههم، أليس كذلك؟

280
00:16:59,930 --> 00:17:01,620
ما الّذي تحاول قوله بالضّبط؟

281
00:17:02,470 --> 00:17:04,400
،أحتاج للتحقُّق من شيء أوّلاً

282
00:17:04,400 --> 00:17:06,900
في حال كنتَ مُتورّطاً

283
00:17:06,900 --> 00:17:07,890
هل أنت من فعل هذا؟

284
00:17:07,890 --> 00:17:08,900
لا

285
00:17:08,900 --> 00:17:10,270
ماذا عن غو ليانغ؟

286
00:17:12,570 --> 00:17:16,060
هل سبقَ وشككت بالأشخاص المُحيطين حولك؟

287
00:17:17,760 --> 00:17:18,940
هكذا إذاً

288
00:17:18,940 --> 00:17:21,390
زانغ تشولان، أنت هنا لإشعال فتنة

289
00:17:21,390 --> 00:17:24,850
ثمّة مُشكلة في الحالة الرّاهنة لـ ما شيانهونغ

290
00:17:24,850 --> 00:17:28,110
أيّ شخص عاديّ كان ليُشتبَه به

291
00:17:28,110 --> 00:17:29,640
إذا مرّ بما مرّ به شيانهونغ

292
00:17:29,640 --> 00:17:33,100
ما لم أستطع اكتشاف ما فعله الأشخاص
،الّذين يقفون خلف "ما" له

293
00:17:33,100 --> 00:17:35,430
لن أتمكّن من ضمّ "ما" إلى حلفنا

294
00:17:36,130 --> 00:17:39,810
اهدأ! أنا هنا فقط لنقل رسالة
من رئيس شركتنا زاو

295
00:17:40,060 --> 00:17:42,070
الرّئيس زاو؟ زاو فانغشو؟

296
00:17:43,100 --> 00:17:46,580
زانغ تشولان. حشدتُ مواردَ الشّركة

297
00:17:46,580 --> 00:17:50,810
وتكبّدتُ كلّ هذا العناء لمُساعدتك
في تنفيذ خطّة نصب الكمين هذه

298
00:17:50,810 --> 00:17:52,600
والآن تريدني أن أدعه وشأنه؟

299
00:17:52,600 --> 00:17:55,480
وإلغاء عمليّة مُطاردة الشّركة له؟

300
00:17:55,480 --> 00:17:57,470
ما الفائدة الّتي تعود على الشّركة من ذلك؟

301
00:17:57,470 --> 00:17:59,970
،إذا كشفَ ما شيانهونغ عن نفسه حقّاً

302
00:17:59,970 --> 00:18:03,010
فهذا يُثبت وجود شرخ بينه وبين
الّذين يقفون خلفه

303
00:18:03,010 --> 00:18:04,810
هذا مكسبٌ بالفعل من هذه العمليّة

304
00:18:04,810 --> 00:18:06,680
،للتّعامل مع شخص مثل شيانهونغ

305
00:18:06,680 --> 00:18:08,220
عليك أن تُبدي حسن النّيّة

306
00:18:08,220 --> 00:18:10,470
!يجب أن تكسب ودّه

307
00:18:10,850 --> 00:18:12,640
أفهم ما تقصده

308
00:18:12,640 --> 00:18:15,160
لكن لِمَ عليّ تكبُّد كلّ هذا العناء؟

309
00:18:15,840 --> 00:18:19,460
سمعتُ أنّ تشو رانغ لم يتراجع بعد، صحيح؟

310
00:18:20,770 --> 00:18:24,510
هل تعتقد بأنّك تستطيع التّعامل مع مثَله
الأعلى ما شيانهونغ بالقوّة؟

311
00:18:24,510 --> 00:18:26,390
فكّرتُ قليلاً في هذا الأمر

312
00:18:26,390 --> 00:18:28,720
،لكن ماذا لو أقنعنا عائلة ليو بالتّعاون

313
00:18:28,720 --> 00:18:30,310
واستخدمنا مهارتهم الرّوح المُشرقة؟

314
00:18:32,760 --> 00:18:34,250
ما الخطب يا زانغ؟

315
00:18:34,250 --> 00:18:35,390
لماذا تضحك؟

316
00:18:36,400 --> 00:18:39,500
لا شيء، لم أدرك بأنّك فكّرتَ كلّ
هذا التّفكير في الأمر بالفعل

317
00:18:40,060 --> 00:18:41,600
هل تسخر منّي؟

318
00:18:41,600 --> 00:18:42,810
!بالطّبع لا

319
00:18:42,810 --> 00:18:46,260
!أنت شخصٌ بارزٌ ببصيرة لا نظير لها

320
00:18:46,260 --> 00:18:49,470
أنت تتعامل مع الأمور بشموليّة أكبر
!من استيعابنا نحن الضّعفاء

321
00:18:49,830 --> 00:18:52,310
!كفى هُراء. أخبرني

322
00:18:52,310 --> 00:18:54,560
ما رأيك فعلاً؟

323
00:18:56,380 --> 00:18:57,390
إنّها فكرة جيّدة

324
00:18:57,730 --> 00:19:01,110
قد تُساهم مهارة الرُّوح المُشرقة في
استعادة "ما" لذكرياته

325
00:19:01,110 --> 00:19:03,310
،لكن إذا قبضنا عليه فحسب وعبثنا برأسه

326
00:19:03,310 --> 00:19:06,850
،فبعد ذلك، سنضطرّ لحبسه للأبد

327
00:19:06,850 --> 00:19:09,020
أو قتله

328
00:19:09,020 --> 00:19:10,680
،"نظراً لشخصيّة "ما

329
00:19:10,680 --> 00:19:13,100
سيصبح حتماً العدوّ اللّدود للشّركة

330
00:19:13,410 --> 00:19:15,940
وماذا يعني؟ ما علاقة ذلك بك؟

331
00:19:15,940 --> 00:19:17,350
!هذا ما أعنيه تماماً

332
00:19:17,350 --> 00:19:19,810
ما التّأثير الّذي تستطيع نملة مثلي إحداثه؟

333
00:19:19,810 --> 00:19:21,020
سأنفّذ أوامرك

334
00:19:26,770 --> 00:19:27,810
الرّئيس زاو؟

335
00:19:27,810 --> 00:19:30,020
،لطالما تساءلتُ

336
00:19:30,480 --> 00:19:33,100
عمّا رأى فيك المُعلّم شو؟

337
00:19:33,100 --> 00:19:35,120
هل تسخر منّي؟

338
00:19:35,120 --> 00:19:36,660
أنا لا أسخر منك

339
00:19:36,660 --> 00:19:39,680
!أنا خائف منك أيّها المُهمّ

340
00:19:40,960 --> 00:19:42,470
،المُهمّون لديهم بصيرة

341
00:19:42,890 --> 00:19:46,010
وغالباً لا يُلاحظون النّمل الصّغير بين أقدامهم

342
00:19:46,010 --> 00:19:49,600
لكن في العادة النّمل الصّغير هُم
!من يستطيعون عضّ الأشخاص المُهمّين

343
00:19:50,690 --> 00:19:54,290
،إذا تعاملتُ مع ما شيانهونغ بعنف

344
00:19:54,290 --> 00:19:55,850
فهل سيخيب أملك بي؟

345
00:19:58,210 --> 00:19:59,270
كنتُ لأتفاجأ

346
00:19:59,550 --> 00:20:01,220
لا أعتقد بأنّ شخصاً كهذا

347
00:20:01,220 --> 00:20:03,220
سينضمّ للمُعلّم شو في حماية باور

348
00:20:05,070 --> 00:20:08,140
حسناً، سأفكّر فيما قلتَه

349
00:20:08,140 --> 00:20:09,520
لكن هناك شرطان

350
00:20:09,840 --> 00:20:13,310
الاوّل، يجب عليك أن تتأكّد من أنّك
لم تقتل أي موظّف في الشّركة

351
00:20:13,310 --> 00:20:18,030
ثانياً، الصّراع بينك وبين الشّركة
لم يُعالَج بالكامل بعد

352
00:20:18,030 --> 00:20:21,100
،بعد أن نتعامل مع الوضع الرّاهن

353
00:20:21,100 --> 00:20:24,240
يمكننا الجلوس ومُناقشة الأمور فيما يتعلّق

354
00:20:24,240 --> 00:20:27,680
بالحِرفيّة القدسيّة وأتون التّنمية

355
00:20:27,680 --> 00:20:30,230
في هذه الأثناء، يمكنك الذّهاب إلى أيّ مكان

356
00:20:30,230 --> 00:20:32,950
ولن تعتبرك الشّركةُ هارباً

357
00:20:32,950 --> 00:20:37,440
على ذكر الأمر، سمعتُ بأنّك تبحث عن عائلتك؟

358
00:20:37,440 --> 00:20:39,330
،عندما يتعلّق الأمر بالبحث عن أشخاص

359
00:20:39,330 --> 00:20:42,850
فالشّركة هي حتماً أكثر أهليّة
منك ومن زملائك

360
00:20:42,850 --> 00:20:43,640
ما رأيك؟

361
00:20:43,640 --> 00:20:46,870
،في النّهاية، ما زلت تحاول إشعال فتنة

362
00:20:46,870 --> 00:20:49,100
بأن تقطفنا واحداً تلو الآخر، صحيح؟

363
00:20:50,770 --> 00:20:53,060
أنت تسيء فهمنا

364
00:20:53,060 --> 00:20:55,420
لكن يا "ما"، لستَ قويّاً لدرجة

365
00:20:55,420 --> 00:20:58,320
ألّا تستطيع الشّركة مُعالجة
الأمور دون القضاء عليك

366
00:20:58,320 --> 00:21:01,390
أنا وبكلّ أمانة لا أريدك أن تسقط
مع الّذين خلفك

367
00:21:01,910 --> 00:21:03,600
أنت شخص طيّب

368
00:21:04,300 --> 00:21:06,170
هل سبقَ وارتكبتُ فعلاً سيّئاً؟

369
00:21:07,410 --> 00:21:10,100
سمعتُ بأنّك تبحث عن عائلتك؟

370
00:21:10,540 --> 00:21:12,470
،عندما يتعلّق الأمر بالبحث عن أشخاص

371
00:21:12,470 --> 00:21:15,970
فالشّركة هي حتماً أكثر أهليّة
منك ومن زملائك

372
00:21:15,970 --> 00:21:18,470
...فكّر في الأمر بحرص

373
00:21:21,850 --> 00:21:22,680
!ما

374
00:21:23,390 --> 00:21:26,090
خدعتني حقّاً هناك في القرية

375
00:21:26,090 --> 00:21:27,220
،زانغ تشولان

376
00:21:28,090 --> 00:21:30,800
لم أعُد أثق بأيّ كلمة تقولها

377
00:21:33,380 --> 00:21:34,930
هذا صحيح

378
00:21:35,250 --> 00:21:36,810
!هذا صحيح يا ما

379
00:21:37,390 --> 00:21:39,220
لم نلتقِ إلّا بضع مرّات بالمُجمَل

380
00:21:39,220 --> 00:21:41,100
!لا تملك سبباً للوثوق بي

381
00:21:41,100 --> 00:21:43,850
ذكرياتك المفقودة وعائلتك الضّائعة قد يكونون

382
00:21:43,850 --> 00:21:45,720
!مُرتبطين بالأشخاص المُحيطين حولك الآن

383
00:21:45,720 --> 00:21:47,220
!لا تُصدِّق ذلك أيضاً

384
00:21:47,770 --> 00:21:50,020
--زانغ تشولان، هل تقول بأنّ أختـ

385
00:21:53,020 --> 00:21:54,470
!انسَ الأمر يا ما

386
00:21:54,470 --> 00:21:55,740
ليس هذا مقصدي

387
00:21:55,740 --> 00:21:58,220
،مقصدي هو بأنّه لا يمكن الوثوق بي
!وليس أنا فحسب

388
00:21:58,220 --> 00:21:59,430
!لا تثق بأحد

389
00:22:00,010 --> 00:22:01,410
لا أثق بأحد؟

390
00:22:03,140 --> 00:22:08,580
...لا تثق بأحد

391
00:22:13,420 --> 00:22:15,090
...لا تثق بأحد

392
00:22:16,160 --> 00:22:20,020
لا أثق بأحد؟

393
00:22:20,020 --> 00:22:21,930
...ما، أنت

394
00:22:26,720 --> 00:22:29,260
!زانغ تشولان

395
00:22:28,210 --> 00:22:29,260
!أنا بخير

396
00:22:29,700 --> 00:22:30,460
!لا تتحرّك

397
00:22:49,970 --> 00:22:50,600
أمسِك

398
00:22:53,670 --> 00:22:55,430
هذه... أداة حِرفيّة سحريّة؟

399
00:22:55,820 --> 00:22:57,490
ما الغرض منها؟ كيف أستخدمها؟

400
00:22:58,300 --> 00:22:59,200
!ما

401
00:22:59,200 --> 00:23:00,410
!لا تتبعني

402
00:23:00,410 --> 00:23:01,840
دعني أفكّر لوحدي لبعض الوقت

403
00:23:01,840 --> 00:23:03,680
!على الأقلّ اترك رقمَ هاتف يا ما

404
00:23:10,630 --> 00:23:12,690
ما الخطب يا زانغ تشولان؟

405
00:23:12,690 --> 00:23:13,850
ما الّذي تُفكّر فيه؟

406
00:23:14,210 --> 00:23:17,670
كما قلت أنت، ظهرَ ما شيانهونغ فعلاً

407
00:23:17,670 --> 00:23:19,310
ولم ينقلب ضدّك

408
00:23:19,590 --> 00:23:21,460
ألم تُنجز أهدافك؟

409
00:23:25,710 --> 00:23:28,470
لا، ثمّة مُشكلة ما

410
00:23:34,270 --> 00:23:37,810
المُعلّم لينغيو، باور، طرأ تغيير طفيف في الخطّة

411
00:23:38,480 --> 00:23:40,980
!لنلحق به، لنلحق بـ ما شيانهونغ