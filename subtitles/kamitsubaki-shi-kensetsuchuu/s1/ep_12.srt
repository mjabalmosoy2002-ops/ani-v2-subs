1
00:01:34,370 --> 00:01:35,330
حسناً

2
00:01:38,460 --> 00:01:43,080
يبدو وكأنّه مضى وقت طويل
منذ حبسني أبي هنا

3
00:01:47,830 --> 00:01:49,460
إنّه مُغبرّ كثيراً

4
00:01:50,020 --> 00:01:53,100
أعتقد هذا منطقيّ، بما أنّه كان
...محبوساً هنا طوال هذا الوقت

5
00:01:57,890 --> 00:02:00,550
لم يُمسّ منذ مُغادرتي

6
00:02:05,940 --> 00:02:11,020
استخدمتُ مشاعر أبي لإعطاء عذر لضعفي

7
00:02:13,170 --> 00:02:16,140
أتساءل ما إن كان سيغضب إذا رآني الآن

8
00:02:16,890 --> 00:02:19,780
لا، ربّما سيتساهل معي

9
00:02:20,120 --> 00:02:22,220
كان رجلاً لطيفاً

10
00:02:27,930 --> 00:02:32,000
في النّهاية، لم يكن هناك أيّ مكان
،آمن للبقاء فيه

11
00:02:32,500 --> 00:02:36,210
لكن أعيش في عالم حُرّ تقوده إرادتي الخاصّة

12
00:02:37,190 --> 00:02:40,060
...هذه المدينة الّتي حاول أبي حمايتها

13
00:02:40,060 --> 00:02:42,280
سوف نحميها معاً هذه المرّة

14
00:02:42,680 --> 00:02:46,820
ما دام لدينا الفراغمينت... قوّة
،مشاعر النّاس

15
00:02:46,820 --> 00:02:48,730
أعلم بأنّنا سنتمكّن من فعلها

16
00:02:49,240 --> 00:02:50,320
شكراً

17
00:02:51,550 --> 00:02:55,800
شخصيّاً، كنتُ أُفضّل التّركيز
،على إعادة بناء المنطقة صفر

18
00:02:55,800 --> 00:02:57,690
والّتي تحتوي على وظائف المدينة

19
00:02:57,690 --> 00:03:01,000
هناك الكثير من الأضرار في المنطقة 2
والمنطقة 4 على ما أعتقد

20
00:03:01,000 --> 00:03:03,550
الأولويّة لضمان سلامة النّاس

21
00:03:03,550 --> 00:03:07,300
يمكننا عرض شقق احتياطيّة في إسكان
البلديّة الخاصّة بالمنطقة صفر

22
00:03:08,140 --> 00:03:11,860
هارو في المنطقة 2، لذا سأتولّى المنطقة 4

23
00:03:13,620 --> 00:03:18,030
لأجل السّلامة العامّة، سيكون من الأفضل
لنا جميعاً أن نعيش بالقرب من بعضنا

24
00:03:17,140 --> 00:03:18,880
كوكو. تيسّيراكتور

25
00:03:19,740 --> 00:03:21,210
!أوصلهم إلى برّ الأمان بسرعة

26
00:03:21,210 --> 00:03:22,190
!عُلِم

27
00:03:27,600 --> 00:03:30,130
بقايا الّذين صنعهم ماكسويل

28
00:03:30,130 --> 00:03:31,880
لنقضِ عليهم دُفعة واحدة

29
00:03:46,090 --> 00:03:47,530
تمّ التّحييد

30
00:05:39,390 --> 00:05:40,380
هل بقي أحد؟

31
00:05:40,380 --> 00:05:41,330
ليس هنا

32
00:05:41,330 --> 00:05:43,320
هل هذا يعني أنّ هناك المزيد
في أماكن أُخرى؟

33
00:05:43,720 --> 00:05:45,750
من الأفضل أن نُركّز على ذلك أوّلاً

34
00:05:49,790 --> 00:05:51,580
البدء من العدم؟

35
00:05:51,580 --> 00:05:53,190
لنُضِف المزيد من الحواجز هذه المرّة

36
00:05:53,510 --> 00:05:54,490
!القائدة

37
00:05:55,080 --> 00:05:56,160
كيف سارت الأمور؟

38
00:05:56,160 --> 00:05:58,990
لم يكن مزار أوكوتاداما سيّئاً كما
هنا على الأقلّ

39
00:05:58,990 --> 00:06:01,100
إذاً هذا المكان هو أكثر المُتضرّرين؟

40
00:06:01,100 --> 00:06:03,650
فرع إعادة الإعمار يوفّر المواد، صحيح؟

41
00:06:03,650 --> 00:06:06,480
أجل. حريّ بنا أن نسرع
في إزالة الأنقاض

42
00:06:06,480 --> 00:06:07,760
عرفتُ بأنّكِ ستقولين ذلك

43
00:06:07,760 --> 00:06:12,000
حرصتُ على إرسال الشّاحنات والآلات
الثّقيلة الّتي ما زالت تعمل إلى هنا

44
00:06:12,510 --> 00:06:14,520
!هنا

45
00:06:15,020 --> 00:06:16,140
!العمّة

46
00:06:16,420 --> 00:06:18,700
،عندما تحين الذّكرى السّنويّة الأولى

47
00:06:18,700 --> 00:06:22,860
آمل أن نُري أرواح أصدقائنا
المفقودين بلدةً مُرمَّمة

48
00:06:22,860 --> 00:06:23,820
!هارو

49
00:06:23,820 --> 00:06:24,900
!القائدة

50
00:06:27,770 --> 00:06:30,240
!سنُريهم ما يمكننا فعله

51
00:06:30,240 --> 00:06:31,790
!شدّوا همّتكم

52
00:08:03,390 --> 00:08:07,000
صوفيا، ساحرة الأصول، موجودة فعلاً

53
00:08:07,000 --> 00:08:10,380
ليست كافّة تعاليم الكنيسة كانت كذِباً

54
00:08:10,380 --> 00:08:13,590
رغم أنّها لم تُحقّق الخلاص الّذي وعدتْ به

55
00:08:29,320 --> 00:08:31,080
هل ترين شيئاً؟

56
00:08:31,080 --> 00:08:31,770
أجل

57
00:08:33,000 --> 00:08:34,200
نور

58
00:08:34,200 --> 00:08:40,120
لنزرع البذور هنا

59
00:08:40,120 --> 00:08:46,540
نسقيها وننتظرها حتّى تنمو

60
00:08:46,540 --> 00:08:54,590
يوماً ما، لإنارة كلّ شيء

61
00:08:54,590 --> 00:08:58,680
ستتفتّح الزّهور

62
00:08:58,980 --> 00:09:05,230
في يوم ماطر، افتح مظلّة

63
00:09:05,230 --> 00:09:11,320
،وأسمع أصوات الخبط عليها
أوركسترا المطر

64
00:09:11,710 --> 00:09:18,490
أشتمّ رائحة عطرة

65
00:09:18,490 --> 00:09:24,790
رأيت؟ وجدتها الآن

66
00:09:27,370 --> 00:09:33,790
أريد الذّهاب والبحث معك

67
00:09:33,790 --> 00:09:39,820
عن القواعد المحبوبة للعالم

68
00:09:39,820 --> 00:09:47,400
البريق قريب جدّاً

69
00:09:47,400 --> 00:09:53,780
حياتي تشتعل

70
00:09:53,780 --> 00:10:01,510
تطلي كلّ شيء بالأحمر

71
00:14:42,610 --> 00:14:45,340
لننضمّ للآخرين

72
00:14:47,500 --> 00:14:49,040
!لحظة فقط

73
00:14:51,350 --> 00:14:53,870
أحضرتُ الشّاي لكم جميعاً

74
00:14:53,870 --> 00:14:54,920
!شكراً لكِ

75
00:14:54,920 --> 00:14:57,980
...رئيسة الفرع. تبدين هكذا من جديد

76
00:14:57,980 --> 00:15:01,680
سأكون عاجزة عن حمل مثل هذا
الشّاي الثّقيل بهيئة الطّائر خاصّتي

77
00:15:01,680 --> 00:15:03,160
لا مُشكلة. إنّها ظريفة

78
00:15:03,160 --> 00:15:04,880
أجل! يروقني هذا أيضاً

79
00:15:04,880 --> 00:15:06,680
يسرّني مديحكن

80
00:15:06,680 --> 00:15:07,600
...بئساً

81
00:15:07,600 --> 00:15:09,710
أحضرتُ أكلات خفيفة مع البطاطا الحلوة المُجفّفة

82
00:15:09,710 --> 00:15:11,390
الطّعام الخاصّ بالمنطقة 3؟

83
00:15:11,390 --> 00:15:12,800
!إنّه لذيذ

84
00:15:14,860 --> 00:15:17,170
الآن سأقدّم تقريرنا الدّوريّ

85
00:15:17,170 --> 00:15:21,160
لم تعُد حوادث كيو رائجة كما
،في الأشهر الأخيرة كما كانت

86
00:15:21,160 --> 00:15:23,610
رغم أنّها ما زالت تحدث بمُعدّل مُنخفض

87
00:15:23,610 --> 00:15:26,320
نتعامل معها يوميّاً تقريباً

88
00:15:26,320 --> 00:15:31,180
حتّى بعد إعادة ولادتهم، ما زال النّاس
يُعانون من الرّغبة والخوف

89
00:15:31,180 --> 00:15:33,540
إنّ العودة لم تمسح صدمتهم النّفسيّة سحريّاً

90
00:15:33,540 --> 00:15:34,180
أجل

91
00:15:34,180 --> 00:15:39,400
تتّجه شعبيّتها تدريجيّاً لأنّ القليل
جدّاً من النّاس عادوا إلى الحياة

92
00:15:39,400 --> 00:15:42,540
،يجب فعلها بحسب النّسبة
وإلّا فلن نفهم الرّواية بكاملها

93
00:15:44,120 --> 00:15:44,920
ماذا؟

94
00:15:44,920 --> 00:15:48,670
آغني... بدا ذلك ذكيّاً جدّاً

95
00:15:48,670 --> 00:15:49,690
صادم

96
00:15:49,690 --> 00:15:53,730
ظننتُ بأنّ عضلاتك سرقت كلّ
...الطّاقة من عقلكِ

97
00:15:53,730 --> 00:15:56,110
ينبغي ألّا تتدخّل في شؤون غيرك

98
00:15:56,110 --> 00:15:57,710
أنت تُخيف ريمي حتّى

99
00:15:57,710 --> 00:15:58,740
!ماذا قلتِ؟

100
00:15:58,740 --> 00:16:01,580
ما الّذي تعرفينه عن العضلات أو العقول؟

101
00:16:01,580 --> 00:16:03,490
انظروا من يتكلّم

102
00:16:03,490 --> 00:16:05,110
!توقّف يا كوغيل

103
00:16:05,590 --> 00:16:07,270
هذا لأنّه يوجد القليل من النّاس

104
00:16:07,950 --> 00:16:08,900
ريمي؟

105
00:16:08,900 --> 00:16:13,630
أعتقد يمكننا إحياء الجميع
في مدينة كاميتسوباكي

106
00:16:13,630 --> 00:16:14,700
...المعذرة، آسف

107
00:16:14,700 --> 00:16:16,490
قوليها بلغة تستطيع هارو فهمها

108
00:16:16,490 --> 00:16:17,290
!مؤلم

109
00:16:17,290 --> 00:16:22,080
كانت قوّة مشاعرنا هي الّتي أعادت
الجميع إلى حالة الفراغمينت

110
00:16:22,750 --> 00:16:24,930
نبعَتِ المشاعر من ذكرياتنا

111
00:16:24,930 --> 00:16:26,790
كانت مُكوّنة من عواطفنا

112
00:16:26,790 --> 00:16:29,800
لكن لم تستطع بلوغ الجميع في المدينة

113
00:16:29,800 --> 00:16:35,140
فهمت. أعادتْ فقط النّاس
الأقرب إلى الماجو نو موسومي

114
00:16:35,140 --> 00:16:39,690
أجل. النّاس في المدينة الآن هم
النّاس الّذين كنّا نفكّر فيهم

115
00:16:39,690 --> 00:16:42,360
عندما كنّا نُغنّي على ما أعتقد

116
00:16:42,360 --> 00:16:47,310
لهذا القُدماء وجماعة عين العاصفة
...الّذين أعرفهم عادوا، لكن

117
00:16:47,310 --> 00:16:50,370
لم يعُد أيّ شخص آخر

118
00:16:50,370 --> 00:16:54,320
كيف نستطيع إعادة الجميع
في مدينة كاميتسوباكي إذاً؟

119
00:16:54,590 --> 00:16:57,860
يجب علينا العودة إلى النّاس الّذين هنا الآن

120
00:16:57,860 --> 00:17:00,580
ونطلب منهم أن يخبرونا عن الأشخاص
الّذين يهتمّون لأمرهم

121
00:17:00,580 --> 00:17:04,960
وإذا غنّينا أثناء التّفكير
...في أولئك النّاس

122
00:17:04,960 --> 00:17:06,080
أجل

123
00:17:06,380 --> 00:17:07,670
!سيعودون جميعاً

124
00:17:09,060 --> 00:17:10,840
...والشّيء الوحيد الّذي يستطيع فعل ذلك هو

125
00:17:11,100 --> 00:17:16,300
أجل، أغنيتنا نحن، الماجو نو موسومي

126
00:17:16,870 --> 00:17:19,120
قد تكون الفكرة غير واقعيّة بالطّبع

127
00:17:19,120 --> 00:17:22,290
!لا... أعلم بأنّنا نستطيع فعلها

128
00:17:22,290 --> 00:17:23,100
!لنُجرّب

129
00:17:23,420 --> 00:17:24,980
مهلاً لحظة

130
00:17:25,260 --> 00:17:28,810
ليس وكأنّنا نستطيع التكلُّم
مع الجميع في المدينة

131
00:17:28,810 --> 00:17:29,730
!لنُجرّبها

132
00:17:29,730 --> 00:17:30,340
!أجل

133
00:17:30,340 --> 00:17:32,440
ستأتي أيضاً، أليس كذلك يا كوغيل؟

134
00:17:32,440 --> 00:17:34,280
سأفعل ما تريدين يا كوكو

135
00:17:34,280 --> 00:17:35,170
!أجل

136
00:17:35,170 --> 00:17:36,200
أنيموس؟

137
00:17:36,570 --> 00:17:38,360
أنا تحت أمرك

138
00:17:45,850 --> 00:17:47,240
!هذا رائع

139
00:17:47,240 --> 00:17:51,140
وإضافة المزيد من الأمل ينبغي أن يُبقي
!إنجاب التّيسّيراكتور بمُعدّلات مُنخفضة

140
00:17:51,140 --> 00:17:53,840
...نحن كائنات افتراضيّة أيضاً

141
00:17:53,840 --> 00:17:58,010
لكن هذا سبب للافتراض بأنّ
المُعجزات قد تكون مُمكنة هنا

142
00:18:02,850 --> 00:18:03,820
!لنُغنِّ

143
00:23:19,160 --> 00:23:22,040
ابتداء من الآن، سأغيّر عالم الغد