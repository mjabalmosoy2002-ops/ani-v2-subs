1
00:02:08,710 --> 00:02:12,210
أتعتقدون بأنّ مسألة الحاجز هذه
برمّتها هي مُجرّد احتيال؟

2
00:02:12,210 --> 00:02:14,380
تصدّينا للخطر حاليّاً

3
00:02:14,380 --> 00:02:16,690
انسوا ذلك! لماذا يحتاج حياة بشريّ؟

4
00:02:19,910 --> 00:02:21,460
...ما الّذي

5
00:02:21,460 --> 00:02:23,080
ألم تكن هناك طريقة أُخرى؟

6
00:02:23,400 --> 00:02:26,910
...أجل، طريقة أُخرى يمكننا القيام بها

7
00:02:28,730 --> 00:02:33,860
هذا هو الشّيء الوحيد الّذي كان يُحافظ
على سلامة مدينة كاميتسوباكي من التّيسّيراكتور

8
00:02:33,860 --> 00:02:35,590
هذا كلّ ما يمكنني إخباركم به

9
00:02:35,980 --> 00:02:37,090
"الشّيء الوحيد؟"

10
00:02:37,440 --> 00:02:42,300
كانت "فاليس" تُغذّى بواسطة أرواح
السّاحرات المُحتمَلات" في السّنوات السّبع الماضية"

11
00:02:42,580 --> 00:02:45,260
...هذا هو سبب التّضحية بها

12
00:02:45,580 --> 00:02:49,790
تستمدّ "فاليس" اسمها من
هذه السّاحرات المُحتمَلات

13
00:02:49,790 --> 00:02:52,190
اللّواتي يهِبنَ حياتهن لحماية
لمدينة كاميتسوباكي

14
00:02:59,580 --> 00:03:00,400
هكذا إذاً

15
00:03:01,830 --> 00:03:06,550
لم تستطع السّاحرة السّابقة إنقاذ النّاس

16
00:03:07,250 --> 00:03:09,780
،عندما يدلي مُواطن بصوته

17
00:03:09,780 --> 00:03:12,920
فإنّ فرع إعادة الإعمار يُقيّم تاريخه وإمكانيّاته

18
00:03:13,220 --> 00:03:15,420
إذاً تمّ اختيارها منذ البداية؟

19
00:03:15,420 --> 00:03:16,600
أجل

20
00:03:16,600 --> 00:03:22,220
"ما يفصل بين ماجو نو موسومي و"مُحتمَلة
هو أغنية التّطهير

21
00:03:23,000 --> 00:03:26,020
الطّريقة الوحيدة لتطهير المناطق
المُعقّدة والتّيسّيراكتور

22
00:03:26,020 --> 00:03:29,680
هي غناء أغنية التّطهير بواسطتكن
أنتن الماجو نو موسومي

23
00:03:30,490 --> 00:03:35,150
طاقة المعلومات في أغنية التّطهير
هي بتلك الإمكانيّة

24
00:03:35,790 --> 00:03:40,670
تمتلك السّاحرات المُحتمَلات أيضاً كثافة
المعلومات المطلوبة لأداء الأُغنية

25
00:03:40,670 --> 00:03:44,240
لكن، لا أحد منهن بقادرات على غنائها

26
00:03:44,240 --> 00:03:45,460
—هذا ليس سبباً

27
00:03:45,460 --> 00:03:49,610
الماجو نو موسومي جزء أساسيّ
من دفاعات مدينة كاميتسوباكي

28
00:03:51,500 --> 00:03:54,620
لا يمكننا خسارة أي منكن

29
00:03:54,620 --> 00:03:58,420
حمايتكن إلزاميّة لسلامة الجميع

30
00:03:59,230 --> 00:04:03,550
أنا السّبب وراء موت ماكانا

31
00:04:03,870 --> 00:04:06,600
بالطّبع، قدرتهن على الاختيار
بحرّية هي العظمى

32
00:04:07,410 --> 00:04:14,300
الحاجز لا يتجلّى إلّا إذا كان لدى المُحتمَلة
رغبة راسخة في الحماية

33
00:04:15,180 --> 00:04:18,730
أردنا حمايتها، لكنّها حمتنا

34
00:04:27,270 --> 00:04:29,720
لقد تمّ رصد منطقة مُعقّدة

35
00:04:29,720 --> 00:04:31,590
على حدود المنطقة 2

36
00:04:31,590 --> 00:04:32,330
!هاستار

37
00:04:32,330 --> 00:04:33,150
!ريمي

38
00:04:33,460 --> 00:04:34,560
سأذهب

39
00:04:34,560 --> 00:04:36,260
إنّه الشّيء الوحيد الّذي أستطيع
فعله على أيّ حال

40
00:04:36,260 --> 00:04:37,180
!ريمي

41
00:04:53,540 --> 00:04:56,390
بالرّغم من حجمه، لم يكن صعباً إطلاقاً

42
00:04:58,410 --> 00:04:59,270
ما الأمر؟

43
00:05:01,140 --> 00:05:04,240
من الصّعب حماية النّاس، أليس كذلك؟

44
00:05:04,240 --> 00:05:07,210
البشر ضُعفاء أمامنا، أليسوا كذلك؟

45
00:05:07,210 --> 00:05:09,030
ليس هذا ما قصدت

46
00:05:10,760 --> 00:05:13,330
...ذكّرني هذا بذلك الوقت

47
00:05:18,690 --> 00:05:19,940
أمّي

48
00:05:20,890 --> 00:05:22,030
أبي

49
00:05:23,510 --> 00:05:26,220
كان أبي عالماً فيزيائيّاً مُعاصراً

50
00:05:26,220 --> 00:05:28,220
،نجح في استخراج الفراغمينت

51
00:05:28,220 --> 00:05:32,100
مصدر طاقة جديد، من المعلومات الفكريّة للبشر

52
00:05:32,550 --> 00:05:36,270
أعادتْ مدينة كاميتسوباكي بناء نفسها
بفضل الفراغمينت

53
00:05:37,100 --> 00:05:41,530
جلبَ الإضاءة إلى المدينة وسمح لنا
برزاعة طعامنا الخاص

54
00:05:41,530 --> 00:05:44,350
دعمَنا ذلك في كافّة أوجه الحياة

55
00:05:44,350 --> 00:05:45,610
إنّه يُحافظ على سلامتنا

56
00:05:46,170 --> 00:05:50,070
هذا ما قاله أبي لحماية مدينة كاميتسوباكي

57
00:05:50,370 --> 00:05:52,790
...ظلّ يكدح ويكدح

58
00:05:56,540 --> 00:05:59,120
لكن لم يكن ذلك كافياً في النّهاية

59
00:06:08,760 --> 00:06:10,730
لم يكن بيدي حيلة

60
00:06:24,970 --> 00:06:27,700
—لديك رغبة واحدة فقط

61
00:06:27,700 --> 00:06:33,100
لحماية ابنتك العزيزة، ولو كلّف ذلك
التحوّل إلى وحش مثلنا

62
00:06:33,870 --> 00:06:36,580
!حتّى لو مات الآخرون بسبب ذلك

63
00:06:49,530 --> 00:06:51,500
أصبح تيسّيراكتور في النّهاية

64
00:06:55,890 --> 00:06:56,900
كافو

65
00:06:57,860 --> 00:07:00,330
أرجوك، أطلقي سراح أبي

66
00:07:17,570 --> 00:07:20,280
أبي! أنا آسفة

67
00:07:20,820 --> 00:07:22,790
...لطالما حاولتَ حمايتي

68
00:07:23,690 --> 00:07:28,150
لا تحتاجينني لأحميكِ بعد الآن

69
00:07:28,150 --> 00:07:31,910
لديك القوّة للعيش بمفردك

70
00:08:21,130 --> 00:08:25,880
لا أعلم بأنّ الفراغمينت الّتي اخترعها
أبي كانت تُضحّي بالنّاس

71
00:08:25,880 --> 00:08:27,630
أتساءل إن فعل ذلك

72
00:08:43,070 --> 00:08:45,500
كان بوسعك الذّهاب إلى المنزل من دوني

73
00:08:46,490 --> 00:08:49,740
لا أحبّ التّواجد هناك وحيدة

74
00:08:53,270 --> 00:08:55,260
ما الّذي كنتِ تُفكّرين فيه؟

75
00:08:57,940 --> 00:09:02,700
أحياناً أتساءل ما إن كان قضاء المزيد
من الوقت مع أبي سيُغيّر شيئاً

76
00:09:04,570 --> 00:09:08,180
لم أحاول حقّاً معرفة ما كان يمرّ به

77
00:09:08,870 --> 00:09:13,990
تكتّم على كلّ شيء لمدّة طويلة
مُراعياً مشاعري

78
00:09:16,040 --> 00:09:19,200
أنا متأكّدة لأنّ السّبب هو أنّه
لم يكن بمقدوره فعل شيء

79
00:09:19,560 --> 00:09:22,640
رئيسة فرع إعادة الإعمار هي كذلك أيضاً

80
00:09:22,640 --> 00:09:25,320
والأشياء المُتعلّقة بالحاجز هي
غالباً نفس الأمر

81
00:09:27,530 --> 00:09:29,650
ليتهم يخبروننا

82
00:09:29,650 --> 00:09:32,700
لو كنتُ أعلم بأنّ شخصاً كان يحاول
،أن يهب حياته لحمايتي

83
00:09:32,700 --> 00:09:34,590
لكنتُ جاهزة للتدخُّل بنفسي

84
00:09:35,370 --> 00:09:39,550
من سيحمي النّاس من التّيسّيراكتور إذا متنا؟

85
00:09:39,950 --> 00:09:41,440
...في الواقع

86
00:09:41,440 --> 00:09:43,050
هذا واضح الآن

87
00:09:44,030 --> 00:09:49,370
فعل أبي كلّ ما يمكنه فعله
لحماية مدينة كاميتسوباكي

88
00:09:49,370 --> 00:09:51,480
رئيسة فرع إعادة الإعمار هي كذلك أيضاً

89
00:09:51,480 --> 00:09:54,780
هذا يعني بأنّهم يرون النّاس
من منظور الأعداد والأدوار

90
00:09:55,270 --> 00:09:58,190
...لكن من أجل فعل كلّ ما يمكنك فعله حقّاً

91
00:09:58,860 --> 00:10:00,630
مثل هذا الأمر حتميّ

92
00:10:05,510 --> 00:10:07,300
إنّه ليس حتميّاً

93
00:10:08,620 --> 00:10:10,950
لا أستطيع تجاهل الأمر فحسب

94
00:10:12,350 --> 00:10:14,360
!إ-إلى أين أنتِ ذاهبة؟ كافو

95
00:10:24,280 --> 00:10:26,220
ما الأمر؟

96
00:10:26,590 --> 00:10:28,730
لماذا يقع كلّ هذا على عاتقنا؟

97
00:10:28,730 --> 00:10:31,280
لا أفهم سؤالكِ

98
00:10:31,280 --> 00:10:33,860
!أنتِ تُخفين الكثير من الأمور

99
00:10:33,860 --> 00:10:37,280
سأكشف المعلومات عندما يتطلّب الأمر

100
00:10:37,280 --> 00:10:40,810
تفاصيل الحاجز ووجود التّيسّيراكتور

101
00:10:40,810 --> 00:10:43,580
سرّيان لمنع مزيد إصابة المزيد
من النّسل باليأس

102
00:10:43,580 --> 00:10:46,280
عند حماية الآخرين، بعض الأسرار ضروريّة

103
00:10:46,280 --> 00:10:47,670
!ليس هذا ما أعنيه

104
00:10:48,750 --> 00:10:52,570
،لو كان هناك ماجو نو موسومي أكثر
لاستطعنا إنقاذ مزيد من النّاس

105
00:10:52,570 --> 00:10:56,800
إن وُجِدَتْ "مُحتمَلات"، ألا ينبغي أن
أن يكون هناك ماجو نو موسومي أكثر أيضاً؟

106
00:10:57,120 --> 00:10:59,220
لماذا يقع هذا على عاتقنا جميعاً؟

107
00:10:59,810 --> 00:11:01,470
لا أعلم

108
00:11:01,470 --> 00:11:03,660
البيانات حاليّاً قيد المُراجعة

109
00:11:04,270 --> 00:11:10,770
حقيقة أنّكن أنتن الخمسة أصبحتُن
ماجو نو موسومي بتخميني

110
00:11:10,770 --> 00:11:12,410
هي مُعجزة بحدّ ذاتها

111
00:11:12,840 --> 00:11:16,640
!أنتن الأمل بالّنسبة لهذه المدينة

112
00:11:17,320 --> 00:11:21,860
تعاونت رئيسة القسم تانيوكي
مع فرع إعادة الإعمار لسبع سنوات

113
00:11:21,860 --> 00:11:25,370
واكتشفت أفضل وسيلة لمُحاربة التّيسّيراكتور

114
00:11:25,850 --> 00:11:31,580
طريقة غير مُثبَتة تحدُّ بالرّغم من ذلك
من الضّرر ولا تتطلّب مزيداً من الاختبارات

115
00:11:33,790 --> 00:11:35,040
...لكن

116
00:11:37,910 --> 00:11:40,570
ليتك تفهمين مشاعر البشر

117
00:11:41,010 --> 00:11:44,910
لا يمكننا التّعامل مع موت النّاس
كأمر حتميّ

118
00:11:58,380 --> 00:11:59,140
تفضّلي

119
00:11:59,140 --> 00:12:00,150
أنتِ أوّلاً

120
00:12:02,120 --> 00:12:03,740
حسناً، أنا أوّلاً إذاً

121
00:12:17,480 --> 00:12:19,660
كافو، لديكِ أخت صغرى؟

122
00:12:19,660 --> 00:12:21,010
!لا، ليس لديّ

123
00:12:21,010 --> 00:12:21,760
جسناً

124
00:12:22,060 --> 00:12:23,480
إنّها أنا

125
00:12:23,480 --> 00:12:24,470
من؟

126
00:12:24,470 --> 00:12:26,090
إنّها رئيسة فرع إعادة الإعمار

127
00:12:26,850 --> 00:12:28,680
!رئيسة فرع إعادة الإعمار؟

128
00:12:28,680 --> 00:12:29,430
!أجل

129
00:12:29,430 --> 00:12:31,070
أخفتِنا بصراحة

130
00:12:31,070 --> 00:12:32,340
أستميحكما عذراً

131
00:12:32,340 --> 00:12:33,800
كيف دخلتِ إلى هنا؟

132
00:12:33,800 --> 00:12:34,980
هل داهمتِ المكان؟

133
00:12:34,980 --> 00:12:37,340
،وقفتُ عند الباب مُنتظرة عودتكما

134
00:12:37,340 --> 00:12:40,780
فأخطأ المُفوّض بيني وبين الآنسة كافو

135
00:12:40,780 --> 00:12:42,420
كذبتِ للدّخول إذاً؟

136
00:12:42,420 --> 00:12:44,380
تمّ السّماح لي بالدّخول

137
00:12:45,780 --> 00:12:47,680
إنّ الوقوف هكذا مُربِك جدّاً

138
00:12:47,680 --> 00:12:49,050
—أحضرتُ لكما هديـ

139
00:12:50,420 --> 00:12:51,910
شكراً لكِ

140
00:12:55,930 --> 00:12:58,380
!هذه الياكيتوري رائعة

141
00:13:01,090 --> 00:13:03,610
أخبرتني الآنسة كوكو أنّه من الضّروريّ

142
00:13:03,610 --> 00:13:08,130
إحضار طعام عند زيارة منزل شخص آخر

143
00:13:08,130 --> 00:13:11,970
أظهرتْ لي البيانات بأنّ هذا الطّعام
—مطلوب جدّاً، رغم أنّني عندما جرّبتُه

144
00:13:13,530 --> 00:13:14,980
أكلتِها؟

145
00:13:16,140 --> 00:13:19,200
شعرتُ بألم مُبرح في صدري

146
00:13:19,200 --> 00:13:21,140
لعلّ الرّائحة كانت السّبب

147
00:13:21,140 --> 00:13:24,860
أجل، أعتقد هذا يُدعى بـ... أكل
... لحم نفس فصيلتك

148
00:13:24,860 --> 00:13:28,750
أعتقد بأنّني لا أحبّ الياكيتوري

149
00:13:28,750 --> 00:13:34,980
تكلّمتُ مع بقيّتكن حول أمر
لم أكن أعرف عنه شيئاً

150
00:13:34,980 --> 00:13:37,250
من الطّبيعيّ أن تكرهني الآنسة كافو

151
00:13:39,330 --> 00:13:44,860
لكن كحاسوب حيّ، واجهتُ صعوبة
في فهم ذلك الاستنتاج

152
00:13:44,860 --> 00:13:47,760
إذاً استمعتِ... إلى قلبك؟

153
00:13:48,030 --> 00:13:49,240
|أجل

154
00:13:49,240 --> 00:13:51,130
حينئذ خطرة على ذهني فكرة

155
00:13:51,130 --> 00:13:55,770
إذا اتّخذتُ هيئة بشريّة، فقد أستطيع
التحقُّق بشكل أفضل

156
00:13:56,030 --> 00:14:00,530
لحسن الحظّ، التعرُّض المُكرَّر لأغنيتكن

157
00:14:00,530 --> 00:14:03,730
منحَتْني القدرة على اتّخاذ شكل بشريّ

158
00:14:04,680 --> 00:14:07,150
لماذا تبدين مثلي؟

159
00:14:07,150 --> 00:14:14,240
ربّما لأنّكِ أكثر شخص أثّر
على طريقة تفكيري

160
00:14:19,030 --> 00:14:22,790
،رغم أنّني ما زلتُ عديمة الخبرة
آمل أن تساعداني

161
00:14:30,150 --> 00:14:34,010
أهذا ما قصدتِه بمُساعدتكِ؟

162
00:14:34,010 --> 00:14:35,720
هل وجودي يُزعجكما؟

163
00:14:35,720 --> 00:14:38,300
،أشكرك على المُساعدة

164
00:14:38,300 --> 00:14:40,110
لكن أنا مُتفاجئة من عرفتك بأنّني هنا

165
00:14:40,110 --> 00:14:42,690
تلميذ اعتقدني أنتِ بالخطأ

166
00:14:42,690 --> 00:14:45,440
شكرني على تنظيف المسبح لهم

167
00:14:45,440 --> 00:14:46,970
...فعلتُ ذلك لأنّني

168
00:14:47,610 --> 00:14:50,040
،كنتُ مُكلّفة بمهام كثيرة مؤخّراً

169
00:14:50,040 --> 00:14:52,510
وسمحوا لي باستعارة دفتر مُلاحظاتهم
أكثر من مرّة

170
00:14:52,510 --> 00:14:53,820
هكذا إذاً

171
00:14:53,820 --> 00:14:57,280
تكلّم معي عددٌ من النّاس في طريقي إلى هنا

172
00:14:57,280 --> 00:14:59,920
هـ-هل قلتِ أيّ كلام غريب؟

173
00:14:59,920 --> 00:15:02,680
فهمتُ الآن سبب احترامهم لكِ في المدرسة

174
00:15:02,680 --> 00:15:04,260
لستُ أدري ما إن كان يروقني هذا

175
00:15:04,260 --> 00:15:06,550
!لابلاس، المزيد من الماء

176
00:15:09,320 --> 00:15:11,430
الطّلبات لا تنتهي أبداً

177
00:15:24,520 --> 00:15:25,740
!أوقفه

178
00:15:25,740 --> 00:15:27,400
!لابلاس، الماء

179
00:15:30,990 --> 00:15:32,160
آنسة كافو؟

180
00:15:48,030 --> 00:15:51,550
لا أريد أن أخسر أحداً آخر

181
00:15:52,110 --> 00:15:57,040
آمل حماية جميع سكّان مدينة كاميتسوباكي

182
00:15:59,950 --> 00:16:01,100
هكذا إذاً

183
00:16:05,030 --> 00:16:06,250
نحن مُتشابهتان

184
00:16:08,190 --> 00:16:12,990
لسنا على وفاق، لكن لدينا نفس الهدف

185
00:16:14,460 --> 00:16:19,080
طلبتُ منكِ فهم مشاعرنا، لكن
لم أحاول فهم مشاعركِ

186
00:16:20,330 --> 00:16:23,500
دعيني أشارك مزيداً من خبراتنا

187
00:16:24,140 --> 00:16:30,260
،يمكن أن تكون مشاعر النّاس مُعقّدة
وسأحاول تعلُّم التّعبير عن مشاعري بشكل أفضل

188
00:16:43,850 --> 00:16:47,520
سمعتُ بأنّ رئيسة فرع إعادة الإعمار
تتجوّل بهيئة كافو

189
00:16:47,520 --> 00:16:49,230
ما الّذي تُفكّر فيه؟

190
00:16:49,230 --> 00:16:51,360
إن أردتِ المعرفة، فلِمَ لا تسألين؟

191
00:16:51,360 --> 00:16:53,610
أعتقد فقط بأنّ تلك ستكون مُشكلة

192
00:16:53,940 --> 00:16:56,270
العالم غير منطقيّ

193
00:16:56,270 --> 00:16:59,240
يتطلّب حمايته طرُقاً غير عقلانيّة

194
00:17:07,430 --> 00:17:09,770
ماكانا هو ما كنتُ عليه

195
00:17:09,770 --> 00:17:13,260
لو بقيتُ مع الكنيسة، لفعلتُ الشّيء ذاته

196
00:17:13,260 --> 00:17:17,890
قراري بالعيش قليلاً هو سبب
عدم قدرتي على فعلها

197
00:17:18,610 --> 00:17:22,080
يجب التّضحية ببعض الأشياء
من أجل البقاء

198
00:17:22,080 --> 00:17:24,700
أنا مثل رئيسة فرع إعادة الإعمار

199
00:17:24,700 --> 00:17:25,730
هل أُسبّب مُشكلة؟

200
00:17:25,730 --> 00:17:26,820
—المُشكلة هي

201
00:17:31,560 --> 00:17:32,720
—المُشكلة هي

202
00:17:33,790 --> 00:17:36,610
أنا ضعيفة جدّاً لدرجة أنّ كلّ
ما يمكنني فعله هو الشّكوى

203
00:17:41,280 --> 00:17:44,700
مستوى خطر التّيسّيراكتور قد عاد
إلى طبيعته

204
00:17:44,700 --> 00:17:48,780
ستُغلَق المنطقة 3 حاليّاً لمنع
وقوع كارثة ثانويّة

205
00:17:48,780 --> 00:17:50,250
أخيراً

206
00:17:50,250 --> 00:17:54,210
حسناً، فكرة فرع إعادة الإعمار عن
المستوى الطّبيعيّ" لا تعني الكثير"

207
00:17:55,140 --> 00:17:57,300
،إذا حدث شيء كهذا ثانية

208
00:17:57,300 --> 00:18:00,360
فماذا سأفعل يا كوغيل؟

209
00:18:02,820 --> 00:18:04,970
سأفعل ما أتمنّاه

210
00:18:05,370 --> 00:18:07,730
أجل، هذا منطقيّ بالنّسبة لك

211
00:18:10,580 --> 00:18:13,940
آمل ألّا تسألي سبب امتلاكي
جواباً بالفعل

212
00:18:15,050 --> 00:18:18,480
فعلتِ ما تمنّيتِه في المرّة الماضية كذلك

213
00:18:18,480 --> 00:18:19,740
هذا صحيح

214
00:18:20,650 --> 00:18:22,410
...في المرّة المُقبلة، أنا

215
00:18:24,260 --> 00:18:25,300
المرّة المُقبلة؟

216
00:18:32,220 --> 00:18:32,920
ماذا؟

217
00:18:33,350 --> 00:18:34,420
أين رئيسة فرع إعادة الإعمار؟

218
00:18:34,420 --> 00:18:35,640
تُعدّ الشّاي

219
00:18:35,640 --> 00:18:36,250
!مستحيل

220
00:18:36,250 --> 00:18:38,190
تفاجأ الطّاقم أيضاً

221
00:18:38,190 --> 00:18:39,290
!هذا لا يُصدَّق

222
00:18:39,290 --> 00:18:40,530
آمل أن يكون شاياً أسود

223
00:18:40,530 --> 00:18:43,490
سمعتُ بأنّ شاي المكتب العامّ
هو أخضر دوماً

224
00:18:43,490 --> 00:18:44,410
حقّاً؟

225
00:18:44,410 --> 00:18:50,020
أكياس شاي أخضر اقتصاديّة
!تكلّف 1385 ين لكلّ كيلو

226
00:18:50,020 --> 00:18:51,770
ماذا حدث لرئيسة فرع إعادة الإعمار؟

227
00:18:51,770 --> 00:18:54,810
إنّها غريبة أطوار مثلي

228
00:18:54,810 --> 00:18:57,740
إنّه شيء تعلّمتُه بقضاء الوقت معها

229
00:18:57,740 --> 00:18:59,150
هل أنتِ جادّة

230
00:18:59,150 --> 00:19:01,710
لكن هذا لا يعني أنّ علينا قبولها

231
00:19:01,710 --> 00:19:06,370
لكن من خلال مُراقبتها، من الواضح أنّها
تحاول فهم مشاعر البشر

232
00:19:06,760 --> 00:19:09,390
،رئيسة فرع إعادة الإعمار هي حاسوب حيّ

233
00:19:09,390 --> 00:19:12,540
لكنّها تُحبّ مدينة كاميتسوباكي
وتريد حماية شعبها

234
00:19:13,060 --> 00:19:15,870
إنّها مثلنا من هذه النّاحية

235
00:19:23,190 --> 00:19:24,510
إنّه جاهز

236
00:19:25,180 --> 00:19:27,630
لم أعلم بأنّ الشّاي ثقيل هكذا

237
00:19:27,630 --> 00:19:29,680
!تبدو هذه الأكواب كبيرة قليلاً

238
00:19:29,680 --> 00:19:31,890
كان هذا كلّ ما احتواه المطبخ

239
00:19:31,890 --> 00:19:33,310
أخشى أن تدلقي شيئاً

240
00:19:33,310 --> 00:19:35,210
يبدو هذا غير مُرجَّح نظريّاً

241
00:19:35,210 --> 00:19:36,800
تُشبهين كافو حتّى

242
00:19:36,800 --> 00:19:38,540
...هـ-هناك سبب وراء ذلك

243
00:19:38,540 --> 00:19:40,280
لماذا وجهكِ أحمر يا كافو؟

244
00:19:40,280 --> 00:19:41,840
...في الواقع

245
00:19:41,840 --> 00:19:43,230
رئيسة فرع إعادة الإعمار

246
00:19:43,740 --> 00:19:46,110
هناك شيء تريدين أن تخبرينا عنه، صحيح؟

247
00:19:52,150 --> 00:19:54,960
أطلب منكم الغفران في ذلك اليوم

248
00:19:57,180 --> 00:20:02,720
بصراحة، ما زلتُ أؤمن بأنّ قراري
في ذلك الظّرف كان صحيحاً

249
00:20:03,910 --> 00:20:04,910
...لكن

250
00:20:05,900 --> 00:20:11,770
أعدتُ تشغيل المُحاكاة، وأعطيتُ
،الأولويّة للعواطف البشريّة

251
00:20:12,220 --> 00:20:15,380
وثَبُتَ أنّه من الصّعب اتّخاذ
القرار الصّحيح

252
00:20:15,910 --> 00:20:19,210
أعتقد هذا هو الشّعور الّذي كان
يراودكم آنذاك

253
00:20:19,980 --> 00:20:22,740
إذاً تفهمين أنّنا أحياناً لا نستطيع
وضع الأمور جانباً؟

254
00:20:23,210 --> 00:20:28,340
...راودني شعور هنا في صدري
شيء من عدم الرّاحة

255
00:20:29,610 --> 00:20:31,120
أنا أشعر بذلك أيضاً

256
00:20:31,120 --> 00:20:34,040
شعرتُ بالقلق لأنّكِ لم تفهمينا

257
00:20:34,450 --> 00:20:36,170
أطلب منكم الغفران

258
00:20:40,450 --> 00:20:41,930
أعتقد بأنّ هذا يكفي

259
00:20:43,260 --> 00:20:44,850
لا أحد منّا معصوم

260
00:20:44,850 --> 00:20:47,050
لندعم بعضنا الآخر فحسب

261
00:20:48,280 --> 00:20:50,600
أجل، ليس وكأنّه يحقّ لي الكلام

262
00:20:52,680 --> 00:20:54,580
هل هذه مُصالحة؟

263
00:20:54,580 --> 00:20:56,600
شيء من هذا القبيل على ما أعتقد

264
00:20:58,240 --> 00:21:01,550
في هذه الحالة، لنتصافح كما يفعل البشر

265
00:21:04,500 --> 00:21:05,310
!حسناً

266
00:21:26,510 --> 00:21:27,390
!كافو

267
00:21:39,980 --> 00:21:42,190
!كافو! كافو

268
00:21:44,570 --> 00:21:45,650
!كافو

269
00:21:53,290 --> 00:21:54,460
!كافو