1
00:00:15,270 --> 00:00:17,270
سرعان ما وجدتُ نفسي أغنّي

2
00:00:19,240 --> 00:00:22,150
كانت أُغنيتي تُعزَف في كلّ أنحاء المدينة

3
00:00:24,790 --> 00:00:28,730
عندما أغنّي، يمكنني أن أكون نفسي

4
00:00:29,220 --> 00:00:32,520
لكن لماذا أُغنّي؟

5
00:00:33,350 --> 00:00:34,470
أين الجميع؟

6
00:00:54,460 --> 00:00:57,410
!أيّها النّاس! اليوم هو مهرجان كاميتسوباكي

7
00:00:57,750 --> 00:01:02,000
،سواء كنتم هناك أو تُشاهدوننا عبر الإنترنت
!لنبذل قصارى جهدنا

8
00:01:02,540 --> 00:01:04,900
!أنا حقّاً لا أطيق الانتظار

9
00:01:05,760 --> 00:01:09,050
الافتراضيّ والأصليّ... الحقيقيّ الاصطناعيّ

10
00:02:40,490 --> 00:02:42,700
!لنبذل قصارى جهدنا

11
00:02:43,450 --> 00:02:45,910
!أنا حقّاً لا أطيق الانتظار

12
00:02:46,630 --> 00:02:49,900
الافتراضيّ والأصليّ... الحقيقيّ الاصطناعيّ

13
00:03:25,650 --> 00:03:27,050
كم مضى على هذا من وقت؟

14
00:03:27,970 --> 00:03:32,270
...أرى نفسي على الهواتف في أيدي الجميع

15
00:03:32,810 --> 00:03:33,850
ما ذلك المكان؟

16
00:03:35,290 --> 00:03:36,490
ما هذا؟

17
00:03:37,870 --> 00:03:41,790
وأنا... هل أنا هنا؟

18
00:03:42,730 --> 00:03:45,980
كلّما غنّيتُ، شعرتُ بخطأ ما أكثر فأكثر

19
00:03:47,150 --> 00:03:48,180
هذا المنظر

20
00:03:48,990 --> 00:03:51,230
،أعلم بأنّني هنا

21
00:03:51,230 --> 00:03:55,100
ومع ذلك أتذكّر مشاهد مدينة مختلفة

22
00:03:55,580 --> 00:03:58,660
مدينة حيث ننظر للأعلى وتكون
السّماء غائمة دوماً

23
00:03:59,540 --> 00:04:04,190
هنا، السّماء زرقاء دوما، ويمكن رؤية البعيد

24
00:04:05,170 --> 00:04:09,210
،لم أرَ ذلك المكان الآخر أبداً
فلماذا أتذكّره؟

25
00:04:10,850 --> 00:04:13,600
تلك الأغنية. أغنيتي

26
00:04:14,280 --> 00:04:16,310
نسخة منّي لا أعرفها

27
00:04:18,860 --> 00:04:23,570
أصوات غير مألوفة أعرفها جيّداً

28
00:04:24,270 --> 00:04:27,850
أراقبها كلّها من بعيد

29
00:04:29,050 --> 00:04:30,060
...ومع ذلك

30
00:04:35,340 --> 00:04:38,920
دفء. الشّعور باليد في اليد

31
00:04:43,000 --> 00:04:45,350
صافرة تصرخ إليّ كي أهرب

32
00:04:49,370 --> 00:04:52,980
عندما أكون بمفردي، أتوقّف عن الشُّعور باليقين

33
00:04:54,350 --> 00:04:56,380
من أنا؟

34
00:04:57,790 --> 00:05:01,140
أنا موجودة داخل كلمات شخص

35
00:05:01,770 --> 00:05:03,910
داخل سعادة شخص

36
00:05:04,190 --> 00:05:06,680
داخل دموع شخص

37
00:05:06,680 --> 00:05:11,330
أنا دائماً مع شخص... معهم جميعاً

38
00:05:11,330 --> 00:05:15,250
أغنّي لأكون نفسي

39
00:05:16,090 --> 00:05:18,830
بدأتُ أسمع أصوات النّاس وهم يُراقبون

40
00:05:19,620 --> 00:05:22,340
أغنيتي. مشاعر الجميع

41
00:05:22,700 --> 00:05:23,960
نتقرّب إلى بعضنا الآخر

42
00:05:24,840 --> 00:05:28,170
ومع ذلك لا أشعر بالحياة

43
00:05:29,790 --> 00:05:33,020
تبدو هذه الذّكريات اصطناعيّة

44
00:05:34,890 --> 00:05:36,440
المعلومات الّتي تتلقّاها عينايّ

45
00:05:37,070 --> 00:05:39,270
آثار حضوري هنا

46
00:05:39,270 --> 00:05:40,730
لا شيء منه يبدو حقيقيّاً

47
00:05:41,800 --> 00:05:44,230
أشعر بالعالم على نحو مُتقطِّع

48
00:05:44,980 --> 00:05:46,480
...لماذا إذاً

49
00:05:47,650 --> 00:05:52,730
كلّما فكّرتُ في الأمر، طافتْ هذه
المشاعر الغريبة أكثر

50
00:05:53,540 --> 00:05:56,870
،أبدأ بالشُّعور بعدم اتّزان
وكأنّني سأتعثّر بقدمَي

51
00:05:58,980 --> 00:06:02,160
أين أنا؟

52
00:06:25,380 --> 00:06:27,650
!مساء الخير جميعاً

53
00:06:27,960 --> 00:06:29,400
...واحد، اثنان

54
00:06:29,400 --> 00:06:32,380
!نحن في.دبليو.بي

55
00:06:36,360 --> 00:06:39,820
!بدايةً... أنا كاف

56
00:06:43,380 --> 00:06:46,560
!وأنا ريم

57
00:06:50,340 --> 00:06:52,680
!مرحباً بالجميع

58
00:06:52,680 --> 00:06:55,350
!لم يمض إلّا يوم، لكن مرحباً من جديد

59
00:06:55,620 --> 00:06:57,100
!أنا إيسيكايجوتشي

60
00:06:57,100 --> 00:07:00,380
!لنقضِ وقتاً مُمتعاً

61
00:07:06,780 --> 00:07:11,490
!والآن، التّالية... هاروساروهي

62
00:07:11,810 --> 00:07:14,100
!مساء الخير جميعاً

63
00:07:14,100 --> 00:07:16,290
!أنا هاروساروهي

64
00:07:16,290 --> 00:07:18,620
!أنا مُتوتّرة للغاية

65
00:07:18,620 --> 00:07:21,210
!نعلم

66
00:07:21,210 --> 00:07:23,720
!شكراً على القدوم

67
00:07:23,720 --> 00:07:25,670
...أخيراً وليس آخراً

68
00:07:25,670 --> 00:07:26,780
!مرحباً

69
00:07:27,770 --> 00:07:31,050
...أنا

70
00:07:31,050 --> 00:07:34,260
!كوكو

71
00:07:35,720 --> 00:07:37,250
...واحد، اثنان

72
00:07:37,250 --> 00:07:40,820
!نحن في.دبليو.بي

73
00:07:49,070 --> 00:07:53,800
مشهد سديمي، عقل مُتعطّش

74
00:07:53,800 --> 00:08:00,340
حتّى الرّنين في أُذنَي فارغ

75
00:08:00,340 --> 00:08:03,580
كلّما آلمني ذلك، تكرّر أكثر

76
00:08:03,580 --> 00:08:06,420
وازددتُ اعتقاداً بأنّني سأفقد رؤية ذلك

77
00:08:06,420 --> 00:08:11,800
قلبي يصيح في عالم غير مُجزٍ

78
00:08:12,740 --> 00:08:14,350
وكأنّني أغرق

79
00:08:12,770 --> 00:08:14,020
ما هذا المكان؟

80
00:08:14,350 --> 00:08:15,760
لا أستطيع حتّى التنفُّس الآن

81
00:08:15,760 --> 00:08:19,600
أهيم في متاهة، لا أستطيع تحمُّل ذلك

82
00:08:19,600 --> 00:08:23,260
لا أستطيع العيش فترة أطول

83
00:08:22,090 --> 00:08:23,640
...هذه الأغنية

84
00:08:23,260 --> 00:08:26,270
كلّما تمنّيتُ أكثر، قلَّ فهمي

85
00:08:26,270 --> 00:08:28,040
مُثُلي، وحدتي، حُبّي، وأحلامي

86
00:08:26,520 --> 00:08:27,930
مدينة كاميتسوباكي

87
00:08:28,040 --> 00:08:31,560
مُنجذبة نحو عالم غير نامٍ

88
00:08:29,080 --> 00:08:34,670
أنظر للأعلى لأرى سماء ساطعة تحبسنا

89
00:08:31,560 --> 00:08:35,690
،الرّغبة، كلّما اشتهيتُ أكثر
قلّ عدد مَن أُنقذهم

90
00:08:35,420 --> 00:08:36,880
كان لديّ فريق

91
00:08:35,690 --> 00:08:36,600
هذا قاسٍ

92
00:08:36,600 --> 00:08:40,240
أُمنيتي، أطلقي تعويذة الآن

93
00:08:37,140 --> 00:08:43,300
طهّرتْ أغنيتنا ما نبع من الخوف واليأس

94
00:08:42,450 --> 00:08:45,900
أواجه رغباتي الشّديدة، أعيش
حياتي الكئيبة

95
00:08:43,830 --> 00:08:47,680
نحن ماجو نو موسومي

96
00:08:45,900 --> 00:08:48,840
نشاط وحشيّ، يُشكّك الأعداء بعقلي

97
00:08:48,840 --> 00:08:51,260
لا أستطيع الإفلات من هذا القدر

98
00:08:49,170 --> 00:08:50,080
ريمي

99
00:08:50,770 --> 00:08:51,920
هارو

100
00:08:51,260 --> 00:08:53,200
مُستقبل يهيم تائهاً، في كلّ اتّجاه

101
00:08:52,590 --> 00:08:53,930
سيكاي

102
00:08:53,200 --> 00:08:55,980
وكأنّه لا يستطيع أحدٌ أن يفهم

103
00:08:54,460 --> 00:08:55,540
كوكو

104
00:08:55,980 --> 00:08:57,360
لا يستطيع أحدٌ حتّى أن يتنفّس

105
00:08:56,220 --> 00:09:03,370
لكن لطالما سُحِقَ الأول بواسطة
الظّلام الّذي يسقط من السّماء

106
00:08:57,360 --> 00:09:01,560
أهيم في متاهة، لا أستطيع تحمُّل ذلك

107
00:09:01,880 --> 00:09:03,860
أتشعر بأنّك لا تستطيع أن تُواصل حياتك؟

108
00:09:03,860 --> 00:09:08,730
انتكاسات، مخاوف، حُبّ وأحلام

109
00:09:04,420 --> 00:09:05,860
أردتُ العيش

110
00:09:06,950 --> 00:09:10,460
،لا أريد أن أعيش هذا الحزن من جديد

111
00:09:08,730 --> 00:09:10,280
لستُ أفهم

112
00:09:10,280 --> 00:09:13,940
مُنجذبة نحو عالم غير نامٍ

113
00:09:10,460 --> 00:09:12,300
لكن هذا لا ينتهي أبداً

114
00:09:13,940 --> 00:09:16,200
سمعتُ شخصاً يصيح

115
00:09:13,940 --> 00:09:18,010
،الرّغبة، كلّما اشتهيتُ أكثر
قلّ عدد مَن أُنقذهم

116
00:09:17,570 --> 00:09:18,720
"أريد أن أعيش"

117
00:09:18,010 --> 00:09:18,930
هذا مُؤلم

118
00:09:18,930 --> 00:09:25,820
دع شخصاً يسمع هذه الصّيحة

119
00:09:19,160 --> 00:09:24,120
لكن حتّى عندما صحتُ، لم يُجِبني أحد

120
00:09:25,070 --> 00:09:27,340
لذا أطلقتُ تعويذة على نفسي

121
00:09:28,710 --> 00:09:29,640
الأمل

122
00:09:30,490 --> 00:09:32,540
إنهاء ذلك كلّه

123
00:09:33,940 --> 00:09:35,650
عدم تكرار ذلك من جديد

124
00:09:34,590 --> 00:09:38,010
أما من أحد هناك؟

125
00:09:36,340 --> 00:09:38,390
تدمير كلّ شيء

126
00:09:38,010 --> 00:09:43,860
لا أستطيع الشّعور بشيء، حتّى الوحدة

127
00:09:38,840 --> 00:09:41,160
تدمير مدينة كاميتسوباكي

128
00:09:42,220 --> 00:09:46,500
تلك كانت أُمنيتي. ما أردتُه

129
00:09:43,860 --> 00:09:45,260
ستكون الأمور على ما يُرام الآن

130
00:09:45,260 --> 00:09:49,810
أطلق تعويذة على هذا العالم الفارغ

131
00:09:47,750 --> 00:09:49,410
لم يفلح ذلك

132
00:09:49,810 --> 00:09:53,480
أريد أن أعيش بما يكفي للقتال من أجل ذلك

133
00:09:53,480 --> 00:09:56,770
مُثُلي، وحدتي، حُبّي، وأحلامي

134
00:09:55,180 --> 00:09:56,630
أردتُ العيش

135
00:09:56,770 --> 00:10:00,660
أريد إيجادهم في هذا العالم

136
00:09:57,460 --> 00:09:59,630
،أردتُ العيش كثيراً لدرجة غنّيت

137
00:09:59,630 --> 00:10:01,870
...لكن لم أكمل الأُغنية

138
00:10:00,660 --> 00:10:01,870
والإمساك بأيديهم

139
00:10:01,870 --> 00:10:07,620
،الرّغبة، كلّما اشتهيتُ أكثر
أرشدَني النّورُ أكثر

140
00:10:04,780 --> 00:10:06,200
...لم أكن أغنّي بدافع الرّغبة

141
00:10:07,620 --> 00:10:13,760
يا أُمنيتي، جِدي الأمل

142
00:10:16,360 --> 00:10:19,980
!كنتُ أحاول الغناء لأجل الأمل

143
00:10:20,390 --> 00:10:22,920
!شكراً على الحضور

144
00:10:26,440 --> 00:10:28,180
"كانت تلك "رغبة

145
00:10:28,180 --> 00:10:30,600
هذه أوّل مرّة نؤدّيها على الهواء

146
00:10:31,380 --> 00:10:33,660
ما رأيكِ يا كاف؟

147
00:10:34,280 --> 00:10:38,720
أعتقد... مُذهل، نحن نابضات بالحياة

148
00:10:43,070 --> 00:10:44,270
أجل، نحن كذلك

149
00:10:45,130 --> 00:10:52,620
هذا يجعلني أفكّر كيف أنّنا لم نرَ
بعضنا الآخر منذ فترة طويلة

150
00:10:54,870 --> 00:10:59,180
الحفلات الموسيقيّة هي مكان حيث
تحصل على قوّة جديدة

151
00:10:59,180 --> 00:11:05,860
أعتقد جميعكم ستتمكّنون من إحضار
الكثير من الذّكريات إلى المنزل

152
00:11:05,860 --> 00:11:10,500
الكثير من المشاعر أيضاً

153
00:11:11,570 --> 00:11:17,010
!على أيّ حال، لنكمل ونغنّ أغنيتنا التّالية

154
00:11:17,010 --> 00:11:17,710
!لنفعلها

155
00:11:17,710 --> 00:11:18,790
!هيّا بنا

156
00:11:19,870 --> 00:11:23,550
التّالية هي أغنية أنا متأكّدة
،بأنّكم ستعرفونها جميعاً

157
00:11:23,550 --> 00:11:26,870
...الأغنية المُميّزة من سنواتنا الأولى

158
00:11:26,870 --> 00:11:28,130
...واحد، اثنان

159
00:11:28,130 --> 00:11:29,180
!"دينّوه"

160
00:11:42,740 --> 00:11:45,400
!كلّ شيء ينهار

161
00:11:45,400 --> 00:11:53,530
تتغيّر الحقيقة دوماً لتكون ما أريده

162
00:11:54,310 --> 00:11:59,950
لستُ مُتيقّنة من شيء

163
00:11:59,950 --> 00:12:06,200
كلّ ذلك يبدو كلعِب بالدُّمى

164
00:12:07,100 --> 00:12:17,090
...عقل كمبيوتر معصوم يفهم الألم

165
00:12:29,710 --> 00:12:31,070
أين نحن؟

166
00:12:31,070 --> 00:12:32,480
ماذا حدث؟

167
00:12:32,480 --> 00:12:33,720
!برّاق جدّاً

168
00:12:35,480 --> 00:12:37,440
!هارو! عدت

169
00:12:38,360 --> 00:12:40,000
ماذا تقصدين؟

170
00:12:40,620 --> 00:12:42,980
!هارو! عدتِ إلى طبيعتكِ

171
00:12:43,780 --> 00:12:45,530
لدى كوكو ذراعيها أيضاً

172
00:12:45,810 --> 00:12:47,670
...من الطّبيعيّ أن تفعل

173
00:12:48,070 --> 00:12:49,620
ليس هذا ما أقصد

174
00:12:49,620 --> 00:12:51,030
ألا تتذكّرين؟

175
00:12:52,820 --> 00:12:54,370
يسرّني ذلك

176
00:12:56,220 --> 00:12:58,380
على أيّ حال، ما الّذي يجري هنا؟

177
00:12:59,060 --> 00:13:01,400
لستُ أدري تماماً

178
00:13:02,710 --> 00:13:05,980
أجل. ماذا حدث لنا؟

179
00:13:06,960 --> 00:13:09,390
هل هذه... فراغمينت؟

180
00:13:23,580 --> 00:13:27,880
تسرّني رؤيتكن أيّتها الماجو نو موسومي

181
00:13:28,760 --> 00:13:32,880
لحظة، هل أنتِ من أنقذنا؟

182
00:13:33,800 --> 00:13:36,620
هل أنتِ صوفيا، ساحرة الأصول؟

183
00:13:37,690 --> 00:13:38,430
أجل

184
00:13:39,200 --> 00:13:41,470
ساحرة الأصول؟

185
00:13:41,970 --> 00:13:44,010
الّتي تحدّث عنها ماكسويل؟

186
00:13:45,750 --> 00:13:47,930
،في كنيسة إيسيكاي الخلاص

187
00:13:47,930 --> 00:13:50,910
علّمونا بأنّها كانت إحدى المُؤسّسين

188
00:13:50,910 --> 00:13:52,110
...مستحيل

189
00:13:53,030 --> 00:13:54,450
هذا صحيح

190
00:13:54,450 --> 00:13:59,340
ساعدتُ في خلق عالم المنطق الأوّل

191
00:13:59,340 --> 00:14:02,870
ما هو عالم المنطق الأوّل؟

192
00:14:02,870 --> 00:14:04,670
أين نحن؟

193
00:14:05,790 --> 00:14:08,910
هذا ليس عالمكن

194
00:14:09,420 --> 00:14:12,780
إنّه عالمٌ مُوازٍ يُمثّل احتمالاً آخر

195
00:14:13,670 --> 00:14:17,120
،من أجل منح أُمنية ماجو نو موسومي

196
00:14:17,770 --> 00:14:20,290
،بينما كانت مدينة كاميتسوباكي على وشك الزّوال

197
00:14:20,290 --> 00:14:25,550
أعدتُكن إلى طاقة معلومات وأعدتُ
صناعتكن من جديد في هذا البُعد

198
00:14:28,470 --> 00:14:31,820
...مدينة كاميتسوباكي... الظّاهرة

199
00:14:31,820 --> 00:14:33,100
هل انتهى الأمر؟

200
00:14:33,730 --> 00:14:36,100
لم تقع الظّاهرة

201
00:14:37,380 --> 00:14:41,520
إذاً، هل نحن موتى؟ أم أحياء؟

202
00:14:42,030 --> 00:14:47,240
قد يكون من الأدقّ القول بأنّكن
موجودات كطاقة معلومات

203
00:14:48,020 --> 00:14:50,610
إذاً ماذا عن مدينة كاميتسوباكي؟

204
00:14:50,890 --> 00:14:55,240
أنتن من يُقرّرن ما يحدث لمدينة كاميتسوباكي

205
00:14:55,530 --> 00:14:57,560
وكأنّ الأمر ليس شأنكِ؟

206
00:14:57,560 --> 00:14:59,150
ألستِ خالقة؟

207
00:14:59,660 --> 00:15:01,580
...كيف يمكن لكلّ هذا

208
00:15:06,490 --> 00:15:08,590
...بعد كلّ ما عانينا منه

209
00:15:09,060 --> 00:15:10,560
...هارو

210
00:15:11,850 --> 00:15:15,140
أريدكن أن تعِشنَ

211
00:15:15,740 --> 00:15:18,520
...لكن بانقطاع التّيّار

212
00:15:18,520 --> 00:15:22,190
أوّل مرّة استخدمها ماكسويل
،على مدينة كاميتسوباكي

213
00:15:22,580 --> 00:15:26,520
لم أكن أملك القوّة لإيقافها

214
00:15:27,290 --> 00:15:29,860
ما يكون ماكسويل بالضّبط؟

215
00:15:30,920 --> 00:15:33,320
كائن بلا روح

216
00:15:33,880 --> 00:15:37,490
،بسبب الخطأ الّذي ارتكبه ماكسويل

217
00:15:37,490 --> 00:15:41,220
أمسى من الصّعب بالنّسبة لي
أن أُراقب مدينة كاميتسوباكي

218
00:15:41,220 --> 00:15:43,780
،في مُواجهة فقدان حياة دائم

219
00:15:43,780 --> 00:15:47,790
أنشأتُ برنامجاً لإعادة بناء المدينة
تلقائيّاً إذا مات كافّة المُواطنين

220
00:15:48,410 --> 00:15:50,440
الظّاهرة

221
00:15:52,190 --> 00:15:55,460
أملتُ أن ينقذ هذا شعب ذلك العالم

222
00:15:55,880 --> 00:16:00,430
لكن أغنيتكن أثبتتْ لي بأنّ ذلك كان خاطئاً

223
00:16:03,940 --> 00:16:08,190
،حالما تحوّلتْ أغنيتكن إلى يأس

224
00:16:08,550 --> 00:16:13,080
تجاوزَ ذلك اليأس حاجزَ الزّمكان ووصل إليّ

225
00:16:14,310 --> 00:16:15,820
الزّمكان؟

226
00:16:16,700 --> 00:16:19,540
أوقفتُ الظّاهرة

227
00:16:19,970 --> 00:16:24,910
أعتقد سيكون من الأفضل لكُن الحصول
على معرفة كاملة حول ما حدث

228
00:16:24,910 --> 00:16:28,550
عندما تتّخذنَ قراراتكن في المستقبل

229
00:16:28,960 --> 00:16:32,900
،قد تستمررن في العيش هنا إن أردتُن

230
00:16:32,900 --> 00:16:37,060
لكن في الحاضر، أنتُن مُجرّد بُنى طاقة معلومات

231
00:16:37,060 --> 00:16:39,470
لن يتمّ تعريفكن كبشر

232
00:16:40,230 --> 00:16:42,440
مثل ماكانا تماماً

233
00:16:43,930 --> 00:16:46,770
هل ترغبنَ تفاصيلَ أكثر؟

234
00:16:55,660 --> 00:16:57,070
...السّماء

235
00:16:58,120 --> 00:17:01,540
يوجد الكثير من الأبعاد

236
00:17:02,440 --> 00:17:07,840
عالم المنطق الأوّل، الّذي سكنتُن فيه، كان
عالماً افتراضيّاً بنيتُه

237
00:17:08,450 --> 00:17:14,010
أُصيب ذلك العالم الافتراضيّ بواسطة
—خطأ قاتل شبيه بانهيار

238
00:17:14,870 --> 00:17:16,260
انقطاع التّيّار

239
00:17:18,020 --> 00:17:20,220
هذا ما أُطلِق عليه

240
00:17:20,740 --> 00:17:25,310
في تلك اللّحظة، القوانين الفيزيائيّة لعالم
،المنطق الأوّل قد تشابكَتْ

241
00:17:25,310 --> 00:17:28,060
وكافّة المعلومات، بما فيها أفكار
،النّاس بحدّ ذاتهم

242
00:17:28,320 --> 00:17:31,830
أمستْ شكلاً جديداً من طاقة المعلومات
الّتي تُدعى بفراغمينت

243
00:17:32,660 --> 00:17:35,340
تستطيع الماجو نو موسومي التحكُّم
بكثافة هائلة من تلك الطّاقة

244
00:17:35,340 --> 00:17:37,590
من خلال وسيلة الغناء

245
00:17:37,590 --> 00:17:42,200
أصبحتُن قادرات على تجاوز
القوانين الطّبيعيّة للعالم

246
00:17:42,520 --> 00:17:46,690
أمستْ أغانيكن تعويذات بوسعها
تحويل طاقة المعلومات

247
00:17:46,690 --> 00:17:49,870
حتّى عبر الحواجز الزّمكانيّة

248
00:17:50,460 --> 00:17:53,880
لهذا وصلَتْ إليكِ أُغنيتي؟

249
00:17:54,250 --> 00:17:56,550
لستُ أنا فقط

250
00:17:56,990 --> 00:18:01,050
رُصِدت تعويذتكِ في العديد
من الأبعاد الأُخرى

251
00:18:02,280 --> 00:18:06,640
سحبتُ قوّة الجميع الّذين تلقّوا مشاعرك

252
00:18:07,480 --> 00:18:10,510
وذلك كي أستطيع التجلِّي هنا الآن

253
00:18:12,220 --> 00:18:16,490
سألتُن من قبل مَن يكون ماكسويل، صحيح؟

254
00:18:17,800 --> 00:18:20,030
قلتِ بأنّه كائن بلا روح؟

255
00:18:20,700 --> 00:18:25,700
كائن حيّ افتراضيّ يستهلك
طاقة المعلومات بشكل دائم

256
00:18:26,250 --> 00:18:28,180
فيروس كمبيوتر؟

257
00:18:29,430 --> 00:18:33,710
ما كان النّاس ليموتوا في الانقطاع
الكهربائيّ الأوّل مثلما فعلوا

258
00:18:33,710 --> 00:18:35,000
بسبب فيروس، أليس كذلك؟

259
00:18:35,380 --> 00:18:40,330
في المدرسة، علّمونا بأنّه كان الإشعاع
النّيوترونيّ من البقع الشّمسيّة

260
00:18:41,160 --> 00:18:46,430
في انقطاع التّيّار الأوّل، ولّدَ
ماكسويل جُزيئات طاقة

261
00:18:46,430 --> 00:18:48,520
،شبيهة بالإشعاع النيوترونيّ على نِطاق الكوكب

262
00:18:48,520 --> 00:18:52,730
وامتصّ الشّظايا المُنبعثة بواسطة الموتى

263
00:18:53,430 --> 00:18:57,860
لهذا السّبب تُوفّي والدايّ؟

264
00:18:58,170 --> 00:19:04,850
كان ماكسويل يجري تجارُب حول سُبُل
لامتصاص المعلومات بكفاءة أعلى

265
00:19:04,850 --> 00:19:06,200
تجارُب؟

266
00:19:06,200 --> 00:19:10,410
قتلنا وكلّ مَن نهتمّ بهم أمام أعيننا؟

267
00:19:11,630 --> 00:19:13,690
كلّ هذا محض تجربة بالنّسبة له؟

268
00:19:14,250 --> 00:19:15,800
...هذا فظيع

269
00:19:20,380 --> 00:19:23,400
يمكنكن أن تصنعن قراركن الآن

270
00:19:23,400 --> 00:19:27,580
هل ستبقين هنا، أم ترجعن؟

271
00:19:29,490 --> 00:19:32,900
يمكننا العودة إلى مدينة كاميتسوباكي؟

272
00:19:32,900 --> 00:19:36,290
يمكنني إبعادكن من هذا البُعد

273
00:19:36,290 --> 00:19:39,920
وإلى أين تذهبنَ عقب ذلك عائد لكُن

274
00:19:41,450 --> 00:19:42,240
...لكن

275
00:19:42,680 --> 00:19:46,580
هذا يعني تعديل بياناتكن، وذلك
كي لا تستطعنَ العودة إلى الماضي

276
00:19:46,580 --> 00:19:49,580
ولن تحدث الظّاهرة ثانية أبداً

277
00:19:50,470 --> 00:19:53,660
أي حالما نموت، ينتهي الأمر؟

278
00:19:54,440 --> 00:19:55,760
لا مُشكلة

279
00:19:57,310 --> 00:20:03,360
أُجبِرنا على تكرار دورة الغضب
والألم هذه لأكثر من ألف عام

280
00:20:03,360 --> 00:20:06,240
لكن لم يتغيّر شيء أبداً

281
00:20:06,820 --> 00:20:08,990
لا أريد العيش في عالم كهذا بعد الآن

282
00:20:11,130 --> 00:20:13,930
!لسنا دُمى يجري شخصٌ عليها تجارُب

283
00:20:13,930 --> 00:20:15,270
!نحن أحياء

284
00:20:15,270 --> 00:20:19,030
!مهما كان ذلك مؤلماً، أريد مُستقبلاً جديداً

285
00:20:19,380 --> 00:20:22,650
أريد الذّهاب مع صديقاتي لرؤية
!عالم اخترناه بأنفسنا

286
00:20:28,890 --> 00:20:30,970
!لن أستسلم ثانية

287
00:20:33,560 --> 00:20:35,420
أردتُ أن أعيش فعلاً

288
00:20:35,880 --> 00:20:38,670
أردتُ أن أُغنّي بأمل مع الجميع

289
00:20:39,110 --> 00:20:42,900
،إذا كان بالإمكان أن تصل مشاعري للآخرين
ففي المرّة المُقبلة، أريد أن أُغنّي

290
00:20:42,900 --> 00:20:44,360
مرحباً أيّها العالم

291
00:20:44,360 --> 00:20:48,680
أُوهِمتُ بأنّني على قيد الحياة

292
00:20:48,680 --> 00:20:54,730
لكن ما زلتُ أعتقد بأنّ مشاعري كانت كذبة

293
00:20:54,730 --> 00:21:00,270
لنبدأ بقصّة جديدة

294
00:21:00,270 --> 00:21:13,140
من سيُنقذ المستقبل؟