1
00:01:47,930 --> 00:01:49,980
هذه يابوسامي إذًا؟

2
00:01:59,930 --> 00:02:01,180
...أنت

3
00:02:01,180 --> 00:02:02,810
أكانت تلك محاولة فاشلة؟

4
00:02:02,810 --> 00:02:04,090
.نعم، فاشلة

5
00:02:05,890 --> 00:02:07,760
!إنّك تفتقرين للجرأة يا سينباي

6
00:02:15,690 --> 00:02:18,560
!أنتِ! من الخطر الرمي تجاه الناس

7
00:02:18,560 --> 00:02:20,370
...أنا آسفة

8
00:02:21,020 --> 00:02:22,270
!كلّا

9
00:02:23,970 --> 00:02:27,640
بدا وكأنّك كنتِ تتكاسلين، لذا
.أتيت لتنبيهك

10
00:02:28,970 --> 00:02:30,420
.يا هيمي

11
00:02:34,070 --> 00:02:36,730
.هذه واكاماكي أياكا-تشان

12
00:02:36,730 --> 00:02:38,810
إنّها أصغر منّا بسنة، في
.المرحلة الإعداديّة

13
00:02:39,090 --> 00:02:39,920
.مرحبًا

14
00:02:40,170 --> 00:02:42,440
،كانت تمزح قبل قليل

15
00:02:42,440 --> 00:02:44,550
.ولكنّها عادةً فتاة جادّة وجيّدة

16
00:02:44,870 --> 00:02:48,150
إنّها بارعة في كلّ من يابوسامي
.وكيودو العادي

17
00:02:49,370 --> 00:02:51,810
!ياه، توقّفي فحسب

18
00:02:52,010 --> 00:02:56,250
أنا بارعة في يابوسامي؟ أنتِ
!من فاز السنة الماضية

19
00:02:56,250 --> 00:02:57,820
مرحلة التمرّد؟

20
00:02:58,110 --> 00:02:59,070
...ولكن

21
00:02:59,460 --> 00:03:01,570
.لن أدع ذلك يحدث هذه السنة

22
00:03:04,510 --> 00:03:06,570
.نعم، لنبذل قصارى جهدنا

23
00:03:09,220 --> 00:03:10,830
!المعذرة

24
00:03:20,650 --> 00:03:25,340
إن كنتن ستكنّ حاضرات
،في مسابقة هذه السنة لتشجيع سينباي

25
00:03:25,340 --> 00:03:27,930
.فستحبطنَ حتمًا

26
00:03:29,050 --> 00:03:31,840
.حاولن تحفيزها قليلًا قبل ذلك

27
00:03:31,840 --> 00:03:32,840
.إلى اللقاء

28
00:03:34,390 --> 00:03:35,280
...آه

29
00:03:35,280 --> 00:03:36,310
ماذا؟

30
00:03:37,000 --> 00:03:39,810
بالمناسبة، كيف كانت بطولة كيودو؟

31
00:03:41,170 --> 00:03:44,820
أحرزت الثالث فرديًّا وفشلت
.بالتأهّل إلى البطولة الوطنيّة

32
00:03:45,060 --> 00:03:47,720
في منافسة الأفرقة، لم
.أمس الهدف حتّى

33
00:03:48,180 --> 00:03:51,220
،لهذا، كذكرى أخرى للمرحلة الإعداديّة

34
00:03:51,220 --> 00:03:53,950
!سأهزمك على الأقل وأفوز يا سينباي

35
00:03:54,520 --> 00:03:56,620
!يستحسن أن تكوني مستعدة

36
00:04:00,580 --> 00:04:03,460
.كانت متحمسة حقًّا

37
00:04:03,920 --> 00:04:05,060
...نعم

38
00:04:05,360 --> 00:04:09,460
.في الواقع، إنّها تتحمّس أكثر من اللازم

39
00:04:15,420 --> 00:04:19,260
لذا في السنة الماضية، لمحاولة
...تهدئة أعصابها قليلًا

40
00:04:20,330 --> 00:04:22,110
!أياكا-تشان، أياكا-تشان

41
00:04:25,800 --> 00:04:27,270
أشعرتِ بالارتياح؟

42
00:04:27,910 --> 00:04:30,160
!هل تسخرين مني؟

43
00:04:30,450 --> 00:04:32,700
.قطعتِ تركيزي الآن

44
00:04:39,200 --> 00:04:40,950
قمتِ بوجهٍ غريب؟

45
00:04:40,950 --> 00:04:43,470
...اعتقدَت شينو-تشان أنّه مضحك

46
00:04:43,970 --> 00:04:46,310
.هذه ليست طفلة

47
00:04:46,310 --> 00:04:49,800
.بدا وكأنّها تكرهني منذ ذاك الحين

48
00:04:49,990 --> 00:04:53,430
.أتت للفت انتباهك فحسب
.لا أعتقد أنّها تكرهك

49
00:04:54,750 --> 00:04:56,480
.أعتقد أنّها متعلقة بك

50
00:04:56,480 --> 00:04:57,260
حقًّا؟

51
00:04:57,620 --> 00:04:59,150
أتعتقدان ذلك؟

52
00:05:02,230 --> 00:05:07,400
فكّرت بطريقة جيّدة لجعل
.أياكا-تشان ترتاح

53
00:05:07,920 --> 00:05:09,630
حقًّا؟ ماذا؟

54
00:05:16,300 --> 00:05:18,570
أتعتقدين أنّ هذا سيكون مناسبًا؟

55
00:05:18,570 --> 00:05:20,150
.لا بأس

56
00:05:20,150 --> 00:05:21,270
.أنتن

57
00:05:22,100 --> 00:05:23,820
!كاناتاموري-سينسي

58
00:05:24,190 --> 00:05:27,470
.يكفي من حديث الفتيات وعودي للتدريب

59
00:05:27,470 --> 00:05:28,690
.حسنًا

60
00:05:30,460 --> 00:05:34,680
بدلًا من يابوسامي، أتردن
تجربة كيودو العاديّة؟

61
00:05:43,430 --> 00:05:46,140
.شكرًا لكن على مرافقتي خلال تدريبي

62
00:05:46,140 --> 00:05:47,130
.لا بأس

63
00:05:47,130 --> 00:05:49,590
.كان ممتعًا لنا أيضًا

64
00:05:53,620 --> 00:05:57,780
أعتقد أنّ الرماية أصعب
بكثير ممّا تبدو، أليست كذلك؟

65
00:05:58,570 --> 00:06:00,540
.الرماية اليابانيّة على وجه الخصوص

66
00:06:01,000 --> 00:06:04,790
،بالمَناسبة يا هيمينو-سان
لم تتدربين على الرماية؟

67
00:06:07,480 --> 00:06:10,460
.لأنّ أمي أخبرتني بذلك على ما أعتقد

68
00:06:10,460 --> 00:06:14,680
.سيوبخها جدي لو لم أفعل ذلك

69
00:06:14,680 --> 00:06:18,130
هذا من أجل إيجاد رفيق
زواج، أليس كذلك؟

70
00:06:18,130 --> 00:06:21,470
بغض النظر عن معناه الآن
...سبب وجود المسابقة هو

71
00:06:23,480 --> 00:06:27,940
،مكان للتدرّب، معدات جيّدة
ووقتٌ وافر للتدرب

72
00:06:28,210 --> 00:06:31,720
كانوا مقاييس للثروة
.ودليل على الصحة الجيدة

73
00:06:36,620 --> 00:06:39,110
،بما أنّ ليس هنالك عائلات قناطير كثيرة

74
00:06:39,110 --> 00:06:42,670
كانت طريقة جيّدة
.لإيجاد زوج أو زوجة للقناطير

75
00:06:45,220 --> 00:06:47,390
تعنين من أجل التكاثر؟

76
00:06:47,390 --> 00:06:49,960
وضعها بهذه الطريقة قد
.تكون مباشرة أكثر من اللازم

77
00:06:50,940 --> 00:06:53,840
هل كلمة "التكاثر" تعد بذاءة؟

78
00:06:53,840 --> 00:06:56,040
.كنت متيقنة أنّها مصطلح جاد

79
00:06:56,300 --> 00:06:57,970
.يعتمد هذا على الزمان والمكان

80
00:06:59,030 --> 00:07:06,630
...لستُ أفعلها من أجل التكاثر أبدًا

81
00:07:06,900 --> 00:07:07,980
!إنّها الحقيقة

82
00:07:08,180 --> 00:07:10,580
أتفكرين بالزواج بعد المرحلة
الثانويّة فورًا؟

83
00:07:10,580 --> 00:07:13,990
.لم أفكّر بهذا أبدًا

84
00:07:15,460 --> 00:07:18,610
.أتساءل ما هو الحال مع أياكا-تشان

85
00:07:19,430 --> 00:07:22,210
.أعتقد أنّها من عائلة راقية

86
00:07:22,580 --> 00:07:25,350
حسنًا، حتّى وإلّم تكن
،بعمر مناسب للزواج

87
00:07:25,350 --> 00:07:27,690
.فهنالك خطبة على ما أعتقد

88
00:07:38,970 --> 00:07:40,460
قطب جنوبيّة؟

89
00:07:40,460 --> 00:07:41,720
...مذهل

90
00:07:41,720 --> 00:07:42,790
هنا؟

91
00:07:47,250 --> 00:07:48,010
هاه؟

92
00:07:48,300 --> 00:07:51,580
.مرحبًا

93
00:07:51,580 --> 00:07:52,360
.أهلًا

94
00:07:52,970 --> 00:07:54,950
أليست هذه نائبة الرئيس؟

95
00:07:54,950 --> 00:07:57,380
من هن مرّة ثانية؟

96
00:07:57,380 --> 00:07:59,480
.إنّهم في فصل كوموري-كن

97
00:08:00,070 --> 00:08:01,950
.إنّهم الطلاب الأصغر سنًّا مني إذًا

98
00:08:02,250 --> 00:08:04,340
أتذكر الفتاة بالشعر الأحمر الساطع؟

99
00:08:04,340 --> 00:08:06,160
.على الأرجح أنّهن أتين لتشجيعها

100
00:08:09,220 --> 00:08:11,460
أنتنّ أصدقاء ري-تشان إذًا؟

101
00:08:11,460 --> 00:08:13,460
.استمتعن بوقتكن

102
00:08:13,460 --> 00:08:15,220
.هذا غريب

103
00:08:15,220 --> 00:08:16,700
.هذا ما توقعته

104
00:08:16,700 --> 00:08:19,470
!نوزومي-تشان! كيو-تشان! سو-تشان

105
00:08:20,540 --> 00:08:21,350
.مرحبًا

106
00:08:21,350 --> 00:08:23,240
.آه، مرحبًا

107
00:08:23,240 --> 00:08:25,710
.مرحبًا

108
00:08:25,710 --> 00:08:27,610
...قطب جنوبيّة

109
00:08:28,490 --> 00:08:29,410
من هذه؟

110
00:08:29,410 --> 00:08:32,520
.ماكي-تشان. إنّها صديقتي من الحضانة

111
00:08:32,520 --> 00:08:33,480
.سررت لمقابلتك

112
00:08:36,200 --> 00:08:37,790
أهذه وحش؟

113
00:08:37,790 --> 00:08:41,260
.لا، ليست وحشًا، إنّها سو-تشان

114
00:08:47,330 --> 00:08:49,110
.تبدين بحالة جيّدة اليوم

115
00:08:50,290 --> 00:08:52,360
.على المشاركين التجمّع

116
00:08:52,360 --> 00:08:54,010
.عليّ الذهاب

117
00:08:54,240 --> 00:08:55,870
.أراكنّ لاحقًا

118
00:08:55,870 --> 00:08:57,730
!ابذلي جهدك يا ني-تان

119
00:08:57,730 --> 00:08:59,050
.ابذلي جهدك

120
00:09:01,880 --> 00:09:04,320
لنشجعها معًا، حسنًا؟

121
00:09:04,320 --> 00:09:05,890
!وحش مخيف

122
00:09:05,890 --> 00:09:08,860
.لا بأس ني-تان موجودة

123
00:09:08,860 --> 00:09:11,010
.وأيضًا، إنّها ليست وحشًا

124
00:09:11,520 --> 00:09:14,160
.صحيح. لستُ وحشًا

125
00:09:16,570 --> 00:09:18,130
...لا بأس

126
00:09:19,220 --> 00:09:20,850
.اذهبي للتحدّث معها

127
00:09:20,850 --> 00:09:22,440
.اذهب أنت

128
00:09:22,440 --> 00:09:25,370
ولكن يصعب عليّ التحدث
...مع فتيات في المرحلة الثانوية

129
00:09:26,100 --> 00:09:28,690
.لن نسلب هيمي-أونيتشان

130
00:09:28,690 --> 00:09:30,920
!بل سنفعل

131
00:09:51,120 --> 00:09:52,670
.كان ذلك جيّدًا

132
00:09:52,670 --> 00:09:54,240
.شكرًا لك

133
00:09:54,480 --> 00:09:56,770
.التالي، واكاماكي أياكا-سان

134
00:09:56,770 --> 00:09:58,250
.عليّ الذهاب

135
00:09:58,250 --> 00:09:59,980
...انتظري

136
00:10:00,220 --> 00:10:03,710
ماذا؟ هل ستقولين شيئًا
يشتت ذهني ثانيةً؟

137
00:10:03,710 --> 00:10:04,870
.لا

138
00:10:04,870 --> 00:10:06,370
ماذا إذًا؟

139
00:10:06,980 --> 00:10:09,990
لمَ لا نعقد رهانًا لجعل
الأمور أكثر حماسًا؟

140
00:10:11,410 --> 00:10:13,120
.يبدو ذلك ممتعًا

141
00:10:13,620 --> 00:10:14,910
...حسنًا إذًا

142
00:10:15,730 --> 00:10:17,850
.اعرضي عليها عقد رهان

143
00:10:17,850 --> 00:10:18,580
.نعم

144
00:10:19,080 --> 00:10:20,710
...وإن خسرتِ

145
00:10:21,560 --> 00:10:23,220
.سأخرج في موعد معك.

146
00:10:24,750 --> 00:10:26,590
—مـ-ما الذي تقول

147
00:10:27,120 --> 00:10:29,100
!توقّفي عن المزاح

148
00:10:33,860 --> 00:10:35,770
هل هي بخير؟

149
00:10:38,440 --> 00:10:41,540
أين نذهب؟ وماذا أرتدي؟

150
00:10:41,540 --> 00:10:43,630
...لا، قبل هذا

151
00:10:44,540 --> 00:10:46,190
!عليّ هزيمتها

152
00:11:02,880 --> 00:11:04,660
!آسفة

153
00:11:04,660 --> 00:11:06,550
!تأخرتِ يا سينباي

154
00:11:06,550 --> 00:11:09,020
هنالك العديد من الأماكن
!التي أود الذهاب إليها

155
00:11:09,630 --> 00:11:11,370
!حسنًا، لنذهب

156
00:11:12,180 --> 00:11:13,020
.نعم

157
00:11:17,990 --> 00:11:19,820
لمَ نلحقهما؟

158
00:11:19,820 --> 00:11:21,020
لمَ لا؟

159
00:11:24,740 --> 00:11:26,600
.أعتقد أنّنا كُشفنا

160
00:11:33,140 --> 00:11:35,120
.لقد كشفتنا بسببك يا كيوكو

161
00:11:35,120 --> 00:11:36,840
.ماذا؟ ليس خطئي

162
00:11:36,840 --> 00:11:39,810
أكان خطئي؟ أنكمل اللحاق بهما؟

163
00:11:39,810 --> 00:11:41,400
.بالطبع سنفعل

164
00:11:41,400 --> 00:11:42,690
!لا، لن نفعل

165
00:11:51,890 --> 00:11:53,800
.احمل هذا إلى هناك

166
00:11:54,640 --> 00:11:55,980
أوصلت تلك بهذه السرعة؟

167
00:11:56,760 --> 00:11:58,400
!لا، هناك

168
00:12:02,270 --> 00:12:03,570
!هنا

169
00:12:03,810 --> 00:12:07,930
.هذه هي

170
00:12:07,930 --> 00:12:09,550
حقًّا؟

171
00:12:09,550 --> 00:12:10,610
مذهل، أليس كذلك؟

172
00:12:10,610 --> 00:12:12,540
!هذا لا يصدّق

173
00:12:12,540 --> 00:12:16,130
.لا أصدّق أنّك حصلت على هذه المجلة

174
00:12:16,130 --> 00:12:18,200
لا يبيعونها في المدن المحيطة
بالبحر، أليس كذلك؟

175
00:12:18,420 --> 00:12:21,970
قريبي سبّاح متنافس في
.مدينة بريّة

176
00:12:21,970 --> 00:12:23,830
.أعطاني إيّاها

177
00:12:23,830 --> 00:12:25,170
!مذهل

178
00:12:27,100 --> 00:12:29,390
انتبها! ما الذي تفعلانه؟

179
00:12:29,390 --> 00:12:31,010
!لا تقل هذا

180
00:12:31,270 --> 00:12:33,860
.لا يمكنكما النظر في مجلّات خلاعيّة هنا

181
00:12:33,860 --> 00:12:35,730
...إنّكما حقًّا

182
00:12:39,760 --> 00:12:42,230
.هذا منشورٌ صحي تمامًا

183
00:12:42,230 --> 00:12:44,730
ولكنّكما كنتما تنظران إليه بحماس، أليس كذلك؟

184
00:12:46,060 --> 00:12:50,010
.بالأحرى، إنّكما تران أثداءً كلّ يوم

185
00:12:50,010 --> 00:12:52,200
مع ذلك تريدان رؤيتها في مجلة؟

186
00:12:52,200 --> 00:12:53,400
!أيّتها الغبيّة

187
00:12:53,400 --> 00:12:56,040
!هذه قيمتها أكبر لأنّها مستورة

188
00:12:57,640 --> 00:13:01,420
أنتن ترتدين زي السباحة عندما
يأتي أشخاص من الجبال، صحيح؟

189
00:13:03,570 --> 00:13:06,610
.خاصّتكم لها قيمة لديهم أيضًا

190
00:13:07,140 --> 00:13:09,350
أهذا يثيركما إذًا؟

191
00:13:10,850 --> 00:13:12,860
.لا، تأخّر الوقت على ذلك

192
00:13:13,300 --> 00:13:17,710
على أيّ حال! المشكلة هي أنّكما
!لا تقومان بتجهيزات الاحتفال

193
00:13:17,710 --> 00:13:19,740
!كنّا نأخذ استراحة فحسب

194
00:13:20,020 --> 00:13:21,540
...يا إلهي

195
00:13:25,040 --> 00:13:26,500
.مرحبًا يا إيري-تشان

196
00:13:28,300 --> 00:13:29,320
.مرحبًا

197
00:13:31,410 --> 00:13:33,970
إذًا ستكونين الكاهنة في
احتفال اليوم؟

198
00:13:33,970 --> 00:13:35,830
.نعم

199
00:13:37,940 --> 00:13:38,700
!أنتما

200
00:13:38,990 --> 00:13:40,860
!توقّفا عن التحديق بصدرها

201
00:13:42,410 --> 00:13:43,890
.حسنًا، أراكم لاحقًا

202
00:13:43,890 --> 00:13:45,130
.أحسنتِ العمل

203
00:13:45,130 --> 00:13:46,320
.إلى اللقاء

204
00:13:48,950 --> 00:13:50,690
تحبون التي لديها إذًا؟

205
00:13:50,980 --> 00:13:51,970
.نعم، أعتقد

206
00:13:52,320 --> 00:13:54,910
...لأنّها تتصرف بخجل

207
00:13:54,910 --> 00:13:57,450
!يمكنك معرفة أنّها تربّت في البر

208
00:14:02,330 --> 00:14:03,950
...هذان

209
00:14:06,290 --> 00:14:08,040
.انسي الأمر. لنذهب

210
00:14:09,580 --> 00:14:10,690
.إلى اللقاء

211
00:14:41,280 --> 00:14:44,640
.اعتقدت أنّ صبيًّا قد أتى

212
00:14:44,890 --> 00:14:46,800
.هذا تحرش جنسي

213
00:14:47,160 --> 00:14:49,720
يربون الأطفال بصرامة في البر، هاه؟

214
00:14:50,250 --> 00:14:52,900
هنالك موج في البحر، لا بدّ
.وأنّه يتعبك

215
00:14:53,400 --> 00:14:55,480
.ارتاحي هنا قليلًا

216
00:15:15,400 --> 00:15:17,940
.إنّه الإله تاغون

217
00:15:19,040 --> 00:15:22,640
إنّك على وشك تقديم أغنية
.احتفاءً به

218
00:15:22,640 --> 00:15:23,620
.نعم

219
00:15:24,240 --> 00:15:29,930
صحة بحرنا وبركة قريتنا
.سيعتمدان على غنائك

220
00:15:32,660 --> 00:15:35,270
.وأيضًا على حجم جمهورك

221
00:15:37,830 --> 00:15:41,090
اعتبريها واحدة من الحفلات
.التي تقيمينها عادةً

222
00:15:41,090 --> 00:15:42,530
.هذا ليس مختلفًا كثيرًا

223
00:15:42,910 --> 00:15:44,020
...لا

224
00:15:45,780 --> 00:15:48,560
.قد أكون نجمة جماهير، ولكنّي لست بتلك الشهرة

225
00:15:48,920 --> 00:15:52,040
هذه أول مرة أحظى
.بها بجمهور بهذا الحجم

226
00:15:53,310 --> 00:15:54,620
!فهمت

227
00:15:56,980 --> 00:15:58,780
هل أنتِ جاهزة؟

228
00:15:59,220 --> 00:16:00,060
.نعم

229
00:17:06,160 --> 00:17:07,420
.استمري

230
00:17:09,870 --> 00:17:11,390
،إنّه الدلفين البشري

231
00:17:11,720 --> 00:17:13,920
.رسول من الإله تاغون

232
00:17:14,200 --> 00:17:17,110
.أعجبه غناؤك

233
00:17:39,520 --> 00:17:41,530
هرب الدلفين البشري؟ لماذا؟

234
00:18:06,810 --> 00:18:09,810
.أنا الإله تاغون

235
00:18:10,410 --> 00:18:15,170
.اسمعوا كلامي وأطيعوه

236
00:18:18,350 --> 00:18:20,630
إله حقيقي؟

237
00:18:21,990 --> 00:18:24,610
!ليس كذلك! هذا محتال

238
00:18:25,810 --> 00:18:26,970
!اهربي

239
00:18:43,720 --> 00:18:45,810
.لا يبدو أنّه يلاحقنا

240
00:18:46,440 --> 00:18:49,920
لم يمكن هذا إلها حقًّا؟

241
00:18:50,590 --> 00:18:54,540
.نعم. إلهنا هو ذلك التمثال الحجري

242
00:18:55,750 --> 00:18:58,810
.الإله الحقيقي لا يعيش بيننا

243
00:18:59,640 --> 00:19:01,400
...إذًا ما

244
00:19:01,400 --> 00:19:03,570
كان ذلك الوحش؟

245
00:19:04,350 --> 00:19:07,020
،رجلٌ آلي، مخلوق بيولوجي

246
00:19:07,020 --> 00:19:11,260
،شيءٌ وضع من قبل محطة تلفازية
...أو ربما تجربة حكوميّة

247
00:19:11,260 --> 00:19:13,760
.لستُ متأكدًا

248
00:19:16,020 --> 00:19:19,140
،عندما لا تعلمين ما الذي يجري
!فمن الأفضل أن تهربي

249
00:19:21,280 --> 00:19:25,680
علينا العودة إلى الشاطئ
.وإشعار خفر السواحل

250
00:20:07,700 --> 00:20:09,580
إله؟

251
00:20:10,980 --> 00:20:12,470
.نعم، إله

252
00:20:12,470 --> 00:20:14,300
.لا يوجد شيء كهذا

253
00:20:14,300 --> 00:20:17,070
...قد يكون شيئًا كوجود عقائدي

254
00:20:21,250 --> 00:20:22,730
!لدينا محترفة هنا

255
00:20:26,070 --> 00:20:27,190
.لست محترفة

256
00:20:27,190 --> 00:20:29,190
.عائلتي تدير ضريحًا فحسب

257
00:20:29,190 --> 00:20:32,240
.لست عالمة لاهوت ولا شامان

258
00:20:32,240 --> 00:20:34,150
لا تؤمنين بهم أيضًا؟

259
00:20:35,170 --> 00:20:36,790
...الآلهة

260
00:20:38,640 --> 00:20:39,590
الآلهة؟

261
00:20:39,590 --> 00:20:40,430
".إله"؟ عرّفي "إله"

262
00:20:40,430 --> 00:20:42,450
إنّه ناتج المخيلة فحسب، أليس كذلك؟

263
00:20:42,450 --> 00:20:44,890
!هيّا، لا تغلقي الموضوع بسرعة

264
00:20:44,890 --> 00:20:46,170
ما الذي يجعلك متيقنة بوجودهم؟

265
00:20:46,170 --> 00:20:48,600
الأهم من ذلك، ما هو مصدر دخلنا؟

266
00:20:53,690 --> 00:20:55,000
رئيسة الفصل؟

267
00:20:55,390 --> 00:20:57,010
.إنّهم يتواجدون بالطبع

268
00:20:57,010 --> 00:20:59,440
.إله ضريحنا يعمل بجد

269
00:20:59,830 --> 00:21:05,270
،إنّه يجلب الصحة، السلامة المروريّة
،الجمال، التوافق المنزلي

270
00:21:05,270 --> 00:21:07,440
وإنّه فعّال بشكل خاص
.بجلب النجاح الأكاديمي

271
00:21:08,950 --> 00:21:12,410
بالتفكير بالأمر، إنّك
الثانية على سنتنا، صحيح؟

272
00:21:13,100 --> 00:21:14,490
...إنّها

273
00:21:36,930 --> 00:21:39,760
سوي-تشان، أتلعبين هذه لوحدك؟

274
00:21:39,760 --> 00:21:41,860
.لا، رفقة صديقتي

275
00:21:43,710 --> 00:21:45,850
.حسنًا إذًا، كونا على وفاق

276
00:21:49,810 --> 00:21:52,710
!سحقًا! خسرت ثانيةً

277
00:21:55,700 --> 00:21:57,950
!مرّة أخرى! مرّة ثانية