1
00:00:06,020 --> 00:00:08,690
لا يبدو لي أنّه يوجد أي شيء
غريب في هذه المنطقة

2
00:00:09,300 --> 00:00:11,220
كُنَّ حذرات

3
00:00:11,220 --> 00:00:14,980
فنحن لم نعد نواجه الأوبلي فقط بعد الآن

4
00:00:14,980 --> 00:00:18,330
بل نواجه بشراً بنفس قوّتنا

5
00:00:18,330 --> 00:00:20,080
من الصّعب تصديق ذلك

6
00:00:20,450 --> 00:00:22,750
السجلّ القتالي يشير إلى ذلك

7
00:00:23,360 --> 00:00:27,280
أنا قلقة بشأنِ الفتاة الغريبة
التي واجهَها فريقُ تورتي أيضاً

8
00:00:27,280 --> 00:00:30,500
الفارس الأسود أوديلي، أليس كذلك؟

9
00:00:30,500 --> 00:00:33,320
تبدو كشرّيرة غامضة بالنسبة لي

10
00:00:33,320 --> 00:00:35,510
!من شرّيرة غامضة؟

11
00:00:36,210 --> 00:00:39,680
!من الوقاحةِ العبث باسم أحد

12
00:00:39,680 --> 00:00:40,750
أين هي؟

13
00:00:40,750 --> 00:00:42,060
هناك

14
00:00:42,820 --> 00:00:44,490
وأنا لستُ الفارس الأسود

15
00:00:44,490 --> 00:00:45,900
أنا فارس البجعة السّوداء

16
00:00:46,950 --> 00:00:48,970
،سألفظ اسمي مجدّداً

17
00:00:48,970 --> 00:00:51,450
لذا احرصن على حفظِه

18
00:00:51,450 --> 00:00:56,860
أنا الجنديّة الوحيدة التي تقطعُ الطريق
الوعر بين الزمان والمكان

19
00:00:57,200 --> 00:01:00,330
!أنا فارس البجعة السّوداء

20
00:02:32,720 --> 00:02:33,790
...أوديلي

21
00:02:33,990 --> 00:02:35,130
!ظهرت؟...

22
00:02:35,630 --> 00:02:40,450
ظننتُ أنّكن رأيتن حلماً جماعيّاً أو ما شابه

23
00:02:40,380 --> 00:02:42,610
لم أتوقّع أن تظهر فعلاً

24
00:02:44,230 --> 00:02:46,670
لا تثِقن بنا إطلاقاً

25
00:02:46,670 --> 00:02:48,610
هذا غير مُفاجئ

26
00:02:49,410 --> 00:02:50,940
وماذا حدث؟

27
00:02:51,340 --> 00:02:53,770
هاجمَتْنا وقالت لنا أن نسلّم الميموكا خاصّتنا

28
00:02:54,120 --> 00:02:56,750
وكانت قويّة للغاية

29
00:02:56,750 --> 00:02:59,240
بصراحة، كنّا على وشك أن نخسر

30
00:02:59,950 --> 00:03:01,490
على وشك؟

31
00:03:02,980 --> 00:03:05,120
ما خطبها؟

32
00:03:05,120 --> 00:03:06,910
حظوظنا معدومة هنا

33
00:03:07,310 --> 00:03:10,540
هل أدركتُنّ كم أنَّ قوّتي رائعة؟

34
00:03:10,620 --> 00:03:15,420
أنا فارس البجعة السّوداء، أوديلي

35
00:03:15,730 --> 00:03:18,670
فارس البجعة السّوداء، سُرِرتُ بلقائكن

36
00:03:18,910 --> 00:03:20,580
—والآن أعطنّني أموالكـ

37
00:03:20,580 --> 00:03:23,760
أعني أعطنّني كلّ الميموكا خاصّتكن

38
00:03:25,020 --> 00:03:27,180
هيّا هيّا

39
00:03:28,640 --> 00:03:29,810
!أصبتُ ساقي

40
00:03:29,810 --> 00:03:30,340
!ساقي

41
00:03:30,340 --> 00:03:30,960
!هذا مؤلم

42
00:03:30,960 --> 00:03:32,770
!سـ-سأموت

43
00:03:33,030 --> 00:03:35,230
تبّاً، أنتن قويّات

44
00:03:35,230 --> 00:03:37,940
!لم تربحن في هذه

45
00:03:41,740 --> 00:03:44,560
هذا نفس ما حدث معنا تماماً

46
00:03:44,560 --> 00:03:47,090
يومي، دوريّتكن هي التالية، صحيح؟

47
00:03:47,090 --> 00:03:47,990
كُنَّ حذرات

48
00:03:48,280 --> 00:03:50,580
نعم، شكراً يا ريوكو-تشان

49
00:03:51,230 --> 00:03:53,080
ليسَتْ أوديلي فحسب

50
00:03:53,080 --> 00:03:56,280
الثّلاثة اللّاتي قضين على بودينغ هناك أيضاً

51
00:03:58,560 --> 00:04:03,340
على أي حال، أثبتنا أنَّ أوديلي موجودة فعلاً الآن

52
00:04:03,930 --> 00:04:07,600
لكن هذا لا يغيّر شيئاً من الوضع
الذي بمتناولِ اليد

53
00:04:09,220 --> 00:04:10,600
مانا؟

54
00:04:12,950 --> 00:04:14,810
لنفعل ما بوسعنا يا إيو-تشين

55
00:04:17,010 --> 00:04:18,980
،أعلم أنّ هذا مفاجئ

56
00:04:18,980 --> 00:04:22,140
لكن سأطلب منكِ شنّ هجوم طارئ بدلاً من ذلك

57
00:04:22,140 --> 00:04:23,400
هجوم طارئ؟

58
00:04:23,660 --> 00:04:26,660
تأكّدنا من وجود تشوُّه بُعدي
في الكتلة-س. موشو

59
00:04:27,770 --> 00:04:28,530
أوبلي؟

60
00:04:28,920 --> 00:04:30,880
،لم نرصد إشارةً بعد

61
00:04:30,880 --> 00:04:33,290
لكن نعتقد بأنَّ احتمالية وجود أوبلي
هناك عالية جدّاً

62
00:04:33,860 --> 00:04:35,430
...سينسي

63
00:04:35,430 --> 00:04:36,280
نعم؟

64
00:04:36,280 --> 00:04:38,880
هل علمتِ شيئاً عن أكارا-تشين والأخريات؟

65
00:04:39,550 --> 00:04:42,360
...نحن نحلّلُ البيانات، لكن

66
00:04:42,360 --> 00:04:43,330
الشيء الوحيد الذي اكتشفناه هو أنّهن

67
00:04:43,330 --> 00:04:48,430
لم يظهرن بتشوُّه بُعدي مُصاحِب
مثل الأوبلي، موشو

68
00:04:48,670 --> 00:04:50,370
وماذا في ذلك؟

69
00:04:50,370 --> 00:04:56,060
يُسافِرن إلى الحدود البعديّة من هذا العالم
مثل القوّة الخامسة تماماً

70
00:04:56,350 --> 00:05:00,070
إذاً أكارا-تشين والأخريات هُنَّ في مكان
ما في هذا العالم

71
00:05:00,530 --> 00:05:02,790
أستطيع رؤيتهن مجدّداً إذاً يوماً ما

72
00:05:04,810 --> 00:05:06,450
أنا جائعةٌ للغاية

73
00:05:11,940 --> 00:05:14,760
من القسوة أن تتركنا نذهب دون طعام

74
00:05:14,760 --> 00:05:16,170
هل أنتِ بخير يا كوري؟

75
00:05:16,670 --> 00:05:17,750
أجل

76
00:05:22,810 --> 00:05:25,550
نهزم ألتاير تورتي مهما كلّفَ الأمر

77
00:05:27,840 --> 00:05:30,550
لا شيء خارج عن المألوف الآن على ما يبدو

78
00:05:31,020 --> 00:05:33,180
أخوات أوريغامي الثّلاث

79
00:05:33,180 --> 00:05:36,230
ربّما نُصادفهن أثناء تجوّلنا في البلدة

80
00:05:36,230 --> 00:05:38,810
نحن لا نعرف شكلَ أوديلي

81
00:05:39,360 --> 00:05:42,250
عالمنا واسعٌ جدّاً أيضاً

82
00:05:42,250 --> 00:05:45,110
من الصّعب أن أتخيّل أنّنا سنُصادف بعضنا الآخر

83
00:05:45,490 --> 00:05:48,930
أشعر بشعور مختلِف كلّياً بمجرّد معرفتي
أنّنا قد نصادف بعضنا

84
00:05:48,930 --> 00:05:52,460
ماذا ستفعلين إذا صادفتِ أولئك الثّلاثة؟

85
00:05:53,570 --> 00:05:56,290
...في الواقع، مانا

86
00:06:03,360 --> 00:06:04,210
!أوبلي

87
00:06:05,460 --> 00:06:06,670
هُنا ألتاير تورتي

88
00:06:07,170 --> 00:06:08,160
ظهر أوبلي

89
00:06:08,160 --> 00:06:09,590
جاري إرسال البيانات

90
00:06:11,720 --> 00:06:13,330
إنّه أوبلي ماغيري متوسّط الحجم

91
00:06:13,330 --> 00:06:14,910
نوع جديد

92
00:06:14,910 --> 00:06:16,350
يبدو كسحليّة

93
00:06:24,220 --> 00:06:25,240
لقد ذابت

94
00:06:25,240 --> 00:06:27,240
علينا أن نحذر أثناء الاقتراب منه

95
00:06:27,470 --> 00:06:30,310
ساتوكا ومانا، ثبِّتاه من الأطراف

96
00:06:30,310 --> 00:06:30,820
حاضرة

97
00:06:31,180 --> 00:06:34,270
يومي، ركّزي نيرانكِ على وجه الأوبلي

98
00:06:34,270 --> 00:06:34,910
حاضرة

99
00:06:35,190 --> 00:06:38,570
وإيو وأنا سنهاجم من الخلف عندما تسنح لنا الفرصة

100
00:06:38,570 --> 00:06:39,290
عُلِم

101
00:06:42,260 --> 00:06:43,380
!ها أنا قادمة

102
00:07:01,310 --> 00:07:02,770
!لن أدعك تفلت

103
00:07:07,020 --> 00:07:07,990
!قصف مُركَّز

104
00:07:18,650 --> 00:07:19,500
!نجحنا

105
00:07:20,670 --> 00:07:22,620
كان ذلك سهلاً للغاية

106
00:07:24,980 --> 00:07:25,650
!يومي

107
00:07:25,650 --> 00:07:26,670
!يومي-تشين

108
00:07:27,900 --> 00:07:29,560
ما زال الذيل فقط على قيدِ الحياة

109
00:07:29,560 --> 00:07:31,430
!لا داعي لتقلّد سحليّةً حقيقيّةً إلى هذا الحدّ

110
00:07:31,850 --> 00:07:34,350
علينا أن نتوخّى الحذر أثناء الهجوم الآن

111
00:07:36,070 --> 00:07:37,500
المزيد من الأوبلي؟

112
00:07:42,770 --> 00:07:43,400
!ماذا؟

113
00:07:48,450 --> 00:07:50,070
ماذا إن كنّا كذلك؟

114
00:07:50,070 --> 00:07:51,710
!لقد عرفت

115
00:07:51,710 --> 00:07:53,370
!إنّها أوريغامي أكاري-تشان

116
00:07:53,860 --> 00:07:55,130
هذه أنتِ، صحيح؟

117
00:07:55,130 --> 00:07:57,120
وهينا-تشين وكوري-تشين أيضاً

118
00:07:59,060 --> 00:08:01,290
ما أدراكِ بأسمائنا؟

119
00:08:01,530 --> 00:08:03,310
أنا مانا

120
00:08:03,310 --> 00:08:04,420
أتتذكّرنني؟

121
00:08:08,080 --> 00:08:09,760
كثيرة البكاء مانا؟

122
00:08:10,040 --> 00:08:11,300
أجل، هذا صحيح

123
00:08:11,300 --> 00:08:12,090
هذه أنا

124
00:08:12,390 --> 00:08:13,740
مانا

125
00:08:13,740 --> 00:08:15,430
كوري، كنتِ صغيرة

126
00:08:15,430 --> 00:08:16,950
،لذا لا أظنّكِ تتذكّرين

127
00:08:16,950 --> 00:08:19,570
لكن منذ زمن بعيد، كنّا معاً في الميتم

128
00:08:19,570 --> 00:08:20,560
ميتم؟

129
00:08:20,560 --> 00:08:23,980
من كان يتوقّع أن تتعيّن مانا-تشان في القوّةِ الخامسة؟

130
00:08:24,610 --> 00:08:25,800
لماذا؟

131
00:08:25,800 --> 00:08:28,860
لماذا تُقاتلننا؟

132
00:08:33,620 --> 00:08:35,140
أُمِرتُن؟

133
00:08:35,140 --> 00:08:35,910
بواسطة من؟

134
00:08:36,160 --> 00:08:37,320
بواسطة مورغانا-ساما

135
00:08:38,800 --> 00:08:40,620
...مورغانا

136
00:08:44,190 --> 00:08:44,830
تسوبامي؟

137
00:08:46,080 --> 00:08:49,170
مورغانا... أهذا اسم زعيمتكن؟

138
00:08:51,230 --> 00:08:54,670
آسفة، علينا أن نأكل

139
00:08:57,060 --> 00:08:57,840
لا تتحرّكن

140
00:08:57,840 --> 00:08:58,760
ماذا؟

141
00:08:59,710 --> 00:09:02,520
كان من الصّعب حرق الذيل وحده

142
00:09:02,520 --> 00:09:04,390
وكان ذلك مخيفاً قليلاً أيضاً

143
00:09:14,060 --> 00:09:15,570
!كلّا

144
00:09:16,360 --> 00:09:17,950
!لا يجوز يا أكارا-تشين

145
00:09:19,920 --> 00:09:24,020
مانا وأكارا-تشين والأخريات
من نفس العالم

146
00:09:24,020 --> 00:09:26,020
من الغريب أن نتقاتل

147
00:09:27,820 --> 00:09:31,960
أعلم أنّكن عشتُن مع مانا
في نفس الميتم

148
00:09:31,960 --> 00:09:32,920
فلماذا أنتن...؟

149
00:09:35,810 --> 00:09:37,510
هذه هي حدودكن

150
00:09:43,120 --> 00:09:44,100
...الجميع

151
00:09:44,100 --> 00:09:44,890
...لماذا أنتن

152
00:09:45,470 --> 00:09:48,440
مديرة الزمكان جمعَتْنا كلّنا

153
00:09:48,820 --> 00:09:51,320
للقبضِ عليهن

154
00:09:57,280 --> 00:09:58,990
!هذا سيّئ! تفرّقن

155
00:10:05,810 --> 00:10:07,140
اختفين

156
00:10:07,140 --> 00:10:09,290
يبدو أنّهن أفلتن

157
00:10:09,290 --> 00:10:12,420
أردتُ أن أثأر منهن على إذلالنا
في ذلك اليوم

158
00:10:23,490 --> 00:10:28,440
صحيح أنّه رُفِعَ تقرير عن أشخاص مفقودين
منذ عشر سنوات من ذاك الميتم

159
00:10:28,980 --> 00:10:32,060
لكن لم يُعثَر على أي أثر لهن بعد ذلك

160
00:10:32,420 --> 00:10:35,980
من المستحيل أن تتمكّن الطفلات الثّلاث الصغيرات
من النجاةِ بمفردهن

161
00:10:36,560 --> 00:10:42,850
لهذا نعتقد أنَّ الأخوات الثّلاث قد اختفين
تماماً عن هذا العالم أيضاً. موشو

162
00:10:42,850 --> 00:10:46,520
...إذاً مورغانا التي كانت الأخوات الثّلاث تتحدّثن عنها

163
00:10:47,370 --> 00:10:47,910
تسوبامي؟

164
00:10:50,130 --> 00:10:51,230
...مورغانا

165
00:10:51,230 --> 00:10:52,880
...أتذكّر ذلك من مكانٍ ما

166
00:10:53,120 --> 00:10:55,880
الأرجح أنَّ أخوات أوريغامي الثّلاث قد أُخِذنَ
،إلى بُعدٍ آخر

167
00:10:56,230 --> 00:11:00,570
أو الفاصِل البُعدي، بواسطة جماعة مجهولة

168
00:11:00,570 --> 00:11:03,720
اختُطِفَن إلى بُعدٍ آخر؟

169
00:11:04,060 --> 00:11:06,600
...ومن ثمّ تمَّ تدريبهن كجنديّات

170
00:11:06,900 --> 00:11:08,850
!هذا... مستحيل

171
00:11:09,200 --> 00:11:12,520
إن تمَّ اختطافهن، فعلينا تأمينهن إذاً

172
00:11:12,810 --> 00:11:15,610
!يا فتيات، لننقذهن

173
00:11:15,840 --> 00:11:17,650
...أجل، لكن

174
00:11:17,650 --> 00:11:18,880
،حتّى لو أردنا إنقاذهن

175
00:11:18,880 --> 00:11:21,360
...سيستمررن في مُهاجمتنا

176
00:11:21,570 --> 00:11:22,750
...لكن

177
00:11:24,370 --> 00:11:25,490
...لكن

178
00:11:28,740 --> 00:11:30,770
أظنُّنا علينا الذهاب من دون طعام ثانية

179
00:11:34,110 --> 00:11:35,210
أنا جائعة

180
00:11:37,770 --> 00:11:39,090
!حسناً

181
00:11:39,360 --> 00:11:41,240
ستفعل هينا شيئاً

182
00:11:45,350 --> 00:11:48,240
أشعر بدُوار بعض الشيء

183
00:11:51,830 --> 00:11:55,940
لن أجد طعاماً بسهولة، صحيح؟

184
00:11:56,580 --> 00:11:57,440
عُلِم

185
00:11:57,850 --> 00:11:59,910
قالت الجميع أنّهن عجِزن عن إيجادهن

186
00:11:59,910 --> 00:12:01,240
لقد هربن

187
00:12:06,050 --> 00:12:07,450
ستتمكّنين من رؤيتهن ثانية

188
00:12:07,890 --> 00:12:10,580
أكارا-تشين والأخريات ستفهمن في نهاية المطاف، صحيح؟

189
00:12:11,050 --> 00:12:12,180
أجل

190
00:12:12,180 --> 00:12:14,880
أتساءل ما إن كنّا سنجد وسيلةً لإقناعهن

191
00:12:20,850 --> 00:12:22,800
سقطَتْ إحداهن هناك

192
00:12:26,310 --> 00:12:28,340
أفرطتُ في الأكل

193
00:12:28,340 --> 00:12:29,140
شكراً

194
00:12:29,560 --> 00:12:31,230
كان ذلك لذيذاً

195
00:12:31,230 --> 00:12:33,250
بالفعل، أليس كذلك؟

196
00:12:33,250 --> 00:12:36,480
كان الطبق الخاصّ بالكيزينير ساجيما-سان
شريحة لحم خاصّة وأرزّ

197
00:12:36,930 --> 00:12:39,590
ولا أصدِّق أنّها كانت تتضوّر جوعاً

198
00:12:39,590 --> 00:12:42,420
أحضرناها إلى هنا لذا ماذا تريدين أن تفعلي؟

199
00:12:42,420 --> 00:12:44,700
ينبغي أن نحصل على معلوماتٍ منها بطريقةٍ ما

200
00:12:45,010 --> 00:12:46,490
أجل

201
00:12:46,490 --> 00:12:48,660
معلومات عن مورغانا أيضاً

202
00:12:49,120 --> 00:12:50,750
لدينا المزيد

203
00:12:50,750 --> 00:12:51,970
شكراً لكِ

204
00:12:51,970 --> 00:12:52,950
شبِعت الآن

205
00:12:53,280 --> 00:12:56,290
هذه أوّل مرّة أتناول فيها شرائح لحم
بهذه اللذّة

206
00:12:57,060 --> 00:12:59,130
أهذه هي قاعدتكن إذاً؟

207
00:12:59,380 --> 00:13:00,800
تُدعى إيتيرنو؟

208
00:13:00,800 --> 00:13:02,490
أتنوين الهرب؟

209
00:13:02,490 --> 00:13:04,070
فات الأوان

210
00:13:05,540 --> 00:13:07,930
اتّصلتُ بأوني وكوري

211
00:13:07,930 --> 00:13:09,040
ماذا؟

212
00:13:09,040 --> 00:13:11,430
يبدو أنّها الباتوري الخاصّة بنا

213
00:13:18,020 --> 00:13:20,350
أكاري-تشين، كوري-تشين

214
00:13:20,350 --> 00:13:21,900
كيف دخلتُما إلى إيتيرنو؟

215
00:13:25,060 --> 00:13:27,570
إذا استعرنا قدرات مورغانا-ساما

216
00:13:27,840 --> 00:13:29,450
من مورغانا؟

217
00:13:29,930 --> 00:13:32,620
تتحكّم مورغانا-ساما بالجميع

218
00:13:33,100 --> 00:13:34,880
!أكارا-تشين، توقّفي

219
00:13:34,880 --> 00:13:37,210
تذكّري الأيّام التي كنّا نلعبُ فيها في الميتم

220
00:14:08,250 --> 00:14:13,440
تعني أوامر مورغانا-ساما كلّ شيء
بالنسبة إلينا

221
00:14:13,440 --> 00:14:17,580
وتلك الأوامر هي القضاء على ألتاير تورتي

222
00:14:18,240 --> 00:14:19,620
وجدتها

223
00:14:19,620 --> 00:14:22,100
مانا ستقاتلكِ يا أكارا-تشين

224
00:14:22,100 --> 00:14:22,580
ماذا؟

225
00:14:22,580 --> 00:14:23,600
مانا-تشان؟

226
00:14:23,600 --> 00:14:26,620
لكن بالمقابل، إن ربِحنا

227
00:14:26,620 --> 00:14:28,050
أريدُكن أن تتوقّفن عن ارتكاب أفعال شرّيرة

228
00:14:28,610 --> 00:14:30,960
ماذا؟ ماذا تقولين؟

229
00:14:30,960 --> 00:14:32,770
لن نخسر

230
00:14:49,060 --> 00:14:51,560
لقد أكلتا كثيراً من الطعام

231
00:14:51,560 --> 00:14:53,660
،إنّهن غامضات جدّاً

232
00:14:53,660 --> 00:14:56,170
لكن الجميع لديهن شهيّة كبيرة للجوع

233
00:14:56,170 --> 00:14:56,910
طبق ثانٍ

234
00:14:57,360 --> 00:14:59,290
...كان على مانا أن تقول كلّ ذلك الكلام

235
00:14:59,720 --> 00:15:01,470
،لو كان هدفهم هو نحن

236
00:15:01,470 --> 00:15:03,960
فعلينا أن نحسم هذه المسألة عاجلاً أم آجلاً

237
00:15:04,530 --> 00:15:08,800
لا أعتقد أنّ تلك الأخوات سيّئات ضمنيّاً

238
00:15:08,800 --> 00:15:13,640
أجل، لا يمكن أن يكون أحد سيّئاً إن كان يأكل بهذه البهجة

239
00:15:14,130 --> 00:15:16,060
شكراً للجميع

240
00:15:16,060 --> 00:15:19,280
...لكن لم نستطع فعل شيء ضدّ أماني-تشين وحدها

241
00:15:19,280 --> 00:15:20,860
هل يمكننا أن نفوز فعلاً؟

242
00:15:22,540 --> 00:15:24,210
"لا تفكّري بـ"الإمكانيّة

243
00:15:24,210 --> 00:15:25,700
سنفوز

244
00:15:25,700 --> 00:15:28,740
مانا، تريدين التقرّب من أولئك الثّلاث ثانية، صحيح؟

245
00:15:30,180 --> 00:15:31,150
أجل

246
00:15:32,860 --> 00:15:34,780
مبارزة؟

247
00:15:35,170 --> 00:15:37,540
أجل، اسمحي بذلك أرجوكِ

248
00:15:37,860 --> 00:15:40,080
أرجوكِ يا تيرا-سينسي

249
00:15:40,080 --> 00:15:41,380
أرجوكِ

250
00:15:41,380 --> 00:15:42,040
!سينسي

251
00:15:42,410 --> 00:15:45,880
لن أسمح لكُن بالانتشارِ لأسبابٍ شخصيّةٍ كهذه

252
00:15:46,210 --> 00:15:47,370
!سينسي

253
00:15:47,370 --> 00:15:48,630
...لكن

254
00:15:49,120 --> 00:15:50,590
وعدتُن، صحيح؟

255
00:15:51,410 --> 00:15:54,200
لا يجوز أن تنكثن بوعودكن

256
00:15:55,570 --> 00:15:58,330
،سأسمح بذلك كظرف استثنائي هذه المرّة

257
00:15:58,330 --> 00:16:01,060
لكن من فضلكن لا تُجهِدن أنفسكن كثيراً

258
00:16:01,570 --> 00:16:02,810
!حاضر

259
00:16:08,710 --> 00:16:11,200
هذه هي هالة المبارزة

260
00:16:11,200 --> 00:16:12,000
أجل

261
00:16:12,000 --> 00:16:13,570
لقد أتين

262
00:16:18,690 --> 00:16:21,910
أشكركن على توفيرِ العناء علينا

263
00:16:24,900 --> 00:16:26,500
يا فتيات، هيّا بنا

264
00:16:27,500 --> 00:16:28,670
هيّا بنا

265
00:16:30,460 --> 00:16:31,260
إنّهن سريعات

266
00:16:43,250 --> 00:16:44,400
!تسوبامي-تشان

267
00:16:44,400 --> 00:16:46,730
لا وقت لديكن للقلقِ على أحد آخر

268
00:16:50,050 --> 00:16:52,320
هل كان من الآمن حقّاً منحهن الإذن
بالقيامِ بهذا، موشو؟

269
00:16:52,680 --> 00:16:56,320
لم تكن هنالك وسيلة أخرى لمعرفة
هدف أخوات أوريغامي الثّلاث

270
00:16:56,740 --> 00:16:59,920
وأيضاً أريد مُساعدتهن إن أمكن

271
00:16:59,920 --> 00:17:01,700
أولئك الأخوات الثّلاث، موشو؟

272
00:17:02,210 --> 00:17:04,540
...أنا متأكّدة أنَّ أولئك الفتيات

273
00:17:05,090 --> 00:17:08,250
كُنَّ ليكونن أسعد لو ترعرعنَ في هذا العالم

274
00:17:13,000 --> 00:17:15,050
أصبحتُن تُدركن فارق القوّة بيننا، صحيح؟

275
00:17:15,590 --> 00:17:17,010
نُدرِك

276
00:17:17,010 --> 00:17:19,260
لكن لم نخسر بعد

277
00:17:19,590 --> 00:17:20,790
...في الواقع

278
00:17:20,790 --> 00:17:23,390
لن نقبل بخسارةِ هذه المعركة

279
00:17:23,970 --> 00:17:24,980
...أنتن

280
00:17:30,300 --> 00:17:32,900
لأنّكِ وعدتِ أنَّنا إن ربِحنا يا أكارا-تشين

281
00:17:32,900 --> 00:17:36,450
فلن تفعلي أي شيء سيّئ بعد الآن

282
00:17:49,320 --> 00:17:53,870
سنفعل أي شيء لأجلِ مورغانا-ساما
فقد أنقذتنا

283
00:17:53,870 --> 00:17:56,170
المزيد من الكلام سيكون هدراً للوقت

284
00:17:56,540 --> 00:17:57,260
لنقضِ عليهن

285
00:17:57,700 --> 00:17:59,730
نـ-نعم يا أوني

286
00:18:02,660 --> 00:18:04,020
أكاري-تشين

287
00:18:06,980 --> 00:18:08,070
...لا أريد هذا

288
00:18:08,070 --> 00:18:11,560
!لا أريد هذا إطلاقاً

289
00:18:12,020 --> 00:18:13,070
مانا-تشان

290
00:18:15,570 --> 00:18:16,780
...لا

291
00:18:17,280 --> 00:18:20,000
لا أريد أن يحدث هذا مجدّداً

292
00:18:23,360 --> 00:18:24,420
ما الذي يجري؟

293
00:18:25,110 --> 00:18:26,450
لا أصدِّق هذا، موشو

294
00:18:26,820 --> 00:18:30,670
بُعد مختلف يقتحم الحدود البُعديّة، موشو

295
00:18:32,050 --> 00:18:32,880
...السّماء هي

296
00:18:33,160 --> 00:18:34,160
!الأرض؟...

297
00:18:34,160 --> 00:18:35,090
ما الذي يحدث؟

298
00:18:42,340 --> 00:18:45,090
عادت الحدود إلى طبيعتها، موشو

299
00:18:46,090 --> 00:18:49,600
...كان بعدٌ آخر يقتحم... هذا مستحيل

300
00:18:51,270 --> 00:18:51,940
!تسوبامي

301
00:18:52,640 --> 00:18:54,700
أوني، ماذا كان ذلك؟

302
00:18:56,340 --> 00:18:58,860
لقد وجدتُكن أخيراً

303
00:19:05,750 --> 00:19:06,850
مورغانا؟

304
00:19:06,850 --> 00:19:08,040
...هذه

305
00:19:09,570 --> 00:19:11,580
مور... غانا...؟

306
00:19:12,300 --> 00:19:15,340
هربتُن إلى هذا البُعد إذاً

307
00:19:17,740 --> 00:19:24,320
عرفتُ أنّكن ستظهرن يوماً ما إذا استخدمتُ
هذه الفتيات لإطلاق الأوبلي

308
00:19:27,920 --> 00:19:34,060
أكارا-سان، هينا-سان، كوري-سان، أحسنتُن صنعاً

309
00:19:34,820 --> 00:19:37,490
انتهت فائدتكن

310
00:19:37,490 --> 00:19:39,190
!ماذا يعني هذا؟

311
00:19:39,660 --> 00:19:41,700
لم أعد بحاجةٍ إليكن بعد الآن

312
00:19:41,940 --> 00:19:43,210
!ماذا؟

313
00:19:47,040 --> 00:19:50,130
من الأفضل استخدام شيء من العالمِ المقصود

314
00:19:50,130 --> 00:19:53,210
لإيجاد شيء هربَ إلى ذاك العالم، صحيح؟

315
00:19:53,810 --> 00:19:56,210
...قضينا عشر سنوات لأجلِ ذلك إذاً

316
00:19:56,620 --> 00:20:02,430
عشر سنوات بالنسبة للبشر هي كطرفة عين بالنسبة لي

317
00:20:02,690 --> 00:20:05,350
وماذا يُفترَض بنا أن نفعل الآن؟

318
00:20:08,100 --> 00:20:12,230
لا يهمّني ما يحلُّ بكن

319
00:20:16,020 --> 00:20:17,460
لا جدوى

320
00:20:19,130 --> 00:20:22,610
أستطيع توقُّع كافّة الظواهر

321
00:20:22,890 --> 00:20:24,660
!ها يكفي

322
00:20:30,180 --> 00:20:31,080
!أوديلي

323
00:20:31,820 --> 00:20:32,620
ما هذا؟

324
00:20:33,330 --> 00:20:36,880
رأيتُ إشارةَ موشور ستيلّا قويّة جدّاً وأتيتُ لأرى

325
00:20:36,880 --> 00:20:38,210
كنتِ أنتِ، أليس كذلك؟

326
00:20:38,510 --> 00:20:39,440
من أنتِ؟

327
00:20:39,440 --> 00:20:40,300
لا أدري

328
00:20:40,300 --> 00:20:42,880
!أعطيني موشور ستيلّا خاصّتكِ

329
00:20:45,910 --> 00:20:47,510
من أنتِ بالضبط؟

330
00:20:50,610 --> 00:20:52,180
أنا هنا

331
00:20:52,180 --> 00:20:53,160
سأتجاوز قليلاً

332
00:20:53,160 --> 00:20:55,940
فارس البجعة السّوداء، أوديلي

333
00:20:56,420 --> 00:21:00,200
...من كان يتوقَّع أن تحدث أمور لم أتوقّعها

334
00:21:01,770 --> 00:21:02,980
عظيم

335
00:21:03,620 --> 00:21:05,070
سأنسحب

336
00:21:08,630 --> 00:21:10,050
!انتظري

337
00:21:10,050 --> 00:21:11,490
!لن أدعكِ تفلتين

338
00:21:11,490 --> 00:21:15,220
!أعطيني موشوركِ

339
00:21:17,940 --> 00:21:21,050
لم تعد بحاجةٍ إلينا بعد الآن؟

340
00:21:21,410 --> 00:21:24,170
ماذا ينبغي أن نفعل؟

341
00:21:26,530 --> 00:21:28,030
لا داعي للقلق

342
00:21:28,940 --> 00:21:32,110
لنذهب إلى إيتيرنو مع مانا والأخريات

343
00:21:32,110 --> 00:21:34,930
أنا متأكّدة أنَّ الأخريات
...سيُصبحن أصدقائكن فو

344
00:21:50,670 --> 00:21:53,490
...قد لا يحدث ذلك فوراً، لكن

345
00:21:54,980 --> 00:21:55,830
أجل

346
00:21:56,340 --> 00:22:00,080
ستُصبح مانا صديقتهن

347
00:22:00,530 --> 00:22:01,540
أجل