1
00:00:14,530 --> 00:00:16,000
!نجحنا

2
00:00:16,000 --> 00:00:16,860
!انتهى الشوط

3
00:00:16,860 --> 00:00:17,850
!ياغينوما-سان

4
00:00:17,850 --> 00:00:18,870
!إيو-ساما

5
00:00:23,170 --> 00:00:25,700
هذه ياغينوما-سينباي التي عهِدناها

6
00:00:25,700 --> 00:00:28,360
الجميع متحمِّسون زيادة عن اللّزوم لمباراة
تمرينيّة بسيطة

7
00:00:29,330 --> 00:00:30,760
أماني

8
00:02:13,060 --> 00:02:15,320
معركة فِرَق

9
00:02:15,750 --> 00:02:19,520
،ستكون المشاركة الأولى لألتاير تورتي

10
00:02:19,520 --> 00:02:22,660
لهذا سنقدّمُ شرحاً خاصّاً

11
00:02:22,660 --> 00:02:24,030
حسناً، ما هو هذا؟

12
00:02:24,570 --> 00:02:28,660
سهرتُ اللّيلَ كلّه كي تفهمنه بشكلٍ أفضل

13
00:02:29,060 --> 00:02:30,980
!رائع

14
00:02:30,980 --> 00:02:33,630
ألن يكون من الأفضل أن تطبعي
...منشورات فحسـ

15
00:02:33,630 --> 00:02:34,640
لنبدأ

16
00:02:34,640 --> 00:02:36,990
حان وقتُ البدء

17
00:02:39,330 --> 00:02:41,620
مسرحيّة ورقيّة؟

18
00:02:41,620 --> 00:02:43,390
أنا متأكّدةٌ أنّها أرادَتْ فعل هذا فحسب

19
00:02:43,830 --> 00:02:48,260
نقيمُ معاركَ مُحاكية دوريّة بين الفرق
في القوّةِ الخامسة

20
00:02:48,260 --> 00:02:51,150
لتحسين قدراتنا القتاليّة

21
00:02:51,150 --> 00:02:54,770
ستُقام المُباريات في منطقةٍ خاصّة
،في الفضاء البُعدي الخامس

22
00:02:54,770 --> 00:02:57,070
وستُعدَّلُ تلك المنطقة في كلّ مُباراة

23
00:02:58,000 --> 00:03:01,290
،ستشتبك أربعة فِرَق في حدَثٍ دوريّ

24
00:03:01,290 --> 00:03:03,450
ويُحدَّدُ المنتصر بواسطة عدد الانتصارات
في كلّ مباراة

25
00:03:03,920 --> 00:03:04,450
ماذا؟

26
00:03:05,370 --> 00:03:06,870
حدَث دوريّ

27
00:03:07,280 --> 00:03:09,110
هل حدثَ وأن جرّبتموه؟

28
00:03:09,870 --> 00:03:12,040
لقد سئمتُ من هذا

29
00:03:12,040 --> 00:03:14,290
لماذا تتكلّمين بلهجةِ كانساي-بين فجأة؟

30
00:03:15,520 --> 00:03:16,880
ربّما لأنّها تلاعبَتْ بالألفاظ؟

31
00:03:16,880 --> 00:03:18,590
ستقعين في فخِّها إن قلتِ أي كلمة

32
00:03:18,980 --> 00:03:20,850
...مـ-موشو

33
00:03:21,700 --> 00:03:23,300
!أشعرُ بالاستياء الآن

34
00:03:24,290 --> 00:03:25,990
القواعد بسيطة

35
00:03:25,990 --> 00:03:29,090
الفريق الذي يهزمُ أعضاء الفريق الآخر يربح

36
00:03:29,090 --> 00:03:31,030
...الأعضاء

37
00:03:31,030 --> 00:03:33,020
إذاً هذا يعني أنَّنا نربح ولو بقيَتْ
عضوة واحدة فقط

38
00:03:37,610 --> 00:03:38,980
!موشو

39
00:03:39,360 --> 00:03:42,240
...من يُفترَض أن يكون هذا

40
00:03:43,140 --> 00:03:48,250
سنستخدم ميموكا خاصّة تحدُّ من الضرر
الذي نتلقَّاه

41
00:03:48,250 --> 00:03:49,450
لذا لا تقلقن

42
00:03:49,970 --> 00:03:51,350
ميموكا خاصّة؟

43
00:03:54,630 --> 00:03:56,130
ما الأمر يا إيو؟

44
00:03:56,130 --> 00:03:57,650
هل أنتِ بخير؟

45
00:03:57,650 --> 00:03:58,610
...لا أستطيع

46
00:04:03,580 --> 00:04:06,140
!الأفرو مضحكة للغاية

47
00:04:06,740 --> 00:04:09,760
أعتقد أنَّ إيو-تشين قد راقَها الأفرو

48
00:04:09,760 --> 00:04:10,640
أجل

49
00:04:11,060 --> 00:04:12,800
،حسناً يا فتيات

50
00:04:12,800 --> 00:04:15,520
هل فهمتُم كيف ستُقامُ معركةُ الفِرَق؟

51
00:04:16,220 --> 00:04:18,440
،أنا قلقةٌ قليلاً

52
00:04:18,440 --> 00:04:19,650
لكن فهمت

53
00:04:20,900 --> 00:04:21,400
...في هذه الحالة

54
00:04:24,900 --> 00:04:32,740
حان الوقتُ الآن للقصّة الدراميّة الكوميديّة
الأصليّة التي قضيتُ شهراً على تأليفها

55
00:04:37,250 --> 00:04:38,250
ماذا؟

56
00:04:38,440 --> 00:04:40,710
!مرحى! مرحى

57
00:04:48,030 --> 00:04:50,180
كان فِلماً طويلاً جدّاً

58
00:04:50,180 --> 00:04:53,600
أنا واثقةٌ أنَّ تيرا-سينسي أرادتْ
فعلها بدلاً من ذلك

59
00:04:53,950 --> 00:04:58,150
النكات المُستحدثة التي وردَتْ
كانت مُضحكة جدّاً أحياناً

60
00:04:59,370 --> 00:05:00,900
قضَتْ مانا وقتاً ممتعاً

61
00:05:02,410 --> 00:05:05,620
لكن سنخوضُ معركةَ فِرَق، صحيح؟

62
00:05:05,620 --> 00:05:08,700
قد تكون فُرصة جيّدة لنرى كم أصبحنا قويّات

63
00:05:09,960 --> 00:05:13,870
!ربّما من المُمكن أن نكون الفريق الأقوى

64
00:05:14,310 --> 00:05:15,570
...الأقوى

65
00:05:15,570 --> 00:05:17,170
يبدو هذا جيّداً

66
00:05:17,170 --> 00:05:18,370
!مرحى

67
00:05:18,370 --> 00:05:20,290
!تريد مانا أن تكون الأقوى أيضاً

68
00:05:20,640 --> 00:05:24,300
حسناً، بصرفِ النّظر عن ذلك، لنفعل
ما بوسعنا، اتّفقنا؟

69
00:05:25,300 --> 00:05:26,900
!نعم

70
00:05:46,320 --> 00:05:48,380
!انتهت المُباراة

71
00:05:48,910 --> 00:05:51,600
،المُباراة الأولى من معركة الفِرَق

72
00:05:51,600 --> 00:05:54,370
كوكونات فيغا ضدّ ألتاير تورتي

73
00:05:54,370 --> 00:05:56,870
الرّابح: كوكونات فيغا

74
00:06:01,520 --> 00:06:03,940
هكذا تكون المُحاولة الأولى عادة

75
00:06:03,940 --> 00:06:05,550
لا تحزني كثيراً من ذلك

76
00:06:05,920 --> 00:06:07,030
نـ-نعم

77
00:06:12,970 --> 00:06:16,930
ياغينوما إيو، خسرتِ بطريقةٍ سيّئة جدّاً

78
00:06:19,550 --> 00:06:22,310
كان ذلك مُحرِجاً للغاية

79
00:06:24,090 --> 00:06:28,800
أنتِ مختلفةٌ تماماً عمّا كنتِ عليه
في مُباراة كرةِ الطائرة التمرينيّة تلك

80
00:06:28,800 --> 00:06:29,530
ماذا؟

81
00:06:29,790 --> 00:06:31,740
كنتِ تتفرّجين؟

82
00:06:31,740 --> 00:06:33,010
شكراً لكِ

83
00:06:34,200 --> 00:06:37,060
كنتُ مجرّد عابرة فحسب

84
00:06:37,060 --> 00:06:39,620
لا تهمّني مبارياتكِ إطلاقاً

85
00:06:39,980 --> 00:06:43,750
إ-إضافة إلى ذلك، تُقاتلن كفريق في كرةِ الطائرة

86
00:06:43,750 --> 00:06:47,400
لذا لا تعتقدي أنّكِ ربحتِ بمفردكِ

87
00:06:47,990 --> 00:06:49,550
أجل، هذا صحيح

88
00:06:49,960 --> 00:06:53,480
ربِحنا لأنَّ زميلاتي في الفريقِ فعلنَ ما بوسعهن

89
00:06:54,060 --> 00:06:55,970
يسرُّني أنّكِ فهمتِ

90
00:06:57,230 --> 00:06:59,140
...أنا لستُ

91
00:07:00,220 --> 00:07:04,340
على أي حال، أريدكِ أن تفعلي ما بوسعكِ
عندما تُقاتلينني

92
00:07:04,340 --> 00:07:05,250
ماذا؟

93
00:07:05,250 --> 00:07:07,530
لماذا خسرتِ بهذا الشكل؟

94
00:07:08,000 --> 00:07:09,820
أنا واثقةٌ أنّكِ لم تكوني تُحاولين الفوز

95
00:07:10,610 --> 00:07:12,490
لا، كنتُ كذلك صدّقيني

96
00:07:13,040 --> 00:07:18,360
لا أصدِّقُ أنَّ هذا كلّ ما لدى ياغينوما إيو

97
00:07:28,240 --> 00:07:30,260
المرتبة الأولى: بيسكيت سيريوس

98
00:07:30,650 --> 00:07:32,690
الثّانية: كوكونات فيغا

99
00:07:32,690 --> 00:07:34,340
الثّالثة: بروكيون بودينغ

100
00:07:34,990 --> 00:07:37,060
الرّابعة: ألتاير تورتي

101
00:07:37,330 --> 00:07:40,680
حسناً، هذه هي النتيجة المُتوقَّعة

102
00:07:41,240 --> 00:07:42,060
أجل

103
00:07:49,780 --> 00:07:54,320
أعتقدُ أنَّنا خسِرنا لأنَّنا طُوِّقنا
عندما انفصلنا عن بعضِنا البعض

104
00:07:54,610 --> 00:07:57,120
ليسَ عدلاً أن تهاجمنا كلتاهما

105
00:07:57,540 --> 00:08:02,160
أعتقد أنَّ خطّة المواجهة الفرديّة قد انقلبَتْ علينا

106
00:08:02,560 --> 00:08:04,790
أعطى ذلك أفضليّة لخصومنا

107
00:08:05,920 --> 00:08:09,870
أعتقدُ أنَّ الفرق هنا هو الخبرة

108
00:08:14,650 --> 00:08:17,280
لا، لدينا فُرصة

109
00:08:17,280 --> 00:08:18,560
فُرصة مُتاحة بقوّة أمامنا

110
00:08:23,380 --> 00:08:30,000
سيتمكّن خصومنا من اكتشاف أي استراتيجيّة
أساسيّة ننفّذها، أليس كذلك؟

111
00:08:30,610 --> 00:08:35,860
لهذا سنُحاول التفوُّق عليهن بذكائنا وذلك
باستخدام خطّة لن تخطر على ذهنِهن

112
00:08:36,480 --> 00:08:37,730
هكذا إذاً

113
00:08:37,730 --> 00:08:41,840
قد تكون هذه هي الوسيلة الوحيدة
التي بمُتناول يدنا الآن

114
00:08:41,840 --> 00:08:43,250
!أحسنتِ يا إيو-تشين

115
00:08:43,790 --> 00:08:48,390
أجل، لكن لم أرسم أي خطّة حقيقيّة بعد

116
00:08:48,750 --> 00:08:51,530
خطّة لا تخطر على ذهنهن؟

117
00:08:53,660 --> 00:08:55,700
يبدو أنَّ الوقت قد حان لنا

118
00:08:55,700 --> 00:08:59,940
لتطبيق الخطّة الرَّائعة جدّاً التي رسمتُها سرّاً

119
00:09:12,580 --> 00:09:13,240
!مانو

120
00:09:13,600 --> 00:09:14,440
—تبّاً

121
00:09:17,820 --> 00:09:19,710
!!انتهت المباراة

122
00:09:19,710 --> 00:09:21,830
معركة الفِرَق، المباراة الثّانية

123
00:09:22,230 --> 00:09:25,580
الرّابح هو فريق بروكيون بودينغ

124
00:09:26,360 --> 00:09:27,720
أحسنتُن

125
00:09:28,510 --> 00:09:32,170
لا يجوز أن نبقى في المركز الثّالث للأبد

126
00:09:33,090 --> 00:09:35,590
بعد كلّ ما قلتُه أيضاً

127
00:09:38,440 --> 00:09:43,490
ستكون المُباراة التّالية ضدّ سيريوس، الذي في المركز
الأوَّل، وتورتي الذي في المركز الرّابع. موشو

128
00:09:43,490 --> 00:09:47,640
أجل، قال فريق تورتي أنَّ لديهن خطّة مميّزة

129
00:09:49,200 --> 00:09:51,110
يبدو هذا ممتعاً، موشو

130
00:09:53,190 --> 00:09:55,720
حسناً، المُباراة الثّانية لهذا اليوم

131
00:09:55,720 --> 00:09:59,620
بيسكيت سيريوس ضدّ ألتاير تورتي

132
00:09:59,900 --> 00:10:01,410
!حان وقتُ البدء، موشو

133
00:10:05,790 --> 00:10:07,120
ما الذي يجري؟

134
00:10:07,120 --> 00:10:07,710
...ماذا

135
00:10:08,360 --> 00:10:09,630
دُخان؟

136
00:10:10,580 --> 00:10:11,860
...نيهو-ساما

137
00:10:12,640 --> 00:10:15,410
يُحاولن استدراجنا بالدخان إذاً؟

138
00:10:15,410 --> 00:10:16,720
إنّهن يستهنّ بنا حقّاً

139
00:10:26,290 --> 00:10:28,730
أعددنا فخَّ جهة الرِّياح هذا بإتقان

140
00:10:29,020 --> 00:10:33,400
نعم، يسرُّني أنَّنا حظينا بهذه المنطِقة
في مُباراتنا

141
00:10:33,840 --> 00:10:36,610
يسرُّني أنَّنا لدينا أشجّارٌ حيّة لبعثِ الدُّخان

142
00:10:38,760 --> 00:10:42,320
ينبغي أن يتجنّبن السّير عكس جهة الرّياح
لتجنُّب الدُّخان

143
00:10:42,610 --> 00:10:45,290
!حينئذ سننصب لهن كميناً

144
00:10:45,540 --> 00:10:51,540
أسمِّي هذه الخطّة الفائقة "نار المخيّم الحارِقة: الرّقصة
"الشعبيّة التي يمكننا التمتُّع بها لاحقاً

145
00:10:52,690 --> 00:10:54,930
هذا اسمٌ طويلٌ جدّاً

146
00:10:55,620 --> 00:10:59,260
!يومي-تشين، إنّها دخانيّة قليلاً، لكنّها فكرة سديدة

147
00:11:01,670 --> 00:11:06,390
!المخطِّطة العظمى لألتاير تورتي، ساجيما تعتلي المشهد

148
00:11:06,660 --> 00:11:09,100
حسناًن حان الوقتُ للتمركُز في مواقعنا

149
00:11:09,440 --> 00:11:10,730
!عُلِم

150
00:11:12,930 --> 00:11:13,680
ماذا؟

151
00:11:13,680 --> 00:11:14,690
ما الذي يجري؟

152
00:11:16,770 --> 00:11:18,770
يأتي الدُّخان نحونا

153
00:11:18,770 --> 00:11:21,700
يبدو أنَّ جهة الرّياح قد تغيّرَتْ

154
00:11:22,580 --> 00:11:24,700
!لا يجوز أن يحدث هذا

155
00:11:25,050 --> 00:11:26,870
عينايّ تحكّاني

156
00:11:27,310 --> 00:11:28,250
مستحيل

157
00:11:28,250 --> 00:11:31,580
ينبغي أن تكون إيو-تشان قد حسبَت حركة الرّياح جيّداً

158
00:11:43,530 --> 00:11:44,600
...هذا

159
00:11:49,010 --> 00:11:50,930
بيسكيت سيريوس

160
00:11:54,450 --> 00:11:56,950
آسفة، لكن ماتَ الشّاه

161
00:12:01,330 --> 00:12:04,490
!مستحيل

162
00:12:19,850 --> 00:12:23,130
تمكنَّ من إفشالِ خطّتنا بلمحِ البصر

163
00:12:23,340 --> 00:12:25,790
لا عجب في أنّهن الفريق الأقوى

164
00:12:25,790 --> 00:12:29,030
نحن الأضعف

165
00:12:29,030 --> 00:12:32,200
ماذا ينبغي أن نفعل الآن أيّتها المخطِّطة؟

166
00:12:33,900 --> 00:12:35,830
...نعم

167
00:12:38,390 --> 00:12:40,830
تُقاتلن كفريقٍ في كُرة الطائرة

168
00:12:41,910 --> 00:12:44,410
!اتبعنني جميعاً

169
00:12:46,490 --> 00:12:47,950
نعم، هذا جيّد

170
00:12:48,690 --> 00:12:50,790
لكن احرصن على عدمِ إطباقِ أصابعكن على بعضها

171
00:12:50,790 --> 00:12:52,250
لا داعي للقلق

172
00:12:52,460 --> 00:12:54,120
ها أنا ذي

173
00:12:56,310 --> 00:12:57,670
هل أنتِ بخير يا مانا-تشان؟

174
00:12:58,440 --> 00:13:01,330
تمكّنت من تمرير الكرة

175
00:13:01,330 --> 00:13:02,930
موهبة خفيّة

176
00:13:02,930 --> 00:13:05,430
يكفي يا يومي-تشين

177
00:13:05,900 --> 00:13:07,640
آسفة بشأن ذلك

178
00:13:10,700 --> 00:13:12,530
أنا مُتعبة

179
00:13:12,530 --> 00:13:15,520
أجوع عندما أتمرّن

180
00:13:16,580 --> 00:13:19,560
نحن نفكِّرُ دوماً بلطعام يا ساتوكا-تشان

181
00:13:19,960 --> 00:13:22,790
أحبُّ الطعام اللّذيذ

182
00:13:23,680 --> 00:13:26,070
حسناً، ما الخطّة التي سننفّذها هذه المرّة؟

183
00:13:26,610 --> 00:13:27,410
...في الواقع

184
00:13:30,670 --> 00:13:32,860
لم أفكِّر بها مليّاً

185
00:13:33,860 --> 00:13:36,160
ولماذا كُرة طائرة فجأة؟

186
00:13:37,740 --> 00:13:43,130
في الحقيقة، كنتُ أقولُ أنَّ العمل كفريق هو الميّزة
الأهمّ بالنسبة إلى ألتاير تورتي

187
00:13:43,630 --> 00:13:45,430
...التعاون كفريق

188
00:13:45,430 --> 00:13:48,210
،كُرة الطائرة هي لعبة جماعيّة أيضاً

189
00:13:48,210 --> 00:13:50,610
لهذا كنتُ أقول أنَّه قد يخطر
على ذهني فكرةٌ ما

190
00:13:51,410 --> 00:13:52,930
أعتقدُ أنَّ الأمر ليس بتلك السّهولة

191
00:13:52,930 --> 00:13:54,810
لا، هذا غير صحيح

192
00:13:55,410 --> 00:13:56,900
...كرة طائرة

193
00:13:56,900 --> 00:13:58,680
...تعاون جماعي

194
00:13:59,260 --> 00:14:00,110
!وجدتُها

195
00:14:04,760 --> 00:14:08,410
أنا المخطِّطة العظيمة، الاستراتيجيّة، ساجيما

196
00:14:08,410 --> 00:14:09,930
!الجنديّة ياغينوما

197
00:14:10,380 --> 00:14:11,160
سيادة النّقيب؟

198
00:14:11,730 --> 00:14:17,870
سمعتُ أنّ ضرباتكِ في كرة الطائرة قويّة للغاية

199
00:14:17,870 --> 00:14:19,350
نعم، على ما أعتقد

200
00:14:19,830 --> 00:14:23,960
يمكنكِ أن تسألي مانا عن إيو-تشين

201
00:14:24,320 --> 00:14:28,860
تصل سرعة ضربات إيو-تشين التفجيريّة
إلى 150 كم/سا

202
00:14:28,860 --> 00:14:30,840
هذا ما وردَ في قصاصة المجلّة هذه

203
00:14:31,410 --> 00:14:33,430
لماذا قصاصة؟

204
00:14:34,660 --> 00:14:39,840
أمتلِك كلّ شيء عنكِ سواء أكان ذلك
على الإنترنت أو الصّحف

205
00:14:39,840 --> 00:14:40,770
...هكذا إذاً

206
00:14:41,000 --> 00:14:44,000
لكن 150 كم/سا سرعة فائقة جدّاً

207
00:14:44,000 --> 00:14:47,160
لا يمكنُ رمي هذا على النّاس

208
00:14:47,160 --> 00:14:48,640
نعم، وجدتُها

209
00:14:49,800 --> 00:14:51,700
لمعركة الفِرَق؟

210
00:14:51,700 --> 00:14:53,160
تريديننا أن نستخدم كرة طائرة؟

211
00:14:53,440 --> 00:14:56,650
ضدّ سيوف وأسلحة ناريّة؟

212
00:14:56,650 --> 00:15:01,210
كنتُ أفكّرُ بالاستفادةِ من الكُرة الطائرة
...للتحسُّنِ في التعاونِ الجماعي، هذا كلّ شيء

213
00:15:01,950 --> 00:15:04,280
اهدأن

214
00:15:04,280 --> 00:15:06,840
...إن كانَتْ هذه الكرة قنبلة

215
00:15:09,770 --> 00:15:11,620
!الجنديّة سوميهارا

216
00:15:11,620 --> 00:15:12,590
حاضر؟

217
00:15:12,900 --> 00:15:14,810
،بصفتكِ المسؤولة عن تفجيرِ الأشياء

218
00:15:14,810 --> 00:15:18,480
فينبغي أن تكون قادِرة على حملِ أي متفجِّرات
بما في ذلك القنابل اليدويّة

219
00:15:18,820 --> 00:15:19,680
!هكذا إذاً

220
00:15:20,050 --> 00:15:21,190
يبدو هذا رهيباً

221
00:15:21,550 --> 00:15:25,110
!أسمِّي هذه بخطّة عاصفة ألتاير العظيمة

222
00:15:26,730 --> 00:15:28,580
!رائع

223
00:15:28,580 --> 00:15:29,360
أليس كذلك؟

224
00:15:29,360 --> 00:15:31,260
انتظرن لحظة

225
00:15:31,260 --> 00:15:36,340
لن تنفجر حالما أضربها، صحيح؟

226
00:15:40,630 --> 00:15:41,210
!ستكون الأمور على ما يُرام

227
00:15:41,730 --> 00:15:44,500
ما سبب ذلك التوقُّف؟

228
00:15:45,530 --> 00:15:47,210
!أنتن

229
00:15:53,040 --> 00:15:55,540
،حان الوقتُ أخيراً لحسم الأمور

230
00:15:55,540 --> 00:15:56,890
!يا ياغينوما إيو

231
00:15:57,370 --> 00:16:01,100
لن أدعكِ تفلتين بأداءٍ مخيِّب

232
00:16:01,470 --> 00:16:02,940
بالتأكيد. شكراً

233
00:16:05,460 --> 00:16:07,570
حسناً، فلنبدأ بهذا

234
00:16:08,070 --> 00:16:10,740
،المُباراة الأولى لهذا اليوم

235
00:16:11,060 --> 00:16:14,180
بروكيون بودينغ ضدّ ألتاير تورتي

236
00:16:14,180 --> 00:16:16,070
بدء المعركة. موشو

237
00:16:16,930 --> 00:16:19,590
هاروكا وساسا، حاصراهما

238
00:16:20,560 --> 00:16:22,830
كيف سيُهاجمن يا تُرى؟

239
00:16:23,600 --> 00:16:26,420
سنسحقهن مهما فعلن

240
00:16:30,150 --> 00:16:32,840
ما سرّ هذا اللّباس، موشو؟

241
00:16:32,840 --> 00:16:35,100
شعرتُ برغبةٍ بارتدائه فحسب

242
00:16:35,100 --> 00:16:36,390
ألا يليق بي؟

243
00:16:37,730 --> 00:16:39,510
لا تعليق. موشو

244
00:16:42,170 --> 00:16:43,020
المعذرة

245
00:16:43,300 --> 00:16:44,520
هل أنتِ بمفردكِ؟

246
00:16:45,460 --> 00:16:48,270
لن نتحفّظ حتّى لو كنتِ بمفردكِ

247
00:16:48,660 --> 00:16:49,910
ها أنا ذي

248
00:16:53,410 --> 00:16:54,920
اتركن الأمر لي

249
00:16:56,990 --> 00:17:00,740
الشفرة البيولوجيّة لكل عضو مسجّلة في الكرة

250
00:17:01,060 --> 00:17:02,400
نطحة جيّدة

251
00:17:02,400 --> 00:17:03,160
!تسوبامي-تشان

252
00:17:03,690 --> 00:17:06,170
يشحنّها بالترتيب

253
00:17:07,080 --> 00:17:07,920
ما الذي يجري؟

254
00:17:09,360 --> 00:17:10,250
!إيو

255
00:17:10,250 --> 00:17:11,130
!حسناً

256
00:17:10,250 --> 00:17:13,040
شحنها كافّة الأعضاء

257
00:17:13,040 --> 00:17:14,720
!عاصفة ألتاير

258
00:17:20,880 --> 00:17:22,390
...كانت تلك

259
00:17:22,390 --> 00:17:24,810
كرة طائرة، صحيح؟...

260
00:17:25,940 --> 00:17:27,100
!مهلاً أيّتها الحكم

261
00:17:27,100 --> 00:17:28,810
هل هذا مسموح؟

262
00:17:29,540 --> 00:17:31,100
...في الواقع

263
00:17:31,100 --> 00:17:32,790
لا مشكلة، موشو

264
00:17:32,790 --> 00:17:35,950
لقد اقتُرِحَ كسِلاح

265
00:17:38,210 --> 00:17:40,600
هذا ما يجعل الأمور ممتعة إذاً

266
00:17:40,600 --> 00:17:41,160
!أماني

267
00:17:42,770 --> 00:17:43,790
أنا هنا

268
00:17:44,550 --> 00:17:47,290
!حاولي أن تصيبيني يا ياغينوما إيو

269
00:17:47,710 --> 00:17:49,330
!بمفردها؟

270
00:17:49,330 --> 00:17:50,540
...ما الذي تخطِّط له

271
00:17:51,360 --> 00:17:52,300
...أماني-سان

272
00:17:53,140 --> 00:17:54,050
ها أنا ذي

273
00:17:56,580 --> 00:17:57,440
!خذي

274
00:17:59,280 --> 00:18:01,300
...تستخدمُ خطّةَ كرة طائرة

275
00:18:02,060 --> 00:18:02,600
!إيو

276
00:18:02,820 --> 00:18:04,640
!عاصفة ألتاير

277
00:18:13,820 --> 00:18:16,780
!هزمتُ عاصفةَ ألتاير خاصّتكِ

278
00:18:18,450 --> 00:18:19,450
...أماني-سان

279
00:18:20,020 --> 00:18:21,700
مستحيل

280
00:18:22,900 --> 00:18:25,510
هُزِمَتْ هجمتنا القاضية

281
00:18:25,510 --> 00:18:28,330
تمكّنَتْ من تحديد الاتّجاه الذي كانت
الكرة تسلكه

282
00:18:28,960 --> 00:18:30,580
!ياغينوما إيو

283
00:18:31,130 --> 00:18:34,170
تضربين كُرات منحنيّة قليلاً إلى اليمين

284
00:18:35,190 --> 00:18:37,510
هذه أوّل مرّة يُقالُ فيها لي ذلك

285
00:18:38,800 --> 00:18:40,860
لن أدعكِ تستخفِّين بنا

286
00:18:40,860 --> 00:18:42,970
لقد شاهدتُ كلّ مبارياتكِ

287
00:18:43,260 --> 00:18:45,140
!أعرف ما أراه بعيني

288
00:18:45,890 --> 00:18:47,350
كلّها؟

289
00:18:47,350 --> 00:18:49,390
ألم تكوني مجرّد عابرة؟

290
00:18:52,170 --> 00:18:53,820
...أماني

291
00:18:53,820 --> 00:18:55,900
تحبِّين إيو-سان، أليس كذلك؟

292
00:18:58,360 --> 00:19:00,130
!نحن نخوضُ مباراةً الآن

293
00:19:00,130 --> 00:19:03,030
!لا وقت للكلام عن ذلك

294
00:19:05,890 --> 00:19:07,330
ما هذا؟ ما الذي يجري؟

295
00:19:11,150 --> 00:19:12,320
...مستحيل

296
00:19:12,320 --> 00:19:13,520
...في المنطِقة القتاليّة

297
00:19:13,520 --> 00:19:16,130
.رُصِدَتْ إشارة أوبلي. موشو

298
00:19:16,530 --> 00:19:17,300
ماذا؟

299
00:19:20,500 --> 00:19:21,090
أوبلي

300
00:19:21,550 --> 00:19:23,190
هنالك اثنان منهما

301
00:19:24,670 --> 00:19:25,100
ماذا؟

302
00:19:26,050 --> 00:19:27,810
لا يمكننا فعلها بالأسلحة التمرينيّة

303
00:19:28,510 --> 00:19:29,310
!أماني

304
00:19:35,520 --> 00:19:36,940
!ساتوكا، الكرة

305
00:19:37,260 --> 00:19:38,790
!حـ-حسناً

306
00:19:45,480 --> 00:19:47,530
،سنُكسبكن الوقت

307
00:19:47,530 --> 00:19:48,830
لِذا أحضرن الميموكا القتاليّة

308
00:19:49,380 --> 00:19:50,370
!حسناً

309
00:19:50,370 --> 00:19:53,900
سنعود حالاً، لِذا ابقين بأمان

310
00:19:53,900 --> 00:19:54,580
نعم

311
00:19:55,380 --> 00:19:58,000
!لن أسامحكِ إن متِّ

312
00:19:59,940 --> 00:20:02,410
يا فتيات، استمررنَ في إرسالها نحوي

313
00:20:02,410 --> 00:20:03,090
ها أنا ذي

314
00:20:24,140 --> 00:20:25,120
!ساتوكا

315
00:20:25,120 --> 00:20:27,900
...نفدت كراتنا

316
00:20:27,900 --> 00:20:28,370
ماذا؟

317
00:20:30,260 --> 00:20:31,320
هذا سيّئ

318
00:20:36,600 --> 00:20:37,810
نعتذر عن التأخُّر

319
00:20:37,810 --> 00:20:39,380
اتركن الباقي علينا

320
00:21:07,640 --> 00:21:08,700
!نجحنا

321
00:21:19,860 --> 00:21:22,210
...بسببِ الأوبلي

322
00:21:22,210 --> 00:21:25,080
أُلغيَتْ نتائج المباراة...

323
00:21:25,080 --> 00:21:28,140
بذلَتْ مانا مجهوداً كبيراً

324
00:21:28,450 --> 00:21:31,120
سنُضاعف جهودنا مجدّداً في المرّةِ المقبلة

325
00:21:31,620 --> 00:21:32,760
أجل

326
00:21:33,360 --> 00:21:36,360
أماني-سان، أحسنتِ صنعاً

327
00:21:38,080 --> 00:21:39,540
أنا مندهشة

328
00:21:39,540 --> 00:21:42,730
ضرباتكِ قويّة بما يكفي لقذفِ أوبلي للخلف

329
00:21:43,200 --> 00:21:44,700
شكراً لكِ

330
00:21:44,700 --> 00:21:47,670
أنا سعيدةٌ بمديحكِ لي

331
00:21:48,660 --> 00:21:51,570
أنا لا أمدحكِ