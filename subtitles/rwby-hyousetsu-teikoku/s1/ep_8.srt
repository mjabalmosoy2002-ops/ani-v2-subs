1
00:00:01,140 --> 00:00:03,610
!أريد الحصول على أصدقاء

2
00:00:03,870 --> 00:00:06,120
!للحرّية

3
00:00:06,120 --> 00:00:07,810
!ما الذي يجري؟

4
00:00:17,670 --> 00:00:19,370
!أريد الخروج

5
00:00:17,670 --> 00:00:19,370
!أريد الخروج في رحلة

6
00:00:19,370 --> 00:00:21,420
!أريد أن أُدلّل

7
00:00:46,840 --> 00:00:49,520
...ما الذي

8
00:01:46,640 --> 00:01:48,670
لمَ انقلب الطقس فجأةً؟

9
00:01:54,770 --> 00:01:57,520
!ماذا؟ أظنّني رأيتُ شيئاً

10
00:02:03,690 --> 00:02:08,250
،باسم نيكولاس الكبير وعائلة شُني العظيمة

11
00:02:08,930 --> 00:02:11,030
ستلقون جميعاً أيّها السُذّج

12
00:02:11,030 --> 00:02:12,530
!حُكمكم

13
00:02:23,710 --> 00:02:26,850
ماذا الآن؟ أيُفترض بنا قتال بناية؟

14
00:02:26,850 --> 00:02:28,900
إن دخلنا، فلا يستطيع لمسنا

15
00:02:28,900 --> 00:02:30,670
ذاك إن استطعنا الدخول

16
00:02:31,260 --> 00:02:32,610
سأدخل أنا

17
00:02:33,610 --> 00:02:37,060
ثمّ سأستعمل عملةً لصنع باب

18
00:02:37,410 --> 00:02:39,820
فهمت، سنشتّت انتباهه

19
00:02:39,820 --> 00:02:42,880
...لا تتهوّري! روبي، أنا سوف

20
00:02:42,880 --> 00:02:44,030
ليس تهوّراً

21
00:02:44,700 --> 00:02:46,430
يمكنني تولّي الأمر

22
00:02:46,430 --> 00:02:48,530
هذا ليس وقت معاملتي كطفلة

23
00:02:50,410 --> 00:02:52,530
فلنثق بالقائدة يا يانغ

24
00:02:55,440 --> 00:02:56,080
أجل

25
00:02:57,300 --> 00:02:59,040
لا بأس

26
00:02:59,700 --> 00:03:01,580
!حسناً، ها نحن

27
00:03:19,810 --> 00:03:21,880
!أريد اللعب أكثر

28
00:03:21,880 --> 00:03:24,810
!أريد الخروج عندما أريد

29
00:03:24,810 --> 00:03:28,160
أريد الاستمتاع بالكلام
!مع أبي وأمّي

30
00:03:28,160 --> 00:03:30,200
!أريد أن يدلّلاني

31
00:03:33,680 --> 00:03:37,410
...أبي... أمّي

32
00:03:41,420 --> 00:03:45,280
...مسؤوليّة... كبيرة

33
00:03:50,210 --> 00:03:53,060
...أريد الاستمتاع! أريد أن

34
00:04:00,770 --> 00:04:02,350
...عملة، عملة

35
00:04:05,480 --> 00:04:08,540
!أنا جون يا بروفسور! الحلم في فوضى كبيرة

36
00:05:41,230 --> 00:05:44,960
إن كان التغيير كبيراً، سيقاومها قلبها

37
00:05:46,280 --> 00:05:50,450
يستغلّ الكابوس مقاومة قلب وايس-كن

38
00:05:52,460 --> 00:05:54,180
لا عودة الآن

39
00:05:55,020 --> 00:05:58,120
،إن لم تستطيعوا إيقافها من المقاومة

40
00:05:58,670 --> 00:06:01,760
فستفقد وايس-كن
أيّة سبل في العودة

41
00:06:06,810 --> 00:06:09,130
الكلام أسهل من الفعل

42
00:06:34,990 --> 00:06:36,910
!الحرّية

43
00:06:41,650 --> 00:06:43,670
!للحرّية

44
00:06:45,360 --> 00:06:47,870
سأسمح لكم بالتصرّف
بحرّية قدرما تشاؤون

45
00:06:48,340 --> 00:06:50,920
محبوسين في الجانب الآخر

46
00:06:58,290 --> 00:07:01,210
ستبقون صافيين على هذا النحو

47
00:07:12,840 --> 00:07:15,340
!عثرتُ على حمقاء

48
00:07:15,900 --> 00:07:17,530
ماذا؟ خفّاش؟

49
00:07:17,530 --> 00:07:21,290
...سأخبر أختي أنّكم هنا

50
00:07:22,600 --> 00:07:26,080
أختي؟ أقصد وايس؟

51
00:07:37,320 --> 00:07:39,300
!يبدو أنّ روبي دخلت

52
00:07:41,620 --> 00:07:42,700
!لنرجع

53
00:07:55,390 --> 00:07:58,260
!نجحنا! أحسنتِ يا روبي

54
00:07:58,260 --> 00:08:00,240
لم ننتهِ بعد يا أختي

55
00:08:00,760 --> 00:08:01,830
هيّا بنا

56
00:08:01,830 --> 00:08:04,580
علينا هزيمة الغريم هذه المرّة

57
00:08:06,400 --> 00:08:08,370
!عُلِم أيّتها القائدة

58
00:08:50,170 --> 00:08:52,350
حسناً، لنتحرّك

59
00:08:52,350 --> 00:08:55,960
سأفعل أيّ ما يتطلّبه الأمر لإيقاظها

60
00:08:57,090 --> 00:08:58,360
...أنت

61
00:08:59,040 --> 00:09:00,760
محض واحد من السيليز

62
00:09:04,020 --> 00:09:07,050
فلتكن مطيعاً وترجع حيث تنتمي

63
00:09:07,770 --> 00:09:09,100
لن يحصل ذلك

64
00:09:11,540 --> 00:09:14,880
!سأجعلكِ تستيقظين يا ملكة الثلج

65
00:09:22,840 --> 00:09:25,300
فلتبقَ هنا للأبد

66
00:09:25,300 --> 00:09:29,130
وإلّا ستتلقّى حُكمي

67
00:09:31,440 --> 00:09:33,180
رجعت هنا من جديد

68
00:09:37,840 --> 00:09:40,050
!أنت! أخرجني

69
00:09:40,050 --> 00:09:43,050
!لا بدّ أنّك تسمعني يا دوبي البليد

70
00:09:44,770 --> 00:09:45,470
!الغريم

71
00:09:45,470 --> 00:09:46,700
!لنهرب

72
00:09:53,130 --> 00:09:54,930
كيف وصل الغريم هنا؟

73
00:10:00,500 --> 00:10:02,480
أذلك لأنّي أخذت القطعة الأثريّة؟

74
00:10:24,690 --> 00:10:25,600
!باب

75
00:10:25,600 --> 00:10:26,760
!باب! باب

76
00:10:37,260 --> 00:10:38,980
!القطار بالأسفل

77
00:10:56,500 --> 00:10:59,760
إنّه لا يدخل، لمَ يا ترى؟

78
00:11:11,700 --> 00:11:13,160
تمهّلا قليلاً

79
00:11:13,960 --> 00:11:15,440
مرحباً، جون؟

80
00:11:16,130 --> 00:11:21,320
...وايس السلبيّة... البروفسور
...مقاومة القلب

81
00:11:21,320 --> 00:11:24,060
جون؟ لا أسمعك بوضوح

82
00:11:24,060 --> 00:11:25,410
ما الذي يجري يا روبي؟

83
00:11:25,410 --> 00:11:27,030
أهنالك خطبٌ بالسكرول؟

84
00:11:29,930 --> 00:11:32,920
!انتبه الكابوس لأمرنا، لنسرع

85
00:11:47,260 --> 00:11:48,300
!فتح

86
00:12:14,060 --> 00:12:15,600
حان وقت تلقّي حُكمكنّ

87
00:12:15,600 --> 00:12:16,490
وايس؟

88
00:12:17,850 --> 00:12:19,060
!أختي؟

89
00:12:21,730 --> 00:12:23,740
بعد كلّ ما فعلتماه

90
00:12:24,570 --> 00:12:28,070
لا بدّ أنّكما متحضّرتان لما سيأتي

91
00:12:28,070 --> 00:12:29,530
!انتظري يا وايس

92
00:13:00,420 --> 00:13:01,360
!بليك

93
00:13:04,980 --> 00:13:06,230
!مؤلم

94
00:13:14,720 --> 00:13:18,530
أنتنّ مطرودات من هذه البلدة للأبد

95
00:13:19,260 --> 00:13:21,640
ولن تقابلنني من جديد

96
00:13:22,140 --> 00:13:23,160
وايس؟

97
00:13:25,740 --> 00:13:27,550
لن تكوني بحاجةٍ لهذا بعد الآن

98
00:13:27,550 --> 00:13:29,550
!كلّا! توقّفي يا وايس

99
00:13:47,070 --> 00:13:49,580
الوداع يا روبي

100
00:14:06,780 --> 00:14:08,630
إنّه أنا يا روبي

101
00:14:08,630 --> 00:14:09,850
...جون

102
00:14:09,850 --> 00:14:11,550
أين يانغ وبليك؟

103
00:14:11,550 --> 00:14:14,380
استعملت وايس قوّتها لجعلهما تختفيان

104
00:14:15,120 --> 00:14:19,910
قالت أنّها طردتهما، فأعتقد
أنّهما خارج البلدة

105
00:14:19,910 --> 00:14:21,640
سأذهب للبحث عنهما إذاً

106
00:14:21,640 --> 00:14:24,810
شكراً لك، أنا سأرجع

107
00:14:24,810 --> 00:14:26,580
عليّ هزيمة الغريم

108
00:14:26,580 --> 00:14:28,420
ذلك مستحيلٌ بمفردكِ

109
00:14:28,420 --> 00:14:29,020
...لكن

110
00:14:29,300 --> 00:14:31,670
بأيّ حال، علينا التفكير بخطّةٍ جديدة

111
00:14:33,250 --> 00:14:36,420
ألديكِ عملات؟ استنفدتُ ما لديّ

112
00:14:36,420 --> 00:14:37,290
أجل

113
00:14:48,020 --> 00:14:51,920
سيليز؟ هنا... على القطار؟

114
00:14:51,920 --> 00:14:54,750
أجل، سأخبركِ بما حصل

115
00:14:54,750 --> 00:14:55,740
فاستمعي لي

116
00:15:15,480 --> 00:15:16,400
يانغ

117
00:15:17,360 --> 00:15:19,060
!بليك

118
00:15:19,060 --> 00:15:21,240
هل ألقتكِ وايس هنا أيضاً؟

119
00:15:21,240 --> 00:15:22,170
أجل

120
00:15:22,850 --> 00:15:25,520
ظننتُ أنّي سأرجع لنقطة البداية

121
00:15:26,300 --> 00:15:28,260
لكن لا يبدو أنّ الأمر كذلك

122
00:15:35,000 --> 00:15:37,930
أتساءل ما إن كان هناك
أيّ حمقى آخرين

123
00:15:43,220 --> 00:15:48,380
...لذا، بسببها لا يستطيع الكابوس الدخول

124
00:15:48,380 --> 00:15:51,760
ربما للأمر علاقةٌ بالمناعة
التي ذكرها البروفسور

125
00:15:51,760 --> 00:15:53,510
...أي لأنّك أخذت القطعة الأثريّة

126
00:15:53,510 --> 00:15:57,110
حوّل الغريم تلك الفتيات لوحوش وما شابه؟

127
00:15:57,110 --> 00:16:00,430
لذلك دور، كما لم يُفترض
أن يتحرّرن على الأغلب

128
00:16:02,160 --> 00:16:05,860
أتذكرين ما قالته بيرا ورين
قبل بدئنا للعمليّة؟

129
00:16:05,860 --> 00:16:07,980
كانت تحميهنّ لأنّهن ثمينات لها

130
00:16:07,980 --> 00:16:09,750
لم تكن تحتجزهن

131
00:16:12,080 --> 00:16:14,550
لكن لمَ حبستهنّ؟

132
00:16:15,160 --> 00:16:18,800
لا يمكنك أن تصبح بالغاً
إن تعلّقت بعواطف طفولتك

133
00:16:18,800 --> 00:16:22,160
مثل رغبة أكل الحلويّات
أو اللهو طوال اليوم

134
00:16:22,940 --> 00:16:27,440
إذا لم تتحمّل المسؤوليّة
،وتتحكّم بتلك المشاعر

135
00:16:27,440 --> 00:16:29,560
فستخرج حياتك عن السيطرة

136
00:16:32,170 --> 00:16:36,000
هل أخطأتُ في حقّ وايس؟

137
00:16:38,140 --> 00:16:40,270
،ظننتُ بأنانيّة أنّي كنت أساعدها

138
00:16:41,520 --> 00:16:44,320
ولم أفكّر بشعورها

139
00:16:52,750 --> 00:16:55,240
فريق جنبر مذهل

140
00:16:56,620 --> 00:16:59,230
تفكّرون بأفراد فريقكم

141
00:16:59,980 --> 00:17:04,010
تتعاطفون، وتساعدون بعضكم

142
00:17:05,690 --> 00:17:06,850
...روبي

143
00:17:09,010 --> 00:17:13,400
لم أكن قلقةً على وايس حتّى

144
00:17:14,240 --> 00:17:17,320
لم يخطر لي حصول هذا حتّى

145
00:17:19,000 --> 00:17:21,760
لاحظت بيرا عندما أُصبت

146
00:17:22,940 --> 00:17:26,790
بينما لم ألاحظ أنا شيئاً

147
00:17:27,850 --> 00:17:29,940
لا تقولي ذلك يا روبي

148
00:17:29,940 --> 00:17:32,230
ألستِ تقاتلين لإنقاذها الآن؟

149
00:17:33,260 --> 00:17:38,160
الفريق روبي... مصدر إحراج

150
00:17:38,780 --> 00:17:43,550
لا أملك... أحقّيةً بالقيادة

151
00:17:43,550 --> 00:17:44,360
روبي؟

152
00:17:45,130 --> 00:17:46,570
!روبي

153
00:17:46,570 --> 00:17:51,070
آسفة يا وايس، أنا آسفة

154
00:17:57,380 --> 00:17:58,900
!يا للذوق السيّئ

155
00:17:59,780 --> 00:18:01,510
ما هذا؟

156
00:18:02,310 --> 00:18:04,030
!نيكولاس الكبير

157
00:18:05,230 --> 00:18:07,200
باب ناطق آخر

158
00:18:07,200 --> 00:18:08,160
من أنت؟

159
00:18:08,600 --> 00:18:10,890
أنا كلاين الخجول

160
00:18:10,890 --> 00:18:14,670
أحتجز الأشخاص الذين لا يُسمح
لهم بدخول الإمبراطوريّة

161
00:18:14,670 --> 00:18:16,740
لا يُسمح لهم بالدخول؟

162
00:18:16,740 --> 00:18:18,920
تقصد فاونس مثلي؟

163
00:18:19,450 --> 00:18:21,310
صحيح

164
00:18:21,310 --> 00:18:25,280
بالمناسبة، متى خرجتِ؟

165
00:18:25,280 --> 00:18:26,430
...بليك

166
00:18:26,430 --> 00:18:27,770
...هذا

167
00:18:29,150 --> 00:18:30,680
،في ذهن وايس

168
00:18:31,440 --> 00:18:32,970
المكان الذي أنتمي له

169
00:19:07,780 --> 00:19:12,850
مـ-مـ-مسؤوليّة... كـ-كبيرة

170
00:19:16,310 --> 00:19:18,860
شكراً لك يا كلاين، التقرير

171
00:19:18,860 --> 00:19:23,110
المواطنون الإمبراطوريّون في سكونٍ
يا وايس-ساما

172
00:19:23,110 --> 00:19:27,230
بعودة النظام والانضباط الآن

173
00:19:27,230 --> 00:19:29,500
يمكن للائقين ببني شُني

174
00:19:29,500 --> 00:19:32,610
أن ينعموا بالنوم الحقيقيّ

175
00:19:48,230 --> 00:19:49,790
...النوم الحقيقيّ

176
00:20:27,550 --> 00:20:29,080
أنا وحدي؟

177
00:20:31,930 --> 00:20:33,450
أين الجميع؟

178
00:20:42,710 --> 00:20:44,020
روبي

179
00:20:44,020 --> 00:20:45,690
يبدو أنّكِ أفقتِ

180
00:20:48,190 --> 00:20:49,750
!وايس

181
00:20:49,750 --> 00:20:52,450
!استيقظتِ يا وايس

182
00:20:52,780 --> 00:20:56,620
أجل يا روبي، بفضلكِ

183
00:20:57,260 --> 00:21:02,130
!أنتِ أعزّ صديقاتي، وقائدةٌ مذهلة

184
00:21:02,130 --> 00:21:04,340
لم يكن بإمكاني فعلها بمفردي

185
00:21:17,850 --> 00:21:19,860
أبي؟ زوي؟

186
00:21:23,650 --> 00:21:24,650
ماذا؟