1
00:00:09,130 --> 00:00:10,540
...وايس

2
00:00:13,100 --> 00:00:14,110
!غططتُ في النوم

3
00:00:18,010 --> 00:00:21,840
قشدةٌ وخمسة مكعبات سكّر
كما تحبّينها، صحيح؟

4
00:00:22,620 --> 00:00:24,790
هاكِ، قهوة

5
00:00:31,200 --> 00:00:33,210
شكراً لكِ يا وايس

6
00:00:35,800 --> 00:00:38,290
أثرتِ كلّ تلك المتاعب

7
00:00:38,290 --> 00:00:41,970
ظننتُ أنّ بإمكاني الوثوق بكِ لمساعدتي
في حماية ما هو ثمين

8
00:00:45,040 --> 00:00:47,980
اعتقدتُ أنّي أقوم بالأمر الصائب

9
00:00:48,980 --> 00:00:50,980
آسفةٌ يا وايس

10
00:00:51,270 --> 00:00:55,740
شعرتُ بالأسى عليهم لاحتجازهم

11
00:00:57,810 --> 00:01:00,400
أعرف شعوركِ تمام المعرفة

12
00:01:01,130 --> 00:01:06,020
لذا يمكنكِ الإفلات بأشياء
لا أستطيع الإفلات منها

13
00:01:06,760 --> 00:01:07,820
ماذا؟

14
00:01:07,820 --> 00:01:11,270
يمكنكِ التحرّك بحرّيةٍ عبر
أسوار القلعة والبلدة

15
00:01:12,650 --> 00:01:16,130
أفهم شعور يانغ أيضاً في الواقع

16
00:01:17,950 --> 00:01:22,850
عندما أراكِ، تراودني رغبةٌ بتحريرهم أيضاً

17
00:01:22,850 --> 00:01:25,690
لكن ليس تدليلهم تحديداً

18
00:01:26,380 --> 00:01:30,770
ألم تكرهيني لأنّي كنت مُثيرةً للإحراج؟

19
00:01:31,200 --> 00:01:35,400
وجدتُ طبيعتكِ المتهوّرة
والبسيطة محلّ شكّ بالطبع

20
00:01:36,600 --> 00:01:38,710
لكنّي أعرف أنّ بإمكاني الثقة بكِ الآن

21
00:01:38,710 --> 00:01:40,880
ماذا؟ حقّاً؟

22
00:01:40,880 --> 00:01:41,910
أجل

23
00:01:42,840 --> 00:01:47,160
أيضاً، لم يسبق وأن التقيتُ
شخصاً وحيداً أكثر منّي

24
00:01:48,580 --> 00:01:51,170
أنتِ وحيدةٌ يا وايس؟

25
00:01:51,170 --> 00:01:53,670
...لم يخطر

26
00:02:01,150 --> 00:02:04,150
فهمت، أنتِ كذلك أيضاً

27
00:02:07,390 --> 00:02:11,950
لكيلا تفقدي الثمينين لكِ، أغلقي عليهم بإحكام

28
00:02:12,550 --> 00:02:14,070
وأخلديهم للنوم

29
00:02:14,890 --> 00:02:19,650
،بالكلام عن الأشياء الثمينة
وردتي الهلاليّة

30
00:02:19,650 --> 00:02:21,950
كانت الأنبوبة في الجانب المُعاكس

31
00:02:24,970 --> 00:02:30,230
كلّا يا روبي، لكلّ شيءٍ سبب

32
00:02:30,950 --> 00:02:32,440
سبب؟

33
00:02:32,440 --> 00:02:37,460
فهو يختبئ في ظلّ
الشخص الذي يواجهه

34
00:02:37,460 --> 00:02:39,420
وايس، أين تذهبين؟

35
00:02:41,240 --> 00:02:43,820
عليّ الخلود للنوم بدوري

36
00:02:44,830 --> 00:02:47,080
ألا يُفترض أن ننام هنا معاً؟

37
00:02:47,900 --> 00:02:50,480
ربما لا يروقكِ السرير ذو الطابقين بالفعل

38
00:02:51,750 --> 00:02:54,320
لطالما أردتُ واحداً

39
00:02:56,130 --> 00:02:58,360
لكنّ هذا حلمكِ

40
00:02:59,110 --> 00:03:02,730
عليّ العودة لمكان نومي

41
00:03:04,000 --> 00:03:05,160
ألا تتفقين؟

42
00:03:07,920 --> 00:03:10,830
بلى، ربما

43
00:03:13,480 --> 00:03:16,380
طابت ليلتكِ يا روبي

44
00:03:21,360 --> 00:03:23,770
طابت ليلتكِ يا وايس

45
00:05:05,310 --> 00:05:07,030
!روبي

46
00:05:07,030 --> 00:05:09,370
ما الذي حصل؟

47
00:05:10,170 --> 00:05:12,040
روبي! أأنتِ بخير؟

48
00:05:12,510 --> 00:05:14,730
!أيُعقل هذا؟ روبي

49
00:05:34,270 --> 00:05:35,850
هل الوضع خطر؟

50
00:05:36,300 --> 00:05:39,440
اُحتجزت روبي-كن من قِبل
حلمٍ داخل الحلم

51
00:05:40,100 --> 00:05:43,210
لا بدّ أنّ الكابوس تسلّل لقلبها

52
00:05:43,890 --> 00:05:48,040
السيمبلانس خاصّتي يتعرّض للإعاقة
ولا أستطيع مساعدتها بالهروب

53
00:05:48,920 --> 00:05:50,130
...جون

54
00:05:50,130 --> 00:05:51,410
ماذا؟ ماذا؟

55
00:05:51,410 --> 00:05:52,830
ما الذي حصل؟

56
00:05:53,500 --> 00:05:55,280
هالته تزداد قوّةً

57
00:05:56,830 --> 00:06:06,010
!أنت لها يا جون! واحد، اثنان! واحد، اثنان

58
00:06:03,490 --> 00:06:05,090
!قريباً وسأصل

59
00:06:14,360 --> 00:06:15,500
!وايس

60
00:06:16,730 --> 00:06:18,640
...مؤلم

61
00:06:18,640 --> 00:06:19,980
أهذا القطار؟

62
00:06:23,220 --> 00:06:26,050
هل أفقتِ؟ حمداَ لله

63
00:06:26,680 --> 00:06:28,240
...عملتي الأخيرة

64
00:06:36,480 --> 00:06:41,200
السبب ليس واضحاً، لكن يبدو
أنّها تجاوزت الخطر

65
00:06:42,490 --> 00:06:46,080
لم يُستنفد السيمبلانس
خاصّتي بالكامل أيضاً

66
00:06:47,920 --> 00:06:52,510
بالمناسبة، أيّ قوّةٍ يمتلكها
السيمبلانس خاصّته؟

67
00:06:53,700 --> 00:06:56,420
لا نعرف ذلك بعد

68
00:06:56,420 --> 00:06:59,460
تعلّم لتوّه كيفيّة تفعيل هالته

69
00:06:59,460 --> 00:07:03,530
صدقاً، اندهشتُ من قتاله
دون استعمال السيمبلانس

70
00:07:04,650 --> 00:07:07,690
...تساعد القوّة في تنشيط القوى أحياناً

71
00:07:09,690 --> 00:07:11,710
قوى مخفيّة في أعماق المرء

72
00:07:28,690 --> 00:07:31,130
هل نامت روبي؟

73
00:07:35,630 --> 00:07:39,530
هل نامت يانغ وبليك والبقيّة أيضاً؟

74
00:07:45,490 --> 00:07:49,950
...أيّتها المرآة

75
00:07:50,930 --> 00:07:57,080
أخبريني بشيء

76
00:07:58,150 --> 00:08:11,480
أخبريني من الأشدّ وحدة

77
00:08:14,190 --> 00:08:25,260
أيّتها المرآة، ما بداخلي؟

78
00:08:26,550 --> 00:08:40,710
أخبريني، أيمكن أن ينقلب
القلب حجراً؟

79
00:08:42,860 --> 00:08:49,970
مرآة، يا مرآة، ما ذاك الذي وراءك؟

80
00:08:49,970 --> 00:08:56,390
أنقذيني من الأشياء التي أراها

81
00:08:57,310 --> 00:09:03,140
يمكنني إخفائها من العالم

82
00:09:03,140 --> 00:09:10,930
لمَ لا تدعيني أختبئ منّي؟

83
00:09:11,400 --> 00:09:17,720
...مرآة، يا مرآة

84
00:09:19,070 --> 00:09:24,860
أخبريني بشيء

85
00:09:25,960 --> 00:09:39,260
من الأشدّ وحدة؟

86
00:09:41,060 --> 00:09:58,290
أنا الأشدّ وحدة

87
00:10:19,310 --> 00:10:23,540
لا تطيلا في النظر، أشعر بالإحراج

88
00:10:30,370 --> 00:10:33,050
لا يمكنني الاتّصال بـ روبي أو جون

89
00:10:33,050 --> 00:10:37,500
،إنّها أشبه بسقيفتنا في البيت
لكن مريبةٌ أكثر بمئة مرّة

90
00:10:37,500 --> 00:10:40,830
تغطّيها الخرد ولا تُنظّف أبداً

91
00:10:42,040 --> 00:10:44,720
لم أكن أتكلّم عنك بالضبط

92
00:10:44,720 --> 00:10:46,600
كنتُ أقصد هذا المكان

93
00:10:46,600 --> 00:10:48,250
أنا أوافقكِ

94
00:10:59,270 --> 00:11:00,650
المخلب الأبيض

95
00:11:19,530 --> 00:11:20,330
يانغ

96
00:11:20,330 --> 00:11:24,440
قطعة أثريّة! لا بدّ أنّ هذه
!القطعة الأثريّة تخصّكِ

97
00:11:24,440 --> 00:11:26,080
!كنتُ أعرف أنّنا سنجد واحدة

98
00:11:31,380 --> 00:11:32,420
مُذهل

99
00:11:33,220 --> 00:11:35,210
ما-ماذا؟

100
00:11:37,780 --> 00:11:40,090
ماذا؟ ماذا؟ ما الذي ظهر؟

101
00:11:43,810 --> 00:11:46,730
لا أستطيع معرفة ما إن كانوا
غريم أم المخلب الأبيض

102
00:11:47,350 --> 00:11:49,240
لمَ يبدون مُسالمين؟

103
00:11:49,240 --> 00:11:50,960
ربما بسبب وجودي

104
00:11:50,960 --> 00:11:54,950
فبالنسبة لـ وايس، أنا مثلهم

105
00:11:54,950 --> 00:11:57,550
مهلاً، لا تعرفين ذلك

106
00:11:57,550 --> 00:12:01,130
تذكّري، هذا الحلم من صنع الغريم

107
00:12:01,130 --> 00:12:02,630
أظنّني أعرف السبب

108
00:12:02,630 --> 00:12:03,490
ماذا؟

109
00:12:03,490 --> 00:12:08,580
كنتُ أعتقد أنّ شركة غبار شُني
والناس الذين يحاكمون الفاونس

110
00:12:08,580 --> 00:12:11,460
كانوا خطيرين ومُرعبين

111
00:12:11,460 --> 00:12:12,770
مثلما تراهم

112
00:12:13,590 --> 00:12:17,640
في أعماقي، كنتُ أعرف أنّهم
لم يكونوا جميعاً كذلك

113
00:12:18,370 --> 00:12:23,790
لكنّي أقنعتُ نفسي بأنّ عدائيّتهم
أعطتني سبباً لقتالهم

114
00:12:25,480 --> 00:12:30,100
حسناً، ولو فعلتِ، لم تعودي كذلك

115
00:12:30,100 --> 00:12:32,220
بأيّ حال، لنأخذ هذه ونرجع سريعاً

116
00:12:32,730 --> 00:12:34,800
ثمّ نتخلّص من الغريم

117
00:12:34,800 --> 00:12:36,270
...سأستعمل عملتي، لذا

118
00:12:36,590 --> 00:12:40,490
إن فعلنا ذلك، ستوقفنا وايس السلبيّة
من جديد لا أكثر

119
00:12:40,490 --> 00:12:43,310
داخل الحلم، لا نستطيع مجابهة قوّتها

120
00:12:43,310 --> 00:12:45,540
لا نعرف ذلك

121
00:12:45,540 --> 00:12:48,470
أنا متأكّدةٌ أنّ روبي تبذل
قصارى جهدها بمفردها الآن

122
00:12:48,470 --> 00:12:49,750
...علينا الإسراع و

123
00:12:49,750 --> 00:12:51,130
أنا متأكّدةٌ أنّها تعرف

124
00:12:51,640 --> 00:12:56,420
،إن لم نفكّر بخطّةٍ أفضل
فلن نمتلك فرصةً بالفوز

125
00:12:56,420 --> 00:13:00,370
فكّرنا بما يكفي، ما عسانا أن نفعل؟

126
00:13:00,370 --> 00:13:04,680
نُصاب بحساسيّة من الغريم مثل جون
كي نستطيع التسلّل كالجبناء؟

127
00:13:04,680 --> 00:13:06,080
!كلّا، لا أريد ذاك الأسلوب

128
00:13:06,080 --> 00:13:08,870
أخبركِ أنّ القوّة الصريحة لن تنفع

129
00:13:10,490 --> 00:13:12,060
لكن قد تكون هنالك طريقةٌ أخرى

130
00:13:12,060 --> 00:13:12,940
ماذا؟

131
00:13:39,400 --> 00:13:41,540
يوجد سببٌ لهذا أيضاً إذاً؟

132
00:14:03,240 --> 00:14:05,270
الباب الذي نحتاجه لا يُفتح

133
00:14:05,270 --> 00:14:07,530
يمكننا دخول المباني القريبة فحسب

134
00:14:07,530 --> 00:14:09,940
لا يوجد جنود روبوت

135
00:14:09,940 --> 00:14:12,710
أعتقد أنّ بإمكاننا الوصول
لذاك المبنى إن ذهبنا الآن

136
00:14:12,710 --> 00:14:14,750
هل سنذهب هناك حقّاً؟

137
00:14:14,750 --> 00:14:17,740
علينا البحث عن يانغ وبليك بدل ذلك

138
00:14:17,740 --> 00:14:20,420
كما أنّنا استعملنا كافّة عملاتنا

139
00:14:20,420 --> 00:14:23,520
ستغطّ وايس في النوم
!أثناء قيامنا بذلك

140
00:14:23,520 --> 00:14:27,410
لن تستيقظ مُجدّداً، قالت وايس الحقيقيّة ذلك

141
00:14:27,410 --> 00:14:30,010
لكن ماذا لو تحرّك التمثال
على المبنى من جديد؟

142
00:14:30,700 --> 00:14:34,080
لا نعرف من أين سيظهر
المزيد من الجنود أو الأشواك

143
00:14:34,500 --> 00:14:38,670
،لا يمكننا هزيمة وايس السلبيّة
لا نستطيع التصرّف بتهوّر

144
00:14:38,670 --> 00:14:41,330
سأفكّر بخطّةٍ لا متهوّرة إذاً

145
00:14:49,230 --> 00:14:52,960
هذا القطار... لم يعترضه شيء
من الوصول هنا، صحيح؟

146
00:14:52,960 --> 00:14:54,540
...أ-أجل

147
00:14:54,960 --> 00:14:58,470
أتساءل ما إن كان بمقدورنا استقلاله
طوال الطريق إلى ذلك المبنى

148
00:14:58,470 --> 00:14:59,540
أأنتِ جادة؟

149
00:14:59,540 --> 00:15:01,470
لا توجد مسارات

150
00:15:01,470 --> 00:15:03,910
لم تكن هناك مسارات قبلاً أيضاً

151
00:15:03,910 --> 00:15:06,340
يُفترض أن يتقدّم طالما أكون موجودة

152
00:15:06,340 --> 00:15:08,990
أنتِ؟ ما قصدكِ؟

153
00:15:08,990 --> 00:15:13,400
أخبرتني وايس بذلك، أنّ بإمكاني التحرّك بحرّية

154
00:15:14,030 --> 00:15:19,310
لم تكرهني وايس، لذا أنا متأكّدةٌ
أنّها ستسمح لنا بالعبور

155
00:15:19,610 --> 00:15:20,830
ستفهم

156
00:15:20,830 --> 00:15:23,520
لكن كانت تلك وايس، ليس وايس السلبيّة

157
00:15:23,520 --> 00:15:25,880
وايس السلبيّة هي من ستهاجمنا

158
00:15:25,880 --> 00:15:30,200
إن فعلت، فسيعني ذلك أنّ
وايس لم تنم بعد

159
00:15:30,580 --> 00:15:34,330
يمكننا توفير وقتٍ بينما ننتظر
وصول أختي والبقيّة

160
00:15:35,270 --> 00:15:37,480
هل سنجلب الفتيات أيضاً؟

161
00:15:37,900 --> 00:15:41,550
أريد مساعدة وايس
في أن تصبح حرّةً أكثر

162
00:15:42,570 --> 00:15:46,670
قد يبدو ذلك أنانيّاً، لكنّي أراه الأمر الصائب

163
00:15:46,670 --> 00:15:49,250
فأعتقد أنّ على أولئك الفتيات القتال أيضاً

164
00:15:49,250 --> 00:15:52,460
مهلاً، مهلاً، هل نسيتِ ما أخبرتكِ به؟

165
00:15:52,980 --> 00:15:58,020
ستتحوّل الفتيات لوحوش
ويثرن فوضى من جديد

166
00:15:58,020 --> 00:16:00,460
لكنّ ذلك حصل بسبب الغريم

167
00:16:00,460 --> 00:16:05,260
لم تتحوّل بيرا التي بقت بجوارك
إلى وحش، أليس كذلك؟

168
00:16:05,260 --> 00:16:06,510
...بلى

169
00:16:06,510 --> 00:16:12,000
وكلّ ما أخبرتهنّ به هو القتال للحرّية

170
00:16:12,000 --> 00:16:14,370
فلعلّ ذلك سبب إثارتهنّ للفوضى

171
00:16:14,370 --> 00:16:17,140
ما الذي ستجعلينهنّ يفعلن إذاً؟

172
00:16:17,140 --> 00:16:20,120
سأطلب منهنّ القتال لـ وايس

173
00:16:20,710 --> 00:16:23,630
أريد أن تخرج وايس من هنا

174
00:16:24,340 --> 00:16:26,940
أريد أن تدرك وايس أنّها تريد الخروج

175
00:16:51,540 --> 00:16:52,900
ما الذي يجري؟

176
00:16:59,410 --> 00:17:00,460
محطّة الطبقة المتوسّطة

177
00:17:00,460 --> 00:17:01,040
محطّة قصر شُني

178
00:17:02,500 --> 00:17:04,010
ماذا؟ ماذا؟

179
00:17:48,040 --> 00:17:51,670
من البديهيّ أن يكون قطار
للشركة مليئاً بالغبار

180
00:17:52,100 --> 00:17:53,830
!لدينا كلّ الذخيرة التي نحتاجها

181
00:18:04,690 --> 00:18:06,990
!أرجوكِ، دعينا نعبر يا وايس

182
00:18:09,420 --> 00:18:10,870
!واصل التقدّم

183
00:18:58,140 --> 00:18:59,150
...وايس

184
00:19:01,210 --> 00:19:03,160
دعينا نعبر يا وايس

185
00:19:03,160 --> 00:19:05,830
!إن كنتِ تثقين بي، فدعينا نعبر

186
00:19:06,370 --> 00:19:08,510
لا تكوني حمقاء

187
00:19:08,510 --> 00:19:12,630
لا تزالين تجهلين ما يُسمح به
وما يُمنع حتّى في هذه المرحلة

188
00:19:13,300 --> 00:19:16,650
سأحكم عليكِ

189
00:19:17,400 --> 00:19:19,090
وأخلدكِ للنوم

190
00:19:38,200 --> 00:19:40,070
!أطلقن! واصلن الإطلاق

191
00:19:50,510 --> 00:19:52,920
لا جدوى، سنهلك على هذا النحو

192
00:19:58,260 --> 00:20:01,270
!تبّاً، تحرّك! تحرّك

193
00:20:14,410 --> 00:20:15,650
!هذا فظيع

194
00:20:21,650 --> 00:20:22,610
!هناك

195
00:20:28,900 --> 00:20:32,310
فلتكوني فتاةً مُطيعة وتخلدي للنوم يا روبي

196
00:20:34,130 --> 00:20:37,460
!سأنقذ وايس بالتأكيد

197
00:20:53,480 --> 00:20:55,280
هذه نهايتك

198
00:21:00,780 --> 00:21:01,610
ما هذا؟

199
00:21:31,970 --> 00:21:33,770
ما الذي يجري؟

200
00:21:39,220 --> 00:21:40,220
!يانغ

201
00:21:40,550 --> 00:21:41,570
!مرحباً

202
00:21:41,950 --> 00:21:44,690
المخلب الأبيض! لكن لمَ؟

203
00:21:56,500 --> 00:21:58,500
!ابنة عائلة شُني

204
00:21:58,500 --> 00:22:00,320
...بين البشر والفاونس

205
00:22:00,320 --> 00:22:04,180
!سأريكِ أيّهما الأسمى والأعدل