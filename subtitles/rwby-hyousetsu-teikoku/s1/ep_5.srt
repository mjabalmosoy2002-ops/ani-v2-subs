1
00:01:48,170 --> 00:01:49,160
هذا سيّئ

2
00:02:14,530 --> 00:02:17,600
هل استيقظتُ من الحُلم؟

3
00:02:19,510 --> 00:02:21,770
هربت منّا يا أختي

4
00:02:21,770 --> 00:02:22,780
!كلاين

5
00:02:23,610 --> 00:02:26,130
أجل آنستي وايس

6
00:02:26,130 --> 00:02:28,370
كلاين الغاضب هنا تحت إمرتك

7
00:02:28,730 --> 00:02:33,130
انشر كلّ جنود الإمبراطوريّة
وابحثوا عن روبي

8
00:02:33,130 --> 00:02:34,880
سمعاً وطاعة

9
00:02:35,120 --> 00:02:38,800
،إن كنتِ ملائمةً لتكوني ابنةً لآل شُني حقّاً

10
00:02:38,800 --> 00:02:41,050
فأتمّي واجباتكِ يا وايس

11
00:02:46,600 --> 00:02:49,390
سأثبت لك جدارتي سريعاً

12
00:02:52,130 --> 00:02:54,480
أأنتِ بخير؟ هل استيقظتِ تماماً؟

13
00:02:54,480 --> 00:02:55,430
أجل

14
00:02:56,040 --> 00:02:57,820
وجدتُ وايس الحُلم

15
00:02:58,270 --> 00:03:01,120
لكنّي فشلتُ بشكلٍ ما؟

16
00:03:01,120 --> 00:03:04,100
كمهمّة استطلاعٍ أوليّة، كان أداؤكِ ممتازاً

17
00:03:04,100 --> 00:03:07,040
أخبرنا بالتفصيل ما رأيتِه
وسمعتِه من فضلك

18
00:03:08,950 --> 00:03:11,080
كان هنالك سورٌ داخل البلدة أيضاً

19
00:03:11,080 --> 00:03:15,000
لكنّي لم أجد مدخل المنطقة
بالتمثال الكبير بعد

20
00:03:15,580 --> 00:03:18,080
،يبدو أنّه مع اقترابك من مركز البلدة

21
00:03:18,080 --> 00:03:21,500
تتوغليّن أكثر في أعماق ذهن وايس-كن

22
00:03:21,840 --> 00:03:27,330
البلدة هي حصنٌ بناه الكابوس
من أفكار وايس-كن

23
00:03:27,330 --> 00:03:31,470
يُفترض أن يكون الكابوس نفسه
داخل جوهر ذهنها

24
00:03:31,850 --> 00:03:35,830
عندما رأيتِ وايس-سان داخل الحُلم، كيف كانت؟

25
00:03:38,360 --> 00:03:42,940
كانت غاضبةً جدّاً|، بدا أنّها تكرهني

26
00:03:43,250 --> 00:03:44,820
كما وهي مُستيقظة

27
00:03:44,820 --> 00:03:45,950
يانغ

28
00:03:45,950 --> 00:03:50,200
يحاول الكابوس إيهامكِ بذلك

29
00:03:51,290 --> 00:03:54,920
ذلك استغلال الكابوس
لذهنها لا أكثر

30
00:03:54,920 --> 00:03:57,770
رغم أنّ ذلك سيسبّب صدمةً بالتأكيد

31
00:03:57,770 --> 00:03:59,960
إن اعتقدتِ أنّها ذاتها الحقيقيّة

32
00:03:59,960 --> 00:04:03,610
علينا التفريق بينها
وبين وايس-كن الحقيقيّة

33
00:04:03,610 --> 00:04:05,860
لندعها بوايس السلبيّة

34
00:04:05,860 --> 00:04:09,810
السلبيّة؟ لا أظنّ أنّي سبق
ورأيتُ وايس إيجابيّة

35
00:04:09,810 --> 00:04:11,100
يكفي

36
00:04:11,100 --> 00:04:16,890
،كانت وايس قويّةً جدّاً أيضاً
لم أستطع مجابهتها البتّة

37
00:04:16,890 --> 00:04:19,450
ذلك لأنّكِ داخل حلمٍ أيضاً بالطبع

38
00:04:19,450 --> 00:04:23,610
...ستصبح وايس الحُلم
بل وايس السلبيّة قويّةً

39
00:04:23,610 --> 00:04:27,410
بالحدّ الذي يمكّنها ذهنها منه

40
00:04:32,370 --> 00:04:37,970
قرّرن من ستدخل الحُلم بوقت
استعادتي لهالتي رجاءً

41
00:04:37,970 --> 00:04:39,150
!سأذهب أنا

42
00:04:38,360 --> 00:04:40,590
!هذه المرّة، سأذهب أيضاً

43
00:04:39,150 --> 00:04:40,590
!وأنا

44
00:04:40,590 --> 00:04:42,990
إن كان عددنا كبيراً، فسيكتشفوننا فوراً

45
00:04:42,990 --> 00:04:44,430
يكفي أن أذهب بمفردي

46
00:04:44,430 --> 00:04:46,600
تريدين أن نترك كلّ شيءٍ لكِ؟

47
00:04:46,600 --> 00:04:49,290
حسناً، أنا القائدة

48
00:04:49,290 --> 00:04:53,110
ما الذي تتكلّمين عنه؟
ليست مسؤوليتكِ وحدك

49
00:04:53,110 --> 00:04:57,250
لم تستطيعي مقارعتها بمفردك، فمن الطبيعيّ
أنّ علينا الذهاب كفريق

50
00:04:57,250 --> 00:05:00,900
لا تريديننا أن نرى وايس الحُلم تلك، أليس كذلك؟

51
00:05:00,900 --> 00:05:03,150
...حسناً، أنا

52
00:05:03,150 --> 00:05:06,060
ماذا؟! فهمت

53
00:05:06,060 --> 00:05:09,090
لعلّ وايس الحُلم كريهةٌ لذاك الحدّ

54
00:05:09,090 --> 00:05:10,660
"إنّها "وايس السلبيّة

55
00:05:10,940 --> 00:05:14,570
كنتُ أفكّر بالأمر مُذ غطّت وايس في النوم

56
00:05:14,570 --> 00:05:18,070
ومثل وايس، قرّرتُ أنّي لا أبالي

57
00:05:18,070 --> 00:05:20,280
لذا سأكون بخير

58
00:05:20,280 --> 00:05:23,540
يمكننا الاستفسار من وايس لاحقاً
عن شعورها الحقيقيّ

59
00:05:23,540 --> 00:05:25,300
!سندخل معاً أيّتها القائدة

60
00:05:26,500 --> 00:05:28,900
حسناً... لا بأس

61
00:05:30,550 --> 00:05:32,220
!المعذرة

62
00:05:35,060 --> 00:05:37,550
ما الذي جاء بكم؟

63
00:05:37,550 --> 00:05:39,480
سيبدأ الدرس قريباً

64
00:05:39,480 --> 00:05:43,060
أردنا معرفة ما يجري
مع روبي والبقيّة

65
00:05:43,480 --> 00:05:45,380
لم تستيقظ وايس بعد؟

66
00:05:45,380 --> 00:05:48,350
كلا، علينا دخول حُلمها مُجدّداً

67
00:05:48,350 --> 00:05:51,070
لم تستيقظ المرّة الأولى إذاً

68
00:05:51,070 --> 00:05:55,580
!سنجد طريقاً، فلن نخسر لفريق جنبر

69
00:05:55,580 --> 00:05:58,330
أنتنّ قادرات بالتأكيد

70
00:05:58,330 --> 00:06:00,330
أمررنا بتلك الصعوبة؟

71
00:06:00,330 --> 00:06:03,830
يبدو أنّ حالة جون لم تكن بتلك الخطورة

72
00:06:05,470 --> 00:06:08,460
ليته تلبّسني مكانها

73
00:06:15,710 --> 00:06:18,960
حسناً، فلتتوجّهوا أنتم الأربعة للدرس

74
00:06:18,960 --> 00:06:23,480
سأتفقّد عليكم لاحقاً، أنا أثق بالفريق روبي

75
00:06:24,430 --> 00:06:26,640
شكراً لك، سنبذل قصارى جهدنا

76
00:06:31,020 --> 00:06:33,510
استرجعت هالتي

77
00:06:44,290 --> 00:06:48,920
أخمدن قلوبكن، وائتمنّني على أنفسكنّ

78
00:06:50,460 --> 00:06:53,710
سأدعوكنّ للحُلم الآن

79
00:07:27,100 --> 00:07:29,270
إحدى أذنايّ بارزة

80
00:07:29,270 --> 00:07:31,800
أهكذا تراني وايس؟

81
00:07:31,800 --> 00:07:34,060
!يا إلهي، يا لظرافتك

82
00:07:34,060 --> 00:07:35,550
!يلائمكِ هذا جدّاً يا بليك

83
00:07:35,550 --> 00:07:38,870
شكراً لكما... ما قصّة الدرّاجة الناريّة؟

84
00:07:38,870 --> 00:07:40,880
وجدتُ نفسي عليها دون إحساس

85
00:07:40,880 --> 00:07:43,680
!لعلّ وايس تفهمني

86
00:07:43,680 --> 00:07:46,310
!انظري ما حلّ بسلاحي

87
00:07:49,460 --> 00:07:51,650
رأيتِ؟ يُطلق من الطرف الخطأ

88
00:07:51,650 --> 00:07:54,050
...هذا رائعٌ أيضاً، لكن

89
00:07:54,050 --> 00:07:57,160
إذا أخطأت، فقد أصيب أحداً ورائي

90
00:07:57,640 --> 00:07:58,680
ماذا عنكما؟

91
00:07:58,680 --> 00:08:00,280
لم يتغيّر سلاحي كثيراً

92
00:08:00,280 --> 00:08:01,660
ولا سلاحي

93
00:08:09,150 --> 00:08:11,350
قد يكون مختلفاً قليلاً

94
00:08:21,310 --> 00:08:24,740
!أنتما وحدكما أصبحتما أقوى؟ هذا ظلم

95
00:08:24,740 --> 00:08:27,350
تمادت قليلاً بالأحرى فحسب

96
00:08:27,350 --> 00:08:29,560
!اتركي شكواك لـ وايس

97
00:08:29,560 --> 00:08:33,630
يا إلهي، لمَ  أخطأت في وردتي الهلاليّة؟

98
00:08:34,070 --> 00:08:36,960
تمهّلي، لا تستعمليها بعد

99
00:08:36,960 --> 00:08:39,050
لنقم بعدّ ما لدينا أوّلاً

100
00:08:40,790 --> 00:08:41,950
اثنتا عشرة قطعة

101
00:08:42,690 --> 00:08:47,320
إن استعملنا الأخيرة، فلن نستطيع
الخروج من الحُلم، صحيح؟

102
00:08:47,320 --> 00:08:50,060
علينا استعمالها بعناية
واحدةً على حدة

103
00:08:50,060 --> 00:08:50,890
أجل

104
00:08:50,890 --> 00:08:52,210
هيّا بنا إذاً

105
00:09:03,960 --> 00:09:05,240
ماذا؟

106
00:09:05,240 --> 00:09:09,080
يقول عدّة أشياء لا أفهم معناها، كـ وايس تماماً

107
00:09:09,080 --> 00:09:11,730
أعتقد أنّ ردّة فعلي كانت نفسها

108
00:09:13,980 --> 00:09:15,480
ذاك القطار إذاً

109
00:09:17,960 --> 00:09:20,030
...تلك ليست غريم

110
00:09:21,260 --> 00:09:25,490
إنّه المخلب الأبيض... في مخيّلة وايس ربما

111
00:09:26,010 --> 00:09:28,200
ولا يمكننا التدخّل للمساعدة؟

112
00:09:28,200 --> 00:09:30,760
قال البروفسور ألّا نفعل

113
00:09:31,450 --> 00:09:32,430
أين العلامة؟

114
00:09:32,430 --> 00:09:33,840
هناك

115
00:09:37,340 --> 00:09:39,840
!اختفت الصورة التي التقطتُها للخريطة

116
00:09:39,840 --> 00:09:43,980
ربما يُمحى كلّ شيءٍ عدا
قوّة البروفسور شيون إذاً؟

117
00:09:44,860 --> 00:09:46,230
مرحباً؟

118
00:09:46,230 --> 00:09:48,630
يبدو أنّ السكرول يعمل مع ذلك

119
00:09:49,230 --> 00:09:50,880
حسناً، لنفتحه

120
00:10:04,030 --> 00:10:06,030
أعتقد أنّه حارس

121
00:10:06,030 --> 00:10:07,790
...جاك شُني

122
00:10:07,790 --> 00:10:08,660
ماذا؟

123
00:10:08,970 --> 00:10:13,550
،إنّه رئيس شركة شُني للغبار
أي أب وايس

124
00:10:14,500 --> 00:10:15,920
يبدو مُتزمّتاً

125
00:10:17,630 --> 00:10:19,440
أذاك السور؟

126
00:10:19,440 --> 00:10:22,430
لا يبدو أنّه يريد تركنا ندخل

127
00:10:22,910 --> 00:10:24,930
لنبحث عن المدخل معاً

128
00:10:33,440 --> 00:10:36,220
شكراً لك يا كلاين، تقريرك

129
00:10:36,220 --> 00:10:39,370
تعرّض قطارٌ آخر للهجوم

130
00:10:39,370 --> 00:10:43,450
تنمو قوّة المخلب الأبيض
القاطنة في الوادي يوماً ويوم

131
00:10:44,630 --> 00:10:48,700
كم سيمضي قبل أن نستطيع
استلام القطارات بسلامٍ مُجدّداً؟

132
00:10:52,210 --> 00:10:56,250
لحسن الحظّ، لا يوجد أيّ فاونس في الإمبراطوريّة

133
00:10:56,250 --> 00:11:00,530
لكنّ الفتاة ذات الرداء الأسود
تواصل الظهور

134
00:11:00,530 --> 00:11:01,970
ذلك مثيرٌ للقلق

135
00:11:01,970 --> 00:11:06,090
بالفعل، لا يمكنني إزاحة
تفكيري عنها للحظة

136
00:11:06,090 --> 00:11:07,850
راقبوها بعناية

137
00:11:07,850 --> 00:11:08,970
ماذا عن روبي ويانغ؟

138
00:11:08,970 --> 00:11:11,130
لم يقع نظر جاك-ساما على أحدٍ

139
00:11:11,130 --> 00:11:14,240
خرج دون إذنٍ بعد

140
00:11:14,240 --> 00:11:17,420
لا بدّ أنّهما لا تزالان
باقيتين في البرج بسكون

141
00:11:17,730 --> 00:11:20,710
قد نستطيع تحقيق السلام الحقيقيّ أخيراً

142
00:11:20,710 --> 00:11:23,580
لندعُ للوقت المُقدّر قدومه

143
00:11:39,380 --> 00:11:42,220
لا أدري ما علينا فعله حقّاً

144
00:11:59,790 --> 00:12:01,910
!نيكولاس الكبير

145
00:12:01,910 --> 00:12:03,510
ماذا؟! الباب؟

146
00:12:03,510 --> 00:12:04,900
لمَ أنت هنا؟

147
00:12:04,900 --> 00:12:07,700
!ذلك لأنّ السيليز في كلّ الأرجاء

148
00:12:07,700 --> 00:12:08,890
هنا وهناك

149
00:12:08,890 --> 00:12:10,910
!أنا أراقبهم جميعاً

150
00:12:10,910 --> 00:12:14,610
أيمكنك الاتّصال بمركز البلدة أيضاً إذاً؟

151
00:12:14,610 --> 00:12:15,950
ما الذي تتكلّمين عنه؟

152
00:12:15,950 --> 00:12:20,540
لمَ قد يتواجد أيّ سيليز
قرب عائلة شُني المُحترمة؟

153
00:12:20,540 --> 00:12:21,640
!غريبة أطوار

154
00:12:21,640 --> 00:12:23,200
...حسناً

155
00:12:24,790 --> 00:12:28,680
...أيّتها المرآة

156
00:12:28,680 --> 00:12:33,010
أخبريني بشيءٍ

157
00:12:33,680 --> 00:12:43,480
أخبريني من الأشدّ وحدة

158
00:12:39,190 --> 00:12:40,480
!بيرا

159
00:12:40,480 --> 00:12:42,960
!إنّها مغنّيةٌ تحبّ الغناء

160
00:12:42,960 --> 00:12:45,350
!تغني لأجل البلدة

161
00:12:45,350 --> 00:12:53,950
أيّتها المرآة، ما بداخلي؟

162
00:12:54,430 --> 00:13:05,200
أخبريني، أيمكن أن ينقلب
القلب حجراً؟

163
00:13:06,090 --> 00:13:11,220
مرآة، يا مرآة، ما ذاك الذي وراءك؟

164
00:13:11,220 --> 00:13:15,470
أنقذيني من الأشياء التي أراها

165
00:13:16,390 --> 00:13:20,650
يمكنني إخفائها من العالم

166
00:13:20,650 --> 00:13:26,110
لمَ لا تدعيني أختبئ منّي؟

167
00:13:26,590 --> 00:13:31,870
...مرآة، يا مرآة

168
00:13:28,500 --> 00:13:31,870
أختي؟ حسناً، أنا قادمة

169
00:13:31,870 --> 00:13:36,430
أخبريني بشيء

170
00:13:36,920 --> 00:13:47,320
من الأشدّ وحدة؟

171
00:13:50,450 --> 00:14:07,040
أنا الأشدّ وحدة

172
00:14:15,410 --> 00:14:18,770
أنتِ محقّة، اختفى الشيء الشبيه بالظلّ

173
00:14:18,770 --> 00:14:21,240
أتساءل لو كان ذاك المدخل؟

174
00:14:21,240 --> 00:14:24,560
ما يعني، يعترض ذلك الشيء طريقنا

175
00:14:28,420 --> 00:14:31,150
!انتظري! لا تهدريها

176
00:14:31,150 --> 00:14:33,550
لكن سيكون الأمر سهلاً
لو استعملنا طُعماً

177
00:14:33,550 --> 00:14:35,550
دعي ذلك عليّ

178
00:14:38,020 --> 00:14:39,680
!تمّ تحديد دخيل

179
00:14:52,610 --> 00:14:54,060
نجحنا

180
00:14:54,060 --> 00:14:55,060
أين بليك؟

181
00:14:55,470 --> 00:14:56,800
أنا هنا

182
00:14:58,910 --> 00:15:01,190
ما الذي تفعلانه؟

183
00:15:01,190 --> 00:15:03,580
فقدنا أثر الدخيل

184
00:15:10,340 --> 00:15:12,590
!رائع! نحن قريبات جدّاً

185
00:15:12,590 --> 00:15:15,140
لنستعمل هذه إذاً

186
00:15:18,000 --> 00:15:19,770
يمكننا الدخول والخروج من هنا

187
00:15:19,770 --> 00:15:22,070
واستعملنا قطعةً واحدة فحسب للآن

188
00:15:22,070 --> 00:15:24,060
!لدينا موارد كثيرة

189
00:15:24,060 --> 00:15:26,480
!هذا ما يُعرف بالعمل الجماعيّ

190
00:15:26,760 --> 00:15:29,850
!حسناً، لنذهب لإيقاظ وايس

191
00:15:42,180 --> 00:15:46,780
مكان استراحةٍ جميل
يجلب النوم الحقيقيّ

192
00:15:46,780 --> 00:15:51,480
يمكن للابنات الجديرات باسم شُني
وحدهنّ دخوله

193
00:16:03,500 --> 00:16:05,620
!أختي، هناك مشكلة

194
00:16:05,620 --> 00:16:07,770
أخبريني بأيّ شيء

195
00:16:07,770 --> 00:16:13,630
لننفّذ أيّ واجبٍ ضروريّ لإثبات جدارة
حملي لاسم عائلة شُني

196
00:16:13,630 --> 00:16:16,010
ما مدى حجمه؟

197
00:16:16,010 --> 00:16:20,220
ذلك يثبت تأثيره الكبير على حياة وايس

198
00:16:20,220 --> 00:16:22,960
فهمت، أنتِ ذكيّةٌ يا بليك

199
00:16:22,960 --> 00:16:24,640
ذلك محض تخمين

200
00:16:29,980 --> 00:16:32,450
رسالةٌ لكافة مواطني الإمبراطوريّة

201
00:16:32,450 --> 00:16:37,790
روبي روز ويانغ شاو لونغ هربتا
من برج نيكولاس العظيم

202
00:16:37,790 --> 00:16:40,490
إن تركناهما وشأنهما، ستقع أمورٌ كارثيّة

203
00:16:40,490 --> 00:16:42,770
على كافة مواطني الإمبراطوريّة التضامن

204
00:16:42,770 --> 00:16:44,740
!لإعادتهما للبرج

205
00:16:45,270 --> 00:16:49,490
ماذا؟ أي يُفترض أنّنا مُحتجزات
في مكانٍ ما في نطاق الحُلم؟

206
00:16:49,490 --> 00:16:50,820
ذلك ما يبدو

207
00:16:50,820 --> 00:16:54,130
نسخة الحلم خاصتيكما قد اختفيتا
عندما أتيتما، فيبدو أنّكما هربتما

208
00:16:54,130 --> 00:16:57,380
لكن أنا وأختي فحسب؟ ماذا عن بليك؟

209
00:16:57,380 --> 00:16:59,250
...حسناً، أنا متأكّدة

210
00:16:59,250 --> 00:17:02,110
أنّهم لم يلحظوا اختفاء بليك بعد

211
00:17:02,110 --> 00:17:05,390
أو ربما لستُ موجودةً
في حُلم وايس بالأصل

212
00:17:05,690 --> 00:17:09,860
في تلك الحالة، فاقلق من معاملة
ذهن وايس لي كدخيلة

213
00:17:09,860 --> 00:17:11,470
...دخيلة

214
00:17:11,470 --> 00:17:13,950
أسمعا، أهذا البرج الذي قصدته؟

215
00:17:13,950 --> 00:17:16,400
إنّه المكان الوحيد المنطقيّ

216
00:17:16,400 --> 00:17:20,650
،برأيي، إذا كانوا يسعون لإعادتنا هناك

217
00:17:20,960 --> 00:17:23,580
فلمَ لا نتماشى معهم؟

218
00:17:28,620 --> 00:17:31,290
!نستسلم! نحن نستسلم

219
00:17:36,830 --> 00:17:38,850
يا لمضيعة الوقت

220
00:17:39,300 --> 00:17:43,480
ربما قد يكون من الحكمة
البحث في بنيان المحيط أيضاً

221
00:17:43,480 --> 00:17:47,310
فلا نعلم أين قد تكون الفتاة
ذات الرداء الأسود مختبئة

222
00:18:03,920 --> 00:18:06,500
!يا إلهي، كلاين الغاضب

223
00:18:06,500 --> 00:18:08,200
!كلّ شيءٍ على ما يرام سيّدي

224
00:18:08,200 --> 00:18:10,030
!كلّا أيّها الأحمق

225
00:18:10,030 --> 00:18:12,800
!انظر لهذين الاثنتين يا كلاين النعسان

226
00:18:12,800 --> 00:18:14,770
عجباً، روبي-ساما ويانغ-ساما

227
00:18:14,770 --> 00:18:16,670
متى تجاوزتماني؟

228
00:18:16,960 --> 00:18:20,260
باب ناطق؟ هل دماغ وايس بخير؟

229
00:18:20,260 --> 00:18:21,420
...أختي

230
00:18:21,420 --> 00:18:22,890
!افتح الباب بسرعة

231
00:18:22,890 --> 00:18:24,700
!أمرك

232
00:18:32,170 --> 00:18:33,920
يا لها من غرفةٍ جميلة

233
00:18:34,490 --> 00:18:37,440
إنّها مليئةٌ بأشيائها الثمينة

234
00:18:37,900 --> 00:18:40,000
حتّى سريرنا ذو الطابقين

235
00:18:41,930 --> 00:18:44,180
ربما لطالما أرادت واحداً حقّاً

236
00:18:50,010 --> 00:18:51,030
ما هذا؟

237
00:18:52,060 --> 00:18:54,830
أهذه قطعة أثريّة؟

238
00:19:07,570 --> 00:19:12,460
لعلّ ذلك تجسّدٌ لإرادة
وايس-كن بمقاومة الكابوس

239
00:19:12,460 --> 00:19:16,600
مفتاحٌ لدخول أعماق ذهنها وإيقاظها

240
00:19:17,240 --> 00:19:19,110
فلتعتنوا به رجاءً

241
00:19:19,110 --> 00:19:21,090
مفهوم يا بروفسور

242
00:19:22,860 --> 00:19:24,260
ما قال البروفسور؟

243
00:19:24,260 --> 00:19:27,810
أنّها قطعةٌ هامة قد تمكّننا

244
00:19:27,810 --> 00:19:29,830
من دخول أعماق ذهن وايس وإيقاظها

245
00:19:30,540 --> 00:19:33,030
مهلاً، ما الذي تفعلينه؟

246
00:19:33,030 --> 00:19:35,120
سأستدعي بليك، لا يمكنني؟

247
00:19:35,120 --> 00:19:37,880
،حتّى لو وضعتِ باباً هنا
فلا يمكننا الخروج، صحيح؟

248
00:19:37,880 --> 00:19:40,170
فيُفترض أنّ هذه زنزانة

249
00:19:42,380 --> 00:19:43,880
أأنتما بخير؟

250
00:19:43,880 --> 00:19:45,130
!بليك

251
00:19:45,690 --> 00:19:47,510
هل وجدتِ مفتاح الباب؟

252
00:19:48,490 --> 00:19:51,100
حسناً... كان قفلاً بسيطاً جدّاً

253
00:19:51,100 --> 00:19:53,250
يمكنكِ فتح الأقفال؟

254
00:19:53,250 --> 00:19:55,960
!إذا نسيتُ مفتاح المهجع، فسأطلب مساعدتكِ

255
00:19:55,960 --> 00:19:59,340
صه! لنذهب قبل استيقاظه

256
00:19:59,340 --> 00:20:00,480
انتظرا

257
00:20:00,480 --> 00:20:04,210
ربما على إحدانا البقاء هنا، كيلا تلاحظ وايس

258
00:20:04,210 --> 00:20:07,240
!فهمت، هذا دهاءٌ منكِ يا روبي

259
00:20:07,550 --> 00:20:09,240
من ستبقى؟

260
00:20:12,460 --> 00:20:13,450
!رائع

261
00:20:14,960 --> 00:20:18,130
سأبقى، لكنّي أريد ترك
علامة أيضاً. لا بأس ذلك؟

262
00:20:18,130 --> 00:20:20,270
أرى أنّ ذلك للأفضل

263
00:20:20,270 --> 00:20:22,540
استعملي إحدى قطعكِ يا أختي

264
00:20:22,540 --> 00:20:23,630
حسناً، حسناً

265
00:20:27,380 --> 00:20:31,140
روبي-ساما، يانغ-ساما، أأنتما هنا؟

266
00:20:31,460 --> 00:20:33,140
نحن موجودتان، ارجع للنوم

267
00:20:37,420 --> 00:20:40,280
عندما بحثت، وجدتُ باباً يقود للأسفل

268
00:20:40,280 --> 00:20:43,470
قد يأخذنا لجوهر ذهنها
كما قال البروفسور

269
00:20:43,470 --> 00:20:45,320
!مذهل يا بليك

270
00:20:45,320 --> 00:20:48,640
!حتّى عندما كنتِ في طريقكِ لإنقاذنا، كنتِ تبحثين

271
00:20:48,640 --> 00:20:50,060
لم أقضِ وقتاً كثيراً

272
00:20:50,060 --> 00:20:52,640
آمل أن يفيد ذلك في شيء

273
00:20:53,140 --> 00:20:56,260
قد توجد واحدة أخرى أيضاً

274
00:20:56,260 --> 00:20:57,410
أخرى؟

275
00:20:57,410 --> 00:21:00,350
،كانت هذه حيث كنت وأختي

276
00:21:00,350 --> 00:21:05,060
فأرجّح أنّه توجد واحدة حيث
كانت نسختكِ في الحُلم أيضاً

277
00:21:05,060 --> 00:21:07,920
فهناك قطعتان أثريّتان في الواقع أيضاً، أليس كذلك؟

278
00:21:11,960 --> 00:21:12,930
سأفتحه

279
00:21:12,930 --> 00:21:13,930
حسناً

280
00:21:26,360 --> 00:21:27,570
ما هذا المكان؟

281
00:21:27,570 --> 00:21:30,570
لا أعتقد أنّنا سنستطيع عبوره مباشرةً

282
00:21:46,110 --> 00:21:47,580
كما توقّعت

283
00:21:48,220 --> 00:21:51,420
مهما أبعدتكِ من مرّات، لا تنفكّين عن الظهور

284
00:21:54,960 --> 00:21:56,410
سبق وأخبرتُكِ

285
00:21:57,940 --> 00:21:58,970
...لا مكان هنا

286
00:21:59,780 --> 00:22:01,790
للفاونس