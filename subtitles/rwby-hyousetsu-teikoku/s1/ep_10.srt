1
00:00:01,260 --> 00:00:02,970
لكن قد تكون هنالك طريقةٌ أخرى

2
00:00:02,970 --> 00:00:03,810
ماذا؟

3
00:00:04,230 --> 00:00:06,620
يانغ، ما الذي قلتِه؟

4
00:00:06,620 --> 00:00:08,670
أنا متأكّدةٌ أنّ روبي
تبذل قصارى جهدها

5
00:00:08,670 --> 00:00:10,480
كلّا، ما بعد ذلك

6
00:00:10,480 --> 00:00:11,840
...حسناً

7
00:00:11,840 --> 00:00:14,250
بخصوص حساسيّة الغريم؟

8
00:00:14,250 --> 00:00:15,260
أجل

9
00:00:15,260 --> 00:00:18,030
علينا استعمال الكابوس الذي تلبّس جون

10
00:00:18,030 --> 00:00:18,950
ماذا؟

11
00:00:18,950 --> 00:00:21,000
سأكلّم البروفسور شيون

12
00:00:21,310 --> 00:00:23,870
انتظري، وضّحي لي ما تنوين فعله

13
00:00:25,480 --> 00:00:27,910
لا يزال الكابوس الآخر حيّاً

14
00:00:27,910 --> 00:00:29,630
سأجعله يتلبّسني

15
00:00:33,250 --> 00:00:38,010
إن كنّا لا نستطيع مجاراة وايس السلبيّة
في الحُلم، فسأصبح نظيرةً لها

16
00:00:38,010 --> 00:00:39,470
أأنتِ بعقلك؟

17
00:00:39,470 --> 00:00:42,770
أتعتقدين أنّي سأقف وأشاهدكِ
تصبحين بليك سلبيّة؟

18
00:00:43,110 --> 00:00:45,930
علينا فعل ذلك لطرد الكابوس
الذي يتلبّس وايس

19
00:00:45,930 --> 00:00:47,570
وما الذي سيحلّ بكِ؟

20
00:00:47,570 --> 00:00:49,070
سيحين دوركِ ودور روبي

21
00:00:51,610 --> 00:00:55,030
بعد تحريركما للـ وايس، يمكنكما تحريري

22
00:00:55,780 --> 00:00:57,630
!لا يمكنكِ اتّخاذ ذلك بنفسك

23
00:00:57,630 --> 00:00:59,630
أهنالك ضمانٌ على نجاح الخطّة؟

24
00:00:59,630 --> 00:01:02,700
رأيتِ مدى الحرّية التي
يتحرّك بها جون

25
00:01:02,700 --> 00:01:04,640
لها احتمالٌ عالٍ بالنجاح

26
00:01:04,640 --> 00:01:07,790
!لكن لا يقتضي ذلك أن تكوني من تفعلها

27
00:01:08,140 --> 00:01:10,290
أمعني النظر في هذا المكان يا يانغ

28
00:01:10,820 --> 00:01:14,920
أي ستقومين بالأمر لأنّكِ
فاونس التحقت بالمخلب الأبيض؟

29
00:01:15,620 --> 00:01:17,930
أتمقتين وايس في الواقع؟

30
00:01:19,190 --> 00:01:20,240
كلّا

31
00:01:21,190 --> 00:01:24,310
هذه مجموعةٌ من الأشياء التي تريد وايس

32
00:01:24,310 --> 00:01:26,980
تفاديها، أو لا تستطيع فهمها غالباً

33
00:01:26,980 --> 00:01:31,100
لكنّها لا تتجاهلها. لا، بلا يمكنها

34
00:01:31,570 --> 00:01:33,690
وتعتقدين أنّها ستتجاهلني؟

35
00:01:34,020 --> 00:01:37,410
عائلة شُني والمخلب الأبيض بمثابة
مرآتين مُتقابلتين

36
00:01:37,410 --> 00:01:38,820
تعكسان بعضهما

37
00:01:39,690 --> 00:01:44,550
إن تلبّسني الكابوس، فيُفترض أن يظهر
المكان المُعاكس لهذا

38
00:01:45,750 --> 00:01:48,060
جالباً معه ذكريات اضطهاد الفاونس

39
00:01:48,820 --> 00:01:51,090
ما المعنى من جعلها ترى ذلك؟

40
00:01:51,090 --> 00:01:54,530
إن واجهتُ ووايس بعضنا وأدركنا
أنّنا صديقتين ومُتكافئتين

41
00:01:54,530 --> 00:01:56,200
فيُفترض أن نلغي بعضنا

42
00:01:56,910 --> 00:01:59,450
،إن أدركنا أنّنا انعكاسٌ لبعضنا الآخر

43
00:01:59,450 --> 00:02:01,480
فسنستوعب أنّ لا داعي للبغض

44
00:02:01,480 --> 00:02:06,110
قد يُفلح ذلك على أرض الواقع، لكن قد
تفقدان السيطرة على نفسيكما في الحُلم

45
00:02:06,110 --> 00:02:08,350
يجب حصول ذلك بدايةً

46
00:02:08,350 --> 00:02:11,350
لا تهاجم الكوابيس بعضها في العادة

47
00:02:11,350 --> 00:02:14,400
نحتاج لسببٍ يبرّر معارضة كابوسٍ آخر

48
00:02:14,400 --> 00:02:16,270
وإلّا لن تنجح هذه الخطّة

49
00:02:17,710 --> 00:02:19,050
أرجوكِ يا يانغ

50
00:02:19,050 --> 00:02:23,520
هذا الشيء الوحيد الذي بإمكاني
فعله لمساعدة وايس الآن

51
00:02:33,160 --> 00:02:35,570
يا إلهي... أستسلم

52
00:02:36,790 --> 00:02:40,260
لكن لنسأل البروفسور عن إمكانيّة الأمر أوّلاً

53
00:02:40,580 --> 00:02:42,590
لنفعل ذلك الآن إذاً

54
00:04:15,410 --> 00:04:17,390
لديكنّ خطّةٌ جديد؟

55
00:04:18,390 --> 00:04:22,360
قبل ذلك، عليكنّ الحرص على ألّا
تفقدن القطعة الأثريّة بحوزتكنّ

56
00:04:22,780 --> 00:04:25,620
إنّها المفتاح الأخير غالباً

57
00:04:26,010 --> 00:04:30,130
خطّة جديدة؟ أيعني ذلك أنّ السابقة قد فشلت؟

58
00:04:30,440 --> 00:04:34,380
ربما، أتساءل لو بإمكاننا المساعدة

59
00:04:34,750 --> 00:04:39,820
بروفسور أوزبين، أيمكننا دخول حلم وايس أيضاً؟

60
00:04:39,820 --> 00:04:43,120
أرسلنا أربعة أشخاصٍ لحلم وايس-كن سلفاً

61
00:04:43,590 --> 00:04:45,890
لن يتحمّل سيمبلانس وايس المزيد

62
00:04:45,890 --> 00:04:47,880
ماذا لو تبادلنا إذاً؟

63
00:04:47,880 --> 00:04:51,090
صحيح، كانت روبي في خطر

64
00:04:51,630 --> 00:04:53,380
دعنا نأخذ أماكنهم

65
00:04:53,380 --> 00:04:56,750
إن اقتضى الأمر، فستخبرنا شيون

66
00:04:56,750 --> 00:04:58,650
لنثق بهم الآن وننتظر

67
00:04:59,280 --> 00:05:02,830
ثقوا بأصدقائكم الذين سيقاتلون
بجانبكم يوماً ما

68
00:05:04,680 --> 00:05:10,230
إن استعملنا الكابوس الذي تلبّس
جون-كن، فهذه الخطّة مُحتملة

69
00:05:12,290 --> 00:05:19,050
تخاطر

70
00:05:12,630 --> 00:05:16,590
لكن هنالك احتمالٌ بعدم
نجاة أيٍّ منكم

71
00:05:16,590 --> 00:05:19,050
لا أستطيع ضمان نجاحكم

72
00:05:19,380 --> 00:05:21,610
رأيتِ؟ أخبرتكِ أنّها خطرة

73
00:05:23,080 --> 00:05:27,530
بالوضع الحالي، ألدينا أيّة خطط فعّالة أخرى؟

74
00:05:27,530 --> 00:05:29,690
للأسف، كلّا

75
00:05:30,570 --> 00:05:33,020
هل نفعلها إذاً؟

76
00:05:47,840 --> 00:05:49,710
أعطى المدير موافقته

77
00:05:49,710 --> 00:05:52,100
يا إلهي، جدّياً؟

78
00:05:53,160 --> 00:05:55,010
هل نبدأ فوراً؟

79
00:05:55,010 --> 00:05:57,840
أجل، لا تزال لديكم عملات، صحيح؟

80
00:05:57,840 --> 00:06:00,590
لديّ عملة، ولـ يانغ اثنتان

81
00:06:00,590 --> 00:06:02,630
لا أدري عن روبي والبقيّة

82
00:06:03,130 --> 00:06:06,310
عليكما ادّخار عملةٍ لكلتيكما

83
00:06:06,870 --> 00:06:11,840
إن ضعف تحكّم الكابوس، فيمكن استعمال
عملةٍ لإيقاظ بليك-كن

84
00:06:12,660 --> 00:06:17,440
ستحتاجون للعملة الأخرى لإخراج
الجميع من الحلم

85
00:06:17,440 --> 00:06:18,780
فهمت

86
00:06:18,780 --> 00:06:24,660
سيتلبّسكِ فوراً، فلتبتعدي بمسافة كافية
عن بليك-كن يا يانغ-كن

87
00:06:25,050 --> 00:06:29,790
عندما يتداخل الحلمان، قد تقع تحوّلات غير متوقّعة

88
00:06:30,060 --> 00:06:31,060
حاضرة

89
00:06:31,800 --> 00:06:32,790
أأنتِ جاهزة؟

90
00:06:34,700 --> 00:06:35,690
يانغ؟

91
00:06:44,290 --> 00:06:47,260
!حسناً! أنا جاهزة، لنفعلها

92
00:06:48,410 --> 00:06:49,180
...يانغ

93
00:06:51,000 --> 00:06:54,910
إنّه رهان خطر، لكنّي أثق بقدرتهما

94
00:06:55,580 --> 00:06:57,930
إنّهما صلبتا العزيمة

95
00:06:57,930 --> 00:07:01,770
ولا تزالان تخفيان قواهما الحقيقيّة

96
00:07:02,280 --> 00:07:04,840
،إن أصابك ما أصاب وايس يا رين

97
00:07:04,840 --> 00:07:07,780
فأتوقّع أنّي كنت سأفعل
مثلما فعلت بليك

98
00:07:08,170 --> 00:07:11,770
لكنّي أجيد تفادي الغريم

99
00:07:11,770 --> 00:07:13,080
أنسيتِ؟

100
00:07:13,080 --> 00:07:15,400
كنتُ أفترض فحسب

101
00:07:15,400 --> 00:07:18,790
إن أصابكِ الأمر يا نورا، فكنتُ لأفعل الأمر نفسه

102
00:07:20,840 --> 00:07:25,450
وجدتٍ لنفسكِ فريقاً جديراً يا وايس

103
00:07:25,860 --> 00:07:26,930
بالتوفيق

104
00:07:43,010 --> 00:07:44,220
سأبدأ

105
00:08:53,730 --> 00:08:55,960
بدأ الأمر، اذهبي يا يانغ

106
00:08:55,960 --> 00:08:58,190
!سأوقظكِ لاحقاً بالتأكيد

107
00:09:00,390 --> 00:09:01,810
!لا يُغلق

108
00:09:06,110 --> 00:09:09,780
ماذا؟ أستغادرين بالفعل؟

109
00:09:13,220 --> 00:09:15,040
ما كلّ هذا عن الأصدقاء؟

110
00:09:15,040 --> 00:09:16,200
!آدم

111
00:09:16,200 --> 00:09:18,870
هل اعتقدتِ أنّ بإمكانكِ الوصول لتفاهم

112
00:09:18,870 --> 00:09:20,620
مع ابنة لعائلة شُني حقّاً؟

113
00:09:21,560 --> 00:09:23,430
أنت كابوسي إذاً

114
00:09:23,430 --> 00:09:27,030
لا بدّ أنّكِ تندمين على خيانة المخلب الأبيض، أليس كذلك؟

115
00:09:27,700 --> 00:09:31,790
أستواصلين إخفاء كونكِ من بني الفاونس؟

116
00:09:34,890 --> 00:09:36,890
لا أندم على شيء

117
00:09:36,890 --> 00:09:39,630
أعرف أنّ أصدقائي سيتقبّلونني

118
00:09:49,070 --> 00:09:52,700
يخالفكِ الظلام في قلبكِ

119
00:10:13,820 --> 00:10:16,470
...ماذا؟ هنالك أمرٌ غر

120
00:10:22,390 --> 00:10:24,370
!لـ-لحظة

121
00:10:24,370 --> 00:10:28,280
!بليك! أستكونين بخيرٍ حقّاً؟! أخبريني

122
00:10:31,900 --> 00:10:33,070
ما الذي يجري؟

123
00:10:54,220 --> 00:10:55,310
...بليك

124
00:11:01,860 --> 00:11:06,350
،باسم المخلب الأبيض، ولأجل كلّ الفاونس

125
00:11:06,350 --> 00:11:09,230
!ادفنوا شركة غبار شُني

126
00:11:58,920 --> 00:12:01,430
أهذه... عباءة جون؟

127
00:12:41,030 --> 00:12:41,820
0

128
00:12:46,440 --> 00:12:48,710
تأخّرتُ قليلاً

129
00:12:50,180 --> 00:12:52,150
!لذا سأسابق الريح

130
00:13:12,210 --> 00:13:14,050
ما الذي يجري؟

131
00:13:19,230 --> 00:13:20,380
!يانغ

132
00:13:20,820 --> 00:13:21,850
!مرحباً

133
00:13:22,250 --> 00:13:24,920
المخلب الأبيض؟ لمَ؟

134
00:13:30,530 --> 00:13:32,530
!يا ابنة عائلة شُني

135
00:13:32,530 --> 00:13:34,290
...بين البشر والفاونس

136
00:13:34,290 --> 00:13:38,460
!سأريكِ أيّهما الأسمى والأعدل

137
00:13:38,460 --> 00:13:39,660
بليك؟

138
00:13:50,910 --> 00:13:54,470
!ما هذه الهيئة؟ كفّي عن العبث

139
00:13:55,940 --> 00:13:58,810
أيبدو لكِ أنّي أعبث؟

140
00:14:35,750 --> 00:14:36,850
!روبي

141
00:14:37,180 --> 00:14:38,520
!أختي

142
00:14:43,280 --> 00:14:45,540
ما الذي يجري هنا؟

143
00:15:01,040 --> 00:15:02,540
!روبي، هذه

144
00:15:06,080 --> 00:15:06,880
!أختي

145
00:15:10,110 --> 00:15:10,920
!اصعدي

146
00:15:16,040 --> 00:15:17,010
خذيها

147
00:15:18,490 --> 00:15:19,850
قطعة أثريّة؟

148
00:15:23,810 --> 00:15:25,350
أأنتِ بخيرٍ يا روبي؟

149
00:15:25,350 --> 00:15:28,610
أجل، لا يزال بإمكاني القتال

150
00:15:29,110 --> 00:15:31,490
ستوقف بليك وايس السلبيّة

151
00:15:31,490 --> 00:15:35,360
سأشغل انتباهه، لذا استغلّي الفرصة
!واقضي على الغريم

152
00:15:35,360 --> 00:15:36,430
!حسناً

153
00:15:37,550 --> 00:15:39,370
!أعتمد عليكِ أيّتها القائدة

154
00:16:07,510 --> 00:16:09,940
!وجدتُ حمقاء

155
00:16:23,320 --> 00:16:27,410
أهكذا أردتِ منّي استعماله يا وايس؟

156
00:16:53,800 --> 00:16:55,290
...مؤلم

157
00:16:55,920 --> 00:16:56,650
ماذا؟

158
00:17:11,440 --> 00:17:14,130
!مذهل، في الأحلام فقط

159
00:17:21,460 --> 00:17:22,600
!خذ

160
00:17:32,370 --> 00:17:34,110
أوقفي هذه السذاجة

161
00:17:34,520 --> 00:17:39,430
،إن توجّب عليّ الحكم عليكِ أكثر
!فسيتخطّى الأمر مجرّد النفي

162
00:17:39,430 --> 00:17:42,160
حكم؟ تقولين حكم؟

163
00:17:45,990 --> 00:17:49,500
متى حكم جنسكم على الفاونس بعدل؟

164
00:17:49,840 --> 00:17:56,450
كم عانى من الفاونس الأبرياء
!حكماً مجحفاً بنزواتكم؟

165
00:17:56,910 --> 00:17:58,540
ما الذي قلتِه؟

166
00:17:58,540 --> 00:18:01,750
،سلبتم أراضينا، فخرنا

167
00:18:01,750 --> 00:18:03,760
وعندما قاومنا، سلبتم أرواحنا

168
00:18:03,760 --> 00:18:06,010
!أولئك أنتم

169
00:18:19,080 --> 00:18:21,810
الكابوس ينمو سريعاً

170
00:18:22,530 --> 00:18:26,030
،لا تملك بليك-كن هالةً صُلبةً فحسب

171
00:18:26,520 --> 00:18:30,790
لكنّها قبلت الكابوس بإرادتها فوق ذلك

172
00:18:31,140 --> 00:18:34,970
ألن يعسّر ذلك إنقاذها؟

173
00:18:39,750 --> 00:18:41,230
،بما أنّ الأمر كان بإرادتها

174
00:18:41,230 --> 00:18:44,840
هنالك احتمالٌ عالٍ بقدرة قلب
بليك-كن على مواصلة المقاومة

175
00:18:46,130 --> 00:18:49,750
تكمن المشكلة في صمود
السيمبلانس خاصّتي من عدمه

176
00:18:50,260 --> 00:18:55,450
كما، تمكّنهم من هزيمة الكابوس
الذي يتلبّس وايس-كن

177
00:18:56,830 --> 00:19:00,320
،إن لم تُفلح خطّة روبي-كن والبقيّة كما رسموها

178
00:19:00,850 --> 00:19:03,180
فلن تكون هناك سبلٌ أخرى لإنقاذ وايس-كن

179
00:19:18,600 --> 00:19:20,960
شكراً لكِ يا وايس

180
00:19:21,620 --> 00:19:23,530
أنتِ تقاتلين أيضاً، أليس كذلك؟

181
00:19:24,060 --> 00:19:28,310
سأقاتل معكِ، لذا لنهزم الغريم معاً هذه المرّة

182
00:19:41,510 --> 00:19:43,220
لمَ تقومين بهذا؟

183
00:19:43,220 --> 00:19:45,400
ما الذي تقولين أنّي فعلتُه؟

184
00:19:46,550 --> 00:19:50,530
هذا ما أملتِه تماماً
يا ابنة عائلة شُني

185
00:19:50,530 --> 00:19:55,380
جلبتُ لكِ حشداً من الفاونس الشرسين الهائجين

186
00:19:55,380 --> 00:19:57,270
!وزّعي أحكاماً قدرما تشائين

187
00:19:57,270 --> 00:19:59,540
!ذلك إن استطعتِ

188
00:20:00,090 --> 00:20:02,410
متى قلتُ أنّي أردت ذلك؟

189
00:20:02,410 --> 00:20:04,760
ما الضغينة التي تكنّينها لي؟

190
00:20:04,760 --> 00:20:09,380
بكم شكل آذيتمونا نحن الفاونس؟

191
00:20:09,380 --> 00:20:13,390
جعلتمونا نقاتل الغريم، تستغلوننا
،في حروبكم بني البشر

192
00:20:13,390 --> 00:20:16,760
ثمّ تطردوننا

193
00:20:16,760 --> 00:20:19,310
!لم أفعل أيّاً من ذلك

194
00:20:19,610 --> 00:20:23,400
...لا أبغض كلّ الفاونس

195
00:20:23,400 --> 00:20:27,500
!بصفتكِ ابنة عائلة شُني، ستدفعين الثمن

196
00:20:27,500 --> 00:20:28,820
...لكن

197
00:20:33,120 --> 00:20:35,750
أأنتِ بليك حقّاً؟

198
00:20:36,100 --> 00:20:39,870
لن تقول بليك التي أعرفها
أشياء كتلك أبداً

199
00:20:41,280 --> 00:20:44,510
!لا تعرفين شيئاً عنّي

200
00:20:47,210 --> 00:20:48,700
لا بأس

201
00:20:48,700 --> 00:20:52,100
سأخلع ذاك القناع وأعيدكِ لعقلك

202
00:20:52,100 --> 00:20:54,870
ثمّ أطبّق عليكِ الحكم الأخير

203
00:20:55,690 --> 00:20:58,620
كيلا تستيقظي مُجدّداً من حلمكِ

204
00:20:59,360 --> 00:21:01,770
فلتجرّبي إن استطعتِ

205
00:21:01,770 --> 00:21:04,240
!يا ابنة عائلة شُني