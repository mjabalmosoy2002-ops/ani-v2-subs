1
00:00:13,260 --> 00:00:15,030
،أبي العزيز

2
00:00:15,030 --> 00:00:18,590
كيف حالك؟ أنا بخيرٍ تماماً

3
00:00:18,590 --> 00:00:23,080
،أصبحتُ في نفس الفريق مع أختي
أليس ذلك رائعاً؟

4
00:00:23,590 --> 00:00:26,250
،إلى أختي العزيزة وينتر

5
00:00:26,250 --> 00:00:28,430
آمل أنّكِ بخير حال

6
00:00:28,430 --> 00:00:31,590
،مُذ دخلت أكاديميّة بيكون

7
00:00:31,590 --> 00:00:34,470
حافظتُ على أعلى العلامات في فصلي

8
00:00:34,470 --> 00:00:36,520
!حصل شيءٌ أكثر روعة أيضاً

9
00:00:36,520 --> 00:00:38,470
!أصبحتُ قائدة فريق

10
00:00:38,910 --> 00:00:41,310
"يُدعى بالفريق "روبي

11
00:00:41,310 --> 00:00:46,140
انتابني الخجل ولم أكن أتحلّى
بأيّ ثقةٍ بما أنّي الأصغر

12
00:00:46,140 --> 00:00:48,910
،لكن ساعدني جميع الرفاق

13
00:00:48,910 --> 00:00:50,610
وأشعر أنّي أستطيع فعلها الآن

14
00:00:50,610 --> 00:00:54,450
قرّرت الأكاديميّة عدم جعلي القائدة

15
00:00:54,450 --> 00:00:57,590
بدل ذلك، أعطوني مسؤوليّة مساندة

16
00:00:57,590 --> 00:01:00,120
فريقي كليّاً كالزميلة المثاليّة

17
00:01:00,570 --> 00:01:02,690
قائدتنا هي روبي روز

18
00:01:02,690 --> 00:01:05,120
إنّها الأصغر سنّاً ومرتبكةٌ نوعاً ما

19
00:01:05,120 --> 00:01:07,270
،لكنّها تتحلّى بشجاعةٍ استثنائيّة

20
00:01:07,270 --> 00:01:10,540
وعليّ الاعتراف بامتلاكها لكلّ
مقوّمات الصيّادة الممتازة

21
00:01:10,090 --> 00:01:11,130
فائزة                                                        خاسرة

22
00:01:11,130 --> 00:01:13,370
...أنقذتني عندما كنتُ في مأزق

23
00:01:13,370 --> 00:01:17,190
،حسناً، لم تقم بذاك القدر حقّاً

24
00:01:17,190 --> 00:01:19,590
لكنّها قائدةٌ يُعتمد عليها

25
00:01:19,590 --> 00:01:23,640
وإحدى صديقاتي اللواتي
حصلت عليهنّ في الأكاديميّة

26
00:01:23,980 --> 00:01:28,650
ظننتُ أنّ عليّ التمرّن على صنع
،الأسلحة والقتال فحسب

27
00:01:29,240 --> 00:01:31,350
،لكن كي أصبح صيّاد

28
00:01:31,350 --> 00:01:34,780
أتعلّم حالياً أشياء متنوّعة
لم يسبق وأن فكّرتُ بها

29
00:01:35,350 --> 00:01:38,230
مثل معنى الثقة بالآخرين

30
00:01:41,090 --> 00:01:44,470
،لو أخبرتِني في البداية
لأصغيتُ إليكِ بسرور

31
00:01:44,470 --> 00:01:46,230
!لكنّكِ من هربت

32
00:01:46,230 --> 00:01:48,870
لكنّكِ ما كنتِ لتصغين لي بالأصل، أليس كذلك؟

33
00:01:48,870 --> 00:01:52,980
لا تفهمين الجرح الذي يسبّبه ذلك، صحيح؟

34
00:01:52,980 --> 00:01:57,050
ولا تفهمين الحنق الذي يسبّبه
اعتقادكِ أنّي لن أبالي

35
00:01:57,050 --> 00:01:59,140
ألستُ محقّة؟

36
00:01:59,140 --> 00:02:04,270
من الآن فصاعداً، تعالي وحادثينا
متى حصل شيءٌ من فضلكِ

37
00:02:04,270 --> 00:02:05,540
فهمتِ

38
00:02:05,540 --> 00:02:06,900
أحقّاً ذلك؟

39
00:02:07,650 --> 00:02:10,270
أجل، كانت غلطتي أيضاً

40
00:02:10,590 --> 00:02:12,700
سأبذل جهداً أكبر للثقة بكنّ

41
00:02:13,660 --> 00:02:14,700
...إذاً

42
00:02:22,950 --> 00:02:25,540
!حسنٌ، انتهى المسألة الآن

43
00:02:25,540 --> 00:02:27,040
ألا تشعران بارتياح؟

44
00:02:27,040 --> 00:02:29,440
بلى، أفضل بكثير

45
00:02:29,440 --> 00:02:30,580
وأنا كذلك

46
00:02:31,670 --> 00:02:33,890
!سيكون ذلك شعار الفريق روبي

47
00:02:33,890 --> 00:02:37,170
من الآن فصاعداً، لنتواصل
ونحاول فهم بعضنا

48
00:02:37,540 --> 00:02:41,680
لا يمكنك التأكّد من فهمك لأحدهم
ما لم تدخل حُلمه

49
00:02:41,680 --> 00:02:43,890
القلب البشريّ غامضٌ حقّاً

50
00:02:44,550 --> 00:02:47,380
يا إلهي، هلّا توقّفتِ عن الكلام عن الأحلام؟

51
00:02:49,190 --> 00:02:52,530
...غموض القلب البشريّ

52
00:02:52,530 --> 00:02:55,570
لا تزال هناك أشياء كثيرة
أمامي عليّ تعلّمها

53
00:02:56,410 --> 00:02:58,050
قبل فترة قصيرة

54
00:02:58,050 --> 00:03:00,990
،شعرتُ بأنّ الحمل ثقيلٌ عليّ
ولم أعرف ما أفعل

55
00:03:00,990 --> 00:03:02,780
لكنّي أتطلّع للأمر الآن

56
00:03:38,020 --> 00:03:42,990
كان السيمبلانس خاصّتي الأصل
هو قدرة قراءة قلوب الناس

57
00:03:43,830 --> 00:03:47,990
يحمل الجميع النور والظلام داخلهم

58
00:03:48,700 --> 00:03:51,270
لكن لا يمثل أيّ منهما
الشخص بأكمله

59
00:03:52,160 --> 00:03:54,280
القلب أكثر تعقيداً من ذلك بكثير

60
00:03:55,010 --> 00:03:57,430
تمكّنتُ من استيعاب ذلك أخيراً

61
00:03:57,430 --> 00:04:00,020
بسبب ما تعلّمتُه هنا في الأكاديميّة

62
00:04:01,100 --> 00:04:04,370
،عندما التقيتُ غريم الكابوس

63
00:04:04,860 --> 00:04:08,740
نما السيمبلانس خاصّتي
بطرقٍ غير متوقّعة

64
00:04:09,680 --> 00:04:13,690
طوّر قدرة هزيمة الغريم
الذي يتلبّس قلوب الناس

65
00:04:14,030 --> 00:04:16,190
نما السيمبلانس خاصّتك؟

66
00:04:16,190 --> 00:04:17,400
أجل

67
00:04:17,400 --> 00:04:20,700
اكتشفتُ أيضاً أنّ الكوابيس تنجذب للأشخاص

68
00:04:20,700 --> 00:04:23,080
الذين يمتلكون هالات قويّة
لكن شخصيّات حسّاسة

69
00:04:23,080 --> 00:04:26,200
من ناحية، تلك علامة على امتلاكهم
لمهاراتٍ استثنائيّة

70
00:04:26,500 --> 00:04:28,500
سمعتِ؟ ألستِ سعيدة؟

71
00:04:28,500 --> 00:04:31,700
هلّا توقّفتِ عن رشّ الملح على جرحي؟

72
00:04:31,700 --> 00:04:36,510
بنهاية المطاف، سينمو السيمبلانس خاصّتكم
رفقة هالاتكم

73
00:04:36,870 --> 00:04:39,710
منيراً دربكم للأمام كصيّادين

74
00:04:39,710 --> 00:04:43,310
مع أنّ قائدنا لا يزال
لا يملك سيمبلانس حتّى

75
00:04:43,310 --> 00:04:44,480
نورا

76
00:04:44,890 --> 00:04:46,880
سيكون جون بخير

77
00:04:47,720 --> 00:04:53,140
الفريق روبي، الفريق جنبر، كلاكما فريقان مذهلان

78
00:04:53,660 --> 00:04:56,650
أتطلّع قدماً لرؤية نموّكم

79
00:04:58,980 --> 00:05:01,820
شكراً جزيلاً لك يا بروفسور شيون

80
00:05:02,310 --> 00:05:05,860
سنبذل قصارى جهدنا لنصبح
صيّادين بأسرع ما يمكن

81
00:05:05,860 --> 00:05:08,620
كي نستطيع العمل معكم

82
00:05:09,460 --> 00:05:11,970
أجل، أعلّق آمالي عليكم

83
00:05:14,870 --> 00:05:19,590
يبدو أنّ هذا سيكون عاماً
مثيراً للاهتمام حقّاً يا بروفسور أوزبين

84
00:05:19,590 --> 00:05:24,090
أيمكننا افتراض أنّه لم تعد هناك
كوابيس في هذه المنطقة؟

85
00:05:24,090 --> 00:05:28,380
أجل، انتهى عملي هنا

86
00:05:29,510 --> 00:05:34,890
أدعو بأن يقودك طريقك للبركة
والسعادة يا شيون زايدين

87
00:05:44,050 --> 00:05:48,530
،روبي-كن، بليك-كن، أودّ الكلام
مع كلّ منكما على حدة

88
00:05:49,030 --> 00:05:50,040
حسناً؟

89
00:06:02,700 --> 00:06:06,050
أبليتِ حسناً في هزيمة الكابوس

90
00:06:06,410 --> 00:06:10,300
هل لا يزال يراودكِ قلقٌ حيال
عدم استحقاقكِ لمنصب القائدة؟

91
00:06:10,300 --> 00:06:13,810
لستُ متأكّدة من استحقاقي
بعد في الواقع

92
00:06:14,540 --> 00:06:17,550
لكنّي قرّرت بذل قصارى
ما لديّ بأيّ حال

93
00:06:17,550 --> 00:06:19,310
رفقة زميلاتي

94
00:06:23,310 --> 00:06:26,540
،بالمناسبة، عندما هزمتم الكابوس

95
00:06:26,540 --> 00:06:27,820
أشعرتِ بشيء ما؟

96
00:06:29,320 --> 00:06:31,810
شيء ما؟ ما قصدك؟

97
00:06:32,320 --> 00:06:36,970
على سبيل المثال، قوّة مختلفة
عن الهالة أو السيمبلانس

98
00:06:37,410 --> 00:06:42,450
،حسناً... كنتُ أقاتل باستماتة
فلا أتذكّر بصراحة

99
00:06:42,880 --> 00:06:43,880
...صحيح

100
00:06:43,880 --> 00:06:47,920
أتذكّر تمكّني من النجاح
لوجود صديقاتي معي

101
00:06:47,920 --> 00:06:51,930
أدركتُ مدى قوّة الصداقة

102
00:06:54,930 --> 00:06:57,380
التجارب الكثيرة التي ستخوضينها مستقبلاً

103
00:06:57,380 --> 00:07:00,680
ستوقظ القوّة النائمة داخلكِ غالباً

104
00:07:01,500 --> 00:07:03,610
أتطلّع لمواصلتكِ التعلّم

105
00:07:03,610 --> 00:07:06,370
كي تصبحي صيّادةً متفوّقة

106
00:07:13,160 --> 00:07:14,320
كنتنّ بانتظاري؟

107
00:07:14,320 --> 00:07:16,570
نريد معرفة ما تكلّمتما فيه

108
00:07:16,570 --> 00:07:23,240
حسناً، تكلّمت عن القوّة التي تكتسبها
بامتلاكك لأصدقاء في المعارك

109
00:07:23,240 --> 00:07:25,830
أخبرني بمواصلة التعلّم وبذل جهدي

110
00:07:25,830 --> 00:07:28,210
أي كان يطريكِ بشكلٍ عام

111
00:07:28,640 --> 00:07:31,090
لمَ طلب مقابلة بليك أيضاً إذاً؟

112
00:07:31,090 --> 00:07:33,640
سأعرف بعدما أكلّم البروفسور أوزبين

113
00:07:35,600 --> 00:07:37,880
لمَ لا تسبقنني للبلدة؟

114
00:07:37,880 --> 00:07:39,860
لا حاجة لتنتظرنني

115
00:07:39,860 --> 00:07:43,100
حسناً، سندعو الفريق جنبر
ونتوجّه لمقهى

116
00:07:54,970 --> 00:07:58,470
،ردعتِ عمليّة سرقة في حوض السفن

117
00:07:58,470 --> 00:08:03,370
ثمّ أظهرتِ روح مبادرةٍ وقوّة كبيرة
في هزيمة الكابوس

118
00:08:04,120 --> 00:08:06,650
لديكِ إمكانيّات مذهلة

119
00:08:07,130 --> 00:08:10,170
قمتُ بما كان عليّ فعله فحسب

120
00:08:11,130 --> 00:08:13,640
،للالتحاق بأكاديميّتي

121
00:08:13,640 --> 00:08:16,510
على التلامذة اجتياز اختبار
القبول الشاق أوّلاً

122
00:08:16,510 --> 00:08:21,640
لذلك، يمضي الكثير من المتقدّمين أعواماً
في التمرينات التحضيريّة في مدارس قتاليّة

123
00:08:21,640 --> 00:08:25,650
لكن لا سجّل هناك بتمرينكِ

124
00:08:25,650 --> 00:08:30,150
ومع ذلك، نجحتِ في الاختبار بتفوّق
والتحقتِ بالأكاديميّة

125
00:08:30,770 --> 00:08:34,830
،في العالم الذي ترعرعتُ فيه
كان كلّ يومٍ بمثابة قتال

126
00:08:35,430 --> 00:08:38,670
كان عليّ تعلّم الكفاح للنجاة

127
00:08:39,160 --> 00:08:41,730
أقدّر عزيمتكِ

128
00:08:41,730 --> 00:08:44,500
تقبل مدرستنا التلامذة من كافّة أشكال الحياة

129
00:08:44,500 --> 00:08:48,180
...الأغنياء... الفقراء... البشر

130
00:08:50,570 --> 00:08:51,740
والفاونس

131
00:08:54,660 --> 00:08:57,550
لمَ تخفين هويّتكِ بذاك الشريط؟

132
00:08:57,550 --> 00:09:00,810
،لدينا الكثير من التلامذة الفاونس هنا

133
00:09:00,810 --> 00:09:05,550
ولم يسبق أن سألنا تلامذة التبادل
ما إن كانوا فاونس أم لا

134
00:09:06,060 --> 00:09:10,070
،رغم سياستكم الرائعة بالمساواة

135
00:09:10,070 --> 00:09:12,460
سيرفض بعض الناس الفاونس

136
00:09:13,070 --> 00:09:14,390
معكِ حقّ

137
00:09:14,390 --> 00:09:19,070
لكن يعمل الكثير من الناس يوميّاً
لإزالة ذاك التمييز

138
00:09:19,070 --> 00:09:21,680
وأودّ طلب مساعدتكِ في ذلك

139
00:09:21,680 --> 00:09:25,080
مع احترامي، الأمر ليس بتلك السهولة

140
00:09:25,480 --> 00:09:32,090
في الوقت الراهن، أريد أن يراني الناس
على من أكون، وليس مرجعي

141
00:09:32,090 --> 00:09:36,590
أتفهّم شعوركِ، لا نيّة لي بإرغامك

142
00:09:39,600 --> 00:09:42,400
من تكونين بالضبط إذاً؟

143
00:09:43,330 --> 00:09:46,600
لا أفهم... ما الذي تقصده

144
00:09:46,600 --> 00:09:50,100
أكنتِ تعرفين أنّ المخلب الأبيض
سيتواجدون عند حوض السفن؟

145
00:09:50,100 --> 00:09:52,610
كانت محض مصادفة

146
00:09:52,610 --> 00:09:54,220
صادف أن كنت هناك

147
00:09:54,220 --> 00:09:57,610
،وجدتِهم مصادفةً، وقاتلتِهم لمنع السرقة

148
00:09:57,610 --> 00:10:02,370
لكنّكِ لم تعرفي أنّهم
المخلب الأبيض حتّى التقيتِهم؟

149
00:10:02,370 --> 00:10:05,870
أجل، كما وضّحتُ بعد الحادثة

150
00:10:06,190 --> 00:10:09,120
قد أكون مديركم، لكنّي صيّادٌ أيضاً

151
00:10:09,520 --> 00:10:12,500
وسأستعمل كافّة قواي لقتال
من يخلّون بالأمان

152
00:10:14,920 --> 00:10:16,000
...بليك

153
00:10:18,760 --> 00:10:22,140
أأنتِ متأكّدةٌ أنّ ليس هناك
ما تخفينه عنّي؟

154
00:10:23,810 --> 00:10:25,260
أجل

155
00:10:28,270 --> 00:10:31,160
حسناً، شكراً على وقتكِ

156
00:10:31,660 --> 00:10:33,690
عليكِ العودة لصديقاتكِ

157
00:10:34,520 --> 00:10:39,160
متى احتجتِ للكلام معي، لا تتردّدي بالسؤال

158
00:10:50,860 --> 00:10:52,670
لا بدّ أنّ المدير أوزبين أدرك

159
00:10:52,670 --> 00:10:57,670
أنّ هناك صلةً بينكِ وبين المخلب الأبيض

160
00:10:57,670 --> 00:11:00,940
،قد يكون البروفسور منفتح التفكير

161
00:11:00,940 --> 00:11:03,890
لكن لا يمكن أن أتوقّع أن تكون
الأكاديميّة بأسرها بذاك التقبّل

162
00:11:04,470 --> 00:11:09,310
إن اكتشفوا أنّي كنت مع المخلب الأبيض
في الماضي، فسأُفصل بالتأكيد

163
00:11:11,620 --> 00:11:15,080
لن تسمح زميلاتكِ بحصول ذلك أبداً

164
00:11:19,450 --> 00:11:25,820
مع ذلك، لا تنوين العودة للمخلب الأبيض
بعد تخرّجكِ، أليس كذلك؟

165
00:11:25,820 --> 00:11:28,200
!ماذا؟ قطعاً لا

166
00:11:28,200 --> 00:11:31,270
لا تنوين أخذ المعرفة والقوّة
التي اكتسبتِها هنا

167
00:11:31,270 --> 00:11:34,080
واستعمالها لأغراض تدميريّة؟

168
00:11:34,080 --> 00:11:38,020
كلا، أشارك البروفسور قيمه

169
00:11:38,020 --> 00:11:40,860
سأستعمل كافّة قواي لقتال
من يخلّون بالأمان

170
00:11:41,970 --> 00:11:46,630
لا نيّة لي بغضّ النظر
عن جانب الشركة المُظلم

171
00:11:47,470 --> 00:11:51,700
رغم أنّي عديمة خبرة وقوّة
ولا أستطيع فعل شيءٍ الآن

172
00:11:52,280 --> 00:11:55,910
سأساعد على جعل هذا العالم
مكاناً أفضل يوماً ما

173
00:11:56,330 --> 00:12:00,610
عندما يحين ذاك الوقت، سأحتاج
لعون أشخاصٍ مثلكِ

174
00:12:00,610 --> 00:12:03,240
أهذا شعوركِ حقّاً؟

175
00:12:03,240 --> 00:12:07,240
على الأقلّ، لا أودّ قتالكِ مُجدّداً

176
00:12:07,880 --> 00:12:09,030
تذكرين ذلك إذاً؟

177
00:12:09,030 --> 00:12:10,850
بشكلٍ مشوّش

178
00:12:10,850 --> 00:12:13,320
ولا أريد تذكّره بالتحديد

179
00:12:13,320 --> 00:12:17,770
مجرّد التفكير بالأمر يُشعرني
بإحراجٍ للموت

180
00:12:18,250 --> 00:12:21,420
هلّا نسيتِه سريعاً وحسب أيضاً؟

181
00:12:32,890 --> 00:12:36,930
كنتِ مكتئبةً عندما أتيتِ
إلى بيكون لأوّل مرّة

182
00:12:37,230 --> 00:12:38,940
ماذا؟ حقّاً؟

183
00:12:38,940 --> 00:12:44,440
لا أريد البروز! التحقتُ دون
"!معرفة أيّ أحدٍ هنا

184
00:12:44,440 --> 00:12:46,490
ألم تقولي أشياءً كتلك؟

185
00:12:46,490 --> 00:12:50,100
،طالما أملك سلاحي المفضّل"
لا أحتاج لأصدقاء!" وما شابه

186
00:12:50,100 --> 00:12:54,460
حسناً... كنتُ أشعر بالتوتّر
لأنّي أصغر سنّاً من الجميع

187
00:12:54,460 --> 00:12:59,210
وضايقتِني يا أختي وقلتِ أنّكِ
لا تريدين التواجد في فريقي

188
00:12:59,210 --> 00:13:03,380
مهلاً، لم أكن أنوي مضايقتكِ

189
00:13:03,380 --> 00:13:05,840
!وقد أصبحنا في الفريق نفسه

190
00:13:07,230 --> 00:13:10,380
،في حلم وايس، حتّى عندما لم تكوني موجودة

191
00:13:10,380 --> 00:13:11,970
!بذلتُ جهوداً كبيرة

192
00:13:12,300 --> 00:13:15,600
!وسأواصل جني الأصدقاء! الكثير منهم

193
00:13:20,270 --> 00:13:22,610
ابذلي ما بوسعكِ يا روبي

194
00:13:22,610 --> 00:13:25,960
،تعتقدين أنّي لا أستطيع
صحيح يا أختي؟

195
00:13:25,960 --> 00:13:29,660
لا بأس، سأتعلّم فعل كلّ شيءٍ بنفسي

196
00:13:30,080 --> 00:13:33,620
!مرحباً! يا فتيات الفريق روبي

197
00:13:33,620 --> 00:13:35,020
!سون

198
00:13:35,020 --> 00:13:36,470
مرحباً

199
00:13:36,470 --> 00:13:38,170
أأنتما بمفردكما اليوم؟

200
00:13:38,170 --> 00:13:39,590
نحن ننتظر صديقاتنا

201
00:13:39,590 --> 00:13:41,390
أأنت بمفردك دوماً؟

202
00:13:41,390 --> 00:13:42,620
أين رفاقك؟

203
00:13:42,620 --> 00:13:44,640
سيصلون عمَّ قريب

204
00:13:44,640 --> 00:13:48,090
أودّ تقديمكما لهم، أيمكنني ذلك؟

205
00:13:49,200 --> 00:13:51,640
!يسرّني امتلاك أصدقاءٍ أكثر

206
00:13:54,510 --> 00:13:57,230
أهم أصدقاء جديرون بالثقة؟

207
00:13:57,840 --> 00:14:00,270
!أتيتما أخيراً

208
00:14:02,760 --> 00:14:05,900
لمَ لا تنضمّ لنا للكلام؟

209
00:14:06,510 --> 00:14:09,900
لا تمانعين الجلوس مع فتى فاونس؟

210
00:14:09,900 --> 00:14:13,160
متى قلتُ أنّي لن أفعل؟

211
00:14:18,830 --> 00:14:23,140
،ولذا، إضافةً لكون بليك من الفاونس

212
00:14:23,140 --> 00:14:27,440
يجب ألّا تتكلّم عن صلتها
بالمخلب الأبيض أبداً

213
00:14:27,950 --> 00:14:32,170
لا أمانع، لكن هل الأمر يتطلّب الإخفاء حقّاً؟

214
00:14:32,650 --> 00:14:37,780
أرجوك يا سون، أودّ بدء حياةٍ جديدة هنا

215
00:14:38,180 --> 00:14:43,940
في المقابل، لن نسلّمك للشرطة
على ركوبك المجّاني على السفينة

216
00:14:43,940 --> 00:14:45,650
مقايضة؟

217
00:14:45,650 --> 00:14:49,690
حتّى دون ذلك، إن أخبرتني بألّا
أبوح بذلك، فلن أفعل

218
00:14:49,690 --> 00:14:51,700
سأكتم الأمر عن أصدقائي حتّى

219
00:14:51,990 --> 00:14:53,330
أصدقاؤك؟

220
00:14:53,330 --> 00:14:57,070
فريق سون، يقول أنّه سيعرّفنا عليهم
عندما يصلون إلى بيكون

221
00:14:57,070 --> 00:14:58,930
حاولن الانسجام معهم

222
00:14:58,930 --> 00:15:01,510
،من الغريب أن يصدر الكلام منّي
لكنّهم وسماء جميعاً

223
00:15:01,510 --> 00:15:02,830
أنا متأكّدٌ أنّهم سينالون إعجابكنّ

224
00:15:02,830 --> 00:15:05,470
يا إلهي، يا للحماس

225
00:15:05,470 --> 00:15:08,070
حسناً، أتساءل عن ذلك

226
00:15:09,310 --> 00:15:12,050
بالمناسبة، أين الفريق جنبر

227
00:15:12,050 --> 00:15:13,090
قمتُ بدعوتهم

228
00:15:13,450 --> 00:15:16,340
قالوا أنّهم لن يستطيعوا القدوم
بسبب تمرين جون الخاصّ

229
00:15:16,340 --> 00:15:18,360
إنّه مواظبٌ عليه طوال الإجازة

230
00:15:18,360 --> 00:15:20,740
لكن لبيرا أهواء غريبة حقّاً

231
00:15:20,740 --> 00:15:22,740
كان بإمكانها تشكيل فريق
مع شخصٍ آخر

232
00:15:22,740 --> 00:15:24,980
بدل تحمّل كلّ ذلك

233
00:15:25,580 --> 00:15:29,610
تريد وايس أن تكون في فريق
رفقة بيرا بالفعل

234
00:15:29,610 --> 00:15:31,000
,,,لا، ليس تماماً

235
00:15:31,000 --> 00:15:34,430
ربما يمكننا مقايضتها
بشخصٍ من الفريق جنبر؟

236
00:15:34,430 --> 00:15:35,760
!لم يكن ذلك ما قلتُه

237
00:15:35,760 --> 00:15:40,980
سأبذل قصارى ما لديّ
لجعل هذا فريقاً بغاية الروعة

238
00:15:40,980 --> 00:15:44,500
،حتّى لو أتيتِ طالبةً العودة
!لن أقبل بعودتكِ يا وايس

239
00:15:45,640 --> 00:15:49,630
متى كنتُ أحاول مغادرة الفريق؟

240
00:16:03,370 --> 00:16:05,360
يبدو لي أنّكِ من الصنف الصامت

241
00:16:05,680 --> 00:16:06,750
ليس تماماً

242
00:16:07,910 --> 00:16:09,780
أمضيتُ معظم الوقت بمفردي

243
00:16:10,790 --> 00:16:13,180
لستُ معتادةً على الأمر بعد فحسب

244
00:16:17,360 --> 00:16:20,280
لكنّهن مسلّيات، ويمكنني الاعتماد عليهنّ

245
00:16:26,510 --> 00:16:30,260
،صحيح. كما علّمتُك تماماً
واصل تكرار الحركات الأساسيّة

246
00:16:31,050 --> 00:16:36,010
هذه هي الروح المطلوبة! هالتك
!أقوى بكثيرٍ مما تظنّ

247
00:16:36,010 --> 00:16:38,210
...إن لم تستعجل وواصلت التمرين وحسب

248
00:16:38,900 --> 00:16:42,600
!يوماً ما، ستستفيق السميبلانس خاصّتي

249
00:16:42,600 --> 00:16:45,180
!صحيح! ابذل قصارى جهدك يا جون

250
00:16:45,180 --> 00:16:49,750
هل سيواصلان على هذا المنوال
حتّى بداية الفصل الجديد؟

251
00:16:49,750 --> 00:16:53,820
أتوقّع ذلك، فكلاهما مُصمّمان جدّاً

252
00:16:55,660 --> 00:16:59,080
أريد الخروج واللهو أحياناً
مثل الفريق روبي

253
00:16:59,360 --> 00:17:01,540
لمَ لا نقترح ذلك على جون؟

254
00:17:01,540 --> 00:17:03,450
جون غريبٌ بالفعل

255
00:17:03,740 --> 00:17:07,960
إنّه ضعيفٌ جدّاً، لكنّه يظلّ يقول أنّه سيحمينا

256
00:17:09,210 --> 00:17:10,920
...ربما

257
00:17:11,590 --> 00:17:15,150
تلك أعظم قواه

258
00:17:17,230 --> 00:17:20,110
أنت الأقوى بيننا يا رين

259
00:17:20,110 --> 00:17:22,960
يسرّني أنّنا في الفريق نفسه

260
00:17:23,480 --> 00:17:25,640
أشارككِ الشعور يا نورا

261
00:17:26,050 --> 00:17:28,350
لنواصل حراسة بعضنا البعض

262
00:17:28,690 --> 00:17:30,550
أجل، بالطبع

263
00:17:36,370 --> 00:17:38,400
أتيتِ باكرةً بالفعل

264
00:17:39,200 --> 00:17:40,810
ما الذي تفعلينه؟

265
00:17:40,810 --> 00:17:42,660
أراجع ملاحظات الفصل الماضي فحسب

266
00:17:45,590 --> 00:17:49,130
كنتِ تكتبين شيئاً أثناء قراءتكِ، أليس كذلك؟

267
00:17:49,130 --> 00:17:51,250
...كلا، لم أكن

268
00:17:51,250 --> 00:17:53,370
هلّا تركتِني أقرؤه فيما بعد؟

269
00:17:53,370 --> 00:17:55,220
أ-أسأتِ الفهم

270
00:18:00,970 --> 00:18:03,340
أين آدابكِ يا يانغ؟

271
00:18:03,340 --> 00:18:05,720
لا يصحّ اللهو بالطعام

272
00:18:06,240 --> 00:18:08,050
أخبريني، أين روبي؟

273
00:18:08,050 --> 00:18:10,530
قالت أنّها كانت تجهّز شيئاً

274
00:18:19,150 --> 00:18:22,560
...يا أخواتي... صديقاتي

275
00:18:22,560 --> 00:18:24,370
و... وايس

276
00:18:24,370 --> 00:18:25,480
!مهلاً

277
00:18:25,480 --> 00:18:27,370
يبدو أنّ الأمر بدأ

278
00:18:27,650 --> 00:18:30,200
كقائدة، فكّرتُ بشيء

279
00:18:30,200 --> 00:18:32,030
سيبدأ الفصل الجديد غداً

280
00:18:32,030 --> 00:18:35,260
،إنّه اليوم الأخير من العطلة
علينا العمل معاً

281
00:18:35,260 --> 00:18:40,000
والتعاون مع الفريق جنبر لجعله
...أكثر يومٍ ممتعٍ

282
00:18:40,400 --> 00:18:41,510
!قطّ

283
00:18:41,510 --> 00:18:44,400
!بداية الفصل الجديد غداً تشعرني... بالحماس

284
00:18:44,970 --> 00:18:47,450
!حماس من "يانغ" يا رفاق

285
00:18:47,450 --> 00:18:49,300
ما رأيكنّ؟ أليس التلاعب طريفاً؟

286
00:18:49,300 --> 00:18:50,060
!مؤلم

287
00:18:57,820 --> 00:19:00,570
يخصّ وايس شُني

288
00:18:58,080 --> 00:19:00,570
هل سرقتِ مجلّدي؟

289
00:19:00,570 --> 00:19:04,700
!أضفتُ خطّتي شديدة المتعة له

290
00:19:04,700 --> 00:19:06,640
...لم أقل أنّ بإمكانكِ

291
00:19:09,660 --> 00:19:11,820
هذا تمادٍ يا نورا

292
00:19:15,020 --> 00:19:17,530
لديّ اقتراح

293
00:19:17,530 --> 00:19:21,110
في هذا اليوم بالتحديد، لمَ لا نبدأ

294
00:19:21,110 --> 00:19:24,970
نشاط الكافتيريا التقليديّ
هنا في بيكون؟

295
00:19:24,970 --> 00:19:26,210
التقليديّ؟

296
00:19:26,210 --> 00:19:28,840
الذي كان أبي يتكلّم عنه

297
00:19:28,840 --> 00:19:30,140
ما الذي سنفعله؟

298
00:19:33,140 --> 00:19:35,900
قتال طعام! مستعدّون؟

299
00:19:42,910 --> 00:19:44,280
ما قولك أيّها القائد؟

300
00:19:45,410 --> 00:19:46,910
...حسناً

301
00:19:47,820 --> 00:19:49,310
!نقبل تحدّيكن

302
00:20:04,340 --> 00:20:05,600
!مرحى

303
00:21:04,940 --> 00:21:08,750
فاز الإنسان بالحياة عبر المعارك

304
00:21:09,720 --> 00:21:13,160
لكن حتّى ألمع الأنوار
تضعف يوماً وتخمد

305
00:21:13,560 --> 00:21:16,920
ثمّ يرجع الظلام

306
00:21:17,580 --> 00:21:22,060
،لذا ابقين يقظات يا حارسات النور، لكن انتبهن

307
00:21:22,060 --> 00:21:25,740
لن يظفر المؤمن بالقوّة
وحدها بالنصر

308
00:21:42,710 --> 00:21:46,990
ربما تجد النصر
في أشياء أبسط

309
00:21:47,870 --> 00:21:52,090
...أشياء نسيها الناس بمضيّ الوقت

310
00:21:52,090 --> 00:21:56,670
أشياء تتطلّب روحاً أصغر أكثر صراحة