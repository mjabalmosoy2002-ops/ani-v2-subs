1
00:00:07,230 --> 00:00:09,980
ماذا؟ إنّها الشجرة التي أسقطتُها

2
00:00:10,360 --> 00:00:12,770
...إن كانت لا تزال هنا، فذلك يعني

3
00:00:14,390 --> 00:00:16,990
يمكننا تغيير الحلم، صحيح؟

4
00:00:16,990 --> 00:00:18,740
لحظة، أين جون؟

5
00:00:21,610 --> 00:00:23,120
!ماذا؟! دعني

6
00:00:24,360 --> 00:00:27,550
!النجدة

7
00:00:28,040 --> 00:00:29,130
جون؟

8
00:00:30,700 --> 00:00:36,480
...واحد، اثنان

9
00:00:38,230 --> 00:00:41,110
سيفي وعباءتي ثقيلان جدّاً

10
00:00:41,110 --> 00:00:43,570
هكذا تراه وايس، صحيح؟

11
00:00:43,570 --> 00:00:46,670
أعتقد أنّها تظنّ أنّه لا يستطيع
التعامل مع سلاحه

12
00:00:46,670 --> 00:00:48,930
جون، أأنت بخير؟

13
00:00:48,930 --> 00:00:51,320
أعتقد ذلك

14
00:00:52,320 --> 00:00:55,260
ثلاث عملات، ماذا عنكم؟

15
00:00:55,260 --> 00:00:56,280
وأنا

16
00:00:56,280 --> 00:00:57,820
لدى الجميع ثلاثة

17
00:00:58,410 --> 00:01:00,350
استعملوها بعناية، هيّا بنا

18
00:01:10,630 --> 00:01:12,780
!لا يمكنني التوقّف

19
00:01:20,520 --> 00:01:21,940
ما هذه؟

20
00:01:21,940 --> 00:01:24,390
ألديك فكرةٌ عمَّ تقوله؟

21
00:01:27,520 --> 00:01:29,520
حسناً، لنفعلها

22
00:01:29,520 --> 00:01:31,150
جاهزة أيّتها القائدة؟

23
00:01:32,910 --> 00:01:35,180
أجل، تحضّروا جميعاً

24
00:01:36,000 --> 00:01:37,560
أنا مستعدّة

25
00:01:43,470 --> 00:01:45,420
أنا مستعدٌ أيضاً

26
00:01:45,420 --> 00:01:47,210
أأنت متأكّد؟

27
00:03:29,320 --> 00:03:30,100
!ها هو

28
00:03:30,100 --> 00:03:31,140
حسناً

29
00:03:55,980 --> 00:03:57,570
!بسرعة! اذهبا

30
00:03:57,570 --> 00:03:58,460
!حسناً

31
00:04:16,880 --> 00:04:18,390
!إنّه عالق

32
00:04:26,280 --> 00:04:28,240
!عباءتي

33
00:04:30,040 --> 00:04:31,080
!خذ

34
00:04:34,090 --> 00:04:37,370
،لم يخطر لي أن أحمي قطاراً للشركة
حتّى في حلم

35
00:04:37,370 --> 00:04:39,530
ماذا؟ أقلتِ شيئاً؟

36
00:04:40,520 --> 00:04:43,020
عبرنا المنطقة التي توقّف
القطار فيها قبلاً

37
00:04:43,020 --> 00:04:44,920
!لنواصل على هذا المنوال

38
00:05:13,010 --> 00:05:15,680
شكراً لك، التقرير

39
00:05:16,080 --> 00:05:18,460
الطريق في طريقه

40
00:05:19,620 --> 00:05:22,570
المخلب الأبيض المكتسحة للوادي

41
00:05:22,570 --> 00:05:25,190
قد أُبعِدت أخيراً

42
00:05:26,580 --> 00:05:28,340
ما الذي قلتَه؟

43
00:05:34,290 --> 00:05:38,450
ما الذي... يجري بالضبط؟

44
00:05:39,520 --> 00:05:41,000
خرجنا من الوادي

45
00:05:41,000 --> 00:05:43,080
!هذا الأخير

46
00:05:44,120 --> 00:05:46,900
!مشكلة! هناك شيءٌ كبيرٌ أمامنا

47
00:05:49,400 --> 00:05:51,980
أهو قطارٌ للشركة حقّاً؟

48
00:05:52,610 --> 00:05:55,310
لا توجد تماثيل لأبي خارج البلدة

49
00:05:55,850 --> 00:05:58,120
ماذا لو كانت تحمل المخلب الأبيض؟

50
00:05:58,120 --> 00:06:00,650
سيصل القطار عمَّ قريب

51
00:06:00,650 --> 00:06:03,300
هل ستمنحينني إذن فتح البوّابة؟

52
00:06:14,370 --> 00:06:17,790
تحملين مسؤوليّةً كبيرة يا وايس

53
00:06:21,400 --> 00:06:23,770
البوّابة لا تُفتح

54
00:06:23,770 --> 00:06:25,520
أليس ذلك سيّئاً؟

55
00:06:25,520 --> 00:06:27,780
!افتحي يا وايس

56
00:06:27,780 --> 00:06:31,160
تحملين مسؤوليّةً كبيرة يا وايس

57
00:06:32,800 --> 00:06:36,410
على هذا النحو، سيصطدم القطار بالبوّابة

58
00:06:58,740 --> 00:07:01,730
!أرجوكِ يا وايس! افتحي

59
00:07:01,730 --> 00:07:03,080
!يا ملكة الثلج

60
00:07:03,080 --> 00:07:04,740
!افتحي

61
00:07:04,740 --> 00:07:07,610
!لا تصدّينا يا وايس

62
00:07:09,820 --> 00:07:11,360
!افتحوا البوّابة

63
00:07:20,280 --> 00:07:21,770
!فُتحت

64
00:07:40,510 --> 00:07:43,480
مُذهل، الحوائط تُفتح باستمرار

65
00:07:43,780 --> 00:07:47,480
!لا بدّ أنّ هذه هي صيانة الحلم تلك

66
00:07:56,270 --> 00:07:57,390
!ماذا؟

67
00:08:19,290 --> 00:08:21,780
ما الذي يجري بالضبط؟

68
00:08:22,810 --> 00:08:24,520
لأيّ حدٍّ سيمضي؟

69
00:08:25,140 --> 00:08:26,480
!انظروا للحائط التالي

70
00:08:32,530 --> 00:08:34,500
!المسارات ترتفع

71
00:08:34,500 --> 00:08:36,530
!انطلق أبعد ما يمكنك

72
00:09:11,600 --> 00:09:12,940
أتلك محطّة؟

73
00:09:13,490 --> 00:09:16,840
اختفت الحوائط، لكن ظهر شيءٌ جديد

74
00:09:17,750 --> 00:09:20,070
!أعتقد أنّ الخطّة نجحت إذاً

75
00:09:20,350 --> 00:09:23,030
!الآن خطّتكِ أيّتها القائدة

76
00:09:23,800 --> 00:09:24,660
أجل

77
00:09:37,090 --> 00:09:50,020
!نيكولاس الكبير! نيكولاس الكبير

78
00:09:55,100 --> 00:09:57,160
لن نُطرد الآن

79
00:09:57,160 --> 00:10:00,010
حسناً، لنبدأ بخطّتي إذاً

80
00:10:00,490 --> 00:10:02,230
جون، تقدّم

81
00:10:03,800 --> 00:10:06,950
،أشعر بالبرد، وبحكّة في أنفي

82
00:10:06,950 --> 00:10:08,750
وعيناي رطبتين أيضاً

83
00:10:09,170 --> 00:10:11,410
أهذه ردّة فعل سيّئة للكابوس؟

84
00:10:11,410 --> 00:10:16,010
،أنت الوحيد القادر على التحرّك بحرّية
!لذا نعتمد عليك

85
00:10:19,220 --> 00:10:24,010
أخيراً، أخيراً تمكّنا من استقبال
!قطارٍ يا آنستي

86
00:10:25,510 --> 00:10:30,020
دافعت بليك عن القطار
من المخلب الأبيض؟

87
00:10:30,540 --> 00:10:33,150
وحتّى جون... لمَ؟

88
00:10:33,150 --> 00:10:36,650
تحملين مسؤوليةً كبيرة يا وايس

89
00:10:37,570 --> 00:10:39,060
...مسؤوليّة

90
00:10:39,900 --> 00:10:43,050
ما عساي أفعل؟

91
00:10:44,260 --> 00:10:45,950
أين ذهب أولئك الأربعة؟

92
00:10:48,010 --> 00:10:50,320
!مشكلةٌ يا أختي

93
00:10:50,320 --> 00:10:55,080
أخذت بليك روبي ويانغ وجون
!وصعدوا القطار داخلين جميعاً

94
00:10:55,080 --> 00:10:58,160
صمتاً! أدرك ذلك

95
00:10:58,160 --> 00:11:03,000
ماذا؟ أتحاول ترك فاونس
تدخل البلدة يا أختي؟

96
00:11:08,710 --> 00:11:14,520
أأنتِ ابنة جديرةٌ لعائلة
شُني حقّاً يا وايس؟

97
00:11:15,610 --> 00:11:21,680
أنا وحدي أستطيع الحفاظ على فخر
عائلة شُني، واتّباع إرادة نيكولاس الكبير

98
00:11:26,780 --> 00:11:32,030
،حتّى لو رجع القطار للبلدة
لن تتغيّر البلدة نفسها أبداً

99
00:11:34,460 --> 00:11:37,980
سأجعل بليك تفهم ذلك

100
00:11:50,790 --> 00:11:52,730
يبدو أنّه يعاني

101
00:11:52,730 --> 00:11:55,230
ابذل جهدك يا جون

102
00:11:58,230 --> 00:12:03,610
ابذل جهدك يا جون، أنا متأكّدةٌ
أنّك قادر على فعلها

103
00:12:08,220 --> 00:12:10,530
هل سيكون بخيرٍ حقّاً؟

104
00:12:12,350 --> 00:12:15,650
لا أستطيع التنفّس عبر أنفي، أشعر ببردٍ شديد

105
00:12:15,650 --> 00:12:17,290
أريد معطفاً فحسب

106
00:12:40,980 --> 00:12:42,920
إنّه يُتجاهل كليّاً

107
00:12:42,920 --> 00:12:44,870
مُذهلٌ يا جون

108
00:12:44,870 --> 00:12:47,780
كان ذلك ليجرحني

109
00:12:54,340 --> 00:12:55,520
!مرحباً، مرحباً

110
00:12:56,220 --> 00:12:58,790
!نيكولاس الكبير

111
00:12:58,790 --> 00:13:02,190
!أنا كلاين البليد، أحد الخدم السبعة

112
00:13:02,190 --> 00:13:06,050
أحرس السيليز هنا وأحرص
...على ألّا يهربوا

113
00:13:06,050 --> 00:13:07,260
ماذا؟

114
00:13:07,590 --> 00:13:09,950
ألستَ سيلي أيضاً؟

115
00:13:09,950 --> 00:13:13,520
!لا يُفترض أن تخرج أيّها الأحمق

116
00:13:13,520 --> 00:13:16,520
ذلك مزعجٌ وهو صادر
من غبيٍّ مثلك

117
00:13:25,230 --> 00:13:27,260
هلّا فتحت لي؟

118
00:13:27,260 --> 00:13:30,840
لا يمكن، عليّ احتجاز السيليز

119
00:13:30,840 --> 00:13:35,360
لكنّي أحدهم، أليس كذلك؟
لن أستطيع الدخول ما لم تفتح

120
00:13:35,360 --> 00:13:37,330
أأنت أحمق؟

121
00:13:37,330 --> 00:13:39,400
ألم تقل ذلك بنفسك؟

122
00:13:39,400 --> 00:13:40,920
!صحيح

123
00:13:42,800 --> 00:13:44,920
!حسناً، ادخل

124
00:13:55,140 --> 00:13:58,140
!ماذا؟ لا أستطيع الإقفال

125
00:13:58,140 --> 00:13:59,890
!هذا غريب

126
00:14:14,740 --> 00:14:15,790
أهذه لي؟

127
00:14:17,290 --> 00:14:20,020
!هذا ينفعني كثيراً! شكراً لكم

128
00:14:22,370 --> 00:14:28,960
أتيتُ لتحريركم، لكنّ المكان دافئٌ ومريحٌ هنا

129
00:14:28,960 --> 00:14:32,520
،توقّفت الحكّة في أنفي أيضاً
لمَ يا ترى؟

130
00:14:51,390 --> 00:14:53,820
أليست هذه قطعة فريق روبي الأثريّة؟

131
00:14:54,760 --> 00:14:56,460
مع أنّ لونها مُختلف

132
00:15:05,630 --> 00:15:06,380
ماذا؟

133
00:15:06,380 --> 00:15:09,310
!لا أستطيع الإغلاق! لا أستطيع الإغلاق

134
00:15:09,310 --> 00:15:10,720
!هذا غريب

135
00:15:14,130 --> 00:15:15,300
أريد أن أكون حرّةً وأخرج

136
00:15:15,300 --> 00:15:16,190
!أريد الخروج

137
00:15:16,190 --> 00:15:17,350
!أحبّ المهرجانات

138
00:15:17,350 --> 00:15:18,590
!أطريني

139
00:15:18,590 --> 00:15:19,580
!أريد أن أُدلّل

140
00:15:19,580 --> 00:15:20,590
!أريد اللعب

141
00:15:20,590 --> 00:15:23,510
أأولئك... وايس في صغرها؟

142
00:15:23,510 --> 00:15:27,010
هل أقفلت على ذكريات
طفولتها طوال ذاك الوقت؟

143
00:15:27,660 --> 00:15:30,270
أذاك صحيحٌ يا وايس؟

144
00:15:31,870 --> 00:15:33,100
إنّه من جون

145
00:15:33,620 --> 00:15:35,340
مرحباً؟ إنّها أنا

146
00:15:36,950 --> 00:15:39,280
ماذا؟ قطعة أثريّة؟

147
00:15:44,340 --> 00:15:45,380
!مكانكم

148
00:15:45,380 --> 00:15:50,830
،طالما تلمع عيناي بالأحمر، أنا كلاين الغاضب
!فلن أسمح للحمقى بالنعم بالحرّية

149
00:15:54,740 --> 00:15:56,800
!أريد أن أكون حرّاً

150
00:16:00,030 --> 00:16:02,310
!أريد اللعب خارجاً مع الجميع

151
00:16:03,060 --> 00:16:05,440
!أريد أكل الكثير من الحلويات

152
00:16:06,990 --> 00:16:09,400
!أريد الاستمتاع بالكلام مع عائلتي

153
00:16:11,840 --> 00:16:13,040
!جون

154
00:16:13,040 --> 00:16:15,370
روبي، هاكِ

155
00:16:17,550 --> 00:16:20,890
إنّها صفراءٌ هذه المرّة، شكراً لك

156
00:16:20,890 --> 00:16:23,200
أشعر أنّنا حقّقنا نجاحاً باهراً

157
00:16:23,440 --> 00:16:26,710
كلّ ما يحصل... لا بأس به، صحيح؟

158
00:16:24,040 --> 00:16:26,200
!لا أريد تحسين آدابي

159
00:16:26,710 --> 00:16:28,200
أجل

160
00:16:27,390 --> 00:16:29,780
!أريد اللعب خارجاً مع الجميع

161
00:16:28,200 --> 00:16:33,710
المشاعر التي قمعتها لوقتٍ طويل
تحرّرت الآن، أليس ذلك حسناً؟

162
00:16:29,780 --> 00:16:32,180
!أريد أكل الكثير من الحلويّات

163
00:16:34,090 --> 00:16:36,890
يبتغي الجميع الحرّية

164
00:16:36,890 --> 00:16:40,470
لا يمكنك احتجاز الأشياء
المهمّة لك دوماً

165
00:16:40,910 --> 00:16:42,500
يجب أن تكون حرّة

166
00:16:42,500 --> 00:16:43,970
حرّة؟

167
00:16:44,280 --> 00:16:45,600
!حرّة

168
00:16:46,270 --> 00:16:47,200
!تكلّما

169
00:16:48,360 --> 00:16:49,550
!هذه هي الروح المطلوبة

170
00:16:49,550 --> 00:16:53,020
أنتم من المقاومة، تقاتلون للحرّية

171
00:16:53,020 --> 00:16:54,270
!سنقاتل

172
00:16:54,270 --> 00:16:55,240
!لنقاتل

173
00:16:56,560 --> 00:16:58,130
!للحرّية

174
00:17:15,560 --> 00:17:17,380
!هيّا بنا

175
00:17:17,950 --> 00:17:22,170
!أريد أن أكون حرّاً! أريد أن أكون حرّاً

176
00:17:22,170 --> 00:17:23,720
...أريد أن أكون

177
00:17:30,350 --> 00:17:34,730
عجباً، تحملين مسؤوليةً
!كبيرةً جدّاً يا أختي

178
00:17:34,730 --> 00:17:39,000
يستحيل أن تقولي أنّكِ جديرةٌ
بأن تكوني من آل شُني الآن

179
00:17:55,520 --> 00:17:57,050
لا يُغتفر

180
00:17:58,140 --> 00:18:00,660
وصلنا مباشرةً إلى هنا

181
00:18:00,660 --> 00:18:03,730
يبدو أنّ كافة الجنود
ذهبوا إلى مكان جون

182
00:18:03,730 --> 00:18:05,060
!نجاحٌ كبير

183
00:18:11,070 --> 00:18:12,010
هيّا بنا

184
00:18:12,860 --> 00:18:16,960
هذه المرّة، علينا هزيمة الغريم
!وجعل وايس تستيقظ

185
00:18:30,040 --> 00:18:33,790
يوجعني أنفي وعينيّ، لا أستطيع التحمّل

186
00:18:35,950 --> 00:18:37,360
شكراً لكِ

187
00:18:38,110 --> 00:18:39,420
!لنقاتل

188
00:18:39,420 --> 00:18:40,840
!للحرّية

189
00:18:40,840 --> 00:18:43,860
!أريد اللعب! أريد اللعب

190
00:18:43,860 --> 00:18:45,220
!لنقاتل

191
00:18:45,220 --> 00:18:46,640
!للحرّية

192
00:18:46,640 --> 00:18:49,430
!أريد الكلام مع مختلف الناس

193
00:18:49,430 --> 00:18:52,610
!أريد الخروج! أريد الخروج

194
00:18:54,180 --> 00:18:58,130
!أريد الاستمتاع! أريد اللهو طوال الوقت

195
00:18:58,130 --> 00:19:01,260
الوضع يصبح فوضويّاً

196
00:19:04,920 --> 00:19:07,660
!أريد الحصول على أصدقاء

197
00:19:09,150 --> 00:19:10,840
!لنقاتل

198
00:19:12,880 --> 00:19:15,390
!للحرّية

199
00:19:16,760 --> 00:19:19,010
!ماذا؟ لمَ؟

200
00:19:20,940 --> 00:19:23,040
!ما الذي يجري؟

201
00:19:33,560 --> 00:19:35,340
!أريد أن أُدلّل

202
00:19:35,340 --> 00:19:37,320
!أريد أن أُعامل بعناية

203
00:19:55,040 --> 00:19:56,460
لا يُعقل

204
00:20:14,560 --> 00:20:17,210
...ما الذي

205
00:21:15,230 --> 00:21:17,400
لمَ انقلب الطقس فجأةً؟

206
