1
00:00:09,170 --> 00:00:10,920
ما هذا؟ ما هذا؟

2
00:00:10,920 --> 00:00:13,750
ماذا؟ هل لهذه كريستالة؟ كريستالة حقيقيّة؟

3
00:00:21,680 --> 00:00:24,960
أظنّني أريد هذه حقّاً

4
00:00:25,190 --> 00:00:27,870
إنّها لامعة جدّاً ونقيّة

5
00:00:27,870 --> 00:00:30,280
هذا كثير

6
00:00:31,320 --> 00:00:35,600
روري، إلى متى ستستمرّين في النّظر
إلى حصى؟

7
00:00:35,600 --> 00:00:37,770
ليس وكأنّكِ تملكين مالاً لشرائها

8
00:00:37,770 --> 00:00:39,350
عمّاذا تتكلّمين؟

9
00:00:39,350 --> 00:00:45,510
إذا طلبت، أنا واثقة بأنّني أستطيع إيجاد
عشرة أو عشرين شخصاً يشترونها لي

10
00:00:46,470 --> 00:00:50,360
!أرجوكِ

11
00:00:50,360 --> 00:00:52,930
!أعطيني سلفة عن مصروف الشّهر المُقبل

12
00:00:53,090 --> 00:00:56,690
لا. لستِ بحاجة شرائها

13
00:00:56,690 --> 00:00:58,840
لكنّها ظريفة جدّاً

14
00:00:58,840 --> 00:01:00,620
سأدعكِ تستعيرينها حتّى

15
00:01:00,620 --> 00:01:02,620
إنّها كريستالة حقيقيّة

16
00:01:02,770 --> 00:01:04,490
كريستالة؟

17
00:01:04,840 --> 00:01:07,720
كان جدّكِ يحضرها طوال الوقت

18
00:01:07,720 --> 00:01:10,040
عندما كان يذهب لقطف نباتات برّية

19
00:01:10,990 --> 00:01:14,920
في الواقع، الكريستالات يتمّ جمعها
في خارج البلاد

20
00:01:14,920 --> 00:01:16,880
لا يمكن إيجادها في الأرض
في هذه المنطقة

21
00:01:16,880 --> 00:01:19,610
إنّها تلك الأشياء المُدبّبة النّقيّة، صحيح؟

22
00:01:21,410 --> 00:01:22,350
ماذا؟

23
00:01:24,970 --> 00:01:26,580
هل ما زالت لديكِ؟

24
00:01:26,580 --> 00:01:30,400
لم تستهوني، لذا أعطيتُها لغيري

25
00:01:30,620 --> 00:01:32,510
!لماذا؟ يا للإسراف

26
00:01:32,510 --> 00:01:34,320
لا تسأليني

27
00:01:34,320 --> 00:01:36,920
على أيّ حال، لن أعطيكِ سلفة عن مصروفكِ

28
00:01:37,330 --> 00:01:38,210
خُذي

29
00:01:38,210 --> 00:01:40,130
ماذا؟

30
00:01:46,430 --> 00:01:48,830
عندما كان جدّي يقطف
،النّباتات البرّية

31
00:01:48,830 --> 00:01:50,680
هل كان يذهب إلى الجبال الّتي
يزورها لأطفال في رحلات المدرسة؟

32
00:01:50,680 --> 00:01:51,760
هذا صحيح

33
00:02:00,100 --> 00:02:04,040
،إن كان يستطيع إيجادها أثناء قطف النّباتات
فينبغي أن أتمكّن من إيجاد بعض منها أيضاً

34
00:02:04,350 --> 00:02:06,550
،وإذا استطعتُ جمعها بنفسي

35
00:02:06,550 --> 00:02:09,330
يمكنني صنع ما أشاء من إكسسوارات
فاخرة وظريفة

36
00:02:10,350 --> 00:02:12,220
والجميع ستُصيبهم الغيرة

37
00:02:12,530 --> 00:02:15,150
رغم ذلك، لا أُصدّق الأمر

38
00:02:15,150 --> 00:02:17,530
هذا قريب جدّاً من المنزل

39
00:02:19,530 --> 00:02:21,390
أعتقد سأحاول التجوُّل في مُحيط الجبال

40
00:02:21,640 --> 00:02:23,260
أنا متأكّدة بأنّني سأجد شيئاً
إذا تعمّقتُ بما يكفي أكثر

41
00:02:26,400 --> 00:02:29,130
هـ-هذا لا يُخيفني إطلاقاً

42
00:02:29,130 --> 00:02:31,970
دفعتُ 500 ين لركوب الحافلة إلى هنا

43
00:02:35,630 --> 00:02:37,210
هذه المنطقة ستفي بالغرض

44
00:02:38,160 --> 00:02:41,050
...صخرة

45
00:02:42,160 --> 00:02:45,460
...صخرة... صخرة... صخرة

46
00:02:45,460 --> 00:02:46,460
!صخرة، صخرة، صخرة

47
00:02:46,460 --> 00:02:47,850
!مُجرّد صخور قديمة عاديّة

48
00:02:48,130 --> 00:02:51,600
بدأتُ أشعر وكأنّني لن أجد شيئاً أبداً

49
00:02:51,600 --> 00:02:52,480
بئساً

50
00:02:55,870 --> 00:02:57,500
لماذا تجلسين مكانكِ؟

51
00:02:58,180 --> 00:03:00,020
ألستِ على ما يُرام؟

52
00:03:06,430 --> 00:03:08,530
...في الواقع أبحث عن كريسـ

53
00:03:08,530 --> 00:03:11,250
...أقصد، أربطة حذائي

54
00:03:19,820 --> 00:03:21,310
المهمّ أنّكِ لا تُواجهين مُشكلة

55
00:03:21,670 --> 00:03:22,790
انتبهي على نفسكِ

56
00:03:22,790 --> 00:03:24,020
!انتظري

57
00:03:24,880 --> 00:03:26,570
هل تعرفين الكثير عن الصّخور؟

58
00:03:26,940 --> 00:03:28,460
أعرف القليل

59
00:03:29,020 --> 00:03:33,340
سـ-سمعتُ بأنّني قد أجد كـ-كريستالات
...في هذه الأرجاء

60
00:03:33,340 --> 00:03:34,510
كريستالات؟

61
00:03:36,970 --> 00:03:39,990
،في هذه الحالة، إنّها خارج الدّرب
لكنّها هناك

62
00:03:39,990 --> 00:03:40,990
ماذا؟

63
00:03:41,390 --> 00:03:42,520
حقّاً؟

64
00:03:44,300 --> 00:03:46,150
!خـ-خذيني إلى هناك

65
00:03:46,150 --> 00:03:48,450
...ماذا؟ لكنّني

66
00:03:53,980 --> 00:03:55,450
حسناً

67
00:03:57,560 --> 00:03:59,470
اسمي تانيغاوا روري

68
00:03:59,780 --> 00:04:02,470
أراتو ناغي. أنا تلميذة خرّيجة

69
00:04:02,950 --> 00:04:04,710
هل تحبّين الصّخور؟

70
00:04:05,020 --> 00:04:07,820
أحبّ دراستها

71
00:04:16,240 --> 00:04:19,480
المعذرة، لِمَ هذه المِطرقة الضّخمة؟

72
00:04:20,580 --> 00:04:22,120
هذه؟

73
00:04:24,310 --> 00:04:26,570
وجدتُها في سوق الخردة قبل أيّام

74
00:04:26,990 --> 00:04:29,600
إنّها مِطرقة حربيّة جرفها البحر
إلى هنا من الخارج

75
00:04:29,830 --> 00:04:33,750
صُنِعَتْ للاستعمال، لذا مركز جاذبيّتها
هو المكان الصّحيح تماماً

76
00:04:33,750 --> 00:04:35,960
اشتريتُها لشطر الحجارة

77
00:04:36,620 --> 00:04:38,880
أردتُ تجربتها اليوم

78
00:04:39,360 --> 00:04:40,500
أتطلّع قُدماً لذلك

79
00:04:41,350 --> 00:04:42,970
هل هي شخص مُريب؟

80
00:04:49,010 --> 00:04:50,990
مُؤخّرتي تؤلمني

81
00:04:50,990 --> 00:04:52,960
!ناغي-سان

82
00:04:52,960 --> 00:04:54,680
ما الأمر؟ ثانية؟

83
00:04:55,590 --> 00:04:59,490
لا يبدو أنّه يوجد درب هنا

84
00:04:59,490 --> 00:05:01,470
لا تقلقي. هذا هو الطّريق الصّحيح

85
00:05:01,470 --> 00:05:05,240
هل أنتِ متأكّدة؟ لم نتُه، أليس كذلك؟

86
00:05:05,620 --> 00:05:07,200
انظري إلى هذه الصُّخور

87
00:05:08,570 --> 00:05:10,200
أترين كيف أنّ سطحها أسود؟

88
00:05:10,550 --> 00:05:12,640
هذا بازلت مُكوَّن من حمم مُتصلّبة

89
00:05:13,310 --> 00:05:15,980
في حين أنّ الصّخرة المُقابلة لها رسوبيّة

90
00:05:16,300 --> 00:05:18,000
هذا حجرٌ كلسيّ رماديّ

91
00:05:20,980 --> 00:05:24,120
الأشجار كلّها مُتشابهة، لكن
للصّخور وجوه مُختلفة

92
00:05:24,600 --> 00:05:26,460
لا تقلقي. لم نتُه

93
00:05:27,380 --> 00:05:29,290
.شارفنا على الوصول إلى هناك
يمكنكِ فعلها

94
00:05:29,290 --> 00:05:30,480
حسناً

95
00:05:35,510 --> 00:05:38,260
شارفنا على الوصول؟ لا أرى ذلك

96
00:05:38,730 --> 00:05:42,860
ساقايّ ومؤخّرتي يؤلمانني، وأعلق
بأشياء بشكل مُستمرّ

97
00:05:43,170 --> 00:05:45,780
لم يقل أحدٌ بأنّ الأمر سيكون هكذا

98
00:05:46,910 --> 00:05:48,430
هناك شجرة ساقطة

99
00:05:48,430 --> 00:05:49,640
!مؤلم

100
00:05:52,840 --> 00:05:56,520
،سئمتُ من هذا، سئمتُ من هذا
!سئمتُ من هذا

101
00:05:56,520 --> 00:05:59,560
كان ينبغي أن أشتري كريستالاتي في المتجر

102
00:05:59,560 --> 00:06:02,590
،حتّى لو وجدتُ واحدة الآن
لن أكون سعيدة إطلاقاً

103
00:06:03,360 --> 00:06:04,360
روري-تشان

104
00:06:04,900 --> 00:06:05,890
انظري

105
00:06:12,940 --> 00:06:15,160
!كريستالات! كريستالات حقيقيّة

106
00:06:15,160 --> 00:06:17,070
!كانت هنا فعلاً

107
00:06:18,130 --> 00:06:19,490
!هناك أيضاً

108
00:06:21,440 --> 00:06:23,320
!وهنا

109
00:06:23,320 --> 00:06:24,400
!وهناك

110
00:06:24,840 --> 00:06:27,450
!ناغي-سان، ناغي-سان
!انظري إلى كلّ هذا

111
00:06:33,910 --> 00:06:35,390
مشهد رهيب، أليس كذلك؟

112
00:06:35,660 --> 00:06:38,040
يُدعى هذا بطبقة الصّخر المُتلاحك

113
00:06:39,170 --> 00:06:43,080
تتشكّل بواسطة الحمم الّتي تتسرّب
إلى داخل الشّقوق في صخر الأساس

114
00:06:46,870 --> 00:06:48,790
،عندما يحدث ذلك، تتبخّر بعض الحمم

115
00:06:48,790 --> 00:06:50,340
،لكن لا يمكن للغاز أن يتسرّب
لذا يبقى عالقاً

116
00:06:50,340 --> 00:06:51,470
داخل الحمم وتتشكّل تجاويف

117
00:06:52,170 --> 00:06:54,940
تتشكّل الكريستالات داخل ذلك التّجويف

118
00:06:55,350 --> 00:06:57,270
—يُدعى التّجويف بالجيّود و

119
00:06:57,730 --> 00:06:58,790
روري-تشان؟

120
00:07:09,870 --> 00:07:12,920
هذه جميلة. هذه أيضاً

121
00:07:13,530 --> 00:07:15,080
سآخذها كلّها إلى المنزل

122
00:07:15,290 --> 00:07:17,250
يجب علينا العودة مشياً أيضاً

123
00:07:17,250 --> 00:07:18,430
اختاري بحرص

124
00:07:19,910 --> 00:07:20,750
ماذا؟

125
00:07:22,590 --> 00:07:23,680
أريد هذه

126
00:07:24,100 --> 00:07:26,640
!...هيّا! انكسري

127
00:07:26,890 --> 00:07:28,840
روري-تشان، أتريدينني أن أفعلها؟

128
00:07:28,840 --> 00:07:29,650
ماذا؟

129
00:07:32,400 --> 00:07:35,540
إنّها لي، مفهوم؟ تعلمين ذلك، صحيح؟

130
00:07:35,790 --> 00:07:38,370
انتبهي من الشّظايا المُتطايرة. تراجعي

131
00:07:43,830 --> 00:07:47,920
يا إلهي، هذا الكوارتزيت صلب حقّاً

132
00:07:47,920 --> 00:07:50,310
مستحيل. لم يفلح ذلك أيضاً؟

133
00:07:50,550 --> 00:07:52,900
حسناً. حان وقت استخدام هذه

134
00:07:55,660 --> 00:07:57,430
ينبغي أن أعتذر سلفاً

135
00:07:57,430 --> 00:08:00,740
قد تزلّ يدايّ وأكسر الكريستالات

136
00:08:00,740 --> 00:08:02,790
لا تفعلي ذلك. اكسريها بشكل لائق

137
00:08:15,920 --> 00:08:17,320
إنّه أسود. هل هذا مناسب؟

138
00:08:17,320 --> 00:08:18,780
أجل. سأتناوله

139
00:08:24,720 --> 00:08:26,890
إنّها تُذهلني مهما رأيتُها من مرّات

140
00:08:27,270 --> 00:08:29,140
لا بُدّ أنّ الطّبيعة استهلكتْ كثيراً

141
00:08:29,140 --> 00:08:33,570
من الطّاقة والوقت والصّدفة
لصنع هذا المشهد

142
00:08:34,870 --> 00:08:38,200
إنّها ضخمة جدّاً وعظيمة لدرجة
تجعل من العسير عليّ فهمها

143
00:08:39,110 --> 00:08:39,990
هكذا إذاً

144
00:08:40,580 --> 00:08:44,020
لكن هذه الصّخرة هي كنزي

145
00:08:44,400 --> 00:08:47,230
إنّها غالباً الصّخرة الأجمل في العالم

146
00:08:47,640 --> 00:08:49,680
هذا ما يمكنني فهمه

147
00:08:50,910 --> 00:08:54,140
لم أتوقّع وجود أماكن كهذه في اليابان

148
00:08:54,660 --> 00:08:57,440
الكريستالات هي معادن شائعة

149
00:08:57,760 --> 00:09:01,100
قد تختلف من حيث الحجم، لكن هناك
أماكن يمكن جمعها في كافّة البلدان

150
00:09:01,840 --> 00:09:03,550
مُعظم النّاس لا يعلمون ذلك فحسب

151
00:09:05,470 --> 00:09:09,370
الصّفائح التّكتونيّة الأربع تضغط على بعضها الآخر

152
00:09:09,710 --> 00:09:11,160
إنّها ضوضائيّة تحت هذا البلد

153
00:09:11,160 --> 00:09:13,410
تُسبّب كوارث طبيعيّة، لكنّها أيضاً تجعل

154
00:09:13,410 --> 00:09:15,110
هذا البلد أحد أكبر مُنتجي
المعادن في العالم

155
00:09:16,500 --> 00:09:19,850
ياقوت وعقيق أحمر وتوباز وذهب
وفضّة ونُحاس

156
00:09:20,310 --> 00:09:23,800
حتّى الألماس الّذي قيل بأنّه
غير موجود هنا عُثِر عليه

157
00:09:24,410 --> 00:09:26,240
لا يوجد مكان آخر يمكنكِ فيه

158
00:09:26,240 --> 00:09:29,580
جمع كلّ حجر ثمين رئيسيّ
في منطقة صغيرة كهذه

159
00:09:39,390 --> 00:09:41,760
هل يمكنني جمع هذه أيضاً؟

160
00:09:42,990 --> 00:09:44,980
حسناً، نحن نُواجه الطّبيعة هنا

161
00:09:45,230 --> 00:09:47,170
ستحتاجين بعض المعرفة

162
00:09:47,620 --> 00:09:48,560
...إذاً

163
00:09:49,490 --> 00:09:51,820
!إذاً علّميني يا ناغي-سان

164
00:09:58,010 --> 00:10:01,390
آسفة، آسفة. أنتِ مُلحّة جدّاً

165
00:10:03,870 --> 00:10:06,810
أفكّر في البحث عن الغارنيت قريباً

166
00:10:06,810 --> 00:10:08,000
غارنيت؟

167
00:10:08,640 --> 00:10:09,710
هل ترغبين في المجيء معي؟

168
00:10:09,710 --> 00:10:11,000
!أجل

169
00:11:53,200 --> 00:11:54,860
غارنيت

170
00:11:55,070 --> 00:11:59,350
غا-غا-غا-غارنيت، غارنيت

171
00:11:56,620 --> 00:11:57,900
مشينا لمسافة بعيدة جدّاً

172
00:11:57,900 --> 00:11:59,310
هل هو في هذه الأرجاء؟

173
00:12:01,540 --> 00:12:03,310
يبدو أنّنا يمكننا النّزول من هنا

174
00:12:03,600 --> 00:12:05,070
روري-تشان، لنذهب ونتفقّد

175
00:12:05,070 --> 00:12:08,150
ناغي-سان، نحن صديقتان، أليس كذلك؟

176
00:12:08,150 --> 00:12:09,420
ناديني روري

177
00:12:10,130 --> 00:12:11,240
حسناً. هيّا بنا يا روري

178
00:12:11,240 --> 00:12:12,620
!هيّا بنا

179
00:12:14,280 --> 00:12:16,210
الدّرب يمتدّ لأبعد ممّا توقّعت

180
00:12:16,530 --> 00:12:18,140
لا بُدّ أنّ أُناساً يمرّون من هنا

181
00:12:18,900 --> 00:12:20,510
شطرَ أحدهم الحجارة هنا

182
00:12:20,510 --> 00:12:21,950
إنّه قريب. أنا متأكّدة بأنّه قريب

183
00:12:21,950 --> 00:12:23,630
!الغارنيت قريب

184
00:12:23,820 --> 00:12:25,340
ماذا؟ ثمّة شيء هناك

185
00:12:29,180 --> 00:12:30,720
هل هذا هو مكانه؟

186
00:12:34,430 --> 00:12:35,820
ماذا؟

187
00:12:36,260 --> 00:12:39,020
حسناً، لا يسعنا فعل شيء

188
00:12:39,020 --> 00:12:40,580
ما-ماذا تقصدين؟

189
00:12:40,580 --> 00:12:41,970
أقصد ما قلتُه بالضّبط

190
00:12:41,970 --> 00:12:44,540
مع الأسف، لا يمكننا المُتابعة أكثر

191
00:12:45,000 --> 00:12:48,400
ظننتُ بأنّنا سنكون بخير بما أنّ هذا
المكان ذُكِرَ في كتاب

192
00:12:50,630 --> 00:12:52,710
لكن لا أحد يُراقبنا

193
00:12:52,710 --> 00:12:54,920
آسفة. لن أفعل ذلك

194
00:12:57,810 --> 00:13:00,300
!تبّاً لهذه اللّافتة السّخيفة

195
00:13:00,760 --> 00:13:03,600
لا جدوى من صبّ جام غضبكِ على الأشياء

196
00:13:04,220 --> 00:13:08,010
لكن يا ناغي-سان، لولا هذا
—الشّيء، لاستطعنا

197
00:13:08,600 --> 00:13:11,580
،لا. إن كنتِ ستفعلين ذلك

198
00:13:11,580 --> 00:13:14,400
فلن آخذكِ إلى أيّ مكان بعد الآن

199
00:13:17,110 --> 00:13:18,550
هلّا أحسنتِ السُّلوك؟

200
00:13:19,500 --> 00:13:20,320
...حسناً

201
00:13:21,110 --> 00:13:24,740
إذا لم يُسمَح لنا بفعلها، فيجب
علينا طاعة القوانين

202
00:13:25,500 --> 00:13:27,910
لا أريد سماع أي أعذار

203
00:13:28,340 --> 00:13:31,500
قد تحدث أحياناً انهيارات أرضيّة
أو حماية بيئيّة

204
00:13:32,970 --> 00:13:36,530
،كغريبتين، هناك الكثير ممّا قد لا نُلاحظه

205
00:13:36,530 --> 00:13:39,300
لكن ثمّة سبب يجعله محظوراً

206
00:13:41,030 --> 00:13:44,120
حسناً، لكن آمل لو نستطيع
البحث عن أحجار

207
00:13:45,870 --> 00:13:47,010
لنفعل ذلك إذاً

208
00:13:47,010 --> 00:13:50,680
ماذا؟ ناغي-سان، هل تعرفين أماكن
أُخرى حيث نستطيع إيجاد بعض منه؟

209
00:13:51,150 --> 00:13:56,220
لا، لكن أشكّ في أنّ هذا هو المكان
الوحيد الّذي يمكننا فيه الحصول عليه

210
00:13:57,890 --> 00:14:01,780
تتحرّك الصّخور إلى أبعد ما نعتقد

211
00:14:06,530 --> 00:14:08,990
الصّخور تمتدّ؟

212
00:14:09,400 --> 00:14:11,100
لا، الصّخور لا تتحرّك

213
00:14:11,100 --> 00:14:12,840
روري، تعالي إلى هنا

214
00:14:13,970 --> 00:14:15,210
قادمة

215
00:14:16,150 --> 00:14:19,440
هنا سنستخدم غربالاً بدلاً من مِطرقة

216
00:14:27,440 --> 00:14:28,860
ناغي-سان

217
00:14:28,860 --> 00:14:31,640
هل يوجد أي غارنيت في أسفل النّهر حقّاً؟

218
00:14:31,850 --> 00:14:35,050
أجل. اجرفي بعض الحصى إلى
داخل الغربال وانخليها جيّداً

219
00:14:35,050 --> 00:14:36,520
حقّاً؟

220
00:14:36,850 --> 00:14:39,560
لكن هذا مكان مُختلف تماماً
عن تلك الجبال

221
00:14:39,830 --> 00:14:43,490
قد يبدو من الغريب البحث
عن غارنيت في مكان بعيد

222
00:14:45,720 --> 00:14:49,040
لكن بوسعكِ البحث في هذا النّهر بأكمله

223
00:14:49,040 --> 00:14:52,030
ولن تجدي أبداً حجراً كان
هنا من الأساس

224
00:14:52,830 --> 00:14:57,120
صحيح أنّ الغارنيت يبدأ في الجبال
البعيدة من هنا

225
00:14:58,250 --> 00:15:01,620
الحجارة الّتي تتعرّض للرّياح
...والمطر في الجبال

226
00:15:03,070 --> 00:15:05,920
تتفتّت وتسقط في نهاية المطاف

227
00:15:10,700 --> 00:15:15,500
ثمّ يجرفها تيّار النّهر وتهترئ

228
00:15:17,520 --> 00:15:20,240
،للوهلة الأولى، قد تبدو بعيدة

229
00:15:21,050 --> 00:15:25,710
لكن هذا النّهر مُتّصل في الواقع
بالغارنيت الّذي في ذلك الجبل

230
00:15:27,290 --> 00:15:28,770
لكنّها مُجرّد نظريّة منّي

231
00:15:29,040 --> 00:15:30,360
—لا أعلم ما إن كنّا سنجد فعلاً

232
00:15:30,360 --> 00:15:31,310
!ناغي-سان

233
00:15:32,940 --> 00:15:34,550
هذه كريستالة جميلة

234
00:15:35,210 --> 00:15:36,140
إنّها غارنيت

235
00:15:36,580 --> 00:15:39,120
!أجل! أجل! أجل

236
00:15:38,080 --> 00:15:39,800
يسرّني أنّنا عثرنا على واحدة

237
00:15:39,120 --> 00:15:42,500
!مرحى! رائع

238
00:15:39,800 --> 00:15:41,990
تدفّقتْ كلّ الطّريق إلى هنا فعلاً

239
00:15:45,800 --> 00:15:48,890
حسناً، والآن لا أُريد أن أُغادر خالية الوفاض

240
00:15:48,890 --> 00:15:51,840
!حسناً! لنبحث عن المزيد

241
00:15:55,520 --> 00:15:57,780
لا شيء. لا يوجد شيء هنا

242
00:15:58,710 --> 00:15:59,960
ماذا عنكِ يا ناغي-سان؟

243
00:15:59,960 --> 00:16:01,650
وجدتُ اثنتين فقط

244
00:16:01,650 --> 00:16:04,310
!كريستالتان كاملتان؟ هذا ليس عدلاً

245
00:16:04,310 --> 00:16:06,570
هل تستخدمين طريقة خاصّة ما؟

246
00:16:06,570 --> 00:16:07,710
طريقة خاصّة؟

247
00:16:08,180 --> 00:16:10,380
يتمتّع الغارنيت بجاذبيّة مُحدّدة عالية

248
00:16:10,380 --> 00:16:12,130
بصيغة أُخرى، إنّه معدن ثقيل

249
00:16:12,560 --> 00:16:14,480
،حالما يستقرّ

250
00:16:14,480 --> 00:16:18,590
يتطلّب قوّةً أكبر لإزالته مُقارنة
،بالمعادن الأخفّ

251
00:16:18,590 --> 00:16:21,600
لذا هو لا يتحرّك بنفس القدر حيث

252
00:16:21,600 --> 00:16:24,310
يكون التيّار أضعف ويميل المعدن
للتّراكُم هناك

253
00:16:25,330 --> 00:16:26,320
...لذا

254
00:16:26,320 --> 00:16:29,980
!أرجوكِ يا ناغي-سان! بسّطي كلامكِ

255
00:16:30,510 --> 00:16:33,640
في هذه الحالة، ابحثي في أسفل
التيّار عند الصّخور الكبيرة

256
00:16:33,910 --> 00:16:37,060
يتباطأ التيّار هناك، لذا من المُرجّح
أن يتجمّع الغارنيت هناك

257
00:16:37,430 --> 00:16:41,330
...صخور كبيرة؟ صخور كبيرة

258
00:16:41,820 --> 00:16:43,410
!هذه صخرة كبيرة

259
00:16:43,410 --> 00:16:44,890
لكنّها على الضفّة المُعاكسة

260
00:16:44,890 --> 00:16:47,260
لكن غالباً سنجد غارنيت هناك

261
00:16:48,400 --> 00:16:50,850
سنرى إن كنّا سنجد مكاناً ضحلاً
يمكن عبوره

262
00:16:50,850 --> 00:16:55,710
،أعدكِ بأن أوصلكِ إلى هناك بأمان
لذا يمكنكِ الاعتماد عليّ

263
00:17:02,260 --> 00:17:05,140
!حـ-حسناً، هيّا نبحث عن بعض الصُّخور

264
00:17:18,380 --> 00:17:20,090
!وجدتُ واحداً

265
00:17:24,990 --> 00:17:29,070
مُذهل. انتقلتْ كلّ هذه إلى
هنا من ذلك الجبل

266
00:17:29,480 --> 00:17:34,350
،عندما قلتِ أوّل مرّة بأنّ الصّخور تتحرّك
،لم أفهم ما قصدتِه

267
00:17:34,350 --> 00:17:36,650
لكن الأمر بسيط جدّاً حالما نفهمه

268
00:17:36,940 --> 00:17:39,850
،تسقط في النّهر من الجبل
،وتتدفّق عبر النّهر نزولاً

269
00:17:39,850 --> 00:17:42,270
وينتهي المطاف بها في المُحيط

270
00:17:42,270 --> 00:17:43,970
هكذا يسير الأمر، صحيح؟

271
00:17:43,970 --> 00:17:46,210
في الواقع، لا تنتهي رحلة هذا
المعدن في المُحيط

272
00:17:46,770 --> 00:17:48,300
لكن ثمّة مكان آخر ينتقل إليه

273
00:17:48,950 --> 00:17:51,370
قمّة جبل إيفرست مثالاً

274
00:17:51,370 --> 00:17:53,430
كان في قاع البحر في السّابق

275
00:17:53,430 --> 00:17:56,210
أحياناً تصعد الصُّخور الجبالَ
من قاع البحر

276
00:17:56,890 --> 00:17:58,890
،إذا طالَتْها حركة الصّفائح

277
00:17:58,890 --> 00:18:03,110
فيمكن لها أن تغور تحت الأرض
وتغدو جزءاً من بُركان

278
00:18:04,230 --> 00:18:06,230
إذا ثار البُركان، يمكنها أن تطير

279
00:18:07,840 --> 00:18:09,960
حركتها أقلّ محدوديّة من البشر

280
00:18:10,570 --> 00:18:12,860
بالنّسبة لنا، تبدو وكأنّها ثابتة

281
00:18:12,860 --> 00:18:15,880
لأنّها تعمل بمقياس زمنيّ
مُختلف عن مقياسنا

282
00:18:16,390 --> 00:18:21,230
تتحرّك الصُّخور بمقياس آلاف
وملايين السّنين

283
00:18:22,690 --> 00:18:25,500
من المُهمّ وضع وجهة النّظر هذه
بعين الاعتبار عند جمع المعادن

284
00:18:25,950 --> 00:18:29,200
يمكن أن تكون مُفيدة في إيجاد
أماكن للبحث، مثل هذه المرّة

285
00:18:29,690 --> 00:18:33,000
هل هذا يعني أنّكِ تعرفين
مكان الغارنيت؟

286
00:18:33,250 --> 00:18:35,330
لنستمرّ في البحث إذاً

287
00:18:35,910 --> 00:18:39,010
،إذا كنّا سنبحث عن المزيد

288
00:18:40,110 --> 00:18:41,710
فينبغي أن نذهب لأعلى التيّار

289
00:18:54,440 --> 00:18:56,720
هل وقع انهيارٌ أرضيّ في رافد النّهر؟

290
00:18:57,270 --> 00:18:58,920
يبدو أنّ ذلك حدث منذ زمن بعيد

291
00:19:05,190 --> 00:19:07,550
التيّارات هنا مُعقّدة

292
00:19:08,030 --> 00:19:09,960
...في مكانٍ ما هنا ينبغي أن يكون

293
00:19:20,050 --> 00:19:20,870
روري

294
00:19:21,390 --> 00:19:22,330
انظري

295
00:19:51,580 --> 00:19:54,050
ربّما كان ينبغي أن أجمع المزيد

296
00:19:54,340 --> 00:19:56,590
ماذا ستفعلين حتّى بالمزيد؟

297
00:19:56,590 --> 00:20:00,790
كان يوجد الكثير من الغارنيت هناك

298
00:20:01,190 --> 00:20:03,280
هل يحدث ذلك بصورة طبيعيّة؟

299
00:20:05,010 --> 00:20:10,020
التيّارات المُعقّدة الّتي تشكّلتْ بواسطة
ذلك المكان فصلت المعادنَ غالباً

300
00:20:10,720 --> 00:20:15,110
،لدى المعادن جاذبيّة مُحدّدة مُختلفة
لذا فهذا ليس مستحيلاً

301
00:20:15,740 --> 00:20:20,570
يتطلّب توازناً دقيقاً جدّا، أشبه
بعبور خيط من حرير العنكبوت

302
00:20:21,420 --> 00:20:25,450
الآن، الأحجار هناك مُتآكلة بواسطة
النّهر وتتحرّك كلّ يوم تقريباً

303
00:20:26,150 --> 00:20:30,580
قد تمضي أيّام أو قرون حتّى
ينهار ذلك التّوازن

304
00:20:32,040 --> 00:20:33,740
ستختفي في نهاية المطاف إذاً

305
00:20:33,950 --> 00:20:35,330
!يا للهدر

306
00:20:39,420 --> 00:20:41,760
هل نعود يا روري؟

307
00:20:41,760 --> 00:20:42,800
حسناً

308
00:20:42,800 --> 00:20:44,160
انظري إلى هذه يا ناغي-سان

309
00:20:44,160 --> 00:20:45,180
!هناك

310
00:20:48,140 --> 00:20:51,350
ستُجرَف تلك الصّخرة نحو المُحيط، صحيح؟

311
00:20:52,240 --> 00:20:53,690
في نهاية المطاف، أجل

312
00:20:53,690 --> 00:20:57,940
بعد مليون سنة، هل سينتهي المطاف به
على قمّة جبل مثل إيفرست؟

313
00:21:01,370 --> 00:21:03,400
ربّما

314
00:21:03,970 --> 00:21:09,150
في الواقع، قد يُسبّب هجوم نيزك
قذفه في الفضاء

315
00:21:09,150 --> 00:21:11,680
غير ممكن. معقول؟

316
00:21:43,810 --> 00:21:47,560
!أرجوك

317
00:21:47,560 --> 00:21:50,310
!أعطيني سلفة من مصروف الشّهر المُقبل

318
00:21:50,510 --> 00:21:53,120
ها أنتِ ذي من جديد

319
00:21:55,040 --> 00:21:57,100
حسناً، ما الأمر هذه المرّة؟

320
00:21:57,320 --> 00:21:58,850
ملابس؟ مكياج؟

321
00:21:58,850 --> 00:21:59,950
لا

322
00:22:00,680 --> 00:22:04,340
شيء أفضل من ذلك