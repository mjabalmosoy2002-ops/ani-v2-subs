1
00:00:02,570 --> 00:00:05,110
!لذيذ للغاية

2
00:00:05,110 --> 00:00:08,710
لا تنسين، ما زال علينا أن نتناول
العشاء لاحقاً

3
00:00:08,710 --> 00:00:10,100
!سأكون بخير

4
00:00:10,100 --> 00:00:12,910
...استمتعنَ بما أنّكن ما زلتُن صغيرات

5
00:00:12,910 --> 00:00:15,080
إيماري، لا تزالين صغيرة أيضاً

6
00:00:15,080 --> 00:00:19,080
لا أدري، كنتُ شاردة الذّهن مؤخّراً

7
00:00:19,080 --> 00:00:21,600
عليكِ أن تتذكّري أخذ استراحة
بين الفيّنة والأُخرى

8
00:00:21,600 --> 00:00:22,840
!تماماً

9
00:00:22,840 --> 00:00:26,600
فضلاً عن ذلك، تعزو رحلة الينابيع
!السّاخنة هذه لكِ

10
00:01:59,790 --> 00:02:03,500
!كم هذا واسع

11
00:02:03,500 --> 00:02:06,030
!هذا مُذهل

12
00:02:06,030 --> 00:02:07,850
ليس سيّئاً

13
00:02:08,820 --> 00:02:11,400
!انظري إلى هذا السّقف الوعائيّ

14
00:02:11,400 --> 00:02:14,320
لا بُدّ أنّه مُستلهَم من الهندسة
!الغربيّة الانتقائيّة

15
00:02:14,320 --> 00:02:16,240
—وكلّ هذه التّفاصيل المُتقَنة

16
00:02:16,240 --> 00:02:18,840
يبدو أنّ النُّزُل بأكمله صُمِّم بهذه الطّريقة

17
00:02:18,840 --> 00:02:20,500
!يا له من مكان مُذهل

18
00:02:20,500 --> 00:02:22,120
!سينباي، لنذهب ونلقِ نظرة

19
00:02:22,120 --> 00:02:22,960
!هيّا! من هنا

20
00:02:22,960 --> 00:02:24,510
!مهلاً، انتظري يا إيماري

21
00:02:27,960 --> 00:02:31,270
تتحمّس إيماري-سان زيادة عن اللّزوم أحياناً

22
00:02:31,270 --> 00:02:34,620
أوتظنّين ذلك؟ لا أطيق انتظار
أن أصبح تلميذة كلّية مثلها

23
00:02:34,620 --> 00:02:37,900
بوسعي قضاء كلّ وقتي على أشياء أُحبّها

24
00:02:37,900 --> 00:02:40,620
لديكِ أشياء تريدين فعلها حقّاً

25
00:02:40,620 --> 00:02:42,020
ليتني مثلكِ

26
00:02:44,100 --> 00:02:46,630
لكن استمتعنا بصنع ذلك الرّاديو البلّوريّ

27
00:02:47,210 --> 00:02:49,440
أجل، لكنّه انتهى بالفعل

28
00:02:49,920 --> 00:02:54,310
على ذكر الأمر، لعلّ ناغي-سان
وإيماري-سان تعيشان حياة مثاليّة

29
00:02:54,310 --> 00:02:55,820
ماذا تقصدين؟

30
00:02:55,820 --> 00:02:59,480
إنّهما ذكيّتان ولديهما طموح

31
00:02:56,430 --> 00:02:59,990
!انظري! إنّها من فترة ميجي

32
00:02:59,480 --> 00:03:03,070
أنا واثقة بأنّهما تستمتعان طوال اليوم
دون وجود ما يُقلقهما

33
00:03:03,070 --> 00:03:06,040
أشكّ في أنّ حياتهما بتلك البساطة

34
00:03:06,660 --> 00:03:08,220
ماذا عنكِ يا تانيغاوا-سان؟

35
00:03:08,220 --> 00:03:11,560
هل سبقَ وفكّرتِ في مُستقبلكِ
أو مسيرتكِ المهنيّة؟

36
00:03:13,490 --> 00:03:15,800
!انظري يا سيتو-سان

37
00:03:16,600 --> 00:03:18,730
!مفاجأة

38
00:03:19,510 --> 00:03:22,830
لا تكتمل العطلة إلّا بارتداء يوكاتا

39
00:03:22,830 --> 00:03:25,830
—بالتّأكيد. إذاً بالعودة إلى ما كنتُ أقوله

40
00:03:25,830 --> 00:03:30,690
!حسناً! حان وقت استكشاف النُّزُل أيضاً

41
00:03:28,140 --> 00:03:30,690
!ا-انتظري يا تانيغاوا-سان

42
00:03:40,890 --> 00:03:43,060
!لا يسعني سوى التوقُّف وتأمُّل الصُّخور

43
00:03:43,060 --> 00:03:44,540
كذلك أنا

44
00:03:45,200 --> 00:03:46,940
هل خرجتُما للاستكشاف أيضاً؟

45
00:03:46,940 --> 00:03:48,080
!ناغي-سان

46
00:03:48,080 --> 00:03:50,330
وجدتُ شيئاً رائعاً

47
00:03:51,390 --> 00:03:53,250
خمِّنا ما يكون هذا

48
00:03:55,740 --> 00:03:57,920
لا أدري، لكن يبدو حليبيّاً؟

49
00:03:57,920 --> 00:04:00,250
...أبيض وجميل، لكن

50
00:04:00,250 --> 00:04:03,470
لماذا يُشبه الدّونات؟

51
00:04:04,020 --> 00:04:07,090
،وجدتُه بينما أتجوّل في أرجاء النُّزُل

52
00:04:05,340 --> 00:04:09,470
!سينباي! يوجد حمّام بطراز فترة تايشو من هنا

53
00:04:07,700 --> 00:04:08,890
!مهلاً

54
00:04:08,890 --> 00:04:11,310
!مـ-مهلاً، إيماري

55
00:04:09,470 --> 00:04:11,310
!من هنا! اتبعيني

56
00:04:12,460 --> 00:04:14,820
قالتْ بأنّها وجدته في هذا النُّزُل

57
00:04:14,820 --> 00:04:17,490
...أرى بعض الأحجار البيضاء هنا، لكن

58
00:04:17,750 --> 00:04:20,900
تلك ليست حليبيّة كهذه

59
00:04:20,900 --> 00:04:24,550
أنا مهتمّة أكثر حيال هذا الشّكل
منه حيال اللّون

60
00:04:24,550 --> 00:04:27,190
لا يبدو طبيعيّاً. هل يُعقَل أنّه مصنوع يدويّاً؟

61
00:04:27,190 --> 00:04:30,040
ما الّذي يمكن أن يكون بهذا الحجم
ولديه فتحة دائريّة؟

62
00:04:32,560 --> 00:04:33,990
بالوعة؟

63
00:04:37,210 --> 00:04:38,600
يبدو هذا بعيداً جدّاً

64
00:04:38,600 --> 00:04:40,620
ماذا عن تمثال؟

65
00:04:41,180 --> 00:04:42,970
هل يُعقَل أنّه من الحديقة؟

66
00:04:47,590 --> 00:04:49,980
ليس هذا أيضاً

67
00:04:49,980 --> 00:04:51,690
...إن لم يكن هنا

68
00:04:52,420 --> 00:04:54,790
ربّما هو ليس من الخارج

69
00:05:03,450 --> 00:05:06,060
لا بُدّ أنّ هذا هو المكان الّذي
وجدته ناغي-سان فيه

70
00:05:06,060 --> 00:05:08,540
إذاً استمدّ شكله من هذا الأنبوب

71
00:05:08,540 --> 00:05:10,660
لكن ما هذا؟

72
00:05:10,660 --> 00:05:11,660
!روري

73
00:05:12,120 --> 00:05:14,920
مُذهل، وجدتُماه بنفسيكما؟

74
00:05:15,520 --> 00:05:19,170
!ناغي-سان! وجدنا الصّخرة هنا، لكن ما هذه؟

75
00:05:19,640 --> 00:05:23,090
إذا أردتُما أن تعرفا، فيمكنني
أن آخذكما إلى مكان صنعها

76
00:05:29,220 --> 00:05:31,160
!هذا رائع

77
00:05:31,160 --> 00:05:35,260
،قيل بأنّه يُحسّن الدّورة الدّمويّة
وبالتّالي قد يُعزز عمليّة الأيض

78
00:05:35,260 --> 00:05:37,510
بوسعي البقاء هنا للأبد

79
00:05:37,510 --> 00:05:40,150
لا شيء يتفوّق على نبع ساخن
في الهواء الطّلق

80
00:05:40,630 --> 00:05:43,240
.بالمناسبة، كدتُ أنسى
أين هي هذه الصّخور؟

81
00:05:43,240 --> 00:05:44,380
هنا

82
00:05:44,380 --> 00:05:45,380
ماذا؟

83
00:05:45,380 --> 00:05:48,490
صُنِعَتْ تلك الصّخرة بواسطة
هذا النّبع السّاخن

84
00:05:51,990 --> 00:05:55,220
،يمكنني أن أميّز بأنّ شيئاً قد خُلِطَ هنا

85
00:05:55,220 --> 00:05:57,360
لكن كيف تستطيع الينابيع السّاخنة
صنع الصُّخور؟

86
00:05:57,360 --> 00:05:58,640
ما المادّة الرّئيسيّة؟

87
00:05:58,640 --> 00:06:00,140
النّبع السّاخن فقط

88
00:06:00,140 --> 00:06:04,510
أو يمكن القول بأنّ النّبع السّاخن
هو الصّخرة بحدّ ذاتها

89
00:06:05,040 --> 00:06:07,530
الينابيع السّاخنة هي نوع
من المياه الجوفيّة

90
00:06:07,900 --> 00:06:11,520
تحتوي المياه الجوفيّة على معادن مُنحلّة
من الصّخور الّتي تتدفّق عبرها

91
00:06:12,070 --> 00:06:17,000
،لكن عندما تصل المياه الجوفيّة إلى السّطح
فإنّ درجة الحرارة أو الضّغط يتغيّران

92
00:06:17,000 --> 00:06:21,690
أو تتأكسد المُكوّنات لتدفع المواد
للعودة إلى الشّكل الصّلب

93
00:06:26,080 --> 00:06:28,830
أصبحتْ بيضاء! أتتحوّل هذه إلى صخرة؟

94
00:06:28,830 --> 00:06:29,830
أجل

95
00:06:29,830 --> 00:06:34,540
إذاً كان ذلك الأنبوب مسدوداً
بهذه الأشياء البيضاء

96
00:06:34,870 --> 00:06:40,180
وجدتُ أنبوباً مهجوراً، لذا استأذنتُ النُّزُل
حول ما إن كنتُ أستطيع الاحتفاظ به

97
00:06:40,180 --> 00:06:44,140
حالما يصبح صُلباً، فإنّ الأنابيب تُسَدّ
خلال بضعة أشهر

98
00:06:44,140 --> 00:06:46,560
لا بُدّ أنّه من الصّعب التّعامل مع هذا

99
00:06:46,560 --> 00:06:48,380
أيّ نوع من الصّخور هو هذا بالضّبط؟

100
00:06:48,380 --> 00:06:50,190
أفترض بأنّ مُعظمه كلس

101
00:06:50,190 --> 00:06:54,000
تختلف مياه النّبع السّاخن
بحسب الجيولوجيا المحلّية

102
00:06:54,340 --> 00:06:57,100
بدراسته، يمكننا معرفة ما يجري تحت الأرض

103
00:06:57,690 --> 00:07:03,820
بعض الينابيع السّاخنة تتشكّل نتيجة مياه
الأمطار الّتي تسخن على مدى عقود

104
00:07:03,820 --> 00:07:06,870
وأُخرى تُستمَدّ من المياه الأحفوريّة
الّتي حُبِسَتْ تحت الأرض

105
00:07:06,870 --> 00:07:09,000
لعشرات آلاف السّنين

106
00:07:09,560 --> 00:07:16,840
وجاء بعضها أيضاً من تسرّب ماء البحر
القديم من الصّفيحات المُحيطيّة تحت الأرض

107
00:07:16,840 --> 00:07:21,300
،والّذي يمكن أن يستغرق ملايين
أو أكثر من عشرة ملايين سنة

108
00:07:21,300 --> 00:07:22,830
!عشرة ملايين؟

109
00:07:22,830 --> 00:07:24,590
توجد ينابيع ساخنة كهذه؟

110
00:07:24,590 --> 00:07:26,320
تماماً، واحزرنَ أيضاً

111
00:07:26,320 --> 00:07:28,310
نحن في نبع ساخن كهذا الآن

112
00:07:29,130 --> 00:07:32,300
يحتوي هذا النّبع السّاخن على مقدار
ضئيل من الحمم

113
00:07:33,520 --> 00:07:36,120
في الحالات الّتي يتسرّب فيها
،الماء من الصّفيحة

114
00:07:36,120 --> 00:07:38,700
،إذا حدث ذلك في عمق شديد من الصّفيحة
فإنّ الحرارة تصبح

115
00:07:38,700 --> 00:07:41,480
شديدة لدرجة أنّ الصّخرة تذوب
وتتّخذ شكل حمم

116
00:07:42,220 --> 00:07:44,560
،مع برودة وتصلّب الحمم في نهاية المطاف

117
00:07:44,560 --> 00:07:47,820
ينفصل عنه الماء، ويُدعى حينها
بالماء الصُّهاريّ

118
00:07:47,820 --> 00:07:50,800
لم أكن أعلم بأنّ الماء الصُّهاريّ موجود أصلاً

119
00:07:50,800 --> 00:07:54,620
!لذا من ناحية، نحن نجلس على حمم الآن

120
00:07:54,620 --> 00:07:58,310
يحمل الماء الصُّهاريّ الكثير
،من عناصر الحمم الأصليّة

121
00:07:58,310 --> 00:08:00,800
وبينما يبرد، يُشكِّل الكثير من أنواع الصُّخور

122
00:08:00,800 --> 00:08:04,030
حتّى بعد أن يُغيّر شكله، لا يزال يحتفظ
بآثار ما كان عليه من قبل

123
00:08:04,030 --> 00:08:07,550
في هذه اللّحظة عينها، ما زال يخضع
لعمليّة التحوُّل إلى حجر

124
00:08:12,770 --> 00:08:19,250
قد تكون مائيّة، لكن الينابيع السّاخنة قد تكون
...حقّاً صخوراً بحدّ ذاتها

125
00:08:31,320 --> 00:08:32,810
بالمناسبة يا سينباي

126
00:08:32,810 --> 00:08:37,580
سمعتُ بأنّكِ رفضتِ ذلك العرض
للعمل كأمينة متحف

127
00:08:38,170 --> 00:08:39,140
أجل

128
00:08:39,140 --> 00:08:42,170
لا توجد شواغر كثيرة لاختصاصيّي الأحجار

129
00:08:42,170 --> 00:08:43,840
أليس من الهدر تفويت ذلك؟

130
00:08:44,640 --> 00:08:47,420
...هدر... أجل، ربّما

131
00:08:47,420 --> 00:08:49,720
!مـ-مـ-مهلاً لحظة

132
00:08:50,230 --> 00:08:53,710
ناغي-سان! تقصدين بأنّه من المُمكن
!أن تكوني قد رحلتِ في العام المُقبل؟

133
00:08:53,710 --> 00:08:56,010
إن قُبِلتُ فقط

134
00:08:56,010 --> 00:08:58,680
لكن لماذا ترفضين عرضاً رائعاً كهذا؟

135
00:08:58,680 --> 00:09:01,440
يمكنكِ إجراء أبحاث حول
الصّخور لتوفير قوت يومكِ

136
00:09:01,700 --> 00:09:03,920
ما زالت لديّ مشاريع بحث جارية

137
00:09:03,920 --> 00:09:07,610
وأرغب في البقاء في المدرسة وأتابع
بحثي ما زال ذلك مُمكناً

138
00:09:07,610 --> 00:09:09,760
البقاء في المدرسة؟

139
00:09:09,760 --> 00:09:11,240
يعني...؟

140
00:09:12,200 --> 00:09:16,410
،حلمي هو أن أكون أستاذة كلّية ذات يوم

141
00:09:18,830 --> 00:09:22,400
هذا رائع! أنا متأكّدة بأنّكِ تستطيعين
!فعلها يا ناغي-سان

142
00:09:22,400 --> 00:09:23,630
شكراً

143
00:09:23,930 --> 00:09:27,370
،سواء كنتِ أستاذة كلّية، أو أمينة متحف

144
00:09:27,370 --> 00:09:29,910
سيكون من الصّعب كثيراً توفُّر
شواغر للعمل

145
00:09:29,910 --> 00:09:33,740
إذا كان ما تُريدين فعله هو بحث، فليس
بالضّرورة أن يكون في الكلّية

146
00:09:33,740 --> 00:09:35,290
هل أنتِ متأكّدة بأنّ هذا ما تُريدينه؟

147
00:09:37,350 --> 00:09:40,820
سيتو-سان، تبدين وكأنّكِ أستاذتي

148
00:09:41,340 --> 00:09:42,740
بالمُناسبة يا إيماري

149
00:09:42,740 --> 00:09:47,290
تكلّمتِ عن الحصول على كلّ من رخصة أمينة
صندوق ورخصة تدريس في الثّانويّة

150
00:09:47,600 --> 00:09:49,360
ما هي مخطّطاتك؟

151
00:09:49,360 --> 00:09:51,530
يبدو أنّه لم تكن هناك أيّة شواغر

152
00:09:51,530 --> 00:09:54,220
لتدريس علم الأرض في مُحافظتنا مؤخّراً

153
00:09:54,220 --> 00:09:56,060
هذه حقيقة قاسية جدّاً

154
00:09:56,060 --> 00:09:59,090
،أرغب في دخول مجال البحث أيضاً
لكن إذا لم يكن ذلك مُمكناً

155
00:09:59,090 --> 00:10:04,160
آمل أن أتمكّن على الأقلّ من مُمارسة
علم الأرض أو علم المعادن

156
00:10:05,720 --> 00:10:08,470
آسفة إذا كان كلامي غريباً

157
00:10:08,470 --> 00:10:12,480
من يتوقّع أنّه حتّى أمثال ناغي-سان
وإيماري-سان لديهما همومهما؟

158
00:10:12,480 --> 00:10:15,050
يغدو الأمر منطقيّاً عند التّفكير في الأمر

159
00:10:15,050 --> 00:10:18,320
لا يوجد شخص في العالم بلا هموم

160
00:10:18,320 --> 00:10:21,190
لا سيّما الأشخاص الّذين
لديهم رؤية مثاليّة لمُستقبلهم

161
00:10:21,190 --> 00:10:25,350
أقنع نفسي بذلك دوماً، لكن
لا يسعني سوى القلق

162
00:10:25,720 --> 00:10:29,310
مهما اشتدّت صعوبة الأمر، لن أفقد
!الأمل من أن أصبح باحثة

163
00:10:29,310 --> 00:10:32,650
،لا سيّما الآن بعد أن التقيتُ بكما
!سأعمل بجدّ أكبر حتّى

164
00:10:33,010 --> 00:10:35,750
من فضلكما عِداني بأنّكما ستصبحان باحثتين

165
00:10:35,750 --> 00:10:37,860
بهذا الشّكل، يمكنني أن
!أحذو حذوّكما

166
00:10:37,860 --> 00:10:39,880
تحذين حذوّنا؟

167
00:10:39,880 --> 00:10:42,700
لسنا عظيمتين إلى هذا الحدّ

168
00:10:42,950 --> 00:10:45,070
لكن يمكننا أن نُحاول جميعنا معاً

169
00:10:45,070 --> 00:10:46,170
!أجل

170
00:11:04,770 --> 00:11:06,980
!بصحّتكن

171
00:11:15,220 --> 00:11:16,780
!هذا لذيذ جدّاً

172
00:11:16,780 --> 00:11:17,900
!يبدو لذيذاً

173
00:11:17,900 --> 00:11:19,870
بوسعي أكل هذا طوال اليوم

174
00:11:20,810 --> 00:11:22,410
هل شبعتِ؟

175
00:11:22,760 --> 00:11:25,000
...ماذا؟ أ-أجل

176
00:11:25,000 --> 00:11:28,140
رأيتِ؟ لهذا نصحتُكِ ألّا تُخفّفي جوعكِ

177
00:11:29,170 --> 00:11:30,690
حسناً، سأكملها عنكِ

178
00:11:30,690 --> 00:11:31,760
...لـ-لا مشكلة

179
00:11:31,760 --> 00:11:32,760
لا تقلقي

180
00:11:32,760 --> 00:11:33,260
لا داعي للقلق

181
00:11:33,260 --> 00:11:35,910
حسناً! لدينا سماء صافية اللّيلة

182
00:11:36,910 --> 00:11:39,260
ما رأيكن أن نصعد للسّطح؟

183
00:11:44,160 --> 00:11:46,470
!رائع! يا لكلّ هذه النّجوم

184
00:11:46,470 --> 00:11:50,650
يبدو أنّنا نستطيع رؤية قرابة 8،600
نجمة بالعين المُجرّدة

185
00:11:50,650 --> 00:11:54,060
لكن أكثر من 90% منها غير مرئيّة
في المدينة بسبب الإضاءة الشّديدة

186
00:11:55,470 --> 00:11:57,920
من هذا المكان، قد نتمكّن حتّى
من رؤية الشُّهب

187
00:11:57,920 --> 00:11:59,970
هل هناك انهمار نيزكيّ اللّيلة؟

188
00:11:59,970 --> 00:12:02,020
لا، لا شيء على وجه الخصوص

189
00:12:02,020 --> 00:12:03,700
إذاً أليس هذا مستحيلاً؟

190
00:12:03,980 --> 00:12:08,600
يعتقد النّاس بأنّه لا يمكن رؤية الشّهب
،إلّا أثناء الانهمار النّيزكيّ

191
00:12:08,600 --> 00:12:11,680
لكن يُقال بأنّه يظهر حتّى عشرة شُهب
في كلّ ساعة في ليلة طبيعيّة

192
00:12:11,680 --> 00:12:13,330
!أي شهاب في كلّ ستّ دقائق

193
00:12:13,330 --> 00:12:14,780
إذاً لدينا فُرصة جيّدة

194
00:12:14,780 --> 00:12:17,260
!ممتاز! تعال أيّها الانهمار النّيزكيّ

195
00:12:25,900 --> 00:12:29,040
بوسعي تأمُّل هذه السّماء المُرصّعة
بالنّجوم للأبد

196
00:12:29,040 --> 00:12:30,240
أجل

197
00:12:34,150 --> 00:12:35,150
!ها هو

198
00:12:35,150 --> 00:12:36,180
هل رأيتِه؟

199
00:12:36,180 --> 00:12:37,330
!فعلتُها

200
00:12:37,330 --> 00:12:39,140
!انظرن، واحد آخر

201
00:12:39,140 --> 00:12:40,320
حقّاً؟ أين؟

202
00:12:41,740 --> 00:12:42,850
!هناك من جديد

203
00:12:42,850 --> 00:12:44,170
!رأيتُه أيضاً

204
00:12:44,170 --> 00:12:45,160
!صاروا اثنين

205
00:12:45,160 --> 00:12:46,800
!إلى الشّهاب التّالي

206
00:12:52,160 --> 00:12:53,630
مللتِ من الآن؟

207
00:12:54,460 --> 00:12:59,580
ليتني أستطيع رؤيتها للأبد، لكن
الشُّهب سريعة التّلاشي

208
00:12:59,580 --> 00:13:01,300
هذا بديهيّ

209
00:13:02,150 --> 00:13:04,700
لا شيء يدوم

210
00:13:04,700 --> 00:13:08,480
...ليتني أحظى بهذه المتعة للأبد

211
00:13:10,610 --> 00:13:13,310
لا تريدينه أن ينتهي إذاً؟

212
00:13:14,510 --> 00:13:19,030
من الطّبيعيّ أن تريدي احتكار
شيء لنفسكِ قبل أن ينطفئ

213
00:13:20,510 --> 00:13:22,360
لكنّه انتهى، أليس كذلك؟

214
00:13:22,360 --> 00:13:23,960
ليس تماماً

215
00:13:23,960 --> 00:13:25,920
ما زال لدينا متعة نتطلّع لها

216
00:13:27,330 --> 00:13:31,000
ما رأيكن بالحصول على شهاب؟

217
00:13:32,190 --> 00:13:33,660
هل أنتِ ثملة؟

218
00:13:33,660 --> 00:13:34,980
!تقصدين بأنّنا نستطيع البحث عن واحد؟

219
00:13:34,980 --> 00:13:36,040
أجل

220
00:13:36,040 --> 00:13:38,220
لكن ألا تشتعل وتتلاشى فحسب؟

221
00:13:38,220 --> 00:13:39,660
هناك تتمّة لذلك

222
00:13:39,660 --> 00:13:42,590
،قد تهبط في مكان ما بعد أن تشتعل

223
00:13:42,590 --> 00:13:44,970
لكن من المستحيل معرفة مواقعها

224
00:13:44,970 --> 00:13:47,370
لا حاجة للبحث حول مكان سقوطها

225
00:13:47,690 --> 00:13:49,770
يمكننا البحث عنها هنا

226
00:13:50,370 --> 00:13:53,940
تسقط النّيازك على هذا السّطح عينه

227
00:13:57,280 --> 00:13:59,020
مُحال أن يكون هذا صحيحاً

228
00:13:59,020 --> 00:14:00,770
لعلّها ثملة فعلاً

229
00:14:00,770 --> 00:14:04,870
الحقيقة خلف السّقوط النّيزكيّ تختلف
بحسب ما قد تعتقدينه

230
00:14:05,610 --> 00:14:09,590
يُقال بأنّ النّيزك يجب أن يكون بعرض 2 ميلّيمتر
على الأقلّ كي نراه في السّماء

231
00:14:09,590 --> 00:14:13,160
لكن في الحقيقة، مُعظم النّيازك
الّتي تسقط هي أصغر من ذلك

232
00:14:13,560 --> 00:14:17,090
فقط جزء يسير كبير بما يكفي ليُسبّب
ضرراً حقيقيّاً عندما يصطدم بالأرض

233
00:14:17,520 --> 00:14:22,390
معظم النّيازك هي في الواقع صغيرة
جدّاً وتسقط دون أن يُلاحظ أحد

234
00:14:23,120 --> 00:14:28,600
بعبارة أدقّ، ذرّة بقياس 0,1 مم قد تسقط على
متر مُكعّب واحد من الأرض في كلّ عام

235
00:14:28,600 --> 00:14:30,720
...بهذه الحسابات، ينبغي لهذا السّطح

236
00:14:30,720 --> 00:14:32,770
!أن يكون لديه بعض النّيازك

237
00:14:32,770 --> 00:14:35,030
إذاً، كيف نجدها؟

238
00:14:35,030 --> 00:14:37,810
حالما تصل الأرض، تتحرّك
النّيازك كغبار رمليّ

239
00:14:38,130 --> 00:14:41,440
غالباً ما تتراكم في زوايا
السّطح أو المجارير

240
00:14:41,900 --> 00:14:45,900
لجمعها، نستخدم مغناطيساً قويّاً
لالتقاط المواد العالقة

241
00:14:45,900 --> 00:14:49,030
لكن أليست بعض النّيازك غير معدنيّة؟

242
00:14:49,030 --> 00:14:50,830
صيد ممتاز يا سيتو-سان

243
00:14:51,830 --> 00:14:56,190
إذا نظرنا إلى النّيازك كَكُلّ، فإنّ
معظمها لا تلتصق بالمغناطيس

244
00:14:56,190 --> 00:14:59,360
لكن تلك لا يمكن تفريقها فعلاً
عن الصّخور في الأرض

245
00:14:59,360 --> 00:15:01,710
لذا نحن نستبعدها هذه المرّة

246
00:15:02,340 --> 00:15:03,790
!توخّي الحذر

247
00:15:04,660 --> 00:15:10,200
من كان يتوقّع بأنّ مجارير التّصريف يمكن أن تكون
أدوات لجمع النّيازك الّتي سقطت على السّطح؟

248
00:15:17,150 --> 00:15:20,500
لدينا هذه الكمّية. أكلّ هذه نيازك؟

249
00:15:20,500 --> 00:15:22,940
سوف نبحث عنها تحت مجهر

250
00:15:22,940 --> 00:15:26,130
لذا علينا انتظار العودة إلى المُختبر؟

251
00:15:27,460 --> 00:15:30,830
،في الحقيقة، أخبرتني سينباي عن هذا
!لذا أحضرتُ واحداً

252
00:15:33,040 --> 00:15:34,660
!مُفاجأة

253
00:15:34,660 --> 00:15:36,340
!هذا رائع يا إيماري-سان

254
00:15:36,340 --> 00:15:38,590
!الحذر أفضل من النّدم

255
00:15:39,130 --> 00:15:42,420
نأخذ الرّمل المُجمَّع وننثره على صفيحة
بِتري للبحث عن النّيازك

256
00:15:42,420 --> 00:15:45,990
وحالما نجد واحداً، نلتقطه بفرشاة مُبتلّة

257
00:15:45,990 --> 00:15:48,160
وكيف هو شكل النّيزك؟

258
00:15:48,160 --> 00:15:49,830
لديه شكل دائريّ

259
00:15:49,830 --> 00:15:52,930
،إذا استطعتِ رؤية شكل مُميّز عليه
فهذا مثاليّ

260
00:15:52,930 --> 00:15:54,980
لدى النّيازك أشكال؟

261
00:15:54,980 --> 00:16:00,220
عندما تسقط النّيازك في الأرض، فإنّها تخضع
لتغيُّر بسبب الاحتكاك مع الجوّ

262
00:16:00,220 --> 00:16:05,990
،هذا بحدّ ذاته ليس غريباً بالنّسبة للصّخور
لكن وحدها النّيازك الّتي تمرّ بتغييرات كهذه

263
00:16:05,990 --> 00:16:09,380
بينما تدور وتُسافر بسرعة عشرات
الكيلومترات في الثّانية

264
00:16:09,380 --> 00:16:12,530
ما يؤدّي أحياناً إلى شكل مُميّز

265
00:16:12,530 --> 00:16:15,660
إذاً حجر غريب الشّكل ودائريّ. فهمت

266
00:16:15,660 --> 00:16:18,870
لكن ما هو مظهر الشّكل بالضّبط؟

267
00:16:18,870 --> 00:16:21,760
لا أستطيع شرحه بكلمات حقّاً

268
00:16:21,760 --> 00:16:24,550
أعتقد ستعرفان حالما تريانه

269
00:16:25,540 --> 00:16:27,970
!بجدّية! يبدو هذا حماسيّاً للغاية

270
00:16:28,450 --> 00:16:30,370
إجمالاً، لونه داكن جدّاً

271
00:16:30,370 --> 00:16:33,140
لكن جميعها تبدو كذرّات رمل عاديّة

272
00:16:33,410 --> 00:16:36,800
بما أنّه يعلق بمغناطيس، فهل
كلّه عبارة عن ماغنيتيت؟

273
00:16:36,800 --> 00:16:39,060
ربّما يحتوي على ذلك أيضاً

274
00:16:42,200 --> 00:16:44,040
هناك بعضها غريب الشّكل

275
00:16:44,040 --> 00:16:45,770
هل يُعقل أن تكون هذه؟

276
00:16:45,770 --> 00:16:47,760
إن لم تكن دائريّة، فليست كذلك

277
00:16:47,760 --> 00:16:49,920
!هنا! وجدتُ واحدة دائريّة

278
00:16:52,070 --> 00:16:53,180
هذه ليست هي

279
00:16:53,180 --> 00:16:54,960
لـ-لمَ أنتِ متأكّدة؟

280
00:16:54,960 --> 00:16:58,170
لن يلتصق نوعان معاً هكذا
إن كانا نيزكين

281
00:16:58,170 --> 00:17:01,250
أعتقد بأنّها اصطناعيّة، مثل
الشّرارات من مصنع

282
00:17:03,520 --> 00:17:05,340
!وجدتُ دائرة مثاليّة

283
00:17:05,340 --> 00:17:06,870
معكِ حقّ

284
00:17:06,870 --> 00:17:09,510
لديه سطح خشن الملمس غريب الشّكل أيضاً

285
00:17:09,770 --> 00:17:12,430
وجدتُ واحدة أيضاً. دائريّة خشنة الملمس

286
00:17:12,430 --> 00:17:13,310
ما لونها؟

287
00:17:13,310 --> 00:17:13,950
أسود

288
00:17:13,950 --> 00:17:15,110
!كذلك هنا

289
00:17:15,110 --> 00:17:16,770
!فعلناها

290
00:17:16,770 --> 00:17:18,360
يوجد اثنان منهما

291
00:17:18,770 --> 00:17:20,720
هل يمكنكما إيجاد المزيد؟

292
00:17:22,870 --> 00:17:23,870
وجدتُ واحداً

293
00:17:23,870 --> 00:17:25,290
وجدتُ واحداً هنا أيضاً

294
00:17:25,290 --> 00:17:28,180
إذاً هذا ليس نيزكاً غالباً

295
00:17:28,180 --> 00:17:30,820
لِمَ لا؟ ما الخطب هذه المرّة؟

296
00:17:30,820 --> 00:17:33,370
حتّى بوضع تكرار سقوط النّيازك
،بعين الاعتبار

297
00:17:33,370 --> 00:17:36,180
إنّه ليس شيئاً يمكننا إيجاد
الكثير منه في آن واحد

298
00:17:36,180 --> 00:17:39,540
ما وجدتُماه هو غالباً شيء اصطناعيّ

299
00:17:39,800 --> 00:17:43,330
بئساً، إيجاد النّيازك ليس مزحة

300
00:17:40,430 --> 00:17:41,900
إيماري-سان، هل تريدين إلقاء نظرة؟

301
00:17:41,900 --> 00:17:43,330
متأكّدة؟

302
00:17:46,000 --> 00:17:47,740
!يا للظّرافة

303
00:17:47,740 --> 00:17:49,510
ما هو الظّريف؟

304
00:17:49,960 --> 00:17:52,060
إنّها كريستالة

305
00:17:52,060 --> 00:17:53,380
هل هذا ماغنيتيت؟

306
00:17:53,380 --> 00:17:56,410
هذا ما أعتقده. أليس ثُماني السّطوح ظريفاً؟

307
00:17:56,410 --> 00:17:59,060
!لم أتوقّع أن نجد كريستالات رائعة أيضاً

308
00:17:59,350 --> 00:18:02,800
يمكن أن تختلط بينها كريستالات
جميلة إذا كان منشأها قريباً

309
00:18:02,800 --> 00:18:06,090
لا بُدّ أنّها حُمِلَتْ إلى السّطح بواسطة الرّياح

310
00:18:06,090 --> 00:18:09,560
أحياناً، يمكن إيجاد معادن
في أماكن غير معتادة

311
00:18:09,560 --> 00:18:11,990
لا سيّما على مستوى مجهري كهذا

312
00:18:12,350 --> 00:18:13,750
...هكذا إذاً

313
00:18:13,750 --> 00:18:16,430
كان هذا مُجرّد غُبار مُتراكم على سطح

314
00:18:16,430 --> 00:18:18,910
بدتْ كتربة قديمة عاديّة

315
00:18:19,710 --> 00:18:24,800
لكنّه في الواقع مجموعة من الأشياء الاصطناعيّة
أو كريستالات معدنيّة، أو نيازك

316
00:18:24,800 --> 00:18:28,500
لم أكن أعلم أنّ ذلك سيبدو
حماسيّاً تحت مجهر

317
00:18:28,500 --> 00:18:31,890
يبدو جمع كريستالات معدنيّة مجهريّة
ضئيلة الحجم مُمتعاً

318
00:18:31,890 --> 00:18:32,890
!بكلّ تأكيد

319
00:18:32,890 --> 00:18:35,500
إذا كانت بهذا الحجم الصّغير، فقد
تتّسع في شريحة زُجاجيّة مُنزلقة

320
00:18:35,500 --> 00:18:36,630
فكرة ممتازة

321
00:18:36,630 --> 00:18:39,930
.سيكون صندوق الأصناف الأصغر حجماً في العالم
غير مرئيّ إلّا بمجهر

322
00:18:39,930 --> 00:18:40,930
!ينبغي أن نصنع واحداً

323
00:18:47,040 --> 00:18:48,610
أتحتاجين استراحة؟

324
00:18:48,610 --> 00:18:51,920
لا، هذا مُمتع. أشعر وكأنّني
أبحث عن كنز

325
00:18:51,920 --> 00:18:56,950
كنتُ أستمتع بتأمُّل النّجوم، لكن لم أكن
أعلم بأنّنا نستطيع رؤيتها عن كثب

326
00:18:56,950 --> 00:18:58,240
حقّاً؟

327
00:18:58,240 --> 00:19:00,880
،إذا فتحتِ عقلكِ لما هو آتٍ

328
00:19:00,880 --> 00:19:03,840
ستكتشفين بأنّ هناك الكثير من
الأشياء المُثيرة للاهتمام حولنا

329
00:19:03,840 --> 00:19:06,690
وحتّى أنّكِ قد تتوصّلين لاكتشاف
رائع من خلال الصّدفة

330
00:19:06,690 --> 00:19:09,710
!أجل! أريد الاستمرار في جمع كريستالات صغيرة

331
00:19:09,710 --> 00:19:12,630
إذاً لنذهب ونبحث عن أنواع
أُخرى من غبار الرّمل

332
00:19:13,290 --> 00:19:14,360
!أجل

333
00:19:16,530 --> 00:19:19,100
لا شيء يدوم. كلّ شيء
ينتهي في نهاية المطاف

334
00:19:19,100 --> 00:19:22,800
...ليتني أحظى بهذه المتعة للأبد

335
00:19:23,730 --> 00:19:26,020
كنتُ مُخطئة لاعتقادي ذلك

336
00:19:26,700 --> 00:19:29,630
،لو كانت نفس المتعة تدوم للأبد

337
00:19:29,630 --> 00:19:33,300
لما كنتُ أبحث عن الشّيء المُمتع التّالي أبداً

338
00:19:33,770 --> 00:19:37,130
ما كنتُ لأعرف حماس البحث عن النّيازك

339
00:19:37,130 --> 00:19:40,450
ولما تعلّمتُ شيئاً جديداً

340
00:19:40,870 --> 00:19:45,580
عندما ينتهي شيء مُمتع، فذلك يؤدّي
إلى الشّيء المُمتع التّالي

341
00:19:45,580 --> 00:19:47,640
كنتُ قادرة على التغيُّر في كلّ مرّة

342
00:19:48,130 --> 00:19:49,900
هكذا وصلتُ إلى هنا

343
00:19:51,300 --> 00:19:52,960
!وجدتُها

344
00:19:53,460 --> 00:19:54,990
هذه هي

345
00:19:54,990 --> 00:19:57,010
!توقّعتُ هذا! كنتُ أعلم

346
00:19:57,010 --> 00:19:58,310
!يا له من شكل غريب

347
00:19:58,310 --> 00:19:59,930
يبدو هذا اصطناعيّاً أكثر
!من أيّ شيء آخر

348
00:19:59,930 --> 00:20:01,910
هل يمكنني أن أرى أيضاً؟

349
00:20:04,350 --> 00:20:08,010
في النّهاية، كان نيزك روري-تشان
الوحيد الّذي عثرنا عليه

350
00:20:08,010 --> 00:20:09,570
كم أشعر بالغيرة

351
00:20:09,570 --> 00:20:11,910
يمكنكما تجربة البحث في المنزل أو المدرسة

352
00:20:11,910 --> 00:20:14,900
ينبغي أن تكون الاحتمالات
نفسها في أيّ مكان في الأرض

353
00:20:14,900 --> 00:20:18,840
أجل! خاب أملي لأنّني لم أستطع
،إيجاد واحد بحدّ ذاتي

354
00:20:18,840 --> 00:20:22,470
لكن لم أشعر بقربٍ من الفضاء
مثلما شعرتُ اليوم

355
00:20:23,600 --> 00:20:27,700
،وألّا يكون ذلك من خلال منظار فلكيّ
إنّما من خلال مجهر

356
00:20:27,700 --> 00:20:29,400
هذا غريب، أليس كذلك؟

357
00:20:29,400 --> 00:20:30,990
هذا صحيح

358
00:20:39,280 --> 00:20:40,550
...حتّى الآن

359
00:20:41,750 --> 00:20:46,560
هناك الكثير من النّيازك صغيرة الحجم
الّتي تتساقط ولا نستطيع رؤيتها

360
00:20:56,950 --> 00:21:00,430
تعتقدين بأنّ هناك صخوراً تعوم
في الرّياح الآن؟

361
00:21:00,430 --> 00:21:01,800
ربّما

362
00:21:02,530 --> 00:21:04,690
ناغي-سان، أتعلمين؟

363
00:21:04,690 --> 00:21:08,530
في السّابق، كان كلّ ما أهتمّ به
هو إيجاد صخور جميلة

364
00:21:08,530 --> 00:21:09,770
أجل

365
00:21:09,770 --> 00:21:13,810
لكن الآن، أتساءل لماذا هذه
الصّخرة جميلة جدّاً مثلاً

366
00:21:13,810 --> 00:21:16,070
أو لماذا تتواجد في مكان مُعيّن

367
00:21:16,070 --> 00:21:18,510
أريد أن أتعلّم كيف أصبحتْ جميلة

368
00:21:18,830 --> 00:21:21,820
شيئاً فشيئاً، بدأتُ أكتشف ذلك

369
00:21:21,820 --> 00:21:25,500
والآن، أحبّ الصّخور الجميلة
أكثر من أيّ وقت مضى

370
00:21:25,500 --> 00:21:28,890
أريد تعلُّم المزيد والمزيد عن الصُّخور

371
00:21:29,370 --> 00:21:30,430
روري

372
00:21:34,190 --> 00:21:36,330
هل تستمتعين؟

373
00:21:37,780 --> 00:21:41,650
!أجل! من المُمتع تعلُّم المزيد من الأشياء

374
00:21:42,500 --> 00:21:45,550
إذاً السّؤال هو: ماذا الآن؟

375
00:21:45,550 --> 00:21:47,530
ماذا تريدين أن تفعلي تالياً يا روري؟

376
00:21:47,960 --> 00:21:49,470
...في الواقع

377
00:21:51,080 --> 00:21:53,580
!أريد العودة. إلى ذلك المكان ثانية

378
00:21:57,010 --> 00:22:00,920
لماذا هذه الصّخرة موجودة هنا
في هذه اللّحظة؟

379
00:22:01,680 --> 00:22:06,050
كيف استمدّتْ لونها وشكلها؟

380
00:22:07,400 --> 00:22:12,450
البعض قد يُجيب بأنّ ذلك نتيجة
سلسلة من المُصادفات

381
00:22:13,490 --> 00:22:20,350
لكن خلف تلك المُصادفات أيضاً مجموعة
من المُستلزمات

382
00:22:21,610 --> 00:22:26,570
...حيث يجد المرء صخرة... والجبال والأنهار المُحيطة بها

383
00:22:27,010 --> 00:22:33,330
ومنشأها... وتاريخ كوكبنا الأرض

384
00:22:34,520 --> 00:22:38,570
كلّ هذا يُساهم في توفير
المُستلزمات في عالمنا

385
00:22:40,070 --> 00:22:45,120
لذا لماذا هذه الصّخرة وُجِدَتْ هنا
في هذه اللّحظة عينها؟

386
00:22:45,990 --> 00:22:49,980
سعى البعضُ للكشف عن الحقيقة
خلف أهمّيتها

387
00:22:50,970 --> 00:22:54,720
وهذا هو إنجاز عظيم بالفعل