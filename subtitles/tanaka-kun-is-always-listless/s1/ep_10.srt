1
00:00:03,310 --> 00:00:07,610
،عندما يشتدّ البرد يمكنك ارتداء المزيد من الملابس

2
00:00:07,610 --> 00:00:10,990
.لكن عندما يشتدّ الحرّ، فهناك حدّ للملابس الّتي يمكنك إزالتها

3
00:00:11,400 --> 00:00:15,240
.ولذلك لا يسعك إلّا الذّهاب إلى المسبح

4
00:00:20,620 --> 00:00:22,370
!مرّريها بسرعة

5
00:00:21,410 --> 00:00:22,370
!انتظري

6
00:00:25,380 --> 00:00:27,340
!تمهّل

7
00:00:30,050 --> 00:00:31,050
.رغم أنّي لا أجيد السّباحة

8
00:00:31,050 --> 00:00:32,170
!ماذا قلت؟

9
00:01:02,370 --> 00:01:06,370
بعد المدرسة أجلس بجانب النّافذة

10
00:01:06,370 --> 00:01:10,460
ونسيم الرّبيع يغريني للنّوم

11
00:01:10,750 --> 00:01:15,010
لذا أغمضت عيناي على هذا العالم السّاطع

12
00:01:15,010 --> 00:01:18,850
بينما الشّمس تجعل المنظر يرقص على جفوني

13
00:01:19,180 --> 00:01:23,100
أصفّر بإبهام نحو السّماء الزّرقاء

14
00:01:23,270 --> 00:01:27,600
وأثب أعلى في خطواتي

15
00:01:27,600 --> 00:01:31,900
نزعت سمّاعاتي في زاوية صاخبة من المدينة

16
00:01:31,900 --> 00:01:36,110
ونظرت إلى الأفق، حيث سمعت صوتًا

17
00:01:40,740 --> 00:01:46,370
هيا نستلقي بلطفٍ في هذه الشّمس المتوهّجة

18
00:01:46,370 --> 00:01:50,460
أبدأ يومًا آخر كالمعتاد

19
00:01:50,460 --> 00:01:54,420
بقيلولةٍ تحت أشعّة الشّمس

20
00:01:54,420 --> 00:02:00,350
في هذا المكان الدّافئ معك

21
00:02:12,820 --> 00:02:19,490
صحبة كلّ هذه المشاعر المزدهرة في قلبي

22
00:02:24,990 --> 00:02:26,870
.لم أكن أعلم أنّك لا تجيد السّباحة

23
00:02:26,870 --> 00:02:30,170
إذًا لِم أردتَ القدوم إلى المسبح؟

24
00:02:30,170 --> 00:02:33,880
.لقد فوجئتُ عندما دعوتني لأنّك نادرًا ما تفعل ذلك

25
00:02:33,880 --> 00:02:34,960
.لا بأس

26
00:02:35,340 --> 00:02:37,970
.لقد جلبتُ رفيقي معي

27
00:02:38,510 --> 00:02:41,590
،إن أمكنني النّزول إلى الماء والتبرّد

28
00:02:41,590 --> 00:02:42,890
.فذلك كافٍ بالنّسبة لي

29
00:02:42,890 --> 00:02:45,970
.فهمت. هذا الطّوف يبدو ملائمًا لك

30
00:02:54,860 --> 00:02:56,570
...أوتا

31
00:02:55,360 --> 00:02:56,570
.لن أفعلها

32
00:02:56,570 --> 00:02:59,360
."لا ترمقني بتلك النّظرة الّتي تقول "خطرت على بالي فكرةٌ رائعة

33
00:02:59,360 --> 00:03:02,700
.حسنًا... أعتقد أنّي سأكتفي بهذا فقط

34
00:03:02,700 --> 00:03:04,030
!انتظر يا تاناكا

35
00:03:04,030 --> 00:03:07,620
.يجب أن تقوم بالإحماء قبل النّزول إلى المسبح

36
00:03:07,620 --> 00:03:09,580
،أرخِ معصميك وكاحليك

37
00:03:09,580 --> 00:03:12,750
.و مدّد عضلات جسدك

38
00:03:12,750 --> 00:03:15,590
.إن حدث لك شدّ عضليّ في  الماء فستع في ورطة

39
00:03:15,590 --> 00:03:17,550
.خصوصًا أنّك لا تجيد السّباحة

40
00:03:17,550 --> 00:03:20,090
.أنت محقّ بالفعل

41
00:03:20,090 --> 00:03:23,090
—حسنٌ، سأقوم بالإحماء كما ينبغي

42
00:03:26,350 --> 00:03:28,020
...تشنّج... تشنّج

43
00:03:28,020 --> 00:03:30,180
هل أنت بخيرٍ يا تاناكا؟

44
00:03:30,180 --> 00:03:34,230
.من الخطير تحريك العضلات المتراخية فجأةً

45
00:03:34,230 --> 00:03:36,360
.من الأفضل أن أراقبه اليوم عن كثب

46
00:03:36,360 --> 00:03:37,690
.أنا قلقٌ عليه

47
00:03:40,150 --> 00:03:42,110
!أنتما الاثنان هناك

48
00:03:42,110 --> 00:03:44,820
!القفز ممنوع

49
00:04:02,760 --> 00:04:04,260
أتظنّ أنّك في ينبوعٍ حار؟

50
00:04:04,260 --> 00:04:06,050
.لقد نسيتَ طوفك

51
00:04:07,810 --> 00:04:10,020
...إنّه النّعيم

52
00:04:10,020 --> 00:04:14,770
...أستطيع قضاء الصّيف بأكمله وأنا أطفو على الماء هكذا

53
00:04:14,770 --> 00:04:17,110
!إنّه أكبر منّا ومع ذلك يستخدم الطّوف

54
00:04:17,110 --> 00:04:19,530
!ألا تجيد السّباحة؟ يالك من ضعيف

55
00:04:19,900 --> 00:04:22,320
.أجل، لا أجيد السّباحة

56
00:04:22,320 --> 00:04:24,740
.لكن لا بأس

57
00:04:24,740 --> 00:04:28,080
.لأن الذّهاب مع التيّار يتطلّب جهدًا أقل

58
00:04:28,080 --> 00:04:31,500
.أجل، تمامًا مثل حياتي

59
00:04:31,500 --> 00:04:33,370
!لم أفهم

60
00:04:33,370 --> 00:04:34,960
عمّ تتحدّث؟

61
00:04:34,960 --> 00:04:36,790
!سنأخذ هذا

62
00:04:36,790 --> 00:04:38,000
!أجل

63
00:04:36,790 --> 00:04:39,420
...لا... توقّفا

64
00:04:39,420 --> 00:04:40,460
!أنتما

65
00:04:40,840 --> 00:04:44,970
.لا تفعلا شيئًا كهذا لشخصٍ لا يجيد السّباحة

66
00:04:48,390 --> 00:04:49,890
.أنا آسف

67
00:04:49,890 --> 00:04:51,430
لماذا تعتذر أيضًا يا تاناكا؟

68
00:04:53,230 --> 00:04:54,770
...طوفي

69
00:04:54,770 --> 00:04:56,190
أهناك ثقبٌ فيه؟

70
00:04:56,190 --> 00:04:58,020
!هذا سيّئ! ماذا سنفعل؟

71
00:04:58,020 --> 00:05:00,190
!أبي! أمّي! النّجدة

72
00:05:00,610 --> 00:05:05,240
.قد يبدو عليه أنّه مخيف، لكنّه لطيفٌ مثل الملاك، لذا لا تقلقا

73
00:05:05,240 --> 00:05:06,910
.يمكنكما الاسترخاء

74
00:05:06,910 --> 00:05:10,200
.أوتا، انزع تلك النّظارة فهي تبدو مخيفة

75
00:05:10,200 --> 00:05:12,790
.أهذا صحيح؟ آسف

76
00:05:14,000 --> 00:05:16,290
!اصفح عن حياتي

77
00:05:16,290 --> 00:05:18,960
!سأفعل أيّ شيءٍ تريده

78
00:05:26,010 --> 00:05:28,510
...لقد أصبح مفرغًا من الهواء تمامًا

79
00:05:28,510 --> 00:05:30,260
.نحن آسفان

80
00:05:30,930 --> 00:05:33,980
.مثل هذه الأمور تحدث. لا تشغلا بالكما

81
00:05:33,980 --> 00:05:35,850
.اعتذاركما يستحقّ الثّناء

82
00:05:36,230 --> 00:05:39,900
.لكن لا أعتقد أنّك قادرٌ على اللّعب في المسبح بعد الآن يا تاناكا

83
00:05:39,900 --> 00:05:40,650
ماذا ستفعل الآن؟

84
00:05:41,110 --> 00:05:43,440
.لا بأس

85
00:05:43,440 --> 00:05:49,240
.سوف أقف في المسبح أو أحوم في الماء قليلًا

86
00:05:51,910 --> 00:05:53,450
مـ-ما هذا؟

87
00:05:53,450 --> 00:05:55,960
.تاناكا لا يجيد السّباحة إلّا أنّه يطفو

88
00:05:55,960 --> 00:05:57,870
!وعلى نحوٍ سلسٍ أيضًا

89
00:05:58,460 --> 00:05:59,500
...أيعقل أنّه

90
00:05:59,500 --> 00:06:00,750
!فهمت

91
00:06:00,750 --> 00:06:03,840
.خمول تاناكا يتخطّى حدود الخيال

92
00:06:04,550 --> 00:06:06,800
إنّه يطفو بشكلٍ طبيعيّ دون التّفكير في ذلك حتّى

93
00:06:06,800 --> 00:06:10,300
!لأنّ لا ذرة من القوّة في كامل جسده

94
00:06:10,300 --> 00:06:11,760
!مدهش

95
00:06:12,180 --> 00:06:14,770
!لم أرَ من قبل أحدًا يطفو بهذه السّلاسة

96
00:06:14,770 --> 00:06:17,060
!إنّه عوّامٌ محترف! أودّ المحاولة

97
00:06:17,060 --> 00:06:18,770
!أنت مدهشٌ يا تاناكا

98
00:06:19,440 --> 00:06:23,110
.أنا أتلقّى الثّناء على الرّغم من أنّي لا أجيد السّباحة

99
00:06:24,730 --> 00:06:27,030
...الجوّ حار

100
00:06:27,030 --> 00:06:30,490
.ربّما العمل في واك وكمنقذة أكثر ممّا أستطيع تحمّله

101
00:06:30,490 --> 00:06:32,700
.أرغب بالسّباحة أيضًا

102
00:06:33,200 --> 00:06:35,410
!علّمني كيف أفعل ذلك

103
00:06:35,410 --> 00:06:36,700
!وأنا أيضا

104
00:06:37,410 --> 00:06:41,330
طلّاب مدرسةٍ ثانويّة يعلّمون أطفالًا صغارًا كيفية السّباحة؟

105
00:06:41,330 --> 00:06:43,670
...يا له من أمرٍ رائع

106
00:06:50,680 --> 00:06:53,140
مهلًا، أنتما مجدّدًا؟

107
00:06:53,140 --> 00:06:54,760
هل تحاولون تقليد البطّ؟

108
00:06:54,760 --> 00:06:56,680
ألا يمكنكم السبّاحة بشكلٍ طبيعيّ؟

109
00:06:57,520 --> 00:06:58,890
!كان ذلك ممتعًا

110
00:06:58,890 --> 00:07:01,480
متى ستعود مجدّدًا أيّها المدرّب؟

111
00:07:01,480 --> 00:07:02,610
!علّمنا مجدّدًا

112
00:07:03,980 --> 00:07:07,320
.لا بأس. أنتما بالفعل عوّامان محترفان

113
00:07:07,990 --> 00:07:10,950
.لم يعد هناك أيّ شيءٍ لأعلّمكما إيّاه

114
00:07:10,950 --> 00:07:12,320
!أيّها المدرّب

115
00:07:12,820 --> 00:07:16,830
!سنستمرّ في العمل بجدٍّ للارتقاء إلى اسم العوّام المحترف

116
00:07:16,830 --> 00:07:18,700
!شكرًا جزيلًا لك

117
00:07:19,410 --> 00:07:20,790
.حظًا طيّبًا

118
00:07:20,790 --> 00:07:25,420
...تجنّب مهمةً مزعجة دون جرح مشاعرهما

119
00:07:25,420 --> 00:07:27,760
.لقد تحسّنت يا تاناكا

120
00:07:28,130 --> 00:07:30,170
!إلى اللّقاء

121
00:07:30,170 --> 00:07:32,130
.إلى اللّقاء

122
00:07:38,020 --> 00:07:39,430
...تاناكا

123
00:07:39,430 --> 00:07:42,940
،أنا متعبٌ بشكلٍ لا يصدّق

124
00:07:42,940 --> 00:07:45,060
.ونعسانٌ للغاية

125
00:07:45,060 --> 00:07:48,230
.يا لها من مصادفة. أنا أيضًا

126
00:07:48,230 --> 00:07:50,190
.دعنا نأخذ استراحة

127
00:08:01,290 --> 00:08:05,210
.لا أستطيع أن أحرّك ساكنًا ولا أرغب في فعل أيّ شيء

128
00:08:05,210 --> 00:08:08,420
.أشعر كما لو أنّي تحوّلتُ إلى تاناكا

129
00:08:12,970 --> 00:08:18,350
ماذا؟ ومن سيحملني اليوم إلى المنزل؟

130
00:08:24,350 --> 00:08:28,690
.أعتقد أنّ لا خيار آخر سوى أن تنتظر ظهور أنا آخر

131
00:08:35,030 --> 00:08:37,120
!أيّها العوّام المحترف

132
00:08:37,120 --> 00:08:37,990
!أيّها المدرّب

133
00:08:37,990 --> 00:08:40,160
...ذانك الطّفلان

134
00:08:40,160 --> 00:08:41,450
.التقينا مجدّدًا

135
00:08:41,450 --> 00:08:45,250
!اسمع! أصبح ذلك الشّيء شعبيًا للغاية في مدرستنا الآن

136
00:08:45,250 --> 00:08:47,290
!الجميع يقول أنّه ممتعٌ جدًا

137
00:08:47,290 --> 00:08:47,960
ذلك الشّيء؟

138
00:08:50,960 --> 00:08:54,340
أكنتما تقومان بذلك في حصّة السّباحة؟

139
00:08:54,930 --> 00:08:57,090
!إلى اللّقاء

140
00:08:58,930 --> 00:09:02,680
...أوتا، ربّما فعلتُ شيئًا لم يكن يجدر بي فعله

141
00:09:03,810 --> 00:09:06,440
.أنا قلقٌ بشأن مستقبل السّباحة

142
00:09:06,440 --> 00:09:10,070
.لا أحد يعرف ما قد يصير شعبيًا هذه الأيام

143
00:09:16,530 --> 00:09:18,740
!امنحني نُصحك يا معلّمي

144
00:09:19,580 --> 00:09:23,830
أحتاج إلى أن تطول قامتي بعشرة سنتيمترات
!على الأقل وفي غضون خمسة أيّام

145
00:09:23,830 --> 00:09:25,410
.تقبّلي الواقع رجاءً

146
00:09:25,410 --> 00:09:27,120
.حتّى السّخافة لها حدود

147
00:09:27,120 --> 00:09:29,500
.هدّئي من روعكِ أولًا يا ميانو

148
00:09:31,460 --> 00:09:33,960
من أين أتيتِ بهذا فجأةً؟

149
00:09:33,960 --> 00:09:36,760
في الواقع، لقد قامت إتشان بدعوتي

150
00:09:36,760 --> 00:09:41,180
.لمشاهدة عرض الألعاب النّاريّة باليوكاتا في السّبت القادم

151
00:09:41,180 --> 00:09:43,140
!فلنذهب يا ميانو

152
00:09:43,140 --> 00:09:45,480
!كيف الحال

153
00:09:44,310 --> 00:09:46,100
...إتشان بلباس اليوكاتا

154
00:09:46,100 --> 00:09:47,730
...مرحبًا

155
00:09:46,690 --> 00:09:49,810
!واثقةٌ أنّها ستكون بمظهرٍ راشدٍ وفاتن

156
00:09:50,110 --> 00:09:55,400
أعلم أنّي لم أعد بحاجةٍ للتّصرّف بنضجٍ
،أكثر ممّا أنا عليه لأكون برفقتها

157
00:09:55,400 --> 00:09:57,910
،لكن بما أنّي سأقف بجوارها

158
00:09:57,910 --> 00:10:02,620
.أرغب بأن أبدو مثيرةً بعض الشّيء أيضًا

159
00:10:02,620 --> 00:10:04,700
،لكن بقامتي الحاليّة

160
00:10:04,700 --> 00:10:09,210
أعتقد أنّ يوكاتا للأطفال مع شخصيّاتٍ كرتونيّة عليه
.هو الشّيء الوحيد الّذي سيلائمني

161
00:10:09,210 --> 00:10:12,460
!مرحى! أودّ غَرف سمكةٍ ذهبيّة

162
00:10:13,880 --> 00:10:18,220
،أشعر بالأسف للتّفكير في ذلك
.لكن على الأرجح أنّ ذلك سيلائمها كثيرًا

163
00:10:18,720 --> 00:10:21,220
.سأكون بعيدةً كلّ البعد من أن أكون مثيرة

164
00:10:21,220 --> 00:10:23,310
،لكن بالتّفكير في ذلك بواقعيّة

165
00:10:23,310 --> 00:10:26,980
لن يكون من السّهل أن تطول قامتكِ
.بعشرة سنتيمترات في غضون خمسة أيّام

166
00:10:26,980 --> 00:10:28,810
...فهمت

167
00:10:28,810 --> 00:10:32,730
.ظننتُ أنّنا نحن البشر قادرون على فعل أيّ شيء إن حاولنا بجدّ

168
00:10:33,110 --> 00:10:37,030
ماذا لو طلبتِ من إتشيزين ارتداء يوكاتا عليه شخصيّات كرتونيّة أيضًا؟

169
00:10:37,030 --> 00:10:38,780
.فهي تحبّ الأشياء الظّريفة

170
00:10:38,780 --> 00:10:42,160
!سأكون سعيدةً إن كنّا متماثلتين، لكن ذلك غير واردٍ إطلاقًا

171
00:10:42,160 --> 00:10:44,700
!سنبدو كغريبتي أطوار

172
00:10:45,330 --> 00:10:47,830
،في الواقع ليس عليكِ أن تقلقي كثيرًا

173
00:10:47,830 --> 00:10:50,880
.فهناك حلّ بسيط جدًا

174
00:10:50,880 --> 00:10:53,670
!ما هو يا معلّمي؟ أخبرني رجاءً

175
00:10:54,420 --> 00:10:56,460
.لا تذهبي إلى عرض الألعاب النّاريّة

176
00:10:57,550 --> 00:11:02,600
.من الأفضل أن تشاهديه مباشرةً على التّلفاز في غرفة مكيّفة

177
00:11:03,470 --> 00:11:04,510
!هذا صحيح

178
00:11:04,510 --> 00:11:07,980
.إن لم أذهب فلن أضطر لارتداء اليوكاتا

179
00:11:07,980 --> 00:11:09,940
!أنت عبقريّ يا معلّمي

180
00:11:09,940 --> 00:11:11,600
.ستُبكين إتشيزين

181
00:11:12,150 --> 00:11:14,110
قبل القلق بشأن قامتكِ

182
00:11:14,110 --> 00:11:17,650
ألا يجدر بنا البحث أولًا عن يوكاتا يلائمكِ؟

183
00:11:18,190 --> 00:11:20,820
،مؤخرًا أصبح هنالك الكثير من المقاسات للاختيار من بينها

184
00:11:20,820 --> 00:11:24,950
.لذا على الأرجح ستجدين يوكاتا بمقاساتٍ كبيرة وصغيرة

185
00:11:24,950 --> 00:11:26,290
!هذا صحيح

186
00:11:26,990 --> 00:11:31,790
.بالتّفكير في الأمر، أنا لم أتفقّد محلّات اليوكاتا بعد

187
00:11:31,790 --> 00:11:33,380
،إن ذهبنا إلى متجرٍ متخصّص

188
00:11:33,380 --> 00:11:37,250
.فقد يكون لديهم يوكاتا للرّاشدين يمكن أن يناسبني

189
00:11:37,550 --> 00:11:40,010
!حسنٌ! يجب أن أضرب الحديد ما دام حاميًا

190
00:11:40,010 --> 00:11:43,390
!سأذهب إلى متجر الكيمونو بعد الدّوام

191
00:11:43,390 --> 00:11:45,970
!هلّا رافقتماني رجاءً؟

192
00:11:46,890 --> 00:11:47,720
أنا أيضًا؟

193
00:11:47,720 --> 00:11:52,020
لا أمانع، لكن ألا بأس إن رافقكِ رجلان؟

194
00:11:52,020 --> 00:11:54,690
.لا أعتقد أنّنا سنكون ذا فائدةٍ لكِ

195
00:11:56,190 --> 00:12:01,400
!قـ-قد يظنّ النّاس أنّي امرأةٌ وقحة تغري الرّجال

196
00:12:01,400 --> 00:12:04,450
...يا له من عبير امرأةٍ خطير

197
00:12:04,450 --> 00:12:06,740
.لا، نحن لا نشتمّه إطلاقًا

198
00:12:06,740 --> 00:12:09,160
.لا حاجة لأن تقلقي بشأن ذلك

199
00:12:10,200 --> 00:12:12,370
!صحيح! شيرايشي-سان

200
00:12:12,370 --> 00:12:14,420
ميانو-سان؟ ماذا هناك؟

201
00:12:14,420 --> 00:12:17,920
إن رغبتِ، هلّا أتيتِ معنا أيضًا؟

202
00:12:26,550 --> 00:12:30,520
.عجبًا... لم أكن أدرك أنّ هناك الكثير من أنواع اليوكاتا. مدهش

203
00:12:30,520 --> 00:12:33,190
...سيكون الاختيار صعبًا

204
00:12:33,190 --> 00:12:36,110
!فلنبذل جهدنا للعثور على اليوكاتا المناسب لكِ

205
00:12:36,110 --> 00:12:38,820
.وجود شيرايشي معنا يبعث على الطّمأنينة

206
00:12:38,820 --> 00:12:40,320
.يعتمد عليها

207
00:12:40,320 --> 00:12:42,190
!أ-أجل، سأحاول ما في وسعي

208
00:12:44,280 --> 00:12:46,450
!توجد الكثير من التّصاميم الجميلة

209
00:12:46,450 --> 00:12:49,120
إذًا فالنّاس في حاجةٍ لارتداء اليوكاتا

210
00:12:49,120 --> 00:12:51,540
...للذّهاب لمشاهدة الألعاب النّاريّة

211
00:12:51,540 --> 00:12:53,580
.ربّما يجدُر بي شراء واحدٍ أيضًا

212
00:12:53,580 --> 00:12:56,920
ماذا؟ ألاتحبّين ارتداء اليوكاتا يا شيرايشي-سان؟

213
00:12:57,460 --> 00:12:59,750
،أجل، لعدّة أسباب

214
00:12:59,750 --> 00:13:05,260
حتّى الآن كانت الألعاب النّاريّة حدثًا
.أشاهده على التّلفاز وحدي في المنزل

215
00:13:05,260 --> 00:13:06,300
...بملابسي العاديّة

216
00:13:06,800 --> 00:13:09,010
لم تذهبي حتّى لمشاهدة العرض مباشرةً؟

217
00:13:09,010 --> 00:13:10,430
!أنتِ مثل معلّمي

218
00:13:11,140 --> 00:13:12,270
مثل تاناكا-كُن؟

219
00:13:12,270 --> 00:13:13,930
!أنتما ستكونان منسجمين

220
00:13:14,640 --> 00:13:17,860
!معلّمي، معلّمي! وجدتُ شيئًا رائعًا

221
00:13:17,860 --> 00:13:19,480
ما هو يا ميانو؟

222
00:13:19,480 --> 00:13:23,110
!عندما أرتدي الغيتا أصبح أطول من المعتاد

223
00:13:23,860 --> 00:13:24,650
.هذا صحيح

224
00:13:24,650 --> 00:13:26,110
!أنا سعيدةٌ جدًا

225
00:13:26,570 --> 00:13:29,580
.في هذه الحالة، ستصبحين أطول بهذا

226
00:13:30,530 --> 00:13:32,620
!يـ-يا له من كعبٍ عالٍ

227
00:13:32,620 --> 00:13:35,330
!إن ارتديته فسيزيد طولي بعشرة سنتيمترات

228
00:13:35,660 --> 00:13:39,250
!إذًا فهذا بالتّأكيد سيزيد من طولكِ بعشرين سنتيمترًا

229
00:13:40,500 --> 00:13:42,210
.آسفة، لكن لا

230
00:13:44,210 --> 00:13:47,010
.لديهم يوكاتا للرّجال أيضًا

231
00:13:47,010 --> 00:13:49,090
.أراهن أنّه سيبدو رائعًا على تاناكا-كُن

232
00:13:51,100 --> 00:13:54,980
صحيح! شيرايشي-سان، أترغبين
!بالذّهاب معنا لمشاهدة الألعاب النّاريّة؟

233
00:13:54,980 --> 00:13:57,100
!أودّ أن أعرّفكِ على إتشان أيضًا

234
00:13:57,100 --> 00:13:59,730
معلّمي وأوتا-كُن أنتما متفرّغان أيضًا، صحيح؟

235
00:13:59,730 --> 00:14:01,860
!يجب أن نذهب كلّنا معًا

236
00:14:01,860 --> 00:14:03,820
.أنا موافق. يبدو ذلك ممتعًا

237
00:14:03,820 --> 00:14:06,240
...ماذا؟ أفضّل أن أبقى في المنزل وأنام طوال اليوم

238
00:14:06,240 --> 00:14:10,280
!إذًا فأنتما متفرّغان، صحيح؟ تقرّر الأمر إذًا

239
00:14:15,620 --> 00:14:17,960
...آسفةٌ يا ميانو-سان

240
00:14:17,960 --> 00:14:22,090
،في الحقيقة، كيتشان وميو-تشان قامتا بدعوتي سلفًا

241
00:14:22,090 --> 00:14:25,010
.لِذا لا أستطيع الذّهاب معكم. استمتعوا بوقتكم بدوني

242
00:14:25,630 --> 00:14:28,430
.أشكركِ حقًا! لا تقلقي بشأني

243
00:14:30,640 --> 00:14:33,180
.حسنٌ، أظنّ أنّ علينا شراء اليوكاتا أيضًا

244
00:14:33,180 --> 00:14:35,430
.فلنستمتع بصيفنا اليابانيّ

245
00:14:35,430 --> 00:14:38,520
.كان ينبغي أن أختلق عذرًا للتملّص من هذا

246
00:14:39,850 --> 00:14:42,690
.يعجبني هذا النّوع. يبدو سهل الارتداء

247
00:14:42,690 --> 00:14:46,320
.كما لو أنّه صمّم لك خصّيصًا

248
00:14:46,860 --> 00:14:49,820
.لكن يبدو أنّهم يملكون النّسخة النّسائيّة فقط

249
00:14:49,820 --> 00:14:51,820
.إنّه لطيف جدًا بالنّسبة لرجل

250
00:14:51,820 --> 00:14:54,280
،فهمت... إذًا لا خيار آخر

251
00:14:54,740 --> 00:14:55,990
—سأرتدي زيّ النّساء

252
00:14:55,990 --> 00:14:57,040
.انتظر يا تاناكا

253
00:14:57,040 --> 00:15:00,040
.هذا شيءٌ لا يجب أن تقدم عليه أبدًا

254
00:15:01,750 --> 00:15:05,710
!معلّمي! سنقوم بتجربتها، لِذا انتظرا هنا

255
00:15:06,550 --> 00:15:09,340
.يسرّني أنّهما وجدتا شيئًا يعجبهما

256
00:15:09,340 --> 00:15:10,260
.أجل

257
00:15:10,260 --> 00:15:13,930
.ويبدو أنّ قضية قامة ميانو ستحلّ بزوجٍ من الغيتا

258
00:15:21,810 --> 00:15:24,820
...رغم أنّنا أتينا إلى هنا للبحث عن يوكاتا لميانو-سان

259
00:15:24,820 --> 00:15:27,530
.انتهى بي المطاف بتجربة أحدها أيضًا

260
00:15:27,530 --> 00:15:28,740
...حـسنًا... أنا

261
00:15:29,150 --> 00:15:30,780
!أهذه أنتِ يا شيرايشي؟

262
00:15:30,780 --> 00:15:33,990
!خِلتكِ شخصًا آخر بسبب تسريحتكِ المختلفة

263
00:15:33,990 --> 00:15:36,030
.تبدين مختلفةً كلّيًا

264
00:15:36,030 --> 00:15:39,830
.أجل، لقد بالغوا في تصفيفه لي

265
00:15:41,870 --> 00:15:42,790
.يعجبني

266
00:15:43,420 --> 00:15:45,040
.يبدو جميلًا جدًا عليكِ

267
00:15:45,630 --> 00:15:47,550
!شـ-شكرًا

268
00:15:48,760 --> 00:15:50,800
!أنا في غاية السّعادة! لم أعد أكترث

269
00:15:50,800 --> 00:15:54,090
حتّى إن لم أستطع الذّهاب معهم لمشاهدة
!الألعاب النّاريّة، فهذا كافٍ بالنّسبة لي

270
00:15:54,090 --> 00:15:56,260
!شكرًا لكِ يا ميانو-سان

271
00:16:01,980 --> 00:16:04,980
!هذا ليس شيئًا يمكن أن يحلّه زوجٌ من الغيتا

272
00:16:05,610 --> 00:16:07,690
.لـ-لا تقلقي يا ميانو

273
00:16:07,690 --> 00:16:10,780
.ما زال لدينا الوقت. لا تفقدي عزيمتكِ

274
00:16:10,780 --> 00:16:13,200
...لا، أنا بخير

275
00:16:13,200 --> 00:16:17,780
،ما يشغلني أكثر هو أنّ أثداء شيرايشي-سان كبيرةٌ جدًا

276
00:16:17,780 --> 00:16:20,200
...ولم أعد أمتلك الثّقة للعيش بعد الآن

277
00:16:20,200 --> 00:16:21,580
!مـ-ميانو-سان؟

278
00:16:30,050 --> 00:16:33,840
.كان ذلك أصغر مقاسٍ لديهم

279
00:16:35,300 --> 00:16:39,180
!حسنًا، لقد بذلت جهدي ولم أفلح، لا يسعنا فعل شيء

280
00:16:39,180 --> 00:16:42,810
!سأذهب إلى عرض الألعاب النّاريّة في فستانٍ صيفيّ جميل

281
00:16:42,810 --> 00:16:45,730
.أجل، سيشعركِ ذلك بالانتعاش أيضًا

282
00:16:45,730 --> 00:16:46,940
.ابتهجي

283
00:16:47,270 --> 00:16:50,650
رغم قولها لذلك لكن في الحقيقة ميانو-سان

284
00:16:50,650 --> 00:16:53,900
.ترغب بالذّهاب إلى عرض الألعاب النّاريّة مرتديةً اليوكاتا

285
00:16:53,900 --> 00:16:56,410
،لطالما مدّت يد المساعدة لي

286
00:16:56,410 --> 00:16:58,950
...لِذا أودّ أن أفعل شيئًا لأجلها هذه المرّة

287
00:17:01,330 --> 00:17:03,290
!لا تقلقي يا ميانو-سان

288
00:17:03,290 --> 00:17:06,420
!إن لم تجدي شيئًا يلائمكِ، فعلينا فقط صنعه

289
00:17:06,880 --> 00:17:09,670
!أيمكنكِ خيّاطة اليوكاتا يا شيرايشي-سان؟

290
00:17:09,670 --> 00:17:11,630
...لم أخط اليوكاتا من قبل

291
00:17:11,630 --> 00:17:13,670
!لكنّني أجيد الخيّاطة، لِذا سأحرص على فعلها

292
00:17:14,840 --> 00:17:17,510
!أنا سعيدةٌ جدًا! شكرًا جزيلًا لكِ

293
00:17:17,510 --> 00:17:18,800
!سأبذل ما في وسعي

294
00:17:18,800 --> 00:17:19,810
.هذا رائع

295
00:17:19,810 --> 00:17:20,810
.مسرورٌ لأجلكِ

296
00:17:20,810 --> 00:17:25,190
من الجيّد أنّي تدرّبتُ على شتّى الأمور
...من أجل الالتحاق بالمدرسة الثّانويّة

297
00:17:26,810 --> 00:17:29,480
.حسنًا، دعينا نختر قماشًا معًا

298
00:17:29,480 --> 00:17:31,070
!حسنًا

299
00:17:32,110 --> 00:17:34,400
!أحبّ زخارف الأزهار

300
00:17:34,400 --> 00:17:36,070
!سيبدو رائعًا عليكِ

301
00:17:36,660 --> 00:17:37,990
ماذا عن هذا؟

302
00:17:37,990 --> 00:17:40,160
!إنّه جميلٌ جدًا

303
00:17:40,160 --> 00:17:42,080
!أجل، إنّه جميل

304
00:17:50,210 --> 00:17:52,420
...الكثير من أكشاك الطّعام

305
00:17:52,420 --> 00:17:54,460
.والكثير من النّاس أيضًا

306
00:17:54,460 --> 00:17:56,760
!معلّمي! أوتا-كُن

307
00:17:57,550 --> 00:17:59,510
!شكرًا لانتظاركما

308
00:18:01,220 --> 00:18:03,220
أهذه أنتِ يا ميانو؟

309
00:18:03,220 --> 00:18:05,890
.إنّه مثالي. على مقاسكِ تمامًا

310
00:18:05,890 --> 00:18:08,480
!أجل! الفضل يعود إلى شيرايشي-سان

311
00:18:08,480 --> 00:18:12,020
.ليس فقط أنّها تجيد صنع الماكرون بل وحتّى اليوكاتا

312
00:18:12,020 --> 00:18:14,940
.هذا سببٌ آخر يزيد من احترامي لها

313
00:18:15,740 --> 00:18:21,330
،لطالما كرهتُ كوني قصيرة

314
00:18:21,330 --> 00:18:24,700
لكن هذه المرّة، بفضل قصر قامتي

315
00:18:24,700 --> 00:18:28,710
.أنا قادرةٌ على ارتداء هذا اليوكاتا الرّائع والفريد من نوعه

316
00:18:29,750 --> 00:18:32,710
!أن تكون قصيرًا ليس سيئًا في بعض الأحيان

317
00:18:32,710 --> 00:18:33,630
.أجل

318
00:18:34,250 --> 00:18:35,050
.صحيح

319
00:18:36,470 --> 00:18:42,180
،تخيّلتُ للتّو رأسكِ على جسد أوتا

320
00:18:42,180 --> 00:18:44,100
.ولم يبدو ملائمًا إطلاقًا

321
00:18:44,100 --> 00:18:46,390
.من الأفضل أن تظلّي كما أنتِ الآن يا ميانو-سان

322
00:18:46,390 --> 00:18:48,060
ماذا كنتَ تتخيّل؟

323
00:18:48,060 --> 00:18:51,100
!لا أنوي أن أطول إلى ذلك الحدّ

324
00:18:52,110 --> 00:18:54,610
!إتشان! نحن هنا

325
00:18:55,110 --> 00:18:57,820
!ميانو! ملاك؟! هل أنتِ ملاك؟

326
00:18:57,820 --> 00:19:00,740
!تسريحة شعركِ ظريفةٌ جدًا

327
00:19:00,740 --> 00:19:02,820
...لا أستطيع التّنفس يا إتشان

328
00:19:04,200 --> 00:19:07,160
ماذا؟ هل أتيتما لمشاهدة الألعاب النّاريّة معًا؟

329
00:19:07,160 --> 00:19:10,290
كما أنّكما ترتديان اليوكاتا! هل أنتما في موعد؟

330
00:19:10,290 --> 00:19:14,250
لا، نحن هنا لرفقتكما، ألم تعلمي ذلك؟

331
00:19:14,250 --> 00:19:16,000
!كيف الحال

332
00:19:15,130 --> 00:19:17,130
...آسفٌ يا إتشيزين-سان

333
00:19:16,550 --> 00:19:17,760
...مرحبًا

334
00:19:17,760 --> 00:19:19,720
.إنّكِ أكثر أناقةً مما تصوّرت

335
00:19:20,130 --> 00:19:22,340
هل سترافقاننا؟

336
00:19:22,340 --> 00:19:27,060
ظننتُ أنّه من الممتع أن نتسكّع كمجموعة
!من حينٍ لآخر، لذا قمتُ بدعوتهما

337
00:19:27,850 --> 00:19:29,350
.حسنًا، لا بأس

338
00:19:29,350 --> 00:19:32,850
.سأسمح بهذا هذه المرّة، نظرًا لمدى ظرافة ميانو

339
00:19:32,850 --> 00:19:35,190
!تبدين أجمل بكثير يا إتشان

340
00:19:37,150 --> 00:19:40,950
،أوتا طويل القامة وقويّ البنية

341
00:19:40,950 --> 00:19:43,120
.لِذا يبدو أنيقًا في اليوكاتا

342
00:19:43,120 --> 00:19:48,160
بالتّفكير في ذلك، لقد اعتدنا الذّهاب إلى
.المهرجان الصيفيّ معًا عندما كنّا صغارًا

343
00:19:48,160 --> 00:19:52,170
.خاطت لنا والدته يوكاتا متشابهة

344
00:19:52,170 --> 00:19:53,330
...هذا يعيد الذّكريات

345
00:19:53,330 --> 00:19:55,250
إتشيزين، تذكّرتُ للتّو

346
00:19:55,250 --> 00:19:59,010
،كيف أنّنا اعتدنا الذّهاب إلى المهرجان الصيفيّ معًا عندما كنّا صغارًا

347
00:19:59,010 --> 00:20:00,260
.وكُنا نلبس يوكاتا متشابهة

348
00:20:00,630 --> 00:20:03,010
!ماذا؟ أ-أنا لا أتذكّر ذلك

349
00:20:07,010 --> 00:20:09,730
.مـ-ماذا؟ لا تحدّق في وجهي

350
00:20:09,730 --> 00:20:13,150
.هذا جميلٌ حقًا. تبدين فاتنةً يا إتشيزين

351
00:20:13,940 --> 00:20:16,940
!مـ-مـ-ما هذا الّذي يتفوّه به فجأةً؟

352
00:20:23,660 --> 00:20:28,910
...أ-أنت أيضًا تبدو أكثر أناقةً في اليوكاتا ممّا كنت عليه آنذاك

353
00:20:28,910 --> 00:20:33,210
أوتا، يقولون أنّه بالإمكان وضع قدر ما تشاء
.من شراب الحليب المركّز على الجليد المبشور

354
00:20:33,210 --> 00:20:35,630
!ماذا قلت؟! هبةٌ من الإله

355
00:20:42,130 --> 00:20:44,840
هل يجب أن أختار حليب الفراولة التّقليدي؟

356
00:20:45,300 --> 00:20:47,850
...لكنّ المانجو يبدو لذيذً أيضًا

357
00:20:48,600 --> 00:20:49,310
...أوتا

358
00:20:49,310 --> 00:20:51,220
هل سبق وسمعت؟

359
00:20:51,220 --> 00:20:55,270
."هناك شامبو شائع يسمّى "شامبو الجليد المبشور

360
00:20:57,980 --> 00:21:00,940
!هذا سيبرّدك أيّها الأحمق

361
00:21:00,940 --> 00:21:02,110
!إتشان؟

362
00:21:02,110 --> 00:21:03,400
...لقد انسلّ إلى ظهري

363
00:21:02,110 --> 00:21:03,400
.هذا جيّد

364
00:21:03,400 --> 00:21:05,610
.لقد عادت إتشيزين-سان إلى طبيعتها

365
00:21:04,490 --> 00:21:05,610
...باردٌ جدًا

366
00:21:08,450 --> 00:21:10,160
!لقد بدأ

367
00:21:47,030 --> 00:21:48,280
.إنّها رائعة

368
00:21:48,280 --> 00:21:50,080
.أجل، إنّها كذلك

369
00:21:56,000 --> 00:21:59,960
!كان ينبغي أن أجلب حذاء التينغو غيتا

370
00:21:59,960 --> 00:22:04,630
!أنا حقًا أكره كوني قصيرة

371
00:22:09,930 --> 00:22:15,310
الحياة اليوميّة مثل قطٍّ مزعج

372
00:22:15,310 --> 00:22:20,520
لكم أتمنّى أن أقدر على تجاهله وأفعل ما يحلو لي

373
00:22:20,860 --> 00:22:26,360
انعزلت بحذرٍ في عالمي الموسيقيّ الخاص

374
00:22:26,360 --> 00:22:31,240
ربما أمتلك موهبةً في أحلام اليقظة

375
00:22:32,080 --> 00:22:36,040
ما يسمّى السّعادة

376
00:22:37,330 --> 00:22:40,880
ماذا تكون يا ترى؟

377
00:22:42,130 --> 00:22:48,170
حاولت التصرّف وفق رغباتي الخاصّة

378
00:22:48,170 --> 00:22:52,260
فهل سأدركها الآن؟

379
00:22:53,350 --> 00:22:55,520
الخمول الدراميّ

380
00:22:56,060 --> 00:22:58,770
أودّ وضع حياتي بين يديه

381
00:22:58,770 --> 00:23:03,900
ربما موقفٌ إيجابي أفضل

382
00:23:04,230 --> 00:23:09,740
هل بذل قصارى جهدي هو الصّواب؟

383
00:23:09,740 --> 00:23:15,080
لا أستطيع تحمّل الملامح الجامدة

384
00:23:15,080 --> 00:23:17,500
الحياة اليوميّة تصيبني بالدّوار

385
00:23:17,830 --> 00:23:20,460
خمولي الغالي

386
00:23:20,460 --> 00:23:22,580
مرةً أخرى

387
00:23:23,170 --> 00:23:26,050
خمولي الغالي

388
00:23:30,970 --> 00:23:33,430
أترغب بطاولةٌ لشخصٍ واحد؟

389
00:23:33,430 --> 00:23:35,810
...أوووتااا

390
00:23:35,810 --> 00:23:36,940
!إنّه يرتدي ملابس داخليّة

391
00:23:36,940 --> 00:23:38,430
!كان يرتدي ملابس داخليّة

392
00:23:38,430 --> 00:23:40,020
!أنا قادمٌ لإنقاذك

393
00:23:40,020 --> 00:23:41,980
!أعين الجفن

394
00:23:41,980 --> 00:23:43,980
:في الحلقة المقبلة، الحلقة الحادية عشرة

395
00:23:43,980 --> 00:23:45,940
".مهرجان تاناكا-كُن الثّقافي"