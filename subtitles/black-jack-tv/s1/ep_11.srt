1
00:00:06,700 --> 00:00:11,100
تـرجـمـة
كيـمـزهرة الكرزــو

2
00:00:21,200 --> 00:00:27,250
فريق بُحُور للتَّرجَمةِ
يُقدِّم لكُم
بـــلاك جـــاك

3
00:01:25,670 --> 00:01:30,640
،بارعٌ مُتمرِّسٌ بأمور الحياةِ
،يُقدِّم لنا مُعْجِزاتٍ بمهارةِ مِبضعه الرَّبانِيّ

4
00:01:31,500 --> 00:01:33,890
...إنَّه الجرّاح الّذي يَتوق إليه عَصْرنا

5
00:01:34,730 --> 00:01:36,230
بلاك جاك

6
00:01:49,600 --> 00:01:53,270
!لارجو

7
00:01:54,400 --> 00:01:56,610
!لارجو، حان وقت الغداء

8
00:01:57,150 --> 00:01:58,820
أين ذهبت يا ترى؟

9
00:02:01,020 --> 00:02:03,110
!لارجو

10
00:02:04,740 --> 00:02:06,870
أين كنتِ لارجو؟

11
00:02:07,070 --> 00:02:08,320
حان وقت الغداء

12
00:02:10,490 --> 00:02:11,540
ما هذا؟

13
00:02:14,240 --> 00:02:16,580
!يا إلهي

14
00:02:17,500 --> 00:02:17,950
!أيها الطبيب

15
00:02:18,380 --> 00:02:19,130
ماذا هنالك؟

16
00:02:19,340 --> 00:02:20,170
ما خطبكِ، بينوكو؟

17
00:02:20,300 --> 00:02:21,710
!انظر, انظر، انظر

18
00:02:21,840 --> 00:02:23,170
!انظر لهذا

19
00:02:23,170 --> 00:02:24,340
هل هذه حقيقية؟

20
00:02:32,600 --> 00:02:33,770
تعال من هنا

21
00:02:34,270 --> 00:02:37,940
جاءت لارجو من هذا الطريق, وفي فمها هذا الشيء

22
00:02:38,360 --> 00:02:40,610
هناك, لا يوجد سوى الصخور ومياه البحر

23
00:02:40,730 --> 00:02:44,780
!أيُعقل بأن لارجو وجدت كنزًا هنا؟

24
00:02:45,280 --> 00:02:46,110
ربما

25
00:02:49,080 --> 00:02:50,580
إلى أين تذهب؟

26
00:02:51,040 --> 00:02:52,580
إلى مكان الكنز

27
00:02:52,620 --> 00:02:55,330
انتظرني، أنا آتية

28
00:02:56,670 --> 00:02:59,380
لارجو، أيها الطبيب، انتظراني

29
00:03:01,130 --> 00:03:02,630
إنه كهف

30
00:03:02,960 --> 00:03:04,800
المكان مظلمٌ هنا

31
00:03:04,800 --> 00:03:05,760
لنكن حذرين

32
00:03:08,800 --> 00:03:11,180
أشعر بالخوف

33
00:03:18,810 --> 00:03:20,570
أخيرًا، وصلنا لنهايته

34
00:03:27,200 --> 00:03:29,160
!مكانٌ جميل

35
00:03:29,160 --> 00:03:32,330
لماذا لم ترني إياه من قبل؟

36
00:03:36,000 --> 00:03:38,420
لارجو ستصابين بنزلة برد

37
00:03:38,540 --> 00:03:40,080
عودي إلى هنا

38
00:03:49,590 --> 00:03:50,680
!لؤلؤة مرة أخرى

39
00:03:51,350 --> 00:03:52,760
ما يزال هنالك الكثير منها

40
00:03:52,800 --> 00:03:54,350
!حقًا؟

41
00:04:02,360 --> 00:04:03,730
!مستحيل

42
00:04:04,780 --> 00:04:06,860
!بهذا العدد

43
00:04:07,900 --> 00:04:09,610
أهذه كُلها لآلئ؟

44
00:04:09,660 --> 00:04:10,410
أيمكنني أخذها؟

45
00:04:10,870 --> 00:04:11,530
نعم

46
00:04:24,340 --> 00:04:26,130
نلتِ ما تستحقينه بسبب جشعكِ

47
00:04:26,130 --> 00:04:28,220
أنا لم أحصل على شيءٍ منها

48
00:04:28,220 --> 00:04:30,390
لارجو من حصلت على بعضٍ منها

49
00:04:31,930 --> 00:04:36,140
أيها الطبيب، أخبرني لما يوجد الكثير من اللؤلؤ هنا؟

50
00:04:37,020 --> 00:04:39,600
لأن صديقٌ لي قد أحضرها

51
00:04:40,140 --> 00:04:41,100
صديقك؟

52
00:04:41,100 --> 00:04:42,020
نعم

53
00:04:42,020 --> 00:04:44,190
لقد مضت عشر سنوات منذ أن رأيته آخر مرة

54
00:04:46,820 --> 00:04:48,400
أتى إلي من البحر

55
00:04:58,120 --> 00:05:02,460
قبل عشر سنوات، عندما اكتمل بناء العيادة على الجرف الجنوبي

56
00:05:03,330 --> 00:05:07,630
،و بسبب الإشاعات التي تداولها الناس
عن مظهري المريب و الثمن الباهض الذي أطلبه

57
00:05:07,920 --> 00:05:10,680
لم يأتِ أحدٌ إلي

58
00:05:14,300 --> 00:05:16,310
كنتُ وحيدًا بحق

59
00:05:19,100 --> 00:05:21,980
اليوم لا يوجد زوار، هاه؟

60
00:05:27,940 --> 00:05:28,900
ما هذه الضجة؟

61
00:05:34,620 --> 00:05:35,780
إنها صادرة من الأسفل

62
00:05:47,550 --> 00:05:48,170
...إنه

63
00:05:55,680 --> 00:05:56,680
تبدو في حالٍ يرثى لها

64
00:05:57,390 --> 00:05:58,060
ماذا حدث لك؟

65
00:05:58,390 --> 00:05:59,560
مالذي فعلته؟

66
00:06:05,400 --> 00:06:07,440
تبدو ضعيفًا للغاية

67
00:06:08,270 --> 00:06:10,780
لحظة، لن أؤذيك

68
00:06:10,780 --> 00:06:15,070
لا تقلق، أنا طبيب ولكنني أُعالج البشر

69
00:06:16,780 --> 00:06:17,830
!أهذه آثار عض؟

70
00:06:19,040 --> 00:06:20,240
أنت من الثديات أيضًا

71
00:06:20,240 --> 00:06:21,540
لذلك أعتقدُ بأنني سأستطيع تقديم الإسعافات الأولية لك

72
00:06:24,870 --> 00:06:27,590
أنت أول مريضٍ لي في هذه المدينة

73
00:06:28,250 --> 00:06:29,630
علاجك سيكون على حسابي

74
00:06:31,380 --> 00:06:33,420
و كان ذلك أول لقاءٍ لنا

75
00:06:40,180 --> 00:06:42,180
يلزمك أربعة إلى خمسة أيامٍ لتشفى

76
00:06:42,390 --> 00:06:45,020
وعندها ستستطيع السباحة مرةً أخرى

77
00:06:46,060 --> 00:06:49,770
ومنذ ذلك اليوم، أحببت الحوت القاتل ولم أقدر على نسيانه

78
00:06:51,360 --> 00:06:54,860
و بعدها بيومين، ذهبتُ لنفس المكان لألقي نظرةً عليه

79
00:06:59,280 --> 00:07:01,450
لا بد وأنه عاد للبحر

80
00:07:12,800 --> 00:07:14,760
!لا تتهور ليس بعد

81
00:07:22,810 --> 00:07:26,850
يقال أن الحيوانات البرية تتعافى بسرعة، وأعتقدُ أن هذا صحيح

82
00:07:29,230 --> 00:07:29,980
ما هذا؟

83
00:07:32,020 --> 00:07:33,690
أليست لؤلؤة؟

84
00:07:34,190 --> 00:07:34,940
أهي من أجلي؟

85
00:07:36,490 --> 00:07:37,280
حسنٌ

86
00:07:37,950 --> 00:07:39,780
كم أنت لطيف

87
00:07:40,240 --> 00:07:40,990
سأقبلها بكل سرور، شكرًا لك

88
00:07:43,410 --> 00:07:46,750
بالنسبة لي، لقد بدا سعيدًا

89
00:07:49,000 --> 00:07:51,500
و منذ ذلك اليوم، أصبح صديقًا لي

90
00:08:02,100 --> 00:08:02,930
عذرًا

91
00:08:04,680 --> 00:08:06,980
هل أستطيع أخذ بعضًا من هذه الأسماك؟

92
00:08:07,100 --> 00:08:08,810
للأسف، إنها فاسدةٌ لذلك سأرميها

93
00:08:09,230 --> 00:08:11,560
اذهب للسوق إن رغبت في شراؤها

94
00:08:11,730 --> 00:08:14,610
كلامك صحيح، و لكنني أريد هذه

95
00:08:14,610 --> 00:08:16,440
هل ستطعم قط أو ما شابه ذلك؟

96
00:08:16,610 --> 00:08:18,530
نعم، شيءٌ كهذا

97
00:08:18,530 --> 00:08:20,950
ها هي، خذها

98
00:08:21,990 --> 00:08:23,120
لن أخذ منك شيئًا

99
00:08:24,040 --> 00:08:24,620
شكرًا لك

100
00:08:26,540 --> 00:08:28,330
والدي، من يكون؟

101
00:08:28,410 --> 00:08:29,960
لا يعجبني مظهره

102
00:08:30,580 --> 00:08:32,210
كف عن التفوه بهذا الكلام، وركز على عملك

103
00:08:32,210 --> 00:08:33,250
حاضر، حاضر

104
00:08:36,420 --> 00:08:37,210
التقطها

105
00:08:46,180 --> 00:08:49,600
و بعد مدةٍ، أصبحت أذهب للاطمئنان عليه بشكل يومي

106
00:08:50,270 --> 00:08:52,150
...إلى أن أتى ذلك اليوم

107
00:08:55,780 --> 00:08:57,030
!أنت! ماذا حدث لك؟

108
00:08:57,530 --> 00:08:59,570
أصيب بعدة جروح، وقمت بعلاجه

109
00:09:00,570 --> 00:09:02,660
تأذيت مرة أخرى؟

110
00:09:02,660 --> 00:09:03,990
وهنالك العديد من الإصابات

111
00:09:05,280 --> 00:09:06,370
هل ارتطمت بالصخور؟

112
00:09:06,660 --> 00:09:08,290
أو تقاتلت مع حوتٍ أخر؟

113
00:09:09,370 --> 00:09:13,540
حوتٌ عنيفٌ مثلك يجب عليه البقاء
!في المشفى لمدة من الزمن

114
00:09:14,750 --> 00:09:16,500
!إبق ثابتًا، سيؤلمك هذا قليلًا

115
00:09:17,550 --> 00:09:21,760
تبًا، هل سأتوقف عن معالجة الناس وأصبح طبيبًا بيطريًا؟

116
00:09:27,180 --> 00:09:28,430
قد القارب جيدًا

117
00:09:28,430 --> 00:09:29,770
وإلا فإن الأسماك ستهرب بعيدًا

118
00:09:29,770 --> 00:09:31,520
اصمت، فأنا أقوده بشكل جيد

119
00:09:31,730 --> 00:09:34,770
سحقًا، تتصرف وكأن ما تفعله هو الصواب

120
00:09:40,990 --> 00:09:42,780
...إنه الشاب الذي رأيته من المرة السابقة

121
00:09:44,070 --> 00:09:45,200
ما خطبك يا والدي؟

122
00:09:45,700 --> 00:09:46,280
لا شيء

123
00:09:46,280 --> 00:09:47,240
انظر أمامك مباشرةً

124
00:09:49,700 --> 00:09:50,580
وأخيرًا انتهيت

125
00:09:51,370 --> 00:09:54,290
ولأن هذه عودتك الثانية لي، التكلفة ستكون عشرون ألف ين

126
00:10:00,420 --> 00:10:02,090
لقد تجهزت لذلك، صحيح؟

127
00:10:02,630 --> 00:10:03,510
لا بأس إذًا

128
00:10:06,550 --> 00:10:09,180
أطلقت عليه اسم ترتون

129
00:10:09,180 --> 00:10:10,640
وقمت بكتابة سجل طبي له كذلك

130
00:10:11,810 --> 00:10:14,060
وسرعان ما امتلأ

131
00:10:16,270 --> 00:10:20,320
إنه يصاب بكل تلك الجروح مرة كل عشرة أيام، ويعود إلي بعدها لأعالجه

132
00:10:21,190 --> 00:10:24,450
و يجلب معه شيءٌ ما كثمن لمعالجته

133
00:10:25,450 --> 00:10:27,740
وكان في معظم الأوقات، يجلب معه اللؤلؤ ليدفع لي

134
00:10:27,740 --> 00:10:29,740
وأحيانًا يحضر معه المرجان أو عملات نقدية قديمة

135
00:10:31,620 --> 00:10:35,790
ومع مرور الوقت، أصبحت علاقتنا تقوى شيئًا فشيئًا

136
00:10:43,970 --> 00:10:44,800
شكرًا لك

137
00:10:44,800 --> 00:10:46,090
لا داعي للشكر

138
00:10:46,090 --> 00:10:47,550
فنحن سنرميها على كل حال

139
00:10:48,260 --> 00:10:50,640
وأيضًا أنت تأتي إلينا في كل صباح

140
00:10:51,560 --> 00:10:53,730
يبدو بأنها قطة كبيرة

141
00:10:54,390 --> 00:10:55,770
لربما

142
00:11:01,690 --> 00:11:04,240
مرحبًا، هلا أتيت من فضلك إلى الاجتماع؟

143
00:11:04,240 --> 00:11:05,450
يجب أن نتحدث في موضوع صيد ذاك الحوت القاتل

144
00:11:05,820 --> 00:11:06,570
لن آتي

145
00:11:07,030 --> 00:11:08,370
ابني سيذهب بدلًا عني

146
00:11:08,370 --> 00:11:09,330
والدي

147
00:11:09,330 --> 00:11:10,740
...حسنٌ، لا يهم

148
00:11:11,330 --> 00:11:13,700
عمومًا، هل تعرف ذلك الرجل؟

149
00:11:14,160 --> 00:11:14,790
لا

150
00:11:15,370 --> 00:11:18,670
إنه طبيب افتتح  عيادته مؤخرًا، تلك الواقعة على الجرف الجنوبي

151
00:11:18,670 --> 00:11:19,670
!طبيب؟

152
00:11:19,790 --> 00:11:24,170
،أظن بأنه طبيب ماهر
لكن الناس تخشى الذهاب إليه

153
00:11:25,930 --> 00:11:26,760
!إذًا، فهو طبيب؟

154
00:11:36,940 --> 00:11:38,850
!هاي ترتون، على مهلك

155
00:11:55,200 --> 00:11:56,160
!نلت مني

156
00:11:58,040 --> 00:12:00,040
سبحت مع ترتون مراتٍ عدة

157
00:12:01,170 --> 00:12:03,630
و جاء اليوم الذي التقيت فيه بصديقه

158
00:12:04,840 --> 00:12:06,000
...هذا، إنه

159
00:12:08,800 --> 00:12:10,930
مرحبًا، هل ترغب باللعب أيضًا؟

160
00:12:31,370 --> 00:12:32,830
لا تقلق

161
00:12:32,950 --> 00:12:34,410
لستُ غاضبًا

162
00:12:37,230 --> 00:12:42,490
تـرجـمـة
كيـمـزهرة الكرزــو

163
00:12:42,590 --> 00:12:44,840
!الحوت القاتل مرةً أخرى، تبًا

164
00:12:45,550 --> 00:12:47,840
حطم الشبكة، و نشر الفوضى في بقعة الصيد

165
00:12:47,840 --> 00:12:49,090
!الحوت اللعين

166
00:12:49,090 --> 00:12:52,140
و في كل مرة نلاحقه لكي نقوم بإصطياده، يلوذ بالفرار

167
00:12:52,510 --> 00:12:55,140
بعضهم رأوا عليه ضمادات

168
00:12:55,310 --> 00:12:56,060
لا تكن سخيفًا

169
00:12:56,060 --> 00:12:58,640
لا يستطيع الحوت القاتل وضع ضمادات لنفسه

170
00:12:58,640 --> 00:12:59,730
أساليب والدي قديمة

171
00:13:00,230 --> 00:13:03,810
فهو يتحدث عن الأيام الخوالي، و يبقي الحيتان القاتلة حرة طليقة

172
00:13:12,410 --> 00:13:12,910
!أهذا أنت؟

173
00:13:13,660 --> 00:13:15,120
آسف، و لكننا اليوم لم نصطد شيئًا

174
00:13:15,530 --> 00:13:16,740
لم نمسك بأي سمكة

175
00:13:16,910 --> 00:13:18,910
لا، أرغب بسؤالك عن شيء ما

176
00:13:18,910 --> 00:13:19,620
وما هو؟

177
00:13:20,460 --> 00:13:22,750
و أنا أيضًا لدي شيءٌ لأخبرك به

178
00:13:24,250 --> 00:13:27,300
هل تريد الإبحار معي؟

179
00:13:30,050 --> 00:13:30,880
بماذا تشعر؟

180
00:13:30,880 --> 00:13:33,180
يشعرك البحر بالراحة، أليس كذلك؟

181
00:13:33,180 --> 00:13:33,680
معك حق

182
00:13:33,680 --> 00:13:36,260
إذًا، كيف حال ذلك الحوت القاتل؟

183
00:13:36,260 --> 00:13:37,350
هل كنت تعلم؟

184
00:13:38,270 --> 00:13:39,680
رأيتك مصادفة عندما كنت أصطاد

185
00:13:40,270 --> 00:13:44,900
كصيادين كنا في الماضي نتعايش معهم

186
00:13:45,730 --> 00:13:46,940
فهم يصطادون السمك

187
00:13:46,940 --> 00:13:48,900
و نحن نصطادها أيضًا

188
00:13:48,900 --> 00:13:51,030
حياتنا مميزة عن حياة الناس الآخرين

189
00:13:51,780 --> 00:13:54,240
نستطيع التعايش سويًا في البحر

190
00:13:55,280 --> 00:13:57,950
و لكن أصبح هذا شيئًا من الماضي

191
00:13:58,540 --> 00:14:00,080
فهذا تهديدٌ واضح

192
00:14:00,080 --> 00:14:02,000
بألا نقترب من الحيتان القاتلة بعد الآن

193
00:14:02,540 --> 00:14:04,670
فصيد الحيتان القاتلة سيبدأ عما قريب

194
00:14:05,250 --> 00:14:08,670
!ولكن، الحيتان القاتلة لها كامل الحرية في العيش في البحر

195
00:14:08,670 --> 00:14:09,710
أتفق معك

196
00:14:10,260 --> 00:14:13,090
ولكن، يجب علينا أن نمضي في حياتنا نحن أيضًا

197
00:14:15,390 --> 00:14:19,010
ففي نهاية المطاف، البشر والحيتان يعيشون في عوالم مختلفة

198
00:14:23,390 --> 00:14:26,060
ترتون، لقد شاهدوك و أنت تدمر بقعة الصيد

199
00:14:26,770 --> 00:14:29,320
وبسبب هذا فالجروح ملئت جسدك من الصيادين، هاه؟

200
00:14:30,440 --> 00:14:32,650
ترتون، من الأفضل لك أن تعود للمحيط

201
00:14:33,610 --> 00:14:35,490
ولا تعد إلى هنا مجددًا

202
00:14:36,200 --> 00:14:37,990
... وإلا،فإنك سـ

203
00:14:41,790 --> 00:14:43,290
وداعًا، ترتون

204
00:14:43,290 --> 00:14:46,000
لربما نتقابل يومًا ما في البحر

205
00:14:50,920 --> 00:14:54,800
ومن ثم، غبتُ عن ذلك المكان لعدة أيام

206
00:14:58,050 --> 00:15:00,680
إذًا، هل رجع ترتون إلى البحر بعدها؟

207
00:15:01,560 --> 00:15:05,640
... آنذاك، اعتقدت بأنه رجع فعلًا للبحر

208
00:15:07,900 --> 00:15:09,400
...حتى حدثت تلك الحادثة

209
00:15:13,440 --> 00:15:14,240
!انتظر

210
00:15:14,240 --> 00:15:15,570
!انتظر، أيها الحوت الوغد

211
00:15:17,700 --> 00:15:18,870
!أين، إلى أين ذهب؟

212
00:15:19,030 --> 00:15:20,030
خفف السرعة

213
00:15:20,030 --> 00:15:21,450
!سيحترق المحرك

214
00:15:21,450 --> 00:15:23,580
!سحقًا، سأقضي عليه الليلة

215
00:15:38,640 --> 00:15:39,220
...والدي

216
00:15:41,010 --> 00:15:41,510
!والدي

217
00:15:42,510 --> 00:15:43,930
!اهرب يا والدي

218
00:15:44,850 --> 00:15:45,430
!والدي

219
00:15:47,520 --> 00:15:48,060
!والدي

220
00:15:58,990 --> 00:16:01,120
كنت في مأمن، لأنني كنت مُلتصقًا بحطام القارب

221
00:16:01,410 --> 00:16:02,870
لكن الحوت استطاع النيل من والدي

222
00:16:03,290 --> 00:16:04,330
هذا غباء

223
00:16:04,330 --> 00:16:06,620
كيف يمكن لحوتٍ قاتل أن يهاجم مركبًا؟

224
00:16:06,620 --> 00:16:07,580
!إنها الحقيقة

225
00:16:08,170 --> 00:16:11,710
عندما وصلنا إلى هناك، كان الحوت القاتل موجودًا بالجوار

226
00:16:11,840 --> 00:16:13,960
ذاك الحوت يمتلك جرحًا ذو شكل هلالي على زعنفته

227
00:16:14,000 --> 00:16:14,960
!ماذا؟

228
00:16:14,960 --> 00:16:17,590
!ذاك الحوت من المؤكد أنه كان مُتأهبًا لابتلاعه

229
00:16:18,300 --> 00:16:21,970
لو كنت أعلم بأن هذا ما سيؤول إليه الأمر، لكنت قتلته سابقًا

230
00:16:24,350 --> 00:16:25,810
كيف... كيف هو حال والدي؟

231
00:16:26,100 --> 00:16:27,680
حالته حرجة

232
00:16:28,440 --> 00:16:31,980
لا أحد من طاقمنا الطبي يمكنه علاجه

233
00:16:33,520 --> 00:16:34,480
...مستحيل

234
00:16:35,150 --> 00:16:36,400
أنا سأتكفل بعلاجه

235
00:16:37,610 --> 00:16:40,780
سأنقذه، أعدك بذلك

236
00:16:51,670 --> 00:16:53,960
أعتمد عليك أيها الطبيب

237
00:16:57,210 --> 00:16:58,010
جرعة فوسمين

238
00:16:58,010 --> 00:16:59,010
نقل الدم كذلك

239
00:16:59,010 --> 00:17:00,430
أسرعوا بوضع جهاز القلب والرئة الصناعي

240
00:17:00,430 --> 00:17:01,090
!حاضر

241
00:17:05,600 --> 00:17:07,060
!اقتلوا ذاك الحوت الذي يلتهم البشر

242
00:17:07,680 --> 00:17:09,440
لا تخطئوا في إصابته

243
00:17:11,810 --> 00:17:12,480
ملقط

244
00:17:13,150 --> 00:17:14,230
ضغط الدم؟

245
00:17:14,230 --> 00:17:14,860
ثمانون

246
00:17:14,860 --> 00:17:16,610
لا أستطيع قراءة القيمة

247
00:17:17,110 --> 00:17:17,610
احقنه جرعة فوسمين

248
00:17:17,610 --> 00:17:18,240
!حاضر

249
00:17:31,330 --> 00:17:32,960
انتهت العملية

250
00:17:46,760 --> 00:17:49,180
...لم أستطع نسيانه

251
00:17:50,890 --> 00:17:51,730
ترتون

252
00:18:06,870 --> 00:18:07,740
لا

253
00:18:07,740 --> 00:18:09,500
لا أستطيع علاجك هذه المرة

254
00:18:12,620 --> 00:18:13,960
!لا تنظر إلي بعيناك هاتين

255
00:18:14,580 --> 00:18:15,500
!استسلم ولا تعد ثانيةً

256
00:18:24,300 --> 00:18:26,970
أخبرتك بأن لا تعود مجددًا

257
00:18:30,430 --> 00:18:35,850
عاد ترتون في اليوم التالي، بجروحه ومعه هدية جديدة

258
00:18:37,480 --> 00:18:39,690
ومع علمي بذلك، إلا أنني تظاهرت بعدم رؤيتي له

259
00:18:40,980 --> 00:18:44,990
ومع مرور الأيام كان ترتون يضعف أكثر فأكثر، و يحضر معه المرجان و اللؤلؤ

260
00:18:45,820 --> 00:18:46,700
أربعة

261
00:18:46,700 --> 00:18:47,910
...بعدها خمسة

262
00:18:48,530 --> 00:18:51,660
يومًا بعد يوم، أصبح المكان يعج بالهدايا

263
00:18:53,410 --> 00:18:54,500
أرجوك توقف عن ذلك

264
00:18:54,500 --> 00:18:56,420
فأنا لا أريد لؤلؤًا أو مرجانًا

265
00:18:57,000 --> 00:18:57,880
!لا أستطيع علاجك

266
00:18:58,420 --> 00:19:00,170
!لا أستطيع علاجك بعد الآن

267
00:19:08,640 --> 00:19:09,850
!والدي
هل تستطيع سماعي؟

268
00:19:10,180 --> 00:19:11,100
إنه أنا، والدي

269
00:19:11,930 --> 00:19:16,100
لا تتحدث بصوتٍ عالٍ أيها الأحمق

270
00:19:17,100 --> 00:19:20,690
استطعنا الإطاحة بذلك الحوت الوغد بينما كنت نائمًا

271
00:19:21,400 --> 00:19:22,150
ماذا؟

272
00:19:22,150 --> 00:19:23,650
!الحوت ذو الهلال

273
00:19:25,240 --> 00:19:27,360
أقلت، الحوت ذو ندبة الهلال؟

274
00:19:28,490 --> 00:19:29,160
...لكن

275
00:19:29,160 --> 00:19:32,620
!كيف استطعت فعلها؟

276
00:19:34,750 --> 00:19:39,840
بالتأكيد الحوت كان قادمًا باتجاهي

277
00:19:40,250 --> 00:19:46,050
،ولأنني لم أقدر على تحريك جسدي
ظننت بأن أمري قد انتهى

278
00:19:46,050 --> 00:19:47,180
،وعندها

279
00:19:49,140 --> 00:19:54,640
حوت قاتل آخر مع هلال على زعنفته جاء، وهجم على الحوت

280
00:19:55,600 --> 00:20:00,560
وفوق كل هذا، حملني وأخذني لإحدى المراكب

281
00:20:01,520 --> 00:20:03,440
وأنت قتلته ببساطة؟

282
00:20:03,440 --> 00:20:04,530
... محال

283
00:20:05,150 --> 00:20:06,950
... إذًا الحوت الذي طاردناه هو

284
00:20:08,990 --> 00:20:10,030
أيها الطبيب...؟

285
00:20:15,830 --> 00:20:16,540
!ترتون

286
00:20:20,670 --> 00:20:21,290
!ترتون

287
00:20:23,300 --> 00:20:23,920
!ترتون

288
00:20:26,340 --> 00:20:27,300
!ما يزال حيًا

289
00:20:28,720 --> 00:20:31,010
!ترتون، لن أدعك تلقى حتفك

290
00:20:47,820 --> 00:20:50,910
ترتون، هذا المكان ليس مناسبًا لك لتعيش فيه

291
00:20:51,700 --> 00:20:54,660
سيكون هذا وداعنا الأخير

292
00:21:10,470 --> 00:21:12,930
و منذ ذلك اليوم، لم يرَ أحد ترتون أبدًا

293
00:21:20,310 --> 00:21:21,690
هذه هي نهاية القصة

294
00:21:23,690 --> 00:21:25,690
لا تخبري أحدًا بما قلته لكِ

295
00:21:25,690 --> 00:21:26,980
لنعد هيا

296
00:21:26,980 --> 00:21:31,070
أيها الطبيب أنت لست وحيدًا بعد الآن ، أليس كذلك؟

297
00:21:32,950 --> 00:21:33,490
لا

298
00:21:36,410 --> 00:21:37,740
لارجو، ماذا هنالك؟

299
00:21:43,380 --> 00:21:45,040
...أيها الطبيب، إنه

300
00:21:46,040 --> 00:21:46,840
!ترتون

301
00:21:46,840 --> 00:21:49,210
!لا بد أنه ترتون

302
00:21:51,430 --> 00:21:52,340
هذا صحيح

303
00:21:52,340 --> 00:21:55,930
!ترتون

304
00:21:57,100 --> 00:22:00,350
!اعتنِ بنفسك

305
00:22:06,340 --> 00:22:11,950
كمْ أُحبُّكَ يا عزيزي

306
00:22:12,000 --> 00:22:18,350
لو أنّي أستطيع الاِرتباط بكَ

307
00:22:18,400 --> 00:22:23,500
فهذه سعادة الدُّنيا وما فيها

308
00:22:24,940 --> 00:22:30,600
مُنَى عيْنايَّ رُؤيتكَ لأبدِ الدَّهرِ

309
00:22:31,100 --> 00:22:36,650
وكأنّي مشواةٌ مُحترقةٌ

310
00:22:37,050 --> 00:22:39,620
مِن شدّة لهيب شَوْقكَ

311
00:22:39,720 --> 00:22:46,650
جَعَلَني أَتَقلَّبُ في بحرٍ مِن الألوان

312
00:22:47,590 --> 00:22:59,150
فصارَ تَبَرُّجي كَحَبّاتِ الزِّينةِ البرّاقةِ

313
00:22:59,500 --> 00:23:05,070
مُتيَّمَةٌ بكَ يا عزيزي

314
00:23:05,100 --> 00:23:11,500
فأرجوكَ بادلني الغَرام أكثَر فأكثَر

315
00:23:11,520 --> 00:23:17,050
كمْ أُحبُّكَ يا عزيزي

316
00:23:17,080 --> 00:23:23,050
لو أنّي أستطيع الاِرتباط بكَ

317
00:23:23,070 --> 00:23:27,950
فهذه سعادة الدُّنيا وما فيها

318
00:23:28,280 --> 00:23:33,400
كيف مَذاقُ طَعامي؟

319
00:23:45,050 --> 00:23:46,940
!بيغ ماسك

320
00:23:45,460 --> 00:23:48,080
!الحلقة المقبلة: أعد إلي أخي

321
00:23:47,770 --> 00:23:49,590
!جميلٌ للغاية

322
00:23:49,590 --> 00:23:52,090
أخاك هو نفسه جورس، أليس كذلك؟

323
00:23:52,090 --> 00:23:55,350
إذًا، أخوك هو الشرير

324
00:23:55,350 --> 00:23:56,220
لا، أنت مخطئ

325
00:23:56,220 --> 00:23:57,090
ما الخطب؟

326
00:23:57,090 --> 00:23:58,200
...ساقاي، إنهما

327
00:23:58,200 --> 00:23:59,720
...إنهما متورمتان

328
00:23:59,720 --> 00:24:03,190
لماذا يتوجب عليك أن تكون الآلي جوراس يا أخي؟

329
00:24:03,190 --> 00:24:05,830
قد أكون مجبرًا على قطعه

330
00:24:07,170 --> 00:24:10,170
سوف تشعر بوخزة صغيرة فقط

331
00:24:10,850 --> 00:24:14,560
!الحلقة القادمة: أعد إلي أخي

332
00:24:15,960 --> 00:24:17,990
أخطاء التصوير

333
00:24:18,850 --> 00:24:20,010
!إنه ترتون

334
00:24:20,010 --> 00:24:21,210
...لا بد أنه

335
00:24:21,750 --> 00:24:23,060
!اقطع! اقطع

336
00:24:23,060 --> 00:24:25,110
أنفكِ يسيل يا بينوكو