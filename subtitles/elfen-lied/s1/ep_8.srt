1
00:01:31,370 --> 00:01:32,440
!نيو

2
00:01:33,730 --> 00:01:34,840
نيو؟

3
00:01:36,130 --> 00:01:37,170
!كوتا

4
00:01:37,170 --> 00:01:40,850
!لا تعبثي معي
!لن يجدي نفعًا كآخر مرة

5
00:01:40,850 --> 00:01:41,850
!نيو

6
00:01:41,850 --> 00:01:43,530
أأنت بخيرٍ يا نيو؟

7
00:01:43,530 --> 00:01:44,850
!نيو

8
00:01:45,250 --> 00:01:46,250
لماذا؟

9
00:01:46,250 --> 00:01:47,330
...أنتِ

10
00:01:53,330 --> 00:01:55,010
!لِمَ فعلت ذاك فجأةً؟

11
00:01:55,010 --> 00:01:56,670
!هذا ما يفترض بي قوله

12
00:01:58,130 --> 00:02:00,850
...لماذا

13
00:02:00,850 --> 00:02:04,650
أعتذر. أعتذر عن مآل إليه الوضع

14
00:02:04,650 --> 00:02:07,180
كوتا، أنا آسفة

15
00:02:08,850 --> 00:02:10,120
لماذا؟

16
00:02:11,190 --> 00:02:14,290
!لماذا؟! إنها الشخص السيئ

17
00:02:14,290 --> 00:02:16,530
لِمَ يدافع الجميع عن لوسي؟

18
00:02:16,850 --> 00:02:17,770
لوسي؟

19
00:02:17,770 --> 00:02:19,780
!إنها شخصٌ سيئٌ جدًا

20
00:02:20,410 --> 00:02:22,050
لماذا؟

21
00:02:22,050 --> 00:02:24,160
لم أرتكب خطًأ

22
00:02:24,690 --> 00:02:27,690
نانا لم ترتكب خطًأ

23
00:02:27,690 --> 00:02:30,010
!نيو! أجيبي

24
00:02:30,010 --> 00:02:31,170
ما المشكلة؟

25
00:02:31,170 --> 00:02:32,970
يبدو أنها فقدت وعيها

26
00:02:32,970 --> 00:02:34,770
!نيو! تماسكي

27
00:02:37,170 --> 00:02:38,720
!نانا

28
00:02:45,970 --> 00:02:48,610
نانا لم ترتكب خطًأ

29
00:02:48,610 --> 00:02:51,120
نانا لم ترتكب خطًأ، فلِمَ؟

30
00:03:02,570 --> 00:03:04,870
لقد نسيتِ حقيبتك

31
00:03:04,870 --> 00:03:05,800
!لا أحتاجها

32
00:03:06,650 --> 00:03:10,120
!أكرهك! الجميع عاملني وكأني شخصٌ سيئ

33
00:03:10,330 --> 00:03:11,490
!أفلتيني

34
00:03:11,490 --> 00:03:12,690
!لا

35
00:03:11,970 --> 00:03:13,360
!قلت أفلتيني

36
00:03:26,930 --> 00:03:28,930
أنت المخطئة

37
00:03:28,930 --> 00:03:31,130
بفعلك لشيءٍ كذاك بنيو على حين غرة

38
00:03:31,130 --> 00:03:34,290
!لكنها امرئٌ بالغ السوء

39
00:03:34,290 --> 00:03:39,720
ألم تنادي نيو قبل قليل بـ"لوسي"؟

40
00:04:16,330 --> 00:04:18,210
هذا الأسوأ

41
00:04:18,210 --> 00:04:20,850
لن أركبها ثانيةً

42
00:04:20,850 --> 00:04:22,640
لقد كنت بانتظارك

43
00:04:29,930 --> 00:04:33,690
لِمَ عليَّ قطع كل تلك المسافة لتسليم شيءٍ كهذا؟

44
00:04:33,690 --> 00:04:36,360
فكل ما عليك فعله هو الحضور وأخذه، صحيح؟

45
00:04:40,170 --> 00:04:42,960
إلى حدٍ ما يعتبر هذا اختطافًا

46
00:04:44,450 --> 00:04:48,180
أتساءل كم يومًا مضى على آخر استحمامٍ لي

47
00:04:51,730 --> 00:04:53,520
المدير كاكوزاوا بانتظارك

48
00:04:59,090 --> 00:05:00,570
...بلا ريب

49
00:05:01,250 --> 00:05:03,170
الآن حُلت المسألة، صحيح؟

50
00:05:03,170 --> 00:05:04,860
هلّا سمحت لي بالعودة إلى المنزل؟

51
00:05:05,810 --> 00:05:07,050
العودة؟

52
00:05:07,050 --> 00:05:10,410
صدقًا، واجبٌ عليّ تقديم تعازيّ

53
00:05:10,410 --> 00:05:14,190
...إلا أنه تم استدعائي فجأةً إلى مكانٍ كهذا و

54
00:05:14,650 --> 00:05:17,600
أنا مَن عليه تقديم التعازي

55
00:05:21,380 --> 00:05:23,610
!ماذا؟ مهلًا

56
00:05:23,610 --> 00:05:26,250
إنه خطرٌ فاخفضه، صحيح؟

57
00:05:28,090 --> 00:05:31,210
أنتِ، لا تقفي هناك صامتة

58
00:05:31,210 --> 00:05:33,010
لقد رأيتِ هذه

59
00:05:33,010 --> 00:05:34,350
هذه؟ أتقصد القرون؟

60
00:05:34,350 --> 00:05:38,600
لذا لا يسعني السماح لك بالمغادرة

61
00:05:39,690 --> 00:05:41,640
لا بد أنك تمزح

62
00:05:44,490 --> 00:05:46,730
!محال

63
00:05:46,730 --> 00:05:49,770
...محال... محال أن تكون نيو

64
00:05:49,770 --> 00:05:54,770
إنها الحقيقة. لقد فرّت من المختبر وأهلكت الكثير من الناس

65
00:05:54,770 --> 00:05:58,040
فقدتُ ذراعيّ وقدميّ على يدها حينما أتيتُ للبحث عنها

66
00:05:58,770 --> 00:06:02,040
لا أصدق هذا

67
00:06:12,890 --> 00:06:16,130
لسنا بشرًا عاديين

68
00:06:16,130 --> 00:06:18,400
والقرون ليست كل ما يميزنا

69
00:06:23,050 --> 00:06:24,650
ماذا؟

70
00:06:24,650 --> 00:06:26,520
سأريك

71
00:06:33,570 --> 00:06:36,000
لقد أطلق بالفعل

72
00:06:38,530 --> 00:06:40,540
ألستِ لا تبغين الموت؟

73
00:06:41,170 --> 00:06:43,610
!لا تسأل عن شيءٍ بديهي

74
00:06:43,610 --> 00:06:45,420
أنا أنزف بشدة

75
00:06:45,890 --> 00:06:48,800
إذًا أطيعيني بطيب نفس

76
00:06:51,290 --> 00:06:54,010
أجيبي عن سؤالي أولًا

77
00:06:55,490 --> 00:06:57,490
من كان الشخص الآخر؟

78
00:06:57,490 --> 00:06:58,970
عمَّ تتحدث؟

79
00:06:58,970 --> 00:07:01,770
الشخص الآخر الذي رأى جثة ابني

80
00:07:01,770 --> 00:07:05,200
اتضح لنا وجود آثار شخصٍ آخر غيرك

81
00:07:05,810 --> 00:07:09,030
بالفعل كان هنالك شخص آخر

82
00:07:09,370 --> 00:07:12,370
كان طالبًا أتى للقاء البروفيسور

83
00:07:12,370 --> 00:07:13,490
ما اسمه؟

84
00:07:13,490 --> 00:07:17,040
لم أعد أتذكر وجه جيدًا حتى؛ بسبب ما جرى

85
00:07:17,290 --> 00:07:19,600
وهذا يشمل اسمه

86
00:07:20,290 --> 00:07:21,920
...أشعر بالتعب

87
00:07:24,050 --> 00:07:27,210
فهمت. هذا مؤسف

88
00:07:27,610 --> 00:07:31,320
أخبرني ابني بأنك عالمة ممتازة

89
00:07:37,850 --> 00:07:40,730
...لقد تذكرت

90
00:07:42,050 --> 00:07:46,770
لقد أتى باحثًا عن الفتاة التي عهد بها للبروفيسور

91
00:07:47,450 --> 00:07:49,290
فتاة؟

92
00:07:49,290 --> 00:07:54,880
عندما وصلنا إليه، لم تكن برفقته

93
00:07:55,650 --> 00:08:00,970
أسأموت بغية السرية في مكانٍ كهذا وما زلت عذراء؟

94
00:08:00,970 --> 00:08:04,750
...لا أقبل بذلك... البت

95
00:08:12,490 --> 00:08:13,650
شيراكاوا

96
00:08:13,650 --> 00:08:14,760
نعم

97
00:08:17,450 --> 00:08:20,270
معك مكتب المدير
أرسل فريقًا طبيًا حالًا

98
00:08:21,050 --> 00:08:23,570
أستنقذني؟

99
00:08:23,570 --> 00:08:27,120
...بشرط أن تتعاوني معي

100
00:08:30,170 --> 00:08:31,940
بدلًا عن ابني

101
00:08:36,050 --> 00:08:40,370
منذ ولادتنا، نملك أيادٍ مختلفة عنكم

102
00:08:40,370 --> 00:08:41,580
أيادٍ؟

103
00:08:59,210 --> 00:09:01,000
ثمة أربعة أيادٍ من هذا النوع

104
00:09:01,270 --> 00:09:05,840
إنها سبب قدرتي على تحريك الأقدام والأذرع الذي وهبني إيّاها أبي

105
00:09:07,810 --> 00:09:10,920
إذًا لم أكن أحلم

106
00:09:11,770 --> 00:09:14,720
...إذًا ما قاله ذلك الرجل كان أيضًا

107
00:09:16,090 --> 00:09:17,490
أأنت مندهشة؟

108
00:09:17,490 --> 00:09:20,610
لكن نانا مختلفةٌ عن لوسي

109
00:09:20,610 --> 00:09:22,490
لا أقوم بفعل أشياء مشينةٍ أبدًا

110
00:09:23,930 --> 00:09:27,770
!لا! أخبرني بابا بأن ذلك سر

111
00:09:27,770 --> 00:09:30,290
!لقد أفشيته! ما العمل؟

112
00:09:32,290 --> 00:09:33,290
ما الأمر؟

113
00:09:33,290 --> 00:09:36,290
نيو ليست امرئً سيئًا البتة

114
00:09:36,290 --> 00:09:41,010
إنها بريئة بشكلٍ غريب، وتبدو دائمًا سعيدة

115
00:09:41,370 --> 00:09:44,320
وعندما أكون معها، أشعر بالسعادة

116
00:09:47,690 --> 00:09:50,610
...تلك الأيادي

117
00:09:50,610 --> 00:09:52,610
لم تستعملها قط يومًا

118
00:09:52,610 --> 00:09:56,110
!إنها الحقيقة! إنها شخصٌ مختلفٌ تمامًا عمن تتحدثين عنه

119
00:09:56,490 --> 00:09:58,280
...أتساءل لماذا

120
00:09:59,370 --> 00:10:03,000
لا مجال للشك في كونها لوسي

121
00:10:04,050 --> 00:10:07,280
إلا أني لا أشعر بها البتة

122
00:10:08,370 --> 00:10:12,290
نانا تعلم بأنها مختلفةٌ عن لوسي التي تعرفها

123
00:10:12,290 --> 00:10:13,480
...لكن

124
00:10:14,130 --> 00:10:17,560
إن هاجمتها وهي بهذه الشخصية، فسأهزمها بسهولة

125
00:10:18,050 --> 00:10:19,530
!نانا

126
00:10:20,470 --> 00:10:23,450
!لا أعلم. لا أعلم

127
00:10:23,450 --> 00:10:27,730
لا أستطيع مقاتلة شخصٍ أعلم بأنه سيقف مكتوف اليدين

128
00:10:28,210 --> 00:10:31,240
ما العمل يا بابا؟

129
00:10:32,010 --> 00:10:33,730
...نانا

130
00:10:40,250 --> 00:10:42,690
لم تنخفض حرارتها
فما العمل؟

131
00:10:42,690 --> 00:10:45,810
يبدو بأن الهجوم عليها لم يكن السبب الوحيد لما آلت إليه

132
00:10:45,810 --> 00:10:48,410
إن أُصيبت بمرضٍ، فعلينا نقلها إلى المشفى

133
00:10:49,930 --> 00:10:53,250
البشر ذوو القرون يُعزَلون فورًا

134
00:10:53,250 --> 00:10:54,890
...بعد ذلك

135
00:10:54,890 --> 00:10:56,670
...لكن المشفى

136
00:11:02,250 --> 00:11:04,210
!فتحت نيو عينيها

137
00:11:04,210 --> 00:11:05,310
!نيو

138
00:11:06,250 --> 00:11:08,440
أنا سعيد. أتعرفينني؟

139
00:11:10,290 --> 00:11:11,510
...كوتا

140
00:11:12,850 --> 00:11:13,730
نانا؟

141
00:11:17,130 --> 00:11:19,400
نانا، ما الذي حدث؟

142
00:11:23,970 --> 00:11:25,450
!لقد استيقظت

143
00:11:26,370 --> 00:11:28,690
لم أتوقع إحضارك لغريبٍ إلى هنا

144
00:11:28,690 --> 00:11:31,150
حتى إن كانت مساعدة البروفيسور كاكوزاوا فهي غريبة

145
00:11:31,690 --> 00:11:34,010
ففيمَّ تفكر أيها المدير؟

146
00:11:34,010 --> 00:11:37,670
إنها تعلم كل شيءٍ عن أبحاث ابني

147
00:11:37,670 --> 00:11:40,570
تطوير لقاحٍ مضادٍ للفيروس القهقري

148
00:11:40,570 --> 00:11:43,520
ممكنٌ جدًا في منشأةٍ خارجية

149
00:11:44,250 --> 00:11:45,920
لقاح؟

150
00:11:47,890 --> 00:11:53,440
لم يكن اللقاح مرادي، بل الفيروس نفسه

151
00:11:53,730 --> 00:11:57,150
لا أعلم هدفك

152
00:11:57,370 --> 00:12:02,150
بلوسي في قمته، سأسعى إلى إنشاء جنسٍ بشريٍ جديد

153
00:12:03,330 --> 00:12:04,810
...أيها المدير

154
00:12:04,810 --> 00:12:06,370
...أنت

155
00:12:06,370 --> 00:12:11,170
السلالة المسماة بالبشر تسير بلا ريبٍ نحو نهايتها

156
00:12:11,170 --> 00:12:13,970
بالأحرى، هو مصيرها

157
00:12:13,970 --> 00:12:17,320
ظهور لوسي في هذا العالم برهانٌ عليه

158
00:12:18,490 --> 00:12:21,370
أنا ممثل الإله

159
00:12:21,370 --> 00:12:22,380
هذا جنون

160
00:12:23,330 --> 00:12:27,050
لقد أخبرتك
لا تسئ الفهم يا كوراما

161
00:12:27,530 --> 00:12:31,010
أنسيت أنك تدين لي بشكر؟

162
00:12:31,010 --> 00:12:34,480
ينبغي أن تكون مخلصًا لي

163
00:12:36,170 --> 00:12:38,320
سمعت أنك هرّبت الرقم سبعة

164
00:12:39,410 --> 00:12:45,520
سنستعمل الرقم خمسةٍ وثلاثين للتخلص من الرقم سبعة والقبض على لوسي

165
00:12:47,130 --> 00:12:52,080
ستدفع ثمن عصيانك مع دين الشكر

166
00:12:54,890 --> 00:12:57,670
نيو، أتشعرين بالألم في جزءٍ ما؟

167
00:13:05,890 --> 00:13:08,000
إلى أين ستذهبين؟

168
00:13:13,890 --> 00:13:16,530
جزءٌ من ذاكرتي مفقودٌ مجددًا

169
00:13:21,930 --> 00:13:23,440
لعلها ستذهب إلى الحمام

170
00:13:27,930 --> 00:13:29,950
الحمام ليس من هنا

171
00:13:29,950 --> 00:13:32,880
سألقن إحدى الغبيات درسًا

172
00:13:36,850 --> 00:13:38,610
أنت الغبية

173
00:13:38,610 --> 00:13:40,880
عليك المكوث في الفراش بهدوء

174
00:13:42,370 --> 00:13:43,800
...كوتا

175
00:13:47,610 --> 00:13:50,610
سأحضر بعض الدواء من منزلي

176
00:13:50,610 --> 00:13:53,450
...لو كان لديك على الأقل دواءٌ للحمى

177
00:13:53,450 --> 00:13:55,010
أعلم

178
00:13:55,010 --> 00:13:56,490
اعتن بها إذًا

179
00:13:56,490 --> 00:13:57,890
رجاءً

180
00:13:57,890 --> 00:14:00,610
نيو، لا تقومي بأفعالٍ منحرفةٍ ثانيةً

181
00:14:16,410 --> 00:14:20,130
سأبقى معك، لذا لا تقلقي واخلدي للنوم

182
00:14:22,290 --> 00:14:24,590
علينا خفض درجة حرارتك عاجلًا

183
00:14:26,650 --> 00:14:28,960
لنخفض درجة حرارتك، اتفقنا؟

184
00:14:51,370 --> 00:14:53,410
أأصيبت تلك الفتاة بالحمى ثانيةً؟

185
00:14:53,410 --> 00:14:55,730
طفح الكيل

186
00:14:55,730 --> 00:14:58,370
قررت المغادرة إن أصيبت ثانيةً

187
00:14:58,810 --> 00:15:00,690
إنها مرعبة وليست طفوليةً أبدًا

188
00:15:00,690 --> 00:15:05,480
أتساءل ما تلك الأشياء التي تبدو كالقرون

189
00:15:07,890 --> 00:15:11,560
الأطفال الآخرون لا يرغبون في المكوث معها في غرفةٍ واحدة

190
00:15:48,370 --> 00:15:50,520
أأنت قلقٌ عليّ؟

191
00:15:51,290 --> 00:15:54,530
أنا بخير، اعتدت على أن أكون وحدي

192
00:15:54,530 --> 00:16:01,890
أنا لا أشعر بالوحدة

193
00:16:03,970 --> 00:16:05,050
!أنتِ يا ذات القرون

194
00:16:05,050 --> 00:16:07,080
!أنتِ! أحادثك أنتِ

195
00:16:07,730 --> 00:16:09,860
ما الذي حدث لحقيبتك؟

196
00:16:10,450 --> 00:16:12,880
تنبعث منها رائحة نتنة بسبب الحليب

197
00:16:13,970 --> 00:16:15,870
أجيبي على الأقل

198
00:16:23,120 --> 00:16:27,130
سمعت عن ذلك؛ أنه تم العثور عليك وقد هُجِرتِ في الغابة

199
00:16:27,530 --> 00:16:30,480
لا غرابة في أن تُهجري ما دمتِ تملكين قرونًا نابتةً على رأسك

200
00:16:33,730 --> 00:16:34,600
ها أنا ذا

201
00:16:37,970 --> 00:16:42,060
أأنت ابنة شيطان أوشيءٍ غير بشري؟

202
00:16:42,770 --> 00:16:45,720
المعلمون قالوا عنك بأنك مخيفة

203
00:16:53,530 --> 00:16:56,690
!أيها المعلم، إن تومو يتنمر ثانيةً

204
00:16:56,690 --> 00:16:58,200
!ويحي! لنهرب

205
00:17:00,770 --> 00:17:03,160
!أنت الأسوأ؛ فأنت تتنمر على فتاة

206
00:17:03,490 --> 00:17:05,280
أأنت بخير؟

207
00:17:07,210 --> 00:17:09,440
حقيبتك مغطاةٌ بالحليب

208
00:17:10,170 --> 00:17:12,170
لقد ارتكب أشياء فظيعة

209
00:17:12,650 --> 00:17:15,430
كل الأطفال هنا تعساء

210
00:17:15,690 --> 00:17:17,430
ماذا؟ ماذا قلتِ؟

211
00:17:17,730 --> 00:17:22,160
بما أنهم تعساء، فهم على الأرجح يحتاجون امرئً أشد تعاسةً منهم

212
00:17:24,010 --> 00:17:25,640
!مهلًا

213
00:17:30,050 --> 00:17:32,510
آمل أنها ستغدو بحالٍ جيدة ما إن تجف

214
00:17:32,890 --> 00:17:35,950
لا تمكثي وحدك دائمًا

215
00:17:36,210 --> 00:17:40,330
إن وقعت في مشكلة، فبوسعك إخباري

216
00:17:40,330 --> 00:17:42,450
سأعينك حتمًا

217
00:18:00,850 --> 00:18:03,490
كنتَ تتضور جوعًا، صحيح؟

218
00:18:06,730 --> 00:18:12,560
لولاك، لكنتُ يائسةً منذ زمن بعيد

219
00:18:16,770 --> 00:18:20,730
آسفة، ليس لدي شيءٌ آخر أطعمك إيّاه

220
00:18:22,730 --> 00:18:26,040
كما توقعت نصف غدائي لا يكفي

221
00:18:30,010 --> 00:18:33,250
حتى إن أصابك الجوع، فلا تذهب في هذا الاتجاه

222
00:18:33,250 --> 00:18:35,360
سيتنمرون عليك

223
00:18:36,730 --> 00:18:41,680
لو كنتُ فقط أشد قوة، لتمكنت من حمايتك

224
00:18:45,410 --> 00:18:47,520
...لو كنتُ فقط أشد قوة

225
00:19:11,370 --> 00:19:12,730
...مرةً أخرى

226
00:19:12,730 --> 00:19:14,370
...أشعر وكأن

227
00:19:14,370 --> 00:19:16,000
...شيئًا

228
00:19:16,930 --> 00:19:19,010
في داخلي

229
00:19:32,970 --> 00:19:34,240
ما الأمر؟

230
00:19:35,090 --> 00:19:37,200
ثمة شيءٌ أود التحدث معك بشأنه

231
00:19:37,970 --> 00:19:40,360
!مذهل! لديك كلب

232
00:19:41,970 --> 00:19:45,580
آسفة. فإن وجده تومو وأصدقاؤه فسيتنمرون عليه، صحيح؟

233
00:19:47,050 --> 00:19:51,010
اطمئني؛ فسأشاركه أنا أيضًا غدائي

234
00:19:51,010 --> 00:19:53,120
فعلى أي حال أنا لا آكله كله

235
00:19:54,290 --> 00:19:56,210
!ما ألطفه

236
00:19:56,210 --> 00:19:57,530
لا تخبري أحدًا بأمره

237
00:19:57,530 --> 00:20:01,260
أجل، لن أخبر أحدًا. اطمئني

238
00:20:01,810 --> 00:20:03,080
حسنًا

239
00:20:09,690 --> 00:20:10,770
!يا ذات القرون

240
00:20:12,690 --> 00:20:14,530
...أنت مغرورة

241
00:20:14,530 --> 00:20:16,770
رغم أنك لست بشرية

242
00:20:19,890 --> 00:20:21,050
!أنتم

243
00:20:21,050 --> 00:20:22,240
لحظة

244
00:20:24,450 --> 00:20:26,690
!أفلتني! توقفوا

245
00:20:26,690 --> 00:20:30,330
إنها المرة الأولى التي أراك فيها منفعلةً هكذا

246
00:20:30,330 --> 00:20:34,290
!أنت لا تبكين ولا تضحكين. أنت مخيفة

247
00:20:34,650 --> 00:20:37,290
!ابكي! ابكي وتوسلي

248
00:20:37,690 --> 00:20:41,760
وإلا تألم الكلب عوضًا عنك

249
00:20:44,770 --> 00:20:46,570
!...أيتها

250
00:20:46,570 --> 00:20:48,770
اركل الكلب

251
00:20:48,770 --> 00:20:49,640
!إيّاك

252
00:20:54,970 --> 00:20:58,240
هذا أكثر فعاليةً من مضايقتها مباشرة

253
00:21:02,490 --> 00:21:04,000
أمسكه

254
00:21:16,050 --> 00:21:17,320
...محال

255
00:21:17,530 --> 00:21:18,930
...شيءٌ كهذا

256
00:21:18,930 --> 00:21:20,410
...لِمَ

257
00:21:20,730 --> 00:21:21,800
لِمَ؟

258
00:21:22,460 --> 00:21:24,070
!توقفا

259
00:21:24,070 --> 00:21:27,180
لماذا؟ ألستِ مَن أخبرنا عنه؟

260
00:21:28,490 --> 00:21:30,310
...لأني... لأني

261
00:21:30,570 --> 00:21:32,680
لم أتوقع أنك ستفعل شيئًا كهذا

262
00:21:37,450 --> 00:21:40,690
آسفة. لقد زل لساني

263
00:21:43,410 --> 00:21:46,030
ماذا؟ بات لا يتحرك

264
00:21:47,240 --> 00:21:48,440
كان هذا سريعًا جدًا

265
00:21:52,090 --> 00:21:54,120
بما أنهم تعساء

266
00:21:54,730 --> 00:21:59,710
فهم غالبًا يحتاجون امرئً أشد تعاسةً منهم

267
00:22:00,330 --> 00:22:05,160
...مَن هم ليسوا بشرًا

268
00:22:05,970 --> 00:22:07,720
!هم أنتم

269
00:22:32,690 --> 00:22:35,580
آسفة؛ فالذنب ذنبي

270
00:22:36,450 --> 00:22:41,240
لِمَ توجب عليَّ أن أُعامل بهذا الشكل فقط لأني مختلفةٌ قليلًا عن الآخرين؟

271
00:22:41,610 --> 00:22:43,040
لماذا؟

272
00:24:35,290 --> 00:24:40,880
لم تكف التروس يومًا عن الدوران، ولكنها لم تنسجم بعد

273
00:24:42,040 --> 00:24:47,800
بصيص الأمل الذي يُشع في داخلها يؤكد عمق ظلامها وحسب

274
00:24:48,730 --> 00:24:53,630
ما المعنى الذي جلبته الذاكرة للفتاة؟

275
00:24:54,970 --> 00:24:57,240
:الحلقة التاسعة من إلفن ليد