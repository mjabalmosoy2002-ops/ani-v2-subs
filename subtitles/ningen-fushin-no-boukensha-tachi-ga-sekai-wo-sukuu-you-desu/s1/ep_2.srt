1
00:00:03,200 --> 00:00:05,350
...عـ-عفوًا

2
00:00:05,350 --> 00:00:06,360
ماذا؟

3
00:00:06,990 --> 00:00:12,100
.على رسلكم! لا تدفعوا موظّفة استقبالنا للبكاء

4
00:00:12,710 --> 00:00:14,470
أنت هو نيك؟

5
00:00:14,470 --> 00:00:16,230
من أسياد الحرب؟

6
00:00:17,640 --> 00:00:19,670
.نعم. سيتمّ هذا الأمر أسرع إن كنت تعرفينني

7
00:00:20,110 --> 00:00:21,230
...حسنًا

8
00:00:21,230 --> 00:00:25,620
.متعنتر وتنّينيّة وساحرة وراهب

9
00:00:25,620 --> 00:00:28,010
.فرقة متوازنة بشكل جيّد

10
00:00:29,210 --> 00:00:33,150
إذًا فالفتاة النّاجية عادت للعمل؟

11
00:00:35,830 --> 00:00:37,200
ماذا تقصدين؟

12
00:00:37,200 --> 00:00:39,010
.أقصدها هي

13
00:00:39,010 --> 00:00:43,400
حقّقت معجزة بعودتها قيد الحياة
.من متاهة من الرّتبة سي

14
00:00:43,400 --> 00:00:46,640
.تتكلّم النّقابات عنها

15
00:00:47,280 --> 00:00:50,020
ناجية؟

16
00:00:50,870 --> 00:00:52,260
...ناجية

17
00:00:52,840 --> 00:00:53,920
كاران؟

18
00:00:53,920 --> 00:00:56,020
،واثقة أنّك مررت بالكثير

19
00:00:56,020 --> 00:01:01,180
لكنّ أهمّ قدرة قد يملكها المغامر
.هي القدر على العودة قيد الحياة

20
00:01:02,090 --> 00:01:04,920
...العودة قيد الحياة

21
00:01:05,280 --> 00:01:08,520
ماذا سيكون اسم فرقتكم؟

22
00:01:09,600 --> 00:01:11,190
...ناجون

23
00:01:12,710 --> 00:01:15,380
.سنعود إلى هنا قيد الحياة مهما كلّف الأمر

24
00:01:16,000 --> 00:01:18,040
لذلك ما رأيكم أن نسمّي أنفسنا "النّاجون"؟

25
00:01:18,040 --> 00:01:19,560
.إنّه مُتوقّع

26
00:01:19,560 --> 00:01:21,430
.لكنّه ليس سيّئًا

27
00:01:21,430 --> 00:01:23,070
...النّاجون

28
00:01:23,630 --> 00:01:24,510
كاران؟

29
00:01:25,880 --> 00:01:27,340
.أعجبني

30
00:01:27,340 --> 00:01:29,600
!من المهمّ أن يكون قتلنا صعبًا

31
00:01:31,360 --> 00:01:33,610
...إذًا فاسمكم سيكون

32
00:01:33,610 --> 00:01:34,970
!النّاجون

33
00:03:05,350 --> 00:03:12,430
.تبدو كمعجزة لي أنّهم التقوا في تلك الحانة ليلتها

34
00:03:12,430 --> 00:03:17,200
ماذا عن مغامراتهم بعد أن صاروا الآن فرقة واحدة؟

35
00:03:17,460 --> 00:03:18,810
.حسنًا، مرّة أخرى

36
00:03:19,090 --> 00:03:23,730
.كمغامرين مخذولين، سنضع لأنفسنا ثلاثة قوانين

37
00:03:24,250 --> 00:03:26,450
.قوانين" مصطلح مبالغ فيه قليلاً"

38
00:03:26,450 --> 00:03:28,340
!القوانين الثّلاثة لفرقة النّاجون

39
00:03:28,340 --> 00:03:30,110
ما الأوّل يا تيانا؟

40
00:03:30,360 --> 00:03:32,380
!لا يجب التّدخّل في هوايات الآخرين

41
00:03:32,380 --> 00:03:33,060
.زيم

42
00:03:33,060 --> 00:03:34,480
.ننتبه للمال

43
00:03:34,480 --> 00:03:35,270
.كاران

44
00:03:35,270 --> 00:03:36,730
.العودة قيد الحياة مهما كلّف الأمر

45
00:03:36,730 --> 00:03:37,590
.هذا صحيح

46
00:03:38,000 --> 00:03:42,360
بالنّسبة للمال، سيكون لنا جميعًا دور
.في إبقائه آمنًا بدل شخص واحد

47
00:03:42,360 --> 00:03:44,070
.سأتولّى أمر السّجلاّت

48
00:03:44,070 --> 00:03:46,190
ستتحقّق تيانا ممّا أضيفه للسّجلاّت
.وستحمل المال الّذي بحوزتنا

49
00:03:46,190 --> 00:03:47,690
.وستتكفّل كاران بالخزنة

50
00:03:47,690 --> 00:03:50,000
...أ-أنا متوتّرة نوعًا ما

51
00:03:50,000 --> 00:03:52,430
سأحضر لك خزنة قويّة جدًّا
لا يمكن اختراقها بسهولة

52
00:03:52,430 --> 00:03:54,560
.بمطرقة ثقيلة أو حتّى بسحر

53
00:03:54,560 --> 00:03:56,110
...أمّا زيم، فسيتكفّل بالمفتاح

54
00:03:55,350 --> 00:03:57,170
.خيار السّاحر

55
00:03:57,990 --> 00:04:00,990
.إنّه تقنية إجبار يستعملها السّحرة
،تجعل الأمر يبدو كأنّك توزّع مهامًا

56
00:04:00,990 --> 00:04:04,280
.لكنّك ترتّبها فقط لتناسبك

57
00:04:04,280 --> 00:04:05,200
!هذا تمامًا ما أريد سماعه

58
00:04:05,200 --> 00:04:07,440
.إن بدا أيّ شيء آخر مشبوهًا، فأخبروني

59
00:04:07,440 --> 00:04:08,890
...في الحقيقة

60
00:04:09,510 --> 00:04:13,380
سيكون نيك من سيواجه صعوبة أكثر
.بيننا في اختراق الخزنة هكذا

61
00:04:13,700 --> 00:04:17,770
.لأنّه سيكون عليّ تجاوزك للقيام بذلك

62
00:04:17,770 --> 00:04:20,300
ماذا عن محاولة اختراق الخزنة
بينما نكون جميعنا نيامًا؟

63
00:04:20,300 --> 00:04:22,260
!سآكل الكثير من الطّعام اللّذيذ

64
00:04:22,260 --> 00:04:24,220
!إنّها جاهزة تمامًا للسّرقة من الفرقة

65
00:04:25,630 --> 00:04:27,250
.أرى أنّك اخترت الحذر الشّديد

66
00:04:28,540 --> 00:04:32,000
تعلّمت خلال تجربتي مع أسياد الحرب

67
00:04:32,000 --> 00:04:34,950
أنّ جعل شخص ما مسؤولاً
."عن شيء ما لا يُعتبر "ثقة

68
00:04:34,950 --> 00:04:37,860
الثّقة" تعني أن يعترف الجميع"
.أنّ الشّخص الآخر لا يسعى لأذيّتهم

69
00:04:37,860 --> 00:04:41,000
.تخبرنا أن نثق ونشكّ في بعضنا في نفس الوقت

70
00:04:42,240 --> 00:04:44,730
.هـ-هذا صعب

71
00:04:45,210 --> 00:04:46,050
.كاران

72
00:04:47,710 --> 00:04:49,380
هل يمكنك أن تثقي بي؟

73
00:04:53,900 --> 00:04:57,360
.أعتقد أنّني أودّ ذلك

74
00:04:58,120 --> 00:04:59,000
...لكن

75
00:04:59,990 --> 00:05:04,650
.من الصّعب وضع الثّقة في أيّ أحد
.والشّكّ فيهم أصعب بكثير

76
00:05:05,540 --> 00:05:07,870
.وضع ثقتنا في أحد ما هو أسهل شيء على الإطلاق

77
00:05:07,870 --> 00:05:12,500
لأنّنا سنكون بذلك قد منحنا لشخص
.آخر زمام مصيرنا بطريقة ما

78
00:05:12,500 --> 00:05:13,590
.نعم

79
00:05:13,590 --> 00:05:16,160
.والقيام بذلك هو ما أوصلنا إلى هنا

80
00:05:16,160 --> 00:05:19,970
.لهذا السّبب علينا جميعًا أن نشكّ في بعضنا

81
00:05:23,030 --> 00:05:26,610
.لكن... أريد أن أثق في الجميع

82
00:05:28,750 --> 00:05:29,870
...ذلك

83
00:05:31,320 --> 00:05:33,090
.نشاركك نفس الشّعور

84
00:05:33,630 --> 00:05:36,250
.نريد أن نثق

85
00:05:40,620 --> 00:05:42,360
.قنوات الماء اللّزجة

86
00:05:42,360 --> 00:05:47,160
سنبدأ بمهمّة رتبتها جي، ما يعني
.أنّه مسموح لنا بدخول ثلاث متاهات

87
00:05:47,480 --> 00:05:52,920
نحتاج لدخول متاهتين منها وهزيمة
.الزّعماء هناك لنترقّى إلى الرّتبة إف

88
00:05:53,240 --> 00:05:55,900
.يبدو الأمر سهلاً حسب تفسيرك هذا

89
00:05:55,900 --> 00:05:57,920
.إنّه ليس صعبًا جدًّا في الواقع

90
00:05:57,920 --> 00:06:01,630
.إنّها بمثابة مناطق للتّدريب لنتعلّم كيف تسير الأمور

91
00:06:02,430 --> 00:06:05,910
.لكنّي وتيانا لم نخض معركة من قبل

92
00:06:06,130 --> 00:06:09,940
ولا أتخيّل أنّ ما تعلّمته
.في المدرسة سيكون مفيدًا هنا

93
00:06:09,940 --> 00:06:11,340
...صحيح

94
00:06:11,340 --> 00:06:14,050
...لا أتخيّل أن يُقتل شخص ما هنا

95
00:06:14,050 --> 00:06:17,120
.لا، أفترض أنّ ذلك ممكن إن سمحنا للغرور أن يتملّكنا

96
00:06:21,090 --> 00:06:22,060
.ها هو ذا

97
00:06:23,300 --> 00:06:24,440
ذاك؟

98
00:06:24,440 --> 00:06:28,110
.نعم، هذا هو فريسة النّاجون الأولى

99
00:06:28,110 --> 00:06:29,560
!هلام

100
00:06:29,560 --> 00:06:32,140
.إنّه أظرف ممّا توقّعت

101
00:06:32,140 --> 00:06:34,060
!إنّه يمضغ عشبًا

102
00:06:34,300 --> 00:06:35,760
هل هو لذيذ؟

103
00:06:35,760 --> 00:06:39,080
.قد يبدو مسالمًا، لكنّه يأكل أيّ شيء

104
00:06:39,360 --> 00:06:42,270
إن كبر حجمه كثيرًا، فسيقصد
.مزرعة ما ويبدأ بأكل الأبقار

105
00:06:42,270 --> 00:06:44,100
.سيكون ذلك مشكلة

106
00:06:44,100 --> 00:06:45,210
...ولكن

107
00:06:47,450 --> 00:06:49,730
يمكن هزيمة الكائنات الهلاميّة بسهولة
.عن طريق الإمساك بجوهرها

108
00:06:49,730 --> 00:06:54,190
.وهكذا سنحصل على مالنا
.لذا احرصوا ألاّ تتركوا أيًّا منها خلفكم

109
00:06:54,190 --> 00:06:56,140
!حسنًا يا معلّم نيك

110
00:07:00,930 --> 00:07:04,760
الانضمام لهذه الفرقة مخاطرة في نظرك، صحيح يا تيانا؟

111
00:07:04,760 --> 00:07:05,770
!مهلاً

112
00:07:05,770 --> 00:07:09,890
.يا معلّم نيك، يتدخّل زيم في هوايات أحدنا

113
00:07:09,890 --> 00:07:11,200
.هذا صحيح

114
00:07:12,260 --> 00:07:15,920
.ستندمون إن تحدّثتم بدل الانتباه

115
00:07:15,920 --> 00:07:17,250
.حاضرة يا معلّم

116
00:07:19,820 --> 00:07:23,390
.ربّما كنّا على حقّ بتشكيل فرقة معًا

117
00:07:24,740 --> 00:07:27,800
...ربّما إن كنت معهم، فيمكنني

118
00:07:30,330 --> 00:07:35,330
أعلم أنّها وحوش، لكن ما زلت أشعر
.أنّ من الخطأ سلب حياة كائن ما

119
00:07:35,330 --> 00:07:37,840
،لكن إن لم نتخلّص من الهواء الفاسد

120
00:07:37,840 --> 00:07:40,870
.فإنّ النّباتات والحيوانات العاديّة ستصير وحوشًا أيضًا

121
00:07:40,870 --> 00:07:44,120
،إن لم نتخلّص من الوحوش والهواء الفاسد

122
00:07:44,120 --> 00:07:45,860
.فستكبر المتاهة أكثر

123
00:07:46,360 --> 00:07:48,640
.واصل إقناع نفسك بذلك فحسب

124
00:07:48,640 --> 00:07:52,400
لكن لماذا تهاجم الوحوش النّاس؟

125
00:07:52,740 --> 00:07:56,790
ثمّة أبحاث مكثّفة عن محاولات
.التّواصل مع الوحوش

126
00:07:56,790 --> 00:07:59,660
.لكنّ كلّ الوحوش تهاجم النّاس بغضّ النّظر عن نوعها

127
00:07:59,660 --> 00:08:02,880
لذلك علينا أن نقاتلها؟

128
00:08:02,880 --> 00:08:04,720
.هذا محزن نوعًا ما

129
00:08:04,720 --> 00:08:05,540
.نعم

130
00:08:06,790 --> 00:08:09,080
.لا ترخي دفاعاتك فحسب

131
00:08:09,080 --> 00:08:10,810
،لكنّنا صعدنا بعض الطّوابق

132
00:08:10,810 --> 00:08:14,960
والتّغيير الوحيد الّتي رأيناه حتّى الآن
.هو وجود المزيد منها وأنّها صارت أسرع

133
00:08:15,310 --> 00:08:19,220
قد لا يبدو عليّ ذلك، لكنّني هزمت
.كائنات أورك وغوبلين من قبل

134
00:08:23,220 --> 00:08:26,660
،ستطلق الّتي على الأرض سوائل لزجة علينا

135
00:08:26,660 --> 00:08:30,190
وإن دُسنا عليها فسيكون لها نفس
.القوّة القاتلة لقشر الموز

136
00:08:30,190 --> 00:08:31,870
...كما قلتُ سابقًا

137
00:08:32,490 --> 00:08:34,190
.لا يجب أن نرخي دفاعاتنا

138
00:08:36,210 --> 00:08:37,320
.أعلم

139
00:08:37,890 --> 00:08:40,460
.لا يجب إرخاء دفاعاتنا. سلامتنا هي مسؤوليّتنا

140
00:08:40,460 --> 00:08:42,600
.كان هذا خطئي

141
00:08:42,600 --> 00:08:43,840
...هذا مؤلم

142
00:08:44,190 --> 00:08:44,910
...لكن

143
00:08:45,390 --> 00:08:47,500
!سأردّ لها الصّاع صاعين

144
00:08:47,500 --> 00:08:48,450
!مهلاً

145
00:08:48,700 --> 00:08:49,970
!رقصة الجليد

146
00:09:03,560 --> 00:09:07,230
...أ-أنت بخير

147
00:09:08,080 --> 00:09:09,480
صحيح؟

148
00:09:09,970 --> 00:09:15,070
،آسفة لأنّني أطلقت تعويذة كتلك
...لكن عليك أن تكوني حذرة أكثر

149
00:09:13,720 --> 00:09:15,530
!حاولت أن أثق بك

150
00:09:17,540 --> 00:09:20,270
!أردت أنّ أضع ثقتي فيك يا تيانا

151
00:09:23,450 --> 00:09:27,270
...ما-ماذا؟ أنا أحاول أيضًا

152
00:09:27,270 --> 00:09:28,640
...في المرّة القادمة

153
00:09:30,200 --> 00:09:32,470
.قد أكون أنا من تخطئ

154
00:09:37,600 --> 00:09:38,770
ماذا؟

155
00:09:39,350 --> 00:09:41,630
.كنتُ أحاول أن أثق بك أيضًا

156
00:09:52,430 --> 00:09:54,030
وصلنا إلى الطّابق الأعلى؟

157
00:09:54,490 --> 00:09:56,780
.سيعلّمنا كلّ ما حدث هنا شيئًا ما

158
00:09:56,780 --> 00:09:59,010
.لذلك علينا البقاء مركّزين حتّى النّهاية

159
00:10:12,180 --> 00:10:14,040
!نيك! نيك

160
00:10:14,040 --> 00:10:16,180
!ثمّة واحد كبير جدًّا أمامنا

161
00:10:16,180 --> 00:10:19,430
.إنّه هلام ضخم، زعيم القنوات المائيّة اللّزجة

162
00:10:19,430 --> 00:10:20,950
...لذلك هذا ما علينا

163
00:10:20,950 --> 00:10:22,060
تيانا؟

164
00:10:22,390 --> 00:10:25,390
!أستطيع تولّي أمره بنفسي

165
00:10:25,680 --> 00:10:28,800
.حسنًا، لا بأس كما أظنّ

166
00:10:29,690 --> 00:10:31,320
!رمح الجليد

167
00:10:39,440 --> 00:10:40,700
ما رأيكم؟

168
00:10:40,700 --> 00:10:42,070
!ابتعدي يا تيانا

169
00:10:58,150 --> 00:10:59,830
.لا يمكنني أن أثق بها

170
00:11:00,810 --> 00:11:02,800
ماذا؟ ماذا قلت؟

171
00:11:03,540 --> 00:11:07,840
لدى مخلوقات الهلام الضّخمة ردّة فعل
.للسّحر القويّ بإطلاق الهلام في كلّ مكان

172
00:11:08,290 --> 00:11:11,470
.كان بإمكاني فعل شيء ما لو أخبرتني

173
00:11:11,470 --> 00:11:15,670
وإن أخبرتني أيّ نوع من السّحر
.ستستعملين، لكنتُ قد نصحتك

174
00:11:16,280 --> 00:11:17,350
...وأنت يا زيم

175
00:11:17,900 --> 00:11:19,110
ماذا؟

176
00:11:19,110 --> 00:11:22,110
مكانك في المؤخّرة وليس الطّليعة، صحيح؟

177
00:11:22,360 --> 00:11:25,750
...شعرتُ بالسّوء لتواجدي في الخلف

178
00:11:25,750 --> 00:11:27,500
.لا، ذلك هو دورك

179
00:11:28,320 --> 00:11:31,410
أم ظننتَ أنّه سيكون من السّهل هزيمته بنفسك

180
00:11:31,410 --> 00:11:33,680
بدل الاعتماد على رفاقك في الفرقة؟

181
00:11:34,930 --> 00:11:35,640
.هذا صحيح

182
00:11:39,030 --> 00:11:40,410
.أعتقد أنّ هذا وقت مناسب

183
00:11:44,150 --> 00:11:45,710
.هذه هي كلّ أسلحتي

184
00:11:46,250 --> 00:11:49,720
أنا بارع في القتال غير المسلّح
.وقتال الخناجر والاستطلاع

185
00:11:49,980 --> 00:11:53,250
.كما أنّي بارع في استعمال الأغراض والتّسجيل

186
00:11:54,910 --> 00:11:56,970
.لا أعرف أيّ شيء عن السّحر

187
00:11:56,970 --> 00:11:59,230
.ولا يمكنني استعمال الأسلحة الثّقيلة

188
00:11:59,230 --> 00:12:01,720
.كما لا أجيد الخيمياء أو تعاويذ الشّفاء

189
00:12:03,030 --> 00:12:06,360
أهذه طريقتك لإظهار أسرارك لنا؟

190
00:12:07,520 --> 00:12:10,510
لا يمكن أن نثق بمن حولنا

191
00:12:10,510 --> 00:12:12,640
.لأنّنا نجهل ما هم قادرون عليه

192
00:12:12,640 --> 00:12:16,750
،أعتقد أنّنا إن فهمنا بعضنا جيّدًا
.قد نثق في بعضنا أكثر

193
00:12:17,300 --> 00:12:20,930
إذًا فعلينا جميعًا الكشف عن نقاط ضعفنا؟

194
00:12:21,760 --> 00:12:22,990
.لا

195
00:12:22,990 --> 00:12:25,110
أعلم أنّ لكم جميعًا أسبابًا قادتك
،للوضع الّذي أنتم فيه الآن

196
00:12:25,490 --> 00:12:28,550
.إن افترضنا أنّنا نصدّق قصص بعضنا

197
00:12:30,710 --> 00:12:32,450
الشّيء الوحيد المشترك بيننا جميعًا

198
00:12:32,450 --> 00:12:35,490
.هو أنّ هنالك من استغلّنا من أجل ما نبرع فيه

199
00:12:35,760 --> 00:12:37,630
.كان البعض يحسدنا على مهاراتنا

200
00:12:37,630 --> 00:12:39,980
.والبعض الآخر استغلّ ذلك لخداعنا

201
00:12:40,690 --> 00:12:42,950
،هكذا صرنا مخذولين

202
00:12:43,640 --> 00:12:46,330
.ذلك يجعلنا ننفر من كشف مهاراتنا الحقيقيّة

203
00:12:47,580 --> 00:12:50,200
.لذلك إن لم تريدوا إخبارنا
.فليس عليكم ذلك

204
00:12:51,090 --> 00:12:54,170
وقتنا معًا غير مؤكّد، لكن إن أردتم
،الحديث في مرحلة ما

205
00:12:54,580 --> 00:12:56,640
.فبإمكانكم ذلك وقتها

206
00:12:57,510 --> 00:13:01,030
:ولكن... هنالك أمر واحد أريدكم أن تقرّروه

207
00:13:01,030 --> 00:13:02,960
.ما تودّون تحقيقه من خلال هذه الفرقة

208
00:13:03,920 --> 00:13:06,190
...ما أودّ تحقيقه

209
00:13:09,380 --> 00:13:11,570
.أد أردتم هزيمتي، فالأمر سهل للغاية

210
00:13:11,960 --> 00:13:14,900
...السّيوف أو القبضات أو السّحر
.أنا ضعيف أمامها جميعها

211
00:13:14,900 --> 00:13:18,440
.لكن لا أنصح أن تأخذوا وقتكم في ذلك

212
00:13:18,440 --> 00:13:22,070
!لأنّ بإمكاني علاج الإصابات الصّغيرة بسحري

213
00:13:22,070 --> 00:13:24,740
.كفّ عن الكلام وكأنّ هنالك من يحاول قتلك

214
00:13:24,740 --> 00:13:26,130
.أعتذر

215
00:13:42,920 --> 00:13:44,330
.أنا ساحرة

216
00:13:44,980 --> 00:13:47,230
.أبرع أكثر في سحر عنصرَيْ الرّيح والماء

217
00:13:47,490 --> 00:13:50,340
.أستطيع أيضًا استعمال البرق كمزيج للعنصرين

218
00:13:50,340 --> 00:13:52,780
،أستطيع استعمال عنصر الأرض أيضًا
.لكنّي لست قويّة كثيرًا فيه

219
00:13:53,300 --> 00:13:55,710
.وأكاد لا أعرف استعمال سحر النّار على الإطلاق

220
00:13:58,640 --> 00:14:01,740
.أخفقت بشكل كبير هذا الصّباح

221
00:14:02,500 --> 00:14:03,870
.أنا آسفة

222
00:14:05,480 --> 00:14:10,730
،لا حيلة لديّ ضدّ هجمات الأرض والنّار
.إضافة للهجمات السّريعة وقريبة المدى

223
00:14:11,300 --> 00:14:13,290
لماذا تخبرينني بهذا؟

224
00:14:13,730 --> 00:14:16,230
.نعم، هذا صحيح

225
00:14:16,230 --> 00:14:19,000
.أنت بارعة باستعمال النّار والهجمات قريبة المدى

226
00:14:19,000 --> 00:14:20,200
وماذا في ذلك؟

227
00:14:20,200 --> 00:14:24,880
لا شيء، كنتُ أفكّر فقط أنّ عليّ
.البقاء صامتة. هذا كلّ شيء

228
00:14:55,090 --> 00:14:56,260
.شكرًا لك

229
00:14:57,990 --> 00:14:59,140
.هذا مؤسف

230
00:15:00,310 --> 00:15:04,560
.كنتُ أنوي حرقك بالكامل... لكنّي أخطأتك

231
00:15:06,720 --> 00:15:08,920
.لا تخطئي في المرّة القادمة

232
00:15:10,430 --> 00:15:13,650
وإلاّ فلن أستطيع أن أثق بك
.عندما تقاتلين في المعارك أمامي

233
00:15:16,900 --> 00:15:17,960
.دعي الأمر لي

234
00:15:21,300 --> 00:15:23,740
.حسنًا، هدفنا التّالي هو غابة الغوبلين

235
00:15:24,690 --> 00:15:27,160
.معظم الكائنات الّتي تعيش هنا هي الغوبلين

236
00:15:28,070 --> 00:15:31,630
،الغوبلين ضعيفة بمفردها
.لكنّها تقاتل في مجموعات

237
00:15:31,630 --> 00:15:33,570
.احرصوا ألاّ تدعوها تحاصرنا

238
00:15:37,550 --> 00:15:38,570
هل أنت بخير؟

239
00:15:40,400 --> 00:15:44,220
أعتقد أنّ هزيمة الوحوش الشّبيهة بالبشر
.ليس سهلاً بسهولة هزيمة الهلام

240
00:15:44,220 --> 00:15:46,580
،إنّها ذكيّة لدرجة معيّنة

241
00:15:46,580 --> 00:15:48,960
لذلك بإمكانها استعمال كلمات بسيطة
.للتّنظيم والهجوم بتشكيلات

242
00:15:51,180 --> 00:15:54,600
...لم أدرك كم أنّ نيك قويّ

243
00:15:54,850 --> 00:15:57,780
!ستكلّفك الدّردشة ثلاثة دينا

244
00:15:58,650 --> 00:16:00,010
!شكرًا لك

245
00:16:00,800 --> 00:16:03,110
.كانت تلك معظما في هذه المنطقة

246
00:16:04,230 --> 00:16:06,070
.سأتحقّق من المنطقة المحيطة بنا

247
00:16:06,070 --> 00:16:07,630
.حسنًا، بإمكاني تولّي ذلك

248
00:16:08,230 --> 00:16:09,810
!سحر الكشف

249
00:16:11,280 --> 00:16:14,990
ثمّة ما يقارب عشرة منها في الشّمال
...الشّرقيّ على بعد 500 متر

250
00:16:15,610 --> 00:16:16,780
.على ما أظنّ

251
00:16:17,180 --> 00:16:20,450
.إنّها منتشرة، لكنّ الأقرب منها هناك

252
00:16:21,190 --> 00:16:22,490
كيف يمكنك معرفة ذلك؟

253
00:16:22,740 --> 00:16:27,360
يستطيع سحر الكشف إيجاد أيّ آثار
.للسّحر داخل دائرة قطرها ثلاثة كيلومترات

254
00:16:27,720 --> 00:16:29,620
.أنت مذهلة

255
00:16:30,000 --> 00:16:34,380
لا يستطيع الكثير من النّاس كشف
.السّحر عبر تلك المساحة الواسعة

256
00:16:34,380 --> 00:16:37,130
.لكنّي تعلّمت أنّه لا يمكننا أن نثق بنيك

257
00:16:37,930 --> 00:16:39,590
.هذا صحيح

258
00:16:39,590 --> 00:16:41,270
لماذا؟

259
00:16:41,270 --> 00:16:45,270
،عندما أخبرتنا بمهاراتك
.لم تذكر أنّ بإمكانك القتال هكذا

260
00:16:45,270 --> 00:16:49,330
يبدو أنّ لديك مشكلة كبيرة
.في قدرتك على تقدير نفسك

261
00:16:49,330 --> 00:16:50,940
!هذا صحيح

262
00:16:50,940 --> 00:16:53,340
!كنتَ قويًّا جدًّا وبالكاد تسنّى لي فعل أيّ شيء

263
00:16:53,340 --> 00:16:56,340
.كما أنّي تشاركت نقطة ضعفي معكم كالأحمق

264
00:16:56,340 --> 00:16:58,500
...أعني أنّني كنت

265
00:16:58,500 --> 00:16:59,640
ماذا؟

266
00:17:00,120 --> 00:17:00,910
ما الخطب؟

267
00:17:01,350 --> 00:17:05,040
.يملك أحدها سحرًا أكبر بكثير لأن يكون لغوبلين

268
00:17:05,360 --> 00:17:07,130
.أكثر بخمسة أضعاف من المعتاد

269
00:17:07,130 --> 00:17:09,230
.هذا سيّئ

270
00:17:09,230 --> 00:17:11,110
هل من أفكار عمّا قد يكون؟

271
00:17:11,110 --> 00:17:13,030
.لا بدّ أنّه غول

272
00:17:13,670 --> 00:17:17,850
إنّه نسخة متطوّرة عن الهوبغوبلين
.تملك قوّة أكثر بكثير

273
00:17:17,850 --> 00:17:20,040
صعب حتّى عليك أنت؟

274
00:17:20,040 --> 00:17:24,340
حتى إن عملنا معًا، إن لم نكن
.حذرين... تعرفون الباقي

275
00:17:24,930 --> 00:17:27,800
.ليست لدينا خبرة بما يكفي للعمل معًا كفريق

276
00:17:29,760 --> 00:17:32,220
ماذا نفعل إذًا؟ هل ننسحب؟

277
00:17:33,040 --> 00:17:35,120
.لا، ذلك ليس خيارًا

278
00:17:35,120 --> 00:17:37,000
،إن لم نوقفه هنا

279
00:17:37,000 --> 00:17:40,300
ستمتصّ المجموعة الآخرين حولها

280
00:17:40,300 --> 00:17:43,360
وستبدأ أخيرًا في مهاجمة البشر
.الّذين يعيشون على مقربة

281
00:17:43,810 --> 00:17:47,420
.والأهمّ من أيّ شيء... قيمته كبيرة

282
00:17:48,480 --> 00:17:50,210
...أكره قول هذا، ولكن نعم

283
00:17:50,720 --> 00:17:54,590
الغيلان مقاوِمة كثيرًا للسّحر، صحيح؟

284
00:17:55,060 --> 00:17:57,900
.لن أتمكّن من فعل الكثير سوى تشتيت انتباهه

285
00:17:57,900 --> 00:18:01,480
.وفي النّهاية، سيكون علينا أنا وكاران التّعامل معه

286
00:18:02,560 --> 00:18:04,590
.الخطّة بسيطة

287
00:18:04,590 --> 00:18:06,640
،ستستعمل تيانا التّعاويذ لتشتيت انتباهه

288
00:18:06,640 --> 00:18:08,560
،وسيعزّزنا زيم بسحره

289
00:18:08,560 --> 00:18:10,480
.بينما أنا وكاران نهاجمه

290
00:18:10,480 --> 00:18:14,380
،لكن إن كنّا سنخترق جلد الغول السّميك

291
00:18:14,380 --> 00:18:17,570
.فسنحتاج لقوّتك الهجوميّة يا كاران

292
00:18:25,770 --> 00:18:28,110
.لا داعي للقلق. أنا بخير

293
00:18:28,790 --> 00:18:31,050
.حسنًا، هيّا بنا

294
00:18:36,120 --> 00:18:37,310
.تيانا

295
00:18:38,860 --> 00:18:41,750
.ما زلت لا أثق بك بالكامل

296
00:18:42,010 --> 00:18:45,940
.أريد ذلك، لكنّي أجهل إن كنت أستطيع

297
00:18:48,450 --> 00:18:49,970
.لا داعي للقلق

298
00:18:51,360 --> 00:18:53,090
...ذلك صحيح في حالتي أيضًا

299
00:18:53,090 --> 00:18:57,520
.لا، بل في حالة الجميع هنا

300
00:19:00,880 --> 00:19:03,450
.نفكّر جميعًا بذلك

301
00:19:03,450 --> 00:19:08,650
.نجهل إن كنّا نستطيع أن نثق ببعضنا... لكنّنا نريد ذلك

302
00:19:10,900 --> 00:19:12,220
.ها هو قادم

303
00:19:12,740 --> 00:19:15,490
.هيّا. وظهرك نحوي

304
00:19:15,490 --> 00:19:17,210
أيمكنك ذلك؟

305
00:19:17,880 --> 00:19:18,680
...نعم

306
00:19:20,890 --> 00:19:22,810
!يمكنني فعل ذلك القدر

307
00:19:23,050 --> 00:19:24,030
!هيّا بنا

308
00:19:24,960 --> 00:19:27,170
!حصن منيع! القوّة الحديديّة

309
00:19:29,350 --> 00:19:30,500
!رقصة الجليد

310
00:19:41,140 --> 00:19:44,190
!لا تغتروّا بأنفسكم أيّها البشر

311
00:19:44,500 --> 00:19:45,860
!هجوم

312
00:19:47,710 --> 00:19:48,710
...ما أودّ تحقيقه

313
00:19:49,630 --> 00:19:52,510
...ما أودّ تحقيق من هذه الفرقة

314
00:19:52,510 --> 00:19:54,700
!عرفتُ ذلك من البداية

315
00:19:55,710 --> 00:19:58,660
!أريد أن أثق بالجميع

316
00:20:00,100 --> 00:20:05,140
.إنّها تعتذر بدل إلقاء اللّوم عليّ لتقدّمي للأمام

317
00:20:05,460 --> 00:20:07,140
!إنّها شخص نبيل

318
00:20:07,610 --> 00:20:11,800
!على الأرجح أنّها لم تضطرّ للاعتذار لأيّ أحد من قبل

319
00:20:12,350 --> 00:20:13,840
!لن أنظر خلفي

320
00:20:14,610 --> 00:20:18,220
!سأضع ثقتي! سأضع ثقتي حتّى النّهاية

321
00:20:28,520 --> 00:20:29,490
...سوف

322
00:20:31,240 --> 00:20:33,940
!أثق وأثق وأثق وأثق

323
00:20:34,740 --> 00:20:36,260
!ضربة تنّين النّار

324
00:20:50,920 --> 00:20:52,980
!ما رأيك؟ نجحت

325
00:20:52,980 --> 00:20:56,020
أرأيت؟ كانت إدارة ظهري لتيانا سهلاً
!مثل أكل الهابّونياكي

326
00:20:56,690 --> 00:21:00,280
ماذا؟ قد لا يكون هذا الفرصة الوحيدة
.الّتي تتسنّى لي لمهاجمتك

327
00:21:00,810 --> 00:21:02,450
فعلاً؟

328
00:21:02,870 --> 00:21:04,200
!لن أسمح لك بهزيمتي

329
00:21:04,200 --> 00:21:06,220
.أتطلّعُ قدمًا لذلك

330
00:21:06,990 --> 00:21:09,920
ألا تحبّان بعضهما؟

331
00:21:11,800 --> 00:21:12,950
.ربّما لا

332
00:21:21,470 --> 00:21:23,060
أتريدون المساعدة؟

333
00:21:23,830 --> 00:21:27,550
.لا أتدخّل في الهوايات الشّخصيّة للآخرين

334
00:21:27,550 --> 00:21:29,940
!لا أقوم بهذا لأنّها هوايتي

335
00:21:29,940 --> 00:21:32,560
.علينا ذلك إن أردنا أن نقبض المال

336
00:21:33,190 --> 00:21:35,360
.عمل المغامر صعب

337
00:21:35,360 --> 00:21:37,000
.يصير أسهل بعد أن تعتادي عليه

338
00:21:42,320 --> 00:21:44,760
.ليس عليك تعلّم أيّ شيء يا كاران

339
00:21:46,100 --> 00:21:49,670
.لم يعلّموني أيّ شيء آخر مرّة

340
00:21:50,030 --> 00:21:51,590
.كان ذلك وشيكًا

341
00:21:51,590 --> 00:21:53,490
.كان هذا في حالة تطوّر

342
00:21:53,490 --> 00:21:55,950
.لو واجهنا غولاً آخر، لكنا الوضع سيّئًا

343
00:21:57,700 --> 00:21:59,100
!إنّه غالق

344
00:22:00,620 --> 00:22:01,510
!سُحقًا

345
00:22:04,210 --> 00:22:06,060
آسف، هل أنت بخير؟

346
00:22:06,370 --> 00:22:08,100
...نـ-نعم

347
00:22:10,250 --> 00:22:11,350
كسر"؟"

348
00:23:36,400 --> 00:23:39,090
."الحلقة القادمة: "سرّ كاران