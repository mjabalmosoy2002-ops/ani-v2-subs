1
00:00:04,200 --> 00:00:06,970
،بعد معركتهم مع الرّجل القافز

2
00:00:06,970 --> 00:00:10,420
.قضى النّاجون وقتًا طويلاً في أسرّتهم

3
00:00:11,080 --> 00:00:13,760
،إضافة للضّرر الجسديّ الّذي تكبّدون

4
00:00:13,760 --> 00:00:16,440
.كانت عقولهم مشغولة كثيرًا بالتّفكير أيضًا

5
00:00:17,950 --> 00:00:21,250
،في كلّ مرّة لا يوجد فيها ما يشغل بالهم

6
00:00:21,250 --> 00:00:22,970
.يبدأ البشر بالتّفكير في أمور عدّة

7
00:00:23,430 --> 00:00:28,130
يفكّرون بشأن أمور كانوا مشغولين
.جدًّا عن التّفكير بها

8
00:00:28,130 --> 00:00:30,860
.الأشياء الّتي حاولوا ألاّ يفكّروا بها

9
00:00:33,640 --> 00:00:35,330
...إنّ البشريّة

10
00:00:48,520 --> 00:00:51,020
ما المدينة الّتي سنذهب إليها تاليًا يا أبي؟

11
00:00:52,580 --> 00:00:54,650
.سنعود إلى مدينة المتاهة لأوّل مرّة منذ مدّة

12
00:00:55,430 --> 00:00:58,150
تتذكّر العمّ أرغاس، صحيح؟

13
00:00:58,150 --> 00:01:00,250
!ربّت على رأسي مرّة

14
00:01:00,250 --> 00:01:01,620
هل سأراه ثانية؟

15
00:01:06,090 --> 00:01:07,670
ما الأمر يا أبي؟

16
00:01:16,120 --> 00:01:18,550
.أبوك وأمّك يحبّانك كثيرًا

17
00:01:18,860 --> 00:01:20,300
أمّي؟

18
00:01:23,850 --> 00:01:26,080
!أنقذتنا يا أرغاس

19
00:01:26,880 --> 00:01:28,980
لـ-لماذا؟

20
00:02:19,280 --> 00:02:20,680
.أنا آسف

21
00:02:24,330 --> 00:02:25,980
.قنوات الماء اللّزجة

22
00:02:25,980 --> 00:02:29,510
.هذه هي بداية كلّ مغامر متدنّي الرّتبة

23
00:02:29,920 --> 00:02:33,070
،سأصير مغامرًا بدءًا من اليوم
صحيح يا سيّد أرغاس؟

24
00:02:33,070 --> 00:02:37,500
.نعم. وبما أنّك مغامر الآن، لا داعي لمناداتي بسيّد

25
00:02:37,720 --> 00:02:41,580
.كلّ المغامرين سواسية. اسمع يا نيك

26
00:02:41,580 --> 00:02:45,390
!على المغامرين أن يثقوا ببعضهم

27
00:02:44,740 --> 00:02:46,530
!إنّه يمضغ العشب

28
00:02:46,530 --> 00:02:47,770
هل هو لذيذ؟

29
00:02:48,810 --> 00:02:51,600
.لا ترخي دفاعاتك وإلاّ ندمت على ذلك

30
00:02:51,600 --> 00:02:53,580
!مفهوم يا سيّد أرغاس

31
00:02:56,480 --> 00:02:59,020
.هذا ما كنت أعنيه

32
00:03:10,720 --> 00:03:13,840
جزء من السّبب الّذي دفعني لأصير
.مغامرًا هو جني قوت يومي

33
00:03:13,840 --> 00:03:16,810
لكنّ السّبب الرّئيسيّ هو اعتقادي
،أنّني لو كنت أقوى

34
00:03:16,810 --> 00:03:20,480
.لتمكّنت من القتال إلى جانبي والداي

35
00:03:23,600 --> 00:03:27,440
أعطاني أرغاس سيفًا قصيرًا عندما
.انضممت لأسياد الحرب

36
00:03:36,240 --> 00:03:39,050
ما أسعدني أكثر من أيّ شيء آخر هو أنّه اختاره

37
00:03:39,050 --> 00:03:40,750
.لأنّه اعتقد أنّه سيساعدني للتّعلّم

38
00:03:44,180 --> 00:03:46,340
.كلّ ذلك في الماضي الآن

39
00:03:46,340 --> 00:03:50,180
.امتصصت الماضي وجعلته جزءًا منّي

40
00:03:51,210 --> 00:03:54,730
.ولكنّي أحيانًا أنظر إليه بندم

41
00:03:55,590 --> 00:03:59,690
لو أنّي فعلتُ شيئًا من بشكل
...مختلف في مرّة أو أخرى

42
00:04:00,460 --> 00:04:06,180
،لو أنّي أعطيت أرغاس جوابًا مختلفًا
فهل كنت سأظلّ مع أسياد الحرب؟

43
00:04:07,540 --> 00:04:13,460
لو لم أهرب وقتها، هل كنت
قادرًا على الموت مع والداي؟

44
00:04:14,540 --> 00:04:16,760
...لو أنّي وقتها

45
00:04:44,960 --> 00:04:46,120
أغيت؟

46
00:04:51,520 --> 00:04:53,570
ما الّذي تفعله أغيت هنا؟

47
00:04:55,490 --> 00:04:58,580
وماذا يمكنني القول عن نفسي
بما أنّي تعرّفت عليها من الخلف فحسب؟

48
00:04:59,780 --> 00:05:03,830
.هذا سيّئ... يبدو أنّها ستمطر لمدّة

49
00:05:05,580 --> 00:05:07,900
.كنت أتساءل كيف سأعيد هذه لك

50
00:05:08,660 --> 00:05:11,900
...إنّها لي

51
00:05:17,140 --> 00:05:20,650
...ما يعني أنّك... عفوًا

52
00:05:21,150 --> 00:05:24,380
.لم تخبرني عن اسمك

53
00:05:24,380 --> 00:05:25,420
...أنا

54
00:05:26,660 --> 00:05:28,860
.مجرّد كلب شارد يحبّ معبودي الجماهير

55
00:05:29,620 --> 00:05:31,060
فعلاً؟

56
00:05:31,600 --> 00:05:35,430
.في تلك الحالة، أنا مجرّد معبودة جماهير اسمها أغيت

57
00:05:37,340 --> 00:05:39,450
كانت تمطر يومها أيضًا، صحيح؟

58
00:05:39,790 --> 00:05:40,530
...نعم

59
00:05:41,030 --> 00:05:45,300
،كنتَ هنا تحت المطر بدون مظلّة

60
00:05:45,300 --> 00:05:48,180
.لذلك لم يسعني سوى الحديث معك

61
00:05:48,180 --> 00:05:51,510
!أنا مسرورة لمعرفتي أنّ لك منزلاً

62
00:05:52,350 --> 00:05:55,960
...صحيح، هنالك فتاة من وكالتي قد

63
00:05:54,550 --> 00:05:58,970
المعذرة، هل ستواصلين الحديث
هكذا لوقت طويل؟

64
00:05:59,500 --> 00:06:01,510
هل أزعجك هذا؟

65
00:06:01,510 --> 00:06:04,710
...لا، لم يزعجني ولكن

66
00:06:04,710 --> 00:06:06,870
.دعني أتحدّث قليلاً بعد إذًا

67
00:06:07,410 --> 00:06:08,570
.حسنًا، حسنًا

68
00:06:11,610 --> 00:06:16,440
.ربّما ذلك اليوم هو ما أنقذني

69
00:06:16,440 --> 00:06:18,350
هل قلتِ شيئًا ما؟

70
00:06:18,350 --> 00:06:19,590
.لا، لا

71
00:06:19,590 --> 00:06:24,400
هل تسمع أمورًا غير موجودة أحيانًا أيّها الكلب الشّارد؟

72
00:06:24,730 --> 00:06:25,700
.اخرسي

73
00:06:32,060 --> 00:06:32,930
.أخبريني

74
00:06:34,450 --> 00:06:35,410
لماذا ما زلتُ أمسكها؟

75
00:06:37,000 --> 00:06:38,660
.حتّى يتوقّف المطر

76
00:06:55,420 --> 00:06:56,610
.سيفي هذا بالغرض

77
00:07:00,290 --> 00:07:03,720
هل أنت من قتل الطّبيب نالغافا؟

78
00:07:07,070 --> 00:07:08,040
.نعم

79
00:07:09,080 --> 00:07:10,260
.هذا صحيح

80
00:07:10,670 --> 00:07:12,060
!عرفتُ ذلك

81
00:07:12,060 --> 00:07:13,430
!ما يعني أنّني فزت

82
00:07:13,430 --> 00:07:17,630
!عرفتُ ذلك! قتلته لتأخذ مكانه

83
00:07:18,240 --> 00:07:20,230
...هذا مؤلم

84
00:07:20,230 --> 00:07:23,310
.لا تحتاج للمراهنة بعد كسرك لثلاثة أضلاع

85
00:07:23,710 --> 00:07:25,540
.أنت لا تفهم يا طبيب

86
00:07:25,800 --> 00:07:29,180
!كنتُ سأفقد ثلاثة أخرى لو أنّي خسرت

87
00:07:29,690 --> 00:07:31,750
أيعني هذا أنّ ثلاثة أضلاع أخرى
ستنمو لك بما أنّك فزت؟

88
00:07:36,280 --> 00:07:38,610
.ذلك مستحيل

89
00:07:38,610 --> 00:07:40,800
!أنا قلق بشأن طبيبنا الجديد

90
00:07:44,510 --> 00:07:45,800
.الطّبّ أمر مذهل

91
00:07:46,660 --> 00:07:50,000
.يمكّننا من مساعدة الآخرين ولو قليلاً

92
00:07:50,000 --> 00:07:53,710
كما لا نضطرّ للتّفكير بشأن أمور
.أخرى بما أنّنا نساعد الآخرين

93
00:07:54,790 --> 00:07:59,530
وبشكل غريب، حتّى بعد كلّ الأمور
،الفظيعة الّتي فعلها

94
00:08:00,290 --> 00:08:04,730
.لا أستطيع حمل نفسي على كره الرّجل القافز... نالغافا

95
00:08:05,960 --> 00:08:12,250
،ربّما أخذت مكانه كطريقة لأحزن عليه
.أو ربّما أقوم بذلك لأجل نفسي فحسب

96
00:08:13,470 --> 00:08:16,410
.ربّما هما نفس الشّيء في الحقيقة

97
00:08:16,980 --> 00:08:18,250
...أنّني فقط

98
00:08:18,700 --> 00:08:20,080
...أيّها الطّبيب

99
00:08:22,020 --> 00:08:23,750
.شكرًا لك

100
00:08:31,100 --> 00:08:31,900
.العفو

101
00:08:39,560 --> 00:08:43,440
.كنتُ أستيقظ مرارًا وتكرارًا

102
00:08:56,560 --> 00:09:01,080
إنّ الوعد بخلاص صغير يجعلني
...أعاني مرّة أخرى

103
00:09:02,080 --> 00:09:03,470
لكن هل ذلك صحيح؟

104
00:09:04,070 --> 00:09:08,040
هل الحياة قاسية هكذا؟

105
00:09:08,620 --> 00:09:13,560
ألا يوجد فعلاً خلاص في التّقدّم للأمام كلّ يوم

106
00:09:14,040 --> 00:09:16,250
حتّى إن كان ذلك التّقدّم صغيرًا جدًّا؟

107
00:09:21,900 --> 00:09:26,320
لا يجب أن تكون المقامرة شيئًا عليك
.القيام به إلاّ إن شعرت أنّك ستفوز

108
00:09:26,750 --> 00:09:30,550
،لكن حتّى إن شعرتُ أنّني لا أريد المجيء
.لا أزال أريد استعادة حياتي اليوميّة

109
00:09:30,550 --> 00:09:32,500
لذلك أقضي أيّامي في محاكاة الحياة
.الّتي كنتُ أعيشها من قبل

110
00:09:33,920 --> 00:09:36,190
.أنا فتاة محظوظة لتنكّني من ذلك

111
00:09:37,480 --> 00:09:39,110
.لا مشكلة لديّ مع الحياة الآن

112
00:09:39,630 --> 00:09:46,020
.لا احد يكذب عليّ أو يحاول النّيل منّي حاليًّا

113
00:09:46,020 --> 00:09:47,640
.كلّ شيء بخير

114
00:09:48,250 --> 00:09:50,120
لماذا قد تكون لي مشكلة بذلك؟

115
00:09:53,250 --> 00:09:54,500
.لقد فزت

116
00:09:55,410 --> 00:09:58,190
.أواصل الفوز والخسارة. لم أكسب أو أخسر المال

117
00:10:00,150 --> 00:10:01,130
...لكن

118
00:10:02,250 --> 00:10:03,440
.أشعر بالملل

119
00:10:10,260 --> 00:10:11,420
.لذيذ

120
00:10:12,140 --> 00:10:14,450
.أتساءل إن كانت كاران ستأكل هذا

121
00:10:19,340 --> 00:10:22,750
!صباح الخير

122
00:10:22,750 --> 00:10:24,590
.مرحبًا، لم نلتق منذ مدّة

123
00:10:25,830 --> 00:10:27,110
...يا رفاق

124
00:10:29,160 --> 00:10:32,090
هـ-هل جميعكم بخير؟

125
00:10:32,090 --> 00:10:33,500
.نوعًا ما

126
00:10:39,230 --> 00:10:41,640
ما زلت تقوم بذلك؟

127
00:10:44,140 --> 00:10:47,190
وافقنا على عدم التّدخّل في حياة
بعضنا الخاصّة، صحيح؟

128
00:10:47,700 --> 00:10:51,240
.صـ-صحيح، معك حقّ

129
00:10:53,810 --> 00:10:58,200
.ما وقع في حادثة الرّجل القافز كان محزنًا

130
00:10:58,200 --> 00:11:00,500
.لكنّه انتهى كما وجب أن ينتهي

131
00:11:01,660 --> 00:11:06,630
،علينا أن نتقبّل الحياة الّتي نعيشها الآن
.حيث لا نفتقر لأيّ شيء

132
00:11:08,270 --> 00:11:12,280
.يبدو الجميع بعيدًا عن الآخر الآن

133
00:11:12,520 --> 00:11:17,090
يشعر الجميع انّهم يصارعون شيئًا ما
.لا يمكنهم تحديد طبيعته

134
00:11:29,600 --> 00:11:32,700
.قانون النّاجون الأوّل

135
00:11:33,260 --> 00:11:35,950
.عدم التّدخّل في هوايات الآخرين

136
00:11:37,010 --> 00:11:39,300
.لن يشكّل أيّ شيء ستقوله أيّ فرق

137
00:11:40,470 --> 00:11:45,130
...إن أردت ذلك، أستطيع أخذك و

138
00:11:46,270 --> 00:11:47,880
.ذلك صحيح

139
00:11:49,090 --> 00:11:52,250
إن كنت تريد أن تكون طبيبًا
...في مكان خطير كهذا

140
00:11:57,120 --> 00:12:00,720
.فستحتاج لقوّتي

141
00:12:01,200 --> 00:12:03,000
.اعتبرني حارسك الخاصّ

142
00:12:04,710 --> 00:12:06,180
.شكرًا لك

143
00:12:08,420 --> 00:12:11,680
!صباح الخير

144
00:12:11,680 --> 00:12:14,840
!هذا آخر إصدار لمجلّة ليموريا الشّهريّة

145
00:12:15,230 --> 00:12:17,490
.ما زالت أوليفيا على حالها

146
00:12:17,490 --> 00:12:18,550
...لنر ما فيها

147
00:12:18,550 --> 00:12:22,170
".أكثر 100 غريب أطوار في مدينة المتاهة"

148
00:12:22,620 --> 00:12:24,190
...هل أنتم

149
00:12:27,700 --> 00:12:29,890
هل تناولتم الإفطار بعد؟

150
00:12:31,070 --> 00:12:33,400
...ماذا؟ نعم

151
00:12:34,080 --> 00:12:38,430
،اخترتُ باقة اللّيلة الكاملة
.لذلك أكلتُ القليل في محلّ ريد

152
00:12:38,690 --> 00:12:40,310
.أنا أدخّن فقط في الصّباح

153
00:12:41,850 --> 00:12:43,240
.فهمت

154
00:12:43,240 --> 00:12:46,080
.ربّما سأذهب لأكل شيء ما إذًا

155
00:12:55,620 --> 00:12:59,080
هل تمكّن الجميع من النّسيان بالفعل؟

156
00:13:00,240 --> 00:13:01,810
.أنا لا أستطيع

157
00:13:03,090 --> 00:13:06,460
...كاليوس... قائد فرقتي السّابقة

158
00:13:07,280 --> 00:13:10,790
.الرّجل الّذي أقسمت بالولاء له

159
00:13:12,060 --> 00:13:17,300
.خدعني وتخلّى عنّي... سلبني كلّ ما أملك

160
00:13:18,420 --> 00:13:23,680
حتّى إن كذبوا عليّ، كانت أيّامي
.كمغامِرة مع البلشون الأبيض ممتعة

161
00:13:24,380 --> 00:13:26,900
،لكنّي... لن أسامح كاليوس أبدًا

162
00:13:26,900 --> 00:13:30,730
،الرّجل الّذي سرق جوهرة ملك التّنانين
.فخر عشيرتنا

163
00:13:30,730 --> 00:13:33,120
.لم يمرّ يوم واحد لم أنسه فيه

164
00:13:33,670 --> 00:13:37,380
!أنت نمريّة! عليك أن تكوني حذرة

165
00:13:37,380 --> 00:13:40,580
!لكنّني لم أفعل أيّ شيء

166
00:13:40,580 --> 00:13:45,210
.لا بأس أن تكوني متهوّرة أحيانًا
.لكنّ الكذب ليس جيّدًا

167
00:13:45,210 --> 00:13:47,660
...لكنّي فعلاً لم

168
00:13:47,660 --> 00:13:50,520
،يبدو أنّك خرجتِ للتّوّ من الغابة"

169
00:13:51,550 --> 00:13:54,690
،لكن هنا في مدينة المتاهة
.نأخذ هذه الأمور على محمل الجدّ

170
00:13:56,420 --> 00:14:00,200
"...سأنسى الأمر إن اشتريتِها بنصف الثّمن

171
00:14:00,200 --> 00:14:02,150
...أ-أنت

172
00:14:02,420 --> 00:14:05,280
أتريد أن ترى ما سيحدث إن خدشت تلك القلادة؟

173
00:14:13,000 --> 00:14:13,960
.كاران

174
00:14:17,700 --> 00:14:20,370
ماذا؟ إلى أين ستذهبون جميعًا؟

175
00:14:20,370 --> 00:14:23,030
.سمعنا أنّ تجهيزات مهرجان غفوة الصّيف بدأت

176
00:14:23,030 --> 00:14:24,810
.لذلك سنذهب لإلقاء نظرة

177
00:14:25,240 --> 00:14:26,800
مهرجان غفوة الصّيف؟

178
00:14:27,220 --> 00:14:30,090
.هذا صحيح، مهرجان غفوة الصّيف

179
00:14:30,090 --> 00:14:34,660
يقال أنّ كلّ الوحوش تهدأ
.في مثل هذا الوقت من السّنة

180
00:14:36,680 --> 00:14:38,760
هل ستكون هنالك أطعمة؟

181
00:14:38,760 --> 00:14:40,430
.أظنّ ذلك

182
00:14:41,190 --> 00:14:42,180
!لا أطيق الانتظار إذًا

183
00:14:43,720 --> 00:14:48,480
هل سيختفي ذلك الغضب القويّ يومًا ما؟

184
00:14:48,880 --> 00:14:52,110
هل سيكون أمرًا جيّدًا أم سيّئًا إن حدث ذلك؟

185
00:14:52,540 --> 00:14:53,840
.لا أدري

186
00:14:54,110 --> 00:14:58,210
،كلّما اهتممنا بشأن بالحاضر
.بعُد عنّا الماضي أكثر

187
00:14:59,060 --> 00:15:03,040
ربّما يفترض بنا أن نهتمّ بالأشياء
الّتي تبقى فحسب؟

188
00:15:03,840 --> 00:15:08,070
إن صحّ ذلك، ربّما أريد فقط
.أن تبقى الأشياء الّتي أحبّ

189
00:15:11,870 --> 00:15:14,890
.التنّينيّون عرق فخور ولهم قدَر يتّبعونه

190
00:15:15,220 --> 00:15:19,590
قدرهم هو خدمة البشريّ الّذي
.سيصير البطل الّذي سينقذ العالم

191
00:15:20,660 --> 00:15:25,030
.أنا تنّينيّة. ابنة قائد عشيرة تسوباكي

192
00:15:25,030 --> 00:15:26,470
!كاران تسوباكي

193
00:15:27,400 --> 00:15:31,350
!محاربة تنّينيّة تحميه نعمة تنّين النّار

194
00:15:32,810 --> 00:15:34,700
!أخبار مهمّة

195
00:15:34,700 --> 00:15:37,360
!أخبار مهمّة! أخبار مهمّة

196
00:15:38,870 --> 00:15:40,150
أوليفيا؟

197
00:15:40,150 --> 00:15:44,010
!أخبار مهمّة! إصدار إضافيّ! اقرؤوه

198
00:15:44,010 --> 00:15:47,980
!إصدار إضافيّ خاصّ  لمجلّة ليموريا الشّهريّة

199
00:15:47,980 --> 00:15:49,550
ما كلّ هذا يا أوليفيا؟

200
00:15:49,550 --> 00:15:53,390
.أخبار مهمّة يا رفاق. أخبار مهمّة للغاية

201
00:15:53,390 --> 00:15:54,930
.تبدو أخبار مهمّة بالفعل

202
00:15:54,930 --> 00:15:56,220
!إنّها مهمّة بالفعل

203
00:15:56,730 --> 00:15:58,760
ماذا يحدث؟

204
00:15:58,760 --> 00:16:01,030
!هذا ليس وقتًا مناسبًا للبقاء هادئين

205
00:16:01,030 --> 00:16:03,900
.تحمّسوا وإلاّ فلن أخبركم

206
00:16:03,900 --> 00:16:05,260
!ما-ما-ماذا؟

207
00:16:05,260 --> 00:16:07,910
ما الّذي يحدث؟

208
00:16:07,910 --> 00:16:09,870
.حيّد، جيّد

209
00:16:09,870 --> 00:16:12,940
لا أحبّ الأشخاص الّذين يحاولون
.التّلاعب بعواطف الآخرين

210
00:16:12,940 --> 00:16:16,480
!ثمّة قصّة صادمة تحدث في هذه الأثناء

211
00:16:16,480 --> 00:16:22,220
ما هذا؟ "إله شياطين مظلم أسطوريّ
على وشك العودة للحياة"؟

212
00:16:22,470 --> 00:16:23,940
تقول الشّائعات"؟"

213
00:16:23,940 --> 00:16:26,590
.مهلاً، لا تسرقي أخباري المهمّة

214
00:16:26,590 --> 00:16:29,010
.أنت من توزّعين هذه المنشورات في كلّ مكان

215
00:16:29,010 --> 00:16:30,590
المزيد من الأخبار الزّائفة؟

216
00:16:31,000 --> 00:16:35,840
.لن يصدّقك أيّ أحد إن واصلتِ نشر الأكاذيب

217
00:16:35,840 --> 00:16:40,270
.لكنّ مصدر هذا الخبر موثوق به هذه المرّة

218
00:16:40,270 --> 00:16:42,230
ماذا؟ فعلاً؟

219
00:16:42,230 --> 00:16:44,710
.أرى أنّ كيزونا ذكيّ بما يكفي لمعرفة ما معنى هذا

220
00:16:44,710 --> 00:16:45,850
!صحيح

221
00:16:45,850 --> 00:16:47,350
.هذا يعني أنّها تختلق الأمور فحسب

222
00:16:49,330 --> 00:16:51,870
ماذا إن قلتُ أنّ القناع الأبيض له علاقة بالأمل؟

223
00:16:51,870 --> 00:16:53,160
أأنت جادّة؟

224
00:16:53,160 --> 00:16:55,500
...لستُ متأكّدة تمامًا بعد

225
00:16:57,210 --> 00:16:59,750
لكن ماذا إن قلتُ أنّي حدّدت مكان السّوق السّوداء

226
00:16:59,750 --> 00:17:02,200
حيث كانت تُباع جواهر ملك الوهم؟

227
00:17:02,620 --> 00:17:03,850
فعلاً؟

228
00:17:03,850 --> 00:17:05,000
.ليس بعد

229
00:17:06,560 --> 00:17:07,830
!العفو

230
00:17:07,830 --> 00:17:11,410
لم أجده بعد، لكن يقتضي عملي تتبّع
الأشياء الّتي تبدو مريبة

231
00:17:11,410 --> 00:17:14,360
.وجمعها لإنشاء مقالة إخباريّة مذهلة

232
00:17:14,360 --> 00:17:16,750
.لا تُعتبر أخبارًا إن قمت باختلاقها

233
00:17:16,750 --> 00:17:18,010
!بالطّبع

234
00:17:18,010 --> 00:17:20,120
!توجد نار حيثما وُجد الدّخان

235
00:17:20,120 --> 00:17:23,000
وإن لم توجد نار، فإنّ من واجب
.مجلّة قيل وقال أن تشعل واحدة

236
00:17:23,700 --> 00:17:27,050
تدركين أنّك تصفين نفسك بالمخادعة، صحيح؟

237
00:17:27,050 --> 00:17:30,940
!مخادعة؟ لا، لا. أنا رومانتيكيّة

238
00:17:30,940 --> 00:17:32,110
!رومانتيكيّة

239
00:17:32,110 --> 00:17:33,540
!رومانتيكيّة يا كيزونا

240
00:17:33,540 --> 00:17:36,320
!رومانتيكيّة! كم هذا حماسيّ

241
00:17:36,320 --> 00:17:38,030
...هل يبيعون

242
00:17:39,350 --> 00:17:41,940
جوهرة ملك التّنانين أيضًا؟

243
00:17:41,940 --> 00:17:43,050
...كاران

244
00:17:44,850 --> 00:17:50,150
.بصراحة، لا أعتقد أنّ عليّ شغل بالي بكاليوس

245
00:17:50,740 --> 00:17:54,760
!لكنّي لا أعرف ماذا عليّ أن أفعل

246
00:17:55,190 --> 00:18:00,840
،أنا أستمتع بوقتي معكم جميعًا
!لكن يبدو أنّ هنالك ما أتجنّبه

247
00:18:03,250 --> 00:18:04,460
لماذا لا تجرّبين؟

248
00:18:06,120 --> 00:18:09,680
،إن لم تستطيعي نسيان الأمر
.فلماذا لا تسعين خلفه

249
00:18:10,240 --> 00:18:14,510
.لكنّك لن تكوني وحدك هذه المرّة

250
00:18:14,510 --> 00:18:15,460
.صحيح

251
00:18:15,460 --> 00:18:19,570
.لنجعلها أحد مهمّاتنا كما فعلنا مع الرّجل القافز

252
00:18:21,390 --> 00:18:22,630
...نيك

253
00:18:23,880 --> 00:18:25,500
.لا أمانع

254
00:18:25,500 --> 00:18:31,130
نحن فرقة النّاجون. سنعود أحياءً
.مهما كان ما سنواجهه

255
00:18:31,770 --> 00:18:34,580
...ثمّة علاقة بين نالغافا والقناع الأبيض

256
00:18:34,580 --> 00:18:37,340
.نحن متأكّدون من وجودها

257
00:18:37,580 --> 00:18:41,120
...ويمكننا التّخمين بشأن العلاقات الأخرى
.سمعت الكثير من الشّائعات

258
00:18:41,640 --> 00:18:44,570
هل يعقل أن تكون لشخص شرّير علاقة بآخر طيّب؟

259
00:18:44,570 --> 00:18:47,090
.لا، فلا ستكون له علاقة بشخص شرّير أكثر

260
00:18:47,340 --> 00:18:49,560
...وإن واصلنا اللّحاق بسلسلة الأشرار هذه

261
00:18:49,560 --> 00:18:52,470
،فسنجد في نهاية المطاف أكبرهم
!وبإمكانكم حينها تلقينه درسًا

262
00:18:52,470 --> 00:18:54,800
.يبدو هذا محمّسًا

263
00:18:54,800 --> 00:18:56,500
.أعتقد أنّها تلاعبت به للتّوّ

264
00:18:56,500 --> 00:18:58,370
!لنجرّب الأمر

265
00:18:58,370 --> 00:19:00,510
!بإمكاننا الذّهاب للإمساك بكلّ الأشرار

266
00:19:00,510 --> 00:19:00,940
ماذا؟

267
00:19:00,940 --> 00:19:02,990
!نيك، أريد القيام بهذا أيضًا

268
00:19:02,990 --> 00:19:04,220
!نحن جميعًا متّفقون إذًا

269
00:19:04,220 --> 00:19:07,040
لنذهب جميعًا إذًا لهزيمة إله الشّياطين
!المظلم الأسطوريّ! أجل، أجل

270
00:19:07,040 --> 00:19:08,590
!أجل

271
00:19:09,160 --> 00:19:10,720
.لا بأس

272
00:22:07,530 --> 00:22:10,150
.لديّ سؤال لك

273
00:22:10,150 --> 00:22:11,520
.سل ما تريد

274
00:22:12,160 --> 00:22:18,260
.نحن الآثار سنعيش أكثر منهم

275
00:22:18,880 --> 00:22:24,300
من وجهة نظرك كسيف الحرب، الّذي
،يدرّب البشريّة ويساعدهم على التّطوّر

276
00:22:24,300 --> 00:22:27,520
ما رأيك في فرقة النّاجون؟

277
00:22:28,800 --> 00:22:30,910
.لا بأس بهم على ما أظنّ

278
00:22:30,910 --> 00:22:33,050
لكنّي أتوقّع المزيد من الطّموح

279
00:22:33,050 --> 00:22:36,170
.من الأشخاص الّذين سيقتلون إله الشّياطين

280
00:22:36,170 --> 00:22:40,420
.فعلاً؟ ظننتُ أنّك ستكونين أكثر قسوة عليهم

281
00:22:40,670 --> 00:22:43,010
لن يكون ذلك عادلاً، أليس كذلك؟

282
00:22:43,010 --> 00:22:47,360
إنّهم أحياء منذ حوالي 20 سنة فحسب
.من حياتهم القصيرة هذه

283
00:22:47,360 --> 00:22:49,610
.أنا مندهشة لنجاتهم حتّى الآن

284
00:22:49,610 --> 00:22:51,040
.تصفيق، تصفيق، تصفيق

285
00:22:51,040 --> 00:22:54,370
.حسنًا، إنّهم يسمّون نفسهم النّاجون قبل كلّ شيء

286
00:22:54,790 --> 00:22:59,070
.وسيجنّبنا القليل من الشّكّ الكثير من المتاعب

287
00:22:59,430 --> 00:23:01,990
.إنّه أفضل أسلحتهم

288
00:23:01,990 --> 00:23:05,210
.وهو شيء يفقده المرء عندما يكبر

289
00:23:05,580 --> 00:23:08,200
.أو يزداد سوءًا ويجعله عنيدًا

290
00:23:08,200 --> 00:23:11,190
.لكن لا بأس. العناد سلاح أيضًا

291
00:23:11,190 --> 00:23:12,370
.أوافقك

292
00:23:12,370 --> 00:23:14,820
.لندعهم يأخذون وقتهم

293
00:23:14,820 --> 00:23:18,830
.وربّما سيتمكّنون من هزيمة إله الشّياطين في النّهاية

294
00:23:21,520 --> 00:23:23,890
...ربّما سيتمكّنون من ذلك

295
00:23:24,680 --> 00:23:29,180
.لا يستطيع هؤلاء المغامرون إنقاذ العالم الآن

296
00:23:29,190 --> 00:23:33,300
.لكنّهم سينقذونه يومًا ما

297
00:23:33,950 --> 00:23:38,670
!لكنّ ذلك لن يحدث إلاّ بعد وقت طويل