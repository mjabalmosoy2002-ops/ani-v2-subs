1
00:00:13,560 --> 00:00:17,980
لِمَ كلّ هذه العجلة لدرجة أنّك لا تستطيع
النّظر لذلك القمر الجميل؟

2
00:00:19,480 --> 00:00:23,740
ما زالت تعويذة الجسد الخفيف خاصّتك
.غير كاملة، لكنّ مهاراتك القتاليّة جيّدة

3
00:00:24,140 --> 00:00:27,060
هل يجعلني ذلك الرّجل القافز؟

4
00:00:29,530 --> 00:00:33,150
.ثمّة أمر واحد لم أستطع أبدًا اكتشافه

5
00:00:33,150 --> 00:00:37,000
لماذا تواصل القيام بهذا بينما كانت
طريقة عملك معروفة بكلّ وضوح؟

6
00:00:37,000 --> 00:00:39,130
أهي طريقتك لتحدّي السّلطات؟

7
00:00:39,530 --> 00:00:40,250
...أم أنّك

8
00:00:42,680 --> 00:00:44,540
تريد أن يتمّ الإمساك بك فحسب؟

9
00:00:46,150 --> 00:00:48,890
.أنت شابّ كثير الفضول

10
00:00:49,150 --> 00:00:53,280
!اكتشفتُ كلّ شيء آخر تقريبًا عمّا يحفّزك

11
00:00:57,070 --> 00:00:58,740
!سبب اختطافك للأطفال

12
00:00:58,740 --> 00:01:01,410
.سبب مكوثك في حيّ جمع النّفايات

13
00:01:03,160 --> 00:01:05,760
.لكنّك تفتقر لعنصر مهمّ للغاية

14
00:01:05,760 --> 00:01:07,040
.على العكس تمامًا

15
00:01:12,880 --> 00:01:16,070
تفاجأتُ عندما سمعتُ بوجود أحد

16
00:01:16,070 --> 00:01:20,340
يكتب مقالة أكاديميّة من مهمل
.مثل حيّ جمع النّفايات

17
00:01:20,810 --> 00:01:22,550
.يا نالغافا

18
00:01:31,550 --> 00:01:34,590
.دعني أهنّئك في البداية على تفانيك

19
00:03:05,490 --> 00:03:09,320
كان باديًا على الفتاة الّتي عُثر عليها
في القبر الجماعيّ في حيّ جمع النّفايات

20
00:03:09,320 --> 00:03:11,660
.علامات لتلقّيها علاجًا لمرض الشّيطان الأصفر

21
00:03:12,590 --> 00:03:14,760
كيف يُعقل أنّ مرضًا معديًا كهذا

22
00:03:14,760 --> 00:03:18,580
ألاّ ينتشر من حيّ جمع النّفايات إلى مدينة المتاهة؟

23
00:03:18,850 --> 00:03:21,070
،صحيح أن ذلك المكان ليس نظيفًا

24
00:03:21,070 --> 00:03:23,700
لكن لا يجب أن تكون الفجوة
.في معدّلات الإصابة كبيرة هكذا

25
00:03:25,420 --> 00:03:28,210
.يبدو لي أن للأمر سببًا بشريًّا

26
00:03:30,130 --> 00:03:32,900
.هذا هو رأي طبيبنا على الأقل

27
00:03:34,050 --> 00:03:35,850
ذلك الشّابّ؟

28
00:03:36,080 --> 00:03:38,090
حيّ جمع النّفايات هو مختبرك

29
00:03:38,090 --> 00:03:41,930
.حتّى تجد طريقة لعلاج المرض

30
00:03:42,810 --> 00:03:45,370
.تختطف الأطفال لتوفّر لنفسك عيّنات للبحث

31
00:03:47,810 --> 00:03:49,780
.انتهى الكلام في هذا الموضع إذًا

32
00:03:49,780 --> 00:03:51,110
أما زلت تريد القتال؟

33
00:03:51,390 --> 00:03:53,240
!ها أنا ذا إذًا

34
00:03:55,560 --> 00:03:57,130
لم تكتشف الأمر بعد؟

35
00:03:57,130 --> 00:03:59,630
!أعرف كلّ خطوة تقوم بها

36
00:04:01,380 --> 00:04:03,130
!وأنا كذلك

37
00:04:07,420 --> 00:04:11,280
أحمق! إن عزّزت هجومك بكامل
...جسدك في مكان كهذا

38
00:04:11,280 --> 00:04:12,900
!تلك غايتي بالفعل

39
00:04:23,960 --> 00:04:27,040
.حالفنا الحظّ لأنّ حركاتك دقيقة جدًّا

40
00:04:31,060 --> 00:04:34,160
أيعني هذا أنّي محاصر؟

41
00:04:36,420 --> 00:04:37,790
.نالغافا

42
00:04:40,680 --> 00:04:43,290
لماذا نشرتَ وباءً؟

43
00:04:45,470 --> 00:04:48,510
.ماتت ابنتي بسبب مرض الشّيطان الأصفر

44
00:04:48,510 --> 00:04:50,820
.عرفتُ ذلك عندما أجريتُ بحثي

45
00:04:51,360 --> 00:04:53,480
.كانت نهاية حزينة

46
00:04:55,150 --> 00:04:58,770
.ينتشر مرض الشّيطان الأصفر بالاتّصال الجنسيّ أساسًا

47
00:04:59,290 --> 00:05:03,450
.ويعتقد النّاس حتّى الآن أنّه جنسيّ

48
00:05:05,200 --> 00:05:07,620
حاولت ابنتك في أحد الأيّام مساعدة

49
00:05:07,620 --> 00:05:10,930
.مريض مصاب ولمست دماءه

50
00:05:11,260 --> 00:05:14,970
كانت على الأرجح تحاول تقليد
.ما رأتك تفعله كلّ يوم كطبيب

51
00:05:15,420 --> 00:05:18,900
.لكنّ النّاس حولها لم يصدّقوا ذلك

52
00:05:20,190 --> 00:05:25,060
بدؤوا ينشرون كلّ أنواع الشّائعات
...عن طريقة إصابتها به

53
00:05:25,310 --> 00:05:29,310
!استمتعوا بذلك حتّى بعد وفاتها

54
00:05:29,950 --> 00:05:33,090
!لماذا كان على ابنتي أن تموت؟

55
00:05:33,090 --> 00:05:35,910
!لماذا سلبني الرّبّ ابنتي؟

56
00:05:35,910 --> 00:05:37,070
!لماذا؟

57
00:05:38,520 --> 00:05:40,900
لماذا كان ذلك فجأة...؟

58
00:05:43,420 --> 00:05:49,140
تمنّيت أنّني إن وجدت طريقة لعلاج
،المرض الّذي قتلها

59
00:05:49,140 --> 00:05:51,440
.ألاّ يكون موتها سدى على الأقلّ

60
00:05:51,780 --> 00:05:53,790
!لكان له معنى

61
00:05:53,790 --> 00:05:55,160
وهذا هو السّبب...؟

62
00:05:55,770 --> 00:05:58,330
!هذا لا يخفّف من هول ما فعلت

63
00:05:59,160 --> 00:06:03,850
.لا أهتمّ كم عدد الأطفال العشوائيّين الّذين سيموتون

64
00:06:03,850 --> 00:06:07,820
،بصفتي راهبًا سابقًا مثلك يا نالغافا

65
00:06:07,820 --> 00:06:10,620
.انبهرت كثيرًا بالطّريقة الّتي عشت بها حياتك

66
00:06:10,620 --> 00:06:12,540
.احترمتك

67
00:06:13,190 --> 00:06:14,760
لماذا إذًا...؟

68
00:06:15,630 --> 00:06:20,600
أهنالك أيّ أحد في العالم ظاهره مثل باطنه بالضّبط؟

69
00:06:21,080 --> 00:06:25,330
.لكلّ واحد جانبان كبطاقات اللّعب

70
00:06:25,330 --> 00:06:28,500
.يُظهرون الجانب الّذي يناسبهم أكثر حسب الوضع

71
00:06:29,100 --> 00:06:32,240
.لا جانب مزيّف ولا جانب حقيقيّ لهم

72
00:06:32,700 --> 00:06:36,920
.كلاهما حقيقيّ. لكليهما مسؤوليّات

73
00:06:37,990 --> 00:06:43,010
.وأنا لن أهرب من مسؤوليّات أيّ من الجانبين

74
00:06:45,960 --> 00:06:52,040
.ربّما لم يبق لنا ما نقوله إن كان هذا ما تشعر به

75
00:06:52,450 --> 00:06:57,770
!ولكن... ولكن ما زال عليّ إدانة ما فعلتَه

76
00:07:03,620 --> 00:07:07,940
.رأيتُ جثّة فتاة صغيرة في القبر الجماعيّ قبل أيّام

77
00:07:08,430 --> 00:07:12,720
.الجثّة الّتي حاولتَ تمويهها بجوهرة ملك الوهم

78
00:07:13,660 --> 00:07:15,620
ألا تذكر ذلك؟

79
00:07:15,620 --> 00:07:20,030
الفتاة الجميلة ذات الشّعر الأشقر
الطّويل الّتي ترتدي فستانًا؟

80
00:07:21,400 --> 00:07:23,050
أم أنّك نسيت سلفًا؟

81
00:07:23,050 --> 00:07:25,010
!مارثا كانينغ ذات العشر سنوات

82
00:07:25,010 --> 00:07:28,130
!أعدتُ جسدها إلى والديها قبل مجيئي إلى هنا

83
00:07:28,130 --> 00:07:32,530
!كانا يبكيان على خسارة ابنتيهما فجأة

84
00:07:32,530 --> 00:07:35,300
!سألا لماذا كان على ابنتيهما الموت

85
00:07:36,860 --> 00:07:40,470
،وعند انتشار خبر وفاتها

86
00:07:40,470 --> 00:07:44,590
بكى عليها كلّ أصحاب المحلاّت
!في الحيّ والزّبائن أيضًا

87
00:07:46,350 --> 00:07:49,060
."لا وجود لشيء مثل "طفل عشوائيّ

88
00:07:49,880 --> 00:07:54,530
!هنالك من يهتمّ لأمرهم حتّى إن كنت لا تعرفهم

89
00:07:55,410 --> 00:07:59,240
ألم يكن هذا هو الحال بالنّسبة لابنتك؟

90
00:08:01,360 --> 00:08:07,080
ربّما هذه مجرّد عبارة مبتذلة
.تبدو جيّدة ولا تعني أيّ شيء

91
00:08:07,780 --> 00:08:13,980
ولكن رغم ذلك... حتّى إن كنّا
..."راهبين "سابقين

92
00:08:14,590 --> 00:08:17,490
أليس ذلك أمر علينا نهتمّ له؟

93
00:08:19,250 --> 00:08:20,750
...كنتُ

94
00:08:22,300 --> 00:08:24,520
.راهبًا فظيعًا

95
00:08:25,180 --> 00:08:30,110
أنا آسف، لكنّني لم أرغب أبدًا
.بإنقاذ أحد كما تريد أنت بوضوح

96
00:08:30,620 --> 00:08:35,050
قابلتُ رهابًا عالي الرّتبة في ترحالي بالصّدفة

97
00:08:35,050 --> 00:08:39,620
.وتملّقته بشتّى الطّرق حتّى جعلني راهبًا

98
00:08:39,870 --> 00:08:42,020
.أنا مجرّد رجل مثير للشّفقة

99
00:08:43,500 --> 00:08:48,490
لكنّك تنقذ النّاس الّذين في غرف
.النّوم لأنّ هذا ما تشعر به

100
00:08:48,980 --> 00:08:54,920
واثق أنّهم جميعًا ممتنّون لك
.على الوقت الإضافيّة الّذي منحتهم إيّاه

101
00:08:56,910 --> 00:09:01,080
.لتمكّن آخرون من العيش إن ماتوا

102
00:09:01,850 --> 00:09:04,610
.ذلك أمر يجهله كلانا

103
00:09:05,220 --> 00:09:07,330
.هذا ما يجعل الحياة أكثر اهتمامًا

104
00:09:08,980 --> 00:09:11,480
تغيّر الجانب الّذي تُظهره في كلّ ثانية، صححي؟

105
00:09:15,210 --> 00:09:16,290
نالغافا؟

106
00:09:17,510 --> 00:09:20,900
كلّ ما عليك فعله هو إيقافي وسينتهي الأمر"؟"

107
00:09:21,460 --> 00:09:24,780
.تعرف تمامًا أنّ الأمر ليس بتلك البساطة

108
00:09:25,380 --> 00:09:26,790
.معك حقّ تمامًا

109
00:09:27,190 --> 00:09:32,090
ومع ذلك، يمكننا فقط التّعامل مع الأشياء
.كلّ على حدة ونحن نلقاها في طريقنا

110
00:09:33,580 --> 00:09:34,990
.يا لسذاجتك

111
00:09:35,460 --> 00:09:36,530
.أعلم

112
00:09:37,220 --> 00:09:40,180
.لكن هنالك أشياء لا يراها سوى السّذّج

113
00:09:46,290 --> 00:09:47,340
!هذا سيّئ

114
00:09:47,680 --> 00:09:48,810
!ثمّة أحد في الدّاخل

115
00:09:48,810 --> 00:09:50,300
!أحدهم قادم

116
00:09:57,080 --> 00:09:58,450
!نالغافا

117
00:10:01,040 --> 00:10:05,170
.انتهى وقت الكلام أيّها الرّاهب

118
00:10:09,680 --> 00:10:11,550
درع تصوّريّ؟

119
00:10:12,400 --> 00:10:14,220
ماذا تفعل هنا؟

120
00:10:15,000 --> 00:10:16,580
...أتيت لمساعدتك

121
00:10:16,840 --> 00:10:19,370
،أو هذا ما أردت قوله

122
00:10:19,370 --> 00:10:21,480
.لكنّني هنا للأسف لقتلك قبل أن تتمكّن من الكلام

123
00:10:23,030 --> 00:10:26,850
لم يرق لك أنّني حطّمت جوهرة ملك الوهم

124
00:10:26,850 --> 00:10:29,690
الّتي كان ممكنًا بيعها بعشرة
ملايين دينا في مزاد غير شرعيّ؟

125
00:10:30,320 --> 00:10:33,020
،لم تخطر ببالي فكرة استعمالها بتلك الطّريقة أبدًا

126
00:10:33,020 --> 00:10:34,980
.لكنّني سأعترف بتفوّقك كهديّة قبل موتك

127
00:10:35,340 --> 00:10:37,210
لماذا إذًا؟

128
00:10:37,210 --> 00:10:39,340
لماذا تهاونت بشأن تمويه نفسك؟

129
00:10:39,340 --> 00:10:42,190
هل لتعهد بآمالك لهم؟

130
00:10:42,780 --> 00:10:44,980
.تظنّني شخصًا أفضل ممّا أنا عليه

131
00:10:44,980 --> 00:10:48,550
...الأشياء الفظيعة والشّنيعة الّتي ارتكبتُها

132
00:10:48,550 --> 00:10:49,250
.علاج سريع

133
00:10:49,250 --> 00:10:50,980
.ها أنا أدفع ثمنها فحسب

134
00:10:51,270 --> 00:10:52,680
!لا تتدخّل

135
00:10:53,430 --> 00:10:55,820
.سيموت قريبًا في كلّ الأحوال

136
00:10:55,820 --> 00:10:58,250
ألا ترى أنّك تضيّع سحرك بهذا؟

137
00:10:58,250 --> 00:11:00,340
.كما أنّه عدوّك أيضًا

138
00:11:00,940 --> 00:11:06,040
لماذا لا توفّر سحرك لنفسك
بما أنّي سأقتلك أيضًا؟

139
00:11:06,520 --> 00:11:09,140
.لا تسئ فهمي

140
00:11:09,140 --> 00:11:12,280
.أنا هنا لقتلكم جميعًا قبل أن تتكلّموا أيضًا

141
00:11:12,280 --> 00:11:13,780
!مروحة تنّين النّار

142
00:11:13,780 --> 00:11:14,900
!رقصة الجليد

143
00:11:25,730 --> 00:11:26,730
.علاج سريع

144
00:11:28,160 --> 00:11:30,950
.إنّك تعترض طريق فرقتك

145
00:11:31,750 --> 00:11:34,480
...لكنّ جراحك

146
00:11:34,480 --> 00:11:37,010
ماذا؟ هل لاحظت للتّوّ؟

147
00:11:37,010 --> 00:11:41,490
.اتّخذت نفس الخيار في أماكن أخرى من قبل

148
00:11:42,410 --> 00:11:43,800
.انظر

149
00:11:43,800 --> 00:11:48,230
اتّخذتَ الخيار الخاطئ حيال من وما
،يجب أن يكون أولويّة عندك

150
00:11:48,230 --> 00:11:51,500
.ويتلقّى رفاقك أضرارًا هم في غنى عنها

151
00:11:51,500 --> 00:11:52,550
...لكن

152
00:11:52,820 --> 00:11:56,090
.لطفك ليس لطفًا

153
00:11:56,090 --> 00:11:58,280
.بل هو أنانيّة

154
00:11:59,000 --> 00:12:01,880
.سنموت جميعًا بعد بضعة دقائق

155
00:12:01,880 --> 00:12:04,690
.أنا وأنتم

156
00:12:04,690 --> 00:12:07,380
.بسبب أنانيّتك

157
00:12:08,320 --> 00:12:09,850
!زيم! لنستعمل الاتّحاد

158
00:12:09,850 --> 00:12:10,700
أيمكنك ذلك؟

159
00:12:10,980 --> 00:12:12,450
أ-أنا؟

160
00:12:12,680 --> 00:12:15,580
!هذا صحيح! أنت الوحيد القادر على التّحرّك الآن

161
00:12:15,580 --> 00:12:17,480
...لـ-لكن

162
00:12:17,480 --> 00:12:18,570
ما الخطب؟

163
00:12:20,610 --> 00:12:21,460
!نيك

164
00:12:22,520 --> 00:12:23,470
...ثانية

165
00:12:23,470 --> 00:12:26,730
...خسرنا فرصة أخرى بسببي

166
00:12:26,730 --> 00:12:28,230
ماذا أفعل؟

167
00:12:28,230 --> 00:12:30,470
ماذا يفترض بي فعله؟

168
00:12:31,140 --> 00:12:32,240
...زيم

169
00:12:32,800 --> 00:12:34,110
.الأمر يعتمد عليك يا زيم

170
00:12:35,920 --> 00:12:37,660
مرحبًا يا زيم؟

171
00:12:37,660 --> 00:12:38,830
!مـ-مرحبًا؟

172
00:12:39,420 --> 00:12:43,600
ستوفّر أوليفيا الوقت ببعض
.الدّردشة المثيرة جدًّا للاهتمام

173
00:12:43,600 --> 00:12:46,750
.وأثناء ذلك... آمل أن تتّخذ القرار الصّحيح

174
00:12:47,840 --> 00:12:50,770
!أرجوك... ساعدينا يا أوليفيا

175
00:12:50,770 --> 00:12:53,140
!عُلم

176
00:12:56,920 --> 00:13:00,620
لصّ أغراض سحريّة ومنفّذ طقوس غريبة

177
00:13:00,620 --> 00:13:03,550
.وموفّر أسلحة لعبدة لإله الشّياطين

178
00:13:03,550 --> 00:13:05,850
أنت القناع الأبيض، صحيح؟

179
00:13:06,240 --> 00:13:08,770
من تكونين؟

180
00:13:09,340 --> 00:13:11,880
،أنا مراسلة ومغامِرة

181
00:13:11,880 --> 00:13:13,450
.إضافة لأشياء أخرى

182
00:13:13,450 --> 00:13:17,430
.الفتاة الجميلة أوليفيا الّتي كانت تمرّ من هنا فحسب

183
00:13:17,950 --> 00:13:21,650
.يقولون أنّ المعرفة تقتل

184
00:13:21,900 --> 00:13:24,910
فعلاً؟ من قال ذلك؟

185
00:13:24,910 --> 00:13:26,430
!أنا

186
00:13:27,740 --> 00:13:30,810
!يا للمكر

187
00:13:30,810 --> 00:13:33,470
هل سمعت هذه العبارة إذًا؟

188
00:13:34,150 --> 00:13:36,920
".سريعٌ سرعةَ أوليفيا"

189
00:13:39,240 --> 00:13:40,310
...وأيضًا

190
00:13:46,290 --> 00:13:47,360
!سُحقًا

191
00:13:48,260 --> 00:13:50,690
"!أوليفيا ظريفة جدًّا"

192
00:13:51,630 --> 00:13:53,080
...يا لك من

193
00:13:53,080 --> 00:13:55,070
.إنّها مقولات خاصّة بي

194
00:13:55,310 --> 00:14:00,320
بلّغها لعشرة أشخاص على الأقلّ
.خلال ثلاثة أيّام وإلاّ لزمك الحظّ السّيّئ

195
00:14:00,850 --> 00:14:03,310
...ذلك أثر من حضارة قديمة

196
00:14:03,310 --> 00:14:07,180
.لن تكون هجماتي كافية

197
00:14:07,690 --> 00:14:08,840
!الآن يا زيم

198
00:14:08,840 --> 00:14:09,790
!حسنًا

199
00:14:09,790 --> 00:14:10,980
!اتّحاد

200
00:14:12,960 --> 00:14:14,450
اتّحاد؟

201
00:14:14,840 --> 00:14:17,530
لماذا يملكون سحرًا مفقودًا كهذا؟

202
00:14:18,940 --> 00:14:22,670
هل هذا هو السّيف المقدّس الّذي
لم يستعمل أبدًا في الحرب الأخيرة؟

203
00:14:23,590 --> 00:14:26,850
وضعك مشابه لهذا، صحيح؟

204
00:14:26,850 --> 00:14:30,090
!ماذا؟ أنا أروع منه بألف مرّة

205
00:14:30,450 --> 00:14:31,760
.هذا مثير للإعجاب

206
00:14:32,490 --> 00:14:35,820
!إنشاء زنزانة! البقعة الحمراء العظيمة

207
00:14:36,750 --> 00:14:37,720
!أوليفيا

208
00:14:39,350 --> 00:14:43,480
!سأعود لمطاردتك كشبح إن متّ

209
00:14:43,730 --> 00:14:49,860
تلك المنطقة لها حرارة وجاذبيّة
.وضغط مضاعف

210
00:14:49,860 --> 00:14:52,990
أتساءل إلى متى تستطيع بشريّة
.عاديّة التّحمّل هناك

211
00:14:54,250 --> 00:14:57,750
كيف تجرؤ على فعل هذا بفتاة عاديّة جميلة؟

212
00:14:57,750 --> 00:15:01,390
!سألعنك! سألعنك! سألعنك! سألعنك

213
00:15:01,390 --> 00:15:02,100
!أوليفيا

214
00:15:02,100 --> 00:15:02,980
!مهلاً

215
00:15:03,860 --> 00:15:08,660
ستُسحق بمجرّد ذهابك إلى هناك
.إن اندفعتَ هكذا

216
00:15:09,170 --> 00:15:10,120
!انتبه

217
00:15:13,260 --> 00:15:14,510
!هذا ثقيل

218
00:15:14,510 --> 00:15:18,940
على الأرجح أنّ وزن السّيف الحقيقيّ
!مخبّأ في بعد آخر

219
00:15:18,940 --> 00:15:21,150
!إنّه أثق بكثير ممّا يبدو عليه

220
00:15:21,760 --> 00:15:23,300
.فهمت

221
00:15:23,300 --> 00:15:24,730
...في تلك الحالة

222
00:15:25,560 --> 00:15:27,650
!سأهزمه بالسّرعة

223
00:15:29,140 --> 00:15:31,040
بإمكانك استعمال تعويذة القفز؟

224
00:15:33,880 --> 00:15:37,280
...لا. لا يمكن لتعويذة القفز فعل هذا

225
00:15:37,600 --> 00:15:39,870
إنّه يغيّر مساره في الجوّ؟

226
00:15:41,550 --> 00:15:49,190
ضعوا زهرة وقطعة حلوى على
...قبري عندما أموت

227
00:15:50,460 --> 00:15:53,880
...الوداع جميعًا، الوداع، الوداع

228
00:15:53,880 --> 00:15:54,890
.الوداع

229
00:15:56,620 --> 00:15:58,060
قلّت قوّته؟

230
00:15:58,750 --> 00:16:03,680
إنّه إذًا من النّوع الّذي يمكنه التّركيز
.على شيء واحد فقط

231
00:16:04,230 --> 00:16:06,540
!تحويل الأخبار السّيّئة

232
00:16:10,230 --> 00:16:14,080
كنتُ أوشك على قضاء بقيّة
.الزّمان كشبح يسكن هذا المكان

233
00:16:16,580 --> 00:16:19,080
...وكأنّه يقوم بخطوات خفيّة في الجوّ

234
00:16:19,590 --> 00:16:22,940
فهمت! إنّه ينشر الدّرع التّصوّري
...وهو في الجوّ

235
00:16:22,940 --> 00:16:24,950
!انتبه! هجوم جسم طائر

236
00:16:27,930 --> 00:16:28,710
!أوليفيا

237
00:16:29,840 --> 00:16:31,100
.هذا ذكيّ

238
00:16:31,510 --> 00:16:34,220
،لكن إن كان لديك بضع أنماط حركة

239
00:16:34,220 --> 00:16:35,970
!أستطع استهداف أين ستكون

240
00:16:40,580 --> 00:16:41,970
.نلت منك الآن

241
00:16:41,970 --> 00:16:43,890
!أنا من عليه قول ذلك

242
00:16:43,890 --> 00:16:44,740
ماذا؟

243
00:16:44,740 --> 00:16:46,830
!هذه هي نهايتك

244
00:16:50,240 --> 00:16:52,230
.إصابة مباشرة

245
00:16:55,980 --> 00:16:59,000
.مرّ وقت طويل مذ كنت في وضع خطير كهذا

246
00:16:59,000 --> 00:17:01,480
.سأعترف بالهزيمة

247
00:17:01,920 --> 00:17:02,980
!الوداع

248
00:17:17,230 --> 00:17:19,190
...هذا مؤلم

249
00:17:19,190 --> 00:17:20,650
هل الجميع بخير؟

250
00:17:22,340 --> 00:17:23,820
.نوعًا ما

251
00:17:24,630 --> 00:17:26,160
.أنا حيّة

252
00:17:26,480 --> 00:17:29,020
...يا له من رجل مجنون

253
00:17:32,800 --> 00:17:34,110
!نالغافا

254
00:17:35,320 --> 00:17:36,580
!هل أنت بخير؟

255
00:17:36,580 --> 00:17:38,510
!انتظر! سنحرّرك

256
00:17:38,510 --> 00:17:39,400
!كلاّ

257
00:17:40,800 --> 00:17:43,600
لكنّه لم يعد عدوّنا، صحيح؟

258
00:17:43,600 --> 00:17:45,580
.الأمر ليس هكذا يا كاران

259
00:17:46,620 --> 00:17:50,380
...لا أدري كم كنّا فاقدين للوعي

260
00:17:51,260 --> 00:17:53,430
".متلازمة السّحق"

261
00:17:53,850 --> 00:17:58,800
إن تمّ تحرير شخص ما فجأة
،بعد أن حوصر لوقت طويل هكذا

262
00:17:59,080 --> 00:18:01,840
.فإنّ جسده سيدخل حالة صدمة

263
00:18:01,840 --> 00:18:05,160
.لكنّني لن أدوم طويلاً في كلّ الأحوال

264
00:18:05,160 --> 00:18:06,570
...مستحيل

265
00:18:08,630 --> 00:18:09,750
...أنت

266
00:18:11,620 --> 00:18:14,310
."لطالما قالوا "اشف نفسك أيّها الطّبيب

267
00:18:14,600 --> 00:18:16,280
...مهلاً، غير معقول

268
00:18:16,670 --> 00:18:17,950
.مرض الشّيطان الأصفر

269
00:18:19,340 --> 00:18:21,430
.دعوني هنا

270
00:18:21,430 --> 00:18:23,960
.نجهل متى قد ينهار هذا المكان

271
00:18:27,170 --> 00:18:32,120
،صحيح. حتّى بدون الانفجار
.كان هذا المبنى قديمًا من الأساس

272
00:18:32,120 --> 00:18:34,580
.قد ينهار في أيّ لحظة

273
00:18:34,850 --> 00:18:36,840
سـ-سنتركه؟

274
00:18:38,190 --> 00:18:41,710
.دعني أخفّف ألمك على الأقلّ

275
00:18:44,420 --> 00:18:46,480
...أشعر بتحسّن أكثر

276
00:18:46,480 --> 00:18:49,030
.وكأنّني في السّماء

277
00:18:49,030 --> 00:18:53,210
.مزاحك سيّئ أكثر من مزاحي

278
00:18:56,140 --> 00:18:57,090
.لنسرع

279
00:19:01,310 --> 00:19:02,600
...نالغافا

280
00:19:04,810 --> 00:19:07,760
.لقد منحتني الشّجاعة

281
00:19:08,550 --> 00:19:12,510
.أنا حزين على خسرانك

282
00:19:15,020 --> 00:19:16,340
.أعلم

283
00:19:16,980 --> 00:19:20,230
...سأخبر ابنتي عنك

284
00:19:21,050 --> 00:19:24,690
.لطالما أحبّت سماع قصص المغامرين

285
00:19:27,350 --> 00:19:28,280
.زيم

286
00:19:28,280 --> 00:19:29,520
!بسرعة يا زيم

287
00:19:49,360 --> 00:19:54,590
ماذا...؟ ظننتُ أنّني اعتدت على
...موت النّاس، ولكن

288
00:19:56,400 --> 00:19:58,860
.لا تقل شيئًا حزينًا هكذا

289
00:19:59,980 --> 00:20:01,880
.لا تقل أنّك معتاد على موت النّاس

290
00:20:02,440 --> 00:20:05,690
.هذا صحيح. أبليتَ حسنًا

291
00:20:06,550 --> 00:20:08,180
فعلاً...؟

292
00:20:08,610 --> 00:20:13,470
.أعتقد... أنّك أنقذته في النّهاية

293
00:20:15,780 --> 00:20:17,320
أتظنّين هذا فعلاً؟

294
00:20:17,850 --> 00:20:22,100
متى تُغفر خطايا النّاس وممّن؟

295
00:20:23,480 --> 00:20:24,550
زيم؟

296
00:20:24,980 --> 00:20:25,920
...لكن

297
00:20:26,580 --> 00:20:30,080
لا يسعني سوى التّشبّث بالأمل
.رغم معرفتي أنّ ذلك تعجرفًا

298
00:20:30,650 --> 00:20:33,330
.فعلتُ سيئًا من أجله في آخر لحظاته

299
00:20:34,200 --> 00:20:34,950
ماذا؟

300
00:20:36,550 --> 00:20:38,070
...ها أنا أقوم بذلك ثانية

301
00:20:39,710 --> 00:20:43,830
.على أيّ حال، أغلقنا فضيّة الرّجل القافز

302
00:20:44,230 --> 00:20:45,010
.نعم

303
00:20:45,470 --> 00:20:47,960
.لنذهب إلى إيدا وابنتها

304
00:20:48,730 --> 00:20:50,020
.نعم

305
00:20:51,090 --> 00:20:53,850
.انتهينا من قضيّة على الأقلّ

306
00:20:53,850 --> 00:20:56,120
.لم يكن هذا الأمر برمّته ممتعًا

307
00:20:56,120 --> 00:20:58,360
.انتهت قضيّة واحدة

308
00:20:59,590 --> 00:21:02,890
.لكن لا يجب أن ترتاحوا بعد

309
00:21:04,400 --> 00:21:06,770
.ما زال القناع الأبيض موجودًا

310
00:21:06,770 --> 00:21:10,110
.ومن يتحكّمون به بالطّبع

311
00:21:10,400 --> 00:21:13,980
،إن مُنح الإذن لاستعمال أسلحة محرّمة

312
00:21:13,980 --> 00:21:16,720
.فلا يمكن توقّع ماذا يخطّطون

313
00:21:17,410 --> 00:21:19,380
أسلحة محرّمة؟

314
00:21:19,670 --> 00:21:22,590
من تكونين على أيّ حال؟

315
00:21:22,590 --> 00:21:26,270
طريقة قتالك وكلامك
...وكأنّك تعرفين شيئًا نجهله

316
00:21:26,270 --> 00:21:29,210
.لا تقولي لي أنّك مجرّد فتاة

317
00:21:29,210 --> 00:21:32,100
ماذا؟ ستسألني عن ذلك؟

318
00:21:32,390 --> 00:21:34,890
.خضنا موقفًا كانت حياتنا فيه على المحكّ معًا

319
00:21:34,890 --> 00:21:37,470
.أعتقد أنّ بإمكانك إخبارنا من تكونين

320
00:21:37,470 --> 00:21:38,720
.هذا صحيح

321
00:21:38,720 --> 00:21:42,040
أريدك أن تخبرينا ولو بالقليل
.إن كنت ستنضمّين للفرقة

322
00:21:42,040 --> 00:21:43,080
.صحيح

323
00:21:47,100 --> 00:21:51,990
لا بدّ أنّك سيف الرّوابط نظرًا لقدرتك
.على استعمال الاتّحاد يا كيزونا

324
00:21:52,970 --> 00:21:54,240
.بالفعل

325
00:21:56,120 --> 00:21:57,440
...أنا في الحقيقة

326
00:22:00,010 --> 00:22:06,280
...مراسلة ومغامِرة ورجل قافز و

327
00:22:06,280 --> 00:22:10,200
برنامج تدريب قتال تقنيّ مضادّ لإله
،الشّياطين من صنف عناصريّ

328
00:22:10,200 --> 00:22:11,520
."سيف الحرب"

329
00:22:11,970 --> 00:22:16,300
.ذلك هو اسم منتَجي واسم مشروعي

330
00:23:35,700 --> 00:23:36,810
:الحلقة الأخيرة

331
00:23:36,810 --> 00:23:39,450
."مغامرون لا يستطيعون إنقاذ العالم بعد"