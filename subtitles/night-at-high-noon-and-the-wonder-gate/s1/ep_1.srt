1
00:00:42,640 --> 00:00:43,810
!لطيفة

2
00:00:46,850 --> 00:00:48,860
.أتيناكِ بسمكةٍ طازجة

3
00:00:49,520 --> 00:00:51,360
.إنّني شاكرة لك دومًا يا مُحسن

4
00:00:51,650 --> 00:00:52,490
.تفضّلي

5
00:00:59,080 --> 00:01:01,450
أتساءل ما الّذي يفعله سندباد الآن؟

6
00:01:01,740 --> 00:01:03,450
.وأنا كذلك

7
00:01:03,910 --> 00:01:07,580
بالمناسبة، كم مضى على ركوبه عباب البحر؟

8
00:01:07,960 --> 00:01:09,210
أتقصد زوجي؟

9
00:01:09,460 --> 00:01:11,590
أم سندباد؟

10
00:01:11,880 --> 00:01:13,090
.كلاهما

11
00:01:25,140 --> 00:01:26,350
!الطّيور المهاجرة

12
00:01:27,650 --> 00:01:29,480
أحلَّ موسم الهجرة بالفعل؟

13
00:01:50,630 --> 00:01:52,550
!الرّياح تغيّرت

14
00:02:27,330 --> 00:02:29,540
...لقد كنتُ أفكّر مؤخرًا وقلت في نفسي

15
00:02:30,460 --> 00:02:32,340
،مادام سندباد قد ركبَ البحر الآن

16
00:02:32,630 --> 00:02:35,590
.فلا شكَّ في أنَّه يُفكِّر بأبيه الّذي أضحى جزءًا من البحر

17
00:02:36,260 --> 00:02:37,170
...ربّما

18
00:02:39,880 --> 00:02:42,550
.لكنَّ البحّارة لا يملكون وقتًا لهذا

19
00:02:42,850 --> 00:02:44,560
.يا سندباد

20
00:02:44,760 --> 00:02:47,390
.كفاكَ شرودًا وراقب جيّدًا

21
00:02:48,140 --> 00:02:49,560
.حاضر أيها المحترم علي

22
00:02:49,730 --> 00:02:52,860
.لن تصبح بحّارًا جيّدًا هكذا

23
00:02:53,110 --> 00:02:54,570
.أجل أيها المحترم علي

24
00:02:54,610 --> 00:02:57,820
.تعلّم منّي، فأنا لا يشغلني أي شيءٍ عن تأدية عملي

25
00:02:55,650 --> 00:02:57,690
!والده الّذي أضحى جزءًا من البحر

26
00:02:58,150 --> 00:02:59,780
.أنا آسف أيها المحترم علي

27
00:03:18,010 --> 00:03:19,220
،أيّها الجدّ نجيب

28
00:03:19,590 --> 00:03:22,090
هل حللتَ لغزَ مصباح عشيرة السّحرة؟

29
00:03:23,890 --> 00:03:25,350
،على جانبه الخارجي

30
00:03:25,760 --> 00:03:28,520
.ثمّة نقوشٌ لحروفٍ قديمة

31
00:03:29,600 --> 00:03:32,940
.لكنّني لم أستطع قراءة سوى القليل من الكلمات

32
00:03:33,230 --> 00:03:34,980
...ليتني أتمكّن من فكِّ الشفرة

33
00:03:35,820 --> 00:03:38,900
إن فعلتَ، فسنتمكّن من إيجاد موطن سانا الحقيقي، أليس كذلك؟

34
00:03:39,070 --> 00:03:41,530
.أجل، يبدو ذلك

35
00:03:46,870 --> 00:03:49,250
،وحدهم البحارة القدماء

36
00:03:50,120 --> 00:03:51,960
.يتطوّر حدسهم بخصوص الإبحار

37
00:03:52,750 --> 00:03:55,210
.يدركون اقترابَ نهاية الرّحلة

38
00:03:56,750 --> 00:03:59,300
..نهاية... الرّحلة

39
00:04:05,300 --> 00:04:07,510
.الرّحلة... ستنتهي

40
00:04:09,470 --> 00:04:13,600
.ينبغي علينا إيصال ضيفتنا إلى موطنها الحقيقيِّ بسلام

41
00:04:17,940 --> 00:04:18,980
.يا رفاق

42
00:04:21,240 --> 00:04:23,780
.أنصتوا إليَّ جميعًا من فضلكم

43
00:04:31,450 --> 00:04:34,870
،سأخبركم سبب رغبتي في السفر نحو الغرب

44
00:04:35,630 --> 00:04:38,090
.وبهويّة الأشخاص الّذي يطاردونني

45
00:04:40,550 --> 00:04:41,800
...لقد كان والداي

46
00:04:42,630 --> 00:04:43,880
.ملكًا وملكة

47
00:04:50,390 --> 00:04:51,850
،في مملكتنا

48
00:04:52,230 --> 00:04:58,190
،تجتمع عشيرة السحرة التي تستخدم القوى السحرية
.وعامة الشعب العاجزون عن ذلك  ويعيشون معًا بسلام

49
00:05:21,630 --> 00:05:27,130
.أمي كانت أحد أعظم السحرة في العشيرة وأقواهم

50
00:05:28,300 --> 00:05:31,140
.أمّا أبي فلم يحز القوى السحرية كونه من عامّة الشعب

51
00:05:31,510 --> 00:05:34,850
.لكنّه كانَ كيميائيًا حاذقًا برصيد لا ينضبُ من العلم والمعرفة

52
00:05:36,060 --> 00:05:38,480
،الدّمج الّذي حصل بين معرفته وقواها السحرية

53
00:05:38,730 --> 00:05:41,650
،"خلقت علمًا تطبيقيًا جديدًا سُميَّ بـ"علم السحر

54
00:05:42,280 --> 00:05:44,900
.والمملكة ازدهرت بفضله

55
00:05:52,870 --> 00:05:57,080
.لكنَّ ذلك الازدهار لم يدم فترة طويلة

56
00:06:01,420 --> 00:06:03,920
.علمُ السحر سيفٌ ذو حدّين

57
00:06:04,590 --> 00:06:08,590
.فبعضهم حاول استغلال ذلك الازدهار لصالح أطماعهم

58
00:06:08,840 --> 00:06:10,340
.ومذاك الحين بدأت المتاعب

59
00:06:11,350 --> 00:06:12,510
.انتظر رجاءً

60
00:06:13,430 --> 00:06:17,600
.لا وجود لأي مملكة على الخارطة يمكنها أن تكون ندًا لنا

61
00:06:18,020 --> 00:06:24,150
ولهذا السبب علينا استخدام علم السحر لصنع أسلحة قوّية
.نجتاح بها العالم ونوسّع نفوذنا

62
00:06:25,740 --> 00:06:26,530
،عزيزي غالب

63
00:06:27,030 --> 00:06:28,820
.أنت أفضل تلامذتي

64
00:06:28,990 --> 00:06:29,490
.شكرًا

65
00:06:30,320 --> 00:06:33,660
.أنا لن أستخدمَ أبدًا علمَ السحر كأداة للحرب

66
00:06:34,450 --> 00:06:36,700
.لن أفعل ذلك مهما حدث

67
00:06:40,290 --> 00:06:43,090
،فكّر أبي وأمي مليًّا في الأمر

68
00:06:43,710 --> 00:06:48,840
وقرّروا مناشدة الشعب للتخلّي عن علم السّحر والعودة
...لطريقة العيش القديمة ولكن

69
00:06:50,430 --> 00:06:52,180
أتقولون بأنَّ علينا التخلّي عن علم السحر؟

70
00:06:52,260 --> 00:06:54,100
!كفاكم كلامًا فارغًا

71
00:06:54,640 --> 00:06:56,720
،من السهل عليكم قول ذلك

72
00:06:56,890 --> 00:06:58,350
.لأنَّ باستطاعتكم استخدامَ السّحر

73
00:06:59,020 --> 00:07:02,020
.إنّنا نرفض العودة لتلك الحياة المزعجة

74
00:07:06,610 --> 00:07:08,320
.رفض عامة الشعبِ الامتثال

75
00:07:10,200 --> 00:07:11,030
لماذا؟

76
00:07:11,950 --> 00:07:17,290
.ليس من السهل التخلّي عن الثروة والرّفاهية بمجرّد أن تتذوّقها

77
00:07:17,950 --> 00:07:19,750
ألهذه الدّرجة؟

78
00:07:19,960 --> 00:07:21,210
.سأسألكما إذًا

79
00:07:21,420 --> 00:07:28,090
إذا طلب منكما أحد التخلي عن أساليب الملاحة الحديثة
،والإبحار دون خريطة وبوصلة

80
00:07:28,380 --> 00:07:30,090
فهل ستقبلان بسهولة؟

81
00:07:34,350 --> 00:07:37,850
،الصراع بين عشيرة السحرة وعامة الشعب ازداد تدريجيًا

82
00:07:39,640 --> 00:07:42,600
.وبدأت المملكة شيئًا فشيئًا تهوي نحو الفوضى

83
00:07:44,060 --> 00:07:45,940
،ومن استغلَّ تلك الفوضى

84
00:07:46,730 --> 00:07:49,610
.كان رجلاً واحدًا ساعيًا لنيل القوّة

85
00:07:54,410 --> 00:07:55,660
.هذا صحيح

86
00:07:56,410 --> 00:08:00,620
،لقد سرقتُ مخطّطات الآلات السحرية الّتي صممها الملك

87
00:08:01,080 --> 00:08:03,290
.وأحلتُهم أسلحة متطوّرة

88
00:08:04,960 --> 00:08:07,500
،ثمَّ استخدمتُ تلك الأسلحة للمِّ شملِ الشعب

89
00:08:08,250 --> 00:08:10,920
.والاستيلاء على السلطة من العائلة المالكة

90
00:08:13,380 --> 00:08:15,050
،وبعد سنواتٍ قليلة

91
00:08:16,720 --> 00:08:20,390
...حولَّ غالب مملكتنا الجميلة

92
00:08:22,520 --> 00:08:27,860
.إلى بلدة معدنية مخيفة مطوّقة بالأسلحة السحرية

93
00:08:29,860 --> 00:08:31,440
،إذن، أما يزال ذلك المدعو غالب

94
00:08:31,690 --> 00:08:34,490
يُحكم سيطرته على أرض شعبك؟

95
00:08:34,910 --> 00:08:35,610
.نعم

96
00:08:37,200 --> 00:08:38,780
وماذا حلَّ بعشيرة السحرة؟

97
00:09:59,280 --> 00:10:00,870
.نجحنا في نقلهم

98
00:10:08,330 --> 00:10:10,210
.كما هو متوقّع منك يا معلّمي

99
00:10:12,420 --> 00:10:13,300
!غالب

100
00:10:14,260 --> 00:10:19,390
.تمكّنتَ من نقل أفراد عشيرتكَ بالدمج بين قوّة الملكة وقوّة الأميرة

101
00:10:20,550 --> 00:10:23,060
.لكنّني لن أسمح لكم بالهرب

102
00:10:23,720 --> 00:10:26,890
.فالقوى السحرية تنبعثُ بنحوٍ طبيعي من عشيرة السحرة

103
00:10:27,140 --> 00:10:29,730
.وجودكم ضروريٌ لعلم السِحر

104
00:10:30,310 --> 00:10:33,190
.ولا سيما سموُّ الملكة الّتي تُعدّ أعظم ساحرة في العشيرة

105
00:10:33,650 --> 00:10:35,820
.أو سموّ الأميرة الّتي يجري دمُ السحرة في عروقها

106
00:10:37,650 --> 00:10:40,570
.إن حظيت بإحداهما فذلك يفي بالغرض

107
00:10:44,740 --> 00:10:46,750
.توجّهي نحو الغرب يا سانا

108
00:10:47,000 --> 00:10:47,790
الغرب؟

109
00:10:48,160 --> 00:10:51,580
،في جزيرة مغمورة بالضباب في البحر الغربي
.يعيش أهلنا

110
00:10:51,920 --> 00:10:55,170
.هناك يكمن الموطن الوحيد لنا نحن عشيرة السحرة

111
00:10:55,710 --> 00:10:58,170
.يجب أن تعيشي وتنضمي لأهلنا هناك

112
00:10:58,550 --> 00:11:00,010
.لن أبرح جانبك

113
00:11:00,760 --> 00:11:03,260
،عندما تصلين إلى موطننا الحقيقي

114
00:11:03,550 --> 00:11:06,390
.ستخسر الأسلحة السحرية قوتها بالكامل

115
00:11:13,230 --> 00:11:18,530
.قهرُ مطامعهم هي مهمّتك كونكِ فردًا من العائلة الملكية

116
00:11:20,070 --> 00:11:21,610
.مهمّتي

117
00:11:55,940 --> 00:11:59,360
.قُتل أبي وأمي على يدي غالب

118
00:11:59,990 --> 00:12:02,110
،أما أنا فتمكّنتُ بطريقة ما من الهرب

119
00:12:02,660 --> 00:12:05,030
.وأقفلت على نفسي في غرفة صغيرة

120
00:12:23,590 --> 00:12:24,550
!لوط

121
00:12:27,220 --> 00:12:29,680
.استطعت حينها الهرب من براثن غالب

122
00:12:55,500 --> 00:12:57,710
.إنَّ غالب هذا لشخص فظيع

123
00:12:58,170 --> 00:13:00,250
!لا يمكنني أن أسامح ذاك الشخص أبدًا

124
00:13:01,050 --> 00:13:03,510
...ولكن

125
00:13:22,150 --> 00:13:23,860
هل أنتِ بخير يا سانا؟

126
00:13:24,280 --> 00:13:25,030
.نعم

127
00:13:26,160 --> 00:13:27,070
...في ذلك الوقت

128
00:13:27,490 --> 00:13:30,830
،لو أنَّ النّاس أنصتوا لأبي وامتثلوا لقراره

129
00:13:31,660 --> 00:13:34,250
.لعمَّ الاطمئنان والهدوء المملكة لوقتٍ طويل

130
00:13:38,290 --> 00:13:39,340
...أنا

131
00:13:40,290 --> 00:13:43,260
.بدأت أكره كلَّ شيءٍ بخصوص البشر

132
00:13:46,220 --> 00:13:47,380
.لا يمكنني مسامحتهم

133
00:13:57,560 --> 00:13:58,440
...ومع ذلك

134
00:13:59,100 --> 00:13:59,980
.سندباد

135
00:14:01,570 --> 00:14:02,190
.علي

136
00:14:04,320 --> 00:14:05,360
.القبطان رزّاق

137
00:14:07,780 --> 00:14:08,860
.وجميعكم

138
00:14:14,120 --> 00:14:15,830
،بعد أن التقيتُ بكم

139
00:14:16,580 --> 00:14:19,080
،وشاركتكم الرّحال

140
00:14:19,880 --> 00:14:20,830
...بدأتُ

141
00:14:21,590 --> 00:14:22,420
...أتعلّم من جديد

142
00:14:23,130 --> 00:14:24,170
.الثقة في النّاس

143
00:14:29,550 --> 00:14:30,430
.سانا

144
00:14:54,830 --> 00:14:55,790
ما كان ذلك؟

145
00:15:01,080 --> 00:15:02,130
.يمكنني قراءتها

146
00:15:02,750 --> 00:15:04,670
.يمكنني، يمكنني قراءتها

147
00:15:06,760 --> 00:15:08,590
إذًا، وماذا تقول؟

148
00:15:11,390 --> 00:15:13,600
،في اللّيل عندَ وقتِ الظَّهيرة"

149
00:15:13,890 --> 00:15:16,390
،سايِر جريان النهر

150
00:15:16,560 --> 00:15:18,810
".الّذي سيأخذك للبلدة البيضاء

151
00:15:19,480 --> 00:15:25,360
".وراء البوابة العجيبة تكمن الأرض الّتي أتى منها أسلافنا"

152
00:15:26,530 --> 00:15:27,860
!ليل عندَ وقتِ الظهيرة

153
00:15:28,650 --> 00:15:29,990
!بلدة بيضاء

154
00:15:31,320 --> 00:15:32,410
.إنّها معجزة

155
00:15:34,660 --> 00:15:36,120
.معجزة حدثت

156
00:15:37,040 --> 00:15:40,120
.ذلكَ لأنَّ سانا فتحت قلبها لنا

157
00:15:43,130 --> 00:15:43,830
!نعم

158
00:15:44,590 --> 00:15:45,460
!سانا

159
00:15:48,380 --> 00:15:49,380
!مذهل

160
00:15:49,510 --> 00:15:50,590
!إنّها معجزة

161
00:15:53,800 --> 00:15:54,970
.مرّة تلو الأخرى

162
00:15:55,300 --> 00:16:01,390
!تتوالى المعجزات، المعجزات المذهلة

163
00:16:10,360 --> 00:16:11,490
،أيها الجدُّ نجيب

164
00:16:12,450 --> 00:16:15,120
..في اللّيل عندَ وقتِ الظهيرة هو بالفعل

165
00:16:15,570 --> 00:16:16,240
.أجل

166
00:16:16,580 --> 00:16:18,330
.فكّرتَ في نفس الأمر إذًا أيها القبطان

167
00:16:18,910 --> 00:16:19,700
بالفعل؟

168
00:16:21,370 --> 00:16:22,460
.هذه

169
00:16:36,220 --> 00:16:37,930
.أيُّ نوعٍ من الأماكن هو

170
00:16:39,100 --> 00:16:41,350
.الموطن الحقيقيُّ الّذي يجب أن تعودي إليه

171
00:16:56,490 --> 00:16:57,780
.سنفترق عما قريب

172
00:16:58,240 --> 00:17:00,290
.شكرًا لأنّكِ كنتِ في غاية اللطفِ معي

173
00:17:01,290 --> 00:17:02,790
...إن وصلتُ إلى موطني

174
00:17:03,500 --> 00:17:04,710
.فلن أتمكّنَ من رؤيتكِ مجدّدًا

175
00:17:07,080 --> 00:17:08,250
...سندباد

176
00:17:18,760 --> 00:17:20,890
.حدّدنا وجهة الأميرة

177
00:17:21,180 --> 00:17:23,520
.عجبًا! تلك أخبار سارّة

178
00:17:23,730 --> 00:17:25,810
...سأذهب لمباغتتهم على الفور

179
00:17:25,810 --> 00:17:27,770
.لقد باتت خارج اهتماماتك

180
00:17:41,240 --> 00:17:43,080
.يا جماعة

181
00:17:43,450 --> 00:17:46,290
.إنّني أشتمُّ رائحة التراب والشجر

182
00:18:24,620 --> 00:18:25,290
.اسمعوا

183
00:18:25,450 --> 00:18:27,870
.اللّيل عند وقتِ الظهيرة على وشك أن يحدث

184
00:18:28,210 --> 00:18:29,710
وماذا سيحدث حينها؟

185
00:18:30,130 --> 00:18:32,460
.سيبتلع الظلام الشمس

186
00:18:32,630 --> 00:18:33,380
!ماذا؟

187
00:18:34,250 --> 00:18:37,510
.هذا الضوء هو إسقاطٌ للشمس

188
00:18:38,180 --> 00:18:39,840
.الشمس في أعلى ارتفاع لها

189
00:18:51,020 --> 00:18:52,360
.الضوء ينحسر

190
