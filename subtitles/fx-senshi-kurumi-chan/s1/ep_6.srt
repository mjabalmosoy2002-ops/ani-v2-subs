1
00:01:47,920 --> 00:01:50,500
ها قد عدتُ إلى ذلك من جديد

2
00:01:53,240 --> 00:01:56,150
إلى حفرة ساحة المعركة هذه

3
00:02:07,770 --> 00:02:12,580
لكن لن أشتبك في خطوط الجبهة
كبقيّة الفتيات

4
00:02:19,760 --> 00:02:23,540
سأقاتل فقط عندما أعتقد بأنّني أستطيع
الفوز والسّعي لأرباح صغيرة

5
00:02:27,690 --> 00:02:30,680
أن أكسب بما يكفي للعشاء اللّيلة

6
00:02:31,050 --> 00:02:34,050
...وأعتقد بأنّ أفضل زوج عملات لذلك هو

7
00:02:34,830 --> 00:02:36,340
!اليورو والدّولار الأمريكيّ

8
00:02:36,780 --> 00:02:40,350
إنّه ليس الين، وذلك لأنّ الإلمام
،اليابانيّ غير موجود هناك

9
00:02:40,620 --> 00:02:43,630
لكنّه زوج العملات ذو كمّية التّداوُل
الأعلى في العالم

10
00:02:43,630 --> 00:02:46,350
يمكنني توقُّع تحرُّكات مُتحفِّظة نسبيّاً

11
00:02:46,990 --> 00:02:50,840
لكن بأموالي الحاليّة، أستطيع
...فقط أن أتحمّل

12
00:02:50,840 --> 00:02:53,360
حصّة واحدة، أصغر طلب مُمكن

13
00:02:58,330 --> 00:03:00,370
لكن إذا اشتريتُ على أساس الارتفاع
،بهذا الثّمن المُنخفض

14
00:03:00,670 --> 00:03:04,870
أنا متأكّدة بأنّني أستطيع تناول
!طبق أرزّ تيمبورا على العشاء

15
00:03:11,660 --> 00:03:12,900
...شراء على أساس الارتفاع

16
00:03:13,910 --> 00:03:15,580
حصّة واحدة، إطلاق

17
00:03:19,960 --> 00:03:21,900
!ها هو يرتدّ

18
00:03:24,220 --> 00:03:25,640
!قد ينجح هذا

19
00:03:26,060 --> 00:03:28,900
!هل سأحصل على تحلية أيضاً؟

20
00:03:28,900 --> 00:03:32,910
!لا أتصوّر بأنّه سينخفض إلى ما دون 1.35

21
00:03:34,220 --> 00:03:37,400
ماذا؟ ي.ي\د.أ انخفض
إلى ما دون 1.35؟

22
00:03:40,590 --> 00:03:41,910
معكِ حقّ

23
00:03:41,910 --> 00:03:43,730
إنّه ينخفض بشدّة

24
00:03:43,730 --> 00:03:45,220
ماذا ستفعلين يا كورومي؟

25
00:03:45,220 --> 00:03:46,830
بعتُ على أساس الانخفاض بالفعل

26
00:03:46,830 --> 00:03:47,920
كان ذلك سريعاً

27
00:03:48,600 --> 00:03:51,980
رغم ذلك، قد يكون ذلك قراراً حكيماً

28
00:03:58,440 --> 00:04:01,020
حاولتُ البيع على أساس الانخفاض أيضاً

29
00:04:01,020 --> 00:04:03,450
بالمُناسبة، كم حصّة استهلكتِ؟

30
00:04:03,450 --> 00:04:05,110
أربعين

31
00:04:08,260 --> 00:04:09,970
دائماً ما تسعين للرّفع المالي العالي

32
00:04:15,790 --> 00:04:17,150
حقّاً؟

33
00:04:20,350 --> 00:04:22,610
هل هي حمقاء؟

34
00:04:23,760 --> 00:04:27,450
أخبرتُك يا أحمق! هنا تحين
!لحظة تعافيك

35
00:04:29,460 --> 00:04:31,030
!تبّاً لك

36
00:04:31,030 --> 00:04:34,960
!أتريدني أن أجوع إلى هذا الحدّ؟

37
00:04:38,100 --> 00:04:39,470
إنّه ينخفض من جديد

38
00:04:40,300 --> 00:04:41,470
!أنت من طلب ذلك

39
00:04:42,320 --> 00:04:44,090
!حاجز الإصبع

40
00:04:48,480 --> 00:04:50,030
!يكفي إلى هنا

41
00:04:50,030 --> 00:04:51,980
!لا يجوز أن تنخفض أكثر من ذلك

42
00:04:51,980 --> 00:04:54,500
!لأنّني نصبتُ حاجزاً للتو

43
00:04:59,400 --> 00:05:02,490
!أنتِ تفعلينها بشكل خاطئ يا حمقاء

44
00:05:04,050 --> 00:05:06,200
الفوريكس هي كتلة من التوتُّر والإجهاد

45
00:05:06,200 --> 00:05:08,030
!من ابتكره؟

46
00:05:11,000 --> 00:05:13,000
حان وقت إيقاف خسائري

47
00:05:15,380 --> 00:05:17,000
!اللّعنة

48
00:05:17,000 --> 00:05:18,010
انتظر فحسب

49
00:05:18,510 --> 00:05:21,510
!سأحرص على تعويضه دُفعة واحدة

50
00:05:21,980 --> 00:05:23,510
!القوّة الكاملة

51
00:05:23,890 --> 00:05:26,010
!الانتقال للبيع على أساس الانخفاض

52
00:05:30,200 --> 00:05:31,230
ماذا؟

53
00:05:32,670 --> 00:05:34,110
...هل يُعقَل

54
00:05:38,940 --> 00:05:43,280
كما في السّابق، تبيّن بأنّ هذا هو القعر؟

55
00:06:07,090 --> 00:06:10,680
إنّه ينخفض في النّهاية. تبّاً

56
00:06:23,240 --> 00:06:26,370
ميبوكي، لنذهب ونتسوّق

57
00:06:29,330 --> 00:06:33,710
صحيح، قالت بأنّها ستعود إلى منزل
عائلتها لقضاء استراحة الصّيف

58
00:06:35,650 --> 00:06:37,700
!ماذا؟

59
00:06:38,650 --> 00:06:43,140
كورومي-سينباي، ربحتِ 430.000 ين
!بزوج العملات ي.ي\د.أ؟

60
00:06:43,140 --> 00:06:45,670
ليتكِ أبلغتِني بذلك

61
00:06:45,670 --> 00:06:48,750
لكن يا ميبوكي-تشان، قلتِ بأنّها
كانت مُنافسة

62
00:06:49,640 --> 00:06:51,530
أتريدين عقد حلف إذاً؟

63
00:06:51,530 --> 00:06:52,910
حلف؟

64
00:06:52,910 --> 00:06:55,640
حلف لمُجاراة موتشيكو-سينباي

65
00:06:55,640 --> 00:06:57,600
بالتّأكيد، مُوافقة

66
00:06:58,520 --> 00:07:00,310
!هذه هي سينباي الّتي أعرفها

67
00:07:00,310 --> 00:07:03,720
لندخل صلبَ الموضوع، كيف
حال الجنيه اليوم؟

68
00:07:03,720 --> 00:07:05,270
الجنيه؟

69
00:07:06,720 --> 00:07:08,610
اليوم، قد أنتظر وأرى

70
00:07:08,610 --> 00:07:09,660
أتنتظرين وترين؟

71
00:07:10,190 --> 00:07:11,910
لن تشتري على أساس الارتفاع؟

72
00:07:11,910 --> 00:07:14,380
أعتقد بأنّه جاهز للارتفاع

73
00:07:14,790 --> 00:07:17,170
لا، سأكتفي بمُراقبته فحسب

74
00:07:19,550 --> 00:07:22,020
لكن يبدو أنّه من البديهيّ جدّاً أن يصعد

75
00:07:23,470 --> 00:07:25,170
بئس الأمر

76
00:07:25,170 --> 00:07:28,010
كان بمقدوركِ على الأقلّ المُساهمة
في تحضير الطّعام

77
00:07:28,010 --> 00:07:32,680
ارتأيتُ بأنّ حياتكِ بمفردكِ سيُفيدكِ من هذه
النّاحية، لكنّكِ زدتِ سوءاً الآن

78
00:07:33,850 --> 00:07:36,210
هل تُحافظين على نظافة وترتيب شقّتكِ؟

79
00:07:36,800 --> 00:07:37,940
!أجل، بالتّأكيد

80
00:07:37,940 --> 00:07:39,690
هذا لا يُصدَّق

81
00:07:39,690 --> 00:07:42,680
رُبّما تُسرفين معونتكِ الطلّابيّة أيضاً

82
00:07:42,680 --> 00:07:43,940
!ماذا؟

83
00:07:43,940 --> 00:07:46,840
أنا بارعة حقّاً في الادِّخار

84
00:07:46,840 --> 00:07:48,980
في الواقع، ليس بيدي حيلة

85
00:07:48,980 --> 00:07:52,280
إذاً يجدر بكِ أن تكوني قادرة على تسديد
نفقاتكِ المدرسيّة في عامكِ الرّابع

86
00:07:52,950 --> 00:07:55,220
ما زلتِ تتحدّثين عن ذلك؟

87
00:07:55,220 --> 00:07:57,710
أنتِ من قال بأنّكِ ستُسدّدينها

88
00:07:57,710 --> 00:07:59,460
لـ-لا مانع لديّ

89
00:07:59,820 --> 00:08:03,170
سئمتُ الحديث عن هذا! إنّه عشاء سيّئ

90
00:08:07,880 --> 00:08:08,930
بئس الأمر

91
00:08:09,380 --> 00:08:12,700
حسناً، يمكننا على الأقلّ تغطية
نفقاتها المدرسيّة

92
00:08:12,700 --> 00:08:15,550
رُبّما ستصبح ذات يوم عالِمة

93
00:08:15,550 --> 00:08:17,680
ليس بوضعها الرّاهن

94
00:08:18,180 --> 00:08:21,190
لا أتخيّل بأنّ أختي تستطيع فعلها

95
00:08:25,970 --> 00:08:28,070
سيَفي هذا بالغرض

96
00:08:28,070 --> 00:08:32,420
سأحقّق ربحاً هائلاً. ستكون النّفقات
!المدرسيّة أمراً يسيراً

97
00:08:34,580 --> 00:08:37,080
!الجنيه يرتفع

98
00:08:39,080 --> 00:08:41,150
كورومي-سينباي الغبيّة

99
00:08:41,150 --> 00:08:44,340
لو لم أنسحب من هذا، لكسبتُ
!بعض الأرباح الجيّدة

100
00:08:47,140 --> 00:08:50,830
ألستُ جاهزة للقتال بمفردي؟

101
00:08:51,630 --> 00:08:55,350
!سأتخطّى كورومي-سينباي بكثير

102
00:08:57,700 --> 00:09:01,390
!ج.إ\د.د، القوّة الكاملة، مئة حصّة

103
00:09:01,390 --> 00:09:03,270
!شراء على أساس الارتفاع، إطلاق

104
00:09:04,310 --> 00:09:10,610
بهذا التّداوُل، كان الرّفع الماليّ الّذي
طبّقَتْه ميبوكي حوالي 246 ضعف

105
00:09:10,610 --> 00:09:13,660
سأكسب ما يكفي للنّفقات المدرسيّة بلمح البصر

106
00:09:14,210 --> 00:09:18,750
إن وقع مكروه، فلن يكون لديها
حتّى وقت للتّفكير

107
00:09:19,810 --> 00:09:21,250
ستكون في عِداد الموتى

108
00:09:31,480 --> 00:09:36,220
!اصعد

109
00:09:46,290 --> 00:09:51,780
حركة السّعر الشّديدة هذه كانت بسبب
الإعلان عن مُؤشِّر اقتصاديّ

110
00:09:53,290 --> 00:09:56,350
المُؤشِّرات الاقتصاديّة هي إعلانات رسميّة روتينيّة

111
00:09:56,350 --> 00:10:00,250
للبيانات الاقتصاديّة بحسب البلدان حول العالم

112
00:10:00,840 --> 00:10:04,610
،تنعكس نصوصها في الأسواق الماليّة فوراً

113
00:10:04,610 --> 00:10:10,380
وباتت تُعرَف بزعزعة الأسواق المُستقرّة سابقاً أحياناً

114
00:10:13,880 --> 00:10:16,340
ماذا؟ ما الّذي يجري؟

115
00:10:20,930 --> 00:10:23,690
هذا أكثر من كافٍ للنّفقات المدرسيّة

116
00:10:23,690 --> 00:10:28,450
...رغم ذلك، حلم ميبوكي السّعيد

117
00:10:30,940 --> 00:10:34,530
دام لبضع عشرات من الثّواني فقط

118
00:10:37,950 --> 00:10:39,030
ماذا؟

119
00:10:43,320 --> 00:10:45,250
ماذا؟

120
00:10:46,070 --> 00:10:47,720
!ماذا؟

121
00:10:56,260 --> 00:10:58,020
هـ-هكذا إذاً

122
00:10:58,020 --> 00:11:01,180
،عندما يكون السُّوق مُنتفضاً هكذا
فإنّه يرتدّ بسرعة

123
00:11:01,510 --> 00:11:03,210
سأثبِّت عندما تصل المكاسب غير
المُحقَّقة إلى 500.000 ين

124
00:11:03,210 --> 00:11:06,190
لا، 200.000 ين

125
00:11:14,440 --> 00:11:17,760
لحظة، ما هذه التحرُّكات؟

126
00:11:24,910 --> 00:11:27,860
مُؤشِّر؟ كارني؟

127
00:11:31,500 --> 00:11:34,970
!أرجوك استخدم كلمات أفهمها

128
00:11:44,980 --> 00:11:48,210
إن كنتِ تعلمين، فليتكِ أخبرتِني

129
00:11:53,980 --> 00:11:56,850
!ماذا يعني إعلان هامّ؟

130
00:11:56,850 --> 00:11:58,540
عندما يصدر المسؤولون الدُّوليّون إعلانات

131
00:11:58,540 --> 00:12:03,390
،لها علاقة بالاقتصاد أو التّبادُل الأجنبيّ
،مثل المُؤشِّرات الاقتصاديّة

132
00:12:03,390 --> 00:12:07,250
فأحياناً يُشكّل ذلك تأثيراً واضحاً على الأسواق

133
00:12:08,220 --> 00:12:11,750
لكن رُبّما هذا يعني بأنّه
!سوف يُحلّق عالياً

134
00:12:12,780 --> 00:12:17,840
،أنا والجنيه بيننا كيمياء جيّدة
!لذا أنا متأكِّدة بأنّ كارني-سان سيُنقذني

135
00:12:19,840 --> 00:12:20,900
!ها هو ذا

136
00:12:20,900 --> 00:12:23,070
كارني-سان المُنقِذ؟

137
00:12:23,070 --> 00:12:25,640
!هذا مُطمئن

138
00:12:25,640 --> 00:12:28,640
شكراً لك يا كارني-سان

139
00:12:28,640 --> 00:12:31,060
—أنا حقّاً أقصد

140
00:12:34,570 --> 00:12:38,060
في هذا اليوم، حاكم المصرف المركزيّ
للمملكة المُتّحدة

141
00:12:38,060 --> 00:12:41,060
أعربَ عن رأي سلبيّ فيما يخصّ
زيادة نسبة الفائدة

142
00:12:41,060 --> 00:12:44,080
ما شجّعَ المُستثمرين بيع الجنيه
على أساس الانخفاض بشكل أكبر

143
00:12:51,080 --> 00:12:54,600
هل أنا... في ورطة؟

144
00:12:57,590 --> 00:13:01,090
ماذا يحدث إذا تجاوزت الخسائر غير المُحقَّقة
مقدار المال الّذي أملكه؟

145
00:13:01,460 --> 00:13:02,870
!هل سأغرق في الدَّين؟

146
00:13:02,870 --> 00:13:05,590
!لا، لا! لا أستطيع تحمُّل الدَّين

147
00:13:05,590 --> 00:13:08,310
!ماذا سأقول لأمِّي؟

148
00:13:09,600 --> 00:13:11,730
!أرجوك يا إلهي

149
00:13:11,730 --> 00:13:13,120
!أخرجني من هذا

150
00:13:13,120 --> 00:13:15,510
!لن أكون طمّاعة ثانية

151
00:13:28,160 --> 00:13:29,630
مرحباً

152
00:13:29,630 --> 00:13:32,110
مرحباً. كيف هي الأمور عندكِ؟

153
00:13:32,110 --> 00:13:34,130
في الواقع... جيّدة

154
00:13:34,130 --> 00:13:36,210
لا تبدين سعيدة جدّاً

155
00:13:36,210 --> 00:13:38,280
هل مررتِ بيوم سيّئ في الفوريكس؟

156
00:13:39,460 --> 00:13:41,120
قليلاً فقط

157
00:13:41,130 --> 00:13:42,360
كم؟

158
00:13:42,360 --> 00:13:45,140
لـ-ليس بالرّقم الضّخم

159
00:13:45,140 --> 00:13:47,680
ر-ربّما حوالي مئة ألف ين

160
00:13:47,680 --> 00:13:50,390
!يا للهول! تكبّدتِ خسارة كبيرة

161
00:13:50,390 --> 00:13:53,970
حسناً، ربّما يجدر بكِ الانسحاب
بما أنّ الفُرصة سانحة

162
00:13:53,970 --> 00:13:57,890
قبل أن تُقتَلي بتداوُل جنيه واحد

163
00:13:57,890 --> 00:14:00,020
أجل، شكراً

164
00:14:00,670 --> 00:14:02,350
أتواصل معكِ لاحقاً

165
00:14:04,900 --> 00:14:07,410
كذبتُ عليها

166
00:14:07,730 --> 00:14:11,910
أنا متأكّدة بأنّها ستقلق إذا قلتُ
بأنّها كانت خسارة كبيرة

167
00:14:14,260 --> 00:14:15,920
...لكن

168
00:14:16,340 --> 00:14:20,420
هذا يعني فقط بأنّ الـ 200.000 ين
الّتي بدأتُ بها قد تبخّرتْ

169
00:14:21,170 --> 00:14:22,940
...إن كان هذا كُلّ شيء

170
00:14:27,430 --> 00:14:30,530
أستطيع إنفاق بقيّة معونتي الطُلّابيّة

171
00:14:47,200 --> 00:14:50,040
ستبقين هنا لصيف آخر؟

172
00:14:50,040 --> 00:14:52,400
ألم تلغي مراسمَ بلوغكِ سنّ الرّشن أيضاً؟

173
00:14:52,400 --> 00:14:54,130
ما أهمّية ذلك؟

174
00:14:54,130 --> 00:14:57,030
لِمَ أكلّف نفسي بتجمُّع للمغرورين كالطّاووس؟

175
00:14:57,030 --> 00:14:58,960
أنتِ بطّة عجوز

176
00:15:00,250 --> 00:15:03,190
كان ليتمنّى والداكِ رؤيتكِ بالفستان

177
00:15:03,970 --> 00:15:06,490
من يكترث لوالدَي؟

178
00:15:06,490 --> 00:15:08,240
لكن مهلاً، انظري إلى هذا

179
00:15:08,970 --> 00:15:11,090
زوج اليورو والدّولار الأمريكيّ يبدو قاتماً

180
00:15:11,090 --> 00:15:14,980
،يا إلهي! لو بعتُ على أساس الانخفاض
لحقّقتُ مكاسبَ هائلة

181
00:15:14,980 --> 00:15:18,080
على أيّ حال، كنتِ تكسبين كثيراً مُؤخّراً

182
00:15:18,080 --> 00:15:20,630
ألن يكون من السّهل تحقيق العشرين
مليون ين الّتي تستهدفينها؟

183
00:15:20,630 --> 00:15:23,230
لا أتعامل مع الأمر بهذه الطّريقة

184
00:15:23,510 --> 00:15:26,040
،عندما تحسبين الضّرائب المُترتّبة عليّ

185
00:15:26,040 --> 00:15:28,600
فإنّ هدفي الحقيقيّ هو 25 مليون

186
00:15:28,600 --> 00:15:30,240
...ما زلتُ بعيدة

187
00:15:30,240 --> 00:15:33,240
إذاً أعتقد بأنه سيترتّب عليكِ أن تكوني
جريئة في الرّفع الماليّ

188
00:15:33,520 --> 00:15:35,750
أجل، هذه هي النيّة

189
00:15:35,750 --> 00:15:37,940
هكذا إذاً

190
00:15:38,580 --> 00:15:40,960
إذاً، ما زوج العملة الّذي تستهدفينه حاليّاً؟

191
00:15:40,960 --> 00:15:43,310
أعتقد فقط د.أ\ي.ي

192
00:15:43,310 --> 00:15:47,090
في الواقع، اشتريتُ على أساس الارتفاع
بالفعل أثناء الدّرس

193
00:15:47,090 --> 00:15:48,930
أنتِ مُدمنة

194
00:15:48,930 --> 00:15:53,430
،حسناً، ي.ي\د.أ راكِد
...ويبدو الـ د.أ\ي.ي سيرتفع غالباً

195
00:16:01,650 --> 00:16:03,450
ارتفع قليلاً

196
00:16:03,450 --> 00:16:06,580
ربّما كان ينبغي أن أشتري المزيد

197
00:16:11,200 --> 00:16:15,050
بالمُناسبة. هل سمعتِ بشيء من ميبوكي-تشان مؤخّراً؟

198
00:16:15,050 --> 00:16:18,010
ليس منذ الأوبون

199
00:16:18,360 --> 00:16:20,930
غالباً تعيش حياتها في الدّيار

200
00:16:23,460 --> 00:16:25,960
!لن أخفق ثانية أبداً

201
00:16:26,810 --> 00:16:29,130
أموالي هذه المرّة هي الستّمئة ألف ين

202
00:16:29,130 --> 00:16:30,470
!الّتي ادّخرتُها لنفقات المدرسة

203
00:16:30,850 --> 00:16:33,970
إنّها ليست مُستحَقّة قبل ربيع
العام المُقبل، لذا لا مُشكلة

204
00:16:34,380 --> 00:16:39,480
هدفي الأوّليّ هو استعادة الـ 200
!ألف ين الأصليّة

205
00:16:39,480 --> 00:16:42,940
إذا جنيتُ أكثر من 200 ألف ين
كأرباح، فسأنطلق فوراً

206
00:16:42,940 --> 00:16:45,480
!وأعيد الستّمئة ألف إلى مُدّخرات

207
00:16:45,480 --> 00:16:48,240
...وستكون ساحة معركتي التّالية

208
00:16:48,640 --> 00:16:50,240
!د.أ\ي.ي

209
00:16:50,610 --> 00:16:52,670
،خدمتُ في خنادق الجنيه

210
00:16:52,670 --> 00:16:55,240
لذا لن أخسر أبداً مع زوج
!العملات التّافه هذا

211
00:16:57,640 --> 00:17:00,750
ياسكو-تشان، لا حاجة للقلق

212
00:17:03,930 --> 00:17:07,760
والآن جاري البدء بمهمّتي لاستعادة المئتي ألف ين

213
00:17:09,760 --> 00:17:13,510
،بالنّظر إلى الـ د.أ\ي.ي الآن
أيّ شخص سيخطر على باله ذلك

214
00:17:13,880 --> 00:17:16,700
!سيصل قمّته عند 105 ين في هذا العام

215
00:17:16,700 --> 00:17:18,600
!مُحال أن يرتفع أكثر

216
00:17:18,600 --> 00:17:20,230
لن يرتفع الآن على الأغلب

217
00:17:20,230 --> 00:17:23,310
هذا ما يعتقده الجميع، لذا ستكون
هناك فورة بيع

218
00:17:23,710 --> 00:17:26,370
!من الأفضل أن أبيع قبل أن ينخفض

219
00:17:26,370 --> 00:17:28,860
!البيع على أساس الانخفاض

220
00:17:26,370 --> 00:17:28,860
،ثمّ يؤدّي البيع إلى مزيد من البيع

221
00:17:28,860 --> 00:17:30,540
!وسينخفض بصورة فظيعة

222
00:17:30,540 --> 00:17:32,840
!أنا واثقة أنّه سينخفض إلى مئة ين حتّى

223
00:17:33,480 --> 00:17:35,570
،حتّى لو لم يصل إلى تلك النّقطة

224
00:17:35,570 --> 00:17:38,370
!انخفاض 2 ين يعني ربح 200.000 ين

225
00:17:38,370 --> 00:17:40,230
!سأنجز هدفي

226
00:17:40,230 --> 00:17:44,380
!هذا منطق مثاليّ

227
00:17:48,650 --> 00:17:50,380
لماذا؟

228
00:17:50,380 --> 00:17:52,990
لماذا ارتفع قرابة الواحد ين؟

229
00:17:56,610 --> 00:17:59,090
ميبوكي، ماذا تفعلين؟

230
00:17:59,090 --> 00:18:01,550
أم تكوني عائدة إلى شقّتكِ المدرسيّة اليوم؟

231
00:18:04,770 --> 00:18:07,390
إ-إنّه يرتفع حاليّاً فقط على الأغلب

232
00:18:07,390 --> 00:18:09,880
عليّ الإيمان بمنطقي المثاليّ

233
00:18:10,400 --> 00:18:12,370
ألم تنسي شيئاً؟

234
00:18:12,370 --> 00:18:13,380
لا

235
00:18:13,380 --> 00:18:16,150
ما خطبكِ؟ تبدين شاحبة

236
00:18:16,150 --> 00:18:18,380
ميبوكي، هل أنتِ بخير؟

237
00:18:18,380 --> 00:18:19,820
هل حدث شيء؟

238
00:18:19,820 --> 00:18:22,410
لا، كُلّ شيء على ما يُرام

239
00:18:22,410 --> 00:18:24,260
حسناً، إلى اللّقاء

240
00:18:25,160 --> 00:18:27,480
!ادرسي بجدّ، واحرصي على الأكل بما يكفي

241
00:18:27,480 --> 00:18:28,420
!إلى اللّقاء

242
00:18:29,880 --> 00:18:33,170
،في وقت لاحق، استمرَّ الـ د.أ\ي.ي في الصُّعود

243
00:18:33,170 --> 00:18:38,180
ووصل سعر الإغلاق في نهاية
الأسبوع إلى 1$ = 107 ين

244
00:18:41,840 --> 00:18:43,690
!انخفض بسرعة

245
00:18:48,000 --> 00:18:49,690
حسناً، لا يهمّ

246
00:18:51,190 --> 00:18:56,700
:حدث كبير على وشك الحدوث
مُؤشِّر ف.أو.أم.سي الاقتصاديّ

247
00:18:57,740 --> 00:19:00,700
،ينبغي لهذا أن يحفّز بداية هبوط

248
00:19:01,270 --> 00:19:04,270
!ليجلب اليأس لجميع من اشترى

249
00:19:07,300 --> 00:19:08,680
أرجوك

250
00:19:18,960 --> 00:19:20,970
!هـ-ها هو ذا

251
00:19:22,970 --> 00:19:27,160
!هيّا! حان وقت الهبوط من الجحيم

252
00:19:27,980 --> 00:19:30,440
ماذا؟

253
00:19:39,480 --> 00:19:40,840
لماذا؟

254
00:19:55,440 --> 00:19:57,340
!أنا غاضبة الآن

255
00:19:59,720 --> 00:20:01,350
!نوبة غضب إضافيّة

256
00:20:01,350 --> 00:20:03,350
!عشرة حصص، إطلاق

257
00:20:08,390 --> 00:20:09,980
!ما رأيك بذلك؟

258
00:20:31,500 --> 00:20:33,460
انسي الأمر

259
00:20:33,890 --> 00:20:37,040
!سأنام! لا مزيد من مُراقبة الرّسم البيانيّ

260
00:20:50,530 --> 00:20:53,650
أتساءل ما حدث مع الـ د.أ\ي.ي

261
00:20:54,070 --> 00:20:57,430
بعتُ على أساس الانخفاض بعشرة
،حصص إضافيّة من قبل

262
00:20:57,430 --> 00:21:01,660
لذا أستطيع مُواصلة القتال حتّى 109.6 ين

263
00:21:02,300 --> 00:21:04,120
هل ما زال يصمد؟

264
00:21:11,810 --> 00:21:13,670
!ين ونصف آخر

265
00:21:13,670 --> 00:21:17,670
إذا صعدَ ين ونصف، فسأخسر
كُلّ أموالي المدرسيّة

266
00:21:21,870 --> 00:21:24,690
سيغضبون منّي كثيراً

267
00:21:24,690 --> 00:21:27,550
كانوا قلقين بالفعل أصلاً

268
00:21:29,530 --> 00:21:32,520
!ادرسي بجدّ، واحرصي على الأكل بما يكفي

269
00:21:36,910 --> 00:21:38,280
لماذا؟

270
00:21:38,280 --> 00:21:40,980
لماذا آلت الأمور إلى هذا؟

271
00:21:43,690 --> 00:21:45,500
!يجب أن أعوّضه

272
00:21:46,500 --> 00:21:48,000
!مهما كلّف الأمر

273
00:23:19,920 --> 00:23:21,550
ميبوكي، هل كنتِ تعلمين؟

274
00:23:21,550 --> 00:23:26,300
يطلقون عليه برسم الشّمعدان البيانيّ لأنّه
يبدو فعلاً مثل الشّمعدان

275
00:23:26,300 --> 00:23:30,010
...هكذا إذاً

276
00:23:30,010 --> 00:23:34,120
!مهلاً! شمعة حياتكِ على وشك أن تُطفَأ