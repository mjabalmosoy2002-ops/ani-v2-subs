1
00:00:00,600 --> 00:00:01,730
!اخرج إلينا

2
00:00:01,730 --> 00:00:03,690
!نعلمُ بأنّك مختبئ هناك

3
00:00:03,690 --> 00:00:06,190
!اخرجوه إلى المنصّة

4
00:00:09,440 --> 00:00:12,280
!هيبيكي-تشان، أنا خائفة

5
00:00:12,280 --> 00:00:13,660
.سيكون كلّ شيءٍ على ما يرام

6
00:00:16,490 --> 00:00:18,120
ما الذّي يجدرُ بي فعله؟

7
00:00:18,120 --> 00:00:20,290
...على هذا الحال، نيكو-كن والبقيّة سـ

8
00:00:24,670 --> 00:00:25,960
!ها قد أتوا

9
00:00:25,960 --> 00:00:26,960
!هذا هو

10
00:00:27,630 --> 00:00:29,340
!الشخص الموجود مع كويوكي-تشان في الصورة

11
00:00:31,670 --> 00:00:32,720
.سيكون كلّ شيءٍ على ما يرام

12
00:00:34,010 --> 00:00:35,680
،طالما أنّني مع هؤلاء الأعضاء

13
00:00:36,340 --> 00:00:37,850
!سأتمكّنُ من القيام بأيّ شيء

14
00:00:49,320 --> 00:00:50,650
!من الأفضل لك تقديم اعتذار

15
00:00:52,400 --> 00:00:55,160
!اجثِ على ركبتيكَ

16
00:00:56,160 --> 00:00:57,740
.هذا رائع، رائع

17
00:00:57,740 --> 00:00:59,620
.لقد وقفوا على المنصّة حقًّا

18
00:01:03,080 --> 00:01:03,960
!لا تتجاهلوننا

19
00:01:03,960 --> 00:01:05,790
!سنقوم بفضحكم

20
00:01:08,040 --> 00:01:09,790
!إذن، فلنبدأ، يو-كن

21
00:01:10,210 --> 00:01:11,090
.أجل

22
00:01:13,050 --> 00:01:16,430
...بمجرّد ما نبدأ، متأكّد بأنّ الجميع سيُذهل

23
00:01:16,430 --> 00:01:18,090
!بغناء آكيتسكي

24
00:01:18,090 --> 00:01:20,140
!لا تتجاهلنا

25
00:01:22,600 --> 00:01:24,230
!لقد أصاب الهدف

26
00:01:24,230 --> 00:01:25,730
!يو-كن

27
00:01:25,730 --> 00:01:27,520
!هوي، هل أنت بخير، هارونا؟

28
00:01:29,730 --> 00:01:30,690
!مـ-ما الذّي سأفعله؟

29
00:01:31,320 --> 00:01:31,980
...الباص قد

30
00:01:37,530 --> 00:01:38,820
!لقد حان وقت الرمية الثانية

31
00:01:38,820 --> 00:01:40,530
!صوّب نحو رأسه، نحو رأسه

32
00:01:45,710 --> 00:01:47,620
!ما الذّي تحاول فعله لأخي الصغير؟

33
00:01:48,040 --> 00:01:49,130
هاه؟

34
00:01:50,170 --> 00:01:53,210
!هوي، يبدو بأنّ عائلة عازف الباص قد أتت إلى هنا أيضًا

35
00:01:51,170 --> 00:01:52,300
!مهلًا

36
00:01:53,210 --> 00:01:54,510
ما الذّي يجدرُ بنا فعله بهم؟

37
00:01:54,510 --> 00:01:56,050
هل أنت جاد؟! أين؟

38
00:01:56,050 --> 00:01:57,720
!على العائلة بأكملها تقديم اعتذار

39
00:01:57,720 --> 00:01:58,930
!اعتذروا، اعتذروا

40
00:01:58,930 --> 00:02:00,220
!هذا صحيح، صحيح

41
00:02:00,220 --> 00:02:01,430
!توقّفوا رجاءً

42
00:02:01,430 --> 00:02:02,560
!هاه؟

43
00:02:03,010 --> 00:02:04,270
...إن كنتم ترغبون في سماع اعتذار

44
00:02:04,810 --> 00:02:05,770
!سأقدّمه أنا لكم

45
00:02:06,560 --> 00:02:07,600
كويوكي-تشان؟

46
00:02:07,940 --> 00:02:08,980
هاه؟

47
00:02:08,980 --> 00:02:10,270
.مستحيل

48
00:02:10,270 --> 00:02:11,020
لماذا؟

49
00:02:11,270 --> 00:02:12,440
!إنّها هيناشي كويوكي

50
00:02:12,440 --> 00:02:13,820
!لقد أتت إلى هنا حقًّا

51
00:02:13,940 --> 00:02:14,900
!توقّفوا رجاءً

52
00:02:15,570 --> 00:02:18,530
!تـ-توقّفوا! توقّفوا رجاءً

53
00:02:20,870 --> 00:02:21,780
!توقّفوا

54
00:02:21,780 --> 00:02:22,910
!سنستدعي الشرطة

55
00:02:24,160 --> 00:02:25,040
!اللعنة

56
00:02:25,040 --> 00:02:26,250
!يوجدُ الكثير من الأشخاص

57
00:02:30,080 --> 00:02:31,420
.من الأفضل لك العدول عن ذلك

58
00:02:31,420 --> 00:02:33,670
.حتّى وإن ذهبت، لن تتمكّن من فعل أيّ شيء

59
00:02:33,670 --> 00:02:35,420
...و-ولكن

60
00:02:36,420 --> 00:02:40,430
...عائلتي وأصدقائي يعانون أمام ناظري

61
00:02:45,430 --> 00:02:46,770
.هذا مثيرٌ للإهتمام

62
00:02:46,770 --> 00:02:49,060
.بثّ مباشر، بثّ مباشر بالتأكيد

63
00:03:03,280 --> 00:03:06,200
.يامادا-سان، القي نظرةً على هذا من فضلك

64
00:03:07,120 --> 00:03:08,580
ماذا؟ ما الأمر؟

65
00:03:08,580 --> 00:03:09,870
...عذرًا، هذا

66
00:03:10,960 --> 00:03:12,460
!ابحث عن مكان هذه المدرسة

67
00:03:12,460 --> 00:03:14,590
!واجعلهم يوقفون ذلك في الحال

68
00:03:14,590 --> 00:03:15,840
!كويوكي-تشان

69
00:03:15,840 --> 00:03:17,460
!تنحَّ جانبًا يا هذا

70
00:03:19,090 --> 00:03:19,590
!ماذا؟

71
00:03:19,590 --> 00:03:21,470
!من الذّي قام باطفاء الأضواء؟

72
00:03:21,470 --> 00:03:23,390
!لا أستطيعُ معرفة مكان كويوكي-تشان

73
00:03:23,390 --> 00:03:25,100
!ما الذّي يجري؟

74
00:03:26,310 --> 00:03:28,140
!ما الذّي قام بالدوس على قدمي؟

75
00:03:50,370 --> 00:03:52,540
.والآن، فلنبدأ

76
00:04:24,860 --> 00:04:27,530
...يا له من صوتٍ قوّي الصدّى

77
00:04:33,080 --> 00:04:35,670
ذلك الباص...أليس الخاصّ بـ نيكو؟

78
00:04:36,250 --> 00:04:38,090
.اعتقدُ بأنّ يا-سان قد أحضره معه

79
00:04:38,590 --> 00:04:39,250
...ألا

80
00:04:39,250 --> 00:04:41,340
تعتقدُ أنّ تلك المغنيّة جيّدة؟

81
00:04:41,340 --> 00:04:42,470
...اوه، أجل

82
00:04:42,470 --> 00:04:43,510
.بالفعل

83
00:04:56,400 --> 00:04:58,150
!كلاّ، بل مذهلة

84
00:04:58,150 --> 00:05:00,780
!تلك المغنيّة مذهلةٌ حقًّا

85
00:05:00,780 --> 00:05:01,940
.وليست المغنيّة فحسب

86
00:05:02,240 --> 00:05:04,530
!عازفة الغيتار بارعةٌ للغاية أيضًا

87
00:05:06,820 --> 00:05:09,490
.ذلك بأنّني قمتُ بتعليمها كلّ شيءٍ من البداية

88
00:05:10,330 --> 00:05:13,910
.ذلك الفتى ميكاسا أيضًا، إنّه ليس في مستوى الهوّاة

89
00:05:13,910 --> 00:05:18,290
.إنّه بطلُ مسابقة البيانو الدوليّة للناشئين

90
00:05:20,670 --> 00:05:22,760
!اوه! ميكاسا-كن

91
00:05:22,760 --> 00:05:24,970
!ناتشي-سينباي، أنت رائعٌ أيضًا

92
00:05:30,010 --> 00:05:33,350
.إنّه يفقد نمط الإيقاع المتكرّر حينما يبدأُ بالإرتجال في القرع

93
00:05:33,350 --> 00:05:34,890
.لا يزالُ أمامه الكثير ليتعلّمه

94
00:05:42,070 --> 00:05:44,400
.لقد أصبحوا هادئين ومنصاعين بالكامل

95
00:06:05,670 --> 00:06:07,220
.مذهل

96
00:06:14,430 --> 00:06:16,100
.عارف الباص ليس سيّئًا أيضًا

97
00:06:16,100 --> 00:06:17,810
....إنّه رائع

98
00:06:17,810 --> 00:06:19,560
.آداءه أفضل من العاديّ

99
00:06:22,570 --> 00:06:23,980
!يو-ني رائعٌ للغاية

100
00:06:23,980 --> 00:06:24,690
أليس كذلك؟

101
00:06:47,840 --> 00:06:49,840
...الجوّ المحيط بالمكان

102
00:06:49,840 --> 00:06:51,890
!تغيرّ بالكامل عمّا كان عليه قبل لحظات

103
00:07:03,190 --> 00:07:04,020
!كويوكي-تشان

104
00:07:04,020 --> 00:07:05,360
!فلنغنّي معًا

105
00:07:10,360 --> 00:07:11,570
!مهلًا...آ-آكيتسكي

106
00:07:11,950 --> 00:07:13,070
!بسرعة

107
00:07:19,210 --> 00:07:21,710
.لقد أصبحت حفلةً صاخبةً بالكامل

108
00:07:24,130 --> 00:07:25,960
كلاكما، ما الذّي تحاو ـــ

109
00:07:25,550 --> 00:07:26,550
.هارونا

110
00:07:27,210 --> 00:07:29,380
.ستهدرُ وقتك بالتذمّر فحسب

111
00:07:31,010 --> 00:07:31,970
!هاه؟

112
00:07:31,970 --> 00:07:34,510
أتعرفين أغنيّة فرقة القنافذ، "المدينة التّي تساقطت النجوم عليها"؟

113
00:07:34,850 --> 00:07:35,640
.أجل

114
00:07:35,640 --> 00:07:36,970
.أنا أحبّها كثيرًا

115
00:07:37,520 --> 00:07:40,390
!إذن، في الآداء الثاني، سنقوم بالغناء معًا

116
00:07:40,890 --> 00:07:42,350
."أغنية "المدينة التّي تساقطت عليها النجوم

117
00:08:04,420 --> 00:08:06,790
تغنّيان بشكلٍ موحّد بدلًا من التناغم؟

118
00:08:06,790 --> 00:08:08,710
.يبدو بأنّ تلك الفنّانة من النوع الذّي يكره الخسارة

119
00:08:58,510 --> 00:09:01,770
.كما توقّعت، إنّهما مذهلتان، كلاهما

120
00:09:38,050 --> 00:09:39,050
!هذا مذهل

121
00:09:39,050 --> 00:09:40,600
!أنا مسرورٌ لقدومي إلى هنا

122
00:09:40,600 --> 00:09:41,680
!لقد تأثّرتُ تمامًا

123
00:09:42,100 --> 00:09:43,020
!شكرًا

124
00:09:43,520 --> 00:09:45,940
!أن أتمكّن من الغناء مع كويوكي-تشان، هذا أشبه بالحلم

125
00:09:46,190 --> 00:09:48,310
.لقد استمتعتُ أنا أيضًا

126
00:09:48,310 --> 00:09:49,860
.غنائك جيّدٌ أيضًا

127
00:09:49,860 --> 00:09:52,190
!أنا سعيدة! شكرًا

128
00:09:55,950 --> 00:10:01,280
.جميعًا، والآن أريدُ الاعتذار عن افعالي الطائشة

129
00:10:01,280 --> 00:10:03,660
.تقبّلوا خالص اعتذاراتي

130
00:10:04,450 --> 00:10:07,290
.أعتقدُ بأنّني أستحقُ أيّ شيءٍ قد يُقال عنّي

131
00:10:07,870 --> 00:10:12,800
.ولكن، هو وعائلته لا علاقة لهم بالموضوع

132
00:10:13,300 --> 00:10:15,800
.يقعُ كلّ اللوم على عاتقي ولوحدي

133
00:10:17,340 --> 00:10:19,470
.حقًّا...أنا آسفة

134
00:10:26,600 --> 00:10:28,390
!كويوكي-تشان، أنتِ لم ترتكبي أيّ خطأ

135
00:10:29,810 --> 00:10:32,110
!كلّ ما قمتِ به كان الإعتراف بحبّكِ للشخصِ الذّي تحبّينه فحسب

136
00:10:32,110 --> 00:10:33,610
!لا شيء يدعو للاعتذار

137
00:10:33,610 --> 00:10:35,070
!هذا صحيح

138
00:10:35,070 --> 00:10:37,610
!نحنُ نشجّعكِ، لذا ابذلي جهدكِ

139
00:10:37,610 --> 00:10:38,860
!سنقوم بتشجيعكِ

140
00:10:38,860 --> 00:10:40,870
!أغنيّتكِ الجديدة رائعةٌ للغاية

141
00:10:45,080 --> 00:10:46,660
.شكرًا جزيلًا

142
00:10:55,130 --> 00:10:59,050
!والآن، فلنقم بآداء أغنيةٍ أخرى

143
00:11:05,970 --> 00:11:07,770
!عملٌ رائع

144
00:11:08,640 --> 00:11:10,480
،لم أكن متأكّدًا ممّا قد يحدث

145
00:11:10,480 --> 00:11:11,770
.ولكن أعتقدُ بأنّنا تمكّنا من فعلها بطريقةٍ ما

146
00:11:12,020 --> 00:11:13,190
.هذا صحيح

147
00:11:13,190 --> 00:11:15,570
.لقد استمتع الجمهور أيضًا

148
00:11:15,570 --> 00:11:17,780
يو-سان، لقد كان عزفك على الباص مذهلًا ـــ

149
00:11:17,780 --> 00:11:18,570
!أجل، أجل

150
00:11:18,570 --> 00:11:19,860
!لقد كنت رائعًا

151
00:11:21,030 --> 00:11:22,660
...شـ-شكرًا

152
00:11:23,370 --> 00:11:25,790
،اوه، بالمناسبة، آكيتسكي

153
00:11:25,790 --> 00:11:29,040
.لقد رأيتُ تتحدّثين مع شخصٍ من بين الحشد بعد الحفلة

154
00:11:29,040 --> 00:11:30,250
عن ماذا تحدّثتما؟

155
00:11:31,830 --> 00:11:33,540
.سألتني عن اسم فرقتنا

156
00:11:33,880 --> 00:11:34,500
.هذا صحيح

157
00:11:34,500 --> 00:11:36,550
.نحنُ لم نقرّر ذلك بعد

158
00:11:36,550 --> 00:11:38,050
.هذا صحيح

159
00:11:38,050 --> 00:11:40,720
.لا يمكننا الاستمرار في دعوة أنفسنا بـ " الناديّ الموسيقيّ" فحسب

160
00:11:41,930 --> 00:11:43,510
ولكن، كيف يجدرُ بنا تقرير ذلك؟

161
00:11:43,510 --> 00:11:44,850
...هذا صحيح

162
00:11:44,850 --> 00:11:47,180
ربّما يجدرُ بنا استخدام اسماء أعضاء الفرقة؟

163
00:11:56,320 --> 00:11:57,690
؟"fall moon"

164
00:11:57,690 --> 00:11:59,490
بالإنجليزية؟ "Autumn" أليس الخريف هو

165
00:11:59,490 --> 00:12:01,860
.تعني الخريف أيضًا "fall" كلاّ، كلمة

166
00:12:02,950 --> 00:12:05,530
.اعتقدُ بأنّ هذا جيّد

167
00:12:06,780 --> 00:12:08,080
"Fall Moon."

168
00:12:08,490 --> 00:12:11,040
..."The fallen" ولكن هل سيبدو أفضل من الناحية اللغوية إن قلنا

169
00:12:11,040 --> 00:12:13,580
.أجل. هذا أفضل لاسم فرقتنا

170
00:12:13,580 --> 00:12:15,080
...القمر الساقط

171
00:12:15,540 --> 00:12:17,170
"The Fallen Moon."

172
00:12:17,170 --> 00:12:18,920
.يبدو شاعريًّا. قد يكون خيارًا جيّدًا

173
00:12:19,340 --> 00:12:20,010
!مهلًا

174
00:12:20,340 --> 00:12:22,840
...سيجعلني ذلك أبدو كما لو أنّني شخصٌ مغرور

175
00:12:22,840 --> 00:12:25,140
.قام بإرغام مجموعةٍ من الأشخاص على تشكيل هذه الفرقة

176
00:12:31,730 --> 00:12:32,520
...حسنًا

177
00:12:32,520 --> 00:12:33,440
.لقد قمتِ بذلك

178
00:12:34,350 --> 00:12:35,690
.هذا صحيح

179
00:12:35,690 --> 00:12:37,190
.لا أستطيعُ إنكار ذلك

180
00:12:42,400 --> 00:12:43,860
!حسنًا إذن

181
00:12:43,860 --> 00:12:45,950
!لا تتذّمروا عليّ لاحقًّا

182
00:12:53,960 --> 00:12:55,830
.ولقد حصل على العديد من المشاهدات أيضًا

183
00:12:56,250 --> 00:12:58,380
.لقد تسبّبت تلك التغريدة السابقة في لفت الكثير من الإنتباه

184
00:12:58,380 --> 00:13:01,170
.وقدوم هيناشي كويوكي إلى الحفلّ أثرّ في ذلك أيضًا

185
00:13:01,170 --> 00:13:02,420
،بعد الحفل

186
00:13:03,010 --> 00:13:05,220
.قام شخصٌ من وكالتها بأخدها معه

187
00:13:05,680 --> 00:13:07,350
أكانت بخير؟

188
00:13:09,760 --> 00:13:10,930
.لا أدري

189
00:13:11,270 --> 00:13:13,980
.إنّها ليست في نفس الموقف الذّي نحنُ عليه

190
00:13:29,370 --> 00:13:32,080
.لقد تلقّينا بعض التوبيخات من الرئيس

191
00:13:32,080 --> 00:13:33,870
.إنّه شخصٌ كثير التذمّر

192
00:13:34,460 --> 00:13:36,040
.أنا آسفة

193
00:13:36,040 --> 00:13:37,210
.هذا خطئي

194
00:13:37,580 --> 00:13:38,750
.لا تهتمّي بالأمر، لا تهتمّي

195
00:13:39,340 --> 00:13:41,250
الأكثر أهميّة، عديني

196
00:13:41,250 --> 00:13:44,550
.بأنّكِ لن تتصرّفي على هذا النحو من تلقاء نفسكِ مجدّدًا على الإطلاق

197
00:13:45,800 --> 00:13:46,680
.حسنًا

198
00:13:47,010 --> 00:13:47,720
...وكذلك

199
00:13:47,720 --> 00:13:50,010
هارونا-كن، أليس كذلك؟

200
00:13:50,010 --> 00:13:52,600
.أريدُ منكِ قطع اتّصالاتكِ معه لفترة

201
00:13:54,140 --> 00:13:56,940
،نحنُ لا نعلمُ ما قد يسبّبُ لنا جلبةٍ أخرى

202
00:13:56,940 --> 00:13:59,610
.وأنا لا أريدُ تعريضكِ للخطر

203
00:14:01,650 --> 00:14:02,480
.حسنًا

204
00:14:05,240 --> 00:14:07,530
.حسنًا، كفاكٍ شعورًا بالسوء

205
00:14:07,530 --> 00:14:10,240
.فلنبدأ في التعويض عن كلّ شيءٍ بعملكِ

206
00:14:10,870 --> 00:14:12,790
...إذن، بالنسبة لجدول أعمالكِ

207
00:14:12,790 --> 00:14:15,160
،ستهتمُّ الوكالة بالصحافة

208
00:14:15,160 --> 00:14:17,870
.لذا لا حاجةَ لكِ للقلقِ بشأن العمل

209
00:14:17,870 --> 00:14:19,830
،وكذلك، بالنسبة لحفلتك

210
00:14:19,830 --> 00:14:22,210
...تمّ تحديد كلٍّ من الاستوديو الخاص بتمريناتك ومواعيدها، لذا

211
00:14:39,560 --> 00:14:41,860
!يوجدُ الكثير من المواد في الاختبارات النهائيّة

212
00:14:40,690 --> 00:14:42,610
.لقد كان البردُ قارسًا في الصباح

213
00:14:43,020 --> 00:14:46,440
إذن، هارونا، هل تمكّنت من الاتصّال بـ هيناشي كويوكي؟

214
00:14:47,650 --> 00:14:49,700
.كلاّ، ولا مرّة واحدة منذُ تلك الحادثة

215
00:14:49,700 --> 00:14:51,410
...هكذا إذن

216
00:14:51,410 --> 00:14:53,080
.هذا محيّر

217
00:14:54,120 --> 00:14:55,290
!يو-سان، القِ نظرةً على هذا

218
00:14:56,290 --> 00:14:57,120
ماذا؟

219
00:14:57,120 --> 00:14:58,210
ما الأمر؟

220
00:15:45,880 --> 00:15:47,000
...تاما-تشان

221
00:15:52,220 --> 00:15:55,180
."إذن، فلنقم بتأدية أغنية "ألعاب نارٍ ثلجيّة

222
00:15:55,180 --> 00:15:56,010
.حسنًا

223
00:15:57,010 --> 00:15:59,520
.هذا هو العمل الوحيد المتبقيّ لديّ

224
00:15:59,520 --> 00:16:01,730
...عليّ تقديم حفلةٍ رائعة

225
00:16:06,820 --> 00:16:09,820
.من أجل الأشخاص الذّين أحبّوا غنائي

226
00:16:30,090 --> 00:16:31,800
أيوجدُ خطبٌ ما، كويوكي-تشان؟

227
00:16:31,800 --> 00:16:33,380
.اوه...كلاّ

228
00:16:33,590 --> 00:16:35,510
.إذن، فلنقم بذلك مرّةً أخرى

229
00:16:46,560 --> 00:16:47,690
...إنّ صوتي

230
00:17:04,370 --> 00:17:07,130
....لقد تحدّثتُ مع الرئيس للتّو

231
00:17:08,340 --> 00:17:09,340
.أجل

232
00:17:09,670 --> 00:17:13,010
.قال أنّه من الأفضل لكِ عدم القيام بأيّ أعمالٍ غنائية لفترة من الزمن

233
00:17:13,380 --> 00:17:15,340
إذن، حتّى من حفلة عيد الميلاد؟

234
00:17:15,340 --> 00:17:16,010
.أجل

235
00:17:16,550 --> 00:17:17,640
!مهلًا رجاءً

236
00:17:17,640 --> 00:17:18,760
...ذلك

237
00:17:19,890 --> 00:17:22,810
،أخبرنا الطبيب لذلك أيضًا، قال بأنّ هذا قد يكون نتيجة لشدّة التوتّر

238
00:17:22,810 --> 00:17:24,810
.لذا يجدرُ بك أخذُ قسطٍ من الراحة

239
00:17:24,810 --> 00:17:26,650
.خذي عطلة في الوقت الراهن

240
00:17:26,650 --> 00:17:28,810
.أنا لا أريدُ تحميلكِ ما لا طاقة لكِ به أيضًا

241
00:17:43,500 --> 00:17:44,750
...نيكو-كن

242
00:17:46,620 --> 00:17:48,830
!انظري! لقد حجزتُ مكانًا رائعًا

243
00:17:48,830 --> 00:17:49,750
ما هذه؟

244
00:17:49,750 --> 00:17:51,880
!إنّها تذكرةٌ لحفلة كويوكي-تشان الخاصّة بعيد الميلاد

245
00:17:52,130 --> 00:17:52,960
!اوه

246
00:17:52,960 --> 00:17:54,920
أنتِ أحدُ معجبات هيناشي كويوكي، أليس كذلك؟

247
00:17:54,920 --> 00:17:57,340
!أجل! أنا أتطلّعُ للحفلة حقًّا

248
00:17:57,640 --> 00:18:00,010
!من الصعب شراء التذاكر

249
00:18:04,600 --> 00:18:05,850
.آسفة لجعلكِ تنتظرين

250
00:18:05,850 --> 00:18:07,810
أنتِ لا تكرهين الأشياء الحلوة، أليس كذلك؟

251
00:18:08,310 --> 00:18:09,230
.تفضّلي

252
00:18:10,560 --> 00:18:12,190
.شكرًا جزيلًا

253
00:18:32,960 --> 00:18:34,710
!يو-ني، لقد حدثت مشكلة

254
00:18:35,550 --> 00:18:36,550
ما الأمر؟

255
00:18:36,840 --> 00:18:39,720
!ورد في الأخبار أنّ كويوكي-تشان ستتوقّفُ عن الغناء حتّى إشعارٍ آخر

256
00:18:40,010 --> 00:18:41,720
!تمّ إلغاء جميع حفلاتها الموسيقيّة أيضًا

257
00:18:41,720 --> 00:18:42,810
!قيل بأنّ الأمر متعلّقٌ بحالتها الصحيّة

258
00:18:43,640 --> 00:18:44,310
!ماذا؟

259
00:18:55,230 --> 00:18:56,150
...يو-ني

260
00:18:56,150 --> 00:18:58,240
هل تظنُّ بأنّ كويوكي-تشان على ما يرام؟

261
00:18:58,240 --> 00:18:59,360
.لا أدري

262
00:19:00,200 --> 00:19:00,990
...ولكن

263
00:19:53,500 --> 00:19:54,590
!لقد ردّت عليّ

264
00:19:54,590 --> 00:19:56,210
!مرحبًا، تاما-تشان؟

265
00:19:56,630 --> 00:19:57,420
...نيكو-كن

266
00:19:57,420 --> 00:20:00,840
!عذرًا، لم تقومي بالردّ عليّ مطلقًا فأُصبتُ بالحيرة

267
00:20:00,840 --> 00:20:01,720
كنتُ أتسائل ما إن أصابكِ مكروه ـــ

268
00:20:01,720 --> 00:20:02,760
.أنا بخير

269
00:20:03,760 --> 00:20:05,640
...أنا بخير، لذا

270
00:20:06,510 --> 00:20:07,640
.لا تقلق

271
00:20:07,640 --> 00:20:08,640
قلتِ بخير؟

272
00:20:08,640 --> 00:20:09,680
...ولكن، لقد

273
00:20:10,100 --> 00:20:11,980
!تاما-تشان، أين أنتِ الآن؟

274
00:20:11,980 --> 00:20:13,440
!سآتي إليكِ

275
00:20:14,440 --> 00:20:16,020
!أخبريني، تاما-تشان؟

276
00:20:17,780 --> 00:20:18,820
.أراك لاحقًا

277
00:20:38,050 --> 00:20:40,300
!إنّها بخير؟ ذلك مستحيل

278
00:20:44,090 --> 00:20:45,300
.سيتمّ إغلاق الأبواب

279
00:20:45,300 --> 00:20:46,760
.توخّوا الحذر رجاءً

280
00:21:05,030 --> 00:21:08,490
.آنذاك، لم أتمكّن من فعل أيّ شيء

281
00:21:09,990 --> 00:21:13,750
....بالرغم من أنّ تاما-تشان كانت مجروحة كما هي الآن

282
00:21:27,340 --> 00:21:28,680
!لقد عثرتُ عليكِ

283
00:21:32,140 --> 00:21:33,430
...كما توقّعت، لقد كنتِ هنا

284
00:21:35,390 --> 00:21:36,400
...لماذا

285
00:21:36,690 --> 00:21:37,900
!لقد كنتُ قلقًا بشأنك

286
00:21:37,900 --> 00:21:39,610
!لم أتمّكن من التواصل معكِ عبر الهاتف

287
00:21:39,610 --> 00:21:41,690
،رأيتُ الأخبار التّي تحدّثت عن توقّفكِ المفاجئ

288
00:21:41,690 --> 00:21:43,650
...وأخبرتني تشيتوزي بأنّه قد تمّ إلغاء حفلاتكِ أيضًا

289
00:21:43,650 --> 00:21:45,650
...صوتي لا يخرج

290
00:21:48,490 --> 00:21:49,950
.عندما أحاول الغناء

291
00:21:51,990 --> 00:21:53,450
.ولكن، لا بأس

292
00:21:54,040 --> 00:21:56,460
،متأكّدةٌ من أنّني سأتعافى عمّا قريب

293
00:21:57,330 --> 00:21:59,630
.لذا لا تقلق

294
00:22:01,000 --> 00:22:03,840
...أنا آسفة، نيكو-كن

295
00:22:06,680 --> 00:22:08,050
.لوقوعي في حبّك

296
00:22:10,390 --> 00:22:11,510
.أنا آسفة

297
00:24:06,590 --> 00:24:08,380
"!الحلقة القادمة، "موعد