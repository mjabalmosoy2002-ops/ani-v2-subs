1
00:00:04,070 --> 00:00:07,610
هذه الدرّاجة الهوائيّة من كلاريس-سينباي إذاً

2
00:00:07,610 --> 00:00:11,410
إنّها تفوق مستوى تطوّر الدرّاجة التي قدتَها
في مهرجان الأكاديميّة بمراحل

3
00:00:11,410 --> 00:00:13,360
سمّيتُها شوبيرت

4
00:00:13,360 --> 00:00:15,620
أنا مالكها

5
00:00:15,620 --> 00:00:18,620
إذاً، ما معنى "شوبيرت"؟

6
00:00:18,870 --> 00:00:20,910
تعني السيف

7
00:00:20,910 --> 00:00:22,750
!تروقني

8
00:00:22,750 --> 00:00:26,500
إنّها معدنيّةٌ ومُدبّبة، الاسم مثاليّ

9
00:00:27,190 --> 00:00:30,260
لنبدأ التعديل الآن إذاً

10
00:02:03,500 --> 00:02:05,470
ما رأيك أن تُبدي سروراً أكبر؟

11
00:02:05,470 --> 00:02:08,350
صحيح، لقد تمّت ترقيتك

12
00:02:08,580 --> 00:02:11,600
لم أرد أن أٌرقّى

13
00:02:11,910 --> 00:02:14,960
لكنّك لن تعاني في إيجاد زوجةٍ الآن

14
00:02:14,960 --> 00:02:17,490
أترى؟ الفتيات ينظرن لك

15
00:02:18,050 --> 00:02:19,910
سمعتُ أنّه ترقّى من جديد

16
00:02:19,910 --> 00:02:21,350
قد يكون مكسباً الآن

17
00:02:21,350 --> 00:02:24,120
لكنّي أكرهه شخصيّاً

18
00:02:24,120 --> 00:02:27,540
!كأنّهن يقلن أنّ هدفهنّ هو مقامي فحسب

19
00:02:27,540 --> 00:02:28,960
!مستحيل

20
00:02:28,960 --> 00:02:30,610
لا يمكنني إنكار ذلك

21
00:02:30,610 --> 00:02:34,130
حسناً، قد تتمكّن من تطوير
علاقةٍ مع إحداهنّ

22
00:02:34,130 --> 00:02:35,380
الرحلة المدرسيّة تقترب

23
00:02:36,320 --> 00:02:38,130
...حدث الرحلة المدرسيّة

24
00:02:38,940 --> 00:02:41,510
تذهب كافّة الصفوف الثلاثة
في رحلةٍ معاً سنويّاً

25
00:02:41,510 --> 00:02:43,760
يُقسّم التلامذة إلى ثلاث مجموعات

26
00:02:44,100 --> 00:02:47,530
في اللعبة، تتوجّه لنفس وجهة
،عشّاقك المُحتملين

27
00:02:49,940 --> 00:02:52,900
توجد أدوات لا يمكنك الحصول
عليها إلّا في وجهتك أيضاً

28
00:02:52,900 --> 00:02:55,200
فقرّرتُ الذهاب إلى الجزيرة العائمة الجنوبيّة

29
00:02:55,200 --> 00:02:57,330
حيث توجد الأداة التي أريدها

30
00:02:58,150 --> 00:03:00,130
يبدو أنّنا سننفصل

31
00:03:00,130 --> 00:03:03,230
ستكون مع آنجليكا-سان وأوليفيا-سان يا ليون، صحيح؟

32
00:03:03,870 --> 00:03:05,990
لمَ لا تعتذر وتتصالح معهما؟

33
00:03:05,990 --> 00:03:08,160
ماذا؟ لمَ أعتذر لهما؟

34
00:03:08,160 --> 00:03:10,410
لأنّها غلطتك بالتأكيد

35
00:03:10,410 --> 00:03:11,660
بالفعل

36
00:03:11,660 --> 00:03:13,210
أجل، أجل

37
00:03:13,210 --> 00:03:16,670
من تخالانني؟

38
00:03:22,190 --> 00:03:25,570
لا تشبه هذه الرحلات المدرسيّة التي أعهدها

39
00:03:25,570 --> 00:03:27,680
هذه سفينة ركّاب فارهة، فلا عجب

40
00:03:27,680 --> 00:03:30,810
يبدو أنّه سيتسنى لك الاستمتاع
حتّى بالتزلّج المائي في وجهتك

41
00:03:30,810 --> 00:03:34,900
أعرف، أنوي أخذ شوبيرت لتجربة
قيادة بينما أنا هناك

42
00:03:35,490 --> 00:03:37,190
...بأيّ حال

43
00:03:43,950 --> 00:03:46,760
سنحظى بوقتٍ بهيج عند وصولنا

44
00:03:46,760 --> 00:03:50,150
سأحكي لكم كلّ شيءٍ
عن أعمال أجدادي البطوليّة

45
00:03:51,960 --> 00:03:53,350
ديادري-ساما

46
00:03:53,350 --> 00:03:54,680
أتطلّع لذلك

47
00:03:54,680 --> 00:03:57,760
إذا أردتُ الزواج، فعليّ بذل جهدٍ
بينما أنا هنا

48
00:04:00,080 --> 00:04:00,860
كريس-ساما

49
00:04:00,860 --> 00:04:01,910
أين ستتوجّه تالياً؟

50
00:04:01,910 --> 00:04:02,930
تعال للأكل معي

51
00:04:02,930 --> 00:04:04,400
انضمّ لي في رصيف المسبح

52
00:04:06,190 --> 00:04:08,130
!كريس-ساما

53
00:04:06,480 --> 00:04:09,850
يتلقّى العشّاق المحتملون الوسماء
وابل اهتمام كالمعتاد

54
00:04:09,850 --> 00:04:13,670
ليتهم يتبعون مجرى قصّة اللعبة
ويرتبطون بأوليفيا-سان وحسب

55
00:04:18,610 --> 00:04:21,820
مع أنّ الأمر لا يخصّني

56
00:04:23,980 --> 00:04:26,360
اخترتُ التخلّي عن عائلة الدوق

57
00:04:26,590 --> 00:04:30,640
وأنا أيضاً، إنّهم في طريقهم للتدهور
بما أنّ خطبتها بالأمير أُلغيت أصلاً

58
00:04:32,120 --> 00:04:34,930
يُفترض أن نسحب الخيط ونلقيها من النافذة؟

59
00:04:34,930 --> 00:04:37,170
أجل، أُخبرنا بألّا نجلب الانتباه لأنفسنا

60
00:04:54,780 --> 00:04:56,500
...كأنّي في حلم

61
00:04:58,020 --> 00:05:02,310
ليتنا الثلاثة نستطيع المشي
في مكانٍ بهذا الجمال معاً

62
00:05:08,950 --> 00:05:13,490
أمن المقبول لي البقاء
في الأكاديميّة بالأصل؟

63
00:05:42,730 --> 00:05:44,940
لا بدّ أنّكم تلامذةٌ من الأكاديميّة

64
00:05:45,290 --> 00:05:46,670
أأتيتم لزيارة الضريح؟

65
00:05:46,670 --> 00:05:48,070
...في الواقع

66
00:05:48,070 --> 00:05:50,670
هذا الضريح مخصّصٌ للزيجات

67
00:05:50,670 --> 00:05:52,830
يُقال أنّه فعّالٌ جدّاً

68
00:05:52,830 --> 00:05:53,880
ماذا؟

69
00:05:53,880 --> 00:05:55,330
للزيجات؟

70
00:05:55,850 --> 00:05:58,080
هذا الحدث حيث تزور البطلة

71
00:05:58,080 --> 00:06:00,320
والعشّاق المحتملون الضريح معاً إذاً

72
00:06:00,730 --> 00:06:02,160
أجل، أجل

73
00:06:02,160 --> 00:06:04,340
علينا البدء بتقديم قرابين أوّلاً

74
00:06:06,840 --> 00:06:08,590
هـ-هذا القدر؟

75
00:06:08,890 --> 00:06:10,360
ليس صحيحاً؟

76
00:06:10,360 --> 00:06:13,600
في المعبد، من الطبيعيّ التبرّع بهذا المقدار

77
00:06:17,220 --> 00:06:19,730
يا ربّ، أعنّي على إيجاد زوجةٍ رجاءً

78
00:06:20,230 --> 00:06:23,690
!اربطني بامرأةٍ لطيفة تملك منطقاً عاماً

79
00:06:23,690 --> 00:06:27,190
!أنا أهوى الناضجات المثيرات اللواتي سيدلّلني

80
00:06:27,190 --> 00:06:29,490
!ومن الأفضل لو كنّ مُنحرفات

81
00:06:29,730 --> 00:06:32,990
!لا تقل أشياء كهذه في مكانٍ مقدّس أيّها الأحمق

82
00:06:41,020 --> 00:06:45,790
أتساءل لو كانت آنجليكا-سان تأمل
بالزواج بشخص محترم أكثر من الأمير

83
00:06:47,180 --> 00:06:51,020
بالنسبة لأوليفيا-سان، فشخصٌ عدا
...غريغ وبراد المخيّبين للآمال

84
00:06:51,460 --> 00:06:54,760
لا، ربما يوليوس وجيلك ميؤوسٌ منهما أيضاً

85
00:06:55,840 --> 00:06:58,020
كلا، ذلك ليس صحيحاً

86
00:06:58,700 --> 00:07:02,520
،طالما يجعل أوليفيا-سان سعيدة
فلا يهمّ من يكون

87
00:07:05,660 --> 00:07:10,030
يا تلامذة الأكاديميّة، هذه تمائم ضريحنا المشهورة

88
00:07:10,450 --> 00:07:12,030
خذوها كتذكار

89
00:07:12,290 --> 00:07:13,780
تمائم؟

90
00:07:17,890 --> 00:07:21,290
!صحيح، هذا ما كنتُ أبحث عنه

91
00:07:21,570 --> 00:07:23,690
،"تعاويذ "تميمة الحظّ السعيد

92
00:07:23,690 --> 00:07:27,680
"و"تميمة حظّ الحرب"، و"نعمة العنصر
اللواتي تُكتسب عشوائيّاً

93
00:07:28,550 --> 00:07:32,150
أردتُها بشدّة، فقمت بترتيبات كي أتأكّد

94
00:07:32,150 --> 00:07:35,550
من أن أصبح في الرحلة المدرسيّة
المتوجّهة للجزيرة العائمة الجنوبيّة

95
00:07:32,910 --> 00:07:35,550
شكراً، شكراً، شكراً

96
00:07:36,660 --> 00:07:38,870
بُورِكت يا حدث الرحلة المدرسيّة

97
00:07:38,870 --> 00:07:42,430
ا-المعذرة، هذه لكم الثلاثة

98
00:07:43,440 --> 00:07:45,750
حسناً... نحن لا نحتاجها

99
00:07:45,750 --> 00:07:47,190
يمكنك الاحتفاظ بها يا ليون-سان

100
00:07:48,230 --> 00:07:50,480
لا، فلتأخذا منها

101
00:07:50,480 --> 00:07:52,330
لنفتحها معاً

102
00:07:52,330 --> 00:07:53,440
...ليون

103
00:07:56,780 --> 00:07:58,320
إن كنت مصرّاً

104
00:07:58,320 --> 00:07:59,690
شكراً لك

105
00:08:00,450 --> 00:08:03,560
!ها نحن، فلأفز! فلأفز

106
00:08:03,560 --> 00:08:05,110
!لا فوز أو خسارة هنا

107
00:08:05,110 --> 00:08:06,710
!الأنواع مختلفةٌ وحسب

108
00:08:07,040 --> 00:08:07,960
...استعداد

109
00:08:10,090 --> 00:08:11,170
ما هذه؟

110
00:08:11,170 --> 00:08:12,470
يا لجمالها

111
00:08:13,250 --> 00:08:16,470
تعويذتا عناصر بركة حمراء وبيضاء؟

112
00:08:16,850 --> 00:08:19,050
أنا مسرورٌ لأنّكما حصلتما عليها

113
00:08:19,050 --> 00:08:21,760
لا أملك ألفةً لعنصريّ هذين اللونين

114
00:08:21,760 --> 00:08:22,790
ألفة؟

115
00:08:22,790 --> 00:08:24,100
ما قصدك؟

116
00:08:24,330 --> 00:08:27,100
بأيّ حال، فلتحتفظا بها

117
00:08:27,320 --> 00:08:30,110
حصلتُ على شيءٍ جيّدٍ بدوري

118
00:08:30,410 --> 00:08:32,400
إنّها مختلفةٌ عن قطعتينا

119
00:08:32,400 --> 00:08:34,640
أهذه سيوف؟

120
00:08:34,640 --> 00:08:37,110
أجل، إنّها تعويذة حظّ الحرب

121
00:08:37,570 --> 00:08:40,260
أداةٌ تحسّن قدرات
النطاق القريب القتاليّة

122
00:08:44,190 --> 00:08:47,750
لكنّ شكلها مختلفٌ عن التي أعهدها قليلاً

123
00:08:48,210 --> 00:08:49,940
هل نالت إعجابك؟

124
00:08:49,940 --> 00:08:51,750
أجل، شكراً لك

125
00:08:52,180 --> 00:08:55,260
شكراً على زيارتكم للضريح

126
00:08:55,590 --> 00:08:59,260
لا بدّ أنّكم الثلاثة دعوتم لصداقتكم

127
00:09:07,440 --> 00:09:11,770
سيّدي، هل سبب عدم توجّهك
للديماس للحصول على السوار المقدّس

128
00:09:12,150 --> 00:09:15,430
هو لأنّ تلك التعويذة لم تكن بحوزتك بعد؟

129
00:09:16,530 --> 00:09:20,130
رأيتُ أنّ عدم تعجّلك رغم وجود
ماري في الأرجاء أمر غريب

130
00:09:20,450 --> 00:09:24,160
ألا تسعى لأخذ مكان البطلة؟

131
00:09:24,490 --> 00:09:30,170
،طالما أنّها لعبت اللعبة بإسهاب
فلن تُقدم على أيّة حماقات

132
00:09:30,850 --> 00:09:34,530
سنقع في ورطةٍ إن سلكنا مسار الحرب

133
00:09:40,310 --> 00:09:41,620
اقترب الوقت

134
00:09:45,310 --> 00:09:46,340
بارتفورت

135
00:09:47,630 --> 00:09:49,870
سمعتُ أنّك قاتلت براد

136
00:09:49,870 --> 00:09:53,070
علينا أن نجري مبارزتنا الخاصّة بالسيف

137
00:09:53,070 --> 00:09:57,210
ماذا؟ لكنّ براد تحدّاني
لقتالٍ لا يبرع فيه

138
00:09:57,210 --> 00:10:00,200
تريد مقاتلتي بالسيف بما
أنّك سيّافٌ ماهر؟

139
00:10:01,130 --> 00:10:04,510
لم أعتبر نفسي سيّافاً ماهراً قطّ

140
00:10:05,060 --> 00:10:07,460
يقول أبي أنّي لا أمتلك الموهبة

141
00:10:08,500 --> 00:10:11,120
لمَ لا تجعل ماري تواسيك إذاً؟

142
00:10:11,120 --> 00:10:12,960
!لا تعرف شيئاً عنّي

143
00:10:13,400 --> 00:10:15,960
لم يسبق وأن عملتَ كادحاً
!ليومٍ في حياتك

144
00:10:18,980 --> 00:10:19,670
ما الذي يجري؟

145
00:10:19,670 --> 00:10:20,220
إنذار؟

146
00:10:29,150 --> 00:10:30,830
لا يُعقل

147
00:10:30,830 --> 00:10:31,920
ما الذي يحصل؟

148
00:10:31,920 --> 00:10:33,140
وحوش؟

149
00:10:31,920 --> 00:10:34,230
!اهدؤوا جميعاً! توجّهوا داخل السفينة

150
00:10:33,140 --> 00:10:34,820
ماذا يجري؟

151
00:10:34,820 --> 00:10:36,300
...تلك العلامة

152
00:10:36,300 --> 00:10:38,490
إنّها شعار دوقيّة فانوس

153
00:10:39,810 --> 00:10:41,650
...دوقيّة فانوس

154
00:10:41,650 --> 00:10:44,270
،انتمت لدوقٍ في المملكة بالأصل

155
00:10:44,270 --> 00:10:46,830
لكنّهم أعلنوا استقلالهم
ويعتبرون نفسهم بلاداً الآن

156
00:10:47,590 --> 00:10:51,750
يُفترض ألّا يظهروا حتّى ختام اللعبة

157
00:10:51,980 --> 00:10:55,000
لمَ؟ هذا باكرٌ جدّاً

158
00:10:55,280 --> 00:10:57,930
سآمر السفينة الرئيسيّة والشريك بالهجوم

159
00:10:57,930 --> 00:10:59,260
أعطني إذنك سيّدي

160
00:10:59,260 --> 00:11:01,050
أرسلهم فوراً، كم نملك من وقت؟

161
00:11:08,420 --> 00:11:10,270
سفينة وحشٍ هوائيّة؟

162
00:11:10,630 --> 00:11:12,200
إنّها الأميرة

163
00:11:12,200 --> 00:11:13,020
ليون

164
00:11:13,020 --> 00:11:14,730
لمَ تهاجم الدوقيّة؟

165
00:11:18,130 --> 00:11:20,030
...الأميرة هيترود

166
00:11:20,290 --> 00:11:21,310
أتعرفينها؟

167
00:11:21,310 --> 00:11:24,610
أجل، التقيتُها مرّةً من قبل

168
00:11:28,090 --> 00:11:34,890
،لديّ أنا أميرة دوقيّة فانوس
هيترود سيرا فانوس، رسالةً لكم

169
00:11:36,040 --> 00:11:40,250
أعلنّا الحرب على مملكة هولفورت

170
00:11:41,300 --> 00:11:47,350
،يا أبناء نبلاء المملكة السُذّج
استسلموا أو القوا هلاككم

171
00:11:47,350 --> 00:11:49,850
سأمنحكم وقتاً لاتّخاذ قراركم

172
00:11:50,460 --> 00:11:52,380
سأنتظر ساعةً واحدة

173
00:11:53,170 --> 00:11:55,150
إ-إعلان حرب؟

174
00:11:55,550 --> 00:11:58,070
أتنوي أخذنا رهائناً؟

175
00:11:58,370 --> 00:12:02,000
لمَ يقع حدث السنة الثالثة الآن؟

176
00:12:03,540 --> 00:12:05,520
أين ارتكبتُ خطأً؟

177
00:12:14,330 --> 00:12:17,190
كيف حالكم يا أهل المملكة؟

178
00:12:17,190 --> 00:12:19,610
اسمي غاريت

179
00:12:19,610 --> 00:12:20,840
...حسناً إذاً

180
00:12:20,840 --> 00:12:25,250
سيؤخذ أبناء النبلاء ذوي رتبة البارون
فما أعلى سجناءً

181
00:12:25,250 --> 00:12:28,170
لسنا مهتمّين بمن يدنون ذلك

182
00:12:28,170 --> 00:12:31,280
لا حاجة لنا بالعبيد أشباه البشر
أو طاقم السفينة أيضاً

183
00:12:31,280 --> 00:12:31,650
ماذا؟

184
00:12:31,650 --> 00:12:33,480
ليسوا مهتمّين بالفرسان؟

185
00:12:33,480 --> 00:12:34,090
...لكن

186
00:12:33,740 --> 00:12:34,770
هذا سيّئ

187
00:12:34,090 --> 00:12:35,890
لا قيمة لنا كرهائن حتّى؟

188
00:12:34,770 --> 00:12:37,270
ما العمل؟ ما عساي أفعل؟

189
00:12:40,470 --> 00:12:42,740
أنا آنجليكا رافا ريدغريف

190
00:12:43,450 --> 00:12:46,110
أعتقد أنك تعرف اسم عائلتي على الأقلّ

191
00:12:46,110 --> 00:12:47,620
عجباً، عجباً

192
00:12:47,890 --> 00:12:52,120
،أنا الرهينة الوحيدة التي تحتاجها
أطلق سراح الآخرين

193
00:12:52,120 --> 00:12:55,870
لم يخطر لي أن تكون ابنة
دوقٍ على متن هذه السفينة

194
00:12:55,870 --> 00:12:59,660
أثنيك على شجاعتكِ بإبرازكِ نفسك

195
00:12:59,660 --> 00:13:00,960
من هنا من فضلك

196
00:13:02,110 --> 00:13:03,260
...آنجي

197
00:13:03,260 --> 00:13:04,260
!انتظري

198
00:13:07,050 --> 00:13:08,870
!يا أحمق، لا تُقدم على أمرٍ متهوّر

199
00:13:08,870 --> 00:13:10,220
!لم يرغمها أحدٌ على قول ذلك

200
00:13:10,220 --> 00:13:12,630
دعاني! أفقدتما صوابكما؟

201
00:13:14,050 --> 00:13:17,020
يا للاهتمام العميق بصديقته

202
00:13:19,280 --> 00:13:20,270
...ليون

203
00:13:24,650 --> 00:13:29,660
لنعطِ هؤلاء النبلاء عملاً أخيراً

204
00:13:30,030 --> 00:13:32,910
أريد منكم أن تعاقبوه

205
00:13:34,620 --> 00:13:35,920
!هيّا، بسرعة

206
00:13:36,770 --> 00:13:38,220
لا تكنّ ضغينةً لنا

207
00:13:44,670 --> 00:13:45,670
!ليون-سان

208
00:13:46,420 --> 00:13:47,930
!توقّف! لا تفعلوا هذا

209
00:13:48,320 --> 00:13:52,810
ليس هكذا تطلبين شيئاً من أحدهم

210
00:13:52,810 --> 00:13:57,060
ليس سلوكاً يليق بابنة دوق

211
00:13:59,860 --> 00:14:01,360
توقّفوا رجاءً

212
00:14:02,630 --> 00:14:04,160
أتوسّل لك

213
00:14:07,220 --> 00:14:10,450
للأسف، أرفض طلبك

214
00:14:15,420 --> 00:14:17,960
حسناً، تعالي من هنا

215
00:14:18,240 --> 00:14:21,960
أم تريدين تعريض كافّة الطلاب للخطر؟

216
00:14:26,460 --> 00:14:27,590
!انتظري

217
00:14:27,970 --> 00:14:29,680
!لا تذهبي يا آنجي

218
00:14:30,090 --> 00:14:31,280
لا تتجرّئي

219
00:14:31,280 --> 00:14:33,480
تعرفين ما سيحصل إن فعلتِ، صحيح؟

220
00:14:33,480 --> 00:14:36,030
!لا تمسسنها يا حقيرات

221
00:14:33,900 --> 00:14:34,980
لا تتدخّلي

222
00:14:36,030 --> 00:14:37,030
!توقّفن

223
00:14:37,030 --> 00:14:39,560
!لن تفلتن بهذا أبداً

224
00:14:38,230 --> 00:14:39,560
!أغلق فمك

225
00:14:44,290 --> 00:14:47,280
مضى وقتٌ طويل يا آنجليكا

226
00:14:47,580 --> 00:14:50,280
لم يخطر لي أن نلتقي مجدّداً هكذا

227
00:14:50,520 --> 00:14:52,850
أتنوون إشعال حربٍ حقّاً؟

228
00:14:53,330 --> 00:14:56,410
لا بدّ أنّكِ على علمٍ بأنّ المملكة
أقوى من دوقيّتكم بكثير

229
00:14:56,410 --> 00:15:00,920
أنتِ محقّة، من الصحيح أنّ تجاوز
الفارق في القوّة سيكون صعباً

230
00:15:01,770 --> 00:15:03,420
لكن انظري

231
00:15:03,420 --> 00:15:06,450
سموّكِ، علينا مناقشة موضوع الرهائن أوّلاً

232
00:15:06,450 --> 00:15:08,170
معك حقّ

233
00:15:08,880 --> 00:15:12,430
ما الذي تتكلّمان عنه؟ سلّمتُ نفسي
كي تطلقوا سراح الآخرين

234
00:15:12,430 --> 00:15:16,670
قاومنا تلميذان فحسب عندما أُخذتِ

235
00:15:16,670 --> 00:15:19,420
يا لبرودتهم وجبنهم

236
00:15:19,420 --> 00:15:22,010
لا يليق بهم أن يكونوا نبلاءً

237
00:15:30,890 --> 00:15:32,700
لا تبكي

238
00:15:33,210 --> 00:15:35,570
فشلتُ في إنقاذ آنجي

239
00:15:36,110 --> 00:15:39,200
لا يمكنني إخراجك من هنا أيضاً

240
00:15:39,830 --> 00:15:42,020
لا يمكنني تحمّل الفتيات الباكيات

241
00:15:42,630 --> 00:15:48,490
لكن ربما قدرة البكاء لأجل أحدهم
أمرٌ مبهر بحدّ ذاته

242
00:15:52,230 --> 00:15:53,450
...كريس-سان

243
00:15:53,450 --> 00:15:57,100
بارتفورت، وصل مبعوثٌ
من الدوقيّة للتو

244
00:15:57,570 --> 00:15:58,540
و؟

245
00:15:58,970 --> 00:16:01,600
ستكون آنجليكا الرهينة
الوحيدة التي سيأخذونها

246
00:16:01,870 --> 00:16:04,350
سيبدؤون الهجوم في غضون ساعة

247
00:16:04,350 --> 00:16:07,700
يُفترض بنا الموت كنبلاء وفقما يبدو

248
00:16:08,650 --> 00:16:10,360
لا عجب

249
00:16:10,670 --> 00:16:12,970
لهذه السفينة ستّة دروع

250
00:16:12,970 --> 00:16:17,090
أريد أن نوفّر وقتاً معاً
كي يستطيع الآخرون الهرب

251
00:16:17,090 --> 00:16:18,390
فلتعرني قوّتك

252
00:16:18,390 --> 00:16:22,370
لا أريد، لقد تخلّوا عن آنجي

253
00:16:23,120 --> 00:16:24,690
فليهلكوا جميعاً

254
00:16:26,290 --> 00:16:28,380
ليون فو بارتفورت

255
00:16:29,700 --> 00:16:31,380
فلتنقذنا رجاءً

256
00:16:31,380 --> 00:16:32,880
أرفض

257
00:16:35,410 --> 00:16:36,500
أعتذر على إزعاجك

258
00:16:37,940 --> 00:16:41,230
يا أحمق، لم أنتهِ من الكلام

259
00:16:43,020 --> 00:16:46,880
لستُ لطيفاً بحيث أساعد
أشخاصاً لن يفعلوا شيئاً

260
00:16:49,260 --> 00:16:52,020
إذا كنّا سنفعلها، فسيكون بمشاركتنا جميعاً

261
00:16:55,140 --> 00:16:57,160
يا رفاق، أصغوا لي

262
00:16:57,510 --> 00:17:01,160
أتفهّم فقدانكم لجرأتكم
أمام ذاك العدد الكبير من الأعداء

263
00:17:01,640 --> 00:17:04,910
لكن كي ننجو جميعاً، فعلينا القتال

264
00:17:04,910 --> 00:17:06,700
!فلتعيروني قوّتكم

265
00:17:07,740 --> 00:17:10,880
إذا لم نتصدَّ لهم الآن، فسنموت كالكلاب

266
00:17:10,880 --> 00:17:11,670
!اخرس

267
00:17:11,670 --> 00:17:13,060
!يا صبيّ السنة الأولى

268
00:17:13,060 --> 00:17:13,920
!لا تغترّ

269
00:17:13,920 --> 00:17:15,560
!اجلس! لقد حُرِمت من الميراث

270
00:17:15,560 --> 00:17:17,260
!لا يمكننا هزيمتهم

271
00:17:17,260 --> 00:17:18,820
!هذه غلطة آنجليكا

272
00:17:18,820 --> 00:17:20,880
!كلّ ما فعلته هو النفاذ بجلدها

273
00:17:20,880 --> 00:17:23,180
!يا لها من ابنة دوقٍ بائسة

274
00:17:25,590 --> 00:17:28,850
كفّوا عن التذمّر أيّها الحثالات

275
00:17:30,350 --> 00:17:31,860
فلتنصتوا لي

276
00:17:32,180 --> 00:17:36,860
،أنا فارسٌ ببارونيّة رسميّة
ورتبة خامسة دنيا فوق ذلك

277
00:17:37,290 --> 00:17:40,120
مقامي أعلى من المعلّمين الذين يوجّهوننا

278
00:17:40,610 --> 00:17:42,820
وآمركم بالقتال

279
00:17:43,370 --> 00:17:48,370
فلتموتوا في القتال، ذلك أهون من القتل

280
00:17:48,370 --> 00:17:49,130
ماذا؟

281
00:17:49,130 --> 00:17:49,820
!لا تعبث معنا

282
00:17:49,820 --> 00:17:50,890
!لا أريد الموت

283
00:17:50,890 --> 00:17:52,860
!فلتقاتل أنت

284
00:17:52,860 --> 00:17:56,880
أجل، سأقاتل. فأنا نبيلٌ أصيل

285
00:17:56,880 --> 00:17:59,890
بخلافكم أيّها النبلاء الواهمون

286
00:18:00,220 --> 00:18:01,350
ماذا؟

287
00:18:01,890 --> 00:18:04,640
نبلاء واهمون؟

288
00:18:06,340 --> 00:18:09,770
كيف تجرؤ؟ أنا ابنة كونت

289
00:18:09,770 --> 00:18:11,520
اسحب كلامك

290
00:18:11,520 --> 00:18:13,270
ماذا؟ من أنتِ؟

291
00:18:13,500 --> 00:18:16,620
أنا ديادري فو روزبليد

292
00:18:16,620 --> 00:18:19,140
ابنة الكونت روزبليد

293
00:18:19,140 --> 00:18:20,650
لا تنسَ ذلك

294
00:18:20,650 --> 00:18:22,360
روزبليد

295
00:18:22,360 --> 00:18:27,130
باستثناء عائلة الدوق، فقد تكون
عائلتكِ الأعلى نفوذاً هنا

296
00:18:27,130 --> 00:18:28,790
لكنّكِ لا تزالين زائفة

297
00:18:28,790 --> 00:18:32,540
!يا-يا للفظاظة! يا حديث النعمة

298
00:18:32,860 --> 00:18:35,190
أجل، أنا حديث نعمة

299
00:18:35,190 --> 00:18:39,050
لكنّي نبيلٌ أصيل ومُغامر ناجح

300
00:18:39,050 --> 00:18:41,800
بخلافكم أيّها الزائفون

301
00:18:41,800 --> 00:18:43,180
!اصمت

302
00:18:43,470 --> 00:18:47,440
قدّمت عائلتي للمملكة جزيرةً هائلة

303
00:18:47,440 --> 00:18:49,690
!نحن أبرز العائلات المرموقة

304
00:18:49,690 --> 00:18:52,740
كان أجدادكِ نبلاء أصيلين بحقّ

305
00:18:52,740 --> 00:18:56,440
لكنّ سلالتهم جبناء

306
00:18:57,690 --> 00:19:03,040
شعرتم بارتياحٍ عندما سلّمت
آنجي نفسها، أليس كذلك؟

307
00:19:03,040 --> 00:19:05,950
انتظرتم مرور العاصفة بصمت

308
00:19:06,280 --> 00:19:08,370
الدوقيّة محقّة

309
00:19:08,370 --> 00:19:12,460
لا تملكون جرأة أو فخر
سلالة المُغامرين

310
00:19:12,460 --> 00:19:15,960
أنتم محض جبناءٍ يتشبّثون بإنجازات أسلافهم

311
00:19:16,280 --> 00:19:21,710
وإنجازات أسلافكم على وشك
!أن تُمحى بسبب بؤسكم

312
00:19:22,470 --> 00:19:28,220
...بعد إحراجكم لأقاربكم، سينهال على مسامعكم باستمرار

313
00:19:28,220 --> 00:19:30,460
أنّكم عارٌ على النبلاء

314
00:19:30,460 --> 00:19:34,950
وأنّهم لا يريدون شأناً
من جبناء فرّوا من قتال

315
00:19:37,100 --> 00:19:41,740
هل دمّ النبلاء، دمّ المغامرين
الذي يسري في عروقكم مزيّف؟

316
00:19:42,020 --> 00:19:45,240
أتريدون الموت بتعاسةٍ وأنتم
تنتظرون موتكم وحسب؟

317
00:19:46,240 --> 00:19:50,340
إذا كنتم منحدرين من سلالة
مُغامرين عظماء، فلتقاتلوا

318
00:19:55,790 --> 00:19:57,630
لا بدّ أنّك أحمق

319
00:19:57,630 --> 00:20:01,310
أتظنّ بالإمكان هزيمة
تلك الوحوش بذاك الشيء؟

320
00:20:01,760 --> 00:20:06,390
فلتذهب وتقاتل ذاك الشيء كما تشاء

321
00:20:06,390 --> 00:20:07,370
كما ظننت

322
00:20:07,370 --> 00:20:09,770
قلت بنفسك

323
00:20:09,770 --> 00:20:14,140
أنّ دمّ أسلافنا العظماء
يسري في عروقنا

324
00:20:14,780 --> 00:20:17,350
ذلك سلاحنا

325
00:20:17,940 --> 00:20:19,590
!لنفعلها

326
00:20:19,590 --> 00:20:21,780
!لا تستهن بنا أيّها الحقير

327
00:20:21,780 --> 00:20:23,560
!بعدما ننتهي من الدوقيّة، ستكون التالي

328
00:20:23,560 --> 00:20:26,610
!سنسحقك

329
00:20:28,030 --> 00:20:31,220
تروقني رؤية أشخاصٍ
يمتلكون احتراماً للذات

330
00:20:31,220 --> 00:20:33,360
بارون بارتفورت

331
00:20:34,320 --> 00:20:36,540
أنتَ مُذهل

332
00:20:37,790 --> 00:20:40,300
...هذا السلوك المُتطاول

333
00:20:40,740 --> 00:20:43,300
أنت أشبه بكلبٍ غير مُمرّن

334
00:20:43,730 --> 00:20:46,050
!ذلك مثير

335
00:20:49,030 --> 00:20:51,270
بارتفورت، نعتمد عليك

336
00:20:51,270 --> 00:20:52,250
أجل

337
00:20:52,250 --> 00:20:54,870
أوجدتم من أعطى الإشارة للدوقيّة؟

338
00:20:54,870 --> 00:20:57,560
كانا تابعتين لآنجليكا

339
00:20:58,240 --> 00:21:00,570
إنّهما مُحتجزتان في الزنزانة الآن

340
00:21:00,570 --> 00:21:02,380
!انتظر! هذا سوء فهم

341
00:21:02,380 --> 00:21:04,320
!أرجوك! فلتستمع لنا

342
00:21:04,580 --> 00:21:08,570
سندع الدوق يتولى أمرهما لاحقاً

343
00:21:08,570 --> 00:21:11,830
سأذهب لتمزيق شارب ذاك الوغد

344
00:21:12,640 --> 00:21:14,080
أنت قويّ

345
00:21:14,080 --> 00:21:15,960
أجل، أعرف سلفاً

346
00:21:17,100 --> 00:21:18,250
ليون-سان

347
00:21:21,140 --> 00:21:22,300
...فلتنقذ

348
00:21:24,260 --> 00:21:26,050
فلتنقذ آنجي

349
00:21:26,830 --> 00:21:29,510
أجل، ذلك واجبي

350
00:21:31,020 --> 00:21:32,250
حان الوقت

351
00:21:33,470 --> 00:21:38,490
سأريكم كيف نقلب الفارق في القوّة

352
00:21:43,110 --> 00:21:45,320
قوّة الدوقيّة

353
00:23:26,540 --> 00:23:28,660
تعجبني سلاسل المفاتيح
المُباعة كتذكارات هذه

354
00:23:28,660 --> 00:23:29,750
ما الذي تتكلّم عنه؟

355
00:23:29,750 --> 00:23:32,080
،تستهويني السيوف الخشبيّة
لكنّها تشغل مساحةً كبيرة

356
00:23:32,080 --> 00:23:34,260
سيوف خشبيّة؟ لحظة، لمَ سيوف خشبيّة؟

357
00:23:34,260 --> 00:23:38,400
حـ-حسناً... الحلقة القادمة: ما أستطيع فعله الآن

358
00:23:38,400 --> 00:23:40,980
!أشعر بالفضول الآن! فلتخبرني