1
00:00:04,210 --> 00:00:05,390
ليون-سان

2
00:00:06,800 --> 00:00:07,930
...فلتنقذ

3
00:00:09,140 --> 00:00:11,230
فلتنقذ آنجي

4
00:00:11,450 --> 00:00:14,240
أجل، ذلك واجبي

5
00:01:56,880 --> 00:01:58,130
هيّا بنا يا لوكسيون

6
00:01:58,540 --> 00:02:00,800
آنجليكا داخل تلك السفينة

7
00:02:00,800 --> 00:02:03,010
يبدو أنّ الأميرة هيرتود معها

8
00:02:03,350 --> 00:02:05,770
في اللعبة، كان للأميرة ناي سحريّ

9
00:02:07,410 --> 00:02:10,010
سنأخذ الناي السحريّ أثناء إنقاذنا لآنجي

10
00:02:10,010 --> 00:02:11,030
لنشقّ طريقنا بالقوّة

11
00:02:11,030 --> 00:02:12,520
جاهزٌ متى شئت

12
00:02:14,910 --> 00:02:16,690
!خذوا

13
00:02:21,690 --> 00:02:24,330
!رأيتم؟ هذه قوّتي وقوّة لوكسيون

14
00:02:24,330 --> 00:02:27,290
انظروا لمدى روعتنا
!عندما نتعاون

15
00:02:27,290 --> 00:02:30,300
نتعاون؟ أنا أتحمّل معظم العبء هنا

16
00:02:30,300 --> 00:02:32,290
الوصف الأدقّ أنّك تساعدني

17
00:02:32,290 --> 00:02:34,790
!لا يهمّ، فلننتقل للتالي

18
00:02:35,040 --> 00:02:37,050
أنت حثالةٌ بحقّ

19
00:02:37,050 --> 00:02:39,590
!مرحى

20
00:02:41,120 --> 00:02:45,550
بارتفورت، هل سأصبح مثلك يوماً؟

21
00:02:48,190 --> 00:02:51,140
يا رفاق، لنبذل أيّ ما يتطلّبه
!الأمر لحماية السفينة

22
00:02:51,140 --> 00:02:52,560
!أجل

23
00:02:54,980 --> 00:02:55,740
!إنّهم قادمون

24
00:02:55,740 --> 00:02:58,070
اهدؤوا وخذوا مواضعكم

25
00:02:58,290 --> 00:02:59,790
!إنّهم يهاجمون

26
00:03:00,450 --> 00:03:01,390
!كريس-ساما

27
00:03:02,630 --> 00:03:04,650
قطعنا وعداً لبارتفورت

28
00:03:04,650 --> 00:03:06,450
!لن ندع هذه السفينة تسقط

29
00:03:06,450 --> 00:03:07,650
!ضعوا الحواجز

30
00:03:09,450 --> 00:03:11,000
تجهّزوا للاعتراض

31
00:03:11,000 --> 00:03:12,210
!شتّتوا

32
00:03:15,300 --> 00:03:16,840
تمّ تحديد سفينة
باتجاه الساعة التاسعة

33
00:03:17,120 --> 00:03:18,090
ما ذلك؟

34
00:03:18,580 --> 00:03:20,090
يبدو أنّها درّاجة هوائيّة

35
00:03:21,010 --> 00:03:22,330
...شوبيرت

36
00:03:27,010 --> 00:03:27,920
...ليون

37
00:03:35,300 --> 00:03:36,820
اجلبي لي الناي السحريّ من جديد

38
00:03:36,820 --> 00:03:37,360
حاضرة

39
00:03:37,890 --> 00:03:40,320
أيّها الأحمق، أنت أحمقٌ بحقّ

40
00:03:40,660 --> 00:03:44,820
كنت لتتمكّن من الهرب بقوّتك هذه

41
00:03:53,170 --> 00:03:55,000
!إنّهم قادمون، اعترضوهم

42
00:03:56,170 --> 00:04:00,510
يا للسذاجة، المقاومة ستجعلكم
تعانون أكثر فحسب

43
00:04:00,750 --> 00:04:04,270
صمتاً، نبلاء المملكة ينحدرون
من سلالة مُغامرين

44
00:04:04,270 --> 00:04:06,740
إنّهم أقوى بكثير مما تتصوّرون

45
00:04:06,740 --> 00:04:08,760
ولا يستسلمون بسهولةٍ أيضاً

46
00:04:12,420 --> 00:04:15,710
إنّهم يظهرون جرأةً كما أردتِ

47
00:04:15,710 --> 00:04:19,330
من يقودون الهجوم هو أحد
أكثر فرسان المملكة تميّزاً

48
00:04:19,330 --> 00:04:21,280
ليون فو بارتفورت

49
00:04:21,540 --> 00:04:23,680
...بارتفورت

50
00:04:26,170 --> 00:04:28,030
لا يستسلمون بسهولةٍ حقّاً

51
00:04:28,740 --> 00:04:31,170
لكنّ سينتهي كلّ ذلك هنا

52
00:04:31,530 --> 00:04:35,540
سيدخلون مجال تصويب مدافعنا قريباً

53
00:04:35,540 --> 00:04:39,540
سنطيح بهم جميعاً، بالإضافة للوحوش

54
00:04:40,690 --> 00:04:44,550
غيلات، ستستغلّ الوحوش التي
أتحكّم بها كطعم؟

55
00:04:44,550 --> 00:04:49,050
يمكننا الاستحواذ على قدرما
نشاء من الوحوش

56
00:04:49,620 --> 00:04:52,050
...ليون... ليفيا

57
00:04:53,590 --> 00:04:54,770
أنا مُندهش

58
00:04:54,770 --> 00:04:55,810
ممَ؟

59
00:04:56,200 --> 00:04:59,550
تلامذة الأكاديميّة، الفتيان تحديداً

60
00:04:59,970 --> 00:05:02,640
إنّهم يقاتلون ببسالةٍ أمام الوحوش

61
00:05:02,640 --> 00:05:05,320
توقّعتُ أن يعانوا أكثر

62
00:05:05,590 --> 00:05:08,440
نبلاء المملكة أقوياءٌ بالأصل لأنّهم

63
00:05:08,440 --> 00:05:10,070
ينحدرون من مُغامرين

64
00:05:10,350 --> 00:05:14,330
يتمرّنون طوال الوقت
كي تتزوّجهم الفتيات

65
00:05:14,670 --> 00:05:16,460
،إن كانوا جادّين حيال إيجاد زوجات

66
00:05:16,460 --> 00:05:20,350
فيصبحون محاربين أفذاذ
مع وقت تخرّجهم

67
00:05:20,350 --> 00:05:22,960
النتائج تحرّك العواطف

68
00:05:22,960 --> 00:05:24,310
!خذي

69
00:05:24,310 --> 00:05:27,090
سنتولّى الأمر هنا، سنفعل أيّ
!ما يتطلّبه الأمر لحماية الفتيات

70
00:05:28,180 --> 00:05:29,340
!موجة أخرى قادمة

71
00:05:31,470 --> 00:05:32,970
أفسحوا الطريق

72
00:05:32,970 --> 00:05:34,810
!ديادري-سينباي

73
00:05:34,810 --> 00:05:38,020
!إعصار الورود

74
00:05:39,290 --> 00:05:44,250
سأقذف تلك الوحوش الكريهة

75
00:05:44,250 --> 00:05:46,700
هنالك رائحةٌ زكيّة

76
00:05:46,700 --> 00:05:48,490
إنّها رائحة أزهار

77
00:05:51,910 --> 00:05:53,490
لا تأبهوا بالصغار

78
00:05:53,490 --> 00:05:56,910
لندع الرفاق على السفينة يتكفّلون
بالباقي بينما نؤدي دورنا

79
00:05:57,190 --> 00:05:58,170
!أجل

80
00:06:01,070 --> 00:06:02,530
أأنت بخير؟

81
00:06:02,530 --> 00:06:07,030
أ-أجل، لم يسبق وأن رأيتُ سحر علاجٍ قبلاً

82
00:06:07,750 --> 00:06:10,930
وكما... يُتوقّع منكم أيّها النبلاء

83
00:06:11,160 --> 00:06:13,170
أنتم بغاية الشجاعة جميعاً

84
00:06:19,350 --> 00:06:20,310
!إنّهم يُطلقون علينا

85
00:06:24,950 --> 00:06:26,320
!مدافعهم تُصوّب نحونا

86
00:06:26,320 --> 00:06:28,190
وسيقصفون وحوشهم أيضاً؟

87
00:06:28,190 --> 00:06:29,370
!كلا

88
00:06:29,370 --> 00:06:30,310
ماذا نفعل؟

89
00:06:30,310 --> 00:06:32,250
!لا يمكننا صدّها

90
00:06:33,200 --> 00:06:35,060
!لـ-لا

91
00:06:36,450 --> 00:06:37,410
تبّاً

92
00:06:38,410 --> 00:06:39,550
!إنّهم قادمون

93
00:06:40,630 --> 00:06:41,920
لا

94
00:06:41,920 --> 00:06:43,200
!تبّاً

95
00:06:44,670 --> 00:06:45,920
!لا

96
00:06:48,390 --> 00:06:49,450
لا!

97
00:06:51,800 --> 00:06:55,930
!لا

98
00:07:04,860 --> 00:07:09,070
!عليّ فعل ما يسعني فعله الآن

99
00:07:15,130 --> 00:07:16,950
...الـ-الوحوش

100
00:07:17,270 --> 00:07:18,160
مُذهل

101
00:07:18,160 --> 00:07:19,700
أكانت هذه الفتاة تلميذة؟

102
00:07:19,700 --> 00:07:22,320
لا عجب أنّكِ تلقّيتِ منحةً دراسيّة

103
00:07:22,320 --> 00:07:24,960
موهبتكِ السحريّة في مستوى آخر

104
00:07:28,340 --> 00:07:32,970
فلتذهب يا ليون-سان، سأحمي أنا السفينة

105
00:07:33,660 --> 00:07:37,470
تلك القدّيسة إذاً؟ مثيرةٌ للإبهار

106
00:07:37,750 --> 00:07:39,740
تفاجأتُ أنا بدوري

107
00:07:39,740 --> 00:07:43,240
،أدوات القدّيسة الأساسيّة
لكنّها لا تزال بهذه القوّة

108
00:07:43,240 --> 00:07:45,230
إنّه نتاج دراستها

109
00:07:45,590 --> 00:07:48,730
اجتهدت في دراستها في الأكاديميّة

110
00:07:48,730 --> 00:07:51,770
ذلك ما جنته من لقائها بك

111
00:07:51,770 --> 00:07:56,990
امتلكت وقتاً للدراسة لحمايتك لها

112
00:07:58,470 --> 00:08:00,870
طالما لم يكن الأمر بلا فائدة

113
00:08:01,270 --> 00:08:02,700
هذه فرصةٌ سانحةٌ لنا

114
00:08:02,700 --> 00:08:04,870
يمكننا الهجوم دون القلق
بشأن ما ورائنا

115
00:08:05,230 --> 00:08:09,090
أجل، خلقت أوليفيا-سان هذه
النافذة الثمينة لنا

116
00:08:09,090 --> 00:08:10,630
لن أهدرها أبداً

117
00:08:11,000 --> 00:08:15,380
جارٍ اختيار الدرب الأقصر، حاذر من ألّا تسقط

118
00:08:17,210 --> 00:08:19,390
الـ-الدرب الأقصر؟

119
00:08:19,900 --> 00:08:22,390
!تقصد أنّنا سندخل فمه؟

120
00:08:32,220 --> 00:08:34,160
يا لها من سفينة مُتعِبة

121
00:08:34,160 --> 00:08:37,030
كما لو أنّ امتطاء الوحش
لم يكن بغيضاً بما يكفي

122
00:08:37,290 --> 00:08:39,530
ما الذي تقولينه؟ لكنّها ظريفة

123
00:08:39,530 --> 00:08:42,290
!ظريفة؟! أأنتِ عمياء؟

124
00:08:42,290 --> 00:08:45,490
يبدو أنّ فارسكِ المميّز كما تدّعين
الذي يقود الهجوم

125
00:08:45,490 --> 00:08:48,420
قد اُلتهم من قبل هذه السفينة

126
00:08:50,430 --> 00:08:54,230
سنسجّل اسمه في سجّلات تاريخ ولايتنا

127
00:08:54,230 --> 00:08:59,930
سيُتذكّر بصفته الأحمق الكليّ الذي
مات بلا مغزى في معارضته للولاية بمفرده

128
00:09:05,200 --> 00:09:06,060
!ليون

129
00:09:06,060 --> 00:09:06,940
!انخفضي

130
00:09:13,320 --> 00:09:16,350
!خذ يا صاحب الشارب الكريه

131
00:09:18,220 --> 00:09:22,080
سترافقينني، ستكونين رهينتنا هذه المرّة

132
00:09:22,610 --> 00:09:25,780
استهنتُ بك يا فارس المملكة

133
00:09:26,390 --> 00:09:28,590
هلّا أخبرتني باسمك؟

134
00:09:31,250 --> 00:09:34,640
لا تحاولي توفير الوقت، سآخذ نايكِ السحريّ أيضاً

135
00:09:34,640 --> 00:09:37,470
حريٌّ بكِ إطاعة ما أمليه عليك

136
00:09:41,120 --> 00:09:45,470
،سيّدي، تلك قطعة مزيّفة
الحقيقيّة مع الخادمة

137
00:09:46,650 --> 00:09:49,070
طور إزالة الشعر الدائم

138
00:09:52,640 --> 00:09:55,140
يا لسوء حظّكِ يا سموّ الأميرة

139
00:09:57,750 --> 00:09:58,990
رصاصة مطاطيّة؟

140
00:09:59,810 --> 00:10:01,650
أي أفقدها وعيها فحسب

141
00:10:05,620 --> 00:10:09,360
حسنٌ، سترافقيننا لسفينتنا يا سموّ الأميرة

142
00:10:09,360 --> 00:10:10,810
كما تشاء

143
00:10:12,330 --> 00:10:13,900
ليون، ما الذي يجري؟

144
00:10:13,900 --> 00:10:16,500
ذلك لأنّنا هزمنا الوحش أسفل السفينة

145
00:10:16,500 --> 00:10:17,880
علينا الإسراع

146
00:10:18,420 --> 00:10:19,370
!السفينة الأمّ

147
00:10:19,370 --> 00:10:20,890
أين الأميرة؟

148
00:10:27,140 --> 00:10:31,150
!أنتم! أميرتكم الغالية هنا

149
00:10:31,150 --> 00:10:35,150
ابتعدوا! حريٌّ بكم إفساح الطريق
!وإلّا تعرفون ما سيحصل

150
00:10:35,150 --> 00:10:35,990
!هذه دناءة

151
00:10:35,990 --> 00:10:36,980
!أيّها الجبان

152
00:10:36,980 --> 00:10:38,150
!وتعتبر نفسك فارساً؟

153
00:10:38,460 --> 00:10:40,780
!حمقى! انظروا للمرآة

154
00:10:50,210 --> 00:10:53,200
أنت لا تُعقل

155
00:10:58,420 --> 00:11:02,070
شكراً لك حقّاً يا ليون

156
00:11:07,990 --> 00:11:09,950
!غيلات-ساما، أنت بخير

157
00:11:11,150 --> 00:11:12,270
ماذا؟

158
00:11:12,570 --> 00:11:14,400
ما الذي حلّ بشاربك؟

159
00:11:14,400 --> 00:11:17,270
!اخرس! تحضّروا للمعركة

160
00:11:17,270 --> 00:11:17,810
!أمرك

161
00:11:17,810 --> 00:11:20,070
تبّاً له

162
00:11:30,250 --> 00:11:32,930
يبدو أنّ أوليفيا-ساما مُنهكة

163
00:11:34,020 --> 00:11:35,420
!بارتفورت

164
00:11:36,160 --> 00:11:38,670
توقّف هجوم العدوّ، ماذا نفعل؟

165
00:11:38,670 --> 00:11:43,180
كلّ ما تبقّى هو الهروب لديارنا
...مع الأميرة رهينةً

166
00:11:43,700 --> 00:11:48,700
لكافة السفن، ضحّت سموّ الأميرة
بنفسها لأجل الولاية

167
00:11:48,700 --> 00:11:50,980
!شنّوا هجوماً شاملاً

168
00:11:50,980 --> 00:11:51,680
...ما

169
00:11:51,940 --> 00:11:54,310
يخبرون أميرتهم بأن تموت؟

170
00:11:54,750 --> 00:11:57,780
لن يكفي هذا لإيقاف الولاية

171
00:11:57,780 --> 00:11:59,940
فيمكن استبدالي

172
00:12:07,280 --> 00:12:08,200
!ما الذي فعلتِه؟

173
00:12:08,200 --> 00:12:11,700
حرّرتُ الوحوش من سيطرتي

174
00:12:11,700 --> 00:12:16,370
ستهاجم من كان يتحكّم بها

175
00:12:16,370 --> 00:12:19,020
قريباً، ستجتمع حول هذه السفينة

176
00:12:21,630 --> 00:12:26,310
إن استمرّت المعركة، فستحاول
أوليفيا-سان استعمال تلك التعويذة مُجدّداً

177
00:12:26,960 --> 00:12:28,470
!تبّاً

178
00:12:29,220 --> 00:12:31,230
لوكسيون، علينا توفير الوقت

179
00:12:31,230 --> 00:12:34,730
لا أمانع، سأتبعك لأيّ مكان

180
00:12:35,690 --> 00:12:36,690
!ليون

181
00:12:37,930 --> 00:12:39,190
!بارتفورت

182
00:12:39,450 --> 00:12:40,670
...ليون

183
00:12:40,670 --> 00:12:42,020
!لمواضعكم جميعاً

184
00:12:42,020 --> 00:12:43,190
!أجل

185
00:12:43,190 --> 00:12:44,020
!تبّاً

186
00:12:44,020 --> 00:12:45,370
لا يمكنني الاستمرار

187
00:12:45,370 --> 00:12:49,200
!يكفي تذمّراً! انقلوا المُصابين للداخل

188
00:12:46,810 --> 00:12:49,200
!لا يمكننا ترك الأمر ينتهي هكذا

189
00:12:50,650 --> 00:12:52,550
ما عساي أفعل؟

190
00:12:53,460 --> 00:12:56,380
سيّدي، أليس هذا العدد كثيراً
على أن تقاتله؟

191
00:12:56,380 --> 00:12:57,470
!اصمت

192
00:12:58,540 --> 00:13:00,020
لأجل المملكة

193
00:13:00,460 --> 00:13:02,740
!تبّاً لكم

194
00:13:02,740 --> 00:13:04,420
...لأجل ليون

195
00:13:15,540 --> 00:13:17,850
أهذه رماح نار؟

196
00:13:18,850 --> 00:13:21,000
لكنّي لم أستطع استعمالها من قبل

197
00:13:24,030 --> 00:13:29,490
!احرقي أعدائي، بل أعداء ليون

198
00:13:31,980 --> 00:13:33,120
...آنجي

199
00:13:33,430 --> 00:13:34,370
!ليون

200
00:13:36,940 --> 00:13:37,620
!ليفيا

201
00:13:37,620 --> 00:13:38,850
!تبّاً لك

202
00:13:40,130 --> 00:13:43,290
!ليفيا، ما الذي تفعلينه؟ اهربي سريعاً

203
00:13:43,950 --> 00:13:45,880
...آ-آنجي

204
00:13:46,890 --> 00:13:50,660
هل استهلكتِ الكثير
من الطاقة السحريّة؟

205
00:13:51,050 --> 00:13:54,580
أردتُ أن أكون ذات فائدة

206
00:13:54,890 --> 00:14:00,150
كلّ ما فعلتُه هو إعاقتكِ وليون-سان

207
00:14:02,110 --> 00:14:04,370
أردتُ منكما أن تعترفا بي

208
00:14:05,290 --> 00:14:07,870
أردتُ أن أصبح صديقةً حقيقيّةً لكما

209
00:14:09,040 --> 00:14:11,660
لذا بذلتُ قصارى جهدي

210
00:14:11,970 --> 00:14:15,240
!يا حمقاء! قمتِ بما يكفي

211
00:14:15,240 --> 00:14:17,910
لم تعيقينا من قبل قطّ

212
00:14:19,350 --> 00:14:20,920
...آنجي

213
00:14:24,610 --> 00:14:28,920
أيّتها الغبيّة، سأعترف بكِ قدرما تشائين

214
00:14:32,630 --> 00:14:37,530
أنتِ صديقتي العزيزة... يا ليفيا

215
00:14:44,650 --> 00:14:45,940
...آنجي

216
00:14:47,810 --> 00:14:49,950
...حمقاء يا ليفيا

217
00:15:10,530 --> 00:15:11,710
لا جدوى

218
00:15:12,490 --> 00:15:17,390
لو عرفتُ بحصول هذا، لأبكرتُ بإخبارهم بشعوري

219
00:15:18,540 --> 00:15:19,850
...ليفيا

220
00:15:19,870 --> 00:15:21,200
...أبي

221
00:15:21,200 --> 00:15:22,270
...أخي

222
00:15:22,690 --> 00:15:23,650
...سموّك

223
00:15:28,270 --> 00:15:31,200
...فهمت... أنا

224
00:15:33,870 --> 00:15:37,210
فلتكن صديقاً صالحاً لليفيا يا ليون

225
00:15:44,110 --> 00:15:45,370
...ليفيا

226
00:15:45,370 --> 00:15:47,630
!حمقاء! هذا خطر! اهربي

227
00:15:48,000 --> 00:15:49,280
!كلا

228
00:15:50,090 --> 00:15:51,630
!لا تفعلي! يكفي

229
00:15:51,630 --> 00:15:54,640
...كلا! أنتِ

230
00:15:55,270 --> 00:15:57,390
!أنتِ مهمّةٌ لي أيضاً يا آنجي

231
00:15:57,680 --> 00:16:00,890
!يا-يا حمقاء! ستسقطين أيضاً

232
00:16:01,140 --> 00:16:06,100
لكن... لكنّكِ قلتِ أنّنا صديقتان

233
00:16:06,950 --> 00:16:10,020
!أنتِ مهمّةٌ لي أيضاً

234
00:16:11,990 --> 00:16:15,280
...يا حمقاء، هذا السبب لا

235
00:16:15,790 --> 00:16:17,410
لا أهتم إن جعلني هذا حمقاء

236
00:16:18,060 --> 00:16:20,530
طالما يمكنني أن أبقى صديقةً لك

237
00:16:21,900 --> 00:16:23,790
طالما يمكننا أن نكون معاً

238
00:16:25,090 --> 00:16:26,270
...ليفيا

239
00:16:34,970 --> 00:16:35,680
!ليفيا

240
00:16:38,680 --> 00:16:39,680
!ليفيا

241
00:16:41,200 --> 00:16:43,930
!ليفيا

242
00:16:52,590 --> 00:16:54,190
كنتُ أعرف

243
00:16:54,190 --> 00:16:59,700
كنتُ أعرف أنّ ليون-سان سيأتي لإنقاذي

244
00:17:02,970 --> 00:17:06,050
تبّاً، تبدو بغاية الارتياح

245
00:17:06,050 --> 00:17:08,210
لوكسيون، تولَّ الملاحة

246
00:17:08,450 --> 00:17:12,250
سأوافق سرعتها النسبيّة، تمسّك بإحكام

247
00:17:12,250 --> 00:17:15,060
الآن وقت الحماية المُفرطة

248
00:17:15,060 --> 00:17:16,220
اصمت

249
00:17:25,450 --> 00:17:31,110
أنتِ بخيرٍ الآن، سأوصلكِ للسفينة
لذا لا تقلقي يا أوليفيا-سان

250
00:17:32,380 --> 00:17:33,360
إنّه ليفيا

251
00:17:33,930 --> 00:17:35,510
...ا-اسمعي

252
00:17:35,510 --> 00:17:39,010
إنّه ليفيا! لمَ لا تناديني بليفيا؟

253
00:17:39,010 --> 00:17:41,370
أتكرهني الآن؟

254
00:17:41,370 --> 00:17:44,620
!لا تنادني بأوليفيا-سان رجاءً

255
00:17:46,260 --> 00:17:48,010
لا يمكنكِ أن تكوني معي

256
00:17:48,540 --> 00:17:51,250
يجب أن تكوني رفيقةً رجلٍ أفضل مني

257
00:17:51,560 --> 00:17:54,520
لمَ تتكلّم عن الرجال الآخرين؟

258
00:17:54,520 --> 00:17:56,100
لا يمكن هذا

259
00:17:56,100 --> 00:18:01,390
،هنالك شبّانٌ يلائمونكِ أكثر
وسماء أو أثرياء يا أوليفيا-سان

260
00:18:01,390 --> 00:18:03,490
تناديني بأوليفيا-سان مُجدّداً

261
00:18:03,490 --> 00:18:05,610
!لا أبالي بذلك

262
00:18:05,610 --> 00:18:07,020
...لـ-لكن

263
00:18:10,230 --> 00:18:11,520
...لكن

264
00:18:11,860 --> 00:18:13,700
!يوجد الأمير يوليوس

265
00:18:13,700 --> 00:18:16,300
أنا أكرهه، أبكى آنجي

266
00:18:16,300 --> 00:18:17,540
ماذا عن جيلك إذاً؟

267
00:18:17,540 --> 00:18:19,280
إنّه متعفّنٌ في الداخل

268
00:18:19,280 --> 00:18:19,990
!براد

269
00:18:19,990 --> 00:18:20,910
!نرجسيّ

270
00:18:20,910 --> 00:18:21,620
!غريغ

271
00:18:21,620 --> 00:18:22,280
!مفتولٌ فارغ العقل

272
00:18:22,280 --> 00:18:22,770
!كريس

273
00:18:22,770 --> 00:18:23,910
!مُتطلّب

274
00:18:24,180 --> 00:18:26,130
لا أحتاج أحداً لآخراً

275
00:18:26,130 --> 00:18:28,810
أريد أن أكون معك يا ليون-سان

276
00:18:28,810 --> 00:18:32,420
،أريد أن أستمتع معك ومع آنجي
كما كنّا نفعل

277
00:18:33,520 --> 00:18:36,170
لكن ليس ذلك جيّداً بما يكفي لك

278
00:18:36,490 --> 00:18:38,420
!أريد أن أكون معك

279
00:18:38,420 --> 00:18:41,430
...ما الرائع في؟ فأنا مجرّد مو

280
00:18:41,430 --> 00:18:45,180
أنا، ليفيا، أحبّك كثيراً يا ليون-سان

281
00:18:45,180 --> 00:18:47,010
وذلك كلّ شيء

282
00:18:48,870 --> 00:18:52,190
!أنا أحبّك

283
00:19:00,410 --> 00:19:02,950
سأصعد يا سيّدي

284
00:19:03,380 --> 00:19:05,450
أ-أجل

285
00:19:08,330 --> 00:19:10,500
لا أدري ما هي الإجابة الصحيحة

286
00:19:10,870 --> 00:19:15,210
بالنسبة لهذا العالم، قد يكون
...الأمر خاطئاً، لكن

287
00:19:16,740 --> 00:19:20,970
تمسّكي بإحكام يا لـ-ليفيا

288
00:19:25,210 --> 00:19:26,190
حسناً

289
00:19:31,620 --> 00:19:35,730
!ثـ-ثيابي سميكةٌ جدّاً، لا أشعر بشيء

290
00:19:36,050 --> 00:19:40,740
صنعّتُ بزّتك خصّيصاً بحيث تقاوم
الضغط الخارجيّ لحدٍّ عالٍ

291
00:19:41,030 --> 00:19:43,670
!كان عليّ توقّع ذلك منك

292
00:19:47,420 --> 00:19:49,490
!ليون! ليفيا

293
00:19:49,890 --> 00:19:50,990
!آنجي

294
00:19:50,990 --> 00:19:54,500
!أيّتها الحمقاء! كنت قلقةٌ جدّاً عليكِ

295
00:19:54,790 --> 00:19:56,680
آسفة

296
00:19:56,680 --> 00:19:58,190
أنا مسرورةٌ لكونكِ بخير

297
00:20:01,520 --> 00:20:02,290
لوكسيون

298
00:20:02,290 --> 00:20:05,510
أعتذر على التأخير، وصلت أخيراً

299
00:20:12,520 --> 00:20:14,360
ما هذه السفينة؟

300
00:20:14,360 --> 00:20:15,520
أهي سفينة عدوّ؟

301
00:20:15,870 --> 00:20:18,520
إنّها الشريك

302
00:20:18,940 --> 00:20:21,900
تمّ تحديد سفينة جديدة، من فئة 700 متر

303
00:20:22,120 --> 00:20:24,660
المدافع الأماميّة مُصوّبة
نحو سفينتين حربيّتين

304
00:20:25,030 --> 00:20:26,410
إطلاق

305
00:20:30,410 --> 00:20:32,770
ما-ما الذي حصل؟

306
00:20:32,770 --> 00:20:35,830
إطلاق مدافع للعدوّ، دمّروا حاجزنا الدفاعيّ

307
00:20:37,310 --> 00:20:41,920
سلب شاربي أوّلاً، والآن يسلب أسطولي؟

308
00:20:42,250 --> 00:20:45,430
حسنٌ، سننقذ الجميع بينما نؤدي دور الدرع

309
00:20:45,810 --> 00:20:47,980
بين سفينة الركّاب والأسطول

310
00:20:47,980 --> 00:20:49,810
عُلِم

311
00:20:53,060 --> 00:20:55,310
بارتفورت، أيمكنك القتال؟

312
00:20:55,550 --> 00:20:58,310
سأريهم من حاولوا افتعال قتالٍ معه

313
00:20:58,650 --> 00:21:03,130
سأعلّم حمقى الولاية مدى رعبي

314
00:21:03,130 --> 00:21:05,200
شخصيّتك عوجاء تماماً

315
00:21:05,420 --> 00:21:07,980
ليون، أترك الباقي بعهدتك

316
00:21:07,980 --> 00:21:10,450
فلتعد آمناً

317
00:21:10,450 --> 00:21:13,380
لوكسيون، اجلب لي بندقيّتي الكبيرة ونصلي

318
00:21:13,380 --> 00:21:15,460
جارٍ فتح الحاوية 1

319
00:21:18,230 --> 00:21:22,650
حسنٌ، لنذهب لتحطيم إرادتهم في القتال

320
00:21:22,650 --> 00:21:25,340
أنت شرّيرٌ بحقّ سيّدي

321
00:21:26,620 --> 00:21:28,490
!درعٌ آخر

322
00:21:28,490 --> 00:21:31,260
سـ-سيّدي، علينا الانسحاب

323
00:21:31,260 --> 00:21:34,530
لا تكن أحمقاً! أخذوا الأميرة والناي السحريّ

324
00:21:34,530 --> 00:21:36,300
وفوق كلّ ذلك، خسرنا أمام صبيّ

325
00:21:36,300 --> 00:21:39,060
تظنّ بإمكاننا الرحيل الآن وحسب؟

326
00:21:39,060 --> 00:21:40,360
...لـ-لكن

327
00:21:41,360 --> 00:21:46,740
صـ-صحيح، كنّا لا نزال نمتلكك

328
00:21:46,740 --> 00:21:51,650
أقوى أبطال الولاية، السيّد
الفارس الأسود فانديل

329
00:23:26,940 --> 00:23:29,260
الفارس الأسود هو لقبٌ رائع

330
00:23:29,260 --> 00:23:31,440
هل نفكّر بلقبٍ لك يا ليون-سان؟

331
00:23:31,440 --> 00:23:33,770
:على هذا النحو، سيكون لقبك
"الفارس أسود القلب"

332
00:23:33,770 --> 00:23:34,510
هذا قاسٍ

333
00:23:34,760 --> 00:23:38,770
الحلقة القادمة: مهما كان عالم
ألعاب الأوتومي شاقاً

334
00:23:38,770 --> 00:23:40,270
أنتِ تحطّمين قلبي