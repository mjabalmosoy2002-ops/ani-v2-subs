1
00:00:09,250 --> 00:00:11,460
أنت في مزاجٌ ممتاز يا سيّدي

2
00:00:11,460 --> 00:00:12,490
أجل

3
00:00:12,490 --> 00:00:16,990
مجرّد التفكير بالتعبير على وجه
زولا يجعلني أهمهم

4
00:00:17,550 --> 00:00:20,100
كما لدينا هذه الجزيرة

5
00:00:20,100 --> 00:00:22,630
أنا فارسٌ مستقلٌّ الآن

6
00:00:22,630 --> 00:00:28,750
أنا محظوظٌ لعثوري على جزيرةٍ غير مأهولة
تليق ببارونيت في طريق عودتي للبيت

7
00:00:29,250 --> 00:00:32,300
يمكن أن تجني لك مالاً في المستقبل
كوجهةٍ سياحيّة

8
00:00:32,300 --> 00:00:35,330
بمقدورك صنع ينابيع ساخنة باستعمال
البلّورات المُنتجة للحرارة

9
00:00:35,330 --> 00:00:38,760
!ينابيع ساخنة! الينابيع الساخنة رائعة

10
00:00:39,070 --> 00:00:41,260
بدأتُ بالتحضيرات سلفاً

11
00:00:41,260 --> 00:00:43,930
يُفترض أن تكون مريحةً
في غضون بضعة أشهر

12
00:00:44,240 --> 00:00:47,120
عليّ إيجاد زوجةٍ الآن فحسب
في الأكاديميّة

13
00:00:47,120 --> 00:00:49,690
ويمكنني عيش حياةٍ يسيرة
كبارونيت بلدٍ ريفيّ

14
00:00:49,690 --> 00:00:51,820
!ماذا؟ بارون؟

15
00:00:52,070 --> 00:00:57,610
أجل، يبدو أنّهم سيمنحون البارونيّة
لليون فو بارتفورت

16
00:00:57,610 --> 00:00:59,570
لـ-لكن لمَ؟

17
00:00:59,970 --> 00:01:04,950
لإتمامه ديماساً غير مستكشف على الأغلب
واكتشاف جزيرة عائمة جديدة

18
00:01:05,290 --> 00:01:08,340
!لـ-تلك الجزيرة تتّسع لبارونيت فحسب

19
00:01:08,340 --> 00:01:13,090
...اخترتُ تلك الرتبة لسبب، إن أصبحتُ باروناً

20
00:01:13,090 --> 00:01:17,420
سيكون عليك إيجاد زوجةٍ
عالية الرتبة في الأكاديميّة

21
00:01:17,420 --> 00:01:18,470
بقرابة رتبة زولا

22
00:01:18,740 --> 00:01:20,100
زولا؟

23
00:01:20,100 --> 00:01:21,610
!زولا؟

24
00:01:26,140 --> 00:01:29,980
!كلا

25
00:03:00,890 --> 00:03:03,090
العاصمة الملكيّة لمملكة هولفورت

26
00:03:03,450 --> 00:03:05,840
،تقع في منتصف قارّةٍ هائلة

27
00:03:05,840 --> 00:03:10,040
وهي مدينةٌ حديثة وجميلة
تتواجد بانسجام مع الطبيعة

28
00:03:10,370 --> 00:03:14,790
تعدادها السكّاني يفوق المليون، ويتمحور
المجتمع حول النبلاء

29
00:03:15,460 --> 00:03:18,960
مذهل، إنّها كالأكاديميّة
من اللعبة تماماً

30
00:03:19,350 --> 00:03:20,700
،للثلاثة أعوامٍ التالية

31
00:03:20,700 --> 00:03:23,580
سأبحث عن زوجةٍ هنا أثناء دراسة

32
00:03:23,580 --> 00:03:27,720
آداب سلوك النبلاء، أساسيّات المُغامرة والسحر حتّى

33
00:03:28,170 --> 00:03:30,980
وصلتُ نقطة بدء اللعبة أخيراً

34
00:03:31,760 --> 00:03:33,920
فلتحمل حقيبتي فوراً

35
00:03:33,920 --> 00:03:36,480
اعذريني سيّدتي

36
00:03:36,730 --> 00:03:39,480
تمتلك النساء قوّةً أكبر
في هذا العالم بحقّ

37
00:03:40,360 --> 00:03:41,740
أريد العودة

38
00:03:43,290 --> 00:03:45,370
!إنّه الأمير ورفاقه

39
00:03:45,780 --> 00:03:48,620
إنّهم العاشقون المُحتملون

40
00:03:48,920 --> 00:03:51,870
كنت أسعى وراءهم إذاً

41
00:03:52,250 --> 00:03:54,500
لا يزال ذلك يغيظني
حتّى بعد 10 أعوام

42
00:03:55,010 --> 00:03:56,140
انظروا هناك

43
00:03:57,120 --> 00:03:58,880
إنّها فتاة ريدغريف

44
00:03:58,880 --> 00:04:01,660
الغريمة الثريّة آنجليكا

45
00:04:01,660 --> 00:04:03,270
إنّها منافسة البطلة

46
00:04:03,270 --> 00:04:06,890
وابنة الدوق الثاني في السلطة
وراء العائلة الملكيّة فقط

47
00:04:07,180 --> 00:04:09,820
اعترضت تقرّباتي العاطفيّة مرّات كثيرة

48
00:04:09,820 --> 00:04:11,360
يا لروعتها

49
00:04:10,370 --> 00:04:12,450
كما يُتوقّع من عائلة الدوق

50
00:04:11,590 --> 00:04:14,360
لا يكفي الرجل العاديّ للظفر بها

51
00:04:14,360 --> 00:04:18,510
حسناً، بالتوفيق في شؤونكم
النبيلة أيّها النبلاء

52
00:04:18,510 --> 00:04:20,900
سأمضي في شؤوني بطريقة الموب

53
00:04:21,250 --> 00:04:22,830
استغرق ذلك وقتاً طويلاً

54
00:04:21,500 --> 00:04:23,360
أتساءل من سنكون معهم

55
00:04:22,830 --> 00:04:24,500
تبدأ الفصول غداً إذاً؟

56
00:04:23,690 --> 00:04:26,490
آمل أن أكون في نفس الفصل
مع نبلاء مرموقين

57
00:04:24,500 --> 00:04:25,910
كيف هو فصلنا يا ترى؟

58
00:04:27,990 --> 00:04:32,980
أشعر بالنعاس، يبدو أنّ مراسم الدخول
مُملة حتّى في الإيسيكاي

59
00:04:36,570 --> 00:04:37,950
هـ-هل ضربتِني للتوّ؟

60
00:04:38,360 --> 00:04:40,300
أتعرفين من أكون؟

61
00:04:40,300 --> 00:04:45,930
كلا، لكنّي لن أتغاظي عن هكذا
فظاظة مهمن كنت

62
00:04:45,930 --> 00:04:48,480
...ماذا؟ هذا الحوار

63
00:04:49,750 --> 00:04:52,430
لستِ كبقيّة الفتيات

64
00:04:52,890 --> 00:04:54,510
هذا حدثٌ من اللعبة

65
00:04:55,110 --> 00:04:57,440
...لكن أليس

66
00:04:59,910 --> 00:05:01,860
ليست البطلة

67
00:05:05,090 --> 00:05:09,070
أشعر أنّي رأيتها في مكانٍ ما من قبل

68
00:05:09,630 --> 00:05:10,490
سيّدي

69
00:05:10,490 --> 00:05:13,090
لوكسيون، كيف كانت المدينة؟

70
00:05:13,090 --> 00:05:16,910
تقنيتي العلميّة أكثر تقدّماً بكثير

71
00:05:17,410 --> 00:05:21,380
لكن عليّ إجراء بحوثٍ أكثر في السحر

72
00:05:21,720 --> 00:05:24,090
كانت هنالك أشياء كثيرة لتراها إذاً؟

73
00:05:24,090 --> 00:05:26,380
لستَ صريحاً أيّها التسوندري

74
00:05:26,690 --> 00:05:31,570
تسوندري؟ أتتأمّل منّي أن
أتقمّص دور فتاةٍ لك؟

75
00:05:31,570 --> 00:05:36,080
لا جنس لي، فلا يمكنني الإجابة
على تلك المشاعر

76
00:05:36,080 --> 00:05:37,890
أنت تغيظني بحقّ

77
00:05:37,890 --> 00:05:41,620
تدرس بالفعل؟ لا تبدو أنّك مُتحفّز لذاك الحدّ

78
00:05:41,620 --> 00:05:42,770
لا أدرس

79
00:05:43,480 --> 00:05:45,350
أنا أحضّر لحفلة شاي

80
00:05:47,160 --> 00:05:49,780
دانيل، ريموند

81
00:05:49,780 --> 00:05:54,410
أوجدتما أيّة خيوط لفتيات لسن
من عائلات ثريّة مثلنا؟

82
00:05:54,410 --> 00:05:57,460
البتّة، صحيح يا ريموند؟

83
00:05:57,460 --> 00:06:00,790
لا أبالي بمن يكنّ طالما
يحضرن حفلة الشاي خاصّتي

84
00:06:00,790 --> 00:06:03,220
،نقوم بهذا لإرضاء الفتيات فحسب

85
00:06:03,220 --> 00:06:05,850
لكن إذا انتشر أنّنا لا نستطيع
إقامة حفلات شاي حتّى

86
00:06:05,850 --> 00:06:08,050
فسيصبح الزواج أصعب

87
00:06:11,050 --> 00:06:12,330
!سموّك

88
00:06:12,330 --> 00:06:14,030
هل تقيم حفلة شاي؟

89
00:06:14,030 --> 00:06:15,040
!أودّ القدوم

90
00:06:15,040 --> 00:06:15,930
!وأنا

91
00:06:15,930 --> 00:06:18,670
سيكون هذا العام صعباً بما
أنّه يوجد الأمير

92
00:06:18,670 --> 00:06:20,350
وعدّة نبلاء آخرين مرموقين

93
00:06:20,350 --> 00:06:24,530
الفتيات اللواتي يعاملننا ببرود
يفقدن صوابهنّ معهم

94
00:06:24,530 --> 00:06:26,690
رفقاً بنا

95
00:06:27,060 --> 00:06:28,100
سموّك

96
00:06:29,720 --> 00:06:31,950
عليّ الكلام معك بخصوص حفلة الشاي

97
00:06:32,280 --> 00:06:34,580
هل لي أن أنضمّ لكم؟

98
00:06:36,090 --> 00:06:40,460
لا تحاولي إرهابي يا آنجليكا، نحن في الأكاديميّة

99
00:06:40,820 --> 00:06:46,460
أدرك ذلك، لكن... المحيط حولك مزعجٌ قليلاً

100
00:06:48,320 --> 00:06:50,220
تبدو متوتّرةً

101
00:06:50,670 --> 00:06:53,970
لا تنظر، لا تلفت الانتباه، لا تتورّط

102
00:06:54,480 --> 00:06:55,970
...الـ-المعذرة

103
00:06:56,870 --> 00:06:59,310
كنتُ أبحث عنك يا ماري

104
00:07:00,300 --> 00:07:02,600
هل استدعيتني سموّك؟

105
00:07:04,680 --> 00:07:06,960
سأقيم حفلة الشاي خاصّتي قريباً

106
00:07:06,960 --> 00:07:08,880
أودّ منكِ القدوم

107
00:07:08,880 --> 00:07:09,480
ماذا؟

108
00:07:09,480 --> 00:07:10,840
تمهّل

109
00:07:10,840 --> 00:07:12,610
لا يصحّ أن تحضرها

110
00:07:13,210 --> 00:07:15,530
أنا في هذه المدرسة كأحد تلاميذها

111
00:07:15,850 --> 00:07:19,870
قد تكونين خطيبتي، لكن لا حقّ لك
في التدخّل في شؤوني لهذه الدرجة

112
00:07:20,770 --> 00:07:22,870
سـ-سامحني

113
00:07:23,120 --> 00:07:26,060
هذا حدثٌ إجباريّ من اللعبة

114
00:07:26,060 --> 00:07:30,130
...يُفترض أن تُحمى البطلة من قِبل الأمير، لكن

115
00:07:30,600 --> 00:07:32,630
أعتذر بشأن ذلك يا ماري

116
00:07:32,630 --> 00:07:37,890
لا بأس، لكن أأنت متأكّدٌ أنّ لا بأس من قدومي؟

117
00:07:38,410 --> 00:07:42,630
لم يسبق وأن رأيتك تسعى وراء
فتاةٍ كهذه سموّك

118
00:07:42,630 --> 00:07:44,380
تـ-توقّف يا جيلك

119
00:07:44,790 --> 00:07:48,520
بـ-بأيّ جال، أودّ منكِ القدوم

120
00:07:48,520 --> 00:07:49,980
...سموّك

121
00:07:50,760 --> 00:07:51,780
!سأفعل

122
00:07:54,280 --> 00:07:56,180
ما الذي يجري؟

123
00:07:59,020 --> 00:08:03,790
حفلة الشاي هي بمثابة
مرآةٌ تعكس الشخص

124
00:08:04,140 --> 00:08:06,390
،من سلوكك إلى كلماتك

125
00:08:06,390 --> 00:08:13,520
كلّ شاي وأكلةٍ تُقدّم في حفلة
الشاي تعبّر عن ماهيّة الشخص

126
00:08:09,480 --> 00:08:10,950
يا للإزعاج

127
00:08:10,950 --> 00:08:14,230
لا أصدّق أنّي أحضر درس آداب
مع مجموعة فتيان

128
00:08:14,230 --> 00:08:15,050
سيّد ليون

129
00:08:15,050 --> 00:08:16,550
أ-أجل

130
00:08:16,930 --> 00:08:19,560
هلّا أصغيتَ بانتباهٍ أكبر؟

131
00:08:20,180 --> 00:08:21,750
إنّه المُغامر الذي يتكلّم الكلّ عنه

132
00:08:21,750 --> 00:08:23,320
هذه مشكلة الريفيّين

133
00:08:23,320 --> 00:08:25,710
يخال نفسه عظيماً لأنّه
حقّق القليل وحسب

134
00:08:25,710 --> 00:08:27,210
إنّه ابن البارون لا أكثر

135
00:08:27,770 --> 00:08:28,560
اخرسوا

136
00:08:29,170 --> 00:08:34,910
سيّد ليون، من المهمّ الرغبة بدعوة
الفتيات إلى مكانٍ خاص

137
00:08:36,100 --> 00:08:38,070
لا يبدو أنّك تفهم

138
00:08:38,480 --> 00:08:41,580
لمَ لا أريك؟ تعال للمُقدّمة من فضلك

139
00:08:41,940 --> 00:08:44,670
أشعر بالحماس

140
00:08:46,430 --> 00:08:47,830
حفلة شاي؟ يا للهراء

141
00:08:48,280 --> 00:08:50,590
إنّه محض حدثٍ غبيّ لجذب الفتيات

142
00:08:50,940 --> 00:08:52,590
!سينسي

143
00:08:53,010 --> 00:08:54,940
هل فهمت الآن؟

144
00:08:54,940 --> 00:08:58,380
أجل، أشعر بالإحراج من نفسي لسخريتي

145
00:08:58,380 --> 00:09:02,110
آمل أن أقيم حفلات شاي
مثاليّة مثلك يوماً ما

146
00:09:02,110 --> 00:09:05,100
لا يزال أمامي الكثير لأتعلّمه

147
00:09:05,660 --> 00:09:08,600
لنسلك درب الشاي معاً

148
00:09:08,600 --> 00:09:11,610
!حاضر سينسي! بل يا معلّم

149
00:09:11,610 --> 00:09:13,550
ما الذي حلّ به؟

150
00:09:13,550 --> 00:09:14,810
من يعلم؟

151
00:09:16,650 --> 00:09:18,610
أنت تبذل جهداً كبيراً

152
00:09:19,030 --> 00:09:22,830
كنت تنوي تعيين مساعدةٍ
والارتياح حتّى مؤخراً

153
00:09:22,830 --> 00:09:26,250
هذا بفضل معلّمي، لقد وُلِدت من جديد

154
00:09:26,710 --> 00:09:30,590
،من المُبهر أنّك استأجرت هذه الغرفة
لكن هل ستأتي فتيات حقّاً؟

155
00:09:30,590 --> 00:09:33,000
!سيأتين! ستأتي فتاة بارون

156
00:09:34,110 --> 00:09:35,010
رأيت؟ ها هي

157
00:09:35,800 --> 00:09:37,250
...شكراً على قدو

158
00:09:37,250 --> 00:09:37,790
ماذا؟

159
00:09:37,790 --> 00:09:39,000
مرحباً

160
00:09:39,000 --> 00:09:41,430
لم تأتي بمفردك؟

161
00:09:41,430 --> 00:09:45,270
كلا، جلبتُ صديقاتي وخادمهنّ

162
00:09:45,620 --> 00:09:48,520
توجد الكثير من الأكلات الخفيفة

163
00:09:48,520 --> 00:09:53,600
سنذهب لحفلة شاي براد-ساما، لكن كان
لدينا وقتٌ حتّى حينها

164
00:09:53,600 --> 00:09:55,650
خطر لي أنّ بإمكاننا احتساء الشاي

165
00:09:55,650 --> 00:09:58,150
أنا أريد أيضاً

166
00:09:58,150 --> 00:09:59,780
بسرعة

167
00:09:58,800 --> 00:10:00,630
أشعر بالعطش

168
00:09:59,780 --> 00:10:01,160
مذاقه جيّد

169
00:10:01,160 --> 00:10:03,030
حسناً، هل نذهب؟

170
00:10:03,030 --> 00:10:04,160
أجل

171
00:10:04,490 --> 00:10:08,920
شكراً، كانت طريقةً حسنة لإمضاء الوقت

172
00:10:08,920 --> 00:10:10,920
إلى اللقاء

173
00:10:11,250 --> 00:10:15,960
لكن عليك إنفاق المزيد على الأكلات
إذا أردت إرضاء الفتيات

174
00:10:18,510 --> 00:10:22,570
سيّدي، طريق الشاي طويلٌ ووعر

175
00:10:22,570 --> 00:10:23,350
ماذا؟

176
00:10:23,350 --> 00:10:24,940
من تخالين نفسك؟

177
00:10:25,430 --> 00:10:27,310
هل دعاكِ براد-ساما؟

178
00:10:27,310 --> 00:10:28,970
فلتعرفي مقامك

179
00:10:28,970 --> 00:10:30,180
حمقاء

180
00:10:33,440 --> 00:10:35,970
لمَ لا تنظّفين القمامة أيّتها العاميّة؟

181
00:10:34,720 --> 00:10:37,140
لا تغتري بنفسك

182
00:10:37,140 --> 00:10:38,690
...تلك الفتاة

183
00:10:38,690 --> 00:10:43,320
أهذا ما يدعونه بالتنمّر؟ أعتقد أنّها
أتت هنا بمنحة

184
00:10:43,730 --> 00:10:44,810
...أوليفيا

185
00:10:45,680 --> 00:10:47,570
إنّها بطلة هذه اللعبة

186
00:10:57,340 --> 00:11:01,220
...لا أريد التورّط في قصّة اللعبة حقّاً، لكن

187
00:11:01,960 --> 00:11:03,280
أيّتها الفتاة

188
00:11:04,840 --> 00:11:06,600
أتريدين احتساء شاي؟

189
00:11:15,000 --> 00:11:16,230
لذيذة

190
00:11:16,550 --> 00:11:19,250
لم يسبق وأن تناولت حلويات
لذيذة كهذه من قبل

191
00:11:19,250 --> 00:11:21,590
أيمكنني احتساء هذا الشاي أيضاً؟

192
00:11:21,590 --> 00:11:24,740
أجل، كان على وشك أن يُهدر بأيّ حال

193
00:11:26,370 --> 00:11:27,940
كانت طريقةً حسنة لإمضاء الوقت

194
00:11:27,940 --> 00:11:29,640
أسرعي أيّها البطيء

195
00:11:29,640 --> 00:11:32,000
قدّم أشياء باهظة أكثر المرّة القادمة

196
00:11:34,560 --> 00:11:36,000
لذيذٌ جدّاً

197
00:11:36,240 --> 00:11:39,400
جدّياً؟ إنّها فتاةٌ بغاية اللطف

198
00:11:39,400 --> 00:11:41,760
أيّ أحمقٍ قد يدعوها بالمراوغة؟

199
00:11:42,010 --> 00:11:44,260
يا للبطلة المراوغة

200
00:11:48,900 --> 00:11:52,390
أخبريني، هل الأوضاع هكذا لكِ دوماً؟

201
00:11:54,770 --> 00:11:58,370
لا شيء أفعله يمضي بخيرٍ أبداً

202
00:11:58,370 --> 00:12:02,030
لستُ متأكّدة إن كان لا بأس من قدوم
عاميّةٍ مثلي لهذه المدرسة

203
00:12:03,250 --> 00:12:05,130
لا بأس بالتأكيد

204
00:12:05,130 --> 00:12:06,410
أنتِ البطلة بالأصل

205
00:12:06,850 --> 00:12:10,530
أريد دراسة السحر أكثر في الواقع

206
00:12:11,090 --> 00:12:15,740
لكنّي لا أعرف الكثير عن قواعد
الأكاديميّة والاتّفاقيات اللا منطوقة

207
00:12:16,920 --> 00:12:18,790
لا تبكي

208
00:12:18,790 --> 00:12:21,780
أعرف شخصاً يمكننا الاعتماد عليه

209
00:12:21,780 --> 00:12:23,550
قد تتمكّن من مساعدتنا

210
00:12:23,550 --> 00:12:24,050
ماذا؟

211
00:12:24,480 --> 00:12:26,300
!حقّاً؟

212
00:12:26,640 --> 00:12:28,220
!ساطعةٌ جدّاً

213
00:12:29,480 --> 00:12:33,060
استدعيتني إذاً أيّها الأخ الأحمق؟

214
00:12:33,060 --> 00:12:35,810
فلتقدّمي فائدةً من حينٍ لآخر

215
00:12:35,810 --> 00:12:38,310
أخذتِ مالاً كثيراً منّي

216
00:12:39,810 --> 00:12:42,340
قلتِ أنّ اسمكِ أوليفيا، صحيح؟

217
00:12:42,340 --> 00:12:45,480
هل قدّمتِ نفسك للفتاة الأعلى
مقاماً في فصلك؟

218
00:12:45,480 --> 00:12:50,080
،كلا، لديها الكثير من التابعين
لا أستطيع الاقتراب منها

219
00:12:50,330 --> 00:12:51,850
،في هذه الحالات

220
00:12:51,850 --> 00:12:55,620
عليكِ أن تطلبي من أحد أتباعها
الهامين التوسّط لك

221
00:12:55,620 --> 00:12:58,830
أعطها هديّةً أو شيئاً يعجبها

222
00:12:58,830 --> 00:13:00,640
تقصدين رشوة

223
00:13:00,640 --> 00:13:03,340
!ذلك يُفلح، حسناً؟ لا تشكّكي

224
00:13:03,640 --> 00:13:06,420
أعطها أكلات خفيفة من متجرٍ شعبيّ

225
00:13:06,420 --> 00:13:09,000
أ-أكلات خفيفة من متجر شعبيّ؟

226
00:13:10,450 --> 00:13:12,350
إنّها باهظة، أليس كذلك؟

227
00:13:13,120 --> 00:13:14,730
اجعليه يدفع ثمنها

228
00:13:14,730 --> 00:13:17,410
!ماذا؟ لمَ تقرّرين أنتِ ذلك؟

229
00:13:17,410 --> 00:13:18,980
...مئة ديا

230
00:13:18,980 --> 00:13:20,490
...مئتا ديا

231
00:13:22,100 --> 00:13:25,080
لا بأس، سأدفع مقابلها

232
00:13:25,080 --> 00:13:27,670
أ-أعدك بأن أردّ لك

233
00:13:30,400 --> 00:13:32,550
،لا أعلم من أخبركِ بفعل هذا

234
00:13:32,550 --> 00:13:34,860
لكنّكِ تستحقّين إطراءً
لقدومك للتعريف بنفسك

235
00:13:34,860 --> 00:13:36,750
شـ-شكراً لك

236
00:13:37,040 --> 00:13:41,630
سأسمح لكِ بالجلوس بصمتٍ في زاوية
إن كنتِ تعرفين مقامك

237
00:13:42,050 --> 00:13:45,650
أ-أتقصدين أنّ لا بأس
من كوني في الأكاديميّة؟

238
00:13:55,610 --> 00:13:57,140
...ا-المعذرة

239
00:13:57,530 --> 00:14:01,630
،كان يُفترض بكِ الإيماء بصمت
كان كلّ شيءٍ لينتهي

240
00:14:02,260 --> 00:14:05,650
تعقّدت الأمور الآن لأنّكِ طرحتِ سؤالاً

241
00:14:05,920 --> 00:14:07,030
ماذا؟

242
00:14:07,030 --> 00:14:11,580
،لا أحاول إبعادكِ من الأكاديميّة

243
00:14:11,580 --> 00:14:14,910
لا أملك وقتاً لذلك، ولا يروقني
ذاك السلوك الفظّ

244
00:14:15,210 --> 00:14:19,920
حـ-حقّاً؟ أنا آسفة

245
00:14:23,730 --> 00:14:26,640
لعلّكِ أفضل من تلك الفتاة
التي تستلطف الأمير

246
00:14:27,460 --> 00:14:31,370
طالبة المنحة الدراسية، من أوصاك بفعل هذا؟

247
00:14:31,370 --> 00:14:32,930
كان ليون-سان

248
00:14:33,480 --> 00:14:35,730
الابن الثالث لعائلة بارتفورت؟

249
00:14:36,190 --> 00:14:38,780
من حصل على البارونيّة
من تلقاء نفسه؟

250
00:14:39,310 --> 00:14:41,440
إنّه شخصٌ مُبهر

251
00:14:41,680 --> 00:14:43,440
أليس كذلك؟

252
00:14:44,880 --> 00:14:48,940
لكنّ كفاءته تعني أنّ هنالك
من سيريدون استغلاله

253
00:14:54,950 --> 00:14:57,700
تبّاً، دانيل وريموند

254
00:14:57,980 --> 00:15:00,710
تغيّبا عن درس الاستكشاف

255
00:15:01,100 --> 00:15:05,710
ولزيادة الطين بلّة، زملائي
هم العاشقون المحتملون

256
00:15:06,050 --> 00:15:10,350
آسفة، أصرّ الآخرون على قدومهم

257
00:15:10,350 --> 00:15:11,720
...علاوةً على ذلك

258
00:15:11,720 --> 00:15:13,790
لندعهما يسبقاننا

259
00:15:13,790 --> 00:15:15,710
لنتركهما يتولّيان الأمور الخطرة

260
00:15:15,710 --> 00:15:19,730
إنّهما مُغامرٌ مخضرم وطالبة
منحة دراسيّة بأيّ حال

261
00:15:19,730 --> 00:15:24,730
،يعاملوننا كحارسين مريحين لهم
لا، بل كدروع من لحم

262
00:15:25,060 --> 00:15:26,580
حسناً يا سادة

263
00:15:26,580 --> 00:15:29,950
هذه فرصةٌ لتطبيق تقنيات السحر
والقتال التي تعلّمتموها

264
00:15:30,330 --> 00:15:33,990
فلتنزلوا للطابق الثالث من الديماس
وتجمعوا البلّورات هناك

265
00:15:34,430 --> 00:15:36,800
انتبهوا من الوحوش

266
00:15:36,800 --> 00:15:38,570
حاضر

267
00:15:36,800 --> 00:15:38,570
حسناً

268
00:15:39,290 --> 00:15:41,070
هلّا ذهبنا يا أوليفيا-سان؟

269
00:15:41,070 --> 00:15:41,980
أجل

270
00:15:41,980 --> 00:15:43,460
!يكفي

271
00:15:44,280 --> 00:15:46,050
!أخبرتكِ أن تعرفي مقامك

272
00:15:46,380 --> 00:15:48,520
منزلة الأمير الاجتماعيّة ومنزلتك
!مختلفتين تماماً

273
00:15:51,250 --> 00:15:53,010
آنجليكا، توقّفي

274
00:15:53,010 --> 00:15:57,260
سموّك، ستترك هذه الفتاة
تنال ما تريده؟

275
00:15:57,810 --> 00:16:02,140
أردتُ أن أكون مع الأمير فقط

276
00:16:02,140 --> 00:16:04,770
إذا كان ذلك يضايقكِ، فيمكنك أن تقولي وحسب

277
00:16:05,860 --> 00:16:08,020
كيف تجرؤين على التصرّف هكذا مُجدّداً؟

278
00:16:08,020 --> 00:16:08,800
ما الذي يجري؟

279
00:16:08,800 --> 00:16:09,670
هل تتشاجران من جديد؟

280
00:16:09,670 --> 00:16:10,210
ما الذي حصل؟

281
00:16:10,210 --> 00:16:14,410
أخبريني يا أوليفيا-سان، أتعرفين شيئاً
عن هذه الفتاة ماري؟

282
00:16:15,360 --> 00:16:18,090
أعتقد أنّها ابنة فيكونت فقير

283
00:16:18,090 --> 00:16:21,540
تعرّضت لتنمّرٍ أقسى منّي مؤخراً

284
00:16:22,750 --> 00:16:25,120
كيف لها أن تستلطفه هكذا
أمام خطيبته؟

285
00:16:25,120 --> 00:16:27,990
ألم تكن تتصرّف بودٍّ
مع فتيان آخرين أيضاً؟

286
00:16:27,990 --> 00:16:29,800
إنّها فظيعة، لا أصدّقها

287
00:16:29,800 --> 00:16:30,800
!يكفي

288
00:16:32,170 --> 00:16:36,680
آنجليكا-سان، لا تضايقي الأمير
كثيراً من فضلك

289
00:16:36,680 --> 00:16:40,160
لا تقحمي العلاقات الخارجيّة في الأكاديميّة

290
00:16:40,160 --> 00:16:41,680
ذلك يثير الأعصاب

291
00:16:41,680 --> 00:16:44,980
أ-أنا أقوم بما هو في صالح الأمير فقط

292
00:16:44,980 --> 00:16:46,160
هيّا بنا يا ماري

293
00:16:46,160 --> 00:16:47,690
حـ-حسناً

294
00:16:52,920 --> 00:16:57,290
،قد تمتلك النساء قوّةً أكبر في هذا العالم
لكنّ هؤلاء هم الاستثناء الوحيد

295
00:16:57,930 --> 00:16:59,260
...حسنٌ

296
00:17:03,580 --> 00:17:06,460
ليون-سان، تمكّنتُ من استخراج بلّورة

297
00:17:07,140 --> 00:17:09,800
مُبارك، هذه 100 ديا مضمونة

298
00:17:09,800 --> 00:17:13,870
أجل، يمكنني ردّ المال الذي
استعرته منك الآن

299
00:17:14,700 --> 00:17:15,970
يمكنكِ ذلك في أيّ وقت

300
00:17:16,500 --> 00:17:19,860
ألا توجد صناديق كنوز في الدياميس أيضاً؟

301
00:17:19,860 --> 00:17:23,220
أتساءل من تركها، أليس ذلك غريباً؟

302
00:17:23,220 --> 00:17:25,730
معكِ حقّ، إنّه غريب

303
00:17:25,730 --> 00:17:28,800
ماذا؟ لا تشعر بالفضول يا ليون-سان؟

304
00:17:28,800 --> 00:17:30,480
ليس تماماً

305
00:17:31,420 --> 00:17:33,380
أنت باردٌ يا ليون-سان

306
00:17:34,490 --> 00:17:36,900
لا جدوى في التشكيك

307
00:17:36,900 --> 00:17:40,660
فهذا أحد الدياميس مُبهمة المعالم
من لعبة الأوتومي تلك

308
00:17:41,400 --> 00:17:45,780
بصراحة، الاقتراب من أوليفيا-سان أكثر
سيكون فكرةً سيّئة

309
00:17:45,780 --> 00:17:48,410
مقدّرٌ لها أن تصبح صديقةً
مع الأمير وجماعته

310
00:17:49,520 --> 00:17:51,550
لم يصل البقيّة بعد

311
00:17:51,550 --> 00:17:55,530
بالطبع لا، نحن محض دروع لحمٍ لهم

312
00:17:59,710 --> 00:18:01,280
!ليون-سان

313
00:18:01,720 --> 00:18:04,070
عـ-علينا طلب المساعدة
!من الآخرين فوراً

314
00:18:04,070 --> 00:18:07,910
لا جدوى، كانت نيّتهم أن نكون
دروعاً من البداية

315
00:18:07,910 --> 00:18:09,180
...لكن

316
00:18:09,180 --> 00:18:13,010
آمل أن يموت أولئك الفتيان الأثرياء بصراحة

317
00:18:13,750 --> 00:18:17,530
ربما سأختبر هذا السيف
الذي صنعه لوكسيون

318
00:18:26,060 --> 00:18:27,790
!الأخير

319
00:18:29,870 --> 00:18:31,970
أ-أنت قويّ

320
00:18:32,580 --> 00:18:35,270
كنتُ أتمرّن في موطني

321
00:18:35,270 --> 00:18:37,630
قاتلتُ مخلوقات أكثر شناعةً أيضاً

322
00:18:40,430 --> 00:18:41,580
...تبّاً لك

323
00:18:45,640 --> 00:18:47,560
أخافني ذاك الشيء

324
00:18:47,560 --> 00:18:51,110
آ-آسفة، كنت تحميني

325
00:18:55,790 --> 00:18:56,960
...ليون-سان

326
00:18:57,520 --> 00:18:59,190
نعتذر على الإطالة

327
00:18:59,450 --> 00:19:01,390
سنتكفّل بالباقي

328
00:19:02,990 --> 00:19:04,700
يا لجرأتهم

329
00:19:07,990 --> 00:19:09,710
أتشعرين بالحوف يا ماري؟

330
00:19:09,710 --> 00:19:11,710
لا، أنا بخير

331
00:19:13,520 --> 00:19:16,440
أنا قلقٌ أكثر على الأمير

332
00:19:16,440 --> 00:19:19,210
الأشخاص المترعرعون في القصر
يكونون أضعف في العادة

333
00:19:19,480 --> 00:19:22,220
ويحك، لا تتكلّم بفظاظةٍ عن الأمير

334
00:19:22,220 --> 00:19:25,720
نحن تلامذةٌ الآن، إنّنا متكافئون هنا

335
00:19:25,720 --> 00:19:29,290
سيجعلكِ هذا الشاب تمرّين بالعناء
إن تزوّجتِه يا ماري

336
00:19:39,080 --> 00:19:40,490
!كتل لحم

337
00:19:46,340 --> 00:19:47,620
!علينا مساعدته

338
00:19:47,620 --> 00:19:52,120
اهدئي، الأمير ليس بالشخص الضعيف

339
00:20:01,010 --> 00:20:03,130
!تأذّيت يا سموّك

340
00:20:06,100 --> 00:20:08,240
إ-إنّه محض خدش

341
00:20:14,520 --> 00:20:19,020
ما-ماري، يمكنك استعمال سحر العلاج؟

342
00:20:19,510 --> 00:20:20,540
صه

343
00:20:20,540 --> 00:20:21,780
!سموّك

344
00:20:23,150 --> 00:20:24,030
!ماري

345
00:20:24,430 --> 00:20:26,780
أأنت بخير؟ دعني أعالج جراحك

346
00:20:29,480 --> 00:20:30,790
ذلك ليس ضرورياً

347
00:20:31,090 --> 00:20:31,860
ماذا؟

348
00:20:32,730 --> 00:20:34,210
أأنتِ بخيرٍ يا ماري؟

349
00:20:34,210 --> 00:20:35,790
أ-أجل

350
00:20:38,150 --> 00:20:41,250
سموّك، لمَ تمسك بيد ماري؟

351
00:20:41,250 --> 00:20:43,800
لا تحاول التقدّم علينا

352
00:20:43,800 --> 00:20:45,350
هل رأيتِ ذلك؟

353
00:20:45,350 --> 00:20:46,430
أشعر بالأسى عليها

354
00:20:46,430 --> 00:20:48,520
أهي خطيبته حقّاً؟

355
00:20:52,940 --> 00:20:54,430
!ليون-سان، تأذّيت

356
00:20:54,950 --> 00:20:56,940
هذا لا يُذكر

357
00:20:58,010 --> 00:20:59,440
سأعالجك فوراً

358
00:21:06,410 --> 00:21:07,550
شكراً لك

359
00:21:08,200 --> 00:21:11,230
السحر هو الشيء الوحيد الذي أجيده

360
00:21:11,230 --> 00:21:16,620
بدأتُ بارتياد هذه الأكاديميّة لأنّ
معلّماً اكتشف موهبتي

361
00:21:16,620 --> 00:21:18,210
ذلك مُبهر

362
00:21:18,890 --> 00:21:21,560
يسرّني أنّي أفدتك يا ليون-سان

363
00:21:24,190 --> 00:21:25,900
...عجباً

364
00:21:25,900 --> 00:21:29,720
...إنّها البطلة، وأنا محض شخصيّة موب، لكن

365
00:21:30,840 --> 00:21:34,420
مع ذلك، ما الذي يجري؟

366
00:21:35,230 --> 00:21:37,600
لمَ هذا الاختلاف عن اللعبة؟

367
00:23:26,540 --> 00:23:28,920
تتحدّى المرء برمي قفّازٍ عليه، صحيح؟

368
00:23:28,920 --> 00:23:30,900
أجل، هكذا تعلن نهاية الصداقة أيضاً

369
00:23:30,900 --> 00:23:32,090
ليس شيئاً تفعله بتهوّر

370
00:23:32,090 --> 00:23:33,310
حقّاً؟ لم أكن أعرف

371
00:23:33,310 --> 00:23:35,050
لم تعرف ذلك حتّى؟

372
00:23:35,050 --> 00:23:36,850
أتريد الشجار؟ تعال

373
00:23:36,850 --> 00:23:38,760
لنتنازل أيّها الأمير

374
00:23:38,760 --> 00:23:41,020
أخبرتك ألّا تتهوّر