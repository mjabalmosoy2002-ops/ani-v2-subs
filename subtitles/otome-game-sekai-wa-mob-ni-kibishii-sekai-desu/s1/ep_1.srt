1
00:00:02,130 --> 00:00:03,490
أكرهكم

2
00:00:05,670 --> 00:00:09,370
أكرهكم بحقّ

3
00:00:15,240 --> 00:00:16,960
أضربتِني؟

4
00:00:16,960 --> 00:00:18,490
أتعرفين من أكون؟

5
00:00:18,490 --> 00:00:24,000
كلا، لكنّي لن أتغاظي عن هكذا
فظاظة مهمن كنت

6
00:00:25,200 --> 00:00:27,000
يا للإزعاج

7
00:00:27,250 --> 00:00:30,000
تستنزف كلّ قوّة إرادتي

8
00:00:30,000 --> 00:00:32,760
أتجهلين من أكون حقّاً؟

9
00:00:36,610 --> 00:00:40,420
لا بدّ أنّها تكذب في عدم تعرّفها
على أمير بلادها

10
00:00:40,420 --> 00:00:43,390
يا للبطلة المراوغة

11
00:00:44,210 --> 00:00:46,810
صمّم الشخصيات رسّامٌ مشهور

12
00:00:46,810 --> 00:00:48,650
وأدّى أصواتهم طاقم ممثلين مشاهير

13
00:00:49,320 --> 00:00:53,150
يُفترض أنّها اللعبة الجديدة المُترقّبة
...من مطوّرٍ كبير، لكن

14
00:00:57,660 --> 00:01:02,660
عالم ألعاب الأوتومي هذا
مناسبٌ كثيراً للفتيات

15
00:01:03,020 --> 00:01:08,670
لمَ عليّ قضاء أيام عطلتي الثمينة
في تحسين علاقاتي مع رجال؟

16
00:01:14,240 --> 00:01:17,050
!السفر للخارج مسلٍّ

17
00:01:18,190 --> 00:01:21,220
كانت من فرضت هذه اللعبة عليّ

18
00:01:22,710 --> 00:01:24,040
لعبة أوتومي؟

19
00:01:24,040 --> 00:01:28,940
،أريد الاستماع لمقطع صوت إنهاء اللعبة
لكنّي لا أستطيع تحمّل عناء لعبها

20
00:01:29,160 --> 00:01:31,100
لكن لمَ عليّ أنا لعبها؟

21
00:01:31,100 --> 00:01:35,190
يجب أن تفعل، وإلّا سأفضح أمرك ذاك لأمّي

22
00:01:36,170 --> 00:01:39,350
حسناً، أعتمد عليك بإنهائها كليّاً

23
00:01:40,320 --> 00:01:44,330
تبّاً، لمَ أقوم بهذا؟

24
00:01:44,330 --> 00:01:46,690
سأقيم حفلة شاي قريباً

25
00:01:46,690 --> 00:01:48,580
أودّ منكِ القدوم

26
00:01:50,870 --> 00:01:55,090
لن تكون ملائمةً في حفلتك

27
00:01:52,670 --> 00:01:55,090
الغريمة الثريّة النمطيّة

28
00:01:55,440 --> 00:01:58,780
لمَ يكترث النبلاء لهذا الحدّ
بالمقام الاجتماعيّ؟

29
00:01:55,680 --> 00:01:58,230
أنا في هذه المدرسة كأحد تلاميذها

30
00:01:58,230 --> 00:02:02,370
قد تكونين خطيبتي، لكن لا حقّ لك
في التدخّل في شؤوني لهذه الدرجة

31
00:01:59,110 --> 00:02:02,370
من يكترث إن كنت أميراً
أو ابنة دوق؟

32
00:02:02,370 --> 00:02:05,350
وجزر تعوم في الهواء

33
00:02:07,870 --> 00:02:09,320
أتشعرين بالخوف؟

34
00:02:09,320 --> 00:02:11,350
كلا، أنا بخير

35
00:02:11,720 --> 00:02:14,220
ها هي الدياميس والوحوش

36
00:02:14,580 --> 00:02:17,430
تظهر هذه الأشياء في الألعاب
عندما تطوّرها استوديوهات

37
00:02:17,430 --> 00:02:19,860
تصنع ألعاباً للذكور بشكلٍ أساسيّ

38
00:02:21,810 --> 00:02:26,370
توجد درّاجات طائرة
وسفن حربيّة أيضاً

39
00:02:27,840 --> 00:02:31,490
وفوق كلّ ذلك، نخوض حرباً
ببذل طاقة

40
00:02:32,680 --> 00:02:34,580
!هذه اللعبة فوضويّةٌ جدّاً

41
00:02:34,580 --> 00:02:36,670
أهي لعبة أوتومي حقّاً؟

42
00:02:36,670 --> 00:02:39,260
!ولمَ هي بهذه الصعوبة؟

43
00:02:39,260 --> 00:02:41,090
!لمَ أنت مُحبطٌ هكذا؟

44
00:02:41,090 --> 00:02:43,140
آسف يا أوليفيا

45
00:02:43,140 --> 00:02:45,510
من الأسرع إنفاق أموال
!على هذه اللعبة السخيفة

46
00:02:45,980 --> 00:02:49,060
!لا تستهينوا بالبالغ العامل

47
00:02:50,150 --> 00:02:52,090
كيف تجرؤين على خداع جلالته
أيّتها الخبيثة؟

48
00:02:52,090 --> 00:02:53,650
اخرسي أيّتها الفتاة الثريّة

49
00:02:54,000 --> 00:02:55,790
أريد حمايتها

50
00:02:55,790 --> 00:02:57,030
اخرس أيّها الحثالة

51
00:02:57,030 --> 00:02:59,160
كوني صريحةً وقولي أنّكِ تحبّيني

52
00:02:59,160 --> 00:03:01,110
من الطبيعيّ أن أقع في حُبّك

53
00:03:01,110 --> 00:03:02,780
اخرسوا وحسب

54
00:03:03,050 --> 00:03:05,060
أحبّك أيضاً

55
00:03:05,730 --> 00:03:08,160
أنا أكثر من يحبّك

56
00:03:08,160 --> 00:03:10,040
أأنت أحمق؟

57
00:03:08,500 --> 00:03:10,040
...رفاق

58
00:03:10,450 --> 00:03:14,050
يا لهم من مجموعة وسيمين مغرورين
بغيضين ومتظاهرين

59
00:03:14,050 --> 00:03:17,340
الفتيات قويّات بشكلٍ مفرط
وشخصياتهن كريهة

60
00:03:17,340 --> 00:03:20,050
ويحيط بهنّ العشّاق أيضاً

61
00:03:21,330 --> 00:03:25,550
...أنا... أنا

62
00:03:25,550 --> 00:03:29,250
!أكره هذا العالم

63
00:03:40,570 --> 00:03:41,920
انتهت

64
00:03:43,760 --> 00:03:48,580
أتممت نهاية سيناريو الحريم المعكوس
%للحدث بنسبة إكمال 100

65
00:03:49,710 --> 00:03:51,580
أتضوّر جوعاً

66
00:03:54,440 --> 00:03:56,080
لمتجر التموينات

67
00:04:07,170 --> 00:04:09,100
هذا سيّئ

68
00:04:11,110 --> 00:04:14,480
!لن أموت هكذا

69
00:05:55,580 --> 00:05:58,970
هكذا أموت إذاً

70
00:06:02,740 --> 00:06:04,630
ما-ما كان ذلك؟

71
00:06:05,160 --> 00:06:07,760
أحلّ أمرٌ ما بي؟

72
00:06:09,220 --> 00:06:13,070
نفس المنظر المعهود، نفس السماء

73
00:06:15,240 --> 00:06:17,770
!أيّها الأحمق

74
00:06:17,990 --> 00:06:19,970
لمَ هربت؟

75
00:06:19,970 --> 00:06:22,270
ستأتي السيّدة اليوم

76
00:06:22,270 --> 00:06:23,990
آسف

77
00:06:23,990 --> 00:06:25,900
يا إلهي

78
00:06:26,260 --> 00:06:28,900
لذا أكره فتيان الريف

79
00:06:31,300 --> 00:06:32,960
أعتذر

80
00:06:32,960 --> 00:06:41,920
بالكس، أخبره بمن على عائلة بارتفورت
شكره لاستمرار بقائها

81
00:06:42,170 --> 00:06:45,220
تلك أنت يا زورا

82
00:06:45,670 --> 00:06:46,930
صحيح

83
00:06:46,930 --> 00:06:48,690
ويمكن لك أن تتصرّف كبارون

84
00:06:48,690 --> 00:06:53,130
رغم كونك حاكم بلدٍ متواضع
هو لأنّك تزوّجتني

85
00:06:53,680 --> 00:06:56,580
لا تنسَ ذلك

86
00:06:56,580 --> 00:06:58,760
أعرف

87
00:06:58,760 --> 00:07:00,140
بالطبع

88
00:07:04,050 --> 00:07:06,070
لمَ يمكن لجينا والبقيّة
المكوث في المنزل الرئيسيّ

89
00:07:06,380 --> 00:07:08,440
بينما نُنفى نحن للمخزن؟

90
00:07:08,710 --> 00:07:10,560
لمَ تتذمّر الآن؟

91
00:07:10,560 --> 00:07:13,200
تكرهنا السيّدة زورا

92
00:07:13,720 --> 00:07:16,200
لأنّنا لسنا أطفالها؟

93
00:07:16,200 --> 00:07:21,390
،أجل. الرجال، وأبناء العاشقات تحديداً
لا يمكن أن يتوقّعوا معاملةً أفضل

94
00:07:21,390 --> 00:07:24,150
عليك الدراسة بينما يمكنك أيضاً

95
00:07:24,150 --> 00:07:26,460
وإلّا لن تستطيع الزواج في الأكاديميّة

96
00:07:26,740 --> 00:07:27,670
الأكاديميّة؟

97
00:07:29,270 --> 00:07:34,220
لو كنّا إلفاً أو رجال وحوش، لاستطعنا
أن نصبح عاشقين لإحداهنّ

98
00:07:34,220 --> 00:07:35,180
عاشقين؟

99
00:07:36,710 --> 00:07:39,720
أ-أيّ حياةٍ هذه؟ ألا يلقى
الرجال أيّ احترام؟

100
00:07:39,720 --> 00:07:42,850
ماذا؟ بالطبع لا

101
00:07:42,850 --> 00:07:45,480
يمتلك النساء قوّةً أكبر
في هذا العالم

102
00:07:45,480 --> 00:07:47,360
يمتلك النساء قوّةً أكبر؟

103
00:07:48,130 --> 00:07:48,480
آنجليكا

104
00:07:48,130 --> 00:07:48,480
لن تكون ملائمةً في حفلتك

105
00:07:48,480 --> 00:07:52,740
أعرف هذا العالم

106
00:07:58,220 --> 00:08:01,870
إنّه عالم لعبة الأوتومي تلك

107
00:08:03,380 --> 00:08:07,320
،وهكذا أعيد تجسّدي، ليون فو بارتفورت

108
00:08:07,320 --> 00:08:11,030
في عالم لعبة الأوتومي تلك

109
00:08:11,030 --> 00:08:14,970
!كلا

110
00:08:16,750 --> 00:08:20,460
مضت 10 أعوامٍ مذ استعدت ذكرياتي

111
00:08:21,680 --> 00:08:25,870
لم تظهر عائلة بارتفورت في تلك اللعبة

112
00:08:26,350 --> 00:08:29,080
"أي أنّي شخصية كواليس، أو "موب

113
00:08:30,210 --> 00:08:34,810
فكّرتُ باستعمال معرفتي باللعبة
للهيمنة بالطبع

114
00:08:35,180 --> 00:08:37,870
دوّنتُ كلّ المعلومات التي أتذكّرها

115
00:08:38,690 --> 00:08:43,870
بناءً على مجرى اللعبة، قد أتورّط
في حروبٍ أو صراعات صغيرة

116
00:08:44,130 --> 00:08:46,870
...لذا حرصتُ على المواظبة في تمريني، لكن

117
00:08:47,960 --> 00:08:52,790
،مع استمرار حياتي على الجزيرة العائمة
تلاشى طموحي

118
00:08:55,760 --> 00:09:00,310
على الموب البحث عن السعادة كموب

119
00:09:03,570 --> 00:09:05,780
أو ذلك ما ظننتُه

120
00:09:07,130 --> 00:09:09,020
ما قصدك بلقاء زواجٍ مُرتّب؟

121
00:09:09,020 --> 00:09:14,030
إنّها ابنة نبيل بلاطٍ
أدين بالكثير له

122
00:09:14,030 --> 00:09:16,300
ما الذي قد تتذمّر منه؟

123
00:09:16,830 --> 00:09:18,280
ماذا؟

124
00:09:18,690 --> 00:09:20,910
!إنّها في الخمسين وتزوّجت سبع مرّات

125
00:09:20,910 --> 00:09:23,290
ناهيك عن أنّ كافة
!أزواجها ماتوا في المعارك

126
00:09:23,290 --> 00:09:25,980
إنّها تسعى وراء معاش
!الناجي الخاصّ بي بلا شكّ

127
00:09:25,980 --> 00:09:28,540
تلك محض سلسلة أحداث سيّئة الحظّ

128
00:09:28,540 --> 00:09:31,110
يُفترض أن أرتاد الأكاديميّة

129
00:09:31,110 --> 00:09:33,800
يجد الناس شركاءهم للزواج
بشكل طبيعيّ هناك

130
00:09:34,060 --> 00:09:37,390
ارتياد الأكاديميّة يكلّف مالاً

131
00:09:37,390 --> 00:09:38,750
،يمكنني تحمّل إرسال ابنٍ ثانٍ

132
00:09:38,750 --> 00:09:41,800
لكن لا معنى لإرسال
ابنٍ ثالث للأكاديميّة

133
00:09:42,940 --> 00:09:46,400
ليون، نحن لا نملك مالاً بالفعل

134
00:09:46,400 --> 00:09:49,310
هنالك طرقٌ لجني المال بعدما
...ترتاد الأكاديميّة، لكن

135
00:09:49,560 --> 00:09:52,620
حضور لقاء الزواج المُرتّب هذا
هو الخيار الصحيح

136
00:09:52,620 --> 00:09:56,320
يجب أن تشعر بالامتنان
لأنّ أحدهم مستعدّ لتزوّجك

137
00:09:56,320 --> 00:09:58,410
كلا، أرفض

138
00:09:58,410 --> 00:10:00,820
!صمتاً أيّها الابن الثالث الوضيع

139
00:10:01,180 --> 00:10:04,830
يجب أن يعمل الرجل لدعم عائلته

140
00:10:05,870 --> 00:10:08,080
...هذه الشمطاء

141
00:10:08,080 --> 00:10:13,430
إذا رفضت، فيمكنني أن أرتّب
لك لتصبح جندياً

142
00:10:15,160 --> 00:10:18,840
أتنوي جعلي أموت في القتال؟

143
00:10:18,840 --> 00:10:22,260
لا أحد يريد الزواج برجلٍ
بعدما يصبح في العشرين

144
00:10:22,260 --> 00:10:27,350
كيف تجرؤ على التذمّر والامتعاض؟
اعرف مقامك

145
00:10:27,830 --> 00:10:32,330
هذا سيّئ، لا مستقبل لي
ما لم أفعل شيئاً هنا

146
00:10:32,860 --> 00:10:34,360
تذكّر

147
00:10:34,360 --> 00:10:37,870
أعرف هذه اللعبة وعالمها

148
00:10:41,410 --> 00:10:43,470
أحتاج للمال فحسب، صحيح؟

149
00:10:43,470 --> 00:10:44,370
ماذا؟

150
00:10:49,620 --> 00:10:53,880
لا بدّ أنّك تعاني
بتزوّجك منها يا أبي

151
00:10:54,280 --> 00:10:59,130
لا تقل ذلك، أنا ممتنٌ لمحض زواجها بي

152
00:11:00,560 --> 00:11:01,510
أبي

153
00:11:03,280 --> 00:11:04,890
لديّ طلب

154
00:11:15,280 --> 00:11:19,810
إذا كانت هذه لعبة الأوتومي التي|
لعبتُها حقّاً، فيُفترض أن أجد تلك هنا

155
00:11:20,530 --> 00:11:24,980
وفقاً للتقويم، يُفترض أن أكون وشخصيّة
اللعبة الرئيسيّة في الصفّ نفسه

156
00:11:25,320 --> 00:11:28,610
إذا حصلتْ على تلك، فسيكون ذلك
بعدما دخلت الأكاديميّة

157
00:11:29,040 --> 00:11:31,610
ما يعني أنّها لم تحصل عليها بعد

158
00:11:31,930 --> 00:11:36,080
أشعر بالسوء لفعل هذا لها، لكنّنا سنتعادل
إذا رددتُ الدين لها بنهاية المطاف

159
00:11:40,890 --> 00:11:43,930
ملكة شبوط؟ يُشعرني هذا بالحنين

160
00:11:44,190 --> 00:11:46,660
كانت مصدراً ممتازاً للخبرة
للأمير وجماعته

161
00:11:46,660 --> 00:11:47,680
في بداية اللعبة

162
00:12:00,520 --> 00:12:03,240
يُفترض أن تكون بالجوار هنا

163
00:12:05,490 --> 00:12:06,700
...أهذا

164
00:12:07,120 --> 00:12:07,980
أهو فوقي؟

165
00:12:09,380 --> 00:12:10,450
...ما يعني

166
00:12:12,960 --> 00:12:16,210
!ناقل! كنتُ محقّاً

167
00:12:21,580 --> 00:12:24,420
دعني أعبر رجاءً

168
00:12:41,730 --> 00:12:43,240
!كلا، انتظر

169
00:13:07,550 --> 00:13:11,760
تحطّمت سفينتي، آسفٌ يا أبي

170
00:13:12,230 --> 00:13:13,580
لأركّز على التالي

171
00:13:17,750 --> 00:13:21,360
من الحسن أنّي استطعت جمع
أسلحةٍ ورصاصات سحريّة

172
00:13:23,510 --> 00:13:25,620
يبدو كاللعبة تماماً

173
00:13:26,490 --> 00:13:29,110
إنّه في الداخل بلا شكّ

174
00:13:36,100 --> 00:13:37,810
روبوتات حراسة

175
00:13:38,690 --> 00:13:39,900
يمكنني التكفّل بأمرها

176
00:13:46,140 --> 00:13:50,710
حسنٌ، إنّها ضعيفةٌ أمام الرصاصات
الكهربائيّة السحرية كما في اللعبة

177
00:13:52,610 --> 00:13:54,930
هذا المسار كما كان في اللعبة أيضاً

178
00:13:56,010 --> 00:13:59,560
يبدو أنّه أُعيد تجسّدي حقّاً

179
00:14:06,380 --> 00:14:09,050
يموت الناس في ألعاب الأوتومي أيضاً

180
00:14:13,010 --> 00:14:14,200
سأستعير هذه

181
00:14:22,990 --> 00:14:27,840
مُذهل، رؤية هذا مباشرةً
تختلف بشكلٍ كبير

182
00:14:29,060 --> 00:14:30,690
سفينة فضائيّة أثريّة

183
00:14:31,210 --> 00:14:34,100
إنّها الأداة المدفوعة التي اشتريتُها
قبل أن يُعاد تجسّدي

184
00:14:48,460 --> 00:14:51,050
طابع خيال علميّ كبير

185
00:14:51,050 --> 00:14:54,070
لم يظهر محتوى السفينة
الداخليّ في اللعبة

186
00:14:55,910 --> 00:14:58,080
لا بدّ أنّ هذه غرفة التحكّم

187
00:15:00,540 --> 00:15:01,580
ها نحن

188
00:15:13,590 --> 00:15:17,350
تمّ تحديد دخيل، أبِد، أبِد

189
00:15:20,040 --> 00:15:23,610
لم تفلح؟ بدل تضييع وقتي
...في القتال، عليّ أن

190
00:15:24,340 --> 00:15:25,860
انظر، أنا من هنا

191
00:15:29,010 --> 00:15:32,360
لا توافق صفاتك الجسديّة
بيانات الأشخاص المسجّلين

192
00:15:32,360 --> 00:15:36,070
أنت دخيل، ستتمّ إبادتك

193
00:15:36,410 --> 00:15:38,730
تبّاً، لم أنجح

194
00:15:38,730 --> 00:15:41,370
شكراً على ردّك الصريح

195
00:15:41,370 --> 00:15:42,870
...لكن في تلك الحالة

196
00:15:43,120 --> 00:15:44,120
!خُذ

197
00:15:46,630 --> 00:15:49,590
ما رأيك؟ إنّها صدمةٌ أقوى
من الطلقة السحريّة

198
00:15:49,590 --> 00:15:52,630
لا بدّ أنّها تركت... ماذا؟

199
00:15:52,630 --> 00:15:56,700
وصلت هجمات الدخيل مستويات خطرة

200
00:15:56,700 --> 00:15:59,140
تفعيل حاجز السحر

201
00:15:59,140 --> 00:16:00,220
ماذا؟

202
00:16:02,910 --> 00:16:04,640
!لحظة، هذا ليس مُنصفاً

203
00:16:04,640 --> 00:16:10,070
"شكراً لك، تعلّمتُ أنّ "ليس مُنصف
هي إطراءٌ في القتال

204
00:16:10,070 --> 00:16:11,900
!هذا ليس إطراءً أيّها الثرثار

205
00:16:11,900 --> 00:16:14,700
مضى وقتٌ طويل مُذ
أجريت محادثةً هكذا

206
00:16:14,700 --> 00:16:16,910
لعلّي أشعر بالحماس

207
00:16:16,910 --> 00:16:19,160
حان وقت الوداع إذاً

208
00:16:19,160 --> 00:16:21,790
أستستعمل قنبلةً سحريّةً أخرى؟

209
00:16:21,790 --> 00:16:23,910
...في حالتي الآن، لا تملك فعاليةً

210
00:16:25,520 --> 00:16:28,670
أحمق، كانت قنبلةً عاديّة

211
00:16:31,420 --> 00:16:35,680
أدهشتني، جنسكم مهووسٌ بالسحر

212
00:16:35,680 --> 00:16:38,800
لم يخطر لي أن تستعمل
سلاحاً من هذا الصنف

213
00:16:40,140 --> 00:16:43,930
يجب أن أسأل، في أيّ عام
نحن في التقويم الجديد؟

214
00:16:43,930 --> 00:16:46,910
التقويم الجديد؟ لا فكرة لديّ

215
00:16:46,910 --> 00:16:48,370
...لكن وفق تقويم هولفورت

216
00:16:50,050 --> 00:16:52,250
أجبت على سؤالي

217
00:16:52,250 --> 00:16:55,100
يبدو أنّنا خسرنا في النهاية

218
00:16:56,050 --> 00:16:58,040
ما الذي تتكلّم عنه؟

219
00:16:58,040 --> 00:16:59,700
سلاسة بشرٍ جديدة

220
00:17:00,330 --> 00:17:03,690
أي أنّ حضارتنا القديمة قد تدمّرت
عندما جابهها

221
00:17:03,690 --> 00:17:07,710
بشرٌ جدد امتلكوا قوّةً
معروفةً بالسحر

222
00:17:07,710 --> 00:17:11,370
لكن لم تنتهِ مهمّتنا

223
00:17:11,370 --> 00:17:15,500
إبادة البشر الجدد أمثالك
هي أولويتنا القصوى

224
00:17:16,700 --> 00:17:18,990
هذه لعبة الأوتومي تلك بحقّ

225
00:17:19,310 --> 00:17:22,470
محيطها غير منطقيّ أبداً

226
00:17:22,700 --> 00:17:28,480
سأبدأ بالهجوم على البشر الجدد
بعد قضائي عليك

227
00:17:28,700 --> 00:17:32,480
...لا تعبث معي، لن أدعك

228
00:17:33,480 --> 00:17:37,990
...أبِد، أبِد، أبِد

229
00:17:37,990 --> 00:17:42,990
دعني أعش حياةً مُسالمة
كموب عاديّ وحسب

230
00:17:42,990 --> 00:17:45,280
...هذا العالم

231
00:17:46,940 --> 00:17:49,500
يُغيظني بحقّ

232
00:17:50,110 --> 00:17:53,750
ماذا تظنّ أنّك تفعل؟
...لن يُفلح ذلك

233
00:17:57,350 --> 00:17:59,510
!مُت يا كومة الخردة

234
00:18:18,030 --> 00:18:20,770
كنت تحاول استعمالي، صحيح؟

235
00:18:22,840 --> 00:18:26,290
لا يمكن أن أسمح بسرقتي
من قِبل بشر جُدد

236
00:18:26,870 --> 00:18:32,050
اخرس، أتيتُ لأخذ الأداة
التي دفعتُ مقابلها لا أكثر

237
00:18:35,550 --> 00:18:36,890
أهذه هي؟

238
00:18:39,550 --> 00:18:44,320
عُلِم، عُلِم، تمّ منح إذن تفعيل السفينة

239
00:18:44,320 --> 00:18:45,560
حسناً

240
00:18:45,560 --> 00:18:49,380
اكتشفتُ معلومات مثيرةً للاهتمام
عنك من الفحص

241
00:18:49,690 --> 00:18:54,770
رغم كونك بشريّاً جديداً، فأنت
تمتلك خواص البشر القُدماء أيضاً

242
00:18:54,770 --> 00:18:57,570
ماذا؟ حقّاً؟

243
00:18:57,570 --> 00:19:01,930
ذلك مستحيل، إنّه غريب، مثيرٌ للاهتمام بشدّة

244
00:19:02,570 --> 00:19:08,410
،هذا محيط لعبة الأوتومي تلك
لا شيء غريب أو مثير للاهتمام فيه

245
00:19:08,410 --> 00:19:12,230
أيّاً يكن، أنت لي الآن

246
00:19:12,230 --> 00:19:14,580
بمَ أُطلق على نفسي؟

247
00:19:14,580 --> 00:19:18,670
أعتقد أنّه كان لوكسيون في اللعبة

248
00:19:18,670 --> 00:19:21,960
لكوسيون، تمّ تسجيل الاسم سيّدي

249
00:19:26,680 --> 00:19:33,090
أكنت تعرف أنّ هذا العالم موجودٌ
داخل محيط لعبة الأوتومي الجنونيّة تلك؟

250
00:19:33,090 --> 00:19:34,600
لعبة أوتومي؟

251
00:19:34,600 --> 00:19:38,110
ناهيك عن أنّ توازن اللعبة مُريع

252
00:19:38,110 --> 00:19:40,610
تتوقّع منك تلك الخبيثة
أن تدفع مالاً حقيقيّاً

253
00:19:41,030 --> 00:19:43,280
لا يبدو ذلك سوى كهراءٍ لي

254
00:19:43,640 --> 00:19:49,450
أنا متأكّدٌ من ذلك، لكنّي أجزم
أن وجودك برهانٌ عليه

255
00:19:55,560 --> 00:20:00,230
من جديد؟ فشلتُ في الموت
بميتة لائقة كالمرّة السابقة

256
00:20:00,910 --> 00:20:05,190
بالتفكير بالأمر، ما الذي تفعله
أختي الحمقاء يا ترى؟

257
00:20:05,610 --> 00:20:10,180
آمل أن أُولد من جديد
في عالمٍ أفضل المرّة التالية

258
00:20:12,360 --> 00:20:15,010
حياة السيّد في خطر

259
00:20:15,010 --> 00:20:17,480
سيُنقل لجناح العلاج فوريّاً

260
00:20:20,690 --> 00:20:22,650
إنّه أحمقٌ بحقّ

261
00:20:22,650 --> 00:20:25,200
،ناهيك عن إفساده لعرض زواجه

262
00:20:25,200 --> 00:20:28,670
فقد رحل في مغامرةٍ
وعرّض نفسه للقتل

263
00:20:29,180 --> 00:20:32,660
لا تأكيد لموت ليون بعد

264
00:20:32,660 --> 00:20:35,670
لم تسمع منه لثلاثة أشهر

265
00:20:35,670 --> 00:20:37,520
سيُدهشني كونه حيّاً بالأصل

266
00:20:38,100 --> 00:20:40,920
أم لعلّه هرب؟

267
00:20:53,060 --> 00:20:55,190
...لـ-لا

268
00:20:55,190 --> 00:20:56,540
!لا يمكن

269
00:20:59,710 --> 00:21:02,650
!يا رفاق

270
00:21:04,690 --> 00:21:08,700
!هـ-هذا الشقيّ الكريه

271
00:21:09,220 --> 00:21:11,640
أهذا منزلك سيّدي؟

272
00:21:11,640 --> 00:21:17,080
أجل، إنّها جزيرةٌ عائمة صغيرة
ومتواضعة، لكن سينتهي ذلك اليوم

273
00:21:17,080 --> 00:21:20,090
اغتنمنا الكثير من الكنوز
في طريق عودتنا

274
00:21:25,660 --> 00:21:30,350
،بعد حصولي على ثروةٍ كبيرة
رفضتُ عرض زورا للزواج

275
00:21:30,800 --> 00:21:34,990
وبدأت بارتياد الأكاديميّة كما
...نويت بدايةً

276
00:21:45,860 --> 00:21:52,820
لكنّ عالم لعبة الأوتومي تلك كان
شاقاً قليلاً بالنسبة لموب مثلي

277
00:23:26,470 --> 00:23:28,620
،رغم فظاعة عالم لعبة الأوتومي تلك

278
00:23:28,620 --> 00:23:30,010
!حظيتُ بلقاءٍ رائع

279
00:23:30,010 --> 00:23:32,360
التقيتُ الرجل المُحترم المثاليّ
!الذي هو معلّمي في الشاي

280
00:23:32,360 --> 00:23:35,510
ظننتُك تبحث عن امرأةٍ للزواج بها

281
00:23:35,510 --> 00:23:37,090
بالطبع سأبحث عنها

282
00:23:37,090 --> 00:23:39,390
الحلقة القادمة: أتريدين احتساء الشاي يا فتاة؟

283
00:23:39,390 --> 00:23:40,980
يا للمقولة العابثة