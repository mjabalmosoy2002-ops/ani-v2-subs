1
00:00:11,290 --> 00:00:13,610
حرّك تلك الطاولة لليسار قليلاً

2
00:00:13,610 --> 00:00:17,620
دانيل، توخّ الحذر مع مجموعة
الشاي تلك، فهي باهظة

3
00:00:17,620 --> 00:00:20,370
عليك ألّا تستعمل أشياء باهظة
كهذه لمهرجان مدرسيّ

4
00:00:20,690 --> 00:00:23,660
أشعر أنّ عليّ ردّ بعض ما جنيتُه

5
00:00:23,660 --> 00:00:26,010
من أولئك التلامذة الأغبياء

6
00:00:26,010 --> 00:00:29,600
يجب أن تكون واعياً أكثر
بمقدار كره الجميع لك

7
00:00:29,600 --> 00:00:31,630
الـ-المعذرة

8
00:00:34,590 --> 00:00:36,890
لا يبدو مظهري غريباً، صحيح؟

9
00:00:37,230 --> 00:00:40,510
لستُ معتادةً على ارتداء أزياء كهذه

10
00:00:40,510 --> 00:00:43,390
كلا، مظهركِ مثاليّ

11
00:00:45,790 --> 00:00:48,060
هذا يبرز صدري كثيراً

12
00:00:49,890 --> 00:00:53,330
تبدين مرتاحةً في هذا الزيّ يا آنجي
رغم أنّكِ ابنة دوق

13
00:00:53,330 --> 00:00:57,450
أمضيتُ عامين في القصر الملكيّ
وأنا أتتلمذ في تعلّم الآداب

14
00:00:58,710 --> 00:01:03,540
تبدين رائعةً يا ليفيا، براءتكِ تجعله باهراً بحقّ

15
00:01:03,860 --> 00:01:06,380
يروقني في الواقع أيضاً

16
00:01:08,340 --> 00:01:10,690
يا للمنظر الجميل

17
00:01:11,050 --> 00:01:13,730
،لكن وفقاً لإعدادات لعبة الأوتومي هذه

18
00:01:13,730 --> 00:01:16,210
فلا يمكنني إقامة علاقات عاطفيّة معهما

19
00:01:16,780 --> 00:01:19,130
فأنا موب

20
00:02:50,850 --> 00:02:53,280
شعركِ جميلٌ يا ليفيا

21
00:02:54,220 --> 00:02:58,780
أتمنى لو كان لديّ جسدٌ
جذّاب مثلكِ يا آنجي

22
00:02:58,780 --> 00:03:01,750
أهما فتاتان في الأكاديميّة حقّاً؟

23
00:03:01,750 --> 00:03:03,910
كأنّي أحلم

24
00:03:04,200 --> 00:03:04,910
ليون

25
00:03:05,620 --> 00:03:07,660
اسمع لهذا

26
00:03:07,920 --> 00:03:11,280
ما الذي تريدينه؟ أنتِ عقبة، فهلّا رحلتِ؟

27
00:03:11,280 --> 00:03:14,540
لا يصحّ أن تخاطب شقيقتك هذا

28
00:03:14,540 --> 00:03:19,240
إنّها محقّة، عليك التعاطف معي أكثر
وتقديم الشاي لي

29
00:03:19,240 --> 00:03:23,120
أجل، هكذا الفتيات في الأكاديميّة على طبيعتهنّ

30
00:03:23,120 --> 00:03:24,390
انتهى الحلم

31
00:03:25,710 --> 00:03:28,560
ما الأمر؟ فلتذكري ما لديك سريعاً

32
00:03:28,850 --> 00:03:31,810
تشاجرتُ مع صديقة

33
00:03:32,100 --> 00:03:34,710
لا بدّ أنّه كان حول الفتيان وما شابه

34
00:03:35,050 --> 00:03:37,690
أجل، إنّه وريث فيسكونت

35
00:03:37,690 --> 00:03:42,020
إنّه شابٌ واعد وسيصبح ثريّاً جدّاً

36
00:03:42,020 --> 00:03:44,320
وسلبته صديقتكِ منك؟

37
00:03:45,170 --> 00:03:46,450
بل النقيض

38
00:03:46,450 --> 00:03:47,580
ماذا؟

39
00:03:47,580 --> 00:03:53,190
،وضعت صديقتي ناظريها عليه أوّلاً
لكن خطر لي أن أجرّب السعي وراءه أيضاً

40
00:03:54,340 --> 00:03:56,340
أنتِ مخطئةٌ إذاً، انتهينا

41
00:03:56,340 --> 00:03:58,710
أريدك أن تتدخّل وتسويّ الأمر

42
00:03:59,000 --> 00:04:00,820
يمكنك إصلاح المشكلة فوراً
إن هدّدتها قليلاً

43
00:04:00,820 --> 00:04:02,720
لا-لا يصحّ أن يفعل هذا

44
00:04:02,720 --> 00:04:04,720
اصمتي يا طالبة المنحة

45
00:04:05,580 --> 00:04:08,350
لن أفعل شيئاً لك

46
00:04:08,350 --> 00:04:10,100
ولا تضايقي أوليفيا

47
00:04:10,470 --> 00:04:13,150
لن تبقى آنجي صامتةً
ما إن حصل شيء

48
00:04:13,850 --> 00:04:17,860
إنّه محقّ، لن أرأف بكِ
ولو كنتِ شقيقة ليون

49
00:04:17,860 --> 00:04:20,610
حـ-حسناً

50
00:04:20,610 --> 00:04:23,020
أحمقٌ لا نفع منه

51
00:04:25,070 --> 00:04:26,180
ليون-سان

52
00:04:26,970 --> 00:04:30,370
شكراً لك على قلقك عليّ

53
00:04:31,450 --> 00:04:33,740
...إنّها لامعةٌ كالعادة، لكن

54
00:04:34,560 --> 00:04:36,260
هـ-هنالك مشكلةٌ يا ليون

55
00:04:36,260 --> 00:04:37,970
...غرفة الشاي المجاورة

56
00:04:41,410 --> 00:04:44,030
آمل قدومكنّ، مُرحّب بكنّ جميعاً

57
00:04:44,030 --> 00:04:44,490
أجل

58
00:04:44,490 --> 00:04:45,670
سآتي بالتأكيد

59
00:04:45,670 --> 00:04:46,460
وأنا

60
00:04:46,460 --> 00:04:48,150
سأنفق مالاً كثيراً

61
00:04:48,150 --> 00:04:48,760
ماذا؟

62
00:04:49,050 --> 00:04:51,750
نأمل أن تزرن مقهى الأميرة

63
00:04:51,750 --> 00:04:54,200
!ماذا؟

64
00:04:54,200 --> 00:04:56,750
لا أصدّق أنّه يفتح مقهى بجوارنا

65
00:04:56,750 --> 00:04:58,520
يا للحقد الكامن

66
00:05:00,990 --> 00:05:04,970
بارتفورت، سمعت أنّك تدير مقهى أيضاً

67
00:05:04,970 --> 00:05:07,410
إذا كنت مهتمّاً، فلتزرنا

68
00:05:07,740 --> 00:05:09,660
نحن نرحّب بك

69
00:05:09,660 --> 00:05:11,910
مزعجٌ جدّاً

70
00:05:14,630 --> 00:05:17,170
مئة ديا لشاي وحلويّات؟

71
00:05:17,170 --> 00:05:19,590
ماذا؟ أذلك رخيصٌ جدّاً؟

72
00:05:19,930 --> 00:05:22,300
قالت ماري أنّ هذا السعر المناسب

73
00:05:22,570 --> 00:05:27,570
لا أملك شجاعة دخول
محلّ باهظ كهذا

74
00:05:27,570 --> 00:05:32,310
أجل، هذا طبيعيّ. فلتتجاهلي مقهاهم وحسب

75
00:05:32,310 --> 00:05:36,710
تبدو مُتحليّاً بالثقة، لكنّنا لن نخسر هذه المرّة

76
00:05:43,450 --> 00:05:45,660
أنتم، لمَ تتبعوني؟

77
00:05:45,660 --> 00:05:48,070
لأنّي صادقٌ مع نفسي

78
00:05:48,070 --> 00:05:50,200
شعرتُ بالفضول، لذا خطر لي تفقّده

79
00:05:50,450 --> 00:05:52,210
هيّا، فلترنا ما لديكم

80
00:05:58,100 --> 00:05:59,960
!هذا بمثابة نادي مضيفين

81
00:06:00,220 --> 00:06:03,790
بارتفورت؟ يا لدناءتك بقدومك
لاستكشاف المكان

82
00:06:03,790 --> 00:06:05,410
هذا ليس عادلاً

83
00:06:05,410 --> 00:06:09,170
رؤية الاستياء في ملامحك
تجعل الأمر جديراً

84
00:06:09,170 --> 00:06:12,350
أصبنا باتّباع اقتراح ماري

85
00:06:12,580 --> 00:06:14,350
هي مُجدّداً؟

86
00:06:14,350 --> 00:06:16,890
سنفوز نحن هذه المرّة

87
00:06:16,890 --> 00:06:19,120
جديرٌ بك ألّا تهرب لأنّك
تعتقد أنّك ستخسر وحسب

88
00:06:19,120 --> 00:06:21,600
ما الذي نتنافس لأجله أصلاً؟
هذا مهرجانٌ مدرسيّ

89
00:06:21,930 --> 00:06:24,600
أهذا مقهى حقّاً؟

90
00:06:24,600 --> 00:06:28,670
جوّه أشبه بالحانة، وثمن احتساء الشاي 100 ديا

91
00:06:28,670 --> 00:06:30,240
بالطبع

92
00:06:30,470 --> 00:06:34,120
فيوليوس وبقيّة الفتيان وريثون
سابقون لعائلات مرموقة

93
00:06:34,420 --> 00:06:37,500
هم من يخدمون زبائننا

94
00:06:37,830 --> 00:06:40,430
أنتِ تسعين للشرّ دوماً، أليس كذلك؟

95
00:06:40,430 --> 00:06:42,880
ستعترض طريقي من جديد؟

96
00:06:44,880 --> 00:06:48,900
أأنتِ الأميرة المُشار لها
في اسم المقهى؟

97
00:06:48,900 --> 00:06:50,330
أميرة إذاً؟

98
00:06:50,330 --> 00:06:53,140
أ-أنا أميرةٌ في قلبي

99
00:06:53,140 --> 00:06:56,830
ماري، ستكونين أميرتنا دوماً

100
00:06:56,830 --> 00:06:58,350
شكراً لك

101
00:06:58,350 --> 00:07:03,150
في المقابل، أنت بغاية الفظاظة بالنسبة
لشخصيّة موب في الخلفيّة

102
00:07:03,390 --> 00:07:06,030
أتحرّق شوقاً ليوم المهرجان

103
00:07:06,030 --> 00:07:08,400
لا بدّ أنّ مقهاكم سيكون خاوياً

104
00:07:08,660 --> 00:07:11,400
سنقدّم لكم معروفاً ونستعمله كغرفة استراحتنا

105
00:07:12,320 --> 00:07:15,910
وبما أنّنا سندفع، حريٌّ بكم تقديم شاي لائق

106
00:07:16,140 --> 00:07:19,140
لا داعي لتخبريني، لا أتهاون عندما
يتعلّق الأمر بالشاي

107
00:07:19,140 --> 00:07:21,270
لا يمكنني فعل ذلك لمعلّمي

108
00:07:21,910 --> 00:07:22,760
مرحباً

109
00:07:22,760 --> 00:07:23,980
نحن نعرض مسرحيّة

110
00:07:23,980 --> 00:07:25,620
ما رأيك ببيت مسكون؟

111
00:07:27,310 --> 00:07:30,170
حسنٌ، عليّ أداء دوري أيضاً

112
00:07:30,170 --> 00:07:31,030
أين نذهب تالياً؟

113
00:07:31,030 --> 00:07:31,930
ماذا نفعل؟

114
00:07:31,670 --> 00:07:33,930
...المعذرة

115
00:07:31,930 --> 00:07:33,070
أين نذهب؟

116
00:07:34,210 --> 00:07:36,160
ما الذي تريدينه يا طالبة المنحة؟

117
00:07:36,160 --> 00:07:38,930
أنا أروّج لمقهى

118
00:07:38,930 --> 00:07:42,060
أتقصدين مقهى بارتفورت؟

119
00:07:42,060 --> 00:07:43,310
أ-أجل

120
00:07:43,310 --> 00:07:44,810
يستحيل أن نذهب هناك

121
00:07:45,810 --> 00:07:49,720
إعجابه بكِ جعلكِ تشعرين بغرور، أليس كذلك؟

122
00:07:49,720 --> 00:07:50,570
ماذا؟

123
00:07:50,570 --> 00:07:53,820
لا تسيئي الفهم أيّتها العاميّة

124
00:07:54,060 --> 00:07:55,820
...لـ-لكنّي

125
00:07:56,070 --> 00:07:59,700
لا تفعلي، ابنة الدوق معجبةٌ بها

126
00:07:59,970 --> 00:08:04,460
إثارة غضب عائلة ريدغريف
قد يهدّد عائلتك بأسرها

127
00:08:09,430 --> 00:08:11,210
تديرون مقهى؟

128
00:08:11,440 --> 00:08:13,090
أ-أجل

129
00:08:13,330 --> 00:08:15,340
جميل، يبدو ذلك مُسليّاً

130
00:08:15,890 --> 00:08:19,600
أنا كارلا، كارلا فو وين

131
00:08:24,540 --> 00:08:26,600
مهرجان مدرسيّ إذاً؟

132
00:08:27,090 --> 00:08:31,180
أتحرّق لرؤيتك أيّها البارون بارتفورت

133
00:08:33,440 --> 00:08:34,360
حسنٌ

134
00:08:34,740 --> 00:08:38,240
اليوم هو اليوم الأوّل، فلتظهرا روحاً يا فتيان

135
00:08:38,240 --> 00:08:39,620
أجل

136
00:08:39,620 --> 00:08:44,880
ويا آنسات، لا تنسيا أخذ استراحةٍ والاستمتاع بالمهرجان

137
00:08:44,880 --> 00:08:46,250
!أنت ألطف بكثيرٍ معهما

138
00:08:46,470 --> 00:08:49,160
بدأتُ أشعر بالتوتّر

139
00:08:49,160 --> 00:08:52,140
هذه أوّل مرّةٍ أعمل في مقهى أيضاً

140
00:08:52,140 --> 00:08:53,380
كنتُ أنتظر هذا اليوم بشوف

141
00:08:53,660 --> 00:08:57,120
آنجليكا-سان، تودّ اللجنة التنفيذيّة الحديث معك

142
00:08:57,120 --> 00:08:59,270
فلتتوجّهي لمقرّ اللجنة
فوراً من فضلكِ

143
00:09:06,270 --> 00:09:09,900
جلالتك، لا يمكنني الإقرار على طلبٍ
غير معقول كهذا

144
00:09:11,230 --> 00:09:16,530
آسفة، لكن أودّ منكِ تحمّل
أنانيّتي لليوم فحسب

145
00:09:17,120 --> 00:09:19,970
فقد مررتُ بالكثير من المتاعب لأجلكِ

146
00:09:19,970 --> 00:09:21,660
آسفة

147
00:09:21,910 --> 00:09:25,410
كما أنّ هذا مهرجاني المدرسيّ الأوّل

148
00:09:25,810 --> 00:09:28,790
مضى وقتٌ طويل مذ رأيتكِ
في زيّ خادمة

149
00:09:29,050 --> 00:09:32,150
أ-أقدّر كلّ ما قدّمتِه لي آنذاك

150
00:09:34,340 --> 00:09:39,830
ميلين-ساما هي ملكة مملكة هولفورت وأمّ الأمير

151
00:09:40,690 --> 00:09:43,810
أدين لها للأبد

152
00:09:44,340 --> 00:09:48,440
لكنّي أشعر بالاطمئنان لرؤيتكِ في تحسّن

153
00:09:48,440 --> 00:09:51,940
أجل، أنا أستمتع بوقتي في الأكاديميّة

154
00:09:53,920 --> 00:09:56,190
أهذا بسبب ليون-كن؟

155
00:09:59,600 --> 00:10:03,490
ذ-ذلك جانباً، أتنوين لقاء ليون حقّاً؟

156
00:10:03,490 --> 00:10:05,020
بالطبع

157
00:10:05,020 --> 00:10:08,780
،حرمان يوليوس من الميراث كانت غلطته

158
00:10:08,780 --> 00:10:11,580
لكنّي أودّ الكلام معه بصفتي أمّه

159
00:10:11,890 --> 00:10:15,210
لكنّي مسؤولةٌ عمَّ حصل أيضاً

160
00:10:15,210 --> 00:10:18,840
كلا، ما لا يسرّني هو ما حصل أثناء النزال

161
00:10:18,840 --> 00:10:22,410
دعيني أعتذر عن أفعال ابني بصفتي أمّه

162
00:10:22,900 --> 00:10:24,660
أنا آسفةٌ يا آنجي

163
00:10:24,660 --> 00:10:25,970
لا داعي لتعتذري

164
00:10:25,970 --> 00:10:29,850
لكنّي لا أصدّق أنّ يوليوس خُدع بسهولة

165
00:10:30,460 --> 00:10:34,130
الأكاديميّة أسوأ مما تصوّرت

166
00:10:34,130 --> 00:10:36,390
ماذا؟ تتقاضون مالاً مقابل هذا؟

167
00:10:36,390 --> 00:10:37,890
يُفترض أن يكون بالمجّان

168
00:10:37,890 --> 00:10:39,610
...رجاءً

169
00:10:41,440 --> 00:10:42,960
يا للمكان الفظيع

170
00:10:44,270 --> 00:10:45,290
أنا متشوّقة

171
00:10:45,290 --> 00:10:46,120
أتحرّق شوقاً

172
00:10:46,120 --> 00:10:48,020
سأحتسي خمسة أكواب شاي

173
00:10:48,020 --> 00:10:49,620
سأطلب براد-ساما

174
00:10:49,910 --> 00:10:52,070
ليون-سان، يوجد طابور

175
00:10:52,070 --> 00:10:54,250
يا لوقاحتهم

176
00:10:57,690 --> 00:11:00,530
أنا هنا بصفتي زبونة، فلتأخذوني لمقعدي

177
00:11:03,050 --> 00:11:05,760
وقت تسبيب متاعب لليون-كن

178
00:11:06,070 --> 00:11:07,840
أتوقّع منكِ أن تساعديني يا آنجي

179
00:11:07,840 --> 00:11:10,620
لكنّي أعمل هنا

180
00:11:10,620 --> 00:11:12,500
لا تبالي

181
00:11:12,500 --> 00:11:15,240
كلّ ما سأفعله هو التذمّر
عن برودة الشاي وما شابه

182
00:11:15,240 --> 00:11:17,290
سأجعله يعيد صنعه ثلاث مرّات على الأقل

183
00:11:17,290 --> 00:11:18,890
الشاي بارد

184
00:11:19,650 --> 00:11:21,400
فلتعدّ كوباً جديداً

185
00:11:25,430 --> 00:11:26,650
ليون-سان

186
00:11:27,910 --> 00:11:31,660
أعتذر، سأعدّ لكِ كوباً جديداً على الفور

187
00:11:34,500 --> 00:11:38,670
لا داعي في الواقع، أشكّ أنّ أوراق شايكم
ذات جودةٍ بالأصل

188
00:11:39,140 --> 00:11:43,720
ليس عليّ الدفع مقابل شاي سيّئ كهذا، صحيح؟

189
00:11:43,720 --> 00:11:46,370
ألا يُفترض أن تدفعوا لي بالأحرى؟

190
00:11:47,040 --> 00:11:48,930
أتوقّع منكِ أن تدفعي مُقابل الشاي

191
00:11:48,930 --> 00:11:50,020
ماذا؟

192
00:11:50,020 --> 00:11:54,190
كم من المال سلبته من الجميع
بالمراهنة على نزالك برأيك؟

193
00:11:54,190 --> 00:11:56,310
!كان على بعض الفتيات بيع عبيدهنّ

194
00:11:56,850 --> 00:11:59,820
ما-ما الذي يجري؟

195
00:12:01,070 --> 00:12:04,200
فلتقل شيئاً أيّها الحثالة

196
00:12:07,440 --> 00:12:08,700
...آنجي

197
00:12:11,270 --> 00:12:13,830
يا للسلوك الفظيع

198
00:12:14,300 --> 00:12:16,010
أريد منكِ المغادرة

199
00:12:17,520 --> 00:12:21,500
عجباً، أليست آنجليكا التي تركها الأمير؟

200
00:12:21,500 --> 00:12:22,870
لمَ ترتدين هكذا؟

201
00:12:22,870 --> 00:12:25,720
ألا تشعرين بالإحراج كابنة نبيل؟

202
00:12:26,240 --> 00:12:29,020
إنّها ابنة الكونت أوفري

203
00:12:29,540 --> 00:12:31,470
عائلة مُنافسة لنا

204
00:12:31,470 --> 00:12:34,090
أظننتِ أنّي سأخاف منك؟

205
00:12:34,090 --> 00:12:35,980
من ستخاف من نبيلة متدهورة مثلك؟

206
00:12:35,980 --> 00:12:37,230
فلتتوقّفي رجاءً

207
00:12:37,870 --> 00:12:38,800
...ليفيا

208
00:12:38,800 --> 00:12:41,730
كيف يمكنكِ معاملة ليون-سان
وآنجي بهذه القسوة؟

209
00:12:41,990 --> 00:12:43,740
فلترحلي من فضلك

210
00:12:43,740 --> 00:12:47,740
ماذا؟ لا تتمادي أيّتها العاميّة

211
00:12:49,290 --> 00:12:52,250
تظنّين بإمكانكِ الوقوف
على نفس المستوى معنا؟

212
00:12:52,250 --> 00:12:55,750
فقط لأنّكِ حيوانة آنجليكا الأليفة؟

213
00:12:56,620 --> 00:12:57,830
حيوانة أليفة؟

214
00:12:58,540 --> 00:13:01,500
يكفي يا هذه، ستدفعين الثمن حقّاً

215
00:13:02,540 --> 00:13:05,260
أتتعاطفين مع العوام الآن
لأنّكِ فقدتِ أصدقاءً؟

216
00:13:06,130 --> 00:13:11,140
ألا تذكرين قولكِ أنّ العوام محض أرقام؟

217
00:13:13,010 --> 00:13:14,800
...قلتِ ذلك؟ لكن

218
00:13:14,800 --> 00:13:16,890
...لـ-لا، أنا

219
00:13:16,890 --> 00:13:19,450
العوام ليس ناساً

220
00:13:19,450 --> 00:13:23,400
فقط لأنّ لديكِ فارساً وضيعاً حقّق
...إنجازات نوعيّو وابنة دوق

221
00:13:23,400 --> 00:13:25,900
أغلقي فمكِ الكريه

222
00:13:26,620 --> 00:13:29,910
ماذا؟ لا تغترّ أيّها الحثالة

223
00:13:30,230 --> 00:13:33,290
ألا تعرف ما يعنيه أن تعادي عائلة كونت؟

224
00:13:37,540 --> 00:13:39,670
يكفي

225
00:13:41,680 --> 00:13:42,920
ما الذي تريديّنه أيّتها العجوز؟

226
00:13:42,920 --> 00:13:44,400
عـ-عجوز؟

227
00:13:44,750 --> 00:13:48,420
سـ-سأتظاهر أنّي لم أسمع هذا

228
00:13:48,420 --> 00:13:51,850
فلتدفعوا مقابل الشاي وترحلوا من هنا

229
00:13:51,850 --> 00:13:54,430
ألا تشعرون بالخجل من أنفسكم
كنُبلاء للمملكة؟

230
00:13:54,720 --> 00:13:57,780
ماذا؟ من تظنّينني أكون؟

231
00:13:57,780 --> 00:13:59,690
أنا ابنة عائلة أوفري

232
00:13:59,690 --> 00:14:02,190
فليُخرج أحدٌ هذه العجوز

233
00:14:02,190 --> 00:14:05,790
...يكفي، من تظنّين أنّكم

234
00:14:11,950 --> 00:14:13,700
ا-اهدأ يا ليون

235
00:14:15,110 --> 00:14:16,450
...الآن

236
00:14:17,960 --> 00:14:20,080
!لديّ سبب

237
00:14:24,310 --> 00:14:26,460
!خذ أيّها الأحمق

238
00:14:27,210 --> 00:14:28,470
!أنت الأحمق

239
00:14:28,470 --> 00:14:32,670
مدّ يدك على خادمٍ سيجعل كافة
الفتيات في الأكاديميّة يكرهنك

240
00:14:35,310 --> 00:14:38,850
وقت حفلةٍ مُمتعة

241
00:14:39,350 --> 00:14:41,850
!فلتمت

242
00:14:42,170 --> 00:14:43,780
!ليون

243
00:14:43,780 --> 00:14:45,360
!فقد صوابه

244
00:14:48,940 --> 00:14:52,240
لا تعبث معي! كيف تجرؤ على ضرب خدمي؟

245
00:14:53,390 --> 00:14:58,000
راجعوا أنفسكم أيّها الخنازير، أتعرفون من تكون هذه المرأة؟

246
00:14:58,690 --> 00:15:00,790
ملكة مملكة هولفورت

247
00:15:01,850 --> 00:15:04,240
جلالتها ميلين-ساما

248
00:15:10,510 --> 00:15:12,490
حضّري نفسك

249
00:15:12,490 --> 00:15:17,360
قد يكون والدكِ كونتاً، لكنّك لن تفلتِ
بعد افتعال شجارٍ مع الملكة

250
00:15:17,360 --> 00:15:19,940
ليون-كن، انتظر. أنا أتنقّل خفاءً

251
00:15:19,940 --> 00:15:22,020
كُن صبيّاً مطيعاً واهدأ، اتّفقنا؟

252
00:15:22,360 --> 00:15:26,270
جلالتكِ، دعيني أنا ليون فو بارتفورت
أتولّى هذا الأمر

253
00:15:26,570 --> 00:15:29,530
فتك أو إبادة، أنا لها

254
00:15:29,790 --> 00:15:32,280
سأدمر، أدمّر تدميراً

255
00:15:32,280 --> 00:15:35,410
!أخبرتك أنّه لا يمكنك فعل ذلك

256
00:15:37,290 --> 00:15:39,130
!فلتتوقّف رجاءً

257
00:15:37,290 --> 00:15:39,130
فقد سيطرته

258
00:15:39,130 --> 00:15:41,160
ذاك الرجل هو الوحيد
الذي يمكنه مساعدتنا

259
00:15:42,820 --> 00:15:49,040
سيّد ليون، من يسلك درب الشاي
عليه ألّا يضايق الآنسات

260
00:15:49,040 --> 00:15:51,380
ذلك لا يليق بالرجال المُحترمين

261
00:15:51,380 --> 00:15:54,680
...اعذرني معلّمي، لكنّي

262
00:15:54,950 --> 00:15:58,260
،أعرف أنّ الأمر كان شاقاً
أعرف أنّه كان مؤلماً لك

263
00:15:58,700 --> 00:16:04,550
لكن ما يكمن وراء ذلك التحدّي هو جوهر
الرجل المُحترم الحقيقيّ وتتمة درب الشاي

264
00:16:05,350 --> 00:16:06,560
!أجل معلّمي

265
00:16:06,830 --> 00:16:10,530
دعني أحضّر شاياً لك

266
00:16:11,870 --> 00:16:15,840
معلّم الشاي... وقت الشاي السعيد

267
00:16:15,840 --> 00:16:16,570
ليون-كن

268
00:16:17,550 --> 00:16:19,200
أنا غاضبة

269
00:16:21,170 --> 00:16:23,710
فلتصفحي عن عائلتي رجاءً

270
00:16:24,050 --> 00:16:26,460
لا أهتم بما يحلّ بي

271
00:16:26,460 --> 00:16:30,140
ماذا؟ لا، لم أقصد ذلك

272
00:16:30,140 --> 00:16:31,680
ساعديني يا آنجي

273
00:16:31,680 --> 00:16:34,340
ميلين-ساما، إنّه يتلاعب معك

274
00:16:34,340 --> 00:16:35,340
ماذا؟

275
00:16:36,340 --> 00:16:38,740
يا لفظاعتك، أسأتُ تقديرك

276
00:16:39,420 --> 00:16:41,260
أنا آسف

277
00:16:42,690 --> 00:16:46,480
ليون-كن، أتيتُ للتعبير عن شكواي

278
00:16:46,830 --> 00:16:50,480
ليس بخصوص عقوبتك، لكن كشأن شخصيّ

279
00:16:51,740 --> 00:16:53,490
أنا مُنصت

280
00:16:53,810 --> 00:16:59,300
أعتذر على أفعال يوليوس، لكنّ النزال
بحدّ ذاته لم يكن مقبولاً

281
00:16:59,300 --> 00:17:01,350
كان قتالك فظيعاً

282
00:17:03,210 --> 00:17:07,370
ألم تستطع تسوية الأمر بسلام؟

283
00:17:08,690 --> 00:17:11,380
أدركتُ أمراً مهولاً

284
00:17:12,300 --> 00:17:17,590
إنّها بغاية الجمال، لا تبدو أنّها
في الثلاثينيّات أبداً

285
00:17:18,470 --> 00:17:21,390
لديك الكثير من الأعداء في القصر الملكيّ

286
00:17:21,390 --> 00:17:24,640
هل فكّرت بمستقبلك؟

287
00:17:24,880 --> 00:17:26,140
بالطبع

288
00:17:26,370 --> 00:17:31,430
،فهمت، إذا كنت متيقّناً
فلا أملك ما أضيفه

289
00:17:31,900 --> 00:17:34,770
أودّ منك أن تساعدني
في موضوعٍ آخر

290
00:17:34,770 --> 00:17:36,030
ما قصدك؟

291
00:17:36,510 --> 00:17:42,030
،لأنّي أتيت من بلدٍ مجاور
لم يسبق وأن ارتدتُ الأكاديميّة

292
00:17:42,420 --> 00:17:47,540
فأريد صنع ذكريات هنا

293
00:17:47,990 --> 00:17:52,130
في حياتي السابقة، كنتُ لأخبر هذه العجوز
أن تقوم بالأمر بنفسها

294
00:17:52,130 --> 00:17:53,530
لكنّي مختلفٌ الآن

295
00:17:54,010 --> 00:17:57,800
لا بأس، لنصنع ذكريات للأكاديميّة معاً

296
00:17:58,310 --> 00:18:01,130
ميلين-سامان، هلّا تزوّجتِني؟

297
00:18:04,060 --> 00:18:06,550
ليون-سان، ما الذي تقوله؟

298
00:18:06,550 --> 00:18:08,060
إنّها الملكة

299
00:18:08,320 --> 00:18:11,050
...أعرف، أعرف، لكن

300
00:18:11,770 --> 00:18:17,910
امرأة أنيقة ظريفة في ثلاثينيّاتها أفضل بكثير
من المراهقات المتوحشّات في الأكاديميّة

301
00:18:17,910 --> 00:18:21,320
...أريد التزوّج بشريّة، لذا

302
00:18:21,590 --> 00:18:24,410
أنا مُعجب بك، أحبّك

303
00:18:24,870 --> 00:18:30,040
لـ-لكن لا يصحّ هذا، فأنا أملك
زوجاً كما أطفالاً

304
00:18:30,580 --> 00:18:34,290
كما أنّي كبيرةٌ في السنّ

305
00:18:34,290 --> 00:18:37,120
لا يهمّ، أنتِ جميلة

306
00:18:37,120 --> 00:18:39,300
...حتّى لو كانت لديكِ عائلة، أنا

307
00:18:40,580 --> 00:18:43,100
مؤلم، من فعل ذلك؟

308
00:18:46,210 --> 00:18:47,180
سموّك

309
00:18:47,520 --> 00:18:53,190
بارتفورت، يا لجرأتك بالتودّد
لأمّ أحدهم هكذا

310
00:18:53,520 --> 00:18:56,190
لـ-ليس الأمر كما يبدو عليه يا يوليوس

311
00:18:56,420 --> 00:19:00,220
أمّي، ابتعدي عن ذاك الرجل رجاءً

312
00:19:00,220 --> 00:19:01,940
فلتفلتها

313
00:19:01,940 --> 00:19:04,950
ماذا؟ لكنّي لا أريد

314
00:19:05,530 --> 00:19:07,950
!ليون-كن

315
00:19:08,350 --> 00:19:10,460
تجاهليه، لنذهب وحسب يا أمّي

316
00:19:10,460 --> 00:19:12,620
جنيت على نفسك

317
00:19:12,620 --> 00:19:14,450
أتّفق

318
00:19:15,410 --> 00:19:20,210
جلالتك، هل صنعتِ الذكريات
التي أردتِها في الأكاديميّة؟

319
00:19:23,280 --> 00:19:27,100
أمّي، عليكِ ألّا تسمحي
لبارتفورت بالاقتراب منكِ

320
00:19:27,490 --> 00:19:30,480
فهو جبانٌ طمّاع فظّ

321
00:19:33,480 --> 00:19:38,730
يوليوس، ألم تقل أنّك ورفاقك تديرون مقهى؟

322
00:19:38,730 --> 00:19:42,930
بلى، رغم أنّ ماري أجرت تعديلاتاً

323
00:19:42,930 --> 00:19:44,770
أليس جميلاً؟

324
00:19:44,770 --> 00:19:47,260
استدعها لي

325
00:19:47,580 --> 00:19:50,310
إ-إنّها غاضبةٌ جدّاً

326
00:19:50,660 --> 00:19:56,100
إذا اكتشفت أنّي جعلت ابنها
...الأمير يخدم الفتيات

327
00:19:57,510 --> 00:20:00,100
أمّي، أنتِ مثل البقيّة

328
00:20:00,100 --> 00:20:02,880
إذا كان هذا سلوكك، فلا يمكنني
أن أسمح لكِ بمقابلة ماري

329
00:20:04,890 --> 00:20:09,290
ألم تنعت ليون-كن بالطمّاع؟

330
00:20:09,290 --> 00:20:12,140
ما أسعار هذا المتجر إذاً؟

331
00:20:12,390 --> 00:20:15,380
مئة ديا مقابل شاي وحلويات رديئة؟

332
00:20:15,380 --> 00:20:17,770
لا أصّدق أنّكم تتقاضون
ثمن خدمةٍ فوق ذلك

333
00:20:17,770 --> 00:20:22,020
ولمَ يرتدي الوريثون السابقون للعائلات
المرموقة هذه الأزياء؟

334
00:20:22,020 --> 00:20:23,420
...إ-إنّها

335
00:20:24,030 --> 00:20:28,990
وافقتَ على الابتعاد عن ماري
بعد خسارة النزال

336
00:20:28,990 --> 00:20:31,650
من الجبان المُخالف للوعد؟

337
00:20:32,090 --> 00:20:36,920
أنا أساعد براد والبقيّة الذين صادف
أنّهم مع ماري وحسب

338
00:20:37,190 --> 00:20:39,130
لا تختلق أعذاراً بائسة

339
00:20:39,130 --> 00:20:42,920
بأيّ حال، استدع تلك الفتاة لي سريعاً

340
00:20:47,370 --> 00:20:49,550
كانت من صنفي المفضّل تماماً

341
00:20:49,550 --> 00:20:54,430
أيّها الأحمق، أيّ فارس قد يتقرّب
من مملكة بلاده؟

342
00:20:55,180 --> 00:21:01,550
،حسناً، بعد تفكيري بعقلانيّة
فيستحيل أن يتزوّج موب مثلي ملكةً

343
00:21:02,410 --> 00:21:03,940
المعذرة

344
00:21:04,340 --> 00:21:05,820
لا يزال المتجر مفتوحاً؟

345
00:21:05,820 --> 00:21:10,280
المعذرة، معنوياتي متحطّمة لذا أغلقنا لليوم

346
00:21:10,280 --> 00:21:11,580
...أنت

347
00:21:11,580 --> 00:21:14,830
...ماذا؟ حسناً، في تلك الحالة

348
00:21:15,100 --> 00:21:17,080
أوليفيا-سان

349
00:21:17,360 --> 00:21:19,890
أيمكنكِ القيام بما طلبته منكِ قبلاً؟

350
00:21:19,890 --> 00:21:21,340
حـ-حسناً

351
00:21:21,940 --> 00:21:26,830
هذه كارلا-سان، طلبت منّي تقديمها إليك

352
00:21:27,730 --> 00:21:30,000
أنا كارلا فو وين

353
00:21:30,450 --> 00:21:33,100
سُررت بلقائك سيّدي

354
00:21:33,380 --> 00:21:35,600
كارلا وين؟

355
00:21:35,600 --> 00:21:39,980
إذاً، لمَ طلبتِ من ليفيا تقديمك؟

356
00:21:45,060 --> 00:21:48,490
سيّدي، فلتنقذ عائلة وين من فضلك

357
00:21:49,140 --> 00:21:51,230
أنقذنا رجاءً

358
00:23:26,810 --> 00:23:28,840
لا بدّ أنّي سأصبح ذا شعبيّة
إن قدتُ درّاجةً هوائيّة

359
00:23:28,840 --> 00:23:29,990
ليس صحيحاً

360
00:23:29,990 --> 00:23:33,050
سؤال: ما الذي تحتاجه عند
البحث عن زوجة؟

361
00:23:33,050 --> 00:23:33,770
المال

362
00:23:33,770 --> 00:23:34,050
المظهر

363
00:23:34,050 --> 00:23:34,740
المقام

364
00:23:34,740 --> 00:23:35,510
السلالة العريقة

365
00:23:35,510 --> 00:23:36,050
قدرة التوفير

366
00:23:36,050 --> 00:23:36,680
معرفة وقت الاستسلام

367
00:23:36,680 --> 00:23:37,560
الحكمة

368
00:23:37,560 --> 00:23:39,410
الحلقة القادمة: يكره كلانا الفتيان الوسيمين