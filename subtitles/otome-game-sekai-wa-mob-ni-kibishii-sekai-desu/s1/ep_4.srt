1
00:00:08,530 --> 00:00:11,860
احمليها أيّتها الشرّيرة
!التي خدعت الأمير

2
00:00:12,230 --> 00:00:13,500
نزال؟

3
00:00:12,770 --> 00:00:13,970
إنّه نزال

4
00:00:13,970 --> 00:00:17,370
إذا حملت القفّاز، فسيعني ذلك
أنّها قبلت النزال

5
00:00:17,830 --> 00:00:19,270
احمليه يا ماري

6
00:00:19,770 --> 00:00:22,120
سأكون بطلك

7
00:00:22,120 --> 00:00:23,750
...لكن

8
00:00:24,160 --> 00:00:28,880
حسناً يا سادة، أتطوّع أنا لأكون بطلها

9
00:00:29,220 --> 00:00:30,880
قلتَ أنّ اسمك ليون

10
00:00:31,290 --> 00:00:33,760
يُستحسن أن تكون متحضّراً

11
00:00:34,160 --> 00:00:36,760
لنتنازل يا أمير

12
00:02:29,620 --> 00:02:31,000
ما هذا؟

13
00:02:31,350 --> 00:02:33,030
ما ذاك الدرع؟

14
00:02:33,030 --> 00:02:34,550
!يا للسخافة

15
00:02:35,000 --> 00:02:36,870
!لا يُعقل

16
00:02:38,940 --> 00:02:42,140
أتنوي القتال بهذا حقّاً؟

17
00:02:42,140 --> 00:02:44,510
فلتشاهدي وحسب

18
00:02:44,770 --> 00:02:48,340
لمَ يضحك الجميع؟

19
00:02:48,340 --> 00:02:51,340
لا تعرفين شيئاً بحقّ

20
00:02:52,770 --> 00:02:55,760
هذا الدرع أداةٌ مفقودة على الأرجح

21
00:02:56,250 --> 00:02:59,460
لا يمكن إعادة صنعه بالتقنية الحديثة

22
00:02:59,980 --> 00:03:02,780
لكن لا يقتضي ذلك أنّه قويّ

23
00:03:03,030 --> 00:03:07,390
في المعارك الحديثة، الدروع فائقة الحركة
التي تركّز على السرعة هي السائدة

24
00:03:08,050 --> 00:03:10,470
هذه النماذج الثقيلة
لا توافق الطراز

25
00:03:13,500 --> 00:03:17,860
لكنّ صغرها وامتلاءها أمرٌ ظريف

26
00:03:17,860 --> 00:03:20,620
هنالك خطبٌ ما بتفكيرك
إن كنتِ تعتقدين ذلك

27
00:03:22,020 --> 00:03:24,800
يبدو أنّه أكثر من محض
درعٍ بشع

28
00:03:25,110 --> 00:03:27,780
ما الذي يدور ببالك يا بارتفورت؟

29
00:03:30,300 --> 00:03:31,810
ها نحن

30
00:03:33,260 --> 00:03:35,340
تفعيل آروغانز

31
00:03:35,340 --> 00:03:36,380
حسنٌ

32
00:03:38,100 --> 00:03:39,110
لوكسيون

33
00:03:39,110 --> 00:03:39,940
ما الأمر؟

34
00:03:40,280 --> 00:03:42,550
ما معنى "آروغانز"؟

35
00:03:42,550 --> 00:03:44,610
ابحث عن ذلك لاحقاً

36
00:03:44,610 --> 00:03:46,900
إنّها كلمةٌ تلائمك تماماً يا سيّدي

37
00:03:46,900 --> 00:03:50,850
حقّاً؟ يمكنك أن تكون مُراعياً أحياناً

38
00:03:59,460 --> 00:04:02,810
يبدو أنّك لم تهرب من نزالنا

39
00:04:03,170 --> 00:04:04,720
أثني عليك

40
00:04:04,990 --> 00:04:09,220
لكن أتعتقد أنّ بمقدورك هزيمتي
بهذه الآلة القديمة؟

41
00:04:10,010 --> 00:04:13,980
درع أرجوانيّ... لا بدّ أنّ
خصمي الأوّل هو براد

42
00:04:14,560 --> 00:04:18,400
براد نرجسيٌّ موهوب في السحر

43
00:04:18,400 --> 00:04:20,680
،إنّه أصغر الخمسة

44
00:04:20,680 --> 00:04:22,990
لكنّه شديد الفخر ويسعى لجذب الانتباه

45
00:04:23,410 --> 00:04:25,990
جعلني أعاني كثيراً في اللعبة

46
00:04:25,990 --> 00:04:30,790
انظر لهذا الدرع من صنع
الحرفيّ الأستاذ آلتينتر

47
00:04:36,300 --> 00:04:40,500
هل عليك أن تتفاخر لهذا
الحدّ أمام خصمك؟

48
00:04:43,410 --> 00:04:47,030
يبدو أنّه يحمل أسلحةً تشبه
الطائرات المسيّرة على ظهره

49
00:04:47,030 --> 00:04:49,800
هل أطلقّ الردّ المعاكس؟

50
00:04:49,800 --> 00:04:51,890
لا تقلق، أعرف ما ذلك

51
00:04:52,490 --> 00:04:54,520
كما أنّ الأرجوانيّ لونٌ ضعيف

52
00:04:55,100 --> 00:04:57,400
سلوكك يثير أعصابي بحقّ

53
00:04:57,760 --> 00:04:59,850
علينا تحضير أسلحتنا

54
00:04:59,850 --> 00:05:02,400
حسنٌ، سنستعمل النصل رقم 1
في حقيبة الظهر

55
00:05:07,030 --> 00:05:08,710
!هذه مجرفة

56
00:05:08,710 --> 00:05:09,910
بالطبع

57
00:05:10,130 --> 00:05:14,160
عندما أخذت هذه الآلة للتجربة قبلاً، حفرتَ حفراً

58
00:05:14,160 --> 00:05:15,830
!كان عليك تبديلها

59
00:05:15,830 --> 00:05:17,670
!أيّاً يكن، أعطني نصلاً وحسب

60
00:05:17,670 --> 00:05:21,350
لكنّك من حدّد النصل رقم 1 يا سيّدي

61
00:05:21,350 --> 00:05:23,670
فعلتَ هذا عن قصدٍ بالتأكيد

62
00:05:24,040 --> 00:05:27,300
حسناً، لا يهمّ. ربما يمكنني القتال بها غالباً

63
00:05:29,820 --> 00:05:31,850
!يا للنبيل الريفيّ

64
00:05:31,850 --> 00:05:33,670
مجرفة؟ صدقاً؟

65
00:05:36,050 --> 00:05:37,560
يا للمنظر المخزي

66
00:05:40,070 --> 00:05:43,550
تبّاً لك، إلى أيّ أحدٍّ تنوي السخرية منّي؟

67
00:05:43,550 --> 00:05:46,130
لم يكن ذلك عن قصد في الواقع

68
00:05:46,130 --> 00:05:48,580
أيّها البطلان، اذكرا اسماكما قبل النزال

69
00:05:49,620 --> 00:05:51,570
ليون فو بارتفورت

70
00:05:52,320 --> 00:05:54,580
براد فو فيلد

71
00:05:59,100 --> 00:06:01,710
!استعداد... ابدآ

72
00:06:01,710 --> 00:06:04,960
!سأقتلك بضربة واحدة، مُت

73
00:06:32,570 --> 00:06:33,460
ماذا؟

74
00:06:35,270 --> 00:06:38,000
أيّها الحكم، يبدو أنّه فقد وعيه

75
00:06:40,820 --> 00:06:43,510
احتككتُ به بالكاد

76
00:06:43,510 --> 00:06:47,510
لو هاجمته بقوّتك الكاملة، للقي حتفه

77
00:06:47,980 --> 00:06:52,260
كان يجيد استعمال الرمح، لكنّ ذلك
كلّ ما يتميّز به

78
00:06:52,780 --> 00:06:57,520
أيمكن أنّك حاقدٌ لنعتهم آروغانز بالطراز القديم؟

79
00:06:58,640 --> 00:07:00,650
!فـ-فقد وعيه

80
00:07:00,650 --> 00:07:03,020
!الفائز هو بارتفورت

81
00:07:06,020 --> 00:07:10,210
كنتُ أعرف حصول هذا، لكن لا أحد متحمّسٌ لهذه النتيجة

82
00:07:11,380 --> 00:07:12,030
ماذا؟

83
00:07:15,300 --> 00:07:16,750
...معلّمي

84
00:07:17,780 --> 00:07:19,850
يا للسيّد النبيل

85
00:07:20,640 --> 00:07:21,950
ما-ماذا؟

86
00:07:21,950 --> 00:07:23,290
ما الذي جرى؟

87
00:07:23,290 --> 00:07:25,920
حصل بلمح البصر، لم ألاحظ

88
00:07:27,920 --> 00:07:31,740
فاز ليون-سان من فوره، ذلك مُذهل

89
00:07:31,740 --> 00:07:33,550
أ-أجل

90
00:07:34,090 --> 00:07:36,550
ما كانت تلك التحرّكات؟

91
00:07:36,550 --> 00:07:39,560
تبدو مستحيلةً لآلة ثقيلة الدروع كهذه

92
00:07:39,560 --> 00:07:44,060
كان درع براد مصنوعاً خصّيصاً
من قِبل عائلة فيلد

93
00:07:44,320 --> 00:07:45,580
ما معنى هذا؟

94
00:07:45,580 --> 00:07:46,480
...براد-ساما

95
00:07:46,480 --> 00:07:48,670
سيفوزون في الجولة التالية حتماً، صحيح؟

96
00:07:48,670 --> 00:07:51,060
راهنتُ بكافة أموالي على الأمير

97
00:07:55,570 --> 00:07:58,920
ما-ما الأمر يا آنجليكا-سان؟

98
00:07:58,920 --> 00:08:01,070
لا يسعني سوى أن أضحك

99
00:08:01,070 --> 00:08:03,480
بارتفورت رجلٌ فظيعٌ بحقّ

100
00:08:03,480 --> 00:08:06,580
!ليون-سان ليس فظيعاً! إنّه شخصٌ لطيف

101
00:08:07,360 --> 00:08:09,460
أجل، معكِ حقّ

102
00:08:09,900 --> 00:08:14,890
بأيّ حال، لمَ اختار التحالف معي
إن كان بهذه القوّة؟

103
00:08:14,890 --> 00:08:18,970
لا بدّ أنّه يعلم أنّ تحدّي الأمير سيقضي على مستقبله

104
00:08:19,650 --> 00:08:21,070
...بارتفورت

105
00:08:21,450 --> 00:08:24,900
لا بدّ أنّه كان بغاية الثقة
لامتلاكه ذاك الدرع

106
00:08:24,900 --> 00:08:27,290
لعلّه أداة مفقودة غالباً

107
00:08:27,290 --> 00:08:31,510
لكن لم يسبق وأن سمعت
بتبقّي درع قويّ كهذا

108
00:08:31,920 --> 00:08:33,990
أنا التالي

109
00:08:34,230 --> 00:08:36,990
برا\ محض ضعيف

110
00:08:37,500 --> 00:08:40,060
أنا سأغلبه

111
00:08:40,490 --> 00:08:41,170
!غريغ

112
00:08:41,170 --> 00:08:42,710
!أرجوك

113
00:08:41,170 --> 00:08:45,330
!أنت لها

114
00:08:41,580 --> 00:08:43,500
وقت الجولة الثانية

115
00:08:43,500 --> 00:08:44,880
!غريغ

116
00:08:44,880 --> 00:08:46,500
!نل منه

117
00:08:46,940 --> 00:08:49,060
ليون فو بارتفورت

118
00:08:49,530 --> 00:08:51,750
غريغ فو سيبرغ

119
00:08:52,780 --> 00:08:56,010
حدّدتُ عدّة إصلاحات على سطحه

120
00:08:56,010 --> 00:08:59,650
يبدو أنّ لديه خبرةً واسعة
في القتال بالدروع

121
00:08:59,650 --> 00:09:02,270
أجل، إنّه قويّ

122
00:09:02,750 --> 00:09:06,800
،بارتفورت، لم تغلب براد لقوّتك

123
00:09:06,800 --> 00:09:08,270
!بل لقوّة درعك

124
00:09:08,930 --> 00:09:12,300
لستَ على خطأ، لكن إن أردت القتال بالكلمات

125
00:09:12,300 --> 00:09:14,280
فهلّا دعوتني لحفلة شاي قريباً؟

126
00:09:15,250 --> 00:09:16,780
سأسحقك

127
00:09:17,220 --> 00:09:19,330
!أيّها البطلان، ابدآ

128
00:09:23,930 --> 00:09:26,120
هيّا! ما الخطب؟

129
00:09:26,120 --> 00:09:27,910
!أهذا كلّ ما لديك؟

130
00:09:29,690 --> 00:09:35,170
...غريغ ماهرٌ وذو عزيمة، لكن

131
00:09:35,440 --> 00:09:38,430
!اختر أدواتاً أفضل

132
00:09:41,340 --> 00:09:45,230
،غريغ فخورٌ لمهارته

133
00:09:45,230 --> 00:09:48,500
وكانت هناك أدوات قليلة يمكنه تركيبها

134
00:09:48,860 --> 00:09:52,170
انتهت لعبتي عدّة مرّات بسبب ذلك

135
00:09:56,940 --> 00:10:01,040
!تخلَّ عن ذاك الفخر الفارغ

136
00:10:04,050 --> 00:10:05,700
أمسكتُ بك

137
00:10:06,090 --> 00:10:08,030
!دعني! تبّاً لك

138
00:10:08,030 --> 00:10:10,210
لن أدعك يا غبيّ

139
00:10:14,270 --> 00:10:16,990
لا بأس، لا يتأثّر قائد المركبة

140
00:10:17,930 --> 00:10:19,720
ساقك اليمنى تالياً

141
00:10:19,720 --> 00:10:22,660
أتستمتع بتعذيبي يا هذا؟

142
00:10:22,660 --> 00:10:24,720
!أنت تفوز بسبب درعك فحسب

143
00:10:24,720 --> 00:10:29,250
ماذا؟ إنّها غلطتك لخوضك
نزالاً بدرع قديم

144
00:10:29,250 --> 00:10:33,830
أتعرف أنّ نتيجة أيّ نزال تتحدّد
أثناء مرحلة التحضير؟

145
00:10:39,990 --> 00:10:42,260
لكن ألستَ مسروراً لأنّك
قادرٌ على التعذّر؟

146
00:10:42,260 --> 00:10:45,830
خسرتَ لأنّ درعي أفضل
من درعك بكثيرٍ فحسب

147
00:10:46,490 --> 00:10:48,080
تبّاً

148
00:10:48,460 --> 00:10:50,580
!تبّاً

149
00:10:51,330 --> 00:10:52,970
!لن أخسر

150
00:10:52,970 --> 00:10:56,340
سأقاتل للموت، ولو كان
!عليّ القتال دون درعي

151
00:10:56,340 --> 00:10:58,800
...ماذا؟ لكن

152
00:10:58,800 --> 00:11:01,340
!اخرس! هات ما لديك

153
00:11:01,640 --> 00:11:07,100
لا أهوى التنمّر على الضعفاء، بخلافكم

154
00:11:07,100 --> 00:11:08,600
ماذا؟

155
00:11:08,600 --> 00:11:13,100
قلتُ أنّي لا أستمتع بتعذيب
الضعفاء، أتفهم ذلك؟

156
00:11:13,850 --> 00:11:17,610
لا تكن سخيفاً! متى تنمّرنا على ضعيف؟

157
00:11:17,610 --> 00:11:22,110
عجباً، من المُخيف امتلاك بعض الناس
لإدراك ذات ضعيف كهذا، يا إلهي

158
00:11:22,110 --> 00:11:25,370
لذا لا أطيق النبلاء الذين
ينالون معاملةً خاصّة

159
00:11:27,030 --> 00:11:29,470
أيّاً يكن، أنت نكرة

160
00:11:29,470 --> 00:11:31,610
وتعذيب النكرات يترك مذاقاً سيّئاً في فمي

161
00:11:31,610 --> 00:11:33,580
فأريد الانتهاء من هذا بسرعة

162
00:11:33,580 --> 00:11:35,130
ألا تفهم ذلك؟

163
00:11:36,370 --> 00:11:38,010
!تبّاً

164
00:11:40,590 --> 00:11:42,550
ماذا؟ هل هبطت عليّ بعوضة؟

165
00:11:45,510 --> 00:11:50,560
الـ-الفائز هو بارتفورت! فلتغادر الحلبة
!من فضلك يا غريغ فو سيبرغ

166
00:11:50,920 --> 00:11:52,020
فظيع

167
00:11:52,020 --> 00:11:54,490
ليس هذا شيئاً يُفترض
أن يقوم به فارس

168
00:11:54,490 --> 00:11:57,060
لا أصدّق أنّ غريغ خسر أيضاً

169
00:11:57,330 --> 00:12:01,790
يسرّني فوز ليون-سان، لكنّه تمادى كثيراً

170
00:12:01,790 --> 00:12:04,220
عليه الاعتذار لغريغ-سان لاحقاً

171
00:12:04,220 --> 00:12:05,200
توقّفي

172
00:12:06,320 --> 00:12:08,970
سيجرح ذلك غريغ أكثر وحسب

173
00:12:11,850 --> 00:12:12,950
الجولة الثالثة

174
00:12:13,490 --> 00:12:17,460
بارتفورت، لن أستهين بك كما فعلا

175
00:12:18,030 --> 00:12:20,080
سأقاتلك بكلّ قوّتي من البداية

176
00:12:20,080 --> 00:12:21,090
صدقاً؟

177
00:12:21,440 --> 00:12:24,050
سأقاتل بجدّيةٍ بدوري إذاً

178
00:12:24,050 --> 00:12:26,590
لا تكذب بكلامك، صحيح؟

179
00:12:26,590 --> 00:12:28,970
أجل، أعدك

180
00:12:29,390 --> 00:12:32,120
كريس سيّافٌ شاب

181
00:12:32,120 --> 00:12:35,250
إنّه متّزنٌ ولا يجيد التعبير عن مشاعره

182
00:12:35,250 --> 00:12:38,980
استعمل السيوف فحسب أثناء
أجزاء المعارك في اللعبة

183
00:12:39,340 --> 00:12:41,480
أي أنّه مزعجٌ كبير

184
00:12:41,910 --> 00:12:43,490
!أيّها البطلان، ابدآ

185
00:12:48,240 --> 00:12:49,490
ماذا؟

186
00:12:49,890 --> 00:12:52,230
لوكسيون، أطلق الطائرات المسيّرة

187
00:12:52,230 --> 00:12:53,020
حاضر

188
00:13:01,940 --> 00:13:05,420
بارتفورت، أنت راضٍ بالقتال هكذا؟

189
00:13:05,420 --> 00:13:07,680
!لا فروسيّة في هذا الأسلوب أبداً

190
00:13:08,960 --> 00:13:11,180
أهذا كلّ ما لديك لتقوله؟

191
00:13:11,510 --> 00:13:14,680
لم يقل أحدٌ أنّ الإطلاق مخالفٌ للقوانين

192
00:13:15,940 --> 00:13:20,520
أنتم ضعفاء جدّاً بالأصل، فلا أمانع التهاون

193
00:13:20,520 --> 00:13:23,690
سأسمح لك بتجسيد فروسيّتك الغالية

194
00:13:25,040 --> 00:13:27,890
!بارتفورت

195
00:13:31,220 --> 00:13:34,450
سيّافٌ بارع بحقّ، عملٌ مبهر

196
00:13:37,710 --> 00:13:41,510
لمَ؟ لمَ خسرت؟

197
00:13:41,510 --> 00:13:43,960
اجتهدتُ أكثر من أيّ أحد

198
00:13:44,940 --> 00:13:47,950
لمَ لا تتبّجح لماري بشأن اجتهادك؟

199
00:13:47,950 --> 00:13:49,720
قد تتعاطف معك

200
00:13:52,330 --> 00:13:54,390
أنت حثالةٌ بحقّ

201
00:13:54,390 --> 00:13:58,100
اخرس، حتّى أنا أشعر أنّي بالغتُ قليلاً

202
00:13:58,510 --> 00:13:59,730
جدّياً؟

203
00:13:59,730 --> 00:14:00,810
حتّى كريس؟

204
00:14:00,810 --> 00:14:01,840
!لا يُعقل

205
00:14:01,840 --> 00:14:04,110
!راهنتُ بكلّ أموالي

206
00:14:04,110 --> 00:14:10,490
،هذا سيّئ، لا بأس إن خسرت
لكن عليّ حماية الأمير

207
00:14:11,030 --> 00:14:14,150
مهما تطلّب الأمر

208
00:14:24,960 --> 00:14:25,710
اسمعي

209
00:14:30,050 --> 00:14:32,140
اسمعا، لديّ طلب

210
00:14:49,610 --> 00:14:50,530
هل وجدتِه؟

211
00:14:50,530 --> 00:14:52,480
لا، لم أجده في أيّ مكان

212
00:14:56,620 --> 00:14:57,870
!ليون-سان

213
00:14:57,870 --> 00:14:59,160
جعلتنا نقلق

214
00:14:59,420 --> 00:15:01,670
تقلقان؟ بخصوص ماذا؟

215
00:15:01,670 --> 00:15:04,070
أختك التي التقيناها قبلاً

216
00:15:04,070 --> 00:15:07,370
،قالت أنّك لم تبد على ما يرام
وطلبت منّا الاطمئنان عليك

217
00:15:07,370 --> 00:15:10,670
قالت أنّ عليك الانسحاب
من الجولة التالية

218
00:15:10,990 --> 00:15:13,180
جينا قلقةٌ عليّ؟

219
00:15:13,180 --> 00:15:15,550
!أيّها الأحمق

220
00:15:16,340 --> 00:15:18,060
يستحيل

221
00:15:18,410 --> 00:15:21,790
ليون-سان، لا تشعر بخيرٍ حقّاً؟

222
00:15:21,790 --> 00:15:25,220
في الواقع، كنتُ أصارع نفسي لفترة

223
00:15:25,220 --> 00:15:26,770
أنا على وشك تبليل نفسي

224
00:15:26,770 --> 00:15:29,070
لا-لا بدّ أنّ هذا غير مريح

225
00:15:29,580 --> 00:15:33,070
عليك تخيّر كلماتك مع الفتيات

226
00:15:33,380 --> 00:15:36,960
معكِ حقّ، كنتُ أقطف أزهاراً

227
00:15:36,960 --> 00:15:39,580
رغم أنّه لا توجد حقول أزهارٍ في الحلبة

228
00:15:40,980 --> 00:15:43,170
كان علينا ألّا نقلق

229
00:15:43,170 --> 00:15:44,580
أجل

230
00:15:46,320 --> 00:15:49,980
سيّدي، تمّ تفخيخ آروغانز بمتفجّرات

231
00:15:49,980 --> 00:15:55,070
فخّخته أختك، لكنّ من أمرها بذلك
كان خصمك التالي

232
00:15:55,070 --> 00:15:57,600
حسناً، لا أستغرب ذلك

233
00:15:58,030 --> 00:16:01,830
تشعر بالخزيّ لخوضي قتالاً
مع الأمير غالباً

234
00:16:02,160 --> 00:16:04,560
استغلّ جيلك ذلك

235
00:16:05,660 --> 00:16:08,830
تمّ وضع المتفجّرات على ظهر الدرع

236
00:16:08,830 --> 00:16:12,470
يبدو أنّها تُفجّر عبر نوع سحرٍ خاصّ

237
00:16:12,970 --> 00:16:15,700
كانت تلك المتفجّرات موجودةً
في اللعبة أيضاً

238
00:16:15,700 --> 00:16:17,120
مع أنّي لم أستعملها

239
00:16:17,580 --> 00:16:19,550
،لو كان درعاً عاديّاً

240
00:16:19,550 --> 00:16:23,120
،بناءً على كميّة المواد المتفجّرة
فلن يقتل قائد المركبة

241
00:16:23,120 --> 00:16:26,410
لو كان درعاً عاديّاً، صحيح؟

242
00:16:31,860 --> 00:16:34,870
من يبدون لطفاء هم الأكثر إخافةً

243
00:16:35,300 --> 00:16:37,020
هذا شائع

244
00:16:44,520 --> 00:16:47,770
أنت قويّ، أحترم ذلك

245
00:16:48,320 --> 00:16:50,020
شكراً لك

246
00:16:50,590 --> 00:16:52,280
!أيّها البطلان، ابدآ

247
00:16:57,490 --> 00:16:58,730
إنّه غطاءٌ دخانيّ

248
00:16:58,730 --> 00:17:01,660
لا يمكن أن يترك المظهر يؤثر عليه؟

249
00:17:03,920 --> 00:17:07,670
انتهت حياتك لحظة معارضتك للأمير

250
00:17:08,110 --> 00:17:11,670
سأمنحك نهايةً مجيدة على الأقل

251
00:17:13,950 --> 00:17:15,050
أمات؟

252
00:17:18,410 --> 00:17:19,050
ماذا؟

253
00:17:19,390 --> 00:17:24,220
تلك القنبلة المضادة للدروع قادرة
على تمزيق النماذج الاعتياديّة بسهولة

254
00:17:24,220 --> 00:17:26,560
...لم تترك أيّ خدش

255
00:17:26,560 --> 00:17:30,700
...لا خيار بيدي، لم أرد استعمال هذا، لكن

256
00:17:33,820 --> 00:17:34,860
ها هي

257
00:17:34,860 --> 00:17:35,440
أجل

258
00:17:40,300 --> 00:17:44,580
لا تحقد عليّ، هذا لأجل الأمير فقط

259
00:17:48,870 --> 00:17:49,700
مرحباً

260
00:17:50,720 --> 00:17:53,250
تـ-تحمّلت ذاك الانفجار؟

261
00:17:53,250 --> 00:17:56,840
كانت ضربةً ثقيلة، بأكثر من ناحية

262
00:17:59,220 --> 00:18:01,860
أأنت مصمّمٌ على قتال الأمير مهما حصل؟

263
00:18:01,860 --> 00:18:03,350
!ستنتهي حياتك كنبيل

264
00:18:03,610 --> 00:18:05,110
ذلك ما أريده

265
00:18:05,110 --> 00:18:08,640
وأنا متأهّبٌ لفعل أيّ شيء
!لتحقيق ذلك، مثلك

266
00:18:10,610 --> 00:18:12,110
!ستقتل الأمير؟

267
00:18:12,460 --> 00:18:15,610
ألن يكون ذلك رائعاً؟ سيتقلّص عدد منافسيك

268
00:18:16,400 --> 00:18:19,930
لكنّي والأمير نحبّها بحقّ

269
00:18:19,930 --> 00:18:25,860
إذا تنوي أذيّة الأمير، فسأجعل
!عائلتك تدفع الثمن أيضاً

270
00:18:27,100 --> 00:18:28,880
تهدّدني؟

271
00:18:28,880 --> 00:18:32,740
هل نترك الأمير وتلك الفتاة يسمعان هذا؟

272
00:18:32,740 --> 00:18:35,380
لا بدّ أنّهما سيحتقرانك

273
00:18:36,370 --> 00:18:38,880
أيّ دليل تملك على قولي ذلك؟

274
00:18:40,180 --> 00:18:46,130
إذا تنوي أذيّة الأمير، فسأجعل
!عائلتك تدفع الثمن أيضاً

275
00:18:47,670 --> 00:18:52,770
يبدو أنّ النماذج القديمة
مجهّزةٌ بوظيفة تسجيل

276
00:18:53,690 --> 00:18:54,790
!أيّها الجبان

277
00:18:54,790 --> 00:19:00,000
جبان؟ تهديد خصمك لأنّك تخسر
أكثر جبناً بمراحل

278
00:19:00,000 --> 00:19:02,800
وفوق ذلك، فخّخت درعي بمتفجّرات

279
00:19:02,800 --> 00:19:05,530
أليس أنت من انتهت حياته كنبيل؟

280
00:19:06,460 --> 00:19:08,040
!اخرس

281
00:19:08,900 --> 00:19:10,660
سئمتُ من هذا

282
00:19:14,210 --> 00:19:16,460
اكتفيت، فلتسقط وحسب

283
00:19:30,970 --> 00:19:35,390
جـ-جلالتك، إنّه خطر

284
00:19:36,050 --> 00:19:39,260
عليك ألّا تقاتله

285
00:19:40,160 --> 00:19:43,740
لعلّي سبّبت متاعباً لأختّي

286
00:19:45,520 --> 00:19:47,240
...ليون الأحمق

287
00:19:49,750 --> 00:19:51,370
...جيلك

288
00:19:51,370 --> 00:19:52,650
ما الذي يجري؟

289
00:19:52,650 --> 00:19:56,380
كيف يوجد شخصٌ بهذه القوّة؟

290
00:19:56,650 --> 00:19:58,320
هل ستكونين بخير؟

291
00:19:58,320 --> 00:20:00,880
خسر الأربعة دون أن يستطيعوا فعل شيء

292
00:20:00,880 --> 00:20:04,600
يا إلهي، يثير حنقي كالعادة

293
00:20:04,600 --> 00:20:05,680
ماري

294
00:20:06,500 --> 00:20:11,660
لا بأس، درعي مصنوعٌ بأعظم تقنيات المملكة

295
00:20:11,660 --> 00:20:12,850
لا تقلقي

296
00:20:13,440 --> 00:20:14,310
حسناً

297
00:20:14,820 --> 00:20:17,360
هذا ما قالوه، وخسروا جميعاً

298
00:20:17,750 --> 00:20:19,110
،بالمناسبة

299
00:20:19,110 --> 00:20:21,140
كان هؤلاء ضعفاء في اللعبة أيضاً

300
00:20:21,140 --> 00:20:22,890
،خسروا المعارك دوماً

301
00:20:22,890 --> 00:20:25,950
فجعلتُ أخي ينهي اللعبة لي

302
00:20:26,800 --> 00:20:28,350
أنا ذاهبٌ إذاً

303
00:20:30,400 --> 00:20:33,870
حسناً، سأدعو لنصرك يا يوليوس-ساما

304
00:20:38,070 --> 00:20:40,050
هذا مُضنٍّ

305
00:20:40,050 --> 00:20:44,760
التظاهر بشخصيّة البطلة الصالحة
المتفائلة أمرٌ متعب بحقّ

306
00:20:45,440 --> 00:20:48,300
لكنّي لن أترك الأمر ينتهي هنا

307
00:20:48,640 --> 00:20:51,540
!لن أدع شخصيّة الموب تلك تهزمني

308
00:20:52,390 --> 00:20:53,880
!أيّها الأمير

309
00:20:53,880 --> 00:20:55,530
!أنت لها

310
00:20:55,530 --> 00:20:58,020
!اهزم ذاك الريفيّ

311
00:20:59,130 --> 00:21:00,450
يا للبؤس

312
00:21:00,790 --> 00:21:03,940
لا يزالون يتوقّعون فوز الأمير بعد
المعارك التعيسة التي شهدوها

313
00:21:04,450 --> 00:21:06,610
لا يزال الأمير ورفاقه طلّاب سنة أولى

314
00:21:06,610 --> 00:21:11,450
سيصبحون أقوى في المستقبل، لكنّي الأقوى الآن

315
00:21:13,690 --> 00:21:17,990
لم يخطر لي أن يأتي دوري

316
00:21:18,450 --> 00:21:21,210
أحترم جهدك في القتال
حتّى تصل إلى هنا

317
00:21:22,330 --> 00:21:24,720
هل لي أن أسألك عن أمر؟

318
00:21:25,540 --> 00:21:27,720
إذا بإمكاني الإجابة عليه، فسأفعل

319
00:21:27,980 --> 00:21:31,680
ما رأيك بطالبة المنحة الدراسيّة، أوليفيا-سان؟

320
00:21:32,220 --> 00:21:36,950
أوليفيا؟ بالكاد تكلّمنا، فلا رأي لي عنها

321
00:21:37,460 --> 00:21:40,230
سمعت أنّها تدرس باجتهاد

322
00:21:41,060 --> 00:21:42,490
فهمت

323
00:21:47,190 --> 00:21:48,990
!ابدآ أيّها البطلان

324
00:21:48,990 --> 00:21:51,490
!أيّها الأمير

325
00:21:48,990 --> 00:21:51,490
!أنت لها

326
00:23:26,560 --> 00:23:29,010
...براد، غريغ، كريس، جيلك

327
00:23:29,010 --> 00:23:30,570
بلاءٌ حسن جميعاً

328
00:23:30,570 --> 00:23:33,140
أنت الصامد الأخير سموّ الأمير، ما هو شعورك؟

329
00:23:33,140 --> 00:23:34,480
أخبرنا، كيف شعورك الآن؟

330
00:23:34,480 --> 00:23:35,850
الحلقة القادمة: هذا رائع

331
00:23:35,850 --> 00:23:38,540
سأحمل مشاعر الجميع إلى معركتي معك

332
00:23:38,540 --> 00:23:40,980
بناءً على حوارنا فحسب، تبدو كالبطل أكثر