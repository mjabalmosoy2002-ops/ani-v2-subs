1
00:02:30,770 --> 00:02:38,720
47
.الإنقلاب الكبير ! إنطلاق الهجوم المزدوج لـ [ غوكو ] و [ رقم 18 ]

2
00:02:56,510 --> 00:02:59,180
! آ .. آنسة [ فيّدل ]

3
00:02:59,180 --> 00:03:01,180
! حـ .. حلقيّ أقلّ قليّلاً

4
00:03:01,180 --> 00:03:02,200
! حاضر

5
00:03:07,850 --> 00:03:11,190
! أنتيّ ! لا تنخفضيّ هكذا فجأة

6
00:03:11,190 --> 00:03:13,380
... حـ .. حاضر

7
00:03:15,860 --> 00:03:18,950
! لا ترتفعيّ هكذا

8
00:03:25,870 --> 00:03:29,870
.لم أعتقد أبداً أنهما حقّاً ستذهبان للقتال

9
00:03:29,870 --> 00:03:32,310
كلاهما لابُدّ أن لديّهما دمٌ لا يهدأ

10
00:03:32,310 --> 00:03:34,110
.من شبابهم بدأ يظهر مرّةٌ أخرى

11
00:03:57,500 --> 00:04:00,870
ما الذيّ يجري هنا بحقّ ؟

12
00:04:29,530 --> 00:04:32,740
.لا يُمكنُك إستخدام الكاميّهاميّا الخاصةُ بك, ولكماتك لا تصلّ

13
00:04:32,740 --> 00:04:35,900
! أنت خاسر يا [ سون غوكو ]

14
00:04:47,880 --> 00:04:51,490
! أ .. أنا لن أخسر

15
00:04:51,490 --> 00:04:54,850
!! " Dengeki Jigoku-Dama " ! تلقّى هذه

16
00:05:06,170 --> 00:05:08,400
! أنا لن أخسر

17
00:05:15,180 --> 00:05:16,180
ماذا !؟

18
00:05:16,180 --> 00:05:18,510
! أ .. أتركنيّ

19
00:05:18,510 --> 00:05:20,850
! مستحيل

20
00:05:20,850 --> 00:05:24,850
لا يزال لديّك الكثير من الطاقة المتبقيّة, أليّس كذلك ؟

21
00:05:27,990 --> 00:05:32,200
! ولا تستطيع إلتقاط ذبذبات إنتقاليّ الفوريّ جيّداً

22
00:05:32,200 --> 00:05:36,870
والآن, لا يُمكنُك توجيّه أيّ لكمات أو إطلاق طلقات الطاقة, هل أنا محقّ !؟

23
00:05:36,870 --> 00:05:39,040
.الشخص الوحيد الأحمق هنا هو أنت

24
00:05:39,040 --> 00:05:43,540
وأنت أيّضاً لا يُمكنك الهجوم هكذا, أليّس كذلك ؟

25
00:05:43,540 --> 00:05:44,540
! لا يمكن أن تعنيّ

26
00:05:44,540 --> 00:05:47,540
! ربما أعنيّ ذلك

27
00:05:47,540 --> 00:05:49,940
أ .. أتُفكّرُ بتفجير نفسك !؟

28
00:05:50,810 --> 00:05:53,850
.تفجير نفسيّ ؟ حسنٌ, ربما أفكّر فيّ ذلك

29
00:05:53,850 --> 00:05:57,410
! ولكن الآن, هذا هو الشيّء الوحيد الذيّ وصلتُ إليّه

30
00:06:02,160 --> 00:06:05,830
! أ .. أتركنيّ ! وتوقف عن لمسيّ

31
00:06:05,830 --> 00:06:07,600
! أنا لا أُريد أن ألمسك بنفسيّ

32
00:06:07,600 --> 00:06:10,830
! ولكن كما قلت, هذا هو الشيّء الوحيد الذيّ أُفكر به

33
00:06:10,830 --> 00:06:13,840
!! أتركنيّ

34
00:06:13,840 --> 00:06:17,360
!!  هيّا بنا ! طاقة القوّة الكاملة

35
00:06:30,190 --> 00:06:34,120
! [ رقم 17 ]

36
00:07:03,820 --> 00:07:07,690
! [ كـ .. كاكاروتّو ] ! أيّها الحقير

37
00:07:12,160 --> 00:07:13,530
! وعائيّ

38
00:07:17,830 --> 00:07:19,700
! بحقّ

39
00:07:53,140 --> 00:07:54,730
... [ رقم 17 ]

40
00:08:18,830 --> 00:08:20,560
... لقد توقّعت

41
00:08:33,180 --> 00:08:36,180
! هذا مدهش ! هذا مدهش يا [ رقم 17 ]

42
00:08:36,180 --> 00:08:39,270
! أنت حقّاً شخصٌ ذو شأن أيّضاً

43
00:08:42,190 --> 00:08:44,420
.تلك كانت شيّءٌ خطير بالفعل

44
00:08:44,420 --> 00:08:47,760
,إذا تأخرتُ قليّلاً فيّ نصب درعيّ

45
00:08:47,760 --> 00:08:50,790
! لكان قد قضيّ عليّ

46
00:08:50,790 --> 00:08:55,800
.هل هذا صحيح ؟ إذاً لقد فعلتُ شيّئاً مؤسفاً

47
00:08:55,800 --> 00:08:59,130
! والفضل يعود إليّك, ملابسيّ قد دُمّرت

48
00:09:00,470 --> 00:09:03,870
.ولكن لا تزال جيّده عليّك

49
00:09:13,820 --> 00:09:17,980
! لم تعُدّ لديّ طاقة متبقيّة حتى أُحرّك إصبعيّ

50
00:09:20,490 --> 00:09:22,650
! أنت لن تلمسنيّ أبداً مرّةٌ أُخرى

51
00:09:29,170 --> 00:09:32,500
! أنت بالتأكيد شخصٌ قويّ

52
00:09:32,500 --> 00:09:37,170
! إقضيّ عليّه ! إقضيّ عليّه يا [ رقم 17 ] ! أسرع وأقتل [ غوكو ]

53
00:09:37,170 --> 00:09:40,510
! عُدّ إلى الجحيم يا [ سون غوكو ]

54
00:09:40,510 --> 00:09:42,380
! توقّف يا [ رقم 17 ]

55
00:09:46,850 --> 00:09:49,780
أ .. أنتيّ ! [ رقم 18 ] ؟

56
00:09:52,120 --> 00:09:55,320
! مرحباً ! ألستيّ أنتيّ [ رقم 18 ]

57
00:10:00,130 --> 00:10:05,930
! أنت ... كيّف تجرؤ على فعل ذلك لـ [ كوريّريّن ] ... كيّف تجرؤ على قتل [ كوريّريّن ]

58
00:10:07,140 --> 00:10:08,830
[ كوريّريّن ] !؟

59
00:10:11,140 --> 00:10:15,340
! لن تفلُت من ذلك ! أنا لن أسمح لك بالإفلات من ذلك

60
00:10:16,480 --> 00:10:20,480
! من كان يعتقد بأنك مازلتيّ على قيّد الحياة ! يا لكيّ من عنيّدة

61
00:10:20,480 --> 00:10:25,440
! أنظر إلى من يتكلم عن بقائيّ على قيّد الحياة ! أنا أعلم

62
00:10:27,820 --> 00:10:32,830
.فيّ ذلك الوقت, لقد كبحت نفسك فيّ آخر, آخر لحظة

63
00:10:32,830 --> 00:10:36,830
لقد كُنت خائفاً من الأداة المتفجّرة بداخل جسديّ, صحيح ؟

64
00:10:36,830 --> 00:10:40,840
,أنت تعلمُ بأن لديّ أداة متفجّرة بداخل جسديّ

65
00:10:40,840 --> 00:10:42,970
,وكُنت خائفاً من أن القنبلة قد تنفجر

66
00:10:42,970 --> 00:10:46,100
! لذلك أنت تجنّبت مؤشراتيّ الحيويّة عن قصد

67
00:10:48,110 --> 00:10:53,070
! إذا إنفجرت فيّ ذلك النطاق, فإنك لن تخرج سالماً

68
00:10:53,780 --> 00:10:55,590
ما الذيّ تتحدث عنه ؟ قنبلة ؟

69
00:10:55,590 --> 00:11:01,420
هل تعنيّ تلك التيّ كانت بداخل جسد [ رقم 18 ] فيّ ذلك الوقت ؟

70
00:11:02,120 --> 00:11:06,960
... ولكن تلك كان من المفترض أن أزالها [ شيّنلونغ ] منذ فترة طويلة

71
00:11:09,130 --> 00:11:13,590
! هكذا إذاً ! [ رقم 17 ] لا يعلم عن ذلك

72
00:11:17,140 --> 00:11:21,480
! أحسنتيّ عملاً يا [ رقم 18 ] ! هذه حيلة مذهلة

73
00:11:21,480 --> 00:11:25,250
! أنا سوف أنتقم لـ [ كوريّريّن ] ! هيّا يا [ رقم 17 ]

74
00:11:25,250 --> 00:11:29,150
! إذا كُنت تريد تفجير [ غوكو ], إذاً عليّك أن تُفجّرنيّ معه

75
00:11:56,890 --> 00:11:59,400
! هيّا ! أطلق عليّ, إذا كُنت تستطيع ذلك

76
00:11:59,400 --> 00:12:03,800
! ولكن إذا فعلت ذلك, الجميع هنا بالتأكيد سوف يتناثرون بعيّداً

77
00:12:06,570 --> 00:12:09,040
هل لا تزالُ لديّك الشجاعة للإطلاق ؟

78
00:12:09,040 --> 00:12:13,910
! لا, أشك فيّ أن تفعل ذلك أيّها الجبان

79
00:12:13,910 --> 00:12:18,920
! هل هذا هو حجم خوّفك من هذه القنبلة ؟ أنت حقّاً جبان

80
00:12:18,920 --> 00:12:25,150
! توقفيّ عن هذا يا [ رقم 18 ] ! إذا لم تتركيّ الأمر عند هذا الحد, فسوف يُطلق بالفعل

81
00:12:33,260 --> 00:12:37,930
,من ماذا أنت خائف !؟ حتى لوّ كانت قنبلة السيّدة الصغيّرة ستنفجر

82
00:12:37,930 --> 00:12:43,840
! فإنه لا ينبغيّ أن يزعجك على الأقل ! أسرع وفجّر هؤلاء الأشخاص

83
00:12:44,940 --> 00:12:47,940
! أنا لستُ خائفاً من أيّ قنبلة

84
00:12:47,940 --> 00:12:50,210
فيّ هذه الحالة, لماذا لا تُطلق ؟

85
00:12:50,210 --> 00:12:53,280
! أنت مثير للشفقة, لا تقدّم شيّئاً سوى الأعذار

86
00:12:53,280 --> 00:12:57,220
! لا بأس, أمضيّ وفجّرها مع [ غوكو ]

87
00:12:57,220 --> 00:13:00,190
! أنا لستُ مثيراً للشفقة, ولستُ جباناً

88
00:13:20,240 --> 00:13:23,250
! أنا لستُ جباناً

89
00:13:23,250 --> 00:13:25,550
إذاً أخيراً عُدت إلى عقلك, أليّس كذلك !؟

90
00:13:25,550 --> 00:13:30,780
! ولكن, أنا لن أنتظر هنا صامته ويقضى عليّ

91
00:13:59,220 --> 00:14:03,890
! لا تُطلقيّ يا [ رقم 18 ] ! كُلّ ما تفعليّنه هو زيادة قوّته

92
00:14:03,890 --> 00:14:07,890
! أنا بالتأكيد سوف أنتقم لـ [ كوريّريّن ]

93
00:14:07,890 --> 00:14:12,290
! هذا سهلٌ عليّك قوّله, ولكن لا يُمكنُك فعل ذلك بنفسك يا [ رقم 18 ]

94
00:14:19,240 --> 00:14:25,240
... هكذا إذاً ! إنه يتخذ هذه الوضعيّة من أجل أن يمتصّ الطاقة

95
00:14:25,240 --> 00:14:30,280
ماذا ؟ بيّنما هو يمتصّ الطاقة, يترك نفسه مفتوحاً, أليّس كذلك !؟

96
00:14:30,280 --> 00:14:31,920
! حسنٌ

97
00:14:31,920 --> 00:14:37,410
! يا [ رقم 18 ], أطلقيّ عليّه ! أطلقيّ عليّه, أطلقيّ عليّه, أطلقيّ عليّه بشدّة

98
00:14:44,930 --> 00:14:49,530
! مهما كانت عدد طلقات الطاقة التيّ تطلقينها عليّ, إنها فقط تزيد قوّتيّ

99
00:14:49,530 --> 00:14:53,200
ما الذيّ ستفعلونه معيّ عندما أزداد قوّتاً أكثر فأكثر, أيّها الحمقى !؟

100
00:14:53,200 --> 00:14:55,140
! حسنٌ الآن

101
00:14:57,210 --> 00:14:58,210
! أنت الأحمق الآن

102
00:14:58,210 --> 00:14:59,200
ماذا !؟

103
00:15:04,210 --> 00:15:07,180
!! إنفجار " ريو-كين "

104
00:15:14,220 --> 00:15:17,560
! الـ .. اللعنة

105
00:15:17,560 --> 00:15:20,230
...  كا ... ميّ

106
00:15:20,230 --> 00:15:23,230
.. . ها ... ميّ

107
00:15:23,230 --> 00:15:28,570
! أ .. أنا فقط سأمتصّ هذه

108
00:15:28,570 --> 00:15:31,970
! ! لقد تأخّرت كثيّراً لهذا ! هاا

109
00:15:33,240 --> 00:15:34,730
! ! هاا

110
00:15:35,910 --> 00:15:37,440
!! هاا

111
00:15:41,920 --> 00:15:43,910
! لقد فعلناها يا [ كوريّريّن ]

112
00:16:21,220 --> 00:16:23,520
! لقد فعلتها يا [ كاكاروتّو ]

113
00:16:43,250 --> 00:16:49,850
[ رقم 17 ], لماذا قتلت [ كوريّريّن ] ؟ ما الذيّ حدث لك بحقّ ؟

114
00:16:50,520 --> 00:16:52,690
.إنه ليّس ذنب [ رقم 17 ]

115
00:16:52,690 --> 00:16:58,790
.[ رقم 17 ] كان يُستغلّ من قبل [ غيّرو ] و [ ميو ], مسيّطراً عليّه من قبل طموحاتهم

116
00:16:59,530 --> 00:17:03,260
.إنه ... كان يعلم حقّاً بذلك

117
00:17:04,200 --> 00:17:09,210
أنه لا توجد أيّ قنبلة بداخلك ؟

118
00:17:09,210 --> 00:17:10,870
مـ .. ماذا !؟

119
00:17:10,870 --> 00:17:14,040
! ولكن لماذا !؟ ليّس هناك سبب لفعله ذلك

120
00:17:14,040 --> 00:17:18,210
... بالتأكيد, لقد تجنّب مؤشراتيّ الحيويّة, لذلك

121
00:17:18,210 --> 00:17:21,320
.لقد تمّ غسل دماغه من قبل الأشخاص الأشرار

122
00:17:21,320 --> 00:17:23,890
,ولكن على الرغم من أنه يبدو وكأنه كان تحت سيّطرتهم بالكامل

123
00:17:23,890 --> 00:17:26,990
,ربما كان فقط لا يُودّ أن يواجهك أنتيّ بصدق

124
00:17:26,990 --> 00:17:28,650
.شقيقته التوأم

125
00:17:29,890 --> 00:17:32,880
... ولهذ السبب, فيّ النهاية, لم يتمكن من الإطلاق

126
00:17:39,900 --> 00:17:45,200
أنا لا أعلم. ولكن أنتيّ بالتأكيد تعتقديّن ذلك, صحيح ؟

127
00:17:49,510 --> 00:17:50,480
صحيح ؟

128
00:17:55,520 --> 00:18:00,290
أنتم ! أيّن هم الأشخاص الأشرار !؟

129
00:18:04,860 --> 00:18:07,530
! لن نسمح بالشرّ فيّ عالمنا

130
00:18:07,530 --> 00:18:08,900
! نعم, نعم

131
00:18:10,530 --> 00:18:15,330
! ما الذيّ تفعلونه !؟ لقد إهتميّنا بالفعل بالأشخاص الأشرار

132
00:18:17,210 --> 00:18:22,970
... هـ .. هل هذا صحيح ؟ هذا هو [ غوكو ], يؤديّ عمله سريّعاً فيّ كُلّ شيّء

133
00:18:25,550 --> 00:18:28,220
! أنت هناك يا [ سون ] ! هذه مصيبة

134
00:18:28,220 --> 00:18:30,750
! المدن فيّ جميع أنحاء المكان فيّ حالة من الدمار

135
00:18:30,750 --> 00:18:33,560
! البراكيّن إنفجرت, وفيضانات تحدث

136
00:18:33,560 --> 00:18:36,230
! وهناك أشياء فظيعة تحدث فيّ جميع أنحاء العالم

137
00:18:36,230 --> 00:18:38,860
أنا متأكدة من أنه ذنب أولئك الأشخاص الأشرار لربطهم هذا العالم و

138
00:18:38,860 --> 00:18:40,900
! العالم الآخر وأصبح كُلّ شيّء يتصرف بغرابه

139
00:18:40,900 --> 00:18:43,170
فيّ هذه الحالة, كُلّ ما نحتاج فعله هو تمنيّ أمنيّه لكرات التنين

140
00:18:43,170 --> 00:18:44,900
.لإعادة كُلّ شيّء إلى ما كان عليّه من قبل

141
00:18:44,900 --> 00:18:48,500
.أنتيّ محقّة. وعليّنا إعادة [ كوريّريّن ] إلى الحياة أيّضاً

142
00:18:48,500 --> 00:18:53,840
.شكراً. على الرغم من كُلّ شيّءٍ آخر, إنه زوجيّ. سأترك الأمر لك

143
00:18:53,840 --> 00:18:59,180
! حسنٌ, إذاً دعونا نبحث عن كرات التنين فيّ الحال

144
00:18:59,180 --> 00:19:04,450
.بعد الأزمة الخطيرة, [ غوكو ] أخيراً هزم [ رقم 17 ] الخارق

145
00:19:04,850 --> 00:19:08,360
جميع الأشرار الذيّن عادوا من الجحيم قد

146
00:19:08,360 --> 00:19:09,860
.هزموا مرّةٌ أخرى عن طريق [ غوكو ] والآخرين

147
00:19:09,860 --> 00:19:12,330
.وبعد ذلك ذهبوا إلى الجحيم

148
00:19:13,860 --> 00:19:19,870
,بعد ذلك بوقتٍ قصير, [ غوكو ], [ بان ]
,و [ ترانكس ] غادروا فيّ رحلة للبحث عن كرات التنين

149
00:19:19,870 --> 00:19:22,440
,من أجل إعادة [ كوريّريّن ] إلى الحياة

150
00:19:22,440 --> 00:19:25,710
فضلاً عن إعادة جميع المدن المدمّرة

151
00:19:25,710 --> 00:19:27,370
.والطبيعة إلى وضعها الطبيعيّ

152
00:19:30,210 --> 00:19:33,280
,وبالتاليّ, تمّ حلّ كُلّ شيّء بسلام

153
00:19:33,280 --> 00:19:37,280
... وإعتقد الجميع أن السلام قد حلّ مرّةٌ أخرى

154
00:19:37,890 --> 00:19:39,010
! أنت تمزح

155
00:20:07,180 --> 00:20:12,350
.التشقُّقات التيّ ظهرت على كرات التنين ... هذه هيّ المرّة الأولى

156
00:20:12,860 --> 00:20:16,860
.بطريقةٍ ما, لديّ إحساس بالتشاؤم حول هذا

157
00:20:16,860 --> 00:20:21,300
! لـ .. لا تقوليّ هذا يا جدتيّ ! هذه كرات التنين بعد كُلّ شيّء

158
00:20:21,300 --> 00:20:25,200
.ليّس هناك سببٌ يدعوكيّ بالتشاؤم حولها

159
00:20:25,200 --> 00:20:27,670
.فيّ هذه الحالة, دعونا نحاول إستدعاء [ شيّنلونغ ]

160
00:20:27,670 --> 00:20:31,330
.ربما [ شيّنلونغ ] يعرف شيّئاً حول هذا

161
00:20:31,870 --> 00:20:35,650
أ .. أنت محقّ. وإلى جانب ذلك, إعادة السيّد [ كوريّريّن ] و

162
00:20:35,650 --> 00:20:38,550
,الناس من المدن إلى الحياة

163
00:20:38,550 --> 00:20:41,570
.وإعادة الأرض إلى وضعها الطبيعيّ يأتيّ أولاً

164
00:20:44,220 --> 00:20:48,050
! حسنٌ ! إخرج يا [ شيّنلونغ ]

165
00:20:53,830 --> 00:20:58,170
هـ .. هل أخطأت فيّ التعويذة أو شيّءٌ من هذا ؟

166
00:20:58,170 --> 00:21:01,500
.لا, لقد كانت صحيحة بالتأكيد

167
00:21:01,500 --> 00:21:05,700
... هذه الأرض, لذلك نحن لا نحتاج للتحدث بلغة الناميّكسيّجيّن

168
00:21:08,510 --> 00:21:11,070
! حسنٌ ! إخرج يا [ شيّنلونغ ]

169
00:21:21,190 --> 00:21:22,190
! حسنٌ

170
00:21:22,190 --> 00:21:24,130
! إخرج يا [ شيّنلونغ ]

171
00:21:36,210 --> 00:21:37,210
ز .. زلزال ؟

172
00:21:37,210 --> 00:21:40,210
! هـ .. هناك شيّءٌ مختلف غيّر عاديّ حول هذا

173
00:21:40,210 --> 00:21:42,870
! أنا أشعر بطاقة شر لا تُصدّق

174
00:21:56,890 --> 00:21:58,520
ما هذا ؟

175
00:22:02,900 --> 00:22:05,970
ما هذا الذيّ يخرج من داخل

176
00:22:05,970 --> 00:22:09,910
كرات التنين المُتشقّقة بدلاً من [ شيّنلونغ ] ؟

177
00:22:09,910 --> 00:22:13,440
إنها ممتلئة بطاقة شريّرة,مثلها لم يعهدها [ غوكو ] و

178
00:22:13,440 --> 00:22:14,910
! والآخرين من قبل

179
00:22:14,910 --> 00:22:19,900
.حاليّاً, خطر عظيّم أبعد من الخيال يقترب منهم

180
00:22:22,250 --> 00:22:25,020
من أنت بحقّ !؟