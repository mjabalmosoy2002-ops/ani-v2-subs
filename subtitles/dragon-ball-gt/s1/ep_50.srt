1
00:03:12,750 --> 00:03:20,760
50
.قوّة السيّاجيّن تتفوّق !؟ الوحش الكهربائيّ [ شيّنلونغ الخامس ]

2
00:03:30,840 --> 00:03:32,840
! إنّها لذيّذ

3
00:03:32,840 --> 00:03:34,770
هل أنت متأكد من أنّه لا بأس ؟

4
00:03:34,770 --> 00:03:36,730
! يجب أن تشربيّ أيّضاً يا [ بان ]

5
00:03:44,190 --> 00:03:48,750
.فيّ النهاية لا أُريّد. أنا أكره ذلك عندما تضطربُ معدتيّ

6
00:04:02,050 --> 00:04:03,750
... قوليّ يا جديّ

7
00:04:05,470 --> 00:04:10,490
.الكرة ذات النجمتيّن عادت لطبيّعتها مثلما عادت الأرض

8
00:04:11,650 --> 00:04:15,530
... وهو ما يعنيّ بما أنّ هناك سبع كرات تنيّن بالكامل

9
00:04:15,870 --> 00:04:18,050
1 ... 2 ... 3 ... 4 ...

10
00:04:18,150 --> 00:04:20,270
,بعد أنّ نهزم الستّة الأخريّن من هؤلاء الأشخاص

11
00:04:20,310 --> 00:04:22,370
الأرض ستعود كما كانت ؟

12
00:04:22,630 --> 00:04:25,310
! أحسنت صنعاً يا جديّ

13
00:04:25,550 --> 00:04:27,950
! ماذا, لقد كان هذا سهلاً

14
00:04:28,110 --> 00:04:31,490
! لا يوجد أيّ سبب يمنعُنيّ من القضاء على الستّةِ كُلُّهم معاً

15
00:04:31,610 --> 00:04:35,370
! وأنا أيّضاً طالما لديّ [ غيّل ] هنا, يُمكنُنيّ التعامل معهم أكثر بنفسيّ

16
00:04:35,670 --> 00:04:39,390
! إذا أردت يا جديّ, يُمكنُك العودة أوّلاً

17
00:04:40,530 --> 00:04:45,340
! لوحديّ مع [ بان ], الخطر يرتفع ! الخطر يرتفع

18
00:04:51,770 --> 00:04:54,250
! هيّا الآن, إبتهجوا

19
00:04:54,710 --> 00:04:57,090
.أنا متأكده من أنّ [ سون ] قادرٌ على التصرّف

20
00:04:58,570 --> 00:05:00,010
... إعذُريّنيّ

21
00:05:05,150 --> 00:05:08,070
! لقد إكتفيّت من تلك [ بان ], تذهبُ من دون أن تقول أيّ شيّء

22
00:05:08,350 --> 00:05:10,110
! عندما ترجع, سوف تُعاقب

23
00:05:10,350 --> 00:05:12,650
! [ غوكو ], نحن نعتمد عليّك

24
00:05:19,710 --> 00:05:22,430
قوليّ يا [ غيّل ], ألم نصلّ بعد ؟

25
00:05:22,750 --> 00:05:25,590
! تمّ إلتقاط كرة التنيّن ! تمّ إلتقاط كرة التنيّن

26
00:05:25,750 --> 00:05:27,390
! واحد كيّلو للأمام

27
00:05:31,150 --> 00:05:33,920
تلك المديّنة ؟

28
00:05:35,290 --> 00:05:41,830
! أُريّد بعض العصيّر ! أُريّد بعض العصيّر للشرب ! عصيّر -
!... فهمت, توقفيّ -

29
00:05:55,910 --> 00:05:58,950
! جديّ, إنّها إشارة حمراء

30
00:06:04,050 --> 00:06:08,190
.ما الذيّ يحدث مع هذه المديّنة ؟ لا يوجد أيّ شخصٍ هنا

31
00:06:12,830 --> 00:06:17,530
! عصيّر ! عصيّر ! أيّ واحد يجب عليّ أن أختار ؟ هذا

32
00:06:19,950 --> 00:06:22,570
ما الأمر !؟ هل تحطّمت !؟

33
00:06:29,370 --> 00:06:32,050
قوليّ يا [ غيّل ], كرة التنيّن فيّ أيّ إتجاه ؟

34
00:06:33,550 --> 00:06:36,420
... 30درجة للأمام, المدى

35
00:06:37,590 --> 00:06:38,510
ما الأمر يا [ بان ] !؟

36
00:06:38,770 --> 00:06:42,260
! جديّ, هناك

37
00:06:50,990 --> 00:06:53,550
! ما هذا ؟ إنّه مقرف

38
00:07:17,710 --> 00:07:19,610
ما أمرُ هذه المديّنة !؟

39
00:07:20,370 --> 00:07:23,330
.إنّه يمتصّ الكهرباء

40
00:07:23,810 --> 00:07:29,310
.هذا الشيّء ظهر فجأة وبدأ بإمتصاص جميّع الطاقة الكهربائيّة لهذه المديّنة

41
00:07:29,350 --> 00:07:35,050
.لقد كان مخيّفاً حتى أنّ جميّع الناس فيّ المديّنة قد ذهبوا إلى مكانٍ ما آخر

42
00:07:35,370 --> 00:07:39,530
خذيّ. إنّه ليّس باردٌ جدّاً, ولكنّكي تشعريّن بالعطش, صحيّح ؟

43
00:07:39,630 --> 00:07:40,570
! شكراً لكيّ

44
00:07:40,790 --> 00:07:44,190
.نحن آخر المتبقيّين. بعدنا, لا يوجد أحدٌ متبقيّ

45
00:07:44,550 --> 00:07:47,730
.وأنتم يا رفاق يجب عليّكم المغادرة بسرعة أيّضاً

46
00:07:47,830 --> 00:07:50,770
أيمتصّ جميّع الطاقة الكهربائيّة في المديّنة ؟

47
00:08:11,370 --> 00:08:14,990
! لـ .. لا تقترب ! إنّه مقرف

48
00:08:15,050 --> 00:08:19,430
أحقّاً ذلك ؟ إنّه مرنٌ جدّاً, ولطيّف, أليّس كذلك ؟

49
00:08:19,850 --> 00:08:23,560
! كرة التنيّن تقترب ! إنّها تقترب

50
00:08:25,690 --> 00:08:28,110
! لقد كُنتُ فيّ إنتظارك يا [ سون غوكو ]

51
00:08:28,650 --> 00:08:30,490
.إسمي هو [ شيّنلونغ الخامس ]

52
00:08:30,790 --> 00:08:34,150
.[ غوكو ], قضاؤك على [ شيّنلونغ الثانيّ ] قد كان مثيّراً للإعجاب

53
00:08:34,450 --> 00:08:38,570
.ومع ذلك, لقد كان الأضعف من بيّن تنانيّن الشرّ

54
00:08:38,830 --> 00:08:40,470
وماذا عنك ؟

55
00:08:41,930 --> 00:08:43,390
.أنّت لستُ بحاجةٍ لتسأل حتّى

56
00:08:44,030 --> 00:08:49,430
! من الواضح أنّنيّ الأقوى من بيّن تنانيّن الشرّ السبعة

57
00:08:49,670 --> 00:08:54,290
.هل هذا صحيّح ؟ أنّت لا تبدو كذلك ليّ, ويؤسفنيّ قول ذلك

58
00:08:55,450 --> 00:08:58,930
.جديّ, يجب عليّك أنّ لا تحكم على الشخص من خلال مظهره

59
00:08:59,450 --> 00:09:01,350
إنّه ليّس بشخص, صحيّح ؟

60
00:09:02,830 --> 00:09:06,810
! سوف أُريّكم ما الذيّ يحدث عندما أشعرُ بالغضب

61
00:09:07,190 --> 00:09:09,490
!! إنطلق أيّها الوحل الكهربائيّ

62
00:09:18,610 --> 00:09:22,290
! أوقف هذا ! إنّه مقرف

63
00:09:38,270 --> 00:09:39,690
.لقد كان ذلك سهلاً للغايّة

64
00:09:41,850 --> 00:09:43,410
[ بان ], هل أنتيّ بخيّر ؟

65
00:09:43,490 --> 00:09:45,930
.ما زلتُ أشعرُ ببعض التخدّر

66
00:09:48,230 --> 00:09:50,530
! لم يكنّ ذلك أكثر من لعب الأطفال

67
00:09:54,670 --> 00:09:58,360
! إتحدّ أيّها الوحل ! وتفاقم

68
00:10:17,290 --> 00:10:20,030
! والآن أصبحت ضخماً جدّاً

69
00:10:23,310 --> 00:10:26,410
! أنت مقرف بشكلٍ لا يُصدّق

70
00:10:26,650 --> 00:10:33,350
[ غوكو ], هل تتذكّر ؟ عندما [ فيّجيّتا ] و [ نابّا ] أتيا لمهاجمة الأرض ؟

71
00:10:33,750 --> 00:10:36,770
! إرتجفت قبل هجومهم يا [ غوكو ]

72
00:10:40,970 --> 00:10:45,390
إستخدمت كرات التنيّن لجلبك إلى الحياة, صحيّح ؟

73
00:10:48,730 --> 00:10:52,710
.لقد وٌلدّت من الطاقة السالبة فيّ ذلك الوقت

74
00:10:53,090 --> 00:10:57,190
.هل هذا صحيّح ؟ فيّ هذه الحالة, نحن نوّعاً ما مثل الأخوة

75
00:10:58,690 --> 00:11:02,370
.أمزح الآن, بيّنما يُمكنُك ذلك

76
00:11:04,510 --> 00:11:05,990
! مُتّ يا [ غوكو ]

77
00:11:06,330 --> 00:11:09,490
" !!دراغون ثاندر "

78
00:11:11,690 --> 00:11:13,970
هل أنت بخيّر يا جديّ !؟

79
00:11:15,990 --> 00:11:18,930
! الكهرباء مخيّفة ! إنّها مخيّفة ! أفرغها, وسينتهيّ كُلّ شيّء

80
00:11:18,990 --> 00:11:21,370
! أمسك بالخشب ! أمسك بالخشب

81
00:11:22,810 --> 00:11:24,790
! لقد فعلتها أيّها الحقيّر

82
00:11:25,390 --> 00:11:32,650
" !!دراغون ثاندر "

83
00:11:40,490 --> 00:11:42,190
! لكمتيّ قد دُفنت بالداخل

84
00:11:42,410 --> 00:11:46,860
" !!دراغون ثاندر " " ! الآن

85
00:11:55,670 --> 00:11:58,750
" !!دراغون ثاندر "

86
00:12:07,090 --> 00:12:09,190
! إنّهم حتى ليّسوا جيّديّن بقدر كلامهم

87
00:12:09,230 --> 00:12:10,170
.سنرى بشأن ذلك

88
00:12:10,250 --> 00:12:11,670
ماذا ؟

89
00:12:45,290 --> 00:12:48,530
هل إعتقدت بأنّنيّ سأتفاجئ بتفاخرك ؟

90
00:12:50,270 --> 00:12:53,350
هل تريّد أن تُجرّبنيّ, لترى بأنّنيّ أتفاخر ؟

91
00:12:57,750 --> 00:13:00,190
" !!دراغون ثاندر "

92
00:13:05,190 --> 00:13:08,130
.إنّها توخز, شعورٌ جيّد

93
00:13:09,490 --> 00:13:11,970
مـ .. ما الذيّ قلته !؟

94
00:13:22,830 --> 00:13:24,110
! جديّ

95
00:13:24,550 --> 00:13:29,850
.والآن إذاً, ليّس لديّ الكثيّر من الوقت لكيّ ألعب معك

96
00:13:30,290 --> 00:13:33,830
.ما زال أماميّ خمسة آخريّن مثلك لكيّ ألحقهم بعد هذا

97
00:13:36,310 --> 00:13:39,550
.آسف, ولكن لا بُدّ ليّ من أن أُنهيّك على الفور

98
00:13:41,490 --> 00:13:43,010
! لن أسمح لك

99
00:13:43,510 --> 00:13:47,690
!! " كامي هامي" عشرة أضعاف

100
00:14:07,330 --> 00:14:11,950
! يا لها من كذبة ! أرأيّت, أنت كُنت تتفاخر بعد كُلّ شيّء

101
00:14:12,690 --> 00:14:17,490
! الخاصة بيّ " Kamehame-Ha " لـ .. لقد أمسك بالعشرة أضعاف

102
00:14:18,090 --> 00:14:19,670
... مـ .. مستحيّل

103
00:14:19,790 --> 00:14:23,010
! سأعيّدُها إليّك ! إمسكها جيّداً

104
00:14:23,130 --> 00:14:26,570
!! " كرة كامي هامي " عشرة أضعاف

105
00:14:35,850 --> 00:14:42,330
! هل تعلّمت الدرس يا [ سون غوكو ] !؟ أنت لم تكن ندّاً ليّ

106
00:14:57,310 --> 00:15:02,150
! يُقضى عليّ بحركتي الخاصّة القاضيّة هكذا, لم يكن رائعاً ليّ

107
00:15:07,750 --> 00:15:10,350
! هذا ليّس بعد هو حجم قوّتيّ

108
00:15:10,490 --> 00:15:14,530
! أنا أقوى بكثيّرٍ, بكثيّرٍ من ذلك ! شاهد

109
00:15:27,250 --> 00:15:31,750
! ما رأيُّك ؟ أنا أمتلئُ بالطاقةِ سريّعاً

110
00:15:32,470 --> 00:15:36,770
! أنت تمزح ! إنّه يزداد ضخامةً أكثر

111
00:15:44,130 --> 00:15:46,990
! توقفيّ يا [ بان ] ! سوف يقضى عليّكيّ

112
00:15:50,050 --> 00:15:53,630
! أّيّتها الحمقاء ! مهما فعلتيّ سيبقى الأمر كما هو

113
00:16:27,290 --> 00:16:31,290
! أنظروا ! جميّع الطاقة الكهربائيّة للأرض هيّ ليّ

114
00:16:31,570 --> 00:16:33,190
! إنّه شخصٌ لا يُصدّق

115
00:16:37,330 --> 00:16:38,670
! أنت, أنت, أنت, أنت

116
00:16:38,730 --> 00:16:41,790
! هناك حدود لكيّ تحصل على الضخامة

117
00:16:42,990 --> 00:16:44,290
! جديّ

118
00:16:54,110 --> 00:16:55,350
! اللعنة

119
00:16:56,930 --> 00:16:59,390
! هذا ما تستحقّه

120
00:17:02,170 --> 00:17:03,790
! مُتّ يا [ غوكو ]

121
00:17:30,170 --> 00:17:35,190
! [ بـ .. بان ] ! اللعنة, إذا لم أفعل شيّء ... إذا لم أفعل شيّء

122
00:17:36,190 --> 00:17:37,650
! يا لك من شخصٍ صلب

123
00:17:37,850 --> 00:17:40,010
! حسنٌ, إذا أستطعت العيّش من خلال هذه فأنت وحش

124
00:17:40,170 --> 00:17:43,570
! جهّز نفسك ! الجهد الأقصى

125
00:17:55,190 --> 00:18:02,660
... أنا مُخدّرٌ جدّاً, لا يُمكنُنيّ الإحساس بأيّ شيّء ... أشعُرُ بأنّ جسدي قد تمزّق

126
00:18:10,530 --> 00:18:11,410
ماذا !؟

127
00:18:14,470 --> 00:18:20,180
! تـ .. تبّاً ! إنّه مطر ! اللعنة ! فيّ مثل هذا الوقت

128
00:18:21,170 --> 00:18:27,750
! أيّتها الأوحال الكهربائيّة, بسرعة إنفصلوا ! إنفصلوا ! نحنُ سنتفرّغُ على هذا الحال

129
00:18:45,810 --> 00:18:48,630
هل أنتيّ بخيّر يا [ بان ] ؟ [ بان ] !؟

130
00:18:50,470 --> 00:18:51,630
... جديّ

131
00:18:53,870 --> 00:18:57,670
! أسرعوا وإنفصلوا ! نحن سننفجر

132
00:19:00,110 --> 00:19:04,930
.أنظريّ إلى هذا يا [ بان ]. جسده يشتعل فيّ كُلّ مكان

133
00:19:09,550 --> 00:19:10,390
.هكذا إذاً

134
00:19:10,530 --> 00:19:12,650
,المطر يجعل الطاقة الكهربائيّة تتفرّغُ من جميّع أنحاء جسده

135
00:19:12,750 --> 00:19:14,810
.ولا يستطيّع التحكّم بها

136
00:19:19,010 --> 00:19:23,290
! هذه فرصتنا يا جديّ ! أقضيّ عليّه الآن بيّنما يُمكنُك ذلك

137
00:19:23,570 --> 00:19:29,170
.لا, هذه المعركة قد إنتهت. وحتى لوّ لم نفعل شيّئاً, فإنّه مُنتهيّ

138
00:19:30,870 --> 00:19:34,590
! إ .. إ .. إنّها تصعقُنيّ

139
00:19:35,090 --> 00:19:38,930
.لقد تمادى بنفسه, ونمى حجمه بشكلٍ ضخمٍ جدّاً

140
00:19:39,670 --> 00:19:42,690
.إنّه لا يستطيع الإبتعاد عن المطر هكذا

141
00:19:43,210 --> 00:19:45,640
,لقد إعتمد على قوّته كثيّراً

142
00:19:45,640 --> 00:19:47,030
وأسفر ذلك عن تدميّر نفسه, صحيّح ؟

143
00:19:47,790 --> 00:19:49,550
.أشعر بالقليّل من السوء إتجاهه

144
00:20:39,810 --> 00:20:43,190
.يبدو أنّ المعركة قد إنتهت

145
00:20:44,570 --> 00:20:46,430
... لقد خسرت

146
00:20:47,610 --> 00:20:49,570
.يا إلهيّ, يا لك من أنيّق

147
00:20:49,770 --> 00:20:54,830
.سأعطيّكم الكرة ذات الخمسة نجوم. خذوها

148
00:21:03,810 --> 00:21:06,550
! لقد وقعتيّ فيّ الخدعة, أيّتها الغبيّة

149
00:21:07,330 --> 00:21:09,090
! إحذري يا [ بان ]

150
00:21:10,490 --> 00:21:15,230
" !! كامي هامي ها"

151
00:21:36,830 --> 00:21:40,210
! شكراً لك يا جديّ

152
00:21:52,190 --> 00:21:57,660
.وهكذا, تمّ تطهيّر كرة التنيّن الثانيّة

153
00:22:16,650 --> 00:22:24,180
! ومع ذلك, لا يزال هناك خمسة من تنانيّن الشرّ يجب أن تُهزم