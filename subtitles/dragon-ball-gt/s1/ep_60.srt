1
00:02:52,750 --> 00:03:00,740
60
.الإندماج !! الخارقُ المُطلق [ غوجيّتا ]

2
00:03:20,780 --> 00:03:22,080
هل قال إندماج ؟

3
00:03:22,320 --> 00:03:26,180
! هذا مُذهل ! أبي والسيد [ فيجيتا ] سيقومون بالإندماج

4
00:03:28,480 --> 00:03:29,640
!... الإندماج

5
00:03:31,620 --> 00:03:32,660
... أبي

6
00:03:34,560 --> 00:03:37,980
قول لي يا [ ترانكس ], ما هو الإندماج ؟

7
00:03:45,300 --> 00:03:49,760
.الإندماج ؟ أنت مُحق, ما زال بإمكاننا القيام بذلك

8
00:03:55,340 --> 00:03:57,820
! لا تغترّا بنفسيّكُما

9
00:03:58,120 --> 00:04:00,780
! لن أسمح لكما بالحصول على ما تُريدان أكثر

10
00:04:09,520 --> 00:04:13,100
! هيّا أسرعوا ! أبي أرِنا إندماجكُما

11
00:04:15,720 --> 00:04:17,940
! سوف أكسرُ رقبته

12
00:04:23,560 --> 00:04:26,980
إنتظر أنت ! ما الذي تفعله لـ [ ترانكس ] !؟

13
00:04:33,340 --> 00:04:34,160
! أمي

14
00:04:37,240 --> 00:04:40,400
! إ .. إنتظر ! لا يُمكنُك أن تُهاجم هكذا بشكلٍ مُفاجئ

15
00:04:40,560 --> 00:04:44,140
ألا يُمكنُك قول " سأُطلقُ عليّكِ ! " أو " سأُفجرُكِ ! " أو شيءٌ ما !؟

16
00:04:53,420 --> 00:04:54,440
! إنتظر

17
00:04:55,720 --> 00:04:57,100
! [ غوتين ], هيّا بنا

18
00:04:57,520 --> 00:04:58,880
! لا يُمكنُنا السماحُ لهذا الشخص بالتدخل

19
00:04:59,080 --> 00:05:01,300
! يجب أن نسمح لأبي بإتمام إندماجهم

20
00:05:01,700 --> 00:05:02,810
! لقد فهمت يا أخي الكبير

21
00:05:05,260 --> 00:05:09,640
كما كُنت أقول, ماهو الإندماج أساساً !؟

22
00:05:15,040 --> 00:05:17,280
! أخي الكبير ! اللعنة

23
00:05:23,800 --> 00:05:25,660
! أيتها الذُباب المُزعجة

24
00:05:39,240 --> 00:05:41,020
ما الذي سنفعلُه يا [ كاكاروتو ] !؟

25
00:05:41,360 --> 00:05:43,060
هل سنقومُ بالإندماج أم لا ؟

26
00:05:43,180 --> 00:05:44,160
! أسرع وقرّر

27
00:05:48,000 --> 00:05:49,500
ما المُضحك !؟

28
00:05:50,660 --> 00:05:52,300
.لا, لا يُوجد شيءٌ مُضحك

29
00:05:52,580 --> 00:05:53,840
.أنا سعيدٌ فقط

30
00:05:54,200 --> 00:05:57,880
.سماعُ ذلك من فمك بأنك تُريد القيام بالإندماج

31
00:05:59,280 --> 00:06:00,440
! يا للتفاهة

32
00:06:04,080 --> 00:06:06,380
! إنه أمرٌ رائع يا [ فيجيتا ]

33
00:06:10,840 --> 00:06:12,800
! لن أسمح لكم

34
00:06:13,860 --> 00:06:16,640
! لن أسمح لك بالتدخُل ضد أبي

35
00:06:25,720 --> 00:06:27,660
! إبتعد أيها الشقي

36
00:06:31,640 --> 00:06:33,250
! إندماج

37
00:07:50,720 --> 00:07:52,620
مـ .. من أنت أيها اللعين !؟

38
00:07:53,560 --> 00:07:58,120
.أنا ؟ أنا لستُ بـ [ سون غوكو ] أو [ فيجيتا ]

39
00:07:58,400 --> 00:08:00,960
! أنا الذي سيُهزمُك أيها اللعين

40
00:08:08,540 --> 00:08:14,100
! أ .. أنت تمزح ! جدي ووالدُ [ ترانكس ] قد إتحدا معاً

41
00:08:14,200 --> 00:08:17,150
.إنه ليس إتحاد, بل إندماج

42
00:08:18,060 --> 00:08:19,820
.حسنٌ هذا لا يهُم, بكلتا الحالتين

43
00:08:20,360 --> 00:08:23,160
! هل فهمتي الآن يا [ بان ] ؟ هذا هوّ الإندماج

44
00:08:23,980 --> 00:08:25,490
! هذا مُذهل

45
00:08:25,660 --> 00:08:28,040
... هـ .. هذا مُذهلٌ حقّاً

46
00:08:29,340 --> 00:08:32,830
... يا لهم من مُذهلين ... السيد [ غوكو ] والذي معه

47
00:08:33,460 --> 00:08:34,540
... [ أوبو ]

48
00:08:37,020 --> 00:08:40,870
عذراً, أيرغب أيّ شخص بالإندماج معي ؟

49
00:08:47,060 --> 00:08:50,850
! من فضلكم ؟ أُريد أن أُصبح أقوى

50
00:08:52,420 --> 00:08:55,620
من فضلكم يا سيد [ غوهان ] ؟ ويا سيد [ ترانكس ] ؟

51
00:08:58,860 --> 00:09:02,960
.[ أوبو ], قبل أن نفعل ذلك, نحتاجُ لعلاج ذراعك

52
00:09:32,720 --> 00:09:37,820
.بالنسبة لك تتلقّى ثلاثة من لكماتي, وتُقذف بعيداً بأنفٍ ملطّخ بالدماء وهذا شيءٌ آخر

53
00:09:38,400 --> 00:09:42,170
ثلاثة لكمات ؟ ما الذي تتحدّثُ عنه !؟

54
00:09:43,020 --> 00:09:48,110
.هذه المرّة, سأفعلُها ببطئ, بحيثُ يُمكنُك رُؤيتُها

55
00:09:49,020 --> 00:09:50,480
! هذا يكفي

56
00:10:02,400 --> 00:10:05,520
! ليس سيئاً, صحيح !؟ إنه قوّيٌّ بشكلٍ لا يُصدق

57
00:10:05,580 --> 00:10:06,660
! بالطبع هو كذلك

58
00:10:06,960 --> 00:10:10,020
! في النهاية, إنه إلتصاق [ سون ] و [ فيجيتا ]

59
00:10:10,260 --> 00:10:11,540
! جدي

60
00:10:11,820 --> 00:10:15,620
! إقضي عليه ! إقضي عليه ! أعطه المزيد ! إنطلق ! إنطلق

61
00:10:15,920 --> 00:10:18,540
... مـ .. مستحيل ... هذا لا يُمكن أن يكون

62
00:10:18,740 --> 00:10:21,140
... ليس لي ... ليس لي

63
00:10:24,220 --> 00:10:26,540
!... ليس لي

64
00:10:32,500 --> 00:10:34,350
مـ .. ماذا !؟

65
00:10:41,300 --> 00:10:43,680
ما الذي تفعله أيها الغبي ؟

66
00:10:48,080 --> 00:10:51,580
! توقّف عن التلكُّأ أيها الأبله

67
00:10:51,940 --> 00:10:53,580
الأبله ...؟

68
00:10:56,680 --> 00:10:58,240
أقُلت الأبله !؟

69
00:10:58,520 --> 00:11:01,760
! لا تغترّ بنفسك كثيراً بسبب زيادة بعضاً من قّوتك

70
00:11:01,880 --> 00:11:04,960
! حتّى أنت لست قادرٌ على تجنُب هذه

71
00:11:06,740 --> 00:11:09,300
! مُتّ ! مُتّ ! مُتّ ! مُتّ

72
00:11:11,920 --> 00:11:12,760
! أبي

73
00:11:12,860 --> 00:11:13,880
! جدي

74
00:11:35,900 --> 00:11:37,360
! مُتّ ! مُتّ

75
00:11:50,060 --> 00:11:50,720
ما رأيُك بهذه !؟

76
00:11:50,840 --> 00:11:54,820
! مهما كُنت قوّياً, لا يُمكنُك تلقّى هذه الكمية مباشرةً ولم تُصاب

77
00:12:06,860 --> 00:12:08,820
! لستَ بتلك القوّة التي كُنت تتفوّهُ بها

78
00:12:13,400 --> 00:12:15,270
! لقد شعرتُ بها

79
00:12:16,000 --> 00:12:20,340
.نعم, شعرتُ بها, شعرتُ بها. وكان شُعورٌ رائع

80
00:12:21,460 --> 00:12:22,940
ما الذي قُلته ؟

81
00:12:23,520 --> 00:12:29,180
.قول لي, هذه المرّة, هلّا فعلتُها ليّ هنا ؟ كتِفيّ مُتصلّبة جدّاً

82
00:12:34,260 --> 00:12:35,890
! لا تسخر مني

83
00:13:03,660 --> 00:13:08,460
! والآن إذاً, حان الوقت لكيّ أُريك حركتي القاضية

84
00:13:33,700 --> 00:13:37,460
,بعد تلقيك لخمسة من ضربة الـ " كاميّهاميّها " في وقتٍ واحد

85
00:13:37,520 --> 00:13:40,740
! أشُك في أن حتى خلاياك لن تبقى

86
00:13:58,680 --> 00:14:00,200
! اللعنة

87
00:14:07,220 --> 00:14:08,610
! بطني تُؤلمُني

88
00:14:11,680 --> 00:14:13,460
!... أيها اللعين

89
00:14:15,020 --> 00:14:18,520
أتُريد أن تجعلُني أُضحوكة ؟

90
00:14:21,520 --> 00:14:24,080
.بحقّ, لقد خاب أملي فيك

91
00:14:24,340 --> 00:14:26,700
.إعتقدتُ بأنك ستكون أفضل من هذا قليلاً

92
00:14:27,120 --> 00:14:28,270
ماذا ؟

93
00:14:29,040 --> 00:14:31,760
! إصبعٌ واحدٌ هو كُلّ ما أحتاجُه ضدك

94
00:14:32,940 --> 00:14:37,910
! أنا ... أنا لن أخسر أبداً

95
00:14:38,440 --> 00:14:44,620
! تنانين الشرّ, أعيروني قُوّتكم

96
00:15:36,080 --> 00:15:43,810
هذه كرة الطاقة التي صُنعت من الطاقة السالبة المُكثّفة ! من كرات التنين بالإضافة إلى كراهية تناني الشر

97
00:15:45,780 --> 00:15:49,020
! يُمكنُكم جميعاً الذهاب إلى الجحيم

98
00:15:56,420 --> 00:15:58,420
! هذا سيء, أهربوا جميعاً

99
00:16:15,180 --> 00:16:18,040
,لا فائدة. بغض النظر عن المكان الذي نهربُ إليه

100
00:16:18,500 --> 00:16:21,760
,عندما تصطدمُ كرة طاقة مُكثّفة بقوّة مُذهلة بشيءٍ ما

101
00:16:21,820 --> 00:16:24,350
! الأرض ... سوف تُدمّر

102
00:17:40,340 --> 00:17:43,520
! جـ .. جدي المُحترم ! جدي المُحترم

103
00:17:43,860 --> 00:17:47,640
لقد سمعتُك بالفعل, هل إنتهى العشاء ؟

104
00:17:48,920 --> 00:17:51,280
.ليس بعد ! لا يجبُ عليك إزالة الغطاء

105
00:17:51,840 --> 00:17:52,870
! ليس هذا الأمر

106
00:17:53,720 --> 00:17:55,540
.ألقي نظرة على هذا من فضلك

107
00:17:56,320 --> 00:17:59,280
! لقد إختفى ظل الشرّ الذي كان يُغطى الأرض

108
00:18:18,340 --> 00:18:22,330
.يبدو أنه حتى السماء قد تخلّت عنك

109
00:18:25,120 --> 00:18:27,580
كـ .. كيف ؟

110
00:18:28,360 --> 00:18:32,680
هل تعتقدُ أن كُلّ ما فعلته هو فقط ركل كرة الطاقة بعيداً ؟

111
00:18:40,820 --> 00:18:42,220
,في اللحظة التي ركلتُها

112
00:18:42,420 --> 00:18:44,200
,إستخدمتُ الطاقة التي بداخل جسدي

113
00:18:44,400 --> 00:18:48,500
.لتحويل الطاقة السالبة لكرة الطاقة إلى موجبة

114
00:18:56,880 --> 00:18:58,720
مـ .. ما الذي قُلته ؟

115
00:18:59,080 --> 00:19:02,540
,أنت تعني أن الطاقة الموجبة التي كانت بكرة الطاقة

116
00:19:02,560 --> 00:19:05,600
,إصطدمت بالطاقة السالبة المحيطة بالأرض

117
00:19:05,620 --> 00:19:07,420
فأدت إلى تلاشيها !؟

118
00:19:07,880 --> 00:19:12,000
! هذا صحيح ! عند إضافة الموجب والسالب, فإن الجواب يساوي صفر

119
00:19:12,120 --> 00:19:15,060
!... الـ .. اللعنة

120
00:19:15,080 --> 00:19:17,100
! لنُنهي هذا الأمر يا [ شينلونغ الأول ]

121
00:19:17,780 --> 00:19:19,720
! سأرسلُك إلى العالم الآخر بهذه

122
00:19:20,180 --> 00:19:22,520
"  !! إنفجار الكاميّهاميّها الكبير "

123
00:19:49,300 --> 00:19:50,540
! لقد فعلناها

124
00:19:52,680 --> 00:19:53,800
! لقد إنتهى الأمر

125
00:19:59,080 --> 00:20:02,400
أ .. أنت تمزح, صحيح ؟

126
00:20:17,280 --> 00:20:20,360
! أنا لم أختفي بعد

127
00:20:21,140 --> 00:20:22,720
! يا لك من شخصٍ مثابر

128
00:20:23,280 --> 00:20:25,440
! ولكن مهما كافحت, فلا فائدة

129
00:20:26,020 --> 00:20:29,560
! بالضربة التالية, سوف تُمحى من الوجود بالتأكيد

130
00:20:29,560 --> 00:20:36,870
"  !!... إنفجار ... الكاميّهاميّها الكبيـ "

131
00:20:41,400 --> 00:20:45,660
! لماذا ؟ لم تمُر حتى عشر دقائق

132
00:20:46,080 --> 00:20:47,180
ما معنى هذا !؟

133
00:20:47,700 --> 00:20:50,760
يجب أن نكون قادرين على الحفاظ على الإندماج لمدة ثلاثين دقيقة, أليس كذلك !؟

134
00:20:53,740 --> 00:20:57,580
,لقد عرفت ! لا بُدّ وأنه عندما يخضع إثنان من السيّاجيّن الخارق 4 للإندماج

135
00:20:57,840 --> 00:21:01,140
! كُلما إستخدمت قُوّة أكبر, كُلما قلّ الوقت

136
00:21:02,380 --> 00:21:05,440
.كان يجب علينا أن لا نلهو ونقضي عليه في الحال

137
00:21:05,580 --> 00:21:06,960
! أيها الأحمق الغبي

138
00:21:09,300 --> 00:21:13,820
! لـ .. لا تغضب, فأنت تتحمل نصف المسؤولية أيضاً

139
00:21:14,020 --> 00:21:16,800
! اللعنة ! لقد تبقّت ضربة واحدة فقط

140
00:21:18,800 --> 00:21:20,180
,على بعد خطوة واحدة فقط

141
00:21:20,200 --> 00:21:23,640
! الإندماج قد إنتهى بين [ غوكو ] و [ فيجيتا ]

142
00:21:26,100 --> 00:21:30,660
أعرف شُعوركم ! كُنتم قريبين من الفوز, صحيح ؟

143
00:21:31,140 --> 00:21:33,680
! يا لكم من أشخاص غير محظوظين

144
00:21:34,220 --> 00:21:37,040
! أنت تعرف شُعورنا ؟ إسمع من يتكلم

145
00:21:37,360 --> 00:21:39,500
! أنت الشخص الوحيد المُنهك

146
00:21:39,780 --> 00:21:42,720
! وأستطيع الآن أن أتغلّب عليك لوحدي

147
00:21:44,300 --> 00:21:46,080
.أشُك في هذا

148
00:21:46,920 --> 00:21:49,540
! إجتمعي يا كرات التنين

149
00:22:12,060 --> 00:22:17,060
! مُجدّداً, [ شينلونغ الأول ] يحاول إمتصاص كرات التنين ويزدادُ قُوّةً

150
00:22:17,440 --> 00:22:18,270
!... ولكن

151
00:22:19,280 --> 00:22:20,200
ماذا !؟

152
00:22:21,920 --> 00:22:24,920
! الكرة ذات الأربعة نجوم هذه كانت تذكارٌ من جدي

153
00:22:25,320 --> 00:22:27,480
! لن أسمح لك بأخذها