1
00:03:26,740 --> 00:03:34,750
44
.الإنسان الإصطناعيّ المُطلق ! إتحاد إثنان من [ رقم 17 ]

2
00:03:41,850 --> 00:03:46,180
.تعاليّ معيّ يا [ رقم 18 ]

3
00:03:46,180 --> 00:03:48,950
... نحن ... شريكان

4
00:03:53,460 --> 00:03:57,460
... نحن ... شريكان

5
00:03:57,460 --> 00:04:00,800
.هذا صحيح. نحن شريكان

6
00:04:00,800 --> 00:04:03,800
! لا يُمكنُك الذهاب معه

7
00:04:03,800 --> 00:04:08,140
لا تذهبيّ يا [ رقم 18 ] ! أنتيّ زوجتيّ, أليّس كذلك ؟

8
00:04:08,140 --> 00:04:09,210
! إصمت

9
00:04:09,210 --> 00:04:12,610
,[ رقم 18 ], مثليّ, إنسانة إصطناعيّة

10
00:04:12,610 --> 00:04:14,480
! أُعيد بناؤُها من قبل سيّديّ الدكتور [ غيرو ]

11
00:04:14,480 --> 00:04:17,680
ما الذيّ قلته ؟ سيّديّ الدكتور [ غيرو ] ؟

12
00:04:17,680 --> 00:04:21,850
أنت لم تربط أبداً كلمة " سيّديّ " إلى إسم الدكتور [ غيرو ] فيّ الماضيّ, صحيح ؟

13
00:04:23,150 --> 00:04:26,820
لقد كُنت حاقد على الدكتور [ غيرو ], أليّس كذلك ؟

14
00:04:26,820 --> 00:04:31,830
... أنا كُنتُ حاقد ... على سيّديّ الدكتور [ غيرو ]

15
00:04:31,830 --> 00:04:37,130
.ما الذيّ تفعله يا [ رقم 17 ] !؟ تعال الآن ! أنا أنت ; وأنت أنا

16
00:04:37,830 --> 00:04:41,200
[ رقم 17 ] ! ما الذيّ حدث لك بحقّ ؟

17
00:04:42,840 --> 00:04:45,030
! إصمت ! أغلق فمك

18
00:04:52,780 --> 00:04:54,450
! بابا -
! [ كوريّريّن ] -

19
00:04:54,450 --> 00:04:57,450
! [ كوريّريّن ] ! تماسك ! [ كوريّريّن ]

20
00:04:57,450 --> 00:04:59,550
! بابا ! بابا

21
00:05:00,120 --> 00:05:02,650
! [ كوريّريّن ] ! [ كوريّريّن ]

22
00:05:03,790 --> 00:05:05,800
... [ كوريّريّن ]

23
00:05:05,800 --> 00:05:07,200
.أراك لاحقاً

24
00:05:11,800 --> 00:05:14,470
! إهرُبيّ بأمان يا [ رقم 18 ]

25
00:05:14,470 --> 00:05:17,910
هل يُمكنُك إعادة [ رقم 18 ] إلى إنسانة طبيعيّة كما كانت ؟

26
00:05:23,810 --> 00:05:27,480
لماذا ؟

27
00:05:27,480 --> 00:05:32,220
! هيّا بنا, ليّس لديّنا وقت. تعاليّ معيّ

28
00:05:32,820 --> 00:05:35,160
لماذا قتلت [ كوريّريّن ] ؟

29
00:05:35,160 --> 00:05:36,490
... [ كوريّريّن ]

30
00:05:36,490 --> 00:05:41,500
!! أعدّ ليّ ... [ كوريّريّن ]

31
00:05:41,500 --> 00:05:43,830
! أعده ! أعده

32
00:05:43,830 --> 00:05:45,770
!! أعده

33
00:05:55,110 --> 00:05:59,780
... هكذا إذاً ... لقد كُنت سأسمح لكيّ بالعيّش على الأقل

34
00:05:59,780 --> 00:06:04,350
! ولكن إذا كُنتيّ تريديّ الموت بشدّة, فسوف أمنحُك أمنيّتك

35
00:06:05,460 --> 00:06:07,120
! ماما

36
00:06:07,120 --> 00:06:08,650
! أهرُبيّ من هنا

37
00:06:09,790 --> 00:06:12,630
! لا ! لا أُريد أن أكون لوحديّ

38
00:06:15,130 --> 00:06:16,660
! أهرُبيّ بسرعة

39
00:06:18,800 --> 00:06:24,970
.[ رقم 17 ], يبدو بأنك عُدت إلى ذلك الصبيّ الجامح الذيّ كُنت عليّه من قبل

40
00:06:27,480 --> 00:06:30,240
! أنا لن أسمح لك بالإفلات من هذا يا [ رقم 17 ]

41
00:06:49,770 --> 00:06:51,170
.أيّتها الغبيّة

42
00:07:20,460 --> 00:07:23,560
... أنا أُحبك يا [ كوريّريّن ]

43
00:07:36,150 --> 00:07:39,480
إذاً ما رأيُك بهذا المنظر المُخجل ؟

44
00:07:41,150 --> 00:07:45,120
,ولا حتى [ غوكو ] يستطيع الصمود أمام تقنيتُنا الجهنميّة

45
00:07:45,120 --> 00:07:51,430
.مروّض الجحيم, التيّ أسقطتُك هنا فيّ الجزء السفليّ من قاع الجحيم

46
00:07:51,430 --> 00:07:53,800
الآن هو الوقت المناسب لنثأر لأنفسنا من كلّ

47
00:07:53,800 --> 00:07:56,430
.سنوات المرارة التيّ حملناها ضدك

48
00:07:56,430 --> 00:07:59,960
! كما أننا سنُحطم جسدك هذا إلى قطع

49
00:08:07,110 --> 00:08:08,840
مـ .. ماذا ؟

50
00:08:10,780 --> 00:08:12,780
... يا إلهيّ, يا إلهيّ

51
00:08:12,780 --> 00:08:14,610
ماذا يحدث ؟

52
00:08:16,450 --> 00:08:18,120
! إنه حار ! إنه حار

53
00:08:18,120 --> 00:08:21,120
! لا أستطيع التحمّل بعد الآن

54
00:08:21,120 --> 00:08:26,460
هذا الصبيّ لا يُمكن أن يكون على قيّد الحياة, صحيح ؟ هل هو ساكن فيّ الجحيم, أليّس كذلك ؟

55
00:08:26,460 --> 00:08:28,800
ما الذيّ تقصدينه إذاً ؟

56
00:08:28,800 --> 00:08:31,470
.هذه التقنيّة تعمل فقط ضد الموتى

57
00:08:31,470 --> 00:08:33,900
إنها تقنيّة أُخترعت

58
00:08:33,900 --> 00:08:37,140
.لمعاقبة الموتى الذيّن يرتكبون الشرّ سواءاً فيّ الجحيم أو فيّ الجنة

59
00:08:37,140 --> 00:08:40,640
,أولئك الذيّن لا يزالوا على قيّد الحياة يملكون جسد درجة حرارته عاليّة جدّاً

60
00:08:40,640 --> 00:08:41,610
.لذلك لا تُجديّ معه

61
00:08:48,420 --> 00:08:50,650
! مـ .. مستحيل

62
00:08:53,420 --> 00:08:56,760
.للحظة, كُنتُ قلقاً حول ما الذيّ سيحدثُ ليّ

63
00:08:56,760 --> 00:08:59,130
! ولكننيّ إنتهيّت من اللعب الآن

64
00:08:59,130 --> 00:09:01,560
! أنا سأتخلّصُ منكما معاً

65
00:09:10,770 --> 00:09:15,400
! أ .. أيّها الأحمق ! لقد قُلتُ لك, بغضّ النظر عن ما تفعله بنا, فإننا لن نموت

66
00:09:15,780 --> 00:09:20,450
هذا صحيح, هذا صحيح لقد قلت ذلك, صحيح ؟ أنتما يا رفاق بالفعل أموات, أليّس كذلك ؟

67
00:09:20,450 --> 00:09:21,890
! هذا صحيح

68
00:09:21,890 --> 00:09:26,080
! لذلك, فمن المستحيل لك تماماً هزيمتُنا

69
00:09:27,460 --> 00:09:31,220
.فيّ هذه الحالة, أتسائل ما الذيّ سيحدث إذا أدرتُ هذا

70
00:09:31,800 --> 00:09:34,060
,على ما أذكر

71
00:09:34,060 --> 00:09:35,800
هذه تعمل بشكلٍ جيّد ضد الموتى, صحيح ؟

72
00:09:35,800 --> 00:09:37,560
! تـ .. توقف

73
00:09:41,140 --> 00:09:42,730
! الـ .. اللعنة

74
00:09:44,810 --> 00:09:48,400
! دعنيّ أذهب ! دعنيّ أذهب

75
00:09:48,750 --> 00:09:52,420
! أنا ... لا أستطيع ... التحرّك

76
00:09:52,420 --> 00:09:56,040
! أوقف ... هذا

77
00:09:58,420 --> 00:10:03,430
! أنتما يا رفاق حقّاً شريّران, ما زلتُم تفعلون أشياء سيّئة حتى بعد موتكم

78
00:10:03,430 --> 00:10:05,220
! أنا مندهش منكما

79
00:10:13,100 --> 00:10:16,300
! اللعنة ! لقد حطمتهم

80
00:10:43,470 --> 00:10:46,470
!! الآن سأقضيّ عليّك ! مُتّ

81
00:10:46,470 --> 00:10:50,100
!... إذا لم أفعل شيّئاً

82
00:10:53,740 --> 00:10:55,410
! [ أوبو ]

83
00:10:55,410 --> 00:10:56,410
! أخيّ الكبير

84
00:10:56,410 --> 00:10:58,540
هل أنت بخير يا سيّد [ غوهان ] ؟

85
00:10:59,750 --> 00:11:00,880
! شكراً لكم

86
00:11:00,880 --> 00:11:05,090
.إذا أنتم يا رفاق سوف تُنقذونيّ, إذاً فالوقت قد حان لكيّ أتقاعد

87
00:11:05,090 --> 00:11:07,420
! بابا

88
00:11:07,420 --> 00:11:09,290
هل أنت بخير ؟

89
00:11:12,430 --> 00:11:15,100
.[ غيّل ], أصلح ذراع بابا

90
00:11:15,100 --> 00:11:17,230
! عُلم, عُلم

91
00:11:29,110 --> 00:11:31,550
.[ غيّل ], شكراً

92
00:11:39,790 --> 00:11:42,390
أأنت متساويّ بالقوّة ضديّ ؟

93
00:11:42,390 --> 00:11:45,800
! أيّها الوغد, لقد إزددت قوّةً تفوق الخيال

94
00:11:45,800 --> 00:11:49,130
أتقول بأنه إزداد قوّة ؟

95
00:11:49,130 --> 00:11:52,470
.أنا مندهش من أنك تفاجأت بذلك

96
00:11:52,470 --> 00:11:53,800
ماذا !؟

97
00:11:53,800 --> 00:11:57,260
.[ رقم 17 ] سيولد من جديد

98
00:11:58,140 --> 00:12:01,670
وأخيراً وصلت يا [ رقم 17 ] الخاص بيّ ؟

99
00:12:12,160 --> 00:12:16,490
! مـ .. ما نوّع هذا المزاح ؟ هناك إثنان من [ رقم 17 ]

100
00:12:16,490 --> 00:12:18,460
! أبيّ

101
00:12:26,500 --> 00:12:29,210
.يبدو بأن الجميع قد وصل

102
00:12:29,210 --> 00:12:32,840
! والآن إذاً, دعونا نبدأ بعرضنا الرائع

103
00:12:32,840 --> 00:12:35,830
! لقد حان الوقت لبدأ المرحلة الأخيرة

104
00:12:59,560 --> 00:13:04,890
,إستمعوا جيّداً ! عندما يصبحا ثنائيّ هذا العالم والعالم الآخر واحداً

105
00:13:04,890 --> 00:13:08,360
,كُلّ الأنظمة التيّ بداخل أجسادهم تصبح مثاليّة

106
00:13:08,360 --> 00:13:11,400
,و [ رقم 17 ] سيولد من جديد كأقوى

107
00:13:11,400 --> 00:13:14,390
! إنسان إصطناعيّ مُطلق

108
00:13:14,900 --> 00:13:18,910
! حسنٌ إذاً, إتحدا إثنيّنكم يا [ رقم 17 ]

109
00:13:18,910 --> 00:13:21,910
.أنت أنا ; وأنا أنت

110
00:13:21,910 --> 00:13:23,900
.سوف نكون واحد

111
00:13:29,250 --> 00:13:31,590
! لـ .. لامعٌ جدّاً

112
00:13:31,590 --> 00:13:34,110
مـ .. ما الذيّ يخططون لفعله !؟

113
00:14:16,230 --> 00:14:19,170
! لـ .. لقد إندمجا معاً

114
00:14:33,250 --> 00:14:35,920
! يـ .. يا لها من قوّة

115
00:14:35,920 --> 00:14:39,420
! لقد نجحنا ! هذا هو الإنسان الإصطناعيّ المطلق

116
00:14:39,420 --> 00:14:42,590
! ولادة [ رقم 17 ] الخارق

117
00:14:42,590 --> 00:14:47,000
! المرحلة النهائيّة من خطّتنا لغزوّ الأرض إكتملت الآن

118
00:14:59,210 --> 00:15:00,570
! سوف أقتله

119
00:15:05,550 --> 00:15:06,810
ماذا ؟

120
00:15:20,900 --> 00:15:23,390
! مـ .. مستحيل

121
00:15:28,240 --> 00:15:30,910
! جميعكم, أرجعوا للخلف

122
00:15:30,910 --> 00:15:32,580
... كا

123
00:15:32,580 --> 00:15:37,250
... ميّ ... ها

124
00:15:37,250 --> 00:15:39,580
... ميّ

125
00:15:39,580 --> 00:15:41,740
!! ها

126
00:15:48,860 --> 00:15:50,550
! لقد فعلها

127
00:15:56,870 --> 00:15:58,200
... أخيّ الكبير

128
00:15:58,200 --> 00:15:59,540
... الكاميّهاميّها -

129
00:15:59,540 --> 00:16:03,210
الخاصة به لم يكن لها تأثير !؟ -

130
00:16:03,210 --> 00:16:08,700
! هل إنتهيّتم الآن ؟ حسنٌ إذاً, [ رقم 17 ] الخارق, حان دورك الآن

131
00:16:32,900 --> 00:16:35,570
! مهما كان عددكم معاً, الحشرات تبقى حشرات

132
00:16:35,570 --> 00:16:41,240
,وبغضّ النظر عن عدد المرّات التيّ تهاجموه
! لا توجد أيّ وسيلة يُمكنُكم بها هزيمة [ رقم 17 ] الخارق

133
00:16:41,240 --> 00:16:45,740
هل فهمتم ذلك, أنتم يا من فشلتم فيّ الحفاظ على مكانكم الخاص ؟

134
00:16:47,250 --> 00:16:51,710
! لقد مرّ وقتٌ طويل منذ أن غضبت من أعماق قلبيّ

135
00:17:01,860 --> 00:17:06,870
! على ما يبدو, بأنكم لم تفهموا بعد بأن هجماتكم لا معنى لها

136
00:17:06,870 --> 00:17:10,210
.أعتقد بأن لا خيار لديّ سوى إثباتُ ذلك بعدد قليل من مهاراتيّ

137
00:17:10,210 --> 00:17:12,370
!! القذائف الوميضيّة

138
00:17:26,220 --> 00:17:30,890
يا له من شخص ! لديّه قوّة مرعبه, أليّس كذلك ؟

139
00:17:30,890 --> 00:17:36,230
! هؤلاء الأشخاص أبعدونيّ أنا فقط من المجموعة

140
00:17:36,230 --> 00:17:38,230
! أيّها العجوز [ يامّا ]

141
00:17:38,230 --> 00:17:41,900
أسرع وأخرجنيّ من هنا, هل يُمكنُك ؟

142
00:17:41,900 --> 00:17:43,910
.أنا آسف, لا يُمكنُنيّ

143
00:17:43,910 --> 00:17:48,510
! لماذا ؟ أسرع وأعدنيّ إلى مكان [ فيجيتا ] والأخرين

144
00:17:48,510 --> 00:17:51,450
لا أعلم لماذا, ولكن يبدو بأن هناك

145
00:17:51,450 --> 00:17:55,180
.قوّة عظيمة تعمل بيّن هذا العالم والعالم الآخر

146
00:17:55,180 --> 00:18:01,680
.أنا أعلمُ بأنه مثير للشفقة, ولكن لا يُمكنُنيّ إعادتُك إلى الأرض بقوّتيّ

147
00:18:02,530 --> 00:18:08,530
! مستحيل ! إذاً, أيجبُ أن أعيش هنا من الآن فصاعداً ؟ إفعل شيّئاً

148
00:18:08,530 --> 00:18:11,200
... أفعلُ شيّئاً, يقول

149
00:18:11,200 --> 00:18:13,200
أيّها الملك العظيم [ يامّا ] ! هل يُمكنُك سماعيّ ؟

150
00:18:13,200 --> 00:18:15,540
هذا الصوت ! هل هذا أنت يا [ بيكولو ] ؟

151
00:18:15,540 --> 00:18:17,540
.أرسلنيّ إلى الجحيم

152
00:18:17,540 --> 00:18:19,540
مـ .. ماذا !؟

153
00:18:19,540 --> 00:18:24,240
! لديّ فكرة ! هيّا أسرع ! دعنيّ أذهبُ إلى الجحيم

154
00:18:34,890 --> 00:18:40,560
.لا. أنا لا أعلم ماهيّ الفكرة التيّ لديّك, ولكن لا أستطيع أن أفعل ذلك

155
00:18:40,560 --> 00:18:42,230
ماذا !؟ لماذا ؟

156
00:18:42,230 --> 00:18:46,240
شيّءٌ كهذا ينبغيّ أن يكون سهلاً للملك العظيم [ يامّا ] لفعله, أليّس كذلك ؟

157
00:18:46,240 --> 00:18:50,870
,إذا ذهب أحدٌ إلى الجنة أو ذهب أحدٌ إلى الجحيم

158
00:18:50,870 --> 00:18:53,180
! حالما أضع ختميّ على الأوراق, لا يُمكنُنيّ تغيّيره مرّةٌ أخرى إلى الأبد

159
00:18:53,180 --> 00:18:57,510
! هذا كان القانون الأبديّ مُنذُ أن تأسّست الجحيم

160
00:18:57,510 --> 00:19:01,850
.أيّها البيروقراطيّ الرديّء ! حسنٌ فهمت

161
00:19:01,850 --> 00:19:05,840
فيّ هذه الحالة, ما رأيُك بهذا ؟

162
00:19:10,190 --> 00:19:13,530
مـ .. ما الذيّ تفعله !؟

163
00:19:13,530 --> 00:19:18,870
! أيّها المعتوه ! أنا بالفعل الشريّر المُطلق [ بيكولو دايماو ]

164
00:19:23,870 --> 00:19:27,810
,أ .. أيّها المغفّل ! بالنسبةِ لك أن تُعيث فساداً فيّ الجنة

165
00:19:27,810 --> 00:19:30,880
! من بيّن جميع الأماكن, لهو أمرٌ فظيع ولا يوصف

166
00:19:30,880 --> 00:19:33,540
! أنت ستذهبُ للجحيم للأبد

167
00:19:45,230 --> 00:19:46,690
... آسف

168
00:20:31,870 --> 00:20:35,880
! يبدو بأنكم لم تدركوا بعد الفرق بيّن قوتُنا

169
00:20:35,880 --> 00:20:39,550
! إصمُت ! تلقّى حركتيّ القاضيّة الجديدة

170
00:20:39,550 --> 00:20:41,220
السطوع النهائيّ

171
00:20:41,220 --> 00:20:43,190
!! هجوم

172
00:20:54,830 --> 00:20:58,790
! أنا لستُ عديم الفائدة تماماً بعد

173
00:21:04,170 --> 00:21:06,180
وماذا فيّ ذلك ؟

174
00:21:06,180 --> 00:21:08,540
أ .. أيّ نوع من الأوغاد أنت !؟

175
00:21:15,520 --> 00:21:17,990
! هـ .. هذا سيّء الآن

176
00:21:17,990 --> 00:21:21,190
! إذا لم أذهب إلى هناك قريباً, سوف يُهلك الجميع

177
00:21:21,190 --> 00:21:22,520
.إترُك الأمر ليّ

178
00:21:24,860 --> 00:21:28,200
! مـ .. ماذا ؟ إنه أنت يا [ بيكولو ]

179
00:21:28,200 --> 00:21:31,530
لقد مرّ وقت, أليّس كذلك يا [ غوكو ] ؟

180
00:21:31,530 --> 00:21:37,540
.ألم تكُن فيّ الجنة ؟ هكذا إذاً, ربما بسبب وجهك المخيف

181
00:21:37,540 --> 00:21:42,550
.لقد أتيّتُ إلى الجحيم هنا من أجل أن أخرجك من هنا

182
00:21:42,550 --> 00:21:46,880
حقّاً ؟ أيُمكنُك أن تفعل شيّئا كهذا ؟

183
00:21:46,880 --> 00:21:49,820
" لا يُمكنُنيّ أبداً أن أعود إلى الأرض ؟ "

184
00:21:49,820 --> 00:21:54,260
.بما أن [ غوكو ] كان يُفكر بهذا بنفسه, ظهر [ بيكولو ] أمامه

185
00:21:54,890 --> 00:21:58,520
.لا تستهيّن بالقوّة الطبيعيّة الخارقة للناميكسيّجين

186
00:21:58,890 --> 00:22:03,520
[ بيكولو ], هل أنت حقّاً قادرٌ على إعادة [ غوكو ] إلى الأرض ؟

187
00:22:15,240 --> 00:22:18,270
! ليّس هناك الكثير من الوقت المتبقيّ

188
00:22:21,920 --> 00:22:23,250
! بابا

189
00:22:23,250 --> 00:22:25,920
! سيّد [ غوهان ]

190
00:22:25,920 --> 00:22:30,920
! جديّ, أرجوك ! أرجوك, عُدّ