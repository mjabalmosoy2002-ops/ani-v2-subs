1
00:03:46,870 --> 00:03:54,790
37
!! لا يُصَدَّق !! الضربتيّن القاضيتيّن لـ [ بيبي ] و [ غوكو ]

2
00:03:58,300 --> 00:04:00,300
! سيّد [ غوكو ], إفتح عيّنيّك

3
00:04:00,300 --> 00:04:02,090
! [ غوكو ] الطفل

4
00:04:04,300 --> 00:04:06,270
... إنتهى كلّ شيّء

5
00:04:11,310 --> 00:04:17,680
! لحظاتٌ قليلة فقط, وسوف أقتلك

6
00:04:23,650 --> 00:04:38,000
! سيّد [ بيبي ], أقضيّ على ذلك السيّاجين الحقير

7
00:04:38,000 --> 00:04:45,030
الـ .. اللعنة, هل سيُقضى عليّ هكذا ؟

8
00:04:49,610 --> 00:04:53,380
! سوف أقضيّ عليك الآن أيّها السيّاجين

9
00:05:00,290 --> 00:05:02,280
مـ .. ماذا !؟

10
00:05:09,970 --> 00:05:12,060
لماذا !؟

11
00:05:22,980 --> 00:05:28,440
ما الذيّ يحدث بحقّ !؟ ما الذيّ يحدث !؟

12
00:05:32,320 --> 00:05:33,990
! هذا صحيح

13
00:05:33,990 --> 00:05:39,520
عشرة أضعاف, كاميّهاميّ ...

14
00:05:40,000 --> 00:05:44,760
اللعنة ! هل هذا يعنيّ أننيّ بدأتُ أتأثّر بواسطة تلك ؟

15
00:05:47,000 --> 00:05:51,500
! على ما يبدو, بأن الكاميّهاميّ ... ها 10 أضعاف الخاصّة بيّ قد أثّرت عليّك تماماً

16
00:05:52,280 --> 00:05:56,010
,هذا ليّس صحيحاً ! إنه فقط لمن السهل جدّاً أن

17
00:05:56,010 --> 00:05:59,810
! أقتُلك الآن على الرغم من أن قلبيّ لا يُريد ذلك

18
00:06:00,280 --> 00:06:06,280
.لا, بدأ التأثير. لا بُدّ وأن كل ما يُمكنُك فعله هو الوقوف حاليّاً

19
00:06:07,290 --> 00:06:11,820
! هذه المرّة بالتأكيد ... هذه المرّة بالتأكيد, سوف أُرسلُك بعيداً إلى العالم الآخر

20
00:06:12,630 --> 00:06:14,630
.لنرى ذلك

21
00:06:14,630 --> 00:06:16,660
! إذهب إلى الجحيم

22
00:06:31,650 --> 00:06:36,780
! اللعنة ! طاقة السيّد [ غوكو ] إنتهت أيّضاً ! إنها الضربتيّن القاضيتيّن

23
00:06:36,990 --> 00:06:39,680
! حسنٌ ! هذه فُرصتُنا

24
00:06:40,660 --> 00:06:42,660
وما هيّ تلك الفرصة ؟

25
00:06:42,660 --> 00:06:47,000
! إما الآن وإلّا فلا ! إذا أردنا القضاء عليه, فهذه هيّ

26
00:06:47,000 --> 00:06:51,600
فهمت ! سأذهب إلى هناك وأُعيد للسيّد [ غوكو ] طاقته, صحيح ؟

27
00:06:51,600 --> 00:06:52,400
! أيّها المغفّل

28
00:06:52,400 --> 00:06:59,740
! أنت لا تمتلك نوع من القوّة التيّ تُعيد طاقة السيّاجين الخارق 4 لـ [ غوكو ]

29
00:07:01,280 --> 00:07:03,280
إذاً ؟

30
00:07:03,280 --> 00:07:06,950
.أنت ستذهب لتُعيد [ ترانكس ] والآخرين

31
00:07:06,950 --> 00:07:09,120
ما الذيّ تقوله ؟ تذكّر ؟

32
00:07:09,120 --> 00:07:14,630
السيّد [ ترانكس ] والآخرين همّ أعداؤنا الآن ! وأنت تُريد منيّ ...؟

33
00:07:14,630 --> 00:07:16,630
يوجد الماء المُقدّس, صحيح ؟

34
00:07:16,630 --> 00:07:19,030
! الماء المُقدّس ... هكذا إذاً

35
00:07:19,030 --> 00:07:22,290
! يُمكنُنا إستخدام ذلك, صحيح ؟ هذا هو الجدّ المحترم

36
00:07:22,970 --> 00:07:25,970
ما هو هذا الماء المُقدّس ؟

37
00:07:25,970 --> 00:07:28,770
... الماء المُقدّس, كما تعلم

38
00:07:30,970 --> 00:07:33,540
,يُشيرُ إلى الماء المُقدّس الأسطوري

39
00:07:33,540 --> 00:07:37,040
.الذيّ يتمّ الإحتفاظ به فيّ برج السماء, وبإمكانه تطهير جميع السموم

40
00:07:41,320 --> 00:07:43,320
هذا الشيّء مذهلٌ جدّاً, صحيح ؟

41
00:07:43,320 --> 00:07:47,490
بالتأكيد ! بهذا, ليّس هناك شكّ بأننا يُمكنُنا تطهير

42
00:07:47,490 --> 00:07:51,190
! تلك البويّضات التيّ وُضعت في أجساد السيّد [ ترانكس ] والآخرين

43
00:07:51,260 --> 00:07:54,600
والآن بما أنك فهمت, لماذا لا تذهب وتحصل عليّه حالاً !؟

44
00:07:54,600 --> 00:07:58,970
! هـ .. هذا صحيح. عليّ أن أُسرع. حسنٌ إذاً

45
00:07:59,270 --> 00:08:02,970
... يا إلهيّ, يا إلهيّ, لقد ورّطنيّ في كثير من المتاعب

46
00:08:04,940 --> 00:08:06,610
لقد كان هذا سريّعاً جدّاً, صحيح ؟

47
00:08:06,610 --> 00:08:12,140
حسنٌ, كما تعلم, إنه ... أين هو الماء المُقدّس بالضبط ؟

48
00:08:14,280 --> 00:08:18,080
أنت, أيّها ... ما الذيّ تفعله طول الوقت بحقّ !؟

49
00:08:20,620 --> 00:08:22,290
! حاول أن تدرس قليلاً

50
00:08:22,290 --> 00:08:23,960
... أنا آسف

51
00:08:23,960 --> 00:08:26,700
! إنه فيّ قاعة العرش من المعبد فيّ برج السماء

52
00:08:26,700 --> 00:08:27,960
.فهمت هذا ؟ والآن أسرع وإذهب

53
00:08:27,960 --> 00:08:29,430
! لـ ... لقد فهمت

54
00:09:03,600 --> 00:09:05,770
! كان ذلك وشيّكاً ! كان ذلك وشيّكاً

55
00:09:05,770 --> 00:09:09,210
... حاليّاً, [ بوبو ] و [ كاميّ ] الأرض تحت سيّطرة [ بيبي ]

56
00:09:26,290 --> 00:09:31,020
من كان يعتقد بأن [ كايوشيّن ] مثليّ
! يجب عليه القيام بهذا ! تقريّباً كما لو أننيّ لصٌّ متسلّل

57
00:09:34,970 --> 00:09:36,930
.حسنٌ, هذه هيّ قاعة العرش

58
00:09:36,930 --> 00:09:40,330
! والآن إذاً, الماء المُقدّس ... هذا هو

59
00:09:43,640 --> 00:09:46,040
! هذا يجب أن يكون بالتأكيد الماء المُقدّس

60
00:09:50,910 --> 00:09:53,440
أيّ واحدٍ من هذه هو الماء المُقدّس ؟

61
00:09:57,590 --> 00:09:59,260
... ليّس هذا

62
00:09:59,260 --> 00:10:02,590
... ليّس هذا أيّضاً ... وليّس هذا أيّضاً ... وليّس هذا أيّضاً

63
00:10:02,590 --> 00:10:03,930
.يا لها من مصيبة

64
00:10:03,930 --> 00:10:09,300
سيّد [ كايوشيّن ], ما الذيّ تفعله, تأتيّ إلى هنا مثل قطّة الجيران الّلصة ؟

65
00:10:10,930 --> 00:10:14,570
,لا تقلّ ليّ بأنه حتى أنت يا سيّد [ كايوشيّن ]

66
00:10:14,570 --> 00:10:18,060
.تُحاول التدخّل في الخطط الرائعة للسيّد [ بيبي ]

67
00:10:20,280 --> 00:10:21,610
,فيّ الواقع

68
00:10:21,610 --> 00:10:25,920
,إذا كان هذا ما تُفكر به, إذاً حتى ولوّ كنت أنت يا سيّد [ كايوشيّن ]

69
00:10:25,920 --> 00:10:26,940
! لن أسمح لك بذلك

70
00:10:29,620 --> 00:10:31,050
! إنتظر

71
00:10:33,290 --> 00:10:34,190
! خذا

72
00:10:36,290 --> 00:10:37,950
مـ .. ما الذيّ تفعله !؟

73
00:10:41,630 --> 00:10:42,600
! توقف عن ذلك

74
00:10:49,240 --> 00:10:53,640
ماذا, ولا واحدٌ من هذه ؟ هل هو حقّاً هنا !؟

75
00:11:00,580 --> 00:11:02,520
! لا يُمكنُك الهرب بعد لآن

76
00:11:19,940 --> 00:11:22,610
هل يُمكن بأن يكون هذا ؟

77
00:11:22,610 --> 00:11:25,630
! مـ .. ما الأمر يا [ بوبو ] ؟ [ بوبو ]

78
00:11:26,610 --> 00:11:27,410
! خُذّ

79
00:11:34,620 --> 00:11:38,250
هـ .. هل أنتم بخيّر ؟ سيّد [ بوبو ] ؟ سيّد [ دينديّ ] ؟

80
00:11:47,960 --> 00:11:49,970
أيّن أنا !؟

81
00:11:49,970 --> 00:11:52,300
! لقد عُدتما إلى طبيّعتكما

82
00:11:52,300 --> 00:11:54,300
... سـ .. سيّد [ كايوشيّن ]

83
00:11:54,300 --> 00:11:57,470
.من المُؤكّد أن هذا هو الماء المُقدّس

84
00:11:58,310 --> 00:11:59,980
... والآن بما أننيّ عرفت

85
00:11:59,980 --> 00:12:01,640
... أيّن هو السيّد [ ترانكس ]

86
00:12:02,650 --> 00:12:03,650
! هناك

87
00:12:03,650 --> 00:12:06,550
... المعذرة, ولكنّ لا بُدّ ليّ أن أُسرع, لذلك

88
00:12:06,980 --> 00:12:08,990
.لم أفهم هذا

89
00:12:08,990 --> 00:12:10,280
... صحيح

90
00:12:37,060 --> 00:12:41,290
! سيّد [ ترانكس ], أرجوك تماسك يا سيّد [ ترانكس ]

91
00:12:44,740 --> 00:12:47,070
.خُذّ, أرجوك إشرب بعضاً من هذا

92
00:13:11,360 --> 00:13:14,030
سـ .. سيّد [ كايوشيّن ] ؟

93
00:13:14,030 --> 00:13:17,260
.سيّد [ ترانكس ] ! لقد إستيّقظت

94
00:13:17,370 --> 00:13:20,170
ما الذيّ حدث ليّ !؟

95
00:14:03,680 --> 00:14:08,670
ماذا !؟ أتُريد منيّ القضاء على [ بيبي ] !؟

96
00:14:09,690 --> 00:14:11,720
.نعم, فيّ أقرب وقتٍ ممكن

97
00:14:11,720 --> 00:14:16,250
.أنا ذاهبٌ لإعادة السيّد [ غوهان ] والسيّد [ غوتين ] إلى رُشدهم

98
00:14:18,030 --> 00:14:20,160
! حسنٌ, لقد فهمت

99
00:14:24,700 --> 00:14:27,400
.نحن نعتمدُ عليّك يا سيّد [ ترانكس ]

100
00:14:51,660 --> 00:14:54,190
مـ .. ما الذيّ حدث !؟

101
00:14:58,340 --> 00:15:00,460
! مـ .. مستحيل

102
00:15:04,680 --> 00:15:06,170
... سيّد [ بيبي ]

103
00:15:11,680 --> 00:15:15,950
! من المستحيل أن السيّد [ بيبي ] قد قضيّ عليه من قبل السيّاجين

104
00:15:15,950 --> 00:15:20,320
! أرجوك إنهض يا سيّد [ بيبي ] ! إنهض

105
00:15:33,040 --> 00:15:38,500
! سيّد [ بيبي ] إقبل هذه من فضلك ! إنهض مرّةٌ أخرى أرجوك

106
00:15:54,660 --> 00:15:56,990
! الموجة الصوتيّة, إطلاق

107
00:16:10,340 --> 00:16:13,670
! أرجوك, إنهض يا سيّد [ بيبي ]

108
00:16:57,650 --> 00:17:03,020
! مـ .. ما هذا ؟ طاقة ! إننيّ أمتلئُ بالطاقة

109
00:17:04,660 --> 00:17:08,000
ما الذيّ يجريّ !؟

110
00:17:08,000 --> 00:17:10,630
! سيّد [ بيبي ], إنها الموجات الصوتيّة

111
00:17:10,630 --> 00:17:16,270
! يتمّ غمر جسدك بالكامل بالموجات الصوتيّة, لذلك من فضلك, إستعيد قوّتك

112
00:17:35,360 --> 00:17:39,760
ما هذا ؟ ما الذيّ يحدث لغوريلّا [ بيبي ] ؟

113
00:18:01,990 --> 00:18:05,250
! أحسنتيّ عملاً ! أحسنتيّ عملاً يا [ بولما ]

114
00:18:26,010 --> 00:18:28,670
مـ .. ما هذه الطاقة القويّة !؟

115
00:18:29,350 --> 00:18:30,940
! اللعنة

116
00:18:33,350 --> 00:18:34,980
هل فات الأوان ؟

117
00:18:43,030 --> 00:18:46,290
أنت فيّ مزاجٍ جيّد, صحيح ؟

118
00:18:46,700 --> 00:18:53,000
.مرحباً ! من المؤكّد أنك قضيّت وقتاً ممتعاً, أليس كذلك ؟ لقد تعبت من الإنتظار

119
00:18:54,640 --> 00:18:58,270
.يبدو أنك تركت قوّة كافية للكلام

120
00:19:01,310 --> 00:19:05,980
... بيّنما كنت مرهقاً, لقد حصلتُ على الكثير من الراحة, كما تعلم

121
00:19:05,980 --> 00:19:09,420
,بعد كلٍّ, إن لم أستطع الحصول على القليل من المتعة فيّ قتالنا

122
00:19:09,420 --> 00:19:12,720
! فإنيّ لا أستحق أن أصبح السيّاجين الخارق 4

123
00:19:13,320 --> 00:19:15,860
! هل هذا صحيح ؟ آسف على ذلك

124
00:19:15,860 --> 00:19:21,660
! فيّ هذه الحالة, دعنا نُمتّع أنفسنا تماماً ... حتى الموت

125
00:19:23,000 --> 00:19:24,630
! هذا هو الطفل [ غوكو ]

126
00:19:24,630 --> 00:19:28,000
! بتلك الروح, لا يزال قادراً على فعلها

127
00:19:28,000 --> 00:19:31,370
هل هذا صحيح يا سيّد [ كايوشيّن ] ؟

128
00:19:37,680 --> 00:19:39,680
.لا, ليّس صحيحاً

129
00:19:39,680 --> 00:19:42,780
.كلام [ غوكو ] حيلةً لا أكثر

130
00:19:43,690 --> 00:19:46,360
هل تلك حيلة ؟

131
00:19:46,360 --> 00:19:49,590
.بالكاد لا يملك أيّ طاقة متبقية

132
00:19:49,590 --> 00:19:55,970
.إذا أراد التسديد, فيمكنه تسديد " كاميّهاميّها " واحدة عادية, وهذا كلّ ما لديّه

133
00:19:55,970 --> 00:19:58,800
! مـ .. مستحيل

134
00:20:21,320 --> 00:20:26,030
,سابقاً, لم أسيّطر على نفسيّ من الهجمات الطفوليّة والعشوائيّة

135
00:20:26,030 --> 00:20:30,760
! ولكن هذه المرّة, سوف أقتلك بالتأكيد

136
00:20:32,340 --> 00:20:36,290
! بالنسبة لك, كونك [ بيبي ] وتتصرّف بطفوليّة فعلاً لهو شيّءٌ مضحك

137
00:20:41,340 --> 00:20:44,820
,هذا سيّء. لم يتبقى ليّ أيّ طاقة

138
00:20:44,820 --> 00:20:50,290
... ذراعيّ وساقيّ تؤلماننيّ, ولا أستطيع التحرّك كما أُريد

139
00:20:50,290 --> 00:20:55,280
... بما أن هذا القتال سوف يطول, يبدو أننيّ قد أضطرّ إلى الإستسلام

140
00:20:56,290 --> 00:20:58,160
... والآن إذاً

141
00:21:01,970 --> 00:21:04,900
ما رأيُك أن نصبح جاديّن في هذا ؟

142
00:21:06,300 --> 00:21:09,110
! نعم ! دعنا نستمتعُ بما سيأتيّ

143
00:21:09,110 --> 00:21:13,570
! سوف يسمح ليّ بإظهار القوّة الحقيقيّة للسيّاجين الخارق 4

144
00:21:53,350 --> 00:21:56,920
,إستعاد غوريلّا [ بيبي ] قوّته الكاملة

145
00:21:56,920 --> 00:22:00,950
.بيّنما [ غوكو ] بالكاد أن يملك أيّ طاقة متبقية

146
00:22:18,710 --> 00:22:25,910
هل سيكون [ غوكو ] قادراً على محاربة مخرجه من هذه الأزمة الحرجة ؟