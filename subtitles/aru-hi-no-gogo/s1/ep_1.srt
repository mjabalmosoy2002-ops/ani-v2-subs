1
00:00:04,810 --> 00:00:06,400
!مرحباً يا ظريفات

2
00:00:06,400 --> 00:00:07,980
أنا أ.و.ج كاوايي آنجل
المُلقَّبة بـ ك-أنجل

3
00:00:09,480 --> 00:00:12,490
برَكة

4
00:00:14,990 --> 00:00:17,990
برَكة

5
00:00:43,520 --> 00:00:47,400
هذا غير مُمكن. بُعيد أن بدأتُ
أخيراً ببثّ ك.آنجل

6
00:00:47,400 --> 00:00:50,480
يتّصل بي هذا الوغد من العمل؟

7
00:00:50,900 --> 00:00:52,440
نعم، مرحباً؟

8
00:00:53,320 --> 00:00:55,320
أجل، آسف. أجل

9
00:00:56,660 --> 00:01:01,830
أجل. فهمت، لكن اليوم يوم إجازتي

10
00:01:03,080 --> 00:01:05,080
لا بُدّ أنّه من الشّاقّ تولّي أعمال
العناية بالأطفال، أليس كذلك يا رئيس؟

11
00:01:05,080 --> 00:01:07,040
!لا! ليس هذا ما قصدت

12
00:01:07,040 --> 00:01:08,380
المعذرة، مرحباً؟

13
00:01:08,380 --> 00:01:09,840
هل تسمعني؟

14
00:01:13,380 --> 00:01:15,170
البرد قارس

15
00:01:17,970 --> 00:01:20,930
أنا أصحو من الشّرب بعض الشّيء

16
00:01:21,140 --> 00:01:25,520
،هل يروقك؟ ألا يروقك؟ بالنّسبة لك
أنا مُجرّد سُمّ، صحيح؟

17
00:01:25,520 --> 00:01:30,230
!يروقك! رغم ذلك، ما زلت تشربه

18
00:01:32,400 --> 00:01:35,150
أبقوا عيونكم عليّ، اتّفقنا؟

19
00:01:40,370 --> 00:01:41,660
!ثلاثة

20
00:01:41,660 --> 00:01:42,990
!اثنان

21
00:01:42,990 --> 00:01:44,580
!واحد

22
00:01:56,340 --> 00:01:57,720
أيّها الظّريف

23
00:01:57,720 --> 00:02:00,590
!آسف. لم أقصد مُقاطعة تدريبكِ

24
00:02:00,590 --> 00:02:03,470
،سواء كنتُ أُغنّي أمام أرنب صغير مفقود

25
00:02:03,470 --> 00:02:07,850
أو حملان مفقودة، هذا لا يُشكّل فرقاً

26
00:02:08,350 --> 00:02:10,350
ليس عليك القلق

27
00:02:10,350 --> 00:02:13,150
كلّ تلك العلاقات في العالم الواقعيّ؟
ستنساها عمّا قريب

28
00:02:13,900 --> 00:02:16,320
سأقدّم أفضل أداء حيّ لي

29
00:02:16,320 --> 00:02:17,950
لأجلك فقط، حسناً؟

30
00:02:18,070 --> 00:02:20,160
!أكاد أموت من السّعادة الآن

31
00:02:20,160 --> 00:02:21,990
لا تمُت بعد فحسب

32
00:02:21,990 --> 00:02:23,410
فالعرض على وشك أن يبدأ

33
00:02:27,710 --> 00:02:28,910
!كنتُ أنتظر هذا

34
00:02:28,910 --> 00:02:32,330
،لا أشعر بالحياة إلّا عندما أشاهدكِ
!يا ك.آنجل

35
00:02:32,330 --> 00:02:36,420
فهمت. إن كنت ستقول هذا، فيجب
عليّ تحمُّل المسؤوليّة، صحيح؟

36
00:02:36,670 --> 00:02:39,470
شخص مُخلص للملائكة مثلك

37
00:02:39,470 --> 00:02:41,930
سيبلغ السّعادة حتماً في النّهاية

38
00:02:41,930 --> 00:02:44,430
سآتي لآخذك عندما تموت، اتّفقنا؟

39
00:02:45,060 --> 00:02:46,850
برَكة

40
00:02:45,720 --> 00:02:47,980
!وها نحن أولاء

41
00:02:47,980 --> 00:02:51,850
،خلال فترة قصيرة منذ إطلالتها الأولى
!جمعتْ بالفعل ملايين المُشتركين

42
00:02:51,850 --> 00:02:56,070
ما زالت تُحلّق إلى قمّة عالم
،البثّ كما المُذنَّب

43
00:02:56,070 --> 00:02:57,900
،ملاك الإنترنت

44
00:02:57,900 --> 00:03:00,110
،بمُنتهى الظّرافة

45
00:03:00,110 --> 00:03:01,910
!إنّها ك-آنجل

46
00:03:08,950 --> 00:03:11,170
حسناً إذاً، لندع الحكاية الخرافيّة تبدأ

47
00:03:11,790 --> 00:03:14,290
ترون حلماً لن تنسوه ما حييتم

48
00:03:14,420 --> 00:03:15,920
!ك-آنجل

49
00:03:15,920 --> 00:03:19,510
!ثلاثة! اثنان! واحد

50
00:03:20,930 --> 00:03:24,010
أبتسم لك كما الملاك

51
00:03:24,010 --> 00:03:26,850
هلوَسة شديدة، فتاة الإنترنت

52
00:03:26,850 --> 00:03:30,100
تهمس في أذنك كشيطان

53
00:03:30,100 --> 00:03:33,480
مُحزن بالنّسبة لك فقط، فتاة مُلِحّة

54
00:03:51,210 --> 00:03:53,000
برَكة

55
00:04:37,420 --> 00:04:38,880
اذهبي وأحضري بعض مشروبات الطّاقة

56
00:04:38,880 --> 00:04:40,170
لديّ عمل اليوم

57
00:04:53,930 --> 00:04:55,980
هذا العالم مجنون

58
00:04:56,060 --> 00:04:57,770
،منذ ظهور وسائل التّواصل الاجتماعيّ

59
00:04:57,770 --> 00:05:03,320
المظهر والشّعبيّة والدّخل وعدد الأصدقاء
،وتاريخ العلاقات ومستوى الذّكاء

60
00:04:59,570 --> 00:05:01,400
يا فتاة، أنتِ ظريفةٌ حقّاً

61
00:05:01,400 --> 00:05:03,320
لديّ عمل بدوام جزئيّ يمنح
أجراً خياليّاً. مُهتمّة؟

62
00:05:03,320 --> 00:05:06,490
كلّ إحصائيّة مُمكنة تحوّلتْ إلى
عدد ووُضِعت تحت المُراقبة

63
00:05:03,320 --> 00:05:06,950
،لم أركِ منذ وقت طويل! تتذكّرينني
أليس كذلك؟ هذا أنا

64
00:05:06,490 --> 00:05:11,080
،الجميع يعلمون بأنّ هذا غير طبيعيّ
لكن لا يستطيع أحدٌ التكلُّم

65
00:05:06,950 --> 00:05:09,160
!لا تتجاهليني

66
00:05:11,080 --> 00:05:13,080
،مهما كانت مُعتقداتك خطيرة
،مهما كنت مُزعجاً

67
00:05:13,080 --> 00:05:14,460
...لا يهمّ إن نلت شعبيّة بفضيحة

68
00:05:14,460 --> 00:05:16,790
كلّما برزت أكثر، ازدادت أرقامك

69
00:05:16,790 --> 00:05:18,250
"واعتدت على قياس "قيمتك الاجتماعيّة

70
00:05:18,250 --> 00:05:21,590
وقيمة اجتماعيّة مُنخفضة؟
هذا يؤثّر بك في الحياة الواقعيّة مُباشرة

71
00:05:21,590 --> 00:05:24,510
.لا يستطيع أحدٌ الإفلات من الأرقام
أو مُجتمع المُراقبة

72
00:05:26,090 --> 00:05:27,800
،،التّظاهر بأنّك لا تُبالي للآخرين

73
00:05:27,800 --> 00:05:29,680
لكنّك مع ذلك لا تستطيع تحطيم
الهاتف الّذي تحمله

74
00:05:31,640 --> 00:05:33,600
هذا العالم مجنون

75
00:05:33,680 --> 00:05:36,190
كاتشي@
رائدة في فنّ الأظافر
في أكاديميّة التّجميل شيبويا
الظّهور كضيفة: ساعيّاً + مبيعات
%نوع الرّزمة 40% إلى 70

76
00:05:41,150 --> 00:05:42,190
صباح الخير

77
00:05:49,870 --> 00:05:52,160
الحليب يُعزّز حواسك

78
00:05:54,330 --> 00:05:56,620
...شديد العنف

79
00:05:56,830 --> 00:05:59,500
!التّحضير... قد اكتمل

80
00:05:59,500 --> 00:06:01,090
!اكتمل

81
00:06:01,420 --> 00:06:05,300
أنتِ! أعطيني رقمكِ سرّاً، اتّفقنا؟

82
00:06:05,760 --> 00:06:08,090
ألم تُفكّري يوماً في أن تكوني عشيقة؟

83
00:06:10,260 --> 00:06:12,890
،أريد إجراء عمليّة جراحيّة تجميليّة
لذا أريد السّفر إلى كوريا

84
00:06:12,890 --> 00:06:14,350
لكن عليّ ادّخار مليونين تقريباً

85
00:06:14,350 --> 00:06:16,390
مُحال أن تدّخري ذلك

86
00:06:16,390 --> 00:06:18,520
ألا يمكنكِ الحصول على المزيد
من ذلك الكهل؟

87
00:06:18,520 --> 00:06:21,940
!اكتمل التّحضير

88
00:06:21,940 --> 00:06:23,860
لا. ذلك الرّجل مُفلس الآن

89
00:06:23,860 --> 00:06:26,650
،وأيضاً هذا هو الأمر الأسوأ
قد أُصاب بأمراض جنسيّة مُعدية

90
00:06:26,650 --> 00:06:28,360
بئساً. بجدّية؟

91
00:06:28,360 --> 00:06:31,620
،بصراحة، لو لم تُولَدي بجفن مُزدوج
لفقدتِ الامتياز الأبويّ

92
00:06:31,620 --> 00:06:35,410
!اكتمل التّحضير

93
00:06:35,490 --> 00:06:37,450
أتريدان التنزُّه معنا؟

94
00:06:38,040 --> 00:06:41,420
ماذا؟ نحن؟ لماذا فجأة؟

95
00:06:41,420 --> 00:06:44,130
.ستأتي مجموعة من الرّجال الوسيمين
لا أريد تفويت ذلك

96
00:06:44,130 --> 00:06:45,750
فكلتاكما ظريفتان

97
00:06:46,380 --> 00:06:50,090
أرحّب بالفكرة، لكنّنا لسنا مُهتمّتين بذلك

98
00:06:50,090 --> 00:06:55,430
يا للخسارة! حسناً، لا جدوى
من مُحاولة إقناعكما. آسفة

99
00:06:55,930 --> 00:06:57,180
أتريدين التنزُّه معنا؟

100
00:06:57,180 --> 00:06:58,810
ما رأيك؟

101
00:07:02,650 --> 00:07:04,400
قمامة

102
00:07:05,520 --> 00:07:07,320
!كاتشي! كاتشي

103
00:07:07,690 --> 00:07:08,740
نعم؟

104
00:07:08,740 --> 00:07:10,570
هل لديكِ حبيب أو ما شابه؟

105
00:07:10,570 --> 00:07:11,700
لا

106
00:07:11,700 --> 00:07:13,950
إذاً في المرّة المُقبلة، لنذهب
إلى مكان ما

107
00:07:15,490 --> 00:07:18,790
.حقّقتُ جائزة في الباتشينكو قبل أيّام
لديّ مال الآن

108
00:07:18,790 --> 00:07:21,670
هل تسمعينني أصلاً؟ ماذا؟ هل أنتِ ثملة؟

109
00:07:30,470 --> 00:07:32,010
انقلعا وموتا

110
00:07:32,340 --> 00:07:35,470
...كيلر كوين

111
00:08:17,470 --> 00:08:19,720
أجل. أنا بخير

112
00:08:19,720 --> 00:08:25,100
بوجودي أنا وبي، يمكننا أن نصبح
مُؤدّيتَي البثّ الأوليتين في العالم

113
00:08:25,730 --> 00:08:31,780
حتّى في عالم قبيح كهذا، على الأقلّ
نحن الاثنتان لن ننسى كيف نتألّق

114
00:08:34,240 --> 00:08:37,780
لكن قد لا يدوم ذلك للأبد

115
00:08:38,370 --> 00:08:40,490
بي، أُحبّك

116
00:08:41,000 --> 00:08:45,830
لا يمكنني السّعي جاهدة هكذا
إلّا بوجودك يا بي

117
00:08:47,880 --> 00:08:50,550
أُحبّك

118
00:08:50,550 --> 00:08:51,800
أُحبّك حُبّاً جمّاً

119
00:08:52,550 --> 00:08:53,800
تصبحين على خير

120
00:08:57,970 --> 00:09:01,180
تلك الفتاة ميتشيكا كانت زميلتكِ
في الصّفّ، أليس كذلك؟

121
00:09:01,180 --> 00:09:03,770
أجل. ما زلنا نخرج معاً أحياناً

122
00:09:03,770 --> 00:09:05,810
في المرّة المُقبلة، دعيني أُقابلها

123
00:09:05,810 --> 00:09:06,850
لا

124
00:09:06,850 --> 00:09:08,650
بربّكِ

125
00:09:08,650 --> 00:09:11,650
قد تُمرّر لي بعض أعمال تأليف
الموسيقى أو ما شابه

126
00:09:11,650 --> 00:09:14,820
لِمَ عليها أن تمنح عملاً لهاوٍ؟

127
00:09:14,990 --> 00:09:17,320
لم تعُد تتمرّن حتّى

128
00:09:17,530 --> 00:09:20,660
اصمتي. سوف أنجح نجاحاً مُبهراً

129
00:09:22,370 --> 00:09:26,790
لا يسعنا فعل شيء. ليس
وكأنّنا نمتلك أي موهبة مُميّزة

130
00:09:26,790 --> 00:09:29,080
لذا لا تتصرّف بفوقيّة وعجرفة كما لو أنّك إله

131
00:09:29,080 --> 00:09:32,590
يعتقد أولئك النّاس بأنّ المُؤثّرين
!من عالم آخر

132
00:09:32,590 --> 00:09:34,340
ويقولون ما يحلو لهم فحسب

133
00:09:34,470 --> 00:09:36,800
،لأنّهم إذا اعترفوا بأنّنا بشر مثلهم فحسب

134
00:09:36,800 --> 00:09:40,100
،فسيفكّرون بأفكار جنونيّة مثل
"لِمَ لا أستطيع أن أصبح هكذا؟"

135
00:09:40,100 --> 00:09:44,230
لذا بدلاً من ذلك، إمّا يتنمّرون علينا كما لو أنّنا
لسنا بشراً، أو يُقدّسوننا بهوَس

136
00:09:44,230 --> 00:09:47,850
تتكلّمين بكلام أكبر منكِ، لكن الجميع
ينفجرون غضباً عاجلاً أم آجلاً

137
00:09:47,850 --> 00:09:50,520
تلقّيتِ انتقاداً مرّات كثيرة أيضاً

138
00:09:50,520 --> 00:09:52,480
هُم لا ينتقدون فحسب. إنّهم يحرقونكِ

139
00:09:52,480 --> 00:09:54,780
،إذا لم يستطيعوا الوصول إليكِ
يُشعلون النّار فيكِ

140
00:09:54,780 --> 00:09:58,160
انتقاء كلّ كلمة وفعل كفيل
بجعلهم يشعرون بالرِّضا

141
00:09:58,160 --> 00:09:59,870
إنّهم مُدمنون على الثّورة

142
00:09:59,870 --> 00:10:04,250
،هذا لا يُساهم في بثّ الرُّوح في نفوسهم
إنّهم أحياء فقط لرؤية المقصلة تهوي

143
00:10:01,830 --> 00:10:03,160
!موتي

144
00:10:06,410 --> 00:10:08,580
ماذا يُفترض بنا أن نفعل إذاً؟

145
00:10:08,580 --> 00:10:11,210
عليهم التوقُّف فحسب عن مُقارنة
أنفسهم بالآخرين

146
00:10:11,210 --> 00:10:16,050
،ومع ذلك يفتحون هواتفهم بأنفسهم
ويتّصلون بجمهرة غفيرة من الغُرباء

147
00:10:16,050 --> 00:10:19,090
يُقارنون أنفسهم بالنّاس الّذين
أعلى منهم ويغرقون في وحل الكآبة

148
00:10:19,090 --> 00:10:22,220
يعرفون معنى السّعادة، لكن لا ينفكّون
يتظاهرون بأنّهم بائسون

149
00:10:23,100 --> 00:10:25,520
لا بُدّ أن يتحمّل شخصٌ الألم

150
00:10:25,520 --> 00:10:30,100
لذا الشّخص الّذي تمّ إنقاذه هنا
...يمكنه الذّهاب لإنقاذ شخص آخر

151
00:10:31,400 --> 00:10:32,820
كنتُ أُشاهد ذلك

152
00:10:32,820 --> 00:10:36,360
من يأبه لفتاة غريبة أطوار كهذه؟
إنّها مُريبة

153
00:10:37,820 --> 00:10:42,070
الأهمّ، خسرتُ ثانية اليوم لأنّ
زملائي في الفريق كانوا سيّئين

154
00:10:44,660 --> 00:10:46,040
ألا يُفترض أن تتمرّن على الغيتار؟

155
00:10:46,040 --> 00:10:48,120
...قلتُ بأنّني سأفعل. بالمناسبة

156
00:10:49,120 --> 00:10:50,750
أتساءل ما إن كان أولئك الأشخاص

157
00:10:50,750 --> 00:10:53,880
في المقهى البيئيّ الخاصّ بكِ سيفقدون
صوابهم إذا اكتشفوا بأنّ لديكِ حبيب

158
00:10:54,920 --> 00:10:56,920
أنا مُرهَقة

159
00:10:58,380 --> 00:10:59,720
تماسكي

160
00:11:01,140 --> 00:11:02,680
!توقّف

161
00:11:04,470 --> 00:11:05,600
لا

162
00:11:05,720 --> 00:11:07,270
لا أريد ذلك

163
00:11:10,350 --> 00:11:13,020
!حسناً إذاً يا رفاق. كونوا أقوياء

164
00:11:13,020 --> 00:11:16,320
لا تنخدعوا بواسطة مُنتحلي روك-أند-رول مُزيّف

165
00:11:16,320 --> 00:11:19,990
.إذا كرهتُم شيئاً، قولوا بأنّكم تكرهونه
إن كان مُقرفاً، قولوا أنّه كذلك

166
00:11:20,110 --> 00:11:22,360
!ونظّفوا أنفسكم جيّداً في الحمّام

167
00:11:22,360 --> 00:11:23,910
!فرّشوا أسنانكم

168
00:11:23,910 --> 00:11:27,040
مهما حدث، ستستمرّ ك.آنجل في رعايتكم

169
00:11:27,040 --> 00:11:29,540
من الجانب الآخر من الشّاشة، بريق

170
00:11:29,540 --> 00:11:30,870
!برَكة

171
00:11:30,870 --> 00:11:32,370
لا

172
00:11:33,170 --> 00:11:35,920
ما هذا اللّباس؟ هل تركت المدرسة؟

173
00:11:35,920 --> 00:11:37,340
إنّه جميل، أليس كذلك؟

174
00:11:37,340 --> 00:11:38,460
مُجرّد حجب عقلكِ

175
00:11:38,460 --> 00:11:41,880
واتّباع القواعد المدرسيّة الخاصّة
...بارتداء الزيّ الرّسميّ كعبد

176
00:11:41,880 --> 00:11:45,300
أردتُ تمزيقه في أسرع وقت مُمكن

177
00:11:45,760 --> 00:11:49,310
ميتشيكا، هل تبغضين المدرسة إذا هذا الحدّ؟

178
00:11:49,310 --> 00:11:55,310
أجل. إنّه مُجرّد مصنع يُحوّلنا
إلى مُسنّنات للمُجتمع

179
00:11:55,310 --> 00:11:58,820
لا أنوي أن أصبح قطعة آلة صدِئة

180
00:11:59,030 --> 00:12:01,320
لستُ بحاجة للاستمرار في الحضور

181
00:12:01,490 --> 00:12:04,700
سأذهب إلى مكان أكثر حرّيّة

182
00:12:04,700 --> 00:12:07,950
مكان أستطيع أن أصبح فيه
الأميرة الأجمل على الإطلاق

183
00:12:19,340 --> 00:12:22,550
إلى أولئك الّذين على وشك أن يُغمى
...عليهم بسبب سعلة شديدة

184
00:12:23,340 --> 00:12:28,260
اليوم دعينا خبيرة في ثقافة الإنترنت للانضمام معنا

185
00:12:28,260 --> 00:12:30,350
شكراً على انضمامكِ معنا هنا

186
00:12:30,350 --> 00:12:32,810
شكراً على استضافتي

187
00:12:33,140 --> 00:12:37,310
في هذه الأيّام، أصبح الشّباب مغسولي
الدّماغ بواسطة ثقافة ستان

188
00:12:33,140 --> 00:12:37,310
مُلاحظة: ستان هو أحد المُعجبين الخياليّين
بمُغنّي الرّاب إيمينيم إلى حدّ الخطورة

189
00:12:37,310 --> 00:12:41,280
يُقدّسون النّجوم الّذين يدعمونهم
،كما لو أنّهم آلهة

190
00:12:41,280 --> 00:12:43,610
ويسمحون لأنفسهم بالانجرار خلفهم

191
00:12:43,610 --> 00:12:46,410
،ورغم امتلاكهم تأثير هائل

192
00:12:46,410 --> 00:12:50,910
ينشرون تعليقات غير مُلائمة، ويتعاطون
المُخدّرات ويؤدّون عروضاً مُتطرّفة

193
00:12:50,910 --> 00:12:53,460
المُؤثِّرون المُجرّدون من الأخلاق
يصبحون مُعضِلة حقيقيّة

194
00:12:53,460 --> 00:12:56,290
ابنتي متأثِّرة بها أيضاً

195
00:12:56,290 --> 00:12:59,590
أحياناً تبثُّ في وقت متأخّر من اللّيل
،عندما تشعر بالكآبة

196
00:12:59,590 --> 00:13:02,300
وأخشى أن تبدأ برؤية نفسها في تلك الفتاة

197
00:13:02,300 --> 00:13:05,430
أخشى من أن يكبر الصّغار الّذين يُقدّسون
،هؤلاء المُؤثّرين، وهذه الأوهام

198
00:13:05,430 --> 00:13:08,390
دون أي حسّ بالاعتدال

199
00:13:08,390 --> 00:13:10,600
وحسبما فهمت، لم تُكمل دراستها
في الثّانوية حتّى

200
00:13:10,600 --> 00:13:16,980
أتفهّم بأنّ سبب انجرار الجيل الأصغر خلفها
هو لأنّها فظيعة وخارج المألوف

201
00:13:16,980 --> 00:13:19,770
،لكن إذا كان هذا ما هو رائج
فإنّها نهاية الإنترنت حقّاً

202
00:13:19,770 --> 00:13:23,570
إذا استمرّ هذا التأثير الضّارّ الّذي
،يُشكّله المؤثّرون في الانتشار

203
00:13:23,570 --> 00:13:28,280
فقد لا نملك خياراً سوى التّفكير في مُراقبة
وتنظيم بثّ الفيديو الشّبابيّ بحدّ ذاته

204
00:13:28,280 --> 00:13:30,330
،نتحدّث عن أشهر شخصيّة اليوم

205
00:13:30,330 --> 00:13:34,120
الأكثر تسبُّباً بمشاعر القلق
...من التأثير السّلبيّ، إنّها

206
00:13:34,290 --> 00:13:37,420
ك.آنجل

207
00:13:35,750 --> 00:13:36,710
تلك الفتاة الملاك

208
00:13:37,420 --> 00:13:38,710
أ.و.ج كاوايي آنجل

209
00:13:40,790 --> 00:13:44,760
،أنا أعيش كما يحلو لي فحسب
بصِفتي ملاك الإنترنت

210
00:13:44,760 --> 00:13:48,090
حتّى إن لم أرتد المدرسة، حتّى
،لو كنتُ مُكتئبة، حتّى لو آذيتُ نفسي

211
00:13:48,090 --> 00:13:51,310
كلّ هذا دليلٌ على أنّني أنا

212
00:13:51,310 --> 00:13:53,970
سأعيش دون إخفاء أي جزء من ذلك

213
00:13:54,850 --> 00:13:58,480
تجاهلتموني عندما كنتُ نكرة

214
00:13:58,480 --> 00:14:01,650
لكن حالما بدأتُ أزدهر، لجأتم
إلى تمزيق شخصيّتي

215
00:14:01,650 --> 00:14:04,030
تشتهون دوماً أيّ تشويق جديد مُقبل

216
00:14:04,030 --> 00:14:06,650
وعندما يتألّق شخص، تحسدونه وتُدمّرونه

217
00:14:06,650 --> 00:14:08,570
أنانيّة بحتة

218
00:14:08,570 --> 00:14:12,910
لكن عمل الملاك هو احتضان حتّى
فوضى العالم البائس هذا

219
00:14:15,370 --> 00:14:19,080
!لن تخسر ك.آنجل أمام مجموعة انتقادات
!سوف أمضي وأستمرّ

220
00:14:19,080 --> 00:14:22,880
!لأنّ هناك الكثير منكم يُشجّعونني

221
00:14:32,260 --> 00:14:34,890
،سواء كنت ثنائيّ القطب أو لا
دع الأمر لي

222
00:14:37,390 --> 00:14:39,900
في عصرنا هذا، ما هو أهمّ شيء الآن؟

223
00:14:40,940 --> 00:14:42,310
إنّه الأحلام

224
00:14:42,310 --> 00:14:44,820
يريد الجميع فقط أن يستمرّوا
في رؤية أحلام طويلة وسعيدة

225
00:14:44,820 --> 00:14:46,650
،إنّهم خائفون من العودة إلى الواقع

226
00:14:46,650 --> 00:14:49,820
لذا يُفضّلون السّباحة بصورة مُريحة
في عالم يُلائمهم

227
00:14:49,820 --> 00:14:52,660
أليس كونكِ الشّخص الّذي يصنع
أحلام الآخرين يُجهدكِ؟

228
00:14:54,160 --> 00:14:55,410
الجميع يشعرون بالإجهاد

229
00:14:56,080 --> 00:14:58,080
هل سبقَ وأردتِ الموت يوماً؟

230
00:14:59,460 --> 00:15:00,420
في كلّ ليلة

231
00:15:00,710 --> 00:15:03,920
ك.آنجل، هل تعيشين في عالم
الأحلام ذاك طوال الوقت؟

232
00:15:04,170 --> 00:15:10,220
،لا! إذا كنتُ سأُري الجميع أحلاماً
فعليّ النّظر إلى العالم الحقيقيّ أيضاً

233
00:15:10,220 --> 00:15:13,470
هكذا نتعلّم صنع السّلام
مع مُحيطنا ونصبح بالغين

234
00:15:13,470 --> 00:15:14,970
أنتِ بالغة إذاً؟

235
00:15:15,310 --> 00:15:16,430
لا

236
00:15:23,060 --> 00:15:27,150
لستُ مُجرّد ساذجة مُولعة بالخُرافات
لدرجة أفقد فيها رؤية الواقع

237
00:15:27,320 --> 00:15:30,650
هل هذا يعني إذاً بأنّكِ ستبقين
طفلة للأبد يا ك.آنجل؟

238
00:15:30,740 --> 00:15:32,450
مُحال

239
00:15:37,830 --> 00:15:40,830
لكن حالما تنتهي صلاحيّته، سترمونني فوراً، صحيح؟

240
00:15:40,830 --> 00:15:42,420
هذه هي نقطة التحوُّل

241
00:15:45,790 --> 00:15:49,590
أجريتِ بثّاً أثناء الإفراط
في تعاطي الأدوية من قبل

242
00:15:49,590 --> 00:15:51,220
ما رأيكِ بالنّقد الّذي يُفيد

243
00:15:51,220 --> 00:15:54,180
بأنّكِ مُضرّة لتربية الأطفال وتُشكّلين
تأثيراً سلبيّاً على المُجتمع؟

244
00:15:54,300 --> 00:15:55,970
!معكِ كلّ الحقّ

245
00:15:57,010 --> 00:16:04,270
لم أفكّر يوماً في التّربية، لذا
!انتقدوني كما تشاؤون رجاء

246
00:16:04,480 --> 00:16:05,860
أنا هي أنا فحسب

247
00:16:05,860 --> 00:16:08,730
،إذا قلّدني طفلٌ وبدأ يسيء السّلوك
فهذه ليست مُشكلتي

248
00:16:08,730 --> 00:16:10,740
لم أطلب من أحد أن يفعل ذلك أبداً

249
00:16:10,740 --> 00:16:15,530
،عندما يلقي النّاسُ اللّوم على الآخرين
فحينئذ تتفاقم الأمور وتقع أخطاء أكبر

250
00:16:15,530 --> 00:16:19,120
وفضلاً عن ذلك، لا أحد يعيش على أنّه
الصّواب" طوال الوقت"

251
00:16:19,120 --> 00:16:21,370
،بدلاً من الغضب وحظر الأشياء

252
00:16:21,370 --> 00:16:25,460
لِمَ لا نبدأ بمعرفة سبب أذى أولئك الأطفال؟

253
00:16:27,460 --> 00:16:28,210
هكذا إذاً

254
00:16:28,840 --> 00:16:32,090
الجميع يريدون الاستماع فحسب

255
00:16:32,550 --> 00:16:36,050
،إذا استطعت سماع بُكاء الأطفال حولكِ

256
00:16:36,050 --> 00:16:38,970
فهذا يعني أنّ هذا البلد لا يزال يمتلك مُستقبلاً

257
00:16:38,970 --> 00:16:41,350
!اصمتي

258
00:16:42,060 --> 00:16:46,980
.بثّ الانهيار العصبيّ الّذي أجريتِه قد اشتهر
كسبتِ الكثير من المُعجبين الجدُد والكارهين الجدُد، صحيح؟

259
00:16:47,230 --> 00:16:49,480
يعشق النّاس التّحفيز

260
00:16:49,650 --> 00:16:52,280
السّمُّ والدّواء وجهان لعملة واحدة

261
00:16:54,740 --> 00:16:56,950
إذاً هذا يمنحكِ بهجةً في حياتكِ؟

262
00:16:57,160 --> 00:16:59,200
!إطلاق النّار على النّاس في ألعاب الفيديو

263
00:16:59,540 --> 00:17:01,200
حسناً، وبعد؟

264
00:17:01,330 --> 00:17:04,540
التّواجد على الهاتف مع أصدقائي أثناء
!إطلاق النّار على النّاس في ألعاب الفيديو

265
00:17:05,000 --> 00:17:06,040
!جميل

266
00:17:06,670 --> 00:17:10,840
والانجذاب إلى الشّباب الّذين يريدون المُصاحبة
!فقط أثناء سحقنا للعدوّ

267
00:17:11,460 --> 00:17:13,220
لا بأس بكِ

268
00:17:13,220 --> 00:17:14,970
أتريدين الانضمام لي يا ك-آنجل؟

269
00:17:14,970 --> 00:17:17,640
بثّي مُموّل كما تعلمين

270
00:17:17,640 --> 00:17:18,720
أنا لا أقبل بما هو رخيص

271
00:17:18,720 --> 00:17:22,220
تتلقّين أجراً مُقابل قتل الكثير من النّاس؟
!يا للرّوعة

272
00:17:22,220 --> 00:17:24,350
كما في الحياة الواقعيّة، صحيح؟

273
00:17:29,520 --> 00:17:32,360
أصبح عدد السكّان كبير جدّاً
وكلّ شيء يحتدم

274
00:17:32,360 --> 00:17:34,570
الأشخاص الّذين كانوا هنا أوّلاً
وفقدوا مكانهم

275
00:17:34,570 --> 00:17:37,660
يتفاقم استياؤهم كثيراً

276
00:17:37,660 --> 00:17:40,080
بينما النّاس العاديّين الّذين
لم يعتادوا على الإنترنت

277
00:17:40,080 --> 00:17:42,450
يتفوّهون بكلام مسيء دون تفكير

278
00:17:42,620 --> 00:17:44,910
،الرّجال والنّساء يتشاجرون دون توقُّف

279
00:17:44,910 --> 00:17:49,500
ومزيد ومزيد من النّاس يربحون من إثارة
النّزاعات وشحن الفوضى

280
00:17:49,710 --> 00:17:53,460
الصّغار الّذين لا يملكون المال، ولا يعرفون
،أي بالغ يمكنهم الوثوق به

281
00:17:53,460 --> 00:17:57,890
فيلجؤون لتقديس مُؤدّيي بثّ مثلي
ويحوّلون مسؤوليّة حياتهم على عاتقنا

282
00:18:05,430 --> 00:18:08,310
الجميع يصبحون مجانين تدريجيّاً

283
00:18:08,310 --> 00:18:11,650
"لكن ما زالوا يعتقدون بأنّ هذا "أكثر متعة
من الواقع، على الأقلّ حاليّاً

284
00:18:11,650 --> 00:18:14,530
الحقيقة الكاملة تحتاج لشجاعة

285
00:18:14,940 --> 00:18:19,410
نُكافح الفوضى بطريقة ما مُحاولين
ألّا نتعرّض لهجوم

286
00:18:19,410 --> 00:18:21,910
وندمج تفكيرنا مع وسائل التّواصل
الاجتماعيّ بحدّ ذاته

287
00:18:23,540 --> 00:18:25,870
شكراً لوقتك على هذه المُقابلة

288
00:18:28,960 --> 00:18:30,420
سؤال آخر فحسب

289
00:18:30,630 --> 00:18:33,420
هل من رأي تدلين به حول المجموعة
الرّائجة مُؤخّراً، كارامازوف؟

290
00:18:34,050 --> 00:18:36,010
إنّها مُميّزة

291
00:18:36,010 --> 00:18:38,430
بريق روحها مُختلف

292
00:18:38,630 --> 00:18:42,680
أحياناً تبدو كملاك حقيقيّ وأحياناً تبتسم كشيطان

293
00:18:42,850 --> 00:18:46,060
أعتقد إنّه التأرجح الكبير بين الشّخصيّتين
هو ما يجعلها فاتنة

294
00:18:46,060 --> 00:18:48,940
تنظر للأمور بشكل مُختلف
عن الأشخاص العاديّين

295
00:18:50,020 --> 00:18:53,070
لكن في النّهاية، سوف أتفوّق عليها

296
00:18:53,070 --> 00:18:57,650
أنا متأكّدة حتّى هي تشعر بخطر
بواسطة زخم كارامازوف

297
00:18:57,650 --> 00:19:01,030
حتّى ملاك الإنترنت الشّهيرة تبقى بشريّة

298
00:19:01,030 --> 00:19:03,780
هذا العالم غزير بالسُّموم

299
00:19:03,780 --> 00:19:08,710
رويداً رويداً، سوف يلتهم ذلك قدسيّتها

300
00:19:09,500 --> 00:19:13,210
البعض يقولون بأنّهم قد يُشكّلون
خطراً عليكِ. ما رأيكِ؟

301
00:19:14,800 --> 00:19:16,710
مَن كارامازوف؟

302
00:19:17,460 --> 00:19:19,260
لم أسمع بهم من قبل

303
00:19:26,020 --> 00:19:27,980
فتاة السمّ المُميت دينبا
مصّاصة أرجوانيّة

304
00:19:31,850 --> 00:19:37,940
،لستُ مهتمّاً تماماً بالآخرين
،لكن إذا غارت قائدتنا في كلّ ليلة

305
00:19:37,940 --> 00:19:40,150
فلا بُدّ أنّها مُعجبة بها فعلاً إذاً

306
00:19:40,150 --> 00:19:41,320
!ماذا؟

307
00:19:41,820 --> 00:19:46,370
قالت بأنّها بدأت بالبثّ لأنّ ك-آنجل مثلها الأعلى

308
00:19:46,700 --> 00:19:48,700
نيتشيكا-ساما

309
00:19:48,700 --> 00:19:51,870
!نيتشيكا الأحمق! لا تختلق مثل هذه الأمور

310
00:19:52,120 --> 00:19:58,550
مُخطَّط الألوان المُبهرجة هذا والمُصمَّم
للفت أنظار الجماهير لا يُلائم ذوقي

311
00:19:59,840 --> 00:20:01,800
ميتشيكا غوكوبارا

312
00:20:04,890 --> 00:20:08,430
لكن أعتقد بأنّ حسّنا الجماليّ الأرجوانيّ
ليس رقيقاً أيضاً

313
00:20:08,430 --> 00:20:10,060
!أنتما

314
00:20:21,400 --> 00:20:25,660
ميتشيكا، سمعتُ بأنّ اليوم كانت مُناوبة
الضّيف الأوّل لصديقتك، صحيح؟

315
00:20:27,790 --> 00:20:28,740
ماذا؟

316
00:20:28,740 --> 00:20:31,000
أنتِ تقسين كثيراً على صديقتكِ

317
00:20:31,000 --> 00:20:33,960
لستُ مُهتمّة بما يحدث في العالم الأدنى

318
00:20:33,960 --> 00:20:37,460
أعتقد بأنّ صديقتكِ لديها وجه
جميل أيضاً. أليس كذلك يا كاتشي؟

319
00:20:41,130 --> 00:20:46,300
القدرة على المشي بينما يُغطّيهم الوحل
هو امتياز محجوز للعوام

320
00:21:05,030 --> 00:21:05,990
أريد أن أموت

321
00:22:37,330 --> 00:22:39,040
!إنّها مُتغطرسة

322
00:22:39,330 --> 00:22:42,040
!إنّها مُغترّة جدّاً بنفسها

323
00:22:42,590 --> 00:22:45,550
تتصرّف وكأنّها تستطيع فعل
،كلّ شيء بمفردها

324
00:22:45,550 --> 00:22:48,340
وكأنّها مُستميتة ليراها الجميع

325
00:22:48,340 --> 00:22:52,260
ومع ذلك، أعتقد بأنّها جميلة

326
00:22:52,510 --> 00:22:55,980
،قد لا أعدو كوني من العوام

327
00:22:55,980 --> 00:23:00,230
لكن أتفهّم ما يعنيه أن نمتلك روحاً

328
00:23:00,310 --> 00:23:02,520
سأكون أنا من يقتلها

329
00:23:02,520 --> 00:23:04,860
لن أسمح لأحد آخر بفعلها

330
00:23:05,320 --> 00:23:08,700
!سأقتلها ثمّ أموت أيضاً

331
00:23:23,380 --> 00:23:24,250
!بام

332
00:24:25,020 --> 00:24:27,020
الحلقة القادمة

333
00:24:26,070 --> 00:24:31,110
شعاع من الضّوء، يُنير الإنترنت الفوضويّ
اليوم، أ.م.ج كاوايي آنجل

334
00:24:31,240 --> 00:24:33,990
مجموعة البثّ الواعدة، كارامازوف

335
00:24:34,240 --> 00:24:36,870
طريقان يتقاطعان تحت الضّوء

336
00:24:36,870 --> 00:24:39,410
"الحلقة القادمة، "نحن الاثنان فقط

337
00:24:38,040 --> 00:24:40,040
الحلقة 2