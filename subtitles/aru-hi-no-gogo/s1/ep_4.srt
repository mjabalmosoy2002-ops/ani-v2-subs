1
00:00:00,600 --> 00:00:02,270
ليتكِ تفهمينني

2
00:00:02,480 --> 00:00:05,440
المُعاناة المُرافِقة لعَيش حياة
طبيعيّة ببساطة

3
00:00:06,150 --> 00:00:08,520
لا أقول بأنّني مُحاطة بظرف
فظيع على وجه الخصوص

4
00:00:08,520 --> 00:00:11,190
بكلّ تأكيد، هناك أمور مُزعجة
ومُحزِنة كثيرة

5
00:00:11,650 --> 00:00:13,490
...انفصال، شِجار

6
00:00:13,490 --> 00:00:15,660
العديد من الأمور الّتي تجعلني
أشعر بالتّعاسة

7
00:00:14,070 --> 00:00:15,660
آسفة! هل انتظرتِ طويلاً؟

8
00:00:15,660 --> 00:00:16,910
لا! إطلاقاً

9
00:00:17,240 --> 00:00:19,660
لكن كلّ هذا طبيعيّ أيضاً

10
00:00:18,200 --> 00:00:19,660
حسناً، إلى أين تريدين الذّهاب؟

11
00:00:19,660 --> 00:00:21,410
هناك مقهى كنتُ أريد الذّهاب إليه

12
00:00:21,620 --> 00:00:22,910
أنا عاديّة

13
00:00:23,580 --> 00:00:26,830
الأفراح والأحزان المعتادة الّتي
يستطيع أيّ شخص تخيّلها

14
00:00:26,830 --> 00:00:28,420
النّجاح والفشل

15
00:00:28,670 --> 00:00:31,050
الذّهاب إلى الشّاطئ رفقة أصدقاء
والبولينغ والكاراوكي

16
00:00:31,050 --> 00:00:34,130
.الذّهاب إلى حوض الأسماك مع حبيبي
مُواعدة الكريسماس في المنزل

17
00:00:34,300 --> 00:00:36,720
جميعها تجارب رائعة باعتقادي

18
00:00:36,970 --> 00:00:39,510
بالنّسبة لي، إنّها ذكريات ثمينة

19
00:00:39,720 --> 00:00:41,020
...لكن

20
00:00:41,020 --> 00:00:45,140
من وجهة نظر النُّجوم ذات القدر الظّاهريّ
،اللّامعة الّتي تسطع في السّماء

21
00:00:45,270 --> 00:00:49,480
إنّها أحداثٌ ضئيلةٌ جدّاً، مُتناهية الصِّغَر
لدرجة أنّها لا تعدو كونها حبّات رمل

22
00:00:49,730 --> 00:00:52,070
بالنّسبة لأشخاص أمثالك، مَن
،تجذبين عشرات ملايين المُعجبين

23
00:00:52,070 --> 00:00:53,740
،وتصقلين عوالمكِ الفريدة الخاصّة

24
00:00:53,740 --> 00:00:57,320
وتستمرّين في الارتقاء
،جسداً وعقلاً

25
00:00:57,320 --> 00:00:59,240
لا يُستهان بنا فحسب

26
00:00:59,620 --> 00:01:01,490
بل نحن غير مرئيّين في نظركِ

27
00:01:01,740 --> 00:01:03,330
أنتِ غير مُهتمّة فحسب

28
00:01:03,660 --> 00:01:07,580
نجوم أمثالكِ ليس لديهم الوقت
،لمُواجهة كلّ واحد منّا

29
00:01:07,580 --> 00:01:10,500
للاهتمام بسعادتنا أو بؤسنا

30
00:01:11,130 --> 00:01:13,670
أنتِ تلمعين بالطّريقة الّتي
تلمعين فيها بصورة طبيعيّة

31
00:01:13,670 --> 00:01:15,260
لم ترتكبي أيّ خطأ

32
00:01:15,260 --> 00:01:19,550
على العكس، تتحمّلين جهداً أكبر وصعوبات
وضغطاً أشدّ من أيّ شخص آخر

33
00:01:19,550 --> 00:01:24,390
الألماس لا يهدر وقته في التذمُّر
من قِطَع القمامة الخفيّة، أليس كذلك؟

34
00:01:24,390 --> 00:01:27,190
كلّ ما يجب عليه فعله هو اللّمعان

35
00:01:27,520 --> 00:01:30,690
الآخرون غير مُهمّين. ليس لديكِ
الوقت للنّظر إليهم

36
00:01:30,690 --> 00:01:34,070
رغم أنّنا نقضي كلَّ وقتنا ننظر إليكِ

37
00:01:34,190 --> 00:01:37,070
انظري إليّ، انظري إليّ، انظري إليّ

38
00:01:37,320 --> 00:01:40,620
،عائلتي، وأصدقائي، وحبيبي
جميعهم مُهمّون بالنّسبة لي

39
00:01:40,780 --> 00:01:42,580
أعلم ذلك بالطّبع

40
00:01:42,580 --> 00:01:45,120
لكن هذا ليس كافياً

41
00:01:45,790 --> 00:01:48,920
أريدكِ أن تريني مهما كلّف الأمر

42
00:01:49,000 --> 00:01:52,090
ولو لوهلة فقط، دعيني
قريبة من ذلك البريق

43
00:01:55,130 --> 00:01:56,470
ناديني باسمي

44
00:01:56,470 --> 00:01:57,760
!انظري

45
00:01:57,760 --> 00:02:00,800
ذلك الحدث الحِواريّ الّذي عُرِض
قبل أيّام يُحقّق شهرة جنونيّة

46
00:02:00,800 --> 00:02:02,600
هذه صديقتكِ، أليس كذلك يا كاتشي

47
00:02:02,600 --> 00:02:05,980
،هذا مُذهل! في المرّة المُقبلة
!دعيني أحصل على توقيع

48
00:02:07,100 --> 00:02:10,560
لا أعلم. قد لا تُحبّ ميتشيكا ذلك

49
00:02:10,560 --> 00:02:13,360
!بربّكِ، استخدمي سحركِ

50
00:03:54,580 --> 00:03:58,300
المدرسة مُتعِبة. أكرهها حقّاً

51
00:03:59,170 --> 00:04:01,880
،قد يكون هذا المكان عالَماً صغيراً خانِقاً

52
00:04:02,130 --> 00:04:05,090
لكن أينما ذهبت، أرى النّاسَ سواسية

53
00:04:06,890 --> 00:04:11,270
لِمَ لا يستطيع النّاسُ العيش
بطريقة أروع وأكثر حزماً؟

54
00:04:12,350 --> 00:04:14,310
في الوضع الرّاهن، لستِ مُختلفة يا كاتشي

55
00:04:14,650 --> 00:04:17,060
ألستِ مثل الجميع في الصّفّ؟

56
00:04:19,820 --> 00:04:21,820
ماذا؟ هل هي مُختلِفة؟

57
00:04:28,030 --> 00:04:29,830
...في الواقع، أقصد

58
00:04:29,830 --> 00:04:32,500
أكثر روعة وشقاوة

59
00:04:33,000 --> 00:04:36,330
كأنّ لسان حالها يقول، "لن أتوافق
"!مع عالم مُضطرب كهذا أبداً

60
00:04:36,330 --> 00:04:37,750
مثل هذا السُّلوك

61
00:04:37,750 --> 00:04:39,000
ماذا أصابَكِ؟

62
00:04:39,000 --> 00:04:41,340
كنتُ أستمع إلى هذا النّوع
من الموسيقى مُؤخّراً

63
00:05:00,940 --> 00:05:02,740
إذاً ميتشيكا كسرتْ تلك النّوافذ؟

64
00:05:02,740 --> 00:05:05,070
إنّها مُذهلة، أليس كذلك؟ رائع للغاية

65
00:05:05,070 --> 00:05:08,320
،إنّها ترتدي هذه الملابس الجميلة حقّاً
وهي موجودة في هذه الأرجاء في أغلب الأوقات

66
00:05:08,320 --> 00:05:09,910
أراها أحياناً

67
00:05:09,910 --> 00:05:11,580
لكن ليس وكأنّني أتكلّم معها

68
00:05:11,580 --> 00:05:14,620
أشعر وكأنّها تعيش في عالم
مُختلف تماماً عنّا

69
00:05:14,620 --> 00:05:16,170
أقصد بأنّها على تيك توك وما شابه

70
00:05:16,170 --> 00:05:17,670
إذا تجوّلتِ هنا، فسوف تلمحينها غالباً

71
00:05:17,670 --> 00:05:20,290
كاتشي، أنتِ وميتشيكا مُقرّبتان
جدّاً، أليس كذلك؟

72
00:05:20,290 --> 00:05:21,590
هل تعرفين أين هي؟

73
00:05:21,590 --> 00:05:23,260
!عرّفينا

74
00:05:24,420 --> 00:05:27,380
لا أعلم. قد لا تكون ميتشيكا مُهتمّة بذلك

75
00:05:27,380 --> 00:05:28,760
ماذا؟

76
00:05:31,260 --> 00:05:33,770
!رصد قوطي لوليّة

77
00:05:36,890 --> 00:05:40,020
ألستِ مثل الجميع في الصّفّ؟

78
00:05:41,570 --> 00:05:43,480
كنتِ تبحثين عنّي بتلك الاستماتة؟

79
00:05:44,240 --> 00:05:45,610
هل أنتِ مُتربِّصة؟

80
00:05:46,990 --> 00:05:49,620
في الواقع، كنتُ قلقة عليكِ

81
00:05:49,870 --> 00:05:52,660
الحقيقة هي أنّكِ كنتِ تشعرين
بوِحشة، أليس كذلك؟

82
00:05:52,660 --> 00:05:53,490
!وهذا السّبب أيضاً

83
00:05:55,830 --> 00:05:57,080
...هذا أحد الأسباب، لكن

84
00:05:58,000 --> 00:06:00,290
كنتُ قلقة عليكِ حقّاً

85
00:06:00,380 --> 00:06:02,420
ويبدو أنّكِ لم تعودي إلى المنزل

86
00:06:02,420 --> 00:06:03,460
...وفضلاً عن ذلك

87
00:06:08,800 --> 00:06:11,140
هذه المنطقة ليست آمنة تماماً

88
00:06:12,260 --> 00:06:13,310
ميتشيكا

89
00:06:13,310 --> 00:06:15,680
هذا العالم قذِر أينما ذهبتِ

90
00:06:15,680 --> 00:06:16,480
!ميتشيكا

91
00:06:16,480 --> 00:06:18,850
،مُقارنة بضغط المدرسة الخانق والعائلة

92
00:06:19,310 --> 00:06:21,690
يبقى هذا المكان أكثر حرّية

93
00:06:22,440 --> 00:06:23,730
...لكن

94
00:06:35,490 --> 00:06:37,160
...قد يكون هذا صحيحاً، لكن

95
00:06:38,660 --> 00:06:41,580
بغضّ النّظر عن ذلك، منذ متى
بدأتِ تُحقّقين شهرة على تيك توك؟

96
00:06:43,000 --> 00:06:46,510
يبدو أنّ جماهير العالم الدّنيويّ
مُهتمّون بمثل ذلك الأمر

97
00:06:46,510 --> 00:06:48,670
على الأقلّ هذا يعني بأنّه ليس
عليّ القلق بشأن تدبُّر الأمور

98
00:06:49,260 --> 00:06:51,390
أنتِ سعيدةٌ جدّاً بشأن ذلك، صحيح؟

99
00:06:56,350 --> 00:06:57,680
!مُذهل! إنّها هي فعلاً

100
00:06:57,680 --> 00:06:59,100
!إنّها الفتاة القوطي لوليّة

101
00:06:59,100 --> 00:07:01,350
!إنّها نحيلةٌ جدّاً! ظريفة للغاية

102
00:07:01,350 --> 00:07:03,650
أريد فقط أن أعيش كيفما أشاء

103
00:07:04,110 --> 00:07:06,610
!لحظة، مستحيل! هذه هي، أليس كذلك؟

104
00:07:06,610 --> 00:07:08,900
!هذه هي، صحيح؟! وجهها ناعمٌ جدّاً

105
00:07:08,900 --> 00:07:10,360
!إنّها هنا في الواقع

106
00:07:10,360 --> 00:07:11,530
هلّا حصلتُ على توقيعكِ رجاء؟

107
00:07:12,410 --> 00:07:14,330
لذا لا تقلقي

108
00:07:14,490 --> 00:07:18,370
حتّى في عالمٍ كهذا، أتلذّذ
،بما يبقى من الجمال اليسير

109
00:07:18,580 --> 00:07:21,370
بقدر ما أستطيع، ثمّ أرحل
بناء على قراري

110
00:07:21,370 --> 00:07:23,080
!انتظري! ماذا تقصدين بذلك؟

111
00:07:23,080 --> 00:07:23,790
!لا تموتي

112
00:07:23,960 --> 00:07:27,170
لن أموت. سأصحو من هذا الحلم ببساطة

113
00:07:30,630 --> 00:07:31,630
انتظري

114
00:07:34,010 --> 00:07:35,140
كاتشي

115
00:07:37,260 --> 00:07:41,230
عندما تضجرين من ذلك العالم
الصّغير الخانق، تعالي إليّ

116
00:07:41,390 --> 00:07:43,560
سأكون هنا

117
00:07:44,270 --> 00:07:45,360
...بين الحين والآخر

118
00:07:47,820 --> 00:07:51,700
بين الحين والآخر، قد لا أُمانع"
"الاستماع إليكِ

119
00:07:51,820 --> 00:07:53,070
هذا ما قالته لي

120
00:07:53,530 --> 00:07:55,620
هذا سيّئ. هل ستقفز؟

121
00:07:55,620 --> 00:07:57,580
تلك ميتشيكا، صحيح؟

122
00:07:57,700 --> 00:07:59,700
كاتشي. هل تعرفين شيئاً؟

123
00:08:12,260 --> 00:08:14,090
تحبّين الأماكن العالية، أليس كذلك؟

124
00:08:16,640 --> 00:08:17,930
قليلاً

125
00:08:21,810 --> 00:08:23,770
ربّما ينبغي أن أدفعكِ

126
00:08:23,770 --> 00:08:25,150
توقّف

127
00:08:27,060 --> 00:08:29,150
ميتشيكا، هل حدث أمرٌ جيّد؟

128
00:08:31,900 --> 00:08:35,570
لا شيء في هذا العالم يُمكن أن يُسعدني

129
00:08:35,660 --> 00:08:38,780
لا أظنّكِ كذلك. أنتِ أكثر تفاؤلاً
من المعتاد بقليل

130
00:08:38,780 --> 00:08:40,160
وما أدراك؟

131
00:08:40,160 --> 00:08:41,580
أعلم فحسب

132
00:09:20,030 --> 00:09:22,290
شكراً على الشّامبانيا باهظة الثّمن

133
00:09:22,290 --> 00:09:24,210
كاتشي" @كاتشي"
مختصّة في فنّ الأظافر
في أكاديميّة شيبويا للتّجميل
الظّهور كضيف: ساعيّاً + المبيعات
%نوع الحزمة 40% إلى 70

134
00:09:26,170 --> 00:09:28,130
!لا مُشكلة، لا مُشكلة حقّاً

135
00:09:28,130 --> 00:09:30,210
ستقضين وقتاً معي بعد انتهاء
ساعات الدّوام، صحيح؟

136
00:09:31,500 --> 00:09:33,210
سيغضب المُدير منّي

137
00:09:33,210 --> 00:09:36,760
!بربّكِ! ليس هذا ما قلتِه

138
00:09:37,010 --> 00:09:39,300
لديّ مُحاضرة في أوّل حصّة
من صباح الغد

139
00:09:39,300 --> 00:09:42,680
ماذا؟ إذاً لنخرج في مُواعدة
في يوم إجازتكِ

140
00:09:45,680 --> 00:09:47,600
كم جنيتِ اليوم؟

141
00:09:48,900 --> 00:09:50,690
كان اليوم أفضل قليلاً من المعتاد

142
00:09:50,690 --> 00:09:53,030
طلبَ أحد زبائني شامبانيا لي

143
00:09:53,530 --> 00:09:56,280
لذا شاركتُ مزيداً من شبابي الثّمين
مُقابل مال بخس ثانية

144
00:09:56,280 --> 00:09:58,530
كم هذا... مُقرف

145
00:09:59,660 --> 00:10:01,990
!أيّتها المُتسكِّعة اللّعينة
!موتي فحسب

146
00:10:02,790 --> 00:10:05,410
بئساً، مجموعة الردّ هذه لا طائل منها

147
00:10:05,870 --> 00:10:08,330
أتريدين البحث حول اسمكِ يا كاتشي؟

148
00:10:09,380 --> 00:10:10,880
مقهى كاتشي بطراز المنطقة الشّرقيّة

149
00:10:11,380 --> 00:10:13,750
عجباً، هذا مُدهش جدّاً

150
00:10:14,550 --> 00:10:17,880
والآن، لنلقِ نظرة إلى آراء النّاس

151
00:10:19,930 --> 00:10:21,680
لا تبذل كاتشي جهداً يُذكَر
مع الزّبائن

152
00:10:21,680 --> 00:10:23,890
لذا من الغريب أن تُحافظ
على شعبيّتها حتّى الآن

153
00:10:21,680 --> 00:10:23,890
.رأيتُها شخصيّاً وبدتْ عاديّة جدّاً
يعزو الفضل لفيلتر كات فيشينغ

154
00:10:23,890 --> 00:10:25,720
تتحوّل قاعدة كاتشي الشّعبيّة إلى جحيم
بعد أن حظيتْ بأوفياء سُذَّج كُثُر الآن

155
00:10:25,720 --> 00:10:27,480
كان النّاس يقولون بالفعل
بأنّها ذات شخصيّة قاسية

156
00:10:27,480 --> 00:10:28,850
آنذاك عندما كانت لا تزالُ تُناوب كضيف

157
00:10:27,480 --> 00:10:29,770
بصراحة، ألا تبدو كاتشي مغترّة
كثيراً بنفسها مؤخّراً؟

158
00:10:30,060 --> 00:10:31,190
!رأيتِ؟ أخبرتُكِ

159
00:10:31,400 --> 00:10:33,440
كاتشي هي الوحيدة في المتجر ذات
هالة مُختلفة، ولا أقصد من ناحية إيجابيّة

160
00:10:33,440 --> 00:10:36,030
.عند إمعان النّظر، إنّها بدينة بعض الشّيء
تُخفي ذلك بصدرها الكبير فحسب

161
00:10:36,030 --> 00:10:39,860
إنّها تُبالغ في استخدام الفيلتر. في الحياة
الواقعيّة، بدا فكّها ثخيناً ومُمتلئاً

162
00:10:37,900 --> 00:10:41,200
إنّها تُرافق غالباً حبيباً عاهراً
ويحظى بكلّ المال على أيّ حال

163
00:10:39,860 --> 00:10:41,200
يبدو أنّها كثيرة التنقُّل

164
00:10:41,570 --> 00:10:42,870
لا أريد رؤية هذا

165
00:10:42,870 --> 00:10:47,330
لكن من المُهمّ رؤية نقد صادق
وصريح أيضاً، أليس كذلك؟

166
00:10:47,370 --> 00:10:51,170
أتعتقد حقّاً بأنّ آراء مُتحيّزة من لوحة
رسائل تُعَدّ كنقدٍ مُنصِف؟

167
00:10:52,710 --> 00:10:55,710
يمكنك أن تُميّز بوضوح بأنّ لديها فتى
من كمّية الطّعام في صور غرفتها

168
00:10:53,710 --> 00:10:55,710
كم أريد مُضاجعة كاتشي أيضاً

169
00:10:55,710 --> 00:10:57,590
أتساءل كم من المدّة ظلّتْ عذراء

170
00:10:55,710 --> 00:10:57,590
يبدو وكأنّها كانت تفعلها بالفعل
في المدرسة الإعداديّة

171
00:10:57,800 --> 00:11:00,260
لِمَ لا تبحثين حول اسمك
الرّائج بدلاً من ذلك؟

172
00:11:00,260 --> 00:11:02,970
قد يكون من الجيّد بين الحين والآخر
مُواجهة مُعجبينك الخاصّين

173
00:11:02,970 --> 00:11:07,060
من يأبه؟ لن يحظى أولئك الأغبياء
بالموسيقى خاصّتي على أيّ حال

174
00:11:07,270 --> 00:11:08,730
!بجدّية، توقّف

175
00:11:14,060 --> 00:11:16,480
أنا مُتعبة الآن

176
00:11:36,130 --> 00:11:39,050
شكراً جزيلاً على دعوتي
!إلى الحدث الحِواريّ

177
00:11:39,220 --> 00:11:42,430
،كان الجميع مُفعمين بالحيويّة
!وقد قضيتُ وقتاً رائعاً بالفعل

178
00:11:42,640 --> 00:11:44,800
حقّاً؟ أيّ جزئيّة بالضّبط؟

179
00:11:48,970 --> 00:11:53,190
كلمات بلا معنى تُنطَق فقط
لمنع المركِب من الاهتزاز

180
00:11:53,810 --> 00:11:57,400
قولي فقط ما تُفكّرين فيه بتعبيركِ الخاصّ

181
00:11:58,480 --> 00:12:00,030
ميتشيكا غوكوبارا

182
00:12:00,280 --> 00:12:01,780
...لا، في الواقع

183
00:12:02,240 --> 00:12:05,280
...لستُ جيّدة في صياغة الكلمات فحسب، لذا

184
00:12:05,280 --> 00:12:06,700
ارتأيتُ فقط أنّ ذلك كان مُذهلاً

185
00:12:06,700 --> 00:12:09,120
أعتقد حقّاً بأنّ ذلك كان مُذهلاً

186
00:12:09,120 --> 00:12:12,540
لا، بجدّية، كان ذلك مُذهلاً فعلاً

187
00:12:14,330 --> 00:12:17,500
إذاً جوهريّاً، إنّها تقصد بأنّ ذلك
!كان رائعاً إلى حدّ الجنون

188
00:12:17,710 --> 00:12:19,300
نيتشيكا-ساما

189
00:12:19,510 --> 00:12:21,470
شيء من هذا القبيل

190
00:12:30,430 --> 00:12:31,680
،في العالم العصريّ

191
00:12:31,680 --> 00:12:34,900
"حلّل مُحيطك" و"عِش كفرد"

192
00:12:35,600 --> 00:12:38,900
!تواجد جنباً إلى جنب بتناقُض صارخ

193
00:12:39,110 --> 00:12:41,400
فتاة السمّ المُميت دينبا
!مصّاصة أرجوانيّة

194
00:12:41,570 --> 00:12:43,240
يا للإزعاج. ها هي المُزعجة قد أتت

195
00:12:43,240 --> 00:12:45,410
ها هي العجوز الأرجوانيّة تُطلّ علينا

196
00:12:49,910 --> 00:12:52,960
اصمتا! عليكما تحليل مُحيطكما
!أكثر أيُّها الفاشلان

197
00:12:54,500 --> 00:12:55,830
على أيّ حال، أين كنتُ؟

198
00:12:57,130 --> 00:13:01,380
إنّهم يُقدِّرون المُسنّنات الّتي
،تُبقي المُجتمع يدور

199
00:13:01,380 --> 00:13:05,890
ومع ذلك يُطالبون من النّاس أن يُقيِّموا
الفرد" وكأنّه طلبٌ منطقيّ

200
00:13:06,800 --> 00:13:10,810
مع انتشار الإنترنت، ازداد الضّغط
النّظير التّقليديّ شدّة

201
00:13:10,810 --> 00:13:14,060
النّاس يغارون من أولئك الّذين يشتهرون
فيفضحونهم وينتقدونهم

202
00:13:14,060 --> 00:13:15,480
!ويطرقون المسمارَ الّذي يبرز

203
00:13:15,480 --> 00:13:19,150
لأنّه إذا بقي الجميع مُستويين، إذا بقي
الجميع بمُستواهم، يشعرون بأمان

204
00:13:19,150 --> 00:13:21,610
وسرعان ما يجدون أنّ المسامير
الّتي طِرِقَتْ وضاعت

205
00:13:21,610 --> 00:13:25,150
قد بدأت تتراصف مع رأي الأغلبيّة
وتمتزج مع الجماهير

206
00:13:25,400 --> 00:13:28,120
من الواضح أنّ هناك مُشكلة
في عقل لوليبوب

207
00:13:28,660 --> 00:13:30,410
!عـ-على أيّ حال

208
00:13:31,290 --> 00:13:34,460
إذا ظللتِ خائفة وتقولين كلاماً مُسالماً
،وفارغاً، ودفنتِ طبيعتكِ الحقيقيّة

209
00:13:34,460 --> 00:13:36,830
فسينتهي المطاف بكِ بعيش حياة
!لا تكتشفين فيه شخصيّتكِ أبداً

210
00:13:36,830 --> 00:13:38,580
!هذا خالٍ تماماً من الشّقاوة

211
00:13:40,630 --> 00:13:44,550
،إنّها فتاة "دينبا" غريبة الأطوار سامّة
لكن لا أكره طريقة تفكيرها

212
00:13:45,340 --> 00:13:48,470
الجميع مهووسون بالرّائعين والأشقياء

213
00:13:51,260 --> 00:13:54,270
جميعكم... كارامازوف أقوياء

214
00:13:54,890 --> 00:13:56,600
حتّى عندما يُعلّق النّاسُ
على الحدث الحِواريّ

215
00:13:56,600 --> 00:13:59,730
ويُدقِّقون في كلّ شيء من وجهة
،نظر مُتحيّزة لـ ك-آنجل

216
00:13:59,730 --> 00:14:01,520
،لأنّها كانت بالفعل أكثر شهرة أساساً

217
00:14:01,520 --> 00:14:03,150
لا تدعون ذلك يؤثّر بكم سلباً

218
00:14:03,610 --> 00:14:04,780
هذا رائع بالفعل

219
00:14:04,780 --> 00:14:07,240
لا داعي للنّظر إلى الأشياء
!الّتي لا نُريد رؤيتها

220
00:14:07,610 --> 00:14:10,240
قد لا تبدو كذلك، لكنّها في الواقع
تتّخذ الأمور بجدّية كبيرة

221
00:14:10,370 --> 00:14:12,830
فقد كانت مُدمنة وسائل تواصُل
اجتماعيّ عاديّة تماماً

222
00:14:12,830 --> 00:14:14,410
كم مضى على ذلك من وقت؟

223
00:14:14,790 --> 00:14:16,960
حتّى الآونة الأخيرة

224
00:14:20,500 --> 00:14:25,670
رغم ذلك، أصبحتْ قائدتنا قويّة
بما يكفي لإسكات الضّجيج

225
00:14:26,220 --> 00:14:29,300
كلام الرّعاع لا يطفئ بريقنا البتّة

226
00:14:30,390 --> 00:14:32,300
الألماس لا ينكسر

227
00:14:32,890 --> 00:14:37,270
هذيان الحشرات الزّاحفة لا يدخل
حتّى مجال نظري أساساً

228
00:14:37,350 --> 00:14:38,890
ثمّ هناك هذا النّوع أيضاً

229
00:14:38,890 --> 00:14:40,770
لست شقيّة بما يكفي

230
00:14:42,020 --> 00:14:44,280
عِش رائعاً

231
00:14:44,780 --> 00:14:48,280
مرحباً أيُّها الظّرفاء! معكم ملاك
!الإنترنت، ك-آنجل

232
00:14:48,490 --> 00:14:50,280
اليوم، سأقرأ بعض رسائل بريد المُشاهدين

233
00:14:50,700 --> 00:14:52,200
حسناً، لنقرأ هذه

234
00:14:52,200 --> 00:14:53,740
الفرديّة، صحيح؟

235
00:14:53,740 --> 00:14:55,660
،عندما يتعلّق الأمر الفرديّة
،فأعتقد بأنّها تعني

236
00:14:55,870 --> 00:14:59,330
امتلاك أحاسيسك الخاصّة وطريقة تفكيرك"
"بدلاً من التّماشي مع الآخرين

237
00:14:59,620 --> 00:15:02,080
هذا صعب، أليس كذلك؟ من الصّعب
تصوُّر ما يعنيه ذلك فعليّاً

238
00:15:02,080 --> 00:15:03,420
...لنرَ

239
00:15:03,420 --> 00:15:07,380
على سبيل المثال، هل تعرف
الغاية من الفنّ؟

240
00:15:07,590 --> 00:15:09,380
هل تكره متاحف الفنّ؟

241
00:15:09,380 --> 00:15:12,140
لعلّنا التقينا في متحف فنون

242
00:15:12,640 --> 00:15:14,760
،حتّى عندما تنظر إلى عمل فنّي مُذهل

243
00:15:14,760 --> 00:15:17,270
فإنّنا لا نفهمه في مُعظم الوقت

244
00:15:17,270 --> 00:15:19,140
،لكن بتعريض نفسك لمُختلف
،الأمور المُماثلة

245
00:15:19,140 --> 00:15:21,770
،فإنّك تبدأ باكتشاف ما تُحبّ وما تكره

246
00:15:21,770 --> 00:15:22,900
وما يجذب اهتمامك

247
00:15:23,060 --> 00:15:27,530
أعتقد بأنّ معنى الاحتكاك مع الفنون الجميلة
هو نقش تلك المشاعر داخل نفسك

248
00:15:27,740 --> 00:15:31,410
لهذا السّبب الفنّ مثل الموسيقى
واللّوحات والمنحوتات

249
00:15:31,410 --> 00:15:34,740
يمنحك "ذاتاً فرديّة" بجعلك
،تستشعر أحاسيسك

250
00:15:34,740 --> 00:15:38,450
والمشاعر الفريدة الّتي تُميّزك عن الآخرين

251
00:15:39,620 --> 00:15:43,880
لذا ليس عليك إجبار نفسك
على محبّة ك-آنجل

252
00:15:43,880 --> 00:15:47,380
،فقط قدِّر ما شعرت به عندما رأيتني
من دون أيّ إضافات

253
00:15:47,380 --> 00:15:49,090
!هذه هي الفرديّة

254
00:15:49,090 --> 00:15:50,970
،لكن عندما ينظر النّاس إلى ك-آنجل

255
00:15:50,970 --> 00:15:54,010
فإنّ أوّل ما يخطر على البال
دوماً هو "مُذهل، إنّها مُثيرة"، صحيح؟

256
00:15:54,010 --> 00:15:56,760
مهلاً! أُراقب دوماً تعليقات الكراهية

257
00:15:56,760 --> 00:15:57,930
!سأحظركم، تبّاً

258
00:15:58,930 --> 00:16:04,100
حسناً يا رِفاق، سيبدأ البثّN!المُمتع في هذه اللّيلة

259
00:16:13,740 --> 00:16:16,910
!كاتشي! ماذا حدث لشعركِ؟
!إنّه مُبهرَج جدّاً

260
00:16:16,910 --> 00:16:19,080
إنّه يلائمكِ. لكن كانت تلك حركة جريئة

261
00:16:19,080 --> 00:16:20,160
لقد اتّخذتُ قراري

262
00:16:20,160 --> 00:16:20,910
!ماذا؟

263
00:16:20,910 --> 00:16:23,120
هل هذا يعني بأنّكِ لن تحضري
!كضيفة بعد الآن؟

264
00:16:23,120 --> 00:16:25,920
!اكتمل التّحضير

265
00:16:25,920 --> 00:16:28,050
هل كلّ شيء بخير؟

266
00:16:28,050 --> 00:16:30,510
!اكتمل التّحضير

267
00:16:30,510 --> 00:16:33,970
أنا آسفة، لكن اتّخذتُ قراري بالفعل

268
00:16:34,220 --> 00:16:35,760
!لكن اشتريتُ لكِ شامبانيا

269
00:16:35,760 --> 00:16:36,930
هل حصلتْ على حبيب؟

270
00:16:36,930 --> 00:16:38,100
يا ساقطة، تبدين قبيحة

271
00:16:38,510 --> 00:16:41,850
رُبّما لا تجري ذلك النّوع من المُحادثات
أمام الزّبائن؟ مِهنيّة معدومة

272
00:16:48,400 --> 00:16:52,150
كتبَ أحدُكما بسوء عنّي في لوحة
الرّسائل تلك، أليس كذلك؟

273
00:16:56,910 --> 00:16:58,030
من كان منكما؟

274
00:17:00,160 --> 00:17:01,910
أيّاً يكن

275
00:17:02,710 --> 00:17:04,960
لستُ هناك على أيّ حال

276
00:17:05,290 --> 00:17:08,790
،إلى اللّقاء. ما زال لديّ عمل أقوم به
لذا سوف أُغادر

277
00:17:13,340 --> 00:17:18,470
يبدو أنّ صديقتكِ ميتشيكا كانت
تُمارس مُواعدة تعويضيّة آنذاك

278
00:17:18,640 --> 00:17:20,430
!انظري إلى هذا

279
00:17:20,430 --> 00:17:22,060
نشرَ شخصٌ موضوعاً كاملاً حول الأمر

280
00:17:22,060 --> 00:17:25,190
،تتصرّف بما يتلاءم مع المُجتمع
لكنّها داعرة في النّهاية، صحيح؟

281
00:17:25,190 --> 00:17:27,730
هل ستُلبّين رغبتي بالفعل؟

282
00:17:29,400 --> 00:17:31,860
أنت أحمق بالفعل

283
00:17:32,860 --> 00:17:34,360
ما مُشكلة شعركِ بالضّبط؟

284
00:17:34,700 --> 00:17:36,530
يبدو جميلاً. هل تحتاجين رجلاً أو ما شابه؟

285
00:17:38,200 --> 00:17:41,120
بحثتُ حول اسمك اللّامع

286
00:17:41,410 --> 00:17:45,210
لم يعُد أحدٌ يكتب عنك

287
00:17:45,330 --> 00:17:47,920
لا مُعجبين. لا كارهين. مدينة أشباح حقيقيّة

288
00:17:50,170 --> 00:17:52,510
أنت نكِرة حاليّاً

289
00:17:56,930 --> 00:17:59,800
ما مُشكلتكِ يا كاتشي؟ هل
جاءتكِ الدّورة أو ما شابه؟

290
00:18:00,390 --> 00:18:02,310
إن كان كذلك، فأخبريني فحسب

291
00:18:02,560 --> 00:18:04,270
سأذهب وأشتري لكِ فوطة

292
00:18:05,430 --> 00:18:07,480
ثمّ يمكننا أن نُعانق ونُداعب بعضنا

293
00:18:07,940 --> 00:18:08,810
...أنتِ تحبّين ذلك، لذا

294
00:18:11,820 --> 00:18:15,740
الجميع يتوهون أحياناً، ومن المُهمّ
التوقُّف والرّاحة

295
00:18:16,650 --> 00:18:18,570
!مُؤلم! تبّاً

296
00:18:18,570 --> 00:18:19,740
...ما الّذي

297
00:18:23,040 --> 00:18:24,870
...لكنّك

298
00:18:25,000 --> 00:18:26,660
تأخّرتَ كثيراً

299
00:18:28,040 --> 00:18:29,420
!وقت مُستقطَع

300
00:18:51,650 --> 00:18:53,070
اخرج

301
00:18:57,360 --> 00:18:58,860
اخرج

302
00:19:07,160 --> 00:19:11,750
!لا تتعالي عليّ! أتعتقدين أنّكِ أفضل منّي؟

303
00:19:12,420 --> 00:19:15,250
!هذا صحيح! أنت أدنى منّي

304
00:19:16,460 --> 00:19:17,760
!نسيتَ شيئاً

305
00:19:24,310 --> 00:19:29,230
سأؤلّف أعظم موسيقى
!وأجعلكِ تندمين على ذلك

306
00:19:30,980 --> 00:19:32,860
التقطتَه بالفعل؟

307
00:19:35,610 --> 00:19:36,730
يبدو هذا جيّداً

308
00:19:37,230 --> 00:19:41,110
أليس كذلك؟ انتظري فحسب، سوف
أهيمن على العالم يوماً ما

309
00:19:41,410 --> 00:19:44,120
كاتشي، تحبّين حقّاً تلك الثّقافة الفرعيّة

310
00:19:44,370 --> 00:19:46,120
لكنّه مُجرّد تقليد لذلك

311
00:19:46,120 --> 00:19:48,620
لا أفقه شيئاً عن الأداء الفعليّ

312
00:19:48,950 --> 00:19:51,620
هذا بعيدٌ كلّ البُعد عن الرّوك الحقيقيّ

313
00:19:54,960 --> 00:19:56,630
!أنت ثقيل

314
00:20:12,980 --> 00:20:16,820
لكنّه قضى لحظاته الرّائعة

315
00:20:21,570 --> 00:20:24,160
لا أستطيع رؤية النُّجوم

316
00:20:25,240 --> 00:20:26,330
...حسناً إذاً

317
00:21:02,240 --> 00:21:02,740
...تشغيل الفيديو بعد 3

318
00:21:02,740 --> 00:21:03,780
...تشغيل الفيديو بعد 2

319
00:21:03,780 --> 00:21:04,740
...تشغيل الفيديو بعد 1

320
00:21:05,070 --> 00:21:06,740
!عادت الفرقة لنشاطها

321
00:21:06,740 --> 00:21:10,830
لذا على أيّ حال، بعد هذه
...المُساهمة الإبداعيّة

322
00:21:10,830 --> 00:21:12,040
مُساهمة إبداعيّة؟

323
00:21:14,670 --> 00:21:18,790
أحمق! مُحال! لا، كنتُ بمُفردي
!طوال الوقت، وحيداً تماماً

324
00:21:19,920 --> 00:21:20,750
...لذا، على أيّ حال

325
00:21:21,090 --> 00:21:23,720
استمع للموسيقى الّتي ألّفناها
!بعد تصفية أذهاننا

326
00:21:23,970 --> 00:21:26,430
أعلم بأنّك سترضى

327
00:21:26,590 --> 00:21:28,890
!بفضل الدّعم-
!سنكون في الانتظار-

328
00:23:02,190 --> 00:23:06,440
بي! عليك رؤية هذا! هؤلاء
!النّاس يُثيرون غضبي حقّاً

329
00:23:05,400 --> 00:23:10,410
.لا أطيق طريقة كلامها
اصمتي وراقبي فحسب، هذه
.هي إلَهة العصر الحاليّ
أسرعي وقولي شيئاً
.طريفاً، يصبح الأمر مُملّاً
إنّها ماهرة جدّاً في التّرويج لنفسها لدرجة تُثير اشمئزازي

330
00:23:06,440 --> 00:23:10,410
!أنا أدفع ضرائبَ لعينة أكثر منهم

331
00:23:10,700 --> 00:23:13,080
!من يعتقدون أنفسهم؟ الموت لكم

332
00:23:13,080 --> 00:23:14,410
!قِردة

333
00:23:14,410 --> 00:23:17,040
!غادروا واشنقوا أنفسكم

334
00:23:17,040 --> 00:23:20,170
!موتوا! موتوا! موتوا

335
00:23:24,920 --> 00:23:26,920
الحلقة القادمة

336
00:23:26,920 --> 00:23:29,800
،الأداء الحيّ الأوّل لكارامازوف
"جريمة وعقاب"

337
00:23:30,130 --> 00:23:33,260
،مُعتقدة بأنّ شيئاً ما مفقود
تهيم لوليبوب ليلاً

338
00:23:33,260 --> 00:23:35,060
ثمّ ترى ظلّ فتاة وحيدة

339
00:23:35,510 --> 00:23:37,520
"الحلقة القادمة، "لا يهمّ

340
00:23:37,930 --> 00:23:39,940
الحلقة 5