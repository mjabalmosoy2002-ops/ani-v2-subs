1
00:00:10,530 --> 00:00:12,440
لا استجابة

2
00:00:15,700 --> 00:00:17,700
!يستغرق هذا وقتاً طويلاً جدّاً

3
00:00:19,700 --> 00:00:21,410
هل أنتِ متأكّدة من أنّنا
!نستطيع فعل هذا؟

4
00:00:21,580 --> 00:00:22,960
!أجل، نستطيع ذلك

5
00:00:25,580 --> 00:00:28,330
،رغم أنّنا اخترنا هذه الحياة لأنفسنا

6
00:00:28,500 --> 00:00:32,800
نعيش مُتّصلين ومُراقبين بواسطة
...كلّ شخص في الأرض

7
00:00:50,650 --> 00:00:51,900
!سأستعير هذا

8
00:00:56,910 --> 00:00:58,870
هلوسة؟

9
00:00:59,410 --> 00:01:00,910
لا. بجدّية

10
00:01:01,330 --> 00:01:04,870
أنتِ دافئة

11
00:01:05,870 --> 00:01:07,880
أمّي

12
00:01:11,710 --> 00:01:14,670
،لا! حتّى أقول بأنّه لا مانع

13
00:01:14,840 --> 00:01:18,050
سيبقى هاتفك مُصادراً وستبقين هنا

14
00:01:18,220 --> 00:01:21,890
هذا أمرٌ من مُؤدّية البثّ الّتي
!تُعدّ الأولى في اليابان حاليّاً

15
00:01:22,140 --> 00:01:23,890
عدد المُتابعين الإجمالي لكارامازوف

16
00:01:33,610 --> 00:01:35,400
إذاً لديّ طلب واحد

17
00:01:38,780 --> 00:01:43,660
ضفيرة الشّعر الجديدة وأظرف
لِباس يمكنك إيجاده

18
00:01:43,910 --> 00:01:47,080
وخمّري لي شاياً لذيذاً

19
00:01:50,170 --> 00:01:51,580
لا بأس

20
00:01:51,750 --> 00:01:56,920
شكراً لكِ. يبدو أنّنا مُتشابهتان
من نواحٍ عديدة

21
00:01:58,090 --> 00:02:03,930
عندما فعلتُ هذا، تناولتُ الكثير من الأدوية
النّفسيّة وكنتُ مُشوّشة تماماً

22
00:02:04,390 --> 00:02:10,400
،ومتى أردتُ الشّعور بالحياة
كنتُ أتفقّد نبضي في مِعصمي

23
00:02:10,980 --> 00:02:13,360
ما الأدوية الّتي كانت تُوصَف لكِ؟

24
00:02:13,690 --> 00:02:16,820
،كان يُوصَف لي كذا وكذا

25
00:02:17,320 --> 00:02:19,840
وكنتُ أستورد كذا وكذا من تلقاء نفسي

26
00:02:20,010 --> 00:02:21,030
يا إلهي

27
00:02:21,200 --> 00:02:25,200
،كنتُ أتعاطى كذا أيضاً، لكن بعدها حدث كذا
لذا انتهى المطاف بي بالتحوُّل إلى كذا

28
00:02:25,370 --> 00:02:27,740
،لكن كذا سيضرّ بكبدكِ

29
00:02:27,910 --> 00:02:30,200
لذا يصبح الآلفا أوميغا ثمّ
يقوم إيبيلسون بوظيفته

30
00:02:30,370 --> 00:02:32,120
وما أدراني أيضاً، صحيح؟

31
00:02:32,290 --> 00:02:33,830
نحن صديقتان روحيّتان أساساً

32
00:02:34,000 --> 00:02:36,090
لا تتعلّقا ببعضكما فوراً لمُجرّد
!حديث عن أدويتكِ النّفسيّة العجيبة

33
00:02:36,800 --> 00:02:40,090
إذاً لِمَ لا تُجرّبين التّقارب معها أيضاً؟

34
00:02:42,510 --> 00:02:43,600
تفضّلي

35
00:02:44,260 --> 00:02:46,100
تُحبّين هذه، صحيح؟

36
00:02:47,270 --> 00:02:50,940
أتعلمين؟ هذه ذكرى منذ الطّفولة بالنّسبة لي

37
00:02:51,150 --> 00:02:54,860
شاهدتُ كُلّ بثوثكِ

38
00:02:55,320 --> 00:02:58,740
ليس وكأنّكِ مُهتمّة بي

39
00:03:01,070 --> 00:03:02,990
شكراً على كونكِ من مُعجباتي

40
00:03:03,990 --> 00:03:07,790
!لكن أنا الأولى في اليابان

41
00:03:09,960 --> 00:03:12,540
نحن كذلك

42
00:03:17,800 --> 00:03:20,210
ألن تخلعي الباروكة؟

43
00:03:20,380 --> 00:03:22,050
ليس هنا

44
00:03:22,470 --> 00:03:26,060
إنّها دليلٌ على أنّني أنا ولستُ أنا

45
00:03:30,140 --> 00:03:31,190
هكذا إذاً

46
00:03:31,890 --> 00:03:35,360
إذاً ماذا ستفعلين بشأن
تلك النُّدَب والحبوب؟

47
00:03:36,520 --> 00:03:37,570
،الآن

48
00:03:38,150 --> 00:03:43,070
عندما نكون نحن الثّلاثة معاً، أشعر
براحة أكبر، حتّى دون جرعة زائدة

49
00:03:43,610 --> 00:03:45,570
حتّى في هذا العالم القبيح

50
00:03:46,160 --> 00:03:48,910
ولديّ صديقة واحدة

51
00:03:49,790 --> 00:03:51,370
حقّاً؟

52
00:03:51,710 --> 00:03:57,000
في النّهاية، الضّرر الذّاتيّ هو مُجرّد وسيلة
لملء الفراغ وتخفيف التوتُّر

53
00:03:57,420 --> 00:04:02,510
،من السّهل الغضب وحظر كُلَّ شيء
لكن أوّلاً لا بُدّ أن يستمع شخص

54
00:04:02,840 --> 00:04:04,510
إذاً لنستمع لهم

55
00:04:05,090 --> 00:04:07,510
هذا لن يحلّ المُشكلة الأصليّة مع ذلك

56
00:04:08,140 --> 00:04:11,520
بالنّسبة لك، هل كان البديل
راحة الأعداد؟

57
00:04:11,890 --> 00:04:17,060
حالما مسح الإنترنت مكاني الّذي
أنتمي له، فقدتُ كُلَّ قيمتي

58
00:04:17,570 --> 00:04:20,530
والآن أريد وسيلةً أُخرى للهرب
من الحياة الواقعيّة ثانية

59
00:04:22,110 --> 00:04:25,530
حسناً، يمكنك اكتشاف الحقيقة
بنفسكِ في نهاية المطاف

60
00:04:28,240 --> 00:04:30,580
متى أكثر مرّة تعرّضتِ فيها لأبغض موقف؟

61
00:04:30,870 --> 00:04:33,290
بعد أن تركتُ المدرسة بفترة قصيرة

62
00:04:34,370 --> 00:04:35,870
كنتُ أرضخ لهذا الإحساس

63
00:04:36,040 --> 00:04:38,500
بأنّ الخطّ بين الواقع والأحلام يضمحلّ

64
00:04:38,670 --> 00:04:42,720
،استمررتُ في تناول المزيد والمزيد من الحبوب
وذات ليلة شعرتُ بدُوار وهمتُ

65
00:04:43,010 --> 00:04:46,300
"ثمّ سألني رجل، "كم الثّمن؟

66
00:04:48,050 --> 00:04:51,310
تجاهلتُه، لكن ظلّ يسحب
المزيد من النّقود من مِحفظته

67
00:04:52,060 --> 00:04:54,310
لم أكن أريد المال

68
00:04:54,560 --> 00:04:55,600
...لكن

69
00:04:58,400 --> 00:05:04,280
عندما قلتُ لنفسي، "جسدي يستحقّ
هذا المقدار؟" غبتُ عن الوعي

70
00:05:04,570 --> 00:05:07,110
عندما استفقت، وجدتُ نفسي في فندق

71
00:05:08,570 --> 00:05:13,080
،لكن قبل أن يحدث أيّ شيء
أتتْ نيتشيكا لإنقاذي

72
00:05:13,540 --> 00:05:15,750
كانت تقرع على الباب

73
00:05:15,920 --> 00:05:19,880
وحتّى بعد أن أخرجَتْني، قضيتُ
اللّيلةَ كُلّها أبكي على كتفها

74
00:05:20,630 --> 00:05:23,000
لماذا تُخبرينني بكلّ ذلك؟

75
00:05:23,170 --> 00:05:27,890
إذا كشفتُ عن هذا، فسوف يتمّ انتقادكِ
فوراً وتصبح سُمعتكِ في الحضيض

76
00:05:29,890 --> 00:05:31,840
لأنّ هذا هو الواقع

77
00:05:32,010 --> 00:05:35,890
أخبركِ بهذا وذلك كي نتمكّن من مُواجهة
بعضنا الآخر ونبني الثِّقة

78
00:05:36,770 --> 00:05:41,150
.لسنا دُمى في الجانب الآخر من شاشة
لدينا جسد

79
00:05:41,900 --> 00:05:44,030
لهذا يمكننا التكلُّم مع بعضنا الآخر

80
00:05:44,490 --> 00:05:47,440
نحن من بين قلّة من النّاس الّذين
يضحّون بشبابهم

81
00:05:47,610 --> 00:05:49,620
لأجل القبول العامّ، أليس كذلك؟

82
00:05:50,780 --> 00:05:52,580
أنا أثق بكِ

83
00:05:53,410 --> 00:05:56,910
إذاً بما أنّكِ تثقين بي، هل يمكنني
تناول بعض حبوبكِ المُنوِّمة؟

84
00:05:58,170 --> 00:05:59,290
لا

85
00:06:02,250 --> 00:06:03,500
بئسَ الأمر

86
00:07:08,690 --> 00:07:13,870
،حسناً، بالكمّية الّتي كان يشربها
كان من المُمكن أن يموت في أيّ لحظة

87
00:07:24,250 --> 00:07:25,540
هل لي بلحظة؟

88
00:07:27,460 --> 00:07:30,170
إذاً هذا هو الشّكل الّذي
تتّخذينه معي؟

89
00:07:30,840 --> 00:07:33,470
عرفتُ بأنّ هذه النّسخة
ستليق بكِ أكثر

90
00:07:33,760 --> 00:07:35,350
بما أنّكِ في حداد وما شابه

91
00:07:36,010 --> 00:07:39,640
عندما تُعلنين عن عودتكِ، فيجدر
بكِ أن تتعاوني معنا

92
00:07:40,060 --> 00:07:42,310
يمكننا القيام بحدث ارتداء
لِباس جنس مُغاير أو ما شابه

93
00:07:42,810 --> 00:07:44,150
سيُحبّ الجميع ذلك

94
00:07:44,730 --> 00:07:48,900
أنتِ الوحيدة المُتأكِّدة بأنّني سأعود

95
00:07:49,650 --> 00:07:51,950
بالطّبع. فأنتِ ستعودين، أليس كذلك؟

96
00:07:52,700 --> 00:07:59,080
،أشعر وكأنّ خسارتي أقلّ أمام كارامازوف
وأكبر أمامك شخصيّاً

97
00:07:59,950 --> 00:08:01,410
كنتِ الوحيدة الّتي

98
00:08:01,580 --> 00:08:04,790
كانت جادّة بشأن أن تصبح الرّقم
واحد في اليابان منذ البداية

99
00:08:05,290 --> 00:08:11,550
،كان ذلك فقط بفارق ضئيل
لكنّك أكثر من أحببتُه

100
00:08:12,470 --> 00:08:14,050
كانت مُقامرة

101
00:08:14,590 --> 00:08:17,680
أعتقد بأنّني ورثتُ إدمان المُقامرة
من أبي في نهاية المطاف

102
00:08:18,060 --> 00:08:19,770
وربحت، لذا لا يهمّ

103
00:08:21,020 --> 00:08:24,900
لكن أقحمتُ الجميع في حُلمي الغبيّ

104
00:08:26,150 --> 00:08:30,480
ومع ذلك بدا لي وكأنّ الجميع
كانوا مُستمتعين

105
00:08:30,650 --> 00:08:32,400
بمدى راحة ذلك الحلم

106
00:08:36,200 --> 00:08:40,040
أنا أدعمكم جميعاً حتّى تحصلوا
!على أعمال، مفهوم؟

107
00:08:40,620 --> 00:08:45,290
أختكم الكبرى هي مُؤدّية البثّ
!الأولى في اليابان الآن

108
00:08:49,920 --> 00:08:51,670
!نأسف لقلقك علينا

109
00:08:54,380 --> 00:08:57,010
،حصلتُ على توصية في الرّياضة
!لذا أجور تدريسي مكفولة

110
00:08:57,180 --> 00:09:00,180
مُحال، سأدفع لك الضّعف
لِقاء نفقات المعيشة

111
00:09:00,350 --> 00:09:04,560
لدينا وجهكِ يا أختاه. سنتدبّر الأمر

112
00:09:05,850 --> 00:09:07,150
...أنتم

113
00:09:09,480 --> 00:09:11,570
لا تُصبحوا مُضيفين فحسب، مفهوم؟

114
00:09:13,940 --> 00:09:17,570
!مـ-مهلاً! سنتناول الرّامن

115
00:09:17,870 --> 00:09:19,320
!في الوقت المثاليّ

116
00:09:19,490 --> 00:09:21,320
!لـ-ليس وكأنّني أفهم الأجواء أو ما شابه

117
00:09:21,490 --> 00:09:23,120
لا بأس. بالنّسبة لأرجوانيّة على الأقلّ

118
00:09:23,290 --> 00:09:24,290
...ما

119
00:09:24,750 --> 00:09:27,000
هيّا بنا يا أميرة

120
00:09:28,710 --> 00:09:32,130
بهذه المجموعة، سوف نُحدِث جلبة

121
00:09:32,300 --> 00:09:35,340
لا داعي للقلق. أعرف مكاناً أتردّد إليه كثيراً

122
00:09:43,640 --> 00:09:45,350
!حان وقت الظُّهور

123
00:09:46,520 --> 00:09:47,770
ألديك رخصة قيادة؟

124
00:09:47,940 --> 00:09:49,980
،حصلتُ عليها عندما بدأت
من أجل مُحتوى البثّ

125
00:09:50,150 --> 00:09:51,400
فضلاً عن ذلك، إنّها مُفيدة

126
00:09:51,570 --> 00:09:52,650
هل يمكن لقدميك الوصول إلى الدوّاسة؟

127
00:09:52,820 --> 00:09:54,400
!يمكنها بالطّبع أيّتها الحمقاء

128
00:09:55,570 --> 00:09:57,610
،كما ورد في تنبّؤات الطّقس
سطح الطّريق بارد

129
00:09:57,780 --> 00:10:00,240
التّماسُك ضعيف. والإطارات لم تبلغ
درجةَ الحرارة المُناسبة بعد

130
00:10:00,410 --> 00:10:02,740
لكن هكذا أفضل

131
00:10:02,910 --> 00:10:06,420
بقبضة فضفاضة كهذه، يمكنني الشّعور
بكلّ اهتزاز للسيّارة بيدَي

132
00:10:06,590 --> 00:10:07,660
لا تدعي مقياس السّرعة ينخفض

133
00:10:07,830 --> 00:10:09,370
If I punch out from seven thousand
all at once, I'm dead.

134
00:10:09,540 --> 00:10:11,000
!خمسة آلاف وخمسمئة! هيّا

135
00:10:11,170 --> 00:10:12,550
!لا تفقدي هذا العزم

136
00:10:12,920 --> 00:10:13,880
!لا تفلتيها

137
00:10:14,050 --> 00:10:17,010
!سخّري كلّ هذه القوّة في الطّريق

138
00:10:17,260 --> 00:10:19,380
...رائحة احتراق الإطارات

139
00:10:19,550 --> 00:10:20,970
تبّاً، يا لها من ليلة

140
00:10:23,140 --> 00:10:24,720
!تفضّلن

141
00:10:24,890 --> 00:10:28,770
!غاية في الجمال كالعادة اللّيلة
!وأنتما الفتاتان الجديدتان أيضاً

142
00:10:28,940 --> 00:10:31,810
!معك حقّ. تفضّلن

143
00:10:32,110 --> 00:10:36,400
،كان أبي يُحضرني إلى هنا أحياناً
في الأيّام الّتي يربح فيها في سِباق الخيل

144
00:10:39,070 --> 00:10:40,610
مطعم رامن حقيقيّ

145
00:10:40,780 --> 00:10:42,120
لا تتصرّفي كخبيرة

146
00:10:42,290 --> 00:10:43,360
تفضّلي

147
00:10:43,530 --> 00:10:45,120
شكراً لك

148
00:10:45,540 --> 00:10:47,330
!مُذهل يا آنسة، أظافركِ جميلة

149
00:10:47,540 --> 00:10:49,870
ماذا؟ شكراً لك

150
00:10:50,040 --> 00:10:51,660
أتدرّب لأصبح فنّانة أظافر

151
00:10:51,830 --> 00:10:54,530
!إذاً أعتقد بأنّ كلينا تلميذان

152
00:10:54,910 --> 00:10:55,920
!أجل

153
00:10:56,090 --> 00:10:58,170
!سُرِرتُ بلقائك! وأنتِ أيضاً يا آنسة

154
00:10:58,340 --> 00:11:00,670
لحظة، ألا تعرف ك-آنجل؟

155
00:11:00,840 --> 00:11:04,890
ك-آنجل؟ آسف، أعتقد بأنّ
!عليّ أن أدرس

156
00:11:05,060 --> 00:11:07,180
أجل، أعتقد هكذا هو الأمر

157
00:11:07,350 --> 00:11:10,350
شكراً لك

158
00:11:10,810 --> 00:11:12,480
المعذرة، هل لي بطبق آخر
من المعكرونة رجاء؟

159
00:11:12,650 --> 00:11:13,650
!بكلّ تأكيد

160
00:11:15,480 --> 00:11:16,610
!تفضّلي

161
00:11:16,780 --> 00:11:18,150
...شكـ

162
00:11:25,120 --> 00:11:26,580
سأبدأ بالأكل

163
00:11:29,310 --> 00:11:30,330
!أين أنا؟

164
00:11:30,500 --> 00:11:31,790
...هـ-هل يُعقَل أنّني

165
00:11:31,960 --> 00:11:34,040
!تـ-تحوّلتُ إلى أميرة؟

166
00:11:34,210 --> 00:11:35,250
!أميرة! أميرة

167
00:11:35,420 --> 00:11:36,420
...تـ-تلك الأصوات

168
00:11:36,590 --> 00:11:38,090
!يا فلّاحيّي الصِّغار

169
00:11:38,260 --> 00:11:41,130
!يا أميرة! لا يمكننا زراعة الأرزّ
!ساعدينا

170
00:11:41,800 --> 00:11:44,300
،إن كنتُم لا تستطيعون زِراعة الأرزّ
فكُلوا كعكاً

171
00:11:44,470 --> 00:11:45,680
!لا يمكننا زراعة القمح أيضاً

172
00:11:45,850 --> 00:11:47,010
!هناك جفاف

173
00:11:47,180 --> 00:11:49,180
لماذا تخبرونني وكأنّني لا أستطيع
!فعل شيء حيال الأمر؟

174
00:11:49,350 --> 00:11:51,890
!حسناً، فهمت! دعوا المطر لي

175
00:11:52,140 --> 00:11:53,850
سأؤدّي الآن طقوس صناعة
!المطر المُقدّسة

176
00:11:54,020 --> 00:11:55,810
!أوّلاً، نُحضّر مجموعة كاملة من اللُّفّاح

177
00:11:56,940 --> 00:11:58,940
...ثمّ ببواسطة عذراء الحديد هذه

178
00:11:59,400 --> 00:12:01,110
!نُحوّلها إلى سموزي خضراء

179
00:12:02,200 --> 00:12:03,690
!صحّيّة وجميلة

180
00:12:03,860 --> 00:12:05,700
!ثمّ أشرب هذا وأشتعل حماساً

181
00:12:07,200 --> 00:12:09,580
...آمي... آمي

182
00:12:09,750 --> 00:12:11,500
!ها

183
00:12:16,000 --> 00:12:17,800
!يا فلّاحيّي الصّغار! عيشوا هذا النّعيم

184
00:12:35,230 --> 00:12:38,110
ماذا؟ ماذا تفعلين؟

185
00:12:38,520 --> 00:12:42,320
إذا بقيتُ هنا، سأصبح ضعيفة

186
00:12:42,740 --> 00:12:43,900
يجب عليّ العودة

187
00:12:44,070 --> 00:12:46,150
!لكن كنتِ قد بدأتِ تتحسّنين أخيراً

188
00:12:46,320 --> 00:12:48,740
إذا عدتِ إلى الإنترنت، فسيضرّكِ
!ذلك من جديد

189
00:12:49,330 --> 00:12:51,450
سأكون بخير الآن

190
00:12:51,870 --> 00:12:54,580
بعض الحصول أخيراً على بعض النّوم
الهانئ، اكتشفتُ الأمر

191
00:12:54,920 --> 00:12:57,420
هذا لأنّني أبحث عن ذاتي وأدخل
،في دوّامة خيالات الاضطهاد

192
00:12:57,590 --> 00:12:59,250
،وأحيد عن طريقي للاطّلاع على كلّ رأي

193
00:12:59,420 --> 00:13:03,720
فينتهي المطاف بي بترك المزيد من الضّغينة
تجرحني أكثر من أيّ وقت سبق

194
00:13:04,260 --> 00:13:07,600
الحقيقة القاسية لما يحدث
...على الإنترنت الآن

195
00:13:08,350 --> 00:13:09,930
،الحقيقة هي

196
00:13:10,140 --> 00:13:14,730
الجميع قد نسوا بالفعل كافّة الثّرثرات
،وهزيمة ملاك الإنترنت

197
00:13:15,140 --> 00:13:18,150
وسرعان ما انتقلوا إلى الموضوع
التّالي، أليس كذلك؟

198
00:13:19,150 --> 00:13:23,190
حتّى حقيقة أنّ بشريّاً كان يُدفَع
إلى حافّة الموت

199
00:13:23,820 --> 00:13:27,990
لا تدوم ثلاثة أيّام بالنّسبة للغيلان
الصّغيرة الجائعة المُستميتة لبعض التّحفيز

200
00:13:29,200 --> 00:13:34,160
بالتّأكيد، بعض الكارهين ما زالوا
غالباً يحاولون تمزيقي

201
00:13:35,250 --> 00:13:40,000
وأولئك المُعجبون الّذين كانوا مهووسين
بي ينتظرون عودتي

202
00:13:40,170 --> 00:13:42,460
بينما يُطاردون فتاةً أُخرى جانباً

203
00:13:43,460 --> 00:13:49,970
،في هذا العالم العصريّ الّذي يفيض بالآيدول
هذا كُلّ ما تُساويه قيمة شخص واحد

204
00:13:51,220 --> 00:13:53,310
ممّا يجعل الوقت الآن هو الوقت المثاليّ

205
00:13:53,640 --> 00:13:56,640
،بدؤوا ينسون فحسب

206
00:13:56,850 --> 00:14:00,060
لكن المُعجبين والكارهين على حدٍّ سواء
ما زالوا غارقين في الإشاعات والتّخمينات

207
00:14:00,400 --> 00:14:04,490
،ما دمتُ أُحضّر لقصّة العودة المثاليّة

208
00:14:04,940 --> 00:14:08,280
ستهبط ملاكٌ مرّة أُخرى
في بحر الإلكترونات

209
00:14:11,580 --> 00:14:14,200
مُحال أن أموت في مكانٍ كهذا

210
00:14:14,910 --> 00:14:17,750
ك-آنجل، أنتِ لطيفةٌ في الواقع، أليس كذلك؟

211
00:14:17,920 --> 00:14:18,950
ماذا؟

212
00:14:19,120 --> 00:14:23,170
حسناً، لأنّه في النّهاية، تريدين
،أن تري كافّة مُعجبينكِ ثانية

213
00:14:23,340 --> 00:14:24,710
وتريدين إسعادهم

214
00:14:24,880 --> 00:14:27,300
...طمأنة النّاس هي أمرٌ جيّد، لذا

215
00:14:31,220 --> 00:14:34,390
أجل. فهمتُ الأمر الآن

216
00:14:34,770 --> 00:14:37,230
لا عجب في أنّ رجل مطعم
الرّامن وقع في حُبّك

217
00:14:37,890 --> 00:14:39,730
و-وقع؟

218
00:14:39,900 --> 00:14:43,190
أنتِ طبيعيّة تماماً حقّاً

219
00:14:45,400 --> 00:14:47,780
...لن تفهمي أبداً

220
00:14:48,110 --> 00:14:53,160
حزن وتعطُّش مُهرِّجة مسكينة
لا يراها أحد، ولا يحتاجها أحد

221
00:14:53,330 --> 00:14:58,580
ويجب عليها تحويل حتّى مُعاناتها المُستميتة
إلى عرض فقط لجذب جمهور

222
00:14:58,910 --> 00:15:04,670
وعاء فارغ ومُتكبِّر لا يملك سبباً للتّواجد
ما لم يتوفّر جمهورٌ لملئه

223
00:15:04,960 --> 00:15:08,050
لا يمكن أن أرضى بأُناس عاديّين
يُواسون بعضهم الآخر

224
00:15:08,760 --> 00:15:13,600
بعبارات مُبتذلة معسولة برّاقة ليس إلّا

225
00:15:13,890 --> 00:15:15,640
الصّداقة والعائلة والحُبّ

226
00:15:15,810 --> 00:15:20,310
لا شيء من هذا يجعلني في حالة
يُرثى لها مثل جرعة زائدة من القبول

227
00:15:21,560 --> 00:15:24,730
."لا أستطيع فعل ما هو "عاديّ
لا أستطيع حتّى فهمه

228
00:15:25,150 --> 00:15:28,740
لذا لن أستميل لطريقة تفكيركِ العاديّة

229
00:15:29,030 --> 00:15:32,110
في الواقع، ما قلتِه جعلَني يقينة

230
00:15:32,280 --> 00:15:36,830
يمكنكِ أن تكوني طبيعيّة، لذا يجدر
بكِ أن تعيش حياةً طبيعيّة

231
00:15:37,240 --> 00:15:40,830
أنا ملاك أنانيّة

232
00:15:41,290 --> 00:15:45,420
لا أتحمّل فكرة الموت أثناء الغرق
في حالة استرخاء فاترة

233
00:15:46,500 --> 00:15:47,500
لكن أتعلمين؟

234
00:15:47,880 --> 00:15:52,510
كاتشي، لهذا السّبب ذِراعاكِ
هما الأكثر دفئاً

235
00:15:53,220 --> 00:15:55,390
إذاً يجب عليّ الذّهاب

236
00:15:55,970 --> 00:15:58,970
لأنّكِ طبيعيّة، يمكنكِ أن تكوني
لطيفة مع الآخرين

237
00:15:59,560 --> 00:16:01,690
يمكنكِ أن تعتني بهم حقّاً

238
00:16:02,100 --> 00:16:03,980
لذا ابقي لطيفة للأبد

239
00:16:04,310 --> 00:16:08,280
لأنّ هذا شيئاً لا أحد هنا
يستطيع فعله سواكِ

240
00:16:12,700 --> 00:16:15,160
شكراً لكِ على إنقاذي آنذاك

241
00:16:16,990 --> 00:16:19,290
!برَكة

242
00:16:21,910 --> 00:16:24,000
غادرتْ في نهاية المطاف إذاً

243
00:16:24,250 --> 00:16:27,710
كانت تتصرّف بغرابة منذ مطعم الرّامن

244
00:16:28,050 --> 00:16:31,170
أخبرتْني أن أبقى هادئة للأبد

245
00:16:31,340 --> 00:16:34,720
كما في آخر حلقة من آلترامان؟

246
00:16:35,090 --> 00:16:39,220
كُلّ ما يستطيع فعله ذلك الشّخص
هو إنقاذ كُلّ شيء

247
00:16:39,680 --> 00:16:41,680
،إذاً بالنّسبة لمهرجان الاحتفال بانبعاثها

248
00:16:41,850 --> 00:16:45,480
أقلّ ما يمكنني فعله هو إرسال
لها أروع فُستان يمكن تخيُّله

249
00:16:46,110 --> 00:16:47,650
برَكة

250
00:16:48,690 --> 00:16:51,770
،كلّما أحببتُ البشريّة كَكُلّ

251
00:16:51,940 --> 00:16:57,490
نَقُصَ حُبّي للأفراد. كُلّ شخص بعينه

252
00:16:58,780 --> 00:17:04,540
الجميع يعتقدون بأنّ كلامهم
لا يمكن أن يكون ضربة قاضية

253
00:17:05,170 --> 00:17:08,130
لذا يقذفون سكاكينَ شفهيّة دون أدنى تفكير

254
00:17:09,000 --> 00:17:11,540
حتّى عندما يكون هناك فتى عاديّاً
،أو فتاة خلف الآيدول

255
00:17:11,710 --> 00:17:15,930
تلك السّكاكين الصّغيرة تتضاعف إلى شفرات
لا تُحصَى وتُقطّعهم إرباً

256
00:17:16,760 --> 00:17:20,140
،وأحياناً، نتيجة عجزهم عن تحمُّل الألم

257
00:17:20,390 --> 00:17:23,020
قد يجدون أنفسهم يزحفون أرضاً
بشكل مُثير للشّفقة

258
00:17:35,530 --> 00:17:41,490
لكن بعض النّاس يتألّقون ببريق حقيقيّ
لا يُمكن سحقه بأيّ من هذا

259
00:17:42,120 --> 00:17:47,500
قد يزحفون كاليسروع، ويُعانون
،ويتعرّضون لسخرية

260
00:17:47,670 --> 00:17:51,840
لكن الفراشات الجميلة تستمرّ في بسط
جناحيها المُتلألئتين وتُحلّق

261
00:17:52,510 --> 00:17:58,390
،مهما انهال عليّ هذا العالم بأمطار الخبث
لا يمكن خدش الألماس

262
00:17:59,140 --> 00:18:03,810
سأصبح ظاهرة هائلة تجتاح العصرَ بأكمله

263
00:18:04,520 --> 00:18:10,400
يجب الاستفادة من الشرّ، لأنّه"
"لا يوجد سوى شرّ في هذا العالم

264
00:18:10,770 --> 00:18:12,400
!مرحباً يا ظريفات

265
00:18:12,690 --> 00:18:16,320
!ملاك الإنترنت ك-آنجل تتكلّم

266
00:18:16,650 --> 00:18:18,030
تأخّرتُ عليكم، صحيح؟

267
00:18:18,200 --> 00:18:22,200
،المُعجبون، الكارهون، وجميع المُتفرّجين

268
00:18:22,700 --> 00:18:27,330
كلّ واحد منكم، فليحضر بثّ
!عودة ك-آنجل

269
00:18:27,500 --> 00:18:31,420
!الآن في هذه اللّحظة

270
00:19:03,120 --> 00:19:04,370
!برَكة

271
00:19:05,740 --> 00:19:07,120
جميلة

272
00:19:09,540 --> 00:19:12,460
قد تكون أعظم تحفة لكِ

273
00:19:14,130 --> 00:19:16,130
!حاليّاً على أيّ ال

274
00:19:20,220 --> 00:19:23,430
!الأفضل في الإنترنت

275
00:19:23,600 --> 00:19:25,680
يمكنني الشُّعور بتصاعد النّشوة

276
00:19:25,850 --> 00:19:28,600
سلّميني للأحلام السّعيدة، يا عزيزتي ميسلي

277
00:19:28,770 --> 00:19:30,850
،أتحسّسك برؤوس أصابعي

278
00:19:31,020 --> 00:19:33,600
،أسبح عبر الفضاء السّيبرانيّ
يا فتى الإنترنت

279
00:19:33,770 --> 00:19:38,730
الحزن يدور ويلتوي ويهبط
مع تشغيل لعبة الإنترنت في الظّلام

280
00:19:38,900 --> 00:19:41,240
،أبتسم بينما أسند رأسي عليك

281
00:19:41,410 --> 00:19:44,410
إيّاك أن تنسى فتاة الإنترنت
الخاصّة بك، اتّفقنا؟

282
00:20:17,440 --> 00:20:19,940
عبر الضّوء الأزرق لشاشات العالم

283
00:20:20,110 --> 00:20:23,570
مهمّتي هي شِفاء وحدة كافّة المُنعزلين

284
00:20:23,740 --> 00:20:25,780
!لأنّني ملاك الإنترنت

285
00:20:25,950 --> 00:20:27,580
!برَكة

286
00:20:28,740 --> 00:20:33,290
،بالأغنية الجديدة للملاك العائدة
!عدد مُتابعينها يزداد بشكل هائل

287
00:20:33,620 --> 00:20:35,370
،لم تغزُ اليابان فحسب

288
00:20:35,540 --> 00:20:37,790
!إنّها تُصبح مُؤدّية البثّ الأولى في العالم

289
00:20:37,960 --> 00:20:41,800
!شكراً لكم جميعاً

290
00:20:42,220 --> 00:20:46,380
والآن لنقلها معاً

291
00:20:46,550 --> 00:20:47,760
برَكة

292
00:20:48,180 --> 00:20:50,020
جاهزون؟

293
00:20:50,560 --> 00:20:53,940
!برَكة

294
00:22:30,070 --> 00:22:34,080
بعد فترة من بلوغ ك-آنجل المركز
،الأوّل في العالم كمُؤدّية بثّ

295
00:22:34,410 --> 00:22:37,670
اختفتْ ببساطة عن الإنترنت

296
00:22:38,710 --> 00:22:42,170
اعتزلت الإنترنت فعلاً

297
00:22:43,800 --> 00:22:46,420
بدلاً من ذلك، شيّدتْ هذه الكنيسة

298
00:22:47,170 --> 00:22:50,640
،إنّها تُفتَح لأربع وعشرين ساعة
كي لا يصبح أحدٌ وحيداً في اللّيل

299
00:22:51,140 --> 00:22:54,640
هنا، تُرتَّل التّرنيمات الّتي لا تنتمي
لدين بلا نهاية

300
00:22:54,810 --> 00:22:58,850
،تخفيف الأعباء عن أولئك الّذين يزورون
ولو قليلاً

301
00:23:00,060 --> 00:23:04,690
في المرّة المُقبلة، سأخبرك بما حدث بعد
الحكاية الخُرافيّة الأسطوريّة الّتي نسجَتْها ملاك

302
00:23:05,690 --> 00:23:10,700
قصّة عن أشخاص عاديّية وعباقرة
بعد اعتزالهم الإنترنت

303
00:23:11,780 --> 00:23:13,490
بعبارة أُخرى، إنّها خاتمة غير ضروريّة

304
00:23:13,660 --> 00:23:16,000
لكن اسمعي على أيّ حال

305
00:23:17,000 --> 00:23:20,880
،حتّى نهاية قصّة قصيرة شائعة
،رُويَتْ بواسطة شخص عاديّ

306
00:23:21,500 --> 00:23:23,920
عن أشخاص عاديّين يعيشون حياة
عاديّة بأفضل ما عندهم

307
00:23:26,260 --> 00:23:28,380
،من خلال الوهج الأزرق لشاشتهم

308
00:23:28,550 --> 00:23:30,670
سافرتْ من أوتاكو وحيدة إلى أوتاكو
وحيدة، لتُشفيهم واحداً تلو الآخر

309
00:23:30,840 --> 00:23:36,390
أجل. كانت، بلا شكّ، ملاك الإنترنت

310
00:23:36,850 --> 00:23:39,940
"الحلقة الأخيرة، "إيز دو دانس