1
00:00:05,520 --> 00:00:09,780
كلّ واحد منّا أشاح بنظره عن الحقيقة

2
00:00:11,360 --> 00:00:14,320
وغرقَ أكثر فأكثر في عالم الإنترنت

3
00:01:48,000 --> 00:01:52,000
برَكة

4
00:01:54,670 --> 00:01:57,010
!أجل! أنا آسف

5
00:01:55,010 --> 00:01:57,010
ما كان من المُمكن أن يكون

6
00:01:57,170 --> 00:01:59,970
،في الصّباح الباكر غداً! المعذرة
سأُخبر العميل

7
00:01:59,970 --> 00:02:01,430
أجل! أنا آسف

8
00:02:11,770 --> 00:02:14,360
أردتُ حقّاً حضور ذلك الحفل الموسيقيّ

9
00:02:31,540 --> 00:02:32,920
مرّر للإغلاق

10
00:03:04,910 --> 00:03:06,580
!قلتُ أنّه لا يوجد المزيد

11
00:03:06,580 --> 00:03:08,160
!أيّ هُراء هذا؟! سلّميه

12
00:03:08,160 --> 00:03:09,960
!أقول لك لا يوجد شيء، أُقسم بذلك

13
00:03:09,960 --> 00:03:11,460
!هيّا! توقّف

14
00:03:11,460 --> 00:03:12,960
!إذاً اذهبي واكسبي مزيداً من المال

15
00:03:12,960 --> 00:03:15,880
ماذا؟! أنا تلميذة! لا أستطيع
!الاستمرار في هذا

16
00:03:15,880 --> 00:03:18,760
ماذا؟ أتعتقدين بأنّكِ الوحيدة
!الّتي تُعاني؟

17
00:03:18,760 --> 00:03:20,840
!هل لديكِ أدنى فكرة كم أُعاني؟

18
00:03:20,840 --> 00:03:23,930
!رُبّما لا تُحاول بما يكفي
!لم تعد تتمرّن حتّى

19
00:03:23,930 --> 00:03:25,050
!ماذا قلتِ؟

20
00:03:27,720 --> 00:03:30,020
...أنا آسف. إنّني

21
00:03:30,390 --> 00:03:31,600
لا تقترب منّي

22
00:03:31,850 --> 00:03:35,610
أنا قمامة. أنا آسف جدّاً

23
00:03:35,610 --> 00:03:37,610
أنا... لا أملك سواك

24
00:03:44,990 --> 00:03:47,700
سنُعلّمكم ما يحدث عندما تتحدّون ملاكنا

25
00:03:47,700 --> 00:03:49,200
!أنت! اخرج أيّها الطّفل

26
00:03:49,200 --> 00:03:52,040
!أتُشاهد البثّ؟ سنستهدفك تالياً

27
00:03:54,000 --> 00:03:56,750
!مهلاً، يا رجل

28
00:03:57,460 --> 00:04:00,630
!أيّها النّاضجون حديثاً! الموت لكم

29
00:04:00,920 --> 00:04:02,590
!هذا هو! هذا هو النّمط

30
00:04:02,590 --> 00:04:05,140
!فعلَ جيفاني كُلّ ذلك في ليلة واحدة

31
00:04:05,140 --> 00:04:06,640
!أنا ميّتة حرفيّاً

32
00:04:13,440 --> 00:04:16,770
أنا أميرة أجمل من أيّ شخص

33
00:04:33,910 --> 00:04:35,120
أبي؟

34
00:06:08,880 --> 00:06:11,260
أطلق عليّ بذلك المُسدّس الأرجوانيّ

35
00:06:12,430 --> 00:06:14,060
!حسناً! إيقاف

36
00:06:16,980 --> 00:06:19,020
من أين أتى اسمي؟

37
00:06:19,440 --> 00:06:22,310
،فات الأوان على ذلك قليلاً الآن
،لكن عندما كنتُ صغيرة

38
00:06:22,310 --> 00:06:26,190
قرأتُ بأنّ "رصاص حلوى السكّر
"لا تستطيع اختراق شيء

39
00:06:26,190 --> 00:06:29,280
كانت الرّسالة حول كيف أنّ رصاص المصّاصات
،الحُلوة الّتي تكون هكذا

40
00:06:29,280 --> 00:06:32,280
لا يمكنها اختراق جدار الحقيقة السّميك

41
00:06:34,120 --> 00:06:36,450
أحببتُها كثيراً

42
00:06:36,450 --> 00:06:39,790
لكن بعدها حزنت، مُدركة بأنّنا
لا نستطيع البقاء كالحلوى للأبد

43
00:06:41,540 --> 00:06:43,880
رغم ذلك، بينما كنتُ أجلس
،هناك أمام شاشتي

44
00:06:43,880 --> 00:06:48,300
فكّرتُ في إشهار مُسدّسي الأرجوانيّ وشقّ
طريقي عبر هذه الحقيقة التّافهة

45
00:06:48,590 --> 00:06:51,640
من كان يتوقّع أن تلعب فتاتُنا
الصّغيرة دور البطولة في فيلم؟

46
00:06:51,640 --> 00:06:52,970
!أمّي؟ أبي؟

47
00:06:52,970 --> 00:06:55,310
أنا مسرورٌ فحسب لأنّكِ صرتِ أخيراً
قادرة على الخروج

48
00:06:55,310 --> 00:06:57,270
!لماذا أنت هنا بالتّحديد؟

49
00:06:57,270 --> 00:07:01,100
بئس الأمر. هربتِ فجأة من المنزل

50
00:07:01,100 --> 00:07:03,310
قائلة بأنّكِ ستحضرين حفل الملاك الموسيقيّ

51
00:07:03,310 --> 00:07:05,610
كنتِ عازمة على مُطاردة تلك الفتاة

52
00:07:05,610 --> 00:07:06,820
هل تمكّنتُما من أن تُصبحا صديقتين؟

53
00:07:06,820 --> 00:07:10,320
!اصمت! كان ذلك منذ زمن بعيد! بعيد جدّاً

54
00:07:12,070 --> 00:07:16,330
شيئاً فشيئاً، انجرفنا عن الإنترنت

55
00:07:16,910 --> 00:07:18,580
وواجهنا الحقيقة

56
00:07:18,580 --> 00:07:22,670
ورويداً رويداً، كبِرنا واستطعنا
السّير بخُطى ثابتة

57
00:07:23,210 --> 00:07:26,750
كُلّ واحدة منّا سلكتْ دربَها
الخاصّ عبر عالم الحقيقة

58
00:07:27,760 --> 00:07:32,430
استمرّتْ لوليبوب في أن تُصبح عارضة الأزياء
والرّياديّة العالميّة

59
00:07:33,090 --> 00:07:35,850
بعد لعِب دور البطولة في فيلم هنا
،في اليابان، صرّحتْ

60
00:07:35,850 --> 00:07:41,440
"اليابان مسرح صغير جدّاً على تألُّقي"
وسافرتْ إلى أوروبّا

61
00:07:42,650 --> 00:07:44,860
صنعتْ علامتها التّجاريّة الخاصّة

62
00:07:44,860 --> 00:07:49,110
واستخدمتْ بثوثها للحديث عن الأزياء
كطريقة لإلهام الرُّوح حول الموضة

63
00:07:49,360 --> 00:07:53,030
رسالة لوليبوب قد أثّرتْ بشكل هائل
على الفتيان والفتيات حول العالم

64
00:07:53,030 --> 00:07:56,450
قائلة بأنّ الأزياء بوسعها
منحك الشّجاعة والثِّقة

65
00:08:03,870 --> 00:08:06,790
حتّى بعد أن أصبحت مشهورة جدّاً
،كامرأة أعمال

66
00:08:06,790 --> 00:08:10,460
امتعض الكارهون قائلين بأنّها "من الواضح أنّ همّها
هو المال"، فاستشاطتْ غضباً

67
00:08:11,260 --> 00:08:13,090
واختطفتْ بعض الدبّابات

68
00:08:13,090 --> 00:08:17,390
وسارتْ بها عبر البلدة أثناء توزيع
ثروتها كُلّها للجماهير

69
00:08:18,260 --> 00:08:23,020
أشعلتْ مُجازفاتها الشّائنة جدلاً
في كلّ مرّة

70
00:08:24,270 --> 00:08:28,110
لكن كانت أسطورة الرّوك أند رول لوليبوب
،تنتشر أكثر مع الوقت

71
00:08:28,110 --> 00:08:30,480
ما أكسبَها مزيداً من الدّاعمين حتّى

72
00:08:30,860 --> 00:08:35,450
سأوزّع فساتينَ وإكسسوارات مُباشرةً إليكم

73
00:08:35,450 --> 00:08:38,450
كُلّ ما عليكم هو تغليف أنفسكم
،بقماش تلك الملابس الأنيقة

74
00:08:40,950 --> 00:08:47,380
أزياء لوليبوب المُبهرة والجميلة
!سوف تُزيّن روحكم كجوهرة

75
00:08:48,590 --> 00:08:49,800
!بام

76
00:08:55,090 --> 00:08:56,590
!آسفة لتأخُّري

77
00:08:57,050 --> 00:09:01,970
نجحتْ ميتشيكا كعارِضة أزياء
،وأصبحتْ أميرة أزياء اللّوليتا

78
00:09:01,970 --> 00:09:05,600
ليُعجَب بها القوطيّون في كُلّ
أرجاء العالم

79
00:09:06,020 --> 00:09:09,610
كانت أحياناً تستعرض أزياء
من صنع لوليبوب

80
00:09:06,480 --> 00:09:08,270
حسناً؟ ما رأيك بهذا الفُستان؟

81
00:09:08,270 --> 00:09:09,610
فضفاض قليلاً

82
00:09:09,980 --> 00:09:12,190
بنَتِ الاثنتان علاقة متينة

83
00:09:10,480 --> 00:09:12,610
حسناً، ما هذه المجموعة من النّاس؟

84
00:09:13,150 --> 00:09:15,610
!من فضلكِ، رسالة لمُعجبينكِ حول العالم

85
00:09:16,200 --> 00:09:18,160
هذا جزءٌ من العمل أيضاً

86
00:09:18,870 --> 00:09:20,030
أصبحتْ قادرة أيضاً

87
00:09:20,030 --> 00:09:23,620
على التكلُّم عن أذيّتها لنفسها في الماضي
وتجربتها مع الجرعات الزّائدة من العقاقير

88
00:09:24,250 --> 00:09:28,880
الأذى الذّاتي والعقاقير لن تُزيدك إلّا بؤساً

89
00:09:29,210 --> 00:09:33,920
لكن هناك دوماً سبب يجعل النّاس ينتهي المطاف بهم
في بيئة تجعلهم يفعلون تلك الأشياء

90
00:09:34,300 --> 00:09:37,380
لذا أوّلاً، لا ينبغي أن نصدّهم
"ونُخبرهم أن "يتوقّفوا

91
00:09:37,380 --> 00:09:40,550
يجب أن نسمعهم. نسمعهم فحسب

92
00:09:40,890 --> 00:09:42,220
وبعد ذلك، نقرأ هذا

93
00:09:42,640 --> 00:09:44,930
مُؤخّراً، نشرتْ روايةً أيضاً

94
00:09:45,310 --> 00:09:48,230
"عنوانها "الجانب المُظلم من القمر

95
00:09:48,850 --> 00:09:51,400
نظرتها الخياليّة والحالمة للعالم

96
00:09:51,400 --> 00:09:54,990
منحتْ هلوسات للمُراقبين
في كلّ أرجاء المعمورة

97
00:09:55,530 --> 00:09:58,110
!تهانينا اقتباس الفيلم

98
00:09:58,110 --> 00:10:01,240
وبلعبكِ دور بطولة نفسك! كيف
هو شعوركِ الآن؟

99
00:10:02,790 --> 00:10:05,500
،مهما كان العالم قاسياً وقبيحاً

100
00:10:06,120 --> 00:10:08,620
ما دمتُ جميلة، فهذا يكفي

101
00:10:09,040 --> 00:10:11,210
،حتّى لو سقطتُ في الجحيم

102
00:10:11,880 --> 00:10:15,090
ولو تلطّختُ بالدّماء، أنا
أجمل من أيّ أحد

103
00:10:15,670 --> 00:10:19,430
اختفتْ نيتشيكا عن حياتنا دون قول كلمة

104
00:10:20,050 --> 00:10:23,010
الأُخرتان قالتا بأنّهما لطالما شعرتا
بأنّ ذلك سيحدث في نهاية المطاف

105
00:10:23,510 --> 00:10:28,440
،كان ذلك ما أدّى إلى تفكُّك كارامازوف
وكُلّ واحدة منهن سلكتْ دربَها الخاصّ

106
00:10:28,440 --> 00:10:35,030
سأُشجّعك دوماً

107
00:10:29,350 --> 00:10:32,270
أحياناً، نقلق بشأن المكان
الّذي قد تكون فيه نيتشيكا

108
00:10:32,270 --> 00:10:35,030
لكن المال الّذي تُرسله إلى الدّيار
،حيث أخوتها الأصغر لا يتوقّف أبداً

109
00:10:35,030 --> 00:10:37,240
وهكذا علِموا بأنّها لا تزال هناك
في مكانٍ ما

110
00:10:37,240 --> 00:10:39,910
الأخوة الثّلاثة يقولون الكلامَ ذاته

111
00:10:39,910 --> 00:10:41,910
!ما دامت حيّة، فهذا يكفي

112
00:10:42,160 --> 00:10:45,660
حياة ما بعد السّعادة الأبديّة مُملّة للغاية

113
00:10:45,910 --> 00:10:48,460
لذا قرّرتُ البحث عن بقيّة الحلم

114
00:10:51,960 --> 00:10:54,250
وجدتُك أخيراً أيّتها الفتاة القوطيّة

115
00:10:55,000 --> 00:10:56,210
لماذا؟

116
00:10:56,630 --> 00:11:00,010
أصدقاؤكِ التخيّليّون لم يعودوا
يظهرون، أليس كذلك؟

117
00:11:00,260 --> 00:11:03,350
بدوتِ في وِحشة بكونكِ وحيدة للأبد

118
00:11:03,800 --> 00:11:06,020
كان من المُمكن أن تحظي
بمُستقبل مُختلف

119
00:11:06,020 --> 00:11:08,640
أيّ واحد منّا كان من المُمكن
أن يفقد صوابه في أيّ لحظة

120
00:11:08,640 --> 00:11:11,440
كنّا جميعاً نسير على خطّ
رفيع من الاحتمالات

121
00:11:11,850 --> 00:11:14,270
كفراشة تُرفرف بجناحيها وتخلق زوبعة

122
00:11:14,940 --> 00:11:18,280
حيث أخوتها الأصغر لا يتوقّف أبداً

123
00:11:18,530 --> 00:11:23,240
فأجابتْها تلك الملاك المُتقلّبة

124
00:11:24,450 --> 00:11:27,580
لذا، أيّتها الأميرة المُدلّلة الّتي حصلتْ
،على كلّ ما تريده

125
00:11:27,580 --> 00:11:28,950
ماذا تُريدين تالياً؟

126
00:11:30,120 --> 00:11:33,790
لم أحصل على أكثر شيء أردتُه

127
00:11:35,340 --> 00:11:36,630
وما هو؟

128
00:11:58,070 --> 00:12:02,740
أنتِ تمتلكينه بالفعل، أليس كذلك؟
الملاك السّابقة لديها أصدقاء

129
00:12:07,330 --> 00:12:11,460
في أيّام الإعداديّة، ثمّة شخص
أعرفه قتل نفسه

130
00:12:11,750 --> 00:12:14,250
من الصّعب إنقاذ شخص في النّاحية
الأُخرى من الشّاشة

131
00:12:14,670 --> 00:12:17,040
أجل. لم تكن بيدي حيلة

132
00:12:17,290 --> 00:12:19,260
كنتُ أتمالك نفسي بالكاد

133
00:12:20,130 --> 00:12:26,260
،لكن أتذكّر بأنّني فكّرتُ مليّاً
...ما إن كنتُ أستطيع إنقاذ ولو أوتاكو وحيد

134
00:12:26,890 --> 00:12:28,930
...ومع ذلك، أنا

135
00:12:29,640 --> 00:12:32,520
أنقذتِ كثيراً من النّاس

136
00:12:32,730 --> 00:12:35,440
لذا لن تضطرّي لتكوني وحيدة ثانية أبداً

137
00:12:35,650 --> 00:12:36,810
تفضّلي

138
00:12:44,990 --> 00:12:48,280
هيّا يا جيوفاني. لنذهب ونبحث
عن السّعادة الحقيقيّة

139
00:12:49,030 --> 00:12:50,660
!إيسبيرا، موتشا

140
00:12:53,040 --> 00:12:55,540
!تشاو! بوا فياجيم

141
00:13:01,340 --> 00:13:03,300
شكراً لك يا كامبانيلّا

142
00:13:07,300 --> 00:13:08,640
بالمُناسبة

143
00:13:09,510 --> 00:13:13,560
...آمي ليس اسمي الحقيقيّ. إنّه

144
00:13:14,440 --> 00:13:19,980
وبالنّسبة لي، الّتي لستُ ملاكاً، ولستُ
...مُؤدّية البثّ الأولى سابقاً في اليابان

145
00:13:20,360 --> 00:13:23,690
حسناً، نلتُ نصيبي من التقلُّبات

146
00:13:29,620 --> 00:13:34,250
،عندما رأيتُ أظافركِ آنذاك يا كاتشي
لاحظتُ بأنّها كانت مُذهلة

147
00:13:34,620 --> 00:13:39,170
،كشخص يطمح لأن يكون فنّاناً أيضاً
أردتُ تشجيعكِ حقّاً

148
00:13:39,460 --> 00:13:42,670
وأريد الاستمرار في دعم حلمكِ

149
00:13:43,550 --> 00:13:45,260
...لذا، تفضّلي

150
00:13:46,510 --> 00:13:50,350
تعلم بأنّ علامتي التّجاريّة ليست
شيئاً يمكنك تحمُّل تكاليفه، صحيح؟

151
00:13:50,350 --> 00:13:54,270
أنا آسف. لا أعرف حقّاً ماذا يُفترض
أن يكون ثمن هذه الأشياء

152
00:13:54,730 --> 00:13:58,270
لكن ارتأيتُ بأنّ شيئاً من علامتكِ التّجاريّة
سوف يجعلها الأسعد يا لوليبوب

153
00:13:58,980 --> 00:14:01,690
أعطتْني بعض أقراط الأذن منذ زمن بعيد

154
00:14:01,690 --> 00:14:03,480
سنعتبر هذا ردّ جميل لها

155
00:14:03,480 --> 00:14:05,110
!لا تنظر للسّعر

156
00:14:05,110 --> 00:14:06,900
!قيمته مليون طبق من الرّامن الّذي تشتريه

157
00:14:06,900 --> 00:14:11,280
!شكراً جزيلاً لكِ! أُقسم بأنّني سأُسعدها

158
00:14:11,280 --> 00:14:13,290
...وإن لم تفعل

159
00:14:15,290 --> 00:14:16,290
سأقتلك

160
00:14:22,210 --> 00:14:24,630
!أجل! أنا جاهزٌ لذلك

161
00:14:40,060 --> 00:14:41,810
...هل هذا

162
00:14:43,190 --> 00:14:44,820
شكراً لك

163
00:14:44,820 --> 00:14:48,820
أنت لا تأبه للأزياء إطلاقاً، لكن بطريقة ما
عرفتَ العلامة التّجاريّة الأمثل

164
00:14:52,580 --> 00:14:54,830
!إنّه أفضل إكسسوار على الإطلاق

165
00:14:57,000 --> 00:14:59,080
إنّه ناضجٌ حقّاً

166
00:14:59,080 --> 00:15:01,330
حسناً، أعتقد بأنّه نالَ برَكتي

167
00:15:01,330 --> 00:15:03,170
!أنتما ثقيلان

168
00:15:03,170 --> 00:15:06,460
تبدو أسعد من أيّ شخص رأيتُه

169
00:15:13,640 --> 00:15:14,470
!مرحباً

170
00:15:16,350 --> 00:15:18,350
لحظة، ماذا؟-
مرحباً-

171
00:15:19,060 --> 00:15:22,690
!هل كنتُم تتنصّتون علينا؟

172
00:15:22,690 --> 00:15:23,980
ويحك، ويحك

173
00:15:25,360 --> 00:15:27,480
تظهر وتختفي فجأة

174
00:15:27,480 --> 00:15:28,780
ما الّذي تفعله بالضّبط؟

175
00:15:31,360 --> 00:15:33,950
سمعتُ بأنّ جولتك على مستوى
!البلد حقّقتْ مبيعات كاملة

176
00:15:33,950 --> 00:15:36,370
!أنت فنّان من المراتب الأولى الآن! مُذهل

177
00:15:36,540 --> 00:15:37,790
لا، إطلاقاً

178
00:15:37,790 --> 00:15:40,500
هل تتذكّر أوّل مرّة ظهرتَ فيها
في هذا العرض؟

179
00:15:40,500 --> 00:15:42,000
إنّها ذِكرى أتمنّى محوها

180
00:15:42,000 --> 00:15:44,960
.وها نحن نشهد تاريخه المُظلم
!حسناً، لا يهمّ

181
00:15:44,960 --> 00:15:48,130
!ولدينا هنا الآن رقم يبدو جيّداً فعلاً

182
00:15:48,130 --> 00:15:50,090
أستمع إليه طوال الوقت بحدِّ ذاتي

183
00:15:50,510 --> 00:15:52,010
!إيز دو دانس

184
00:15:53,050 --> 00:15:55,470
حدثتْ أمور كثيرة فعلاً

185
00:15:56,510 --> 00:15:59,020
...لكن الآن

186
00:16:05,270 --> 00:16:09,110
أعيش حياتي العاديّة بسعادة

187
00:16:09,780 --> 00:16:11,820
حياتي العاديّة الخاصّة

188
00:17:31,610 --> 00:17:34,320
هل ستختفين في مكانٍ ما أيضاً؟

189
00:17:34,610 --> 00:17:37,620
قرّرتُ أن أرى عالماً جديداً

190
00:17:37,620 --> 00:17:40,330
،الآن بعد أن اكتمل هذا المكان
لا أتحسّر على شيء

191
00:17:40,580 --> 00:17:43,330
سأبحث عن سعادة حقيقيّة

192
00:17:43,910 --> 00:17:48,420
إن كان من المُمكن إنقاذ هائم
هنا، فهذا يكفي

193
00:17:48,920 --> 00:17:52,050
حتّى لو سكّنَ ذلك وحدته للحظة واحدة

194
00:17:52,630 --> 00:17:55,130
لا يوجد إلهٌ في هذا العالم

195
00:17:55,380 --> 00:17:58,760
ولهذا السّبب بالضّبط، عندما
،تُصلّي روحٌ وحيدة

196
00:17:58,760 --> 00:18:01,350
لا بُدّ من وجود مكان
يمكن إنقاذها فيه

197
00:18:01,930 --> 00:18:05,350
ملاك وُلِدت من تشوُّهات الإنترنت

198
00:18:05,770 --> 00:18:07,850
،قبل أن تختفي عن الإنترنت

199
00:18:07,850 --> 00:18:11,940
هلّا لبّيتِ أُمنية الفتاة الّتي أنقذتِها؟

200
00:18:12,780 --> 00:18:15,740
بالتّأكيد. فأنا ملاك

201
00:18:32,550 --> 00:18:34,760
ك-آنجل

202
00:18:39,760 --> 00:18:43,760
افتح فوراً

203
00:19:25,180 --> 00:19:26,770
أنت

204
00:19:26,770 --> 00:19:28,270
!أيّها الظّريف

205
00:19:33,270 --> 00:19:35,690
...شُعاع أمل

206
00:19:37,320 --> 00:19:41,490
يُضيء هذا الإنترنت الفوضويّ
!من العصر الحاليّ

207
00:19:43,570 --> 00:19:45,830
...ملاك الإنترنت

208
00:19:46,620 --> 00:19:48,410
قد هبطتْ

209
00:19:49,080 --> 00:19:50,580
!أتيتُ لأقلك

210
00:19:54,210 --> 00:19:57,000
!قذِر في طريق الأوتاكو ذاك. مُقرف

211
00:19:57,880 --> 00:20:01,090
!حسناً، ستأتي معي لرؤية المُحيط

212
00:20:03,180 --> 00:20:04,430
المُحيط؟

213
00:20:05,890 --> 00:20:07,560
ك-آنجل؟

214
00:20:08,720 --> 00:20:09,680
!أجل

215
00:20:17,570 --> 00:20:20,280
!ك-آنجل، بذلتُ قصارى جهدي

216
00:20:20,440 --> 00:20:23,200
،رغم أنّني لم أنخرط مع المُجتمع، عملت

217
00:20:23,200 --> 00:20:25,280
واستمررتُ في العيش حتّى عندما
!سَخِرَ النّاسُ منّي

218
00:20:25,490 --> 00:20:27,370
أجل. أبليتَ حسناً

219
00:20:27,790 --> 00:20:30,870
هذا مُذهلٌ حقّاً

220
00:20:33,120 --> 00:20:35,920
مُدهش! إنّه كذلك بالفعل

221
00:20:41,760 --> 00:20:44,050
!المُحيط! لنرَ المُحيط

222
00:20:44,640 --> 00:20:45,930
إنّه هناك

223
00:20:45,930 --> 00:20:47,850
!هذا صحيح

224
00:20:47,930 --> 00:20:49,220
!إنّه جميل

225
00:20:49,220 --> 00:20:50,390
!وواسعٌ جدّاً

226
00:20:52,140 --> 00:20:55,020
!ك-آنجل، ك-آنجل

227
00:20:55,020 --> 00:20:56,360
نعم؟

228
00:20:56,360 --> 00:20:59,860
ك-آنجل، كـ-كيف كانت المدرسة
بالنّسبة لك؟

229
00:21:00,480 --> 00:21:01,610
الأسوأ

230
00:21:01,610 --> 00:21:04,200
أجل، بالنّسبة لي أيضاً-
أجل-

231
00:21:04,200 --> 00:21:07,240
طريقة قُدرتك على استخراج
،نكتة من كلّ شيء

232
00:21:07,240 --> 00:21:10,790
"مثل، "ما هذا بحقّ السّماء؟
فيُصبحون مُشاكسين جميعهم

233
00:21:10,790 --> 00:21:12,910
لا أعلم بشأنك، لكن كنتُ
أشعر بالغيرة قليلاً

234
00:21:12,910 --> 00:21:14,750
بدوتِ حُرّة تماماً

235
00:21:15,620 --> 00:21:16,710
هكذا إذاً

236
00:21:16,710 --> 00:21:19,000
!ك-آنجل، ك-آنجل-
ماذا؟-

237
00:21:19,000 --> 00:21:20,590
...المعذرة

238
00:21:20,590 --> 00:21:22,970
هل لديك والدان؟ كذكريات معهما؟

239
00:21:22,970 --> 00:21:26,140
أقصد هل تعيشين مع أمّكِ وأبيكِ
وجدّكِ وجدّتكِ؟

240
00:21:26,140 --> 00:21:28,350
لا أملك شخصاً كهذا-
لا؟ لا أحد؟-

241
00:21:28,350 --> 00:21:29,640
حسناً، هكذا إذاً

242
00:21:29,640 --> 00:21:32,980
لكن هناك ذلك المفهوم المُحيط
حول بقائكِ وحيدة

243
00:21:32,980 --> 00:21:36,560
هكذا ينبغي أن تعيشي. أنا مُعجب بذلك

244
00:21:36,560 --> 00:21:39,230
هـ-هذا أشبه بالتغلُّب على العقبات

245
00:21:39,230 --> 00:21:41,150
هذه هي فكرتي فحسب. إنّها مُدهشة

246
00:21:41,690 --> 00:21:43,690
!ك-آنجل، ك-آنجل

247
00:21:43,690 --> 00:21:46,700
...لا، ماذا ينبغي أن أسأل؟ المعذرة، حسناً

248
00:21:46,700 --> 00:21:49,910
متى تعقّدت الأمور، أعود وأُشاهد
بثوثكِ القديمة

249
00:21:49,910 --> 00:21:51,990
مدّتْني بالشّجاعة

250
00:21:51,990 --> 00:21:53,410
!شكراً لك

251
00:21:53,410 --> 00:21:56,250
لا عليك. من الآن فصاعداً، سنبقى معاً دوماً

252
00:21:56,250 --> 00:21:59,210
أجل! أُحبّكِ يا ك-آنجل

253
00:22:00,250 --> 00:22:02,960
أُحبّك أيضاً أيُّها الأوتاكو الصّغير

254
00:22:13,470 --> 00:22:14,850
!وقت سرّيّ

255
00:22:14,850 --> 00:22:18,400
ما بعد هذه النّقطة حرق أحداث
!مُهم لحياتك

256
00:22:18,400 --> 00:22:21,520
!من ليس جاهزاً، فليُطفئ شاشته حالاً

257
00:22:21,900 --> 00:22:22,900
!ثلاثة

258
00:22:22,900 --> 00:22:23,900
!اثنان

259
00:22:23,900 --> 00:22:24,900
!واحد

260
00:22:25,070 --> 00:22:29,320
انتهى ذلك بسلاسة أيضاً

261
00:22:29,320 --> 00:22:31,910
أنتِ طمّاعة حقّاً

262
00:22:32,200 --> 00:22:36,210
أجل. هذه النّهاية هي إحدى
الاحتمالات غير النّهائيّة

263
00:22:36,330 --> 00:22:39,080
قطعة صغيرة جدّاً من كافّة
الاحتمالات بداخلي

264
00:22:39,080 --> 00:22:41,790
يمكن للبشر أن يُصبحوا أيّ شيء

265
00:22:42,040 --> 00:22:44,630
وهذا أمرٌ قاسٍ جدّاً

266
00:22:45,260 --> 00:22:48,630
لأنّ جميعكم لديكم احتمالات
غير محدودة أيضاً

267
00:22:48,630 --> 00:22:53,390
في نفس الوقت، هناك عدد لا ينتهي من المُستقبل
حيث لا تُصبح أحداً على الإطلاق

268
00:22:53,810 --> 00:22:57,890
.كالتّبديل من قناة لأُخرى
كتشغيل الفيديو التّالي

269
00:22:58,140 --> 00:23:00,650
استمرّ في استهلاك الآخرين فحسب

270
00:23:00,650 --> 00:23:04,480
،مُتشبّثاً بأمل الاحتماليّات
وهائماً للأبد

271
00:23:05,400 --> 00:23:10,870
لا توجد السّعادةُ الحقيقيّة سوى
في عقلك

272
00:23:11,490 --> 00:23:16,120
،كُلّ نهاية هي نهاية سعيدة
وكُلّ نهاية هي نهاية بائسة

273
00:23:17,160 --> 00:23:22,670
،الجواب موجودٌ أمامك مُباشرة
لكنّك لن تراه أبداً. مسكين

274
00:23:23,340 --> 00:23:27,800
رغم ذلك، لا تنسَ أن تستمرّ
في مُحاولة أن تكون سعيداً

275
00:23:28,220 --> 00:23:31,430
في هذا العالم حيث لا آلهة
ولا ملائكة، تُصبح على خير

276
00:23:32,220 --> 00:23:34,390
هيّا، لنُمسك بأيدي بعضنا الآخر

277
00:23:34,970 --> 00:23:37,020
!برَكة