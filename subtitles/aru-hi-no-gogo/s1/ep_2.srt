1
00:00:00,000 --> 00:00:02,480
الموت لك
سأقتلك

2
00:00:00,520 --> 00:00:02,480
سأقتلك

3
00:00:02,770 --> 00:00:06,480
سأقتلك. سأقتلك. سأقتلك

4
00:00:02,770 --> 00:00:06,480
!هذا كلّ شيء لبثّ اللّيلة
!لنتنزّه معاً ثانية قريباً

5
00:00:06,480 --> 00:00:10,190
!فلتموتي، فلتموتي، فلتموتي، فلتموتي

6
00:00:07,060 --> 00:00:09,570
الحقيقة مؤلمة حقّاً. مُقرفة للغاية

7
00:00:09,570 --> 00:00:12,400
لكن لا تُبالغوا ولا تُقدموا على أيّ عمل
طائش فقط لأنّكم مُضجَرون، اتّفقنا؟

8
00:00:10,190 --> 00:00:14,700
سأقتلك. سأقتلك. سأقتلك

9
00:00:12,400 --> 00:00:14,700
ناموا جيّداً. تصبحون على خير

10
00:00:14,700 --> 00:00:19,030
!أنا أيضاً! أنا أيضاً! أنا أيضاً

11
00:00:15,530 --> 00:00:16,620
!برَكة

12
00:00:19,490 --> 00:00:21,790
!كان ينبغي أن أكون أنا أيضاً

13
00:01:52,960 --> 00:01:55,970
سُمّ مُباشر في قلب كلّ أوتاكو

14
00:01:55,970 --> 00:01:59,010
فتاة السمّ المُميت دينبا
!مصّاصة أرجوانيّة

15
00:01:59,260 --> 00:02:02,010
الفارس الفضّي الّذي يُشوّش يُغطّي حقيقتكم

16
00:02:02,680 --> 00:02:06,020
!أنا، نيتشيكا، سأرافقكم إلى قاعتنا الخاصّة

17
00:02:06,350 --> 00:02:08,520
الوردة السّوداء هي رمز اللّعنات

18
00:02:08,890 --> 00:02:13,020
ابتهجوا! وردة دماء الجحيم ميتشيكا
تكرهكم حتّى يوم مماتكم

19
00:02:13,320 --> 00:02:15,030
،ما دمتم تريدون ذلك أيّها الأوتاكو

20
00:02:15,030 --> 00:02:19,280
كارامازوف سيُريكم حلماً أبديّاً
بسُمّنا الحُلو

21
00:02:17,070 --> 00:02:18,780
فتاة السمّ المُميت دينبا
!مصّاصة أرجوانيّة

22
00:02:19,280 --> 00:02:23,280
ولهذا السّبب قلتُ بأنّ لدينا
إعلان مُهمّ اليوم، صحيح؟

23
00:02:23,280 --> 00:02:26,540
أتريدون أن تروا؟ أتريدون حقّاً
أن تعرفوا أيّها الأوتاكو الصّغار؟

24
00:02:26,540 --> 00:02:28,830
حسناً، أعتقد بأنّني لا أملك خياراً

25
00:02:28,830 --> 00:02:34,130
ألسنا، كارامازوف، مجموعة البثّ
الأروع في هذه الأيّام؟

26
00:02:34,460 --> 00:02:37,760
من الواضح أنّنا نُخطّط للسّيطرة
،على المشهد كلّه

27
00:02:34,840 --> 00:02:36,670
ميتشيكا غوكوبارا

28
00:02:37,760 --> 00:02:42,010
لكن ما زالت هناك تحفة أثريّة فاشلة
ترفض التخلّي عن مقعدها

29
00:02:42,010 --> 00:02:43,970
هذا لا يُغتفَر، صحيح؟

30
00:02:42,010 --> 00:02:44,180
نيتشيكا-ساما

31
00:02:45,600 --> 00:02:46,680
،لهذا السّبب إذاً

32
00:02:46,680 --> 00:02:49,690
في هذه الأيّام، سأكون أنا
من يؤدّي الطّقوس الأخيرة

33
00:02:49,940 --> 00:02:52,230
،وكخطوة أولى

34
00:02:52,230 --> 00:02:56,690
كارامازوف ستجري حدثَ مُقابلة
تعاونيّة معها دون سواها

35
00:02:58,360 --> 00:03:01,320
!الملاك فائقة الظّرافة، ك.آنجل

36
00:03:19,550 --> 00:03:20,880
متى ستعتزلين أخيراً؟

37
00:03:20,880 --> 00:03:22,130
أنتِ فاشلة في الغناء والرّقص

38
00:03:24,090 --> 00:03:25,470
هل عدتِ لتسويق جمالكِ ثانية؟
الموهبة معدومة

39
00:03:25,470 --> 00:03:27,010
ذلك الغناء الحيّ كان سيّئاً لدرجة
ظننتُ فيها أنّني سأُصبح أصمّاً

40
00:03:39,030 --> 00:03:40,280
!بي

41
00:03:41,150 --> 00:03:44,160
!عملتُ بجدٍّ حقّاً على بثّ اليوم

42
00:03:46,450 --> 00:03:48,830
أنا بخير. أنا لا أكبت أيّ شيء

43
00:03:48,830 --> 00:03:50,500
لستُ مُتضايقة إطلاقاً

44
00:03:50,790 --> 00:03:52,500
!بجدّية

45
00:03:53,370 --> 00:03:56,500
!المُعجبون المُزعِجون الصّاخبون
!الكارهون المُتربّصون البغيضون

46
00:03:57,420 --> 00:03:59,550
إنّهم لا يزعجونني إطلاقاً

47
00:04:00,170 --> 00:04:05,140
ليتني أستطيع تقييدهم وسحلهم في الشّوارع

48
00:04:05,550 --> 00:04:09,890
وربّما سأسلخ جلدهم ببطء بحيث
لا يغيبون عن الوعي

49
00:04:09,890 --> 00:04:11,810
إنّهم كحشرات تحوم حول الأضواء

50
00:04:11,810 --> 00:04:13,350
لا أُبالي البتّة

51
00:04:13,560 --> 00:04:15,310
أنا سعيدة

52
00:04:15,310 --> 00:04:19,190
،أنا مع بي، أكثر شخص أحبّه في العالم
لذا أستطيع فعل أيّ شيء

53
00:04:19,320 --> 00:04:22,070
بي، نحن معاً للأبد

54
00:04:22,610 --> 00:04:24,490
رغم أنّ "للأبد" هي كذبة

55
00:04:29,490 --> 00:04:33,410
على ذكر الأمر، أشعر وكأنّني
وافقتُ على دعوة ما

56
00:04:33,540 --> 00:04:36,080
أظنّني وافقتُ فقط لأنّهم كانوا مُلحّين للغاية

57
00:04:36,080 --> 00:04:37,210
لكن ماذا كان ثانية؟

58
00:04:37,500 --> 00:04:40,210
حسناً! قد لا يكون بالأمر المُهمّ غالباً

59
00:04:40,670 --> 00:04:43,220
بي، ماذا يجدر بنا أن نفعل
للتّسلية اليوم؟

60
00:04:43,420 --> 00:04:47,220
لنثبت أنّ المظلّة هي الشّيء
"الأسرع في "سِباق الذوّاقين

61
00:04:54,140 --> 00:04:59,110
المعذرة، هل من المُناسب لي أن
أتواجد هنا مع ثلاثتكم؟

62
00:05:00,650 --> 00:05:05,400
.مُتفرّج إضافيّ واحد لن يُغيّر شيئاً
لا داعي للقلق

63
00:05:05,400 --> 00:05:09,160
سيراك عشرات الآلاف من النّكرات
بصرف النّظر عن ذلك

64
00:05:09,830 --> 00:05:12,080
على أيّ حال، قلت بأنّكِ أردتِ مُناقشة شيء؟

65
00:05:12,370 --> 00:05:15,080
،قلتُ بأنّني أريد الكلام

66
00:05:15,250 --> 00:05:19,540
لكن لم أتوقّع أن تتمّ دعوتي
أمام بثّ لكارامازوف

67
00:05:19,790 --> 00:05:23,460
ارتأيتُ بأنّ صديقة من صديقات
ميتشيكا ستكون ظريفة

68
00:05:24,840 --> 00:05:26,180
!نيتشيكا-ساما

69
00:05:26,510 --> 00:05:28,260
مُعجباتك سيقتلنَني

70
00:05:28,260 --> 00:05:30,300
ماذا لو فعلنَ ذلك؟

71
00:05:30,300 --> 00:05:31,930
لنستمتع إلى ذلك الحين

72
00:05:31,930 --> 00:05:34,930
لا تفعل شيئاً ينتهي بمقتل صديقتي

73
00:05:36,390 --> 00:05:38,100
حسناً، حسناً

74
00:05:39,310 --> 00:05:43,940
صديقة ميتشيكا المُتباهية هي أندر
من كنز وطنيّ في نهاية المطاف

75
00:05:43,940 --> 00:05:45,990
هل ينبغي أن أقتلك أوّلاً؟

76
00:05:46,280 --> 00:05:51,830
تقول صديقتك ذلك، لكنّها تتوتّر
فجأة في اللّيل أحياناً

77
00:05:52,410 --> 00:05:54,250
كانت كذلك في الإعداديّة أيضاً

78
00:05:54,250 --> 00:05:55,750
ماذا أخبرتها؟

79
00:05:57,410 --> 00:06:00,210
حسناً يا كاتشي، عمّاذا أردتِ أن تتكلّمي؟

80
00:06:00,210 --> 00:06:03,750
يبدو سطحيّاً ومُثيراً للشّفقة
عندما أقوله بشكل علنيّ

81
00:06:04,260 --> 00:06:06,630
لكن لا أنفك أتساءل عن قيمتي حتّى

82
00:06:06,630 --> 00:06:10,340
مُقارنة بكم جميعاً، هذه مُشكلة
بسيطة ومُملّة. هذا سخيف، أليس كذلك؟

83
00:06:10,340 --> 00:06:11,640
هيّا

84
00:06:12,260 --> 00:06:16,060
قبل أيّام، أدّيتُ مُناوبة ضيف
في مقهى بيئيّ للمرّة الأولى

85
00:06:16,060 --> 00:06:18,390
غازلتُ الشّباب الأوتاكو، وبعتُهم
،هذه النّسخة من نفسي

86
00:06:18,390 --> 00:06:20,270
وخرجتُ بعشرات الآلاف من الين

87
00:06:20,270 --> 00:06:22,610
حوّلتُ شبابي إلى مال

88
00:06:22,860 --> 00:06:26,400
جزء من حياتي مُقابل أجر يوميّ
قيمته الآلاف

89
00:06:26,780 --> 00:06:29,860
ثمّ عدتُ إلى المنزل، ولستُ متأكّداً
،حتّى ما إن كان يروقني

90
00:06:29,860 --> 00:06:31,490
لكن سمحتُ لحبيبي بأن يفعل
ما يريد معي

91
00:06:31,490 --> 00:06:33,410
ليس وكأنّني أكرهه بما يكفي للانفصال

92
00:06:33,410 --> 00:06:35,160
إنّه وسيم جدّاً على ما أعتقد

93
00:06:36,120 --> 00:06:38,830
ومن الرّائع أن أكون مرغوبة
بواسطة شخص

94
00:06:40,420 --> 00:06:43,420
عندما أقولها بشكل علنيّ، فإنّه يبدو
سخيفاً، وعاديّاً جدّاً

95
00:06:43,420 --> 00:06:44,250
—أريد المـ

96
00:06:44,250 --> 00:06:48,300
أنت تستخدمين شعور الرغبة فيكِ
لطمأنة نفسكِ بأنّ لديكِ قيمة

97
00:06:48,590 --> 00:06:50,300
،القذر الّذي يتردّد على تلك المقاهي البيئيّة

98
00:06:50,300 --> 00:06:53,050
والفتيات اللّواتي يستغللن حسابات
،السّيلفي خاصّتهن للتبرُّعات

99
00:06:53,050 --> 00:06:55,100
،والشّباب الّذين يرمون الأموال على تلك الفتيات

100
00:06:55,100 --> 00:06:58,430
،والخليلون الّذين يقتاتون على أموالهن
جميعهم قمامة بالتّساوي

101
00:06:59,230 --> 00:07:00,310
حاليّاً، على أيّ حال

102
00:07:00,560 --> 00:07:03,650
إن أردت منح النّاس أحلاماً لا يرونها
،في حياتهم اليوميّة

103
00:07:03,650 --> 00:07:06,320
فإنّ تقاضي أجر مُقابل ذلك
ليس بالأمر السيّئ

104
00:07:06,320 --> 00:07:08,820
حينئذ نحن الثّلاثة مُذنبون أيضاً، أليس كذلك؟

105
00:07:09,450 --> 00:07:11,570
،إذا كنّا سنتقاضى أجراً لبيع أحلام

106
00:07:11,570 --> 00:07:13,820
فكلّ ما علينا فعله هو الاستمرار
في التألُّق إذاً

107
00:07:14,370 --> 00:07:17,240
أن نكون ماسات دون خدوش أو تصدُّعات

108
00:07:17,240 --> 00:07:18,450
هذه هي قيمتنا

109
00:07:19,120 --> 00:07:20,210
الجريمة والعقاب

110
00:07:20,790 --> 00:07:23,210
وبعد؟ أتعتقدين بأنّ الشّباب هو الشّيء
الوحيد الّذي يملك قيمة؟

111
00:07:24,290 --> 00:07:25,590
...في الواقع

112
00:07:26,050 --> 00:07:28,460
إن كنتِ فعلاً شخصاً بلا قيمة
،تتجاوز ذلك

113
00:07:28,460 --> 00:07:31,380
فلا أعتقد بأنّ ميتشيكا كانت
لتدعكِ تقتربين

114
00:07:31,680 --> 00:07:33,220
ماذا؟ دعَتْكِ تقتربين؟

115
00:07:33,220 --> 00:07:35,550
،أقصد بأنّني سعيدة بقولك ذلك

116
00:07:35,550 --> 00:07:37,640
لكنّني مُجرّد تلميذة مهنيّة

117
00:07:37,640 --> 00:07:39,430
هل سبق وشاهدت برامجَ توكوساتو؟

118
00:07:40,230 --> 00:07:42,020
لم أتوقّع ذلك

119
00:07:42,350 --> 00:07:44,940
أتعرفين أولئك الأبطال الّذين
يتحوّلون ويرتدون حزاماً؟

120
00:07:44,940 --> 00:07:47,940
مُعظمهم يبدؤون كعوَام عاديّين

121
00:07:47,940 --> 00:07:50,570
الكثير منهم نكِرة عاطلين عن العمل

122
00:07:50,570 --> 00:07:52,320
،بالتّأكيد، هناك استثناءات

123
00:07:52,610 --> 00:07:56,580
لكن ذات يوم، وبشكل مُفاجئ، ينتهي المطاف
بهم أبطالاً بظروف بحتة

124
00:07:56,580 --> 00:07:58,540
،لعلّهم كانوا أُناساً مُتواضعين أساساً

125
00:07:58,540 --> 00:08:04,040
،لكن إذا بدؤوا كأشخاص نموذجيّين صالحين
ويُناصرون العدالة، أطفال اليوم الأشقياء لا يتفاعلون

126
00:08:04,040 --> 00:08:06,500
مُؤدّو البثّ مثل حزام رايدر

127
00:08:06,500 --> 00:08:10,970
،الفرق الوحيد هو ما الزرّ الّذي تضغطه
"الحِزام أم "الظّهور على الهواء

128
00:08:10,970 --> 00:08:14,720
في اللّحظة التّالية، تجدين نفسكِ
بطلة في الجانب الآخر من الكاميرا

129
00:08:14,800 --> 00:08:18,180
إن كنتِ تتحوّلين، فيمكنكِ أن تلعبي
دور أي شخصيّة تحبّينها

130
00:08:18,180 --> 00:08:20,390
وترتدين القناع الّذي تريدينه

131
00:08:21,100 --> 00:08:23,100
أيّ شخص يستطيع أن يكون نجم العرض

132
00:08:23,100 --> 00:08:26,310
لكنّهم خائفون جدّاً من الوقوف
تحت الأضواء والرّقص

133
00:08:29,730 --> 00:08:32,990
خلايا دماغهم، والإدراك المنطقيّ لديهم
يعترض طريقهم

134
00:08:33,490 --> 00:08:35,870
"يرتاحون لحقيقة أنّهم "غير مجانين

135
00:08:35,870 --> 00:08:38,200
مدرسة. عمل. عائلة

136
00:08:38,200 --> 00:08:41,330
.العلاقات على وسائل التّواصل الاجتماعيّ
علاقة مع حبيب

137
00:08:41,330 --> 00:08:46,460
حتّى لو كان كلّ ذلك هشّاً، لا يزال يؤدّي دور
شبكة أمان، يحمي عقولهم

138
00:08:46,460 --> 00:08:49,670
"لذا لن يعتبرهم المُجتمع "غرباء أطور

139
00:08:49,670 --> 00:08:53,510
لكن لدى هذه الأحفورة الأرجوانيّة
بعض الخلايا المُعطّلة في الدّماغ

140
00:08:53,760 --> 00:08:55,010
!أحفورة أرجوانيّة؟

141
00:08:55,380 --> 00:08:57,720
هذا ينطبق عليكِ أيضاً

142
00:08:58,100 --> 00:08:59,310
صحيح

143
00:09:00,010 --> 00:09:03,640
لهذا نعيش خارج نِطاق الأخلاقيّات

144
00:09:04,310 --> 00:09:07,020
من وجهة نظر المُجتمع، نحن غُرباء أطوار

145
00:09:07,020 --> 00:09:09,940
في عالم الأشخاص العاديّين، أنتِ جذّابة

146
00:09:09,940 --> 00:09:13,110
يمكنكِ إيجاد السّعادة هناك
بقدر ما تشائين

147
00:09:13,110 --> 00:09:15,280
،الخلايا في دماغكِ ما زالت تعمل

148
00:09:15,280 --> 00:09:17,490
لذا لا يزال بإمكانكِ العيش داخل
حدود المنطق والإدراك السّليم

149
00:09:17,490 --> 00:09:19,330
بخلاف أمير أحلام

150
00:09:19,330 --> 00:09:23,160
أو أميرة أنانيّة ترفض الجميع سوى نفسها

151
00:09:24,290 --> 00:09:27,960
إذا أردتِ يوماً فقدان عقلكِ وقرّرتِ بأنّكِ
تريدين التحوُّل، فتكلّمي فحسب

152
00:09:27,960 --> 00:09:29,790
سأضع لكِ الحزام

153
00:09:35,880 --> 00:09:37,680
حان الوقت تقريباً للظهور على الهواء

154
00:09:38,430 --> 00:09:40,640
حسناً، لنعُد إلى ذلك النّقاش قبل قليل

155
00:09:40,640 --> 00:09:42,060
ما زلتُ أعتقد بأنّها ظريفة

156
00:09:42,060 --> 00:09:43,850
أظنّها ثرثارة ومُزعجة

157
00:09:43,850 --> 00:09:45,100
...أقصد، أراها ظريفة، لكن

158
00:09:47,810 --> 00:09:49,860
سأقتلك. الموت لك

159
00:09:49,860 --> 00:09:52,020
سأقتلك. سأقتلك

160
00:09:54,530 --> 00:09:56,110
برَكة

161
00:09:58,490 --> 00:10:00,990
مُدهش. تمكّنت من إجراء حدث حيّ
مع الملاك بحدّ ذاتها

162
00:10:01,990 --> 00:10:04,410
كانت تعلم بأمرنا بالفعل

163
00:10:04,410 --> 00:10:06,620
كلّ ما تطلّبه ذلك هو استفزاز بسيط

164
00:10:06,620 --> 00:10:07,710
هل أنتِ متأكّدة من ذلك؟

165
00:10:07,710 --> 00:10:09,830
،إنّها ليست مُنافسة عمليّاً

166
00:10:09,830 --> 00:10:12,880
لكن سيقرّر النّاسُ بصورة طبيعيّة
أيّ طرف يتمتّع بالزّخم

167
00:10:13,380 --> 00:10:17,010
رغم ذلك، ثلاثة ضدّ واحد
لا تبدو عادلة تماماً

168
00:10:19,470 --> 00:10:22,140
ك-آنجل
غرفة الملابس

169
00:10:29,230 --> 00:10:31,690
ثلاثة ضدّ واحد، ونحن نخسر بالفعل

170
00:10:31,690 --> 00:10:33,980
تتصرّفين كـ يوجيرو هانما في بداية المُسلسل

171
00:10:34,900 --> 00:10:38,320
اصمت! كنتُ أنتشي بحقيقة أنّ

172
00:10:38,320 --> 00:10:40,280
كارامازوف على وشك أن تصبح
!الأقوى أخيراً

173
00:10:45,620 --> 00:10:48,040
أيّاً يكن. افتحيه فحسب

174
00:10:49,960 --> 00:10:50,960
!مؤلم

175
00:10:51,500 --> 00:10:55,170
تبّاً، كيف تجرؤ على فعل ذلك لقائدتك؟

176
00:10:58,470 --> 00:10:59,800
!مرحباً يا ظريفات

177
00:11:02,510 --> 00:11:03,890
!مرحباً يا ظريفات

178
00:11:04,390 --> 00:11:06,310
أو.م.ج كاوايي آنجل

179
00:11:06,560 --> 00:11:08,020
مرحباً

180
00:11:08,390 --> 00:11:12,060
أنا فتاة السمّ المُميت دينبا
!مصّاصة أرجوانيّة

181
00:11:08,810 --> 00:11:10,310
ك-آنجل
غرفة الملابس
كارامازوف

182
00:11:12,060 --> 00:11:14,730
شكراً جزيلاً على المجيء اليوم

183
00:11:15,110 --> 00:11:16,940
كما قلتُ، خسارة

184
00:11:17,030 --> 00:11:20,320
هذه في الواقع أوّل مرّة لي أؤدّي فيها
حدثاً حيّاً تعاونيّاً مع شخص

185
00:11:21,160 --> 00:11:24,410
كانت من مُعجبينك قبل أن إطلالتها الأولى

186
00:11:24,410 --> 00:11:27,120
ميتشيكا، أيّتها المُدمنة! لا تختلقي
!مثل هذه الأمور

187
00:11:27,120 --> 00:11:30,290
لطالما قلتِ بأنّ حلمكِ هو أن تلعبي
لعبة قتاليّة ضدّها، صحيح؟

188
00:11:30,290 --> 00:11:33,790
لا! تفقّدتُها لمرّة فقط وتعلّقتُ
!بها، هذا كلّ شيء

189
00:11:34,000 --> 00:11:35,500
...هكذا إذاً

190
00:11:35,920 --> 00:11:38,800
إذاً لم تعودي تُشجّعينني؟

191
00:11:41,130 --> 00:11:43,470
حسناً، أقصد بلا شكّ. أُعجبتُ بكِ
،قليلاً آنذاك

192
00:11:43,470 --> 00:11:45,970
!لكنّنا نتمتّع بزخم حقيقيّ الآن أيضاً

193
00:11:45,970 --> 00:11:49,810
من يدري؟ ربّما هناك عدد أكبر حتّى
من مُعجبي كارامازوف اليوم، صحيح؟

194
00:11:50,060 --> 00:11:54,270
الأمر لا يتعلّق بالفوز أو الخسارة
عندما يخصّ البثّ

195
00:12:01,150 --> 00:12:02,990
أنا فقط لا أرى نفسي خاسرة

196
00:12:07,080 --> 00:12:08,830
!إلى جميع الحاضرين هنا اليوم

197
00:12:09,410 --> 00:12:15,170
إنّه لشرف عظيم لنا أن نُشارككم
!هذه اللّحظات الخاصّة

198
00:12:17,800 --> 00:12:20,880
!آمل أن تستمتعوا جميعاً

199
00:12:20,880 --> 00:12:22,510
مُذهل

200
00:12:23,010 --> 00:12:26,850
والآن، لجعل هذه اللّحظة الخاصّة
،أكثر بريقاً حتّى

201
00:12:26,850 --> 00:12:30,180
،دعينا الملاك فائقة الظّرافة

202
00:12:31,350 --> 00:12:32,690
أو.م.ج كاوايي آنجل

203
00:12:44,950 --> 00:12:47,740
من باب اللّباقة، سأقول هذا أوّلاً

204
00:12:47,990 --> 00:12:51,330
شكراً لكِ على قبول دعوتنا

205
00:12:51,330 --> 00:12:53,750
لا، أنا من أشكركم على دعوتي

206
00:12:53,750 --> 00:12:58,250
كان يُراودني فضول لأتعرّف
"على مجموعة "المركز الثّاني

207
00:12:54,370 --> 00:12:55,370
المركز الثّاني

208
00:12:59,130 --> 00:12:59,670
الآن

209
00:12:59,340 --> 00:13:02,460
الآن، الملاك الرّزينة والرّائعة
،قد تكون في المركز الأوّل

210
00:13:02,460 --> 00:13:06,010
،لكن إذا كنّا نتكلّم عن الزّخم الخالص
فإنّ كارامازوف الأفضل

211
00:13:07,640 --> 00:13:10,060
.أنتِ ماهرة في تشويق الجمهور
مُدهش جدّاً

212
00:13:10,060 --> 00:13:12,770
رغم أنّكِ كنتِ ترتجفين كما الشّادِن

213
00:13:13,770 --> 00:13:16,150
هذه كذبة رخيصة

214
00:13:16,150 --> 00:13:19,360
،كذبة كانت أم لا، حالما ارتبكتِ
هذه سلبيّة

215
00:13:19,360 --> 00:13:22,780
بصراحة، لم تكوني مُجرّد شادِن. بل
أقرب إلى سُلحفاة مُنقلبة على ظهرها

216
00:13:22,780 --> 00:13:25,530
لماذا زميلايّ في الفريق يُهاجمانني؟

217
00:13:26,320 --> 00:13:31,540
شرف لي أن أتعاون مع مثل هؤلاء
الكوميديّين المُخضرمين الهادئين

218
00:13:28,530 --> 00:13:29,530
كوميديّون

219
00:13:33,250 --> 00:13:37,670
رأيت؟ في هذه الأيّام حتّى
الآيدول يعرفون كيف يُضحكون الآخرين

220
00:13:34,040 --> 00:13:34,660
في هذه الأيّام

221
00:13:34,660 --> 00:13:35,290
الآيدول

222
00:13:37,670 --> 00:13:42,050
بينما كنتُ غارقة في السموّ، ألم
تتخلّفي عن الزّمن؟

223
00:13:39,040 --> 00:13:41,420
مُتخلّفة عن الزّمن

224
00:13:43,710 --> 00:13:44,840
ربّما

225
00:13:44,840 --> 00:13:47,510
لستُ مُهتمّة بصراحة في مُؤدّيي البثّ الآخرين

226
00:13:47,510 --> 00:13:49,470
إذاً إنّها غير مُهتمّة بنا أيضاً

227
00:13:50,390 --> 00:13:53,850
أو ربّما إنّكِ خائفة جدّاً من رؤية
أحد يتفوّق عليكِ؟

228
00:13:53,850 --> 00:13:56,100
هذا طعم بمستوى لوحة إعلانات غامض

229
00:13:56,100 --> 00:13:58,440
!اصمتي! لا تُصنّفيني مع حمقى الإنترنت

230
00:13:58,440 --> 00:14:00,310
جميعنا مُنسحبون من المدرسة الثّانويّة

231
00:14:00,310 --> 00:14:01,770
لننسجم كأغبياء زملاء

232
00:14:01,770 --> 00:14:03,780
!ملاك الإنترنت المُنسحبة من الثّانويّة

233
00:14:03,780 --> 00:14:05,320
!لا تبدئي بإطلاق نيران صديقة

234
00:14:05,320 --> 00:14:07,610
!ولماذا تصبحين ودودة مع خصمنا؟

235
00:14:07,610 --> 00:14:10,620
نحن عباقرة كشفنا حدود تلك
المدرسة الضّئيلة باكراً

236
00:14:10,620 --> 00:14:12,540
لا تُصنّفينا معك

237
00:14:18,540 --> 00:14:23,460
!نحن الثّلاثة هنا زملاء، أليس كذلك؟

238
00:14:27,340 --> 00:14:28,130
كم هذا مُبهج

239
00:14:28,760 --> 00:14:31,680
ربّما أرغب في الشّعور بالخوف
قليلاً كنوع من التّغيير

240
00:14:31,680 --> 00:14:33,510
...لأنّني كوني في القمّة

241
00:14:33,850 --> 00:14:35,520
يجعل الأجواء مُوحشة

242
00:14:36,850 --> 00:14:39,190
هل تشعرين بالوحدة يا ك-آنجل؟

243
00:14:39,440 --> 00:14:40,270
أجل

244
00:14:40,270 --> 00:14:43,020
لهذا أقوم بالبثّ. لرؤية الجميع

245
00:14:43,020 --> 00:14:45,650
والجميع يأتون لرؤيتي لأنّهم وحيدون أيضاً

246
00:14:45,990 --> 00:14:48,820
لكن هذه ليست علاقة مُتكافئة

247
00:14:48,820 --> 00:14:51,780
في النّهاية، نحن مُجرّد مُنتجات
،تخضع للتّقييم

248
00:14:51,780 --> 00:14:55,160
والمُشاهدون لا يعدون كونهم جمهوراً
يقيس قيمة الكائنات البشريّة

249
00:14:55,370 --> 00:15:01,670
،الزّبون ليس إلَهاً، لكن بالنّسبة لهم
يجب أن نكون كذلك كمُؤدّيي بثّ

250
00:15:01,960 --> 00:15:03,500
،نحن من نفس طينة البشر مثلهم

251
00:15:03,500 --> 00:15:06,210
ومع ذلك وُجِدنا لنعيش كآلهة أو أُمراء

252
00:15:06,340 --> 00:15:08,510
لكن وحدهم الحمقى من يرمون
بأنفسهم طوعاً

253
00:15:08,510 --> 00:15:10,380
في ذلك الدّور للتنعُّم بسَيل من المديح

254
00:15:10,510 --> 00:15:12,140
لا بأس في ذلك

255
00:15:12,140 --> 00:15:15,390
لأنّني ملاك تهدي الأوتاكو الخاصّين بها

256
00:15:15,510 --> 00:15:17,180
أحياناً أخرج عن السّيطرة قليلاً بالتّأكيد

257
00:15:17,520 --> 00:15:21,400
لكن كلّما دلّلتهم الملاك، يزداد
الجمهور حماقة وتعلُّقاً

258
00:15:21,730 --> 00:15:25,270
إذا أرادوا الاستمرار في الإشاحة بنظرهم
عن الحقيقة والبقاء سُعداء للأبد، أليس هذا مُناسباً؟

259
00:15:25,730 --> 00:15:28,280
غالباً سيُعادون إلى الواقع في نهاية المطاف

260
00:15:28,690 --> 00:15:31,910
،ما داموا سُعداء بينما يُشاهدونني
فهذا يكفي

261
00:15:31,910 --> 00:15:41,670
برَكة

262
00:15:32,200 --> 00:15:34,410
،وبينما يركّز الأوتاكو كلّ انتباههم لنا

263
00:15:34,410 --> 00:15:36,370
نشعر وكأنّنا في حلم أيضاً

264
00:15:36,370 --> 00:15:38,790
،لأنّ النّاس يعاملوننا بتلك الطّريقة

265
00:15:38,790 --> 00:15:41,670
نستطيع أن نلعب دور الشّخصيّات
الّتي اخترناها

266
00:15:41,830 --> 00:15:44,540
نتمكّن من أن نكون شخصيّات في رواية

267
00:15:44,540 --> 00:15:46,170
رواية تنتمي لنا فقط

268
00:15:46,340 --> 00:15:49,720
الجميع يريدون أن يكونوا البطل، لكنّهم
يستيقظون من ذلك الحلم

269
00:15:49,720 --> 00:15:53,890
يفقدون الإرادة لمُتابعة القصّة
"وينجرفون لكونهم "عاديّين

270
00:15:53,890 --> 00:15:54,890
وسرعان ما يجدون أنفسهم

271
00:15:54,890 --> 00:15:57,640
أنّهم استقرّوا في كينونة "شخص كان
"الشّخصيّة الرّئيسيّة

272
00:15:57,640 --> 00:16:00,940
لكن ك.آنجل ملاك أبديّ. هذا
ما يجعل الأمر مُوحشاً

273
00:16:00,940 --> 00:16:02,810
،لا يستطيعون النّجاة في مُجتمع عاديّ

274
00:16:02,810 --> 00:16:05,150
لذا يرمون بأنفسهم في جنون البثّ

275
00:16:05,150 --> 00:16:08,110
إن فشلوا، فيتظاهرون بأنّهم
مجانين منذ البداية

276
00:16:08,110 --> 00:16:09,070
كلام جريء

277
00:16:09,070 --> 00:16:12,070
هذا هو دوركِ، يا مصّاصة، بصفتك القائدة

278
00:16:12,070 --> 00:16:14,990
قد يحدث معكِ هذا يوماً ما أيضاً

279
00:16:14,990 --> 00:16:18,120
حسناً، حتّى ملاكاً مثلكِ قد تخون
الأوتاكو الخاص بها

280
00:16:18,120 --> 00:16:21,460
وتسقط سقوطاً مدويّاً في الأرض

281
00:16:27,590 --> 00:16:31,010
صحيح. ربّما سأسقط من السموّ يوماً ما

282
00:16:31,300 --> 00:16:35,390
إن حدث ذلك يا مصّاصة، فاحرصي على
أن تُقدّري ذكرى كونك مُعجبة بي

283
00:16:35,390 --> 00:16:38,850
مُجرّد معرفة أنّ شخصاً يتذكّرني
كافية لإنقاذي

284
00:16:38,850 --> 00:16:42,390
"دعيني أخبركِ بأنّ "كنتُ مُعجبة بكِ
!كانت كذبتهم

285
00:16:42,390 --> 00:16:44,900
"لستُ "كنتُ". إنّما "ما زلتُ

286
00:16:46,520 --> 00:16:48,730
،مهما كنتِ ملاكاً

287
00:16:48,730 --> 00:16:51,190
،ومهما بعثتُ من سموم دينبا

288
00:16:51,190 --> 00:16:55,110
يبقى من المُحزن ألّا نستطيع مُواجهة
كلّ مُعجَب على حِدة فعلاً

289
00:16:55,110 --> 00:16:56,370
أحقّاً ذلك؟

290
00:16:56,370 --> 00:16:58,490
ربّما لا نستطيع بلوغ الجميع

291
00:16:58,490 --> 00:17:02,790
لكن عندما يحتاجني شخصٌ فعلاً، فلا يسعني
سوى الشّعور بأنّه مُميّز

292
00:17:02,790 --> 00:17:06,420
حقّاً"؟ يتظاهر بأنّه حقيقيّ، ثمّ"
يُغيّر مُفضّلاته في غضون ثلاثة أشهر

293
00:17:06,920 --> 00:17:11,260
على سبيل المثال، إذا دعمني شخصٌ
،بصدق مثلكِ يا مصّاصة

294
00:17:11,260 --> 00:17:13,050
فهذا يسكن قلبي حقّاً

295
00:17:13,050 --> 00:17:15,180
هذه ليست مُجرّد كلمات معسولة. أنا جادّة

296
00:17:15,180 --> 00:17:18,640
"صدق"؟ أخبرتُكِ جملة "كنتُ مُعجبة بكِ
!كانت مزحة

297
00:17:18,640 --> 00:17:21,180
،عندما أدّيتُ أوّل بثّ للعبة قتال لي

298
00:17:21,180 --> 00:17:23,770
كانت هناك فتاة قد أرسلتْ سوبّر
تشات، 500 ين فحسب

299
00:17:23,770 --> 00:17:27,440
كتبتْ، "أحبّ هذه اللّعبة أيضاً! أريد
"!أن ألعبها معكِ

300
00:17:27,610 --> 00:17:33,110
لا أحد يتلقّى رسالةً بهذا النّقاء من فتاة
في بثّ لعبة قتاليّة

301
00:17:33,110 --> 00:17:36,820
من الواضح أنّها أرادت اللّعب معي

302
00:17:36,820 --> 00:17:37,950
...ك-آنجل

303
00:17:38,410 --> 00:17:39,950
أما زلتِ تتذكّرين ذلك؟

304
00:17:53,420 --> 00:17:57,380
أنتِ رائعة
عبقريّة
برَكة
برَكة
إنّها في وضع الصّحوة
!ها هي ذي
جميل

305
00:17:57,680 --> 00:17:58,720
!أمّي

306
00:17:58,720 --> 00:17:59,390
ما الأمر؟

307
00:17:59,390 --> 00:18:02,060
دعيني أنفق الـ 500 ين في بطاقة
!الائتمان خاصّتكِ! أرجوكِ

308
00:18:02,060 --> 00:18:04,730
ماذا؟ -
!أرجوكِ! إنّها 500 ين فقط -

309
00:18:05,180 --> 00:18:06,810
!مرحى! شكراً

310
00:18:08,730 --> 00:18:09,480
أنتِ رائعة
فتاة السُّمّ المُميت دينبا
!أعشق هذه اللّعبة أيضاً
!أريد أن ألعبها معك

311
00:18:15,400 --> 00:18:19,620
بدا ذلك مُبهِجاً، لكن مُوحشاً حقّاً
في نفس الوقت. لذا عرفتُ

312
00:18:19,780 --> 00:18:22,200
كانت تشعر بالوحدة أيضاً

313
00:18:22,620 --> 00:18:23,540
أتذكّر

314
00:18:27,750 --> 00:18:29,420
أجل، خسرنا هذه

315
00:18:31,290 --> 00:18:32,710
،إذا صوّرتُها بهذه الطّريقة

316
00:18:32,710 --> 00:18:35,920
فإنّ نسبة تأييدي للأوتاكو ترتفع
إلى ما لا نهاية، صحيح؟

317
00:18:36,170 --> 00:18:37,930
هذا عمل ملاك

318
00:18:41,800 --> 00:18:45,720
رأيتم؟! هكذا بالضّبط ينتهي المطاف
!بإفساد الأوتاكو لمُؤدّيي البثّ

319
00:18:45,720 --> 00:18:48,270
!مُحال أن أُرسل سوبّر تشات أو شيئاً كهذا

320
00:18:48,270 --> 00:18:50,350
هذه المرّة جرفتْني المشاعر وليدة اللّحظة

321
00:18:50,350 --> 00:18:52,860
!كنتُ أقدّم احترامي لسينباي فحسب

322
00:18:52,860 --> 00:18:54,690
لكن ذات يوم سوف تنقلب الشّعبيّة

323
00:18:54,690 --> 00:18:57,740
فقط ابقي هناك وارتجفي
!حتّى يحين ذلك اليوم

324
00:18:58,360 --> 00:19:00,870
أصابعكِ ترتجف يا قائدة

325
00:19:01,910 --> 00:19:03,830
!أنا أيضاً

326
00:19:10,790 --> 00:19:12,000
!أيّتها السّاقطة

327
00:19:14,130 --> 00:19:18,010
!دمّرتِني، وكلّ هذه غلطتكِ

328
00:19:18,470 --> 00:19:21,010
امرأة سيّئة
من النّوع المُؤثّر العاطل عن العمل

329
00:19:21,470 --> 00:19:24,310
يبدو أنّه ظهر شيء مثاليّ كمُحتوى
!بثّ للتو

330
00:19:24,310 --> 00:19:25,890
مُعجبة مُزعجة

331
00:19:25,890 --> 00:19:29,020
هكذا يسير الأمر. خلف كلّ تأييد
كراهية بنفس القدر

332
00:19:31,480 --> 00:19:33,940
...تلك الفتاة

333
00:19:34,730 --> 00:19:37,820
يبدو أنّها مُعجبة بـ ك-آنجل، لا بنا

334
00:19:43,740 --> 00:19:48,040
!أجل! بسببكِ، سقطتُ سقوطاً مدوياً

335
00:19:48,040 --> 00:19:51,290
إحدى أولئك الأشخاص الّذين يلومون
الآخرين على سقوطهم

336
00:19:51,290 --> 00:19:53,830
إنّها من النّوع ضعيف القلب الّذي نتوقّعه

337
00:19:53,830 --> 00:19:56,750
خسارة. يبدو أنّ الملاك لا تتذكّرها حتّى

338
00:19:56,750 --> 00:19:59,380
اصمتي. لا أكترث لما تقولينه

339
00:19:59,380 --> 00:20:04,640
سأقتلها هنا والآن! لن أتمكّن
!من النّوم ما لم أفعل

340
00:20:04,640 --> 00:20:05,760
كنتِ تُنادينني؟

341
00:20:05,760 --> 00:20:10,020
حسناً إذاً، مَن منهما صاحبة العقل التّالف؟

342
00:20:10,350 --> 00:20:13,190
!أستطيع فعلها

343
00:20:17,110 --> 00:20:19,030
!سأفعلها! سأقتلكِ

344
00:20:19,030 --> 00:20:22,320
...بسببكِ، أنا... أنا

345
00:20:22,320 --> 00:20:23,860
بي تنتظر

346
00:20:24,280 --> 00:20:25,870
يجب أن أعود إلى المنزل

347
00:20:39,300 --> 00:20:42,720
الأشخاص فاترو الهمّة لا يستطيعون
حتّى أن يفقدوا صوابهم بصورة صحيحة

348
00:22:25,150 --> 00:22:27,610
بي، أتتلقّى كلّ هذا؟

349
00:22:31,030 --> 00:22:34,830
أتعلمين؟ أحبّك حقّاً يا بي

350
00:22:34,830 --> 00:22:37,670
مهما رغبتُ في الموت، أو كنتُ
،قريبة من الانفجار بُكاء

351
00:22:37,670 --> 00:22:40,210
أستطيع الاستمرار في الحياة الآن
لأنّني لستُ وحيدة

352
00:22:40,210 --> 00:22:44,460
أنا مُمتنّة للشّخص الوحيد في هذا
العالم الّذي هو حبيبي

353
00:22:45,380 --> 00:22:48,510
أظنّني سأفقد صوابي قريباً

354
00:22:48,840 --> 00:22:50,260
يمكنني الشّعور بذلك

355
00:22:50,470 --> 00:22:52,600
أنا أترنّح بين كوني ملاكاً
،وكوني بشريّة

356
00:22:52,600 --> 00:22:54,930
والمسافة بينهما تزداد تقلُّصاً

357
00:22:55,270 --> 00:22:57,140
،لأنّ كليهما واقعيّان

358
00:22:57,140 --> 00:23:00,440
الحدود بينهما تغدو ضبابيّة وقد
لا يتمكّن عقلي من استيعاب ذلك

359
00:23:00,440 --> 00:23:02,820
لا أستطيع حتّى تخيُّل ما سيحدث

360
00:23:03,110 --> 00:23:05,690
ربّما لن أتمكّن من العودة
من الجانب الآخر

361
00:23:08,740 --> 00:23:10,570
لكن لا بأس في ذلك

362
00:23:10,780 --> 00:23:12,990
إن كنت موجوداً عندما تحين
،تلك اللّحظة يا بي

363
00:23:12,990 --> 00:23:15,080
فلن أخشى شيئاً

364
00:23:17,080 --> 00:23:20,670
،حتّى لو متُّ أو انهرتُ أو أصبحتُ إلَهاً

365
00:23:20,670 --> 00:23:22,170
سنبقى معاً دوماً

366
00:23:25,050 --> 00:23:27,050
الحلقة القادمة

367
00:23:26,510 --> 00:23:31,140
تبتسم كملاك، وهلوسة شديدة، فتاة الإنترنت

368
00:23:31,140 --> 00:23:35,060
تهمس كشيطان، مُحزن بالنّسبة لك فقط، فتاة مُلِحّة

369
00:23:35,680 --> 00:23:38,060
"الحلقة القادمة، "جرعة زائدة من الإنترنت

370
00:23:38,060 --> 00:23:40,060
الحلقة 3