1
00:00:44,350 --> 00:00:45,640
هل أنتِ بخير؟

2
00:00:46,850 --> 00:00:48,230
اصمتي

3
00:00:48,230 --> 00:00:51,150
لا علاقة لهذا بكِ، لذا لا تتكبّدي
عناء قلقكِ الثّمين

4
00:00:51,530 --> 00:00:52,650
سوف أقلق

5
00:00:53,070 --> 00:00:54,280
لأنّنا صديقتان

6
00:02:30,960 --> 00:02:33,340
!لا أعتبركِ صديقتي

7
00:02:34,000 --> 00:02:34,840
نحن صديقتان

8
00:02:35,670 --> 00:02:38,590
ليس عليكِ الاستمرار في القيام
بكلّ شيء بمفردكِ

9
00:02:39,840 --> 00:02:42,890
أتعتقدين بأنّ بعض العبارات المُبتذلة
يمكن أن تُصلح هذا حقّاً؟

10
00:02:42,890 --> 00:02:44,560
يا لكِ من عاديّة بشكل مُقرف

11
00:02:45,890 --> 00:02:47,930
قولي ما تشائين. تبقين صديقتي

12
00:02:48,100 --> 00:02:51,940
ابتعدي عنّي. لسنا في دراما رخيصة
!يمكن حلّ المُشكلة فيها بعِناق

13
00:02:52,100 --> 00:02:55,020
لستِ غبيّة بما يكفي لتُكرّسي إيمانكِ

14
00:02:55,020 --> 00:02:56,690
في "صداقة" أو أيّاً كان؟

15
00:02:57,070 --> 00:02:59,950
لا. لستُ بتلك الحماقة

16
00:03:05,200 --> 00:03:07,160
شكّلتِ ثقوباً عديدة في هذه

17
00:03:07,790 --> 00:03:09,910
أم أنّكِ ترعين يرقات في جيوبكِ؟

18
00:03:10,870 --> 00:03:13,790
الشّخص الّذي يذوب من مُجرّد عِناق

19
00:03:13,790 --> 00:03:15,920
مُحال أن يبلغ قمّة سلسلة أغذية
مُؤدّيّي البثّ، صحيح؟

20
00:03:16,340 --> 00:03:17,420
...أيّتها

21
00:03:19,300 --> 00:03:22,430
بشرتكِ جميلة حقّاً. لم أكن أعلم

22
00:03:23,180 --> 00:03:25,680
،دائماً ما ترتدين لِباس لوليتا بأكمام طويلة
حتّى في مُنتصف الصّيف

23
00:03:27,890 --> 00:03:30,480
ميتشيكا-ساما فقدت أعصابها حقّاً

24
00:03:30,810 --> 00:03:32,900
!أفلتيني

25
00:03:35,190 --> 00:03:38,650
هذا صحيح. كان الأمر هكذا منذ
المدرسة الابتدائيّة

26
00:03:38,900 --> 00:03:40,990
كلّ شيء في الدُّنيا كان قبيحاً

27
00:03:41,530 --> 00:03:43,160
...مُقرفاً جدّاً، وتافهاً للغاية

28
00:03:41,900 --> 00:03:43,160
صداقة

29
00:03:43,160 --> 00:03:44,410
مهرجان مدرسة إعداديّة
حُبّ

30
00:03:43,450 --> 00:03:46,660
!كلّما شعرتُ بالمرض، أتناول حبوباً

31
00:03:44,410 --> 00:03:45,660
عدالة

32
00:03:45,660 --> 00:03:46,910
للأبد

33
00:03:46,660 --> 00:03:49,410
مُجرّد البقاء حيّة في هذا العالم
الزّائل الفاسد كان مُعاناة

34
00:03:46,910 --> 00:03:48,160
أخلاق

35
00:03:48,160 --> 00:03:49,410
سلام

36
00:03:50,120 --> 00:03:53,580
وكلّما أردتُ الموت، أجرح
!مِعصمَي بدلاً من ذلك

37
00:04:14,650 --> 00:04:15,730
يروقني ذلك

38
00:04:16,150 --> 00:04:19,980
.تبدين أكثر روعة الآن ممّا كنتِ سابقاً
بجدّية. هذا يُلائمكِ

39
00:04:30,540 --> 00:04:32,790
!لا أفهم أيّاً منكم

40
00:04:33,290 --> 00:04:35,960
كيف تستطيعون قضاء الحياة
!بهذه البساطة فحسب؟

41
00:04:35,960 --> 00:04:41,300
،رجال، نساء، مال، أغانٍ، خمر
!كلّ شيء مُقرف

42
00:04:41,300 --> 00:04:44,930
أشخاص قذرين يقولون كلاماً قذراً

43
00:04:44,930 --> 00:04:47,090
أولئك الأغبياء في الصّفّ، يتظاهرون بالصّداقة

44
00:04:47,090 --> 00:04:49,310
مع  تلك الابتسامات الغبيّة
!المُرتسمة في وجوههم

45
00:04:49,310 --> 00:04:51,100
والقمامة على الإنترنت الّذين يتصرّفون بفوقيّة

46
00:04:51,100 --> 00:04:53,850
بينما يكبتون الإشاعات فقط
!ليشعروا بالرّاحة حيال أنفسهم

47
00:04:54,100 --> 00:04:56,940
!وما زال علينا الاستمرار في العيش على أيّ حال

48
00:04:57,230 --> 00:05:00,360
بخلافكِ، مُعظم النّاس لا يستطيعون
!إظهار الجانب الرّائع

49
00:05:00,570 --> 00:05:02,530
!يقبلون ذلك، ويستمرّون في المُحاولة

50
00:05:03,320 --> 00:05:05,360
،ينتشون بعقدة التّضحية الخُرافية

51
00:05:05,360 --> 00:05:07,530
مُدّعيّين وكأنّكِ الشّخص البائس
!الوحيد في العالم

52
00:05:08,950 --> 00:05:10,580
أتستمعين لساوند هورايزن؟

53
00:05:12,330 --> 00:05:15,920
،لستُ مُهتمّة بالموسيقى الغريبة
لذا معلوماتي قليلة

54
00:05:18,250 --> 00:05:23,010
و... لم أنسجم في المدرسة أيضاً

55
00:05:23,960 --> 00:05:26,590
رغم أنّني أعتقد بأنّه من الوقاحة
التصرُّف بأنّنا مُتشابهون

56
00:05:29,220 --> 00:05:31,720
"لا، المسوخ هم النّاس "العاديّون

57
00:05:31,720 --> 00:05:37,140
!الّذين ينظرون إلى هذه الحقيقة القبيحة وقبولها

58
00:05:37,900 --> 00:05:39,980
لا يسعني سوى العيش في حلم

59
00:05:39,980 --> 00:05:43,320
إن لم أبقَ داخل الحلم، فسأبدأ في التّحطيم

60
00:05:43,320 --> 00:05:47,320
!يجب أن أكون البطلة الّتي تُقدّسونها جميعاً

61
00:05:47,320 --> 00:05:50,370
!يجب عليّ الاستمرار في منحهم ما يريدون

62
00:05:50,370 --> 00:05:54,040
لذا في كلّ مرّة، أتناول مزيداً من الحبوب
!أو أجرح مِعصمَي

63
00:05:56,040 --> 00:05:59,420
مُعاناة الزحف والخروج من ذلك
...الواقع بأي وسيلة مُمكنة

64
00:05:59,710 --> 00:06:02,040
...كيف لأمثالكم بالضّبط

65
00:06:02,750 --> 00:06:05,880
!كيف لأمثالكم أن يفهموا هذا يوماً؟

66
00:06:06,170 --> 00:06:08,840
!لستُ أفهم، ولذا هذا مُؤلم

67
00:06:08,930 --> 00:06:11,760
!مهما فعلتُ، لستُ سوى شخص عاديّ آخر

68
00:06:11,760 --> 00:06:14,220
!لأنّ كلّ ما أفعله هو التّقديس من بعيد

69
00:06:17,310 --> 00:06:20,560
أظنّني أردتُ فقط شخصاً أتكلّم معه

70
00:06:21,230 --> 00:06:24,280
قرّرتُ من تلقاء نفسي بأنّنا سوف ننسجم

71
00:06:25,280 --> 00:06:26,360
آسفة

72
00:06:30,780 --> 00:06:32,240
ما هذا بالضّبط؟

73
00:06:33,280 --> 00:06:37,370
لأنّ أُناساً مُذهلين مثلكِ يجعلون
!حتّى المُعاناة تبدو رائعة

74
00:06:38,120 --> 00:06:41,330
ويستفزّني ذلك كثيراً، وفي كلّ
!يوم، يُحزنني للغاية

75
00:06:46,050 --> 00:06:49,550
سأسمح لكِ بالتكلّم معي لمرّة
واحدة في كلّ فترة

76
00:06:50,090 --> 00:06:51,180
فقط بين الحين والآخر

77
00:06:52,720 --> 00:06:54,260
رموشكِ طويلة جدّاً

78
00:06:56,020 --> 00:07:00,770
أمثالكِ يفعلون حقّاً الأشياء الّتي
!يفقد بقيّتُنا الأمل منها

79
00:07:01,020 --> 00:07:03,900
!يمكنكِ تحطيم النّوافذ والخروج من المدرسة

80
00:07:04,440 --> 00:07:08,570
!مهما حدث، أمثالكِ رائعون وجميلون ورهيبون

81
00:07:09,030 --> 00:07:11,570
!لذا لا، لا أستطيع فهم مُعاناتكِ

82
00:07:12,410 --> 00:07:14,830
ليس عندما لا تُحاولين حتّى
!فهم نكِرات مُملّة أمثالنا

83
00:07:15,580 --> 00:07:17,540
!حتّى وجهكِ الباكي جميل

84
00:07:17,540 --> 00:07:19,460
!هذا ليس عدلاً! أنتم غير مُنصفين إطلاقاً

85
00:07:19,460 --> 00:07:21,870
!إذاً ماذا يُفترض بي أن أفعل؟

86
00:07:21,870 --> 00:07:24,420
!أريد أن أكون أكثر جمالاً من أيّ أحد، للأبد

87
00:07:24,420 --> 00:07:29,170
وكلّما ازداد ذلك الضّغط، أحتاج
!مزيداً من الحبوب فحسب للبقاء جميلة

88
00:07:29,170 --> 00:07:33,840
هل يُفترَض بي أن أستمرّ في إغراق
خوفي بمزيد ومزيد من حبوب التّنويم

89
00:07:33,840 --> 00:07:39,020
وتوفير أدوية نفسيّة في كلّ يوم، حيث
!نعيش تحت وطأة الخوف من السّقوط في النّهاية؟

90
00:08:00,120 --> 00:08:02,250
!إذاً سنحلّ تلك المسألة

91
00:08:05,210 --> 00:08:08,630
!لماذا؟ لأنّني سمعتُ المُشكلة للتو

92
00:08:08,630 --> 00:08:11,550
،سمعنا أخيراً ما تُفكّرين فيه فعليّاً
بحيث يمكننا الآن فعل شيء حيال الأمر

93
00:08:11,550 --> 00:08:13,430
أوّلاً، سنبدأ بتقليص عدد الأدوية

94
00:08:13,430 --> 00:08:15,590
سأذهب معكِ إلى الطّبيب النفسيّ

95
00:08:15,590 --> 00:08:18,140
والباقي، نُعالجه معاً. بهذه البساطة

96
00:08:19,180 --> 00:08:20,270
!من هناك؟

97
00:08:21,140 --> 00:08:24,140
بمُساعدتنا، ألا تعتقدين بأنّكِ
قد تنجحين فعلاً؟

98
00:08:26,610 --> 00:08:30,190
ساهمتُ كثيراً في العلاج من الإدمان

99
00:08:30,190 --> 00:08:31,530
وأنتِ قويّة يا ميتشيكا

100
00:08:31,940 --> 00:08:33,740
أيّتها الجبانتان

101
00:08:33,740 --> 00:08:36,450
كنتُما تنتظران اللّحظة المثاليّة للدّخول

102
00:08:36,450 --> 00:08:37,910
تماماً

103
00:08:37,910 --> 00:08:40,910
وإن أردتِ الصّدق، كنتُ أعلم بشأن
الأدوية والجروح أيضاً

104
00:08:41,040 --> 00:08:42,910
نعرف بعضنا الآخر منذ فترة طويلة

105
00:08:43,410 --> 00:08:46,250
كنّا نفكّر في التدخُّل والعناية بكِ بطريقة ما

106
00:08:46,960 --> 00:08:50,500
.كاتشي أدّت الدّور الصّعب بالنّسبة لنا
ارتأينا بأنّ الوقت هو الآن

107
00:08:50,800 --> 00:08:52,880
هذا يفلح بطريقة مثاليّة

108
00:08:52,880 --> 00:08:55,380
ما زال لدينا مُتّسع من الوقت قبل المُواجهة

109
00:08:55,380 --> 00:08:57,760
لنغتنم هذه الفُرصة لمُعالجة الأمور بالنّقاش

110
00:08:57,890 --> 00:09:01,560
،في السّابق، كنتِ تتكتّمين على كلّ شيء وتهربين

111
00:09:01,560 --> 00:09:04,520
،لكن الآن بعد أن انفجرتِ بهذه الشدّة
يمكننا فعل شيء حيال الأمر أخيراً

112
00:09:05,100 --> 00:09:07,060
نحن الثّلاثة ينبغي أن نُعين بعضنا الآخر

113
00:09:07,060 --> 00:09:09,770
عندما تتألّمين، استندي علينا أكثر

114
00:09:10,230 --> 00:09:11,820
،أنا حمقاء أيضاً

115
00:09:11,820 --> 00:09:14,490
إذاً هناك أشياء غير محدودة سأحتاج
لمُساعدتكم فيها جميعها

116
00:09:15,200 --> 00:09:18,870
عند الشّدائد، لدينا أصدقاء سيأتون مُسرعين

117
00:09:19,450 --> 00:09:22,080
والأهمّ من أيّ شيء، لديكِ عائلة الآن

118
00:09:22,080 --> 00:09:26,870
هل نسيتِ سبب تسمية أنفسنا بكارامازوف؟

119
00:09:30,040 --> 00:09:32,760
،حسناً. بما أنّكِ تتجاوزين كلّ هذه الحدود
فأعتقد بأنّني لا أملك خياراً

120
00:09:32,760 --> 00:09:35,880
لا يمكننا هزيمة الملاك ما لم نكُن
نحن الثّلاثة معاً على أيّ حال

121
00:09:36,300 --> 00:09:40,390
،لعلّي فقدتُ رباطة جأشي قليلاً
لكن لا أنوي الخسارة

122
00:09:40,760 --> 00:09:42,890
أعتذر لأنّني أثرتُ قلقكما

123
00:09:43,140 --> 00:09:45,350
حسناً إذاً، هل نتوجّه إلى المنزل؟

124
00:09:45,350 --> 00:09:48,480
سوف نُعيد ضبط أنفسنا، وسأخمّر
لأنفسنا شاياً ساخناً لطيفاً

125
00:09:48,480 --> 00:09:50,440
ما زال بإمكانكِ جعل نفسكِ تبدين
رائعة بعد كلّ هذا؟

126
00:09:50,440 --> 00:09:52,400
أجل. هذه موهبة

127
00:09:55,360 --> 00:09:56,530
شكراً

128
00:09:59,570 --> 00:10:00,950
لا تغترّي

129
00:10:00,950 --> 00:10:04,580
أنتِ تلومين نفسكِ لأنّكِ نسّقتِ الأمور
بحيث تؤول إلى هذا الشّكل

130
00:10:06,000 --> 00:10:08,870
الصّدق هو فضيلة

131
00:10:08,870 --> 00:10:11,960
وأنتِ مسؤولة تماماً، فلا يسعكِ سوى
الكفّ عن الشّعور بهذه الطّريقة

132
00:10:11,960 --> 00:10:13,340
لكن لا بأس

133
00:10:13,340 --> 00:10:15,840
لطفكِ يُلامسني يا نيتشيكا

134
00:10:15,840 --> 00:10:17,340
لا تقلقي

135
00:10:17,340 --> 00:10:18,720
لا بأس يا قائدة

136
00:10:19,220 --> 00:10:22,930
!لكن لن أنسى بأنّكِ جعلتِني أبثّ لوحدي

137
00:10:22,930 --> 00:10:26,480
وثمّة أمر آخر! من الأفضل لكما
!أن تُصلحا النّوافذ

138
00:10:28,850 --> 00:10:33,730
،بصراحة، في اليوم الّذي أستقيل فيه من المدرسة
سآخذ مجموعة من الحبوب أيضاً

139
00:10:34,020 --> 00:10:37,860
أمسى كلّ شيء سديميّاً، وأنا تهوّرت

140
00:10:38,200 --> 00:10:40,570
،وبينما كنتُ أحاول إخماد الخوف

141
00:10:40,660 --> 00:10:43,030
دمّرتُ كلَّ شيء

142
00:10:49,290 --> 00:10:51,960
كلّ يوم اثنين جعلَني أشعر بدُوار

143
00:10:52,500 --> 00:10:54,960
كنتُ خائفة بشأن قدرتي على
الانخراط في العالم

144
00:10:55,340 --> 00:10:59,220
لكن جزءاً مُتغطرساً منّي ظنّ بأنّ ذلك
جعلَني رائعة، فعلقتُ بين الاثنين

145
00:10:59,590 --> 00:11:03,050
،لذا أبقيتُ سمّاعات أذني طوال الوقت
كما لو أنّني كنتُ أنعزل عن العالم الخارجيّ

146
00:11:08,180 --> 00:11:09,140
!ميتشيكا؟

147
00:11:10,270 --> 00:11:13,440
لكن ثمّة فتاة سخيفة تمكّنتْ من تجاوزهم

148
00:11:15,400 --> 00:11:16,230
هكذا إذاً

149
00:11:17,070 --> 00:11:18,490
شكراً على إخباري

150
00:11:19,070 --> 00:11:20,490
سيبقى هذا بيننا. سرّ مُطلَق

151
00:11:24,200 --> 00:11:26,490
،الوحيدون الّذين يعرفون هُم أنت يا كاتشي

152
00:11:28,250 --> 00:11:31,830
وذلك القمر الضّخم الدّائريّ هناك

153
00:11:33,750 --> 00:11:34,460
أعلم كم بذلت من جهود حثيثة

154
00:11:54,650 --> 00:11:57,190
!يا مسوخ الأوتاكو

155
00:11:58,110 --> 00:12:00,900
أيّها الأوغاد المُشوّشون بالدّوبامين، يجب
عليكم الاستمتاع بالحياة بكفاءة

156
00:12:00,900 --> 00:12:05,160
بالتنقُّل إلى ما لا نهاية بين فيديوهات قصيرة
!لفتيات ظريفات يرقصنَ على موسيقى إيقاعيّة

157
00:12:32,060 --> 00:12:33,480
أعلم كم بذلت من جهود حثيثة

158
00:12:37,360 --> 00:12:40,230
كتاب التخرُّج السّنويّ

159
00:13:04,630 --> 00:13:05,840
أجل

160
00:13:06,260 --> 00:13:10,600
بدا ذلك مُبهِجاً، لكنّه مُوحش حقّاً
في نفس الوقت. لذا عرفتُ

161
00:13:10,600 --> 00:13:11,720
—كانت وحيدة

162
00:13:41,840 --> 00:13:43,130
أتيتُ لأقلك

163
00:13:43,710 --> 00:13:47,130
لنُغادر هذا العالم خلفنا ونذهب
ونرَ المجرّة معاً

164
00:13:53,430 --> 00:13:55,640
سنبحث عن السّعادة الحقيقيّة

165
00:14:05,900 --> 00:14:09,870
آمي، ما هي "السّعادة الحقيقيّة"؟

166
00:14:11,120 --> 00:14:14,660
،تعني الصّعود إلى السّماء هكذا فحسب
والاقتراب أكثر من الإله

167
00:14:14,910 --> 00:14:16,660
هذا جميلٌ جدّاً

168
00:14:16,960 --> 00:14:18,420
نبيل للغاية

169
00:14:20,420 --> 00:14:22,670
رُبّما يكون كذلك

170
00:14:23,050 --> 00:14:26,630
هيّا. لطالما تقت لذلك، صحيح؟

171
00:14:26,630 --> 00:14:30,930
،ذلك النّجم البرّاق في سماء اللّيل
والبعيد جدّاً عن منال أحد

172
00:14:33,720 --> 00:14:34,810
أجل

173
00:14:35,470 --> 00:14:38,730
...لا أعرف السّبب، لكن

174
00:14:38,850 --> 00:14:43,940
أشعر وكأنّ سعادتكِ وسعادتي
لم تعودا مُتشابهتين

175
00:14:44,480 --> 00:14:46,440
لذا لا أستطيع الذهاب معك

176
00:14:52,320 --> 00:14:55,410
هكذا إذاً. هذا ما في الأمر

177
00:14:58,790 --> 00:15:03,290
يمكنك إيجاد السّعادة الآن، حتّى
من دون صعود القطار المجرّيّ

178
00:15:11,260 --> 00:15:12,470
خائنة

179
00:15:16,520 --> 00:15:17,730
أنا آسفة

180
00:15:22,190 --> 00:15:24,690
آمي، أنا آسفة جدّاً

181
00:15:25,020 --> 00:15:26,110
أنا آسفة

182
00:15:28,990 --> 00:15:36,080
غيوم المرأة المُسلسَلة

183
00:15:36,830 --> 00:15:43,580
!هي على شكل فم سمكة

184
00:15:44,750 --> 00:15:50,800
قدم الدُّبّ الكبير تُشير نحو الشّمال

185
00:15:47,670 --> 00:15:48,760
!هذا مُستحيل

186
00:15:51,380 --> 00:15:57,010
لتصل إلى خمسة أماكن

187
00:15:57,970 --> 00:16:03,100
فوق جبين الدُّبّ الصّغير

188
00:16:03,850 --> 00:16:08,820
يقع المُؤشِّر الّذي تلتفت نحوه السّماوات

189
00:16:09,570 --> 00:16:12,280
بي، اقترب الكريسماس

190
00:16:15,910 --> 00:16:20,200
لا جدوى من إخفاء ذلك، لكن جهّزتُ
لك هديّة يا بي

191
00:16:20,200 --> 00:16:21,790
انتظري حتّى تريها فحسب

192
00:16:24,120 --> 00:16:26,790
لديّ عمل بسيط أقوم به أوّلاً

193
00:16:29,880 --> 00:16:32,550
أجل. سأبذل قصارى جهدي

194
00:16:32,760 --> 00:16:35,340
بي، سنكون معاً للأبد

195
00:16:35,720 --> 00:16:39,520
السّبب الوحيد الّذي يجعلني أستمرّ في المُحاولة
بشكل حثيث هو لأنّ لديّ أنت

196
00:16:40,520 --> 00:16:44,480
أُحبّ. سأُحبّك دائماً وأبداً

197
00:16:44,900 --> 00:16:46,900
أُحبّك حُبّاً جمّاً

198
00:16:51,820 --> 00:16:54,910
السّعادة الحقيقيّة موجودة هنا

199
00:16:58,370 --> 00:17:00,240
المعركة الأخيرة
ك-آنجل

200
00:16:59,290 --> 00:17:04,210
ملاك الإنترنت الوحيدة ضدّ الشّقيقات
صائدات الملاك الثّلاث

201
00:17:00,370 --> 00:17:04,210
المعركة على عرش الإنترنت

202
00:17:05,370 --> 00:17:09,130
حامِلات آلاف الصّلوات وعشرات
،آلاف الأحقاد والضّغائن

203
00:17:09,550 --> 00:17:12,260
!أخيراً، الوقت قد حان

204
00:17:12,720 --> 00:17:14,010
!الأرض تهتزّ

205
00:17:14,010 --> 00:17:15,380
!والسّماء تنشقّ

206
00:17:15,380 --> 00:17:17,390
!والصّمت سائد

207
00:17:17,760 --> 00:17:21,020
!المعركة قد بدأت

208
00:17:19,100 --> 00:17:21,020
انضمّت كارامازوف للمعركة

209
00:17:22,560 --> 00:17:24,020
إنّهن الجيل المُقبل، أليس كذلك؟

210
00:17:24,640 --> 00:17:27,520
ثُلاثيّ حيث كلّ عضوة لديها
،مزاياها وشهرتها الخاصّة

211
00:17:27,520 --> 00:17:29,020
وعلاوة على ذلك، إنّهن مُنسجمات حقّاً

212
00:17:29,690 --> 00:17:31,780
بالنّسبة لمُعجبات صغيرات يُحببنَ
،العلاقات والدّيناميكيّة

213
00:17:31,780 --> 00:17:34,030
أعتقد بأنّهن مجموعة تستحقُّ الإدمان

214
00:17:46,080 --> 00:17:47,920
أطمح لأكون مثلها

215
00:17:47,920 --> 00:17:51,880
كنتُ أشاهد بثوث ملاك الإنترنت
،طوال الوقت

216
00:17:52,050 --> 00:17:54,880
ولا أنكر بأنّها أنقذتني

217
00:17:55,260 --> 00:17:58,890
لكن هذا بالضّبط سبب وداعي لها

218
00:17:58,890 --> 00:18:01,390
إنّها غالباً جاهزة للرّاحة الآن

219
00:18:01,390 --> 00:18:04,390
المعركة على عرش الإنترنت

220
00:18:04,810 --> 00:18:08,400
إنّها هائلة. ساطعة ومُتألِّقة

221
00:18:08,600 --> 00:18:10,900
بالنّسبة لي، إنّها معبد السّرادق الذّهبيّة

222
00:18:11,320 --> 00:18:14,400
إنّها مُبهرة جدّاً لدرجة حارقة

223
00:18:14,690 --> 00:18:17,110
يتغيّر الزّمن

224
00:18:17,110 --> 00:18:21,450
وأجل، أعتقد ستكون مُشكلة إذا لم يأتِ
اليوم الّذي تعتزل فيه ك-آنجل

225
00:18:22,540 --> 00:18:25,410
لكن لا أعتقد بأنّ ذلك اليوم قد حان بعد

226
00:18:25,870 --> 00:18:29,000
.تتمتّع تلك الفتيان بقوّة نجم
إنّهن مُثيرات للاهتمام

227
00:18:29,000 --> 00:18:33,170
وعلاوة على ذلك، يعِشنَ الحياة الرّائعة
الّتي يطمح لها المُعجبون

228
00:18:33,630 --> 00:18:36,590
إنّها فِرقة البثّ المثاليّة حقّاً، أليس كذلك؟

229
00:18:36,590 --> 00:18:39,430
لكن في اليابان، تبقى الرّقم 2 فقط

230
00:18:39,890 --> 00:18:44,060
معبد السّرادق الذّهبيّة هو الأجمل
عندما تشتعل فيه النّيران

231
00:18:44,060 --> 00:18:48,390
.تستطيع فرقة كارامازوف تحقيق ذلك
سيبدأ عصرٌ جديد

232
00:18:48,560 --> 00:18:51,060
مجموعة أصدقاء مُتقاربة جدّاً
تنتشي بدُعاباتها الخاصّة

233
00:18:51,060 --> 00:18:53,190
وتعتقد بأنّها خطفت العصرَ
من خلال الزّخم المُطلَق

234
00:18:53,480 --> 00:18:55,900
تلك الفتوّة ثمينة حقّاً

235
00:18:55,990 --> 00:18:57,900
لكن لا أعتقد بأنّ هذا كافٍ

236
00:18:58,070 --> 00:19:01,910
لنسأل الإله المُتغطرس الّذي صعدَ
كلّ الطّريق نحو القمّة للخروج من المسرح

237
00:19:01,910 --> 00:19:05,370
العالم يريد ذلك. سوف نربح

238
00:19:06,450 --> 00:19:07,790
لن أخسر

239
00:19:10,330 --> 00:19:18,010
الشّخص الّذي يعتلي القمّة
ك-آنجل

240
00:19:10,330 --> 00:19:18,010
الأشخاص الّذين يتحدّون ذلك العرش
كارامازوف

241
00:20:49,720 --> 00:20:52,940
من الصّعب أن أصدّق بأنّ الثّلوج
بدأت تتراكم قبل يوم

242
00:20:53,020 --> 00:20:55,020
تعرف الحياةُ أحياناً كيف تكون دراميّة

243
00:20:55,350 --> 00:20:57,730
مثاليّ لليلة مُقدّسة

244
00:20:57,730 --> 00:21:02,030
سيُغطّي الثّلجُ جثَةَ الملاك
الّتي كسرنا أجنحتها

245
00:21:02,240 --> 00:21:04,530
البرد قارس. أريد العودة إلى المنزل

246
00:21:05,910 --> 00:21:07,780
حان وقت مُغادرتنا

247
00:21:08,280 --> 00:21:11,790
المعذرة يا لوليبوب الأرجوانيّة؟
أردتُ إعطاءكِ شيئاً

248
00:21:11,950 --> 00:21:14,960
!ما هو؟ لا تقولي لي بأنّكِ ستُودّعينني هنا؟

249
00:21:14,960 --> 00:21:18,040
لا بُدّ أنّه من اللّطيف أن يكون المرء أحمق
بما يكفي لامتلاك طاقة في الشّتاء

250
00:21:18,710 --> 00:21:21,460
كنتُ أنوي إعطاءها لكِ دوماً، لكن
دائماً ما أتلكّأ في النّهاية

251
00:21:22,130 --> 00:21:24,970
والآن بقي يوم للمُواجهة، لذا أمسى
،هذا ذا معنى

252
00:21:24,970 --> 00:21:27,300
لكن هذا ليس بالأمر الجلل حقّاً

253
00:21:32,520 --> 00:21:33,850
!أقراط أذن

254
00:21:45,280 --> 00:21:49,830
.أردتُ أن أشكركِ على هذا العِقد
وأيضاً... أن أُشجّعكِ قليلاً

255
00:21:50,910 --> 00:21:52,540
!لكنّه رخيص جدّاً

256
00:21:52,540 --> 00:21:54,460
!أنا لا أقول بأنّه عليكِ ارتداءه أو ما شابه

257
00:21:54,460 --> 00:21:56,580
!سأكون سعيدة فقط إذا احتفظتِ به

258
00:21:56,870 --> 00:21:58,040
!يا للظّرافة

259
00:21:58,040 --> 00:22:01,550
مهلاً! ليس عليكِ أن تكوني لطيفة
!حيال هذا الأمر

260
00:22:01,750 --> 00:22:05,880
غداً هو يوم عظيم، لذا أريدكِ
!أن تظهري بأبهى حلّة لكِ

261
00:22:05,880 --> 00:22:08,590
إذاً هذه هي أبهى حلّة لي

262
00:22:08,890 --> 00:22:10,350
الخاتم من نيتشيكا

263
00:22:10,510 --> 00:22:12,100
والعِقد من ميتشيكا

264
00:22:12,430 --> 00:22:15,850
والآن، قُبيل المعركة، أقراط من صديقة جديدة

265
00:22:16,190 --> 00:22:18,600
!هذا هو أروع مظهر على الإطلاق

266
00:22:19,730 --> 00:22:21,230
لوليبوب الأرجوانيّة

267
00:22:21,900 --> 00:22:24,440
صديقة؟

268
00:22:24,690 --> 00:22:27,610
احذري يا ميتشيكا. سوف تسرق صديقتكِ

269
00:22:28,700 --> 00:22:31,240
ليس لديّ أي أصدقاء

270
00:22:57,890 --> 00:23:01,150
في قديم الزّمان، كان هناك ثلاثة أخوة

271
00:23:01,150 --> 00:23:04,480
كلّ واحد منهم يتمتّع بشخصيّة مُختلفة

272
00:23:04,480 --> 00:23:09,110
كان الأكبر عنيفاً وخارجاً عن القانون، لكن
يمتلك جاذبيّة جامحة وبرّاقة

273
00:23:09,110 --> 00:23:12,780
بينما كان الثّاني ذكيّاً، إلّا أنّ إيمانه كان ضعيفاً

274
00:23:12,780 --> 00:23:15,240
وكان يتأرجح بين العلم والرّبّ

275
00:23:15,240 --> 00:23:18,620
والثّالث كان من الأشخاص الّذين يبدون
بأنّه كتلة من الإيمان

276
00:23:19,170 --> 00:23:23,670
أشعلَتْ وفاةُ والدهم نِزاعاً كبيراً
بين الأخوة الثّلاثة

277
00:23:24,130 --> 00:23:26,510
وحالما دخلت المرأةُ حولهم على الخطّ أيضاً

278
00:23:26,510 --> 00:23:29,010
يا للهول، تحوّل الأمر إلى فوضى عارمة

279
00:23:30,510 --> 00:23:35,970
،لكن في النّهاية، من خلال مسار المِحنة
استرجعَ الأخوةُ الثّلاثة روابطهم

280
00:23:36,270 --> 00:23:39,850
اكتشفَ الأخ الأكبر المسؤوليّة داخل القوّة

281
00:23:39,850 --> 00:23:42,650
والثّاني، الّذي كان يُعذّبه الشّعور
بأنّ فطرته العلميّة

282
00:23:42,650 --> 00:23:46,480
سلّمتْ روحَه للشّيطان، وجدَ طريق العودة

283
00:23:46,480 --> 00:23:49,650
،والثّالث تمسّكَ بالمسيحيّة حتّى آخر لحظة

284
00:23:49,650 --> 00:23:52,950
لينضج ويتطوّر إلى شخص مُبهر
من خلال كلّ التّجارب الّتي خاضها

285
00:23:56,240 --> 00:24:01,210
وهكذا، اعتباراً من هذا اليوم، سنُسمّي
أنفسنا كارامازوف

286
00:24:01,210 --> 00:24:03,580
لذا أيّ أخ تُمثّل كلّ واحدة منّا؟

287
00:24:03,580 --> 00:24:05,540
ليس هنا بيت القصيد

288
00:24:05,540 --> 00:24:07,800
بيت القصيد هو أنّه حتّى عندما يكون
،الثّلاثة مُختلفين تماماً

289
00:24:07,800 --> 00:24:10,800
ما يهمّ في النّهاية هو أنّهم
يؤمنون ببعضهم الآخر

290
00:24:10,800 --> 00:24:15,800
الأشخاص الحقيقيّون لا يملكون شخصيّة
واضحة كشخصيّات الرّوايات

291
00:24:16,100 --> 00:24:18,350
نحن أكثر تعقيداً من ذلك. أشبه بانحداريّين

292
00:24:18,350 --> 00:24:23,230
خِلاف ذلك يا نيتشيكا، بدأتِ تتشبّهين بالأخ الثّاني

293
00:24:23,230 --> 00:24:27,860
الذّكيّ والعالق بين الإله والعلم

294
00:24:27,940 --> 00:24:29,490
رُبّما

295
00:24:29,490 --> 00:24:31,570
رُبّما من وجهة نظرك الخاصّة

296
00:24:31,570 --> 00:24:35,950
لكن من وجهة نظري، تبدين الشّخص الألطف بيننا

297
00:24:36,410 --> 00:24:38,160
هكذا تسير الأمور

298
00:24:38,160 --> 00:24:40,080
افعلي ما تشائين

299
00:24:40,080 --> 00:24:43,580
على أيّ حال، حدثتْ كثير من الأمور
،العجيبة، وفي النّهاية

300
00:24:43,580 --> 00:24:46,590
كلّ واحد منهم سلكَ طريقاً
لم يكن سعيداً تماماً

301
00:24:46,590 --> 00:24:51,220
لكن الأشكال المُختلِفة من "الاستقامة" الّتي
،عثر عليها الأخوةُ الثّلاثة كانت

302
00:24:51,220 --> 00:24:54,220
من دون شكّ، أثمن وأجمل من أيّ شيء

303
00:24:54,970 --> 00:24:56,970
الحلقة القادمة

304
00:24:56,350 --> 00:24:59,430
مُؤدّية البثّ الّتي تُهيمن على القمّة، ك-آنجل

305
00:24:59,600 --> 00:25:02,430
ومُؤدّيات البثّ اللّواتي يتحدّين ذلك
العرش، كارامازوف

306
00:25:02,640 --> 00:25:04,900
تمّ رمي النّرد

307
00:25:05,270 --> 00:25:07,980
"الحلقة القادمة، "النّجمة اللّامعة المسيخ الدجّال

308
00:25:07,980 --> 00:25:09,980
الحلقة 10