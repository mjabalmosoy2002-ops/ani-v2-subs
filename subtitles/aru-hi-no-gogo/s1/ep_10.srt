1
00:00:01,560 --> 00:00:03,190
مارلين مانسون؟

2
00:00:03,310 --> 00:00:04,230
أجل

3
00:00:05,020 --> 00:00:08,730
أشهر الكارهين للمسيح يسوع

4
00:01:45,660 --> 00:01:46,830
مُتوتّرة؟

5
00:01:47,960 --> 00:01:50,580
!كيف لكِ ألّا تكونين مُتوتّرة يا نيتشيكا؟

6
00:01:50,880 --> 00:01:52,250
فلنبدأ

7
00:01:52,250 --> 00:01:56,510
أجل. حتّى أجمل الأزهار لا تعني
شيئاً إذا لم تتفتّح أبداً

8
00:02:01,350 --> 00:02:02,760
حسناً. فلنبدأ

9
00:02:03,310 --> 00:02:05,720
،في أوّل مرّة ذهبتُ فيها إلى المدرسة

10
00:02:05,720 --> 00:02:09,520
،كان الجميع في الصّفّ بسيطين وعاديّين
وغير مرضى نفسيّاً على الإطلاق

11
00:02:09,520 --> 00:02:12,020
أخافني ذلك كثيراً، ولم أستطع الانسجام

12
00:02:12,400 --> 00:02:16,070
ولم أشعر بطيبة كافية في المُعلّمين
للوثوق بهم أيضاً

13
00:02:16,070 --> 00:02:17,530
المكان برمّته بدا مُريباً

14
00:02:17,950 --> 00:02:21,620
،عندما شبكتُ على الإنترنت
كنتُ مُتحمّسة للغاية

15
00:02:21,780 --> 00:02:25,540
كلّ أولئك الأشخاص الّذين طرحوا بشريّتهم
...واختبئوا خلف قِناع المجهول

16
00:02:25,540 --> 00:02:28,790
لم أطِق انتظار رؤية قباحتهم مُقارنة بي

17
00:02:29,040 --> 00:02:32,460
لكن كان العالم عبر الإنترنت
أنظف ممّا تخيّلتُ في الواقع

18
00:02:32,880 --> 00:02:34,800
،على العكس، بعيداً عن كلّ المُجاملات الاجتماعيّة

19
00:02:34,800 --> 00:02:36,880
يمكنك لمح شيء نقيّ فيهم

20
00:02:36,880 --> 00:02:40,470
،وكانت لديهم شخصيّات فاسدة
ولا يعرفون سوى أفعال الفساد

21
00:02:41,760 --> 00:02:44,220
جعلَني ذلك أشعر بالقرف-
جعلَني ذلك أشعر بالقرف-

22
00:02:44,310 --> 00:02:46,180
شعرتُ نفسي مُثيرة للشّفقة-
شعرتُ نفسي مُثيرة للشّفقة-

23
00:02:47,100 --> 00:02:50,770
كلّ ذلك الافتراء والقدح المُتطرّف كان
يُمثّل عقدهم الّتي أخرجوها من أنفسهم

24
00:02:50,850 --> 00:02:54,860
مراراً وتكراراً، هاجموا النّخبَ والبرجوازيّين
بشعبويّة كسولة ورخيصة

25
00:02:54,860 --> 00:02:57,230
ناتجة عن فهم سطحيّ

26
00:02:57,230 --> 00:02:58,940
بندول إيقاع مُحطَّم

27
00:02:59,280 --> 00:03:01,450
،رفضوا العدالة المُزيّفة

28
00:03:01,450 --> 00:03:04,910
.لكن لم يستطيعوا حتّى أن يصبحوا أشراراً حقيقيّين
أقذر قمامة يمكن تصوّرها

29
00:03:04,910 --> 00:03:08,910
وعندما أدركتُ ذلك، العجز في كلّ هذا
بدأ في الواقع يصبح جميلاً

30
00:03:09,410 --> 00:03:12,920
للمرّة الأولى في حياتي، شعرتُ
وكأنّني أحببتُ الآخرين

31
00:03:26,100 --> 00:03:28,890
أتيتُ للإبلاغ. أتيتُ للإبلاغ يا مولايّ

32
00:03:29,180 --> 00:03:30,640
ذلك الرّجل قاسٍ

33
00:03:30,640 --> 00:03:34,150
قاسٍ، أجل. مخلوق حقير. رجل شرّير

34
00:03:34,940 --> 00:03:36,400
لا أستطيع تحمُّل ذلك

35
00:03:36,400 --> 00:03:37,900
يجب ألّا يُسمَح له بالعيش

36
00:03:38,280 --> 00:03:41,360
أجل، أجل. سأهدّئ نفسي وأخبرك كما ينبغي

37
00:03:42,070 --> 00:03:44,240
يجب ألّا يُسمَح لذلك الرّجل بالعيش

38
00:03:44,240 --> 00:03:45,950
إنّه عدوّ العالم

39
00:03:45,950 --> 00:03:49,200
.أجل، سأخبرك بكلّ شيء
كلّ شيء. كلّ تفصيل

40
00:03:49,200 --> 00:03:51,620
أعرف أين هو

41
00:03:51,710 --> 00:03:53,500
سآخذك إلى هناك حالاً

42
00:03:53,500 --> 00:03:56,380
قطّعه إرباً. عذّبه. اقتله

43
00:03:56,380 --> 00:03:58,920
ذلك الرّجل هو مُعلّمي يا مولايّ

44
00:03:59,630 --> 00:04:03,510
هل لديك أدنى فكرة كيف حميتُهم
سرّاً جميعاً طوال هذا الوقت؟

45
00:04:04,470 --> 00:04:06,350
لا أحد يعلم

46
00:04:06,640 --> 00:04:10,350
لا، حتّى الرّجل بحدّ ذاته لا يعلم

47
00:04:10,680 --> 00:04:12,980
لا، إنّه يعلم

48
00:04:13,190 --> 00:04:14,520
يعرف تمام المعرفة

49
00:04:14,520 --> 00:04:19,070
ولأنّه يعرف، يُعاملني باحتقار أكبر حتّى

50
00:04:19,440 --> 00:04:20,780
ذلك الرّجل مُتعجرف

51
00:04:20,780 --> 00:04:24,990
،يعرف كم يتلقّى من مُساعدة منّي
وهذا يُغيظه

52
00:04:25,070 --> 00:04:27,780
إنّه مغرور بصورة غبيّة

53
00:04:27,780 --> 00:04:34,580
يبدو أنّه يعتقد بأنّ قبول المُساعدة من شخص
مثلي هو إهانة فظيعة

54
00:04:34,790 --> 00:04:39,880
إنّه مُستميت ليعتقد الجميع بأنّه
يستطيع فعل كلّ شيء بمفرده

55
00:04:39,880 --> 00:04:42,630
هُراء. لا يسير العالم بهذا الشّكل

56
00:04:42,630 --> 00:04:44,090
،إذا أردت العيش في هذا العالم

57
00:04:44,090 --> 00:04:47,550
،فلا تملك خياراً سوى الانحناء لشخص

58
00:04:47,550 --> 00:04:51,930
ثمّ تُعاني، خطوة بخطوة، إلى أن تتمكّن
من مُساندة الآخرين بحدّ ذاتك

59
00:04:52,220 --> 00:04:54,390
ما الّذي يستطيع ذلك الرّجل فعله حقّاً؟

60
00:04:54,390 --> 00:04:56,100
لا شيء. لا يستطيع فعل شيء

61
00:04:56,100 --> 00:04:57,980
في نظري، لا يزال طفلاً ساذجاً

62
00:04:57,980 --> 00:05:00,570
،لو لم أكن هناك، منذ مدّة طويلة

63
00:05:00,570 --> 00:05:07,360
لكان هو وأتباعه الأغبياء قد ماتوا
كالكِلاب في حقلٍ ما

64
00:05:07,950 --> 00:05:11,120
أعتقد بأنّ ذلك الرّجل جميل

65
00:05:11,120 --> 00:05:13,830
بالنّسبة لي، إنّه كطفل، خالٍ من الجشع

66
00:05:13,830 --> 00:05:17,210
حتّى عندما أقتصد وأدّخر مالاً
،لتوفير قوت يومي

67
00:05:17,210 --> 00:05:21,090
يجعلني أنفق كلّ قطعة نقديّة
على شيء عديم القيمة

68
00:05:21,090 --> 00:05:24,050
لكنّني لا أبغضه على ذلك

69
00:05:24,050 --> 00:05:26,050
إنّه رجلٌ جميل

70
00:05:26,050 --> 00:05:29,050
قد لا أعدو كوني أكثر من تاجرة
،فقيرة، لكن مع ذلك

71
00:05:29,050 --> 00:05:32,470
أعتقد بأنّني أفهم ما يعنيه أن
يكون المرء ذا روح عالية

72
00:05:33,100 --> 00:05:39,810
لذا مهما أنفق ذلك الرّجل بغباء القطع النّقديّة
،الشّحيحة الّتي عملتُ بجدّ لادّخارها

73
00:05:39,810 --> 00:05:41,820
لا أشعر بشيء

74
00:05:41,820 --> 00:05:43,150
لا شيء إطلاقاً

75
00:05:43,150 --> 00:05:48,910
،لكن إن كان الأمر كذلك، فبين الحين والآخر
أما كان يستطيع على الأقلّ أن يمدحني بكلمة لطيفة؟

76
00:05:48,910 --> 00:05:52,660
مع ذلك هو قاسٍ معي دوماً

77
00:05:52,910 --> 00:05:56,410
ذات مرّة، بينما كان ذلك الرّجل
،يتجوّل على امتداد شاطئ الرّبيع

78
00:05:56,410 --> 00:05:58,170
ناداني باسمي فجأة

79
00:05:58,370 --> 00:06:00,210
"أنتِ تفعلين الكثير لأجلي"

80
00:06:00,460 --> 00:06:02,670
"أتفهّم وحدتك"

81
00:06:02,670 --> 00:06:06,050
لكن يجب ألّا يرتسم في وجهك"
"مثل هذه التّعابير العبوسة

82
00:06:06,380 --> 00:06:11,680
أن تبدي وحيدة بينما أنتِ وحيدة"
"هو ما يفعله المُنافقون

83
00:06:11,680 --> 00:06:14,060
لن يعني هذا إلّا أنّك تُبدّلين"
"تعابير وجهك عمداً

84
00:06:14,060 --> 00:06:17,100
"مُحاولة جعل الآخرين يفهمون وحدتك"

85
00:06:17,270 --> 00:06:19,520
"،إن كنت تؤمنين بالرّبّ فعلاً"

86
00:06:19,520 --> 00:06:23,400
فحتّى عندما تكونين وحيدة، ينبغي"
"أن تتظاهري بأنّه لا توجد مُشكلة

87
00:06:23,400 --> 00:06:26,690
"اغسلي وجهكِ، وامسحي رأسكِ، وابتسمي"

88
00:06:27,820 --> 00:06:29,320
"ألا تفهمين؟"

89
00:06:29,320 --> 00:06:31,870
"،حتّى لو لم يفهم أحدٌ آخر وحدتكِ"

90
00:06:31,870 --> 00:06:38,830
ينبغي أن يكفي بأن يفهمها أبوكِ"
"الحقيقيّ، غير المرئيّ في مكانٍ ما

91
00:06:39,080 --> 00:06:42,880
"أليس الأمر كذلك؟ الجميع وحيدون"

92
00:06:45,670 --> 00:06:50,180
،عندما قال ذلك لي، لسبب ما
أردتُ الانفجار بُكاء

93
00:06:50,180 --> 00:06:53,390
لا، لم أحتج لفهم أبي في الجنّة

94
00:06:53,390 --> 00:06:55,680
لم أحتج لمعرفة النّاس في العالم

95
00:06:55,680 --> 00:07:00,560
"إن أنت، أنت فقط، فهمتني، فذلك سيكفي"

96
00:07:00,560 --> 00:07:02,480
"أُحبّك"

97
00:07:02,480 --> 00:07:05,730
مهما كانت درجة عمق حُبّ"
"،الأتباع الآخرين لك

98
00:07:05,730 --> 00:07:08,900
"لا يُمكن مُقارنة حُبّهم بحُبّي"

99
00:07:09,240 --> 00:07:13,620
أحبّ ذلك الرّجل. إذا مات، فسأموت معه

100
00:07:14,120 --> 00:07:17,120
لا ينتمي ذلك الرّجل لأحد. إنّه لي

101
00:07:17,120 --> 00:07:22,170
،إذا ترتّب عليّ تسليمه لشخص آخر
فقبل أن أفعل، سأقتله بنفسي

102
00:07:23,080 --> 00:07:24,920
،هجرتُ أبي، هجرتُ أمّي

103
00:07:24,920 --> 00:07:29,670
هجرتُ مسقط رأسي، وتبعتُ
ذلك الرّجل حتّى يومنا هذا

104
00:07:29,880 --> 00:07:31,720
أنا لا أؤمن بالجنّة

105
00:07:31,720 --> 00:07:32,930
لا أؤمن بالربّ

106
00:07:32,930 --> 00:07:34,800
لا أؤمن بانبعاث ذلك الرّجل

107
00:07:34,800 --> 00:07:37,390
كيف له أن يكون ملك إسرائيل؟

108
00:07:37,640 --> 00:07:39,020
إنّه كاذب

109
00:07:39,020 --> 00:07:42,060
،كلّ كلمة يتفوّه بها هُراء
من البداية حتّى النّهاية

110
00:07:42,060 --> 00:07:44,100
لا أؤمن بأيّ شيء يقوله

111
00:07:44,100 --> 00:07:47,900
لكن أؤمن بجماله

112
00:07:47,900 --> 00:07:50,070
لا يوجد أحدٌ في هذا العالم بجماله

113
00:07:50,070 --> 00:07:52,990
أُحبّ جمال ذلك الرّجل، نقيّ وكامل

114
00:07:52,990 --> 00:07:56,330
هذا كلّ شيء. لا أطلب مُكافأة

115
00:07:59,660 --> 00:08:03,210
ومع ذلك بعد أن اشتقتُ له بإخلاص مُميت

116
00:08:03,210 --> 00:08:05,040
،ولحقتُ به كلّ هذا الطّريق

117
00:08:05,040 --> 00:08:07,880
لم يقلْ لي ولو كلمة

118
00:08:07,880 --> 00:08:13,090
بدلاً من ذلك، احمرّ وجهه بينما أخذ يُدافع
عن تلك المرأة الرّيفيّة الوضيعة

119
00:08:16,350 --> 00:08:18,350
هذا ما كان الأمر عليه. كان
ذلك الرّجل ضعيفاً في نهاية المطاف

120
00:08:18,350 --> 00:08:21,350
فقدَ هيبته. لم يبقَ بصيص أمل فيه

121
00:08:21,350 --> 00:08:23,390
كان عاديّاً. مُجرّد رجل

122
00:08:23,390 --> 00:08:25,230
لن تكون خسارة إذا مات

123
00:08:25,230 --> 00:08:29,110
حالما فكّرتُ في ذلك، خطرتْ فكرة
فظيعة على ذهني

124
00:08:29,110 --> 00:08:31,490
رُبّما كنتُ مسحورة بواسطة الشّيطان

125
00:08:31,900 --> 00:08:36,660
منذ تلك اللّحظة، ارتأيتُ بأنّني ينبغي
أن أقتل الرّجل بيدَي هاتين

126
00:08:36,660 --> 00:08:39,120
كان من المُقدَّر حتماً أن يُقتَل يوماً ما

127
00:08:39,120 --> 00:08:41,160
وفي بعض الأوقات، لمحتُه حتّى

128
00:08:41,160 --> 00:08:44,670
يتصرّف كما لو أنّه كان يتعمّد دفع
الآخرين إلى قتله

129
00:08:47,790 --> 00:08:49,750
سأقتله بيديّ هاتين

130
00:08:49,750 --> 00:08:51,880
لن أدع رجلاً آخر يفعلها

131
00:08:51,880 --> 00:08:54,010
سأقتله، ثمّ سأموت

132
00:08:59,140 --> 00:09:01,060
الطّيور صاخبة جدّاً

133
00:09:01,060 --> 00:09:02,770
أصواتها عالقة في أُذنَي

134
00:09:02,770 --> 00:09:05,810
لماذا تُسبّب الطّيور ضجّة كهذه؟

135
00:09:05,810 --> 00:09:08,980
زقزقة، زقزقة، زقزقة. لِمَ يُحدثون هذه الجلبة؟

136
00:09:10,860 --> 00:09:12,230
المال؟

137
00:09:12,230 --> 00:09:14,200
ستعطيني إيّاه؟

138
00:09:14,450 --> 00:09:16,910
ثلاثون قطعة من الفضّة؟

139
00:09:17,070 --> 00:09:18,370
هكذا إذاً

140
00:09:19,990 --> 00:09:22,370
لا، أنا مُضطرّة للرّفض

141
00:09:22,370 --> 00:09:25,540
كان من الأفضل لك أن تسترجع هذا
المال قبل أن أضربك

142
00:09:25,540 --> 00:09:28,750
لم آتِ إلى هنا لاتّهامهم طمعاً
!منّي بالمال. ضعه جانباً

143
00:09:30,040 --> 00:09:32,670
لا، سامحني. سآخذه

144
00:09:32,670 --> 00:09:35,470
أجل، هذا صحيح. كنتُ تاجرة

145
00:09:35,470 --> 00:09:40,350
بسبب المال، ذلك الرّجل البهيّ
يبغضني دوماً

146
00:09:40,430 --> 00:09:41,720
سآخذه

147
00:09:41,720 --> 00:09:43,470
في النّهاية، أنا تاجرة

148
00:09:43,470 --> 00:09:47,690
بهذا المال المقيت، سوف أحقّق
انتقامي المُبهر منه

149
00:09:47,850 --> 00:09:50,690
هذه هي طريقة الانتقام الأنسب لي

150
00:09:50,690 --> 00:09:51,980
!يستحقّ هذا

151
00:09:51,980 --> 00:09:54,820
سيُباع مُقابل ثلاثين فضّية

152
00:09:57,950 --> 00:10:00,030
!لن أبكي إطلاقاً

153
00:10:00,030 --> 00:10:01,990
!لا أحبّ ذلك الرّجل

154
00:10:01,990 --> 00:10:04,540
لم أُحبّه يوماً. البتّة

155
00:10:04,540 --> 00:10:05,790
أجل يا مولايّ

156
00:10:05,790 --> 00:10:08,000
كلّ ما أخبرتُك به كان كذبة

157
00:10:08,000 --> 00:10:11,590
تبعتُ ذلك الرّجل فقط لأنّني أردتُ مالاً

158
00:10:11,590 --> 00:10:13,800
أجل. لا بُدّ أنّ هذا هو السّبب

159
00:10:14,300 --> 00:10:18,630
اللّيلة رأيتُ بوضوح بأنّه لن يدعني
أبداً أحقّق ربحاً

160
00:10:18,630 --> 00:10:21,640
لذا كأيّ تاجر، غيّرتُ ولائي بسرعة

161
00:10:21,850 --> 00:10:22,890
