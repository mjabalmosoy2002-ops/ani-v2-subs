1
00:00:03,310 --> 00:00:07,340
دانتاك، أنت آخر عملاق تلّة صامد

2
00:00:07,880 --> 00:00:10,190
!لماذا تفعل هذا؟

3
00:00:10,820 --> 00:00:12,700
بسبب كسلك

4
00:00:12,700 --> 00:00:14,450
كسلي؟

5
00:00:14,790 --> 00:00:19,790
وحوش يرفضون قتل النّاس
ويختبئون في قلعتهم؟

6
00:00:20,240 --> 00:00:22,460
هذا يُنافي تعاليم فخامته ديميس

7
00:00:22,800 --> 00:00:24,940
من أنت؟

8
00:00:26,710 --> 00:00:29,840
فان البطل، قاتل الشرّ

9
00:00:30,750 --> 00:00:32,050
بطل"؟"

10
00:00:32,630 --> 00:00:34,730
—مُحال لطفل مجنون

11
00:00:40,220 --> 00:00:41,600
تمّ القضاء على الشرّ

12
00:00:41,600 --> 00:00:44,610
!أنت الأروع يا فان

13
00:00:44,610 --> 00:00:46,800
هذا الشّخص مجنون

14
00:02:28,870 --> 00:02:31,630
هذه رائحة زكيّة يا إيستا

15
00:02:32,000 --> 00:02:34,120
ما رأيك بالانضمام لي على العشاء؟

16
00:02:34,120 --> 00:02:36,270
أين الآخرون؟

17
00:02:36,270 --> 00:02:38,970
فان ولافيندر ذهبا لصيد الوحوش

18
00:02:39,420 --> 00:02:41,640
الكاردينال لوبو نائم

19
00:02:43,570 --> 00:02:45,310
إذاً لا مانع إذا فعلت

20
00:02:51,930 --> 00:02:55,440
كنّا نجلس حول نار التّخييم
هكذا طوال الوقت

21
00:02:55,440 --> 00:02:56,250
أجل

22
00:02:56,890 --> 00:03:02,140
ما تغيّر هو أنّكِ غير معتادة
على الطّبخ يا آنسة تيودورا

23
00:03:02,140 --> 00:03:03,800
حصلتُ على مهارة طبخ

24
00:03:04,190 --> 00:03:06,540
إنّها مُمتعة جدّاً

25
00:03:07,180 --> 00:03:09,790
أتحذين حذوّ ريد؟

26
00:03:10,230 --> 00:03:10,940
أجل

27
00:03:11,550 --> 00:03:13,260
أتمنّى أن أكون مثله

28
00:03:13,750 --> 00:03:17,990
ليس في الطّبخ، لكن أيضاً
في دعم وتوجيه بطل

29
00:03:18,640 --> 00:03:21,800
لكن كلّ ما أتعلّمه في هذه الأيّام
هو كم أنّني ناقصة

30
00:03:22,080 --> 00:03:26,060
أعتقد بأنّ هذه مشكلة مرتبطة أكثر مع بطلكِ

31
00:03:26,060 --> 00:03:28,580
كان آلبيرت قلقاً عليكِ أيضاً

32
00:03:30,800 --> 00:03:34,570
آلبيرت... سبّبتُ له مشكلة كبيرة

33
00:03:34,570 --> 00:03:40,230
لكن تكلّم عنكِ بفخر واعتزاز

34
00:03:40,230 --> 00:03:42,910
أظنّه سعيداً بتمكّنه من العمل بجانبك

35
00:03:43,300 --> 00:03:46,030
ماذا؟ هل قال ذلك حقّاً؟

36
00:03:46,400 --> 00:03:47,160
أجل

37
00:03:47,860 --> 00:03:51,290
بدا أنّه يفتقدكِ كثيراً

38
00:03:51,290 --> 00:03:52,940
ماذا؟

39
00:03:52,940 --> 00:03:56,090
!هو... يفتقدني؟

40
00:03:57,730 --> 00:03:59,730
حـ-حقّاً؟

41
00:04:00,220 --> 00:04:02,850
أفتقد له بنفسي

42
00:04:02,850 --> 00:04:06,080
إذا سنحت الفُرصة، أرغب في رؤيته قريباً

43
00:04:06,080 --> 00:04:07,930
...لحظة، أعني

44
00:04:08,190 --> 00:04:10,250
ما الّذي أقوله حتّى؟

45
00:04:10,930 --> 00:04:12,720
من فضلكِ لا تسيئي الفهم

46
00:04:12,720 --> 00:04:17,510
أتمنّى رؤية صديق عزيز من جديد ببساطة

47
00:04:18,370 --> 00:04:21,110
عـ-على أيّ حال، ترين كيف هو الأمر الآن

48
00:04:21,110 --> 00:04:24,210
أشعر بالعطش فجأة

49
00:04:24,210 --> 00:04:26,620
دعيني أذهب وأحضر بعض الماء

50
00:04:30,700 --> 00:04:31,860
!إحداهن واقعة في الحبّ

51
00:04:36,950 --> 00:04:40,590
،بعض فطائر الكاري الخاصّة بالقرية
إنّها طازجة

52
00:04:40,590 --> 00:04:42,840
!كلوا ما تشاؤون

53
00:04:43,120 --> 00:04:45,340
لا تتردّدوا الآن

54
00:04:47,600 --> 00:04:49,380
كاري على الفطور والغداء والعشاء

55
00:04:49,380 --> 00:04:50,350
!صه

56
00:04:52,990 --> 00:04:58,550
!أعشق هذه الرّائحة والنّكهة الحارّة الغنيّة

57
00:04:58,550 --> 00:05:03,260
!خبز مقليّ. يا للمتعة

58
00:05:03,260 --> 00:05:04,890
الحشوة هي كاري

59
00:05:04,890 --> 00:05:06,430
هذا لأنّها خبزة كاري

60
00:05:06,430 --> 00:05:07,790
!مذهل

61
00:05:07,790 --> 00:05:09,370
!انظرا، انظرا

62
00:05:09,370 --> 00:05:10,390
هذا مذهل

63
00:05:10,390 --> 00:05:11,910
إلى أين هم ذاهبون؟

64
00:05:13,770 --> 00:05:17,850
نادراً ما نرى البيغاسي يحلّقون فوق قريتنا

65
00:05:17,850 --> 00:05:21,130
نادراً؟ لا أظنّني رأيتُ ذلك في حياتي

66
00:05:21,720 --> 00:05:24,300
وكأنّهم يحاولون الهرب

67
00:05:27,500 --> 00:05:28,680
ثمّة شيء يقترب

68
00:05:37,700 --> 00:05:38,980
ترس ملك الجنّيات

69
00:05:39,820 --> 00:05:43,230
يسمح لحامله أن يستخدم سحر التحكُّم بالعقل

70
00:05:45,920 --> 00:05:48,010
أثق بأنّك تعي خطورة ذلك

71
00:05:48,010 --> 00:05:49,990
موعظة أخرى؟

72
00:05:50,250 --> 00:05:52,490
كم أنتِ لحوحة

73
00:05:53,060 --> 00:05:55,170
هذا يعتمد على كيفيّة استخدامه

74
00:05:55,640 --> 00:06:01,000
إذا ما استُخدِم بشكل صحيح، يمكنه
أن يقود الأشرار إلى طريق الإيمان

75
00:06:01,340 --> 00:06:04,700
إنَّ إجبار شخص على الصّلاة لا يجعله مؤمناً

76
00:06:05,260 --> 00:06:07,220
يجب لهذا الشّيء أن يُختَم عليه

77
00:06:07,980 --> 00:06:09,710
التّرس هو مُلك فان

78
00:06:09,710 --> 00:06:12,410
كيفيّة استخدامه ليس من شأنكِ

79
00:06:18,190 --> 00:06:23,120
نحن هنا فقط لتسليم السّفينة الجوّيّة
للبطل، ومع ذلك هم جاهزون للحفلة

80
00:06:23,520 --> 00:06:25,190
يراودني شعور سيّئ حيال هذا

81
00:06:25,190 --> 00:06:28,500
من المؤكّد أنّه لن تكون هناك
مشكلة هذه المرّة

82
00:06:28,500 --> 00:06:31,450
فهذا أكثر ما يريده البطل

83
00:06:34,150 --> 00:06:36,430
أجل، ينبغي لهذا أن يفي بالغرض

84
00:06:36,430 --> 00:06:37,500
موغريم

85
00:06:37,890 --> 00:06:39,760
كيف حال الزّوجة؟

86
00:06:39,760 --> 00:06:44,220
،أظلّ أطلب منها أن ترتاح
لكنّها لا تصغي لي

87
00:06:44,220 --> 00:06:46,050
أنا متوتّرٌ جدّاً طوال الوقت

88
00:06:46,050 --> 00:06:48,010
حسناً، ما زال الوقت باكراً

89
00:06:48,440 --> 00:06:52,890
لكن عليك أن تكون موجوداً بجانبها
وتحرص على ألّا تُرهِق نفسها

90
00:06:53,280 --> 00:06:55,470
!أنوي فعل ذلك فحسب

91
00:07:02,480 --> 00:07:05,020
حسناً، كيف يسير العمل الجديد؟

92
00:07:05,400 --> 00:07:08,280
بدأ يدرّ علينا بالأرباح

93
00:07:08,280 --> 00:07:11,210
الفطور العطِرة من غابة زوغ

94
00:07:11,210 --> 00:07:13,490
مطلوبة بشدّة في هذه المنطقة

95
00:07:13,760 --> 00:07:15,850
!سوف تصبح ثريّاً

96
00:07:15,850 --> 00:07:17,110
اعزمنا على العشاء يوماً ما

97
00:07:17,110 --> 00:07:21,050
ماذا؟ لِمَ عليّ أن أُطعمكما
وأسقيكما أيّها الغبيّان؟

98
00:07:21,050 --> 00:07:22,880
!اشتريا لي أنتما شيئاً

99
00:07:22,880 --> 00:07:25,880
مهلاً، ما هذا الأمر الجلل؟

100
00:07:26,160 --> 00:07:27,630
!كُن رجلاً

101
00:07:27,630 --> 00:07:29,050
!اصمت

102
00:07:29,050 --> 00:07:30,000
!حمقاوان

103
00:07:30,000 --> 00:07:31,960
!عابَ غيره بعيبٍ فيه

104
00:07:30,970 --> 00:07:32,800
!أنتم

105
00:07:32,800 --> 00:07:35,800
!تأدّبوا! انظروا إلى الأطفال المهذّبين

106
00:07:36,600 --> 00:07:38,040
مرحباً

107
00:07:38,040 --> 00:07:39,420
هل يمكنني تناول واحدة؟

108
00:07:41,450 --> 00:07:44,190
!سيحبّ البطلُ هذا

109
00:07:44,190 --> 00:07:45,810
أجل، صحيح

110
00:07:45,940 --> 00:07:47,600
هذا خاطئ

111
00:07:47,600 --> 00:07:50,720
ما تتحدّث عنه ليس بهجة

112
00:07:50,720 --> 00:07:51,950
إنّه انحطاط

113
00:07:54,710 --> 00:07:56,700
!لقد عادَ البطل

114
00:07:59,380 --> 00:08:02,830
هكذا إذاً، وجدتُم السّفينةَ الجوّيّة أخيراً

115
00:08:03,120 --> 00:08:04,250
أجل

116
00:08:04,250 --> 00:08:09,340
والآن من فضلكم احتفلوا بهذه المناسبة

117
00:08:09,340 --> 00:08:10,980
!سيّد بطل

118
00:08:10,980 --> 00:08:12,840
!تهانينا

119
00:08:13,230 --> 00:08:14,220
ليس ثانية

120
00:08:14,840 --> 00:08:16,720
الحفلة غير ضروريّة إطلاقاً

121
00:08:18,670 --> 00:08:21,860
،حضرة المُحافظ، نشكرك على مشاعرك

122
00:08:21,860 --> 00:08:24,690
لكن يجب أن نحجم عن المُشاركة
نظراً إلى أنّ لدينا التزامات مسبقة

123
00:08:26,480 --> 00:08:28,000
عُلِم

124
00:08:28,000 --> 00:08:31,230
فشِلنا في أخذ واجبات البطل بعين الاعتبار

125
00:08:31,230 --> 00:08:33,130
اعذرونا من فضلكم على طيشنا

126
00:08:33,130 --> 00:08:38,200
نصلّي للعظيم ديميس أن يمنحكم
النّجاح في سفركم

127
00:08:38,610 --> 00:08:41,200
صلوات من زنادقة لن تصل مسامع العظيم

128
00:08:51,310 --> 00:08:54,550
فان، لم يكن ذلك ملائماً

129
00:08:54,550 --> 00:08:56,840
اسحب كلامك واعتذر

130
00:08:57,420 --> 00:08:59,560
لا، لا أعتقد أنّني بحاجة لذلك

131
00:09:00,400 --> 00:09:03,340
أنا البطل، وخضعتُ لتدريب كراهب

132
00:09:03,860 --> 00:09:07,440
إحدى مهامي هي هِداية الزّنادقة
نحو الطّريق الصّواب

133
00:09:07,880 --> 00:09:10,020
ما الّذي يتحدّث عنه؟

134
00:09:10,020 --> 00:09:14,550
البرَكات الإلهيّة تُظهِر بأنّ الجميع
يعبدون العظيم ديميس

135
00:09:15,120 --> 00:09:17,450
ومع ذلك ينعتنا بالزّنديقين؟

136
00:09:21,550 --> 00:09:23,080
معدتي تؤلمني

137
00:09:24,160 --> 00:09:28,320
سيّد بطل، ألا تلاحظ بأنّك شديد الإهانة؟

138
00:09:28,320 --> 00:09:31,040
ما الّذي يجعلك تقول بأنّنا زنديقون؟

139
00:09:31,620 --> 00:09:35,260
حقيقة أنّكم تعيشون حياة كسولة مُتراخية هنا

140
00:09:35,560 --> 00:09:37,370
،كما ورد في النّصوص المُقدّسة

141
00:09:37,370 --> 00:09:41,960
الكسل هو خطيئة مُميتة، وهذا يُنافي
الأدوار الّتي منحنا إيّاها العظيم

142
00:09:41,960 --> 00:09:44,770
عليكم أن تتوبوا وتُصلِحوا حالكم

143
00:09:45,650 --> 00:09:47,770
ما يجب عليكم فعله واضح

144
00:09:51,350 --> 00:09:53,980
!ستُقاتلون جيش ملك الشّياطين معي

145
00:09:54,560 --> 00:09:55,860
جيش ملك الشّياطين؟

146
00:09:56,080 --> 00:09:57,280
نحن؟ نقاتل؟

147
00:09:58,160 --> 00:10:02,830
!واجبكم المُقدّس هو القتال بجانب البطل

148
00:10:03,660 --> 00:10:07,270
لدينا أرض لنحميها، وأرواحنا غالية

149
00:10:07,270 --> 00:10:08,740
اطرحوها جانباً

150
00:10:09,840 --> 00:10:12,670
هذه البلاد النّائية لا تستحقّ شيئاً

151
00:10:14,930 --> 00:10:15,810
بئساً

152
00:10:17,970 --> 00:10:22,710
وضع أجدادُنا أرواحهم على المحكّ
!من أجل تطوير زولتان

153
00:10:22,710 --> 00:10:24,840
وتعتبر ذلك غير ذي قيمة؟

154
00:10:24,840 --> 00:10:28,820
!حتّى لو كنتَ البطل، هذه قمّة الوقاحة

155
00:10:28,820 --> 00:10:29,620
وقاحة؟

156
00:10:30,230 --> 00:10:32,710
آداب السُّلوك ليست سوى
عادات ابتدعها النّاس

157
00:10:32,710 --> 00:10:34,780
أتكلّم عن الأمور القدسيّة

158
00:10:43,560 --> 00:10:45,710
لماذا هم هكذا؟

159
00:10:45,710 --> 00:10:49,290
جميعهم يحبّون زولتان حبّاً جمّاً

160
00:10:50,000 --> 00:10:54,630
يُقدِّرون حياتهم الهادئة هنا

161
00:10:57,650 --> 00:10:58,880
كلام فارغ

162
00:11:01,250 --> 00:11:02,430
ما الّذي تفكّر فيه؟

163
00:11:02,740 --> 00:11:03,640
توقّف

164
00:11:04,320 --> 00:11:06,310
لن تعترضا طريق فان

165
00:11:06,590 --> 00:11:11,020
!ابتعدي! ما سيفعله فان ليس بطوليّاً إطلاقاً

166
00:11:11,340 --> 00:11:14,770
أتّفق. لكن ماذا يعني؟

167
00:11:14,770 --> 00:11:19,030
في نظري، كلّ ما يفعله فان صواب

168
00:11:25,620 --> 00:11:28,660
هذا السّحر... أيُعقَل؟

169
00:11:31,620 --> 00:11:32,370
!الكاردينال لوبو

170
00:11:35,940 --> 00:11:38,990
الفشل سيساعد فان في التعلُّم

171
00:11:38,990 --> 00:11:45,170
ووفاة بضعة أشخاص ريفيّين لن تضرّ
بسمعة البطل على الإطلاق

172
00:11:46,100 --> 00:11:48,850
الزمي مكانكِ أيضاً يا تيسّي

173
00:11:49,430 --> 00:11:51,580
أي مُحاولة لإيقاف فان، سأقتلكِ

174
00:11:54,620 --> 00:11:57,770
هذا هو ترس ملِك الجنّيات

175
00:11:58,350 --> 00:12:02,340
لديه قوّة هدايتكم نحو الطّريق
الصوّاب وإنقاذكم

176
00:12:03,560 --> 00:12:06,720
أتتجاهلون عرضَ البطل وتختارون حياة السّلام؟

177
00:12:06,720 --> 00:12:08,160
!لن يتحمّل العظيم ديميس ذلك

178
00:12:08,550 --> 00:12:12,340
!والآن لنقاتل جيش ملِك الشّياطين معاً

179
00:12:15,790 --> 00:12:17,000
!القيد الشّوكيّ

180
00:12:18,990 --> 00:12:19,710
ماذا؟

181
00:12:21,050 --> 00:12:24,130
فان البطل... أنت تتمادى كثيراً

182
00:12:24,600 --> 00:12:25,760
!من أنتِ؟

183
00:12:26,510 --> 00:12:29,220
مجرّد إيلف رفيعة ودودة تقطن في زولتان

184
00:12:31,760 --> 00:12:34,360
أي بطل يستخدم سحرَ التحكُّم بالعقل؟

185
00:12:34,360 --> 00:12:36,150
أنت أقرب إلى شرّير

186
00:12:36,150 --> 00:12:38,930
أتجرئين على نعت البطل بالشرّير؟

187
00:12:38,930 --> 00:12:41,270
لا تملكين الحقّ في الحديث عن الصّواب والخطأ

188
00:12:44,940 --> 00:12:46,160
،أنا فان البطل

189
00:12:46,590 --> 00:12:48,070
!قاتل الشرّ

190
00:12:49,130 --> 00:12:50,320
!الحشائش اللّاسعة

191
00:13:04,410 --> 00:13:06,720
!لنبتعد من هنا

192
00:13:04,410 --> 00:13:06,720
!أسرعوا جميعاً

193
00:13:16,520 --> 00:13:17,440
:الفنّ القتاليّ

194
00:13:18,190 --> 00:13:21,290
!ركلة المُذنّب التّدميريّة

195
00:13:27,570 --> 00:13:29,120
كان ذلك وشيكاً

196
00:13:29,570 --> 00:13:30,560
دانان

197
00:13:30,560 --> 00:13:34,330
لا يمكنكِ مواجهة البطل بمفردكِ. سأشارك

198
00:13:34,330 --> 00:13:36,350
عليك أن تعلم ما تُقحِم نفسك فيه

199
00:13:36,350 --> 00:13:37,600
هذا واضح تماماً

200
00:13:38,480 --> 00:13:40,600
لماذا لا يُعالج نفسه؟

201
00:13:40,600 --> 00:13:42,860
إذا كان البطل، فيستطيع استخدام الأيدي الشّافية

202
00:13:42,860 --> 00:13:44,300
من يدري؟

203
00:13:44,560 --> 00:13:47,770
لعلّ جسده خارقاً، لكن هذا لا يعني
أنّه لا يشعر بالألم

204
00:13:48,690 --> 00:13:50,620
!شرّان عظيمان

205
00:13:51,180 --> 00:13:52,180
لكن أنا البطل

206
00:13:52,770 --> 00:13:54,060
!لن أرضخ للشرّ

207
00:13:54,390 --> 00:14:00,060
فهمتُ الآن. إنّ الإيمان في برَكته هو
ما يجعله مستمرّاً

208
00:14:00,400 --> 00:14:03,320
حان وقت ركل مؤخّرته وإلزامه عند حدّه

209
00:14:04,410 --> 00:14:07,820
العظيم ديميس، أقدِّم لك معركة البطل

210
00:14:10,760 --> 00:14:13,950
!الفنّ القتاليّ: مخالب النّمر الشّرس

211
00:14:14,340 --> 00:14:16,770
الفنّ القتاليّ: النّصل المُقدّس

212
00:14:24,870 --> 00:14:25,920
دعني أساعدك

213
00:14:37,570 --> 00:14:38,730
...هذا مؤلم

214
00:14:39,230 --> 00:14:42,270
لكن... يجب ألّا يستسلم البطل

215
00:14:43,270 --> 00:14:44,650
...إتقان الأيدي الشّافية

216
00:14:45,070 --> 00:14:46,080
انعكاس

217
00:14:50,490 --> 00:14:52,220
مؤلم

218
00:14:52,220 --> 00:14:53,240
مذهل

219
00:14:53,650 --> 00:14:57,000
هذا يؤلمني كثيراً، لكنّه لا يؤثّر بك إطلاقاً

220
00:14:57,370 --> 00:15:00,060
أنت خصمٌ جديرٌ ليواجهه البطل

221
00:15:00,060 --> 00:15:00,960
هل أنت بخير؟

222
00:15:02,980 --> 00:15:05,520
حوّلت الجرح إليّ؟

223
00:15:05,520 --> 00:15:07,920
ليست مهارة بطوليّة

224
00:15:07,920 --> 00:15:11,730
إنّها مهارةٌ تسمح لي بالشّفاء
باستخدام حيويّة خصمي

225
00:15:12,130 --> 00:15:16,330
بهذه المهارة، يمكنني تجاوز أيّ عقبة

226
00:15:16,330 --> 00:15:19,940
مهما كان الشرّ قويّاً، لن يستسلم البطل

227
00:15:20,380 --> 00:15:25,820
!أيّ بطل ينقل آلامه إلى الآخرين؟

228
00:15:26,550 --> 00:15:30,570
إنّه العظيم ديميس من جعلني البطل

229
00:15:31,180 --> 00:15:33,680
أنت ترفض إرادة العظيم

230
00:15:34,310 --> 00:15:36,200
لا كفر أكبر من هذا

231
00:15:45,480 --> 00:15:50,360
أنت من قتل بَني جلدتنا وسرق كنزنا

232
00:15:50,360 --> 00:15:54,010
!حان الوقت لتذوق سخطنا وثأرنا

233
00:15:54,910 --> 00:15:56,360
اللّعنة على أولئك التّنانين الأشرار

234
00:15:56,830 --> 00:15:59,220
هل أتوا لأخذ ترسي؟

235
00:16:02,800 --> 00:16:04,350
!يا روح الشّجرة العظيمة

236
00:16:14,320 --> 00:16:17,780
قوايّ غير ملائمة لمواجهة تنانين سولت

237
00:16:18,090 --> 00:16:20,350
!سوف يدمِّرون البلدة

238
00:16:20,350 --> 00:16:22,000
!أجل، أعلم

239
00:16:22,000 --> 00:16:22,910
!نلتُ منكِ

240
00:16:23,780 --> 00:16:24,420
!أيّها الشّقيّ

241
00:16:25,080 --> 00:16:26,540
!يا روح الشّجرة العظيمة

242
00:16:30,250 --> 00:16:31,760
هذا مؤسف

243
00:16:31,760 --> 00:16:35,590
إذا كنتَ بطلاً حقّاً، فينبغي
!أن تفكّر في إنقاذ النّاس

244
00:16:36,020 --> 00:16:38,310
لا بدّ أنّ هذه هي مشيئة العظيم ديميس

245
00:16:38,960 --> 00:16:42,310
،إذا دمّرَ تنانين سولت هذه البلاد

246
00:16:42,580 --> 00:16:47,650
حتّى الزولتينيّين الكسالى
سينضمّون للحرب، أليس كذلك؟

247
00:16:47,920 --> 00:16:50,950
حسناً، سئمتُ من هرائك

248
00:16:50,950 --> 00:16:52,900
!سوف تسقط أوّلاً

249
00:16:56,030 --> 00:16:57,620
...إتقان الأيدي الشّافية

250
00:16:58,120 --> 00:16:59,100
انعكاس

251
00:17:09,530 --> 00:17:10,750
هل تأخّرت؟

252
00:17:11,030 --> 00:17:12,220
!ريد

253
00:17:12,220 --> 00:17:13,760
ماذا تفعل هنا؟

254
00:17:19,920 --> 00:17:21,310
ماذا تفعل؟

255
00:17:25,980 --> 00:17:27,020
...أنت

256
00:17:48,410 --> 00:17:50,450
ها هي تنانين سولت

257
00:17:50,890 --> 00:17:52,590
فان سيلحقها قريباً ربّما

258
00:17:53,380 --> 00:17:55,300
شكراً يا أوغيغي-سان

259
00:17:56,010 --> 00:18:00,440
لولا خيوطك، لما تمكّنتُ من الوصول في الوقت

260
00:18:02,260 --> 00:18:07,090
الآن عليّ أن أحرص على ألّا تُهدَر جهوده

261
00:18:10,520 --> 00:18:12,070
!اسمعوني

262
00:18:18,960 --> 00:18:21,280
...تعطُّش هائل للدّماء

263
00:18:21,280 --> 00:18:22,310
إنّه البطل

264
00:18:23,440 --> 00:18:25,330
اسمعوني

265
00:18:25,690 --> 00:18:29,020
سارعتُ إلى هنا وذلك كي أتمكّن
من إعادة هذا إليكم

266
00:18:29,670 --> 00:18:31,580
كان لكم من الأساس، صحيح؟

267
00:18:32,450 --> 00:18:37,420
بالفعل. ائتمنا ملِك الشّياطين السّابق
على هذا الكنز

268
00:18:37,840 --> 00:18:38,850
توقّعت

269
00:18:39,580 --> 00:18:40,670
استرجعوه

270
00:18:49,900 --> 00:18:52,500
احذر من ذلك البطل

271
00:18:54,230 --> 00:18:57,610
...أشكرك على التّحذير، لكن

272
00:18:57,610 --> 00:18:58,240
:الفنّ القتاليّ

273
00:18:58,550 --> 00:18:59,450
فات الأوان

274
00:18:59,450 --> 00:19:01,260
!النّصل المُقدّس

275
00:19:06,590 --> 00:19:10,540
يا إلهي. هذا سيجعل المُسافرين
يواجهون وقتاً عصيباً

276
00:19:11,220 --> 00:19:13,540
أنت فاشلٌ كبطل

277
00:19:13,840 --> 00:19:15,250
أنت زنديق أيضاً إذاً

278
00:19:15,450 --> 00:19:16,170
!مهلك

279
00:19:18,480 --> 00:19:23,030
،إذا كنت لا تستطيع التّلويح بسيفك
فلن تتمكّن من تقطيع أحد

280
00:19:23,030 --> 00:19:25,930
!أنت! ابتعد عنّي

281
00:19:26,190 --> 00:19:28,640
،عملتَ على تطوير مستوى برَكتك

282
00:19:28,640 --> 00:19:30,440
لكن ليس مهاراتك بالسّيف

283
00:19:30,750 --> 00:19:32,930
مهارات السّيف؟ مجرّد تقنيّة بشريّة؟

284
00:19:32,930 --> 00:19:35,690
!إنّها نكرة أمام برَكتي الإلهيّة

285
00:19:36,000 --> 00:19:39,090
هكذا هو تفكيرك إذاً

286
00:19:39,600 --> 00:19:44,700
هذا يفسّر سبب قدرتي على استدراجك
إلى خارج البلدة، بعيداً عن فرقتك

287
00:19:45,890 --> 00:19:47,980
،إذا لم أستطع استخدام سيفي
!فلديّ سحري إذاً

288
00:19:51,220 --> 00:19:53,750
لا أتوقّع استخدام أيّ سحر من هذه المسافة

289
00:19:54,060 --> 00:19:56,690
لِمَ تكسب الوقت؟

290
00:19:56,690 --> 00:19:59,630
يستطيع البطلُ القتال طوال اللّيل
!دون أن يلهث حتّى

291
00:20:00,000 --> 00:20:02,940
لا أعتقد أنّ ذلك سيطول كثيراً

292
00:20:02,940 --> 00:20:03,640
أتعرف السّبب؟

293
00:20:06,980 --> 00:20:07,730
من؟

294
00:20:20,290 --> 00:20:22,620
من... كانت؟

295
00:20:24,460 --> 00:20:26,700
ليست بالشّخص المهمّ

296
00:20:26,700 --> 00:20:28,630
لا حاجة لتتذكّرني غداً

297
00:20:29,450 --> 00:20:31,560
سيصل فريق فان إلى هنا قريباً

298
00:20:31,560 --> 00:20:33,740
ينبغي أن نغادر قبل أن يروا وجوهنا

299
00:20:33,740 --> 00:20:34,540
أجل

300
00:20:39,340 --> 00:20:40,680
...أشعر ببرد

301
00:20:41,660 --> 00:20:44,540
فهمت، أنا على وشك الموت إذاً

302
00:20:45,780 --> 00:20:47,280
هُزِمَ البطل

303
00:20:51,010 --> 00:20:52,140
ولا مُشكلة في ذلك

304
00:20:53,180 --> 00:20:58,480
فعمل البطل هو مقاتلة الشرّ، لا الفوز

305
00:20:59,730 --> 00:21:02,410
وأنا فعلتُ ما طُلِب منّي

306
00:21:03,750 --> 00:21:07,180
لكن لِمَ كانت تلك الفتاة بالذّات؟

307
00:21:07,180 --> 00:21:08,250
!فان

308
00:21:08,250 --> 00:21:11,450
!كم هذا فظيع! لا تمُت يا فان

309
00:21:08,250 --> 00:21:12,040
إذا سار كلّ شيء وفق مشيئة
،العظيم ديميس

310
00:21:12,880 --> 00:21:15,450
استخدمي التّجدُّد

311
00:21:12,880 --> 00:21:16,200
...فلا بدّ أنّني التقيتُ بتلك الفتاة لسبب

312
00:21:15,450 --> 00:21:16,200
حسناً

313
00:21:22,880 --> 00:21:24,380
...هكذا إذاً

314
00:21:31,590 --> 00:21:32,770
الأيدي الشّافيّة

315
00:21:39,080 --> 00:21:40,370
!هل أنت بخير؟

316
00:21:40,370 --> 00:21:42,360
!لا بدّ أنّك تتألّم! أنا آسفة جدّاً

317
00:21:42,650 --> 00:21:45,120
!لن أدعك لوحدك ثانية أبداً

318
00:21:47,300 --> 00:21:49,840
هذا جزء من دوري إذاً

319
00:21:50,940 --> 00:21:51,860
فان؟

320
00:21:52,620 --> 00:21:54,860
سأقتل تلك الفتاة

321
00:21:55,860 --> 00:21:59,360
وسوف أصبح البطل الحقيقيّ

322
00:22:02,600 --> 00:22:04,600
!جاء العظيم