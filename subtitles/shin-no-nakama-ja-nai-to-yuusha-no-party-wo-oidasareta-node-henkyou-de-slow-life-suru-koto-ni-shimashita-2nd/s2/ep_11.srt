1
00:00:03,730 --> 00:00:07,550
هناك أطلال إيلفيّة قديمة
في أعلى جبال زولتان

2
00:00:07,550 --> 00:00:11,680
الفتاة هي سلاح إنسان آليّ صُنِع هناك

3
00:00:11,680 --> 00:00:14,530
يمكنك قراءة المزيد عنها
في تقرير التّحقيق ذاك

4
00:00:15,240 --> 00:00:19,480
،إنّها ليست خطراً على البشريّة
لذا لا سبب يدفعنا للبقاء هنا

5
00:00:19,480 --> 00:00:20,830
سوف نعود حالاً

6
00:00:20,830 --> 00:00:22,250
أخشى أنّني لا أستطيع قبول هذا

7
00:00:22,250 --> 00:00:23,250
لماذا؟

8
00:00:23,690 --> 00:00:27,940
لأنّنا يجب أن نعيش مثلما تُملي علينا بركاتُنا

9
00:00:28,400 --> 00:00:30,250
تُملي عليّ برَكتي أنّ الوقت
لم يحِن للذّهاب

10
00:00:32,050 --> 00:00:34,750
حسناً، لا أريد أن أجبرك على الرّحيل

11
00:00:35,180 --> 00:00:38,540
آمل أن تشجّعك برَكتُك على الشّروع
في رحلة جديدة

12
00:00:40,520 --> 00:00:44,770
يبدو أنّ العظيم ديميس قد ابتلاني
بمِحنة كي أتغلّب عليها

13
00:00:44,770 --> 00:00:46,020
أي مِحنة؟

14
00:00:46,330 --> 00:00:48,390
...لا أعرف السّبب

15
00:00:48,390 --> 00:00:51,420
لكن دوافع برَكتي، والّتي جعلَتْني
،أمضي قُدماً طوال هذا الوقت

16
00:00:52,720 --> 00:00:54,230
قد اختفَتْ كلّياً على ما يبدو

17
00:02:33,800 --> 00:02:34,740
شهيّ

18
00:02:37,650 --> 00:02:40,320
الشّاي الّذي تُعِدّه يساعد المرء
على الاسترخاء يا ريد

19
00:02:40,320 --> 00:02:41,710
يسرّني سماع ذلك

20
00:02:42,340 --> 00:02:44,300
حسناً، كيف حال فان؟

21
00:02:45,770 --> 00:02:49,350
كان يتصرّف بغرابة منذ خاض
تلك المهمّة معك

22
00:02:50,080 --> 00:02:52,990
ينعزل في غرفته طوال اليوم ويصلّي

23
00:02:52,990 --> 00:02:54,610
قلَّ كلامه الآن أيضاً

24
00:02:56,860 --> 00:02:59,770
،نعلم ما قد يخطر على ذهنه من أفكار جنونيّة

25
00:02:59,770 --> 00:03:02,800
لذا لوبو وأنا نتناوب على تفقّده

26
00:03:02,800 --> 00:03:04,120
مرحباً

27
00:03:04,120 --> 00:03:06,580
مرحباً. هل من مشكلة؟

28
00:03:06,580 --> 00:03:08,620
أردتُ رأيكم حول شيء

29
00:03:08,980 --> 00:03:13,700
كانت هناك مهمّة بحث عن طفلة
،مفقود في الغابة

30
00:03:13,700 --> 00:03:18,130
لكن الآنسة روتي وأنا لا نستطيع
فعل شيء خشية أن نُصادف فان

31
00:03:18,130 --> 00:03:23,360
والمُغامرون الآخرون لا يقبلون المهمّة لأنّهم
،يشكّون بوجود خدعة ما في الأمر

32
00:03:23,360 --> 00:03:24,770
لذا النّقابة محتارة

33
00:03:24,770 --> 00:03:26,500
سأذهب أنا إذاً

34
00:03:26,500 --> 00:03:27,440
ماذا؟

35
00:03:27,440 --> 00:03:28,560
متأكّد؟

36
00:03:28,560 --> 00:03:30,640
أجل. دعوا هذا الأمر لي

37
00:03:30,880 --> 00:03:32,140
...لكن

38
00:03:32,380 --> 00:03:34,320
،كنتُ مُغامِراً زولتيّاً

39
00:03:34,320 --> 00:03:36,420
لذا أعرف طريقاً التفافيّاً

40
00:03:36,960 --> 00:03:42,030
وفي حين أنّني أعلم بأنّ هذا
،لن يعوّض ما فعلتُه في السّابق

41
00:03:42,030 --> 00:03:45,160
أريد مساعدة هذه المنطقة
بأي طريقة ممكنة

42
00:03:45,420 --> 00:03:46,540
...آلبيرت

43
00:03:47,300 --> 00:03:53,840
لستُ بطلاً أو نصيراً، لكن أسافر مع إيستا الآن

44
00:03:53,840 --> 00:03:57,540
يُسعدني ذلك للغاية، وهو مصدر فخر دائم لي

45
00:03:57,930 --> 00:04:02,000
أريد التصرُّف بطريقة تجعلني مُلائماً كشريك لها

46
00:04:02,000 --> 00:04:04,050
شـ-شرف لي أن يراودك هذا الشُّعور

47
00:04:06,010 --> 00:04:06,970
!ماذا؟

48
00:04:06,970 --> 00:04:09,680
يمكننا الوثوق بآلبيرت بمُعالجته للأمور

49
00:04:09,680 --> 00:04:12,180
أ-أجل، أفترض ذلك

50
00:04:12,180 --> 00:04:15,350
هذه كلّ المعلومات الّتي لدينا حاليّاً

51
00:04:15,350 --> 00:04:17,040
الأمر يعود لك الآن

52
00:04:17,040 --> 00:04:17,730
حسناً

53
00:04:43,040 --> 00:04:46,800
نفدت الكمّية. أحضر قنينة أخرى

54
00:04:48,480 --> 00:04:51,470
ماذا تظنُّ أنّك تفعل هنا يا لوبو؟

55
00:04:51,470 --> 00:04:53,260
هذه أنتِ يا إيستا

56
00:04:53,260 --> 00:04:55,160
انضمّي لي في المشروب

57
00:04:55,160 --> 00:04:58,000
أين فان؟ ما زال في النُّزُل؟

58
00:04:58,000 --> 00:05:01,480
لا. ذهب إلى مكان ما بمفرده

59
00:05:01,750 --> 00:05:03,370
ماذا تعني؟

60
00:05:03,370 --> 00:05:05,240
لا أعرف التّفاصيل

61
00:05:05,600 --> 00:05:08,490
،سَمِعَ بأنّ طفلة قد فُقِدت

62
00:05:08,490 --> 00:05:11,240
لذا ذهب هو ولافيندر للبحث

63
00:05:13,090 --> 00:05:16,680
يتجاهل كلّ ما أقوله

64
00:05:16,680 --> 00:05:21,880
لكن لماذا؟ ما الّذي أصاب بطلي؟

65
00:05:23,390 --> 00:05:26,880
لكن ما زال يمكن مُعالجته. لا بدّ من ذلك

66
00:05:29,920 --> 00:05:35,020
ألم يكن العظيم من أحضر البطل إليّ؟

67
00:05:40,120 --> 00:05:42,620
لم أتوقّع أن أواجه أوغر في هذه الغابة

68
00:05:43,260 --> 00:05:44,280
آمل أن يبقى الطّفل على ما يُرام

69
00:05:50,580 --> 00:05:51,330
بئساً

70
00:05:51,600 --> 00:05:53,010
آسف بشأن ذلك

71
00:05:54,000 --> 00:05:55,820
!كوروكورورو

72
00:05:56,830 --> 00:05:59,420
!لا تقتله

73
00:05:57,430 --> 00:05:59,420
...أ... أنا بخير

74
00:05:59,690 --> 00:06:03,320
لحظة، أنا مجرّد مُغامر. أتيتُ بحثاً عنكِ

75
00:06:03,320 --> 00:06:04,490
عنّي؟

76
00:06:04,490 --> 00:06:09,180
أجل. كان والداكِ قلقين من أن تتوهي في الغابة

77
00:06:09,510 --> 00:06:11,580
كنتُ ألعب مع كوروكورورو

78
00:06:11,580 --> 00:06:13,660
لكن آنذاك، ظهرَ ذلك الوحش

79
00:06:14,430 --> 00:06:16,180
الأمور بخير الآن

80
00:06:16,180 --> 00:06:18,440
حافظتِ عليها، أليس كذلك؟

81
00:06:18,760 --> 00:06:21,940
!أجل! كوروكورورو حمَتْني

82
00:06:21,940 --> 00:06:24,290
لكن هناك كائن أكثر رُعباً في الأرجاء

83
00:06:24,290 --> 00:06:25,940
!جميع الجنّيون خائفون

84
00:06:26,280 --> 00:06:27,020
ماذا؟

85
00:06:27,020 --> 00:06:28,700
وجدتُها

86
00:06:29,440 --> 00:06:30,450
سيّد بطل

87
00:06:30,450 --> 00:06:31,840
هل تأذّت الطّفلة؟

88
00:06:31,840 --> 00:06:32,700
لا

89
00:06:33,060 --> 00:06:34,290
هذا جيّد

90
00:06:34,700 --> 00:06:36,730
ما خطب هالته المُستبدّة؟

91
00:06:37,260 --> 00:06:38,750
ثمّة شيء غريب فيه

92
00:06:39,350 --> 00:06:41,710
سأعيدها إلى المنزل الآن

93
00:06:41,710 --> 00:06:43,120
هيّا بنا

94
00:06:43,120 --> 00:06:45,710
قبل ذلك، علينا أن نقتل الشرّ
الّذي سبّبَ كلّ هذا

95
00:06:46,120 --> 00:06:48,220
الـ... الشرّ؟

96
00:06:48,710 --> 00:06:51,470
ألم يقم ذلك الشّيء بإغواء الطّفل
لدخول الغابة؟

97
00:06:52,040 --> 00:06:54,090
يجب على الشرّ أن يُقتَل

98
00:06:54,930 --> 00:06:58,100
ا-اهدأ يا سيّد بطل

99
00:06:58,100 --> 00:07:01,190
التّنانين الجنّية ليست وحوشاً خبيثة

100
00:07:01,190 --> 00:07:05,150
،إنّهم جنّيون، مثل لافيندر تماماً
!وودودون مع البشر

101
00:07:05,150 --> 00:07:08,070
تستخدمني للتوسّل على حياته؟

102
00:07:08,070 --> 00:07:10,960
آلبيرت. سأنتظر عشر ثوانٍ حتّى تبتعد

103
00:07:10,960 --> 00:07:13,660
إذا اعترضتَ طريقي، فسأعتبرك
شرّيراً إذاً ويجب أن تُقتَل

104
00:07:16,800 --> 00:07:19,260
!اهربا! سوف أتصدّى لهما

105
00:07:19,260 --> 00:07:20,220
...لـ-لكن

106
00:07:20,220 --> 00:07:21,040
!اذهبي فحسب

107
00:07:25,360 --> 00:07:27,420
هل تعرف ذاك الجنّي؟

108
00:07:27,880 --> 00:07:30,130
لا. التقيتُ به للتوّ

109
00:07:30,620 --> 00:07:33,140
هل أنت واثق بأنّك تستطيع هزيمتي؟

110
00:07:34,800 --> 00:07:35,890
على الإطلاق

111
00:07:35,890 --> 00:07:38,890
إذاً لماذا ترمي بحياتك؟

112
00:07:40,630 --> 00:07:42,310
معك حقّ

113
00:07:42,310 --> 00:07:44,570
أنا أرتجف خوفاً بصراحة

114
00:07:45,200 --> 00:07:49,150
لكن لن أقف مكتوف اليدين وأراك
وأنت تزهق روحاً بريئة

115
00:07:49,750 --> 00:07:51,650
!ولن أهرب من هذه المعركة

116
00:07:52,220 --> 00:07:54,160
ما هذا الإحساس؟

117
00:07:54,730 --> 00:07:59,900
لا أعرف السّبب، لكن يبدو وكأنّني
أرغب في قتلك

118
00:08:13,480 --> 00:08:15,050
لافيندر، هل يمكنك تعقّبهما؟

119
00:08:15,050 --> 00:08:16,300
!أستطيع بالطّبع

120
00:08:25,800 --> 00:08:26,730
ما الّذي تحاول فعله؟

121
00:08:27,850 --> 00:08:30,010
لا... تقتله

122
00:08:31,050 --> 00:08:33,640
لِمَ تفعل هذا لمجرّد جنّي؟

123
00:08:33,640 --> 00:08:37,740
لأنّني جزء من فريق البطل

124
00:08:40,350 --> 00:08:43,460
أريد أن أتصرّف بطريقة ملائمة لذلك

125
00:08:43,750 --> 00:08:44,780
أفلتني

126
00:08:48,440 --> 00:08:55,500
أفلتني

127
00:08:57,180 --> 00:09:08,270
!أفلتني

128
00:09:08,520 --> 00:09:11,860
!أنا البطل، اللّعنة عليك

129
00:09:23,160 --> 00:09:24,290
!فان

130
00:09:26,040 --> 00:09:27,210
قاتلتَ ببسالة

131
00:09:28,830 --> 00:09:29,960
تجدَّد

132
00:09:31,940 --> 00:09:35,110
آلبيرت، أنت نصير

133
00:09:35,760 --> 00:09:38,430
أنا فخورةٌ بك بحقّ

134
00:09:41,040 --> 00:09:45,430
إيستا، منعني هذا الرّجل من قتل الشرّ

135
00:09:47,190 --> 00:09:50,270
فان، هل تعتقد بأنّني بمزاج
يسمح لي بإجراء محادثة؟

136
00:09:50,270 --> 00:09:51,690
...أنا

137
00:09:52,000 --> 00:09:54,050
!أستشيط غضباً

138
00:10:01,530 --> 00:10:02,910
لماذا؟

139
00:10:02,910 --> 00:10:05,240
!كنتِ مثَلي الأعلى

140
00:10:05,240 --> 00:10:07,600
لعلّك ارتكبتَ خطأ فادحاً؟

141
00:10:08,420 --> 00:10:09,880
!ابتعدي عنه

142
00:10:13,950 --> 00:10:16,550
!تقولين بأنّكِ غاضبة ثمّ تقاتلين كساقطة

143
00:10:17,160 --> 00:10:19,660
وماذا حدث لكِ؟

144
00:10:19,660 --> 00:10:23,180
ظننتُ أنّكِ لم تريدي أن تُري فان
كيف تُقاتلين فعليّاً

145
00:10:23,180 --> 00:10:24,710
اصمتي

146
00:10:24,710 --> 00:10:27,850
كرهتُكِ منذ رأتْكِ عينايّ

147
00:10:29,270 --> 00:10:31,230
حسناً، هذا يكفي

148
00:10:34,630 --> 00:10:39,070
مجرّد جنّية ماء وضيعة تعتقد
أنّها قادرة على إيقافي؟

149
00:10:39,330 --> 00:10:42,400
غضبُكِ يفسد وجهكِ الصّغير الظّريف

150
00:10:42,400 --> 00:10:44,580
هل تحاولين فضح نفسكِ؟

151
00:10:44,580 --> 00:10:46,180
!ستموتين

152
00:11:12,060 --> 00:11:12,960
...فان

153
00:11:15,520 --> 00:11:16,610
الأيادي الشّافية

154
00:11:20,520 --> 00:11:22,950
تلك الفتاة ضمن منالي

155
00:11:23,470 --> 00:11:25,880
...قريباً، أستطيع

156
00:11:33,760 --> 00:11:36,040
هل سيكون السيّد مُغامِر بخير؟

157
00:11:36,400 --> 00:11:38,800
شُفيَتْ جروحه كلّياً

158
00:11:38,800 --> 00:11:40,970
إنّه يستريح الآن فحسب

159
00:11:42,610 --> 00:11:46,050
.أنا مسرور لأنّ الطّفلة نجَتْ أيضاً
أبلى آلبيرت بلاء حسناً

160
00:11:46,760 --> 00:11:48,810
هل سيستيقظ يا تُرى؟

161
00:11:48,810 --> 00:11:53,110
أجل. ضغط على نفسه زيادة
عن اللّزوم للتّعامل مع فان

162
00:11:53,110 --> 00:11:55,290
يحتاج وقتاً للرّاحة

163
00:11:55,290 --> 00:11:56,310
هكذا إذاً

164
00:11:56,610 --> 00:11:59,030
يسرّني أنّكِ أدركتِ ما كان يجري

165
00:12:00,190 --> 00:12:03,690
خمّنتُ فحسب. شعرتُ بشيء
خطير يلوح في الأفق

166
00:12:04,800 --> 00:12:06,780
خرجَ فان عن السّيطرة

167
00:12:06,780 --> 00:12:10,010
دوافع برَكات البطل قويّة جدّاً

168
00:12:10,010 --> 00:12:13,790
في العادة، لا تدعك هذه الدّوافع
تقاتل من منبع عاطفيّ

169
00:12:14,350 --> 00:12:18,310
لا بدّ أنّه مُرتبك لدرجة تُقمَع فيها دوافع بركَته

170
00:12:19,020 --> 00:12:20,800
مررتُ بهذه التّجربة من قبل

171
00:12:21,270 --> 00:12:24,610
لا بدّ أنّه مُرتعِد من مدى تردّده

172
00:12:25,200 --> 00:12:28,560
كان هدفي تغيير عقليّته، لكن
لم أكن أتوقّع هذا

173
00:12:28,810 --> 00:12:30,420
هذه ليست غلطتك

174
00:12:30,860 --> 00:12:34,560
تقع المسؤوليّة على عاتقنا، كوننا
الأشخاص الّذين قضينا وقتاً طويلاً معه

175
00:12:34,880 --> 00:12:35,730
إيستا

176
00:12:37,860 --> 00:12:39,940
اسمح لي بالذّهاب وتهدئة نفسي

177
00:12:45,300 --> 00:12:46,320
أخي

178
00:12:46,550 --> 00:12:47,190
أعلم

179
00:12:57,520 --> 00:13:02,250
للمرّة الأولى في حياتي، أسمح
لغضبي بالسّيطرة عليّ

180
00:13:03,080 --> 00:13:05,730
...عندما رأيتُ آلبيرت على حافّة الموت، أنا

181
00:13:05,730 --> 00:13:07,760
لم تستطيعي منع نفسكِ؟

182
00:13:07,760 --> 00:13:11,760
كنتُ خائفة من فقدانه

183
00:13:12,430 --> 00:13:15,770
حتّى الآن، نفس الفكرة تغرس
وتداً في قلبي

184
00:13:16,580 --> 00:13:22,060
وحاولتُ مرّةً قتلك من أجل الحفاظ
على روتي تقاتل كبطلة لنا

185
00:13:22,660 --> 00:13:24,780
تغيّرتُ كثيراً، وهذا أكثر ما يُخيفني

186
00:13:25,900 --> 00:13:28,700
قد أرتكب القرارَ الخاطئ في نهاية المطاف ثانية

187
00:13:29,280 --> 00:13:33,300
قد أخسر نفسي وأفعل شيئاً يتعذّر إصلاحه

188
00:13:34,210 --> 00:13:35,790
وهذا يُرعبني

189
00:13:36,300 --> 00:13:39,290
هل ستتخلّين عن مشاعركِ تجاه آلبيرت إذاً؟

190
00:13:45,630 --> 00:13:46,590
...لا

191
00:13:47,830 --> 00:13:49,300
لا أستطيع

192
00:13:50,460 --> 00:13:52,120
لا أريد ذلك

193
00:13:53,130 --> 00:13:54,850
لا مشكلة إذاً

194
00:13:55,500 --> 00:13:58,000
،لا تنبع تلك العواطف من برَكَتكِ

195
00:13:58,000 --> 00:14:00,390
إنّما من أعماق قلبكِ

196
00:14:01,080 --> 00:14:03,820
وأعتقد لِهذا قيمة حقيقيّة

197
00:14:04,830 --> 00:14:07,820
...العواطف الّتي لا علاقة لها ببرَكاتنا

198
00:14:10,590 --> 00:14:15,930
إنّ لقاءكم جعلَ منّي امرأة
مؤمنة لدرجة فظيعة

199
00:14:16,450 --> 00:14:17,960
ريد. إيستا

200
00:14:34,530 --> 00:14:35,430
من الطّارق؟

201
00:14:35,950 --> 00:14:37,930
الكاردينال لوبو، هذا أنا

202
00:14:37,930 --> 00:14:42,080
فان. ادخل

203
00:14:44,010 --> 00:14:47,690
أتيتُ لأخبرك بأنّني سأغادر زولتان

204
00:14:47,690 --> 00:14:51,440
!حـ-حقّاً؟ فهمتَ أخيراً

205
00:14:51,440 --> 00:14:53,110
!لنستعدّ للمغادرة حالاً

206
00:14:53,110 --> 00:14:56,070
لكن أوّلاً، سأتوجّه إلى مسكن أوندين

207
00:14:56,070 --> 00:14:56,910
ماذا؟

208
00:14:57,230 --> 00:14:59,570
وسأقتل كلّ الجنّيين هناك

209
00:14:59,570 --> 00:15:01,880
أعتقد بأنّ إيستا وغيديون والآخرين
،سيكونون هناك كذلك

210
00:15:01,880 --> 00:15:03,360
وسوف أقتلهم أجمعين

211
00:15:03,360 --> 00:15:05,920
عمّاذا تتكلّم؟

212
00:15:06,220 --> 00:15:09,670
،هذا سيستدرج الفتاة للخروج حتماً
وسوف أقتلها

213
00:15:10,160 --> 00:15:13,680
إن لم تظهر، فسأدمِّر زولتان حتّى تظهر

214
00:15:13,970 --> 00:15:15,700
اهدأ يا فان

215
00:15:15,700 --> 00:15:20,260
أنت البطل. يجب أن تتصرّف على هذا الأساس

216
00:15:23,470 --> 00:15:24,440
...فان

217
00:15:25,580 --> 00:15:26,620
لماذا؟

218
00:15:28,160 --> 00:15:31,350
لم أعُد أشعر بدوافع برَكة البطل

219
00:15:31,350 --> 00:15:35,100
برَكتي لا تخبرني ما عليّ فعله كبطل

220
00:15:35,500 --> 00:15:36,200
...بالتّالي

221
00:15:36,640 --> 00:15:39,180
...سأنفّذ الدّافع الأخير الّذي أعطَتْني إيّاه برَكتي

222
00:15:39,180 --> 00:15:43,580
سأقتل تلك الفتاة وكلّ ما يعترض
طريقي من شرّ

223
00:15:44,680 --> 00:15:46,480
...انتـ

224
00:15:54,230 --> 00:15:55,760
سيأتي فان إلى هنا قريباً

225
00:15:56,330 --> 00:15:58,610
ولا شكّ في أنّ لافيندر ستكون معه

226
00:15:58,610 --> 00:16:01,770
لا أستطيع إيقاف تلك الجنّية بمفردي

227
00:16:02,170 --> 00:16:05,110
إنّها أقوى من جنّية ماء؟

228
00:16:05,110 --> 00:16:07,580
من تكون لافيندر بالضّبط؟

229
00:16:08,240 --> 00:16:12,150
،لم أرد الاعتراف لها

230
00:16:12,150 --> 00:16:14,570
لكن أعتقد فات الأوان على ذلك الآن

231
00:16:16,490 --> 00:16:19,200
إنّها كارثة

232
00:16:19,200 --> 00:16:20,560
ماذا؟

233
00:16:20,560 --> 00:16:23,410
إنّها إحدى الجنّيات كيتو

234
00:16:23,410 --> 00:16:26,160
تجسيد للقوّة والدّمار

235
00:16:26,160 --> 00:16:30,420
عاثوا فساداً كما الكوارث الطبيعيّة
منذ وُجِد هذا الكوكب

236
00:16:30,750 --> 00:16:35,040
مع تقدُّم الحضارة، الإيلف القدماء
،والتّنانين أبادوا الكيتو

237
00:16:35,040 --> 00:16:37,140
حتّى بقيَتْ هي النّاجية الوحيدة

238
00:16:37,600 --> 00:16:41,430
أعتقد بأنّها كانت تعيش مختبئة
...في أعماق أدغال

239
00:16:41,790 --> 00:16:45,940
...انتقلنا من الأسطوريّ إلى الخرافيّ هنا

240
00:16:46,300 --> 00:16:47,940
حسناً، ما هي خطّتنا؟

241
00:16:47,940 --> 00:16:52,690
،جنّية خرافيّة والبطل، البشريّ المُطلَق
في طريقهما لمهاجمتنا

242
00:16:52,690 --> 00:16:55,950
ستكون هذه غالباً فُرصتنا الأخيرة
لتسوية الأمور مع فان

243
00:16:55,950 --> 00:16:59,700
تسوية الأمور؟ لا أعتقد أنّ هذا ممكن

244
00:16:59,970 --> 00:17:02,190
أجل، لا يمكننا تجنُّب معركة

245
00:17:02,630 --> 00:17:05,460
،لكن بخلاف ما كان عليه فان سابقاً
أعتقد سنملك فرصة جيّدة

246
00:17:05,750 --> 00:17:08,210
لكنّنا تكلّمنا للتوّ حول خروجه عن السّيطرة

247
00:17:08,440 --> 00:17:10,870
أجل، خرجَ عن السّيطرة

248
00:17:10,870 --> 00:17:13,310
البطل الّذي لا يتردّد أبداً، مُتردّد الآن

249
00:17:13,840 --> 00:17:16,470
ينبغي لكلماتي أن تؤثّر به بطريقة ما

250
00:17:16,470 --> 00:17:18,970
أستطيع تغيير نظرته المُتطرِّفة

251
00:17:18,970 --> 00:17:21,280
أنا أؤمن بريد

252
00:17:21,280 --> 00:17:23,820
سأدعمه إذا لَزِم الأمر

253
00:17:23,820 --> 00:17:26,710
لذا من فضلكِ دعيه يتولّى هذا

254
00:17:26,710 --> 00:17:28,980
...إن كان هذا رأيكما

255
00:17:29,340 --> 00:17:32,480
حسناً، كيف تنوي أن تتصرّف حيال الأمر؟

256
00:17:33,040 --> 00:17:35,740
سأحسم الأمر بمواجهة فرديّة مع فان

257
00:17:35,740 --> 00:17:37,990
تريد مقاتلة فان وجهاً لوجه؟

258
00:17:37,990 --> 00:17:39,870
هذا جنون

259
00:17:40,200 --> 00:17:43,450
فان قويّ، ولا ضمانات في المعركة

260
00:17:43,450 --> 00:17:46,050
...لذا لا أستطيع الجزم بأنّني سأنتصر، لكن

261
00:17:46,830 --> 00:17:47,870
سأنتصر

262
00:17:51,650 --> 00:17:55,610
سأنصب مجالاً لتقليص الضّرر

263
00:17:55,610 --> 00:17:57,380
هل يستطيع أحد منكم مساعدتي؟

264
00:17:57,800 --> 00:17:59,260
أستطيع

265
00:17:59,560 --> 00:18:01,380
سأساعدك أيضاً

266
00:18:01,380 --> 00:18:04,270
أريد أيضاً من شخص أن يحمي القرية

267
00:18:04,270 --> 00:18:07,260
أوغيغي-سان وأنا سنشرف على الأمر

268
00:18:08,540 --> 00:18:10,830
حسناً، أعتمد عليكم جميعاً

269
00:18:10,830 --> 00:18:12,270
والآن حان وقت اللّمسة الأخيرة

270
00:18:12,800 --> 00:18:14,410
!أجل

271
00:18:22,120 --> 00:18:23,160
،حظّاً سعيداً

272
00:18:25,020 --> 00:18:25,870
يا أخي

273
00:18:30,530 --> 00:18:31,500
شكراً

274
00:18:33,280 --> 00:18:34,640
سأتمكّن أخيراً من مقاتلتك ثانية

275
00:18:35,510 --> 00:18:39,010
أعلم بأنّني أستطيع العودة إلى كوني
بطلاً حالما أقتلك

276
00:18:58,710 --> 00:19:01,570
غيديون، هذا واضح بالنّسبة لي

277
00:19:02,260 --> 00:19:04,580
إنّها البطلة روتي، أليس كذلك؟

278
00:19:05,530 --> 00:19:08,580
هذا هو القدَر الّذي مهّده لي العظيم ديميس

279
00:19:09,120 --> 00:19:13,880
كي أصبح البطل الحقيقيّ، يجب أن أهزم القديم

280
00:19:14,480 --> 00:19:17,420
،بخلافة قوّة البطلة روتي

281
00:19:17,420 --> 00:19:19,880
!البطل فان سينقذ العالم

282
00:19:19,880 --> 00:19:21,540
أنت تبتعد عن الحقيقة

283
00:19:22,640 --> 00:19:25,510
،لم تعُد تعرف ماذا تفعل بعد الآن

284
00:19:25,510 --> 00:19:28,600
لذا تعطي أهمّية لأحداث عشوائيّة حولك بالقوّة

285
00:19:28,600 --> 00:19:30,200
!هذا غير صحيح

286
00:19:30,200 --> 00:19:33,760
أليس كذلك؟ ما الّذي تُمليه عليك برَكة البطل خاصّتك؟

287
00:19:33,760 --> 00:19:35,860
!تخبرني أن أقتل روتي

288
00:19:36,170 --> 00:19:39,360
أنت لا تشعر بذلك الدّافع إطلاقاً، أليس كذلك؟

289
00:19:41,640 --> 00:19:43,700
بدأ هذا فقط بعد أن تكلّمتُ معك

290
00:19:44,380 --> 00:19:46,010
التردُّد مؤلم

291
00:19:46,490 --> 00:19:49,330
أشعر وكأنّني أخسر نفسي

292
00:19:49,330 --> 00:19:52,330
الجميع يشكِّكون بأنفسهم في مرحلة ما من الحياة

293
00:19:52,330 --> 00:19:54,240
البطل لا يتردّد أبداً

294
00:19:54,240 --> 00:19:55,880
!هذا غير مسموح

295
00:19:55,880 --> 00:19:57,420
أنا تردّدت

296
00:19:58,290 --> 00:20:01,790
تردّدتُ مراراً وتكراراً أثناء
مقاتلة جيش ملك الشّياطين

297
00:20:02,360 --> 00:20:04,650
قلقتُ فيما إذا كنتُ أفعل الصّواب

298
00:20:04,650 --> 00:20:08,060
لم أكن متأكّدة فيما إذا كان ينبغي أن أثق
بحكمي وندمتُ على أشياء كثيرة فعلتُها

299
00:20:09,280 --> 00:20:12,000
،بشكلٍ خاصّ، بعد مغادرة أخي الفريق

300
00:20:12,000 --> 00:20:14,530
لم أعد أعرف ما الّذي أؤمن به بعدها

301
00:20:15,040 --> 00:20:18,570
في مرحلة ما، كنتُ أباعد بيني وبين
النّاس الّذين أستطيع الوثوق بهم

302
00:20:19,530 --> 00:20:22,670
ومع ذلك، إنّهم يساعدونني الآن

303
00:20:23,310 --> 00:20:24,570
،بعد كلّ هذا الوقت

304
00:20:25,660 --> 00:20:29,580
أؤمن أخيراً حقّاً بأنّنا أصبحنا فريقاً فعليّاً

305
00:20:29,580 --> 00:20:30,760
!لا أصدّقكِ

306
00:20:30,760 --> 00:20:32,250
!البطل لا يتردّد أبداً

307
00:20:32,250 --> 00:20:34,580
!هذا هو الدّور المُخصَّص بواسطة العظيم

308
00:20:34,580 --> 00:20:36,080
!كفَّ عن الهرب يا فان

309
00:20:37,210 --> 00:20:39,370
،إذا أردتَ أن تكون البطل فعلاً

310
00:20:39,370 --> 00:20:41,550
فكُفّ عن الهرب من الشُّكوك الّتي لديك

311
00:20:41,550 --> 00:20:43,470
استجمع الشّجاعة لمواجهتها

312
00:20:43,470 --> 00:20:44,600
شجاعة؟

313
00:20:44,600 --> 00:20:45,650
أجل

314
00:20:45,650 --> 00:20:47,540
،مهما أمست الأمور مؤلمة

315
00:20:47,540 --> 00:20:49,730
اثبت مكانك واسلك الدّرب الّذي اخترتَه

316
00:20:49,730 --> 00:20:51,470
هذا ما يُدعى بالشّجاعة

317
00:20:51,920 --> 00:20:54,990
البطل منيع أمام الخوف

318
00:20:54,990 --> 00:20:56,860
أليس هذا جيّداً بما يكفي؟

319
00:20:56,860 --> 00:21:00,230
بصِفتي الدّليل، اسمح لي أن أدلّك على الطّريق

320
00:21:03,030 --> 00:21:05,440
قاتلني. أمسِك بهذا السّيف

321
00:21:06,110 --> 00:21:07,730
سيف برونزيّ؟

322
00:21:07,730 --> 00:21:10,720
هذه معركة بين البطل والدّليل

323
00:21:10,720 --> 00:21:13,120
حاول أن تتفوّق عليّ يا فان

324
00:21:13,120 --> 00:21:15,740
ينبغي لهذا أن يبدّد شكوكك

325
00:21:21,260 --> 00:21:22,460
فهمت

326
00:21:23,280 --> 00:21:25,380
!لا تدعه يخدعك يا فان

327
00:21:25,380 --> 00:21:27,000
تراجعي يا لافيندر

328
00:21:27,000 --> 00:21:29,070
!تراجعي أنتِ! سأقتلكِ

329
00:21:29,070 --> 00:21:32,140
لا يحقُّ لنا أن نوقفهما

330
00:21:32,140 --> 00:21:33,910
!أغلقي فمكِ

331
00:21:33,910 --> 00:21:38,400
أيّ شخص يعترض طريقَ حبّي
!يستحقُّ أن يموت موتاً بائساً

332
00:21:38,650 --> 00:21:41,570
!وأنا لن أدع أحداً يعبث بحبّي

333
00:21:41,570 --> 00:21:45,400
سواء كان جنّياً خرافيّاً أو البطل
أو حتّى العظيم بنفسه

334
00:21:45,400 --> 00:21:49,410
!إذا تدخّلتِ، فسأقتلكِ

335
00:21:51,240 --> 00:21:54,960
،سنوقف سيوفنا في اللّحظة الأخيرة
...والخاسر سيعترف بالهزيمة

336
00:21:54,960 --> 00:21:58,210
آمل حقّاً ألّا تعتقد بأنّ الأمور ستجري هكذا

337
00:21:58,440 --> 00:22:02,960
بالطّبع لا. فسنتقاتل حتّى يسقط أحدُنا

338
00:22:02,960 --> 00:22:04,710
!ممتاز

339
00:22:04,710 --> 00:22:08,940
لأنّني لا أستطيع التوقُّف حتّى
!أصبّ كلّ هذا الغضب عليك