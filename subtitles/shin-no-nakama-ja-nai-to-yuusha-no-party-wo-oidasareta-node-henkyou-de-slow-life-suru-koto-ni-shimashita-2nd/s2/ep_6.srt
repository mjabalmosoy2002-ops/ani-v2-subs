1
00:00:01,610 --> 00:00:04,900
،الآن بعد أن اجتمعنا كلُّنا هنا
لنراجع الأمر مرّة أخرى

2
00:00:05,440 --> 00:00:09,690
آلبيرت، هل اعترفَت الكنيسةُ
بفان كبطل رسميّاً؟

3
00:00:10,110 --> 00:00:15,660
أجل. تمّ تقييم برَكته، والكاردينال
لوبو قد عُيِّن مسؤولاً عنه

4
00:00:15,860 --> 00:00:19,230
سيعمل كبطل للكنيسة

5
00:00:19,680 --> 00:00:21,660
...بطل الكنيسة

6
00:00:21,920 --> 00:00:22,830
ريد؟

7
00:00:23,460 --> 00:00:26,960
أنا متأكّدٌ بأنّه بطلٌ فعلاً
بما أنّ الكنيسة تقول ذلك

8
00:00:27,580 --> 00:00:30,960
لكن لا أفهم لماذا لم يظهر حتّى الآن

9
00:00:30,960 --> 00:00:31,920
صحيح

10
00:00:32,290 --> 00:00:37,280
على ذكر الكنيسة، هل تتذكّرون عندما
زرنا حصن السّور الأخير العظيم؟

11
00:00:37,280 --> 00:00:40,680
هناك حيث التقينا تيودورا. يعيدني ذلك للذّكريات

12
00:00:40,920 --> 00:00:43,770
كان ذلك قبل أن أنضمّ للفريق، صحيح؟

13
00:00:43,770 --> 00:00:47,560
هل تعتقدون بأنّ الكنيسة كانت
مُدرِكة بوجود فان آنذاك؟

14
00:00:48,010 --> 00:00:51,520
وجود بطلين في آن واحد أمرٌ غير طبيعيّ

15
00:00:51,520 --> 00:00:53,740
لو كانوا يعلمون، لفعلوا شيئاً ما

16
00:00:54,750 --> 00:00:56,450
لكن لم يفعلوا شيئاً إطلاقاً

17
00:00:56,930 --> 00:00:59,700
من المنطقيّ أكثر أن نفترض أنّهم
لم يكونوا يعلمون

18
00:01:03,000 --> 00:01:06,460
لا جدوى من التّفكير في كلّ ذلك

19
00:01:06,460 --> 00:01:11,170
المُشكلة هي أنّ هذا الفتى فان
في طريقه إلى زولتان، صحيح؟

20
00:02:44,480 --> 00:02:48,020
كم تعرف  الكنيسة عن روتي؟

21
00:02:48,430 --> 00:02:50,380
لا شيء، حسبما سمعت

22
00:02:50,880 --> 00:02:55,360
عجباً، لم يسمعوا شيئاً عن حملة البطل أساساً

23
00:02:56,160 --> 00:02:58,750
حسناً، كنّا نحرص على ألّا يعلموا

24
00:02:59,280 --> 00:03:03,920
،لكن روتي قضَتْ على اثنين من القادة
بينما هزمَتْ تيودورا واحداً آخر

25
00:03:03,920 --> 00:03:07,180
بسبب ذلك، الحرب مع جيش ملك
الشّياطين في طريق مسدود

26
00:03:07,180 --> 00:03:10,290
من الآمن القول بأنّ أفالون آمنة
ثانية إلى حدٍّ ما

27
00:03:11,030 --> 00:03:14,600
لا ينبغي لغياب روتي أن يسبّب مشكلة كبيرة

28
00:03:15,570 --> 00:03:19,800
لكن ظهور بطل جديد يغيّر الأمور

29
00:03:20,310 --> 00:03:23,780
إذا عَلِمَ بأنّ البطلة روتي
،مضَتْ بعيداً عن المعركة

30
00:03:23,780 --> 00:03:25,420
لن يروقه ذلك الأمر كثيراً

31
00:03:26,730 --> 00:03:29,520
هل من طريقة لمنعهم من الاجتماع؟

32
00:03:29,520 --> 00:03:30,810
ربّما بتجربة تنكُّر؟

33
00:03:31,280 --> 00:03:33,230
ستكشف نفسها فحسب

34
00:03:33,230 --> 00:03:35,210
مولاتي روتي مُلفِتة كثيراً للأنظار

35
00:03:36,770 --> 00:03:41,910
فان قادم إلى هنا لأخذ السّفينة الجويّة
لملك الشّياطين السّابق، صحيح؟

36
00:03:41,910 --> 00:03:47,020
في هذه الحالة، ما رأيكم أنتم
الثّلاثة أن تغادروا زولتان لبعض الوقت؟

37
00:03:48,350 --> 00:03:51,500
أنصح بالذّهاب إلى وجهة سياحيّة

38
00:03:51,500 --> 00:03:54,250
يمكنكم ترك مزرعة الأعشاب على عاتقي

39
00:03:54,250 --> 00:03:56,000
!وأنا سأدير المحلّ

40
00:03:56,230 --> 00:03:57,980
!اذهبوا واسترخوا لبعض الوقت

41
00:03:57,980 --> 00:03:59,760
تبدو فكرة سديدة

42
00:04:00,300 --> 00:04:01,150
أجل

43
00:04:01,150 --> 00:04:03,260
سأكون الرّسولة

44
00:04:03,680 --> 00:04:06,220
سأبقى في زولتان تحسُّباً لأي طارئ أيضاً

45
00:04:06,560 --> 00:04:09,040
ألن يكون من السيّئ أن تلتقي بالكاردينال؟

46
00:04:09,040 --> 00:04:11,130
لا شأن لي معه أيضاً

47
00:04:11,130 --> 00:04:14,170
لكن ينتابني إحساس سيّئ حقّاً
حيال هذا الوضع

48
00:04:15,320 --> 00:04:20,940
وحتّى لو التقيتُ به، يمكنني القول
،بأنّني طُرِدتُ من فريق البطل

49
00:04:22,310 --> 00:04:24,150
ولديّ سبب وجيه هنا

50
00:04:24,710 --> 00:04:28,410
دانان، أنت أقوى الآن ممّا
كنتَ عليه بذراعين

51
00:04:28,650 --> 00:04:29,390
ماذا؟

52
00:04:31,830 --> 00:04:32,530
بالفعل

53
00:04:32,530 --> 00:04:33,040
هل أنت جادّ؟

54
00:04:33,040 --> 00:04:33,710
ربّما

55
00:04:33,710 --> 00:04:34,820
!حقّاً؟

56
00:04:39,740 --> 00:04:42,010
!يا له من مكان مُسالِم

57
00:04:42,730 --> 00:04:44,530
قرية القدّيس دورانت

58
00:04:44,530 --> 00:04:48,310
دورانت هو اسم البطل الّذي أنقذ
هذه القرية من الدّمار

59
00:04:48,310 --> 00:04:51,600
كان لديهم بطل تألّق في ساحة المعركة أيضاً؟

60
00:04:51,600 --> 00:04:54,990
لا، كان حطّاباً، وقويّاً

61
00:04:54,990 --> 00:04:56,020
...حطّاب

62
00:04:56,720 --> 00:04:58,400
،عندما شنّ قطيعٌ من عمالقة التلّة هجوماً

63
00:04:58,660 --> 00:05:01,170
خسِرَ السكّان الأوّلون لهذه المنطقة كلّ شيء

64
00:05:01,170 --> 00:05:05,440
وبنى منازلَ لهم جميعاً بين ليلة
وضُحاها واعتُبِرَ مُنقِذاً

65
00:05:05,440 --> 00:05:08,370
ماذا؟ هذا لا يُصدَّق

66
00:05:12,270 --> 00:05:14,450
إذاً هذا هو دورانت البطل

67
00:05:15,040 --> 00:05:16,500
"دورانت البطل"

68
00:05:16,950 --> 00:05:21,020
الكثير من الأبطال قتلوا قرناً"
"،من الخصوم في الماضي وفي الحاضر

69
00:05:21,020 --> 00:05:24,580
لكن بطل واحد فقط بنى قرناً"
"من البيوت في ليلة واحدة

70
00:05:25,040 --> 00:05:27,190
"وها هو يقوم بتقطيع شجرة كبيرة"

71
00:05:27,190 --> 00:05:29,950
"انظروا إلى عضلات صدره المُبهرة"

72
00:05:36,380 --> 00:05:37,400
أنا متحمّسة

73
00:05:42,850 --> 00:05:44,460
هذا مثيرٌ للاهتمام

74
00:05:44,460 --> 00:05:47,540
سمعتُ أنّ كثيراً من النُّبلاء
،والتُّجار يزورون هذا المكان

75
00:05:47,540 --> 00:05:49,620
ما يجعله مركزاً تجاريّاً ضخماً

76
00:05:49,620 --> 00:05:52,510
هذه الأدوات هي للعرض فقط

77
00:05:52,510 --> 00:05:53,490
...المعذرة

78
00:05:54,080 --> 00:05:55,470
أتريدان شراء شيء؟

79
00:05:55,470 --> 00:05:56,380
!بالتّأكيد

80
00:05:58,190 --> 00:06:01,030
تفضّلوا مفتاحكم

81
00:06:01,030 --> 00:06:01,880
شكراً

82
00:06:02,440 --> 00:06:04,740
استمتعوا بإقامتكم

83
00:06:04,740 --> 00:06:06,070
!لندخل

84
00:06:06,070 --> 00:06:06,880
أجل

85
00:06:10,760 --> 00:06:12,480
!يبدو هذا رائعاً

86
00:06:12,480 --> 00:06:13,970
تُعجبني الأجواء

87
00:06:24,070 --> 00:06:27,420
لا بدّ أنّ مولاتي روي قد وصلت
إلى المكان الآن

88
00:06:28,660 --> 00:06:32,800
،حالما ينتهي هذا الأمر برمّته
لِمَ لا نخرج في رحلة قصيرة؟

89
00:06:41,340 --> 00:06:42,540
جميلة

90
00:06:42,540 --> 00:06:45,990
لا بدّ أنّهم مزجوا شيئاً معها
للقيام بهذا. رائع

91
00:06:45,990 --> 00:06:48,990
هل نشتري المزيد في طريق
العودة إلى المنزل؟

92
00:06:48,990 --> 00:06:52,430
أجل، أريد من تيسّي وياراندرالا أن تريا هذا

93
00:06:52,430 --> 00:06:54,450
أوغيغي-سان سيُعجبه هذا أيضاً

94
00:07:04,860 --> 00:07:06,940
...البطل فان

95
00:07:07,600 --> 00:07:09,950
ينبغي أن يصل إلى زولتان قريباً

96
00:07:10,560 --> 00:07:12,730
آمل أن يغادر بسرعة

97
00:07:14,000 --> 00:07:17,110
أعلم إلى أي درجة سيّئة يمكن أن يتحفّز البطل

98
00:07:17,670 --> 00:07:19,960
،حتّى لو أراد البقاء لبعض الوقت

99
00:07:20,230 --> 00:07:22,700
برَكة البطل خاصّته لن تسمح له

100
00:07:27,940 --> 00:07:30,370
يجدر بنا أن نستمتع بهذه اللّحظة حاليّاً

101
00:07:33,620 --> 00:07:34,970
معكِ حقّ

102
00:07:36,920 --> 00:07:39,440
ما رأيكما أن أعدّ بعض الحليب والعسل؟

103
00:07:39,440 --> 00:07:40,460
!مرحى

104
00:07:55,420 --> 00:07:57,740
!كان الطّعام هناك رائعاً

105
00:07:58,090 --> 00:08:00,960
كان ذلك الشّيء الورقيّ الغريب
حُلواً بصورة مفاجئة

106
00:08:00,960 --> 00:08:02,650
كان يُدعى بورق الأفعى الثّملة

107
00:08:02,650 --> 00:08:05,920
يُستخدَم عادةً لمعالجة عسر الهضم

108
00:08:05,920 --> 00:08:08,250
أعتقد ينمو في هذه الأرجاء

109
00:08:08,660 --> 00:08:10,010
...مؤلم

110
00:08:10,010 --> 00:08:10,880
!يا إلهي

111
00:08:11,500 --> 00:08:12,670
هل أنتِ بخير؟

112
00:08:12,670 --> 00:08:13,750
...نعم

113
00:08:13,750 --> 00:08:15,520
...مؤلم

114
00:08:15,520 --> 00:08:16,850
لنأخذها إلى كوخنا

115
00:08:16,850 --> 00:08:17,400
!حسناً

116
00:08:17,400 --> 00:08:17,990
نعم

117
00:08:20,850 --> 00:08:23,890
كيت. هذا المكان يؤلمكِ، صحيح؟

118
00:08:24,340 --> 00:08:25,190
أجل

119
00:08:26,400 --> 00:08:28,050
من طبيب القرية؟

120
00:08:28,050 --> 00:08:29,440
ليس لدينا طبيب

121
00:08:30,980 --> 00:08:33,650
لستُ كذلك أيضاً، لكن أدير صيدليّة

122
00:08:33,650 --> 00:08:35,610
لذا أعرف بعض الأمور عن الأمراض والجروح

123
00:08:36,290 --> 00:08:38,630
هل يمكنكِ الإجابة عن بضعة أسئلة؟

124
00:08:38,630 --> 00:08:39,620
حسناً

125
00:08:40,170 --> 00:08:43,660
هل تعرّضتِ لأي شيء غير عاديّ مؤخّراً؟

126
00:08:43,660 --> 00:08:45,230
...لا، ليس تماماً

127
00:08:45,680 --> 00:08:49,630
جرحتُ ساقي قبل أيّام قليلة

128
00:08:49,910 --> 00:08:50,960
أتقولين ساقكِ؟

129
00:08:50,960 --> 00:08:53,230
أجل، حدث ذلك أثناء العمل

130
00:08:53,230 --> 00:08:55,440
كنتُ مستهترة قليلاً

131
00:08:55,440 --> 00:08:57,390
متى بدأت أطرافكِ بالارتجاف؟

132
00:08:57,610 --> 00:08:58,240
ماذا؟

133
00:08:59,120 --> 00:09:02,370
...أعتقد كانت كذلك منذ مدّة

134
00:09:02,370 --> 00:09:04,130
هل اكتشفتَ شيئاً؟

135
00:09:04,130 --> 00:09:07,400
،غالباً تعرّضَتْ لسُمٍّ عندما جُرِحت
فانتشر إلى أنحاء جسدها

136
00:09:07,400 --> 00:09:08,590
!ماذا؟

137
00:09:08,590 --> 00:09:11,020
،يمكن للسّحر أن يقمع الألم

138
00:09:11,020 --> 00:09:13,500
لكن لا يمكنه إزالة السُّموم

139
00:09:17,130 --> 00:09:18,570
ماذا فعل؟

140
00:09:19,530 --> 00:09:22,230
ريد، هل يمكن للأدوية معالجة هذا؟

141
00:09:23,150 --> 00:09:26,920
أجل. سوف أصنع شيئاً بالأعشاب الّتي لديّ

142
00:09:27,280 --> 00:09:29,000
هل هذا مناسب؟

143
00:09:29,000 --> 00:09:30,920
!بالطّبع! من فضلك

144
00:09:31,320 --> 00:09:34,520
سيستغرق ذلك بعض الوقت
بمهارة الخلط خاصّتي

145
00:09:34,520 --> 00:09:35,170
روتي

146
00:09:35,580 --> 00:09:40,200
في هذه الأثناء، هل يمكنكِ الذّهاب
لإحضار عشبة تنقصني؟

147
00:09:40,200 --> 00:09:42,430
أجل. ماذا ينبغي أن أحضر؟

148
00:09:42,700 --> 00:09:45,180
ورقة الأفعى الثّملة. الّتي أكلناها قبل مدّة

149
00:09:45,840 --> 00:09:49,640
ينبغي للطبّاخ أن يخبركِ عن مكان نموّها

150
00:09:49,640 --> 00:09:54,600
إذا حصلتُ عليها، ينبغي أن أتمكّن
من تقليد تأثيرات الدّواء الفعليّ

151
00:09:54,600 --> 00:09:55,650
عُلِم

152
00:09:57,280 --> 00:09:59,460
ريت، اعتني بكيت

153
00:09:59,920 --> 00:10:02,680
استخدمي سحركِ لتخفّفي لها ألمها

154
00:10:02,680 --> 00:10:03,350
!عُلِم

155
00:10:34,870 --> 00:10:36,310
أهلاً بعودتكِ يا روتي

156
00:10:37,450 --> 00:10:38,970
!ماذا حدث لكِ؟

157
00:10:38,970 --> 00:10:41,200
لا شيء. سقطتُ في وادٍ فحسب

158
00:10:42,480 --> 00:10:44,230
تفضّل يا أخي

159
00:10:44,230 --> 00:10:45,580
شكراً يا روتي

160
00:10:46,140 --> 00:10:48,070
يمكنني استكمال الدّواء الآن

161
00:10:51,390 --> 00:10:53,640
!حسناً، سأستدعي شخصاً كي يأخذها

162
00:10:52,390 --> 00:10:53,640
...ماذا؟

163
00:11:09,000 --> 00:11:13,210
ينبغي أن تكوني بخير الآن، لكن استمرّي
في تناول الدّواء لبعض الوقت

164
00:11:13,210 --> 00:11:15,900
!شكراً جزيلاً لك على معالجتي

165
00:11:21,670 --> 00:11:23,600
ما خطب هؤلاء النّاس؟

166
00:11:24,070 --> 00:11:28,870
تجوّلتُ وأنا أسأل عن عنوان منزل
كيت، فلحِقَ بي الجميع

167
00:11:29,170 --> 00:11:31,570
!شكراً على إنقاذ كيت

168
00:11:31,570 --> 00:11:35,350
!هذه هي وصفة القرية السرّية
!جرّبوها يوماً ما

169
00:11:35,350 --> 00:11:36,690
!خذوا هذه أيضاً

170
00:11:36,690 --> 00:11:37,880
!وهذه

171
00:11:37,880 --> 00:11:40,380
هيّا، هيّا. لا داعي للخجل

172
00:11:40,870 --> 00:11:42,420
شكراً جزيلاً لكم

173
00:11:47,200 --> 00:11:48,770
تعِبت

174
00:11:49,460 --> 00:11:51,290
...كيف حالُ ريد

175
00:12:07,600 --> 00:12:08,780
!العشاء جاهز

176
00:12:08,780 --> 00:12:10,160
!مرحى

177
00:12:11,360 --> 00:12:13,760
حسناًن ما هذا؟

178
00:12:13,760 --> 00:12:15,910
طبق يُدعى كاري

179
00:12:15,910 --> 00:12:18,800
طبق تقليديّ يعود أصله إلى موطن
دورانت على ما يبدو

180
00:12:18,800 --> 00:12:22,420
تلك الوصفة الّتي حصلتَ عليها للتو؟
...إنّها ذات لون مذهل

181
00:12:22,420 --> 00:12:23,690
استنشاق، استنشاق

182
00:12:23,690 --> 00:12:25,430
تفوح منه رائحة لاذعة أيضاً

183
00:12:25,740 --> 00:12:26,430
...لذا

184
00:12:26,960 --> 00:12:29,420
ما هذا الزيّ؟

185
00:12:29,420 --> 00:12:30,310
ماذا؟

186
00:12:30,310 --> 00:12:31,810
نحن في إجازة

187
00:12:32,080 --> 00:12:35,060
فضلاً عن ذلك، الأرض هنا دافئة ومُريحة

188
00:12:35,710 --> 00:12:40,430
سمعتُ بأنّ هذه المنطقة هنا
كانت جيوحراريّة. هذا هو السّبب غالباً

189
00:12:41,380 --> 00:12:42,070
...و

190
00:12:42,830 --> 00:12:43,890
ما خطبك يا روتي؟

191
00:12:44,480 --> 00:12:45,670
نسيتُ زيّ سباحتي

192
00:12:45,670 --> 00:12:46,800
!هذا ليس مُبرِّراً

193
00:12:50,010 --> 00:12:52,670
أيّاً يكن. لنأكل

194
00:12:52,670 --> 00:12:53,480
!أجل

195
00:12:58,890 --> 00:13:02,530
التّوابل الحارّة ظاهرة. هذا رائع

196
00:13:02,530 --> 00:13:05,470
تتماشى جيّداً مع الخبز الطّازج
أيضاً. يروقني هذا

197
00:13:05,840 --> 00:13:09,890
لكن عجباً! لم نسمع أي نبأ

198
00:13:09,890 --> 00:13:12,400
أشعر بالقلق وأنا مسترخية هكذا

199
00:13:12,400 --> 00:13:14,980
وجودنا هناك سوف يُعقّد الأمور

200
00:13:15,650 --> 00:13:17,450
لنثِق بالآخرين وننتظر

201
00:13:21,140 --> 00:13:22,190
طبقٌ ثانٍ

202
00:13:30,880 --> 00:13:31,540
مرحباً

203
00:13:32,150 --> 00:13:32,830
دانان

204
00:13:33,360 --> 00:13:34,750
كيف تسير الأمور؟

205
00:13:34,750 --> 00:13:36,940
لم يأتوا إلى هنا بعد

206
00:13:36,940 --> 00:13:37,790
هكذا إذاً

207
00:13:39,930 --> 00:13:41,920
تفضّل، أحضرتُ هدايا

208
00:13:41,920 --> 00:13:43,630
!شكراً لك

209
00:13:44,320 --> 00:13:45,880
مذهل

210
00:13:45,880 --> 00:13:47,690
يبدو هذا لذيذاً

211
00:13:47,690 --> 00:13:49,420
أنا من أعددتُها

212
00:13:52,600 --> 00:13:53,800
أنت؟

213
00:13:54,350 --> 00:13:55,360
ألن تأكل؟

214
00:13:56,710 --> 00:13:57,850
...في الواقع

215
00:14:05,170 --> 00:14:08,010
لم أتوقّع أن يكون بهذه اللذّة

216
00:14:08,010 --> 00:14:08,920
ماذا؟

217
00:14:08,920 --> 00:14:10,570
!أعتذر

218
00:14:10,970 --> 00:14:12,050
آلبيرت

219
00:14:12,050 --> 00:14:13,080
!بئساً

220
00:14:13,420 --> 00:14:16,580
!أعتقد لم أعبّر عن شعوري جيّداً

221
00:14:20,560 --> 00:14:23,040
أنا مَدين لك بحياتي. شكراً

222
00:14:26,420 --> 00:14:28,300
!د... دانان

223
00:14:28,830 --> 00:14:30,530
!أظنّنا سنكون صديقين حميمين

224
00:14:30,530 --> 00:14:31,430
!أجل

225
00:14:31,430 --> 00:14:32,450
!هيّا، كُل

226
00:14:32,450 --> 00:14:33,330
!سأفعل

227
00:14:38,090 --> 00:14:39,810
هذه هي زولتان إذاً

228
00:14:40,050 --> 00:14:41,720
وصلنا أخيراً يا فان

229
00:14:41,720 --> 00:14:42,310
!أجل

230
00:14:43,640 --> 00:14:46,100
يا له من ميناء سيّئ

231
00:14:46,100 --> 00:14:48,310
لا يتّسع حتّى للقارب الضّئيل

232
00:14:50,370 --> 00:14:51,830
هل من مُشكلة؟

233
00:14:51,830 --> 00:14:56,130
تذكّرتُ للتو صديقاً سابقاً لي
يقول نفس الكلام في الماضي

234
00:14:56,130 --> 00:14:59,860
هل كان بطلاً أيضاً؟ أتمنّى أن ألتقي به

235
00:15:00,360 --> 00:15:03,000
يؤسفني القول أنّ الفُرَص ضئيلة

236
00:15:03,310 --> 00:15:04,620
معك حقّ

237
00:15:04,620 --> 00:15:07,640
هدفنا هو إنقاذ العالم

238
00:15:07,640 --> 00:15:10,010
لا يجوز أن نهدر الوقت، أليس كذلك؟

239
00:15:10,010 --> 00:15:11,420
تماماً

240
00:15:14,580 --> 00:15:16,260
ذاك هو فان البطل؟

241
00:15:17,090 --> 00:15:19,280
إنّه مختلف عن مولاتي روتي

242
00:15:24,720 --> 00:15:26,690
ألم يصل دليلُنا إلى هنا بعد؟

243
00:15:27,160 --> 00:15:32,630
لا بدّ أنّه ورّطَ نفسه بصفقة مشبوهة
ما فأدّى ذلك إلى مقتله

244
00:15:36,280 --> 00:15:38,660
ما رأيك أن نبحث عنه بأنفسنا؟

245
00:15:38,960 --> 00:15:40,660
سيخيّم الظّلام قريباً

246
00:15:40,660 --> 00:15:44,020
يمكننا مناقشة خطّة العمل في النُّزُل

247
00:15:49,360 --> 00:15:50,420
انتهيت

248
00:15:50,650 --> 00:15:51,930
!مذهل

249
00:15:52,380 --> 00:15:54,190
الأستاذ الكبير وايفرن دائماً ما يفوز

250
00:15:55,500 --> 00:15:56,860
جاء صديق

251
00:15:56,860 --> 00:15:58,060
صديق؟

252
00:16:01,630 --> 00:16:03,660
لم أتوقّع أن يزورنا أوغيغي-سان

253
00:16:03,660 --> 00:16:05,610
يستطيع هذا العنكبوت فعل كلّ شيء

254
00:16:06,120 --> 00:16:08,080
هذا هو أوغيغي-سان الّذي عهِدناه

255
00:16:08,080 --> 00:16:10,270
يبدو أنّ فان البطل قد وصل

256
00:16:10,770 --> 00:16:13,080
لا مشاكل حقيقيّة بعد

257
00:16:13,080 --> 00:16:14,040
هكذا إذاً

258
00:16:16,490 --> 00:16:19,950
ماذا؟ تريد أن لعب سباق وايفرن
أيضاً يا أوغيغي-سان؟

259
00:16:21,380 --> 00:16:24,000
يستطيع فعل كلّ شيء حقّاً

260
00:16:33,090 --> 00:16:34,520
اسمي تيسّي

261
00:16:34,920 --> 00:16:36,860
،عضوة في نقابة المغتالين

262
00:16:36,860 --> 00:16:39,650
ومغتالة تسلّلَتْ بصورة خبيثة
كخادمة في هذه الأمسية

263
00:16:39,650 --> 00:16:41,390
مرحباً

264
00:16:41,620 --> 00:16:45,400
اسمي تورنيد، المُحافِظ. شرف
لي أن ألتقيكم

265
00:16:48,690 --> 00:16:49,970
...المعذرة

266
00:16:50,740 --> 00:16:54,290
مع الأسف، البطل مُرهَق بسبب رحلته

267
00:16:54,290 --> 00:16:55,910
بـ-بالطّبع

268
00:16:55,910 --> 00:16:59,180
المعذرة. سأعود لاحقاً

269
00:17:01,000 --> 00:17:03,940
فان، لا أؤيّد سلوكك

270
00:17:04,730 --> 00:17:07,980
،إذا كنتَ غاضباً بشأن السّفينة الجويّة
فلديّ فكرة

271
00:17:07,980 --> 00:17:09,380
ابتهج

272
00:17:10,400 --> 00:17:12,700
—سيّد بطل، هذا طبق خاصّ بالطبّاخ

273
00:17:12,700 --> 00:17:14,840
!لا يحتاج بطلٌ للطّعام

274
00:17:17,010 --> 00:17:18,760
!أعتذر من أعماق قلبي

275
00:17:26,160 --> 00:17:27,520
يجب أن نتكلّم. في الخارج

276
00:17:27,810 --> 00:17:32,030
فكرة ممتازة. أردتُ الخروج أساساً

277
00:17:40,420 --> 00:17:42,800
لن أطلب منك أن تكون لطيفاً

278
00:17:42,800 --> 00:17:46,160
لكن هلّا حاولت أن تخفي امتعاضك
قليلاً على الأقلّ؟

279
00:17:46,640 --> 00:17:48,170
إذاً، نفعل هذا من جديد

280
00:17:48,670 --> 00:17:51,920
هل تستمتع بإلحاحي؟

281
00:17:52,400 --> 00:17:53,910
!بالطّبع

282
00:17:53,910 --> 00:17:56,110
ما زلتُ غير خبير كبطل

283
00:17:56,110 --> 00:17:59,680
التكلّم مع شخص ببرَكة رفيعة المستوى
مثلك هو تجربة تعلُّم عظيمة

284
00:18:00,040 --> 00:18:04,030
!يقول ذلك وكأنّه تعلّم شيئاً أصلاً

285
00:18:04,860 --> 00:18:07,390
ينبغي أن تحترم النّاس ومشاعرهم

286
00:18:07,390 --> 00:18:11,690
نظّموا هذه الحفلة للاحتفال بوصولك

287
00:18:12,060 --> 00:18:15,440
لكن لماذا يفعلون ذلك؟

288
00:18:15,770 --> 00:18:16,950
لماذا"؟"

289
00:18:17,380 --> 00:18:19,130
ألا يمكنك أن تستوعب رغبتهم

290
00:18:19,130 --> 00:18:22,450
في  التّعبير عن إعجابهم وامتنانهم للبطل؟

291
00:18:22,870 --> 00:18:27,560
البطل ينقذ النّاسَ لأنّها مشيئة العظيم

292
00:18:27,560 --> 00:18:30,460
لا حاجة للإعجاب أو الامتنان

293
00:18:30,700 --> 00:18:34,760
،قد ترى الأمر من هذه النّاحية
لكن ليس الجميع يرونه كذلك

294
00:18:34,760 --> 00:18:39,870
وأيضاً، البطل هو رمز شجاعة يمنح
النّاسَ إرادة محاربة الشرّ

295
00:18:39,870 --> 00:18:43,680
سيحين وقتٌ تحتاج فيه لقيادتهم
،في ساحة المعركة

296
00:18:43,680 --> 00:18:47,730
لذا من المهمّ فهم مشاعرهم واحترامها

297
00:18:48,560 --> 00:18:49,630
صحيح

298
00:18:49,630 --> 00:18:53,060
مدّ النّاس بشجاعة القتال هو
من واجبات البطل

299
00:18:53,560 --> 00:18:56,730
عندما يصل البطل، يجب على الجمع
...أن يزحف نحو أرض المعركة

300
00:18:57,270 --> 00:18:58,850
ويموت

301
00:19:01,200 --> 00:19:01,940
ماذا؟

302
00:19:02,890 --> 00:19:05,090
هذا ما يرغبه العظيم

303
00:19:05,090 --> 00:19:09,310
لذا من الطبيعيّ أن يقاتلوا بشجاعة
ويفقدون حياتهم نتيجة ذلك

304
00:19:09,930 --> 00:19:15,010
ما يهمّ ليس الإعجاب أو الامتنان، لكن
الإيمان بالعظيم ديميس وحده

305
00:19:16,880 --> 00:19:23,500
ستطلب من النّاس أن يقاتلوا
بجانبك كي يموتوا ببساطة؟

306
00:19:24,460 --> 00:19:26,590
ولن يراودك أي شعور؟

307
00:19:27,340 --> 00:19:30,240
هذا صحيح. الشّهادة تعبير عن الإيمان

308
00:19:30,240 --> 00:19:31,770
العواطف تُفسِد ذلك فحسب

309
00:19:32,230 --> 00:19:34,780
!هذا هو فان الّذي أعرفه! يا لك من رجل

310
00:19:37,040 --> 00:19:39,940
سنغادر غداً

311
00:19:41,040 --> 00:19:43,790
يمكن لسكّان زولتان أن يحقّقوا بشأن السّفينة

312
00:19:43,790 --> 00:19:48,050
في هذه الأثناء، سوف نفعل
ما يمكننا فعله فقط

313
00:19:48,050 --> 00:19:49,450
ماذا سنفعل؟

314
00:19:49,800 --> 00:19:51,750
،سوف نرجع للوراء قليلاً

315
00:19:51,750 --> 00:19:54,430
لكن هناك جزيرة مسكونة بواسطة تنّين سولت

316
00:19:54,430 --> 00:19:56,420
سوف نُبيده

317
00:19:56,690 --> 00:19:58,170
تنّين سولت؟

318
00:19:58,170 --> 00:20:00,820
تنّين الرّكود والدّمار

319
00:20:00,820 --> 00:20:02,800
!إذاً إنّه عدوّ البطل؟

320
00:20:03,120 --> 00:20:06,630
تنانين سولت لا تُهاجم النّاس
إذا ظلّوا بعيدين عنها

321
00:20:06,630 --> 00:20:09,200
ووجودها لا يشكّل أي آثار سلبيّة أيضاً

322
00:20:09,200 --> 00:20:11,680
هل هناك حاجة لإبادته حقّاً؟

323
00:20:11,940 --> 00:20:15,830
إنّه وقود مثاليّ لتعزيز مستوى برَكة فان

324
00:20:15,830 --> 00:20:22,200
وأيضاً، تُفيد الإشاعات بأنّ تنّين سولت
يمتلك كنزاً لملك الجنّيات الّذي سرقَه

325
00:20:22,780 --> 00:20:24,520
لن يضرّنا امتلاكه

326
00:20:24,520 --> 00:20:25,240
...لكن

327
00:20:25,240 --> 00:20:26,480
!لا مشكلة

328
00:20:26,480 --> 00:20:29,840
إنَّ قتل الوحوش وأخذ كنوزهم صحيح أخلاقيّاً

329
00:20:29,840 --> 00:20:32,210
!هذا ما ورد في كُتُب الكنيسة المُقدّسة

330
00:20:32,570 --> 00:20:36,460
،إذا شكّلت عداوات كثيرة لنفسك
سوف تندم على ذلك

331
00:20:36,810 --> 00:20:39,460
من واجب البطل أن يقضي على كلّ كائن شرّير

332
00:20:39,920 --> 00:20:43,530
وبالتّالي، سأكون دوماً عدوّاً
لكلّ الشُّرور في هذا العالم

333
00:20:45,330 --> 00:20:48,220
لنعُد إلى الدّاخل قبل أن يبرد الطّعام

334
00:20:48,220 --> 00:20:51,740
سمعتُ أنّ الطّعام البحريّ
يتماشى جيّداً مع مشروب زولتان

335
00:20:51,740 --> 00:20:53,140
سأعود إلى النُّزُل

336
00:20:53,430 --> 00:20:58,110
.صنعَ العظيم خمراً كي يستمتع به أتباعه
يجب عليك ألّا ترفض

337
00:20:59,520 --> 00:21:00,590
...فهمت. في هذه الحالة

338
00:21:00,590 --> 00:21:03,110
حسناً. أيّاً يكن

339
00:21:12,220 --> 00:21:15,280
هل أتيتُم لسرقة كنزنا؟

340
00:21:15,280 --> 00:21:18,500
!أيُّها اللّصوص القذِرون الوقِحون

341
00:21:22,750 --> 00:21:23,880
...كيف تجرؤ

342
00:21:23,880 --> 00:21:26,800
!ارحلوا أيُّها البشر

343
00:21:35,080 --> 00:21:38,730
!أنا، فان البطل، سوف أقتل كلّ الأشرار

344
00:21:59,250 --> 00:22:00,800
!فعلتَها يا فان

345
00:22:00,800 --> 00:22:01,540
أجل

346
00:22:04,710 --> 00:22:08,630
هذا هو ترس ملِك الجنّيات إذاً