1
00:00:01,620 --> 00:00:03,570
آسفة للمجيء في مثل هذه السّاعة

2
00:00:04,230 --> 00:00:06,330
لا مُشكلة. لا نُمانع

3
00:00:06,330 --> 00:00:08,190
ما الأمر؟ هل من شيء مهمّ؟

4
00:00:08,190 --> 00:00:11,240
هل تتذكّر الكاردينال لوبو؟

5
00:00:11,240 --> 00:00:15,240
أجل. رأيتُه في حصن السُّور الأخير العظيم

6
00:00:16,170 --> 00:00:20,030
يبحث عن سفينة ملك الشّياطين السّابق

7
00:01:55,450 --> 00:01:58,280
"الفارسة المُقنَّعة إيسكارلاتا"

8
00:01:58,280 --> 00:02:01,240
يهزم آلترا الماء، قائد جيش"
"،ملك الشّياطين

9
00:02:01,240 --> 00:02:02,970
"ويجبر آلترا على الانسحاب"

10
00:02:03,190 --> 00:02:05,670
من تخدم يا تُرى؟

11
00:02:05,670 --> 00:02:07,760
...الكنيسة؟ أم

12
00:02:07,760 --> 00:02:09,340
يبدو أنّها مرتزقة

13
00:02:11,470 --> 00:02:16,660
بالمناسبة، السّفينة الهوائيّة لملك الشّياطين
...السّابق الّتي ذكرَتْها تيسّي

14
00:02:17,170 --> 00:02:19,740
هل أنت متأكّدٌ من أنّك تريد تسليمها للكنيسة؟

15
00:02:20,060 --> 00:02:24,240
أعتقد سيُحسِنون استخدامها بشكل أفضل
ممّا هو عليه عند تركها تتعفّن في زولتان

16
00:02:24,840 --> 00:02:27,540
،إذا أرادوا إساءة استعمالها، فسنوقفهم

17
00:02:28,000 --> 00:02:29,790
لكن في الوقت الرّاهن، سوف ننتظر ونرى

18
00:02:29,790 --> 00:02:31,040
حسناً

19
00:02:31,040 --> 00:02:35,540
أولويّتنا الآن هو الحرص على ألّا يجد أحدٌ روتي

20
00:02:37,590 --> 00:02:39,880
يبدو أنّ عفن البرد قد زال

21
00:02:43,590 --> 00:02:46,220
الأعشاب تنمو بصورة جميلة أيضاً

22
00:02:46,220 --> 00:02:47,500
أجل

23
00:02:47,500 --> 00:02:50,230
يعزو الفضلُ لنصيحتك يا أخي

24
00:02:50,230 --> 00:02:53,690
وأيضاً لأنّ تيسّي كانت معي

25
00:02:53,690 --> 00:02:58,490
أجل. أنا أستمتع بالعمل على هذه المزرعة
رفقة مولاتي روتي أيضاً

26
00:02:58,770 --> 00:03:02,380
سيترتّب علينا التّفكير في خطّة مبيعات قريباً

27
00:03:02,380 --> 00:03:04,790
لنبدأ مع صيدليّتي

28
00:03:04,790 --> 00:03:06,940
سأشتري أوّل حصاد لكِ

29
00:03:06,940 --> 00:03:07,750
حسناً

30
00:03:07,750 --> 00:03:11,300
ينبغي أن نحاول الحديث مع نقابة
التجّار وعيادات زولتان

31
00:03:12,050 --> 00:03:14,960
وأيضاً التجّار المُسافرين

32
00:03:15,440 --> 00:03:17,990
ستُعيننا؟

33
00:03:17,990 --> 00:03:21,770
،أجل. أنا عضو في نقابة التجّار

34
00:03:21,770 --> 00:03:24,970
ومعلّمكما في عيش حياة هادئة في زولتان

35
00:03:25,770 --> 00:03:27,600
!أخي-سينباي

36
00:03:28,310 --> 00:03:30,290
...أخي-سينباي

37
00:03:33,070 --> 00:03:35,480
عبارة جميلة

38
00:03:54,050 --> 00:03:56,000
تبدين بحالٍ جيّدة

39
00:03:56,000 --> 00:03:57,130
جيّدة بما يكفي

40
00:03:57,560 --> 00:04:01,000
الباقي سوف أستعيده من خلال القتال

41
00:04:01,000 --> 00:04:03,840
سوف تغادر زولتان حالما تتسرّح؟

42
00:04:03,840 --> 00:04:05,140
سأفتقدك

43
00:04:05,140 --> 00:04:07,150
تعال معي إذاً

44
00:04:07,150 --> 00:04:09,890
!لنذهب ونذبح جيش ملك الشّياطين

45
00:04:09,890 --> 00:04:14,100
لا. قرّرتُ العيش هنا وإدارة صيدليّتي مع ريت

46
00:04:14,290 --> 00:04:16,610
حقّاً؟ هذا مؤسفٌ جدّاً

47
00:04:16,610 --> 00:04:19,570
لنذهب ونتناول شراباً بما أنّك هنا

48
00:04:19,570 --> 00:04:24,300
حسناً. لكن ثمّة أمر عليّ فعله قبل وداعك

49
00:04:24,300 --> 00:04:25,030
ماذا؟

50
00:04:26,190 --> 00:04:27,230
غيديون

51
00:04:29,190 --> 00:04:31,340
نازِلني

52
00:04:33,770 --> 00:04:36,040
وقبِلت؟

53
00:04:36,040 --> 00:04:37,380
أجل

54
00:04:37,380 --> 00:04:40,580
أصرَّ على فعل ذلك قبل مُغادرة زولتان

55
00:04:41,070 --> 00:04:44,550
.سيترتّب عليّ التّدريب بكثافة
غالباً فقدتُ قوّتي بعد هذه الفترة

56
00:04:44,550 --> 00:04:46,120
هل يمكنك الفوز؟

57
00:04:46,120 --> 00:04:48,190
بصراحة، ليست لديّ فُرصة

58
00:04:48,640 --> 00:04:50,980
برَكة دانان هي فنّ قتاليّ

59
00:04:50,980 --> 00:04:52,660
،إنّها برَكة شائعة

60
00:04:52,660 --> 00:04:56,420
لكن لا يوجد أحد أحبَّ برَكته وبادلَتْه
هي الحبّ بالمقابل، مثلما حدث معه

61
00:04:57,520 --> 00:04:59,690
بينما أنا الدّليل

62
00:05:00,180 --> 00:05:03,460
لا أملك سوى مهاراة شائعة الغاية
منها حماية بطلة صغيرة

63
00:05:04,020 --> 00:05:06,820
النّتيجة واضحة

64
00:05:07,140 --> 00:05:08,820
لكن مع ذلك سوف تُنازله؟

65
00:05:09,800 --> 00:05:10,830
أجل

66
00:05:12,790 --> 00:05:14,830
في هذه الحالة، هل يمكنك مُنازلتي أيضاً؟

67
00:05:18,130 --> 00:05:21,820
أقصد، لم نخُض نِزالاً من قبل أبداً

68
00:05:21,820 --> 00:05:24,790
ستكون الأمور على ما يُرام
"إذا استخدمت "رحيم

69
00:05:24,790 --> 00:05:27,530
أنا واثقة بأنّك سوف تستخدمها ضدّ دانان أيضاً

70
00:05:28,070 --> 00:05:33,860
حسناً، إذا أطلقتُ التّعويذة، فلن
أؤذي أو أجرح خصمي

71
00:05:34,110 --> 00:05:36,380
لكن سيبقى ذلك مؤلماً

72
00:05:41,350 --> 00:05:42,440
!لا أستطيع

73
00:05:50,320 --> 00:05:51,910
تدهورَ مستوايّ كثيراً

74
00:05:52,460 --> 00:05:55,500
سأخيِّب أمال دانان بهذه الطريقة

75
00:05:55,690 --> 00:05:58,720
تفضّل، احرص على شرب السّوائل

76
00:05:58,720 --> 00:06:00,020
شكراً

77
00:06:00,020 --> 00:06:02,090
!ريد

78
00:06:02,500 --> 00:06:05,460
!سمعتُ بأنّك ستقاتل دانان

79
00:06:05,910 --> 00:06:07,740
انتشرت الأخبار؟

80
00:06:08,180 --> 00:06:11,010
هذا يعني بأنّني مثاليّة للعمل

81
00:06:11,470 --> 00:06:15,220
!تدرّب معي لاستعادة فطرتك القتاليّة

82
00:06:15,490 --> 00:06:19,480
لكن ألستِ ساحرة أرواح؟

83
00:06:20,730 --> 00:06:24,980
صدِّقي أو لا تصدِّقي، أنا مؤسِّسة تقنيّة
العصا بأسلوب اللّوتس

84
00:06:24,980 --> 00:06:28,700
!ماذا؟ هذا الأسلوب شهير في كلّ مكان

85
00:06:28,700 --> 00:06:30,780
هذا ليس كلّ شيء

86
00:06:30,780 --> 00:06:34,750
أتعرفين ذلك الكتاب الّذي يُفصِّل
تكتيكات عسكريّة مختلِفة للمناطق؟

87
00:06:34,750 --> 00:06:36,850
مئة استراتيجيّة: جمال الحرب" الشّهير؟"

88
00:06:36,850 --> 00:06:39,480
هي من جمّعَتْه أيضاً

89
00:06:39,480 --> 00:06:41,000
!مذهل

90
00:06:41,350 --> 00:06:44,170
أنا لا أعيش سنواتي دون أن أفعل شيئاً

91
00:06:45,480 --> 00:06:47,630
...لذا، لنعُد إلى موضوعنا

92
00:06:48,010 --> 00:06:52,790
ما تحتاجه الآن يا ريد هو شحذ عقلك

93
00:06:52,790 --> 00:06:56,220
ليس من السّهل استرجاع مهاراتك السّابقة

94
00:06:56,220 --> 00:07:00,480
لكن يجب أن يتمتّع عقلك بنوعيّة مختلفة
!من القوّة عن الّتي امتلكها في الماضي

95
00:07:00,700 --> 00:07:04,980
صحيح. اكتسبتُ الكثير منذ انتقالي إلى زولتان

96
00:07:05,440 --> 00:07:09,490
إذاً أعتقد سأتدرّب بطريقة تتناسب مع قوى ريد

97
00:07:09,710 --> 00:07:11,060
!هكذا تكون المعنويّات

98
00:07:11,060 --> 00:07:13,800
إذاً لنتطرّق مباشرة للتّخطيط لمعسكر التّدريب

99
00:07:13,800 --> 00:07:14,920
معسكر التّدريب؟

100
00:07:14,920 --> 00:07:16,870
ستأتين أيضاً بالطّبع

101
00:07:21,830 --> 00:07:23,410
هل انتظرتَ طويلاً يا أخي؟

102
00:07:23,410 --> 00:07:25,880
لا، وصلتُ إلى هنا للتو

103
00:07:27,200 --> 00:07:30,870
أردتِ فقط أن تؤدّي ذلك المشهد فحسب، صحيح؟

104
00:07:31,180 --> 00:07:33,890
"هل انتظرت طويلاً؟" "لا، وصلتُ إلى هنا للتو"

105
00:07:33,890 --> 00:07:37,640
حقّاً؟ اهتمامها الشّديد بأخيها ظريف جدّاً

106
00:07:37,640 --> 00:07:39,410
هل انتظرت طويلاً يا أخي؟

107
00:07:39,410 --> 00:07:41,200
لا، وصلتُ إلى هنا للتو

108
00:07:41,200 --> 00:07:42,700
!هل انتظرت طويلاً يا أخي؟

109
00:07:42,700 --> 00:07:44,580
لا. وصلتُ إلى هنا للتو

110
00:07:44,580 --> 00:07:45,690
—أخي، هل

111
00:07:45,690 --> 00:07:50,150
على أي حال، هل أنت متأكّد من أنّك
تستطيع تحمُّل التّدريب مع مولاتي روتي؟

112
00:07:50,150 --> 00:07:53,100
أنا من علّمها المُبارزة بالسّيف

113
00:07:53,100 --> 00:07:56,040
لا يمكن لمُعلّم وتلميذ ألّا يستطيعا التدرُّب معاً

114
00:07:56,040 --> 00:07:59,200
أتطلّع قُدماً للتدرّب معك

115
00:07:59,530 --> 00:08:02,570
،معسكر التّدريب هو طريقة لتعزيز القوّة

116
00:08:02,570 --> 00:08:04,280
وهو الشّكل النّهائي للاستجمام أيضاً

117
00:08:05,400 --> 00:08:07,980
دانان! هل تسرّحت؟

118
00:08:07,980 --> 00:08:11,760
أجل. وتعلم كم أحبُّ معسكرات التّدريب

119
00:08:12,110 --> 00:08:14,260
!لذا سوف أنضمّ إليكم

120
00:08:14,500 --> 00:08:17,720
هذا هو طبعك. حسناً، انضمّ لنا

121
00:08:18,070 --> 00:08:19,070
!أجل

122
00:08:26,040 --> 00:08:28,670
...حسناً. يبقى الحطب فقط

123
00:08:28,670 --> 00:08:29,760
المعذرة

124
00:08:39,740 --> 00:08:42,750
!المعذرة! لا تدمّروا النِّظام البيئيّ

125
00:08:44,240 --> 00:08:47,250
!حسناً! سأخوض جولة حطب أخرى

126
00:08:47,250 --> 00:08:48,760
أجل، هذا كلُّه خاطئ

127
00:08:49,880 --> 00:08:53,820
أوّل وجبة في معسكر التّدريب
!هي غداء التّدريب الاعتياديّ لريد

128
00:08:57,010 --> 00:09:01,010
صحيح. لا أعتقد بأنّ لدينا وجبة لك يا دانان

129
00:09:01,170 --> 00:09:02,600
يمكنك الحصول على وجبتي

130
00:09:02,600 --> 00:09:04,830
!لا يمكن أن أرضى

131
00:09:06,060 --> 00:09:11,020
لا تقلق. مخاض الجوع هي أيضاً
تجربة جديدة بالنّسبة لي

132
00:09:11,420 --> 00:09:13,780
لنتقاسم الوجبة يا مولاتي روتي

133
00:09:13,780 --> 00:09:16,410
يمكنك الحصول على نصف وجبتي أيضاً

134
00:09:20,910 --> 00:09:23,280
نصف ونصف يصبحان وجبة كاملة

135
00:09:23,800 --> 00:09:25,680
لا يبدو هذا منطقيّاً

136
00:09:26,220 --> 00:09:28,420
لحظة، لحظة. لنجرّب هذا بدلاً من ذلك

137
00:09:29,260 --> 00:09:31,320
هكذا يمكننا أكل ما نشاء

138
00:09:31,320 --> 00:09:32,920
!هذا هو أخي الّذي عهِدتُه

139
00:09:33,180 --> 00:09:34,700
آسف

140
00:09:34,700 --> 00:09:38,300
،لكن بما أنّكم تعرضون عليّ
!سأجاريكم بكلِّ سرور

141
00:09:45,250 --> 00:09:46,500
قُل شيئاً يا رجل

142
00:09:50,870 --> 00:09:54,710
مضى وقتٌ طويلٌ منذ اجتمع
فريقُ البطل بهذا الشّكل

143
00:09:54,710 --> 00:09:57,700
لكن نفتقد لتيودورا... وآريس

144
00:10:01,160 --> 00:10:02,390
صحيح

145
00:10:04,120 --> 00:10:06,050
هل قرأتم صحيفة الأخبار؟

146
00:10:06,050 --> 00:10:11,460
الأخبار عن المرتزقة الغامضة الّتي
قضت على آلترا الماء؟

147
00:10:11,760 --> 00:10:14,460
تقصد الفارسة المُقنَّعة إيسكارلاتا؟

148
00:10:14,690 --> 00:10:16,850
لا بدّ أنّها تيودورا

149
00:10:16,850 --> 00:10:21,440
لا يوجد فارس آخر في هذه القارّة
يستطيع التفوُّق على قائد عسكريّ

150
00:10:21,920 --> 00:10:26,070
،ثمّ هناك اليد اليمنى لإيسكارلاتا

151
00:10:26,070 --> 00:10:28,060
الفارس ذو الذّراع اليمنى الاصطناعيّة

152
00:10:28,700 --> 00:10:30,860
لا بدّ أنّه آلبيرت

153
00:10:31,230 --> 00:10:35,230
هو؟ لم أشكره على إنقاذي بعد

154
00:10:35,500 --> 00:10:39,630
أخطّط للّقاء بتيودورا أوّلاً بعد مغادرة زولتان

155
00:10:39,630 --> 00:10:42,610
،إذا أرادت الذّهاب والإجهاز على قائد الماء العسكريّ

156
00:10:42,610 --> 00:10:44,740
فسوف أنضمّ لها بكلِّ سرور

157
00:10:45,990 --> 00:10:49,910
لم أجرّب ساتيه البطّ بعد

158
00:10:49,910 --> 00:10:51,250
لا يهمّني

159
00:10:51,500 --> 00:10:53,360
!توقّف عن ذلك

160
00:10:52,630 --> 00:10:54,040
...أيّتها

161
00:10:54,980 --> 00:10:56,160
لذيذة

162
00:10:56,160 --> 00:10:57,800
!روتي

163
00:11:00,070 --> 00:11:01,890
!حسناً، لنشرع في ذلك

164
00:11:06,720 --> 00:11:08,290
هل ندرّب أيضاً؟

165
00:11:08,290 --> 00:11:09,190
فكرة سديدة

166
00:11:09,190 --> 00:11:11,470
هناك شيء آخر أريد فعله

167
00:11:11,780 --> 00:11:13,110
مولاتي روتي؟

168
00:11:58,950 --> 00:12:03,290
كان ذلك... غير مُتوقَّع من ناحيتي

169
00:12:03,290 --> 00:12:06,880
حقّاً؟ كان كما توقّعتُ تماماً

170
00:12:07,520 --> 00:12:08,540
تماماً

171
00:12:08,540 --> 00:12:11,040
ما الّذي كنتِ تتخيّلينه

172
00:12:12,920 --> 00:12:14,580
أشتمّ رائحة طيّبة

173
00:12:14,580 --> 00:12:19,080
سمعتُ أنّ ريت وياراندرالا يعدّان العشاء اللّيلة

174
00:12:19,510 --> 00:12:20,660
ينبغي أن يكون هذا كافياً

175
00:12:24,930 --> 00:12:27,410
أسلوب قتالك بالسّيف يجعل خصمك مرئيّاً

176
00:12:27,410 --> 00:12:28,510
خصمي؟

177
00:12:28,720 --> 00:12:32,770
أجل. يمكنني رؤية مَن تُصيبه بحركاتك بالضّبط

178
00:12:33,960 --> 00:12:36,220
أجل، هذا لأنّني أتخيّله في ذهني

179
00:12:37,110 --> 00:12:40,590
البشر، الإيلف، الوحوش، الشّياطين

180
00:12:40,910 --> 00:12:44,670
يمكنني رؤية خصم مختلف من خصومك
في كلّ مرّة وبشكل واضح

181
00:12:45,030 --> 00:12:48,120
هذا يُثبِت كم أنّ تكتيكاتك مرِنة

182
00:12:48,120 --> 00:12:50,290
!سيكون النِّزال معك مُمتعاً

183
00:12:50,850 --> 00:12:51,940
كذلك أنا

184
00:13:06,980 --> 00:13:09,330
هل أغسل ظهرك؟

185
00:13:15,910 --> 00:13:18,230
قبلتُ عرضكِ

186
00:13:25,060 --> 00:13:29,610
التدرُّب معه اليوم وضّح تماماً حجم قوّة دانان

187
00:13:29,610 --> 00:13:33,840
أظنّه أقوى بشريّ موجود هنا باستثناء روتي

188
00:13:33,840 --> 00:13:36,750
أجل، شعرتُ ذات الشُّعور

189
00:13:37,050 --> 00:13:41,030
لكن النِّزال معه لا هو رياضة ولا هو
معركة حتّى الموت

190
00:13:41,360 --> 00:13:44,210
النِّزال معه له هدف خارج
إطار الفوز والخسارة

191
00:13:44,210 --> 00:13:45,760
وما هو؟

192
00:13:46,030 --> 00:13:48,160
دانان هو مُحارب في الصّميم

193
00:13:48,160 --> 00:13:50,320
أبعد ما يمكن عن حياة هادئة

194
00:13:50,820 --> 00:13:55,090
من خلال معاركنا، أريد أن أريه
كيف اخترتُ عيش حياتي

195
00:13:55,770 --> 00:13:58,040
إنّه صديقٌ كنتَ تخوض مُغامرات معه في النّهاية

196
00:13:58,460 --> 00:13:59,940
آمل أن يفهم

197
00:14:01,240 --> 00:14:02,130
أجل

198
00:14:10,840 --> 00:14:13,950
"حسناً، سأطلِق "رحيم

199
00:14:16,680 --> 00:14:20,660
لن تُصاب بجروح، لكن تأكّد بأنّ
هذه التّعويذة لا تخفّف الألم

200
00:14:25,380 --> 00:14:27,380
لا ضغينة

201
00:14:29,630 --> 00:14:30,890
!ابدآ

202
00:14:35,930 --> 00:14:36,890
:الفنّ القتاليّ

203
00:14:36,890 --> 00:14:38,060
!الرّكلة الهائجة

204
00:14:59,580 --> 00:15:01,570
!الفنّ القتاليّ: اللّكمة السّاحقة

205
00:15:10,200 --> 00:15:12,940
إنّه ليس إلّا مجرّد سيف عاديّ

206
00:15:12,940 --> 00:15:15,760
،يُفترض أن أكون أقوى منك بكثير

207
00:15:15,760 --> 00:15:20,530
لكن كشفتَ كلّ حركاتي وحتّى
أنّك احتككت معي باستخدام سيفك

208
00:15:23,530 --> 00:15:26,200
أنت مُسلٍّ يا غيديون

209
00:15:26,200 --> 00:15:28,360
أنت مُسلٍّ حقّاً

210
00:15:28,360 --> 00:15:31,860
لكن اكتشفتَ كيف تفوز، أليس كذلك؟

211
00:15:31,860 --> 00:15:36,310
أجل. أنت تتعامل مع هجماتي فقط

212
00:15:36,310 --> 00:15:39,790
لأنّك تتوقّعها

213
00:15:40,370 --> 00:15:43,880
من المُحال أن أتمكّن من حماية
نفسي لولا ذلك

214
00:15:44,050 --> 00:15:47,810
في هذه الحالة، يمكنني الفوز ببساطة
من خلال الحركات الّتي لا أستخدمها عادةً

215
00:15:47,810 --> 00:15:50,380
التحفُّظ قليلاً هو كلّ ما سيتطلّبه الأمر

216
00:15:50,380 --> 00:15:53,890
هكذا إذاً. سوف تتحفّظ؟

217
00:15:54,320 --> 00:15:56,270
طبعاً لا

218
00:15:56,270 --> 00:15:58,840
هذا نِزال، ليس معركة حتّى الموت

219
00:15:59,300 --> 00:16:04,740
!سوف أقاتلك بذروة قوّتي

220
00:16:04,740 --> 00:16:06,520
!لم أتوقّع أقلّ من هذا

221
00:16:07,700 --> 00:16:09,480
ها أنا قادم يا غيديون

222
00:16:09,730 --> 00:16:13,520
،إذا كشفت تحرُّكاتي وأنا بكامل قوّتي

223
00:16:13,520 --> 00:16:17,150
!فسأريك كيف سأبتعد إلى ما وراء ذلك

224
00:16:17,530 --> 00:16:18,780
أنا جاهزٌ يا دانان

225
00:16:19,190 --> 00:16:23,290
!سأجاريك بكلّ ما اكتسبتُه في حياتي حتّى الآن

226
00:16:28,460 --> 00:16:29,680
!غيديون

227
00:16:30,340 --> 00:16:31,510
!دانان

228
00:16:38,500 --> 00:16:42,480
مؤلم... كان ينبغي أن أعلم بأنّني
لا أستطيع تحمُّل ضربة مُباشرة

229
00:16:43,550 --> 00:16:46,480
لولا تعويذة ياراندرالا لكنتُ في عداد الموتى

230
00:16:48,410 --> 00:16:51,240
أنت قويٌّ حقّاً يا غيديون

231
00:16:51,240 --> 00:16:53,640
آمل ألّا أكون قد خيّبتُ أملك

232
00:16:53,640 --> 00:16:54,950
بالطّبع لا

233
00:16:55,480 --> 00:16:58,170
لا أفهم الحياة الهادئة الّتي تتحدّث عنها

234
00:16:58,650 --> 00:17:01,780
لهذا بالضّبط أردتُ مُنازلتك

235
00:17:02,070 --> 00:17:04,960
القتال هو الشّيء الوحيد الّذي أجيده

236
00:17:04,960 --> 00:17:08,210
حسناً، هل فهمتَ شيئاً عن الحياة الهادئة؟

237
00:17:08,440 --> 00:17:10,010
إطلاقاً

238
00:17:10,010 --> 00:17:13,330
لكن يا غيديون... لا، يا ريد

239
00:17:13,330 --> 00:17:17,300
رأيتُ أنّ مبارزتك بالسّيف تتمتّع
بقوّة كامنة لا تلين

240
00:17:17,850 --> 00:17:20,920
ما زلتَ ذلك الرّجل القويّ الّذي احترمتُه

241
00:17:20,920 --> 00:17:22,470
كلّ ما في الأمر أنّك اخترتَ درباً آخر

242
00:17:22,860 --> 00:17:25,600
قد تكون هذه الحياة الهادئة شكلاً
مختلفاً من القوّة فحسب

243
00:17:26,050 --> 00:17:28,230
ابذل قصارى جهدك لتعيش سعيداً للأبد

244
00:17:28,230 --> 00:17:30,290
شكراً لك يا دانان

245
00:17:30,290 --> 00:17:33,540
أقاتل لأنّني أرغب في القتال دوماً

246
00:17:33,540 --> 00:17:35,740
هذا هو مصدري عزّتي

247
00:17:35,740 --> 00:17:41,240
أجل. أحترم قوّتك الصّلبة أيضاً

248
00:17:43,200 --> 00:17:46,190
دانان. دوري تالياً

249
00:17:46,960 --> 00:17:50,750
!ماذا؟ يمكنني مُنازلة البطلة الأقوى؟

250
00:17:50,750 --> 00:17:52,920
...ولا حتّى في الأحلام

251
00:17:55,920 --> 00:18:00,390
اللّعنة! كيف يمكنني الفوز؟

252
00:18:03,940 --> 00:18:06,020
أشفق عليه كثيراً

253
00:18:06,020 --> 00:18:07,020
آسفة

254
00:18:15,930 --> 00:18:17,900
!آلبيرت دون سواه

255
00:18:17,900 --> 00:18:19,580
لم أرك منذ وقت

256
00:18:19,580 --> 00:18:22,910
يا للمفاجأة. عدتَ إلى زولتان؟

257
00:18:22,910 --> 00:18:25,030
وصلتُ إلى هنا اليوم

258
00:18:25,030 --> 00:18:28,160
يسرّني أن أراكما بخير
يا سيّد ريد، وآنسة ريت

259
00:18:28,160 --> 00:18:30,920
سيّد ريد؟ يبدو هذا غريباً

260
00:18:32,260 --> 00:18:35,420
من فضلك لا تذكّرني بِمَن كنتُ عليه

261
00:18:35,640 --> 00:18:37,420
هل تيودورا معك؟

262
00:18:37,420 --> 00:18:39,740
أتيتُ لوحدي

263
00:18:39,740 --> 00:18:43,280
إنّها تستعمل اسم إيسكارلاتا حاليّاً

264
00:18:43,280 --> 00:18:46,680
وأحمل لك رسالة منها

265
00:18:46,680 --> 00:18:47,930
رسالة؟

266
00:18:48,970 --> 00:18:51,450
"ظهور بطل جديد"

267
00:18:52,120 --> 00:18:54,690
"إنّه فان من فلامبيرغ"

268
00:18:55,360 --> 00:19:00,700
قد يشقّ طريقه إلى زولتان من أجل"
"أن يأخذ سفينة ملك الشّياطين السّابق

269
00:19:08,270 --> 00:19:09,940
!يا للجلبة

270
00:19:09,940 --> 00:19:11,540
الجميع مستمتعون

271
00:19:13,540 --> 00:19:16,730
لافيندر، ابقي قريبة. هذا ليس آمناً

272
00:19:16,730 --> 00:19:19,340
لكن ستحميني، أليس كذلك؟

273
00:19:19,340 --> 00:19:22,050
بالطّبع. سأحافظ على سلامتكِ
بكلّ ما أوتيت من قوّة

274
00:19:22,050 --> 00:19:26,560
!بوسعي أن أفعل أي شيء لك يا فان

275
00:19:28,260 --> 00:19:31,100
!لِمَ تبتسم باستخفاف في وجهي؟

276
00:19:31,100 --> 00:19:34,560
حـ-حسناً، أمسى هذا دفاعاً عن النّفس

277
00:19:37,050 --> 00:19:43,960
عـ-عـ... عليّ قتل النّاس بين الحين والآخر
!فقط كي أبقي برَكتي تحت السّيطرة

278
00:19:45,490 --> 00:19:48,580
هل يوجد هنا صديقٌ له؟

279
00:19:48,580 --> 00:19:52,870
!لِمَ لا تُهاجمني وتثأر له؟

280
00:19:52,870 --> 00:19:55,500
!هيّا! تعال إليّ

281
00:19:55,500 --> 00:19:58,670
!أ-أتوسّل إليك! امنحني حياتك

282
00:19:55,880 --> 00:19:57,390
برَكة آثم؟

283
00:20:07,090 --> 00:20:08,370
زالَ الشرّ

284
00:20:13,510 --> 00:20:15,520
ماذا حدث هنا؟

285
00:20:15,520 --> 00:20:18,390
فان أسقطَ شخصاً غريباً للتو

286
00:20:18,390 --> 00:20:22,780
أجل. قتلتُه لأنّه قتلَ شخصاً

287
00:20:23,140 --> 00:20:26,950
أحتاج شرحاً كاملاً. لماذا اندلعت المعركة؟

288
00:20:26,950 --> 00:20:30,340
ماذا؟ وهل هذا مهمّ؟

289
00:20:30,340 --> 00:20:33,290
من المهمّ معرفة ما الّذي حفّزَ على القتل

290
00:20:33,690 --> 00:20:37,290
كان بوسعك القبض عليه حيّاً ببساطة

291
00:20:37,740 --> 00:20:40,300
كان ينبغي أن تستجوبه أوّلاً

292
00:20:40,550 --> 00:20:45,540
ولِمَ أفعل؟ تعلمين بأنّه كان لديه
برَكة آثم على ما أفترض

293
00:20:46,030 --> 00:20:48,160
لكن الجميع هنا بشر

294
00:20:48,480 --> 00:20:51,400
حياة النّاس تشمل أكثر من دوافع
البرَكات خاصّتهم فحسب

295
00:20:51,890 --> 00:20:54,160
لكلّ شخص إرادته الحرّة

296
00:20:54,160 --> 00:20:55,810
يجب ألّا تنسى ذلك أبداً

297
00:20:56,510 --> 00:20:58,840
أنتِ مُخطئة

298
00:20:58,840 --> 00:20:59,780
ماذا؟

299
00:20:59,780 --> 00:21:04,280
لا، لا أقصد بأنّ ما تقولينه خاطئ

300
00:21:05,130 --> 00:21:10,730
لم أكرهه، ولم أكن أحاول منع
وقوع المزيد من القتل

301
00:21:11,130 --> 00:21:14,580
استخدام سيف البطل لإشباع رغبات
شخصيّة هو أمر خاطئ

302
00:21:14,580 --> 00:21:18,580
ناهيك عن أنّ كلّ معاركي هي
عطايا لديميس العظيم

303
00:21:18,580 --> 00:21:20,590
لماذا قتلتَه إذاً؟

304
00:21:20,930 --> 00:21:25,810
وُجِدَ الآثمون ليتمّ إسقاطهم بواسطة شخص آخر

305
00:21:25,810 --> 00:21:29,840
قتلتُه وذلك كي يؤدّي دوره

306
00:21:30,100 --> 00:21:35,410
وشعرتُ بأنّني نموتُ كبطل عندما قتلتُه

307
00:21:36,460 --> 00:21:39,280
أعرض الحُبَّ والبرَكات لحياته

308
00:21:39,840 --> 00:21:42,820
،برَكتي، والّتي نمَتْ الآن على حساب حياته

309
00:21:42,820 --> 00:21:44,860
سوف تنقذ العالمَ يوماً ما بكلِّ تأكيد

310
00:21:44,860 --> 00:21:46,850
...فان، لماذا أنت

311
00:21:46,850 --> 00:21:48,870
إنّها لَكلِمات بطل حقيقيّ بالفعل

312
00:21:49,160 --> 00:21:51,930
مهلك. ما زلتُ بطلاً بالاسم فقط

313
00:21:51,930 --> 00:21:55,250
لم أقاتل حتّى جيش ملِك الشّياطين

314
00:21:55,680 --> 00:22:00,260
من المؤكّد أنّ إيمان البطلة روتي
أعمق بكثير من إيماني

315
00:22:04,900 --> 00:22:07,470
هيّا. سنتوجّه إلى زولتان