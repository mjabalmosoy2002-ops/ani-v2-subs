1
00:00:09,650 --> 00:00:11,650
أهلاً بعودتك يا تيودورا

2
00:00:12,160 --> 00:00:13,900
نادِني "إيستا" هنا

3
00:00:14,320 --> 00:00:17,270
حسناً. آسف، لم أعتد على ذلك بعد

4
00:01:59,050 --> 00:02:01,210
سفينة ملِك الشّياطين السّابق؟

5
00:02:01,720 --> 00:02:04,930
إنّها السّفينة الّتي استقلّتها روتي إلى زولتان

6
00:02:05,770 --> 00:02:11,710
،إذا توجّه فان إلى زولتان وصادف روتي

7
00:02:11,710 --> 00:02:13,320
فلن يكون الأمر حميداً

8
00:02:14,070 --> 00:02:16,490
علينا تجنُّب ذلك، من أجل روتي

9
00:02:17,910 --> 00:02:20,550
هل يمكنك التوجُّه إلى زولتان لأجلي؟

10
00:02:21,000 --> 00:02:23,190
يجب أن يُبلَغ ريد بهذه الأحداث

11
00:02:23,630 --> 00:02:24,700
حسناً

12
00:02:25,990 --> 00:02:29,120
هل "البطل" الجديد حقيقيّ فعلاً؟

13
00:02:31,180 --> 00:02:35,840
قيّمَه القدّيس، وقيادة الكنيسة
،قد اعترفَتْ به كذلك

14
00:02:36,380 --> 00:02:38,420
...لذا أستنتج بأنّه كذلك فعلاً

15
00:02:39,110 --> 00:02:41,430
لكنّه مختلف عن روتي

16
00:02:42,430 --> 00:02:45,610
كلّ ما يمكننا فعله الآن هو الانتظار وسنرى

17
00:02:45,610 --> 00:02:50,230
فهمت. سأفعل ما يمكنني فعله للمُساعدة

18
00:02:52,560 --> 00:02:54,060
شكراً لك يا آلبيرت

19
00:02:54,790 --> 00:02:56,560
أنا مسرورة لأنّك هنا لأجلي

20
00:03:04,640 --> 00:03:05,450
مرحباً

21
00:03:05,880 --> 00:03:09,460
أريد بعضاً من خلطتك الجديدة

22
00:03:09,870 --> 00:03:11,790
خُلاصة فطر التنّين؟

23
00:03:11,790 --> 00:03:13,120
!أجل، أجل

24
00:03:13,120 --> 00:03:15,420
!ذلك الشّراب يمنح فائضاً من الطّاقة حقّاً

25
00:03:15,750 --> 00:03:20,340
نادراً ما تزورينني باكراً جدّاً يا ناو

26
00:03:20,570 --> 00:03:22,620
اليوم هو يوم المهرجان

27
00:03:22,620 --> 00:03:25,550
إذا أهدرتُ الوقت، فسينتهي اليوم
دون أن أشعر بذلك

28
00:03:27,140 --> 00:03:29,520
دعيني أضيف المزيد لميدو وغونز أيضاً

29
00:03:29,840 --> 00:03:31,310
!شكراً يا ريد

30
00:03:36,560 --> 00:03:37,690
ينبغي لهذا أن يفي بالغرض

31
00:03:38,570 --> 00:03:40,950
هل أنتِ جاهزة يا ريت؟

32
00:03:41,140 --> 00:03:42,500
!قادمة

33
00:03:49,540 --> 00:03:50,630
أنا هنا

34
00:03:51,060 --> 00:03:52,160
كيف أبدو؟

35
00:03:52,910 --> 00:03:54,780
تبدين رائعة

36
00:03:55,360 --> 00:03:58,130
!يُعجبني مظهرك بهذا المعطف أيضاً

37
00:03:59,790 --> 00:04:01,350
هل ننطلق إذاً؟

38
00:04:02,080 --> 00:04:04,340
هل لديك ما طلبه زيف؟

39
00:04:04,730 --> 00:04:06,720
لديّ هنا

40
00:04:06,720 --> 00:04:08,350
لنذهب إذاً

41
00:04:13,350 --> 00:04:17,460
مذهل... على ذكرِ روح المهرجانات

42
00:04:17,460 --> 00:04:21,040
اليوم هو مهرجان الدرّاج دريك وانقلاب
،القدّيس ليسينيوس

43
00:04:21,040 --> 00:04:23,760
بحسب أسطورة أفالونيّة

44
00:04:24,460 --> 00:04:27,440
حتّى الزّولتانيّين الّذين يحبّون
،قضاء وقتهم كسولين أثناء النّهار

45
00:04:27,440 --> 00:04:30,360
يخرجون لجعل الأجواء حيويّة من الصّباح
في هذا اليوم المُميّز

46
00:04:30,360 --> 00:04:32,450
!ريد

47
00:04:35,750 --> 00:04:37,630
أتستمتع بوقتك؟

48
00:04:37,630 --> 00:04:40,840
غونز. يبدو أنّك بمزاج جيّد

49
00:04:41,040 --> 00:04:43,980
بالطبع. فهو مهرجان

50
00:04:43,980 --> 00:04:46,830
...الجميع في إجازة من العمل. وأيضاً

51
00:04:51,210 --> 00:04:53,680
سآخذ غداً إجازة بسبب صُداع الخمر

52
00:04:53,680 --> 00:04:55,720
غداً أيضاً؟

53
00:04:55,720 --> 00:04:59,020
من يذهب إلى العمل بعد يوم من الحفلة؟

54
00:04:59,310 --> 00:05:02,030
!أخبرهم يا غونز! ما يعنيه أن تكون رجلاً

55
00:05:02,210 --> 00:05:07,030
لا... حتّى تانتا سوف يكبر ليصبح فاشلاً

56
00:05:07,860 --> 00:05:08,700
تانتا

57
00:05:08,700 --> 00:05:10,490
ما الأمر يا ريد؟

58
00:05:11,180 --> 00:05:14,000
سوف أعود إلى العمل غداً

59
00:05:14,000 --> 00:05:16,670
مهلك، خذه عطلة

60
00:05:16,670 --> 00:05:18,080
انظر إلى هناك

61
00:05:22,780 --> 00:05:28,220
هكذا يُقام مهرجان الدرّاج دريك وانقلاب
القدّيس ليسينيوس في زولتان، صحيح؟

62
00:05:28,220 --> 00:05:30,390
هل هو مختلف عن المكان الّذي
أتيتِ منه يا ريت؟

63
00:05:30,870 --> 00:05:33,990
أجل. كان أكثر رسميّة بكثير في لوغّارفيا

64
00:05:33,990 --> 00:05:35,290
هكذا إذاً

65
00:05:36,830 --> 00:05:42,410
الهدف هو نفسه، الدرّاج دريك والقدّيس
يطردان شيطانَ الشّتاء

66
00:05:42,410 --> 00:05:45,710
لكن الرّائع هو كيف تؤدّي كلّ منطقة
المهرجانَ بشكلٍ مختلف

67
00:05:45,710 --> 00:05:50,910
هنا، نحن نغنّي ونرقص ونحتفل بملء
قلوبنا لطرد شيطان الشّتاء

68
00:05:51,390 --> 00:05:53,280
هذه هي طريقة زولتان

69
00:05:53,280 --> 00:05:55,750
هذا مُرهق للغاية

70
00:05:55,750 --> 00:05:59,430
لهذا سآخذ غداً إجازة

71
00:06:00,200 --> 00:06:01,630
هكذا منطقيّ

72
00:06:02,240 --> 00:06:03,940
لنأخذ عطلة

73
00:06:03,940 --> 00:06:05,090
...ريت

74
00:06:05,410 --> 00:06:13,640
!لنأخذ عطلة

75
00:06:13,640 --> 00:06:15,630
حسناً، فهمت

76
00:06:15,630 --> 00:06:18,830
أنا متأكّدٌ أنّ زولتان بأكملها ستكون
خارج الخدمة غداً على أي حال

77
00:06:18,830 --> 00:06:20,730
أعتقد يمكننا اتّخاذ الأمور برويّة

78
00:06:21,890 --> 00:06:23,810
!مرحى

79
00:06:23,810 --> 00:06:25,230
مرحى

80
00:06:26,450 --> 00:06:28,150
سوف نأخذ عطلة أيضاً

81
00:06:28,150 --> 00:06:29,280
...في الواقع

82
00:06:29,870 --> 00:06:30,740
حسناً

83
00:06:33,030 --> 00:06:38,080
أيُعقَل هذا؟ روتي وتيسي كبِرا
وأصبحا فاشلين أيضاً

84
00:06:38,670 --> 00:06:39,880
أليس هذا مُمتعاً؟

85
00:06:41,040 --> 00:06:42,520
أعتقد الأمور على ما يُرام

86
00:06:50,060 --> 00:06:52,420
هذا يُسكّن الرُّوح

87
00:06:52,420 --> 00:06:53,800
...ربّما

88
00:06:54,920 --> 00:06:56,350
أوبارارا؟

89
00:06:56,350 --> 00:06:58,600
هل انتهيتِ بالفعل؟

90
00:06:58,600 --> 00:07:00,180
!مُـ-مُحال

91
00:07:00,180 --> 00:07:02,420
إذا كانت هذه نكتة، فهي ليست
!مُضحِكة يا ميغريا

92
00:07:02,420 --> 00:07:04,940
!أنا لم أبدأ بعد هنا

93
00:07:04,940 --> 00:07:07,570
هكذا إذاً، يسرُّني سماع ذلك

94
00:07:14,720 --> 00:07:16,580
رائحة زكيّة

95
00:07:27,590 --> 00:07:29,180
هل أنتِ بخير؟

96
00:07:29,180 --> 00:07:30,380
شكراً، أردتُ شراباً

97
00:07:36,760 --> 00:07:38,880
هل أخذتُما عطلة؟

98
00:07:38,880 --> 00:07:41,270
أجل. نقابة المُغامرين هي الّتي
فعلت على الأقلّ

99
00:07:42,260 --> 00:07:43,310
...في هذه الأثناء

100
00:07:44,180 --> 00:07:48,130
سأفعل ما أفعله في أي يوم آخر

101
00:07:48,580 --> 00:07:53,920
الأودن الخاصّ بي مشغول حاليّاً
،ليصبح لذيذاً في القِدر

102
00:07:55,920 --> 00:07:59,260
لهذا أتيتُ إلى هنا لأطرح
العرق والسّموم من جسدي

103
00:07:59,260 --> 00:08:00,200
أفهم ما تقصدينه

104
00:08:00,780 --> 00:08:04,530
يختلِف مذاق الأودن تماماً بحسب
المدّة الّتي يُطبَخ فيها

105
00:08:04,530 --> 00:08:05,560
!انتظر يا فتى

106
00:08:05,560 --> 00:08:08,340
!دعني! لم أرتكب أي خطأ

107
00:08:09,580 --> 00:08:12,430
ألم ترني واقفاً هنا؟

108
00:08:12,430 --> 00:08:14,870
!لم تكن كذلك! كفى كذِباً

109
00:08:14,870 --> 00:08:15,850
ماذا قلت؟

110
00:08:17,320 --> 00:08:18,760
ما المشكلة؟

111
00:08:19,430 --> 00:08:21,420
تجاوز هذا الفتى الطّابور

112
00:08:21,420 --> 00:08:23,480
!كـ-كنتُ هناك أوّلاً

113
00:08:23,480 --> 00:08:25,690
!أنت من تجاوز الطّابور

114
00:08:25,690 --> 00:08:28,630
ماذا؟ ماذا قلت أيُّها القزم؟

115
00:08:29,450 --> 00:08:31,030
!لا تسخر منّي

116
00:08:39,800 --> 00:08:41,010
...أديمي

117
00:08:41,010 --> 00:08:42,660
لا تفعل ذلك. كان من المُمكن أن تؤذيه

118
00:08:48,140 --> 00:08:50,850
أعتذر عن الإزعاج

119
00:08:52,670 --> 00:08:57,410
استيقظَتْ برَكتُه مؤخّراً، لذا
ما زال غير مستقرّ بعض الشّيء

120
00:08:57,410 --> 00:08:58,770
اعتذر أيضاً

121
00:08:59,820 --> 00:09:00,970
!أنا آسف

122
00:09:01,520 --> 00:09:05,130
لا داعي. انفعلتُ قليلاً أيضاً

123
00:09:05,760 --> 00:09:08,730
لا تُلام على انقباضات البرَكة الخاصّة بك

124
00:09:09,340 --> 00:09:12,990
لا يُلام المرء على انقباضات البرَكة"
الخاصّة به" إذاً؟

125
00:09:14,400 --> 00:09:16,820
كبر أديمي وأصبح شابّاً ناضجاً

126
00:09:17,400 --> 00:09:18,270
أجل

127
00:09:18,640 --> 00:09:20,280
!ريد

128
00:09:20,630 --> 00:09:23,160
!الجميع

129
00:09:23,760 --> 00:09:26,060
أرى شيئاً يقفز هناك

130
00:09:27,600 --> 00:09:28,920
!أنتم

131
00:09:28,170 --> 00:09:28,920
!هنا

132
00:09:29,180 --> 00:09:30,470
!ياراندرالا

133
00:09:30,470 --> 00:09:32,300
!ريت

134
00:09:34,560 --> 00:09:36,550
البلدة مُفعمة بالحيويّة اليوم حقّاً

135
00:09:38,140 --> 00:09:39,950
تسرّني رؤيتكِ تستمتعين

136
00:09:39,950 --> 00:09:42,810
هناك كثير من العرباتِ لم أرها من قبل

137
00:09:42,810 --> 00:09:43,920
!انظروا

138
00:09:43,920 --> 00:09:47,770
يُقال بأنّ هذا القِناع المُقدّس صُنِع
!بواسطة حكيم عظيم أسطوريّ

139
00:09:48,150 --> 00:09:51,740
ياراندرالا؟ ذكّريني كم عمرك؟

140
00:09:53,560 --> 00:09:57,360
قد يراني البعض كفتاة صغيرة
!في الخمسين تقريباً

141
00:09:58,300 --> 00:10:00,940
نكتة إيلف... هذه جديدة

142
00:10:06,280 --> 00:10:07,520
!تعالوا جميعاً

143
00:10:14,670 --> 00:10:16,370
!يا زعيم

144
00:10:16,370 --> 00:10:19,190
!لم تخبرني بأنّك تعرف إيلف كيرامين

145
00:10:19,190 --> 00:10:20,510
إيلف كيرامين؟

146
00:10:20,510 --> 00:10:25,020
نحن الإيلف نشير إلى بعضنا الآخر
بحسب الأماكن الّتي وُلِدنا فيها

147
00:10:25,020 --> 00:10:27,390
ما يجعلني إيلف زولتان

148
00:10:27,390 --> 00:10:29,730
أنا مندهش من معرفتكِ المكان
الّذي انحدرتْ منه

149
00:10:29,730 --> 00:10:31,830
نعرف فحسب

150
00:10:31,830 --> 00:10:35,750
حتّى بين الإيلف الرّفيعين، الإيلف
الكيرامين مُميّزون

151
00:10:35,750 --> 00:10:39,510
كيف لريفيّة جاهلة مثلي أن تتكلّم معها؟

152
00:10:39,510 --> 00:10:41,950
!اخشى أن أتلفّظ بكلمة خاطئة تجاهها

153
00:10:41,950 --> 00:10:43,330
أوبارارا؟

154
00:10:43,330 --> 00:10:44,720
!حـ-حاضرة

155
00:10:44,720 --> 00:10:49,980
أنا من كيرامين بالتّأكيد، لكن هذا لا يعني شيئاً

156
00:10:51,360 --> 00:10:52,390
لا عليكِ

157
00:10:52,860 --> 00:10:55,500
،ياراندرالا صديقتي

158
00:10:56,040 --> 00:10:58,090
لذا لا تقلقي بشأن ذلك

159
00:10:59,640 --> 00:11:00,840
!روتي

160
00:11:01,170 --> 00:11:05,350
على أي حال، هل يمكنني تناول
بعض الأودن؟ أنا أتضوّر جوعاً

161
00:11:06,480 --> 00:11:08,190
!لكِ ذلك

162
00:11:08,190 --> 00:11:10,160
ماذا تريدون؟

163
00:11:10,160 --> 00:11:11,850
لديّ أخطبوط طازج اليوم

164
00:11:12,180 --> 00:11:13,660
!وكُرات السّمك حظيَتْ بمُوافقتي أيضاً

165
00:11:13,660 --> 00:11:17,000
سأتناول بعضاً إذاً. وقليل من الأرقطيون

166
00:11:17,000 --> 00:11:18,860
أريد أخطبوطاً وبعض البيض

167
00:11:19,440 --> 00:11:21,850
أريد مثل فخامتها روتي

168
00:11:21,850 --> 00:11:24,370
وأربعة أسياخ سمك مشويّة

169
00:11:24,670 --> 00:11:26,490
...المعذرة، بالنّسبة لي

170
00:11:26,490 --> 00:11:28,740
أريد أخطبوطاً وبيضاً وأرقطيوناً وكُرات سمك

171
00:11:28,740 --> 00:11:30,930
وكُرات حبّار وفجل وأوتار لحم عجل

172
00:11:30,930 --> 00:11:35,030
...وأيضاً كعكة سمك وعشب بحريّ وجيلي

173
00:11:35,030 --> 00:11:36,340
!وكعك توفو

174
00:11:36,340 --> 00:11:37,900
هذا طلب كبير جدّاً

175
00:11:38,790 --> 00:11:41,070
بدا الطّعام لذيذاً فحسب

176
00:11:41,070 --> 00:11:42,760
ماذا عنكِ يا ياراندرالا؟

177
00:11:42,990 --> 00:11:46,410
سأطلب ما تطلبه أنت

178
00:11:46,410 --> 00:11:50,270
أخطبوط وأرقطيون. بالإضافة
إلى بعض كُرات السّمك رجاء

179
00:11:51,740 --> 00:11:52,550
!فوراً

180
00:11:53,760 --> 00:11:54,860
!تفضّلوا

181
00:11:55,500 --> 00:11:57,360
!لنبدأ بالأكل

182
00:11:57,870 --> 00:12:00,380
!نضيف هذه هنا وسيصبح المذاق أطيب بمرّتين

183
00:12:01,370 --> 00:12:04,490
لم نطلب شيئاً باهظ الثّمن كهذا

184
00:12:04,930 --> 00:12:07,020
إنّه على حساب الآنسة هنا

185
00:12:07,460 --> 00:12:08,840
!روتي؟

186
00:12:08,840 --> 00:12:09,490
أجل

187
00:12:10,000 --> 00:12:14,250
لحظة، لحظة. لا أستطيع أن أدع
أختي الصّغرى تدفع عنّي

188
00:12:14,720 --> 00:12:18,080
كنتُ مُغامرة برتبة ب ناجحة كما تعلم

189
00:12:18,080 --> 00:12:21,670
واحزر من تقاضى أجره للتوّ

190
00:12:21,670 --> 00:12:23,260
ماذا يوجد في هذا الكيس؟

191
00:12:23,520 --> 00:12:26,580
أخبرتني أن أعيش كما أردتُ

192
00:12:26,580 --> 00:12:30,660
والآن، أريدكم جميعاً أن تستمتعوا
ببعض الأودن اللّذيذ

193
00:12:32,710 --> 00:12:35,900
كلتاكما تتشاركان المال، صحيح؟
أوقفيها وإلّا أنفقَتِ المالَ كلّه

194
00:12:36,720 --> 00:12:39,190
ما تقرّره هي يحدث

195
00:12:51,340 --> 00:12:54,210
حسناً، سأبدأ بالأكل يا روتي

196
00:12:54,210 --> 00:12:55,000
لذيذ

197
00:13:16,080 --> 00:13:19,900
لا حاجة للهرب. أنت مُمثّل زولتان

198
00:13:19,900 --> 00:13:21,610
!تصرّف على هذا الأساس

199
00:13:21,610 --> 00:13:23,180
!مؤلم

200
00:13:23,660 --> 00:13:25,070
أي مُمثِّل هو؟

201
00:13:25,640 --> 00:13:28,150
،عندما زرنا الزّوغ

202
00:13:28,150 --> 00:13:31,490
قال كبيرهم بأنّهم يواجهون مُشكلة
نظراً لضعف الأعمال التّجاريّة

203
00:13:33,440 --> 00:13:35,750
سيتولّى غودوين ذلك من الآن فصاعداً

204
00:13:37,990 --> 00:13:41,040
أنا مَدين لك بالكثير يا ريد

205
00:13:41,040 --> 00:13:44,430
وسيكون بخير حتّى لو واجه وحوشاً
في الطريق إلى هناك

206
00:13:44,430 --> 00:13:46,420
هل يمكن الوثوق بهذا الرّجل حقّاً؟

207
00:13:47,330 --> 00:13:49,180
!يمكن بالطّبع! الثّقة هي عنواني

208
00:13:49,500 --> 00:13:52,120
لديه المهارات على الأقلّ

209
00:13:52,120 --> 00:13:55,870
حريّ بك أن تسعى جاهداً للتّعويض عمّا فعلتَه

210
00:13:57,830 --> 00:14:00,210
يبدو أنّ الوقت قد حان للاختتاميّة العظيمة

211
00:14:00,210 --> 00:14:01,190
!هيّا بنا

212
00:14:11,850 --> 00:14:16,170
!التزم بالنصّ واسقط فحسب

213
00:14:17,550 --> 00:14:18,250
ماذا؟

214
00:14:18,250 --> 00:14:19,250
،أهذه أنتِ

215
00:14:19,250 --> 00:14:21,560
!يا مُحاربتي الحبيبة؟

216
00:14:21,560 --> 00:14:22,370
من هذا؟

217
00:14:22,370 --> 00:14:23,250
لا أدري

218
00:14:23,250 --> 00:14:25,840
!لا أستطيع رؤيتها

219
00:14:26,290 --> 00:14:27,790
لكنّه يحدِّق بكِ يا روتي

220
00:14:30,880 --> 00:14:35,220
إنّه الرّجل الّذي رميتِه عن الجسر
في الطريق إلى زولتان

221
00:14:38,370 --> 00:14:39,480
لا أتذكّر

222
00:14:41,160 --> 00:14:43,190
!اسمي أوتّو

223
00:14:43,190 --> 00:14:44,230
—من فضلكِ تذكّري كيف أنّنا

224
00:14:45,540 --> 00:14:46,280
ماذا؟

225
00:14:47,560 --> 00:14:50,070
أهذا أنت يا دانان؟

226
00:14:53,760 --> 00:14:55,120
مرحباً يا ريد

227
00:14:55,120 --> 00:14:57,360
!لم أرك منذ وقت طويل يا دانان

228
00:14:57,360 --> 00:15:00,210
سمعتُ بأنّكم ستقيمون في زولتان لبعض الوقت

229
00:15:01,180 --> 00:15:03,040
ماذا حدث لذراعك؟

230
00:15:03,040 --> 00:15:04,380
هذا ليس بالأمر الجلل

231
00:15:04,720 --> 00:15:06,400
!يبدو أمراً جللاً

232
00:15:07,110 --> 00:15:08,420
هل أنت بخير؟

233
00:15:08,420 --> 00:15:10,020
أنا بخير؟

234
00:15:10,020 --> 00:15:12,680
،أردتُ الخروج من الآن

235
00:15:12,680 --> 00:15:15,010
لكن ظلّ الطبيبُ ينقّ عليّ طالباً
منّي البقاء مكاني

236
00:15:15,470 --> 00:15:17,120
!لكن لا يبدو لي كذلك

237
00:15:17,120 --> 00:15:19,160
هذا يُعَدُّ كالتزام للمكان بالنّسبة لي

238
00:15:22,940 --> 00:15:25,940
!شيطان الشّتاء الملعون! إلى أين ذهب؟

239
00:15:26,180 --> 00:15:29,530
بئساً، عليّ أن ألعب دوري حتّى النّهاية

240
00:15:58,640 --> 00:16:01,440
أتمنّى لو أنّه كانت هناك طريقة
سهلة لجني بعض المال

241
00:16:01,440 --> 00:16:04,140
ربّما لو كان هناك كنز خفيّ ما في زولتان

242
00:16:04,140 --> 00:16:05,290
أليس كذلك؟

243
00:16:05,290 --> 00:16:08,820
!كسفينة هوائيّة أو ما شابه

244
00:16:09,120 --> 00:16:11,390
ولا بالأحلام

245
00:16:11,390 --> 00:16:12,760
بالطبع لا

246
00:16:31,750 --> 00:16:32,800
أخي

247
00:16:33,550 --> 00:16:36,430
شكراً على اليوم. استمتعتُ كثيراً

248
00:16:38,210 --> 00:16:40,340
حقّاً؟ يسرّني سماع ذلك

249
00:16:43,540 --> 00:16:46,320
لكن ما زال هناك شيء لم نفعله

250
00:16:49,870 --> 00:16:51,340
هل نرقص؟

251
00:16:51,790 --> 00:16:54,070
أنا؟ أرقص معك؟

252
00:16:56,390 --> 00:16:57,020
حسناً

253
00:16:58,020 --> 00:17:03,510
لكن آخر مرّة رقصتُ فيها معك
كانت قبل أن تصبح فارساً

254
00:17:04,390 --> 00:17:06,490
لن أكون بارعة في ذلك

255
00:17:06,490 --> 00:17:08,590
المسألة لا تتعلّق بمدى براعتكِ

256
00:17:09,360 --> 00:17:11,380
بل تتعلّق بمدى استمتاعكِ بالرّقص

257
00:17:11,990 --> 00:17:12,710
تعالي

258
00:17:17,780 --> 00:17:18,570
حسناً

259
00:17:21,930 --> 00:17:23,200
هل أنت متأكّد؟

260
00:17:23,830 --> 00:17:24,640
من ماذا؟

261
00:17:25,740 --> 00:17:30,400
هل يُسمَح لي بالشُّعور بهذه السّعادة حقّاً؟

262
00:17:32,630 --> 00:17:34,110
قلتُ لكِ لا عليكِ

263
00:17:35,550 --> 00:17:41,080
تحمّلتِ ألماً كبيراً لإسعاد الآخرين يا روتي

264
00:17:41,950 --> 00:17:46,080
أعتقد حان الوقت لتُسعدي نفسكِ

265
00:17:46,830 --> 00:17:47,990
...أخي

266
00:17:49,170 --> 00:17:50,370
شكراً لك

267
00:17:59,620 --> 00:18:01,160
هل تريدين بعض الخمر؟

268
00:18:01,160 --> 00:18:02,350
لا، لا داعي

269
00:18:03,710 --> 00:18:06,350
كيف وجدتِ فان؟

270
00:18:06,690 --> 00:18:09,100
إنّه يفوق توقّعاتي من نواحٍ عديدة

271
00:18:09,750 --> 00:18:11,060
حقّاً؟

272
00:18:11,760 --> 00:18:14,450
،بالنّظر إلى السجلّات الّتي أعطيتني إيّاها

273
00:18:14,450 --> 00:18:16,920
إنّه يتطوّر بوتيرة لا تُصدَّق

274
00:18:16,920 --> 00:18:22,080
لكن هذا يجعل إرساله إلى زولتان
يبدو مضيعة للوقت فحسب

275
00:18:22,890 --> 00:18:25,040
هل ذهبتِ إلى زولتان؟

276
00:18:25,380 --> 00:18:27,700
لفترة قصيرة فقط

277
00:18:27,700 --> 00:18:30,740
تلك البلد لا تحمل قيمة اقتصاديّة أو تاريخيّة

278
00:18:30,740 --> 00:18:32,040
لا شيء فيها

279
00:18:32,370 --> 00:18:35,860
،حتّى لو كانت سفينة ملِك الشّياطين هناك

280
00:18:35,860 --> 00:18:37,970
ما الفائدة الّتي سيجنيها فان من ذلك؟

281
00:18:38,290 --> 00:18:41,970
نحتاج لبعض المعلومات حتّى نتحقّق من ذلك

282
00:18:44,110 --> 00:18:48,870
إذا عُثِر على السّفينة، فأنا متأكّد
بأنّنا سنحتاج مساعدتكِ

283
00:18:52,700 --> 00:18:54,980
،سوف أعتمد عليكِ

284
00:18:55,440 --> 00:18:56,800
يا إسكارلاتا

285
00:19:02,640 --> 00:19:04,880
...انتهى المهرجان

286
00:19:04,880 --> 00:19:06,620
سيعود العام المقبل

287
00:19:07,150 --> 00:19:08,870
سوف نراه معاً في العام المقبل؟

288
00:19:09,280 --> 00:19:10,370
بالطبع

289
00:19:10,960 --> 00:19:12,380
والعام الّذي يليه؟

290
00:19:13,020 --> 00:19:13,880
وسنبقى معاً

291
00:19:29,570 --> 00:19:30,640
ما هذا؟

292
00:19:31,410 --> 00:19:32,430
هديّة لكِ

293
00:19:36,130 --> 00:19:36,820
...لحظة

294
00:19:37,360 --> 00:19:42,170
في الواقع، لم أستطع إحضار تلك
،الياقوتة الزّرقاء لكِ

295
00:19:42,170 --> 00:19:46,720
لكن هذه طريقتي في قطع وعدٍ عليكِ
بأنّني سأحضر ذلك الخاتم يوماً ما

296
00:19:46,720 --> 00:19:48,900
إنّه طوق خطوبة إذاً؟

297
00:19:48,900 --> 00:19:49,520
أجل

298
00:19:50,050 --> 00:19:50,710
خُذ

299
00:19:51,570 --> 00:19:52,460
ضعه لي

300
00:19:52,870 --> 00:19:54,210
حـ-حسناً

301
00:20:01,440 --> 00:20:02,870
كيف يبدو؟

302
00:20:04,410 --> 00:20:05,180
يبدو رائعاً

303
00:20:06,460 --> 00:20:07,180
أنتِ جميلة

304
00:20:10,400 --> 00:20:11,510
!بئساً

305
00:20:13,870 --> 00:20:15,250
!هذا ليس عدلاً

306
00:20:15,250 --> 00:20:15,900
ريت؟

307
00:20:16,470 --> 00:20:21,840
تطلب منّي انتظار خاتم لكن تحضر
لي شيئاً بهذا الجمال؟

308
00:20:21,840 --> 00:20:24,290
!هذا ليس عدلاً! أُحبّك

309
00:20:25,810 --> 00:20:31,290
من الأفضل أن تتحمّل مسؤوليّة
إخراج كلّ هذا الحُبّ منّي

310
00:20:32,460 --> 00:20:33,470
كيف ذلك؟

311
00:20:34,410 --> 00:20:35,420
...أنت وأنا

312
00:20:37,010 --> 00:20:39,920
سنسهب في النّوم غداً

313
00:20:42,140 --> 00:20:43,590
أنتِ غير عادلة بحدِّ ذاتكِ

314
00:20:54,030 --> 00:20:57,170
لا معلومات حول مكان السّفينة

315
00:20:57,700 --> 00:20:59,230
ربّما علينا أن نبذل جهداً أكبر

316
00:20:59,660 --> 00:21:03,270
لا تفعلوا. إنَّ إحداث جلبة سوف
يعقّد تحرّكاتنا أكثر

317
00:21:07,690 --> 00:21:08,660
!هذه أنتِ

318
00:21:09,660 --> 00:21:10,600
!لنهرب

319
00:21:13,700 --> 00:21:14,620
أوغيغي-سان

320
00:21:18,910 --> 00:21:21,710
!ما-ماذا تفعل تيسّي هنا؟

321
00:21:21,710 --> 00:21:24,220
لا بدّ أنّ شيئاً يجري هنا في زولتان

322
00:21:27,870 --> 00:21:29,530
!ما كلّ هذا بالضّبط؟

323
00:21:40,820 --> 00:21:42,120
تبّاً

324
00:21:55,110 --> 00:21:56,080
...هل أنت