1
00:00:03,480 --> 00:00:08,070
في المباريات الودّية لهذا اليوم، ستلعب
ألمانيا، البطل المُهيمن، مع اليابان؟

2
00:00:12,110 --> 00:00:16,660
.أشعر بالشفقة على فريقكم المُضيف
يلعب مع ألمانيا من البداية

3
00:00:18,780 --> 00:00:22,500
!تمّ اختيارك لتمثيل اليابان

4
00:00:22,500 --> 00:00:25,080
سألعب لصالح أمريكا

5
00:00:26,750 --> 00:00:28,210
!يا قصير

6
00:00:31,880 --> 00:00:33,920
أما زلت تفتقد لليابان؟

7
00:00:33,920 --> 00:00:34,970
ليس تماماً

8
00:00:34,970 --> 00:00:38,760
ريوما، هل أنت بخير؟ تبدو حزيناً

9
00:00:38,760 --> 00:00:40,430
هل تؤلمك معدتك؟

10
00:00:42,770 --> 00:00:45,390
أنا في أحسن حال

11
00:00:45,390 --> 00:00:50,610
انسوا أمر الفرق الأخرى. علينا
أن نفعل ما بوسعنا ونفوز

12
00:00:50,610 --> 00:00:52,650
حتّى لو كانت مُباراة ودّية

13
00:00:52,650 --> 00:00:54,990
أجل، أعلم

14
00:00:54,990 --> 00:00:59,030
ريوما، أنت في التّشكيل الرئيسي اليوم

15
00:01:01,160 --> 00:01:03,250
حسناً

16
00:01:03,250 --> 00:01:06,040
!اليوم هو يومنا

17
00:01:06,040 --> 00:01:07,750
!أنا أشتعل حماساً

18
00:01:07,750 --> 00:01:11,090
كين، ستُنهك نفسك قبل أن نصل حتّى

19
00:01:11,090 --> 00:01:14,630
هل سيصل تانيغاشيما في الوقت
ليلحق بالمباريّات الرئيسيّة؟

20
00:01:14,630 --> 00:01:16,550
إنّه قادم بقارب

21
00:01:16,550 --> 00:01:19,930
يكره ركوب الطائرات كما تعلم

22
00:01:19,930 --> 00:01:24,390
سيكون ثنائي مُباريات اليوم تلميذ
ثانويّة وتلميذ إعداديّة؟

23
00:01:24,390 --> 00:01:25,730
أجل

24
00:01:25,730 --> 00:01:28,600
أريد أن أشكّل ثنائيّاً مع أتوبي

25
00:01:28,600 --> 00:01:30,610
لا أريد

26
00:01:30,610 --> 00:01:32,980
أريد أن أشكّل ثنائيّاً مع الأمير كيمي

27
00:01:32,980 --> 00:01:37,610
الأمير كيمي! نسّق الأمور بحيث
أكون أنا وبيودوين ثنائيّاً

28
00:01:37,610 --> 00:01:39,200
هل تسمعني أيّها الأمير كيمي؟

29
00:01:39,200 --> 00:01:40,280
!يا أمير كيمي

30
00:01:40,280 --> 00:01:42,410
!هل تسمعني؟ الأمير كيمي -
!اصمت -

31
00:01:42,410 --> 00:01:44,080
!أنت -
!اصمت -

32
00:01:44,080 --> 00:01:45,700
هل تريد العودة إلى المنزل؟

33
00:01:45,700 --> 00:01:47,670
!مُحال أن أعود

34
00:01:55,880 --> 00:02:00,550
تتوافد الفِرق من البلدان الأخرى

35
00:02:01,760 --> 00:02:02,970
أجل

36
00:02:02,970 --> 00:02:06,560
،سويسرا وأستراليا، الفريق المُضيف

37
00:02:06,560 --> 00:02:07,980
...اليونان

38
00:02:10,270 --> 00:02:11,650
وفرنسا...

39
00:02:13,150 --> 00:02:15,610
!هيّا بنا يا فتيان

40
00:02:28,370 --> 00:02:29,750
حان الوقت

41
00:02:31,420 --> 00:02:34,670
حسناً إذاً. لنذهب أيّها القصير

42
00:02:37,970 --> 00:02:39,510
حسناً

43
00:02:42,390 --> 00:02:45,560
العالم في قبضتنا. فوزوا

44
00:02:45,560 --> 00:02:46,970
هذا كلّ شيء

45
00:02:46,970 --> 00:02:49,230
!أجل

46
00:04:21,610 --> 00:04:26,030
"!منافسة ما قبل كأس العالم تبدأ"

47
00:04:26,740 --> 00:04:32,830
:المُباراة الودّية لما قبل كأس العالم تحت 17
ألمانيا ضدّ اليابان

48
00:04:32,830 --> 00:04:35,080
!نرحّب بكلا الفريقين

49
00:04:36,500 --> 00:04:39,380
!أوّلاً، لدينا هنا فريق اليابان

50
00:04:40,500 --> 00:04:46,260
ثمّ الفائز للمرّة التاسعة بكأس العالم
...والبطل المُدافع عن اللّقب

51
00:04:46,260 --> 00:04:49,050
!فريق ألمانيا

52
00:04:56,520 --> 00:04:59,190
لا أحد مهتمّ باليابان حسبما أرى

53
00:04:59,190 --> 00:05:02,570
!هذا فولك! إنّه لاعب كرة مضرب محترف

54
00:05:02,570 --> 00:05:04,820
!إنّه هو بشحمه ولحمه

55
00:05:07,610 --> 00:05:08,910
...تيزوكا

56
00:05:13,410 --> 00:05:18,000
!المُباراة الودّية: أمريكا ضدّ جمهوريّة تيوب

57
00:05:26,760 --> 00:05:31,010
إنّه هو حقّاً في فريق ألمانيا إذاً؟

58
00:05:32,350 --> 00:05:37,350
هذا التّعبير الهادئ السّاخط في
نفس الوقت... لم يتغيّر

59
00:05:37,350 --> 00:05:42,150
أجل، لكن هالة تيزوكا ازدادت شدّة

60
00:05:42,150 --> 00:05:46,570
لم أتوقّع أن نكون خصوماً هكذا

61
00:05:49,320 --> 00:05:52,240
سوف نبدأ الآن بالمباراة الأولى

62
00:05:52,240 --> 00:05:55,080
فلتخرجا وتكونا أوّل من يموت

63
00:05:55,080 --> 00:05:58,210
كم أنا متوتّر

64
00:05:58,210 --> 00:06:01,040
ستكون الهجمة الأولى ضدّ العالم من نصيبنا

65
00:06:01,040 --> 00:06:05,090
لنستشعر ما يعنيه أن نلعب مع العالم

66
00:06:05,090 --> 00:06:07,380
انتظر يا سيغفريد

67
00:06:07,380 --> 00:06:09,680
ما الأمر يا كيو-بي؟

68
00:06:09,680 --> 00:06:13,720
سيكون من الأحسن سؤال تيزوكا حول فريق اليابان

69
00:06:13,720 --> 00:06:17,020
كان حاضراً في معسكر تدريب الفريق الياباني

70
00:06:20,730 --> 00:06:25,730
إنّه ليس ألمانيّاً. أوتظنّه سيقدّم
معلومات صادقة عن فريق اليابان؟

71
00:06:25,730 --> 00:06:27,610
كُفّ عن ذلك يا سيغفريد

72
00:06:27,610 --> 00:06:29,740
!لا، لا، لا! لا جدوى من هذا

73
00:06:33,330 --> 00:06:35,330
المُباراة الأولى

74
00:06:35,330 --> 00:06:40,210
من ألمانيا: مايكل بيسامرك، إلمار سيغفريد

75
00:06:40,210 --> 00:06:43,710
من اليابان: ديوك واتانابي، شوسكي فوجي

76
00:06:43,710 --> 00:06:49,130
!ألمانيا! ألمانيا! ألمانيا

77
00:06:50,130 --> 00:06:54,760
.الأفضل في مُباراة من دورة واحدة
ألمانيا في الإرسال

78
00:06:54,760 --> 00:06:56,600
أيّها الفتى اليابانيّ

79
00:06:59,940 --> 00:07:03,190
--تمنَّ فقط ألّا يكره أصدقاؤك الصّغار كرة المضرب بعد أن

80
00:07:08,530 --> 00:07:10,990
ديوك هوم ران

81
00:07:16,740 --> 00:07:18,410
0-15

82
00:07:19,710 --> 00:07:23,380
أهذا ما أردته يا زعيم؟

83
00:07:23,380 --> 00:07:27,130
غيّرَ مزاج الميدان بأكمله برمية واحدة

84
00:07:27,130 --> 00:07:30,510
مرحى! حقّقنا اللّكمة الأولى ضدّ
!ألمانيا، الأبطال

85
00:07:30,510 --> 00:07:32,970
!أحرزَ السيّد هوم ران

86
00:07:32,970 --> 00:07:34,850
حسناً، حسناً

87
00:07:34,850 --> 00:07:39,350
لم أكن أتوقّع منك الكثير. يمكنك
البقاء في تلك الزاوية فحسب

88
00:07:39,350 --> 00:07:43,730
يمكنني الظفر بهذه المُباراة بمفردي

89
00:07:43,730 --> 00:07:45,810
إنّه جادّ، صحيح؟

90
00:07:45,810 --> 00:07:47,730
أجل

91
00:07:47,730 --> 00:07:50,280
قوّتك تلك مُزعجة

92
00:07:50,280 --> 00:07:54,280
لكن الشّريكين ذوي الشخصيّة القويّة
يتحطّمان بسهولة أكبر

93
00:07:57,870 --> 00:08:00,450
،على سبيل المثال، بهذه الرّمية اللّادورانيّة المتأرجحة

94
00:08:03,620 --> 00:08:07,630
.لتكبح ديوك هوم ران خاصّتك
وتُجبَر على اتّخاذ وضعيّة دفاعيّة

95
00:08:07,630 --> 00:08:10,840
!لا يمكنكما الفوز ما لم تهاجما

96
00:08:12,680 --> 00:08:14,260
يركض فوجي نحو الشّبكة؟

97
00:08:14,260 --> 00:08:18,430
لماذا لا يستخدم هجمته المُرتدّة الثلاثيّة... هبوط الدبّ؟

98
00:08:18,430 --> 00:08:22,730
آنذاك، أقسمتُ أن أفعل ثلاثة أشياء يا تيزوكا

99
00:08:24,560 --> 00:08:26,650
!يمكن لشوسكي فوجي أن يُولَد من جديد

100
00:08:28,070 --> 00:08:29,570
0-30

101
00:08:30,530 --> 00:08:33,740
ردَّ الضربة القويّة بضربة قويّة أخرى

102
00:08:33,740 --> 00:08:36,820
الرّياح الحرجة: العاصفة الثلجيّة الخِطمِيّة

103
00:08:41,910 --> 00:08:45,080
لم أعُد ألعب كرة مضرب دفاعيّة

104
00:08:49,670 --> 00:08:51,380
!ركضَ فوجي نحو الشّبكة ثانية

105
00:08:51,380 --> 00:08:53,840
!لا يستخدم هجماته المُرتدّة الثلاثيّة فعلاً؟

106
00:08:53,840 --> 00:08:56,260
هذا أسلوب الجديد في اللّعب

107
00:08:57,590 --> 00:09:00,180
!العاصفة الثلجيّة الخِطمِية

108
00:09:00,180 --> 00:09:02,810
شوط، اليابان. 0-1

109
00:09:02,810 --> 00:09:04,770
يا له من إنجاز مُبهِر

110
00:09:04,770 --> 00:09:09,650
ردّ ضربة قويّة بأخرى قويّة؟ لا بدّ أنّه عبقريّ

111
00:09:09,650 --> 00:09:15,240
.يعتزّ فوجي بنفسه في هجماته المرتدّة
أنا متفاجئ من أسلوبه الخشن في اللّعب

112
00:09:15,240 --> 00:09:18,280
هذا يختلف بشكل كبير عن بياناتنا
حول فريق اليابان

113
00:09:18,280 --> 00:09:20,990
إنّه كلاعب مختلف تماماً

114
00:09:20,990 --> 00:09:24,620
ماذا حدث معه بالضبط؟

115
00:09:24,620 --> 00:09:26,580
...فوجي

116
00:09:26,580 --> 00:09:31,170
،تيزوكا، قبل أن تسافر إلى ألمانيا لتصبح محترفاً

117
00:09:31,170 --> 00:09:33,670
تحدّيتُك في مباراة

118
00:09:33,670 --> 00:09:37,970
...عرفتُ بأنّني لن أستطيع الفوز، لكن تحدّيتُك

119
00:09:37,970 --> 00:09:40,850
بنيّة اعتزال كرة المضرب بعد أن تهزمني...

120
00:09:43,640 --> 00:09:46,480
وداعاً يا كونيميتسو تيزوكا

121
00:09:48,190 --> 00:09:50,190
!لماذا يا فوجي؟

122
00:09:55,440 --> 00:10:00,070
لا جدوى من هذا. من المُحال أن
تتمكّن من هزيمة تيزوكا الآن

123
00:10:13,170 --> 00:10:15,210
تـ-تيزوكا، لماذا؟

124
00:10:15,210 --> 00:10:17,220
لماذا اعتزلت في منتصف المُباراة؟

125
00:10:17,220 --> 00:10:20,140
--ألا تشفق على فوجي؟ أكمل مباراتك

126
00:10:20,140 --> 00:10:23,640
لن ألعب مع فوجي بوضعه الرّاهن

127
00:10:35,900 --> 00:10:37,360
...فوجي

128
00:11:15,940 --> 00:11:20,070
أنا واثق بأنّ فوجي يستطيع رؤية تيزوكا

129
00:11:23,620 --> 00:11:27,790
حتّى الآن، كنتَ دليلي

130
00:11:27,790 --> 00:11:30,710
وصلتُ إلى هذه المرحلة بفضلك

131
00:11:30,710 --> 00:11:35,250
لأنّك كنت دوماً بجانبي لتوجّهني
نحو الطريق الصّحيح

132
00:11:35,250 --> 00:11:40,220
وها أنت الآن تذهب إلى ألمانيا لتصبح محترفاً؟

133
00:11:40,220 --> 00:11:44,140
رؤيتي ضبابيّة لكرة المضرب. لا معنى
لها بالنسبة لي

134
00:11:44,140 --> 00:11:47,260
!الآن لم أعُد أملك دليلاً أيضاً

135
00:11:49,350 --> 00:11:53,940
ارتأيتُ بأنّني إذا تكبّدتُ خسارة
مُذلّة، سأكره كرة المضرب

136
00:11:53,940 --> 00:11:55,730
...لكن

137
00:11:55,730 --> 00:12:00,030
لن تدعني أعتزل كرة المضرب، صحيح؟...

138
00:12:02,450 --> 00:12:03,490
...فوجي

139
00:12:05,410 --> 00:12:09,750
يجب أن تجد طريقك الخاص...

140
00:12:09,750 --> 00:12:12,210
...تيزوكا

141
00:12:12,210 --> 00:12:18,170
غادرتَ المُباراة لأنّك لم ترد
أن تكون دليلي؟

142
00:12:20,880 --> 00:12:25,510
فعلتَ ذلك لأجلي، بما أنّني كنتُ
دوماً أعتمد عليك كثيراً

143
00:12:25,510 --> 00:12:29,180
لطالما كنتَ تسبقني بخطوة

144
00:12:30,520 --> 00:12:33,640
!في هذه الحالة، سأخطو إضافيّة

145
00:12:40,780 --> 00:12:43,070
...شوط ومباراة

146
00:12:44,780 --> 00:12:47,620
شوسكي فوجي...

147
00:12:53,750 --> 00:12:57,210
شكراً لك يا كونيميتسو تيزوكا

148
00:13:12,560 --> 00:13:15,600
شوط لليابان. 5-5

149
00:13:15,600 --> 00:13:18,690
هزمانا ثانية

150
00:13:18,690 --> 00:13:20,110
فعلَها فوجي

151
00:13:20,110 --> 00:13:21,650
يتحرّك بتقنيّة عالية

152
00:13:21,650 --> 00:13:24,570
!لقنّاهم درساً يا زعيم

153
00:13:24,570 --> 00:13:28,570
لم يبدأ العرض بعد. أليس كذلك يا ديوك؟

154
00:13:28,570 --> 00:13:32,410
هل يمكنني أن أطلق العنان الآن يا زعيم؟

155
00:13:34,410 --> 00:13:38,380
!العب... بالكُرة

156
00:13:38,380 --> 00:13:40,420
!ماذا يفعل بالتّحديد؟

157
00:13:40,420 --> 00:13:42,550
كم هذا مُخزٍ

158
00:13:42,550 --> 00:13:44,510
!إنّه طريف جدّاً

159
00:13:50,720 --> 00:13:51,850
0-15

160
00:13:51,850 --> 00:13:53,890
!مذهل

161
00:13:53,890 --> 00:13:57,020
!حتّى لو تمكّنت من إصابة هذه، سيتحطّم مضربك

162
00:13:57,020 --> 00:14:00,860
"كان ديوك يُعرَف في السّابق بـ"المُدمّر

163
00:14:03,280 --> 00:14:06,150
شوط لليابان، 5-6

164
00:14:11,280 --> 00:14:13,580
أحسنت صنعاً يا ريوما

165
00:14:13,580 --> 00:14:15,660
بالكاد بذلتُ جهداً

166
00:14:15,660 --> 00:14:20,380
هذا لأنّكما فرضتُما هيمنتكما ولم تُجهدا نفسيكما

167
00:14:20,380 --> 00:14:23,340
كانا ضعيفين فحسب. الذنب ليس ذنبي

168
00:14:25,960 --> 00:14:30,340
على هذا المُعدّل، لن أحظى أنا ورالف
بدور لِلّعب في المُباريات الرئيسيّة

169
00:14:30,340 --> 00:14:32,970
لن ينجح الأمر في المُباريات الرئيسيّة كمُباراة اليوم

170
00:14:32,970 --> 00:14:35,470
سنكون ضدّ الأفضل في العالم

171
00:14:35,470 --> 00:14:38,390
!هيّا يا سيّد مُدمّر

172
00:14:40,730 --> 00:14:42,270
!مرحى! أحرزا هذه

173
00:14:42,270 --> 00:14:43,480
ليس بعد

174
00:14:45,320 --> 00:14:46,780
!جميل يا فوجي

175
00:14:46,780 --> 00:14:49,320
!دورك يا سيغفريد

176
00:14:51,700 --> 00:14:52,950
!ضربة قويّة

177
00:14:52,950 --> 00:14:54,410
!إنّها العاصفة الثلجيّة الخِطمِيّة الخاصّة بفوجي

178
00:14:54,410 --> 00:14:57,910
تمكّنتُ من دراسة عاداتك في اللّعب بالتفصيل

179
00:14:59,420 --> 00:15:01,210
!بالإضافة إلى إذلالك

180
00:15:02,380 --> 00:15:04,590
!تمّت مُناورته

181
00:15:04,590 --> 00:15:06,130
!يستطيع ديوك اللّحاق بها

182
00:15:06,130 --> 00:15:11,510
مع الأسف! ستخرج كافّة تسديدات
هوم ران خاصّتك عن تلك الزاوية

183
00:15:11,510 --> 00:15:13,350
ضربة ديوك الرّقيقة

184
00:15:15,010 --> 00:15:19,560
لدى ديوك أسلوب لعب رقيق من الأساس

185
00:15:19,560 --> 00:15:21,600
!أبليتَ حسناً يا سيغفريد

186
00:15:25,150 --> 00:15:27,860
!الهجمة المُرتدّة الثلاثيّة، التنّين الأبيض

187
00:15:44,000 --> 00:15:45,210
...فوجي

188
00:15:46,750 --> 00:15:50,970
كنتُ أنتظر أن تلعب بحقيقتك طوال هذا الوقت

189
00:15:50,970 --> 00:15:52,800
حتّى المُباريّات الرئيسيّة

190
00:15:57,260 --> 00:15:59,140
!شوط ومُباراة، اليابان

191
00:16:01,640 --> 00:16:03,060
!مرحى -
!مذهل -

192
00:16:03,060 --> 00:16:05,900
!حقّقنا فوزنا الأوّل ضد ألمانيا! مرحى

193
00:16:07,230 --> 00:16:09,740
سوف نتابع الآن نحو مباراتنا الثّانية

194
00:16:09,740 --> 00:16:13,110
أنتما التّاليان. فلتخضعا للجحيم

195
00:16:14,200 --> 00:16:17,030
هل سأكون شريكاً مناسباً له؟

196
00:16:17,030 --> 00:16:19,750
كلّ ما تقوله يثير أعصابي

197
00:16:19,750 --> 00:16:22,830
هل ربحت اليابان شوطاً واحداً حتّى؟

198
00:16:22,830 --> 00:16:26,880
لم تخسر ألمانيا أيّ مُباراة حتّى في الودّيات

199
00:16:26,880 --> 00:16:32,010
!مهلاً، اليابان هزمت ألمانيا في المُباراة الأولى

200
00:16:32,010 --> 00:16:34,430
بجدّية؟ هزمت ألمانيا؟

201
00:16:34,430 --> 00:16:36,220
اليابان ممتازة يا ريوما

202
00:16:36,220 --> 00:16:38,470
أعتقد ألمانيا ليست بالأمر الجلل

203
00:16:39,390 --> 00:16:41,060
كُن صريحاً فحسب

204
00:16:41,060 --> 00:16:42,310
أيّاً يكن

205
00:16:42,310 --> 00:16:46,650
حسناً، بصفتها البطلة، لن تقبل ألمانيا بهذا

206
00:16:47,900 --> 00:16:52,780
!كيو-بي! كيو-بي! كيو-بي

207
00:16:52,780 --> 00:16:55,780
لماذا الجمهور متحمّس جدّاً؟

208
00:16:55,780 --> 00:17:01,200
بينما كلّ العيون تترصّدني، قد لا أتمكّن
من إظهار عِشر من قوّتي

209
00:17:01,200 --> 00:17:04,040
لماذا يردّدون دوماً باسم مايونيز كيوبي؟

210
00:17:04,040 --> 00:17:07,040
ربّما لأنّه سيقلي خصومه في غضون ثلاث دقائق؟

211
00:17:07,040 --> 00:17:10,300
"كيو-بي هو اختصار لـ"الجودة المثاليّة

212
00:17:11,760 --> 00:17:15,590
بفضل ذلك اللّقب، صنعَ اسمه

213
00:17:15,590 --> 00:17:18,550
اسمه الحقيقيّة ومسقط رأسه مجهولان

214
00:17:18,550 --> 00:17:21,850
تلقّى تدريباً احترافيّاً في كرة المضرب
منذ نعومة أظفاره

215
00:17:21,850 --> 00:17:24,600
إنّه النّخبة في أكاديميّته لكرة المضرب

216
00:17:24,600 --> 00:17:27,060
إنّه عقل الفريق الألماني

217
00:17:27,060 --> 00:17:30,400
يُقال بأنّه التّحفة العظمى في
أكاديميّة كرة المضرب الألمانيّة

218
00:17:30,400 --> 00:17:32,610
!نحن في ورطة حقيقيّة

219
00:17:32,610 --> 00:17:37,450
فريق ألمانيا متلهّف للفوز بكأس العالم العاشر لهم

220
00:17:37,450 --> 00:17:39,580
هيّا يا كونيميتسو

221
00:17:41,830 --> 00:17:43,080
حاضر

222
00:17:43,080 --> 00:17:44,660
!تيزوكا

223
00:17:44,660 --> 00:17:49,130
شكراً على قيادة الجميع هنا يا أتوبي

224
00:17:49,130 --> 00:17:52,590
كلام ينمّ عن غطرسة

225
00:17:52,590 --> 00:17:53,630
المباراة الثّانية

226
00:17:53,630 --> 00:17:57,470
من ألمانيا: كيو-بي، كونيميتسو تيزوكا

227
00:17:57,470 --> 00:18:01,390
من اليابان: كاناتا إيري، كيغو أتوبي

228
00:18:01,390 --> 00:18:04,100
سيلعب كيو-بي من فريق ألمانيا

229
00:18:04,100 --> 00:18:05,850
إنّهم مُصِرُّون

230
00:18:05,850 --> 00:18:07,810
لن يتخلّوا عن فوز آخر

231
00:18:07,810 --> 00:18:09,860
وبعد؟ من شريكه؟

232
00:18:09,860 --> 00:18:11,980
كونيميتسو تيزوكا

233
00:18:27,410 --> 00:18:30,040
ما الأمر يا أتوبي؟

234
00:18:30,040 --> 00:18:32,250
إلى متى ستظلّ راكعاً مكانك؟

235
00:18:32,250 --> 00:18:38,430
!ألمانيا! ألمانيا! ألمانيا

236
00:18:43,510 --> 00:18:47,520
أهكذا أصبحتْ قوّتك؟

237
00:18:51,190 --> 00:18:52,770
...أتوبي

238
00:19:00,240 --> 00:19:03,910
!ماذا تفعل يا كيغو أتوبي؟

239
00:19:07,500 --> 00:19:12,630
!أتسرِّع من عمليّة تطوّرك؟! كفاك مُزاحاً

240
00:19:15,500 --> 00:19:17,130
...أنا

241
00:19:21,720 --> 00:19:23,720
شوط ومُباراة، ألمانيا

242
00:19:25,720 --> 00:19:30,060
أعتقد لم تكن هناك حاجة لاستخدام عِشر قوّتي

243
00:19:30,060 --> 00:19:32,900
يعزو الفضل لك يا كونيميتسو

244
00:19:32,900 --> 00:19:37,110
هذا... هذا هو العالم

245
00:19:37,110 --> 00:19:40,030
ربحت ألمانيا 0-6

246
00:19:40,030 --> 00:19:41,490
توقّعتُ هذا

247
00:19:43,450 --> 00:19:48,500
!ألمانيا! ألمانيا! ألمانيا

248
00:19:51,040 --> 00:19:54,290
!لحظة! إلى أين أنت ذاهب يا أتوبي؟

249
00:19:56,000 --> 00:19:58,960
!أتوبي! لم تنتهِ المُباريات

250
00:19:58,960 --> 00:20:00,380
!لحظة

251
00:20:03,300 --> 00:20:06,970
اكتشفتُ ما أفتقر له

252
00:20:08,770 --> 00:20:11,940
فهمت. اذهب إذاً

253
00:20:17,230 --> 00:20:20,070
اللّعنة! ما زلنا متعادلين بنتيجة 1-1

254
00:20:20,070 --> 00:20:22,610
!لنهزمهم في هذه المُباراة الأخيرة

255
00:20:23,990 --> 00:20:27,580
!فولك! فولك! فولك

256
00:20:27,580 --> 00:20:29,410
!فولك يلعب مُباراة ودّية؟

257
00:20:29,410 --> 00:20:32,040
يبدو أنّنا أغضبنا ألمانيا

258
00:20:32,790 --> 00:20:38,210
جورغن بوريسوفيتش فولك، المُلقّب
"بـ"فيلسوف النّصر

259
00:20:38,210 --> 00:20:41,670
أصبح محترفاً في العام الفائت وظلّ بلا هزيمة

260
00:20:41,670 --> 00:20:45,550
ماذا؟! فولك من فريق ألمانيا سيلعب حقّاً

261
00:20:45,550 --> 00:20:46,550
فولك؟

262
00:20:46,550 --> 00:20:50,390
عجباً، ألمانيا مُلحّة على تدمير اليابان حقّاً

263
00:20:50,390 --> 00:20:52,140
سأشاهد مُباراة ألمانيا

264
00:20:52,140 --> 00:20:54,400
هل تستكشف لاعبيهم؟

265
00:20:54,400 --> 00:20:56,650
ريوما، ينبغي أن تأتي أيضاً

266
00:20:56,650 --> 00:20:58,860
لا، لستُ بحاجة لذلك

267
00:20:58,860 --> 00:21:04,280
رالف، إنّه فتى مُعاند، لذا فالأوامر
المُباشرة لن تفلح

268
00:21:04,280 --> 00:21:09,240
هيّا بنا. ما زلت لا تعرف طبيعة العالم

269
00:21:09,240 --> 00:21:12,160
أو كيف سيلعب اليابان ضدّ العالم

270
00:21:14,120 --> 00:21:19,750
!فولك! فولك! فولك

271
00:21:23,550 --> 00:21:26,140
اسمح لي أن ألعب

272
00:21:26,140 --> 00:21:28,260
افعل ما يحلو لك

273
00:21:28,260 --> 00:21:31,140
من منّا ينبغي أن يلعب؟

274
00:21:31,140 --> 00:21:33,310
...يا شباب

275
00:21:35,100 --> 00:21:37,900
هلّا سمحت لي باللّعب؟...

276
00:23:10,700 --> 00:23:13,660
الثّنائي التّالي سيكون توكوغاوا ويوكيمورا

277
00:23:13,660 --> 00:23:15,290
ثنائي مُثير للاهتمام

278
00:23:15,290 --> 00:23:18,830
ماذا؟ فقدَ يوكيمورا حواسه الخمس؟

279
00:23:18,830 --> 00:23:21,500
"الحلقة القادمة، "لحظة من المستقبل

280
00:23:19,670 --> 00:23:25,000
"لحظة من المستقبل"

281
00:23:21,500 --> 00:23:25,380
يوكيمورا، هل تتذكّر مُباراتنا؟

282
00:23:25,000 --> 00:23:25,960
أمير كرة المضرب الجزء الثّاني"
"كأس العالم تحت 17 سنة
"فقرة إضافيّة"

283
00:23:25,380 --> 00:23:27,210
تيزوكا، أبليتَ حسناً

284
00:23:25,960 --> 00:23:39,980
'واغا يومي نو دايشو"
"كونيميتسو تيزوكا

285
00:23:27,210 --> 00:23:29,630
أجل، كانت مُباراة ذات مغزى

286
00:23:29,630 --> 00:23:32,090
ما الّذي كان يدور في رأسك أثناء المُباراة؟

287
00:23:32,090 --> 00:23:34,560
لا أستطيع إخبارك بذلك

288
00:23:34,560 --> 00:23:37,470
يمكن معرفة الأمر بالاستماع جيّداً
--إلى أغنية هذه الشخصيّة

289
00:23:37,470 --> 00:23:39,520
فوجي، لا تتلفّظ بكلمة أخرى