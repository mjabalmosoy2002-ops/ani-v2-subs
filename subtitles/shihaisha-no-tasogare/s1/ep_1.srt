1
00:01:02,710 --> 00:01:12,720
‫منذُ بدايةِ الزمان، أنجبت أُمُّنا العظيمة الكثيرَ من مخلوقاتِ هَذِهِ الأرضِ‬‫.

2
00:01:13,340 --> 00:01:15,640
...عِندما خلقت الإنسان

3
00:01:15,640 --> 00:01:20,010
.خَلَقَت معهُمُ الشَّياطِينَ أيضًا، لِتكوُنَ عدُوَّهُمُ الأزليَّ

4
00:01:20,010 --> 00:01:24,410
.كي تُعلِمَ البشريةَ مُحاربةِ الخوف

5
00:01:25,320 --> 00:01:31,940
.فِي نَفسِ الوَقتِ، خُلِقَت قَبِيلَةٌ لِتَحمِيَ البَشَرَ مِنهُم

6
00:01:31,940 --> 00:01:35,250
.سُمّوا بِالحُراسِ

7
00:01:36,370 --> 00:01:39,170
...الشياطين والحُراس

8
00:01:39,170 --> 00:01:44,250
...رُغمَ أنَّهُم أتوا مِن أُمٍ واحدةٍ ودمٍ واحدٍ

9
00:01:44,250 --> 00:01:50,840
.في أعماقِهِم، شُعلةُ حقدٍ خافِتةٌ

10
00:01:51,550 --> 00:01:54,730
...إنَّها نارٌ لن تهدأ

11
00:01:54,730 --> 00:02:00,210
.حتى ينقرِضُ أحدُهُما

12
00:02:03,560 --> 00:02:18,120
.شَفَقُ سيِّدِ الظّلامِ

13
00:02:21,270 --> 00:02:22,490
...توقف

14
00:02:29,540 --> 00:02:31,670
!أرجُوكَ... توقف

15
00:03:41,060 --> 00:03:42,610
!هُناك

16
00:03:56,750 --> 00:03:58,450
!سُحقًا

17
00:03:58,450 --> 00:04:00,880
!أيُّها الوحشُ اللعين

18
00:04:03,040 --> 00:04:04,640
.ب-3، أجِب

19
00:04:05,240 --> 00:04:07,150
!ب-3، أجِب

20
00:04:07,150 --> 00:04:10,040
.صِف الهدف الَّذِي تُطلِقُ عليه

21
00:04:25,200 --> 00:04:26,390
!ما هذا الشيء؟

22
00:04:26,390 --> 00:04:28,290
!إنهُ قادمٌ نحونا

23
00:04:29,570 --> 00:04:33,610
.تبًا! لو كانت معنا خوذة فريق الهارد سيت لالتقطنا صورةً واضحة

24
00:04:33,610 --> 00:04:36,430
!لسنا بعيدين عنهُم، لِنُسرِع

25
00:04:44,210 --> 00:04:47,440
.تُشيرُ الإحداثيَّاتُ إلى هذا المكان

26
00:04:50,930 --> 00:04:53,800
!ب-3، ب-4، ب-5، أَجِيبُوا

27
00:04:53,800 --> 00:04:56,940
!بسرعة، ب-3، ب-4
.لن تُجاب

28
00:04:57,460 --> 00:05:00,690
.بِالنَّظرِ إلى الوضعِ، لا بُدَّ أنَّهُم سمِعوك

29
00:05:01,490 --> 00:05:04,560
.أغلِقوا المُقاطعة الغربِيَّةَ. طوِّقوا المنطقة

30
00:05:04,560 --> 00:05:07,400
.أستدعي الهارد سيت إلى الحديقة المركزية

31
00:05:07,400 --> 00:05:11,450
بسرعة. حول الوحدة إلى الهارد سيت

32
00:05:12,050 --> 00:05:13,620
.إحذر من الهدف

33
00:05:13,620 --> 00:05:15,260
!عُلِم

34
00:05:45,550 --> 00:05:47,720
!لَقَد أَصَبنَاهُ! أَصَبنَا العَدُوَّ

35
00:05:47,720 --> 00:05:49,310
!نَطلُبُ دَعمًا فَورِيًّا

36
00:05:49,310 --> 00:05:51,660
.مفهوم. سنوافيكُم سريعًا

37
00:05:52,620 --> 00:05:53,710
.أوقِف الصاعق

38
00:05:53,790 --> 00:05:55,920
!عُلِم

39
00:05:57,460 --> 00:05:58,930
...مُحقق كوميزاوا

40
00:05:58,930 --> 00:06:01,130
.لَم نَجِدِ الهَدَفَ في المُقَاطَعَةِ الأُولَى

41
00:06:01,130 --> 00:06:03,930
.مفهوم، توجه إلى المقاطعة الثانية

42
00:06:03,930 --> 00:06:06,640
.سأُرسِلُ تعزيزاتٍ إلى المنطقتينِ الثالثةِ والرابعةِ

43
00:06:06,640 --> 00:06:08,130
.عُلِم

44
00:06:17,170 --> 00:06:18,970
!اِستَعِدَّ لِلإِقْلَاعِ بِسُرعَةٍ

45
00:06:18,970 --> 00:06:20,440
!عُلِم

46
00:06:22,220 --> 00:06:25,640
.تغيَّرت وِجهةُ العيِّنةِ الَّتجرِيبِيَّةِ

47
00:06:25,640 --> 00:06:28,450
.وجهتُهُ هي ناديكَ الليلي يا كودو

48
00:06:29,320 --> 00:06:33,200
!لا تُحضِرِي هذا الشَّيء إلى محلي

49
00:06:33,200 --> 00:06:36,630
ألم تعُد تُطيعُ الآوامرَ؟

50
00:06:36,630 --> 00:06:38,580
.هَذِهِ أوامِرُ تاكميا-ساما

51
00:06:39,530 --> 00:06:41,580
.افعل ما يحلو لك

52
00:06:42,110 --> 00:06:49,840
‫نَصحَتُ السَّيِدَ تاكاميا بِأَنَّك الأنسب لِجمعِ الفَرائِسِ لِذَاكَ "الشَّيءِ"‬‫.

53
00:06:52,050 --> 00:06:54,350
!اكتمل النقل

54
00:06:54,840 --> 00:06:56,840
.مُمتاز، سَنُغادِرُ فورًا

55
00:06:56,840 --> 00:06:58,450
!عُلِم

56
00:06:59,020 --> 00:07:04,400
.كودو-سان، أَسرِع رَجَاءً، وَاعتَد على تَلَقِّي الأَوَامِرِ مِنَّا

57
00:07:24,610 --> 00:07:26,670
...عليَّ أن أقتُلَ

58
00:07:28,680 --> 00:07:30,310
.الشَّيطان

59
00:07:34,290 --> 00:07:36,310
...يجِبُ أن أقتُل

60
00:07:38,760 --> 00:07:40,440
.الشَّيطان

61
00:07:44,300 --> 00:07:46,290
...عليَّ أن أقتُلَ

62
00:08:13,130 --> 00:08:14,550
...يجِبُ أن أقتُل

63
00:08:52,470 --> 00:08:55,050
.سَيُشعِرُكِ بِالدّفءِ

64
00:08:55,700 --> 00:08:58,620
.ملابِسُكِ مُبلَّلةٌ تمامًا، لِذَلِكَ أُجفِّفُها

65
00:08:58,620 --> 00:09:00,560
.يُمكِنُكِ إرتِداؤها لاحقًا

66
00:09:00,970 --> 00:09:02,310
.شكرًا

67
00:09:02,670 --> 00:09:06,330
.اسمي تينكو

68
00:09:06,330 --> 00:09:08,200
.سُررتُ بِلقائِكِ

69
00:09:08,950 --> 00:09:11,200
هَل لِي بِسُؤالٍ؟

70
00:09:11,200 --> 00:09:17,750
هل تعتادِينَ التَّمشِّي ليلًا تحتَ المطرِ في مِنطَقَةٍ كهَذِهِ؟

71
00:09:18,230 --> 00:09:20,830
.أبحثُ عن شيطانٍ

72
00:09:22,370 --> 00:09:24,830
.هذا المكان مُمتلئٌ بالشياطين

73
00:09:28,520 --> 00:09:32,130
.هَذِهِ مجموعةُ صديقي

74
00:09:32,130 --> 00:09:34,800
.أُدِيرُها وأعرِضُها

75
00:09:34,800 --> 00:09:37,510
.لكِن نادِرًا ما يزوروها أحدٌ

76
00:09:38,310 --> 00:09:40,100
.فهمت

77
00:09:41,840 --> 00:09:45,520
.أبحثُ عن شيطانٍ حقيقي

78
00:09:47,230 --> 00:09:51,370
.لِحُسنِ حَظِّكِ، صديقي يبرعُ في العُثورِ على الشَّياطين

79
00:09:51,370 --> 00:09:53,980
.لَا تَفُوتُهُ أَصغَرُ التَّفَاصِيلِ

80
00:09:53,980 --> 00:09:56,530
.يُمكِنُنِي تقديمُكِ إليه إذا أردتِ

81
00:10:01,400 --> 00:10:04,800
.سمِعتُ أنّهُ لا أحدَ يعيشُ في هَذِهِ المنطقة

82
00:10:04,800 --> 00:10:07,530
.قانونيًا، لا

83
00:10:07,530 --> 00:10:14,770
أَتَعرِفينَ أَنَّ ضَوءًا غَامِضًا غَطَّى هَذِهِ المِنطَقَةَ قَبلَ ثَلَاثِينَ سَنَةً وَمَاتَ كُلُّ سُكَّانِهَا؟

84
00:10:14,770 --> 00:10:16,460
.أجل

85
00:10:16,460 --> 00:10:18,570
.أُجرِيَ بعدها تحقيقٌ

86
00:10:18,570 --> 00:10:23,940
‫أغلقت الحُكُومة هَذِهِ المنطقة دونَ إِيجَادِ مُسبِّبَ الكارِثةِ‬‫.

87
00:10:24,790 --> 00:10:30,650
‫أمَّا الآن، فإنَّ السُّكَّان الجُدُد لِهَذِهِ المِنطقة صَنَعُوا حَقِيقَتَهُم الخاصَّة‬‫.

88
00:10:32,100 --> 00:10:33,740
...بِصراحة

89
00:10:33,740 --> 00:10:36,290
.وُلِدتُ وَنَشَأتُ هُنا

90
00:10:36,900 --> 00:10:39,320
.هُنا حَيثُ اَلتَقَيتُهُ

91
00:10:41,910 --> 00:10:45,940
.يُدعَى شيجو تسونامي

92
00:11:08,470 --> 00:11:11,230
كيفَ اخدِمُكِ؟

93
00:11:13,940 --> 00:11:16,730
.جِد الشَّيطانَ رجاءً

94
00:11:17,740 --> 00:11:20,740
وإِن وَجَدتُهُ، ماذا ستفعلِين؟

95
00:11:21,620 --> 00:11:24,440
.عليَّ أن أقتُلَه

96
00:11:26,690 --> 00:11:28,780
.يجِبُ أن أقتُله

97
00:11:30,560 --> 00:11:32,650
...اِطمئِني

98
00:11:35,650 --> 00:11:39,090
.هَذِهِ وظيفتي

99
00:11:48,710 --> 00:11:50,060
كَيفَ وَجَدتَهَا؟

100
00:11:51,130 --> 00:11:54,300
.رأيتُ حُزنًا كَبِيرًا في قلبِها

101
00:11:54,690 --> 00:11:58,800
.جَسَدُهَا يَشِعُّ طاقةً شيطانِيةً

102
00:11:59,700 --> 00:12:02,120
.لا شكَّ أنها أقامت اِتِّصَالًا

103
00:12:02,120 --> 00:12:07,720
.أتذكرُ أن جَسَدَهَا كَانَ مُثخنًا بِالخُدُوش عِندما عَرَّيتُهَا

104
00:12:07,720 --> 00:12:08,870
هل ضاجعتها؟

105
00:12:08,870 --> 00:12:11,830
!لم أفعل أيَّ شيءٍ

106
00:12:12,080 --> 00:12:15,590
.سَنَصِلُ قرِيبًا إلى مِنطَقَةِ الخَدَمَات

107
00:12:30,350 --> 00:12:32,420
.مُتلاعِب بِالرِّياح

108
00:12:32,420 --> 00:12:35,020
أَلَم يَكُن هذا كَثِيرًا لِمُجرَّدِ تَرحِيبٍ؟

109
00:12:35,460 --> 00:12:38,080
.انتَ تَعمَلُ لدَى تاكاميا

110
00:12:38,080 --> 00:12:40,030
ماذا تُرِيدُ مِنِّي؟

111
00:12:41,200 --> 00:12:42,830
.لا شيء يُذكر

112
00:12:42,830 --> 00:12:48,280
.فَقَط اِنسَ أَمرَ تِلكَ المَرأَةِ

113
00:12:49,650 --> 00:12:51,260
...وضِح لي

114
00:12:51,260 --> 00:12:54,040
ماذا سيحدُثُ إِذا رفضتُ؟

115
00:13:15,850 --> 00:13:17,630
!أيُّها الوغد

116
00:13:17,630 --> 00:13:19,940
!فلتمُت

117
00:13:35,220 --> 00:13:37,520
...مُتلاعبٌ بالنار

118
00:13:37,520 --> 00:13:40,790
.حتى مِن موطني لا يوجد أحدٌ بِبَرَاعَتِهِ

119
00:13:41,920 --> 00:13:45,260
.أتساءلُ لو ماتَ

120
00:13:46,080 --> 00:13:48,360
لَا، مَا يزالُ حَيًّا

121
00:13:48,360 --> 00:13:50,600
أَتُرِيدِينَهُ؟

122
00:13:51,850 --> 00:13:56,270
.أتخيَّلهُ مُمزَّقًا ومُقطَّعًا، يسبحُ في دِمائِهِ

123
00:13:57,270 --> 00:14:02,150
.دمي يشتعِلُ حماسةً

124
00:14:13,750 --> 00:14:17,320
.أهلًا، عرفتُ مكان الشَّيطان

125
00:14:17,320 --> 00:14:19,170
في نادي كريستال بوكس؟

126
00:14:19,830 --> 00:14:24,770
.أجل، ظاهريًا يبدو كدارِ دعارةٍ لِلأغنياءِ

127
00:14:24,770 --> 00:14:28,660
.لَكِن مُؤخَّرًا، العامِلاتُ هُناكَ بَدَأن َباِلِاختِفاءِ

128
00:14:29,230 --> 00:14:32,500
.كودو مالِكَ الملهى، يبدو مشبوهًا أيضًا

129
00:14:32,500 --> 00:14:35,310
.هُناكَ من يتلاعبُ بِهِ مِن خلفِ السِتارِ

130
00:14:36,660 --> 00:14:38,110
.تاكاميا

131
00:14:38,110 --> 00:14:39,770
أتعلمُ بِذلِكَ؟

132
00:15:52,060 --> 00:15:53,640
أنامَ العجُوزُ؟

133
00:15:54,320 --> 00:15:56,150
.أجل

134
00:15:57,130 --> 00:15:58,850
أتراهُ سيستيقظ؟

135
00:15:58,850 --> 00:16:01,160
.سنُزيفُ الأمر

136
00:16:01,160 --> 00:16:02,140
!صحيح

137
00:16:03,960 --> 00:16:05,300
!يا حظنا

138
00:16:05,300 --> 00:16:06,990
.أرجو أن نجِدَ بعض النُقود

139
00:16:06,990 --> 00:16:09,860
.لا أُمانِعُ أيَّ شيءٍ ثمينٍ

140
00:16:17,610 --> 00:16:20,350
أتشُمِّينَ شَيئًا؟

141
00:16:20,350 --> 00:16:22,000
.أجل

142
00:16:23,720 --> 00:16:25,870
‫أهُناك أحدٌ هُنا‬‫؟

143
00:16:45,010 --> 00:16:48,110
كودو-ساما، هُناكَ من يرغبُ بِرُؤيتِكَ

144
00:16:49,480 --> 00:16:50,610
من يكون؟

145
00:16:51,140 --> 00:16:53,790
.شيجو-ساما

146
00:16:53,790 --> 00:16:55,770
.لا أعرِفُهُ

147
00:16:56,460 --> 00:17:00,370
.لا بأس، سَأُوافيهِ خلال خمسة دقائق في الصَّالةِ

148
00:17:00,370 --> 00:17:02,410
.أمرُكَ

149
00:17:04,180 --> 00:17:07,710
.يُشرِفُني لِقائُكَ. اسمي كودو

150
00:17:07,710 --> 00:17:10,850
كيفَ أخدِمُكَ؟

151
00:17:10,850 --> 00:17:15,380
.أودُ الحديثَ عن حيوانِكَ الأليف

152
00:17:16,140 --> 00:17:19,530
.لدينا العديد من العملاء وهناك الكثيرُ من الأذواقِ الفريدةِ

153
00:17:19,530 --> 00:17:22,390
‫ما نوعُ الحيوانِ الأليف الَّذي تبحثُ عنه‬‫؟

154
00:17:24,560 --> 00:17:26,900
.حَيَوَانٌ ذُو قُرُونٍ

155
00:17:27,540 --> 00:17:29,450
.يا للأسف

156
00:17:29,450 --> 00:17:31,400
.لا نملِكُ هذا النوع

157
00:17:32,020 --> 00:17:35,400
.سَمِعتُ أنكم توفِرونَ كُل شيءٍ هُنا

158
00:17:36,440 --> 00:17:41,410
‫سَنُعلِمُكَ فور تلقَّينا معلُوماتٍ عَن أيَّ شيءٍ يُشابِهُهُ، شيجيو-سان‬‫.

159
00:17:45,570 --> 00:17:48,660
.شكرًا جزيلًا

160
00:17:52,380 --> 00:17:54,550
.كيزاكي، تخلص مِنه

161
00:17:54,550 --> 00:17:56,470
.يُمكِنُكَ استخدامُ المُنشِط

162
00:17:56,470 --> 00:17:58,050
.حسنًا

163
00:17:58,050 --> 00:18:00,700
...شيجو تسونامي

164
00:18:01,090 --> 00:18:02,470
من يكون؟

165
00:18:20,400 --> 00:18:23,890
هل وجدتَ الحيوان الذَّي طلبتُه؟

166
00:18:44,320 --> 00:18:46,220
مُنشِطُ عضلاتٍ؟

167
00:19:06,140 --> 00:19:08,120
.أعتذِرُ على مُقابلتِكَ هُنا

168
00:19:09,980 --> 00:19:11,120
.هدية لك

169
00:19:13,130 --> 00:19:15,170
ما هذا؟

170
00:19:15,580 --> 00:19:19,640
.كبسولاتٌ حيوية، تُنشِطُ العضلات

171
00:19:20,210 --> 00:19:23,140
.اِعتقدتُ أنها ممنوعة

172
00:19:24,840 --> 00:19:27,200
.تصنيع فورجن للأدوية

173
00:19:27,200 --> 00:19:32,300
أتعتقِدُ أن هُناكَ علاقةٌ ما بينَ الشَّياطِينِ والفيروس؟

174
00:19:32,710 --> 00:19:33,890
.جَاءَت فِي وَقتِهَا

175
00:19:33,890 --> 00:19:36,880
.اللَّيلة سَأُرسِلُ تاجيما لِلبلدةِ القَديمةِ في شينجوكو

176
00:19:36,880 --> 00:19:39,650
.سأتحققُ مِن خاصتِكَ أيضًا

177
00:19:40,880 --> 00:19:43,200
.أرسِله إلى متجرِ جانك

178
00:20:13,700 --> 00:20:16,270
.سأدخُل

179
00:20:17,280 --> 00:20:20,910
.سَمِعتُ أنَ  شيجو بدأ بِالتحرُكِ

180
00:20:21,660 --> 00:20:24,630
لِمَ أستخدمتَ الدواءَ يا كودو؟

181
00:20:24,630 --> 00:20:27,700
.وكأنكَ كشفتَ أوراقنا

182
00:20:28,160 --> 00:20:29,690
.أنا أسِفٌ

183
00:20:29,690 --> 00:20:33,770
.بدا أنَّهُ يَعلمُ بِشأنِنا، لِذا حاولتُ قتلهُ

184
00:20:33,770 --> 00:20:43,080
كودو، المطلوب مِنكَ هو الإستمرار في إِطعام عَينتِنا
.التَّجرِيبِيةَ المزِيدَ من الفيروس والفَرَائِسِ الطَّازَجَةِ

185
00:20:43,080 --> 00:20:47,380
.لا تشغَل بالكَ بِأيِّ شيءٍ آخر

186
00:20:47,380 --> 00:20:54,100
.أنا أعلمُ أنَ مَجِيءَ شيجو تسونامي حتمي

187
00:21:00,130 --> 00:21:02,740
.تاجيما، وصلت نَتائِجُ التحليل

188
00:21:03,500 --> 00:21:09,000
‫الَّذي أَحضرهُ كومازاوا سابِقًا،
‫ والَّذي أَحضَرتَهُ أَنتَ يَتَشَارَكَانِ نَفسَ الحِمض.

189
00:21:09,000 --> 00:21:12,310
.كِلا الفيروسان يَستطِيعانِ تَغيِيرَ جِسمِ المخلُوقِ بِشكلٍ جَذرِيٍّ

190
00:21:12,310 --> 00:21:19,470
‫الفرقُ الوحِيدُ هُوَ أن فايروس كومازاوا
يُسبِبُ انفجاراتٍ في الخلايا أثناءَ عَمَلِيَّةِ التَّعزِيزِ‬‫.

191
00:21:19,470 --> 00:21:24,090
.إذا وَاصلتَ تَعَاطِي هَذِهِ الأشياء، سَتَتَلَاشَى إِنسَانِيَّتُكَ

192
00:21:24,090 --> 00:21:25,450
ما قَصدُكَ؟

193
00:21:25,450 --> 00:21:29,760
.ستتحول إلى شيطانٍ حقيقي

194
00:21:30,120 --> 00:21:33,770
.أمرٌ آخرٌ... أود أن أعرض عليكم شيئًا مُثيرًا للاهتمام

195
00:21:37,910 --> 00:21:40,500
.فايروس كومازاوا على اليمين

196
00:21:40,500 --> 00:21:45,400
.أما الذي على اليسار، فَسرقتهُ من قاعدةِ بياناتِ شركةِ أدويةٍ

197
00:21:45,400 --> 00:21:48,230
...عندما تقارن بينهم

198
00:21:51,150 --> 00:21:53,040
!مِن أَينَ لَكَ هَذِهِ البَيَانَاتِ؟

199
00:21:54,120 --> 00:21:56,580
.تاجيما، معلوماتي مُكلِفةٌ

200
00:21:59,000 --> 00:22:01,170
.السرقة جريمة

201
00:22:01,170 --> 00:22:02,600
.يا فتى

202
00:22:02,600 --> 00:22:04,170
من أنتِ؟

203
00:22:08,460 --> 00:22:11,900
.كان علي أن أُعرِفَ بِنفسي على الأقل

204
00:22:11,900 --> 00:22:15,180
.لِنُنظِفَ بِسُرعةٍ يا تشين لونج

205
00:22:16,080 --> 00:22:19,240
.أنتَ مُستعجِلٌ كعادتِكَ

206
00:22:19,240 --> 00:22:21,190
.أُحِبُكَ يا هوانج لونج

207
00:22:34,470 --> 00:22:37,210
.عُدتَ مُبكِرًا

208
00:22:38,430 --> 00:22:41,780
ايجي، ماذا حدثَ لك؟

209
00:22:42,400 --> 00:22:43,890
!ايجي

210
00:23:07,340 --> 00:23:08,980
..شيجو-سان

211
00:23:11,400 --> 00:23:13,120
.أرجوكَ تعال

212
00:23:27,870 --> 00:23:29,800
.آسِفةٌ على الِاتِّصالِ في وقتٍ مُتّأخِّرٍ

213
00:23:30,940 --> 00:23:33,090
ماذا تُريدين؟

214
00:23:34,270 --> 00:23:37,320
المعذرة... كيفَ يجري البحث؟

215
00:23:37,320 --> 00:23:39,740
.أعطيتُكِ التحديثات

216
00:23:39,740 --> 00:23:42,060
.سَأَتَوَاصَلُ مَعَكِ إن جدَ جديدٌ

217
00:23:53,130 --> 00:23:54,620
...تينكو

218
00:23:56,730 --> 00:23:59,450
هلَّا راقبتها؟

219
00:24:00,520 --> 00:24:02,960
.سَأُلَاقِي جانك

220
00:24:04,050 --> 00:24:05,310
.أَعتمِدُ عَليكَ

221
00:24:05,310 --> 00:24:07,100
.حسنًا

222
00:24:18,050 --> 00:24:21,660
.أعتذِرُ على جرِّكَ مَعِي إلى غُرفَتِي

223
00:24:21,660 --> 00:24:24,170
...لا أُمانِعُ

224
00:24:24,170 --> 00:24:26,060
لكن أمُتأكِدةٌ أنكِ لا تُمانِعِينَ؟

225
00:24:26,060 --> 00:24:32,490
.أَكِيد! لم أَشكُركَ بعد على إنقاذِي

226
00:24:33,000 --> 00:24:34,620
.لا تشغل بالك

227
00:24:34,620 --> 00:24:38,620
.أيُّ أحدٍ سَيفعَلُ المِثلَ

228
00:24:39,350 --> 00:24:42,270
.لا دَعٍ لِلتَّواضُعِ

229
00:24:42,270 --> 00:24:46,420
.أعتذِرُ بشأنِ الفوضى

230
00:24:46,420 --> 00:24:48,290
.لا تَقلَقِي حيالها

231
00:24:48,290 --> 00:24:53,810
.تسونامي دَائِمًا ما يُسمِّي غُرفتِي بالزَّرِيبَةِ

232
00:24:55,800 --> 00:24:58,450
.صداقتكُم قويةٌ

233
00:24:58,450 --> 00:25:01,600
...بِالمُناسبة، بِخصوصِ الشَّيطان

234
00:25:01,600 --> 00:25:06,070
.أَخبَرَنِي تسونامي أن أسألَكَ عن بعضِ المعلوماتِ التفصيلية

235
00:25:06,070 --> 00:25:08,500
ماذا؟ تسونامي قالها؟

236
00:25:08,500 --> 00:25:09,960
.لم يَقُل لِي شَيئًا

237
00:25:09,960 --> 00:25:13,420
.ولكِنَهُ طَلبَ مِني أن أسألكَ

238
00:25:13,420 --> 00:25:19,410
فَهِمتُ، الشَّيطان موجودٌ في نادٍ يُدعى
.كريستال بوكس" في نيو كابوكيتشو"

239
00:25:20,130 --> 00:25:23,790
.لَكِنهُ ليسَ بِمكانٍ مُناسِبٍ لِفَتَاةٍ مِثلَكِ

240
00:25:23,790 --> 00:25:27,880
.اِترُكِ لنا الموضُوع، سَنَهتَمُّ بِهِ

241
00:25:46,350 --> 00:25:48,410
ماذا؟

242
00:25:50,080 --> 00:25:53,870
...أظُنُّنِي ثَمِلتُ قَلِيلًا

243
00:26:09,030 --> 00:26:10,560
...ايجي

244
00:26:52,000 --> 00:26:53,590
.أوه، وَصِلتَ

245
00:26:54,330 --> 00:26:57,060
.حَالَةُ القبوِ كارِثِيَّةٌ

246
00:26:57,060 --> 00:27:01,520
.نَعتقِدُ أن الجُثَثِ تَعُودُ لِجانك وتاجيما، لَكِنها مُشَوَّهَةٌ

247
00:27:01,520 --> 00:27:06,470
.أيًا كَانَ المَسؤُول، فلم يَتَوقَّع أن يُحتَفَظَ بِالبياناتِ هُنا

248
00:27:08,030 --> 00:27:10,400
.هذا ما تركهُ لنا جانك

249
00:27:11,330 --> 00:27:14,400
.نَأمَلُ أن تقُودَ إلى اِعتِقَالِ تاكاميا

250
00:27:15,390 --> 00:27:18,710
...تذكرت، بِخصوص تاتشيبانا شيزوكا

251
00:27:18,710 --> 00:27:24,610
.حِمضُ خَطِيبِهَا النَّوَوِيُّ يُطَابِقُ حِمضَ الشَّيطَانِ

252
00:27:24,610 --> 00:27:28,520
.كَانَ باحِثًا في شَرِكَةِ فورجن لِلأَدوِيَةِ

253
00:27:28,520 --> 00:27:35,410
.لَكِنَ تأثيرُ تاكاميا على فورجن كَبِيرٌ لِدَرَجَةٍ تَمنعُنا مِن التعمُقِ في التَّحقِيقِ

254
00:27:38,190 --> 00:27:40,590
تينكو، ما الآمر؟

255
00:27:40,590 --> 00:27:43,110
!شيزو إختفت

256
00:27:43,110 --> 00:27:47,470
.أسِفٌ يا تسونامي، أخبرتُها عن مكانِ الشيطان

257
00:27:47,470 --> 00:27:50,940
.لا بُدَ أنها ذهبت إلى كريستال بوكس

258
00:27:50,940 --> 00:27:53,440
.فَهِمتُ، اترُك الباقي لي

259
00:27:56,540 --> 00:27:58,440
سَتُلَاحِقه؟
.أجل

260
00:28:22,400 --> 00:28:25,520
!اِزدَادَ لُطفًا

261
00:28:25,520 --> 00:28:29,020
.ضَبطتُ اِمرَأَةً مَشبُوهةً تتجسَّسُ حولنا

262
00:28:29,990 --> 00:28:31,520
.دعني أراها

263
00:28:33,190 --> 00:28:36,150
.حَبِيبةُ الشَّيطان. اِقتُلُوهَا

264
00:28:36,150 --> 00:28:37,270
.اِنتَظِر

265
00:28:37,940 --> 00:28:40,490
.يَا لِحَالِهَا البَائِسِ

266
00:28:40,490 --> 00:28:44,900
...سَيُقضَى عَليهِ حَالَمَا نُنّهِي التَّجرِبةُ

267
00:28:44,900 --> 00:28:48,350
لِذَا لِمَا لا نَدَعهم يرون بَعضَهُم لِمَرَّةٍ أَخِيرَةٍ؟

268
00:28:49,180 --> 00:28:51,970
أَلَا تُوافِقُنِي يا هوانج لونج؟

269
00:28:51,970 --> 00:28:53,870
.اِفعَلِي ما يَحلُو لَكِ

270
00:28:54,290 --> 00:28:56,320
.أحضِرِ الفتاةَ إِلى الدَّاخِلِ

271
00:28:56,320 --> 00:28:59,880
.سَنُرسِلُها مَعَ عَينَةِ اِختِبَارِنَا لِلسَّيِّدِ تاكاميا. لِذَا أَسرِع

272
00:29:24,470 --> 00:29:29,660
.تاكميا-ساما، جَمَعنا كَمِيَّةَ الدَّمِ المَطلُوبة مِنَ العينة

273
00:29:30,070 --> 00:29:31,870
.أَحسَنتُم صُنعًا

274
00:29:31,870 --> 00:29:34,460
.اِستَعِدُّوا لِلمَرحَلَةِ الثَّانِيَةِ

275
00:29:34,460 --> 00:29:35,240
.مفهوم

276
00:29:35,240 --> 00:29:39,840
‫تاكاميا-ساما، ريثما نَستَعِدُّ لِلخطوَةِ القَادِمَةِ، أودُّ أن أُقدِمَ لكَ بعضَ الترفيه‬‫.

277
00:29:40,540 --> 00:29:44,530
.هَذِهِ الفَتَاةُ خَطِيبَةُ عَيِّنَتِنَا التَّجرِيبِيَّة

278
00:29:44,530 --> 00:29:48,130
.أَوَدُّ أن يَتَقَابَلُوا اللَّيلَةَ لِمرَّةٍ أَخِيرَةٍ

279
00:29:48,130 --> 00:29:49,850
هل هذا مُمكِن؟

280
00:29:52,190 --> 00:29:55,120
.يَبدُو هَذَا مُمتِعًا

281
00:29:56,230 --> 00:30:01,550
.سَأَسمَحُ بِهَذَا، أَدَّى غَرَضَهُ بِامتِيَازٍ

282
00:30:01,550 --> 00:30:04,220
.فَليَحظَ بِمُكَافَأَتِهِ

283
00:30:13,080 --> 00:30:14,680
.ايجي

284
00:30:24,010 --> 00:30:26,630
ايجي، أعَرِفتَنِي؟

285
00:30:29,740 --> 00:30:30,890
!ايجي

286
00:30:45,620 --> 00:30:47,150
...ايجي

287
00:30:49,060 --> 00:30:52,040
.لا يُمكِنُكَ البقاءُ هُنا

288
00:30:59,300 --> 00:31:01,140
.ايجي

289
00:31:30,540 --> 00:31:32,250
...ايجي

290
00:31:35,240 --> 00:31:37,590
.أُحِبُك

291
00:32:17,680 --> 00:32:19,410
...تاكاميا-ساما

292
00:32:19,410 --> 00:32:22,310
.سَنَتَخَلَصُ مِنهُ

293
00:32:22,310 --> 00:32:25,300
.لا بأس، قُومُوا بِذَلِكَ

294
00:32:27,620 --> 00:32:29,960
.كودو، أكمِل

295
00:32:37,520 --> 00:32:41,520
.ليتني حَرِصّتُ على موتِهِ سابِقًا

296
00:32:46,430 --> 00:32:49,980
.تاكايما-ساما، انتهيتُ مِن ضَبطِ الأُسطُوانَةِ

297
00:32:50,940 --> 00:32:52,980
...حسنٌ

298
00:32:52,980 --> 00:32:57,290
.ضَعْ يَدَيكَ على الجانِبِ الأيمنِ.

299
00:32:57,290 --> 00:33:02,000
.سَتَكُونُ مِفتَاحَ تَفعِيلِ النِّظَامِ

300
00:33:02,580 --> 00:33:04,170
.حسنًا

301
00:33:50,510 --> 00:33:52,060
...كودو

302
00:33:52,060 --> 00:33:56,050
.بِخُصُوصِ مُكَافَأَتُكَ

303
00:34:03,710 --> 00:34:08,700
.كُن فَرِيسَتِي وإِحيا بِداخِلي

304
00:34:28,130 --> 00:34:31,040
!تاكاميا-ساما بُعِثَ مِن جديد

305
00:34:33,710 --> 00:34:38,030
!هَذِهِ بِدايةُ عَصرِنَا الجديد

306
00:34:40,310 --> 00:34:42,930
!هوانج لونج، أخي

307
00:34:46,250 --> 00:34:48,310
!تشين لونج

308
00:34:48,310 --> 00:34:49,840
!سُحقًا

309
00:34:49,840 --> 00:34:52,690
!فَلتَمُت

310
00:35:06,820 --> 00:35:09,370
...عِندما يتعلقُ الأمر بأُختِكَ الصغيرة

311
00:35:09,370 --> 00:35:11,960
.لا تستطيعُ تمالُكَ أعصابِكَ

312
00:35:12,160 --> 00:35:14,810
.نَفِذَت طاقتُك

313
00:35:14,810 --> 00:35:17,380
!اخرس، سَأَمحَقُكَ

314
00:35:44,740 --> 00:35:47,710
.يَا مَن كَانَ يومًا كورازاوا ايجي

315
00:35:47,710 --> 00:35:51,240
.إِن وَصَلَكَ صَوتِي فَاستَمِع

316
00:35:54,480 --> 00:35:58,230
...إِن استَرجعتَ الَقلبَ الَّذِي أَعَادَ مَشَاعِرَكَ

317
00:35:58,230 --> 00:36:01,340
.حِينَئِذٍ سَتَتَمَكَّنُ مِن رُؤيَتِهَا مَرَّةً أُخرَى

318
00:36:03,960 --> 00:36:08,150
.تِلكَ كَانَت أُمنِيَتُهَا الخالِصَةُ

319
00:37:07,120 --> 00:37:12,570
.استَمتَعتُ بِالعَرضِ مِن مَكَانِي

320
00:37:12,570 --> 00:37:17,940
مَا رَأيُكَ يَا تسونامي؟ أَنَنتَقِلُ إِلَى الفَصلِ الثَّانِي؟

321
00:37:17,940 --> 00:37:21,310
.لَا تُسِئ فَهمِي

322
00:37:21,310 --> 00:37:25,310
.لَم أَنتَظِر هَذِهِ المُدَّةَ مِن أَجلِ قِتَالٍ

323
00:37:25,310 --> 00:37:29,850
.بَل اِنتَظَرتُ لِأُحَادِثَكَ بِإِسهَابٍ

324
00:37:31,150 --> 00:37:35,850
.مَضَى ثَلَاثُونَ عَامًا منذُ آخِرِ لِقاءٍ بَينَنَا

325
00:37:36,290 --> 00:37:42,120
.اُنظُر إِلَى الظَّلَامِ الَّذِي جَلَبتَهُ عِندَمَا قَاتَلتَنِي ذَلِكَ اليَوم

326
00:37:42,120 --> 00:37:47,370
.أَنتَ مِن بَينِ الجَمِيعِ، حَارِسُ البَشَرِيَّةِ، قَتَلتَ مِنهُم عَشَرَاتِ الآلافِ

327
00:37:47,370 --> 00:37:52,960
.أُصِبتُ وقتها بِشِدَّةٍ، لَكِنَّنِي نَجَوتُ

328
00:37:59,630 --> 00:38:01,940
.هَذا مُثيرٌ لِلسُخرية

329
00:38:01,940 --> 00:38:06,650
...أَنتَ، سَيِّدُ الضَّوءِ، بَقِيتَ مُندَسًا فِي الظَّلَامِ

330
00:38:06,650 --> 00:38:14,650
.أمَّا أنا، سَيِّدُ الظَّلامِ، سُدتُ النُّورَ الَّذِي خُلِقَ لِلبَشَرِيَّةِ

331
00:38:15,760 --> 00:38:21,720
.بِغَضِ النَّظَرِ، البَشَرِيَّةُ عِرقٌ غامِضٌ

332
00:38:22,340 --> 00:38:25,780
.كُلَّمَا اجتَلَبَت ظَلَامًا أَكبَرَ

333
00:38:25,780 --> 00:38:30,700
.كُلَّمَا زَادَت قُوَّتُهَا فِي رَدعِهِ

334
00:38:31,510 --> 00:38:37,670
.اُنظُر لِهَذَا الاِزدِهَارِ العَجِيبِ، وَكَأَنَّهُ يُحَاوِلُ احتِوَاءَ هَذَا الظَّلَامِ

335
00:38:38,600 --> 00:38:40,130
...بِفَضلِهِ

336
00:38:40,130 --> 00:38:47,280
.تَمَكَّنتُ مِنَ الحُصُولِ عَلَى هَذَا الجَسَدِ، وَهَذِهِ القُوَّةِ العَظِيمَةِ

337
00:38:48,460 --> 00:38:50,730
ما رأيك يا تسونامي؟

338
00:38:50,730 --> 00:38:53,610
هَلَّا اِنضَمَمتَ لِي؟

339
00:38:53,610 --> 00:38:56,040
.بَينَنَا مَعرِفَةٌ طَوِيلَةٌ

340
00:38:56,040 --> 00:38:58,870
.دَعنَا نَتَجَنَّبُ قِتالًا عَقِيمًا

341
00:38:58,870 --> 00:39:02,770
!لِنَحكُم البَشَرِيَّةَ سَوِيًّا

342
00:39:03,140 --> 00:39:04,830
حُكامٌ؟

343
00:39:04,830 --> 00:39:09,840
.مُستَقبَلٌ كَهَذَا لَن يَنْتُجَ عنهُ سِوَى الجَرَائِمِ وَالفَسَادِ

344
00:39:10,520 --> 00:39:17,970
.لِسُوءِ الحَظِّ، سَبَبُ بقائِيَ الوحيد هُوَ تَدمِيرُ أَمثَالِكَ مِنَ الشَّيَاطِين

345
00:39:17,970 --> 00:39:22,290
.قِيَمِي لَا تَقبلُ التَّغيِيرَ

346
00:39:24,450 --> 00:39:27,400
.أَضَعتُ وَقْتِي بِمُحَاوَلَةِ التَّهَادُنِ مَعَكَ

347
00:39:27,400 --> 00:39:31,180
.غَيرَ أَن لَا مَكَانَ إِلَّا لِحَاكِمٍ وَاحِدٍ

348
00:39:38,410 --> 00:39:42,600
.هُجُومَكَ أَضعَفُ مِن أَن يَخدِشَنِي

349
00:39:50,360 --> 00:39:53,240
!مَا خَطبُكَ؟ هَاجِمنِي بِكُلِّ قُوَّتِكَ يا تسونامي

350
00:39:57,130 --> 00:40:00,410
.لَا طَائِلَ مِن تِكرارِ قَطعِكَ إيَّايَ

351
00:40:06,110 --> 00:40:10,010
.أنتَ هالِكٌ يا تسونامي

352
00:40:12,550 --> 00:40:16,750
...خَيَارُكَ الوَحِيدُ، إِمَّا أَن تَدَعَنِي أَمتَصَّكَ

353
00:40:16,750 --> 00:40:24,370
.أَو أَن تُطلِقَ النَّارَ بِكُلِّ طَاقَتِكَ وَتُكرِرُ ما حدثَ قَبلَ ثَلَاثِينَ عَامًا

354
00:40:24,860 --> 00:40:31,990
.لَكِن تَذَكَّر، قُوَّتِي تَضَاعَفَت عَشَرَاتِ المَرَّاتِ عَنّها وقتها

355
00:40:32,370 --> 00:40:37,550
.هَذِهِ المَرَّةَ لَن أَكتَفِيَ بِتَدمِيرِ شينجوكو

356
00:40:38,670 --> 00:40:44,330
أَنتَ كَمَا السَّابِق، أَلَم تَتَعَلَّم مِن أَخطَائِكَ حِينَهَا؟

357
00:40:50,300 --> 00:40:52,980
أَلَا تَحتَمِلُ الخَسَارَةَ؟

358
00:40:53,720 --> 00:40:55,900
.لا بأس

359
00:40:55,900 --> 00:40:58,670
.اِنتَظَرتُ هَذِهِ اللَّحظَةَ بِفَارِغِ الصَّبرِ

360
00:40:58,670 --> 00:41:02,740
.لِنَستَمتِع مَعًا بِالعَرضِ

361
00:41:08,530 --> 00:41:11,190
.أَعشَقُكَ يَا تسونامي

362
00:41:11,870 --> 00:41:14,970
لِمَاذَا لَا تَتَمَاشَى مَعِي؟

363
00:41:15,470 --> 00:41:18,900
.كَانَ هُنَاكَ وَقتٌ تَشَارَكنَا فِيهِ المَشَاعِرَ

364
00:41:19,710 --> 00:41:22,680
.كَانَ ذَلِكَ وَقتٌ كَانَ البَشَرُ فِيهِ أَبرِيَاءً

365
00:41:22,680 --> 00:41:25,210
.مُنذُ زَمنٍ بعيدٍ

366
00:41:25,650 --> 00:41:30,880
.لِنَعُد لِتِلكَ الأَيَّامِ... لِمَرَّةٍ أَخِيرَةٍ

367
00:41:31,580 --> 00:41:34,060
...إِذَا كَانَت هَذِهِ رَغَبَاتُكَ

368
00:41:34,060 --> 00:41:37,900
.فَلَن أُمَانِعَ وَهَبَ نَفسِي لَكَ

369
00:41:37,900 --> 00:41:41,580
.إِذَن اِخلَعِي هَذَا الدِّرعَ

370
00:41:45,050 --> 00:41:49,540
.مُحَال، حَتَّى تُغَيِّرَ مَا فِي قَلبِكَ

371
00:41:49,540 --> 00:41:52,400
.قَلبِي سَيَبقَى كَمَا هُوَ

372
00:41:53,580 --> 00:41:59,160
!مَا أَعنَدَكَ يَا تسُونَامِي! سَتُمحَى دَاخِلَ جَسَدِي الجَدِيد

373
00:41:59,950 --> 00:42:04,160
.لَستِ وَحدَكِ مَن تَغَيَّرَ

374
00:42:25,080 --> 00:42:27,070
.الوداع

375
00:43:01,730 --> 00:45:43,890
‫شُكرًا لِمُتابعتِكُم.
