1
00:00:32,930 --> 00:00:34,880
النسيم عليل

2
00:00:34,880 --> 00:00:37,530
أتُرِدن الدخول الآن؟

3
00:00:37,530 --> 00:00:38,390
نعم

4
00:00:40,360 --> 00:00:42,060
المكانُ مزدحم للغاية

5
00:00:42,060 --> 00:00:43,520
تبّاً

6
00:00:43,840 --> 00:00:47,720
تويا-ساما، يستلزمُ هذا الأمرُ خدماتي

7
00:00:47,720 --> 00:00:49,350
أحم

8
00:00:49,780 --> 00:00:53,400
سأُبعدُ الآخرين بقوّة مياه
بُخار العبوديّة الخاص بي

9
00:00:58,820 --> 00:01:00,660
كان ذلك سهلاً للغاية

10
00:01:01,750 --> 00:01:03,910
يبدو أنّك ضعيفة للغاية

11
00:01:03,910 --> 00:01:05,910
!تذكّرتُكما

12
00:01:07,540 --> 00:01:10,420
أنا روحُ نبع آشينوكو الساخن، آشينوكو

13
00:01:10,420 --> 00:01:12,910
روح نبع غورا الساخن، غورا

14
00:01:12,910 --> 00:01:14,300
سُرِرتُ بلقائك

15
00:01:14,710 --> 00:01:16,970
أنتُما إذاً روحا النبع الساخن الجديدتان

16
00:01:16,970 --> 00:01:17,930
نعم

17
00:01:17,930 --> 00:01:21,710
انتهى زمنُكم أيّتها الأرواح القديمة
القادمة ممّا قبل فترة ميجي

18
00:01:21,710 --> 00:01:24,100
حانَ وقتُنا نحنُ الجيل العصري لكي نتألّق

19
00:01:24,370 --> 00:01:25,750
عصريّ؟

20
00:01:25,750 --> 00:01:27,770
أنتُما من جيل فترة شووا، أليس كذلك؟

21
00:01:28,130 --> 00:01:31,910
سنحصلُ على مصدرِ قوّتكِ، الصندوق السرِّي

22
00:01:31,910 --> 00:01:35,280
ومن ثمّ سنحكمُ كافّة أرواح النبع الساخن هاكوني

23
00:01:35,280 --> 00:01:39,160
أخذتا أثمن صندوق سرِّي لديّ

24
00:01:39,160 --> 00:01:42,290
أنا روح نبع ساخن فاشلة

25
00:01:42,290 --> 00:01:43,560
لا تبكي يا ميا

26
00:01:44,670 --> 00:01:47,120
شاهديني وأنا أستعيدُه

27
00:01:48,930 --> 00:01:51,280
أنا عدوّتُها، لماذا تفعلُ هذا لأجلي؟

28
00:01:51,280 --> 00:01:54,420
لا أظنّها تعتبرُكِ عدوّة

29
00:01:55,190 --> 00:01:59,540
مُنافِسة؟ لا، ربَّما أقرب إلى صديقة

30
00:02:00,510 --> 00:02:03,750
هيّا، أعيدا صندوقَ ميا السرِّي من دون مُقاومة

31
00:02:04,500 --> 00:02:06,020
ركبتاكِ ترتجفان

32
00:02:06,480 --> 00:02:07,270
!خذي

33
00:02:08,180 --> 00:02:09,520
!كيف تجرؤين؟

34
00:02:12,300 --> 00:02:13,740
سأسقُط

35
00:02:14,590 --> 00:02:15,590
ميا

36
00:02:15,590 --> 00:02:17,130
أصعدتِ إلى هنا أيضاً؟

37
00:02:17,130 --> 00:02:20,250
أعتبرُ نفسي روحَ نبع ساخن أيضاً

38
00:02:20,250 --> 00:02:22,510
معكِ حقّ، فلتتضافر قوّتانا

39
00:02:24,590 --> 00:02:25,330
ها أنا ذي

40
00:02:25,330 --> 00:02:26,910
انتبهي يا هاكوني-تشان

41
00:02:26,910 --> 00:02:28,320
تـ-تمالكي نفسكِ

42
00:02:28,320 --> 00:02:29,930
ما الذي يجري؟

43
00:02:29,930 --> 00:02:31,460
هل هذا نوعٌ من المعالِم السياحية؟

44
00:02:31,780 --> 00:02:34,250
كلّ ما عليّ فعله الآن هو الحصول
على صندوق هاكوني السرِّي

45
00:02:35,470 --> 00:02:37,190
لن تفعلي

46
00:02:39,090 --> 00:02:43,100
سمعتُ أنّكِ نمتِ لمئة عام
أو ما قاربَ يا هاكوني-سان

47
00:02:44,350 --> 00:02:50,350
نستحقُّ الصناديقَ السرِّية أكثر
منكن أيّتها الأرواح الكسولة

48
00:02:51,960 --> 00:02:54,930
تقِفُ الأرواح المحلّية إلى جانبهما

49
00:02:54,930 --> 00:02:57,360
تمتلِكان أفضليّة كبيرة من حيثُ القوّة الصَّرفة

50
00:03:00,570 --> 00:03:02,700
أعيدي صندوقي السرِّي

51
00:03:02,700 --> 00:03:03,820
!توقّفي

52
00:03:09,730 --> 00:03:11,460
لقد ربِحت

53
00:03:14,060 --> 00:03:16,740
لا أستطيع منع جسدي من الانبطاح

54
00:03:16,740 --> 00:03:18,620
ماذا تفعلين يا غورا؟

55
00:03:18,620 --> 00:03:19,880
أحسنتِ صنعاً يا ميا

56
00:03:21,660 --> 00:03:23,260
عدنا إلى موتوهاكوني

57
00:03:23,260 --> 00:03:24,900
إلى المزار

58
00:03:25,150 --> 00:03:26,210
هاكوني