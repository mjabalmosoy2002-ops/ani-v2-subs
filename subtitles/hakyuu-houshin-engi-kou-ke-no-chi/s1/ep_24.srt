1
00:00:06,540 --> 00:00:09,160
،فور أن نعبر النهر الأصفر
.سنجد تشوكا أمامنا

2
00:00:09,160 --> 00:00:11,110
!سنكون في قلب الين أخيرًا

3
00:00:11,740 --> 00:00:12,640
!دقّت ساعة الحرب

4
00:00:12,640 --> 00:00:14,130
!علينا بهم

5
00:00:15,340 --> 00:00:16,410
...لكن

6
00:00:16,410 --> 00:00:18,220
ماذا؟ أين روحك القتالية؟

7
00:00:18,840 --> 00:00:19,880
!أنت

8
00:00:19,880 --> 00:00:22,540
.كنّا جنودًا بالين أيضًا

9
00:00:23,040 --> 00:00:26,370
،بغضّ النظر عن الأوامر
أيمكننا قتل رفاقنا السابقين حقًّا؟

10
00:00:26,370 --> 00:00:27,950
...فـ-في الواقع

11
00:00:28,540 --> 00:00:31,280
.لا تعتبروا ذلك قتل بعضنا لبعض

12
00:00:33,240 --> 00:00:34,300
!ا-الملك بو

13
00:00:35,560 --> 00:00:38,680
.ليس وكأنّني أضمرُ أيّ شيء لجنود الين

14
00:00:39,400 --> 00:00:41,560
.علينا أن نحاول أخذ هذا بالاتجاه الصحيح

15
00:00:41,810 --> 00:00:42,830
!صـ-صحيح

16
00:00:42,830 --> 00:00:43,560
!نحن آسفون

17
00:00:43,920 --> 00:00:44,740
.جيد

18
00:00:45,230 --> 00:00:46,560
!لا تستهتروا يا رجال

19
00:00:46,760 --> 00:00:49,380
!سنقع في مأزق إن هوجمنا ونحن نعبر النهر

20
00:00:49,380 --> 00:00:51,070
!حاضر

21
00:00:52,570 --> 00:00:55,780
.يبدو أنّ الجنود بدؤوا يقبلون الملك بو

22
00:00:55,780 --> 00:00:59,780
ماذا تقصد؟
.لطالما كان الملك بو ذا شعبية

23
00:00:59,780 --> 00:01:00,330
...لا

24
00:01:01,370 --> 00:01:06,590
في البداية، اتّبع الجنود والد
.الملك بو، كي شو بسبب جاذبيّته

25
00:01:06,590 --> 00:01:08,670
،لكن الآن، بدلًا من الملك شو

26
00:01:08,670 --> 00:01:12,090
.بدؤوا يريدون بو كملِكهم حقًّا

27
00:01:12,770 --> 00:01:15,720
.لا يمكننا توقّع أقلّ من هذا من ابن كي شو

28
00:01:16,410 --> 00:01:20,970
.سنكتشف عمّا قريب أيٌّ من الين وشو ستسقط

29
00:01:21,630 --> 00:01:23,220
...بالمناسبة يا يوزن

30
00:01:23,770 --> 00:01:26,790
ماذا حلّ بعشيرة البوسيو؟

31
00:01:26,790 --> 00:01:30,480
.إنهم متّصلون بالين أعمق من الجميع

32
00:01:30,480 --> 00:01:31,620
.لا داعي للقلق

33
00:01:32,070 --> 00:01:33,730
.إنّهم أفضل القادة العسكريّين في البلاد

34
00:01:34,130 --> 00:01:37,360
...لكن يا يوزن، عندما يتعلّق الأمر بتينكا

35
00:01:37,640 --> 00:01:40,440
!لا داعي للقلق بشأني

36
00:01:40,440 --> 00:01:42,500
.أنا جاهز ومتحمّس للذهاب

37
00:01:42,500 --> 00:01:44,430
!لستُ بذلك الضّعف

38
00:01:44,430 --> 00:01:45,310
!أهلًا يا فرس النهر

39
00:01:46,480 --> 00:01:48,000
.اعذرني لحظة

40
00:01:48,520 --> 00:01:49,530
...تايكوبو

41
00:01:49,530 --> 00:01:50,500
ماذا؟

42
00:01:50,670 --> 00:01:52,750
.سأتكفّل بالملك تشو

43
00:01:53,910 --> 00:01:56,260
.لا تفكّر في أيّ شيء غريب يا تينكا

44
00:01:57,040 --> 00:02:00,510
.أخبرتك... لستَ بحاجةٍ للقلق بشأني

45
00:02:01,840 --> 00:02:05,630
صحيحٌ أنّ الملك تشو قتل أمّي

46
00:02:05,630 --> 00:02:08,040
.والمعلّم الأعظم قتل أبي

47
00:02:08,040 --> 00:02:12,160
.لكنّي لا أقاتل من امتعاضي لهما

48
00:02:12,160 --> 00:02:14,400
.بل أنا أنفّذ وصيّة أبي

49
00:02:15,160 --> 00:02:18,150
،فهمت. إن كنتَ قد فكّرت في الأمر مليًّا

50
00:02:19,230 --> 00:02:20,930
.فلا أملك ما أقوله

51
00:03:53,700 --> 00:03:57,000
.سنستغرق نحو نصف يوم سيرًا لتشوكا

52
00:03:57,720 --> 00:03:59,530
.يُجدر بنا أن نصل غدًا

53
00:04:01,010 --> 00:04:02,720
...سوف ندخل القلعة أخيرًا

54
00:04:02,720 --> 00:04:04,260
!بدأتُ أتوتّر

55
00:04:04,730 --> 00:04:05,660
...عذرًا

56
00:04:06,240 --> 00:04:07,260
تينشو؟

57
00:04:07,800 --> 00:04:09,060
أين هو تايكوبو؟

58
00:04:09,540 --> 00:04:12,270
.كان متعبًا، لذا ذهب للنّوم مبكّرًا

59
00:04:12,650 --> 00:04:14,980
.تبًّا، يا للملل

60
00:04:14,980 --> 00:04:17,770
...غادر أخي تينكا إلى مكانٍ ما أيضًا

61
00:04:21,990 --> 00:04:24,780
.آسف يا تايكوبو

62
00:04:25,380 --> 00:04:28,030
.عليّ أن أذهب إلى تشوكا

63
00:04:29,230 --> 00:04:32,560
!انطلق! انطلق

64
00:04:32,560 --> 00:04:35,280
!أجل! أسرع

65
00:04:35,280 --> 00:04:36,620
!مرحى

66
00:04:40,880 --> 00:04:44,300
.لم يعد لديّ متّسع من الوقت

67
00:04:45,880 --> 00:04:51,810
نشأتُ وأنا أُبجّل الشخصيتين العظيمتين
.لأبي والمعلّم الأعظم بونتشو

68
00:04:52,440 --> 00:04:55,430
.لطالما أردتُ أن أكون مثلهما يومًا ما

69
00:04:58,040 --> 00:04:59,790
.من الأفضل لك أن تتفوّق عليّ يومًا ما

70
00:05:00,400 --> 00:05:02,360
.هكذا يُظهر الابن ولاءه لأبيه

71
00:05:03,000 --> 00:05:06,070
.كان أبي الشخص الوحيد الذي لا أمانع الخسارة أمامه

72
00:05:06,600 --> 00:05:10,830
.كنتُ لأفضّل الموت على أن أخسر أمام أيّ أحد آخر

73
00:05:11,480 --> 00:05:15,300
.لكن بعدها... انتهت طفولتي

74
00:05:17,780 --> 00:05:19,590
!مـ-من هناك؟

75
00:05:20,250 --> 00:05:22,780
.اسمي دوتوكو شينكُن

76
00:05:23,350 --> 00:05:27,720
هل أنت مهتمّ بتعلّم الرّوح الرياضية معي؟

77
00:05:28,890 --> 00:05:33,860
.لأكون صادقًا، تردّدتُ قليلًا لأصبح دوشي

78
00:05:34,550 --> 00:05:40,550
لكن شعرتُ أنّني إن سرتُ على نفس
.خطى أبي، لن أستطيع التفوّق عليه أبدًا

79
00:05:40,550 --> 00:05:44,320
لذا تدرّبتُ في عالم السينين

80
00:05:44,320 --> 00:05:47,600
.واكتسبتُ باوبي باكويا نو هوكن

81
00:05:49,430 --> 00:05:51,990
لمَ هذا التعبير الجاد أيها المدرّب؟

82
00:05:52,780 --> 00:05:56,000
.غادر والدك تشوكا

83
00:06:09,140 --> 00:06:10,140
...تينكا

84
00:06:10,680 --> 00:06:13,140
من هذا الطفل؟

85
00:06:13,140 --> 00:06:14,400
.إنه تينشو

86
00:06:14,400 --> 00:06:15,100
أخي؟

87
00:06:15,100 --> 00:06:17,940
.وُلد بعد أن غادرتَ إلى عالم السينين

88
00:06:18,700 --> 00:06:19,640
.تينكا

89
00:06:21,540 --> 00:06:22,900
.مسرورٌ لعودتك

90
00:06:36,160 --> 00:06:37,600
!تريّس، تريّس

91
00:06:39,430 --> 00:06:42,790
.تشوكا... مضى وقتٌ طويل

92
00:06:44,780 --> 00:06:45,940
...مؤلم

93
00:06:47,080 --> 00:06:50,550
.حسنًا يا حصاني، سأُكمل وحدي

94
00:06:50,980 --> 00:06:52,080
.شكرًا على إيصالي

95
00:07:00,070 --> 00:07:02,560
.تينكا. لقد تأخّرت

96
00:07:03,020 --> 00:07:04,570
.سئمتُ من انتظارك

97
00:07:05,650 --> 00:07:06,920
...تايكوبو

98
00:07:07,450 --> 00:07:10,920
.شككتُ أنّك قد تحاول فعل شيء

99
00:07:11,880 --> 00:07:15,700
.أظنّني أفهم كيف تشعر جيّدًا في النهاية

100
00:07:16,120 --> 00:07:21,620
،لكن... إن تصرّفتَ بأنانيّة الآن
!ستكون خائنًا فحسب

101
00:07:22,250 --> 00:07:24,140
!لا يمكنني أن أسمح بذلك

102
00:07:33,340 --> 00:07:37,140
.تبدو شاحبًا للغاية هذه الأيّام أيّها الإمبراطور العظيم

103
00:07:38,010 --> 00:07:42,320
.سيدخل ذلك الأحمق تايكوبو تشوكا قريبًا

104
00:07:42,320 --> 00:07:46,540
.إنّه ينوي قتلك والإعلان عن بداية حقبة شو

105
00:07:46,540 --> 00:07:47,540
...لكن

106
00:07:48,150 --> 00:07:52,400
.لن ندعه ينشئ سلالةً حاكمة جديدة بتلك السّهولة

107
00:07:53,720 --> 00:07:57,410
.تينكا، هذه فرصتك الأخيرة لتعيد التفكير

108
00:07:58,060 --> 00:08:02,630
لا يجب عليك أن تواجه الملك تشو
.قبل دخول جيش شو إلى تشوكا

109
00:08:03,630 --> 00:08:07,540
!ماذا سيحلّ بالبشريّة إن هزم سينين أو دوشي الملك تشو؟

110
00:08:08,510 --> 00:08:12,050
!لا مغزى من الأمر إلّم يفعل بشريّ ذلك

111
00:08:12,290 --> 00:08:17,300
وإلّا كيف ستكون الأوضاع مختلفة
!عن كون الين تحت سيطرة داكّي؟

112
00:08:18,250 --> 00:08:19,330
...تايكوبو

113
00:08:19,900 --> 00:08:21,810
!افهم رجاءً

114
00:08:22,660 --> 00:08:28,570
!أعلم كيف كافحت في سعيك لإنشاء عالم بشريّ جديد

115
00:08:29,240 --> 00:08:31,570
...لكن... لكن مع ذلك

116
00:08:31,820 --> 00:08:34,570
!سأموت قريبًا

117
00:08:35,040 --> 00:08:39,450
!لا يمكنني أن أقف هنا وأنزف منتظرًا حتفي

118
00:08:39,450 --> 00:08:42,580
!أريد أن أقاتل وأُحدث تغييرًا قبل أن أموت

119
00:08:43,520 --> 00:08:44,830
!لا تستعجل على حتفك

120
00:08:45,500 --> 00:08:48,590
!بوسعك أن تعيش أطول إن خضعت للعلاج المناسب

121
00:08:49,520 --> 00:08:51,880
!أوتشوشي يبحث بجدّ بينما نتحدّث

122
00:08:52,680 --> 00:08:55,020
!مع ذلك، عليّ أن أرحل

123
00:08:55,690 --> 00:08:58,720
!حتّى وإن كان عليّ أن أقاتلك أوّلًا

124
00:08:59,000 --> 00:09:01,000
!لا تكن صبيانيًّا يا تينكا

125
00:09:01,000 --> 00:09:03,230
!يستحيل عليك أن تهزمني

126
00:09:06,920 --> 00:09:08,480
...سيدي

127
00:09:08,940 --> 00:09:10,730
...إ-إنه قويّ

128
00:09:11,040 --> 00:09:13,250
!لا تتردّد في مثل هذا الهجوم البسيط يا تينكا

129
00:09:13,710 --> 00:09:17,240
!ما زلتُ أملك الباوبي الاستثنائيّ خاصّتي، تايكيوكوزو

130
00:09:17,680 --> 00:09:19,740
!ألغِ الهوكن خاصتك

131
00:09:20,830 --> 00:09:22,240
ما هذا؟

132
00:09:22,600 --> 00:09:25,750
صديقان يقاتلان بعضهما؟
.لا بدّ أنّها نهاية العالم

133
00:09:26,750 --> 00:09:27,760
!أوتينكون

134
00:09:27,760 --> 00:09:29,910
لمَ لا تدعه يذهب فحسب؟

135
00:09:30,400 --> 00:09:34,760
.ستسقط الين عاجلًا أم آجلًا على أيّ حال

136
00:09:38,320 --> 00:09:39,010
!تينكا

137
00:09:39,820 --> 00:09:42,260
!أين أرسلت تينكا؟

138
00:09:44,120 --> 00:09:46,520
.حيث أراد أن يذهب

139
00:09:47,570 --> 00:09:51,520
!والآن، ستنهار أفكارك المثلى

140
00:09:59,490 --> 00:10:00,930
.هيا بنا يا سوبو

141
00:10:00,930 --> 00:10:03,110
.لا بدّ أنّ تينكا في القصر المحظور

142
00:10:03,110 --> 00:10:06,290
!علم! تجهّز للتحليق يا سيدي

143
00:10:07,010 --> 00:10:10,510
.قد يكون محاربًا بالفِطرة

144
00:10:10,510 --> 00:10:13,500
،حتّى إن كان لا يستطيع الفوز
.ما زال يحاول القتال

145
00:10:14,360 --> 00:10:19,580
.أخشى أن تودِيَ طبيعته التنافسية بحياته يومًا ما

146
00:10:22,040 --> 00:10:22,920
...تينكا

147
00:10:33,080 --> 00:10:34,020
...مؤلم

148
00:10:35,440 --> 00:10:36,280
...هذا

149
00:10:38,060 --> 00:10:39,260
.القصر المحظور

150
00:10:41,260 --> 00:10:45,400
،لن أتحجّج من كوني على قيد الحياة

151
00:10:45,400 --> 00:10:48,630
لكن أريد أن أكون راضيًا عن
.حياتي قبل أن أموت على الأقل

152
00:10:48,630 --> 00:10:49,900
...مثل أبي

153
00:10:51,370 --> 00:10:55,300
.لقد عاش أبي حياته بالصّواب حتّى الممات

154
00:10:56,300 --> 00:10:59,800
إذًا، ما هو "الصواب" بالنّسبة لي؟

155
00:11:01,110 --> 00:11:05,300
.تكبّدتُ إصابةً هدّدت حياتي أثناء تلك المعركة

156
00:11:05,840 --> 00:11:08,810
.إصابة لا تنفكّ عن النزيف بسبب لعنة يوكاي

157
00:11:09,690 --> 00:11:11,810
...وأثناء المعركة ضدّ المعلّم الأعظم

158
00:11:12,400 --> 00:11:13,810
!تايكوبو

159
00:11:14,170 --> 00:11:16,070
!أترك الباقي عليك

160
00:11:18,350 --> 00:11:20,040
.مات أبي...

161
00:11:22,700 --> 00:11:25,530
.بعدها، تهتُ عن وجهتي

162
00:11:26,100 --> 00:11:29,710
لأجل من وماذا سأقاتل إذًا؟

163
00:11:31,230 --> 00:11:35,100
لا يمكنني أن أقاتل بصرامة
لأجل عالم البشر أو عالم السينين

164
00:11:35,100 --> 00:11:38,740
.كما يفعل رجال الباوبي أو يوزن

165
00:11:40,010 --> 00:11:45,600
لأجل أن أتفوّق على أبي وأجعله
.يعترف بي... تلك كانت أهدافي الوحيدة

166
00:11:46,660 --> 00:11:50,130
،بعد تفكيري مليًّا عمّاذا يجب أن أفعل الآن

167
00:11:50,130 --> 00:11:52,210
:وجدتُ إجابتي

168
00:11:53,280 --> 00:11:59,920
بأن أرث رغبته في هزيمة
.الين وإنشاء سلالة شو الحاكمة

169
00:12:00,660 --> 00:12:02,930
.لكن لم أعد أملك متّسعًا من الوقت

170
00:12:02,930 --> 00:12:04,690
...هذا الجرح في بطني

171
00:12:05,620 --> 00:12:08,300
،إن أمكنني على الأقل أن أُجهز على الملك تشو بيدي

172
00:12:08,300 --> 00:12:11,070
.سيكون ذلك بُرهان تفوّقي على أبي

173
00:12:13,080 --> 00:12:14,620
...يا للحنين

174
00:12:16,360 --> 00:12:18,450
كم مرّ من عام؟

175
00:12:18,990 --> 00:12:22,140
.قاتلتُ البوسيو مرّةً هنا

176
00:12:23,120 --> 00:12:24,340
...الملك تشو

177
00:12:25,080 --> 00:12:26,140
أنت الملك تشو؟

178
00:12:30,510 --> 00:12:33,900
ما الذي يخطّط إليه أوتينكون؟

179
00:12:41,000 --> 00:12:43,580
.أنت تشبه البوسيو إلى حدٍّ كبير

180
00:12:44,440 --> 00:12:47,410
كو تينكا، صحيح؟

181
00:12:53,410 --> 00:12:55,270
لا يمكنني أن أستخدم الباوبي خاصتي؟

182
00:12:58,480 --> 00:12:59,670
.استخدم هذا

183
00:13:01,520 --> 00:13:05,740
.والآن، قاتلني أيّها الدوشي الصغير

184
00:13:09,570 --> 00:13:11,720
.بدأت السماء تسطع أكثر

185
00:13:11,720 --> 00:13:13,430
.تشوكا أمام ناظرنا الآن

186
00:13:13,900 --> 00:13:17,580
لكنّ نور الصّباح يبعث بشعورٍ
خاطئ، أليس كذلك يا هيتو؟

187
00:13:17,580 --> 00:13:20,440
حقًّا؟ ألا تحبّ الشروق؟

188
00:13:21,260 --> 00:13:24,190
.فقط يُوتّرني نوعًا ما

189
00:13:25,970 --> 00:13:30,340
.يُشعرني وكأنّ شيئًا جيّدًا وآخر سيّئًا سيحدثان

190
00:13:44,290 --> 00:13:46,470
.بدأ الضّوء يسطع

191
00:13:57,820 --> 00:14:01,160
!والآن، أنا آتٍ إليك أيها الملك تشو

192
00:14:01,160 --> 00:14:01,980
.تعال إذًا

193
00:14:02,560 --> 00:14:04,990
!سأريك كلّ ما تعلّمت من تدريب بونتشو

194
00:14:05,270 --> 00:14:06,610
!ومن يهتمّ لذلك؟

195
00:14:06,610 --> 00:14:10,490
!أملك دم البوسيو، كو هيكو يجري في عروقي

196
00:14:22,720 --> 00:14:24,010
...كو تينكا

197
00:14:24,860 --> 00:14:26,820
،شكله ليس كالبوسيو أبدًا

198
00:14:27,370 --> 00:14:30,820
.لكنّه ورث روحه القتالية بالتأكيد

199
00:14:31,510 --> 00:14:33,600
.أحسدك يا بوسيو

200
00:14:34,150 --> 00:14:38,070
...أردتُ أن أورث شيئًا لطفليّ أيضًا

201
00:14:44,270 --> 00:14:47,850
.تبًّا... بدأت رؤيتي تتشوّش

202
00:14:47,850 --> 00:14:50,530
.لستُ واثقًا ما إن كنتُ أستطيع هزيمته

203
00:14:50,960 --> 00:14:53,780
...حتّى أنّه نجح في هزيمة أبي من قبل

204
00:14:53,780 --> 00:14:59,880
!إنّه قويّ، لكنّه سببٌ آخر يدفعني لعدم الخسارة

205
00:14:59,880 --> 00:15:01,540
!لن أخسر أمامك

206
00:15:01,800 --> 00:15:04,040
!أرني ما لديك يا ابن البوسيو

207
00:15:18,430 --> 00:15:20,060
!اللعنة عليك

208
00:15:49,670 --> 00:15:52,340
.لقد خسرت يا كو تينكا

209
00:15:55,230 --> 00:15:59,110
.كان هذا القتال محسومًا قبل بدايته

210
00:15:59,890 --> 00:16:05,610
.لم... لم أعد أملك شيئًا يستحقّ القتال لأجله في النهاية

211
00:16:06,370 --> 00:16:11,860
.رجاءً... خذ رأسي وأريه للجميع

212
00:16:12,720 --> 00:16:14,610
.تلك ستكون نهاية الين

213
00:16:16,380 --> 00:16:18,860
،أشكرك أيها الملك تشو

214
00:16:18,860 --> 00:16:21,940
.لكونك خصمي الأخير

215
00:16:22,440 --> 00:16:23,370
...لكن

216
00:16:25,360 --> 00:16:28,800
.لستُ أنا من سيأخذ رأسك

217
00:16:29,340 --> 00:16:34,140
.سأدع تايكوبو يتكفّل بالباقي

218
00:16:35,160 --> 00:16:37,310
.كنتُ أنانيًّا

219
00:16:37,950 --> 00:16:42,390
لذا سأعيش الآن ما بقي من
.حياتي بهدوء كما نصحني تايكوبو

220
00:16:43,800 --> 00:16:44,890
هل أنت واثق؟

221
00:16:45,480 --> 00:16:46,360
.أجل

222
00:16:46,930 --> 00:16:51,400
.لم أعد أملك سببًا أقاتل لأجله

223
00:16:56,910 --> 00:17:01,540
!خدمت عائلتي بيت ا-ا-الين لـ-لأجيال

224
00:17:01,540 --> 00:17:07,000
...لذا، كـ-كـ-كلّ من يعصي ا-ا-الملك تشو سوف

225
00:17:12,620 --> 00:17:17,510
...لم أتوقّع أن أموت هكذا

226
00:17:22,000 --> 00:17:24,520
!تينكا

227
00:17:25,610 --> 00:17:27,190
!سيدي، إنّي أراه

228
00:17:28,000 --> 00:17:31,690
!تينكا

229
00:17:39,270 --> 00:17:40,100
...تينكا

230
00:17:43,160 --> 00:17:45,580
...تـ-تينكا

231
00:17:45,910 --> 00:17:46,710
!تينكا

232
00:17:48,880 --> 00:17:51,210
.تينكا... أنا آسف

233
00:17:52,410 --> 00:17:53,490
.أنا آسف

234
00:18:14,570 --> 00:18:16,250
.هذا بائس

235
00:18:16,250 --> 00:18:17,300
.بالفعل

236
00:18:17,300 --> 00:18:19,490
.بوكيتشي، تعال إلى هنا للحظة

237
00:18:19,770 --> 00:18:20,850
!حاضر

238
00:18:20,850 --> 00:18:24,120
،اطلب من شو أن يجلبوا بعضًا من طعامهم ولباسهم

239
00:18:24,450 --> 00:18:26,790
.ووزّعوها على هؤلاء النّاس

240
00:18:26,790 --> 00:18:27,620
!حاضر

241
00:18:31,480 --> 00:18:32,130
...أهذا

242
00:18:32,910 --> 00:18:34,500
تينكا أم الملك تشو؟

243
00:18:34,960 --> 00:18:36,630
أم هو تايكوبو؟

244
00:18:36,870 --> 00:18:37,820
...الملك بو

245
00:18:37,820 --> 00:18:39,150
.أعلم

246
00:18:40,100 --> 00:18:44,940
.فلنتقدّم بجرأة. لا داعي للاستعجال

247
00:18:46,790 --> 00:18:47,860
.معك حق

248
00:19:02,370 --> 00:19:03,410
!هناك

249
00:19:03,710 --> 00:19:05,640
!لا بد أنه تحت سوبوشان

250
00:19:05,640 --> 00:19:06,410
!أجل

251
00:19:07,340 --> 00:19:08,770
...تينكا

252
00:19:09,920 --> 00:19:12,690
تايكوبو! أين هو تينكا؟

253
00:19:14,190 --> 00:19:15,380
!تايكوبو

254
00:19:17,130 --> 00:19:18,040
...الملك بو

255
00:19:20,020 --> 00:19:21,690
.لقد حانت اللحظة الأخيرة

256
00:19:22,760 --> 00:19:25,940
،اللحظة الأخيرة للسّطوع
.تركها لنا تينكا

257
00:19:26,390 --> 00:19:27,930
.ضع نهايةً لهذه الحرب الآن

258
00:19:32,680 --> 00:19:33,650
...الملك تشو

259
00:19:35,640 --> 00:19:38,240
.إذًا أنت هو... الملك تشو

260
00:19:39,340 --> 00:19:42,950
.التقط ذلك السّيف واتبعني

261
00:19:43,410 --> 00:19:47,960
.لا تقلق. لم تعد لديّ أيّ قوة

262
00:19:50,850 --> 00:19:55,340
.الملك تشو، أنا متأكّد جيدًا أنّني أعلم فيمَ تُفكّر

263
00:19:56,230 --> 00:19:58,910
.يجب عليك أن تكتسي كما يجب على الأقل لهذه اللحظة

264
00:20:00,120 --> 00:20:02,420
.يمكنني أن أنتظرك حتّى تُغيّر ملابسك

265
00:20:03,720 --> 00:20:04,820
.شكرًا لك

266
00:20:09,950 --> 00:20:11,740
!انظروا! في قمّة المِتراس

267
00:20:11,740 --> 00:20:12,150
أين؟

268
00:20:12,150 --> 00:20:13,270
!أحدهم يتسلّق

269
00:20:13,270 --> 00:20:13,920
من يكون؟

270
00:20:13,920 --> 00:20:15,450
...مهلًا! إنه

271
00:20:18,810 --> 00:20:20,070
!الملك تشو؟

272
00:20:20,070 --> 00:20:20,740
!ماذا؟

273
00:20:21,050 --> 00:20:22,700
!إنه الملك تشو والملك بو

274
00:20:24,160 --> 00:20:26,240
.صه! سيقول شيئًا

275
00:20:26,480 --> 00:20:28,410
...أمّي، أذاك الرّجل

276
00:20:51,400 --> 00:20:52,360
.آسف بشأن هذا

277
00:20:53,030 --> 00:20:55,270
هل لديك أيّ طلب أخير؟

278
00:20:58,820 --> 00:21:02,020
.كلّ النّاس الذين أردتُ رؤيتهم في الأخير قد رحلوا

279
00:21:02,440 --> 00:21:03,660
،كيوشي

280
00:21:03,660 --> 00:21:05,090
،ولداي

281
00:21:05,090 --> 00:21:07,360
...بونتشو و

282
00:21:07,780 --> 00:21:12,670
...لن يُصدّقني أحد، لكن حتّى الآن بعد زوال التعويذة

283
00:21:12,670 --> 00:21:13,540
...لا تزال داكّي

284
00:21:20,810 --> 00:21:22,550
!بهذا، تنتهي الين

285
00:21:22,840 --> 00:21:25,800
!انتهت الحرب وانتصرت شو

286
00:21:39,310 --> 00:21:41,190
.الهتافات جامحة

287
00:21:43,040 --> 00:21:47,220
.هذا دليلٌ لا ريب فيه أنّهم يقبلونه كملِكهم الجديد

288
00:21:51,900 --> 00:21:55,110
تايكوبو، هل ستُغادر حقًّا؟

289
00:21:55,110 --> 00:21:56,460
.ابقَ هنا

290
00:21:56,720 --> 00:21:59,460
سار كلّ شيء بشكلٍ عظيم حتّى الآن، أليس كذلك؟

291
00:22:02,120 --> 00:22:03,460
.لستُ واثقًا

292
00:22:04,110 --> 00:22:07,050
.نملك ما نفعله أيضًا

293
00:22:11,600 --> 00:22:12,470
.حسنًا

294
00:22:13,270 --> 00:22:14,470
...لكن

295
00:22:15,120 --> 00:22:17,980
ليس وكأنّ هذا وداعًا أبديّ، صحيح؟

296
00:22:19,590 --> 00:22:20,340
!صحيح

297
00:24:08,280 --> 00:24:10,070
أما زلت لا تستطيع حسم أمرك؟

298
00:24:12,430 --> 00:24:13,470
.اقفز على ظهري

299
00:24:16,810 --> 00:24:18,200
.اقفز أو مت

300
00:24:27,760 --> 00:24:28,980
.لا تقلق

301
00:24:30,190 --> 00:24:31,990
.سوف أُربّيك

302
00:24:33,480 --> 00:24:36,990
.لكنّ الجميع سيموتون على أي حال

303
00:24:37,240 --> 00:24:42,310
!أنت وتايكوبو والجميع ستموتون وتتركونني

304
00:24:42,310 --> 00:24:44,000
!لذا لستُ بحاجةٍ لأيّ أحد

305
00:24:44,360 --> 00:24:45,250
.لن أموت

306
00:24:47,560 --> 00:24:51,280
.ولو كبرتُ وتمزّقت كلّ أطرافي

307
00:24:51,280 --> 00:24:52,220
تعلم ذلك، صحيح؟

308
00:24:57,800 --> 00:24:58,470
.أجل