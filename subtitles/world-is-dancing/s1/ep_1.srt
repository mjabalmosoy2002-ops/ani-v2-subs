1
00:00:09,260 --> 00:00:11,580
ما من شيءٍ إلّا ومصيره الفناء

2
00:00:11,930 --> 00:00:16,040
وما اشتدّت شوكة قومٍ إلّا ووافاهم الأفول يومًا

3
00:00:16,350 --> 00:00:17,810
يا للأسى

4
00:00:17,810 --> 00:00:19,410
يا للأسى حقًّا

5
00:00:20,510 --> 00:00:25,210
بيد أنّ البقاء يحتم علينا الإذعان لسنّةٍ كهذه

6
00:00:28,030 --> 00:00:29,940
أمِن أمرٍ حدث؟

7
00:00:31,620 --> 00:00:35,380
رُغم ما به هذا المكان، ما زالت الأزهار تتفتّح

8
00:00:38,520 --> 00:00:42,710
...بين البلاط الشماليّ في كيوتو، والبلاط الجنوبيّ في يوشينو

9
00:00:42,710 --> 00:00:47,220
أتى زمنٌ مزّق نسيج البلاطين، وما خمدت نار الحروب بينهما منذئذ

10
00:00:48,390 --> 00:00:49,940
لنمضِ

11
00:00:53,930 --> 00:00:58,430
،فما كان لويلاتِها إلّا أن أذاقت النّاس الجوع، وسلبتهم أسباب رزقهم وأُنسِهم

12
00:00:58,430 --> 00:01:01,240
بل والحياة بحدّ ذاتها

13
00:01:50,570 --> 00:01:52,280
!هيّا يا فرقة كانزي

14
00:01:52,280 --> 00:01:53,420
!كان-ساما

15
00:01:53,990 --> 00:01:56,050
ما وجه المتعة في هذا؟

16
00:01:59,370 --> 00:02:01,390
أرجو أن يمضي كلّ شيءٍ على خير اليوم

17
00:02:01,390 --> 00:02:03,250
ماذا تفعل يا إيشيا؟

18
00:02:03,250 --> 00:02:04,170
غورو؟

19
00:02:04,170 --> 00:02:05,350
سينتبهون إليك

20
00:02:07,750 --> 00:02:10,030
ها هو سيّدي الشّاب

21
00:02:10,590 --> 00:02:12,030
شارد الذّهن كعادته

22
00:02:15,550 --> 00:02:18,590
للطّيور عظامٌ في غاية الخِفّة

23
00:02:19,770 --> 00:02:23,080
ولهذا تستطيع التّحليق

24
00:02:23,840 --> 00:02:28,450
وللحصان أرجلٌ نحيلةٌ، وهذا مكمن سرعتِها

25
00:02:29,480 --> 00:02:31,770
جُبلت الطّيور على التّحليق

26
00:02:32,410 --> 00:02:34,870
كما جُبلت الأحصنة على العدو سريعًا

27
00:02:34,870 --> 00:02:38,280
وعليه، ما الذي جُبل عليه البشر؟

28
00:02:38,280 --> 00:02:39,170
سيّدي الشّاب؟

29
00:02:40,590 --> 00:02:42,560
ليس الرّقص

30
00:02:44,380 --> 00:02:45,970
أقطعُ بذلك

31
00:02:46,790 --> 00:02:50,600
إذ يبدو الرّقص منافيًا لطبيعة البشر

32
00:02:51,380 --> 00:02:55,280
ولا يزال النّاس يتكلّفون أداء ما ينافي طبيعتهم رُغم ذلك

33
00:02:55,590 --> 00:02:57,030
أعجز عن الفهم

34
00:02:57,030 --> 00:02:59,940
!سيّدي الشّاب؟ سيّدي الشّاب! سيّدي الشّاب

35
00:03:15,280 --> 00:03:16,910
!حان دورك يا سيّدي الشّاب

36
00:03:16,910 --> 00:03:18,260
!سيّدي الشّاب

37
00:03:18,570 --> 00:03:19,840
!مهلًا

38
00:03:26,500 --> 00:03:28,100
!سيّدي الشّاب! سيّدي الشّاب

39
00:03:28,380 --> 00:03:29,970
!أونياشا

40
00:03:46,490 --> 00:03:48,770
أتحدّث إليك يا جينين كوجي

41
00:03:48,770 --> 00:03:50,360
هاتِ ما عندك

42
00:03:50,360 --> 00:03:51,200
!عظيم

43
00:03:51,520 --> 00:03:53,040
هيّا امضِ

44
00:03:54,310 --> 00:03:57,050
!يا لحسرتي، أخفقتُ ثانيةً

45
00:04:05,870 --> 00:04:07,910
ما بها هذه الدّمية؟

46
00:04:09,000 --> 00:04:11,020
!أعدها إليّ

47
00:04:11,880 --> 00:04:12,830
أعتذر إليك

48
00:04:12,830 --> 00:04:15,290
لا عليك، فما كنتُ منتبهًا أنا أيضًا

49
00:04:39,320 --> 00:04:40,490
سلحفاة؟

50
00:04:40,490 --> 00:04:41,880
أُدعى كاميكيتشي

51
00:04:41,880 --> 00:04:45,760
أبتِ، أتقدّم إليك ببالغ الاعتذار

52
00:04:46,870 --> 00:04:47,970
ما الدّاعي؟

53
00:04:54,420 --> 00:04:57,070
تُعدّ جينين كوجي عُمدة عروض فرقة كانزي

54
00:04:54,420 --> 00:04:57,070
مسرحية جينين كوجي واحدة من العروض التي أبدعها المؤدي والكاتب المسرحي كان-آمي في القرن الرابع عشر وتحكي عن راهبٍ متجول، أخذ يطارد تجّار بشرٍ لينقذ يتيمةً باعت نفسها لتمويل جنازة والديها

55
00:04:57,890 --> 00:05:02,320
إن تلاشى صيتُها، فلعلّ أثر ذلك سيطال جميع عروض الساروغاكو

56
00:05:04,300 --> 00:05:08,240
أعتذر ممّا سببتُه من تعطيلٍ لهذا العرض الفنّي

57
00:05:11,700 --> 00:05:14,700
حسنًا، ما دمت تعي الأمر

58
00:05:15,490 --> 00:05:16,580
...معذرةً

59
00:05:16,580 --> 00:05:18,390
يا هيفومي وتوشيغو

60
00:05:18,870 --> 00:05:19,460
نعم؟

61
00:05:19,870 --> 00:05:21,070
تنحيا جانبًا

62
00:05:31,560 --> 00:05:34,060
أمتعني عرضك اليوم

63
00:05:34,580 --> 00:05:36,040
شكرًا لك

64
00:05:36,040 --> 00:05:37,460
بانتظار لقائك مجدّدًا

65
00:05:37,460 --> 00:05:38,980
!كان-ساما

66
00:05:38,980 --> 00:05:41,780
عظيم، أأتيت مجدّدًا؟

67
00:05:41,780 --> 00:05:45,840
الساروغاكو أيّ حرفيًا ترفيه القردة أو موسيقى القردة وهو فنٌّ يعود أصله إلى الصين ولمعنى اسمه نصيبٌ فيه، إذ بدأ عروضًا فُكاهيةً وبهلوانيّة، وبفضل جهود كان-آمي تطّور وغدا أكثر رصانة حتّى أخذ يتربّع على عرش الفنون آنذاك

68
00:05:41,780 --> 00:05:45,840
!دنا اليوم الذي سيعلو شأن مسرح الساروغاكو على مسرح الدينغاكو

69
00:05:45,840 --> 00:05:48,110
أمّا الدينغاكو، فيعني موسيقى الأرز، وهو فنٌّ تقليديٌّ تَعُودُ أصولُه إلى الطقوس الزراعية
وقد كان الدينغاكو الفنَّ السائد والمحبوب، قبل أن يزيحه الساروغاكو عن عرش الصّدارة

70
00:05:45,840 --> 00:05:48,110
هذا بفضلكم

71
00:05:48,430 --> 00:05:50,660
لتشارك هذا الطّعام مع الفرقة

72
00:05:51,060 --> 00:05:52,580
شكرًا

73
00:05:52,580 --> 00:05:57,540
أليس لقائدنا طاقة لا تنفد؟

74
00:05:57,540 --> 00:06:01,300
يتنامى إقبال الجماهير علينا أكثر فأكثر

75
00:06:01,780 --> 00:06:06,860
يا معلم، أصحيحٌ أنّنا تلقّينا دعواتٍ لأداء عرضٍ في العاصمة؟

76
00:06:07,570 --> 00:06:08,820
صحيح

77
00:06:08,820 --> 00:06:10,220
عظيم حقًّا

78
00:06:10,670 --> 00:06:14,040
إنّه لمن العجيب حقًّا أن ينهض بالفرقة في جيلٍ واحدٍ فحسب

79
00:06:14,040 --> 00:06:15,460
....وللأسف

80
00:06:15,460 --> 00:06:17,140
!أونياشا-ساما

81
00:06:17,500 --> 00:06:19,530
أبخيرٍ أنت؟

82
00:06:20,290 --> 00:06:21,750
...إيشيا

83
00:06:24,320 --> 00:06:27,260
غضب منّي ثانيةً

84
00:06:27,260 --> 00:06:28,340
لا تبكِ

85
00:06:28,340 --> 00:06:29,390
بكاء، بكاء

86
00:06:29,390 --> 00:06:32,740
سأعينك في سحبها، فشاهدني من فضلك

87
00:06:33,150 --> 00:06:34,200
واحد، اثنان

88
00:06:44,490 --> 00:06:46,760
كفاك، سأسحبها وحدي

89
00:06:46,760 --> 00:06:49,170
يا له من صبيٍّ كثير البكاء

90
00:06:49,170 --> 00:06:53,080
حَسْبُه أنّه لا يبكي أمام أبيه

91
00:06:53,080 --> 00:06:58,850
...صحيح ولكننا على أعتاب بزوغ فجرٍ جديدٍ للساروغاكو

92
00:06:58,850 --> 00:07:01,040
!ثابر يا أونياشا

93
00:07:01,040 --> 00:07:04,130
!فلتكافئ نفسك بالدانغو بعد أن تنتهي من عملك

94
00:07:02,190 --> 00:07:04,680
له وجهٌ جميلٌ في الأقل

95
00:07:06,050 --> 00:07:09,130
ليتني وسيمٌ أنا الآخر

96
00:07:10,590 --> 00:07:12,690
أسخرت منّي لتوّك؟

97
00:07:12,690 --> 00:07:14,580
!فعلتَها مجدّدًا

98
00:07:22,910 --> 00:07:24,500
لن ننتهي أبدًا

99
00:07:24,860 --> 00:07:28,450
في التّراث الشعبي الياباني، يرمز اليوكاي لمجموعةٍ واسعة من الأرواح والوحوش
وحتّى الظواهر الغريبة ومن أشهرها الأوني، وتعني الشياطين أو الغيلان

100
00:07:24,860 --> 00:07:28,450
لا بدّ أنّ اليوكاي يضعون ثقلهم فوق هذه العربة

101
00:07:28,450 --> 00:07:30,490
يـ-يوكاي؟

102
00:07:30,490 --> 00:07:35,110
على ذكر ذلك، فقد تناهى إلى مسامعي أنّ كثيرًا
من الأرواح الشّريرة تهيم في هذه الأرجاء

103
00:07:39,130 --> 00:07:42,270
إيشيا، بوسعك الذّهاب إلى المنزل

104
00:07:42,920 --> 00:07:46,850
فقد كلّفني أبي بهذا العمل لأنجزه بنفسي على كلٍّ

105
00:07:47,220 --> 00:07:48,630
...سيّدي

106
00:07:49,140 --> 00:07:50,570
ألا تنوي التّملّص؟

107
00:07:50,570 --> 00:07:51,430
!صدمة

108
00:07:51,430 --> 00:07:56,230
أحسبتني لم ألحظك تتسلّل خلسةً إلى المدينة حينها؟

109
00:07:56,230 --> 00:07:57,950
!ما كنتُ قاصدًا المدينة

110
00:07:58,440 --> 00:08:01,530
...إنّما نزلتُ إلى النّهر

111
00:08:01,530 --> 00:08:03,200
!وكنت أتدرّب أيضًا

112
00:08:03,200 --> 00:08:06,960
لكن لا يُسمح لك بالذّهاب إلى الخارج إلّا بإذن أبيك

113
00:08:06,960 --> 00:08:08,740
...لكن

114
00:08:08,740 --> 00:08:11,240
وما الضير في الخروج لهنيهةٍ؟

115
00:08:11,240 --> 00:08:16,970
!فما انقضى وقتي إلّا بالقراءة والكتابة والتدريب منذ عهد صباي

116
00:08:17,290 --> 00:08:20,660
لِمَ لا أحظى بفسحةٍ لنفسي؟

117
00:08:21,130 --> 00:08:25,390
مهلًا! أيعقل أنّك تعينُني لتراقبني فحسب؟

118
00:08:25,390 --> 00:08:26,230
!صدمة

119
00:08:27,090 --> 00:08:28,780
أبتوجيهٍ من أبي؟

120
00:08:28,780 --> 00:08:30,760
...حسنًا

121
00:08:30,760 --> 00:08:32,840
!أعتذر إليك يا سيّدي الشّاب

122
00:08:32,840 --> 00:08:34,190
ضقتُ ذرعًا بالوضع

123
00:08:34,800 --> 00:08:38,200
لا همّ للجميع سوى والدي

124
00:08:40,440 --> 00:08:43,650
ولا يشغل بال والدي سوى فنّه

125
00:08:43,650 --> 00:08:48,250
لا يرى فيّ ابنًا له

126
00:08:55,390 --> 00:09:00,000
أبي لا يعلّمني فنّه

127
00:09:02,180 --> 00:09:06,250
وإنّما يُراقبني ليرى إن كنتُ أفهم ما الأداء الحسن

128
00:09:06,250 --> 00:09:09,160
وما ليس بأداءٍ حسن

129
00:09:10,170 --> 00:09:11,530
!استقم

130
00:09:27,240 --> 00:09:29,660
لم تُجبل على الرّقص

131
00:09:29,660 --> 00:09:33,010
لهذا أداؤك ليس بحسن

132
00:10:03,290 --> 00:10:05,830
أكره الرّقص

133
00:10:21,210 --> 00:10:24,540
!أكره أبي

134
00:10:26,390 --> 00:10:30,760
أعجز عن فهم ما يدور في خلد أبي

135
00:10:30,760 --> 00:10:32,590
حقًّا؟

136
00:10:32,590 --> 00:10:34,570
أتفهمه يا إيشيا

137
00:10:34,930 --> 00:10:36,340
...إنّما أعني

138
00:10:36,340 --> 00:10:41,930
...ثمّة فكرةٌ تراودني، غير أنّ معالمها لا تزال مبهمة

139
00:10:42,580 --> 00:10:43,580
!ها هي ذي

140
00:10:43,980 --> 00:10:47,620
إنّ في رقص قائدنا تغييرًا للعالم

141
00:10:48,110 --> 00:10:50,970
تغييرًا للعالم؟

142
00:10:51,560 --> 00:10:54,800
تغييرًا... للعالم؟

143
00:10:55,320 --> 00:10:57,450
لعلّ فهم ما قلتُ عسيرٌ

144
00:10:57,450 --> 00:10:59,210
أ-أعذرني

145
00:11:00,160 --> 00:11:07,100
لِعلّةٍ في ساقي، أعجز عن التّرحال لمسافاتٍ طويلةٍ والرّقص بشتّى أنواعه

146
00:11:07,460 --> 00:11:09,850
،لكن لسببٍ ما

147
00:11:10,130 --> 00:11:12,550
،حين أرى رقص قائدنا

148
00:11:12,550 --> 00:11:15,010
أشعر بأنّ ليّ القدرة على بلوغ أيّ مدىً تتوق إليه نفسي

149
00:11:15,470 --> 00:11:18,950
تلك هي قوّة رقص قائدنا

150
00:11:21,280 --> 00:11:23,660
يشقّ عليّ فهم الأمر

151
00:11:23,660 --> 00:11:28,020
!على كلٍّ، إيّاك والتّجول من دوني

152
00:11:28,020 --> 00:11:29,250
أفهمت؟

153
00:11:31,150 --> 00:11:32,600
حسنًا، فهمت

154
00:11:33,200 --> 00:11:34,820
!رائع

155
00:11:36,620 --> 00:11:38,010
أونياشا-ساما؟

156
00:11:38,320 --> 00:11:41,460
أين أنت يا سيّدي الشّاب

157
00:11:41,460 --> 00:11:43,810
سيّدي الشّاب؟

158
00:11:44,170 --> 00:11:46,420
أونياشا-ساما؟

159
00:11:46,420 --> 00:11:47,810
سيّدي الشّاب؟

160
00:11:48,080 --> 00:11:50,220
أين أنت؟

161
00:11:51,080 --> 00:11:52,930
أونياشا-ساما

162
00:11:51,710 --> 00:11:52,930
أمجدّدًا؟

163
00:11:58,400 --> 00:12:01,630
!سيّدي الشّاب، اظهر من فضلك

164
00:12:02,340 --> 00:12:04,550
!أرجوك يا سيّدي الشّاب

165
00:12:03,220 --> 00:12:04,550
سامحني يا إيشيا

166
00:12:04,550 --> 00:12:06,590
أين أنت؟

167
00:12:54,870 --> 00:12:56,560
!كوغاني-دونو

168
00:12:57,170 --> 00:12:59,950
أأحزنك والدك ثانيةً؟

169
00:12:59,950 --> 00:13:02,410
لا بدّ أنّك حزينٌ أيضًا

170
00:13:02,410 --> 00:13:05,090
أشجارٌ آخر مع رفيقك؟

171
00:13:05,090 --> 00:13:08,630
!لا أصاحبُ فتًى كذاك

172
00:13:08,630 --> 00:13:11,930
لا أحسبه حيًّا، بل هو شيطان

173
00:13:11,930 --> 00:13:14,350
!أبي أيضًا شيطان

174
00:13:14,790 --> 00:13:18,790
أوليس اسمك أونياشا لأنّك ابن شيطان إذًا؟

175
00:13:19,430 --> 00:13:21,210
!ليس هذا هو السبب

176
00:13:22,220 --> 00:13:25,480
لم أرك في الآونة الأخيرة، كيف حالك؟

177
00:13:25,480 --> 00:13:26,840
ماذا عنك؟

178
00:13:26,840 --> 00:13:29,490
وما حال أخيك الذي ولد من القرع؟

179
00:13:29,490 --> 00:13:31,810
ماذا؟ أقلتُ ذلك حقًّا؟

180
00:13:31,810 --> 00:13:33,000
!أجل قلتَها

181
00:13:33,000 --> 00:13:35,650
وقلتَ قبلها إنّك أتيت من وراء البحر

182
00:13:35,650 --> 00:13:38,610
وذكرت لي مرّة أنّك وجدت أرنبًا ناطقًا

183
00:13:38,610 --> 00:13:39,700
!مرحبًا

184
00:13:39,700 --> 00:13:43,420
،أمّا أنت، فزعمت أنّك عشت مع يوكاي شجرة الصنوبر

185
00:13:43,420 --> 00:13:46,340
وكادت أن تبتلعك

186
00:13:46,340 --> 00:13:48,490
أقلتُ ذلك حقًّا؟

187
00:13:48,490 --> 00:13:51,180
ألا نهذي دائمًا بسفاسف الحكايات؟

188
00:13:51,180 --> 00:13:55,080
!ولأنّك تفعل ذلك، حذيتُ حذوك وصنعتُ مثلك

189
00:13:55,080 --> 00:13:59,320
!لكنّني حقًّا أهوى سفاسف حكاياتك

190
00:13:59,890 --> 00:14:01,110
حقًّا؟

191
00:14:01,110 --> 00:14:02,920
!أجل، بالتّأكيد

192
00:14:06,430 --> 00:14:08,450
لك ساقان قويّتان

193
00:14:09,060 --> 00:14:10,330
...كوغاني-دونو

194
00:14:11,520 --> 00:14:12,790
!تبدو مضحكًا

195
00:14:16,080 --> 00:14:17,950
!لن تمسك بي

196
00:14:17,950 --> 00:14:19,660
!قف مكانك

197
00:14:41,970 --> 00:14:43,920
ما ذاك الصّخب؟

198
00:14:44,590 --> 00:14:47,040
أُلغي المهرجان

199
00:14:47,510 --> 00:14:49,900
إذ الحصاد شحيحٌ هذا العام

200
00:14:50,430 --> 00:14:53,120
لا بدّ أنّها رقصة الحشود الصّاخبة

201
00:14:53,120 --> 00:14:56,040
رقصة الحشود... الصّاخبة؟

202
00:14:56,440 --> 00:14:59,770
وإن وضعت الحروب الكُبرى أوزارها، لا يجد النّاس ما يأكلوه

203
00:14:59,770 --> 00:15:01,940
فينتزع الموت أرواحهم دون مشقة

204
00:15:01,940 --> 00:15:04,620
،يسرق البعض ليعيش

205
00:15:04,620 --> 00:15:07,010
ومن النّساء من يبعنَ أجسادهنّ كذلك

206
00:15:08,240 --> 00:15:10,510
ضاقت نفوس العالمين بهذه الدّنيا

207
00:15:10,870 --> 00:15:13,250
فيجد النّاس متنفسًا لهم في الرّقص

208
00:15:13,250 --> 00:15:16,870
وما الجدوى من ذلك؟

209
00:15:17,710 --> 00:15:21,110
يلقى النّاس حتفهم سواءً أرقصوا أم لا

210
00:15:22,550 --> 00:15:25,940
لا سبيل للرقص في تغيير العالم

211
00:15:30,090 --> 00:15:32,000
سأعود إلى المنزل

212
00:15:32,480 --> 00:15:33,450
حسنًا

213
00:15:35,300 --> 00:15:39,260
لم يُجبل النّاس على الرّقص

214
00:15:39,260 --> 00:15:44,450
إن أوتي النّاس القوت والمأوى، تسنّى لهم العيش دون أن يرقصوا

215
00:15:45,330 --> 00:15:50,380
فما بالهم إذًا يترقّبونه بأعينهم وتمتهنا أجسداهم؟

216
00:15:51,570 --> 00:15:53,170
لماذا يا تُرى؟

217
00:16:00,420 --> 00:16:02,470
!لقد ضِعت

218
00:16:17,450 --> 00:16:22,250
أعتذر من مقاطعتك، فقد أضعت طريقي

219
00:16:25,560 --> 00:16:26,880
من هناك

220
00:16:27,870 --> 00:16:29,570
ممتنٌ لك

221
00:16:36,710 --> 00:16:39,930
لِمَ جُلبنا إلى العالم

222
00:16:39,130 --> 00:16:39,930
غناء؟

223
00:16:39,930 --> 00:16:45,520
ألنمرح ونلعب؟

224
00:16:45,920 --> 00:16:47,750
الشيرابيوشي هنّ راقصاتٌ ومغنّيات، وبلغت شهرتهنّ أشدّها في القرن الثاني عشر وكنّ يؤدين عروضهنّ أمام النّبلاء في الاحتفالات ، وغالبًا ما ترتدي هؤلاء النّساء زيّ الرجال (قبعة إيبوشي وملابس ساموراي)

225
00:16:45,920 --> 00:16:47,750
شيرابيوشي؟

226
00:16:45,920 --> 00:16:51,440
لِمَ جُلبنا إلى العالم

227
00:16:51,440 --> 00:16:57,030
ألنزهو بالمرح؟

228
00:16:57,030 --> 00:16:59,070
يا له من صوتٍ أجش

229
00:16:57,030 --> 00:17:08,890
ولمّا أستمع إلى صوت الأطفال إذ يلعبون

230
00:16:59,780 --> 00:17:01,450
...لكن

231
00:17:09,940 --> 00:17:22,360
يتراقص جسدي ويتمايل طوع نغماتهم

232
00:18:05,140 --> 00:18:08,250
تراقص فتراقص أيّها الحلزون

233
00:18:08,250 --> 00:18:12,980
وإلّا نالت منك رفسات الخيول والأبقار

234
00:18:33,370 --> 00:18:34,840
هذا حَسَن

235
00:19:06,560 --> 00:19:08,790
!أعتذر من التطفل

236
00:19:19,280 --> 00:19:20,700
...ذاك

237
00:19:20,700 --> 00:19:21,920
أفي ذلك تجلّى "الحُسن"؟

238
00:19:22,920 --> 00:19:24,720
لا أفهم

239
00:19:24,720 --> 00:19:28,080
ولماذا لقي استحساني؟

240
00:19:28,640 --> 00:19:29,970
لا أعي البتّة

241
00:19:30,580 --> 00:19:34,540
...لكن إن غشاني ذاك "الحُسن" يومًا

242
00:19:35,930 --> 00:19:38,960
...لو أتى ذلك اليوم

243
00:20:00,640 --> 00:20:04,750
أونياشا، البالغ أحد عشرة سنةً

244
00:20:05,510 --> 00:20:09,460
ليمضي به العمر فيغدو زيامي، مؤدي فنّ النّو

245
00:20:10,390 --> 00:20:15,070
،لا يُدرك بعد أنّ خُطاه تقوده إلى عالمٍ يتمدّد في الأفق

246
00:20:15,070 --> 00:20:18,880
،مجاوزًا بتمدّده الأنهار والمحيطات

247
00:20:20,480 --> 00:20:23,370
بل والسّماء أيضًا