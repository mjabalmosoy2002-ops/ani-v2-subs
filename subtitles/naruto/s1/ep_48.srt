1
00:01:41,660 --> 00:01:43,830
!أنت، أيّها الفاشل

2
00:01:46,200 --> 00:01:48,340
.لديّ نصيحتان لك

3
00:01:49,570 --> 00:01:52,540
كفاك من ذلك التّشجيع المقزّر
.إن كنتَ شينوبي بالفعل

4
00:01:54,180 --> 00:01:55,380
...والنّصيحة الثّانية

5
00:01:56,680 --> 00:01:59,110
.سيبقى الفاشل فاشلاً دائمًا

6
00:01:59,850 --> 00:02:01,180
!لا يوجد ما قد يغيّر ذلك

7
00:02:04,750 --> 00:02:06,150
هل تريد أن تختبر ذلك؟

8
00:02:14,360 --> 00:02:15,130
!أنت

9
00:02:15,630 --> 00:02:18,300
.أدرك ما يدفعك لهذا يا ناروتو، صدّقني

10
00:02:19,130 --> 00:02:22,470
لكن على كلّ القتالات أن تجري
!ضمن نزالات رسميّة

11
00:02:24,010 --> 00:02:27,510
هزيمة الفاشل للعبقريّ الموهوب
...بواسطة الجهد فقط

12
00:02:28,440 --> 00:02:30,140
ألن يقدّم لنا ذلك معركة رئيسيّة حماسيّة؟

13
00:02:33,910 --> 00:02:35,580
.أنا أعدك

14
00:02:44,890 --> 00:02:46,460
!سأفوز مهما كلّف الأمر

15
00:02:56,780 --> 00:03:00,480
!!غارا يتحطّم
!شباب! قوّة! وانفجار

16
00:03:02,390 --> 00:03:03,790
!يا تشوجي

17
00:03:03,790 --> 00:03:05,460
.أنت في ورطة

18
00:03:05,460 --> 00:03:07,890
.لم يبق إلاّ الأقوياء

19
00:03:08,860 --> 00:03:12,730
على الأرجح أنّ أقوى نينجا
.الصّوت هو ذلك الشّخص

20
00:03:13,330 --> 00:03:16,970
كما أنّ لي يبدو قويًّا كفاية بما
!أنّه واجه ساسكي

21
00:03:17,300 --> 00:03:19,670
!هذا دون ذكر فتى الرّمل ذلك

22
00:03:20,140 --> 00:03:23,010
!على الأرجح أنّه الأخطر بينهم

23
00:03:29,050 --> 00:03:31,180
!لا-لا أهتمّ

24
00:03:31,180 --> 00:03:33,920
...أنوي الانسحاب إن حدث ذلك

25
00:03:33,920 --> 00:03:35,120
...هذا يعني

26
00:03:35,650 --> 00:03:38,520
أنّه ستضيّع عليك فرصة الأكل
.في مطعم المشويّات أيضًا

27
00:03:38,520 --> 00:03:40,890
!ماذا؟ مستحيل

28
00:03:42,290 --> 00:03:43,490
.لا تقلق

29
00:03:43,490 --> 00:03:44,930
،إن بدأت الأمور تسوء

30
00:03:44,930 --> 00:03:49,160
،سأتدخّل وأوقف القتال
كما حدث مع هيناتا، موافق؟

31
00:03:49,160 --> 00:03:50,900
،ثمّة أجود ما في ألسنة البقر
...والأضلاع الصّغيرة

32
00:03:50,900 --> 00:03:53,820
.يمكنك أكل ما تريد

33
00:03:50,900 --> 00:03:53,820
!لا تغره بالطّعام

34
00:03:53,820 --> 00:03:57,570
.كما أنّه لم يتدخّل لإيقاف قتال هيناتا

35
00:03:53,820 --> 00:03:57,570
.يمكنك أكل أيّ شيء وكلّ شيء تريد

36
00:03:59,840 --> 00:04:07,020
!مشويّات! المشويّات هي الأفضل
!سآكل حتّى الشّبع

37
00:04:10,720 --> 00:04:12,420
.لا يبدو بخير

38
00:04:13,690 --> 00:04:15,760
...مشاهدة القتال السّابق

39
00:04:16,190 --> 00:04:21,800
!هل بدأ شيطانه الدّاخليّ بالثّوران؟

40
00:04:23,030 --> 00:04:25,900
.يساورني الفضول أيضًا حيال نيجي ذاك

41
00:04:28,040 --> 00:04:29,670
.لديّ خطّة

42
00:04:31,710 --> 00:04:32,610
كانكورو؟

43
00:04:32,610 --> 00:04:35,650
.مهمّة جمع معلومات صغيرة فحسب

44
00:04:36,950 --> 00:04:37,680
!أنت

45
00:04:38,610 --> 00:04:41,150
ما الّذي تفعله هناك وحدك؟

46
00:04:41,150 --> 00:04:43,850
ألا يجدر بك أن تكون مع أصدقائك؟

47
00:04:43,850 --> 00:04:46,560
!إ-إنّ ذلك ليس من شأنك

48
00:04:49,190 --> 00:04:50,530
...فهمت

49
00:04:51,130 --> 00:04:54,170
اسمه هيوغا نيجي، صحيح؟

50
00:04:54,170 --> 00:04:58,740
يبدو أنّه لم يكشف عن كامل قوّته
.الحقيقيّة في ذلك النّزال الأخير

51
00:04:58,740 --> 00:05:00,200
ما قصّته؟

52
00:05:01,870 --> 00:05:04,310
!سوف أسحقه

53
00:05:05,940 --> 00:05:08,950
.كلاّ، ذلك ليس ما سألتك عنه

54
00:05:09,780 --> 00:05:12,920
...كما أنّ هذا الفتى ليس في مستواه أبدًا

55
00:05:13,820 --> 00:05:17,650
.تبدو فتى مرحًا. أنت تروق لي

56
00:05:17,650 --> 00:05:22,130
!وأنت تبدو مملاًّ. ولا تروق لي بالمرّة

57
00:05:23,960 --> 00:05:27,100
!سأضيّع وقتي مع هذا الأبله

58
00:05:29,530 --> 00:05:32,400
.والآن، سنواصل النّزالات

59
00:05:35,870 --> 00:05:37,210
!حسنًا

60
00:05:37,210 --> 00:05:41,340
.سيحين دورك تاليًا بكلّ تأكيد
!تجهّز جيّدًا يا لي

61
00:05:41,710 --> 00:05:42,750
!كلاّ

62
00:05:43,970 --> 00:05:49,290
،بما أنّني انتظرت كلّ هذا الوقت
!أفضّل أن أبقى حتّى النّهاية

63
00:05:51,090 --> 00:05:53,660
هل السّيّد لي مستاء؟

64
00:06:19,620 --> 00:06:22,520
...انزل بسرعة

65
00:06:25,320 --> 00:06:27,360
!نجوت

66
00:06:28,290 --> 00:06:29,490
!أبله

67
00:06:29,490 --> 00:06:31,290
!لا تخدعنا هكذا

68
00:06:34,630 --> 00:06:35,730
!سيّد لي

69
00:06:37,130 --> 00:06:39,200
!نجح الأمر

70
00:06:39,200 --> 00:06:42,250
،إن قلتُ أنّني أريد البقاء للنّهاية
.فلن يحدث ذلك

71
00:06:42,250 --> 00:06:44,470
إنّه تطبيق لنفس القانون

72
00:06:44,470 --> 00:06:47,140
الّذي يقول أنّه إن صوّبنا
،على عمود فلن نصيبه

73
00:06:47,140 --> 00:06:50,180
،لكن إن قصدنا ألاّ نصيبه
!فسنصيبه مباشرة

74
00:06:50,180 --> 00:06:53,180
!أجل! هذا هو تلميذي

75
00:06:53,180 --> 00:06:56,220
!لم أرد أن أكون آخر المقاتلين

76
00:06:56,220 --> 00:06:58,990
!لقد قمت بخداعهم

77
00:06:59,420 --> 00:07:01,160
خدعت من يا ترى؟

78
00:07:01,160 --> 00:07:05,390
.دعني أقدّم لك نصيحة صغيرة إذًا

79
00:07:05,390 --> 00:07:06,600
!حاضر

80
00:07:07,360 --> 00:07:10,630
...ربّما لم يلاحظ أيّ أحد بعد، ولكن

81
00:07:11,430 --> 00:07:14,550
!تلك الجرّة تبدو مثيرة للشّبهات

82
00:07:14,550 --> 00:07:16,110
!فهمت

83
00:07:16,110 --> 00:07:17,540
!كفّ عن أخذ الملاحظات

84
00:07:17,540 --> 00:07:21,810
لن يكون لديك وقت لقراءتها
!أثناء النّزال أيّها الغبيّ

85
00:07:21,810 --> 00:07:23,110
!فهمت

86
00:07:24,310 --> 00:07:26,480
ألم يدرك ذلك؟

87
00:07:27,120 --> 00:07:29,550
هل سيكون السّيّد لي بخير؟

88
00:07:29,550 --> 00:07:34,160
!حسنًا! انطلق يا لي

89
00:07:34,160 --> 00:07:36,160
!حاضر

90
00:07:44,500 --> 00:07:48,300
أنا جدّ سعيد لتمكّني من قتالك
.باكرًا هكذا في هذا النّزال

91
00:07:53,080 --> 00:07:56,880
لا أعرف أيّ نوع من الحركات يجيد
،صاحب التّسريحة الدّائريّة ذاك

92
00:07:56,880 --> 00:07:59,110
.لكنّه لن يهزم غارا أبدًا

93
00:07:59,520 --> 00:08:00,980
!مطلقًا

94
00:08:01,250 --> 00:08:05,960
،واضح جدًّا أنّه سريع
.لكنّ ركلاته ليست بتلك القوّة

95
00:08:06,720 --> 00:08:07,620
...كلاّ

96
00:08:19,200 --> 00:08:22,170
.إنّه... قويّ

97
00:08:26,710 --> 00:08:28,480
.لا تتعجّل هكذا لو سمحت

98
00:08:34,620 --> 00:08:35,880
...سيّد لي

99
00:08:38,860 --> 00:08:41,560
.كن حذرًا يا لي

100
00:08:46,400 --> 00:08:49,730
...والآن... النّزال التّاسع

101
00:08:52,170 --> 00:08:53,140
!سيبدأ الآن

102
00:08:57,240 --> 00:08:59,050
!إعصار ورق الشّجر

103
00:09:16,590 --> 00:09:17,830
أذلك...؟

104
00:09:17,830 --> 00:09:19,060
رمل؟

105
00:09:19,360 --> 00:09:21,030
...يا لها من تقنية غير عاديّة

106
00:09:21,030 --> 00:09:24,500
!هنالك رمل في تلك الجرّة

107
00:09:25,030 --> 00:09:26,040
...ذلك

108
00:09:30,270 --> 00:09:32,040
أهذا كلّ شيء؟

109
00:09:33,040 --> 00:09:35,180
!تابوت الصّحراء

110
00:09:44,750 --> 00:09:46,590
!جنازة الصّحراء

111
00:09:49,560 --> 00:09:52,660
...إنّها قصّة رعب كتلك ثانية

112
00:09:53,300 --> 00:09:56,010
تقنية تتلاعب بالرّمل إذًا؟

113
00:09:56,010 --> 00:09:57,630
.يبدو هذا خطيرًا

114
00:09:58,300 --> 00:10:00,440
!لكن لنجرّب حظّنا

115
00:10:28,060 --> 00:10:30,830
...رغم أنّ هجمات السّيّد لي سريعة

116
00:10:30,830 --> 00:10:32,700
!إلاّ أنّ لا تأثير لها عليه

117
00:10:32,700 --> 00:10:35,230
!ما قصّته يا ترى؟

118
00:10:35,230 --> 00:10:38,940
لن تؤثّر به أيّ هجمات جسديّة
.على الإطلاق

119
00:10:39,780 --> 00:10:42,140
يحيط الرّمل بغارا ويحميه

120
00:10:42,140 --> 00:10:45,450
.بإرادته الخاصّة، بغضّ النّظر عن نوايا غارا

121
00:10:46,280 --> 00:10:50,450
لهذا السّبب لم يتمكّن أيّ أحد
...من ذلك حتّى الآن

122
00:10:51,450 --> 00:10:55,390
.أقصد أن يلحق ضررًا بغارا

123
00:10:58,230 --> 00:11:02,530
...سُحقًا! إنّه لا يحرّك ساكنًا

124
00:11:03,170 --> 00:11:04,800
أهذا كلّ شيء؟

125
00:11:06,470 --> 00:11:09,610
...متّعني أكثر قليلاً

126
00:11:11,140 --> 00:11:12,910
!لم أنل كفايتي بعد

127
00:11:14,640 --> 00:11:15,540
!من الدّماء

128
00:11:30,690 --> 00:11:33,890
لماذا لا يستعمل السّيّد لي إلاّ التّايجتسو؟

129
00:11:33,890 --> 00:11:36,510
لن يتمكّن أبدًا من الاقتراب منه
!بما يكفي هكذا

130
00:11:36,510 --> 00:11:40,270
لماذا لا يتراجع قليلاً ويستعمل
النّينجتسو أو ما شابه؟

131
00:11:41,040 --> 00:11:42,970
.الأمر ليس وكأنّه لا يريد استعماله

132
00:11:43,370 --> 00:11:45,050
.بل إنّه لا يمكنه ذلك

133
00:11:46,060 --> 00:11:50,670
.لا يملك لي أيّ مهارات نينجتسو أو غينجتسو

134
00:11:50,670 --> 00:11:52,150
!مـ-مستحيل

135
00:11:53,180 --> 00:11:57,420
،عندما قابلتُ لي أوّل مرّة
.كان غير كفؤ بالمرّة

136
00:11:57,420 --> 00:11:59,660
.لم تكن لديه أيّ مواهب على الإطلاق

137
00:12:00,090 --> 00:12:02,890
!مستحيل! لا أصدّق هذا

138
00:12:30,720 --> 00:12:31,650
!مهلاً، مهلاً

139
00:12:42,500 --> 00:12:43,830
...وبكلّ تأكيد

140
00:12:43,830 --> 00:12:48,400
من النّادر وجود نينجا لا يمكنه
.استعمال النّينجتسو والغينجستو

141
00:12:49,440 --> 00:12:50,470
،لهذا السّبب

142
00:12:50,470 --> 00:12:56,950
الطّريق الوحيد الّذى لدى لي ليسلكه
.ليكون نينجا هو بالتّايجتسو

143
00:12:57,980 --> 00:13:00,920
!ولكن، ذلك بالضّبط ما يجعل منه فائزًا

144
00:13:02,230 --> 00:13:03,890
!لي، انزعها

145
00:13:05,120 --> 00:13:07,160
...لـ-لكن يا غاي سينسي

146
00:13:07,160 --> 00:13:11,360
أخبرتني أن أقوم بذلك فقط لحماية مجموعة
!كبيرة من الأشخاص الأعزّاء عليّ

147
00:13:11,590 --> 00:13:13,400
!لا بأس بذلك

148
00:13:13,400 --> 00:13:14,830
!أنا أمنحك الإذن

149
00:13:24,340 --> 00:13:25,810
هل تلك...؟

150
00:13:25,810 --> 00:13:27,080
أثقال؟

151
00:13:27,610 --> 00:13:29,550
...يا له من تدريب مبتذل

152
00:13:29,550 --> 00:13:31,050
!فهمت

153
00:13:31,050 --> 00:13:32,280
!هذا سخيف

154
00:13:34,320 --> 00:13:37,720
!أجل، بإمكاني الآن التّحرّك بسهولة أكثر

155
00:13:39,190 --> 00:13:41,890
هل يعتقد أنّ إزالة بعض الأثقال الصّغيرة

156
00:13:41,890 --> 00:13:44,130
ستمكّنه من التّفوّق على مناورات رمل غارا...؟

157
00:13:50,570 --> 00:13:52,800
.هذا مبالغ فيه يا غاي

158
00:13:54,970 --> 00:13:57,040
!انطلق يا لي

159
00:13:57,040 --> 00:13:58,140
!حاضر

160
00:14:13,160 --> 00:14:14,090
!خذ

161
00:14:15,320 --> 00:14:16,290
!كان وشيكًا

162
00:14:16,290 --> 00:14:17,530
!إنّه سريع

163
00:14:17,820 --> 00:14:18,760
!...مذهل

164
00:14:25,270 --> 00:14:28,440
إنّه غير قادر على استعمال
...النّينجتسو أو الغينجتسو

165
00:14:28,820 --> 00:14:35,140
،وبالتّالي، كرّس كلّ وقته
...وكلّ طاقته

166
00:14:35,140 --> 00:14:38,180
.وكلّ كيانه للتاجتسو

167
00:14:39,150 --> 00:14:42,150
...رغم عدم مقدرته على تنفيذ أيّ تقنية

168
00:14:42,650 --> 00:14:45,120
...فلن يخسر أمام أيّ أحد

169
00:14:45,120 --> 00:14:47,620
!إنّه متخصّص في التّايجتسو

170
00:15:00,540 --> 00:15:04,110
!لا أصدّق عينيّ! لقد أصيب غارا

171
00:15:04,770 --> 00:15:06,180
!مستحيل

172
00:15:06,180 --> 00:15:10,150
!كثيف الحواجب أسرع بكثير عن ذي قبل

173
00:15:10,780 --> 00:15:13,650
!هل كان بهذه القوّة دائمًا؟

174
00:15:13,650 --> 00:15:19,350
!الشّباب... انفجار

175
00:15:19,350 --> 00:15:20,690
!أجل

176
00:15:29,270 --> 00:15:30,430
!أنا هنا

177
00:15:34,770 --> 00:15:35,740
!جيّد

178
00:15:37,040 --> 00:15:38,710
!نلت منه

179
00:15:39,280 --> 00:15:42,060
!مـ-مذهل، إنّه سريع

180
00:15:42,060 --> 00:15:44,580
!درع الرّمل لا يمكنه مجاراته

181
00:15:44,810 --> 00:15:46,180
!إصابة مباشرة

182
00:15:46,180 --> 00:15:48,380
.مـ-مذهل

183
00:15:48,380 --> 00:15:50,620
!ضرباته أسرع من البرق

184
00:15:50,620 --> 00:15:53,160
!لا يمكنني حتّى تتبّعها بعينيّ

185
00:16:04,570 --> 00:16:05,570
...يا للورطة

186
00:16:05,800 --> 00:16:07,500
!نعم، أنتم في ورطة

187
00:16:07,500 --> 00:16:11,710
صاحب العينين ذاتا الهالات السّوداء
!يتعرّض لضرب مبرّح

188
00:16:11,710 --> 00:16:13,810
.تلك ليست الورطة الّتي قصدتها

189
00:16:31,630 --> 00:16:33,300
!ما-ماذا؟

190
00:16:33,300 --> 00:16:36,030
!إنّ وجهه يتفتّت

191
00:16:36,570 --> 00:16:38,500
...جسمه بالكامل مغطّى بالرّمل

192
00:16:38,500 --> 00:16:40,240
!ليس عليه خدش واحد

193
00:16:40,640 --> 00:16:42,700
!ما-ما قصّته؟

194
00:16:47,440 --> 00:16:50,150
.لقد كان مغطّى بالرّمل بكلّ تأكيد

195
00:16:50,680 --> 00:16:55,750
لكن، مرّ وقت طويل جدًّا مذ
.رأيت ذلك التّعبير على وجه غارا

196
00:16:56,950 --> 00:17:00,020
شعرتُ أنّه بدأ يصبح
غير مستقرّ شيئًا فشيئًا

197
00:17:00,020 --> 00:17:02,890
...كلّما تقدّمنا في اختبارات التشونين

198
00:17:04,860 --> 00:17:08,560
هل استيقظ كيان غارا الآن ؟

199
00:17:12,740 --> 00:17:15,340
مهلاً! ما ذلك؟

200
00:17:15,340 --> 00:17:19,110
هل حماه ذلك من ضربات
كثيف الحواجب؟

201
00:17:19,110 --> 00:17:22,280
.نعم... ذلك غطاء الرّمل المدرّع

202
00:17:22,280 --> 00:17:23,250
غطاء مدرّع؟

203
00:17:23,650 --> 00:17:27,120
في العادة، يعمل درع الرّمل
،على حمايته بشكل تلقائيّ

204
00:17:27,120 --> 00:17:29,920
لكن إن تمّ اختراق الدّرع
،في أيّ حال من الأحوال

205
00:17:29,920 --> 00:17:33,060
يعمل الغطاء المدرّع كطبقة
...ثانية تحمي من الضّربات

206
00:17:33,060 --> 00:17:36,230
!ذلك هو دفاع غارا المطلق

207
00:17:36,230 --> 00:17:39,490
!من المستحيل إذًا النّيل منه هكذا

208
00:17:39,490 --> 00:17:41,630
.ليست لديه نقاط ضعف حتّى

209
00:17:42,100 --> 00:17:44,830
...كلاّ. ذلك ليس صحيحًا بالكامل

210
00:17:45,470 --> 00:17:48,870
.غطاء الرّمل المدرّع مليء بنقاط الضّعف

211
00:17:49,610 --> 00:17:53,320
أوّلاً، إنّه لا يعمل بشكل تلقائيّ
.ويستنزف الكثير من التشاكرا

212
00:17:53,320 --> 00:17:55,640
،كما أنّه أقلّ فعاليّة من درع الرّمل

213
00:17:55,640 --> 00:18:00,180
كما يتطلّب الكثير من الطّاقة الجسديّة
.لإبقاء الرّمل متشبّثًا بالجسم هكذا

214
00:18:01,150 --> 00:18:07,160
يدلّ اضطرار غارا لاستعمال
.الغطاء المدرّع أنّه تحت الضّغط

215
00:18:07,860 --> 00:18:11,160
...لي ذاك بارع حقًّا

216
00:18:12,260 --> 00:18:14,630
.لكن حُدّدت نتيجة النّزال سلفًا

217
00:18:15,530 --> 00:18:18,600
!لن يهزم غارا أبدًا

218
00:18:19,670 --> 00:18:21,070
أهذا كلّ شيء؟

219
00:18:22,470 --> 00:18:24,340
...يا لدفاعه المذهل

220
00:18:24,820 --> 00:18:28,810
حتّى سرعتي لن تمكّنني
.من تسديد ضربة مباشرة له

221
00:18:29,510 --> 00:18:34,780
عليّ أن ألحق ضررًا كبيرًا
.من أعلى جرّة الرّمل

222
00:18:36,180 --> 00:18:37,250
!حان وقت اللّوتس

223
00:18:41,490 --> 00:18:42,190
.نعم

224
00:18:56,410 --> 00:18:57,410
!استعدّ

225
00:19:03,080 --> 00:19:06,380
ستكون جرّة هشّة كتلك بلا أيّة فائدة

226
00:19:06,380 --> 00:19:10,350
في مواجهة تأثير سرعة لوتس
.لي العالية من الأعلى

227
00:19:11,850 --> 00:19:13,590
!قم بحركتك بسرعة

228
00:19:14,010 --> 00:19:15,560
!سل وستنال

229
00:19:19,330 --> 00:19:20,560
.لم يرتفع كفاية

230
00:19:20,800 --> 00:19:22,260
!ليس بعد

231
00:19:29,740 --> 00:19:31,810
!يا لها من سلسلة ركلات مذهلة

232
00:19:34,010 --> 00:19:37,980
حتّى اللّوتس العاديّة تسبّب
!إجهادًا كبيرًا للجسد

233
00:19:38,380 --> 00:19:40,450
!لتكن هذه ضربتك القاضية يا لي

234
00:19:54,060 --> 00:19:56,530
!خذ هذه

235
00:19:58,100 --> 00:19:59,840
!اللّوتس الأولى

236
00:20:26,900 --> 00:20:28,060
...نلت منه

237
00:20:28,760 --> 00:20:29,970
!جيّدًا

238
00:20:31,030 --> 00:20:33,000
!أحسنت

239
00:20:33,300 --> 00:20:35,340
!ا-انتهى النّزال

240
00:20:35,340 --> 00:20:37,470
!ما-ماذا؟ غير ممكن

241
00:20:37,470 --> 00:20:40,440
!أحسنت! فاز السّيّد لي

242
00:20:40,740 --> 00:20:43,910
مهلاً، لم يمت، صحيح؟

243
00:21:11,140 --> 00:21:12,370
!ماذا؟

244
00:21:16,040 --> 00:21:20,670
هل تسمعني؟

245
00:21:20,670 --> 00:21:28,800
السماء الزرقاء الصافية ليس لأفقها حدودُ

246
00:21:29,970 --> 00:21:38,730
والبحرُ واسعٌ على مد البصر كبيرُ

247
00:21:39,060 --> 00:21:53,580
من فضلك، أبقِ هذه البسمة على محيّاك، وإلّا بكيتُ

248
00:21:53,700 --> 00:21:57,670
لستَ بعوزٍ إلى البحث من حولكْ

249
00:21:57,670 --> 00:22:10,510
فالجميع في هاتين اليدين متواجدْ

250
00:22:10,510 --> 00:22:15,520
،حتى وإن أردتَّ الهروب، حتى وإن أردتَّ البكاء

251
00:22:15,680 --> 00:22:23,980
.حتى وإن نسيتَ سعادتك، فما عليك سوى بالغناء

252
00:22:24,230 --> 00:22:31,660
وُلد النور، ثم وُلد الظلام، فاجتمعا واندمجا

253
00:22:31,700 --> 00:22:38,120
فبالأُلفة والتخاطر أحسسنا

254
00:22:38,500 --> 00:22:43,590
هل بتّ تسمعني؟

255
00:22:47,830 --> 00:22:50,100
مهلاً، مهلاً، ماذا يحدث
يا كثيف الحواجب؟

256
00:22:50,230 --> 00:22:52,430
!يبدو أنّ كلّ قوّتك قد اختفت

257
00:22:52,600 --> 00:22:55,270
!سوف تُهزم على هذا المعدّل

258
00:22:55,670 --> 00:22:59,570
لـ... لماذا يبتسم كثيف الحواجب؟

259
00:23:00,140 --> 00:23:01,770
كيف بإمكانه الوقوف استعدادًا للقتال

260
00:23:01,840 --> 00:23:03,710
!بعد أن تكبّد هزيمة كهذه؟

261
00:23:04,480 --> 00:23:09,740
الحلقة القادمة

262
00:23:04,510 --> 00:23:09,240
!في الحلقة القادمة: اشتعال المعركة
وانكشاف التقنية المحرمة السرية

263
00:23:10,020 --> 00:23:12,850
!تغيّرت النّظرة في عينيْ كثيف الحواجب