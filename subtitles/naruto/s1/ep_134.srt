1
00:01:43,260 --> 00:01:48,300
نهاية الدُّموع

2
00:02:03,470 --> 00:02:05,130
...بالتميُّز

3
00:02:06,170 --> 00:02:10,470
!بالتميُّز، هل قصدتَ ذلك؟

4
00:02:15,470 --> 00:02:17,470
لا أشعر بأنَّني سأخسر

5
00:03:51,130 --> 00:03:53,920
...ساسكي... أنت

6
00:04:04,840 --> 00:04:07,590
إذا استمرَّتْ في التحرُّر لفترةٍ طويلة

7
00:04:07,670 --> 00:04:10,590
فإنّ علامات اللَّعنة ستظلُّ تأكل جسدك

8
00:04:10,670 --> 00:04:13,220
...وعندما تأكلك بشكلٍ كامل

9
00:04:13,300 --> 00:04:17,170
ستخسر نفسك... للأبد

10
00:04:20,840 --> 00:04:22,340
...هذا الجسد

11
00:04:23,220 --> 00:04:26,220
يجب عليّ استغلال الوقت

12
00:04:35,420 --> 00:04:38,590
...لم أعد أشعر بذراعي اليُسرى

13
00:04:41,840 --> 00:04:43,920
...هذه القوّة التي تمتلكُها

14
00:04:45,920 --> 00:04:49,550
يبدو أنّها مصحوبة بمخاطر أيضاً، صحيح؟

15
00:04:53,670 --> 00:04:55,050
هل تعلم؟

16
00:05:01,260 --> 00:05:02,510
...أنَّ هذا المكان

17
00:05:03,130 --> 00:05:05,800
يُدعى بالوادي الأخير

18
00:05:08,380 --> 00:05:14,380
أظنُّه المسرح المثالي، ألا تعتقِد ذلك يا ناروتو؟

19
00:05:24,130 --> 00:05:25,840
تذكّرت

20
00:05:27,050 --> 00:05:29,970
قلتُ أنَّه لا مزيد من الكلام، أليس كذلك؟

21
00:05:31,300 --> 00:05:34,300
في هذه الحالة فما رأيك أن نحسم المسألة؟

22
00:05:34,670 --> 00:05:36,590
أن نحسم هذه المعركة

23
00:05:38,010 --> 00:05:40,130
!وكلّ معاركنا حتّى اللَّحظة

24
00:05:40,970 --> 00:05:44,630
!التالي في الفريق 7. أوزوماكي ناروتو

25
00:05:45,800 --> 00:05:47,090
!هارونو ساكورا

26
00:05:48,630 --> 00:05:50,050
!مرحى

27
00:05:50,130 --> 00:05:52,010
مع ناروتو...؟

28
00:05:52,420 --> 00:05:54,340
وساسكي أوتشيها

29
00:05:54,420 --> 00:05:55,920
!مرحى

30
00:05:56,220 --> 00:05:58,050
مع ساسكي...؟

31
00:05:58,880 --> 00:06:02,170
حاول ألّا تعرقلني أيُّها الفاشل

32
00:06:02,510 --> 00:06:04,510
!...أنت

33
00:06:04,590 --> 00:06:08,550
...لكن... لكن... لكن... قلتَ لنا

34
00:06:08,630 --> 00:06:10,130
...لهذا السّبب هما

35
00:06:10,590 --> 00:06:13,220
ألسنا فرقة مؤلَّفة من ثلاثة أشخاص؟

36
00:06:14,340 --> 00:06:18,050
!هذا صحيح! نحن الثّلاثة واحد

37
00:06:18,340 --> 00:06:19,300
!أنت

38
00:06:21,050 --> 00:06:25,340
هل تأذّيت... أيُّها الجبان؟

39
00:06:27,470 --> 00:06:34,010
هل تأذّيت؟ أيُّها الجبان؟

40
00:06:35,300 --> 00:06:38,010
أنت أحد الذين أريد مقاتلتهم

41
00:06:40,380 --> 00:06:41,840
!ساسكي

42
00:06:43,010 --> 00:06:47,420
أريد... أن أقاتلك أيضاً

43
00:06:48,260 --> 00:06:55,420
لا أريد رؤية المزيد من رفاقي الأعزّاء يموتون

44
00:06:55,880 --> 00:06:57,380
!تقنيّة الاستدعاء

45
00:07:03,130 --> 00:07:07,420
!سوف... أحمي ساكورا

46
00:07:07,920 --> 00:07:09,380
ما الذي يضحكك؟

47
00:07:09,470 --> 00:07:12,670
!لا شيء يضحكني! أنا سعيد

48
00:07:13,550 --> 00:07:17,340
!لأنّني شعرتُ أنني أستطيع هزيمتك هنا أخيراً

49
00:07:17,630 --> 00:07:21,170
!ماذا قلت؟! لا تتفوَّه بهراء أيُّها الفاشل

50
00:07:21,720 --> 00:07:25,010
!لن أبقى فاشلاً للأبد

51
00:07:25,300 --> 00:07:26,920
!تعال إليّ في الحال

52
00:07:27,010 --> 00:07:30,170
!ضع عصبةَ رأسك قبل ذلك! سأنتظرك

53
00:07:30,260 --> 00:07:32,380
...لستُ بحاجةٍ لشيء كهذا

54
00:07:32,670 --> 00:07:34,050
!افعلْ ذلك فحسب

55
00:07:36,300 --> 00:07:41,800
!لن تتمكّن حتّى من ترك جرح واحد على جبيني

56
00:07:41,880 --> 00:07:43,090
!أنت مخطئ

57
00:07:43,170 --> 00:07:45,300
ما أقصده هو أنَّ هذا برهان

58
00:07:45,380 --> 00:07:47,840
!على القتالِ ندّاً لندّ كشينوبي الورق

59
00:07:48,260 --> 00:07:49,510
!ناروتو

60
00:07:50,130 --> 00:07:51,720
!ساسكي

61
00:07:51,800 --> 00:07:53,670
!سأربح مهما كلّفَ الأمر

62
00:07:53,760 --> 00:07:55,840
!لا تصدِّق نفسك

63
00:07:56,340 --> 00:07:58,590
!توقَّفا

64
00:08:02,550 --> 00:08:04,760
...ومنذ هذه اللّحظة

65
00:08:16,880 --> 00:08:18,670
!تشيدوري

66
00:08:29,550 --> 00:08:31,130
!راسينغان

67
00:08:59,420 --> 00:09:01,090
!راسينغان -
!تشيدوري -

68
00:09:23,590 --> 00:09:25,380
!راسينغان -
!تشيدوري -

69
00:09:54,550 --> 00:09:56,010
...هذه التشاكرا

70
00:09:57,380 --> 00:09:58,470
!هذا سيّئ

71
00:13:16,720 --> 00:13:18,220
...ناروتو

72
00:13:30,920 --> 00:13:32,300
...أنا

73
00:14:36,340 --> 00:14:39,340
بدأتْ تُمطِر! هل سيزيل هذا الرّائحة؟

74
00:14:40,170 --> 00:14:41,340
لا مشكلة

75
00:14:41,970 --> 00:14:43,840
لقد اقتربنا. من هنا

76
00:14:56,420 --> 00:14:57,880
هل تأخّرتُ كثيراً؟

77
00:15:06,300 --> 00:15:07,880
!ناروتو

78
00:15:12,670 --> 00:15:14,880
!لماذا آلت الأمور إلى هذا؟

79
00:15:25,470 --> 00:15:27,130
...هذه لساسكي

80
00:16:05,670 --> 00:16:10,340
لم أصل في الوقت... سامحني رجاء

81
00:16:16,590 --> 00:16:17,800
...ناروتو

82
00:16:19,470 --> 00:16:21,220
...أعرف طبيعتك

83
00:16:22,220 --> 00:16:23,880
لا بدَّ وأنّك بذلت جهوداً مستميتة

84
00:16:30,510 --> 00:16:31,970
...ساسكي

85
00:16:55,510 --> 00:16:57,970
هذا ابني ساسكي الذي عهدتُه

86
00:17:10,840 --> 00:17:14,880
...يحدّثني أبوك عنك دوماً

87
00:17:15,260 --> 00:17:17,550
أنت أخي الوحيد

88
00:17:18,220 --> 00:17:20,340
سأبقى جانبك دوماً

89
00:17:20,420 --> 00:17:23,170
جِدار يجب عليك أن تتجاوزه

90
00:17:24,760 --> 00:17:26,630
حتّى ولو كرهتَني

91
00:17:29,550 --> 00:17:30,880
أنت شخص

92
00:17:30,970 --> 00:17:34,470
يمكنه اكتساب مانغيكيو شارينغان مثلي

93
00:17:37,630 --> 00:17:40,300
لكن بشرطٍ واحد

94
00:17:46,380 --> 00:17:48,920
...صديقك الأعزّ

95
00:18:01,380 --> 00:18:02,880
...الوادي الأخير

96
00:18:03,470 --> 00:18:06,670
لا أصدِّق أن يتقاتل ساسكي وناروتو هنا

97
00:18:10,470 --> 00:18:12,420
يا لسخرية القدر

98
00:18:15,130 --> 00:18:16,170
أجل

99
00:18:19,300 --> 00:18:21,090
كلّما نظرتُ إلى تيّار النّهر هذا

100
00:18:21,840 --> 00:18:28,380
أشعر وكأنّني أشهد معركةً أبديّة لا تنتهي

101
00:18:32,550 --> 00:18:34,800
تماماً مثل قدر صاحبَي التّمثالَين
المنحوتَين هنا

102
00:18:34,880 --> 00:18:38,050
اللّذان أسّسا قرية الورق المخفيّة

103
00:18:42,760 --> 00:18:49,380
...ناروتو وساسكي، ما دمتما على قيدِ الحياة

104
00:19:08,050 --> 00:19:10,670
...يجب عليك أن تقتل

105
00:19:13,130 --> 00:19:15,170
!صديقك الأعزّ

106
00:19:29,920 --> 00:19:31,420
...لن أتقيّد

107
00:19:32,760 --> 00:19:35,420
!بكلّ ما تقوله

108
00:19:42,970 --> 00:19:46,590
!سأحصل على القوّةِ بطريقتي الخاصّة

109
00:19:47,840 --> 00:19:51,760
!سأتفوّق عليك بطريقتي الخاصّة

110
00:19:52,840 --> 00:19:54,380
!بلا فشل

111
00:20:08,340 --> 00:20:11,510
المطر... قد توقّفت، أليس كذلك؟

112
00:20:12,720 --> 00:20:13,840
أجل

113
00:20:29,800 --> 00:20:31,550
بهذه الأمطار الغزيرة

114
00:20:31,630 --> 00:20:33,800
لن أتمكّن من تتبُّع الرّائحة بعد الآن

115
00:20:35,050 --> 00:20:38,220
ناروتو أهمّ الآن من اللّحاقِ بساسكي

116
00:20:40,050 --> 00:20:41,220
أجل

117
00:21:05,760 --> 00:21:08,760
أصبح الأمر مثيراً، أليس كذلك؟

118
00:21:10,340 --> 00:21:11,340
نعم

119
00:22:49,550 --> 00:22:54,170
أنا آسف. أنا آسف حقّاً يا ساكورا

120
00:22:54,840 --> 00:23:00,170
قطعتُ وعدَ العمر بأنّني سأعيد ساسكي

121
00:23:01,340 --> 00:23:04,090
!لم أنتهِ بعد

122
00:23:04,170 --> 00:23:06,220
!سأفي بوعدي مهما حدث

123
00:23:06,300 --> 00:23:08,340
...بما أنّني اعتدتُ دوماً أن أقول

124
00:23:08,420 --> 00:23:10,090
أنّني لا أتراجع عن كلمتي أبداً

125
00:23:10,170 --> 00:23:13,260
!هذا هو طريقي في النّينجا

126
00:23:13,840 --> 00:23:16,340
:الحلقة القادمة
‟الوعد الذي لم يُوفَ”