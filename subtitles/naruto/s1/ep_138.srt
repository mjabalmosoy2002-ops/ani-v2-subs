1
00:01:44,080 --> 00:01:48,950
خيانة بحتة
!واِلتماس عابر

2
00:01:57,030 --> 00:01:59,330
!تقنيّة الاستدعاء

3
00:02:03,740 --> 00:02:05,200
!ناروتو! تمسّك

4
00:02:08,200 --> 00:02:09,530
!حسناً، اسحبه

5
00:02:10,950 --> 00:02:11,910
!هناك؟

6
00:02:15,830 --> 00:02:17,660
!تبّاً! هل كانت نسخة؟

7
00:02:18,370 --> 00:02:19,620
!هنا

8
00:02:20,410 --> 00:02:22,160
!ها هو الهجوم المضاد

9
00:02:27,330 --> 00:02:29,620
!راسينغان، انطلاق

10
00:02:30,030 --> 00:02:30,870
!ماذا؟

11
00:02:31,080 --> 00:02:32,580
أيُّها الوغد

12
00:02:42,080 --> 00:02:42,950
!مرحى

13
00:02:43,080 --> 00:02:46,200
!احذر يا ناروتو! هناك آخران يختبئان

14
00:02:48,240 --> 00:02:50,030
!ها هما

15
00:02:50,740 --> 00:02:51,910
!كاغيرو

16
00:02:51,990 --> 00:02:53,490
!لننسحب حاليّاً

17
00:02:54,870 --> 00:02:55,740
!انتظروا

18
00:02:59,330 --> 00:03:02,280
!إ-إنّهم سريعون جدّاً في الهرب

19
00:03:13,120 --> 00:03:16,080
!ناروتو، لماذا أنت شارد؟

20
00:03:17,410 --> 00:03:18,780
أين ساكورا؟

21
00:03:18,870 --> 00:03:20,370
!يا للهول

22
00:03:21,870 --> 00:03:22,950
!ساكورا

23
00:03:25,950 --> 00:03:27,620
...ناروتو

24
00:03:28,080 --> 00:03:31,370
هذا مُطمئن! أنت بخير يا ساسامي

25
00:03:32,700 --> 00:03:35,200
أجل... ساسامي بخير

26
00:03:35,530 --> 00:03:36,700
ساسامي بخير تماماً

27
00:03:38,120 --> 00:03:40,120
لماذا أنتِ غاضبة؟

28
00:03:48,120 --> 00:03:49,780
لنأخذ استراحة هنا

29
00:03:52,580 --> 00:03:55,580
ساكورا... من الفتاة الظريفة؟

30
00:03:55,870 --> 00:03:57,530
...حسناً! هذه المسافة كافية

31
00:03:57,870 --> 00:03:59,910
ما الخطب... يا ساكورا؟

32
00:04:00,450 --> 00:04:02,780
!حسناً، لا تقترِب أكثر

33
00:04:04,580 --> 00:04:09,450
!ما-ماذا؟! لستُ مهتمّاً سوى بالنساء البالغات

34
00:04:09,530 --> 00:04:11,080
!...يجب ألّا تسيئي الفهم

35
00:04:11,160 --> 00:04:12,200
!لا تسيئي الفهم

36
00:04:13,330 --> 00:04:14,620
هذا ليس سوء فهم

37
00:04:14,700 --> 00:04:18,990
يبدو أنّ ساكورا فهِمَتْ أخيراً الطبيعةَ الحقيقيّةَ
للناسك المنحرف

38
00:04:19,370 --> 00:04:21,910
!"قلتُ لك كفّ عن نعتي بـ"الناسك المنحرف

39
00:04:21,990 --> 00:04:23,780
!إذاً أنت الناسك الداعر

40
00:04:24,160 --> 00:04:28,280
!كفّا عن هذا! ساسامي خائفة

41
00:04:28,580 --> 00:04:29,410
حسناً -
حسناً -

42
00:04:30,410 --> 00:04:31,910
تبّاً

43
00:04:32,910 --> 00:04:34,410
اسم هذه الفتاة هو ساسامي

44
00:04:34,740 --> 00:04:36,280
إنّها نينجا من بلد حقل الأرزّ

45
00:04:36,830 --> 00:04:38,410
فرد من أفراد عشيرةِ فوما

46
00:04:38,490 --> 00:04:41,200
اختُطِف ابن عمّها بواسطةِ أوروتشيمارو

47
00:04:41,280 --> 00:04:43,080
وكانت تبحث عن مخبئه

48
00:04:43,160 --> 00:04:46,660
نعم. والنينجا للتو كانوا يستهدفون ساسامي

49
00:04:46,740 --> 00:04:49,160
!لحمايةِ سرّ المخبأ

50
00:04:49,410 --> 00:04:52,410
ماذا؟ من عشيرةِ فوما؟

51
00:04:52,490 --> 00:04:54,030
ماذا؟! أتعلم؟

52
00:04:54,580 --> 00:04:59,660
تواصلتُ مع النينجا في البلدة الذين غادروا
عشيرةَ فوما

53
00:05:00,240 --> 00:05:05,160
ماذا؟! إذاً كنتَ تؤدّي بعض التحرّيات بجدّية
!أيُّها الناسك المنحرف؟

54
00:05:05,240 --> 00:05:07,280
!لـ-لا أصدِّق ذلك

55
00:05:07,660 --> 00:05:10,330
في الواقع، عندما ذهبتُ إلى تلك الحانة

56
00:05:10,410 --> 00:05:13,660
تبيّن أنّها مخبأهم

57
00:05:13,740 --> 00:05:17,240
ماذا؟! إذاً في نهايةِ المطاف كنتَ تتسكّع
مع بعض الفتيات، صحيح؟

58
00:05:17,330 --> 00:05:20,490
يجب ألّا تتكلَّم بطريقةٍ تؤدّي إلى سوء فهم

59
00:05:20,910 --> 00:05:23,160
...حتَّى ساكورا التي تحترمني سوف

60
00:05:23,240 --> 00:05:26,120
!فقدتَ احترامي لك منذ مدّة طويلة

61
00:05:26,410 --> 00:05:29,080
...هكذا إذاً

62
00:05:29,910 --> 00:05:31,490
أفراد من عشيرةِ فوما؟

63
00:05:32,080 --> 00:05:35,950
أجل. كان الزعيم يُدعى هانزاكي أو ما شابه

64
00:05:36,030 --> 00:05:39,330
هانزاكي والآخرون خونة تخلّوا عن العشيرة

65
00:05:41,160 --> 00:05:43,620
هل فعل أولئك النّاس شيئاً؟

66
00:05:44,410 --> 00:05:47,410
كانوا يستهدفون مالي لذلك لقّنتُهم درساً

67
00:05:47,490 --> 00:05:50,620
وفي نفسِ الوقت سألتُهم عن مخبأ أوروتشيمارو

68
00:05:51,160 --> 00:05:53,080
لكنّهم لا يعرفون شيئاً

69
00:05:55,120 --> 00:05:59,740
يمكنني أن أدلّكم إلى مخبأ أوروتشيمارو

70
00:06:00,280 --> 00:06:01,580
!حقّاً؟

71
00:06:01,660 --> 00:06:02,490
...أجل

72
00:06:02,660 --> 00:06:04,080
!مرحى

73
00:06:14,910 --> 00:06:17,950
لم يُشفَ جرحكِ بعد. لا تضغطي على نفسكِ

74
00:06:18,030 --> 00:06:19,990
...أجل... لكن

75
00:06:22,990 --> 00:06:25,490
هذا هو المدخل إلى قرية الصّوت المخفيّة

76
00:06:26,030 --> 00:06:28,530
مخبأ أوروتشيمارو في أعماق تلك الجبال

77
00:06:34,870 --> 00:06:39,120
واثقة أنَّ ساسكي في مكانٍ ما في هذه الجبال

78
00:06:39,490 --> 00:06:42,370
!حسناً، أخيراً

79
00:06:42,450 --> 00:06:43,990
!لنسرع

80
00:06:44,080 --> 00:06:45,160
...انتظر

81
00:06:47,870 --> 00:06:48,740
!لماذا؟

82
00:06:49,080 --> 00:06:53,490
إن لم نسرع فسيخيّم اللّيل قبل أن نصل
...إلى مخبأ أوروتشيمارو

83
00:06:53,830 --> 00:06:54,870
!هذا صحيح

84
00:06:54,950 --> 00:06:58,450
!ساسكي على مقربةٍ من هنا أيُّها الناسك المنحرف

85
00:06:58,780 --> 00:07:01,370
إذا أردنا إنقاذه فيجدر بنا أن نسرع قدر المُستطاع

86
00:07:01,700 --> 00:07:03,410
!لمَ علينا الانتظار؟

87
00:07:05,490 --> 00:07:07,660
ماذا؟

88
00:07:07,740 --> 00:07:08,700
...في الواقع

89
00:07:10,160 --> 00:07:13,370
أنا جائع كما ترون

90
00:07:13,740 --> 00:07:16,660
...مهلاً... يجب على كافّة الشينوبي

91
00:07:16,740 --> 00:07:18,990
!لا أستطيع أن أقاتل وأنا جائع

92
00:07:19,450 --> 00:07:22,080
المنطِقة أمامنا مليئة بالأعداء

93
00:07:22,490 --> 00:07:25,910
لن نحظى بوقتٍ هادئ لتناول الطعام

94
00:07:27,740 --> 00:07:30,280
!حسناً! كلوا أيضاً، كلوا

95
00:07:36,100 --> 00:07:37,870
...هذا لذيذ

96
00:07:38,160 --> 00:07:41,370
حضّرتَ هذا خصِّيصاً لنا؟

97
00:07:41,450 --> 00:07:47,490
لا. يبدو أنّ الفتاة الأجمل في الحانة
وقعَتْ في سحري

98
00:07:49,830 --> 00:07:53,620
أعدَّتْ هذا بحبّ واهتمام

99
00:07:55,780 --> 00:07:57,780
سأذهب لإعدادِ الشّاي

100
00:07:58,280 --> 00:08:00,120
...شكراً

101
00:08:20,870 --> 00:08:22,870
مذاقه لذيذ جدّاً

102
00:08:25,870 --> 00:08:27,660
الشّاي جاهز

103
00:08:30,830 --> 00:08:31,660
تفضّل

104
00:08:33,410 --> 00:08:34,240
تفضّل

105
00:08:34,330 --> 00:08:35,330
شكراً

106
00:08:36,030 --> 00:08:36,870
تفضّلي

107
00:08:37,080 --> 00:08:38,780
شكراً لكِ يا ساسامي

108
00:08:40,870 --> 00:08:44,410
ساسامي، ينبغي أن تشاركينا الطعام أيضاً

109
00:08:44,740 --> 00:08:45,580
حسناً

110
00:09:10,740 --> 00:09:12,830
!الناسك المنحرف... ما الأمر...؟

111
00:09:14,280 --> 00:09:15,160
!ناروتو

112
00:09:50,410 --> 00:09:52,990
...فعلتها ساسامي

113
00:09:53,660 --> 00:09:55,780
بما أنّ الأمور وصلَتْ إلى هنا فقد وقعوا في قبضتِنا

114
00:09:59,330 --> 00:10:00,910
لم يُشفَ جرحك بعد

115
00:10:01,240 --> 00:10:03,740
كاغيرو، عليك الانتظار هنا

116
00:10:03,990 --> 00:10:07,780
لا شكّ... إنّهم نينجا الورق

117
00:10:08,870 --> 00:10:11,700
إذا تولّينا أمر مُطاردي الورق

118
00:10:11,780 --> 00:10:16,330
فسوف يعترف أوروتشيمارو-ساما بقوّةِ عشيرة فوما

119
00:10:17,370 --> 00:10:18,280
أجل

120
00:10:19,120 --> 00:10:21,660
لنعد إليه حاملين أنباء سارّة

121
00:10:21,910 --> 00:10:24,280
!وبرؤوسِ نينجا الورق كهدايا تذكارية

122
00:11:15,330 --> 00:11:16,530
!وجدتُه أخيراً

123
00:11:26,330 --> 00:11:28,870
ظننتُه شخصاً من قريةِ الورق المخفيّة
في بادئ الأمر

124
00:11:29,490 --> 00:11:31,740
لكن تبيّن بأنّها ساسامي

125
00:11:32,990 --> 00:11:35,450
...كاميكيري، جيغومو، كاغيرو

126
00:11:35,950 --> 00:11:37,870
هذا لِقاء غريب

127
00:11:40,410 --> 00:11:43,700
!أين أراشي؟! لم يكن معكم؟

128
00:11:46,740 --> 00:11:52,660
يخدم أراشي بالقربِ من أوروتشيمارو-ساما
ويقضي أيّامه في التّدريب

129
00:11:53,910 --> 00:11:56,330
!هل يمكنني رؤية أراشي؟

130
00:11:56,740 --> 00:12:01,410
إذا تعاونتِ معنا لحسابِ أوروتشيمارو-ساما

131
00:12:01,490 --> 00:12:03,160
فأنا متأكّدٌ أنّكِ ستتمكَّنين من رؤيته

132
00:12:14,780 --> 00:12:15,990
ما الأخبار؟

133
00:12:21,120 --> 00:12:22,620
أبليتِ حسناً

134
00:12:22,700 --> 00:12:25,490
بهذا سأتمكّن من رؤيةِ أراشي، صحيح؟

135
00:12:27,410 --> 00:12:30,620
!بعد أن نقضي عليهم

136
00:12:31,830 --> 00:12:35,120
لماذا؟! ألم يكن من المُتَّفق أن تأخذوهم
إلى أوروتشيمارو-ساما

137
00:12:35,200 --> 00:12:37,280
!للفحصِ بعد أسرِهم؟

138
00:12:37,370 --> 00:12:40,870
لا نحتاج سوى للرؤوسِ لإجراءِ الفحص

139
00:12:42,450 --> 00:12:43,330
!لا

140
00:12:43,700 --> 00:12:45,740
...هؤلاء... لأجلي

141
00:12:45,830 --> 00:12:46,660
!ابتعدي

142
00:12:49,830 --> 00:12:50,660
!ماذا؟

143
00:12:55,530 --> 00:12:56,370
!ماذا؟

144
00:12:56,450 --> 00:12:58,580
!دواء فوما المخدِّر لم يفلح

145
00:12:58,910 --> 00:13:02,160
!كنّا نعلم بالأمر منذ البداية

146
00:13:02,950 --> 00:13:04,030
!ساكورا

147
00:13:10,910 --> 00:13:12,330
!بدائل؟

148
00:13:12,660 --> 00:13:13,830
!أترك ساسامي لكِ

149
00:13:13,910 --> 00:13:14,950
!اعتمِد عليّ

150
00:13:18,200 --> 00:13:20,240
!ساسامي... تماسكي

151
00:13:23,950 --> 00:13:28,450
لماذا؟ لمَ على ساسامي أن تفعل شيئاً كهذا؟

152
00:13:29,120 --> 00:13:31,450
!لا، إنّها لا تفعل هذا رغم إرادتها

153
00:13:31,530 --> 00:13:33,950
!هي من أرادَتْ فعل ذلك

154
00:13:34,030 --> 00:13:35,030
!كاذب

155
00:13:36,030 --> 00:13:37,240
...بل كلامي صحيح

156
00:13:38,490 --> 00:13:39,410
...ماذا

157
00:13:39,870 --> 00:13:42,450
ماذا ينبغي أن أفعل لأرى أراشي مجدّداً؟

158
00:13:42,530 --> 00:13:44,660
هذا ليس صعباً

159
00:13:44,740 --> 00:13:48,330
كلّ ما عليكِ فعله هو أن تخدّري أولئك الذين اخترقوا
بلد حقل الأرزّ ليُغمى عليهم

160
00:13:49,370 --> 00:13:50,280
!هل علينا قتلهم؟

161
00:13:50,370 --> 00:13:53,740
سنأخذهم إلى أوروتشيمارو-ساما لإجراء فحص

162
00:13:54,030 --> 00:13:55,410
لن نضطرّ للقتل إذاً، صحيح؟

163
00:13:55,700 --> 00:13:59,870
إذا نفّذنا هذا العمل فإنَّ أوروتشيمارو-ساما سيعترف بنا

164
00:14:01,910 --> 00:14:06,080
يقول هانزاكي أنَّ أراشي والجميع يُخدَعون
بواسطة أوروتشيمارو

165
00:14:06,490 --> 00:14:08,830
يقول أنّكم سوف تُستَغَلّون وتُرمون

166
00:14:08,910 --> 00:14:12,370
هانزاكي هو مجرّد خائن تخلّى عن القرية

167
00:14:12,660 --> 00:14:14,700
هل تصدّقين ما نقوله؟

168
00:14:15,240 --> 00:14:17,580
أم تصدّقين ما يقوله خائن؟

169
00:14:17,660 --> 00:14:22,910
أوروتشيمارو-ساما سيحيي عشيرتنا فوما

170
00:14:25,410 --> 00:14:30,330
ورغم أنّكِ ما زلتِ صغيرة يا ساسامي إلّا أنّكِ
جزء من عشيرةِ فوما أيضاً

171
00:14:31,080 --> 00:14:34,410
ساهمي في إحياءِ عشيرتنا فوما

172
00:14:41,280 --> 00:14:43,660
!خدعتم ساسامي إذاً

173
00:14:43,990 --> 00:14:46,580
!كلّ هذا لإحياءِ عشيرة فوما

174
00:14:50,740 --> 00:14:51,700
!أيُّها الوغد

175
00:14:58,240 --> 00:14:59,740
!تقنية نسخة الظل

176
00:15:00,080 --> 00:15:01,280
!ها أنا ذا

177
00:15:01,370 --> 00:15:02,200
!ماذا؟

178
00:15:02,280 --> 00:15:04,910
!...أو-زو-ما-كي

179
00:15:09,830 --> 00:15:11,410
!وابل ناروتو

180
00:15:13,990 --> 00:15:15,580
!هذا سيّئ

181
00:15:25,370 --> 00:15:26,990
!راسينغان

182
00:15:36,240 --> 00:15:39,530
!هذه لأجل ساسامي. حضِّروا أنفسكم

183
00:15:40,450 --> 00:15:41,280
!ناروتو

184
00:15:47,490 --> 00:15:50,030
!أنت... ذاك الشخص؟

185
00:15:50,530 --> 00:15:52,660
مُستخدِم تقنيّة أسلوب الأرض ذاك؟

186
00:15:53,200 --> 00:15:58,450
لكن لا جدوى من استخدامِ ذلك الفنّ
في هذه المنطِقة الصخريّة

187
00:16:00,240 --> 00:16:04,370
لا أنكر أنَّ أسد النمل يظهر من داخل الأرض

188
00:16:04,450 --> 00:16:06,700
ويبسط جناحيه تحت أشعّة الشّمس

189
00:16:06,780 --> 00:16:08,950
فإنّه يلمع بلمحة

190
00:16:09,830 --> 00:16:13,160
!ذلك عندما أموت ككاغيرو

191
00:16:16,830 --> 00:16:17,830
!كُن حذراً

192
00:16:25,330 --> 00:16:27,280
ما هذا؟

193
00:16:28,740 --> 00:16:30,030
...انظر! ناروتو

194
00:16:37,240 --> 00:16:38,080
!ماذا؟

195
00:16:49,870 --> 00:16:51,410
!غـ-غير معقول

196
00:16:51,490 --> 00:16:53,370
!كنت امرأة؟

197
00:16:54,990 --> 00:16:58,240
ستكون العشيرة من جديد في مكانٍ
...تضيئه أشعّة الشمس

198
00:16:58,700 --> 00:17:01,780
...أوروتشيمارو-ساما وعد بذلك

199
00:17:02,660 --> 00:17:07,200
سأستخدم هذا الفنّ النادر لأجلِ ذلك

200
00:17:12,240 --> 00:17:14,700
!فنّ نينجا كاغيرو: العابِرة

201
00:17:18,410 --> 00:17:19,990
!ناروتو! تعال معي

202
00:17:27,160 --> 00:17:28,330
!ناروتو

203
00:17:45,120 --> 00:17:48,910
...أ-أشعر وكأنّني... رأيتُ هذا من قبل

204
00:17:49,530 --> 00:17:52,080
تقنيّة فخّ فم الضفدع

205
00:17:52,330 --> 00:17:55,120
استدعيتُ المعدةَ المتينة الاستثنائيّة

206
00:17:55,200 --> 00:17:57,450
لضفدع إيواجوكو العملاق من جبلِ ميوبوكو

207
00:17:58,030 --> 00:17:59,240
معدة؟

208
00:18:03,200 --> 00:18:05,160
...إنّها تذوب

209
00:18:05,240 --> 00:18:06,450
لو لم أفعل هذا

210
00:18:06,530 --> 00:18:08,780
لما تمكّنتُ من حمايةِ أنفسنا من التشاكرا خاصّتها

211
00:18:26,240 --> 00:18:30,910
...آمنت... أنَّ العشيرة يوماً ما

212
00:18:31,330 --> 00:18:32,830
آمنتُ بذلك

213
00:18:42,910 --> 00:18:44,910
ا-اختفت

214
00:18:45,910 --> 00:18:47,370
أثني عليها حقّاً

215
00:18:47,740 --> 00:18:50,120
وضعتْ كلّ حياتها على المحكّ

216
00:18:50,200 --> 00:18:52,370
وحاولتْ إنقاذ زملائها

217
00:18:54,240 --> 00:18:55,620
!هذا لا يُغتفَر

218
00:18:58,160 --> 00:19:01,490
...أولئك الأشخاص... نينجا فوما

219
00:19:01,870 --> 00:19:05,370
مشاعرهم تجاه العشيرة هي نفس مشاعرنا

220
00:19:06,080 --> 00:19:11,240
...استغلال رغبة فوما لإحياء عشيرتهم

221
00:19:12,910 --> 00:19:17,530
!سأسحق أوروتشيمارو مهما كلّف الأمر

222
00:19:35,490 --> 00:19:37,080
أ-أين نحن؟

223
00:19:38,490 --> 00:19:39,660
!...كاغيرو

224
00:19:40,120 --> 00:19:44,780
خاطرتِ بحياتكِ لإنقاذنا؟

225
00:19:49,160 --> 00:19:50,490
حمقاء

226
00:20:07,450 --> 00:20:09,160
...أرجوك

227
00:20:10,080 --> 00:20:13,080
أرجوك استخدم النينجيتسو الطبّية خاصّتك لإنقاذِها

228
00:20:13,490 --> 00:20:17,160
!لم يبقَ الكثير من الوقت أمام زميلتنا لتعيش

229
00:20:18,410 --> 00:20:22,740
ضعا أيديكما على صدريكما وفكّرا

230
00:20:23,620 --> 00:20:28,280
فكّرا في عجزِكما عن إنجاز المهمّة... مفهوم؟

231
00:20:28,530 --> 00:20:33,950
خاطرنا بأرواحنا لأجلك... لمساعدتك يا أوروتشيمارو-ساما

232
00:20:34,200 --> 00:20:36,410
!لأجل إحياء عشيرة فوما

233
00:20:36,490 --> 00:20:38,780
!أرجوك اعترف بعملنا

234
00:20:40,410 --> 00:20:45,990
يجب عليكم أن تكفِّروا عن فشلِكم بأجسادكم

235
00:20:52,080 --> 00:20:53,410
!أوروتشيمارو-ساما

236
00:20:54,780 --> 00:20:56,200
!آسف على الخيانة

237
00:22:50,700 --> 00:22:52,330
!ذاك هو مقرّ أوروتشيمارو

238
00:22:52,410 --> 00:22:56,030
من طِباعه تشييد مقرّه تحت الأرض

239
00:22:56,120 --> 00:22:58,490
ساسكي متواجد في مكانٍ ما داخل
ذلك المقرّ، صحيح؟

240
00:22:58,580 --> 00:22:59,990
!ساكورا، لنسرع

241
00:23:00,080 --> 00:23:00,910
!نعم

242
00:23:00,990 --> 00:23:03,620
!توخّوا الحذر! محطّة الجحيم الأولى تقع أمامنا

243
00:23:03,700 --> 00:23:05,280
هل سيظهر شيطان أم أفعى؟

244
00:23:05,370 --> 00:23:07,120
!أتطلّع قدماً لذلك

245
00:23:07,200 --> 00:23:08,870
سأسحق الشّيطان والأفعى

246
00:23:08,950 --> 00:23:12,620
!وسأنقذ ساسكي وأراشي

247
00:23:12,990 --> 00:23:15,830
!الحلقة القادمة "رُعب حقيقي
"بيت أوروتشيمارو