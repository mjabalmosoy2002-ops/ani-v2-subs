1
00:01:57,480 --> 00:01:58,620
!ساسكي

2
00:01:59,720 --> 00:02:02,220
إنّ ناروتو مختلف عنك بكلّ
.تأكيد يا ساسكي

3
00:02:02,220 --> 00:02:04,750
.إنّه أخرق ويعيق طريقنا أحيانًا

4
00:02:04,750 --> 00:02:07,850
!لكنّه ليس جبانًا على الإطلاق

5
00:02:08,220 --> 00:02:10,450
أخبرني، هل كلامي صحيح؟

6
00:02:11,290 --> 00:02:12,520
!ساسكي

7
00:02:24,980 --> 00:02:27,050
.يا لحمقك يا أخي الصّغير

8
00:02:27,680 --> 00:02:32,090
...إن أردتَ قتلي، اكرهني، امقُتني

9
00:02:32,420 --> 00:02:35,950
.وواصل عيش حياتك البشعة

10
00:02:37,650 --> 00:02:38,680
...كلاّ

11
00:02:41,890 --> 00:02:42,920
.اهرب

12
00:02:42,920 --> 00:02:46,580
.اهرب وتشبّث بالحياة

13
00:02:47,250 --> 00:02:48,650
!كلاّ

14
00:02:51,990 --> 00:02:53,240
!كلاّ

15
00:02:57,680 --> 00:03:01,690
!إحياء الشّارينغان"
"!أسلوب النّار: تقنية لهب التّنّين"

16
00:03:05,250 --> 00:03:07,480
،هذا ما توقّعتُه من عشيرة الأوتشيها

17
00:03:07,480 --> 00:03:10,250
...بدأت دماؤه تغلي

18
00:03:11,350 --> 00:03:15,450
.سآخذ وقتي وأتأكّد من قوّته الحقيقيّة

19
00:03:17,650 --> 00:03:20,780
.عليّ أن أعيش لأتمكّن من قتل أخي الأكبر

20
00:03:21,350 --> 00:03:22,650
.ذلك ما ظننتُه

21
00:03:23,910 --> 00:03:27,150
.لكن أنا من كان يتصرّف بغباء

22
00:03:27,350 --> 00:03:28,120
!ناروتو

23
00:03:28,120 --> 00:03:29,080
!ساكورا

24
00:03:29,080 --> 00:03:31,820
لكن كيف لامرئ ما كان ليخاطر
...بحياته في وضع كهذا

25
00:03:31,820 --> 00:03:34,110
!أن يهزم ذلك الرّجل؟

26
00:03:59,820 --> 00:04:00,750
.يمكنني أن أرى

27
00:04:15,680 --> 00:04:16,310
!يمكنني أن أرى

28
00:04:18,280 --> 00:04:19,750
!يمكنني أن أراك

29
00:04:43,180 --> 00:04:44,640
ذلك جيّدًا

30
00:04:44,650 --> 00:04:48,080
.لقد توقّعت كلّ حركاتي
كان تسديدك مضبوطًا

31
00:04:49,020 --> 00:04:50,680
يمكنك رؤية حركاتي، صحيح؟

32
00:05:01,620 --> 00:05:03,380
...ستغرب الشّمس قريبًا

33
00:05:04,880 --> 00:05:06,480
!عليّ إيجاده بسرعة

34
00:05:07,150 --> 00:05:10,920
سيحلّ اللّيل قريبًا وستقلّ
.فرصي بشكل كبير

35
00:05:13,310 --> 00:05:17,210
...لكن لماذا الآن بالتّحديد
ما هو هدفه؟

36
00:05:19,650 --> 00:05:20,780
.لا بأس بذلك

37
00:05:21,660 --> 00:05:24,930
.لقد أتى إلى هذه القرية
.وسأنهي هذا الأمر هنا والآن

38
00:05:38,370 --> 00:05:39,740
!نلت منك

39
00:06:06,800 --> 00:06:08,070
!تقنية استبدال

40
00:06:31,170 --> 00:06:32,300
!ساسكي

41
00:06:38,000 --> 00:06:39,500
.أنت سهل للغاية

42
00:06:40,240 --> 00:06:42,460
.اسم الأوتشيها يبكي الآن

43
00:06:42,930 --> 00:06:44,030
.لا بأس بذلك

44
00:06:44,030 --> 00:06:47,430
سأستمتع بوقتي وأنا ألعب
.معك أكثر قبل قتلك

45
00:06:48,670 --> 00:06:50,670
.كأنّك دودة

46
00:07:08,770 --> 00:07:12,260
!هجوم طاحونة الهواء الثّلاثيّ بالشّارينغان

47
00:07:21,140 --> 00:07:22,860
!أسلوب النّار: تقنية لهب التنّين

48
00:07:34,430 --> 00:07:35,930
!لقد نجح

49
00:07:57,670 --> 00:07:58,900
!ساسكي

50
00:07:59,940 --> 00:08:01,000
!نجحت

51
00:08:04,500 --> 00:08:05,230
هل أنت بخير؟

52
00:08:06,370 --> 00:08:07,630
.تمالك نفسك

53
00:08:21,930 --> 00:08:23,300
تقنية الشّلل المؤقّت؟

54
00:08:24,130 --> 00:08:28,500
لم أتوقّع أن تستعمل الشّارينغان
.بهذا القدر وفي هذه السّنّ

55
00:08:29,070 --> 00:08:32,060
أنت بالفعل فرد حقيقيّ
.من عشيرة الأوتشيها

56
00:08:32,230 --> 00:08:35,030
.أريدك بالفعل، قبل كلّ شيء

57
00:08:39,770 --> 00:08:41,730
.أنت أخوه بكلّ تأكيد

58
00:08:42,100 --> 00:08:45,870
رغم أنّ عينيك تخفي قدرات أكثر
.من عينَيْ إيتاتشي

59
00:08:46,100 --> 00:08:48,170
من تكون يا هذا؟

60
00:08:53,630 --> 00:08:55,930
.اسمي أوروتشيمارو

61
00:08:56,370 --> 00:09:00,300
،إن كنت تظنّ أنّك ترغب في لقائي ثانية

62
00:09:00,300 --> 00:09:04,530
.فاحتلّ يائسًا أعلى المراتب في هذا الامتحان

63
00:09:05,170 --> 00:09:06,370
!اللّفيفة

64
00:09:05,170 --> 00:09:10,000
اهزم نينجا قرية الصّوت
.الثّلاثة الّذين تحت سيطرتي

65
00:09:10,270 --> 00:09:12,600
!كلامك ليس منطقيًّا على الإطلاق

66
00:09:12,800 --> 00:09:16,770
!لا نريد رؤية وجهك ثانية أبدًا، مفهوم؟

67
00:09:18,470 --> 00:09:20,470
.لن يحدث ذلك

68
00:09:28,470 --> 00:09:29,600
!ساسكي

69
00:09:46,400 --> 00:09:47,730
!ساسكي

70
00:09:47,970 --> 00:09:51,000
أنت، ما الّذي فعلتَه بساسكي؟

71
00:09:52,530 --> 00:09:54,730
.أعطيته هديّة وداع

72
00:09:55,000 --> 00:10:00,200
سيأتي ساسكي باحثًا عنّي
.بكلّ تأكيد، باحثًا عن القوّة

73
00:10:00,840 --> 00:10:05,430
.استمتعتُ برؤية قواك المختلفة

74
00:10:17,200 --> 00:10:18,500
!ساسكي

75
00:10:20,770 --> 00:10:22,630
.تماسك يا ساسكي

76
00:10:23,130 --> 00:10:23,800
ما بك؟

77
00:10:32,500 --> 00:10:33,730
...ساسكي

78
00:10:40,370 --> 00:10:42,130
!أجبني يا ساسكي

79
00:10:42,500 --> 00:10:43,930
...هيّا يا ساسكي

80
00:10:45,000 --> 00:10:46,470
...ساسكي

81
00:10:50,990 --> 00:10:55,800
!...ناروتو! إن ساسكي... إنّ ساسكي

82
00:10:57,170 --> 00:10:59,340
!ناروتو

83
00:11:14,500 --> 00:11:15,870
ماذا؟

84
00:11:17,500 --> 00:11:19,770
ماذا عليّ أن أفعل؟

85
00:11:48,030 --> 00:11:49,370
!يمكنني الشّعور به

86
00:12:02,630 --> 00:12:04,030
.إنّه قريب

87
00:12:25,330 --> 00:12:27,000
...لم أرك منذ مدّة

88
00:12:27,770 --> 00:12:28,900
.يا آنكو

89
00:12:31,290 --> 00:12:35,270
أنت هارب بالغ الخطورة من الفئة س
.وعلى لائحة أكثر المطلوبين

90
00:12:36,070 --> 00:12:39,800
لهذا السّبب سأقتلك هنا
.وإن كلّفني ذلك حياتي

91
00:12:40,070 --> 00:12:42,760
هذا واجبي بصفتي تلميذتك السّابقة

92
00:12:42,960 --> 00:12:47,370
،الّتي تعلّمت منك كلّ شيء
!أليس ذلك صحيحًا يا أوروتشيمارو؟

93
00:12:47,670 --> 00:12:48,470
!لن تقوي على ذلك

94
00:13:04,030 --> 00:13:05,530
!أذرع ثعابين الظّلال الخفيّة

95
00:13:12,860 --> 00:13:14,530
.لن أدعك تهرب

96
00:13:35,630 --> 00:13:37,100
.نلت منك

97
00:13:37,770 --> 00:13:40,890
.أوروتشيمارو، سأستعير يدك اليسرى

98
00:13:42,400 --> 00:13:43,930
...ختم اليد هذا

99
00:13:44,930 --> 00:13:48,770
.صحيح... سنموت أنا وأنت هنا

100
00:13:52,030 --> 00:13:55,100
!أسلوب النّينجا: تضحية الثّعبانين التّوأم

101
00:13:56,830 --> 00:14:00,300
أتنوين الانتحار؟

102
00:14:11,630 --> 00:14:13,160
.تقنية استبدال

103
00:14:29,770 --> 00:14:33,530
،بما أنّك جونين خاصّ للقرية الآن

104
00:14:34,030 --> 00:14:38,030
فلا يجب عليك استعمال
.تقنيات محرّمة علّمتك إيّاها

105
00:14:41,330 --> 00:14:43,500
.أخبرتك أنّ لا فائدة من ذلك

106
00:14:57,730 --> 00:14:59,540
لماذا أتيت الآن؟

107
00:14:59,570 --> 00:15:04,030
،هذا لقاؤنا الأوّل بعد فراق طويل
.ومع ذلك تعاملينني ببرود

108
00:15:05,170 --> 00:15:08,740
لا تقل أنّك قد أتيت لاغتيال
!السّيّد الهوكاغي؟

109
00:15:08,740 --> 00:15:10,370
...لا، لا

110
00:15:10,860 --> 00:15:13,460
.ليس لديّ رجال بما يكفي لذلك الآن

111
00:15:13,660 --> 00:15:17,970
لكنّني سمعتُ عن نخبة هذه القرية
.وفكّرت في جعلهم ملكي

112
00:15:23,200 --> 00:15:28,370
منحت قبل قليل نفس الختم
.الملعون كهديّة لأحدهم

113
00:15:29,670 --> 00:15:31,730
.هنالك فتى أرغب فيه

114
00:15:32,960 --> 00:15:34,960
.أنت أنانيّ كعادتك

115
00:15:35,130 --> 00:15:36,830
.سيموت ذلك الفتى

116
00:15:37,530 --> 00:15:41,690
،بالتّأكيد... احتمال بقاءه على قيد الحياة هو واحد من عشرة

117
00:15:41,730 --> 00:15:45,700
.لكنّه قد ينجو مثلك تمامًا

118
00:15:46,470 --> 00:15:49,270
هذا الفتى، هل تريده بشدّة هكذا؟

119
00:15:50,730 --> 00:15:52,330
أتشعرين بالغيرة؟

120
00:15:52,600 --> 00:15:53,530
...اسمعي

121
00:15:54,160 --> 00:15:58,700
هل ما زلت تحملين ضغينة تجاهي
لأنّني استغللتك وتخلّيت عنك؟

122
00:16:01,330 --> 00:16:04,660
.على عكسك، فإنّ ذلك الفتى سيتفوّق

123
00:16:04,760 --> 00:16:08,770
.إنّه وريث قدرات الأوتشيها قبل كلّ شيء

124
00:16:10,500 --> 00:16:15,130
لديه مميّزات جميلة وهو مُضيف
.قادر على أن يصبح خليفتي

125
00:16:15,630 --> 00:16:19,540
،إن عاش ذلك الفتى
.فستغدو الأمور أكثر إثارة

126
00:16:20,000 --> 00:16:23,730
.احرصوا على ألاّ تلغوا هذا الامتحان

127
00:16:25,600 --> 00:16:28,870
.هنالك ثلاثة أشخاص من قريتي مشاركون أيضًا

128
00:16:29,470 --> 00:16:31,490
.من الأفضل أن أستمتع بالأمر

129
00:16:33,930 --> 00:16:37,900
،إن حدث ما قد يحرمني من متعتي

130
00:16:38,740 --> 00:16:41,800
.فاعتبروا ذلك نهاية قرية ورق الشّجر

131
00:16:53,630 --> 00:16:56,770
أمّنّا المأكل والمشرب بعد قضائنا لنصف يوم

132
00:16:57,200 --> 00:17:00,470
.وها قد أوقفت الآن معظم الفرق نشاطها

133
00:17:01,730 --> 00:17:04,230
هذا هو الوقت المناسب للهجوم
.كما خطّطنا تمامًا

134
00:17:04,660 --> 00:17:07,370
.سنفترق نحن الثّلاثة ونكتشف المنطقة

135
00:17:07,370 --> 00:17:11,190
،ولكن، سواء أوجدنا فرقًا أخرى أم لا

136
00:17:11,190 --> 00:17:13,160
.فسنعود لهذا المكان

137
00:17:15,030 --> 00:17:15,900
مفهوم؟

138
00:17:16,200 --> 00:17:17,200
.نعم

139
00:17:17,200 --> 00:17:18,600
.عُلم

140
00:17:19,000 --> 00:17:20,000
.حسنًا

141
00:17:20,100 --> 00:17:21,030
!انطلقا

142
00:17:30,960 --> 00:17:33,730
...يصبح تنفّسه أفضل تدريجيًّا

143
00:17:34,100 --> 00:17:36,230
.لكنّه ما زال يعاني من الحمّى

144
00:17:47,700 --> 00:17:49,800
.عليّ حمايتهما معًا

145
00:18:04,100 --> 00:18:07,570
.عليّ تبليغ السّيّد الهوكاغي بهذا في الحال

146
00:18:39,670 --> 00:18:42,030
!سُحقًا! هذا ليس وقتًا مناسبًا

147
00:19:11,730 --> 00:19:15,000
.هذه تقنية شلل

148
00:19:15,630 --> 00:19:18,000
.أنت هنا إذًا يا آنكو

149
00:19:28,440 --> 00:19:31,800
.تأخّرتم كثيرًا رغم أنّكم من الآنبو

150
00:19:31,800 --> 00:19:33,430
.لا فائدة من الشّكوى الآن

151
00:19:38,840 --> 00:19:40,490
هل أنت بخير؟

152
00:19:40,730 --> 00:19:42,930
...ماذا؟ هـ-هذا

153
00:19:43,430 --> 00:19:45,630
...لقد ظهر الختم الملعون

154
00:19:46,170 --> 00:19:47,370
!مستحيل

155
00:19:47,930 --> 00:19:49,140
هل هو أوروتشيمارو؟

156
00:19:49,570 --> 00:19:51,560
ماذا؟ أهذا معقول؟

157
00:19:52,860 --> 00:19:55,870
،بما أنّ الأمر قد آل لهذا الحال
.فسنأخذك إلى الهوكاغي

158
00:19:57,000 --> 00:19:59,100
.كلاّ، خذوني للبرج

159
00:19:59,100 --> 00:20:00,860
ماذا تقولين؟

160
00:20:00,860 --> 00:20:04,830
يجب إطلاق تحذير بالغ الخطورة
.بمجرّد ظهور أوروتشيمارو في القرية

161
00:20:05,030 --> 00:20:06,600
.إنّه أمر عاجل أكثر من مواصلة الامتحان

162
00:20:06,800 --> 00:20:07,930
...أعلم

163
00:20:09,240 --> 00:20:14,060
،على أيّ حال، سأشرح الأمر بالكامل لاحقًا
.لذلك استدعوا هوكاغي-ساما رجاءً

164
00:20:26,520 --> 00:20:27,620
.وجدتكم

165
00:20:28,320 --> 00:20:32,320
سننتظر حتّى الفجر لنباشر
.كما أمر أوروتشيمارو

166
00:20:33,050 --> 00:20:36,360
،أوتشيها ساسكي هو هدفنا
.ولا أحد غيره

167
00:20:36,660 --> 00:20:40,430
،لكن إن وقفا في طريقينا
فلا مانع من قتلهما، صحيح؟

168
00:20:40,560 --> 00:20:41,480
.بالطّبع

169
00:21:16,420 --> 00:21:21,050
هل تسمعني؟

170
00:21:21,050 --> 00:21:29,180
السماء الزرقاء الصافية ليس لأفقها حدودُ

171
00:21:30,350 --> 00:21:39,110
والبحرُ واسعٌ على مد البصر كبيرُ

172
00:21:39,440 --> 00:21:53,950
من فضلك، أبقِ هذه البسمة على محيّاك، وإلّا بكيتُ

173
00:21:54,080 --> 00:21:58,040
لستَ بعوزٍ إلى البحث من حولكْ

174
00:21:58,040 --> 00:22:10,890
فالجميع في هاتين اليدين متواجدْ

175
00:22:10,890 --> 00:22:15,890
،حتى وإن أردتَّ الهروب، حتى وإن أردتَّ البكاء

176
00:22:16,060 --> 00:22:24,360
.حتى وإن نسيتَ سعادتك، فما عليك سوى بالغناء

177
00:22:24,610 --> 00:22:32,030
وُلد النور، ثم وُلد الظلام، فاجتمعا واندمجا

178
00:22:32,080 --> 00:22:38,500
فبالأُلفة والتخاطر أحسسنا

179
00:22:38,870 --> 00:22:43,960
هل بتّ تسمعني؟

180
00:22:47,090 --> 00:22:50,800
وحش قرية ورق الشّجر الجميل
!روك لي قد وصل

181
00:22:51,050 --> 00:22:53,680
!أجل، نجحت! نجحت يا غاي سينسي

182
00:22:53,810 --> 00:22:57,350
!أستطيع الآن الفوز بقلب الآنسة ساكورا

183
00:22:58,940 --> 00:23:01,980
يمكن القول أنّني في وضع
!لا  أحسد عليه من ناحية العدد

184
00:23:01,980 --> 00:23:04,360
.لكن على العكس، كلّ الشّروط قد تحقّقت

185
00:23:04,440 --> 00:23:08,610
.غاي سينسي، سأستعمل تلك التّقنية بلا أيّ تردّد

186
00:23:09,240 --> 00:23:14,990
:في الحلقة القادمة: "وعدُ كثيف الحواجب
"!سأحميك حتّى الموت