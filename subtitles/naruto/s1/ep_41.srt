1
00:01:45,400 --> 00:01:47,900
!سأنهي الأمر بسرعة

2
00:01:49,040 --> 00:01:50,640
.لن أسمح لك بفعل أيّ شيء

3
00:01:51,210 --> 00:01:52,340
!فوزي مؤكّد بتحرّكي أوّلاً

4
00:02:06,660 --> 00:02:08,990
!مذهل! كان ذلك رائعًا

5
00:02:09,560 --> 00:02:11,730
!ما بال جسده؟

6
00:02:12,290 --> 00:02:18,770
أخلع كلّ مفصل في جسدي بينما أتحكّم
.في ليونته كما أشاء بالتشاكرا خاصّتي

7
00:02:19,740 --> 00:02:20,900
بالتشاكرا؟

8
00:02:24,440 --> 00:02:27,910
أستطيع أيضًا الضّغط عليك
.إلى أن تنكسر عظامك

9
00:02:28,880 --> 00:02:32,010
سأواصل التّضييق عليك بسرعة
.ما دمتَ ترفض الاستسلام

10
00:02:33,080 --> 00:02:35,780
لا أعرف أيّ نوع من أدوات
...النّينجا ستستعمل

11
00:02:36,420 --> 00:02:38,920
،لكن إن واصلتُ القيام بهذا بجسدك
.فلن يشكّل ذلك أيّ فرق

12
00:02:39,660 --> 00:02:42,590
.أستطيع كسر عنقك في الحال

13
00:02:44,130 --> 00:02:45,690
.لذلك أسرع واستسلم

14
00:02:47,660 --> 00:02:48,760
.لن أستسلم

15
00:02:49,000 --> 00:02:49,970
!هل تريد الموت؟

16
00:02:51,830 --> 00:02:55,370
.غبيّ. أنت من سيموت

17
00:03:07,450 --> 00:03:09,520
.كُسر عنقه

18
00:03:12,020 --> 00:03:13,060
...يا للسّخافة

19
00:03:16,990 --> 00:03:17,830
.غبيّ

20
00:03:18,730 --> 00:03:21,360
.لقد بالغتُ قليلاً وانتهى بي الأمر أقتلك

21
00:03:27,500 --> 00:03:28,370
ما-ماذا؟

22
00:03:29,240 --> 00:03:32,110
.حسنًا، حان دوري الآن

23
00:03:41,220 --> 00:03:43,620
!هـ-هذه دمية

24
00:03:51,590 --> 00:03:53,700
ذ-ذلك هو الجسد الحقيقيّ؟

25
00:03:54,930 --> 00:03:56,830
...إنّه... مستعمل دُمى

26
00:03:58,930 --> 00:04:02,270
!إنّه يتحكّم بالدّمية بتشاكرا تخرج من يده

27
00:04:13,850 --> 00:04:15,050
!أ-أستسلم

28
00:04:17,350 --> 00:04:21,120
إن سُحقت عظامك، فستتمكّن
.من أن تلتوي أكثر من ذي قبل

29
00:04:23,230 --> 00:04:29,060
لوهلة، كنتُ أوشك على إيقاف
.النّزال في المنتصف

30
00:04:33,940 --> 00:04:37,670
الفائز هو كانكورو بعد أن أصبح
.خصمه عاجزًا عن مواصلة النّزال

31
00:04:37,870 --> 00:04:40,740
!اثنان ضدّ واحد ليس نزالاً عادلاً

32
00:04:40,780 --> 00:04:43,680
!هل ذلك مسموح به يا كاكاشي سينسي؟

33
00:04:44,080 --> 00:04:45,950
.بل هو قتال عادل بما يكفي

34
00:04:46,080 --> 00:04:47,820
.إنّها دمية قبل كلّ شيء

35
00:04:48,550 --> 00:04:50,750
.تلك تقنية مستعملي الدّمى

36
00:04:51,020 --> 00:04:53,020
.إنّه يتحكّم بالدّمية عن طريق التشاكرا

37
00:04:53,760 --> 00:04:55,790
إنّه نفس الشّيء كاستعمال
.النّينجا لأداة كالشّوريكن

38
00:05:01,230 --> 00:05:03,670
...جميعهم مستعملو تشاكرا بارعين

39
00:05:04,800 --> 00:05:08,470
اعتقدتُ أنّني أستطيع التّقدّم
.كثيرًا بالتشاكرا

40
00:05:11,490 --> 00:05:15,100
!صراع نِدّين
مواجهة جادّة لفتانين

41
00:05:29,160 --> 00:05:29,990
!إينو

42
00:05:31,930 --> 00:05:34,430
هل خفتِ يا ساكورا؟

43
00:05:40,200 --> 00:05:43,040
.حتّى ساسكي لم يستطع التّحمّل

44
00:05:43,310 --> 00:05:47,080
بدا وكأنّ الأمر ما كان لينتهي كذلك
.لو كان شخصًا آخر غير ساسكي

45
00:05:47,410 --> 00:05:50,850
ماذا كان سيحدث إن كنتِ مكانه؟

46
00:05:51,480 --> 00:05:54,150
!سيكون من الأفضل أن تستسلمي

47
00:06:01,960 --> 00:06:04,260
!لن يُجدي شيء كهذا معي

48
00:06:13,870 --> 00:06:16,540
لا بأس! أستطيع التّصرّف بقوّة
.هذه المرّة أيضًا

49
00:06:17,640 --> 00:06:19,610
أستسلم؟ أنا؟

50
00:06:28,980 --> 00:06:30,690
.لا أطيق الانتظار

51
00:06:39,090 --> 00:06:42,530
!تشانّارو! أريني ما لديك

52
00:06:46,230 --> 00:06:49,800
.والآن، سنواصل ونبدأ بالنّزال الرّابع

53
00:06:52,770 --> 00:06:57,180
!يا إلهي، لا يوجد هنا سوى غرباء الأطوار

54
00:06:57,380 --> 00:06:58,780
!لا تقل ذلك أنت بالأخصّ

55
00:06:59,080 --> 00:06:59,880
.معك حقّ

56
00:06:59,920 --> 00:07:01,580
!أنت أيضًا يا ساكورا؟

57
00:07:03,490 --> 00:07:06,150
.هذا ليس وقت الضّحك

58
00:07:37,020 --> 00:07:42,190
.لم أتوقّع أبدًا أنّني سأقاتلك يا ساكورا

59
00:07:43,220 --> 00:07:45,130
.وبهذه السّرعة أيضًا

60
00:07:48,030 --> 00:07:52,070
لقد تميّزت إينو بين مثيلاتها
.الكونويتشي المبتدئات

61
00:07:53,230 --> 00:07:58,170
إن كانت ساكورا خصمها، فهل ستقاتل
بجدّيّة... بل هل يمكنها القتال بجدّيّة؟

62
00:07:58,740 --> 00:08:01,180
.لا أصدّق أنّه نزال بين هاتين الاثنتين

63
00:08:01,840 --> 00:08:04,080
.أصبح الوضع كئيبًا

64
00:08:04,410 --> 00:08:06,610
.أتساءل ما إن ستكون إينو بخير

65
00:08:07,350 --> 00:08:08,580
.معك حقّ

66
00:08:10,050 --> 00:08:12,220
ما الّذي ستفعلينه يا إينو؟

67
00:08:13,250 --> 00:08:17,660
!ساكورا! حظًّا سعيدًا! لا تخسري

68
00:08:20,030 --> 00:08:20,660
!ابدآ

69
00:08:35,040 --> 00:08:37,250
.كلاّ. عرفتُ هذا

70
00:08:37,450 --> 00:08:40,750
!ساكورا متفوّقة تمامًا على إينو

71
00:08:41,020 --> 00:08:41,780
.غبيّ

72
00:08:42,720 --> 00:08:43,850
!ماذا قلت؟

73
00:08:44,550 --> 00:08:47,220
.إن لم تكن غبيًّا، فلا بدّ أنّك نائم

74
00:08:48,220 --> 00:08:49,390
!عمّن تتكلّم؟

75
00:08:49,420 --> 00:08:50,860
.هذا واضح لأنّهما كونويتشي

76
00:08:51,430 --> 00:08:53,190
هذا هو مستوى قتالهما الجسديّ إذًا؟

77
00:08:55,060 --> 00:08:56,870
.لا علاقة للأمر بكونهما كونويتشي

78
00:08:58,400 --> 00:09:03,200
.إنّهما لا تقاتلان بحماس فحسب
.لا وجود لامرأة أو رجل في القتال

79
00:09:08,280 --> 00:09:09,610
لا تقاتلان بحماس؟

80
00:09:27,360 --> 00:09:28,060
!هذه فرصتي

81
00:10:08,040 --> 00:10:10,610
،ليس على الكونويتشي تعلّم النّينجيتسو فقط

82
00:10:10,810 --> 00:10:15,110
بل عليها التّحلّي بنطاق واسع
.من المعرفة والتّهذيب كامرأة

83
00:10:15,840 --> 00:10:20,180
إن لم تنسجمن بين صفوف العدوّ
...وتتصرّفن كنساء عاديّات

84
00:10:20,580 --> 00:10:24,150
فستواجهن صعوبة إن اضطررتنّ
.للعمل كجاسوسات

85
00:10:24,850 --> 00:10:27,060
.درس اليوم عن تنسيق الزّهور

86
00:10:28,760 --> 00:10:29,660
.حسنًا يا فتيات

87
00:10:30,130 --> 00:10:32,260
.لنجمع زهورًا على ذوقنا

88
00:10:32,560 --> 00:10:33,760
!في الحال

89
00:10:36,460 --> 00:10:38,370
!انتظري يا إينو

90
00:10:44,270 --> 00:10:46,310
.يا لك من خرقاء

91
00:10:58,190 --> 00:11:00,050
.أنا لا أجيد أشياء كهذه

92
00:11:01,020 --> 00:11:02,020
ماذا عنك يا إينو؟

93
00:11:03,890 --> 00:11:06,790
.هذا سيّئ بالنّظر إلى أنّ اسمك ساكورا

94
00:11:07,030 --> 00:11:10,100
.اسمعي. هنالك خدعة للنّجاح في أمر كهذا

95
00:11:11,030 --> 00:11:13,800
،بالنّسبة لمنسّقي الزّهور

96
00:11:13,900 --> 00:11:19,170
،فبعد تحديد ما هي الزّهرة الرّئيسيّة
.يضيفون زهورًا أخرى للتّزيين

97
00:11:19,470 --> 00:11:22,210
.لا يجب أن تتنافس كلّ الزّهور لتبرز

98
00:11:22,840 --> 00:11:25,180
.على سبيل المثال... هناك

99
00:11:26,280 --> 00:11:28,950
هل ترين زهور القسموس الّتي هناك؟

100
00:11:29,880 --> 00:11:32,750
...فإن كانت هي الزّهرة الرّئيسيّة مثلاً

101
00:11:34,060 --> 00:11:36,560
!فستكون الزّهور النّجميّة البيضاء مرافقة لها

102
00:11:37,790 --> 00:11:40,230
،فكما يتميّز الرّبيع بزهور الكرز

103
00:11:40,260 --> 00:11:42,300
فإنّ زهور القسموس تُدعى أيضًا
،بزهور الكرز الخريفيّة

104
00:11:42,460 --> 00:11:45,230
.وهي أجمل زهور الخريف

105
00:11:45,570 --> 00:11:48,800
،كما أنّ هذه الزّهور ترمز للانسجام

106
00:11:49,000 --> 00:11:51,770
لذلك فإنّ أيّ زهرة خريف
.ستنسجم معها بالكامل

107
00:12:01,480 --> 00:12:05,390
ما رأيك؟ هل أبدو مثل زهور القسموس؟

108
00:12:05,590 --> 00:12:07,160
أخبريني، هل أنا ظريفة؟

109
00:12:10,660 --> 00:12:12,330
.نـ... نعم

110
00:12:12,390 --> 00:12:14,460
أخبريني. لماذا تردّدتِ؟

111
00:12:16,100 --> 00:12:19,130
.يبدو أنّك تستمتعين بوقتك كثيرًا

112
00:12:19,900 --> 00:12:21,800
!يا عريضة الجبهة

113
00:12:29,540 --> 00:12:32,310
هل تحاولين الظّهور مؤخّرًا
وكأنّك أكبر من سنّك؟

114
00:12:32,750 --> 00:12:35,380
!لا تغترّي بنفسك كثيرًا

115
00:12:40,190 --> 00:12:41,260
!يا آمي

116
00:12:41,990 --> 00:12:45,830
آسفة! لديك جسد أسطوانيّ جميل

117
00:12:45,890 --> 00:12:48,730
.وخلتُك مزهريّة ووضعت زهورًا فيك

118
00:12:49,830 --> 00:12:51,000
!إينو

119
00:12:52,070 --> 00:12:53,670
.إنّها الخربق، زهرة الشّينوبي

120
00:12:54,140 --> 00:12:59,140
،لديها سُمّيّة طفيفة، لكنّها تظلّ سامّة
.لذلك من الأفضل أن تبصقيها في الحال

121
00:13:02,980 --> 00:13:04,880
!سينسي

122
00:13:08,750 --> 00:13:11,190
.الجذور فقط هي السّامّة

123
00:13:15,620 --> 00:13:17,490
.إينو رائعة

124
00:13:18,390 --> 00:13:21,830
.إنّها واسعة المعرفة وأنيقة وظريفة

125
00:13:22,530 --> 00:13:24,530
.وبارعة في رمي الشّوريكن

126
00:13:25,170 --> 00:13:26,770
...النّينجيتسو خاصّتها ممتاز أيضًا

127
00:13:28,300 --> 00:13:30,670
...ومقارنة بها، أنا

128
00:13:35,180 --> 00:13:36,040
ساكورا؟

129
00:13:37,380 --> 00:13:39,710
...إن كنتِ تشبهين زهرة القسموس

130
00:13:41,020 --> 00:13:43,220
فهل أنا زهرة نجميّة بيضاء؟

131
00:13:49,860 --> 00:13:51,530
!ما الّذي تقولينه؟

132
00:13:53,060 --> 00:13:55,130
...دعيني أفكّر

133
00:13:55,930 --> 00:14:00,340
،إن جاز التّعبير، فأنت لست زهرة
!ما زلتِ برعمًا لم يتفتّح

134
00:14:04,240 --> 00:14:05,340
.معك حقّ

135
00:14:22,380 --> 00:14:23,870
...في هذه اللّحظة

136
00:14:26,050 --> 00:14:28,840
.لا أنوي حتّى أن أقاتلك من أجل ساسكي

137
00:14:29,110 --> 00:14:30,640
ماذا قلتِ؟

138
00:14:31,090 --> 00:14:36,660
،أنت وساسكي لا تناسبان بعضكما
!وأنا أقوى بكثير منك

139
00:14:37,110 --> 00:14:38,430
!بالكاد ألاحظك

140
00:14:39,710 --> 00:14:43,630
!ساكورا! هل تعرفين مع من تتحدّثين؟

141
00:14:44,610 --> 00:14:47,310
!إيّاك والتّمادي أكثر يا ساكورا البكّاءة

142
00:14:50,050 --> 00:14:51,500
...أشعر وكأنّ

143
00:14:51,500 --> 00:14:54,730
!أشعر وكأنّ ساكورا قد تجاوزت الحدود

144
00:14:54,730 --> 00:14:57,930
هنالك غضب مشتعل
.في عينيّ إينو. إنّها مخيفة

145
00:15:00,070 --> 00:15:01,320
....أنت مخطئ

146
00:15:02,700 --> 00:15:05,700
ليست ساكورا من الفتيات اللّواتي

147
00:15:05,700 --> 00:15:08,290
.تتباهين بقوّتهنّ وتؤذين الآخرين

148
00:15:08,740 --> 00:15:13,030
إنّها لا تتقبّل أن تشفق عليها إينو
.وتتهاون معها في القتال

149
00:15:14,420 --> 00:15:16,570
قلتِ أنّني برعم؟

150
00:15:21,060 --> 00:15:22,790
...أخبريني يا إينو

151
00:15:25,310 --> 00:15:26,520
ماذا؟

152
00:15:27,610 --> 00:15:32,510
لماذا أعطيتني هذا الشّريط؟

153
00:15:35,490 --> 00:15:36,980
...في الحقيقة

154
00:15:39,460 --> 00:15:44,500
ظننتُ أنّه ستكون خسارة
.أن تذبلي وأنت ما زلت برعمًا

155
00:15:50,650 --> 00:15:53,650
.لا فائدة من الزّهور إن لم تتفتّح

156
00:16:04,020 --> 00:16:05,500
...فعلى حدّ علمنا

157
00:16:05,500 --> 00:16:06,600
...قد تصبحين

158
00:16:16,740 --> 00:16:20,500
.زهرة أجمل بكثير من القسموس

159
00:16:31,630 --> 00:16:32,890
...شكرًا لك

160
00:16:34,910 --> 00:16:36,000
!يا إينو

161
00:16:39,220 --> 00:16:41,940
.ساكورا. لنسرع ونقطف الأزهار

162
00:16:41,990 --> 00:16:43,060
.حـ-حسنًا

163
00:16:43,780 --> 00:16:45,400
ما الخطب يا ساكورا؟

164
00:16:46,650 --> 00:16:49,820
...دخل تراب في عيني عندما سقطت

165
00:16:49,820 --> 00:16:52,010
.يا لك من خرقاء

166
00:16:56,470 --> 00:16:57,350
...إينو

167
00:17:00,640 --> 00:17:06,270
لقد آمنت بالكلمات الّتي قلتِها
.لي طوال الوقت

168
00:17:07,260 --> 00:17:09,270
.ظننتُ فعلاً أنّه لا بأس إن كان الأمر كذلك

169
00:17:10,590 --> 00:17:13,320
سيكون من الجميل إن جعلتُ
...زهرة جميلة تتفتّح

170
00:17:14,170 --> 00:17:20,830
وضعتُك نصب عينيّ لأنّني
.أردت أن أكون مثلك دائمًا

171
00:17:23,990 --> 00:17:27,010
.وها أنا الآن هنا بفضل ذلك

172
00:17:28,230 --> 00:17:31,420
.لذلك يا إينو، أريد قتالك بجدّيّة

173
00:17:38,850 --> 00:17:43,650
إن لم أستطع تجاوزك وأنت
جادّة تمامًا، فما الفائدة؟

174
00:18:11,960 --> 00:18:14,280
ما-ما بال ساكورا؟

175
00:18:15,840 --> 00:18:19,610
!لماذا كلّ هذا الاحتدام بينهما؟

176
00:18:20,060 --> 00:18:26,960
يا إلهي، إنّه لا يعرف حتّى سبب
.تصرّفاته تلك مع ساسكي

177
00:18:27,520 --> 00:18:32,380
.حسنًا، إنّ الندّ لهو أمر غامض بكلّ تأكيد

178
00:18:37,140 --> 00:18:38,850
...مرحبًا

179
00:18:40,200 --> 00:18:43,070
...ندّي من أيام الشباب كاكاشي

180
00:18:43,590 --> 00:18:48,540
.يا لردّة فعله الحمقاء الرّائعة والمزعجة تلك

181
00:18:52,000 --> 00:18:52,950
...أنا

182
00:18:54,940 --> 00:18:57,190
.في نفس الفريق مع ساسكي

183
00:18:57,480 --> 00:18:59,490
لماذا تخبرينني بهذا الآن؟

184
00:19:02,290 --> 00:19:05,040
.لن أخسر أمامك يا إينو

185
00:19:05,560 --> 00:19:11,780
!مهما حدث، لن أخسر أمامك أيضًا يا ساكورا

186
00:19:17,350 --> 00:19:18,370
...الشّريط

187
00:19:18,370 --> 00:19:21,100
.سأعيد لك هذا الشّريط

188
00:19:30,740 --> 00:19:32,770
.لقد أهديتُك إيّاه

189
00:19:33,220 --> 00:19:36,340
إضافة إلى أنّ واقية الجبهة
توضع على الجبهة، صحيح؟

190
00:19:38,020 --> 00:19:42,190
من الآن فصاعدًا، لم أعد الفتاة
.الّتي ستركض خلفك يا إينو

191
00:19:43,470 --> 00:19:45,370
،عندما أضع هذه على رأسي

192
00:19:45,370 --> 00:19:50,130
فسترمز إلى أنّني شينوبي أنثى
.ترفض أن تخسر أمامك

193
00:20:02,380 --> 00:20:03,590
...فكرة سديدة

194
00:20:12,530 --> 00:20:13,710
...وأنا أيضًا

195
00:20:14,900 --> 00:20:15,980
.حتّى ذلك الحين

196
00:20:20,970 --> 00:20:24,070
.فهمت... يا ساكورا

197
00:20:43,460 --> 00:20:44,840
...هذه المرّة بالتّأكيد

198
00:20:46,260 --> 00:20:47,550
...وبكلّ قوّتي

199
00:20:49,810 --> 00:20:53,660
!سأقاتل... قتالاً عادلاً

200
00:21:16,920 --> 00:21:21,550
هل تسمعني؟

201
00:21:21,550 --> 00:21:29,680
السماء الزرقاء الصافية ليس لأفقها حدودُ

202
00:21:30,850 --> 00:21:39,610
والبحرُ واسعٌ على مد البصر كبيرُ

203
00:21:39,940 --> 00:21:54,450
من فضلك، أبقِ هذه البسمة على محيّاك، وإلّا بكيتُ

204
00:21:54,580 --> 00:21:58,540
لستَ بعوزٍ إلى البحث من حولكْ

205
00:21:58,540 --> 00:22:11,390
فالجميع في هاتين اليدين متواجدْ

206
00:22:11,390 --> 00:22:16,390
،حتى وإن أردتَّ الهروب، حتى وإن أردتَّ البكاء

207
00:22:16,560 --> 00:22:24,860
.حتى وإن نسيتَ سعادتك، فما عليك سوى بالغناء

208
00:22:25,110 --> 00:22:32,530
وُلد النور، ثم وُلد الظلام، فاجتمعا واندمجا

209
00:22:32,580 --> 00:22:39,000
فبالأُلفة والتخاطر أحسسنا

210
00:22:39,370 --> 00:22:44,460
هل بتّ تسمعني؟

211
00:22:49,000 --> 00:22:51,070
!منذ متى أصبحت قويّة هكذا؟

212
00:22:51,100 --> 00:22:52,630
.إينو رائعة بالفعل

213
00:22:52,930 --> 00:22:56,340
.لكنّني لن أخسر. لن أخسر أبدًا

214
00:22:56,570 --> 00:22:59,370
!مستحيل. إنّها في نفس مستواي؟

215
00:22:59,410 --> 00:23:01,740
.لم أعد تلك الفتاة

216
00:23:02,510 --> 00:23:05,750
!الضّربة الّتالية هي الحاسمة

217
00:23:06,980 --> 00:23:10,410
الحلقة القادمة

218
00:23:06,980 --> 00:23:10,420
،في الحلقة القادمة: القتال الأفضل
!!"تشانّارو"

219
00:23:10,750 --> 00:23:13,820
،لا يمكنني التّراجع في هذا النّزال
!حتى لو كان آخر شيء أقوم به