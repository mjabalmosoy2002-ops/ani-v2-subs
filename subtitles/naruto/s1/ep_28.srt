1
00:01:43,490 --> 00:01:48,290
!بدأ امتحان التشونين الثّاني الآن

2
00:01:52,210 --> 00:01:53,340
!ابحثا عن أولئك الأشقياء

3
00:01:53,710 --> 00:01:55,130
أولئك الثّلاثة، صحيح؟

4
00:01:57,550 --> 00:02:00,050
!حسنًا! لننطلق

5
00:02:09,650 --> 00:02:14,190
.حسنًا! أوّلاً، سنبحث عن ذلك الشّيء
أيمكنك ذلك يا هيناتا؟

6
00:02:14,190 --> 00:02:15,070
.نعم

7
00:02:17,070 --> 00:02:20,070
.تروَّ يا لي! لقد بدأنا للتّوّ

8
00:02:20,700 --> 00:02:22,990
...أعلم ذلك. لكن

9
00:02:24,200 --> 00:02:25,910
!لا أستطيع الوقوف بلا حراك

10
00:02:25,910 --> 00:02:28,500
من يدري أيّ نوع من الخصوم
.الأقوياء بانتظارنا

11
00:02:29,040 --> 00:02:32,000
!لدينا هدف واحد كما تعرفان

12
00:02:39,180 --> 00:02:41,140
.يبدو أنّهم قد بدؤوا بالفعل

13
00:02:42,760 --> 00:02:45,770
ألم يكن ذلك صوت صراخ أحدهم للتّوّ؟

14
00:02:50,020 --> 00:02:52,770
.بـ-بدأت أشعر بالتّوتّر

15
00:02:53,150 --> 00:02:57,280
!لـ-لم يكن ذلك شيئًا. لا تقلقي يا ساكورا

16
00:02:59,740 --> 00:03:02,280
...عـ-عليّ أن أتبوّل

17
00:03:02,280 --> 00:03:04,410
!أيّها الغبيّ

18
00:03:04,740 --> 00:03:07,540
!ما الّذي تفعله في حضرة فتاة محترمة؟

19
00:03:07,540 --> 00:03:09,000
!اذهب خلف تلك الشّجيرات

20
00:03:10,960 --> 00:03:13,920
!إمّا أن تَأكل أو تُؤكل"
".ناروتو الذي أصبح طعم

21
00:03:28,140 --> 00:03:31,390
!كان ذلك كثيرًا! يا لها من راحة

22
00:03:31,770 --> 00:03:36,770
سبق وقلت لك، لا تفعل أشياء كهذه
...أمام فتاة

23
00:03:44,280 --> 00:03:48,200
مهلاً يا ساسكي... ليس عليك القيام
.بهذا مهما كان السّبب

24
00:03:50,430 --> 00:03:53,120
!لماذا فعلتَ هذا فجأة؟

25
00:03:53,740 --> 00:03:55,340
أين هو ناروتو الحقيقي؟

26
00:03:58,330 --> 00:04:00,750
!لا-لا فكرة لديّ عمّ تتحدّث عنه

27
00:04:00,750 --> 00:04:04,620
أنا أسألك عن الجرح الّذي تسبّبت
!لك به المشرفة من قبل

28
00:04:04,940 --> 00:04:08,920
كما أنّ جيب الشّوريكن خاصّتك
.موجود على ساقك اليسرى

29
00:04:09,330 --> 00:04:11,120
!يستعمل الحقيقيّ يده اليمنى

30
00:04:13,370 --> 00:04:17,850
!أنت أسوأ من ناروتو في التّحوّل أيّها المزيّف

31
00:04:18,400 --> 00:04:21,620
.يا لسوء حظّي! نلتَ منّي
...في تلك الحالة

32
00:04:23,200 --> 00:04:25,440
!من منكما يحمل اللّفيفة؟

33
00:04:25,810 --> 00:04:27,610
!سألجأ إلى القوّة إذًا

34
00:04:29,870 --> 00:04:32,570
!أسلوب النّار: تقنية زهرة العنقاء

35
00:04:38,460 --> 00:04:40,930
!يا ساسكي

36
00:04:40,930 --> 00:04:42,920
.لا بدّ أنّك تمازحني أيّها المغفّل الفاشل

37
00:04:43,700 --> 00:04:44,420
!حسنًا

38
00:04:44,420 --> 00:04:46,660
!نلت منك على حين غرّة
!يا لي من محظوظ

39
00:04:49,000 --> 00:04:50,000
!أوراق متفجّرة

40
00:04:57,100 --> 00:04:58,460
!يا لحظّي

41
00:04:58,460 --> 00:05:02,140
!سأقتلك إن تحرّكت
!سلّمني اللّفيفة بكلّ هدوء

42
00:05:03,100 --> 00:05:04,050
!ساسكي

43
00:05:11,300 --> 00:05:12,340
!لن أسمح لك بالفرار

44
00:05:13,070 --> 00:05:15,810
!أ-أنت متأخّر دائمًا يا ناروتو

45
00:05:18,300 --> 00:05:19,880
!سأتحكّم به بالتشاكرا

46
00:05:34,740 --> 00:05:35,770
...ساسكي

47
00:05:36,060 --> 00:05:37,760
!لا تقفي هناك يا ساكورا

48
00:05:37,760 --> 00:05:39,620
!من المستحيل أن يكون قد أتى وحده

49
00:05:40,570 --> 00:05:41,470
!أفهمتِ؟

50
00:05:41,470 --> 00:05:43,550
...إن أرخيت دفاعاتك، فستُقتلين

51
00:05:45,740 --> 00:05:48,030
!يا لسوء حظّي

52
00:05:48,030 --> 00:05:51,120
،أتيت وحدي لأخفي حضوري
...لكنّ ذلك لم يكن في صالحي

53
00:05:57,260 --> 00:05:58,210
لقد هرب إذًا؟

54
00:06:05,200 --> 00:06:07,500
،إن حدث وافترقنا عن بعضنا

55
00:06:07,500 --> 00:06:09,980
فلا يجب علينا أن نثق في أحد
.وإن كان يشبهنا

56
00:06:11,130 --> 00:06:15,140
هنالك احتمال أنّ العدوّ قد يتحوّل
!للتّقرّب منّا كما حدث للتّوّ

57
00:06:15,410 --> 00:06:16,230
.نعم

58
00:06:16,230 --> 00:06:17,750
ماذا نفعل إذًا؟

59
00:06:18,870 --> 00:06:20,510
.سنتّفق على كلمة سرّ

60
00:06:20,510 --> 00:06:22,720
كلمة سرّ؟

61
00:06:23,100 --> 00:06:28,850
،اسمعا، إن كانت كلمة السّرّ غير صحيحة
...فلا يهمّ كيف يبدو

62
00:06:29,570 --> 00:06:31,080
!علينا أن نفترض أنّه العدوّ

63
00:06:32,200 --> 00:06:35,050
.سأقولها مرّة واحدة فقط، فاستمعا جيّدًا

64
00:06:35,860 --> 00:06:38,110
"ستسألان "متى تحين فرصة النّينجا؟

65
00:06:38,700 --> 00:06:40,350
:وسيكون الجواب هو التّالي

66
00:06:41,330 --> 00:06:44,020
على النّينجا أن يتسلّل عندما يكون"
".عددًا كبيرًا من العدوّ في خلاف

67
00:06:44,470 --> 00:06:46,980
".لا يوجد مخابئ سرّيّة في المكان الصّامت"

68
00:06:47,660 --> 00:06:50,730
".من المهمّ للشّينوبي أن يعرف الوقت المناسب"

69
00:06:51,170 --> 00:06:53,940
الوقت الّذي يكون فيه العدوّ"
".متعبًا ودفاعاته مكشوفة

70
00:06:54,260 --> 00:06:55,180
.هذا كلّ شيء

71
00:06:55,800 --> 00:06:56,750
!مفهوم

72
00:06:58,560 --> 00:07:00,730
هلاّ كرّرت ذلك ثانية؟

73
00:07:02,170 --> 00:07:04,040
.أخبرتك أنّني سأقولها مرّة واحدة

74
00:07:04,460 --> 00:07:07,250
أيعقل أنّك لم تستطع حفظها؟

75
00:07:07,630 --> 00:07:08,970
!يا لك من غبيّ

76
00:07:09,470 --> 00:07:11,270
!حفظتها في الحين

77
00:07:11,270 --> 00:07:14,610
!لـ-لقد حفظتها بشكل مثاليّ

78
00:07:14,610 --> 00:07:19,200
قلت في نفسي ربّما عليّ سماعها
...ثانية من باب الحيطة

79
00:07:19,200 --> 00:07:21,150
!سأحمل أنا اللّفيفة

80
00:07:22,100 --> 00:07:23,680
.مهلاً يا ساسكي

81
00:07:23,680 --> 00:07:24,780
!هذا مؤلم

82
00:07:28,530 --> 00:07:29,580
ما كان هذا؟

83
00:07:39,030 --> 00:07:39,770
!عدوّ جديد؟

84
00:07:48,870 --> 00:07:52,440
.اذهبا أنتما للّهو في مكان ما

85
00:07:53,360 --> 00:07:55,580
.سأهتمّ بهذا الأمر وحدي

86
00:08:08,400 --> 00:08:09,440
!ساكورا

87
00:08:09,440 --> 00:08:10,670
!ساسكي

88
00:08:10,670 --> 00:08:11,950
!لا تقتربي

89
00:08:11,950 --> 00:08:13,680
...أخبريني بكلمة السّرّ أوّلاً

90
00:08:14,130 --> 00:08:15,630
متى تحين فرصة النّينجا؟

91
00:08:15,630 --> 00:08:17,340
...حـ-حسنًا

92
00:08:17,340 --> 00:08:19,980
على النّينجا أن يتسلّل عندما يكون
.عددًا كبيرًا من العدوّ في خلاف

93
00:08:20,600 --> 00:08:22,650
.لا يوجد مخابئ سرّيّة في المكان الصّامت

94
00:08:23,160 --> 00:08:26,300
.من المهمّ للشّينوبي أن يعرف الوقت المناسب

95
00:08:26,300 --> 00:08:28,610
الوقت الّذي يكون فيه العدوّ
.متعبًا ودفاعاته مكشوفة

96
00:08:29,330 --> 00:08:30,350
.جيّد

97
00:08:30,350 --> 00:08:32,410
!هذا مؤلم

98
00:08:32,410 --> 00:08:34,490
يا رفيقَيّ، هل أنتما بخير؟

99
00:08:34,490 --> 00:08:36,080
!مهلاً يا ناروتو

100
00:08:36,630 --> 00:08:37,530
...كلمة السّرّ

101
00:08:37,860 --> 00:08:39,620
...أعرفها

102
00:08:39,930 --> 00:08:42,590
على النّينجا أن يتسلّل عندما يكون
.عددًا كبيرًا من العدوّ في خلاف

103
00:08:42,930 --> 00:08:45,430
.لا يوجد مخابئ سرّيّة في المكان الصّامت

104
00:08:45,430 --> 00:08:48,900
.من المهمّ للشّينوبي أن يعرف الوقت المناسب

105
00:08:48,900 --> 00:08:51,520
الوقت الّذي يكون فيه العدوّ
.متعبًا ودفاعاته مكشوفة

106
00:08:57,660 --> 00:08:59,530
!ما الّذي تفعله؟

107
00:09:00,330 --> 00:09:03,040
أرى أنّه شخص يمكنه تفادي
.هجماتي هذه المرّة

108
00:09:03,040 --> 00:09:05,340
ماذا تقول يا ساسكي؟

109
00:09:05,930 --> 00:09:08,500
.أخبرنا ناروتو بكلمة السّرّ الصّحيحة

110
00:09:08,500 --> 00:09:10,520
!المشكلة أنّه استطاع قولها

111
00:09:13,190 --> 00:09:17,330
هل تعتقدين فعلاً أنّ ذلك المغفّل
قد يتذكّر كلمة سرّ طويلة هكذا؟

112
00:09:19,070 --> 00:09:21,780
،إن سألنا ناروتو الحقيقيّ عن كلمة السّرّ

113
00:09:22,140 --> 00:09:25,280
فماذا كان ليقول في رأيك؟

114
00:09:26,300 --> 00:09:28,250
".آسف. لقد نسيتها"

115
00:09:29,670 --> 00:09:32,840
إضافة لذلك، بالنّظر إلى حركاته
...عندما تفادى هجومي

116
00:09:33,660 --> 00:09:35,810
!كان من الواضح أنّه ليس ناروتو

117
00:09:36,730 --> 00:09:40,650
!أرنا شكلك الحقيقيّ أيّها المزيّف

118
00:09:46,830 --> 00:09:48,580
...هكذا الأمر إذًا

119
00:09:54,930 --> 00:09:58,280
،لكن إن كنت تعرف أنّه سينساها

120
00:10:00,130 --> 00:10:03,930
لماذا لم تفكّر في كلمة سرّ أقصر؟

121
00:10:04,230 --> 00:10:10,280
كنتُ أعرف أنّك مختبئة تحت
.الأرض وتتنصّتين لمحادثتنا

122
00:10:10,770 --> 00:10:13,930
.لذلك اخترت كلمة السّرّ كل عن قصد

123
00:10:16,630 --> 00:10:20,750
مفهوم. إذًا فأنت لست متعبًا
.ولم ترخِ دفاعاتك

124
00:10:21,870 --> 00:10:24,780
.سيكون هذا أكثر متعة ممّا ظننت

125
00:10:28,330 --> 00:10:30,980
!إنّها مريبة... ومخيفة جدًّا

126
00:10:31,830 --> 00:10:34,840
وأين هو ناروتو؟

127
00:10:41,270 --> 00:10:42,940
....هذا مؤلم

128
00:10:44,560 --> 00:10:47,280
!عليّ النّهوض

129
00:10:47,730 --> 00:10:51,650
ماذا؟ أين هما ساكورا وساسكي يا ترى؟

130
00:10:54,590 --> 00:10:57,980
!إ-إنّه ضخم للغاية

131
00:10:59,830 --> 00:11:03,160
...هذه أوّل مرّة أرى فيها
!ثعبانًا بهذا الحجم الهائل

132
00:11:12,790 --> 00:11:13,790
!خلفي؟

133
00:11:16,930 --> 00:11:18,210
!هـ-هذا ذيله

134
00:11:34,430 --> 00:11:37,830
تريدان لفيفة الأرض خاصّتنا، صحيح؟

135
00:11:38,160 --> 00:11:41,480
.هذا لأنّكما تملكان لفيفة السّماء

136
00:11:38,970 --> 00:11:42,470
مكتوب على اللفافة: الأرض

137
00:11:55,700 --> 00:11:58,350
...حسنًا، لنبدأ

138
00:12:00,500 --> 00:12:03,130
.المعركة للحصول على اللّفيفة

139
00:12:05,830 --> 00:12:07,350
!معركة الحياة أو الموت

140
00:12:36,000 --> 00:12:36,930
!غينجيتسو؟

141
00:12:46,900 --> 00:12:48,200
.كلاّ، ليس كذلك

142
00:12:49,670 --> 00:12:52,430
.إنّهما مجرّد رغبة في سفك الدّماء

143
00:12:53,260 --> 00:12:54,430
ما الّذي يحدث؟

144
00:12:55,730 --> 00:12:59,330
إنّ مجرّد النّظر إلى عينيها
.جعلني أفكّر في الموت

145
00:13:03,230 --> 00:13:06,000
!من تلك... المرأة؟

146
00:13:09,370 --> 00:13:11,630
سا... ساكورا؟

147
00:13:21,090 --> 00:13:22,030
.لا فائدة

148
00:13:22,460 --> 00:13:24,060
.لا خيار آخر أمامنا سوى الهرب

149
00:13:25,900 --> 00:13:28,700
...إن لم نهرب، فإنّ كلّ ما ينتظرنا

150
00:13:31,730 --> 00:13:32,990
!هو الموت

151
00:13:35,030 --> 00:13:38,130
!أخرجني

152
00:13:38,900 --> 00:13:41,760
!هيّا... قم... ببصقي

153
00:13:43,390 --> 00:13:47,130
.سُحقًا! هذا لا ينفع

154
00:13:48,230 --> 00:13:49,990
ألديّ شيء آخر؟

155
00:13:53,130 --> 00:13:55,800
!كرة الأرزّ الّتي أحضرتها للغداء

156
00:14:06,330 --> 00:14:07,260
!لقد تحلّلت

157
00:14:07,730 --> 00:14:11,220
سيتمّ هضمي تمامًا
.ككرة الأرزّ تلك في النّهاية

158
00:14:14,430 --> 00:14:16,130
!كـ-كلاّ

159
00:14:16,560 --> 00:14:19,870
!أخرجني! هيّا أخرجني

160
00:14:26,930 --> 00:14:28,870
عاجزان عن الحركة بهذه السّرعة؟

161
00:14:31,220 --> 00:14:32,130
!ستقتلني

162
00:14:32,930 --> 00:14:35,730
!تحرّك... تحرّك... تحرّك

163
00:14:35,730 --> 00:14:36,860
!تحرّك

164
00:14:39,000 --> 00:14:41,160
!تحرّك! تحرّك

165
00:14:42,760 --> 00:14:43,960
!تحرّك

166
00:14:53,960 --> 00:14:57,900
!حتّى ولو كان قليلاً، فعليّ... أن أتحرّك

167
00:14:59,570 --> 00:15:03,260
ما الّذي تنوي فعله بذلك؟

168
00:15:08,100 --> 00:15:09,270
!لا يمكنني التّحرّك

169
00:15:10,720 --> 00:15:15,400
.لا تقلق. سأنهي هذا الأمر في لمح البصر

170
00:15:16,900 --> 00:15:19,070
.لن يكون لديك وقت حتّى للشّعور بالألم

171
00:15:32,990 --> 00:15:35,730
.أردتك أن تمتّعني لوقت أطول

172
00:15:37,400 --> 00:15:38,570
.هذا مؤسف

173
00:15:53,790 --> 00:15:57,500
هل... سأموت هنا؟

174
00:16:00,960 --> 00:16:02,460
...إيروكا سينسي

175
00:16:06,000 --> 00:16:08,430
...العجوز الهوكاغي

176
00:16:10,920 --> 00:16:12,160
...كونوهامارو

177
00:16:16,030 --> 00:16:17,460
...كاكاشي سينسي

178
00:16:20,960 --> 00:16:22,060
...ساكورا أيضًا

179
00:16:25,860 --> 00:16:26,930
.وساسكي

180
00:16:29,950 --> 00:16:33,510
.حدثت أمور عدّة بيننا

181
00:16:34,480 --> 00:16:36,780
،رغم أنّنا نتشاجر على الدّوام

182
00:16:36,780 --> 00:16:41,880
فقد تعاونّا لإنقاذ كاكاشي سينسي
.عند قتالنا ضدّ زابوزا

183
00:16:44,180 --> 00:16:47,020
،وخلال تدريب التشاكرا في الغابة

184
00:16:47,220 --> 00:16:51,440
تنافسنا ضدّ بعضنا في التّدرّب
.على تسلّق الأشجار

185
00:16:54,880 --> 00:16:57,850
...وجدتُها! لم أنهِ

186
00:16:58,280 --> 00:17:00,780
!حسابي معه بعد

187
00:17:02,850 --> 00:17:04,050
!أريد المزيد من الأرزّ

188
00:17:09,490 --> 00:17:12,150
إن لم يكن هذا الثّعبان يرغب
...في بصقي

189
00:17:12,610 --> 00:17:16,120
!فسأرغمه على ذلك مهما كلّف الأمر

190
00:17:30,780 --> 00:17:32,280
.فهمت

191
00:17:53,980 --> 00:17:55,150
!ساسكي

192
00:17:58,620 --> 00:18:01,140
...جرح نفسه في آخر لحظة

193
00:18:04,880 --> 00:18:09,290
!تحرّك. تحرّك. تحرّك. تحرّك

194
00:18:14,780 --> 00:18:16,350
!تحرّك

195
00:18:26,980 --> 00:18:29,790
.جعل الخوف يتلاشى عن طريق الألم

196
00:18:32,910 --> 00:18:36,080
كما توقّعت، إنّه ليس فريسة عاديّة

197
00:18:37,880 --> 00:18:39,690
!تقنيّة نسخ الظّلّ

198
00:18:49,620 --> 00:18:52,850
!أنا... هو الشّينوبي الّذي سيصبح الهوكاغي

199
00:18:53,350 --> 00:18:56,980
لن أقبل أن ينتهي بي المطاف
!كفضلات ثعبان في مكان كهذا

200
00:19:07,150 --> 00:19:08,350
.ساسكي

201
00:19:08,790 --> 00:19:09,720
هل أنت بخير؟

202
00:19:11,710 --> 00:19:15,780
.إن لم نهرب بسرعة، فسيُكشف مكاننا

203
00:19:16,780 --> 00:19:17,880
كيف نهرب؟

204
00:19:17,880 --> 00:19:19,350
كيف علينا أن نهرب؟

205
00:19:20,680 --> 00:19:23,710
...لم أر ساسكي من قبل

206
00:19:24,780 --> 00:19:26,350
.بهذا القلق الشّديد

207
00:19:33,450 --> 00:19:34,880
!احذر الثّعبان يا ساسكي

208
00:19:38,990 --> 00:19:43,180
سُحقًا! كنت شاردًا لدرجة
!أنّني لم ألحظ الثّعبان

209
00:19:54,710 --> 00:19:56,280
!لا تقترب منّي

210
00:20:21,880 --> 00:20:24,880
.لا ترخي دفاعاتك ولو للحظة واحدة

211
00:20:27,380 --> 00:20:32,810
دائمًا ما تظلّ الفريسة متوتّرة
...وتفكّر في الهرب بكلّ يأس

212
00:20:34,550 --> 00:20:36,850
.في مواجهة مفترسها

213
00:20:55,450 --> 00:20:57,280
.آسف يا ساسكي

214
00:21:05,050 --> 00:21:06,420
!ناروتو

215
00:21:08,790 --> 00:21:12,880
!لقد نسيت كلمة السّرّ

216
00:21:16,580 --> 00:21:21,190
هل تسمعني؟

217
00:21:21,190 --> 00:21:29,340
السماء الزرقاء الصافية ليس لأفقها حدودُ

218
00:21:30,500 --> 00:21:39,260
والبحرُ واسعٌ على مد البصر كبيرُ

219
00:21:39,620 --> 00:21:54,120
من فضلك، أبقِ هذه البسمة على محيّاك، وإلّا بكيتُ

220
00:21:54,240 --> 00:21:58,220
لستَ بعوزٍ إلى البحث من حولكْ

221
00:21:58,220 --> 00:22:11,040
فالجميع في هاتين اليدين متواجدْ

222
00:22:11,040 --> 00:22:16,040
،حتى وإن أردتَّ الهروب، حتى وإن أردتَّ البكاء

223
00:22:16,220 --> 00:22:24,520
.حتى وإن نسيتَ سعادتك، فما عليك سوى بالغناء

224
00:22:24,790 --> 00:22:32,210
وُلد النور، ثم وُلد الظلام، فاجتمعا واندمجا

225
00:22:32,220 --> 00:22:38,660
فبالأُلفة والتخاطر أحسسنا

226
00:22:39,030 --> 00:22:44,130
هل بتّ تسمعني؟

227
00:22:48,280 --> 00:22:49,800
!مهلاً، مهلاً، مهلاً

228
00:22:49,800 --> 00:22:54,640
!يبدو أنّك كنتِ تستقوين على الضّعفاء في غيابي

229
00:22:54,640 --> 00:22:59,230
،ذلك الانفجار والثّعبان الضّخم
كلّ ذلك من صنيعك، صحيح؟

230
00:22:59,230 --> 00:23:01,400
!يا لك من ثعبان وغد

231
00:23:01,400 --> 00:23:06,440
،بما أنّني أنا أوزوماكي ناروتو هنا الآن
!فسوف أمسح الأرض بك

232
00:23:07,310 --> 00:23:10,640
!في الحلقة القادمة: "هجوم ناروتو المضادّ
"!أنا لن أهرب

233
00:23:10,640 --> 00:23:12,900
!تطلّعوا قُدمًا لرؤيتي أقاتل