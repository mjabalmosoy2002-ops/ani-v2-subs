1
00:01:44,670 --> 00:01:47,310
،إن حدث وافترقنا عن بعضنا

2
00:01:47,310 --> 00:01:49,980
فلا يجب علينا أن نثق في أحد
.وإن كان يشبهنا

3
00:01:50,740 --> 00:01:54,950
هنالك احتمال أنّ العدوّ قد يتحوّل
!للتّقرّب منّا كما حدث للتّوّ

4
00:01:54,950 --> 00:01:55,850
.نعم

5
00:01:55,850 --> 00:01:57,620
ماذا نفعل إذًا؟

6
00:01:58,650 --> 00:02:00,250
.سنتّفق على كلمة سرّ

7
00:02:01,320 --> 00:02:02,660
كلمة سرّ؟

8
00:02:03,420 --> 00:02:06,460
.سأقولها مرّة واحدة فقط، فاستمعا جيّدًا

9
00:02:07,590 --> 00:02:09,360
"ستسألان "متى تحين فرصة النّينجا؟

10
00:02:09,960 --> 00:02:11,760
:وسيكون الجواب هو التّالي

11
00:02:12,730 --> 00:02:15,370
على النّينجا أن يتسلّل عندما يكون"
".عددًا كبيرًا من العدوّ في خلاف

12
00:02:15,370 --> 00:02:18,000
".لا يوجد مخابئ سرّيّة في المكان الصّامت"

13
00:02:18,640 --> 00:02:21,870
".من المهمّ للشّينوبي أن يعرف الوقت المناسب"

14
00:02:22,380 --> 00:02:25,080
الوقت الّذي يكون فيه العدوّ"
".متعبًا ودفاعاته مكشوفة

15
00:02:25,450 --> 00:02:26,480
.هذا كلّ شيء

16
00:02:27,350 --> 00:02:28,780
!إ-إنّه ضخم للغاية

17
00:02:32,790 --> 00:02:33,990
!هـ-هذا ذيله

18
00:02:40,230 --> 00:02:43,560
تريدان لفيفة الأرض خاصّتنا، صحيح؟

19
00:02:56,810 --> 00:02:59,480
...حسنًا، لنبدأ

20
00:03:01,850 --> 00:03:04,420
.المعركة للحصول على اللّفيفة

21
00:03:07,190 --> 00:03:08,790
!معركة الحياة أو الموت

22
00:03:17,560 --> 00:03:20,900
إن لم يكن هذا الثّعبان يرغب
...في بصقي

23
00:03:20,900 --> 00:03:24,340
!فسأرغمه على ذلك مهما كلّف الأمر

24
00:03:26,240 --> 00:03:28,340
!تقنيّة نسخ الظّلّ

25
00:03:35,450 --> 00:03:36,620
!لا يمكنني التّحرّك

26
00:03:40,650 --> 00:03:43,490
.أردتك أن تمتّعني لوقت أطول

27
00:03:44,920 --> 00:03:46,330
.هذا مؤسف

28
00:03:51,560 --> 00:03:52,600
!تحرّك

29
00:03:58,700 --> 00:04:01,570
.جعل الخوف يتلاشى عن طريق الألم

30
00:04:04,310 --> 00:04:07,680
كما توقّعت، إنّه ليس فريسة عاديّة

31
00:04:16,660 --> 00:04:18,220
!لا تقترب منّي

32
00:04:25,700 --> 00:04:28,600
.لا ترخي دفاعاتك ولو للحظة واحدة

33
00:04:39,010 --> 00:04:44,850
دائمًا ما تظلّ الفريسة متوتّرة
...وتفكّر في الهرب بكلّ يأس

34
00:04:46,290 --> 00:04:48,550
.في مواجهة مفترسها

35
00:04:59,970 --> 00:05:01,900
.آسف يا ساسكي

36
00:05:09,180 --> 00:05:10,710
!ناروتو

37
00:05:12,710 --> 00:05:16,820
!لقد نسيت كلمة السّرّ

38
00:05:17,550 --> 00:05:20,990
!هجوم ناروتو المضادّ"
"!أنا لن أهرب

39
00:05:29,560 --> 00:05:31,260
...لقد نسيت

40
00:05:32,300 --> 00:05:34,000
!كلمة السّرّ

41
00:05:34,800 --> 00:05:36,170
!لا بأس بذلك يا ناروتو

42
00:05:36,170 --> 00:05:37,100
!هذا رائع

43
00:05:41,010 --> 00:05:41,910
!ناروتو

44
00:05:42,210 --> 00:05:45,550
أعرف أنّك حاولت أن تبدو رائعًا
!ونويت إنقاذ حياتي، لكن لا تتدخّل

45
00:05:45,550 --> 00:05:46,310
!اهرب

46
00:05:47,310 --> 00:05:49,920
!إنّها... إنّها في مستوى مختلف تمامًا

47
00:05:50,150 --> 00:05:54,890
يبدو أنّك قد قضيت على ذلك
.الثّعبان الضّخم ببراعة يا ناروتو

48
00:05:56,020 --> 00:06:00,690
إنّها تبدو مثل ثعبان مهما
.حاولت النّظر إليها

49
00:06:06,170 --> 00:06:10,240
.هكذا إذًا، كان ذلك من صنيع هذه المرأة

50
00:06:16,040 --> 00:06:19,810
لم يتحسّن الوضع
.على الإطلاق بمجيئه لإنقاذنا

51
00:06:20,750 --> 00:06:21,880
ما العمل؟

52
00:06:22,420 --> 00:06:24,280
!مهلاً، مهلاً، مهلاً

53
00:06:24,280 --> 00:06:28,390
!يبدو أنّك كنتِ تستقوين على الضّعفاء

54
00:06:28,620 --> 00:06:31,520
،بما أنّني أنا أوزوماكي ناروتو هنا الآن

55
00:06:31,520 --> 00:06:33,490
!فسوف أمسح الأرض بك

56
00:06:33,490 --> 00:06:37,700
،هذا سيّئ! إن واصل على هذا الحال
!فسينتهي أمرنا نحن الثّلاثة

57
00:06:39,200 --> 00:06:40,630
ما العمل؟

58
00:06:47,210 --> 00:06:48,910
...ساسكي

59
00:06:57,050 --> 00:06:58,450
.لا فائدة

60
00:06:59,990 --> 00:07:01,650
.هذه هي الطّريقة الوحيدة

61
00:07:05,660 --> 00:07:06,690
.مهلاً لحظة

62
00:07:16,200 --> 00:07:18,900
،إن كانت اللّفيفة هي ما تريدين
.فسأعطيها لك

63
00:07:19,370 --> 00:07:22,880
.ها أنا أقدّمها لك، خذيها واذهبي

64
00:07:27,780 --> 00:07:30,950
!مهلاً يا ساسكي! ما الّذي تفعله؟

65
00:07:30,950 --> 00:07:33,690
لماذا تعطي اللّفيفة للعدوّ؟

66
00:07:33,920 --> 00:07:35,520
!أغلق فمك

67
00:07:35,520 --> 00:07:36,460
!ماذا؟

68
00:07:37,760 --> 00:07:41,030
.مفهوم... أنت حسّاس

69
00:07:43,960 --> 00:07:46,800
الشّيء الوحيد الّذي تتمنّاه
"الفريسة" من "المفترس"

70
00:07:46,800 --> 00:07:52,540
هو تقديم طعام آخر وأن تأمل
النجاة بحياتها، صحيح؟

71
00:08:02,110 --> 00:08:03,450
.خذيها

72
00:08:12,460 --> 00:08:14,690
!أنت! لا تتدخّل في الأمر

73
00:08:14,690 --> 00:08:16,860
!ألا تدرك الوضع الّذي نحن فيه؟

74
00:08:25,940 --> 00:08:28,510
!لماذا فعلت ذلك فجأة؟

75
00:08:41,950 --> 00:08:45,730
...بالنّسبة لي، فأنا لا أتذكّر كلمة السّرّ

76
00:08:45,960 --> 00:08:49,030
.لذلك لا أملك طريقة أخرى لأتأكّد

77
00:08:49,400 --> 00:08:52,230
أمّا أنت، فأنت مزيّف يا ساسكي، صحيح؟

78
00:08:52,230 --> 00:08:53,500
!ناروتو

79
00:08:53,500 --> 00:08:56,370
!ما الّذي تحاول أن تبدأه؟

80
00:08:56,700 --> 00:08:58,740
!اسمع أيّها المغفّل الفاشل

81
00:08:59,170 --> 00:09:00,940
!أنا هو الحقيقيّ

82
00:09:02,910 --> 00:09:03,910
.كاذب

83
00:09:06,110 --> 00:09:11,020
...هذا... هذا الجبان الغبيّ الواقف أمامي

84
00:09:11,020 --> 00:09:14,990
!ما كان أبدًا... ليكون ساسكي الّذي أعرفه

85
00:09:15,860 --> 00:09:18,960
،لا أعرف ما مدى قوّتها

86
00:09:18,960 --> 00:09:23,830
كيف لك أن تكون واثقًا تمامًا أنّها
ستتركنا وشأننا إن سلّمناها اللّفيفة؟

87
00:09:25,530 --> 00:09:29,900
أنت من تشعر بأنّك محاصر
!ولا تدرك الوضع الّذي نحن فيه

88
00:09:33,340 --> 00:09:34,610
.يا ناروتو

89
00:09:37,910 --> 00:09:39,480
.أنت على حقّ

90
00:09:42,450 --> 00:09:43,980
.اللّفيفة

91
00:09:47,120 --> 00:09:50,690
.يمكنني قتلكم والحصول عليها ببساطة

92
00:09:55,190 --> 00:09:56,600
!لا تعبثي معي

93
00:09:56,600 --> 00:09:58,560
!توقّف! اهرب يا ناروتو

94
00:09:58,760 --> 00:10:00,600
!سُحقًا

95
00:10:01,100 --> 00:10:03,300
!فقدتُ الثّقة فيك يا ساسكي

96
00:10:03,500 --> 00:10:04,970
!تقنية الاستدعاء

97
00:10:17,450 --> 00:10:18,420
!ناروتو

98
00:10:32,830 --> 00:10:34,770
.هنالك ثلاث جثث

99
00:10:35,700 --> 00:10:39,540
هذا نينجيتسو من نوع ما، صحيح؟

100
00:10:39,540 --> 00:10:42,740
.هذا سيّئ

101
00:10:46,010 --> 00:10:49,120
.لدينا مشكلة من البداية

102
00:10:49,120 --> 00:10:50,580
.يا إلهي

103
00:10:56,420 --> 00:10:59,530
أعلم المشرفة على الامتحان
.الثّاني الآنسة آنكو

104
00:10:59,530 --> 00:11:00,690
!حاضر

105
00:11:05,670 --> 00:11:09,870
لا يجوز تناول الزلابية من دون شرب
.حساء الفاصولياء الحمراء الحلوة معها

106
00:11:12,670 --> 00:11:16,410
،حسنًا... بمجرّد تناولي لهذا

107
00:11:16,410 --> 00:11:20,350
سأنطلق في طريقي وأنتظر
.أولئك الأطفال في البرج

108
00:11:21,480 --> 00:11:26,990
حسب هذا البرنامج، فإنّ الأطفال
.السّريعين سينتهون باكرًا

109
00:11:28,050 --> 00:11:30,460
!علامة قرية ورق الشّجر، ممتاز

110
00:11:35,700 --> 00:11:38,100
!لدينا مشكلة يا سيّدة آنكو

111
00:11:39,430 --> 00:11:41,200
ما هذه المشكلة المفاجئة؟

112
00:11:41,200 --> 00:11:43,240
!إنّها جثث! ثلاث جثث

113
00:11:46,240 --> 00:11:47,770
.إضافة إلى أنّها غريبة

114
00:11:47,770 --> 00:11:49,780
!تعالي معي رجاءً على أيّ حال

115
00:11:52,310 --> 00:11:53,880
غريبة؟

116
00:12:01,690 --> 00:12:04,590
،تحقّقت من مقتنياتهم وهويّاتهم

117
00:12:04,590 --> 00:12:10,000
إنّهم نينجا من قرية العشب مسجّلون
...لاجتيار امتحانات التشونين، لكن

118
00:12:10,700 --> 00:12:12,060
...فكما ترين

119
00:12:15,030 --> 00:12:16,300
.لا وجوه لهم

120
00:12:19,070 --> 00:12:19,940
.نعم

121
00:12:21,040 --> 00:12:24,740
تبدو وجوههم مسطّحة
.وكأنّه قد تمّ إذابتها

122
00:12:29,050 --> 00:12:30,580
.لا مجال للشّكّ

123
00:12:31,380 --> 00:12:33,050
...هذه التّقنية

124
00:12:35,150 --> 00:12:36,860
...لذلك الرّجل

125
00:12:38,220 --> 00:12:40,390
لماذا هو في هذا الامتحان؟

126
00:13:05,310 --> 00:13:08,380
أرني صور هويّات هؤلاء النّينجا
.الثّلاثة من قرية العشب

127
00:13:08,380 --> 00:13:09,850
.إنّها على استماراتهم

128
00:13:09,850 --> 00:13:10,880
!في الحال

129
00:13:13,780 --> 00:13:15,750
.إذًا فقد سُرق وجه هذه

130
00:13:17,990 --> 00:13:20,290
...مهلاً، لقد كان هو بالفعل حينها

131
00:13:22,160 --> 00:13:25,330
.أتيتُ أعيد لك الكوناي خاصّتك

132
00:13:25,330 --> 00:13:27,230
.شكرًا على تكبّدكِ عناء ذلك

133
00:13:31,730 --> 00:13:33,270
.نحن في ورطة كبيرة

134
00:13:34,170 --> 00:13:38,140
!أبلغوا الهوكاغي-ساما بهذا في الحال

135
00:13:38,140 --> 00:13:43,650
واطلبوا أيضًا تحرّك الآنبو لتوفير
!أكثر من فرقتين لغابة الموت

136
00:13:43,650 --> 00:13:46,880
سوف أبدأ بملاحقة هؤلاء النينجا
بدءًا من الآن! مفهوم؟

137
00:13:46,880 --> 00:13:47,620
!نعم

138
00:13:52,020 --> 00:13:53,260
...ذلك الرّجل

139
00:13:53,890 --> 00:13:56,290
!ذلك الرّجل... قد عاد لقرية ورق لشّحر

140
00:14:10,170 --> 00:14:11,740
.ظريف

141
00:14:12,240 --> 00:14:14,780
.يا لك من فريسة ظريفة

142
00:14:19,950 --> 00:14:22,420
!ناروتو

143
00:14:31,760 --> 00:14:34,500
.هيّا، التقط وجبتك

144
00:14:50,750 --> 00:14:52,920
!أغلقي فمك

145
00:15:03,990 --> 00:15:06,130
...هذا الفتى! لا يمكن

146
00:15:15,040 --> 00:15:17,670
...ناروتو... لقد فقد رشده

147
00:15:17,670 --> 00:15:22,010
!لكن لماذا ناروتو بهذه القوّة؟

148
00:15:43,270 --> 00:15:44,400
...هاتان العينان

149
00:15:44,400 --> 00:15:46,400
.لا مجال للشّكّ

150
00:15:47,570 --> 00:15:49,870
!ذلك هو... ناروتو؟

151
00:15:51,640 --> 00:15:53,610
.أصبح الوضع أكثر إثارة

152
00:15:54,780 --> 00:15:55,850
...التّالي

153
00:15:58,080 --> 00:15:59,450
.هو ساسكي

154
00:15:59,880 --> 00:16:01,820
!كيف ستردّ الآن؟

155
00:16:08,620 --> 00:16:10,030
!ساسكي

156
00:16:21,570 --> 00:16:22,970
.عليّ أن أسرع

157
00:16:25,110 --> 00:16:26,180
...يراودني

158
00:16:27,940 --> 00:16:29,550
.إحساس سيّئ

159
00:16:48,200 --> 00:16:52,270
...أخبرني... هل تأذّيت

160
00:16:57,740 --> 00:16:59,340
!أيّها الجبان؟

161
00:17:08,250 --> 00:17:09,620
!ناروتو

162
00:17:11,050 --> 00:17:12,120
!أخبرني

163
00:17:13,260 --> 00:17:15,290
...هل تأذّيت

164
00:17:16,830 --> 00:17:18,030
أيّها الجبان؟

165
00:17:22,000 --> 00:17:23,500
!ساسكي

166
00:17:27,470 --> 00:17:33,940
هذا الجبان الغبيّ هو قطعًا
!ليس ساسكي الّذي أعرفه

167
00:17:44,090 --> 00:17:47,790
!أيّتها الحقيرة! سُحقًا، أطلقي سراحي

168
00:17:47,790 --> 00:17:49,090
!أفعى حقيرة

169
00:17:51,830 --> 00:17:56,400
.لا أصدّق أن فتى الكيوبي حيّ يُرزق

170
00:18:00,100 --> 00:18:05,040
عندما تتحمّس كثيرًا، تتسرّب بعض
.قوّة الكيوبي قليلاً

171
00:18:10,010 --> 00:18:13,050
.كبرت وأصبحت مثيرًا للاهتمام

172
00:18:15,850 --> 00:18:16,720
...انظروا لهذا

173
00:18:17,250 --> 00:18:19,690
.الختم ظاهر فوق جلدك وكأنّه وشم

174
00:18:24,060 --> 00:18:27,360
!ختم العناصر الخمسة

175
00:18:38,710 --> 00:18:40,780
!ساسكي! ساعد ناروتو

176
00:18:51,450 --> 00:18:53,390
...مرّت اثنا عشر سنة على الختم

177
00:18:53,960 --> 00:18:59,190
تشاكرا ناروتو وتشاكرا الكيوبي
...قد بدأتا تتزامنان معًا

178
00:19:04,170 --> 00:19:07,900
.لكن الآن... أنت تقف في طريقي

179
00:19:13,040 --> 00:19:15,280
!سوف يسقط على هذا الحال

180
00:19:15,580 --> 00:19:17,150
!ناروتو

181
00:19:20,280 --> 00:19:22,320
!ماذا حدث يا ساسكي؟

182
00:19:26,260 --> 00:19:27,720
...ساسكي

183
00:19:33,930 --> 00:19:37,570
إنّ ناروتو مختلف عنك بكلّ
.تأكيد يا ساسكي

184
00:19:37,570 --> 00:19:40,500
.إنّه أخرق ويعيق طريقنا أحيانًا

185
00:19:40,940 --> 00:19:44,010
!لكنّه ليس جبانًا على الإطلاق

186
00:19:44,010 --> 00:19:46,480
أخبرني، هل كلامي صحيح؟

187
00:19:53,920 --> 00:19:56,190
.يا لحمقك يا أخي الصّغير

188
00:19:56,890 --> 00:20:01,990
...إن أردتَ قتلي، اكرهني، امقُتني

189
00:20:01,990 --> 00:20:05,790
.وواصل عيش حياتك البشعة

190
00:20:06,200 --> 00:20:07,230
.اهرب

191
00:20:07,230 --> 00:20:11,470
.اهرب وتشبّث بالحياة

192
00:20:14,440 --> 00:20:15,900
!كلاّ

193
00:20:24,780 --> 00:20:30,290
،هذا ما توقّعتُه من عشيرة الأوتشيها
...بدأت دماؤه تغلي

194
00:20:34,020 --> 00:20:35,460
!ساسكي

195
00:20:39,380 --> 00:20:43,310
ينبغي أن أستغرق وقتي وأتأكد من قوته الحقيقية

196
00:21:17,790 --> 00:21:22,420
هل تسمعني؟

197
00:21:22,420 --> 00:21:30,560
السماء الزرقاء الصافية ليس لأفقها حدودُ

198
00:21:31,720 --> 00:21:40,480
والبحرُ واسعٌ على مد البصر كبيرُ

199
00:21:40,820 --> 00:21:55,330
من فضلك، أبقِ هذه البسمة على محيّاك، وإلّا بكيتُ

200
00:21:55,460 --> 00:21:59,420
لستَ بعوزٍ إلى البحث من حولكْ

201
00:21:59,420 --> 00:22:12,260
فالجميع في هاتين اليدين متواجدْ

202
00:22:12,260 --> 00:22:17,270
،حتى وإن أردتَّ الهروب، حتى وإن أردتَّ البكاء

203
00:22:17,440 --> 00:22:25,740
.حتى وإن نسيتَ سعادتك، فما عليك سوى بالغناء

204
00:22:25,990 --> 00:22:33,410
وُلد النور، ثم وُلد الظلام، فاجتمعا واندمجا

205
00:22:33,450 --> 00:22:39,880
فبالأُلفة والتخاطر أحسسنا

206
00:22:40,250 --> 00:22:45,340
هل بتّ تسمعني؟

207
00:22:50,060 --> 00:22:51,530
.أنا منتقم

208
00:22:51,770 --> 00:22:55,140
عليّ أن أنجو اليوم
!إن أردتُ هزيمة أخي

209
00:22:55,600 --> 00:22:59,410
لكن كيف لمرء ما كان ليخاطر
...بحياته في وضع كهذا

210
00:22:59,710 --> 00:23:01,610
أن يهزم أخاه؟

211
00:23:02,480 --> 00:23:04,610
.اهدأ، عليك أن تكون قادرًا على الرّؤية

212
00:23:04,950 --> 00:23:06,950
.لا بدّ من طريقة ما لصدّ حركاتها

213
00:23:08,450 --> 00:23:12,990
!في الحلقة القادمة: "إحياء الشّارينغان
"!أسلوب النّار: تقنية لهب التّنّين