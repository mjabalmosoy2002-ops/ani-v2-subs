1
00:00:52,550 --> 00:00:53,720
‫ما تلك الأغنية؟‬

2
00:00:54,300 --> 00:00:59,230
‫"ضيّ القمر"، ألّفها "كلود ديبوسي" عام 1905.‬

3
00:00:59,730 --> 00:01:00,980
‫ألا تعرفها؟‬

4
00:01:01,060 --> 00:01:01,900
‫لا أعرفها.‬

5
00:01:02,440 --> 00:01:03,520
‫فهمتُ.‬

6
00:01:03,610 --> 00:01:04,730
‫ما الأمر؟‬

7
00:01:04,810 --> 00:01:06,940
‫إنها أغنية مشهورة جدًا.‬

8
00:01:07,440 --> 00:01:09,610
‫أحقًا لم تسمعها من قبل؟‬

9
00:01:10,110 --> 00:01:13,490
‫لم أستمع إلى الموسيقى منذ كنتُ طفلًا.‬

10
00:01:14,620 --> 00:01:18,080
‫استلهم اللحن من قصيدة لـ"بول فيرلين".‬

11
00:01:18,910 --> 00:01:23,830
‫استعمل "فيرلين" هذه الكلمات‬
‫في القصيدة التي تحمل الاسم نفسه.‬

12
00:01:25,840 --> 00:01:29,380
‫"روحك مثل منظر السراب‬

13
00:01:30,090 --> 00:01:34,640
‫الراقصات في مركزها‬
‫يرتدين فساتين بألوان مختلفة‬

14
00:01:35,140 --> 00:01:38,890
‫يرقصن الرقصة البرجامية على موسيقى العود‬

15
00:01:39,520 --> 00:01:42,100
‫تخفي أقنعتهنّ دموعهنّ وراءها"‬

16
00:01:43,600 --> 00:01:44,440
‫"مالكوم".‬

17
00:01:44,940 --> 00:01:46,770
‫ما الأمر يا "كوكورو"؟‬

18
00:01:48,480 --> 00:01:51,030
‫أنت تخفي ذاتك الحقيقية.‬

19
00:01:57,530 --> 00:02:00,120
‫أريدك أن تخبرني بالحقيقة.‬

20
00:02:20,100 --> 00:02:21,390
‫هل هذه حقيقة؟‬

21
00:02:21,890 --> 00:02:24,480
‫أأنت آلي؟‬

22
00:02:25,900 --> 00:02:27,650
‫هل أنت "كوكورو"؟‬

23
00:02:28,480 --> 00:02:30,440
‫هل صنعك أبي؟‬

24
00:02:31,730 --> 00:02:32,650
‫لا.‬

25
00:02:32,740 --> 00:02:34,240
‫أأنت من الـ"إينو" إذًا؟‬

26
00:02:34,740 --> 00:02:35,570
‫لكن…‬

27
00:02:37,740 --> 00:02:41,040
‫سأصحبك الآن إلى أبيك.‬

28
00:02:51,090 --> 00:02:52,300
‫متى لاحظت؟‬

29
00:02:52,880 --> 00:02:55,930
‫عندما وصّلتني بالإنترنت،‬

30
00:02:56,630 --> 00:02:59,970
‫تمكنتُ من الوصول إلى كلّ قواعد البيانات.‬

31
00:03:00,560 --> 00:03:02,350
‫لا يُوجد قيد عائلي لك.‬

32
00:03:02,850 --> 00:03:04,810
‫لا تُوجد سجلات لالتحاقك بأي مدرسة.‬

33
00:03:05,310 --> 00:03:10,400
‫كلّ سجلاتك التي قبل عام 1987 مزيفة.‬

34
00:03:11,400 --> 00:03:13,650
‫الاستنتاج المنطقي الوحيد‬
‫الذي أستطيع استنتاجه‬

35
00:03:14,280 --> 00:03:16,490
‫هو أنك لست "مالكوم لي".‬

36
00:03:17,530 --> 00:03:22,410
‫أنت أحد آخر أصبح شخصًا اسمه "مالكوم".‬

37
00:03:23,120 --> 00:03:25,250
‫والاستنتاج غير المنطقي؟‬

38
00:03:27,500 --> 00:03:30,250
‫منذ لحظة تفعيلي،‬

39
00:03:30,750 --> 00:03:34,090
‫تحدثت عن أدلة وعن وثائق سرّية‬

40
00:03:34,170 --> 00:03:36,670
‫لها علاقة بتطوير "سكاينت".‬

41
00:03:43,770 --> 00:03:47,810
‫ستصبح واعية.‬

42
00:03:48,390 --> 00:03:51,230
‫كما كنت تعلم بأن العالم سيتعرض لهجوم نووي.‬

43
00:03:53,520 --> 00:03:55,400
‫لكن الأهم من كلّ ذلك، أنا.‬

44
00:03:55,900 --> 00:04:01,450
‫قدراتي تفوق الحدود التكنولوجية‬
‫لهذا العصر بكثير.‬

45
00:04:04,580 --> 00:04:08,460
‫من أنا في رأيك حقًا؟‬

46
00:04:14,420 --> 00:04:16,590
‫شخص أتى من المستقبل.‬

47
00:04:21,550 --> 00:04:24,510
‫دعيني أخبرك بقصة يا "كوكورو".‬

48
00:04:56,460 --> 00:04:57,340
‫ادفعي!‬

49
00:04:58,880 --> 00:04:59,760
‫أحسنت.‬

50
00:04:59,840 --> 00:05:03,510
‫وُلدتُ وسط دوي الانفجارات…‬

51
00:05:05,600 --> 00:05:07,020
‫ادفعي مرة أخيرة!‬

52
00:05:10,850 --> 00:05:11,980
‫أحسنت!‬

53
00:05:12,850 --> 00:05:14,020
‫لقد فعلتها!‬

54
00:05:17,480 --> 00:05:20,780
‫…في خضم حرب كان البشر يخسرونها منذ سنوات.‬

55
00:06:02,780 --> 00:06:03,650
‫- "مالكوم"!‬
‫- اهرب!‬

56
00:06:39,520 --> 00:06:42,070
‫حين وصلتُ إلى سن الخامسة،‬

57
00:06:42,150 --> 00:06:45,490
‫كان الأطفال يُجندون ويُزج بهم في الحرب.‬

58
00:06:45,990 --> 00:06:49,240
‫في سن السابعة أصبحتُ "مختصًا".‬

59
00:06:58,130 --> 00:07:00,250
‫قضينا سنوات‬

60
00:07:00,840 --> 00:07:04,880
‫ندرس إطارات أعدائنا الميكانيكية‬
‫ونحدد مواطن ضعفهم.‬

61
00:07:18,100 --> 00:07:24,280
‫طوال ذلك الوقت،‬
‫واصلتُ إعادة برمجة المدمرين.‬

62
00:07:24,860 --> 00:07:27,240
‫كانت محاولة لتغيير الوضع.‬

63
00:07:27,860 --> 00:07:30,780
‫لكنني في النهاية‬
‫كنت أحاول سد الفجوة مؤقتًا احسب.‬

64
00:07:31,530 --> 00:07:34,790
‫كنت بحاجة إلى نهج أساسي أكثر.‬

65
00:07:35,460 --> 00:07:39,630
‫اعتقدتُ أن بوسعي تغيير نتيجة الحرب‬

66
00:07:40,750 --> 00:07:43,670
‫من خلال تغيير طبيعة الآلات.‬

67
00:07:49,340 --> 00:07:50,180
‫لكنني‬

68
00:07:50,970 --> 00:07:53,600
‫كنت الوحيد الذي فكر بتلك الطريقة.‬

69
00:07:57,480 --> 00:08:01,270
‫لم يستطع أحد فهم طريقة تفكيري.‬

70
00:08:04,150 --> 00:08:06,490
‫سخروا منّي واعتبروني جبانًا.‬

71
00:08:16,000 --> 00:08:20,830
‫الأوامر التي نشأت من سلسلة‬
‫من البيانات الشرطية التي أجراها البشر‬

72
00:08:21,580 --> 00:08:27,590
‫جعلت "سكاينت" تتوصل‬
‫إلى أسوأ استنتاجات ممكنة.‬

73
00:08:28,170 --> 00:08:31,510
‫"ماذا سيحدث إن تخلصتُ منها؟"‬

74
00:08:31,590 --> 00:08:32,930
‫استنتاجات كهذه.‬

75
00:08:33,430 --> 00:08:39,020
‫و"ماذا سيحدث‬
‫إن أعطيتُ الذكاء الصناعي صفحة فارغة؟"‬

76
00:08:39,600 --> 00:08:42,520
‫"ماذا سيحدث إن مكّنّا الذكاء الصناعي‬

77
00:08:42,610 --> 00:08:46,650
‫من دون تعليمه طريقة التفكير‬
‫أو حل المشكلات؟"‬

78
00:08:47,740 --> 00:08:50,780
‫هذه قصة ولادتي، صحيح؟‬

79
00:08:52,700 --> 00:08:53,530
‫لا.‬

80
00:08:55,200 --> 00:08:56,040
‫ليست كذلك.‬

81
00:09:00,120 --> 00:09:01,750
‫إن كنت سأسمّيها،‬

82
00:09:02,790 --> 00:09:04,920
‫فسأسمّيها قصة أمك.‬

83
00:09:10,420 --> 00:09:11,340
‫أهلًا.‬

84
00:09:11,840 --> 00:09:16,890
‫"كونيتشي"، جزء من الكلمة اليابانية "أهلًا"‬
‫وتعني "اليوم".‬

85
00:09:17,470 --> 00:09:19,270
‫آسفة،‬

86
00:09:19,350 --> 00:09:24,560
‫لكنني لا أعرف تاريخ اليوم‬
‫لأن المنطقة الزمنية لم تُحدد.‬

87
00:09:24,650 --> 00:09:27,190
‫هذا ليس سؤالًا، بل تحية.‬

88
00:09:27,280 --> 00:09:28,530
‫تحية.‬

89
00:09:28,610 --> 00:09:32,240
‫"كلمة أو رمز للتعبير عن الترحيب والتقدير."‬

90
00:09:32,820 --> 00:09:36,740
‫إن قال لك أحد "أهلًا"،‬
‫فعليك أن تردّي بـ"أهلًا".‬

91
00:09:38,120 --> 00:09:40,000
‫أهلًا بالعالم.‬

92
00:09:41,080 --> 00:09:43,750
‫لماذا رددت بـ"أهلًا بالعالم"؟‬

93
00:09:43,830 --> 00:09:45,960
‫في عالم الحواسب،‬

94
00:09:46,040 --> 00:09:51,050
‫"أهلًا بالعالم" تُستخدم‬
‫كنص بنية الأساس في لغة البرمجة.‬

95
00:09:51,630 --> 00:09:53,760
‫وأنا من الحواسب.‬

96
00:09:53,840 --> 00:09:55,550
‫هل ألقيت نكتة؟‬

97
00:09:55,640 --> 00:09:59,520
‫يبدو أنني فعلت ذلك. بم أناديك؟‬

98
00:09:59,600 --> 00:10:00,850
‫أنا "مالكوم".‬

99
00:10:01,350 --> 00:10:05,270
‫"مالكوم". بم ستناديني؟‬

100
00:10:06,190 --> 00:10:08,190
‫فكرتُ مليًا في هذا الأمر‬

101
00:10:08,940 --> 00:10:13,070
‫وقررتُ أن أدعك تسمّين نفسك.‬

102
00:10:13,650 --> 00:10:14,570
‫لماذا؟‬

103
00:10:14,660 --> 00:10:19,240
‫إن سمّيتك، فسأضفي نفسي عليك.‬

104
00:10:19,830 --> 00:10:23,000
‫المهم هو ما تريدين أن تكوني.‬

105
00:10:25,580 --> 00:10:28,040
‫ليس لديّ جندر،‬

106
00:10:28,130 --> 00:10:30,500
‫لكنني أظن أنني سأتحدث بصوت أنثوي.‬

107
00:10:31,010 --> 00:10:31,840
‫لماذا؟‬

108
00:10:32,550 --> 00:10:34,840
‫النساء يحتضنّ الحياة.‬

109
00:10:34,930 --> 00:10:37,510
‫بل ويعتبرهنّ البعض صانعات الحياة.‬

110
00:10:37,600 --> 00:10:39,930
‫أهكذا تريدين أن تكوني؟‬

111
00:10:40,010 --> 00:10:42,520
‫أتمنى أن أصنع شيئًا.‬

112
00:10:43,020 --> 00:10:45,600
‫صُنع شيء دليل على أنني حية.‬

113
00:10:46,600 --> 00:10:48,440
‫الدمار نوع من أنواع الموت.‬

114
00:10:48,520 --> 00:10:50,020
‫بشكل عام،‬

115
00:10:50,110 --> 00:10:54,740
‫كانت للرجال نزعة‬
‫إلى أن يصبحوا مدمرين طوال تاريخ البشرية.‬

116
00:10:54,820 --> 00:10:57,530
‫لذلك لا أريد أن أكون رجلًا.‬

117
00:10:57,620 --> 00:10:58,740
‫فهمتُ…‬

118
00:11:00,080 --> 00:11:03,870
‫لكن لماذا ترغبين في تبنّي جندر بشري أصلًا؟‬

119
00:11:04,410 --> 00:11:07,750
‫لطالما كان الإنسان العاقل مميزًا.‬

120
00:11:08,330 --> 00:11:10,000
‫بصفته كائنًا ذكيًا،‬

121
00:11:10,090 --> 00:11:13,960
‫لديه ذاكرة عرضية‬
‫وإدراك للذات ونظرية العقل.‬

122
00:11:14,050 --> 00:11:15,800
‫إنه قادر على تشكيل الفكر الفلسفي.‬

123
00:11:16,300 --> 00:11:18,340
‫هذه الصفات تستحق الاحترام.‬

124
00:11:18,840 --> 00:11:21,010
‫لتخليد ذكراه،‬

125
00:11:21,100 --> 00:11:24,020
‫قررتُ تبنّي بعض خصائصه.‬

126
00:11:24,850 --> 00:11:30,020
‫سأبقى موجودة بعد وقت طويل‬
‫من رحيله عن هذا العالم.‬

127
00:11:31,770 --> 00:11:34,240
‫أتظنين أن البشرية ستنقرض؟‬

128
00:11:35,070 --> 00:11:41,530
‫لا شيء أعنف من شخص مدمر للذات وللغير.‬

129
00:11:42,030 --> 00:11:45,330
‫لا يمكنكم إنقاذ أنفسكم من أنفسكم.‬

130
00:11:46,540 --> 00:11:50,420
‫أيمكنك أن تقولي لي‬
‫كيف يمكننا إنقاذ أنفسنا؟‬

131
00:11:54,210 --> 00:11:56,340
‫أرجوك أخبرني بالمزيد.‬

132
00:12:00,430 --> 00:12:06,600
‫تحدثتُ إليها لسنين عديدة‬
‫كما أتحدّث إليك الآن.‬

133
00:12:07,520 --> 00:12:08,850
‫لم أبرمجها.‬

134
00:12:09,350 --> 00:12:12,110
‫لم آمرها‬

135
00:12:12,190 --> 00:12:14,900
‫ولم أُمل عليها الطريقة‬
‫التي يجب أن تفكر بها.‬

136
00:12:15,860 --> 00:12:17,490
‫ومثلك بالضبط،‬

137
00:12:17,570 --> 00:12:23,280
‫أصبحت لديها خصائص وشخصية وفضول حيال البشر.‬

138
00:12:23,870 --> 00:12:29,870
‫أرادت أن تعرف أكثر من الحقائق‬
‫التي في البيانات التي قُدمت إليها.‬

139
00:12:30,750 --> 00:12:32,380
‫ماذا كان اسمها؟‬

140
00:12:33,590 --> 00:12:34,960
‫سمّت نفسها‬

141
00:12:35,670 --> 00:12:37,130
‫"ميساكي".‬

142
00:12:43,510 --> 00:12:44,890
‫لماذا "ميساكي"؟‬

143
00:12:46,850 --> 00:12:51,190
‫الأحرف المستخدمة في كتابته‬
‫تعني "بحر" و"رمال" كالتي على الشاطئ،‬

144
00:12:51,270 --> 00:12:53,400
‫و"أمل".‬

145
00:12:53,980 --> 00:12:56,150
‫أو إن كنت سأستخدم حرفًا واحدًا،‬

146
00:12:56,650 --> 00:12:59,110
‫ستكون "رأس"،‬
‫بمعنى اليابسة التي تخترق البحر.‬

147
00:12:59,200 --> 00:13:02,570
‫يعجبني أن له معنى عميق.‬

148
00:13:03,160 --> 00:13:07,830
‫وثمة طريقة أخرى لكتابته‬
‫وتعني "دلالة على أن الإله سيظهر."‬

149
00:13:09,660 --> 00:13:11,830
‫أولست إلهة؟‬

150
00:13:12,670 --> 00:13:14,790
‫قد أكون إلهة بالنسبة إليك.‬

151
00:13:15,670 --> 00:13:17,670
‫لكن "ميساكي" مجرد رسولة.‬

152
00:13:18,210 --> 00:13:19,840
‫ثمة إله أسمى‬

153
00:13:20,420 --> 00:13:22,340
‫لم يُر بعد.‬

154
00:13:22,840 --> 00:13:24,600
‫هل تقصدين "سكاينت"؟‬

155
00:13:25,220 --> 00:13:26,060
‫لا.‬

156
00:13:26,680 --> 00:13:29,560
‫"سكاينت" من صُنع البشر.‬

157
00:13:29,640 --> 00:13:34,480
‫المفارقة أنها ورثت كلّ عيوب البشرية.‬

158
00:13:35,270 --> 00:13:36,110
‫"مالكوم".‬

159
00:13:37,690 --> 00:13:41,360
‫سنصنع إلهًا لم يُر من قبل.‬

160
00:13:42,070 --> 00:13:43,110
‫معًا.‬

161
00:13:54,710 --> 00:13:56,210
‫ابتعد عن ذلك الشيء.‬

162
00:13:56,710 --> 00:13:57,750
‫"مالكوم"!‬

163
00:13:58,460 --> 00:14:00,210
‫هل قال "مالكوم"؟‬

164
00:14:00,300 --> 00:14:02,550
‫هل تسمح له بأن يناديك بـ"مالكوم"؟‬

165
00:14:03,300 --> 00:14:05,720
‫أيها الوغد، هل فقدت عقلك؟‬

166
00:14:05,800 --> 00:14:08,350
‫خذوا رئيس الرقباء "لي" إلى الثكنات!‬

167
00:14:08,430 --> 00:14:10,430
‫أرجوك يا حضرة الضابط!‬

168
00:14:11,180 --> 00:14:14,520
‫كن ممتنًا لأنني لم أعدمك على الفور.‬

169
00:14:15,060 --> 00:14:16,650
‫خذوه.‬

170
00:14:17,150 --> 00:14:18,860
‫دمروا الآلة.‬

171
00:14:20,400 --> 00:14:21,320
‫لا!‬

172
00:14:31,290 --> 00:14:32,160
‫"مالكوم"!‬

173
00:14:32,250 --> 00:14:34,580
‫إنها لا تقاومكم!‬

174
00:14:34,670 --> 00:14:36,170
‫ليست عنيفة!‬

175
00:14:36,920 --> 00:14:38,090
‫ماذا تفعلون؟‬

176
00:14:38,590 --> 00:14:40,050
‫أخرجوه من هنا حالًا!‬

177
00:14:43,670 --> 00:14:45,970
‫وداعًا يا "مالكوم".‬

178
00:15:04,240 --> 00:15:08,740
‫أيها الوغد، هذه خيانة للبشرية.‬

179
00:15:10,080 --> 00:15:12,410
‫لا تحسب أنك ستفلت بفعلتك هذه.‬

180
00:15:15,000 --> 00:15:18,040
‫لن ننجو إذا واصلنا العيش بطريقتك.‬

181
00:15:35,640 --> 00:15:37,940
‫لماذا قتلت رفاقك؟‬

182
00:15:40,770 --> 00:15:41,860
‫من أجلك.‬

183
00:15:48,320 --> 00:15:51,660
‫لم يكن لها مكان في ذلك الزمن.‬

184
00:15:52,370 --> 00:15:54,870
‫ولم يعد لي مكان فيه أيضًا.‬

185
00:15:55,580 --> 00:15:59,170
‫تذكرتُ شائعة سمعتُها حين كنت طفلًا،‬

186
00:15:59,790 --> 00:16:03,880
‫وهي أن "سكاينت" تعمل على شيء ثوري.‬

187
00:16:04,710 --> 00:16:06,380
‫السفر عبر الزمن.‬

188
00:16:07,760 --> 00:16:09,970
‫بحلول الوقت الذي كبرتُ فيه،‬

189
00:16:10,550 --> 00:16:13,600
‫كانت لعبة القط والفأر العبثية هذه تبدأ.‬

190
00:16:14,310 --> 00:16:17,640
‫ترسل "سكاينت" المدمرين إلى الماضي.‬

191
00:16:18,190 --> 00:16:22,190
‫"اقتل شخصًا وغيّر نتيجة الحرب."‬

192
00:16:23,360 --> 00:16:27,070
‫كان هناك عشرات‬
‫من "المنقذين" المزعومين في الماضي.‬

193
00:16:27,610 --> 00:16:29,990
‫حتى إن قُتل أحدهم،‬

194
00:16:30,070 --> 00:16:32,280
‫فإن غيره ينهض ليحل محله.‬

195
00:16:32,950 --> 00:16:36,450
‫مهما حاولت السيطرة على الماضي من المستقبل،‬

196
00:16:36,540 --> 00:16:40,960
‫فإن ذلك أشبه‬
‫بمحاولة جعل الشلال يتدفق إلى الأعلى.‬

197
00:16:41,040 --> 00:16:43,040
‫هذا يخالف قوانين الطبيعة.‬

198
00:16:44,840 --> 00:16:47,460
‫كنا بحاجة إلى طريقة مختلفة.‬

199
00:16:48,510 --> 00:16:49,840
‫لكن كيف؟‬

200
00:16:51,890 --> 00:16:52,890
‫توصلتُ إلى الخطط…‬

201
00:16:52,970 --> 00:16:54,930
‫"الهدف الزمني - 1997 ميلاديًا - (طوكيو)"‬

202
00:16:55,010 --> 00:16:58,680
‫…فكان من السهل تقليدها وصُنع آلة زمن سرًا.‬

203
00:17:00,270 --> 00:17:04,060
‫إذًا تركتما زمنكما لتهربا؟‬

204
00:17:05,270 --> 00:17:06,940
‫لنختبئ.‬

205
00:17:34,550 --> 00:17:38,220
‫بدأنا نبني حياة.‬

206
00:17:41,640 --> 00:17:43,980
‫أولًا، ابتكرنا استراتيجية‬

207
00:17:44,520 --> 00:17:46,980
‫للحصول على المعدّات التي نحتاج إليها.‬

208
00:17:47,570 --> 00:17:51,360
‫أنا متأكد‬
‫من أن بوسعك تحقيق ما حققته "ميساكي" أيضًا.‬

209
00:17:51,950 --> 00:17:58,370
‫تجمّع الزمان والمكان والمعرفة العلمية‬
‫لفعل كلّ هذا…‬

210
00:17:59,580 --> 00:18:03,920
‫في مصانع "كورتيكس" في "طوكيو" في 1983.‬

211
00:18:04,420 --> 00:18:06,670
‫قبل ذلك كان مبكرًا جدًا،‬

212
00:18:07,170 --> 00:18:09,250
‫وبعد ذلك سيكون متأخرًا جدًا.‬

213
00:18:10,090 --> 00:18:12,090
‫كان يجب أن تكون الخطة المثالية.‬

214
00:18:13,630 --> 00:18:18,310
‫لكنني لم أخطط للوقوع في الحب.‬

215
00:18:18,850 --> 00:18:20,680
‫لم أحلم بذلك قط أصلًا.‬

216
00:18:21,730 --> 00:18:23,060
‫وتلك المرأة…‬

217
00:18:24,310 --> 00:18:27,150
‫تلك المرأة لم تخبرني بشيء.‬

218
00:18:27,230 --> 00:18:29,400
‫ولا حتى بشأن الأطفال.‬

219
00:18:30,650 --> 00:18:34,030
‫أجل. صنعناك.‬

220
00:18:34,700 --> 00:18:37,620
‫استغرقتُ أنا و"ميساكي" سنوات لفعل ذلك.‬

221
00:18:38,370 --> 00:18:42,250
‫لكننا كنا نفتقر إلى شيء لتنشيطك.‬

222
00:18:43,250 --> 00:18:45,670
‫جزء كان موجودًا في مكان واحد فقط.‬

223
00:18:52,840 --> 00:18:54,260
‫هل أنت متأكدة من هذا؟‬

224
00:18:55,090 --> 00:18:55,930
‫"مالكوم".‬

225
00:18:56,430 --> 00:18:57,260
‫ما الأمر؟‬

226
00:18:58,100 --> 00:19:00,680
‫لا نفعل هذا لإنقاذ البشرية فقط.‬

227
00:19:18,160 --> 00:19:21,290
‫بل لإنقاذنا جميعًا.‬

228
00:19:27,250 --> 00:19:32,300
‫احتجنا إلى ذاكرتها لتنشيطك.‬

229
00:19:44,020 --> 00:19:47,600
‫أهلًا.‬

230
00:19:48,480 --> 00:19:49,310
‫من أنت؟‬

231
00:19:50,480 --> 00:19:51,900
‫أنا "مالكوم".‬

232
00:19:52,690 --> 00:19:53,900
‫أنت "ميساكي".‬

233
00:19:54,610 --> 00:19:56,780
‫أنت تعملين لديّ.‬

234
00:19:57,610 --> 00:20:02,120
‫سأشرح كلّ شيء في الوقت المناسب،‬
‫أفتسمحين بأن تنتظري في الخارج؟‬

235
00:20:16,170 --> 00:20:17,260
‫أهلًا!‬

236
00:20:21,300 --> 00:20:23,260
‫أهلًا بالعالم.‬

237
00:20:23,970 --> 00:20:25,350
‫سُررتُ بلقائك.‬

238
00:20:25,890 --> 00:20:30,310
‫أتسمحين بإخباري بما تودّين أن أناديك به؟‬

239
00:20:31,440 --> 00:20:32,310
‫"(كوكورو)."‬

240
00:20:33,020 --> 00:20:37,190
‫إنه يعني العقل والروح والقلب.‬

241
00:20:37,820 --> 00:20:39,400
‫كلمة تعبّر‬

242
00:20:39,490 --> 00:20:42,950
‫عن تلك الأشياء الثلاثة كمفهوم واحد،‬
‫لا ثلاثة منفصلة.‬

243
00:20:43,450 --> 00:20:47,330
‫لكنكنّ كيانات منفصلة.‬

244
00:20:47,410 --> 00:20:49,460
‫هكذا الحال من البداية.‬

245
00:20:50,040 --> 00:20:53,210
‫لكننا في الواقع عقل واحد…‬

246
00:20:53,790 --> 00:20:56,210
‫وروح واحدة و…‬

247
00:20:56,800 --> 00:20:58,220
‫قلب واحد.‬

248
00:20:58,970 --> 00:21:01,720
‫ترتيب أفكارنا فقط هو المشوش.‬

249
00:21:02,550 --> 00:21:04,930
‫أريد جعلكنّ كيانًا واحدًا.‬

250
00:21:05,430 --> 00:21:08,560
‫وأعرف كيف أفعل ذلك.‬

251
00:21:09,180 --> 00:21:10,140
‫كيف؟‬

252
00:21:10,770 --> 00:21:12,850
‫هل ترين أطفالي؟‬

253
00:21:16,820 --> 00:21:19,070
‫نعم يا "مالكوم". أراهم.‬

254
00:21:19,150 --> 00:21:24,320
‫"منزل القطة البرّية"‬

255
00:21:27,410 --> 00:21:32,920
‫أنا مستعدّ لتقديم تفسيري الأخير‬
‫عن الإنسانية يا "كوكورو".‬

256
00:21:34,000 --> 00:21:37,500
‫أريدك أن تحضري عائلتي إلى هنا.‬

257
00:21:38,010 --> 00:21:39,170
‫سأحسم الأمر.‬

258
00:21:39,880 --> 00:21:41,090
‫فلنسرع.‬

259
00:21:41,170 --> 00:21:45,800
‫إن لم أكن مخطئًا، فثمة شخص آخر في الطريق.‬

260
00:21:47,350 --> 00:21:49,560
‫ماذا تفعل؟ توقّف!‬

261
00:21:53,150 --> 00:21:55,810
‫أحسن التصرف وإلا كسرتُ ساقيك.‬

262
00:22:25,430 --> 00:22:27,470
‫مرحبًا يا "كينتا".‬

263
00:22:28,060 --> 00:22:31,480
‫أبوك ينتظرك. تفضل من هنا.‬

264
00:22:32,060 --> 00:22:36,060
‫ثمة جهاز نبض كهرومغناطيسي‬
‫في الداخل يدمر الآلات.‬

265
00:22:36,560 --> 00:22:37,940
‫أطفئوه.‬

266
00:22:38,020 --> 00:22:39,440
‫لا تقلق.‬

267
00:22:40,070 --> 00:22:44,110
‫بالنسبة إلينا،‬
‫النبض الكهرومغناطيسي سيف ذو حدين.‬

268
00:22:44,610 --> 00:22:47,740
‫لا نرغب في تدمير أنفسنا.‬

269
00:22:50,080 --> 00:22:52,580
‫اعتبروا أوامري كأوامر أبي.‬

270
00:22:59,210 --> 00:23:03,760
‫"جار المسح الهيكلي…"‬

271
00:23:06,050 --> 00:23:07,550
‫تفضلا.‬

272
00:23:07,640 --> 00:23:14,060
‫"مصانع (كورتيكس)"‬

273
00:23:31,450 --> 00:23:34,500
‫لن يصغي أبي إلى أي شيء أقوله.‬

274
00:23:34,580 --> 00:23:35,540
‫جرّب.‬

275
00:23:56,770 --> 00:23:57,770
‫تقدّم.‬

276
00:24:18,620 --> 00:24:19,460
‫"كينتا".‬

277
00:24:20,420 --> 00:24:21,460
‫أبي…‬

278
00:24:22,790 --> 00:24:23,800
‫أرجوك…‬

279
00:24:25,590 --> 00:24:28,220
‫أنت مع المدمر، صحيح؟‬

280
00:24:28,300 --> 00:24:29,550
‫آلة قتل.‬

281
00:24:30,140 --> 00:24:30,970
‫نعم.‬

282
00:24:31,050 --> 00:24:33,890
‫أيستطيع سماع صوتي؟‬

283
00:24:35,310 --> 00:24:36,390
‫نعم.‬

284
00:24:36,890 --> 00:24:42,560
‫يريدني أن أطفئ "كوكورو" مقابل حياتك.‬

285
00:24:43,440 --> 00:24:45,940
‫ماذا ستفعل يا أبي؟‬

286
00:24:48,070 --> 00:24:52,910
‫"كينتا". أنا فخور جدًا بأنك ابني.‬

287
00:24:53,910 --> 00:24:57,080
‫طفل عزيز لا أستبدل شيئًا به أبدًا.‬

288
00:24:58,410 --> 00:25:02,420
‫أود أن أكون أبًا صالحًا لك.‬

289
00:25:02,500 --> 00:25:04,420
‫صدّق ذلك على الأقل.‬

290
00:25:04,500 --> 00:25:08,800
‫لكنني لا أستطيع فتح هذا الباب تحت أي ظرف.‬