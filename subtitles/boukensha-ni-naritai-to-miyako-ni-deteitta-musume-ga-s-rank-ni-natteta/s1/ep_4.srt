1
00:00:14,630 --> 00:00:15,660
تبّاً

2
00:00:15,660 --> 00:00:17,410
كان هذا هدفهم

3
00:00:29,370 --> 00:00:32,380
كان ذلك إهمالاً منّي

4
00:00:33,570 --> 00:00:36,910
سيتعيّن عليّ التفكير بخطّةٍ أخرى

5
00:02:08,600 --> 00:02:10,720
حسناً، اصطفّوا جميعاً

6
00:02:10,720 --> 00:02:12,970
سنوزّعها بالترتيب، حسناً؟

7
00:02:12,240 --> 00:02:13,700
!أجل

8
00:02:12,970 --> 00:02:16,160
"هذا النبيذ الساخن رائجٌ في "أورفين

9
00:02:16,160 --> 00:02:20,010
تضيف هذه التوابل والعسل وتشربه دافئاً

10
00:02:20,010 --> 00:02:21,150
!بسرعة

11
00:02:20,010 --> 00:02:21,570
شكراً

12
00:02:21,570 --> 00:02:23,810
...بالطبع! وأيضاً

13
00:02:22,540 --> 00:02:23,810
!شكراً لك

14
00:02:30,070 --> 00:02:31,850
كبرتِ كثيراً

15
00:02:32,910 --> 00:02:35,110
ماذا؟ أين وضعتها؟

16
00:02:36,640 --> 00:02:38,870
بطاقة رتبة "إس"؟

17
00:02:39,170 --> 00:02:43,500
"من كان ليتصوّر أن تصل ابنتي الرتبة "إس
بينما أنهيتُ مسيرتي في الرتبة "إي"؟

18
00:02:45,150 --> 00:02:46,210
أبي؟

19
00:02:46,760 --> 00:02:47,930
ما الأمر؟

20
00:02:49,570 --> 00:02:51,410
لا، لا شيء

21
00:02:54,780 --> 00:02:57,110
...رائحة موقد النار والقشّ

22
00:02:57,110 --> 00:02:59,660
رائحتك زكيّةٌ يا أبي

23
00:03:01,050 --> 00:03:03,010
ما الذي تتكلّمين عنه؟

24
00:03:03,010 --> 00:03:05,670
لا تزالين طفلةً حتّى بعدما كبرتِ

25
00:03:05,900 --> 00:03:09,770
سأبقى ابنتك دوماً مهما كبرت يا أبي

26
00:03:12,700 --> 00:03:14,100
حسناً، تفضّلن بالدخول

27
00:03:14,100 --> 00:03:16,170
!شكراً لاستضافتنا

28
00:03:16,440 --> 00:03:19,320
أقدّر قدومكنّ إلى هنا مع أنجي

29
00:03:19,320 --> 00:03:21,170
لا بدّ أنّكما مُنهكتان من الرحلة

30
00:03:21,170 --> 00:03:25,480
كلّا، البتّة، استمتعنا بالرحلة اللطيفة

31
00:03:25,480 --> 00:03:29,220
لم يسبق وأن رأيتُ أنجي بهذا التودّد

32
00:03:29,630 --> 00:03:32,480
لا بدّ أنّكِ تحبّين أباكِ حقّاً

33
00:03:33,350 --> 00:03:38,090
!اسمعي، مضت خمسة أعوام! لا، بل ستّة

34
00:03:38,090 --> 00:03:39,840
!وصبرتُ كثيراً! أحسنت البلاء

35
00:03:40,490 --> 00:03:41,810
حسناً

36
00:03:41,810 --> 00:03:45,830
يكفي هذا، اذهبن لترتيب أغراضكنّ

37
00:03:45,830 --> 00:03:47,360
!حاضرة

38
00:03:47,360 --> 00:03:50,510
آني وميري، يمكنكما وضع أمتعتكما الآن

39
00:03:51,140 --> 00:03:53,830
سمعتُ أنّ أنجي رجعت أخيراً

40
00:03:53,830 --> 00:03:57,820
!كيري-سان! كنتُ أنوي جلب هدايا لاحقاً

41
00:03:57,820 --> 00:04:00,710
!مُذهل، كبرتِ حقّاً

42
00:04:00,710 --> 00:04:03,310
أأنتِ أنجي القصيرة تلك حقّاً؟

43
00:04:03,550 --> 00:04:09,370
ألستَ بارنز الذي خسر أمامي
في المُبارزات دوماً رغم أنّه أكبر سنّاً؟

44
00:04:10,920 --> 00:04:12,810
لا داعي لتذكري ذلك

45
00:04:13,120 --> 00:04:18,060
بالمناسبة يا كيري، أيمكنني استعارة
لحافات زائدة إن كان لديك؟

46
00:04:18,060 --> 00:04:21,520
بالطبع، تعالي لأخذها يا أنجي

47
00:04:22,590 --> 00:04:23,820
حسناً

48
00:04:27,180 --> 00:04:31,080
تفضّلا، هذا الشاي معدٌّ من أوراق
لينت" التي تُقطف في المنطقة"

49
00:04:31,080 --> 00:04:33,240
أعتذر على الفوضى التي تعمّ المكان

50
00:04:33,240 --> 00:04:36,570
البتّة، نحن نعتذر على القدوم المُفاجئ

51
00:04:36,570 --> 00:04:41,920
وبصراحة، هذا المكان مرتّب أكثر
من بيتنا، فالأمر محرجٌ نوعاً ما

52
00:04:41,920 --> 00:04:45,340
تترك أني ثيابها في أرجاء المكان

53
00:04:45,340 --> 00:04:47,080
!تلك أنتِ

54
00:04:47,080 --> 00:04:50,730
كلّا، لن أفعل ذلك أبداً

55
00:04:50,730 --> 00:04:52,710
هذا ظلمٌ يا ميري

56
00:04:53,350 --> 00:04:56,330
نعتذر على إحداث الجلبة

57
00:04:57,540 --> 00:04:59,700
تبدوان مُقرّبتان

58
00:04:59,700 --> 00:05:01,480
كما قالت أنجي

59
00:05:01,480 --> 00:05:02,540
ماذا؟

60
00:05:02,540 --> 00:05:04,650
كتبت عنكما في رسائلها

61
00:05:04,650 --> 00:05:07,960
...قالت أنّ أني-تشان فتاةٌ جادة، بينما ميري-تشان

62
00:05:09,040 --> 00:05:11,290
مهمةٌ قليلاً، لكن مسليّة

63
00:05:11,290 --> 00:05:14,240
ماذا؟ ذلك ليس صحيحاً

64
00:05:14,240 --> 00:05:16,790
يمكن أن تكون أنجي مهملة جدّاً أيضاً

65
00:05:17,920 --> 00:05:19,740
قد تكونين مُحقّة

66
00:05:19,740 --> 00:05:23,080
أشكركما على مصادقي أنجي

67
00:05:24,590 --> 00:05:29,600
أعتقد أنّكما سبب عدم
"شعورها بالوحدة في "أورفين

68
00:05:29,600 --> 00:05:30,970
أنا مُمتنّ

69
00:05:32,780 --> 00:05:34,940
هيّا، اشرباه وهو ساخن

70
00:05:35,410 --> 00:05:37,620
!شكراً على الشاي

71
00:05:37,620 --> 00:05:40,360
...بالمناسبة، في طريقنا إلى هنا

72
00:05:41,070 --> 00:05:43,710
اسمي ساشا بوردو

73
00:05:43,710 --> 00:05:47,740
شكراً لك على إنقاذ أختي الصغرى، سيرين

74
00:05:48,630 --> 00:05:50,740
أنتِ أخت سيرين؟

75
00:05:50,740 --> 00:05:54,110
أجل! التقيتُ والدكِ السيّد بيلغريف
...في يومٍ سابق

76
00:05:55,700 --> 00:05:59,240
فهمت، أنتِ هي إذاً

77
00:06:00,100 --> 00:06:04,500
آ-آنسة أنجيلين، هل قمتُ بشيءٍ ضايقك؟

78
00:06:05,350 --> 00:06:07,040
لا تتحامقي

79
00:06:07,040 --> 00:06:10,550
أعرف أنّكِ حاولتِ جرّ أبي إلى بوردو

80
00:06:10,550 --> 00:06:14,550
!لـ-لا، لم تكن تلك أنا! بل أختي الكبرى

81
00:06:15,830 --> 00:06:16,770
ماذا؟

82
00:06:16,770 --> 00:06:18,810
حسناً، يكفي

83
00:06:19,910 --> 00:06:27,290
وهكذا، كانت أختي الكبرى هيلفيتيكا هي
من سبّبت متاعباً للسيّد بيلغريف

84
00:06:27,290 --> 00:06:30,930
لا تقلقي حيال الأمر، ضايقتكِ فتاتنا الحمقاء هنا أيضاً

85
00:06:30,930 --> 00:06:32,380
اعتذري يا أنجي

86
00:06:32,820 --> 00:06:34,340
آسفة

87
00:06:34,620 --> 00:06:37,710
لا تهتمّي، يسرّني أنّنا حللنا سوء التفاهم

88
00:06:37,950 --> 00:06:41,710
لكن لم أعلم أنّكِ درستِ
السيافة بإشراف أب أنجي

89
00:06:41,710 --> 00:06:46,320
،أجل! والد الآنسة أنجيلين
،معلّمي الغول الأحمر بيلغريف

90
00:06:46,320 --> 00:06:48,350
هو سيّافٌ بارعٌ جدّاً

91
00:06:48,350 --> 00:06:51,290
—كما مُخطّط موهوب

92
00:06:52,560 --> 00:06:55,490
سامحيني على انطباعي السيّئ عنك

93
00:06:55,990 --> 00:06:58,390
فهمت الآن أنّكِ مثلي

94
00:06:59,380 --> 00:07:02,010
أ-أتقصدين ذلك حقّاً؟

95
00:07:02,010 --> 00:07:05,740
!أنا، ساشا بوردو، تأثّرت جدّاً

96
00:07:07,920 --> 00:07:10,860
...فهمت، ذلك ما حصل إذاً

97
00:07:11,170 --> 00:07:16,490
لكنّي لا أدري ما إن كنت أمتلك شأناً
بتعليم مُغامِرة ذات رتبة "إيه" مزدوجة

98
00:07:17,110 --> 00:07:21,010
كنتَ مُغامِراً أيضاً، صحيح؟

99
00:07:21,910 --> 00:07:26,250
أجل، لكن أصابني هذا في شبابي

100
00:07:26,770 --> 00:07:30,470
كنتُ في المجال لثلاثة أعوامٍ فحسب

101
00:07:30,730 --> 00:07:35,590
توقّفتُ عند رتبة "إي" أيضاً، مما يجعلكما فوقي

102
00:07:35,590 --> 00:07:39,640
مع ذلك، تبدو رجلاً لطيفاً جدّاً

103
00:07:39,640 --> 00:07:44,620
ظننتُك ستكون أكثر حدّة بما أنّهم
يدعونك بالغول الأحمر

104
00:07:45,610 --> 00:07:49,960
حسناً، من أخبركِ أنّ الناس ينادوني بذاك اللقب؟

105
00:07:49,960 --> 00:07:52,840
ماذا؟ قالت أنجي ذلك

106
00:07:54,620 --> 00:07:59,470
أنتما! لا تتقرّبا من أبي دون
!مناقشة الأمر معي أوّلاً

107
00:07:59,470 --> 00:08:00,470
أنجي

108
00:08:01,130 --> 00:08:03,060
ماذا يا أبي؟

109
00:08:03,980 --> 00:08:05,370
...حسناً

110
00:08:08,530 --> 00:08:11,130
ما موضوع "الغول الأحمر"؟

111
00:08:11,920 --> 00:08:15,080
!أنا ابتكرتُه! إنّه لقبك

112
00:08:15,080 --> 00:08:16,150
أليس رائعاً؟

113
00:08:16,150 --> 00:08:17,920
ماذا؟

114
00:08:17,920 --> 00:08:21,630
أيعني هذا أنّكِ كنتِ تنشرينه؟

115
00:08:22,280 --> 00:08:25,150
كانت أنجي تخبر الجميع به

116
00:08:25,150 --> 00:08:27,550
لم تكن تعرف؟

117
00:08:27,550 --> 00:08:31,400
لم يعد هناك أحدٌ في نقابة
أورفين" يجهل ذاك الاسم"

118
00:08:31,780 --> 00:08:35,480
أب المحاربة سوداء الشعر

119
00:08:35,480 --> 00:08:38,920
!المُغامِر السابق القويّ، الغول الأحمر بيلغريف

120
00:08:38,920 --> 00:08:42,610
حتّى مُغامرو الرتبة "إس" الذين
رجعوا من الاعتزال

121
00:08:42,610 --> 00:08:44,730
ورئيس النقابة أصبحوا يعرفونه

122
00:08:44,730 --> 00:08:45,900
...أنجي

123
00:08:49,790 --> 00:08:51,290
ماذا سأفعل؟

124
00:08:51,690 --> 00:08:56,050
ما الخطب يا أبي؟ هل أخطأتُ بشيء؟

125
00:08:56,310 --> 00:09:01,800
،كلّا، أتفهّم اهتمامكِ بي

126
00:09:01,800 --> 00:09:06,880
لكنّي لم أقم بشيءٍ جدير بذاك المجد

127
00:09:07,220 --> 00:09:10,100
تقصد أنّك لست مذهلاً كما تقول أنجي؟

128
00:09:10,100 --> 00:09:11,570
!لا تسيئي الفهم

129
00:09:12,020 --> 00:09:14,050
أبي قويٌّ جدّاً

130
00:09:14,050 --> 00:09:17,530
ألم أخبركما؟ لم أستطع إصابته ولو بضربة

131
00:09:17,530 --> 00:09:20,350
...ذلك قبل خمسة أعوام

132
00:09:20,350 --> 00:09:23,550
لا أهتمّ ما إن كانت
خمسة أم عشرة أعوام

133
00:09:23,550 --> 00:09:26,870
!إذا كنتما مُستاءتان، فسأثبت لكما! أبي

134
00:09:26,870 --> 00:09:28,500
أجل؟

135
00:09:28,500 --> 00:09:30,410
!بارزني

136
00:09:30,410 --> 00:09:34,420
لكنّكِ رجعتِ لتوّكِ

137
00:09:35,410 --> 00:09:37,170
لا أمانع

138
00:09:38,310 --> 00:09:41,180
سيتسنّى لنا رؤية المهارات التي
!سمعنا عنها الكثير أخيراً

139
00:09:41,180 --> 00:09:44,180
أنجي وساشا-سان تطريان عليك كثيراً

140
00:09:45,520 --> 00:09:50,290
ما الذي كان يجري
في جهلٍ منّي؟

141
00:10:05,320 --> 00:10:07,570
!أبي، لا تتهاون

142
00:10:12,150 --> 00:10:16,680
لا أدري كيف سأبلي أمام مُغامِرة
...نشطة من الرتبة "إس"، لكن

143
00:10:41,590 --> 00:10:45,230
لم تحسّني عاداتكِ التي أخبرتكِ بإصلاحها

144
00:10:45,230 --> 00:10:46,250
...كما

145
00:10:45,620 --> 00:10:46,470
ضربتني

146
00:10:46,470 --> 00:10:46,990
ماذا؟

147
00:10:48,230 --> 00:10:50,760
!ضربتني جدّياً يا أبي

148
00:10:51,140 --> 00:10:54,130
لكن... أخبرتِني بألّا أتهاون

149
00:10:54,910 --> 00:10:56,140
احملني

150
00:10:56,540 --> 00:10:59,440
مهلاً، أنتِ في السابعة عشرة

151
00:10:59,440 --> 00:11:00,670
!احملني

152
00:11:05,620 --> 00:11:08,250
أنت الأقوى يا أبوي

153
00:11:08,250 --> 00:11:09,630
...هوّني قليلاً

154
00:11:11,100 --> 00:11:13,340
لم يُفترض أن يجري الأمر هكذا

155
00:11:13,640 --> 00:11:16,510
غلب أنجي بتلك البساطة

156
00:11:16,510 --> 00:11:20,150
...لا أصدّق، فأنجي

157
00:11:25,540 --> 00:11:26,690
صحيح؟

158
00:11:26,690 --> 00:11:27,870
أجل، أجل

159
00:11:28,420 --> 00:11:31,970
ما رأيكِ يا أني؟ أليس أبي قويّاً جدّاً؟

160
00:11:31,970 --> 00:11:34,700
!بلى، إنّه مٌذهل! أدهشني

161
00:11:36,050 --> 00:11:38,210
كنتُ عارف أنّك تقدر يا أبي

162
00:11:38,210 --> 00:11:39,580
أنت الغول الأحمر كليّاً

163
00:11:40,690 --> 00:11:42,090
...أنجي

164
00:11:42,090 --> 00:11:43,710
ماذا يا أبي؟

165
00:11:44,050 --> 00:11:50,760
يسرّني أنّكِ تحبّيني، لكن هلّا امتنعتِ
عن إخبار الجميع عنّي؟

166
00:11:51,040 --> 00:11:54,110
ماذا؟ لكن من الصحيح أنّك قويّ

167
00:11:54,110 --> 00:11:55,550
أقوى منّي حتّى

168
00:11:55,550 --> 00:12:00,780
.بغض النظر، توقّفي رجاءً
لا يُسعدني الأمر بالتحديد

169
00:12:01,840 --> 00:12:02,770
!فهمت

170
00:12:02,770 --> 00:12:05,980
يُقال أنّ الصقر الموهوب يخفي مخالبه

171
00:12:05,980 --> 00:12:08,240
فهمت، سأتكتّم على الأمر

172
00:12:09,790 --> 00:12:13,780
...كونك أستاذاً مجهولاً أمرٌ رائع بدوره

173
00:12:19,690 --> 00:12:21,720
"لا نملك أحواض استحمام في "تورنيرا

174
00:12:21,720 --> 00:12:24,870
لذا امسحن أنفسكنّ بالمناشف الساخنة

175
00:12:24,870 --> 00:12:28,410
هل عليّ خلع كلّ شيء؟

176
00:12:29,310 --> 00:12:30,970
!شعورٌ جميل

177
00:12:33,980 --> 00:12:38,550
لا تنسي أنّكِ فتاة، لا تخلعي ثيابكِ بهذه السهولة

178
00:12:38,550 --> 00:12:40,280
!هيّا يا أني، اخلعي ثيابكِ أيضاً

179
00:12:40,990 --> 00:12:43,080
أسمعتِ تلك الصيحة؟

180
00:12:43,080 --> 00:12:45,260
!يا لصفائكِ يا أني

181
00:12:44,500 --> 00:12:46,240
!اصمتا يا حمقاوتان

182
00:12:47,060 --> 00:12:49,890
...لا يكبر حجمي أبداً

183
00:12:49,890 --> 00:12:51,510
لمَ يا ترى؟

184
00:12:51,510 --> 00:12:55,330
ليس أنّكِ لا تملكين شيئاً، بل مصقولة وحسب

185
00:12:55,330 --> 00:12:59,000
!صحيح! أنتِ نحيلة، أشعر بالغيرة

186
00:12:59,590 --> 00:13:01,990
أتسخران منّي أيّتها الحقيرتان؟

187
00:13:01,990 --> 00:13:04,200
!تبّاً لكما يا وحوش الأثداء

188
00:13:07,820 --> 00:13:09,220
أشعر بالانتعاش

189
00:13:09,220 --> 00:13:11,910
أجل، هذا جميل

190
00:13:11,910 --> 00:13:17,030
يا للروعة، أشعر أنّي رجعت لتورنيرا أخيراً

191
00:13:31,380 --> 00:13:32,970
هل انتهيتنّ؟

192
00:13:35,090 --> 00:13:36,770
مرحباً بعودتك يا أبي

193
00:13:36,770 --> 00:13:38,190
أجل، رجعت

194
00:13:38,890 --> 00:13:40,830
حسناً، لنتناول العشاء

195
00:13:45,110 --> 00:13:47,920
،"أشكّ بأن يضاهي الطعام في "أورفين

196
00:13:47,920 --> 00:13:49,360
لكن تناولن قدرما تشأن

197
00:13:49,360 --> 00:13:51,950
!طهو أبي لأوّل مرّة منذ خمسة أعوام

198
00:13:51,950 --> 00:13:54,430
!يا للوليمة! أنا سعيدة

199
00:13:55,780 --> 00:13:57,680
رائحة التوت اليارليّ

200
00:13:57,680 --> 00:14:00,720
أنت تحبّه يا أبي، وكذلك أنا

201
00:14:01,140 --> 00:14:04,070
"ربما لا يتواجد بكثرة في "أورفين

202
00:14:04,070 --> 00:14:05,950
آمل أن يعجبكما

203
00:14:07,070 --> 00:14:09,510
له نكهة فريدة، لكنّه لذيذ

204
00:14:09,510 --> 00:14:10,990
أنا أحبّه

205
00:14:10,990 --> 00:14:12,780
وكذلك أنا

206
00:14:12,780 --> 00:14:15,140
فهمت، يسرّني ذلك

207
00:14:15,140 --> 00:14:16,710
لم أتناول هذا منذ فترة أيضاً

208
00:14:17,450 --> 00:14:19,340
أنجي، ما ذلك؟

209
00:14:19,710 --> 00:14:22,200
إنّه طير، مذاقه لذيذ

210
00:14:22,200 --> 00:14:25,670
،تفعلين هذا، وتحملينه كيلا يتساقط

211
00:14:25,670 --> 00:14:27,840
وتقرّبين الطبق من فمك

212
00:14:29,610 --> 00:14:31,210
!لذيذ

213
00:14:32,480 --> 00:14:34,690
هكذا، صحيح؟

214
00:14:35,480 --> 00:14:37,720
ميري، اتّسخت قبّعتكِ بالزيت

215
00:14:38,730 --> 00:14:41,220
يا إلهي، وقعتُ بها

216
00:14:41,540 --> 00:14:45,010
ميري-تشان، الأكل صعبٌ عليكِ هكذا

217
00:14:45,010 --> 00:14:46,980
لمَ لا تخلعي قبّعتكِ؟

218
00:14:48,060 --> 00:14:50,730
...حسناً، أنا

219
00:14:53,650 --> 00:14:56,870
ميري، أبي ليس من ذاك الصنف

220
00:14:57,890 --> 00:15:01,030
...أعرف، لكن

221
00:15:01,840 --> 00:15:03,590
انظروا، إنّها من بني الوحوش

222
00:15:03,590 --> 00:15:04,640
هل أذناها حقيقيّتان؟

223
00:15:04,640 --> 00:15:07,130
يمكن بيعها لمعرض مسوخ بسعرٍ باهظ

224
00:15:07,130 --> 00:15:09,250
هل رأيتِ أذنيّ تلك الفتاة؟

225
00:15:09,250 --> 00:15:13,210
يا للمسكينة، لا بدّ أنّها مرّت بحياة عصيبة

226
00:15:14,950 --> 00:15:18,000
آسف، لم أقصد شيئاً بذلك

227
00:15:18,000 --> 00:15:20,650
لا داعي لتخلعيها إذا لم تريدي بالطبع

228
00:15:35,640 --> 00:15:38,670
فهمت، لذا إذاً

229
00:15:42,820 --> 00:15:44,950
بردت أذناكِ

230
00:15:45,920 --> 00:15:50,120
"الليل باردٌ في "تورنيرا" بخلاف "أورفين

231
00:15:50,120 --> 00:15:51,170
ماذا؟

232
00:15:51,170 --> 00:15:54,560
وجدتُها، لديّ قبّعة صيفيّة
في مكانٍ ما هنا

233
00:15:54,560 --> 00:15:58,780
لن تعيقكِ، وستدفئ أذنيك

234
00:15:58,780 --> 00:16:00,380
يُفترض أن تكون هنا

235
00:16:01,530 --> 00:16:03,380
يظنّ أذناكِ أُصيبتا بالبرد

236
00:16:04,290 --> 00:16:05,000
رأيتِ؟

237
00:16:07,780 --> 00:16:12,310
!معكِ حقّ، فهو والدكِ في النهاية

238
00:16:13,670 --> 00:16:15,150
وجدتها، ها هي

239
00:16:15,150 --> 00:16:17,120
ماذا؟ ما الخطب؟

240
00:16:17,980 --> 00:16:19,960
لا شيء

241
00:16:21,000 --> 00:16:22,830
...بالمناسبة

242
00:16:25,230 --> 00:16:29,320
بالمناسبة، أتمانع لو ربتّ على رأسي؟

243
00:16:29,960 --> 00:16:31,830
كلّا، لا أمانع

244
00:16:35,630 --> 00:16:37,090
!ما هذا؟

245
00:16:37,560 --> 00:16:39,090
أهذا ما أردتِه؟

246
00:16:39,090 --> 00:16:42,120
أجل، شكراً لك

247
00:16:43,000 --> 00:16:45,220
...هذا شعور امتلاك أبٍ إذاً

248
00:16:45,750 --> 00:16:47,110
أب؟

249
00:16:47,920 --> 00:16:50,120
يمكن أن تكون غريبةً بعض الشيء

250
00:16:51,490 --> 00:16:53,320
لا بدّ أنّكِ تشعرين بالغيرة

251
00:16:53,320 --> 00:16:55,360
أنا أعرف ذلك

252
00:16:55,950 --> 00:17:00,870
لـ-لا، ليس كأنّي الصعود
على كتفيه أو ما شايه

253
00:17:01,710 --> 00:17:03,990
...أنتما

254
00:17:04,630 --> 00:17:10,010
،إن أردتما الصعود على كتفيّ أبي
!فعليكما هزيمتي أوّلاً

255
00:17:10,490 --> 00:17:12,300
!الأمر ليس كما تظنّين

256
00:17:25,460 --> 00:17:27,450
لا تنظري قبل تحرّككِ

257
00:17:27,450 --> 00:17:29,310
كم مرّة عليّ إخباركِ بذلك؟

258
00:17:29,310 --> 00:17:32,100
يُفترض أنّكِ استوعبتِ الأمر الآن

259
00:17:32,100 --> 00:17:34,970
لم يتفادَ أحدٌ سواك هجماتي يا أبي

260
00:17:34,970 --> 00:17:38,150
أيمكنكِ الجزم بعدم ظهور شخص
يستطيع ذلك مستقبلاً؟

261
00:17:38,150 --> 00:17:41,110
،اختلقي الأعذار كيفما تشائين
لكن لن تصغي الوحوش

262
00:17:41,420 --> 00:17:42,520
...لكن

263
00:17:42,520 --> 00:17:45,360
بلا "لكن"، لا يتسلّل لكِ الاطمئنان

264
00:17:45,360 --> 00:17:46,700
اسمعي يا أنجي

265
00:17:47,130 --> 00:17:51,200
سأقلق عليكِ إذا لم تستطيعي
هزيمتي في التمرين

266
00:17:51,200 --> 00:17:55,380
أنتِ تقاتلين وحوشاً عالية الرتبة وملوك شياطين

267
00:17:56,420 --> 00:17:59,010
لم يكن ملك الشياطين بقوّتك

268
00:17:59,350 --> 00:18:02,240
ذلك لا يُعقل

269
00:18:03,040 --> 00:18:05,880
بالمناسبة، كيف كان ملك الشياطين؟

270
00:18:06,320 --> 00:18:10,400
حسناً، كان ظلّاً أسوداً متحرّكاً وما شابه

271
00:18:10,400 --> 00:18:11,810
ظلّ؟

272
00:18:16,910 --> 00:18:17,940
كيف كان مظهره؟

273
00:18:17,940 --> 00:18:22,440
شبه بشريّ، لكن صغير كطفل

274
00:18:26,450 --> 00:18:28,330
لا بدّ أنّه مخلوق مختلف

275
00:18:28,870 --> 00:18:32,160
...لو كان ملك شياطين، لكنّا الآن قد

276
00:18:32,160 --> 00:18:33,150
أبي؟

277
00:18:34,050 --> 00:18:35,320
ما الخطب؟

278
00:18:35,320 --> 00:18:37,070
لا شيء

279
00:18:37,070 --> 00:18:38,900
!أنتما هناك

280
00:18:39,470 --> 00:18:42,220
أتودّان تناول الغداء؟

281
00:18:43,370 --> 00:18:46,950
!بلى! الغداء، الغداء

282
00:18:48,040 --> 00:18:50,210
...بدا ملك الشياطين كظلّ

283
00:18:50,210 --> 00:18:55,330
بما أنّها من الرتبة "إس"، ستواصل أنجي
قتال وحوش مثله مستقبلاً

284
00:18:57,210 --> 00:18:59,520
يمكن أن تفقد ساقها اليمنى وتنجو

285
00:18:59,520 --> 00:19:02,720
لكن إن فقدت حياتها، تكون النهاية

286
00:19:05,650 --> 00:19:06,590
أنجي

287
00:19:07,090 --> 00:19:08,250
ماذا؟

288
00:19:08,750 --> 00:19:12,750
هل ستواصلين المُغامرة؟

289
00:19:12,750 --> 00:19:15,490
أجل، فذلك مُسلٍّ

290
00:19:15,490 --> 00:19:17,750
لا بدّ أنّها أفضل مهنة لي

291
00:19:23,490 --> 00:19:24,690
أبي؟

292
00:19:25,230 --> 00:19:30,070
إن أردتِ مواصلة المُغامرة، فعليكِ هزيمتي في مبارزة

293
00:19:31,120 --> 00:19:31,950
ماذا؟

294
00:19:32,730 --> 00:19:37,320
لا يمكن أن أسمح لكِ بالمواصلة
بعزيمتكِ ومهاراتكِ الناقصة

295
00:19:37,720 --> 00:19:42,060
،إن واصلتِ المُغامرة دون هزيمتي أوّلاً

296
00:19:42,750 --> 00:19:45,360
فلن أعتبركِ ابنتي بعد الآن

297
00:19:54,270 --> 00:19:58,320
أبي، أنت تمزح، صحيح؟

298
00:20:00,660 --> 00:20:01,950
احملي سيفكِ

299
00:20:02,620 --> 00:20:03,700
لا

300
00:20:04,270 --> 00:20:08,030
!لا، لا، لا! لا أريد

301
00:20:08,030 --> 00:20:10,480
تعتقدين أنّ الوحوش ستصغي لتذمّركِ؟

302
00:20:11,860 --> 00:20:13,060
!احملي سيفك

303
00:20:15,340 --> 00:20:17,730
لا أريد فعل هذا

304
00:20:18,320 --> 00:20:21,440
...هذه ليست طباعك

305
00:20:21,660 --> 00:20:22,450
!ها أنا ذا

306
00:20:26,600 --> 00:20:29,310
لمَ؟ لمَ؟ لمَ؟

307
00:20:29,310 --> 00:20:32,110
أهذا لأنّي أغضبته؟

308
00:20:33,740 --> 00:20:37,130
كلّا، ليس غاضباً

309
00:20:37,130 --> 00:20:40,620
إنّه حزينٌ لكوني بائسة

310
00:20:53,450 --> 00:20:54,530
!نالت منّي

311
00:21:00,090 --> 00:21:01,300
...أنجي

312
00:21:01,830 --> 00:21:05,670
أحسنتِ البلاء، كما أتوقّع من ابنتي

313
00:21:05,670 --> 00:21:07,040
اعتذر

314
00:21:07,040 --> 00:21:07,610
ماذا؟

315
00:21:08,040 --> 00:21:10,550
!اعتذر لقسوتك معي

316
00:21:10,550 --> 00:21:14,910
!لا تقل أنّك ستتبرّأ منّي! أكره ذلك

317
00:21:14,910 --> 00:21:18,880
!مهما حصل، سأبقى ابنتك دوماً

318
00:21:18,880 --> 00:21:24,130
حـ-حسناً، أنا آسف، أردتكِ أن تأخذي
الأمر على محمل الجدّ وحسب

319
00:21:24,130 --> 00:21:26,000
!كلّا! لا أسامحك

320
00:21:26,000 --> 00:21:28,100
إذا أردت مسامحتي لك، فاحملني

321
00:21:28,100 --> 00:21:29,360
!احضنّي

322
00:21:30,740 --> 00:21:32,350
حسناً

323
00:21:32,730 --> 00:21:35,780
حمداً لله، راودني القلق قليلاً

324
00:21:35,780 --> 00:21:39,620
صحيح، يناسبهما أن يكونا على انسجامٍ وحسب

325
00:21:39,620 --> 00:21:44,860
لكن... إنّه الغول الأحمر حقّاً

326
00:21:46,030 --> 00:21:46,990
أجل

327
00:21:51,130 --> 00:21:53,860
لم أكن أعلم أنّها تستطيع الحركة بذلك الشكل

328
00:21:54,250 --> 00:21:58,310
يا لحماقتي، كبرت حقّاً

329
00:21:59,660 --> 00:22:01,960
!أبي