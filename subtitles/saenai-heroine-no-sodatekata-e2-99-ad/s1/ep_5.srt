1
00:00:03,480 --> 00:00:04,540
!إنّه يعترف

2
00:00:04,540 --> 00:00:07,140
!لا شكّ أنّه يعترف بمشاعره لكاتو

3
00:00:07,140 --> 00:00:08,740
!تمهّل

4
00:00:08,740 --> 00:00:10,420
.أنا من وجدهما أوّلًا

5
00:00:10,420 --> 00:00:11,570
—لـ-لكن، لكن

6
00:00:11,570 --> 00:00:17,010
،رغبتك باستئثار الفتاة لنفسك لحظة ظهور منافس

7
00:00:17,010 --> 00:00:20,540
.تمنحك الكثير من نقاط بطلٍ خسيس

8
00:00:20,540 --> 00:00:26,120
".إن قلت شيئًا مثل: "جعلني أدرك أخيرًا أنّي أُكنّ لها المشاعر

9
00:00:26,120 --> 00:00:27,960
.فسأمنحك نقاطًا مضاعفة على فظاعتك

10
00:00:27,960 --> 00:00:30,370
،آسف، لا أستطيع سماع ما يقولان

11
00:00:30,370 --> 00:00:32,300
أيمكنكِ أن تصمتي إلى الأبد؟

12
00:00:50,820 --> 00:00:54,810
.أهنّئك على انتسابك إلى قاعة مشاهير أسوأ الأبطال يا أخلاقيّ-كُن

13
00:00:54,810 --> 00:00:56,030
.إليك جائزتك

14
00:00:56,030 --> 00:00:57,140
!آسف

15
00:00:57,140 --> 00:00:58,900
،قد أكون الأسوأ

16
00:00:58,900 --> 00:01:01,950
!لكن ارحميني رجاءً، فأنا لست بمازوخيّ

17
00:02:48,180 --> 00:02:49,210
،على كلّ حال

18
00:02:49,210 --> 00:02:52,530
.لطالما كانت كاتو-سان متّزنةً في تصرّفاتها

19
00:02:52,530 --> 00:02:54,660
.عيبها الوحيد أنّها لا تبرز إطلاقًا

20
00:02:54,660 --> 00:02:57,820
.ذلك الجزء الأخير بليغٌ بالفعل

21
00:02:57,820 --> 00:03:03,200
،لكن مؤخّرًا، بفضل توجيهاتي السّلوكيّة وموضة ساوامورا-سان

22
00:03:03,200 --> 00:03:06,620
.أصبحت أشبه أكثر فأكثر ببطلةٍ رئيسيّة

23
00:03:06,620 --> 00:03:10,090
.يستحيل ألا يجتذب ذلك صبّيًّا أو اثنان

24
00:03:11,200 --> 00:03:17,700
.أردت أن يكون ظهورها الأوّل متزامنًا مع إصدار لعبتنا في كوميكت الشّتاء

25
00:03:17,700 --> 00:03:20,590
.لم أتصوّر أنّ الأمور قد تطوّرت إلى هذا الحدّ

26
00:03:20,590 --> 00:03:22,090
،المعذرة

27
00:03:22,090 --> 00:03:28,100
.لا أقدّر لكم انتهاك خصوصيّاتي ومناقشتها بلا استحياء

28
00:03:28,100 --> 00:03:31,770
إذًا لماذا قمتِ برفضه؟

29
00:03:31,770 --> 00:03:35,580
،عليكِ أن تفعلي أمورًا مشبوهة يُسيء الآخرون فهمها بسهولة

30
00:03:35,580 --> 00:03:38,110
.وإلّا اغترّ هذا البطل الخسيس بنفسه

31
00:03:38,640 --> 00:03:40,800
،لكن إن بدأت في مواعدة أحدهم

32
00:03:40,800 --> 00:03:45,250
.فسأنشغل بالمواعيد وما إلى ذلك في نهاية كلّ أسبوع

33
00:03:45,250 --> 00:03:46,620
وما الخطب في ذلك؟

34
00:03:46,620 --> 00:03:49,000
.نحن نقترب من موعد التّطوير النّهائيّ

35
00:03:49,000 --> 00:03:51,370
لن يكون لديّ الوقت لهذا وقتها، أليس كذلك؟

36
00:03:51,370 --> 00:03:56,840
...البرمجة، التّصحيح، تنظيم المطبوعات، التّحضير للحدث

37
00:03:56,840 --> 00:04:01,450
.ليس لديّ الوقت لأشغل بالي بشيءٍ قبل كوميكت الشّتاء عدا المجموعة

38
00:04:01,450 --> 00:04:03,320
...كـ-كاتو

39
00:04:03,320 --> 00:04:05,340
!فهمت

40
00:04:06,320 --> 00:04:07,600
.كاتو-سان

41
00:04:07,600 --> 00:04:12,600
.أتفهّم تمامًا تفانيكِ الكبير في تطوير لعبتنا

42
00:04:13,410 --> 00:04:14,350
...لكن

43
00:04:15,840 --> 00:04:18,520
،عدم اكتمال الرّسم بحلول الموعد النّهائيّ لانتهاء التّطوير

44
00:04:18,520 --> 00:04:20,860
.يجعل كوميكت الشّتاء وكلّ شيءٍ آخر ضربًا من الخيال

45
00:04:20,860 --> 00:04:27,810
هل قالت الكاتبة والمخرج اللّذان لم يؤخّرا السّيناريو فحسب
بل وأضافا أيضًا مسارًا جديدًا يتطلّب الرّسم شيئًا؟

46
00:04:27,810 --> 00:04:29,830
!لكِ خالص اعتذاراتي

47
00:04:30,440 --> 00:04:34,540
.لكنّنا قمنا بتمديد الجدول الزّمنيّ، وما زلتِ متخلّفة

48
00:04:34,980 --> 00:04:36,320
،وفقًا للجدول الزّمنيّ

49
00:04:36,320 --> 00:04:39,140
.كان لديكِ الوقت الكافي لإنهاء كل شيء بما في ذلك العمل الإضافيّ

50
00:04:39,140 --> 00:04:40,500
...هذا

51
00:04:40,500 --> 00:04:44,550
.لأنّني لم أستطع تصوّر صورةٍ مناسبة للبطلة الرّئيسيّة إلّا مؤخّرًا

52
00:04:44,860 --> 00:04:48,670
.أتأسّف بشدّة على ذلك

53
00:04:48,670 --> 00:04:49,810
أهذا كلّ ما في الأمر؟

54
00:04:50,670 --> 00:04:52,100
إلامَ ترمين؟

55
00:04:52,820 --> 00:04:58,190
.أشعر أنّك مهووسةٌ بالجودة لدرجة أنّكِ لا تبرحين مكانكِ

56
00:04:58,190 --> 00:05:00,760
أتريدين القول أنّ جهودي بلا فائدة؟

57
00:05:00,760 --> 00:05:02,340
.لن أبالغ إلى ذلك الحدّ

58
00:05:02,340 --> 00:05:07,320
.لكن لا يبدو أنّ الأمور تتحسّن بشكلٍ متناسبٍ مع الوقت الّذي تستغرقينه

59
00:05:08,580 --> 00:05:09,830
وما أدراكِ؟

60
00:05:09,830 --> 00:05:11,720
أتظنّين أنّي لا أدري؟

61
00:05:11,720 --> 00:05:13,050
—أنا دائمًا

62
00:05:13,050 --> 00:05:14,180
!تريّثا

63
00:05:14,180 --> 00:05:17,370
!إن كانت لديكما أيّ شكاوى فأخبراني أنا المخرج

64
00:05:17,370 --> 00:05:19,210
.لا تقلقي، ستفعلها إريري

65
00:05:19,210 --> 00:05:21,590
بالرّغم من أنّها أوّل مرّةٍ تعمل فيها على رسومات لعبة؟

66
00:05:21,590 --> 00:05:24,300
ورغم أنّها لم تكمل أحدها من قبل؟

67
00:05:24,300 --> 00:05:27,890
!مع ذلك، لديها إنجازاتٌ عظيمة كرسّامة دوجينشي

68
00:05:28,710 --> 00:05:30,220
!تومويا

69
00:05:30,220 --> 00:05:32,400
!لم تتخلَّ من قبل عن أيٍّ من أعمالها

70
00:05:32,400 --> 00:05:34,640
.وأنهت جميع كتبها بانتظام

71
00:05:34,640 --> 00:05:39,310
!إنّها مبدعةٌ متفانية تجسّد ما تتصوّره في رسمها

72
00:05:39,310 --> 00:05:42,230
أتحاول مدحها بهذه الطّريقة؟

73
00:05:42,230 --> 00:05:44,360
.فهمت، أعدكم بأن أنهي العمل كما ينبغي

74
00:05:44,900 --> 00:05:46,000
.لا تقلقوا

75
00:05:46,000 --> 00:05:48,660
.سأنتهي في الموعد المحدّد مهما كلّف الأمر

76
00:05:49,530 --> 00:05:50,290
أرأيتِ؟

77
00:05:54,850 --> 00:05:57,210
.أعتقد أنّ هذا كلّ ما بيدي فعله حاليًّا

78
00:06:02,720 --> 00:06:04,600
نـ-ناسو كوغين؟

79
00:06:04,600 --> 00:06:06,680
.أجل، إلى فيلاتنا هناك

80
00:06:06,680 --> 00:06:09,760
.فكرّت بأن أُعلِمك قبل أن أذهب

81
00:06:10,150 --> 00:06:12,390
كنتَ هناك من قبل، أتذكر؟

82
00:06:12,390 --> 00:06:15,830
ذلك القصر الّذي ذهبنا إليه في الصّف الابتدائي؟

83
00:06:15,830 --> 00:06:16,980
.صحيح

84
00:06:16,980 --> 00:06:20,150
.فكّرت بأن أعتكف فيه لوحدي

85
00:06:20,150 --> 00:06:21,940
إلى متى؟

86
00:06:22,410 --> 00:06:26,740
تمّ تمديد الموعد النّهائيّ لتسليم نسخي النّهائيّة حتّى نهاية الأسبوع المقبل، أليس كذلك؟

87
00:06:26,740 --> 00:06:28,940
تخطّطين للمكوث هناك إلى حينها؟

88
00:06:28,940 --> 00:06:31,820
.بالمقابل، أعدك بأن أنهي العمل في الموعد المحدّد

89
00:06:32,490 --> 00:06:33,980
.ثِق بي

90
00:06:34,990 --> 00:06:38,250
!لطالما وثقت بكِ، ومع ذلك وصلنا إلى هذا الوضع

91
00:06:38,250 --> 00:06:40,620
!أعدك أنّ الأمور ستكون على خير هذه المرّة

92
00:06:40,620 --> 00:06:43,920
.سأعزل نفسي في القصر إلى أن أُتمّ رسم كلّ شيء

93
00:06:43,920 --> 00:06:46,060
وماذا عن المدرسة؟

94
00:06:46,060 --> 00:06:48,960
.سأضطرّ للغياب وإلّا لن أكمل في الموعد المحدّد

95
00:06:51,580 --> 00:06:55,680
لِم أنتِ أساسًا متخلّفةٌ عن الجدول الزّمنيّ إلى هذا الحدّ؟

96
00:06:56,240 --> 00:06:59,360
...بوتيرتكِ المعتادة، إن كنتِ جدّيّة في العمل

97
00:07:01,480 --> 00:07:06,400
.هذه المرّة، لا أريد أن أخسر مهما كلّف الأمر

98
00:07:07,160 --> 00:07:08,150
...إريري

99
00:07:12,140 --> 00:07:13,780
.حسنًا، حان وقت ذهابي

100
00:07:14,340 --> 00:07:15,740
.سأُراسلك لاحقًا

101
00:07:16,110 --> 00:07:18,330
!أعدك أنّي سأراسلك كلّ يوم

102
00:07:18,820 --> 00:07:20,710
.لهذا انتظرني

103
00:07:25,980 --> 00:07:28,460
.فهمت، سأنتظركِ

104
00:07:31,490 --> 00:07:32,800
!إريري

105
00:07:33,530 --> 00:07:34,920
ماذا؟

106
00:07:34,920 --> 00:07:36,460
ستعودين، صحيح؟

107
00:07:36,460 --> 00:07:38,350
لن تختفي، صحيح؟

108
00:07:38,350 --> 00:07:39,780
.بالطّبع سأعود

109
00:07:39,780 --> 00:07:41,490
ما هذا الّذي تهذي به يا تومويا؟

110
00:07:41,490 --> 00:07:44,190
...لا، صحيح، لكن

111
00:07:44,760 --> 00:07:45,870
.ما أغربك

112
00:07:52,550 --> 00:07:54,620
!حتمًا لن تعود

113
00:07:54,620 --> 00:07:56,200
.ستختفي

114
00:07:56,200 --> 00:07:58,650
.أرجوكِ لا تؤجّجي قلقي

115
00:07:58,650 --> 00:08:03,620
لكن أتظنّان أنّها ستكون بخيرٍ وحدها في الخلاء؟

116
00:08:03,620 --> 00:08:05,080
.ستكون بخير

117
00:08:05,080 --> 00:08:07,070
.كنت هناك ذات مرّة

118
00:08:07,070 --> 00:08:09,100
.كما أنّ هناك متجر بقالةٍ بالقرب منه

119
00:08:11,300 --> 00:08:13,280
.المشكلة لا تكمن هنا

120
00:08:14,330 --> 00:08:17,850
...السّماح لمبدعةٍ لديها مواعيد نهائيّة وشيكة بالخروج إلى البريّة بمفردها

121
00:08:17,850 --> 00:08:21,850
.لقد اقترفت غلطةً فادحة بصفتك المخرج

122
00:08:21,850 --> 00:08:25,530
.لـ-لكن إريري قالت أنّ عليها فعل ذلك وإلّا لن تكمل في الموعد المحدّد

123
00:08:25,530 --> 00:08:27,360
.يا لك من ساذجٍ يا أخلاقيّ-كُن

124
00:08:27,360 --> 00:08:29,180
...حكمك ذاك

125
00:08:29,180 --> 00:08:31,980
،كان مثل هذا وهذا

126
00:08:31,980 --> 00:08:33,610
!في غاية السّذاجة

127
00:08:31,980 --> 00:08:33,610
!اصمتي، اصمتي، اصمتي

128
00:08:34,270 --> 00:08:36,890
،انظري، لقد راسلتني يوم أمس كما وعدت

129
00:08:36,890 --> 00:08:38,870
.كما أنّها أنهت رسمتين في يومها الأوّل

130
00:08:38,870 --> 00:08:40,900
.إنّها تتقدّم بخطى ثابتة

131
00:08:40,900 --> 00:08:41,750
صحيح؟

132
00:08:41,750 --> 00:08:43,850
.وما زال لديها أسبوعٌ في المتناول

133
00:08:43,850 --> 00:08:46,150
.هكذا هي الأمور في البداية

134
00:08:46,150 --> 00:08:46,960
ماذا؟

135
00:08:46,960 --> 00:08:50,760
.هذا ما سمعته من أحد المحرّرين

136
00:08:50,760 --> 00:08:54,590
.كما لو أنّكِ تعرفين محرّرًا آخر عدا ماتشيدا-سان

137
00:08:54,940 --> 00:08:58,680
.يقولون أنّ المبدعين المتهرّبين يتبعون نمطًا معيّن

138
00:08:58,680 --> 00:08:59,280
ما هذا؟

139
00:08:59,280 --> 00:08:59,930
قصّة أشباح؟

140
00:08:59,930 --> 00:09:03,000
.لهذا عليك أن تأخذ حذرك يا أخلاقيّ-كُن

141
00:09:03,000 --> 00:09:04,440
نمط؟

142
00:09:04,440 --> 00:09:06,200
.أوّلًا، المستوى الأوّل

143
00:09:06,200 --> 00:09:08,940
.يصبح كلامهم أكثر خشونة

144
00:09:08,940 --> 00:09:10,440
.نعم، فهمت

145
00:09:10,710 --> 00:09:12,610
.ثمّ يأتي المستوى الثّاني

146
00:09:12,610 --> 00:09:14,750
.هذه المرّة يبدؤون بلوم أنفسهم

147
00:09:14,750 --> 00:09:16,080
.فـ-فهمت

148
00:09:16,080 --> 00:09:17,950
.يليه المستوى الثّالث

149
00:09:17,950 --> 00:09:20,260
.تصبح ردودهم أبطأ أكثر فأكثر

150
00:09:21,080 --> 00:09:22,890
.ثمّ إلى المستوى الرّابع

151
00:09:22,890 --> 00:09:25,490
"!أريد أن أموت!" أو "لم أعد أستطيع التحمّل"

152
00:09:25,490 --> 00:09:28,430
.سيتمرّغون في الشّفقة على الذّات دون أدنى اعتبارٍ للآخرين

153
00:09:29,940 --> 00:09:31,830
.وأخيرًا، المستوى الخامس

154
00:09:31,830 --> 00:09:35,340
.في يومٍ ما، لن تستطيع التّواصل معهم نهائيًّا

155
00:09:37,050 --> 00:09:38,630
،بالمناسبة، في المستوى السّادس

156
00:09:38,630 --> 00:09:41,440
،حتّى لو ذهبت للبحث عن المبدعة المختفية

157
00:09:41,440 --> 00:09:46,280
في الغالب ستكون مع رجلٍ آخر تحت اسمٍ
.مستعارٍ جديد وتعمل على عملٍ جديدٍ كلّيًّا

158
00:09:42,210 --> 00:09:44,260
.أعتذر عن التّأخير

159
00:09:44,260 --> 00:09:47,060
.لحظة، هذا ليس ما طلبته

160
00:09:46,280 --> 00:09:50,510
.لذا، الرّجل الّذي تمّ هجره ، ليس عليه أن يقلق إلى هذا الحدّ

161
00:09:47,060 --> 00:09:50,110
!مـ-ماذا؟! آسفة

162
00:09:50,510 --> 00:09:52,510
.تلك هي نصيحة ماتشيدا-سان

163
00:09:52,510 --> 00:09:54,940
المعذرة، أكان ذلك الجزء الأخير ضروريًّا؟

164
00:09:55,210 --> 00:09:56,150
،على أيّ حال

165
00:09:56,150 --> 00:09:59,460
،إن بدأت تلحظ ذلك النّمط في رسائل ساوامورا-سان

166
00:09:59,460 --> 00:10:00,900
.فاحتط من ذلك

167
00:10:06,860 --> 00:10:10,370
إذًا إلى متى ستظلّ تعزل نفسها هناك؟

168
00:10:10,370 --> 00:10:14,210
...موعد تسليم النّسخة النّهائيّة هو صباح يوم الاثنين، لِذا

169
00:10:16,100 --> 00:10:17,700
،في تلك الحالة يا أكي-كُن

170
00:10:17,700 --> 00:10:21,390
أتريد أن نذهب معًا يوم السّبت إلى ناسو كوغين لزيارة إريري؟

171
00:10:21,790 --> 00:10:27,330
ما رأيك بأن نبيت في الفيلا ثمّ نعود جميعًا يوم الأحد؟

172
00:10:27,330 --> 00:10:32,480
كاتو، أتدركين حتّى أنّكِ اقترحتِ للتّو أن يذهب فتى في رحلةٍ رفقة فتاتين؟

173
00:10:32,480 --> 00:10:36,550
،بالنّظر إلى أنّه سبق وأمضينا ليالٍ تجمع بين فتى وأربع فتيات

174
00:10:36,550 --> 00:10:39,420
.أتساءل أيّ مجموعةٍ هذه

175
00:10:40,670 --> 00:10:42,500
.لا أستطيع هذه المرّة

176
00:10:42,500 --> 00:10:45,040
.يحب أن أضيف بعض اللّمسات على النّسخة النّهائيّة أيضًا

177
00:10:45,040 --> 00:10:46,620
.حسنًا، فهمت

178
00:10:46,620 --> 00:10:48,620
.إذًا فأنا لا أستطيع أيضًا

179
00:10:48,620 --> 00:10:50,120
.لأنّني سأساعدك في ذلك

180
00:10:50,470 --> 00:10:52,430
.شكرًا، أقدّر مساعدتكِ

181
00:10:52,430 --> 00:10:54,900
،حسنًا، سأتفرّغ طوال نهاية الأسبوع

182
00:10:54,900 --> 00:10:56,960
.لِذا أعلمني إن احتجت المساعدة

183
00:10:56,960 --> 00:10:58,880
.نعم، أعتمد عليكِ

184
00:11:01,950 --> 00:11:07,270
،بالنّظر إلى أنّه في كلّ أسبوع تبيت فتاةٌ مختلفةٌ في غرفة فتى

185
00:11:07,270 --> 00:11:10,180
.أتساءل أيّ مجموعةٍ هذه

186
00:11:11,990 --> 00:11:14,110
.سأرسل لك ما أنهيته اليوم

187
00:11:14,110 --> 00:11:14,960
.حسنًا

188
00:11:16,920 --> 00:11:18,030
رسمةٌ واحدةٌ فحسب؟

189
00:11:18,030 --> 00:11:21,660
أعتذر، لم أفهم سؤالك جيّدًا. أيمكنك أن تكرّره؟

190
00:11:21,660 --> 00:11:22,680
!مذهل

191
00:11:22,680 --> 00:11:26,290
!هذه أفضل رسمةٍ لكِ حتّى الآن يا كاشيواجي إري-سينسي

192
00:11:28,430 --> 00:11:31,540
.على كلّ، بهذا يكتمل مسار روري

193
00:11:31,540 --> 00:11:34,650
.أعمل حاليًّا على المسار الكبير الّذي كتبتَه

194
00:11:34,650 --> 00:11:36,340
!فهمت، أخيرًا

195
00:11:36,340 --> 00:11:38,290
،كنتُ على علمٍ بهذا

196
00:11:38,290 --> 00:11:41,300
.لكن لهذا السّيناريو صفةٌ مغايرةٌ عن ما سبقه

197
00:11:41,300 --> 00:11:45,400
.حـ-حسنٌ، هذا لأنّه مكتوبٌ من قبل كاتبٍ مختلف

198
00:11:45,400 --> 00:11:49,520
.قد أحتاج لنهج مغايرٍ تمامًا في التّخطيط والتّلوين

199
00:11:50,560 --> 00:11:54,900
.ونظرًا لذلك، ربّما يصبح تقدّمي أبطأ قليلًا بدءًا من الغد

200
00:11:54,900 --> 00:11:56,940
ماذا؟ أبطأ ممّا هو عليه الآن؟

201
00:11:56,940 --> 00:12:00,230
أعتذر، لم أفهم سؤالك جيّدًا. أيمكنك أن تكرّره؟

202
00:12:00,230 --> 00:12:04,630
!سينسي، سأنتظر مهما استغرقكِ الأمر لرسم شيءٍ تجدينه مقبولًا

203
00:12:09,480 --> 00:12:12,370
.ابلعي طعامكِ قبل الحديث رجاءً

204
00:12:13,870 --> 00:12:16,370
ألم أخبرك يا أخلاقيّ-كُن؟

205
00:12:16,370 --> 00:12:20,050
.ترك ساوامورا-سان بمفردها كان غلطةً فادحة

206
00:12:20,050 --> 00:12:23,350
.لكن لم يسبق أن تخّلت إريري عن أعمالها

207
00:12:23,350 --> 00:12:26,680
.المستوى الأوّل، يصبح كلامهم أكثر خشونة

208
00:12:27,890 --> 00:12:32,090
على الأرجح أنّها ستتقدّم إلى المستوى
.الثّاني بحلول اللّيلة، لِذا حضّر نفسك لذلك

209
00:12:32,090 --> 00:12:34,890
.لقد كانت ترسم البارحة كما هو مفترض

210
00:12:34,890 --> 00:12:36,400
.مع أنّها كانت رسمةً واحدةً فقط

211
00:12:36,950 --> 00:12:39,860
.يتوقّف الفنّان عن الرّسم في لحظة

212
00:12:40,200 --> 00:12:44,130
.ولن تعلم متى سيكون قادرًا على الرّسم مجدّدًا

213
00:12:44,130 --> 00:12:46,990
قالت ساوامورا-سان أنّها ستغيّر أسلوبها، صحيح؟

214
00:12:48,410 --> 00:12:53,710
.الشّروع في شيءٍ جديدٍ كهذا هو أخطر أمرٍ في هذه المرحلة

215
00:12:54,130 --> 00:12:57,120
.أجل، أتفهّم ما تمرّ به

216
00:12:57,120 --> 00:13:00,900
.أعجز عن التّفكير بحبكةٍ لروايتي الخفيفة الجديدة

217
00:13:00,900 --> 00:13:03,870
.ما كان عليّ أن أجعلها تصنيف هاريم مدرسيّ

218
00:13:03,870 --> 00:13:05,180
سـ-سينباي؟

219
00:13:05,180 --> 00:13:08,390
!كان عليّ أن أجعلها قصّة حبٍّ طاهر كالسّابق

220
00:13:08,390 --> 00:13:10,280
!أتطلّع قدمًا لسلسلتكِ الجديدة

221
00:13:10,280 --> 00:13:13,100
!سأظلّ أنتظركِ يا كاسومي أوتاكو-سينسي

222
00:13:15,890 --> 00:13:18,820
.ستكون إريري على ما يرام

223
00:13:18,820 --> 00:13:20,970
.لن تقدم على شيءٍ متهوّر

224
00:13:20,970 --> 00:13:22,650
.أثق أنّها درست الوضع

225
00:13:23,340 --> 00:13:28,740
.لهذا أعلم أنّها ستواصل السّعي للانتهاء في الموعد المحدّد بأسلوبها المعتاد

226
00:13:29,760 --> 00:13:31,410
.أخلاقيّ-كُن

227
00:13:31,410 --> 00:13:33,980
...أيعقل أنّك

228
00:13:33,980 --> 00:13:35,770
.أجل، أثِق بها

229
00:13:36,820 --> 00:13:39,760
.لا، تلك ليست ثِقة

230
00:13:39,760 --> 00:13:41,760
.أنت ببساطة لا تتوقّع شيئًا

231
00:13:42,750 --> 00:13:47,220
أتظنّ حقًّا أنّها مبدعةٌ لها مستقبلٌ باهت؟

232
00:13:47,220 --> 00:13:49,300
!لـ-لم أقل ذلك قطّ

233
00:13:49,300 --> 00:13:50,690
...إنّها فقط

234
00:13:50,690 --> 00:13:53,600
،لن تستطيع ساوامورا-سان تغيير أسلوبها

235
00:13:53,600 --> 00:13:55,020
.ولن تحرز أيّ تقدّم

236
00:13:55,420 --> 00:13:58,370
،وحتّى عندما واجهت تحدّيًا يفرض عليها تجواز حدودها

237
00:13:58,370 --> 00:14:00,540
.تراجعت إلى الخلف دون أن تحاول

238
00:14:00,540 --> 00:14:02,490
هذا ما تظنّه، صحيح؟

239
00:14:02,490 --> 00:14:04,930
عمّ تتحدّثين يا أوتاها-سينباي؟

240
00:14:04,930 --> 00:14:06,780
ألا تريدينها أن تكمل في الموعد المحدّد؟

241
00:14:07,310 --> 00:14:09,030
،يا أخلاقيّ-كُن

242
00:14:09,620 --> 00:14:12,790
ألا تريدها أن تتطوّر؟

243
00:14:16,410 --> 00:14:17,790
ما هذا؟

244
00:14:20,370 --> 00:14:22,420
.هذا لا يتعلّق بي، لكنّه يثير حنقي

245
00:14:22,830 --> 00:14:24,920
ما-ما هو؟

246
00:14:24,920 --> 00:14:28,780
،يفترض أنّي أكره ساوامورا إريري

247
00:14:28,780 --> 00:14:34,520
إلّا أنّني أكنّ الكثير من الاحترام لكاشيواجي إري
.رغم أنّه يفترض بك أن تكون أكثر شخصٍ يفهمها

248
00:14:34,520 --> 00:14:36,180
.هذا هو الواقع المثير للسّخريّة

249
00:14:47,650 --> 00:14:50,660
.أعتذر، لم أنجز اليوم أيّ شيء

250
00:14:51,260 --> 00:14:54,040
.بصراحة، أنا محتارةٌ قليلًا

251
00:14:54,040 --> 00:14:57,910
فقد اعتدت العمل على سيناريو كاسوميغاوكا أوتاها
،في الأشهر السّتة الأخيرة

252
00:14:57,910 --> 00:15:01,980
.ولم أهتدِ بعد لكيفيّة التّعامل مع السّيناريو خاصّتك

253
00:15:01,980 --> 00:15:04,100
.أنتِ تبالغين التّفكير في الأمر

254
00:15:04,100 --> 00:15:05,750
.إنّه السّيناريو خاصّتي فحسب

255
00:15:06,040 --> 00:15:09,670
.في الواقع، لقد رسمت بضع صورٍ على سبيل التّجربة

256
00:15:09,670 --> 00:15:10,180
ماذا؟

257
00:15:10,180 --> 00:15:13,080
.لكنّها لم ترقني

258
00:15:13,080 --> 00:15:17,060
.استخدمت نفس أسلوبي المعتاد، لكنّه لم يكن ملائمًا للنّص

259
00:15:17,560 --> 00:15:20,060
.لهذا، تخلّصت منها كلّها

260
00:15:20,400 --> 00:15:22,040
.لا تتخلّصي منها

261
00:15:22,040 --> 00:15:23,060
!مهلًا لحظة

262
00:15:23,480 --> 00:15:27,100
.لم أواجه هذا الموقف من قبل

263
00:15:27,100 --> 00:15:29,070
.لا أحرز أيّ تقدّم

264
00:15:29,590 --> 00:15:31,600
ما الّذي حلّ بي؟

265
00:15:31,600 --> 00:15:33,780
...حاولي فعلها بعرضيّة أكثر

266
00:15:33,780 --> 00:15:34,910
...كالمعتاد

267
00:15:34,910 --> 00:15:36,830
.لكن سأحرص على أن أنتهي في الموعد المحدّد

268
00:15:37,540 --> 00:15:40,250
.هذه مشكلتي وسأتعامل معها بنفسي

269
00:15:40,250 --> 00:15:42,380
...ليس وكأنّكِ تقصّرين

270
00:15:42,380 --> 00:15:43,370
.حسنًا، سأكلّمك غدًا

271
00:15:43,370 --> 00:15:44,590
إ-إريري؟

272
00:15:53,550 --> 00:15:55,180
.آسفة يا تومو-كُن

273
00:15:55,940 --> 00:15:59,730
.لم أستطع الوفاء بوعدي لك

274
00:16:00,650 --> 00:16:01,480
.آسفة

275
00:16:08,070 --> 00:16:10,940
هل تلقّيت أيّ أخبارٍ من إريري؟

276
00:16:12,070 --> 00:16:13,360
.فهمت

277
00:16:13,360 --> 00:16:15,690
.لم تراسلني أيضًا

278
00:16:15,690 --> 00:16:18,930
.ولا أعتقد أنّه من الصّواب أن نتّصل بها

279
00:16:22,590 --> 00:16:26,290
هل عليّ أن أتخلّى عن المسار الكبير؟

280
00:16:26,290 --> 00:16:30,050
لكنّه أوّل سيناريو تكتبه، صحيح؟

281
00:16:30,360 --> 00:16:33,920
لهذا سيكون مستواه منخفضًا، أليس كذلك؟

282
00:16:33,920 --> 00:16:36,680
.لن تشكّل إزالته أيّ إشكال

283
00:16:37,430 --> 00:16:40,930
.لا أظنّ أنّ إريري ستوافق على ذلك إطلاقًا

284
00:16:41,490 --> 00:16:42,630
لماذا؟

285
00:16:47,840 --> 00:16:50,920
،كنت أنوي قول شيءٍ لطيف

286
00:16:50,920 --> 00:16:53,530
.لكن موقفك هذا غيّر رأيي

287
00:16:53,530 --> 00:16:56,200
ألا ترين أنّكِ أصبحتِ فظّةً معي مؤخّرًا؟

288
00:16:56,200 --> 00:16:58,450
،حسنًا، مهما يكن

289
00:17:00,890 --> 00:17:03,710
.أعلمني فورًا إذا استجدّ شيء خلال نهاية الأسبوع

290
00:17:04,210 --> 00:17:07,210
،سآتي على الفور، حتّى لو تعيّن الذّهاب إلى ناسو كوغين

291
00:17:07,540 --> 00:17:09,920
.حـ-حسنًا، شكرًا

292
00:17:09,920 --> 00:17:12,710
.على كلٍّ، أتساءل إن كانت إريري على ما يرام

293
00:17:12,710 --> 00:17:14,680
هل تتغذّى جيّدًا يا ترى؟

294
00:17:14,680 --> 00:17:17,440
.قالت أنّ الشّعرية سريعة التّحضير هي طعامها الرّئيسيّ

295
00:17:18,240 --> 00:17:20,830
.آمل ألّا تضرّ بصحّتها

296
00:17:20,830 --> 00:17:23,640
.أنتِ مثل أمٍّ يا كاتو

297
00:17:23,640 --> 00:17:26,620
.أنا قلقةٌ حيال أمورٍ مقلقة

298
00:17:26,620 --> 00:17:28,230
لربّما هي مصابةٌ بالزّكام؟

299
00:17:28,850 --> 00:17:31,690
ذلك المكان أشدّ برودةً من طوكيو، أليس كذلك؟

300
00:17:36,790 --> 00:17:40,120
.لقد كان البرد قارسًا هناك قبل تسع سنوات

301
00:18:00,000 --> 00:18:01,210
أوني-تشان؟

302
00:18:02,370 --> 00:18:04,980
أين ذهبت يا أوني-تشان؟

303
00:18:07,860 --> 00:18:09,980
.أنا هنا

304
00:18:10,340 --> 00:18:13,070
أين ذهبت يا أوني-تشان؟

305
00:18:32,660 --> 00:18:33,320
إريري؟

306
00:18:33,320 --> 00:18:34,650
!الثّلج يتساقط يا تومويا

307
00:18:34,650 --> 00:18:36,640
!إنّه في غاية الجمال

308
00:18:36,640 --> 00:18:37,870
مـ-ماذا؟

309
00:18:37,870 --> 00:18:39,300
،على كلّ حال

310
00:18:39,300 --> 00:18:41,210
!يبدو أنّي سأنتهي في الموعد المحدّد

311
00:18:41,210 --> 00:18:42,250
!حـ-حقًّا؟

312
00:18:42,250 --> 00:18:45,270
!لقد توصّلت للتّو إلى أسلوب رسمٍ جديد

313
00:18:45,270 --> 00:18:47,550
.وأخيرًا أستطيع العودة إلى العمل

314
00:18:47,550 --> 00:18:48,100
ماذا؟

315
00:18:48,100 --> 00:18:49,450
!مـ- انتظري لحظة

316
00:18:49,450 --> 00:18:53,640
تعلم أنّ شخصيّة وخلفيّات اللّعبة تُرسم عادةً على حدة، صحيح؟

317
00:18:53,640 --> 00:18:59,040
.لكن في نادي الفنون، يُرسم المجسّم والخلفيّة في نفس الصّورة

318
00:18:59,040 --> 00:19:01,930
.ذلك الاختلاف كان يضايقني قليلًا

319
00:19:01,930 --> 00:19:03,940
!تمهّلي يا إريري

320
00:19:03,940 --> 00:19:05,410
ما الأمر يا تومويا؟

321
00:19:05,410 --> 00:19:08,620
أتنوين تغيير أسلوبكِ في هذه المرحلة؟

322
00:19:08,620 --> 00:19:10,380
!سأغيّر كلّ شيء

323
00:19:10,380 --> 00:19:12,920
—سألوّنها أوّلًا، ثم أمسحها بالماسح الضّوئي

324
00:19:12,920 --> 00:19:16,170
إذًا كم من الصّفحات أكملتِ حتّى الآن؟

325
00:19:16,170 --> 00:19:18,720
!أخبرتك بأنّي بدأت للتّو

326
00:19:18,720 --> 00:19:20,260
إذًا فقد تبقّت خمس صور؟

327
00:19:20,260 --> 00:19:21,590
مع تبقّي يومٍ واحدٍ فحسب؟

328
00:19:21,590 --> 00:19:24,080
!أجل، خمس صورٍ على الأقل

329
00:19:24,080 --> 00:19:26,870
!لكن قد أنجز أكثر من ذلك إن شعرت برغبةٍ لفعلها

330
00:19:26,870 --> 00:19:28,600
!يستحيل أن تنهي كلّ ذلك

331
00:19:28,600 --> 00:19:29,810
!أستطيع

332
00:19:30,260 --> 00:19:33,810
.أستطيع فعلها طالما أنّك تعقد الآمال عليّ

333
00:19:34,330 --> 00:19:37,380
.أعجبني المسار الّذي كتبته

334
00:19:37,380 --> 00:19:38,840
.أحببته

335
00:19:38,840 --> 00:19:42,600
،قد تكون النّهاية السّعيدة موظّفةً قسرًا

336
00:19:42,600 --> 00:19:44,870
.لكنّها غمرتني بسعادةٍ لا توصف

337
00:19:45,550 --> 00:19:47,230
.لهذا السّبب سأرسمها

338
00:19:47,230 --> 00:19:50,620
.سأنهيها بلا أدنى شكّ، بغضّ النّظر عمّا يقوله أيّ كان

339
00:19:51,090 --> 00:19:53,110
!أنا هنا يا روري

340
00:19:53,110 --> 00:19:54,380
!من هنا

341
00:19:57,540 --> 00:19:59,580
أين نحن ذاهبان يا أوني-تشان؟

342
00:19:59,580 --> 00:20:00,740
!اتبعيني فحسب

343
00:20:00,740 --> 00:20:02,320
.صباح الخير يا سيجي-كُن

344
00:20:02,320 --> 00:20:03,370
.صباح الخير يا ميجوري

345
00:20:03,370 --> 00:20:05,090
!اهرب يا أوني-تشان

346
00:20:05,090 --> 00:20:06,500
!روري، روري

347
00:20:06,500 --> 00:20:07,740
...لطالما

348
00:20:07,740 --> 00:20:10,510
!أريد أن أنقذ روري يا سيجي-كُن

349
00:20:10,510 --> 00:20:11,640
.فلنعد معًا إلى الموطن

350
00:20:11,640 --> 00:20:13,610
.ميجوري وروري والجميع

351
00:20:13,610 --> 00:20:14,510
.روري

352
00:20:14,510 --> 00:20:15,980
.شكرًا لكِ يا ميجوري

353
00:20:15,980 --> 00:20:16,860
.سيجي-كُن

354
00:20:16,860 --> 00:20:18,130
!أوني-تشان

355
00:20:18,130 --> 00:20:19,380
!لقد عدنا

356
00:20:19,380 --> 00:20:21,970
.ميجوري، روري. أهلاً بعودتكما

357
00:20:21,970 --> 00:20:25,060
!مهلًا يا روري! أنتِ تبالغين في التّشبّث بسيجي-كُن

358
00:20:25,060 --> 00:20:28,320
وما المانع! صحيح يا أوني-تشان؟

359
00:20:28,320 --> 00:20:29,450
!هيّا

360
00:20:29,450 --> 00:20:31,040
...أنتما الاثنتان

361
00:20:31,040 --> 00:20:32,270
!صِدقًا

362
00:20:32,270 --> 00:20:35,500
.لا، أريد أن أسمعها منك

363
00:20:36,030 --> 00:20:38,510
!أنّك تثِق بقدرتي على فعلها

364
00:20:38,510 --> 00:20:40,850
!أنّني بارعةٌ حقًّا

365
00:20:40,850 --> 00:20:42,090
!أنّني عبقريّة

366
00:20:42,910 --> 00:20:45,180
!لِذا أخبرني بأن أرسم

367
00:20:46,930 --> 00:20:47,550
...أنتِ

368
00:20:49,110 --> 00:20:53,060
.افعلي ما يحلو لكِ

369
00:22:23,020 --> 00:22:24,590
.فعلتها

370
00:22:25,190 --> 00:22:27,220
.فعلتها يا تومويا

371
00:22:28,050 --> 00:22:30,910
.سأرسلها لك الآن

372
00:22:30,910 --> 00:22:32,230
!إريري

373
00:22:32,230 --> 00:22:32,900
ما الخطب؟

374
00:22:32,900 --> 00:22:33,740
!تماسكي

375
00:22:34,230 --> 00:22:36,850
.أنا بخيرٍ يا تومو-كُن

376
00:22:36,850 --> 00:22:40,040
.سأستعيد عافيتي بحلول الغد

377
00:22:40,440 --> 00:22:44,400
.لِذا دعنا نلعب بعض الألعاب حينها

378
00:22:46,090 --> 00:22:46,810
!أيّتها الحمقاء

379
00:22:46,810 --> 00:22:48,300
!أفيقي

380
00:22:48,300 --> 00:22:49,570
!إريري