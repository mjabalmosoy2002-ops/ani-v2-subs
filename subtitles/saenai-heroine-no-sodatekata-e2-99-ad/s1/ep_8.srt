1
00:00:02,480 --> 00:00:04,270
...لطالما كانت

2
00:00:05,860 --> 00:00:07,230
...كاتو

3
00:00:37,100 --> 00:00:40,140
.حسنًا، لنمضي معًا إلى اجتماع المجموعة يا كاتو

4
00:00:41,890 --> 00:00:45,900
.يبدو أنّ حيلة تظاهري بالنّوم قد انطلت عليكِ

5
00:00:45,900 --> 00:00:50,230
حسنٌ، لقد كنتٙ نائمًا بالفعل، أليس كذلك يا أكي-كُن؟

6
00:00:50,780 --> 00:00:54,030
!كانت نيّتي أن أتظاهر بالنّوم فحسب

7
00:02:25,580 --> 00:02:28,160
ماذا عن إريري وكاسوميغاوكا-سينباي؟

8
00:02:28,160 --> 00:02:29,500
!لن تحضرا اليوم

9
00:02:30,540 --> 00:02:32,210
ألم أخبركِ بذلك؟

10
00:02:32,210 --> 00:02:33,840
أحقًّا فعلت؟

11
00:02:33,840 --> 00:02:35,510
!والآن، تعالي معي

12
00:02:36,340 --> 00:02:38,380
هل سنستخدم غرفة الإذاعة؟

13
00:02:38,380 --> 00:02:40,510
.أجل، الظّروف تتطلّب ذلك

14
00:02:49,060 --> 00:02:50,690
أ-أكي-كُن؟

15
00:03:06,620 --> 00:03:11,120
،في الواقع كنت أنوي طبع هذا على الورق

16
00:03:11,120 --> 00:03:13,380
.لكنّ الحبر نفذ من طابعتي

17
00:03:16,300 --> 00:03:19,050
.إذًا هذا ما في الأمر

18
00:03:19,630 --> 00:03:20,720
،بعبارةٍ أخرى

19
00:03:20,720 --> 00:03:26,560
،إبراز أمورٍ بجلاء مثل مواقف البطلة المعقّدة ومشاعرها المتغيّرة

20
00:03:26,560 --> 00:03:32,690
هو الجوهر الّذي يخلق بطلةً ثنائيّة الأبعاد
.أكثر جاذبيّة يمكن أن تقع حقًّا في حبّها

21
00:03:33,520 --> 00:03:35,270
أهذا صحيح؟

22
00:03:35,270 --> 00:03:38,320
،اللّعبة الّتي خططّت لها في البداية

23
00:03:38,320 --> 00:03:41,200
،سلّطت الضّوء على جاذبيّة البطلة

24
00:03:41,200 --> 00:03:45,780
.هدفي كان جعلكِ بطلةً رئيسيّة تجعل القلوب تتسارع

25
00:03:45,780 --> 00:03:47,370
حـ-حقًّا؟

26
00:03:47,910 --> 00:03:52,330
.لكن النّتيجة النّهائيّة كانت شيئًا مختلفًا كلّيًا عن الهدف الأصليّ

27
00:03:52,330 --> 00:03:55,080
.كانت قصّةً رومنسيّة عاطفيّة وملحميّة

28
00:03:55,080 --> 00:03:58,760
،بالطّبع كنت مؤيّدًا للتّغييرات الجديدة

29
00:03:58,760 --> 00:04:01,630
،ومع موهبة أوتاها-سينباي وإريري

30
00:04:01,630 --> 00:04:04,970
.لاقت اللّعبة نجاحًا باهرًا

31
00:04:04,970 --> 00:04:05,760
...إنّما

32
00:04:05,760 --> 00:04:07,890
أتسمح لي بسؤال؟

33
00:04:07,890 --> 00:04:09,470
ما الأمر يا كاتو؟

34
00:04:09,470 --> 00:04:11,890
ما هذه الملفّات بالتّحديد؟

35
00:04:11,890 --> 00:04:15,310
ألم تقرئي عنوان الصّفحة الأولى يا كاتو؟

36
00:04:15,310 --> 00:04:17,650
—لا أقصد هذا

37
00:04:17,650 --> 00:04:20,990
!من الجليّ أنّه مقترح مشروع لعبتنا التّالية

38
00:04:23,280 --> 00:04:26,410
لماذا تريني هذا؟

39
00:04:26,410 --> 00:04:27,240
!كاتو

40
00:04:27,240 --> 00:04:29,240
أنتِ بالفعل لم تقرئيه، أليس كذلك؟

41
00:04:29,240 --> 00:04:31,540
!هذا المقترح النّابع من روحي

42
00:04:31,540 --> 00:04:34,870
!كانو ميجوري ستكون البطلة الرّئيسيّة لهذه اللّعبة مجدّدًا

43
00:04:34,870 --> 00:04:37,710
!وهذا يعني أنّها ستكون مقتبسةً عن كاتو ميجومي

44
00:04:37,710 --> 00:04:43,090
أتعتقد حقًّا أنّي سأسعد بالمشاركة في هذا المشروع؟

45
00:04:43,090 --> 00:04:44,630
.لا أعلم ذلك

46
00:04:44,630 --> 00:04:45,720
.لا أدري

47
00:04:46,090 --> 00:04:47,010
...لكن

48
00:04:47,390 --> 00:04:50,810
.إن لم تنضمّي فإنّ هذا المشروع لن يرى النّور

49
00:04:51,180 --> 00:04:53,730
،حتّى لو انضمّت كلّ الأخريات

50
00:04:53,730 --> 00:04:57,400
.من دونكِ لن نستطيع صنع هذه اللّعبة

51
00:04:58,150 --> 00:05:01,860
.لا أرى حاجةً من تعنّتك حيال ذلك

52
00:05:01,860 --> 00:05:04,150
...نموذجٌ للبطلة للرّئيسيّة

53
00:05:04,150 --> 00:05:06,490
،إنّه دورٌ معقّدٌ ومملّ

54
00:05:06,490 --> 00:05:09,330
...ومبهم المعنى

55
00:05:09,330 --> 00:05:11,200
،ثمّة ما أندم عليه

56
00:05:12,410 --> 00:05:16,790
.حظينا بأمهر الأعضاء، وصنعنا أفضل لعبة

57
00:05:16,790 --> 00:05:18,880
.الجميع قاموا بعملٍ رائع

58
00:05:19,210 --> 00:05:22,670
.إريري، أوتاها-سينباي، ميتشيرو

59
00:05:22,670 --> 00:05:23,920
.وأنتِ كذلك يا كاتو

60
00:05:24,470 --> 00:05:27,970
.واصل الجميع بذل كلّ ما لديهم حتّى آخر لحظة

61
00:05:27,970 --> 00:05:31,260
.هذا صحيح. الجميع بذلوا قصرى جهدهم

62
00:05:31,260 --> 00:05:33,270
.لِذا لا داعي للمزيد

63
00:05:33,270 --> 00:05:35,770
.لا سبب للاستمرار

64
00:05:35,770 --> 00:05:39,520
.لكنّي لم آخذكِ بعد إلى ذلك المكان

65
00:05:40,190 --> 00:05:41,570
ذلك المكان؟

66
00:05:42,020 --> 00:05:45,360
،خلف المكان الّذي تأخذنا إليه جهودنا

67
00:05:45,360 --> 00:05:47,950
،مكانٌ يغمر قلبكِ سعادةً وبهجة

68
00:05:48,530 --> 00:05:50,660
...لكن مع القليل من الحزن

69
00:05:50,660 --> 00:05:52,540
.ذلك التّنفيس عن المشاعر

70
00:05:53,790 --> 00:05:56,870
.أنا الوحيد الّذي لم يبذل قصارى جهده

71
00:05:56,870 --> 00:05:59,460
،توقّفت عن الرّكض في آخر لحظة

72
00:05:59,460 --> 00:06:01,250
.دون أن حرّك ساكنًا

73
00:06:02,340 --> 00:06:04,260
!هذا هو انتقامي

74
00:06:04,260 --> 00:06:07,300
!لن أسمح لكِ بالاستيقاظ من الحلم هذه المرّة

75
00:06:07,300 --> 00:06:09,640
!سأجعلكِ في الصّدارة طوال المسيرة

76
00:06:09,640 --> 00:06:13,260
!سأجعلكِ تعجزين الإقلاع عن صناعة الألعاب أو عن كونكِ أوتاكو

77
00:06:13,640 --> 00:06:14,850
!هذا صحيح

78
00:06:14,850 --> 00:06:16,680
.لعب دور البطلة الرّئيسيّة كان محض إعلانٍ خادع

79
00:06:16,680 --> 00:06:18,020
!عذرٌ مقنعٌ لا غير

80
00:06:18,560 --> 00:06:22,860
!هذه المرّة أريد ببساطة أن أحتفل معكِ في النّهاية

81
00:06:22,860 --> 00:06:24,940
...لهذا، لهذا بالذّات

82
00:06:24,940 --> 00:06:29,700
لا خيار أمامي سوى كتابة مقترح مشروعٍ
!لا يسعكِ رفض المشاركة فيه

83
00:06:32,370 --> 00:06:35,200
في تلك الحالة، لماذا؟

84
00:06:35,200 --> 00:06:40,040
لماذا مقترح مشروعك ليس إلّا أوهامك المحرجة والجامحة؟

85
00:06:40,040 --> 00:06:44,460
أهذا حقًّا ما تعتقد أنّه لن يسعني رفض المشاركة فيه؟

86
00:06:44,460 --> 00:06:46,090
!هذا سيحدث ثورةً في تصنيف ألعاب محاكاة المواعدة

87
00:06:46,090 --> 00:06:48,840
وحدي القادر على تنفيذ هذا المشروع، صحيح؟

88
00:06:49,180 --> 00:06:50,930
.أتساءل

89
00:06:50,930 --> 00:06:54,220
.ما تريد فعله هو شيءٌ مألوفٌ في نظري

90
00:06:54,220 --> 00:06:57,730
!أحقًّا قرأتِ مقترح المشروع الّذي كتبته بدمي؟

91
00:06:57,730 --> 00:06:59,480
،الفكرة الرّئيسيّة لهذا المشروع

92
00:06:59,480 --> 00:07:01,270
،هي أخذ الأفكار الّتي يمكن لأيّ أحدٍ الإتيان بها

93
00:07:01,270 --> 00:07:04,400
—وتطبيقها بعمقٍ وشغفٍ لا يخطر على بال أحد

94
00:07:04,400 --> 00:07:05,730
.هذه هي الإشكالية يا أكي-كُن

95
00:07:05,730 --> 00:07:07,110
!ما هي يا كاتو-كُن؟

96
00:07:08,440 --> 00:07:12,990
تريد صناعة لعبةٍ بتلك الضّخامة مع طاقم العمل هذا؟

97
00:07:13,780 --> 00:07:19,960
،يبدو أنّ هناك شخصًا واحدًا مكلّفٌ بالإعداد والسّيناريو والإخراج

98
00:07:19,960 --> 00:07:21,250
أم أنّي أتخيّل؟

99
00:07:21,250 --> 00:07:22,330
!لا تقلقي

100
00:07:22,330 --> 00:07:25,710
!لأنّكِ ستساعدين ذلك الشّخص في الإعداد والإخراح

101
00:07:25,710 --> 00:07:27,760
.ماذا؟ لا أريد، فذلك متعب

102
00:07:27,760 --> 00:07:32,470
لا مجال للتذمّر عندما تقفين أمام مشروعٍ على وشك
!أن يعيد كتابة تاريخ ألعاب محاكاة المواعدة

103
00:07:32,470 --> 00:07:33,430
...أكي-كُن

104
00:07:33,430 --> 00:07:35,390
.أرجوكِ يا كاتو

105
00:07:35,760 --> 00:07:37,220
،مرّةً أخرى

106
00:07:37,220 --> 00:07:38,640
،مرّةً أخرى فقط

107
00:07:38,640 --> 00:07:43,020
!كوني بطلتي الرّئيسيّة ونائبتي في المجموعة

108
00:07:43,730 --> 00:07:47,480
!أريدكِ أن تقودي معي هذه المجموعة

109
00:07:54,530 --> 00:07:57,200
أيمكنني أن أستوضح منك أمرًا ما؟

110
00:07:57,620 --> 00:07:58,700
.نعم

111
00:07:58,700 --> 00:08:03,620
هل أخبرت إريري بأنّك ستجعلني البطلة الرّئيسيّة مجدّدًا؟

112
00:08:03,620 --> 00:08:04,880
.ليس بعد

113
00:08:04,880 --> 00:08:06,710
ألا بأس بذلك؟

114
00:08:07,040 --> 00:08:09,510
أيمكنك حقًّا اتّخاذ هذا القرار دون استشارة إريري؟

115
00:08:10,670 --> 00:08:12,470
.أصغي يا كاتو

116
00:08:12,470 --> 00:08:15,970
،أعلم أنّ هذا بعيد الاحتمال

117
00:08:15,970 --> 00:08:19,310
،لكن هل سبب غضبكِ منّي مؤخّرًا

118
00:08:19,310 --> 00:08:24,850
،هو أنّ لديكِ أفكارًا متضاربة بشأن تقاربنا أنا وإريري مؤخّرًا

119
00:08:24,850 --> 00:08:29,730
أو شيئًا معقّدًا كهذا، كما في ألعاب محاكاة المواعدة؟

120
00:08:39,080 --> 00:08:41,450
عمّ تتحدّث يا أكي-كُن؟

121
00:08:41,450 --> 00:08:42,500
!بالطّبع ليس كذلك

122
00:08:42,500 --> 00:08:43,370
!بالطّبع

123
00:08:43,370 --> 00:08:44,830
ماذا؟

124
00:08:45,120 --> 00:08:49,630
،أظننت أنّي وقعت في حبّك

125
00:08:49,630 --> 00:08:52,720
غافلةً عن كلّ ما اقترفته في حقّي؟

126
00:08:52,720 --> 00:08:55,300
!لكن كما تعلمين، هذا يحدث كثيرًا في ألعاب محاكاة المواعدة

127
00:08:55,300 --> 00:08:59,260
!بطلةٌ تقع في الحبّ مع مرور الوقت دون سببٍ معيّن

128
00:08:59,260 --> 00:09:06,100
ذلك على الأرجح بسبب أنهنّ من إنشاء أشخاصٍ أمثالك
.لا يعلمون شيئًا عن العلاقات في العالم الواقعيّ

129
00:09:06,100 --> 00:09:08,150
!سامحيني، توقّفي عن رشقي بلسانك

130
00:09:08,150 --> 00:09:09,770
!ارحميني

131
00:09:09,770 --> 00:09:14,150
وما غير هذا أقول عندما تتفوّه بشيءٍ سخيفٍ كهذا؟

132
00:09:15,950 --> 00:09:18,030
.أنا آسفٌ حقًّا يا كاتو

133
00:09:18,030 --> 00:09:19,490
.لا تهتم

134
00:09:19,490 --> 00:09:22,040
.أريد فقط أن أُذهِب ذلك من ذاكرتي

135
00:09:22,040 --> 00:09:25,960
.لا، ليس هذا. أنا أتحدّث عن السّنة المنصرمة

136
00:09:25,960 --> 00:09:27,040
السّنة المنصرمة؟

137
00:09:28,000 --> 00:09:30,210
.آسفٌ لأنّي لم أطلب مساعدتكِ

138
00:09:30,210 --> 00:09:32,170
.آسفٌ لأنّي لم أعوّل عليكِ

139
00:09:32,170 --> 00:09:35,630
.آسفٌ لأنّي خذلتكِ كصديق

140
00:09:36,340 --> 00:09:37,380
...هذا

141
00:09:37,380 --> 00:09:39,180
.لكن أشكركِ

142
00:09:39,180 --> 00:09:40,970
.أنا سعيدٌ جدًا

143
00:09:42,310 --> 00:09:43,100
لماذا؟

144
00:09:43,100 --> 00:09:44,980
،لأنّكِ يا كاتو

145
00:09:44,980 --> 00:09:47,480
!تحبّين بليسينغ سوفتوير أكثر منّي

146
00:09:48,480 --> 00:09:53,030
أحببتِها لدرجة أنّكِ لا تستطيعين مسامحتي
!على التخلّي عن كوميكت الشّتاء

147
00:09:53,030 --> 00:09:55,610
!جعلني ذلك سعيدًا، في قمّة السّعادة

148
00:09:55,610 --> 00:09:56,780
!سعادةٌ لا توصف

149
00:09:57,820 --> 00:10:00,950
.لهذا السّبب بالذّات، أتأسّف بشدّة

150
00:10:13,880 --> 00:10:16,300
.شكرًا لكِ يا كاتو

151
00:10:16,300 --> 00:10:19,220
...ما الّذي

152
00:10:20,140 --> 00:10:22,970
ما الّذي تتحدّث عنه؟

153
00:10:22,970 --> 00:10:24,520
.شكرًا لكِ

154
00:10:24,520 --> 00:10:26,730
.أشكركِ يا كاتو

155
00:10:27,980 --> 00:10:29,150
...وأيضًا

156
00:10:30,100 --> 00:10:31,310
.أنا آسفٌ حقًّا

157
00:10:31,980 --> 00:10:34,230
.آسف. آسف

158
00:10:37,900 --> 00:10:40,410
.آسف

159
00:10:44,160 --> 00:10:47,580
،أ-أتعلم يا أكي-كُن

160
00:10:47,580 --> 00:10:50,620
...كنتُ أكبت في نفسي طوال هذا الوقت

161
00:10:50,620 --> 00:10:51,170
.آسف

162
00:10:51,710 --> 00:10:54,340
،يمكنك التفوّه باعتذاراتك قدر ما تشاء

163
00:10:54,340 --> 00:10:57,050
.لكنّها لن تشفي غليلي

164
00:10:57,050 --> 00:10:58,420
.حسنٌ... نعم

165
00:10:59,380 --> 00:11:01,510
علامَ تبتسم؟

166
00:11:01,510 --> 00:11:05,060
!هذا يؤجّج من غضبي لا أكثر

167
00:11:06,020 --> 00:11:07,600
نحن رفاق، صحيح؟

168
00:11:07,600 --> 00:11:09,350
نحن أصدقاء، صحيح؟

169
00:11:09,350 --> 00:11:13,190
.إريري وكاسوميغاوكا-سينباي وهيودو-سان أيضًا

170
00:11:13,190 --> 00:11:15,110
.أ-أجل

171
00:11:15,110 --> 00:11:16,940
.وأنا كذلك

172
00:11:16,940 --> 00:11:24,530
وبين الرّفاق لا وجود للأسرار والخبايا
ولا قرارات تتّخذ خفية، صحيح؟

173
00:11:25,830 --> 00:11:30,210
ألم يجدر بك أن تحدّثنا عن كلّ شيء؟

174
00:11:31,290 --> 00:11:32,790
.أنتِ محقّة

175
00:11:33,290 --> 00:11:34,880
.كنتُ مخطئًا

176
00:11:36,550 --> 00:11:38,760
.استمتعت كثيرًا

177
00:11:38,760 --> 00:11:41,970
.المجموعة كانت أكثر متعةً ممّا تصوّرت

178
00:11:41,970 --> 00:11:42,930
...كاتو

179
00:11:42,930 --> 00:11:50,520
لهذا، الشّهران الماضيان اللّذان كنت فيهما بعيدةً
.عنك وعن الأخريات، كانا بغاية المشقّة

180
00:11:50,520 --> 00:11:51,690
.آسف

181
00:11:52,690 --> 00:11:53,940
،أخبرتك

182
00:11:54,230 --> 00:11:57,820
.اعتذاراتك لا وقع لها

183
00:12:01,820 --> 00:12:05,530
أتعتقد حقًّا أنّ هذا النّظام الجديد سيفلح؟

184
00:12:05,870 --> 00:12:09,080
،بالطّبع قد نواجه بعض الصّعوبات في البداية

185
00:12:09,080 --> 00:12:10,790
...لكن إن عملنا به بتأنٍّ واعتدنا عليه

186
00:12:10,790 --> 00:12:17,210
ما زلت أرى أنّ من المستحيل على مبتدئةٍ مثلي
.أن تتولّى منصب نائبة القائد

187
00:12:17,210 --> 00:12:20,210
.خصوصًا أنّ العضوات الأخريات أجدر منّي

188
00:12:20,210 --> 00:12:21,010
!لا تقلقي

189
00:12:21,340 --> 00:12:24,090
.فالقيّادة ليست شيئًا ذا أهميّة

190
00:12:25,590 --> 00:12:28,220
المعذرة، أيمكنك أخذ حزمة البصل تلك؟

191
00:12:28,220 --> 00:12:29,680
لِم البصل؟

192
00:12:29,680 --> 00:12:33,890
.فكّرت بأن أحضّر الكاري على العشاء

193
00:12:33,890 --> 00:12:35,520
ستحضّرين العشاء؟

194
00:12:35,520 --> 00:12:38,570
.لأنّ اجتماعنا سيطول اللّيلة على ما يبدو

195
00:12:38,940 --> 00:12:41,360
تظنّين أنّه سيطول؟

196
00:12:42,150 --> 00:12:47,450
إذًا فأنت ستطلب من كاسوميغاوكا-سينباي كتابة المسار الرّئيسيّ فقط؟

197
00:12:47,450 --> 00:12:48,280
.أجل

198
00:12:48,280 --> 00:12:50,830
،أوتاها-سينباي بدأت الجامعة لتوّها

199
00:12:50,830 --> 00:12:54,040
.كما أنّها مشغولةٌ بالعمل على روايتها الجديدة

200
00:12:55,420 --> 00:12:59,250
على الرّغم من أنّها في السّنة الماضية، عندما كان من المفترض
،أن تكون مشغولةً بامتحانات الالتحاق بالجامعة وروايتها

201
00:12:59,250 --> 00:13:02,510
.عملت على لعبةٍ كاملة

202
00:13:02,510 --> 00:13:05,260
،لـ-لكن حتّى لو كان مجرّد مسارٍ واحد

203
00:13:05,260 --> 00:13:09,010
!أتوقّع بأنّه سيكون أعظم أعمال كاسومي أوتاكو

204
00:13:09,010 --> 00:13:12,270
،لكن إن كنتَ ستعمل على بقيّة السّيناريو

205
00:13:12,270 --> 00:13:15,140
أفلن يكون هناك اختلافٌ كبيرٌ في الجودة؟

206
00:13:15,140 --> 00:13:17,520
!ما لنا الآن إلّا التّفاؤل، صحيح؟

207
00:13:17,520 --> 00:13:21,780
.حسنٌ، أعتقد أنّ على قائدنا أن يبذل قصارى جهده

208
00:13:22,230 --> 00:13:24,950
.حسنًا، سأذهب لدفع ثمن هذه

209
00:13:24,950 --> 00:13:27,240
.أعرني بعض الثّياب لاحقًا

210
00:13:27,240 --> 00:13:29,620
.أنت تنوين حقًّا قضاء اللّيلة في منزلي

211
00:13:32,040 --> 00:13:35,830
إذًا أما تزال إريري في حالة ركود؟

212
00:13:35,830 --> 00:13:36,670
.أجل

213
00:13:36,670 --> 00:13:41,210
.لِذا من الصّعب أن أطلب منها الآن تصميم جميع الشّخصيّات

214
00:13:43,420 --> 00:13:46,510
،لكن حتّى وإن أردنا إضافة رسّامٍ آخر

215
00:13:46,510 --> 00:13:54,980
هل تعرف أحدًا بنفس مهارة إريري، وغير منتسبٍ لمجموعةٍ أخرى
يمكنك أن تطلب منه الانضمام؟

216
00:13:54,980 --> 00:13:58,650
.أشكركِ على جعلي أدرك واقعنا المرير

217
00:14:00,520 --> 00:14:01,860
هل والداك في المنزل اليوم؟

218
00:14:01,860 --> 00:14:05,110
.في الواقع، إنّهما في ناغانو لحضور حفلٍ تأبينيّ عائليّ

219
00:14:05,110 --> 00:14:07,700
.ولن يعودا إلّا بعد يومين

220
00:14:07,700 --> 00:14:10,370
هذا النّمط مجدّدًا؟

221
00:14:11,580 --> 00:14:13,540
!المعذرة على الإزعاج

222
00:14:14,870 --> 00:14:18,170
.أنتِ بالفعل لا تبالين بأيّ شيء

223
00:14:19,460 --> 00:14:21,040
،كما أسلفت

224
00:14:21,040 --> 00:14:25,300
.لعبتنا تشيري بليسينغ آلت لتكون لعبةً مذهلة

225
00:14:25,300 --> 00:14:31,350
.لكن ليس بسبب أنّ مقترحي— اللّعبة الّتي هدفت لصناعتها كانت مذهلة

226
00:14:31,350 --> 00:14:36,560
.حسنٌ، لقد حصلت على دعم كاسوميغاوكا-سينباي وإريري

227
00:14:37,270 --> 00:14:41,940
.لهذا في مشروعنا القادم سنعود إلى تصوّر بليسينغ سوفتوير الأصليّ

228
00:14:42,940 --> 00:14:46,360
.لعبةٌ تكتسب سحرها من اللّحظات اليومية الخالية من الهمّ

229
00:14:46,360 --> 00:14:47,280
حقًّا؟

230
00:14:47,280 --> 00:14:49,240
،الشّخصيّات ستكون أكثر "موي" من لعبتنا السّابقة

231
00:14:49,240 --> 00:14:52,160
.لكنّها ستكون مؤثّرةً بقصّةٍ بسيطة

232
00:14:52,160 --> 00:14:54,790
—سنجتذب اللّاعبين بسحركِ الحقيقيّ

233
00:14:54,790 --> 00:14:56,080
ما رأيك؟

234
00:15:03,540 --> 00:15:04,880
.يبدو جيّدًا

235
00:15:05,800 --> 00:15:09,630
،كلّ ما في الأمر أنّ الألعاب الّتي تركّز على التّواصل مع البطلات

236
00:15:09,630 --> 00:15:12,390
تميل إلى الاعتماد كثيرًا على النّظام، صحيح؟

237
00:15:12,390 --> 00:15:15,390
،تتطلّب منكِ إدارة صحّة وجدول البطل الزّمنيّ

238
00:15:15,390 --> 00:15:18,270
،واختيار مكان الموعد والهديّة من بين ثلاثة خيارات

239
00:15:18,270 --> 00:15:20,980
.والضّغط على الشّاشة لتقبيل الفتيات

240
00:15:20,980 --> 00:15:23,310
.حقًّا؟ هذا رائع

241
00:15:24,480 --> 00:15:27,070
.بالفعل، مثل تلك الألعاب رائعة

242
00:15:27,070 --> 00:15:31,740
.لكنّي أريد صنع لعبة مغامراتٍ ترتكز على القصّة بدلًا من ذلك

243
00:15:31,740 --> 00:15:34,910
.أعتقد أنّ ذلك سيمنحها لمسة أكي تومويا المميّزة

244
00:15:34,910 --> 00:15:36,240
ما رأيكِ يا كاتو؟

245
00:15:36,240 --> 00:15:38,120
...حسنٌ، أتساءل

246
00:15:38,120 --> 00:15:39,710
!هذا شيءٌ بالغ الأهميّة

247
00:15:39,710 --> 00:15:43,500
!أقصد أنّي أحبّ قصص الفتيات اللّائي أحبّهنّ

248
00:15:43,500 --> 00:15:47,670
أنت حقًّا لا تشعر بالإحراج حين يتعلّق الأمر
بالأبعاد الثّنائيّة، أليس كذلك يا أكي-كُن؟

249
00:15:48,340 --> 00:15:49,760
.على كلٍّ، أنصتي

250
00:15:49,760 --> 00:15:51,220
.أنصتي إليّ الآن

251
00:15:51,220 --> 00:15:52,090
.حسنًا، حسنًا

252
00:15:52,380 --> 00:15:54,010
.هذا عسيرٌ بالفعل

253
00:15:54,010 --> 00:15:56,470
.قد تصبح أسوأ من لعبتنا السّابقة

254
00:15:56,850 --> 00:15:58,220
.قد لا تكون مبيعاتها جيّدة

255
00:15:58,220 --> 00:16:00,020
.قد يذمّها اللّاعبون

256
00:16:00,020 --> 00:16:01,850
—مع ذلك، أنا

257
00:16:02,350 --> 00:16:03,480
.حبّة أرزّ

258
00:16:08,690 --> 00:16:10,740
.هذا ما ستبدو عليه اللّعبة

259
00:16:10,740 --> 00:16:13,070
تقصد محض لعبة محاكاة مواعدة مدرسيّة عاديّة؟

260
00:16:13,070 --> 00:16:16,870
.أجل. لا ذكرياتٍ من حياةٍ سالفة. لا داءً عضال. لا قفزاتٍ عبر الزّمن

261
00:16:16,870 --> 00:16:18,660
.ولا عوالم متوازية سخيفة

262
00:16:18,660 --> 00:16:22,920
،سنوفّر ببساطة محادثاتٍ اعتياديّة
.أحداث الحياة اليوميّة وظرافة بطلاتنا

263
00:16:22,920 --> 00:16:27,420
لكن ألم يوظّفوا كلّ ذلك في هذه اللّعبة والألعاب الأخرى؟

264
00:16:27,420 --> 00:16:31,340
.لا، ثمّة شيءٌ لم ترقَ له هذه اللّعبة

265
00:16:31,340 --> 00:16:32,970
.في الواقع هما شيئان

266
00:16:34,340 --> 00:16:36,430
.الأوّل هو المحادثات الاعتياديّة

267
00:16:36,430 --> 00:16:40,220
،رغم أنّ مشاهد المحادثات بين البطل والبطلات تقع في أغلب أطوار اللّعبة

268
00:16:40,220 --> 00:16:44,270
.إلّا أنّها مملّةٌ بشكلٍ لا يصدّق ومضجرة وغير مبرّرةٍ بتاتًا

269
00:16:44,270 --> 00:16:47,190
.إذًا علينا الاحتراز من ذلك

270
00:16:47,190 --> 00:16:49,230
.والثّاني هو ردود فعل البطلات

271
00:16:49,230 --> 00:16:51,110
.إنّها مكرّرةٌ بشكلٍ مبالغ

272
00:16:51,110 --> 00:16:53,490
،التسونديري، الأخت الصّغرى، الأخت الكبرى

273
00:16:53,490 --> 00:16:55,910
!إنّهنّ يتّبعن نفس النّموذج فحسب

274
00:16:55,910 --> 00:16:59,160
لكن ألم تقل أنّ النّماذج مهمّة؟

275
00:16:59,160 --> 00:17:01,200
.أجل، إنّها مهمّة. بالغة الأهميّة

276
00:17:01,200 --> 00:17:03,410
!لكن البطلات بشر أيضًا يا كاتو

277
00:17:03,830 --> 00:17:07,210
،اعتمادًا على الوقت الّذي قضيناه معكِ ومشاعرهنّ آنذاك

278
00:17:07,210 --> 00:17:09,500
من البديهيّ أن تتغيّر ردود أفعالهنّ، صحيح؟

279
00:17:09,500 --> 00:17:11,460
ستتغيّر مواقفكِ عندما تقعين في الحبّ، صحيح؟

280
00:17:11,460 --> 00:17:13,970
تتحدّثين بأسلوبٍ مختلف عندما تطول معرفتكما ببعض، صحيح؟

281
00:17:13,970 --> 00:17:16,130
!وبلباقةٍ وتدرّج

282
00:17:16,130 --> 00:17:18,180
!أجل، ولا يمكنكِ تغيير ذلك دفعةً واحدة أيضًا

283
00:17:18,180 --> 00:17:20,010
!فذلك سيعكّر صفو اللّاعبين

284
00:17:20,010 --> 00:17:22,180
.لهذا بالذّات يجب أن يكون التّغيير تدريجيًّا

285
00:17:22,180 --> 00:17:23,430
،مع تباينٍ كبير

286
00:17:23,430 --> 00:17:26,520
—نبرز جاذبيّة البطلات كبشر

287
00:17:27,100 --> 00:17:28,230
كاتو؟

288
00:17:28,230 --> 00:17:29,310
...أكي-كُن

289
00:17:30,940 --> 00:17:33,400
.اجلس هناك للحظة

290
00:17:33,400 --> 00:17:35,780
.أ-أنا جالسٌ بالفعل

291
00:17:36,320 --> 00:17:40,330
!كما قلتٙ يا أكي-كُن، العلاقات تتغيّر

292
00:17:40,330 --> 00:17:41,660
.هـ-هذا صحيح

293
00:17:41,660 --> 00:17:48,210
أعتقد أنّ عليك أن تغيّر مواقفك وأفعالك، استنادًا
.على الوقت الّذي قضيتموه معًا ومشاعرك اتّجاههنّ

294
00:17:48,210 --> 00:17:55,130
.ومع ذلك لا أفهم سبب عدم تغيّر تصرّفاتك وأقوالك في كوميكت الشّتاء

295
00:17:55,130 --> 00:17:59,090
إن كنت ملمًّا بهذا، فلمَ لم تفعل ذلك من أجلي؟

296
00:17:59,390 --> 00:18:02,640
ألسنا قريبين بما يكفي لتصلك مشاعري؟

297
00:18:02,640 --> 00:18:05,180
!ظننتكِ قد سامحتني على ذلك

298
00:18:05,180 --> 00:18:07,770
،أدركت أنّك لم تستوعب شيئًا البتّة

299
00:18:07,770 --> 00:18:09,560
!وهذا ما أغضبني مجدّدًا

300
00:18:09,560 --> 00:18:10,520
!مهلًا لحظة

301
00:18:10,520 --> 00:18:12,190
!هدّئي من روعكِ يا كاتو

302
00:18:12,190 --> 00:18:15,030
قلتَ أنّ بطلات الألعاب بشرٌ أيضًا، صحيح؟

303
00:18:15,030 --> 00:18:16,820
!صحيح، هذا صحيحٌ تمامًا

304
00:18:16,820 --> 00:18:20,450
!أنا الأخرى، البطلة الرّئيسيّة، بشريّةٌ أيضًا

305
00:18:21,160 --> 00:18:23,040
.يبدو أنّني أذرف الدّموع مجدّدًا

306
00:18:23,700 --> 00:18:27,830
!بالمناسبة، ما هذا العنوان " كيف تنمّي بطلةً مملّة"؟

307
00:18:24,040 --> 00:18:25,700
...حـ-حسنٌ

308
00:18:26,120 --> 00:18:27,210
...حسنٌ

309
00:18:27,210 --> 00:18:28,120
.آسف

310
00:18:27,830 --> 00:18:30,960
،أعلم أنّك أخبرتني عدّة مرّات أنّ شخصيّتي هامدة

311
00:18:30,960 --> 00:18:33,960
!لكن لم أتصوّر قطّ أنّك ستضع ذلك في العنوان

312
00:18:33,960 --> 00:18:35,960
!يمكنني تغييره إن لم يعجبكِ

313
00:18:36,760 --> 00:18:38,470
،أتعلم

314
00:18:38,470 --> 00:18:41,930
،إن كنت غير قادرٍ حتّى على قراءة ردود أفعالي

315
00:18:41,930 --> 00:18:46,350
أتظنّ حقًّا أنّك تمتلك ما يلزم لصناعة لعبةٍ حسّاسةٍ كتلك؟

316
00:18:46,350 --> 00:18:51,480
.حسنٌ، كل ما أستطيع قوله حاليًّا هو أنّي سأبذل جهدي

317
00:18:51,480 --> 00:18:53,110
،بغضّ النّظر عن مجهودك

318
00:18:53,110 --> 00:18:56,400
.لعلّك تفتقر تمامًا للفهم الّذي تتطلّبه

319
00:18:56,400 --> 00:18:59,360
!سـ-سأدرس الموضوع قدر استطاعتي

320
00:18:59,360 --> 00:19:05,200
ألست تحاول القيام بشيءٍ أكثر صعوبةً من لعبتنا السّابقة؟

321
00:19:05,200 --> 00:19:07,620
...ا-الأهمّ من هذا يا كاتو

322
00:19:07,620 --> 00:19:09,160
ما الأمر؟

323
00:19:09,160 --> 00:19:12,330
،بما أنّكِ أردتِ الاستحمام لإراحة أعصابكِ

324
00:19:12,330 --> 00:19:15,880
.فينبغي عليكِ الاستمتاع به بدل توبيخي

325
00:19:15,880 --> 00:19:19,170
.صِدقًا. اصمت

326
00:19:19,170 --> 00:19:21,640
من الملام هنا برأيك؟

327
00:19:21,640 --> 00:19:22,510
.آسف

328
00:19:22,510 --> 00:19:26,850
!أخبرتك أنّ اعتذاراتك اليوم لا وقع لها

329
00:19:26,850 --> 00:19:27,680
.آسف

330
00:19:27,680 --> 00:19:29,180
!صِدقًا

331
00:19:29,180 --> 00:19:33,440
!ليس وكأنّي أردت جلب هاتفي معي إلى الحمّام

332
00:19:33,440 --> 00:19:34,690
...أكي-كُن

333
00:19:37,070 --> 00:19:40,280
إذًا، ما الّذي ستفعله قُدمًا؟

334
00:19:40,280 --> 00:19:43,570
.أعتقد أنّي سأحاول أوّلًا إقناع العضوات الأخريات

335
00:19:44,030 --> 00:19:49,660
أتساءل إن كانت كاسوميغاوكا-سينباي
.ستواصل العمل معنا بعدما تخرّجت

336
00:19:49,660 --> 00:19:52,670
.أعتقد أنّ كلّ ما بيدي فعله الآن هو التّعبير لها عن صدقِي

337
00:19:52,670 --> 00:19:55,420
أتعني الاعتراف لها بمشاعرك؟

338
00:19:55,420 --> 00:19:57,420
.اخلدي إلى النّوم رجاءً يا كاتو-سان

339
00:19:57,420 --> 00:20:02,380
وكيف ستتعامل مع ركود إريري؟

340
00:20:02,380 --> 00:20:03,800
...هذا

341
00:20:04,550 --> 00:20:06,970
.لا يسعني سوى منحها المزيد من الوقت

342
00:20:07,680 --> 00:20:11,310
أتظنّ حقًّا أنّ الوقت هو كلّ ما يلزمها لتخطّي ذلك؟

343
00:20:11,310 --> 00:20:13,190
،لا أعرف

344
00:20:13,190 --> 00:20:16,440
.لكنّي لا أعرف أيضًا ماذا أفعل غير ذلك

345
00:20:16,440 --> 00:20:20,860
أكان عليك أن تركّز عليّ بينما لا تعرف أيّ شيءٍ بعد؟

346
00:20:20,860 --> 00:20:22,110
.اخلدي إلى النّوم فحسب

347
00:20:22,110 --> 00:20:24,570
.لا تلمني على ما قد يحدث يا أكي-كُن

348
00:20:25,160 --> 00:20:27,950
إذًا ماذا عليّ أن أفعل؟

349
00:20:27,990 --> 00:20:30,700
!لا علم لي أيضًا

350
00:20:30,700 --> 00:20:32,120
.صِدقًا

351
00:20:32,120 --> 00:20:34,830
.أنتِ تعبثين اليوم كثيرًا يا كاتو

352
00:20:35,420 --> 00:20:36,840
.أنت محقّ

353
00:20:38,090 --> 00:20:39,840
.اسمع يا أكي-كُن

354
00:20:39,840 --> 00:20:40,840
ما الأمر؟

355
00:20:41,550 --> 00:20:45,970
.انسٙ ما كنت عليه اليوم بحلول الغد

356
00:20:45,970 --> 00:20:48,350
.أجل، أعلم

357
00:20:48,640 --> 00:20:50,520
.لكنّي لن أفعل

358
00:20:50,520 --> 00:20:51,980
.تذكّرت

359
00:20:54,270 --> 00:20:55,770
ما الأمر الآن؟

360
00:20:56,560 --> 00:20:58,150
.تفضّل يا أكي-كُن

361
00:20:58,150 --> 00:21:00,530
،إنّها إلزاميّة بالطّبع

362
00:21:00,530 --> 00:21:01,740
.لكن اقبلها

363
00:21:01,740 --> 00:21:03,700
.شكرًا لكِ

364
00:21:03,700 --> 00:21:06,110
.حسنًا، سأخلد الآن إلى النّوم

365
00:21:06,110 --> 00:21:06,950
.نعم

366
00:21:18,340 --> 00:21:19,590
.طابت ليلتكِ

367
00:21:18,340 --> 00:21:19,590
.طابت ليلتك