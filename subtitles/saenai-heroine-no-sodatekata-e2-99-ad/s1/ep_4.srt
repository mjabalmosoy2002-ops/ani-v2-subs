1
00:00:06,520 --> 00:00:08,690
أين ذهب يا ترى؟

2
00:00:31,130 --> 00:00:32,970
.هذا سيّئٌ يا أكي-كُن

3
00:00:32,970 --> 00:00:38,640
.هذا القرار يحمل معنى بالغ لكاسوميغاوكا-سينباي

4
00:00:38,640 --> 00:00:40,640
.أتساءل إن كان يعلم ذلك

5
00:00:40,640 --> 00:00:42,560
!لماذا تأبى أن تفهم؟

6
00:00:42,560 --> 00:00:44,020
!أيّها الأخلاقيّ

7
00:00:44,020 --> 00:00:46,350
!هذا ليس ما أردت معرفته

8
00:00:46,350 --> 00:00:48,520
!هذا ليس ما أطلبه منك

9
00:00:48,820 --> 00:00:56,450
!لِم عليك أن تنظر دائمًا إلى الأمور من منظورٍ خاطئ؟

10
00:02:28,540 --> 00:02:30,630
!مرحبًا بعودتك يا سيّدي

11
00:02:30,630 --> 00:02:32,750
.بشكلٍ عام، هذا يضعنا أمام مشكلتين

12
00:02:32,750 --> 00:02:35,800
،الأولى أنّنا بينما نقترب من الذّروة

13
00:02:35,800 --> 00:02:39,090
.يصبح نصّكِ أقرب إلى رواية

14
00:02:39,090 --> 00:02:42,970
.تبالغين في وصف ملامح الشّخصيّات وأفكارها وبتفصيلٍ مفرط

15
00:02:42,970 --> 00:02:45,970
.وذلك يعيق وتيرة تقدّم اللّعبة

16
00:02:48,560 --> 00:02:52,480
.لا حاجة لكتابة نصٍّ عن أشياء يمكن مشاهدتها على الشّاشة

17
00:02:52,480 --> 00:02:54,610
.في الواقع إنّها بمثابة عائق

18
00:02:54,610 --> 00:02:58,150
أتريد القول أنّها ستكون أفضل بدون نثري؟

19
00:02:58,150 --> 00:03:01,660
.اللّاعب يضغط على زرٍّ للتّقدّم في ألعاب الرّوايات المرئيّة

20
00:03:01,660 --> 00:03:03,320
،إن كان الضّغط على الزّرّ لا يحرّك شيئًا

21
00:03:03,320 --> 00:03:06,490
.فلن تشعري بأنّكِ من يحرّك القصّة

22
00:03:06,490 --> 00:03:08,580
.وذلك يضرّ باللّعبة

23
00:03:09,080 --> 00:03:11,170
.ثمّ تأتي المشكلة الثّانية

24
00:03:11,170 --> 00:03:12,420
—هذا أكثر أهميّة

25
00:03:12,420 --> 00:03:13,460
!هذا يكفي

26
00:03:14,040 --> 00:03:19,260
أتحاول دحضي بتجنّب الإجابة عمّا أريد معرفته؟

27
00:03:19,260 --> 00:03:21,470
.أنت جريءٌ حقًّا يا أخلاقيّ-كُن

28
00:03:21,470 --> 00:03:24,010
،لستُ أحاول دحضكِ

29
00:03:24,010 --> 00:03:26,310
،وليس حتّى أعمالكِ السّابقة

30
00:03:26,310 --> 00:03:29,350
!أنا أتحدّث عن سيناريو هذه اللّعبة بالذّات لا غير

31
00:03:26,390 --> 00:03:28,770
كاسوميغاوكا-سان؟

32
00:03:29,350 --> 00:03:30,440
!أصغِ

33
00:03:30,440 --> 00:03:32,350
!قولي لشيءٍ كهذا ليس مشكلتي

34
00:03:30,940 --> 00:03:33,940
...المعذرة، هلّا أخفضتما صوتكما

35
00:03:32,350 --> 00:03:33,940
!ما قصدكِ بـ"شيءٍ كهذا"؟

36
00:03:34,270 --> 00:03:36,020
!هذه لعبتنا

37
00:03:36,020 --> 00:03:39,400
!إنّها ثمرة أرواحنا الّتي بذلنا فيها أقصى جهودنا

38
00:03:39,400 --> 00:03:40,990
!هذا السّيناريو لن يجدي

39
00:03:40,990 --> 00:03:44,120
،إنّها قصّةٌ رائعة، لكن لأسبابٍ لا علاقة لها بذلك

40
00:03:44,120 --> 00:03:45,990
!فإنّها لن تنفع أبدًا

41
00:03:45,990 --> 00:03:47,740
.أنا أشتاط غضبًا

42
00:03:47,740 --> 00:03:51,250
.أريد أن ألكم نفسي لعدم ملاحظتي للأمر حتّى الآن

43
00:03:51,660 --> 00:03:53,540
...لأنّ هذه

44
00:03:53,540 --> 00:03:55,250
!ليست اللّعبة الّتي أردت صناعتها

45
00:04:05,930 --> 00:04:07,930
!أ-أوتاها-سينباي

46
00:04:10,680 --> 00:04:12,310
!آ-آسف

47
00:04:14,940 --> 00:04:16,190
!أوتاها-سينباي

48
00:04:22,860 --> 00:04:25,820
.إنّها ليست غلطتكِ يا أوتاها-سينباي

49
00:04:25,820 --> 00:04:28,240
.أنا الملام بمثابتي المخرج

50
00:04:28,240 --> 00:04:31,250
.لم ألحظ الأمر لأنّني قرأتها على شكل ملفّاتٍ نصيّة فقط

51
00:04:31,830 --> 00:04:34,830
.ظلّلني تميّز القصّة وكمالها

52
00:04:34,830 --> 00:04:38,340
.النّصف الثّاني خصوصًا أشبه برواية

53
00:04:38,340 --> 00:04:40,760
.لم يكن سيناريو للعبة

54
00:04:40,760 --> 00:04:42,170
.لكن لا بأس

55
00:04:42,170 --> 00:04:44,340
.ما زال أمامنا متّسعٌ من الوقت

56
00:04:44,340 --> 00:04:47,260
.لِذا دعينا نصحّح هذا السّيناريو

57
00:04:47,260 --> 00:04:51,770
،إن لم تقتنعي بفعل ذلك، فسأصحّحه بنفسي

58
00:04:51,770 --> 00:04:56,900
،على الأرجح أنّ الجودة ستقلّ كقصّةٍ خالصة

59
00:04:56,900 --> 00:04:58,270
.لكنّي سأفعلها رغم ذلك

60
00:04:58,860 --> 00:05:01,730
.لأنّني أنا المخرج

61
00:05:01,730 --> 00:05:04,650
،حتّى وإن رفضتِ فعلها مهما حدث

62
00:05:04,650 --> 00:05:05,400
.فسأفعلها

63
00:05:30,100 --> 00:05:33,430
.إذًا فالسّيناريو يحتاج لأن يُعاد النّظر فيه

64
00:05:34,680 --> 00:05:37,400
.قال أكي-كُن أنه بصدد تصحيحه بنفسه

65
00:05:37,400 --> 00:05:38,940
ماذا عن كاسوميغاوكا أوتاها؟

66
00:05:39,360 --> 00:05:41,360
.يبدو أنّها معه في غرفته

67
00:05:41,360 --> 00:05:42,530
.فهمت

68
00:05:42,530 --> 00:05:43,280
ماذا؟

69
00:05:43,280 --> 00:05:47,490
ماذا حلّ بجملتكِ المعهودة "كـ-كـ-كـ-كاسوميغاوكا أوتاها!"؟

70
00:05:47,490 --> 00:05:50,990
من تخالينني يا ميجومي؟

71
00:05:50,990 --> 00:05:53,330
.إنّهما يراجعان السّيناريو

72
00:05:53,330 --> 00:05:55,330
.رُفض السّيناريو الّذي كتبته للتّو

73
00:05:55,330 --> 00:05:57,420
ما الّذي قد يحدث؟

74
00:05:57,420 --> 00:05:59,330
.أتساءل حيال ذلك

75
00:05:59,330 --> 00:06:02,040
.هذا إن كانت مبدعة

76
00:06:02,040 --> 00:06:06,130
.أتفهّم ما تشعر به كاسوميغاوكا أوتاها حاليًّا

77
00:06:06,130 --> 00:06:07,260
.فهمت

78
00:06:07,260 --> 00:06:08,590
،بالإضافة

79
00:06:08,590 --> 00:06:11,470
.لا يمكنني أن أشغل بالي بالآخرين حاليًّا

80
00:06:11,470 --> 00:06:14,470
،فهناك الكثير من العمل ينتظرني

81
00:06:14,470 --> 00:06:17,600
.لِذا عليّ أن أنجز الآن قدر ما أستطيع

82
00:06:17,600 --> 00:06:20,150
أيعني هذا أنّكِ لن تشاركي في المهرجان المدرسيّ؟

83
00:06:20,150 --> 00:06:23,070
ألن تشاركي في منافسة ملكة جمال تويوغاساكي لهذه السّنة؟

84
00:06:23,070 --> 00:06:25,570
فزتِ بها السّنة الفارطة، أليس كذلك؟

85
00:06:25,570 --> 00:06:29,110
.هذا يمنحني عذرًا مثاليًّا لعدم المشاركة هذه السّنة

86
00:06:30,070 --> 00:06:32,370
.حسنًا، لا أريد أن أطيل عليكِ

87
00:06:32,370 --> 00:06:33,280
.سأنهي المكالمة

88
00:06:33,280 --> 00:06:34,700
.شكرًا على اتّصالكِ

89
00:06:34,700 --> 00:06:35,660
.أراكِ لاحقًا

90
00:07:23,580 --> 00:07:26,340
!يا ويلي! لقد غفوت

91
00:07:26,340 --> 00:07:27,250
هل استيقظت؟

92
00:07:27,250 --> 00:07:28,010
!لم أكن نائمًا

93
00:07:28,010 --> 00:07:29,720
!لم أكن نائمًا مطلقًا

94
00:07:35,300 --> 00:07:37,680
.شارفت على إنهاء المراجعة

95
00:07:38,810 --> 00:07:40,690
...أوتاها-سينباي

96
00:07:43,690 --> 00:07:46,360
.صباح الخير يا أخلاقيّ-كُن

97
00:07:52,280 --> 00:07:53,200
،وعلاوةً على ذلك

98
00:07:53,200 --> 00:07:57,450
قمت بكتابة ملاحظات حول الجوانب الّتي لا أوافقك الرّأي فيها
.والأجزاء الّتي ارتكبت فيها أخطاءً واضحة

99
00:07:57,450 --> 00:08:02,210
.كما أنّي قد أشّرت على أخطاء الهِجاء والكلمات المفقودة بقدر ما أمكنني

100
00:08:02,210 --> 00:08:04,710
.لِذا فلنبدأ النّقاش بناءً على هذا

101
00:08:04,710 --> 00:08:05,710
قمتِ بكلّ هذا؟

102
00:08:06,090 --> 00:08:08,420
،المطبوع الّذي منحني جائزة مؤلّف السّنة الصّاعد

103
00:08:08,420 --> 00:08:12,130
.أدرجت فيه ماتشيدا-سان ضعف هذا العدد من الملاحظات

104
00:08:13,550 --> 00:08:15,090
—المعذرة يا أوتاها-سينباي

105
00:08:15,090 --> 00:08:18,260
.استغرق منّي الأمر سنتين لتخفيضها إلى رقمين

106
00:08:18,260 --> 00:08:21,480
.الكتابة مهنةٌ عسيرةٌ حقًّا

107
00:08:21,480 --> 00:08:23,770
...حسنٌ، هذا

108
00:08:23,770 --> 00:08:31,150
.وبالطّبع ما كان لينجح أوّل سيناريو لعبةٍ أكتبه من المحاولة الأولى

109
00:08:35,280 --> 00:08:37,990
والآن يا أخلاقيّ-كُن، هلّا بدأنا؟

110
00:08:38,330 --> 00:08:39,200
!حسنًا

111
00:08:40,660 --> 00:08:43,870
،سأعيد بناءها اعتمادًا على تغييراتي على النّص

112
00:08:43,870 --> 00:08:45,040
لكن ما رأيكِ؟

113
00:08:45,040 --> 00:08:48,130
أواثقٌ أنّك تريد أن تقتصر على مثل هذه الحوارات فقط؟

114
00:08:48,130 --> 00:08:51,880
.في نظري، أشعر أنّها طفيفة

115
00:08:51,880 --> 00:08:55,380
.للألعاب العديد من المقوّمات المميّزة الأخرى

116
00:08:55,380 --> 00:08:57,760
.لا بأس بأن يكون الأساس طفيفًا

117
00:08:58,390 --> 00:09:03,640
.لن يكون مستوى المراجعة هذا بتلك الصّعوبة حالما أعتاد عليه

118
00:09:04,230 --> 00:09:07,520
.ينبغي أن أكون قادرةً على إنهائه في يومٍ واحد

119
00:09:07,520 --> 00:09:09,570
.ليس عليكِ القيام بكلّ ذلك

120
00:09:09,570 --> 00:09:12,230
.يكفي أن تراجعي ما قمتُ بتغييره

121
00:09:12,230 --> 00:09:14,490
.مراجعة هذا لا يعدّ شيئًا

122
00:09:14,900 --> 00:09:16,410
.المستحيل هو هذا

123
00:09:16,410 --> 00:09:19,240
.السّيناريوهان يسلكان منحيين مختلفين كلّيًّا

124
00:09:19,580 --> 00:09:23,200
،صحيحٌ أنّ مسار ميجوري هو حبكة أكشن ومغامرة

125
00:09:23,200 --> 00:09:25,250
.ومسار روري حبّ مأساويّ

126
00:09:25,250 --> 00:09:27,750
،في مسار ميجوري عادا إلى يومهما الحاضر

127
00:09:28,170 --> 00:09:31,840
.لكن في مسار روري، انتهى بها الحال تهوم في الزّمكان

128
00:09:31,840 --> 00:09:35,130
،حصل الجميع على نهايةٍ سعيدة في مسار ميجوري ما عدا روري

129
00:09:35,130 --> 00:09:39,390
.لكن في مسار روري، وحدها روري والبطل وجدا سعادةً طفيفة

130
00:09:40,600 --> 00:09:44,230
.لِذا إن أضفتهما معًا في لعبةٍ واحدة فذلك سيخلّ بالموضوع العام

131
00:09:44,230 --> 00:09:46,810
وما الخطب في ذلك؟

132
00:09:46,810 --> 00:09:49,980
!ها أنتِ تفكّرين كروائيّةٍ مجدّدًا يا أوتاها-سينباي

133
00:09:49,980 --> 00:09:54,530
،وجود خليطٍ من المواضيع، دون معرفة أين ستأخذكِ

134
00:09:54,530 --> 00:09:56,400
!هو ما يميّز ألعاب محاكاة المواعدة

135
00:09:56,780 --> 00:09:58,780
.ثمّة قاعدتان في ألعاب محاكاة المواعدة

136
00:09:58,780 --> 00:10:00,990
،وهما أنّ على البطلات أن يكنّ ظريفات

137
00:10:00,990 --> 00:10:02,910
.وألّا تتقيّد بالقواعد

138
00:10:03,240 --> 00:10:11,290
إ-إذًا هل تهدف لصنع لعبةٍ عشوائيّة بمسارين مختلفين كلّيًّا؟

139
00:10:11,290 --> 00:10:14,170
.لا، أنتِ مخطئة يا أوتاها-سينباي

140
00:10:16,380 --> 00:10:18,510
.ستحتوي على ثلاثة مسارات

141
00:10:19,640 --> 00:10:20,890
أأنت أحمق؟

142
00:10:20,890 --> 00:10:22,260
.ربّما

143
00:10:22,640 --> 00:10:25,680
تريد إضافة مسارٍ آخر في هذه المرحلة؟

144
00:10:25,680 --> 00:10:27,520
وبنهاية هذا الأسبوع؟

145
00:10:27,520 --> 00:10:32,610
هذا لأنّ علينا تسليم السّيناريو النّهائيّ لإريري بحلول يوم الاثنين
.وإلّا لن تجد متّسعًا من الوقت لحدث الصّور

146
00:10:32,610 --> 00:10:36,240
إذًا لماذا تقترح الآن شيئًا غير عقلانيّ كهذا؟

147
00:10:36,240 --> 00:10:36,900
...هذا

148
00:10:37,570 --> 00:10:42,370
.لم أستطع تمالك نفسي بسبب سحر البطلات اللّائي ابتدعتِهنّ

149
00:10:43,990 --> 00:10:49,790
.أردت رؤية قصّةٍ حيث تعيش هؤلاء البطلات معًا في سعادة

150
00:10:50,210 --> 00:10:54,210
،قد يتعارض ذلك مع أسلوب كاسومي أوتاكو الأدبيّ

151
00:10:54,210 --> 00:10:56,920
،لكن مع كلّ هذه الشّخصيّات الّتي أحبّها

152
00:10:56,920 --> 00:11:00,800
.سيحزّ في نفسي عدم وجود مستقبلٍ يحمل لها السّعادة جميعًا

153
00:11:03,550 --> 00:11:04,930
،معك حقّ

154
00:11:04,930 --> 00:11:07,310
.هذا مختلفٌ عن أسلوبي الأدبيّ

155
00:11:07,680 --> 00:11:09,980
.لهذا لن أكتبه

156
00:11:09,980 --> 00:11:10,730
—في هذه الحالة

157
00:11:10,730 --> 00:11:12,270
،يكفي أن أقول

158
00:11:12,860 --> 00:11:14,690
،إن كنت متلهّفًا لصناعتها إلى هذا الحدّ

159
00:11:14,690 --> 00:11:16,780
.فيمكنك كتابته بنفسك

160
00:11:16,780 --> 00:11:19,780
،رغم أنّه شيءٌ لا ينبغي أن تقوله مبدعةٌ للمخرج

161
00:11:20,150 --> 00:11:24,120
لكن لا ضرر من أن تقول مبدعةٌ ذلك لزميلٍ مبدع، صحيح؟

162
00:11:24,120 --> 00:11:24,830
أواثقة؟

163
00:11:25,450 --> 00:11:27,450
،بما أنّك من أتى بهذه الفكرة السّخيفة

164
00:11:27,450 --> 00:11:29,580
.فتحمّل مسؤوليّتها حتّى النّهاية

165
00:11:31,000 --> 00:11:32,000
ألا بأس بهذا؟

166
00:11:32,000 --> 00:11:36,800
ألا بأس حقًّا بمزج السّيناريو خاصّتكِ بتفاهاتي؟

167
00:11:36,800 --> 00:11:38,340
عمّ تتحدّث؟

168
00:11:38,340 --> 00:11:41,050
.إنّه ممتزجٌ بالفعل

169
00:11:41,050 --> 00:11:44,260
.جزءٌ منك أصبح بداخلي بالفعل

170
00:11:44,260 --> 00:11:47,220
تقصدين أنّ تنقيحاتي بداخل السّيناريو خاصّتكِ، صحيح؟

171
00:11:47,640 --> 00:11:49,350
،وأيضًا يا أخلاقيّ-كُن

172
00:11:49,350 --> 00:11:52,140
أنسيت ما قلتَه قبل قليل بهذه السّرعة؟

173
00:11:52,900 --> 00:11:56,070
القاعدة هي ألّا تتقيّد بالقواعد، صحيح؟

174
00:11:59,070 --> 00:12:01,740
ما-ما رأيكِ بهذا؟

175
00:12:01,740 --> 00:12:04,870
كتبت كلّ هذا في نصف يومٍ فحسب؟

176
00:12:04,870 --> 00:12:06,780
.سرعتك هذه مثيرةٌ للإعجاب

177
00:12:06,780 --> 00:12:08,040
حـ-حقًّا؟

178
00:12:13,870 --> 00:12:16,380
،على سبيل المثال، هذا الجزء

179
00:12:16,750 --> 00:12:19,670
ما الهدف من إضافتك لهذا الحوار؟

180
00:12:20,170 --> 00:12:25,890
أتظنّ أنّ هذا المحتوى التّافه قادرٌ على وصف جوهر الشّخصيّة؟

181
00:12:26,800 --> 00:12:29,100
...الشّخصيّة، المشاعر، العلاقات

182
00:12:29,100 --> 00:12:34,060
.عليك أن تفكّر بكيفية توظيف تلك المعلومات في النّص بينما تكتب

183
00:12:34,060 --> 00:12:39,650
هذا الحشو المطوّل والّذي لا معنى له هو علامة
.على عدم الكفاءة سواءً في الألعاب أو الرّوايات

184
00:12:39,650 --> 00:12:42,990
،بما أنّك كنت واثقًا كفاية لتنتقد السّيناريو الّذي كتبته

185
00:12:42,990 --> 00:12:44,610
،فكّرت بأن أدعك تتكفّل بهذا

186
00:12:44,610 --> 00:12:46,870
.لكن هذا لا يتعدّى كونه عمل مبتدئ

187
00:12:46,870 --> 00:12:49,450
بعبارةٍ أخرى، عليّ أن أعيد كتابته؟

188
00:12:49,450 --> 00:12:50,450
.لا

189
00:12:50,450 --> 00:12:52,710
.أتمّ كتابة البقيّة أوّلًا

190
00:12:52,710 --> 00:12:55,040
.التّدقيق سيكون بعد إتمامك الكتابة

191
00:12:55,040 --> 00:12:58,840
.لن تكمله إطلاقًا إن بدأت من الصّفر كلّ مرّة

192
00:12:58,840 --> 00:13:02,720
لكن ماذا لو كان كلّ ما كتبته غير مناسبٍ للاستخدام؟

193
00:13:02,720 --> 00:13:04,220
،وقتها

194
00:13:04,220 --> 00:13:06,340
.سأبذل كلّ ما بوسعي لتنقيحه

195
00:13:06,340 --> 00:13:08,050
...أوتاها-سينباي

196
00:13:08,050 --> 00:13:09,600
.اعتمد عليّ

197
00:13:10,060 --> 00:13:14,600
.سأساعدك في نزوتك هذه بكلّ ما أوتيت

198
00:13:14,600 --> 00:13:18,810
.أرجوكِ لا تقوليها بطريقةٍ تصعّب عليّ شكرك

199
00:13:20,820 --> 00:13:22,610
.لا يا روري

200
00:13:22,610 --> 00:13:26,030
!لن أتخلّى عنكِ أبدًا

201
00:13:26,490 --> 00:13:28,070
!سنعود معًا إلى الوطن

202
00:13:28,070 --> 00:13:31,370
!يجب أن تتواجد هناك روري وميجوري والجميع

203
00:13:32,330 --> 00:13:34,200
!قطعًا لن أقبل بغير ذلك

204
00:14:03,820 --> 00:14:05,400
أين وصلت؟

205
00:14:06,610 --> 00:14:08,610
.أنا في مشهد وداع روري

206
00:14:08,610 --> 00:14:09,780
.أرني

207
00:14:11,870 --> 00:14:16,870
.سنضع هنا خيارًا للّحاق بروري وتشعيب القصّة

208
00:14:17,210 --> 00:14:20,380
ما رأيكِ بهذا؟

209
00:14:20,380 --> 00:14:22,710
.أخبريني إن كانت هناك أيّ مشكلة

210
00:14:22,710 --> 00:14:24,380
.هناك مشكلة

211
00:14:25,380 --> 00:14:27,380
.أعجز عن التّفكير بسبب النّعاس

212
00:14:28,800 --> 00:14:30,640
.خذي قسطًا من النّوم

213
00:14:30,640 --> 00:14:32,550
.سأواصل العمل عليها لبعض الوقت

214
00:14:36,020 --> 00:14:38,560
.إذن فلتوقظني بعد ساعتين

215
00:14:38,560 --> 00:14:39,520
.مفهوم

216
00:14:39,520 --> 00:14:40,560
.طابت ليلتكِ

217
00:14:41,310 --> 00:14:43,070
أيمكنني إطفاء الأنوار؟

218
00:14:43,070 --> 00:14:44,780
.أجل. بالطّبع

219
00:14:45,440 --> 00:14:46,820
.طابت ليلتك

220
00:15:25,270 --> 00:15:26,940
!ها نحن

221
00:15:26,940 --> 00:15:29,360
!أيّها الأحمق هيرويوكي

222
00:15:31,450 --> 00:15:32,570
.أخبرني يا أخلاقيّ-كُن

223
00:15:33,950 --> 00:15:34,830
ماذا؟

224
00:15:35,160 --> 00:15:39,540
أتظنّ حقًّا أنّ مثل هذه النّهاية السّعيدة الخالية من الأحزان موجودة؟

225
00:15:40,120 --> 00:15:41,620
ولِم لا؟

226
00:15:41,620 --> 00:15:42,620
،أعتذر عن قول هذا

227
00:15:43,080 --> 00:15:46,040
.لكن لا أظنّ أنّ لروري أيّ حقٍّ لتسعد

228
00:15:46,040 --> 00:15:47,800
أهذا شيءٌ يصدر من مبتدعتها؟

229
00:15:47,800 --> 00:15:50,670
.أقصد أنّ غيرتها تصل حدّ الهوس

230
00:15:50,670 --> 00:15:56,260
حتّى أنّها حاولت التخلّص من ميجوري
.والبطلات الأخريات لتستأثر البطل لنفسها

231
00:15:56,260 --> 00:15:58,890
.لكن هذا ما أحبّه في روري

232
00:15:59,850 --> 00:16:02,100
إذن هي أم ميجوري، أيّ منهما تحبّ أكثر؟

233
00:16:02,100 --> 00:16:04,810
.بالطّبع أحبّ كليهما

234
00:16:04,810 --> 00:16:08,610
.فهما البطلتان الرّئيسيتان اللّتان أنشأناهما

235
00:16:09,570 --> 00:16:12,650
.لا أقصد على هذا النّحو

236
00:16:13,280 --> 00:16:15,990
،ميجوري وروري تتصارعان على البطل

237
00:16:15,990 --> 00:16:18,080
،تصبحان ظريفتين بغيرتهما

238
00:16:18,080 --> 00:16:20,250
...جاعلتين الجميع يضحك في سخط

239
00:16:20,250 --> 00:16:23,870
ألا تريدين رؤية نهايةٍ هنيئةٍ كتلك؟

240
00:16:23,870 --> 00:16:30,300
.ثمّة جزءٌ منّي يرى أنّ ذلك بعيد المنال، وجزءٌ آخر يودّ رؤية ذلك

241
00:16:30,300 --> 00:16:34,550
.هذا ما تتمحور حوله العلاقة بين روري وميجوري

242
00:16:45,940 --> 00:16:47,520
.لا أستطيع الحراك

243
00:16:47,520 --> 00:16:49,900
.هذا مؤسفٌ حقًّا

244
00:16:49,900 --> 00:16:53,030
.يمكنني الآن أن أفعل بك ما أشاء

245
00:16:53,030 --> 00:16:56,910
تقصدين إبراحي ضربًا، أليس كذلك؟

246
00:16:59,740 --> 00:17:02,370
.آسفٌ يا أوتاها-سينباي

247
00:17:02,370 --> 00:17:04,460
.لا داعي للاعتذار

248
00:17:04,830 --> 00:17:08,540
.لكنّني أفسدت السّيناريو الّذي كتبتِه

249
00:17:08,540 --> 00:17:11,510
.غيّرت طباع الشّخصيّات والإعداد

250
00:17:11,510 --> 00:17:16,550
،رغم أنّ تلك الشّخصيّات الّتي تغيّرت تعيش في عالمٍ متغيّر

251
00:17:17,090 --> 00:17:19,930
.لكن تانك الفتاتان لم تلقيا حتفهما

252
00:17:21,180 --> 00:17:22,520
.هما على قيد الحياة

253
00:17:22,520 --> 00:17:26,190
.ذرفتا الدّموع، ضحكتا، وأحبّتا

254
00:17:26,190 --> 00:17:30,570
.قراءتها— أقصد لعبها أسعدني كثيرًا

255
00:17:30,570 --> 00:17:32,030
.كانت ممتعة

256
00:17:32,030 --> 00:17:33,570
.أثارت حماسي

257
00:17:33,570 --> 00:17:35,700
...أوتاها-سينباي

258
00:17:36,200 --> 00:17:42,580
.هذا ليس شيئًا بوسع أحدٍ آخر أو حتّى أنت أو أنا أن يصنعه بمفرده

259
00:17:42,580 --> 00:17:47,170
.إنّه السّيناريو الأصليّ خاصّتنا

260
00:18:16,030 --> 00:18:19,110
.وهكذا تمكّنا من إتمام السّيناريو بطريقةٍ ما

261
00:18:19,820 --> 00:18:22,160
.وبهذا أكون قد أزحتُ واجبي عن كاهلي

262
00:18:26,580 --> 00:18:28,000
.سأدعكِ تتكفّلين بالباقي

263
00:18:28,500 --> 00:18:31,750
.يجب أن أعود لكتابة روايتي

264
00:18:32,790 --> 00:18:35,460
بالمناسبة، أتسمحين لي بسؤال؟

265
00:18:35,460 --> 00:18:36,260
ما هو؟

266
00:18:39,840 --> 00:18:44,720
روري هي سايوكا من رواية ميترونوم الحبّ، صحيح؟

267
00:18:44,720 --> 00:18:48,440
.قرأت كليهما عدّة مرّات

268
00:18:48,440 --> 00:18:50,900
،السّبب في أنّ الأمر يبدو كذلك يا كاتو-سان

269
00:18:51,610 --> 00:18:54,730
.هو أنّ كليهما يستند على نفس الشّخص

270
00:18:55,280 --> 00:19:02,240
.كاتبةٌ انطوائيّة تفتقر للخبرة، لم يكن لها خيارٌ غير الاستلهام من أقرب مكان

271
00:19:02,820 --> 00:19:07,160
.امرأةٌ متجهّمة، انتقاميّة، وبغيضة

272
00:19:08,160 --> 00:19:12,000
.لطالما كانت شخصيّةً وحيدة

273
00:19:14,540 --> 00:19:16,380
،لهذا السّبب هذه المرّة

274
00:19:16,380 --> 00:19:19,300
أتمنّى حقًّا لو أنّها تكون المختارة

275
00:19:19,300 --> 00:19:21,260
.من طرف البطل-كُن

276
00:19:34,980 --> 00:19:37,780
.لا، لم يفت الأوان بعد

277
00:19:38,190 --> 00:19:43,740
.أعلم أنّكِ قادرةٌ على تغيير تلك البطلة المتجهّمة لتكون أكثر تألّقًا

278
00:19:44,830 --> 00:19:47,290
ما عساي أفعل؟

279
00:19:54,250 --> 00:19:55,130
.محال

280
00:19:55,710 --> 00:19:58,130
.متى انقطعت بي السّبل إلى هذه المنطقة الغريبة

281
00:20:00,880 --> 00:20:01,880
!أوني-تشان

282
00:20:04,640 --> 00:20:05,890
.أوني-تشان

283
00:20:08,310 --> 00:20:10,640
.يا أوني-تشان

284
00:20:16,190 --> 00:20:21,320
كيف طاوعتك نفسك أن تتجاهل روري؟

285
00:20:23,410 --> 00:20:24,820
روري؟

286
00:20:25,950 --> 00:20:28,540
.كنتُ أنادي عليك طوال الوقت

287
00:20:28,990 --> 00:20:30,200
،لسنوات

288
00:20:30,200 --> 00:20:31,660
،لعقود

289
00:20:31,660 --> 00:20:33,790
.دائمًا وأبدًا

290
00:20:34,620 --> 00:20:35,710
...كاتو

291
00:20:37,290 --> 00:20:39,550
،لا تنادِني بـ"كاتو" حاليًّا

292
00:20:40,880 --> 00:20:42,050
.يا أكي-كُن

293
00:20:43,130 --> 00:20:48,010
،لأنّني الآن روري وسايوكا

294
00:20:49,770 --> 00:20:51,270
...وأيضًا