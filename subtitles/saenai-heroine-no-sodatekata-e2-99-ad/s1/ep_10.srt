1
00:01:33,480 --> 00:01:36,740
إلى متى تنوين البقاء هنا؟

2
00:01:36,740 --> 00:01:38,200
.لقد غربت الشّمس بالفعل

3
00:01:38,200 --> 00:01:39,820
.اصمتي

4
00:01:39,820 --> 00:01:43,040
.إن كنتِ تعارضين الأمر، فيمكنكِ المغادرة قبلي

5
00:01:43,040 --> 00:01:45,580
لم يمضِ على وعكتكِ الصحيّة الكثير من الوقت، أليس كذلك؟

6
00:01:49,540 --> 00:01:51,170
.أنا لن أفعلها

7
00:01:51,170 --> 00:01:52,550
.فهمت

8
00:01:52,550 --> 00:01:56,550
.لن أشعر بالارتياح لرسمي تحت إمرة تلك المرأة الأنانيّة

9
00:01:56,550 --> 00:01:57,630
.قد يكون ذلك صحيحًا

10
00:01:57,630 --> 00:02:00,260
،كما أنّي سأدرس بالسّنة الثّالثة في أبريل

11
00:02:00,260 --> 00:02:02,350
.وسأتخرّج السّنة القادمة

12
00:02:02,350 --> 00:02:03,600
...بالإضافة

13
00:02:03,600 --> 00:02:05,730
...بالإضافة إلى أنّي حاليًّا

14
00:02:05,730 --> 00:02:07,440
لا تستطعين الرّسم بسبب ركودكِ؟

15
00:02:09,270 --> 00:02:15,860
.تلك هي المسألة الوحيدة الّتي أتّفق فيها مع كوساكا أكاني

16
00:02:15,860 --> 00:02:18,320
لماذا تقفين في صفّها؟

17
00:02:18,320 --> 00:02:20,570
ألستِ مغتاظة؟

18
00:02:25,540 --> 00:02:28,460
،على كلٍّ، فكّري في الأمر بنفسكِ

19
00:02:28,460 --> 00:02:31,750
.وقرّري بنفسكِ ما تريدين فعله

20
00:02:31,750 --> 00:02:34,500
...سبق وأخبرتكِ، أنا

21
00:02:34,500 --> 00:02:37,340
.أنتِ تسردين أسباب عدم قدرتكِ على فعلها لا غير

22
00:02:38,510 --> 00:02:40,800
.لم تقرّري أيّ شيءٍ بعد

23
00:02:40,800 --> 00:02:44,260
.ما تريدين فعله، ما تطمحين إليه

24
00:02:44,260 --> 00:02:46,890
...سواءً أردتِ الاستمرار كمبدعة، أو

25
00:02:46,890 --> 00:02:48,430
.هذا يكفي

26
00:02:48,430 --> 00:02:50,230
أتحاولين إقناعي لفعلها؟

27
00:02:50,230 --> 00:02:52,230
أتحاولين دفعي للانسحب من المجموعة؟

28
00:02:53,230 --> 00:02:54,820
.ليس هذا ما أفكّر فيه

29
00:02:54,820 --> 00:02:55,980
...لكن

30
00:03:03,910 --> 00:03:05,790
أتصدّقين ذلك؟

31
00:03:06,200 --> 00:03:08,080
!إنّها وقائع الميادين

32
00:03:08,080 --> 00:03:10,710
.كانت سلسلةً شهيرة حتّى قبل أن نولد

33
00:03:10,710 --> 00:03:13,920
!ويريدون منّي ومنكِ أن نعمل على جزءٍ جديد

34
00:03:13,920 --> 00:03:16,630
.جنبًا إلى جنب مع كوساكا أكاني

35
00:03:16,630 --> 00:03:19,720
!لكم كان ذلك المقترح مفصّلًا

36
00:03:21,050 --> 00:03:24,300
.أتساءل كيف ستكون اللّعبة عندما تكتمل

37
00:03:24,300 --> 00:03:27,220
.ربّما تؤول لتصبح أفضل جزءٍ في تاريخ السّلسلة في أسوأ الأحوال

38
00:03:27,220 --> 00:03:28,890
!والأكثر من ذلك

39
00:03:28,890 --> 00:03:31,770
—كوساكا أكاني تلك، قالت أنّها تحتاجني

40
00:03:34,190 --> 00:03:35,270
.آسفة

41
00:03:35,690 --> 00:03:38,280
.لا حاجة لأن تعتذري على شيء

42
00:03:38,280 --> 00:03:43,780
،ليس على حقيقة أنّ كوساكا أكاني أعدّت مقترحًا آخذةً انضمامكِ بالاعتبار

43
00:03:43,780 --> 00:03:46,160
.ولا على حقيقة أنّها استدعتني فقط لكي تستميلكِ

44
00:03:46,160 --> 00:03:47,700
!لـ-لحظة

45
00:03:50,080 --> 00:03:54,380
.سألتني قبل قليل إن كنتُ مغتاظة

46
00:03:54,380 --> 00:03:55,460
...هذا

47
00:03:56,170 --> 00:03:58,300
.حسنًا سأجيبكِ

48
00:03:58,300 --> 00:04:00,210
.أنا مغتاظة

49
00:04:00,210 --> 00:04:02,800
!بالطّبع سأكون مغتاظة بسبب ذلك

50
00:04:02,800 --> 00:04:06,890
!معاملتي كإضافةٍ لرسّامة دوجين هاوية مثلكِ

51
00:04:06,890 --> 00:04:10,140
!كيف لذلك ألّا يغيظ محترفةً مثلي؟

52
00:04:22,570 --> 00:04:24,910
.لِذا حضّري نفسكِ

53
00:04:25,280 --> 00:04:28,160
،إن قرّرتِ المشاركة في هذا المشروع

54
00:04:28,910 --> 00:04:31,660
.أعدكِ أنّي سأسحقكِ

55
00:04:32,580 --> 00:04:36,290
.وهكذا أكون قد قلت كلّ ما في جعبتي

56
00:04:36,290 --> 00:04:37,710
.سأترك الباقي عليكِ

57
00:04:37,710 --> 00:04:38,630
.إلى اللّقاء

58
00:04:39,920 --> 00:04:42,670
ماذا تقصدين بهذا؟

59
00:04:42,670 --> 00:04:45,760
أنّكِ ستنضمّين إذا انضممت؟

60
00:04:46,550 --> 00:04:48,600
.أفترض ذلك

61
00:04:48,600 --> 00:04:52,430
وإن رفضت، سترفضين أيضًا؟

62
00:04:52,810 --> 00:04:56,190
.إن حدث ذلك، فهم أساسًا لا يريدونني من دونكِ

63
00:04:56,190 --> 00:04:57,270
!ما هذا؟

64
00:04:57,270 --> 00:04:58,770
،تطلبين منّي أن أقرّر

65
00:04:58,770 --> 00:05:00,570
وتلقين عليّ عبء اتّخاذ القرار عنكِ أيضًا؟

66
00:05:01,110 --> 00:05:04,950
.لم يكن لديّ أساسًا أيّ خيارٍ في هذه المسألة يا ساوامورا-سان

67
00:05:04,950 --> 00:05:05,700
!مهلًا

68
00:05:05,700 --> 00:05:08,280
!تمهّلي لحظة يا كاسوميغاوكا أوتاها

69
00:05:08,280 --> 00:05:10,660
...محاولتكِ استفزاز الآخرين هكذا

70
00:05:11,950 --> 00:05:14,040
!لا يعقل

71
00:05:16,120 --> 00:05:21,420
.إن كان بالإمكان، أودّ أن أعمل معها مجدّدًا

72
00:05:21,420 --> 00:05:27,930
،مرّةً أخرى، مع رسم كاشيواجي إري
".أريد صنع لعبةٍ تتفوّق على "تشيري بليسينغ

73
00:05:29,350 --> 00:05:30,680
...لأنّ

74
00:05:30,680 --> 00:05:33,810
!كاسوميغاوكا أوتاها

75
00:05:31,180 --> 00:05:35,140
.قلبي حسم أمره بالفعل

76
00:05:34,680 --> 00:05:37,690
!ماذا يفترض بي أن أفعل؟

77
00:05:40,690 --> 00:05:41,690
.أكاني-سان

78
00:05:42,150 --> 00:05:44,650
.استيقظي رجاءً يا أكاني-سان

79
00:05:49,200 --> 00:05:53,290
.يبدو أنّ مفاوضاتكِ معهما باءت بالفشل

80
00:05:54,370 --> 00:05:55,910
.من يدري

81
00:05:56,330 --> 00:06:00,040
،لهذا أخبرتكِ أنّه إن أردتِ التقرّب منهما

82
00:06:00,040 --> 00:06:03,460
.فيجب أن تتواصلي أوّلًا مع قائد مجموعتهما أكي-كُن

83
00:06:03,460 --> 00:06:05,420
.وكأنّي أهتمّ

84
00:06:05,420 --> 00:06:12,970
.هما من أحتاج لصناعة اللّعبة الحماسيّة الّتي توصّلت إليها

85
00:06:16,560 --> 00:06:18,810
.أظنّني سمعت هذا من قبل في مكانٍ ما

86
00:06:19,770 --> 00:06:23,020
.سأبعث حياةً جديدة في وقائع الميادين

87
00:06:23,020 --> 00:06:25,940
.أنا، وتانك الاثنتان

88
00:06:25,940 --> 00:06:31,120
،محاولتكِ استمالة الآخرين بتلك الطّريقة

89
00:06:31,120 --> 00:06:35,660
.هي ما أكسبكِ أعداءً أكثر منّي يا أكاني-سان

90
00:06:35,660 --> 00:06:38,750
.سأخنع للموت إن توقّفت مبيعات أعمالي

91
00:06:38,750 --> 00:06:41,130
.فهذا هو العالم الوحيد الّذي يلائمني

92
00:06:43,630 --> 00:06:47,590
.لا أستطيع حصر نفسي في تلك الزّاوية بعد

93
00:06:47,590 --> 00:06:50,970
.تلك هي العقليّة الّتي تحتاجها إن كنت تهدف للقمّة

94
00:06:50,970 --> 00:06:53,970
.أريد أن أتريّث قليلًا

95
00:06:53,970 --> 00:06:57,730
،مع بعض الحرية ودون الكثير من الالتزامات

96
00:06:58,270 --> 00:07:00,480
.والاستمتاع رفقة الأصدقاء

97
00:07:02,690 --> 00:07:04,360
.فهمت

98
00:07:04,360 --> 00:07:06,230
.إذًا فأنت تنوي المغادرة

99
00:07:07,650 --> 00:07:09,610
.شكرًا لكِ على كلّ ما قدّمته لي

100
00:07:10,610 --> 00:07:13,450
:لكن تذكّر هذا يا يوري

101
00:07:13,780 --> 00:07:16,740
،ما دمت تحاول صنع اسمٍ لنفسك في هذا المجال

102
00:07:16,740 --> 00:07:19,160
.فليس هناك سبيلٌ مفروشٌ بالورود

103
00:07:19,160 --> 00:07:20,870
،مبغوضًا ومعنّفًا

104
00:07:20,870 --> 00:07:23,830
.ليس لك إلّا أن تشقّ طريقك بعزيمةٍ من حديد

105
00:07:24,540 --> 00:07:27,590
،حسنٌ، كنتُ أفكّر بأن ألقي عبء العمل على الآخرين

106
00:07:27,590 --> 00:07:31,090
!وأنصّب نفسي كوسيط

107
00:07:31,470 --> 00:07:36,470
هذا إن وجدت بسهولةٍ شركاء على استعدادٍ
.لحمل كلّ أعباء العمل على عاتقهم

108
00:07:38,140 --> 00:07:39,850
،سأعقد شراكةً مع شخصٍ مثلكِ مجدّدًا

109
00:07:39,850 --> 00:07:44,270
.شخصٌ أحمق يندفع إلى الأمام دون أن يلقي اعتبارًا لأيٍّ كان

110
00:07:52,070 --> 00:07:54,570
.فهمت، إذًا فأنتِ متردّدة

111
00:07:54,570 --> 00:07:55,990
.آسفة

112
00:07:55,990 --> 00:07:58,910
.أعلم أنّي أيضًا بدأت العمل للتّو على سلسلتي الجديدة

113
00:07:58,910 --> 00:08:00,250
.إطلاقًا

114
00:08:00,250 --> 00:08:05,500
.من حقّ المبدع أن يرغب بالمشاركة في مثل ذلك المشروع المغري

115
00:08:06,750 --> 00:08:07,800
،مع ذلك

116
00:08:07,800 --> 00:08:11,550
.سأحرص على أن يلتزم عملكِ معنا بالجدول الزّمنيّ

117
00:08:11,880 --> 00:08:16,850
،المؤلّفون الّذين يتولّون أكثر من عمل وتقتبس أعمالهم إلى أنمي

118
00:08:16,850 --> 00:08:19,100
،وينتهي بهم الحال عاجزين عن إكمال سلاسلهم

119
00:08:19,100 --> 00:08:21,350
.أكثر من أن أحصيهم

120
00:08:21,350 --> 00:08:25,400
.لن أتخلّى عن عملي هنا، لِذا لا تكتئبي وتستبقي الأمور

121
00:08:28,110 --> 00:08:31,150
إذًا ماذا ستفعلين بشأن مجموعتكِ؟

122
00:08:31,150 --> 00:08:33,240
لستِ قادرةً على القيام بثلاثة أعمالٍ في آنٍ واحد، صحيح؟

123
00:08:33,240 --> 00:08:34,490
...أنا

124
00:08:35,320 --> 00:08:37,200
.سأتخرّج على كلّ حال

125
00:08:37,200 --> 00:08:40,330
ماذا لو بكى أكي-كُن وترجّاكِ؟

126
00:08:40,330 --> 00:08:44,170
"!أرجوكِ ابقي معي إلى الأبد حتّى بعد تخرّجكِ"

127
00:08:45,210 --> 00:08:46,290
.شيءٌ كهذا

128
00:08:47,590 --> 00:08:49,340
.أنا محترفة

129
00:08:49,340 --> 00:08:52,010
.لن أدع المشاعر تتداخل مع عملي

130
00:08:52,010 --> 00:08:56,260
.واثقةٌ أنّ مشاعركِ كانت تقودكِ إلى وقتٍ قريب

131
00:08:56,260 --> 00:08:58,010
.شكرًا على القهوة

132
00:08:58,010 --> 00:08:59,560
.ينبغي عليّ الذّهاب

133
00:08:59,560 --> 00:09:00,600
...إذًا

134
00:09:02,060 --> 00:09:04,690
كيف حال أكاني؟

135
00:09:06,310 --> 00:09:08,360
هل تعرفان بعضكما؟

136
00:09:08,360 --> 00:09:11,730
.كنّا معًا بنادي المانجا في الجامعة

137
00:09:11,730 --> 00:09:15,280
.لكن لم تسنح لنا الفرصة للقاء بعضنا منذ بدأنا مسيرتنا المهنيّة

138
00:09:15,280 --> 00:09:20,200
ممّا يعني أنّها ستكون سينباي جامعتي؟

139
00:09:20,200 --> 00:09:22,370
.لا داعي لأن تشمئزّي كثيرًا من ذلك

140
00:09:22,370 --> 00:09:25,660
.فهي تظلّ سينباي لكِ في هذا المجال أيضًا

141
00:09:25,660 --> 00:09:30,880
أعتقد أنّه من غير المعقول أن تتوقّعي منّي
.ألّا أكرهها بعد الطّريقة الّتي عاملتني بها

142
00:09:30,880 --> 00:09:35,090
.كلّ ذلك بسبب أنّها مبدعةٌ خالصة

143
00:09:35,090 --> 00:09:39,640
.في نظري تبدو كمنتجةٍ سافلة وخبيثة لا غير

144
00:09:39,640 --> 00:09:42,520
،أعترف أنّها خسيسة

145
00:09:42,520 --> 00:09:45,020
،وتفعل كلّ ما يتطلّبه الأمر لتحقيق مساعيها

146
00:09:45,020 --> 00:09:47,940
...ولا تلقي أدنى اعتبارٍ لظروف الآخرين

147
00:09:48,310 --> 00:09:51,150
أوليست أسوأ منتجة؟

148
00:09:51,150 --> 00:09:55,530
.لكنّها لا تهدف إلى المال أو المكانة أو الشّهرة

149
00:09:55,820 --> 00:09:59,620
.شغفها الإبداعيّ هو ما يحرّكها لا غير

150
00:09:59,620 --> 00:10:02,830
رغم أنّها نالت من المكانة والمال الكثير؟

151
00:10:02,830 --> 00:10:07,370
.ستفهمين بعد أن تقضي المزيد من الوقت مع ذلك الوحش

152
00:10:07,370 --> 00:10:11,420
أحقًّا سأكون قادرةً على العمل مع شخصٍ مثلها؟

153
00:10:11,420 --> 00:10:14,130
.لا أستطيع الجزم بذلك

154
00:10:14,130 --> 00:10:17,970
،من أجل مواكبتها أو بالأحرى قتالها

155
00:10:17,970 --> 00:10:20,090
،تحتاجين إلى قدراتٍ عظيمة أو استقرارٍ ذهنيّ بالغ

156
00:10:20,090 --> 00:10:22,850
.أو كليهما، وإلّا لن تستطيعي مقارعتها

157
00:10:23,430 --> 00:10:26,270
.قد يكون ذلك صحيحًا

158
00:10:26,270 --> 00:10:28,730
أيمكنكِ فعلها يا شي-تشان؟

159
00:10:30,560 --> 00:10:33,070
.كنت لأتدبّر الأمر لو كنت وحدي

160
00:10:35,530 --> 00:10:36,570
...لكن

161
00:10:49,710 --> 00:10:52,630
.كـ-كاسوميغاوكا أوتاها

162
00:10:52,630 --> 00:10:54,130
ساوامورا-سان؟

163
00:10:54,130 --> 00:10:57,090
هل لي بلحظةٍ من وقتكِ؟

164
00:10:57,090 --> 00:10:59,680
ألديكِ أدنى فكرةٍ كم السّاعة الآن؟

165
00:10:59,680 --> 00:11:02,140
إنّها الثّالثة بعد الزّوال، أليس كذلك؟

166
00:11:07,640 --> 00:11:09,060
.فهمت

167
00:11:15,900 --> 00:11:18,070
.أعتذر عن استدعائكِ فجأة

168
00:11:18,070 --> 00:11:19,650
.لا بأس

169
00:11:19,650 --> 00:11:22,280
.فليس لديّ أيّ التزامات إلى حين موعد التخرّج

170
00:11:23,450 --> 00:11:24,780
إذًا، عمّ تريدين الحديث؟

171
00:11:28,120 --> 00:11:30,040
أتذكرين ما قلتِه لي سابقًا؟

172
00:11:30,040 --> 00:11:32,500
،أنّ عدم مقدرتي على الرّسم لا يعزو إلى الرّكود

173
00:11:32,500 --> 00:11:34,750
.أنّي فاشلةٌ فحسب

174
00:11:34,750 --> 00:11:38,960
.أظنّ أنّ ذلك قول كوساكا أكاني وليس أنا

175
00:11:38,960 --> 00:11:41,300
!لكنّكِ شاطرتها الرّأي

176
00:11:41,300 --> 00:11:44,140
!قلتِ أنّ رسوماتي سيّئة

177
00:11:46,140 --> 00:11:47,890
على كلٍّ، إلى ما ترمين؟

178
00:11:48,720 --> 00:11:51,850
...إن كنتِ لا تستطيعين الرّسم أساسًا، سواءً كنتِ جيّدة أو سيّئة

179
00:11:53,690 --> 00:11:55,310
لحظة، ساوامورا-سان؟

180
00:11:55,310 --> 00:11:56,940
...أيعقل أنّكِ

181
00:11:58,360 --> 00:12:01,150
يمكنكِ الرّسم من جديد؟

182
00:12:01,150 --> 00:12:03,910
.أشعر أنّي استعدت لمستي

183
00:12:03,910 --> 00:12:05,450
!حقًّا؟

184
00:12:05,450 --> 00:12:07,700
—كنتُ أرسم في المنزل يوم أمس، وقبل أن أدرك

185
00:12:07,700 --> 00:12:08,790
!كنتِ ترسمين؟

186
00:12:08,790 --> 00:12:09,700
أين هي؟

187
00:12:09,700 --> 00:12:10,700
!أرني إيّاها

188
00:12:10,700 --> 00:12:12,040
.ليست هنا

189
00:12:12,040 --> 00:12:14,630
.تركتها في المنزل

190
00:12:14,630 --> 00:12:17,380
!أنتِ بالفعل عديمة الفائدة يا قطعة الخردة

191
00:12:17,380 --> 00:12:18,250
!مهلًا

192
00:12:18,250 --> 00:12:21,260
!لماذا أتلقّى هذه الإهانات؟

193
00:12:21,260 --> 00:12:22,800
.ما باليد حيلة

194
00:12:22,800 --> 00:12:24,260
. إذًا هيّا بنا

195
00:12:24,260 --> 00:12:25,680
إلى أين؟

196
00:12:25,680 --> 00:12:27,140
أليس هذا واضحًا؟

197
00:12:27,140 --> 00:12:28,930
!لمعاينة تلك الرّسومات

198
00:12:28,930 --> 00:12:30,100
!في منزلكِ

199
00:12:30,600 --> 00:12:31,430
لماذا؟

200
00:12:31,430 --> 00:12:32,770
ماذا تقصدين بـ"لماذا"؟

201
00:12:32,770 --> 00:12:34,100
...هل أنتِ

202
00:12:37,400 --> 00:12:39,900
.سيكون أسرع من الذّهاب إلى المنزل

203
00:12:40,480 --> 00:12:41,780
أيّ شيء؟

204
00:12:49,200 --> 00:12:52,290
.رسم واحدةٍ أخرى هنا

205
00:13:05,010 --> 00:13:06,340
.هذا صحيح

206
00:13:06,340 --> 00:13:07,970
!لقد قطعتِ شوطًا طويلًا

207
00:13:08,760 --> 00:13:11,600
!وصلتِ إلى هنا بسرعة ومهارة وثبات

208
00:13:11,600 --> 00:13:13,680
!لِذا فليكن هدفكِ التّالي بلوغ العظمة

209
00:13:13,680 --> 00:13:17,400
!أظهري للجميع أنّ بإمكانكِ أن تصبحي سريعة، ماهرة، ثابتة، وعظيمة

210
00:13:23,940 --> 00:13:25,490
!أخبرتكِ ألّا تجهدي نفسكِ

211
00:13:25,990 --> 00:13:26,860
—هيّا

212
00:13:27,610 --> 00:13:29,580
...صديقةٌ ألمّ بها المرض فجأة وموعد التّسليم النّهائيّ

213
00:13:29,580 --> 00:13:32,700
أوليس جليًّا أيّهما سأختار؟

214
00:13:41,670 --> 00:13:45,840
.حسنًا، يمكنكِ العمل عليها وقتما تشائين

215
00:13:48,680 --> 00:13:51,430
!لا تجعليني أضحك أيّتها الفاشلة

216
00:13:51,430 --> 00:13:54,220
!ذلك لا يعدّ ركودًا أو أيّ شيء

217
00:13:55,980 --> 00:13:57,310
!انتهيت

218
00:14:00,400 --> 00:14:03,530
انظري. من الفاشلة الآن؟

219
00:14:03,530 --> 00:14:04,940
...أنتِ حقًّا

220
00:14:04,940 --> 00:14:06,570
!يمكنني الرّسم

221
00:14:06,570 --> 00:14:08,360
!أستطيع التغلّب على ركودي

222
00:14:08,360 --> 00:14:12,950
!أستطيع تجاوز المستوى الّذي تبحث عنه كوساكا أكاني في طرفة عين

223
00:14:12,950 --> 00:14:14,870
.أومن بكِ

224
00:14:14,870 --> 00:14:15,580
.لا

225
00:14:16,080 --> 00:14:19,250
.بعد النّظر إلى هذا، لا يسعني سوى الإيمان بكِ

226
00:14:20,380 --> 00:14:25,050
!اعترفتِ بي أخيرًا يا كاسوميغاوكا أوتاها

227
00:14:39,520 --> 00:14:41,610
ساوامورا-سان؟

228
00:14:41,610 --> 00:14:43,730
،حتّى عندما اعترف بي تومويا

229
00:14:43,730 --> 00:14:45,820
،حتّى عندما شجّعني تومويا

230
00:14:46,490 --> 00:14:49,820
.إلّا أنّني لم أستطع الرّسم

231
00:14:50,950 --> 00:14:52,120
،مع ذلك

232
00:14:52,740 --> 00:14:55,790
.كلّ ما تطلّبه الأمر هو أن أُهان من طرف كوساكا أكاني

233
00:14:55,790 --> 00:14:57,910
،التعرّض للسّخرية من طرف امرأة فحسب

234
00:14:58,620 --> 00:15:02,840
،جعلني أشتاط غضبًا ومحرجة ولم أرغب بالخسارة

235
00:15:02,840 --> 00:15:05,170
!ذلك جعلني قادرةً على الرّسم من جديد

236
00:15:05,630 --> 00:15:07,130
.ساوامورا-سان

237
00:15:07,130 --> 00:15:08,050
...أنا

238
00:15:08,720 --> 00:15:11,930
،أنا لا أستطيع الرّسم بجانب تومويا

239
00:15:12,390 --> 00:15:15,390
!وتومويا لا يستطيع دفعي إلى الرّسم

240
00:15:16,180 --> 00:15:21,440
!إن بقيت في المجموعة كما السّابق، فلن أتقدّم بمستواي

241
00:15:22,020 --> 00:15:28,360
!لن أستطيع أن أغدو الرّسامة العظيمة الّتي يريدها تومويا

242
00:15:48,170 --> 00:15:52,550
.لقد خُنت تومويا عندما كنّا صغارًا

243
00:15:52,550 --> 00:15:53,640
.أعلم

244
00:15:54,550 --> 00:15:57,310
.لهذا ستكون هذه خيانتي الثّانية

245
00:15:57,310 --> 00:15:59,890
.لن يسامحني تومويا هذه المرّة

246
00:16:00,520 --> 00:16:02,350
.قد يكون ذلك صحيحًا

247
00:16:02,350 --> 00:16:03,020
...لكن

248
00:16:03,520 --> 00:16:07,110
.مع الأسف، سيكون لديكِ شريكةٌ في الخيانة هذه المرّة

249
00:16:07,110 --> 00:16:09,280
.لِذا حتّى لو آلمكِ ذلك، فلن تكوني وحيدة

250
00:16:09,780 --> 00:16:10,900
أليس كذلك؟

251
00:16:13,490 --> 00:16:16,530
...كاسوميغاوكا أوتاها

252
00:16:16,530 --> 00:16:21,160
.مع ذلك، كلتانا تنتظرنا أوقاتٌ عصيبة

253
00:16:21,160 --> 00:16:23,000
.أنا مستعدّة لها

254
00:16:23,000 --> 00:16:26,750
.على كلٍّ، يمكنكِ استدعائي إن أردتِ النّحيب والإفصاح عمّا يعتريكِ

255
00:16:26,750 --> 00:16:29,050
.يمكنني أن أصغي إليكِ على الأقل

256
00:16:29,050 --> 00:16:30,760
.لن أبكِي بعد الآن

257
00:16:31,550 --> 00:16:33,470
.لا يحقّ لي أن أبكي

258
00:16:34,720 --> 00:16:37,100
.لا داعي لأن تكبتي في نفسكِ حاليًّا

259
00:16:38,970 --> 00:16:42,270
.على كلٍّ، يجب أن تستعدّي أيضًا

260
00:16:42,270 --> 00:16:45,520
،سألتحق بالجامعة قريبًا

261
00:16:45,520 --> 00:16:46,480
—لِذا يمكنني الاعتناء بكِ

262
00:16:46,480 --> 00:16:47,560
!لا أقصد هذا

263
00:16:47,560 --> 00:16:49,360
.أنا أتحدّث عنكِ

264
00:16:50,230 --> 00:16:54,320
!لا تسمحي لكوساكا أكاني بأن تحطّ من قيمتكِ يا كاسومي أوتاكو

265
00:16:54,740 --> 00:16:56,870
أنتِ محترفةٌ مثلها، صحيح؟

266
00:16:56,870 --> 00:16:58,030
ساوامورا-سان؟

267
00:16:58,030 --> 00:17:00,580
.لقد غفلتْ عن شيءٍ واحد

268
00:17:00,580 --> 00:17:05,460
!موهبتكِ، مجهودكِ، وإصراركِ على عدم الاستسلام

269
00:17:06,790 --> 00:17:10,630
،عدم إدراك كوساكا أكاني لمدى عظمة كاسومي أوتاكو

270
00:17:10,630 --> 00:17:12,760
!يدلّ على أنّها ليست مميّزةً إطلاقًا

271
00:17:24,850 --> 00:17:27,900
.معًا، سنهزم كوساكا أكاني

272
00:17:33,320 --> 00:17:34,780
.أنتِ أيضًا

273
00:17:34,780 --> 00:17:38,410
.توخّي الحذر من أن أفاجئكِ على حين غرّة

274
00:17:46,750 --> 00:17:47,790
.فهمت

275
00:17:48,670 --> 00:17:50,790
.إذًا فكلتاهما انسحبتا في النّهاية

276
00:17:50,790 --> 00:17:52,300
.آسف

277
00:17:52,300 --> 00:17:54,760
.رغم أنّك حذّرتني من ذلك

278
00:17:54,760 --> 00:17:58,090
.لا، أنا من عليه الاعتذار

279
00:17:58,090 --> 00:17:59,510
.هذا ليس صحيحًا

280
00:17:59,850 --> 00:18:04,180
—لكنّ السّبب في أنّ أكاني-سان وضعت أنظارها عليهما هو أنّي

281
00:18:04,180 --> 00:18:05,230
.يوري

282
00:18:05,230 --> 00:18:10,520
.أصغِ، هذه فرصةٌ لا تعوّض لإريري وأوتها-سينباي

283
00:18:10,520 --> 00:18:13,440
.سيكون من الغريب أن أشتكي من هذا الاختيار المذهل

284
00:18:13,440 --> 00:18:16,650
...لكنّهما في الأصل كانتا ضمن مجموعتك

285
00:18:16,650 --> 00:18:20,700
.أجل، أنا من أدخلهما إلى مجال تطوير الألعاب

286
00:18:21,330 --> 00:18:26,200
بعبارةٍ أخرى، أليس هذا دليلًا على أنّي منتجٌ موهوب؟

287
00:18:29,040 --> 00:18:32,290
.إذًا فلتبدِ بعض السّرور على الأقلّ

288
00:18:37,720 --> 00:18:41,640
.بالمناسبة، ثمّة شيءٌ عليّ أن أخبرك به

289
00:18:41,640 --> 00:18:43,100
ما هو؟

290
00:18:43,100 --> 00:18:46,680
.إيزومي وأنا انسحبنا من روج إن روج

291
00:18:46,680 --> 00:18:50,770
إن فعلت ذلك مراعاةً لي بعد أن قاموا
—بتوظيف عضوتي مجموعتي، فإنّ ذلك

292
00:18:50,770 --> 00:18:53,070
.لا علاقة لذلك بهذا

293
00:18:53,730 --> 00:18:57,070
.كلّ ما في الأمر أنّني وجدت شيئًا جديدًا أودّ فعله

294
00:18:57,570 --> 00:18:59,860
.شيءٌ لم أتمكّن من فعله في مجموعتي الحاليّة

295
00:18:59,860 --> 00:19:03,740
.حسنٌ، يمكنك أن تنجح أينما ذهبت

296
00:19:03,740 --> 00:19:06,200
.لكن احرص على أن تعتني بإيزومي-تشان

297
00:19:06,700 --> 00:19:07,700
!اطمئن

298
00:19:07,700 --> 00:19:11,580
!سبق ووجدت أفضل مكانٍ لتبرز فيه إيزومي مواهبها

299
00:19:11,580 --> 00:19:12,460
.فهمت

300
00:19:13,130 --> 00:19:16,210
.لِذا حافظ على استمرارية مجموعتك

301
00:19:16,210 --> 00:19:19,170
.أخبرتني بنفس الشّيء في لقائنا الأخير

302
00:19:19,170 --> 00:19:21,890
.وسأستمرّ بقولها

303
00:19:21,890 --> 00:19:23,760
.لا تتوقّف عن صنع الألعاب

304
00:19:23,760 --> 00:19:25,430
.لا تتوقّف عن الإبداع

305
00:19:26,310 --> 00:19:29,640
.لا يجب أن تتخلّى عن مطاردة أحلامك

306
00:19:29,640 --> 00:19:32,560
لمٙ تحاول إقناعي إلى هذا الحدّ؟

307
00:19:32,560 --> 00:19:34,110
نحن عدوّان، أليس كذلك؟

308
00:19:35,690 --> 00:19:39,440
.لأنّني لن أستمتع إن لم تكن جدّيًّا

309
00:19:39,440 --> 00:19:40,990
.لا أستوعب الأمر

310
00:20:02,260 --> 00:20:03,510
!وكأنّي سأفعل أيّها الأحمق

311
00:20:04,180 --> 00:20:05,970
.أمنحه تقييم صفر كمقترح مشروع

312
00:20:05,970 --> 00:20:11,230
.من الآن فصاعدًا، أنا كاشيواجي إري، عضوةٌ في مجموعتك

313
00:20:11,230 --> 00:20:15,610
.مرحبًا بك في عالم المبدعين يا أكي تومويا-كُن

314
00:20:15,940 --> 00:20:19,110
.سأنهيها بلا أدنى شكّ، بعضّ النّظر عمّا يقوله أيّ كان

315
00:20:20,070 --> 00:20:24,740
.إنّه السّيناريو الأصليّ خاصّتنا

316
00:20:59,150 --> 00:21:00,730
...كاتو

317
00:21:08,330 --> 00:21:09,910
.لم أرك منذ مدّة

318
00:21:09,910 --> 00:21:12,370
...أنتِ— شعرك

319
00:21:12,370 --> 00:21:14,580
.فلنذهب في موعد

320
00:21:16,670 --> 00:21:19,840
.فلناحول أن نتواعد نحن الاثنان