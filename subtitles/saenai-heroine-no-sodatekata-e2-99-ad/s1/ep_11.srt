1
00:00:01,770 --> 00:00:04,620
هل تحدّثتِ مع إريري بعد ما جرى؟

2
00:00:04,620 --> 00:00:06,590
.قليلًا فحسب

3
00:00:06,590 --> 00:00:08,230
،أصغي يا كاتو

4
00:00:08,230 --> 00:00:11,540
.إريري وأوتاها-سينباي ليستا مخطئتين

5
00:00:11,540 --> 00:00:15,670
.فأنا أساسًا من دفعهما للانضمام إلى المجموعة

6
00:00:15,670 --> 00:00:17,740
.ودفعتني لذلك أيضًا

7
00:00:17,740 --> 00:00:20,450
،إن كانتا تهدفان إلى القمّة كمبدعتين

8
00:00:20,450 --> 00:00:22,980
،إن أُتيحت لهما فرصةٌ كبرى

9
00:00:22,980 --> 00:00:25,980
.فلا سبب يدعوهما للبقاء في مجموعةٍ صغيرةٍ كهذه

10
00:00:27,000 --> 00:00:28,320
...لِذا

11
00:00:28,320 --> 00:00:30,130
.لا تلوميهما كثيرًا

12
00:00:30,890 --> 00:00:32,630
أنتنّ صديقاتٌ حميمات، صحيح؟

13
00:00:35,150 --> 00:00:37,270
.لقد فات الأوان

14
00:00:52,520 --> 00:00:55,240
!على كلّ، فلنستمتع بوقتنا الآن

15
00:00:55,240 --> 00:00:58,490
.لم نخرج في موعدٍ منذ مدّةٍ طويلة

16
00:02:37,010 --> 00:02:38,970
.روكتينبا مول

17
00:02:39,310 --> 00:02:42,220
.حسنًا، فلنبدأ باستراتيجيّة اللّقاء

18
00:02:42,910 --> 00:02:45,720
.أودّ أن أركّز اليوم على زيارة هذه المتاجر

19
00:02:45,720 --> 00:02:48,850
.لِذا، هنا وهنا

20
00:02:49,280 --> 00:02:52,690
.هيّا يا أكي-كُن، فكّر بالمسار الأمثل

21
00:02:52,690 --> 00:02:54,660
.كالمرّة السّابقة

22
00:02:54,660 --> 00:02:55,940
.أخبريني يا كاتو

23
00:02:56,570 --> 00:03:00,270
هل تحاولين الرّفع من معنويّاتي؟

24
00:03:01,260 --> 00:03:04,080
.إن كان الأمر كذلك، فأنا ممتنّ لكِ

25
00:03:04,440 --> 00:03:06,990
.لكن لا داعي لأن تقلقي بشأني

26
00:03:06,990 --> 00:03:10,130
.حسنٌ، هذا نحو ثلاثين بالمئة من السّبب

27
00:03:10,130 --> 00:03:11,920
ما البقيّة إذًا؟

28
00:03:11,920 --> 00:03:15,940
.عشرون بالمئة بسبب أنّي أردت القدوم حقًّا

29
00:03:15,940 --> 00:03:20,280
.فهذه عطلة الرّبيع، إلّا أنّي لم أذهب إلى أيّ مكان

30
00:03:20,280 --> 00:03:22,760
.ثمّة خمسون بالمئة متبقيّة

31
00:03:23,670 --> 00:03:28,570
.في آخر مرّةٍ جِئت إلى هنا برفقتك، كنتُ متحسّرةً على شيءٍ واحد

32
00:03:28,570 --> 00:03:29,930
متحسّرة؟

33
00:03:32,260 --> 00:03:35,320
،جِئنا إلى هنا معًا وتسوّقنا معًا

34
00:03:35,320 --> 00:03:38,400
.لكنّك تركتني قبل أن نعود إلى المنزل معًا

35
00:03:42,130 --> 00:03:44,700
!لكِ خالص اعتذاراتي

36
00:03:45,270 --> 00:03:46,660
،ولهذا

37
00:03:47,580 --> 00:03:50,410
.سأحرص على أن ترافقني اليوم حتّى آخر لحظة

38
00:03:50,850 --> 00:03:52,420
!حاضر

39
00:03:58,210 --> 00:03:59,650
.أخبرني يا أكي-كُن

40
00:03:59,650 --> 00:04:00,900
.كاتو

41
00:04:00,900 --> 00:04:04,390
...بشأن المتجر التّالي، أظنّ أنّه من الأفضل أن نتوجّه غربًا

42
00:04:04,390 --> 00:04:06,600
.ليس هذا ما أردت سؤالك عنه

43
00:04:06,600 --> 00:04:08,210
أيّهما أفضل؟

44
00:04:08,210 --> 00:04:09,140
ماذا؟

45
00:04:09,140 --> 00:04:12,080
،يعجبني هذا اللّون أكثر

46
00:04:12,080 --> 00:04:14,150
.لكن يروقني هذا التّصميم أكثر

47
00:04:14,150 --> 00:04:16,690
...لستُ الشّخص المناسب لتسأليه عن هذا

48
00:04:16,690 --> 00:04:19,280
.يمكنك إخباري برأيك فحسب

49
00:04:19,280 --> 00:04:20,540
!مهلًا، توقّفي

50
00:04:20,540 --> 00:04:23,900
أتدركين مدى صعوبة أن ينتقي أوتاكو الملابس؟

51
00:04:23,900 --> 00:04:24,840
حقًّا؟

52
00:04:24,840 --> 00:04:25,870
!أجل، حقًّا

53
00:04:25,870 --> 00:04:29,600
كما أنّي لا أفهم شيئًا عن الملابس ولا أملك
.ذوقًا في الموضة ولا المال لأنفقه عليها

54
00:04:29,600 --> 00:04:32,750
.يستحيل أن أعطيكِ رأيي بثقة

55
00:04:34,000 --> 00:04:35,750
أهذا ما في الأمر؟

56
00:04:35,750 --> 00:04:37,180
.أ-أجل

57
00:04:37,180 --> 00:04:39,660
—لِذا أعتذر، يمكنكِ سؤال العاملين هنا أو

58
00:04:39,660 --> 00:04:40,670
،في هذه الحالة

59
00:04:40,670 --> 00:04:43,970
.سأرتديها، ليتسنّى لك الاختيار على راحتك

60
00:04:43,970 --> 00:04:45,010
—أنصتي إلى ما أقول

61
00:04:54,920 --> 00:04:56,480
.آسفةٌ على تأخّري

62
00:04:56,480 --> 00:04:57,560
هل نال منك التّعب؟

63
00:04:57,560 --> 00:05:00,070
!ليس جسديًّا، بل ذهنيًّا

64
00:05:00,380 --> 00:05:01,300
ما التّالي؟

65
00:05:01,300 --> 00:05:02,600
أتريد أن نأخذ استراحة؟

66
00:05:02,600 --> 00:05:05,590
.تبقّى متجرٌ واحد فقط، لِذا فلنقصده

67
00:05:05,590 --> 00:05:07,200
.فهمت

68
00:05:08,190 --> 00:05:09,580
.سأحملها عنكِ

69
00:05:09,580 --> 00:05:13,080
.كان هذا المكان محتشدًا في السّنة الماضية

70
00:05:22,040 --> 00:05:23,050
.لا تركضي

71
00:05:23,520 --> 00:05:26,550
.سأكون بخيرٍ طالما أنّك لا تركض

72
00:05:26,550 --> 00:05:28,180
.لا تتعثّري

73
00:05:28,180 --> 00:05:32,010
.سأكون بخيرٍ طالما أنّك تفسح الطّريق

74
00:05:32,010 --> 00:05:33,480
...وأيضًا

75
00:05:33,480 --> 00:05:34,770
.لا تفلتي يدي

76
00:05:34,770 --> 00:05:39,660
.سأكون بخير طالما أنّك تشدّ بيدي

77
00:06:05,680 --> 00:06:07,490
!بوركت جهودك

78
00:06:07,490 --> 00:06:10,070
.بهذا نكون انتهينا من كلّ شيء

79
00:06:10,070 --> 00:06:11,030
ماذا الآن؟

80
00:06:11,030 --> 00:06:12,050
أنستريح؟

81
00:06:12,050 --> 00:06:13,890
أم نعود أدراجنا؟

82
00:06:14,500 --> 00:06:15,580
.أخبريني يا كاتو

83
00:06:16,740 --> 00:06:20,750
أعتذر، لكن أيمكنكِ مرافقتي إلى متجرٍ إضافيّ؟

84
00:06:20,750 --> 00:06:21,540
ماذا؟

85
00:06:25,650 --> 00:06:27,270
...هذا المكان

86
00:06:36,520 --> 00:06:37,660
.أخبريني يا كاتو

87
00:06:39,720 --> 00:06:44,000
القبّعة الّتي كنتِ ترتدينها وقتها كانت مشابهةً لهذه، صحيح؟

88
00:06:47,020 --> 00:06:49,970
.إنّها لشكركِ على دعوتي اليوم إلى هنا

89
00:06:49,970 --> 00:06:55,970
.كما أنّي لم أقدّم لكِ إلى الآن شيئًا مقابل النّظارة الّتي أهديتني إيّاها آنذاك

90
00:06:55,970 --> 00:06:58,260
.شكرًا لكِ يا كاتو

91
00:07:00,420 --> 00:07:02,670
.على الرّحب

92
00:07:05,370 --> 00:07:06,700
.أخبرني يا كاتو

93
00:07:06,700 --> 00:07:09,740
ألم يكن من الأفضل أن تستبدليها بشيءٍ آخر؟

94
00:07:09,740 --> 00:07:11,160
.لا أريد

95
00:07:11,160 --> 00:07:13,320
،لكن بالتّفكير في الأمر مليًّا

96
00:07:13,320 --> 00:07:16,300
أليست نفس القبّعة الّتي كانت لديكِ وقتها؟

97
00:07:16,300 --> 00:07:18,250
.هذا ما يجعلها مميّزة

98
00:07:18,250 --> 00:07:20,940
،بالإضافة إلى أنّهما متشابهتان تقريبًا

99
00:07:20,940 --> 00:07:23,000
.لكنّهما ليستا متطابقتين بتاتًا

100
00:07:23,520 --> 00:07:25,250
.لم أستوعب الأمر

101
00:07:39,440 --> 00:07:41,270
.أخبرني يا تومويا-كُن

102
00:07:41,270 --> 00:07:47,300
هل بطلة قصّتك الجديدة شيءٌ من هذا القبيل؟

103
00:07:48,280 --> 00:07:54,580
هل حدث الخروج في موعد في قصّتك الجديدة شيءٌ من هذا القبيل؟

104
00:07:54,580 --> 00:07:55,660
...كاتو

105
00:07:55,660 --> 00:08:05,540
هل شعرت بالاختناق والتوتّر والحماس
كما كنت لتشعر لو وقعت في حبّ فتاةٍ حقيقيّة؟

106
00:08:06,590 --> 00:08:10,720
،الوقت الّذي قضيته مع البطلة نفيسٌ بحدّ ذاته

107
00:08:10,720 --> 00:08:13,680
...وتقع في حبّها من كلّ أعماق قلبك

108
00:08:13,680 --> 00:08:18,180
هل أفلح هذا كدافعٍ لتأليف قصّةٍ كتلك؟

109
00:08:18,180 --> 00:08:22,140
...أيعقل أنّ السّبب الحقيقيّ لدعوتكِ لي اليوم

110
00:08:22,830 --> 00:08:25,400
.أنا لن أستسلم يا تومويا-كُن

111
00:08:25,870 --> 00:08:29,900
،حتّى لو رحلت إريري، حتّى لو رحلت كاسوميغاوكا-سينباي

112
00:08:30,340 --> 00:08:33,650
.بليسينغ سوفتوير لن تختفي

113
00:08:34,110 --> 00:08:36,490
.طالما أنّك هنا يا تومويا-كُن

114
00:08:38,800 --> 00:08:39,910
!أجل

115
00:08:40,590 --> 00:08:42,650
،طالما أنّي هنا

116
00:08:42,650 --> 00:08:44,830
،طالما أنّ كلينا هنا

117
00:08:44,830 --> 00:08:46,420
!لن تختفي

118
00:08:51,920 --> 00:08:55,180
.أنا... أريد المحافظة على استمراريّة المجموعة

119
00:08:55,650 --> 00:08:56,400
.أجل

120
00:08:59,430 --> 00:09:03,180
!أريد صنع لعبةٍ جديدة

121
00:09:03,920 --> 00:09:04,750
!أجل

122
00:09:17,970 --> 00:09:19,600
،لِذا يا ميجومي

123
00:09:19,600 --> 00:09:22,950
!فلتصبحي بطلتي الرّئيسيّة من جديد

124
00:09:31,070 --> 00:09:37,050
!اجعلني مجدّدًا بطلةً رئيسيّة يغار منها الجميع

125
00:10:54,320 --> 00:10:56,340
.من هنا يا ساوامورا-سان

126
00:10:56,750 --> 00:10:59,280
لماذا لم نحصل على مقاعد الدّرجة الأولى؟

127
00:10:59,280 --> 00:11:03,970
لا يمكننا أن نطلب من زبونٍ نحن في طريقنا
.لمقابلته لأول مرّة أن يحجز لنا في الدّرجة الأولى

128
00:11:03,970 --> 00:11:07,520
كنت لأنهي بعض الأعمال في طريقنا
.لو أنّنا حصلنا على مقاعد الدّرجة الأولى

129
00:11:07,520 --> 00:11:11,770
.أصبحتِ متلهّفةً للعمل منذ أن تغلّبتِ على ركودكِ

130
00:11:11,770 --> 00:11:13,650
.هذه أنا الحقيقيّة

131
00:11:14,120 --> 00:11:15,400
...وأيضًا

132
00:11:16,610 --> 00:11:20,150
.لقد ضحّينا بالكثير لنأخذ هذا العمل على محمل الجدّ

133
00:11:21,360 --> 00:11:23,160
.أنتِ محقّة

134
00:11:28,660 --> 00:11:30,700
.حسنًا، هيّا لنركب

135
00:11:30,700 --> 00:11:32,420
.سنكون في ميدان الخصم

136
00:11:32,740 --> 00:11:34,170
هل أنتِ مستعدّة؟

137
00:11:34,170 --> 00:11:36,920
!لا مجال للعودة بعد الآن

138
00:11:40,370 --> 00:11:41,180
!مهلًا

139
00:11:41,620 --> 00:11:42,680
!إريري

140
00:11:42,680 --> 00:11:44,680
!أوتاها-سينباي

141
00:11:51,250 --> 00:11:52,360
!هذا مطمئن

142
00:11:52,360 --> 00:11:54,080
!وصلت في الوقت المناسب

143
00:11:55,820 --> 00:11:57,490
...تـ-تومو

144
00:11:57,490 --> 00:11:58,750
تومويا-كُن؟

145
00:12:01,700 --> 00:12:04,970
حسنٌ، لمٙ أنت هنا يا تومويا-كُن؟

146
00:12:04,970 --> 00:12:07,230
.أخبرتني ماتشيدا-سان

147
00:12:07,230 --> 00:12:09,790
.أخبرتني أنّكما ذاهبتان اليوم إلى أوساكا

148
00:12:09,790 --> 00:12:11,460
ستبدآن أخيرًا، صحيح؟

149
00:12:11,460 --> 00:12:13,710
!ابذلا جهدكما

150
00:12:16,740 --> 00:12:20,080
.لكنّني ظننت أنّك لم توافق على هذا

151
00:12:20,080 --> 00:12:21,970
.واهدئي قليلًا يا ساوامورا-سان

152
00:12:21,970 --> 00:12:24,800
!اصمتي يا كاسوميغاوكا أوتاها

153
00:12:24,800 --> 00:12:27,050
.الأمر لا يتعلّق بموافقتي من عدمها

154
00:12:27,050 --> 00:12:29,570
!فنحن نتحدّث عن وقائع الميادين

155
00:12:29,570 --> 00:12:31,580
!وقائع الميادين المشهورة

156
00:12:31,580 --> 00:12:36,640
!حتمًا ستكون لعبةً ألوهية المستوى بما أنّكما ستعملان عليها

157
00:12:36,640 --> 00:12:38,570
!سأهتف لكما

158
00:12:38,570 --> 00:12:41,420
،سأدعمها بالنّشر عنها في مدوّنتي وعرضها على أصدقائي

159
00:12:41,420 --> 00:12:44,230
!وسأشتري قدر ما أستطيع من النّسخ المحدودة

160
00:12:44,230 --> 00:12:47,690
...تومويا

161
00:12:47,690 --> 00:12:49,550
.لِذا فلتبذلي جهدكِ يا إريري

162
00:12:51,540 --> 00:12:56,630
...لكن لم أجرحك وحدك فحسب، بل وميجومي أيضًا

163
00:12:57,180 --> 00:13:01,050
...ستقطع صلتها بي، ولن تسامحني أبدًا

164
00:13:01,050 --> 00:13:02,660
أتظنّين ذلك حقًّا؟

165
00:13:14,150 --> 00:13:16,100
.حظًّا طيّبًا يا إريري

166
00:13:16,570 --> 00:13:19,110
.آسفةٌ لأنّي لم أستطع القدوم لتوديعكِ

167
00:13:19,110 --> 00:13:21,750
!لكنّني سأهتف لكِ

168
00:13:23,020 --> 00:13:26,950
.وسأظل أنتظر دائمًا موعد عودتكِ

169
00:13:29,540 --> 00:13:32,120
...ميجومي

170
00:13:32,590 --> 00:13:34,840
.لِذا كفّي عن البكاء

171
00:13:34,840 --> 00:13:36,860
...لكن... لكن

172
00:13:36,860 --> 00:13:38,300
تريدين فعلها، أليس كذلك؟

173
00:13:38,300 --> 00:13:39,880
تريدين النّجاح، أليس كذلك؟

174
00:13:40,260 --> 00:13:42,630
تريدين أن تصبحي رسّامةً بمستوى الإله، أليس كذلك؟

175
00:13:42,630 --> 00:13:45,200
!إذًا فلتصبحي كذلك

176
00:13:45,200 --> 00:13:47,010
!اجعليني فخورًا بكِ

177
00:13:47,010 --> 00:13:50,600
!اجعليني أتباهى بكوني صديق طفولة كاشيواجي إري

178
00:13:51,300 --> 00:13:52,360
.سأفعل

179
00:13:53,790 --> 00:13:57,590
!لسوف أغدو رسّامةً في مستوى الإله وأجعلك تذرف الدّموع

180
00:13:57,590 --> 00:13:59,690
!إلى جانب كاسوميغاوكا أوتاها

181
00:14:01,350 --> 00:14:04,690
.أوتاها-سينباي، أترك إريري تحت رعايتكِ

182
00:14:04,690 --> 00:14:06,660
.اعتمد عليّ

183
00:14:06,660 --> 00:14:09,370
.إيّاكما أن تخسرا أمام كوساكا أكاني

184
00:14:09,370 --> 00:14:12,470
من تحسبنا يا ترى؟

185
00:14:12,470 --> 00:14:13,450
.أنتِ محقّة

186
00:14:14,070 --> 00:14:15,380
.وأنت أيضًا

187
00:14:15,380 --> 00:14:17,210
.حظًّا طيّبًا في مشروعك الجديد

188
00:14:18,450 --> 00:14:21,250
.سأصنع شيئًا أسطوريًّا هذه المرّة

189
00:14:21,250 --> 00:14:22,770
.سأكون بالانتظار

190
00:14:22,770 --> 00:14:24,290
ألن تسخري منّي؟

191
00:14:24,290 --> 00:14:26,420
.لا، لن أسخر منك

192
00:14:26,910 --> 00:14:29,100
وكيف لي أن أفعل؟

193
00:14:29,100 --> 00:14:34,680
.فذلك أحد أسباب تركي لك

194
00:14:36,050 --> 00:14:38,940
...عندما لا تتّكل أو تعوّل على أحد

195
00:14:39,320 --> 00:14:42,670
.أردت أن أرى تفانيك التّام

196
00:14:42,670 --> 00:14:44,760
...أوتاها-سينباي

197
00:14:44,760 --> 00:14:46,310
،لهذا يا تومويا-كُن

198
00:14:46,310 --> 00:14:48,450
.ارتقي لمستوى توقّعاتي

199
00:14:48,720 --> 00:14:49,720
،لا

200
00:14:49,720 --> 00:14:51,450
.بل تجاوز توقّعاتي

201
00:14:54,450 --> 00:14:55,760
.حسنًا

202
00:14:55,760 --> 00:14:57,450
!رافقتكما السّلامة

203
00:15:00,180 --> 00:15:01,460
.تومويا

204
00:15:01,960 --> 00:15:03,930
.أعطني هذه من فضلك

205
00:15:03,930 --> 00:15:04,960
إريري؟

206
00:15:05,560 --> 00:15:08,720
يمكنني أخذها، أليس كذلك؟

207
00:15:10,130 --> 00:15:10,990
.لا بأس

208
00:15:10,990 --> 00:15:12,220
.خذيها

209
00:15:12,650 --> 00:15:15,450
...تومويا... أنا

210
00:15:17,030 --> 00:15:18,230
...أنا

211
00:15:39,260 --> 00:15:42,180
...أخلاقيّ-كُن

212
00:15:42,180 --> 00:15:43,310
،لا

213
00:15:43,310 --> 00:15:45,540
."من الآن فصاعدًا أنت "لا أخلاقيّ-كُن

214
00:15:47,160 --> 00:15:49,340
لماذا لم تسمح لي بأن أستسلم؟

215
00:15:49,910 --> 00:15:52,360
لماذا لم تسمح لي بأن أنسى؟

216
00:15:52,360 --> 00:15:54,020
ما هذا الّذي فعلتِه يا أوتاها-سينباي؟

217
00:15:54,020 --> 00:15:55,850
.حسنًا، فهمت

218
00:15:55,850 --> 00:15:58,120
.لقد حسمت قراري أيضًا

219
00:15:58,120 --> 00:16:00,020
.سأسمح لك بأن تحتفظ بي بدافع الشّفقة

220
00:16:00,020 --> 00:16:01,360
.سأسمح لك بأن تستمرّ في قتلي

221
00:16:01,360 --> 00:16:02,850
!لن أفعل أيًّا من ذلك

222
00:16:02,850 --> 00:16:06,110
.سأتخلّى عن الاستسلام

223
00:16:08,610 --> 00:16:11,240
!كـ-كاسوميغاوكا أوتاها

224
00:16:12,220 --> 00:16:14,780
!ماذا تظنّين نفسكِ فاعلة؟

225
00:16:14,780 --> 00:16:16,960
...كنت على وشك

226
00:16:16,960 --> 00:16:18,120
...كنت

227
00:16:18,120 --> 00:16:21,000
لكنّكما ما زلتما ستدرسان في نفس المدرسة، صحيح؟

228
00:16:21,360 --> 00:16:22,700
،إن فعلتِ شيئًا كهذا

229
00:16:22,700 --> 00:16:24,950
.فستحرجان ولن تقدرا على النّظر إلى بعضكما في أروقة المدرسة

230
00:16:24,950 --> 00:16:28,070
!أنا حقًّا لا يمكنني العمل معكِ

231
00:16:28,070 --> 00:16:30,630
هذا وذاك مسألتان منفصلتان، أليس كذلك؟

232
00:16:30,630 --> 00:16:35,510
.على كلّ، أتفهّم غيرتكِ من فتاته الأولى

233
00:16:36,270 --> 00:16:37,640
!أنتما الاثنتان

234
00:16:37,640 --> 00:16:41,250
—إن لم تتوقّفا عن هذه المشاحنة، فإنّكما ستفوّتان القطـ

235
00:16:43,270 --> 00:16:44,940
القطار؟

236
00:16:45,730 --> 00:16:47,620
أين اختفى؟

237
00:18:27,580 --> 00:18:30,100
...صـ-صباح الخير، حسنٌ

238
00:18:30,100 --> 00:18:31,210
.يا ميجومي

239
00:18:32,180 --> 00:18:34,210
—صباح الخير يا تومو

240
00:18:35,720 --> 00:18:37,240
هذه؟

241
00:18:37,240 --> 00:18:40,220
.لقد أضعت نظّارتي الاعتياديّة

242
00:18:40,880 --> 00:18:41,990
ما رأيكِ؟

243
00:18:43,920 --> 00:18:45,220
ميجومي؟

244
00:18:45,220 --> 00:18:47,150
.إ-إنّها تلائمك

245
00:18:47,150 --> 00:18:49,930
.أجل. إنّها تلائمك كثيرًا

246
00:18:50,730 --> 00:18:53,730
.إ-إنّها حقًّا تبدو رائعةً عليك

247
00:18:53,730 --> 00:18:56,140
،أعدك أن أمتدحها لاحقًا

248
00:18:56,140 --> 00:18:59,200
.لِذا امنحني الآن بعضًا من الوقت

249
00:18:59,200 --> 00:19:01,040
!لماذا تضحكين يا كاتو؟

250
00:19:01,040 --> 00:19:04,020
هل ستحرجين أوتاكو لمحاولته معاصرة الموضة؟

251
00:19:04,020 --> 00:19:07,620
...أ-أنا آسفة، لقد تفاجأت فحسب

252
00:19:07,620 --> 00:19:08,630
!كاتو

253
00:19:08,630 --> 00:19:10,450
...تـ-توقّف رجاءً

254
00:19:11,210 --> 00:19:14,710
.أساسًا، إنّها النّظارة الّتي أهديتني إيّاها في السّنة الماضيّة

255
00:19:15,100 --> 00:19:17,100
!لا تسخري من ذوقكِ في الموضة

256
00:19:17,100 --> 00:19:20,400
.بالتّفكير في الأمر، أفترض أنّ ذلك حدث بالفعل

257
00:19:20,400 --> 00:19:23,220
.إذًا هذا ما في الأمر، هذا مدى تعرّفكِ عليها

258
00:19:23,690 --> 00:19:24,720
!لا بأس إذًا

259
00:19:24,720 --> 00:19:26,950
!سأضع العدسات من الآن فصاعدًا

260
00:19:36,940 --> 00:19:39,740
.أجل، أظنّ أن ذلك سيلائمك أكثر

261
00:19:39,740 --> 00:19:40,980
.كاتو

262
00:19:40,980 --> 00:19:45,690
.رغم أنّنا في السّنة الثّالثة، إلّا أنّ معاملتكِ لي بجفاء لم تتغيّر

263
00:19:45,690 --> 00:19:51,470
.أظنّ أنّ السّبب يعزو لكونك فظًّا معي كالعادة

264
00:19:51,470 --> 00:19:52,750
!صِدقًا

265
00:19:53,370 --> 00:19:57,080
!كنتِ تتصرّفين كبطلةٍ رئيسيّة حقيقيّة في ذلك اليوم

266
00:19:57,080 --> 00:20:00,510
.لا أظنّني مختلفةً في شيء عن ذلك الوقت

267
00:20:00,510 --> 00:20:03,220
!مخطئة، إنّكِ شخصٌ مختلفٌ كليًّا

268
00:20:03,560 --> 00:20:07,100
،كنتِ في غاية الظّرافة واللّطف آنذاك

269
00:20:07,100 --> 00:20:08,470
،موي ومهمومة

270
00:20:08,470 --> 00:20:10,820
!جعلتني أرغب بأن أتدحرج على الأرض

271
00:20:10,820 --> 00:20:15,280
.هذا النّوع من ردّ الفعل ليس محفّزًا لبذل الجهد

272
00:20:15,280 --> 00:20:18,730
!وأيضًا، الطّريقة الّتي ناديتني بها

273
00:20:19,910 --> 00:20:23,220
ماذا؟ هل زلّ لساني في شيءٍ ما؟

274
00:20:23,220 --> 00:20:25,230
"!ناديتني "تومويا-كُن

275
00:20:25,230 --> 00:20:26,490
"!تومويا-كُن"

276
00:20:27,990 --> 00:20:29,430
!تومويا-سينباي

277
00:20:29,430 --> 00:20:33,750
،حسنًا، أعليّ القول أنّي لا أعلم عمّا تتحدّث

278
00:20:33,750 --> 00:20:36,670
...أم أنّي نادمةٌ على ذلك الآن

279
00:20:36,670 --> 00:20:38,300
!لقد قلتِ ذلك قطعًا

280
00:20:38,300 --> 00:20:40,540
!ناديتني "تومويا-كُن" أعلى تلك التلّة وقت المغيب

281
00:20:40,540 --> 00:20:42,190
!تومويا-سينباي

282
00:20:42,190 --> 00:20:44,340
!أترين؟ هكذا

283
00:20:46,340 --> 00:20:48,070
إيزومي-تشان؟

284
00:20:48,070 --> 00:20:52,430
!أنا هاشيما إيزومي، التحقت اليوم بأكاديميّة تويوغاساكي

285
00:20:52,430 --> 00:20:55,100
!أتطلّع لسنتنا معًا

286
00:20:55,100 --> 00:20:58,990
.حـ-حسنٌ، إيزومي-تشان، ظننت أنّكِ ستلتحقين بمدرسةٍ عموميّة

287
00:20:58,990 --> 00:20:59,520
ماذا؟

288
00:20:59,520 --> 00:21:04,010
.تقدّمت إليها، لكنّني قُبلت في تويوغاساكي أوّلًا، لِذا لم ألتحق بها

289
00:21:04,010 --> 00:21:04,820
!اطمئن

290
00:21:04,820 --> 00:21:08,600
!سبق ووجدت أفضل مكانٍ لتبرز فيه إيزومي مواهبها

291
00:21:08,600 --> 00:21:10,090
...ذلك الوغد

292
00:21:10,090 --> 00:21:11,870
.إذًا هذا ما كان يقصده

293
00:21:13,360 --> 00:21:15,470
تومويا-سينباي؟

294
00:21:15,470 --> 00:21:17,880
.تهانينا على قبولكِ يا إيزومي-تشان

295
00:21:18,290 --> 00:21:20,460
.فلنبذل جهدنا معًا

296
00:21:21,180 --> 00:21:22,460
!أجل

297
00:21:24,980 --> 00:21:29,420
.من المخزِ كيف أنّ هذا السّلوك الخبيث يلائمكِ يا ساوامورا-سان

298
00:21:29,420 --> 00:21:32,010
ماذا جاء بكِ إلى هنا أيّتها الخرّيجة؟

299
00:21:32,010 --> 00:21:35,690
لي حريّة التّواجد في أيّ مكانٍ عامّ أرغب، أليس كذلك؟

300
00:21:35,690 --> 00:21:39,910
!سبق وخلّدتِ ذكرياتكِ، والآن اغربي عن هنا بسرعة

301
00:21:39,910 --> 00:21:43,900
.لا يمكنكِ البقاء على عنادكِ حتّى وأنتِ في الجامعة

302
00:21:43,900 --> 00:21:47,330
.هذا صحيح، كلتاكما انسحبتما من المجموعة

303
00:21:47,330 --> 00:21:51,180
.من بالغ الأنانيّة أن ترغبا بالعودة في هذه المرحلة

304
00:21:51,180 --> 00:21:53,670
ماذا جاء بكِ إلى هنا يا آنسة من-مدرسة-أخرى؟

305
00:21:53,670 --> 00:21:56,700
ماذا عن مراسم الدّخول في مدرستكِ؟

306
00:21:56,700 --> 00:21:57,370
،حسنٌ

307
00:21:57,370 --> 00:22:02,290
سمعت من تومو أنّنا سنستأنف أنشطة مجموعتنا
،ظهر اليوم بعد توقّفٍ دام طويلًا

308
00:22:02,290 --> 00:22:04,880
.لِذا لم أستطع الجلوس والانتظار

309
00:22:04,880 --> 00:22:07,980
!لقد فات الأوان على محاولة الظّهور في الشّاشة

310
00:22:07,980 --> 00:22:10,270
!نحن الآن في المشهد الختاميّ

311
00:22:10,270 --> 00:22:13,880
كما أنّكِ كنتِ مختفية طوال النّصف الثّاني، أليس كذلك؟

312
00:22:13,880 --> 00:22:16,730
ماذا تظنّين أنّ بوسعكِ فعله في هذه المرحلة؟

313
00:22:17,180 --> 00:22:22,840
حسنًا، ما بوسعي وما ليس بوسعي فعله
يعتمد على الأحداث المستقبليّة، صحيح؟

314
00:22:22,840 --> 00:22:24,920
...حسنًا، هذا كلّ ما في الأمر

315
00:22:24,920 --> 00:22:25,900
!توقّفي مكانكِ

316
00:22:25,900 --> 00:22:26,720
!لن تذهبي إلى أيّ مكان

317
00:22:26,720 --> 00:22:29,170
!لن أسمح لكِ بالتّظاهر كصديقة

318
00:22:29,170 --> 00:22:30,510
!دعاني

319
00:22:30,510 --> 00:22:31,740
!صاحبة الأثداء عديمة النّفع

320
00:22:31,740 --> 00:22:35,580
!لكنّني صديقةٌ حقًّا