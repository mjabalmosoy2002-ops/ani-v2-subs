1
00:00:11,750 --> 00:00:14,280
،تهانينا على تخرّجكِ

2
00:00:14,840 --> 00:00:16,620
.يا أوتاها-سينباي

3
00:01:54,480 --> 00:01:56,840
أواثقةٌ من عدم رغبتكِ حضور حفلة التخرّج؟

4
00:01:56,840 --> 00:01:59,970
.لا أشعر أنّه من الضّروريّ الذّهاب

5
00:01:59,970 --> 00:02:02,520
،عندما يتعلّق الأمر بمن هم في فصلي

6
00:02:02,520 --> 00:02:05,910
.فليس لديّ أدنى ارتباطٍ بهم

7
00:02:05,910 --> 00:02:09,100
.أولئك الّذين يضعون الأقنعة يتحدّثون حقًّا بشكلٍ مغاير

8
00:02:09,570 --> 00:02:13,070
.لكن لم أتوقّع قدومك

9
00:02:13,530 --> 00:02:16,740
.خصوصًا بعد جدالنا السّابق

10
00:02:17,780 --> 00:02:21,410
،ربّما يسرّ ذلك ساوامورا إريري

11
00:02:21,410 --> 00:02:25,750
.لكن لا أتصوّر أنّه يُسعد كاشيواجي إري

12
00:02:26,630 --> 00:02:31,670
.حسنٌ، ذلك جزءٌ من سبب قدومي اليوم إلى هنا

13
00:02:32,540 --> 00:02:33,920
،تجادلنا

14
00:02:33,920 --> 00:02:38,120
.كما أنّي تخرّجت، وعلى الأرجح أنّ هذا لقاؤنا الأخير

15
00:02:38,120 --> 00:02:39,680
،لِذا إن كانت طرقنا ستنفصل

16
00:02:39,680 --> 00:02:42,180
".فأنا أريد شيئًا أتذكّركِ به يا أوتاها-سينباي"

17
00:02:42,180 --> 00:02:45,050
تقولها كما لو أنّك تحاول قضاء ليلةٍ معي قبل أن تهجرني؟

18
00:02:45,050 --> 00:02:45,850
!لا

19
00:02:45,850 --> 00:02:47,390
!الأمر ليس كذلك إطلاقًا

20
00:02:47,880 --> 00:02:49,860
،لكن إن كنّا سنخلّد ذكرى

21
00:02:49,860 --> 00:02:53,150
فهلّا سمحت لي على الأقل بالذّهاب
إلى المنزل لارتداء ملابس أكثر أناقة؟

22
00:02:53,150 --> 00:02:57,240
.مع أنّه إن كنّا سنخلّد ذكرى تخرّجي، فيجب أن أرتدي زيّي المدرسيّ

23
00:02:57,240 --> 00:02:59,510
.أتساءل أيّهما الخيار الصّائب

24
00:02:59,510 --> 00:03:03,450
المعذرة، أنا أحاول أن أكون جدّيًّا، فهلّا أطبقتِ فمكِ؟

25
00:03:05,450 --> 00:03:06,790
!أوتاها-سينباي

26
00:03:09,900 --> 00:03:11,670
.هذا جوابي

27
00:03:11,670 --> 00:03:15,460
.إنّي حقًّا أريد مواصلة صنع الألعاب مع نفس الأعضاء الحاليّين

28
00:03:16,010 --> 00:03:17,300
،معكِ ومع إريري

29
00:03:17,300 --> 00:03:19,060
،ميتشيرو

30
00:03:19,060 --> 00:03:20,380
.ومع كاتو أيضًا

31
00:03:20,700 --> 00:03:21,840
،ومن أجل تحقيق ذلك

32
00:03:21,840 --> 00:03:25,720
.فكّرت بأنّ كلّ ما بيدي فعله هو كتابة مقترحٍ ينال إعجابكنّ

33
00:03:26,820 --> 00:03:29,290
وذلك ما يتمحور عليه هذا المقترح؟

34
00:03:29,290 --> 00:03:30,480
.أجل

35
00:03:31,710 --> 00:03:33,980
.إذًا اسمح لي بقراءته

36
00:03:33,980 --> 00:03:35,730
.من فضلكِ

37
00:03:59,590 --> 00:04:00,470
.شكرًا لك

38
00:04:00,470 --> 00:04:02,440
ما-ما رأيكِ؟

39
00:04:03,620 --> 00:04:05,140
.أمنحه 75 نقطة

40
00:04:06,100 --> 00:04:08,220
.أبليت حسنًا يا أخلاقيّ-كُن

41
00:04:08,220 --> 00:04:11,540
،رغم أنّ القصّة والحبكة ليستا أصليّتين بالكامل

42
00:04:11,540 --> 00:04:14,380
.لكنّك وظّفت الأفكار المبتذلة بطريقةٍ مدروسة

43
00:04:14,380 --> 00:04:15,800
،لا تحاول التّخالف عمدًا

44
00:04:15,800 --> 00:04:18,480
.لكنّك تلعب على جاذبيّة الشّخصيّات

45
00:04:18,480 --> 00:04:22,450
.إنّها مقاربةٌ مماثلةٌ للعبة محاكاة مواعدة، ملائمةٌ للعبة موي

46
00:04:22,450 --> 00:04:25,700
.بالطّبع لا أعني ذلك على نحوٍ سلبيّ

47
00:04:25,700 --> 00:04:29,590
،أحبّ القصص الرّومنسيّة والعاطفيّة مثل لعبتنا السّابقة

48
00:04:29,590 --> 00:04:36,500
لكنّني تذكّرت أنّ هدفي الأصليّ من إنشاء هذه المجموعة
.كان لإيصال ظرافة البطلة للجميع

49
00:04:38,850 --> 00:04:39,970
.أجل

50
00:04:39,970 --> 00:04:44,130
.ما كتبته هنا يُبرز بوضوحٍ ما تريد صنعه

51
00:04:44,130 --> 00:04:46,300
.ويمكن الإحساس بتلك الرّغبة تنبعث منه

52
00:04:46,300 --> 00:04:49,420
.شكرًا لكِ يا أوتاها-سينباي

53
00:04:49,420 --> 00:04:52,310
.أعطيت هذا المقترح تقييمًا صادقًا ليس إلّا

54
00:04:52,780 --> 00:04:54,840
.ليس شيئًا يستحقّ أن تشكرني عليه

55
00:04:56,380 --> 00:04:58,060
،في هذه الحالة

56
00:04:58,060 --> 00:05:00,940
هلّا انضممتِ إلى هذا المشروع؟

57
00:05:03,900 --> 00:05:06,410
!إن كان ثقلًا عليكِ، فيكفي أن تتولّي ما باستطاعتكِ فحسب

58
00:05:06,860 --> 00:05:08,160
!مسارٌ واحدٌ يكفي

59
00:05:08,460 --> 00:05:10,630
!لا، الإشراف وحده يكفي

60
00:05:10,630 --> 00:05:11,570
...لِذا

61
00:05:12,380 --> 00:05:13,660
!ألتمس موافقتكِ

62
00:05:19,030 --> 00:05:22,310
هل تحدّثت مع ساوامورا-سان؟

63
00:05:22,310 --> 00:05:23,680
إريري؟

64
00:05:23,680 --> 00:05:25,420
ما كان جوابها؟

65
00:05:26,160 --> 00:05:28,110
هل وافقت على الانضمام؟

66
00:05:28,110 --> 00:05:30,430
.لا، لم أسألها بعد

67
00:05:31,180 --> 00:05:33,740
.يبدو أنّي من سيضطرّ لإخبارك

68
00:05:35,210 --> 00:05:37,480
.هذا غير منصفٍ يا ساوامورا-سان

69
00:05:38,770 --> 00:05:41,190
أوتاها-سينباي؟

70
00:05:42,120 --> 00:05:44,440
.آسفةٌ يا تومويا-كُن

71
00:05:45,570 --> 00:05:48,450
.لا أستطيع مواصلة العمل معك

72
00:05:48,860 --> 00:05:49,450
ماذا؟

73
00:05:53,130 --> 00:05:54,700
لماذا؟

74
00:05:56,460 --> 00:05:59,680
.لم أعد أملك الوقت للانضمام لمشاريعك

75
00:05:59,680 --> 00:06:01,930
.أعدكِ أنّي لن أحمّلكِ المحال

76
00:06:01,930 --> 00:06:03,700
!لا أنتِ ولا إريري

77
00:06:03,700 --> 00:06:05,390
.لهذا السّبب بالذّات يا تومويا-كُن

78
00:06:06,220 --> 00:06:11,720
.لم تقدر قطّ على طلب المحال منّي أو من ساوامورا-سان

79
00:06:12,100 --> 00:06:16,160
.لم تقدر قطّ حتّى على قول أنّه مشروعٌ يستحقّ التّضحية من أجله

80
00:06:16,160 --> 00:06:21,430
أنى لي أن أقول شيئًا كهذا؟

81
00:06:21,430 --> 00:06:23,480
،المبدعون أمثالنا

82
00:06:23,480 --> 00:06:27,910
.إن لم يُطلب منّا التّحامل على أنفسنا فإنّنا نتوقّف عن التطوّر

83
00:06:27,910 --> 00:06:29,420
،مواجهة مواعيد نهائيّة عسيرة

84
00:06:29,420 --> 00:06:32,180
...النّضال لإيجاد التّوازن بين الجودة والسّرعة

85
00:06:32,180 --> 00:06:35,490
.لن نتحسنّ ما لم نواجه تلك التحدّيات العصيبة

86
00:06:35,940 --> 00:06:38,490
...أوتاها-سينباي

87
00:06:38,490 --> 00:06:40,180
،لهذا يا تومويا-كُن

88
00:06:40,180 --> 00:06:42,750
.لست جديرًا بأن تكون منتجًا

89
00:06:42,750 --> 00:06:47,970
.يجب أن تعرف كيف تدفع الآخرين لتجاوز حدودهم دون فعل شيء

90
00:06:47,970 --> 00:06:52,120
.يجب أن تُري الجحيم للآخرين بينما تتراجع أنت

91
00:06:52,120 --> 00:06:55,340
،إن لم تقوَ على جعل المبدعين يتّبعونك إلى درجة شعورك بالذّنب

92
00:06:55,340 --> 00:06:56,880
.فقد فشلت كمنتج

93
00:06:57,890 --> 00:07:02,560
هل مثل أولئك الأشخاص المجانين موجودون؟

94
00:07:03,110 --> 00:07:06,570
.أحدهم قال لي أن أموت في سبيل هذا المشروع

95
00:07:07,560 --> 00:07:09,490
،وعندما تمعّنت في تفاصيله

96
00:07:09,490 --> 00:07:11,770
.فكّرت أنّي لن أمانع الموت من أجله

97
00:07:19,170 --> 00:07:20,830
.مهلًا لحظة

98
00:07:20,830 --> 00:07:22,950
...وقائع الميادين

99
00:07:22,950 --> 00:07:24,840
أهي حقًّا وقائع الميادين؟

100
00:07:25,510 --> 00:07:27,860
،بما أنّ هذه السّنة هي الذّكرى العشرين

101
00:07:27,860 --> 00:07:30,330
،فإنّهم يصنعون جزءًا جديدًا على ما يبدو

102
00:07:30,330 --> 00:07:33,000
.مع طاقم عملٍ جديد

103
00:07:33,000 --> 00:07:35,100
تقصدين... كوساكا-أكاني؟

104
00:07:35,100 --> 00:07:38,120
.على الأرجح أنّها ستخلق ضجّةً حينما تصدر

105
00:07:38,120 --> 00:07:40,350
،كوساكا أكاني الأشهر من نارٍ على علم

106
00:07:40,630 --> 00:07:43,600
.ستعمل هذه المرّة على لعبة تقمّص أدوارٍ ملحميّة

107
00:07:46,280 --> 00:07:47,860
ما هذا؟

108
00:07:48,410 --> 00:07:53,410
،إن كنت مكاني وسلّمك أحدهم مقترحك وهذا المقترح

109
00:07:53,410 --> 00:07:55,830
،وطُلب منك اختيار أحدهما

110
00:07:55,830 --> 00:07:56,790
ماذا ستفعل؟

111
00:07:59,910 --> 00:08:01,750
.آسفةٌ يا تومويا-كُن

112
00:08:01,750 --> 00:08:06,520
أتقولين أنّ كوساكا أكاني تلك اكتشفتكِ؟

113
00:08:06,520 --> 00:08:07,920
بعرض هذا عليكِ؟

114
00:08:08,860 --> 00:08:11,080
.هذا ليس دقيقًا تمامًا

115
00:08:11,080 --> 00:08:13,480
ماذا حدث إذًا؟

116
00:08:13,480 --> 00:08:14,680
!آسفة

117
00:08:14,680 --> 00:08:16,050
!آسفةٌ على ماذا؟

118
00:08:16,980 --> 00:08:19,890
...الشّخص الّذي ابتغته كوساكا أكاني أكثر

119
00:08:20,900 --> 00:08:22,650
.ليس أنا

120
00:08:29,620 --> 00:08:32,900
...سامحني يا تومويا-كُن

121
00:08:36,260 --> 00:08:39,290
هل أصبحت الأولى في نظرك؟

122
00:08:41,040 --> 00:08:43,870
.لن ألومك إن كرهتني

123
00:08:43,870 --> 00:08:44,710
.محال

124
00:08:44,710 --> 00:08:50,290
!لكن رغم ذلك، أردت أن أتعاون مع كاشيواجي إري مجدّدًا

125
00:08:54,600 --> 00:08:55,880
.هذا محال

126
00:09:01,550 --> 00:09:02,520
...آسفة

127
00:09:04,420 --> 00:09:07,050
!أنا آسفةٌ يا تومويا

128
00:09:30,920 --> 00:09:33,130
...حسنًا، لنرَ

129
00:09:36,860 --> 00:09:38,390
فشلٌ آخر؟

130
00:09:41,100 --> 00:09:44,570
.رغم أنّها لا تبدو لي بذلك السّوء

131
00:09:44,570 --> 00:09:46,250
ما الّذي لا يعجبكِ فيها؟

132
00:09:46,250 --> 00:09:49,220
!منذ متى وأنتِ هنا يا كاسوميغاوكا أوتاها؟

133
00:09:49,220 --> 00:09:50,400
...دعيني أرى

134
00:09:50,400 --> 00:09:55,320
.ربّما منذ أن كنتِ تبتسمين على رسائل أخلاقيّ-كُن بابتسامةٍ عريضة

135
00:09:56,000 --> 00:09:59,170
".سأنتظرك. سأنتظرك إلى الأبد يا تومويا"

136
00:09:59,170 --> 00:10:00,320
.صِدقًا

137
00:10:00,320 --> 00:10:03,860
.هذا تحوّلٌ بالغٌ في سلوككِ

138
00:10:03,860 --> 00:10:06,170
.كما لو أنّه انفصامٌ في الشّخصيّة

139
00:10:06,170 --> 00:10:09,040
!اخرسي أيّتها المسترقة ذات الشّعر الأسود الطّويل

140
00:10:09,040 --> 00:10:12,390
أليست كاتو-سان من تتّصف بذلك هذه الأيّام؟

141
00:10:12,390 --> 00:10:17,800
!أساسًا، ليس من شأنكِ من أنتظر أو مع من أسير إلى المنزل

142
00:10:17,800 --> 00:10:20,040
،صحيحٌ أنّي لا أكترث لذلك

143
00:10:20,040 --> 00:10:23,520
لكن ماذا لو رآكِ أصدقاؤكِ برفقته؟

144
00:10:23,520 --> 00:10:28,560
ألستِ تُخفين نشاطاتكِ في المجموعة وعلاقتكِ بأخلاقيّ-كُن؟

145
00:10:28,560 --> 00:10:30,320
.نحن نتشارك طريق عودتنا إلى المنزل فقط

146
00:10:30,320 --> 00:10:32,150
.لا جُرم في ذلك

147
00:10:32,560 --> 00:10:33,880
...بالإضافة

148
00:10:33,880 --> 00:10:34,940
بالإضافة؟

149
00:10:35,900 --> 00:10:41,660
أتظنّين أنّي سأظلّ أُصاحب أشخاصًا سيحاسبونني على شيءٍ كهذا؟

150
00:10:42,910 --> 00:10:44,470
.معكِ حقّ

151
00:10:44,470 --> 00:10:47,160
.كما أنّ هناك بقعة طلاءٍ على وجهكِ

152
00:10:51,230 --> 00:10:53,170
لماذا لا تنصرفين؟

153
00:10:53,520 --> 00:10:56,380
أيعقل أنّكِ تنوين مرافقتنا؟

154
00:10:56,380 --> 00:10:59,630
.لا أنوي أن أكون طفوليّةً إلى هذا الحدّ

155
00:10:59,630 --> 00:11:03,400
.سأغادر قبل أن يصل، حالما ننهي حديثنا

156
00:11:03,400 --> 00:11:05,210
عمّ تودّين الحديث؟

157
00:11:05,210 --> 00:11:08,060
أما زال لديكِ طرقٌ أخرى للسّخريّة منّي؟

158
00:11:08,510 --> 00:11:10,280
،الرّسمة الّذي كنتِ تعملين عليها

159
00:11:10,280 --> 00:11:13,530
هي التّصميم الجديد لصفحة مجموعتنا، أليس كذلك؟

160
00:11:13,530 --> 00:11:15,370
متى ستفرغين منها؟

161
00:11:17,370 --> 00:11:21,840
أتذكّر أنّ الموعد النّهائيّ الأوّل كان في يناير، أليس كذلك؟

162
00:11:21,840 --> 00:11:23,710
في أيّ يومٍ من فبراير نحن الآن؟

163
00:11:23,710 --> 00:11:25,440
!أعلم ذلك

164
00:11:25,440 --> 00:11:28,200
،لن أقول لكِ ألّا يستحوذ رجلٌ على تفكيركِ

165
00:11:28,200 --> 00:11:30,800
.فقد مررت من ذلك أيضًا

166
00:11:30,800 --> 00:11:32,140
.لستُ أجهل ذلك

167
00:11:32,140 --> 00:11:34,210
.لم يستحوذ أيّ رجلٍ على تفكيري

168
00:11:34,210 --> 00:11:36,650
.وأنتِ تكذبين بشأنِ مروركِ من ذلك

169
00:11:36,650 --> 00:11:39,080
،لكن سواءً كان دوجين أو عملًا تجاريًّا

170
00:11:39,080 --> 00:11:41,400
.يجب أن تنهي عملكِ بإتقان

171
00:11:41,400 --> 00:11:43,110
أنتِ مبدعة، أليس كذلك؟

172
00:11:45,270 --> 00:11:48,590
.كلّ ما في الأمر أنّي لم أتعاف من نزلة البرد الّتي ألمّت بي رأس السّنة

173
00:11:48,590 --> 00:11:50,230
...فور تحسّن حالتي

174
00:11:50,230 --> 00:11:53,780
رغم مضيّ أكثر من شهرٍ على ذلك؟

175
00:11:53,780 --> 00:11:55,230
!لا يسعني فعل شيء

176
00:11:55,720 --> 00:11:58,990
!لسببٍ ما، أصبحت رسّامةً فاشلة

177
00:12:00,390 --> 00:12:04,990
لا أستطيع الاقتراب إطلاقًا لمستوى الرّسومات
.الّتي رسمتها في ناسو كوغين

178
00:12:04,990 --> 00:12:07,240
ألا تظنّين أنّ ذلك من نسج مخيّلتكِ فحسب؟

179
00:12:07,240 --> 00:12:10,000
وماذا تعرفين عن كون المرء رسّامًا؟

180
00:12:13,860 --> 00:12:17,500
.مع ذلك، في السّابق كنتِ لتتدبّري الأمر بطريقةٍ ما

181
00:12:17,840 --> 00:12:21,140
.كنتِ لتبذلي أقصى ما باستطاعتكِ في المهلة المحدّدة

182
00:12:21,140 --> 00:12:24,920
.على الأقل ما كنتِ لتستسلمي حتّى آخر لحظة

183
00:12:24,920 --> 00:12:27,640
أين ذهب فخركِ كمبدعة؟

184
00:12:27,640 --> 00:12:31,990
ماذا حلّ بساوامورا إريري الّتي عملت
بلا كللٍ في ناسو كوغين حتّى انهارت؟

185
00:12:34,350 --> 00:12:37,860
!ليس وكأنّها ستباع أو ستؤثّر على جودة اللّعبة

186
00:12:38,190 --> 00:12:39,400
...ساوامورا-سان

187
00:12:39,400 --> 00:12:42,650
.كما أنّ تومويا سيسامحني على هذا

188
00:12:42,940 --> 00:12:44,740
،حتّى إن لم أرسم

189
00:12:44,740 --> 00:12:48,370
...أعلم أنّ تومويا سيظلّ

190
00:12:49,270 --> 00:12:51,080
.آمل ذلك

191
00:12:52,640 --> 00:12:54,710
.إلى اللّقاء إذًا يا ساوامورا-سان

192
00:13:00,350 --> 00:13:01,630
.أعتذر عن تأخّري

193
00:13:02,680 --> 00:13:04,800
هل من خطبٍ ما؟

194
00:13:04,800 --> 00:13:06,800
.لا، لا شيء

195
00:13:07,750 --> 00:13:09,000
هلّا ذهبنا؟

196
00:13:12,470 --> 00:13:13,640
ماروزو؟

197
00:13:13,640 --> 00:13:14,680
!أجل

198
00:13:14,680 --> 00:13:16,790
.شركة الألعاب المتواجدة في أوساكا

199
00:13:16,790 --> 00:13:20,690
،إذًا فحتّى أنتِ يا شي-تشان المهتمّة بالقراءة والفتيان الأصغر سنًّا فقط

200
00:13:20,690 --> 00:13:22,780
!تعلمين بشأنها

201
00:13:22,780 --> 00:13:26,910
.أرجوكِ لا تجعلي​ الأمر يبدو كما لو أنّي منجذبةٌ لمن هم أصغر منّي

202
00:13:27,320 --> 00:13:32,620
.شركة ماروزو لديها سلسلة تقمّص أدوارٍ تدعى وقائع الميادين

203
00:13:33,020 --> 00:13:36,080
.ويريدون من أحدهم أن يشارك في العمل على لعبتهم الجديدة

204
00:13:36,080 --> 00:13:37,160
من؟

205
00:13:37,160 --> 00:13:38,040
.ماروزو

206
00:13:38,040 --> 00:13:39,140
من يريدون؟

207
00:13:39,140 --> 00:13:40,920
.كاسومي أوتاكو-سينسي

208
00:13:42,740 --> 00:13:45,210
.في الواقع، بيننا علاقات عملٍ بالفعل

209
00:13:45,210 --> 00:13:48,430
.يسمحون لنا بنشر رواياتهم ومجلّاتهم الخاصّة

210
00:13:48,430 --> 00:13:51,280
أيعني هذا أنّهم يريدون منّي العمل على اقتباس روايةٍ من اللّعبة؟

211
00:13:51,280 --> 00:13:52,740
.لا

212
00:13:52,740 --> 00:13:54,570
.يريدون منكِ كتابة السّيناريو الرّئيسيّ للّعبة

213
00:13:56,980 --> 00:13:59,610
.الرّؤساء مبتهجون كثيرًا

214
00:13:59,610 --> 00:14:02,950
!فأحد مؤلّفينا سيكون الكاتب الرّئيسيّ لقصّة وقائع الميادين

215
00:14:02,950 --> 00:14:08,200
.وهذا يكفُل لنا عمليًّا حقوق النّشر المربحة

216
00:14:08,200 --> 00:14:13,890
وهل تظنّين أنّي سأتمكّن ببساطةٍ من كتابة سيناريو لعبة تقمّص أدوارٍ خياليّة؟

217
00:14:13,890 --> 00:14:15,790
.ربّما كنتُ لأستطيع لو كانت لعبة دوجين

218
00:14:18,000 --> 00:14:20,400
.أظنّ أنّكِ قادرةٌ على ذلك

219
00:14:20,400 --> 00:14:25,670
فموهبة كاسومي أوتاكو ما زالت واسعةً
.وعميقة ولا نهاية تلوح لها في الأفق

220
00:14:26,630 --> 00:14:30,040
.لكنّني أشعر أنّ هذا ليس الوقت المناسب لذلك

221
00:14:30,040 --> 00:14:33,530
.لا أظنّكِ مستعدّةً بعد لتعملي تحت إمرة ذلك الشّخص

222
00:14:34,450 --> 00:14:35,470
ذلك الشّخص؟

223
00:14:35,970 --> 00:14:39,100
.الشّخص الّذي عرض هذه الصّفقة عليكِ مباشرةً

224
00:14:39,100 --> 00:14:44,440
شخصٌ يحيط علمًا بكلّ شيء يتعلّق بالدّوجين
.والنّشر التّجاري، حتّى في جانبه المظلم

225
00:14:44,440 --> 00:14:46,510
.محترفة احتراف

226
00:14:46,510 --> 00:14:47,990
من تكون؟

227
00:14:48,980 --> 00:14:51,740
.كوساكا أكاني

228
00:14:51,740 --> 00:14:54,470
من روج إن روج؟

229
00:14:54,470 --> 00:14:58,280
.يبدو أنّها تركت مجموعة الدّوجين خاصّتها ليديرها شركاؤها الأصغر سنًّا

230
00:14:59,080 --> 00:15:01,090
،لكن في مجال النّشر التّجاريّ ولعدّة سنوات الآن

231
00:15:01,090 --> 00:15:06,960
.كانت مؤلّفة مانجا تتجاوز مبيعات أعمالها المليون نسخة

232
00:15:06,960 --> 00:15:11,930
لِم قد تهتمّ مبدعةٌ متفوّقةٌ بشخصٍ مثلي؟

233
00:15:11,930 --> 00:15:14,470
.لقد وجدت ما تبحث عنه بعد أن لعبت هذه على ما يبدو

234
00:15:14,790 --> 00:15:19,940
.قالت أنّ كاتبة السّيناريو والرّسامة تلائمان مشروعها التّالي

235
00:15:19,940 --> 00:15:22,400
،الرسّامة

236
00:15:22,400 --> 00:15:23,560
أيضًا؟

237
00:15:25,190 --> 00:15:27,440
هل أنتِ واثقةٌ من هذا يا ساوامورا-سان؟

238
00:15:27,440 --> 00:15:30,700
.لمجيئكِ رغم عدم نيّتكِ بقبول العمل

239
00:15:30,700 --> 00:15:32,410
.ما بيدي حيلة

240
00:15:32,410 --> 00:15:35,770
.أنتِ من قالت أنّ عليكِ مقابلتهم على الأقل

241
00:15:35,770 --> 00:15:40,260
.توجّب عليّ المجيء بسبب التزاماتي مع دار نشر فوشيكاوا

242
00:15:40,260 --> 00:15:41,120
—لكن أنتِ

243
00:15:41,120 --> 00:15:45,370
!إن كنتِ وحدكِ، فسأقلق من أنّهم قد يقنعونكِ بقبول العرض

244
00:15:45,370 --> 00:15:48,470
.لا أرى سببًا يدفعكِ للقلق حيال ذلك

245
00:15:48,470 --> 00:15:51,920
،ما كنتُ لأحزن أو أغضب إن قبلتِ

246
00:15:51,920 --> 00:15:53,680
.لكن تومويا سينزعج

247
00:15:53,680 --> 00:15:55,250
...ساوامورا-سان

248
00:15:56,470 --> 00:15:59,110
،لم يأتِ على ذكرها

249
00:15:59,110 --> 00:16:01,930
.لكنّه يخطّط لمشروعه الجديد على ما يبدو

250
00:16:01,930 --> 00:16:06,940
!سيُحبط إذا ما فقد فجأةً كاتبته الرّئيسيّة

251
00:16:11,330 --> 00:16:13,910
.وصل ضيوفكِ

252
00:16:17,410 --> 00:16:19,410
.عن إذنكم

253
00:16:22,860 --> 00:16:24,730
...ا-المعذرة

254
00:16:24,730 --> 00:16:26,920
أنتِ من شركة ماروزو، صحيح؟

255
00:16:32,380 --> 00:16:33,940
!كوساكا أكاني

256
00:16:33,940 --> 00:16:34,740
ماذا؟

257
00:16:34,740 --> 00:16:36,300
!كوساكا أكاني؟

258
00:16:36,300 --> 00:16:37,240
أهذه هي؟

259
00:16:37,240 --> 00:16:38,260
!محال

260
00:16:40,270 --> 00:16:43,590
.مرّ وقتٌ طويل يا كاشيواجي-سينسي

261
00:16:43,590 --> 00:16:46,020
كيف هي حالتكِ الصحيّة؟

262
00:16:46,860 --> 00:16:48,520
هل تقابلنا من قبل؟

263
00:16:49,990 --> 00:16:51,530
.من يدري

264
00:16:51,530 --> 00:16:52,960
جئتِ وحدكِ؟

265
00:16:52,960 --> 00:16:54,690
ماذا عن ممثّلي شركة ماروزو؟

266
00:16:54,690 --> 00:16:57,500
.لا حاجة لنا بتلك الرّسميّات

267
00:16:57,500 --> 00:17:01,270
.وحدهم المبدعون ينبغي أن يكونوا هنا

268
00:17:02,030 --> 00:17:03,540
.لديكما ثلاثون دقيقة لقراءة هذا

269
00:17:03,540 --> 00:17:05,580
.وبعدها قرّرا

270
00:17:05,580 --> 00:17:07,410
نقرّر ماذا؟

271
00:17:07,410 --> 00:17:10,840
.إن كنتما ستشاركان في هذا المشروع من عدمه

272
00:17:10,840 --> 00:17:12,880
ما هذا الهراء الّذي تتفوّهين به؟

273
00:17:13,160 --> 00:17:16,050
.إنّها سلسلةٌ استمرّت على مدار عشرين سنة

274
00:17:16,050 --> 00:17:19,680
!لا أريد التّفكير بأنّ قصّتي ناقصة إلى هذا الحدّ

275
00:17:19,680 --> 00:17:21,350
!هذا ليس ما أعنيه

276
00:17:21,350 --> 00:17:24,870
!قصدت ألّا تستبقي الأمور

277
00:17:24,870 --> 00:17:27,740
—لم نقل بتاتًا أنّنا سنشارك

278
00:17:27,740 --> 00:17:28,730
!مهلًا

279
00:17:28,730 --> 00:17:30,610
لماذا تفتحينه يا كاسوميغاوكا أوتاها؟

280
00:17:30,610 --> 00:17:33,040
ألن تطّلعي عليه يا ساوامورا-سان؟

281
00:17:33,740 --> 00:17:35,860
...مهلًا لحظة، أنتِ

282
00:17:36,500 --> 00:17:39,370
.هذا مقترحٌ من إعداد كوساكا أكاني

283
00:17:39,370 --> 00:17:42,200
.إنّه أحد أعمالها

284
00:18:04,670 --> 00:18:07,650
.إليّ بأيّ أفكارٍ أو تساؤلات أو انتقادات

285
00:18:07,650 --> 00:18:11,060
.لكن فقط إن ملكتما الجرأة للدّفاع عن وجهة نظركما

286
00:18:13,320 --> 00:18:16,960
ما الّذي تطلبين منّا فعله؟

287
00:18:19,620 --> 00:18:20,320
.الموت

288
00:18:21,700 --> 00:18:25,080
.هذا هو المشروع الّذي ستفنيان حياتكما عليه

289
00:18:25,080 --> 00:18:26,310
،طوال سنةٍ كاملة

290
00:18:26,310 --> 00:18:28,410
،صبّ تركيزكما على هذا المشروع

291
00:18:28,410 --> 00:18:30,140
،عيشا لأجل هذا المشروع

292
00:18:30,140 --> 00:18:32,580
.كرّسا حياتكما لإكمال هذا المشروع

293
00:18:32,580 --> 00:18:34,500
!ما هذا الّذي تقولينه فجأةً؟

294
00:18:34,500 --> 00:18:36,270
.كاشيواجي إري

295
00:18:36,270 --> 00:18:41,090
.الرّسومات السّبع الأخيرة للّعبة الّتي أصدرتموها مؤخّرًا

296
00:18:41,760 --> 00:18:42,550
...ذلك

297
00:18:43,160 --> 00:18:44,490
.ذلك ما أبتغيه

298
00:18:44,490 --> 00:18:45,310
،لا

299
00:18:45,310 --> 00:18:47,560
.تجاوزي ذلك حتّى

300
00:18:47,560 --> 00:18:50,060
.إن لم تفعلي، فلن يكون لها معنى

301
00:18:50,060 --> 00:18:51,860
!عمّ تتحدّثين؟

302
00:18:51,860 --> 00:18:53,900
!يستحيل أن أوافق على هذا

303
00:18:53,900 --> 00:18:57,770
!لديّ مجموعتي.... بليسينغ سوفتوير

304
00:18:57,770 --> 00:19:01,570
لكنّكِ غير قادرةٍ على البقاء في تلك المجموعة بعد الآن، أليس كذلك؟

305
00:19:03,080 --> 00:19:07,700
إن ظلّت الأمور على حالها، فإن موهبتكِ
.ستغلب على الأشخاص المحيطين بكِ

306
00:19:07,700 --> 00:19:10,830
.لن يستطيع أحدٌ مواكبتكِ

307
00:19:10,830 --> 00:19:12,430
!هذا ليس صحيحًا

308
00:19:12,430 --> 00:19:14,490
.إنّه كذلك

309
00:19:14,490 --> 00:19:19,050
.كاسومي أوتاكو هي الوحيدة الّتي بالكاد تواكب تلك المجموعة

310
00:19:19,050 --> 00:19:21,320
،لِذا يا كاسومي أوتاكو

311
00:19:21,320 --> 00:19:25,180
.أتوقّع منكِ أن تبرزي كامل إمكانيّات كاشيواجي إري

312
00:19:25,470 --> 00:19:28,090
.فنّيًّا وذهنيًّا

313
00:19:28,090 --> 00:19:31,840
أترمين إلى أنّي سأكون مساعدة ساوامورا-سان؟

314
00:19:31,840 --> 00:19:35,650
.أنا حقًّا أظنّ أنّ السّيناريو الّذي كتبته لتلك اللّعبة كان محكمًا

315
00:19:36,320 --> 00:19:39,360
،لكن إن لم تنضَمِمْ كاشيواجي إري

316
00:19:39,360 --> 00:19:42,120
.فلا معنى من إشراك كاسومي أوتاكو وحدها

317
00:19:43,110 --> 00:19:45,830
.لا أستطيع التّعامل مع عملٍ ضخمٍ كهذا

318
00:19:45,830 --> 00:19:48,410
،أعلم أنّها فرصةٌ لا تعوّض

319
00:19:48,410 --> 00:19:50,830
.لكنّي لم أعد أستطيع الرّسم كما السّابق

320
00:19:50,830 --> 00:19:53,190
ماذا، القليل من الرّكود؟

321
00:19:53,190 --> 00:19:54,560
!ليس قليلًا فقط

322
00:19:54,560 --> 00:19:56,870
!لقد بلغت حدّ قدراتي! لن أقدر مطلقًا على الرّسم بتلك الطّريقة مجدّدًا

323
00:19:56,870 --> 00:19:57,960
!ساوامورا-سان

324
00:20:14,170 --> 00:20:16,730
!لا تجعليني أضحك أيّتها الفاشلة

325
00:20:22,110 --> 00:20:24,720
!ما زلتِ بعيدةً كلّ البعد عن قمّة مستواكِ

326
00:20:24,720 --> 00:20:27,780
!انتكستِ مرّةً وتقولين أنّكِ في ركود؟

327
00:20:27,780 --> 00:20:29,490
!أتسمّين نفسكِ رسّامة؟

328
00:20:29,960 --> 00:20:31,200
...توقّفي

329
00:20:31,200 --> 00:20:33,540
!ذلك لا يعدّ ركودًا أو أيّ شيء

330
00:20:33,540 --> 00:20:35,040
!أنتِ فاشلةٌ فحسب

331
00:20:35,040 --> 00:20:37,420
!مهاراتكِ لم تبلغ ذروتها فحسب

332
00:20:36,420 --> 00:20:37,420
...توقّفي

333
00:20:37,420 --> 00:20:39,500
!هذا يكفي

334
00:20:44,090 --> 00:20:45,650
...لأنّه كما تعلمين

335
00:20:45,650 --> 00:20:49,760
رسمكِ على هذه الشّاكلة، صحيح؟

336
00:21:01,610 --> 00:21:05,240
.أحترمه على الأقلّ لكونه أصليًّا

337
00:21:06,500 --> 00:21:08,240
...لا يعقل

338
00:21:08,240 --> 00:21:12,000
.لكن ما زال بالإمكان تقليده بسهولة

339
00:21:12,820 --> 00:21:14,430
.عن أسلوبكِ أتحدّث