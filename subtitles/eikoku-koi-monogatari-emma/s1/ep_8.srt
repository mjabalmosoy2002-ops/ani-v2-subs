1
00:01:56,860 --> 00:02:01,870
الحلقة الثامنة
[ ساعة الجيب ]

2
00:02:16,550 --> 00:02:17,840
.عمت صباحًا

3
00:02:33,940 --> 00:02:39,740
.يصدر مزلاج الباب الخلفيِّ صريرًا مزعجًا
فهل تودِّين منِّي أن أدهنه لاحقًا؟

4
00:02:39,820 --> 00:02:45,370
.افعل ذلك من فضلك
.كما ترجو منك سيِّدتي تقصير عكَّازها ببوصةٍ واحدة

5
00:02:45,450 --> 00:02:46,450
مجدَّدًا؟

6
00:02:46,790 --> 00:02:49,120
هل انخفضت حمَّى (كيلي)؟

7
00:02:49,250 --> 00:02:51,960
.أجل، تعافت من نزلة برد

8
00:02:52,290 --> 00:02:55,550
.ولكنَّها فقدت شهيَّتها منذ بضعة أيَّام

9
00:02:55,630 --> 00:03:00,180
.حسنٌ، أرتئي أنَّ كبار السِّنِّ يقتضي منهم وقتًا ليتعافوا

10
00:03:02,930 --> 00:03:11,350
"،ينبغي تخزين السُّكَّر على الدَّوام"
".رطل من الشَّاي، نصف لتر من الخلِّ، وربع لتر من الحليب"

11
00:03:11,850 --> 00:03:18,190
"العدس الأحمر والفاصوليا العريضة والكُرَّاث"
".هم الأرخص سعرًا عند بائعي الخضار في حديقة كوفنت غاردن"

12
00:03:20,110 --> 00:03:22,530
.ستغدين بعلة رائعة

13
00:03:33,210 --> 00:03:35,670
.أُمرت بتسليمك هذه

14
00:03:37,000 --> 00:03:38,510
.شكرًا لك كالمعتاد

15
00:03:38,590 --> 00:03:39,630
.عفوًا

16
00:04:11,290 --> 00:04:12,750
هل أعددت الإفطار؟

17
00:04:12,830 --> 00:04:15,170
ألن تهمِّي بتناول القليل؟

18
00:04:15,580 --> 00:04:18,300
.لست جائعة إلى هذا الحدِّ

19
00:04:18,380 --> 00:04:22,050
.ولكن يجدر بك تناول لقمة على الأقلِّ

20
00:04:23,550 --> 00:04:25,550
.طيِّب، لربَّما سأتناول الشُّوربة

21
00:04:42,070 --> 00:04:45,910
هل استلمت رسالة أخرى من السَّيِّد الصَّغير (جونز)؟

22
00:04:49,330 --> 00:04:51,910
.من السَّهل قراءة وجهك

23
00:04:58,380 --> 00:05:00,170
!ما أبهى الطَّقس

24
00:05:00,420 --> 00:05:05,050
.من المؤسف أنِّي لا أستطيع التَّنزُّه في هايد بارك في مثل هذا اليوم البهيِّ

25
00:05:05,680 --> 00:05:09,390
.بمقدورك التَّنزُّه وقتما تشائين ما إن تُشفى ساقك

26
00:05:12,100 --> 00:05:13,640
.أجل

27
00:05:18,020 --> 00:05:19,150
أين (آل)؟

28
00:05:19,230 --> 00:05:23,780
.خرج ليبتاع مزلاجًا جديدًا، لأنَّ مزلاج الباب مكسور

29
00:05:24,490 --> 00:05:25,740
.فهمت

30
00:05:31,410 --> 00:05:33,540
.لقد توقَّفت مجدَّدًا

31
00:05:34,080 --> 00:05:36,710
.تتوقَّف كثيرًا هذه الأيَّام

32
00:05:37,080 --> 00:05:43,000
.كنت أضبطها خمس عشرة مرَّة كلَّ صباح لدهور

33
00:05:43,510 --> 00:05:47,970
.يقتضي بي ضبطها أكثر هذه الأيَّام إذ إنِّي لم أستعملها

34
00:05:49,050 --> 00:05:49,930
.معذرةً

35
00:05:50,970 --> 00:05:53,310
أيجدر بي التَّكفُّل بإصلاحها يا سيِّدتي؟

36
00:06:01,520 --> 00:06:02,940
.نعم

37
00:06:03,020 --> 00:06:04,360
.رجاءً افعلي ذلك

38
00:06:04,530 --> 00:06:05,650
.سمعًا يا سيِّدتي

39
00:06:09,130 --> 00:06:11,620
آذت سيِّدتك ساقها؟

40
00:06:11,700 --> 00:06:12,490
.أجل

41
00:06:12,530 --> 00:06:18,790
،بالرَّغم من سقوط والدي في نهر التِّيمز قبل دهور
.إلاَّ أنَّه انفلت من الغرق، فهو جسور كعادته

42
00:06:19,620 --> 00:06:22,920
.ولكن لم يطل الوقت حتَّى قضى نحبه عندما أُصيبت ساقه

43
00:06:24,840 --> 00:06:27,920
.عليك أن تتركي هذه معي

44
00:06:29,300 --> 00:06:30,430
.حسنٌ

45
00:06:32,680 --> 00:06:37,810
.اعتادت القدوم إلى هنا كثيرًا عندما كان بعلها على قيد الحياة

46
00:06:40,850 --> 00:06:44,940
.حسنٌ، بلِّغي تحيَّاتي إلى سيِّدتك، أتمنَّى لها الشِّفاء العاجل

47
00:06:46,070 --> 00:06:47,110
.حاضر

48
00:06:58,370 --> 00:07:03,710
.سأواظب على محاولة إقناع والدي حتَّى يدرك مدى جدِّيَّة علاقتنا

49
00:07:04,590 --> 00:07:07,760
.أرجو أن تثقي بي وتنتظريني

50
00:07:22,850 --> 00:07:24,190
سيِّد (ويليام)؟

51
00:07:26,150 --> 00:07:28,740
هلاَّ أحطتني علمًا فور عودة والدي؟

52
00:07:29,490 --> 00:07:30,740
.سأكون بالأسفل

53
00:07:30,990 --> 00:07:32,660
.عُلم يا سيِّدي

54
00:07:39,870 --> 00:07:41,580
أين تقع الهند؟

55
00:07:41,830 --> 00:07:43,040
مَن يعلم؟

56
00:07:43,960 --> 00:07:49,420
إذن يا أمير (حكيم)، تعتقد أنَّ النِّساء الهنديَّات هنَّ الأجمل، صحيح؟

57
00:07:49,510 --> 00:07:50,510
!(ڤيڤي)

58
00:07:50,590 --> 00:07:59,680
.لا، كنت أظنُّهنَّ الأجمل إلى أن جئت إلى لندن فاستدركت خطئي وغيَّرت رأيي حينئذٍ

59
00:08:00,930 --> 00:08:02,640
.(أمير (حكيم

60
00:08:02,940 --> 00:08:06,650
.أجد كلَّ النِّساء الإنجليزيَّات فاتنات جمال لا يقاوم

61
00:08:06,980 --> 00:08:09,400
ما السَّبب يا أمير (حكيم)؟

62
00:08:09,530 --> 00:08:10,280
ماذا؟

63
00:08:10,530 --> 00:08:14,910
.إنَّه لشرفٌ لي، لكنِّي في علاقةٍ فعليَّة حاليًّا

64
00:08:15,280 --> 00:08:17,120
.يا لخيبة الأمل

65
00:08:17,450 --> 00:08:20,250
!تظفر أختي بكلِّ انتباهٍ

66
00:08:22,790 --> 00:08:23,670
.(ويل)

67
00:08:23,750 --> 00:08:24,580
نعم؟

68
00:08:24,670 --> 00:08:26,540
أين تقع الهند؟

69
00:08:26,630 --> 00:08:27,750
أين؟

70
00:08:29,380 --> 00:08:30,710
.دعني ألقي نظرة

71
00:08:30,960 --> 00:08:32,420
.بالمناسبة يا أخي

72
00:08:32,840 --> 00:08:36,050
.كنت ترسل الكثير من الرسائل مؤخَّرًا

73
00:08:36,300 --> 00:08:38,010
رسائل؟ لمَن؟

74
00:08:38,100 --> 00:08:40,640
!(أليس الأمر واضحًا؟ لـ(إليانور

75
00:08:40,850 --> 00:08:42,140
إليانور)؟)

76
00:08:43,600 --> 00:08:45,560
.ما هي إلاَّ مجرَّد رسائل للعمل

77
00:08:47,020 --> 00:08:49,610
إن لم تكن لـ(إليانور)، فمن تكون إذن؟

78
00:08:49,730 --> 00:08:52,320
.كما أسلفت، إنَّها من أجل العمل

79
00:08:52,990 --> 00:08:54,030
.(إيما)

80
00:09:00,120 --> 00:09:01,540
.(حكيم)

81
00:09:01,620 --> 00:09:02,750
إيما)؟)

82
00:09:03,040 --> 00:09:05,000
من تكون هي؟ أيُّ نوع من الفتيات هي؟

83
00:09:05,710 --> 00:09:07,210
...أيُّ نوع من الفتيات

84
00:09:07,750 --> 00:09:10,250
جاوبني، هل قابلتُها قبلاً؟

85
00:09:10,340 --> 00:09:11,340
.لا

86
00:09:11,420 --> 00:09:13,970
هل هي دوقة أم كونتيسة؟

87
00:09:14,050 --> 00:09:17,800
.إنَّها ابنة البارونيت حسب معرفتي بك

88
00:09:17,930 --> 00:09:19,260
.أنت مخطئ

89
00:09:21,680 --> 00:09:22,890
.إنَّها خادمة

90
00:09:24,680 --> 00:09:26,020
خادمة؟

91
00:09:30,690 --> 00:09:32,030
...خادمة

92
00:09:32,650 --> 00:09:35,490
.حسنٌ، صحيح أنَّها تعمل كخادمة حاليًّا

93
00:09:35,570 --> 00:09:36,860
!أنت تكذب

94
00:09:36,950 --> 00:09:38,200
ولمَ عساي أكذب بهذا الشَّأن؟

95
00:09:38,280 --> 00:09:39,410
أأنت جادٌّ؟

96
00:09:39,740 --> 00:09:40,910
.أنا جادٌّ

97
00:09:41,120 --> 00:09:42,540
ما الَّذي تفكِّر به؟

98
00:09:42,620 --> 00:09:48,420
.غير معقول! ما دار بخلدي بتاتًا أنَّك تتمتَّع بشخصيَّة لاعقلانيَّة

99
00:09:48,540 --> 00:09:51,090
.أنا ضدَّها كلِّيًّا

100
00:09:51,170 --> 00:09:54,590
.لقد أضحيتَ امرءًا فجًّا، فحتَّى الفطيم سيفطن للأمر

101
00:09:54,760 --> 00:09:56,760
!كفى كلاكما

102
00:09:57,880 --> 00:09:59,300
.كفاكما شجارًا

103
00:10:00,350 --> 00:10:01,640
...في أيِّ مكانٍ

104
00:10:03,810 --> 00:10:05,890
.الحبُّ يمكن أن يوجد في أيِّ مكانٍ

105
00:10:05,980 --> 00:10:08,350
!هذا ليس بيت القصيد

106
00:10:08,350 --> 00:10:10,900
.تتصرَّف دائمًا بما يهواه قلبك بدل عقلك

107
00:10:10,900 --> 00:10:12,690
.ولا تستوعب الوضع استيعابًا مطلقًا

108
00:10:12,820 --> 00:10:15,360
!لا يحقُّ لك أن تخاطبني بهذا الأسلوب

109
00:10:16,030 --> 00:10:19,740
ألم تفكِّر في سمعة عائلتنا؟

110
00:10:19,820 --> 00:10:22,030
!(لا تتدخَّلي في الموضوع يا (ڤيڤي

111
00:10:22,160 --> 00:10:24,080
.في جعبتي الكثير لأبوح به له

112
00:10:29,460 --> 00:10:32,290
!أخي! لم ننتهِ من الحديث بعد

113
00:10:33,920 --> 00:10:36,210
.سنستأنف بعدما أستشير والدي

114
00:10:36,710 --> 00:10:39,630
أستخبر أبي بالأمر حقًّا؟

115
00:10:49,230 --> 00:10:51,560
.كلاَّ، قطعًا لا

116
00:10:51,650 --> 00:10:55,690
.زكنتُ أن يكون ردُّك على هذا النَّحو، ولكنِّي سأخبرك بالأمر عمومًا

117
00:10:56,150 --> 00:10:57,360
.لا

118
00:10:58,360 --> 00:11:00,820
.إنَّها ليست كباقي الخادمات

119
00:11:01,030 --> 00:11:03,450
.شخصيَّتها ليست لبَّ المشكلة

120
00:11:03,530 --> 00:11:04,450
.حسنٌ إذن

121
00:11:04,620 --> 00:11:08,370
.لدى البعلة العديد من الواجبات الهامَّة

122
00:11:08,370 --> 00:11:11,920
.يتعيَّن عليها تنظيم مآدب عشاء وحفلات الرَّقص وحفلات الشَّاي

123
00:11:12,040 --> 00:11:15,090
.وعليها أن تكون محاورة ماهرة، وأن تُظهر الأخلاق الحسنة

124
00:11:15,170 --> 00:11:19,170
.يجب أن تكون مثقَّفة ومتحدِّثة باللُّكنة البريطانيَّة بطلاقةٍ

125
00:11:19,380 --> 00:11:21,840
هل يمكن لخادمة أن تنجز كلَّ هذه المهامِّ؟

126
00:11:22,300 --> 00:11:29,140
.لقد رويت لي الأمر ذات مرَّة يا والدي
.فالرَّجل النَّبيل تحدَّر من أسرةٍ نبيلة ولم يولد

127
00:11:29,230 --> 00:11:33,100
.يمكن للحصان أن يغدو بطلاً بحكم طبيعته ونتيجة تدريباته

128
00:11:33,100 --> 00:11:37,610
.بيد أنَّ الهرَّ يستحيل عليه الغدوُّ حصانًا، إذ توجد بعض الأمور يتعذَّر تغييرها

129
00:11:37,610 --> 00:11:43,950
.إن أصررت على الخوض في هذا الأمر، فعندئذٍ ستجرِّد نفسك من طبقتك

130
00:11:44,660 --> 00:11:53,120
.فأنت مسؤول عن شقيقيك وشقيقتيك و(ستيفنز) وأكثر من مائة خادمٍ

131
00:11:53,460 --> 00:11:58,800
.كما يوجد التَّاريخ الَّذي صنعوه أسلافنا من إنجازات

132
00:11:59,010 --> 00:12:02,680
ألم تضع هذه الأمور في حسبانك؟

133
00:12:04,470 --> 00:12:09,640
أمتهيِّئ تمام التَّهيُّؤ للتَّنصُّل من مسؤوليَّاتك لتلبية رغباتك الخاصَّة؟

134
00:12:10,060 --> 00:12:12,640
وهل هذا نوع الرَّجل الَّذي أنت عليه؟

135
00:12:15,100 --> 00:12:19,230
.لا تخال ولو لوهلةٍ أنَّه بوسعك تطعيم القَصَب على شجرة الدَّردار

136
00:12:19,230 --> 00:12:23,000
.إذ ينمو شجر الدَّردار على التِّلال، وأمَّا القصب فهو نبات يجاور المياه

137
00:12:23,000 --> 00:12:24,700
.فهذا هو النِّظام الطَّبيعيُّ للحياة

138
00:12:24,700 --> 00:12:28,790
!ينبغي عدم الخلط بين الحرِّيَّة والإخلال بالنِّظام، فإيَّاك ونسيان هذا الأمر

139
00:12:41,550 --> 00:12:44,880
.لعلَّ حالك يتحسَّن بعدما أفركك بفوطة مبلَّلة

140
00:12:53,690 --> 00:12:58,270
.خلتني قد استعدت عافيتي، ولكن يبدو أنَّ التَّقدير خانني

141
00:12:58,980 --> 00:13:01,610
.لقد عُدل عكَّازك

142
00:13:07,870 --> 00:13:09,700
.تبدين مكروبة

143
00:13:10,030 --> 00:13:14,080
.بدا وجهك طافحًا بالغبطة قبل فترة ليست بطويلة

144
00:13:14,620 --> 00:13:18,880
.يمرُّ معظم الشَّباب في حياتهم بكثير من التَّقلُّبات

145
00:13:19,670 --> 00:13:24,670
.ترك لي السَّيِّد (جونز) رسالة مفادها أنَّه سيشافه والده

146
00:13:26,430 --> 00:13:27,640
.فهمت

147
00:13:28,680 --> 00:13:31,850
.يزعم أنَّه سيقنع والده بالأمر

148
00:13:32,720 --> 00:13:36,310
.ولكنِّي أعلم يقينًا بأنَّ هذا الأمر متعذِّر الحدوث

149
00:13:37,730 --> 00:13:40,860
،كلَّما تمعَّنت في الأمر بصورةٍ أكثر واقعيَّة

150
00:13:41,610 --> 00:13:47,860
.استنبطت أنَّ الفجوة بين طبقتينا لهي مفرطة الاتِّساع

151
00:13:54,330 --> 00:13:57,250
.اطمئنِّي، ستغدين على ما يرام

152
00:14:18,190 --> 00:14:19,730
...(السَّيِّد (ويليام

153
00:14:19,810 --> 00:14:21,610
ما خطبه يا تُرى؟

154
00:15:13,740 --> 00:15:15,830
أحقًّا ستهجعين هنا؟

155
00:15:15,910 --> 00:15:19,580
.أجل، أتلذَّذ بالرَّاحة في هذا المكان

156
00:15:20,370 --> 00:15:21,710
.سأطفئ الضَّوء

157
00:15:32,430 --> 00:15:35,050
.بلغتُ من الكبر عتيًّا فعلاً

158
00:15:38,980 --> 00:15:40,730
.أهذي مع نفسي وحسب

159
00:15:44,360 --> 00:15:47,320
.طابت ليلتك يا سيِّدتي

160
00:15:48,570 --> 00:15:50,610
.(طابت ليلتك يا (إيما

161
00:16:31,940 --> 00:16:34,490
هل فقدت شهيَّتك للأكل؟

162
00:16:34,910 --> 00:16:36,270
.ليس تمامًا

163
00:16:36,820 --> 00:16:42,580
.حريٌّ بك تناول القليل ممَّا تشتهينه، ولا تتخطِّي وجبات الطَّعام

164
00:16:46,670 --> 00:16:48,670
كيف حال سيِّدتي؟

165
00:16:48,750 --> 00:16:51,960
.طيِّب، ليس بيدنا حيلة حيال عمرها

166
00:16:51,960 --> 00:16:53,760
.أرجو أن تعتني بها

167
00:16:53,840 --> 00:16:55,510
.شكرًا لك

168
00:17:02,180 --> 00:17:03,810
.أنا آسفة

169
00:17:03,890 --> 00:17:05,100
.لا مشكلة

170
00:17:05,810 --> 00:17:08,310
ماذا عن تناول بعض الفواكه؟

171
00:17:08,440 --> 00:17:11,150
.ما عندي شهيَّة للأكل

172
00:17:11,400 --> 00:17:12,860
هل (آل) موجودٌ هنا؟

173
00:17:12,940 --> 00:17:13,950
.نعم

174
00:17:14,110 --> 00:17:16,610
هلاَّ أخبرته أن يأتي لرؤيتي؟

175
00:17:17,320 --> 00:17:24,580
.يزورنا يوميًّا بيد أنَّه لم يكلِّف نفسه عناء صعود السَّلالم لرؤيتي

176
00:17:25,670 --> 00:17:27,040
.سمعًا يا سيِّدتي

177
00:17:28,670 --> 00:17:32,380
.أستميحك عذرًا، ترغبين سيِّدتي بإجراء محادثة معك

178
00:17:35,090 --> 00:17:36,130
سيِّد (آل)؟

179
00:17:36,220 --> 00:17:37,130
ماذا؟

180
00:17:37,220 --> 00:17:38,720
أمِن خطب ما؟

181
00:17:38,800 --> 00:17:43,390
.لا، كنت أفكِّر في زراعة بعض الورود ليس إلاَّ

182
00:17:43,470 --> 00:17:44,640
ورود؟

183
00:17:44,770 --> 00:17:49,610
.أجل، بمقدوري طلب الشُّجيرات من صديقي

184
00:17:49,900 --> 00:17:52,480
.فهو يدين لي بعدِّة جمائل

185
00:17:58,700 --> 00:18:01,740
.ذلك... سيكون أمرًا رائعًا

186
00:18:02,740 --> 00:18:07,420
.بوسعنا احتساء الشَّاي في وقت العصر ريثما تتفتَّح الأزهار

187
00:18:09,750 --> 00:18:12,340
عمَّ أردت محادثتي؟

188
00:18:13,300 --> 00:18:15,550
.ألتمس منك إسداء معروفٍ لي

189
00:18:15,920 --> 00:18:21,640
.لست مستوثقًا من أنِّي أكون يد العون لك، ولكن كلِّي آذانٌ مصغية

190
00:18:22,510 --> 00:18:24,520
.(الأمر بخصوص (إيما

191
00:18:42,780 --> 00:18:47,330
.لا مجال للنَّبيل والخادمة بأن يعيشا بسعادةٍ سويًّا

192
00:18:47,790 --> 00:18:50,710
.ما كان عليك جعلها تتعشَّم بأملٍ زائف

193
00:18:51,290 --> 00:18:55,050
.أجل، بدأت الأمور تتعقَّد على هذا النَّحو

194
00:18:56,130 --> 00:18:59,680
.ولكنَّ (إيما) هائمة في حبِّه

195
00:19:00,510 --> 00:19:02,180
...إيما) خاصَّتنا)

196
00:19:04,010 --> 00:19:08,890
.ما انتابها هذا الشُّعور قبلاً، ولعلَّها لن تشعر به مجدَّدًا حير الدَّهر

197
00:19:10,560 --> 00:19:15,780
.أتعاطف مع السَّيِّد (جونز)، ولكنِّي أرغب بمساعدتهما بتغيُّر حياتهما

198
00:19:15,940 --> 00:19:18,030
فما عساي فاعلة؟

199
00:19:18,490 --> 00:19:19,860
.اعتنِ بها

200
00:19:22,530 --> 00:19:25,120
.اعتنِ بـ(إيما) من أجلي

201
00:19:45,760 --> 00:19:49,100
.أُصلحت ساعة الجيب، لذا أُمرت بتوصيلها إلى هنا

202
00:19:49,680 --> 00:19:51,270
.شكرًا لك

203
00:19:53,650 --> 00:19:55,610
أهذه السَّاعة الصَّحيحة؟

204
00:19:58,940 --> 00:20:00,820
.بالفعل كذلك

205
00:20:01,280 --> 00:20:02,410
!طاب يومك

206
00:20:12,870 --> 00:20:14,380
!سأستدعي الطَّبيب

207
00:20:14,460 --> 00:20:15,290
ماذا؟

208
00:20:23,840 --> 00:20:24,840
...سيِّدتي

209
00:20:49,080 --> 00:20:50,410
سيِّدتي؟

210
00:21:03,590 --> 00:21:05,050
...سيِّدتي

211
00:21:05,970 --> 00:21:08,430
.لقد أُصلحت ساعة جيبك

212
00:21:46,260 --> 00:21:47,800
!سيِّدتي

213
00:24:06,070 --> 00:24:09,440
:في الحلقة القادمة
[ وحدة ]