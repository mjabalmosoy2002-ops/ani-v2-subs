18
00:00:56,700 --> 00:00:57,860
.أجل

19
00:00:57,860 --> 00:01:00,330
.المادّة الإلزاميّة المُتبقّية هي الغوص العميق

20
00:01:01,080 --> 00:01:04,880
حالما تنتهين من الغوص العميق،
.كلُّ ما سيتبقّى لكِ هو مادّة اختياريّة واحدة

21
00:01:05,820 --> 00:01:07,100
مادّة واحدة مُتبقّية؟

22
00:01:07,100 --> 00:01:08,840
!لقد اجتهدتِ يا تيكو

23
00:01:09,490 --> 00:01:10,380
.أجل

24
00:01:11,280 --> 00:01:13,840
.حينها ستنالين أخيرًا رُخصتكِ المُتقدّمة

25
00:01:14,550 --> 00:01:19,170
.فكِّري جيدًا حول المادّة الاختياريّة الأخيرة الَّتي تُريدينها

26
00:01:20,820 --> 00:01:22,640
.لم يتبقَّ سِوى شيءٌ واحد

27
00:01:23,770 --> 00:01:25,930
،بينما أتقدّمُ خطوةً خطوة

28
00:01:25,930 --> 00:01:29,310
.أقترب شيئًا فشيئًا إلى نهاية شيءٍ ما

29
00:01:30,850 --> 00:01:34,370
،أنا سعيدة، ولكن حزينة بعض الشيء

30
00:01:34,930 --> 00:01:37,240
.أُكرّرُ هذا بينما أتقدّم إلى الأمام

31
00:01:38,630 --> 00:01:40,070
.لا أملك خيارًا إلَّا هذا

32
00:01:40,680 --> 00:01:41,970
.الغوص العميق

33
00:01:42,640 --> 00:01:46,670
.ستصير عمليّات عقلكِ أبطأ بسبب ضغط الماء المُرتفع

34
00:01:48,920 --> 00:01:51,340
،سيزداد استهلاككِ للهواء بشدّة

35
00:01:51,340 --> 00:01:54,900
،وحينما تغطسين إلى حدّ الأربعين متر
.لن تصمُدي لمدّة 10 دقائق

36
00:01:54,900 --> 00:01:56,250
.إنَّه عالمٌ قاسٍ

37
00:02:00,600 --> 00:02:05,560
عُمق

38
00:02:18,020 --> 00:02:21,240
.يا إلهي، إنَّها تُبدي ملامح السعادة على وجهِها

39
00:02:21,530 --> 00:02:23,620
لقد توصّلتِ إلى هدفكِ

40
00:02:22,170 --> 00:02:26,240
قبل مدَّةٍ قصيرة، كانت بيكاري
،تسحبها على الدوام

41
00:02:27,330 --> 00:02:31,320
ولكنَّ مؤخرًا، تحاول تيكو
.التقدّم للأمام بإرادتها

42
00:02:35,070 --> 00:02:36,940
.لقد نمت حقًّا

43
00:02:50,070 --> 00:02:51,390
!أوه

44
00:02:51,830 --> 00:02:53,020
!إنَّها سمكة الشمس

45
00:02:57,740 --> 00:02:59,200
خُذيها

46
00:02:59,980 --> 00:03:03,070
ألا بأس حقًّا في استعارتي للكاميرا؟

47
00:03:30,680 --> 00:03:32,140
ما هذا السمك؟

48
00:03:32,480 --> 00:03:33,670
!إنَّه ظريف

49
00:03:35,150 --> 00:03:38,990
،قِصّة يومٍ ما
غد لا يزال مجهولاً

50
00:03:42,070 --> 00:03:43,600
.بوركت جهودكِ يا تيكو

51
00:03:43,600 --> 00:03:45,390
!شكرًا جزيلاً لكِ

52
00:03:45,390 --> 00:03:47,880
.لقد قدَّم لنا البحر خِدمةً كبيرة اليوم

53
00:03:47,880 --> 00:03:49,100
!سمكة الشمس

54
00:03:49,100 --> 00:03:52,220
.هذا صحيح، لا يتسنّى لكِ رؤيتها إلَّا نادِرًا

55
00:03:52,220 --> 00:03:54,040
.كان هناكَ الكثير من الحبار بيضويّ الشكل أيضًا

56
00:03:54,380 --> 00:03:56,690
!وأيضًا تِلكَ الأسماك الصغيرة الظريفة

57
00:03:56,690 --> 00:03:58,640
أطفال سمك الدانجوو؟

58
00:03:58,640 --> 00:04:02,990
.يُسمّون النقش على رأسها بحلقة الملائكة

59
00:04:02,990 --> 00:04:05,010
.أوه، فعلاً

60
00:04:05,340 --> 00:04:06,640
هل التقطتِ صُور؟

61
00:04:07,020 --> 00:04:08,860
.آه، هذا صحيح

62
00:04:09,730 --> 00:04:11,820
.آمل أنَّني صوّرتُها بشكلٍ جيّد

63
00:04:18,380 --> 00:04:20,720
...أجل، حسنٌ

64
00:04:20,720 --> 00:04:23,910
.إنَّ التصوير تحت الماء صعبٌ للغاية

65
00:04:25,990 --> 00:04:29,700
...حسبتُ أنَّني التقطتُها ببراعةٍ أكثر قليلاً

66
00:04:32,790 --> 00:04:37,170
في تِلك الحالة، هل تريدين أخذ
التصوير تحت الماء للمادّة الاختياريّة الأخيرة؟

67
00:04:39,900 --> 00:04:42,670
...المعذرة، أنا

68
00:04:44,600 --> 00:04:46,090
!أريد القيام بالغطس الليليّ

69
00:04:47,560 --> 00:04:48,430
تيكو؟

70
00:04:48,670 --> 00:04:50,080
أمتأكّدةٌ من مقدرتكِ على ذلك؟

71
00:04:50,080 --> 00:04:52,060
!أجل! سأكون على ما يرام

72
00:05:00,650 --> 00:05:03,750
.لم أتوقّع بأنَّكِ ستختارين الغطس الليليّ

73
00:05:03,750 --> 00:05:06,200
إيه؟ كما ظننت هل كان تهوّرًا؟

74
00:05:06,810 --> 00:05:08,020
.هذا غير صحيح

75
00:05:08,020 --> 00:05:09,700
.لقد كان أمرًا مُفاجئًا بعض الشيء فقط

76
00:05:10,890 --> 00:05:14,250
.يسرُّني أنَّكِ تشعرين بأنَّه أمرٌ مُفاجئ

77
00:05:14,250 --> 00:05:16,220
هاه؟ حقًّا؟

78
00:05:17,690 --> 00:05:19,710
.أنتِ من أخبرني يا سينسي

79
00:05:20,720 --> 00:05:22,590
،لا يمكنكِ تغيير الآخرين أو الماضي"

80
00:05:23,060 --> 00:05:25,630
".لكن يمكنكِ تغيير نفسكِ والمستقبل

81
00:05:27,240 --> 00:05:31,140
يا للهول! قد تكون هذه
!أسعد لحظاتي كمُعلّمة

82
00:05:31,560 --> 00:05:36,410
،كلماتكِ آنذاك يا كاتوري-سينسي... شجَّعتني

83
00:05:36,890 --> 00:05:39,440
.لقد قرّرتُ أن أتغيّر

84
00:05:40,160 --> 00:05:44,430
.سينسي... لقد قُلتِ شيئًا عظيمًا بحقّ

85
00:05:49,070 --> 00:05:51,760
!نادي غطس ثانويّة يوميجاوكا، انتباه

86
00:05:51,760 --> 00:05:52,710
ماذا؟ ماذا؟

87
00:05:52,710 --> 00:05:53,740
أوبيو؟

88
00:05:53,740 --> 00:05:57,190
!سيحضر الجميع دورة تيكو الأخيرة في الغطس

89
00:05:58,570 --> 00:05:59,950
!ماذا! هذا يبدو مُمتعًا

90
00:05:59,950 --> 00:06:00,710
صحيح؟

91
00:06:00,710 --> 00:06:02,440
!سأحضر سأحضر! لنذهب

92
00:06:02,440 --> 00:06:03,970
.شكرًا لكِ يا تيكو-تشان

93
00:06:03,970 --> 00:06:07,350
!أنا آسفة نوعًا ما

94
00:06:10,440 --> 00:06:11,470
...إيه

95
00:06:12,220 --> 00:06:15,980
إذًا لهذا حصلتُ على دعوةٍ أيضًا؟

96
00:06:15,980 --> 00:06:16,980
.أجل

97
00:06:16,980 --> 00:06:21,980
،فبعد كلِّ شيء، ستخطو تيكو خطوةً ضخمة
!إنَّها لحظةٌ تدعو للاحتفال

98
00:06:22,330 --> 00:06:25,530
.جدّتي، سآخذ الغسيل للمنزل

99
00:06:25,530 --> 00:06:27,440
.حسنًا، شكرًا لكِ يا كوداما

100
00:06:28,180 --> 00:06:31,280
ستُرافقنا كوداما-تشان كذلك
!لا يسعني الانتظار أكثر

101
00:06:31,280 --> 00:06:34,020
.هاه؟ ولكنَّني لم أقُل بأنَّني ذاهبة

102
00:06:34,020 --> 00:06:34,660
!أوبيو؟

103
00:06:35,020 --> 00:06:36,160
...لكن، لكن، لكن

104
00:06:36,160 --> 00:06:40,640
،لقد نجحتِ في امتحان قبول ثانويّة يوميجاوكا
وستنضمين إلى نادي الغطس، صحيح؟

105
00:06:40,640 --> 00:06:42,070
.إنَّني بصدد التفكير بالأمر

106
00:06:42,070 --> 00:06:42,880
!أوبيو

107
00:06:43,340 --> 00:06:45,840
.سأفعل أكثر شيءٍ أرغب بفعله

108
00:06:46,740 --> 00:06:49,050
.ولكن من المُحتمل أن ترغب كوتوري برؤية تيكو-سان

109
00:06:49,050 --> 00:06:50,290
!صحيح؟

110
00:06:50,290 --> 00:06:53,710
مِمّا يعني بأنَّكِ ستذهبين أيضًا لتشجيع تيكو، صحيح؟

111
00:06:53,710 --> 00:06:56,470
.لا أُمانع ما دامتُ مع كوتوري

112
00:06:56,940 --> 00:07:00,680
!سأعتبرها موافقة
!سأدعو كوكورو-تشان أيضًا

113
00:07:00,680 --> 00:07:03,080
.سيكون ذلك حشدًا هائل

114
00:07:03,080 --> 00:07:04,560
...وعليه يا جدّتي

115
00:07:05,610 --> 00:07:08,190
.أريد أن أطلب منكِ معروفًا بسيطًا

116
00:07:08,190 --> 00:07:08,900
ما هو؟

117
00:07:12,090 --> 00:07:13,120
!سهلٌ جدًّا

118
00:07:13,480 --> 00:07:17,220
!مرحى! ستُصبح الأمور مُمتعة

119
00:07:23,440 --> 00:07:27,170
.احرصي على ألَّا تتضرّر صحّتكِ قبل الغطس الليليّ

120
00:07:27,170 --> 00:07:28,220
.حسنًا

121
00:07:29,620 --> 00:07:33,640
بمجرّد أن أنتهي من ذلك، سأحصل
على رُخصتي المُتقدّمة، صحيح؟

122
00:07:33,890 --> 00:07:35,730
.أجل، هذا صحيح

123
00:07:35,730 --> 00:07:38,190
ما الخطب؟ أأنتِ قلِقة؟

124
00:07:38,190 --> 00:07:40,600
.آه كلّا، الأمر ليس هكذا

125
00:07:41,450 --> 00:07:43,610
ماذا؟ هل أنتِ حزينة؟

126
00:07:44,690 --> 00:07:50,570
،كيف أقولها... أنا حزينة
.ولكن لستُ حزينة، ولكنَّني أشعر بالوحدة نوعًا ما

127
00:07:50,990 --> 00:07:57,330
أريد الحصول على الرُخصة المُتقدّمة بسرعة
.لكي أتمكن من الغطس في البحر أكثر مع بيكاري والجميع

128
00:07:57,580 --> 00:07:59,910
.أريد القيام بالكثير من الأمور المُمتعة

129
00:08:00,440 --> 00:08:02,190
.إنَّني مُتشوّقة للغاية

130
00:08:02,190 --> 00:08:03,040
...ولكن

131
00:08:03,290 --> 00:08:06,360
.الأوقات المُمتعة تمضي بشكلٍ مُتسارعٍ جدًّا

132
00:08:07,140 --> 00:08:12,340
لِذلك ظننتُ أنَّ عليّ مواصلة إيجاد أمورٍ مُمتعة للقيام بها

133
00:08:13,360 --> 00:08:14,300
...لكن

134
00:08:14,520 --> 00:08:17,800
مع ذلك، ستصل يومًا ما إلى مُنتهاها، صحيح؟

135
00:08:18,620 --> 00:08:21,460
،كُنتُ أحاول عدم التفكير بالأمر

136
00:08:22,020 --> 00:08:25,020
،ولكن في كلِّ مرّةٍ تبلغُ فيها الأمور المُمتعة مُنتهاها بهذه الطريقة

137
00:08:25,460 --> 00:08:27,980
.لا يسعني سِوى التفكير بها

138
00:08:30,480 --> 00:08:33,450
!لا أعرف ما الّذي عليّ فعله

139
00:08:35,820 --> 00:08:37,740
ما الّذي عليّ فعله يا تُرى؟

140
00:08:38,460 --> 00:08:39,650
...بشأن هذا

141
00:08:40,500 --> 00:08:41,080
.لا أدري

142
00:08:42,960 --> 00:08:45,690
.ولكن هذا ما تعنيه المُراهقة

143
00:08:47,880 --> 00:08:49,670
.لا بأس بذلك

144
00:08:51,050 --> 00:08:53,990
.لا بأس إذا كُنتِ لا تعرفين الآن

145
00:08:53,990 --> 00:08:54,970
...لكن

146
00:08:55,310 --> 00:08:57,430
.يجب ألَّا تتوقّفي عن التحرّك أبدًا

147
00:08:57,430 --> 00:09:01,180
.إذا توقّفتِ، فلن تعرفي أبدًا

148
00:09:04,880 --> 00:09:06,800
!المُراهقة هي الأفضل

149
00:09:06,800 --> 00:09:09,820
!شـ-شـكرًا جزيلاً لكِ

150
00:09:16,080 --> 00:09:19,830
.سيحين الوقت لا محالة عندما ترغبين حقًّا بالذهاب للغطس الليليّ

151
00:09:20,410 --> 00:09:23,580
.آمل أن نستطيع الذهاب للغطس الليليّ يومًا ما

152
00:09:29,500 --> 00:09:39,350
بيكاري

153
00:09:29,500 --> 00:09:39,350
بلا موضوع

154
00:09:29,500 --> 00:09:39,350
،يا خبيرة "المُتعة" العزيزة

155
00:09:29,500 --> 00:09:39,350
هل تعتقدين أن بوسعكِ العثور على الأمور المُمتعة

156
00:09:29,500 --> 00:09:39,350
ما وراء الغطس الليليّ؟

157
00:09:29,500 --> 00:09:39,350
!بالنسبةِ لي.... أوبيو بيو بيو بيو بيو

158
00:09:29,500 --> 00:09:39,350
!إنَّه سِرّ

159
00:09:29,500 --> 00:09:39,350
!آه، أتطلّع بشوقٍ لذلك

160
00:09:29,680 --> 00:09:31,620
.يا خبيرة "المُتعة" العزيزة

161
00:09:31,620 --> 00:09:35,820
هل تعتقدين أنَّ بوسعكِ
العثور على الأمور المُمتعة ما وراء الغطس الليليّ؟

162
00:09:35,820 --> 00:09:37,430
...بالنسبةِ لي

163
00:09:37,430 --> 00:09:39,340
!أوبيو-أوبيو-بيو-بيو--بيو! إنَّه سِرّ

164
00:09:39,900 --> 00:09:42,130
!آه، أتطلّع شوقًا لذلك

165
00:09:44,190 --> 00:09:47,550
.ثمَّة مرحٌ مُخبأ في أسرار بيكاري دائمًا

166
00:09:48,080 --> 00:09:51,320
!أجل، يجب أن أستمتع إلى أقصى حدٍّ أولاً

167
00:09:52,230 --> 00:09:55,650
،أنا بصراحة خائفة قليلاً من الغطس الليليّ

168
00:09:56,750 --> 00:09:59,700
.ولكنَّني أنوي الاستمتاع بالكامل

169
00:09:59,700 --> 00:10:01,600
!أرجو منكم تشجيعي

170
00:10:09,350 --> 00:10:11,040
آيتو... ما هذا؟

171
00:10:11,270 --> 00:10:16,070
!ضُيوف المُفاجأة
!فِرقة تشجيع تيكو

172
00:10:16,070 --> 00:10:18,800
!طلبتُ من جدّتي أن توصلهم خِفيةً بواسطة سيّارتها

173
00:10:20,340 --> 00:10:22,640
.هذا هو سِرّكِ يا بيكاري

174
00:10:23,870 --> 00:10:27,240
.الجدّة، كوداما-تشان وكوتوري-تشان

175
00:10:27,240 --> 00:10:29,480
.جاء كوكورو-تشان أيضًا

176
00:10:29,480 --> 00:10:30,900
.أ-أجل

177
00:10:31,450 --> 00:10:34,360
.إنَّهم أشبه بفرقة تشجيعٍ ومُراقبة

178
00:10:36,080 --> 00:10:37,400
.شكرًا جزيلاً لكم

179
00:10:37,780 --> 00:10:40,780
.تيكو-تشان، واصلي التقدّم إلى الأمام

180
00:10:41,320 --> 00:10:45,040
!أمانتشو

181
00:10:41,320 --> 00:10:45,040
~التقدّم~

182
00:10:42,390 --> 00:10:43,300
!حسنًا

183
00:10:46,540 --> 00:10:47,920
...لا أُصدّق

184
00:10:47,920 --> 00:10:49,550
.أجل، فعلاً

185
00:10:49,550 --> 00:10:50,460
ما هو؟

186
00:10:51,000 --> 00:10:55,520
يبدو أنَّهما لا تُصدّقان
.بأنَّهم سيغطسون في الليل بهذا البحر قاتم السواد

187
00:10:56,420 --> 00:10:57,170
حقًّا؟

188
00:11:03,960 --> 00:11:06,490
المعذرة... هل ستكونين على ما يرام؟

189
00:11:06,490 --> 00:11:07,120
هاه؟

190
00:11:07,120 --> 00:11:09,350
...أعني، البحر قاتم السواد

191
00:11:09,840 --> 00:11:11,270
هل تسألين إذا ما كُنتُ خائفة؟

192
00:11:11,270 --> 00:11:12,060
.أجل

193
00:11:12,480 --> 00:11:13,610
!أنا خائفة

194
00:11:14,340 --> 00:11:17,720
لقد كُنتُ خائفةً جدًّا في المرّة السابقة
.لدرجة أنَّني راقبتُ من الأعلى

195
00:11:17,720 --> 00:11:18,940
!علِمتُ هذا

196
00:11:19,280 --> 00:11:25,320
ولكن أصبحت مشاعر الرغبة في المحاولة
.أقوى شيئًا فشيئًا من الخوف

197
00:11:26,860 --> 00:11:33,330
،حتَّى لو شعرتِ بالخوف وأنَّه حتمًا مُستحيل
.فسيحلُّ يومٌ حينما لا تكون عندكِ مشكلة بالتعامل معه

198
00:11:35,280 --> 00:11:38,040
!إ-إنَّكِ رائعة جدًّا يا تيكو-سان

199
00:11:38,040 --> 00:11:39,410
.شكرًا لكِ

200
00:11:39,960 --> 00:11:42,610
.تيكو، لنقم بفحص الشريك

201
00:11:42,610 --> 00:11:43,640
!حسنًا

202
00:11:47,380 --> 00:11:49,310
.سأبدأ أولاً إذًا

203
00:11:49,310 --> 00:11:50,590
.من فضلكِ

204
00:11:51,080 --> 00:11:54,250
.جهاز التحكم بالطفو... جيّد

205
00:11:52,760 --> 00:11:56,020
.ولكن الفضل في تمكني من التعامل مع هذا يعود إلى بيكاري

206
00:11:54,800 --> 00:11:56,020
...فحص الوزن

207
00:11:58,240 --> 00:12:01,040
.حسنًا، حان دوركِ تاليًّا يا تيكو

208
00:12:01,040 --> 00:12:01,790
!حسنًا

209
00:12:01,790 --> 00:12:04,370
.جهاز التحكم بالطفو... جيّد

210
00:12:04,760 --> 00:12:06,870
.فحص الوزن... جيّد

211
00:12:07,570 --> 00:12:10,680
،إنَّه أمرٌ رائعٌ جدًّا
.ويبدو مُمتعًا

212
00:12:11,080 --> 00:12:14,120
مع ذلك، أعتقد أنَّ الغطس
.في هذا البحر قاتم السواد سيكون مُخيفًا حتمًا

213
00:12:25,720 --> 00:12:27,840
.حسنًا، فلنذهب إذًا

214
00:12:27,840 --> 00:12:29,080
!حسنًا

215
00:12:30,180 --> 00:12:31,640
!رافقتكم السلامة

216
00:12:33,270 --> 00:12:34,390
!نحنُ ذاهبون

217
00:12:40,190 --> 00:12:41,780
.حظًّا موفقًا يا تيكو

218
00:12:43,160 --> 00:12:43,860
.شكرًا

219
00:12:43,860 --> 00:12:45,660
أ-أسمعتِ ذلك؟

220
00:12:52,900 --> 00:12:57,890
،تمنّينا الذهاب للغطس الليليّ يومًا ما
.وها قد تحقّقت الأُمنية بالفعل

221
00:12:57,890 --> 00:12:58,720
.أجل

222
00:12:59,930 --> 00:13:04,380
أنجزتُ اليوم هدفي
.في تحقيق هذه الأُمنية بلمح البصر

223
00:13:05,280 --> 00:13:09,350
خفقان قلبي وحُزني
.يمّتدّان وينحسران كالأمواج

224
00:13:10,570 --> 00:13:12,060
،واليوم

225
00:13:12,270 --> 00:13:14,060
.إنَّه إحساسٌ يبعث بالبهجة حقًا

226
00:13:20,260 --> 00:13:22,400
.حسنًا. لنذهب يا تيكو

227
00:13:22,400 --> 00:13:23,280
.حسنًا

228
00:13:30,380 --> 00:13:31,410
.جميل

229
00:13:31,710 --> 00:13:38,540
:ثمَّة مَثَلٌ يقول
".مشاهدة الغطس الليليّ يجعل المرء راغبًا بتجربتهِ بنفسه"

230
00:13:38,880 --> 00:13:40,950
.أعتقد أنَّ ذلك اتّضح لي

231
00:13:42,010 --> 00:13:44,510
خسارةٌ أن يعتريكِ الخوف، صحيح؟

232
00:13:46,470 --> 00:13:47,470
أحقًّا؟

233
00:13:56,800 --> 00:13:58,810
،كما قالت بيكاري تمامًا

234
00:13:58,810 --> 00:14:02,900
،البحر المُضيء بالمصابيح في الليل
.ليسَ بالعالم الأزرق المُعتاد

235
00:14:06,180 --> 00:14:08,270
!لا أبدو أنَّني في البحر

236
00:14:14,020 --> 00:14:14,790
أوبيو؟

237
00:14:15,220 --> 00:14:18,880
آيتو... الطيران؟

238
00:14:19,400 --> 00:14:20,970
.أوه، فهمت

239
00:14:20,970 --> 00:14:25,170
إنَّها تحاول القول
.بأنَّ أنيه-تشان-سينباي والبقيّة يبدون وكأنَّهم يطيرون في السّماء

240
00:14:25,840 --> 00:14:30,050
لقد بقيت ألوانهم على حالتها الدائمة
.لِذا يبدون وكأنَّهم يطيرون في السّماء

241
00:14:30,550 --> 00:14:33,450
!هذا ما ظننتُهُ أيضًا في أوّل مرّة لي

242
00:14:35,090 --> 00:14:37,330
،في أعماقها، هي فتاةٌ عاطفيّة

243
00:14:37,330 --> 00:14:40,670
.وطريقة تغيُّر التعابير دائريًّا على وجهِها هي أظرف سمات تيكو

244
00:14:41,900 --> 00:14:46,440
إنَّ مشاعر تيكو
.تنتقل إليّ عبر البحر

245
00:14:47,060 --> 00:14:48,300
".جميل"

246
00:14:48,300 --> 00:14:49,440
".مُمتع"

247
00:14:49,820 --> 00:14:50,850
".ساحِر"

248
00:14:51,610 --> 00:14:52,740
".لم أعد خائفة بعد الآن"

249
00:14:53,860 --> 00:14:55,660
".سأكون بخيرٍ الآن"

250
00:14:55,850 --> 00:14:57,060
!هذا ما تقوله

251
00:15:02,060 --> 00:15:03,880
.أجل، إنّه جميل

252
00:15:04,730 --> 00:15:11,340
،مُستنيرةً بالأضواء المُتلألئة
.ترقُصُ على مسرح البحر مثل أرواح الماء، الأوندينات

253
00:15:12,860 --> 00:15:14,140
...وكأنَّ هذا

254
00:15:15,460 --> 00:15:17,220
!عالمٌ خياليٌ آخر

255
00:15:19,930 --> 00:15:21,310
،قبل فترة قصيرة

256
00:15:21,770 --> 00:15:23,770
.بدت على حافّةِ البُكاء

257
00:15:25,830 --> 00:15:28,010
.كانت مرعوبة جدًّا

258
00:15:30,320 --> 00:15:36,110
.ولكنَّ شريكتي تسبحُ إلى الأمام بكلِّ قوّةٍ وجمال

259
00:15:43,040 --> 00:15:44,670
.الأضواء تختفي

260
00:15:44,670 --> 00:15:46,140
هل حدث شيءٌ ما؟

261
00:15:47,830 --> 00:15:51,740
.لقد حلَّت دورة الربيع أبكر من المُعتاد في هذا العام

262
00:15:51,740 --> 00:15:53,660
وماذا يعني إذا حلَّت أبكر؟

263
00:15:54,970 --> 00:15:57,990
يعني أنَّ تيكو-تشان
.ستحصل على هديّةٍ من البحر

264
00:16:04,400 --> 00:16:06,060
.ينبغي أن يكون كافيًا الآن

265
00:16:08,580 --> 00:16:10,000
.إنَّه شديد السواد

266
00:16:10,000 --> 00:16:11,740
.عالم ظلامٍ كُلّيّ

267
00:16:12,090 --> 00:16:13,490
.ولكن ستكونين على ما يرام

268
00:16:14,030 --> 00:16:16,370
.سنبدأ حالما تتأقلم أعيُننا مع الظلام

269
00:16:21,940 --> 00:16:28,420
تتفاعل أعدادٌ لا تُحصى من البلانكتون
.مع تحرُّكات أيدينا وأرجُلِنا، مُطلقةً ضوءًا خافتًا

270
00:16:30,440 --> 00:16:33,300
:هويّة هذه الأضواء الضئيلة الّتي تتوهّج كاليراعات هي

271
00:16:34,120 --> 00:16:35,300
الهوام البحرية المضيئة

272
00:16:34,120 --> 00:16:35,300
.بريق البحر

273
00:16:38,060 --> 00:16:39,260
.أفهم عليكِ، أفهم عليكِ

274
00:16:41,240 --> 00:16:46,680
بفضل تيكو، تذكّرتُ غالبًا كيف
.كانت الأحوال عندما بدأت بالغطس لأوّل مرّة

275
00:16:48,430 --> 00:16:54,400
وشعوري الغير واضح
.مُنِحَ لونًا وشكلاً

276
00:16:55,870 --> 00:17:01,240
تيكو هي المِفتاح الّذي
!فَتَحَ الباب المؤديّ إلى ذكرياتي ومشاعري

277
00:17:02,780 --> 00:17:05,910
.يومًا ما، أتمنّى أن أُعرب لها عن امتناني ببراعة

278
00:17:10,800 --> 00:17:12,770
.أوه، لقد عادوا

279
00:17:15,420 --> 00:17:16,680
هل هو حساء التونجيرو؟

280
00:17:16,680 --> 00:17:17,850
!مرحى

281
00:17:17,850 --> 00:17:21,510
،هديّة من الجدّة
!إنَّها رمز متجر أمانتشو

282
00:17:21,510 --> 00:17:22,960
!كما هو متوقّع من جدّتي

283
00:17:22,960 --> 00:17:24,480
!أنا في مُنتهى السعادة

284
00:17:24,480 --> 00:17:25,780
.يبدو لذيذًا جدًّا

285
00:17:25,780 --> 00:17:27,020
ما الخطب يا تيكو؟

286
00:17:27,020 --> 00:17:29,620
.حسنًا، اخلعوا هذه الخزّانات الثقيلة أولاً

287
00:17:28,620 --> 00:17:30,900
.آه كلّا، لا شيء

288
00:17:29,620 --> 00:17:30,900
!حاضر

289
00:17:32,650 --> 00:17:34,150
!إنَّه يُدفَّئ

290
00:17:34,530 --> 00:17:36,460
.كينو-سان، أنتِ ملاك

291
00:17:37,440 --> 00:17:39,140
...عذرًا يا تيكو-سان

292
00:17:39,140 --> 00:17:39,850
ماذا؟

293
00:17:39,850 --> 00:17:42,200
هل كان مُخيفًا كما ظننتِ؟

294
00:17:45,000 --> 00:17:46,120
.إطلاقًا

295
00:17:46,720 --> 00:17:48,270
!على الإطلاق

296
00:17:48,270 --> 00:17:51,460
،بفضل ضوء المصابيح، الألوان كانت مثلما هي عليه على الأرض

297
00:17:51,460 --> 00:17:54,510
.لِذا بدا النّاس والأسماك كما لو أنَّهم يطيرون بالسّماء

298
00:17:55,900 --> 00:17:58,890
.بدا مثل مسرحٍ في البحر مُضاءٌ بإضاءةٍ مُتلألئة

299
00:17:58,890 --> 00:17:59,440
!أوبيو؟

300
00:17:59,440 --> 00:18:03,680
.وكانت أرواح المياه الأوندينات ترقصُ في السّماء بداخله

301
00:18:03,680 --> 00:18:06,370
!وكأنَّه عالمٌ خياليٌّ آخر

302
00:18:06,370 --> 00:18:09,280
!لم أتوقّع بأنَّنا كُنّا نُفكّر في نفس الشيء بالضبط

303
00:18:09,280 --> 00:18:11,320
!يا للهول

304
00:18:11,840 --> 00:18:12,690
بيكاري؟

305
00:18:13,710 --> 00:18:14,840
.حسنٌ إذًا

306
00:18:14,840 --> 00:18:18,320
تيكو، أنتِ الآن مؤهّلةٌ رسميًّا
.للحصول على الرُخصة المُتقدّمة

307
00:18:18,970 --> 00:18:19,910
.أجل

308
00:18:19,910 --> 00:18:21,650
!مبارك

309
00:18:21,650 --> 00:18:22,740
.شكرًا لكم

310
00:18:23,060 --> 00:18:24,680
.يجب أن نقوم بغطسٍ احتفاليّ

311
00:18:24,680 --> 00:18:27,830
!أوه! تقصد المكان الّذي اكتشفتهُ كينو-سان؟

312
00:18:29,290 --> 00:18:30,580
!أودّ الذهاب

313
00:18:30,580 --> 00:18:32,200
!أودّ الذهاب إلى قصر ريوغو أيضًا

314
00:18:32,200 --> 00:18:33,220
!أوبيو

315
00:18:33,220 --> 00:18:35,670
.تيكو، لا تبدين حزينةً بعد الآن

316
00:18:36,060 --> 00:18:37,090
!أجل

317
00:18:37,090 --> 00:18:40,360
.ثمَّة الكثير من الأمور المُمتعة بانتظارنا من الآن فصاعدًا

318
00:18:40,360 --> 00:18:43,910
.أجل. لكن أوتعلمين، هذا ليس كلَّ شيء

319
00:18:43,910 --> 00:18:44,640
أوبيو؟

320
00:18:45,090 --> 00:18:51,600
أدركتُ أنَّ المُتعة والحُزن
.يمّتدّان وينحسران مِرارًا وتِكرارًا كالأمواج

321
00:18:51,820 --> 00:18:53,110
كالأمواج؟

322
00:18:53,110 --> 00:18:53,920
.أجل

323
00:18:54,490 --> 00:18:57,070
.مرّات عديدة تلو المرّات

324
00:18:57,270 --> 00:19:02,330
،حتّى لو كانت هناك أيّامٌ بلا أمواج
.فستأتي حتمًا موجةٌ جديدة مرّة أخرى

325
00:19:02,800 --> 00:19:04,840
.لِذا لا بأس

326
00:19:07,580 --> 00:19:12,320
مهلاً! آريه؟ هل قُلتُ
شيئًا بلا معنى؟

327
00:19:12,320 --> 00:19:13,900
.لا تقلقي

328
00:19:13,900 --> 00:19:14,880
.أتفهّمكِ أيضًا

329
00:19:15,540 --> 00:19:17,200
.هذا مُذهل يا تيكو

330
00:19:17,200 --> 00:19:20,000
!بدأتُ أشعر بطريقةٍ ما بأنَّنا سنكون على ما يرام

331
00:19:20,000 --> 00:19:21,020
حقًّا؟

332
00:19:21,020 --> 00:19:22,120
أوليس هذا غامضًا؟

333
00:19:22,120 --> 00:19:22,840
!أجل

334
00:19:23,540 --> 00:19:28,820
كونكما تفكّران بتلك الطريقة
.يُبيّن كم أصبحتما قويّتان

335
00:19:28,820 --> 00:19:29,730
صحيح يا كينو-سان؟

336
00:19:31,330 --> 00:19:34,190
.أجل هذا صحيح. إنَّه استثنائيّ

337
00:19:34,600 --> 00:19:36,210
،بالرغم مِمّا قُلتُه

338
00:19:36,210 --> 00:19:41,450
،إذا كانت موجةً كبيرة من الحُزن
.فرُبّما أغرقُ مجدّدًا

339
00:19:41,450 --> 00:19:43,840
.ماذا، لا تقلقي

340
00:19:43,840 --> 00:19:49,120
.بالفعل أنَّه كلّما ازداد استمتاعكِ أكثر ازداد حُزنكِ أكثر عند الانتهاء

341
00:19:51,960 --> 00:19:53,580
،ولكن على صعيدٍ آخر

342
00:19:53,580 --> 00:19:59,280
.كلّما ازداد حُزنكِ أكثر، ازدادت موجة الاستمتاع القادمة الّتي ستشعرين بها

343
00:20:00,410 --> 00:20:02,490
.لِذا سيكون كلُّ شيءٍ على ما يرام

344
00:20:03,550 --> 00:20:06,980
،حتَّى لو افترقتم

345
00:20:07,890 --> 00:20:09,850
.ستكونون على ما يرام

346
00:20:15,520 --> 00:20:19,520
!أنا... أرغب بالانضمام إلى نادي الغطس

347
00:20:19,520 --> 00:20:22,540
.هاه؟ إذًا، سأنضم أيضًا

348
00:20:29,220 --> 00:20:31,800
اللقاءات والفِراقات... هاه؟

349
00:20:33,380 --> 00:20:34,920
.لم أركِ مُنذُ فترة طويلة

350
00:20:35,440 --> 00:20:37,910
.إنَّها بداية العام الجديد

351
00:20:38,790 --> 00:20:42,140
،ثمَّة خرّيجين وهناك طُلابٌ جُدد

352
00:20:42,140 --> 00:20:44,550
.وأنا قادرٌ على التقدّم عامًا واحدًا بالسِنّ

353
00:20:45,220 --> 00:20:47,340
.أنا مُمتنٌ لكِ يا ماتو-تشان

354
00:20:47,340 --> 00:20:51,110
.اللقاءات والفِراقات تمّتدّ وتنحسر كالأمواج أيضًا

355
00:20:52,640 --> 00:20:55,900
.كلّما ازداد حُزن الفُراق، ازداد فَرح اللقاء

356
00:20:56,150 --> 00:20:58,880
صحيح... هل حدثَ شيءٌ ما؟

357
00:20:58,880 --> 00:20:59,860
.كلّا

358
00:21:00,300 --> 00:21:03,480
يمكن لكِلانا تعلُّم الكثير من تلاميذنا، صحيح؟

359
00:21:03,480 --> 00:21:05,820
.آه، أجل

360
00:21:11,330 --> 00:21:14,460
!إنَّنا في نفس الصفّ مجدّدًا للسنة الثانية! أنا سعيدة

361
00:21:14,460 --> 00:21:15,830
.أجل، وأنا أيضًا

362
00:21:17,820 --> 00:21:24,050
.اسمعي، لقد كتبتُ رِسالةً أُعبّر بها عن مشاعر امتناني لكِ يا تيكو

363
00:21:24,050 --> 00:21:25,010
!إيه؟

364
00:21:25,010 --> 00:21:25,660
إيه؟

365
00:21:25,660 --> 00:21:27,240
!في-في الواقع، لقد كتبتُ رِسالةً أيضًا

366
00:21:27,240 --> 00:21:27,760
!أوبيو

367
00:21:29,810 --> 00:21:31,220
هل أستطيع قراءتها الآن؟

368
00:21:31,220 --> 00:21:32,280
..أوبيو

369
00:21:32,280 --> 00:21:33,470
لا أستطيع؟

370
00:21:33,470 --> 00:21:34,430
.تفضلي

371
00:21:38,480 --> 00:21:39,800
،عزيزتي تيكو"

372
00:21:39,800 --> 00:21:42,360
.شكرًا لكِ على لقائي

373
00:21:42,810 --> 00:21:45,470
.شكرًا لكِ على البدء بالغطس

374
00:21:45,470 --> 00:21:48,320
شكرًا لكِ على اجتهادكِ
.لأجل الرُّخصة المُتقدّمة

375
00:21:49,050 --> 00:21:53,430
.شكرًا لكِ مُقدّمًا على كونكِ صديقتي في المُستقبل من الآن فصاعدًا

376
00:21:54,180 --> 00:21:58,080
،أطلعيني على الأماكن الّتي ترغبين بالذهاب إليها
.والأمور الَّتي ترغبين بفعلها

377
00:21:58,480 --> 00:22:00,820
".سأصطحبكِ بخطىً حثيثة

378
00:22:04,960 --> 00:22:07,120
هل يمكنني قراءة رِسالتكِ أيضًا يا تيكو؟

379
00:22:07,120 --> 00:22:09,010
!تـ-تـفضلي

380
00:22:10,330 --> 00:22:11,530
،عزيزتي بيكاري"

381
00:22:12,120 --> 00:22:15,640
.شكرًا لكِ على لقائي مُنذُ عام

382
00:22:16,110 --> 00:22:18,630
.شكرًا لكِ على إعطائي لقبًا

383
00:22:19,020 --> 00:22:21,830
.شكرًا لكِ على دعوتي للغطس

384
00:22:22,900 --> 00:22:26,720
.شكرًا لكِ مُقدّمًا على جميع الأمور الَّتي ستُعلّمينني إياها في المُستقبل

385
00:22:27,880 --> 00:22:34,520
اصطحِبيني رجاءً إلى بُقعة جدّتكِ الساحِرة
".وقصر ريوغو والعديد من الأماكن الأخرى

386
00:22:39,330 --> 00:22:40,370
...بيكاري

387
00:22:41,140 --> 00:22:42,160
ماذا؟

388
00:22:43,230 --> 00:22:46,550
.أنا... سعيدة

389
00:22:47,240 --> 00:22:49,100
.وأنا كذلك يا تيكو

390
00:22:56,620 --> 00:23:01,740
،وفي بداية شهر أبريل
.تحقّقت أُمنية تيكو على الفور

391
00:23:02,170 --> 00:23:06,640
الأُمنية التالية هي المجيء
.مع كوداما-تشان وكوتوري-تشان

392
00:23:08,570 --> 00:23:11,900
...بالنسبةِ إلى هذا العام، ولفترة طويلة جدًّا في المُستقبل

393
00:23:12,630 --> 00:23:14,910
!المُتعة لا حصر لها