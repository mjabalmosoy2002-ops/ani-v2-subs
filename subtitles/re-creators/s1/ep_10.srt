1
00:00:02,250 --> 00:00:03,790
...كنت أبحث عنكِ

2
00:00:06,040 --> 00:00:07,040
!ميتيورا

3
00:00:07,210 --> 00:00:08,920
!أحسنتِ أيتها الفارسة الظريفة

4
00:00:17,260 --> 00:00:18,260
!هانغاكو

5
00:00:20,520 --> 00:00:22,520
!سوتا، ابتعد عن هذا المكان

6
00:00:22,680 --> 00:00:25,020
!سوتا-دونو، اتصل بكيكوتشيهارا

7
00:02:07,660 --> 00:02:09,620
.لا تعرف حتى أساسيات القتال

8
00:02:09,790 --> 00:02:10,790
!ميروكوجي

9
00:02:13,090 --> 00:02:14,300
حقًّا؟

10
00:02:20,430 --> 00:02:22,890
هل أساعدك أيتها الفارسة الظريفة؟

11
00:02:23,050 --> 00:02:25,520
!إني في غنى عن مساعدة يديك الملوثتين

12
00:02:25,680 --> 00:02:27,810
.هذا لاذع

13
00:02:27,980 --> 00:02:30,900
...ولكن لا يهم إن كانت ملوثة أم طاهرة

14
00:02:31,060 --> 00:02:34,110
ألن تحتاجي المساعدة من هرة قدر الإمكان؟

15
00:02:34,270 --> 00:02:35,030
أأنا مخطئة؟

16
00:02:35,030 --> 00:02:36,230
!أيتها اللعينة

17
00:02:36,400 --> 00:02:37,820
...وأصلًا

18
00:02:38,070 --> 00:02:42,320
...عملكِ ليس مع الفتى المشاغب

19
00:02:42,320 --> 00:02:43,990
وإنما الفتاة المهووسة، صحيح؟

20
00:02:45,620 --> 00:02:49,210
.سأتولى أمر الفتى المشاغب بنفسي

21
00:02:49,500 --> 00:02:51,500
...أنتِ والفتاة المهووسة بالعلم

22
00:02:51,500 --> 00:02:57,170
لِم لا تتمتعا بأنوثتكما بينما تتقاتلان حتى الموت؟

23
00:03:01,840 --> 00:03:05,100
ميزوشينو-كن؟ ما قصدك باستخدام الأسلحة؟

24
00:03:05,470 --> 00:03:07,100
ما الذي يحدث عندك؟

25
00:03:07,470 --> 00:03:11,980
!ميتيورا-سان وميروكوجي-سان يقاتلان أليستيريا

26
00:03:12,150 --> 00:03:14,480
!كما أن تشيكوجوين ماغاني هناك أيضًا

27
00:03:15,480 --> 00:03:16,820
!سأتولى الأمر حالًا

28
00:03:16,980 --> 00:03:18,150
أأنت بخير؟

29
00:03:18,320 --> 00:03:19,860
.أنا بخير

30
00:03:20,110 --> 00:03:22,120
...على كلٍّ، أين سيليزيا-سان والآخرون

31
00:03:22,120 --> 00:03:23,820
.سأرسلهم إلى هناك فورًا

32
00:03:23,990 --> 00:03:25,410
.اصمدوا قليلًا رجاءً

33
00:03:27,660 --> 00:03:29,120
نصمد؟

34
00:03:34,960 --> 00:03:37,550
...باسم مبدأ آرس ماغنس

35
00:03:37,710 --> 00:03:41,510
...مثلما تتجسد الأرواح من توبوس الذي يترأس الخلق أجمع

36
00:03:41,880 --> 00:03:44,390
...فلتصقل الأرواح بالفولاذ

37
00:03:44,550 --> 00:03:46,640
!وتتخذ الهيئة التي أبتغيها

38
00:03:48,220 --> 00:03:50,100
!لن يجدي علي

39
00:03:51,980 --> 00:03:53,810
!غيتز ڤون بيرلهينغن

40
00:03:53,980 --> 00:03:55,610
!إني أستدعيكم بقفازي

41
00:03:55,770 --> 00:03:58,520
!يا فرسان الفجر، تجسدوا تحت رايتي

42
00:04:17,340 --> 00:04:18,340
!هانغاكو

43
00:04:22,050 --> 00:04:25,390
.يا لها من دمية تفوح منها رائحة العفن

44
00:04:25,550 --> 00:04:27,600
أهذه الحيلة الوحيدة التي بجعبتك؟

45
00:04:27,760 --> 00:04:30,810
.أنتِ تثيرين حنقي فعلًا

46
00:04:30,970 --> 00:04:33,850
!لا تجيدين شيئًا سوى الثرثرة بلا توقف

47
00:04:34,020 --> 00:04:35,980
.هذا مديح لي

48
00:04:36,150 --> 00:04:37,400
!أيها الفتى المشاغب

49
00:04:47,950 --> 00:04:50,740
.لا أستطيع فعل أي شيء

50
00:04:50,910 --> 00:04:52,870
.فكر يا سوتا

51
00:04:53,040 --> 00:04:54,710
.فكر مليًّا

52
00:04:55,120 --> 00:04:56,960
.حتى وإن عدت فأنا عاجز

53
00:04:57,130 --> 00:04:59,460
.سأعيقهما فحسب

54
00:05:00,130 --> 00:05:01,380
...لذا

55
00:05:12,310 --> 00:05:15,350
!واجهيني في معركة نزيهة يا ميتيورا

56
00:05:26,530 --> 00:05:28,780
.لن أسمح بموتك بعد

57
00:05:28,950 --> 00:05:31,200
...انتقامًا لموت صديقتي العزيزة ماميكا

58
00:05:31,830 --> 00:05:33,370
!ستدفعين الثمن أولًا

59
00:05:35,000 --> 00:05:36,460
!انتظري

60
00:05:42,750 --> 00:05:44,510
!ذاك المغفل. سوتا

61
00:05:44,670 --> 00:05:47,970
!أيها الفتى المشاغب، لا يجب أن تشيح بنظرك

62
00:05:48,130 --> 00:05:52,560
.بما أنك تطاردني، فاجعل الأمر رومانسيًّا أكثر

63
00:05:52,720 --> 00:05:54,930
!هيا، حاول الإمساك بي

64
00:05:55,100 --> 00:05:57,060
!سأحسم قتالي معك لاحقًا

65
00:05:57,230 --> 00:05:58,270
.أيتها الثعلبة

66
00:05:58,440 --> 00:05:59,770
...بالمناسبة

67
00:06:00,230 --> 00:06:03,980
.لاحظت شيئًا في دميتك

68
00:06:04,150 --> 00:06:05,740
أتريد معرفته؟

69
00:06:07,320 --> 00:06:10,870
.أنا مطلعة على الكثير من الأمور التافهة لذلك أعرف هذا الأمر

70
00:06:11,030 --> 00:06:14,370
هانغاكو" هو اسم جنرال أنثى، صحيح؟"

71
00:06:15,770 --> 00:06:19,290
.لديك فتاة في صفك تعتمد عليها في كل وأي شيء دائمًا

72
00:06:19,460 --> 00:06:22,340
.يا لها من عيشة رغدة، تجعلني أغار

73
00:06:22,500 --> 00:06:24,960
!علاقتي بهانغاكو ليست هكذا

74
00:06:25,130 --> 00:06:26,760
.إنها لعنة

75
00:06:26,920 --> 00:06:28,550
لعنة؟

76
00:06:29,300 --> 00:06:32,100
.مخيف، مخيف، لا يبدو هذا مسالمًا

77
00:06:32,260 --> 00:06:35,140
أتساءل أي نوع من اللعنات؟

78
00:06:35,310 --> 00:06:36,310
!أيتها اللعينة

79
00:06:36,470 --> 00:06:37,480
.هكذا إذن

80
00:06:37,640 --> 00:06:41,020
أتقصد أن علي قراءة قصتك لمعرفتها؟

81
00:06:42,480 --> 00:06:46,030
...ولكن هذا النوع من اللعنات

82
00:06:46,900 --> 00:06:49,320
أتعلم أنك تستطيع التخلص منها؟

83
00:06:49,490 --> 00:06:52,200
.أنتِ كتلة أكاذيب بالفعل

84
00:06:52,370 --> 00:06:55,200
.إن كنتِ تظنين نزعها ممكنًا، فجربي ذلك إذن

85
00:06:56,240 --> 00:06:57,370
.قبلت الرهان

86
00:06:57,540 --> 00:06:59,290
ما العمل يا ترى؟

87
00:06:59,460 --> 00:07:02,000
...قد لا يبدو علي ذلك، ولكن الأشباح والوحوش

88
00:07:02,000 --> 00:07:04,750
.كيف أصوغها... إننا ننسجم جيدًا

89
00:07:05,170 --> 00:07:07,880
...لذا فكرت بالأمر

90
00:07:08,050 --> 00:07:10,800
...لو أنني... هذا مجرد افتراض

91
00:07:10,970 --> 00:07:15,930
.لو أنني خلصتك من اللعنة، أعطني هانغاكو-تشان

92
00:07:16,100 --> 00:07:18,890
.أنت لا تحسن استخدامها على أية حال

93
00:07:19,350 --> 00:07:20,850
ماذا قلتِ؟

94
00:07:20,850 --> 00:07:21,850
...كذبة عن كذبة

95
00:07:22,020 --> 00:07:23,730
أعطيك إياها؟

96
00:07:23,940 --> 00:07:26,730
!لا تمازحيني

97
00:07:26,900 --> 00:07:29,190
.وتنقلب رأسًا على عقب

98
00:07:31,860 --> 00:07:33,780
.آسف يا ميتيورا-سان

99
00:07:34,490 --> 00:07:36,910
.لا أستطيع الهروب

100
00:07:38,700 --> 00:07:40,410
.أليستيريا-سان

101
00:07:42,290 --> 00:07:44,920
...كنتِ تحاربين أونترويلت

102
00:07:45,080 --> 00:07:46,710
.أعرفك تمام المعرفة

103
00:07:46,880 --> 00:07:48,130
.هذا طبيعي

104
00:07:48,300 --> 00:07:53,090
.فعالمي كان وسيلة تسلية لكم

105
00:07:53,720 --> 00:07:55,140
أكانت ممتعة؟

106
00:07:55,300 --> 00:07:59,020
رؤية شعبي يتعرضون للتعذيب ويقتلون؟

107
00:07:59,180 --> 00:08:00,470
!لم تكن ممتعة

108
00:08:02,770 --> 00:08:04,150
...أنا

109
00:08:04,310 --> 00:08:08,480
.مشاهدة سكان مدينتك وهم يموتون أحزنتني

110
00:08:09,230 --> 00:08:10,860
...وقرية ماغراتز

111
00:08:11,030 --> 00:08:13,860
...حين تعرضت لهجوم من جيوش أونترويلت

112
00:08:14,490 --> 00:08:16,870
!كنت أرجو أن تصلي في الوقت المناسب

113
00:08:17,030 --> 00:08:20,080
.كنت مجرد شخص يشاهد من الخارج

114
00:08:20,240 --> 00:08:22,410
...كانت مجرد قصة

115
00:08:22,910 --> 00:08:25,880
.بالنسبة لأمثالك من سكان هذا العالم

116
00:08:26,240 --> 00:08:27,960
...إن كنتِ تقولين إنها مجرد قصة

117
00:08:27,960 --> 00:08:32,260
!فهل كل شيء لم يحدث أمام عينيّ يُعد مجرد قصة بالنسبة لي؟

118
00:08:32,260 --> 00:08:35,760
!لا يهم سواءً كان واقعًا أو قصة

119
00:08:40,680 --> 00:08:44,440
.العديد من الناس يعرفون عن معركتك

120
00:08:44,640 --> 00:08:46,400
.وجميعهم يشاهدونك ويشجعونك

121
00:08:46,560 --> 00:08:48,190
أتعرفين السبب؟

122
00:08:50,230 --> 00:08:55,700
...رؤيتك وأنتِ تقاتلين وتخاطرين بحياتكِ من أجل كل شيء عزيز عليكِ

123
00:08:55,860 --> 00:09:00,200
!تمد كل شخص يعيش هنا بالأمل

124
00:09:00,700 --> 00:09:02,160
.أليستيريا-سان

125
00:09:02,330 --> 00:09:05,160
...سبب نهوضك والشيء الذي تقاتلين من أجله

126
00:09:05,790 --> 00:09:07,710
!إننا نعرفه جيدًا

127
00:09:08,710 --> 00:09:12,840
...نستمر بمشاهدتكِ تقاتلين

128
00:09:13,010 --> 00:09:15,260
.لأننا معجبون بعدالتك

129
00:09:15,420 --> 00:09:20,050
!ونرجو أن نصبح مثلك يومًا ما

130
00:09:25,890 --> 00:09:27,850
.أنت تبالغ في تقديري

131
00:09:28,730 --> 00:09:31,860
.لست نفس الشخص الذي تؤمن به

132
00:09:34,400 --> 00:09:35,900
...الأشياء العزيزة علي

133
00:09:36,450 --> 00:09:39,030
.دائمًا ما تنساب من بين أصابعي

134
00:09:40,030 --> 00:09:42,120
.حاولت أن أكون فارسة

135
00:09:42,490 --> 00:09:44,290
...بغية إنقاذ عالمي

136
00:09:44,580 --> 00:09:47,460
.خاطرت بحياتي وقاتلت حتى الآن

137
00:09:48,250 --> 00:09:49,420
...ولكن

138
00:09:49,750 --> 00:09:52,130
...كان عالمي كذبة

139
00:09:52,460 --> 00:09:54,710
.أُنشئ بغرض الترفيه لا أكثر

140
00:09:57,590 --> 00:09:59,970
.حاولت إنقاذ ماميكا

141
00:10:00,260 --> 00:10:04,640
.لكنني عجزت عن منع موتها في النهاية

142
00:10:05,350 --> 00:10:06,810
.هذا مضحك

143
00:10:06,980 --> 00:10:08,560
.بئس الفارسة

144
00:10:08,980 --> 00:10:13,150
لست إلا فزاعة في عالم خيالي فكيف لي إنقاذ العالم؟

145
00:10:14,980 --> 00:10:16,030
...ولكن

146
00:10:16,780 --> 00:10:19,410
.حتى وإن كنت فزاعة، ما زلت فارسة

147
00:10:20,530 --> 00:10:21,530
...لذا

148
00:10:23,160 --> 00:10:25,040
.تنحَّ يا فتى

149
00:10:25,540 --> 00:10:26,540
.لن أتنحى

150
00:10:27,080 --> 00:10:29,960
.لا نية لي بإقحامك في المعركة

151
00:10:30,620 --> 00:10:31,460
.تنحَّ

152
00:10:31,460 --> 00:10:32,460
.أرفض

153
00:10:32,630 --> 00:10:34,170
...أنتِ التي أعرفها

154
00:10:34,340 --> 00:10:37,130
!كانت لتفعل نفس الشيء الذي أفعله الآن

155
00:10:39,220 --> 00:10:40,550
.تراجع

156
00:10:40,970 --> 00:10:43,100
...ولكن يا ميتيورا-سان

157
00:10:43,760 --> 00:10:45,390
...أنا وهي

158
00:10:45,850 --> 00:10:48,980
.علينا أن نتحدث إلى أن نتوصل إلى تفاهم

159
00:10:49,140 --> 00:10:51,770
أبدأتِ تتأسفين على أفعالك الآن؟

160
00:10:51,940 --> 00:10:53,270
...أليستيريا-دونو

161
00:10:53,440 --> 00:10:55,440
.سأتحدث بصراحة

162
00:10:55,610 --> 00:10:57,280
...في ظل أي ظرف

163
00:10:57,530 --> 00:11:00,030
.ما كنت لأؤذي ماميكا-دونو

164
00:11:00,200 --> 00:11:03,160
أما زلتِ تنوين خداعي بمغالطتك العقيمة؟

165
00:11:03,320 --> 00:11:05,240
...كانت ماميكا عازمة بلا شك

166
00:11:05,410 --> 00:11:07,120
!وطارت أمامي

167
00:11:08,000 --> 00:11:10,660
...حاولت تسوية الخلافات معك

168
00:11:10,830 --> 00:11:13,000
!ولكن المفاوضات فشلت وأدت إلى مقتلها

169
00:11:13,000 --> 00:11:14,920
!خطأ! هذه إحدى أكاذيب ماغاني

170
00:11:14,920 --> 00:11:16,210
!اخرس

171
00:11:19,720 --> 00:11:21,300
.اخرس

172
00:11:22,090 --> 00:11:23,090
.أرجوك

173
00:11:25,470 --> 00:11:26,930
...لقد فقدت

174
00:11:27,100 --> 00:11:29,560
.كل شيء آمنت به

175
00:11:30,350 --> 00:11:31,690
.عالمي

176
00:11:31,850 --> 00:11:33,730
.وحليفتي

177
00:11:34,480 --> 00:11:36,900
...لم أعد أعلم

178
00:11:37,900 --> 00:11:39,490
.أين تقع الحقيقة

179
00:11:40,860 --> 00:11:44,030
...ولكن حتى قوقعة فارغة مثلي

180
00:11:44,280 --> 00:11:46,490
...إن كان مسموحًا لي نيل شرف الفرسان

181
00:11:46,910 --> 00:11:49,040
...إذن باسم شرفي

182
00:11:49,540 --> 00:11:52,370
!لا بد لي من الثأر لصديقتي الهالكة

183
00:11:52,620 --> 00:11:54,790
...ذلك الواجب الوحيد

184
00:11:54,960 --> 00:11:56,590
!الذي تبقى لي الآن

185
00:12:07,180 --> 00:12:08,430
!ميتيورا-سان

186
00:12:10,680 --> 00:12:11,770
لماذا؟

187
00:12:19,440 --> 00:12:20,860
سيليزيا-سان؟

188
00:12:22,280 --> 00:12:24,200
ميزوشينو-كن، أأنت بخير؟

189
00:12:24,410 --> 00:12:27,450
!أرسلت سيليزيا-سان وكانويا-كن إليكم

190
00:12:27,620 --> 00:12:29,450
.نحن في طريقنا إليكم أيضًا

191
00:12:29,620 --> 00:12:30,870
ماذا عن غيغاس ماكينا؟

192
00:12:31,040 --> 00:12:34,330
.كانويا-كن على أهبة الاستعداد في السماء

193
00:12:34,500 --> 00:12:37,080
.لا نستطيع أن نتركه يهبط في المدينة

194
00:12:37,420 --> 00:12:39,840
.استخدامه هو ملاذنا الأخير

195
00:12:40,380 --> 00:12:43,720
!ميتيورا-سان

196
00:12:46,720 --> 00:12:48,260
!انظري لفعلتك

197
00:12:50,500 --> 00:12:53,180
هل الوحيدة التي تستطيعين هزيمتها هي ساحرة ضعيفة؟

198
00:12:53,350 --> 00:12:54,640
!ظننتكِ فارسة

199
00:12:55,390 --> 00:12:56,730
!هلمي إلي

200
00:12:57,060 --> 00:12:58,860
!أيتها الجبانة

201
00:13:21,030 --> 00:13:23,260
.إن دمارك في غاية الجمال

202
00:13:27,430 --> 00:13:28,760
.هولوبسيكون

203
00:13:29,550 --> 00:13:30,970
:حركة الكون الثالثة

204
00:13:32,600 --> 00:13:34,600
".معرض التمثيل"

205
00:13:43,590 --> 00:13:45,440
...الأزهار هي أنسب

206
00:13:45,610 --> 00:13:47,490
.هدية وداع فعلًا

207
00:13:48,450 --> 00:13:51,030
أليس كذلك يا سيليزيا؟

