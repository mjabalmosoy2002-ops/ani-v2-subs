1
00:00:00,690 --> 00:00:02,780
سابقاً في تيوغونيا

2
00:00:03,270 --> 00:00:07,650
...لدى العودة إلى هيجو، التهمَ الملِك السّابق

3
00:00:07,820 --> 00:00:09,900
وتغذّى على أشقّائه

4
00:00:11,090 --> 00:00:12,900
هذا هو الديابو؟

5
00:00:14,910 --> 00:00:20,660
والآن أطعني كيف نُغيّر هذا العالم الفاسد

6
00:00:21,540 --> 00:00:24,840
!توقّفي! لم تُشفَ جروحه بعد

7
00:00:25,010 --> 00:00:26,210
!لا تُملِ عليّ ما يجب فعله

8
00:00:26,380 --> 00:00:29,670
!يمكنني استخدام أتباعي كيفما أشاء

9
00:00:31,250 --> 00:00:32,300
!احذري

10
00:02:06,460 --> 00:02:08,400
"حامي كاناي"

11
00:02:13,490 --> 00:02:14,560
!مولايّ

12
00:02:14,730 --> 00:02:18,370
!لا! سيتمّ التهامك بواسطة الديابو كذلك

13
00:02:18,540 --> 00:02:19,570
...لكن

14
00:02:19,740 --> 00:02:22,590
لا يوجد ما يُنقذه الآن

15
00:02:22,760 --> 00:02:25,200
لم يعُد أحدٌ من قبل بعد حدوث ذلك

16
00:02:25,370 --> 00:02:27,930
هذه هي نهاية هيجو

17
00:02:30,530 --> 00:02:34,850
ذلك الأحمق الطّائش سمحَ لنفسه
بأن يُلتهَم بواسطة الديابو

18
00:02:35,020 --> 00:02:37,590
أثناء مُحاولة إنقاذي فوق ذلك

19
00:02:38,230 --> 00:02:41,510
!لا أُصدّق أنّه يوجد حمقى أمثاله

20
00:02:57,070 --> 00:02:59,870
!بيتوباها! راكيتشيتا

21
00:03:04,460 --> 00:03:05,600
ما هذا؟

22
00:03:05,920 --> 00:03:11,700
رائحة لحمه فوّاحة وتبدو كخُلاصة حجر إله

23
00:03:11,870 --> 00:03:14,900
لا جدوى. بالكاد أستطيع التحرُّك

24
00:03:16,410 --> 00:03:20,130
هذه الخُلاصة تمتصّ حياتي

25
00:03:20,580 --> 00:03:23,890
ألم أعُد قادراً على القتال؟

26
00:03:24,480 --> 00:03:29,540
لم يكن من المُمكن أن أنقذ العالم

27
00:03:33,930 --> 00:03:34,930
غابة؟

28
00:03:35,950 --> 00:03:40,250
!اقتله! اقتل الدّيابو

29
00:03:40,420 --> 00:03:41,720
!بسرعة

30
00:03:41,890 --> 00:03:45,160
هذا الصّوت... أهذا أنت يا إله الوادي؟

31
00:03:47,010 --> 00:03:49,580
لا أستطيع. لا أستطيع حتّى
النّهوض بعد الآن

32
00:03:50,310 --> 00:03:53,310
لا أستطيع استخدام سيفي الإعجازيّ أيضاً

33
00:03:53,720 --> 00:03:56,670
كيف يُفترَض بي أن أخرج من هنا؟

34
00:04:02,170 --> 00:04:05,130
هل أنت إله الوادي؟

35
00:04:05,300 --> 00:04:07,430
اقتل الدّيابو

36
00:04:08,070 --> 00:04:11,310
طوّر نفسك وتجاوز الحدود

37
00:04:11,550 --> 00:04:15,030
إله الوادي، لماذا اخترتني؟

38
00:04:15,400 --> 00:04:19,630
كما قالت زاينا، ما كان ينبغي
أن أكون إله التّحكيم

39
00:04:20,490 --> 00:04:22,430
أنا عديم الجدوى

40
00:04:23,340 --> 00:04:25,580
المسؤوليّة أكبر من أن أتحمّلها

41
00:04:26,240 --> 00:04:27,910
يجب أن تُقاتل

42
00:04:28,460 --> 00:04:31,280
!انهض! ارتقِ

43
00:04:31,450 --> 00:04:33,240
!دع حياتك تشتعل بريقاً

44
00:04:33,410 --> 00:04:34,660
...إله الوادي

45
00:04:34,830 --> 00:04:36,910
!تغلّب على الموت

46
00:04:37,080 --> 00:04:39,590
!أرِهم بريقك

47
00:04:43,360 --> 00:04:45,410
الأرض تذوب

48
00:04:46,760 --> 00:04:48,230
إنّها تُدنَّس

49
00:04:49,350 --> 00:04:51,300
العالم ينقلب

50
00:04:51,660 --> 00:04:56,840
هل تحاول أن تُرشدني أنا، مُضيفك؟

51
00:04:57,010 --> 00:04:59,690
!اكره! اكره

52
00:04:59,860 --> 00:05:02,270
لا، أنت تختبرني

53
00:05:05,860 --> 00:05:06,990
!إيلسا

54
00:05:19,380 --> 00:05:21,320
ما تلك الغيوم؟

55
00:05:21,660 --> 00:05:23,580
اجمع الجنود وابقوا يقظين

56
00:05:23,750 --> 00:05:24,750
حاضر

57
00:05:27,630 --> 00:05:31,270
ستكون بخير يا إلهي. لا تخسر من فضلك

58
00:05:31,890 --> 00:05:35,160
يمتصّ الدّيابو حياة النّاس

59
00:05:35,780 --> 00:05:37,900
...على هذا المُعدّل، أنا

60
00:05:39,630 --> 00:05:43,410
!لن أدعه يمتصّ مزيداً من حياتي

61
00:05:43,960 --> 00:05:45,270
ركّز

62
00:05:45,440 --> 00:05:50,540
لحم الدّيابو شبيه بخُلاصة حجر الإله

63
00:05:51,020 --> 00:05:53,880
تلك الخُلاصة مُغلّفة بقشرة

64
00:05:54,740 --> 00:05:56,300
...والقشرة هي

65
00:05:56,660 --> 00:05:58,170
"تكلُّس"

66
00:05:58,560 --> 00:06:00,470
ذكرى غريبة أُخرى

67
00:06:01,170 --> 00:06:02,900
،إذا حميتُ نفسي بقشرة

68
00:06:03,530 --> 00:06:05,670
فلن تُؤثّر بي لعنة الخُلاصة

69
00:06:08,680 --> 00:06:12,180
!اقتل الدّيابو أيُّها المُحارب

70
00:06:12,710 --> 00:06:14,840
عُلِم

71
00:06:16,430 --> 00:06:19,960
!سأتغلّب عليه

72
00:06:26,070 --> 00:06:27,320
ماذا؟

73
00:06:31,330 --> 00:06:32,950
ما الّذي يحدث؟

74
00:06:45,780 --> 00:06:46,860
...هذا

75
00:06:47,210 --> 00:06:49,920
!عاد من داخل الدّيابو حيّاً

76
00:06:50,090 --> 00:06:53,320
يبدو مُختلفاً

77
00:06:56,320 --> 00:06:58,350
...إله جديد

78
00:07:15,370 --> 00:07:18,190
!قاتل! تجاوز الحدّ

79
00:07:18,690 --> 00:07:21,540
لم أعُد كما كنتُ قديماً

80
00:07:21,710 --> 00:07:24,590
أنا لا أُحاول إنقاذ نفسي فحسب

81
00:07:24,850 --> 00:07:27,810
أنا لا أحاول حماية واديّي فقط

82
00:07:27,980 --> 00:07:29,680
!راقبني يا إله الوادي

83
00:07:29,850 --> 00:07:31,670
،بهذه القوّة

84
00:07:31,840 --> 00:07:33,550
،كإله التّحكيم

85
00:07:33,720 --> 00:07:35,930
،كالإله العظيم كاناي

86
00:07:36,100 --> 00:07:37,300
،ديابو

87
00:07:37,470 --> 00:07:39,720
!سوف أقضي عليك

88
00:07:43,770 --> 00:07:44,880
!ديوولف

89
00:07:45,480 --> 00:07:50,840
اعترف ديوولف بذلك الفتى طوعاً؟

90
00:07:51,010 --> 00:07:54,370
!إنّه الإله العظيم كاناي بحقّ

91
00:07:55,930 --> 00:07:58,370
!أرفض الاعتراف به

92
00:08:00,620 --> 00:08:01,700
!هيّا بنا

93
00:08:01,870 --> 00:08:03,120
!هاجمه

94
00:08:03,520 --> 00:08:05,720
!هاجم العرش

95
00:08:05,890 --> 00:08:07,020
أعلم

96
00:08:07,190 --> 00:08:09,070
هناك حجر إله داخل ذلك الشّيء

97
00:08:09,240 --> 00:08:13,880
لكن جسده ضخم. لا أعرف
...مكانه بالضّبط، لذا

98
00:08:22,110 --> 00:08:23,390
!بالطّبع

99
00:08:35,250 --> 00:08:36,280
!فعلَها

100
00:08:36,450 --> 00:08:37,780
ماذا حدث؟

101
00:08:37,950 --> 00:08:42,450
يحمل مولايّ سيفاً خفيّاً

102
00:08:52,830 --> 00:08:54,840
هل أنت الجسد الرّئيسيّ؟

103
00:08:57,830 --> 00:08:58,830
!لن تفلت

104
00:09:01,310 --> 00:09:03,370
!زاباتاريغو

105
00:09:08,880 --> 00:09:10,690
!إنّه يستهدف جسدَه الرّئيسيّ

106
00:09:10,860 --> 00:09:13,060
!يحاول الاندماج من جديد

107
00:09:13,230 --> 00:09:15,320
!لن ندعه يصل إلى مولايّ

108
00:09:15,490 --> 00:09:16,610
!يجب أن نوقفه

109
00:09:16,860 --> 00:09:18,370
!غاجّيتا

110
00:09:24,710 --> 00:09:27,040
!زاينا، أوقفي ذلك الشّيء

111
00:09:27,210 --> 00:09:28,780
!لا تدعيه يخرج

112
00:09:28,950 --> 00:09:31,500
!سيلتهم كلّ الحياة

113
00:09:32,460 --> 00:09:33,560
!أرجوكِ

114
00:09:33,730 --> 00:09:35,320
!لا تُملِ عليّ ما أفعله

115
00:09:35,490 --> 00:09:37,560
!سوف نقتل الدّيابو

116
00:09:37,730 --> 00:09:39,300
!يا حمَلة الدّرع، إلى الأمام

117
00:09:39,470 --> 00:09:42,470
!حاصروه وامنعوه من الحركة

118
00:09:43,950 --> 00:09:48,280
!يا جنود، ادحروا الموت بحدِّ ذاته

119
00:09:58,610 --> 00:09:59,950
!أجل، هكذا

120
00:10:04,950 --> 00:10:06,970
لا أستطيع الوصول إلى حجر الإله الخاصّ به

121
00:10:07,400 --> 00:10:08,740
يجب أن أمزّقه

122
00:10:10,090 --> 00:10:11,430
ما هذا؟

123
00:10:11,600 --> 00:10:13,460
!ستحدث فوضى عارمة

124
00:10:23,560 --> 00:10:25,560
ها هو حجر الإله

125
00:10:25,850 --> 00:10:29,140
...اجمع النُّور

126
00:10:29,310 --> 00:10:32,110
...أكثر

127
00:10:32,280 --> 00:10:36,570
...نورك هو الأكبر

128
00:10:47,800 --> 00:10:50,260
قوى أبريدور تُقدّم المُساندة؟ لكن لماذا؟

129
00:10:50,430 --> 00:10:52,230
!لا حاجة للنّزاع الدّاخليّ الآن

130
00:10:52,400 --> 00:10:55,210
يجب ألّا ندع القطع المُتبقّية
!أن تصل إلى الجسد الرّئيسيّ

131
00:11:01,230 --> 00:11:02,300
زاينا؟

132
00:11:02,470 --> 00:11:05,470
...لا أصدّق ذلك! الأميرة

133
00:11:06,960 --> 00:11:09,710
لستُ قويّة بما يكفي لطعنه

134
00:11:10,210 --> 00:11:11,320
!لا أستطيع تثبيته فترة أطول

135
00:11:11,490 --> 00:11:14,110
!بسرعة أيّها الإله العظيم كاناي

136
00:11:15,000 --> 00:11:16,000
!عُلِم

137
00:11:17,610 --> 00:11:19,490
!استأصل حجر الإله

138
00:11:25,080 --> 00:11:26,080
إنّه ليس هنا؟

139
00:11:26,250 --> 00:11:27,630
!بسرعة

140
00:11:28,120 --> 00:11:30,270
!لا جدوى

141
00:11:32,420 --> 00:11:33,970
هل أنت الجسد الرّئيسيّ؟

142
00:11:34,140 --> 00:11:37,000
...النُّور الأكبر

143
00:11:37,860 --> 00:11:39,600
!لي

144
00:11:51,550 --> 00:11:54,150
...العب أكثر

145
00:11:56,400 --> 00:11:57,900
هل فعلها؟

146
00:12:05,930 --> 00:12:07,600
ثمّة شيء في الدّاخل هناك

147
00:12:07,770 --> 00:12:08,790
ماذا؟

148
00:12:08,960 --> 00:12:11,610
...لا أريد العودة

149
00:12:13,670 --> 00:12:17,670
هذا مثلما حدث مع أدوراكان

150
00:12:31,800 --> 00:12:34,940
الغيوم السّوداء تنقشع

151
00:12:50,190 --> 00:12:51,550
ما هذا؟

152
00:12:51,930 --> 00:12:55,460
عالم لا نعرفه؟

153
00:13:05,470 --> 00:13:06,740
شيندور؟

154
00:13:18,570 --> 00:13:19,810
أين الدّيابو؟

155
00:13:19,980 --> 00:13:21,440
رحل

156
00:13:22,420 --> 00:13:25,820
فهمت. نجوتُ إذاً

157
00:13:25,990 --> 00:13:29,320
شيندور، جرائمك نكراء

158
00:13:29,740 --> 00:13:33,320
تبدّد طموحي

159
00:13:37,250 --> 00:13:40,140
مولايّ، انتهى الأمر

160
00:13:40,310 --> 00:13:42,330
هكذا يبدو

161
00:13:42,500 --> 00:13:43,530
مولايّ؟

162
00:13:43,700 --> 00:13:44,700
ما الأمر؟

163
00:13:47,380 --> 00:13:49,380
يقول بأنّه جائع

164
00:13:50,500 --> 00:13:51,580
من يكون؟

165
00:13:51,750 --> 00:13:55,990
الشّخص الّذي ساهمَ في تنظيف مُخلّفاتك

166
00:13:56,160 --> 00:13:57,900
مُخلّفاتي؟

167
00:13:58,620 --> 00:14:01,150
زاينا، دعيني أقول هذا

168
00:14:01,700 --> 00:14:05,010
لا تستسلمي للفخر المُكتسَب
من خلال القوّة

169
00:14:05,180 --> 00:14:09,240
...مثلي ومثل أخوتنا وأبينا

170
00:14:09,410 --> 00:14:13,400
كدتُ أقع في نفس الفخّ

171
00:14:25,050 --> 00:14:28,440
الإله العظيم كاناي، استيقظت

172
00:14:28,960 --> 00:14:30,060
أين أنا؟

173
00:14:36,560 --> 00:14:39,330
!فعلناها

174
00:14:40,420 --> 00:14:42,560
!الإله العظيم كاناي

175
00:14:43,510 --> 00:14:46,650
أبريدور، هل يمكنك النّهوض الآن؟

176
00:14:46,820 --> 00:14:51,030
بدأتْ قوّتي تعود منذ انحسر تدنيس الأرض

177
00:14:51,200 --> 00:14:53,050
الإله العظيم كاناي

178
00:15:05,710 --> 00:15:08,270
أنقذتُ هؤلاء؟

179
00:15:08,640 --> 00:15:11,900
حضّرنا شيئاً لك في الأسفل. تعال

180
00:15:12,070 --> 00:15:13,220
ماذا؟

181
00:15:20,900 --> 00:15:22,810
هذا مُبهر

182
00:15:22,980 --> 00:15:25,730
كلّ هذا لأجلك

183
00:15:32,280 --> 00:15:39,290
كوّنتُ صداقة مع أكثر من عشرة آلاف
ماكاك يدعمون أبريدور

184
00:15:40,710 --> 00:15:45,670
بعد أن تلقّيتُ إكرامهم، غادرتُ قريتهم

185
00:15:52,050 --> 00:15:53,360
زاينا

186
00:15:55,550 --> 00:15:57,060
ماذا تريدين؟

187
00:15:57,300 --> 00:16:03,210
لا نريد شيئاً. إنّما الحقيقة هي
أنّك قتلتَ الدّيابو

188
00:16:03,750 --> 00:16:06,020
كملِكة، أتيتُ لأشكرك

189
00:16:06,190 --> 00:16:07,230
ملِكة؟

190
00:16:08,420 --> 00:16:11,110
تلقّيتُ بركةَ الإله الملكيّ

191
00:16:11,280 --> 00:16:14,380
من الآن فصاعداً، أنا ملِكة الماكاك

192
00:16:14,780 --> 00:16:17,580
أبريدور والماكاك الخاصّون به لا يعترفون بك

193
00:16:18,820 --> 00:16:21,080
سأدفعهم لذلك

194
00:16:21,370 --> 00:16:23,240
الأهمّ، أخبرني بما ترغبه

195
00:16:23,410 --> 00:16:25,160
سأمنحك طلباً واحداً

196
00:16:25,330 --> 00:16:27,460
طلب واحد؟

197
00:16:28,700 --> 00:16:31,840
في هذه الحالة، حرّري ديوولف

198
00:16:32,060 --> 00:16:33,470
أُحرّر ديوولف؟

199
00:16:34,320 --> 00:16:36,470
إذاً اعتبر طلبك مُجاباً

200
00:16:36,730 --> 00:16:38,500
،لتلقّي برَكة الإله الملكيّ

201
00:16:38,670 --> 00:16:42,470
كنتُ مُضطرّة للتخلّي عن برَكة
إله النّاس الّذين يخدمهم

202
00:16:43,160 --> 00:16:45,480
ديوولف حُرّ بالفعل

203
00:16:48,480 --> 00:16:49,810
...ديوولف

204
00:16:55,520 --> 00:16:59,060
سمعتُ بأنّك قبلتَ حلفاً مع أبريدور

205
00:16:59,370 --> 00:17:00,820
ينتشر الكلام بسرعة

206
00:17:00,990 --> 00:17:05,330
المرّة المُقبلة الّتي نلتقي فيها
قد تكون في ساحة المعركة

207
00:17:05,500 --> 00:17:08,000
أُفضّل ألّا ألتقي بكِ هناك

208
00:17:09,390 --> 00:17:12,770
وداعاً أيُّها الإله العظيم كاناي

209
00:17:14,250 --> 00:17:18,890
لنلتقِ من جديد يا زاينا، ملِكة الماكاك

210
00:17:29,010 --> 00:17:31,610
كاي! عُدت

211
00:17:31,780 --> 00:17:34,860
أجل. أتممتُ عملي

212
00:17:35,030 --> 00:17:36,300
كيف سارت الأمور؟

213
00:17:36,670 --> 00:17:39,770
لم يعُد يوجد أي ماكاك هنا

214
00:17:39,940 --> 00:17:42,570
ماذا؟ لكن هذا غير ممكن

215
00:17:42,740 --> 00:17:45,580
طاردتُهم إلى أعماق الغابة لأيّام

216
00:17:46,010 --> 00:17:49,540
أنا متأكّد بأنّهم غادروا جميعاً

217
00:17:50,700 --> 00:17:51,860
حقّاً؟

218
00:17:52,030 --> 00:17:53,030
أجل

219
00:17:54,030 --> 00:17:55,770
سيحلّ الشّتاء هنا قريباً

220
00:17:56,230 --> 00:17:58,710
أشباه البشر سيختبئون

221
00:17:59,210 --> 00:18:02,180
سننعم ببعض السّلام والهدوء لبعض الوقت

222
00:18:02,350 --> 00:18:03,390
أجل

223
00:18:03,560 --> 00:18:04,800
بالمناسبة

224
00:18:05,740 --> 00:18:06,810
خذي

225
00:18:07,900 --> 00:18:11,460
عندما أعطيتني هذا، قلتِ لي

226
00:18:11,890 --> 00:18:14,780
بأنّني لا أستطيع القتال بكامل
قوّتي إذا راودتني شكوك

227
00:18:15,230 --> 00:18:17,450
كنتِ مُحقّة

228
00:18:18,120 --> 00:18:20,070
كلماتكِ أنقذتني

229
00:18:20,710 --> 00:18:21,950
...هكذا إذاً

230
00:18:22,230 --> 00:18:25,160
كاي، يبدو أنّك تغيّرت

231
00:18:25,330 --> 00:18:26,370
ماذا؟

232
00:18:26,540 --> 00:18:29,550
وكأنّك نضجت فجأة

233
00:18:29,720 --> 00:18:31,910
ماذا؟ ليس إلى هذه الدّرجة

234
00:18:32,080 --> 00:18:34,710
ربّما قصصتُ شعري قليلاً

235
00:18:35,580 --> 00:18:37,600
المعذرة... جوسي-ساما؟

236
00:18:37,770 --> 00:18:38,770
ماذا؟

237
00:18:40,180 --> 00:18:42,170
!كاي

238
00:18:42,340 --> 00:18:43,510
...و

239
00:18:43,900 --> 00:18:44,960
جوسي-ساما؟

240
00:18:45,130 --> 00:18:46,650
...بما أنّك عدت

241
00:18:46,820 --> 00:18:47,870
...فكان ينبغي لك على الأقلّ

242
00:18:48,040 --> 00:18:49,310
أن تأتي لرؤيتنا...

243
00:18:49,480 --> 00:18:50,600
لقد عُدت

244
00:18:50,770 --> 00:18:52,610
أليس لديك شيء آخر تقوله؟

245
00:18:53,740 --> 00:18:57,550
باسكو، هل تعتقد بأنّ كاي قد تغيّر؟

246
00:18:57,720 --> 00:19:00,190
لا، ليس تماماً

247
00:19:01,480 --> 00:19:03,370
—أولها، هل أنت

248
00:19:03,620 --> 00:19:06,870
أولها-ساما قد تعافى كُلّياً

249
00:19:09,290 --> 00:19:14,960
،أبي، لعلّ هجمات الماكاك قد توقّفت
لكن لدينا مخاوف أُخرى

250
00:19:15,130 --> 00:19:19,200
تقصد اختفاء المُفتّش غاندال

251
00:19:19,370 --> 00:19:24,470
أرسلتُ كشّافين، لكنّه لم يصل
إلى أي قرية أُخرى بعد

252
00:19:24,640 --> 00:19:28,220
سمعتُ بأنّ إحدى فتيات القرية فُقِدت كذلك

253
00:19:28,390 --> 00:19:31,530
السّهول الوسطى سيُعلِّقون حول هذا الأمر

254
00:19:31,900 --> 00:19:35,730
سيلقون اللّوم على قرية لاغ بشأن اختفائه

255
00:19:35,900 --> 00:19:39,990
سنضطرّ للطّلب من الكونت المحلّي للتدخُّل

256
00:19:40,400 --> 00:19:46,340
لكن بالنّسبة لليوم، أبناء مولوك وهذه الأرض بأمان

257
00:19:48,610 --> 00:19:51,280
كاي، كنتَ مع جوسي-ساما، أليس كذلك؟

258
00:19:51,450 --> 00:19:52,850
ماذا؟ حقّاً؟

259
00:19:53,020 --> 00:19:55,640
بما أنّك عدت بأمان، فسأسمح بذلك

260
00:19:55,810 --> 00:19:57,590
اصمتوا

261
00:19:57,760 --> 00:19:58,920
أحقّاً ذلك؟

262
00:20:03,200 --> 00:20:05,680
شكراً على الاعتناء بإيلسا

263
00:20:05,850 --> 00:20:06,850
إطلاقاً

264
00:20:07,110 --> 00:20:10,260
حياة الآنسة إيلسا أقوى ممّا ظننت

265
00:20:10,430 --> 00:20:12,690
أنا متأكّدة بأنّها ستتعافى

266
00:20:13,240 --> 00:20:14,240
أجل

267
00:20:15,450 --> 00:20:18,550
قد يصبح هذا الوادي دولة جديدة

268
00:20:19,440 --> 00:20:23,810
،قلتِ لكِ بأنّكِ سآخذكِ إلى مكان مُميّز يوماً ما

269
00:20:24,200 --> 00:20:26,960
،لكن إذا أصبح هذا المكان دولة فعلاً

270
00:20:27,530 --> 00:20:34,320
فسوف أحضر أختكِ الصّغرى إلى هنا

271
00:20:36,490 --> 00:20:39,520
سأنتظر مجيء هذا اليوم

272
00:20:40,090 --> 00:20:41,090
ماذا؟

273
00:20:45,600 --> 00:20:48,310
أؤمن بأنّ هذا اليوم سيأتي

274
00:20:48,480 --> 00:20:49,800
أروي

275
00:20:49,970 --> 00:20:54,980
في نهاية المطاف، أصبحتَ إلَهاً جديداً
عندما غادرتَ القرية

276
00:20:55,270 --> 00:21:01,230
من الطّبيعيّ لإله جديد أن يبني دولة جديدة

277
00:21:01,610 --> 00:21:08,570
هذا ما فعلته الأرض والآلهة والنّاس
الّذين يعيشون هناك منذ القِدَم

278
00:22:48,400 --> 00:22:50,050
!دعوني أرى الإله

279
00:22:50,220 --> 00:22:52,040
ما الأمر؟

280
00:22:52,210 --> 00:22:54,690
!دعني أرى الإله في هذه اللّحظة

281
00:22:54,860 --> 00:22:55,960
ما الأمر؟

282
00:22:56,130 --> 00:22:57,160
ها أنت ذا

283
00:22:57,330 --> 00:22:58,560
...أنتِ

284
00:22:58,730 --> 00:23:00,720
أنا نيرون من الأوزيلي

285
00:23:00,890 --> 00:23:04,610
دعنا—من فضلك دعنا ننضمّ لقطيعك

286
00:23:05,280 --> 00:23:06,940
ما هذا الطّلب فجأة؟

287
00:23:07,110 --> 00:23:09,590
أنا، نيرون، الابنة الوحيدة لكبيرنا

288
00:23:09,760 --> 00:23:12,250
ورثتُ برَكة إله الأرض الخاصّ بنا

289
00:23:12,420 --> 00:23:14,720
من واجبي حماية عشيرتي

290
00:23:14,890 --> 00:23:16,360
اسمح لنا بعبادتك من فضلك

291
00:23:16,530 --> 00:23:17,580
ماذا؟

292
00:23:17,750 --> 00:23:19,760
اجمع العابدين

293
00:23:19,990 --> 00:23:21,060
!ماذا؟

294
00:23:21,230 --> 00:23:23,040
سأمنحك كلّ ما أملك

295
00:23:23,210 --> 00:23:25,080
سوف أصبح زوجتك

296
00:23:25,250 --> 00:23:28,950
الأوزيلي مُسالمون. يمكننا التّعايش معهم

297
00:23:29,120 --> 00:23:33,470
وكان ينقصنا حُرّاس للوادي

298
00:23:33,640 --> 00:23:35,800
!سأبقى مُلتصقة بك

299
00:23:35,970 --> 00:23:39,980
!ابتعدي عنّي