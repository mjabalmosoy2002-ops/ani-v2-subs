1
00:00:05,620 --> 00:00:08,110
!يعود أوسوماتسو-سان

2
00:00:10,740 --> 00:00:12,700
!إنه وضعٌ طارئ

3
00:00:13,010 --> 00:00:14,570
!أكرّر، إنه وضعٌ طارئ

4
00:00:14,570 --> 00:00:15,580
!كاراماتسو

5
00:00:16,070 --> 00:00:16,980
!تشوروماتسو

6
00:00:17,450 --> 00:00:18,540
!إتشيماتسو

7
00:00:18,950 --> 00:00:20,140
!جيوشيماتسو

8
00:00:20,450 --> 00:00:21,510
!تودوماتسو

9
00:00:22,200 --> 00:00:25,060
ما الخطب يا أوسوماتسو-نيسان؟

10
00:00:25,060 --> 00:00:26,410
!إنه وضعٌ طارئ

11
00:00:26,410 --> 00:00:30,060
الأنمي الخاص بنا الذي انتهى
في مارس من العام الماضي

12
00:00:30,060 --> 00:00:31,840
!سيبدأ مُجدّدًا اليوم

13
00:00:31,840 --> 00:00:33,580
!ماذا؟

14
00:00:35,650 --> 00:00:37,860
!أجل! وقد بدأ بالفعل

15
00:00:44,120 --> 00:00:45,250
!هذه معجزة

16
00:00:45,250 --> 00:00:46,910
!مرحى

17
00:00:47,260 --> 00:00:48,800
...أنا قلق

18
00:00:48,800 --> 00:00:50,600
ماذا هناك يا تشوروماتسو؟

19
00:00:50,600 --> 00:00:54,940
لقد بُثَّ الأنمي الخاص بنا قبل عامين

20
00:00:54,940 --> 00:00:56,940
فأتساءل ما إن كان أيّ أحدٍ يذكرنا الآن

21
00:00:56,940 --> 00:00:58,820
هل انتظرنا النّاس حقًّا؟

22
00:00:59,210 --> 00:01:00,380
!سيكون الأمر بخير

23
00:01:00,380 --> 00:01:02,100
!لا تقلق

24
00:01:02,100 --> 00:01:07,370
إن كنتَ قلقًا لهذه الدرجة، أتريد أن نستخدم
هذا التلفاز لنرى كيف نكون في المستقبل؟

25
00:01:07,370 --> 00:01:09,330
ماذا؟ أيمكننا فعل ذلك حقًّا؟

26
00:01:09,330 --> 00:01:10,420
!أجل! أريد أن أرى ذلك

27
00:01:10,420 --> 00:01:13,340
!لا أطيق الانتظار لأرى كيف نحن ككبار

28
00:01:14,620 --> 00:01:16,450
!حسنًا، اجتمعوا

29
00:01:17,130 --> 00:01:19,350
ها نحن. هل أنتم مستعدّون؟

30
00:01:19,350 --> 00:01:20,350
!أجل

31
00:01:20,710 --> 00:01:24,100
!والآن، الأنمي الخاص بنا يعود

32
00:01:24,100 --> 00:01:26,100
!يعود

33
00:01:29,350 --> 00:01:31,550
الأنمي التلفزيوني أوسوماتسو-سان

34
00:01:32,110 --> 00:01:35,490
انتهى بثّه بشكلٍ مؤقتٍ في مارس من 2016

35
00:01:35,490 --> 00:01:39,460
وقد خلق ضجة بسيطة وأصبح ذا شعبية قليلًا

36
00:01:39,460 --> 00:01:42,870
والآن مرّ عامٌ وستّة أشهر

37
00:01:43,330 --> 00:01:46,950
بئسًا... لقد مرّ وقتٌ طويل

38
00:01:46,950 --> 00:01:49,100
ماذا كنتَ تفعل؟

39
00:01:49,100 --> 00:01:51,340
ماذا برأيك؟

40
00:01:51,340 --> 00:01:54,850
لقد كنتُ أنا أقضي عطلةً في فرنسا

41
00:01:55,350 --> 00:01:57,380
فهمت

42
00:01:57,380 --> 00:01:59,610
أنا لستُ من العامّة مثلك

43
00:01:59,610 --> 00:02:00,310
فعلًا

44
00:02:00,310 --> 00:02:02,580
!لا تصدّقني، أليس كذلك؟

45
00:02:02,580 --> 00:02:05,140
إليكَ الدليل! انظر، برج ترامب

46
00:02:05,140 --> 00:02:06,370
!تلك ليست فرنسا

47
00:02:07,780 --> 00:02:12,020
بالتفكير في الأمر، ما أحوال أولئك الأغبياء؟
لمَ لا نزورهم في منزلهم؟

48
00:02:12,500 --> 00:02:16,540
،بمعرفتي لأولئك الأغبياء
أنا واثقٌ أنّ لا شيء تغيّر

49
00:02:16,540 --> 00:02:20,980
لا بدّ أنّهم يتكاسلون فقط ولا يقومون
—بأيّ شيء ويعيشون حياةً بدون أيّ معنى

50
00:02:20,980 --> 00:02:21,700
ماذا؟

51
00:02:22,020 --> 00:02:24,410
!ماذا؟ ما هذا؟

52
00:02:25,370 --> 00:02:28,310
هل أصبح منزلهم أكبر بكثيرٍ عن السابق؟

53
00:02:28,310 --> 00:02:29,970
!هل جُدِّدَ تمامًا؟

54
00:02:29,970 --> 00:02:30,500
!حقًّا؟

55
00:02:30,500 --> 00:02:33,050
!انظر! بابهم الأمامي فيه قفلٌ آليّ

56
00:02:33,050 --> 00:02:34,090
!شييه

57
00:02:34,090 --> 00:02:36,100
!كما أنّ منزلهم يعمل بالطاقة الشمسيّة أيها الغبي

58
00:02:36,100 --> 00:02:37,200
!شييه

59
00:02:37,200 --> 00:02:38,840
!حتّى أنّ لديهم واي فاي

60
00:02:38,840 --> 00:02:40,620
...شـ-شـ-شييه

61
00:02:40,620 --> 00:02:42,340
مـ-ما قصّة هذه التغييرات؟

62
00:02:42,340 --> 00:02:45,650
!متى أصبحوا بهذا الثراء أيها الغبي؟

63
00:02:45,650 --> 00:02:47,680
!تشيبيتا، لا بدّ أنّ هذا السبب

64
00:02:48,740 --> 00:02:50,720
ماذا...؟

65
00:02:50,720 --> 00:02:51,810
!ما الذي يجري؟

66
00:02:51,810 --> 00:02:52,810
!انظر هناك أيضًا

67
00:02:54,130 --> 00:02:57,070
هل يُعقل أنّ أولئك الأشخاص معجبوهم؟
وهل هم هنا لأجل مقابلتهم؟

68
00:02:57,070 --> 00:03:00,640
ما الذي يجري؟
ما الذي حدث؟

69
00:03:00,640 --> 00:03:03,250
!الأمر يكاد يبدو وكأنّهم ذوي شعبية بالفعل

70
00:03:03,250 --> 00:03:05,210
!ما الذي يجري في هذا العالم؟

71
00:03:05,210 --> 00:03:08,370
!تماسك يا عالم! حقًّا، ما هذا؟

72
00:03:08,370 --> 00:03:09,460
!أيها الأغبياء! تبًّا

73
00:03:09,960 --> 00:03:12,580
!استيقظوا! إنّهم عاطلون

74
00:03:12,580 --> 00:03:13,180
!إنّهم بِكر

75
00:03:13,180 --> 00:03:13,890
!حثالة

76
00:03:13,890 --> 00:03:14,280
!قمامة

77
00:03:14,280 --> 00:03:14,700
!قذارة

78
00:03:14,700 --> 00:03:15,180
—تبًّا

79
00:03:19,820 --> 00:03:23,210
لـ-لا فائدة... إنّهم بلا روحٍ تمامًا

80
00:03:23,210 --> 00:03:24,550
...شييه

81
00:03:24,550 --> 00:03:26,260
ماذا لدينا هنا؟

82
00:03:26,260 --> 00:03:30,760
ماذا؟ أتريدان مقابلة التوائم الستّة-ساما ماتسونو؟

83
00:03:30,760 --> 00:03:32,020
!الـ-التوائم الستّة-ساما؟

84
00:03:32,020 --> 00:03:35,930
التوائم الستّة-ساما لديهم عملهم الناجح

85
00:03:35,930 --> 00:03:40,190
،ولأنّ لديهم عملهم الناجح
فقد مُنِحوا ثروةً وشهرةً سخفيتين

86
00:03:40,190 --> 00:03:43,660
وبسبب ذلك، فهم يعيشون حياةً
جيدة بأسلوبٍ سخيف تمامًا

87
00:03:43,660 --> 00:03:44,730
أتريدان الذهاب لمقابلتهم؟

88
00:03:55,310 --> 00:03:57,960
ماذا تفعلان؟ أسرعا

89
00:03:59,230 --> 00:04:02,220
التوائم الستّة-ساما يجرون لقاءً مع المعجبين

90
00:04:02,220 --> 00:04:03,910
احرصا على عدم عرقلتهم

91
00:04:03,910 --> 00:04:05,470
لقاء مع المعجبين؟

92
00:04:07,180 --> 00:04:08,190
إلى اللقاء

93
00:04:12,740 --> 00:04:15,830
أوسوماتسو؟ كاراماتسو؟

94
00:04:15,830 --> 00:04:17,400
هل أنتم هنا؟

95
00:04:18,860 --> 00:04:19,900
...إ-إنّه

96
00:04:19,900 --> 00:04:21,570
!ما هذا؟

97
00:04:33,810 --> 00:04:35,270
مرحبًا. تفضلي

98
00:04:35,270 --> 00:04:36,540
أجل

99
00:04:37,880 --> 00:04:40,740
!شيييه

100
00:04:51,250 --> 00:04:52,420
أجل، فهمت

101
00:04:52,420 --> 00:04:54,410
أجل، بالفعل

102
00:05:01,430 --> 00:05:03,240
أبعدن أيديكنّ الوسخة

103
00:05:07,610 --> 00:05:09,330
أجل

104
00:05:10,060 --> 00:05:12,640
مرحبًا. شكرًا

105
00:05:12,640 --> 00:05:13,540
مرحبًا

106
00:05:17,540 --> 00:05:19,450
!أنا توتي

107
00:05:19,450 --> 00:05:20,920
ألستُ ظريفًا؟

108
00:05:23,770 --> 00:05:25,530
...إنّهم مقرفون حقًّا

109
00:05:25,530 --> 00:05:26,890
...شييه

110
00:05:27,430 --> 00:05:30,430
!رفاق

111
00:05:32,700 --> 00:05:35,930
.مضى وقتٌ طويل
كان عليكما أن تخبرانا أنّكما قادمان

112
00:05:35,930 --> 00:05:42,940
.لدينا عملنا الناجح
لا أعلم كيف، لكنّنا أصبحنا أثرياء للغاية

113
00:05:42,940 --> 00:05:45,730
لذا ففكرة العمل غير واردة تمامًا

114
00:05:45,730 --> 00:05:50,280
.إنّنا نعيش حياة الرفاهية
الحياة ممتعة حقًّا

115
00:05:50,630 --> 00:05:55,420
.أجل، نعتذر
أصبحنا أثرياء للغاية وذوي شعبية

116
00:05:55,420 --> 00:05:57,290
الحياة ممتعةٌ حقًّا الآن

117
00:06:04,340 --> 00:06:06,950
تفضلا. هذا كتاب طبخٍ أصدرته

118
00:06:06,950 --> 00:06:08,180
أتريدان توقيعًا؟

119
00:06:08,180 --> 00:06:10,350
تبًّا، هذا مرهق حقًّا

120
00:06:10,350 --> 00:06:14,640
،لدينا مال، لدينا شعبية
حتّى التنفّس مرهق

121
00:06:18,600 --> 00:06:22,350
صحيح. لمَ لا نطلب بعض السوشي لهما؟

122
00:06:22,350 --> 00:06:24,610
.السوشي؟ تبدو فكرةً جيّدة
أجل، سيكون على حسابنا

123
00:06:24,940 --> 00:06:26,890
أيّ إعدادٍ يجب أن نطلب؟

124
00:06:26,890 --> 00:06:29,590
إعداد ماتسو بالطبع

125
00:06:30,190 --> 00:06:31,620
نحن ماتسو في النهاية

126
00:06:36,130 --> 00:06:38,010
!لـ-لأننا ماتسو

127
00:06:38,010 --> 00:06:41,040
!إعداد السوشي يدعى ماتسو ونحن ماتسو أيضًا

128
00:06:42,130 --> 00:06:44,300
!نكاتك مضحكة جدًّا

129
00:06:43,290 --> 00:06:45,580
.لا عجب أنّنا ناجحون
لا عجب أنّنا ذوو شعبية

130
00:06:50,370 --> 00:06:53,640
ماذا؟ هذا لن يفيد بالطبع

131
00:06:53,640 --> 00:06:58,380
محالٌ أن يقوم توائمنا الستّة
المحبوبين بشيءٍ مبتذل كهذا

132
00:06:58,380 --> 00:07:02,020
.إنّهم نجوم وطنيون الآن
ماذا لو كرههم النّاس بسبب هذا؟

133
00:07:02,020 --> 00:07:02,820
!لا نكات دنيئة

134
00:07:02,820 --> 00:07:03,770
!لا ابتذال

135
00:07:03,770 --> 00:07:04,810
!لا شيء غريب

136
00:07:04,810 --> 00:07:05,480
!لا مزيد من المحاكاة الساخرة

137
00:07:05,480 --> 00:07:08,070
!الظرافة تسود

138
00:07:08,070 --> 00:07:10,490
!توائمي الستّة الصغار

139
00:07:09,570 --> 00:07:12,180
!توائمنا الستّة الظرفاء

140
00:07:15,860 --> 00:07:20,410
حسنًا! لقد أعددنا بعض السلع
!الجديدة لأجل التوائم الستّة الصغار

141
00:07:20,740 --> 00:07:22,710
!أوّلًا... مفاجأة

142
00:07:23,030 --> 00:07:25,670
!حمّالة مفاتيح أوسوماتسو-كُن بـ5،000 ين

143
00:07:25,670 --> 00:07:27,380
إنه ظريف، جو

144
00:07:27,380 --> 00:07:29,630
!التالي... مفاجأة

145
00:07:29,990 --> 00:07:32,630
!بلّوز كاراماتسو-كُن بـ10،000 ين

146
00:07:32,950 --> 00:07:34,640
مصنوعٌ بدقة، جو

147
00:07:34,640 --> 00:07:38,310
!مفاجأة! دمية تشوروماتسو المحشوة بـ30،000 ين

148
00:07:38,310 --> 00:07:39,850
أريدها تمامًا، جو

149
00:07:40,170 --> 00:07:43,560
!مفاجأة! مجموعة مجسّمات إتشيماتسو-سان بـ100،000 ين

150
00:07:43,560 --> 00:07:45,820
ستباع بثمنٍ أغلى، جو

151
00:07:45,820 --> 00:07:47,770
أ-أرجو المعذرة

152
00:07:47,770 --> 00:07:52,280
...لا بدّ وأن أتساءل عن الجودة

153
00:07:52,660 --> 00:07:54,780
الجودة؟

154
00:07:55,780 --> 00:07:59,220
!من يكترث للجودة؟
!إن وضعنا هذا الهراء للبيع، فسيباع

155
00:07:59,220 --> 00:08:01,000
!اعرض هذه القذارة للبيع وبعها فحسب

156
00:08:01,000 --> 00:08:04,170
!نحن هنا لنربح مالًا هنيئًا فحسب
!لا يوجد ما هو أفضل من هذا

157
00:08:05,150 --> 00:08:07,190
!أنا فاحشة الثراء بسبب أولئك التوائم الستّة

158
00:08:07,190 --> 00:08:09,530
مشروعٌ مربح، جو

159
00:08:12,010 --> 00:08:14,640
!شيييه

160
00:08:12,470 --> 00:08:14,640
!ما هذا أيها الأغبياء! تبًّا

161
00:08:15,830 --> 00:08:18,930
سنخبركنّ بسرٍّ صغير

162
00:08:19,420 --> 00:08:24,660
صدّقن أو لا، نحن من صنعنا أنمي التوائم الستّة ذاك

163
00:08:24,660 --> 00:08:27,700
!لقد كان إنجازنا نحن

164
00:08:29,650 --> 00:08:31,700
أتردن مقابلة التوائم الستّة؟

165
00:08:31,700 --> 00:08:33,620
ما رأيكن؟

166
00:08:40,070 --> 00:08:42,020
!أحضري لي المزيد من الساكي

167
00:08:48,940 --> 00:08:50,880
مذاقه رائع

168
00:08:52,540 --> 00:08:54,810
!أنت ظريفة

169
00:08:54,810 --> 00:08:57,180
يمكن للقبيحات أن تنصرفن. جدّيًا

170
00:09:02,430 --> 00:09:04,770
!انتبهوا جيدًا جميعًا

171
00:09:04,770 --> 00:09:09,520
...لذا مع الأنمي المناسب
الشخصيات المشهورة... مفهوم؟

172
00:09:11,980 --> 00:09:16,270
...سأفكّر بإيجابية بروحٍ حِبّية وسلمية

173
00:09:30,860 --> 00:09:33,350
لقد هيمنّا على البلاد بأسرها

174
00:09:33,350 --> 00:09:34,280
أليس كذلك؟

175
00:09:34,280 --> 00:09:36,210
لا أحد يشتكي بعد الآن

176
00:09:36,210 --> 00:09:37,260
أليس كذلك؟

177
00:09:37,260 --> 00:09:39,510
...والآن، مستقبلنا

178
00:09:39,510 --> 00:09:42,470
!مضمون

179
00:09:42,470 --> 00:09:43,680
!إنه مضمون

180
00:09:44,090 --> 00:09:45,390
!مضمون

181
00:09:45,390 --> 00:09:49,850
!هكذا يجب أن يكون

182
00:09:51,480 --> 00:09:53,860
!هذا هراء

183
00:09:53,860 --> 00:09:56,280
!من تظنّون أنفسكم أيها العاطلون البكر؟

184
00:09:56,280 --> 00:09:58,070
!تبًّا لأوسوماتسو-سان هذا

185
00:09:58,070 --> 00:10:00,070
!كفّوا عن الإفراط في الحماس

186
00:10:00,070 --> 00:10:01,910
!من تحسبون أنفسكم؟

187
00:10:01,910 --> 00:10:03,120
!العقوبة الإلهية

188
00:10:04,950 --> 00:10:06,690
ما رأيك أن تموت؟

189
00:10:13,210 --> 00:10:16,510
أجل... توقعنا حدوث هذا

190
00:10:16,990 --> 00:10:19,990
لقد انتهى كل شيء أيها الأغبياء

191
00:10:19,990 --> 00:10:21,700
انتهى

192
00:10:29,240 --> 00:10:30,540
ما كان ذلك؟

193
00:10:30,540 --> 00:10:33,760
أهكذا يفترض أن يكون مستقبلنا؟

194
00:10:33,760 --> 00:10:35,340
لقد كنّا حثالة جميعًا

195
00:10:35,340 --> 00:10:37,550
أجل، لم نكن سوى قمامة

196
00:10:39,310 --> 00:10:41,300
!ماذا؟

197
00:10:41,300 --> 00:10:44,510
!ما كان ذلك؟! أهكذا سينتهي بنا الحال في المستقبل؟

198
00:10:44,510 --> 00:10:45,350
!لا

199
00:10:45,350 --> 00:10:47,250
!انتهى الأنمي! انتهى

200
00:10:47,250 --> 00:10:49,450
!لا يجب أن نقوم به بعد الآن

201
00:10:49,970 --> 00:10:52,810
!فلينقذنا أحدكم

202
00:10:50,790 --> 00:10:53,290
!ا-اهدؤوا جميعًا

203
00:10:53,680 --> 00:10:54,950
!ما زال أمامنا وقت

204
00:10:54,950 --> 00:10:56,710
،إن بدأنا العمل بجدّ الآن

205
00:10:56,710 --> 00:10:59,760
!فبوسعنا أن نصبح أنمي رائعًا محبوبًا من قبل الجميع

206
00:11:00,110 --> 00:11:02,160
أحقًّا يا أوسوماتسو-نيسان؟

207
00:11:02,160 --> 00:11:03,840
أجل، فلنبذل قصارى جهدنا

208
00:11:03,840 --> 00:11:05,870
!سنولد من جديد! بدءًا من الآن

209
00:11:05,870 --> 00:11:07,630
!مفهوم

210
00:11:08,150 --> 00:11:13,900
لذا قرّر التوائم الستّة أن يعملوا
بجدٍ ويحظون بمستقبلٍ لائق

211
00:11:14,650 --> 00:11:15,750
...فلنقم بهذا كما يجب

212
00:11:15,750 --> 00:11:16,610
كما يجب

213
00:11:17,170 --> 00:11:18,490
سنقوم بهذا بشكلٍ صحيح

214
00:11:18,820 --> 00:11:20,020
...سوف نعمل بجد

215
00:11:20,020 --> 00:11:21,110
...ونتغير...

216
00:11:23,290 --> 00:11:25,240
لكي يحبّنا الجميع...

217
00:11:25,810 --> 00:11:30,430
،وبعدها مرّت عشر سنوات غريبة
...وفي النهاية

218
00:11:57,020 --> 00:11:59,130
صباح الخير يا عزيزي

219
00:11:59,130 --> 00:12:00,540
!صباح الخير يا أبي

220
00:12:01,010 --> 00:12:02,570
صباح الخير

221
00:12:03,190 --> 00:12:06,570
.يا إلهي
إنّك تسكب الطعام في كل مكان

222
00:12:14,260 --> 00:12:15,790
حسنًا، سأذهب

223
00:12:16,290 --> 00:12:16,880
أوسوماتسو؟

224
00:12:20,260 --> 00:12:21,690
احظَ بيومٍ جيد

225
00:12:21,690 --> 00:12:22,630
سأفعل

226
00:12:27,850 --> 00:12:30,100
!مع السلامة يا أبي

227
00:12:31,100 --> 00:12:33,100
لقد أصبحتُ... شخصًا لائقًا

228
00:12:34,060 --> 00:12:37,610
منذ ذلك الوقت، عملتُ بشكلٍ لائق
وأصبحتُ رائعًا بشكلٍ لائق

229
00:12:37,610 --> 00:12:40,420
!أيها الرئيس ماتسونو! صباح الخير

230
00:12:40,420 --> 00:12:42,030
أترون؟ أنا أقوم بهذا بشكلٍ لائق

231
00:12:43,890 --> 00:12:45,700
انظروا. بشكلٍ لائق

232
00:12:46,740 --> 00:12:47,320
أجل

233
00:12:47,630 --> 00:12:48,980
أنا أقوم بهذا بشكلٍ لائق

234
00:12:51,460 --> 00:12:53,460
أنا شخصٌ لائقٌ جدًّا

235
00:12:53,910 --> 00:12:56,920
أنا أقوم بهذا بشكلٍ لائق. هذا رائع

236
00:12:57,780 --> 00:13:00,250
!أنت لها

237
00:12:58,820 --> 00:13:00,800
!أنا أقوم بهذا بشكلٍ لائق

238
00:13:00,800 --> 00:13:02,300
!أنا لها

239
00:13:05,300 --> 00:13:10,180
،واليوم وبعد وقتٍ طويل
سوف أجتمع مُجدّدًا مع الآخرين

240
00:13:11,030 --> 00:13:14,490
أنا واثقٌ أنّهم أصبحوا لائقين أكثر منّي حتّى

241
00:13:17,650 --> 00:13:19,980
!أنت... كاراماتسو

242
00:13:23,400 --> 00:13:27,160
!مذهل، هذا مدهش! لقد كبرت بشكلٍ لائق

243
00:13:32,090 --> 00:13:33,810
مـ-من هؤلاء؟

244
00:13:37,530 --> 00:13:38,290
!ماذا؟

245
00:14:01,520 --> 00:14:05,120
!إنّك تقوم بالأمر بشكلٍ لائق
أنت خيالٌ علميّ الآن يا كاراماتسو؟

246
00:14:05,120 --> 00:14:06,380
!إذًا فقد سلكتَ ذاك الطريق

247
00:14:06,380 --> 00:14:08,880
!لقد كبرتَ كثيرًا يا رجل

248
00:14:10,130 --> 00:14:12,770
!فهمت! إنّك تقوم بالأمر بشكلٍ لائق

249
00:14:12,770 --> 00:14:14,970
!أوسوماتسو-نيسان! كاراماتسو-نيسان

250
00:14:14,970 --> 00:14:15,700
مضى وقتٌ طويل

251
00:14:16,550 --> 00:14:18,460
!تشوروماتسو! توتوكو-تشان

252
00:14:22,410 --> 00:14:24,260
كيف حالك يا أوسوماتسو-كُن؟

253
00:14:24,780 --> 00:14:26,720
كيف حالك يا كاراماتسو-نيسان؟

254
00:14:30,590 --> 00:14:34,810
هذا صحيح. أنا وتوتوكو-تشان تبادلنا أجسادنا

255
00:14:35,750 --> 00:14:37,600
!إنهما يقومان بالأمر بشكلٍ لائق

256
00:14:37,600 --> 00:14:41,870
الفتيان والفتيات يتبادلون الأجساد؟
!إنكما تقومان بالأمر بشكلٍ لائق

257
00:14:46,180 --> 00:14:47,340
لقد عملنا بجد

258
00:14:48,330 --> 00:14:49,270
لقد عملنا بجدٍّ حقًّا

259
00:14:50,540 --> 00:14:51,620
!رفاق

260
00:14:52,830 --> 00:14:53,830
!إتشيماتسو؟

261
00:14:56,530 --> 00:15:01,420
رفاق، سوف أذهب للبحثِ عن المعبد الغامض

262
00:15:01,420 --> 00:15:04,840
الذي يُدعى بتحت النّبض ويقال أنّه في قعر البحر

263
00:15:04,840 --> 00:15:09,640
.لكن لا أحد من البالغين في السماء يُصدّقني
لهذا سوف أذهب لأجده

264
00:15:09,640 --> 00:15:11,930
،بسيفي وشغفي الأزليّ

265
00:15:11,930 --> 00:15:13,970
!سوف أضعُ نهايةً لمعركةِ الآلهة هذه

266
00:15:14,320 --> 00:15:16,220
!إنه يقوم بالأمر بشكلٍ لائق

267
00:15:16,220 --> 00:15:18,470
!مغامرة خيالية
!لا شكّ في ذلك

268
00:15:18,470 --> 00:15:20,530
!ذلك ناجح في كلّ الأجيال

269
00:15:20,530 --> 00:15:22,090
!لقد كبرتَ كثيرًا

270
00:15:22,090 --> 00:15:23,250
لقد عملتُ بجد

271
00:15:23,250 --> 00:15:24,260
فهمت

272
00:15:24,260 --> 00:15:26,110
!رفاق

273
00:15:27,130 --> 00:15:28,740
!جيوشيماتسو

274
00:15:44,890 --> 00:15:46,710
!إنه يقوم بالأمر بشكلٍ لائق

275
00:15:46,710 --> 00:15:50,530
!أصبحت ثلاثيَّ الأبعاد؟ هذا عظيم

276
00:15:50,530 --> 00:15:51,730
!عملتُ بجد

277
00:15:51,730 --> 00:15:53,550
فهمت

278
00:15:53,550 --> 00:15:54,340
!مرحبًا

279
00:15:54,980 --> 00:15:56,510
!تودوماتسو

280
00:15:58,260 --> 00:16:00,350
!إنه يقوم بالأمر بشكلٍ لائق

281
00:16:01,720 --> 00:16:02,850
أنا توتي

282
00:16:02,850 --> 00:16:04,450
!آسفٌ على التأخر

283
00:16:04,450 --> 00:16:07,590
عرضٌ حيّ؟
...هذه الهيئة الأخيرة إذًا

284
00:16:09,930 --> 00:16:12,390
!أنتم رائعون جميعًا
!أكاد لا أميّزكم

285
00:16:12,390 --> 00:16:13,780
!جميعنا نقوم بهذا بشكلٍ لائق

286
00:16:19,630 --> 00:16:20,910
!نقوم بهذا بشكلٍ لائق

287
00:16:21,380 --> 00:16:22,640
!نحن أشخاص لائقون

288
00:16:24,710 --> 00:16:27,790
!شييه! لم ينتهِ الأمر بعد

289
00:16:28,950 --> 00:16:29,500
...إنّه

290
00:16:33,170 --> 00:16:36,690
!أنا من سيسيطر على هذا العالم

291
00:16:36,690 --> 00:16:39,600
سوف نقتل أيّ من يقاوم أيها الأغبياء

292
00:16:42,300 --> 00:16:44,210
!ها أنت أيّها العدوّ اللّائق

293
00:16:44,210 --> 00:16:46,130
!حسنًا، فلنهزمه

294
00:16:46,130 --> 00:16:46,900
!أجل

295
00:16:47,730 --> 00:16:48,400
!هيا بنا

296
00:16:56,210 --> 00:16:59,830
!الإقلاع بشكلٍ لائق

297
00:17:00,180 --> 00:17:03,580
!ميكا لائق

298
00:17:13,310 --> 00:17:17,390
!تحوّل لائق

299
00:17:15,580 --> 00:17:20,680
انسجام العالم المستقرّ سيساندنا

300
00:17:18,220 --> 00:17:19,720
!اندماج بشكلٍ لائق

301
00:17:21,300 --> 00:17:22,860
!اندماج بشكلٍ لائق

302
00:17:21,300 --> 00:17:30,520
أطلقوا القوّة اللائقة للمستقبل

303
00:17:32,650 --> 00:17:35,610
اندمجوا بشكلٍ لائق

304
00:17:35,610 --> 00:17:37,570
بشكلٍ لائق، أجل

305
00:17:35,610 --> 00:17:40,030
!هجوم نهائيّ لائق

306
00:17:37,570 --> 00:17:43,150
سنغيّر كلّ شيء ولو أنفسنا

307
00:17:41,660 --> 00:17:46,020
!ما هذا أيها الأغبياء! تبًّا

308
00:17:43,150 --> 00:17:49,250
سنضع أيدينا على مستقبلٍ لائق

309
00:17:49,250 --> 00:17:50,790
!شيييه

310
00:17:49,330 --> 00:17:55,470
بحياتنا اللائقة

311
00:17:51,740 --> 00:17:56,470
!لدينا أزمة مؤقّتة لائقة

312
00:17:56,470 --> 00:17:59,660
!شييه

313
00:18:02,170 --> 00:18:04,970
!لكنّنا... سنهزمه بشكلٍ لائق

314
00:18:03,180 --> 00:18:04,970
تحوّل لائق

315
00:18:04,970 --> 00:18:06,680
!سنهزمه بشكلٍ لائق

316
00:18:05,620 --> 00:18:07,700
اركضوا بشكلٍ لائق

317
00:18:07,700 --> 00:18:17,010
حتّى نمسك بمستقبلنا اللائق

318
00:18:08,020 --> 00:18:14,310
!شـ-شيييه

319
00:18:23,180 --> 00:18:24,300
...وحينها

320
00:18:25,980 --> 00:18:30,310
سوف نتمهّل بشكلٍ لائق

321
00:18:34,990 --> 00:18:39,550
!نحن رائعون جدًّا

322
00:18:40,460 --> 00:18:44,140
!نحن مثاليون

323
00:19:02,700 --> 00:19:06,670
،وهكذا، أصبح التوائم الستّة لائقين بنجاح

324
00:19:06,670 --> 00:19:10,040
وولدوا من جديد ليصبحوا أنمي لائقًا ومذهلاً

325
00:19:11,210 --> 00:19:13,210
تطلّعوا للحلقة القادمة أيضًا رجاءً

326
00:19:25,630 --> 00:19:27,970
!حسنًا! فلنواصل العمل الجاد

327
00:19:27,970 --> 00:19:29,820
...هكذا، سيكون مستقبلنا

328
00:19:29,820 --> 00:19:35,400
!مضمونًا

329
00:19:35,400 --> 00:19:36,810
...هكذا

330
00:19:36,810 --> 00:19:38,440
!يجب أن يكون الأمر...

331
00:19:38,440 --> 00:19:41,300
!أنتم لستم لائقين البتّة أيّها الأنمي الرّديء

332
00:19:41,300 --> 00:19:42,450
!أنتم مخطئون

333
00:19:42,450 --> 00:19:44,050
!ماذا تقصدون بـ"لائق"؟

334
00:19:44,050 --> 00:19:46,210
!تمالكوا أنفسكم أيها الحثالة

335
00:19:46,210 --> 00:19:49,850
...بالتالي فالتوائم الستّة سيّئون إن أصبحوا متعجرفين

336
00:19:49,850 --> 00:19:52,380
وسيئّون حتّى لو قاموا بالأمور بشكلٍ لائق

337
00:19:52,380 --> 00:19:55,630
لقد تخبّطوا في متاهةٍ بدون أيّ مخرج

338
00:19:56,930 --> 00:19:58,350
...وبعدها

339
00:19:58,350 --> 00:20:00,370
أصبحوا كبارًا

340
00:20:00,370 --> 00:20:05,260
دون أن يعرفوا ما يجب عليهم
فعله ولا أين يجب أن يذهبوا

341
00:20:08,290 --> 00:20:12,640
...لا، لا، لا

342
00:20:10,310 --> 00:20:11,520
...لا، لا، لا، لا

343
00:20:13,710 --> 00:20:15,480
...لا، لا، لا، لا

344
00:20:19,070 --> 00:20:21,010
!صِدقًا! ماذا يجب أن نفعل؟

345
00:20:21,010 --> 00:20:23,080
!لم نتغيّر مطلقًا في النهاية

346
00:20:23,080 --> 00:20:25,240
!هنالك حلقة الأسبوع القادم أيضًا

347
00:20:25,240 --> 00:20:29,020
...أتعلمون

348
00:20:29,810 --> 00:20:31,900
لا نملك أيّ مستقبل أساسًا

349
00:20:34,990 --> 00:20:36,560
،بعد هذا وذاك

350
00:20:37,010 --> 00:20:41,260
قصّتهم على وشك أن تبدأ مجدّدًا

351
00:23:44,290 --> 00:23:46,730
مرحبًا! يجب أن نؤدّي العرض المسبق
بشكلٍ لائق على الأقل

352
00:23:46,730 --> 00:23:48,860
!ها هو الأول للأسبوع المقبل
—إنّه أخيرًا