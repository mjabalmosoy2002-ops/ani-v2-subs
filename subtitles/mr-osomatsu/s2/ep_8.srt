1
00:01:36,900 --> 00:01:39,030
!اكتمل أخيرًا

2
00:01:39,030 --> 00:01:44,290
!إنّه اختراع القرن
سأدمج بين شيئين على الفور

3
00:01:44,930 --> 00:01:48,270
المفاجئ-تشان رقم 1

4
00:01:50,210 --> 00:01:52,550
،أوّلًا نقوم بهذا

5
00:01:53,650 --> 00:01:55,030
...ثمّ هذا

6
00:01:56,910 --> 00:01:59,470
!ها نحن

7
00:02:31,190 --> 00:02:33,090
!لقد نجح

8
00:02:33,090 --> 00:02:36,090
!الأرز بالكاري فجأةً

9
00:02:36,090 --> 00:02:40,690
!سيدرّ عليّ هذا بالثراء
!عملي اليدويّ قد أتى بثماره أخيرًا

10
00:02:43,350 --> 00:02:45,630
!أنا سعيدٌ جدًّا

11
00:03:21,330 --> 00:03:23,470
اسمي ذبابان

12
00:03:27,350 --> 00:03:29,670
سرّني العمل معك

13
00:03:30,350 --> 00:03:33,390
...واحد، اثنان... واحد، اثنان

14
00:03:33,390 --> 00:03:36,120
!كفّ عن اختلاس النظر أيها الأحمق! انقلع

15
00:03:36,120 --> 00:03:37,360
...مؤلم

16
00:03:38,810 --> 00:03:41,820
!شيييه! ماذا ستفعلان بشأن هذا؟

17
00:03:41,820 --> 00:03:45,280
!أطالب بالتعويض! هذا افتراء

18
00:03:45,280 --> 00:03:47,180
!سلّمني تعويضات

19
00:04:04,020 --> 00:04:07,500
!شيييه! اسمي إياماتسو

20
00:04:11,020 --> 00:04:13,390
سرّني العمل معك

21
00:04:27,660 --> 00:04:30,380
!اسمي تشيبيبو، جو

22
00:04:30,380 --> 00:04:32,410
!ما هذا أيها الأنذال! اللعنة

23
00:04:33,290 --> 00:04:35,620
سرّني العمل معك

24
00:04:50,490 --> 00:04:52,110
!أرني ما لديك يا صاح

25
00:04:54,020 --> 00:04:56,100
سرّني العمل معك

26
00:05:06,620 --> 00:05:07,740
!بويه

27
00:05:10,340 --> 00:05:12,230
إنّنا وحش

28
00:05:14,630 --> 00:05:16,620
سرّنا العمل معك

29
00:05:26,150 --> 00:05:28,970
اسمي هاشيموتو نيانوسكي، مياو

30
00:05:28,970 --> 00:05:29,760
مياو

31
00:05:30,540 --> 00:05:32,390
سرّني العمل معك

32
00:05:46,030 --> 00:05:47,910
سرّني العمل معك

33
00:06:31,200 --> 00:06:34,890
!سأدمج المزيد

34
00:06:44,700 --> 00:06:50,030
!المزيد

35
00:06:53,930 --> 00:06:57,100
والآن سيكتمل الإله

36
00:07:35,750 --> 00:07:39,630
!اقترفتُ شيئًا فظيعًا

37
00:08:26,360 --> 00:08:30,890
لا، لستُ أفعل! بل أريد هذا العمل

38
00:08:30,890 --> 00:08:32,810
!لذا رجاءً

39
00:08:34,350 --> 00:08:37,370
!رجاءً

40
00:08:39,950 --> 00:08:44,030
عد إلى بيتك. هنالك أشياء في
هذا العالم تنجح بها إن حاولت

41
00:08:44,030 --> 00:08:45,820
لكن هنالك أشياء أخرى لا تنجح

42
00:08:45,820 --> 00:08:49,630
.وهذه الحالة من بين تلك الأشياء
لستَ ملائمًا لهذا العمل

43
00:08:49,630 --> 00:08:51,570
!لا تقولي هذا رجاءً

44
00:08:51,570 --> 00:08:52,840
إنها الحقيقة

45
00:08:52,840 --> 00:08:54,220
!لكن لماذا؟

46
00:08:54,220 --> 00:08:59,010
أقصد، قد أفهم إن أردتَ أن
،تصبح مدرّب دلافين مثلنا

47
00:08:59,010 --> 00:09:01,890
لكنّك تريد أن تصبح دلفينًا، صحيح؟

48
00:09:01,890 --> 00:09:03,790
تقصد دلفينًا حقيقيًّا، صحيح؟

49
00:09:05,230 --> 00:09:06,180
ذلك غير ممكن

50
00:09:08,090 --> 00:09:12,180
كلّا. ما دمتُ أبذل قصارى
!جهدي فسأنجح بطريقةٍ ما

51
00:09:11,390 --> 00:09:13,010
!كلّا، لن تفعل

52
00:09:13,010 --> 00:09:14,720
!هذا مستحيل كيفما فكّرت

53
00:09:14,720 --> 00:09:16,410
!وأطلب منكنّ ألّا تقلن ذلك

54
00:09:16,410 --> 00:09:19,780
!صِدقًا، لمَ دلفين؟
لمَ اخترتَ أن تصبح دلفينًا؟

55
00:09:19,780 --> 00:09:23,580
إن أردتَ أن تصبح مدرّبًا فنحن
!ينقصنا المدرّبون ونبحث عنهم

56
00:09:23,580 --> 00:09:27,960
لا. لا أملك أيّ اهتمام لأكون مدرّبًا لذا لا أستطيع

57
00:09:27,960 --> 00:09:29,860
أنت تغضبني بحق

58
00:09:32,190 --> 00:09:33,260
سأعمل بجد

59
00:09:33,260 --> 00:09:36,930
أنت إنسان! لن تستطيع أن تقوم
!بسباحة الظهر أو بالقفز العالي

60
00:09:36,930 --> 00:09:38,470
!بل أستطيع

61
00:09:38,470 --> 00:09:41,970
لماذا؟ لماذا تريد أن تصبح دلفينًا بشدّة؟

62
00:09:42,790 --> 00:09:44,170
...ذلك لأنّني

63
00:09:44,820 --> 00:09:46,140
عاطل

64
00:09:47,070 --> 00:09:51,450
،لـ-لأنّني عاطل
أريد أن أجد عملًا

65
00:09:51,450 --> 00:09:53,770
...أريد أن أكون قادرًا على جني المال بنفسي

66
00:09:54,790 --> 00:09:56,820
أجل، لكنّنا لا نشعر بالأسف عليك

67
00:09:56,820 --> 00:09:59,200
أنت عاطل لذا تريد عملًا؟

68
00:09:59,200 --> 00:10:01,050
لكن صِدقًا، لمَ تريد أن تصبح دلفينًا إذًا؟

69
00:10:01,050 --> 00:10:04,290
إن كان هذا هدفك فالأجدر بكَ أن تجدَ عملًا أوّلًا

70
00:10:04,290 --> 00:10:06,660
مع أنّه ما يزال مستحيلاً
!عليك أن تصبح دلفينًا

71
00:10:06,660 --> 00:10:07,830
!ليس مستحيلًا

72
00:10:07,830 --> 00:10:08,870
!اغرب عنّا

73
00:10:08,870 --> 00:10:10,310
!لا

74
00:10:11,290 --> 00:10:12,570
!انتظروا رجاءً

75
00:10:14,310 --> 00:10:18,450
أيتها القائدة، هلّا تركتني أتكفّل به لفترة؟

76
00:10:21,990 --> 00:10:24,650
،سأتكفّل بتدريبه

77
00:10:24,650 --> 00:10:28,980
وسأساعده على الظهور في عرض الدلافين كدلفين

78
00:10:38,150 --> 00:10:39,840
!هيّا، تنحّ عن الطريق

79
00:10:39,840 --> 00:10:40,940
!تحرك

80
00:10:41,870 --> 00:10:43,930
!أخوات الدلفين يعبرن

81
00:10:46,580 --> 00:10:51,920
المسبح يفوح برائحة البشر الكريهة يا أخواتي

82
00:10:52,310 --> 00:10:54,060
كم هذا مقرف

83
00:10:54,940 --> 00:10:56,930
لا بأس يا جيوشيماتسو-كُن

84
00:10:57,490 --> 00:10:59,170
فلنتدرّب سويًّا هنا

85
00:11:00,170 --> 00:11:01,340
حسنًا

86
00:11:04,420 --> 00:11:06,100
!تستطيع فعلها يا جيوشيماتسو-كُن

87
00:11:06,100 --> 00:11:09,930
تستطيع الدلافين أن تكبح أنفاسها
نحو خمسين دقيقة تحت الماء

88
00:11:09,930 --> 00:11:10,980
!تبقّت عشرون دقيقة فحسب

89
00:11:12,230 --> 00:11:14,860
!لا أستطيع... لا أستطيع التنفّس

90
00:11:14,860 --> 00:11:16,780
ماذا؟ لا تستطيع الاحتمال؟

91
00:11:16,780 --> 00:11:18,450
إذًا، فلتصعد للهواء بسرعة

92
00:11:18,450 --> 00:11:24,000
تستطيع الدلافين أن تملأ رئتيها
بالهواء الطلق بنسبة 90٪ بشهيقٍ واحد

93
00:11:24,000 --> 00:11:25,500
!مستعد؟ انطلق

94
00:11:27,620 --> 00:11:32,500
!جيوشيماتسو-كُن

95
00:11:37,750 --> 00:11:39,030
!انطلق

96
00:11:43,250 --> 00:11:45,660
اسبح من ذلك الاتجاه يا جيوشيماتسو-كُن

97
00:11:46,490 --> 00:11:48,870
!استخدم دلفينك الباطني! ركلة الدلفين

98
00:11:48,870 --> 00:11:51,730
!اشعر بالدلفين بكلّ جزءٍ من جسمك

99
00:11:51,730 --> 00:11:54,730
!أنت دلفين
!أنت دلفين يا جيوشيماتسو-كُن

100
00:11:55,150 --> 00:11:57,750
!جيوشيماتسو-كُن

101
00:12:00,270 --> 00:12:01,320
حسنًا، أمستعد؟

102
00:12:01,650 --> 00:12:02,370
خذ

103
00:12:05,530 --> 00:12:09,250
هيّا، عليك أن تبتلعها كلّها. مستعد؟

104
00:12:09,250 --> 00:12:13,570
خذ

105
00:12:14,420 --> 00:12:16,880
خذ، خذ، خذ، خذ

106
00:12:22,650 --> 00:12:25,760
بئسًا! لمَ لا تستطيع أن تقوم بهذا القدر على الأقل؟

107
00:12:25,760 --> 00:12:27,680
أسرع وأصدر صريرًا فوق صوتيّ

108
00:12:30,390 --> 00:12:32,770
!هيّا، أسرع
أنت دلفين، أليس كذلك؟

109
00:12:32,770 --> 00:12:34,980
أين صفيرك ونباحك؟

110
00:12:34,980 --> 00:12:37,480
!لمَ لا تستطيع إصدار تلك الأصوات؟ تبًّا

111
00:12:37,480 --> 00:12:39,950
!جيوشيماتسو-كُن أيها الغبيّ

112
00:12:41,030 --> 00:12:42,100
!اذهب

113
00:12:43,930 --> 00:12:44,950
!حسنًا

114
00:12:46,780 --> 00:12:48,210
تفضل مكافأتك

115
00:12:48,830 --> 00:12:51,500
!هيّا اعتدل يا جيوشيماتسو

116
00:12:52,300 --> 00:12:55,750
!جيوشيماتسو

117
00:12:55,750 --> 00:12:58,840
!أنت أصلب ممّا توقعت

118
00:13:01,290 --> 00:13:05,970
شييييه! هل تتدرّبن بجدّ جميعًا؟

119
00:13:05,970 --> 00:13:09,930
إن أخفقتنّ أمام المدير فسأتعامل معكنّ

120
00:13:12,410 --> 00:13:14,670
ابدأ الاختبار متى أردت رجاءً

121
00:13:14,670 --> 00:13:16,350
أواثقة؟

122
00:13:16,760 --> 00:13:18,440
!شكرًا على وقتك

123
00:13:21,780 --> 00:13:24,520
ابدأن الاختبار

124
00:13:24,520 --> 00:13:26,280
!سأبدأ أوّلًا

125
00:13:26,280 --> 00:13:27,630
!اقفز

126
00:13:28,500 --> 00:13:30,080
جيد جدًّا

127
00:13:30,080 --> 00:13:30,970
!اذهب

128
00:13:30,970 --> 00:13:32,260
!انطلق

129
00:13:35,300 --> 00:13:38,050
!شيييه! مذهل

130
00:13:39,390 --> 00:13:42,000
جيّد جدًّا. جميعكنّ ماهرات للغاية

131
00:13:42,000 --> 00:13:44,950
سنحقّق نجاحًا باهرًا مجدّدًا، أليس كذلك؟

132
00:13:44,950 --> 00:13:47,250
!جيوشيماتسو، انطلق

133
00:13:48,620 --> 00:13:50,430
ماذا؟

134
00:13:50,930 --> 00:13:54,620
حان الوقت لتستعرض كلّ
!عملك الجاد يا جيوشيماتسو

135
00:14:06,820 --> 00:14:07,740
!اذهب

136
00:14:17,750 --> 00:14:19,710
سأعلن عن النتائج الآن

137
00:14:20,620 --> 00:14:22,410
أنتما الوحيدان اللذان فشلا

138
00:14:22,410 --> 00:14:23,930
!ماذا؟

139
00:14:23,930 --> 00:14:24,730
!محال

140
00:14:24,730 --> 00:14:25,370
!لماذا؟

141
00:14:25,370 --> 00:14:26,900
!شيييه

142
00:14:29,050 --> 00:14:33,100
!سأغرق! هذا المسبح عميق

143
00:14:33,100 --> 00:14:34,890
لا تبدو الدلافين بهذا الشكل

144
00:14:34,890 --> 00:14:36,700
!أنت مطرود

145
00:14:41,030 --> 00:14:46,280
...لماذا؟ لقد عملتُ بجدّ
لقد بذلتُ أفضل ما أستطيع

146
00:14:46,970 --> 00:14:52,150
لا يا جيوشيماتسو-كُن. لأكون
صادقةً معك، أظنّك أخفقتَ أيضًا

147
00:14:52,150 --> 00:14:52,810
ماذا؟

148
00:14:53,310 --> 00:14:55,570
لستَ دلفينًا إطلاقًا

149
00:14:55,570 --> 00:14:58,430
ظننتُ أنّني أراقب تلميذًا ابتدائيًّا يتعلّم السباحة

150
00:15:00,650 --> 00:15:03,820
لكن ألم يكن التدريب غريبًا بعض الشيء كذلك؟

151
00:15:03,820 --> 00:15:05,030
هذا صحيح أيضًا

152
00:15:07,670 --> 00:15:12,180
هذا مستحيل فحسب. لقد دفعني
...شغفك لذا حاولتُ مساعدتك، لكن

153
00:15:12,800 --> 00:15:14,830
ليس من الممكن عليك أن تصبح دلفينًا فحسب

154
00:15:16,290 --> 00:15:17,430
فلنعد إلى البيت

155
00:15:17,430 --> 00:15:19,530
لا، سأتدرّب

156
00:15:19,530 --> 00:15:20,890
لا فائدة

157
00:15:20,890 --> 00:15:22,730
!لقد فشلتُ في الاختبار مرّةً واحدة

158
00:15:22,730 --> 00:15:25,520
!هذا مستحيل! أنت لستَ دلفينًا

159
00:15:25,520 --> 00:15:27,850
!اخرسي! بل سأفعل هذا

160
00:15:27,850 --> 00:15:28,890
!استسلم

161
00:15:28,890 --> 00:15:29,440
!لا

162
00:15:29,440 --> 00:15:30,570
!تقبّل الواقع وحسب

163
00:15:30,570 --> 00:15:34,490
!كلّا! لن أتخلّى عن أحلامي أبدًا

164
00:15:37,130 --> 00:15:38,230
أيها الأبله

165
00:15:39,070 --> 00:15:40,270
!افعل ما شئت

166
00:16:07,020 --> 00:16:09,180
من السّيئ أن نضطرّ للعمل في أيّام العطلة

167
00:16:09,180 --> 00:16:10,280
أنا مرهقة

168
00:16:12,770 --> 00:16:13,550
أطبّاء

169
00:16:16,150 --> 00:16:18,030
ما ذلك؟

170
00:16:24,010 --> 00:16:28,170
إنها تقفز... لكن ليس هنالك جمهور

171
00:16:31,020 --> 00:16:32,290
!هيا

172
00:16:32,290 --> 00:16:33,300
!هنا

173
00:16:36,090 --> 00:16:37,690
!انطلقي

174
00:16:56,770 --> 00:16:58,170
!لم ننتهِ بعد

175
00:17:01,620 --> 00:17:04,610
!ها أنا ذا

176
00:17:08,000 --> 00:17:11,130
!شيييه! أوقفنه على الفور

177
00:17:15,810 --> 00:17:18,300
نـ-نـ-نـ-نـ-نرجو منكم أن تتجاهلوا كلّ شيء من الآن

178
00:17:18,300 --> 00:17:19,410
!ابتعدن

179
00:17:19,410 --> 00:17:25,060
جميعًا! هذا برنامج خاص من قِبل
!دلفيننا الجديد، جيوشيماتسو

180
00:17:25,430 --> 00:17:31,630
،إنّه جديد، لذا قد لا يكون الأفضل
!لكن أرجو منكم أن تستقبلوه بشكلٍ حار

181
00:17:37,220 --> 00:17:43,060
!هيا يا جيوشيماتسو-كُن. قم بكلّ ما تستطيع الآن

182
00:18:03,730 --> 00:18:07,640
لـ-لقد فعلها حقًّا! مـ-ما الذي يجري؟

183
00:18:11,180 --> 00:18:13,990
مـ-مذهل! تبدو كواحد

184
00:18:13,990 --> 00:18:16,620
!تبدو كدلفين يا جيوشيماتسو-كُن

185
00:18:21,870 --> 00:18:23,860
!مهلًا، مهلًا، ماذا؟

186
00:18:24,340 --> 00:18:25,330
ما هذا؟

187
00:18:29,370 --> 00:18:31,930
!توقفي عن ذلك! توقفي

188
00:18:31,930 --> 00:18:33,290
!توقفي

189
00:18:39,860 --> 00:18:41,890
!شييييه

190
00:18:43,990 --> 00:18:44,850
...انطلق

191
00:18:48,020 --> 00:18:50,830
!انطلق

192
00:21:45,860 --> 00:21:51,830
الأودِن الهجين

193
00:21:53,930 --> 00:21:55,790
مساء الخير يا تشيبيتا-كُن

194
00:21:55,790 --> 00:21:58,620
!توتوكو-تشان! لقد أتيت

195
00:21:58,960 --> 00:22:00,070
!شكرًا

196
00:22:17,370 --> 00:22:18,020
!لذيذ

197
00:22:21,420 --> 00:22:22,150
!لذيذ

198
00:22:25,490 --> 00:22:30,130
.هذا مفاجئ
لم أتوقع أن أراك تشربين لوحدك

199
00:22:30,130 --> 00:22:34,390
أجل، أحيانًا. أظنّني لم أخبرك قط

200
00:22:35,160 --> 00:22:37,490
أجل، لم تخبريني من قبل

201
