1
00:01:36,580 --> 00:01:38,280
!سئمتُ من هذا العالم

2
00:01:38,280 --> 00:01:40,690
يا إلهي. ماذا يجب أن نفعل؟

3
00:01:43,080 --> 00:01:44,140
!أيّها الضّابط

4
00:01:44,620 --> 00:01:47,570
!لدينا مشكلة! أحدهم يحاول أن يقفز

5
00:01:47,570 --> 00:01:48,580
!انظر! هناك في الأعلى

6
00:01:50,350 --> 00:01:52,340
.لا يوجد ما يمكنني فعله

7
00:01:53,930 --> 00:01:55,920
.مهلًا، مهلًا. عليك أن توقفه

8
00:01:55,920 --> 00:01:57,710
!سيموت على هذا الحال

9
00:01:57,710 --> 00:01:59,070
.لا يوجد ما يمكنني فعله

10
00:01:59,070 --> 00:02:00,090
!بالطّبع يوجد

11
00:02:00,370 --> 00:02:01,680
!أسرع! استخدم هذا

12
00:02:03,170 --> 00:02:04,520
ماذا؟

13
00:02:06,660 --> 00:02:08,700
.حسنًا... أنت هناك

14
00:02:11,130 --> 00:02:13,760
.أنت هناك. لا ترتكب أيّ فعل غبيّ

15
00:02:13,760 --> 00:02:15,530
!اخرس! سأنهي كلّ شيء فحسب

16
00:02:15,530 --> 00:02:19,030
.لا تفعل. ستجعل الأمور مضطّربة. لا يوجد ما يكمننا فعله

17
00:02:19,030 --> 00:02:22,890
!ماذا تقصد؟! وكأنّك تستطيع فهم ألمي

18
00:02:22,890 --> 00:02:25,120
.أشعر بالوحدة في العمل

19
00:02:25,370 --> 00:02:28,930
.حقًّا؟ لا يوجد ما يمكنك فعله إذًا. بادر واقفز

20
00:02:29,830 --> 00:02:32,560
...ثلاثة، اثنان، واحد

21
00:02:32,560 --> 00:02:35,830
!لمَ تعدّ تنازلًا؟! أخبرناك أن توقفه

22
00:02:35,830 --> 00:02:37,040
.لا يوجد ما يمكنني فعله

23
00:02:37,040 --> 00:02:38,170
!أقنعه بالتّراجع

24
00:02:38,170 --> 00:02:39,470
!أنت ضابط شرطة، أليس كذلك؟

25
00:02:39,850 --> 00:02:41,410
.لا يوجد ما يمكنني فعله على ما أظنّ

26
00:02:47,060 --> 00:02:48,690
لمَ تقفز أنت؟

27
00:02:48,690 --> 00:02:50,020
.لا يوجد ما يمكنني فعله

28
00:02:50,020 --> 00:02:50,770
!ماذا تقصد؟

29
00:02:51,050 --> 00:02:52,560
.لا يوجد ما يمكننا فعله

30
00:02:53,790 --> 00:02:55,280
!لمَ نقفز جميعًا؟

31
00:02:55,280 --> 00:02:56,980
!هذا عابث! دعنا لا نفعل

32
00:02:56,980 --> 00:02:58,570
لكن لا يوجد ما يمكننا فعله، صحيح؟

33
00:02:59,450 --> 00:03:01,230
!لا عليك! لا تتدخّل فحسب

34
00:03:02,190 --> 00:03:03,280
!أنت

35
00:03:03,810 --> 00:03:05,700
.جميعنا نمرّ بوقت عصيب الآن

36
00:03:05,700 --> 00:03:07,000
!تشجّع

37
00:03:07,000 --> 00:03:10,210
.أنا واثق أنّك تستطيع أن تبلي كما الجميع

38
00:03:10,500 --> 00:03:12,220
!تحلّ بالمزيد من الثّقة في نفسك

39
00:03:12,970 --> 00:03:14,440
!اخرس

40
00:03:14,440 --> 00:03:17,050
!الأشخاص من أمثالك هم من يجعلونني أريد الموت

41
00:03:17,510 --> 00:03:21,210
!الجميع مماثلون؟ بل ذلك الهراء مؤلم لأنّ الجميع مختلفون

42
00:03:21,760 --> 00:03:23,860
.اقفز أنت

43
00:03:23,860 --> 00:03:24,580
!ماذا؟

44
00:03:24,580 --> 00:03:25,610
!مت! اقفز

45
00:03:25,610 --> 00:03:26,720
!توقّف

46
00:03:26,970 --> 00:03:28,150
.لا يوجد ما يمكنني فعله إذًا

47
00:03:28,150 --> 00:03:29,190
.أظنّني سأقفز

48
00:03:29,190 --> 00:03:30,320
!لا تفعل رجاءً

49
00:03:30,320 --> 00:03:31,430
.يمكننا أن نقفز جميعًا إذًا

50
00:03:31,430 --> 00:03:32,810
!لماذا؟

51
00:03:38,360 --> 00:03:39,650
.شكرًا جزيلًا

52
00:03:40,200 --> 00:03:42,610
.منحتني سببًا أعيش لأجله

53
00:03:43,390 --> 00:03:46,880
.لا يوجد ما يمكنني فعله بشأن ذلك ولم أفعل

54
00:03:46,880 --> 00:03:48,700
.أنت من اتّخذ هذا القرار

55
00:03:53,140 --> 00:03:55,150
!أتسوشي-كن

56
00:03:55,150 --> 00:03:57,400
!قلقتُ كثيرًا

57
00:03:58,500 --> 00:04:00,460
ومن هذه؟

58
00:04:01,740 --> 00:04:03,000
.حبيبتي

59
00:04:04,610 --> 00:04:05,990
!مهلًا، مهلًا، مهلًا

60
00:04:05,990 --> 00:04:10,730
!لا يوجد ما يمكننا فعله بشأن ذلك

61
00:04:07,210 --> 00:04:08,220
!أجل

62
00:04:26,850 --> 00:04:30,540
!أنا مسرور لأنّك عدت إلى البيت. ما هذا؟! سيّدي، أيّها الغبيّ

63
00:04:34,960 --> 00:04:37,850
.سأكون من يطعمك اليوم

64
00:04:37,850 --> 00:04:40,960
.أنا تشيبيتا موي موي الظّريفة ذات الرّأس الحجريّ

65
00:04:43,140 --> 00:04:46,730
.دعنا نقوم بموي موي وكيون كيون ونشفى معًا

66
00:04:48,970 --> 00:04:50,310
!تفضّل قائمتك

67
00:04:50,310 --> 00:04:51,900
.هذه مياو مياو دايكيون

68
00:04:51,900 --> 00:04:53,130
.بعض البيض الفرفوش

69
00:04:53,130 --> 00:04:54,630
.والكيونياك الموي موي

70
00:04:54,630 --> 00:04:56,720
.ولحم البقر المو مو

71
00:04:56,720 --> 00:05:00,030
.وبعض التشيكوا-تان الموي موي مياو مياو

72
00:05:05,360 --> 00:05:08,170
.والآن سأضيف تعويذة لهذا المشروب وأجعله لذيذًا زيادةً

73
00:05:08,170 --> 00:05:11,410
.سيّدي، كرّر خلفي رجاءً

74
00:05:15,540 --> 00:05:16,460
ماذا؟

75
00:05:18,640 --> 00:05:19,830
ماذا؟

76
00:05:22,080 --> 00:05:22,960
!أيّها الغبيّ

77
00:05:24,170 --> 00:05:25,470
!سحقًا

78
00:05:26,970 --> 00:05:30,110
!ما هذا؟! أيّها الغبيّ! سحقًا

79
00:05:30,110 --> 00:05:31,640
!موي موي

80
00:05:31,900 --> 00:05:35,140
!والآن، لنرَ اللّون الّذي تحوّل له مشروبك

81
00:05:36,250 --> 00:05:37,410
!إنّه بنيّ

82
00:05:37,410 --> 00:05:39,060
!إنّه حساء الأودن

83
00:05:39,420 --> 00:05:41,930
!موي موي! موي موي

84
00:05:45,920 --> 00:05:47,610
.لا شيء يدلّ على "مقهى الخادمة" كالالتقاط الصّور

85
00:05:49,740 --> 00:05:51,450
.تفضّل يا سيّدي

86
00:05:51,900 --> 00:05:53,630
.أعطني 5،000 ين أيّها الغبيّ

87
00:05:55,230 --> 00:05:58,120
!لا شيء يدلّ على "مقهى الخادمة" كالألعاب المسليّة

88
00:05:58,980 --> 00:06:00,000
.كابو

89
00:06:00,730 --> 00:06:01,880
.إينوشيكاتشو

90
00:06:03,130 --> 00:06:04,800
!نرد متطابق! ثلاث مرّات

91
00:06:07,890 --> 00:06:09,720
!سأغنّي

92
00:06:11,590 --> 00:06:17,600
!بيض، كونياك، دايكون، تشيكاوابو

93
00:06:17,600 --> 00:06:20,110
لنتناول بعض الأودن السّاخن

94
00:06:20,110 --> 00:06:22,820
!ماذا؟! أيّها الغبيّ! سحقًا

95
00:06:22,820 --> 00:06:24,230
لا بأس إن كنت صغيرة

96
00:06:24,230 --> 00:06:25,610
لا بأس إن كنت صلعاء

97
00:06:25,610 --> 00:06:29,900
ما زلتُ خادمة في هذا المسرح

98
00:06:29,900 --> 00:06:35,370
!بيض، كونياك، دايكون، تشيكوابو

99
00:06:35,370 --> 00:06:38,370
!سحقًا

100
00:06:39,720 --> 00:06:41,250
هلّا سمحت لي يا فضيلة القاضي؟

101
00:06:42,130 --> 00:06:44,840
.فظاظة المدّعى عليه سافلة بحقّ

102
00:06:45,180 --> 00:06:47,970
.لا يمانع مطلقًا إطلاق الرّيح بوجود النّاس من حوله

103
00:06:48,400 --> 00:06:50,790
!حتّى بينما نأكل

104
00:06:54,020 --> 00:06:57,450
.وأحيانًا يطلق الرّيح على أنفك بينما يسير

105
00:06:58,270 --> 00:07:03,550
!يطالب الادّعاء بتعويض للأضرار قدره 100،000 ين

106
00:07:03,550 --> 00:07:04,580
!مئة ألف ين؟

107
00:07:09,970 --> 00:07:11,600
!كما أنّه يزعجنا

108
00:07:11,600 --> 00:07:13,110
!يفعل هذا طوال الوقت

109
00:07:15,380 --> 00:07:18,500
.فضيلتك، أطالب بمداولة عادلة

110
00:07:21,050 --> 00:07:22,000
.إعدام

111
00:07:26,580 --> 00:07:27,380
فضيلتك؟

112
00:07:31,470 --> 00:07:32,240
.إعدام

113
00:07:33,890 --> 00:07:36,930
.حتّى الادّعاء لم يطلب بتلك العقوبة

114
00:07:36,930 --> 00:07:37,850
.إعدام

115
00:07:39,670 --> 00:07:40,920
!أنا نادم على أفعالي

116
00:07:42,000 --> 00:07:43,820
...كنتُ أحمقًا

117
00:07:44,300 --> 00:07:45,910
.استغللت عائلتي

118
00:07:46,890 --> 00:07:48,250
!سامحوني رجاءً

119
00:07:48,810 --> 00:07:50,900
!أنا آسف حقًّا

120
00:07:51,540 --> 00:07:53,330
هل أنت نادم على أفعالك حقًّا؟

121
00:07:53,330 --> 00:07:54,260
!أجل

122
00:07:54,260 --> 00:07:57,300
لن تطلق الرّيح ثانيةً عندما لا ينبغي عليك ذلك؟

123
00:07:57,300 --> 00:07:58,530
!لن أفعل

124
00:07:59,630 --> 00:08:00,500
.فضيلتك

125
00:08:00,760 --> 00:08:04,440
،يبدو أنّ المدّعى عليه نادم حقًّا على أفعاله

126
00:08:04,440 --> 00:08:07,650
.لذا يرغب الادّعاء سحب التّهمة

127
00:08:10,350 --> 00:08:10,920
.إعدام

128
00:08:12,480 --> 00:08:13,470
...فضيلتك

129
00:08:17,440 --> 00:08:18,010
.إعدام

130
00:08:18,220 --> 00:08:21,520
...لا، مهلًا. لقد سامحه الادّعاء

131
00:08:21,760 --> 00:08:24,500
.جيّد. لكنّي لن أسامحه أبدًا

132
00:08:27,110 --> 00:08:28,820
.يقول ذلك الآن فحسب

133
00:08:28,820 --> 00:08:29,980
.سيكرّرها

134
00:08:29,980 --> 00:08:32,880
.بربّكم. لا يتغيّر النّاس بهذه السّهولة

135
00:08:33,120 --> 00:08:35,240
.المشاكل تظلّ مشاكل

136
00:08:35,240 --> 00:08:38,490
"هل تغيّر حقًّا؟ هل تحسّن حاله؟"

137
00:08:40,520 --> 00:08:42,500
...من نتعرّض للأذى عندما لا يتغيّر بتاتًا، لذا

138
00:08:43,010 --> 00:08:43,870
!إعدام

139
00:08:46,050 --> 00:08:46,850
شاهد؟

140
00:08:50,820 --> 00:08:54,420
.هذا خطأ عائلته جزئيًّا لأنّهم لم يؤدّبوه كما يجب

141
00:08:54,420 --> 00:08:55,930
.نحن ملامون أيضًا

142
00:08:56,480 --> 00:08:58,580
.لكنّه ليس حثالة بالكامل

143
00:08:58,580 --> 00:09:01,560
—التّواجد معه مرح، لذا آمل

144
00:09:01,560 --> 00:09:02,170
.إعدام

145
00:09:04,550 --> 00:09:05,800
ثمّة الكثير من الأشخاص

146
00:09:05,800 --> 00:09:09,020
.الّذين ليسوا حثالة بالكامل والتّواجد معهم مرح

147
00:09:09,420 --> 00:09:13,340
.ثمّة الكثير من النّاس الجيّدون، مع أنّ عائلاتهم سيّئة

148
00:09:13,340 --> 00:09:13,990
.إعدام

149
00:09:15,970 --> 00:09:17,930
.حسنًا. لننفّذ هذا الحكم

150
00:09:16,650 --> 00:09:19,450
!ماذا؟ مهلًا

151
00:09:17,930 --> 00:09:19,450
!هل ستنفّذه بنفسك؟

152
00:09:19,680 --> 00:09:21,220
!أرجوك! أعطني فرصة أخرى

153
00:09:21,220 --> 00:09:23,620
.لا يمكن

154
00:09:22,110 --> 00:09:24,330
!فرصة واحدة

155
00:09:26,240 --> 00:09:27,600
هل أنت نادم حقًّا؟

156
00:09:27,600 --> 00:09:30,600
!أ-أجل! أعدكم أنّني لن أضرط عشوائيًّا ثانيةً أبدًا

157
00:09:30,600 --> 00:09:32,250
!يمكنني أن أتغيّر

158
00:09:33,690 --> 00:09:35,290
.حسنًا

159
00:09:37,460 --> 00:09:38,030
.إعدام

160
00:09:38,030 --> 00:09:38,890
!ماذا؟

161
00:09:44,360 --> 00:09:46,810
.أظنّ أنّ بعض الأشخاص لا يتسامحون أبدًا

162
00:09:54,700 --> 00:09:56,980
!مرحبًا! هذا أنا، تشوروماتسو

163
00:09:56,980 --> 00:09:58,590
!تحوّلتُ إلى بعوضة

164
00:10:01,330 --> 00:10:03,700
تسألون كيف انتهى بي المطاف كبعوضة؟

165
00:10:03,700 --> 00:10:04,790
...في الواقع

166
00:10:05,370 --> 00:10:08,080
.تبًّا. لا يمكنني أن أصبح ذا شعبيّة

167
00:10:08,080 --> 00:10:13,120
أريد أن أقابل بعض الفتيات ونتحدّث
!ونمسك بيد بعضنا ونخرج في مواعيد

168
00:10:15,520 --> 00:10:18,130
.رغباتي الجنسيّة تتفاقم

169
00:10:21,930 --> 00:10:24,260
!ماذا؟ تحوّلت إلى بعوضة

170
00:10:25,910 --> 00:10:29,320
!والآن يمكنني أن أشرب دم قدر ما أريد من الفتيات

171
00:10:29,320 --> 00:10:30,810
!لذيذ

172
00:10:30,810 --> 00:10:33,210
.لذيذ! أحببته

173
00:10:34,810 --> 00:10:37,380
.هل تضايقتم؟ وأنا أيضًا

174
00:10:37,380 --> 00:10:38,720
.هذا منحرف حقًّا

175
00:10:39,090 --> 00:10:41,260
لكنّي بعوضة، لذا ماذا ستفعلون؟

176
00:10:45,930 --> 00:10:47,440
!عجبًا! إنّها توتوكو-تان

177
00:10:47,440 --> 00:10:51,720
!أظنّني سأتذوّق من ساقيها الفاضحتين

178
00:10:58,970 --> 00:11:00,440
.لا فائدة. لا أستطيع

179
00:11:00,440 --> 00:11:03,530
...لا أستطيع فعل هذا! النّدم

180
00:11:03,530 --> 00:11:05,810
.أشعر بتوتّر شديد! ساقاي ترتعشان

181
00:11:06,280 --> 00:11:08,730
!ماذا تفعل يا تشوروماتسو؟ اذهب

182
00:11:08,730 --> 00:11:10,770
!أنت منحرف، أليس كذلك؟ اذهب واشرب

183
00:11:11,040 --> 00:11:12,440
...لـ-لكن

184
00:11:12,440 --> 00:11:15,650
.يفترض بك أن تشرب. أنت بعوضة

185
00:11:16,400 --> 00:11:17,480
.صحيح

186
00:11:17,480 --> 00:11:18,570
!والآن اذهب واشرب

187
00:11:18,570 --> 00:11:19,110
!سأفعل

188
00:11:22,590 --> 00:11:24,580
...لا أستطيع فحسب

189
00:11:25,490 --> 00:11:28,300
.توتوكو-تشان، انتظري

190
00:11:28,300 --> 00:11:30,250
...ساقاي المفضوحتان الثّمينتان

191
00:11:30,750 --> 00:11:33,420
!سحقًا! سحقًا لكلّ شيء

192
00:11:34,310 --> 00:11:37,230
.لكنّي بعوضة بالفعل، لذا أريد أن أشرب بعض الدّم

193
00:11:37,230 --> 00:11:38,460
.لا يوجد ما يمكنني فعله

194
00:11:38,820 --> 00:11:40,510
.عليّ أن أرضى به

195
00:11:42,580 --> 00:11:44,000
!مذاقه فظيع

196
00:11:47,450 --> 00:11:48,130
.تبًّا

197
00:11:54,220 --> 00:11:58,370
!أيّها العمّ أوسوماتسو، لنلعب

198
00:12:00,420 --> 00:12:02,170
أنتم مجدّدًا أيّها الأشقياء؟

199
00:12:02,170 --> 00:12:03,610
!العمّ أوسوماتسو

200
00:12:03,610 --> 00:12:06,020
.نهيتكم عن القدوم إلى هنا

201
00:12:06,020 --> 00:12:08,490
.فأنا خطير للغاية

