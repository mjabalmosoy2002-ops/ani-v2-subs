1
00:00:05,060 --> 00:00:07,130
."الأنمي التّلفزيّ، "أوسوماتسو-سان

2
00:00:07,700 --> 00:00:13,240
...إن أردنا وصف هذا الأنمي فسنعتبره رائعًا وغير مؤذي

3
00:00:13,240 --> 00:00:15,260
،سلسلة ما كانت لتؤذي حتّى ذبابة

4
00:00:15,260 --> 00:00:18,420
.بحيث أنّ جميع الشّخصيّات مضبوطة بشكل جيّد

5
00:00:18,420 --> 00:00:21,090
عرض تعليميّ ممتاز لأجل الصّغار

6
00:00:21,090 --> 00:00:24,660
.والّذي قد يُنصح به أو خلافه من قِبل مكست

7
00:00:21,090 --> 00:00:26,000
مكست: وزارة التعليم والثقافة والرياضة والعلوم والتقنية اليابانيّة

8
00:00:24,660 --> 00:00:30,460
!الأنمي المثاليّ الّذي سيحرّك مشاعرك لا محالة

9
00:00:30,950 --> 00:00:33,880
ونجد في جذور هذه السّلسلة

10
00:00:33,880 --> 00:00:37,520
!توائم ماتسونو الستّة المرموقين للغاية

11
00:00:41,440 --> 00:00:43,770
!مرحبًا يا رفاق! مضى وقتٌ طويل

12
00:00:44,090 --> 00:00:45,810
!اشتقنا لكم

13
00:00:46,540 --> 00:00:48,410
.اسمي أوسوماتسو

14
00:00:50,600 --> 00:00:51,190
!تشوروماتسو

15
00:00:51,470 --> 00:00:52,160
!إتشيماتسو

16
00:00:52,160 --> 00:00:52,910
!جيوشيماتسو

17
00:00:52,910 --> 00:00:53,610
!تودوماتسو

18
00:00:53,910 --> 00:00:56,010
!نحن ستّة توائم متفاهمون دائمًا

19
00:00:56,010 --> 00:00:57,870
!نأمل أن تستمتعوا بالعرض

20
00:00:57,870 --> 00:00:59,760
!أتى الموسم الثّالث أخيرًا

21
00:00:59,760 --> 00:01:01,080
!أنا متحمّسة حقًّا

22
00:01:06,350 --> 00:01:07,190
من هؤلاء؟

23
00:01:07,960 --> 00:01:11,750
!عجبًا، إنّهم مضبوطين جيّدًا! هذا يبعث الطمأنينة

24
00:01:11,750 --> 00:01:15,210
!إنّهم يقبلون بعضهم جميعًا! كم هم رائعون

25
00:01:16,020 --> 00:01:18,550
!كما أنّهم يسعون لتحقيق المساواة بين الجنسين

26
00:01:19,050 --> 00:01:21,510
!وها قد أصبحوا عالميّين

27
00:01:21,510 --> 00:01:25,690
!نحن التّوائم الستّة الـ18 الجدد الّذين نلبّي جميع طلباتكم

28
00:01:25,690 --> 00:01:27,350
!استمتعوا بالعرض

29
00:01:27,350 --> 00:01:30,670
!شملنا كلّ شيء في الموسم الثّالث! سيحقّق نجاحًا باهرًا

30
00:01:30,670 --> 00:01:32,880
!مرحى! مرحى

31
00:01:32,880 --> 00:01:38,290
!مرحى! مرحى! مرحى! مرحى

32
00:01:33,070 --> 00:01:35,110
!لم يعد هذا "أوسوماتسو-سان" حتّى

33
00:01:35,110 --> 00:01:37,130
!وما معنى "توائم ستّة 18" أساسًا؟

34
00:01:37,130 --> 00:01:38,700
!كما أنّنا متطابقون

35
00:01:39,050 --> 00:01:40,570
!من هم بالضّبط؟

36
00:01:41,300 --> 00:01:44,090
،اسمعوا، إن كنتم ستغيّرون كلّ شيء هكذا

37
00:01:44,090 --> 00:01:46,930
أنا واثق أنّ ذلك سيزعج أكاتسكا-سينسي
.الّذي ألّف السّلسلة الأصليّة

38
00:01:48,120 --> 00:01:49,800
!من ذلك بالضّبط؟

39
00:01:50,920 --> 00:01:52,460
!مصيبة

40
00:01:53,520 --> 00:01:55,630
!إنّها مصيبة حقًّا

41
00:01:57,600 --> 00:01:59,890
!إنّها مصيبة يا إخواني الحقيقيّين

42
00:02:00,240 --> 00:02:02,100
،بدأ الأنمي خاصّتنا بالفعل

43
00:02:02,100 --> 00:02:06,520
!واستولى مجموعة من الأشخاص الغريبين على أماكننا

44
00:02:06,520 --> 00:02:08,590
!هذا سيّئ! عليكم أن تأتوا معي

45
00:02:09,880 --> 00:02:11,520
ماذا؟ ما الخطب؟

46
00:02:13,050 --> 00:02:14,280
.هذا سيّئ

47
00:02:14,280 --> 00:02:16,750
.إنّنا نمضي كلّ يوم من دون فعل أيّ شيء

48
00:02:16,750 --> 00:02:20,060
...كنتُ أضيّع الوقت هنا البارحة أيضًا

49
00:02:20,610 --> 00:02:23,540
.في الواقع، كنتُ هنا ما قبل البارحة أيضًا

50
00:02:23,540 --> 00:02:26,170
.أظنّني كنتُ هنا في اليوم الّذي سبق ذلك أيضًا

51
00:02:34,270 --> 00:02:35,800
.صنعتُ قطًّا

52
00:02:39,750 --> 00:02:41,300
مـ-ما العمل؟

53
00:02:43,520 --> 00:02:45,560
.علينا أن نعرف ما يجب أن نفعل قريبًا

54
00:02:46,000 --> 00:02:48,600
.أتساءل فيمَ يفكّر والدانا

55
00:02:48,600 --> 00:02:50,830
شيء نفعله؟ ماذا؟

56
00:02:50,830 --> 00:02:54,690
لنرَ، لدينا الباتشينكو وسباق الخيول
.ومشاهدة بعض الواقع الافتراضيّ المنحرف

57
00:02:54,690 --> 00:02:55,860
.أطبق فمك

58
00:02:55,860 --> 00:02:57,950
!الواقع الافتراضيّ رائع

59
00:02:57,950 --> 00:03:00,070
.إنّه أشبه بطوف نجاة بالنّسبة للبكر

60
00:03:00,310 --> 00:03:04,340
.كلّا. قد يضرّنا ذلك أيضًا

61
00:03:04,340 --> 00:03:05,200
.صحيح

62
00:03:05,200 --> 00:03:06,510
!كفى حديثًا عن الواقع الافتراضيّ

63
00:03:12,060 --> 00:03:13,330
!بالطّبع لا نملك

64
00:03:13,670 --> 00:03:15,910
!وإلّا لما كنّا في هذه الفوضى أيّها الأحمق

65
00:03:15,910 --> 00:03:16,460
!غبيّ

66
00:03:16,460 --> 00:03:16,940
!حثالة

67
00:03:16,940 --> 00:03:17,600
!مت

68
00:03:20,880 --> 00:03:26,140
دعونا نسترسل فحسب! ما رأيكم أن نكون
أحرارًا جميعًا ونعيش حسب وتيرتنا الخاصّة؟

69
00:03:26,140 --> 00:03:27,600
!ذلك هو الخطب هنا بالضّبط

70
00:03:27,900 --> 00:03:31,240
.سبب وجودنا هنا هو أنّنا عشنا حسب وتيرتنا الخاصّة

71
00:03:31,240 --> 00:03:33,500
!لا تسمح للنّاجحين بإخبارك ذلك

72
00:03:38,310 --> 00:03:41,320
...لا بأس ببدء شيء، لكن

73
00:03:41,320 --> 00:03:43,230
!لا أريد أن أخوض أيّ شيء مرهق

74
00:03:43,230 --> 00:03:48,830
...تمامًا! دعونا نتجاوز أيّ شيء مرهق
!ونتحوّل إلى مرحلة النّاجحين

75
00:03:48,830 --> 00:03:50,740
.سيكون من الجميل إن أمكننا التحوّل

76
00:03:50,740 --> 00:03:52,020
أليس كذلك؟

77
00:03:52,020 --> 00:03:53,000
ماذا؟

78
00:03:53,250 --> 00:03:55,110
.أنتم مريعون

79
00:04:07,030 --> 00:04:09,670
صنعتُ مسدّسًا. أيرغب أيّكم استخدامه؟

80
00:04:15,100 --> 00:04:16,940
.أتساءل لمَ هم هكذا

81
00:04:17,220 --> 00:04:19,940
.لا يهمّ. ما باليد حيلة الآن

82
00:04:19,940 --> 00:04:23,490
.انتهى الأنمي خاصّتنا قبل وقت طويل على أيّ حال

83
00:04:26,650 --> 00:04:27,950
.صحيح

84
00:04:28,350 --> 00:04:30,990
.إذًا... لقد بدأ الأنمي خاصّتنا بالفعل

85
00:04:32,830 --> 00:04:34,420
!ماذا؟

86
00:04:34,650 --> 00:04:37,150
حقًّا؟ بدأ فعلًا؟

87
00:04:37,150 --> 00:04:37,600
.أجل

88
00:04:37,600 --> 00:04:38,670
!رائع

89
00:04:42,400 --> 00:04:47,010
.بلى فعلت! لكنّي تأثّرت بكلّ هذا وجلست

90
00:04:47,010 --> 00:04:47,470
.مؤلم

91
00:04:47,840 --> 00:04:51,090
.لكن هذا يعني أنّ لدينا ما نفعله

92
00:04:51,090 --> 00:04:52,210
أليس هذا رائعًا؟

93
00:04:52,210 --> 00:04:53,890
!بالفعل

94
00:04:55,020 --> 00:04:55,730
.لا، مهلًا

95
00:04:56,130 --> 00:04:57,850
.لدينا مشكلة مع ذلك

96
00:04:59,400 --> 00:05:00,990
.مسح، مسح

97
00:05:02,870 --> 00:05:03,820
من أولئك الأشخاص؟

98
00:05:05,790 --> 00:05:08,710
!ما الّذي يفعلونه في بيتنا؟

99
00:05:08,710 --> 00:05:11,440
ما العمل يا أوسوماتسو-نيسان؟ هل نقتلهم؟

100
00:05:11,440 --> 00:05:16,230
...أجل. فلن ننجو نحن العاطلون إن طُردنا من بيتنا

101
00:05:17,080 --> 00:05:18,460
.لذا لنقتلهم

102
00:05:20,710 --> 00:05:23,180
.المكان نظيف جدًّا

103
00:05:36,110 --> 00:05:38,440
ماذا؟ أين نحن؟

104
00:05:44,480 --> 00:05:46,270
.أيّها التّوائم الستّة

105
00:05:53,330 --> 00:05:54,820
!لجنة؟

106
00:05:54,820 --> 00:05:57,440
حقًّا؟ ألا بأس أن تأتوا إلى هنا؟

107
00:05:57,440 --> 00:06:00,090
!شيييه

108
00:05:58,990 --> 00:06:00,090
!إيامي

109
00:06:00,090 --> 00:06:00,950
!شيه

110
00:06:01,730 --> 00:06:05,670
!من تحسبون أنفسكم؟! أخفضوا رؤوسكم

111
00:06:05,670 --> 00:06:10,700
قرّرنا أن نستبدلكم جميعًا أيّها العاطلون

112
00:06:10,700 --> 00:06:14,930
.كنجوم العرض عندما تبدأ السّلسلة الجديدة

113
00:06:14,930 --> 00:06:16,110
استبدال؟

114
00:06:16,110 --> 00:06:18,980
.تخلّوا عنّا كتوائم ستّة

115
00:06:18,980 --> 00:06:21,200
ما معنى ذلك أساسًا؟

116
00:06:21,200 --> 00:06:23,230
.أعلم أنّي قلت هذا، لكن لا أملك فكرة

117
00:06:23,230 --> 00:06:25,880
!بربّكم! استبدال؟

118
00:06:25,880 --> 00:06:27,570
!لم نربح أيّ فلس

119
00:06:27,570 --> 00:06:30,080
كيف يفترض بنا أن نعيش خارج بيتنا؟

120
00:06:30,080 --> 00:06:31,580
!سحقًا لكم أيّتها الشّركة الشرّيرة

121
00:06:31,580 --> 00:06:34,130
!إن كنتم ستطردوننا فأعطونا سببًا وجيهًا

122
00:06:34,130 --> 00:06:34,870
!شيييه

123
00:06:35,390 --> 00:06:36,850
سبب وجيه؟

124
00:06:36,850 --> 00:06:40,070
!أنتم عاطلون! كلّكم حثالة

125
00:06:40,070 --> 00:06:41,540
!تشربون خلال النّهار

126
00:06:41,540 --> 00:06:42,880
!ولم تكبروا إطلاقًا

127
00:06:43,380 --> 00:06:48,240
.من الصّعب النّظر إليكم من وجهة مجتمعيّة وتعليميّة

128
00:06:49,920 --> 00:06:51,620
...ناهيكم

129
00:06:51,620 --> 00:06:55,140
!كثيرًا ما صدرت منكم أفعال تنمّ عن العنف

130
00:06:55,140 --> 00:06:56,390
!وأنتم دنيئون

131
00:06:56,600 --> 00:06:57,520
!والتعرّي

132
00:06:57,520 --> 00:06:59,350
!فظيع *****

133
00:07:00,260 --> 00:07:02,490
.ما عدتم تناسبون هذا العصر

134
00:07:02,490 --> 00:07:05,230
...ما يريده النّاس الآن هو

135
00:07:05,570 --> 00:07:08,740
!الالتزام

136
00:07:08,950 --> 00:07:10,740
!معًا الآن يا جماعة

137
00:07:10,740 --> 00:07:14,060
!التزام

138
00:07:15,910 --> 00:07:18,600
.ما عدنا في حقبة شوا أو هيسي

139
00:07:18,600 --> 00:07:21,670
.إنّنا في حقبة ريوا الآن. عليكم أن تتماشوا مع الوقت

140
00:07:21,940 --> 00:07:24,700
.إيامي، أنت آخر من يخبرنا بذلك

141
00:07:24,700 --> 00:07:25,520
.أجل

142
00:07:26,050 --> 00:07:28,690
.والآن أيّها التّوائم السّتّة السّابقون

143
00:07:28,690 --> 00:07:31,090
التـ-تّوائم السّتّة السّابقون؟

144
00:07:31,090 --> 00:07:34,090
.اقبلوا هذه الأزهار من أجل تخرّجكم

145
00:07:38,560 --> 00:07:41,350
ماذا؟ من هم الآن؟

146
00:07:43,330 --> 00:07:45,860
.مرحبًا. أنا مؤدّي الأصوات ساكوراي تاكاهيرو

147
00:07:47,310 --> 00:07:49,120
.وأنا مؤدّي الأصوات ناكامورا يويتشي

148
00:07:49,980 --> 00:07:51,060
.أنا كاميا هيروشي

149
00:07:51,060 --> 00:07:51,610
!هيروشي

150
00:07:51,860 --> 00:07:53,360
!أنا فوكوياما جون

151
00:07:54,880 --> 00:07:56,700
!موسو! أنا أونو دايسكي

152
00:07:56,700 --> 00:07:58,370
!موسو! أنا جيوشيماتسو

153
00:07:58,590 --> 00:07:59,870
.أنا موراكامي كوجي

154
00:07:59,870 --> 00:08:04,580
!ماذا؟! مهلًا... من؟

155
00:08:04,580 --> 00:08:07,290
!مهلًا! والآن ظهر مؤدّي الأصوات؟

156
00:08:07,290 --> 00:08:08,670
ألا بأس بهذا حقًّا؟

157
00:08:08,670 --> 00:08:10,010
!ومن موراكامي بالضّبط؟

158
00:08:10,010 --> 00:08:11,550
.أحسنتم عملًا يا رفاق

159
00:08:11,550 --> 00:08:16,080
!لمَ تأخذ جانبهم؟! يفترض بك أن تكون إلى جانبنا

160
00:08:16,080 --> 00:08:17,550
.لا تقلقوا

161
00:08:17,830 --> 00:08:21,320
.لدينا الكثير من السّلسلات الاعتياديّة الأخرى الّتي نعمل عليها

162
00:08:21,320 --> 00:08:22,420
!مرحى

163
00:08:22,420 --> 00:08:23,520
!أنتم حثالة

164
00:08:23,520 --> 00:08:24,600
!موتوا! آمل أن تُطردوا

165
00:08:31,900 --> 00:08:33,740
!إتشي! لنلعب كرة السلّة سويًّا

166
00:08:33,970 --> 00:08:35,690
!التّمرين ممتع

167
00:08:35,690 --> 00:08:36,370
!إتشي

168
00:08:37,170 --> 00:08:39,600
!هيّا، لنلعب

169
00:08:37,510 --> 00:08:39,600
...إنّهما مختلفان تمامًا

170
00:08:39,600 --> 00:08:40,870
!بويه

171
00:08:39,600 --> 00:08:40,870
!هيّا يا إتشي

172
00:08:40,870 --> 00:08:43,130
!أجل، أجل، أجل! بويه

173
00:08:43,130 --> 00:08:44,330
.في الواقع، إنّهما متشابهان تمامًا

174
00:08:44,330 --> 00:08:45,400
.أحسنت عملًا

175
00:08:45,400 --> 00:08:48,210
!من أنت؟! أين هو ميو بالضّبط؟

176
00:08:48,210 --> 00:08:49,750
!إنّه المُخرج

177
00:08:50,210 --> 00:08:51,770
!المخرج

178
00:08:51,770 --> 00:08:53,290
!أنقذنا أيّها المخرج

179
00:08:52,250 --> 00:08:53,950
!هذا ليس صائبًا

180
00:08:53,290 --> 00:08:55,570
!قل شيئًا لهم

181
00:09:00,310 --> 00:09:02,400
.أنتم تقومون بالكثير من النّكات الدّنيئة

182
00:09:04,430 --> 00:09:06,800
!أنت من صنع هذا العرض

183
00:09:08,530 --> 00:09:10,400
!إن كان يجب التخلّي عن أحد فيجب أن يكون أنت

184
00:09:10,400 --> 00:09:11,820
!شيييه

185
00:09:17,700 --> 00:09:18,940
!أيّها الحقيرون

186
00:09:18,940 --> 00:09:21,210
!ستدفعون ثمن هذا! انتظروا فحسب

187
00:09:21,210 --> 00:09:22,640
!سنقتلكم يومًا ما

188
00:09:38,640 --> 00:09:42,800
ماذا؟ "مصنع إعادة خلق شخصيّات الأنمي"؟

189
00:09:42,800 --> 00:09:44,560
ماذا؟

190
00:09:44,560 --> 00:09:47,790
!إعادة خلق! إعادة خلق! لنولد من جديد

191
00:09:47,790 --> 00:09:51,010
!إعادة الخلق! إعادة الخلق! لنولد من جديد

192
00:09:52,110 --> 00:09:53,810
.انظروا هناك

193
00:09:54,860 --> 00:09:56,700
!مهلًا، إنّه ديكابان

194
00:10:00,170 --> 00:10:02,060
.أعتمد عليك

195
00:10:04,120 --> 00:10:06,370
!إعادة خلق! إعادة خلق! إعادة خلق

196
00:10:16,740 --> 00:10:17,670
!مهلًا، مهلًا، مهلًا

197
00:10:21,850 --> 00:10:23,030
!هاتابو

198
00:10:23,030 --> 00:10:24,110
...جو

199
00:10:25,270 --> 00:10:27,270
!إعادة خلق! إعادة خلق! إعادة خلق

200
00:10:32,470 --> 00:10:33,850
.أنا هاتابو، جو

201
00:10:33,850 --> 00:10:34,480
!مهلًا، مهلًا، مهلًا

202
00:10:36,710 --> 00:10:37,900
!دايون

203
00:10:41,640 --> 00:10:43,150
!دايون

204
00:10:46,880 --> 00:10:51,210
مـ-ما الّذي سيحدث لنا؟

205
00:10:51,210 --> 00:10:53,210
!إعادة خلق! إعادة خلق

206
00:11:00,300 --> 00:11:01,800
!تحوّلنا إلى غائط

207
00:11:02,010 --> 00:11:03,520
!ماذا؟! لماذا؟

208
00:11:06,310 --> 00:11:07,300
!كفّوا عن العبث معنا

209
00:11:07,300 --> 00:11:08,380
!أنتم

210
00:11:09,690 --> 00:11:11,940
.لم ننجح في إعادة خلقكم

211
00:11:11,940 --> 00:11:13,890
.سيتمّ الآن إبادتكم

212
00:11:19,110 --> 00:11:21,410
!ماذا تقصدون بإخفاق؟

213
00:11:27,950 --> 00:11:30,190
مهلًا، ما الّذي يجري هنا؟

214
00:11:30,190 --> 00:11:32,880
لمَ تحوّلنا إلى غائط من الحلقة الأولى؟

215
00:11:32,880 --> 00:11:35,460
كيف سيفكّر فينا النّاس إن رأونا الآن؟

216
00:11:35,460 --> 00:11:38,180
.سيظنّون أنّنا فضلات

217
00:11:38,180 --> 00:11:41,000
.بالطّبع. لأنّنا كذلك

218
00:11:41,000 --> 00:11:42,680
!هذا سيّئ

219
00:11:42,680 --> 00:11:47,160
هذا ليس جيّدًا. ألديك أيّة أفكار مشرقة أيّها الغائط الأخضر؟

220
00:11:47,160 --> 00:11:48,060
.أنا تشوروماتسو أيّها الحقير

221
00:11:55,510 --> 00:11:58,070
!فـ-فكّرت في شيء مجنون للتّو

222
00:11:59,220 --> 00:12:04,110
...إذًا، إن حاولنا التغوّط ونحن على شكل غائط

223
00:12:05,050 --> 00:12:08,190
ما الّذي سيخرج من شرجنا؟

224
00:12:08,190 --> 00:12:10,900
!ماذا تقول أساسًا أيّها البراز؟ اخرس

225
00:12:11,450 --> 00:12:13,000
!لا داعي من ذلك حقًّا

226
00:12:13,830 --> 00:12:17,040
!أفلح الأمر! كما أنّه براز

227
00:12:17,040 --> 00:12:18,410
!اخرس أيّها البراز

228
00:12:18,410 --> 00:12:21,050
.قل شيئًا يا إتشيماتسو

229
00:12:21,050 --> 00:12:24,470
أصبحنا غائطًا حقًّا الآن. ماذا سنفعل؟

230
00:12:25,110 --> 00:12:25,800
...في الواقع

231
00:12:26,510 --> 00:12:29,120
.أظنّ أنّه ربّما لا بأس في هذا

232
00:12:30,070 --> 00:12:32,560
.هذا مريح حقًّا في الواقع

233
00:12:32,840 --> 00:12:33,710
ماذا؟

234
00:12:33,710 --> 00:12:34,690
.وجهة نظر جيّدة

235
00:12:34,690 --> 00:12:36,190
تشوروماتسو-نيسان؟

236
00:12:36,190 --> 00:12:40,720
،نتلقّى الكثير من النّقد عندما نكون عاطلين كبشر

237
00:12:40,720 --> 00:12:43,650
لكن من سيشتكي من غائط؟

238
00:12:43,650 --> 00:12:47,060
.ربّما ارتحت من ضغوطات العيش

239
00:12:47,700 --> 00:12:50,380
،من الواضح أنّنا لن نحظى بشعبيّة مع الآنسات الآن

240
00:12:50,380 --> 00:12:51,890
.لذا لنعش كغائط فحسب

241
00:13:05,290 --> 00:13:07,830
!مهلًا! ما زلت صغيرًا

242
00:13:08,330 --> 00:13:10,500
توتي، هل تعرف أين ذهب الغائط الّذي تغوّطته؟

243
00:13:10,500 --> 00:13:13,500
!كلّا! جد غائطك بنفسك

244
00:13:23,360 --> 00:13:26,200
!لمَ حدث هذا أساسًا؟! من المخطئ في هذا؟

245
00:13:26,200 --> 00:13:28,550
السّبب من تحوّلنا إلى غائط؟

246
00:13:28,550 --> 00:13:30,540
.إنّه خطأ أوسوماتسو-نيسان بالطّبع

247
00:13:30,540 --> 00:13:31,460
.أجل، أجل

248
00:13:31,460 --> 00:13:32,910
ماذا؟ مهلًا، لماذا؟

249
00:13:32,910 --> 00:13:34,980
،لأنّك كنت عاطلًا دائمًا

250
00:13:34,980 --> 00:13:36,510
.وأنت كسول متقاعس يعيش في البيت

251
00:13:36,510 --> 00:13:37,430
.أنت غائط حرفيًّا

252
00:13:37,430 --> 00:13:39,070
.هذا ينطبق عليكم جميعًا أيضًا

253
00:13:39,880 --> 00:13:42,940
.أظنّنا تحوّلنا إلى غائط بسبب تشوروماتسو-نيسان

254
00:13:42,940 --> 00:13:43,950
.أجل، أجل

255
00:13:43,950 --> 00:13:44,810
لماذا؟

256
00:13:44,810 --> 00:13:47,510
من هذا يتابع عرضًا عن ولد بكر؟

257
00:13:47,510 --> 00:13:48,990
.أنتم بكر جميعًا أيضًا

258
00:13:49,740 --> 00:13:51,010
.شخصيّتك سيّئة

259
00:13:51,010 --> 00:13:52,140
.كما حال شخصيّاتكم

260
00:13:52,680 --> 00:13:53,750
.لم تنضج على الإطلاق

261
00:13:56,280 --> 00:13:57,310
.كما حالكم جميعًا

262
00:13:57,900 --> 00:13:59,760
.أنت إنسان فاسد

263
00:13:59,760 --> 00:14:01,060
.كما حالكم جميعًا

264
00:14:01,310 --> 00:14:02,500
!أنتم أغبياء جميعًا

265
00:14:02,500 --> 00:14:02,950
!حثالة

266
00:14:02,950 --> 00:14:04,030
!مغفّلون

267
00:14:03,660 --> 00:14:05,460
!لا تستحقّون العيش

268
00:14:04,040 --> 00:14:05,070
!سيّئون

269
00:14:05,460 --> 00:14:05,940
!مهلًا

270
00:14:07,450 --> 00:14:08,820
.فهمت الآن

271
00:14:08,820 --> 00:14:11,700
في قرارة أنفسنا، كنّا دائمًا

272
00:14:12,840 --> 00:14:14,440
.غائطًا

273
00:14:23,060 --> 00:14:23,750
!مت

274
00:14:27,160 --> 00:14:28,510
!هيديبو

275
00:14:47,070 --> 00:14:48,030
!انظري! فضلات

276
00:14:47,420 --> 00:14:49,650
.انظر إلى تلك الفضلات

277
00:14:48,030 --> 00:14:49,650
!لا تحدّق بها

278
00:14:49,650 --> 00:14:50,450
!إنّها فضلات

279
00:14:50,100 --> 00:14:51,000
.بالفعل

280
00:14:51,000 --> 00:14:51,820
.مقرف

281
00:14:53,340 --> 00:14:57,060
...نـ-نحن آسفون على كلّ شيء

282
00:14:57,060 --> 00:14:58,830
.نحن آسفون

283
00:14:59,510 --> 00:15:03,340
.لن نخرج عن الصّواب بعد الآن

284
00:15:04,050 --> 00:15:07,550
!نعدك أنّنا سنحظى بحبّ الجميع

285
00:15:07,550 --> 00:15:08,670
...لذا رجاءً

286
00:15:10,820 --> 00:15:12,520
!نترجّاك

287
00:15:14,100 --> 00:15:17,120
هل تعرفون مكانكم الآن أيّها الحثالة؟

288
00:15:17,740 --> 00:15:20,780
.لا مكان لكم في الموسم الثّالث

289
00:15:20,780 --> 00:15:24,500
.إن وافقتم على ذلك، سنعيدكم إلى أشكالكم الأصليّة

290
00:15:27,360 --> 00:15:28,280
!حسنًا

291
00:15:28,280 --> 00:15:31,810
!توبوا وعيشوا حياةً متواضعة

292
00:15:31,810 --> 00:15:33,290
!حاضر

293
00:15:40,810 --> 00:15:41,860
!أجل

294
00:15:41,860 --> 00:15:43,400
!لقد عدنا

295
00:15:43,400 --> 00:15:45,020
!حمدًا لهذا

296
00:16:08,690 --> 00:16:11,520
!الجميع يحبّوننا

297
00:16:12,490 --> 00:16:14,700
.أنا لا أهتم ما دام أنا يتقاضى راتبه

298
00:16:15,470 --> 00:16:18,210
!جميعًا! مرحبًا

299
00:16:18,210 --> 00:16:20,520
!أنا الأخ الأكبر، ماتسونو أوسوماتسو

300
00:16:20,520 --> 00:16:22,290
!أشكركم جميعًا على دعمكم

301
00:16:22,290 --> 00:16:25,460
!نحبّكم جميعًا

302
00:16:40,630 --> 00:16:43,180
ما هو التّرفيه بالضّبط؟

303
00:16:43,690 --> 00:16:49,900
.أمنيّتنا الوحيدة... هي أن نحرص أنّكم على نفس المركب معنا

304
00:16:50,170 --> 00:16:54,130
.آمل أن تأتوا معنا. هذه السّلسلة معكم دائمًا

305
00:16:54,130 --> 00:16:55,960
!تشورو

306
00:16:55,960 --> 00:16:58,160
.نحن سواسية جميعًا. نحن أصدقاء

307
00:16:58,160 --> 00:17:00,120
!إتشي

308
00:16:59,150 --> 00:17:02,330
!لنتواصل جميعًا ونوطّد روابطنا

309
00:17:02,790 --> 00:17:04,790
.هذا هو الموسم الثّالث من أوسوماتسو-سان

310
00:17:05,030 --> 00:17:06,540
...وهكذا

311
00:17:06,540 --> 00:17:09,540
!يجب أن يكون

312
00:17:16,590 --> 00:17:19,590
!اخرسوا

313
00:17:23,230 --> 00:17:26,400
!ر-رفاق... العنف ليس حلًّا

314
00:17:26,400 --> 00:17:27,400
!اخرس

315
00:17:29,790 --> 00:17:31,610
—التّرفيه الّذي نصنعه بواسطة

316
00:17:31,610 --> 00:17:33,110
!إلى الجحيم

317
00:17:33,110 --> 00:17:34,610
...تـ-توقّفوا

318
00:17:33,110 --> 00:17:34,960
...جو

319
00:17:34,610 --> 00:17:36,010
!أفيقوا

320
00:17:36,650 --> 00:17:39,210
!توقّفوا! سيكرهنا النّاس

321
00:17:40,110 --> 00:17:42,120
!لا

322
00:17:46,170 --> 00:17:49,710
!الهيئة الأولى: قاطع الهرّ

323
00:18:17,620 --> 00:18:19,910
!شيييه

324
00:18:42,720 --> 00:18:44,970
!رفاق، انتظروا رجاءً

325
00:18:45,950 --> 00:18:50,840
!لا تقلقوا. سنقبلكم دائمًا بصدر رحب

326
00:18:56,030 --> 00:18:58,380
!لا يهمّ من هي الشّخصيّات الرّئيسيّة

327
00:18:58,380 --> 00:19:00,570
!والآن، دعونا نبدأ من جديد

328
00:19:00,940 --> 00:19:02,820
!نحن الـ24 جميعًا

329
00:19:16,170 --> 00:19:20,090
!شيييه! نجوم المستقبل

330
00:19:21,680 --> 00:19:24,980
...يا أولاد... ما تلك

331
00:19:25,700 --> 00:19:27,190
الأكياس؟

332
00:19:32,290 --> 00:19:37,190
شيييه! كنتم تفعلون الشّيء الّذي
!لا يجب عليكم أن تفعلوه قطعًا

333
00:19:37,580 --> 00:19:40,940
.عجبًا، فعلوا ذلك حقًّا. أظنّنا بحاجة إلى بدائل

334
00:19:40,940 --> 00:19:42,360
.أجل

335
00:19:42,360 --> 00:19:44,320
أظنّ أنّ هذا يعني أنّنا نحن السّتّة

336
00:19:44,620 --> 00:19:46,910
.يمكننا أن نكون نجوم الموسم الثّالث ثانيةً

337
00:19:48,250 --> 00:19:50,290
.فقد استبدلناهم فعلًا

338
00:19:50,290 --> 00:19:51,160
!أجل

339
00:19:51,410 --> 00:19:53,340
.لا شيء يدعو للبهجة

340
00:19:55,440 --> 00:19:56,210
.قطعًا لا

341
00:19:56,210 --> 00:19:58,360
.حمدًا لهذا

342
00:19:56,210 --> 00:19:59,090
!مرحى! مرحى! مرحى

343
00:19:58,360 --> 00:19:59,360
!لا شيء يُحمد في هذا

344
00:19:59,360 --> 00:20:00,650
!حمدًا لهذا

345
00:20:00,650 --> 00:20:02,090
!هذا سيّئ

346
00:20:02,300 --> 00:20:06,930
!لا تبدؤوا العرض

347
00:21:38,820 --> 00:21:42,230
.يا إلهي... كان ذلك وشيكًا

348
00:21:42,550 --> 00:21:46,010
.كِدنا نُسلب مناصبنا كنجوم

349
00:21:47,960 --> 00:21:49,820
.لنفعل ما نفعله عادةً فحسب

350
00:21:49,820 --> 00:21:51,450
.دعونا نسترسل

351
00:21:57,740 --> 00:21:59,850
!لديّ تسليم

352
00:23:34,790 --> 00:23:36,580
.مرحبًا، مرحبًا، معكم أوسوماتسو

353
00:23:36,580 --> 00:23:38,600
،خلتُ أنّنا نجونا من الاستبدال

354
00:23:38,600 --> 00:23:41,320
.لكن أظنّنا سنستقبل شخصيّات جديدة الأسبوع القادم

355
00:23:41,320 --> 00:23:43,600
.يا إلهي كم نحن مشغولون

356
00:23:43,600 --> 00:23:46,070
...لقاءات جديدة وبيئة متغيّرة

357
00:23:46,070 --> 00:23:48,670
.نحن عاطلون من الأساس لأنّ كلّ شيء مزعج

358
00:23:50,280 --> 00:23:53,910
.أظنّ أنّ الكثير يمكن أن يحدث بعد ثلاثة مواسم