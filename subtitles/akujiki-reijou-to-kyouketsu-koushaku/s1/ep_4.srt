1
00:00:01,740 --> 00:00:04,110
...عندما قال بأنّه أراد أن يعرفني أكثر

2
00:00:04,280 --> 00:00:06,130
هـ-هذا ما قصده؟

3
00:00:07,030 --> 00:00:08,070
...أنا

4
00:00:08,240 --> 00:00:10,660
!مُحال أن أنعتك بالمُخيف

5
00:00:10,830 --> 00:00:14,040
!أعتقد بأنّك شهم ووسيم جدّاً. سموّك

6
00:00:16,190 --> 00:00:17,810
وسيم؟

7
00:00:18,630 --> 00:00:23,690
أليس هذا ما أراد سماعه؟

8
00:00:25,700 --> 00:00:27,630
أتعتقدين ذلك حقّاً؟

9
00:00:29,120 --> 00:00:34,510
أجل! إن سألت، فأنا متأكّدة بأنّ عشرة
من أصل عشرة سيتّفقون

10
00:00:38,560 --> 00:00:42,010
ماذا؟ هل أخطأتُ ثانية؟

11
00:02:11,040 --> 00:02:12,110
الإشارة بالمُغادرة بواسطة عمود من النّار

12
00:02:12,280 --> 00:02:15,360
الإشارة بالمُغادرة بواسطة عمود من النّار
شعرك جميل كلون ضوء القمر -

13
00:02:15,530 --> 00:02:18,060
الإشارة بالمُغادرة بواسطة عمود من النّار
إنّه رماديّ باهت فحسب -

14
00:02:18,230 --> 00:02:22,950
،عندما توهّجتْ عيناك العنبريّتان ذهباً بالسّحر
جعل ذلك قلبي تتسارع نبضاته

15
00:02:23,120 --> 00:02:26,570
لديّ ذلك المنظر. ألا يزعجكِ ذلك؟

16
00:02:26,740 --> 00:02:27,740
إطلاقاً

17
00:02:28,360 --> 00:02:33,040
صورة عينيك الذّهبيّتين بينما كنت
تقطع رأس الباكهورن

18
00:02:33,210 --> 00:02:35,710
محفورة في ذاكرتي

19
00:02:35,880 --> 00:02:38,880
رُبّما لأنّكِ سُحِرتِ بواسطة ذلك المنظر

20
00:02:39,300 --> 00:02:40,440
أنت مُخطئ

21
00:02:41,610 --> 00:02:46,020
لن أنسى حدّتك أبداً

22
00:02:48,510 --> 00:02:51,380
...فهمت. ما دام ذلك لا يزعجكِ

23
00:02:51,550 --> 00:02:52,550
أبداً

24
00:02:53,030 --> 00:02:57,090
لا بُدّ لشخص أن يقتل الوحوش

25
00:02:57,490 --> 00:03:01,650
أنت تُنجز دوراً هامّاً ببساطة

26
00:03:02,170 --> 00:03:05,540
لِمَ ينبغي لذلك أن يؤرقك؟

27
00:03:06,190 --> 00:03:11,300
أنت تقاتل الوحوش. من الطّبيعيّ
أن يتطاير دمهم عليك

28
00:03:13,060 --> 00:03:15,510
لا أملك ذرّة رقيّ أيضاً

29
00:03:15,680 --> 00:03:17,170
ألا يزعدكِ ذلك؟

30
00:03:17,340 --> 00:03:23,230
أنت تُحقّق السّلام ليس لشعب
غالبريث فقط، بل للدّولة بأسرها

31
00:03:23,710 --> 00:03:26,000
لا شيء أنبل من ذلك

32
00:03:26,170 --> 00:03:27,860
...في هذه الحالة، المعذرة

33
00:03:29,140 --> 00:03:31,690
ما رأيكِ بي كخطيب؟

34
00:03:33,200 --> 00:03:35,550
لم أفكّر في ذلك أبداً

35
00:03:36,130 --> 00:03:38,180
...إذا خطبنا بعضنا الآخر

36
00:03:38,610 --> 00:03:41,750
في هذه المرحلة، حتّى الفارس سيَفي بالغرض

37
00:03:42,450 --> 00:03:44,920
سيكون دوق أكثر من كافٍ

38
00:03:45,090 --> 00:03:47,950
على العكس، الفارق بين مكانتي
ومكانته يُشكّل معضلة

39
00:03:50,860 --> 00:03:54,970
لكن التمكُّن من قضاء كلّ يوم
...مع رجل مثله

40
00:03:55,510 --> 00:03:57,480
صباح الخير يا ميلفيرا

41
00:03:58,340 --> 00:04:00,290
تصبحين على خير يا ميلفيرا

42
00:04:00,940 --> 00:04:03,220
!سيكون ذلك مُذهلاً للغاية

43
00:04:03,530 --> 00:04:08,100
باستثناء أنّني أشعر الدّونيّة
عندما أقف بجانبه

44
00:04:08,270 --> 00:04:11,870
،لأنّني لم أكن مهتمّة سوى ببحثي

45
00:04:12,040 --> 00:04:16,210
كلّ ما أكترث له هو شريك
يسمح لي بفعل ما أقوم به

46
00:04:16,380 --> 00:04:18,060
ميلفيرا؟

47
00:04:18,230 --> 00:04:20,110
...بـ-بصيغة أُخرى

48
00:04:20,730 --> 00:04:26,010
ما دام يمنحني أبي برَكته، سأتمكّن
من قضاء أيّامي في نعيم؟

49
00:04:26,180 --> 00:04:29,110
!كم أنا مادّية وماكرة

50
00:04:29,770 --> 00:04:30,920
...المعذرة

51
00:04:31,620 --> 00:04:35,130
اسمح لي بالإجابة عن سؤالك بسؤال

52
00:04:35,670 --> 00:04:40,590
من المؤكّد أنّك شريك زواج مرغوب

53
00:04:40,760 --> 00:04:42,860
فلماذا أنا؟

54
00:04:43,030 --> 00:04:49,130
إن كنّا سنتزوّج حقّاً، فلا أتخيّل
بأنّ شعبك سيقبل بي

55
00:04:50,970 --> 00:04:56,000
مذهب الحيويّة ليس شائعاً في بلاد
غالبريث كما هو هنا

56
00:04:56,170 --> 00:05:01,570
لكن إذا تزوّجت من الشّرّيرة الشّرهة
...الآكلة للوحوش الّذي يتجنّبها الجميع

57
00:05:02,060 --> 00:05:03,060
لا

58
00:05:04,460 --> 00:05:07,060
أعتقد بأنّ شعبي سيُرحّب بكِ

59
00:05:07,230 --> 00:05:08,310
ماذا؟

60
00:05:08,480 --> 00:05:10,660
هل تألفين غابة إيرزيني؟

61
00:05:10,830 --> 00:05:16,290
أجل. إنّها غابة ضخمة في بلاد غالبريث
وكنز دفين من الوحوش

62
00:05:16,510 --> 00:05:18,550
كنز دفين من الوحوش؟

63
00:05:18,720 --> 00:05:21,040
حسناً، لستِ مُخطئة

64
00:05:21,210 --> 00:05:23,900
مهما اصطدتُ منهم، يظهرون باستمرار

65
00:05:24,070 --> 00:05:26,940
بالكاد أستطيع التخلُّص من الجِيَف

66
00:05:28,570 --> 00:05:31,630
لكن حيث تهيج الوحوش، تتجمّع قوّة السّحر

67
00:05:32,090 --> 00:05:35,910
،ذلك يُولّد سموماً سحريّة في نهاية المطاف
الأمر الّذي يُثير غضب الوحوش

68
00:05:36,080 --> 00:05:39,680
يجب أن أثابر على صيدي لمنع ذلك

69
00:05:40,040 --> 00:05:44,400
هذا هو قدر أولئك الّذين يخلفون اسم غالبريث

70
00:05:44,570 --> 00:05:46,250
...سموّك

71
00:05:47,420 --> 00:05:52,070
بالنّسبة لي، كانت الوحوش
مُجرّد فريسة في نظري

72
00:05:52,590 --> 00:05:57,900
لذا صُدِمتُ عندما سمعتُكِ تتحدّثين
بلهفة عن أكلها

73
00:05:58,070 --> 00:06:01,370
وعندما رأيتُكِ تُحضّرين ذلك المودل الملكيّ

74
00:06:01,540 --> 00:06:04,100
رؤيتكِ للأمور مُبتكَرة

75
00:06:05,930 --> 00:06:08,560
،أحياناً نأكل الوحوش كذلك

76
00:06:08,830 --> 00:06:13,400
لكن لم نفكّر يوماً بأنّ هناك طريقة
لاستنزافها تماماً من سحرها

77
00:06:13,570 --> 00:06:17,130
ليت لم تكن تلك قوّتي الوحيدة

78
00:06:17,300 --> 00:06:18,550
عمّاذا تتكلّمين؟

79
00:06:18,720 --> 00:06:22,420
أنتِ تُحوّلين وحوشاً مُزعجة
إلى مصدر طعام قيّم

80
00:06:22,590 --> 00:06:24,180
من الطّبيعيّ أن يُرحَّب بكِ

81
00:06:24,740 --> 00:06:29,690
تقصد بأنّ بحثي سيكون مُفيداً لك؟

82
00:06:32,970 --> 00:06:36,800
إذا استطاعت الشّرّيرة الشّرهة
...مُساعدة شخص فقط

83
00:06:36,970 --> 00:06:42,770
،إذا رأى بحثي وبحث أمّي النّور
فهذا كلّ ما أحتاجه

84
00:06:42,940 --> 00:06:44,090
ميلفيرا

85
00:06:45,640 --> 00:06:48,800
معي، لن تحتاجي شيئاً

86
00:06:48,970 --> 00:06:51,350
يمكنني حمايتكِ من كلّ الشّرور

87
00:06:53,830 --> 00:06:59,010
أريدكِ أن تستخدمي معرفتكِ لمُساعدة
شعب غالبريث

88
00:07:04,890 --> 00:07:08,870
هل أنت جادّ حقّاً، سموّك؟

89
00:07:16,290 --> 00:07:20,970
لا بُدّ أنّ هذا هو العقد بيني وبين الدّوق

90
00:07:22,050 --> 00:07:28,020
لا توجد رومانسيّة جميلة مشوبة
،بمرارة بيننا

91
00:07:28,770 --> 00:07:29,890
...لكن

92
00:07:31,430 --> 00:07:32,660
سموّك

93
00:07:34,250 --> 00:07:38,230
أنا مسرورة بعرضك السّخيّ

94
00:07:38,800 --> 00:07:41,280
سوف تُنجدني

95
00:07:42,880 --> 00:07:46,600
أنا لا أستحقّك

96
00:07:47,380 --> 00:07:52,520
.ميلفيرا، أكره الأسلوب غير المُباشر
—إذا رفضتِني

97
00:07:52,690 --> 00:07:53,730
!من فضلك

98
00:07:53,900 --> 00:07:56,490
!من فضلك، أقبل وبكلّ سرور

99
00:07:56,780 --> 00:07:59,760
كما ترى، كلّ ما أهتمّ له هو بحثي

100
00:07:59,930 --> 00:08:02,730
لا أستطيع فعل شيء ينبغي
لسيّدة أن تتمكّن من فعله

101
00:08:02,900 --> 00:08:06,480
،لكن إذا كان صيد الوحوش هو واجبك

102
00:08:06,650 --> 00:08:10,330
فيمكنني مُساعدتك في إعداد وجبات
!شهيّة ما دامت لا تُهدَر

103
00:08:10,500 --> 00:08:11,930
...ماذا؟ المعذرة

104
00:08:12,100 --> 00:08:16,630
سأعطيك بعض القوارير، لذا
من فضلك استخدمها كيفما تشاء

105
00:08:16,800 --> 00:08:19,770
هذا أكثر ما يمكنني فعله لأجلك

106
00:08:20,740 --> 00:08:25,760
لكن إن كان هذا كافياً، فمن فضلك
اصنع لي معروف الزّواج منّي

107
00:08:28,940 --> 00:08:30,120
...ميلفي

108
00:08:33,320 --> 00:08:34,910
المعذرة

109
00:08:36,060 --> 00:08:38,650
نحن مُستعدّون لاستقبالك في القصر

110
00:08:38,820 --> 00:08:41,670
الكونت ينتظرك في غرفة الاستقبال

111
00:08:42,230 --> 00:08:43,330
عُلِم

112
00:08:45,720 --> 00:08:48,960
مولاتي، هل لي بلحظة؟

113
00:08:49,710 --> 00:08:51,560
لعلّه من الأفضل عدم مُناقشة

114
00:08:51,730 --> 00:08:56,590
ظروف بلادنا أو بحثكِ مع أيّ شخص
لا تعرفينه جيّداً

115
00:08:59,560 --> 00:09:01,630
حسناً إذاً، سأدلّك على الطّريق

116
00:09:06,340 --> 00:09:10,120
كان هذا الرّجل يتنصّت على مُحادثتنا

117
00:09:10,710 --> 00:09:12,070
...على ذكر الأمر

118
00:09:16,460 --> 00:09:20,960
بالطّبع، الدّوق الدّمويّ المجنون سيّئ الصّيت
تقدّم لخطبة ابنة الكونت

119
00:09:21,130 --> 00:09:23,340
لا عجب في أن يكون محميّاً

120
00:09:26,790 --> 00:09:29,760
هل أنت متأكّد من هذا؟

121
00:09:30,050 --> 00:09:33,070
يُشرّف عائلة غالبريث

122
00:09:33,240 --> 00:09:35,470
طلب يد ابنتك الاستثنائيّة

123
00:09:35,750 --> 00:09:41,000
بصفتي أبيها، يسرّني سماعك تقول ذلك

124
00:09:41,170 --> 00:09:44,000
...لكن الحادثة في المأدبة

125
00:09:44,290 --> 00:09:48,780
كان ذلك اليوم مُملّاً جدّاً بالنّسبة لي

126
00:09:49,380 --> 00:09:53,320
عندما ظهر الوحش المسعور، لم أتفاجأ

127
00:09:53,490 --> 00:09:55,350
أردتُ قتله والإجهاز عليه فقط

128
00:09:56,140 --> 00:10:00,950
،لكن عندما رأتني ابنتك مُضرجاً بدماء الوحش
لم تخف منّي

129
00:10:02,410 --> 00:10:05,530
لم تشح بنظرها عن منظري ذاك

130
00:10:10,090 --> 00:10:12,000
بصراحة، أنا مُتفاجئ

131
00:10:12,950 --> 00:10:16,180
ستقبلني على الأرجح

132
00:10:16,720 --> 00:10:19,700
ليس وكأنّني مُتيقّن من أنّها ستفعل

133
00:10:20,510 --> 00:10:24,260
،أعلم بأنّ هذا مُفاجئ

134
00:10:24,430 --> 00:10:28,210
لكن فرداً من أفراد عائلتي المُتطفّلين
لن يدعني أتجاوز الأمر

135
00:10:28,380 --> 00:10:31,000
فهمت. هذا ما يعترضك إذاً

136
00:10:31,450 --> 00:10:33,600
أتفهّم شعورك

137
00:10:33,770 --> 00:10:37,120
حقّاً؟ إذاً سوف تُوقّع العقد؟

138
00:10:39,900 --> 00:10:43,990
كلّ ما في الأمر هو أنّ ذوقها حيال
...لحم الوحوش... لا، أقصد بحثها

139
00:10:44,160 --> 00:10:47,110
هذه ليست مشكلة. على العكس، أُشجّع ذلك

140
00:10:47,280 --> 00:10:49,370
هـ-هكذا إذاً

141
00:10:49,540 --> 00:10:50,630
هل ما زال هناك أمر آخر؟

142
00:10:50,800 --> 00:10:52,360
...في الواقع

143
00:10:52,890 --> 00:10:56,970
...أنا مُمتنّ لأنّك مُعجب بابنتي، لكن

144
00:10:57,140 --> 00:10:58,140
لا

145
00:10:58,800 --> 00:11:02,750
ليس من الدّقيق القول بأنّني أُعجبتُ بها

146
00:11:03,190 --> 00:11:05,310
أنا أرغبها

147
00:11:06,810 --> 00:11:09,310
هلّا سألتُك سؤالاً؟

148
00:11:10,150 --> 00:11:14,200
عائلة غالبريث تبنّت خلفاءها لأجيال

149
00:11:14,370 --> 00:11:16,930
لماذا تبحث عن خطيبة الآن؟

150
00:11:17,620 --> 00:11:20,320
سؤال بديهيّ

151
00:11:21,710 --> 00:11:24,920
سيترتّب عليّ إخباره في نهاية المطاف

152
00:11:25,750 --> 00:11:29,830
اسمح لي أن أشرح سبب رغبتي بها

153
00:11:31,160 --> 00:11:33,140
...أوّلاً

154
00:11:36,330 --> 00:11:39,120
تُجدها مُريحة؟ تعتقد بأنّها جذّابة؟

155
00:11:39,290 --> 00:11:41,120
أنت شخصيّة عجيبة، سموّك

156
00:11:41,290 --> 00:11:44,080
إطلاقاً. إنّها جذّابة

157
00:11:45,800 --> 00:11:52,090
،هنا حيث مذهب الرّوحيّة مُنتشر بشكل واسع
قُدِّرها لها أن تعيش بعار

158
00:11:53,140 --> 00:11:57,280
إن لم يتغيّر شيء، كنتُ أنوي
إرسالها إلى دَير

159
00:11:57,450 --> 00:12:00,370
عندما أفكّر فيما يصبّ في صالح
ابنتي، أتمنّى ألّا أضطرّ لذلك

160
00:12:00,540 --> 00:12:04,230
لكن ككونت، أنا مُلتزم بمكانتي

161
00:12:04,710 --> 00:12:09,770
هذا مُثير للشّفقة، لكن رغم أنّني
أبوها، لا أستطيع حمايتها

162
00:12:10,170 --> 00:12:11,740
...لذا، من فضلك

163
00:12:11,910 --> 00:12:12,910
أعلم

164
00:12:14,450 --> 00:12:18,960
عندما تنضمّ لعائلة غالبريث، سوف أحميها

165
00:12:19,340 --> 00:12:22,530
يمكنك أن تطمئنّ وتترك كلّ شيء على عاتقي

166
00:12:24,750 --> 00:12:29,010
...بعد عشرة أيّام من عودة الدّوق إلى الدّيار

167
00:12:30,820 --> 00:12:33,440
ميلفيرا-ساما، أين أضع هذه؟

168
00:12:34,020 --> 00:12:37,170
لنرَ. الأغراض الخفيفة تُوضع
في الصّناديق الخشبيّة

169
00:12:37,340 --> 00:12:39,020
وتُوضَع كلّ الوثائق معاً

170
00:12:39,330 --> 00:12:42,850
هل يمكنك ختم هذا الصّندوق
حالما تتحقّقين من مُحتوياته؟

171
00:12:43,020 --> 00:12:44,860
بالتّأكيد. أنا قادمة في الحال

172
00:12:45,030 --> 00:12:46,110
ميلفيرا-ساما، هل يمكنكِ تفقُّد هذا أيضاً؟

173
00:12:46,280 --> 00:12:47,360
!أجل

174
00:12:47,530 --> 00:12:48,630
!هنا كذلك من فضلكِ

175
00:12:48,800 --> 00:12:49,800
!قادمة

176
00:12:53,250 --> 00:12:55,680
،بينما أستعدّ للانتقال إلى بلاد غالبريث

177
00:12:55,850 --> 00:13:00,290
اكتظّتْ غرفتي بالأغراض الّتي تمّ
نقلها من مركز البحث

178
00:13:00,730 --> 00:13:02,310
،بناء على طلب الدّوق

179
00:13:02,480 --> 00:13:06,830
سيُؤخَذ معي كلّ شيء من المركز

180
00:13:07,000 --> 00:13:09,840
وحتّى أنّه ترك بعض الفُرسان لتقديم المُساعدة

181
00:13:10,690 --> 00:13:17,030
الدّوق وأنا خطبنا بعضنا الآخر منذ
...زيارته، لكن

182
00:13:20,540 --> 00:13:25,640
يبدو أنّه أُطلِق سحر قويّ على هذا العقد

183
00:13:25,810 --> 00:13:27,150
هل هذا مُناسب حقّاً؟

184
00:13:27,320 --> 00:13:29,590
لا تقلقي يا ميلفيرا

185
00:13:29,990 --> 00:13:33,450
أقسمتُ بألّا تُفسَخ خطوبتنا

186
00:13:33,620 --> 00:13:34,620
...فضلاً عن ذلك

187
00:13:35,830 --> 00:13:39,830
أردتُ أن أرتقي لصدقكِ وعزيمتكِ

188
00:13:40,450 --> 00:13:42,940
لا تخبري كايوس بذلك فحسب

189
00:13:43,110 --> 00:13:45,080
دائماً ما يجد شيئاً يتذمّر بشأنه

190
00:13:45,640 --> 00:13:47,240
...سموّك

191
00:13:47,410 --> 00:13:48,540
!أحم

192
00:13:50,500 --> 00:13:53,300
أنتما مخطوبان رسميّاً الآن

193
00:13:53,470 --> 00:13:54,470
بالفعل

194
00:13:54,770 --> 00:13:56,620
...بالمناسبة، سموّك

195
00:13:56,790 --> 00:13:57,790
ما الأمر؟

196
00:13:58,140 --> 00:14:01,600
من فضلك لا تذكر تلك الجزئيّة لابنتي

197
00:14:02,580 --> 00:14:04,320
ماذا؟ أنت تعترف بذلك إذاً؟

198
00:14:04,490 --> 00:14:08,620
كنت أنت من نشر الإشاعات حول الشّرّيرة
الشّرِهة وسط المُجتمع الرّفيع

199
00:14:09,210 --> 00:14:11,540
،بتلويث سُمعتهم عمداً

200
00:14:11,710 --> 00:14:15,650
حميتها من أولئك الّذين قد يستغلّون
بحثها لغرض الشّرّ

201
00:14:16,080 --> 00:14:17,450
أليس كذلك؟

202
00:14:17,620 --> 00:14:20,230
لعلّي تماديتُ كثيراً

203
00:14:20,400 --> 00:14:22,100
،أتفهّم مشاعرك

204
00:14:22,270 --> 00:14:26,950
لكن حبّذا أن تحجم عن ذلك في المستقبل يا أبي

205
00:14:28,010 --> 00:14:31,850
المعذرة، عمّاذا تتكلّمان؟

206
00:14:32,020 --> 00:14:33,910
!لا شيء إطلاقاً

207
00:14:37,520 --> 00:14:41,490
لكن هذا السّحر... يبدو هذا استثنائيّاً بالفعل

208
00:14:41,660 --> 00:14:43,060
ميلفيرا-ساما

209
00:14:44,060 --> 00:14:46,980
المودل الملكيّ جاهز للنّقل

210
00:14:47,150 --> 00:14:51,030
التّنانين ستنقل الحمولة المُتجمّدة جوّاً

211
00:14:51,410 --> 00:14:53,400
شكراً لك يا مولان

212
00:14:53,570 --> 00:14:55,750
احرص على أن تكون مُتجمِّدة تماماً من فضلك

213
00:14:55,920 --> 00:14:57,460
عُلِم

214
00:14:57,740 --> 00:15:00,960
ماذا سنفعل بالفراء الذّهبيّ
الخاصّ بالمودل الملكيّ؟

215
00:15:01,130 --> 00:15:03,000
سأتركه هنا

216
00:15:03,170 --> 00:15:07,660
سأخيّط معاطفَ دافئة لأبي وابنه

217
00:15:07,830 --> 00:15:09,210
حسناً

218
00:15:09,590 --> 00:15:11,080
شكراً لك

219
00:15:13,020 --> 00:15:14,780
حسناً، شارفتُ على الانتهاء

220
00:15:14,950 --> 00:15:16,840
ينبغي أن أنتهي بالتّزامن مع وصوله

221
00:15:18,870 --> 00:15:24,940
لكن رغم ذلك، هل الزّوجان المخطوبان
ينتقلان عادة معاً بهذه السّرعة؟

222
00:15:25,410 --> 00:15:26,800
...قال الدّوق

223
00:15:26,970 --> 00:15:29,320
شتاء مارشالريد طويل جدّاً

224
00:15:29,490 --> 00:15:31,630
هل أنتظر حتّى الرّبيع؟

225
00:15:32,760 --> 00:15:37,240
قال بأنّه يريدني أن أتأقلم مع بلاده
،بما أنّهم مُميّزون

226
00:15:37,410 --> 00:15:40,750
لكن ألا ينبغي أن أتجهّز قبل
الانتقال إلى عائلته؟

227
00:15:43,440 --> 00:15:46,840
كيف كان الأمر بالنّسبة لكِ يا أمّي؟

228
00:15:47,480 --> 00:15:51,970
،هذا صحيح. فقدتُ أمّي في صغري

229
00:15:52,140 --> 00:15:55,040
والتّدريب كربّة منزل صعب

230
00:15:58,410 --> 00:16:01,220
وصل مُرافقكِ

231
00:16:01,390 --> 00:16:03,890
ينتظركِ مولايّ في المنزل الرّئيسيّ

232
00:16:04,250 --> 00:16:07,080
يبدو أنّكِ انتهيتِ من حزم الأمتعة

233
00:16:07,250 --> 00:16:10,860
،قد تكون المُغادرة مُحزنة
لكن هذه مُناسبة مُبهِجة

234
00:16:11,030 --> 00:16:13,270
معك حقّ. شكراً لك

235
00:16:13,530 --> 00:16:15,700
اعتنِ بأبي يا هيرمان

236
00:16:15,870 --> 00:16:17,440
سأفعل بكلّ تأكيد

237
00:16:17,610 --> 00:16:19,300
والآن، نل نذهب؟

238
00:16:19,470 --> 00:16:20,470
أجل

239
00:16:24,640 --> 00:16:28,150
لن أعود إلى هذه الغرفة

240
00:16:30,530 --> 00:16:36,050
على الأقلّ ما دامت هذه الخطوبة لم تُفسَخ

241
00:16:37,550 --> 00:16:39,370
...لكن أنا متأكّدة

242
00:16:41,710 --> 00:16:44,130
أبي، أنا جاهزة

243
00:16:44,300 --> 00:16:45,740
—المعذرة

244
00:16:50,200 --> 00:16:53,060
شيليا-ساما، ماذا تفعلين هنا؟

245
00:16:53,400 --> 00:16:54,950
،قد أكون زوجة أبيك فقط

246
00:16:55,120 --> 00:16:58,910
لكن أيّ أ مّ هذه لا تُودّع ابنتها قبل زواجها؟

247
00:16:59,700 --> 00:17:03,390
رائحة تلك التّنانين كريهة. أشعر بالاشمئزاز

248
00:17:05,160 --> 00:17:07,400
أين أبي؟

249
00:17:07,570 --> 00:17:11,540
إنّه في الخارج يحرص على تنسيق أمتعتكِ

250
00:17:11,710 --> 00:17:15,920
لا بُدّ أنّ غرفتكِ المُرعبة تلك تحتاج للتّطهير

251
00:17:16,090 --> 00:17:18,590
آمل ألّا تتركي أيّ شيء غير ضروريّ
قبل رحيلكِ

252
00:17:18,900 --> 00:17:21,810
سأترك الفِراء الذّهبيّ الخاصّ بالمودل الملكيّ

253
00:17:22,230 --> 00:17:26,720
من فضلك استخدميه لصنع ملابس
لأبي وابنكِ

254
00:17:27,330 --> 00:17:29,990
فِراء الوحوش تُشعرني بالقشعريرة

255
00:17:30,290 --> 00:17:33,070
إنّها نادة جدّاً وثمينة

256
00:17:33,240 --> 00:17:35,440
لا أستحقّها

257
00:17:35,610 --> 00:17:36,980
حقّاً؟

258
00:17:37,400 --> 00:17:40,290
شكراً لكِ على كلّ شيء

259
00:17:40,980 --> 00:17:42,830
!يا للوقاحة

260
00:17:43,000 --> 00:17:46,000
!لا أملك فكرة كيف تمكّنتِ من إغواء الدّوق

261
00:17:47,620 --> 00:17:50,020
،أنا متأكّدة من أنّكِ تعلمين

262
00:17:50,190 --> 00:17:53,660
،لكن حتّى لو أنجبتِ أنتِ والدّوق طفلاً

263
00:17:53,830 --> 00:17:57,800
ابني، لوي، هو الوريث الوحيد
لعائلة مارشالريد

264
00:17:57,970 --> 00:18:00,660
أعلم. فأنا أتزوّج من خارج العائلة

265
00:18:00,830 --> 00:18:03,900
من الآن فصاعداً، سأكرّس نفسي
لخدمة عائلة غالبريث

266
00:18:04,510 --> 00:18:05,710
!ويحكِ

267
00:18:05,880 --> 00:18:09,200
!وجهكِ الخجول هذا كوجه إيليزي-ساما

268
00:18:10,020 --> 00:18:13,350
!دائماً ما تحتكرين الأفضل لنفسكِ

269
00:18:13,520 --> 00:18:16,400
!لا أستطيع تحمّلكِ أو تحمُّل أمّكِ

270
00:18:17,000 --> 00:18:18,410
...إيليزي

271
00:18:18,580 --> 00:18:21,120
كانت هذه المرأة تعرف أمّي؟

272
00:18:21,290 --> 00:18:23,410
أين التقيا يا ترى؟

273
00:18:24,140 --> 00:18:25,320
أصغي إليّ

274
00:18:25,550 --> 00:18:30,930
حتّى لو فسخت خطوبتكما، لم يعد
لديكِ منزل هنا بعد الآن

275
00:18:31,100 --> 00:18:33,700
سأرسلكِ إلى دَير مُباشرة

276
00:18:34,430 --> 00:18:36,040
سأضع ذلك في الحسبان

277
00:18:36,210 --> 00:18:37,880
انتهينا هنا

278
00:18:38,050 --> 00:18:40,340
لا أتحمّل أولئك التّنانين المُزعجين

279
00:18:40,600 --> 00:18:42,650
انصرفي حالاً

280
00:18:42,820 --> 00:18:43,820
حاضرة

281
00:18:52,260 --> 00:18:56,410
من الطّبيعيّ ألا تُحبّني شيليا-ساما

282
00:18:56,580 --> 00:18:59,730
،لا أتصرّف كما ينبغي لابنة كونت أن تتصرّف

283
00:18:59,900 --> 00:19:04,340
لا سيّما أنّني أجري بحثاً مُحرّماً
على أكل الوحوش

284
00:19:05,480 --> 00:19:12,260
لكن يسرّني أنّني تمكّنتُ من سماع
شيء عن أمّي في النّهاية

285
00:19:19,450 --> 00:19:20,580
!أبي

286
00:19:20,750 --> 00:19:24,010
ميلفيرا. هل أنتِ جاهزة للانطلاق؟

287
00:19:24,270 --> 00:19:25,950
أجل. انتهيتُ من حزم أغراضي

288
00:19:26,120 --> 00:19:29,090
يليق بكِ ذلك المعطف

289
00:19:29,260 --> 00:19:32,580
ارتدته إيليزي عندما تزوّجتني

290
00:19:33,180 --> 00:19:34,820
أمّي فعلت ذلك؟

291
00:19:35,490 --> 00:19:39,090
إنّها من الجنوب، أليس كذلك؟

292
00:19:39,260 --> 00:19:42,410
لا بُدّ أنّ شتاء مارشالريد كان صدمة

293
00:19:42,640 --> 00:19:46,910
بالفعل. سرّها رؤية ثلجها الأوّل

294
00:19:47,800 --> 00:19:51,240
تحمّستْ كثيراً لدرجة أنّها أُصيبَتْ
بنزلة برد حالما وصلتْ

295
00:19:51,410 --> 00:19:53,920
أمّي

296
00:19:54,480 --> 00:19:57,520
رغم كلّ شيء، قد تكون إيليزي سخيفة قليلاً

297
00:19:57,690 --> 00:20:00,120
كانت تتصرّف كطفلة دوماً

298
00:20:00,550 --> 00:20:02,040
...على ذكر الأمر

299
00:20:02,340 --> 00:20:06,020
لم أخبركِ بذلك من قبل

300
00:20:06,400 --> 00:20:07,690
أنا آسف

301
00:20:07,860 --> 00:20:09,870
لا تعتذر يا أبي

302
00:20:17,330 --> 00:20:19,630
أتيتُ لأجلكِ يا ميلفيرا

303
00:20:20,060 --> 00:20:21,610
!سموّك

304
00:20:26,590 --> 00:20:30,840
كيف حالكِ يا خطيبتي؟

305
00:20:32,290 --> 00:20:34,310
ما الخطب؟ تبدين خجِلة

306
00:20:34,480 --> 00:20:35,900
...هـ-هـ-هذا لأنّك

307
00:20:36,070 --> 00:20:37,070
لأنّني ماذا؟

308
00:20:37,240 --> 00:20:39,090
!لا تُضايقني

309
00:20:40,840 --> 00:20:46,800
عجيب أمرك، سموّك، أنا مُندهش
من جرأتك على فعل ذلك أمامي

310
00:20:46,970 --> 00:20:48,360
سامحني يا أبي

311
00:20:48,530 --> 00:20:51,680
أنا أحبّ خطيبتي حبّاً جمّاً فحسب

312
00:20:53,200 --> 00:20:54,500
هل جهّزتِ كلّ ما تحتاجينه؟

313
00:20:54,670 --> 00:20:55,670
أجل

314
00:20:56,110 --> 00:20:59,220
أتتخلّصين من كلّ هذا؟ هذا كثير

315
00:20:59,390 --> 00:21:02,110
كلّها ملحوظات أو ألواح خشبيّة

316
00:21:02,280 --> 00:21:05,700
دوّنتُها عندما نفد الورق لديّ

317
00:21:05,870 --> 00:21:08,040
هل أستطيع حرقها إذاً؟

318
00:21:08,210 --> 00:21:09,620
أعتقد بأنّ مُناسب

319
00:21:10,410 --> 00:21:15,910
في هذا الصّدد، الكونت مارشالريد، سآخذ ابنتك معي

320
00:21:20,540 --> 00:21:23,510
ميلفيرا، أراكِ في الرّبيع

321
00:21:23,680 --> 00:21:25,310
...بخصوص ذلك

322
00:21:25,480 --> 00:21:27,420
قد لا تتمكّن من العودة حينها

323
00:21:27,800 --> 00:21:31,200
سأحتفظ بها معي حتّى زفافنا في الخريف

324
00:21:31,370 --> 00:21:36,260
ماذا؟ لكن يجب علينا جمع كلّ شيء
تحتاجه للزّواج من عائلتك

325
00:21:36,430 --> 00:21:39,050
لا داعي. سأوفّر كلّ ما تحتاجه

326
00:21:39,220 --> 00:21:40,310
ماذا؟

327
00:21:43,180 --> 00:21:45,530
سموّك، ما زالت هناك المزيد
!من الأمور لمُناقشتها

328
00:21:45,700 --> 00:21:48,360
!أبي، ليس عليك القلق

329
00:21:48,530 --> 00:21:50,690
!سوف أحمي ميلفيرا

330
00:21:50,860 --> 00:21:54,020
!فأنا أملك المركز والقوّة لفعل ذلك

331
00:21:54,190 --> 00:21:59,720
بالمناسبة، سيكون حرق هذه النّفايات
مهمّة مُضجِرة بالنّسبة لكم

332
00:22:00,680 --> 00:22:02,790
أنا بمزاج جيّد اليوم

333
00:22:02,960 --> 00:22:04,570
سأتخلّص منها لأجلكم

334
00:22:09,570 --> 00:22:12,010
!أنت تُبالغ كثيراً، سموّك

335
00:22:12,600 --> 00:22:13,990
سامحني

336
00:22:14,160 --> 00:22:15,690
كلاود، صحيح؟

337
00:22:16,070 --> 00:22:18,160
أنت تتمتّع بالإمكانيّات

338
00:22:18,330 --> 00:22:19,560
تعال واخدم عائلة غالبريث

339
00:22:19,730 --> 00:22:21,160
سأخصّص مكاناً لك

340
00:22:21,330 --> 00:22:23,030
!مـ-محال أن أفعل

341
00:22:30,000 --> 00:22:36,260
بدت النّيران الّتي تتصاعد عالياً نحو
السّماء بدت كألعاب ناريّة

342
00:22:36,430 --> 00:22:38,950
احتفاء بحياتنا الجديدة معاً

343
00:24:11,160 --> 00:24:13,870
"الحلقة القادمة: "اللّيل في حصن ريتيرد