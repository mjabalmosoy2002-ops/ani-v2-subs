1
00:00:05,080 --> 00:00:06,730
ألن تزيل هذا؟

2
00:00:07,010 --> 00:00:07,910
لا

3
00:00:08,430 --> 00:00:13,050
فيلق النّسر المُتوهّج الّذي
تركناه هناك قد يجد شيئاً

4
00:00:13,490 --> 00:00:14,740
هذا صحيح

5
00:00:16,900 --> 00:00:18,160
ما الأمر يا مولان؟

6
00:00:18,860 --> 00:00:20,880
...في الواقع، أقصد

7
00:00:20,880 --> 00:00:26,620
أليست غرفة تيري الخاصّة بك وغرفة شييل
الخاصّة بميلفيرا-ساما مُتّصلين بباب داخليّ؟

8
00:00:27,250 --> 00:00:30,130
ألا يجعلك هذا مُتوتّراً؟

9
00:00:30,680 --> 00:00:32,630
ليس لديّ أي دوافع خفيّة

10
00:00:32,940 --> 00:00:35,250
...أعلم، لكن

11
00:00:35,250 --> 00:00:38,760
مولان، هل رأيت الطّائر الّذي
يقود ذلك السّرب؟

12
00:00:40,750 --> 00:00:43,270
،قد يصطاد أولئك الطّيور الوحوش بشكل جماعي

13
00:00:43,890 --> 00:00:46,430
لكن لم أتعرّض لمُطارَدة شرِسة كهذه من قبل

14
00:00:46,730 --> 00:00:50,180
لا بُدّ أنّ البيرغينون الأكبر كان قائدهم

15
00:00:50,180 --> 00:00:54,660
عندما انقضضتُ على السّرب، كان الوحيد
الّذي لم يبتعد عن مساري

16
00:00:55,490 --> 00:00:58,480
لم يهَب تنّيناً جليديّاً، صحيح؟

17
00:00:59,040 --> 00:01:01,960
هل تعتقد بأنّه كان مسعوراً؟

18
00:01:02,510 --> 00:01:03,640
على الأغلب

19
00:02:47,520 --> 00:02:52,260
إذا كان مولان يعتقد ذلك، فمن
المُؤكّد أنّه كان مسعوراً

20
00:02:53,050 --> 00:02:56,210
الوحش الطّائر الأكبر بينهم

21
00:02:56,210 --> 00:02:59,610
ابتلع دون خوف قارورتنا الّتي تحتوي
على قوّة سحريّة هائلة

22
00:03:00,690 --> 00:03:03,690
لا بُدّ أنّ تراكمَ السّموم السّحريّة
،دفعه للجنون

23
00:03:03,690 --> 00:03:06,170
وهاجَ أثناء قيادة السّرب

24
00:03:06,750 --> 00:03:08,960
أمسى الأمر مفهوماً الآن

25
00:03:11,750 --> 00:03:13,620
،على أيّ حال، سموّك

26
00:03:14,260 --> 00:03:18,080
متى طوّرت تلك التّعويذة المُروّعة؟

27
00:03:18,080 --> 00:03:20,650
ظننتُ نفسي في عداد الموتى

28
00:03:22,420 --> 00:03:25,510
فعّلتُ دائرة السّحر فحسب

29
00:03:25,510 --> 00:03:27,490
ميلفي هي من ابتكرتها

30
00:03:29,370 --> 00:03:34,050
عملَتْ بجدّ عليها. كيف يجرؤ
!على وصفها بالمُروّعة؟

31
00:03:34,530 --> 00:03:39,990
أعترف بأنّ نتاج بحث ميلفيرا يمكن
،أن يُستخدَم كسلاح ضدّ البلاد

32
00:03:39,990 --> 00:03:41,900
لكن هذا كلّ شيء من حيث كيفيّة استخدامه

33
00:03:41,900 --> 00:03:43,450
لم ترتكب أي خطأ

34
00:03:44,570 --> 00:03:49,890
رغم ذلك، كم شخصاً في بلدنا يمتلك
المعرفة والمهارة

35
00:03:49,890 --> 00:03:51,950
لتشكيل مثل هذه الدّوائر السّحريّة؟

36
00:03:52,970 --> 00:03:58,640
من أجل حماية ميلفيرا، سأحتاج
لتسخير مُساعدة مَن أثق بهم

37
00:03:59,690 --> 00:04:02,470
أشخاص مثل مولان

38
00:04:09,770 --> 00:04:15,590
أرغب في مُناقشة شيء يخصّ
"التّعويذة المُروّعة"

39
00:04:15,590 --> 00:04:16,360
ماذا؟

40
00:04:23,850 --> 00:04:27,940
أرغب في السّماع عنها كذلك

41
00:04:27,940 --> 00:04:29,270
!كـ-كايوس؟

42
00:04:29,270 --> 00:04:30,700
!سيّدي

43
00:04:31,070 --> 00:04:33,110
لماذا أشهرت سيفك؟

44
00:04:33,110 --> 00:04:35,660
!أ-أنت... دخلتَ فجأة

45
00:04:36,170 --> 00:04:37,830
!لا تُفاجئني هكذا

46
00:04:37,830 --> 00:04:41,590
هذا الباب الخفيّ هو للحالات الطّارئة فقط

47
00:04:43,300 --> 00:04:44,910
...بئساً

48
00:04:45,620 --> 00:04:48,610
!رأسك هو الطّارئ، سموّك

49
00:04:49,090 --> 00:04:54,110
لماذا أرشدت ميلفيرا-ساما
إلى غرفة شييل بهذه السّرعة؟

50
00:04:54,110 --> 00:04:59,480
استخدمتُ سحرَ التّسارع للعودة بعجلة وذلك كي
أتمكّن من الانتظار أمام البوّابة العظيمة

51
00:04:59,750 --> 00:05:02,080
أ-أعتذر

52
00:05:02,080 --> 00:05:06,310
ارتأيتُ بأنّه ينبغي لميلفيرا
أن تسترخي أوّلاً

53
00:05:06,310 --> 00:05:07,740
!ينبغي لها ذلك بالطّبع

54
00:05:07,740 --> 00:05:12,630
لهذا جمعتُ بعجالة خادمات غرف
يخدمنَ السّيّدات النّبيلات

55
00:05:12,630 --> 00:05:15,380
!من أجل استقبالها

56
00:05:20,620 --> 00:05:23,140
أ-أختي؟

57
00:05:23,430 --> 00:05:24,460
حسناً؟

58
00:05:24,460 --> 00:05:29,460
لم تترك ميلفيرا-ساما في غرفة شييل، صحيح؟

59
00:05:31,400 --> 00:05:34,800
لديك عقل راجح عندما يتعلّق
،الأمر بالمعارك

60
00:05:34,800 --> 00:05:39,010
لكن يجب أن تُدرك بأنّك لا تفقه
شيئاً حول هذه الأمور

61
00:05:39,010 --> 00:05:40,430
لقد تحمّستَ زيادة عن اللّزوم

62
00:05:45,330 --> 00:05:48,160
لم أترك ميلفيرا لوحدها أبداً

63
00:05:48,160 --> 00:05:50,700
خصّصتُ شركة بلانش لأجلها

64
00:05:50,700 --> 00:05:52,280
شركة بلانش؟

65
00:05:52,710 --> 00:05:56,100
سيكون الحرس الشّخصيّ لميلفيرا
في كافّة الأحوال

66
00:05:56,100 --> 00:05:59,530
لا ضير من جعلهم يتلاقون عاجلاً غير آجل

67
00:06:00,030 --> 00:06:03,670
أعتقد بأنّها ليست فكرة سيّئة بالنّسبة لك

68
00:06:04,580 --> 00:06:07,170
،أعتذر على التأخُّر بعد استدعائكن إلى هنا

69
00:06:07,170 --> 00:06:10,680
يا سيّدة لافورغ، سيّدة جوردان، وسيّدة سيرو

70
00:06:11,140 --> 00:06:15,580
تلتقي ميلفيرا-ساما حاليّاً مع شركة بلانش

71
00:06:15,580 --> 00:06:19,690
هل يمكنكن الانتظار قليلاً قبل إحضار
فُستان وأشياء أُخرى لها؟

72
00:06:19,690 --> 00:06:24,280
من فضلك يا كايوس. ليس عليك
الاعتذار من أمّك

73
00:06:24,280 --> 00:06:28,710
بالفعل، فالدّوق قد تحمّس قليلاً فحسب

74
00:06:28,710 --> 00:06:32,200
لكن من الواضح أنّه يحبّها

75
00:06:32,200 --> 00:06:34,320
!نحن مُتحمّسات لِلقائها

76
00:06:34,820 --> 00:06:36,740
أليس كذلك يا مولان؟

77
00:06:36,740 --> 00:06:38,200
...أ-أجل

78
00:06:38,410 --> 00:06:40,600
لنستمتع ببعض الشّاي إذاً

79
00:06:40,600 --> 00:06:42,270
اشتريتُ أوراقَ ذات جودة عالية

80
00:06:42,270 --> 00:06:44,710
يمكننا أن نأكل معه بعضاً من خبزي كذلك

81
00:06:44,710 --> 00:06:46,480
!كم هذا رائع

82
00:06:51,180 --> 00:06:52,570
هل أنت جادّ؟

83
00:06:52,570 --> 00:06:55,330
من يجعل أمّه تعمل كخادمة غرف؟

84
00:06:55,840 --> 00:06:58,890
لا يوجد أحدٌ آخر أثق به أكثر منها

85
00:06:59,500 --> 00:07:03,270
لديها خبرة من خلال الاعتناء بك
عندما كنتَ طفلاً

86
00:07:03,270 --> 00:07:06,540
إنّها مثاليّة لرعاية ميلفيرا-ساما

87
00:07:06,540 --> 00:07:09,730
...قـ-قد يكون هذا صحيحاً، لكن

88
00:07:10,050 --> 00:07:13,500
...المعذرة يا سيّد كايوس

89
00:07:13,500 --> 00:07:16,360
ماذا تفعل أختي هنا؟

90
00:07:16,360 --> 00:07:18,750
إنّها مُجرّد خبّازة

91
00:07:19,100 --> 00:07:24,130
السّيّدة سيرو هي امرأة مُدهشة تزوّجت
وتولّت أعمال متجر العائلة

92
00:07:24,130 --> 00:07:27,640
بعد أن أصبح أخوها فارساً ولم يبقَ
أحدٌ آخر ليخلف المتجر

93
00:07:28,820 --> 00:07:30,730
أختك جريئة

94
00:07:30,730 --> 00:07:34,640
لا، معك حقّ. لطف منك أن تقول ذلك

95
00:07:34,960 --> 00:07:38,900
والسّيّدة جوردان هي زوجة
فارس من غالبريث

96
00:07:38,900 --> 00:07:40,870
لكن هذه ليست إلّا مهمّة مؤقّتة

97
00:07:40,870 --> 00:07:43,260
سأختار خادمات غرف جديدات يوماً ما

98
00:07:45,520 --> 00:07:49,270
،لا أعترض على خيارات كايوس

99
00:07:49,270 --> 00:07:53,530
لكنّه مُحتسب بشكل مُروّع دوماً

100
00:07:54,860 --> 00:07:56,050
...حسناً إذاً

101
00:08:00,910 --> 00:08:02,930
لنُكمل من حيث توقّفنا

102
00:08:03,510 --> 00:08:07,290
أخبراني بكلّ ما يمكن معرفته
حول تلك التّعويذة

103
00:08:08,800 --> 00:08:13,800
،عرفتُ بأنّك تمتلك قوّة سحريّة غير محدودة

104
00:08:13,800 --> 00:08:15,720
!لكن ماذا كان ذلك؟

105
00:08:15,720 --> 00:08:20,160
هل توحّدتَ مع غابة إيرزين
!لأنّها تحبّها كثيراً؟

106
00:08:20,160 --> 00:08:25,020
"هل أبدأ بمُناداتك بأسماء مثل "البُركان السّائر
!أو "مُولّد السّحر"؟

107
00:08:29,770 --> 00:08:33,450
هل تعتقد بأنّ أحداً آخر قد لاحظ؟

108
00:08:33,710 --> 00:08:35,100
وما أدراني؟

109
00:08:35,100 --> 00:08:37,200
ما رأيك يا مولان؟

110
00:08:37,200 --> 00:08:40,060
...ماذا؟ فـ-في الواقع

111
00:08:40,060 --> 00:08:44,700
،لستُ أفهم ما تقصده بالضّبط
...لكن لوهلة

112
00:08:50,130 --> 00:08:54,660
تلك التّعويذة الّتي فجّرتْ سربَ
البيرغينون إلى أشلاء

113
00:08:54,660 --> 00:08:57,090
قد أنشئت بواسطة ميلفيرا-ساما

114
00:08:58,630 --> 00:09:00,540
!ميلفيرا-ساما؟

115
00:09:00,540 --> 00:09:06,600
المُروِّع... أقصد ذلك الانفجار الّذي لا يُصدَّق؟

116
00:09:07,160 --> 00:09:11,610
كانت ميلفيرا مُستميتة لإنقاذي فحسب

117
00:09:12,680 --> 00:09:16,270
استخدمتْ قوّةَ السّحر الخاصّة بالزّاناس

118
00:09:16,270 --> 00:09:19,270
الزّاناس الّذي أكلناه على الفطور؟

119
00:09:20,340 --> 00:09:21,180
أجل

120
00:09:21,560 --> 00:09:24,560
دوّنتْ ميلفيرا كلّ تعويذة خطرتْ على ذهنها

121
00:09:24,560 --> 00:09:28,520
على تلك القارورة المليئة بالقوّة
السّحريّة وسلّمتْني إيّاها

122
00:09:28,970 --> 00:09:31,810
أنا فعّلتُها فحسب

123
00:09:32,630 --> 00:09:35,520
لا، لحظة. هذا غير مُمكن

124
00:09:35,520 --> 00:09:38,010
هل ميلفيرا-ساما عبقريّة أم ماذا؟

125
00:09:38,010 --> 00:09:40,340
أجل، إنّها عبقريّة

126
00:09:41,500 --> 00:09:43,890
أتفهّم ذهول مولان

127
00:09:44,800 --> 00:09:47,360
مُعظم التّعويذات المُعاصرة

128
00:09:47,360 --> 00:09:51,960
هي عزائم انسيابيّة ومُبسَّطة

129
00:09:52,400 --> 00:09:55,920
بينما قيل بأنّ التّعويذات القديمة عبارة عن حكمة

130
00:09:55,920 --> 00:10:00,450
تُمنَح للنّاس بواسطة الأرواح
في الزّمن القديم

131
00:10:00,450 --> 00:10:04,410
إنّه سحر مهجور بالكاد بات يدرسه أحد

132
00:10:04,930 --> 00:10:08,790
لكنّها تعلّمتْ ذاتيّاً وتمكّنتْ من رسم
تلك الدّائرة السّحريّة المُدهشة

133
00:10:09,280 --> 00:10:12,360
مولان على حقّ. إنّها عبقريّة بلا شكّ

134
00:10:13,650 --> 00:10:17,950
كايوس، أفترض بأنّك تعتني بمواد
البحث الخاصّة بميلفيرا

135
00:10:17,950 --> 00:10:19,960
أجل، أنا حريص جدّاً

136
00:10:19,960 --> 00:10:25,760
وحتّى أنّني وضعتُ أختامَ إضافيّة على القارورة
الّتي تحتوي على قوّة السّحر الخاصّة بالمودل الملكيّ

137
00:10:26,340 --> 00:10:28,120
سيَفي ذلك بالغرض حاليّاً

138
00:10:28,120 --> 00:10:30,810
هناك الكثير من الاستخدامات المُسالمة لها

139
00:10:31,270 --> 00:10:36,190
إلى أن يُحسَم الوضع، لا تُخبر أحداً
بما سمعته للتو يا مولان

140
00:10:36,190 --> 00:10:38,000
!حـ-حاضر، سموّك

141
00:10:38,000 --> 00:10:40,870
لـ-لكن لماذا تخبرني؟

142
00:10:41,090 --> 00:10:42,570
...بخصوص ذلك

143
00:10:43,110 --> 00:10:47,990
أريدك أن تحمي ميلفيرا مع شركة بلانش

144
00:10:49,650 --> 00:10:52,700
،ستستأنف واجباتك كفارس تنّين

145
00:10:52,700 --> 00:10:55,030
لكن ستحميها أيضاً إن لزم الأمر

146
00:10:55,030 --> 00:10:58,510
ماذا؟ ألن تكون بأمان في ميدلايغ؟

147
00:10:58,860 --> 00:11:01,260
يوجد كثير من النّاس في هذه الأرجاء

148
00:11:01,650 --> 00:11:05,830
حضّرتُ غرفة معزولة كنتُ أستخدمها
،لتجعل منها مُختبر أبحاثها

149
00:11:05,830 --> 00:11:08,020
لكن يجب ألّا يُصيبها شيء

150
00:11:10,040 --> 00:11:13,270
لن أمنع بحث ميلفيرا

151
00:11:13,690 --> 00:11:18,280
،إذا سمح ذلك لنا بأكل الوحوش بأمان

152
00:11:18,280 --> 00:11:20,910
فسوف تتغيّر غالبريث للأفضل

153
00:11:21,690 --> 00:11:23,760
أعتمد عليك يا مولان

154
00:11:24,290 --> 00:11:25,770
عُلِم، سموّك

155
00:11:30,460 --> 00:11:33,580
سيترتّب عليّ مُناقشة هذا مع ميلفي أيضاً

156
00:11:35,030 --> 00:11:37,260
إنّها شخصٌ طيّب

157
00:11:37,890 --> 00:11:43,710
من المُمكن أنّها لا تفهم أنّه يوجد أشخاص
مُستعدّون لاستخدام بحثها لغرض الشّرّ

158
00:11:46,130 --> 00:11:49,940
الأمور بخير. سوف أحميها

159
00:11:54,030 --> 00:11:55,980
ينبغي أن نتكلّم

160
00:11:57,090 --> 00:11:59,490
كايوس...؟

161
00:12:03,910 --> 00:12:05,980
...أثناء غيابي

162
00:12:06,440 --> 00:12:08,610
ماذا تفعل؟

163
00:12:08,610 --> 00:12:10,620
أكلتَ من دوني، أليس كذلك؟

164
00:12:11,110 --> 00:12:13,630
!هاتان العينان... إنّه لا يبتسم إطلاقاً

165
00:12:15,660 --> 00:12:17,890
لماذا تفعل ذلك؟

166
00:12:18,420 --> 00:12:20,200
عمّاذا تتكلّم؟

167
00:12:20,810 --> 00:12:24,590
الزّاناس الشّهيّ الّذي حضّرَتْه ميلفيرا-ساما

168
00:12:25,710 --> 00:12:27,620
هل تناولته أيضاً يا مولان؟

169
00:12:27,620 --> 00:12:28,840
!أ-أجل

170
00:12:29,440 --> 00:12:33,440
فهمت. الزّاناس في موسمه حاليّاً

171
00:12:33,440 --> 00:12:35,860
وتناولتُماه على الفطور من دوني

172
00:12:38,360 --> 00:12:39,980
!احترس، سموّك

173
00:12:39,310 --> 00:12:40,950
المعذرة، سموّك

174
00:12:40,980 --> 00:12:41,720
!اهدأ

175
00:12:41,720 --> 00:12:42,810
!لا أعتقد ذلك

176
00:12:42,810 --> 00:12:44,190
!ستؤذي أحداً

177
00:12:42,840 --> 00:12:46,300
سيّد كايوس والقائد مولان، أنتما هنا أيضاً؟

178
00:12:46,300 --> 00:12:47,360
...في الحقيقة

179
00:12:48,080 --> 00:12:49,190
ماذا؟

180
00:12:50,100 --> 00:12:51,860
...لا

181
00:12:52,170 --> 00:12:58,020
الرّجال الّذين تركناهم خلفنا أبلغوا
بأنّ بعض البيرغينون قد هاجوا

182
00:12:58,020 --> 00:13:03,010
هل هذا طارئ لدرجة أنّه يجب عليك
أن تشنّ إغارة لإسقاطهم؟

183
00:13:03,460 --> 00:13:06,890
هذا حدث يوميّ في غالبريث

184
00:13:09,610 --> 00:13:12,730
كنتُ أنوي أن آخذكِ في جولة تعريفيّة

185
00:13:12,730 --> 00:13:15,640
أنا آسف لحدوث هذا حال وصولكِ

186
00:13:15,930 --> 00:13:17,550
لـ-لا عليك

187
00:13:18,450 --> 00:13:22,910
المعذرة، هل من شيء أستطيع فعله؟

188
00:13:25,510 --> 00:13:28,120
ليتني أستطيع البقاء معك

189
00:13:28,120 --> 00:13:32,160
لكن وحوش الطّائر المسعورة
قد تُهاجم بلدات أو قُرى

190
00:13:32,530 --> 00:13:34,090
انتظريني هنا

191
00:13:36,910 --> 00:13:40,380
لا تقلقي. سأهتمّ بأمرهم بسرعة

192
00:13:40,380 --> 00:13:42,800
حسناً، سموّك

193
00:13:43,850 --> 00:13:45,910
كلّا يا ميلفي

194
00:13:48,930 --> 00:13:51,180
بماذا يُفترض أن تُناديني؟

195
00:13:54,390 --> 00:13:55,420
!بئساً

196
00:13:55,420 --> 00:14:00,310
ا-الدّوق آريستيد، لماذا تحبّ إحراجي؟

197
00:14:00,310 --> 00:14:03,620
!تـ-تولّ أمر أولئك الوحوش وعُد بسرعة

198
00:14:05,570 --> 00:14:07,940
أنا لا أُحاول إحراجكِ

199
00:14:08,650 --> 00:14:10,700
لا تأخذني على حين غرّة هكذا

200
00:14:11,440 --> 00:14:15,190
ميلفي، هل تتذكّرين واجبات الدّوقة؟

201
00:14:15,890 --> 00:14:19,960
تقدير وتهدئة الدّوق

202
00:14:20,610 --> 00:14:22,450
لا تستائي منّي كثيراً

203
00:14:22,880 --> 00:14:26,740
أجد جانبكِ الظّريف مُسكِّناً

204
00:14:26,740 --> 00:14:28,340
امنحيني بعض الدّفء

205
00:14:30,970 --> 00:14:34,010
أحقّاً ذلك؟

206
00:14:35,630 --> 00:14:37,100
بالطّبع

207
00:14:37,850 --> 00:14:41,070
عندما أعود، قدّمي لي وجبة شهيّة

208
00:14:41,070 --> 00:14:42,450
قبل أن أنسى

209
00:14:43,090 --> 00:14:46,120
أريد يخنة مُكوّنة من المودل الملكيّ المُتبقّي

210
00:14:47,640 --> 00:14:52,770
الطّعام العاديّ سيَفي بالغرض

211
00:14:52,770 --> 00:14:57,180
،أتعتقدين ذلك؟ ما دام لذيذاً
فلا أُمانع البيرغينون حتّى

212
00:14:57,180 --> 00:15:00,630
أجد من المُحفِّز أن أتخيّل بأنّني
سأغادر بحثاً عن مُكوّنات طعام

213
00:15:02,210 --> 00:15:08,390
الدّوق يؤكّد على أنّه يريد لحمَ وحش

214
00:15:09,040 --> 00:15:13,940
بالتّأكيد على ذلك أمام شركة بلانش
،والفُرسان الآخرين

215
00:15:13,940 --> 00:15:16,900
سيقبلون بحثي بصدر رحب

216
00:15:17,230 --> 00:15:19,510
لا بُدّ أنّ هذه هي نيّته

217
00:15:22,560 --> 00:15:25,580
هل هناك أي وحوش أنتِ مهتمّة بهم؟

218
00:15:25,580 --> 00:15:27,530
سأصطاد واحداً أثناء وجودي في الخارج

219
00:15:29,420 --> 00:15:33,620
سـ-سيكون من الوقاحة طلب
شيء ضخم كهذا

220
00:15:33,620 --> 00:15:38,030
فأساساً، إنّه في طريقه لقتل بيرغينون مسعور

221
00:15:38,030 --> 00:15:41,720
...لكن بما أنّه يعرض مُساعدته

222
00:15:42,400 --> 00:15:47,290
فـ-في هذه الحالة، أريد فاكهة سكريموود

223
00:15:49,820 --> 00:15:51,180
!مرحى

224
00:15:51,480 --> 00:15:55,600
قلتَ بأنّها كانت شيئاً أكلتَه وتحسّرت

225
00:15:55,970 --> 00:15:59,340
...في الواقع، كان ذلك

226
00:15:59,340 --> 00:16:01,830
كان لها رائحة قويّة، أليس كذلك؟

227
00:16:01,830 --> 00:16:06,370
لكن يبدو أنّ السّيّد مولان شعر
!بأنّها أحلى من الرّحيق

228
00:16:06,370 --> 00:16:07,350
أليس كذلك؟

229
00:16:07,350 --> 00:16:08,120
ماذا؟

230
00:16:09,950 --> 00:16:12,990
ميلفيرا-ساما، أين سمعتِ ذلك؟

231
00:16:13,520 --> 00:16:15,370
هذا سرّ

232
00:16:15,940 --> 00:16:20,370
مهلاً يا مولان، هل أنت متأكّد
بأنّها كانت فاكهة سكريموود؟

233
00:16:20,700 --> 00:16:25,620
،أجل، ربّما كانت ناضجة زيادة عن اللّزوم
بما أنّ الفاكهة كانت سوداء

234
00:16:25,620 --> 00:16:28,410
لكن كانت عطِرة وحلوة

235
00:16:28,410 --> 00:16:32,380
امتلأ فمي كلّه بسعادة غامرة

236
00:16:34,710 --> 00:16:38,330
لكن أكلتُ الكثير لدرجة أنّ شطف
فمي بالماء لم يُزِل الطّعم

237
00:16:38,330 --> 00:16:41,230
حلّ عليّ مصيرٌ فظيع لاحقاً

238
00:16:42,110 --> 00:16:47,580
كيف خاضَ شخصان مثل هاتين التّجربتين
المُختلفتين بأكل نفس الفاكهة؟

239
00:16:48,020 --> 00:16:50,020
يراودني فضول شديد

240
00:16:51,870 --> 00:16:55,090
ليس بالضّرورة أن يكون هذا أولويّة حقّاً

241
00:16:55,090 --> 00:16:59,730
الأولويّة لعودتك الآمنة

242
00:17:01,560 --> 00:17:02,960
حسناً

243
00:17:02,960 --> 00:17:04,990
سأحضر بعضاً معي إذا وجدت

244
00:17:06,300 --> 00:17:09,420
حسناً، دعونا ننطلق حتّى
نعود قبل غروب الشّمس

245
00:17:14,720 --> 00:17:16,970
سآخذ هذه كدُفعة مُقدّمة

246
00:17:19,560 --> 00:17:23,810
طلبتُ نقل مواد بحثكِ إلى غرفة
كنتُ أستخدمها

247
00:17:25,110 --> 00:17:27,720
بلانش، أرشدنَها إلى هناك لاحقاً

248
00:17:27,720 --> 00:17:28,800
عُلِم

249
00:17:35,630 --> 00:17:36,880
...سموّك

250
00:17:37,380 --> 00:17:41,210
أريستيد-ساما، انتبه على نفسك رجاء

251
00:17:46,170 --> 00:17:49,130
صباح الخير يا ميلفيرا-ساما

252
00:17:50,030 --> 00:17:52,080
أرى بأنّكِ لم تستطيعي النّوم

253
00:17:52,560 --> 00:17:56,800
أولئك الوحوش الطّائرة هاجمونا
بعنف شديد البارحة

254
00:17:56,800 --> 00:18:00,350
...ليس ذلك فقط، لكن سرباً مسعوراً كاملاً

255
00:18:00,620 --> 00:18:05,700
،فكّرتُ في تقديم قارورة سحر انفجاريّة أُخرى

256
00:18:06,090 --> 00:18:10,860
لكن الوحيدة الّتي تبقّتْ لديّ تحتوي على طاقة
السّحر الخاصّة بالمودل الملكيّ

257
00:18:11,290 --> 00:18:14,100
طاقتها كثيفة وغزيرة

258
00:18:14,100 --> 00:18:18,340
وحتّى أنّ انفجارها قد يطال الدّوق ورجاله

259
00:18:18,730 --> 00:18:22,580
!أكره أنّ كلّ ما يمكنني فعله هو الانتظار

260
00:18:22,960 --> 00:18:26,580
لا مُشكلة. سوف يعود قريباً

261
00:18:28,270 --> 00:18:30,640
والآن تناولي بعض الفطور

262
00:18:31,650 --> 00:18:36,080
يجب أن تكوني مُستعدّة للتّرحيب بسموّه
بابتسامة مُشرقة

263
00:18:37,610 --> 00:18:38,730
حسناً

264
00:18:41,050 --> 00:18:44,990
هذه هي الغرفة الّتي أرشدني الدّوق
بأن أريكِ إيّاها البارحة

265
00:18:46,440 --> 00:18:50,090
من الآن فصاعداً، ستكون مُختبر أبحاثكِ

266
00:18:57,520 --> 00:19:01,230
مُدهش. هذه ليست موادي فحسب

267
00:19:01,620 --> 00:19:04,990
هناك كُتُب ووثائق مُثيرة للاهتمام أيضاً

268
00:19:05,950 --> 00:19:12,080
لكن لسبب ما، لا أشعر بذرّة اهتمام حاليّاً

269
00:19:14,790 --> 00:19:19,440
...في النّهاية، لم يعُد الدّوق في ذلك اليوم

270
00:19:40,020 --> 00:19:42,580
!عاد الدّوق

271
00:19:44,240 --> 00:19:45,980
!سموّك

272
00:19:59,210 --> 00:20:00,670
أنت بخير

273
00:20:02,290 --> 00:20:05,430
آسف لأنّني تأخّرتُ كثيراً

274
00:20:06,190 --> 00:20:07,940
هذا غير مُهمّ

275
00:20:09,200 --> 00:20:10,820
أحضرتُ لكِ هديّة

276
00:20:11,240 --> 00:20:14,800
وجدتُ شيئاً مُثيراً في الغابة

277
00:20:15,420 --> 00:20:18,070
لديّ فاكهة سكريموود كذلك

278
00:20:18,070 --> 00:20:19,740
حقّاً؟

279
00:20:19,740 --> 00:20:22,700
أجل. سأحضرها إلى غرفتكِ لاحقاً

280
00:20:23,220 --> 00:20:28,110
...لكن أوّلاً، أحتاج قيلولة

281
00:20:28,110 --> 00:20:29,690
سموّك؟

282
00:20:32,590 --> 00:20:34,200
سموّك؟

283
00:20:41,480 --> 00:20:48,090
إذاً هذه هي فاكهة سكريموود الشّهيرة
الّتي أحضرها لي الدّوق

284
00:20:49,040 --> 00:20:52,970
لا بُدّ أنّها النّوع الّذي أكله الدّوق

285
00:20:53,690 --> 00:20:57,770
،ذكَرَتِ الموسوعة بأنّ سكريموود حمراء

286
00:20:57,770 --> 00:21:01,730
ولديها رائحة قويّة ومذاقها حامض

287
00:21:02,690 --> 00:21:06,650
سأترك الحمراء في الخارج حاليّاً

288
00:21:19,580 --> 00:21:24,120
مولاتي، هل هذا السّائل المُتوهّج طاقة سحر؟

289
00:21:26,850 --> 00:21:30,970
إنّ استخراج طاقة السّحر من هذا
الشّيء صعب

290
00:21:30,970 --> 00:21:33,380
لا يمكنني ادّخار الجهد للردّ

291
00:21:34,030 --> 00:21:38,480
الوحوش الشّجر لا تموت فعليّاً
ما لم تذبل بشكل كامل

292
00:21:38,480 --> 00:21:40,480
أو تحترق حتّى تغدو رماداً

293
00:21:40,950 --> 00:21:44,520
لكن فاكهتها لا تُؤكَل حالما تذبل

294
00:21:44,520 --> 00:21:47,970
إنّ استخراج طاقة السّحر منها بينما
لا تزال حيّة أشبه بالمستحيل

295
00:21:59,280 --> 00:22:04,200
لا أُصدّق كم عطرها فوّاح بعد
استخراج طاقة السّحر

296
00:22:04,550 --> 00:22:07,750
هل كان الأمر مُختلفاً عندما أكلتِ واحدة؟

297
00:22:07,750 --> 00:22:09,670
كان لها رائحة كريهة صادمة

298
00:22:09,670 --> 00:22:13,000
كريهة" غير كافية حتّى لوصف"
مدى فظاعة تلك الرّائحة

299
00:22:13,520 --> 00:22:17,160
ولم تكن سوداء هكذا

300
00:22:17,160 --> 00:22:20,410
كانت كالّتي وضعناها في الخارج

301
00:22:20,410 --> 00:22:23,290
خُدِعنا بواسطة مظهرها

302
00:22:25,320 --> 00:22:27,520
إنّها سوداء

303
00:22:27,520 --> 00:22:31,540
...ليست مُشهّية، لكن

304
00:22:34,040 --> 00:22:37,360
!الرّائحة تحثّ رغبتي على قضمها

305
00:22:37,360 --> 00:22:38,930
!حُلوة للغاية

306
00:24:11,120 --> 00:24:14,800
"الحلقة القادمة: "فاكهة حُلوة أو حامضة