1
00:00:02,720 --> 00:00:06,220
العديد من الدّيساس العدوّ يقتربون
!من البوّابة الرئيسيّة

2
00:00:11,980 --> 00:00:14,740
،ظهر ديساس في مدينة ناها

3
00:00:14,850 --> 00:00:17,450
تأكّدنا من وجود ديساس مُعدّل من فئة هالوين

4
00:00:17,650 --> 00:00:20,700
أدفِعوهم الصّاع صاعين على ما فعلوه
!في الحرب العظيمة

5
00:00:24,110 --> 00:00:25,250
...الجنرال تابيرا

6
00:00:25,250 --> 00:00:27,840
تراجعي إلى عالم الرُّوح من فضلك

7
00:00:29,490 --> 00:00:31,100
،إذا أصابَكِ أي مكروه

8
00:00:31,100 --> 00:00:33,910
فستكون خسارة للبشريّة جمعاء

9
00:00:36,260 --> 00:00:37,930
!أغلِقَ الجسر

10
00:00:38,410 --> 00:00:42,270
بما أنّ العدوّ استخدم متفجّرات بعديّة
...الآن، فهذا يعني

11
00:00:42,940 --> 00:00:45,270
أنّه لا يستهدف ناها السّادس

12
00:00:46,200 --> 00:00:47,620
!هدفهم هو الجنرال تابيرا

13
00:01:04,000 --> 00:01:05,200
...لا

14
00:01:05,200 --> 00:01:06,430
هنا أيضاً؟

15
00:01:06,430 --> 00:01:08,130
!لنهرب يا ساياكو

16
00:02:54,370 --> 00:02:56,440
يبدو أنّنا نجونا من الموجة الأولى

17
00:02:56,910 --> 00:03:00,260
قد نتمكّن من تولّي هذا الأمر بمفردنا

18
00:03:00,260 --> 00:03:01,690
مستحيل

19
00:03:01,690 --> 00:03:03,410
نحتاج للفتياتِ السحريّات

20
00:03:03,410 --> 00:03:07,280
هُنَّ وحوش أيضاً، مثل الدّيساس

21
00:03:07,280 --> 00:03:08,870
لا يمكننا الوثوق بهم على ما أعتقد

22
00:03:15,850 --> 00:03:16,720
،أنت

23
00:03:17,360 --> 00:03:19,410
هل رأيت الفتيات السحريّات؟

24
00:03:19,410 --> 00:03:20,510
لمحتُهن فقط

25
00:03:21,920 --> 00:03:24,300
...إنّهن في مثل سنّ ابنتي

26
00:03:24,730 --> 00:03:27,200
ويُفترض أن يكُنّ ورقتنا الرّابحة

27
00:03:27,200 --> 00:03:28,470
هذا يُقلقني

28
00:03:28,470 --> 00:03:31,040
إنّهن مُراهِقات

29
00:03:31,040 --> 00:03:33,740
لديهن أمور أخرى يفعلونها في الحياة

30
00:03:33,740 --> 00:03:35,730
تختلف الأمور عمّا كانت أثناء الحرب

31
00:03:35,730 --> 00:03:38,480
...آمل أن نتمكّن من إيقافهم هنا، لكن

32
00:03:39,050 --> 00:03:39,870
!ها هم

33
00:03:40,670 --> 00:03:41,900
!استعدّوا لإطلاق النّار

34
00:03:42,350 --> 00:03:43,340
!هؤلاء هم

35
00:03:43,670 --> 00:03:44,490
!أطلقوا

36
00:03:48,240 --> 00:03:49,410
!جاهز

37
00:03:52,820 --> 00:03:53,960
!سقط عدوّ

38
00:03:54,140 --> 00:03:56,080
هذا عمل ممتع

39
00:04:34,500 --> 00:04:39,570
كان من المُفترَض أن يكون التغلُّب العدديّ
من تخطيطات الرُّوس

40
00:04:40,780 --> 00:04:44,030
حلفاؤنا قد أمّنوا سلامة مناطق الدّفاع الرئيسيّة

41
00:04:44,030 --> 00:04:47,210
مُعظم وحدات العدوّ الجويّة التي هاجمت
الطرفَ الشّمالي

42
00:04:47,210 --> 00:04:49,010
قد أبيدَتْ

43
00:04:50,680 --> 00:04:54,170
نجونا من الهجومِ الأوّل

44
00:04:54,170 --> 00:04:57,100
،البوّابة الرئيسيّة الشرقيّة تصمد بشكلٍ جيّد

45
00:04:57,100 --> 00:05:00,160
بفضلِ لوائنا ومورغ

46
00:05:01,250 --> 00:05:03,220
،الفرقة م تتولّى الطرفَ الجنوبي

47
00:05:03,220 --> 00:05:06,530
وفينيكس من روسيا تتولّى الشّمال

48
00:05:06,720 --> 00:05:08,530
ماذا عن وحداتنا الاحتياطيّة؟

49
00:05:08,530 --> 00:05:11,010
لدينا سريّة من المُشاة

50
00:05:11,960 --> 00:05:14,970
،من دون فكرة عمّا بقي من قوّات العدوّ

51
00:05:14,970 --> 00:05:17,500
أنا متردّدٌ من إرسالهم

52
00:05:17,940 --> 00:05:22,300
هدفنا الآن هو الحفاظ على خطوطنا الدفاعيّة
والاستمرار في استنزافِ العدوّ

53
00:05:22,300 --> 00:05:24,390
لنرَ ما يفعلون تالياً

54
00:05:29,800 --> 00:05:32,070
!لم أعد قادرة على التحمُّل

55
00:05:32,070 --> 00:05:33,600
!لنبتعد لأطول مسافة ممكنة

56
00:05:50,780 --> 00:05:52,410
!اهربا! بسرعة! بسرعة

57
00:05:52,950 --> 00:05:54,120
!نوزو-تشان

58
00:05:56,580 --> 00:05:57,790
نوزو-تشان؟

59
00:06:00,040 --> 00:06:01,090
أنا آسفة

60
00:06:01,540 --> 00:06:03,640
لا أستطيع المواصلة

61
00:06:05,310 --> 00:06:07,890
ساياكو، اذهبي بمفردكِ

62
00:06:07,890 --> 00:06:09,170
!نوزو-تشان

63
00:06:10,380 --> 00:06:13,370
،لا أستطيع المشي على هذه السّاق

64
00:06:13,370 --> 00:06:14,140
حسناً؟

65
00:06:17,940 --> 00:06:19,130
ساياكو؟

66
00:06:19,700 --> 00:06:20,810
...أنا

67
00:06:23,470 --> 00:06:26,520
لا أريد أن أهرب

68
00:06:27,940 --> 00:06:30,990
لا أستطيع أن أهرب وأترككِ

69
00:06:44,430 --> 00:06:47,370
!أريد أن أكون قويّة

70
00:06:54,340 --> 00:06:58,520
يبدو أنّ فئات الهالوين تسبّب ضرراً جسيماً
في مركز المدينة

71
00:06:58,520 --> 00:07:02,600
رُماة الحبّات الصّغيرة الذين تمتلكهم الشّرطة
ليسوا ندّاً لهم، غي

72
00:07:02,790 --> 00:07:07,740
تهيّأ العدوُّ للدفاعِ عن مقرّه والعنبر في الطرف
الشّمالي، غي

73
00:07:07,740 --> 00:07:12,610
الشيء الذي نستهدفه موجود تحت
ذلك العنبر، صحيح؟

74
00:07:12,610 --> 00:07:13,560
أجل

75
00:07:13,560 --> 00:07:15,410
لكنّه سيكون محميّاً بشكل مُكثَّف

76
00:07:15,820 --> 00:07:18,000
،من حيث القتال الداخليّ من مسافات قريبة

77
00:07:18,000 --> 00:07:20,610
رابشر هي الأقوى بين السحريّات الخمس

78
00:07:20,610 --> 00:07:24,890
هي وممرّضة الحرب على الأرجح
في الخطّ الدفاعي الأخير

79
00:07:25,300 --> 00:07:26,380
،تشيساتو

80
00:07:26,380 --> 00:07:28,800
قد تكون هذه بداية شاقّة لكِ في مسيرتكِ

81
00:07:29,460 --> 00:07:30,750
لا مُشكلة

82
00:07:31,040 --> 00:07:33,060
،عندما أصبحتُ فتاة سحريّة

83
00:07:33,060 --> 00:07:37,830
تذكّرتُ كم أنا قويّة

84
00:07:46,720 --> 00:07:47,730
هل أنتما بخير؟

85
00:07:48,300 --> 00:07:49,690
!ابتعدي عنّي

86
00:07:53,310 --> 00:07:54,100
،حسناً

87
00:07:54,100 --> 00:07:55,370
من الطبيعي أن يخافا

88
00:08:11,120 --> 00:08:14,010
...سمعتُ أنّ هناك ديساس من فئة هالوين

89
00:08:14,910 --> 00:08:19,220
لكن ثلاثة في آنٍ واحد سيجعلها معركة ممتعة

90
00:08:20,460 --> 00:08:24,480
وحداتنا تكبّدَ صفوف العدوّ البرّية خسائرَ فادحة

91
00:08:24,480 --> 00:08:29,410
لا أثر لوحدات جويّة أو مدفعيّة للعدوّ

92
00:08:29,410 --> 00:08:33,440
جاست كوز من الجيش الأمريكي قد اشتبكَتْ
!مع العدوّ في ناها

93
00:08:34,000 --> 00:08:35,530
هنا مايك 02

94
00:08:35,720 --> 00:08:37,900
!تمّ تأكيد وجود عدد من فئات هالوين

95
00:08:38,110 --> 00:08:39,010
!تبّاً

96
00:08:44,390 --> 00:08:47,120
مُحال أن ننجو من هذا

97
00:08:47,120 --> 00:08:48,920
ألم يحن الوقت للكشفِ عن ورقتِنا الرّابحة؟

98
00:08:49,370 --> 00:08:50,870
!أؤيّد ذلك

99
00:08:52,460 --> 00:08:54,140
!فيكتور! فيكتور

100
00:08:54,140 --> 00:08:55,340
!هنا مايك 01

101
00:08:55,600 --> 00:08:56,910
!هنا فيكتور

102
00:08:56,910 --> 00:09:00,680
أطلب دعماً ناريّاً سحريّاً نحو الدّيساس الضِّخام
في الطّرف الجنوبي

103
00:09:00,680 --> 00:09:01,470
!حوّل

104
00:09:01,470 --> 00:09:02,810
!فيكتور، عُلِم

105
00:09:07,140 --> 00:09:09,300
!جاري تلقيم القذيفة المُعزَّزة سحريّاً

106
00:09:10,530 --> 00:09:14,780
!هدفنا هو مجموعة الدّيساس التي تقترب من البناء 101

107
00:09:14,920 --> 00:09:15,980
!أطلِق

108
00:09:29,250 --> 00:09:30,300
!مرحى

109
00:09:30,300 --> 00:09:31,550
!مذهل

110
00:09:31,550 --> 00:09:32,870
!تمّ تأكيد الإصابة

111
00:09:32,870 --> 00:09:35,300
تمّ القضاء على كافّة الدّيساس الضّخام
في الطرف الجنوبي

112
00:09:35,860 --> 00:09:38,200
!بقيت قذيفة مُعزّزة سحريّاً واحدة

113
00:09:38,920 --> 00:09:40,660
هنا مايك 01

114
00:09:40,660 --> 00:09:43,120
فيكتور، توجّه إلى البوّابة الرئيسيّة الشرقيّة

115
00:09:43,120 --> 00:09:45,080
عليكم بالضِّخام هناك

116
00:09:45,080 --> 00:09:46,510
!فيكتور، عُلم

117
00:09:46,510 --> 00:09:47,350
!حوّل

118
00:09:47,350 --> 00:09:48,650
بقيَتْ قذيفة واحدة؟

119
00:09:49,400 --> 00:09:51,870
ليتنا نملك المزيد منها

120
00:09:52,560 --> 00:09:53,680
حسناً

121
00:09:53,680 --> 00:09:55,980
!لنقضِ على النّاجين الأصغر حجماً

122
00:09:55,980 --> 00:09:57,020
!عُلِم

123
00:10:00,360 --> 00:10:04,680
يعتقدون على الأرجح أنّهم يستطيعون أن يربحوا هذه

124
00:10:04,680 --> 00:10:06,830
لن يحدث هذا، غي

125
00:10:07,070 --> 00:10:09,630
ما يُؤلم الإنسان أكثر هو أن تمنحه
،أملاً في البداية

126
00:10:09,630 --> 00:10:13,530
بدلاً من مجرّد يأس

127
00:10:17,620 --> 00:10:19,720
المعركة لم تبدأ بعد

128
00:10:40,250 --> 00:10:41,970
سأتراجع وألقّم

129
00:11:06,040 --> 00:11:08,220
!سكّين سبيتسناز السحريّة

130
00:11:17,400 --> 00:11:18,650
!هنا غولف 01

131
00:11:18,970 --> 00:11:21,910
العديد من الضحايا بين حلفائنا
!في البوّابة الرئيسيّة الشرقيّة

132
00:11:22,210 --> 00:11:23,710
!هنا غولف ألفا

133
00:11:23,710 --> 00:11:24,880
!لقد أرسلنا تعزيزات

134
00:11:24,880 --> 00:11:25,860
!تماسكوا

135
00:11:27,300 --> 00:11:28,280
أهذه هي؟

136
00:11:31,200 --> 00:11:32,960
!مرحى

137
00:11:33,340 --> 00:11:34,650
هنا مايك 01

138
00:11:34,650 --> 00:11:37,220
فيكتور، نفدت لديك القذائف السحريّة، صحيح؟

139
00:11:37,220 --> 00:11:38,540
تراجع حاليّاً

140
00:11:38,540 --> 00:11:40,330
سيكون التّراجع صعباً

141
00:11:40,330 --> 00:11:42,540
سنستمرّ في القتالِ هنا إلى أن تنفد ذخيرتنا

142
00:11:42,540 --> 00:11:43,790
!تولّوا أنتم الباقي

143
00:11:55,850 --> 00:11:57,100
!تبّاً

144
00:11:57,100 --> 00:11:59,100
!لا نملك ما يكفي من قوّات للصمود

145
00:12:00,020 --> 00:12:01,830
!لا ردّ من م.س.ف

146
00:12:01,830 --> 00:12:04,000
!تكبّدت قوّات اللّواء الرّئيسيّة العديد من الضحايا

147
00:12:04,000 --> 00:12:05,950
!العديد من الضحايا من مورغ

148
00:12:06,300 --> 00:12:09,830
،لنرسل وحدتنا الاحتياطيّة، السريّة الثّالثة
إلى البوّابة الرئيسيّة

149
00:12:10,060 --> 00:12:12,700
،لكن يجرّب العدوُّ وسيلةً أخرى

150
00:12:12,700 --> 00:12:14,420
لن نتمكّن من الصُّمود أمامه

151
00:12:15,120 --> 00:12:20,580
لا يعنينا أن يخترقوا البوّابةَ الرئيسيّة ويدخلوا
!إلى الملجأ

152
00:12:20,580 --> 00:12:23,500
!يجدر بنا أن نستخدم قوّاتنا الاحتياطيّة هنا

153
00:12:25,470 --> 00:12:26,460
حسناً

154
00:12:26,460 --> 00:12:29,230
!أرسلوا السريّةَ الثّالثة إلى البوّابة الرئيسيّة

155
00:12:29,230 --> 00:12:29,990
!حاضر

156
00:12:29,990 --> 00:12:32,930
!جاري إرسال السريّة الثّالثة إلى البوّابة الرئيسيّة

157
00:12:34,260 --> 00:12:38,280
وصلَتْ تعزيزاتهم إلى البوّابة الرئيسيّة

158
00:12:38,470 --> 00:12:40,730
لا يوجد ما يدعو للخوف، غي

159
00:12:41,220 --> 00:12:44,450
حان دورُنا لنلعب بورقتنا الأخيرة

160
00:12:44,450 --> 00:12:45,560
!غي

161
00:12:47,580 --> 00:12:50,120
ما هذا التّشكيل الغريب؟

162
00:12:50,750 --> 00:12:52,330
!هذه مصيبة

163
00:12:52,330 --> 00:12:53,990
!ركّزوا الكثافة الناريّة

164
00:12:59,700 --> 00:13:01,640
!هنا غولف 01

165
00:13:01,640 --> 00:13:04,590
!وصلَت تعزيزات للعدوّ بطريقةِ الانتقال الآني

166
00:13:04,700 --> 00:13:08,340
!لا تكفي نيراننا لمنع عمليّة الانتقال الآنيّ

167
00:13:09,440 --> 00:13:10,980
!سنغادر السّطح

168
00:13:10,980 --> 00:13:12,180
سنقاتل على البرّ

169
00:13:12,180 --> 00:13:13,020
!عُلِم

170
00:13:13,790 --> 00:13:16,320
!تمّ خرق خطّ الدّفاع عن البوّابة الرئيسيّة

171
00:13:17,920 --> 00:13:23,280
لم نعُد نملك القوّة لمنعِ تقدُّم العدوّ

172
00:13:31,900 --> 00:13:37,450
سيتوجّب علينا ترك الباقي للفتياتِ في الملجأ

173
00:13:48,370 --> 00:13:50,270
!أرسلوا فصيلاً عسكريّاً إلى الجناح الأيسر

174
00:13:50,270 --> 00:13:51,640
!أخرجوا الجرحى من هنا

175
00:13:51,640 --> 00:13:53,190
أين تعزيزاتنا؟

176
00:13:53,190 --> 00:13:54,290
!نفدت ذخيرتي

177
00:14:04,050 --> 00:14:05,170
أسوكا-سان؟

178
00:14:05,870 --> 00:14:08,710
هل سيحدث ذلك مجدّداً؟

179
00:14:11,100 --> 00:14:15,780
العديد من زميلاتي مُتن في الحرب
الديستونيّة قبل ثلاث سنوات

180
00:14:17,760 --> 00:14:18,890
وعائلتي أيضاً

181
00:14:21,650 --> 00:14:22,900
،لكن في النّهاية

182
00:14:22,900 --> 00:14:25,430
بدأت الحربُ معهم مجدّداً للتو

183
00:14:27,460 --> 00:14:30,940
...السّلام الذي ضحّينا لأجله كثيراً

184
00:14:31,680 --> 00:14:32,970
ماذا كان بالضبط؟

185
00:14:35,630 --> 00:14:36,860
...أسوكا-سان

186
00:14:38,110 --> 00:14:40,090
نحن نعاني من جديد

187
00:14:41,340 --> 00:14:45,730
،حتّى لو لم تكن هناك فتيات سحريّات

188
00:14:45,730 --> 00:14:46,820
—هل كان ليتغيّر شيء

189
00:14:49,920 --> 00:14:51,900
،إذا تفوّهتِ بكلمة إضافيّة

190
00:14:51,900 --> 00:14:54,860
فأنا متأكّدة أنّ كلّ من مات سيغضب

191
00:14:57,410 --> 00:14:59,680
،يمكنني القتال للأبد

192
00:14:59,680 --> 00:15:01,580
ما دمتُ بجانبك

193
00:15:01,760 --> 00:15:02,700
...كورومي

194
00:15:15,770 --> 00:15:17,690
آسفة لسخافتي

195
00:15:20,880 --> 00:15:21,830
أنا بخير

196
00:15:22,430 --> 00:15:23,460
سأركّز

197
00:15:28,770 --> 00:15:31,410
هل تلك فتاة سحريّة؟

198
00:15:31,410 --> 00:15:33,240
تبدو جريحة

199
00:15:38,230 --> 00:15:38,990
!احذري

200
00:15:45,710 --> 00:15:47,010
شكراً

201
00:15:47,010 --> 00:15:48,080
...المعذرة

202
00:15:48,080 --> 00:15:51,760
كلّ ما يمكننا فعله هو المراقبة

203
00:15:51,760 --> 00:15:52,570
،لا

204
00:15:52,570 --> 00:15:54,620
أنقذتِني بذلك التّحذير

205
00:15:54,620 --> 00:15:56,180
أنا مَدينة لك بحياتي

206
00:15:56,800 --> 00:15:58,760
هل هي جريحةٌ أيضاً؟

207
00:15:58,760 --> 00:15:59,800
أجل

208
00:15:59,800 --> 00:16:02,620
وأسبّب مشكلة لصديقاتي بسببِ ذلك

209
00:16:02,620 --> 00:16:04,220
هذه ليست مشكلة

210
00:16:05,440 --> 00:16:07,860
هيّا بنا نعود أدراجنا معاً

211
00:16:07,860 --> 00:16:10,570
لا بدّ من وجودِ مكان آمن ما

212
00:16:12,400 --> 00:16:13,240
!حسناً

213
00:16:17,870 --> 00:16:19,230
!تبّاً

214
00:16:19,230 --> 00:16:20,780
!هؤلاء السّفلة

215
00:16:25,980 --> 00:16:26,920
!شكراً

216
00:16:26,920 --> 00:16:28,180
أنقذتِ أرواحنا

217
00:16:28,180 --> 00:16:31,010
أعيدوا تنظيم القوّات النّاجية

218
00:16:31,010 --> 00:16:32,230
وأنتِ؟

219
00:16:32,230 --> 00:16:35,220
سأقضي على قوّات العدوّ البرّية

220
00:16:35,600 --> 00:16:38,860
لا يمكننا إرسال تعزيزات إلى الملجأ هكذا

221
00:16:43,390 --> 00:16:44,430
،ريكو

222
00:16:44,430 --> 00:16:46,230
هل تكره الفتيات السحريّات؟

223
00:16:47,250 --> 00:16:49,620
هل هُنّ وحوش؟

224
00:16:51,660 --> 00:16:55,200
أتعتقد أنّهن يُقاتلن بمحضِ إرادتهن؟

225
00:17:02,060 --> 00:17:03,180
...المعذرة

226
00:17:04,030 --> 00:17:05,240
أنتِ تنزفين

227
00:17:05,640 --> 00:17:08,520
لقد حاولتُ إيقافه بالفعل

228
00:17:09,290 --> 00:17:11,760
حسناً، سأكون بخير

229
00:17:12,080 --> 00:17:14,340
...كيف يمكنكِ

230
00:17:14,340 --> 00:17:17,470
كيف يمكنكِ متابعة القتال وأنتِ هكذا؟

231
00:17:17,470 --> 00:17:19,470
لا أدري

232
00:17:19,470 --> 00:17:20,590
هذا مخيف

233
00:17:20,590 --> 00:17:21,760
ومؤلم

234
00:17:21,930 --> 00:17:23,720
مُزعج ليس إلّا

235
00:17:24,250 --> 00:17:26,230
لا شيء حميد نناله من هذا

236
00:17:28,670 --> 00:17:31,880
لكن تمّ اختياري

237
00:17:31,880 --> 00:17:34,050
هل تمّ اختياركِ لأنّكِ قويّة؟

238
00:17:34,050 --> 00:17:34,950
،لا

239
00:17:35,220 --> 00:17:37,340
أصبحتُ قويّة لأنّه تمّ اختياري

240
00:17:38,800 --> 00:17:43,520
يُولَد كلّ شخصٍ بعمله الخاص ليقوم به

241
00:17:44,250 --> 00:17:46,170
...كنتُ محظوظة

242
00:17:46,170 --> 00:17:50,040
أو ربّما منحوسة بما يكفي لإيجاد هذا العمل

243
00:17:50,040 --> 00:17:51,470
ولهذا أنا هنا

244
00:17:52,400 --> 00:17:54,160
كذلك الأمر بالنسبة للأخريات

245
00:18:04,210 --> 00:18:06,520
!العدوُّ قد دخل الملجأ

246
00:18:06,730 --> 00:18:08,130
،رابشر، ممرّضة الحرب

247
00:18:08,130 --> 00:18:09,480
توجّها إلى صالة المصعد

248
00:18:09,660 --> 00:18:10,700
أنا آسف

249
00:18:10,700 --> 00:18:12,440
لم نستطع منع العدوّ من الدّخول

250
00:18:12,900 --> 00:18:13,910
لا مُشكلة

251
00:18:14,370 --> 00:18:15,600
أنا جاهزة

252
00:18:18,690 --> 00:18:21,720
قُتِل كثير من الجنود هناك

253
00:18:23,160 --> 00:18:27,520
...واثقة أنّهم آمنوا بنا جميعاً عندما قاتلوا

254
00:18:28,590 --> 00:18:31,580
ولذلك لن ندع أرواحهم تذهب سُدى

255
00:18:40,260 --> 00:18:44,720
!ساتشو جاهز للقتل، تشو

256
00:19:07,200 --> 00:19:11,620
يبدو أنّ قوّتها السحريّة لم ترجع بشكل
...كامل، لكن

257
00:19:16,880 --> 00:19:19,400
قرأتُ السجلّات منذ ثلاث سنوات مضت

258
00:19:19,400 --> 00:19:24,300
كانت رابشر تواجه وقتاً عصيباً في مواجهة
فئات السينوبايت والهالوين

259
00:19:27,240 --> 00:19:31,280
مع الأسف، هذا يصعِّب علينا الاقتراب منك

260
00:19:31,280 --> 00:19:35,900
لكن يصعّب عليكِ الهرب من تلك الأسلاك
السحريّة، صحيح؟

261
00:19:35,900 --> 00:19:38,730
فئة سينوبايت، ركّزوا على كسبِ الوقت

262
00:19:39,720 --> 00:19:40,740
!مكانك

263
00:19:41,620 --> 00:19:43,980
ستقاتلينني أنا

264
00:19:51,780 --> 00:19:56,410
عملي هو هزيمةُ ممرّضة الحرب

265
00:20:02,970 --> 00:20:04,360
حاجز؟

266
00:20:04,360 --> 00:20:09,430
هذه الأداة السحريّة صُنِعَتْ بواسطة شخص
"يُطلِقون عليها اسم "قائدة اللّواء

267
00:20:10,800 --> 00:20:12,160
إنّها تلك

268
00:20:15,200 --> 00:20:17,610
لا يوجد سوانا الآن

269
00:20:17,610 --> 00:20:19,610
لن يتدخّل أحد

270
00:20:28,810 --> 00:20:31,520
إنّه مجرّد باب صُنِعَ بواسطة بشر

271
00:20:31,870 --> 00:20:32,980
ادخلا

272
00:20:50,260 --> 00:20:53,200
،لا تستهن بسيوف ميريبيكو

273
00:20:53,200 --> 00:20:55,530
الدّولة ذات الجيش الأقوى في عالم الرُّوح

274
00:20:55,530 --> 00:21:00,360
!لا يُسمَح لأي ديساس أن يمسّ الجنرال

275
00:21:04,850 --> 00:21:06,900
اصمت

276
00:21:20,910 --> 00:21:21,930
...كينجو

277
00:21:23,970 --> 00:21:26,060
وصلتُ أخيراً

278
00:21:28,010 --> 00:21:30,640
سآخذ هذه الحقيبة

279
00:21:40,230 --> 00:21:43,190
عليّ الوصول إلى الجنرال تابيرا بسرعة

280
00:21:43,530 --> 00:21:44,150
!تشو

281
00:21:44,850 --> 00:21:49,790
!القنبلة اليدويّة السحريّة م67، تشو

282
00:21:52,140 --> 00:21:53,830
!طاقة الأسلاك السحريّة قد ضَعُفَتْ

283
00:21:58,540 --> 00:21:59,500
،ساتشو

284
00:21:59,500 --> 00:22:01,330
!سنتوجّه إلى الجنرال تابيرا

285
00:22:01,330 --> 00:22:02,860
!هيّا بنا، تشو

286
00:22:16,620 --> 00:22:18,140
أيّها السّافل

287
00:23:57,790 --> 00:24:00,430
!كاراتيه سحريّة وأسلحة مضادّة للفتيات السحريّات

288
00:24:00,430 --> 00:24:04,290
تقاتل الفتيات السحريّات حتّى آخر رمق، ولو
تضرّجنَ بالدّماء، تشو

289
00:24:04,290 --> 00:24:07,300
الحلقة القادمة: "الفتيات السحريّات
"وهذا العالم الجميل

290
00:24:07,300 --> 00:24:11,500
ينتظركم يأسُ فتاةٍ مسكينة ما، تشو