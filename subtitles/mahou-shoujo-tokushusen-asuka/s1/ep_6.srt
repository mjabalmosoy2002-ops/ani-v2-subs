1
00:00:11,100 --> 00:00:13,050
!هذه الحلاوة

2
00:00:13,050 --> 00:00:13,820
!أعشقها

3
00:00:13,820 --> 00:00:16,270
لا تفرطي في أكل هذا يا ميا

4
00:00:16,270 --> 00:00:19,480
"استمتعي بالسّعادة اليوميّة ما دمتِ تستطيعين"

5
00:00:19,480 --> 00:00:21,160
أخبرني أبي بذلك قبل أن يموت

6
00:00:23,200 --> 00:00:25,210
أتريدين بعضاً يا جوليا؟

7
00:00:25,210 --> 00:00:26,350
لا

8
00:00:26,350 --> 00:00:29,420
تعلمين أنني أتّبع حِمية منخفضة الكربوهيدرات

9
00:00:33,660 --> 00:00:34,880
،على أي حال

10
00:00:34,880 --> 00:00:37,840
عادَتْ رابشر لخطوطِ الجبهة

11
00:00:39,400 --> 00:00:42,260
ما زالت تامارا مع السبيتسناز، صحيح؟

12
00:00:42,260 --> 00:00:42,980
أجل

13
00:00:43,960 --> 00:00:45,070
،رابشر

14
00:00:45,070 --> 00:00:46,110
،ممرّضة الحرب

15
00:00:46,110 --> 00:00:47,480
...العنقاء

16
00:00:47,620 --> 00:00:51,710
أربعة من الفتيات السحريّات الخمس عُدن
إلى ساحة القتال

17
00:00:51,710 --> 00:00:54,400
لم يبقَ سوى بيبّي الآن إذاً؟

18
00:00:55,130 --> 00:00:57,850
،أودُّ رؤيتها

19
00:00:57,850 --> 00:00:59,200
ولا أودّ في نفس الوقت

20
00:00:59,200 --> 00:01:03,150
قد تحظين بفرصتكِ لرؤية رابشر وممرّضة الحرب

21
00:01:03,150 --> 00:01:04,530
هكذا إذاً

22
00:01:04,530 --> 00:01:08,240
مهمّتك التّالية ستكون في اليابان على الأرجح

23
00:01:11,260 --> 00:01:13,200
لا أطيق الانتظار

24
00:02:50,020 --> 00:02:51,680
،المعذرة

25
00:02:51,680 --> 00:02:53,200
...في الواقع

26
00:02:53,800 --> 00:02:56,920
لا أجيد الإنجليزيّة

27
00:02:57,310 --> 00:02:58,610
ماذا؟

28
00:02:59,170 --> 00:03:00,190
...المعذرة

29
00:03:00,190 --> 00:03:01,380
هل تحتاجين لمساعدة؟

30
00:03:03,700 --> 00:03:05,280
!شكراً لكِ

31
00:03:06,190 --> 00:03:08,430
أريد الذهاب إلى هذا الفندق

32
00:03:08,430 --> 00:03:11,450
إنّه في آخر ذاك الطريق

33
00:03:11,450 --> 00:03:12,170
حسناً؟

34
00:03:12,170 --> 00:03:13,220
!حسناً

35
00:03:13,220 --> 00:03:14,250
!شكراً لكِ

36
00:03:17,730 --> 00:03:19,110
!شكراً لكِ

37
00:03:19,110 --> 00:03:20,680
!وداعاً

38
00:03:22,760 --> 00:03:23,710
!يا للهول

39
00:03:26,170 --> 00:03:29,350
!شكراً على حضور حلقتي الدراسيّة اليوم

40
00:03:29,610 --> 00:03:31,440
قالت كورومي أنّها ستتأخّر

41
00:03:31,670 --> 00:03:33,150
قالت نوزو-تشان نفس الكلام

42
00:03:33,460 --> 00:03:34,240
،حسناً

43
00:03:34,240 --> 00:03:35,480
لنبدأ من دونهما

44
00:03:35,480 --> 00:03:36,320
حسناً

45
00:03:37,680 --> 00:03:40,820
يحتوي هذا المكان على كتبٍ كثيرة

46
00:03:41,440 --> 00:03:43,650
كثير من المسرحيّات والكتب عن الدراما

47
00:03:44,240 --> 00:03:45,950
أنتِ فعلاً منتسِبة لنادي الأدب

48
00:03:45,950 --> 00:03:46,970
،كما تعلمين

49
00:03:46,970 --> 00:03:49,870
عندما تقرئين ما يكفي من كتُب، تبدئين
برغبةٍ في تأليف كتاب

50
00:03:50,080 --> 00:03:55,090
آمل أن أصبح مؤلّفة نصوص عندما أكبر

51
00:03:55,200 --> 00:03:57,720
أهذا حلمكِ؟

52
00:03:57,720 --> 00:03:59,450
...في الواقع

53
00:04:00,540 --> 00:04:03,230
ما هو حلمكِ يا أسوكا-سان؟

54
00:04:05,370 --> 00:04:07,010
...حلمي

55
00:04:13,300 --> 00:04:17,980
...لا أحبّ نفسي كثيراً

56
00:04:18,360 --> 00:04:21,010
لذا لا أملك حلماً حقّاً

57
00:04:22,650 --> 00:04:24,560
!أنتِ مذهلة يا أسوكا-سان

58
00:04:26,190 --> 00:04:31,120
لذا لا تقولي أنّكِ لا تحبّين نفسكِ

59
00:04:43,110 --> 00:04:45,020
!نوزو-تشان، كفّي عن ذلك

60
00:04:46,060 --> 00:04:47,930
!مـ-مرحباً

61
00:04:48,180 --> 00:04:49,380
كورومي؟

62
00:04:50,010 --> 00:04:50,970
!أسوكا-سان

63
00:04:50,970 --> 00:04:52,150
هل أنتِ بخير؟

64
00:04:52,150 --> 00:04:53,850
هل حدث أي شيء غريب بينكِ وبينها؟

65
00:04:55,000 --> 00:04:57,720
أي شيء... غريب؟

66
00:05:00,680 --> 00:05:02,030
...في الواقع

67
00:05:02,030 --> 00:05:03,040
...أعتقد أنّ هذا

68
00:05:05,950 --> 00:05:09,290
يجب أن تستخدمي هذه الصّيغة لحلّها

69
00:05:09,290 --> 00:05:11,160
هكذا إذاً

70
00:05:11,540 --> 00:05:14,250
!لا يمكنني فعل هذا! إنّه منهك

71
00:05:14,250 --> 00:05:17,260
لم تمضِ نصف ساعة حتّى يا نوزو-تشان

72
00:05:17,260 --> 00:05:19,580
!لكن تعِبت

73
00:05:20,400 --> 00:05:21,740
!وجدتُها

74
00:05:21,740 --> 00:05:23,020
،حالما ننتهي من هذا

75
00:05:23,020 --> 00:05:24,590
ما رأيكن أن نذهب لحضورِ مهرجان تاناباتا؟

76
00:05:24,750 --> 00:05:26,030
مهرجان تاناباتا؟

77
00:05:26,770 --> 00:05:29,760
إنّهم يقيمونه في منطقة التسوُّق أمام المحطّة

78
00:05:29,760 --> 00:05:31,440
،توجد أكشاك صغيرة كثيرة

79
00:05:31,440 --> 00:05:33,890
لذا أعتقد أنّ هذا قد يكون ممتعاً

80
00:05:34,880 --> 00:05:37,660
لم أحضر شيئاً كهذا منذ زمن بعيد

81
00:05:37,660 --> 00:05:39,920
!فلنذهب إذاً

82
00:05:39,920 --> 00:05:42,900
يمكننا أن ندرس بشكلٍ أفضل عندما يكون
!هناك شيء ممتع ينتظرنا

83
00:05:42,900 --> 00:05:44,660
،أنا لا أمانع

84
00:05:44,660 --> 00:05:47,100
لكن أعتقد أنّ كورومي لديها شيء تفعله

85
00:05:47,100 --> 00:05:49,320
!أصبح جدول مواعيدي شاغراً للتو

86
00:05:49,320 --> 00:05:52,190
...أعطي الأولويّة لرؤيتكِ ترتدين يوكاتا

87
00:05:52,190 --> 00:05:54,740
أعني لصنع ذكريات مع صديقاتي

88
00:05:54,740 --> 00:05:56,530
هـ-هكذا إذاً

89
00:05:57,070 --> 00:05:58,790
حسناً، أظنّنا نستطيع

90
00:05:58,790 --> 00:06:01,910
!مرحى! وقت المهرجان

91
00:06:06,760 --> 00:06:08,970
...ليونيد غرينبارغ

92
00:06:08,970 --> 00:06:11,510
عالم رياضيّات أمريكي يهودي

93
00:06:12,010 --> 00:06:14,430
،قُتِلَ في مكسيكو

94
00:06:14,430 --> 00:06:16,050
وأخوه في اليابان

95
00:06:16,750 --> 00:06:19,840
،الأخ الأصغر لليونيد، جيرومي

96
00:06:19,840 --> 00:06:23,750
هو مليونير يدير شركة تكنولوجيا معلومات

97
00:06:23,750 --> 00:06:27,550
أو بالأحرى تقاعدَ الآن ويعيش حياة رغيدة

98
00:06:27,550 --> 00:06:29,190
كان كذلك

99
00:06:29,190 --> 00:06:32,530
لا يستطيع أحدٌ التّواصل معه

100
00:06:33,220 --> 00:06:37,800
أرسل الفرع الياباني من وكالة المخابرات المركزيّة
،طائرة مُصغّرة بلا طيّار للبحث في غرفته

101
00:06:37,800 --> 00:06:40,510
ووجدوه محشوراً في مُكعّب

102
00:06:41,570 --> 00:06:47,930
إذاً فتاة سحريّة غير شرعيّة قويّة متورّطة
في هذه المسألة؟

103
00:06:47,930 --> 00:06:49,890
أو مرتزقة سحريّين

104
00:06:49,890 --> 00:06:52,530
لواء بابل أولئك؟

105
00:06:52,530 --> 00:06:54,720
جيّد، سيكون هذا ممتعاً

106
00:06:54,890 --> 00:06:59,690
ماذا ستفعلين إذا صادفتِ رابشر وممرّضة
الحرب أثناء تحرّياتك؟

107
00:07:00,750 --> 00:07:03,640
لن أدعهما تعيقان مسار عملي

108
00:07:03,640 --> 00:07:04,840
هذا كُل ما في الأمر

109
00:07:08,590 --> 00:07:11,840
بغضّ النّظر عن احتمال أن يكون سحرة
غير شرعيّين

110
00:07:11,840 --> 00:07:15,380
،متورّطين في حادثة شين أوكوبو الإرهابيّة

111
00:07:15,380 --> 00:07:23,210
—تحمّل أحزاب المعارضة ضعفَ الحكومة

112
00:07:16,490 --> 00:07:19,170
أسوكا وكورومي-تشان تأخّرتا

113
00:07:19,170 --> 00:07:21,650
أعتقد ينبغي أن يكونا هنا قريباً

114
00:07:24,120 --> 00:07:25,820
آ-آسفة

115
00:07:25,820 --> 00:07:28,900
...قلتُ لها لستُ بحاجة ليوكاتا مُبهرَج، لكن

116
00:07:28,900 --> 00:07:30,180
...أصرّتْ كورومي

117
00:07:30,180 --> 00:07:32,730
!أعتقد أنّه يليق بكِ كثيراً

118
00:07:32,730 --> 00:07:34,140
!أتّفق

119
00:07:36,470 --> 00:07:38,000
!لنذهب إذاً

120
00:07:38,000 --> 00:07:39,720
!إنّه قريب جداً

121
00:07:49,610 --> 00:07:53,400
الذهاب لحضورِ مهرجان مع الجميع مثير جدّاً

122
00:07:53,730 --> 00:07:54,410
ماذا؟

123
00:07:54,410 --> 00:07:55,360
أين نوزومي؟

124
00:07:56,480 --> 00:07:58,400
...لم أعد قادرة على الأكل

125
00:07:58,400 --> 00:08:00,330
!هذا لأنّكِ تأكلين بسرعة

126
00:08:00,680 --> 00:08:02,170
متى أكلتْ كلّ ذلك؟

127
00:08:02,620 --> 00:08:04,880
سأعتني بنوزومي-سان

128
00:08:04,880 --> 00:08:06,600
سنلحق بكما لاحقاً

129
00:08:07,350 --> 00:08:08,240
شكراً

130
00:08:08,240 --> 00:08:09,170
آسفة بشأن ذلك

131
00:08:13,390 --> 00:08:16,680
حضنكِ مريح جدّاً

132
00:08:16,680 --> 00:08:20,000
أشعر وكأنّكِ معتادة على العنايةِ بالناس

133
00:08:20,000 --> 00:08:21,850
ربّما أكون كذلك

134
00:08:22,200 --> 00:08:26,460
،منذ انتقالكما إلى هنا

135
00:08:26,460 --> 00:08:28,310
بات كلّ يوم ممتعاً هكذا

136
00:08:29,330 --> 00:08:30,810
معك حقّ

137
00:08:31,540 --> 00:08:32,700
،في الحقيقة

138
00:08:33,220 --> 00:08:38,160
أسوكا وساياكو تبدوان كزوجين، أليس كذلك؟

139
00:08:39,740 --> 00:08:42,770
،بصِفتي صديقة طفولتها، هذا أمر جيّد

140
00:08:42,770 --> 00:08:45,460
لكنّه يحزنني بعض الشيء أيضاً

141
00:08:49,610 --> 00:08:51,420
فلنذهب

142
00:08:52,190 --> 00:08:54,880
لكن ما زالت معدتي تؤلمني

143
00:08:55,140 --> 00:08:57,340
!لا أبالي

144
00:09:10,480 --> 00:09:11,520
هل أنتِ بخير؟

145
00:09:12,700 --> 00:09:13,790
...نعم

146
00:09:22,460 --> 00:09:23,670
المعذرة

147
00:09:24,570 --> 00:09:25,900
يوشينو-سان؟

148
00:09:25,900 --> 00:09:26,960
مرحباً

149
00:09:29,580 --> 00:09:31,000
أنتم؟

150
00:09:39,340 --> 00:09:41,200
لماذا الفرقة م هنا؟

151
00:09:41,200 --> 00:09:43,680
قلتُ أنّني في إجازة اليوم

152
00:09:43,920 --> 00:09:45,650
وكذلك نحن

153
00:09:45,990 --> 00:09:50,680
منحنا إيزوكا-سان إجازةً لبقيّة اليوم

154
00:09:50,680 --> 00:09:53,360
طلب منّا الذهاب والاستمتاع معكن بالمهرجان

155
00:09:58,280 --> 00:10:03,480
جزء من العملِ في سلك قوّات الدّفاع الذاتي
هو نَيل استراحة كلّما سنحت الفرصة

156
00:10:03,480 --> 00:10:05,080
،أنتم

157
00:10:05,330 --> 00:10:06,350
!أسوكا

158
00:10:06,350 --> 00:10:08,790
!عرّفينا

159
00:10:08,790 --> 00:10:10,910
أتعرفينهم يا أسوكا-سان؟

160
00:10:10,910 --> 00:10:13,630
هل هم أقرباؤكِ أو ما شابه؟

161
00:10:13,630 --> 00:10:15,340
...لا، نحن

162
00:10:16,680 --> 00:10:19,570
كانت لكمة قويّة حقّاً

163
00:10:20,830 --> 00:10:25,470
نحن نذهب إلى نفس نادي التّدريب الذي
تتدرّب فيه أسوكا وكورومي

164
00:10:25,470 --> 00:10:28,310
!هكذا إذاً

165
00:10:28,310 --> 00:10:29,640
!وجدتُها

166
00:10:29,640 --> 00:10:32,650
لمَ لا نذهب جميعاً معاً؟

167
00:10:32,650 --> 00:10:34,830
!سيؤتي تدريبنا أُكُله

168
00:10:34,830 --> 00:10:36,720
!مرحى

169
00:10:36,720 --> 00:10:38,320
إنّها لا تتعلّم أبداً

170
00:10:54,540 --> 00:10:56,250
متى مضى كلّ هذا الوقت؟

171
00:10:56,250 --> 00:10:58,250
إلى أين ذهبت مجموعة الأشخاص الغريبين تلك؟

172
00:10:58,250 --> 00:11:00,580
يصطفّون في الطابور للحصول على بيرة
وياكيتوري

173
00:11:07,810 --> 00:11:12,230
يبدون كمُراهقين عاديّين عندما يتصرّفون هكذا

174
00:11:13,130 --> 00:11:16,440
حتّى نحن لا نبدو كجنود الآن

175
00:11:16,740 --> 00:11:18,940
جنود؟

176
00:11:18,940 --> 00:11:22,410
تطوّعنا للتجنيد ونتقاضى أجراً من نقود الضرائب

177
00:11:22,870 --> 00:11:24,740
نحن لسنا مثلهن

178
00:11:26,770 --> 00:11:30,110
ماذا سيحدث في مهمّتنا التالية؟

179
00:11:30,110 --> 00:11:31,840
،لا أعلم

180
00:11:31,840 --> 00:11:34,380
لكن لن تكون أسهل ممّا واجهناه حتّى اللّحظة

181
00:11:36,120 --> 00:11:39,170
آمل ألّا تكون هذه إجازتنا الصيفيّة الأخيرة

182
00:11:39,300 --> 00:11:42,460
!لا تقل كلاماً كهذا

183
00:11:45,870 --> 00:11:50,260
تنتشر كثير من الأخبار حول حوادث
العنف مؤخّراً

184
00:11:50,640 --> 00:11:52,900
ما الذي أصابكِ؟

185
00:11:52,900 --> 00:11:54,520
،عندما أكون وسط ازدحام

186
00:11:54,520 --> 00:11:56,870
...أبدأ بتذكُّر لحظات

187
00:11:56,870 --> 00:11:59,210
أنقذتْني فيها الفتاة السحريّة

188
00:12:00,890 --> 00:12:04,610
اندلعَتْ معركةٌ ضخمةٌ في أوكوبو
منذ مدّة أيضاً

189
00:12:05,440 --> 00:12:08,300
آمل أن يدوم السّلامُ للأبد

190
00:12:08,300 --> 00:12:10,540
لكن أعتقد أنّه لن يدوم

191
00:12:12,560 --> 00:12:16,380
كيف سيكون شكل نهاية العالم يا تُرى؟

192
00:12:18,200 --> 00:12:23,260
أتذكّر كم كنتُ خائفة عندما بدأت
الحرب الديستونيّة

193
00:12:23,260 --> 00:12:24,660
...نعم

194
00:12:24,660 --> 00:12:26,920
أغلِقَت كافّة المدارس

195
00:12:26,920 --> 00:12:28,650
وقضينا وقتنا مع عائلاتنا في الرّيف

196
00:12:28,980 --> 00:12:32,620
واندلعت حروب أهليّة في كلّ أنحاء
العالم وقتذاك

197
00:12:33,310 --> 00:12:38,610
رأيتُ في التلفزيون كيف أراد الديساس استخدام
البشريّة كمصدر للطاقة

198
00:12:40,390 --> 00:12:46,000
،لو ظهر وحشُ الدّيساس، قائدهم، بشكل كامل

199
00:12:46,000 --> 00:12:51,200
لأُبيد كلّ جيش في الأرض
في غضون 36 ساعة

200
00:12:53,440 --> 00:12:55,720
!لا تقلقن

201
00:12:55,720 --> 00:12:59,660
يُقال أنّ كلّ جيش في العالم يتعلّم القتال السحريّ

202
00:12:59,770 --> 00:13:02,740
وهناك عدد أكبر من الفتياتِ السحريّاتِ أيضاً

203
00:13:05,660 --> 00:13:08,010
سوف أتمشّى بمفردي قليلاً

204
00:13:19,080 --> 00:13:22,150
سلام تحافظ عليه فتيات سحريّات؟

205
00:13:30,010 --> 00:13:31,140
...أنتِ تلك الفتاة

206
00:13:31,140 --> 00:13:33,420
!شكراً على مساعدتكِ

207
00:13:33,420 --> 00:13:36,030
!عباءة الكيمونو خاصّتكِ جميلة جداً

208
00:13:36,570 --> 00:13:37,730
شكراً لكِ

209
00:13:38,420 --> 00:13:41,300
بالمناسبة، ما هذا؟

210
00:13:42,690 --> 00:13:44,840
هذه زينة تاناباتا

211
00:13:44,840 --> 00:13:46,410
إنّه تقليد يابانيّ

212
00:13:46,410 --> 00:13:49,390
يُقال أنّه إذا دوّنت أمنيتكِ على واحدة
منها فإنّها تتحقّق

213
00:13:50,820 --> 00:13:53,490
ماذا تمنّيتِ؟

214
00:13:53,490 --> 00:13:54,880
،لا

215
00:13:54,880 --> 00:13:57,650
ليست لديّ أي أمنية

216
00:13:57,650 --> 00:13:58,970
!هذا خطأ

217
00:13:58,970 --> 00:14:01,440
!على كلّ صغير أن يمتلك أمنيات

218
00:14:01,880 --> 00:14:04,370
لكن لا أعرف ماذا أتمنّى

219
00:14:04,370 --> 00:14:06,360
!إذاً عليكِ أن تبحثي عن أي شيء

220
00:14:11,740 --> 00:14:13,020
اسمعي

221
00:14:13,020 --> 00:14:15,950
من واجب الصّغير أن يكون سعيداً

222
00:14:15,950 --> 00:14:16,960
مفهوم؟

223
00:14:17,730 --> 00:14:18,680
حسناً

224
00:14:19,040 --> 00:14:20,680
،إن لم يكن لديكِ أمنية

225
00:14:20,680 --> 00:14:23,440
فتمنّي أن تكوني سعيدة إذاً

226
00:14:23,440 --> 00:14:25,700
حينئذ ستجدين شيئاً بالتأكيد

227
00:14:25,950 --> 00:14:26,770
نعم

228
00:14:33,240 --> 00:14:35,710
المعذرة، لماذا أتيتِ إلى اليابان؟

229
00:14:35,710 --> 00:14:36,920
للسياحة؟

230
00:14:37,390 --> 00:14:39,480
أبحث عن شخص

231
00:14:39,480 --> 00:14:40,680
تبحثين عن شخص؟

232
00:14:41,020 --> 00:14:44,500
طفلة انفصلتُ عنها منذ زمن بعيد

233
00:14:46,460 --> 00:14:48,240
!أسوكا-سان

234
00:14:49,230 --> 00:14:50,820
زينة تاناباتا

235
00:14:50,820 --> 00:14:52,990
!سأكتب أمنية أيضاً

236
00:15:01,250 --> 00:15:02,000
!أنتِ

237
00:15:02,220 --> 00:15:06,210
!كفّي عن الشّرود وأعيرينا انتباهاً

238
00:15:08,030 --> 00:15:10,180
!لا تنقضّي على أسوكا-سان

239
00:15:10,180 --> 00:15:12,010
!اتركيها

240
00:15:12,010 --> 00:15:13,420
!نوزو-تشان

241
00:15:14,960 --> 00:15:18,050
عضَّ الكلبُ على الطعم

242
00:15:18,820 --> 00:15:21,400
سيصل إلى يوكاتا في صباح الغدّ

243
00:15:21,950 --> 00:15:22,940
عُلِم

244
00:15:34,810 --> 00:15:38,490
هذا هو البناء الذي تتواجد فيه شقّة
جيرومي العلويّة؟

245
00:15:39,410 --> 00:15:41,720
لا يوجد أحدٌ هنا، صحيح؟

246
00:15:41,720 --> 00:15:44,480
طلبنا من وكالة الاستخبارات المركزيّة إغلاقه

247
00:15:44,480 --> 00:15:45,880
أحسنت صنعاً

248
00:15:48,210 --> 00:15:53,650
على أي حال، لم يهتمّ أحد بانقطاع
الاتّصال مع جيرومي؟

249
00:15:53,650 --> 00:15:57,310
كانت سكرتيرته تنظّف المكان
وتدفع الإيجار

250
00:15:59,830 --> 00:16:01,040
هذه هي؟

251
00:16:01,730 --> 00:16:04,940
الشرطة اليابانيّة لم تكتشف ما يجري هنا بعد

252
00:16:04,940 --> 00:16:07,930
ينبغي أن نكون أوّل من يطّلع على مسرح الجريمة

253
00:16:10,440 --> 00:16:12,570
جاست كوز، هيّا بنا

254
00:16:19,820 --> 00:16:21,370
ماذا ترين في الدّاخل؟

255
00:16:21,370 --> 00:16:24,450
،لن أعرف الكثير ما لم أدخل بنفسي

256
00:16:24,450 --> 00:16:28,050
لكن على الأقلّ، يبدو أنّه لا يوجد أحدٌ
حيّ في الداخل

257
00:16:28,050 --> 00:16:29,320
حسناً

258
00:16:29,880 --> 00:16:30,880
لندخل

259
00:16:38,560 --> 00:16:39,770
...هذا

260
00:16:39,770 --> 00:16:41,260
مُكعَّب

261
00:16:41,260 --> 00:16:43,250
مثل الذي رأيناه في مكسيكو

262
00:16:43,250 --> 00:16:45,620
الجثّة شبه مُحنَّطة

263
00:16:45,620 --> 00:16:48,770
مضى ثلاثة أشهر على الأقلّ منذ وفاته

264
00:16:48,770 --> 00:16:51,890
سأستخرج عيّنة حمض نووي

265
00:16:51,890 --> 00:16:53,960
تابعا أنتما البحث

266
00:16:55,650 --> 00:16:56,420
...مهلاً

267
00:16:56,840 --> 00:17:00,500
لماذا تعتقدين أنّهم لم يحاولوا إخفاء الجثّة؟

268
00:17:00,500 --> 00:17:02,890
أرادوا منّا أن نكتشفها، صحيح؟

269
00:17:02,890 --> 00:17:06,330
ذلك كان انطباعي منذ مكسيكو

270
00:17:07,730 --> 00:17:10,590
الحرّ شديد هنا

271
00:17:10,590 --> 00:17:12,650
هل شغّلَ المدفأة؟

272
00:17:23,050 --> 00:17:24,270
ما هذا؟

273
00:17:24,270 --> 00:17:27,600
".يضحك كثيراً من يضحك أخيراً"

274
00:17:28,850 --> 00:17:31,200
إنّه شعارنا كفتيات سحريّات

275
00:17:38,480 --> 00:17:39,670
ما هذا؟

276
00:17:39,670 --> 00:17:41,220
سلاح بيولوجيّ؟

277
00:17:41,220 --> 00:17:43,700
الحرارة ودُخان أياهوسكا

278
00:17:43,700 --> 00:17:46,920
،سيُعزَّزان بواسطةِ رغبتي للانتقام

279
00:17:46,920 --> 00:17:49,130
وأصبح فهداً يحرقكم

280
00:17:49,860 --> 00:17:51,540
مرتزقة سحريّة؟

281
00:17:52,040 --> 00:17:53,130
بالضبط

282
00:18:00,180 --> 00:18:03,390
من مسافات قريبة، يمكنني اختراق الدّروع

283
00:18:03,390 --> 00:18:05,600
تعلّمتُ هذا في الحرب الأخيرة

284
00:18:05,600 --> 00:18:06,810
!كفّي عن الكلام

285
00:18:11,570 --> 00:18:12,400
!نلتُ منك

286
00:18:14,450 --> 00:18:16,810
حتّى رصاصي لا يستطيع اختراق درعها؟

287
00:18:16,810 --> 00:18:18,190
!إنّه متينٌ جدّاً

288
00:18:24,160 --> 00:18:25,720
تذكّرت

289
00:18:25,720 --> 00:18:28,490
أنتِ الهلال ساندينو، أليس كذلك؟

290
00:18:28,490 --> 00:18:30,200
إرهابيّة كولومبيّة

291
00:18:30,430 --> 00:18:31,920
الآن قد تذكّرت

292
00:18:32,200 --> 00:18:36,360
تتعاطى جرعات عالية من المخدّرات وتتعرَض
لكثير من الحرارة لامتصاص أفضل للقوّة السحريّة

293
00:18:36,360 --> 00:18:39,440
إنّه تكتيك يُستخدَم بشكل شائع بواسطة
الكهَنة الكولومبيّن

294
00:18:40,100 --> 00:18:42,600
إذاً هذه الحرارة والضباب هما حاجزكِ؟

295
00:18:43,450 --> 00:18:45,300
أنا متفاجئة من اكتشافكِ السّريع لذلك

296
00:18:45,300 --> 00:18:47,300
لقد أدّيتِ فريضتكِ

297
00:18:48,000 --> 00:18:52,880
توفّيت عائلتي أثناء قصف الولايات المتّحدة
على الديساس

298
00:18:53,440 --> 00:18:55,560
وأنا أنتقم

299
00:18:55,560 --> 00:18:59,290
هذا لا يبرّر لكِ أن تكوني إرهابيّة

300
00:19:07,160 --> 00:19:08,800
فئة فورهيس؟

301
00:19:09,180 --> 00:19:10,620
تبديل للقذائف السحريّة

302
00:19:10,620 --> 00:19:11,540
!عُلِم

303
00:19:14,960 --> 00:19:19,420
!قنابلكِ قتلَتْ 300 جنديّاً أمريكيّاً في السّودان

304
00:19:19,560 --> 00:19:22,640
!وأنتِ ستنضمّين إليهم

305
00:19:43,740 --> 00:19:48,750
وإن كنتِ تكرهين الدّيساس، فلماذا تقتلين
الفتيات السحريّات؟

306
00:19:49,400 --> 00:19:51,870
توفّيت ابنتي

307
00:19:51,870 --> 00:19:55,220
كان البشر هُم من قتلوها في تلك الحرب

308
00:19:57,310 --> 00:19:59,510
كانت الجبهة الكولومبيّة فظيعة

309
00:19:59,940 --> 00:20:01,730
كان الجيش خارج السّيطرة

310
00:20:01,730 --> 00:20:03,680
مات أناسٌ بلا ضرورة

311
00:20:03,810 --> 00:20:05,630
لا تحاولي التستّر على ذلك ببضع كلمات

312
00:20:05,630 --> 00:20:07,560
!لم تنتهِ حربي

313
00:20:07,560 --> 00:20:12,520
ستستمرّ حربي حتّى يلتهم يأسي
!العالمَ بأسره

314
00:20:12,520 --> 00:20:14,220
!أنتِ ناضجة

315
00:20:14,220 --> 00:20:16,270
!لا تشتكي من همومكِ لطفلة

316
00:20:18,830 --> 00:20:19,560
!جوليا

317
00:20:20,560 --> 00:20:21,610
عُلِم

318
00:20:38,460 --> 00:20:41,170
أعتقد لا يمكننا استجوابكِ بهذه الجروح

319
00:20:43,340 --> 00:20:44,910
...يسرّني هذا

320
00:20:45,290 --> 00:20:47,840
لم أضطرّ لقتلِ طفلة

321
00:20:48,440 --> 00:20:51,200
إيّاك أن تحاولي حتّى الخلاص والتّكفير
في لحظاتكِ الأخيرة

322
00:20:51,720 --> 00:20:53,850
أنتِ مجرّد إرهابيّة

323
00:20:54,720 --> 00:20:59,020
لا تختلفين عمّن قتل أمّي وأبي بقنبلة

324
00:21:01,980 --> 00:21:03,480
معك حقّ

325
00:21:26,800 --> 00:21:31,930
إذاً ربّما لواء بابل استأجر ساندينو ففعلتها؟

326
00:21:31,930 --> 00:21:33,990
لا، هذا غير صحيح

327
00:21:35,640 --> 00:21:40,170
واحدة من الفتياتِ السحريّات الخمس فقط
من تعلم بشأن تلك العبارة

328
00:21:54,910 --> 00:21:56,730
هل من مشكلة؟

329
00:21:57,310 --> 00:21:59,150
...بخصوص حلمي

330
00:21:59,680 --> 00:22:02,720
أخشى أنّني لا أعرف ما الذي يعنيه
،بالنسبة لي أن أكون سعيدة

331
00:22:02,890 --> 00:22:04,950
أو أن أمتلك حلماً

332
00:22:06,750 --> 00:22:07,660
...لكن

333
00:22:08,460 --> 00:22:10,160
،يمكنني حماية شخص

334
00:22:10,160 --> 00:22:12,570
ودعم أحلام شخص آخر

335
00:22:13,420 --> 00:22:17,860
ربّما هذا هو حلمي الآن

336
00:22:19,030 --> 00:22:20,410
...أسوكا-سان

337
00:22:22,060 --> 00:22:23,730
!أسوكا-سان

338
00:22:24,060 --> 00:22:28,030
!صباح الخير

339
00:22:32,270 --> 00:22:38,040
ربّما يمكنني إيجاد سعادتي من خلال ذلك

340
00:24:12,460 --> 00:24:16,380
لماذا تستخدم وحدة قوّات خاصّة للدفاع الذاتي
مقهى خادمات قاعدةً لهم؟

341
00:24:16,380 --> 00:24:19,050
ألم يجدوا مكاناً أفضل من ذلك، تشو؟

342
00:24:19,050 --> 00:24:21,950
الحلقة القادمة: "وحدة تطوير عمليّات
"الفتاة السحريّات

343
00:24:21,950 --> 00:24:24,110
!تقع أحداث مريبة في كلّ مكان

344
00:24:24,110 --> 00:24:26,640
!تغدو الأمور حافلة هنا، تشو