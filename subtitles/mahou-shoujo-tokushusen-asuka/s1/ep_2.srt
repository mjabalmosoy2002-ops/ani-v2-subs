1
00:00:44,210 --> 00:00:45,560
لن أقتلك

2
00:00:46,180 --> 00:00:48,240
ستُساق إلى قسم الشؤون الخارجية
التابع للأمن العام

3
00:01:02,220 --> 00:01:05,240
فتاة سحريّة... حقيقيّة

4
00:01:07,320 --> 00:01:09,080
إنّها حسناء

5
00:02:54,610 --> 00:02:56,140
ماذا تفعل؟

6
00:02:56,140 --> 00:02:58,000
،ينبغي أن تكوني أكثر حذراً

7
00:02:58,000 --> 00:02:58,730
يا أسوكا

8
00:02:59,560 --> 00:03:00,840
كيف؟

9
00:03:01,690 --> 00:03:03,770
استخرجتَ مفتاحاً احتياطيّاً دون
أن تخبرني؟

10
00:03:04,300 --> 00:03:06,170
قوّات الدفاع الذاتي لديها صلاحيّة خاصّة

11
00:03:06,170 --> 00:03:08,200
!هذا غير قانوني بالطبع

12
00:03:09,140 --> 00:03:12,420
ما كان ينبغي أن تشعلي حرباً في الأراضي اليابانيّة

13
00:03:12,940 --> 00:03:15,120
سحري يُشوّش وعي الناس

14
00:03:15,120 --> 00:03:16,930
لا أحد يعلم من أكون

15
00:03:16,930 --> 00:03:19,650
لكن افتعلتِ فوضى

16
00:03:19,650 --> 00:03:21,380
راعي الظرف أكثر

17
00:03:24,770 --> 00:03:27,680
ذلك الرّجل الذي رأيتِه اليوم كان كيم كانث

18
00:03:27,680 --> 00:03:30,980
إرهابي من جبهةِ آسيا الشرقيّة المُتّحدة

19
00:03:30,980 --> 00:03:32,370
هكذا إذاً

20
00:03:32,370 --> 00:03:34,540
الأمر معقّد أكثر ممّا يبدو

21
00:03:34,540 --> 00:03:36,610
ثمّة منظّمة جديدة متورّطة بشكلٍ ما

22
00:03:37,740 --> 00:03:39,960
،أردتُ أن نقبض عليه نحن

23
00:03:39,960 --> 00:03:41,920
لكن سبقَتْنا شرطةُ العاصِمة في ذلك

24
00:03:41,920 --> 00:03:44,240
سيُعلَن عن موتِه غداً على ما أعتقد

25
00:03:44,830 --> 00:03:46,750
لم أقتله

26
00:03:46,750 --> 00:03:48,960
لا حقوق للموتى

27
00:03:49,400 --> 00:03:52,910
سيحصلون على المعلوماتِ التي يريدونها منه
مهما كلّف الأمر

28
00:03:54,020 --> 00:03:56,580
سيتكتّمون على الأمر برمّته، صحيح؟

29
00:03:57,060 --> 00:03:59,720
أعتقد أنّ الشرطة اليابانيّة ليست عديمة الجدوى

30
00:04:03,310 --> 00:04:06,130
من الأفضل أن تكوني معنا

31
00:04:06,130 --> 00:04:07,180
أمتأكّدة أنّكِ لن تغيّري رأيكِ؟

32
00:04:07,600 --> 00:04:11,440
،بالطبع. سأحمي نفسي وصديقاتي

33
00:04:11,440 --> 00:04:13,640
لكن لن أنضمّ لمجموعة العمليّات الخاصّة

34
00:04:15,900 --> 00:04:17,060
هكذا إذاً

35
00:04:22,690 --> 00:04:24,610
شعور غريب

36
00:04:25,090 --> 00:04:29,370
الأشياء التي اعتدتُ أن أراها كلّ يوم
تبدو وكأنّها كذبة

37
00:04:41,200 --> 00:04:42,240
ماذا؟

38
00:04:42,240 --> 00:04:45,220
هل حجب الوعي لا يؤثّر عليها؟

39
00:04:47,570 --> 00:04:49,180
صباح الخير

40
00:04:50,300 --> 00:04:51,600
أعتقد أنّني قلقتُ عن عبث

41
00:04:52,450 --> 00:04:53,780
صباح الخير

42
00:04:53,780 --> 00:04:54,880
...المعذرة

43
00:04:54,880 --> 00:04:57,000
سمعتُ أنّكِ كنتِ في إيداباشي البارحة

44
00:04:57,000 --> 00:05:00,350
نعم

45
00:04:58,590 --> 00:04:59,570
هل أنتِ بخير؟

46
00:05:00,350 --> 00:05:02,110
لم أتأذّ حقيقةً

47
00:05:03,020 --> 00:05:03,900
هكذا إذاً

48
00:05:03,900 --> 00:05:05,570
!ساياكو

49
00:05:06,900 --> 00:05:08,620
!كنتُ قلقة للغاية

50
00:05:08,620 --> 00:05:10,010
،لم يكن هناك أحد في منزلكِ

51
00:05:10,010 --> 00:05:11,360
ولم أتلقَّ رسالتك سوى هذا الصّباح

52
00:05:11,360 --> 00:05:12,870
كنتُ في مركزِ الشّرطة

53
00:05:12,870 --> 00:05:14,780
طالَ التّحقيق كثيراً

54
00:05:14,780 --> 00:05:15,750
!أنا آسفة جدّاً

55
00:05:18,960 --> 00:05:20,850
لا حاجة لتعتذري

56
00:05:20,850 --> 00:05:22,460
يسرّني أنّكِ بأمان

57
00:05:23,170 --> 00:05:24,000
نعم

58
00:05:25,450 --> 00:05:26,700
تبّاً

59
00:05:26,700 --> 00:05:30,090
لا أصدّق أن تعمل الشّرطة على استجوابِ
فتاةٍ جميلة مثلكِ طوال اللّيل

60
00:05:30,840 --> 00:05:32,270
...نوزو-تشان

61
00:05:32,560 --> 00:05:34,890
لكن هل أنتِ بخير حقّاً؟

62
00:05:34,890 --> 00:05:35,880
،إذا أردتِ

63
00:05:35,880 --> 00:05:37,190
يمكنني التكلُّم مع أبي

64
00:05:37,190 --> 00:05:39,190
أنا بخير يا نوزو-تشان

65
00:05:39,190 --> 00:05:40,490
شكراً لكِ

66
00:05:40,670 --> 00:05:42,880
ماذا يعمل والدكِ؟

67
00:05:42,880 --> 00:05:45,870
والد نوزو-تشان ضابط شرطة

68
00:05:47,120 --> 00:05:50,300
يعمل في قسمِ شرطة العاصِمة على ما أعتقد

69
00:05:50,300 --> 00:05:52,520
سمعتُ أنّه يعمل في وكالة الشرطة الوطنيّة

70
00:05:52,520 --> 00:05:54,210
هل هما مختلِفان؟

71
00:05:54,210 --> 00:05:55,660
مختلِفان تماماً

72
00:06:07,540 --> 00:06:09,680
،كنتَ منغمساً جداً في ذلك

73
00:06:09,680 --> 00:06:10,970
يا ماكينا-سان

74
00:06:10,970 --> 00:06:14,720
لا نعرف أي شيء عن هذه المنظّمة
التي تدعم كيم كانث

75
00:06:14,720 --> 00:06:16,800
يجب علينا أن نجبره على الكلام

76
00:06:17,010 --> 00:06:17,920
نعم

77
00:06:18,410 --> 00:06:20,590
،وبيني وبينك

78
00:06:20,590 --> 00:06:23,130
المسألة شخصيّة بعض الشيء

79
00:06:23,130 --> 00:06:24,560
شخصيّة؟

80
00:06:24,560 --> 00:06:30,330
سمعتُ أنّ صديقةً لابنتي كادَتْ أن
تُقتَل في إيداباشي

81
00:06:30,330 --> 00:06:31,620
وهل هي بخير؟

82
00:06:31,620 --> 00:06:32,860
أجل

83
00:06:32,860 --> 00:06:35,870
كان ذلك وشيكاً، لكن أنقذتْها رابشر

84
00:06:35,870 --> 00:06:38,830
يبدو أنّنا مَدينون للفتاةِ السحريّة بواحدة إذاً

85
00:06:39,250 --> 00:06:41,950
كانت ابنتي خائفة جدّاً

86
00:06:41,950 --> 00:06:45,340
كان ينبغي أن يفعلوا هذا الهراء خارج اليابان

87
00:06:45,340 --> 00:06:47,420
إنّها في مدرسة ثانويّة، صحيح؟

88
00:06:47,420 --> 00:06:48,480
نعم

89
00:06:48,480 --> 00:06:50,620
إنّها مفعمةٌ بالحيويّة وظريفة جداً

90
00:06:50,620 --> 00:06:53,230
أعتقد أنّها لم ترث ذلك من والدها

91
00:06:53,230 --> 00:06:55,390
ماذا تعني؟

92
00:06:55,880 --> 00:06:58,400
ماذا تخبر ابنتك حول عملك؟

93
00:06:58,400 --> 00:07:01,100
أقول لها أنّه عمل مكتبيّ مملّ

94
00:07:01,100 --> 00:07:02,350
هكذا إذاً

95
00:07:02,350 --> 00:07:05,320
لكن أخبرتها أنّ الأعمال اليوميّة المملّة
التي نقوم بها

96
00:07:05,320 --> 00:07:07,810
هو ما يساعد الشّرطة في الشّوارع
على أداء أعمالهم

97
00:07:08,420 --> 00:07:12,530
مُلحَق الاتّصالات الحسّاسة التابع لقسم
مكافحة الإرهاب الدولي

98
00:07:13,060 --> 00:07:16,000
مكتبُنا غير موجود رسميّاً حتّى

99
00:07:16,890 --> 00:07:18,340
،والآن

100
00:07:18,340 --> 00:07:20,420
أعتقد أنّ الوقت قد حان للعودةِ إلى العمل

101
00:07:20,650 --> 00:07:23,880
ينبغي أن تكون العقاقير قد أخذت مفعولها الآن

102
00:07:54,130 --> 00:07:56,750
قُتِلَ الزميل كيم كانث

103
00:07:57,150 --> 00:07:59,200
علينا أن ننتقم

104
00:08:00,400 --> 00:08:03,670
لا تفكّروا بأمور مجنونة

105
00:08:05,880 --> 00:08:08,840
لديّ طريقة مثاليّة للانتقام

106
00:08:08,840 --> 00:08:10,400
خذوا

107
00:08:10,400 --> 00:08:13,050
هديّة من ملكتي

108
00:08:13,650 --> 00:08:16,430
!هديّة هالوين سعيد مبكّرة قليلاً

109
00:08:33,210 --> 00:08:34,130
أتريدين قليلاً؟

110
00:08:34,800 --> 00:08:35,940
...في الواقع

111
00:08:35,940 --> 00:08:37,340
لا تقلقي

112
00:08:37,340 --> 00:08:39,110
نحن صديقتان، صحيح؟

113
00:08:39,660 --> 00:08:43,600
حسناً، سأجرّب قليلاً

114
00:08:45,860 --> 00:08:51,710
تحتاج ساياكو لكثير من السّعرات الحراريّة
لتحافظ على هذا القوام

115
00:08:52,780 --> 00:08:54,490
!لا

116
00:08:54,490 --> 00:08:56,580
،تمّ استجوابي طوال الوقت البارحة

117
00:08:56,580 --> 00:08:59,680
...ولم أتعشّ، لذا

118
00:08:59,990 --> 00:09:02,000
يسرّني أنّكِ جائعة

119
00:09:02,000 --> 00:09:03,140
هذا يشعرني براحة

120
00:09:03,410 --> 00:09:04,740
أليس كذلك؟

121
00:09:04,740 --> 00:09:08,110
نحن مَدينون لتلك الفتاة السحريّة بالكثير

122
00:09:09,650 --> 00:09:13,320
كانَتْ على الأرجح إحدى الفتيات السحريّات
الخمس، أليس كذلك؟

123
00:09:15,310 --> 00:09:17,440
الفتاة السحريّة رابشر

124
00:09:17,440 --> 00:09:20,160
الفتاة التي أنقذت العالم

125
00:09:20,160 --> 00:09:22,720
لا أعلم إن أنقذت العالم فعلاً

126
00:09:22,720 --> 00:09:24,750
،ما زالت الحروب مستمرّة

127
00:09:24,750 --> 00:09:26,500
وما زال الإرهاب موجوداً أيضاً

128
00:09:26,790 --> 00:09:30,200
كانت أوّل مرّة تقاتل فيها البشريّةُ عدوّاً
!من عالمٍ آخر

129
00:09:30,200 --> 00:09:31,710
!وربِحنا

130
00:09:31,710 --> 00:09:32,960
!هذا كافٍ

131
00:09:32,960 --> 00:09:34,090
هكذا إذاً

132
00:09:35,490 --> 00:09:40,760
ماذا تحبُّ الفتيات القويّات أن تفعلن
في مُعظم الوقت؟

133
00:09:40,760 --> 00:09:43,060
ما الذي يفكِّرن فيه؟

134
00:09:43,690 --> 00:09:46,550
...لديهن قوّة مدهشة

135
00:09:46,550 --> 00:09:48,550
قوّة مُحاربة جيش بمفردهن

136
00:09:50,820 --> 00:09:53,530
أعتقد أنّهن يفعلن ما بوسعهن

137
00:09:54,150 --> 00:09:55,640
يفعلن ما بوسعهن؟

138
00:09:55,640 --> 00:09:58,090
القوّة العظيمة تغيّر الناس

139
00:09:58,090 --> 00:10:00,400
يمكن أن تجعلهن عبيداً لقوّتهن

140
00:10:01,100 --> 00:10:05,520
حتّى الشّخص القدّيس الذي يكون فقيراً
قد يتغيّر حالما يصبح ثريّاً

141
00:10:06,730 --> 00:10:10,610
أعتقد أنّ الفتيات السحريّات ما زلن
...يفعلن ما بوسعهن

142
00:10:11,590 --> 00:10:14,010
،ليحرصن على أن تخدمهن قوّتهن

143
00:10:14,010 --> 00:10:15,540
وليس العكس

144
00:10:16,450 --> 00:10:20,260
وذلك كي لا يتخلّين عن العالم الذي ما زالت
فيه الأمور سليمة

145
00:10:26,260 --> 00:10:28,690
هكذا هو الأمر بتصوُّري

146
00:10:29,780 --> 00:10:31,140
تبّاً

147
00:10:46,260 --> 00:10:48,280
!ملكتي

148
00:10:48,280 --> 00:10:49,450
هل الأمور بخير؟

149
00:10:49,450 --> 00:10:51,030
بالطبع

150
00:10:51,030 --> 00:10:53,960
لكن هل أنتِ متأكِّدة من هذا؟

151
00:10:53,960 --> 00:10:57,330
...مساعدة أولئك الإرهابيّين الهمجيّين

152
00:10:57,330 --> 00:10:58,540
لا مُشكلة

153
00:10:59,520 --> 00:11:04,000
فنحن فتيات سحريّات سيّئات جدّاً

154
00:11:08,550 --> 00:11:10,210
،أسوكا-سان

155
00:11:10,210 --> 00:11:11,550
هل تحبِّين السّباحة؟

156
00:11:11,550 --> 00:11:12,690
لا أكرهها

157
00:11:12,830 --> 00:11:14,610
!رائع

158
00:11:14,610 --> 00:11:15,650
!ساياكو

159
00:11:19,720 --> 00:11:21,760
ساياكو؟

160
00:11:21,760 --> 00:11:22,910
ما الأمر؟

161
00:11:22,910 --> 00:11:26,510
قلتُ سِباحة

162
00:11:26,510 --> 00:11:28,620
هل أنتِ بخير يا ساياكو؟

163
00:11:29,240 --> 00:11:30,290
نـ-نعم

164
00:11:30,290 --> 00:11:31,710
لا شيء

165
00:11:31,900 --> 00:11:33,970
بل من الواضح أنّه يوجد شيء

166
00:11:33,970 --> 00:11:35,130
تكلّمي

167
00:11:38,470 --> 00:11:39,340
...في الواقع

168
00:11:47,190 --> 00:11:49,020
!ساياكو! ساياكو

169
00:11:53,400 --> 00:11:55,690
!ساياكو! ساياكو

170
00:11:57,000 --> 00:11:58,270
استنشقي

171
00:12:00,130 --> 00:12:01,290
نعم

172
00:12:01,290 --> 00:12:02,620
والآن زفير

173
00:12:03,200 --> 00:12:04,180
شهيق

174
00:12:08,310 --> 00:12:10,720
هل أطلب الإسعاف؟

175
00:12:10,720 --> 00:12:11,970
لا، لا داعي

176
00:12:11,970 --> 00:12:13,830
لقد تجاوزتُ ذلك

177
00:12:15,710 --> 00:12:17,250
...في الواقع

178
00:12:17,250 --> 00:12:18,790
...بخصوص ما حدث

179
00:12:18,920 --> 00:12:20,690
هل أنتِ بخير؟

180
00:12:20,690 --> 00:12:22,760
لا ينبغي أن تجبري نفسكِ على التذكُّر

181
00:12:22,760 --> 00:12:24,760
لا، دعيني أكمل

182
00:12:26,020 --> 00:12:29,360
تمكّنتُ من الذهاب إلى المنزل، صحيح؟

183
00:12:29,360 --> 00:12:31,840
وأعتقد أنّه لم يحدث شيء

184
00:12:31,840 --> 00:12:35,010
لكن كثير من النّاس لم يتمكّنوا من العودة
إلى المنزل، صحيح؟

185
00:12:36,570 --> 00:12:39,280
!لم أستطع فعل شيء

186
00:12:39,980 --> 00:12:41,650
كلّ ما استطعتُ فعله هو المُراقبة

187
00:12:42,060 --> 00:12:43,730
هذه ليست غلطتكِ

188
00:12:43,730 --> 00:12:45,560
لستِ فتاة سحريّة

189
00:12:45,560 --> 00:12:47,420
لم يكن بمقدوركِ إنقاذهم

190
00:12:47,420 --> 00:12:49,590
لا، الأمر ليس كذلك

191
00:12:49,590 --> 00:12:52,050
لم أفكّر حتّى بإنقاذهم

192
00:12:52,050 --> 00:12:54,000
قبل هذه اللّحظة، نسيتُ الأمر تماماً

193
00:12:54,000 --> 00:12:55,620
هذه ليست غلطتكِ يا ساياكو

194
00:12:55,620 --> 00:12:58,510
مُكافحة المُجرمين هو عملُ الشّرطة

195
00:12:58,510 --> 00:13:00,510
...ربّما، لكن

196
00:13:00,860 --> 00:13:03,760
لكن أنا ضعيفة جدّاً

197
00:13:03,970 --> 00:13:05,660
هذا غير صحيح

198
00:13:05,660 --> 00:13:06,460
أليس كذلك؟

199
00:13:08,740 --> 00:13:10,030
معك حقّ

200
00:13:10,030 --> 00:13:11,680
لستِ قويّة يا ساياكو

201
00:13:14,800 --> 00:13:19,440
لكن من الأفضل أن تكوني جبانة عوضاً
عن الادّعاء بأنّكِ قويّة بينما أنتِ عكس ذلك

202
00:13:20,740 --> 00:13:23,550
...الإنسان الذي يستطيع إدراك نقاط ضعفه

203
00:13:25,180 --> 00:13:26,160
هو شخصٌ قويّ

204
00:13:28,920 --> 00:13:31,310
كنتُ أعرف شخصاً كهذا

205
00:13:31,310 --> 00:13:32,580
...إنّها

206
00:13:37,350 --> 00:13:38,240
آسفة

207
00:13:38,240 --> 00:13:39,210
سأراكما لاحقاً

208
00:13:43,550 --> 00:13:44,770
انسَ الأمر

209
00:13:44,770 --> 00:13:46,500
لن تغيّر رأيي بالاتّصال بي طوال اليوم

210
00:13:46,500 --> 00:13:47,880
لن أعود إلى الجيش أبداً

211
00:13:47,880 --> 00:13:51,090
وقعَ هجومٌ إرهابيّ استُخدِمَ فيه سلاح
ديساس بيولوجي سحريّ

212
00:13:51,280 --> 00:13:52,560
ماذا؟

213
00:13:52,860 --> 00:13:54,280
إنّه من فئة هالوين

214
00:13:54,280 --> 00:13:56,290
في شينجوكو الجادّة الثّالثة

215
00:13:56,290 --> 00:13:58,480
مجموعة العمليّات الخاصّة قد أقلعَتْ
من ناراشينو

216
00:13:59,130 --> 00:14:01,260
!قضينا عليهم

217
00:14:01,260 --> 00:14:02,850
ما الذي يفعلونه هنا؟

218
00:14:02,850 --> 00:14:07,060
سمعتُ أنّ بقايا الحرب تُشترى وتباع
في السُّوق السّوداء

219
00:14:07,060 --> 00:14:09,100
هذه أوّل مرّة نرى فيها واحداً في اليابان

220
00:14:09,100 --> 00:14:11,540
هل تستطيع مجموعة العمليّات الخاصّة
معالجة الأمر من تلقاء نفسها؟

221
00:14:11,540 --> 00:14:14,620
لدينا وحدة مُدرَّبة لقتال الكائنات الحيّة
المضادّة للسحر

222
00:14:14,620 --> 00:14:17,250
،لكن لا نعلم ما إن كانوا يستطيعون الفوز

223
00:14:17,250 --> 00:14:18,840
وسيستغرق ذلك وقتاً في كلّ الأحوال

224
00:14:18,840 --> 00:14:20,580
ممرّضة الحرب في طريقها الآن

225
00:14:21,440 --> 00:14:22,540
!كورومي؟

226
00:14:26,290 --> 00:14:29,170
إنّها بحاجةٍ لشخصٍ أمامها حِفاظاً على سلامتِها

227
00:14:29,300 --> 00:14:32,930
إنّها حاليّاً الفتاة السحريّة الجاهزة للقتال
الوحيدة ضمن

228
00:14:32,930 --> 00:14:33,830
الحدود اليابانيّة

229
00:14:35,430 --> 00:14:36,360
!تبّاً

230
00:14:51,080 --> 00:14:54,500
أريدكِ أن تقاتلي وحوش الدّيساس معي

231
00:14:54,850 --> 00:14:56,960
لا أستطيع فعلها من تلقاء نفسي

232
00:14:57,140 --> 00:15:01,150
...لكنّني لستُ جيّدة في

233
00:15:01,150 --> 00:15:01,920
!أرجوكِ

234
00:15:02,360 --> 00:15:04,510
ليسَتْ أرواحنا فقط

235
00:15:04,510 --> 00:15:06,380
!أرواح الكثيرين على المحكّ

236
00:15:09,760 --> 00:15:12,960
عـ-عديني بشيء واحد

237
00:15:12,960 --> 00:15:13,840
ما هو؟

238
00:15:15,040 --> 00:15:17,390
...أنا لستُ

239
00:15:17,800 --> 00:15:20,850
لا أظنُّني بتلك القوّة

240
00:15:23,140 --> 00:15:24,510
،لذا يا أسوكا-سان

241
00:15:24,510 --> 00:15:28,200
احميني أرجوكِ

242
00:15:40,680 --> 00:15:43,760
!الفتاة السحريّة رابشر أسوكا

243
00:15:44,520 --> 00:15:47,040
سلاح بيولوجي سحري؟

244
00:15:47,040 --> 00:15:49,470
هل يعلمون ما تكبّدناه من معاناة؟

245
00:15:50,140 --> 00:15:53,180
...أولئك الوحوش الأشرار عديمي الرُّوح

246
00:15:53,380 --> 00:15:55,930
لماذا تعيدون مثل هذه الأشياء؟

247
00:15:59,330 --> 00:16:00,410
!كورومي

248
00:16:01,380 --> 00:16:07,540
!دبّ! دبّ! دبّ

249
00:16:08,170 --> 00:16:09,690
!دبّ

250
00:16:09,690 --> 00:16:10,270
دبّ؟

251
00:16:32,550 --> 00:16:35,890
!ممرّضة الحرب والفتاة السحريّة كورومي

252
00:16:35,890 --> 00:16:38,810
!ساتشو

253
00:16:44,020 --> 00:16:45,310
ستتمكّنين من المشي الآن

254
00:16:45,310 --> 00:16:46,220
!اخرجا من هنا

255
00:16:47,370 --> 00:16:48,240
!حسناً

256
00:16:49,240 --> 00:16:51,400
!دبّ

257
00:16:57,450 --> 00:16:59,740
!دبّ

258
00:17:04,660 --> 00:17:07,420
...دبّ

259
00:17:08,420 --> 00:17:09,880
دبّ؟

260
00:17:14,210 --> 00:17:17,540
!دبّ

261
00:17:17,540 --> 00:17:18,260
!ممتاز

262
00:17:18,540 --> 00:17:19,530
!كورومي

263
00:17:19,530 --> 00:17:21,140
!ابقي يقظة، تشو

264
00:17:21,140 --> 00:17:22,520
!دبّ

265
00:17:38,020 --> 00:17:39,240
هذا غير منطقيّ

266
00:17:39,240 --> 00:17:41,950
إنّه أقوى من فئات الهالوين القديمة التي قاتلتُها

267
00:18:17,980 --> 00:18:18,930
!أسوكا

268
00:18:18,930 --> 00:18:19,850
،ساتشو

269
00:18:19,850 --> 00:18:23,310
راقب السرعة التجديديّة للعدوّ ونشاطه الحيويّ

270
00:18:23,310 --> 00:18:25,570
تمّ منح الإذن لإنشاء وصلة مع حواسي

271
00:18:25,760 --> 00:18:27,300
!عُلِم، تشو

272
00:18:30,700 --> 00:18:33,190
هذا ليس أثراً من الماضي

273
00:18:33,190 --> 00:18:34,340
!لقد تمّ تعزيزه

274
00:18:35,250 --> 00:18:36,750
...لكنّه مع ذلك

275
00:18:37,740 --> 00:18:39,460
!ليس ندّاً لي...

276
00:18:45,280 --> 00:18:49,230
!دبّ

277
00:18:50,460 --> 00:18:52,880
أسوكا-سان؟

278
00:18:55,870 --> 00:18:57,150
...المعذرة

279
00:18:58,230 --> 00:18:59,410
لم أركِ منذ مدّة

280
00:19:01,210 --> 00:19:02,800
اشتقتُ إليكِ

281
00:19:09,900 --> 00:19:11,250
هل حصلت على البيانات؟

282
00:19:11,470 --> 00:19:13,900
!بالتأكيد، غوبو

283
00:19:13,900 --> 00:19:16,290
...ممرّضة الحرب ورابشر

284
00:19:16,290 --> 00:19:20,650
سيدفعان الثمن غالياً لإفسادهما هديّة الملكة

285
00:19:20,650 --> 00:19:22,430
أنتِ

286
00:19:22,540 --> 00:19:24,320
عليكِ الخروج من هنا

287
00:19:24,320 --> 00:19:26,600
فهذا المكان هو منطقة محظورة الآن

288
00:19:26,600 --> 00:19:28,810
أنا آسفة

289
00:19:42,060 --> 00:19:45,180
شكراً لإخلاصك للواجب يا حضرة الضابط

290
00:19:54,630 --> 00:19:56,600
!أريد لقمة واحدة، تشو

291
00:19:56,600 --> 00:19:58,600
!أريد لقمة واحدة فقط، تشو

292
00:19:58,600 --> 00:20:00,510
هل تأذّيتِ في المعركة؟

293
00:20:00,510 --> 00:20:02,100
أنا بخير

294
00:20:02,280 --> 00:20:04,090
أنا جيّدة في شفاء الجروح

295
00:20:04,090 --> 00:20:06,640
وفي عدم التأذّي

296
00:20:09,020 --> 00:20:13,220
كان من التهوُّر الوقوف في وجه عدوّ
من فئة هالوين بمفردكِ

297
00:20:13,930 --> 00:20:17,250
لكن لم يكن هناك أحد غيري

298
00:20:17,880 --> 00:20:22,080
لم يرد إيزوكا-سان إعطائي رقم هاتفك

299
00:20:22,520 --> 00:20:25,580
أنا من طلب منه التكتُّم عليه

300
00:20:26,020 --> 00:20:27,760
لماذا؟

301
00:20:27,760 --> 00:20:30,040
لم أرد التورُّط في أعمال الفتيات
السحريّات بعد الآن

302
00:20:32,730 --> 00:20:34,440
لم أرد أن أقاتل بعد الآن

303
00:20:37,250 --> 00:20:41,710
لطالما كنتِ تقولين أنّكِ تريدين الاعتزال

304
00:20:45,040 --> 00:20:48,940
لكن أنتِ من طلب منّي القيام بهذا

305
00:20:49,530 --> 00:20:50,800
...لكن

306
00:20:51,420 --> 00:20:53,070
أنتِ فظيعة

307
00:20:54,460 --> 00:20:57,330
،جعلتِني فتاةً سحريّة

308
00:20:57,330 --> 00:20:59,360
ومن ثمّ هربتِ

309
00:21:01,930 --> 00:21:05,720
...لا أعلم ماذا أقول، باستثناء أنّني

310
00:21:08,230 --> 00:21:12,570
التزمي بوعدكِ من الآن فصاعداً، اتّفقنا؟

311
00:21:18,460 --> 00:21:21,720
أنا لستُ شخصاً قويّاً

312
00:21:27,750 --> 00:21:29,600
هجوم إرهابي آخر؟

313
00:21:29,600 --> 00:21:30,680
!هذا جنون

314
00:21:31,010 --> 00:21:33,360
هل صحيحٌ أنّه كانت هناك فتاة سحريّة؟

315
00:21:33,360 --> 00:21:34,930
هل من فيديوهات؟

316
00:21:34,930 --> 00:21:37,520
هل من الآمن امتلاك فيديوهات لفتياتٍ سحريّات؟

317
00:21:37,520 --> 00:21:39,150
!إنّها سرّ دوليّ

318
00:21:39,150 --> 00:21:41,170
إذا سجّلتِ فيديو فأنا واثقة أنّ الشرطة
سوف تُلاحقك

319
00:21:41,170 --> 00:21:43,590
!ولن تعودي أبداً إذا اعتقلوكِ حسبما سمعت

320
00:21:43,590 --> 00:21:44,740
حقّاً؟

321
00:21:44,740 --> 00:21:45,950
!يا للهول

322
00:21:47,000 --> 00:21:50,580
هويّة الفتيات السحريّة يُعَدُّ من الأسرار
الدوليّة بالفعل

323
00:21:50,580 --> 00:21:53,440
لكن لا يتمّ اعتقال أحد على تصوير الفيديو

324
00:21:54,120 --> 00:21:58,000
سحر حجب الوعي الخاص بنا يؤثّر
حتّى على عدسات الكاميرا

325
00:21:58,720 --> 00:22:01,510
!حسناً يا تلميذات، اجلسن

326
00:22:02,090 --> 00:22:03,770
،هذا مُفاجئ

327
00:22:03,770 --> 00:22:08,100
لكن سنعرّفكن على تلميذةٍ منتقلةٍ أخرى

328
00:22:12,610 --> 00:22:18,370
سأتعلّم هنا في هذه المدرسة معكن
جميعاً ابتداء من اليوم

329
00:22:18,370 --> 00:22:20,480
اسمي موغين كورومي

330
00:22:21,510 --> 00:22:23,450
سررتُ بلقائكن جميعاً

331
00:23:57,410 --> 00:24:00,670
عندما تذهب فتيات سحريّات إلى المدرسة
!يصبح الأمر ممتعاً كثيراً

332
00:24:00,670 --> 00:24:03,690
مسابح مغلقة وملابس سباحة
!وما يطلبه الجمهور، تشو

333
00:24:03,690 --> 00:24:06,850
لكن ثمّة أمر بغيض يُثار في الطرف
!الآخر من البحر

334
00:24:07,140 --> 00:24:09,220
"الحلقة القادمة: حرب أكثر فظاعة

335
00:24:09,220 --> 00:24:11,550
!هاجس فظيع يقترب من التحقُّق، تشو