1
00:01:33,110 --> 00:01:36,740
كيف لشخص بلا موهبة أن يتمكّن
من دخول مدرستنا؟

2
00:01:36,740 --> 00:01:39,070
بتوصية من المُديرة على ما يبدو

3
00:01:39,070 --> 00:01:41,660
ماذا؟ لا مُحاباة؟

4
00:01:42,280 --> 00:01:44,410
!هيزوكي رينارد-يامادا

5
00:01:45,290 --> 00:01:46,860
!ياهو

6
00:01:46,860 --> 00:01:48,040
من أنتِ؟

7
00:01:48,040 --> 00:01:50,500
!عرّفتُ عن نفسي للتو

8
00:01:50,750 --> 00:01:53,300
لا ينبغي أن تحاولي التكلّم معي

9
00:01:53,840 --> 00:01:57,800
،إذا اعتقد الآخرون بأنّنا صديقتان
فسوف ينبذكِ صفُّنا

10
00:01:58,930 --> 00:02:00,510
!لنكُن صديقتين فحسب إذاً

11
00:02:00,510 --> 00:02:01,850
ماذا؟

12
00:02:01,850 --> 00:02:05,100
أفضّل امتلاك عدد قليل من الأصدقاء فحسب

13
00:02:07,520 --> 00:02:08,890
أنا آسفة

14
00:02:11,730 --> 00:02:14,020
انتقلت تلك الفتاة إلى هنا، صحيح؟

15
00:02:17,070 --> 00:02:19,150
لكن تمّ تجاهل الأمر تماماً

16
00:02:19,150 --> 00:02:20,820
كان هذا ليؤدّي إلى طرد في العادة

17
00:02:20,820 --> 00:02:22,160
...سامحيني

18
00:02:23,830 --> 00:02:27,830
سمعتُ بأنّ عشيرة رينارد لديها ميول فاميليا
،للخدمة كوُسطاء روحيّين

19
00:02:28,290 --> 00:02:32,130
لكن لا أشعر بأي آثار للاتّصال الرُّوحيّ

20
00:02:32,130 --> 00:02:37,300
لذا أعتقد بأنّ انقطاعاتكِ الدّوريّة
في الذّاكرة سببها مختلف

21
00:02:41,970 --> 00:02:43,380
آسفة

22
00:02:46,640 --> 00:02:48,060
!سامحوني

23
00:02:49,180 --> 00:02:54,570
،عيد ميلاد سعيد يا عزيزتي هيزوكي

24
00:02:54,570 --> 00:02:58,610
!عيد ميلاد سعيد لكِ

25
00:02:58,840 --> 00:03:00,230
أنا آسفة

26
00:03:07,490 --> 00:03:08,790
سامحوني

27
00:03:10,910 --> 00:03:12,920
!المعذرة يا هيجيكي

28
00:03:12,920 --> 00:03:14,130
هذا مذهل

29
00:03:13,420 --> 00:03:15,500
هذا هو منزل هيزوكي إذاً؟

30
00:03:16,000 --> 00:03:22,260
إنّه لشرف لي أن أتولّى مسؤوليّة
قيادة نخبنا اللّيلة وبكلّ تواضُع

31
00:03:22,260 --> 00:03:26,890
شكراً على اقتطاعكم من وقتكم المزدحم
للاجتماع هنا في منزل هيزوكي

32
00:03:25,990 --> 00:03:26,890
!طويل جدّاً

33
00:03:26,890 --> 00:03:29,700
!بصحّتكم

34
00:03:27,970 --> 00:03:30,350
!مهلاً! أنت تتسرّع يا فيلي

35
00:03:34,520 --> 00:03:38,570
مع أنّني لم أتوقّع أن تعملي
بدوام جزئيّ يا هيزوكي

36
00:03:38,570 --> 00:03:41,320
تسمح المدرسة للتّلاميذ بالعمل؟

37
00:03:41,320 --> 00:03:42,320
لا تسمح

38
00:03:42,320 --> 00:03:42,950
ماذا؟

39
00:03:43,490 --> 00:03:45,530
أعمل بشكل سرّي

40
00:03:46,870 --> 00:03:48,200
لا تشي بي، اتّفقنا؟

41
00:03:48,200 --> 00:03:49,950
!لن أفعل، لن أفعل

42
00:03:50,200 --> 00:03:51,210
تفضّلي

43
00:03:51,710 --> 00:03:53,170
شكراً لكِ

44
00:03:53,420 --> 00:03:56,880
أنتِ ماهرة جدّاً في الطّبخ يا ماكينا

45
00:03:56,880 --> 00:03:58,170
هذا مُفاجئ قليلاً

46
00:03:58,170 --> 00:04:01,300
عشتُ بمفردي منذ بضعة عقود

47
00:04:01,300 --> 00:04:02,510
ماذا؟

48
00:04:03,260 --> 00:04:05,510
عقود؟

49
00:04:05,090 --> 00:04:08,850
أجل، أجل! فيلي، هلّا اقترحتُ
!اقتراحاً مُتواضعاً؟

50
00:04:08,850 --> 00:04:09,600
سأسمح بذلك

51
00:04:09,600 --> 00:04:13,350
ما رأيكم أن نُقيم نحن الأربعة
بطولة لعبة قتال؟

52
00:04:13,350 --> 00:04:15,600
يبدو هذا مُسلّياً

53
00:04:15,600 --> 00:04:20,440
هذا اقتراح لا يمكنني تجاهله
كمُزوّد بثّ ألعاب

54
00:04:20,440 --> 00:04:23,240
لماذا تُسيّرون الأمور على هواكم؟

55
00:04:23,240 --> 00:04:24,990
ألا تحبّين ألعاب الفيديو؟

56
00:04:24,990 --> 00:04:26,450
...ماذا؟ في الواقع

57
00:04:26,450 --> 00:04:27,700
فهمت يا هيجيكي

58
00:04:28,080 --> 00:04:31,290
لا تجرئين على مواجهتي، أليس كذلك؟

59
00:04:31,660 --> 00:04:32,710
!ماذا؟

60
00:04:35,620 --> 00:04:37,170
الضّربة القاضية

61
00:04:37,170 --> 00:04:39,500
!اللّاعب 2 يربح

62
00:04:41,260 --> 00:04:45,430
لن أخسر أمام شخص يتلقّى هجمات مُنخفضة
وعلويّة وهجمات أثناء القفز

63
00:04:45,430 --> 00:04:46,260
مستحيل

64
00:04:46,260 --> 00:04:47,220
بجدّية؟

65
00:04:49,300 --> 00:04:51,350
!أنت مُذهلة

66
00:04:51,350 --> 00:04:53,730
فيلتول-ساما، لم تستطع الفوز حتّى بمُباراة واحدة

67
00:04:53,730 --> 00:04:56,850
أنا متفاجئة من قدرتك على الأداء بهذه
الجودة بجهاز إدخال عتيق كهذا

68
00:04:57,860 --> 00:05:00,190
!واجهيني تالياً يا هيزوكي

69
00:05:00,190 --> 00:05:02,110
أرغب في طلب نِزال كذلك

70
00:05:03,110 --> 00:05:06,240
بئساً، ماذا عسايّ أفعل؟

71
00:05:06,490 --> 00:05:08,990
!لن أخسر يا هيزوكي

72
00:05:07,030 --> 00:05:08,370
لا تخسري يا تاكاهاشي

73
00:05:07,660 --> 00:05:09,240
!أجل! يمين، يمين، يمين

74
00:05:08,990 --> 00:05:10,580
!أريها قوّتنا

75
00:05:18,130 --> 00:05:19,210
ماذا؟

76
00:05:20,590 --> 00:05:22,340
هذه أنتِ يا هيجيكي

77
00:05:22,340 --> 00:05:23,340
!ماذا؟

78
00:05:23,340 --> 00:05:24,970
...هـ-هيجي

79
00:05:24,970 --> 00:05:28,800
،أتفهّم الرّغبة في رؤية قوامي الملكيّ

80
00:05:26,930 --> 00:05:28,800
...إ-إنّه

81
00:05:28,800 --> 00:05:33,600
لكن أعتقد أنّ اختلاس النّظر أثناء استحمامي
هو تصرّف جسور جدّاً، أليس كذلك؟

82
00:05:29,550 --> 00:05:32,350
هـ-هيزوكي، مفهوم؟

83
00:05:33,600 --> 00:05:36,560
بئساً! حسناً

84
00:05:36,560 --> 00:05:38,270
سأسمح بذلك هذه المرّة

85
00:05:38,270 --> 00:05:40,270
لحظة. لماذا؟

86
00:05:40,270 --> 00:05:42,360
كانت كلّ الأضواء مُطفأة، صحيح؟

87
00:05:42,360 --> 00:05:44,190
،بصفتي الشّخص الّذي يعشق اللّيل

88
00:05:44,190 --> 00:05:44,940
ماذا؟

89
00:05:44,940 --> 00:05:47,280
من الطّبيعيّ لي أن أتنعّم بالظّلام

90
00:05:47,740 --> 00:05:50,570
أعتقد كانت غلطتي لعدم تفقُّدي أوّلاً

91
00:05:51,240 --> 00:05:53,040
أخبرني عندما تخرج

92
00:05:54,040 --> 00:05:55,660
فهمت يا هيجيكي

93
00:05:56,660 --> 00:06:00,830
لا بدّ أنّكِ تشعرين بالرّهبة وجسدي
المثاليّ معروض أمامكِ

94
00:06:00,830 --> 00:06:01,540
!ماذا؟

95
00:06:01,540 --> 00:06:03,880
!لـ-لـ-لـ-لستُ خائفة، مفهوم؟

96
00:06:03,880 --> 00:06:05,130
لا، لا مشكلة

97
00:06:05,510 --> 00:06:09,720
إنّ الاستحمام بجانب جسدي الّذي لا نظير له

98
00:06:10,090 --> 00:06:13,470
،سيجبركِ على مُقارنة جماله بجمال جسدكِ

99
00:06:13,470 --> 00:06:15,180
شئتِ ذلك أم لم تشائي

100
00:06:15,520 --> 00:06:19,310
،حسناً، يبدو أنّكِ تمتلكين جسداً جميلاً بحدّ ذاتكِ

101
00:06:19,310 --> 00:06:20,770
لكن جسدي أجمل

102
00:06:21,110 --> 00:06:24,150
!لـ-لا تسخر منّي

103
00:06:24,690 --> 00:06:29,150
!إنّ الاستحمام معك ليس بالأمر الجلل

104
00:06:31,450 --> 00:06:33,950
عمّاذا تكلّمت حالما غادرتُ؟

105
00:06:33,950 --> 00:06:35,410
مع كورنيا

106
00:06:35,410 --> 00:06:40,000
سمعتُ بأنّكِ تلقّيتِ الرّيغاليا خاصّتكِ من سلفكِ

107
00:06:40,000 --> 00:06:41,540
هكذا إذاً

108
00:06:43,920 --> 00:06:45,090
...لماذا

109
00:06:45,630 --> 00:06:48,130
اهتممت لأمري؟

110
00:06:48,590 --> 00:06:51,220
...في المقصف، وفي المدينة الكهربائية

111
00:06:53,510 --> 00:06:57,270
هل لأنّني رئيسة عشيرة رينارد؟

112
00:06:57,270 --> 00:07:00,100
أنتِ تُسرفين في جلد ذاتكِ، أليس كذلك؟

113
00:07:00,100 --> 00:07:00,890
ماذا؟

114
00:07:00,890 --> 00:07:04,320
أتبع هواي فحسب

115
00:07:04,320 --> 00:07:06,820
إنّ نتائج النّزال كانت مُكافأة
على الثّأر للأودون خاصّتي

116
00:07:08,150 --> 00:07:10,030
رغم أنّ الأمر سيكون مختلفاً الآن

117
00:07:11,110 --> 00:07:13,660
تشاركنا الوجبات معاً

118
00:07:13,870 --> 00:07:14,830
نحن صديقان

119
00:07:16,370 --> 00:07:18,200
أبليتِ بلاء حسناً

120
00:07:18,200 --> 00:07:23,330
قدّرتِ والديكِ وسعيتِ جاهدة لتوفير
قوت اليوم وحميتِ عشيرتكِ

121
00:07:23,580 --> 00:07:25,290
وطبخكِ لا بأس به أيضاً

122
00:07:25,750 --> 00:07:27,800
تلك الباستا كانت هيجيكي، صحيح؟

123
00:07:27,800 --> 00:07:29,760
—لا، كانت بولونيز

124
00:07:29,760 --> 00:07:31,760
!لحظة، اسمي هيزوكي

125
00:07:31,760 --> 00:07:33,340
أنتِ ماهرة في الألعاب أيضاً

126
00:07:33,340 --> 00:07:36,100
مستواك هو العاديّ فحسب

127
00:07:36,100 --> 00:07:38,430
تحسّنتُ كثيراً عمّا كنتُ عليه

128
00:07:38,430 --> 00:07:41,520
فضلاً عن ذلك، كانت ماكينا هي
مَن يمتلك مهارات حقيقيّة

129
00:07:41,520 --> 00:07:43,020
راودني نفس التّفكير

130
00:07:44,230 --> 00:07:46,070
لم أتحمّس بهذا الشّكل منذ زمن

131
00:07:47,730 --> 00:07:49,030
هل استمتعت؟

132
00:07:49,280 --> 00:07:50,150
أجل

133
00:07:51,030 --> 00:07:52,110
وأنتِ؟

134
00:07:59,750 --> 00:08:01,500
كنتُ سعيدة

135
00:08:01,500 --> 00:08:02,540
بحقّ

136
00:08:05,290 --> 00:08:08,500
هل كانت تلك صورة مُؤطَّرة لكِ
عندما كنتِ أصغر سنّاً؟

137
00:08:08,500 --> 00:08:10,630
ماذا؟ أجل

138
00:08:11,630 --> 00:08:14,640
أخبأتِها لأنّ هناك شيئاً لا تريدين
من الآخرين أن يعرفوه

139
00:08:15,640 --> 00:08:16,720
أجل

140
00:08:18,060 --> 00:08:21,730
من الصّعب سؤالكِ عن نفسكِ

141
00:08:26,440 --> 00:08:27,650
حسناً، فهم

142
00:08:28,110 --> 00:08:29,570
سأخبرك

143
00:08:30,730 --> 00:08:32,440
سأشاركك أسراري

144
00:08:49,750 --> 00:08:50,710
!سايا

145
00:08:50,710 --> 00:08:51,960
!غيلنوري

146
00:08:51,960 --> 00:08:53,550
!صباح الخير

147
00:08:53,550 --> 00:08:55,430
صباح الخير

148
00:08:55,430 --> 00:08:57,430
!احزرا ما اليوم

149
00:08:57,430 --> 00:08:59,650
إنّه يوم ميلادكِ يا هيزوكي-ساما

150
00:09:00,720 --> 00:09:03,180
!هذا صحيح

151
00:09:03,180 --> 00:09:05,190
مُبارك

152
00:09:06,900 --> 00:09:08,100
!شكراً لكما

153
00:09:08,100 --> 00:09:11,150
!عيد ميلاد، عيد ميلاد

154
00:09:11,150 --> 00:09:13,830
انظر إلى هيزوكي-ساما كيف تستمتع

155
00:09:14,360 --> 00:09:19,490
اعتبارها طفلة مدينة السّحر والمدينة
الكهربائيّة الملعونة يبدو ككذبة

156
00:09:19,990 --> 00:09:25,120
آمل ألّا يقع مكروه على هيزوكي-ساما
إلى حين اعتمادها على نفسها

157
00:09:27,250 --> 00:09:28,880
هل قرّرتِ أي واحدة؟

158
00:09:29,210 --> 00:09:32,210
!تستغرق السيّدة وقتاً للتسوُّق

159
00:09:32,460 --> 00:09:36,050
!عجباً، أنت لا تفهم النّساء يا أبي

160
00:09:35,940 --> 00:09:37,430
لماذا أتوا إلى هنا؟

161
00:09:38,050 --> 00:09:39,680
عائلة خوَنة

162
00:09:39,680 --> 00:09:41,010
انقلعوا

163
00:09:41,760 --> 00:09:42,970
هذا صحيح

164
00:09:43,310 --> 00:09:45,890
ماذا يجدر بنا أن نفعل يا عزيزي؟

165
00:09:45,890 --> 00:09:48,400
!حسناً، أعرف ما يجب فعله

166
00:09:50,190 --> 00:09:52,520
ألم يكن ذلك لطيفاً يا هيزوكي؟

167
00:09:52,520 --> 00:09:53,320
!أجل

168
00:09:53,320 --> 00:09:55,280
هل ترينني من منظور إيجابيّ الآن؟

169
00:09:55,280 --> 00:09:56,570
تقريباً

170
00:09:57,230 --> 00:09:58,110
قاسية

171
00:09:58,110 --> 00:10:00,280
ما زال الطّريق أمامك طويلاً

172
00:09:58,410 --> 00:10:06,080
!عيد ميلاد سعيد لك

173
00:10:06,080 --> 00:10:11,210
!عيد ميلاد سعيد يا عزيزتي هيزوكي

174
00:10:11,540 --> 00:10:15,710
!عيد ميلاد سعيد لك

175
00:10:20,800 --> 00:10:25,350
أنا آسفة

176
00:10:27,480 --> 00:10:30,770
أنت وأمّك كنتُما غائبتين
عن الوعي أمام المشفى

177
00:10:31,190 --> 00:10:33,610
كانت جروحها أخطر بكثير من جروحكِ

178
00:10:34,230 --> 00:10:36,610
...فعلنا المستحيل، لكن

179
00:10:38,360 --> 00:10:39,910
...سامحوني

180
00:10:41,280 --> 00:10:42,870
الأمر الّذي يُؤرقني

181
00:10:42,870 --> 00:10:46,700
هو حقيقة أنّ السجلّات تنصّ على أن
ترِث الفتاةُ الرّيغاليا

182
00:10:46,700 --> 00:10:50,040
يبدو أنّ هيزوكي غير مُدرِكة لذلك بحدّ ذاتها

183
00:10:50,040 --> 00:10:55,670
على أيّ حال، ربّما هذا هو السّبب
الّذي جعلها تصبح هدفاً أيضاً

184
00:10:55,670 --> 00:10:57,260
هل من أفكار عن هويّة الجاني؟

185
00:10:57,260 --> 00:11:00,180
لو كان لديّ أدلّة، لقتلتُهم جميعاً بنفسي

186
00:11:01,550 --> 00:11:05,060
لكن لا تزال هيزوكي صغيرة

187
00:11:05,060 --> 00:11:07,980
هذا يعني أنّ علينا الاهتمام بها

188
00:11:07,980 --> 00:11:10,690
كلانا مَدينان لها بالكثير، صحيح؟

189
00:11:10,690 --> 00:11:11,770
أجل

190
00:11:12,480 --> 00:11:14,980
نحن مَدينان للشّخصين اللّذين
ماتا وهما يحميانها أيضاً

191
00:11:17,990 --> 00:11:19,030
...سامحوني

192
00:11:23,950 --> 00:11:26,910
سبب عيشي في أكيهابارا هكذا

193
00:11:26,910 --> 00:11:31,920
هو لأنّ أمّي وأبي أراداني
أن أعيش كنبيلة لهذه البلدة

194
00:11:33,330 --> 00:11:35,380
...لكن بصراحة، هذه المدينة

195
00:11:37,090 --> 00:11:42,470
كلّ من يحتكّ معي ينتهي المطاف به
بتلقّي الأذى والتخلّي عنّي

196
00:11:42,890 --> 00:11:47,350
لذا قرّرتُ أنّه من الأفضل ألّا
أقترب من أيّ شخص من البداية

197
00:11:48,970 --> 00:11:50,230
...أنا

198
00:11:54,940 --> 00:11:57,110
لن أكون سعيدة أبداً

199
00:11:59,780 --> 00:12:03,410
لا بدّ أنّه كان من الصّعب مُشاركة
ماضٍ كهذا على الملأ

200
00:12:04,320 --> 00:12:06,080
شكراً لكِ يا صديقتي

201
00:12:06,740 --> 00:12:09,370
،والآن بعد أن عرفت أسراري

202
00:12:10,250 --> 00:12:13,870
هلّا سامحتني مهما حدث؟

203
00:12:13,870 --> 00:12:18,590
أقسم باسمي كفيلتول فيلفيت فيلسفالت

204
00:12:20,510 --> 00:12:22,170
!أنت تتباهى زيادة عن اللّزوم الآن

205
00:12:23,600 --> 00:12:24,390
شكراً لك

206
00:12:24,390 --> 00:12:26,260
—أنا رجل وسيم برّاق

207
00:12:28,850 --> 00:12:33,270
!ثمّني ذكرى الاستحمام معي هذه لبقيّة حياتكِ

208
00:12:33,270 --> 00:12:33,850
!لا، لن أفعل

209
00:12:33,850 --> 00:12:34,690
لحظة

210
00:12:35,100 --> 00:12:35,900
ماذا؟

211
00:12:36,900 --> 00:12:41,030
مع الأسف، يبدو أنّ فترة استرخائي قد انتهت

212
00:12:41,030 --> 00:12:42,240
من أنت؟

213
00:12:42,700 --> 00:12:45,070
يمكنك أن تناديني بعديم الوجه

214
00:12:45,780 --> 00:12:49,540
لنقُل بأنّني بطل من النّقابة

215
00:12:51,370 --> 00:12:54,370
لديّ طلب منك

216
00:12:54,750 --> 00:12:58,380
نريدك أن تنسحب من هذه المدينة فوراً

217
00:12:58,380 --> 00:13:01,840
،كان ماركوس عضواً في منظّمتنا

218
00:13:01,840 --> 00:13:05,470
وهزيمته بشكل مُباشر جعلتنا
نعتبرك تهديداً خطيراً

219
00:13:06,010 --> 00:13:08,470
،إذا لبّيت مطلبنا

220
00:13:08,470 --> 00:13:11,930
فنعِدك ألّا نمسّ أيّ أحد منكم بضرّ

221
00:13:12,390 --> 00:13:16,400
سنتعامل أيضاً مع الخزينة تحت
المدرسة من أجلك

222
00:13:15,480 --> 00:13:17,230
هذا أمر مُستبعَد

223
00:13:17,730 --> 00:13:20,940
!لا تتصرّف بتعالٍ أيّها الأحمق

224
00:13:22,650 --> 00:13:26,660
هناك رجل واحد فقط في هذا العالم
يستطيع الوقوف في وجهي

225
00:13:26,660 --> 00:13:28,870
ويُطلِق على نفسه البطل

226
00:13:29,330 --> 00:13:33,370
وأيّ شخص آخر يجرؤ عى تبنّي
هذا اللّقب عقوبته الإعدام

227
00:13:34,620 --> 00:13:37,420
فشلت المُفاوضات إذاً

228
00:13:37,960 --> 00:13:40,210
أستأذن بالانصراف اللّيلة

229
00:13:41,380 --> 00:13:44,340
وثمّة أمر أخير

230
00:13:46,090 --> 00:13:48,840
مدينة أكيهابارا سوف تتغيّر

231
00:14:10,370 --> 00:14:12,620
يا له من تفتيش شديد

232
00:14:12,620 --> 00:14:15,620
أنت تفعلين المثل، صحيح؟

233
00:14:22,500 --> 00:14:27,050
لم تكن لدينا علاقة بحادث ماغ روسانتا

234
00:14:27,050 --> 00:14:30,970
لا، ليس هذا سبب مجيئي إلى هنا اليوم

235
00:14:32,260 --> 00:14:34,350
ماذا إذاً؟

236
00:14:36,980 --> 00:14:40,690
أتيتُ لأجل التّاج

237
00:14:42,980 --> 00:14:44,150
هل سمعتم؟

238
00:14:47,110 --> 00:14:49,200
مستحيل، هذا مُزيّف، صحيح؟

239
00:14:49,200 --> 00:14:50,320
يبدو أنّ هذا صحيح

240
00:14:50,320 --> 00:14:53,330
سمعتُ تلاميذَ آخرين يتحدّثون عن ذلك قبل قليل

241
00:14:53,330 --> 00:14:57,000
طالَها ذلك الانفجار؟ كم هذا عنيف

242
00:14:57,000 --> 00:14:58,710
تمزّقت إلى أشلاء؟

243
00:14:59,080 --> 00:15:00,500
أنباء عاجلة

244
00:15:00,500 --> 00:15:02,290
،رئيس شركة كورنيا التّجاريّة

245
00:15:02,290 --> 00:15:04,590
كورنيا سيبورد قد قُتِل

246
00:15:04,920 --> 00:15:07,050
حرس المدينة الكهربائيّة

247
00:15:07,050 --> 00:15:10,430
حدّد تراتّي غوتيل، المُديرة التّنفيذيّة
لمدرسة السّحر

248
00:15:10,430 --> 00:15:13,800
كمُشتبهة رئيسيّة في جريمة القتل
وجاري البحث عنها

249
00:15:13,260 --> 00:15:15,720
يا له من نبأ سيّئ

250
00:15:14,390 --> 00:15:19,980
وبهذا، نتوقّع أن تتفاقم أجواء التوتُّر سوءاً بين
مدينة السّحر والمدينة الكهربائيّة

251
00:15:15,720 --> 00:15:17,520
لا بدّ أنّ هذا مُزيّف

252
00:15:19,980 --> 00:15:23,650
الرّجاء من كافّة المُواطنين الحِفاظ على هدوئهم
بعد سماعهم هذه الأنباء

253
00:15:24,320 --> 00:15:30,110
أكرِّر، كورنيا سيبورد، رئيس
شركة كورنيا التّجاريّة قد قُتِل

254
00:15:30,110 --> 00:15:35,330
وحرس المدينة الكهربائيّة حدّد تراتّي
غوتيل كمُشتبهة رئيسيّة

255
00:15:32,320 --> 00:15:38,080
اعتباراً من هذه اللّحظة، نُعلِن عن حالة طورئ رقم 2
،في منطقة أكيهابارا بأكملها

256
00:15:35,330 --> 00:15:37,410
بينما تتمّ عمليّة المُلاحقة

257
00:15:38,080 --> 00:15:40,290
وجاري عقد اجتماع طارئ

258
00:15:40,660 --> 00:15:45,130
إلى كافّة التّلاميذ، الرّجاء التوجّه
إلى قاعة التّدريب العمليّ فوراً

259
00:15:45,380 --> 00:15:47,340
أتعتقدون بأنّ المُديرة قاتلة حقّاً؟

260
00:15:47,340 --> 00:15:49,050
غالباً كذبة لفّقتها المدينة الكهربائيّة

261
00:15:53,970 --> 00:15:55,260
!آنسة تراتّي

262
00:15:55,600 --> 00:15:57,850
هل الأنباء حول السيّد كورنيا صحيحة؟

263
00:15:57,850 --> 00:16:00,390
لا تقلقي. اهدئي رجاء

264
00:16:00,390 --> 00:16:03,350
...واحد آخر... من جديد

265
00:16:03,350 --> 00:16:06,020
اهدئي رجاء يا آنسة رينارد

266
00:16:06,730 --> 00:16:10,570
أريدكِ أن تصغي جيّداً إلى ما أنا
على وشك أن أقوله

267
00:16:11,950 --> 00:16:12,990
من أنتِ؟

268
00:16:14,620 --> 00:16:15,780
آنسة رينارد؟

269
00:16:15,280 --> 00:16:16,120
!لا

270
00:16:16,580 --> 00:16:21,120
عندما كنّا بمفردنا، كانت الآنسة
تراتّي تناديني هيزومي دوماً

271
00:16:21,790 --> 00:16:23,290
صحيح؟

272
00:16:27,750 --> 00:16:31,630
فمن أنتِ؟

273
00:16:34,430 --> 00:16:35,680
أبولفوس

274
00:16:46,690 --> 00:16:48,270
لا أحد يتحرّك

275
00:16:48,650 --> 00:16:50,230
أحذّركم

276
00:16:50,610 --> 00:16:52,440
جميعكم رهائن

277
00:16:52,820 --> 00:16:54,860
لا جدوى من المُقاومة

278
00:16:54,860 --> 00:16:57,990
من يعصي، يُقتَل فوراً

279
00:17:01,120 --> 00:17:05,120
ظننتُ بأنّني راقبتُكما بما يكفي من وقت

280
00:17:05,120 --> 00:17:08,290
...مع أنّني أعتقد عندما تكونين لوحدكِ

281
00:17:13,550 --> 00:17:15,020
هل تميّزينني الآن؟

282
00:17:16,680 --> 00:17:19,010
المُعلّمة ماغ؟

283
00:17:19,010 --> 00:17:20,430
أجل

284
00:17:20,430 --> 00:17:22,140
لكنّكِ مُتِّ؟

285
00:17:22,140 --> 00:17:23,020
...لا

286
00:17:23,020 --> 00:17:25,100
...لكن هذا جسد الآنسة تراتّي

287
00:17:26,350 --> 00:17:33,030
المهمّة الّتي تلقّيتُها من النّقابة
كانت جمع كلّ الرّيغاليا الثّلاثة

288
00:17:33,030 --> 00:17:35,610
العقبة الكبرى في المهمّة كانت

289
00:17:36,280 --> 00:17:38,200
كورنيا سيبورد

290
00:17:38,450 --> 00:17:43,160
ما كانت لتكتمل مهمّتي من دون قتله

291
00:17:43,450 --> 00:17:46,790
،رغم أنّه كان رجلاً يقظاً جدّاً

292
00:17:46,790 --> 00:17:51,880
أدركتُ بأنّه يرخي دفاعه أمام
العائلات العظيمة الثّلاث

293
00:17:51,880 --> 00:17:56,800
لذا سرقتُ جسد تراتّي غوتيل

294
00:17:57,300 --> 00:17:59,930
،دعيتُها إلى عيادة الجراحة الميكانيكيّة

295
00:17:59,930 --> 00:18:01,890
،واستخرجتُ وحدتها

296
00:18:01,890 --> 00:18:05,640
ووضعتُ وحدتي في جسدها

297
00:18:06,020 --> 00:18:07,140
أين الآنسة تراتّي؟

298
00:18:07,520 --> 00:18:08,900
من يدري؟

299
00:18:09,230 --> 00:18:13,650
غالباً طالَها ذلك الانفجار وصارت أشلاء

300
00:18:18,320 --> 00:18:23,700
حسناً إذاً، أحتاج تعاونكِ في مهمّتي

301
00:18:23,700 --> 00:18:25,500
!مُحال أن أساعدكِ

302
00:18:25,500 --> 00:18:28,670
لا، سوف تتعاونين

303
00:18:31,840 --> 00:18:34,050
أتساءل من ينبغي

304
00:18:34,050 --> 00:18:34,760
أن يكون

305
00:18:34,760 --> 00:18:36,260
الشّخص

306
00:18:36,260 --> 00:18:37,090
التّالي

307
00:18:37,090 --> 00:18:38,010
يا ترى؟

308
00:18:38,010 --> 00:18:41,180
هل تخطّطين لقتلي وسرقة الجِرم؟

309
00:18:42,180 --> 00:18:43,350
لا

310
00:18:44,140 --> 00:18:47,890
سأُجلِّي الإلَهة ميلديا

311
00:18:48,140 --> 00:18:51,730
الرّيغاليا الثّلاثة هي الهِبة المطلوبة
من أجل إتمام ذلك

312
00:18:51,730 --> 00:18:54,370
ستفترضين بأنّ الجِرم ما زال مفقوداً، صحيح؟

313
00:18:54,370 --> 00:18:56,990
،لكن الحقيقة هي أنّ الجِرم موجود هنا

314
00:18:56,990 --> 00:19:00,820
وميلديا قد هبطتْ إلى هذا العالم بالفعل

315
00:19:01,160 --> 00:19:05,540
عقب الفانتازيون، كائن روحيّ رفيع
المرتبة مثل ميلديا

316
00:19:05,540 --> 00:19:09,000
كان ينبغي أن تتلاشى وتعجز
عن الحفاظ على وجودها

317
00:19:09,000 --> 00:19:12,960
لكن تجنّبَتِ الإزالة بتقليص روحها

318
00:19:12,960 --> 00:19:15,050
ونقلها إلى داخل طفل رضيع

319
00:19:15,300 --> 00:19:18,260
تريدين أن تعرفي كيف عرفت ذلك؟

320
00:19:18,260 --> 00:19:21,470
،لأنّني عندما هاجمتُك قبل 10 سنوات

321
00:19:21,470 --> 00:19:26,180
تجلّتْ هي بشكل مُؤقّت وهاجَت وتصدّت لي

322
00:19:26,180 --> 00:19:27,520
أنا آسفة

323
00:19:27,520 --> 00:19:29,390
...إذاً الصّوت

324
00:19:29,640 --> 00:19:35,020
الإلَهة ميلديا تستخدم جسدكِ
بالفعل كمُضيف لها

325
00:19:36,530 --> 00:19:37,610
آلبيرت

326
00:19:37,610 --> 00:19:38,150
!ماذا؟

327
00:19:38,150 --> 00:19:39,190
لا تنظر إليّ

328
00:19:39,190 --> 00:19:43,410
سأمنحك شرف خدمتي كذِراع لي
في هذه المرّة فقط

329
00:19:44,240 --> 00:19:47,240
إذا دمّرتَ السّيوفَ الضّوئيّة
،فوق رؤوس التّلاميذ

330
00:19:47,240 --> 00:19:48,660
فسوف تُلغَى سيطرتها

331
00:19:49,250 --> 00:19:50,280
هل يمكنك فعلها؟

332
00:19:51,500 --> 00:19:54,880
تريدني أن أساهم في القضاء
—على أولئك النّاس؟ هذا

333
00:19:55,920 --> 00:19:57,760
!فهمت، فهمت، فهمت

334
00:19:58,130 --> 00:20:02,680
ستندلع حربٌ قريباً، وستتغيّر مدينة أكيهابارا

335
00:20:03,050 --> 00:20:05,640
لن يكون هناك أمان في هذه المدينة

336
00:20:11,690 --> 00:20:15,230
،لكن في حين أنّ ميلديا استجابتْ دفاعاً عن النّفس

337
00:20:15,230 --> 00:20:17,860
إلّا أنّها لم تُظهر أيّ أثر للتجلّي

338
00:20:17,860 --> 00:20:18,780
أنا آسفة

339
00:20:19,990 --> 00:20:22,450
لذا كانت قد خطرت على بالي فكرة

340
00:20:22,450 --> 00:20:25,120
،يمتلك الجِرم قوّة التحكُّم بالألوهيّة

341
00:20:25,120 --> 00:20:31,540
لذا ماذا لو استخدمت تلك القوّة للتحكّم
بتجلّيات ونوبات غضب ميلديا؟

342
00:20:32,620 --> 00:20:37,130
هذا أيضاً السّبب وراء مخزون
المانا المُنخفض غير العاديّ لديكِ

343
00:20:37,130 --> 00:20:43,340
جعلني ذلك أتساءل فيما إذا كانت كلّ المانا
خاصّتكِ تُستخدَم لضبط ميلديا والختم عليها

344
00:20:43,840 --> 00:20:48,430
لكن إذا كان كذلك، فأين كانت الجِرم
الّذي كان يُستخدَم للتحكّم بها؟

345
00:20:49,140 --> 00:20:50,640
،وفقاً للسجلّات

346
00:20:50,640 --> 00:20:54,980
احتجتِ لعمليّة جراحيّة لإزالة عينكِ
اليمنى وتبديلها بأخرى اصطناعيّة

347
00:20:54,980 --> 00:20:58,650
بعد أن أُصِبتِ بجروح نتيجة هجمتي
عليكِ قبل 10 سنوات

348
00:20:58,650 --> 00:21:03,030
غير أنّ عينكِ اليمنى ليست اصطناعيّة

349
00:21:05,910 --> 00:21:10,370
أثناء العمليّة الجراحيّة، طلبَتْ أمُّكِ
أن يزرعها الطّبيب

350
00:21:10,740 --> 00:21:14,620
!عينكِ اليُمنى هي الجِرم

351
00:21:15,330 --> 00:21:16,540
أنا آسفة

352
00:21:19,420 --> 00:21:20,550
!فيلي

353
00:21:20,550 --> 00:21:22,510
!العدوّ يستهدف هيزوكي

354
00:21:22,510 --> 00:21:23,800
!إنّهم على السّطح غالباً

355
00:21:23,800 --> 00:21:25,680
أحسنتِ صنعاً يا تاكاهاشي

356
00:21:25,680 --> 00:21:27,760
!سوف أطاردها

357
00:21:27,760 --> 00:21:28,550
سأدعها لكِ

358
00:21:29,140 --> 00:21:30,010
!آلبيرت

359
00:21:30,010 --> 00:21:30,780
ماذا؟

360
00:21:32,920 --> 00:21:33,990
يمكنك تولّيه، صحيح؟

361
00:21:34,690 --> 00:21:35,720
عُلِم

362
00:21:36,090 --> 00:21:37,620
ما رأيكِ؟

363
00:21:37,620 --> 00:21:39,440
لم تكوني تعلمين، صحيح؟

364
00:21:42,160 --> 00:21:47,250
!قتلتُ ذلك الطّبيب ووالديكِ، جميعهم

365
00:21:47,250 --> 00:21:50,440
تتذكّرين تلك الصّديقة الّتي جرحتِها، صحيح؟

366
00:21:50,440 --> 00:21:53,780
!كانت  أيضاً مغتالة أرسلتُها لقتلكِ

367
00:21:53,780 --> 00:21:57,070
!ثمّ أتيتِ إليّ لاستشارتي

368
00:21:57,070 --> 00:22:00,740
!كان ذلك مُضحكاً للغاية

369
00:22:03,560 --> 00:22:06,920
...أنا حقّاً

370
00:22:09,200 --> 00:22:12,600
لا يمكن الغفران لي

371
00:22:12,600 --> 00:22:15,190
أنا آسفة

372
00:22:20,140 --> 00:22:23,340
تغطّي الغيوم القمر، وتقذف الرّياح الزّهور

373
00:22:23,760 --> 00:22:25,650
سأستعيد هيزوكي

374
00:22:25,900 --> 00:22:29,990
أنت حقّاً عنصر غير مُتوقَّع، أليس كذلك؟

375
00:22:29,990 --> 00:22:33,180
مُخطّط يُرسَم لمدّة 10 سنوات
!يذهب الآن أدراج الرّياح

376
00:22:33,180 --> 00:22:34,900
لقد خسرتُ

377
00:22:34,900 --> 00:22:36,630
،لكن

378
00:22:37,120 --> 00:22:40,520
لم تربح أيضاً

379
00:22:40,520 --> 00:22:44,410
لا يمكنك إخماد نيران الحرب
الّتي تحرق هذه المدينة

380
00:22:47,540 --> 00:22:48,460
!هيزوكي

381
00:22:48,460 --> 00:22:49,810
لستُ هي

382
00:23:30,790 --> 00:23:32,990
اسمي ميلديا

383
00:23:36,000 --> 00:23:37,640
"عودة الملِك"