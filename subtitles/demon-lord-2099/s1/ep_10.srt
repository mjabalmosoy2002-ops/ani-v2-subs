1
00:01:39,540 --> 00:01:41,750
ينبغي أن تبتعدوا عنّي

2
00:01:42,880 --> 00:01:44,820
وإلّا فأنا متأكّدة بأنّ مُصيبة ستقع عليكم

3
00:01:48,700 --> 00:01:50,820
هذا ليس من طِباعك يا هيزوكي

4
00:01:50,820 --> 00:01:52,540
كان ذلك شيئاً من الماضي

5
00:01:52,990 --> 00:01:54,710
لن تتكلّمي معهم ثانية أبداً

6
00:01:55,120 --> 00:01:58,220
!يامادا! طلبوكِ

7
00:01:58,930 --> 00:02:00,080
!قادمة

8
00:02:00,620 --> 00:02:04,170
!ظريفة للغاية

9
00:02:01,350 --> 00:02:02,050
!ماذا؟

10
00:02:03,460 --> 00:02:05,380
هذا يليق بكِ كثيراً

11
00:02:06,080 --> 00:02:08,020
!هذا حلم بحقّ

12
00:02:08,020 --> 00:02:10,870
!الأحلام موجودة هنا

13
00:02:10,870 --> 00:02:12,280
!الأفضل

14
00:02:11,200 --> 00:02:12,530
بالمناسبة يا هيجيكي

15
00:02:12,530 --> 00:02:13,600
!اسمي هيزوكي

16
00:02:14,030 --> 00:02:16,560
هل من المقبول لكِ أن تتكلّمي
بهذه الطّريقة؟

17
00:02:16,940 --> 00:02:19,200
الآن، لستُ زميلكِ التّلميذ

18
00:02:19,200 --> 00:02:21,170
أنا سيّدكِ

19
00:02:25,220 --> 00:02:29,170
يا سادة، ماذا تريدون أن تطلبوا؟

20
00:02:29,170 --> 00:02:32,290
!سأطلب ذلك الشّيء إذاً

21
00:02:33,540 --> 00:02:36,120
!حسناً إذاً

22
00:02:36,120 --> 00:02:43,970
!سأبذل قصارى جهدي لأجلكم يا سادة

23
00:02:43,970 --> 00:02:46,290
!ظريفة جدّاً يا مانانان-تشان

24
00:02:44,430 --> 00:02:47,440
!حسناً، ها أنا ذي

25
00:02:46,290 --> 00:02:48,150
!هذه هي مانانان الّتي عهِدناها

26
00:02:47,440 --> 00:02:54,140
!كُن لذيذاً وشهيّاً

27
00:02:54,140 --> 00:02:56,100
!موي، موي، كيون

28
00:02:56,100 --> 00:02:57,910
...في الواقع، هذا

29
00:02:57,910 --> 00:02:59,330
لا يمكنك فعلها؟

30
00:02:57,910 --> 00:03:02,610
عجّة موي-كيون الخاصّة بمانانان
!بمستوى آخر تماماً

31
00:02:59,650 --> 00:03:02,240
المعذرة، ليس عليك فعلها

32
00:03:02,610 --> 00:03:04,220
!هذا هو شكل الخادمة الحقيقيّة

33
00:03:03,020 --> 00:03:05,510
هل قلتُ بأنّني عاجزة عن ذلك؟

34
00:03:04,220 --> 00:03:05,950
!شكراً جزيلاً لكم

35
00:03:05,950 --> 00:03:09,140
!مانانان! مانانان

36
00:03:06,510 --> 00:03:08,490
!سوف أفعلها

37
00:03:08,490 --> 00:03:12,470
!سأريكم فخر خادمة حقيقيّة

38
00:03:13,240 --> 00:03:16,150
!البانكيك والبارفية أيضاً من فضلك

39
00:03:16,150 --> 00:03:18,050
تغيّرتْ تعابير وجهها

40
00:03:18,050 --> 00:03:19,880
سوف تفعلها

41
00:03:25,060 --> 00:03:27,400
!حسناً، ها أنا ذا

42
00:03:28,510 --> 00:03:36,730
!كُن لذيذاً وشهيّاً

43
00:03:36,730 --> 00:03:40,580
!موي، موي، كيون

44
00:03:40,580 --> 00:03:42,620
!حسناً، انتهيت

45
00:03:42,620 --> 00:03:44,530
!كُلوا حتّى الإشباع رجاء

46
00:03:44,530 --> 00:03:47,320
كم هذا خلّاب

47
00:03:45,030 --> 00:03:47,320
!مـ-مذهل

48
00:03:47,320 --> 00:03:51,200
!هذا على طريقة خادمات آكيبا كاواي القديم

49
00:03:50,130 --> 00:03:52,530
!مُبهر! إنّه عمل فنّي

50
00:03:52,530 --> 00:03:54,660
،لنكتفِ بهذا القدر

51
00:03:55,100 --> 00:03:57,040
!لِذا كُله قريباً يا سيّدي

52
00:03:55,590 --> 00:03:57,630
!شكراً لك يا مانانان

53
00:03:57,040 --> 00:03:57,710
يا

54
00:03:57,710 --> 00:03:58,270
يا سـ

55
00:03:58,270 --> 00:03:58,830
يا سـيّـ

56
00:03:58,830 --> 00:03:59,310
يا سيّد

57
00:03:59,310 --> 00:04:00,840
يا سيّدي

58
00:04:01,520 --> 00:04:03,720
كان ذلك شهيّاً حقّاً

59
00:04:03,990 --> 00:04:05,540
تستحقّين إطرائي

60
00:04:06,170 --> 00:04:08,470
!شكراً جزيلاً لك

61
00:04:08,470 --> 00:04:10,250
يمكنكِ الاسترخاء الآن

62
00:04:17,910 --> 00:04:20,570
...مهلاً! هذه لي

63
00:04:22,020 --> 00:04:25,790
أنتِ رئيسة عشيرة رينارد، صحيح؟

64
00:04:27,590 --> 00:04:31,540
أحتاج الرّيغاليا

65
00:04:31,540 --> 00:04:32,260
لماذا؟

66
00:04:32,640 --> 00:04:34,710
لحكم العالم

67
00:04:34,710 --> 00:04:36,670
عمّاذا تتكلّم؟

68
00:04:36,940 --> 00:04:40,340
أرغب في فتح الخزينة تحت
مدرسة أكيهابارا السّحريّة

69
00:04:40,340 --> 00:04:42,580
وأتحقّق ممّا بداخلها

70
00:04:44,200 --> 00:04:47,130
آسفة، لكن هذا غير ممكن

71
00:04:47,130 --> 00:04:49,760
لأنّكِ فقدتِ الرّيغاليا خاصّتكِ؟

72
00:04:51,260 --> 00:04:53,000
سمعتُ من تراتّي

73
00:04:54,130 --> 00:04:55,140
أجل

74
00:04:55,530 --> 00:04:58,600
وبسبب ذلك، دُمِّرت عشيرتي

75
00:04:58,600 --> 00:05:02,610
الآن أنا مجرّد تلميذة فقيرة تعمل
بدوام جزئيّ كي تعيش

76
00:05:02,610 --> 00:05:05,120
ماذا يُفترض أن يكون الرّيغاليا على أيّ حال؟

77
00:05:05,120 --> 00:05:08,440
لا تعرفين ما يكون ومع ذلك تُريدينه؟

78
00:05:08,640 --> 00:05:10,920
هذان هما من يريدانه

79
00:05:11,190 --> 00:05:13,120
أنا أُرافقهما فحسب

80
00:05:14,900 --> 00:05:20,420
هذه الأشياء تعمل كدليل
على ملَكيّة صاحبها

81
00:05:20,420 --> 00:05:23,300
—وفقاً لما قاله والدايّ منذ مدّة طويلة

82
00:05:23,300 --> 00:05:24,790
أنا آسفة

83
00:05:27,690 --> 00:05:31,940
قبل 500 عام، بعد أن قام البطل غرام
،بهزيمة سيّد الشّياطين

84
00:05:31,940 --> 00:05:34,290
أُعجِبَتْ به الإلَهة ميلديا

85
00:05:34,290 --> 00:05:37,480
ومنحَتْه الرّيغاليا والأرض

86
00:05:37,480 --> 00:05:39,820
وكنوز هائلة وبركَتها

87
00:05:40,180 --> 00:05:42,380
فيما بعد، نُفي البطل غرام

88
00:05:42,380 --> 00:05:45,390
بواسطة الملك، الّذي كان يُعرَف بعجزه

89
00:05:45,850 --> 00:05:50,850
قبل المُغادرة، تنازل غرام عن الرّيغاليا لشخص

90
00:05:51,180 --> 00:05:54,180
،كان ذلك الرّجل الملك لو كسيل الثّاني

91
00:05:54,180 --> 00:05:56,330
مُؤسّس العائلات العظيمة الثّلاث

92
00:05:56,910 --> 00:05:59,320
،عندما ورّث ذلك الملك العرش

93
00:05:59,320 --> 00:06:03,790
ائتمن أبناءه الثّلاثة على الرّيغاليا والمملكة

94
00:06:04,320 --> 00:06:06,490
رغم أنّه تبيّن بأنّه من المستحيل
أن ينسجموا معاً

95
00:06:06,490 --> 00:06:08,740
ومُشاركة السّلطة والثّروة الّتي تلقّوها

96
00:06:08,740 --> 00:06:11,270
،انقسموا إلى ثلاث قِوى مُعارضة

97
00:06:11,270 --> 00:06:13,360
،وبعد إراقة دماء غزيرة

98
00:06:13,360 --> 00:06:17,310
توصّلوا لاتّفاق على حكم هذا البلد
باستخدام نِظام برلمانيّ

99
00:06:17,950 --> 00:06:21,410
هذه هي الحالة الأصليّة أكيهابارا
والعائلات العظيمة الثّلاثة

100
00:06:21,410 --> 00:06:23,780
،الأمور أفضل بكثير الآن

101
00:06:23,780 --> 00:06:25,720
لكن استمرّت تلك الكراهيّة لسببٍ ما

102
00:06:25,720 --> 00:06:29,620
إذاً هذا هو سبب عدم إزالة الختم لخمسمئة عام

103
00:06:29,620 --> 00:06:30,820
كم هذا سخيف

104
00:06:31,770 --> 00:06:34,610
لا يهمّ بما أنّ الجِرم قد زال

105
00:06:34,610 --> 00:06:37,250
لذا لا جدوى من سؤالي عنه

106
00:06:37,500 --> 00:06:39,250
أعلم ذلك

107
00:06:39,250 --> 00:06:43,460
ما أرغب في طلبه هو أن تجمعينا
مع كورنيا سيبورد

108
00:06:43,940 --> 00:06:47,040
أعتقد سيلتقي بك إذا رافقتُه

109
00:06:47,040 --> 00:06:48,260
هلّا فعلتِ ذلك رجاء؟

110
00:06:49,500 --> 00:06:52,590
...حسناً، أنا مَدينة لكم

111
00:06:52,590 --> 00:06:55,970
!هيزوكي! أنتِ لطيفة للغاية

112
00:06:52,940 --> 00:06:55,970
!ماذا؟! مهلاً! لا تتشبّثي بي

113
00:06:58,670 --> 00:07:00,350
كان الصّوت صاخباً للغاية

114
00:07:00,350 --> 00:07:01,300
أجل

115
00:07:01,300 --> 00:07:03,890
لم يكن البانكيك كافياً بالنّسبة لك إذاً؟

116
00:07:04,400 --> 00:07:05,220
!ماذا؟

117
00:07:05,220 --> 00:07:07,030
!لـ-لم أكن أنا

118
00:07:07,030 --> 00:07:08,310
ليس عليكِ إخفاء ذلك

119
00:07:08,310 --> 00:07:09,870
هيّا، اطلبي شيئاً

120
00:07:09,870 --> 00:07:10,970
هل تريدين أرزّ بالعجّة؟

121
00:07:10,970 --> 00:07:13,360
!لم أكن أنا صدّقني

122
00:07:15,340 --> 00:07:16,740
انظروا

123
00:07:16,740 --> 00:07:20,170
أجل. ما الّذي يفعله تلاميذ المدينة
السّحريّة هنا؟

124
00:07:22,730 --> 00:07:25,000
أنتِ شَرِهة حقّاً يا هيزوكي

125
00:07:26,580 --> 00:07:29,590
أنتِ مُذهلة جدّاً لحصولكِ على موعد

126
00:07:29,590 --> 00:07:33,370
مع صاحب أكبر نفوذ في المدينة
الكهربائيّة خلال فترة قصيرة

127
00:07:35,050 --> 00:07:38,320
ليس وكأنّني مُذهلة أو ما شابه

128
00:07:38,320 --> 00:07:40,930
،وأيضاً لا نريد أن ندخل بأعداد كبيرة

129
00:07:40,930 --> 00:07:44,780
لذا واحد منكم فقط يستطيع
مُرافقتي لرؤية كورنيا

130
00:07:44,780 --> 00:07:46,520
سوف أذهب إذاً

131
00:07:48,030 --> 00:07:49,130
هذا لذيذ

132
00:07:49,800 --> 00:07:52,780
لا تُدعى بـ"بلدة اللّحم" عن عبث

133
00:07:54,800 --> 00:07:57,800
!إنّه يتلاءم بشكل مثاليّ مع صلصة اللّبن

134
00:07:57,800 --> 00:08:02,000
ما زال من المُكلِف جدّاً زراعة لحم
،الخنزير والدّجاج المُعدّل جينيّاً

135
00:08:02,000 --> 00:08:06,050
لكن لحم العجل الّذي تأكلونه الآن
هو لحم رخيص الصّنع

136
00:08:07,300 --> 00:08:12,220
مع ذلك لا تزال هناك طلبات للحم الخنزير
والدّجاج على أيّ حال، رغم مشاكل التّكلفة

137
00:08:13,840 --> 00:08:16,360
!اللّحم باهظ الثّمن شهيّ

138
00:08:16,360 --> 00:08:19,130
ما اللّحم الّذي تأكلينه يا هيزوكي؟

139
00:08:20,430 --> 00:08:21,900
لحم تنّين

140
00:08:23,220 --> 00:08:24,640
تنّين؟

141
00:08:24,930 --> 00:08:26,920
لِمَ تنظرون إليّ هكذا؟

142
00:08:26,920 --> 00:08:29,620
التنّين الأسود، سيلوالد

143
00:08:29,620 --> 00:08:30,820
أجل

144
00:08:30,820 --> 00:08:33,850
يراودني شعور غريب وأنا آكل لحماً
من نفس نوع خادمي

145
00:08:33,850 --> 00:08:35,820
أتردّد عن أكله أيضاً

146
00:08:35,820 --> 00:08:37,370
لا بأس في ذلك

147
00:08:37,370 --> 00:08:39,990
لكن إن كنتم نيّقين، فينبغي
أن تجرّبوا قضمة أوّلاً

148
00:08:39,990 --> 00:08:41,720
أم أنّكم تخشون أكله؟

149
00:08:43,040 --> 00:08:45,280
!فتاة صغيرة وقحة

150
00:08:45,280 --> 00:08:48,960
مضى وقت طويل منذ خاطبنا
!شخصٌ بهذه الطّريقة

151
00:08:52,080 --> 00:08:53,570
!هذا لذيذ بصورة مُفاجئة

152
00:08:53,870 --> 00:08:57,330
إنّه كلحم عجل يُشبه مذاقه الدّجاج

153
00:08:57,550 --> 00:09:00,870
ربّما كان ينبغي أن نجرّب أكل هذا مسبقاً

154
00:09:00,870 --> 00:09:04,280
سوف يتجدّد فوراً بما أنّه خالد أيضاً

155
00:09:04,280 --> 00:09:05,890
بوسعنا حصاد الكثير

156
00:09:05,890 --> 00:09:10,030
مهلاً، سوف يختفي حالما يتجدّد

157
00:09:11,250 --> 00:09:13,960
دُعابة الخلود خاصّتك مُبالغ بها

158
00:09:11,970 --> 00:09:13,540
هذا صحيح

159
00:09:16,820 --> 00:09:18,650
!هيزوكي

160
00:09:18,650 --> 00:09:21,160
!أعطيني عنوان فاميليا خاصّتكِ

161
00:09:21,160 --> 00:09:23,630
!ماذا؟ مستحيل

162
00:09:25,210 --> 00:09:26,860
...بو-هو-هو

163
00:09:26,860 --> 00:09:29,350
أمزح فحسب. سأشاركها

164
00:09:30,670 --> 00:09:32,850
أنا مسرورة لأجلكِ يا تاكاهاشي

165
00:09:32,850 --> 00:09:34,420
ما هذه الرّقصة؟

166
00:09:34,420 --> 00:09:36,140
المعذرة، هل لي بلحظة؟

167
00:09:36,520 --> 00:09:39,110
أنتم تلاميذ من المدينة السّحريّة، صحيح؟

168
00:09:39,740 --> 00:09:42,400
تلك الفتاة الّتي معكم هي الآنسة رينارد، صحيح؟

169
00:09:42,390 --> 00:09:44,490
...ماذا؟ ا-المعذرة

170
00:09:42,930 --> 00:09:44,890
هذا سيّئ

171
00:09:44,880 --> 00:09:48,590
لا نسمح بتسكُّع تلاميذ من المدينة
السّحريّة في هذه الأرجاء

172
00:09:49,020 --> 00:09:51,070
هلّا أتيتِ معنا قليلاً؟

173
00:09:51,070 --> 00:09:52,540
كفى ذلك

174
00:09:53,510 --> 00:09:55,200
تراتّي غوتيل

175
00:09:55,610 --> 00:10:00,400
هل الحُرّاس هنا يعتقلون التّلاميذ
بسبب الأكل فقط؟

176
00:10:01,260 --> 00:10:03,780
تبّاً! هيّا بنا

177
00:10:04,640 --> 00:10:08,840
كان مشهداً مُحرِجاً ترونه أنتم
الّذين من خارج البلدة

178
00:10:09,380 --> 00:10:13,750
لا سيّما عندما تكون كلّاً من المدينة
الكهربائيّة والسّحريّة مُوحَّدة

179
00:10:13,980 --> 00:10:16,710
كنتِ خير مُعين لنا

180
00:10:16,710 --> 00:10:18,820
مساء الخير يا حضرة مُديرة المدرسة تراتّي

181
00:10:18,820 --> 00:10:21,270
مساء الخير يا آنسة رينارد

182
00:10:21,820 --> 00:10:25,620
وبعد، ماذا تفعلون جميعاً هنا؟

183
00:10:25,620 --> 00:10:28,930
كانت هيزوكي تأخذنا في جولة
تعريفيّة حول أكيهابارا

184
00:10:28,930 --> 00:10:30,010
يا إلهي

185
00:10:30,010 --> 00:10:31,400
وأنتِ يا حضرة المُديرة؟

186
00:10:31,400 --> 00:10:33,760
سألتقي مع ماغ

187
00:10:33,760 --> 00:10:35,300
هل رأيتها؟

188
00:10:35,300 --> 00:10:36,520
لم أرها

189
00:10:37,320 --> 00:10:38,460
هكذا إذاً

190
00:10:39,110 --> 00:10:42,250
آنسة رينارد، هلّا تكلّمنا لبعض الوقت؟

191
00:10:44,940 --> 00:10:49,140
تاكاهاشي، يبدو أنّ المطعم هناك
يعمل على قلي كاراغي

192
00:10:49,140 --> 00:10:50,830
هل نذهب إذاً؟

193
00:10:51,740 --> 00:10:53,470
سوف آتي معكما

194
00:10:53,470 --> 00:11:00,740
!مقالي طازجة! مقالي طازجة

195
00:11:00,040 --> 00:11:04,410
يسرّني أنّكِ تعرّفتِ على أصدقاء
حميمين يا هيزوكي

196
00:11:05,160 --> 00:11:07,710
إنّهم ليسوا أصدقائي في الواقع

197
00:11:08,920 --> 00:11:11,850
المعذرة، عمّاذا أردتِ الكلام؟

198
00:11:12,630 --> 00:11:13,690
عرضي

199
00:11:14,220 --> 00:11:17,140
أيّ عرض؟

200
00:11:17,500 --> 00:11:20,370
عجباً! هل أنتِ هكذا دوماً؟

201
00:11:20,990 --> 00:11:22,610
عرضي في تبنّيكِ

202
00:11:23,550 --> 00:11:25,570
،إن كنتِ مستعدّة للقبول

203
00:11:25,570 --> 00:11:27,640
فأنا جاهزة لتبنّيكِ في أيّ وقت

204
00:11:29,120 --> 00:11:31,210
،إذا وقفتِ معي بهذا الشّكل

205
00:11:31,210 --> 00:11:33,610
فالنّبلاء الآخرون سوف ينبذونكِ

206
00:11:34,240 --> 00:11:36,250
لا تقلقي بشأني

207
00:11:36,660 --> 00:11:40,300
أريدكِ فقط أن تعيشي حياة سعيدة

208
00:11:42,410 --> 00:11:46,690
يجب أن أحمي عشيرة رينارد

209
00:11:47,350 --> 00:11:49,810
لأجل أمّي وأبي كذلك

210
00:11:52,180 --> 00:11:53,360
حسناً

211
00:11:53,750 --> 00:11:56,980
لكن تذكّري هذا فحسب

212
00:11:58,650 --> 00:12:05,750
لطالما كنتُ بجانبكِ منذ لحظة
ولادتكِ يا هيزوكي

213
00:12:07,000 --> 00:12:09,630
شكراً على كلّ شيء يا آنسة تراتّي

214
00:12:13,150 --> 00:12:15,870
حسناً، سوف أغادر الآن

215
00:12:16,320 --> 00:12:18,650
استمتعي مع التّلاميذ المُنتقلين

216
00:12:19,010 --> 00:12:19,850
حسناً

217
00:12:24,520 --> 00:12:25,460
أنا آسفة

218
00:12:27,400 --> 00:12:28,680
هيزوكي؟

219
00:12:28,960 --> 00:12:30,340
هل أنتِ بخير؟

220
00:12:30,340 --> 00:12:32,190
...لا  تبدين بخير

221
00:12:33,030 --> 00:12:34,390
أنا بخير

222
00:12:34,390 --> 00:12:35,140
—لكن

223
00:12:35,140 --> 00:12:36,550
أنا بخير حقّاً

224
00:12:38,370 --> 00:12:39,810
لا تقلقي بشأن ذلك

225
00:12:45,400 --> 00:12:46,960
آسف لو تأخّرتُ عليك

226
00:12:47,710 --> 00:12:50,850
أنا مُساعد كورنيا

227
00:12:50,850 --> 00:12:52,750
اسمي ميرال

228
00:12:52,750 --> 00:12:54,330
من دواعي سروري معرفتك

229
00:12:54,640 --> 00:12:57,830
،سيلتقي بك السيّد كورنيا اليوم

230
00:12:57,830 --> 00:13:01,690
لذا من فضلك سامحنا على قيامنا
بإجراء فحص جسديّ

231
00:13:09,540 --> 00:13:11,900
شكراً على التّعاون

232
00:13:11,900 --> 00:13:13,690
اسمح لي أن أدلّك على الطّريق

233
00:13:14,200 --> 00:13:15,070
!مرحباً

234
00:13:15,410 --> 00:13:19,020
أنا رئيس عشيرة سيبورد، كورنيا سيبورد

235
00:13:19,260 --> 00:13:23,690
شكراً جزيلاً لك على اقتطاعك من وقتك
!المزدحم بالأعمال لرؤيتنا

236
00:13:23,690 --> 00:13:28,980
،عندما تأتي فتاةٌ ظريفة مثلكِ للزيارة
فأكون سعيداً دوماً بالتّرحيب بها

237
00:13:30,310 --> 00:13:34,690
إذاً، هذا هو الشّخص الّذي يقول
بأنّه يريد اللّقاء بي؟

238
00:13:35,170 --> 00:13:38,130
اسمي فيلتول فيلفيت فيلسفالت

239
00:13:38,130 --> 00:13:40,490
فيلتول

240
00:13:41,130 --> 00:13:44,920
كنتُ قد افترضتُ بأنّ كافّة العائلات
،العظيمة الثّلاثة من دم إيلفيّ

241
00:13:44,920 --> 00:13:46,320
لكن أرى بأنّك غوبلن

242
00:13:46,320 --> 00:13:47,010
!مهلاً

243
00:13:47,360 --> 00:13:51,760
ماذا؟ يا له من سلوك تتّخذه
مع شخص التقيت به للتو

244
00:13:51,760 --> 00:13:55,390
لديّ عادة مُخاطبة عقلي

245
00:13:55,390 --> 00:13:57,510
!أ-أنا آسفة يا كورنيا

246
00:13:59,920 --> 00:14:02,380
لستُ مُنزعجاً من ذلك

247
00:14:02,380 --> 00:14:04,620
السّلالات لا تعني شيئاً

248
00:14:04,620 --> 00:14:07,530
،كنتُ مجرّد تاجر بسيط

249
00:14:07,530 --> 00:14:12,000
لكن صعدتُ طريقي بالكفاح
بعرق الجبين وذرف الدّموع والدّماء

250
00:14:12,000 --> 00:14:13,980
لم تكن تنشئتي ممتازة

251
00:14:14,450 --> 00:14:17,770
،انتهى المطاف بي بالاعتناء بالعجوز سيبورد

252
00:14:17,770 --> 00:14:19,720
حتّى رقتُ له

253
00:14:19,720 --> 00:14:23,860
فعلتُ الشّيء تلو الآخر ثمّ سرعان ما وجدتُ
نفسي حصلتُ على اسمه

254
00:14:23,860 --> 00:14:27,080
لذا لا توجد أي قطرة دم لو كسيل في عروقي

255
00:14:27,420 --> 00:14:28,320
...لذا

256
00:14:28,320 --> 00:14:30,310
ماذا أردت منّي؟

257
00:14:30,540 --> 00:14:33,000
أتيتُ لأسألك عن الرّيغاليا

258
00:14:33,280 --> 00:14:34,490
ماذا؟

259
00:14:38,730 --> 00:14:42,850
هذا هو الرّيغاليا الخاصّ بعشيرة سيبورد، التّاج

260
00:14:42,850 --> 00:14:44,470
سِلاح روحيّ؟

261
00:14:44,470 --> 00:14:46,400
تقريباً، لكنّه ليس كذلك

262
00:14:46,400 --> 00:14:50,540
صُنِع الرّيغاليا باستخدام جزء من القوّة

263
00:14:50,540 --> 00:14:53,420
المُقتطَعة من الإلَهة ميلديا

264
00:14:53,960 --> 00:14:58,070
يمكنك القول بأنّه جزء مُبلوَر من روحها

265
00:14:58,360 --> 00:15:01,400
ويمكن تخزينه داخل روح المالك

266
00:15:01,400 --> 00:15:04,250
،لذا ما لم أتخلّ عنه أنا، المالك
،أو تمّ قتلي

267
00:15:04,250 --> 00:15:06,810
فلن يُغادرني أبداً

268
00:15:06,810 --> 00:15:12,060
إذاً إن قتلتُك، فأستطيع الحصول عليه

269
00:15:15,050 --> 00:15:16,760
تماديتُ في مزاحي

270
00:15:18,650 --> 00:15:20,710
يا لك من شخص مُثير للاهتمام

271
00:15:20,710 --> 00:15:23,330
هلّا استعرتُ هذا لبعض الوقت؟

272
00:15:24,190 --> 00:15:29,050
هناك احتمال أن يكون الشّيء الّذي
أبحث عنه يتواجد داخل الخزينة

273
00:15:29,400 --> 00:15:31,310
أريد أن أتحقّق بشكل مُؤكّد

274
00:15:31,630 --> 00:15:34,790
لا يبدو لي أنّ هدفك هو الكنز

275
00:15:34,790 --> 00:15:36,980
هدفي هو غزو العالم

276
00:15:38,730 --> 00:15:42,950
...يبدو أنّك فقدت صوابك تماماً

277
00:15:43,300 --> 00:15:45,480
،لكن هيزومي أحضرَتْك إليّ

278
00:15:45,480 --> 00:15:49,820
لذا أرغب في الوثوق بك. لن أتقصّى كثيراً

279
00:15:50,480 --> 00:15:51,420
هل تمانعين؟

280
00:15:51,930 --> 00:15:52,630
أبداً

281
00:15:52,630 --> 00:15:54,430
شكراً

282
00:15:59,970 --> 00:16:04,460
أكيهابارا مُقيّدة حاليّاً بتقاليد قديمة

283
00:16:05,910 --> 00:16:08,670
،أريد كسر تلك الأجواء

284
00:16:09,020 --> 00:16:11,600
،لكن الشّعب العنيد في مدينة السّحر
ولا سيّما أولئك

285
00:16:11,600 --> 00:16:15,030
المُتمسّكين بمصالحهم، لا يفهمون فحسب

286
00:16:15,420 --> 00:16:21,220
رغم أنّ هذه المدينة بحاجة لأن تُولَد
من جديد من أجل مستقبلها

287
00:16:22,490 --> 00:16:25,800
تسألني إذاً ما إن كان بمقدورك
،استعارة الرّيغاليا خاصّتي

288
00:16:25,800 --> 00:16:29,100
،لكن حتّى لو سمحتُ بذلك
لا جدوى إطلاقاً

289
00:16:29,670 --> 00:16:36,600
يجب الاستحواذ على الرّيغاليا كلّها
لتحرير الختم عن الخزينة

290
00:16:36,600 --> 00:16:41,800
ما يعني أيضاً بأنّه يجب أن تصبح
الملِك الحقيقيّ لهذه المدينة

291
00:16:42,110 --> 00:16:45,120
...توحيد شظايا روح الإلَهة في جسد واحد

292
00:16:45,120 --> 00:16:49,270
لذا الحصول عليها أيضاً يعمل كطقوس
لاستدعاء الإلَهة

293
00:16:49,270 --> 00:16:50,550
أجل

294
00:16:50,550 --> 00:16:52,530
،حالما تجتمع كلّ الرّيغاليا معاً

295
00:16:52,530 --> 00:16:55,490
ستتمكّن من إخراج القوّة الحقيقيّة للإلَهة

296
00:16:56,080 --> 00:16:59,370
كلّ هذا الكلام عن الدّم النّبيل
ورموز الحُكم هو عبارة عن هُراء

297
00:17:00,120 --> 00:17:03,700
إنّ جمع الرّيغاليا كلّها تبقى الطّريقة الأسرع

298
00:17:03,700 --> 00:17:06,070
تراتّي تُفكّر بنفس الطّريقة غالباً

299
00:17:06,070 --> 00:17:09,930
تريد من الرّيغاليا أن تحمي تقاليد هذه المدينة

300
00:17:09,930 --> 00:17:13,020
بينما أريد من الرّيغاليا أن تُغيّر هذه المدينة

301
00:17:13,020 --> 00:17:14,750
كلانا على حقّ

302
00:17:16,800 --> 00:17:20,800
آسف، لكن هلّا غادر الجميعُ
الغرفة عدا هذا الشّخص؟

303
00:17:22,990 --> 00:17:27,620
لا أعرف ما نواياك الحقيقيّة خلف الرّغبة
في جمع الرّيغاليا الثّلاثة

304
00:17:27,620 --> 00:17:30,060
لكن هلّا أطلعتني على الأمر أيضاً؟

305
00:17:30,760 --> 00:17:33,980
سأخبرك بكلّ شيء أعرفه بالمقابل

306
00:17:34,790 --> 00:17:37,640
بما أنّنا سنتحالف، سأشاركك سرّاً صغيراً

307
00:17:37,640 --> 00:17:42,880
ثمّة أمر لا أريد من تلك الفتاة سماعه

308
00:17:43,680 --> 00:17:46,330
الجِرم موجود في مكان قريب

309
00:17:49,550 --> 00:17:55,290
لكن أصحاب الرّيغاليا يستطيعون الشّعور بالآخرين
ما داموا هنا في أكيهابارا

310
00:17:55,690 --> 00:17:57,360
نفس الأمر ينطبق على تراتّي غالباً

311
00:17:58,600 --> 00:18:01,350
لكن أريدك أن تصنع لي معروفاً

312
00:18:02,090 --> 00:18:05,350
أريدك أن تساعد تلك الفتاة، هيزوكي

313
00:18:06,190 --> 00:18:10,060
لعلّها تتظاهر بالقوّة، لكنّها ضعيفة

314
00:18:10,060 --> 00:18:13,220
إنّ تحرير تلك الفتاة من قيود هذه المدينة

315
00:18:13,220 --> 00:18:16,080
هو أحد الأسباب الّذي يجعلني
أرغب في تغيير هذه المدينة

316
00:18:16,520 --> 00:18:19,490
أنا مَدين لوالد تلك الفتاة بالكثير

317
00:18:19,490 --> 00:18:22,030
مات قبل أن أحظى بفُرصة لردّ الجميل له

318
00:18:22,570 --> 00:18:25,840
لذا أقلّ ما يمكنني فعله هو الاهتمام بها

319
00:18:27,290 --> 00:18:30,220
وفقاً للسجلّات، تلك الفتاة ورثت الجِرم

320
00:18:30,220 --> 00:18:32,970
من سلَفها عندما كانت مجرّد طفلة

321
00:18:33,280 --> 00:18:36,420
إنّ المفتاح إلى مواقع الرّيغاليا

322
00:18:36,940 --> 00:18:38,330
هو هيزوكي

323
00:18:40,580 --> 00:18:44,860
!لـ-لماذا هذا...؟

324
00:18:45,640 --> 00:18:48,520
لا أصدّق بأنّ المطاف انتهى بي
بشراء كتابي

325
00:18:49,180 --> 00:18:51,130
ماذا سأفعل بهذا؟

326
00:18:51,130 --> 00:18:53,580
!ماكينا! آسفة لو تأخّرت

327
00:18:53,990 --> 00:18:57,870
آسفة، المُساومة على السّعر استغرقتْ وقتاً

328
00:18:57,870 --> 00:19:00,560
،لم أنتظر تلك المدّة الطّويلة
لذا لا عليكِ

329
00:19:00,560 --> 00:19:02,490
ماذا؟ ماذا اشتريتِ؟

330
00:19:02,490 --> 00:19:04,560
...اشتريتُ كتاباً فحسب

331
00:19:04,560 --> 00:19:07,290
!ماذا؟ دعيني أرى، دعيني أرى

332
00:19:07,290 --> 00:19:08,530
هل هو كِتاب شقيّ؟

333
00:19:08,530 --> 00:19:10,290
!ماذا؟ لا

334
00:19:10,290 --> 00:19:12,160
!أنتِ تتحمّسين زيادة عن اللّزوم

335
00:19:14,580 --> 00:19:18,120
تاكاهاشي، هل أنتِ متأكّدة من هذا؟

336
00:19:18,120 --> 00:19:20,020
من ماذا؟

337
00:19:20,020 --> 00:19:21,390
برنامج التّبادُل

338
00:19:21,390 --> 00:19:23,800
لم تكوني مُضطرّة للمجيء معنا

339
00:19:23,800 --> 00:19:25,390
أتعتقدين بأنّني أعترض طريقكِ؟

340
00:19:25,390 --> 00:19:26,970
لا أقصد ذلك

341
00:19:27,880 --> 00:19:31,130
،أنا أحرِز درجات ممتازة في المدرسة

342
00:19:31,130 --> 00:19:32,980
لذا ليست مُشكلة

343
00:19:32,980 --> 00:19:36,350
عجباً! تتصرّفين كأخت كبرى
أحياناً يا ماكينا

344
00:19:36,350 --> 00:19:39,020
أنا أكبر منكِ كما تعلمين

345
00:19:39,340 --> 00:19:43,030
أشكّ بأنّه يوجد مَن هو أكبر منكِ يا ماكينا

346
00:19:43,450 --> 00:19:47,230
لكن كنتُ وافدة جديدة قريبة
من أقران الظّلام الستّة

347
00:19:47,520 --> 00:19:48,200
حقّاً؟

348
00:19:48,500 --> 00:19:51,760
فقط ماي العلياء الحزينة كانت أصغر منّي

349
00:19:52,150 --> 00:19:55,680
حسناً، تاريخ ماي مُعقّد قليلاً

350
00:19:55,680 --> 00:19:58,860
لذا لا يصحّ اعتبارها من الصِّغار

351
00:20:00,160 --> 00:20:03,380
هل كنتِ مُقرّبة إلى هذا الحدّ
من ماي هذه؟

352
00:20:03,770 --> 00:20:05,260
أجل

353
00:20:05,960 --> 00:20:10,130
كانت ماي كأخت صغيرة ظريفة لي

354
00:20:12,420 --> 00:20:13,960
ما الأمر؟

355
00:20:13,960 --> 00:20:15,750
لا شيء

356
00:20:15,750 --> 00:20:19,180
هل سيتأخّر فيلي إلى هذا الحدّ؟

357
00:20:20,510 --> 00:20:24,400
ماي... آمل أن تكون حيّة تُرزَق

358
00:20:24,850 --> 00:20:25,620
ماذا؟

359
00:20:25,870 --> 00:20:27,860
أليست تلك مُديرة المدرسة؟

360
00:20:27,860 --> 00:20:31,370
!يا حضرة المُديرة

361
00:20:34,630 --> 00:20:35,920
رحلَتْ

362
00:20:36,710 --> 00:20:38,830
!ضممتُ كورنيا إلى صفّنا

363
00:20:39,180 --> 00:20:41,740
إذاً هل حصلتَ على التّاج بالفعل؟

364
00:20:41,740 --> 00:20:44,880
،لا أقول بأنّنا حصلنا عليه

365
00:20:44,880 --> 00:20:47,530
لكن تلقّينا بعض المعلومات المُفيدة

366
00:20:47,840 --> 00:20:49,580
بفضل هيزوكي

367
00:20:49,580 --> 00:20:51,850
شكراً جزيلاً لك يا هيزوكي

368
00:20:52,460 --> 00:20:55,840
لا، لم أفعل شيئاً

369
00:20:57,160 --> 00:20:58,080
مهلاً، مهلاً

370
00:20:58,080 --> 00:20:59,470
ماذا سنفعل عقب هذا؟

371
00:20:59,470 --> 00:21:03,670
أرغب في تصفُّح الدّوجي— متاجر
الكُتُب القديمة أكثر

372
00:21:03,670 --> 00:21:05,410
!أريد تجربة الذّهاب إلى صالة أركيد

373
00:21:05,410 --> 00:21:08,900
لكن الوقت يتأخّر بالفعل

374
00:21:09,330 --> 00:21:11,550
،بفرض أنّنا سنزور تلك الأماكن غداً

375
00:21:11,550 --> 00:21:14,620
...يجدر بنا العودة إلى الحرم اليوم

376
00:21:14,620 --> 00:21:16,740
!أو بوسعنا الذّهاب وقضاء اللّيلة في منزل هيزوكي

377
00:21:16,740 --> 00:21:17,340
ماذا؟

378
00:21:17,340 --> 00:21:18,300
!ماذا؟

379
00:21:18,560 --> 00:21:20,500
هذه فكرة ممتازة

380
00:21:20,500 --> 00:21:22,500
هل أنت مُوافق عليها يا فيلتول-ساما؟

381
00:21:22,790 --> 00:21:24,340
لا أمانع

382
00:21:24,340 --> 00:21:26,340
!أنا أمانع

383
00:21:26,340 --> 00:21:28,810
فضلاً عن ذلك، لماذا تريدون الإقامة في منزلي؟

384
00:21:28,810 --> 00:21:30,820
!وذلك كي نخرج ونتنزّه معاً أكثر

385
00:21:30,820 --> 00:21:31,600
!ماذا؟

386
00:21:31,600 --> 00:21:34,320
أريد أن أتعرّف عليكِ بشكل أفضل

387
00:21:34,320 --> 00:21:35,490
—هل

388
00:21:36,100 --> 00:21:37,520
!هل أنتما غبيّان؟

389
00:21:37,890 --> 00:21:42,290
حُسِم الأمر إذاً. سننام اللّيلة
في قصر هيزوكي

390
00:21:42,290 --> 00:21:44,000
!مرحى

391
00:21:44,000 --> 00:21:47,390
!منامة، منامة

392
00:21:47,390 --> 00:21:52,960
!منامة، منامة، منامة، منامة

393
00:22:02,650 --> 00:22:04,270
لماذا؟...

394
00:23:35,760 --> 00:23:39,970
"إعادة تجسُّد الإلَهة"