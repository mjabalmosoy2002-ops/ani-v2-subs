1
00:00:05,050 --> 00:00:07,770
من فضلك، لا تحملقي بي هكذا

2
00:00:08,250 --> 00:00:11,980
جُلّ ما أريده هو الاحتفال بلمّ شمل

3
00:00:12,840 --> 00:00:14,440
مع صديق قديم

4
00:00:15,460 --> 00:00:17,240
!أيّها المعتوه

5
00:00:17,240 --> 00:00:22,420
لا يحقّ لك أن تعتبرني صديقة
!بعد أن خنتَ ملكنا

6
00:00:22,680 --> 00:00:27,660
عندما بُعِث فيلتول، أجريتُ
،بعض الأبحاث حول المُحيطين به

7
00:00:28,570 --> 00:00:32,910
لكن لم أتوقّع أبداً أن تتمكّني من النّجاة

8
00:00:33,270 --> 00:00:34,880
!أين نحن؟

9
00:00:35,530 --> 00:00:37,550
في قلب مدينة شينجوكو

10
00:00:38,030 --> 00:00:40,540
تحت المفاعل الإيثريّ تماماً

11
00:00:41,050 --> 00:00:45,670
مُنشأة سحر الطّقوس هذه للتّصفية الإيثريّة
تُعرَف باسم الفرن الخالد

12
00:00:45,940 --> 00:00:46,930
الفرن الخالد؟

13
00:00:47,290 --> 00:00:53,280
هذا ما نُطلِق عليه بالبرنامج الّذي يستخدم
أرواح الخالدين كوقود لتوليد الإيثر

14
00:00:53,860 --> 00:00:59,000
الإيثر المُنتَج بواسطة هذا الفرن الخالد
يُنقَل بعدها إلى المفاعل الإيثريّ

15
00:00:59,000 --> 00:01:06,970
حيث يُحوّل إلى كهرباء وطاقة سحريّة
تغذّي مدينة شينجوكو

16
00:01:07,500 --> 00:01:10,050
تستخدم أرواح الخالدين كوقود؟

17
00:01:11,850 --> 00:01:15,430
!إذاً هل تقصد بأنّ أورناريد وبالملوك...؟

18
00:01:15,660 --> 00:01:19,870
أدّيا دور حطب ممتاز

19
00:01:19,870 --> 00:01:23,030
الاهتمام الّذي أبدياه تجاه بعضهما
الآخر حتّى آخر لحظة

20
00:01:23,030 --> 00:01:25,380
،كان استعراضاً جميلاً للصّداقة

21
00:01:25,890 --> 00:01:30,100
لا، بل كان حُبّاً

22
00:01:32,260 --> 00:01:33,800
!حقير

23
00:01:34,350 --> 00:01:37,650
!أيّها الحقير

24
00:01:45,300 --> 00:01:49,250
هذه الكراهية مُرضية جدّاً

25
00:01:49,250 --> 00:01:51,100
!هل تملك أدنى فكرة عمّا تفعله؟

26
00:01:51,100 --> 00:01:54,300
بالطّبع أملك

27
00:01:55,960 --> 00:01:59,630
الموت الجسديّ غير موجود بالنّسبة للخالدين

28
00:02:00,020 --> 00:02:04,660
،لكن حالما يتمّ رميهم في الفرن الخالد
فإنّ أرواح الخالدين ستحترق

29
00:02:04,660 --> 00:02:07,110
حتّى تلقى حتفها

30
00:02:07,310 --> 00:02:11,560
باختصار، يموتون ميتة روحيّة

31
00:02:12,580 --> 00:02:15,140
اسمحي لي أن أخبركِ بشيء
ما دامت الفُرصة سانحة

32
00:02:15,510 --> 00:02:19,490
أتتذكّرين زينول، دوق سيف العاقبة؟

33
00:02:19,490 --> 00:02:22,020
كان أوّل شخص استخدمناه كحطب

34
00:02:23,130 --> 00:02:27,140
حرقتُ كثيراً من بَني جلدتنا في هذا الفرن

35
00:02:28,390 --> 00:02:30,210
الألم الّذي تكبّده الدّوق زينول

36
00:02:30,210 --> 00:02:35,410
،بينما كان جسده يشتعل باللّهب
،وروحه تحترق حتّى انخمدت أخيراً

37
00:02:35,710 --> 00:02:41,080
!كان من المستحيل تخيّله

38
00:02:41,080 --> 00:02:42,060
!سوف أقتلك

39
00:02:42,620 --> 00:02:46,860
!سوف أحرقك حتّى لا يبقى شيء من رمادك

40
00:02:46,860 --> 00:02:49,720
مُخيف، مُخيف

41
00:02:49,720 --> 00:02:52,250
لا تغضبي كثيراً من فضلكِ

42
00:02:52,250 --> 00:02:54,690
بفضل أولئك الخالدين العفيفين

43
00:02:54,690 --> 00:02:58,830
نستمتع بالحياة المترفة الّتي
نعيشها جميعنا الآن

44
00:02:58,830 --> 00:03:01,460
ينبغي أن تُظهري لهم امتناناً أكبر

45
00:03:01,460 --> 00:03:03,470
هل تنوي استخدامي كحطب أيضاً؟

46
00:03:03,470 --> 00:03:04,330
أجل

47
00:03:04,730 --> 00:03:07,490
حان الوقت لتصبحي حجر أساس هذه المدينة

48
00:03:07,740 --> 00:03:14,910
حتّى في آي.أتش.أم.آي، قلّة مختارة فقط
من تعلم بوجود الفرن الخالد

49
00:03:14,910 --> 00:03:17,300
أمسى من الصّعب تحريض النّاس

50
00:03:17,300 --> 00:03:19,750
الآن بعد أن صار المواطنون فاتري
،الهمّة عقب إعادة إعمار ما بعد الحرب

51
00:03:19,750 --> 00:03:21,560
،وإذا انتشر هذا على العلن

52
00:03:21,560 --> 00:03:26,720
فسنضطرّ لمواجهة بعض مُثيري المتاعب
الّذين يثرثرون حول "حقوق الخالدين" وما شابه

53
00:03:27,160 --> 00:03:29,070
،لذا حفاظاً على السرّية

54
00:03:29,070 --> 00:03:32,180
أتيتُ لأسركِ بنفسي

55
00:03:32,770 --> 00:03:38,140
،حطبنا الحاليّ كان على وشك النّفاد
لذا كان هذا التّوقيت المثاليّ

56
00:03:38,760 --> 00:03:41,950
الفرن الخالد هذا موجود في قلب مدينة شينجوكو

57
00:03:41,950 --> 00:03:44,600
لا نريده أن يتوقّف، أليس كذلك؟

58
00:03:45,360 --> 00:03:48,330
لحسن الحظّ، أنتِ إحدى أقران
،الظّلام الستّة أيضاً

59
00:03:48,560 --> 00:03:53,040
لذا ينبغي أن تصمدي طويلاً
ممّا يكسبنا الوقت المطلوب

60
00:03:53,040 --> 00:03:56,030
للبحث عن مصدر طاقة بديل

61
00:05:31,370 --> 00:05:38,510
قال ماركوس-ساما بأنّ سيّد الشّياطين سوف
يمرّ من هنا، لذا كلّفي بعرقلتك

62
00:05:39,030 --> 00:05:42,740
لكن لم أتوقّع أن تأتي فعليّاً

63
00:05:42,740 --> 00:05:46,050
ناهيك عن شريك آخر

64
00:05:46,050 --> 00:05:47,330
هذا شاذّ تماماً

65
00:05:48,660 --> 00:05:52,300
هل أنت البطل غرام؟

66
00:05:52,300 --> 00:05:55,450
أجل. أتعرفينني؟

67
00:05:55,450 --> 00:05:56,740
هذا شرفٌ لي

68
00:05:57,080 --> 00:05:59,710
هناك سجلّات عنك في قاعدة البيانات

69
00:05:59,710 --> 00:06:03,940
البطل الّذي لا يشيخ والّذي أبلى بلاء
حسناً أثناء الحرب الثّانية

70
00:06:04,450 --> 00:06:06,180
هكذا إذاً

71
00:06:06,180 --> 00:06:09,720
إذاً البطل وسيّد الشّياطين يتعاونان معاً الآن

72
00:06:10,270 --> 00:06:12,340
هذا مُثير للاهتمام

73
00:06:13,910 --> 00:06:16,160
سأتولّى أمرها

74
00:06:16,480 --> 00:06:19,760
لعلّي أصبحتُ قانطاً، لكن مهاراتي
لم تصدأ بعد

75
00:06:19,760 --> 00:06:21,320
لا تقلق بشأني

76
00:06:21,320 --> 00:06:25,330
أيّها الأحمق. مُحال أن أقلق عليك

77
00:06:25,800 --> 00:06:27,290
لكن كُن حذراً

78
00:06:27,750 --> 00:06:32,860
قد تكون مهارات هذه المرأة في استخدام
السّيف نظيرة لمهارات زينول

79
00:06:36,270 --> 00:06:38,470
إذاً سيكون نصراً سهلاً؟

80
00:06:39,730 --> 00:06:41,100
ماذا قلت؟

81
00:06:41,580 --> 00:06:44,230
،حقّقتُ نصراً مؤزراً ضدّ زينول
،دوق سيف العاقبة

82
00:06:44,230 --> 00:06:46,450
في نِزال صرف بالسّيف

83
00:06:46,450 --> 00:06:49,600
بإنجازي ذلك، مُحال أن أخسر

84
00:06:49,600 --> 00:06:51,080
صحيح

85
00:06:51,080 --> 00:06:55,060
كنتَ الأقوى في آرنيث كلّها عندما
يتعلّق الأمر بالسّيف وحده

86
00:06:56,510 --> 00:06:59,430
!مجرّد أوهام من الماضي

87
00:07:20,790 --> 00:07:22,940
!هل تعتقد بأنّني سأدعك تفلت؟

88
00:07:29,280 --> 00:07:30,660
!أنت تعترض طريقي

89
00:07:30,920 --> 00:07:33,170
استمع إليّ بينما تقاتل يا غرام

90
00:07:34,500 --> 00:07:35,630
!لا تمُت

91
00:07:36,000 --> 00:07:37,230
!عُلِم

92
00:07:40,380 --> 00:07:41,470
!فيستوم

93
00:07:48,460 --> 00:07:49,970
!وهم لعين

94
00:07:50,790 --> 00:07:54,270
!عصرك قد ولّى منذ زمن بعيد

95
00:07:55,190 --> 00:07:56,480
هذا صحيح

96
00:07:57,020 --> 00:07:59,960
مع أنّه لا يزال هناك شخص
يسعى ليكون بطلاً

97
00:08:01,920 --> 00:08:03,450
حسناً

98
00:08:05,080 --> 00:08:08,090
هذا يعني ببساطة أنّني بحاجة لحذفك بسرعة

99
00:08:08,090 --> 00:08:12,200
والعودة سريعاً إلى جانب ماركوس-ساما

100
00:08:12,530 --> 00:08:16,080
ثمّ سألتزم بالنّتائج

101
00:08:20,050 --> 00:08:22,480
زيروبيس، تفعيل

102
00:08:41,300 --> 00:08:42,400
درع؟

103
00:08:54,670 --> 00:08:56,000
عتاد ماغينو؟

104
00:08:56,520 --> 00:08:58,220
تماماً

105
00:08:59,130 --> 00:09:03,660
هذا نموذج أوّلي من عتاد ماغينو الجيل المقبل

106
00:09:03,660 --> 00:09:06,730
والّذي هو قيد التّطوير حاليّاً بواسطة
شركتنا، زيروبيس

107
00:09:07,010 --> 00:09:10,360
،من خلال تكييف استدعاء الأسلحة

108
00:09:10,360 --> 00:09:14,170
جعلنا المستخدم قادراً على استدعائه
بواسطة مُحفّز والتسلّح به فوراً

109
00:09:15,870 --> 00:09:17,540
نموذج جيل خامس

110
00:09:23,390 --> 00:09:26,110
،لكن بنموذج الجيل الخامس هذا، زيروبيس

111
00:09:26,110 --> 00:09:31,170
،نجحنا في جعله أصغر وأخفّ وزناً من سلفِه

112
00:09:31,580 --> 00:09:34,210
مع تحسين مُخرجاته بشكل كبير أيضاً

113
00:09:34,210 --> 00:09:36,770
وتحقيق كفاءة طاقة أفضل

114
00:09:36,950 --> 00:09:40,070
!إنّه ابتكار حقيقيّ في الصّناعة

115
00:09:40,070 --> 00:09:42,870
!ستكون هذه الآلة البوّابة نحو جيل جديد

116
00:09:43,230 --> 00:09:46,400
،لكن بخلاف نموذج الجيل الرّابع

117
00:09:46,400 --> 00:09:49,910
عيبه الوحيد هو أنّ زمنه التّشغيليّ

118
00:09:49,910 --> 00:09:53,150
يعتمد بشكل كبير على احتياطي
السّحر لدى مُستخدمه

119
00:09:53,720 --> 00:09:57,030
غير أنّ هذا سيُحَلُّ بالتّأكيد في المستقبل

120
00:10:05,690 --> 00:10:09,070
ستُمثّل بالنّسبة لنا بيانات اختبار
،قيّمة لزيروبيس

121
00:10:09,070 --> 00:10:10,680
لذا يجدر بك أن ينتابك الشّرف

122
00:10:10,920 --> 00:10:13,610
أنتِ تثرثرين كثيراً مثل زعيمكِ

123
00:10:13,610 --> 00:10:17,040
لم أطلب منكِ التّرويج لمنتجكِ

124
00:10:20,850 --> 00:10:23,550
كلّاً من سلاحك وأنت

125
00:10:24,210 --> 00:10:26,080
مجرّد أثر من الماضي

126
00:10:26,080 --> 00:10:28,310
حتّى الفاميليا خاصّتك نموذجها قديم

127
00:10:28,310 --> 00:10:30,350
!كلّ شيء فيك عتيق

128
00:10:30,750 --> 00:10:36,230
من جانب آخر، أمتلك أكثر الآليّات تطوُّراً
!وأمارس أحدث التّدريبات

129
00:10:36,500 --> 00:10:40,410
المعارك لا تُحسَم بعمر أو جودة العتاد

130
00:10:40,410 --> 00:10:42,120
إمّا أن ينتصر المرء أو يخسر

131
00:10:42,120 --> 00:10:43,340
هذا كلّ ما في الأمر

132
00:10:45,210 --> 00:10:46,580
...حسناً إذاً

133
00:10:59,090 --> 00:11:03,470
هكذا إذاً. لديك غريزة جيّدة

134
00:11:06,910 --> 00:11:09,570
لا أستطيع إيجاد ثغرة لشنّ هجوم

135
00:11:09,570 --> 00:11:12,270
تطوُّر التّكنولوجيا مُرعب

136
00:11:12,740 --> 00:11:15,780
يسرّني أنّني لم أضطرّ لمقاتلة هذا الشّيء

137
00:11:17,040 --> 00:11:18,110
أثناء حروب المدينة

138
00:11:20,830 --> 00:11:22,070
إنّه قاسٍ

139
00:11:28,670 --> 00:11:31,810
هجماتكِ العاديّة ليست بتلك السّرعة

140
00:11:31,810 --> 00:11:34,380
هل أنت متأكّد من ذلك؟

141
00:11:34,810 --> 00:11:40,380
سحركِ لا يتفعّل إلّا عندما تسحبين
سيفاً مُغمداً بالكامل

142
00:11:42,180 --> 00:11:46,340
أفترض كان ينبغي أن أتوقّع ذلك
من البطل المخضرم في المعارك

143
00:11:46,340 --> 00:11:48,000
ممتاز

144
00:11:48,000 --> 00:11:51,820
هذا هو سحري بالفعل، سحب البرق

145
00:11:53,930 --> 00:11:55,320
،لكن

146
00:11:55,320 --> 00:11:59,760
اكتشافك ذلك لا يعني بأنّ لديك فُرصة للفوز

147
00:11:59,760 --> 00:12:02,630
نصري مُقرّر مسبقاً بالفعل

148
00:12:03,270 --> 00:12:07,950
بعتاد ماغينو النّموذج الخامس وتعويذات
،سحب البرق السّريع

149
00:12:08,300 --> 00:12:10,580
الفارق في الإمكانيّات القتاليّة واضح

150
00:12:11,180 --> 00:12:14,580
حسناً، سئمتُ من الكلام

151
00:12:15,030 --> 00:12:17,140
لنضع حدّاً لهذا

152
00:12:19,010 --> 00:12:20,480
ها أنا ذي

153
00:12:40,930 --> 00:12:43,290
هل أنا عاجزة عن إصابتك؟

154
00:12:46,150 --> 00:12:48,950
لا بدّ أنّك تألف ذلك أيضاً

155
00:12:49,560 --> 00:12:50,980
هذا صعب للغاية

156
00:12:51,440 --> 00:12:52,490
...رغم ذلك

157
00:12:55,880 --> 00:12:58,310
،أنا المختارة

158
00:12:58,890 --> 00:13:01,800
مُحال لمُتخلّف رجعيّ

159
00:13:02,200 --> 00:13:03,340
!أن يتمكّن من هزيمتي

160
00:13:08,890 --> 00:13:10,510
!غلايف الأرض

161
00:13:18,020 --> 00:13:19,680
!هذا لا يكفي

162
00:13:21,390 --> 00:13:23,140
!نوفا الصّقيع

163
00:13:29,110 --> 00:13:31,180
!هذا غير كفيل بإيقاف زيروبيس

164
00:13:36,750 --> 00:13:40,490
لم أتوقّع من هذا أن ينجح بالطّبع

165
00:13:45,250 --> 00:13:46,120
!ماذا؟

166
00:13:48,220 --> 00:13:50,270
!كُرة النّار

167
00:14:05,000 --> 00:14:07,450
!أيّها المُزعج الوغد

168
00:14:08,010 --> 00:14:10,230
لم أخترقه بعد؟

169
00:14:10,800 --> 00:14:13,420
لكن يبدو أنّ هذا التّكتيك ينجح

170
00:14:13,660 --> 00:14:14,920
ماذا؟

171
00:14:14,920 --> 00:14:17,400
كان مزيج الهجمات هذا تقليداً

172
00:14:17,400 --> 00:14:20,240
لما استخدمه ظلاميٌّ ضدّي قبل خمسمئة عام

173
00:14:20,840 --> 00:14:25,750
يبدو أنّ التّكتيك ما زال فعّالاً ضدّ
أشخاص بتدريبكِ الأحدث هذا

174
00:14:26,140 --> 00:14:27,620
!لا تستهن بي

175
00:14:35,780 --> 00:14:36,840
!لماذا؟

176
00:14:36,840 --> 00:14:38,590
!لماذا لا أستطيع هزيمتك؟

177
00:14:45,880 --> 00:14:47,490
ألا تعلمين؟

178
00:14:47,760 --> 00:14:51,950
لو كان هذا كافياً لهزيمتي، لما كنتُ
أستحقّ لقب البطل

179
00:14:52,340 --> 00:14:55,860
!أيّها الرّجعيّ

180
00:15:02,020 --> 00:15:04,080
مُحال أن أخسر

181
00:15:04,650 --> 00:15:07,880
أمامك

182
00:15:08,340 --> 00:15:10,830
!وأمام هذا السّيف الصّدئ

183
00:15:11,910 --> 00:15:15,260
أهكذا يبدو سيفي في نظركِ؟

184
00:15:16,520 --> 00:15:19,460
،ما دام هناك أشخاص يحتاجون البطل

185
00:15:19,970 --> 00:15:23,230
سيبقى هذا السّيف مُحافظاً على بريقه

186
00:15:24,960 --> 00:15:30,180
!أطِع ندائي وتألّق يا إكساسوردي

187
00:15:33,020 --> 00:15:34,590
دينواه لوز
(التعرّف على البطل)

188
00:15:34,590 --> 00:15:35,950
أسترا روبس أران
(تحرير سيف الخلاص المُقدّس)

189
00:15:38,990 --> 00:15:41,210
ليز إكساسوردي
(تمّت الموافقة على سحب السّيف)

190
00:15:47,780 --> 00:15:49,180
،حاولي أن تصمدي أمام هذا

191
00:15:49,180 --> 00:15:50,670
البرق الأبيض

192
00:15:51,480 --> 00:15:55,190
هذا هجومي الأعظم الّذي دمّر
!سيّد الشّياطين

193
00:15:55,730 --> 00:15:58,010
!والآن احفظي هذا جيّداً في ذاكرتكِ

194
00:15:58,350 --> 00:16:01,290
!فلتشهدي نور هذه الشّمس الّتي لا تغيب

195
00:16:02,970 --> 00:16:08,270
!لا تستهن بي

196
00:16:15,590 --> 00:16:17,540
!آلوينغ

197
00:16:37,910 --> 00:16:40,840
إكسا مِزاجيّة حقّاً

198
00:16:41,640 --> 00:16:44,780
رغم أنّها تدعني أطلِق عنانها للمرّة
،الأولى منذ مدّة طويلة

199
00:16:44,780 --> 00:16:47,350
إلّا أنّ حدودها هجمة واحدة فقط

200
00:16:49,150 --> 00:16:51,330
لكنّه مُبهر

201
00:16:51,330 --> 00:16:54,290
أقصد درعكِ هذا، عتاد ماغينو الأحدث

202
00:16:54,590 --> 00:16:58,230
ولو أنّ هجمتي لم تكن بنفس قوّتها
،عندما هزمتُ سيّد الشّياطين

203
00:16:58,740 --> 00:17:02,200
إلّا أنّني متفاجئ من عدم قدرة
ضربة إكسا على قتلكِ

204
00:17:04,260 --> 00:17:06,460
لماذا خسرتُ؟

205
00:17:08,020 --> 00:17:11,040
،أعتقد من الأفضل أن تسألي عن سبب فوزي أنا

206
00:17:11,590 --> 00:17:14,870
عوضاً عن سبب خسارتكِ

207
00:17:15,490 --> 00:17:17,170
...كلاهما نفس الشّيء

208
00:17:17,560 --> 00:17:20,500
لماذا تمكّنتَ من الفوز؟

209
00:17:20,500 --> 00:17:22,490
سنوات خبرتي على الأغلب

210
00:17:22,950 --> 00:17:25,220
يا له من سبب غير منطقيّ

211
00:17:25,510 --> 00:17:28,860
لا، لا، لا يمكنكِ تجاهل ذلك صدّقيني

212
00:17:29,310 --> 00:17:32,690
لا سيّما عندما أمتلك خبرة خمسمئة عام

213
00:17:34,110 --> 00:17:37,590
أظنّني تمكّنتُ من القيام بعمل
بطوليّ بعد كلّ هذا الوقت

214
00:17:40,070 --> 00:17:44,090
ظننتُك ستتوجّه إلى ماركوس-ساما؟

215
00:17:44,470 --> 00:17:46,940
سيكون بخير من دون انضمامي له

216
00:17:46,940 --> 00:17:49,370
لا يستطيع سيّد شياطينك الفوز

217
00:17:50,930 --> 00:17:53,010
ماركوس-ساما قويّ

218
00:17:53,010 --> 00:17:55,130
أقوى منّي حتّى

219
00:17:55,130 --> 00:17:58,190
لا، قبل ذلك، أيّ شخص بلا فاميليا

220
00:17:58,190 --> 00:18:00,220
لا يمكنه أن يحلم حتّى بالوقوف في وجهه

221
00:18:01,000 --> 00:18:04,260
لم يتمكّن سيّد شياطينك أصلاً
من هزيمتي في مواجهة مباشرة

222
00:18:06,910 --> 00:18:09,050
ما المضحك في الأمر؟

223
00:18:09,050 --> 00:18:14,230
ظننتُكِ امرأة ذكيّة، لكنّك تتفوّهين
ببعض الكلام السّخيف

224
00:18:14,790 --> 00:18:19,970
هل ظننتِ بأنّ ذلك الرّجل ذهب
ليتحدّاه من دون خطّة؟

225
00:18:20,420 --> 00:18:22,860
إن كان كذلك، فأنتِ تستهينين به بشدّة

226
00:18:22,860 --> 00:18:25,800
!المسألة ليست كذلك! لهذا ما زلتُ هنا

227
00:18:25,800 --> 00:18:27,350
صحيح

228
00:18:27,830 --> 00:18:31,130
أنا الوحيد الّذي يعلم بورقته الرّابحة

229
00:18:31,730 --> 00:18:35,210
ورقة رابحة؟ ماذا تقصد بذلك؟

230
00:18:35,210 --> 00:18:38,080
أنا واثق بأنّه حتّى ماركوس لا يعلم

231
00:18:38,720 --> 00:18:42,310
أيّ شخص يشاهد ذلك سيغرق
في بحر من اليأس

232
00:18:42,840 --> 00:18:44,770
ذلك الرّجل لقويّ

233
00:18:44,770 --> 00:18:48,060
أضمن لكِ ذلك كرجل هزمَكِ

234
00:18:50,010 --> 00:18:51,060
...إذاً

235
00:18:52,460 --> 00:18:54,020
ألن تقتلني؟

236
00:18:54,350 --> 00:18:55,530
أقتلكِ؟

237
00:18:55,530 --> 00:18:56,860
أجل، أنا

238
00:19:00,880 --> 00:19:04,320
لا أملك أيّ سبب حقيقيّ لأقتلكِ

239
00:19:05,280 --> 00:19:09,170
،لم تعودي تمتلكين القوّة لمقاتلتي

240
00:19:09,170 --> 00:19:10,840
لذا لا أحتاج لقتلكِ أيضاً

241
00:19:11,440 --> 00:19:15,010
قاتلتِني ونجوتِ بفضل مهارتكِ

242
00:19:15,370 --> 00:19:21,760
دوري هو منع أمثالكِ من الاقتراب
من فيلتول والتدخّل

243
00:19:22,510 --> 00:19:25,180
سيتولّى الباقي بنفسه

244
00:19:26,020 --> 00:19:27,470
حقّاً؟

245
00:19:31,560 --> 00:19:33,030
!الملاذ

246
00:19:55,280 --> 00:19:59,540
يبدو أنّ تلك الهجمة كانت ستُصيب كِلينا

247
00:20:00,200 --> 00:20:01,840
،حسناً

248
00:20:02,210 --> 00:20:04,290
أعتقد حان الوقت للقيام بعمل آخر كبطل

249
00:20:06,860 --> 00:20:08,840
وإعانة النّاس

250
00:21:42,870 --> 00:21:44,350
،حسناً إذاً

251
00:21:44,350 --> 00:21:46,440
لنكتفِ بهذا القدر من محادثتنا الطّويلة

252
00:21:46,920 --> 00:21:49,480
،أريد فقط أن أرميكِ في الفرن الخالد

253
00:21:49,480 --> 00:21:52,530
ثمّ سيبدأ تلقائيّاً بحرق روحكِ

254
00:21:52,530 --> 00:21:54,890
لتغذية هذه المدينة

255
00:21:56,050 --> 00:22:03,150
ربّما ستشتعل روحكِ ببريق أكبر
من الباقي بما أنّكِ إغنيا

256
00:22:04,250 --> 00:22:06,520
،قريباً سيزول كافّة الخالدين

257
00:22:06,520 --> 00:22:11,050
!وسوف أصبح سيّد الشّياطين الحقيقيّ لهذا العالم

258
00:22:12,200 --> 00:22:15,360
حانت لحظة الوداع

259
00:22:23,570 --> 00:22:25,180
...فيلتول-ساما

260
00:22:26,980 --> 00:22:31,400
الأودون وحده لن يوفّر غذاء مُتّزناً، لذا
من فضلك اطبخ لنفسك من بين الحين والآخر

261
00:22:31,890 --> 00:22:34,240
احرص على غسل الملابس بانتظام

262
00:22:35,720 --> 00:22:40,400
لا تدعه يتراكم عليك

263
00:22:41,440 --> 00:22:43,470
،بما أنّ عملك لا يتطلّب الكثير من الحركة

264
00:22:43,470 --> 00:22:47,830
فلا تنسَ من فضلك أن تقف وتؤدّي
تمارين التمدُّد في كلّ ساعة

265
00:22:49,160 --> 00:22:50,070
...وأيضاً

266
00:22:50,570 --> 00:22:51,860
ماذا أيضاً؟

267
00:22:55,770 --> 00:22:57,570
أحببتُك

268
00:23:20,110 --> 00:23:24,270
لديك عادة مؤسفة وهي الاستسلام سريعاً

269
00:23:25,630 --> 00:23:28,200
آسف لتأخُّري

270
00:23:31,190 --> 00:23:33,750
أتيتُ لإنقاذكِ يا ماكينا

271
00:23:36,270 --> 00:23:38,120
"انبعاث سيّد الشّياطين"