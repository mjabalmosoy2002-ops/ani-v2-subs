1
00:00:04,890 --> 00:00:06,900
!أيّتها الشّيطانة الحقيرة

2
00:00:07,650 --> 00:00:10,030
!أنتِ سبب نزول الكارثة علينا

3
00:00:10,030 --> 00:00:11,100
!عاقّة

4
00:00:11,370 --> 00:00:12,590
!أسقطوها

5
00:00:12,590 --> 00:00:14,900
!أسقطوا هذه الخالِدة بسرعة

6
00:00:23,290 --> 00:00:24,630
!أسقطها

7
00:00:24,630 --> 00:00:25,570
!حسناً

8
00:00:51,890 --> 00:00:52,690
!ما-ماذا؟

9
00:00:52,690 --> 00:00:53,860
!إنّها كارثة

10
00:00:53,260 --> 00:00:56,360
...أتيتُ لأنّني سمعتُ إشاعات عن خالِدة، لكن

11
00:00:56,800 --> 00:00:58,320
هكذا إذاً

12
00:00:58,320 --> 00:00:59,820
أنتِ جميلة

13
00:01:00,250 --> 00:01:04,850
روحكِ تسطع بريقاً وتتّقد كما الشّمس

14
00:01:04,850 --> 00:01:07,100
سيكون من الخسارة أن تفني هنا

15
00:01:08,160 --> 00:01:09,720
تعالي يا امرأة

16
00:01:09,720 --> 00:01:14,070
كرّسي جسدكِ وروحكِ لي

17
00:01:30,290 --> 00:01:31,680
إطفاء المُنبّه

18
00:01:55,180 --> 00:01:56,380
إيليكليت

19
00:01:59,070 --> 00:02:01,930
صباح الخير يا ماكينا-ساما

20
00:02:01,930 --> 00:02:07,450
إنّنا حاليّاً في اليوم 13 من شهر
التنّين، حقبة الاندماج 2099

21
00:02:07,450 --> 00:02:09,760
السّاعة حاليّاً هي 6:03 صباحاً

22
00:02:09,760 --> 00:02:13,770
درجة الحرارة المُتوسِّطة ضمن منطِقة
تحمُّل التّبريد هي -2

23
00:02:14,140 --> 00:02:15,940
الجوّ دافئ اليوم

24
00:02:15,940 --> 00:02:17,570
كيف حالكِ يا إيليك؟

25
00:02:17,880 --> 00:02:21,190
الفاميليا خاصّتكِ تعمل حاليّاً بالوضع الطّبيعيّ

26
00:02:21,190 --> 00:02:24,390
المخزن السّحري ومزايا المُعالجة الكمّية

27
00:02:24,390 --> 00:02:27,290
كلّها تعمل بصورة مثاليّة

28
00:02:28,210 --> 00:02:30,290
...لم يكن هذا ما قصدت

29
00:02:30,850 --> 00:02:32,000
لكن انسي الأمر

30
00:02:35,130 --> 00:02:36,430
فيلتول-ساما

31
00:02:39,510 --> 00:02:41,810
انتهيتُ من تحضير الفطور

32
00:02:45,700 --> 00:02:48,980
ماذا؟ لم أرَ شيئاً كهذا من قبل

33
00:02:48,980 --> 00:02:50,930
لكن رائحته زكيّة

34
00:02:51,400 --> 00:02:54,180
يُحفّز حتّى شهيّة خالد

35
00:02:54,650 --> 00:02:56,900
آمل أن يُعجبك

36
00:02:57,350 --> 00:02:59,420
حسناً، لنُجرّبه

37
00:03:23,480 --> 00:03:24,590
إنّه لذيذ

38
00:05:10,560 --> 00:05:14,280
أعلم بأنّ هناك آخرين نجوا من صيد
الخالدين مثلما نجوتُ أنا

39
00:05:14,280 --> 00:05:17,940
،لكن مؤخّراً، كان الخالدون يختفون

40
00:05:17,940 --> 00:05:22,020
وفقدتُ الاتِّصال مع أعواني المُقرّبين
أورنارد وبالمولك كذلك

41
00:05:22,500 --> 00:05:24,950
آمل أن يكونا قد اختبآ في مكانٍ ما فحسب

42
00:05:25,870 --> 00:05:28,790
هل ما زالت عمليّات صيد الخالدين
هذه مُستمرّة؟

43
00:05:28,790 --> 00:05:32,910
لا، عمليّات صيد الخالدين قد توقّفت
منذ عقود عديدة

44
00:05:33,310 --> 00:05:36,390
والتّحامُل الّذي شعر به النّاس
آنذاك قد انحسر كذلك

45
00:05:36,950 --> 00:05:40,990
،تمّ تحريضهم من الأساس لتأمين مركز ماركوس

46
00:05:40,990 --> 00:05:43,810
ولا يملك سبباً لإحيائهم

47
00:05:44,660 --> 00:05:48,140
،رحتُ إلى غرف أعواني بعدما فقدتُ الاتّصال

48
00:05:48,140 --> 00:05:50,020
،وبدا وكأنّ معركة كانت قد اندلعت في الدّاخل

49
00:05:50,560 --> 00:05:53,960
لكن الكلام المكتوب بعُجالة والّذي تركوه
خلفهم لم يكن إلّا عِبارة واحدة

50
00:05:57,920 --> 00:05:59,240
فرن خالد"؟"

51
00:05:59,240 --> 00:06:02,040
آمل أن يكونا بخير فحسب

52
00:06:03,460 --> 00:06:04,730
!فيلتول-ساما؟

53
00:06:05,400 --> 00:06:06,920
أنا بخير

54
00:06:06,920 --> 00:06:09,790
يبدو أنّ بعض آثار جرح الأمس
ما زالت بادية عليّ

55
00:06:10,160 --> 00:06:12,430
أكثر من مجرّد أن تكون قدراتي
التّجديديّة قد انحسرت

56
00:06:13,440 --> 00:06:15,420
إيل ستونا الّتي حرّرتُها

57
00:06:15,420 --> 00:06:20,820
كانت لتُبدِّد تلك الغيوم بالكامل
لو كنتُ بكامل قوّتي

58
00:06:21,420 --> 00:06:25,600
تدهورَ كلُّ شيء بشكل كبير مُقارنة
بما قبل انبعاثي

59
00:06:26,330 --> 00:06:30,120
فيلتول-ساما، هذا لأنّ الإيمان الّذي كان
يعمل كمصدر قوّة لك

60
00:06:30,120 --> 00:06:32,990
قد انحسر بشكل هائل في هذا العصر الحديث

61
00:06:33,690 --> 00:06:36,690
من دون وجود آخرين للاعتراف بي
،وتوجيه مشاعرهم نحوي

62
00:06:36,690 --> 00:06:39,330
فإنَّ قوّة الإيمان خاصّتي قد فُقِدت

63
00:06:39,900 --> 00:06:43,550
أفترض أنّ هذا يعني بأنّني أصبحتُ منسيّاً

64
00:06:43,810 --> 00:06:47,730
في الوقت الحاضر، صرتَ مجرّد
جزء من التّاريخ

65
00:06:48,660 --> 00:06:50,220
لا شيء يدعو للقلق

66
00:06:51,860 --> 00:06:52,780
لي ديوا

67
00:06:55,930 --> 00:06:58,180
حياتي أبديّة

68
00:06:58,670 --> 00:07:02,340
كلّ ما عليّ هو استرجاع إيماني ببساطة

69
00:07:03,010 --> 00:07:06,150
والجلوس هنا سيكون مُملّاً

70
00:07:06,150 --> 00:07:08,250
سوف أجري مسحاً للمنطقة المُحيطة

71
00:07:08,820 --> 00:07:10,810
هل أنت بخير بما يكفي لفعل ذلك؟

72
00:07:10,810 --> 00:07:13,110
أنا بخير بما يكفي لحياة يوميّة

73
00:07:13,570 --> 00:07:16,970
الجلوس نائماً طوال اليوم سيضرّ
جسدي أكثر

74
00:07:18,150 --> 00:07:20,790
...المعذرة، في هذه الحالة

75
00:07:20,790 --> 00:07:22,580
ما الأمر؟

76
00:07:23,620 --> 00:07:25,430
هل ترغب في الذّهاب للتسوُّق؟

77
00:07:27,410 --> 00:07:31,040
يجدر بنا أن نبدأ بتأمين اللّباس لك
يا فيلتول-ساما

78
00:07:40,430 --> 00:07:41,960
ما هذا؟

79
00:07:42,640 --> 00:07:44,940
قِف هناك من فضلك

80
00:07:44,940 --> 00:07:47,060
ستجري فحصاً ثلاثي الأبعاد

81
00:07:47,500 --> 00:07:49,230
فحص ثلاثي الأبعاد؟

82
00:07:51,650 --> 00:07:52,990
أعي تماماً

83
00:07:52,990 --> 00:07:57,560
بأنّه سيكون واجبي كتابِعة لك تحضير

84
00:07:57,560 --> 00:08:01,620
ملابس أعلى جودة بكثير ممّا يُوفّره
...هذا المتجر، لكن

85
00:08:01,620 --> 00:08:03,220
لا يهمّ

86
00:08:03,220 --> 00:08:05,950
،عندما يمتلك شخصٌ جمالاً حقيقيّاً مثلي

87
00:08:05,950 --> 00:08:09,670
فحتّى الملابس الرّخيصة عاجزة
عن تلويث أناقتي

88
00:08:10,070 --> 00:08:15,870
وسأكون مرتاحاً تماماً حتّى بالكشف
!عن جسدي الطّبيعيّ أمام العوام

89
00:08:16,170 --> 00:08:18,590
!لا، من فضلك ارتدِ شيئاً

90
00:08:19,160 --> 00:08:23,970
النّاس العاديّون غير قيّمين بما يكفي
!ليروا جسدك الملكيّ

91
00:08:23,970 --> 00:08:25,300
حقّاً؟

92
00:08:25,520 --> 00:08:27,110
أجل، حقّاً

93
00:08:29,680 --> 00:08:32,200
هل لديك أي تفضيلات بالنّسبة للملابس؟

94
00:08:32,200 --> 00:08:33,810
سأدع الأمر لكِ

95
00:08:34,590 --> 00:08:35,730
أمرك

96
00:08:37,250 --> 00:08:43,460
إيليك، من فضلكِ اختاري أفضل خيار
من حيث الكلفة والعمليّة والتكيّفيّة

97
00:08:44,450 --> 00:08:46,340
!عُلِم

98
00:08:46,340 --> 00:08:50,010
هذه هي الملابس الّتي تُطابق شروطك

99
00:08:50,310 --> 00:08:51,170
ماذا؟

100
00:08:51,170 --> 00:08:53,130
!ماذا؟ بدلة رياضيّة؟

101
00:08:53,130 --> 00:08:55,690
...لا، ليس بدلة رياضيّة

102
00:08:55,690 --> 00:08:56,560
إنّها لائقة

103
00:08:56,560 --> 00:08:57,190
ماذا؟

104
00:08:57,570 --> 00:09:00,010
التّصميم بسيط، لكن مُتقَن

105
00:09:00,270 --> 00:09:03,640
هذا هو الشّكل المثاليّ الّذي أبحث عنه

106
00:09:04,020 --> 00:09:05,760
أحسنتِ صنعاً يا ماكينا

107
00:09:07,850 --> 00:09:10,510
!يا له من تصميم مُبهِر

108
00:09:10,510 --> 00:09:12,320
هل هذا شِعار من نوع ما؟

109
00:09:12,320 --> 00:09:17,200
في الواقع، إنّه شكل قديم من الكِتابة كان يُستخدَم
بواسطة الدّولة الّتي ازدهرتْ في هذه البلاد

110
00:09:17,200 --> 00:09:18,160
ماذا؟

111
00:09:18,160 --> 00:09:19,960
ماذا كُتِب إذاً؟

112
00:09:20,780 --> 00:09:22,150
"سيّد شياطين"

113
00:09:24,530 --> 00:09:26,570
لننتقل إلى محطّتنا التّالية

114
00:09:26,570 --> 00:09:27,800
انتظري يا ماكينا

115
00:09:27,800 --> 00:09:29,780
لم تقدّمي لها أي قطع نقديّة بعد

116
00:09:29,780 --> 00:09:33,500
أُجريَتْ عمليّة الدّفع الرّقميّ التّلقائيّ بالفعل

117
00:09:36,620 --> 00:09:37,920
ماكينا

118
00:09:38,310 --> 00:09:39,190
نعم؟

119
00:09:39,530 --> 00:09:41,840
ما شكل فاميليا؟

120
00:09:42,360 --> 00:09:44,320
ماذا تقصد؟

121
00:09:44,640 --> 00:09:46,850
،بغضّ النّظر عن تمرُّد ماركوس

122
00:09:46,850 --> 00:09:50,560
إنَّ فاميليا بحدِّ ذاتها هي أداة ثوريّة

123
00:09:51,110 --> 00:09:53,200
لذا يراودني فضول حيالها

124
00:09:53,200 --> 00:09:57,300
حسناً، يمكنني القول بأنّها مُلائمة ومُريحة

125
00:09:57,730 --> 00:09:59,800
،تُستخدَم للسّحر بشكل خاصّ

126
00:09:59,800 --> 00:10:02,020
لكن يمكن استخدامها أيضاً
لجمع معلومات والتسوُّق

127
00:10:02,020 --> 00:10:05,110
والتّواصل من دون الحاجة لحمل شيء

128
00:10:07,190 --> 00:10:11,670
كان هناك جهازاً نقّالاً يؤدّي
،مُعظم الوظائف نفسها

129
00:10:12,080 --> 00:10:16,700
لكن الحاجة لحمله قيّدَ من فائدته

130
00:10:17,080 --> 00:10:18,520
دعيني ألمسها

131
00:10:20,070 --> 00:10:21,810
!ما-ما-ما-ماذا؟

132
00:10:22,340 --> 00:10:23,360
لا تتحرّكي

133
00:10:23,360 --> 00:10:24,000
!حسناً

134
00:10:25,830 --> 00:10:27,780
...يفعل هذا بلا خجل أمام العامّة

135
00:10:28,190 --> 00:10:31,370
لكن أوامر فيلتول-ساما مُطلَقة

136
00:10:31,370 --> 00:10:33,470
!لا أملك خياراً

137
00:10:33,470 --> 00:10:35,730
!لا أملك سبباً للرّفض أيضاً

138
00:10:36,580 --> 00:10:40,120
تمّ رصد تسارع غير عاديّ في نبضات
القلب وضغط الدّم

139
00:10:40,120 --> 00:10:40,700
—يجب

140
00:10:40,700 --> 00:10:41,740
!اصمتي

141
00:10:42,430 --> 00:10:43,510
انتهيت

142
00:10:43,510 --> 00:10:44,150
ماذا؟

143
00:10:44,150 --> 00:10:45,770
حـ-حسناً

144
00:10:46,770 --> 00:10:49,800
أردت فقط تفقُّد فاميليا، صحيح؟

145
00:10:49,800 --> 00:10:51,190
...صحيح

146
00:10:51,840 --> 00:10:54,870
ألا تُعيقك بإلصاقها في مؤخّرة عنقك؟

147
00:10:55,190 --> 00:10:57,780
،بدت غريبة في البداية

148
00:10:57,780 --> 00:10:58,960
لكن اعتدتُ عليها

149
00:10:58,960 --> 00:11:01,140
اعتدتِ عليها إذاً؟

150
00:11:01,140 --> 00:11:02,360
أجل

151
00:11:02,360 --> 00:11:06,300
من الصّعب عيش الحياة اليوميّة من دون هذه

152
00:11:06,830 --> 00:11:07,970
...لكن

153
00:11:08,430 --> 00:11:13,050
امتلاك واحدة لا يعني بالضّرورة
أن تتحسّن حياتك أيضاً

154
00:11:18,100 --> 00:11:19,510
فيلتول-ساما؟

155
00:11:20,180 --> 00:11:21,670
أنا ذاهب إلى العمل

156
00:11:21,670 --> 00:11:22,160
ماذا؟

157
00:11:23,200 --> 00:11:25,190
قلتُ أنا ذاهب إلى العمل

158
00:11:26,240 --> 00:11:27,320
!يجب ألّا تفعل

159
00:11:27,600 --> 00:11:31,170
!فيلتول-ساما، لا حاجة لتفعل شيئاً كهذا

160
00:11:31,170 --> 00:11:32,160
—لكن يا ماكينا

161
00:11:32,160 --> 00:11:35,020
،قد أكون مضطرّة للعيش هكذا حاليّاً

162
00:11:35,020 --> 00:11:37,350
لكن سأوفّر حياة أفضل لك

163
00:11:37,350 --> 00:11:42,180
المعذرة، من النّاحية العمليّة، سأبحث
،عن مزيد من المُناوبات

164
00:11:42,180 --> 00:11:44,150
—وأعمل في وظيفتين أو ثلاث

165
00:11:43,650 --> 00:11:45,130
ماكينا، اسمعي

166
00:11:46,830 --> 00:11:48,270
تغيّر الزّمن

167
00:11:48,880 --> 00:11:50,710
حتّى أنا لستُ قديراً على كلّ شيء

168
00:11:51,390 --> 00:11:54,190
ربّما حان الوقت كي أتغيّر

169
00:11:54,760 --> 00:11:56,860
لا أستطيع الجلوس دون فعل شيء

170
00:11:56,860 --> 00:12:01,200
بينما تُجهِدين نفسكِ لتوفير الطّعام
واللّباس والملجأ لي

171
00:12:01,680 --> 00:12:04,050
،دون واجبات تُشغلني كملِك

172
00:12:04,050 --> 00:12:06,440
يجب أن أسعى للعمل الآن

173
00:12:10,540 --> 00:12:11,490
ماكينا

174
00:12:13,750 --> 00:12:18,430
!لم أتخلَّ عن فكرة غزو هذا العالم

175
00:12:19,000 --> 00:12:22,080
هل ستكرّسين نفسكِ لي مرّة أخرى؟

176
00:12:24,100 --> 00:12:25,290
أمرك

177
00:12:27,560 --> 00:12:33,060
أنا، ماكينا سوليج، ستخدم سموّك
ما دمتُ على قيد الحياة

178
00:12:34,590 --> 00:12:36,630
أقسم بروحي

179
00:12:41,170 --> 00:12:42,670
...ماكينا تلك

180
00:12:43,310 --> 00:12:45,890
لم يكن عليها القلق إلى هذا الحدّ

181
00:12:46,450 --> 00:12:49,170
!سأرافقك إن كنت ستبحث عن عمل

182
00:12:49,460 --> 00:12:52,540
قلتِ لي بأنّ لديكِ عمل عقب هذا

183
00:12:52,540 --> 00:12:53,490
!سألغيه

184
00:12:53,490 --> 00:12:54,120
!لن تفعلي

185
00:12:54,310 --> 00:12:56,090
حسناً، اسمعي يا ماكينا

186
00:12:56,090 --> 00:12:57,370
أصغي جيّداً

187
00:12:57,370 --> 00:12:59,360
،في حين أنّني أرى الفكرة مستحيلة

188
00:12:59,360 --> 00:13:03,710
لنفترض بأنّني عجزتُ عن إيجاد عمل
بسبب سلسلة من الحوادث المؤسفة

189
00:13:03,710 --> 00:13:05,080
،إذا حدث ذلك

190
00:13:05,080 --> 00:13:07,700
!فسوف أعتمد على دخلك حينئذ

191
00:13:09,550 --> 00:13:11,570
!تعتمد عليّ؟

192
00:13:11,570 --> 00:13:12,370
أجل

193
00:13:12,370 --> 00:13:14,800
إيراداتكِ مطلوبة يا ماكينا

194
00:13:14,800 --> 00:13:16,520
!يا له من حثالة

195
00:13:16,520 --> 00:13:17,760
عسى أن يموت

196
00:13:18,460 --> 00:13:20,200
فهمت

197
00:13:20,200 --> 00:13:21,910
إذاً خذ هذه على الأقلّ

198
00:13:22,500 --> 00:13:25,230
إنّها مشحونة بقليل من المال سلفاً

199
00:13:25,230 --> 00:13:28,000
إذا جعت، استخدمها للدّفع

200
00:13:28,000 --> 00:13:32,040
،وأيضاً، إذا واجهتك أي مشكلة
فاتّصل بي بواسطة هذه من فضلك

201
00:13:32,040 --> 00:13:34,720
تحتوي على مُتعقِّب، لذا سأسارع
إليك على الفور

202
00:13:34,720 --> 00:13:37,130
،وأيضاً، أيضاً، إذا تكلّم معك أيّ شخص مشبوه

203
00:13:37,130 --> 00:13:39,420
اضغط هذا بضع مرّات ليصدر صوت مُنبِّه

204
00:13:40,750 --> 00:13:42,880
لستُ طفلاً

205
00:13:43,610 --> 00:13:46,330
،لكن في حين أنّني قلتُ بأنّني سأعمل

206
00:13:46,330 --> 00:13:51,200
لا أملك فكرة عن الأعمال المُتاحة
أو كيف أحصل على عمل

207
00:13:51,780 --> 00:13:53,660
ربّما يجدر بي أن أسأل ماكينا

208
00:13:54,080 --> 00:13:56,320
لا، لا حاجة لذلك

209
00:13:56,320 --> 00:13:57,340
!مرحباً

210
00:13:57,690 --> 00:14:00,120
تفضّل الأودون

211
00:14:03,250 --> 00:14:06,310
مضى وقت طويل جدّاً منذ شعرتُ بالجوع

212
00:14:06,650 --> 00:14:09,780
لا بدّ أنّ الانحسار في الإيمان بي شديد

213
00:14:12,950 --> 00:14:14,570
ماذا يجدر بي أن أفعل؟

214
00:14:14,570 --> 00:14:16,350
نعم، ما الأمر؟

215
00:14:16,350 --> 00:14:17,200
ماذا؟

216
00:14:17,200 --> 00:14:18,780
ليس كذلك

217
00:14:18,780 --> 00:14:21,110
تركتُ باني بونز مسؤولاً عن ذلك

218
00:14:21,530 --> 00:14:24,120
يا سيّد، هلّا تبرّعت ببعض المال؟

219
00:14:21,990 --> 00:14:24,120
أجل. أجل. أعتمد عليك

220
00:14:24,120 --> 00:14:25,720
انتبه على نفسك، مفهوم؟

221
00:14:24,120 --> 00:14:26,340
ولا مانع أن يكون طعاماً أيضاً

222
00:14:28,180 --> 00:14:30,770
لا يجوز أن يكون النّاس نيّقين

223
00:14:36,630 --> 00:14:38,710
!هل لدى أحدكم عمل لي؟

224
00:14:39,180 --> 00:14:40,860
!لا أملك مالاً

225
00:14:41,170 --> 00:14:43,930
!لذا أبحث عن عمل حالاً

226
00:14:44,200 --> 00:14:46,570
،لا أضمن قدراتي

227
00:14:46,570 --> 00:14:47,640
!لكنّني مستعدّ لفعل أيّ شيء

228
00:14:47,850 --> 00:14:49,850
!من فضلكم امنحوني عملاً

229
00:14:48,320 --> 00:14:51,800
!أنت، أنت، أنت! ماذا تعتقد بأنّك تفعل؟

230
00:14:52,320 --> 00:14:53,910
أبحث عن عمل

231
00:14:53,910 --> 00:14:56,510
اذهب إلى النّقابة التّجاريّة إذاً

232
00:14:56,510 --> 00:14:58,490
لديك هويّة مواطن، صحيح؟

233
00:14:58,800 --> 00:15:00,750
هويّة مواطن؟

234
00:15:01,210 --> 00:15:03,290
مُهاجر غير شرعيّ؟

235
00:15:03,290 --> 00:15:07,370
هذه أرضنا، لذا لا يمكنك فعل هذا هنا

236
00:15:07,370 --> 00:15:09,180
سبّبتُ إساءة لكم إذاً

237
00:15:09,180 --> 00:15:10,160
آسف على التدخُّل

238
00:15:10,160 --> 00:15:11,340
انتظر يا رجل

239
00:15:11,660 --> 00:15:12,480
خُذ

240
00:15:13,560 --> 00:15:14,680
ما هذه؟

241
00:15:14,680 --> 00:15:16,290
إنّها سيرة ذاتيّة

242
00:15:16,290 --> 00:15:19,880
دوِّن تاريخك في العمل عليها وخذها
معك إلى النّقابة التّجاريّة

243
00:15:20,510 --> 00:15:23,150
،لا أضمن حصولك على عمل من خلالها

244
00:15:23,150 --> 00:15:26,100
لكن امتلاكها خير من لا شيء

245
00:15:26,360 --> 00:15:31,190
صحيح، تقع النّقابة التّجاريّة في الطّابق الرّابع
من ذاك البناء الّذي عليه لافتة كانياسو

246
00:15:31,450 --> 00:15:35,400
وأيضاً ابتعد عن أي شركة تحت
...مسمّى آي.أتش.أم.آي

247
00:15:35,400 --> 00:15:37,820
لا سيّما تلك المُتعلِّقة بالإنشاءات

248
00:15:37,820 --> 00:15:38,690
لماذا؟

249
00:15:39,110 --> 00:15:41,200
لأنّني لم أسمع عنهم خيراً قطّ

250
00:15:41,650 --> 00:15:43,680
اعتبرها وساوس عجوز

251
00:15:43,680 --> 00:15:45,330
أشكرك على التّحذير

252
00:15:47,150 --> 00:15:49,470
...المعذرة يا سيّد فيلتول

253
00:15:49,470 --> 00:15:52,960
ماذا؟ اسألني ما تشاء. أسمح بذلك

254
00:15:53,200 --> 00:15:56,800
المعذرة، أدرجتَ بأنّ "ديل ستيلا" هي
إحدى مهاراتك الفريدة

255
00:15:56,800 --> 00:15:58,770
أجل. ديل ستيلا

256
00:15:58,770 --> 00:16:00,680
ماذا يعني "ديل ستيلا" بالضّبط؟

257
00:16:00,680 --> 00:16:01,450
تعويذة

258
00:16:01,800 --> 00:16:06,650
إنّها قادرة عى إبادة قوّات العدو
على نِطاق واسع فوراً

259
00:16:08,680 --> 00:16:10,030
هكذا إذاً

260
00:16:10,400 --> 00:16:14,350
أدرجتَ أيضاً تكتيكات عسكريّة وقيادة استراتيجيّة

261
00:16:14,660 --> 00:16:15,740
!أجل

262
00:16:15,740 --> 00:16:18,480
أنا بارع في قيادة جيوش ضخمة

263
00:16:18,480 --> 00:16:20,990
أعتزّ بعدم قدرة أحد على مُجاراة مهارتي

264
00:16:20,990 --> 00:16:23,380
عندما يتعلّق الأمر بتحقيق أهداف استراتيجيّة

265
00:16:23,770 --> 00:16:29,280
معركة أوربيل في عام 723
من الحقبة القارّية

266
00:16:29,280 --> 00:16:32,130
ليست إلّا مثال صغير على إنجازاتي
المجيدة المُتعدّدة

267
00:16:32,130 --> 00:16:34,180
أورب... ماذا؟

268
00:16:34,180 --> 00:16:36,960
معركة أوربيل. هل سمعتَ عنها؟

269
00:16:36,960 --> 00:16:39,470
أعتذر على قلّة ثقافتي

270
00:16:40,230 --> 00:16:42,480
،إذاً تحت إنجازاتك

271
00:16:42,480 --> 00:16:45,620
"أدرجت "بناء ديماس حَرَم فونهايغ المُقدّس

272
00:16:45,620 --> 00:16:46,380
أجل

273
00:16:46,380 --> 00:16:50,310
ذلك الدّيماس هو أحد أعظم شيئين بنيتُهما

274
00:16:50,610 --> 00:16:54,310
وتحت تاريخك المهنيّ، أدرجتَ
إدارة مملكة؟

275
00:16:54,310 --> 00:16:55,260
أجل

276
00:16:55,260 --> 00:16:58,730
كنتُ حاكم دولة لقرابة ألف عام

277
00:16:58,730 --> 00:17:00,990
خضنا العديد من الحروب بسبب
،الاضطراب السّياسيّ

278
00:17:00,990 --> 00:17:05,240
لكن تلقّيتُ تقاريرَ عن أنّ رعاياي أنجزوا
واجباتهم وكانوا سُعداء

279
00:17:05,480 --> 00:17:06,330
...حسناً

280
00:17:06,780 --> 00:17:09,750
آخر منصِب مُدرَج لك كان
قبل أكثر من 500 عام

281
00:17:09,750 --> 00:17:11,270
هل كان هذا خطأ في الإدخال؟

282
00:17:11,270 --> 00:17:14,170
لا، كان قبل 500 عام دون شكّ

283
00:17:14,170 --> 00:17:17,140
لكن من وجهة نظري، لم يمضِ
،حتّى يوم واحد

284
00:17:17,140 --> 00:17:19,460
لذا لا حاجة للقلق

285
00:17:19,860 --> 00:17:22,930
فهمت. هذه هي كلّ أسئلتي

286
00:17:22,930 --> 00:17:23,690
جيّد

287
00:17:24,680 --> 00:17:26,220
...سيّد فيلتول

288
00:17:26,220 --> 00:17:26,980
ماذا؟

289
00:17:27,710 --> 00:17:31,910
يؤسفني إبلاغك بهذا، لكن ليس
لدينا عمل نوفّره لك

290
00:17:33,760 --> 00:17:34,970
لِمَ لا؟

291
00:17:34,970 --> 00:17:40,120
هذا هو القرار الّذي توصّلنا إليه بعد دراسة
حريصة لسيرتك وبعد هذه المُقابلة

292
00:17:40,120 --> 00:17:45,410
بالإضافة إلى ذلك، شركتنا لا تُوفّر عملاً
لأيّ شخص لم يزرع فاميليا

293
00:17:46,030 --> 00:17:47,680
تفضّل بالانصراف

294
00:17:48,710 --> 00:17:50,550
...ماكينا

295
00:17:50,790 --> 00:17:52,560
ما الأمر؟

296
00:17:52,880 --> 00:17:54,720
...من النّاحية النّظريّة

297
00:17:54,720 --> 00:17:59,480
لا. أنا متأكّد بأنّه من غير الممكن حتّى
،أن يكون هذا صحيحاً

298
00:17:59,480 --> 00:18:01,500
لكن هلّا تحقّقتِ من شيء لأجلي؟

299
00:18:02,170 --> 00:18:05,620
هل أنا عاجز تماماً عن فعل
شيء في هذا العصر؟

300
00:18:05,620 --> 00:18:07,960
بدأتُ أفقد الثّقة تماماً

301
00:18:07,960 --> 00:18:10,670
من فضلك لا تحزن

302
00:18:10,670 --> 00:18:12,860
أولئك الفانون الحمقى التّافهون

303
00:18:12,860 --> 00:18:16,230
عاجزون ببساطة عن استيعاب
عظمتك يا فيلتول-ساما

304
00:18:16,850 --> 00:18:20,010
أنت شخص يعلو فوق الجميع

305
00:18:20,010 --> 00:18:22,850
ينبغي ألّا تبرح مكانك وتنتظر فحسب

306
00:18:23,510 --> 00:18:25,460
لا أستطيع فعل ذلك

307
00:18:25,820 --> 00:18:30,540
ماكينا، هل تعرفين شخصاً في هذا
العالم بوسعه تقديم نصيحة؟

308
00:18:30,980 --> 00:18:33,550
أفترض يمكنك القول بأنّه يوجد شخص

309
00:18:33,550 --> 00:18:36,660
ماذا؟ لديكِ صديق في العصر الحاليّ؟

310
00:18:36,660 --> 00:18:37,710
يُطمئنني سماع ذلك

311
00:18:37,710 --> 00:18:39,670
أعتقد يمكنك اعتبارها صديقة

312
00:18:39,670 --> 00:18:46,190
نذهب للتسوّق والأكل واللّهو والنّوم
في منازل بعضنا عند المُناسبات

313
00:18:46,910 --> 00:18:48,880
ماذا تكون إن لم تكُن صديقة؟

314
00:18:49,150 --> 00:18:50,890
هذا موضوع جدليّ

315
00:18:51,560 --> 00:18:53,990
طلبتُ منها مقابلتنا في مقهى قريب

316
00:18:53,990 --> 00:18:55,810
قالت بأنّها في طريقها الآن

317
00:18:56,470 --> 00:19:01,320
!مرحباً، مرحباً! آسفة لتأخّري

318
00:19:02,610 --> 00:19:04,110
أنت ذلك الرّجل

319
00:19:04,490 --> 00:19:05,640
التقينا من جديد

320
00:19:05,900 --> 00:19:07,600
تعرفان بعضكما الآخر؟

321
00:19:07,600 --> 00:19:08,250
أجل

322
00:19:08,250 --> 00:19:10,270
كان يحاول مُغازلتي

323
00:19:10,270 --> 00:19:13,240
يا لي من امرأة آثمة

324
00:19:13,240 --> 00:19:16,000
أجل، أجل، تستحقّين هذا

325
00:19:16,000 --> 00:19:18,090
بئساً، أنتِ مُملّة

326
00:19:18,090 --> 00:19:20,890
بوسعكِ مُسايرتي قليلاً على الأقلّ

327
00:19:20,890 --> 00:19:23,220
لن ينتهي الأمر إذا بدأتُ بفعل ذلك

328
00:19:23,640 --> 00:19:25,600
اسمي تاكاهاشي

329
00:19:25,600 --> 00:19:26,610
سررتُ بلقائك

330
00:19:26,860 --> 00:19:28,100
فيلتول

331
00:19:28,100 --> 00:19:30,510
إذاً كنتَ جادّاً بشأن مسألة سيّد الشّياطين؟

332
00:19:30,510 --> 00:19:33,530
لطالما أسهبتْ ماكينا بسعادة
حول هذا الأمر

333
00:19:33,530 --> 00:19:36,600
"!فيلتول-ساما سيُبعَث قريباً"

334
00:19:36,600 --> 00:19:39,390
لكن لم أتوقّع أن يكون ذلك صحيحاً

335
00:19:39,390 --> 00:19:41,770
!تاكاهاشي! أنتِ قليلة الاحترام

336
00:19:41,770 --> 00:19:42,800
لا، لا مشكلة

337
00:19:42,800 --> 00:19:45,650
الآن، أنا من يطلب المساعدة من تاكاهاشي

338
00:19:45,970 --> 00:19:47,280
سررتُ بلقائكِ

339
00:19:47,280 --> 00:19:52,390
حسناً، أنت صديق صديقة، لذا
!أعتبرك صديقاً الآن أيضاً

340
00:19:52,390 --> 00:19:53,540
سررتُ بلقائك يا فيلي

341
00:19:53,830 --> 00:19:57,060
!تاكاهاشي

342
00:19:57,430 --> 00:19:59,710
كيف أصبحتُما صديقتين؟

343
00:20:06,080 --> 00:20:07,020
دوجين؟

344
00:20:07,020 --> 00:20:07,960
آسفة، اِنسَ الأمر

345
00:20:08,470 --> 00:20:13,680
في الواقع، التقينا في غرفة دردشة
تجسيديّة للخيال الإبداعيّ

346
00:20:13,680 --> 00:20:15,250
—من هناك

347
00:20:15,250 --> 00:20:16,170
المعذرة

348
00:20:16,910 --> 00:20:18,100
!مهلاً يا فيلي

349
00:20:18,100 --> 00:20:19,370
!ماذا تفعل؟

350
00:20:19,370 --> 00:20:20,910
!مهلاً يا ماكينا؟! ما الّذي يجري هنا؟

351
00:20:20,910 --> 00:20:23,080
!فعل ذلك لي أوّلاً

352
00:20:23,080 --> 00:20:24,280
!ليس هذا ما أقصده يا حمقاء

353
00:20:24,280 --> 00:20:25,140
!حمقاء

354
00:20:25,140 --> 00:20:26,880
!ضعي تلك الأفكار جانباً الآن

355
00:20:28,120 --> 00:20:29,820
آسف لأنّني أفزعتُكِ

356
00:20:30,150 --> 00:20:33,070
لاحظتُ بأنّ الفاميليا خاصّتكِ مختلفة
عن الفاميليا الخاصّة بماكينا

357
00:20:33,070 --> 00:20:36,240
لذا كنتُ أبحث في كيفيّة صناعتها وآليّة عملها

358
00:20:36,240 --> 00:20:38,250
يمكنك فعل ذلك؟

359
00:20:38,250 --> 00:20:41,890
استخدم فيلتول-ساما قدرة عيون الحاكم خاصّته

360
00:20:41,890 --> 00:20:44,030
تسمح له باستخدام تدفُّق المانا

361
00:20:44,030 --> 00:20:46,780
لفهم تركيبة أي شيء يلمسه

362
00:20:46,780 --> 00:20:50,480
إذاً هكذا تمكّنتَ من اكتشاف
اختراقي البرمجيّ قبل أيّام

363
00:20:50,480 --> 00:20:54,360
لديّ فكرة عامّة حول ما يجري داخل الفاميليا

364
00:20:54,360 --> 00:20:57,220
رغم أنّه لا يزال هناك الكثير ممّا
لا أستطيع تحليله بشكل كامل

365
00:20:57,610 --> 00:21:00,100
فيلتول-ساما، ينبغي أن نتطرّق
إلى موضوعنا الأساسيّ

366
00:21:00,100 --> 00:21:00,840
أجل

367
00:21:01,330 --> 00:21:05,710
تاكاهاشي، كان فيلتول-ساما يأمل
أن تعرّفيه على عمل ما

368
00:21:06,090 --> 00:21:08,020
لِمَ لا تذهب إلى النّقابة التّجاريّة؟

369
00:21:08,020 --> 00:21:12,470
فعلتُ ذلك قبلاً، لكن رفضوني
لعدم امتلاكي فاميليا

370
00:21:12,700 --> 00:21:14,920
!أليس لديك فاميليا يا فيلي؟

371
00:21:14,920 --> 00:21:17,300
لأسباب عديدة، لا أستطيع زرع واحدة

372
00:21:17,300 --> 00:21:19,180
هذا فظيع

373
00:21:19,590 --> 00:21:21,010
أرغب في الحصول على مشورتكِ

374
00:21:21,300 --> 00:21:23,140
أي شيء تريده خارج إطار العمل؟

375
00:21:23,390 --> 00:21:24,470
،إن أمكن

376
00:21:24,470 --> 00:21:27,900
أفضّل فعل شيء يجعل وجودي
معروفاً في كلّ أرجاء العالم

377
00:21:28,520 --> 00:21:32,480
عمل يستطيع سيّد شياطين قبل 500
...عام فعله في العصر الحديث

378
00:21:35,250 --> 00:21:37,610
...لكن لا يستطيع استخدام فاميليا

379
00:21:37,610 --> 00:21:40,640
سلوكه المُميّز وطريقة كلامه
...سرعان ما تبني شخصيّته

380
00:21:40,730 --> 00:21:44,680
!مرحباً! معكم ياسان ذات الأنف المسدود

381
00:21:41,170 --> 00:21:44,440
...بالإضافة إلى أنّه وسيم بصوت مُثير

382
00:21:45,470 --> 00:21:46,790
هذا غريب

383
00:21:47,290 --> 00:21:50,280
لِمَ ما زال لديّ أنف مسدود كهذا؟

384
00:21:50,710 --> 00:21:57,740
مساء الفانين! كيف يتعامل معكم ألم
الحياة أيّها الفانون اليوم؟

385
00:21:58,060 --> 00:22:04,040
!هذا أنا، سيّد الشّياطين فيلتول فيلفيت فيلسفالت