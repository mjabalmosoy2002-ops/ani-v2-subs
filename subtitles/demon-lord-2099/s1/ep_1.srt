1
00:00:01,860 --> 00:00:04,190
،منذ فترة ليست ببعيدة

2
00:00:05,390 --> 00:00:10,510
كانت هناك قوّتان تتحاربان
للهيمنة على ألنيث

3
00:00:11,430 --> 00:00:14,490
،إحداها كانت فانية ذات عمر محدود

4
00:00:23,390 --> 00:00:26,340
والأخرى كانت خالدة ومُحرّرة من قيود الموت

5
00:00:37,910 --> 00:00:42,290
حرب الخالدين قسمت العالم إلى نصفين
وأمست أشرس من أيّ وقت مضى

6
00:00:59,970 --> 00:01:05,020
في النّهاية، أصبح مصير العالم يعتمد
على معركة بين رجلين

7
00:01:05,930 --> 00:01:11,120
أحدهما كان غرام، البطل الّذي يحمل السّيف
المُقدّس إكساسوردي الخاصّ بالإلَهة ميلديا

8
00:01:12,020 --> 00:01:17,270
والآخر كان سيّد الشّياطين الّذي يحكم
كلّ الخالدين، فيلتول فيلفيت فليسفالت

9
00:02:06,480 --> 00:02:09,550
،في عام 1599 من الحقبة القارّيّة

10
00:02:09,890 --> 00:02:12,810
،في اليوم 12 من شهر التنّين

11
00:02:13,870 --> 00:02:18,180
انتهت تلك القصّة بلمح البصر

12
00:02:36,940 --> 00:02:39,300
أحسنت أيّها البطل

13
00:02:42,320 --> 00:02:43,480
أحسنت صنعاً فعلاً

14
00:02:44,080 --> 00:02:46,890
أنت، الفاني، قد هزمتني

15
00:02:47,410 --> 00:02:54,420
أثني على قوّتك، والأهمّ، شجاعتك

16
00:02:54,750 --> 00:02:58,190
كنتَ قويّاً كذلك. بحقّ

17
00:03:00,010 --> 00:03:02,020
لماذا خسرتُ؟

18
00:03:02,460 --> 00:03:05,900
كنتُ أقوى منكم أنتم الزّائلون العابِرون الضُّعفاء

19
00:03:06,590 --> 00:03:12,050
،بتخطيطي، وقوّتي العسكريّة، وطاقتي
وكلّ ناحية أخرى

20
00:03:13,250 --> 00:03:16,300
فلماذا إذاً؟ أخبرني

21
00:03:21,260 --> 00:03:22,650
إنّها الحياة

22
00:03:24,900 --> 00:03:26,230
الحياة؟

23
00:03:26,600 --> 00:03:29,220
لدينا حياة

24
00:03:29,580 --> 00:03:33,950
لعلّ هذا يجعلنا نبدو ضُعفاء
وعابرين في نظركم

25
00:03:34,350 --> 00:03:37,130
رغم أنّ هذا هو السّبب بالضّبط الّذي يجعلنا

26
00:03:37,130 --> 00:03:39,990
نفعل كلّ ما باستطاعتنا لنعيش

27
00:03:39,990 --> 00:03:43,530
،نقطة ضعفنا تُحفّزنا لنصبح أقوياء

28
00:03:44,140 --> 00:03:46,730
ومن هنا نكتشف بريق الحياة

29
00:03:47,300 --> 00:03:49,190
بريق الحياة؟

30
00:03:49,920 --> 00:03:51,270
كفى هُراء

31
00:03:51,690 --> 00:03:54,870
مُحال لهُراء كهذا أن يؤدّي إلى هزيمتي

32
00:03:54,870 --> 00:03:57,080
رغم ذلك، انتصرنا

33
00:03:58,060 --> 00:04:03,720
أؤمن بأنّ هذا النّصر نبع من ذلك
البريق الّذي نمتلكه نحن الفانون

34
00:04:05,280 --> 00:04:08,550
أصغِ أيُّها البطل

35
00:04:09,370 --> 00:04:12,880
حيث يوجد نور، يوجد أيضاً ظلام

36
00:04:14,170 --> 00:04:20,000
ما دام الظّلام موجوداً، سأظهر أمام
نورك مِراراً وتِكراراً

37
00:04:20,610 --> 00:04:23,070
فأنا الملِك الّذي لا يُقهَر

38
00:04:23,800 --> 00:04:27,950
إذاً سأواجه هذا الظّلام مِراراً

39
00:04:30,020 --> 00:04:36,120
الوداع يا عدوّي اللّدود الأعظم، البطل غرام

40
00:04:42,860 --> 00:04:48,690
الوداع يا خصمي الأبغض، سيّد الشّياطين فيلتول

41
00:04:53,100 --> 00:04:53,860
سأعود إلى الدِّيار

42
00:05:01,940 --> 00:05:04,520
مع ذلك استمرّ العالم

43
00:05:11,850 --> 00:05:13,290
فيلتول-ساما

44
00:05:17,020 --> 00:05:18,170
ماكينا؟

45
00:05:18,170 --> 00:05:18,890
حاضرة

46
00:05:19,290 --> 00:05:21,510
،هذه أنا، إحدى أركان أقران الظّلام الستّة

47
00:05:21,510 --> 00:05:23,630
ماكينا سوليج، دوقة اللّهب المُتوهِّج

48
00:05:23,630 --> 00:05:26,620
كنتُ أنتظر هذه اللّحظة لـ 500 عام

49
00:05:28,840 --> 00:05:29,600
حاضرة

50
00:05:30,450 --> 00:05:34,930
من فضلك سامحني على الحضور
أمامك بمثل هذا الزّي

51
00:05:34,930 --> 00:05:36,050
لا مُشكلة

52
00:05:36,050 --> 00:05:39,380
،الأهمّ، أشرفتِ على إتمام الميتينويل

53
00:05:39,380 --> 00:05:42,640
طقوس إعادة تجسُّدي، وسارعتِ
لحضور إعادة ولادتي

54
00:05:43,230 --> 00:05:46,020
والآن، أين نحن؟

55
00:05:46,410 --> 00:05:50,240
،في كاتدرائيّة ديماس نيلدور تحت الأرض
أسفل محطّة شينجوكو السّابقة

56
00:05:51,240 --> 00:05:52,450
حسناً، لا يهمّ

57
00:05:52,820 --> 00:05:54,240
!حسناً يا ماكينا

58
00:05:54,640 --> 00:05:57,120
!عاد سيّدُ الشّياطين للتو

59
00:05:57,120 --> 00:06:00,740
!انضمّي مرّة أخرى للهيمنة على ألنيث

60
00:06:00,740 --> 00:06:03,430
أريد أن أبلغك بأمر

61
00:06:03,430 --> 00:06:04,240
ما هو؟

62
00:06:04,240 --> 00:06:08,460
العالم الّذي كنّا سنحكم قد زال بالفعل

63
00:06:10,550 --> 00:06:11,440
ماذا؟

64
00:06:13,170 --> 00:06:15,540
،قبل قرابة 80 عاماً

65
00:06:15,540 --> 00:06:21,200
،عالمنا ألنيث والأرض، عالم من بُعد آخر

66
00:06:21,200 --> 00:06:24,520
تعرّضا لكارثة غير مسبوقة واندمجا معاً

67
00:06:25,410 --> 00:06:28,290
يُعرَف هذا الحدث باسم فانتازيون

68
00:06:28,290 --> 00:06:30,420
وسبّب تبدُّلاً زلزاليّاً

69
00:06:30,420 --> 00:06:34,860
%أثناء السّنوات الثّلاثة الأولى، 90
من السكّان قد أُبيدوا

70
00:06:35,340 --> 00:06:38,710
،توقّفت الحكومات الوطنيّة عن العمل

71
00:06:38,710 --> 00:06:42,540
وبدأت المُدُن بالعمل كدُول مُستقلّة

72
00:06:43,310 --> 00:06:46,370
اندلعت أيضاً حربان رئيسيّتان
،بين تلك المُدّن المستقلّة

73
00:06:46,950 --> 00:06:49,630
وبدأت الجِراح الّتي سبّبَتْها تِلك
الصِّراعات تندمل

74
00:06:50,100 --> 00:06:53,420
هذه هي الحالة الرّاهنة للحقبة
الّتي نعيش فيها

75
00:06:54,030 --> 00:06:57,510
امتلكت حضارة الأرض الصّناعيّة
،تكنولوجيا مُتقدِّمة

76
00:06:57,510 --> 00:07:00,970
بينما امتلكت حضارة ألنيث السّحريّة
ما يُدعى بالتّكنولوجيا السّحريّة

77
00:07:01,610 --> 00:07:05,010
اندماج ذلكما النّظامين المختلفين

78
00:07:05,010 --> 00:07:07,190
أدّى إلى تقدُّم سريع

79
00:07:07,790 --> 00:07:10,210
العام الآن هو 2099 من حقبة الاندماج

80
00:07:12,480 --> 00:07:13,450
...هذا هو

81
00:07:17,640 --> 00:07:20,030
العالم الجديد الّذي نعيش فيه

82
00:07:27,410 --> 00:07:30,680
!ما هذا بالتّحديد؟

83
00:08:50,800 --> 00:08:54,620
لا أصدِّق بأنّ الحضارة الفانية
قد تطوّرت إلى هذا الحدّ

84
00:08:53,540 --> 00:08:55,910
!فيلتول-ساما

85
00:08:55,950 --> 00:08:58,710
!انتبهي لخُطواتكِ

86
00:08:58,710 --> 00:09:01,140
اعذريني. كنتُ شارداً

87
00:09:01,140 --> 00:09:02,550
أجل

88
00:09:02,550 --> 00:09:04,390
المعذرة

89
00:09:04,390 --> 00:09:05,540
...بئساً

90
00:09:06,080 --> 00:09:09,560
ألا يعي حتّى أيّ من أقران
الظّلام الستّة قد اصطدم به؟

91
00:09:12,700 --> 00:09:14,110
فيلتول-ساما؟

92
00:09:14,110 --> 00:09:19,660
أعتقد سيترتّب عليّ الحرص على أن يعي
هؤلاء الفانون الحمقى ذلك بكلّ كيانهم

93
00:09:21,280 --> 00:09:24,670
!المعذرة يا فيلتول-ساما

94
00:09:21,640 --> 00:09:28,140
فلتشهدوا! الفنّ السرِّي للسّحر الّذي لا يتطلّب ترتيلاً
!والّذي لا يستطيع سوى سيّد الشّياطين استخدامه

95
00:09:24,670 --> 00:09:29,090
!المعذرة... هذا ليس مُناسباً الآن في الواقع

96
00:09:29,090 --> 00:09:30,470
!إيل ستونا

97
00:09:35,330 --> 00:09:36,590
انظروا

98
00:09:36,830 --> 00:09:38,930
سحر طقس؟

99
00:09:38,930 --> 00:09:42,330
هنالك دوماً شخص غبيّ يفعل
شيئاً غبيّاً في مكانٍ ما

100
00:09:47,110 --> 00:09:48,470
!هذا صوت صاخب

101
00:09:48,890 --> 00:09:52,080
ممنوع استخدام سحر عظيم داخل المدينة

102
00:09:52,080 --> 00:09:52,900
ماذا؟

103
00:09:53,320 --> 00:09:54,680
علينا الخروج من هنا

104
00:09:53,670 --> 00:09:55,270
...مـ-مهلاً

105
00:09:56,370 --> 00:09:58,570
لِمَ عليّ الهرب بمركزي هذا؟

106
00:09:58,570 --> 00:10:00,060
!من فضلك! من فضلك

107
00:10:06,910 --> 00:10:12,870
فيلتول-ساما، بعد مماتك، اتّفقنا
على وقف إطلاق النّار مع الفانين

108
00:10:13,430 --> 00:10:16,520
،ثمّ قبل قرابة 80 عاماً

109
00:10:16,830 --> 00:10:18,830
الاضطراب في فانتازيون

110
00:10:18,830 --> 00:10:22,660
أدّى إلى تفرُّق مُواطني مملكة الخالدين
وانتقالهم إلى المُدُن الكُبرى

111
00:10:22,660 --> 00:10:27,660
بعد فترة قصيرة، شنّت الصّناعات
الكُبرى حملة

112
00:10:27,660 --> 00:10:28,610
حملة؟

113
00:10:30,910 --> 00:10:32,280
صيد الخالدين

114
00:10:33,780 --> 00:10:37,480
عُومِل الخالدون كمخلوقات سيّئة
عِوضاً عن أُناس

115
00:10:37,480 --> 00:10:39,700
وأصبحوا هدفاً للاستئصال

116
00:10:40,070 --> 00:10:42,850
،مع تطوُّر الهندسة السّحريّة

117
00:10:42,850 --> 00:10:46,240
تمّ تطوير أسلحة مُضادّة للخالدين
،وأُنتِجت بكمّيات كبيرة

118
00:10:46,240 --> 00:10:48,090
لتُبيدنا بشكل شبه كامل

119
00:10:49,090 --> 00:10:51,200
ماذا حدث لأقران الظّلام الستّة؟

120
00:10:52,720 --> 00:10:56,790
،مكان ماي، العلياء الحزينة
وسيلوالد، التنّين الأسود

121
00:10:56,790 --> 00:10:59,480
ورالشين، العاصفة الزّرقاء، مجهول تماماً

122
00:11:00,220 --> 00:11:02,090
،وزينول، سيف العاقِبة

123
00:11:02,090 --> 00:11:06,170
لعِب دور الطّعم وانقضّ على العدوّ
كي أتمكّن من الهرب

124
00:11:06,700 --> 00:11:12,430
قال أنّه كان يفعل ذلك لأجلك
بما أنّ رالشين وأنا

125
00:11:12,430 --> 00:11:16,020
كنّا الوحيدين اللّذين نعرف كيفيّة
تفعيل الميثينويل

126
00:11:16,020 --> 00:11:18,740
كان رجلاً ذا ولاء شديد دوماً

127
00:11:19,240 --> 00:11:20,940
خدمَني بإخلاص حقّاً

128
00:11:25,320 --> 00:11:27,250
ماذا عن ماركوس، الفنون الدّامية؟

129
00:11:27,250 --> 00:11:28,020
ماذا؟

130
00:11:28,520 --> 00:11:30,140
...في الواقع

131
00:11:30,710 --> 00:11:35,380
فيلتول-ساما، هل أنت عطشان؟

132
00:11:35,380 --> 00:11:36,580
ليس تماماً

133
00:11:36,880 --> 00:11:38,880
،حتّى لو كان لا يؤثِّر بك

134
00:11:38,880 --> 00:11:42,800
!هواء هذه المدينة مُلوّث جدّاً بالنّسبة لك

135
00:11:43,100 --> 00:11:47,120
سأذهب لشراء شراب لترطيب
حلقك يا فيلتول-ساما

136
00:11:47,120 --> 00:11:49,430
انتظر هنا لبعض الوقت من فضلك

137
00:11:50,760 --> 00:11:53,400
!صباح الخير

138
00:11:54,080 --> 00:11:58,330
!ياهو

139
00:12:00,560 --> 00:12:02,810
اثنتان تكفيان

140
00:12:02,810 --> 00:12:03,830
لا، أربعة

141
00:12:03,830 --> 00:12:08,110
اثنتان تكفيان. افهم من فضلك

142
00:12:16,310 --> 00:12:17,700
!أجل

143
00:12:17,700 --> 00:12:19,580
!ماذا؟! ما هذا؟

144
00:12:18,210 --> 00:12:19,790
أهذا كلّ ما يمكنك أخذه؟

145
00:12:19,580 --> 00:12:21,460
هل الإعلانات العامّة تُخترَق؟

146
00:12:19,790 --> 00:12:21,470
!لا، ما زال بمقدوري المتابعة

147
00:12:21,470 --> 00:12:23,190
!أجل، هذا صحيح

148
00:12:23,190 --> 00:12:23,960
!أجل

149
00:12:23,960 --> 00:12:26,770
جسدك يتوسّلني أن أعذّبه

150
00:12:26,670 --> 00:12:27,940
يا امرأة

151
00:12:26,770 --> 00:12:28,570
!أريد المزيد، من فضلك

152
00:12:29,950 --> 00:12:31,770
!ها أنا ذا

153
00:12:31,670 --> 00:12:33,530
أ-أنا؟

154
00:12:31,770 --> 00:12:34,510
أجل. جيّد، جيّد

155
00:12:33,530 --> 00:12:34,170
أجل

156
00:12:35,210 --> 00:12:36,640
ماذا؟

157
00:12:37,380 --> 00:12:39,920
ماذا فعلتِ للتو؟

158
00:12:38,270 --> 00:12:40,280
!ما زال بمقدوري أخذ المزيد

159
00:12:39,920 --> 00:12:40,850
ماذا؟

160
00:12:40,840 --> 00:12:43,600
!جيّد، خمسة إضافيّات فقط

161
00:12:40,850 --> 00:12:45,780
عـ-عمّاذا تتكلّم؟ لستُ أفهم

162
00:12:43,600 --> 00:12:44,390
!أجل

163
00:12:45,780 --> 00:12:48,580
رأيتُ الإيثر حولكِ يتذبذب

164
00:12:48,580 --> 00:12:51,010
ثمّ تغيّرتْ تِلك الإسقاطات

165
00:12:52,300 --> 00:12:56,190
اكتشفتَ اختراقي البرمجيّ
من التقلُّبات في الإيثر؟

166
00:12:56,190 --> 00:12:57,460
مستحيل

167
00:12:57,930 --> 00:12:59,290
من أنت؟

168
00:13:01,830 --> 00:13:03,000
سيّد الشّياطين

169
00:13:03,000 --> 00:13:04,710
هل أنت جادّ؟

170
00:13:04,980 --> 00:13:10,250
أفهم بأنّكِ فعلتِ شيئاً لتلك
،الإسقاطات المُزيّفة

171
00:13:10,250 --> 00:13:13,320
لكن لا أفهم المبدأ خلف ذلك

172
00:13:13,630 --> 00:13:15,940
تبدين خبيرة بالنّسبة لي

173
00:13:15,940 --> 00:13:20,400
في الواقع، لم أفعل شيئاً مُبهراً
إلى هذه الدّرجة

174
00:13:20,400 --> 00:13:22,540
مجرّد اختراق بسيط

175
00:13:22,540 --> 00:13:24,270
!اختراق برمجيّ إيثيريّ

176
00:13:24,540 --> 00:13:26,080
اختراق برمجيّ؟

177
00:13:26,080 --> 00:13:32,440
أجل. بالرّغم ممّا يوحي به مظهري، أنا أيضاً
أتولّى اعمالَ خطيرة قد تكلّفني حياتي

178
00:13:32,440 --> 00:13:34,360
!أنا مُخترِقة إيثيريّة

179
00:13:34,610 --> 00:13:36,520
،لذا بالنّسبة لما فعلتُه للتو

180
00:13:36,520 --> 00:13:38,670
في الواقع، هناك ضعف قاتل
في حاجز المنطِق

181
00:13:38,670 --> 00:13:40,450
الخاصّ ببرنامج شاشات العرض الهولوغرافيّة
،المُصنَّعة بواسطة آي.أتش.أم.آي

182
00:13:40,450 --> 00:13:42,780
والّتي تُشكِّل غالبيّة شاشات العرض
الحاليّة في مدينة شينجوكو

183
00:13:42,780 --> 00:13:47,620
لذا دسستُ بعض الإعلانات الإباحيّة
الّتي وجدتُها على الإنترنت فحسب

184
00:13:47,620 --> 00:13:51,070
والآن لا أريدك أن يلتبس عليك الأمر

185
00:13:51,070 --> 00:13:54,260
وتفترض بأنّني فعلتُ ذلك فقط من باب
الفضول الفكريّ أو الملل

186
00:13:54,260 --> 00:13:58,060
إنَّ آي.أتش.أم.آي صارمة جدّاً بشأن
،النُّظُم الشّبكيّة وفلترة المحتوى

187
00:13:58,060 --> 00:14:01,900
لذا هي عدوّة لمُعتقداتي بأنّ الإنترنت ينبغي
أن يكون مكاناً للحرّية الحقيقيّة

188
00:14:01,900 --> 00:14:06,610
لذا كان هذا في الواقع شيئاً
من الأنشطة بالنّسبة لي

189
00:14:06,610 --> 00:14:10,390
بصِفتي شخص يُجسّد المُتمرِّدين
،ضدّ هذا المُجتمع الفاسد

190
00:14:10,390 --> 00:14:13,470
—أستعمل مواهبي كمُخترِقة عبقريّة جميلة كي

191
00:14:13,470 --> 00:14:14,050
أخبريني

192
00:14:14,050 --> 00:14:15,040
ماذا؟

193
00:14:15,440 --> 00:14:18,120
أبحث عن رجل يُدعى ماركوس

194
00:14:18,120 --> 00:14:20,130
هل سبقَ وسمعتِ بهذا الاسم من قبل؟

195
00:14:21,530 --> 00:14:23,990
قد تجده إن ذهبت إلى هناك

196
00:14:23,990 --> 00:14:27,850
الرّئيس التّنفيذيّ لتلك الشّركة يُدعى
ماركوس، وهو مشهور

197
00:14:48,020 --> 00:14:50,580
مرحباً بك في آي.أتش.أم.آي

198
00:14:50,580 --> 00:14:52,570
من فضلك صرِّح عن عملك

199
00:14:52,570 --> 00:14:54,350
أخبري ماركوس بأنّني هنا

200
00:14:54,350 --> 00:14:56,920
سيفهم عندما تخبرينه بأنّ فيلتول هنا

201
00:14:56,920 --> 00:14:58,600
كنّا ننتظرك

202
00:14:59,240 --> 00:15:03,320
أنا الأمينة الخاصّة بالمُدير ماركوس

203
00:15:03,320 --> 00:15:05,040
اسمي كينوهارا

204
00:15:12,260 --> 00:15:13,590
ما الأمر؟

205
00:15:13,590 --> 00:15:17,260
في الواقع، كان يراودني فضول بشأن
هذا المخلوق الغامض

206
00:15:17,260 --> 00:15:22,390
هذه هي الشّخصيّة الدّعائيّة الّتي نعتزّ بها لشركة
السّحر الثّقيل الصّناعيّة إيشيمارو، إيشيماري

207
00:15:22,390 --> 00:15:26,030
نُخطِّط لتأسيس حركة تتمحور حوله
في المستقبل القريب

208
00:15:28,320 --> 00:15:30,450
إنّه مخلوق فريد من نوعه

209
00:15:33,420 --> 00:15:37,760
مضى وقت طويل يا ملِكي

210
00:15:39,010 --> 00:15:42,530
ماركوس. من قلّة الاحترام أن تبقى جالساً

211
00:15:43,560 --> 00:15:47,570
ما الشّأن الّذي جعلك تأتي إلى هنا اليوم؟

212
00:15:47,570 --> 00:15:50,970
ألا ينبغي أن تكون أوّل من يحتفل بإعادة إحيائي؟

213
00:15:50,970 --> 00:15:53,170
...أجل، في الواقع

214
00:15:53,170 --> 00:15:54,340
اِنسَ الأمر

215
00:15:54,700 --> 00:16:00,440
ستُساعدني في إعادة بناء مملكة الخالدين
والهيمنة على هذا العالم من جديد

216
00:16:09,160 --> 00:16:10,370
!أرفُض

217
00:16:10,870 --> 00:16:11,900
ماذا؟

218
00:16:11,900 --> 00:16:20,190
—أخبرتُك للتو بأنّني أرفض يا ملِكي
بل يا فيلتول

219
00:16:20,440 --> 00:16:22,610
أتجرؤ على الاستخفاف باسمي؟

220
00:16:23,100 --> 00:16:24,410
!يا للوقاحة

221
00:16:24,410 --> 00:16:26,340
نصل التنّين، تشيدوري

222
00:16:35,420 --> 00:16:37,630
سحر تشكيل الأسلحة؟

223
00:16:37,860 --> 00:16:41,310
لا مُشكلة يا كينوهارا. تراجعي

224
00:16:41,310 --> 00:16:42,590
أمرك

225
00:16:45,790 --> 00:16:48,160
أصبحتَ ضعيفاً

226
00:16:48,160 --> 00:16:51,320
إنَّ جرحاً كهذا كان ليلتئم فوراً
،حالما تُصاب به

227
00:16:51,320 --> 00:16:54,040
دون أن تُراق قطرة دم واحدة

228
00:16:54,330 --> 00:16:57,220
وتقول بأنّك ستسيطر على هذا العالم؟

229
00:16:57,220 --> 00:16:59,670
من فضلك لا تُثِرني على الضّحك

230
00:16:59,670 --> 00:17:05,220
الإيمان الّذي كان يدعمك والخوف الّذي
كنتَ تُمثِّله ضاع في طي النّسيان

231
00:17:05,970 --> 00:17:09,060
لن أنحني لضعيف كهذا

232
00:17:09,060 --> 00:17:12,090
والآن أسرع واغرُب عن وجهي

233
00:17:12,410 --> 00:17:13,670
...لكن رُبّما

234
00:17:13,910 --> 00:17:17,500
،إذا سجدت وتوسّلت

235
00:17:17,500 --> 00:17:20,060
حينئذ قد أعيد النّظر في الأمر

236
00:17:21,650 --> 00:17:25,520
ينبغي أن تعلم سلفاً بأنّك لا تستطيع هزيمتي

237
00:17:25,770 --> 00:17:27,480
أتجرؤ على تجربة ذلك؟

238
00:17:27,800 --> 00:17:28,290
—فير

239
00:17:28,290 --> 00:17:29,570
كاسر التّعويذات

240
00:17:32,180 --> 00:17:35,070
أنت أبطأ بخطوتين

241
00:17:35,740 --> 00:17:36,650
!مستحيل

242
00:17:37,140 --> 00:17:38,150
!كيف؟

243
00:17:44,310 --> 00:17:47,740
،لا بدّ أنّك تتساءل كيف لشخص مثلك
،يستطيع استخدام سحر دون ترتيل

244
00:17:47,740 --> 00:17:51,250
أن يغدو عاجزاً أمام شخص مثلي
لا يملك موهبة في السّحر

245
00:17:51,250 --> 00:17:54,180
أهذا ما تفكّر فيه؟

246
00:17:54,180 --> 00:17:55,970
!يا سيّد الشّياطين فيلتول

247
00:17:56,240 --> 00:17:57,210
صحيح؟

248
00:17:57,210 --> 00:17:58,880
أنت كذلك، صحيح؟

249
00:17:59,200 --> 00:18:01,010
هذا هو السّبب

250
00:18:01,360 --> 00:18:03,010
ما هذا؟

251
00:18:03,420 --> 00:18:07,890
اليوم، سوف نعرّفكم على نتاج حكمة البشريّة

252
00:18:07,890 --> 00:18:10,440
،الأحدث في الهندسة السّحريّة

253
00:18:10,440 --> 00:18:12,560
الأداة السّحريّة، فاميليا

254
00:18:12,880 --> 00:18:17,210
كما تعلمون جميعاً، يتطلّب تفعيل السّحر
عمليّة من خمس خطوات

255
00:18:17,210 --> 00:18:22,090
وهي الإعداد، البناء، التّوسيع، التّعويذ، والإعلان

256
00:18:22,090 --> 00:18:23,580
،مع فاميليا

257
00:18:23,580 --> 00:18:27,790
يمكنك تخطّي خطوات البناء والتّوسيع والتّعويذ

258
00:18:27,790 --> 00:18:29,710
أولئك الّذين زُرِعت فيهم فاميليا

259
00:18:29,710 --> 00:18:32,180
يمكنهم ببساطة الاختيار والسّحر
الّذي يريدون استعماله

260
00:18:32,180 --> 00:18:34,700
سيُفعَّل بمُجرّد إعلان فقط

261
00:18:34,700 --> 00:18:36,170
،بزرع هذه الأداة

262
00:18:36,170 --> 00:18:38,630
النّاس من كافّة الأعراق والأعمار

263
00:18:38,630 --> 00:18:43,510
يستطيعون استخدام السّحر دون تعويذ
أو بناء أو توسيع

264
00:18:43,510 --> 00:18:46,100
اجعلوا أحلامكم حقيقة

265
00:18:46,100 --> 00:18:48,610
هذه هي فاميليا

266
00:18:48,810 --> 00:18:52,290
بالمناسبة، صمّمتُ الفاميليا بحيث لا تندمج

267
00:18:55,410 --> 00:18:59,060
لذا لا يمكنك استخدام فاميليا

268
00:18:59,260 --> 00:19:02,900
فلو زرعتَ فاميليا في داخلك بعد
،بعثك النّهائيّ

269
00:19:02,900 --> 00:19:05,650
حينئذ سأفقد اليد الطّولى، أليس كذلك؟

270
00:19:05,980 --> 00:19:09,080
حينئذ سيكون ذلك سيّئاً جدّاً، سيّئاً للغاية

271
00:19:09,660 --> 00:19:10,280
—فيرن

272
00:19:10,280 --> 00:19:11,570
كاسر التّعويذات

273
00:19:12,760 --> 00:19:15,870
سرعتك في مُعالجة السّحر مُبهرة

274
00:19:15,870 --> 00:19:18,810
،غير أنّ فاميليا أسرع حتّى

275
00:19:18,810 --> 00:19:21,250
وأصبحت الآن حاجة يوميّة يملكها الجميع

276
00:19:21,610 --> 00:19:26,610
،إن لم يكن لديك واحدة في جسدك
فستكون بطيئاً جدّاً بالنّسبة لهذا العالم

277
00:19:27,010 --> 00:19:28,950
لماذا يا ماركوس؟

278
00:19:28,950 --> 00:19:31,820
!لماذا، لماذا، لماذا... كم هذا مُخجِل

279
00:19:32,390 --> 00:19:36,890
هل صدّقتَ حقّاً بأنّني كنتُ
قد أقسمتُ الولاء لك؟

280
00:19:37,160 --> 00:19:40,200
لم أحبّك منذ البداية

281
00:19:41,130 --> 00:19:44,610
أنت طاغية ومُتغطرس ودائماً ما تثبت
بأنّك أفضل منّي في كلّ شيء

282
00:19:44,610 --> 00:19:46,960
!لذا كرهتُك من أعماق قلبي

283
00:19:48,130 --> 00:19:52,100
هل يمكنك أن تستوعب حتّى كيف
كان شعوري بينما يتمّ إكراهي

284
00:19:52,100 --> 00:19:56,310
على احتواء غضبي وأنا أعمل كخادم
!لرجل كهذا لمدّة طويلة؟

285
00:19:56,310 --> 00:19:59,090
اعذرني، فقدتُ رباطة جأشي

286
00:19:59,600 --> 00:20:02,180
هل تعني بأنّني كنتُ أعمى طوال الوقت؟

287
00:20:02,450 --> 00:20:04,830
يسرّني أن تفهم

288
00:20:05,220 --> 00:20:07,710
حان الوقت لأطلب منك المُغادرة

289
00:20:07,710 --> 00:20:09,260
سيف الدّم

290
00:20:15,140 --> 00:20:17,990
وداعاً أيّها الملِك القديم

291
00:20:23,370 --> 00:20:25,350
!من دم إلى قنبلة

292
00:20:27,700 --> 00:20:31,330
والآن وهم سيّد الشّياطين السّابق قد ولّى

293
00:20:31,330 --> 00:20:34,540
من الآن فصاعداً، سأكون سيّد الشّياطين الحقيقيّ

294
00:20:35,530 --> 00:20:36,990
حضرة المُدير

295
00:20:36,990 --> 00:20:38,310
ما الأمر؟

296
00:20:38,690 --> 00:20:42,510
أرغب في مُناقشة خطّة التّسويق لإيشيماري

297
00:20:44,250 --> 00:20:47,500
سلّمي أفكاركِ في اجتماع التّخطيط

298
00:20:53,820 --> 00:20:56,490
إعادة تجدُّدي بطيئة جدّاً

299
00:21:00,270 --> 00:21:01,320
!اللّعنة

300
00:21:01,320 --> 00:21:02,150
ماذا؟

301
00:21:02,440 --> 00:21:06,100
!أنت! أتلعنني بعد الاصطدام بي؟

302
00:21:06,410 --> 00:21:07,830
أحمق وقح

303
00:21:08,120 --> 00:21:09,280
ماذا؟

304
00:21:09,910 --> 00:21:13,070
!فيلتول-ساما

305
00:21:14,320 --> 00:21:16,070
ماذا؟ هل كان يتشاجر؟

306
00:21:16,070 --> 00:21:17,950
!هذا عنيف

307
00:21:19,680 --> 00:21:21,220
لماذا خسرت؟

308
00:21:22,350 --> 00:21:25,460
سخافات بريق الحياة؟

309
00:21:22,580 --> 00:21:25,290
!فيلتول-ساما! فيلتول-ساما

310
00:21:25,710 --> 00:21:27,110
!فيلتول-ساما

311
00:21:27,110 --> 00:21:28,520
!اِبقَ معي

312
00:21:28,750 --> 00:21:31,290
!فيلتول-ساما! فيلتول-ساما

313
00:21:29,630 --> 00:21:31,290
...هذا فقط

314
00:21:31,290 --> 00:21:32,570
!فيلتول-ساما

315
00:21:32,900 --> 00:21:35,660
...هذا فقط

316
00:21:38,700 --> 00:21:40,410
أنا آسفة جدّاً

317
00:21:41,620 --> 00:21:43,820
لماذا تعتذرين يا ماكينا؟

318
00:21:43,820 --> 00:21:46,620
،تردّدتُ في إبلاغك عن خيانة ماركوس

319
00:21:46,620 --> 00:21:50,690
وتكبّدتَ جروحاً كهذه بسبب ذلك

320
00:21:51,300 --> 00:21:52,230
لا مُشكلة

321
00:21:52,670 --> 00:21:59,790
لو كنتِ قد أخبرتِني، لزادت رغبتي في رؤية
ماركوس والتحقُّق من ذلك بنفسي

322
00:22:09,610 --> 00:22:11,830
هذا منزلي الحاليّ

323
00:22:12,200 --> 00:22:16,810
إنّه يفتقر للجاذبيّة، لكنّه واسع نسبيّاً

324
00:22:17,150 --> 00:22:21,240
أبليتِ حسناً في تأمين قلعة
كهذه في هذه الحقبة الحاليّة

325
00:22:22,410 --> 00:22:23,680
من هنا

326
00:22:23,680 --> 00:22:24,860
من هنا؟

327
00:22:34,010 --> 00:22:36,730
هذا صغير جدّاً بالنّسبة لمخزن

328
00:22:37,580 --> 00:22:38,590
لا

329
00:22:41,640 --> 00:22:43,680
هذه الغرفة هي منزلي

330
00:22:47,460 --> 00:22:48,890
كفى مُزاحاً

331
00:22:50,390 --> 00:22:52,340
راتبي قليل

332
00:22:54,640 --> 00:22:57,530
كنتِ تعيشين هكذا طوال هذا الوقت؟

333
00:22:57,530 --> 00:22:58,350
أجل

334
00:23:06,890 --> 00:23:12,500
العمق الحقيقيّ لولائكِ قد حُفِر في ذهني

335
00:23:13,800 --> 00:23:15,620
خدمتِني بوفاء حقّاً

336
00:23:20,530 --> 00:23:25,700
مديحك هو أكثر ممّا أستحقّ

337
00:23:35,940 --> 00:23:37,600
"سيّد الشّياطين وخدمه"