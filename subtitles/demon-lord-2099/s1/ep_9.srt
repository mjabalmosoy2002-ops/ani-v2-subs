1
00:01:34,280 --> 00:01:35,440
،وبالتّالي

2
00:01:35,440 --> 00:01:41,030
مثلما يُعدّ استنساخ الرُّوح الخاصّ بالاستحضار
،والأنيسيان الخاصّ بالخيمياء مُحرّماً

3
00:01:41,030 --> 00:01:47,110
فإنّ نقل الرّوح يُعدّ حراماً أكبر حتّى
بموجب أخلاقيّات السّحر المُعاصر

4
00:01:47,470 --> 00:01:52,790
إذاً لِمَ علينا أن نتعلّم نقل الرّوح"
"في مدرسة السّحر المُعاصر؟

5
00:01:52,790 --> 00:01:56,020
هو السّؤال الّذي سيطرحه الكثيرون...

6
00:01:56,020 --> 00:01:57,990
لكن سيكون ذلك خطأ

7
00:01:57,990 --> 00:02:01,110
،من حيث قدرتها على مُراقبة الرُّوح

8
00:02:01,110 --> 00:02:05,530
نقل الرّوح قد ساهم بشكل
—كبير في تطوير

9
00:02:05,530 --> 00:02:07,930
ما الأمر يا مُعلّمة ماغورو؟

10
00:02:07,930 --> 00:02:10,060
تابعي المُحاضرة من فضلكِ

11
00:02:10,060 --> 00:02:11,950
اسمي ماغ

12
00:02:11,950 --> 00:02:14,020
دوّن ذلك

13
00:02:14,020 --> 00:02:15,370
لا تقلقي

14
00:02:15,370 --> 00:02:17,240
حفظتُ ذلك عن ظهر قلب

15
00:02:17,510 --> 00:02:22,430
إذاً في بداية الدّرس، تكلّمتُ عن حادثة
—وقعت في الحقبة القارّية 722

16
00:02:22,430 --> 00:02:23,830
حادثة ريلرود

17
00:02:23,830 --> 00:02:26,910
،ريلرود، ساحر بلاط من مملكة رويستاند

18
00:02:26,910 --> 00:02:28,950
كان يجري تجارب نقل روحيّ

19
00:02:28,950 --> 00:02:33,170
وفقد السّيطرة على جسده لصالح
روح بطل كان قد نقله

20
00:02:33,500 --> 00:02:35,620
كان ذلك اليوم كارثيّاً

21
00:02:35,620 --> 00:02:38,780
لم أتوقّع أن يشتّت ريلرود إلى هذه
الدّرجة بواسطة خيانة زوجته الجنسيّة

22
00:02:38,780 --> 00:02:40,300
—لدرجة أنّه استهتر في إنشاء التّعويذة

23
00:02:40,300 --> 00:02:42,260
حسناً، هذه هي الإجابة الصّحيحة

24
00:02:42,260 --> 00:02:43,340
خيانة جنسيّة؟

25
00:02:43,340 --> 00:02:45,090
هل ذكرت المُعلّمة ذلك؟

26
00:02:45,090 --> 00:02:47,250
يتكلّم كما لو أنّه رأى ذلك شخصيّاً

27
00:02:47,250 --> 00:02:48,440
مستحيل، صحيح؟

28
00:02:52,160 --> 00:02:55,180
لماذا تبدين معتزّة كثيراً يا ماكينا؟

29
00:03:04,070 --> 00:03:05,400
انظروا

30
00:03:05,400 --> 00:03:06,620
هل أولئك تلاميذ مُنتقلون؟

31
00:03:06,620 --> 00:03:08,070
فيلتول، صحيح؟

32
00:03:07,960 --> 00:03:09,510
شلّة غريبة

33
00:03:08,630 --> 00:03:10,040
مُزوِّد البثّ؟

34
00:03:10,040 --> 00:03:11,770
رأيتُه قبل أيّام

35
00:03:11,770 --> 00:03:12,590
هل هذا هو حقّاً؟

36
00:03:12,940 --> 00:03:15,800
،هل أنتِ مهتمّة بالتّلاميذ المُنتقلين أيضاً

37
00:03:16,290 --> 00:03:21,140
،يا رئيسة عشيرة رينارد المُدمَّرة
هيزوكي رينارد-يامادا-ساما؟

38
00:03:21,790 --> 00:03:25,600
وما الّذي يريده وريث عائلة هيغرامس النّبيلة منّي؟

39
00:03:25,900 --> 00:03:31,330
من واجب النُّبلاء أن يدلّوا الّذين تنقصهم
النّبالة إلى الطّريق الصّحيح

40
00:03:31,330 --> 00:03:33,710
هذا هو اعتقادي على الأقلّ

41
00:03:34,700 --> 00:03:36,980
مع ذلك، ماذا تفعلين؟

42
00:03:37,270 --> 00:03:39,070
،لا تملكين موهبة في السّحر

43
00:03:39,070 --> 00:03:41,080
مع ذلك تتمسّكين بهذه المدرسة

44
00:03:41,080 --> 00:03:43,430
معتزّة بنفسكِ في الصفّ

45
00:03:43,430 --> 00:03:45,780
فقط لأنّك جزء من العائلات العظيمة الثّلاث

46
00:03:46,380 --> 00:03:48,670
من المُبالغة أن تعتبري نفسكِ نبيلة

47
00:03:52,570 --> 00:03:55,240
لستِ أكثر من مجرّد ابنة كهربائيّ

48
00:03:55,240 --> 00:03:56,660
وإيلف مُنعدمة الذّوق

49
00:03:57,300 --> 00:03:59,800
نصف إيلف معتوهة

50
00:04:01,950 --> 00:04:04,560
ما هذه النّظرة؟

51
00:04:04,560 --> 00:04:07,400
،يمكنك قول ما تريد عنّي

52
00:04:07,400 --> 00:04:10,390
!لكن لن أدعك تُهين أمّي وأبي

53
00:04:11,170 --> 00:04:13,760
أدليتُ بالحقيقة فحسب

54
00:04:13,760 --> 00:04:15,880
لا تغضبي لأنّني مُحقّ

55
00:04:14,660 --> 00:04:16,160
كفى ضجيجاً

56
00:04:17,110 --> 00:04:20,910
ألا ترى بأنّني أستمتع بطبق من الأودون؟

57
00:04:20,910 --> 00:04:22,200
ومن تكون أنت؟

58
00:04:22,590 --> 00:04:25,960
هل نسيتَ اسم الرّجل الّذي عرّف
عن نفسه في هذا الصّباح بالفعل؟

59
00:04:25,960 --> 00:04:27,550
وأنت أيّها النّبيل الصّغير؟

60
00:04:29,440 --> 00:04:32,540
المعذرة يا فيلتول

61
00:04:32,540 --> 00:04:35,070
اسمي آلبيرت هيغرامس

62
00:04:35,070 --> 00:04:37,130
الابن الأكبر لعائلة هيغرامس

63
00:04:37,920 --> 00:04:39,620
هيغرامس؟

64
00:04:40,330 --> 00:04:41,440
أيّاً يكن

65
00:04:42,300 --> 00:04:43,730
السرّ في الأودون

66
00:04:44,180 --> 00:04:47,360
هو أنّه يؤكَل بصمت وتركيز

67
00:04:47,760 --> 00:04:49,320
ومع ذلك ما الّذي لدينا هنا؟

68
00:04:49,570 --> 00:04:54,540
كأنّني سمعتُ بعض الأفكار النّفاقيّة
،حول النّبالة والمُلاحظات الازدرائيّة

69
00:04:54,540 --> 00:04:56,980
لذا فَسُدَت الأودون خاصّتي

70
00:04:57,450 --> 00:05:04,120
لا يحقّ لك بنعتي بالمُنافق وأنت تُمارس
عملاً مُزيّفاً وهو البثّ عبر الإنترنت

71
00:05:04,120 --> 00:05:06,410
هل كنت تشاهد بثّي؟

72
00:05:06,920 --> 00:05:09,560
!شكراً لك على المُساهمة في إيراداتي الإعلانيّة

73
00:05:09,560 --> 00:05:13,080
!سمعتُ زملائي في الصفّ يذكرون ذلك فقط

74
00:05:13,080 --> 00:05:17,200
أنت تقف أمام الابن الأكبر لعائلة
—هيغرامس، ومع ذلك تجرؤ

75
00:05:16,250 --> 00:05:17,200
مهلاً

76
00:05:17,200 --> 00:05:18,320
...هيغرامس

77
00:05:18,320 --> 00:05:19,540
!هيغرامس

78
00:05:19,800 --> 00:05:23,880
إذاً أنت سليل غانفال هيغرامس؟

79
00:05:23,880 --> 00:05:26,740
ما-ما أدراك باسم مؤسّسنا؟

80
00:05:26,740 --> 00:05:28,320
توقّعتُ ذلك

81
00:05:28,320 --> 00:05:31,470
إذاً لم يمُت ذلك الجبان

82
00:05:31,470 --> 00:05:33,050
عمّاذا تهذي؟

83
00:05:33,590 --> 00:05:35,270
أحنّ لتلك الأيّام

84
00:05:35,680 --> 00:05:38,780
،عندما وقفتُ أمامه في معركة ستانبولت

85
00:05:38,780 --> 00:05:41,980
ارتعد المسكين غانفال هيغرامس
ولاذ بالفرار يلبسه العار

86
00:05:42,400 --> 00:05:45,030
،القدر مليء بالمُفاجآت

87
00:05:45,030 --> 00:05:47,310
يجعلني أواجه سليله مباشرة

88
00:05:47,710 --> 00:05:49,630
!يا له من افتراء

89
00:05:49,630 --> 00:05:51,990
—كيف تجرؤ على إهانة مؤسّسـ

90
00:05:50,840 --> 00:05:51,990
...لكن، قبل كلّ شيء

91
00:05:52,360 --> 00:05:54,420
تتصرّف بعجرفة وغرور

92
00:05:54,420 --> 00:05:58,390
كيف لك أن تتبنّى مثل هذا السّلوك
وأنت حتّى أقلّ موهبة

93
00:05:58,390 --> 00:06:01,080
من المرأة الّتي تسخر منها؟

94
00:06:01,780 --> 00:06:04,520
أتدّعي بأنّني أدنى منها؟

95
00:06:04,520 --> 00:06:08,190
!أدنى من النّاقصة رينارد؟

96
00:06:09,650 --> 00:06:14,730
يبدو أنّني بحاجة لتعليمك كيف تسير
الأمور هنا في هذه المدرسة

97
00:06:16,350 --> 00:06:18,920
!أتحدّاك في نِزال

98
00:06:22,710 --> 00:06:25,010
خرجت الأمور عن السّيطرة

99
00:06:25,010 --> 00:06:26,550
!مرحباً، مرحباً

100
00:06:27,050 --> 00:06:29,350
كنتِ تواجهين وقتاً عصيباً هناك، صحيح؟

101
00:06:29,350 --> 00:06:32,200
الجميع يبتعدون عنكِ

102
00:06:32,200 --> 00:06:33,160
ماذا فعلتِ؟

103
00:06:33,160 --> 00:06:34,120
تاكاهاشي

104
00:06:36,350 --> 00:06:41,080
لا تروقهم حقيقة أنّني أرتاد هذه
المدرسة وأنا فاشلة

105
00:06:42,450 --> 00:06:43,810
فاشلة؟

106
00:06:44,980 --> 00:06:47,810
علاماتي في النّظريّ ممتازة

107
00:06:48,340 --> 00:06:50,250
لكن لا أستطيع استخدام السّحر

108
00:06:50,250 --> 00:06:51,480
ماذا؟ بجدّية؟

109
00:06:51,480 --> 00:06:53,790
إذاً لِمَ ترتادين مدرسة سحر؟

110
00:06:54,310 --> 00:06:56,100
آسفة

111
00:06:56,100 --> 00:06:57,170
لا تقلقي

112
00:06:57,170 --> 00:06:58,490
اعتدتُ على سماع ذلك

113
00:06:59,340 --> 00:07:01,810
حسناً، لديّ أسبابي

114
00:07:03,990 --> 00:07:07,800
بغضّ النّظر عن ذلك، أنا مُتفاجئة
بأنّهم يُبيحون النِّزالات

115
00:07:07,800 --> 00:07:13,460
إحدى أهداف هذه المدرسة هي تدريب
سحَرة قادرين على القتال

116
00:07:13,460 --> 00:07:15,560
،يجب أن يكون هناك مُعلّم يترأس النّزال

117
00:07:15,560 --> 00:07:19,030
،لكن ما دمت تحترم ذلك
فالنّزالات مُرحّب بها

118
00:07:19,830 --> 00:07:21,890
لكن المُعلّمة ماغ تُواجه وقتاً عصيباً

119
00:07:22,340 --> 00:07:24,710
إنّها لطيفة مع النّاس زيادة عن اللّزوم

120
00:07:25,800 --> 00:07:27,840
لنُنهِ هذا بسرعة

121
00:07:27,840 --> 00:07:30,090
ستنتهي استراحة الغداء خاصّتنا قريباً

122
00:07:30,090 --> 00:07:31,470
حسناً، مهلاً

123
00:07:32,070 --> 00:07:33,260
!أنتِ يا امرأة

124
00:07:34,490 --> 00:07:37,350
!المعذرة... هيجيكي

125
00:07:37,350 --> 00:07:38,500
!ماذا؟

126
00:07:38,500 --> 00:07:40,770
!إنّه هي-زو-كي! هيزوكي

127
00:07:40,770 --> 00:07:43,020
!لا تقتبس اسمي من عشبة بحريّة

128
00:07:43,380 --> 00:07:45,570
!افتحي عينيكِ جيّداً وراقبي

129
00:07:45,570 --> 00:07:50,410
اشهدي النّصر المؤزر لفيلتول
!فيلفيت فيلسفالت

130
00:07:50,410 --> 00:07:52,800
أتفترض بأنّك ربحت بالفعل؟

131
00:07:52,800 --> 00:07:54,230
!يا للسّذاجة

132
00:07:54,540 --> 00:07:57,720
اسمحوا لي أن أشرح الحقيقة المُحزِنة
لتلميذنا المُنتقل الجاهل

133
00:07:58,130 --> 00:08:04,910
عندما يتعلّق الأمر بتحرير المانا، والتحكّم
...بالمانا، وتخزين المانا

134
00:08:04,910 --> 00:08:09,460
أنا التّلميذ الوحيد في هذه المدرسة الّذي
تلقّى تصنيف +أ في كلّ شيء

135
00:08:09,460 --> 00:08:15,800
بصيغة أخرى، لا أحد في هذه المدرسة
!يستطيع مُجاراتي في القتال السّحريّ

136
00:08:15,800 --> 00:08:17,430
،لا أعلم بشأن الآخرين

137
00:08:17,430 --> 00:08:21,370
لكن إذا تلقّيت هذا التّصنيف
،في تخزين المانا

138
00:08:21,370 --> 00:08:25,400
فتلك المرأة الّتي كنتَ تسخر منها
إذاً تصنيفها أعلى منك بكثير

139
00:08:25,400 --> 00:08:26,390
هذا ما يقوله

140
00:08:26,390 --> 00:08:31,260
لا، تلقّيتُ تصنيف ف في تخزين
المانا والاختبارات العمليّة

141
00:08:31,260 --> 00:08:34,750
إذاً لا بدّ أنّ تقييم المدرسة خاطئ

142
00:08:34,980 --> 00:08:36,030
أجل

143
00:08:36,030 --> 00:08:40,210
تصريحات فيلتول-ساما لا تخطئ أبداً

144
00:08:42,220 --> 00:08:44,950
مهلاً، هل هذه المرأة بخير؟

145
00:08:45,310 --> 00:08:47,730
تُنادي زميلها في الصفّ "ساما"؟

146
00:08:47,730 --> 00:08:50,660
حسناً، هذا طبيعيّ بالنّسبة لها

147
00:08:50,660 --> 00:08:55,750
إذا كان هذا ما تشعر به، فأثبت إذاً
بأنّك تستطيع دعم هذه الثّقة

148
00:08:55,750 --> 00:08:59,080
،لن تكون معركة بسيطة نزيهة لك

149
00:08:59,080 --> 00:09:00,730
لذا سأضيف بعض المُعوِّقات

150
00:09:07,430 --> 00:09:11,280
،إن كنت ستختلق عذراً للخسارة
فهذا عذر سيّئ

151
00:09:11,280 --> 00:09:16,350
سأكون غير ناضج إذا تحرّكتُ
أثناء هذا الحدث التّرفيهيّ

152
00:09:16,350 --> 00:09:19,140
أنت عازم على إهانتي فحسب، أليس كذلك؟

153
00:09:19,140 --> 00:09:20,870
حسناً، حسناً

154
00:09:20,870 --> 00:09:22,950
لنُقسِم قسَماً

155
00:09:22,950 --> 00:09:24,520
قسَم؟

156
00:09:24,520 --> 00:09:25,730
هذا صحيح

157
00:09:25,730 --> 00:09:30,510
،إذا خسرتُ أو تزحزحتُ خطوة واحدة من هنا
فسأفعل أيّ شيء تطلبه

158
00:09:30,510 --> 00:09:33,270
،بالمقابل، إذا ربحتُ دون التحرُّك خطوة

159
00:09:33,270 --> 00:09:35,840
فسوف تتوقّف عن إزعاج هذه المرأة

160
00:09:35,840 --> 00:09:36,560
ماذا؟

161
00:09:36,560 --> 00:09:38,790
في الصفّ وفي أيّ مكان آخر

162
00:09:38,790 --> 00:09:39,550
لماذا؟

163
00:09:39,890 --> 00:09:44,160
طريقتك في إهانة تلك المرأة
قبل قليل كانت بغيضة

164
00:09:44,160 --> 00:09:45,520
هل تقبل؟

165
00:09:45,520 --> 00:09:46,880
مُوافق

166
00:09:46,880 --> 00:09:50,410
لا أكترث لتلك المعتوهة على أيّ حال

167
00:09:50,410 --> 00:09:53,870
،رغم أنّك أنت من يقترح هذا الوعد
لذا إيّاك أن تنكثه

168
00:09:54,110 --> 00:09:56,860
لم أقل وعداً، بل قلتُ قسَماً

169
00:09:56,860 --> 00:09:59,560
ومن المُؤكّد أنّ نبيلاً مثلك
يفهم ما يعنيه ذلك؟

170
00:09:59,560 --> 00:10:01,140
بالطّبع

171
00:10:01,140 --> 00:10:05,680
سوف أقسِم هذا القسَم باسمي
كآلبيرت هيغرامس

172
00:10:06,650 --> 00:10:09,500
أنتما صديقتاه، صحيح؟

173
00:10:09,500 --> 00:10:11,020
ينبغي أن توقفاه

174
00:10:11,020 --> 00:10:12,700
آلبيرت قويّ

175
00:10:12,700 --> 00:10:15,380
إنّه ليس التّلميذ رقم واحد في هذه
المدرسة بلا سبب

176
00:10:15,380 --> 00:10:17,160
لا تقلقي

177
00:10:17,160 --> 00:10:20,660
ذلك الرّجل لا يملك حتّى فُرصة
واحد من مليون أمامه

178
00:10:20,660 --> 00:10:25,040
أجل. سيلقّن ذلك الرّجل درساً
ويربح بأسرع ما يمكن

179
00:10:27,230 --> 00:10:28,310
...حسناً إذاً

180
00:10:28,310 --> 00:10:33,030
أنا، المُعلّمة ماغ روسانتا، سوف
أُشرف على هذا النّزال

181
00:10:33,350 --> 00:10:36,560
كلا الطّرفين، من فضلكما عرّفا عن نفسيكما

182
00:10:36,840 --> 00:10:41,040
أنا الابن الأكبر لعائلة هيغرامس، آلبيرت هيغرامس

183
00:10:41,040 --> 00:10:46,500
،أنا سيّد الشّياطين ومُزوّد بثّ حيّ
فيلتول فيلفيت فيلسفالت

184
00:10:46,500 --> 00:10:47,700
!ابدآ

185
00:10:51,650 --> 00:10:53,460
—كافّة الخلائق المُجتمعة هنا

186
00:10:52,960 --> 00:10:56,410
آلبيرت، لا تُخيّب أملي

187
00:10:57,650 --> 00:11:00,630
هل تنوي أن تُطلِق عليّ بهذا
القدر البسيط من المانا؟

188
00:11:00,940 --> 00:11:04,210
لا تدع عجرفتك تُقيّدك أيّها السّاحر الأبله

189
00:11:04,210 --> 00:11:08,090
أطلِق عليّ بكامل قوّتك، كما
لو أنّك تحاول تدميري

190
00:11:08,930 --> 00:11:11,020
!إذاً لا تلُمني على ما يحدث

191
00:11:14,520 --> 00:11:15,740
!اهدآ

192
00:11:15,740 --> 00:11:19,690
ما الفائدة من المُبارزة إذا بدأتُما تحاولان
!قتل بعضكما الآخر بجدّية؟

193
00:11:19,690 --> 00:11:20,890
هذا مُناسب

194
00:11:20,890 --> 00:11:23,230
لا تتدّخلي يا ماغورو

195
00:11:23,500 --> 00:11:25,670
سيكون هذا درساً تربوياً له

196
00:11:25,950 --> 00:11:28,900
يبدو أنّ فيلي مستمتع بوقته

197
00:11:28,900 --> 00:11:32,150
هذا لأنّه مضى وقت منذ خاض نِزالاً
سحريّاً على الطّريقة القديمة

198
00:11:33,150 --> 00:11:35,950
جميعكم مجانين

199
00:11:36,630 --> 00:11:39,670
،كلّ الخلائق مُجتمعة هنا لملء السّماوات الواسعة

200
00:11:39,670 --> 00:11:42,740
!يتّخذ جسدي شكلَ سهم لهزيمة خصمي

201
00:11:42,740 --> 00:11:44,530
!إلقاء تعويذة

202
00:11:44,530 --> 00:11:45,810
!أجل، هذه هي

203
00:11:45,810 --> 00:11:47,840
!مضى وقت طويل

204
00:11:47,840 --> 00:11:49,770
!أيّها الأحمق! اهرب

205
00:11:49,770 --> 00:11:51,820
!ستموت فعلاً

206
00:11:51,820 --> 00:11:54,020
!السّهم الإيثريّ

207
00:12:01,560 --> 00:12:05,880
يبدو أنّك لست مجرّد كلام

208
00:12:10,490 --> 00:12:12,460
!مـ-مستحيل

209
00:12:12,460 --> 00:12:15,430
تلقّيت تعويذتي بكامل قوّتها وأنت أعزل؟

210
00:12:15,430 --> 00:12:16,670
!هذا مستحيل

211
00:12:16,950 --> 00:12:18,510
لا بأس بذلك

212
00:12:18,510 --> 00:12:20,850
،بـ 200 سنة أخرى من التّدريب

213
00:12:20,850 --> 00:12:23,800
يمكنك أن تصبح خصماً مُسلّياً بعض الشّيء

214
00:12:25,130 --> 00:12:27,290
لا تيأس

215
00:12:27,290 --> 00:12:29,400
كانت هذه النّتيجة الطبيعيّة

216
00:12:29,760 --> 00:12:33,410
تحرير المانا والتحكّم بالمانا لديك

217
00:12:33,410 --> 00:12:35,840
ممتازان بالنّسبة لزائل في العصر الحديث

218
00:12:36,190 --> 00:12:38,530
أنا متأكّد بأنّ هذه ثمرة تدريبك اليوميّ

219
00:12:39,240 --> 00:12:41,710
أنتج غانغال نسلاً جيّداً حقّاً

220
00:12:41,710 --> 00:12:42,410
ماذا؟

221
00:12:43,040 --> 00:12:46,190
سأعتذر على وقاحتي السّابقة تجاه سلفك

222
00:12:46,190 --> 00:12:51,950
وأيضاً سأمنحك مُكافأة على جهودك
ومُثابرتك في تعلّم السّحر

223
00:12:58,060 --> 00:13:00,960
فلتتذوّق الجوهر الحقيقيّ للسّحر

224
00:13:00,960 --> 00:13:03,340
تذوّقه بكامل جسدك

225
00:13:15,210 --> 00:13:17,720
ماذا كان ذلك؟

226
00:13:17,720 --> 00:13:20,970
أطلقَ كتلة من المانا المضغوطة

227
00:13:21,320 --> 00:13:25,190
إنّه شرفٌ أن تتنعّم بمانا فيلتول-ساما
بصورة مباشرة

228
00:13:25,420 --> 00:13:27,400
هذا هدرٌ على زائل

229
00:13:27,800 --> 00:13:29,490
،تتكلّمين وكأنّ المسألة بسيطة

230
00:13:29,490 --> 00:13:34,830
لكن هذا ليس شيئاً يستطيع بشريّ
فعله، ناهيك عن تلميذ ثانويّة

231
00:13:35,170 --> 00:13:37,840
من يكون بالضّبط؟

232
00:13:38,710 --> 00:13:40,410
ما الأمر يا ماغورو؟

233
00:13:40,940 --> 00:13:42,870
أعلِني عن الرّابح

234
00:13:42,870 --> 00:13:45,260
...الرّابح هو

235
00:13:45,610 --> 00:13:48,590
!فيلتول فيلفيت فيلسفالت

236
00:13:49,710 --> 00:13:52,220
!فيلي غاية في الرّوعة

237
00:13:53,500 --> 00:13:55,680
هل كنتِ تشاهدين يا هيجيكي؟

238
00:13:55,930 --> 00:13:57,850
!قُل هي-زو-كي

239
00:13:58,290 --> 00:14:00,810
أهديك هذا النّصر

240
00:14:01,540 --> 00:14:03,350
...في الواقع

241
00:14:03,820 --> 00:14:05,070
شكراً

242
00:14:05,360 --> 00:14:06,100
جيّد

243
00:14:06,510 --> 00:14:07,220
...لكن

244
00:14:08,350 --> 00:14:10,560
يجدر بك أن تبتعد عنّي

245
00:14:11,870 --> 00:14:14,180
وإلّا فأنا متأكّدة بأنّك ستواجه مُصيبة

246
00:14:21,280 --> 00:14:23,300
...رغم ذلك

247
00:14:23,300 --> 00:14:30,390
إذاً هناك فعلاً أشخاص أثرياء
مغرورون لا يُحتمَلون مثل آلبيرت

248
00:14:30,990 --> 00:14:37,020
تصرّف وكأنّه عاش في عالم مختلف
عن عالمنا نحن البقيّة

249
00:14:37,020 --> 00:14:41,800
هذا لأنّ ثقافة آلنيث تبقى
قويّة جدّاً لا سيّما في أكيهابارا

250
00:14:41,800 --> 00:14:45,590
،لا أستطيع استخدام فاميليا خاصّتي
...لا أستطيع اختيار زيّي الرّسميّ

251
00:14:45,590 --> 00:14:49,130
كانت كلّ المدارس هكذا قبل مئة سنة، صحيح؟

252
00:14:49,480 --> 00:14:54,290
هذا يجعلني أُدرك كم أنا مسرورة
لأنّني وُلدتُ في هذه الحقبة

253
00:14:54,290 --> 00:14:57,410
يمكنكِ الذّهاب إلى الدّيار بنفسكِ إن أردتِ؟

254
00:14:57,410 --> 00:14:58,670
أمزح

255
00:14:58,670 --> 00:15:02,130
لا يمكنني الإسراع بالعودة إلى المنزل
دون رؤية ذلك الكنز

256
00:15:02,730 --> 00:15:08,540
رغم أنّني متفاجئة من حاجتنا للريغاليا
الثّلاثة لفتح الخزينة

257
00:15:09,000 --> 00:15:11,560
تبدو الاحتمالات ضعيفة

258
00:15:11,560 --> 00:15:15,360
ما زلنا لا نعلم ما إذا كانت سجلّات أقران
الظّلام الّتي نستهدفها بداخل الخزينة

259
00:15:15,840 --> 00:15:21,760
ألا يمكنكما فتحها بالقوّة بطريقة ما بسحركما؟

260
00:15:21,760 --> 00:15:26,360
كان ذلك مُمكناً لو أنّ الكنز
المُقفَل بسحر قديم

261
00:15:26,360 --> 00:15:30,790
مُصمّم بحيث يُدمِّر محتواه إذا حاول
أحدٌ فتحه بالقوّة

262
00:15:31,220 --> 00:15:33,110
لا أوصي بمثل هذا السّلوك

263
00:15:33,570 --> 00:15:36,720
سيترتّب علينا جمع الرّيغاليا بالطّريقة الصّعبة

264
00:15:36,720 --> 00:15:39,650
لحسن الحظّ أنّنا توصّلنا إلى اتّفاق
،مع المُديرة بخصوص النّصل

265
00:15:39,650 --> 00:15:40,800
لذا يبقى اثنان فقط

266
00:15:40,800 --> 00:15:44,810
،التّاج يملكه مُمثّل المدينة الكهربائيّة

267
00:15:44,810 --> 00:15:46,970
رئيس عشيرة سيبورد، كورنيا سيبورد

268
00:15:46,970 --> 00:15:48,380
وجدتُ ذلك بسرعة عندما بحثت

269
00:15:52,340 --> 00:15:55,110
لا يمكننا فعل شيء بشأن هذا، صحيح؟

270
00:15:55,110 --> 00:15:57,840
لا يمكننا إيجاد كنز بلا أدلّة

271
00:15:57,840 --> 00:16:00,080
لا، المسألة ليست كذلك

272
00:16:00,080 --> 00:16:01,280
ماذا تقصد؟

273
00:16:01,280 --> 00:16:03,550
هيزوكي رينارد-يامادا، صحيح؟

274
00:16:03,550 --> 00:16:04,310
أجل

275
00:16:04,310 --> 00:16:06,190
رينارد؟

276
00:16:07,820 --> 00:16:09,050
أجل

277
00:16:09,050 --> 00:16:14,720
بحسب ما قال آلبيرت لها، تلك الفتاة
هي رئيسة عشيرة رينارد

278
00:16:14,720 --> 00:16:17,830
،فقدان الجِرم، رمز سلطتهم

279
00:16:17,830 --> 00:16:20,990
لا بدّ أنّه مُرتبط بسقوطهم

280
00:16:20,990 --> 00:16:23,040
هذا هو الدّليل في بحثنا

281
00:16:23,920 --> 00:16:29,750
إذاً ذلك النّزال كان استراتيجيّة لترك
!انطباع جيّد حول تلك الفتاة

282
00:16:29,750 --> 00:16:35,070
كنّا جميعاً ألعوبة في كفّ
!سيّد الشّياطين الشرّير

283
00:16:33,680 --> 00:16:36,740
لا، استفزّني ذلك الطّفل فحسب

284
00:16:36,740 --> 00:16:40,570
هذا ما تقوله، لكن هذا لا يمنع
أنّك ساعدتها في النّهاية

285
00:16:37,650 --> 00:16:39,240
تاكاهاشي

286
00:16:40,570 --> 00:16:42,850
!هذا ما يجعلك رائعاً

287
00:16:44,050 --> 00:16:46,070
شارفنا على الوصول إلى هناك

288
00:16:46,070 --> 00:16:48,020
ماذا يوجد هناك؟

289
00:16:48,440 --> 00:16:49,790
بالمناسبة

290
00:16:49,790 --> 00:16:51,720
لم تره بعد يا فيلي

291
00:16:51,720 --> 00:16:55,930
زرتُه مرّة واحدة من قبل، لكن كان مُذهلاً

292
00:16:56,980 --> 00:16:59,270
...هـ-هذا

293
00:16:59,570 --> 00:17:00,760
!أجل

294
00:17:00,760 --> 00:17:04,040
!هذا هو الوجه الآخر لأكيهابارا

295
00:17:04,040 --> 00:17:05,900
!الوجه المُعاكس لمدينة السّحر

296
00:17:05,900 --> 00:17:09,330
!مدينة تعجّ بالملذّات والرّغبات

297
00:17:09,960 --> 00:17:12,090
!المدينة الكهربائيّة

298
00:17:12,090 --> 00:17:17,130
حتّى رؤيتها من الخارج تمنحك إحساساً
بمدى اكتظاظها السكّانيّ

299
00:17:17,560 --> 00:17:20,550
إنّها متاهة من الدّاخل غالباً

300
00:17:20,970 --> 00:17:26,260
والآن أتشوّق لأكتشف كيفيّة غزو
!هذا المكان وجمع معلومات

301
00:17:26,260 --> 00:17:27,860
انتظر يا فيلي

302
00:17:27,860 --> 00:17:29,460
هذا المكان فوضويّ من الدّاخل

303
00:17:29,460 --> 00:17:34,920
تُفيد الإشاعة بأنّك تحتاج يوماً كاملاً
للخروج منه إذا تهت

304
00:17:34,920 --> 00:17:38,630
هذا يعني بأنّك ستحتاج لكائن مُرافق كدليل

305
00:17:38,630 --> 00:17:39,470
هكذا إذاً

306
00:17:39,470 --> 00:17:42,690
والمرأة الّتي أمامك الآن هي

307
00:17:42,690 --> 00:17:46,300
مُخترِقة جميلة عبقريّة جدّاً
مُبدعة في المدينة الكهربائيّة

308
00:17:46,570 --> 00:17:49,670
أنا أيضاً مختصّة في جمع المعلومات

309
00:17:49,670 --> 00:17:50,660
ماذا يعني؟

310
00:17:50,660 --> 00:17:55,550
سوف آخذك إلى أفضل مكان لجمع
المعلومات في المدينة الكهربائيّة

311
00:17:56,730 --> 00:17:59,470
!أهلاً بعودتك يا سيّدي

312
00:17:59,470 --> 00:18:01,710
ثلاثة من فضلك

313
00:18:01,710 --> 00:18:03,420
!من هنا رجاء

314
00:18:03,680 --> 00:18:06,560
!شكراً على طلبي طوال الوقت

315
00:18:06,560 --> 00:18:08,400
!مانانان مُتأثّرة جدّاً

316
00:18:09,900 --> 00:18:12,410
!أنتِ ظريفة جدّاً اليوم يا مانانان-تان

317
00:18:12,410 --> 00:18:18,320
بئساً، أنتِ ظريفة جدّاً لدرجة
أنّ لساني قد زلّ بلُغتي القديمة

318
00:18:18,830 --> 00:18:21,110
كان ذلك حتميّاً

319
00:18:21,110 --> 00:18:24,350
مستوى مانانان-شي في الظّرافة استثنائيّ

320
00:18:24,350 --> 00:18:25,160
!صحيح

321
00:18:25,160 --> 00:18:28,670
بعبارة أدقّ، إنّها أظرف بثلاثة أضعاف
من الخادمة العاديّة

322
00:18:28,670 --> 00:18:30,960
مانانان، هل فهمتِ الإشارة؟

323
00:18:30,960 --> 00:18:35,650
أسرع بثلاثة أضعاف من عارضة أزياء
—عاديّة هي عبارة من أنمي روبوت شهير

324
00:18:36,720 --> 00:18:39,010
هلّا طرحتُ عليك سؤالاً يا تاكاهاشي؟

325
00:18:39,450 --> 00:18:40,970
ما هو؟

326
00:18:41,330 --> 00:18:43,660
،ليس تشكيكاً بك

327
00:18:43,660 --> 00:18:46,950
لكن هل يمكننا جمع معلومات
حقّاً في مكان كهذا؟

328
00:18:46,950 --> 00:18:48,450
لا، لا، لا

329
00:18:48,450 --> 00:18:49,980
هذه سذاجة يا فيلي

330
00:18:49,980 --> 00:18:53,740
مُختلف أشكال النّاس يتوقّفون
في زيارة لمقاهي الخادمات

331
00:18:53,740 --> 00:18:57,630
ووفقاً لبحثي، تعشق الخادمات الثّرثرة والإشاعات

332
00:18:57,630 --> 00:18:59,630
،لذا إذا أردنا جمع معلومات

333
00:18:59,630 --> 00:19:03,360
فإذاً زيارة مقهى خادمات هو تصرّف منطقيّ

334
00:19:03,360 --> 00:19:06,610
الحانات هي الأماكن المناسبة لجمع
المعلومات في الألعاب، صحيح؟

335
00:19:06,610 --> 00:19:09,860
مقاهي الخادمات هذه هي أشبه بالحانات

336
00:19:09,860 --> 00:19:11,250
وحتّى أنّهم يُقدّمون مشروبات هنا

337
00:19:11,250 --> 00:19:12,590
هكذا إذاً

338
00:19:12,590 --> 00:19:16,550
ظننتُ بأنّنا أتينا إلى هنا للسّياحة فقط

339
00:19:17,110 --> 00:19:18,060
سامحيني

340
00:19:18,430 --> 00:19:22,690
مستحيل. الأمر ليس كذلك إطلاقاً

341
00:19:22,960 --> 00:19:25,690
هناك أجواء فريدة في هذا
المكان، أليس كذلك؟

342
00:19:25,690 --> 00:19:29,720
،لا أستطيع إيجاد وصف دقيق له

343
00:19:29,720 --> 00:19:32,980
لكنّه جوّ فريد فعلاً

344
00:19:33,530 --> 00:19:36,900
ماكينا، تقولين الكثير من الكلام الفارغ أحياناً

345
00:19:36,900 --> 00:19:41,080
بغضّ النّظر عن ذلك، أليست
هذه الأسعار مرتفعة جدّاً؟

346
00:19:41,080 --> 00:19:43,200
!ماكينا! أيّتها الحمقاء

347
00:19:43,200 --> 00:19:44,950
ما-ماذا أصابكِ؟

348
00:19:44,950 --> 00:19:48,410
!هذا هو الثّمن! ثمن الأحلام

349
00:19:48,410 --> 00:19:51,280
تحقيق حلم وجود خادمة

350
00:19:51,280 --> 00:19:53,790
مُزيّنة بزيّ ظريف تسخّر نفسها في خدمتك

351
00:19:53,790 --> 00:19:56,040
!هذا ما تدفعين لأجله ثمناً باهظاً

352
00:19:57,300 --> 00:19:59,460
لكن كان لدينا الكثير من الخدَم والخادمات

353
00:19:59,460 --> 00:20:02,710
"يهتمّون بنا دون الحاجة لدفع ثمن "الحلم

354
00:20:02,710 --> 00:20:05,960
أجل. رغم أنّه مضت فترة طويلة
جدّاً بالنّسبة لي

355
00:20:06,210 --> 00:20:07,430
هذا صحيح

356
00:20:07,430 --> 00:20:10,880
كنتُما من الأساس من الطّبقة
النّبيلة والملكيّة

357
00:20:11,680 --> 00:20:14,690
أنسى دوماً بأنّكما حلم بحدّ ذاتكما

358
00:20:14,690 --> 00:20:16,990
رغم أنّ الخدمة هنا

359
00:20:14,690 --> 00:20:17,280
!معلوماتك غزيرة يا سيّدي

360
00:20:16,990 --> 00:20:18,910
ليست كالّتي تُوفّرها خادماتنا حسبما أذكر

361
00:20:17,280 --> 00:20:18,910
ينبغي أن تري ذلك أيضاً يا أكيبي-تشان

362
00:20:19,170 --> 00:20:22,650
حسناً، هذا هو شكل الخادمات الحقيقيّات

363
00:20:22,650 --> 00:20:23,830
حقّاً؟

364
00:20:23,830 --> 00:20:25,020
لا، لا

365
00:20:26,220 --> 00:20:32,080
أنا متأكّد بأنّكما ستكونان بخير، لكن
أحد أصدقائي قد حُظِر

366
00:20:32,080 --> 00:20:35,500
،بعد التحرُّش بخادمة حتّى طلبت منه الابتعاد

367
00:20:35,500 --> 00:20:36,600
لذا توخّيا الحذر

368
00:20:36,600 --> 00:20:40,700
تاكاهاشي، يجب أن تفكّري بعلاقاتك

369
00:20:41,260 --> 00:20:44,200
...ابتعاد

370
00:20:44,200 --> 00:20:45,940
هل من مُشكلة؟

371
00:20:46,170 --> 00:20:50,280
لا، أتذكّر فقط ما قالته رينارد تلك

372
00:20:50,730 --> 00:20:53,150
ثمّة شيء في ذلك يُؤرقني

373
00:20:53,420 --> 00:20:56,440
طلبَتْ منّا أن نبتعد عنها

374
00:20:56,930 --> 00:20:58,450
،تكلّمتُ معها قليلاً

375
00:20:58,450 --> 00:21:02,110
وبدا وكأنّها تتعمّد تجنُّب الآخرين

376
00:21:02,470 --> 00:21:03,570
هكذا إذاً

377
00:21:03,570 --> 00:21:04,640
،نظراً إلى طبيعتها

378
00:21:04,640 --> 00:21:07,870
أعتقد بأنّ إجبارها على التّفاعل معنا
سيُشكّل تأثيراً عكسيّاً

379
00:21:08,240 --> 00:21:11,790
ما زال لدينا مُتّسع من الوقت في برنامج التّبادُل
الخاصّ بنا، لذا لنصبر عليها

380
00:21:12,540 --> 00:21:15,210
نريد تجنُّب مُجابهتها

381
00:21:15,210 --> 00:21:19,850
لم تبدُ كفتاة سيّئة أيضاً، لذا حتّى
،بوضع قضيّة ريغاليا جانباً

382
00:21:19,850 --> 00:21:23,260
إنّها شخص أرغب في الانسجام معه شخصيّاً

383
00:21:23,260 --> 00:21:24,980
أجل

384
00:21:25,540 --> 00:21:29,770
!حسناً! لنُنهِ هذا الكلام ونستدعِ خادمتنا

385
00:21:29,770 --> 00:21:32,310
—تاكاهاشي، كنّا نجري مُناقشة جادّة

386
00:21:32,310 --> 00:21:35,390
!حتّى أنّ لديهم نِظام طلبات

387
00:21:35,390 --> 00:21:38,390
!إذاً لنطلب الخادمة ذات أكبر صدر

388
00:21:38,690 --> 00:21:41,150
تاكاهاشي، هل تسمعينني؟

389
00:21:41,150 --> 00:21:43,280
أنتِ جادّة زيادة عن اللّزوم يا ماكينا

390
00:21:43,280 --> 00:21:46,490
ينبغي أن نستمتع بما أنّنا قطعنا
كلّ الطّريق إلى هنا

391
00:21:46,490 --> 00:21:47,840
—ليس بيت القصيد هـ

392
00:21:47,840 --> 00:21:49,610
!آسفة لو تأخّرت

393
00:21:49,610 --> 00:21:52,120
—سيّدي! هل يمكنني تسجيل

394
00:21:56,350 --> 00:21:57,300
ماذا؟

395
00:23:35,760 --> 00:23:39,970
"العائلات العظيمة الثّلاثة في أكيهابارا"