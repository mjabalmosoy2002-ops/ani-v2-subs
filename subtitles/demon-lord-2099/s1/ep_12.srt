1
00:00:02,930 --> 00:00:05,040
!سلّمي تراتّي غوتيل

2
00:00:05,040 --> 00:00:07,100
!كيف تجرؤ على قتل كورنيا-ساما؟

3
00:00:07,100 --> 00:00:09,450
!مُحال لتراتّي-ساما أن تفعل شيئاً كهذا

4
00:00:09,450 --> 00:00:10,990
!كفى اتِّهامات لا أساس لها

5
00:00:11,830 --> 00:00:14,120
ألن تمنعهم؟

6
00:00:14,440 --> 00:00:15,620
لماذا؟

7
00:00:15,620 --> 00:00:17,760
أليس هذا ما يفعله البطل؟

8
00:00:31,790 --> 00:00:37,180
،أنا الإلَهة الّتي تحكم الحظّ والبليّة
،إحدى الآلهة العظماء الستّة

9
00:00:37,650 --> 00:00:39,910
الإلَهة ميلديا

10
00:00:41,860 --> 00:00:44,150
هذا عدم احترام، وثنيّة

11
00:00:45,530 --> 00:00:48,740
هذه أوّل مرّة نلتقي فيها شخصيّاً، أليس كذلك

12
00:00:48,740 --> 00:00:50,520
يا ملك الشّياطين فيلتول؟

13
00:00:50,520 --> 00:00:53,810
لم أتخيّل أن تنجي لتري هذا العصر

14
00:00:53,810 --> 00:00:55,730
يراودني نفس الشّعور تجاهك

15
00:00:55,730 --> 00:00:58,350
لكنّك أصبحت ضعيفاً، أليس كذلك؟

16
00:00:58,350 --> 00:01:00,160
ليس بقدركِ

17
00:01:00,560 --> 00:01:02,170
شكلك البشريّ غير مُتوقَّع

18
00:01:02,170 --> 00:01:04,830
ألا تمتلكين كبرياء كإلَهة؟

19
00:01:05,280 --> 00:01:07,930
أمقتك مقتاً شديداً

20
00:01:07,930 --> 00:01:11,340
لكن أكره كلّ الرّجال ذوي الشّعر الأسود

21
00:01:11,930 --> 00:01:14,180
ينبغي للرّجل أن يكون أشقر

22
00:01:16,110 --> 00:01:18,750
أكرهكِ كذلك

23
00:01:18,750 --> 00:01:22,520
لا سيّما هذه النّغمة المُتعالية الّتي
تتكلّمين معي بها

24
00:01:22,790 --> 00:01:27,460
يقول هذا الرّجل الّذي يتّخذ
نفس النّغمة مع إلَهة

25
00:01:33,070 --> 00:01:37,020
لم أتوقّع أبداً أن أشهد اليوم
الّذي أُقتَل فيه بواسطة إلَهة

26
00:01:38,930 --> 00:01:41,120
،تجدُّدي قد تحسّن كثيراً

27
00:01:41,120 --> 00:01:44,780
بفضل إيمان 3 ملايين مشترك لديّ

28
00:01:45,640 --> 00:01:47,190
كم هذا مُزعج

29
00:01:47,190 --> 00:01:50,200
هل هذا هو نفسه ملك الشّياطين
،الّذي قاتل البطل، غرام

30
00:01:50,200 --> 00:01:53,080
وجعل كلّ آلهة آلنيث تنقلب ضدّه؟

31
00:01:53,280 --> 00:01:57,600
وأنتِ أيضاً فقدتِ بريقكِ بالنّسبة
لشخص يدعو نفسه إلَهة

32
00:01:57,600 --> 00:02:00,810
أنا حاليّاً لستُ سوى مجرّد يرقانة قبل التّفريخ

33
00:02:10,840 --> 00:02:11,990
!شُعاع ديل

34
00:02:14,380 --> 00:02:17,100
!مُت لأجل حُبّي يا ملك الشّياطين

35
00:02:25,870 --> 00:02:28,250
كبحتِ خلودي؟

36
00:02:29,050 --> 00:02:31,640
لا ينبغي أن أتوقّع أقلّ من هذا من أسلحة أسطوريّة

37
00:02:31,640 --> 00:02:33,660
صُنِعَتْ من قِطعة من إلَهة

38
00:02:34,100 --> 00:02:35,840
لكن أمركِ مكشوف بالنّسبة لي

39
00:02:36,470 --> 00:02:37,790
ماذا؟

40
00:02:38,130 --> 00:02:40,230
،تتحكّمين بقوّة المصير

41
00:02:40,230 --> 00:02:43,770
،لتمنحي هجماتك ودفاعك حظّاً سعيداً

42
00:02:43,770 --> 00:02:47,350
بينما تعطين نتائج هجماتي ودفاعي حظّاً سيّئاً

43
00:02:47,350 --> 00:02:50,470
،لا، تُطّبقين ذلك على حركاتكِ أيضاً

44
00:02:50,470 --> 00:02:52,520
لذا لا بدّ أنّ التّطبيق أوسع من ذلك

45
00:02:53,160 --> 00:02:55,820
سلطتكِ الإلهيّة تحكم عاقبة
،الأخلاق الّتي لا حدود لها

46
00:02:55,820 --> 00:02:57,300
أيّتها الغشّاشة

47
00:02:57,650 --> 00:03:02,530
لذا في أيّام ذروتكِ، طبّقتِ هذه السّلطة
الإلَهيّة على قدره، أليس كذلك؟

48
00:03:03,140 --> 00:03:05,700
،أزلتِ قدره المُتمثّل بالشّيخوخة

49
00:03:06,050 --> 00:03:08,470
لتُحوّري وبشكل كبير مسار حياته

50
00:03:08,470 --> 00:03:10,410
حياة البطل، غرام

51
00:03:10,410 --> 00:03:11,490
اصمت

52
00:03:13,450 --> 00:03:14,810
هذا غير صحيح

53
00:03:14,810 --> 00:03:19,040
أردتُ أن يكون غرام سعيداً

54
00:03:19,720 --> 00:03:22,240
...هـ-هذا غير صحيح. أ-أنا لم

55
00:03:22,240 --> 00:03:24,580
!لم أقصد أن يحدث ذلك

56
00:03:24,580 --> 00:03:25,830
!غرام

57
00:03:27,840 --> 00:03:29,180
!أنا آسفة

58
00:03:29,560 --> 00:03:33,060
!أنا آسفة! أنا آسفة! أنا آسفة! أنا آسفة

59
00:03:33,060 --> 00:03:35,510
!أنا آسفة! أنا آسفة

60
00:03:35,510 --> 00:03:36,480
!ساعدني

61
00:03:36,970 --> 00:03:40,250
!ساعدني يا فيلتول

62
00:03:41,160 --> 00:03:43,310
أجل، بالطّبع

63
00:03:43,310 --> 00:03:44,980
تحمّلي فترة أطول قليلاً

64
00:03:44,980 --> 00:03:47,620
!أعدكِ بأن أنقذكِ يا هيزوكي

65
00:03:48,220 --> 00:03:49,190
لا

66
00:03:51,460 --> 00:03:53,450
اسمي ميلديا

67
00:03:57,850 --> 00:03:59,500
تمّت عمليّة المسح

68
00:03:59,500 --> 00:04:03,380
تمّ تأكيد كشف عنصر خالد في العدوّ الهدف

69
00:04:03,380 --> 00:04:05,880
مستوى الخطر يزيد عن 20

70
00:04:06,420 --> 00:04:08,300
!ثُر! أيّها القرمز

71
00:04:14,960 --> 00:04:17,030
لديّ سؤال واحد لو سمحتِ

72
00:04:18,330 --> 00:04:21,980
هل التقيتُ بكِ من قبل في مكان ما؟

73
00:04:24,400 --> 00:04:27,990
اسمي الرّمزيّ هو آنجي

74
00:04:27,990 --> 00:04:29,450
ما اسمكِ؟

75
00:04:29,710 --> 00:04:30,550
ماذا؟

76
00:04:31,330 --> 00:04:34,120
هذه أوّل مرّة نلتقي فيها، لذا
لنعرّف عن بعضنا الآخر

77
00:04:36,460 --> 00:04:38,790
اسمي ماكينا سوليج

78
00:04:38,790 --> 00:04:40,590
سررتُ بلقائكِ

79
00:04:40,590 --> 00:04:41,870
ماكينا

80
00:04:41,870 --> 00:04:43,530
اسم غير مألوف

81
00:04:47,900 --> 00:04:48,940
!طلقة الزّنبق المائيّ

82
00:04:53,570 --> 00:04:57,350
كان ليسهل الأمر لو أنّ تلك كانت
كافية لجعل هذا الخصم رماداً

83
00:05:10,760 --> 00:05:12,060
ماستيس

84
00:05:15,930 --> 00:05:17,200
رصاص مُوجَّه؟

85
00:05:18,500 --> 00:05:19,960
!زهرة درع اللّهب

86
00:05:23,000 --> 00:05:24,150
اندفاع

87
00:05:35,120 --> 00:05:39,700
تمّ تأكيد تناقُص القدرة القتاليّة للعدوّ

88
00:05:40,060 --> 00:05:41,870
هل كنتِ تعلمين؟

89
00:05:41,870 --> 00:05:44,640
،حالما يغادر الدمُ جسدَ خالد

90
00:05:44,640 --> 00:05:48,410
فإنّه يتحلّل ليصبح إيثَر ويتلاشى مع الوقت

91
00:05:48,410 --> 00:05:51,620
ما لم يحتفظ به صاحبه عمداً

92
00:05:53,230 --> 00:05:54,370
!من دم إلى قنبلة

93
00:05:59,890 --> 00:06:03,540
أكره الاعتماد على تعويذات ذلك الحقير

94
00:06:11,700 --> 00:06:12,720
خالدة؟

95
00:06:21,170 --> 00:06:23,370
توقّعتُ كذلك

96
00:06:23,850 --> 00:06:25,910
هذه أنتِ فعلاً، أليس كذلك؟

97
00:06:26,520 --> 00:06:27,450
!يا ماي

98
00:06:27,890 --> 00:06:29,150
...لا أعرف

99
00:06:29,650 --> 00:06:31,450
شيئاً عنكِ

100
00:06:31,980 --> 00:06:33,990
هل ذاكرتكِ...؟

101
00:06:33,990 --> 00:06:36,940
!القيود

102
00:06:38,030 --> 00:06:39,130
!ماي

103
00:06:43,430 --> 00:06:50,140
!لا

104
00:06:57,980 --> 00:06:59,760
...هذه المانا

105
00:07:06,460 --> 00:07:07,620
نامي

106
00:07:13,160 --> 00:07:14,740
!المُديرة تراتّي؟

107
00:07:14,740 --> 00:07:17,560
هذا غير مُتوقَّع

108
00:07:17,560 --> 00:07:18,350
ماذا؟

109
00:07:18,350 --> 00:07:19,730
...هذا الصّوت

110
00:07:20,280 --> 00:07:23,600
تركتُه مضبوطاً على هذا الصّوت

111
00:07:23,600 --> 00:07:24,840
أيّاً يكن

112
00:07:24,840 --> 00:07:26,680
...ما يقود كومة الخردة هذه

113
00:07:26,680 --> 00:07:31,420
أقصد آنجي، نحو حالة الغضب الشّديد
كان مُفاجأة حقيقيّة

114
00:07:31,860 --> 00:07:34,300
!اسمها ليست آنجي

115
00:07:34,300 --> 00:07:35,970
!أعيدي ماي

116
00:07:35,970 --> 00:07:40,910
،إذا فقدتُ آنجي بالإضافة إلى فشل خطّتي

117
00:07:40,910 --> 00:07:44,600
فسوف أفقد عقلي كذلك

118
00:07:44,600 --> 00:07:48,250
،أحبّ المسؤولون الكبار هذا النّموذج

119
00:07:48,250 --> 00:07:50,000
حتّى لو كان قمامة قديمة

120
00:07:50,000 --> 00:07:50,780
ماذا؟

121
00:07:51,180 --> 00:07:52,900
انتقال آنيّ؟

122
00:07:56,920 --> 00:07:57,850
...ماي

123
00:08:04,780 --> 00:08:07,510
أتهرب فحسب؟ كم هذا مُثير للشّفقة يا فيلتول

124
00:08:09,310 --> 00:08:12,920
أهذا ما حلّ بملك الشّياطين الّذي عصى الآلهة؟

125
00:08:13,110 --> 00:08:17,320
لا أريد سماع هذا من شخص يسكن
!جسد فتاة صغيرة كجبان

126
00:08:17,680 --> 00:08:18,750
يكفي أيّها الخادم

127
00:08:23,290 --> 00:08:24,400
!فيربول

128
00:08:29,560 --> 00:08:31,220
!فان سوليجيا

129
00:08:45,390 --> 00:08:47,480
فهمتُ أخيراً

130
00:08:47,480 --> 00:08:49,430
أرى الطّبيعة الحقيقيّة لسلطتكِ الإلهيّة

131
00:08:49,780 --> 00:08:52,080
في التحكّم بالمصير

132
00:08:52,760 --> 00:08:59,600
الهجمات الجسديّة، مثل هجمات سيف ونار
تحمل قليلاً من الإيثر، أمست عقيمة

133
00:09:00,050 --> 00:09:03,070
وعندما أُهاجمكِ بتعويذات تستهلك
،تركيزاً أعلى من الإيثر

134
00:09:03,070 --> 00:09:05,010
فإنّكِ تحرفينها كي لا تُصيبكِ

135
00:09:05,270 --> 00:09:09,820
الفرق الواضح بين هاتين القدرتين هو
أنّ واحدة تلقائيّة، والأخرى يدويّة

136
00:09:10,370 --> 00:09:14,430
،قدرتكِ على إبطال الهجمات نشِطة دوماً

137
00:09:14,430 --> 00:09:18,550
لكن يجب عليكِ تفعيل قدرتكِ على تجنُّب
الهجمات السّحريّة بشكل يدويّ

138
00:09:19,250 --> 00:09:22,060
،وحقيقة أنّكِ تضطرّين لتجنّبها

139
00:09:22,700 --> 00:09:26,330
هي دليل على أنّها ستضرّكِ إذا أصابتكِ

140
00:09:26,790 --> 00:09:30,000
أفضليّتكِ الحاسمة قد انهارت

141
00:09:30,000 --> 00:09:32,030
كُفّ عن التّباهي يا ملك الشّياطين

142
00:09:32,030 --> 00:09:35,250
خسرتَ بالفعل حتّى قبل رمي النّرد

143
00:09:35,470 --> 00:09:40,510
سأبيد روحك كذلك، للحرص
على ألّا تغترّ ثانية

144
00:09:40,510 --> 00:09:44,520
ثمّ سألتقي مع البطل مرّة أخرى

145
00:09:44,900 --> 00:09:48,280
ماذا أردتِ أن تفعلي في هذا
العالم من الأساس؟

146
00:09:48,480 --> 00:09:50,280
ماذا أردتُ أن أفعل؟

147
00:09:51,450 --> 00:09:53,700
أريد معرفة شعور ذلك الرّجل

148
00:09:54,160 --> 00:09:57,510
أريد أن أسأله عمّا يفكّر فيه

149
00:09:57,970 --> 00:10:01,040
ويجب عليّ الاعتذار له

150
00:10:02,160 --> 00:10:03,500
...هل أنتِ

151
00:10:04,010 --> 00:10:06,960
تقولين بصدق أنّكِ لا تفهمين مشاعر غرام؟

152
00:10:08,340 --> 00:10:11,460
!وكأنّ شخصاً مثلك سيفهم ذلك الرّجل يوماً

153
00:10:11,460 --> 00:10:12,530
!أفهمه بالطّبع

154
00:10:12,780 --> 00:10:16,240
!قبل كلّ شيء، إنّه البطل غرام

155
00:10:16,240 --> 00:10:17,720
...هذا

156
00:10:17,720 --> 00:10:19,710
أنتِ بطيئة الاستيعاب

157
00:10:20,190 --> 00:10:23,550
أنا واثق بأنّكِ علمتِ بقدره عقب
هِبة الشّباب الأبديّ خاصّتكِ

158
00:10:23,550 --> 00:10:27,100
،ونقلتِ تلك الحسرة إلى هذا العصر

159
00:10:27,100 --> 00:10:29,520
بينما تتساءلين عمّا يجب فعله

160
00:10:29,520 --> 00:10:31,140
عذراء خالدة لعينة

161
00:10:31,470 --> 00:10:32,360
عذراء؟

162
00:10:32,750 --> 00:10:36,230
ما تشعرين به تجاه البطل ليس
علاقة غير جنسيّة

163
00:10:36,230 --> 00:10:37,340
!بل هي حُبّ عاطفيّ

164
00:10:38,620 --> 00:10:39,780
حُبّ؟

165
00:10:39,780 --> 00:10:44,930
أعرف شعوره تجاه ما فعلتَه
من دون التّفكير في الأمر حتّى

166
00:10:47,760 --> 00:10:49,950
إنّه يكرهني بالطّبع

167
00:10:49,950 --> 00:10:53,300
أهذه حدود فهمكِ لغرام؟

168
00:10:53,520 --> 00:10:54,950
!أخبرني إذاً

169
00:10:54,950 --> 00:10:57,630
!ما رأيه بي؟

170
00:10:57,630 --> 00:10:59,170
سوف أخبركِ

171
00:10:59,170 --> 00:11:02,120
بعد أن تعيدي هذا الجسد إلى هيزوكي

172
00:11:02,470 --> 00:11:05,420
أنتِ إلَهة، تسرق جسد فتاة صغيرة

173
00:11:05,770 --> 00:11:08,660
!تعلمين بأنّ هذا السّلوك هو أكثر ما يكرهه هو

174
00:11:13,320 --> 00:11:14,860
...آسفة

175
00:11:16,990 --> 00:11:24,420
!أنا آسفة! أنا آسفة! أنا آسفة
!أنا آسفة! أنا آسفة! أنا آسفة

176
00:11:24,420 --> 00:11:25,930
!غرام! غرام

177
00:11:25,930 --> 00:11:27,980
!بطلي الحبيب

178
00:11:27,980 --> 00:11:29,860
هكذا بالضّبط يا ميلديا

179
00:11:30,380 --> 00:11:33,220
يمكنني على الأقلّ قبول هذا
الشّغف الشّديد منكِ

180
00:11:34,630 --> 00:11:35,320
!هيزوكي

181
00:11:37,080 --> 00:11:38,360
!أخرجيني

182
00:11:38,360 --> 00:11:40,080
!أخرجيني من هنا

183
00:11:40,080 --> 00:11:43,250
!اصمتي! لا تعترضي طريق رومانسيّتي

184
00:11:43,250 --> 00:11:45,440
!اللّعنة عليك! لا أبالي لذلك

185
00:11:45,440 --> 00:11:47,560
!اصمتي، اصمتي، اصمتي، اصمتي

186
00:11:47,860 --> 00:11:49,090
!سئمتُ من هذا

187
00:11:49,090 --> 00:11:51,030
!أريد الخروج من هذا المكان فوراً

188
00:11:51,990 --> 00:11:53,210
!النّجدة

189
00:11:56,040 --> 00:11:58,770
!أنقذني يا فيلتول

190
00:11:58,770 --> 00:12:02,340
!أجل، أسمعكِ يا هيزوكي

191
00:12:03,160 --> 00:12:03,940
!لا

192
00:12:04,540 --> 00:12:08,910
!اسمي ميلديا

193
00:12:11,400 --> 00:12:13,010
،ابتهج في السّماوات الفضّية

194
00:12:13,460 --> 00:12:15,190
!يا فيرنال ديل

195
00:12:34,520 --> 00:12:35,930
ماغورو اللّعينة

196
00:12:37,150 --> 00:12:40,350
تفعّل إذاً؟

197
00:12:40,660 --> 00:12:42,510
هيوبريس

198
00:12:42,510 --> 00:12:46,570
.كنتُ مُحقّة في إعداد ذلك من باب الحيطة
فلا أحد يعلم متى يواجه ملك الشّياطين

199
00:12:46,570 --> 00:12:47,440
...حسناً إذاً

200
00:12:47,830 --> 00:12:50,590
حان وقت مُغادرتي قبل أن تنفجر هذه المدينة

201
00:13:03,110 --> 00:13:04,200
أيّاً يكن

202
00:13:04,620 --> 00:13:07,300
الزّعيم القويّ دائماً لديه طور ثانٍ

203
00:13:22,620 --> 00:13:24,230
مرحباً يا ملك الشّياطين

204
00:13:24,480 --> 00:13:27,470
تبدو بحالة مُضحكة للغاية، أليس كذلك؟

205
00:13:27,470 --> 00:13:29,440
هل يجري أمرٌ ما؟

206
00:13:29,440 --> 00:13:30,880
...لماذا أنت

207
00:13:30,880 --> 00:13:33,290
إذا كنتَ ستُقدّم المساعدة، فافعل
ذلك برفق أكبر

208
00:13:33,690 --> 00:13:35,900
متُّ بسبب ذلك

209
00:13:36,180 --> 00:13:39,300
وما أهمّية ذلك إذا كنتَ سوف تتجدّد؟

210
00:13:39,770 --> 00:13:40,490
وبعد؟

211
00:13:40,900 --> 00:13:42,630
ما هذا بالتّحديد؟

212
00:13:42,630 --> 00:13:44,470
عذراء مُغرَمة

213
00:13:44,470 --> 00:13:46,970
،انفعلت لأجل الرّجل الّذي هي مفتونة به

214
00:13:46,970 --> 00:13:49,450
والآن تدخل في حالة هستيريّة

215
00:13:49,960 --> 00:13:52,380
هل ينبغي أن أفعل شيئاً بشأن هذا؟

216
00:13:52,380 --> 00:13:53,090
لا

217
00:13:53,810 --> 00:13:56,610
ينتمي هذا الجسد بالأصل إلى صديقة

218
00:13:56,610 --> 00:13:58,630
وعدتُ أن أساعدها

219
00:13:58,960 --> 00:14:03,100
رغم أنّه من الصّعب أن أحقّق هذا بمفردي

220
00:14:03,490 --> 00:14:06,940
البطل غرام، آمرك

221
00:14:08,260 --> 00:14:09,880
أمّن لي التّغطية

222
00:14:17,270 --> 00:14:18,380
أقبل بذلك

223
00:14:22,130 --> 00:14:24,510
!إكساسوردي سيغناليا

224
00:14:25,530 --> 00:14:26,540
!فيستام

225
00:14:27,590 --> 00:14:28,990
سأفجّر كلَّ طاقتي

226
00:14:29,390 --> 00:14:30,620
عليك بمُجاراتي

227
00:14:30,620 --> 00:14:32,130
مع من تتكلّم؟

228
00:15:06,110 --> 00:15:07,460
ماذا؟ ما هذا الصّوت؟

229
00:15:07,460 --> 00:15:08,840
!فوقنا! احذروا

230
00:15:13,930 --> 00:15:16,840
شـ-شكراً يا مولاتي

231
00:15:16,840 --> 00:15:18,180
لا عليكم

232
00:16:02,200 --> 00:16:03,710
أنا آسفة

233
00:16:04,500 --> 00:16:06,280
لا حاجة للاعتذار

234
00:16:12,600 --> 00:16:14,270
...ذلك السّيف

235
00:16:14,660 --> 00:16:16,770
إنّه سيف يُمزّق الرُّوح

236
00:16:17,290 --> 00:16:21,120
هكذا إذاً. سوف أختفي؟

237
00:16:21,550 --> 00:16:23,010
الإلَهة ميلديا

238
00:16:23,430 --> 00:16:26,960
كان ينبغي أن تؤمني به أكثر

239
00:16:28,120 --> 00:16:31,700
الرّجل الّذي اخترتِه وأحببتِه

240
00:16:31,700 --> 00:16:34,040
مُحال أن يكرهكِ بسبب ذلك

241
00:16:34,580 --> 00:16:37,970
لأنّه البطل

242
00:16:38,910 --> 00:16:43,120
هو... لم يكن حزيناً؟

243
00:16:43,470 --> 00:16:44,760
بالطّبع لا

244
00:16:46,930 --> 00:16:49,370
والآن نامي يا ميلديا

245
00:16:49,880 --> 00:16:55,360
،الإلَهة الجميلة الّتي تحبّ النّاس
وتُحَبّ بالمقابل

246
00:16:56,340 --> 00:16:58,970
شكراً لك يا فيلتول

247
00:17:00,280 --> 00:17:02,750
،وأيضاً يا هيزوكي

248
00:17:03,780 --> 00:17:05,230
أنا آسفة

249
00:17:11,000 --> 00:17:12,430
صباح الخير يا هيجيكي

250
00:17:12,950 --> 00:17:13,930
كيف حالكِ؟

251
00:17:15,640 --> 00:17:18,080
اسمي هيزوكي. أبله

252
00:17:23,420 --> 00:17:24,880
!فيلي

253
00:17:24,880 --> 00:17:26,440
!هل هيزوكي بخير؟

254
00:17:26,440 --> 00:17:27,240
إنّها بأمان

255
00:17:27,240 --> 00:17:27,970
كيف الوضع عندكِ؟

256
00:17:27,970 --> 00:17:29,700
جميعنا بأمان

257
00:17:29,700 --> 00:17:31,590
التقيتُ بماكينا للتو

258
00:17:31,590 --> 00:17:33,110
ماذا سنفعل الآن؟

259
00:17:33,110 --> 00:17:36,120
تبدو هذه المدينة من الآن على بُعد
ثوانٍ عن حرب

260
00:17:36,600 --> 00:17:38,370
لن أدع الأمور تصل إلى هنا

261
00:17:40,000 --> 00:17:42,980
ما زالت هناك أشياء يجب فعلها

262
00:17:46,770 --> 00:17:48,990
!تبّاً! ماذا كان ذلك؟

263
00:17:48,990 --> 00:17:51,420
!سكّان مدينة السّحر فعلوها الآن

264
00:17:51,420 --> 00:17:53,160
!لم نفعل شيئاً

265
00:17:53,160 --> 00:17:54,860
!لا نملك خياراً

266
00:17:53,380 --> 00:17:55,350
الأوامر إلى كافّة الوحدات، ابدؤوا

267
00:17:55,350 --> 00:17:57,510
!من كلا الطّرفين، ارموا أسلحتهم

268
00:18:00,630 --> 00:18:04,310
تلقّينا مرسوماً جديداً من ملِكة
!مدينة أكيهابارا الجديدة

269
00:18:04,620 --> 00:18:06,520
!أصغوا إليها باحترام

270
00:18:06,520 --> 00:18:07,850
هيزوكي-ساما؟

271
00:18:07,850 --> 00:18:08,740
من هي هذه؟

272
00:18:08,740 --> 00:18:10,030
ابنة الخوَنة

273
00:18:10,030 --> 00:18:11,630
ماذا يفعل شخصٌ من الخارج هنا؟

274
00:18:11,630 --> 00:18:13,090
!عودي إلى المنزل أيّتها الهجينة

275
00:18:13,090 --> 00:18:14,870
!تريدين أن تتأذّي؟

276
00:18:17,140 --> 00:18:20,480
!أنا هيزوكي رينارد-يامادا

277
00:18:20,980 --> 00:18:24,810
أنا رئيسة عشيرة رينارد، إحدى العائلات
العظيمة الثّلاثة الخاصّة بأكيهابارا

278
00:18:24,810 --> 00:18:26,580
والآن ملِكة مدينة أكيهابارا

279
00:18:27,350 --> 00:18:28,440
ما الّذي يجري هنا؟

280
00:18:28,440 --> 00:18:30,330
أتنصّبين نفسكِ ملِكة فجأة؟

281
00:18:30,330 --> 00:18:31,970
!لا أقبل بذلك

282
00:18:31,970 --> 00:18:34,920
بالإضافة إلى ذلك، لماذا لديك
!الرّيغاليا من الأساس؟

283
00:18:34,920 --> 00:18:37,640
!أنتِ من سحرَ تراتّي، أليس كذلك؟

284
00:18:37,640 --> 00:18:38,560
!هذا صحيح

285
00:18:38,560 --> 00:18:40,500
!كان كلّ ذلك من صنيعك

286
00:18:39,810 --> 00:18:41,580
...لستُ مقبولة

287
00:18:49,530 --> 00:18:55,070
قُتِل كورنيا سيبورد بواسطة شخص
مُتنكّر بهيئة تراتّي غوتيل

288
00:18:55,070 --> 00:18:59,870
نفس ذلك الشّخص قتلَ تراتّي أيضاً

289
00:19:00,180 --> 00:19:04,520
،هوجِمتُ أيضاً، لكن صديقي أنقذني

290
00:19:04,520 --> 00:19:06,450
واسترجعنا الرّيغاليا

291
00:19:06,870 --> 00:19:10,290
أتفهّم غضبكم وإرباككم

292
00:19:10,600 --> 00:19:14,760
لكن الآن بعد أن حصلتُ على
،على كلّ الرّيغاليا الثّلاثة

293
00:19:15,080 --> 00:19:18,830
!لديّ حاليّاً السّلطة الكاملة على أكيهابارا بكاملها

294
00:19:18,830 --> 00:19:20,000
!—هذا هُراء

295
00:19:20,000 --> 00:19:21,960
لا تُقاطعوا. ملكتنا تتكلّم

296
00:19:22,950 --> 00:19:24,260
تابعي من فضلكِ

297
00:19:26,150 --> 00:19:30,320
أختار تطبيق حقّي كملِكتكم

298
00:19:32,420 --> 00:19:36,180
أعلن هاهنا عن أنّ السّلطة الملكيّة
الّتي تنتمي للرّيغاليا

299
00:19:36,180 --> 00:19:37,790
!شاغرة كلّياً الآن

300
00:19:38,940 --> 00:19:43,100
اعتباراً من هذه اللّحظة، لا يوجد
!ملِك لمدينة أكيهابارا

301
00:19:43,400 --> 00:19:47,490
أترك أي إدارة للمدينة بعد الآن
لمجلس مدينة أكيهابارا

302
00:19:47,960 --> 00:19:49,000
!النّهاية

303
00:19:50,400 --> 00:19:51,580
مستحيل

304
00:19:51,580 --> 00:19:54,000
ماذا سنفعل من دون ملِك أو أي عائلة عظيمة؟

305
00:19:54,000 --> 00:19:55,250
المجلس؟

306
00:19:55,250 --> 00:19:57,290
!مجموعة العجائز عديمة الجدوى؟

307
00:19:57,290 --> 00:19:59,540
!لا أريد أن نترك مدينتنا بين أيديهم

308
00:20:01,000 --> 00:20:06,850
!تدبّروا أمركم بأنفسكم أيّها الحمقى

309
00:20:10,620 --> 00:20:12,680
!كنز

310
00:20:12,680 --> 00:20:14,690
!مرحى

311
00:20:14,690 --> 00:20:20,520
لا أصدّق بأنّكما كنتُما سيّد الشّياطين
!فيلتول وماكينا اللّهب المُتوهِّج

312
00:20:16,210 --> 00:20:17,320
...هيزوكي

313
00:20:17,320 --> 00:20:19,780
!هذا يُدغدغ

314
00:20:20,520 --> 00:20:22,490
ماذا؟ هذا غريب؟

315
00:20:20,770 --> 00:20:22,790
لكن تاكاهاشي تبقى تاكاهاشي

316
00:20:23,140 --> 00:20:25,180
!ماذا؟

317
00:20:25,180 --> 00:20:28,750
!لعبتُ دوري من وراء الكواليس أيضاً

318
00:20:28,750 --> 00:20:30,600
أعلم

319
00:20:30,600 --> 00:20:31,530
شكراً

320
00:20:31,530 --> 00:20:32,440
!جيّد

321
00:20:32,440 --> 00:20:33,680
هذا هو

322
00:20:32,440 --> 00:20:34,510
بالمناسبة، ما هذا الّذي لديك هناك؟

323
00:20:33,680 --> 00:20:36,560
أجل. هذه المانا تبعث على الحنين

324
00:20:34,510 --> 00:20:36,030
لا أعلم

325
00:20:38,040 --> 00:20:40,010
سيلوالد التنّين الأسود

326
00:20:40,010 --> 00:20:42,030
وماي العلياء الحزينة

327
00:20:42,400 --> 00:20:46,210
القدرة على التأكُّد بأنّهما على قيد
الحياة هي مكسب غير مُتوقَّع

328
00:20:46,210 --> 00:20:47,280
أجل

329
00:20:47,280 --> 00:20:52,390
كان ذلك مُجزياً جدّاً بما أنّنا أيضاً خضنا
تجربة العيش كتلاميذ مدرسة ثانويّة

330
00:20:52,390 --> 00:20:53,320
أجل

331
00:20:55,260 --> 00:20:57,140
!مرحباً، مرحباً

332
00:20:57,140 --> 00:20:58,680
!عذراً على الدّخول فجأة

333
00:21:01,250 --> 00:21:02,800
ماذا؟

334
00:21:02,800 --> 00:21:05,790
يليق بكِ هذا الزيّ الرّسميّ يا هيجيكي

335
00:21:05,790 --> 00:21:07,760
شـ-شكراً

336
00:21:08,190 --> 00:21:09,660
وأيضاً، اسمي هيزوكي

337
00:21:09,660 --> 00:21:12,330
حسناً، لماذا استدعيتنا إلى هنا؟

338
00:21:12,330 --> 00:21:14,540
للاحتفال بالانتقال إلى مدرسة جديدة

339
00:21:14,540 --> 00:21:16,810
!ولنِزال انتقام

340
00:21:19,310 --> 00:21:22,000
تاكاهاشي، ماذا يُفترض أن يكون هذا؟

341
00:21:20,180 --> 00:21:21,470
خسارة حقيقيّة؟

342
00:21:22,730 --> 00:21:24,420
لستَ ندّاً إطلاقاً

343
00:21:23,390 --> 00:21:25,210
!كم أنا مرتاحة

344
00:21:24,420 --> 00:21:26,950
!سأقلب النّتيجة

345
00:21:26,950 --> 00:21:29,460
كيف الأمور في مدرستكِ الجديدة؟

346
00:21:29,460 --> 00:21:31,980
أكثر رحة بكثير من من مدرستي السّابقة

347
00:21:31,980 --> 00:21:33,440
تاكاهاشي موجودة أيضاً

348
00:21:33,790 --> 00:21:37,010
لكن اشتهرتُ قليلاً بعد ذلك الخِطاب

349
00:21:37,420 --> 00:21:40,540
بفضل ذلك، ارتفع عدد مُشتركيّي أيضاً

350
00:21:40,540 --> 00:21:43,200
لكن بعضهم بدؤوا بإشعال فتيل الحرب

351
00:21:47,570 --> 00:21:48,830
شكراً لك

352
00:21:49,890 --> 00:21:51,180
فيلتول

353
00:21:52,850 --> 00:21:55,260
شكراً على مُسامحتي

354
00:21:57,240 --> 00:21:58,460
من الطبيعيّ أن أفعل

355
00:22:00,620 --> 00:22:02,040
هيزوكي

356
00:22:02,270 --> 00:22:04,770
النّهائيّ. ضدّ ماكينا

357
00:22:04,770 --> 00:22:07,290
!حسناً! أنا مُتشوّقة لذلك

358
00:22:07,290 --> 00:22:09,850
!سأثأر لفيلتول-ساما

359
00:22:09,850 --> 00:22:11,510
!أعتمد عليكِ يا ماكينا

360
00:22:11,510 --> 00:22:12,580
!اعتمد عليّ

361
00:22:12,580 --> 00:22:16,090
بالمناسبة يا فيلي، لدينا نِزال
لتحديد المركز الأخير

362
00:22:16,620 --> 00:22:17,900
!لا مانع لديّ

363
00:22:17,900 --> 00:22:24,190
مساء الزّائلين! كيف يتعامل معكم ألم
الحياة أنتم الزّائلين اليوم؟

364
00:22:24,640 --> 00:22:30,580
!هذا أنا، ملك الشّياطين فيلتول فيلفيت فيلسفالت