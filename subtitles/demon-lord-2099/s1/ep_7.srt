!لماذا؟

195
00:14:06,680 --> 00:14:09,030
لماذا أنت متفاجئ؟

196
00:14:09,390 --> 00:14:15,040
أنا أفعل الشّيء ذاته الّذي فعلتَه قبل قليل
عندما ألغيت تعويذاتي

197
00:14:15,040 --> 00:14:15,860
ماذا؟

198
00:14:16,560 --> 00:14:18,510
!ماركوس

199
00:14:18,510 --> 00:14:23,320
علّقت من قبل بأنّني أبطأ بخطوتين

200
00:14:23,850 --> 00:14:25,100
!ماذا؟

201
00:14:25,810 --> 00:14:28,680
لذا اسمح لي أن أردّ الجميل

202
00:14:28,680 --> 00:14:32,740
!أنت أبطأ بخطوة يا ماركوس

203
00:14:32,740 --> 00:14:35,970
!هـ-هذا مستحيل

204
00:14:36,630 --> 00:14:38,930
!سـ-سحر بلا نداء؟

205
00:14:38,930 --> 00:14:40,410
!بالفعل

206
00:14:41,160 --> 00:14:42,650
!هذا مستحيل

207
00:14:43,110 --> 00:14:44,890
!هذا غير ممكن

208
00:14:44,890 --> 00:14:49,190
هذا مجال حتّى التّقنيّة السّحريّة الحديثة
!لم تكن قادرة على بلوغه

209
00:14:49,190 --> 00:14:54,110
كيف استطعت تنشيط سحر
!من دون ترتيل أو نِداء؟

210
00:14:54,500 --> 00:14:56,510
إنّ تبنّي هذا الشّكل

211
00:14:56,510 --> 00:14:59,070
،سمح لي بنسخ وظائف الفاميليا

212
00:14:59,070 --> 00:15:04,390
وإطلاق السّحر باستخدام نفس
التّركيبة الّتي بداخلي

213
00:15:05,590 --> 00:15:09,820
لحسن الحظّ، لا ينقصنا الإيثر في هذا المكان

214
00:15:09,820 --> 00:15:11,050
،ما يعني

215
00:15:11,050 --> 00:15:14,040
يمكنني استخدام السّحر قدرما وكيفما أشاء

216
00:15:14,730 --> 00:15:18,770
!يعزو كلّ الفضل لك يا ماركوس

217
00:15:18,770 --> 00:15:19,780
ماذا؟

218
00:15:20,020 --> 00:15:23,490
أنت الّذي دفع بتقدُّم التّكنولوجيا
السّحريّة في هذا العالم

219
00:15:23,490 --> 00:15:26,450
في مسعاك بالحلول مكاني كسيّد شياطين

220
00:15:26,450 --> 00:15:29,040
الفضل لهذا التقدُّم

221
00:15:29,040 --> 00:15:34,500
في قدرتي الآن على بلوغ مستويات
جديدة من سحر اللّا نِداء

222
00:15:34,990 --> 00:15:39,580
أبليتَ بلاء ممتازاً لأجلي في السّنوات
الخمسمئة الماضية

223
00:15:40,090 --> 00:15:43,000
أقدّم لك أسمى عِبارات المديح يا ماركوس

224
00:15:43,440 --> 00:15:45,160
!ينبغي أن يكون هذا مستحيلاً

225
00:15:45,160 --> 00:15:49,480
!لا ينبغي أن تتمكّن من هزيمتي بلا فاميليا

226
00:15:49,840 --> 00:15:51,570
!سيف الدّماء

227
00:15:58,050 --> 00:16:08,850
!سيف الدّماء

228
00:16:13,810 --> 00:16:15,440
!لماذا؟

229
00:16:15,900 --> 00:16:18,960
!كيف؟

230
00:16:20,030 --> 00:16:21,340
...أنا

231
00:16:21,340 --> 00:16:23,140
!تفوّقتُ عليك

232
00:16:23,140 --> 00:16:27,320
!أنا أعظم بكثير من أن أخدم شخصاً مثلك

233
00:16:27,320 --> 00:16:31,260
!أنا من يجب أن يكون سيّد الشّياطين

234
00:16:32,470 --> 00:16:36,350
أمسى صراخك مُزعجاً

235
00:16:36,350 --> 00:16:38,100
اصمت قليلاً

236
00:16:38,100 --> 00:16:40,840
!فيلتول

237
00:17:00,680 --> 00:17:05,490
إنّ استخدام السّحر من دون نِداء
يفتقر للأناقة حقّاً

238
00:17:05,490 --> 00:17:07,470
لنُجرّب نهجاً آخر

239
00:17:11,470 --> 00:17:12,950
!ما هذا؟

240
00:17:12,950 --> 00:17:16,390
!توقّف

241
00:17:13,960 --> 00:17:14,980
!لا تلمسني

242
00:17:17,180 --> 00:17:19,390
،وفقاً لصديقتي

243
00:17:19,390 --> 00:17:22,070
"يُدعى هذا بـ"الرّجل الضّاحك

244
00:17:22,440 --> 00:17:25,050
يخترق فاميليا الهدف

245
00:17:25,050 --> 00:17:27,270
ويستولي على وعيه

246
00:17:28,480 --> 00:17:29,830
ما رأيك؟

247
00:17:29,830 --> 00:17:32,110
،إنّه ليس وهماً نُسِج من خلال السّحر

248
00:17:32,320 --> 00:17:35,990
إنّما صورة مُزيّفة تمّ إسقاطها
بشكل مُباشر في دماغك

249
00:17:36,390 --> 00:17:37,980
!واقعيّة، أليس كذلك؟

250
00:17:38,260 --> 00:17:43,440
أتقصد بأنّك اخترقتَ حاجزَ المنطق
!المُتعلّق بالفاميليا المُتقدّمة خاصّتي؟

251
00:17:45,130 --> 00:17:46,810
!توقّف

252
00:17:47,410 --> 00:17:49,580
!توقّف فحسب

253
00:17:52,540 --> 00:17:53,880
!هذا مُسلٍّ

254
00:17:53,880 --> 00:17:55,970
!هذا مُسلٍّ حقّاً يا ماركوس

255
00:17:55,970 --> 00:17:57,860
!استمرّ في ذلك

256
00:17:57,860 --> 00:18:00,160
أنت مُضحك جدّاً

257
00:18:00,160 --> 00:18:04,050
!لدرجة أنّني قد أنسى كلّ هذا وأغيّر رأيي

258
00:18:04,300 --> 00:18:07,040
!أرجوك أوقف ذلك! أتوسّل إليك

259
00:18:07,040 --> 00:18:09,130
!سأنضمّ إلى قوّاتك من جديد

260
00:18:09,130 --> 00:18:11,770
!لذا أظهِر الرّحمة أرجوك

261
00:18:12,030 --> 00:18:14,540
أخبرتُك سلفاً

262
00:18:14,540 --> 00:18:16,670
!لن تكون هناك مرّة ثالثة

263
00:18:25,850 --> 00:18:27,030
!مستحيل

264
00:18:27,030 --> 00:18:29,640
!هل تنوي أن تجعل منّي حطباً؟

265
00:18:29,640 --> 00:18:31,040
أجل

266
00:18:31,040 --> 00:18:33,170
!ما الفائدة الّتي ستجنيها من ذلك؟

267
00:18:33,710 --> 00:18:36,620
تزويد الفرن الخالد بحياتك الخائنة

268
00:18:36,620 --> 00:18:39,460
ينبغي أن تضمن استمراريّة عمله

269
00:18:39,460 --> 00:18:42,440
وتحافظ على هذا المكان فترة أطول، صحيح؟

270
00:18:42,440 --> 00:18:47,900
لذا يجدر بك أن تصبح حجر
أساس هذه المدينة وأنت فخور

271
00:18:47,900 --> 00:18:51,960
كان هذا الفرن نافعاً حقّاً

272
00:18:51,960 --> 00:18:54,220
سيكون من الخسارة تدميره

273
00:18:54,220 --> 00:18:57,060
!ما تفعله لا يختلف عمّا كنتُ أفعله

274
00:18:57,060 --> 00:18:59,370
!أنت ترمي ببني جلدتك كحطب

275
00:18:59,370 --> 00:19:02,580
!هل أنت راضٍ عن تصرّف شنيع كهذا؟

276
00:19:02,820 --> 00:19:04,270
أيّها الأحمق

277
00:19:04,620 --> 00:19:07,810
هل جعلَتْك القرون الخمسة الماضية خرِفاً؟

278
00:19:07,810 --> 00:19:14,290
،أنا جالب الظّلام، سيّد الشّياطين
!فيلتول فيلفيت فيلسفالت

279
00:19:14,290 --> 00:19:18,050
!الأفعال الشّنيعة أساسيّة بالنّسبة لي

280
00:19:18,350 --> 00:19:21,320
!أنت لا تعرف شيئاً عن هذا العالم

281
00:19:21,320 --> 00:19:24,770
!لا تعلم حتّى حقيقة سبب وصوله إلى هنا

282
00:19:24,770 --> 00:19:28,470
لا تفهم حتّى بأنّ هذا كان
!الخيار الوحيد الّذي لديّ

283
00:19:29,350 --> 00:19:31,840
!فلتمُت

284
00:19:31,840 --> 00:19:34,780
!من دماء إلى انفجار

285
00:19:45,570 --> 00:19:49,710
هل أنت راضٍ عن كون هذه
آخر مُحاولة عصيان منك؟

286
00:19:50,080 --> 00:19:57,600
قبلتُ بذُعرك المُثير للشّفقة
!كآخر عطاياك إليّ

287
00:19:57,600 --> 00:19:59,130
لن أنسى هذا

288
00:19:59,620 --> 00:20:01,460
!انتظر

289
00:20:01,460 --> 00:20:02,700
!انتظر، انتظر، انتظر

290
00:20:02,700 --> 00:20:05,430
!توقّف

291
00:20:05,430 --> 00:20:07,400
!أنت! أنت! أنت

292
00:20:06,100 --> 00:20:07,400
الوداع

293
00:20:08,230 --> 00:20:10,630
!لا! لا أريد أن أموت

294
00:20:10,630 --> 00:20:15,330
!لا

295
00:20:33,220 --> 00:20:34,860
ماركوس

296
00:20:34,860 --> 00:20:37,100
لنلتقِ ثانية بعد الميتينويل خاصّتك

297
00:20:48,270 --> 00:20:51,470
هل أخافكِ مظهري يا ماكينا؟

298
00:20:51,900 --> 00:20:52,740
أجل

299
00:20:53,380 --> 00:20:58,230
كنتَ تجسيداً للرّعب. وهذا يلائم سيّد شياطين

300
00:21:03,930 --> 00:21:06,640
بصيص أمل الحياة؟

301
00:21:08,880 --> 00:21:10,430
فيلتول-ساما؟

302
00:21:11,860 --> 00:21:13,540
كنتُ ضعيفاً

303
00:21:14,080 --> 00:21:17,220
لكن لأنّني كنتُ ضعيفاً، استطعتُ
رؤية بصيص أمل الحياة

304
00:21:18,230 --> 00:21:21,790
في الخالدين وفيكِ

305
00:21:22,780 --> 00:21:25,790
لهذا انتصرتُ هذه المرّة

306
00:21:27,090 --> 00:21:28,740
هكذا إذاً

307
00:21:29,830 --> 00:21:30,820
...لهذا السّبب

308
00:21:39,460 --> 00:21:42,760
كان هذا كلّ ما في الأمر يا ماكينا

309
00:21:54,310 --> 00:21:55,530
أحبّكِ

310
00:21:57,670 --> 00:22:02,570
أحبّك أيضاً يا فيلتول-ساما

311
00:23:35,810 --> 00:23:40,010
"المدينة السّحريّة السّيبرانيّة أكيهابارا"