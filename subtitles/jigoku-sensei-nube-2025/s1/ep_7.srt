1
00:00:08,510 --> 00:00:10,970
الجو هنا بارد جدًا

2
00:00:11,050 --> 00:00:13,600
هل ضبطوا المكيّف على برودة عالية؟

3
00:00:22,860 --> 00:00:24,320
...أستاذ نوينو

4
00:00:31,870 --> 00:00:36,410
معلم الجحيم

5
00:02:05,380 --> 00:02:07,040
الصف 3-5

6
00:02:07,130 --> 00:02:11,420
ولهذا فإن حظي يتحسن أكثر فأكثر

7
00:02:11,510 --> 00:02:12,800
...إذن ينبغي أنْ

8
00:02:15,550 --> 00:02:16,550
...أليسَ هذا

9
00:02:21,640 --> 00:02:23,440
لِمَ؟

10
00:02:24,770 --> 00:02:26,060
الثلج يَتَساقطُ؟

11
00:02:26,150 --> 00:02:26,960
مُذهل

12
00:02:27,260 --> 00:02:28,110
واه

13
00:02:34,030 --> 00:02:35,240
يبدو أنّ الثلج سيتكدّس

14
00:02:35,320 --> 00:02:36,780
!هذا طقس غير مألوف

15
00:02:36,870 --> 00:02:38,450
كيفَ يُمكن أنْ يَتساقطَ الثَّلجُ في هذا الوقت من السنة؟

16
00:02:39,950 --> 00:02:43,540
لا تَقولوا إنَّ هذا
بسببِ يوكاي آخَر؟

17
00:02:45,290 --> 00:02:47,840
يا نوبي، هل تَشعُرُ بشَيء؟

18
00:02:49,750 --> 00:02:50,840
نوبي؟

19
00:02:51,920 --> 00:02:53,840
!يا نوبي

20
00:02:54,630 --> 00:02:56,640
ما الَّذي يَجعَلُكَ تَبتَسِمُ كالأبله؟

21
00:02:57,590 --> 00:02:58,600
...هُناك أمر ما

22
00:02:59,350 --> 00:03:01,720
الثلج يعيد إليّ ذكريات جميلة

23
00:03:01,810 --> 00:03:04,600
أتساءلُ إن كانتْ تِلكَ الفتاةُ بخَير؟

24
00:03:05,480 --> 00:03:07,270
ما الَّذي يَجعَلهُ شاردَ الذِّهن؟

25
00:03:07,350 --> 00:03:08,610
فعلًا

26
00:03:08,690 --> 00:03:11,360
رُبَّما يُفكِّرُ في المعلمةِ ريتسوكو؟

27
00:03:12,280 --> 00:03:14,110
،على ذكر المعلمةِ رِيتسوكو

28
00:03:14,190 --> 00:03:17,870
أردتُ أنْ أُخبِرَكَ بحَظِّكَ لِأنَّكَ لا تُحرزُ تقدُّمًا معها

29
00:03:17,950 --> 00:03:19,870
موسوعةُ التَّنجيمِ

30
00:03:18,740 --> 00:03:19,870
!انظر

31
00:03:19,950 --> 00:03:24,160
تَوافُقُ الميلادِ في التَّنجيمِ

32
00:03:19,950 --> 00:03:24,160
،لنَرَ، وُلِدَ نوبي في 21 يوليو

33
00:03:24,250 --> 00:03:27,580
ووُلِدَتْ المعلمةِ رِيتسوكو في 2 أكتوبر

34
00:03:27,670 --> 00:03:29,630
...إذن تَوافُقُكما هو

35
00:03:29,710 --> 00:03:31,040
!الأفضل أنْ تَستَسلِم

36
00:03:31,130 --> 00:03:33,090
ماذا؟

37
00:03:33,170 --> 00:03:35,840
فلنَرَ متى
سَتصبِحُ شَعبِيًّا بينَ النِّساء

38
00:03:35,920 --> 00:03:37,510
...سيكونُ ذلكَ

39
00:03:38,550 --> 00:03:39,900
!بالتَّحديدِ في العصرِ الطَّباشيري

40
00:03:40,080 --> 00:03:40,760
!ما هذا بالضبط؟

41
00:03:40,850 --> 00:03:43,270
حسنًا، فلنُجرِّب توقُّعاتِ الجاذِبية

42
00:03:43,350 --> 00:03:46,980
...مستوى جاذِبيَّتِكَ هو

43
00:03:47,770 --> 00:03:49,810
بِقَدرِ ثلاثِ عُودِ بَخورٍ مُطفأ

44
00:03:49,900 --> 00:03:50,900
ما الذي يعنيهِ هذا؟

45
00:03:51,480 --> 00:03:54,150
حسنًا، ماذا عن تَجربةِ التَّاروت؟

46
00:03:57,360 --> 00:03:59,160
!لا أفهم أيًا من هذا

47
00:04:00,620 --> 00:04:02,580
مَن كان يَظنُّ أنَّهُ سيكونُ سَيِّئًا إلى هذا الحَد؟

48
00:04:02,660 --> 00:04:04,160
هذا مُذهِلٌ فعلًا

49
00:04:04,240 --> 00:04:06,710
مهلًا يا نوبي

50
00:04:06,790 --> 00:04:09,420
ألم يَقل لكَ أحَدٌ مِن قبلُ إنَّهُ يُحبُّك؟

51
00:04:10,540 --> 00:04:11,630
لحظة يا ميكي

52
00:04:11,710 --> 00:04:15,510
هُناكَ أشياءُ لا ينبغي قولُها، ولو كانتْ حقيقيَّة

53
00:04:15,590 --> 00:04:16,720
بالضَّبط

54
00:04:16,800 --> 00:04:20,680
"!حتى لو لم يُحبَّه أحَد، فلا بُدَّ أنَّ أحدًا قال له: "لنبقَ أصدقاء

55
00:04:20,760 --> 00:04:22,890
"قولُ "لنبقَ أصدقاء

56
00:04:22,970 --> 00:04:25,970
يعني أنَّها تَرى استِحالةَ أنْ يَكونا أصدقاءَ أصلًا

57
00:04:26,060 --> 00:04:27,810
!توقفوا عن هذا

58
00:04:28,600 --> 00:04:29,940
عُذرًا

59
00:04:38,200 --> 00:04:41,320
مَرَّ وقتٌ طويل على لقائنا يا أستاذ نوينو

60
00:04:41,950 --> 00:04:44,200
من أنتِ؟

61
00:04:46,290 --> 00:04:48,620
إنها أنا يوكيمي، خطيبتُكَ

62
00:04:50,540 --> 00:04:51,710
خطيبتُك؟

63
00:04:53,290 --> 00:04:54,590
!لقد اشتَقتُ إليكَ كثيرًا

64
00:04:54,670 --> 00:04:57,590
قالتْ إنَّها خَطيبةُ نوبي

65
00:04:57,670 --> 00:04:59,970
ما هيَ "الخَطيبة"؟ هل هو شيء يؤكل؟

66
00:05:00,050 --> 00:05:02,590
كم أنتَ أحمق
المعنى أنَّهما مُخطوبان

67
00:05:02,680 --> 00:05:05,350
قد يكونُ هذا إنذارًا
بكارثةٍ طبيعيَّة

68
00:05:05,430 --> 00:05:07,810
إذًا لهذا يَتساقطُ الثَّلج

69
00:05:07,890 --> 00:05:09,850
لن أستَغرِبَ إذا بَدأ مَطَرُ من الرماحِ

70
00:05:09,940 --> 00:05:11,770
حقًّا؟

71
00:05:11,850 --> 00:05:14,360
هل أنتِ حقًا يوكيمي تلك؟

72
00:05:14,940 --> 00:05:18,360
نعم. لقد التقَينا قبلَ خمسِ سنواتٍ
في منتجعِ التَّزلُّجِ ذاك

73
00:05:18,940 --> 00:05:20,820
حُبٌّ بدأ في مُنتَجعِ تَزلُّج؟

74
00:05:20,900 --> 00:05:23,370
إنَّهُ "سِحرُ المُنحدَر" إذًا؟

75
00:05:24,120 --> 00:05:25,870
ألا تُصدِّقُني؟

76
00:05:26,370 --> 00:05:27,740
إذًا

77
00:05:28,370 --> 00:05:30,370
سَأُثبِتُ لكَ

78
00:05:35,580 --> 00:05:37,210
بارد. لحظة؟ لقد تَجمَّد

79
00:05:37,300 --> 00:05:38,510
كيفَ حَدَثَ هذا؟

80
00:05:39,800 --> 00:05:40,840
ما الأمر؟

81
00:05:40,920 --> 00:05:42,010
ما الذي حدث؟

82
00:05:42,590 --> 00:05:44,720
رأيت؟ هل تُصدِّقُني الآن؟

83
00:05:44,800 --> 00:05:46,600
فلنَتحدَّث في الخارج

84
00:05:47,350 --> 00:05:49,020
نوبي، إلى أين تذهب؟

85
00:05:49,100 --> 00:05:51,480
بالتأكيد في موعد غرامي

86
00:05:52,020 --> 00:05:53,190
مَوعِد؟

87
00:05:56,110 --> 00:05:58,400
مُنتزَهُ دُومُوري الثَّالِث

88
00:05:58,480 --> 00:06:01,030
ما الَّذي جَعلكِ
تأتينَ إلى هُنا فجأة؟

89
00:06:02,490 --> 00:06:05,030
عجبًا. ليس فجأةً

90
00:06:06,620 --> 00:06:10,540
ألم أُعطِكَ وعدًا
قبلَ خمسِ سنوات؟

91
00:06:11,160 --> 00:06:13,670
أنَّني سآتي لأجِدَكَ بالتَّأكيد

92
00:06:14,250 --> 00:06:17,880
وأنَّني سأُحِبُّكَ إلى الأبد

93
00:06:24,260 --> 00:06:26,720
،والآن بعدَ أنِ اجتَمَعنا أخيرًا

94
00:06:26,800 --> 00:06:28,180
فلنَذهَب في مَوعِد

95
00:06:32,180 --> 00:06:34,690
هل أنتِ جادَّةٌ في الزَّواجِ بي؟

96
00:06:35,350 --> 00:06:37,360
أنتِ لستِ بَشريَّة

97
00:06:37,440 --> 00:06:38,610
هذا مُستحيل

98
00:06:39,360 --> 00:06:42,690
يا أستاذ،  إلى أينَ سَتأخُذُني؟

99
00:06:44,400 --> 00:06:46,280
يَجِب أن أُعيدَها
إلى الجِبال

100
00:06:46,780 --> 00:06:48,620
سوكياكي بلحم البقر والتوفو

101
00:06:46,780 --> 00:06:48,620
غير أنني متردّد في ذلك

102
00:06:48,700 --> 00:06:52,000
،إنَّها تَكرَهُ الحَرارة
فسَأستَغلُّ هذا لِتستَسلِم

103
00:06:52,750 --> 00:06:55,830
هيا، كُلي. لا بُدَّ أنَّكِ جائِعةٌ
بعدَ رحلتِكِ الطَّويلة

104
00:06:55,920 --> 00:06:57,250
كُلي ما شِئتِ

105
00:06:57,840 --> 00:07:00,750
إنَّهُ حارٌّ قليلًا، أليسَ كذلك؟

106
00:07:00,840 --> 00:07:02,380
نعم، إنَّهُ كذلك

107
00:07:02,460 --> 00:07:06,010
البشرُ يأكُلون طَعامًا حارًّا كهذا كُلَّ يوم

108
00:07:06,090 --> 00:07:09,760
إن لم تستطيعي أكل هذا، فلن تتمكني أبدًا من العيش مع البشر

109
00:07:09,850 --> 00:07:11,350
هكذا إذاً

110
00:07:12,100 --> 00:07:13,270
فهمت

111
00:07:19,400 --> 00:07:20,820
شُكرًا على الطَّعام

112
00:07:23,530 --> 00:07:26,110
إنَّهُ لذيذٌ حقًّا

113
00:07:26,200 --> 00:07:28,490
ألن تأكل؟

114
00:07:29,030 --> 00:07:31,240
كلا، لن أفعل

115
00:07:31,740 --> 00:07:32,740
ساونا و حمام دوموري الساخن

116
00:07:32,830 --> 00:07:33,480
الجو بارد

117
00:07:33,700 --> 00:07:34,660
آه، يا لَهُ من انتعاش

118
00:07:35,870 --> 00:07:38,250
حسنًا، لنُهيِّئ أجسامنا

119
00:07:39,040 --> 00:07:40,170
نُهيِّئ أجسامنا؟

120
00:07:40,250 --> 00:07:41,420
أجل

121
00:07:41,500 --> 00:07:43,800
البَشرُ يَحتاجونَ الذهاب
إلى السَّاونا لِتحسينِ دَورةِ دِمائِهم

122
00:07:44,300 --> 00:07:47,090
وتَوازُنِ أَذهانِهم وأبدانِهم

123
00:07:47,590 --> 00:07:48,680
أتَستَطيعينَ فِعلَ ذلك؟

124
00:07:59,400 --> 00:08:02,570
عُذرًا. أيمكنُني استِعارةُ هذا؟

125
00:08:02,650 --> 00:08:04,440
هاه؟ أكيد

126
00:08:07,530 --> 00:08:08,040
!آه

127
00:08:08,260 --> 00:08:08,950
ما الأمر؟

128
00:08:10,030 --> 00:08:12,080
عجبًا، ما الخطب؟

129
00:08:15,160 --> 00:08:16,830
!أجل

130
00:08:18,500 --> 00:08:20,250
!أجل

131
00:08:28,180 --> 00:08:29,180
ماذا؟

132
00:08:29,260 --> 00:08:31,180
!أجل

133
00:08:35,720 --> 00:08:37,180
إلى أينَ نَذهَبُ تالِيًا؟

134
00:08:37,270 --> 00:08:39,690
المسبح؟ صالون التسمير؟

135
00:08:40,940 --> 00:08:43,400
دِفاعاتُها
أعلى مِمَّا توقَّعتُ

136
00:08:43,480 --> 00:08:46,150
...وفَوقَ هذا، راتبي هذا الشَّهر

137
00:08:47,150 --> 00:08:48,400
لحظة، هل أنتِ بخير؟

138
00:08:48,660 --> 00:08:49,180
ساعدني

139
00:08:49,500 --> 00:08:50,110
حسنًا

140
00:08:50,200 --> 00:08:50,680
جاهز؟

141
00:08:50,930 --> 00:08:51,410
...واحد، اثنان

142
00:08:51,490 --> 00:08:53,660
...إنَّهُ لا يَتحرَّك

143
00:08:54,160 --> 00:08:55,410
ادفع بقُوَّةٍ أكبر

144
00:08:56,160 --> 00:08:57,580
الوَضعُ يُصبِحُ سيِّئًا

145
00:09:02,840 --> 00:09:04,590
يا أستاذ، اُنظُر إلى هذا

146
00:09:05,170 --> 00:09:07,840
لقد صَنَعتُ رجلَ ثَلج

147
00:09:10,430 --> 00:09:14,430
ماذا لو أنهى المَوعِدَ
بتقدمهِ للزواج؟

148
00:09:14,510 --> 00:09:17,350
إذًا سنكونُ أوَّلَ مَن يُشاهِدُ
تلك اللَّحظةَ السِّحريَّة

149
00:09:17,430 --> 00:09:19,850
مهلًا، فلنعُد إلى المنزل

150
00:09:19,940 --> 00:09:21,850
البرد شديد، ولا أستطيع التحمل

151
00:09:22,480 --> 00:09:25,860
يا يوكيمي، إنكِ تبالغين في تقديري

152
00:09:25,940 --> 00:09:28,650
فأنا لستُ رَجُلًا جيِّدًا إلى هذا الحَدِّ

153
00:09:28,740 --> 00:09:31,860
،لا أَكسَبُ المال
ولستُ شَعبِيًّا بينَ النِّساء

154
00:09:33,160 --> 00:09:36,080
النساء البشريات لا يُجِدن تقييم الرجال

155
00:09:36,160 --> 00:09:39,790
فأنا أَعلَمُ كم أنتَ رائِع

156
00:09:50,920 --> 00:09:53,430
يبدو أنني انحرفت عن المسار

157
00:10:00,310 --> 00:10:01,940
وفَوقَ ذلك، الرُّؤيةُ

158
00:10:03,150 --> 00:10:05,020
سيِّئةٌ جِدًّا

159
00:10:06,190 --> 00:10:08,440
لا تَقُل إنَّ هذه العاصِفةَ الثَّلجِيَّة

160
00:10:08,530 --> 00:10:10,400
بسببِ يوكاي

161
00:10:25,920 --> 00:10:27,170
!توقَّف

162
00:10:29,760 --> 00:10:32,420
توقَّف، ماذا تَفعل؟

163
00:10:33,090 --> 00:10:34,130
اتركني

164
00:10:34,220 --> 00:10:36,430
تلك ليست بشرية بل يوكينكو

165
00:10:37,100 --> 00:10:40,310
لأجيالٍ، كانَتِ اليوكينكو
تُهدِّدُ حَياتَنا

166
00:10:40,390 --> 00:10:44,350
بِإحداثِ عواصِفَ ثَلجِيَّةٍ تُعزِلُ قَريَتَنا

167
00:10:44,440 --> 00:10:46,560
،ولو اقتَصر الأمرُ على هذا لكانَ جيِّدًا

168
00:10:46,650 --> 00:10:49,820
لكنَّ اليوكينكو ستصبحُ
يوكي أونا يومًا ما

169
00:10:49,900 --> 00:10:51,690
واليوكي أونا يوكاي مُروِّع

170
00:10:52,360 --> 00:10:54,700
تُحوِّلُ كُلَّ رَجُلٍ تُحبُّه

171
00:10:55,280 --> 00:10:57,660
!إلى ثَلجٍ وتَقتُلُه

172
00:10:58,160 --> 00:11:01,160
لهذا يَجبُ أنْ تُطلِقَ النَّارَ
على أي يوكينكو تُصادِفُه

173
00:11:01,250 --> 00:11:03,290
!هذا هو قانونُ قَريَتِنا منذ الأزل

174
00:11:03,370 --> 00:11:05,620
!لكن لا داعيَ لقتلِها

175
00:11:05,710 --> 00:11:07,040
!أنظُر

176
00:11:20,350 --> 00:11:21,350
...أيها

177
00:11:37,700 --> 00:11:39,950
سماء شاسعة وبحار مترامية
،نظرة تبرد القلوب وقلب يشفيها

178
00:11:40,030 --> 00:11:42,330
،ومع صدى عويل الملعونين
فلتختفِ آثارهم

179
00:11:42,410 --> 00:11:44,410
سماء شاسعة وبحار مترامية
،نظرة تبرد القلوب وقلب يشفيها

180
00:11:44,500 --> 00:11:46,920
،ومع صدى عويل الملعونين
فلتختفِ آثارهم

181
00:11:47,000 --> 00:11:49,290
سماء شاسعة وبحار مترامية
،نظرة تبرد القلوب وقلب يشفيها

182
00:11:49,380 --> 00:11:52,500
،ومع صدى عويل الملعونين
فلتختفِ آثارهم

183
00:12:06,350 --> 00:12:08,100
لا داعيَ للخَوف

184
00:12:08,190 --> 00:12:10,020
لن أَقتُلَكِ

185
00:12:13,440 --> 00:12:15,780
ألا تشعرُ بالبردِ؟

186
00:12:16,450 --> 00:12:18,280
أنا بخَير. أنظُري؟

187
00:12:18,360 --> 00:12:20,870
لديَّ كُلُّ هذه اللَّواصِقِ الحارَّة
لذلك أنا بخير

188
00:12:27,250 --> 00:12:29,460
حسنًا، لا داعيَ للقلقِ علَيَّ

189
00:12:30,420 --> 00:12:32,460
اسمي نوينو وأنتِ؟

190
00:12:32,960 --> 00:12:33,960
يوكيمي

191
00:12:34,050 --> 00:12:35,460
اسمُكِ يوكيمي، هاه؟

192
00:12:35,550 --> 00:12:39,050
أظن أنّ عمركِ يقارب عمرَ تلميذٍ في الصف الخامس
بحساب سنوات البشر

193
00:12:39,720 --> 00:12:41,760
هل أنت من أهل القرية؟

194
00:12:42,260 --> 00:12:43,260
كلا

195
00:12:43,350 --> 00:12:45,310
أنا طالب جامعي، جئت لأزور منتجع التزلج

196
00:12:46,060 --> 00:12:48,060
طالب جامعي؟

197
00:12:48,640 --> 00:12:52,310
نعم. لكنني سأصبح
أستاذ مدرسة ابتدائية يومًا ما

198
00:12:53,070 --> 00:12:54,440
أستاذ؟

199
00:12:55,730 --> 00:12:58,200
لأنني أريد حماية الأطفال

200
00:12:59,780 --> 00:13:03,280
أريد مساعدة الأطفال الذين يعانون
بسبب الأشباح التي تطاردهم

201
00:13:03,370 --> 00:13:06,410
أؤمن أنّ ذلك هو واجبي

202
00:13:06,500 --> 00:13:08,960
ألن تساعد أطفال اليوكاي؟

203
00:13:09,040 --> 00:13:11,330
لا يهم
سواء كانوا يوكاي أو بشرًا

204
00:13:12,250 --> 00:13:16,710
الاعتقاد بأن جميع اليوكاي يقتلون البشر اعتقادٌ خاطئ تمامًا

205
00:13:17,210 --> 00:13:19,590
ألهذا قمتَ بحمايتي؟

206
00:13:20,550 --> 00:13:21,930
يسعدني أنكِ بخير

207
00:13:28,680 --> 00:13:30,850
حسنًا. علينا أن نبدأ
بالنزول من الجبل

208
00:13:34,650 --> 00:13:39,110
وعليكِ أن تحذري ألّا يراكِ أيُّ بشري في طريق عودتكِ

209
00:13:50,410 --> 00:13:52,370
!أستاذ نوينو

210
00:13:55,340 --> 00:13:56,840
شكرًا لك

211
00:13:57,340 --> 00:14:00,260
لن أنسى لطفك أبدًا

212
00:14:00,840 --> 00:14:04,220
سأبحث عنك حين أكبر

213
00:14:04,300 --> 00:14:07,310
!وسأحبك إلى الأبد

214
00:14:18,190 --> 00:14:22,530
ذلك اليوم، ابتسمتَ لي حقًا

215
00:14:23,950 --> 00:14:25,530
،والآن

216
00:14:25,620 --> 00:14:28,450
أخيرًا، أخيرًا

217
00:14:28,540 --> 00:14:30,870
وصلتُ إلى هنا
لأفي بوعدي

218
00:14:33,120 --> 00:14:34,630
قالت إنها "يوكي أونا"؟

219
00:14:34,710 --> 00:14:36,130
حقًا؟

220
00:14:43,010 --> 00:14:45,390
أنا أحبك يا أستاذ

221
00:15:00,110 --> 00:15:03,200
لهذا، تعال معي رجاءً

222
00:15:04,030 --> 00:15:07,490
إلى عالمٍ من الجليد لنا وحدنا

223
00:15:16,040 --> 00:15:17,330
الحافلة لم تصل بعد؟

224
00:15:17,840 --> 00:15:21,920
القطارات في كلا الاتجاهين متأخرة
بسبب الثلوج الكثيفة

225
00:15:22,010 --> 00:15:23,010
القطارات معلّقة
بسبب الثلوج الكثيفة

226
00:15:27,720 --> 00:15:31,270
هيا يا أستاذ نوينو، تعال معي

227
00:15:32,430 --> 00:15:33,770
هكذا إذاً

228
00:15:33,850 --> 00:15:36,400
لقد كنتِ تخطّطين دائمًا
لأخذي معكِ

229
00:15:36,980 --> 00:15:38,520
محولةً إياي إلى جليد

230
00:15:39,110 --> 00:15:44,780
"هذه هي الطريقة الوحيدة التي تستطيع بها "يوكي أونا
الزواجَ من بشري

231
00:16:23,980 --> 00:16:25,610
لا فائدة من محاولة الهرب

232
00:16:27,360 --> 00:16:28,610
إذًا لا خيار أمامي

233
00:16:29,110 --> 00:16:31,120
يا قوى السماوات والأرض الكونية، امنحيني قوتك

234
00:16:31,200 --> 00:16:33,040
!أيتها الشياطين، اخضعي لنا، فنحن ننهض من الأعماق نحو الفجر

235
00:16:33,120 --> 00:16:35,750
أيها الشيطان المختوم في يدي اليسرى

236
00:16:36,250 --> 00:16:38,290
...أرِني قوتك

237
00:16:39,120 --> 00:16:41,750
أرجوك لا تقاوم

238
00:16:42,460 --> 00:16:44,550
فلن تشعر بأي ألم

239
00:16:47,670 --> 00:16:49,050
لا تخف

240
00:16:49,550 --> 00:16:52,800
الرجال الذين تقع "يوكي أونا" في حبّهم
وتحوّلهم إلى جليد

241
00:16:52,890 --> 00:16:55,180
لن يموتوا أبدًا

242
00:16:56,230 --> 00:17:01,440
ستعيش للأبد
داخل جليد الحب

243
00:17:03,190 --> 00:17:05,070
فلنحبّ بعضنا

244
00:17:06,280 --> 00:17:07,900
داخل الجليد

245
00:17:07,990 --> 00:17:11,070
إلى الأبد

246
00:17:11,700 --> 00:17:14,580
ذلك هو حبّنا الأبدي

247
00:17:14,660 --> 00:17:15,700
!توقفي

248
00:17:19,330 --> 00:17:20,330
...أبعدي يديكِ

249
00:17:20,420 --> 00:17:22,460
...عن

250
00:17:22,540 --> 00:17:24,550
!أستاذنا...

251
00:17:27,630 --> 00:17:29,220
...يا رفاق

252
00:17:36,850 --> 00:17:39,560
هل ستعترضون طريقي؟

253
00:17:39,640 --> 00:17:41,060
بالطبع

254
00:17:41,560 --> 00:17:44,060
لن نترك نوبي لكِ

255
00:17:44,650 --> 00:17:45,650
هكذا إذاً

256
00:17:46,400 --> 00:17:48,740
إذًا لم تتركوا لي خيارًا
سوى تجميدكم

257
00:17:54,950 --> 00:17:56,830
توقفي يا يوكيمي

258
00:17:57,410 --> 00:17:58,660
اللعنة

259
00:18:29,360 --> 00:18:30,610
!اهربوا

260
00:19:11,440 --> 00:19:12,860
...أبعدي يديكِ

261
00:19:16,240 --> 00:19:19,280
!عن تلاميذي...

262
00:19:35,180 --> 00:19:37,050
...أستاذ

263
00:19:41,430 --> 00:19:42,560
...نوبي

264
00:19:43,270 --> 00:19:45,100
...عذرًا، أستاذ

265
00:19:45,600 --> 00:19:48,060
أنا آسفة للغاية
...لقد أُصبتَ بجراح بالغة

266
00:19:53,400 --> 00:19:55,070
يا يوكيمي

267
00:19:55,150 --> 00:19:57,660
لا أريد قتالَكِ

268
00:19:58,160 --> 00:20:01,870
لكن إن كنتِ ستؤذين
،هؤلاء الأطفال

269
00:20:01,950 --> 00:20:04,330
فلن أتردّد في القضاء عليكِ

270
00:20:06,080 --> 00:20:07,330
رجاءً يا آنسة يوكيمي

271
00:20:07,960 --> 00:20:10,290
،أعلم أنّكِ تحبّين نوبي حقًا

272
00:20:11,000 --> 00:20:13,880
لكن لا تأخذيه معكِ

273
00:20:13,960 --> 00:20:15,300
أجل، أجل

274
00:20:15,380 --> 00:20:18,010
،صحيح أن حظه معدوم في الحبِ والزواج

275
00:20:18,090 --> 00:20:21,930
لكنه يظل
معلّمًا مهمًا بالنسبة لنا

276
00:20:22,470 --> 00:20:25,980
،إن أخذتِ نوبي بعيدًا
فسألاحقكِ إلى أعماق الجحيمِ

277
00:20:26,060 --> 00:20:27,100
أجل

278
00:20:37,990 --> 00:20:40,490
يا له من دفء، أشعر وكأنني سأذوب

279
00:20:46,410 --> 00:20:50,380
إنه أمر مخيّب قليلًا، لكنني سأعود
إلى الجبال هذه المرة

280
00:20:52,340 --> 00:20:54,880
لكنني لن أستسلم

281
00:20:54,960 --> 00:20:58,510
سأنتظر حتى تبادلني المشاعر

282
00:21:00,430 --> 00:21:01,720
آسف

283
00:21:01,800 --> 00:21:03,890
ليس الأمر أنني أكرهكِ

284
00:21:03,970 --> 00:21:05,220
...كل ما بالأمر

285
00:21:15,900 --> 00:21:16,900
أراك لاحقًا

286
00:21:27,370 --> 00:21:29,290
لقد أحبّتكِ فعلًا، أليس كذلك؟

287
00:21:29,870 --> 00:21:32,130
لو كانت بشرية، لكان الوضع أفضل

288
00:21:32,210 --> 00:21:33,790
أشعر بالأسى لأجلها

289
00:21:34,380 --> 00:21:35,590
أجل

290
00:21:35,670 --> 00:21:37,170
...مهلًا يا نوبي

291
00:21:39,260 --> 00:21:40,930
!نوبي متجمّد تمامًا

292
00:21:41,010 --> 00:21:43,010
!تماسك يا نوبي

293
00:21:43,100 --> 00:21:44,970
!أحضروا ماءً ساخنًا. ماءً ساخنًا

294
00:21:45,060 --> 00:21:46,030
!هذا مرعب للغاية

295
00:21:46,030 --> 00:21:47,470
ومن أين سأحضر ماءً ساخنًا؟

296
00:21:47,560 --> 00:21:48,820
ماذا نفعل يا نوبي؟

297
00:21:49,000 --> 00:21:49,940
استفق يا نوبي