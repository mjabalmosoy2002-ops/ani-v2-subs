.ساتاكا

187
00:11:53,340 --> 00:11:55,510
.الأمر متروكٌ لكَ الآن

188
00:11:57,880 --> 00:11:59,800
،إن كان حسن ضيافة ساتاكا-سان جيّدًا

189
00:11:59,930 --> 00:12:02,390
."فهو مستعدٌّ لمنحه قرد "لا أسمع

190
00:12:03,100 --> 00:12:04,470
...لـ-لكن

191
00:12:04,680 --> 00:12:09,310
...إرضاء السيّد ماتسوموري المعروف بالعناد وسوء الطبع

192
00:12:09,730 --> 00:12:13,360
.لا أستطيع، هذا مستحيل

193
00:12:13,480 --> 00:12:16,740
ياماوكا-كن، هل من حيلة لديك؟

194
00:12:19,570 --> 00:12:23,080
.يبدو أنّ "حيلةً قرديّة" قد خطرت لك

195
00:12:39,510 --> 00:12:41,300
،لكن يا ياماوكا-كن

196
00:12:41,600 --> 00:12:43,180
،بالحديث عن السيّد ماتسوموري

197
00:12:43,300 --> 00:12:46,770
.إنّه عضوٌ بارزٌ في نادي الذواقة وذوقه رفيع

198
00:12:47,350 --> 00:12:50,230
.ولديه شخصيةٌ قويةٌ للغاية

199
00:12:51,100 --> 00:12:55,150
لن تدهشه مأكولات الكايسيكي ولا الصينية ولا الفرنسية ولا الإيطالية

200
00:12:55,270 --> 00:12:58,190
فما البديل الذي تراه؟

201
00:12:59,030 --> 00:13:00,280
،ياماوكا-كن

202
00:13:00,400 --> 00:13:03,910
بأي طعامٍ ستقنع السيّد ماتسوموري؟

203
00:13:05,620 --> 00:13:07,080
...في الواقع

204
00:13:07,200 --> 00:13:08,750
،ياماوكا-سان

205
00:13:09,460 --> 00:13:11,830
تواصلتَ مع السيّد ماتسوموري؟

206
00:13:12,210 --> 00:13:15,290
.نعم، بعد ثلاثة أيّام في مطعم ياماكاوا في شينباشي

207
00:13:15,670 --> 00:13:18,510
ماذا؟ إذن ستختار الكايسيكي في نهاية المطاف؟

208
00:13:18,920 --> 00:13:19,840
،لا

209
00:13:19,970 --> 00:13:22,470
لن نجعلها كايسيكي بالمعنى الحرفي

210
00:13:24,010 --> 00:13:26,930
بالمناسبة يا ساتاكا-سان، هل لديكَ أيّ خبرةٍ في الطهي؟

211
00:13:27,060 --> 00:13:33,970
.ماذا؟ حسنٌ، لا أقصد التفاخر، لكنّني لم أمسك سكين مطبخٍ في حياتي قطّ

212
00:13:34,770 --> 00:13:36,440
.فهمت

213
00:13:37,530 --> 00:13:38,730
.لا حيلة لنا إذن

214
00:13:38,860 --> 00:13:41,110
حسنٌ إذن، لنبدأ تدريبًا خاصًّا الآن، ماذا؟

215
00:13:41,610 --> 00:13:43,070
تـ-تدريبٌ خاص؟

216
00:13:48,500 --> 00:13:50,870
هل تغيّيت تاباتا-سان اليوم كذلك؟

217
00:13:51,210 --> 00:13:53,630
.نعم، هذا رابع يوم على التوالي

218
00:13:54,040 --> 00:13:56,380
تتظاهر بالصلابة

219
00:13:56,500 --> 00:13:59,510
.لكن أظن أنَّ الصدمة النفسية كانت كبيرة

220
00:14:00,920 --> 00:14:03,130
،ليس الزفاف فحسب

221
00:14:03,590 --> 00:14:05,260
بل حفل الاستقبال

222
00:14:05,390 --> 00:14:08,350
.مهمٌّ للغاية للنساء أيضًا

223
00:14:09,390 --> 00:14:11,310
يحضر فيه الأصدقاء والمعارف

224
00:14:11,430 --> 00:14:14,440
ويغدقون علينا بالتهاني

225
00:14:14,560 --> 00:14:18,270
يشعركِ الحفل بالسعادة، السعادة لزواجك من هذا الرجل

226
00:14:18,650 --> 00:14:21,990
وتتجسد الفكرة في القلب

227
00:14:22,950 --> 00:14:25,240
أشفق على تاباتا-سان

228
00:14:29,240 --> 00:14:31,660
.لا لا، قبضتك أقوى مما يلزم

229
00:14:32,120 --> 00:14:33,830
.حسنٌ

230
00:14:35,790 --> 00:14:36,880
هل فهمت؟

231
00:14:37,000 --> 00:14:39,550
.الأرزّ شيءٌ حسّاس

232
00:14:39,670 --> 00:14:42,220
.إن شددت قبضتك، فسيتفتت

233
00:14:42,340 --> 00:14:44,680
وإن أرخيتها كثيرًا

234
00:14:44,800 --> 00:14:47,100
.فسيفرط عند أكله ويسوء منظره

235
00:14:47,510 --> 00:14:49,850
.سأريكَ، راقبني

236
00:14:49,970 --> 00:14:50,810
.حاضر

237
00:14:51,930 --> 00:14:53,020
.ياماوكا-كن

238
00:14:53,390 --> 00:14:55,390
أهذا تدريبٌ خاصٌّ حقًّا؟

239
00:14:55,690 --> 00:14:56,690
نعم

240
00:14:57,190 --> 00:15:01,990
أتظن حقًّا أنَّ هذا سيقنع السيّد ماتسوموري؟

241
00:15:19,750 --> 00:15:22,000
.هذه هي الغرفة المنفصلة

242
00:15:30,470 --> 00:15:31,430
.تفضّل

243
00:15:37,940 --> 00:15:43,650
.استعمال حجر الرحى كمزهريةٍ فكرةٌ غريبةٌ

244
00:15:44,320 --> 00:15:45,320
.المعذرة

245
00:15:46,200 --> 00:15:49,240
تشرّفت بحضورك اليوم

246
00:15:49,950 --> 00:15:50,950
أجل

247
00:15:54,700 --> 00:15:57,920
أرى الكثير من الناس مجتمعين

248
00:16:04,300 --> 00:16:08,550
إذن، أيّ نوعٍ من الوجبات ستقدّم اليوم؟

249
00:16:08,720 --> 00:16:13,560
.سأبذل قصارى جهدي لضمان أن تنال إعجابكَ

250
00:16:13,970 --> 00:16:15,810
وهذا يعني؟

251
00:16:16,680 --> 00:16:19,440
.سأعدّ وجبة اليوم بنفسي

252
00:16:19,560 --> 00:16:22,900
مـ-ماذا؟ أنتَ بنفسكَ؟

253
00:16:23,520 --> 00:16:26,780
.يا للعجب، وجبةٌ من إعداد هاوٍ

254
00:16:27,240 --> 00:16:28,820
.المعذرة

255
00:16:33,660 --> 00:16:35,870
.حسنٌ، تفضّل شايًا الآن

256
00:16:36,200 --> 00:16:37,870
ما هذا؟

257
00:16:38,000 --> 00:16:39,830
.إنّه شاي أوراق الكاكي

258
00:16:40,880 --> 00:16:44,290
.مصنوعٌ من أوراق الكاكي المجفّفة ويُقال إنّه مفيدٌ جدًّا للصحّة

259
00:16:45,340 --> 00:16:47,260
.ومع الشاي، لدينا بذور الكاكي

260
00:16:47,510 --> 00:16:52,640
شاي أوراق الكاكي وبذور الكاكي... هل لهذا معنى؟

261
00:16:56,390 --> 00:16:57,890
.المعذرة

262
00:17:03,360 --> 00:17:05,030
ما هذا؟

263
00:17:06,030 --> 00:17:08,490
.لنبدأ

264
00:17:09,030 --> 00:17:11,200
.حسنٌ، تفضّل

265
00:17:33,720 --> 00:17:36,350
كرات أرزّ؟

266
00:17:38,140 --> 00:17:42,810
.ليست صلبةً جدًّا، ولا طريةً جدًّا، كي لا يُسحق الأرزّ

267
00:18:09,670 --> 00:18:10,960
،حسبما سمعت

268
00:18:11,090 --> 00:18:13,010
فإنَّك يا ماتسوموري-سان

269
00:18:13,130 --> 00:18:14,680
.مشهورٌ بكونك ذوّاقة

270
00:18:14,800 --> 00:18:18,010
لا يسهل إيجاد طعامٍ يرضي شخص مثلك

271
00:18:20,350 --> 00:18:24,650
.لذا فكّرت في أن أريكَ ذوقي بدلًا من ذلك

272
00:18:25,060 --> 00:18:27,860
ماذا؟ ذوقكَ يا ساتاكا-سان؟

273
00:18:29,480 --> 00:18:32,570
.نعم، عبر صنع كرات الأرزّ بيديّ هاتين

274
00:18:32,820 --> 00:18:35,370
أظن أنَّ هذه أفضل طريقةٍ لتفهم

275
00:18:35,490 --> 00:18:37,080
.أيّ نوعٍ من الرجال أنا

276
00:18:37,240 --> 00:18:40,290
.فهمت

277
00:18:41,540 --> 00:18:46,040
.جئت مستعدًّا للهجوم، لكن هذا قد يقلب الطاولة عليّ

278
00:18:47,170 --> 00:18:48,090
.تفضّل

279
00:18:48,210 --> 00:18:49,340
ما هذا؟

280
00:18:49,460 --> 00:18:50,840
.إنّه ساكي مثلّج

281
00:18:50,960 --> 00:18:54,010
.الساكي المثلّج يتناسب بشكلٍ استثنائي مع كرات الأرزّ

282
00:19:03,020 --> 00:19:04,690
ما هذا؟

283
00:19:04,810 --> 00:19:08,400
.لم أعرف قطّ أنَّ كرات الأرزّ والساكي المثلّج متناغمان إلى هذا الحدّ

284
00:19:13,820 --> 00:19:17,200
!لا تكفَّ عن إبهاري

285
00:19:24,250 --> 00:19:26,710
.الآن دور كرات الأرزّ المشوية

286
00:19:32,630 --> 00:19:36,890
...يوجد فجلٌ مخللٌ مفرومٌ ناعمًا في الداخل

287
00:19:41,220 --> 00:19:44,730
...رائحة الميسو المنبعثة من كرات الأرزّ المشوية الساخنة

288
00:19:44,850 --> 00:19:48,810
.تتصاعد بروعة وتتناغم تمامًا مع الساكي المثلّج

289
00:19:53,820 --> 00:19:56,530
.كرات أرزّ مقلية

290
00:20:10,790 --> 00:20:11,790
.تفضّل

291
00:20:12,170 --> 00:20:15,260
.افرط كرة الأرزّ قبل أكلها رجاءً

292
00:20:25,640 --> 00:20:27,770
.يا لها من نكهة

293
00:20:28,480 --> 00:20:30,810
...طعم المرق الغنيّ بالبونيتو

294
00:20:30,940 --> 00:20:34,230
.تكمّله حموضة البرقوق المخلل داخل كرة الأرزّ بمثالية

295
00:20:37,900 --> 00:20:42,450
...حبّات الأرزّ المقلية تمتصّ المرق وتتمتّع بقوامٍ فريد

296
00:20:42,870 --> 00:20:45,450
.هذا لذيذ، لذيذٌ حقًّا

297
00:20:46,500 --> 00:20:48,370
،لكن يا ساتاكا-سان

298
00:20:49,330 --> 00:20:51,290
.أنتَ ماكرٌ حقًّا

299
00:20:53,170 --> 00:20:56,670
.يمكنني انتقاد أطباق الطهاة المحترفين أو الهواة المتباهين

300
00:20:56,800 --> 00:20:58,720
.لكن كرات الأرزّ بسيطةٌ للغاية

301
00:20:59,380 --> 00:21:07,560
...ورؤيتكَ يا ساتاكا-سان تصنعها بخرقٍ وجدّية

302
00:21:07,560 --> 00:21:10,190
أتظن أنَّ بوسعي انتقاد ذلك؟

303
00:21:10,940 --> 00:21:13,440
.واجهتَ مطالبي القاسية بصدق

304
00:21:16,810 --> 00:21:20,230
،إن عجزت عن فهم عمق شخصيتكَ يا ساتاكا-سان

305
00:21:20,400 --> 00:21:23,640
.فسيكون ذلك عارًا أبديًا عليّ

306
00:21:24,120 --> 00:21:25,530
...ماتسوموري-سان

307
00:21:30,580 --> 00:21:32,130
...إذن أخبرني

308
00:21:32,250 --> 00:21:35,300
سنتناول شيئًا مصنوعًا من الكستناء للتحلية، أليس كذلك؟

309
00:21:35,840 --> 00:21:37,750
!اكتشفتَ الأمر

310
00:21:38,130 --> 00:21:39,720
،حجر رحى عند المدخل

311
00:21:39,920 --> 00:21:42,180
،شاي أوراق الكاكي مع بذور الكاكي

312
00:21:42,590 --> 00:21:44,140
،كرات أرزّ

313
00:21:44,470 --> 00:21:46,390
.وكستناء

314
00:21:46,760 --> 00:21:50,100
.إنّها أشبه بمعركة القرد والسرطان

315
00:21:50,850 --> 00:21:53,060
.فهمت

316
00:21:53,980 --> 00:21:55,520
.ياماوكا-سان

317
00:21:56,270 --> 00:22:01,650
.حين يحاول القرد مغادرة الغرفة، يسقط عليه حجر الرحى

318
00:22:01,780 --> 00:22:03,450
.هُزمت

319
00:22:09,370 --> 00:22:13,120
.سأعطيكَ هذا القرد يا ساتاكا-سان

320
00:22:13,250 --> 00:22:16,880
!حقًّا؟ شكرًا لك

321
00:22:18,300 --> 00:22:20,840
فعلناها، فعلناها، مرحى

322
00:22:21,210 --> 00:22:23,530
."فعلتها، حصلت أخيرًا على قرد "لا أسمع

323
00:22:23,530 --> 00:22:27,580
ياماوكا-سان وأراكاوا-سان، شكرًا لكما

324
00:22:32,640 --> 00:22:35,730
.الآن يمكننا إقامة حفل الزفاف

325
00:22:38,400 --> 00:22:41,650
.أراكاوا-سان

326
00:22:43,740 --> 00:22:44,990
.ياماوكا-سان

327
00:22:45,110 --> 00:22:48,160
.كانت تاباتا-سان وأراكاوا-سان سعيدين للغاية

328
00:22:48,280 --> 00:22:50,120
.قالا إنَّ الفضل كلّه يعود إليكَ يا ياماوكا-سان

329
00:22:50,740 --> 00:22:52,700
.أنا نادم

330
00:22:53,830 --> 00:22:55,330
ما الّذي فعلته لأستحقّ

331
00:22:55,460 --> 00:22:59,170
الاضطرار لرؤية عروسين في منتصف العمر؟

332
00:22:59,300 --> 00:23:00,250
...حسنٌ

333
00:23:00,380 --> 00:23:03,090
!ياماوكا-سان

334
00:23:03,340 --> 00:23:06,840
.ياماوكا-سان، أرجوكَ، أرجوكَ تعالَ إلى حفل الزفاف

335
00:23:06,970 --> 00:23:09,430
.أتوسّل إليكَ

336
00:23:09,850 --> 00:23:11,180
...مهما حدث

337
00:23:11,310 --> 00:23:13,310
.سأحضر حتمًا

338
00:24:40,670 --> 00:24:44,070
.لم يتمكّن حفيد الرئيس من دخول الكلية الّتي اختارها

339
00:24:44,650 --> 00:24:48,700
.خياره الثاني لم يكن سيئًا، لكنّه لا يريد الذهاب

340
00:24:51,960 --> 00:24:55,670
.طلب منّي إقناعه بالحضور

341
00:24:55,990 --> 00:24:58,650
في المرة القادمة على الأنمي
:الدرامي المثالي أويشينبو

342
00:24:59,080 --> 00:25:00,020
سمك موسى والسمك المفلطح

343
00:25:00,460 --> 00:25:01,110
ترقّبوها