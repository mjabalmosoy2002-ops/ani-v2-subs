1
00:00:01,040 --> 00:00:02,720
‫"هذه القصة خيالية وأسماء الأشخاص
‫والأماكن والمجموعات وهمية"

2
00:00:02,840 --> 00:00:04,480
‫"الالتزام بقواعد المرور
‫والقيادة بأمان"

3
00:00:23,880 --> 00:00:26,360
‫"المعلومات، تنتشر في غضون ثوان"

4
00:00:26,480 --> 00:00:28,680
‫"لكننا لا نعرف كيف نختاره"

5
00:00:28,800 --> 00:00:30,600
‫"أولئك الذين يقولون
‫"المال لا يشتري حبي"

6
00:00:30,720 --> 00:00:32,560
‫"يستحقون عقوبة"

7
00:00:32,680 --> 00:00:34,480
‫"نحن نمارس الحب وفقاً للكتيبات"

8
00:00:34,600 --> 00:00:36,480
‫"لا نلاحظ قلة الحب"

9
00:00:36,600 --> 00:00:39,080
‫"قبل أن نختنق دعونا نصيح!"

10
00:00:39,200 --> 00:00:40,240
‫"في حلم منتصف الليل"

11
00:00:40,360 --> 00:00:44,200
‫"لا مكان للاسترخاء
‫في المدينة التي لا تنام"

12
00:00:44,320 --> 00:00:48,120
‫"نبتسم بدون أن نتخلى عن حذرنا"

13
00:00:48,240 --> 00:00:52,240
‫"الكذب آمن والحقيقة فارغة"

14
00:00:52,360 --> 00:00:56,280
‫"أريد بشدة أن أثور"

15
00:00:56,400 --> 00:00:58,160
‫"الآن، يجب أن نبدأ دعونا نتحرك"

16
00:00:58,280 --> 00:00:59,920
‫"دعونا ننتقل إلى عالم جديد تماماً"

17
00:01:00,040 --> 00:01:02,160
‫"دعنا نغص في رحلة جديدة"

18
00:01:02,280 --> 00:01:05,880
‫"أنت خائف من عالم كبير"

19
00:01:06,000 --> 00:01:08,200
‫"لقد بدأت للتو"

20
00:01:08,320 --> 00:01:10,160
‫"الآن نذهب بأقصى سرعة
‫ونبض غير تقليدي"

21
00:01:10,280 --> 00:01:11,880
‫"سوف تتألق بالتأكيد"

22
00:01:12,000 --> 00:01:13,800
‫"حول العالم"

23
00:01:13,920 --> 00:01:16,640
‫"رحلة إلى العالم
‫ها نحن نذهب إلى عالم مجهول"

24
00:01:16,760 --> 00:01:18,400
‫"أنت مسافر حديث الولادة"

25
00:01:18,520 --> 00:01:20,440
‫"مشاهدة الخطوات غير المستقرة ممتعة"

26
00:01:20,560 --> 00:01:22,560
‫"قم بإنجاز الأمور بشكل صحيح
‫عند الحاجة فقط"

27
00:01:22,680 --> 00:01:24,080
‫"الكثير من الناس في هذا العالم"

28
00:01:24,200 --> 00:01:26,360
‫"في بعض الأحيان
‫سوف تتلقى الافتراءات"

29
00:01:26,480 --> 00:01:28,400
‫"دعونا نتخلص من الأشياء الرتيبة"

30
00:01:28,520 --> 00:01:29,880
‫"ونعش حياة عقلانية على الأقل"

31
00:01:30,000 --> 00:01:31,800
‫"هذا هو قانوننا"

32
00:03:05,360 --> 00:03:06,800
‫لم يتغير أبداً

33
00:03:10,560 --> 00:03:16,400
‫"الحلقة الأولى الذكرى الخالدة
‫لمحل (فوجي وارا)"

34
00:03:18,400 --> 00:03:21,840
‫حتى طراز 1991
‫تكلف حوالي 13 مليون ين

35
00:03:22,200 --> 00:03:24,520
‫(إس 3) مكلفة جداً

36
00:03:26,320 --> 00:03:27,720
‫مثلما اعتقدت
‫علينا اختيار طراز 86

37
00:03:28,040 --> 00:03:29,600
‫فهي معقولة جداً

38
00:03:29,800 --> 00:03:32,800
‫على أية حال يجب أن تكون السيارة
‫(إف آر)؟ أليس كذلك (تاكومي)؟

39
00:03:33,480 --> 00:03:34,480
‫(تاكومي)!

40
00:03:35,400 --> 00:03:37,160
‫أنت! هل تستمع إلي؟

41
00:03:37,720 --> 00:03:39,200
‫أسمعك يا (إيتزوكي)؟

42
00:03:39,600 --> 00:03:42,520
‫حسناً، كم تكلفة الـ86؟

43
00:03:42,960 --> 00:03:44,920
‫هذه تكلف 300 ألف ين

44
00:03:45,040 --> 00:03:46,480
‫وهذا من دون الأقساط

45
00:03:46,640 --> 00:03:48,400
‫كم من المال معك حالياً؟

46
00:03:48,960 --> 00:03:50,320
‫50 ألف ين

47
00:03:50,800 --> 00:03:52,320
‫لا يزال أمامك طريق طويل

48
00:03:52,800 --> 00:03:54,360
‫نعم

49
00:03:56,680 --> 00:03:59,960
‫أليست هنالك طريقة سريعة لكسب المال؟

50
00:04:00,200 --> 00:04:03,280
‫مع عملنا في محطة الوقود
‫في هذا الصيف ولو عملنا بدوام كامل

51
00:04:03,400 --> 00:04:05,240
‫سوف نجني 120 ألف ين فقط

52
00:04:05,360 --> 00:04:07,720
‫لا بد من وجود عمل مربح

53
00:04:08,520 --> 00:04:10,560
‫هل تعملان جزئياً في وقت الدراسة؟

54
00:04:12,800 --> 00:04:13,800
‫(موجي)؟

55
00:04:18,080 --> 00:04:21,480
‫ماذا؟ هل من الغريب
‫بأنني أتحدث معكما؟

56
00:04:22,040 --> 00:04:23,040
‫لا أبداً

57
00:04:23,840 --> 00:04:25,960
‫قلت إنك تستطيع كسب
‫120 ألف ين في العمل؟

58
00:04:26,080 --> 00:04:28,640
‫كم من الوقت يجب أن تعمل يومياً؟

59
00:04:28,760 --> 00:04:30,440
‫من الصباح إلى وقت متأخر من المساء

60
00:04:30,680 --> 00:04:31,960
‫ماذا؟

61
00:04:32,080 --> 00:04:35,880
‫تجني 120 ألف ين
‫مع كل هذا العمل الكثير؟

62
00:04:36,000 --> 00:04:37,360
‫هذا صحيح

63
00:04:37,480 --> 00:04:40,640
‫أجور طلاب الثانوية قليلة جداً

64
00:04:41,720 --> 00:04:42,760
‫لم أكن أعلم بذلك

65
00:04:43,560 --> 00:04:46,080
‫لم أعمل جزئياً أبداً

66
00:04:50,440 --> 00:04:51,760
‫حظاً موفقاً في عملكما

67
00:04:52,280 --> 00:04:54,720
‫دعونا نخرج معاً
‫بعد الامتحانات النهائية

68
00:04:55,040 --> 00:04:56,200
‫بالتأكيد!

69
00:04:57,240 --> 00:05:00,520
‫لقد قالت بأن نذهب مع بعضنا
‫أليس كذلك؟

70
00:05:00,800 --> 00:05:02,600
‫رائع! نخرج مع (موجي)؟

71
00:05:04,360 --> 00:05:05,960
‫هذا رائع! رائع

72
00:05:06,760 --> 00:05:08,800
‫(تاكومي)
‫لماذا لم تخبرني؟

73
00:05:09,080 --> 00:05:11,280
‫كان يجب أن تخبرني
‫بأنك صديق (موجي)

74
00:05:11,400 --> 00:05:16,720
‫لم أتكلم معها منذ سنة
‫فقد كنا في الصف ذاته

75
00:05:17,360 --> 00:05:19,920
‫كنا نتحدث كثيراً الصيف الماضي

76
00:05:20,280 --> 00:05:23,680
‫ما الذي تتكلم عنه؟
‫من يهتم بأمور كهذه؟

77
00:05:24,000 --> 00:05:27,240
‫(ناتسوكي موجي)
‫يا لها من فرصة عظيمة

78
00:05:27,640 --> 00:05:30,560
‫لقد كنت أراقبها منذ فترة
‫وهي جميلة جداً

79
00:05:37,320 --> 00:05:40,480
‫(تاكومي)
‫(تاكومي)! لا تشرد كثيراً

80
00:05:40,600 --> 00:05:42,200
‫إذا لم نسرع سوف نقع في ورطة كبيرة

81
00:05:42,320 --> 00:05:43,880
‫لدينا اختبار في القواعد
‫في الحصة الثانية

82
00:05:44,000 --> 00:05:45,000
‫انتظرني

83
00:05:48,080 --> 00:05:51,520
‫لماذا لا نشتري الـ86 كلانا؟

84
00:05:51,840 --> 00:05:53,920
‫إذا جمعنا ما ادخرناه معاً
‫يمكننا شراؤها

85
00:05:54,440 --> 00:05:55,440
‫هذا مستحيل

86
00:05:55,920 --> 00:05:58,080
‫لماذا أنت مستعجل لشراء سيارة ما؟

87
00:05:58,480 --> 00:06:00,600
‫عائلتك تملك سيارة، صحيح؟

88
00:06:00,880 --> 00:06:05,880
‫إنها رديئة
‫سيارة أبي أوتوماتيكية وذات دفع أمامي

89
00:06:06,040 --> 00:06:09,720
‫وتعمل على الديزل
‫إنها خردة

90
00:06:09,880 --> 00:06:11,800
‫أنا لا أسميها سيارة أصلاً

91
00:06:13,680 --> 00:06:16,840
‫لديها أربع عجلات وتسير
‫إذاً إنها سيارة

92
00:06:17,240 --> 00:06:18,720
‫أنت لا تفهم الأمر

93
00:06:19,200 --> 00:06:22,480
‫ليست جيدة على الطريق الجبلي
‫فهي ليست سيارة

94
00:06:23,160 --> 00:06:24,680
‫ماذا تعني بالطريق الجبلي؟

95
00:06:25,240 --> 00:06:28,760
‫ما الذي تتكلم عنه؟
‫سنتسابق على منحدرات الطريق الجبلي

96
00:06:29,000 --> 00:06:32,640
‫منحدرات الطريق الجبلي؟
‫لماذا؟ هل هي ممتعة؟

97
00:06:33,240 --> 00:06:34,840
‫بالطبع!

98
00:06:35,200 --> 00:06:39,480
‫لا تريد أن تزعجك المنعطفات

99
00:06:40,200 --> 00:06:42,680
‫سئمت من تلك الأمور

100
00:06:43,480 --> 00:06:48,240
‫ما الذي تعنيه؟
‫حصلنا على رخصتنا قبل شهور فقط

101
00:07:06,000 --> 00:07:09,680
‫تبدين جميلة
‫الرداء المدرسي يليق بك دائماً

102
00:07:10,400 --> 00:07:12,360
‫حقاً؟ شكراً لك

103
00:07:15,520 --> 00:07:20,480
‫أتعرف أن أحد أصدقائي في المدرسة
‫يعمل بدوام جزئي؟

104
00:07:21,280 --> 00:07:28,480
‫يقول إنه إذا عمل بكامل فصل الصيف
‫فسوف يجني 120 ألف ين

105
00:07:29,040 --> 00:07:30,920
‫ذلك صحيح

106
00:07:31,520 --> 00:07:35,360
‫هل من الصعب أن تجني المال؟

107
00:07:36,320 --> 00:07:41,000
‫فأنت تنفق علي أكثر من ذلك يومياً

108
00:07:42,560 --> 00:07:44,720
‫ألا بأس بأن تنفق
‫كل هذا المبلغ من أجلي؟

109
00:07:45,160 --> 00:07:48,680
‫بالطبع، فأنت تستحقينه

110
00:07:50,000 --> 00:07:51,440
‫حقاً؟

111
00:07:51,600 --> 00:07:53,120
‫أنا لا أفهم ذلك

112
00:07:57,360 --> 00:07:59,040
‫شكراً جزيلاً لك

113
00:07:59,840 --> 00:08:04,840
‫(تاكومي)
‫أرجوك، فكر بصفقة شراء الـ86!

114
00:08:05,040 --> 00:08:06,840
‫أنا لا أهتم بسيارة 86!

115
00:08:07,880 --> 00:08:10,200
‫أيها الشباب
‫لديكما ذوق مناسب بانتقاء الـ86

116
00:08:11,120 --> 00:08:12,480
‫تحاولان الحصول عليها؟

117
00:08:12,920 --> 00:08:16,880
‫أرأيت؟ (إيكيتاني) يدعم رأيي أيضاً

118
00:08:17,080 --> 00:08:20,520
‫- الـ86 سيارة جيدة
‫- لقد أخبرتك

119
00:08:21,240 --> 00:08:22,240
‫ولكن...

120
00:08:22,600 --> 00:08:25,920
‫لأكون صادقاً معكما، لا أعرف ما هي

121
00:08:26,560 --> 00:08:28,360
‫من يصنعها؟

122
00:08:28,600 --> 00:08:32,160
‫هل أنت تمزح؟
‫أتريد أن تشرب بعض الوقود؟

123
00:08:32,280 --> 00:08:34,800
‫تعمل بمحطة وقود
‫ولا تعلم ما هي سيارة الـ86؟

124
00:08:34,920 --> 00:08:36,280
‫عار عليك

125
00:08:36,960 --> 00:08:39,200
‫هذا لا يفاجئني

126
00:08:39,560 --> 00:08:43,760
‫عندما صدر طراز الـ92
‫كنتما في الصف الثالث أو الثاني؟

127
00:08:43,880 --> 00:08:47,440
‫لدينا سيارة قديمة في منزلنا
‫ولكننا نستخدمها في طلبياتنا

128
00:08:47,640 --> 00:08:49,520
‫لا تستطيع مقارنة تلك السيارة بالـ86

129
00:08:49,640 --> 00:08:52,080
‫رغم أنها قديمة، لكنها مميزة

130
00:08:53,040 --> 00:08:56,120
‫عندما نبتاع سيارة الـ86
‫هل ستسمح لنا بالانضمام لفريقك؟

131
00:08:56,280 --> 00:08:59,320
‫لقد حلمت دوماً
‫بالانضمام لفريق نجوم (أكينا)

132
00:08:59,560 --> 00:09:05,160
‫بالتأكيد! بالمناسبة اليوم السبت
‫وكل الشباب سيأتون إلى هضبة (أكينا)

133
00:09:06,000 --> 00:09:07,280
‫لذا هل تريدان المجيء؟

134
00:09:07,400 --> 00:09:08,960
‫ماذا؟ نحن؟

135
00:09:10,040 --> 00:09:12,200
‫لكننا لا نملك سيارة

136
00:09:12,480 --> 00:09:13,600
‫سأسمح لك بجولة بسيارتي

137
00:09:18,000 --> 00:09:19,840
‫نستطيع أن نأخذ جولة
‫في سيارة (إس 13)!؟

138
00:09:20,600 --> 00:09:22,720
‫سأذهب! بالتأكيد سأذهب!

139
00:09:22,840 --> 00:09:25,000
‫أنت أيضاً ستأتي (تاكومي)؟
‫إنها لفرصة نادرة

140
00:09:25,240 --> 00:09:28,800
‫- هذا رائع! سأقابل الفريق بأكمله
‫- "لم أوافق أبداً"

141
00:09:33,720 --> 00:09:35,320
‫اسمح لنا، سنذهب إلى البيت

142
00:09:35,480 --> 00:09:38,520
‫حسناً، سألقاكما عند موقف الحافلات
‫الساعة 8 مساء

143
00:09:38,640 --> 00:09:39,680
‫حسناً!

144
00:09:41,360 --> 00:09:43,640
‫إذاً أنتم مصممون على ذلك؟
‫إلى أين أنتم ذاهبون؟

145
00:09:44,080 --> 00:09:47,920
‫سيدي، الهضبة الأخطر هنا
‫هي هضبة (أكينا)؟

146
00:09:48,680 --> 00:09:52,280
‫نحن الأسرع عليها

147
00:09:52,640 --> 00:09:55,480
‫الكثيرون يدعون بأنهم الأسرع
‫على هضبة (أكينا)

148
00:09:56,280 --> 00:10:01,320
‫عندما كنت أسابق عليها
‫كان هنالك شخص يعترف الجميع بتفوقه

149
00:10:01,840 --> 00:10:05,280
‫ولا يزال يقود على هضبة (أكينا)

150
00:10:05,640 --> 00:10:12,240
‫لا يزال!؟ أعرف كل سائقي هضبة
‫(أكينا) وليس هناك سائق مسن

151
00:10:13,120 --> 00:10:19,680
‫لأنه يقود في وقت آخر
‫لأنه يعمل في محل حلوى (توفو)!

152
00:10:20,040 --> 00:10:21,480
‫ماذا؟

153
00:10:22,120 --> 00:10:26,080
‫حوالي الساعة 4 صباحاً
‫يوصل طلبياته إلى فنادق منحدرات (أكينا)

154
00:10:26,640 --> 00:10:30,240
‫عجيب عندما ترى سرعته في النزول

155
00:10:30,600 --> 00:10:34,000
‫بسبب عمله، يقوم بهذا في جميع
‫الحالات في المطر والثلج ويومياً

156
00:10:34,400 --> 00:10:38,520
‫يعرف كل بقعة صغيرة
‫على منحدرات (أكينا)

157
00:10:39,880 --> 00:10:44,240
‫أراهن بأن الأسرع على منحدرات (أكينا)
‫هي الـ86 من محل التوفو

158
00:10:44,560 --> 00:10:46,080
‫الـ86 من محل التوفو!؟

159
00:10:46,600 --> 00:10:49,000
‫"الشارع الأخضر للتبضع"

160
00:10:54,160 --> 00:10:55,680
‫هل ستخرج يا (تاكومي)؟

161
00:10:56,560 --> 00:10:58,800
‫نعم، سأخرج مع (إيتزوكي)

162
00:10:59,200 --> 00:11:00,640
‫لا أهتم إن خرجت ليلاً

163
00:11:00,760 --> 00:11:02,560
‫ولكنني سوف أسحبك من سريرك
‫إن لم تنهض في الصباح

164
00:11:02,680 --> 00:11:04,680
‫لا داعي لتذكيري بذلك

165
00:11:05,400 --> 00:11:06,560
‫أنا ذاهب

166
00:11:24,200 --> 00:11:25,520
‫اصمت! يا (تاكومي)

167
00:11:25,640 --> 00:11:27,560
‫أنت تشوش تركيز (إيكيتاني)

168
00:11:27,960 --> 00:11:31,360
‫مهما يكن! هذا مروع وأنا خائف

169
00:11:31,840 --> 00:11:35,800
‫لا شيء جديد الكل يخاف
‫عندما يركبون مع سائقي السيارات

170
00:11:35,920 --> 00:11:37,680
‫الآن سوف أضع ناقل الحركة
‫على العيار الثاني

171
00:11:45,320 --> 00:11:47,240
‫ما زلت مزعجاً يا (تاكومي)

172
00:11:51,880 --> 00:11:54,160
‫الليلة سأقطع كل المنعطفات

173
00:11:57,960 --> 00:11:59,360
‫هل أنت بخير (تاكومي)؟

174
00:11:59,720 --> 00:12:01,760
‫لم أعتقد أنك ستخاف لهذه الدرجة

175
00:12:01,880 --> 00:12:04,160
‫لم أكن أدفع السيارة بكل قدرتي

176
00:12:06,480 --> 00:12:08,800
‫أنت جبان يا (تاكومي)
‫لقد جلبت العار لنا

177
00:12:09,280 --> 00:12:12,240
‫أنت النوع الذي يصرخ
‫في القاطرات السريعة، أليس كذلك؟

178
00:12:12,840 --> 00:12:16,080
‫لم أعتقد أن تلك القطارات مخيفة

179
00:12:16,640 --> 00:12:18,320
‫إنها ليست كذلك

180
00:12:19,080 --> 00:12:22,720
‫(إيتزوكي) حتى وإن شرحت لك
‫فلن تتفهم الأمر

181
00:12:23,640 --> 00:12:24,720
‫هذا الخوف...

182
00:12:25,600 --> 00:12:26,600
‫ماذا؟

183
00:12:39,800 --> 00:12:43,840
‫"لم أرهم يقصدون هضبة (أكينا)
‫في مثل هذا الوقت من قبل"

184
00:12:45,920 --> 00:12:48,280
‫"ربما هنالك حدث ما على الهضبة"

185
00:13:00,400 --> 00:13:01,680
‫لدينا زوار

186
00:13:11,720 --> 00:13:15,240
‫"الشموس الحمراء"

187
00:13:15,880 --> 00:13:18,360
‫"هل هم الشموس الحمراء
‫أسرع السائقين في (أكاجي)؟"

188
00:13:31,960 --> 00:13:33,880
‫"(إنيشال دي)"

189
00:13:36,120 --> 00:13:37,920
‫"(إنيشال دي)"

190
00:13:42,280 --> 00:13:45,840
‫نحن أعضاء فريق الشمس الحمراء
‫من (أكاجي)

191
00:13:46,640 --> 00:13:53,520
‫لا أحب أن أكون فظاً
‫ولكن من أسرع فريق أو سائق هنا؟

192
00:13:54,040 --> 00:13:55,360
‫ماذا يريدون؟
‫نحن الأسرع هنا

193
00:13:56,400 --> 00:14:01,880
‫نحن هنا فريق نجوم (أكينا)
‫نعتبر أنفسنا الأسرع هنا

194
00:14:03,840 --> 00:14:05,240
‫فقد وجدنا ما كنا نبحث عنه

195
00:14:05,760 --> 00:14:10,080
‫هل أنتم أهل بجولة تدريب
‫هنا في هضبة (أكينا) مع الشمس الحمراء

196
00:14:10,560 --> 00:14:14,360
‫"ماذا؟
‫هل هم جادون؟"

197
00:14:15,000 --> 00:14:18,040
‫يا لها من فرصة لا تعوض!

198
00:14:19,120 --> 00:14:20,480
‫ما الذي تعتقده؟

199
00:14:20,600 --> 00:14:23,920
‫أن نتدرب مع أناس نعرفهم
‫أصبح روتيناً معتمداً

200
00:14:24,040 --> 00:14:27,200
‫ولكن مجاراة فريق آخر
‫هذا تحد جديد

201
00:14:28,080 --> 00:14:30,280
‫ونستطيع كسب معرفة جديدة
‫من أصدقاء مثلكم

202
00:14:30,800 --> 00:14:32,320
‫ونثبت براعتنا أيضاً

203
00:14:33,080 --> 00:14:38,080
‫أولاً نتدرب ثم ندع سائقاً من كل فريق
‫يتسابقان صعوداً ونزولا من الهضبة

204
00:14:38,400 --> 00:14:40,200
‫لن نعلق عليهم إن فازوا أو خسروا

205
00:14:40,320 --> 00:14:42,800
‫نريد فقط أن نطور
‫الصداقة بين الفرق

206
00:14:43,440 --> 00:14:44,440
‫ما الذي تقوله في هذا؟

207
00:14:44,880 --> 00:14:47,160
‫إن كان الأمر كذلك فكيف لنا أن نرفض؟

208
00:14:47,560 --> 00:14:48,680
‫حسناً

209
00:14:48,800 --> 00:14:52,040
‫ما رأيكم بالسبت القادم
‫الساعة 10 مساء؟

210
00:14:52,160 --> 00:14:53,520
‫حسناً

211
00:14:54,080 --> 00:14:57,360
‫اليوم، سنتروى

212
00:14:57,760 --> 00:14:59,840
‫هذا رائع يا (تاكومي)! رائع

213
00:15:09,480 --> 00:15:10,960
‫لا داعي للخوف

214
00:15:11,080 --> 00:15:12,880
‫- سنشارك أيضاً
‫- هيا

215
00:15:25,000 --> 00:15:26,000
‫(إيكيتاني)

216
00:15:27,080 --> 00:15:31,440
‫دعوني أر الأخوين (تاكاشي) يقال بأنهما
‫الأسرع في (أكاجي)

217
00:15:32,000 --> 00:15:33,520
‫أنت تعني الأخوين (تاكاشي)

218
00:15:33,680 --> 00:15:36,920
‫المتحديان المشهوران في سباقات الشوارع
‫اللذان لديهما عروض بالمجلات؟

219
00:15:37,200 --> 00:15:40,240
‫نعم، المعروفان
‫"بالأخوين المتسكعين" أيضاً

220
00:15:43,240 --> 00:15:44,720
‫(إيكيتاني)! ماذا عنا؟

221
00:15:45,280 --> 00:15:48,920
‫آسف، عندما أدفع السيارة بكل ما لدي
‫لا آخذ أشخاصاً معي

222
00:15:49,520 --> 00:15:51,520
‫ابقيا هنا، سأقلكما فيما بعد

223
00:16:02,480 --> 00:16:06,880
‫هذا مريع!
‫لماذا نحن الوحيدان من دون سيارة؟

224
00:16:08,200 --> 00:16:09,520
‫(إيتزوكي)

225
00:16:10,520 --> 00:16:13,000
‫هل من الممتع أن تكون متحدي شوارع؟

226
00:16:14,840 --> 00:16:15,960
‫أنا لا أفهم هذا

227
00:16:16,640 --> 00:16:18,840
‫لماذا الكل متحمس لهذا؟

228
00:16:19,160 --> 00:16:20,840
‫أنت الوحيد الذي لم يتحمس

229
00:16:21,280 --> 00:16:24,360
‫نستطيع سماع السيارات
‫تتحدى الواحدة الأخرى صحيح؟

230
00:16:24,480 --> 00:16:27,520
‫لماذا لا تتحمس؟

231
00:16:28,880 --> 00:16:29,880
‫أتحمس!؟

232
00:16:33,280 --> 00:16:34,560
‫مرحباً، محل (فوجي وارا) للتوفو

233
00:16:36,360 --> 00:16:38,080
‫إنه أنت إذاً؟

234
00:16:38,880 --> 00:16:40,880
‫يا لها من مفاجأة

235
00:16:41,080 --> 00:16:44,760
‫أنا فقط؟ لم أتكلم معك
‫منذ زمن وأحظى بهذه التحية؟

236
00:16:45,920 --> 00:16:49,040
‫ذلك اليوم عبرت بجانبي
‫في طريق عودتك من توصيل طلباتك

237
00:16:49,800 --> 00:16:51,440
‫لقد أومأت لك ولكنك تجاهلتني

238
00:16:52,240 --> 00:16:54,600
‫لم أكن أنا

239
00:16:55,160 --> 00:16:57,360
‫"لا بد أنك هو
‫لقد كانت سيارة 86"

240
00:16:59,320 --> 00:17:04,560
‫حسناً كانت سيارتي
‫ولكن لم أكن أنا السائق

241
00:17:05,400 --> 00:17:08,200
‫"ابني (تاكومي) هو من يوصل الطلبيات
‫إلى الفنادق الآن"

242
00:17:10,680 --> 00:17:11,920
‫ما الذي تقوله؟

243
00:17:12,680 --> 00:17:13,800
‫"منذ متى؟"

244
00:17:14,440 --> 00:17:15,800
‫خمس سنوات

245
00:17:16,200 --> 00:17:19,040
‫خمس سنوات
‫منذ أن كان في الصف السابع؟

246
00:17:37,680 --> 00:17:40,080
‫تباً! لا أستطيع مجاراتهم

247
00:17:45,760 --> 00:17:46,840
‫إنهم سريعون!

248
00:17:46,960 --> 00:17:50,520
‫أنا في أقصى سرعتي ولا أجاري
‫أياً من فريق الشمس الحمراء

249
00:17:58,720 --> 00:18:00,040
‫ما رأيك يا أخي؟

250
00:18:01,080 --> 00:18:02,200
‫فاشلون

251
00:18:02,640 --> 00:18:07,680
‫حتى مجموعة فريقنا الثاني قد تهزمهم
‫لن نحتاج لأمهر سائقينا

252
00:18:07,920 --> 00:18:08,920
‫أنا لن أحضر

253
00:18:09,280 --> 00:18:11,680
‫إن لم تحضر فأنا أيضاً لن أحضر

254
00:18:12,120 --> 00:18:13,480
‫لا، أنت يجب أن تباريهم

255
00:18:13,760 --> 00:18:17,640
‫يجب أن تسجل رقماً قياسياً لهذا السباق
‫حتى لا يستطيع العامة كسره

256
00:18:18,320 --> 00:18:21,760
‫وإلا فلن نضع
‫اسم الشمس الحمراء الأسطورة

257
00:18:22,200 --> 00:18:23,360
‫نعم

258
00:18:23,880 --> 00:18:27,320
‫أولاً، سنسجل أرقاماً قياسية جديدة
‫لكل تدريب في هذه الولاية

259
00:18:28,200 --> 00:18:32,120
‫ثم سنذهب إلى (سايتاما)
‫و(كاناجاوا) و(طوكيو) و(كيبا)

260
00:18:32,520 --> 00:18:37,600
‫سيكون لدينا رقم قياسي في (كانتو) كلها
‫ومن ثم سنصبح أسطورة ونعتزل التحديات

261
00:18:38,560 --> 00:18:43,040
‫"شموس (أكاجي) الحمراء"
‫الأسرع في مشروع (كانتو)

262
00:18:57,200 --> 00:18:58,360
‫إنهم مدهشون

263
00:18:59,000 --> 00:19:01,200
‫إنهم مختلفون عنا تماماً

264
00:19:01,840 --> 00:19:06,200
‫لا أصدق أننا خسرنا في أرضنا

265
00:19:07,000 --> 00:19:09,840
‫لقد أنفقوا الكثير
‫على سياراتهم ومحركاتهم

266
00:19:10,480 --> 00:19:12,560
‫من المستحيل أن نقارن
‫مع "الشمس الحمراء"

267
00:19:12,920 --> 00:19:15,520
‫ولكن كيف نتفادى تحدياً على أرضنا؟

268
00:19:15,800 --> 00:19:18,400
‫هذا صحيح؟ لا نستطيع التراجع الآن

269
00:19:18,560 --> 00:19:21,520
‫ولكن الحماس وحده لن يهزمهم

270
00:19:21,640 --> 00:19:23,600
‫أنا أعلم ذلك ولكن...

271
00:19:25,120 --> 00:19:29,040
‫الوقت متأخر
‫فلنجتمع غداً ونتكلم بهذا الموضوع

272
00:19:31,400 --> 00:19:33,520
‫متحدو الشوارع لا يحبون الخسارة

273
00:19:34,280 --> 00:19:37,160
‫بل هم جادون في التحديات

274
00:19:38,160 --> 00:19:42,040
‫لا شيء أسوأ من أن تخسر أمام أشخاص
‫من مكان آخر على أرضك

275
00:19:43,400 --> 00:19:46,320
‫وكأنه قانون لمتحدي الشوارع

276
00:19:56,880 --> 00:19:58,720
‫- أين (ريوسكي)؟
‫- "(الشموس الحمراء)"

277
00:19:59,600 --> 00:20:00,800
‫لقد ذهب إلى البيت

278
00:20:01,360 --> 00:20:02,760
‫نحن فقط من بقينا هنا

279
00:20:03,800 --> 00:20:05,240
‫إن الفجر يقترب

280
00:20:06,040 --> 00:20:07,880
‫أظن أننا يجب أن نعود أيضاً

281
00:20:20,920 --> 00:20:24,960
‫إذا كنت جاداً في التحدي فلن يصمدوا
‫فهم ليسوا بالمستوى المطلوب

282
00:20:29,680 --> 00:20:30,760
‫أخيراً لحق بي أحد منهم

283
00:20:36,360 --> 00:20:40,000
‫ماذا؟ ليس من فريقنا
‫هل هي (إم آر 2) أم (180)؟

284
00:20:52,960 --> 00:20:57,160
‫قيادة رائعة ولكن بعد منعطفين
‫لن تجاريني أبداً

285
00:21:12,880 --> 00:21:15,280
‫طراز 86!؟
‫لا بد أنك تمازحني

286
00:21:36,000 --> 00:21:39,200
‫(إف دي) لا تستطيع
‫أن تسبق سيارة قديمة كهذه؟

287
00:21:39,960 --> 00:21:42,560
‫هل هذا كابوس أم ماذا؟ بئساً!

288
00:21:43,320 --> 00:21:46,120
‫أنا العضو الثاني في فريق
‫"الشمس الحمراء" لـ(أكاجي)

289
00:21:51,320 --> 00:21:53,520
‫"ألا يعرف هذا الطريق؟"

290
00:21:53,640 --> 00:21:55,600
‫"هناك منعطف أيسر
‫بعد هذا المنعطف"

291
00:21:56,280 --> 00:21:58,560
‫"إذا لم يخفف السرعة
‫سيسقط في الوادي"

292
00:22:01,560 --> 00:22:04,400
‫كنت أعلم أنه سينطلق بتلك السرعة

293
00:22:04,880 --> 00:22:07,080
‫لا تستطيع تخفيف سرعتك الآن

294
00:22:13,040 --> 00:22:14,480
‫ما هذا بحقك!؟

295
00:22:17,200 --> 00:22:18,440
‫التفاف قصير وصغير!؟

296
00:22:43,920 --> 00:22:46,280
‫"يخبرني فخري أن أكون جامحاً وقوياً"

297
00:22:46,400 --> 00:22:48,280
‫"لا أسمح للآخرين بالتدخل"

298
00:22:48,400 --> 00:22:50,160
‫"لا أتوقف أبداً، ولا أريد التوقف"

299
00:22:50,280 --> 00:22:52,080
‫"حتى لو ضحيت بكل ما أحب"

300
00:22:52,200 --> 00:22:54,400
‫"أتوجه نحو القمة، ولا أكترث لشيء"

301
00:22:54,520 --> 00:22:56,320
‫"احذروا، فأصوات التحذير تملأ المكان"

302
00:22:56,440 --> 00:22:57,760
‫"ولا مجال للضعفاء"

303
00:22:57,880 --> 00:23:00,080
‫"لأنني لن أكف عن مطاردة حلمي"

304
00:23:00,200 --> 00:23:02,120
‫"تحفيزك أمر سهل"

305
00:23:02,240 --> 00:23:04,080
‫"كل شيء محسوب"

306
00:23:04,200 --> 00:23:08,040
‫"حتى لو أردت الثوران
‫سينتهي بك الأمر في منطقة الأمان"

307
00:23:08,160 --> 00:23:11,960
‫"تفوز بشيء بينما تخسر آخر"

308
00:23:12,080 --> 00:23:15,960
‫"لن يتغير ذلك حتى لو انتهت الدنيا"

309
00:23:16,080 --> 00:23:24,000
‫"صرخة كبيرة
‫لا يمكن لأحد أن يتحملها"

310
00:23:24,120 --> 00:23:31,400
‫"الحلم الجامح يتجاوز الوقت الآن"

311
00:23:31,520 --> 00:23:35,480
‫"أجج حلمك ليتجاوز الظلام"

312
00:23:35,600 --> 00:23:37,440
‫"مثل شعاع نحو القمة"

313
00:23:37,560 --> 00:23:43,400
‫"سيضيء برودة الليل"

314
00:23:43,520 --> 00:23:47,480
‫"أجج حلمك لتستكشف الطريق"

315
00:23:47,600 --> 00:23:50,400
‫"هيا لجولة أخرى، لا تستسلم أبداً"

316
00:23:50,520 --> 00:23:52,200
‫"اهزمهم في جزء من الثانية"

317
00:23:52,320 --> 00:23:54,440
‫"توجه إلى البلدة التالية تاركاً أثرك"

318
00:23:54,560 --> 00:23:56,520
‫"غبار يتصاعد والخاسر يسقط"

319
00:23:56,640 --> 00:23:58,080
‫"الثرثرة مليئة بالمنطق"

320
00:23:58,200 --> 00:24:00,120
‫"مزعجة للغاية لذا فلنتجاهلها"

321
00:24:00,240 --> 00:24:02,080
‫"الفائز يختفي في الطريق"

322
00:24:02,200 --> 00:24:03,640
‫"وهو شيء سيعرفونه جيداً"

323
00:24:03,920 --> 00:24:11,480
‫"أجج حلمك في الطريق الذي لا ينتهي
‫من أن تنظر إلى ما هو خلفك"

324
00:24:11,600 --> 00:24:15,480
‫"واصل المضي قدماً لكي تسطع"

325
00:24:15,600 --> 00:24:20,520
‫"أجج حلمك لتعيش في الحاضر"

326
00:24:26,480 --> 00:24:31,000
‫"يا معجبي الانجراف ومالكي الـ86
‫نعتذر على طول انتظاركم!"

327
00:24:31,120 --> 00:24:34,640
‫"بدأ (إنيشال دي) وأخيراً"

328
00:24:34,760 --> 00:24:36,320
‫"ما رأيكم بسيارة (تاكومي)
‫في أداء فائق؟"

329
00:24:36,440 --> 00:24:42,120
‫"350 حصاناً، 1،6 لترات بلا توربو
‫وبتقنية الانجراف الرائعة خاصته"

330
00:24:42,320 --> 00:24:44,680
‫"كان ذلك رائعاً، صحيح؟"

331
00:24:44,800 --> 00:24:49,080
‫"المسلسل مليء بمحتوى مميز
‫سيمتع محبي السيارات حتماً"

332
00:24:49,200 --> 00:24:52,680
‫"شاهد سباقاً حماسياً الحلقة القادمة
‫(إعلان الانتقام، توربو صارخ)"

333
00:24:52,800 --> 00:24:54,880
‫لا تفوتوها!