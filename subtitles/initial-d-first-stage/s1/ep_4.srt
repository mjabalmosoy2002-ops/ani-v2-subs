1
00:00:01,000 --> 00:00:02,720
‫"هذه القصة خيالية وأسماء الأشخاص
‫والأماكن والمجموعات وهمية"

2
00:00:02,840 --> 00:00:04,360
‫"الالتزام بقواعد المرور
‫والقيادة بأمان"

3
00:00:23,840 --> 00:00:26,320
‫"المعلومات، تنتشر في غضون ثوان"

4
00:00:26,440 --> 00:00:28,640
‫"لكننا لا نعرف كيف نختاره"

5
00:00:28,760 --> 00:00:30,560
‫"أولئك الذين يقولون
‫"المال لا يشتري حبي"

6
00:00:30,680 --> 00:00:32,520
‫"يستحقون عقوبة"

7
00:00:32,640 --> 00:00:34,440
‫"نحن نمارس الحب وفقاً للكتيبات"

8
00:00:34,560 --> 00:00:36,440
‫"لا نلاحظ قلة الحب"

9
00:00:36,560 --> 00:00:39,040
‫"قبل أن نختنق دعونا نصيح!"

10
00:00:39,160 --> 00:00:40,200
‫"في حلم منتصف الليل"

11
00:00:40,320 --> 00:00:44,160
‫"لا مكان للاسترخاء
‫في المدينة التي لا تنام"

12
00:00:44,280 --> 00:00:48,080
‫"نبتسم بدون أن نتخلى عن حذرنا"

13
00:00:48,200 --> 00:00:52,200
‫"الكذب آمن والحقيقة فارغة"

14
00:00:52,320 --> 00:00:56,240
‫"أريد بشدة أن أثور"

15
00:00:56,360 --> 00:00:58,120
‫"الآن، يجب أن نبدأ دعونا نتحرك"

16
00:00:58,240 --> 00:00:59,880
‫"دعونا ننتقل إلى عالم جديد تماماً"

17
00:01:00,000 --> 00:01:02,120
‫"دعنا نغص في رحلة جديدة"

18
00:01:02,240 --> 00:01:05,840
‫"أنت خائف من عالم كبير"

19
00:01:05,960 --> 00:01:08,160
‫"لقد بدأت للتو"

20
00:01:08,280 --> 00:01:10,120
‫"الآن نذهب بأقصى سرعة
‫ونبض غير تقليدي"

21
00:01:10,240 --> 00:01:11,840
‫"سوف تتألق بالتأكيد"

22
00:01:11,960 --> 00:01:13,760
‫"حول العالم"

23
00:01:13,880 --> 00:01:16,600
‫"رحلة إلى العالم
‫ها نحن نذهب إلى عالم مجهول"

24
00:01:16,720 --> 00:01:18,360
‫"أنت مسافر حديث الولادة"

25
00:01:18,480 --> 00:01:20,400
‫"مشاهدة الخطوات غير المستقرة ممتعة"

26
00:01:20,520 --> 00:01:22,520
‫"قم بإنجاز الأمور بشكل صحيح
‫عند الحاجة فقط"

27
00:01:22,640 --> 00:01:24,040
‫"الكثير من الناس في هذا العالم"

28
00:01:24,160 --> 00:01:26,320
‫"في بعض الأحيان
‫سوف تتلقى الافتراءات"

29
00:01:26,440 --> 00:01:28,360
‫"دعونا نتخلص من الأشياء الرتيبة"

30
00:01:28,480 --> 00:01:29,840
‫"ونعش حياة عقلانية على الأقل"

31
00:01:29,960 --> 00:01:31,760
‫"هذا هو قانوننا"

32
00:01:58,440 --> 00:02:00,680
‫اخرج، يا شبح (أكينا)!

33
00:02:04,000 --> 00:02:06,240
‫"الحلقة الرابعة
‫التحدي الكبير"

34
00:02:06,360 --> 00:02:08,360
‫- ماذا بشأن مقوي الدفع؟
‫- جيد

35
00:02:08,560 --> 00:02:11,360
‫- لا تنس فحص ضغط الهواء أيضاً
‫- حسناً

36
00:02:11,880 --> 00:02:14,680
‫أعتقد أن تحدي اليوم سيكون سهلاً أيضاً
‫لن يكون صعباً كسابقاته

37
00:02:14,800 --> 00:02:16,080
‫اصمت! واعمل بسرعة

38
00:02:20,600 --> 00:02:22,560
‫"الشموس الحمراء"

39
00:02:22,760 --> 00:02:24,520
‫ماذا؟

40
00:02:24,760 --> 00:02:27,080
‫أعطني مفتاح البراغي ذاك

41
00:02:33,080 --> 00:02:34,640
‫ما الذي يفعلونه؟

42
00:02:35,200 --> 00:02:36,760
‫إنهم يغيرون إطارات الـ(إف دي)

43
00:02:37,520 --> 00:02:40,440
‫لديهم الكثير منها في شاحنتهم

44
00:02:41,360 --> 00:02:47,320
‫يغيرونها حتى تلائم الوضع الحالي
‫يبدون كالمتخصصين

45
00:02:47,960 --> 00:02:48,960
‫هراء!

46
00:02:50,840 --> 00:02:52,800
‫إنها جاهزة، يا (كيسكي)

47
00:02:53,200 --> 00:02:54,800
‫ماذا؟ شكراً

48
00:02:55,800 --> 00:02:58,120
‫إنها العاشرة إلا ربعاً، أليس كذلك؟

49
00:02:58,240 --> 00:03:00,560
‫إنها التاسعة وأربعون دقيقة

50
00:03:09,120 --> 00:03:10,120
‫تباً!

51
00:03:10,440 --> 00:03:11,600
‫لم يأت إلى الآن!

52
00:03:12,440 --> 00:03:16,000
‫أخي، تلك الـ86 تغيظني

53
00:03:16,600 --> 00:03:19,520
‫أنا الذي أقنعته بأن يخبر الـ86
‫بأن يمثلهم في هذا التحدي

54
00:03:20,040 --> 00:03:22,080
‫هل كنت مخطئاً!
‫لقد فقدت حماستي!

55
00:03:22,600 --> 00:03:27,800
‫الآن سوف أحقق رقماً قياسياً
‫وسأهزمهم وأذلهم بذلك

56
00:03:27,920 --> 00:03:29,400
‫إذا لم أفعل، فلن أستطيع ذلك أبداً

57
00:03:37,120 --> 00:03:38,840
‫(إيكيتاني) إنها العاشرة تقريباً!

58
00:03:39,240 --> 00:03:41,000
‫أعلم ذلك

59
00:03:50,880 --> 00:03:51,880
‫ماذا بشأنه؟

60
00:03:52,480 --> 00:03:56,040
‫(إيكيتاني)!

61
00:03:56,280 --> 00:03:57,400
‫(إيتزوكي)

62
00:04:00,200 --> 00:04:03,400
‫- متى سيبدأ السباق؟
‫- سنبدأ بعد قليل

63
00:04:03,520 --> 00:04:05,800
‫رائع! في الوقت المناسب

64
00:04:06,040 --> 00:04:08,440
‫ومن سيمثل "نجوم (أكينا)"؟

65
00:04:09,200 --> 00:04:10,280
‫إنه...

66
00:04:10,520 --> 00:04:13,240
‫(كينجي)، كن جاهزاً في أي لحظة

67
00:04:13,640 --> 00:04:15,200
‫نعم

68
00:04:16,520 --> 00:04:18,320
‫أنت ستمثل الفريق!

69
00:04:18,440 --> 00:04:21,520
‫حظاً موفقاً! أعتمد عليك

70
00:04:26,760 --> 00:04:28,120
‫هنا خط البداية

71
00:04:28,440 --> 00:04:29,480
‫هل أنت مستعد؟

72
00:04:31,800 --> 00:04:33,200
‫هنا خط النهاية

73
00:04:33,400 --> 00:04:35,080
‫كل شخص في مكانه

74
00:04:35,520 --> 00:04:36,960
‫ابدؤوا في أي وقت

75
00:04:37,760 --> 00:04:38,760
‫علم!

76
00:04:39,480 --> 00:04:41,840
‫هل نبدأ الآن؟

77
00:04:42,880 --> 00:04:45,040
‫لم يأت في النهاية

78
00:04:46,080 --> 00:04:47,080
‫أنا أعتمد عليك يا (كينجي)

79
00:04:48,200 --> 00:04:49,200
‫نعم

80
00:04:59,000 --> 00:05:02,000
‫هل تمزح معي؟
‫هذا منافسي؟

81
00:05:05,320 --> 00:05:06,320
‫(كينجي)

82
00:05:06,880 --> 00:05:08,480
‫تبدو شاحباً

83
00:05:08,680 --> 00:05:10,000
‫أنت تتعرق!

84
00:05:10,120 --> 00:05:11,880
‫نحن أيضاً نشعر بمشاعرك
‫بمجرد النظر إليك

85
00:05:12,040 --> 00:05:13,800
‫سهل عليك قول ذلك، ولكن...

86
00:05:13,920 --> 00:05:15,440
‫كن قاسياً! ولئيماً معهم

87
00:05:16,080 --> 00:05:18,880
‫حسناً، سنبدأ بالعد

88
00:05:19,000 --> 00:05:20,000
‫تباً

89
00:05:24,000 --> 00:05:25,200
‫01 ثوان

90
00:05:25,440 --> 00:05:26,800
‫"انتظر قليلاً!"

91
00:05:26,920 --> 00:05:30,640
‫"هنا خط النهاية!
‫هنالك سيارة قادمة إليكم"

92
00:05:33,280 --> 00:05:35,360
‫لا تريدونها أثناء السباق

93
00:05:36,080 --> 00:05:37,200
‫"هل ننتظر إلى أن تصل إلى الأعلى؟"

94
00:05:38,520 --> 00:05:45,360
‫هذا طريق عام ستكون هنالك
‫سيارات دوماً! انس الموضوع! ولنبدأ

95
00:05:45,560 --> 00:05:49,680
‫- حسناً
‫- انتظر قليلاً اسأله، ما نوع السيارة

96
00:05:52,280 --> 00:05:53,720
‫ما هي السيارة التي عبرت؟

97
00:05:54,400 --> 00:05:57,920
‫أعتقد أنها سيارة لها
‫أضواء منبثقة

98
00:05:58,480 --> 00:06:00,160
‫"أعتقد أنها (تورينو) الـ86"

99
00:06:03,480 --> 00:06:04,480
‫أعطني ذلك!

100
00:06:05,800 --> 00:06:07,600
‫ما لون تلك السيارة؟

101
00:06:08,360 --> 00:06:10,320
‫"لماذا أنتم مهتمون بهذا الأمر؟"

102
00:06:11,120 --> 00:06:12,160
‫"إنها بيضاء وسوداء"

103
00:06:12,760 --> 00:06:13,760
‫"(تورينو) صغيرة"

104
00:06:15,840 --> 00:06:16,840
‫إنه هنا!

105
00:06:19,920 --> 00:06:21,960
‫لقد ظهرت فريستي!

106
00:06:23,280 --> 00:06:25,360
‫ما الذي ستفعلونه؟
‫هل نبدأ العد؟

107
00:06:25,520 --> 00:06:26,600
‫ليس بعد!

108
00:06:27,120 --> 00:06:28,560
‫انتظر حتى تصل تلك الـ86

109
00:06:29,560 --> 00:06:34,440
‫منافسي لا يجب أن يختلف عني كثيراً

110
00:06:35,520 --> 00:06:36,920
‫أنت محق

111
00:06:38,360 --> 00:06:40,000
‫(كينجي) يمكنك الاستراحة!

112
00:06:40,360 --> 00:06:42,360
‫نعم، هذا مريح

113
00:06:42,880 --> 00:06:45,120
‫عيناك كانتا تلمعان!

114
00:06:45,360 --> 00:06:46,760
‫وأنت أيضاً

115
00:06:47,480 --> 00:06:53,560
‫لقد جاء لأجلنا
‫وليحمي سمعة "نجوم (أكينا)"

116
00:06:54,840 --> 00:07:00,240
‫هذا لا يهم الآن!
‫لست بحاجة لمعرفة من سينتصر

117
00:07:18,320 --> 00:07:19,680
‫ما هذا؟

118
00:07:20,520 --> 00:07:21,600
‫يبدو غريباً

119
00:07:22,560 --> 00:07:24,520
‫هناك أشخاص عند كل منعطف

120
00:07:25,560 --> 00:07:28,120
‫ما الذي يفعلونه هنا؟

121
00:07:29,960 --> 00:07:32,880
‫أعتقد أنني جئت إلى مكان غريب

122
00:07:34,000 --> 00:07:37,040
‫لا بأس
‫لأنني إذا ربحت سأحظى بخزان مملوء

123
00:07:37,360 --> 00:07:39,360
‫وسأذهب إلى الشاطئ
‫من دون أن أنفق نقودي

124
00:07:56,120 --> 00:07:58,200
‫ما الأمر؟ يا (تاكاشي)؟

125
00:07:58,480 --> 00:07:59,520
‫مهارة رائعة!

126
00:07:59,920 --> 00:08:04,200
‫يبرع عند المنعطفات

127
00:08:04,600 --> 00:08:05,600
‫"ماذا!؟"

128
00:08:06,560 --> 00:08:07,760
‫ألم تروا ذلك؟

129
00:08:08,480 --> 00:08:09,880
‫إذا كنت تعتقد ذلك

130
00:08:10,000 --> 00:08:14,880
‫بالنسبة إلينا
‫هي 86 عادية وسائقها عادي مثلها

131
00:08:16,280 --> 00:08:22,560
‫سيارة يقودها سائق يستطيع التحكم بها
‫ولديه خبرة في موضوع السباقات

132
00:08:23,640 --> 00:08:27,000
‫(ريوسكي تاكاشي) لديه خبرة كبيرة

133
00:08:28,080 --> 00:08:29,760
‫وخبرة أخيه الصغير لا تزال ضعيفة

134
00:08:30,920 --> 00:08:34,400
‫ولكن سائق تلك الـ86 لديه خبرة كبيرة

135
00:08:35,160 --> 00:08:40,680
‫إذا مثل (أكينا) سوف يفوز لا محالة

136
00:08:44,600 --> 00:08:45,600
‫كاد يصل

137
00:08:46,480 --> 00:08:47,720
‫لقد جاء بالفعل!

138
00:08:48,320 --> 00:08:50,000
‫الأسرع في هضبة (أكينا)!

139
00:08:50,600 --> 00:08:52,320
‫"أسطورة السرعة"

140
00:08:53,680 --> 00:08:57,920
‫سنريهم قوة متحدي (أكينا)!

141
00:08:58,960 --> 00:09:00,280
‫هيا يا 86

142
00:09:00,640 --> 00:09:03,640
‫أتوق لأرى من سيخرج من تلك السيارة

143
00:09:04,160 --> 00:09:06,040
‫لم أتحمس هكذا منذ زمن

144
00:09:07,440 --> 00:09:08,920
‫لقد جعلنا ننتظره طويلاً

145
00:09:09,680 --> 00:09:11,160
‫لكن أسلوباً كهذا لن ينطلي علي

146
00:09:11,960 --> 00:09:13,720
‫سأراقبك عن كثب

147
00:09:18,120 --> 00:09:19,120
‫ها هو قادم!

148
00:09:19,640 --> 00:09:22,640
‫أعطه إشارة ليعرف أين خط البداية

149
00:09:32,720 --> 00:09:34,040
‫ما هي تلك السيارة؟

150
00:09:34,280 --> 00:09:36,000
‫هل كان الجميع ينتظرون هذه؟

151
00:09:36,640 --> 00:09:38,200
‫ولكنها 86

152
00:09:38,400 --> 00:09:43,240
‫من أين جاء كل هؤلاء الأشخاص؟

153
00:09:57,480 --> 00:09:59,960
‫"محل (فوجي وارا) للتوفو"

154
00:10:00,200 --> 00:10:01,840
‫اعذرني!

155
00:10:02,840 --> 00:10:04,280
‫الـ86! أيمكن أن يكون...

156
00:10:11,640 --> 00:10:12,640
‫(تاكومي)!

157
00:10:13,280 --> 00:10:14,680
‫إنه هو

158
00:10:27,480 --> 00:10:29,080
‫إذاً هذا هو الشخص...

159
00:10:33,200 --> 00:10:35,320
‫"(إنيشال دي)"

160
00:10:38,040 --> 00:10:40,040
‫"(إنيشال دي)"

161
00:10:42,440 --> 00:10:43,440
‫(تاكومي)

162
00:10:45,040 --> 00:10:47,160
‫ما الذي يحدث؟
‫ما الذي حدث لوالدك؟

163
00:10:47,560 --> 00:10:50,000
‫طلب مني والدي أن أحضر إلى هنا

164
00:10:50,320 --> 00:10:54,160
‫حتى إذا كانت السيارة هنا
‫بدون والدك فلا فائدة من ذلك

165
00:10:54,360 --> 00:10:55,360
‫ماذا!؟

166
00:10:55,760 --> 00:10:57,400
‫ما الذي ستفعله، يا (إيكيتاني)

167
00:10:57,520 --> 00:10:59,600
‫ماذا عن قولك بأننا سنكون بخير

168
00:11:00,040 --> 00:11:02,400
‫- كنت أعلم أنني لا يجب أن أحضر
‫- النهاية (كينجي) سيقود السباق

169
00:11:02,840 --> 00:11:05,480
‫تباً! أبي، لقد أحرجتني

170
00:11:06,160 --> 00:11:09,000
‫(تاكومي)، ألم يقل أبوك شيئاً آخر؟

171
00:11:09,760 --> 00:11:16,040
‫لقد طلب مني هزم (إف دي)

172
00:11:16,400 --> 00:11:17,400
‫ماذا!؟

173
00:11:17,560 --> 00:11:20,600
‫طلب منك القيادة؟

174
00:11:21,280 --> 00:11:22,280
‫نعم

175
00:11:22,720 --> 00:11:26,960
‫هل تستطيع هزم (كيسكي تاكاشي)؟

176
00:11:28,080 --> 00:11:31,400
‫لن أعرف حتى نبدأ

177
00:11:32,880 --> 00:11:34,720
‫لكنني هزمته سابقاً

178
00:11:35,360 --> 00:11:37,040
‫هزمته سابقاً

179
00:11:37,720 --> 00:11:43,080
‫سأحظى بخزان مملوء إذا انتصرت
‫وسأنتصر مهما حصل

180
00:11:47,760 --> 00:11:50,600
‫اعذرني، اعذرني!

181
00:11:51,040 --> 00:11:53,680
‫(تاكومي)! أيها الغبي

182
00:11:54,680 --> 00:11:56,680
‫ما الذي تفعله؟

183
00:11:57,280 --> 00:12:00,520
‫(تاكومي)! أنت غبي جداً

184
00:12:00,640 --> 00:12:04,320
‫أنا خجل من نفسي فقط
‫برؤيتك تقول هذا!

185
00:12:04,720 --> 00:12:05,960
‫أبعد سيارتك حالاً

186
00:12:06,080 --> 00:12:07,800
‫لا تتدخل في السباق

187
00:12:08,200 --> 00:12:09,920
‫اصعد إلى الـ86

188
00:12:10,040 --> 00:12:11,520
‫انتظر يا (إيتزوكي)

189
00:12:12,680 --> 00:12:14,480
‫(إيكيتاني)! أنا متأسف

190
00:12:14,600 --> 00:12:17,680
‫إنه غبي ولا يفهم هذا الأمر

191
00:12:19,000 --> 00:12:20,440
‫سامحه، أرجوك!

192
00:12:21,440 --> 00:12:27,760
‫(تاكومي) هل أنت من يوصل
‫الطلبات مع والدك في سيارته؟

193
00:12:28,160 --> 00:12:29,960
‫أوصلها دائماً

194
00:12:30,320 --> 00:12:31,320
‫على مر السنوات الخمس الماضية

195
00:12:31,720 --> 00:12:32,960
‫السنوات الخمس الماضية؟

196
00:12:37,080 --> 00:12:39,200
‫الآن فهمت يا (تاكومي)!

197
00:12:40,640 --> 00:12:44,040
‫حسناً، سأدعك تتحدى على المنحدر

198
00:12:44,160 --> 00:12:46,160
‫ما الذي تقوله يا (إيكيتاني)؟

199
00:12:46,400 --> 00:12:49,440
‫مبتدئ مثل (تاكومي) يتحدى المنحدر!

200
00:12:49,560 --> 00:12:51,880
‫خلال دقيقة سوف يصطدم ويموت

201
00:12:52,000 --> 00:12:55,240
‫لا تقلق
‫قف جانباً وسوف ترى ذلك

202
00:13:00,080 --> 00:13:01,880
‫شكراً، لحضورك يا (تاكومي)

203
00:13:02,720 --> 00:13:05,080
‫- أنا أعتمد عليك!
‫- نعم

204
00:13:06,240 --> 00:13:08,000
‫أعتذر لانتظارك

205
00:13:08,600 --> 00:13:11,000
‫حقاً، لقد سئمت الانتظار

206
00:13:14,760 --> 00:13:15,920
‫أنت يافع جداً

207
00:13:17,440 --> 00:13:18,440
‫ما اسمك؟

208
00:13:18,720 --> 00:13:20,200
‫(تاكومي فوجي وارا)

209
00:13:20,640 --> 00:13:21,680
‫سأتذكر اسمك دائماً

210
00:13:22,320 --> 00:13:23,720
‫أنا (كيسكي تاكاشي)

211
00:13:24,440 --> 00:13:26,360
‫لن أكرر الخطأ نفسه مرتين

212
00:13:32,880 --> 00:13:34,720
‫هل هذا الفعل الصحيح؟

213
00:13:35,120 --> 00:13:37,560
‫لمن الغباء مجاراة (إف دي)
‫بـ86 قديمة

214
00:13:37,680 --> 00:13:42,400
‫هناك فرق كبير في الطاقة (إف دي)
‫من أفضل السيارات عند المنعطفات

215
00:13:42,840 --> 00:13:46,040
‫في جميع الحالات الـ86 متخلفة جداً

216
00:13:47,800 --> 00:13:49,600
‫يجب أن نؤمن به فقط

217
00:13:58,680 --> 00:14:00,720
‫سنبدأ العد

218
00:14:00,840 --> 00:14:02,360
‫- "علم"
‫- "علم"

219
00:14:03,240 --> 00:14:04,760
‫10 ثوان

220
00:14:06,280 --> 00:14:09,200
‫9، 8، 7

221
00:14:10,000 --> 00:14:12,800
‫6، 5، 4

222
00:14:13,680 --> 00:14:16,600
‫3، 2، 1

223
00:14:17,280 --> 00:14:18,680
‫انطلاق!

224
00:14:43,360 --> 00:14:46,000
‫(إف دي) أسرع بكثير!

225
00:14:46,520 --> 00:14:48,600
‫350 حصاناً، ليست قوة قليلة أبداً

226
00:14:49,000 --> 00:14:50,320
‫انتقال مثالي

227
00:14:50,520 --> 00:14:51,760
‫لا يمكن مقارنتها

228
00:14:51,960 --> 00:14:55,600
‫بسرعتها العالية
‫الـ86 كانت لا تزال كأنها لا تتحرك

229
00:14:57,280 --> 00:14:59,040
‫(تاكومي)

230
00:15:01,080 --> 00:15:06,600
‫بالمناسبة، تلك الـ86
‫بقوة 150 حصاناً فقط

231
00:15:07,560 --> 00:15:10,040
‫ليست بالشبح الذي تكلم عنه (كيسكي)

232
00:15:11,520 --> 00:15:15,080
‫السبب الذي يدعه ينتقل بسهولة
‫أنه يملك تروساً مختلفة

233
00:15:16,000 --> 00:15:19,040
‫لا بد أنها الأفضل لهضبة (أكينا)

234
00:15:20,240 --> 00:15:24,600
‫ما زلت لا أعتقد
‫أن (كيسكي) سيهزم اليوم

235
00:15:26,560 --> 00:15:30,680
‫الشبح ليست السيارة ولكنه السائق!

236
00:15:39,040 --> 00:15:40,200
‫لن أسمح له بالاقتراب!

237
00:15:40,840 --> 00:15:44,640
‫لا أحبذ استخدام الطريق المستقيم للفوز
‫ولكن هذا للرقم القياسي

238
00:15:45,640 --> 00:15:48,560
‫سأسبقه

239
00:16:28,360 --> 00:16:32,320
‫ماذا!؟ هنا المنعطف الأول!
‫الـ86 حققت مناورة عرضية رائعة

240
00:16:32,640 --> 00:16:35,000
‫"لقد كانت المسافة
‫5 سنتيميترات بين الحاجز والسيارة"

241
00:16:35,440 --> 00:16:38,080
‫"لم أر أحداً
‫يناور بالسيارة عرضياً هكذا"

242
00:16:52,280 --> 00:16:53,280
‫ماذا!

243
00:16:54,080 --> 00:16:55,080
‫إنه يقترب مني

244
00:16:55,680 --> 00:16:57,120
‫يقترب!؟

245
00:17:00,240 --> 00:17:02,920
‫لا بد أنها مخيلتي
‫هذا مستحيل

246
00:17:51,560 --> 00:17:52,840
‫هل أنت جاد؟

247
00:17:53,120 --> 00:17:56,840
‫والد (تاكومي) كان أفضل سائقي (أكينا)؟

248
00:17:57,360 --> 00:17:58,360
‫نعم

249
00:17:58,480 --> 00:18:00,960
‫لقد رأيته مرات عديدة

250
00:18:01,440 --> 00:18:03,880
‫لكنه شخص عادي يملك محل توفو

251
00:18:04,200 --> 00:18:06,960
‫أعتقد أنك لا تستطيع الحكم
‫على الشخص من مظهره

252
00:18:07,280 --> 00:18:10,760
‫بالنسبة إليه
‫لا يزال الأسرع في منحدرات (أكينا)

253
00:18:12,640 --> 00:18:18,920
‫مهما يكن، فهو من أرسل (تاكومي)
‫ليحل محله، يجب علينا الوثوق به

254
00:18:19,280 --> 00:18:22,040
‫نعم، ذلك أفضل من أن أتحداه أنا

255
00:18:22,200 --> 00:18:25,200
‫ولكن إذا كان والد (تاكومي) سريعاً
‫فهذا لا يعني...

256
00:18:26,720 --> 00:18:31,000
‫ولكن (تاكومي) هزم (كيسكي) سابقاً

257
00:18:31,440 --> 00:18:36,640
‫ماذا؟
‫(تاكومي)! هزم (كيسكي تاكاشي)؟

258
00:18:39,440 --> 00:18:42,720
‫لا أستطيع تصديق ذلك!
‫(تاكومي) المخادع

259
00:18:42,840 --> 00:18:45,440
‫لم يكن يعرف ماهية الـ86

260
00:19:00,320 --> 00:19:02,040
‫ما قصة تلك الـ86؟

261
00:19:02,480 --> 00:19:07,760
‫"بسرعة رهيبة يستطيع تحرير الإطارات
‫الخلفية ليناور بالسيارة بطريقة رائعة"

262
00:19:08,240 --> 00:19:09,720
‫"لن أفاجأ إذا اصطدم بسيارته
‫إنه مجنون"

263
00:19:09,880 --> 00:19:11,440
‫"نخاف عندما يقترب من المنعطفات!"

264
00:19:25,160 --> 00:19:26,160
‫لقد لحق بي

265
00:19:26,600 --> 00:19:29,360
‫ما الذي يحدث؟ هل فقدت صوابي؟

266
00:20:00,400 --> 00:20:03,600
‫عند الترس الثاني السرعة متساوية
‫ولكن الانحدار مختلف

267
00:20:04,760 --> 00:20:07,160
‫لو كان الطريق المستقيم طويلاً
‫لكان الآن عند النهاية

268
00:20:19,280 --> 00:20:20,920
‫هنا الطريق المستقيم
‫عند ساحة التزلج

269
00:20:21,040 --> 00:20:22,520
‫عبر الاثنان من هنا للتو

270
00:20:22,800 --> 00:20:24,400
‫إنه خلف (كيسكي) مباشرة!

271
00:20:24,560 --> 00:20:26,640
‫الـ86 سريعة جداً

272
00:20:27,640 --> 00:20:32,400
‫"هل هذا حقيقي!؟ لم يبق أحداً
‫قريباً من (كيسكي) في كل سباقاته"

273
00:20:36,560 --> 00:20:39,240
‫أنا متحمس، جداً

274
00:20:39,760 --> 00:20:45,920
‫"في الطريق المستقيم سيسبقه (كيسكي)
‫وبعدها هناك الكثير من المنعطفات"

275
00:20:46,800 --> 00:20:48,240
‫هل تستمع يا (ريوسكي)؟

276
00:20:48,440 --> 00:20:49,720
‫أخطأنا حساباتنا

277
00:20:50,560 --> 00:20:53,360
‫لم نكن نعلم بأن (أكينا)
‫تملك سائقاً كهذا

278
00:21:29,720 --> 00:21:31,120
‫اندفاع رائع

279
00:21:31,840 --> 00:21:33,240
‫"تلك الـ86 كانت رائعة في اندفاعها"

280
00:21:33,360 --> 00:21:35,160
‫"كانت عملية جنونية!"

281
00:21:35,360 --> 00:21:37,680
‫"إنه لا يخاف أبداً"

282
00:21:39,800 --> 00:21:41,560
‫على الطريق المستقيم، أنا سريع

283
00:21:42,080 --> 00:21:43,560
‫ولكنه يلحق بي!

284
00:21:43,960 --> 00:21:45,680
‫هذا يعني أن المنعطفات تعيقني

285
00:21:46,640 --> 00:21:50,600
‫أن تجاريني سيارة قديمة، هذا محرج

286
00:21:51,920 --> 00:21:55,080
‫سأموت ولن أقبل بذلك

287
00:22:01,040 --> 00:22:06,640
‫أبي لن يعترف بفوزي
‫إن لم أتجاوز تلك السيارة

288
00:22:08,960 --> 00:22:13,000
‫ليس لدي خيار آخر
‫سأفعلها، خزان مملوء بالأوكتان ينتظرني

289
00:22:14,280 --> 00:22:18,320
‫سوف أفعلها
‫عند المنعطفات الخمسة القادمة

290
00:22:42,560 --> 00:22:44,920
‫"يخبرني فخري أن أكون جامحاً وقوياً"

291
00:22:45,040 --> 00:22:46,920
‫"لا أسمح للآخرين بالتدخل"

292
00:22:47,040 --> 00:22:48,800
‫"لا أتوقف أبداً، ولا أريد التوقف"

293
00:22:48,920 --> 00:22:50,720
‫"حتى لو ضحيت بكل ما أحب"

294
00:22:50,840 --> 00:22:53,040
‫"أتوجه نحو القمة، ولا أكترث لشيء"

295
00:22:53,160 --> 00:22:54,960
‫"احذروا، فأصوات التحذير تملأ المكان"

296
00:22:55,080 --> 00:22:56,400
‫"ولا مجال للضعفاء"

297
00:22:56,520 --> 00:22:58,720
‫"لأنني لن أكف عن مطاردة حلمي"

298
00:22:58,840 --> 00:23:00,760
‫"تحفيزك أمر سهل"

299
00:23:00,880 --> 00:23:02,720
‫"كل شيء محسوب"

300
00:23:02,840 --> 00:23:06,680
‫"حتى لو أردت الثوران
‫سينتهي بك الأمر في منطقة الأمان"

301
00:23:06,800 --> 00:23:10,600
‫"تفوز بشيء بينما تخسر آخر"

302
00:23:10,720 --> 00:23:14,600
‫"لن يتغير ذلك حتى لو انتهت الدنيا"

303
00:23:14,720 --> 00:23:22,640
‫"صرخة كبيرة
‫لا يمكن لأحد أن يتحملها"

304
00:23:22,760 --> 00:23:30,040
‫"الحلم الجامح يتجاوز الوقت الآن"

305
00:23:30,160 --> 00:23:34,120
‫"أجج حلمك ليتجاوز الظلام"

306
00:23:34,240 --> 00:23:36,080
‫"مثل شعاع نحو القمة"

307
00:23:36,200 --> 00:23:42,040
‫"سيضيء برودة الليل"

308
00:23:42,160 --> 00:23:46,120
‫"أجج حلمك لتستكشف الطريق"

309
00:23:46,240 --> 00:23:49,040
‫"هيا لجولة أخرى، لا تستسلم أبداً"

310
00:23:49,160 --> 00:23:50,840
‫"اهزمهم في جزء من الثانية"

311
00:23:50,960 --> 00:23:53,080
‫"توجه إلى البلدة التالية تاركاً أثرك"

312
00:23:53,200 --> 00:23:55,160
‫"غبار يتصاعد والخاسر يسقط"

313
00:23:55,280 --> 00:23:56,720
‫"الثرثرة مليئة بالمنطق"

314
00:23:56,840 --> 00:23:58,760
‫"مزعجة للغاية لذا فلنتجاهلها"

315
00:23:58,880 --> 00:24:00,720
‫"الفائز يختفي في الطريق"

316
00:24:00,840 --> 00:24:02,280
‫"وهو شيء سيعرفونه جيداً"

317
00:24:02,560 --> 00:24:10,120
‫"أجج حلمك في الطريق الذي لا ينتهي
‫من أن تنظر إلى ما هو خلفك"

318
00:24:10,240 --> 00:24:14,400
‫"واصل المضي قدماً لكي تسطع"

319
00:24:14,520 --> 00:24:19,160
‫"أجج حلمك لتعيش في الحاضر"

320
00:24:25,160 --> 00:24:27,920
‫- "بدأ السباق وأخيراً يا (تاكومي)"
‫- "أجل"

321
00:24:28,040 --> 00:24:31,520
‫- "هل تدربت لهذه المعركة؟"
‫- "ليس حقيقة"

322
00:24:31,640 --> 00:24:33,160
‫"هذا كتوصيل التوفو"

323
00:24:33,280 --> 00:24:37,560
‫- "عملك اليومي مفيد إذاً"
‫- "صحيح تقريباً"

324
00:24:37,680 --> 00:24:40,120
‫"هل لديك خطة سرية
‫لهزيمة (إف دي)؟"

325
00:24:40,240 --> 00:24:42,480
‫"ليست سرية، لكن..."

326
00:24:42,600 --> 00:24:48,640
‫"عليك الفوز لتستخدم السيارة
‫بخزان مملوء لتواعد (ناتسوكي)"

327
00:24:48,760 --> 00:24:52,720
‫"الحلقة القادمة، سيحصل شيء
‫عند المنعطفات الخمس"