1
00:00:01,000 --> 00:00:02,480
‫"هذه القصة خيالية وأسماء الأشخاص
‫والأماكن والمجموعات وهمية"

2
00:00:02,600 --> 00:00:04,360
‫"الالتزام بقواعد المرور
‫والقيادة بأمان"

3
00:00:23,760 --> 00:00:26,280
‫"المعلومات، تنتشر في غضون ثوان"

4
00:00:26,400 --> 00:00:28,600
‫"لكننا لا نعرف كيف نختاره"

5
00:00:28,720 --> 00:00:30,520
‫"أولئك الذين يقولون
‫المال لا يشتري حبي"

6
00:00:30,640 --> 00:00:32,480
‫"يستحقون عقوبة"

7
00:00:32,600 --> 00:00:34,400
‫"نحن نمارس الحب وفقاً للكتيبات"

8
00:00:34,520 --> 00:00:36,360
‫"لا نلاحظ قلة الحب"

9
00:00:36,480 --> 00:00:39,000
‫"قبل أن نختنق دعونا نصيح!"

10
00:00:39,120 --> 00:00:40,120
‫"في حلم منتصف الليل"

11
00:00:40,240 --> 00:00:44,120
‫"لا مكان للاسترخاء
‫في المدينة التي لا تنام"

12
00:00:44,240 --> 00:00:48,040
‫"نبتسم بدون أن نتخلى عن حذرنا"

13
00:00:48,160 --> 00:00:52,160
‫"الكذب آمن والحقيقة فارغة"

14
00:00:52,280 --> 00:00:56,200
‫"أريد بشدة أن أثور"

15
00:00:56,320 --> 00:00:58,080
‫"الآن، يجب أن نبدأ دعونا نتحرك"

16
00:00:58,200 --> 00:00:59,840
‫"دعونا ننتقل إلى عالم جديد تماماً"

17
00:00:59,960 --> 00:01:02,080
‫"دعنا نغص في رحلة جديدة"

18
00:01:02,200 --> 00:01:05,800
‫"أنت خائف من عالم كبير"

19
00:01:05,920 --> 00:01:08,120
‫"لقد بدأت للتو"

20
00:01:08,240 --> 00:01:10,080
‫"الآن نذهب بأقصى سرعة
‫ونبض غير تقليدي"

21
00:01:10,200 --> 00:01:11,800
‫"سوف تتألق بالتأكيد"

22
00:01:11,920 --> 00:01:13,720
‫"حول العالم"

23
00:01:13,840 --> 00:01:16,560
‫"رحلة إلى العالم
‫ها نحن نذهب إلى عالم مجهول"

24
00:01:16,680 --> 00:01:18,320
‫"أنت مسافر حديث الولادة"

25
00:01:18,440 --> 00:01:20,360
‫"مشاهدة الخطوات غير المستقرة ممتعة"

26
00:01:20,480 --> 00:01:22,440
‫"قم بإنجاز الأمور بشكل صحيح
‫عند الحاجة فقط"

27
00:01:22,560 --> 00:01:23,960
‫"الكثير من الناس في هذا العالم"

28
00:01:24,080 --> 00:01:26,280
‫"في بعض الأحيان
‫سوف تتلقى الافتراءات"

29
00:01:26,400 --> 00:01:28,320
‫"دعونا نتخلص من الأشياء الرتيبة"

30
00:01:28,440 --> 00:01:29,800
‫"ونعش حياة عقلانية على الأقل"

31
00:01:29,920 --> 00:01:31,720
‫"هذا هو قانوننا"

32
00:01:46,920 --> 00:01:49,480
‫انظرا إلى الحشد!

33
00:01:50,320 --> 00:01:53,440
‫الناس يتزايدون أكثر فأكثر
‫منذ تحدي (إف دي)!

34
00:01:53,600 --> 00:01:59,160
‫التحدي بين (تاكومي) و(تاكيشي) يزداد
‫إثارة

35
00:02:00,240 --> 00:02:04,160
‫ما الذي سأفعله؟
‫أزداد إحباطاً في كل دقيقة تمر

36
00:02:06,400 --> 00:02:10,640
‫لا يحق لنا لومه في عدم قدومه

37
00:02:11,600 --> 00:02:13,000
‫(تاكومي)!

38
00:02:13,560 --> 00:02:16,920
‫اظهر أرجوك!

39
00:02:21,000 --> 00:02:25,640
‫"الحلقة الثامنة
‫اللحظة الحاسمة!"

40
00:02:28,600 --> 00:02:29,760
‫تباً

41
00:02:29,880 --> 00:02:30,920
‫أبي أيها العجوز!

42
00:02:31,200 --> 00:02:33,040
‫أين أنت؟

43
00:02:33,680 --> 00:02:36,480
‫هل تستطيع الفوز
‫إذا تحديته أنت؟

44
00:02:38,760 --> 00:02:40,160
‫بالتأكيد

45
00:02:40,920 --> 00:02:43,360
‫لا يهم أية سيارة تكون الـ32 أو غيرها

46
00:02:45,760 --> 00:02:48,720
‫هل تعتقد بأنه يمكنني الفوز؟

47
00:02:49,960 --> 00:02:53,560
‫أنا أعلم أنه لم يكن قرارك
‫أن تقبل هذا التحدي

48
00:02:54,240 --> 00:02:57,240
‫لكن لا تدخل التحدي
‫خصوصاً أمام تلك الـ32

49
00:02:57,360 --> 00:03:03,320
‫لن يلومك أحد
‫إذا تراجعت عن التحدي

50
00:03:03,440 --> 00:03:04,920
‫أتراجع

51
00:03:13,280 --> 00:03:16,200
‫ها هو ذا

52
00:03:16,480 --> 00:03:17,720
‫"شبان الليل"

53
00:03:17,840 --> 00:03:19,760
‫إنها الـ32 الخاصة بـ(تاكيشي)

54
00:03:31,320 --> 00:03:32,880
‫مدهشة

55
00:03:33,000 --> 00:03:37,080
‫تلك الـ32 السوداء تبدو كبطلة التحديات

56
00:03:40,720 --> 00:03:42,880
‫هؤلاء هم "شبان الليل" إذاً

57
00:03:46,720 --> 00:03:49,160
‫لا بد أنهم أتوا مع مجموعتهم الكبيرة

58
00:03:49,840 --> 00:03:53,200
‫(كينجي)
‫دعونا نبدأ بالاعتذار الآن

59
00:03:53,320 --> 00:03:55,400
‫ولكن...

60
00:03:55,800 --> 00:03:58,120
‫لم تدق الساعة العاشرة بعد

61
00:03:58,920 --> 00:04:01,200
‫دعونا نتكلم معهم

62
00:04:01,320 --> 00:04:02,480
‫ماذا؟

63
00:04:02,600 --> 00:04:08,760
‫لا أعتقد أنها فكرة صائبة
‫أن نشرك (تاكومي) في تحد خاسر

64
00:04:09,320 --> 00:04:12,200
‫لن نعرف ذلك حتى يتسابقا

65
00:04:12,320 --> 00:04:13,880
‫بالطبع سيخسر

66
00:04:14,680 --> 00:04:16,840
‫النتيجة بسيطة إن فكرت بها قليلاً

67
00:04:17,000 --> 00:04:18,680
‫سيتحدى الـ32

68
00:04:18,840 --> 00:04:22,640
‫لا يستطيع تحدي نظام الـ(تي إس)
‫وأيضاً الدفع الرباعي

69
00:04:23,280 --> 00:04:25,680
‫لقد اعتقدت ذات الشيء بالبداية

70
00:04:27,080 --> 00:04:31,160
‫ولكن منذ أن وصلت هنا
‫قلت لربما يمكن حدوث العكس

71
00:04:31,520 --> 00:04:34,760
‫بالطبع إن كانت هذه المنطقة غريبة
‫فالـ86 ستخسر

72
00:04:35,400 --> 00:04:37,360
‫ولكن هذه (أكينا)

73
00:04:38,920 --> 00:04:41,800
‫هنا تمرن (تاكومي) طيلة خمس سنوات

74
00:04:41,920 --> 00:04:44,080
‫لا أحد يعلم بما سيحدث

75
00:04:44,520 --> 00:04:48,960
‫عندما يقود (تاكومي) الـ86
‫فهي لا تكون 86 عادية

76
00:04:49,440 --> 00:04:52,680
‫تتحول إلى جهاز نابض بالحياة
‫يستطيع هزم أقوى المتنافسين

77
00:04:53,120 --> 00:04:57,920
‫أنا أعلم ذلك لأنني كنت معه في السيارة

78
00:04:58,320 --> 00:05:02,600
‫قيادة (تاكومي) ممتازة
‫لدرجة لم نتخيلها أبداً

79
00:05:02,720 --> 00:05:06,080
‫تعني تلك المرة عندما أغمي عليك
‫بعد المنعطف الثالث

80
00:05:06,200 --> 00:05:08,880
‫وصيحات استغاثتك وصلت السماء

81
00:05:10,480 --> 00:05:13,880
‫قيادته بالفعل جنونية! فلا تلمني

82
00:05:14,880 --> 00:05:18,280
‫لا بد أن أحداً غيرنا يشعر بنفس الشعور

83
00:05:18,400 --> 00:05:20,760
‫من تقصد بذلك؟

84
00:05:22,120 --> 00:05:26,400
‫شخص ينتظر رؤية أسلوبه بفارغ الصبر

85
00:05:26,560 --> 00:05:28,160
‫هل تقصد...

86
00:05:28,520 --> 00:05:29,760
‫هذا صحيح!

87
00:05:31,760 --> 00:05:34,480
‫(كيسكي تاكاشي)
‫من الـ"الشموس الحمراء"!

88
00:05:37,920 --> 00:05:40,040
‫ها هما الأخوان (تاكاشي)

89
00:05:40,160 --> 00:05:42,720
‫الآن لدينا الكثير من النجوم
‫أنا متحمس!

90
00:05:45,560 --> 00:05:47,440
‫(كيسكي)

91
00:05:47,560 --> 00:05:50,520
‫- عزيزي (ريوسكي)
‫- تبدو رائعاً

92
00:05:51,480 --> 00:05:54,680
‫لديهما عاشقات من كل مكان!
‫يا لهما من محظوظين

93
00:05:54,800 --> 00:05:57,840
‫تباً! المتسابقون
‫يجب أن يقدروا لمهاراتهم

94
00:06:02,280 --> 00:06:04,200
‫"أنا لا أقارن بهما لأتكلم هكذا"

95
00:06:04,320 --> 00:06:05,720
‫كما أنهما غنيان

96
00:06:10,560 --> 00:06:12,720
‫لقد علمت أنهما سيأتيان

97
00:06:35,200 --> 00:06:38,760
‫أنا متشوق لنتيجة هذا السباق

98
00:06:39,400 --> 00:06:40,720
‫راقب جيداً!

99
00:06:40,840 --> 00:06:43,920
‫سأريك من الأسرع في (جوما)

100
00:06:44,240 --> 00:06:46,400
‫ليست الـ86 أو الأخوين (تاكاشي)

101
00:06:46,520 --> 00:06:47,760
‫بل أنا

102
00:06:47,880 --> 00:06:50,720
‫(تاكيشي ناكازاتو) من "شبان الليل"

103
00:06:51,040 --> 00:06:52,200
‫وغد!

104
00:06:53,360 --> 00:06:55,840
‫يبدو أن الـ86 ليست هنا

105
00:06:57,360 --> 00:07:01,720
‫في هذا الوضع
‫علينا إقناع (تاكومي) مهما كلفنا ذلك

106
00:07:02,320 --> 00:07:03,600
‫حسناً

107
00:07:05,880 --> 00:07:07,040
‫اركب!

108
00:07:08,640 --> 00:07:10,400
‫(إيتزوكي)، ما الأمر؟

109
00:07:13,160 --> 00:07:16,240
‫سأبقى يا (إيكيتاني)

110
00:07:16,920 --> 00:07:19,240
‫لا أستطيع رؤية (تاكومي)!

111
00:07:20,840 --> 00:07:22,240
‫حسناً

112
00:07:22,360 --> 00:07:24,440
‫انتظر هنا إلى اللحظة الأخيرة

113
00:07:24,560 --> 00:07:26,760
‫سأحضره مهما يكن

114
00:07:32,040 --> 00:07:34,400
‫أنا متأكد من حضور (تاكومي)

115
00:07:35,280 --> 00:07:36,920
‫ولكن...

116
00:07:37,040 --> 00:07:39,640
‫- "(ريوسكي)! عزيزي (كيسكي)"
‫- يا له من مكان رائع للمشاهدة!

117
00:07:48,730 --> 00:07:51,770
‫(ريوسكي)! انتظر

118
00:07:54,130 --> 00:07:56,250
‫(ريوسكي) عزيزي!

119
00:08:01,650 --> 00:08:05,410
‫ما الأمر؟
‫أنا متوتر جداً، ماذا حل بي؟

120
00:08:05,570 --> 00:08:08,410
‫أريد الذهاب إلى هضبة (أكينا) الآن

121
00:08:09,570 --> 00:08:14,930
‫لا أعرف إذا كنت أحب القيادة
‫لهذه الدرجة، ولكن...

122
00:08:16,690 --> 00:08:21,330
‫للسنوات الخمس
‫الماضية في الثلج والمطر

123
00:08:22,010 --> 00:08:25,010
‫قدت في (أكينا) أكثر من أي شخص

124
00:08:25,850 --> 00:08:30,130
‫أريد رؤية ما أستطيع فعله الآن

125
00:08:30,930 --> 00:08:36,810
‫الكل يزعم بأن الـ(جي تي) هي الأسرع
‫لذا أريد تحديها بكل ما أملك من خبرة

126
00:08:37,610 --> 00:08:40,330
‫لم أشعر هكذا من قبل

127
00:08:41,250 --> 00:08:44,050
‫لا أستطيع التوقف عن التفكير بالأمر
‫مع أنني لا أملك سيارة

128
00:08:44,410 --> 00:08:47,570
‫ولكن أريد أن أقود في كل ثانية تمر

129
00:08:53,410 --> 00:08:54,930
‫أبي أيها العجوز الخرف

130
00:08:55,690 --> 00:08:57,970
‫إلى أين ذهبت؟

131
00:09:05,730 --> 00:09:06,730
‫(تاكومي)!

132
00:09:08,530 --> 00:09:09,890
‫(إيكيتاني)

133
00:09:14,570 --> 00:09:16,130
‫ماذا؟

134
00:09:16,290 --> 00:09:20,370
‫والدك أخذ السيارة؟

135
00:09:22,850 --> 00:09:24,770
‫ألا تعرف أين يكون الآن؟

136
00:09:25,770 --> 00:09:31,250
‫ظننته في الحانة واتصلت بها كلها
‫ولم أجده

137
00:09:32,530 --> 00:09:33,810
‫لا تستطيع إيجاده

138
00:09:36,090 --> 00:09:37,650
‫ما هذا؟

139
00:09:37,770 --> 00:09:40,730
‫إذا لم تملك الـ86
‫فلا فائدة من كل هذا الحديث

140
00:09:41,050 --> 00:09:43,770
‫لم أتوقع هذا

141
00:09:44,410 --> 00:09:48,650
‫(إيكيتاني)، هل جئت
‫لتحدثني بشأن السباق؟

142
00:09:49,850 --> 00:09:51,170
‫شيء كهذا

143
00:09:51,290 --> 00:09:53,570
‫الحشد يزيدون الأمر حماسة على الهضبة

144
00:09:53,930 --> 00:09:58,730
‫(تاكيشي) والأخوان (تاكاشي) هناك أيضاً

145
00:09:59,130 --> 00:10:02,170
‫ولكن بالرغم من ذلك
‫أنت النجم اليوم يا (تاكومي)

146
00:10:02,730 --> 00:10:05,690
‫انتظر قليلاً
‫أرجوك

147
00:10:06,010 --> 00:10:08,090
‫لا تصعب الأمر علي

148
00:10:08,770 --> 00:10:11,570
‫ولكنك لم تغير رأيك

149
00:10:12,170 --> 00:10:13,530
‫ليس كذلك

150
00:10:13,650 --> 00:10:16,450
‫في الحقيقة، أردت الذهاب

151
00:10:17,090 --> 00:10:18,210
‫"ماذا!؟"

152
00:10:18,610 --> 00:10:21,970
‫ولكن بدون سيارة ما الذي أستطيع فعله؟

153
00:10:23,530 --> 00:10:26,450
‫كنت مكتئباً قبل مجيئكما

154
00:10:26,770 --> 00:10:28,770
‫لماذا يحدث هكذا؟

155
00:10:28,890 --> 00:10:30,530
‫كم هذا محبط

156
00:10:30,650 --> 00:10:33,410
‫ما الذي نستطيع فعله؟

157
00:10:34,210 --> 00:10:36,130
‫لدي فكرة
‫يا (تاكومي)

158
00:10:36,370 --> 00:10:38,810
‫لماذا لا تأخذ سيارة (كينجي) 180

159
00:10:38,930 --> 00:10:40,130
‫فكرة عظيمة

160
00:10:40,250 --> 00:10:43,770
‫إنها مثل (إف أر)
‫ولها توربو للقوة الاحتياطية

161
00:10:44,370 --> 00:10:46,250
‫ستسير أسرع إن قدتها

162
00:10:46,730 --> 00:10:49,330
‫- هذا لن يجدي نفعاً
‫- لماذا؟

163
00:10:50,490 --> 00:10:53,450
‫لن أقود سيارة شخص آخر

164
00:10:54,130 --> 00:10:57,130
‫يجب أن تكون سيارتي
‫هذا ما اعتدت عليه

165
00:10:58,170 --> 00:11:00,010
‫وجهة نظر صحيحة!

166
00:11:00,530 --> 00:11:05,770
‫قيادة سيارة شخص آخر
‫ليست فكرة جيدة في عالم السيارات

167
00:11:06,370 --> 00:11:09,490
‫بأية حال، سأنتظر للحظة الأخيرة

168
00:11:09,610 --> 00:11:11,210
‫هذا ما أستطيعه

169
00:11:15,810 --> 00:11:17,650
‫لقد تأخر، ما الأمر؟

170
00:11:19,810 --> 00:11:21,530
‫الساعة العاشرة إلا ربع

171
00:11:22,450 --> 00:11:24,250
‫أعتقد أنه لن يحضر

172
00:11:27,690 --> 00:11:29,050
‫أين هو؟

173
00:11:29,170 --> 00:11:31,490
‫- ما الوقت الآن؟
‫- تقارب العاشرة

174
00:11:31,970 --> 00:11:33,490
‫لن يأتي

175
00:11:34,170 --> 00:11:36,370
‫أين أنت أبي؟

176
00:11:36,490 --> 00:11:38,290
‫عد في الحال، أرجوك

177
00:11:38,930 --> 00:11:40,890
‫لا أملك وقتاً إضافياً

178
00:11:52,730 --> 00:11:54,650
‫- لقد عاد
‫- ماذا؟

179
00:11:55,330 --> 00:12:00,130
‫يعبر الطريق السريع يغير الناقل مرتين
‫بذلك الإيقاع وتلك القوة التي تصدر صوتاً

180
00:12:02,210 --> 00:12:04,010
‫إنه هنا

181
00:12:06,330 --> 00:12:08,170
‫"(إنيشال دي)"

182
00:12:11,330 --> 00:12:12,890
‫"(إنيشال دي)"

183
00:12:19,370 --> 00:12:20,930
‫هل يخمن ذلك من صوت العادم فقط؟

184
00:12:21,050 --> 00:12:22,890
‫هل أنت متأكد؟

185
00:12:23,290 --> 00:12:25,810
‫بالطبع
‫إنها سيارتي

186
00:12:29,490 --> 00:12:32,890
‫- الأخوان (تاكاشي) هنا!
‫- نعم

187
00:12:33,010 --> 00:12:35,330
‫لا بد أنهما متلهفان لهذا السباق

188
00:12:36,850 --> 00:12:40,010
‫قالا لي أنني سأخسر

189
00:12:42,490 --> 00:12:43,970
‫تباً لك، يا (ريوسكي تاكاشي)

190
00:12:44,770 --> 00:12:47,850
‫ليس محترماً
‫ولكن سمعته كبيرة

191
00:12:48,490 --> 00:12:53,010
‫سأهزم الـ86 بدلاً عنه وسأحرجه

192
00:12:53,690 --> 00:12:55,010
‫دعونا نقم بذلك

193
00:12:55,370 --> 00:13:01,570
‫أرهم أنك أسرع من تلك الـ86
‫ذلك سيهزم (كيسكي)

194
00:13:01,690 --> 00:13:04,330
‫ومن ثم سنستطيع
‫إثبات سرعتنا أمام "الشموس الحمراء"

195
00:13:06,130 --> 00:13:11,530
‫هذه فكرة رائعة
‫حتى نوصلها للجمهور

196
00:13:12,090 --> 00:13:16,450
‫المناورة العرضية
‫لا تهزم السرعة العالية

197
00:13:16,770 --> 00:13:17,930
‫تماماً

198
00:13:18,050 --> 00:13:20,970
‫ما تتميز به

199
00:13:21,090 --> 00:13:22,450
‫إنه أمر عادي

200
00:13:22,570 --> 00:13:25,650
‫المناورة العرضية لتمتع الجمهور فقط

201
00:13:25,770 --> 00:13:28,450
‫وليست مهارة تستخدم في التحديات

202
00:13:28,570 --> 00:13:31,930
‫يجب أن تنطق بكلمتك في هذا السباق

203
00:13:32,330 --> 00:13:37,250
‫أستطيع ذلك لأنني اختبرت أسلوب
‫المناورة في سيارتي (إس 13)

204
00:13:37,770 --> 00:13:42,330
‫السائق الذي اختبر المناورة للسرعة
‫يستطيع التحكم بالسرعة في هذه السيارة

205
00:13:42,690 --> 00:13:46,450
‫عندما تخسر الـ32
‫سيكون ذلك مخزياً

206
00:13:48,930 --> 00:13:50,930
‫لقد تلعثمت

207
00:13:52,450 --> 00:13:55,130
‫لقد تغيرت منذ تلك المدة

208
00:13:55,250 --> 00:14:00,490
‫منذ أن هزمني ذلك الوحش
‫ولكنني بأفضل حال في الـ32

209
00:14:01,370 --> 00:14:04,850
‫لا تستطيع تسمية نفسك متسابقاً
‫إذا لم تلاحق المتحدين الماهرين

210
00:14:05,170 --> 00:14:09,410
‫لا أصدق أن الجميع
‫يهتم بفن المناورة العرضية فقط

211
00:14:10,530 --> 00:14:12,410
‫أظهري نفسك أيتها الـ86

212
00:14:12,970 --> 00:14:18,370
‫المناورة الخاصة بك ستنتهي
‫سأثبت ذلك

213
00:14:19,810 --> 00:14:23,170
‫كالعادة، لن يظهر إلى اللحظة الأخيرة

214
00:14:23,490 --> 00:14:25,290
‫أنا أتساءل إن كان سيظهر أم لا

215
00:14:26,410 --> 00:14:28,690
‫ألم يخبرك بعدم رغبته بالحضور؟

216
00:14:29,210 --> 00:14:31,090
‫سيحضر

217
00:14:32,130 --> 00:14:33,610
‫أنا متأكد

218
00:14:34,450 --> 00:14:36,050
‫سيأتي بالتأكيد

219
00:14:43,330 --> 00:14:45,210
‫هكذا هو الأمر

220
00:14:45,330 --> 00:14:47,330
‫لذا سآخذ السيارة

221
00:14:48,050 --> 00:14:49,570
‫الأفضل أن تسرع (تاكومي)

222
00:14:49,890 --> 00:14:51,530
‫الوقت شارف على الانتهاء

223
00:14:52,010 --> 00:14:54,650
‫نتأسف لأخذ (تاكومي) معنا

224
00:14:54,770 --> 00:14:57,610
‫سنشتري 10 قطع من التوفو عند عودتنا

225
00:14:57,730 --> 00:15:00,010
‫التي خلطت مع الخضار أيضاً

226
00:15:03,930 --> 00:15:05,530
‫تمهل!

227
00:15:10,530 --> 00:15:11,890
‫(تاكومي)

228
00:15:12,010 --> 00:15:14,290
‫عيناه تبدوان مختلفتين

229
00:15:14,410 --> 00:15:16,410
‫ما الأمر؟

230
00:15:20,170 --> 00:15:21,290
‫لا تهتم

231
00:15:21,650 --> 00:15:24,650
‫مع تلك التجهيزات، سيحسن الأداء

232
00:15:30,090 --> 00:15:31,930
‫لقد اقتربنا من الهضبة

233
00:15:32,050 --> 00:15:34,010
‫أتساءل إن كنت تستطيع مجاراته

234
00:15:34,130 --> 00:15:38,090
‫أعتذر لإحباطك ولكن سيارته
‫بدون توربو ومحركها 16

235
00:15:38,490 --> 00:15:40,730
‫وهذه 200 وتوربو

236
00:15:40,850 --> 00:15:44,970
‫المهم أنني أستطيع مجاراته
‫على الهضبة ولكن المنحدر صعب قليلاً

237
00:15:45,810 --> 00:15:50,210
‫من تعتقدني؟
‫واحد من الأسرع على (أكينا)

238
00:16:01,210 --> 00:16:02,210
‫سريع جداً

239
00:16:03,410 --> 00:16:05,970
‫لا أستطيع فعل ذلك

240
00:16:11,730 --> 00:16:13,050
‫وبالقوة العالية

241
00:16:15,650 --> 00:16:18,850
‫- لقد اختفى
‫- الـ86 اختفت

242
00:16:30,770 --> 00:16:35,050
‫(تاكومي)
‫كنت تبدو شارداً أثناء التصوير

243
00:16:42,330 --> 00:16:44,770
‫دقيقتان وتدق الساعة العاشرة

244
00:16:48,770 --> 00:16:52,010
‫أعتقد أنهما لم يستطيعا إقناعه

245
00:16:59,290 --> 00:17:01,970
‫يجب علي الاعتذار كرجل

246
00:17:06,290 --> 00:17:09,890
‫انتظر!
‫طلب (إيكيتاني) مني الانتظار لآخر لحظة

247
00:17:10,010 --> 00:17:12,850
‫يجب علي ذلك

248
00:17:18,650 --> 00:17:20,610
‫ولكن هذا خطأي

249
00:17:20,730 --> 00:17:23,290
‫ليس لي علاقة بـ"نجوم (أكينا)"

250
00:17:23,410 --> 00:17:26,770
‫يجب علي أخذ عقابي كرجل

251
00:17:34,610 --> 00:17:36,530
‫لا! يوجد الكثيرون منهم هنا

252
00:17:36,650 --> 00:17:39,650
‫يبدو أنني سأتلقى لكمات كثيرة

253
00:17:42,850 --> 00:17:44,570
‫هذا ليس مزاحاً

254
00:17:44,690 --> 00:17:46,090
‫أريد الهروب

255
00:17:46,210 --> 00:17:49,170
‫أشك بأنهم سيسامحونني

256
00:17:49,290 --> 00:17:52,090
‫إذا أخبرتهم أن الـ86 لن تحضر الآن

257
00:18:01,570 --> 00:18:03,370
‫الاعتذار على ركبتي لن يجدي نفعاً

258
00:18:03,490 --> 00:18:06,010
‫إن الأمر يسوء، لعلي سأموت

259
00:18:07,410 --> 00:18:09,090
‫أبي! أمي

260
00:18:09,210 --> 00:18:10,530
‫ساعداني

261
00:18:10,650 --> 00:18:12,170
‫أرجوك يا إلهي

262
00:18:12,650 --> 00:18:14,930
‫أنا لم أرتبط بفتاة بعد

263
00:18:15,050 --> 00:18:16,930
‫لا أريد الموت بتولاً

264
00:18:17,050 --> 00:18:19,370
‫ها هو! إنه قادم

265
00:18:19,690 --> 00:18:23,290
‫لا! لقد رأوني

266
00:18:23,410 --> 00:18:26,090
‫فات أوان الهروب

267
00:18:26,210 --> 00:18:27,890
‫سأموت

268
00:18:43,810 --> 00:18:48,450
‫ما الذي تفعله
‫بجلوسك بمنتصف الطريق؟

269
00:18:51,490 --> 00:18:53,010
‫ابتعد عن طريقي

270
00:18:53,130 --> 00:18:56,490
‫هيا، سأدهسك بالسيارة

271
00:18:57,570 --> 00:18:58,970
‫(تاكومي)!

272
00:18:59,090 --> 00:19:01,210
‫لقد أتيت

273
00:19:02,850 --> 00:19:05,450
‫آسف لتأخري، (إيتزوكي)

274
00:19:06,130 --> 00:19:07,890
‫(تاكومي)!

275
00:19:08,890 --> 00:19:13,330
‫السائق عليه قبول التحدي
‫إذا تحداه أحد

276
00:19:13,810 --> 00:19:16,330
‫(تاكومي)

277
00:19:18,410 --> 00:19:21,450
‫لا! مخاطك يسيل عليّ
‫توقف، (إيتزوكي)

278
00:19:22,850 --> 00:19:25,250
‫نعم، هذه هي الروح المطلوبة

279
00:19:31,130 --> 00:19:33,090
‫مرحباً، محل (فوجي وارا)

280
00:19:33,210 --> 00:19:35,210
‫(يوشي)

281
00:19:36,370 --> 00:19:38,290
‫هل أنت هناك؟

282
00:19:38,810 --> 00:19:41,170
‫ما الذي حدث لولدي؟

283
00:19:41,530 --> 00:19:44,090
‫أراد التحدي في النهاية

284
00:19:44,530 --> 00:19:46,650
‫الابن سر أبيه

285
00:19:47,170 --> 00:19:50,330
‫بالمناسبة منافسه لديه سيارة
‫من نوعية الـ(جي تي أر)

286
00:19:50,450 --> 00:19:52,850
‫هل يملك فرصة أمامه؟

287
00:19:53,370 --> 00:19:55,330
‫لقد ظهر في النهاية

288
00:19:55,650 --> 00:20:00,490
‫- (كيسكي)، كنت محقاً
‫- ماذا إذاً؟

289
00:20:00,970 --> 00:20:05,850
‫هل ستخبر الـ86
‫عن نقطة ضعف تلك الـ32 أم لا؟

290
00:20:06,490 --> 00:20:08,730
‫كنت سأخبره، ولكن لا

291
00:20:08,850 --> 00:20:12,450
‫عندما رأيت وجهه شعرت بالاشمئزاز

292
00:20:12,570 --> 00:20:16,330
‫يبقى منافسي في النهاية

293
00:20:18,250 --> 00:20:22,690
‫وهو لن يخسر
‫وإن لم يعرف نقطة ضعف الـ32

294
00:20:24,050 --> 00:20:25,850
‫"هل أعطيته أية نصيحة؟"

295
00:20:26,250 --> 00:20:31,610
‫لا شيء،
‫ولكن الـ(جي تي) تملك نقطة ضعف

296
00:20:32,370 --> 00:20:37,290
‫نقطة ضعف الـ32 هي وزن الهيكل

297
00:20:37,410 --> 00:20:40,690
‫فالدفع الرباعي يثقل الجزء الأمامي

298
00:20:41,090 --> 00:20:45,610
‫مع مهارة السائق
‫وقدراته فهذه النقطة عيب كبير

299
00:20:45,890 --> 00:20:50,570
‫إذا كنت ستقود بسرعة على المنحدر
‫فلن تتحكم بالفرامل والعجلات الأمامية

300
00:20:50,810 --> 00:20:53,250
‫مع امتلاك السيارة
‫نظام (أبي إس) للفرامل

301
00:20:54,010 --> 00:21:00,450
‫فذلك لن يفيد أثناء الانحدار السريع

302
00:21:03,650 --> 00:21:07,610
‫إن كانت هناك فرصة للفوز
‫فهي عند المنعطف الأخير قبل النهاية

303
00:21:09,170 --> 00:21:15,450
‫يمكن للـ86 مجاراة الـ32 إلى النهاية
‫ومن ثم سيكون ذلك المنعطف حاسماً

304
00:21:15,890 --> 00:21:19,850
‫بشأن فرامل الـ86 لقد فعلت أمراً ما

305
00:21:19,970 --> 00:21:21,130
‫"الفرامل؟"

306
00:21:21,410 --> 00:21:22,730
‫"ما هو؟"

307
00:21:25,690 --> 00:21:28,250
‫لكي يستطيع الاستدارة بسهولة
‫عند المنعطفات مع دواسة البنزين

308
00:21:28,370 --> 00:21:29,930
‫هكذا هي الفرامل الآن

309
00:21:30,050 --> 00:21:33,130
‫ماذا؟
‫الاستدارة عند زيادة البنزين

310
00:21:33,770 --> 00:21:35,610
‫قيادة (تاكومي) تعتمد
‫على المناورة العرضية

311
00:21:36,010 --> 00:21:37,570
‫ما الذي كنت تفكر به يا (بونتا)؟

312
00:21:37,690 --> 00:21:40,410
‫كيف يستطيع تحدي الـ(جي تي)
‫بتلك التجهيزات؟

313
00:21:41,130 --> 00:21:43,490
‫أنت لا تفهم ذلك

314
00:21:43,730 --> 00:21:48,370
‫إذا كنت جيداً فالاستدارة تزيد سرعتك
‫عندما تزيد السرعة عند المنعطفات

315
00:21:48,730 --> 00:21:53,370
‫لكنها انخفضت
‫لأنها تحمل التوفو دوماً

316
00:21:54,410 --> 00:21:59,290
‫مع هذه الإعدادات
‫يصعب عليك القيادة إلى الحد الأقصى

317
00:22:09,610 --> 00:22:11,330
‫ولكن إذا كنت جيداً

318
00:22:12,290 --> 00:22:14,170
‫أنا متأكد أنه سيستطيع فعل ذلك

319
00:22:43,930 --> 00:22:46,290
‫"يخبرني فخري أن أكون جامحاً وقوياً"

320
00:22:46,410 --> 00:22:48,290
‫"لا أسمح للآخرين بالتدخل"

321
00:22:48,410 --> 00:22:50,170
‫"لا أتوقف أبداً، ولا أريد التوقف"

322
00:22:50,290 --> 00:22:52,090
‫"حتى لو ضحيت بكل ما أحب"

323
00:22:52,210 --> 00:22:54,410
‫"أتوجه نحو القمة، ولا أكترث لشيء"

324
00:22:54,530 --> 00:22:56,330
‫"احذروا، فأصوات التحذير تملأ المكان"

325
00:22:56,450 --> 00:22:57,770
‫"ولا مجال للضعفاء"

326
00:22:57,890 --> 00:23:00,090
‫"لأنني لن أكف عن مطاردة حلمي"

327
00:23:00,210 --> 00:23:02,130
‫"تحفيزك أمر سهل"

328
00:23:02,250 --> 00:23:04,090
‫"كل شيء محسوب"

329
00:23:04,210 --> 00:23:08,050
‫"حتى لو أردت الثوران
‫سينتهي بك الأمر في منطقة الأمان"

330
00:23:08,170 --> 00:23:11,970
‫"تفوز بشيء بينما تخسر آخر"

331
00:23:12,090 --> 00:23:15,970
‫"لن يتغير ذلك حتى لو انتهت الدنيا"

332
00:23:16,090 --> 00:23:24,010
‫"صرخة كبيرة
‫لا يمكن لأحد أن يتحملها"

333
00:23:24,130 --> 00:23:31,410
‫"الحلم الجامح يتجاوز الوقت الآن"

334
00:23:31,530 --> 00:23:35,490
‫"أجج حلمك ليتجاوز الظلام"

335
00:23:35,610 --> 00:23:37,450
‫"مثل شعاع نحو القمة"

336
00:23:37,570 --> 00:23:43,410
‫"سيضيء برودة الليل"

337
00:23:43,530 --> 00:23:47,490
‫"أجج حلمك لتستكشف الطريق"

338
00:23:47,610 --> 00:23:50,410
‫"هيا لجولة أخرى، لا تستسلم أبداً"

339
00:23:50,530 --> 00:23:52,210
‫"اهزمهم في جزء من الثانية"

340
00:23:52,330 --> 00:23:54,450
‫"توجه إلى البلدة التالية تاركاً أثرك"

341
00:23:54,570 --> 00:23:56,530
‫"غبار يتصاعد والخاسر يسقط"

342
00:23:56,650 --> 00:23:58,090
‫"الثرثرة مليئة بالمنطق"

343
00:23:58,210 --> 00:24:00,130
‫"مزعجة للغاية لذا فلنتجاهلها"

344
00:24:00,250 --> 00:24:02,090
‫"الفائز يختفي في الطريق"

345
00:24:02,210 --> 00:24:03,650
‫"وهو شيء سيعرفونه جيداً"

346
00:24:03,930 --> 00:24:11,490
‫"أجج حلمك في الطريق الذي لا ينتهي
‫من أن تنظر إلى ما هو خلفك"

347
00:24:11,610 --> 00:24:15,490
‫"واصل المضي قدماً لكي تسطع"

348
00:24:15,610 --> 00:24:20,530
‫"أجج حلمك لتعيش في الحاضر"

349
00:24:26,690 --> 00:24:29,450
‫ما فرص فوزك أمام الـ86
‫يا (ناكازاتو)؟

350
00:24:29,570 --> 00:24:31,330
‫هذا واضح جداً

351
00:24:31,450 --> 00:24:34,530
‫ستفوز الـ32 إذاً
‫لكن (تاكاشي ريوسكي)

352
00:24:34,650 --> 00:24:37,090
‫إنه متردد لخسارة أخيه

353
00:24:37,210 --> 00:24:41,290
‫ساريهما أنني الأسرع في (جوما)

354
00:24:41,410 --> 00:24:46,370
‫والقيادة الثابتة متفوقة
‫سوف أهزمه شر هزيمة

355
00:24:46,490 --> 00:24:48,210
‫ما هذه الثقة؟

356
00:24:48,530 --> 00:24:49,930
‫إثارة بحتة!

357
00:24:50,570 --> 00:24:53,170
‫"في الحلقة القادمة
‫معركة حتى أقصى الحدود"