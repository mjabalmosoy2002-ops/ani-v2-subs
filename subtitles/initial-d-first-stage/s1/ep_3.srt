1
00:00:01,400 --> 00:00:03,000
‫"هذه القصة خيالية وأسماء الأشخاص
‫والأماكن والمجموعات وهمية"

2
00:00:03,120 --> 00:00:04,800
‫"الالتزام بقواعد المرور
‫والقيادة بأمان"

3
00:00:24,200 --> 00:00:26,680
‫"المعلومات، تنتشر في غضون ثوان"

4
00:00:26,800 --> 00:00:29,000
‫"لكننا لا نعرف كيف نختاره"

5
00:00:29,120 --> 00:00:30,920
‫"أولئك الذين يقولون
‫"المال لا يشتري حبي"

6
00:00:31,040 --> 00:00:32,880
‫"يستحقون عقوبة"

7
00:00:33,000 --> 00:00:34,800
‫"نحن نمارس الحب وفقاً للكتيبات"

8
00:00:34,920 --> 00:00:36,800
‫"لا نلاحظ قلة الحب"

9
00:00:36,920 --> 00:00:39,400
‫"قبل أن نختنق دعونا نصيح!"

10
00:00:39,520 --> 00:00:40,560
‫"في حلم منتصف الليل"

11
00:00:40,680 --> 00:00:44,520
‫"لا مكان للاسترخاء
‫في المدينة التي لا تنام"

12
00:00:44,640 --> 00:00:48,440
‫"نبتسم بدون أن نتخلى عن حذرنا"

13
00:00:48,560 --> 00:00:52,560
‫"الكذب آمن والحقيقة فارغة"

14
00:00:52,680 --> 00:00:56,600
‫"أريد بشدة أن أثور"

15
00:00:56,720 --> 00:00:58,480
‫"الآن، يجب أن نبدأ دعونا نتحرك"

16
00:00:58,600 --> 00:01:00,240
‫"دعونا ننتقل إلى عالم جديد تماماً"

17
00:01:00,360 --> 00:01:02,480
‫"دعنا نغص في رحلة جديدة"

18
00:01:02,600 --> 00:01:06,200
‫"أنت خائف من عالم كبير"

19
00:01:06,320 --> 00:01:08,520
‫"لقد بدأت للتو"

20
00:01:08,640 --> 00:01:10,480
‫"الآن نذهب بأقصى سرعة
‫ونبض غير تقليدي"

21
00:01:10,600 --> 00:01:12,200
‫"سوف تتألق بالتأكيد"

22
00:01:12,320 --> 00:01:14,120
‫"حول العالم"

23
00:01:14,240 --> 00:01:16,960
‫"رحلة إلى العالم
‫ها نحن نذهب إلى عالم مجهول"

24
00:01:17,080 --> 00:01:18,720
‫"أنت مسافر حديث الولادة"

25
00:01:18,840 --> 00:01:20,760
‫"مشاهدة الخطوات غير المستقرة ممتعة"

26
00:01:20,880 --> 00:01:22,880
‫"قم بإنجاز الأمور بشكل صحيح
‫عند الحاجة فقط"

27
00:01:23,000 --> 00:01:24,400
‫"الكثير من الناس في هذا العالم"

28
00:01:24,520 --> 00:01:26,680
‫"في بعض الأحيان
‫سوف تتلقى الافتراءات"

29
00:01:26,800 --> 00:01:28,720
‫"دعونا نتخلص من الأشياء الرتيبة"

30
00:01:28,840 --> 00:01:30,200
‫"ونعش حياة عقلانية على الأقل"

31
00:01:30,320 --> 00:01:32,120
‫"هذا هو قانوننا"

32
00:01:55,000 --> 00:01:56,080
‫كان هذا خطيراً

33
00:01:56,400 --> 00:01:58,080
‫يا له من متهور

34
00:02:01,040 --> 00:02:02,240
‫أنت

35
00:02:02,640 --> 00:02:04,720
‫اصمد، هل أنت بخير؟

36
00:02:06,200 --> 00:02:08,920
‫أنا أعتذر، إنه خطئي

37
00:02:09,840 --> 00:02:12,360
‫أنا آسف

38
00:02:12,680 --> 00:02:16,000
‫اصمد هناك، سأتصل بالطوارىء

39
00:02:18,560 --> 00:02:23,680
‫"الحلقة الثالثة
‫ظهور شبح (أكينا)"

40
00:02:24,400 --> 00:02:28,120
‫ماذا؟
‫(إيكيتاني)، صدم سيارته

41
00:02:28,240 --> 00:02:29,400
‫متى حصل ذلك؟

42
00:02:29,640 --> 00:02:32,720
‫الليلة الماضية
‫صدم حافة منحدر (أكينا)

43
00:02:32,960 --> 00:02:37,520
‫- وكيف حاله؟
‫- ليس متأذياً كثيراً، جروح طفيفة

44
00:02:37,920 --> 00:02:40,920
‫ولكنه منزعج بشأن ما حدث

45
00:02:41,880 --> 00:02:44,520
‫لقد تأذت سيارته بشكل كبير

46
00:02:44,640 --> 00:02:47,920
‫وماذا بشأن سباق السبت
‫أمام الأخوين (تاكاشي)؟

47
00:02:48,440 --> 00:02:50,240
‫إنه وضع ميؤوس منه

48
00:02:50,680 --> 00:02:53,600
‫على أية حال، يجب علينا
‫إيجاد بديل لـ(إيكيتاني)

49
00:02:56,440 --> 00:02:58,800
‫أهلاً وسهلاً بكم في (أوتو موبيل)

50
00:02:58,920 --> 00:03:01,920
‫(إيكيتاني)
‫هل يجب عليك الخروج؟

51
00:03:02,040 --> 00:03:04,640
‫أنا بخير، كيف هي سيارتي؟

52
00:03:04,920 --> 00:03:08,080
‫إنها في الخلف ولكننا لم نبدأ بإصلاحها

53
00:03:08,320 --> 00:03:10,720
‫لا نستطيع عمل شيء
‫إلى أن تصل قطع الغيار

54
00:03:42,760 --> 00:03:45,160
‫"محل (فوجي وارا) للتوفو"

55
00:03:48,440 --> 00:03:51,680
‫لو سمحت، توفو طازج

56
00:03:52,000 --> 00:03:54,600
‫نعم، أنا قادم

57
00:03:55,840 --> 00:03:57,240
‫هل اصطدمت بسيارتك؟

58
00:03:57,440 --> 00:03:58,440
‫نعم

59
00:03:59,400 --> 00:04:02,360
‫السباق قريب، ما الذي ستفعله؟

60
00:04:02,800 --> 00:04:05,760
‫أريد أن أطلب منك خدمة
‫سيد (فوجي وارا)

61
00:04:06,080 --> 00:04:08,080
‫- خدمة؟
‫- نعم

62
00:04:08,200 --> 00:04:11,680
‫في السباق
‫هل يمكنك القيادة نيابة عني؟

63
00:04:14,120 --> 00:04:15,920
‫أتوسل إليك سيدي

64
00:04:16,080 --> 00:04:17,080
‫مؤلم!

65
00:04:18,920 --> 00:04:21,520
‫- رقبتي!
‫- لا تمت

66
00:04:22,120 --> 00:04:25,760
‫سيد (فوجي وارا)
‫أنت تعلم كيف يشعر المتحدي

67
00:04:26,240 --> 00:04:28,520
‫لن أسمح بأن نخسر

68
00:04:29,000 --> 00:04:34,360
‫حتى وان ذهبت إلى السباق
‫سأذهب إلى مكان آخر لأسابق

69
00:04:34,920 --> 00:04:37,680
‫لقد ترعرعت في (أكينا)

70
00:04:38,200 --> 00:04:42,960
‫أولئك الأشخاص
‫يسخرون من قيادة سكان (أكينا)

71
00:04:43,160 --> 00:04:44,560
‫لا أستطيع قبول ذلك!

72
00:04:44,800 --> 00:04:49,600
‫أريدهم أن يعلموا أن لدى (أكينا)
‫سائقاً ليس بلقمة سائغة أبداً

73
00:04:50,040 --> 00:04:52,480
‫سيد (فوجي وارا)
‫أنت الذي تستطيع عمل ذلك

74
00:04:52,840 --> 00:04:56,680
‫أنت هزمت (كيسكي) من (أكاجي) مرة
‫وتستطيع ذلك مرة أخرى

75
00:04:58,160 --> 00:05:00,520
‫أنا أتوسل إليك يا سيد (فوجي وارا)

76
00:05:09,280 --> 00:05:11,720
‫ماذا هناك؟
‫لقد أغلقنا

77
00:05:14,280 --> 00:05:16,760
‫لا تكن فظاً
‫عبئه بالأوكتان الممتاز

78
00:05:17,360 --> 00:05:20,760
‫يا لها من مفاجأة
‫وتريد الأوكتان الممتاز لهذه الـ86

79
00:05:23,240 --> 00:05:24,920
‫لا بد أنه أنت (يايشي)

80
00:05:25,040 --> 00:05:28,440
‫من أخبر ذلك الشاب
‫بتلك الإشاعة الغريبة

81
00:05:28,720 --> 00:05:31,800
‫بالتأكيد فهي ليست كذبة

82
00:05:32,160 --> 00:05:33,600
‫وماذا في ذلك؟

83
00:05:33,840 --> 00:05:37,560
‫لقد أتى مرة أخرى اليوم
‫وعليه ضمادات كثيرة

84
00:05:37,760 --> 00:05:40,320
‫لقد طلب أن أسابق بدلاً عنه

85
00:05:40,680 --> 00:05:43,280
‫لا أقول إنني أكره هذه الأمور

86
00:05:43,440 --> 00:05:46,680
‫إن كنت لا تكرهها
‫اذهب بدلاً عنه

87
00:05:47,200 --> 00:05:49,280
‫(إيكيتاني)، شخص طيب

88
00:05:49,560 --> 00:05:50,560
‫لا، شكراً

89
00:05:51,000 --> 00:05:54,200
‫لا أريد أن أحشر أنفي في أمور الصغار

90
00:05:54,560 --> 00:05:56,080
‫هذا ليس أسلوبي

91
00:05:56,920 --> 00:06:00,400
‫إذاً دع قتال الأطفال للأطفال

92
00:06:01,840 --> 00:06:03,640
‫أتقصد (تاكومي)؟

93
00:06:03,760 --> 00:06:04,760
‫صحيح

94
00:06:05,120 --> 00:06:09,960
‫- إنه بارع جداً
‫- ولكن لا يزال أمامه طريق طويل

95
00:06:10,240 --> 00:06:14,520
‫في منحدرات (أكينا) لن يخسر أبداً

96
00:06:14,680 --> 00:06:16,760
‫إلا أنه لن يهزمني، بالطبع!

97
00:06:16,920 --> 00:06:18,640
‫روحك القتالية بدأت تظهر

98
00:06:19,240 --> 00:06:26,080
‫لا أعرف من أين ورث عناده
‫لكن وإن طلبت منه فما الذي سيقنعه؟

99
00:06:26,560 --> 00:06:30,240
‫الضمادات على وجه (إيكيتاني)

100
00:06:30,400 --> 00:06:32,160
‫سأفكر بطريقة ما

101
00:06:48,360 --> 00:06:50,880
‫الوعد يجب ألا ينقض

102
00:06:51,440 --> 00:06:53,360
‫هناك نوعان من الأشخاص أكرههم

103
00:06:53,480 --> 00:06:55,560
‫الحانثون لوعودهم والمدخنون

104
00:06:56,280 --> 00:06:59,760
‫أريد استعارة السيارة يوم الأحد

105
00:07:00,080 --> 00:07:02,280
‫لا يمكنك ذلك الأحد

106
00:07:02,520 --> 00:07:03,920
‫لماذا؟

107
00:07:04,040 --> 00:07:06,480
‫سأهتم بتوصيل الطلبات صباحاً

108
00:07:06,600 --> 00:07:08,040
‫ليست تلك المشكلة!

109
00:07:08,360 --> 00:07:11,800
‫أحتاجها للذهاب إلى اجتماع في القرية

110
00:07:12,120 --> 00:07:14,600
‫حقاً؟ هذا سيئ

111
00:07:15,200 --> 00:07:17,840
‫أنا أحتاج السيارة الأحد

112
00:07:20,360 --> 00:07:21,680
‫لا بد أنها فتاة!

113
00:07:23,320 --> 00:07:24,720
‫لا يجب أن تعلم

114
00:07:24,920 --> 00:07:27,080
‫لا تكن عنيداً
‫دعني أستعير السيارة

115
00:07:27,360 --> 00:07:29,240
‫إنها مجرد سيارة قديمة

116
00:07:29,600 --> 00:07:30,840
‫سآخذها لو سمحت يا أبي

117
00:07:31,560 --> 00:07:33,760
‫السيارة لن تتحرك من دون مفتاح

118
00:07:34,040 --> 00:07:36,280
‫سأضعه في عقد وأعلقه بعنقي

119
00:07:36,920 --> 00:07:37,960
‫هذا ظلم

120
00:07:38,800 --> 00:07:41,640
‫إذا كنت تريدها حقاً
‫سأفكر بذلك

121
00:07:42,760 --> 00:07:45,520
‫- حقاً؟
‫- ولكن بشرط

122
00:07:46,040 --> 00:07:47,040
‫شرط؟

123
00:07:47,720 --> 00:07:54,440
‫أن تتحدى السبت الأسرع في (أكاجي)
‫وتهزمه على منحدر (أكينا)

124
00:07:54,840 --> 00:07:56,960
‫ماذا؟

125
00:07:57,520 --> 00:08:02,880
‫إذا فعلت ذلك لن أمانع استعارتك
‫السيارة الأحد، وستحظى بخزان مملوء

126
00:08:03,640 --> 00:08:05,120
‫خزان وقود مملوء

127
00:08:08,000 --> 00:08:09,280
‫خزان وقود مملوء

128
00:08:09,920 --> 00:08:12,240
‫هذا العرض لا يقاوم حقاً

129
00:08:12,720 --> 00:08:14,400
‫أنا مفلس أيضاً

130
00:08:15,280 --> 00:08:16,800
‫ما الذي قررته؟

131
00:08:17,480 --> 00:08:19,520
‫دعني أفكر بالأمر

132
00:08:22,000 --> 00:08:24,400
‫خذ وقتك بالتفكير

133
00:08:27,080 --> 00:08:28,880
‫"(تاكاشي)"

134
00:08:43,160 --> 00:08:44,440
‫أنا قادم

135
00:08:48,240 --> 00:08:50,000
‫أريد أن أسألك شيئاً

136
00:08:50,720 --> 00:08:51,840
‫ما الأمر يا أخي؟

137
00:08:52,680 --> 00:08:58,600
‫الـ86 التي رأيتها
‫هل تستطيع وصف سرعتها نظرياً؟

138
00:08:59,680 --> 00:09:01,920
‫انتظر قليلاً!

139
00:09:02,360 --> 00:09:05,360
‫أنا لست جيداً في هذه الأمور مثلك

140
00:09:05,720 --> 00:09:09,920
‫مثلما كنت أقول دائماً
‫أهم ما في السائق يكمن هنا

141
00:09:10,520 --> 00:09:15,000
‫عندما تتحدى أحدهم تستطيع البقاء خلفه
‫وتتعلم عنه ما تريد

142
00:09:15,640 --> 00:09:20,000
‫من نقطة ضعف منافسك
‫يبدأ التحدي الأكبر

143
00:09:20,440 --> 00:09:23,480
‫إن طريقتك مخيفة

144
00:09:24,960 --> 00:09:31,160
‫في رأيي، أنك تقود بلا تفكير
‫هذا يعني أنك مخيف

145
00:09:32,000 --> 00:09:35,960
‫إن أضفت النظريات إلى مهارتك
‫ستصبح السائق المثالي

146
00:09:36,080 --> 00:09:39,440
‫لقد خسرت لأنني لم أكن أعرف
‫الطريق جيداً وكنت نعساً

147
00:09:40,440 --> 00:09:42,320
‫هذا أكبر إحراج في حياتي

148
00:09:43,320 --> 00:09:45,960
‫دخول تلك الـ86 كان مثل دخول الشبح

149
00:09:46,440 --> 00:09:47,760
‫شبح

150
00:09:48,520 --> 00:09:50,240
‫هذا شيء مثير للاهتمام

151
00:09:52,920 --> 00:09:56,120
‫غداً موعد السباق
‫لعلي يجب أن أذهب وأشاهد ذلك

152
00:10:04,560 --> 00:10:06,200
‫(تاكومي)

153
00:10:07,440 --> 00:10:09,280
‫إنه السبت

154
00:10:10,680 --> 00:10:11,840
‫ماذا بشأنه؟

155
00:10:13,360 --> 00:10:16,040
‫ماذا تعني بهذا الكلام؟
‫اليوم يبدأ السباق

156
00:10:16,160 --> 00:10:18,600
‫السباق مع شموس (أكاجي)

157
00:10:18,760 --> 00:10:21,920
‫لقد وعدتني باستعارة الـ86
‫لمشاهدة السباق

158
00:10:22,960 --> 00:10:28,320
‫بالمناسبة، الأمر معقد قليلاً

159
00:10:28,840 --> 00:10:30,480
‫ما الذي تقوله؟

160
00:10:30,760 --> 00:10:34,400
‫لا تقل لي
‫أنك لا تملك وقتاً كافياً لذلك

161
00:10:35,160 --> 00:10:37,840
‫لا، ليس الأمر كذلك

162
00:10:38,200 --> 00:10:41,960
‫إذا لم تحضر إلى هناك
‫يمكنك نسيان أمر صداقتنا

163
00:10:42,320 --> 00:10:47,200
‫لقد عددت أصابعي يومياً
‫بانتظار هذا اليوم

164
00:10:47,440 --> 00:10:48,480
‫أعلم ذلك

165
00:10:49,240 --> 00:10:50,320
‫عذراً

166
00:10:51,240 --> 00:10:52,440
‫توفو طازج

167
00:10:53,240 --> 00:10:54,920
‫إنه أنت مرة أخرى

168
00:10:55,600 --> 00:10:57,440
‫ألا تستسلم أبداً؟

169
00:10:57,920 --> 00:10:59,640
‫سيد (فوجي وارا)، أتوسل إليك

170
00:11:00,000 --> 00:11:01,480
‫سباق اليوم

171
00:11:03,120 --> 00:11:04,840
‫يمكن أن آتي

172
00:11:08,240 --> 00:11:11,120
‫يمكن أن آتي، هذا ما لدي

173
00:11:11,600 --> 00:11:13,120
‫إلى (أكينا) الليلة

174
00:11:14,080 --> 00:11:15,440
‫بصدق!؟

175
00:11:16,440 --> 00:11:18,280
‫آلمتني رقبتي!

176
00:11:19,080 --> 00:11:20,680
‫هل أنت بخير؟

177
00:11:21,680 --> 00:11:23,520
‫هل ستأتي بالتأكيد؟

178
00:11:23,760 --> 00:11:29,080
‫أنا لست متأكداً
‫ولكن أعتقد أنه هنالك فرصة

179
00:11:30,160 --> 00:11:31,440
‫في أي وقت ستبدأ؟

180
00:11:31,560 --> 00:11:35,760
‫التجمع الساعة الثامنة
‫ولكن السباق يبدأ العاشرة

181
00:11:36,120 --> 00:11:37,200
‫العاشرة

182
00:11:38,840 --> 00:11:43,040
‫إذا لم تظهر الـ86 قبل العاشرة
‫فلا تنتظرني

183
00:11:43,360 --> 00:11:45,360
‫يجب أن يفعلها أحد غيري

184
00:11:45,920 --> 00:11:47,640
‫سأنتظرك، سيد (فوجي وارا)

185
00:11:48,080 --> 00:11:50,480
‫أنا أؤمن بأنك ستأتي

186
00:11:50,840 --> 00:11:53,200
‫أنا لم أؤكد ذلك ولكن هنالك فرصة

187
00:11:53,920 --> 00:11:56,880
‫لا، أنت قررت المجيء مسبقاً

188
00:11:57,160 --> 00:11:59,200
‫فريقنا سينتظرك!

189
00:12:00,000 --> 00:12:01,360
‫حسناً، يا سيد (فوجي)

190
00:12:01,720 --> 00:12:04,760
‫سننتظرك في هضبة (أكينا) إلى العاشرة

191
00:12:18,160 --> 00:12:21,320
‫لا أستطيع أن أكون هادئاً
‫أمام شخص متحمس مثله

192
00:12:21,920 --> 00:12:24,920
‫إذا لم يذهب (تاكومي)
‫هل يجدر بي ذلك؟

193
00:12:26,520 --> 00:12:29,520
‫لا، لا يجب أن أتحمس لذلك

194
00:12:31,800 --> 00:12:33,720
‫"(إنيشال دي)"

195
00:12:35,880 --> 00:12:37,600
‫"(إنيشال دي)"

196
00:12:52,200 --> 00:12:54,400
‫هل هنالك ما يدعوك للابتسام؟

197
00:12:55,360 --> 00:12:57,360
‫تبدين غريبة اليوم

198
00:12:57,600 --> 00:12:58,920
‫حقاً؟

199
00:12:59,160 --> 00:13:01,360
‫ألست هكذا دائماً؟

200
00:13:02,040 --> 00:13:04,040
‫تبدين سعيدة، بأمر ما

201
00:13:05,160 --> 00:13:08,120
‫في الحقيقة
‫سأذهب إلى الشاطئ مع أصدقائي!

202
00:13:08,360 --> 00:13:10,080
‫أنا متحمسة لذلك

203
00:13:10,520 --> 00:13:12,480
‫أصدقاء؟ أتعنين صديقاً؟

204
00:13:12,600 --> 00:13:16,400
‫ماذا؟ صديق؟ لا! مع صديقة فقط

205
00:13:17,040 --> 00:13:22,000
‫حسناً دعينا نذهب إلى محل ما
‫سأشتري لك ثوب سباحة جميلاً

206
00:13:22,920 --> 00:13:25,240
‫لا بأس فقد اشتريت واحداً

207
00:13:25,360 --> 00:13:27,360
‫لا أحتاج لاثنين

208
00:13:27,480 --> 00:13:30,320
‫أريد أن أراك في ثوب السباحة

209
00:13:30,600 --> 00:13:34,200
‫هذا سخيف، لقد رأيتني مسبقاً

210
00:13:34,560 --> 00:13:36,200
‫مزعج كالعادة

211
00:13:37,640 --> 00:13:39,200
‫أتساءل، إذا كان الغد مشمساً

212
00:13:39,520 --> 00:13:41,640
‫لا تتساءل عن أمر سخيف كهذا

213
00:13:41,920 --> 00:13:44,400
‫الجو رائع في (اليابان) كلها

214
00:13:45,000 --> 00:13:46,240
‫هل ستذهب إلى مكان ما؟

215
00:13:46,560 --> 00:13:47,800
‫إلى البحر

216
00:13:49,040 --> 00:13:50,040
‫البحر؟

217
00:13:50,440 --> 00:13:51,800
‫ماذا!؟

218
00:13:52,080 --> 00:13:56,000
‫أنا أريد الذهاب معك أرجوك

219
00:13:56,120 --> 00:13:57,280
‫هل يعقل؟

220
00:13:57,640 --> 00:14:00,400
‫أنت ذاهب برفقة فتاة!
‫أليس كذلك؟ فتاة!

221
00:14:00,720 --> 00:14:01,720
‫شيء كهذا

222
00:14:02,120 --> 00:14:04,480
‫من هي؟ هل أعرفها؟

223
00:14:04,600 --> 00:14:07,000
‫هل هي جميلة؟
‫ماذا عن جسمها؟

224
00:14:07,880 --> 00:14:09,120
‫إنها جميلة جداً

225
00:14:11,240 --> 00:14:13,560
‫(موجي ناتسوكي)

226
00:14:14,400 --> 00:14:15,400
‫نعم

227
00:14:15,680 --> 00:14:17,840
‫إنه لمن السخف ألا تخبرني بذلك

228
00:14:18,200 --> 00:14:22,320
‫أنا آسف، فالوضع لم يسمح لي بإخبارك

229
00:14:22,640 --> 00:14:24,040
‫المرة القادمة

230
00:14:25,440 --> 00:14:26,920
‫لا تبك، أرجوك

231
00:14:30,080 --> 00:14:32,320
‫ما الذي سيحدث في سباق اليوم؟

232
00:14:33,000 --> 00:14:37,560
‫لقد سمعت أن "الشموس الحمراء"
‫هزموا جميع من تحدوهم

233
00:14:37,800 --> 00:14:39,720
‫النتيجة واضحة جداً

234
00:14:40,040 --> 00:14:41,960
‫فريق (أكينا) سيهزم بالتأكيد

235
00:14:42,520 --> 00:14:45,360
‫مهما يكن الفريق الأسرع
‫فليس "الشموس الحمراء"

236
00:14:45,480 --> 00:14:47,560
‫إنه نحن "فريق شبان الليل"

237
00:14:48,080 --> 00:14:49,800
‫(تاكيشي)، لقد حان الوقت

238
00:14:49,920 --> 00:14:51,560
‫فلنذهب

239
00:14:52,280 --> 00:14:54,880
‫"فريق شبان الليل"

240
00:14:55,520 --> 00:15:01,840
‫صنعت للسرعة الفائقة
‫أصل رفيع وذوق رائع، إنها (آر 23)

241
00:15:01,960 --> 00:15:04,720
‫لن تخسر أمام منعطفات (أكاجي) السخيفة

242
00:15:12,800 --> 00:15:16,000
‫هذا مدهش
‫الهضبة تمتلئ وكأنه احتفال ما

243
00:15:17,920 --> 00:15:25,200
‫انتشر خبر السباق بين (إيكيتاني)
‫وفريق (أكاجي) السريع

244
00:15:31,000 --> 00:15:32,600
‫من الذي سينتصر؟

245
00:15:32,920 --> 00:15:37,400
‫الـ86 الخاصة بـ(تاكومي)
‫لا يمكن أن تخسر

246
00:15:39,120 --> 00:15:41,520
‫لم أتحمس هكذا منذ زمن بعيد

247
00:15:51,600 --> 00:15:53,400
‫هناك أناس كثيرون

248
00:15:53,920 --> 00:15:57,320
‫لم أر أشخاصاً بهذا العدد في (أكينا)

249
00:15:57,560 --> 00:16:01,600
‫"الشموس الحمراء" أحضرت كل فريقها
‫إلى هنا لإظهار سرعتهم

250
00:16:02,080 --> 00:16:04,920
‫إذا خسرنا الليلة، سوف يلحق بنا العار

251
00:16:05,560 --> 00:16:10,360
‫بالمناسبة، الـ86 التي كنت تتكلم عنها
‫هل هي حقيقية يا (إيكيتاني)؟

252
00:16:10,480 --> 00:16:11,480
‫نعم

253
00:16:12,040 --> 00:16:15,600
‫أنا لا أعتقد بأن سيارة 86 ستهزمهم

254
00:16:16,160 --> 00:16:20,480
‫سمعت بأن (إف دي) التي تخص
‫(كيسكي) صممت لتناسب المنحدرات

255
00:16:20,680 --> 00:16:24,280
‫وهي بقوة 350 حصاناً

256
00:16:24,520 --> 00:16:26,440
‫الفارق كبير بين السيارتين

257
00:16:26,840 --> 00:16:30,800
‫حتى على المنحدر، فمن المستحيل
‫على الـ86 أن تهزم تلك السيارة

258
00:16:30,920 --> 00:16:33,960
‫(إيكيتاني)، أمتأكد أنك لم تتلق
‫ضربة قوية على رأسك؟

259
00:16:35,160 --> 00:16:38,520
‫الـ86 تظل كما نعرفها
‫ولكن هذه غير عادية

260
00:16:38,800 --> 00:16:40,520
‫(كيسكي)، قالها بنفسه

261
00:16:40,800 --> 00:16:46,000
‫في الظاهر هي (تورينو) عادية
‫ولكن من الداخل هي وحش هائل

262
00:16:46,640 --> 00:16:47,720
‫ثقوا بي

263
00:16:48,280 --> 00:16:50,000
‫أنا متأكد أنه سيأتي

264
00:16:54,680 --> 00:16:56,680
‫وإذا لم يحضر؟

265
00:16:56,800 --> 00:16:58,600
‫هنالك جمهور كبير هنا

266
00:16:59,200 --> 00:17:02,080
‫أنا لا أريدهم أن يقولوا
‫إن نجوم (أكينا) تراجعوا

267
00:17:03,160 --> 00:17:05,640
‫إذا لم يحضر

268
00:17:07,080 --> 00:17:10,520
‫(كينجي)، مثل فريقنا ودافع عن شرفنا

269
00:17:12,280 --> 00:17:13,920
‫لا بد أنك تمزح

270
00:17:17,560 --> 00:17:22,160
‫- مجموعة من السيارات قادمة
‫- تستطيع سماع المحركات

271
00:17:27,840 --> 00:17:29,360
‫"الشموس الحمراء"!

272
00:17:30,520 --> 00:17:31,520
‫"(الشموس الحمراء)"

273
00:17:32,200 --> 00:17:34,520
‫إنهم هنا! "الشموس الحمراء"

274
00:17:37,760 --> 00:17:39,360
‫وأخيراً وصلوا

275
00:17:56,600 --> 00:17:59,400
‫الأخوان (تاكاشي) مشهوران جداً

276
00:17:59,520 --> 00:18:03,480
‫لقد سمعت أن والدهما
‫يملك مستشفى كبيراً في (أكاجي)

277
00:18:03,600 --> 00:18:05,920
‫لا تستطيع الفوز
‫أمام الأغنياء والمشاهير

278
00:18:06,440 --> 00:18:12,360
‫التقنية في القيادة تعتمد عليك أنت
‫وما تفعله بسيارتك

279
00:18:12,600 --> 00:18:14,760
‫"قمة (سيكي)"
‫"النقل العام"

280
00:18:18,840 --> 00:18:21,240
‫ما الذي يفعله (تاكومي)؟

281
00:18:21,360 --> 00:18:23,800
‫التحدي سوف يبدأ قريباً

282
00:18:24,040 --> 00:18:25,960
‫بالرغم من أنني حرصت على قدومه

283
00:18:26,080 --> 00:18:28,240
‫ذلك الغبي، الأحمق
‫الأبله، الحقير (تاكومي)!

284
00:18:28,360 --> 00:18:30,400
‫أنت لست صديقي أبداً بعد الآن

285
00:18:32,040 --> 00:18:33,200
‫هذا يؤلم!

286
00:18:33,960 --> 00:18:36,960
‫لا أستطيع الانتظار أكثر
‫سأذهب على دراجتي

287
00:18:37,760 --> 00:18:41,160
‫دعونا نبدأ التحدي في العاشرة
‫كما اتفقنا

288
00:18:41,320 --> 00:18:45,520
‫سيكون سهلاً في وقت متأخر
‫فلن تكون هنالك سيارات تسير

289
00:18:46,160 --> 00:18:49,800
‫سنستعمل اللاسلكي في البداية والنهاية
‫لنحسب الوقت المستغرق

290
00:18:50,360 --> 00:18:53,360
‫لنسمح للمتحدين بالتهور
‫والانطلاق بكل سرعتهم

291
00:18:53,480 --> 00:18:57,800
‫سنضع عند كل منعطف شخصاً
‫ليخبرنا بقدوم أية سيارة

292
00:18:58,080 --> 00:19:00,600
‫وسنستعمل الأضواء لتنبيه المتحدين

293
00:19:00,920 --> 00:19:02,080
‫حسناً

294
00:19:02,200 --> 00:19:04,320
‫يبدو أنهم مستعدون لكل شيء

295
00:19:04,440 --> 00:19:07,520
‫نعم، لا بد أنهم فعلوا هذا
‫في تحدياتهم السابقة

296
00:19:08,000 --> 00:19:12,960
‫بعد قول ذلك
‫دعونا نستمتع ببعض الجولات إلى العاشرة

297
00:19:13,480 --> 00:19:15,480
‫إن الجماهير مجتمعة

298
00:19:29,600 --> 00:19:32,080
‫الـ86 لم تظهر إلى الآن

299
00:19:32,280 --> 00:19:33,520
‫أتساءل عن السبب

300
00:19:33,800 --> 00:19:37,080
‫هل ينوون إخفاء سلاحهم السري
‫إلى اللحظة الأخيرة؟

301
00:19:41,360 --> 00:19:43,880
‫ماذا؟ هل أنت مستعد للذهاب؟

302
00:19:44,120 --> 00:19:46,720
‫بالتأكيد، ولكنني لا أريد فعل هذا

303
00:19:46,880 --> 00:19:49,120
‫لماذا؟ ألست واثقاً بفوزك؟

304
00:19:49,240 --> 00:19:51,680
‫قد كعادتك ولن تخسر

305
00:20:01,360 --> 00:20:02,560
‫إنه هنا

306
00:20:02,680 --> 00:20:05,240
‫(كيسكي) وسيارته (إف دي)

307
00:20:16,920 --> 00:20:19,120
‫مدهش!
‫يا لها من سرعة!

308
00:20:21,200 --> 00:20:23,320
‫التالي، هو (ريوسكي تاكاشي)

309
00:20:27,000 --> 00:20:28,480
‫اهربوا!

310
00:20:39,360 --> 00:20:41,280
‫إذاً هذا (ريوسكي)

311
00:20:41,440 --> 00:20:43,440
‫مهارته رائعة

312
00:20:54,360 --> 00:20:57,280
‫مدهش! يستطيعون الاقتراب من بعضهم
‫من دون أن يصطدموا

313
00:20:57,560 --> 00:20:59,880
‫تلك حركتهم الشهيرة
‫"الانجراف المتوازي"

314
00:21:00,800 --> 00:21:03,880
‫الاقتراب من السيارة الأخرى
‫هو الجزء الأصعب

315
00:21:04,280 --> 00:21:09,320
‫إن لم تتحكم بمسارك وسرعتك
‫في المناورة العرضية، فستفشل

316
00:21:11,360 --> 00:21:13,960
‫لكن هذا عرض صغير فقط

317
00:21:14,360 --> 00:21:17,240
‫القيادة وتحقيق الرقم القياسي تختلف!

318
00:21:33,080 --> 00:21:35,680
‫شبح (أكينا) لم يظهر إلى الآن

319
00:21:35,800 --> 00:21:37,400
‫أنت فقط منافسي

320
00:21:38,000 --> 00:21:39,960
‫أظهر نفسك يا سائق الـ86!

321
00:21:40,080 --> 00:21:41,960
‫"الشارع الأخضر للتبضع"

322
00:21:53,680 --> 00:21:55,640
‫هل أحتاج كوب ماء اليوم؟

323
00:21:56,000 --> 00:22:00,120
‫لا تحتاج لذلك
‫أنت لا تحمل أي طعام في الخلف!

324
00:22:00,400 --> 00:22:03,760
‫هذا ليس كالتوصيل اليومي
‫فأظهر كل ما لديك!

325
00:22:04,360 --> 00:22:06,680
‫خزان مملوء! لا تنس ذلك

326
00:22:06,840 --> 00:22:08,200
‫أعلم، أعلم

327
00:22:09,040 --> 00:22:10,200
‫أنا ذاهب

328
00:22:10,520 --> 00:22:11,800
‫حسناً

329
00:22:44,320 --> 00:22:46,640
‫"يخبرني فخري أن أكون جامحاً وقوياً"

330
00:22:46,760 --> 00:22:48,680
‫"لا أسمح للآخرين بالتدخل"

331
00:22:48,800 --> 00:22:50,520
‫"لا أتوقف أبداً، ولا أريد التوقف"

332
00:22:50,640 --> 00:22:52,440
‫"حتى لو ضحيت بكل ما أحب"

333
00:22:52,560 --> 00:22:54,800
‫"أتوجه نحو القمة، ولا أكترث لشيء"

334
00:22:54,920 --> 00:22:56,680
‫"احذروا، فأصوات التحذير تملأ المكان"

335
00:22:56,800 --> 00:22:58,160
‫"ولا مجال للضعفاء"

336
00:22:58,280 --> 00:23:00,440
‫"لأنني لن أكف عن مطاردة حلمي"

337
00:23:00,560 --> 00:23:02,480
‫"تحفيزك أمر سهل"

338
00:23:02,600 --> 00:23:04,440
‫"كل شيء محسوب"

339
00:23:04,560 --> 00:23:08,400
‫"حتى لو أردت الثوران
‫سينتهي بك الأمر في منطقة الأمان"

340
00:23:08,520 --> 00:23:12,360
‫"تفوز بشيء بينما تخسر آخر"

341
00:23:12,480 --> 00:23:16,360
‫"لن يتغير ذلك حتى لو انتهت الدنيا"

342
00:23:16,480 --> 00:23:24,400
‫"صرخة كبيرة
‫لا يمكن لأحد أن يتحملها"

343
00:23:24,520 --> 00:23:31,800
‫"الحلم الجامح يتجاوز الوقت الآن"

344
00:23:31,920 --> 00:23:35,840
‫"أجج حلمك ليتجاوز الظلام"

345
00:23:35,960 --> 00:23:37,800
‫"مثل شعاع نحو القمة"

346
00:23:37,920 --> 00:23:43,800
‫"سيضيء برودة الليل"

347
00:23:43,920 --> 00:23:47,840
‫"أجج حلمك لتستكشف الطريق"

348
00:23:47,960 --> 00:23:50,800
‫"هيا لجولة أخرى، لا تستسلم أبداً"

349
00:23:50,920 --> 00:23:52,600
‫"اهزمهم في جزء من الثانية"

350
00:23:52,720 --> 00:23:54,840
‫"توجه إلى البلدة التالية تاركاً أثرك"

351
00:23:54,960 --> 00:23:56,880
‫"غبار يتصاعد والخاسر يسقط"

352
00:23:57,000 --> 00:23:58,440
‫"الثرثرة مليئة بالمنطق"

353
00:23:58,560 --> 00:24:00,520
‫"مزعجة للغاية لذا فلنتجاهلها"

354
00:24:00,640 --> 00:24:02,440
‫"الفائز يختفي في الطريق"

355
00:24:02,560 --> 00:24:04,040
‫"وهو شيء سيعرفونه جيداً"

356
00:24:04,320 --> 00:24:11,840
‫"أجج حلمك في الطريق الذي لا ينتهي
‫من أن تنظر إلى ما هو خلفك"

357
00:24:11,960 --> 00:24:16,160
‫"واصل المضي قدماً لكي تسطع"

358
00:24:16,280 --> 00:24:20,880
‫"أجج حلمك لتعيش في الحاضر"

359
00:24:27,040 --> 00:24:31,560
‫"ضيف اليوم شهير بقيادته العدوانية
‫من الشموس الحمراء، (تاكاشي)"

360
00:24:31,720 --> 00:24:32,920
‫"أعطني ذلك!"

361
00:24:33,040 --> 00:24:35,440
‫"أظهر نفسك يا شبح (أكينا)!"

362
00:24:35,560 --> 00:24:38,040
‫"لا تقل إنك خفت وهربت"

363
00:24:38,160 --> 00:24:40,400
‫"هل تعتقد أنك ستفوز هذه المرة"

364
00:24:40,520 --> 00:24:42,680
‫"اصمت، لا شك"

365
00:24:42,800 --> 00:24:45,720
‫"سأنتقم مهما حصل"

366
00:24:45,840 --> 00:24:49,080
‫"في الحلقة القادمة
‫تبدأ المعركة أخيراً"

367
00:24:49,200 --> 00:24:53,440
‫"ومن سيفوز في المعركة الحاسمة
‫بين (إف دي) والـ86؟"

368
00:24:53,560 --> 00:24:54,960
‫"لا تفوتوها"