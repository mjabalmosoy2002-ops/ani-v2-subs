1
00:00:01,850 --> 00:00:04,020
.أُرسلت قوّات الدّفاع الذّاتي إلى المنطقة الخاصّة

2
00:00:04,020 --> 00:00:07,690
،كان إيتامي وبينا، الأميرة الثالثة للإمبراطوريّة
،يحاولان عقد السلام

3
00:00:07,690 --> 00:00:10,320
.ولكنّ زلزالاً مفاجئًا عكّر خططهم

4
00:00:10,780 --> 00:00:15,860
أنقذ إيتامي ورجاله نوريكو، امرأة يابانيّة
.تمّ أسرها من قِبل أخ بينا الأكبر، زولزال

5
00:00:15,860 --> 00:00:20,540
.وغادر بعد ذلك لقتل تنّين النّار الّذي قتل والد توكا

6
00:00:23,870 --> 00:00:27,840
!ألنوس هو مكانٌ رائع! تعالوا لزيارته في وقتٍ ما

7
00:00:27,840 --> 00:00:29,920
،الطّعام لذيذ

8
00:00:29,920 --> 00:00:32,130
!والعمل سهل

9
00:00:32,130 --> 00:00:35,590
.تبتسم السّماء لمدينةٍ رائعة

10
00:00:35,880 --> 00:00:40,220
هل سيحدث شيء

11
00:00:40,220 --> 00:00:43,850
جيّد اليوم يا ترى؟

12
00:00:45,360 --> 00:00:46,740
!أنتِ رائعة يا ديليلا

13
00:00:58,370 --> 00:00:59,970
من إيتاليكا؟

14
00:01:02,080 --> 00:01:03,290
يابانيّة...؟

15
00:01:04,930 --> 00:01:07,000
لماذا استلمت أمرًا كهذا؟

16
00:02:45,770 --> 00:02:49,520
.أنا ملكة الأرانب المقاتلين العظيمة

17
00:02:49,520 --> 00:02:52,380
إلى متى سأدع حياتي بين يدي العدوّ؟

18
00:02:53,810 --> 00:02:57,480
.تيولي-ساما، إنّه أنا، بورو

19
00:02:58,120 --> 00:02:59,070
ما الوضع؟

20
00:02:59,590 --> 00:03:01,330
.جيّد

21
00:03:01,330 --> 00:03:03,190
.حسنًا، انصرف

22
00:03:03,490 --> 00:03:04,520
.مفهوم

23
00:03:08,120 --> 00:03:12,000
.جاسوسي في ألنوس من عائلة فورمار سيقتُل نوريكو

24
00:03:12,710 --> 00:03:16,710
...المُحاربة الأرنبة الّتي تريد حياتي بتطاول

25
00:03:17,920 --> 00:03:20,220
،إن جعلت الأمر يبدو وكأنّ بينيا أمرت به

26
00:03:20,220 --> 00:03:23,300
،فستنهار العلاقات بين اليابان والإمبراطوريّة

27
00:03:23,300 --> 00:03:24,800
.وستستمرّ الحرب

28
00:03:25,720 --> 00:03:28,470
زولزال، الرّجل الّذي دمّر عشيرتي

29
00:03:28,470 --> 00:03:32,480
!والإمبراطوريّة وكلّ شيء آخر سيُدمّر

30
00:03:36,820 --> 00:03:37,690
،إلهي

31
00:03:38,650 --> 00:03:40,440
،التّابعون الّذين يُسندون السّماوات والأرض

32
00:03:40,990 --> 00:03:43,070
.أُقدّم صلواتي هنا

33
00:03:43,410 --> 00:03:47,700
.جسدي هو الهِبة الّتي تضيء شعلة الشّعيرة

34
00:03:48,040 --> 00:03:49,790
...إيمروي، إله الحرب

35
00:03:49,790 --> 00:03:51,460
...هاردي، إله العالم السّفليّ

36
00:03:51,750 --> 00:03:53,750
...ديلدوت، إله العهود

37
00:03:53,750 --> 00:03:55,460
...بارابان، إله الانتقام

38
00:03:55,960 --> 00:03:59,590
سوف يصبح جسدي السّيف

39
00:03:59,590 --> 00:04:01,260
.الّذي يقتل خصومي

40
00:04:01,760 --> 00:04:05,050
،لن أموت حتّى أنفّذ انتقامي من تيولي

41
00:04:05,050 --> 00:04:08,890
.المرأة الّتي خانت شرفها كمحاربة أرنبة وتخلّت عنّا

42
00:04:10,720 --> 00:04:14,730
حصل الملازم الأوّل إيتامي على معلومات
،قيّمةٍ وسرّيّة من السّكان المحليّين

43
00:04:14,730 --> 00:04:17,110
،وترك قيادة الوحدة للرّقيب الأوّل كواهارا

44
00:04:17,110 --> 00:04:20,780
.وتوجّه بمفرده إلى إقليم إلبي

45
00:04:21,080 --> 00:04:22,770
هل هذا صحيح؟

46
00:04:22,770 --> 00:04:23,750
.نعم

47
00:04:23,740 --> 00:04:27,490
طلب مركز القيادة كلّ المعلومات الّتي نستطيع
.إيجادها عن الموارد مثل النّفط

48
00:04:27,820 --> 00:04:29,530
،بأخذ الوضع المحيط بنا بعين الاعتبار

49
00:04:29,530 --> 00:04:32,960
.فإنّنا نحتاج بياناتٍ دقيقة الآن

50
00:04:33,750 --> 00:04:35,790
.سمعت أنّ هناك تنّينًا في تلك المنطقة

51
00:04:35,790 --> 00:04:37,500
.أنا متأكّدٌ أنّه يدرك ذلك

52
00:04:37,920 --> 00:04:40,590
لماذا قد يفعل شيئًا كهذا؟

53
00:04:41,510 --> 00:04:42,920
.ربّما لأنّه غبيّّ

54
00:04:52,430 --> 00:04:54,770
.حسنًا، اعتنيت بمعظم الأمر هكذا

55
00:04:55,100 --> 00:04:57,480
...والآن، إن استطعت الحصول على موافقة الفريق فقط

56
00:05:03,990 --> 00:05:06,950
إذًا؟ ما هي خطّة إيتامي؟

57
00:05:06,950 --> 00:05:07,860
!نعم

58
00:05:07,860 --> 00:05:10,200
،تحرّكات إيتامي ناشئة من تعليمات المقر 5-304

59
00:05:10,200 --> 00:05:14,660
بشأن بعثات البحث الإستراتيجيّ
.في المنطقة الخاصّة

60
00:05:14,660 --> 00:05:17,250
أعلم هذا، ولكن هذا ليس هو السّبب
الحقيقيّ، أليس كذلك؟

61
00:05:17,460 --> 00:05:21,250
.السّبب الوحيد لذهابه هو للبحث عن الموارد يا سيّدي

62
00:05:24,090 --> 00:05:25,170
.فهمت

63
00:05:29,760 --> 00:05:32,720
أعتقد أنّ بعضنا غبيٌّّ بما فيه الكفاية ليذهب للقتال

64
00:05:32,720 --> 00:05:34,770
.لأنّ دولةً أخرى قالت هذا

65
00:05:36,600 --> 00:05:38,730
.حتّى وإن كان غبيًّا، فإنّه يبقى مواطنًا يابانيًّا

66
00:05:39,060 --> 00:05:40,610
.لا يمكننا تركه يموت

67
00:05:40,940 --> 00:05:43,820
!هذا صحيح يا رجال، لا تتركوا ذلك الغبيّ يموت

68
00:05:44,190 --> 00:05:45,070
!أيّها العقيد كامو

69
00:05:45,070 --> 00:05:45,860
!حاضر

70
00:05:45,860 --> 00:05:48,110
.فريق القتال 1 في وضع الاستعداد

71
00:05:48,110 --> 00:05:51,660
فور عودة قوّات الدّفاع الذّاتي الجوّيّة
،مع بيانات الاستطلاع

72
00:05:51,660 --> 00:05:53,990
.كوِّنّوا مجموعة لمساندة بعثة البحث

73
00:05:53,990 --> 00:05:55,120
!أيّها المقدّم كاميكودا

74
00:05:55,120 --> 00:05:55,870
!حاضر

75
00:05:55,870 --> 00:05:57,790
،نطلب استطلاعًا جوّيًّا

76
00:05:57,790 --> 00:05:59,920
ودوريّة قتال جوّيّة أيضًا للاستعداد

77
00:05:59,910 --> 00:06:02,180
.لحيوانٍ مؤذٍ من المستوى الأوّل في المنطقة الخاصّة

78
00:06:02,480 --> 00:06:03,050
.انصرفوا

79
00:06:03,050 --> 00:06:04,320
!مفهوم

80
00:06:03,050 --> 00:06:04,710
فريق
القتال
الأوّل
في
المنطقة
الخاصّة

81
00:06:04,710 --> 00:06:06,350
!حسنًا، لنذهب

82
00:06:08,180 --> 00:06:11,140
كيف يمكنهم الاستعداد بهذه السّهولة؟

83
00:06:11,470 --> 00:06:13,010
،بالمناسبة أيّها الملازم الأوّل ياناغيدا

84
00:06:13,010 --> 00:06:14,560
أنت تتحدّث اللّغة المحلّيّة، أليس كذلك؟

85
00:06:14,890 --> 00:06:17,180
.هناك شخصٌ أوّد أن تقابله

86
00:06:19,520 --> 00:06:21,560
.ولكن أغلق فمك أوّلاً

87
00:06:23,610 --> 00:06:24,360
.ادخل

88
00:06:24,940 --> 00:06:26,070
.المعذرة

89
00:06:30,860 --> 00:06:33,660
.لقد أتيت، لقد كنت بانتظارك

90
00:06:34,030 --> 00:06:36,540
.أنا دوران، ملك إقليم إلبي

91
00:06:38,910 --> 00:06:40,370
...هذا هو الموضوع إذًا

92
00:06:42,250 --> 00:06:46,000
.يُفترض أنّ وليّ العهد يدير الأمور في البلد

93
00:06:46,020 --> 00:06:48,960
.على الأرجح أنّه سعيدٌ الآن لأنّي غير موجود

94
00:06:49,420 --> 00:06:54,050
لذا أريد منك إرسال هذه إلى الماركيز
.كليمزين والكونت وات تباعًا

95
00:06:54,720 --> 00:06:57,810
أريد أن يجمع هؤلاء الاثنان قوّاتهم

96
00:06:57,810 --> 00:07:01,230
.للسّماح لي باسترجاع الإقليم

97
00:07:01,600 --> 00:07:03,810
.لن نتدخّل بالأمور العائليّة

98
00:07:03,820 --> 00:07:06,390
.تحدّث بهذا مع الإمبراطوريّة من فضلك

99
00:07:08,680 --> 00:07:10,490
.يأست من الإمبراطوريّة

100
00:07:12,860 --> 00:07:17,200
ما الّذي سنجنيه من مساعدتنا لك إذًا؟

101
00:07:17,700 --> 00:07:19,620
،إن زوّدتموني بمرافَقة

102
00:07:19,620 --> 00:07:23,000
.سأعطيكم الإذن لعبور الحدود لهزيمة تنّين النّار

103
00:07:23,000 --> 00:07:24,170
كيف هذا؟

104
00:07:26,290 --> 00:07:29,970
أعتقد أنّه يمكننا الحصول عليها بسهولةِ
تخليل رأسك بالملح

105
00:07:29,970 --> 00:07:31,970
.وإرساله إلى وليّ العهد

106
00:07:33,090 --> 00:07:34,470
.لا أفهمك

107
00:07:34,850 --> 00:07:38,470
هناك أشخاصٌ لطيفون بما فيه الكفاية
.لمقاتلة تنّين نار لأجل شخصٍ آخر

108
00:07:39,470 --> 00:07:41,350
ماذا تريد إذًا؟

109
00:07:41,600 --> 00:07:43,850
.حقوق التّعدين وإلغاء الضّرائب

110
00:07:44,480 --> 00:07:47,190
.الذّهب والنّحاس هما مصدرا ثراء دولتي

111
00:07:47,190 --> 00:07:48,360
.لا أستطيع إعطاءك هذا

112
00:07:48,690 --> 00:07:51,190
.أيّ شيءٍ ليس ذهبًا أو نحاسًا إذًا

113
00:07:51,190 --> 00:07:54,610
لحظة، هل هناك شيءٌ آخر ذو قيمة أكثر؟

114
00:07:55,450 --> 00:07:57,780
إن كنت لا تعلم فمن الأرجح ألاّ
يكون هناك شيء، أليس كذلك؟

115
00:07:57,780 --> 00:08:01,120
أم هل أُجهّز الملح؟

116
00:08:02,860 --> 00:08:04,560
.حسنًا، حسنًا

117
00:08:04,880 --> 00:08:09,250
.ماذا عن الحقوق لأيّ شيء لا يُستخدم في العملة

118
00:08:10,010 --> 00:08:12,220
.لا تنسَ الجزء الخاصّ بالضّرائب

119
00:08:12,880 --> 00:08:14,720
أنت لا تنسى شيئًا، صحيح؟

120
00:08:15,220 --> 00:08:19,140
.حسنًا، سترافقك قوّات الدّفاع الذّاتي أثناء عودتك

121
00:08:19,430 --> 00:08:21,020
.ستكون مهمّةً ثانويّة بجانب مهمّة التّنّين

122
00:08:21,020 --> 00:08:22,600
.لن يكون أمرًا كبيرًا

123
00:08:23,770 --> 00:08:27,770
.سأرتّب حقّكم بعبور حدودنا

124
00:08:27,770 --> 00:08:30,280
.إنّه كتحالف أساسًا قبل كل شيء

125
00:08:31,610 --> 00:08:34,320
،ما دمتَ ستفي بكلمتك

126
00:08:34,320 --> 00:08:37,280
.فإنّ اليابان تنوي البقاء صديقة

127
00:08:42,000 --> 00:08:43,040
.سحقًا

128
00:08:43,040 --> 00:08:45,540
.ظننت أنّي استخدمت ياو للنّيل منه، ولكنّه نال منّي

129
00:08:46,710 --> 00:08:50,380
،لا يسانده الفريق هازاما والملك دوران فحسب

130
00:08:50,380 --> 00:08:51,920
.أنا أيضًا الآن

131
00:08:52,590 --> 00:08:55,720
.ذلك الغبيّ! آمل أن يهطل المطر عليه

132
00:09:01,010 --> 00:09:02,060
.إنّها تُمطر

133
00:09:02,310 --> 00:09:04,140
.أكره المطر

134
00:09:04,140 --> 00:09:06,020
.الأرضيّة سيئة في أنحاء هذا المكان

135
00:09:06,020 --> 00:09:09,110
.علينا عبورها قبل أن يسوء المطر

136
00:09:09,480 --> 00:09:10,650
.أنت محقّة

137
00:09:22,870 --> 00:09:26,120
.لا يوجد اتّصال من عائلتك منذ حادثة غينزا

138
00:09:27,040 --> 00:09:28,420
ربما يكونون

139
00:09:28,420 --> 00:09:31,130
.قد وقعوا ضحيّة له بطريقة ما

140
00:09:35,050 --> 00:09:36,420
مرحبًا؟ أمّي؟

141
00:09:36,420 --> 00:09:40,220
.الرّقم الّذي اتّصلتم به غير مستخدم

142
00:09:40,220 --> 00:09:41,810
—تحقّقوا من الرّقم من فضلكم و

143
00:09:43,560 --> 00:09:45,520
...أبي... أمّي

144
00:09:46,310 --> 00:09:47,140
...هيروكي

145
00:09:51,570 --> 00:09:54,030
.ربما عليّ الموت وحسب

146
00:09:55,030 --> 00:09:56,150
.فهمت

147
00:09:57,070 --> 00:09:58,950
.تريدين الموت

148
00:09:59,280 --> 00:10:00,450
.أنا سعيدة

149
00:10:00,450 --> 00:10:01,410
من أنتِ؟

150
00:10:03,030 --> 00:10:06,540
.لم أكن مرتاحةً بشأن قتل شخص لا يريد الموت

151
00:10:06,540 --> 00:10:08,290
.ولكن إن كنتِ تريدين الموت فلا بأس

152
00:10:08,290 --> 00:10:10,000
.سأكون أساعد وحسب

153
00:10:10,920 --> 00:10:13,090
.سوف تقتلينني

154
00:10:13,380 --> 00:10:16,010
.نعم، لديّ أسبابي الخاصّة

155
00:10:18,840 --> 00:10:19,970
.فهمت

156
00:10:22,470 --> 00:10:25,270
.أنا آسفة، حقًّا

157
00:10:25,680 --> 00:10:27,930
.لا أريد أن يؤلمني هذا

158
00:10:30,150 --> 00:10:31,730
.هذه مشكلة

159
00:10:31,730 --> 00:10:34,940
.لا أعرف طريقةً أطعنك بها ولا تتألّمين

160
00:10:37,240 --> 00:10:39,990
.تبدين كتيولي-سان قليلاً

161
00:10:41,280 --> 00:10:44,240
—ماذا قلتِ

162
00:10:45,450 --> 00:10:46,290
!أنتِ

163
00:10:46,540 --> 00:10:48,000
ما الّذي تفعلينه هناك؟

164
00:11:09,350 --> 00:11:10,270
ماذا؟

165
00:11:10,270 --> 00:11:12,100
ما الّذي يجري في الخارج؟

166
00:11:12,100 --> 00:11:13,020
!هناك

167
00:11:27,540 --> 00:11:28,750
!سحقًا

168
00:11:30,910 --> 00:11:32,830
!سحقًا! سحقًا

169
00:11:33,750 --> 00:11:35,170
!سحقًا

170
00:11:36,750 --> 00:11:39,090
!سحقًا! سحقًا

171
00:11:39,340 --> 00:11:42,090
!سحقًا! سحقًا! سحقًا

172
00:11:42,090 --> 00:11:45,930
!سحقًا! سحقًا

173
00:11:46,350 --> 00:11:49,100
!سحقًا

174
00:11:55,520 --> 00:11:58,480
!كارثة! كارثةٌ كبيرة

175
00:11:59,820 --> 00:12:01,280
هل حصل شيء ما؟

176
00:12:01,740 --> 00:12:04,780
!ديليلا طعنت ياناغيدا

177
00:12:19,550 --> 00:12:21,380
،إذًا أيّها الطّاهي غاستون

178
00:12:21,380 --> 00:12:23,510
ديليلا كانت جاسوسة في الحقيقة؟

179
00:12:23,510 --> 00:12:27,390
...نعم، أمرتها بالتّوقّف، ولكن

180
00:12:27,710 --> 00:12:30,290
.فهمت، شكرًا لك

181
00:12:30,270 --> 00:12:31,470
...لحظة

182
00:12:31,470 --> 00:12:32,020
نعم؟

183
00:12:32,560 --> 00:12:35,900
هل سيتمّ نفينا من البلدة؟

184
00:12:36,270 --> 00:12:37,270
لماذا؟

185
00:12:37,270 --> 00:12:39,150
.ليس لكم علاقة بهذا

186
00:12:43,320 --> 00:12:44,900
ما هذا؟

187
00:12:44,900 --> 00:12:46,870
هل كانت تنفّذ شعيرةً ما أم تصلي؟

188
00:12:46,870 --> 00:12:47,870
!كيكوتشي-سان

189
00:12:47,870 --> 00:12:48,580
.نعم

190
00:12:48,580 --> 00:12:50,740
هل هذه رسالة؟

191
00:12:52,750 --> 00:12:54,660
ختم عشيرة فورمار؟

192
00:13:04,170 --> 00:13:08,340
.نعلم أنّك بعت رأسيّة عشيرتنا

193
00:13:08,340 --> 00:13:11,060
!لا أعلم شيئًا! لست أنا

194
00:13:11,810 --> 00:13:13,220
.انظر بعناية

195
00:13:13,220 --> 00:13:15,690
.تُركت هذه العلامات بواسطة الأصابع الّتي لمستها

196
00:13:16,020 --> 00:13:19,400
.الّتي داخل الدائرة الحمراء تعود لديليلا

197
00:13:20,060 --> 00:13:22,440
إلى من تنتمي الأخرى برأيك؟

198
00:13:25,360 --> 00:13:28,410
.اعترف بارثولوميو كبير خدم عائلة فورمار

199
00:13:28,700 --> 00:13:31,280
الفصيل المعارض لمعاهدة السّلام حاول

200
00:13:31,280 --> 00:13:33,330
.استغلال عشيرة فورمار لاغتيال نوريكو موتشيزوكي

201
00:13:33,660 --> 00:13:36,920
،من بين كلّ النّاس الّذين يعرفونها
...وأكثر من يستفيد من هذا هو

202
00:13:37,870 --> 00:13:39,170
وليّ العهد زولزال؟

203
00:13:39,500 --> 00:13:41,630
.سيأخذ الذّهاب بالحصان عشرة أيّام للوصول إلى العاصمة

204
00:13:41,920 --> 00:13:43,760
.يُفترض أنّ العدوّ لا يعرف ما حصل بعد

205
00:13:44,170 --> 00:13:45,720
ماذا نفعل إذًا؟

206
00:13:45,970 --> 00:13:47,880
،لنخبر الكونت أنّ الاغتيال فشل

207
00:13:47,880 --> 00:13:50,140
.وأنّ السّفراء سيناقشون السّلام

208
00:13:50,140 --> 00:13:52,260
.سنرى من أين تتسرّب المعلومات

209
00:13:52,600 --> 00:13:55,480
.علينا التّحقّق من الأشخاص القريبين من زولزال أيضًا

210
00:13:55,480 --> 00:13:58,020
.فرقة البحث 3 داخل العاصمة الآن

211
00:13:58,980 --> 00:14:00,360
.حسنٌ

212
00:14:00,360 --> 00:14:02,070
على فرقة الاستطلاع 3

213
00:14:02,070 --> 00:14:04,730
.التّسلل إلى المنطقة حول وليّ العهد زولزال

214
00:14:05,740 --> 00:14:08,780
اجعلوا أيًّا مَن خدع أحدًا تحت حمايتنا

215
00:14:08,780 --> 00:14:11,070
!أو سفك دم أحد رجالنا يندم

216
00:14:11,070 --> 00:14:11,870
!حاضر

217
00:14:18,960 --> 00:14:19,790
!اسمعوا

218
00:14:21,420 --> 00:14:23,920
من طبخ لحم الما نوغا هذا؟

219
00:14:26,880 --> 00:14:28,090
أنت؟

220
