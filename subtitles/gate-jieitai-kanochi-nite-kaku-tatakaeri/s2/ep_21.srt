1
00:00:01,660 --> 00:00:04,100
تمّ إرسال قوّات الدفاع الذاتي إلى المنطقة الخاصة

2
00:00:04,220 --> 00:00:07,190
،من أجل إنقاذ توكا المتألمة نفسيًّا

3
00:00:07,190 --> 00:00:09,100
إيتامي ذهبَ لقتّل تنّين النار

4
00:00:09,980 --> 00:00:11,690
،وأثناء ذلك، في القاعِدة

5
00:00:11,690 --> 00:00:14,750
ديليلاه وياناغيدا تقاتلا ووقعت حادِثة

6
00:00:15,820 --> 00:00:19,280
إيتامي والآخرين وصلوا إلى مُستَوطنة جنّ الظلام

7
00:00:20,320 --> 00:00:24,290
وأخيرًا... قِتال تنّين النار على وشكِ البدء

8
00:02:14,200 --> 00:02:15,690
...كانت فكّرة سيئة

9
00:02:16,240 --> 00:02:17,070
ماذا؟

10
00:02:17,650 --> 00:02:21,450
إنّ توكا مهما أنكرت الأمر، فهي تبقى مُصرّةً على أنّني والِدُها

11
00:02:22,120 --> 00:02:26,290
توكا أبقت على نفسها طوال الوقت من خِلال تجنّب الواقع

12
00:02:26,290 --> 00:02:29,000
،أجل، اليوم أُرغمت على مواجهة الحقيقة

13
00:02:29,000 --> 00:02:30,790
ولم تستطع تحمُّل الأمر

14
00:02:30,790 --> 00:02:34,050
...هل ستجعلها مجددًا تواجه الواقع؟ أم ربما

15
00:02:34,050 --> 00:02:35,800
كلا، ليسَ لا نملكُ وقتًا لذلك

16
00:02:35,800 --> 00:02:38,170
لهذا السبب أحضرتها إلى هذا المكان

17
00:02:38,510 --> 00:02:41,300
...إذا توجب عليّ ذلك، فسوف أُرغمها

18
00:02:44,760 --> 00:02:45,810
هل من خطبٍ ما؟

19
00:02:45,810 --> 00:02:48,770
سِحري لم يستطع إصابة تنّين النار

20
00:02:48,770 --> 00:02:50,060
هذا أزعجني

21
00:02:51,100 --> 00:02:54,520
إنّها مشكلةٌ أنّ نصل هالبارد لم يجدي نفعًا عليه

22
00:02:54,520 --> 00:02:56,780
إذا لم أستطع قطعهُ، فسوف أوسعهُ ضربًا

23
00:02:56,780 --> 00:02:59,530
ولكن لكمُ شيءٍ حتّى الموت ليسَ من هواياتي

24
00:03:04,490 --> 00:03:05,290
،أيتّها القدّيسة

25
00:03:05,790 --> 00:03:10,420
إنّنا مُمتنّون لكِ لقدومكِ كُلّ هذه المسافة إلى هُنا

26
00:03:10,420 --> 00:03:13,340
ليسَ وكأنّني أتيتُ من أجلكم

27
00:03:13,340 --> 00:03:15,710
يا إيتامي-دونو، أودّ تقديمك

28
00:03:15,710 --> 00:03:17,590
هؤلاء هم محاربي عشيرتي

29
00:03:17,840 --> 00:03:21,010
،كورو، ميتو، بان، فان

30
00:03:21,010 --> 00:03:24,300
...نوكّو، كوم، سيم، نايو

31
00:03:24,300 --> 00:03:27,220
وبإحتسابي، سيكون هُناكَ تسعة منّا برفقتك

32
00:03:27,220 --> 00:03:29,980
سيتوجب عليكَ السير حتّى الوصول إلى عُش التنّين

33
00:03:29,980 --> 00:03:32,650
ستحتاج إلى مُرشدٍ ولإشخاصٍ لحمل أغراضكَ، أليسَ كذلك؟

34
00:03:33,360 --> 00:03:34,730
أنا آسف

35
00:03:35,020 --> 00:03:37,320
،لو أنّكَ لم تأتي

36
00:03:37,320 --> 00:03:39,650
فعاجلًا آم أجلًا كُنا جميعًا سنموت

37
00:03:40,320 --> 00:03:44,070
في هذهِ المعركة لا أحد سيتردّد في التضحية بحياته

38
00:03:44,320 --> 00:03:47,910
،ولكن... إذا أستمر في مهاجمة عشيرتكم إلى أن لم يبقى أحد

39
00:03:48,200 --> 00:03:51,290
فحتّى تنّين النار ألن يقع في مشكلةٍ إذا نفذ منه الطعام؟

40
00:03:51,710 --> 00:03:54,790
دورة نشاط وسبات تنّين النار طويلة للغاية

41
00:03:55,130 --> 00:03:59,880
،لذا، حتّى إذا استنفذ تقريبًا جميع مصادر طعامه، فستجدّد في أثناء سُباته

42
00:03:59,880 --> 00:04:02,180
فبإمكاننا الإفتراض بأنّها لن تكون مشكلةً له

43
00:04:03,180 --> 00:04:05,680
دورةُ نشاطِهِ وسُباته؟

44
00:04:09,560 --> 00:04:13,560
إذًا، هذه الأشياء هي ما أودّ منكم حملها

45
00:04:13,560 --> 00:04:17,270
التي دمّرت ذراع تنّين النار، العصيان الحديدية؟

46
00:04:17,270 --> 00:04:17,940
أجل

47
00:04:17,940 --> 00:04:19,980
سأُعلمكم الآن كيفية استخدامها

48
00:04:20,570 --> 00:04:21,530
هكذا؟

49
00:04:21,530 --> 00:04:22,520
جيّد

50
00:04:22,520 --> 00:04:25,230
الباقي هو تحديد الهدف والإطلاق

51
00:04:25,230 --> 00:04:29,210
وعندها، سوف يُقذف شيءٌ يدعى الكُتلة المُعاكسة بسرعةٍ مذهلة

52
00:04:29,840 --> 00:04:33,040
قبل أن تُطلق، عليكَ التأكد حتمًا أنّ لا أحد خلفك

53
00:04:33,330 --> 00:04:34,460
فهمت

54
00:04:37,840 --> 00:04:39,590
هذا صحيح، يبدو جيّدًا

55
00:04:39,880 --> 00:04:41,070
لقد إنتهينا هُنا أيضًا

56
00:04:41,070 --> 00:04:42,670
يمكننا الذهاب في أيّ وقت

57
00:04:43,470 --> 00:04:45,640
جعلتُ توكا تنام بسِحري

58
00:04:45,640 --> 00:04:49,600
.لقد ظلّت طوال الوقت تقول، أبي، أبي وهي خائفة

59
00:05:14,500 --> 00:05:15,540
هنا؟

60
00:05:15,540 --> 00:05:17,420
...أجل. جبل دوبا

61
00:05:17,420 --> 00:05:20,250
لقد قالوا بأنّهم رأو عُش تنّين النار هُنا ذات مرّة

62
00:05:20,710 --> 00:05:22,980
،تنّين النار يدخل ويُغادر عبر القِمّة

63
00:05:22,980 --> 00:05:26,220
وعلى الرّف الصخري في البركان، يقوم بإنشاء عُشّه

64
00:05:27,840 --> 00:05:29,290
هل نستطيع الدخول إلى هُناك؟

65
00:05:29,580 --> 00:05:32,050
هنالكَ كهفٌ يقود إلى عُشّ التنّين في منتصف الجبل

66
00:05:39,740 --> 00:05:42,730
،ذات مرّة، عندما كُنا نبحثُ عن الكبريت لإعداد الفواكهة المُدخنة

67
00:05:42,730 --> 00:05:44,490
دخلنا هذا الكهف

68
00:05:47,160 --> 00:05:49,990
،إنّهُ مرتبطٌ برّفٍ صخري بداخل حفرة البركان

69
00:05:50,280 --> 00:05:52,290
حيث رأينا تنّين النار نائمًا

70
00:05:52,290 --> 00:05:55,750
في اللحظة التي رأيناهُ فيها، قلنا بأنّ الأمر خطير وهربنا

71
00:05:56,210 --> 00:05:58,630
ألا نستطيع الدخول من حفرة البركان؟

72
00:05:58,630 --> 00:06:01,750
إنّها شديدة الإنحدار، من المستحيل النزول عبرها

73
00:06:01,750 --> 00:06:04,880
إذًا لا خيار لنا سوى الذهاب من خِلال هذا الكهف؟

74
00:06:05,170 --> 00:06:07,680
أنا لا أستطيع الدخول لتحت الأرض

75
00:06:07,970 --> 00:06:10,550
لا بأس، إنتظري بالخارج يا روري

76
00:06:10,850 --> 00:06:15,270
بينما نحنُ بالداخل،
تأكدي من أنّ تنّين النار لن يعود

77
00:06:33,830 --> 00:06:34,740
كيف كان؟

78
00:06:34,740 --> 00:06:37,750
تمامًا كما قال كورو، إنّهُ يؤدي إلى العُش

79
00:06:38,290 --> 00:06:40,640
وحاليًا، تنّين النار ليسَ موجودًا

80
00:06:40,640 --> 00:06:43,230
حسنًا... حالما ننتهي من تناول الطعام، سننّطلق

81
00:06:47,250 --> 00:06:48,840
هل تستطيعين سماعي يا روري؟

82
00:06:50,220 --> 00:06:51,720
أستطيعُ سماعك

83
00:06:52,740 --> 00:06:53,470
لنذهب

84
00:07:11,030 --> 00:07:13,070
إيتامي-دونو، إنّهُ أمامنا

85
00:07:13,070 --> 00:07:14,620
نتظروا هنا

86
00:07:24,290 --> 00:07:27,210
هذا هو عُشّ تنّين النار؟

87
00:07:34,350 --> 00:07:36,720
قشور... البيض؟

88
00:07:37,060 --> 00:07:39,600
،جميع الحيوانات تأكُل طعامها خِلال دورةِ نشاطِها

89
00:07:39,890 --> 00:07:42,020
،ثمّ تَتَكاثر وتُربّيّ صغارها

90
00:07:42,020 --> 00:07:43,810
لقد نسيتُ هذا الأمر

91
00:07:43,810 --> 00:07:46,070
أيعقل أنّهُ يوجد أكثر من تنّين نارٍ واحد؟

92
00:07:46,070 --> 00:07:50,490
كلا، لقد مضى وقتٌ طويل على كسر قشور البيض هذه

93
00:07:50,900 --> 00:07:52,860
أظنّ بأنّها قد غادرت العُشّ مُسبقًا

94
00:07:52,860 --> 00:07:55,830
نحنُ لم نرى سوى تنّين نارٍ واحد

95
00:07:55,830 --> 00:07:58,080
حسنًا، إذا كان هُناكَ عدوٌّ واحد، فهذا جيّد

96
00:07:58,330 --> 00:08:00,870
مذهل! إنّ هذا سيفٌ سِحري

97
00:08:01,210 --> 00:08:02,790
هذا مُذهل

98
00:08:03,500 --> 00:08:06,170
أيعقل أنّها تخصّ الأشخاص الّذين قتلهم تنّين النار؟

99
00:08:06,170 --> 00:08:11,440
صحيح، إنّها مِلكٌ للأشخاص الّذين تحدّوا تنّين النار في الماضي

100
00:08:12,530 --> 00:08:15,210
...حسنًا، بان، فين، نوكّو

101
00:08:15,210 --> 00:08:16,840
إحفروا حفرةً في وسط العُشّ

102
00:08:16,840 --> 00:08:17,390
!حاضر

103
00:08:17,850 --> 00:08:19,960
والبقية منكم، خذوا هذه

104
00:08:27,660 --> 00:08:29,650
سنقوم بإعداد ستّةٍ متبقيةٍ من هذه

105
00:08:30,190 --> 00:08:32,280
هل شيءٌ كهذا قادرٌ على هزيمة تنّين النار؟

106
00:08:32,530 --> 00:08:35,220
C-إنّها 74 كيلوغرام من متفجرات 4

107
00:08:35,510 --> 00:08:38,870
عندما تنفجر، من المفترض بأنّها ستدمّر تنّين النار بلا شكّ

108
00:08:39,240 --> 00:08:41,120
...حتّى لو نجى

109
00:08:44,240 --> 00:08:45,820
أنا سأتولّى الباقي

110
00:08:47,440 --> 00:08:48,940
يا روري، هل تسمعينني؟

111
00:08:49,270 --> 00:08:50,560
كيف هو الوضع بالخارج؟

112
00:08:52,480 --> 00:08:55,510
هل الصخور... تحجبُ وصول الإشارة؟

113
00:08:56,010 --> 00:08:56,800
!روري

114
00:08:58,760 --> 00:08:59,890
لا فائدة

115
00:09:00,270 --> 00:09:03,390
على هذا الحال، سيكون من السيئ العمل

116
00:09:03,390 --> 00:09:05,810
Signs الراديو قد تُفعّلها دون قصد

117
00:09:05,810 --> 00:09:06,900
الأمر خطير

118
00:09:10,190 --> 00:09:10,900
ما باليد حيلة

119
00:09:26,250 --> 00:09:29,210
الأمر يذكّرني بوقتي في القوّات الخاصة

120
00:09:38,510 --> 00:09:40,570
يوجي، هل تستطيع سماعي؟

121
00:09:40,570 --> 00:09:42,290
!تنّين النار أتى

122
00:09:42,620 --> 00:09:46,130
!يوكي؟! نيه، أجبّ عليّ

123
00:09:47,310 --> 00:09:48,350
...لا يمكن

124
00:09:52,490 --> 00:09:53,740
!يوجي

125
00:09:55,740 --> 00:09:57,450
ما المعنى من وضع السيوف عليها؟

126
00:09:57,450 --> 00:09:59,740
إنّها من أجل جعل الانفجار أكثر قوّة

127
00:10:09,980 --> 00:10:11,520
حسنًا، لقد إنتهى

128
00:10:18,310 --> 00:10:19,150
ما الخطب؟

129
00:10:24,310 --> 00:10:25,140
!تنّين النار

130
00:10:35,360 --> 00:10:36,070
!تنّين النار

131
00:10:51,500 --> 00:10:53,120
!بان! تحقّق من ورائك

132
00:10:56,590 --> 00:10:57,380
!فعلتُها

133
00:11:09,310 --> 00:11:10,350
!إسحب الزرّ

134
00:11:13,600 --> 00:11:14,850
!الزرّ يا نوكّو

135
00:11:18,570 --> 00:11:19,980
!يا إيتامي-دونو، توجّه للداخل

136
00:11:19,980 --> 00:11:20,690
!تبًا

137
00:11:30,410 --> 00:11:31,830
!آوي! لا تُطلقي

138
00:11:38,540 --> 00:11:41,460
!إيتامي-دونو

139
00:11:58,150 --> 00:12:01,480
...أبي مات بدلًا منّي

140
00:12:03,740 --> 00:12:05,110
...بسببي أنا

141
00:12:05,610 --> 00:12:07,780
!بسببي أنا، أبي قد

142
00:12:07,780 --> 00:12:09,120
هذا ليسَ صحيحًا

143
00:12:10,120 --> 00:12:12,590
من قام بقتل والِدكِ يا توكا هو تنّين النار

144
00:12:12,590 --> 00:12:13,700
هذهِ هي الحقيقة

145
00:12:13,700 --> 00:12:14,790
...ولكن

146
00:12:14,790 --> 00:12:17,250
لقد إعتبرتِ بأنّكِ يا توكا غير قادرةٍ على هزيمة تنّين النار

147
00:12:17,250 --> 00:12:20,210
لهذا، وجّهتِ هذا الغضب إلى نفسكِ

148
00:12:20,210 --> 00:12:22,210
!ولكن، أنا لا أستطيع هزيمته

149
00:12:25,560 --> 00:12:26,600
!إيتامي-دونو

150
00:12:27,480 --> 00:12:28,770
!هل أنتَ بخير؟

151
00:12:28,770 --> 00:12:29,480
!ياو

152
00:12:29,480 --> 00:12:31,230
!إذهب وإختبئ بالكهف

153
00:12:32,110 --> 00:12:33,230
!إنتظري يا ياو

154
00:12:37,040 --> 00:12:39,210
!تبًا! لقد قُطع

155
00:12:58,920 --> 00:13:00,750
!أيّها الغبي

156
00:13:07,260 --> 00:13:08,180
!عثرتُ عليه

157
00:13:15,810 --> 00:13:18,640
حتّى أنا، موطني قد سُلبَ بسببه

158
00:13:18,640 --> 00:13:20,270
خسرت العديد من أصدقائي

159
00:13:25,110 --> 00:13:26,190
...ليلي

160
00:13:38,250 --> 00:13:39,710
هذا غير كافٍ

161
00:13:39,710 --> 00:13:40,790
يجب أن تكون أسرع

162
00:13:42,790 --> 00:13:44,130
...لقد إخترقه

163
00:13:45,840 --> 00:13:46,920
!لقد إخترقه

164
00:14:03,100 --> 00:14:03,860
!ليلي

165
00:14:05,830 --> 00:14:09,120
!هذا هو إنتقامنا

166
00:14:11,290 --> 00:14:16,040
!مُتْ! أيّها الزاحف الوغد القذر

167
00:14:30,640 --> 00:14:31,680
!إيتامي-دونو

168
00:14:31,970 --> 00:14:33,180
!توقّفا! لا تأتيان

169
00:14:33,180 --> 00:14:34,140
!أحضري الساحرة

170
00:14:38,140 --> 00:14:38,930
!ليلي-دونو

171
00:14:41,190 --> 00:14:42,400
!تراجع

172
00:14:53,710 --> 00:14:54,670
!كورو

173
00:14:54,670 --> 00:14:55,380
!تبًا

174
00:15:05,590 --> 00:15:07,430
...أبي سوف يموت

175
00:16:19,030 --> 00:16:20,830
!هذا سيئ! لنهرب

176
00:16:24,700 --> 00:16:25,450
!توكا

177
00:16:30,920 --> 00:16:32,000
لا بأس

178
00:16:43,890 --> 00:16:45,140
هل الجميع بخير؟

179
00:16:46,060 --> 00:16:46,900
أنا حيّة

180
00:16:47,480 --> 00:16:48,520
ونحنُ أيضًا

181
00:16:48,520 --> 00:16:49,350
...بطريقةٍ ما

182
00:16:50,060 --> 00:16:52,230
لم أتعرض للكثير من الضرر

183
00:16:53,400 --> 00:16:54,480
حسنًا

184
00:16:55,810 --> 00:16:59,220
مهلًا... لقد تأخرتم

185
00:17:04,420 --> 00:17:05,290
!روري

186
00:17:09,580 --> 00:17:11,630
ما الخطب؟ ما الّذي حدث؟

187
00:17:14,510 --> 00:17:17,260
يا أونيه-ساما، يالهُ من منظرٍ مُحزن

188
00:17:20,300 --> 00:17:24,680
يا أونيه-ساما، بمجرّد أن تصبحي زوجةَ جلالتها

189
00:17:24,680 --> 00:17:31,770
هل تعتقدين فعلًا أنّ من الآداب اللائقة لمسُ إنسانٍ قذر، أو تركهُ يلمسكِ؟

190
00:17:32,360 --> 00:17:35,280
!من قد يودّ أن يتزوّج هاردي؟

191
00:17:40,810 --> 00:17:43,120
من تكون حضرتكِ؟

192
00:17:43,370 --> 00:17:44,990
أنا جيزيل

193
00:17:44,990 --> 00:17:47,030
تمامًا كما ترى، أنا مبعوثة

194
00:17:49,880 --> 00:17:52,210
أنا خادمة جلالتها هاردي

195
00:17:52,670 --> 00:17:58,440
و أتيتُ لأنّ جلالتها أمرتني بإحضار روري نيه-ساما إليها

196
00:18:01,040 --> 00:18:04,390
...ظننتُ بأنّ روري قويّةٌ للغاية، ولكن

197
00:18:04,680 --> 00:18:05,930
هل أنتَ أحمق؟

198
00:18:06,390 --> 00:18:11,620
إنّها هكذا لأنّ أونيه-ساما تلقت إصاباتك بدلًا عنك

199
00:18:15,980 --> 00:18:17,830
العقد قد تمّ

200
00:18:17,830 --> 00:18:21,810
...في الحقيقة، ما كُنتُ حتمًا لأهزمها بمفردي

201
00:18:21,810 --> 00:18:23,720
مع ذلك، هي بالكاد تَتَحرك

202
00:18:24,010 --> 00:18:25,920
،لا أعلم ما الّذي كُنتَ تفعله

203
00:18:25,920 --> 00:18:28,750
ولكنّ أونيه-ساما تلقت إصاباتكَ

204
00:18:29,290 --> 00:18:30,290
لماذا؟

205
00:18:30,580 --> 00:18:32,120
الأمر غير مُهمٍّ حقًا

206
00:18:32,120 --> 00:18:35,360
حسنًا، والآن بما أنّني فهمت الوضع، فالأمور ستختلف

207
00:18:35,360 --> 00:18:37,870
!هذه المرّة لن أكبحَ قوّتي بأكملها

208
00:18:41,090 --> 00:18:42,380
فرّاخ تنّين؟

209
00:18:42,380 --> 00:18:45,100
...لا يمكن
هل هي من البيض الموجودة في عُشّ تنّين النار؟

210
00:18:45,430 --> 00:18:47,350
،أيقظتُ تنّين النار عن قصد

211
00:18:47,350 --> 00:18:49,680
جعلتهُ يتكاثر، ودرّبتُ صِغارهُ على الطاعة

212
00:18:49,680 --> 00:18:53,350
مع وجودهما، أنا أقوى حتّى من أونيه-ساما

213
00:18:53,770 --> 00:18:55,610
أيقظتِ تنّين النار؟

214
00:18:55,860 --> 00:19:00,900
،إذًا الّذي قام بإيقاظ تنّين النار 50 عامًا قبل أوانهِ
كانت مبعوثةَ هاردي؟

215
00:19:00,900 --> 00:19:02,450
لماذا فعلتِ ذلكَ بعشيرتي؟

216
00:19:02,700 --> 00:19:07,200
لا يتعاطفُ مبعوثي الآلهة مع البشرية

217
00:19:07,790 --> 00:19:09,660
بما في ذلك أنا أيضًا

218
00:19:11,120 --> 00:19:12,690
بالضبط

219
00:19:12,690 --> 00:19:16,380
والبشر والجنّ لا ينبغي عليهم التدخّل في شؤوننا

220
00:19:16,790 --> 00:19:19,290
،ولكن كما تعلمين، قد يكون بشريًّا

221
00:19:19,290 --> 00:19:22,310
إلا أنّ هذا الشخصَ هُنا هزمَ تنّين النار

222
00:19:23,510 --> 00:19:25,160
شخصٌ يهزم تنّين النار؟

223
00:19:25,160 --> 00:19:26,480
محال

224
00:19:26,480 --> 00:19:27,890
من الّذي فعلها؟

225
00:19:30,590 --> 00:19:31,850
هاه؟ أنا؟

226
00:19:31,850 --> 00:19:33,800
أصبحُ الأمر مُثيرًا للإهتمام

227
00:19:33,800 --> 00:19:37,240
!تواتو! موتو! أنتما أيضًا إنتقما لموت والِدكما

228
00:19:37,240 --> 00:19:38,610
لا تَتَساهلا

229
00:19:40,230 --> 00:19:41,110
!إذهبا

230
00:19:43,320 --> 00:19:44,030
!مستحيل

231
00:19:44,320 --> 00:19:45,860
!أنتما! خلفهم

232
00:19:51,500 --> 00:19:52,870
!تمّ الرصد

233
00:19:52,870 --> 00:19:55,170
التنّين أصغر من المرّة السابقة

234
00:19:55,170 --> 00:19:57,920
يوجدُ اثنانٍ منهم، إنّهما هدفٌ مختلف

235
00:19:57,920 --> 00:20:01,130
ولكن، إنّهما يلاحقان المُلازم إيتامي بلا شكّ

236
00:20:01,130 --> 00:20:03,130
!أنتَ مُحقّ، لنفعلها

237
00:20:07,390 --> 00:20:08,640
!الهدف تحدّد

238
00:20:08,640 --> 00:20:11,600
!هاوك ويند-01، فوكس-02، إطلاق

239
00:20:14,020 --> 00:20:15,350
!فوكس-03

240
00:20:18,940 --> 00:20:22,940
!تريبور، هاوك ويند-01، لقد أردينا الهدف

241
00:20:23,450 --> 00:20:26,190
هاوك ويند-01، تريبور تمّ الاستلام

242
00:20:26,190 --> 00:20:27,820
المباشرة بالقصف المدفعي

243
00:20:29,000 --> 00:20:30,660
!الصدمة...! الآن

244
00:20:32,410 --> 00:20:35,370
!المباشرة بالضرب على الهدف
!إبقوا على الإحداثيّات! أطلقوا لزيادة القوّة

245
00:20:48,510 --> 00:20:51,100
ما... ما هذا؟

246
00:20:55,180 --> 00:20:57,140
...جيزيل

247
00:20:57,480 --> 00:20:59,190
أين أنتِ؟

248
00:20:59,610 --> 00:21:01,110
...أونيه-ساما

249
00:21:02,730 --> 00:21:05,110
أينَ أنتِ؟

250
00:21:05,570 --> 00:21:06,900
!هذا سيئ

251
00:21:08,280 --> 00:21:11,700
هاوك ويند-01، تريبور، تمّ تأكيد القتل

252
00:21:11,700 --> 00:21:13,120
إكتملت المهمّة

253
00:21:13,410 --> 00:21:15,120
سننال البينجو قريبًا

254
00:21:15,120 --> 00:21:17,580
من الأفضل أن نعود، وإلا سينفذ الوقود منّا

255
00:21:17,580 --> 00:21:18,580
عُلم

256
00:21:18,580 --> 00:21:22,040
!إكتملت المهمّة! 01، 02! عودا للقاعدة

257
00:21:22,040 --> 00:21:23,460
02تمّ الاستلام

258
00:21:26,880 --> 00:21:28,590
...لماذا قوّات الدفاع الذاتي

259
00:21:31,220 --> 00:21:32,600
...أنا مُرهقة

260
00:21:34,560 --> 00:21:37,060
نحنُ على قيد الحياة، أليس كذلك؟

261
00:21:37,350 --> 00:21:38,140
أجل

262
00:21:38,140 --> 00:21:39,810
لقد هزمناه

263
00:21:40,190 --> 00:21:40,850
...أجل

264
00:21:43,860 --> 00:21:45,360
أخذتُ إنتقامي

265
00:21:46,620 --> 00:21:49,800
...توقفي عن مناداتي بـ"أبي" بعد الآن

266
00:21:51,350 --> 00:21:54,330
كلا! لقد إعتدتُ على ذلكَ الآن

267
00:21:55,000 --> 00:21:55,920
فهمت

268
00:21:58,880 --> 00:22:01,510
أيّها المُراقب، أعطني تقريرًا عن الوضع

269
00:22:01,510 --> 00:22:03,220
ألفِرقة تَتَحركُ لاسترجاع إيتامي

270
00:23:36,610 --> 00:23:38,140
الحلقة القادمة من: البوابة

271
00:23:38,600 --> 00:23:41,060
"مدينة السِحر روندل"