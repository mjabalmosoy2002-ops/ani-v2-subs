1
00:00:01,730 --> 00:00:03,920
.أُرسلت قوّات الدّفاع الذّاتيّ إلى المنطقة الخاصّة

2
00:00:03,920 --> 00:00:08,190
رئيس الوزراء في اليابان مجبرٌ على اتّخاذ
القرار بشأن إنقاذ اليابانيّين أم لا

3
00:00:08,190 --> 00:00:12,190
وأعضاء المجلس الأعلى المؤيّدين للسّلام
.محتجزون في قصر اليشم من قِبل جيش زولزال

4
00:00:12,930 --> 00:00:17,240
واجهت جنود فارسات الورد الثّلاثمائة
.ما يقارب ألفًا من جنود الإمبراطوريّة

5
00:00:17,560 --> 00:00:21,120
في تلك الأثناء، إيتامي والفتيات ملاحَقون
،من قِبل عازف المزمار المرقّط

6
00:00:21,120 --> 00:00:25,120
.قاتلٌ غامض يمكنه التّحكم بقلوب الرّجال

7
00:01:57,530 --> 00:02:02,200
إنهنّ مجرّد نساء ترتدين دروعًا
!يلعبون دور الفروسيّة

8
00:02:02,710 --> 00:02:05,440
.إنهنّ لسنَ أندادًل لجنود الإمبراطوريّة المحنّكين

9
00:02:08,600 --> 00:02:11,290
!لا داعيَ للخوف منهم، مهمًا كانوا

10
00:02:11,290 --> 00:02:14,570
!إنّنا نقاتل لدعم أوامر الإمبراطور

11
00:02:14,570 --> 00:02:15,730
!استعددن

12
00:02:15,980 --> 00:02:16,770
!نعم

13
00:02:19,000 --> 00:02:21,380
لماذا نقاتل حلفاءنا؟

14
00:02:21,380 --> 00:02:22,150
!اصمت

15
00:02:22,450 --> 00:02:26,290
!إن سمعك الأوبريتشنينا فسيقتلون عائلتك أيضًا

16
00:02:26,670 --> 00:02:28,050
!إنّه حكمٌ من الرّعب

17
00:02:28,930 --> 00:02:30,580
!سلّوا سيوفكم

18
00:02:28,930 --> 00:02:30,580
!تقدّموا

19
00:02:46,980 --> 00:02:48,850
.أخبروني

20
00:02:49,550 --> 00:02:51,390
هل أنتم الصّبية من نُزل بحر الكتب؟

21
00:02:53,380 --> 00:02:54,230
.إنّها هنا

22
00:02:54,490 --> 00:02:56,820
.إنّك الوحيدة الّتي لن يتعرفوا على وجهها

23
00:02:57,240 --> 00:02:59,190
.لذا أودّ منكِ أن تقومي بالاستطلاع

24
00:03:01,110 --> 00:03:02,380
.اسمعوا

25
00:03:02,380 --> 00:03:05,190
.سأمثّل أنّي تحت تأثير عازف المزمار المرقّط

26
00:03:05,200 --> 00:03:07,660
.وسأهاجم ليلي في يوم تقديمها

27
00:03:07,950 --> 00:03:10,500
،أنتم حذّروا ليلي بشأن هذا

28
00:03:10,500 --> 00:03:13,250
.واجعلوها ترتدي درعًا تحت ملابسها

29
00:03:13,630 --> 00:03:15,250
ما الّذي سيحدث بعد ذلك؟

30
00:03:15,710 --> 00:03:18,510
.سنجعلها تمثّل أنّها ميتة

31
00:03:18,510 --> 00:03:21,090
عندها سيأتي عازف المزمار المرقّط بنفسه

32
00:03:21,090 --> 00:03:23,510
.ليرى ما إن كانت ميتةً حقًّا

33
00:03:23,510 --> 00:03:27,260
!فهمت! وبعدها نمسك به

34
00:03:28,310 --> 00:03:31,600
أنتم تذكرون وجهه، أليس كذلك؟

35
00:03:31,940 --> 00:03:32,980
!بالطّبع

36
00:03:33,230 --> 00:03:34,690
!لن ننساه أبدًا

37
00:03:37,020 --> 00:03:40,110
.إذًا؟ هذه هي فرصتكم لاستعادة احترامكم

38
00:03:40,110 --> 00:03:41,490
هل ستشاركون؟

39
00:03:41,700 --> 00:03:43,110
!بالطّبع سنشارك

40
00:03:45,200 --> 00:03:48,040
.لقد خُدعوا ببساطة مرّةً أخرى

41
00:03:48,290 --> 00:03:51,000
!حسنًا إذًا، اتبعوا الخطّة

42
00:03:51,290 --> 00:03:53,000
!إلى اللّقاء

43
00:04:14,440 --> 00:04:15,810
هل جهزتِ؟

44
00:04:16,100 --> 00:04:16,980
.نعم

45
00:04:20,860 --> 00:04:22,690
رداء معلّمة جديد إذًا؟

46
00:04:23,030 --> 00:04:27,280
تقول أنّها لم تستطع التّخلص من البقع
.الّتي تسببت بها أربيجيو

47
00:04:27,570 --> 00:04:28,370
.فهمت

48
00:04:28,740 --> 00:04:31,500
.ولكن هذا يبدو جيّدًا أيضًا

49
00:04:33,790 --> 00:04:35,000
.المعذرة

50
00:04:35,790 --> 00:04:38,290
.شاندي مفقودة منذ أربعة أيّام

51
00:04:38,590 --> 00:04:41,590
.أعتقد في رأيي أنّه من المبكّر أن نستسلم

52
00:04:43,720 --> 00:04:47,840
.أودّ الذّهاب للبحث في المنطقة مرّةً أخرى

53
00:04:48,970 --> 00:04:51,640
!أنا آسفة لتأخّري

54
00:04:54,890 --> 00:04:56,350
شاندي؟

55
00:04:56,730 --> 00:04:58,480
...مـ-ماء

56
00:04:59,560 --> 00:05:00,940
.آسفة

57
00:05:00,940 --> 00:05:02,900
،كنت ألاحق فتاةً تدعى نونرا

58
00:05:02,900 --> 00:05:04,610
.وتأخّرت

59
00:05:04,610 --> 00:05:08,320
ألم تستطيعي إرسال رسالةٍ على الأقلّ إذًا؟

60
00:05:08,700 --> 00:05:10,990
!لم يكن لديّ وقت لذلك

61
00:05:11,540 --> 00:05:15,410
هل أتى الفتية للحديث معكم؟

62
00:05:15,660 --> 00:05:16,420
.نعم

63
00:05:16,710 --> 00:05:19,290
.أخبروا ليلي أن ترتدي درعًا

64
00:05:20,710 --> 00:05:25,380
أنا متأكّدة أنّكم لاحظتم، ولكن نونرا هذه
.هي دمية لعازف المزمار المرقّط

65
00:05:25,380 --> 00:05:26,840
.كما توقّعت

66
00:05:26,840 --> 00:05:28,970
.الدّرع لن يجدي نفعًا

67
00:05:28,970 --> 00:05:31,970
.على الأرجح أنّها ستستهدف رقبتها

68
00:05:31,970 --> 00:05:36,770
أملنا الوحيد إن ظهرت هو إمساكها
.قبل أن تقترب من ليلي-سان

69
00:05:37,100 --> 00:05:38,440
.أنتِ مُحقّة

70
00:05:39,310 --> 00:05:42,650
إذًا يا شاندي، هل وصلتِ إلى عازف المزمار المرقّط؟

71
00:05:42,650 --> 00:05:43,440
.نعم

72
00:05:43,440 --> 00:05:47,320
،كما قال الصّبية الخدم
.كان رجلاً يرتدي زيّ صيّاد جوائز

73
00:05:47,650 --> 00:05:50,410
،اقتفيتُ أثره إلى مدينة بايران

74
00:05:50,780 --> 00:05:53,540
.ولكنّي أضعته عندما شحت بعينيّ عنه قليلاً

75
00:05:53,870 --> 00:05:57,460
،أخذ الطّريق يومان ذهابًا وإيابًا
.وقامت بتقفّي أثره بمفردها

76
00:05:57,870 --> 00:05:59,460
.لا يمكنني لومها

77
00:05:59,960 --> 00:06:03,550
في الحقيقة، كلّ ما أردنا منكِ رؤيته هو

78
00:06:03,550 --> 00:06:07,010
.من كان يقوم بالاتّصال مع الصّبية الخدم

79
00:06:07,970 --> 00:06:11,720
كانت أيامي الأربعة بلا فائدة إذًا؟

80
00:06:11,720 --> 00:06:14,390
.هذا غير صحيح

81
00:06:14,680 --> 00:06:17,680
.تأكيد مظهره يساعدنا بشكلٍ كبير

82
00:06:18,020 --> 00:06:18,890
.شكرًا لكِ

83
00:06:19,190 --> 00:06:22,020
لم تأكلي، أليس كذلك؟
.اذهبي للأكل في الطّابق السّفلي

84
00:06:22,020 --> 00:06:22,810
!حسنًا

85
00:06:26,110 --> 00:06:29,070
هل نخبر الصّبية بذلك؟

86
00:06:29,070 --> 00:06:32,740
.لا، لنتركهم مخدوعين

87
00:06:33,330 --> 00:06:35,870
.سيعملون بجدٍّ أكبر هكذا

88
00:06:36,500 --> 00:06:37,910
.ثمّ سنتّبع نحن الخطّة

89
00:06:38,250 --> 00:06:41,630
.نجد عازف المزمار المرقّط عندما يظهر في التّقديم

90
00:06:43,840 --> 00:06:44,710
.حظًّا موفّقًا

91
00:06:44,710 --> 00:06:46,170
.بدأت أشعر بالتّوتّر

92
00:06:46,960 --> 00:06:48,760
.يا له من عددٍ كبيرٍ من النّاس

93
00:06:48,760 --> 00:06:53,550
قد يكون هناك آخرون قد خُدعوا
.من قِبل عازف المزمار المرقّط هنا

94
00:06:53,550 --> 00:06:56,350
.يجب علينا الحذر

95
00:06:56,350 --> 00:06:57,020
.نعم

96
00:06:57,020 --> 00:06:58,810
!إنّهم هنا

97
00:06:58,810 --> 00:07:00,440
!من هنا

98
00:07:01,730 --> 00:07:03,560
!أنتِ متأخّرةٌ يا ليلي

99
00:07:03,560 --> 00:07:04,820
.لست متأخّرة

100
00:07:04,820 --> 00:07:07,900
.يُفترض أنّهم لا يزالون يقبلون المشاركين

101
00:07:07,900 --> 00:07:10,150
.يا لك من شقيّة كعادتكِ

102
00:07:13,320 --> 00:07:15,660
.استطعتِ الانتهاء في الوقت

103
00:07:15,660 --> 00:07:18,370
!يا إلهي، أربيجيو

104
00:07:19,700 --> 00:07:21,330
ما الأمر أيّتها المعلّمة العظيمة؟

105
00:07:21,330 --> 00:07:22,830
.يا إلهي

106
00:07:22,830 --> 00:07:25,840
لقد بقيتِ مستيقظةً طوال اللّيل تقومين بتعديل رداءك

107
00:07:25,840 --> 00:07:27,840
.لكي تتمكّن من أخذه إن احتاجته

108
00:07:27,840 --> 00:07:29,970
!ولكن أظنّ أنّها لم تحتجه

109
00:07:30,880 --> 00:07:31,930
!أيّتها المعلّمة العظيمة

110
00:07:31,930 --> 00:07:35,050
!أخبرتكِ أن تبقي ذلك سرًّا

111
00:07:35,350 --> 00:07:38,180
!يا إلهي! أنا آسفة

112
00:07:39,100 --> 00:07:42,100
على الأشخاص الّذين يريدون أخذ
.اختبار المعلّمين التّجمّع هنا

113
00:07:43,560 --> 00:07:44,730
،أربيجيو-سان

114
00:07:45,400 --> 00:07:48,860
هل هناك حدٌّ لعدد المتقدّمين الّذين سينجحون؟

115
00:07:48,860 --> 00:07:51,900
،لا، الجميع ينجح في بعض الأحيان

116
00:07:51,900 --> 00:07:54,160
.وفي أحيانٍ أخرى لا أحد ينجح

117
00:07:54,160 --> 00:07:55,320
لماذا؟

118
00:07:55,570 --> 00:07:59,540
كنت أفكّر أنّ عازف المزمار المرقّط قد وضع أحدًا منهم

119
00:07:59,540 --> 00:08:03,540
.للتّخلّص من أحدٍ كان يقف عقبةً في طريقهم

120
00:08:03,790 --> 00:08:05,710
.هذا مستحيل

121
00:08:05,710 --> 00:08:07,250
جميعهم حكماء

122
00:08:07,250 --> 00:08:10,460
.يحاولون أن يكونوا أطبّاء أو معلّمين

123
00:08:10,460 --> 00:08:13,180
.جميعهم أشخاصٌ رائعون

124
00:08:17,550 --> 00:08:22,180
ماذا إن سرق أحدٌ ما البحث
الّذي قضيتِ سنين عدّة في العمل عليه؟

125
00:08:22,600 --> 00:08:27,520
وذلك الشّخص على وشك
أن يعلن أنّه ملكٌ له؟

126
00:08:28,650 --> 00:08:33,030
،وإن كان ذلك الشّخص أمامكِ مباشرة
يتصرّف وكأنّ ليس هناك شيء خاطئ؟

127
00:08:34,070 --> 00:08:37,620
...حسنًا، إن كنت أنا، فذلك السّارق

128
00:08:43,580 --> 00:08:44,870
.لا تتحرّك

129
00:08:54,550 --> 00:08:56,340
!ليست غلطتي

130
00:08:56,340 --> 00:08:59,720
!إنّه خطأ هذه الفتاة لسرقة بحثي

131
00:09:01,720 --> 00:09:05,940
كيف يمكن لفتاةٍ كهذه أن تحاول
كسب لقب المعلّم على أيّ حال؟

132
00:09:05,940 --> 00:09:07,940
!لقد سرَقته بالطّبع

133
00:09:08,400 --> 00:09:11,020
.يمكنك الحديث بشأنِ هذا في مكانٍ آخر

134
00:09:11,780 --> 00:09:14,110
.يبدو أنّه قد خُدع كما البقيّة

135
00:09:14,110 --> 00:09:16,110
.لذا قم بالتّفسير له

136
00:09:16,110 --> 00:09:17,570
.مفهوم

137
00:09:19,910 --> 00:09:21,120
ما الّذي تفعله؟

138
00:09:21,490 --> 00:09:22,700
.لقد أنقذتني

139
00:09:24,960 --> 00:09:25,960
.شكرًا لك

140
00:09:27,620 --> 00:09:31,290
.نعم، سنبقيكِ آمنة. لا تخافي

141
00:09:34,880 --> 00:09:37,130
.حظًّا موفّقًا بتقديمكِ

142
00:09:39,840 --> 00:09:41,850
لجنة اختبار درجة المعلّمين

143
00:09:41,850 --> 00:09:45,140
...وبالتّالي، إذا اتّبعنا

144
00:09:45,140 --> 00:09:47,520
،مسار هذا الرّسم البيانيّ

145
00:09:47,520 --> 00:09:49,650
يمكن تفسير تراجع

146
00:09:49,650 --> 00:09:51,860
.حركة الكواكب

147
00:09:50,150 --> 00:09:51,860
!غبيّ

148
00:09:52,150 --> 00:09:54,320
من أي حفرةٍ خرجت؟

149
00:09:54,320 --> 00:09:56,950
!تلك النّظريّة موجودةٌ منذ زمنٍ بعيد

150
00:09:56,950 --> 00:10:01,070
نظريّة موكوري لمركزيّة الشّمس
!لها معنى أكثر بكثير

151
00:10:01,070 --> 00:10:03,910
!صحيح! أيها الطّفل الغبيّ

152
00:10:03,200 --> 00:10:04,740
!انصرف

153
00:10:04,740 --> 00:10:06,620
!لقد فشلت! فشلت

154
00:10:10,500 --> 00:10:12,340
!أمّي

155
00:10:12,340 --> 00:10:13,750
.فهمت

156
00:10:13,750 --> 00:10:16,840
هذا هو سبب ارتداء الملابس البيضاء للاختبار؟

157
00:10:19,430 --> 00:10:20,840
.سأكون على ما يرام

158
00:10:22,260 --> 00:10:25,560
.نعم. هذا سيجعل الحماية أسهل

159
00:10:25,560 --> 00:10:28,770
،إن كان باستطاعتنا فهم سبب التّشويهات العالميّة هذه

160
00:10:28,770 --> 00:10:33,360
فقد يقرّبنا ذلك من أسرار
.خلق هذا العالم

161
00:10:34,860 --> 00:10:35,900
.ليس سيّئًا

162
00:10:38,450 --> 00:10:40,780
.حان دوركِ أخيرًا

163
00:11:06,430 --> 00:11:08,890
.أتمنّى لو أنّها انتظرت إلى ما بعد التّقديم

164
00:11:13,520 --> 00:11:15,270
.تلك المرأة على ما يرام

165
00:11:15,820 --> 00:11:17,980
ممّا يعني... هذه هي نونرا؟

166
00:11:29,290 --> 00:11:30,250
!لن أصيبها في الوقت المناسب

167
00:11:48,520 --> 00:11:50,770
لماذا تم إطلاق كلّ السّحر دفعةً واحدة؟

168
00:11:52,350 --> 00:11:56,440
كلّ المدينة كانت تتحدّث عن احتمال
.وجود قاتل يسعى خلف ليلي

169
00:11:56,690 --> 00:11:59,690
.الجميع كان ينتظر هذه الفرصة

170
00:12:01,490 --> 00:12:03,990
.أتمنّى لو كان لقوّات الدّفاع الذّاتيّ سحرٌ أيضًا

171
00:12:05,160 --> 00:12:07,370
.ولكن، أنتِ بخير الآن على أيّ حال

172
00:12:07,990 --> 00:12:09,580
.حظًّا موفقًا مع ما بقي لكِ

173
00:12:39,570 --> 00:12:40,320
!ليلي

174
00:12:45,280 --> 00:12:46,530
أميرة بينيا؟

175
00:12:48,070 --> 00:12:49,660
أنتم مرّةً أخرى؟

176
00:12:50,330 --> 00:12:51,490
ما الأمر؟

177
00:12:52,000 --> 00:12:54,040
.أخبارٌ مؤسفة

178
00:12:55,290 --> 00:12:58,380
.سنضطرّ أن نطلب منك تغيير ملابسكِ إلى هذه

179
00:13:18,560 --> 00:13:21,110
ألم تأتِ الأوامر بعد أيّها الفريق؟

180
00:13:21,110 --> 00:13:23,530
!سيسقط قصر اليشم على هذه الحال

181
00:13:24,190 --> 00:13:26,030
.أعلم

182
00:13:26,700 --> 00:13:28,660
.تحلّوا بالصّبر في الوقت الحاليّ

183
00:13:32,200 --> 00:13:34,540
.سيأتي الأمر قطعًا

184
00:13:44,010 --> 00:13:46,260
.هناك ستّمائةٍ منهم فقط

185
00:13:46,260 --> 00:13:49,680
.وجميعهم فتيات ورجالٌ كبار في السّنّ

186
00:13:50,010 --> 00:13:54,970
،كم يومًا ستستغرقون لتدميرهم
يا نائب البريتور لوفلوس؟

187
00:13:55,850 --> 00:13:57,310
.أنا آسف

188
00:13:57,690 --> 00:14:01,820
ولكن معنويّات الجنود الّذين
...جنّدناهم منخفضةٌ بشكلٍ كبير

189
00:14:01,820 --> 00:14:05,280
.لست هنا لسماع الأعذار

190
00:14:05,570 --> 00:14:08,700
.الأمير زولزال ينتظر تقريرًا عن الانتصار

191
00:14:08,950 --> 00:14:09,610
.نعم

192
00:14:10,200 --> 00:14:12,870
.أحضر المزيد من القوّات إن احتجت

193
00:14:13,240 --> 00:14:16,960
،إن تركت أعداء الإمبراطوريّة يتصرّفون على هواهم أكثر

194
00:14:16,960 --> 00:14:20,080
.فسيتمّ اعتبارك غير كفء

195
00:14:21,210 --> 00:14:22,130
مفهوم؟

196
00:14:29,550 --> 00:14:32,390
.لقد بدأ التّعب يتسلّل إلينا

197
00:14:32,970 --> 00:14:34,640
كيف هي مؤونتنا؟

198
00:14:35,100 --> 00:14:37,980
،لم نتوقّع أن نكون تحت الحصار هنا

199
00:14:37,980 --> 00:14:39,850
.لذا ربّما لم نحضر الكثير

200
00:14:40,230 --> 00:14:41,400
.صحيح

201
00:14:41,900 --> 00:14:45,070
.هنالك البئر في قصر اليشم، لذا لدينا ماء

202
00:14:45,070 --> 00:14:46,860
.ولكن الطّعام على وشك النّفاذ

203
00:14:47,570 --> 00:14:49,610
ما الّذي علينا فعله الآن يا بوزيس؟

204
00:14:51,030 --> 00:14:53,320
،إن استطعنا الحصول على الموافقة من الجانب اليابانيّ

205
00:14:53,320 --> 00:14:56,830
.فإنّني أخطّط لأخذ الجميع واختراق الحصار

206
00:14:57,410 --> 00:14:59,330
إلى أين سنذهب إن اخترقنا الحصار؟

207
00:15:00,420 --> 00:15:01,330
.إيتاليكا

208
00:15:02,420 --> 00:15:03,500
!فهمت

209
00:15:03,880 --> 00:15:06,920
.نصف فارسات الورود الصّفر وجنودنا المشاة هناك

210
00:15:07,380 --> 00:15:10,340
.يمكننا استعادة الفارسات إن اجتمعنا معهم

211
00:15:10,340 --> 00:15:10,970
.نعم

212
00:15:11,430 --> 00:15:14,850
،ولكنّي قلقة على الأميرة بينيا
.لا زالت في القصر الإمبراطوريّ

213
00:15:15,810 --> 00:15:19,310
.مهما كانوا، فلن يؤذوا أحد أعضاء العائلة الملكيّة

214
00:15:19,600 --> 00:15:21,940
.لا، لا نستطيع الجزم بذلك

215
00:15:21,940 --> 00:15:25,940
.نحتاجها معنا عندما نغادر العاصمة

216
00:15:26,820 --> 00:15:29,820
.ولكن لن يكون التسلّل إلى القصر سهلاً

217
00:15:30,450 --> 00:15:33,200
وهل تعرفين أين تكون أصلاً؟

218
00:15:34,030 --> 00:15:34,820
.لا

219
00:15:35,700 --> 00:15:37,950
.علينا انتظار رسالة هاميلتون

220
00:15:39,870 --> 00:15:41,710
!هجوم من العدوّ! هجوم من العدوّ

221
00:15:41,710 --> 00:15:42,960
!إلى أماكنكم

222
00:15:44,000 --> 00:15:46,500
لن يتركونا نرتاح إذًا، صحيح؟

223
00:15:46,500 --> 00:15:48,500
.ذلك صعبٌ عليهم أيضًا

224
00:15:48,840 --> 00:15:52,510
،علينا حماية هذا المكان مهما يكن
.إلى أن نسمع خبرًا من بينيا-ساما

225
00:15:53,130 --> 00:15:55,300
.نعم، أنتِ محقّة

226
00:16:00,600 --> 00:16:01,980
!توقّف

227
00:16:01,980 --> 00:16:03,230
!توقّف، أرجوك

228
00:16:03,650 --> 00:16:06,150
أنت، هل تسمع؟

229
00:16:07,520 --> 00:16:08,820
!انتظر

230
00:16:14,740 --> 00:16:15,910
!انتظر

231
00:16:31,770 --> 00:16:36,180
لقد تجاهلتِ عدّة
،تحذيرات من زولزال-ساما

232
00:16:36,180 --> 00:16:39,010
.وتدخّلتِ بأعمالنا

233
00:16:39,600 --> 00:16:44,600
لهذا، سيتمّ الحكم عليكِ
.طبقًا لقانون الأوبريتشنينا الخاصّ

234
00:16:44,940 --> 00:16:46,900
!إنّك محض أرنبةٌ مقاتلة

235
00:16:47,190 --> 00:16:49,900
.قولي ما شئتِ

236
00:16:50,440 --> 00:16:54,400
.تلك الغرفة هي الّتي كنت محبوسةً فيها لمدّة طويلةٍ جدًّا

237
00:16:54,990 --> 00:16:57,410
.إنّها غرفةٌ رائعة

238
00:16:58,030 --> 00:16:59,990
!مثاليّة لكِ

239
00:17:00,330 --> 00:17:02,200
.صحيح

240
00:17:02,200 --> 00:17:07,670
هنالك رسالةٌ من زولزال-ساما
.أراد منّي إعطاءك إيّاها

241
00:17:14,670 --> 00:17:17,140
.خسرتِ يا بينيا

242
00:17:21,220 --> 00:17:22,850
هل أنتِ بخير يا ليلي؟

243
00:17:32,610 --> 00:17:33,740
كيف؟

244
00:17:36,950 --> 00:17:39,450
لماذا ترتدين درعًا؟

245
00:17:46,960 --> 00:17:48,210
كيف سارت الأمور؟

246
00:17:48,830 --> 00:17:51,630
،لقد أعجبوا برسالتها

247
00:17:51,630 --> 00:17:56,220
ولكن لا يمكنها أن تصبح معلّمة
.إلى أن تُحلّ هذه المشكلة

248
00:17:56,630 --> 00:17:58,590
.هذا مؤسف

249
00:17:59,510 --> 00:18:02,390
هل كان هناك أيّ أثرٍ لعازف المزمار المرقّط في المكان؟

250
00:18:02,390 --> 00:18:03,930
.لا

251
00:18:04,350 --> 00:18:08,600
بالطّبع، لا يوجد ضمانٌ أنّ الرّجل
.الّذي قابلته شاندي يكون هو حقًّا

252
00:18:09,060 --> 00:18:11,900
.ربّما كان موجودًا هناك ولم نعلم

253
00:18:13,070 --> 00:18:14,610
!هذا ليس عادلاً

254
00:18:14,610 --> 00:18:18,450
كان يجب عليكِ إخباري إن كنت سترتدين
!درعًا تحت ملابسك

255
00:18:18,910 --> 00:18:21,410
لا، لقد كنتِ أنتِ أوّل من سمع

256
00:18:21,410 --> 00:18:23,950
.أنّه من الأفضل لها أن ترتدي درعًا

257
00:18:25,160 --> 00:18:27,620
،أنتم حذّروا ليلي بشأن هذا

258
00:18:27,620 --> 00:18:29,960
.واجعلوها ترتدي درعًا تحت ملابسها

259
00:18:32,380 --> 00:18:34,420
!صحيح

260
00:18:34,670 --> 00:18:38,550
.أنا مسرورةٌ لأنّ من خُدع كان غبيًّا

261
00:18:38,550 --> 00:18:42,550
.بالتّأكيد سنأخذ احتياطاتنا إن كانت حياتها معرّضةً للخطر

262
00:18:42,550 --> 00:18:45,310
يُقال الحذر أفضل من النّدم، أليس كذلك؟

263
00:18:45,310 --> 00:18:47,890
.لقد تصرّفتِ بشكل أخرق بتصويبك لرقبتها

264
00:18:48,770 --> 00:18:50,850
...لا

265
00:18:51,150 --> 00:18:53,730
إذًا؟ لماذا فعلتِ شيئًا كهذا؟

266
00:18:54,150 --> 00:18:57,150
!لإنقاذ الأميرة بينيا كما هو واضح

267
00:18:57,490 --> 00:18:58,530
بينيا؟

268
00:18:59,200 --> 00:19:02,740
لماذا مهاجمة ليلي ستنقذها؟

269
00:19:05,160 --> 00:19:09,000
.من يسعى خلف حياة ليلي-سان هو الأمير زولزال

270
00:19:11,960 --> 00:19:15,290
لذا حاولت أن أُظهر ولاء الأميرة بينيا له

271
00:19:15,290 --> 00:19:17,920
.من خلال إحضار رأس ليلي إليه

272
00:19:18,840 --> 00:19:20,470
.فهمت

273
00:19:20,800 --> 00:19:24,010
!استغلّ ولاءك لبينيا إذًا

274
00:19:24,010 --> 00:19:26,850
!لا! لم أُخدع

275
00:19:26,850 --> 00:19:30,690
!الأميرة في مصيبةٍ كبيرةٍ الآن

276
00:19:31,270 --> 00:19:34,360
...دكتاتوريّة وليّ العهد زولزال

277
00:19:38,730 --> 00:19:40,780
.عرّضت حتّى حياتها للخطر

278
00:19:45,120 --> 00:19:48,330
لا أستطيع تصديق أنّ هناك معركةً
.بدأت في قصر اليشم

279
00:19:48,950 --> 00:19:53,620
على هذه الحال، الأميرة بنفسها
!سيُحكم عليها بقانون الأوبريتشنينا

280
00:19:53,620 --> 00:19:54,750
،يا حامل الدّروع غري

281
00:19:54,750 --> 00:19:57,500
،إن كان لديك أيّ ولاء للأميرة

282
00:19:57,500 --> 00:19:59,130
!فاقتل ليلي-سان

283
00:20:00,300 --> 00:20:02,380
...حتّى وإن قلتِ ذلك

284
00:20:04,340 --> 00:20:06,890
.تلك المهمّة كبيرةٌ عليّ

285
00:20:07,350 --> 00:20:10,270
على أيّ حال، ألن يكون واقعيًّا أكثر

286
00:20:10,270 --> 00:20:14,150
أن تذهبي إلى القصر إن أردتِ إنقاذ الأميرة؟

287
00:20:14,150 --> 00:20:15,690
ما الّذي تقوله؟

288
00:20:15,690 --> 00:20:19,110
!هناك عشرات الآلاف من الجنود الملكيّين يحمونه

289
00:20:19,110 --> 00:20:21,900
،ولكن، لإيقاف عازف المزمار المرقّط والقتلة الآخرين

290
00:20:21,900 --> 00:20:25,740
.علينا أن نوقف المشكلة من المصدر

291
00:20:25,740 --> 00:20:28,330
هل تنوي قتل وليّ العهد؟

292
00:20:28,330 --> 00:20:33,080
هذه هي الطّريقة الأكثر فعاليّة
.لإنقاذ الأميرة بينيا، على ما أعتقد

293
00:20:36,460 --> 00:20:38,000
.بالمناسبة يا إيتامي-دونو

294
00:20:38,000 --> 00:20:40,760
هل اتّصلت بقوّات الدّفاع الذّاتيّ؟

295
00:20:41,090 --> 00:20:44,590
ستكون هناك أماكن أستطيع الاتّصال منها
،إن خرجت من رونديل

296
00:20:44,590 --> 00:20:46,890
.ولكن بصراحة، إنّها لا تعمل جيّدًا

297
00:20:46,890 --> 00:20:48,970
،توقّعت أنّ هذا سيحدث

298
00:20:48,970 --> 00:20:52,980
لذا استغللت الجسر الّذي تمّ إصلاحه
.للتّوّ لاستدعاء مبعوث

299
00:20:53,430 --> 00:20:54,640
!المعذرة

300
00:20:54,980 --> 00:20:56,900
!لقد كنت بالانتظار

301
00:20:57,190 --> 00:20:57,810
!مصيبة

302
00:20:58,440 --> 00:20:59,690
—الأميرة بينيا

303
00:21:07,370 --> 00:21:08,910
.مفهوم

304
00:21:15,120 --> 00:21:16,370
!لدينا الإذن

305
00:21:20,130 --> 00:21:21,630
!دُر

306
00:21:22,090 --> 00:21:24,920
.تمّ التّحقّق من المظلّة الثّانويّة
.تمّ التّحقّق من المظلّة الرّئيسيّة

307
00:21:24,920 --> 00:21:26,050
.تمّ التّحقّق من صمّامان الأمان

308
00:21:26,430 --> 00:21:27,590
.تمّ التّحقّق من قيود الأربطة

309
00:21:27,590 --> 00:21:28,760
.تمّ التّحقّق من الخطاطيف

310
00:21:28,760 --> 00:21:29,800
!الحلقات التّلقائيّة

311
00:21:29,800 --> 00:21:31,220
!تمّ التّحقّق من الحلقات التّلقائيّة

312
00:21:31,220 --> 00:21:32,560
!كلّ شيء جاهز! مستعدّون للذّهاب

313
00:21:32,810 --> 00:21:34,520
.سننطلق الآن

314
00:21:40,150 --> 00:21:42,860
.إلى كلّ القوّات في المنطقة الخاصّة، هذا طاقم المقرّ الرّئيسيّ

315
00:21:43,150 --> 00:21:45,190
عند السّاعة 06:30 غدًا، ستنفّذ قوّات المنطقة الخاصّة

316
00:21:45,190 --> 00:21:48,860
،هبوطًا بالمظلاّت جنوب غرب عاصمة الإمبراطوريّة

317
00:21:48,860 --> 00:21:50,700
.بالإضافة إلى عملية هليكوبتر

318
00:21:51,030 --> 00:21:53,740
المهمّة هي إنقاذ السّفراء وطالبي اللّجوء السّيّاسيّ

319
00:21:53,740 --> 00:21:57,670
.في قصر اليشم لحماية إمكانيّة عقد السّلام مع الإمبراطوريّة

320
00:21:57,670 --> 00:21:58,670
...أكرّر

321
00:22:01,000 --> 00:22:01,790
...أسرعوا

322
00:22:03,130 --> 00:22:04,130
!إلى العاصمة

323
00:23:36,310 --> 00:23:39,810
".الحلقة القادمة من بوّابة: "هبوط بالمظلاّت