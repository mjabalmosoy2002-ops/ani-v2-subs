1
00:00:01,600 --> 00:00:02,400
.تفضّل

2
00:00:04,690 --> 00:00:07,060
ما الّذي أردت التّحدث عنه إذًا؟

3
00:00:07,060 --> 00:00:10,730
.كان لدينا زائرٌ مثيرٌ للاهتمام بينما كنت غائبًا

4
00:00:10,730 --> 00:00:13,150
.أراد منّا قتل تنّين

5
00:00:13,150 --> 00:00:15,110
—ماذا؟ هذا مستحـ

6
00:00:15,110 --> 00:00:16,120
.اسمعني وحسب

7
00:00:17,620 --> 00:00:20,370
فهمت. قلتَ قريتها؟

8
00:00:20,360 --> 00:00:22,220
.هذا مُحزن

9
00:00:22,540 --> 00:00:24,960
ولكن الفريق رفض، أليس كذلك؟

10
00:00:25,330 --> 00:00:26,960
.لذا هذه هي نهاية الحديث

11
00:00:26,980 --> 00:00:30,550
.ظهر التّنّين في جنوب دولة إيروبي الأميريّة

12
00:00:31,090 --> 00:00:33,790
.يوجد نفطٌ هناك على ما يبدو

13
00:00:33,790 --> 00:00:36,030
.وألماس خام ضخم أيضًا

14
00:00:37,510 --> 00:00:38,890
.لست مُهتمًّا

15
00:00:39,180 --> 00:00:41,350
هل تريد الذّهاب في مهمّة استطلاع موارد؟

16
00:00:42,180 --> 00:00:45,890
قلت لك ذلك من قبل، ولكن إن ذهبت
،إلى هناك للبحث عن الموارد

17
00:00:45,890 --> 00:00:48,480
.فإنّك ستحظى ببعض الحرّيّة

18
00:00:49,820 --> 00:00:51,320
ما الّذي تريد الوصول إليه؟

19
00:00:51,320 --> 00:00:53,490
،أعني إن ذهبت إلى هناك

20
00:00:53,490 --> 00:00:56,740
،"!صادف أنّي عبرت الحدود"
،"!صادف أنّي رأيت تنّينًا"

21
00:00:56,740 --> 00:00:59,490
..."!ومن ثم، "صادف أنّي قتلته وأتيت بهذه الموارد

22
00:00:59,780 --> 00:01:02,830
.لا أعتقد أنّ هنالك من سيمانع

23
00:01:02,830 --> 00:01:03,500
!أنا سأمانع

24
00:01:04,080 --> 00:01:07,250
!أنت تجعل الأمر يبدو سهلاً لأنّك لم تقابل واحدًا من قبل

25
00:01:07,250 --> 00:01:08,830
!إنّه مخيفٌ حقًّا

26
00:01:09,170 --> 00:01:12,050
.سأطيع الأوامر، ولكن إن كان لي حق الرّفض فسأرفض

27
00:01:12,340 --> 00:01:15,010
.لا أريد الموت ولا أريد موت رجالي

28
00:01:18,760 --> 00:01:21,930
.اذهب للتّحدث مع الجنّيّة الشّقراء

29
00:01:26,060 --> 00:01:27,090
توكا؟

30
00:03:03,950 --> 00:03:04,780
توكا؟

31
00:03:18,410 --> 00:03:19,340
...والدي

32
00:03:21,590 --> 00:03:22,930
!والدي

33
00:03:23,720 --> 00:03:24,620
توكا؟

34
00:03:25,100 --> 00:03:26,930
!رأيتم؟ لقد عاد بالفعل

35
00:03:26,930 --> 00:03:28,890
!كانت تلك مزحة ثقيلة منكما

36
00:03:30,180 --> 00:03:31,190
!توكا

37
00:03:31,520 --> 00:03:32,770
.اسمع لهذا يا أبي

38
00:03:33,900 --> 00:03:35,060
...قالَت

39
00:03:35,940 --> 00:03:39,070
!قالت أنّك متّ

40
00:03:39,400 --> 00:03:41,820
!قالت أنّ تنّينَ نارٍ قضى عليك

41
00:03:48,370 --> 00:03:50,580
.لن تستيقظ لفترة من الزّمن الآن

42
00:03:51,080 --> 00:03:52,410
ماذا حصل؟

43
00:03:52,710 --> 00:03:54,000
.إنّها ياو

44
00:03:56,250 --> 00:03:57,630
ماذا قلتِ؟

45
00:03:58,050 --> 00:04:00,920
.والدك لم يعد موجودًا في هذا العالم

46
00:04:01,380 --> 00:04:03,840
.لن تجديه مهما بحثتِ

47
00:04:04,890 --> 00:04:06,090
تذكّري ماذا حدث

48
00:04:06,510 --> 00:04:09,060
.عندما هاجَم التّنّين قريتكِ

49
00:04:10,020 --> 00:04:12,100
.كنتِ أنتِ النّاجية الوحيدة

50
00:04:13,480 --> 00:04:15,690
.وقُتِل كلّ من بقي

51
00:04:17,610 --> 00:04:18,270
!أنتِ تكذبين

52
00:04:18,270 --> 00:04:21,690
!استيقظي! والدكِ ميِّت

53
00:04:22,070 --> 00:04:24,320
!أكَله تنّين النّار

54
00:04:33,000 --> 00:04:36,960
!لا

55
00:04:40,170 --> 00:04:43,510
...أرغمتها ياو على مواجهة الحقيقة

56
00:04:43,840 --> 00:04:46,930
.الحقيقة الّتي كنّا نتفاداها

57
00:04:47,390 --> 00:04:50,930
.كانت توكا تبحث عن والدها منذ ذلك الحين

58
00:04:51,270 --> 00:04:53,930
،كان تتجوّل عبر القرية

59
00:04:53,930 --> 00:04:55,940
.ناسيةً حتّى الأكل أو النّوم

60
00:04:56,440 --> 00:05:00,270
.لذا ننوّمها بهذه الطّريقة في أحيانٍ كثيرة

61
00:05:00,570 --> 00:05:01,900
.فهمت

62
00:05:04,530 --> 00:05:06,410
لماذا فعلتِ شيئًا لا يعنيكِ؟

63
00:05:07,030 --> 00:05:10,160
.لقد كنّا حذرين أشدّ الحذر بموضوع والد توكا

64
00:05:10,530 --> 00:05:12,160
!إنّكِ تسبّبين لنا المشاكل بفعلكِ هذا

65
00:05:12,410 --> 00:05:15,660
فعلت شيئًا لا يعنيني؟
.كلّ ما فعلته هو إخبارها بالحقيقة

66
00:05:16,540 --> 00:05:20,460
سمعت أنّ هؤلاء الثّلاثة بالذّات
.يعنين الكثير بالنّسبة لك

67
00:05:20,750 --> 00:05:26,130
.وأنّك عازم على مخالفة بعض القوانين لمساعدتهنّ

68
00:05:26,510 --> 00:05:29,090
كيف لي ألاّ أستغلّ ذلك لمصلحتي
وأنا أعرف هذه الحقيقة؟

69
00:05:29,680 --> 00:05:31,850
—بعض الأشياء تُعتبر تخطّيًا للحدود

70
00:05:31,850 --> 00:05:33,470
!أنا لست طفلة

71
00:05:33,810 --> 00:05:36,560
توسّلت المساعدة من رفاقك

72
00:05:36,560 --> 00:05:38,850
!لهزيمة تنّين النّار

73
00:05:39,310 --> 00:05:41,900
!قلت لهم بأنّي سأفعل أي شيء بإمكاني

74
00:05:42,570 --> 00:05:46,280
!ولكنّ الجميع يرفضني

75
00:05:46,610 --> 00:05:48,200
!يقولون بأنّهم لا يستطيعون المساعدة

76
00:05:49,200 --> 00:05:52,990
ولكنّهم جميعًا يقولون

77
00:05:53,620 --> 00:05:55,160
!أنّك أنت تستطيع ذلك يا إيتامي

78
00:05:57,960 --> 00:05:59,580
!لهذا حطّمتهُا

79
00:06:00,000 --> 00:06:02,000
الطريقة الوحيدة لإنقاذ سلامة عقل تلك الجنّيّة

80
00:06:02,000 --> 00:06:07,470
هو جعلها تستوعب أنّ تنّين النّار قتل
!والدها قبل قتلك إيّاه

81
00:06:07,470 --> 00:06:09,470
ماذا ستفعل إذًا أيّها الرّجل الأخضر؟

82
00:06:09,930 --> 00:06:11,760
هل ستتخلّى عن الجنّيّة؟

83
00:06:11,760 --> 00:06:13,970
أم هل ستحمل سلاحك وتقف؟

84
00:06:14,810 --> 00:06:17,310
،إن كان شخصٌ ما من قتل من تحبّ

85
00:06:17,310 --> 00:06:20,850
.فإنك تستطيع ملاحقته وأخذ ثأرك

86
00:06:21,150 --> 00:06:22,770
ولكن ماذا إن كان تنّين نار؟

87
00:06:23,320 --> 00:06:24,820
.لا يوجد ما تستطيع فعله

88
00:06:24,820 --> 00:06:27,940
.لا أحد يستطيع إمساكه، لا أحد يستطيع معاقبته

89
00:06:27,940 --> 00:06:30,530
أين توجّه غضبك إذًا؟

90
00:06:31,030 --> 00:06:33,370
من يجب عليّ أن أكره

91
00:06:33,370 --> 00:06:35,330
لسلبه منّي الأشخاص الّذين أحبّهم؟

92
00:06:37,410 --> 00:06:39,710
.أعلم أنّ هذه أنانيّة

93
00:06:40,330 --> 00:06:44,840
.بالمقابل، سأعطيك قلبي وجسدي وكلّ شيء

94
00:06:45,660 --> 00:06:47,600
...أنقذها

95
00:06:48,590 --> 00:06:51,260
.ولكن أنقذ رفقائي أيضًا

96
00:06:54,980 --> 00:06:55,600
ماذا؟

97
00:06:55,930 --> 00:06:58,020
تم تعيين زولزال الوريث؟

98
00:06:58,230 --> 00:07:01,730
.نعم، ترتيب الخلافة تم إقراره

99
00:07:01,730 --> 00:07:03,940
!سحقًا! هذا مبكّرٌ جدًّا

100
00:07:03,940 --> 00:07:04,860
ديابو ني-ساما؟

101
00:07:05,360 --> 00:07:07,610
!إنّه يفقد عقله

102
00:07:07,610 --> 00:07:09,320
!إنّه ينوي الانقلاب على أبي

103
00:07:09,650 --> 00:07:13,030
.أخبرني أن أختار الجانب الّذي سأكون معه

104
00:07:13,030 --> 00:07:14,530
زولزال ني-ساما قال ذلك؟

105
00:07:14,950 --> 00:07:18,950
ولكن من أعطاه هذه الفكرة؟

106
00:07:19,580 --> 00:07:21,420
.تذكّري ذلك جيّدًا يا بينيا

107
00:07:22,080 --> 00:07:25,040
.أحمقٌ يعرف القليل من الحيل مخيفٌ للغاية

108
00:07:25,040 --> 00:07:28,460
.سيطيح بجميع من حوله أيضًا

109
00:07:29,050 --> 00:07:32,680
.عليكِ التّفكير جيِّدًا بمَ ستفعلين أيضًا

110
00:07:35,390 --> 00:07:37,060
الشّيء الوحيد الّذي أريده

111
00:07:37,060 --> 00:07:39,720
.هو السّلام بين اليابان والإمبراطوريّة

112
00:07:39,720 --> 00:07:40,680
...ني-ساما

113
00:07:52,780 --> 00:07:53,740
ماذا تريد؟

114
00:07:56,660 --> 00:08:01,410
.أخبار من جاسوسنا في آلنوس

115
00:07:56,990 --> 00:08:00,910
بورو

116
00:08:01,790 --> 00:08:02,960
.سأقرأه لاحقًا

117
00:08:02,960 --> 00:08:04,710
.اتركه هناك

118
00:08:05,710 --> 00:08:06,670
.مكافأتك

119
00:08:09,840 --> 00:08:11,840
،إن كان زولزال هو وليّ العهد

120
00:08:11,840 --> 00:08:15,180
.فقد تكون نهاية الإمبراطوريّة وشيكة

121
00:08:15,180 --> 00:08:19,180
.كان من الصّعب إطراؤه حتّى أصبح بهذا التّغطرس

122
00:08:20,020 --> 00:08:26,100
ولكنّه الآن مجرّد أحمق يعتقد
.أنّ العالم يتمحّور حوله

123
00:08:27,810 --> 00:08:29,900
.سيفعل ما أريد

124
00:08:30,940 --> 00:08:32,860
.لن أسمح بالسّلام

125
00:08:33,860 --> 00:08:35,360
انتقامي

126
00:08:35,780 --> 00:08:38,120
.بدأ للتّوّ

127
00:08:38,410 --> 00:08:40,240
،إذًا يا تيولي-ساما

128
00:08:40,620 --> 00:08:45,440
لِم لا نتخلص من العبد اليابانيّ
الباقي في الإمبراطوريّة؟

129
00:08:45,830 --> 00:08:49,090
.إنّهم يهتمّون لرفقائهم أكثر من أيّ شيء

130
00:08:49,420 --> 00:08:53,050
.سيستشيطون غضبًا وسيهاجمون الإمبراطوريّة

131
00:08:53,050 --> 00:08:54,880
لأجل صديقهم؟

132
00:08:56,260 --> 00:08:57,840
.إنّك ساذج يا بورو

133
00:08:57,840 --> 00:09:00,220
ما الّذي علينا فعله إذًا؟

134
00:09:00,220 --> 00:09:01,390
...نوريكو

135
00:09:01,770 --> 00:09:04,140
،كانت في نفس حالتي

136
00:09:04,140 --> 00:09:06,390
.ولكن عُرض عليها الخلاص

137
00:09:06,900 --> 00:09:09,770
من سيتعيّن لقتلها؟

138
00:09:12,030 --> 00:09:13,530
.بينا ستفعل ذلك

139
00:09:25,040 --> 00:09:27,370
قبل 20 سنة

140
00:09:25,040 --> 00:09:27,420
أنت من قتل والدي، أليس كذلك؟

141
00:09:36,260 --> 00:09:40,220
.أمّي مختلّة عقليًّا، لذا عليها الذّهاب إلى المستشفى

142
00:09:40,680 --> 00:09:42,720
.هذا هو القانون

143
00:09:43,810 --> 00:09:45,600
.ما بيدي حيلة

144
00:09:46,690 --> 00:09:48,560
...لا يمكنني فعل شيءٍ

145
00:09:59,160 --> 00:10:00,570
استيقظتِ؟

146
00:10:01,290 --> 00:10:02,070
.نعم

147
00:10:08,110 --> 00:10:09,980
ما الخطب يا أبي؟

148
00:10:10,340 --> 00:10:11,870
...لا شيء

149
00:10:11,870 --> 00:10:14,260
.لا بأس، لا تقل شيئًا

150
00:10:17,470 --> 00:10:18,800
.مرحبًا بعودتك

151
00:10:24,540 --> 00:10:26,480
.لقد عدت يا توكا

152
00:10:31,980 --> 00:10:34,730
!من هنا يا أبي

153
00:10:34,730 --> 00:10:35,720
أبي؟

154
00:10:35,720 --> 00:10:36,600
ما الّذي يجري؟

155
00:10:36,600 --> 00:10:37,570
إيتامي؟

156
00:10:38,860 --> 00:10:40,820
إلى أين نذهب الآن يا أبي؟

157
00:10:41,530 --> 00:10:42,740
...لنرَ

158
00:11:11,480 --> 00:11:15,150
سمعت أنّ القائد إيتامي بدأ
.يتصرّف وكأنّه والد توكا

159
00:11:15,150 --> 00:11:16,070
.نعم

160
00:11:16,440 --> 00:11:18,610
.إنّه يأتي للعمل من منزلها كل يوم

161
00:11:18,610 --> 00:11:20,490
هل حالة توكا بهذا السّوء؟

162
00:11:20,490 --> 00:11:23,530
!إنّها سيّئة لدرجة أنّها تظنّ أنّ القائد هو والدها

163
00:11:23,530 --> 00:11:25,580
!لنذهب إلى هناك الآن يا أبي

164
00:11:27,370 --> 00:11:28,500
!بالفعل

165
00:11:29,160 --> 00:11:32,080
أين تريدين الذّهاب اليوم يا توكا؟

166
00:11:32,750 --> 00:11:33,830
...لنرَ

167
00:11:35,500 --> 00:11:37,500
.سأذهب إلى أيّ مكان معك

168
00:11:37,790 --> 00:11:39,170
.هذا يُحيّرني

169
00:11:41,140 --> 00:11:42,190
...أبي

170
00:11:45,010 --> 00:11:47,010
بعد عدّة أيّام

171
00:11:47,010 --> 00:11:49,270
.اذهب إلى العاصمة مرّة أخرى غدًا

172
00:11:49,520 --> 00:11:50,520
هل سأنتقل إلى هناك؟

173
00:11:50,520 --> 00:11:52,690
.نعم، نريد منك أن تترجم مرةً أخرى

174
00:11:52,680 --> 00:11:54,950
.ستأخذ وقتًا في هذه المرّة

175
00:11:55,850 --> 00:11:56,960
ما الخطب؟

176
00:11:56,960 --> 00:11:59,270
ذهبت إلى هناك مراتٍ عديدةً مسبقًا، أليس كذلك؟

177
00:12:01,820 --> 00:12:06,660
جميع الأطفال متحمّسون لأنّهم
.سيخرجون من القرية اليوم

178
00:12:07,120 --> 00:12:07,780
حقًّا؟

179
00:12:07,780 --> 00:12:10,540
.أخبرتهم أنّ ذلك خطير ولكنّهم يأبوْن الاستماع

180
00:12:10,540 --> 00:12:13,670
.ولكن أعتقد أنّه تغييرٌ جيّدٌ للجميع

181
00:12:14,040 --> 00:12:15,330
.هذا جيّد

182
00:12:17,670 --> 00:12:20,000
هل حصل شيءٌ ما يا أبي؟

183
00:12:20,710 --> 00:12:22,260
.لا شيء

184
00:12:24,840 --> 00:12:26,720
متى يوم إجازتك المقبل إذًا؟

185
00:12:27,350 --> 00:12:29,810
!أريد الذّهاب إلى مكانٍ ما ثانيةً، نحن فقط

186
00:12:30,430 --> 00:12:31,730
...بشأن ذلك

187
00:12:36,860 --> 00:12:39,610
.آسف، لن أحظى بأيّ يوم إجازة لفترة

188
00:12:39,610 --> 00:12:40,650
ماذا؟

189
00:12:40,650 --> 00:12:42,900
.ما بيدي حيلة، إنّه العمل

190
00:12:43,740 --> 00:12:46,360
.أنت تعمل بجهدٍ كبيرٍ مؤخرًّا

191
00:12:46,360 --> 00:12:47,910
.لا تقولي ذلك

192
00:12:47,910 --> 00:12:48,950
.سأشعر بالسّوء

193
00:12:48,950 --> 00:12:50,290
هل تشعر بذلك حقًّا؟

194
00:12:51,080 --> 00:12:52,200
،توكا

195
00:12:52,500 --> 00:12:54,370
.استمعي لي بهدوء

196
00:12:55,250 --> 00:12:58,670
.سأغادر لفترة مرّة أخرى

197
00:12:59,630 --> 00:13:01,190
.لا تقلقي

198
00:13:01,190 --> 00:13:02,510
.سأعود

199
00:13:02,840 --> 00:13:07,010
.ولكنّي سأترككِ وحيدةً لفترة

200
00:13:09,220 --> 00:13:10,050
توكا؟

201
00:13:11,430 --> 00:13:14,350
.أنا بخير، لا شيء

202
00:13:14,350 --> 00:13:15,730
اعمل بجدّ، حسنًا؟

203
00:13:21,360 --> 00:13:22,780
ما زلتِ هنا؟

204
00:13:23,070 --> 00:13:24,940
لم تحظَ بصباح جيّد، صحيح؟

205
00:13:27,200 --> 00:13:29,060
أصابها صداع، أليس كذلك؟

206
00:13:29,740 --> 00:13:32,260
.ابنتك تقف على حافة المنحدر الآن

207
00:13:32,700 --> 00:13:37,870
خطوةٌ واحدة... لا، حتى نصف خطوة
.وستسقط في وادي الجنون

208
00:13:38,290 --> 00:13:39,420
—لهذا أنا

209
00:13:39,420 --> 00:13:41,290
.تُمثّل أنّك والدها

210
00:13:42,050 --> 00:13:44,920
.لكي لا تضطّر لمواجهة حقيقة موت والدها

211
00:13:45,300 --> 00:13:47,300
.ولكنّك لا تعرف رودرو

212
00:13:47,630 --> 00:13:49,680
،يمكنك التّمثيل بأنّك والدها

213
00:13:49,680 --> 00:13:52,810
.ولكنّ كلّ غلطة تقترفها تزيد من توتّر عقلها

214
00:13:52,810 --> 00:13:54,640
.هذا هو سبب صداعها

215
00:13:54,640 --> 00:13:56,310
.أعلم ذلك

216
00:13:58,100 --> 00:13:59,850
!لن يبقى ذلك إلى الأبد

217
00:13:59,850 --> 00:14:01,980
!النّهاية باتت وشيكة

218
00:14:03,270 --> 00:14:06,900
إلى متى ستظلّ تلعب لعبة العائلة يا إيتامي؟

219
00:14:06,900 --> 00:14:07,900
.اتركني

220
00:14:08,150 --> 00:14:10,070
.إن كان الأمر لا يزعجك فلا بأس

221
00:14:10,370 --> 00:14:12,990
.لكنّ الدّفعة الأولى من السّجناء ستُردّ قريبًا

222
00:14:12,990 --> 00:14:14,540
ماذا عن الضّحايا المختطفين؟

223
00:14:14,540 --> 00:14:16,790
.سيكونون بعد الدّفعة التّالية

224
00:14:17,160 --> 00:14:20,380
.هذه المرّة هي لإيفاء واجبنا للأميرة بينا

225
00:14:20,380 --> 00:14:22,750
.لن نعلم شيئًا أكثر إلى حين بدء المفاوضات

226
00:14:22,750 --> 00:14:25,260
.فهمت، أرجو أن تجري جيّدًا

227
00:14:26,300 --> 00:14:28,170
هل أنت بخير حقًّا؟

228
00:14:28,170 --> 00:14:29,630
.أنا بخير

229
00:14:29,630 --> 00:14:31,050
.لا تبدو كذلك

230
00:14:33,350 --> 00:14:36,100
.آسف، بصراحة أنا لست بخير

231
00:14:36,100 --> 00:14:38,020
.أفكاري مبعثرة

232
00:14:38,020 --> 00:14:40,100
.الأمر بسيط

233
00:14:40,100 --> 00:14:41,860
.اذهب لقتل التّنّين

234
00:14:41,860 --> 00:14:44,610
وأدع معظم رجالي يموتون؟

235
00:14:44,610 --> 00:14:45,480
.مستحيل

236
00:14:46,030 --> 00:14:47,570
،بترك المهمّة على جنب

237
00:14:47,570 --> 00:14:51,570
.لا أستطيع تعريضهم للخطر لأسبابٍ خاصّة

238
00:14:51,570 --> 00:14:55,120
.الحياة الّتي أستطيع تعريضها لذلك هي حياتي فقط

239
00:14:55,120 --> 00:14:56,490
.لا بأس

240
00:14:56,830 --> 00:14:59,120
.أخبرني عندما ستذهب يا إيتامي

241
00:14:59,960 --> 00:15:02,080
.سأحرص على تجهيز المعاملات الورقيّة

242
00:15:04,710 --> 00:15:06,250
!ها هو

243
00:15:06,250 --> 00:15:07,380
!أيها القائد

244
00:15:12,550 --> 00:15:14,100
!في صحّتكم

245
00:15:18,600 --> 00:15:22,600
كيف هو شعور امتلاك ابنةٍ تكبرك عمرًا؟

246
00:15:22,940 --> 00:15:24,730
.معقّدٌ حقًّا

247
00:15:24,730 --> 00:15:26,020
.لا بدّ أنّه كذلك

248
00:15:26,020 --> 00:15:27,860
.أستطيع تصوّر شعورك

249
00:15:27,860 --> 00:15:30,900
.أنا سعيد أنّها أحبّت كوروكاوا على أيِّ حال

250
00:15:31,780 --> 00:15:34,700
.يمكنني ترك توكا معها وأنا مطمئن

251
00:15:34,700 --> 00:15:36,410
!أبي

252
00:15:40,710 --> 00:15:43,880
سؤالك هو ما إذا كان الانتقام سيساعد النّاجين؟

253
00:15:44,790 --> 00:15:48,760
.أعتقد أنّ الانتقام غريزيّ في البشر

254
00:15:48,760 --> 00:15:51,470
.ولكن يُقال أنّ الانتقام هو شيءٌ فارغ

255
00:15:51,930 --> 00:15:53,430
.ربما هو كذلك

256
00:15:53,430 --> 00:15:55,760
ولكن بعض النّاس يتمكّنون من المضي قدمًا

257
00:15:55,760 --> 00:15:57,760
.بعد تجربة هذا الفراغ فقط

258
00:16:12,530 --> 00:16:15,070
.تنحّى أيها الشّاب

259
00:16:16,660 --> 00:16:17,660
.تفضّل

260
00:16:19,330 --> 00:16:21,160
.قرارٌ جديرٌ بالثّناء

261
00:16:21,660 --> 00:16:23,790
.أنا أستخدم هذا المكان كلّ ليلة

262
00:16:24,170 --> 00:16:25,830
.تذكّر ذلك

263
00:16:26,290 --> 00:16:27,290
.نعم

264
00:16:27,960 --> 00:16:30,380
لماذا أنت جالسٌ هنا بهذه الكآبة؟

265
00:16:31,170 --> 00:16:32,300
.لا سبب

266
00:16:32,630 --> 00:16:35,260
.إن كنت لا تريد إخباري فلا بأس

267
00:16:35,640 --> 00:16:39,140
،بالمناسبة، إن فقد النّاس في عالمك أطرافهم

268
00:16:39,140 --> 00:16:41,600
هل كلّهم يضعون أشياءً كهذه؟

269
00:16:41,600 --> 00:16:42,680
...نعم

270
00:16:42,680 --> 00:16:45,600
.لقد قالوا أنّي سأتمكّن من الرّكض

271
00:16:45,940 --> 00:16:49,650
هنالك أرجل اصطناعيّة قد تُمكّنك
.من الرّكض أسرع من الرّجل الحقيقيّة

272
00:16:49,650 --> 00:16:50,900
حقًّا؟

273
00:16:54,940 --> 00:16:56,160
ما الأمر؟

274
00:16:56,160 --> 00:17:00,580
اخرج من تلك الحالة وأخبرني
.بكلّ شيءٍ يضايقك

275
00:17:04,500 --> 00:17:08,130
.الانتقام سيجعلها بحالةٍ أفضل بالفعل

276
00:17:08,130 --> 00:17:10,380
.ولكنّ الخصم قويّ

277
00:17:10,880 --> 00:17:13,630
.ولا يمكننا إرسال وحدةٍ كبيرة

278
00:17:14,010 --> 00:17:16,550
.لا يجب علينا الذّهاب مطلقًا في الواقع

279
00:17:16,550 --> 00:17:19,390
.سيُقضى علينا إن ذهبنا بمجموعةٍ صغيرة

280
00:17:19,760 --> 00:17:22,100
.سأفقد شيئًا في كلتا الحالتين

281
00:17:22,600 --> 00:17:24,100
.اسمع أيّها الشّاب

282
00:17:25,020 --> 00:17:28,150
ألم تنسَ شيئًا أكبر؟

283
00:17:30,480 --> 00:17:32,440
.قلبك

284
00:17:32,730 --> 00:17:35,570
ما كنتُ لأواجه أيّة مشكلةٍ إن كنت أستطيع
.أخذ القرار بهذه الطّريقة

285
00:17:37,860 --> 00:17:43,540
،هناك أوقاتٌ في حياتك يجب عليك التّصرف فيها
.حتّى وإن كنت تعلم أنّ الأمر خطير

286
00:17:43,870 --> 00:17:46,660
قرّر قلبك مسبقًا، أليس كذلك؟

287
00:17:55,590 --> 00:17:57,720
.لا ترسمي هذه الملامح على وجهك

288
00:17:58,130 --> 00:17:59,180
...ولكن

289
00:18:02,310 --> 00:18:03,850
.سأعود قريبًا

290
00:18:05,180 --> 00:18:05,980
.نعم

291
00:18:08,060 --> 00:18:09,060
...وحينها

292
00:18:11,610 --> 00:18:14,730
وحينها... سيعود كلّ شيءٍ إلى ما
كان عليه سابقًا، صحيح؟

293
00:18:18,450 --> 00:18:19,490
.حسنًا، لنذهب

294
00:18:35,510 --> 00:18:38,510
وحينها سيعود كلّ شيءٍ إلى ما
كان عليه سابقًا، صحيح؟

295
00:18:39,260 --> 00:18:40,510
.أنا آسف أيّها العمّ

296
00:18:40,510 --> 00:18:41,590
!لن أذهب

297
00:18:44,930 --> 00:18:46,180
!توكا

298
00:18:54,590 --> 00:18:55,620
أبي؟

299
00:18:57,940 --> 00:19:00,100
.قرّرت البقاء معك

300
00:19:02,740 --> 00:19:03,630
ألا بأس بذلك؟

301
00:19:04,160 --> 00:19:04,960
.نعم

302
00:19:05,770 --> 00:19:07,660
.لنذهب معًا يا توكا

303
00:19:11,500 --> 00:19:15,500
!إنّك أحمقٌ بالفعل يا إيتامي

304
00:19:15,500 --> 00:19:18,630
تركت مهمّتك لكي تتمكّن من الذّهاب
لقتل التّنّين مع فتاةٍ واحدة؟

305
00:19:18,620 --> 00:19:22,920
ما هو العذر الّذي يُفترض
!أن آتي به لإرسالك وحدك؟

306
00:19:22,930 --> 00:19:24,930
.أنا متأكّدٌ أنّك تستطيع التّفكير بعذرٍ ما

307
00:19:25,470 --> 00:19:28,430
.اسمع، اذهب واجتمع معهم فحسب

308
00:19:28,720 --> 00:19:32,230
،تستطيع إكمال مهمّتك
.ثمّ قيادة فرقة للذّهاب لقتل التّنّين

309
00:19:32,230 --> 00:19:33,100
—بعدها أستطيع

310
00:19:33,100 --> 00:19:35,230
.لقد عزمت على قراري يا ياناغيدا-سان

311
00:19:36,320 --> 00:19:37,440
!حسنًا

312
00:19:37,980 --> 00:19:39,400
ماذا تحتاج؟

313
00:19:39,400 --> 00:19:41,240
،سيّارة وبنزينٌ إضافيّ

314
00:19:41,240 --> 00:19:43,030
.وأسلحة وذخيرة

315
00:19:43,050 --> 00:19:44,450
.وطعام

316
00:19:44,780 --> 00:19:48,080
.ما يكفي لاثنين لمدّة أسبوع

317
00:19:48,090 --> 00:19:49,950
.طعامٌ لاثنين

318
00:19:51,040 --> 00:19:53,120
هل أنت متأكّدٌ أنّك تريد اثنين فقط؟

319
00:19:53,460 --> 00:19:54,210
.نعم

320
00:19:56,840 --> 00:19:57,840
حقًّا؟

321
00:19:58,880 --> 00:20:00,260
!بالطّبع

322
00:20:00,260 --> 00:20:01,590
...من أيضًا قد

323
00:20:04,590 --> 00:20:05,760
روري؟

324
00:20:06,050 --> 00:20:10,390
،إن كنت تريد أخذ فتاةٍ للّعب بالنّار
لِمَ لم تقل ذلك بصراحة؟

325
00:20:10,390 --> 00:20:13,190
!ولكنّنا سنواجه تنّين نار

326
00:20:13,770 --> 00:20:17,190
.لا أستطيع الانتظار! أشعر بالارتعاش

327
00:20:17,440 --> 00:20:20,360
أم هل كنتَ تخطّط لتخسر منذ البداية؟

328
00:20:20,360 --> 00:20:21,240
...لا

329
00:20:21,240 --> 00:20:22,700
إذًا لا بأس، أليس كذلك؟

330
00:20:22,700 --> 00:20:23,530
...لحظة

331
00:20:25,200 --> 00:20:27,330
.حسنًا، حسنًا، سأقولها

332
00:20:29,290 --> 00:20:31,950
هل ستأتين معي يا روري؟

333
00:20:34,000 --> 00:20:35,500
.سيُكلّفك ذلك الكثير

334
00:20:35,500 --> 00:20:36,830
.سآخذكِ على أيّ حال

335
00:20:37,710 --> 00:20:39,880
.ومع ذلك لا أعلم إن كنت أستطيع ردّ الدّين لكِ

336
00:20:41,130 --> 00:20:42,550
.لا تقلق

337
00:20:46,550 --> 00:20:47,890
ماذا تفعلين؟

338
00:20:49,720 --> 00:20:51,560
.تمّ العقد

339
00:20:51,560 --> 00:20:53,020
عقد؟

340
00:20:53,020 --> 00:20:56,700
.إن متّ الآن فروحك ملكٌ لي

341
00:20:56,700 --> 00:20:57,580
ماذا؟

342
00:20:57,560 --> 00:21:00,570
.طعام لثلاثة أشخاص يا ياناغيدا

343
00:21:00,570 --> 00:21:01,980
.لا، أربعة

344
00:21:02,360 --> 00:21:03,440
أنتِ أيضًا يا ليلي؟

345
00:21:07,070 --> 00:21:09,990
.أنا ملكٌ لك الآن، إلى الأبد

346
00:21:10,330 --> 00:21:11,990
.مُرني بأيّ أمرٍ تريده

347
00:21:11,990 --> 00:21:14,000
.أنتِ أيضًا ستأتين كما توقّعت

348
00:21:14,000 --> 00:21:16,580
.سنحتاج إلى مرشدٍ على أيِّ حال

349
00:21:17,040 --> 00:21:19,840
انتهى الأمر بذهاب خمسة إذًا؟

350
00:21:20,380 --> 00:21:22,260
لماذا هي هنا أيضًا؟

351
00:21:22,260 --> 00:21:23,970
.لا تقولي هذا

352
00:21:23,970 --> 00:21:27,300
.إنّها ذاهبةٌ لوطنها، لذا نحن نوصلها فحسب

353
00:21:27,590 --> 00:21:28,340
!حسنًا

354
00:21:35,520 --> 00:21:38,850
.الهوايات أوّلاً، ومن ثمّ اعمل في أوقات فراغك

355
00:21:38,850 --> 00:21:41,360
...لذا لِمَ

356
00:21:42,110 --> 00:21:45,700
لِمَ لديك أشخاص يتطوّعون للّحاق بك؟

357
00:21:50,740 --> 00:21:52,870
غادر الشّاب إذًا؟

358
00:21:56,040 --> 00:21:58,500
.أنا قادمة يا رفاق

359
00:21:58,870 --> 00:22:00,080
!انتظروا فقط

360
00:22:00,960 --> 00:22:02,880
!اهزمه يا أبي

361
00:22:02,880 --> 00:22:04,010
!اعتمدي عليّ

362
00:23:35,810 --> 00:23:39,180
:"في الحلقة القادمة من "بوّابة
"تنّين النّار مرّةً أخرى"