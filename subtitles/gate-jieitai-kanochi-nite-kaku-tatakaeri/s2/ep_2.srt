193
00:14:58,410 --> 00:15:02,130
.وعقدت اجتماعاتٍ عدّة من أجل ذلك

194
00:15:02,580 --> 00:15:04,460
ما معنى هذا إذًا؟

195
00:15:04,880 --> 00:15:08,340
لماذا دُمّر المجلس الأعلى؟

196
00:15:10,590 --> 00:15:14,140
.إن لم تُجب، فأنا سأخبرهم

197
00:15:14,550 --> 00:15:16,760
بدأ هذا كلّه عندما اختُطف عدّة مواطنين

198
00:15:16,760 --> 00:15:20,600
.من ما وراء البوّابة قبل الحرب

199
00:15:20,600 --> 00:15:21,390
ماذا؟

200
00:15:21,980 --> 00:15:23,560
حصل شيء كهذا؟

201
00:15:25,190 --> 00:15:28,110
،عندما عرفوا ذلك

202
00:15:28,110 --> 00:15:31,070
!ضربوا الأمير زورزال بوحشيّة

203
00:15:32,200 --> 00:15:33,320
لماذا؟

204
00:15:33,990 --> 00:15:36,200
...إ-إنّ اليابانيّين

205
00:15:36,780 --> 00:15:40,620
.يقدّرون حياة مواطنيهم فوق كل شيء

206
00:15:40,620 --> 00:15:43,540
.لا، ليس فقط مواطنيهم

207
00:15:43,540 --> 00:15:47,250
.إنّهم حتّى لا يقتلون أو يستعبدون سجناءهم

208
00:15:47,250 --> 00:15:49,340
!هل يعقل شيء كهذا؟

209
00:15:49,340 --> 00:15:50,590
!هذه تفاهة

210
00:15:50,590 --> 00:15:53,050
هل يعتقدون أنّهم آلهة؟

211
00:15:53,050 --> 00:15:54,640
...إنّهم يحبّون شعبهم

212
00:15:55,260 --> 00:15:57,640
.كما أنّهم يعاملون سجناءهم بشكلٍ جيّد

213
00:15:58,010 --> 00:16:02,480
.ولن يقوموا حتى ببيع أعدائهم مقابل المال

214
00:16:02,940 --> 00:16:06,650
.هؤلاء هم اليابانيّون

215
00:16:08,020 --> 00:16:13,280
...نتيجةُ رؤيتهم لشعبهم يُستعبدون كانت

216
00:16:13,910 --> 00:16:15,160
.ما ترونه أمامكم

217
00:16:16,160 --> 00:16:19,200
لماذا تقف إلى جانبهم إلى هذه الدرجة؟

218
00:16:26,210 --> 00:16:28,750
.حاول تبريد وجهك يا صاحب السّموّ

219
00:16:30,000 --> 00:16:32,510
!الثّلج! أحضري لي الثّلج

220
00:16:32,510 --> 00:16:33,880
!أجل، في الحال

221
00:16:36,300 --> 00:16:37,180
.سحقًا

222
00:16:37,890 --> 00:16:40,100
.يا للأسى يا أخي

223
00:16:41,350 --> 00:16:42,390
ديابو؟

224
00:16:42,850 --> 00:16:45,810
.أغلبية المجلس الأعلى يريد إبرام السّلام

225
00:16:46,270 --> 00:16:48,900
.بهذه الحالة، سيكون هذا كالاستسلام بلا شروط

226
00:16:49,320 --> 00:16:50,610
...لتجنّب هذا

227
00:16:50,610 --> 00:16:52,110
.حِيَلٌ غبيّة

228
00:16:52,110 --> 00:16:53,440
.أخي

229
00:16:53,860 --> 00:16:56,450
.من الصّعب التّظاهر كالغبيّ

230
00:16:57,820 --> 00:17:01,790
.لا يمكنني أن أكون ذكيًّا كما هو حالك أنت

231
00:17:02,370 --> 00:17:05,830
.سيتمّ تعذيبي حتّى الموت كأخينا كاتي

232
00:17:06,250 --> 00:17:08,790
.كان أبي لا يزال يافعًا حينها

233
00:17:09,210 --> 00:17:12,260
.لهذا، خاف من وليّ العهد

234
00:17:12,590 --> 00:17:15,760
.ولكنّه كبيرٌ في السّنّ الآن

235
00:17:16,430 --> 00:17:19,550
أرى أنّك كنت تحاول أن تصبح

236
00:17:19,550 --> 00:17:22,060
.الإمبراطور التّالي بينما كنت أنا أتظاهر بالغباء

237
00:17:22,890 --> 00:17:24,980
،ولكن مهما حاولت أن تفعل

238
00:17:24,980 --> 00:17:28,400
.أنا من سيُعيّن الإمبراطور التّالي

239
00:17:30,060 --> 00:17:33,230
...لا أعتقد أنّ أبي يُفضّلك كثيرًا

240
00:17:33,230 --> 00:17:34,860
.لهذا السّبب

241
00:17:35,190 --> 00:17:38,990
.لإنهاء هذه الحرب، على الإمبراطور أن يتخلّى عن الحكم

242
00:17:39,700 --> 00:17:42,830
.ولكنّ والدي لن يتخلّى عن قوّةً حقيقيّة

243
00:17:43,240 --> 00:17:45,910
،ينوي جعلي الإمبراطور لأنّ من السّهل التّحكم بي

244
00:17:46,250 --> 00:17:48,250
.ومن ثمّ يحكم هو من خلف الكواليس

245
00:17:48,250 --> 00:17:50,130
!هذا استهتار

246
00:17:50,130 --> 00:17:53,250
ما الّذي سيحدث بعد رحيل أبي؟

247
00:17:52,550 --> 00:17:53,250
!تشيولي

248
00:17:53,590 --> 00:17:54,260
.نعم

249
00:17:55,130 --> 00:17:57,550
.كان هناك اثنين قُبض عليهما رفقة نوريكو

250
00:17:57,880 --> 00:18:00,680
.كلاهما تمّ بيعه للعمل في المناجم

251
00:18:00,680 --> 00:18:03,560
.علق أحدهما في انهيار كهف ومات

252
00:18:03,850 --> 00:18:05,980
ماذا عن الّذي يدعى هيروكي؟

253
00:18:06,640 --> 00:18:07,980
.هو من مات

254
00:18:10,400 --> 00:18:12,110
.يا له من أخرق

255
00:18:12,480 --> 00:18:13,480
.حسنًا، لا يهم

256
00:18:13,480 --> 00:18:15,820
.أعتقد أنّه حان الوقت لجلب النّاجي لهم

257
00:18:15,820 --> 00:18:17,200
.مفهوم

258
00:18:17,820 --> 00:18:20,110
،بعرضك تسليم العبد لهم بمحض إرادتك

259
00:18:20,110 --> 00:18:22,330
ستجعل النّاس يظنّون أنّك من طائفة دعاة السّلام؟

260
00:18:22,830 --> 00:18:24,830
،إن كنت أعلم أنّ هذا سيحدث

261
00:18:24,830 --> 00:18:28,330
.ربّما كنت سأكون ألطف مع نوريكو

262
00:18:28,620 --> 00:18:34,590
كلاّ، أنت لم تنقذها من الاغتصاب
،من قبل عدّة رجال فحسب

263
00:18:34,590 --> 00:18:37,630
.بل أعطيتها شرف اختيارك لها

264
00:18:37,630 --> 00:18:39,340
.عليها أن تشعر بالفخر

265
00:18:39,630 --> 00:18:43,140
.قرّر من ستخدم يا ديابو

266
00:18:43,470 --> 00:18:45,430
...أنا، أم أبي

267
00:18:45,770 --> 00:18:48,940
.تُعتبر بينيا خائنةً الآن على ما أعتقد

268
00:18:50,020 --> 00:18:53,190
!ولكن، جروحك يا صاحب السّموّ

269
00:18:53,190 --> 00:18:55,900
!لا أهتمّ

270
00:19:00,300 --> 00:19:01,280
هل تريدين منها؟

271
00:19:02,490 --> 00:19:04,170
.شكرًا لك

272
00:19:05,010 --> 00:19:06,450
.أوشكنا على الوصول

273
00:19:09,710 --> 00:19:10,830
.سأتمكّن من العودة

274
00:19:12,210 --> 00:19:13,170
...أستطيع العودة حقًّا

275
00:19:23,930 --> 00:19:26,180
أنتِ موتشيزوكي نوريكو-سان، صحيح؟

276
00:19:26,810 --> 00:19:27,600
.نعم

277
00:19:28,020 --> 00:19:29,230
.من هنا لو سمحتِ

278
00:19:33,520 --> 00:19:35,820
.يبدو أنّك أخفقت مرّةً أخرى

279
00:19:40,190 --> 00:19:42,530
أطلقتَ النّار في القصر الملكيّ؟

280
00:19:42,530 --> 00:19:44,660
.إنّك تدهشني

281
00:19:44,660 --> 00:19:47,030
.ومن ثمّ أنقذت الضّحيّة المختطفة

282
00:19:47,030 --> 00:19:49,410
.لست متأكّدًا إن كنت تستحقّ توبيخًا أم ميداليّة

283
00:19:49,410 --> 00:19:50,710
ما هي الحالة؟

284
00:19:50,710 --> 00:19:53,210
.أعتقد أنّك ستكون محظوظًا إن تمّ خصم راتبك فقط

285
00:19:54,390 --> 00:19:56,060
...ولكن

286
00:19:57,000 --> 00:20:01,170
تنوي الحكومة استخدام هذا كمحفّز
.لزيادة أعداد التّصويت لها في الانتخابات

287
00:20:01,510 --> 00:20:05,430
.إنقاذ السّجناء من الأعداء ستكون دعايةً جيّدة

288
00:20:05,970 --> 00:20:10,180
لذا لا أستطيع معاقبة
.الرّجل الّذي جعل هذا ممكنًا

289
00:20:10,640 --> 00:20:14,190
.الجنرال هازاما لا يعلم ما يفعل أيضًا

290
00:20:14,190 --> 00:20:16,690
.أنا آسف جدًّا يا جنرال

291
00:20:17,820 --> 00:20:21,490
...وأيضًا، بشأن عائلة موتشيزوكي نوريكو

292
00:20:26,160 --> 00:20:27,620
كيف حالك؟

293
00:20:29,700 --> 00:20:31,250
.هدأت كثيرًا

294
00:20:31,540 --> 00:20:32,620
.تحمّلي

295
00:20:32,620 --> 00:20:33,660
.حسنًا

296
00:20:34,170 --> 00:20:38,000
،أنا متأكّدة أنّ عائلتي قلقة
هل يمكنني استعارة هاتف؟

297
00:20:38,290 --> 00:20:39,590
...لدي واحدٌ

298
00:20:42,010 --> 00:20:43,720
.آسف يا موتشيزوكي-سان

299
00:20:44,430 --> 00:20:47,180
.لم نُثبّت خطًّا للمدنيّين بعد

300
00:20:47,510 --> 00:20:50,640
يجب أن توضعي تحت المراقبة الطّبيّة قبل
.أن تعودي خلال البوّابة أيضًا

301
00:20:50,640 --> 00:20:53,480
هل تستطيعين الانتظار قليلاً قبل الاتّصال بهم؟

302
00:20:53,480 --> 00:20:55,250
...فهمت

303
00:20:56,580 --> 00:20:58,570
،بعد أن فُقدت

304
00:20:58,860 --> 00:21:03,400
بقيّة عائلتها كانوا يوزّعون منشورات
.عليها اسمها في غينزا

305
00:21:03,400 --> 00:21:04,240
...لا يمكن

306
00:21:05,110 --> 00:21:07,110
.تمّ العثور عليهم هناك في ذلك اليوم

307
00:21:11,990 --> 00:21:16,170
نحن نبحث عن
هذه الفتاة

308
00:21:11,990 --> 00:21:16,170
موتشيزوكي نوريكو

309
00:21:15,360 --> 00:21:18,100
.لا تخبروها بعد

310
00:21:18,100 --> 00:21:19,060
.حسنًا

311
00:21:20,880 --> 00:21:21,970
!موتشيزوكي-سان

312
00:21:22,260 --> 00:21:24,300
...إيتامي-سان، كوريباياشي-سان

313
00:21:25,120 --> 00:21:28,030
...كان عليّ قول هذا سلفًا، ولكن

314
00:21:28,010 --> 00:21:30,760
.أنا حقًّا شاكرة لكما

315
00:21:46,540 --> 00:21:47,170
.مرحبًا

316
00:21:50,040 --> 00:21:51,700
ما الأمر الآن؟

317
00:21:51,960 --> 00:21:54,380
.أردت إخبارك شيئًا

318
00:21:54,380 --> 00:21:57,120
لا شيء جيّد، أليس كذلك؟

319
00:21:57,120 --> 00:21:59,260
.ستندم إن لم تسمعه

320
00:22:02,730 --> 00:22:05,550
أين أنت يا أبي؟

321
00:23:36,890 --> 00:23:40,140
:"في الحلقة القادمة من "بوّابة
.توكا لونا مارسو