61
00:05:10,870 --> 00:05:12,790
.وتقوية أمن القصر

62
00:05:12,790 --> 00:05:13,700
!حاضر

63
00:05:15,580 --> 00:05:17,960
.أنتنّ نظفنّ القاعة

64
00:05:17,960 --> 00:05:18,880
.نعم

65
