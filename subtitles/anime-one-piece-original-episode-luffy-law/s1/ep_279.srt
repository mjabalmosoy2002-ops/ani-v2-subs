1
00:00:15,570 --> 00:00:17,490
...الثّروة والشّهرة والسّلطة

2
00:00:17,490 --> 00:00:19,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:19,450 --> 00:00:21,370
.ملك القراصنة، غولد روجر

4
00:00:21,370 --> 00:00:25,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:25,080 --> 00:00:28,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:28,840 --> 00:00:32,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:34,800 --> 00:00:39,140
وبهذا، يتوجّه الرّجال نحو
!غراند لاين لملاحقة أحلامهم

8
00:00:39,720 --> 00:00:42,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:43,520 --> 00:00:48,110
سنجمع كل أحلامنا

10
00:00:49,110 --> 00:00:54,530
ونبحر باحثين عن شيء، باحثين عن

11
00:00:54,950 --> 00:00:56,570
!وان بيس

12
00:01:01,080 --> 00:01:05,920
لا تجلب البوصلات سوى التّأخيرات

13
00:01:06,750 --> 00:01:11,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:12,460 --> 00:01:17,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:17,760 --> 00:01:23,310
!فإنّها ليست أسطورة إذًا

16
00:01:24,520 --> 00:01:30,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:30,230 --> 00:01:35,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:35,400 --> 00:01:37,990
!وتظاهر أنّها غير موجودة

19
00:01:38,990 --> 00:01:43,830
سنجمع كلّ أحلامنا

20
00:01:44,830 --> 00:01:50,340
ونبحر باحثين عن شيء

21
00:01:50,340 --> 00:01:53,340
،عملة في جيبي

22
00:01:53,340 --> 00:01:56,590
وتريد أن تصبح صديقي؟

23
00:01:56,590 --> 00:02:01,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:02:01,970 --> 00:02:03,890
!إننا كذلك

25
00:02:05,650 --> 00:02:06,940
.سوغيكينغ

26
00:02:08,610 --> 00:02:10,770
.أطلق على ذلك العلم

27
00:02:11,160 --> 00:02:12,360
.عُلم

28
00:02:14,380 --> 00:02:17,620
هذا سلاحي الجديد، المقلاع
!الضّخم... وأسميته كابوتو

29
00:02:18,180 --> 00:02:20,570
!أمعنوا النّظر إلى قوّته

30
00:02:20,570 --> 00:02:24,000
!القتل المؤكّد: نجم طائر النّار

31
00:02:33,140 --> 00:02:34,170
!مستحيل

32
00:02:38,100 --> 00:02:39,300
!تمّت المهمّة

33
00:02:39,940 --> 00:02:43,190
هل أنتم مجانين؟! لا تظنّوا أنّكم ستنجون

34
00:02:43,190 --> 00:02:45,020
!بعد جعلكم للعالم بأسره عدوًّا لكم

35
00:02:45,270 --> 00:02:49,900
!تلك غايتي من الأساس

36
00:02:53,660 --> 00:02:54,920
!روبين

37
00:02:56,620 --> 00:02:59,200
!ما زلنا لم نسمعك تقولينها

38
00:03:04,000 --> 00:03:07,240
!قولي أنّك تريدين أن تعيشي

39
00:03:10,800 --> 00:03:11,810
...روبين

40
00:03:16,390 --> 00:03:17,410
!روبين

41
00:03:19,810 --> 00:03:21,000
...أعيش

42
00:03:23,020 --> 00:03:26,560
.ظننتُه أمرًا ما كنت لأجرأ على تمنّيه

43
00:03:29,030 --> 00:03:32,470
.لم يسمح لي أحد أبدًا بتمنّيه

44
00:03:32,700 --> 00:03:36,870
...نعم. البحر واسع، ويومًا ما بكلّ تأكيد

45
00:03:36,870 --> 00:03:40,900
!ستقابلين أصدقاء سيحمونك

46
00:03:49,710 --> 00:03:54,750
إن كان من المسموح لي بالفعل
...البوح بأمنيتي أخيرًا

47
00:03:56,050 --> 00:03:57,310
...فأنا

48
00:04:00,270 --> 00:04:02,030
!أريد أن أعيش

49
00:04:03,430 --> 00:04:07,520
!خذوني للبحر معكم

50
00:04:27,880 --> 00:04:31,820
!يا رفاق...! أنا أحبّكم اللّعنة عليكم

51
00:04:33,750 --> 00:04:34,660
!لننطلق

52
00:04:38,550 --> 00:04:40,010
!الجسر المتحرّك ينزل

53
00:04:46,660 --> 00:04:47,480
!روبين

54
00:04:48,270 --> 00:04:49,920
!سننقذك بكلّ تأكيد

55
00:04:50,730 --> 00:04:54,810
!إنّ الجسر المتحرّك ينزل! انطلق يا قبّعة القشّ

56
00:04:54,900 --> 00:04:56,820
!كيف تجرؤون أيّها القراصنة الملعونون

57
00:04:56,820 --> 00:04:58,950
!لن نسمح بحدوث هذا

58
00:04:58,950 --> 00:05:03,620
!جهّزوا مدفع الخندق! أوقفوا الجسر
!حطّموه إن اقتضى الأمر

59
00:05:03,620 --> 00:05:04,660
!حاضر

60
00:05:13,240 --> 00:05:14,570
!توقّف الجسر المتحرّك عن النّزول؟

61
00:05:15,010 --> 00:05:17,460
!كيف تجرؤون على الوقوف في وجهنا؟
!أوغاد ملعونون

62
00:05:18,260 --> 00:05:20,220
!من الفاعل؟

63
00:05:21,470 --> 00:05:24,500
!أيّها القراصنة

64
00:05:24,680 --> 00:05:26,310
!ماذا؟! كوكورو-سان؟

65
00:05:26,310 --> 00:05:29,980
!سمعتُ كلّ شيء
!لماذا تضيّعون الوقت؟

66
00:05:29,980 --> 00:05:32,990
.نضيّع الوقت؟ لكنّ الجسر لم ينزل بالكامل

67
00:05:33,270 --> 00:05:36,600
!اقفزوا بكلّ ما لديكم من قوّة للشّلاّلات

68
00:05:37,900 --> 00:05:39,050
أهذا صوت القطار البحريّ؟

69
00:05:40,990 --> 00:05:43,740
ماذا؟ ما معنى تلك الابتسامة؟

70
00:05:53,180 --> 00:05:54,540
!لننطلق

71
00:05:55,280 --> 00:05:56,580
!عرفتُ هذا

72
00:06:00,500 --> 00:06:02,490
!كلاّ

73
00:06:06,850 --> 00:06:08,680
!لم أكن لآخذك على أي حال

74
00:06:09,020 --> 00:06:11,390
!يستحيل أن تصبح قرصانًا

75
00:06:11,890 --> 00:06:12,840
!بل سأصبح

76
00:06:13,190 --> 00:06:16,020
،سأجمع رفقاء يضاهون هذا الطّاقم يومًا ما

77
00:06:16,690 --> 00:06:18,480
،وأجد أعظم كنز في العالم

78
00:06:18,900 --> 00:06:22,120
!وسأصبح ملك القراصنة حتمًا

79
00:06:25,290 --> 00:06:29,570
عندما كنت طفلاً، أقسمت
...أن أجمع طاقمي وأصبح قرصانًا

80
00:06:30,370 --> 00:06:32,710
.مثل القرصان الّذي حماني

81
00:06:34,880 --> 00:06:36,710
!أنت صديقتنا بالفعل

82
00:06:37,020 --> 00:06:37,980
...روبين

83
00:06:38,670 --> 00:06:41,550
،لذلك، كما حماني هو حينها

84
00:06:41,550 --> 00:06:44,180
!سأحميك أنا أيضًا

85
00:06:52,060 --> 00:06:55,400
"!اقفزوا نحو الشّلاّلات! مشاعر لوفي"

86
00:07:11,620 --> 00:07:14,880
!خذني معك في رحلتك القادمة إذًا يا شانكس

87
00:07:14,880 --> 00:07:16,840
!أريد أن أصبح قرصانًا أيضًا

88
00:07:18,590 --> 00:07:20,620
!يستحيل أن تصبح قرصانًا

89
00:07:21,260 --> 00:07:22,600
!لماذا؟

90
00:07:24,010 --> 00:07:25,040
.لوفي

91
00:07:25,040 --> 00:07:29,020
مجرّد كونك سبّاحًا ماهرًا، فذلك لا يعني
.أنّك ستصبح قرصانًا جيّدًا

92
00:07:29,020 --> 00:07:32,470
!أنا قويّ بالقتال أيضًا
!لكماتي كالمسدّس

93
00:07:32,770 --> 00:07:34,020
حقًّا؟

94
00:07:34,020 --> 00:07:35,430
!ما هذا الأسلوب؟

95
00:07:35,770 --> 00:07:38,440
!هذا يعني أنّك طفل صغير يا لوفي

96
00:07:38,440 --> 00:07:40,890
!إنّك بنفس عمر ابني

97
00:07:41,030 --> 00:07:43,410
!لست طفلاً! أنا بالغ

98
00:07:43,410 --> 00:07:46,830
.هوّن عليك، لا تغضب
!هيّا، اشرب العصير

99
00:07:46,830 --> 00:07:48,700
!شكرًا لك

100
00:07:50,160 --> 00:07:52,290
!أرأيت؟ إنّك طفل

101
00:07:52,290 --> 00:07:53,980
!هذه حركة قذرة يا شانكس

102
00:07:55,930 --> 00:07:57,080
!لا تضحكوا

103
00:07:57,750 --> 00:07:59,880
!تبًّا لك يا شانكس الغشّاش

104
00:08:10,180 --> 00:08:11,600
.سنعذر أنفسنا

105
00:08:17,520 --> 00:08:22,470
.هؤلاء هم المدعوّون بالقراصنة إذًا
.يبدون كالحمقى

106
00:08:27,370 --> 00:08:28,720
...مرحبًا

107
00:08:31,240 --> 00:08:35,710
.إنّنا قطّاع طرق جبال
.ولكنّنا لم نأت لتخريب المكان

108
00:08:36,170 --> 00:08:39,010
بيعي لنا الشّراب. عشرة براميل
.تقريبًا ستكون كافية

109
00:08:40,320 --> 00:08:44,010
.المعذرة، نفد منا الشّراب للتّوّ

110
00:08:44,010 --> 00:08:45,550
.هذا غريب

111
00:08:45,550 --> 00:08:49,390
يبدو أنّ القراصنة يشربون شيئًا ما، أذلك ماء؟

112
00:08:49,390 --> 00:08:52,510
.ما قدّمته لهم للتّوّ هو كلّ ما أملكه

113
00:08:52,970 --> 00:08:57,720
المعذرة على ذلك، يبدو أننا شربنا
.حتّى نفد الشّراب من المحلّ

114
00:08:57,960 --> 00:08:58,680
!آسف

115
00:08:59,560 --> 00:09:02,950
.سأعطيك هذه إن أردت. لم أفتحها بعد

116
00:09:10,460 --> 00:09:14,200
.هناك مكافأة 8 ملايين بيري على رأسي لعلمك

117
00:09:14,200 --> 00:09:18,150
زجاجة واحدة ليست كافية حتّى
.لشراب ما قبل النّوم. لا تستخفّ بي

118
00:09:22,090 --> 00:09:23,420
.تبلّلت الأرض

119
00:09:24,760 --> 00:09:27,840
أعتذر على ذلك يا ماكينو-سان، ألديك خرقة؟

120
00:09:28,050 --> 00:09:30,290
!سأعتني بالأمر

121
00:09:36,450 --> 00:09:41,150
.يبدو أنّك تحبّ التّنظيف
.ربّما سيرضيك هذا أكثر

122
00:09:41,820 --> 00:09:46,250
لا فائدة من البقاء بما أنّهم
!لا يملكون الشّراب. لنذهب

123
00:09:48,780 --> 00:09:50,560
!الوداع أيّها الجبناء

124
00:10:01,710 --> 00:10:04,000
هل أنت بخير أيّها القائد؟
هل من جروح؟

125
00:10:04,000 --> 00:10:06,200
.أنا بخير. لا مشكلة

126
00:10:10,970 --> 00:10:13,010
!هزأ بك بالكامل يا زعيم

127
00:10:13,010 --> 00:10:14,430
!حالك يرثى لها

128
00:10:17,730 --> 00:10:19,010
!لماذا تضحكون؟

129
00:10:19,640 --> 00:10:23,310
!بدوتم سخيفين جدًّا
!لماذا لم تقاتلوهم؟

130
00:10:23,820 --> 00:10:26,280
،مهما كانت أعدادهم أو مدى قوّتهم

131
00:10:26,280 --> 00:10:29,940
فلستم رجالاً لضحككم بعد فعلهم
!ذلك بكم... ولا قراصنة

132
00:10:32,320 --> 00:10:37,120
أتفهّم شعورك، ولكنّه صبّ
.الشّراب عليّ فحسب

133
00:10:37,120 --> 00:10:39,040
.ليس شيئًا يستحقّ الغضب بشأنه

134
00:10:39,040 --> 00:10:40,080
!لا يهمّ

135
00:10:48,520 --> 00:10:49,720
أتأكل بدافع الغضب يا لوفي؟

136
00:10:49,720 --> 00:10:50,380
!اصمت

137
00:10:53,140 --> 00:10:54,510
!ما الّذي تأكله؟

138
00:10:56,640 --> 00:11:00,140
ما داخل الصّندوق... هل أكلت
ما داخل هذا الصّندوق؟

139
00:11:00,140 --> 00:11:00,880
...أ-أجل

140
00:11:02,110 --> 00:11:04,770
!الفظه! الفظه حالاً! الفظّ كلّ ما أكلته

141
00:11:04,770 --> 00:11:07,060
!مـ-ماذا تفعل يا شانكس؟

142
00:11:16,910 --> 00:11:18,740
ما كان ذلك؟

143
00:11:19,040 --> 00:11:21,790
!ما أكلته كان فاكهة المطّاط

144
00:11:21,790 --> 00:11:23,420
،فاكهة المطّاط معروفة باسم فاكهة الشّيطان

145
00:11:23,790 --> 00:11:25,420
...وتناولها يحوّل جسدك إلى مطّاط

146
00:11:25,670 --> 00:11:29,320
!وتفقد القدرة على السّباحة إلى الأبد

147
00:11:29,510 --> 00:11:31,930
!ماذا؟! مستحيل

148
00:11:31,930 --> 00:11:33,800
!أيّها الغبيّ

149
00:11:51,600 --> 00:11:57,110
،كنّا نشرب بمزاج جيّد
فما الّذي تفعله أيّها الطّفل؟

150
00:11:57,430 --> 00:12:00,530
سحقًا! اعتذر! كيف تجرؤ على
السّخرية من شانكس وطاقمه؟

151
00:12:02,880 --> 00:12:06,140
أقلت شيئًا يهينك؟

152
00:12:06,140 --> 00:12:07,880
!قلت! اعتذر

153
00:12:08,420 --> 00:12:09,330
!أيّها العمدة

154
00:12:14,720 --> 00:12:17,220
!هل رأيتم وجوه أولئك القراصنة في تلك المرّة؟

155
00:12:17,220 --> 00:12:21,670
!غُطّي بالشّراب ولم يقل أيّ كلمة
!يا له من مثير للشّفقة

156
00:12:22,310 --> 00:12:26,220
.القراصنة مجرّد مجموعة من الجبناء
.لا يجيدون سوى الكلام

157
00:12:26,560 --> 00:12:27,520
!توقّفوا

158
00:12:29,360 --> 00:12:32,820
!لا تسخروا من شانكس والبقيّة
!ليسوا ضعفاء

159
00:12:32,820 --> 00:12:34,190
!توقّف يا لوفي

160
00:12:36,570 --> 00:12:38,990
لا تسخروا من شانكس والبقيّة
!يا قطّاع الطّرق الأغبياء

161
00:12:43,760 --> 00:12:46,910
.اختيارك للكلمات كان سيّئًا أيّها الطّفل

162
00:12:46,910 --> 00:12:51,120
.لم ينجُ شخص أغضبني من قبل

163
00:12:51,880 --> 00:12:53,210
!تمهّل

164
00:12:53,550 --> 00:12:55,660
!أفلت الصّبي! أرجوك

165
00:12:58,090 --> 00:13:02,350
،لا أدري ما الّذي فعله لوفي
!ولا أريد قتالكم

166
00:13:02,350 --> 00:13:04,640
!إلّم يكن ذلك يهينكم، فسأدفع لكم حتّى

167
00:13:04,640 --> 00:13:07,340
!أرجوكم، اعفوا عن هذا الصّبي

168
00:13:07,600 --> 00:13:08,840
!العمدة

169
00:13:09,480 --> 00:13:13,020
.يعرف كبار السّنّ كيف يسير العالم بالفعل

170
00:13:13,440 --> 00:13:15,860
.ولكن لا فائدة. فات الأوان عليه

171
00:13:15,860 --> 00:13:18,780
...ذلك لأنّه أغضبني

172
00:13:19,780 --> 00:13:22,020
!أنتم المخطئون يا قردة الجبال

173
00:13:24,200 --> 00:13:27,960
.أمرك ميؤوس أيّها الطّفل
!فلتندم على ذلك في العالم الآخر

174
00:13:28,170 --> 00:13:28,910
!لوفي

175
00:13:28,910 --> 00:13:31,770
!أرجوك! أفلته

176
00:13:31,770 --> 00:13:34,670
...تساءلت لِمَ كانت الحانة فارغة

177
00:13:35,730 --> 00:13:37,460
.يبدو أنّهم قطّاع الطّرق من تلك المرّة

178
00:13:37,970 --> 00:13:39,670
!القائد

179
00:13:44,100 --> 00:13:45,510
!شانكس

180
00:14:07,400 --> 00:14:10,790
ما زلتم في هذه القرية أيّها القراصنة؟

181
00:14:10,790 --> 00:14:13,040
هل كنت تنظّف القرية طوال الوقت؟

182
00:14:13,040 --> 00:14:14,000
!لوفي

183
00:14:14,590 --> 00:14:17,200
ألم تكن لكماتك قوية كالمسدّس؟

184
00:14:17,480 --> 00:14:18,380
!اصمت

185
00:14:19,230 --> 00:14:23,090
،لا أدري ما الّذي جاء بك إلى هنا
.ولكن غادر قبل أن يلحق بك الأذى

186
00:14:23,450 --> 00:14:27,310
.إن اقتربت أكثر، فسنفجر رأسك أيّها الضّعيف

187
00:14:29,190 --> 00:14:32,810
!أخبرك ألا تقترب أكثر! سأفجّر رأسك

188
00:14:40,010 --> 00:14:41,620
.ضع حياتك على المحكّ

189
00:14:41,830 --> 00:14:42,600
!ماذا؟

190
00:14:43,740 --> 00:14:46,320
ضع حياتك على المحكّ بما
.أنّك قد سحبت مسدّسك

191
00:14:47,000 --> 00:14:48,580
ماذا تقول أيّها الوغد؟

192
00:14:49,310 --> 00:14:52,030
.أعني أنّ هذا ليس أداة للتّهديد

193
00:15:06,320 --> 00:15:07,940
!أ-أطلقتم النّار عليه

194
00:15:07,940 --> 00:15:09,350
!يا لهم من قذرين

195
00:15:09,890 --> 00:15:10,680
قذرين؟

196
00:15:10,680 --> 00:15:12,560
.لا تتفوّهوا بالسّخافات

197
00:15:12,560 --> 00:15:15,060
هل تعتقدون أنّكم تواجهون
قدّيسين أو شيئًا من ذلك القبيل؟

198
00:15:15,440 --> 00:15:17,730
!من يقفون أمامكم قراصنة

199
00:15:18,100 --> 00:15:20,930
!اصمتوا! لا علاقة لكم بالأمر من الأساس

200
00:15:21,380 --> 00:15:22,930
...استمعوا يا قطاع الطّرق

201
00:15:22,930 --> 00:15:27,490
حين يصبّ الشّراب عليّ أو يلقى عليّ
،طعام أو يُبصق عليّ حتّى

202
00:15:27,490 --> 00:15:30,000
.فإنّي سأضحك وأنسى الأمر في أغلب الأوقات

203
00:15:30,000 --> 00:15:30,950
...ولكن

204
00:15:31,330 --> 00:15:33,080
،مهما كان السّبب

205
00:15:33,080 --> 00:15:35,240
!فلن أغفر لمن يؤذي أصدقائي

206
00:15:36,490 --> 00:15:37,700
...شانكس

207
00:15:39,910 --> 00:15:41,330
!لن تغفر له؟

208
00:15:41,510 --> 00:15:44,500
!قراصنة سفلة! اقتلوهم يا رجال

209
00:15:46,930 --> 00:15:48,970
.سأتولّى هذا. لا نحتاج للمزيد

210
00:15:59,410 --> 00:16:01,650
.لا تغترّ بنفسك يا قاطع الطّرق

211
00:16:01,650 --> 00:16:06,010
.إن أردت قتالنا، فاجلب سفينة حربيّة إلى هنا

212
00:16:06,950 --> 00:16:08,530
!قويّ للغاية

213
00:16:08,790 --> 00:16:12,920
!تـ-تمهل! هذا الطّفل هو من هاجمنا

214
00:16:13,220 --> 00:16:14,500
.إنّك رجل مطلوب

215
00:16:16,080 --> 00:16:17,230
!سحقًا

216
00:16:18,190 --> 00:16:19,120
!قنبلة دخانيّة

217
00:16:22,630 --> 00:16:23,540
!لوفي

218
00:16:25,400 --> 00:16:27,300
!تمكّنت من الهرب بسلاسة

219
00:16:27,300 --> 00:16:29,500
لن يتوقّعوا هروب قاطع طرق
!جبليّة إلى البحر أبدًا

220
00:16:30,180 --> 00:16:34,510
!سحقًا! اتركني أيّها القرد الغبيّ
!فلتمت أفضل

221
00:16:35,270 --> 00:16:37,680
!أيّها الغبيّ... أنت من سيموت

222
00:16:38,270 --> 00:16:40,640
!فقد أغضبتني في نهاية المطاف

223
00:16:41,040 --> 00:16:42,150
!الوداع

224
00:16:44,200 --> 00:16:45,570
!سحقًا! سحقًا

225
00:16:45,570 --> 00:16:49,350
إنّهم مجرّد قمامة، ولم أتمكن من
!ضربهم حتّى مرّة واحدة! سحقًا

226
00:16:54,790 --> 00:16:58,430
.آسف، ولكن لا فائدة لي منك بعد الآن

227
00:17:07,090 --> 00:17:09,580
!مـ-ما هذا؟

228
00:17:17,190 --> 00:17:18,540
!النّجدة

229
00:17:35,230 --> 00:17:36,540
!شانكس

230
00:17:44,760 --> 00:17:45,870
!انصرف

231
00:18:05,110 --> 00:18:09,570
...أدين لك يا لوفي
.أخبرتنا ماكينو-سان بكل شيء

232
00:18:09,570 --> 00:18:11,820
.قاتلت من أجلنا

233
00:18:15,540 --> 00:18:18,910
!لا تبكِ... إنّك رجل

234
00:18:18,910 --> 00:18:21,100
...ولكن يا شانكس

235
00:18:21,830 --> 00:18:24,120
!ذراعك

236
00:18:25,250 --> 00:18:27,870
.مجرّد ذراعٍ واحدة ثمن بخس

237
00:18:28,880 --> 00:18:30,240
...حمدًا على سلامتك

238
00:18:51,530 --> 00:18:52,610
ستغادرون إذًا؟

239
00:18:52,980 --> 00:18:56,960
.أجل. بقينا لوقت طويل
.ولكنّنا سنفترق الآن

240
00:18:56,960 --> 00:18:58,110
ستشعر بالوحدة، أليس كذلك؟

241
00:18:58,660 --> 00:19:03,330
أجل، سأكون وحيدًا... ولكنّني
.لن أطلب منك اصطحابي

242
00:19:03,330 --> 00:19:06,280
!قرّرت أن أصبح قرصانًا بنفسي

243
00:19:08,210 --> 00:19:10,140
!لم أكن لآخذك على أيّ حال

244
00:19:10,550 --> 00:19:13,340
!يستحيل أن تصبح قرصانًا

245
00:19:13,720 --> 00:19:14,580
!بل سأصبح

246
00:19:15,350 --> 00:19:18,540
،سأجمع رفقاء يضاهون هذا الطّاقم يومًا ما

247
00:19:18,900 --> 00:19:21,020
،وأجد أعظم كنز في العالم

248
00:19:21,220 --> 00:19:24,490
!وسأصبح ملك القراصنة حتمًا

249
00:19:25,730 --> 00:19:28,440
ستفوقنا إذًا؟

250
00:19:31,480 --> 00:19:32,310
...في هذه الحالة

251
00:19:35,190 --> 00:19:37,790
.سأأتمن هذه القبعة عندك

252
00:19:37,790 --> 00:19:39,910
.إنّها قبّعة غالية عليّ

253
00:19:40,590 --> 00:19:41,870
!اعتن بها

254
00:19:59,700 --> 00:20:01,360
،بعدها بعشر سنوات

255
00:20:01,360 --> 00:20:03,840
.بدأت إبحاري وصرتُ قرصانًا

256
00:20:05,100 --> 00:20:10,100
،كما حماني شانكس حينها
!سأحمي أصدقائي

257
00:20:19,200 --> 00:20:21,160
!كلاّ

258
00:20:26,170 --> 00:20:28,430
!انتظري فحسب يا روبين

259
00:20:43,190 --> 00:20:44,960
!أيّها الوغد

260
00:20:45,180 --> 00:20:47,020
!يا لتشوبّر مان المقيت ذاك

261
00:20:47,020 --> 00:20:50,300
لن أسمح له بإفساد خططي
!للسّيطرة على العالم بعد الآن

262
00:20:50,860 --> 00:20:53,240
!هذا هو الشّرّ بعينه، الدّكتور أوسودابا

263
00:20:53,240 --> 00:20:56,820
إنّه قائد عصابة أوسودابا الشّرّيرة
!ويخطّط للسّيطرة على العالم

264
00:20:56,820 --> 00:21:01,080
إنّه عالِم شرّير يصنع من الشّرّ
!أطيافًا ووحوشًا وآليّين... وأيّ شيء

265
00:21:01,080 --> 00:21:03,780
.أولئك خلفه هم بعض أتباعه

266
00:21:04,170 --> 00:21:08,040
سأستدرجه إلى قاعدتي وأنتظره
.هنا متأهّبًا لأضرب ضربتي

267
00:21:08,040 --> 00:21:11,300
!ثمّ سأسحقه بقوّة عصابتي القتاليّة الكاملة

268
00:21:11,740 --> 00:21:12,880
!هكذا

269
00:21:12,880 --> 00:21:14,490
...إنّ نقطة ضعفه

270
00:21:14,630 --> 00:21:16,430
!هذا صحيح، مساعدته ناميفيا

271
00:21:16,430 --> 00:21:18,050
!هذه المساعدة الجميلة ناميفيا

272
00:21:18,050 --> 00:21:20,890
.إنّها تدير مهمّات تشوبّر مان بكلّ براعة

273
00:21:21,310 --> 00:21:22,680
!هيّا يا رجال

274
00:21:22,680 --> 00:21:24,100
!أوّلاً، أحضروا لي رهينة

275
00:21:25,100 --> 00:21:26,540
!حالاً

276
00:21:26,990 --> 00:21:28,520
!أحضرنا رهينة

277
00:21:28,520 --> 00:21:29,220
!مرحبًا

278
00:21:29,220 --> 00:21:30,270
!أحضرتموه هو؟

279
00:21:30,520 --> 00:21:33,190
،هذا بطلنا المدافع عن العدالة
!تشوبّر مان

280
00:21:33,190 --> 00:21:37,670
إنّه يطير في الأرجاء بعباءة تشوبّر مان
!ويحارب من أجل سلام العالم

281
00:21:37,670 --> 00:21:38,790
!سلاحه هو ظرافته

282
00:21:40,410 --> 00:21:43,660
يستطيع إذابة قلب العدوّ
!بـ"بريق الظّرافة" خاصّته

283
00:21:43,660 --> 00:21:48,750
وإن لم ينجح ذلك، يستعمل
!عنف تشوبّر" لإبراح العدوّ ضربًا"

284
00:21:50,130 --> 00:21:51,260
.أريد شايًا

285
00:21:51,260 --> 00:21:53,490
!ما الّذي تفعله بالاسترخاء في قاعدتي؟

286
00:21:54,170 --> 00:21:57,090
!ماذا؟! ما ذلك الشّيء الضّخم في الحديقة؟

287
00:21:57,090 --> 00:21:59,870
!إنّه سلاحي السّرّيّ
!كفّ عن النّظر إليه أيّها الوغد

288
00:22:00,390 --> 00:22:01,580
هل يمكنني أن أحاول ركوبه؟

289
00:22:01,580 --> 00:22:02,550
.نعم، تفضّل

290
00:22:02,550 --> 00:22:04,890
!مهلاً! لماذا تصادق لوفيبومبر؟

291
00:22:05,430 --> 00:22:08,400
،هذا هو لوفيبومبر العملاق
.آليّ ضخم وسلاحهم السّرّيّ

292
00:22:08,400 --> 00:22:10,560
.إنّه آليّ ضخم يبلغ طوله 50 مترًا

293
00:22:10,560 --> 00:22:14,030
،عندما يركبه أوسودابا
.يصبح أسوأ وأقوى أعدائكم

294
00:22:14,030 --> 00:22:15,820
.الميزات الخاصّة: القدرة على الكلام

295
00:22:15,820 --> 00:22:17,860
!الشّخصيّة: يقوم بما يحلو له

296
00:22:30,080 --> 00:22:31,710
!هذا وحش كرة الأرزّ زوروكيلر

297
00:22:31,710 --> 00:22:33,750
،إن لم تمنحوه كرات أرزّ عندما يطلبها

298
00:22:33,750 --> 00:22:35,670
يغضب ويقول "أحضروا بعضها
"!من الآن فصاعدًا

299
00:22:36,010 --> 00:22:38,380
.هذه وحش الزّهور روبيفلورن
إنّها امرأة شرّيرة

300
00:22:38,380 --> 00:22:41,630
"هزمها تشوبّر مان بـ"بريق تشوبّر
.القاتل عدّة مرّات

301
00:22:41,720 --> 00:22:43,310
.هذا هو الوحش المنحرف سانجيروبس

302
00:22:43,310 --> 00:22:46,480
،إنّه يصرّ أنّه ليس منحرفًا
.لكن لا تشغل باله إلاّ الأشياء المنحرفة

303
00:22:46,480 --> 00:22:48,100
.لا يظهر أيّ رحمة للرّجال

304
00:22:48,650 --> 00:22:50,880
.إنّهم أشرار عصابة أوسودابا الثّلاثة

305
00:22:50,880 --> 00:22:52,560
...لكن لا علاقة لهم بهذه القصّة

306
00:22:52,690 --> 00:22:56,370
.وهكذا، تمّ القضاء على العصابة الشّرّيرة

307
00:22:56,370 --> 00:22:57,820
!هذا مذهل

308
00:22:57,820 --> 00:22:59,600
!أنت رائع يا لوفيبومبر

309
00:22:59,600 --> 00:23:00,610
!بالطّبع أنا رائع

310
00:23:03,700 --> 00:23:05,900
تشوبّر مان! ثمّة مشاكل في إحدى
!البلدات الشّرقيّة

311
00:23:06,160 --> 00:23:10,360
،حسنًا! سأتّجه إلى هناك راكبًا لوفيبومبر
!الآليّ الضّخم الّذي حصلت عليه ذلك اليوم

312
00:23:10,570 --> 00:23:11,450
!ليس هنا

313
00:23:11,450 --> 00:23:12,540
.لقد بعتُه

314
00:23:12,540 --> 00:23:13,240
!ماذا؟

315
00:23:13,240 --> 00:23:14,920
!انطلق! انطلق يا بطلنا تشوبّر مان

316
00:23:14,920 --> 00:23:17,000
!قاتل من أجل سلام العالم

317
00:23:25,570 --> 00:23:29,060
.لا-لا تقلقي يا روبين-كُن
.نحن هنا إلى جانبك

318
00:23:29,060 --> 00:23:32,100
.قالها وساقاه ترتجفان

319
00:23:32,100 --> 00:23:34,020
!أ-أنا أرتجف من الحماس

320
00:23:34,020 --> 00:23:37,900
فعلاً؟ حسنًا، لنسرع ونتولّى
!أمر رجال حكومة العالم هؤلاء

321
00:23:37,900 --> 00:23:40,570
!ثمّ سننقذ روبين-كُن بكلّ تأكيد

322
00:23:40,570 --> 00:23:42,200
:في الحلقة القادمة من وان بيس

323
00:23:42,200 --> 00:23:45,710
دروب الرّجال! تقنيات"
"!زورو وحلم أوسوبّ

324
00:23:45,710 --> 00:23:48,010
!ملك القراصنة، لن يكون إلاّ أنا

325
00:23:50,150 --> 00:23:55,160
نلقاكم في الحلقة القادمة