1
00:00:40,430 --> 00:00:45,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,520 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,190 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:59,030 --> 00:01:01,790
"وأقول "أريد أن أصير أقوى

5
00:01:01,950 --> 00:01:07,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,370 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,510 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,090 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,810
هيّا بنا

10
00:01:25,890 --> 00:01:29,110
دون توقّف

11
00:01:29,230 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,490 --> 00:01:39,910
سأواصل النّهوض على قدميّ

13
00:01:40,030 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,540 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,880 --> 00:01:56,010
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,390 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,390 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,810 --> 00:02:14,980
دون توقّف

21
00:02:15,110 --> 00:02:20,160
دون استسلام لمرور الوقت

22
00:02:20,280 --> 00:02:25,830
سأواصل النّهوض على قدميّ

23
00:02:26,000 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,590 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:34,000 --> 00:03:36,360
،بعد انفصال لوفي عن بقيّة طاقم قبّعة القشّ

38
00:03:36,360 --> 00:03:39,040
اندفع نحو مقرّ البحريّة لإنقاذ أخيه إيس

39
00:03:39,040 --> 00:03:40,120
!الّذي اقترب موعد إعدامه

40
00:03:41,490 --> 00:03:43,370
،أثناء ذلك في مارينفورد

41
00:03:44,170 --> 00:03:49,510
بدأت الحرب العظيمة بين قراصنة
!اللّحية البيضاء والبحريّة

42
00:03:52,200 --> 00:03:54,030
!جواهر ياساكاني المقدّسة

43
00:04:04,940 --> 00:04:08,520
...عرفتُ أنّك لن تسمح لي

44
00:04:09,140 --> 00:04:13,230
.بمهاجمة رأسك بسهولة

45
00:04:18,100 --> 00:04:19,150
!ما الّذي يفعله؟

46
00:04:20,550 --> 00:04:22,520
!أوقفوا هذا إن استطعتم

47
00:04:28,050 --> 00:04:30,500
...إن تركنا أماكننا نحن الثّلاثة

48
00:04:33,470 --> 00:04:35,840
!فمن سيشغلها؟

49
00:04:38,240 --> 00:04:39,670
!الثّوران العظيم

50
00:04:47,410 --> 00:04:48,970
!ابتعدوا

51
00:04:57,440 --> 00:04:59,740
.أضاء المكان بضوء أسطع

52
00:05:15,100 --> 00:05:19,340
لماذا لا تضيء كعك حفلات الميلاد
!بدل هذا يا شقيّ الحمم

53
00:05:24,020 --> 00:05:28,000
ألا تريد لجنازتك أن تكون مضاءة أيّها اللّحية البيضاء؟

54
00:05:32,170 --> 00:05:36,490
"!سليل الوحش! تقدّم ليتل أورز جونيور بأقصى سرعة"

55
00:06:00,510 --> 00:06:04,170
لم أكن أعرف بوجود رجال ضخام
.لهذا الحدّ في هذا العالم

56
00:06:04,300 --> 00:06:06,800
!إنّه وحش حقيقيّ

57
00:06:16,800 --> 00:06:19,560
،إن استطعت وضع يدي على جثّته

58
00:06:19,560 --> 00:06:23,240
!فسيعني ذلك أنّ بإمكاني الحصول على الزّومبي الأقوى ثانية

59
00:06:42,310 --> 00:06:43,790
!انطلقوا نحو المنصّة بسرعة

60
00:06:44,780 --> 00:06:47,320
!بدأت وحدة العمالقة تحرّكها

61
00:06:59,030 --> 00:07:00,470
!لا تخافوا

62
00:07:07,950 --> 00:07:10,200
!يسعون جميعًا خلف ليتل أورز جونيور

63
00:07:13,610 --> 00:07:15,600
...إنّ إيقافه

64
00:07:15,600 --> 00:07:17,250
!من واجبنا

65
00:07:23,750 --> 00:07:25,590
...إنّه ضخم بشكل لا يُصدّق

66
00:07:26,020 --> 00:07:28,640
!حجمه أكثر من ضعفي حجم العملاق العاديّ

67
00:07:28,640 --> 00:07:30,130
!واصلوا الإطلاق

68
00:07:30,130 --> 00:07:33,170
!ما زال بشريًّا، لذلك سيجدي هذا نفعًا ضدّه

69
00:07:45,490 --> 00:07:48,570
.أحضروا معهم مخلوقًا لا نظير لقوّته مثله

70
00:07:51,260 --> 00:07:53,300
!أطلقوا عليه! أطلقوا

71
00:07:55,480 --> 00:07:57,470
!أورز، كلاّ

72
00:07:57,470 --> 00:08:00,670
!أنت هدف سهل بسبب ضخامة حجمك

73
00:08:00,870 --> 00:08:02,660
!إيس-كُن

74
00:08:09,320 --> 00:08:13,050
!ها أنا قادم

75
00:08:22,560 --> 00:08:23,850
!هذا سيّئ

76
00:08:24,180 --> 00:08:25,320
!أوقفوه

77
00:08:40,670 --> 00:08:43,830
!فتح لنا أورز ثغرة لندخل الخليج

78
00:08:46,880 --> 00:08:49,190
!اغزوا الخليج

79
00:08:57,830 --> 00:09:00,770
!تبًّا! تراجعوا وعزّزوا خطّ الدّفاع

80
00:09:00,770 --> 00:09:02,480
!لا تسمحوا لهم بدخول السّاحة

81
00:09:47,600 --> 00:09:50,150
!إ-إلى أين علينا الهرب؟

82
00:09:51,110 --> 00:09:52,310
!تراجع يا جنديّ البحريّة

83
00:09:55,910 --> 00:09:58,010
!لا تعترض طريقي

84
00:09:59,680 --> 00:10:02,360
!اللّواء البحريّ يوكيمورا، قاتل الألف رجل

85
00:10:02,780 --> 00:10:05,180
ما الّذي تفعله؟

86
00:10:06,120 --> 00:10:09,670
!نحن في ساحة معركة
!لا فائدة لنا ممّن ليسوا مستعدّين

87
00:10:23,370 --> 00:10:26,470
!أنا عاجز

88
00:10:40,870 --> 00:10:42,250
!ولا أنا

89
00:10:42,560 --> 00:10:46,960
!عليّ بلوغ إيس-كُن

90
00:10:47,320 --> 00:10:49,250
!لا تقفوا في طريقي

91
00:10:50,710 --> 00:10:52,540
!لن أسمح لك بالتّقدّم أكثر

92
00:11:20,440 --> 00:11:22,160
!يا نائب الأميرال لاكروا

93
00:11:25,740 --> 00:11:28,550
.أورز، إنّه لا يتغيّر أبدًا

94
00:11:29,370 --> 00:11:32,000
!لا يسعى الشّجعان للموت

95
00:11:32,740 --> 00:11:36,390
!لا توقفني يا والدي

96
00:11:36,800 --> 00:11:39,720
!أريد إنقاذه فحسب

97
00:11:40,180 --> 00:11:45,390
!أريد إنقاذ إيس-كُن بأسرع ما يمكن

98
00:11:46,290 --> 00:11:48,240
.أعلم ذلك

99
00:11:48,730 --> 00:11:51,890
!ساعدوه جميعًا

100
00:11:52,150 --> 00:11:54,060
!احموا أورز

101
00:11:59,260 --> 00:12:02,740
!كيف لنا أن ندافع في مواجهة شخص بهذه الضّخامة؟

102
00:12:08,990 --> 00:12:11,970
!قطعتَ نائب الأميرال لاكروا

103
00:12:26,900 --> 00:12:30,140
!لا يمكن مهاجمته فُرادى! علينا أن نقوم بذلك معًا

104
00:12:32,890 --> 00:12:36,900
،بينما يشتّت أورز انتباهكم
!فسنقوم بخطوتنا ضدّكم

105
00:12:43,880 --> 00:12:45,450
!سهم الاستعباد

106
00:12:55,450 --> 00:12:57,630
!يا-يا رفاق

107
00:12:58,390 --> 00:12:59,840
!أنت الإمبراطورة القرصانة إذًا

108
00:13:05,670 --> 00:13:08,140
!جسدي... يتفتّت

109
00:13:08,560 --> 00:13:10,400
!السّاق العطِرة

110
00:13:25,240 --> 00:13:28,530
!حقيرة! تهاجمين جنود البحريّة أيضًا

111
00:13:28,730 --> 00:13:32,040
...وافقت على القتال ضدّ اللّحية البيضاء

112
00:13:32,650 --> 00:13:35,830
.لكنّني لم أقل أنّني سأصير جزءًا منكم

113
00:13:36,650 --> 00:13:39,460
.سواء كانوا حلفاء أو أعداء... كلّ الرّجال سواسية

114
00:13:40,700 --> 00:13:42,360
.فيما عداه هو

115
00:13:44,380 --> 00:13:47,640
."يمكنني القول... "وفيت بوعدي

116
00:13:47,640 --> 00:13:48,890
!ماذا؟

117
00:13:52,760 --> 00:13:55,260
.ارحم جمالي

118
00:13:55,950 --> 00:13:58,640
!أ-أنت

119
00:14:09,460 --> 00:14:11,250
!إيس-كُن

120
00:14:15,560 --> 00:14:17,810
!تعال! تعال بسرعة

121
00:14:22,470 --> 00:14:23,790
!أورز

122
00:14:58,410 --> 00:14:59,570
!أنت

123
00:15:25,000 --> 00:15:27,540
!سأنقذك الآن

124
00:15:28,340 --> 00:15:29,510
...أورز

125
00:15:45,210 --> 00:15:47,140
!إيس-كُن

126
00:16:18,600 --> 00:16:20,420
.صدمة الدّبّ

127
00:17:19,460 --> 00:17:21,350
!أورز

128
00:17:27,940 --> 00:17:30,600
!هذا يكفي! توقّف

129
00:17:31,600 --> 00:17:33,370
!لا يمكنك الوصول إليّ

130
00:17:49,600 --> 00:17:50,860
!اسمع يا أورز

131
00:17:54,750 --> 00:17:57,590
...كنتُ أتساءل

132
00:17:59,210 --> 00:18:00,680
ألا تشعر بالحرّ؟

133
00:18:02,270 --> 00:18:04,170
.لأنّك أقرب إلى الشّمس

134
00:18:08,760 --> 00:18:09,940
.أشعر بالحرّ فعلاً

135
00:18:10,800 --> 00:18:11,750
.فهمت

136
00:18:12,190 --> 00:18:15,560
.سيكون من اللّطيف لو كانت هنالك ظلال

137
00:18:17,240 --> 00:18:19,110
!أيها القبطان أورز

138
00:18:24,070 --> 00:18:25,980
أما زال قادرًا على الحركة؟

139
00:18:27,470 --> 00:18:28,870
!هذا رائع

140
00:18:28,870 --> 00:18:30,920
!إنّه يملك صلابة سلفه

141
00:18:31,970 --> 00:18:33,260
ما هذه؟

142
00:18:37,660 --> 00:18:40,510
.تعلّمت كيف أصنعها في بلاد وانو

143
00:18:41,390 --> 00:18:42,580
.جرّبها

144
00:18:44,710 --> 00:18:47,420
.أفسد إيس-سان اثنتان من قبلها

145
00:18:47,420 --> 00:18:48,780
!لقد أحرقهما

146
00:18:48,780 --> 00:18:52,150
!بما أنّ جسده من النّار، فلا يجب عليه التّعامل بالقشّ

147
00:18:56,220 --> 00:18:58,620
!الجوّ أبرد تحتها

148
00:18:59,390 --> 00:19:01,440
.فعلاً؟ أسعدني هذا

149
00:19:11,740 --> 00:19:13,740
!أطلقوا على أورز

150
00:19:24,240 --> 00:19:25,450
!أورز

151
00:19:25,870 --> 00:19:28,850
!ما كان عليه الوقوف ثانية! إنّه هدف سهل

152
00:19:36,450 --> 00:19:40,200
أيّها القبطان أورز! لماذا أنت في الخارج؟

153
00:19:43,130 --> 00:19:45,090
.لا أتبلّل من المطر

154
00:19:46,280 --> 00:19:48,220
!إنّها متينة

155
00:19:48,580 --> 00:19:50,460
!أحببتها

156
00:19:59,840 --> 00:20:03,470
!ما زلت... لا أستطيع الوصول إليه

157
00:20:11,200 --> 00:20:12,560
...إن أمكنني

158
00:20:13,760 --> 00:20:17,490
!الإطاحة بأحد الشّيتشيبوكاي على الأقلّ

159
00:20:37,290 --> 00:20:39,940
ما الخطب أيّها الوحش؟

160
00:20:40,290 --> 00:20:41,710
...قدمي

161
00:20:42,970 --> 00:20:44,220
!أيّها القبطان

162
00:20:45,460 --> 00:20:48,450
أيّها القبطان، لماذا أنت في الخارج ثانية؟

163
00:20:49,090 --> 00:20:52,670
.لا ينزل الثّلج على رأسي

164
00:20:53,520 --> 00:20:55,530
!لا أشعر بالبرد

165
00:20:56,740 --> 00:20:58,980
!أحبّها كثيرًا

166
00:21:01,740 --> 00:21:03,240
...شكرًا لك يا إيس

167
00:21:13,130 --> 00:21:14,880
!كم هذا ممتع

168
00:21:20,010 --> 00:21:21,960
!أورز

169
00:21:40,660 --> 00:21:42,490
!لا-لا بدّ أنّه وحش

170
00:21:45,700 --> 00:21:47,700
!لقد خطا على السّاحة

171
00:21:56,510 --> 00:21:59,210
...القليل فحسب

172
00:22:02,960 --> 00:22:07,680
!القليل فحسب وأصل لإيس-كُن

173
00:22:14,280 --> 00:22:16,230
!تبًّا لك يا دوفلامينغو

174
00:22:16,230 --> 00:22:18,520
!لقد بتر ساقه

175
00:22:18,520 --> 00:22:21,020
!سبق وطالبت بجثّته لي

176
00:22:21,270 --> 00:22:22,700
!رجل الظّلّ

177
00:22:24,590 --> 00:22:26,080
!نالي منه

178
00:22:26,500 --> 00:22:27,780
!سيف سحليّة الظّلال

179
00:22:30,340 --> 00:22:32,360
!أورز

180
00:22:50,820 --> 00:22:54,270
...سوف... أنقذك الآن

181
00:23:16,960 --> 00:23:19,100
!يا إيس-كُن

182
00:23:25,360 --> 00:23:28,560
.ضحّى أورز بحياته ليفتح الطّريق للبقيّة

183
00:23:29,090 --> 00:23:32,100
،يندفع قراصنة اللّحية البيضاء نحو المنصّة

184
00:23:32,470 --> 00:23:36,100
لكن عندما يبدو وكأنّ بإمكانهم
،إنقاذ إيس من الإعدام

185
00:23:36,270 --> 00:23:39,370
.نجد سنغوكو وهو يجهّز خطّة جديدة

186
00:23:39,640 --> 00:23:41,140
:في الحلقة القادمة من وان بيس

187
00:23:41,140 --> 00:23:45,020
"!العدالة لمن ينتصر! بدء العمل باستراتيجيّة سنغوكو"

188
00:23:45,020 --> 00:23:47,230
!ملك القراصنة، لن يكون إلاّ أنا

189
00:23:49,990 --> 00:23:54,990
!!نلقاكم في الحلقة القادمة