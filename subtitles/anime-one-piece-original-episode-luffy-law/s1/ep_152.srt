1
00:00:22,250 --> 00:00:25,280
!العالم... نعم

2
00:00:25,820 --> 00:00:27,480
...اسعوا نحو الحرّيّة

3
00:00:27,480 --> 00:00:31,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,360 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:05,450 --> 00:02:08,050
!أعد ذهب العمّ ذو الرّأس الماسيّ

22
00:02:08,050 --> 00:02:09,550
ذهب؟

23
00:02:10,750 --> 00:02:14,020
تقصد أغراض العجوز كريكت؟

24
00:02:26,140 --> 00:02:27,900
!الوداع يا قبّعة القشّ

25
00:02:50,830 --> 00:02:54,160
!ما الخطب؟! يا قبّعة القشّ
!إلى أين أنت ذاهب؟

26
00:02:55,770 --> 00:02:56,800
إلى أين؟

27
00:03:01,170 --> 00:03:01,970
!السّماء

28
00:03:06,410 --> 00:03:10,350
!الانطلاق نحو السّماء"
".ركوب تيّار المحيط الصّاعد

29
00:03:18,260 --> 00:03:21,830
!أين هو؟! حلّ الصّباح بالفعل؟

30
00:03:22,560 --> 00:03:27,660
تجاوزنا الموعد المحدّد بأكثر
!من 46 دقيقة! سيفوتنا التّيّار

31
00:03:27,660 --> 00:03:31,800
سيحتاج وقتًا أطول للعودة
!لأنّه يحمل كلّ ذلك الذّهب الآن

32
00:03:31,800 --> 00:03:35,010
!أنا واثقة أنّه لم يأخذ ذلك في حسبانه

33
00:03:35,010 --> 00:03:38,310
لا، لا أعتقد أنّه أخذ الوقت
.في الحسبان على الإطلاق

34
00:03:38,310 --> 00:03:39,810
.نعم، متأكّد من ذلك 200 بالمائة

35
00:03:40,080 --> 00:03:42,580
هل تعتقدون أنّه هُزم في البلدة؟

36
00:03:42,950 --> 00:03:44,680
!على يد بيلامي ذاك؟

37
00:03:44,680 --> 00:03:47,550
إن هُزم، فسيدفع ثمنًا باهظًا
!حتّى إن عاد في الوقت المناسب

38
00:03:48,190 --> 00:03:50,020
...ذلك متوقّع منك

39
00:03:53,760 --> 00:03:56,790
!مرحبًا

40
00:04:00,760 --> 00:04:03,570
!هذا هو! هذا جيّد! لقد عاد

41
00:04:03,570 --> 00:04:05,440
!وجدتها

42
00:04:05,440 --> 00:04:08,840
!لوفي! أسرع! لقد تأخّرنا

43
00:04:08,840 --> 00:04:10,370
!انظروا

44
00:04:10,370 --> 00:04:14,410
!خنفساء هرقل! بحثتُ عنها طويلاً

45
00:04:14,410 --> 00:04:15,780
...كنتَ تبحث

46
00:04:15,780 --> 00:04:17,180
!عن خنفساء؟

47
00:04:25,720 --> 00:04:28,090
!ماذا؟! مذهل

48
00:04:28,090 --> 00:04:30,930
!إنّه النّموذج الطّائر لغوينغ ميري

49
00:04:30,930 --> 00:04:32,830
!يبدو أنّها قادرة على الطّيران

50
00:04:32,830 --> 00:04:36,300
!أليس كذلك؟! فعلوا ذلك من أجلنا

51
00:04:40,800 --> 00:04:42,040
.انظروا إليهم

52
00:04:42,040 --> 00:04:44,610
...رؤيتهم تجعلني أشعر بعدم الرّاحة

53
00:04:44,610 --> 00:04:45,710
.أوافقك

54
00:04:46,340 --> 00:04:50,010
حتّى الحمامة كانت لتبدو
...أفضل من الدّجاجة

55
00:04:50,010 --> 00:04:52,850
!تلك ليست المشكلة هنا
!أنت غبيّ

56
00:04:53,080 --> 00:04:56,520
!حسنًا! لنبحر! أمستعدّون يا رجال؟

57
00:04:56,520 --> 00:04:57,790
!نعم، نعم يا سيّدي

58
00:05:14,400 --> 00:05:17,110
!اصعدوا للسّفينة بسرعة! الوقت يداهمكم

59
00:05:17,110 --> 00:05:21,110
هل تنوون إضاعة فرصتكم
بالذّهاب للسّماء أيّها الحمقى؟

60
00:05:21,450 --> 00:05:23,480
!صحيح! شكرًا على السّفينة

61
00:05:27,350 --> 00:05:29,150
.عليك أن تشكرهم هم

62
00:05:35,360 --> 00:05:37,830
!نعم! شكرًا يا رفاق

63
00:05:38,100 --> 00:05:40,300
!بإمكانكم الاحتفاظ بخنفساء هرقل خاصّتي

64
00:05:40,700 --> 00:05:44,770
!فعلاً؟! هل أنت جادّ؟! يمكننا ذلك؟

65
00:05:44,770 --> 00:05:47,170
!أنت شخص طيّب

66
00:05:47,170 --> 00:05:50,470
!على أيّ حال، علينا الإسراع
!اصعدوا على السّفينة قبل فوات الأوان

67
00:05:50,470 --> 00:05:53,280
!سنسبقكم وأنتم ستتبعوننا

68
00:05:53,640 --> 00:05:55,280
!أسرع يا لوفي

69
00:05:55,280 --> 00:05:56,110
!حاضر

70
00:06:02,750 --> 00:06:07,190
مدينة الذّهب" هذه مجرّد"
!ضرب من خيال نولاند

71
00:06:09,090 --> 00:06:12,130
!عليك أن تدرك أنّ الأحلام لا تتحقّق أبدًا

72
00:06:21,670 --> 00:06:23,470
!يا تحالف ساروياما

73
00:06:26,640 --> 00:06:28,410
!الإخفاق ليس خيارًا الآن

74
00:06:28,880 --> 00:06:33,680
!ابذلوا كلّ ما لديكم مهما حدث

75
00:06:33,680 --> 00:06:35,750
!أجل

76
00:06:38,390 --> 00:06:39,790
!حسنًا! لننطلق

77
00:06:43,860 --> 00:06:45,400
!حان وقت الإبحار يا رفاق

78
00:06:45,400 --> 00:06:46,360
!أجل

79
00:06:46,360 --> 00:06:48,200
!حاضر يا نامي-سان

80
00:07:00,410 --> 00:07:03,850
!أيّها الفتى! هنا ستفترق طرقنا

81
00:07:04,820 --> 00:07:05,880
!نعم

82
00:07:06,650 --> 00:07:10,320
.هنالك حقيقة مؤكّدة واحدة

83
00:07:11,490 --> 00:07:17,860
لم يسبق لأيّ أحد في التّاريخ إثبات عدم
!وجود مدينة الذّهب أو جزيرة السّماء

84
00:07:18,160 --> 00:07:18,800
!نعم

85
00:07:20,230 --> 00:07:25,970
ربّما يضحك النّاس ويصفون الأمر بمنطق
!أحمق، لكنّ ذلك كافٍ بالنّسبة لي

86
00:07:25,970 --> 00:07:28,610
!لكنّ ذلك هو ما تعنيه الرّومانسيّة

87
00:07:28,610 --> 00:07:29,940
...الرّومانسيّة

88
00:07:32,380 --> 00:07:33,640
!هذا صحيح

89
00:07:37,610 --> 00:07:40,750
.وشكرًا على الذّهب

90
00:07:42,150 --> 00:07:45,460
!إيّاكم أن تسقطوا من السّماء، مفهوم؟

91
00:07:47,890 --> 00:07:49,790
!إلى اللّقاء أيّها العمّ

92
00:07:49,790 --> 00:07:52,400
!شكرًا على كلّ شيء يا كريكت-سان

93
00:07:52,600 --> 00:07:56,830
!أنا واثق أنّ مدينة الذّهب حقيقيّة أيّها العجوز

94
00:07:57,200 --> 00:08:00,140
!أيّها العمّ! لا تضغط على نفسك

95
00:08:00,440 --> 00:08:02,610
!اهتمّ بشؤونك الخاصّة

96
00:08:10,150 --> 00:08:12,320
!حلّ الصّباح بالفعل

97
00:08:12,750 --> 00:08:15,120
حسنًا، هل ترون أيّ شيء؟

98
00:08:15,690 --> 00:08:18,520
لا أستطيع حتّى رؤية أفق
!الشّاطئ المقابل لنا بعد

99
00:08:18,520 --> 00:08:21,590
هل هم ذاهبون لجزيرة السّماء بالفعل؟

100
00:08:22,260 --> 00:08:23,930
.نعم، ذلك ما قالوه

101
00:08:24,260 --> 00:08:28,430
،سيكون من الصّعب اللّحاق بهم
.لذلك علينا الاهتمام بأمرهم قبل ذلك

102
00:08:28,870 --> 00:08:33,840
قبّعة القشّ لوفي... مكافأة
...بقيمة 100 مليون بيري

103
00:08:34,910 --> 00:08:38,410
!حسنًا! إنّها السّابعة صباحًا

104
00:08:38,410 --> 00:08:42,950
!يجدر بنا أن نصل لوجهتنا حوالي الحادية عشر

105
00:08:42,950 --> 00:08:47,450
كما قال العجوز، إنّ المكان الّذي
ينطلق منه تيّار المحيط الصّاعد

106
00:08:47,450 --> 00:08:54,390
يتغيّر في كلّ مرّة، لذلك علينا
!الوصول قبل ذلك وإيجاده

107
00:08:54,860 --> 00:08:56,190
!انظرا! انظرا

108
00:08:56,730 --> 00:08:59,900
...نحن متأخّرون قليلاً، لذلك

109
00:08:59,900 --> 00:09:02,700
!أنتم! هل تستمعون إلى شرحي؟

110
00:09:03,430 --> 00:09:05,500
!أرأيتما؟ لقد نظر للأمام

111
00:09:06,940 --> 00:09:09,770
!هنالك طيور غريبة بالفعل في هذا العالم

112
00:09:10,140 --> 00:09:15,050
!صحيح! بإمكانه النّظر للجنوب فقط
!إنّه يشبه بوصلة! هذا ممتع

113
00:09:19,650 --> 00:09:20,550
ما الّذي قاله؟

114
00:09:21,020 --> 00:09:24,550
.قال أنّه سينظر لاتّجاه مختلف لإرباكنا

115
00:09:26,260 --> 00:09:27,490
!لماذا لا تحاول؟

116
00:09:30,760 --> 00:09:32,900
!مهلاً! إنّه ينظر للشّمال

117
00:09:40,970 --> 00:09:43,270
!لا يشعر بارتياح إلاّ إن نظر إلى الجنوب

118
00:09:43,270 --> 00:09:48,410
!أنتم! لا تغضبوا الزّعيم الكبير

119
00:09:49,250 --> 00:09:54,890
!لا بأس! إنّ عفويّتهم تُحمّسني

120
00:09:55,220 --> 00:09:56,890
!ماذا؟ ماذا هنالك؟

121
00:09:57,990 --> 00:10:01,020
!لا داعي للشّعور بالقلق

122
00:10:01,860 --> 00:10:03,560
!لنستمتع بوقتنا

123
00:10:03,560 --> 00:10:05,860
من سبب تأخّرنا؟

124
00:10:06,260 --> 00:10:11,440
إنّه محقّ! لا فائدة من الشّعور
!بالتّوتّر طوال هذه السّاعات

125
00:10:11,670 --> 00:10:16,440
!فهمت! حسنًا يا رجال
!انطلقوا بأقصى سرعة... وبارتياح

126
00:10:19,240 --> 00:10:21,750
!يا له من طقس جميل

127
00:10:24,880 --> 00:10:26,380
!هل سنكون بخير؟

128
00:10:29,590 --> 00:10:32,120
!ماذا؟! ما هذا؟

129
00:10:33,160 --> 00:10:36,090
!السّماء... مظلمة

130
00:10:36,490 --> 00:10:38,360
!أخبار سيّئة يا زعيم

131
00:10:38,360 --> 00:10:39,400
!ما الخطب؟

132
00:10:39,400 --> 00:10:42,800
!يحلّ اللّيل في الجنوب الغربيّ
!إنّها السّحب الملكيّة

133
00:10:43,100 --> 00:10:45,300
!فعلاً؟! ما الوقت الآن؟

134
00:10:45,300 --> 00:10:48,340
!إنّها العاشرة! هذا أبكر ممّا توقّعنا

135
00:10:48,340 --> 00:10:50,840
!هذا سيّئ... شوجو
!أيمكننا الوصول في الوقت؟

136
00:10:50,840 --> 00:10:54,810
!إلى البحر في الحال يا غطّاسي أوتان
!ابحثوا عن التّيّار

137
00:10:57,910 --> 00:10:59,650
!هذه هي السّحب الملكيّة؟

138
00:11:00,380 --> 00:11:01,990
!ماذا الآن؟

139
00:11:03,390 --> 00:11:06,090
!ظهرت أبكر ممّا توقّعنا

140
00:11:06,090 --> 00:11:08,260
!لكنّنا لا نعرف حتّى مكان التّيّار

141
00:11:16,200 --> 00:11:17,630
!تمّ كشف تردّدات صوتيّة

142
00:11:17,630 --> 00:11:20,300
!ثمّة تيّار ضخم أمامنا مباشرةً

143
00:11:20,300 --> 00:11:24,270
مخلوقات ضخمة غربنا
!مباشرةً! يبدو أنّها ملوك بحر

144
00:11:25,040 --> 00:11:28,310
ثمّة موجات عكس التّيّار
!في اتّجاه السّاعة العاشرة

145
00:11:28,310 --> 00:11:30,350
!أعتقد أنّها دوّامة ضخمة

146
00:11:30,350 --> 00:11:33,780
!هذا هو! اسلكوا اتّجاه السّاعة العاشرة

147
00:11:33,780 --> 00:11:37,520
!إنّها إشارة على الانفجار
!اتّجهوا نحو الدّوّامة ولا تتراجعوا

148
00:11:42,260 --> 00:11:43,490
!ما الّذي...؟

149
00:11:43,490 --> 00:11:45,230
!أصبحت الأمواج أعلى فجأة

150
00:11:45,230 --> 00:11:46,760
!سوف نغرق

151
00:11:48,730 --> 00:11:51,740
!إنّه زلزال يسبق الانفجار! استعدّوا

152
00:11:51,740 --> 00:11:53,170
!ا-انفجار؟

153
00:11:53,740 --> 00:11:54,670
!أيّتها الملاّحة

154
00:11:55,370 --> 00:11:56,840
إلام تشير البوصلة المسجِّلة؟

155
00:11:59,780 --> 00:12:01,450
!إنّها تشير لتلك السّحب

156
00:12:02,580 --> 00:12:05,150
!هل جزيرة السّماء هناك؟

157
00:12:05,780 --> 00:12:07,420
!اتّجاه الرّياح مثاليّ أيضًا

158
00:12:07,420 --> 00:12:10,120
إنّ السّحب متّجهة مباشرة
!إلى مركز الدّوّامة

159
00:12:10,450 --> 00:12:13,560
مهلاً، ما هذه "الدّوّامة"؟
...أنا لا أرى شيئًا

160
00:12:14,260 --> 00:12:17,360
!يبدو أنّنا أصبنا الهدف هذه المرّة يا أخي

161
00:12:17,360 --> 00:12:20,830
نعم! ويبدو أنّه سيكون
!انفجارًا ذا حجم جيّد أيضًا

162
00:12:20,830 --> 00:12:22,170
!بإمكاننا الذّهاب؟

163
00:12:22,170 --> 00:12:23,630
!نعم، بإمكاننا

164
00:12:25,700 --> 00:12:26,440
ماذا؟

165
00:12:26,770 --> 00:12:28,740
!سنأخذكم إلى الحافّة الدّاخليّة للدّوّامة

166
00:12:29,240 --> 00:12:31,210
!ماذا نفعل بعد ذلك؟

167
00:12:31,210 --> 00:12:35,550
،اركبوا التّيّار! إن وصلتم إلى المركز
!فستسير الأمور كما يجب

168
00:12:36,980 --> 00:12:38,980
!مركز هذه الدّوّامة الضّخمة؟

169
00:12:59,670 --> 00:13:03,540
.لم أقابل حمقى مثلكم من قبل

170
00:13:04,470 --> 00:13:06,840
!أريد الذّهاب لجزيرة السّماء أيّها العمّ

171
00:13:07,170 --> 00:13:09,640
!الذّهب... لقد سُرق

172
00:13:10,310 --> 00:13:12,010
.سأعود في الصّباح

173
00:13:14,080 --> 00:13:15,820
!إلى اللّقاء أيّها العمّ

174
00:13:19,950 --> 00:13:22,490
...لا يكفّون عن الحديث عن الأحلام

175
00:13:22,860 --> 00:13:26,030
!إنّها تسحبنا

176
00:13:29,730 --> 00:13:32,070
!لم يذكر أيّ أحد أيّ شيء عن دوّامة

177
00:13:32,430 --> 00:13:35,540
!لا بأس! سأحميك أنت وروبين-تشان

178
00:13:36,370 --> 00:13:38,210
...لم أرَ دوّامة ضخمة كهذه من قبل

179
00:13:41,140 --> 00:13:44,510
!هذا سيّئ! لنعد أدراجنا! دعوني أعود

180
00:13:44,510 --> 00:13:47,850
!اقبل الأمر فحسب يا أوسوبّ! فات الأوان
!فهنالك من هو متحمّس سلفًا

181
00:13:48,250 --> 00:13:50,580
!لنذهب إلى جزيرة السّماء

182
00:14:21,780 --> 00:14:27,390
!حسنًا يا رفاق
!الباقي منوط بكم أنتم الآن

183
00:14:27,390 --> 00:14:30,060
!حسنًا! شكرًا على مرافقتنا

184
00:14:30,060 --> 00:14:31,130
!مهلاً

185
00:14:31,130 --> 00:14:34,860
!على مهلكم! أنا خائف

186
00:14:34,860 --> 00:14:36,730
!دعني أعود أيّها الوغد

187
00:14:36,730 --> 00:14:38,630
!هذا الشّيء سيقتلنا في الحال

188
00:14:38,630 --> 00:14:42,470
!لم يخبرنا أحد عن دوّامة عملاقة
!لقد خدعتمونا

189
00:14:42,470 --> 00:14:43,540
!حلّ اللّيل

190
00:14:43,900 --> 00:14:46,970
!الدّوّامة تسحبنا إليها

191
00:14:47,410 --> 00:14:50,510
!لنعد يا لوفي! ما زال بإمكاننا ذلك

192
00:14:50,510 --> 00:14:54,310
!أليس الأمر واضحًا؟
!هذه الدّوّامة وحدها كفيلة بقتلنا

193
00:14:54,310 --> 00:14:56,320
!جزيرة السّماء مجرّد حلم في حلم

194
00:14:56,320 --> 00:14:58,620
حلم في حلم؟ أهذا ما تظنّ؟

195
00:14:58,620 --> 00:15:01,960
!نعم يا لوفي! لا أعتقد أنّ بإمكاننا ذلك أيضًا

196
00:15:02,320 --> 00:15:04,360
!جزيرة في حلم في حلم

197
00:15:04,360 --> 00:15:08,230
سأندم طوال حياتي إن فوّتّ
!مغامرة كبيرة كهذه

198
00:15:08,860 --> 00:15:11,830
...إ-إنّه يستمتع بهذا

199
00:15:15,800 --> 00:15:18,740
أنتم! بينما تعارضون الأمر
...بدون فائدة

200
00:15:18,740 --> 00:15:19,840
ماذا هنالك؟

201
00:15:23,180 --> 00:15:25,080
!تسحبنا الدّوّامة إلى داخلها

202
00:15:27,550 --> 00:15:30,820
!بسرعة يا نامي-سان! تعالي لذراعيّ

203
00:15:34,050 --> 00:15:35,690
!نحن نسقط

204
00:15:38,830 --> 00:15:41,360
!ماذا؟! إنّها تختفي؟! كيف ذلك؟

205
00:15:41,360 --> 00:15:42,400
!ماذا حدث؟

206
00:15:43,060 --> 00:15:47,300
!كـ-كانت تلك الدّوّامة ضخمة أيضًا
!ما الّذي يحدث؟

207
00:15:53,140 --> 00:15:56,780
!كلاّ! بدأ الأمر سلفًا

208
00:15:58,480 --> 00:16:01,250
!اختفت الدّوّامة من السّطح فحسب

209
00:16:02,820 --> 00:16:05,750
...تـ... تقصدين

210
00:16:06,050 --> 00:16:08,390
!مهلاً

211
00:16:11,290 --> 00:16:12,130
!يا زورو

212
00:16:12,930 --> 00:16:13,760
!انظر

213
00:16:21,570 --> 00:16:26,070
!لحقت بك يا قبّعة القشّ لوفي

214
00:16:26,610 --> 00:16:28,680
!...إنّه ذلك الرّجل من موكتاون

215
00:16:30,780 --> 00:16:31,750
!من؟

216
00:16:32,000 --> 00:16:36,720
أنا هنا للحصول على مكافأة المائة
!مليون الّتي على رأسك! استعدّ

217
00:16:41,960 --> 00:16:44,760
من يكونون؟ أصدقاء؟

218
00:16:45,560 --> 00:16:47,430
.لا أدري

219
00:16:51,600 --> 00:16:53,200
لماذا حلّ الظّلام هنا؟

220
00:16:53,430 --> 00:16:56,340
مكافأتي؟ ماذا تعني بمائة مليون؟

221
00:16:56,640 --> 00:16:58,710
!إذًا فأنت لا تعرف

222
00:16:59,370 --> 00:17:03,580
!هنالك مكافأة مائة مليون على رأسك

223
00:17:04,040 --> 00:17:08,380
ومكافأة صائد القراصنة زورو
!هي ستّون مليون بيري

224
00:17:08,680 --> 00:17:11,490
!ذلك صحيح! لديه ملصقات مطلوبين جديدة

225
00:17:11,490 --> 00:17:14,560
!زورو! على رأسك مكافأة الآن

226
00:17:14,560 --> 00:17:18,760
!ماذا؟! تمهّل! ماذا عنّي؟
!هنالك واحدة لي أيضًا، صحيح؟

227
00:17:19,890 --> 00:17:20,330
.لا

228
00:17:20,630 --> 00:17:21,760
!انظر جيّدًا

229
00:17:22,530 --> 00:17:23,260
.لا

230
00:17:25,530 --> 00:17:29,400
فهمت! ارتفعت مكافأتك كثيرًا
!بعد حادثة أراباستا

231
00:17:29,400 --> 00:17:31,110
...لكن مائة مليون

232
00:17:32,840 --> 00:17:36,880
!مائة مليون! أسمعتَ ذلك؟
!مكافأتي مائة مليون

233
00:17:36,880 --> 00:17:39,210
!ستّون مليون فقط؟ هذا محبط

234
00:17:39,210 --> 00:17:41,120
!لا تفرحا بهذا

235
00:17:42,350 --> 00:17:45,650
!يا رفاق! لا تدعوهم يشتّتون انتباهكم

236
00:17:49,520 --> 00:17:53,590
!إنّه قادم! تيّار المحيط الصّاعد قادم

237
00:17:54,090 --> 00:17:56,230
!استعدّوا

238
00:17:59,060 --> 00:17:59,900
ما الّذي...؟

239
00:18:00,500 --> 00:18:03,440
يا رفاق! تمسّكوا بالسّفينة
!جيّدًا أو ادخلوا للدّاخل

240
00:18:03,770 --> 00:18:09,410
!السّفينة... إنّها ترتفع

241
00:18:46,680 --> 00:18:49,850
!كلاّ! ستنقلب سفينتنا

242
00:18:52,320 --> 00:18:54,290
!تحمّلوا

243
00:18:54,290 --> 00:18:56,020
!إيّاكم أن تُرموا من على السّفينة

244
00:18:59,830 --> 00:19:02,430
!هيّا إلى جزيرة السّماء

245
00:19:04,930 --> 00:19:06,330
!ما الّذي يحدث؟

246
00:19:06,330 --> 00:19:09,100
!إنّ السّفينة تصعد عمودًا من الماء

247
00:19:09,700 --> 00:19:10,840
!هذا رائع

248
00:19:10,840 --> 00:19:12,810
!كيف يحدث هذا؟

249
00:19:14,710 --> 00:19:15,780
!الرّياح؟

250
00:19:16,310 --> 00:19:22,750
!حسنًا! بإمكاننا الآن الذّهاب للسّماء
!انطلقي يا ميري

251
00:19:24,990 --> 00:19:28,190
!مهلاً! لا أعتقد أنّ الأمر سيكون سهلاً

252
00:19:28,190 --> 00:19:29,420
!ما-ما الخطب؟

253
00:19:29,420 --> 00:19:31,660
ماذا؟ هل نسينا أمرًا ما؟

254
00:19:31,660 --> 00:19:33,890
!هيكل السّفينة بدأ يطفوا

255
00:19:35,230 --> 00:19:37,970
!إن استمرّ هذا، فسنحلّق بعيدًا نحو هلاكنا

256
00:19:37,970 --> 00:19:43,700
!لكن ما الّذي تريدنا أن نفعله؟
!بالكاد نستطيع التّمسّك

257
00:19:44,810 --> 00:19:45,710
!ما هذا؟

258
00:19:46,710 --> 00:19:47,780
!ملك بحر

259
00:19:47,780 --> 00:19:49,940
!إنّه الّذي تمّ حسبه للدّوّامة

260
00:19:54,310 --> 00:19:57,950
أرأيتم؟! إنّها مسألة وقت فحسب
!قبل أن يحدث ذلك لنا

261
00:19:58,200 --> 00:20:03,460
!مهلاً! نحن نركب انفجارًا قويًّا

262
00:20:03,460 --> 00:20:04,930
!ماذا بإمكاننا فعله؟

263
00:20:05,140 --> 00:20:07,900
!أعتقد أنّها مجرّد ظاهرة طبيعيّة

264
00:20:10,860 --> 00:20:12,170
!تسقط علينا أشياء كثيرة

265
00:20:12,770 --> 00:20:15,900
!إنّها ضحايا تيّار المحيط الصّاعد

266
00:20:15,900 --> 00:20:20,940
نحن هالكون! سنسقط وسنصطدم
!بالمحيط وسنموت

267
00:20:23,340 --> 00:20:24,910
!افردوا الأشرعة في الحال

268
00:20:24,910 --> 00:20:25,280
ماذا؟

269
00:20:25,880 --> 00:20:30,420
هذا هو البحر! وليس مجرّد
!عمود ماء! إنّه تيّار صاعد

270
00:20:30,720 --> 00:20:33,650
والرّياح الّتي تهبّ من تحت
عبارة عن تيّار هوائيّ صاعد

271
00:20:33,650 --> 00:20:35,960
!أنتجته الحرارة الجوفيّة وبخار الانفجار

272
00:20:36,460 --> 00:20:39,260
،إن كنّا نتعامل مع رياح وبحر
!فذلك اختصاصي

273
00:20:39,660 --> 00:20:41,700
!من في رأيكم ملاّحة هذه السّفينة؟

274
00:20:43,460 --> 00:20:45,670
!أنت يا نامي-سان

275
00:20:45,770 --> 00:20:48,800
!يا رفاق! افعلوا ما قالته نامي-سان

276
00:20:47,100 --> 00:20:52,640
سنجمع كل أحلامنا

277
00:20:48,800 --> 00:20:50,140
!أجل

278
00:20:50,400 --> 00:20:52,570
!اركبوا رياح الميمنة واسحبوا الدّفّة نحوها

279
00:20:52,570 --> 00:20:54,140
!صفّوا السّفينة مع التّيّار

280
00:20:52,640 --> 00:20:58,380
ونبحر باحثين عن شيء، باحثين عن

281
00:20:54,140 --> 00:20:54,840
!حاضر

282
00:20:57,180 --> 00:20:59,810
!كلاّ! توشك السّفينة على ترك المياه

283
00:20:58,380 --> 00:20:59,810
!ون بيس

284
00:21:00,210 --> 00:21:03,250
!سنسقط! سنسقط يا نامي
!افعلي شيئًا يا نامي

285
00:21:03,580 --> 00:21:05,250
!لا، بإمكاننا النّجاح

286
00:21:04,620 --> 00:21:10,220
لا تجلب البوصلات سوى التّأخير

287
00:21:08,890 --> 00:21:10,620
!نحن نطير

288
00:21:10,220 --> 00:21:15,960
أمسك بمقود السّفينة وأنا أهذي بالحمّى

289
00:21:13,090 --> 00:21:15,500
!مذهل! السّفينة تطير

290
00:21:15,900 --> 00:21:16,900
!هذا حقيقيّ؟

291
00:21:15,960 --> 00:21:27,370
،إن تمّ التّحقّق من خريطة الكنز المغبرة
!فإنّها ليست أسطورة إذًا

292
00:21:19,970 --> 00:21:20,800
!نجحنا

293
00:21:21,170 --> 00:21:22,200
!أجل

294
00:21:22,500 --> 00:21:24,640
!نامي-سان! أنت رائعة

295
00:21:25,240 --> 00:21:28,110
!أنا أحبّك

296
00:21:28,110 --> 00:21:33,880
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

297
00:21:28,710 --> 00:21:33,010
!انطلقوا! نحو نهاية حلمنا الّذي لم يُرى

298
00:21:33,880 --> 00:21:39,090
فاركب إيقاع أحدهم الحيويّ فحسب

299
00:21:38,220 --> 00:21:40,420
!انطلقوا

300
00:21:39,090 --> 00:21:42,760
!وتظاهر أنّها غير موجودة

301
00:21:40,790 --> 00:21:44,860
،بهذه الرّياح وهذا التّيّار
!بإمكاننا الانطلاق فوق بقدر ما نشاء

302
00:21:42,760 --> 00:21:48,260
سنجمع كلّ أحلامنا

303
00:21:45,660 --> 00:21:48,560
!يا نامي! هل نكاد نصل جزيرة السّماء؟

304
00:21:48,260 --> 00:21:53,970
ونبحر باحثين عن شيء

305
00:21:49,060 --> 00:21:52,270
إن كانت موجودة، فستكون على
!الجانب الآخر من تلك السّحب

306
00:21:53,470 --> 00:21:54,800
!فوق السّحب؟

307
00:21:53,970 --> 00:22:00,210
عملة في جيبي، وتريد أن تصبح صديقي؟

308
00:21:55,440 --> 00:21:57,770
!ما الّذي قد نجده هناك؟

309
00:21:58,340 --> 00:22:01,080
!فلنخترق السّحب الملكيّة

310
00:22:00,310 --> 00:22:05,080
!إنّنا، إنّنا في رحلة بحريّة

311
00:22:05,750 --> 00:22:06,950
!إننا كذلك

312
00:22:09,430 --> 00:22:17,340
آه، خلف السّماء الّتي لا نهاية لها

313
00:22:17,340 --> 00:22:27,950
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

314
00:22:35,830 --> 00:22:43,270
مرّت عليّ أيّام كدت أخسر فيها نفسي

315
00:22:43,270 --> 00:22:51,680
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

316
00:22:51,680 --> 00:22:59,880
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

317
00:22:59,880 --> 00:23:08,730
دفعوا بي للأمام، أليس كذلك؟

318
00:23:08,730 --> 00:23:17,030
آه، إنّ النّجوم تهوي من السّماء

319
00:23:17,030 --> 00:23:20,170
...وهذه اللّحظة الفريدة

320
00:23:25,380 --> 00:23:28,040
!يا رفاق! انظروا خارج السّفينة

321
00:23:28,040 --> 00:23:29,510
!ما هذا المكان؟

322
00:23:29,510 --> 00:23:31,050
!يا للبياض النّاصع

323
00:23:31,050 --> 00:23:33,850
!باختصار، هذا محيط في السّماء؟

324
00:23:33,850 --> 00:23:34,990
!ثمّة شيء ما هناك

325
00:23:34,990 --> 00:23:36,690
...إنّه مخلوق غريب

326
00:23:36,690 --> 00:23:37,550
أهي سمكة؟

327
00:23:37,550 --> 00:23:39,120
!ثمّة شيء ما هناك

328
00:23:39,120 --> 00:23:40,220
!ماذا الآن؟

329
00:23:40,220 --> 00:23:41,990
!إنّه شخص ما! أحدهم قادم

330
00:23:41,990 --> 00:23:43,290
:في الحلقة القادمة من ون بيس

331
00:23:43,290 --> 00:23:46,200
!الإبحار في البحر الأبيض"
".فارس السّماء والبّوابة في السّحب

332
00:23:46,200 --> 00:23:48,670
!ملك القراصنة، لن يكون إلاّ أنا