1
00:00:22,250 --> 00:00:25,280
!العالم... نعم

2
00:00:25,820 --> 00:00:27,490
...اسعوا نحو الحرّيّة

3
00:00:27,490 --> 00:00:31,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,370 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:16,130 --> 00:02:19,400
!سحقًا، سحقًا، سحقًا

22
00:02:19,400 --> 00:02:23,370
!كم مرّة ستواصل البحريّة الهجوم علينا؟

23
00:02:23,630 --> 00:02:26,700
،إن كنت تريد النّجاة من هذا
!واصل التّجديف وتوقّف عن التذمّر

24
00:02:32,080 --> 00:02:35,910
!سنموت

25
00:02:38,620 --> 00:02:41,020
!يا لوفي! ساعدنا

26
00:02:41,320 --> 00:02:44,990
...لا، لقد خارت قوّتي
...لم آكل شيئًا منذ الصّباح

27
00:02:45,960 --> 00:02:47,960
!أهذا الوقت المناسب لتجوع؟

28
00:02:51,160 --> 00:02:53,000
!أيّها الرّائد! أيّها الرّائد باسكوا

29
00:02:53,000 --> 00:02:56,330
امتثل في نقطة المراقبة حالاً رجاءً
!أيّها الرّائد باسكوا

30
00:02:56,830 --> 00:02:58,100
!أيّها الرّائد باسكوا

31
00:03:02,470 --> 00:03:05,180
!اخرس أيّها المعتوه

32
00:03:05,510 --> 00:03:07,180
.يكفي أن تناديني مرّةً

33
00:03:07,180 --> 00:03:09,180
.أ-أنا جدّ آسف أيّها الرّائد

34
00:03:09,180 --> 00:03:12,550
،لكنّنا التحمنا مع المجرم المطلوب
!مونكي د. لوفي

35
00:03:12,850 --> 00:03:14,020
!ماذا؟

36
00:03:18,690 --> 00:03:20,260
.أخذت وقتك في المجيء

37
00:03:21,090 --> 00:03:23,660
.كدتَ تفوّت اللّقاء التّاريخيّ

38
00:03:24,230 --> 00:03:25,400
.ناوليني المنظار

39
00:03:27,870 --> 00:03:31,300
.لا شكّ في ذلك. إنّها راية قبّعة القشّ لوفي

40
00:03:31,770 --> 00:03:32,670
.نعم، صحيح

41
00:03:34,710 --> 00:03:36,470
...ذلك الغبيّ

42
00:03:37,010 --> 00:03:39,310
،كنّا نطلق عليهم طلقات تحذيريّة لوهلة

43
00:03:39,310 --> 00:03:40,910
.لكنّهم لم يظهروا أيّ نيّة في التّوقّف

44
00:03:40,910 --> 00:03:42,610
...أيّها الرّائد، هلاّ فعلت "ذلك" رجاءً

45
00:03:42,610 --> 00:03:44,780
...أفعل "ذلك"؟ إن كنت مصرًّا

46
00:03:45,880 --> 00:03:46,980
.أظنّني سأفعل

47
00:03:47,620 --> 00:03:50,960
!ها هي ذي! المهارة الخاصّة للرّائد

48
00:03:50,960 --> 00:03:53,490
المهارة الّتي أسقطت عددًا
...لا يحصى من سفن القراصنة

49
00:03:53,490 --> 00:03:54,760
!قنبلة الإصبع

50
00:04:07,670 --> 00:04:08,440
ماذا؟

51
00:04:08,440 --> 00:04:10,840
!ماذا فعلت أيّها الرّائد؟

52
00:04:14,410 --> 00:04:15,280
ما كان ذلك؟

53
00:04:15,280 --> 00:04:16,780
هل يطلقون على بعضهم؟

54
00:04:19,620 --> 00:04:21,350
!هذا جزاؤكم يا حثالة البحريّة

55
00:04:21,350 --> 00:04:23,920
!تنبّأتُ أنّ هذا سيحدث من البداية

56
00:04:24,320 --> 00:04:25,790
متى تنبّأت به؟

57
00:04:26,560 --> 00:04:27,290
!حسنًا

58
00:04:27,290 --> 00:04:30,530
،بينما تتداعى تشكيلتهم
!سننتهز هذه الفرصة للهرب

59
00:04:30,530 --> 00:04:33,500
أنقذوا الرّجال الّذين سقطوا
!في البحر من السّفينة الغارقة

60
00:04:33,500 --> 00:04:35,500
!هل أنتم بخير؟

61
00:04:36,070 --> 00:04:38,270
!تبتعد سفينة غوينغ ميري أكثر

62
00:04:38,500 --> 00:04:39,500
!حسنٌ

63
00:04:39,500 --> 00:04:40,740
!لا شيء حسن في هذا

64
00:04:41,310 --> 00:04:43,310
...فرصتي لنيل مليار بيري

65
00:04:41,310 --> 00:04:44,610
بدأت عجلة الحظّ تدور، صحيح؟

66
00:04:43,310 --> 00:04:48,010
!لا، ترقيتي... تتلاشى أيّها الرّائد باسكوا

67
00:04:45,840 --> 00:04:49,080
.أجل. كلّ شيء يسير مسار التّاريخ

68
00:04:49,350 --> 00:04:50,580
!عالجوا الجرحى

69
00:04:50,580 --> 00:04:54,290
!سيُبحر الأسطول إلى لولوكا كما هو مخطّط

70
00:04:58,590 --> 00:05:02,890
!أسطورة ضباب قوس قزح"
".جزيرة لولوكا والعجوز هينزو

71
00:05:14,310 --> 00:05:15,210
أين البحريّة؟

72
00:05:15,540 --> 00:05:16,970
.يبدو أنّنا نفدنا منهم

73
00:05:18,040 --> 00:05:20,880
.كانوا يلاحقوننا بشكل مكثّف مؤخرًا

74
00:05:21,250 --> 00:05:23,510
عند وجود شخصين بمكافأة على رأسيهما

75
00:05:23,510 --> 00:05:26,150
على متن السّفينة، فمن الطّبيعيّ
.أن تلاحقنا البحريّة بجدّيّة

76
00:05:37,090 --> 00:05:38,400
...لوفي

77
00:05:39,200 --> 00:05:40,830
.احذر

78
00:05:40,830 --> 00:05:43,930
يبدو أنّ هنالك الكثير
.من الشّعاب تحت الأمواج

79
00:05:54,850 --> 00:05:56,050
!ثمّة ميناء

80
00:05:56,050 --> 00:05:57,650
!ماذا؟! ميناء؟

81
00:05:57,650 --> 00:05:59,480
!انظرا! يمكنكما رؤية المنارة

82
00:06:00,650 --> 00:06:02,120
ميناء إذًا؟

83
00:06:02,120 --> 00:06:03,890
!ما يعني أنّ هنالك ما يُؤكل

84
00:06:10,130 --> 00:06:12,400
.ماذا؟ ليست منارة

85
00:06:12,400 --> 00:06:14,930
.إنّه برج طويل حقًّا

86
00:06:15,330 --> 00:06:17,600
!من يهتمّ؟ لنجد طعامًا نأكله! طعام

87
00:06:17,600 --> 00:06:19,570
.فهمنا. فقط امسح لعابك

88
00:06:25,780 --> 00:06:26,980
!انتظروا يا هؤلاء

89
00:06:28,350 --> 00:06:33,880
في جزيرة لولوكا، على كلّ السّفن الّتي
،ترسوا في مينائنا أو حتّى بين الصّخور

90
00:06:34,520 --> 00:06:36,250
!أن تدفع رسوم الميناء

91
00:06:36,250 --> 00:06:37,920
رسوم الميناء؟

92
00:06:37,920 --> 00:06:40,720
بيت القصيد هو أنّنا يجب
.أن ندفع لهم مالاً

93
00:06:40,720 --> 00:06:45,030
مهلاً، لِمَ علينا أن ندفع
الضّريبة فقط على الرّسو هنا؟

94
00:06:45,030 --> 00:06:47,000
!لأنّه واجبكم

95
00:06:47,000 --> 00:06:48,530
!ستدفعون أم لا؟

96
00:06:49,030 --> 00:06:49,830
...اسمع

97
00:06:50,730 --> 00:06:52,900
.لا تتحدّث بهذا الأسلوب مع آنسة

98
00:06:53,340 --> 00:06:54,610
!ماذا؟

99
00:06:59,010 --> 00:07:00,850
!طعام

100
00:07:00,850 --> 00:07:03,110
!طعام! طعام! طعام! طعام

101
00:07:04,220 --> 00:07:06,420
...ذلك الوغد

102
00:07:06,420 --> 00:07:07,550
هل أنت بخير؟

103
00:07:07,550 --> 00:07:09,650
!نعم! بخير حال

104
00:07:10,190 --> 00:07:11,560
.هيّا، لنذهب

105
00:07:11,560 --> 00:07:13,990
أريد أن أشتري بعض ورق
.الرّسم لأرسم بعض الخرائط

106
00:07:13,990 --> 00:07:16,030
!سأرافقك يا نامي-سان

107
00:07:16,030 --> 00:07:18,160
!سـ-سآتي معكما

108
00:07:18,530 --> 00:07:21,930
...مـ-مهلاً! سآتي أيضًا! أنا أيضًا

109
00:07:20,600 --> 00:07:21,930
!أنتم يا هؤلاء

110
00:07:27,200 --> 00:07:29,910
.هناك ما أريد أن أسألكم

111
00:07:30,370 --> 00:07:32,540
نوع جديد من المهرّجين؟

112
00:07:32,540 --> 00:07:34,880
.قد يكون بائعًا مخادعًا

113
00:07:35,180 --> 00:07:36,550
!لستُ أيًّا منهما

114
00:07:37,780 --> 00:07:41,090
هل رأيتم ضبابًا بألوان الطّيف؟

115
00:07:42,050 --> 00:07:44,760
ماذا؟ ضباب بألوان الطّيف؟

116
00:07:44,760 --> 00:07:46,560
.لا فائدة. إنّه غبيّ

117
00:07:46,560 --> 00:07:47,730
هل استبق الحكم عليّ؟

118
00:07:47,730 --> 00:07:49,360
!مهلاً، انتظر لحظة

119
00:07:49,360 --> 00:07:52,460
!ما هذا الأسلوب بعد أن سألتني سؤالاً؟

120
00:07:52,460 --> 00:07:54,870
.أتساءل إن كان بإمكانك إخباري عنه

121
00:08:00,910 --> 00:08:02,670
!أيّها العمّ، أريد المزيد

122
00:08:02,670 --> 00:08:04,580
!حالاً! طبق خاصّ آخر

123
00:08:04,580 --> 00:08:05,880
!المزيد لأجلي أيضًا

124
00:08:06,240 --> 00:08:07,550
.تفضّل طبقك الخاصّ

125
00:08:08,210 --> 00:08:10,080
تستطيع دفع ثمن الطّعام، صحيح؟

126
00:08:10,080 --> 00:08:11,850
.سيدفع عنّي

127
00:08:11,850 --> 00:08:13,150
!ماذا؟ أنا؟

128
00:08:13,850 --> 00:08:16,850
.سأخبرك بأسرار ضباب قوس قزح

129
00:08:16,850 --> 00:08:18,660
.لذا من الطّبيعيّ أن تدفع

130
00:08:18,660 --> 00:08:20,560
!لست من طلب منك أن تخبره

131
00:08:22,230 --> 00:08:24,530
.اسمي هينزو

132
00:08:24,530 --> 00:08:29,730
أنا عبقريّ، لا، أنا عالم عبقريّ
.أجري بحثًا عن ضباب قوس قزح

133
00:08:29,730 --> 00:08:32,340
.لا يمكنك أن تدعو نفسك بعبقريّ

134
00:08:32,340 --> 00:08:34,640
.أيّ من يدعو نفسه كذلك ليس صادقًا

135
00:08:34,640 --> 00:08:35,770
...سيّد هينزو

136
00:08:36,240 --> 00:08:38,110
.ادعوني بالأستاذ

137
00:08:38,110 --> 00:08:38,740
!أنت

138
00:08:39,140 --> 00:08:41,580
أيّها الأستاذ، هل تعرف هذا الكتاب؟

139
00:08:42,750 --> 00:08:43,650
أذاك...؟

140
00:08:44,250 --> 00:08:46,050
.وجدته في ألاباستا

141
00:08:46,050 --> 00:08:49,820
صحيح. فكّرتُ أنّني سمعت عن
،ضباب قوس قزح في مكان ما من قبل

142
00:08:49,820 --> 00:08:52,420
ليتّضح أنّه اسم الكتاب
.الّذي تقرئينه يا روبين

143
00:08:53,320 --> 00:08:55,360
،لا أعرف من مؤلّفه

144
00:08:55,360 --> 00:08:58,230
.لكنّه أُصدر قبل 40 سنة

145
00:08:58,230 --> 00:09:02,900
وفقًا للكتاب، ضباب قوس قزح هو
.حديقة الآلهة، أو ربّما إل دورادو

146
00:09:03,370 --> 00:09:06,100
.سُجّل على أنّه مدخل مدينة الذّهب

147
00:09:07,040 --> 00:09:09,570
.تلك ما إلاّ أسطورة

148
00:09:09,570 --> 00:09:14,410
،أُغويَ العديد من قبل تلك الأسطورة

149
00:09:14,410 --> 00:09:17,310
،وذهبوا في رحلة لإيجاد ضباب قوس قزح

150
00:09:17,310 --> 00:09:19,880
.لكن لم يعد منها أيّ منهم

151
00:09:20,250 --> 00:09:22,850
.نعم حتّى أصدقائي

152
00:09:29,330 --> 00:09:32,200
.لهذا السّبب تبحث في أمر الضّباب إذًا

153
00:09:32,760 --> 00:09:34,300
...سيّدي

154
00:09:34,570 --> 00:09:38,070
.من الأفضل ألاّ تأخذوا ما يقوله محمل الجدّ

155
00:09:38,570 --> 00:09:39,700
ماذا تقصد؟

156
00:09:40,040 --> 00:09:42,670
.إنّه أحد كلاب المحافظ ويتّون

157
00:09:42,670 --> 00:09:43,810
كلاب؟

158
00:09:43,810 --> 00:09:47,650
صحيح! إنّه يتلقّى تمويلاً للبحث من
،قبل المحافظ ويعيش حياة الرّفاهيّة

159
00:09:47,950 --> 00:09:50,280
!إنّه عالم كاذب

160
00:09:59,060 --> 00:10:02,160
!فـ-فرقة تحصيل الضّرائب
!أتت فرقة تحصيل الضّرائب

161
00:10:02,360 --> 00:10:03,330
ماذا؟

162
00:10:03,330 --> 00:10:05,230
!أسرع واشرب ذلك

163
00:10:16,010 --> 00:10:18,640
.عجبًا، عجبًا أيّها المواطنون الصّالحون

164
00:10:19,210 --> 00:10:22,550
هل تستمتعون بوجباتكم؟

165
00:10:25,250 --> 00:10:28,090
.أنت هناك. يبدو أنّك تشرب شرابًا لذيذًا

166
00:10:28,090 --> 00:10:31,760
عندما تشرب الشّراب، عليك دفع
ضريبة شرب الشّراب، صحيح؟

167
00:10:35,160 --> 00:10:36,730
!مـ-مهلاً، انتظروا لحظة

168
00:10:37,090 --> 00:10:41,270
كـ-كلّ ما أملك في جيبي
!هو قوت عيش زوجتي وأولادي

169
00:10:41,630 --> 00:10:44,300
.من واجب المواطن أن يدفع الضّرائب

170
00:10:45,640 --> 00:10:50,410
من يتجاهل التزاماته، لا يملك
.الحقّ في العيش في هذه البلدة

171
00:10:51,310 --> 00:10:52,740
من هذا الشّخص؟

172
00:10:52,740 --> 00:10:54,710
.ابن المحافظ ويتّون، فيليب

173
00:10:55,450 --> 00:10:59,220
وغدٌ بغيض يستأصل منّا
.كلّ أنواع الضّرائب

174
00:11:01,920 --> 00:11:05,260
...عجبًا، عجبًا، الأستاذ هينزو

175
00:11:05,260 --> 00:11:07,830
.كان أبي يبحث عنك

176
00:11:07,830 --> 00:11:10,230
كان يتساءل كيف يسير
.بحثك عن الضّباب

177
00:11:10,490 --> 00:11:12,230
.كحاله

178
00:11:12,230 --> 00:11:16,430
لا يمكننا أن نجزم متى أو
.أين سيظهر الضّباب في النّهاية

179
00:11:16,770 --> 00:11:22,640
يا إلهي. بحثك مدعوم
.من أموال ضرائب المواطنين

180
00:11:22,640 --> 00:11:27,610
تمّ بناء برج قوس قزح هناك
.بناءً على بحثك

181
00:11:27,950 --> 00:11:30,450
،تذكّر أنّه كلّما تباطأ بحثك

182
00:11:30,450 --> 00:11:33,880
.تضايق الجميع هنا

183
00:11:34,320 --> 00:11:35,890
.حسنًا، سأراك لاحقًا

184
00:11:43,360 --> 00:11:45,230
...عجبًا، عجبًا

185
00:11:45,230 --> 00:11:48,630
يا هذا، إنّك تأكل طبقًا
مكوّمًا بالمعكرونة، صحيح؟

186
00:11:48,630 --> 00:11:51,240
.نعم، كنتُ جائعًا

187
00:11:52,670 --> 00:11:57,340
تناول طبق مكوّم يعني أنّك
ستدفع ضرائب مكوّمة، صحيح؟

188
00:11:57,810 --> 00:12:00,080
.هو من سيدفع

189
00:12:00,080 --> 00:12:01,480
!أنا؟

190
00:12:08,090 --> 00:12:11,090
لِمَ أنا يا إلهي؟

191
00:12:11,960 --> 00:12:12,590
!شكرًا

192
00:12:12,590 --> 00:12:14,060
!لا تعبث معي

193
00:12:19,430 --> 00:12:21,000
.فهمتم الآن

194
00:12:21,000 --> 00:12:24,500
إن كنتم لا تريدون أن يفكّر
،فيكم أهل البلدة بسوء

195
00:12:25,040 --> 00:12:26,600
.كفّوا عن التّسكّع مع هينزو

196
00:12:27,570 --> 00:12:29,110
.شكرًا على التّحذير

197
00:12:29,340 --> 00:12:32,310
.لكنّ ذلك ليس قراري

198
00:12:32,910 --> 00:12:34,080
.بل قرار القائد

199
00:12:54,600 --> 00:12:56,670
أ-أما زلت تتسوّقين؟

200
00:12:57,170 --> 00:12:58,840
.بالطّبع

201
00:12:58,840 --> 00:13:00,570
.عليّ أن أشتري أوراق الرّسم

202
00:13:00,570 --> 00:13:03,340
،إن نفدت منّا ونحن في البحر
.فسنكون في مأزق

203
00:13:03,340 --> 00:13:07,240
لكنّك تشترين الكثير من
.الأشياء الّتي لا حاجة لنا بها

204
00:13:07,710 --> 00:13:12,550
نامي-سان، سأتبعك حتّى قاع الجحيم
!لمرافقتك وأنت تتسوّقين

205
00:13:14,390 --> 00:13:16,850
!إنّهم هناك يا ليك-ساما! إنّهم هم

206
00:13:18,590 --> 00:13:20,220
أنتم أولئك المتغطرسون

207
00:13:20,220 --> 00:13:23,830
الّذين لم يدفعوا ضرائبهم
في الميناء، أليس كذلك؟

208
00:13:29,570 --> 00:13:32,570
!أنا حفيد المحافظ ويتّون، ليك

209
00:13:33,100 --> 00:13:37,740
أنا الضّابط الّذي يأخذ الضّرائب
!المتخلّف دفعها من المتغطرسين

210
00:13:37,740 --> 00:13:40,180
،لستُ واثقًا ممّا يجري هنا بالضّبط

211
00:13:40,180 --> 00:13:43,050
لكن إن أتيت إلى هنا بهدف
،تعكير رحلة تسوّقنا الممتعة

212
00:13:43,050 --> 00:13:44,620
.لن أظهر لك أيّ رحمة

213
00:13:59,960 --> 00:14:01,270
!سانجي

214
00:14:01,270 --> 00:14:02,670
!تبًّا، ما الّذي تفعله؟

215
00:14:03,070 --> 00:14:07,570
.شـ-شعرتُ بصدمة فور أن لمستُ جسده

216
00:14:07,570 --> 00:14:12,240
.لا فائدة. هذا ما يحدث لأيّ أحد يلمسني

217
00:14:12,740 --> 00:14:13,780
كهرباء؟

218
00:14:13,780 --> 00:14:14,780
.فهمت

219
00:14:14,780 --> 00:14:16,880
!إنّه يملك قدرات فاكهة الشّيطان

220
00:14:22,350 --> 00:14:24,360
!مُولّدك الخاصّ؟

221
00:14:37,430 --> 00:14:40,810
يبدو هذا مشؤومًا بطريقةٍ ما، صحيح؟

222
00:14:42,910 --> 00:14:46,280
!اختبر قوّة بذلة الصّدمة الكهربائيّة خاصّتي

223
00:14:46,780 --> 00:14:48,910
!الرّعد الجيّاش

224
00:14:56,550 --> 00:14:58,220
ماذا؟ أكان ذلك رعد؟

225
00:15:03,130 --> 00:15:04,330
!كان ذلك وشيكًا

226
00:15:04,330 --> 00:15:08,970
أحسنت في تفاديه، لكنّك
!لن تفلت هذه المرّة

227
00:15:11,070 --> 00:15:13,070
.تشوبّر، اعتن بنامي

228
00:15:13,070 --> 00:15:14,000
!مفهوم

229
00:15:14,240 --> 00:15:16,740
سانجي-كن، لا تقم بأيّ حماقة، اتّفقنا؟

230
00:15:17,810 --> 00:15:20,210
!حاضر، لا تقلقي عليّ

231
00:15:20,640 --> 00:15:23,180
.بل أنا قلقة على تلك

232
00:15:23,180 --> 00:15:23,910
هذه؟

233
00:15:24,250 --> 00:15:26,380
.إ-إنّها الشّيطان بعينه

234
00:15:26,620 --> 00:15:27,590
.لا بأس

235
00:15:27,590 --> 00:15:31,460
،لن أحافظ عليها من الضّرر فحسب
.بل لن تتّسخ بالغبار حتّى

236
00:15:32,690 --> 00:15:35,430
.لديكم محافظ ظالم حقًّا هنا

237
00:15:35,430 --> 00:15:38,960
يأخذ المال من كلّ شيء
.ويقول أنّه لأجل الضّرائب

238
00:15:38,960 --> 00:15:42,770
كيف يجرؤ على تسميتها
!ضرائب مكوّمة؟ يا لها من سرقة

239
00:15:42,770 --> 00:15:45,470
...آسف جميعًا

240
00:15:46,600 --> 00:15:48,370
لِمَ تعتذر أيّها العمّ؟

241
00:15:48,370 --> 00:15:51,680
ألم تصغ لما قاله أولئك الأشخاص؟

242
00:15:51,680 --> 00:15:52,680
.كلاّ، إطلاقًا

243
00:15:52,680 --> 00:15:56,150
.حسنًا، هذا العمّ متواطئ مع أولئك اللّصوص

244
00:15:56,150 --> 00:16:00,480
.يُهدر مال الجميع على حساب بحثه الغريب

245
00:16:01,820 --> 00:16:03,620
هل تفهم ما يجري حقًّا؟

246
00:16:03,620 --> 00:16:06,720
.كلاّ، إطلاقًا

247
00:16:04,520 --> 00:16:05,820
اسمع يا لوفي، هل سمعت بالقواقع؟

248
00:16:06,720 --> 00:16:07,930
ما الّذي يجري؟

249
00:16:07,930 --> 00:16:10,490
!إنّها سفينة! سفينة غاليون في الميناء

250
00:16:11,260 --> 00:16:12,200
سفينة غاليون؟

251
00:16:12,200 --> 00:16:13,400
...لا-لا يمكن

252
00:16:13,700 --> 00:16:15,970
!يبدو هذا مثيرًا للاهتمام! هيّا بنا

253
00:16:15,970 --> 00:16:17,470
!انتظر يا لوفي

254
00:16:29,580 --> 00:16:30,880
!إنّها ضخمة

255
00:16:34,920 --> 00:16:37,090
.إنّها سفينة قديمة جدًّا

256
00:16:37,090 --> 00:16:38,790
.إنّها التّالييليسين

257
00:16:39,090 --> 00:16:42,230
!التّـ-التاليـ...؟ مـ-مهلاً أيّها العمّ

258
00:16:52,040 --> 00:16:54,040
!مذهل

259
00:16:55,070 --> 00:16:57,410
!رائع

260
00:16:59,440 --> 00:17:02,780
!ممتاز! مذهل! أريد واحدة
!أريد واحدة حقًّا

261
00:17:02,780 --> 00:17:05,320
.نعم، هذا من طبعك

262
00:17:10,890 --> 00:17:12,060
...الرّعد

263
00:17:17,860 --> 00:17:19,630
!لا فائدة

264
00:17:24,840 --> 00:17:25,540
!سانجي

265
00:17:25,540 --> 00:17:26,900
!حقائب التّسوّق

266
00:17:27,840 --> 00:17:32,240
...هـ-هذا غباء... لقد تفاديتها

267
00:17:33,780 --> 00:17:35,180
!أنت الغبيّ

268
00:17:36,180 --> 00:17:37,820
!إنّه المعدن يا سانجي

269
00:17:37,820 --> 00:17:40,020
المقتنيات الثّمينة تسحب
!الكهرباء! تخلّص منها

270
00:17:40,020 --> 00:17:41,120
!لا

271
00:17:41,650 --> 00:17:43,120
!كانت غالية

272
00:17:43,120 --> 00:17:45,990
تعلم ما سيحدث لك
!إن أسقطتها، أليس كذلك؟

273
00:17:45,990 --> 00:17:49,160
نعم، لكن... بعد تلقّيه لتيّار
،كهربائيّ بتلك القوّة

274
00:17:49,160 --> 00:17:50,690
...كان الشّخص العاديّ لـ

275
00:17:50,690 --> 00:17:52,360
!ليس شخصًا عاديًّا، لذا لا مشكلة

276
00:17:54,530 --> 00:17:56,270
...هذا سيّئ

277
00:17:56,270 --> 00:17:59,400
...إن كانت هجماتي المباشرة لا تفلح

278
00:18:03,810 --> 00:18:04,380
!إنّه يهرب

279
00:18:04,380 --> 00:18:05,380
!انتظر

280
00:18:05,380 --> 00:18:06,580
!ليك-ساما

281
00:18:09,550 --> 00:18:10,380
!لنذهب بينما نستطيع

282
00:18:10,380 --> 00:18:12,620
!أحكم حمل حقائبي

283
00:18:12,620 --> 00:18:13,120
!حاضر

284
00:18:13,450 --> 00:18:16,890
،إن كانت بتلك الأهميّة
فلمَ لا تحمليها بنفسك؟

285
00:18:16,890 --> 00:18:17,890
أهذا خاطئ؟

286
00:18:17,890 --> 00:18:18,660
...لا

287
00:18:19,590 --> 00:18:22,060
!رابا نوي! إيسوكا

288
00:18:23,090 --> 00:18:24,430
!رونغو! بوكاو

289
00:18:25,560 --> 00:18:26,330
!أكيبي

290
00:18:26,900 --> 00:18:30,030
!رفاق! يا رفاق

291
00:18:42,550 --> 00:18:44,180
!أيّها العمّ

292
00:18:45,180 --> 00:18:46,150
...غومو غومو نوو

293
00:18:47,720 --> 00:18:49,120
!الصّاروخ

294
00:18:49,620 --> 00:18:50,720
!...ذ-ذراعك

295
00:18:52,260 --> 00:18:54,230
!أيّها العمّ، أعطني ذلك القارب

296
00:18:54,230 --> 00:18:56,860
هـ-هل أكلت فاكهة شيطان...؟

297
00:18:56,860 --> 00:19:00,200
.أنا؟ أنا رجل مطّاطيّ، أكلت فاكهة المطّاط

298
00:19:01,430 --> 00:19:05,670
."لا يمكنني إعطاؤك آلة الـ"إتش-1

299
00:19:05,670 --> 00:19:09,470
!ماذا؟ لا تقل هذا، أعطها لي

300
00:19:13,840 --> 00:19:16,450
يبدو أنّه كان هناك أشخاص
.هنا قبل وهلة فقط

301
00:19:17,310 --> 00:19:20,420
.لا يوجد أيّ شخص على هذه السّفينة

302
00:19:22,790 --> 00:19:27,860
لقد انجرفت هذه السّفينة
.منذ خمسين سنة

303
00:19:27,860 --> 00:19:29,690
!خمسون سنة؟

304
00:19:30,230 --> 00:19:32,760
.أجد تصديق ذلك صعبًا

305
00:19:34,570 --> 00:19:36,170
.لا شكّ في ذلك

306
00:19:36,500 --> 00:19:38,540
.ما زالت السّفينة كما كانت عليه آنذاك

307
00:19:38,540 --> 00:19:41,470
مهلاً، عمّاذا تتحدّث أيّها العمّ؟

308
00:19:43,840 --> 00:19:45,110
مـ-ما ذلك؟

309
00:19:45,880 --> 00:19:46,880
...إ-إنّه

310
00:19:49,680 --> 00:19:51,480
!إنّ راداري يتفاعل

311
00:19:51,480 --> 00:19:54,020
!لم أحصل على قراءة بهذه الكثافة من قبل

312
00:20:00,930 --> 00:20:02,660
!إنّه ضباب قوس قزح

313
00:20:02,660 --> 00:20:06,860
سحقًا، لا أستطيع الخروج
."إلى عرض البحر بالـ"إتش-1

314
00:20:06,860 --> 00:20:07,700
ما العمل؟

315
00:20:08,000 --> 00:20:09,170
!وجدتها

316
00:20:11,370 --> 00:20:12,540
!سأستعير هذه

317
00:20:12,540 --> 00:20:13,770
!ماذا؟

318
00:20:14,040 --> 00:20:15,770
!لا تسرق سفينتنا

319
00:20:15,770 --> 00:20:18,680
!إن أردت الذّهاب، فخذ الغاليون

320
00:20:19,940 --> 00:20:25,650
،ما زال مقود التّالييليسين محطّمًا
.على يد ويتّون

321
00:20:25,650 --> 00:20:28,120
ماذا تقول أيّها العمّ؟

322
00:20:28,120 --> 00:20:30,490
كيف تعرف ذلك؟

323
00:20:30,790 --> 00:20:35,460
،لأنّه قبل خمسين سنة
.كنتُ على متن التّالييليسين

324
00:20:39,200 --> 00:20:40,030
!لقد اختفت

325
00:20:40,030 --> 00:20:42,000
!اختفت الغوينغ ميري

326
00:20:42,000 --> 00:20:44,400
!مهلاً، ما الّذي يجري هنا؟

327
00:20:44,640 --> 00:20:48,610
لا بدّ أنّ أولئك الأشخاص
!أخذوها بدلاً من الضّرائب

328
00:20:48,610 --> 00:20:50,310
!في تلك الحالة، ستكون في الميناء

329
00:20:50,310 --> 00:20:53,380
!سحقًا، رأس الطّحلب ذاك لا ينفع بشيء

330
00:20:56,550 --> 00:20:58,920
مهلاً، هل سندخل إلى هناك؟

331
00:20:58,920 --> 00:21:01,620
،إنّه مكان تحدّاه الكثير من المغامرين

332
00:21:01,620 --> 00:21:03,950
لكن لم يرجع أيّ منهم، صحيح؟

333
00:21:04,290 --> 00:21:05,160
.سندخل

334
00:21:05,520 --> 00:21:09,930
هذا السّبب الّذي واصلت
.بحثي لأجله حتّى اليوم

335
00:21:10,330 --> 00:21:11,400
هل أنت خائف؟

336
00:21:11,400 --> 00:21:13,400
!مـ-مستحيل أن أخاف

337
00:21:13,400 --> 00:21:18,040
أنا الّذي يجوب غمار
!الغراند لاين، القائد أوسوبّ

338
00:21:20,040 --> 00:21:22,940
!سننطلق إلى ضباب قوس قزح

339
00:21:49,900 --> 00:21:51,470
أيّها الأستاذ، أين نحن؟

340
00:21:51,470 --> 00:21:53,370
."حفلة القرد"

341
00:21:53,370 --> 00:21:55,410
.حفلة القرد"؟ لا يعقل"

342
00:21:55,410 --> 00:21:56,610
!مـ-ماذا تعني؟

343
00:21:57,410 --> 00:22:01,080
مقبرة سفن، حيث من يدخلها
.لا يرجع منها أبدًا

344
00:22:01,380 --> 00:22:03,050
!مـ-ماذا؟

345
00:22:03,410 --> 00:22:06,020
!رائع

346
00:22:09,720 --> 00:22:17,790
آه، خلف السّماء الّتي لا نهاية لها

347
00:22:17,790 --> 00:22:28,410
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

348
00:22:36,280 --> 00:22:43,720
مرّت عليّ أيّام كدت أخسر فيها نفسي

349
00:22:43,720 --> 00:22:52,130
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

350
00:22:52,130 --> 00:23:00,340
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

351
00:23:00,340 --> 00:23:09,180
دفعوا بي للأمام، أليس كذلك؟

352
00:23:09,180 --> 00:23:17,490
آه، إنّ النّجوم تهوي من السّماء

353
00:23:17,490 --> 00:23:20,620
...وهذه اللّحظة الفريدة

354
00:23:25,830 --> 00:23:28,700
.كنتُ قرصانًا من قبل، مثلكم تمامًا

355
00:23:28,700 --> 00:23:30,730
.لستُ خائفًا من مكان هكذا

356
00:23:30,730 --> 00:23:32,770
.أنت، قرصان؟ لا تبدو كذلك بالنّسبة لي

357
00:23:32,770 --> 00:23:36,010
عندما كنتُ صغيرًا، كان لي إيمان
.راسخ بأنّني أستطيع القيام بأيّ شيء

358
00:23:36,010 --> 00:23:39,940
لكنّ ذلك القرصان اليافع
.ما زال حيًّا، في قلبك

359
00:23:39,940 --> 00:23:42,310
.أخبرني بقصّتك أيّها الجدّ

360
00:23:42,310 --> 00:23:43,810
:في الحلقة القادمة من ون بيس

361
00:23:43,810 --> 00:23:46,750
"!سكّان أرض البقاء! قراصنة اليقطين"

362
00:23:46,750 --> 00:23:49,090
!ملك القراصنة، لن يكون إلاّ أنا