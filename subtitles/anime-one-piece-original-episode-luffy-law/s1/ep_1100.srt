1
00:00:10,970 --> 00:00:19,040
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

2
00:00:23,660 --> 00:00:26,500
في نهاية الأحلام، في نهاية البحر

3
00:00:26,500 --> 00:00:29,000
لكلّ واحد منّا مكان يسعى إليه

4
00:00:29,000 --> 00:00:32,010
ولكن أوّلاً، علينا صنع

5
00:00:32,010 --> 00:00:36,890
أسطورة لامعة من أنفسنا

6
00:00:37,290 --> 00:00:39,720
شرارات متطايرة من هنا بلا حدود

7
00:00:39,720 --> 00:00:41,350
!وان بيس

8
00:00:41,350 --> 00:00:43,980
سنخبر جميعنا الرّحّالة

9
00:00:43,980 --> 00:00:47,980
هل ما زالت أحلامكم واضحة؟

10
00:00:49,360 --> 00:00:56,030
خلاياي الّتي لا تنام تدغدغني وتنفجر

11
00:00:56,030 --> 00:01:02,500
وحتّى الآن، جميعنا في خضمّ مغامرة

12
00:01:02,500 --> 00:01:05,120
سنخبر جميعنا الرّحّالة

13
00:01:05,120 --> 00:01:08,880
لا توجد قتالات بلا معنى

14
00:01:10,540 --> 00:01:17,010
إن كان السّياق العشوائيّ بدأ يصير منطقيًّا

15
00:01:17,010 --> 00:01:23,600
فإنّ خيوط الزّمن ستُحاك

16
00:01:23,600 --> 00:01:29,730
معنا، سيستمرّ العالم في التّغيّر

17
00:01:29,730 --> 00:01:36,860
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

18
00:01:41,740 --> 00:01:44,120
!هذا خارق

19
00:01:44,830 --> 00:01:47,000
مرحبًا بكم، كيف الحال؟

20
00:01:47,330 --> 00:01:51,090
.أنا نجّار سفينة طاقم قبّعة القشّ فرانكي

21
00:01:51,380 --> 00:01:55,710
.وأنا عالمة الآثار نيكو روبين من نفس الطّاقم

22
00:01:56,130 --> 00:02:00,890
أخبريني يا روبين، ماذا يفترض بي فعله؟

23
00:02:01,300 --> 00:02:05,520
.تسلّل عملاء سايفر بول إلى إيغهيد

24
00:02:05,640 --> 00:02:07,520
.كنت أفكّر في تقرير عنهم

25
00:02:07,690 --> 00:02:10,600
أولئك الّذي واجهناهم منذ مدّة؟

26
00:02:10,940 --> 00:02:14,570
،إنّهم الآن جزء من سايفر بول إيجيس زيرو

27
00:02:14,690 --> 00:02:18,110
.أقوى وكالة استخبارات في العالم

28
00:02:18,530 --> 00:02:21,450
...إنّهم أشخاص يرتدون بِذلاً بيضاء وأقنعة

29
00:02:21,870 --> 00:02:26,660
.لا أرى ضررًا من إلقاء نظرة عليهم

30
00:02:27,050 --> 00:02:29,870
.لنبدأ بدون أيّ تأخير

31
00:02:30,000 --> 00:02:32,170
...نعم، هيّا بنا

32
00:02:32,330 --> 00:02:33,630
!نبدأ

33
00:02:35,750 --> 00:02:40,330
سجلّ التّنافس! طاقم قبّعة"
"!القشّ ضدّ سايفر بول

34
00:02:43,530 --> 00:02:46,350
.صحيحٌ أنّكم أصلحتم سفينتنا

35
00:02:46,470 --> 00:02:50,910
،لكن كيفما نظرت إلى الأمر
.أجد أنّ الرّسوم مرتفعة للغاية

36
00:02:51,230 --> 00:02:55,320
.لذا قرّرت... ألاّ أدفع ولا بيري واحد

37
00:03:00,070 --> 00:03:04,620
هؤلاء هم الحرفيّون في شركة غالي-لا
!الّتي تبني السّفن في ووتر سفن

38
00:03:06,170 --> 00:03:09,830
.وعملاء سايفر بول كانوا يعملون هناك متخفّين

39
00:03:10,080 --> 00:03:15,250
أساليب القراصنة لا تنفع
في ورشة الحرفيّين، أليس كذلك؟

40
00:03:17,090 --> 00:03:18,710
!تمهّل

41
00:03:19,840 --> 00:03:23,930
فقط الأشخاص المصرّح لهم
.يمكنهم دخول المصنع

42
00:03:24,780 --> 00:03:27,390
!الرّجل ذو الأنف المستطيل هو كاكو

43
00:03:27,510 --> 00:03:30,480
.كان في ذلك الوقت جزءًا من سي بي 9

44
00:03:34,560 --> 00:03:38,690
.وروب لوتشي أيضًا كان من سي بي 9

45
00:03:39,210 --> 00:03:42,200
.أنا روب لو... لا، أقصد، أنا هاتّوري الحمامة

46
00:03:42,330 --> 00:03:46,490
.وهذا روب لوتشي. وهو يعمل هنا
!سعيد بلقائكم

47
00:03:47,280 --> 00:03:48,580
!يا لوقاحتك

48
00:03:48,840 --> 00:03:50,570
كانت السّكرتيرة الجميلة كاليفا

49
00:03:50,740 --> 00:03:54,290
.وساقي الحانة بلونو يعملان لنفس عميلين أيضًا

50
00:03:54,950 --> 00:03:57,460
،نيابة عن حكومة العالم

51
00:03:57,600 --> 00:04:01,330
كان لوتشي ورفاقه يسعون خلف أيسبرغ

52
00:04:01,470 --> 00:04:05,300
رئيس شركة غالي-لا ظنًّا
.أنّ تصاميم بلوتون بحوزته

53
00:04:05,800 --> 00:04:07,640
!لا أملك شيئًا أعطيكم إيّاه

54
00:04:08,600 --> 00:04:10,270
.إلّم تملكه، فهذه مشكلة

55
00:04:12,850 --> 00:04:14,480
حيث أنّك تكاد أن تموت؟

56
00:04:15,440 --> 00:04:17,820
.خاب أملي فيك

57
00:04:18,980 --> 00:04:20,000
!لوتشي

58
00:04:20,480 --> 00:04:25,950
أنتم... تعملون لمصلحة الحكومة؟

59
00:04:26,080 --> 00:04:31,030
.صحيح. كان التّخفّي مهمّة سهلة بالنّسبة لنا

60
00:04:32,080 --> 00:04:36,960
.ولكن حنكتك أبهرتني

61
00:04:38,700 --> 00:04:40,860
...حسنًا يا أيسبرغ-سان

62
00:04:41,460 --> 00:04:46,090
أين مخطّطات السّلاح القديم بلوتون؟

63
00:04:46,470 --> 00:04:50,640
.أرجوك أخبرنا قبل أن يتأذّى الكثير من النّاس

64
00:04:52,350 --> 00:04:54,560
كان أيسبرغ في ورطة

65
00:04:54,690 --> 00:04:57,400
.عندما اقتحم لوفي وزورو الغرفة

66
00:04:57,650 --> 00:05:03,070
.باولي، نحن عملاء استخبارات حكوميّين في الحقيقة

67
00:05:03,740 --> 00:05:07,180
ولكنّك ستسامحنا إن اعتذرنا، أليس كذلك؟

68
00:05:07,990 --> 00:05:12,830
.فنحن رفاق قضينا كلّ يوم في بناء السّفن معًا

69
00:05:13,800 --> 00:05:19,240
،إن كنتَ لا تصدقني لكون هذا مفاجئًا جدًّا
فهل تريدني أن أدوس على وجه أيسبرغ؟

70
00:05:20,590 --> 00:05:21,340
!الانتقال الآني

71
00:05:22,880 --> 00:05:23,840
!اختفى

72
00:05:30,300 --> 00:05:31,310
!مسدّس الإصبع

73
00:05:41,480 --> 00:05:42,400
!لوفي

74
00:05:46,740 --> 00:05:47,700
...سحقًا

75
00:05:47,820 --> 00:05:50,820
،يُسمح لسي بي 9
،الّتي تمثّل العدالة في الظّلال

76
00:05:50,950 --> 00:05:53,510
.بالقتل دون الخوف من أيّ مساءلة

77
00:05:53,730 --> 00:05:57,910
يتقن عملاؤها مجموعة من
.التّقنيات تُسمّى القوى السّتّة

78
00:05:58,040 --> 00:05:59,500
.وهذا ليس كلّ شيء

79
00:05:59,630 --> 00:06:02,940
.تناول لوتشي فاكهة شيطان فوق كلّ ذلك

80
00:06:07,220 --> 00:06:08,920
...فاكهة القطّ

81
00:06:12,930 --> 00:06:14,830
...من صنف النّمر المرقّط

82
00:06:16,930 --> 00:06:20,840
...أنواع الفواكه هي لوغيا وزون وباراميسيا

83
00:06:21,230 --> 00:06:23,860
.توجد الكثير من القوى الفريدة

84
00:06:24,270 --> 00:06:30,410
.التّعزيز الجسديّ الحقيقيّ هو سمة أنواع زون

85
00:06:30,610 --> 00:06:33,870
.كلّما تدرّبنا، صرنا أقوى

86
00:06:36,620 --> 00:06:41,420
نوع زون هو أقوى الأصناف عندما
.يتعلّق الأمر بالهجوم القريب

87
00:06:48,260 --> 00:06:49,380
.مسدّس الإصبع

88
00:06:51,480 --> 00:06:52,390
!لوفي

89
00:06:59,440 --> 00:07:02,150
!احظَ بتحليق ممتع خارج هذه الجزيرة

90
00:07:07,210 --> 00:07:10,950
،تمّ أخذنا إلى الجزيرة القضائيّة إنيس لوبي

91
00:07:11,070 --> 00:07:14,490
.حيث واجه لوفي وبقية الطّاقم سي بي 9

92
00:07:18,540 --> 00:07:21,040
.مرّ وقت طويل يا رئيس

93
00:07:21,540 --> 00:07:23,500
...أجل

94
00:07:24,420 --> 00:07:27,210
كاتي فلام، المجرم المسؤول عن

95
00:07:27,370 --> 00:07:32,180
مهاجمة موظّفين حكوميّين في
...ووتر سيفن قبل ثمان سنوات

96
00:07:32,340 --> 00:07:36,010
نيكو روبين، المجرمة الّتي كانت
متورّطة في حادثة

97
00:07:36,010 --> 00:07:40,390
مهاجمة سفن البحريّة الحربيّة
...في أوهارا في الأزرق الغربيّ

98
00:07:40,390 --> 00:07:43,130
.أكملنا اصطحابهما إلى هنا بلا مشاكل

99
00:07:43,940 --> 00:07:46,860
.كلاهما خلف الباب الآن

100
00:07:47,020 --> 00:07:49,200
...على أيّ حال، دعوني أقابل

101
00:07:50,320 --> 00:07:52,320
!أمل العالم أجمع

102
00:07:52,680 --> 00:07:56,940
.لا أحبّ النّظر في وجه سباندام على الإطلاق

103
00:08:02,210 --> 00:08:06,750
منذ أن أقيمت حكومة العالم، فلم يحدث قطّ

104
00:08:07,130 --> 00:08:11,130
.أن قطع رجل كلّ هذا الشّوط إلى مدخل الحكومة

105
00:08:12,300 --> 00:08:15,720
إلى متى تنوي الهيجان؟

106
00:08:18,930 --> 00:08:20,410
.إلى أن أموت

107
00:08:23,350 --> 00:08:27,520
.لن تتمكّن من مجاراتي الآن

108
00:08:27,690 --> 00:08:28,650
ماذا؟

109
00:08:29,400 --> 00:08:33,400
.ستتطّور كلّ تقنياتي خطوة إلى الأمام

110
00:08:35,570 --> 00:08:37,890
!المستوى... الثّاني

111
00:08:39,540 --> 00:08:41,940
...فاكهة المطّاط

112
00:08:43,410 --> 00:08:46,140
!البازوكا النفّاثة

113
00:09:06,690 --> 00:09:09,450
ماذا؟ هل عدوّنا هو قبّعة القشّ وحده؟

114
00:09:10,230 --> 00:09:11,360
!يويوي

115
00:09:11,480 --> 00:09:17,320
حتّى إن كان وحده، إلاّ أنّ وصوله
.إلى هنا مثير للإعجاب

116
00:09:20,450 --> 00:09:25,370
،حتّى مع سقوط بلونو
.تظلّ سي بي 9 مجموعة قويّة

117
00:09:25,960 --> 00:09:30,040
أعتقد أنّ كونه مالك حانة
.لخمس سنوات جعله ضعيفًا

118
00:09:30,170 --> 00:09:32,880
،حتّى إن كان قد أصبح ضعيفًا
أكان يمكن هزيمته؟

119
00:09:33,010 --> 00:09:36,170
.لقد هُزم... تشابابا

120
00:09:36,760 --> 00:09:41,430
خاض الطّاقم معركة ضدّهم
.من أجل مفتاح أصفادي

121
00:09:45,100 --> 00:09:47,230
!العجلة الخارقة، الكرة الحديديّة

122
00:09:47,550 --> 00:09:50,690
!سأسحقك في زاوية البرج باستخدام هذا الزّخم

123
00:09:52,430 --> 00:09:53,600
...مدفع

124
00:09:54,280 --> 00:09:55,310
!الرّياح

125
00:10:02,870 --> 00:10:06,790
!خارق

126
00:10:07,040 --> 00:10:08,660
.استطعتُ هزيمة فوكورو

127
00:10:08,920 --> 00:10:13,170
أمّا تشوبّر، فقد تجاوز حدوده
.وهزم كومادوري أثناء هيجانه

128
00:10:13,400 --> 00:10:16,440
!إن كنتُ سأموت على أيّ حال، فسأقوم بذلك

129
00:10:17,340 --> 00:10:21,110
.أتمنّى فقط ألاّ يدخل أحد لهذه الغرفة

130
00:10:25,430 --> 00:10:28,130
!ساق العاصفة

131
00:10:31,880 --> 00:10:33,070
!خذ هذه

132
00:10:33,440 --> 00:10:36,280
!أغنيّة الصّفصاف... القرمزيّة

133
00:10:49,540 --> 00:10:53,590
أيّ نوع من التّنبّؤات هذا؟
...يا لغرورك

134
00:10:53,790 --> 00:10:56,300
.ليست تنبّؤات. بل توقّعات جوّيّة

135
00:10:56,600 --> 00:10:58,660
.تحكّمت بكلّ من الرّطوبة والحرارة هنا

136
00:10:58,840 --> 00:11:01,210
!الطّقس في هذه الغرفة تحت سيطرتي

137
00:11:05,430 --> 00:11:07,180
!جوّ رمح البرق

138
00:11:11,850 --> 00:11:13,610
...لا يهمّ كم أنت قويّة

139
00:11:14,010 --> 00:11:16,320
.توقّعاتي الجوّيّة لا تخطئ أبدًا

140
00:11:16,560 --> 00:11:19,880
أصبحت كاليفا امرأة الصّابون
،بعد تناولها لفاكهة الفقاعات

141
00:11:20,030 --> 00:11:21,520
.لكنّ نامي استطاعت هزيمتها

142
00:11:22,010 --> 00:11:25,160
إن كان لديك وقت لتشعر بالشّفقة
،على تلك المرأة المشؤومة

143
00:11:25,290 --> 00:11:28,660
فعليك التّفكير في طريقة
.للنّجاة بجلدك من هنا

144
00:11:29,410 --> 00:11:31,120
.انتبه لكلامك

145
00:11:33,500 --> 00:11:37,050
.أنا من النّوع الّذي يشتعل غضبًا

146
00:11:37,880 --> 00:11:39,510
!ساق الشّيطان

147
00:11:39,670 --> 00:11:41,470
!ماذا؟ مـ-مهلاً

148
00:11:41,820 --> 00:11:43,430
...ركلة

149
00:11:49,540 --> 00:11:51,310
!اللّهب

150
00:12:01,400 --> 00:12:04,820
وفي مواجهة جابرا وقوّة فاكهة الكلب
،من صنف الذّئب

151
00:12:04,970 --> 00:12:06,580
.خرج سانجي منتصرًا

152
00:12:06,740 --> 00:12:09,540
.لم يتبقّ سوى لوتشي وكاكو

153
00:12:25,550 --> 00:12:28,390
.تناول كاكو فاكهة الثّور، صنف الزّرافة

154
00:12:29,260 --> 00:12:32,960
وبفضلها، استطاع دفع
.زورو إلى حدوده القصوى

155
00:12:33,220 --> 00:12:38,320
،أقول أنّه لو كان الخيار لي
!فأنا أفضّل اللّحم أكثر

156
00:12:40,150 --> 00:12:42,860
!وأنا أقول أنّ ذلك ليس مهمًّا أيّها العاشب

157
00:12:45,950 --> 00:12:47,340
...أسلوب السّيفين

158
00:12:47,780 --> 00:12:48,880
...القاطعان

159
00:12:57,470 --> 00:12:58,880
!تسلّق البرج

160
00:13:01,670 --> 00:13:03,590
!ردّ تسلّق البرج

161
00:13:06,340 --> 00:13:07,890
!منجل الزّرافة

162
00:13:17,560 --> 00:13:19,860
.الجسد الحديديّ: لا نقاط عمياء

163
00:13:21,650 --> 00:13:22,520
!ماذا؟

164
00:13:32,750 --> 00:13:36,160
.أصبحتُ مكعّبًا بلا نقاط عمياء

165
00:13:37,820 --> 00:13:39,130
!زخّات الزّرافة

166
00:13:44,050 --> 00:13:45,220
!الجسد الحديديّ

167
00:13:50,180 --> 00:13:50,850
!مسدّس الأنف

168
00:13:52,180 --> 00:13:54,020
!تقطيع الغوريلّتان القويّ

169
00:14:03,400 --> 00:14:07,570
إنّك من النّوع الّذي يعجز حتّى عن
تخيّل نفسه أنّه قد يُهزم، صحيح؟

170
00:14:12,700 --> 00:14:14,200
!يا لتكبّرك

171
00:14:14,530 --> 00:14:16,370
!وكذلك أنت

172
00:14:21,110 --> 00:14:23,710
...هالة الشّيطان... أسلوب السّيوف التّسعة

173
00:14:27,550 --> 00:14:28,640
!أسورا

174
00:14:33,050 --> 00:14:34,480
!تقطيع السّماء

175
00:14:40,810 --> 00:14:43,640
!هجومي القاطع... تحوّل إلى ضباب؟

176
00:14:44,030 --> 00:14:46,070
!لا أمانع وجود العقبات

177
00:14:46,440 --> 00:14:49,400
!اخترت السّير على درب أسورا

178
00:15:00,500 --> 00:15:03,130
!أسورا: الضّباب الفضّيّ

179
00:15:18,640 --> 00:15:20,060
!زورو رجل ولا كلّ الرّجال

180
00:15:20,730 --> 00:15:24,650
في مكان آخر، كان لوفي يواجه
.لوتشي في قتال رجل لرجل

181
00:15:25,150 --> 00:15:29,210
،مهما كان ما يواجهونه الآن
!فسينجون حتمًا

182
00:15:29,400 --> 00:15:33,820
،ولكن إن تركتك تفلت الآن
!فستذهب لقتل رفاقي

183
00:15:34,380 --> 00:15:37,160
!لن أزيح عينيّ عنك

184
00:15:38,490 --> 00:15:40,560
.إنّك زعيم ممتاز

185
00:15:40,700 --> 00:15:43,580
.أودّ من أحمق ما أن يسمع هذا

186
00:15:44,250 --> 00:15:47,660
ولكن أتساءل ما إن كانت
!قدراتك كافية لتدعيم قرارك هذا

187
00:15:48,280 --> 00:15:49,130
!مسدّس الإصبع

188
00:15:50,260 --> 00:15:52,050
!ساق العاصفة! ذيل الفهد

189
00:16:00,390 --> 00:16:02,510
!أتستطيع هزيمتي؟

190
00:16:02,850 --> 00:16:05,610
!لا أستطيع حماية أحد ما لم أنتصر

191
00:16:09,650 --> 00:16:11,770
...فاكهة المطّاط

192
00:16:13,700 --> 00:16:14,950
!البندقيّة

193
00:16:16,240 --> 00:16:18,120
.الجسد الحديديّ. الشّجرة الفارغة

194
00:16:31,770 --> 00:16:33,890
!المستوى... الثّالث

195
00:16:43,740 --> 00:16:45,400
!بالون العظام

196
00:16:46,560 --> 00:16:47,510
عظام؟

197
00:16:48,200 --> 00:16:50,760
...القوّة الّتي تنتقل من عظم إلى آخر

198
00:16:51,960 --> 00:16:54,380
...انظر! ذراعي اليسرى

199
00:16:55,950 --> 00:16:58,230
!ذراعُ عملاق

200
00:16:58,740 --> 00:17:01,380
!إن كان هذا مجرّد عرض، فلا تزعج نفسك

201
00:17:01,840 --> 00:17:04,160
...فاكهة المطّاط

202
00:17:04,320 --> 00:17:05,120
!الجسد الحديديّ

203
00:17:05,450 --> 00:17:08,130
!المسدّس العملاق

204
00:17:20,470 --> 00:17:21,260
.الحلقة القصوى

205
00:17:53,710 --> 00:17:55,460
...وإلى أن أهزمك

206
00:17:57,970 --> 00:18:01,640
!فلن... أسقط أرضًا ثانية أبدًا

207
00:18:18,400 --> 00:18:20,000
...المدفع

208
00:18:21,050 --> 00:18:24,880
!الرّشّاش النّفّاث

209
00:18:42,180 --> 00:18:46,680
.في نهاية معركة شاقّة، هزم لوفي لوتشي

210
00:18:47,980 --> 00:18:49,390
!أحسنت يا لوفي

211
00:18:55,860 --> 00:18:58,710
كانت سفن نداء الدّمار تحيط بالجزيرة

212
00:18:58,860 --> 00:19:01,200
.عندما أتت ميري لاصطحابنا

213
00:19:01,340 --> 00:19:04,830
.بدونها، لكنّا لقينا حتفنا في إنيس لوبي

214
00:19:05,050 --> 00:19:09,780
!سفينة شجاعة صانعة للمعجزات

215
00:19:10,370 --> 00:19:14,240
بعد هذه الحادثة، انضمّ فريق
لوتشي إلى سي بي 0

216
00:19:14,380 --> 00:19:16,710
.وحاولوا التّأثير على أحداث دريسروزا

217
00:19:17,380 --> 00:19:21,550
إنّ لهم يدًا في كلّ عمل قذر
.وفي أماكن لا نتوقّعها

218
00:19:23,390 --> 00:19:26,850
.لا أستطيع العثور على أيّ قائمة استعملوها للتّهريب

219
00:19:27,270 --> 00:19:30,730
...لكن واضح تمامًا أنّ هنالك من سرقها

220
00:19:31,100 --> 00:19:32,310
.توقّعت ذلك

221
00:19:33,150 --> 00:19:36,300
كلّ الأسلحة والمتفجّرات الّتي تُركت في الخلف

222
00:19:36,470 --> 00:19:38,880
.سُرقت بعد الحادثة

223
00:19:39,150 --> 00:19:41,030
.كان هنالك الكثير

224
00:19:41,500 --> 00:19:43,470
.لا بدّ أنّه من صنيع منظّمة ما

225
00:19:43,740 --> 00:19:45,740
.كانت البحريّة قلقة بشأن ذلك أيضًا

226
00:19:46,410 --> 00:19:48,040
أكان الجيش الثّوريّ؟

227
00:19:48,450 --> 00:19:52,140
.نعم. ومن غيرهم؟ عد في الحال

228
00:19:53,670 --> 00:19:57,670
تتكوّن سي بي 0 من عملاء
.يتلقّون أوامر مباشرة من نبلاء العالم

229
00:19:58,060 --> 00:20:01,510
وخلال قمّة ليفيلي، كانوا يؤمّنون
.الحماية للتّنانين السّماويّين

230
00:20:02,010 --> 00:20:04,420
.يجدر بكم أن تشكروني

231
00:20:05,600 --> 00:20:07,600
.سايفر بول 0

232
00:20:08,510 --> 00:20:12,770
.بما أنّنا أوقفناكم، تمّ إنقاذ العديد من البلدان

233
00:20:13,020 --> 00:20:15,360
.لا يجب مواجهة التّنانين السّماويّين

234
00:20:15,520 --> 00:20:17,020
.حتّى الأطفال يعرفون ذلك

235
00:20:17,370 --> 00:20:21,360
.التّنانين السّماويّون آلهة أسّسوا هذا العالم

236
00:20:21,530 --> 00:20:24,780
.وكلّ ما لدينا هنا هم مجرّد ملوك للعالم الأدنى

237
00:20:24,950 --> 00:20:28,600
.وبالطّبع يجب أن نقدّم للآلهة كلّ ما يريدونه

238
00:20:28,740 --> 00:20:31,450
.وبعد ذلك، أتّجهوا إلى إيغهيد

239
00:20:31,570 --> 00:20:35,580
إنّ مهمّتنا تنصّ على إعادة
هذا الضّخم إلى إيغهيد

240
00:20:35,710 --> 00:20:38,800
.والقضاء على كلّ الفيغابانك

241
00:20:38,960 --> 00:20:41,260
...إضافة إلى التزام الحذر

242
00:20:41,580 --> 00:20:43,720
.بشأن كلّ ابتكاراته القيّمة

243
00:20:44,220 --> 00:20:47,470
يريدون منّا القضاء على أكثر
.رجل مفيد في العالم

244
00:20:50,350 --> 00:20:54,810
وهل لهذا الأمر أيّ علاقة بما
حدث للولوسيا قبل أيّام؟

245
00:21:07,700 --> 00:21:09,500
.هذا كلّ شيء لليوم

246
00:21:09,870 --> 00:21:14,200
هل سنواجه سي بي 0؟
...إنّهم لا يتعلّمون درسهم أبدًا

247
00:21:14,410 --> 00:21:16,680
.لوتشي رجل خطير للغاية

248
00:21:16,920 --> 00:21:20,670
لنأمل فقط ألاّ يحوّل مسدّس الإصبع
.خاصّته أصدقاءنا لخليّة نحل

249
00:21:21,170 --> 00:21:22,960
.توقّفي، أنت تخيفينني

250
00:21:23,210 --> 00:21:27,220
بدأت الأمور تحتدم أكثر
.على إيغهيد في كلّ الأحوال

251
00:21:27,510 --> 00:21:30,310
.لا أشعر بالقلق أبدًا بوجود لوفي وأصدقائنا هنا

252
00:21:30,430 --> 00:21:31,450
.أنت على حقّ

253
00:21:32,020 --> 00:21:33,800
.كلاّ، داهمَنا الوقت

254
00:21:34,600 --> 00:21:37,520
!إلى لقاء آخر يا رفق

255
00:21:37,690 --> 00:21:39,140
.مع السّلامة

256
00:21:45,860 --> 00:21:51,450
إلى أيّ مدى هربنا؟

257
00:21:51,450 --> 00:21:58,580
نعدّ النّدوب دون أن نعرف

258
00:21:58,580 --> 00:22:05,840
وفي بالي دائمًا، خريطة كنز

259
00:22:05,840 --> 00:22:12,310
أبحث باستمرار عن المستقبل

260
00:22:12,310 --> 00:22:25,860
توجد الوعود الحقيقيّة عميقًا في القلب

261
00:22:25,860 --> 00:22:35,330
للجميع أحلام لا يستطيع أحد اللّحاق بها

262
00:22:35,330 --> 00:22:40,960
تمسّكوا بذلك الحلم فقط

263
00:22:40,960 --> 00:22:48,090
إليك يا من تبتسم مثل الشّمس

264
00:22:48,090 --> 00:22:55,060
لنغنّ نفس الأغنية مثل ذلك اليوم

265
00:22:55,060 --> 00:23:02,110
حتّى إن كبر بنا العمر، لا أريد أن أنسى

266
00:23:02,110 --> 00:23:09,530
إلى أن تصلك هذه الأمنية

267
00:23:19,500 --> 00:23:22,330
.يواصل لوفي ولوتشي القتال بتهوّر

268
00:23:22,460 --> 00:23:26,440
ويهزم السّيرافيم الأربعة جيش
.سي بي 0 الكبير بدون رحمة

269
00:23:26,590 --> 00:23:29,920
وبينما يشهد طاقم قبّعة القشّ
،على قوّتهم الاستثنائيّة

270
00:23:30,060 --> 00:23:35,350
يبدأ فيغابانك بإخبارهم عن بحثه المهمّ
!المتعلّق بقوى فواكه الشّيطان

271
00:23:35,700 --> 00:23:37,140
:في الحلقة القادمة من وان بيس

272
00:23:37,270 --> 00:23:40,180
"!أقوى أشكال البشريّة! قوى السّيرافيم"

273
00:23:40,360 --> 00:23:42,780
!ملك القراصنة، لن يكون إلاّ أنا