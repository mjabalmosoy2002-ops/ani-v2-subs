1
00:00:40,390 --> 00:00:45,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,400 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,150 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:58,910 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,740 --> 00:01:07,250
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,250 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,380 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,050 --> 00:01:23,640
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,850
هيّا بنا

10
00:01:25,850 --> 00:01:29,190
دون توقّف

11
00:01:29,190 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,440 --> 00:01:39,990
سأواصل النّهوض على قدميّ

13
00:01:39,990 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,410 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,840 --> 00:01:56,170
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,260 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,520 --> 00:02:09,400
أوه

19
00:02:09,400 --> 00:02:11,690
هيّا بنا

20
00:02:11,690 --> 00:02:14,980
دون توقّف

21
00:02:14,980 --> 00:02:20,200
دون استسلام لمرور الوقت

22
00:02:20,200 --> 00:02:25,870
سأواصل النّهوض على قدميّ

23
00:02:25,870 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:37,760
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:34,230 --> 00:03:36,900
،بعد أن فُرّق عن بقيّة طاقمه

38
00:03:36,900 --> 00:03:41,630
أغار لوفي على مقرّ البحريّة بهدف إنقاذ
!أخيه إيس الّذي كان على وشك أن يُعدَم

39
00:03:41,630 --> 00:03:43,610
لكنّ كفاحه ذهب سدى

40
00:03:43,830 --> 00:03:49,680
.وحرب القمّة الأسطوريّة في مارينفورد انتهت

41
00:03:52,330 --> 00:03:59,210
...لكن قبل 10 سنوات، في الأزرق الشّرقيّ

42
00:03:59,210 --> 00:04:01,880
.لوفي، هذا إيس

43
00:04:01,880 --> 00:04:04,760
.ستعيش هنا معهم اعتبارًا من اليوم

44
00:04:04,760 --> 00:04:08,470
!خذني معك! لنصبح صديقين

45
00:04:28,700 --> 00:04:30,860
.إنّها نهاية الغابة

46
00:04:35,900 --> 00:04:40,230
"!ها هو ذا سابو! الفتى في غري ترمينال"

47
00:04:45,910 --> 00:04:48,400
!لا أصدّق أنّنا حقّقنا كلّ هذا المكسب

48
00:04:49,060 --> 00:04:51,140
!كان بورشيمي-سان محقًّا

49
00:04:52,030 --> 00:04:59,150
توسّل التّاجر الجشع للحصول عليه
!عندما أخبرناه أنّه كنز من الغراند لاين

50
00:04:59,150 --> 00:05:03,830
بينما في الواقع، كان مجرّد خردة
!وجدناها منفجرة في الشّاطئ

51
00:05:03,830 --> 00:05:07,350
!حالفنا الحظّ لأنّه كان مجرّد جبان لم يُبحر يومًا

52
00:05:08,580 --> 00:05:12,290
!لم نبحر نحن أيضًا

53
00:05:24,510 --> 00:05:27,340
مذهل! ما هذا المكان؟

54
00:05:28,730 --> 00:05:34,060
ثمّة مكان كهذا في الجانب الشّماليّ
.من جبل كولبو حيث تعيش عائلة دادان

55
00:05:35,040 --> 00:05:40,230
.ومعظمه كومة من القمامة المهملة

56
00:05:40,700 --> 00:05:43,690
.حيث ينتهي المطاف بالأشياء غير المرغوبة

57
00:05:44,630 --> 00:05:50,200
وهنا يعيش المحتالون الّذين تمّ
.نبذهم من المجتمع السّائد

58
00:05:50,530 --> 00:05:53,080
.ممّا لا يثير الدّهشة، إنّها منطقة منعدمة القانون

59
00:05:53,860 --> 00:05:58,030
.حيث تكثر الجرائم والأمراض نظرًا لعدم وجود أطبّاء

60
00:05:58,030 --> 00:06:01,960
.يدعى هذا المكان بغري ترمينال

61
00:06:04,200 --> 00:06:06,160
!إيس

62
00:06:11,000 --> 00:06:12,010
ما ذلك؟

63
00:06:26,000 --> 00:06:27,320
.ليس هنا

64
00:06:33,280 --> 00:06:37,000
!أنت! أين ذهبت؟

65
00:06:38,240 --> 00:06:40,120
!يا إيس

66
00:06:43,340 --> 00:06:45,800
!إيس

67
00:06:52,630 --> 00:06:55,650
.حلّ العصر بالفعل

68
00:06:57,680 --> 00:07:02,630
كنز، كنز! أيوجد أيّ شيء قيّم هنا؟

69
00:07:05,200 --> 00:07:07,030
!وجدتُ شيئًا

70
00:07:07,030 --> 00:07:08,400
!أعطني إيّاه

71
00:07:08,400 --> 00:07:09,610
!إنّه لي

72
00:07:09,610 --> 00:07:11,570
!توقّفوا! أنا من وجده

73
00:07:12,030 --> 00:07:14,070
!لا تلمسوه أيّها الحمقى

74
00:07:14,070 --> 00:07:16,580
!دعني أبعه من أجلك

75
00:07:16,580 --> 00:07:17,910
!لا يمكنك أخذه

76
00:07:17,910 --> 00:07:19,370
!توقّف

77
00:07:28,340 --> 00:07:29,250
!سحقًا لك

78
00:07:29,250 --> 00:07:29,880
!أعطني إيّاه

79
00:07:32,010 --> 00:07:36,650
!ما كنتَ لتتأذّى لو أنّك أعطيتني إيّاه

80
00:07:37,820 --> 00:07:39,520
!شكرًا جزيلاً

81
00:07:39,980 --> 00:07:42,150
!أيّها الحقير

82
00:07:44,310 --> 00:07:46,360
!لصّ

83
00:07:52,280 --> 00:07:54,320
!ابتعد عن طريقي أيّها الشّقيّ

84
00:07:55,200 --> 00:07:58,450
...أسرع! وإلاّ

85
00:07:58,450 --> 00:08:00,700
!ذهب من ذلك الاتّجاه

86
00:08:39,610 --> 00:08:41,450
!سابو! يا سابو، هل أنت هناك؟

87
00:08:44,280 --> 00:08:45,920
!هذا أنت يا إيس

88
00:08:46,580 --> 00:08:48,630
.آسف على التّأخّر

89
00:08:48,630 --> 00:08:50,050
.تأخّرت بالفعل

90
00:08:50,480 --> 00:08:53,570
.سبق وقمت ببعض الأعمال في المدينة

91
00:08:56,390 --> 00:08:59,100
.حقًّا؟ وأنا أيضًا

92
00:08:59,100 --> 00:09:00,890
!في آن واحد

93
00:09:00,890 --> 00:09:04,770
!عجبًا! حصلت على الكثير! أكثر ممّا كسبتُ بكثير

94
00:09:04,770 --> 00:09:07,770
ذلك مال كثير! كيف حصلت عليه؟

95
00:09:07,770 --> 00:09:11,280
!سرقتُ بعض البلطجيّة قرب البوّابة الرّئيسيّة

96
00:09:11,840 --> 00:09:15,280
!سحقًا! فزتَ ثانيةً

97
00:09:15,280 --> 00:09:17,420
.لا يهمّ إن فزت أو خسرت

98
00:09:18,070 --> 00:09:23,520
مضت خمس سنوات مذ بدأنا نضع
.المال في "مدّخرات القراصنة" خاصّتنا

99
00:09:26,750 --> 00:09:28,060
.عملنا بجدّ على ذلك

100
00:09:29,330 --> 00:09:30,590
.أجل

101
00:09:31,880 --> 00:09:36,380
سنغادر الأزرق الشّرقيّ ونذهب
.إلى مكان لم يحلم به هؤلاء النّاس قطّ

102
00:09:36,840 --> 00:09:39,790
!من الشّيّق مجرّد التّفكير في الأمر

103
00:09:46,270 --> 00:09:49,400
.والآن خبّئه. لا يمكننا أن ندع أيّ أحد يراه

104
00:09:49,400 --> 00:09:53,860
.أتساءل كم نحتاج للحصول على سفينة قراصنة

105
00:09:53,860 --> 00:09:57,820
لا أدري. ربّما 10 ملايين أو 100؟

106
00:09:57,820 --> 00:09:59,410
.ما زال الطّريق طويلاً أمامنا

107
00:09:59,410 --> 00:10:00,660
!سفينة قراصنة"؟"

108
00:10:01,330 --> 00:10:05,250
!يا رفاق! هل ستصبحان قرصانين؟

109
00:10:05,250 --> 00:10:08,920
!سأصبح كذلك أيضًا

110
00:10:18,760 --> 00:10:20,550
!اصمت

111
00:10:23,710 --> 00:10:27,600
!إيس! لم أعلم أنّك تقطع كلّ هذه المسافة كلّ يوم

112
00:10:27,600 --> 00:10:28,730
!اخرس

113
00:10:29,200 --> 00:10:32,560
أهذا هو لوفي الّذي كنت تتحدّث عنه؟

114
00:10:32,560 --> 00:10:35,190
!هل أخبرته عنّي؟

115
00:10:35,190 --> 00:10:37,740
.أخبرته كم أنت مزعج

116
00:10:37,740 --> 00:10:41,690
.أخبرني أيضًا أنّك غبيّ

117
00:10:42,370 --> 00:10:43,330
حقًّا؟

118
00:10:43,600 --> 00:10:46,620
لا تدرك أنّنا نقلّل من شأنك، أليس كذلك؟

119
00:10:46,620 --> 00:10:52,420
لحق بي إلى هنا أخيرًا مع أنّني لم أسلك
.أيّ طرق يمكن السّير عليها

120
00:10:52,420 --> 00:10:56,880
!هل أنت صديق إيس يا هذا؟ كن صديقي أيضًا يا هذا

121
00:10:56,880 --> 00:11:00,510
!"اخرس! وكفّ عن مناداتي "يا هذا

122
00:11:00,510 --> 00:11:02,390
ما اسمك إذًا؟

123
00:11:02,390 --> 00:11:03,140
...سا

124
00:11:03,140 --> 00:11:04,850
!لن أخبرك

125
00:11:04,850 --> 00:11:08,240
!لهذا أخبرتك أن تعيش هنا معي

126
00:11:08,240 --> 00:11:12,650
!اتّضح أنّ الرّحلة والتّدريب من وإلى الجبل فكرة سيّئة

127
00:11:12,650 --> 00:11:14,150
ما العمل؟

128
00:11:15,360 --> 00:11:20,480
.اكتشف سرّنا. سيخبر أحدًا ما لم نفعل شيئًا

129
00:11:27,200 --> 00:11:28,200
.علينا قتله

130
00:11:28,200 --> 00:11:30,120
.حسنًا، لنفعل ذلك

131
00:11:32,080 --> 00:11:34,290
!ماذا؟

132
00:11:34,960 --> 00:11:40,760
!لا تقتلاني! النّجدة! لا أريد الموت

133
00:11:40,760 --> 00:11:42,720
!اخرس أيّها الأحمق

134
00:11:43,110 --> 00:11:45,100
!سابو، اقتله بسرعة

135
00:11:45,100 --> 00:11:47,100
!ماذا؟! افعل ذلك أنت

136
00:11:47,100 --> 00:11:49,740
!لم أقتل أيّ أحد من قبل

137
00:11:49,740 --> 00:11:52,350
!ولا أنا! ولا أعرف كيف

138
00:11:52,730 --> 00:11:55,320
!لا ترمياني في الماء

139
00:11:55,320 --> 00:11:56,970
!حسنًا، لنذهب إلى النّهر

140
00:11:57,020 --> 00:11:59,230
لِمَ أخبرنا بذلك؟

141
00:11:59,230 --> 00:12:00,240
!إنّه غبيّ

142
00:12:00,240 --> 00:12:02,780
!النّجدة

143
00:12:02,780 --> 00:12:04,370
!اخرس

144
00:12:06,650 --> 00:12:08,830
!لا أريد أن أموت

145
00:12:09,430 --> 00:12:11,580
!أسمع صوتًا من الغابة

146
00:12:11,580 --> 00:12:12,750
!صوت صبيّ

147
00:12:12,750 --> 00:12:15,200
!لا! أحدهم قادم

148
00:12:15,200 --> 00:12:17,210
!حرّره في الوقت الرّاهن

149
00:12:17,210 --> 00:12:20,090
!علينا أن نتحرّك من هنا وإلاّ وجدوا كنزنا

150
00:12:22,960 --> 00:12:26,470
.الجميع يعرفون ذلكما الصبيّين هنا. إيس وسابو

151
00:12:27,560 --> 00:12:32,230
هل أنت واثق أنّ إيس من أخذ المال؟

152
00:12:32,230 --> 00:12:36,350
.أجل. نحن آسفون. لا يجب أن نهمل دفاعنا

153
00:12:36,860 --> 00:12:41,900
!كم ذلك الصّبيّ شائن! لا يمكنه سرقة مالنا ببساطة

154
00:12:42,630 --> 00:12:47,530
!إن اكتشف القبطان بلوجام بشأن هذا، سيقتلنا جميعًا

155
00:12:49,200 --> 00:12:54,100
سحقًا! لم أعلم أنّ أولئك البطلجيّون
!يعملون لصالح بلوجام

156
00:12:54,100 --> 00:12:57,000
أتقصد أنّك سرقت المال منهم؟

157
00:12:57,800 --> 00:13:00,500
...ما كان يجب أن آخذ ذلك المال

158
00:13:00,500 --> 00:13:04,550
.لديه سيف حقيقيّ
.ذلك بورشيمي الّذي يعمل لصالح بلوجام

159
00:13:05,360 --> 00:13:08,300
إنّه مجنون. هل علمت ذلك؟

160
00:13:09,440 --> 00:13:14,230
يقوم بسلخ فروة رأسك وأنت حيّ
!بعد أن تخسر نزالاً معه

161
00:13:17,900 --> 00:13:20,290
...لندعهم يمرّون فقط الآن

162
00:13:21,800 --> 00:13:23,240
ماذا؟ أين هو؟

163
00:13:25,990 --> 00:13:27,820
اتركني! ماذا تريد منّي؟

164
00:13:27,820 --> 00:13:30,080
كيف تركتهم يمسكون بك؟

165
00:13:30,080 --> 00:13:33,290
!دعني! أيّها الوغد

166
00:13:35,870 --> 00:13:37,620
من هذا الصّغير الحقير؟

167
00:13:37,620 --> 00:13:41,290
!النّجدة! إيس

168
00:13:41,960 --> 00:13:43,760
!ساعدني يا إيس

169
00:13:44,360 --> 00:13:48,010
!ذلك الأحمق! إنّه ينادي باسمي

170
00:13:44,360 --> 00:13:48,010
!النّجدة! إيس

171
00:14:03,800 --> 00:14:06,110
هل قلت "إيس" للتّوّ؟

172
00:14:07,030 --> 00:14:08,240
!وماذا إذًا؟

173
00:14:08,240 --> 00:14:10,910
هل تعرف إيس؟

174
00:14:12,370 --> 00:14:13,950
!أنا صديقه

175
00:14:14,640 --> 00:14:17,210
.لكنّه حاول قتلي للتّوّ

176
00:14:18,870 --> 00:14:21,750
!ذلك الأحمق! إنّه ثرثار

177
00:14:22,460 --> 00:14:29,470
لا أدري إن كنت تعرف هذا ولكنّ إيس
.سرق بعض المال منّا وهرب اليوم

178
00:14:29,470 --> 00:14:32,720
لا تعرف أين هو، أليس كذلك؟

179
00:14:37,170 --> 00:14:40,350
!لا! سيأخذون كلّ مالنا

180
00:14:40,350 --> 00:14:42,690
!آمل ألاّ يخبرهم ذلك الأحمق

181
00:14:50,240 --> 00:14:52,830
إذًا؟ ما قولك؟

182
00:14:56,240 --> 00:14:58,460
!ماذا؟

183
00:14:58,460 --> 00:15:01,350
...لـ-لا أدري

184
00:15:02,360 --> 00:15:03,960
!أنت فظيع في الكذب

185
00:15:12,250 --> 00:15:16,140
.حسنًا، حسنًا! ما باليد حيلة لأنّك لا تعرف

186
00:15:19,480 --> 00:15:22,900
!لا تقلق، سأساعدك على استعادة ذاكرتك

187
00:15:24,150 --> 00:15:27,190
!ماذا تفعل؟! اتركني! إلى أين تأخذني؟

188
00:15:27,190 --> 00:15:29,900
!سحقًا! غبيّ! اتركني

189
00:15:29,900 --> 00:15:33,370
!أيّها الوغد! دعني! ماذا تفعل أيّها الوغد؟

190
00:15:35,280 --> 00:15:36,660
!ما العمل؟

191
00:15:36,660 --> 00:15:39,340
...تعلم ما علينا فعله

192
00:15:47,670 --> 00:15:49,510
!دعني

193
00:15:49,510 --> 00:15:52,040
!لن أخبرك بأيّ شيء

194
00:15:59,720 --> 00:16:01,690
!أيّها الحقير الصّغير

195
00:16:15,920 --> 00:16:19,410
أخبرتك أنّ جسدي تحوّل إلى مطّاط
!بعدما أكلتُ فاكهة المطّاط

196
00:16:19,410 --> 00:16:21,290
!اخرس

197
00:16:22,570 --> 00:16:25,460
فاكهة الشّيطان إذًا؟

198
00:16:26,210 --> 00:16:28,230
.يبدو أنّ هذا حقيقيّ

199
00:16:30,760 --> 00:16:33,330
.اجلبوا لي قفّازين

200
00:16:33,330 --> 00:16:34,680
!حـ-حاضر

201
00:16:34,680 --> 00:16:38,300
!بسرعة، بسرعة! نحن هالكان إن عادوا

202
00:16:38,510 --> 00:16:41,240
!علينا أن ننقل كنزلنا إلى مكان آخر

203
00:16:42,060 --> 00:16:45,270
!إنّها مسألة وقت إلى أن يخبرهم لوفي

204
00:16:45,270 --> 00:16:48,650
لن يأخذوا ما سرقنا منهم فحسب

205
00:16:48,650 --> 00:16:52,860
بل وحتّى "مدّخرات القراصنة" الّتي
!أمضينا خمس سنوات في جمعها

206
00:16:58,450 --> 00:17:00,450
.اسمع أيّها الحقير الصّغير

207
00:17:00,450 --> 00:17:06,040
المال الّذي سرقه صديقك إيس مهمّ جدًّا
.من أجل طاقم قراصنتنا

208
00:17:06,850 --> 00:17:09,340
.وأنت تعرف أين هو

209
00:17:09,340 --> 00:17:11,960
.لذا أحتاج منك أن تخبرنا

210
00:17:13,510 --> 00:17:14,640
!لا

211
00:17:22,100 --> 00:17:23,730
!أفلح الأمر

212
00:17:27,940 --> 00:17:30,860
!لا تريد إغضاب قرصان

213
00:17:31,400 --> 00:17:35,990
!قبطاننا بلوجام قاسٍ حقًّا

214
00:17:43,580 --> 00:17:46,080
!هذا مؤلم! أنا خائف

215
00:17:46,080 --> 00:17:47,710
!النّجدة

216
00:17:50,710 --> 00:17:55,510
!أنتم، اذهبوا وابحثوا عن إيس وسابو
!لا نملك الوقت للوقوف

217
00:17:55,510 --> 00:17:56,920
!حـ-حاضر

218
00:18:05,000 --> 00:18:07,980
تسألانني إن كنت أعرف إيس وسابو؟

219
00:18:08,360 --> 00:18:11,040
.لا بدّ أنّكما مشاغبان من المدينة

220
00:18:11,880 --> 00:18:14,690
.لا أنصحكما بالعبث مع ذلكما الاثنين

221
00:18:15,740 --> 00:18:18,450
.إنّهما صبيّان لكن لا يجب أن تستخفّا بهما

222
00:18:18,450 --> 00:18:21,240
.إنّهما ككلبين مسعورين سيقتلان حتّى نمرًا

223
00:18:21,240 --> 00:18:24,560
.إيس وسابو؟ لم أرهما منذ مدّة

224
00:18:25,310 --> 00:18:30,360
على أيّ حال أيّها الشابّان، لِمَ لا تتركان
كلّ ما هو قيّم معكما هنا؟

225
00:18:30,360 --> 00:18:32,300
!بـ-بربّك يا صاح

226
00:18:32,300 --> 00:18:34,280
!سنسأل أحدًا آخر

227
00:18:34,840 --> 00:18:39,130
ما زالوا لا يعلمون أين نحن؟

228
00:18:39,560 --> 00:18:41,770
...ظننت أنّهم سيكونون قد عرفوا الآن

229
00:18:43,410 --> 00:18:44,720
!كلاّ

230
00:18:47,380 --> 00:18:49,270
.لم أدرك أنّ اللّيل وشيك

231
00:18:50,080 --> 00:18:51,980
!أجل! انتهيت

232
00:18:51,980 --> 00:18:54,320
!نقلنا كلّ الكنز

233
00:19:00,450 --> 00:19:03,490
ما بال ذلك الصّبيّ؟

234
00:19:07,370 --> 00:19:09,120
!يا إيس

235
00:19:09,120 --> 00:19:13,000
سابو! ما الخطب؟ هل أتوا للبحث عن المال؟

236
00:19:15,710 --> 00:19:18,210
!كلاّ، لم يأتوا

237
00:19:18,210 --> 00:19:21,090
!وأراهن أنّهم لن يأتوا

238
00:19:21,090 --> 00:19:22,360
ماذا تقصد؟

239
00:19:22,360 --> 00:19:24,260
...ذلك الفتى، لوفي

240
00:19:25,310 --> 00:19:27,600
!لم يخبرهم بأيّ شيء

241
00:19:29,180 --> 00:19:32,230
!أنا واثق أنّهم يعذّبونه

242
00:19:32,230 --> 00:19:36,440
!ظننت أنّه سيخبرهم بما أنّه مغفّل وبكّاء

243
00:19:36,440 --> 00:19:38,150
!هذا غير منطقيّ

244
00:19:39,740 --> 00:19:41,720
...إلّم نفعل شيئًا، سوف

245
00:19:50,460 --> 00:19:53,170
!تأخّر الوقت

246
00:19:53,580 --> 00:19:55,790
من المسؤول اليوم؟

247
00:19:56,540 --> 00:19:59,840
.بورشيمي أيّها القبطان بلوجام

248
00:20:00,640 --> 00:20:02,800
.أوشك المغيب

249
00:20:06,550 --> 00:20:10,210
.أنا واثق أنّهما صرفا الكنز بالفعل الآن

250
00:20:10,850 --> 00:20:14,190
.ربّما يهرب بالمال

251
00:20:15,240 --> 00:20:20,490
مستحيل! لا أظنّ أنّه سيخاطر
!بأن يُقتل ليحاول فعل شيء كهذا

252
00:20:22,160 --> 00:20:23,950
!لا أظنّ ذلك أيضًا

253
00:20:31,800 --> 00:20:34,790
!أخبرنا بسرعة

254
00:20:38,040 --> 00:20:43,340
!بـ-بـ-بورشيمي-سان
!لا فائدة من فعل ذلك بعد الآن

255
00:20:45,840 --> 00:20:49,100
!ما عاد يملك الطّاقة حتّى ليصرخ الآن

256
00:20:53,730 --> 00:20:59,600
،أراهن أنّه لن يقول أيّ شيء وللأمانة
!لا أطيق مشاهدة هذا... هذا قاسٍ بحقّ

257
00:20:59,600 --> 00:21:02,320
!أظهر بعض الرّأفة

258
00:21:04,740 --> 00:21:08,780
ابحث عن إيس وسابو إن كنت تملك
!الوقت للدّفاع عن الصّبيّ

259
00:21:09,320 --> 00:21:13,160
!حياتنا نحن المهدّدة! ألا ترى؟

260
00:21:13,540 --> 00:21:18,790
!تأخّرنا بالفعل لإعطاء ذلك المال للقبطان بلوجام

261
00:21:23,510 --> 00:21:27,520
كيف أمكنهم فعل ذلك لصبيّ صغير؟
أيجب أن نستدعي رئيس شرطة المدينة؟

262
00:21:28,060 --> 00:21:31,850
.لا فائدة. هذه المنطقة ليست مشملة بقانون البلاد

263
00:21:31,850 --> 00:21:36,080
.كما أنّه عضو في طاقم بلوجام

264
00:21:36,080 --> 00:21:38,400
.وهم يدفعون مالاً للنّبلاء

265
00:21:38,400 --> 00:21:43,400
.سيغفلون عن أيّ جرائم أو قتل مرتكبة في هذه البلاد

266
00:21:44,110 --> 00:21:48,870
.لن تصرف جثّة أخرى انتباه أيّ أحد هنا

267
00:21:50,030 --> 00:21:52,080
!أجبني

268
00:21:53,340 --> 00:21:54,700
.لن أخبرك

269
00:21:55,730 --> 00:22:00,420
!أيّها الحقير الصّغير
!كفّ عن محاولة صون سرّ كالكبار

270
00:22:04,210 --> 00:22:06,720
!أخبرني

271
00:22:09,260 --> 00:22:15,310
!لن أخبرك

272
00:22:19,010 --> 00:22:20,810
!لن أخبرك

273
00:22:30,800 --> 00:22:32,700
.حسنًا. يكفي

274
00:22:51,610 --> 00:22:53,010
.فلتمت إذًا

275
00:23:14,080 --> 00:23:16,990
!توقّف

276
00:23:25,510 --> 00:23:30,590
.أغار إيس وسابو على مخبأ بورشيمي لإنقاذ لوفي الأسير

277
00:23:30,590 --> 00:23:32,890
،على الرّغم من قوّة القراصنة الكاسحة

278
00:23:32,890 --> 00:23:36,890
،يجد سابو فرصة لإنقاذ لوفي ويحاول من أجل ذلك

279
00:23:36,890 --> 00:23:40,440
...في حين يفصح إيس عن قرار مفاجئ

280
00:23:40,440 --> 00:23:41,920
:في الحلقة القادمة من وان بيس

281
00:23:41,920 --> 00:23:45,190
"!لن أهرب! عمليّة إنقاذ إيس اليائسة"

282
00:23:45,190 --> 00:23:47,840
!ملك القراصنة، لن يكون إلاّ أنا

283
00:23:50,030 --> 00:23:55,030
!!نلقاكم في الحلقة القادمة