.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,370 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:06,680 --> 00:02:09,890
!يا قراصنة اليقطين، انطلقوا

22
00:02:14,960 --> 00:02:16,990
الكنز الّذي نسعى إليه قابعٌ
!في تلك الجزيرة

23
00:02:16,990 --> 00:02:20,300
،من يصل إليها أوّلاً
!سيحصل على مكافأة

24
00:02:24,300 --> 00:02:25,800
!مـ-مهلاً

25
00:02:28,640 --> 00:02:31,080
!انتظروني! أنا قادم أيضًا

26
00:02:32,310 --> 00:02:33,380
.لا تستطيع

27
00:02:36,310 --> 00:02:39,180
أنت كبير الآن، أليس كذلك؟

28
00:02:48,330 --> 00:02:49,390
!انتظروني

29
00:02:50,160 --> 00:02:53,800
!رابا نوي! إيسوكا! رونغو
!أكيبي! بوكاو

30
00:02:54,330 --> 00:02:56,230
!لا تتركوني وحدي

31
00:02:57,230 --> 00:03:00,810
!لا تتركوني هنا

32
00:03:06,140 --> 00:03:07,140
...كنتُ أحلم

33
00:03:07,140 --> 00:03:09,280
أنت قلق على أصدقائك، صحيح؟

34
00:03:10,350 --> 00:03:12,680
.كنت تنادي على أسمائهم أثناء نومك

35
00:03:15,590 --> 00:03:17,790
ما كان المغزى من كلّ ذلك بالضّبط؟

36
00:03:17,790 --> 00:03:21,760
لِمَ كرّستُ خمسين سنة من عمري
في البحث عن ضباب قوس قزح؟

37
00:03:21,760 --> 00:03:24,830
برؤيتي لرابا نوي
،والبقيّة كما كانوا حينها

38
00:03:25,200 --> 00:03:28,930
يجعلني ذلك أنا على الأقلّ أفكّر
.أنّني أهدرتُ كلّ ذلك الوقت

39
00:03:28,930 --> 00:03:30,730
لم تُهدره، صحيح؟

40
00:03:30,730 --> 00:03:33,470
رأيت أصدقاءك القدامى
.مجدّدًا بالفعل

41
00:03:33,470 --> 00:03:34,940
...لستُ واثقًا

42
00:03:38,310 --> 00:03:40,410
أهذه السّفينة تتحرّك؟

43
00:03:40,980 --> 00:03:42,750
...لا يُفترض أن تفعل

44
00:03:46,820 --> 00:03:51,020
مشاعر الحنين! مقبرة القراصنة"
"!الّتي لا خروج منها

45
00:03:52,660 --> 00:03:54,160
!إلى الأمام

46
00:03:54,660 --> 00:03:56,430
!إلى الأمام بأقصى سرعة

47
00:03:56,660 --> 00:04:00,030
أواثق أنّنا نسير إلى الأمام يا لوفي؟

48
00:04:00,030 --> 00:04:02,600
!نعم! إلى الأمام مباشرةً

49
00:04:03,830 --> 00:04:06,040
إلى أين أنتم ذاهبون بالضّبط؟

50
00:04:06,040 --> 00:04:08,070
!إلى أين؟ سنخرج من الضّباب

51
00:04:08,610 --> 00:04:10,040
.لا تكن سخيفًا

52
00:04:10,670 --> 00:04:14,410
،"فور أن تدخل إلى "حفلة القرد
.لن تخرج منها ثانيةً

53
00:04:14,410 --> 00:04:16,250
.إنّها منطقة بحر شيطانيّة

54
00:04:16,950 --> 00:04:21,090
مهلاً، ألم نرَ تلك السّفينة قبل وهلة؟

55
00:04:21,620 --> 00:04:22,820
.لا تنزعج من ذلك

56
00:04:22,820 --> 00:04:25,090
.ثمّة سفن مشابهة أينما ذهبت

57
00:04:25,090 --> 00:04:30,160
كلاّ، لقد مرّت هذه السّفينة من
.نفس المكان الأوّل الّذي رسونا فيه

58
00:04:30,590 --> 00:04:33,060
أذكر رؤية رمز الإلهة
!في مقدّمة السّفينة

59
00:04:33,060 --> 00:04:37,700
أ-أيعني هذا أنّنا عدنا من حيث بدأنا؟

60
00:04:38,300 --> 00:04:41,740
لهذا سألتك إن كنت واثقًا
!من أنّنا نسير إلى الأمام

61
00:04:41,740 --> 00:04:43,910
!كنتُ أراقب! كنّا نسير إلى الأمام

62
00:04:44,310 --> 00:04:47,410
لا يمكنك الجزم إن كنّا نسير إلى الأمام
وسط هذا الضّباب، أليس كذلك؟

63
00:04:47,410 --> 00:04:48,080
...لا يعقل

64
00:04:51,120 --> 00:04:52,780
!ستّ زهور

65
00:05:08,770 --> 00:05:10,230
!لِمَ فعلت ذلك؟

66
00:05:10,230 --> 00:05:12,800
!أطلقنا إلى الأمام، لكنّها عادت من خلفنا

67
00:05:12,800 --> 00:05:14,310
.عرفتها

68
00:05:14,310 --> 00:05:16,510
.الفضاء مشوّه

69
00:05:16,840 --> 00:05:18,080
ماذا تقصد؟

70
00:05:18,780 --> 00:05:21,110
.أذكرُ أنّي قرأتُ شيئًا في كتاب

71
00:05:21,110 --> 00:05:24,720
.إنّ داخل ضباب قوس قزح أشبه بمتاهة

72
00:05:25,950 --> 00:05:28,320
...غومو غومو نوو

73
00:05:26,920 --> 00:05:28,920
!مهلاً، لا تتهوّر

74
00:05:28,320 --> 00:05:31,360
!الصّاروخ

75
00:05:31,960 --> 00:05:32,920
.فات الأوان

76
00:05:33,360 --> 00:05:37,600
.لن يعود إلى نفس المكان بالضّرورة

77
00:05:37,600 --> 00:05:39,330
!ذلك الأحمق

78
00:05:46,340 --> 00:05:47,610
.فهمت

79
00:05:47,610 --> 00:05:50,670
هذا ضباب غامض، بحيث أنّ أينما
.ذهبت، ستعود من حيث بدأت

80
00:05:51,380 --> 00:05:53,540
."إنّه "ضباب غامض

81
00:05:53,840 --> 00:05:56,310
هل أنتم واثقون أنّكم فهمتم؟

82
00:05:56,650 --> 00:05:59,180
على الأقلّ جزئيّة عدم مقدرتنا
.على الخروج من هنا

83
00:06:00,950 --> 00:06:03,350
!لسنا بحاجة للخروج. المكان ممتع

84
00:06:03,350 --> 00:06:04,020
!بلى، علينا ذلك

85
00:06:04,560 --> 00:06:06,990
.لننضمّ إلى رابا نوي والبقيّة

86
00:06:08,230 --> 00:06:09,260
لأولئك الصّبية؟

87
00:06:09,490 --> 00:06:11,830
"أفضل طريقة لنا للخروج من "حفلة القرد

88
00:06:11,830 --> 00:06:15,170
هي باستشارة الّذين يملكون المنطقة، صحيح؟

89
00:06:15,170 --> 00:06:19,140
نعم، لكن أين هم؟

90
00:06:19,140 --> 00:06:22,110
.لنسأل ذلك الصبيّ هناك

91
00:06:25,740 --> 00:06:27,110
!كيف وجدتني؟

92
00:06:27,110 --> 00:06:28,610
.لا فائدة من الاختباء

93
00:06:29,950 --> 00:06:31,180
.زهرة واحدة

94
00:06:33,120 --> 00:06:34,950
هلاّ أخذتنا؟

95
00:06:35,290 --> 00:06:37,520
.إلى زعيمكم

96
00:06:42,960 --> 00:06:44,300
!مستحيل

97
00:06:46,130 --> 00:06:48,930
أقلتما أنّ هينزو عاد كرجلٍ عجوز؟

98
00:06:48,930 --> 00:06:51,270
أيّ نكتة هذه؟

99
00:06:51,270 --> 00:06:53,140
.ليست نكتة

100
00:06:53,540 --> 00:06:58,410
،لقد سقط إلى البحر لإنقاذنا
.ولم نره منذ حينها

101
00:07:00,810 --> 00:07:03,110
!أعدكم أن ألحق بكم لاحقًا

102
00:07:03,310 --> 00:07:05,620
!اذهبوا! تابعوا طريقكم ولا تقلقوا بشأني

103
00:07:06,980 --> 00:07:09,320
.ما زال حيًّا، في العالم الخارجيّ

104
00:07:09,650 --> 00:07:15,330
قال هينزو أنّه كان يبحث عن طريقةٍ
،لإعادتنا طوال هذا الوقت في لولوكا

105
00:07:15,330 --> 00:07:17,660
!وأنّه مرّت خمسون سنة، بتلك البساطة

106
00:07:18,930 --> 00:07:21,430
.خمسون سنة؟ هذا سخيف

107
00:07:21,830 --> 00:07:24,840
أواثقون أنّ ذلك العجوز لا يخدعكم؟

108
00:07:24,840 --> 00:07:27,070
ولِمَ قد يخدعنا؟

109
00:07:27,940 --> 00:07:29,870
.ما كنتُ لأعرف

110
00:07:29,870 --> 00:07:32,910
،لكن إن كان ما قاله هينزو صحيحًا

111
00:07:32,910 --> 00:07:34,810
.أتساءل ما حلّ ببلدة لولوكا

112
00:07:37,280 --> 00:07:39,280
...أبي... أمّي

113
00:07:39,950 --> 00:07:42,250
.لا فائدة من القلق بشأن ذلك

114
00:07:42,250 --> 00:07:45,490
ستعرفون إن كان ذلك صحيحًا
.أم لا فور أن تعودوا وتروا بأعينكم

115
00:07:46,120 --> 00:07:47,560
هل تعرف طريقة للرّجوع؟

116
00:07:48,330 --> 00:07:50,030
.بالطّبع

117
00:07:50,030 --> 00:07:53,560
،أنا قائد غارات قراصنة ويتّون

118
00:07:53,560 --> 00:07:54,770
.إيان-ساما

119
00:07:54,770 --> 00:07:57,800
أخبرني بالطّريقة للرّجوع
!إلى بلدة لولوكا

120
00:07:57,800 --> 00:07:58,740
!أكيد

121
00:07:58,740 --> 00:08:01,240
!أحضروا لي المفتاح فحسب

122
00:08:01,240 --> 00:08:06,180
،إن أخرجتموني من هنا
.سأقودكم وأعيدكم إلى دياركم

123
00:08:08,150 --> 00:08:09,510
!رونغو! أكيبي

124
00:08:10,310 --> 00:08:11,720
.لا تدعاه يخدعكما

125
00:08:12,420 --> 00:08:15,090
.يريد إيان الخروج من هنا فحسب

126
00:08:15,590 --> 00:08:19,790
قوله أنّه يعرف طريقة للرّجوع
.إلى العالم الخارجيّ ما هي إلاّ حيلة

127
00:08:20,590 --> 00:08:21,730
حيلة؟

128
00:08:23,830 --> 00:08:25,260
.أنت قاسية يا إيسوكا-تشان

129
00:08:25,600 --> 00:08:30,100
لم أنس كلّ تلك الأوقات
.الّتي عاملتنا بسوء فيها

130
00:08:32,270 --> 00:08:34,710
!اسمعوا أيّها المبتدئون

131
00:08:34,710 --> 00:08:37,980
!مع الإبحار تأتي المخاطر دائمًا

132
00:08:38,240 --> 00:08:39,740
،إن كنتم تريدون النّجاة

133
00:08:39,740 --> 00:08:44,680
فلتتّبعوا أوامر قائد غارات
!قراصنة ويتّون، إيان-ساما

134
00:08:46,820 --> 00:08:49,820
هذا رائع! تلك السّفينة هناك
!مليئة بالجواهر أيضًا

135
00:08:50,150 --> 00:08:53,020
.حسنًا، خذها إلى مقرّ القائد

136
00:08:53,320 --> 00:08:54,860
!كما أنّه كان لديهم كلّ هذا الطّعام

137
00:08:55,330 --> 00:08:58,130
.حسنًا، خذوا ذلك إلى مقرّ القائد أيضًا

138
00:08:58,130 --> 00:09:00,130
!ثعبان بحر

139
00:09:04,970 --> 00:09:06,900
!النّجدة

140
00:09:08,470 --> 00:09:10,070
!النّجدة

141
00:09:08,710 --> 00:09:10,070
!لا تهرب منه، واجهه

142
00:09:11,940 --> 00:09:13,510
!ر-رونغو

143
00:09:14,450 --> 00:09:15,980
!رابا نوي

144
00:09:22,920 --> 00:09:24,020
!انتظر

145
00:09:27,090 --> 00:09:28,060
!خذ هذه

146
00:09:39,540 --> 00:09:41,540
!لِمَ ترمقونني بتلك النّظرات؟

147
00:09:41,540 --> 00:09:44,680
النّظر إلى وجوهكم العابسة
.يجعل مذاق الطّعام سيّئًا

148
00:09:45,680 --> 00:09:46,710
.تذكّروا

149
00:09:46,710 --> 00:09:52,220
تمكّنتم من البقاء أحياء حتّى الآن
!بفضل وجودي في هذه السّفينة فحسب

150
00:09:53,280 --> 00:09:55,390
،عليكم شكري على الأقلّ

151
00:09:55,390 --> 00:09:57,390
لكن لم يرمقني أحد قطّ
!بنظرات ناقدة كهذه

152
00:10:02,730 --> 00:10:03,930
!ما هذا؟

153
00:10:09,600 --> 00:10:12,000
استُدرج إلى هنا بسبب رائحة
!الطّعام، أليس كذلك؟

154
00:10:12,300 --> 00:10:14,140
!رفاق، اخرجوا

155
00:10:14,840 --> 00:10:18,880
!انتظروا! هذه سفينتي! احموها

156
00:10:19,510 --> 00:10:22,410
وهل سفينتك أكثر أهمّيّة
!من حياة الجميع؟

157
00:10:22,410 --> 00:10:24,920
!لا حاجة لنا لقائد مثلك

158
00:10:41,600 --> 00:10:44,200
!...سحقًا! سفينتي

159
00:10:44,670 --> 00:10:46,970
.نحن أفضل حالاً من دونها

160
00:10:46,970 --> 00:10:50,110
.بدأت رحلتنا الحقيقيّة الآن

161
00:10:54,040 --> 00:10:58,180
،لقد سئمنا منك وكلامك التّافه دائمًا

162
00:10:58,180 --> 00:10:59,650
!كما أنّك لا تفكّر سوى في نفسك

163
00:11:00,120 --> 00:11:01,850
.أظنّ أنّكم تكرهونني

164
00:11:01,850 --> 00:11:06,190
لكن ماذا إن كنتُ أعرف
طريق الخروج من هنا فعلاً؟

165
00:11:06,190 --> 00:11:07,630
!كذبة ساذجة أخرى

166
00:11:08,090 --> 00:11:10,230
.اختبريني إذًا وتحقّقي ما إن كنتُ أكذب

167
00:11:11,200 --> 00:11:14,700
أنت قلقة بشأن بلدة لولوكا
أيضًا، أليس كذلك؟

168
00:11:14,700 --> 00:11:18,470
فور أن نأخذ كلّ الكنوز
،"القابعة في "حفلة القرد

169
00:11:18,470 --> 00:11:22,810
يمكننا أن نعيش برخاء
!إلى آخر يومٍ في حياتنا

170
00:11:22,810 --> 00:11:25,810
لسنا بحاجة للعيش هنا كقراصنة
.في هذا الضّباب الأغبش

171
00:11:25,810 --> 00:11:29,110
ما رأيكم؟ تعالوا معي
.إلى العالم الخارجيّ

172
00:11:29,450 --> 00:11:32,750
.قائدنا الوحيد هو رابا نوي

173
00:11:32,750 --> 00:11:35,520
.لن يتبعك أيٌّ منّا

174
00:11:35,820 --> 00:11:38,460
.يا إلهي، لن يجدي الكلام معك نفعًا

175
00:11:38,460 --> 00:11:41,990
حسنًا، خذي وقتك وفكّري
.في الأمر يا إيسوكا-تشان

176
00:11:45,430 --> 00:11:46,560
!ما الّذي يجري؟

177
00:11:46,560 --> 00:11:47,630
!ثمّة سفينة قادمة

178
00:11:48,270 --> 00:11:51,600
!تأهّبوا للقتال جميعًا
!حصّنوا دفاعاتنا

179
00:11:51,600 --> 00:11:54,910
كيف عرفوا أين نحن؟

180
00:11:57,680 --> 00:11:58,740
!أذلك...؟

181
00:12:00,340 --> 00:12:00,910
!بوكاو

182
00:12:04,180 --> 00:12:08,520
!تلك السّفينة ضخمة

183
00:12:09,020 --> 00:12:10,450
تلك سفينة حربيّة محطّمة، صحيح؟

184
00:12:10,450 --> 00:12:13,820
.نعم. إنّها قاعدتنا الآن

185
00:12:15,560 --> 00:12:16,230
!أيّها الجبناء

186
00:12:16,630 --> 00:12:18,160
!كيف تجرؤون على أسر بوكاو؟

187
00:12:18,700 --> 00:12:20,260
عمّاذا تتحدّث؟

188
00:12:21,000 --> 00:12:22,270
!لا مزيد من الكلام

189
00:12:25,240 --> 00:12:26,940
!حرّروا بوكاو

190
00:12:44,700 --> 00:12:46,970
!أيّها المحافظ! إنّها التّالييليسين

191
00:12:48,470 --> 00:12:50,740
.سفينتي القديمة العزيزة

192
00:12:52,140 --> 00:12:56,680
لكن يا جدّي، لِمَ تعود
هذه السّفينة الآن؟

193
00:12:56,680 --> 00:12:57,210
!هذا مؤلم

194
00:12:57,210 --> 00:12:59,350
!"أخبرتك أن تناديني بـ"المحافظ

195
00:12:59,350 --> 00:13:00,110
.حاضر

196
00:13:00,110 --> 00:13:01,350
.انظر هناك

197
00:13:02,050 --> 00:13:06,020
قبل خمسين سنة، اختفت
.سفينتي داخل ذلك الضّباب

198
00:13:06,020 --> 00:13:08,690
،وبما أنّ السّفينة عادت

199
00:13:08,690 --> 00:13:12,230
.ذلك يعني أنّ بوّابة "حفلة القرد" فُتحت

200
00:13:12,960 --> 00:13:13,590
،بعبارات أخرى

201
00:13:13,590 --> 00:13:17,870
هذه فرصتنا الوحيدة إن أردنا الحصول
على الكنز الّذي في الدّاخل، صحيح؟

202
00:13:17,870 --> 00:13:21,300
هذا صحيح. لكن كيف تعلمين ذلك؟

203
00:13:21,300 --> 00:13:24,970
.لقد أخبرني حفيدك

204
00:13:24,970 --> 00:13:26,640
!أيّها الأهوج

205
00:13:26,640 --> 00:13:29,640
!رغم أنّي أخبرتك أنّ الكنز سرّ

206
00:13:29,640 --> 00:13:32,480
.أنا آسف يا جدّي... أقصد، أيّها المحافظ

207
00:13:32,480 --> 00:13:36,220
لا بدّ أنّ امتلاك أقارب أغبياء
.شيء مزعج بالفعل

208
00:13:38,090 --> 00:13:39,050
.معك حقّ

209
00:13:39,050 --> 00:13:41,920
!ولِمَ تتعاطفين معي؟

210
00:13:42,190 --> 00:13:46,330
على أيّ حال، بما أنّكم تعرفون
،"سرّ "حفلة القرد

211
00:13:46,330 --> 00:13:47,560
.لا يمكنكم الرّحيل

212
00:13:49,430 --> 00:13:51,270
هل ستخرسنا إذًا؟

213
00:13:51,500 --> 00:13:54,700
"كلاّ، بل ستدفعون ضريبةَ "عرفتُ السّرّ

214
00:13:54,700 --> 00:13:57,510
.وهي عشرة ملايين بيري

215
00:13:58,710 --> 00:14:00,240
!أهذه مزحة؟

216
00:14:00,240 --> 00:14:02,240
!بالأحرى، هذا كثير

217
00:14:02,240 --> 00:14:04,710
!بالأحرى، أيّ ضريبة هذه؟

218
00:14:04,980 --> 00:14:07,080
أتقصدون أنّكم لا تستطيعون دفع الضّريبة؟

219
00:14:07,520 --> 00:14:08,850
!فريق تحصيل الضّرائب

220
00:14:15,090 --> 00:14:17,090
هل استدعيتنا أيّها المحافظ ويتّون؟

221
00:14:18,390 --> 00:14:19,390
!بابا

222
00:14:19,390 --> 00:14:20,930
بابا؟

223
00:14:21,860 --> 00:14:25,870
خذهم إلى برج قوس قزح
.واحكم عليهم بالأشغال الشّاقّة

224
00:14:26,130 --> 00:14:27,570
ما هذا؟

225
00:14:28,570 --> 00:14:30,570
.ذلك هو برج قوس قزح

226
00:14:31,270 --> 00:14:35,110
ستواصلون العمل في ذلك
.البرج حتّى الموت

227
00:14:35,110 --> 00:14:37,950
.أعمال شاقّة وجحيميّة، ليلاً ونهارًا

228
00:14:37,950 --> 00:14:40,580
.ستودّعون الحياة بسرعة

229
00:14:41,950 --> 00:14:44,690
.هيّا يا فيليب، خذهم من هنا

230
00:14:44,690 --> 00:14:49,060
،لقد ظهر ضباب قوس قزح
!أليس كذلك يا أبي؟

231
00:14:49,060 --> 00:14:53,090
إنّها فرصتنا للحصول على
!"الكنز من "حفلة القرد

232
00:14:53,330 --> 00:14:55,430
.قال كلّ شيء للتّوّ

233
00:14:55,900 --> 00:14:58,100
لا يلقون أيّ شأن للأسرار، أليس كذلك؟

234
00:14:58,100 --> 00:15:00,500
.أجيال عائلتهم الثّلاثة كلّها مغفّلة

235
00:15:00,500 --> 00:15:03,300
!أيّها المعتوه! حسنًا

236
00:15:03,300 --> 00:15:06,310
استدعِ هينزو واجعله
!يتحرّى عن ضباب قوس قزح

237
00:15:06,310 --> 00:15:09,640
!صحيح! أحضروا لي حلزون اتّصال حالاً

238
00:15:06,310 --> 00:15:09,640
.أبي، ما زلتَ قويًّا للغاية

239
00:15:09,640 --> 00:15:10,310
!حاضر

240
00:15:11,680 --> 00:15:14,120
!مهلاً، هدّئ من روعك

241
00:15:14,120 --> 00:15:15,180
!اخرس

242
00:15:15,180 --> 00:15:19,190
أخذتم بوكاو رهينةً وأرغمتموه
!على إخباركم عن مقرّنا، أليس كذلك؟

243
00:15:20,220 --> 00:15:21,690
.سيكون ذلك مخزيًا

244
00:15:24,430 --> 00:15:27,360
!رابا نوي، لستُ رهينةً

245
00:15:27,930 --> 00:15:31,730
طلبوا منّي إحضارهم
!إلى هنا فحسب، فأحضرتهم

246
00:15:31,730 --> 00:15:33,730
!هدّدوك لتقول هذا

247
00:15:34,800 --> 00:15:37,810
بل هذه الحقيقة! هؤلاء الأشخاص
!ليسوا سيّئين كما أخبرتك

248
00:15:38,110 --> 00:15:41,280
!انظر، لا يغضب حتّى عندما أقوم بهذا

249
00:15:42,440 --> 00:15:46,280
غير صحيح! كلّ هذه استراتيجيّة
!لجعلنا نرخي دفاعاتنا

250
00:15:46,280 --> 00:15:47,750
.أسأت الفهم

251
00:15:47,980 --> 00:15:52,220
إنّنا نريد معرفة طريقة الخروج
.من "حفلة القرد" فقط

252
00:15:52,220 --> 00:15:53,750
وبعد أن تعرفوا؟

253
00:15:54,820 --> 00:15:58,830
تخطّطون لأخذ كلّ الكنوز من هذه
!السّفن المحطّمة وتهربوا بها

254
00:15:58,830 --> 00:16:00,800
.صدّقني يا رابا نوي

255
00:16:00,800 --> 00:16:02,900
ما كان هؤلاء الأشخاص
.ليفعلوا ذلك على الأقلّ

256
00:16:03,230 --> 00:16:05,630
!وكيف لي أن أثق بكلام شخصٍ كبير؟

257
00:16:05,830 --> 00:16:07,900
!أتوا لأخذ الكنز بالطّبع

258
00:16:08,270 --> 00:16:09,840
.لا فائدة من الكلام

259
00:16:09,840 --> 00:16:11,270
!رفاق

260
00:16:11,640 --> 00:16:14,980
!انظروا! غذاء اختصاص أوسوبّ جاهز

261
00:16:14,980 --> 00:16:17,240
!مرحى! طعام

262
00:16:17,240 --> 00:16:18,710
هل تريدان بعضه أيضًا؟

263
00:16:19,110 --> 00:16:20,550
أيمكننا؟

264
00:16:21,180 --> 00:16:23,450
.لكن لا يمكنني أن أضمن المذاق

265
00:16:23,450 --> 00:16:25,720
ومن طلب منك أن تفعل؟

266
00:16:25,720 --> 00:16:28,560
لذيذ! هل أعددت هذا حقًّا؟

267
00:16:28,560 --> 00:16:30,260
.لا يوجد ما لا أستطيع فعله

268
00:16:30,260 --> 00:16:32,130
!يا لوفي! لا تأكلها كلّها وحدك

269
00:16:32,790 --> 00:16:35,260
،ليست بلذّة طبخ سانجي
.لكنّها لذيذة عامّةً

270
00:16:35,260 --> 00:16:39,130
.شكرًا. عشتُ لوحدي لوقتٍ طويل

271
00:16:36,060 --> 00:16:38,430
.ثمّة بعض الأطفال هناك يبدون جائعين

272
00:16:40,200 --> 00:16:42,270
!تعالوا إلى هنا يا رفاق

273
00:16:42,270 --> 00:16:43,870
!إنّها لذيذة

274
00:16:43,870 --> 00:16:45,240
أيمكننا حقًّا؟

275
00:16:45,240 --> 00:16:46,370
!حسنًا

276
00:16:47,580 --> 00:16:49,110
!لا تدعوهم يخدعونكم بالطّعام

277
00:16:49,980 --> 00:16:52,810
!هل نسيتم فخركم كقراصنة اليقطين؟

278
00:16:54,010 --> 00:16:55,150
!رابا نوي

279
00:16:56,320 --> 00:16:58,390
.لن يملأ الفخر معدتك

280
00:16:59,490 --> 00:17:02,620
ماذا؟ أتيتم من الأزرق الشّرقيّ؟

281
00:17:04,290 --> 00:17:05,090
.نعم

282
00:17:05,490 --> 00:17:08,700
ما يعني أنّكم عبرتم الجبل المعكوس؟

283
00:17:08,700 --> 00:17:10,360
!أنتم شجعان

284
00:17:10,830 --> 00:17:14,900
نعم، لقد خضنا غمار الكثير
.من المغامرات حتّى الآن

285
00:17:14,900 --> 00:17:17,910
تقاتلنا مع العمالقة وثعابين
،البحر الّتي تلتهم الجزر برمّتها

286
00:17:17,910 --> 00:17:20,710
.حتّى أنّنا أنقذنا بلادًا من منظّمة سريّة

287
00:17:20,710 --> 00:17:22,380
مذهل، حقًّا؟

288
00:17:22,380 --> 00:17:23,310
!مذهل

289
00:17:23,310 --> 00:17:25,910
لكنّنا نجونا من كلّ المصاعب

290
00:17:25,910 --> 00:17:29,150
!بفضل حكمتي وشجاعتي فقط

291
00:17:29,420 --> 00:17:33,650
واحترامًا لذلك، يناديني
"...الجميع بـ"القائد

292
00:17:35,420 --> 00:17:36,860
!لِمَ فعلت هذا؟

293
00:17:36,860 --> 00:17:39,060
.كفّ عن البصق بينما يأكل النّاس

294
00:17:47,440 --> 00:17:50,400
!رابا نوي، سامحني

295
00:17:50,670 --> 00:17:52,810
!اعذر نفسي المخزية

296
00:17:52,810 --> 00:17:58,410
أمضيتُ خمسين سنة في البحث
،لإنقاذكم من ضباب قوس قزح

297
00:17:58,410 --> 00:18:01,750
،وتمكّنتُ أخيرًا من دخول الضّباب

298
00:18:01,750 --> 00:18:04,750
.لكن بسبب طيشي، لا يمكننا الخروج

299
00:18:05,120 --> 00:18:06,890
!أنا فاشل كأستاذ قرصان

300
00:18:07,560 --> 00:18:10,290
،لكنّي سأبلع خزيي وأسألك

301
00:18:10,290 --> 00:18:12,760
!إن كنت تعرف طريقةً، فأخبرني رجاءً

302
00:18:12,760 --> 00:18:15,230
كيف يمكننا الخروج من هذا الضّباب؟

303
00:18:15,230 --> 00:18:19,470
حينها يمكننا أن نغادر سويًّا
.ونعود إلى ديارنا

304
00:18:20,430 --> 00:18:22,070
.لا يوجد مخرج

305
00:18:23,100 --> 00:18:26,070
،وما كنتُ لأخبرك به
.حتّى إن كنتُ أعرف

306
00:18:27,310 --> 00:18:30,910
.ما زلت لا أثق بكم قبل كلّ شيء

307
00:18:32,850 --> 00:18:34,850
وتعتبرون أنفسكم أصدقاء؟

308
00:18:34,850 --> 00:18:35,550
!ماذا؟

309
00:18:36,650 --> 00:18:40,590
دعك منّا، لكنّ هذا العمّ
صديقك، أليس كذلك؟

310
00:18:40,590 --> 00:18:43,690
أخبرني، إن كنت لا تثق
بأصدقائك، فبمن ستثق؟

311
00:18:44,260 --> 00:18:46,060
!لا تتدخّل في هذا

312
00:18:46,460 --> 00:18:51,170
أتتوقّع منّي أن أصدّق أنّه مرّت
خمسون سنة بهكذا بساطة؟

313
00:18:51,470 --> 00:18:53,300
!صدّق ذلك

314
00:18:53,700 --> 00:18:57,640
مهما مضى من الوقت
،ومهما اختلف مظهره

315
00:18:57,640 --> 00:19:00,880
إن كنتما صديقين ويجمع
،بينكما نفس العَلم

316
00:19:00,880 --> 00:19:01,940
!عليكما أن تعرفا بعضكما

317
00:19:01,940 --> 00:19:05,810
،قد يبهت لون علمكما
!لكنّ الصّداقة أبديّة

318
00:19:11,190 --> 00:19:12,690
.هذا لي

319
00:19:12,690 --> 00:19:15,360
.حسنًا، حسنًا، سأجيب

320
00:19:16,390 --> 00:19:17,760
نعم، مرحبًا؟

321
00:19:17,760 --> 00:19:19,890
!لِمَ أجبت أنت؟

322
00:19:19,890 --> 00:19:21,760
أهذا الأستاذ هينزو؟

323
00:19:23,260 --> 00:19:24,270
من أنت؟

324
00:19:24,270 --> 00:19:27,130
ماذا؟ بل من أنت؟

325
00:19:27,770 --> 00:19:28,800
لوفي، أهذا أنت؟

326
00:19:28,800 --> 00:19:30,170
أين أنتم؟

327
00:19:30,840 --> 00:19:33,570
،لقد أبحرتم من أنفسكم

328
00:19:33,570 --> 00:19:35,810
!وتركتم بقيّتنا في مأزق عويص

329
00:19:36,180 --> 00:19:37,780
ماذا؟ أهذه أنت يا نامي؟

330
00:19:38,080 --> 00:19:40,250
هل أنت متّصل بنامي والبقيّة؟

331
00:19:40,250 --> 00:19:41,020
نامي؟

332
00:19:41,020 --> 00:19:44,350
...انتظر، إن كنّا نستطيع الحديث معها

333
00:19:44,820 --> 00:19:46,920
!هل نحن متّصلون بالعالم الخارجيّ؟

334
00:19:46,920 --> 00:19:48,920
!فيليب؟! فيليب، هل أنت هناك؟

335
00:19:48,920 --> 00:19:50,320
!نعم، هذا فيليب

336
00:19:51,090 --> 00:19:53,260
أستاذ هينزو، أين أنت؟

337
00:19:53,260 --> 00:19:55,560
.أنا داخل ضباب قوس قزح

338
00:19:55,860 --> 00:19:56,530
!ماذا؟

339
00:19:57,630 --> 00:19:58,370
...ضباب

340
00:19:58,970 --> 00:19:59,900
قوس قزح؟

341
00:20:00,330 --> 00:20:03,270
.نحن غير قادرين على الخروج حاليًّا

342
00:20:03,270 --> 00:20:05,240
آسف، لكن هلاّ أتيتم لإنقاذنا؟

343
00:20:05,540 --> 00:20:07,070
!هل سيأتي أحد لنجدتنا؟

344
00:20:07,310 --> 00:20:10,210
!بإمكاننا العودة إلى لولوكا، صحيح؟

345
00:20:10,210 --> 00:20:11,780
أليس هذا عظيمًا يا رابا نوي؟

346
00:20:11,780 --> 00:20:16,480
لا يوجد وقت. أخبر ويتّون
أن يتجهّز بعُدّة البحث الآمن

347
00:20:16,480 --> 00:20:19,750
.الّذي اخترعتها ويدخل إلى الضّباب

348
00:20:20,490 --> 00:20:21,560
...أيضًا

349
00:20:22,120 --> 00:20:23,090
!ماذا تفعل؟

350
00:20:23,720 --> 00:20:26,490
...الاسم الّذي قلته، ويتّون

351
00:20:26,490 --> 00:20:29,800
هو نفس الرّجل الّذي أحرق
!بلدة لولوكا، أليس كذلك؟

352
00:20:29,800 --> 00:20:35,400
مهلاً! اضطررت للتّعاون مع ذلك
!الرّجل من أجل إنقاذكم جميعًا

353
00:20:35,700 --> 00:20:36,970
.اتّضح كلّ شيء الآن

354
00:20:37,570 --> 00:20:40,310
!لستَ هينزو الّذي نعرفه

355
00:20:40,310 --> 00:20:42,840
،إن كنت أحد قراصنة اليقطين

356
00:20:43,180 --> 00:20:46,380
!يستحيل أن تصبح بيدقًا لدى ويتّون

357
00:20:46,850 --> 00:20:48,050
...رابا نوي

358
00:20:48,950 --> 00:20:50,720
!لا تنادني بذلك الاسم

359
00:20:51,450 --> 00:20:52,920
!أنت خائن

360
00:20:52,920 --> 00:20:55,960
مرحبًا؟ مرحبًا؟

361
00:20:56,290 --> 00:21:00,260
يا إلهي، إنّهم داخل
ذلك الضّباب فعلاً، أليس كذلك؟

362
00:21:00,730 --> 00:21:01,660
ما العمل؟

363
00:21:01,660 --> 00:21:04,730
.أليس هذا واضحًا؟ سندخل إلى الضّباب

364
00:21:04,930 --> 00:21:06,600
!مهلاً لحظة

365
00:21:08,500 --> 00:21:09,870
،أخبرتكم

366
00:21:09,870 --> 00:21:13,210
لا يمكنكم الدّخول
.إلى "حفلة القرد" بدون إذني

367
00:21:13,210 --> 00:21:15,710
...تابعوا التّصرّف كما يحلو لكم، وسوف

368
00:21:16,910 --> 00:21:20,280
بالمناسبة، أين عُدّة الأمن
الّتي ذكرها سابقًا؟

369
00:21:20,280 --> 00:21:21,820
.هنا

370
00:21:21,820 --> 00:21:22,580
!شكرًا لك

371
00:21:22,580 --> 00:21:23,450
.العفو

372
00:21:23,450 --> 00:21:24,750
!لِمَ أعطيتها لهم؟

373
00:21:24,750 --> 00:21:26,320
!شكرًا

374
00:21:26,320 --> 00:21:29,560
!أيّها الحمقى! ألقوا القبض عليهم فورًا

375
00:21:29,560 --> 00:21:30,020
!حاضر

376
00:21:32,460 --> 00:21:35,060
.وأنا الّذي أردت أن أجعل من هروبنا طريفًا

377
00:21:43,470 --> 00:21:44,370
!اذهبي يا نامي

378
00:21:44,370 --> 00:21:48,140
!حسنًا! دعا لوفي والبقيّة والذّهب لي

379
00:21:56,150 --> 00:21:56,620
!نامي-سان

380
00:22:02,360 --> 00:22:03,160
!ماذا؟

381
00:22:09,430 --> 00:22:17,500
آه، خلف السّماء الّتي لا نهاية لها

382
00:22:17,500 --> 00:22:28,120
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

383
00:22:35,990 --> 00:22:43,430
مرّت عليّ أيّام كدت أخسر فيها نفسي

384
00:22:43,430 --> 00:22:51,840
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

385
00:22:51,840 --> 00:23:00,050
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

386
00:23:00,050 --> 00:23:08,890
دفعوا بي للأمام، أليس كذلك؟

387
00:23:08,890 --> 00:23:17,200
آه، إنّ النّجوم تهوي من السّماء

388
00:23:17,200 --> 00:23:20,330
...وهذه اللّحظة الفريدة

389
00:23:25,670 --> 00:23:27,270
!يا رفاق

390
00:23:27,270 --> 00:23:29,210
.هذه أنت يا نامي

391
00:23:29,210 --> 00:23:30,710
!ماذا تقصد بـ"هذه أنت"؟

392
00:23:30,710 --> 00:23:33,480
!بعد أن قطعتُ كلّ هذه المسافة لأنقذكم

393
00:23:33,880 --> 00:23:35,080
أين لوفي إذًا؟

394
00:23:35,080 --> 00:23:36,050
.ليس موجودًا

395
00:23:36,880 --> 00:23:39,120
.لقد اختفى خلف الضّباب

396
00:23:39,120 --> 00:23:41,290
ماذا؟ ماذا تقصد؟

397
00:23:41,290 --> 00:23:42,360
:في الحلقة القادمة من ون بيس

398
00:23:42,360 --> 00:23:46,130
اشتباكٌ محتوم! مخطّطات"
"!ويتّون وبرج قوس قزح

399
00:23:46,130 --> 00:23:48,360
!ملك القراصنة، لن يكون إلاّ أنا