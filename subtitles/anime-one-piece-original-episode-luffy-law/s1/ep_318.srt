1
00:00:15,570 --> 00:00:17,490
...الثّروة والشّهرة والسّلطة

2
00:00:17,490 --> 00:00:19,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:19,450 --> 00:00:21,370
.ملك القراصنة، غولد روجر

4
00:00:21,370 --> 00:00:25,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:25,080 --> 00:00:28,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:28,840 --> 00:00:32,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:34,800 --> 00:00:39,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:39,720 --> 00:00:42,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:43,520 --> 00:00:48,110
سنجمع كل أحلامنا

10
00:00:49,110 --> 00:00:54,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:54,950 --> 00:00:56,570
!وان بيس

12
00:01:01,080 --> 00:01:05,920
لا تجلب البوصلات سوى التّأخيرات

13
00:01:06,750 --> 00:01:11,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:12,460 --> 00:01:17,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:17,760 --> 00:01:23,310
!فإنّها ليست أسطورة إذًا

16
00:01:24,520 --> 00:01:30,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:30,230 --> 00:01:35,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:35,400 --> 00:01:37,990
!وتظاهر أنّها غير موجودة

19
00:01:38,990 --> 00:01:43,830
سنجمع كلّ أحلامنا

20
00:01:44,830 --> 00:01:50,340
ونبحر باحثين عن شيء

21
00:01:50,340 --> 00:01:53,340
،عملة في جيبي

22
00:01:53,340 --> 00:01:56,590
وتريد أن تصبح صديقي؟

23
00:01:56,590 --> 00:02:01,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:02:01,970 --> 00:02:03,890
!إنّنا كذلك

25
00:02:06,790 --> 00:02:10,000
...الثّروة والشّهرة والسّلطة

26
00:02:11,100 --> 00:02:15,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:16,840 --> 00:02:22,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:23,320 --> 00:02:27,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:27,400 --> 00:02:31,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:32,260 --> 00:02:36,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:37,350 --> 00:02:41,400
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:03:03,520 --> 00:03:05,160
!لا تتكلّم بسخف

33
00:03:05,160 --> 00:03:08,120
أتظنّ أنّك تستطيع شراء سيف
!حقيقيّ بذلك المبلغ الزّهيد؟

34
00:03:08,120 --> 00:03:09,470
...حسنٌ

35
00:03:09,470 --> 00:03:11,140
!انقلع إن كنت لن تشتري أيّ شيء

36
00:03:11,140 --> 00:03:12,560
...يا إلهي

37
00:03:16,990 --> 00:03:18,750
...على أيّ حال

38
00:03:32,440 --> 00:03:34,520
...إلّم تخنّي الذّاكرة، إنّهما

39
00:03:34,520 --> 00:03:36,270
!تقدّم رجاءً

40
00:03:37,360 --> 00:03:39,000
...حقًّا

41
00:03:39,000 --> 00:03:42,250
!آسفان لأنّنا حاولنا ابتزازك

42
00:03:42,250 --> 00:03:45,530
لا تقلقا بشأن ذلك! شكرًا على
!إرشادي إلى الطّريق! إلى اللّقاء

43
00:03:47,540 --> 00:03:49,540
.الشّقيّان اللّذان دلاّني إلى الطّريق تلك المرّة

44
00:03:50,080 --> 00:03:51,290
!زورو-سان! زورو-سان

45
00:03:51,620 --> 00:03:53,500
!كن أخانا الكبير رجاءً

46
00:04:00,330 --> 00:04:04,540
!الأمّهات قويّات"
"!أعمال زورو المنزليّة المحمومة

47
00:04:06,360 --> 00:04:07,390
.أرفض

48
00:04:07,390 --> 00:04:09,080
!ماذا؟! حقًّا؟

49
00:04:09,080 --> 00:04:13,190
لِمَ عساي أصبح أخًا كبيرًا لشقيّين مثلكما؟

50
00:04:13,900 --> 00:04:15,640
.بربّك، لا تكن هكذا

51
00:04:15,640 --> 00:04:19,850
!لقد أعجبنا بك كثيرًا بعد رؤيتك تهزم البحريّة

52
00:04:19,850 --> 00:04:22,780
.أنا مايكل. سعيد للقائك

53
00:04:22,780 --> 00:04:23,950
.وأنا هويكل

54
00:04:24,530 --> 00:04:27,950
حول الشّوارع الخلفيّة، نحن الأخوان
...مشهوران قليلاً بـ

55
00:04:28,910 --> 00:04:31,750
!عليك أن تنصت للنّاس

56
00:04:32,500 --> 00:04:34,750
.أخي، سنأخذك حيثما تشاء

57
00:04:34,750 --> 00:04:36,800
أتريد الذّهاب لشراء بعض اللّحم؟
ماذا عن بعض الخضراوات؟

58
00:04:36,800 --> 00:04:37,710
.أرفض

59
00:04:37,710 --> 00:04:39,070
ترفض؟ ترفض ماذا؟

60
00:04:39,070 --> 00:04:41,380
.أن أصبح أخاكما الكبير وأن تدلاّني إلى الطّريق

61
00:04:41,380 --> 00:04:43,020
.اغربا عن وجهي

62
00:04:43,020 --> 00:04:45,340
نعم، صحيح! أخي، أنت تسعى
لشراء سيف، صحيح؟

63
00:04:45,340 --> 00:04:49,310
رفض أن يبيعني صاحب محلّ السّيوف
.سابقًا بما أنّني لا أملك الكثير من المال

64
00:04:49,620 --> 00:04:53,990
.إذًا عليك الذّهاب لمحلّ البضع المُستعملة
!أراهن أنّك ستجد صفقة رائعة

65
00:04:53,990 --> 00:04:56,980
نعم! سندلّ أخانا الكبير
!إلى محلّ البضع المستعملة

66
00:04:58,610 --> 00:04:59,940
.أظنّ أنّ ذلك لن يضرّ

67
00:05:00,330 --> 00:05:03,730
لكن دعاني أوضّح لكما أنّني
.لم أقبل أن أصبح أخاكما الكبير

68
00:05:03,730 --> 00:05:05,210
!نعم يا أخونا الكبير

69
00:05:05,990 --> 00:05:08,320
!هيّا، أفسحوا الطّريق، أفسحوا الطّريق

70
00:05:08,320 --> 00:05:10,500
!صائد القراصنة زورو-ساما سيمرّ

71
00:05:10,500 --> 00:05:11,160
!توقّفا

72
00:05:31,190 --> 00:05:34,020
.تهرّبا من المدرسة ويتسكّعان ثانيةً

73
00:05:34,020 --> 00:05:36,840
.لن يكونا مفيدين في شيء عندما يكبران
...يا لهما من طفلين جاحدين

74
00:05:36,840 --> 00:05:39,830
...في بيتهما، الأمّ هي الّتي

75
00:05:39,830 --> 00:05:42,360
.أشعر بالأسى على ذلكما الطّفلين

76
00:05:52,350 --> 00:05:53,990
.لم يحالفني الحظّ هنا أيضًا

77
00:05:54,820 --> 00:05:56,290
!إلامَ تنظران؟

78
00:05:56,290 --> 00:05:58,000
!هذا فظّ تجاه أخينا الكبير زورو

79
00:06:01,960 --> 00:06:04,280
اسمع، أليس ذلك السّياف الّذي برفقتهما

80
00:06:04,280 --> 00:06:07,670
هو أحد القراصنة الّذين أنقذوا أيسبرغ-سان؟

81
00:06:07,670 --> 00:06:10,130
.ماذا؟ ظننتُ أنّه بطل

82
00:06:10,130 --> 00:06:12,300
.أهو مجرّد رعاع إذًا؟ أخطأتُ الحكم عليه

83
00:06:13,490 --> 00:06:15,770
.لديكما سمعة استثنائيّة

84
00:06:15,770 --> 00:06:18,670
.أهل البلدة جاهلون

85
00:06:18,670 --> 00:06:20,940
.دعهم يقولون ما يشاؤون عنّا. لا نهتمّ لهم

86
00:06:20,940 --> 00:06:22,570
.حقًّا؟ طوبى لكما إذًا

87
00:06:22,570 --> 00:06:23,970
.حسنًا، إلى اللّقاء

88
00:06:23,970 --> 00:06:25,230
مـ-ماذا تقصد؟

89
00:06:25,230 --> 00:06:27,400
!هل ستتخلّى عن أخويك الصّغيرين العزيزين؟

90
00:06:27,400 --> 00:06:29,830
!كما قلت، لم أوافق أن أصبح أخاكما الكبير

91
00:06:29,830 --> 00:06:31,600
هل قلت شيئًا؟

92
00:06:31,600 --> 00:06:33,490
.لا نسمع أيّ شيء

93
00:06:33,490 --> 00:06:37,250
!عجبًا! ما ذلك؟

94
00:06:37,250 --> 00:06:38,930
!ماذا؟! ماذا؟

95
00:06:50,890 --> 00:06:52,370
.حسنًا، تخلّصت منهما

96
00:06:52,370 --> 00:06:53,470
!أخي

97
00:06:53,470 --> 00:06:55,100
!ماذا؟

98
00:07:04,000 --> 00:07:04,780
!أخي

99
00:07:12,970 --> 00:07:13,860
!أخي

100
00:07:16,360 --> 00:07:17,200
!أخي

101
00:07:18,500 --> 00:07:21,210
!أخي! أخي! أخي

102
00:07:21,210 --> 00:07:22,650
!أخي

103
00:07:33,480 --> 00:07:36,210
.نعرف هذه البلدة عن ظهر قلب

104
00:07:36,210 --> 00:07:38,350
.لا يمكنك أن تهرب منّا

105
00:07:39,030 --> 00:07:43,400
!اخرس! كفّا عن السّخريّة منّي أيّها الشّقيّان

106
00:07:44,330 --> 00:07:46,050
!هذا قاسٍ يا أخي

107
00:07:46,050 --> 00:07:48,110
!لا تنادني بأخيك

108
00:07:53,230 --> 00:07:54,500
من أنت يا هذه؟

109
00:07:54,500 --> 00:07:56,700
ماذا تظنّ نفسك فاعلاً بضربك لطفليّ؟

110
00:07:56,700 --> 00:07:59,200
...طفلاك؟ إذًا

111
00:08:01,450 --> 00:08:05,670
!يا لها من قوّة! ما بال هذه المرأة؟

112
00:08:08,790 --> 00:08:10,950
.لا بأس بك يا فتى

113
00:08:10,950 --> 00:08:15,810
!إذًا... الهجوم الخاصّ! زوبعة بام-بام

114
00:08:18,810 --> 00:08:21,570
!توقّفي يا أمّي! لم يرتكب أيّ خطأ

115
00:08:21,570 --> 00:08:22,980
!كان خطأنا نحن

116
00:08:24,580 --> 00:08:28,190
!هل أسأتما التّصرّف ثانيةً؟! أيّها الغبيّان

117
00:08:35,240 --> 00:08:36,740
.آسفة بشأن ذلك

118
00:08:36,740 --> 00:08:40,180
لكن أظنّ أنّ لا بأس، صحيح؟
بما أنّك أصبحت أخاهما الكبير؟

119
00:08:40,180 --> 00:08:41,700
.كلاّ، لم أصبح كذلك

120
00:08:42,620 --> 00:08:44,690
.اخرجوا يا أولاد وألقوا التّحيّة

121
00:08:44,690 --> 00:08:45,870
.أنا يوكو

122
00:08:45,870 --> 00:08:47,130
.أنا يويا

123
00:08:48,010 --> 00:08:48,960
.أنا شو

124
00:08:48,960 --> 00:08:50,270
.أنا أياكو

125
00:08:50,270 --> 00:08:51,590
.أنا أكيهيرو

126
00:08:51,770 --> 00:08:53,790
!رفاق، هذا أخونا الكبير زورو

127
00:08:53,790 --> 00:08:55,790
!إنّه أخونا الكبير الجديد

128
00:08:55,790 --> 00:08:59,180
أخوكما الكبير؟ لا تقولا لي أنّكما تريدان
منّي أن أصبح أخاكما الكبير حقًّا؟

129
00:09:00,160 --> 00:09:02,460
،تعال معنا. نحن متخلّفون في أعمالنا المنزليّة

130
00:09:02,460 --> 00:09:05,140
بما أنّنا أمضينا الكثير من الوقت
.في ترميم بيتنا عقب أكوا لاغونا

131
00:09:06,740 --> 00:09:08,870
!أخي! أخي

132
00:09:08,870 --> 00:09:13,080
!انتظروا! لم أوافق على هذا! دعوني

133
00:09:13,080 --> 00:09:14,720
!والآن، لنعد إلى البيت يا أولاد

134
00:09:14,720 --> 00:09:16,450
!أجل

135
00:09:28,950 --> 00:09:30,290
بالمناسبة، ما ذلك؟

136
00:09:30,660 --> 00:09:34,140
بينما تخرج أمّي للعمل، نذهب
لجمع خشب الخردة من الميناء

137
00:09:34,140 --> 00:09:35,980
،بينما نجالس أشقّاءنا

138
00:09:35,980 --> 00:09:38,860
،وعندما نحصل على ما يكفي من الخشب
.نذهب لبيعه في غالي-لا عند نهاية الأسبوع

139
00:09:38,860 --> 00:09:41,020
يمكننا أن نجني الكثير من
.أموال مصروفنا بتلك الطّريقة

140
00:09:42,330 --> 00:09:44,490
.حسنًا، ودّعا أمّكما عنّي

141
00:09:44,490 --> 00:09:45,990
هل ستغادر حقًّا؟

142
00:09:45,990 --> 00:09:48,550
...آسف، لكن لا علاقة لي بهذا، لذا

143
00:09:48,550 --> 00:09:49,060
!احترس

144
00:09:54,520 --> 00:09:55,170
...يا إلهي

145
00:09:55,170 --> 00:09:56,150
!أحسنت في رعاية الطّفل

146
00:09:58,000 --> 00:09:58,990
!أخي

147
00:10:04,830 --> 00:10:06,900
.لا بأس بك حقًّا

148
00:10:06,900 --> 00:10:09,000
!كما توقّعت، أنت بارع مع الأطفال

149
00:10:11,380 --> 00:10:13,460
!لقد بلّل نفسه

150
00:10:15,030 --> 00:10:16,360
.ناوله لي

151
00:10:17,250 --> 00:10:18,430
.اذهب وغيّر حفّاظاته

152
00:10:18,430 --> 00:10:18,970
!عُلم

153
00:10:18,970 --> 00:10:22,100
!أ-أنت! ماذا تفعلين؟! هل أنت منحرفة؟

154
00:10:22,100 --> 00:10:24,680
.سنغسله. ارتد هذا ريثما يجفّ

155
00:10:26,640 --> 00:10:29,060
!مـ-ما هذا؟

156
00:10:29,930 --> 00:10:31,340
اعتن به، مفهوم؟

157
00:10:31,340 --> 00:10:34,490
!حسنًا يا أولاد! لنعمل بجدّ وننظّف البيت

158
00:10:34,490 --> 00:10:35,890
!أجل

159
00:10:41,880 --> 00:10:44,410
...يا هويكل. آسف، لكنّي

160
00:10:50,540 --> 00:10:52,260
!أنت، أنت... أنت

161
00:10:52,260 --> 00:10:53,260
!توقّف

162
00:10:55,850 --> 00:10:58,260
...يا مايكل! افعل شيئًا بشأنهما

163
00:11:01,020 --> 00:11:01,970
!توقّف

164
00:11:16,960 --> 00:11:19,540
...أنتم! أين أضع هؤلاء الـ

165
00:11:23,600 --> 00:11:26,340
.لديك موهبة فطريّة في هذا. واصل

166
00:11:36,840 --> 00:11:39,970
.حسنًا، أحسنوا التّصرّف

167
00:11:43,530 --> 00:11:47,470
.يا سيّدتي. سأعود الآن. أعيدي لي قميصي

168
00:11:48,140 --> 00:11:49,630
عمّ تتحدّث؟

169
00:11:49,630 --> 00:11:52,650
ألديك ملجأ آخر أساسًا غير هذا البيت؟

170
00:11:52,650 --> 00:11:54,640
.نعم. أصدقائي ينتظرونني

171
00:11:54,640 --> 00:11:58,110
يا للغباء! الأصدقاء أو العائلة... أيّهم أهمّ؟

172
00:11:58,110 --> 00:12:02,190
،لستُ من عائلتك. لا أذكر أنّك أنجبتني

173
00:12:02,190 --> 00:12:03,700
.كما أنّنا لسنا مرتبطين بصلة دمّ

174
00:12:03,700 --> 00:12:06,800
!اخرس! بئس روابط الدّم

175
00:12:06,800 --> 00:12:08,830
!هل روابط الدّم بتلك الأهمّيّة؟

176
00:12:13,810 --> 00:12:16,130
.سنسوّي هذه المسألة اليوم بالتّأكيد

177
00:12:16,610 --> 00:12:17,710
.اغربوا

178
00:12:17,710 --> 00:12:22,290
،أتيت إلى هنا البارحة وما قبل البارحة
!لكنّك لم تردّي لنا الدّين أيّتها الحقيرة

179
00:12:22,290 --> 00:12:23,940
ماذا؟ ومن أنت؟

180
00:12:23,940 --> 00:12:26,980
.أشعر وكأنّني رأيتك في مكان ما من قبل
هل أنت عضو جديد في عائلتهم؟

181
00:12:26,980 --> 00:12:27,810
.نعم

182
00:12:26,980 --> 00:12:27,810
.لا

183
00:12:27,800 --> 00:12:29,400
!نعم أم لا؟

184
00:12:29,400 --> 00:12:30,880
.لا يهمّ

185
