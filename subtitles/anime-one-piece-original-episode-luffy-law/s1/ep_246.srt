1
00:00:18,200 --> 00:00:19,740
!لا تذهبي يا روبين

2
00:00:20,200 --> 00:00:22,120
!لم ينته كلامنا بعد

3
00:00:22,120 --> 00:00:27,080
.بلى، انتهى. لن أراكم ثانيةً أبدًا

4
00:00:30,760 --> 00:00:33,880
!لوفي! أسرع وأمسك روبين

5
00:00:40,260 --> 00:00:41,020
!روبين

6
00:00:48,810 --> 00:00:51,610
!كيف لهم أن يكونوا أقوياء هكذا؟

7
00:00:57,410 --> 00:00:59,660
ما أنتم؟

8
00:01:00,410 --> 00:01:01,990
.نحن سي بي 9

9
00:01:02,830 --> 00:01:05,290
.هذا أمر فائق السّرّيّة على مستوى العالم

10
00:01:06,040 --> 00:01:09,380
.ليست مسألة ليتدخّل فيها أمثالكم

11
00:01:11,960 --> 00:01:15,590
.اقترب وقت انفجار أجهزة الإشعال
.علينا أن نسرع أيضًا

12
00:01:15,590 --> 00:01:16,470
.نعم

13
00:01:16,470 --> 00:01:18,300
.لكنّ هذه مناسبة نادرة

14
00:01:18,300 --> 00:01:21,560
.دعوني أريكم شيئًا مثيرًا للاهتمام قبل أن أذهب

15
00:01:43,370 --> 00:01:45,080
!فاكهة شيطان

16
00:01:46,710 --> 00:01:47,920
!ما هي؟

17
00:01:56,260 --> 00:01:59,300
لوتشي... ما الّذي...؟

18
00:02:01,180 --> 00:02:03,260
...فاكهة القطّ

19
00:02:06,890 --> 00:02:09,020
...من صنف النّمر المرقّط

20
00:02:10,730 --> 00:02:12,860
...إنسان نمر

21
00:02:12,860 --> 00:02:14,360
!إ-إنّه ضخم

22
00:02:15,110 --> 00:02:17,990
!ما بال شكله؟

23
00:02:18,950 --> 00:02:21,320
!ما أنت بالضّبط؟

24
00:02:28,000 --> 00:02:32,040
لا بأس! هيّا نمضي قُدمًا

25
00:02:32,340 --> 00:02:35,550
فالشّمس تُدفئ قلوبنا دومًا

26
00:02:35,710 --> 00:02:39,010
قوّةٌ تعبر بين أيادينا المتشابكة

27
00:02:39,130 --> 00:02:42,680
هيّا نُحقّق أمنيّاتنا

28
00:02:50,270 --> 00:02:56,480
بالعمل معًا، دعونا نركب الأمواج العاتية

29
00:02:57,780 --> 00:03:04,240
دعونا نسرع إلى التّشويق... ها هي إشارة البداية

30
00:03:11,960 --> 00:03:18,970
عبر الرّيح الملوّنة بألوان الطّيف نخترق صوبَ بحرِ المغامرة

31
00:03:19,090 --> 00:03:22,510
لن تسلم رحلتنا من الإصابات

32
00:03:22,590 --> 00:03:26,220
لكنّ ما نعتزّ به سيكون هناك

33
00:03:26,430 --> 00:03:30,350
وإن وقعت في مأزق

34
00:03:30,440 --> 00:03:32,350
ستجدني معك لأحميك

35
00:03:33,480 --> 00:03:37,320
لا بأس! هيّا نمضي قُدمًا

36
00:03:37,690 --> 00:03:40,780
فالشّمس تُدفئ قلوبنا دومًا

37
00:03:41,200 --> 00:03:44,320
حتّى إن عصفت عاصفة، سنعانق بعضنا

38
00:03:44,410 --> 00:03:48,200
ونوجّه ناظرنا إلى الضّوء البعيد

39
00:03:48,700 --> 00:03:51,920
إن جمعنا شظايا أحلامنا

40
00:03:52,420 --> 00:03:55,540
سنُشكّل خريطةً تقودنا إلى الغد

41
00:03:55,710 --> 00:03:58,670
لذا لنُحقّق أمنيّاتنا

42
00:03:59,130 --> 00:04:04,390
علمٌ واحد يجمعنا، نحن واحد

43
00:04:04,510 --> 00:04:06,470
وان بيس

44
00:04:17,040 --> 00:04:21,750
القضاء على قراصنة قبّعة القشّ؟"
"!تهديد صنف النّمر المرقّط

45
00:04:27,030 --> 00:04:28,780
!حريق

46
00:04:28,780 --> 00:04:30,740
!يا جماعة! استيقظوا

47
00:04:31,250 --> 00:04:34,960
سحقًا! أهذا من صنيع القراصنة؟

48
00:04:34,960 --> 00:04:37,670
!لا بدّ أنّه لا يزال الكثير من النّاس في الدّاخل

49
00:04:37,670 --> 00:04:41,300
!أين أيسبرغ-سان؟! ما الّذي يجري في الأعلى؟

50
00:04:41,300 --> 00:04:42,840
!لنذهب للتّفقّد

51
00:04:42,840 --> 00:04:47,300
!أسرعوا! أخمدوا النّار

52
00:04:58,440 --> 00:05:00,770
.يبدو أنّ النّار بدأت تنتشر

53
00:05:05,400 --> 00:05:09,280
لا أدري إن كنتَ إنسانًا نمرًا
...أم ماذا، لكن

54
00:05:09,280 --> 00:05:11,950
!لن أدعك تمسّ أيسبرغ-سان بسوء

55
00:05:14,290 --> 00:05:19,340
!يصبح مستخدمو نوع زون اللاّحم أكثر عدوانيّة

56
00:05:19,960 --> 00:05:25,840
صحيح. أنواع الفواكه هي لوغيا
...وزون وباراميسيا

57
00:05:25,840 --> 00:05:28,220
.توجد الكثير من القوى الفريدة

58
00:05:28,930 --> 00:05:35,270
.التّعزيز الجسديّ الحقيقيّ هو سمة أنواع زون

59
00:05:35,270 --> 00:05:38,730
.كلّما تدرّبنا، صرنا أقوى

60
00:05:40,940 --> 00:05:46,150
نوع زون هو أقوى الأصناف عندما
.يتعلّق الأمر بالهجوم القريب

61
00:05:46,950 --> 00:05:48,740
!اخرس

62
00:05:48,740 --> 00:05:52,740
!لا أريد أن أسمع أشياء عن الوحوش هكذا

63
00:05:53,870 --> 00:05:56,710
...لا نريد إهدار الوقت أيضًا

64
00:05:56,710 --> 00:06:02,090
بما أنّ علينا التّكفّل بكم قبل
.أن تلتهمنا ألسنة اللّهب

65
00:06:02,090 --> 00:06:03,550
!أيسبرغ-سان

66
00:06:03,550 --> 00:06:05,010
!رؤساء العمّال

67
00:06:06,340 --> 00:06:09,340
.لوتشي... إنّ الحرفيّين قادمون إلى الأعلى

68
00:06:09,930 --> 00:06:12,930
.لا تقلقي. لا يمكنهم الوصول إلى هنا

69
00:06:12,930 --> 00:06:14,970
!ساق العاصفة

70
00:06:26,150 --> 00:06:28,110
!...ارجعوا! إنّ السّقف

71
00:06:37,790 --> 00:06:38,660
!نامي

72
00:06:47,590 --> 00:06:49,050
!تشوبّر

73
00:06:50,430 --> 00:06:51,930
باولي، ما الّذي يجري؟

74
00:06:51,930 --> 00:06:54,100
!سأخرجك من هذا المكان مهما كان

75
00:06:54,100 --> 00:06:56,970
!هذا مستحيل! جراحك بليغة للغاية
...فكيف لك أن

76
00:06:58,480 --> 00:07:00,480
.توقّف يا باولي

77
00:07:04,440 --> 00:07:05,780
...لا تناديني باسمي

78
00:07:06,820 --> 00:07:08,490
!وكأنّنا صديقان

79
00:07:13,450 --> 00:07:17,660
!تنحّوا... عن طريقنا

80
00:07:23,000 --> 00:07:25,380
!...سحقًا لكم

81
00:07:25,960 --> 00:07:28,090
!لِمَ أنتم بالضّبط؟

82
00:07:29,050 --> 00:07:29,840
...أنا

83
00:07:30,920 --> 00:07:33,140
...على الأقلّ

84
00:07:34,300 --> 00:07:38,560
!اعتبرتكم أصدقائي طوال هذا الوقت

85
00:07:43,690 --> 00:07:45,560
.كان ذلك من جانبك فحسب

86
00:07:57,160 --> 00:07:59,620
!...وغد الحمامة

87
00:07:59,620 --> 00:08:00,950
!قبّعة القشّ

88
00:08:07,590 --> 00:08:09,250
.مسدّس الإصبع

89
00:08:10,550 --> 00:08:11,550
!لوفي

90
00:08:35,570 --> 00:08:38,200
!احظَ بتحليق ممتع خارج هذه الجزيرة

91
00:08:43,500 --> 00:08:45,620
!لوفي

92
00:08:48,250 --> 00:08:49,210
!أيّها الوغد

93
00:08:50,250 --> 00:08:52,260
.الجسد الحديديّ

94
00:09:07,350 --> 00:09:08,730
!زورو

95
00:09:23,250 --> 00:09:24,330
.أنت أيضًا

96
00:10:03,700 --> 00:10:08,710
!جدّتي! جدّتي! هنالك حريق كبير

97
00:10:08,710 --> 00:10:12,670
.إنّه مكتب غالي-لا الرّئيسيّ
...يا له من فعل مريع

98
00:10:14,630 --> 00:10:18,180
فعل مريع؟ هل الحريق من صنيع أحد؟

99
00:10:18,180 --> 00:10:20,680
...لا أدري

100
00:10:21,090 --> 00:10:25,020
.لكنّ الحدس السّيّئ يكون حقيقة أحيانًا

101
00:10:25,020 --> 00:10:27,140
.آمل أنّ أيسبرغ بخير

102
00:10:30,150 --> 00:10:35,360
.صدقًا، كلّ هذا بسبب ذلك الشّيء
.لا يجب أن يتواجد

103
00:10:45,160 --> 00:10:48,500
.ما يقوله القراصنة لا يُؤخذ كدليل

104
00:10:48,500 --> 00:10:51,290
.ستُدفن هذه الحادثة في غياهب الظّلام

105
00:10:52,580 --> 00:10:57,710
أيسبرغ-سان... مهما كنتَ
،مهندس بناء سفن بارع

106
00:10:57,710 --> 00:11:00,300
...وحتّى إن كنت عمدة هذه المدينة

107
00:11:00,840 --> 00:11:03,510
بما أنّك من عامّة النّاس، ما كان
يجب عليك أن تعصي

108
00:11:03,510 --> 00:11:06,010
.حكومة العالم القويّة

109
00:11:14,150 --> 00:11:18,530
...لنذهب. سنجد تلميذ توم الآخر، فرانكي

110
00:11:18,530 --> 00:11:23,030
.أو بالأحرى، كاتي فلام ونأخذ منه المخطّطات

111
00:11:39,010 --> 00:11:40,800
!هل أخرجتم الجميع؟

112
00:11:40,800 --> 00:11:44,550
!ما عدنا نستطيع الدّخول
!ليحسب كلّ فريق رجاله

113
00:11:44,550 --> 00:11:48,680
مهلاً، أين أيسبرغ-سان؟ هل رأيته؟

114
00:11:48,680 --> 00:11:51,440
...لا يعقل أنّه لا يزال في النّيران

115
00:11:51,440 --> 00:11:52,520
!أنا واثق أنّه بخير

116
00:11:53,190 --> 00:11:56,440
.ثلاثة من رؤسائنا معه. محال أنّه بقي هناك

117
00:11:56,440 --> 00:11:58,440
!اذهبوا وتفقّدوا المكان أيضًا

118
00:12:02,860 --> 00:12:04,240
...هذه المرأة

119
00:12:05,030 --> 00:12:08,200
!إنّها من طاقم قبّعة القشّ ممّا لا شكّ فيه

120
00:12:08,700 --> 00:12:11,000
هل قفزت من النّافذة؟

121
00:12:11,000 --> 00:12:14,500
.لا بدّ أنّ النّيران أحاطت بها وعانت لكي تهرب

122
00:12:15,290 --> 00:12:17,460
ماذا نفعل بها؟

123
00:12:17,460 --> 00:12:21,670
.صدقًا... يا له من فعلٍ مريع

124
00:12:21,670 --> 00:12:23,970
!سنسألها عن مكان البقيّة

125
00:12:23,970 --> 00:12:27,550
!سنقبض عليهم جميعًا ونسلّمهم إلى البحريّة

126
00:12:35,150 --> 00:12:39,020
بلونو... أكان فرانكي في حانتك؟

127
00:12:39,020 --> 00:12:40,190
.نعم

128
00:12:40,190 --> 00:12:42,740
.لكنّه هرع للبحث عن قبّعة القشّ

129
00:12:42,740 --> 00:12:44,360
...فهمت

130
00:12:46,070 --> 00:12:48,950
.يبدو أنّه لا يمكث في مكان واحد طويلاً

131
00:12:55,120 --> 00:12:55,830
.انظر

132
00:12:56,580 --> 00:12:58,840
!اسمع يا قبّعة القشّ

133
00:12:58,840 --> 00:13:00,800
!لقد قبضنا على طويل الأنف

134
00:13:00,800 --> 00:13:03,130
!أجل، إنّه معنا

135
00:13:03,130 --> 00:13:05,760
...إن كنت لا تريده أن يغرق في النّهر

136
00:13:05,760 --> 00:13:08,600
!غبيّ! ليس هكذا! كم مرّة يجب أن أخبرك؟

137
00:13:08,600 --> 00:13:10,810
!"بل "إن كنت لا تريده أن يغرق في البحر

138
00:13:11,260 --> 00:13:12,060
...في النّهر

139
00:13:12,060 --> 00:13:12,770
!"في البحر"

140
00:13:13,230 --> 00:13:16,310
!تبًّا، ما الّذي تنصت له؟

141
00:13:16,310 --> 00:13:19,520
!الأهمّ هو إيصال الرّسالة إلى قبّعة القشّ، صحيح؟

142
00:13:19,520 --> 00:13:21,570
!أخبرناك أنّ تلك الرّسالة لن تفلح

143
00:13:21,570 --> 00:13:23,650
.سيوسعك أخانا ضربًا

144
00:13:23,650 --> 00:13:25,700
يجب أن تقول، "إن كنت لا تريده
،أن يغرق في البحر

145
00:13:25,700 --> 00:13:28,450
!تعال إلى المستودع أسفل الجسر
"!مع تحيّات فرانكي

146
00:13:28,450 --> 00:13:29,830
!مفهوم؟

147
00:13:29,830 --> 00:13:35,540
.ناهيك أنّه حتّى إن أتى، سيوسعه أخي ضربًا

148
00:13:37,920 --> 00:13:42,130
قلتَ من ينتظر من وأين؟

149
00:13:42,130 --> 00:13:44,260
!من أنت؟

150
00:13:44,840 --> 00:13:47,800
!نحن مشغولون الآن! انصرف

151
00:13:47,800 --> 00:13:51,260
،إن كنتم لا تريدون الموت
.أجيبوا عن سؤالي بعد ثلاث ثوانٍ

152
00:13:53,970 --> 00:13:56,310
.هذا الشّخص يتفوّه بالهراء

153
00:13:56,310 --> 00:13:58,940
هل تعرف إلى أيّ عائلة ننتمي؟

154
00:14:02,570 --> 00:14:05,490
أيّ مكان تقصده بالمستودع الّذي أسفل الجسر؟

155
00:14:05,490 --> 00:14:08,280
فرانكي هناك، أليس كذلك؟

156
00:14:10,120 --> 00:14:12,990
أيّ شأن تملك مع أخي؟

157
00:14:12,990 --> 00:14:15,620
،إن كنت تريد الحديث معه
!فعليك الحديث معنا أوّلاً

158
00:14:30,970 --> 00:14:33,890
لا أصدّق أنّك تترك أصدقاءك
الّذين ارتحلت معهم

159
00:14:33,890 --> 00:14:36,270
كلّ هذه المسافة من الأزرق
...الشّرقيّ، من أجل السّفينة

160
00:14:37,310 --> 00:14:40,190
لماذا تبكون؟

161
00:14:40,190 --> 00:14:43,110
!غبيّ! لا نبكي يا غبيّ

162
00:14:43,110 --> 00:14:46,610
لكن صحيحٌ أنّني تأثّرت بحمايتك
لهذه السّفينة لوحدك

163
00:14:46,610 --> 00:14:48,530
!في خضمّ كلّ ما حدث

164
00:14:48,530 --> 00:14:52,240
!لسنا نبكي! لا أحد منّا يبكي

165
00:14:52,240 --> 00:14:54,580
ما بالهم؟

166
00:14:56,910 --> 00:15:01,630
على أيّ حال، بتّم تعرفون الآن أنّ أولئك
!الأشخاص لم يعودوا أصدقائي، صحيح؟

167
00:15:03,000 --> 00:15:04,380
...سوف

168
00:15:04,380 --> 00:15:07,050
!أغنّي من أجل صِعابك

169
00:15:07,050 --> 00:15:10,430
!عنوان الأغنيّة هو "صداقة مقطوعة
"!رياح الشّمال القاطعة

170
00:15:10,430 --> 00:15:12,300
!مرحى! أخي

171
00:15:12,300 --> 00:15:14,350
!هل تسخر منّي؟

172
00:15:20,270 --> 00:15:25,270
.هل الشّاي جاهز؟ أشعر بالعطش

173
00:15:25,270 --> 00:15:28,280
!حسنًا! سنحضره حالاً

174
00:15:29,690 --> 00:15:33,910
.أنهكني البكاء... ليس وكأنّني بكيت

175
00:15:37,540 --> 00:15:41,330
.تفضّل يا أخي. إنّه حامٍ قليلاً

176
00:15:43,420 --> 00:15:45,000
.شكرًا

177
00:15:45,590 --> 00:15:48,590
...فهمتُ إذًا يا أخي

178
00:15:49,880 --> 00:15:52,050
!هذا مؤلم، إنّه ساخن

179
00:15:52,050 --> 00:15:53,840
!هلاّ هدأت قليلاً؟

180
00:15:54,890 --> 00:15:58,180
.أنا آسفة يا أخي

181
00:15:58,180 --> 00:16:00,680
ما رأيك أن تأخذ استراحة
وتحتسي بعض الشّاي أيضًا؟

182
00:16:08,650 --> 00:16:10,530
.لا ألومك

183
00:16:10,530 --> 00:16:16,070
لا بدّ أنّك تكنّ ضغينة كبيرة تجاهنا
لأنّنا سرقنا منكم الـ200 مليون بيري

184
00:16:16,870 --> 00:16:20,700
.بما أنّ ذلك قاد إلى شجار كبير

185
00:16:21,500 --> 00:16:23,830
.كان ذلك مقدّرًا فحسب

186
00:16:23,830 --> 00:16:26,080
.لن تفيدني الضّغينة في شيء

187
00:16:27,130 --> 00:16:28,960
.تملك روحًا رياضيّة

188
00:16:28,960 --> 00:16:31,090
...فهمت

189
00:16:31,090 --> 00:16:32,670
...بشأن الـ200 مليون

190
00:16:33,590 --> 00:16:36,300
!أسرفتها كلّها

191
00:16:36,300 --> 00:16:37,890
هل تريدني أن أضربك؟

192
00:16:37,890 --> 00:16:41,140
.هوّن عليك... لا تغضب هكذا

193
00:16:41,140 --> 00:16:44,850
.أريتني مدى رجولتك

194
00:16:44,850 --> 00:16:49,980
لذا عليّ الآن أن أهدّئ أعصابي
بسبب الدّمار الكامل

195
00:16:49,980 --> 00:16:53,780
لمنزل فرانكي، الّذي كان منزلي
.ومصنع التّهديم

196
00:16:54,650 --> 00:16:58,280
!علاوةً على ذلك، قضيتم على أتباعي

197
00:16:58,280 --> 00:17:00,540
!كيف تجرؤون أيّها الأوغاد؟

198
00:17:00,540 --> 00:17:01,610
!أخي

199
00:17:01,610 --> 00:17:03,840
!لقد تصاعد غضبك

200
00:17:03,840 --> 00:17:05,790
!أوغاد

201
00:17:16,400 --> 00:17:18,680
،إذًا يا أخي، مع أنّ الكثير حدث

202
00:17:18,680 --> 00:17:21,560
دعنا نهدّئ غضبنا تجاه بعضنا
،البعض في هذه المسألة

203
00:17:21,560 --> 00:17:25,230
.ونحلّ الخلاف بالتّمادي

204
00:17:25,230 --> 00:17:27,020
.تقصد بالتّراضي

205
00:17:27,020 --> 00:17:30,320
.تقصد بالتّراضي يا أخي

206
00:17:30,320 --> 00:17:31,780
.أيًّا كان

207
00:17:33,990 --> 00:17:36,910
ماذا سنفعل الآن بما أنّك لوحدك؟

208
00:17:37,610 --> 00:17:39,530
ليس لديك مكان تقصده، صحيح؟

209
00:17:41,740 --> 00:17:45,960
.في تلك الحالة، يمكنني أن أضمّك لي
!اعمل لصالحي

210
00:17:46,620 --> 00:17:47,960
.أُعجبت بك

211
00:17:48,420 --> 00:17:52,210
.مستحيل! لا أريد أن أصبح عامل هدم

212
00:17:53,050 --> 00:17:55,920
!مع أنّني تركتُ مجموعتي، إلاّ أنّي لا أزال قرصانًا

213
00:17:57,630 --> 00:18:01,010
.استمعوا لأغنيّتي رجاءً
."بعنوان "قانون القراصنة

214
00:18:01,010 --> 00:18:03,140
!مرحى! أخي

215
00:18:03,140 --> 00:18:06,100
!سأسألك ثانيةً، هل تسخر منّي؟

216
00:18:06,600 --> 00:18:11,060
يا إلهي... إنّي أحاول أن أفكّر فيمَ
!يجب أن تفعل تاليًا، من أجل مصلحتك

217
00:18:11,060 --> 00:18:13,070
!ذلك ليس من شأنك

218
00:18:13,650 --> 00:18:17,240
وأيضًا، ألا بأس أن تسترخي في مكان كهذا؟

219
00:18:17,240 --> 00:18:19,030
ثمّة موجة عارمة تقترب، صحيح؟

220
00:18:19,030 --> 00:18:22,160
...أجل، ولهذا السّبب بالذّات

221
00:18:22,160 --> 00:18:26,000
،عندما تحلّ علينا أكوا لاغونا
.علينا مساعدة بعضنا

222
00:18:29,420 --> 00:18:31,250
،من الآن حتّى وقت متأخّر من اللّيل

223
00:18:31,250 --> 00:18:33,920
.ستُغمر المنازل بالمياه حتّى الطّابق الثّاني

224
00:18:33,920 --> 00:18:38,420
إن كنتَ في الشّوارع الخلفيّة أو الرّؤوس
.في وقتٍ كهذا، فأنت هالك لا محالة

225
00:18:38,420 --> 00:18:41,970
.لست بحاجة للقلق إن تركت سفينتك هنا أيضًا

226
00:18:42,720 --> 00:18:45,930
.شكرًا... أقدّر لك ذلك

227
00:18:45,930 --> 00:18:47,930
!أيّها الغبيّ! لا تتكلّم وكأنّنا غريبين عن بعضنا

228
00:18:47,930 --> 00:18:52,690
على أيّ حال، لا بدّ أنّ من الصّعب
.أن تتضرّروا من الفيضان هكذا كلّ عام

229
00:18:52,690 --> 00:18:56,780
الجميع معتادون على هذا الإخلاء
.السّنويّ على كلّ حال

230
00:18:57,740 --> 00:19:02,740
الإشكال الأكبر هو أنّ مستوى ماء
.البحر كان يتزايد كلّ عام

231
00:19:03,240 --> 00:19:07,750
المنطقة الخلفيّة الّتي ترونها فوق البحر
الآن هي في الواقع بلدة بُنيت على أسطح

232
00:19:07,750 --> 00:19:11,210
.بلدة قديمة تواجدت قبل مئات السّنين

233
00:19:11,210 --> 00:19:13,750
يقال أنّ جزيرة بناء السّفن والشّوارع الخلفيّة

234
00:19:13,750 --> 00:19:16,960
.كانت متّحدة على يابسة واحدة قبل وقتٍ طويل

235
00:19:16,960 --> 00:19:21,220
لكن باتت منطقة كبيرة منها غارقة
.تحت الماء وسُمّيت بالمدينة العائمة

236
00:19:21,220 --> 00:19:24,760
.أصبحت كلّ الأرصفة قنوات

237
00:19:24,760 --> 00:19:28,270
بالأحرى، بدلاً من القول
،أنّ مستوى الماء في ازدياد

238
00:19:28,270 --> 00:19:31,310
.نقول أنّ أساس الجزيرة يغرق

239
00:19:31,310 --> 00:19:35,980
على هذا الحال، المناطق الّتي نعيش
.فيها في البلدة ستتقلّص شيئًا فشيئًا

240
00:19:35,980 --> 00:19:41,740
فهمت... حتّى هذه المدينة
.العائمة الجميلة تمرّ بأزمات إذًا

241
00:19:43,160 --> 00:19:45,120
،لكن، إن اقتضت الحاجة

242
00:19:45,120 --> 00:19:48,240
بإمكانكم أخذ قطار البحر
.والذّهاب للعيش في مكانٍ آخر

243
00:19:48,450 --> 00:19:52,420
.بإمكانك قول ذلك الآن

244
00:19:52,420 --> 00:19:56,840
.لكنّ قطار البحر لم يُخترع إلاّ قبل نحو عقد

245
00:19:56,840 --> 00:20:01,880
.قبل ذلك الوقت، لم يكن التّنقّل عبر البحر سهلاً

246
00:20:03,550 --> 00:20:06,720
.بطبيعة الحال، قلّما استطاع النّاس التّنقّل بين الجزر

247
00:20:06,720 --> 00:20:07,890
،ففي هذه الجزيرة المعزولة

248
00:20:07,890 --> 00:20:12,520
تخيّل السّاكنة بشكل مبهم
أنّ أرضهم ستنغمر بالمياه يومًا ما

249
00:20:12,520 --> 00:20:16,110
.واستيأسوا تمامًا

250
00:20:27,450 --> 00:20:30,500
،وما طمأن قلوب النّاس حتّى عن المستقبل

251
00:20:30,500 --> 00:20:33,540
.كان قطار البحر، توم النّافث

252
00:20:33,540 --> 00:20:37,670
بإمكانهم الآن عبور البحر متى أرادوا
.دون الحاجة إلى بوصلة مسجّلة

253
00:20:37,670 --> 00:20:39,960
!لذا كان ذلك بمثابة تقدّم كبير

254
00:20:40,630 --> 00:20:42,920
.فهمت... لم أكن أعلم

255
00:20:42,920 --> 00:20:45,800
.قطار البحر شيء عظيم حقًّا

256
00:20:46,390 --> 00:20:49,560
.عادت ووتر سيفن إلى الحياة

257
00:20:49,560 --> 00:20:54,770
كلّ ذلك بفضل نجّار السّفن العظيم
.توم الّذي صنع قطار البحر

258
00:20:55,980 --> 00:21:00,020
.لقد أنقذنا جميعًا

259
00:21:08,240 --> 00:21:10,120
!أخي

260
00:21:13,370 --> 00:21:15,580
...النّجدة

261
00:21:20,210 --> 00:21:23,920
.سألقي التّحيّة على أخيكم من أجلكم

262
00:21:41,270 --> 00:21:42,230
.هيّا بنا

263
00:22:28,820 --> 00:22:33,450
جمعنا حلمٌ ذلك اليوم

264
00:22:33,450 --> 00:22:38,250
ثقتنا بأنفسنا

265
00:22:38,250 --> 00:22:47,300
ستقودنا لعبور البحر الشّاسع والعاصف

266
00:22:47,300 --> 00:22:56,810
أنت الأشجع والأكثر مراعاة بين الجميع

267
00:22:56,810 --> 00:23:07,030
إن تركت يومًا هذه السّفينة وذهبت للعيش في عالم آخر

268
00:23:07,030 --> 00:23:15,580
في النّهاية، سنبتسم سويًّا لا محالة

269
00:23:25,590 --> 00:23:27,800
أخبرني يا طويل الأنف، ماذا ستفعل
بعد إصلاحك لتلك السّفينة؟

270
00:23:27,800 --> 00:23:30,470
وماذا برأيك؟ سأذهب في مغامرة
...معها ثانيةً و

271
00:23:30,470 --> 00:23:32,550
.ذلك غير ممكن. لا تستطيع

272
00:23:32,550 --> 00:23:33,470
ماذا قلت؟

273
00:23:33,470 --> 00:23:36,970
لا تستطيع تلك السّفينة حتّى
.أن تدرك الجزيرة التّالية

274
00:23:36,970 --> 00:23:39,140
.سأساعدك على هدم تلك السّفينة

275
00:23:39,140 --> 00:23:42,060
!توقّف! ما الّذي تفعله؟

276
00:23:42,060 --> 00:23:43,020
:في الحلقة القادمة من وان بيس

277
00:23:43,020 --> 00:23:46,150
الرّجل الّذي يحظى بحبّ حتّى"
"!سفينته! دموع أوسوبّ

278
00:23:46,150 --> 00:23:48,480
!ملك القراصنة، لن يكون إلاّ أنا

279
00:23:50,110 --> 00:23:55,080
نلقاكم في الحلقة القادمة