122
00:12:24,850 --> 00:12:29,750
حمّلوا سفينتكم بكلّ الكنوز الّتي تستطيعون
!تحميلها، ما عدا الجرس الذّهبيّ

123
00:12:31,490 --> 00:12:34,920
!سيتو! أرشدهم لمكان الكنوز

124
00:12:35,990 --> 00:12:36,790
!حاضر

125
00:12:36,990 --> 00:12:39,290
هل أنت واثق من هذا؟

126
00:12:39,530 --> 00:12:42,100
.وافق أهل القرية على هذا بالفعل

127
00:12:42,100 --> 00:12:46,270
نحن مدينون لك لإنقاذك قبيلتنا
.من ذلك المرض المريع

128
00:12:46,730 --> 00:12:48,370
.هذا لا يعدّ شيئًا

129
00:12:48,840 --> 00:12:50,900
!أنت سخيّ جدًّا أيّها المحارب العظيم

130
00:12:50,900 --> 00:12:55,510
لكن ألم يكن شعبك يحمي
المدينة طوال الوقت؟

131
00:12:55,680 --> 00:12:58,580
...نعم. حمينا المدينة

132
00:12:59,380 --> 00:13:04,620
!لكن ليس كنزها بالضّرورة

133
00:13:05,090 --> 00:13:07,050
...لأكون دقيقًا أكثر

134
00:13:15,230 --> 00:13:16,930
.هذا الحجر فحسب

135
00:13:19,570 --> 00:13:23,300
ما هذه؟ كتابة؟

136
00:13:23,770 --> 00:13:25,310
.نصّ التّاريخ

137
00:13:26,240 --> 00:13:28,440
."وتُعرف أيضًا بـ"البونيغليف

138
00:13:28,640 --> 00:13:30,640
.لا نستطيع قراءتها أيضًا

139
00:13:31,380 --> 00:13:35,420
أتقصد أنّ أسلافك لم يكتبوا هذا؟

140
00:13:37,680 --> 00:13:42,020
كلّ ما أنا متأكّد بشأنه
هو أنّ مدينة شاندورا

141
00:13:42,020 --> 00:13:45,630
قاتلت وسقطت وهي تحاول
.حماية هذا الحجر

142
00:13:46,930 --> 00:13:51,160
.ويجب أن نواصل حمايته بنفس ذلك العزم

143
00:13:51,400 --> 00:13:54,070
،بصفتنا أحفادًا لنفس السّلالة
من واجبنا أن نحمي

144
00:13:54,070 --> 00:13:57,540
.الدّليل على أنّ أجدادنا قاتلوا ونجوا

145
00:14:00,110 --> 00:14:03,840
.إنّنا نمجّد أجدادنا وكأنّهم آلهة

146
00:14:04,140 --> 00:14:10,050
مع ذلك، لم أعلم أنّ ما سمعته
.كان هذا الجرس الذّهبيّ الضّخم

147
00:14:12,350 --> 00:14:15,090
.طنين هذا الجرس يحمل كلماته الخاصّة

148
00:14:15,260 --> 00:14:16,190
كلمات؟

149
00:14:16,690 --> 00:14:20,560
لكي تعود أرواح أجدادنا الّتي عانقتها السّماء

150
00:14:20,560 --> 00:14:25,270
،إلى هذه الأرض في أيّ وقت دون أن تتوه

151
00:14:25,630 --> 00:14:32,770
تابعنا قرع هذا الجرس كمبادرة
!"منّا لنقول لهم "نحن هنا

152
00:14:34,010 --> 00:14:38,780
يعلن صوته عن المجد الثّابت
،الّذي حظت به شاندورا

153
00:14:39,280 --> 00:14:42,520
!ويبعث وجوده ليُعرف حتّى أقاصي البحار

154
00:14:42,750 --> 00:14:45,920
!لن نهرب ولن نختبئ أبدًا

155
00:14:46,920 --> 00:14:51,560
لهذا ندعو جرس هذه المدينة
."العظيم بـ"نار شاندورا

156
00:14:52,160 --> 00:14:55,830
!ذلك يفسّر صوته الجليل

157
00:14:55,830 --> 00:14:57,200
!هل تظنّ ذلك؟

158
00:14:57,200 --> 00:14:58,130
!نعم

159
00:14:59,870 --> 00:15:04,470
لقد وصلتنا هذه النّار
.وساعدتنا للوصول إلى هنا

160
00:15:06,440 --> 00:15:12,880
سمعتُ هذا الجرس في خضمّ عاصفة
...حيث لا يجدر أن يكون مسموعًا

161
00:15:17,580 --> 00:15:21,190
هل تحبّ صوت هذا الجرس أيضًا؟

162
00:15:21,360 --> 00:15:25,760
هل ستكبر لتكون مثل ذلك
الثّعبان العملاق يومًا ما؟

163
00:15:30,860 --> 00:15:33,600
!ليس قبل مئات السّنين على الأغلب

164
00:15:36,100 --> 00:15:39,310
!اسمع! ابق هنا قدر ما تشاء يا نولاند

165
00:15:40,070 --> 00:15:45,580
أنتم أوّل ضيوف لنا هنا منذ
!‫400 سنة، أي منذ سقوط شاندورا

166
00:15:45,580 --> 00:15:47,550
!أريد أن أمنحكم كرم الضّيافة

167
00:15:49,250 --> 00:15:50,580
!أودّ ذلك

168
00:15:50,980 --> 00:15:53,820
،أريد جمع النّباتات من هذه الغابة

169
00:15:53,820 --> 00:15:56,760
.وأريد مراقبة هذا الوباء حتّى يتبدّد

170
00:15:56,790 --> 00:16:00,090
!أيّها العميد! أيّها العميد

171
00:16:00,090 --> 00:16:02,130
تمهّلا. ما بال ثيابكما هذه؟

172
00:16:02,130 --> 00:16:03,960
!انظر، انظر! بوصلة دائمة

173
00:16:03,960 --> 00:16:06,330
!وخريطة! خريطة أيّها العميد

174
00:16:06,670 --> 00:16:10,070
.أخذنا هذه من دخلاء

175
00:16:10,640 --> 00:16:13,410
!أتلك خريطة لهذه الجزيرة؟

176
00:16:14,040 --> 00:16:18,180
نعم. شكل الجمجمة هذا يوحي
.لهذه الجزيرة لا محالة

177
00:16:18,450 --> 00:16:22,880
،"اسم "شاندورا" يعني "عين الجمجمة اليمنى

178
00:16:28,820 --> 00:16:30,420
!اعتنيا بنفسيكما إذًا

179
00:16:30,690 --> 00:16:33,090
!احرصي أن تنال الكثير من الرّاحة

180
00:16:33,090 --> 00:16:35,400
!شكرًا أيّها الطّبيب

181
00:16:37,930 --> 00:16:42,870
!اسمعوا! تعالوا وانظروا جميعًا
!إنّ نولاند يعطينا بعض المحاصيل الغريبة

182
00:16:43,100 --> 00:16:47,370
أملك دفيئة في سفينتي تحتوي
.على شتّى عيّنات النّباتات

183
00:16:48,040 --> 00:16:51,350
سأترك بعض البذور والبراعم
.الّتي تناسب تربتكم

184
00:16:51,680 --> 00:16:53,480
أهذا مفيد؟

185
00:16:53,480 --> 00:16:56,320
!بالطّبع! كما أنّها مليئة بالعناصر المغذّية

186
00:17:57,010 --> 00:18:00,450
!حسنًا! دعونا نعمل بجدّ ثانيةً اليوم

187
00:18:00,780 --> 00:18:04,650
نعمل بجدّ في ماذا؟
في الاحتفال مع نار المخيّم؟

188
00:18:12,790 --> 00:18:16,860
لماذا؟! لم قد يفعل الطّبيب
!والبقيّة هذا؟

189
00:18:21,740 --> 00:18:24,540
!يا زعيم! إنّ نولاند والبقيّة قادمون

190
00:18:25,570 --> 00:18:28,740
!اسمعوا! لا تذكروا ليلة البارحة

191
00:18:29,240 --> 00:18:32,250
.قالوا أنّهم سيبحرون بعد بضعة أيّام

192
00:18:32,680 --> 00:18:36,550
!لا تقوموا بأيّ تهوّر

193
00:18:36,950 --> 00:18:40,820
أظنّنا لا نستطيع فهم بعضنا
!البعض في النّهاية

194
00:18:41,590 --> 00:18:46,460
،مهما كان دواؤه مفيدًا
!يظل قاتل الآلهة

195
00:18:46,460 --> 00:18:51,030
هل يظنّون أنّهم عظيمون كفايةً
!ليدوسوا على كلّ تاريخنا؟

196
00:18:51,470 --> 00:18:57,400
تحمّلوا! اقمعوا مشاعركم
!وانتظروا مغادرتهم بهدوء

197
00:18:57,600 --> 00:18:58,640
!لقد أتوا

198
00:19:02,140 --> 00:19:04,950
مرحبًا يا رفاق! هل كالغارا موجود؟

199
00:19:14,120 --> 00:19:18,190
لِمَ يتصرّف الجميع ببرود
فجأةً؟ أين كالغارا؟

200
00:19:18,190 --> 00:19:20,930
!أنتم دخلاء

201
00:19:21,400 --> 00:19:24,630
!ما عاد كالغارا يريد رؤيتك

202
00:19:24,970 --> 00:19:25,800
!سيتو

203
00:19:29,240 --> 00:19:32,440
!متى ستغادرون على أيّ حال؟

204
00:19:34,780 --> 00:19:38,810
...يبدو أنّهم أصبحوا يكرهوننا فجأةً

205
00:19:39,510 --> 00:19:43,720
انتظروا يا رفاق! لا يمكنكم
!أن تبدؤوا في الحديث هكذا فجأةً

206
00:19:43,720 --> 00:19:44,480
.توقّف

207
00:19:46,690 --> 00:19:48,320
.لنتابع عملنا

208
00:19:50,420 --> 00:19:52,890
.ما زال أمامنا فحص بعض الغابات

209
00:19:56,060 --> 00:20:00,100
!أنت هنا إذًا يا كالغارا
!إنّ نولاند يبحث عنك

210
00:20:00,100 --> 00:20:03,370
.نعم. ما عدتُ أريد رؤية وجهه

211
00:20:04,040 --> 00:20:08,540
!إن رأيته، قد أقتله

212
00:20:14,820 --> 00:20:17,550
...لم يُقرع الجرس اليوم

213
00:20:17,550 --> 00:20:22,260
نعم. هذه أوّل مرّة يحدث هذا
.أثناء الشّهر الّذي أمضيناه هنا

214
00:20:22,820 --> 00:20:23,990
...أيّها العميد

215
00:20:24,260 --> 00:20:27,460
.سأنتهي من استكشاف الغابة بعد يومين

216
00:20:27,460 --> 00:20:28,930
...حـ-حاضر

217
00:20:29,600 --> 00:20:34,400
أخبر الطّاقم أنّنا سنبحر ثانيةً
،بعد ثلاثة أيّام

218
00:20:34,400 --> 00:20:38,140
لذا هذه فرصتهم الأخيرة
.للاستمتاع باليابسة لفترة

219
00:20:38,740 --> 00:20:39,810
...أيّها العميد

220
00:20:39,810 --> 00:20:43,110
لأصدقك القول، أريد الرّحيل
...من هذه الجزيرة الغريبة

221
00:20:43,110 --> 00:20:45,280
!بعد أن ننتهي من أعمالنا

222
00:20:45,650 --> 00:20:46,510
.اخلد إلى النّوم

223
00:20:49,050 --> 00:20:51,150
!عش هنا يا نولاند

224
00:20:51,150 --> 00:20:54,620
!صحيح! ما رأيك أن تتزوّج بموس؟

225
00:20:55,120 --> 00:20:56,260
.لا تكن سخيفًا

226
00:20:56,260 --> 00:20:59,390
لديّ عائلة في الدّيار وأطفال
.بعمر يناهز عمرها

227
00:20:59,390 --> 00:21:00,590
.يجب أن أعود

228
00:21:00,860 --> 00:21:04,400
!ما عاد كالغارا يريد رؤيتك

229
00:21:05,600 --> 00:21:09,000
!متى ستغادرون على أيّ حال؟

230
00:21:21,850 --> 00:21:25,320
!أعلم أنّك هنا يا كالغارا! اخرج إليّ

231
00:21:26,090 --> 00:21:28,920
!ألا تظنّ أنّ هذا تعسّف حقًّا؟

232
00:21:29,190 --> 00:21:30,620
!أخبرني لماذا

233
00:21:31,090 --> 00:21:32,760
!لن أفهم حتّى تخبرني

234
00:21:33,590 --> 00:21:35,600
!سنبحر قريبًا جدًّا

235
00:21:36,100 --> 00:21:38,470
!لا أريد أن نفترق هكذا

236
00:21:51,950 --> 00:21:55,150
!لا تظهر أمامي

237
00:21:55,150 --> 00:21:58,450
!أم تريد من زوجتك أن تترمّل؟

238
00:22:02,120 --> 00:22:03,760
!كالغارا

239
00:22:09,030 --> 00:22:14,670
إن كنت تشعر بالوحدة، تعال حدّثني

240
00:22:14,670 --> 00:22:19,870
تتجوّل وعيناك نصبَ السّماء

241
00:22:19,870 --> 00:22:27,480
كمثَل القمر، تُحدّق بثبات

242
00:22:30,720 --> 00:22:39,860
بينما يتضاءل انعكاسك العميق
وأنت تختفي ببطء

243
00:22:39,860 --> 00:22:53,410
ابقَ كما أنت ودع الكلمات تقودك

244
00:22:54,210 --> 00:23:07,120
احلموا، أيّها الرّحالة الّذين
قضيتم ليالٍ لا تُحصى تنجرفون

245
00:23:07,120 --> 00:23:11,630
حتّى إن كنتم لا تستطيعون الرّجعة

246
00:23:11,630 --> 00:23:18,000
لسوف تمضون قدمًا من جديد

247
00:23:25,370 --> 00:23:27,840
!لقد فقد الجرس معناه تمامًا

248
00:23:27,840 --> 00:23:30,580
!فعلت ما يرضي ضميري فحسب

249
00:23:30,580 --> 00:23:33,150
،"إن كانت هذه تضحيّات من أجل "تطوّرك

250
00:23:33,150 --> 00:23:36,180
!ما كان يجب أن نقبلك أبدًا

251
00:23:36,180 --> 00:23:39,090
.من حقّهم أن يغضبوا
!لا نملك سببًا لنستحقّ المغفرة

252
00:23:39,790 --> 00:23:41,960
!سنعود إلى مملكة لفنيل

253
00:23:41,960 --> 00:23:43,120
:في الحلقة القادمة من ون بيس

254
00:23:43,120 --> 00:23:46,660
صديقان إلى الأبد! يتردّد صدى
!جرس العهدِ عبر البحار العاتية

255
00:23:46,660 --> 00:23:48,730
!ملك القراصنة، لن يكون إلاّ أنا