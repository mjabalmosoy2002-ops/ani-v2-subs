1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:13,070 --> 00:02:16,030
!إلى الجحيم يا أبو

29
00:02:16,030 --> 00:02:17,490
!كيد

30
00:02:17,490 --> 00:02:19,950
...الوتر

31
00:02:24,370 --> 00:02:26,790
!المغناطيسيّ

32
00:02:27,990 --> 00:02:32,210
"!حُطّم حُلمه؟! الفخّ الّذي استدرج سانجي"

33
00:02:50,690 --> 00:02:52,440
!أيّها المسنّن

34
00:02:52,440 --> 00:02:54,110
!ذلك المغفّل

35
00:02:57,230 --> 00:02:58,690
!أبو-سان

36
00:02:58,690 --> 00:03:01,360
!مهلاً! إنّه ليس معنا

37
00:03:15,040 --> 00:03:17,920
!ماذا؟

38
00:03:17,920 --> 00:03:20,840
!...لا تقل لي أنّه

39
00:03:25,130 --> 00:03:29,100
!إنّه كابتن كيد

40
00:03:33,270 --> 00:03:36,190
!كيف يوجد كيد هنا أيضًا؟

41
00:03:36,190 --> 00:03:39,110
!ظننتُ أنّه مسجون في أودون

42
00:03:39,110 --> 00:03:43,990
!ما كلّ هذا يا بابانوكي؟

43
00:03:56,160 --> 00:04:00,630
...كنت توّاقًا لتشكيل تحالف معنا

44
00:04:02,300 --> 00:04:07,010
!كان حريًّا بي ملاحظة ذلك وقتها

45
00:04:09,720 --> 00:04:13,730
!كنتَ مخبرًا لكايدو

46
00:04:13,730 --> 00:04:17,880
...عرف كايدو كلّ خطوة قمنا بها

47
00:04:17,880 --> 00:04:21,610
!لأنّك كنت تبلّغه بها، صحيح؟

48
00:04:24,940 --> 00:04:27,570
!هذا بسبب سذاجتك

49
00:04:27,570 --> 00:04:28,620
!ماذا؟

50
00:04:28,620 --> 00:04:34,540
هل اعتقدت أنّ تحالفنا كان قويًّا
!كفاية للإطاحة بأحد اليونكو؟

51
00:04:34,540 --> 00:04:36,380
!كن واقعيًّا

52
00:04:38,710 --> 00:04:41,490
...إنّ تحالفات القراصنة في المقام الأوّل

53
00:04:41,490 --> 00:04:44,720
!نادرًا ما تكون لها نهاية سعيدة

54
00:04:44,720 --> 00:04:46,640
!خدش

55
00:04:46,640 --> 00:04:48,680
!تقطيع

56
00:05:01,310 --> 00:05:04,490
...ظننتُ أنّك ميت

57
00:05:04,490 --> 00:05:07,240
ماذا؟ كيد؟

58
00:05:08,610 --> 00:05:10,240
!أيّها الحثالة

59
00:05:16,620 --> 00:05:18,050
!ضرب

60
00:05:28,510 --> 00:05:29,880
!يا قبطان

61
00:05:29,880 --> 00:05:31,770
هل أنت بخير؟

62
00:05:32,180 --> 00:05:33,430
!لا داعي للقلق

63
00:05:33,430 --> 00:05:37,350
!كوين-سان! لقد أطلقوا العنان لأنفسهم

64
00:05:38,270 --> 00:05:42,110
إنّهم مليئون بالطّاقة
!ويصعب الإمساك بهم أحياء

65
00:05:47,690 --> 00:05:49,660
.بإمكانكم قتلهم

66
00:05:57,750 --> 00:05:59,330
!تنافر

67
00:06:05,300 --> 00:06:07,840
!هلمّوا إليّ إن كان الموت رغبتكم

68
00:06:08,050 --> 00:06:10,590
!سأقتلك

69
00:06:14,350 --> 00:06:17,520
!ها هو ذا! عرفت أنّه كان كيلر

70
00:06:32,200 --> 00:06:35,420
!كيد! لنخرج من هنا

71
00:06:36,490 --> 00:06:39,580
!لن يوصلنا قتالهم هنا إلى أيّ نتيجة

72
00:06:40,790 --> 00:06:43,170
!معك حقّ

73
00:06:50,630 --> 00:06:55,390
،توقّفوا! حتّى إن قتلتموهم
!لا يمكنكم أن تكونوا جزءًا من التّوبي روبّو

74
00:07:10,230 --> 00:07:13,080
!مهلاً، توقّف! ستؤذينا

75
00:07:21,910 --> 00:07:24,460
!ابتعدوا

76
00:07:25,090 --> 00:07:27,930
!ليوقفه شخص ما

77
00:07:29,090 --> 00:07:31,360
...لا يبدو هذا جيّدًا

78
00:07:31,360 --> 00:07:33,340
!لنتراجع حاليًّا

79
00:07:33,720 --> 00:07:37,350
!من ذلك الرّجل؟! ألا يمكن السّيطرة عليه؟

80
00:07:37,590 --> 00:07:41,770
!أهو عملاق؟! لكنّه يبدو أكبر بكثير

81
00:07:59,040 --> 00:08:03,670
!أجل يا هاتشا! اسحق الجيل الأسوأ

82
00:08:22,180 --> 00:08:25,820
!سآخذ رأس كيد

83
00:08:40,080 --> 00:08:42,790
!أيّها المسنّن! لنسرع نحو القلعة

84
00:08:43,660 --> 00:08:46,960
!هدفنا الآن هو رأس كايدو

85
00:08:46,960 --> 00:08:51,010
!لا يجب أن نضيّع وقتنا هنا

86
00:08:51,330 --> 00:08:53,140
!يا قبّعة القشّ

87
00:09:00,760 --> 00:09:01,770
!رفاق

88
00:09:01,770 --> 00:09:04,180
!واصل يا قبطان

89
00:09:04,180 --> 00:09:06,520
!سنتولّى أمرهم

90
00:09:06,520 --> 00:09:09,130
!حسنًا! سنتركهم لكم يا رفاق

91
00:09:09,130 --> 00:09:11,070
!هيّا بنا أيّها المسنّن

92
00:09:22,660 --> 00:09:24,580
!هيّا بنا يا زورو

93
00:09:24,580 --> 00:09:26,250
!أجل

94
00:09:46,140 --> 00:09:47,640
...يا إلهي

95
00:09:47,640 --> 00:09:51,600
!عرفت أنّك ستسبّب الفوضى أيّها المسنّن

96
00:09:51,600 --> 00:09:54,530
!أنت تقول هذا يا لوفي؟

97
00:09:55,240 --> 00:09:57,150
!لا يحقّ لك الحديث أيضًا يا رورونوا

98
00:09:59,910 --> 00:10:01,580
!اسمع أيّها المسنّن

99
00:10:01,580 --> 00:10:04,830
!سنتسلّل بهدوء من هنا

100
00:10:04,830 --> 00:10:07,040
!لا تملِ عليّ الأوامر

101
00:10:07,040 --> 00:10:09,660
!لا أتذكّر أنّني تحالفت معكم أيّها الحمقى

102
00:10:09,660 --> 00:10:11,640
!ماذا؟

103
00:10:11,640 --> 00:10:14,050
!هل تستمع لي يا قبّعة القشّ؟
...إنّك دائمًا ما

104
00:10:14,050 --> 00:10:17,050
!مع السّلامة يا رفاق! سأطيح برأس كايدو

105
00:10:17,050 --> 00:10:19,380
!ماذا؟ انتظر

106
00:10:19,840 --> 00:10:21,390
!لا يمكنك ذلك

107
00:10:21,390 --> 00:10:22,720
!سأذهب أوّلاً

108
00:10:22,720 --> 00:10:24,430
!كلاّ، سأذهب أنا أوّلاً

109
00:10:24,430 --> 00:10:25,470
!بل أنا

110
00:10:25,470 --> 00:10:27,560
!لن أسمح لك

111
00:10:28,100 --> 00:10:32,460
.فسدت الخطّة تمامًا
...لقد خرجوا عن السّيطرة

112
00:10:32,460 --> 00:10:34,570
!لا أمل يُرجى منهم

113
00:10:36,190 --> 00:10:38,380
!مرحى

114
00:10:38,380 --> 00:10:44,030
!لا يستطيع أحد الهروب من قتال الموسيقى خاصّتي

115
00:10:44,030 --> 00:10:46,570
!سأمحوكم! استمعوا

116
00:10:46,570 --> 00:10:48,160
!انفجار

117
00:11:07,010 --> 00:11:09,770
!أعتقد أنّه هو الفاعل

118
00:11:40,210 --> 00:11:41,470
!تبًّا

119
00:11:41,470 --> 00:11:43,670
!إنّه هو ثانية

120
00:11:43,670 --> 00:11:45,800
!من تلك المسافة؟

121
00:11:49,680 --> 00:11:52,640
!أبو! ذلك الوغد

122
00:11:52,640 --> 00:11:56,280
!لا تفقدوا تركيزكم! ذلك ما يسعى إليه

123
00:11:58,020 --> 00:12:01,740
!ها نحن أولاء! مرّة أخرى! استمعوا

124
00:12:02,570 --> 00:12:05,160
!هيّا! غطّوا آذانكم

125
00:12:05,160 --> 00:12:08,200
!استمعوا! انفجار

126
00:12:38,230 --> 00:12:40,280
!اسمعوا يا رفاق

127
00:12:40,650 --> 00:12:46,660
!هجمات أبو فعّالة فقط على مرمى السّمع
!لا يمكن تفاديها ما دمنا سمعناها

128
00:12:46,660 --> 00:12:49,080
!انتبهوا لهجماته المفاجئة

129
00:12:50,370 --> 00:12:51,160
ماذا؟

130
00:12:51,950 --> 00:12:53,810
ماذا قلت؟

131
00:12:53,810 --> 00:12:55,450
!كرّر ذلك ثانية

132
00:12:55,450 --> 00:12:58,830
!هذا مهمّ للغاية، لذلك سأكرّر كلامي

133
00:12:58,830 --> 00:13:00,300
!نعم

134
00:13:05,260 --> 00:13:07,780
!تلقّيت رسالة منهم

135
00:13:07,780 --> 00:13:12,350
!قالوا أنّ السّفينة بخير، لذلك سيكونون هنا قريبًا

136
00:13:12,350 --> 00:13:13,710
!هذا جيّد

137
00:13:13,710 --> 00:13:17,600
...لكنّ ذلك غريب يا بيغ مام

138
00:13:18,020 --> 00:13:22,610
...لم تصلنا أيّ أخبار من ميناء موغورا

139
00:13:22,900 --> 00:13:27,490
،إن رأوا أيّ سفينة في الميناء
...كان عليهم الاتّصال بنا

140
00:13:27,990 --> 00:13:29,870
ميناء؟

141
00:13:29,870 --> 00:13:32,550
أيّ ميناء؟

142
00:13:32,550 --> 00:13:34,080
!ماذا؟

143
00:13:52,890 --> 00:14:00,940
في تلك الأثناء، القوّات الشّرقيّة تحت قيادة كينييمون
.متّجهة إلى المدخل الخلفيّ للقلعة كما هو مخطّط

144
00:14:08,700 --> 00:14:11,280
!يا كينييمون

145
00:14:11,280 --> 00:14:14,700
!أتينا عبر الغوّاصة

146
00:14:15,450 --> 00:14:18,880
!تشوبّر-دونو! أنت هنا

147
00:14:19,540 --> 00:14:22,630
!حسنًا! هيّا بنا

148
00:14:23,340 --> 00:14:27,510
!يا رفاقي المحاربين! أودّ تعديل خطّتنا الآن

149
00:14:27,710 --> 00:14:33,100
.يبدو أنّه لم يصلهم خبر بوصولنا بعد

150
00:14:33,100 --> 00:14:36,350
!لننفصل لمجموعتين ثانية

151
00:14:37,770 --> 00:14:42,130
،سيتسلّل النّصف الأوّل من جانب قبّة الجمجمة

152
00:14:42,130 --> 00:14:45,800
.وسينتظر اللّحظة المناسبة متنكّرين بهيئة العدوّ

153
00:14:45,800 --> 00:14:49,510
،بينما سيتسلّل النّصف الثّاني عبر المدخل الخلفي

154
00:14:49,510 --> 00:14:52,660
!وسنهاجم كايدو وأوروتشي من كِلا الجانبين

155
00:14:53,030 --> 00:14:55,240
!أنا أرتعش من الحماسة

156
00:14:55,240 --> 00:14:57,580
.أتساءل إن كنّا سنجد مومو هناك

157
00:15:00,660 --> 00:15:07,430
بالتّالي، تتواصل الخطّة في التّقدّم
.بسلاسة مع بعض التّعديلات

158
00:15:08,500 --> 00:15:13,520
في تلك الأثناء، ينتقل لو والبقيّة
...تحت البحر في الغوّاصة

159
00:15:18,980 --> 00:15:25,190
ويأخذ دنجيرو والبقيّة الطّريق
.في الجانب الجنوبيّ للجزيرة

160
00:15:25,860 --> 00:15:32,550
يختلط جينبي وروبين مع الأعداء
.وهما متخفّيان وهدفها التّسلّل للقلعة

161
00:15:32,550 --> 00:15:35,330
.وكذلك حال فرانكي وبروك

162
00:15:35,700 --> 00:15:39,500
،بينما يستمتع قراصنة مملكة الحيوان بالوليمة

163
00:15:39,500 --> 00:15:45,920
يتقدّم السّاموراي بشكل ثابت
.إلى القلعة حيث أوروتشي وكايدو

164
00:15:50,090 --> 00:15:52,010
ما الّذي يفعلونه؟

165
00:15:55,880 --> 00:15:58,430
!يا رفاق

166
00:15:58,430 --> 00:16:00,480
!أنتم

167
00:16:03,060 --> 00:16:06,640
...استدعانا كايدو-ساما

168
00:16:06,640 --> 00:16:09,110
!ونحن في عجلة من أمرنا! دعونا نمرّ

169
00:16:09,110 --> 00:16:10,530
!هيّا

170
00:16:10,530 --> 00:16:11,240
!شكرًا

171
00:16:11,240 --> 00:16:12,360
!مرحى

172
00:16:16,990 --> 00:16:22,390
هل تودّون الاستمتاع بوقتكم معي بعد
أن ينتهي عملي مع كايدو-ساما؟

173
00:16:22,390 --> 00:16:26,580
!في تلك الحالة، دعوني أمرّ

174
00:16:26,580 --> 00:16:27,900
!ماذا؟

175
00:16:27,900 --> 00:16:29,210
!لا

176
00:16:30,010 --> 00:16:32,880
!نينبو: ساحق الكرات

177
00:16:43,560 --> 00:16:46,810
.كوني امرأة ناضجة جريمة

178
00:16:46,810 --> 00:16:48,820
...كانت تلك التّقنية مرعبة

179
00:16:49,230 --> 00:16:54,550
...لم أجرّب أيّ شيء كذلك من قبل
...لكن قد أودّ اكتشاف إمكانيّات جديدة

180
00:16:54,550 --> 00:16:55,470
!لا، لا

181
00:16:55,470 --> 00:16:58,080
!لستُ مستعدًّا لذلك

182
00:17:01,870 --> 00:17:03,170
!توقّفوا

183
00:17:03,540 --> 00:17:07,960
.ولكن، كان هنالك خطأ في الحسابات

184
00:17:08,790 --> 00:17:13,150
.فهمت. كانت المعلومات على التّصاميم قديمة

185
00:17:13,150 --> 00:17:16,410
.لا عجب أنّ بنايات جديدة قد بُنيت

186
00:17:16,410 --> 00:17:21,640
لكنّه ليس مناسبًا إطلاقًا ليعبر أكثر
!من ألفَيْ محارب ذلك الجسر

187
00:17:40,660 --> 00:17:43,040
...يا كينييمون

188
00:17:44,660 --> 00:17:47,690
!...ثـ...ثـ...ثـ

189
00:17:47,690 --> 00:17:51,380
!ثمّة منزل للمتعة

190
00:17:51,800 --> 00:17:57,090
هذا منزل متعة... وهو من أملاك
!بلاد ماريا السّوداء، من التّوبي روبّو

191
00:18:02,090 --> 00:18:06,230
يراودني شعور أنّ هنالك الكثير
!من النّساء الجميلات هناك

192
00:18:06,230 --> 00:18:08,100
!كلاّ يا سانجي

193
00:18:08,350 --> 00:18:11,440
!انتظر يا سانجي-دونو

194
00:18:12,270 --> 00:18:15,280
!وكأنّ هنالك من يجرّه إليه

195
00:18:16,020 --> 00:18:18,590
!انسوا أمر سانجي-كُن

196
00:18:18,590 --> 00:18:20,790
.بغضّ النّظر عن ذلك يا كينييمون

197
00:18:21,280 --> 00:18:23,870
!سنتسلّل نحن أيضًا

198
00:18:23,870 --> 00:18:27,540
!سنشكّل فريقًا لإنقاذ مومونوسكي-ساما

199
00:18:27,540 --> 00:18:32,630
أنت تقلق عليه كثيرًا، صحيح؟

200
00:18:38,340 --> 00:18:42,060
!دع أمر إنقاذ مومو-تشان لنا

201
00:18:43,010 --> 00:18:47,310
!وهكذا يستطيع كينييمون والبقيّة التّركيز على القتال

202
00:18:47,310 --> 00:18:50,940
!نامي-دونو! كاروت-دونو! شينوبو

203
00:18:53,560 --> 00:18:58,030
!شكرًا لكنّ! لأصدقكنّ القول، كان ذلك يثقل كاهلي

204
00:18:58,400 --> 00:18:59,950
!أعتمد عليكنّ

205
00:19:14,420 --> 00:19:17,210
!خرج أحد ما من منزل المتعة

206
00:19:18,880 --> 00:19:20,470
...إنّه

207
00:19:22,970 --> 00:19:26,480
...يبدو أنّه لم يستطع إيجاد أيّ نساء

208
00:19:27,390 --> 00:19:32,000
،بعد سماع الجلبة الّتي أحدثها لوفي والبقيّة

209
00:19:32,000 --> 00:19:37,200
كان معظم أتباع كايدو وأوروتشي
...قد غادروا منزل المتعة سلفًا

210
00:19:38,320 --> 00:19:42,160
حسنًا! عدم وجود نساء في منزل المتعة
.يعني أنّ لا رجال هناك أيضًا

211
00:19:42,160 --> 00:19:44,200
!سنعبر ذلك الجسر الآن

212
00:19:49,370 --> 00:19:52,450
!دخلاء! أمسكوا بهم

213
00:19:52,450 --> 00:19:54,170
!أطيحوا بهم

214
00:20:07,050 --> 00:20:08,680
!إنّه كيلر

215
00:20:11,180 --> 00:20:13,940
!اسمعوا! اسمعوا! اسمعوا

216
00:20:14,140 --> 00:20:15,670
!أجل! أجل

217
00:20:15,670 --> 00:20:20,360
لماذا أخذت هزيمة ضعفاء مثلهم كلّ هذا الوقت؟

218
00:20:22,070 --> 00:20:24,050
أتعلمون؟

219
00:20:24,050 --> 00:20:26,850
أكل كيلر فاكهة سمايل معيبة

220
00:20:26,850 --> 00:20:31,330
!وصار من المسرورين الآن

221
00:20:52,230 --> 00:20:54,170
!يا كيلر

222
00:20:54,170 --> 00:20:58,650
!إن أكلت هذه، سأمنحك فرصة لإنقاذ قبطانك

223
00:20:58,650 --> 00:21:01,320
هيّا، ماذا ستفعل؟

224
00:21:33,470 --> 00:21:35,440
!ما المضحك في ذلك؟

225
00:21:37,400 --> 00:21:39,690
!أيّها الأوغاد

226
00:21:40,350 --> 00:21:44,070
!لا تضحكوا على صديقي

227
00:21:52,110 --> 00:21:56,790
!سأرسل كلّ من يضحك عليك للجحيم

228
00:21:58,040 --> 00:21:59,590
.مفهوم

229
00:22:01,830 --> 00:22:03,960
!أيّها المسنّن

230
00:22:03,960 --> 00:22:06,380
!لا تتسبّب في المزيد من المشاكل

231
00:22:06,380 --> 00:22:08,340
!لا يحقّ لكما الحديث

232
00:22:11,880 --> 00:22:15,730
...إذًا فقد هربوا من سجن أودون

233
00:22:15,730 --> 00:22:18,940
هل نمسك بهم؟ بإمكاننا
...الحصول على فضل ذلك

234
00:22:18,940 --> 00:22:22,320
.انس الأمر! إنّهم مجرّد حفنة من الفئران

235
00:22:22,320 --> 00:22:26,090
.بدل ذلك، جدوا ياماتو وأعلموني بمكانه

236
00:22:26,090 --> 00:22:28,990
.ستكون تلك وجبة أكبر

237
00:22:29,440 --> 00:22:31,870
!لا تدعوا ساساكي يجده أوّلاً

238
00:22:31,870 --> 00:22:33,120
!حاضر

239
00:22:36,580 --> 00:22:39,790
!لماذا تعانون في مواجهة أولئك الحمقى؟

240
00:22:39,790 --> 00:22:42,590
!اقتلوهم فحسب

241
00:22:44,130 --> 00:22:45,550
...على أيّ حال

242
00:22:46,040 --> 00:22:49,390
...لا أصدّق أنّ كوين قال

243
00:22:50,220 --> 00:22:55,060
...شاءت الصّدف أنّني أريد التّخلّص

244
00:22:56,930 --> 00:22:59,440
!من أحد التّوبي روبّو

245
00:23:01,730 --> 00:23:04,280
...ثمّة أحد ما

246
00:23:06,360 --> 00:23:08,740
.أريد قتله أيضًا

247
00:23:18,200 --> 00:23:26,090
بينما يتواصل التّسلّل إلى أونيغاشيما، يحاول
.أبناء بيغ مام دخول بلاد وانو ثانية بكلّ إصرار

248
00:23:26,090 --> 00:23:31,200
!هنالك رجل واحد يقف في طريقهم
!أجنحة من لهب ومخالب حادّة

249
00:23:31,200 --> 00:23:35,980
!اسمه ماركو العنقاء! وها قد أتى

250
00:23:36,390 --> 00:23:37,560
:في الحلقة القادمة من وان بيس

251
00:23:37,560 --> 00:23:41,080
"!وصول التّعزيزات! قائد قراصنة اللّحية البيضاء"

252
00:23:41,080 --> 00:23:45,650
.ملك القراصنة، لن يكون إلاّ أنا