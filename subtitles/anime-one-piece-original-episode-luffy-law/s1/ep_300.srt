1
00:00:15,570 --> 00:00:17,490
...الثّروة والشّهرة والسّلطة

2
00:00:17,490 --> 00:00:19,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:19,450 --> 00:00:21,370
.ملك القراصنة، غولد روجر

4
00:00:21,370 --> 00:00:25,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:25,080 --> 00:00:28,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:28,840 --> 00:00:32,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:34,800 --> 00:00:39,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:39,720 --> 00:00:42,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:43,520 --> 00:00:48,110
سنجمع كل أحلامنا

10
00:00:49,110 --> 00:00:54,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:54,950 --> 00:00:56,570
!وان بيس

12
00:01:01,080 --> 00:01:05,920
لا تجلب البوصلات سوى التّأخيرات

13
00:01:06,750 --> 00:01:11,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:12,460 --> 00:01:17,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:17,760 --> 00:01:23,310
!فإنّها ليست أسطورة إذًا

16
00:01:24,520 --> 00:01:30,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:30,230 --> 00:01:35,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:35,400 --> 00:01:37,990
!وتظاهر أنّها غير موجودة

19
00:01:38,990 --> 00:01:43,830
سنجمع كلّ أحلامنا

20
00:01:44,830 --> 00:01:50,340
ونبحر باحثين عن شيء

21
00:01:50,340 --> 00:01:53,340
،عملة في جيبي

22
00:01:53,340 --> 00:01:56,590
وتريد أن تصبح صديقي؟

23
00:01:56,590 --> 00:02:01,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:02:01,970 --> 00:02:03,890
!إنّنا كذلك

25
00:02:06,790 --> 00:02:10,000
...الثّروة والشّهرة والسّلطة

26
00:02:11,100 --> 00:02:15,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:16,840 --> 00:02:22,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:23,320 --> 00:02:27,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:27,400 --> 00:02:31,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:32,260 --> 00:02:36,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:37,480 --> 00:02:41,430
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:43,640 --> 00:02:45,810
.أخذ هذا وقتًا طويلاً بالفعل

33
00:02:45,810 --> 00:02:47,800
.لكنّني وصلت أخيرًا

34
00:02:47,800 --> 00:02:50,770
،بمجرّد أن أعبر هذه البوّابات
...فيمكنني أن أكون للحكومةِ

35
00:02:50,770 --> 00:02:54,480
!كلاّ، بل للعالم بأسره بطلاً

36
00:02:56,040 --> 00:02:59,360
لوتشي إذًا؟ إذًا فأنت تواجه
وقتًا عصيبًا ضدّه؟

37
00:02:59,890 --> 00:03:03,320
.أين هي نيكو روبين؟ أحضرت مفتاحين معي

38
00:03:03,720 --> 00:03:04,950
هل أساعدك؟

39
00:03:04,950 --> 00:03:06,820
...لا. الأهمّ من ذلك

40
00:03:07,590 --> 00:03:09,770
.أوقف روبين أرجوك

41
00:03:10,990 --> 00:03:14,890
بإمكانك الذّهاب لبوّابات العدالة
.عبر ذلك الباب خلف رجل الحمامة

42
00:03:14,890 --> 00:03:16,920
.أُخذت روبين إلى هناك سلفًا

43
00:03:17,520 --> 00:03:19,970
.سأقوم أنا بإيقافه

44
00:03:21,040 --> 00:03:23,590
!سأدع الأمر لك بشكل خارق أيّها الوغد

45
00:03:28,960 --> 00:03:30,520
!شكرًا على الانتظار

46
00:03:35,100 --> 00:03:38,570
...ذراعاي وساقاي وعنقي
،إن أمكنني التّحكّم في مداها

47
00:03:38,570 --> 00:03:40,440
!أستطيع التّلويح بسيفيّ بكلّ قوّة

48
00:03:43,400 --> 00:03:46,250
.أنا سيّاف يستعمل أسلوب السّيوف الأربعة

49
00:03:46,250 --> 00:03:49,120
أستطيع الآن الاستفادة من قوى
!الزّرافة خاصّتي بالكامل

50
00:03:49,820 --> 00:03:52,580
!ما عدت تملك أيّ فرصة أمامي

51
00:03:56,080 --> 00:03:59,000
...قوى الزّرافة قويّة جدًّا

52
00:03:59,530 --> 00:04:03,090
...بإمكانك تخزين عنقك الّذي يعرقلك

53
00:04:03,540 --> 00:04:06,720
...بإمكانك استعمال أسلوب السّيوف الأربعة

54
00:04:07,930 --> 00:04:09,220
!كلاّ

55
00:04:11,240 --> 00:04:12,270
!ماذا؟

56
00:04:12,840 --> 00:04:15,230
!أوقف هجمات سيفيّ؟

57
00:04:17,440 --> 00:04:22,950
لا شيء من ذلك... بإمكانه
.أن يكون أساسًا لهزيمتي

58
00:04:26,300 --> 00:04:30,700
الإله الشّيطانيّ زورو! وُلد تجسّد"
"!أسورا من الرّوح القتاليّة

59
00:04:49,190 --> 00:04:54,690
.يا له من ردّ عديم الفائدة
!أرني "أساسك" إذًا

60
00:04:56,920 --> 00:04:58,830
...أسلوب السّيوف الثّلاثة

61
00:05:00,000 --> 00:05:01,190
...هجوم

62
00:05:02,280 --> 00:05:03,240
النّمر

63
00:05:06,080 --> 00:05:07,200
!سوف يحلّق نحوي

64
00:05:07,200 --> 00:05:08,570
!الدّوّار

65
00:05:09,200 --> 00:05:10,310
!فنّ الورق

66
00:05:18,230 --> 00:05:21,300
!غير ممكن...! واثق أنّني كشفت هجومه

67
00:05:26,010 --> 00:05:27,930
...هل يعقل

68
00:05:31,130 --> 00:05:34,960
!أيعقل فعلاً أنّه توقّع ردّة فعلي؟

69
00:05:37,580 --> 00:05:39,900
لماذا أنت متفاجئ هكذا؟

70
00:05:40,590 --> 00:05:44,820
...لا تخبرني أنّك لم تُقطع من قبل

71
00:05:46,820 --> 00:05:49,600
فهمت... يبدو أنّك لم تكن
.مجرّد متباهٍ فحسب

72
00:05:49,600 --> 00:05:53,590
.قلّلت من شأنك قليلاً
.لكن لن يحدث ذلك بعد الآن

73
00:05:53,590 --> 00:05:59,310
،أتقنتُ القوى السّتّ. وفوق ذلك
.لديّ الآن قوى الزّرافة الجامحة

74
00:05:59,310 --> 00:06:03,540
...التّقنيات والقوّة والسّرعة
!محال أن تستطيع هزيمتي في أيّ منها

75
00:06:03,540 --> 00:06:05,420
!لن أمنحك أيّ ثغرات أخرى للهجوم

76
00:06:06,670 --> 00:06:08,090
!ساق العاصفة: شوريكن

77
00:06:15,110 --> 00:06:16,230
!برج إطلاق الزّرافة

78
00:06:18,910 --> 00:06:19,980
!سُحقًا

79
00:06:22,440 --> 00:06:24,840
...بإمكان عنقي أن يصبح سوطًا

80
00:06:24,840 --> 00:06:26,150
!سوط الجَلد

81
00:06:34,150 --> 00:06:35,580
...وإليك الآن النّسخة الأسرع

82
00:06:35,580 --> 00:06:36,700
!سوط الجَلد الشّرس

83
00:06:39,210 --> 00:06:42,210
!ما رأيك؟! أما زال بإمكانك التّباهي؟

84
00:06:45,820 --> 00:06:50,510
،لن تتوقّف هجمات السّيوف الأربعة
!لذلك استسلم فحسب

85
00:06:52,500 --> 00:06:53,800
!الجَلد الغاضب

86
00:06:59,210 --> 00:07:00,140
!...ها أنا ذا

87
00:07:03,890 --> 00:07:05,890
!يا له من هجوم شرس

88
00:07:05,890 --> 00:07:09,610
حسنًا! ما الخطب؟! كلّ ما
!تستطيع فعله هو التّصدّي لي

89
00:07:09,610 --> 00:07:12,150
!لا يمكنك هزيمتي

90
00:07:16,310 --> 00:07:17,740
.ما أنتم إلاّ قراصنة

91
00:07:17,740 --> 00:07:21,620
كانت مجابهتكم لحكومة
!العالم خطأ من الأساس

92
00:07:22,820 --> 00:07:26,960
بما أنّ الأمر آل لهذا الآن، سيتوجّب
...عليك الموت باسم العدالة

93
00:07:26,960 --> 00:07:28,420
!تمامًا كتلك المرأة

94
00:07:34,840 --> 00:07:36,480
...وغد

95
00:07:54,670 --> 00:07:56,810
!ما كان ذلك؟

96
00:07:56,810 --> 00:08:00,790
لوهلة، بدا لي كإله شيطانيّ
!بثلاثة وجوه وستّ أذرع

97
00:08:01,350 --> 00:08:04,710
!ما بال هذا الرّجل؟

98
00:08:06,800 --> 00:08:08,990
.بدأتَ تنجرف في حماسك

99
00:08:09,900 --> 00:08:12,130
.أنت تثرثر كثيرًا

100
00:08:12,640 --> 00:08:14,380
سئمت الاستماع لي؟

101
00:08:15,070 --> 00:08:18,700
،سأستعمل إذًا تقنية ساق العاصفة
،تقطيع السّماء

102
00:08:18,700 --> 00:08:20,360
...الّتي قطّعت هذا البرج

103
00:08:24,080 --> 00:08:26,860
!وأنهي هذه المعركة بتقطيعك لنصفين

104
00:08:27,210 --> 00:08:30,280
.لذلك استسلم. لا مهرب لك

105
00:08:30,280 --> 00:08:33,490
إنّها تقنية من مستوى مختلف
!تمامًا عمّا أظهرته لك قبل قليل

106
00:08:39,150 --> 00:08:40,200
...غبيّ

107
00:08:42,410 --> 00:08:45,170
.أنت من عليه الاستسلام

108
00:08:51,510 --> 00:08:54,080
...هالة الشّيطان... أسلوب السّيوف التّسعة

109
00:08:57,780 --> 00:08:59,100
!أسورا

110
00:09:03,520 --> 00:09:05,730
!...الإله الشّيطانيّ الّذي رأيته قبل قليل

111
00:09:05,730 --> 00:09:08,480
كيف له أن يظهر وهمًا قويًّا
!كهذا بروحه القتاليّة فحسب؟

112
00:09:08,970 --> 00:09:11,440
!مذهل! لكنّ الأوان قد فات

113
00:09:11,800 --> 00:09:15,570
.أنت من فات الأوان عليه

114
00:09:16,080 --> 00:09:21,390
انتظر حتّى تتفادى تقنية ساق
.العاصفة هذه قبل أن تتباهى

115
00:09:22,410 --> 00:09:24,060
!تقطيع السّماء

116
00:09:47,270 --> 00:09:48,270
...هجومي القاطع

117
00:09:49,490 --> 00:09:51,820
!تحوّل إلى ضباب؟

118
00:09:53,170 --> 00:09:55,030
!لا أمانع وجود العقبات

119
00:09:55,730 --> 00:09:58,780
!اخترت السّير على درب أسورا

120
00:10:09,960 --> 00:10:12,710
!أسورا: الضّباب الفضّيّ

121
00:11:02,550 --> 00:11:03,800
...لديّ

122
00:11:04,640 --> 00:11:07,430
.رسالة لك من زعيم غالي-لا الأصغر

123
00:11:08,850 --> 00:11:13,020
...عندما ترى... أولئك الأشخاص، أخبرهم

124
00:11:14,950 --> 00:11:17,860
.قال أنّكم مطرودون

125
00:11:38,380 --> 00:11:42,970
!اعتبرتكم أصدقائي طوال هذا الوقت

126
00:11:47,550 --> 00:11:49,110
باولي، صحيح؟

127
00:11:50,090 --> 00:11:52,440
.فهمت... أنا في ورطة

128
00:11:53,320 --> 00:11:58,900
مهارات الاغتيال ليست مفيدة
.جدًّا في الوظائف الأخرى

129
00:12:00,060 --> 00:12:02,740
.ما زال بإمكانك العمل في حديقة حيوانات

130
00:12:07,810 --> 00:12:09,620
...بربّك

131
00:12:39,180 --> 00:12:40,290
.آسف

132
00:12:57,990 --> 00:13:00,430
!يا رأس الطّحلب! أين المفتاح؟

133
00:13:00,430 --> 00:13:01,590
...نعم

134
00:13:02,590 --> 00:13:04,020
.حصلتُ عليه توًّا

135
00:13:04,990 --> 00:13:06,550
.فهمت

136
00:13:07,320 --> 00:13:09,550
.على أيّ حال، يبدو أنّ قتالكما كان حاميًا

137
00:13:09,550 --> 00:13:13,000
ألم تتسبّبا في انزلاق البرج أكثر؟
أسنكون بخير؟

138
00:13:13,000 --> 00:13:16,560
.من يهتمّ؟ ذلك ليس مهمًّا

139
00:13:18,960 --> 00:13:22,900
.على أيّ حال، لدينا الآن كلّ المفاتيح

140
00:13:28,030 --> 00:13:29,410
.نعم

141
00:13:29,960 --> 00:13:32,040
.لنسرع إلى روبين

142
00:13:37,400 --> 00:13:40,500
!اركضا

143
00:13:41,240 --> 00:13:45,510
!اركضا فحسب! واصلا الرّكض بسرعة

144
00:13:45,510 --> 00:13:50,950
من واجبنا أن ننجو لكي لا نُقلق
!أخانا وقبّعة القشّ علينا

145
00:13:51,680 --> 00:13:56,830
!اركضا لنعيش! حتّى إن كسر ذلك رجليكما

146
00:13:56,830 --> 00:13:58,060
!أجل

147
00:13:59,820 --> 00:14:01,570
!اركضا

148
00:14:01,570 --> 00:14:03,980
!نعتمد عليكما أيّها العملاقان

149
00:14:03,980 --> 00:14:08,680
يا رفاق... إن كنتم ستركبون فوقنا
!فحسب، فالتزموا الصّمت على الأقلّ

150
00:14:09,610 --> 00:14:11,450
!نعم، أوافقه الرّأي

151
00:14:11,960 --> 00:14:15,960
!انطلقا! باسم إلباف

152
00:14:15,960 --> 00:14:17,460
!اخرس

153
00:14:19,920 --> 00:14:22,690
!بسرعة يا جدّتي! أسرعي! أسرعي

154
00:14:22,690 --> 00:14:27,010
!يا تشيمني! أنا عجوز! أظهري بعض اللّطف

155
00:14:27,010 --> 00:14:31,470
يا إلهي، لا أستطيع مواصلة
.الرّكض ما لم أشرب

156
00:14:31,940 --> 00:14:33,050
!يا ويحي

157
00:14:37,550 --> 00:14:39,760
!...يا لكثرة مطالبك

158
00:14:39,760 --> 00:14:41,130
!يا جدّتي

159
00:14:41,130 --> 00:14:43,060
!عليّ أن أسرع، صحيح؟ أعلم ذلك

160
00:15:34,200 --> 00:15:35,780
!اتّصل الجسر بالجانبين أخيرًا

161
00:15:36,820 --> 00:15:38,590
!لا يمكنني الكفّ عن الضّحك

162
00:15:38,590 --> 00:15:42,170
!أنتم يا حرّاس بوّابات العدالة
!هل أنتم جاهزون؟

163
00:15:42,170 --> 00:15:45,510
نعم! سفينة المرافقة أمام
...العمود الثّالث مسبقًا و

164
00:15:45,510 --> 00:15:48,300
!هذا ليس قصدي! لماذا لا تخرجون لتحيّتي؟

165
00:15:48,300 --> 00:15:50,500
!سيعبر البطل العظيم سباندام الجسر

166
00:15:50,500 --> 00:15:51,930
!حا-حاضر! سنخرج في الحال

167
00:15:52,470 --> 00:15:55,000
يا لهم من أغبياء! لا يمكنهم فعل
!أيّ شيء من تلقاء أنفسهم

168
00:15:55,980 --> 00:15:58,470
.يا نيكو روبين. انظري إلى هناك

169
00:15:59,310 --> 00:16:03,140
.تلك البوّابة الصّغيرة هي المدخل الحقيقيّ

170
00:16:03,630 --> 00:16:08,940
عند المرور منها، سنعبر الحدّ
.بين النّعيم والجحيم

171
00:16:09,380 --> 00:16:12,900
وتلك هي اللّحظة الّتي سيُحفر
!فيها اسمي في التّاريخ

172
00:16:43,890 --> 00:16:47,590
يا ويحي. هل كنتِ تحاولين الهرب؟

173
00:16:50,100 --> 00:16:54,110
.أنا أتعاطف معك في الحقيقة على الأقلّ

174
00:16:54,610 --> 00:16:58,320
لكن ما باليد حيلة، صحيح؟
.لا قيمة لحياتك

175
00:16:59,890 --> 00:17:01,470
.أسرعي وموتي

176
00:17:04,500 --> 00:17:06,290
!تلك الحقيرة

177
00:17:09,640 --> 00:17:11,050
...لا أريد الموت

178
00:17:11,650 --> 00:17:13,010
!...لا أريد الموت

179
00:17:13,720 --> 00:17:15,970
!لا أريد الموت

180
00:17:29,610 --> 00:17:31,900
!نلت كفايتك أيّتها الحقيرة

181
00:17:31,900 --> 00:17:34,030
...هيّا قفي على قدميك

182
00:17:35,200 --> 00:17:38,660
!ماذا؟ إنّها لا تتحرّك. ما الّذي يحدث؟

183
00:17:44,290 --> 00:17:48,410
!إنّها تعضّ الجسر الحجريّ

184
00:17:48,960 --> 00:17:52,050
!إنّها لا تدري متى تستسلم
!كم هذا مزعج

185
00:17:52,570 --> 00:17:55,270
!إنّه لمن المزعج كيف تتشبّث بالحياة

186
00:17:55,270 --> 00:17:57,150
!هذا مثير للشّفقة وبذيء

187
00:17:57,150 --> 00:18:01,900
أنت مجرمة! الطّريقة الوحيدة
!لإسعاد الآخرين هي بموتك

188
00:18:01,900 --> 00:18:05,250
لماذا عليك التّصرّف ببؤس
!هكذا حتّى النّهاية؟

189
00:18:05,830 --> 00:18:09,440
...أخشى الموت كثيرًا

190
00:18:13,350 --> 00:18:14,810
!...لا أريد الموت

191
00:18:15,650 --> 00:18:17,400
...أنقذوني يا رفاق

192
00:18:20,430 --> 00:18:21,810
!...لوفي

193
00:18:25,580 --> 00:18:26,540
!مسدّس الإصبع

194
00:18:28,130 --> 00:18:29,710
!أخبرتك أنّ ذلك لا ينفع ضدّي

195
00:18:31,070 --> 00:18:32,000
!اللّوتس الصّفراء

196
00:18:34,650 --> 00:18:35,880
!يا قبّعة القشّ

197
00:18:36,780 --> 00:18:37,550
...كلاّ

198
00:18:38,460 --> 00:18:42,100
مهمّتي هي عبور ذلك الباب
!بأسرع وقت ممكن

199
00:18:45,740 --> 00:18:49,170
.لا فائدة. لا يمكنك عبوره

200
00:18:49,170 --> 00:18:50,650
!اخرس

201
00:18:50,650 --> 00:18:52,050
...المطرقة

202
00:18:52,050 --> 00:18:52,730
!الجسد الحديديّ

203
00:18:52,730 --> 00:18:54,570
!القويّة

204
00:19:09,960 --> 00:19:12,560
...ماذا؟ لم يتزحزح شبرًا واحدًا

205
00:19:13,460 --> 00:19:15,960
مع أنّه هجوم كان قويًّا كفاية
.ليرمي بتشابابا بعيدًا

206
00:19:17,260 --> 00:19:20,820
فهمت. أتيتَ بعد هزيمة فوكورو؟

207
00:19:20,820 --> 00:19:25,500
لكنّي آسف. مستوى قوّتي يفوق
.مستواه هو بخمسة أضعاف

208
00:19:35,270 --> 00:19:38,080
.من المذهل أنّك تمكّنت من هزيمة فوكورو

209
00:19:38,080 --> 00:19:41,400
يمكن القول أنّك تقف
.على حدود البشر الخارقين

210
00:19:41,400 --> 00:19:44,910
.كما توقّعت، إنّه أقوى كثير من البقيّة بشكل لا يصدّق

211
00:19:45,490 --> 00:19:47,530
.لكن... مت

212
00:19:47,530 --> 00:19:48,910
...فاكهة المطّاط

213
00:19:49,360 --> 00:19:50,620
!المسدّس النّفّاث

214
00:20:04,190 --> 00:20:06,050
...ما الّذي قمتَ

215
00:20:06,860 --> 00:20:09,730
!ما ذلك البخار؟

216
00:20:14,490 --> 00:20:16,230
.المستوى الثّاني

217
00:20:25,990 --> 00:20:28,910
.لن يدوم هذا طويلاً

218
00:20:28,910 --> 00:20:31,960
!لكنّني سأوقفه، لذلك تقدّم يا فرانكي

219
00:20:33,640 --> 00:20:35,120
!روبين تنتظر

220
00:20:36,080 --> 00:20:37,590
!حسنًا يا قبّعة القشّ

221
00:20:37,590 --> 00:20:40,890
،لا أدري ما الّذي يحدث
!لكن أطح به بذلك

222
00:20:45,370 --> 00:20:47,880
...قلتُ أنّني لن أسمح لك بالمرور

223
00:20:49,510 --> 00:20:50,520
ألم أفعل؟

224
00:20:50,520 --> 00:20:53,730
!مهلاً! أنت من مستعملي القدرات أيضًا؟

225
00:20:54,100 --> 00:20:56,770
.أوّلاً، سأقتلك يا فرانكي

226
00:21:00,480 --> 00:21:01,530
!السّوط النّفّاث

227
00:21:10,080 --> 00:21:12,900
هل نسيت يا قبّعة القشّ لوفي؟

228
00:21:12,900 --> 00:21:17,670
.أطحت بك أرضًا بهجوم واحد بهذه الهيئة

229
00:21:18,670 --> 00:21:21,880
.نعم، ذلك... أصبحت أفضل بعد أكل اللّحم

230
00:21:23,270 --> 00:21:24,470
!انتقال آنيّ

231
00:21:24,930 --> 00:21:25,510
!مسدّس الإصبع

232
00:21:27,800 --> 00:21:29,350
...فاكهة المطّاط

233
00:21:29,350 --> 00:21:30,180
!الجسد الحديديّ

234
00:21:31,680 --> 00:21:33,390
!البازوكا النّفّاثة

235
00:21:40,020 --> 00:21:40,980
!فرانكي

236
00:21:41,990 --> 00:21:43,440
!أنقذ روبين رجاءً

237
00:21:45,150 --> 00:21:47,980
!أنا لها بشكل خارق

238
00:21:59,000 --> 00:22:01,810
!أيّتها الحقيرة! ما زلت لا تستوعبين؟
!قلتُ أنّ هذا بلا فائدة

239
00:22:01,810 --> 00:22:03,380
!كم مرّة عليّ إخبارك؟

240
00:22:03,940 --> 00:22:06,220
!لم يعد لك أيّ أمل

241
00:22:07,120 --> 00:22:09,370
!لن أبارح مكاني

242
00:22:09,370 --> 00:22:13,100
!سيأتون جميعًا لإنقاذي بكلّ تأكيد

243
00:22:46,880 --> 00:22:49,590
.استمعوا جيّدًا يا رجال البحريّة
!شاهدوا جيّدًا

244
00:22:49,910 --> 00:22:53,260
هذه الخطوة العظيمة للبطل سباندام

245
00:22:53,260 --> 00:22:56,220
...الّذي سيُحفر اسمه في التّار

246
00:22:56,650 --> 00:22:59,190
!ما... ماذا؟! من هذا؟

247
00:22:59,710 --> 00:23:01,400
:في الحلقة القادمة من وان بيس

248
00:23:01,400 --> 00:23:04,820
!يرتعد سباندام خوفًا"
"!بطل يقف على برج القانون

249
00:23:04,820 --> 00:23:07,050
!ملك القراصنة، لن يكون إلاّ أنا

250
00:23:09,990 --> 00:23:14,990
نلقاكم في الحلقة القادمة