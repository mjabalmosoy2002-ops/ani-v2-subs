1
00:00:23,830 --> 00:00:27,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:38,350 --> 00:00:45,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:45,770 --> 00:00:53,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:53,440 --> 00:01:00,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:01:00,910 --> 00:01:08,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:17,470 --> 00:01:20,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:20,850 --> 00:01:24,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:24,890 --> 00:01:26,310
!اصقلوا مهاراتكم أكثر

9
00:01:26,350 --> 00:01:28,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:28,560 --> 00:01:29,940
!ارتقوا دومًا

11
00:01:29,980 --> 00:01:31,860
!وحلّقوا فوق الأمواج

12
00:01:31,900 --> 00:01:35,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:35,490 --> 00:01:39,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:39,950 --> 00:01:46,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:46,120 --> 00:01:50,290
نلتقي بأشخاص ونودّعهم، ونعيد الكرّة

16
00:01:50,340 --> 00:01:54,550
...تحت هذا العلم

17
00:01:56,300 --> 00:01:59,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:59,760 --> 00:02:03,220
نقشته برويّة هناك ذات يوم

19
00:02:03,310 --> 00:02:06,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:02:06,890 --> 00:02:09,770
!فأنا أطبق عليها بين يديّ

21
00:02:18,450 --> 00:02:21,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:21,700 --> 00:02:25,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:25,870 --> 00:02:27,210
!اصقلوا مهاراتكم أكثر

24
00:02:27,250 --> 00:02:29,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:29,540 --> 00:02:30,920
!ارتقوا دومًا

26
00:02:30,960 --> 00:02:32,750
!وحلّقوا فوق الأمواج

27
00:02:32,790 --> 00:02:36,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:36,550 --> 00:02:40,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:49,310 --> 00:02:52,730
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:52,730 --> 00:02:57,690
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:03:00,070 --> 00:03:06,410
لكن، لم يكتشفه أيّ أحد قطّ
.عدا غولد روجر، ملك القراصنة

32
00:03:07,410 --> 00:03:12,460
.دمّر العالم الجديد أحلام وطموحات الكثير من القراصنة

33
00:03:14,210 --> 00:03:20,680
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:20,680 --> 00:03:22,390
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:22,930 --> 00:03:26,640
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:29,680 --> 00:03:31,980
،بعد نجاتهم من معركة حامية

37
00:03:31,980 --> 00:03:35,010
،يدخل طاقم قبّعة القشّ العالم الجديد أخيرًا

38
00:03:35,010 --> 00:03:37,380
.البحر العاتي حيث يبسط اليونكو سيطرتهم

39
00:03:38,360 --> 00:03:41,530
،رسوا في بانك هازارد، جزيرة من جزأين
.أحدها مشتعل بالنّيران والآخر متجمّد

40
00:03:42,390 --> 00:03:47,370
،بعد اكتشافهم لدافع للسّيّد سيزار كلاون حاكم الجزيرة

41
00:03:47,700 --> 00:03:50,790
وبينما هم يحاولون الهرب جميعًا
.من سلاح الدّمار الشّامل شينوكوني

42
00:03:50,790 --> 00:03:55,250
،إلى جانب حليفهم القرصان الشّيتشيبوكاي ترافالغار لو

43
00:03:55,250 --> 00:03:58,420
،هم في طريقهم الآن لاختطاف سيزار

44
00:03:58,420 --> 00:04:01,920
.وإنقاذ الأطفال والهرب من الجزيرة

45
00:04:02,180 --> 00:04:03,920
!الرّمح النّفّاث

46
00:04:06,500 --> 00:04:07,260
!الأرضيّة

47
00:04:11,850 --> 00:04:14,170
.يا لقوّته الخفيّة المذهلة

48
00:04:14,600 --> 00:04:16,820
لكنّ السّقوط هنا

49
00:04:16,820 --> 00:04:20,460
سيقوده إلى المنحدر نحو مكبّ
.النّفايات عميقًا تحت الأرض

50
00:04:21,110 --> 00:04:24,140
.لن يتمكّن من العودة أبدًا إلاّ إن كان يستطيع الطّيران

51
00:04:24,660 --> 00:04:27,120
.لم أتوقّعه أن يحفر قبره بنفسه

52
00:04:27,770 --> 00:04:28,740
!الوداع

53
00:04:30,160 --> 00:04:31,830
!لم ينجح الأمر

54
00:04:32,370 --> 00:04:36,660
.كنتُ واثقًا جدًّا أنّ بإمكاني أخذ قلبي من سيزار

55
00:04:37,350 --> 00:04:40,420
.لكن لم أتوقّع تواجدك هنا

56
00:04:41,440 --> 00:04:42,260
!فيرغو

57
00:04:43,330 --> 00:04:44,220
!أضف "سان" لاسمي

58
00:04:58,750 --> 00:05:00,670
.أنا مشغول بأمر الآن

59
00:05:01,290 --> 00:05:03,450
هل سبب مجيء عاجل لهذه الدّرجة؟

60
00:05:04,860 --> 00:05:06,280
.يا نائب الأميرال سموكر

61
00:05:11,190 --> 00:05:15,000
"!صِدام قبضات! معركة بين نائبَيْ أميرال"

62
00:05:22,300 --> 00:05:26,970
الطّابق الثّالث للمبنى "ب" - غرفة البسكويت

63
00:05:31,130 --> 00:05:35,480
موتشا، تلك الحلوى اللّذيذة
من حقّ الجميع، صحيح؟

64
00:05:35,480 --> 00:05:37,230
.كفّوا عن القتال

65
00:05:37,230 --> 00:05:40,190
.تشاركوها وكلوها معًا كالعادة

66
00:05:40,400 --> 00:05:41,280
!كلاّ

67
00:05:41,280 --> 00:05:44,570
!ليس علينا أكلها بعد الآن

68
00:05:47,080 --> 00:05:48,820
.أنت طفلة صعبة

69
00:05:48,820 --> 00:05:51,410
!مهلاً، ما الّذي فعلته؟

70
00:05:51,660 --> 00:05:56,120
!صحيح، ليس لدينا وقت لك

71
00:05:56,120 --> 00:05:58,530
كيف أمكنكم قول شيء كهذا؟

72
00:05:58,530 --> 00:06:01,670
.أنا أعرفكم حقّ المعرفة

73
00:06:01,930 --> 00:06:05,010
.طاقم قبّعة القشّ ذائع الصّيت

74
00:06:05,380 --> 00:06:07,840
.مسرورة بلقائكم

75
00:06:09,220 --> 00:06:10,680
!من تكونين؟

76
00:06:12,100 --> 00:06:15,550
.أنا موني، وأكلت فاكهة الثّلج

77
00:06:25,710 --> 00:06:27,690
!أوسوبّ! بروك

78
00:06:27,690 --> 00:06:30,830
!سأحاول إبقاء الأطفال هنا

79
00:06:30,830 --> 00:06:33,450
!وأنتما، اذهبا وابحثا عن أغلال الحجر البحريّ

80
00:06:33,840 --> 00:06:35,360
!أغلال من الحجر البحريّ؟

81
00:06:35,360 --> 00:06:36,570
لماذا تريدينها؟

82
00:06:36,570 --> 00:06:38,120
!طلب منّي لوفي البحث عنها

83
00:06:40,410 --> 00:06:42,260
...لا أعلم السّبب، ولكن

84
00:06:43,350 --> 00:06:45,670
!يمكن الاعتماد عليّ للبحث عن الأشياء

85
00:06:45,670 --> 00:06:49,050
!سأذهب معكما! إذْ عليّ إيجاد مومونوسكي

86
00:06:49,050 --> 00:06:51,000
!حسنٌ! فلنذهب إذًا

87
00:07:01,650 --> 00:07:05,940
"المبنى "د" - غرفة تصنيع "إس إيْ دي

88
00:07:25,240 --> 00:07:26,000
ما هذه؟

89
00:07:26,850 --> 00:07:28,670
.هذه الغرفة مريبة للغاية

90
00:07:29,780 --> 00:07:32,760
.هذا ليس من شأنك

91
00:07:35,710 --> 00:07:38,970
أنت، لِمَ تشيح بنظرك عنّي؟

92
00:07:39,210 --> 00:07:43,150
.فأنا لم أستسلم بعد

93
00:07:48,100 --> 00:07:50,660
.سأتولّى أمرك لاحقًا

94
00:07:50,660 --> 00:07:53,280
فلماذا لا تخرس وتظلّ مستلقيًا أرضًا؟

95
00:07:58,460 --> 00:07:59,420
.فيرغو

96
00:08:00,630 --> 00:08:04,700
.لا أريد أن يعلم الجنود بحقيقتك

97
00:08:05,850 --> 00:08:10,130
.إنّهم يتطلّعون إليك كأب لهم

98
00:08:10,910 --> 00:08:12,830
.إنّ هذا من أقصى درجات الخيانة

99
00:08:13,260 --> 00:08:16,600
.لا يسعني تصديق أنّك كلب جوكر الطّائع

100
00:08:18,330 --> 00:08:19,350
.فات الأوان على ذلك

101
00:08:20,720 --> 00:08:24,480
.كنتُ بصحبتهم قبل دقائق معدودة

102
00:08:24,910 --> 00:08:25,980
!ماذا فعلت بهم؟

103
00:08:25,980 --> 00:08:27,360
.لا أذكر

104
00:08:27,360 --> 00:08:28,690
!فيرغو

105
00:08:31,400 --> 00:08:34,220
.أنت تتحمّس كثيرًا يا سموكر-كُن

106
00:08:35,150 --> 00:08:40,290
.لا تقل لي أنّك قلق على مشاكسي البحرية أولئك

107
00:08:42,370 --> 00:08:44,050
.أنا قائد قاعدة

108
00:08:44,050 --> 00:08:47,340
.أستطيع فعل ما أشاء لرجالي عديمي النّفع

109
00:08:50,520 --> 00:08:55,560
كما أنّه عليك الموت في كلّ الأحوال
.بما أنّك تعرف حقيقتي الآن

110
00:09:29,130 --> 00:09:32,670
،حتّى ولو كنت تعرفهم لوقت طويل

111
00:09:34,000 --> 00:09:37,190
،وحتّى ولو كنت قائد قاعدة
،وهو ما لم أعد أعترف به بعد الآن

112
00:09:38,720 --> 00:09:40,470
،فبمجرّد خروجنا من القاعدة

113
00:09:40,470 --> 00:09:43,460
.فإنّ قائد وحدة ما مسؤول عن حياة رجاله

114
00:09:44,390 --> 00:09:48,850
!إيّاك ولمس شعرة من رجالي

115
00:09:50,190 --> 00:09:53,820
المبنى "ب" - [جي-5] وسانجي

116
00:09:59,150 --> 00:10:00,910
ما الّذي يحدث هنا؟

117
00:10:00,910 --> 00:10:02,450
!هذا ساخن! ساخن

118
00:10:02,450 --> 00:10:04,040
!لا مكان نطأ فيه هنا

119
00:10:04,040 --> 00:10:06,460
!ما الّذي حدث هنا؟

120
00:10:06,680 --> 00:10:09,420
!أسرعوا! احملوا الجرحى ودعونا نتقدّم

121
00:10:09,420 --> 00:10:12,920
!كما علينا حماية تاشيغي-تشان

122
00:10:12,920 --> 00:10:14,090
!توقّفوا عن هذا

123
00:10:14,420 --> 00:10:16,920
!لا تكونوا ودودين معه هكذا! إنّه عدوّنا

124
00:10:16,920 --> 00:10:19,220
!هكذا قد يعرّف العالم علاقتنا

125
00:10:19,220 --> 00:10:21,180
!لكنّ القراصنة أحرار

126
00:10:21,180 --> 00:10:25,500
،عندما ضربت فيرغو المزيّف بركلة يا أخي

127
00:10:25,500 --> 00:10:27,990
!بدوتَ رائعًا، حتّى أنا وقعت في حبّك

128
00:10:27,990 --> 00:10:30,100
!نعم، بدوت مثيرًا حقًّا يا أخي

129
00:10:30,100 --> 00:10:31,320
!اخرسوا

130
00:10:31,320 --> 00:10:33,970
!أخبرتكم أنّي لا أقبل الدّعم من الرّجال

131
00:10:33,970 --> 00:10:36,690
!كفّوا على مناداة القرصان بأخي

132
00:10:40,210 --> 00:10:43,490
!انفجرت إحدى الحاويات! إنّها تحترق

133
00:10:43,490 --> 00:10:45,650
!مهلاً، هذا سيّئ

134
00:10:45,650 --> 00:10:47,180
!ثمّة صدع على الجدار الخارجيّ

135
00:10:50,940 --> 00:10:53,710
!انفجار آخر! ما الّذي يحدث؟

136
00:10:53,710 --> 00:10:55,380
!اهربوا يا هؤلاء

137
00:10:55,380 --> 00:10:58,800
.ماذا؟ ما الخطب؟ يبدو وجهك شاحبًا

138
00:10:58,800 --> 00:11:01,550
!بدأ الغاز بالتّسرّب إلى الدّاخل

139
00:11:01,550 --> 00:11:03,910
!الغاز المميت الّذي واجهناه سابقًا

140
00:11:03,910 --> 00:11:05,780
!ماذا؟

141
00:11:05,780 --> 00:11:08,010
!اهربوا إن كنتم تريدون النّجاة

142
00:11:12,480 --> 00:11:14,440
!كلاّ

143
00:11:19,080 --> 00:11:22,740
المبنى "ب" كبير جدًّا، لكنّه سيمتلئ
!بالغاز في أيّة لحظة

144
00:11:27,740 --> 00:11:29,500
!قف وكفاك نحيبًا

145
00:11:31,230 --> 00:11:33,380
!تاشيغي-تشان، عليكِ قيادتهم

146
00:11:33,700 --> 00:11:37,550
!ستموتون إن أضعتم طريقكم
!لا تسلكوا الطّريق الخطأ

147
00:11:38,010 --> 00:11:38,910
!أيّها السّاق السّوداء

148
00:11:38,910 --> 00:11:41,470
!هيّا يا رجال! سيُقضى عليكم إن أبطأتم

149
00:11:44,280 --> 00:11:45,930
!يا رفاق! اتبعوني

150
00:11:46,470 --> 00:11:50,890
الطّابق الثّاني للمبنى "ب" - الغرفة السّرّيّة

151
00:11:54,170 --> 00:11:56,930
!يا لهم من مجموعة حمقى

152
00:11:56,930 --> 00:11:59,880
!سمحوا لشينوكوني بالدّخول بأنفسهم

153
00:11:59,880 --> 00:12:01,050
...لكن

154
00:12:01,660 --> 00:12:05,990
السّماح لهم بالموت هناك لن يساعد
!على إتمام عرض تجربتي إلى نهايته

155
00:12:06,530 --> 00:12:10,280
!"اسمع، أغلق البوّابات للمبنيين "س" و"د

156
00:12:10,280 --> 00:12:12,050
حاضر. ماذا عن "ر"؟

157
00:12:12,050 --> 00:12:13,620
.دع تلك مفتوحة

158
00:12:14,130 --> 00:12:18,920
."أريد استدراجهم إلى الطّابق الأوّل للمبنى "ر

159
00:12:19,250 --> 00:12:23,350
."في كلّ الأحوال، يحاولون بلوغ البوّابة 66 للمبنى "ر

160
00:12:24,050 --> 00:12:28,980
،لا أريدهم أن يأخذوا طريقًا خاطئًا
.لذلك دعونا  نرشدهم

161
00:12:32,930 --> 00:12:36,560
المبنى "س" - مكبّ النّفايات

162
00:12:43,960 --> 00:12:45,990
.كان ذلك فظيعًا

163
00:12:50,860 --> 00:12:52,190
أين أنا؟

164
00:12:57,330 --> 00:12:58,320
.إنّه مكسور

165
00:12:58,770 --> 00:13:00,090
أهذا مكبّ نفايات؟

166
00:13:01,890 --> 00:13:05,090
.أظنني سقطت إلى هذا القاع العميق

167
00:13:11,530 --> 00:13:13,520
!أنا جائع

168
00:13:14,330 --> 00:13:18,050
!بالتّفكير في الأمر، كنت أركض طوال الوقت

169
00:13:19,550 --> 00:13:21,580
هل يوجد ما يمكنني أكله هنا؟

170
00:13:22,040 --> 00:13:22,860
!سُحقًا

171
00:13:23,210 --> 00:13:24,750
!كلّها نفايات

172
00:13:35,890 --> 00:13:38,170
!احذر أيّها الرّجل الوقح

173
00:14:06,290 --> 00:14:09,580
!لا يروقني هذا المكان بالمرّة

174
00:14:10,160 --> 00:14:13,800
."الغرفة السّرّيّة في الطّابق الثّاني للمبنى "ر

175
00:14:13,800 --> 00:14:17,120
.لم أرد المجيء لهذه الغرفة الرّديئة

176
00:14:17,380 --> 00:14:19,900
لكن لا يجب أن أسمح لطاقم
.قبّعة القشّ بفعل ما يحلو لهم

177
00:14:20,570 --> 00:14:23,480
.لقد تمادوا كثيرًا

178
00:14:24,730 --> 00:14:27,310
.يقف جوكر إلى جانبي

179
00:14:27,310 --> 00:14:31,180
!بمجرّد وصولهم إلى هنا، سأقتلهم جميعًا دفعة واحدة

180
00:14:31,890 --> 00:14:33,030
!أيّها السّيّد

181
00:14:33,030 --> 00:14:35,930
!نحن متأهّبون للقتال منذ البارحة

182
00:14:35,930 --> 00:14:38,830
لماذا استدعيتنا إلى هنا

183
00:14:38,830 --> 00:14:41,210
حيث كان مكتب فيغابانك المقيت السّابق؟

184
00:14:41,210 --> 00:14:44,240
فيغابانك عدوّ لنا أيضًا

185
00:14:44,240 --> 00:14:46,320
!بما أنّه تسبّب بالحادثة قبل أربع سنوات

186
00:14:46,620 --> 00:14:50,820
!ألا يوجد ما نستطيع فعله؟

187
00:14:50,820 --> 00:14:52,950
!ألا يجدر بنا قتالهم؟

188
00:14:53,200 --> 00:14:55,080
.لا، لا داعي لذلك

189
00:14:55,970 --> 00:15:00,720
!أنتم يا رجال أفضل جنود لديّ

190
00:15:02,150 --> 00:15:04,500
!لا أريد أن تُزهق أرواحكم سدى

191
00:15:04,900 --> 00:15:07,090
...أ-أيّها السّيّد

192
00:15:09,170 --> 00:15:12,430
.حسنٌ، سأشرح الخطّة

193
00:15:13,260 --> 00:15:16,970
،عندما نغلق البوّابات "س" و"د" كما سبق وقلت

194
00:15:16,970 --> 00:15:20,560
فالطّرق الوحيدة الّتي ستبقى هي المتّصلة

195
00:15:20,560 --> 00:15:22,440
.بالطّابق الأوّل للمبنى "ر" الّذي تحت هذه الغرفة

196
00:15:26,170 --> 00:15:29,680
.طاقم قبّعة القشّ أو جي-5 أو الأطفال

197
00:15:29,680 --> 00:15:31,330
،لا يهمّ إن كانوا أعداءنا أم لا

198
00:15:31,330 --> 00:15:35,200
ستكون الغرفة أسفلنا المكان الوحيد الّذي
.يستطيع هؤلاء النّاجون الذّهاب إليه

199
00:15:35,690 --> 00:15:39,670
."ثمّة نظام تهوية في الطّابق الأوّل للمبنى "ر

200
00:15:39,670 --> 00:15:43,150
لذلك بإمكاننا السّماح للهواء من الخارج
.المحمّل بشينوكوني، بالدّخول

201
00:15:43,150 --> 00:15:45,420
.ولن يكون هناك سبيل للعودة بعدها

202
00:15:45,670 --> 00:15:48,690
!من بإمكانه النّجاة من ذلك؟

203
00:15:48,690 --> 00:15:53,220
سيصبح المكان غرفة غاز ضخمة
!بعدما نغلق كلّ البوّابات

204
00:15:53,970 --> 00:15:59,120
سنبثّ ما سيحدث في تلك الغرفة
!لكلّ سماسرة السّوق السّوداء في العالم

205
00:16:00,450 --> 00:16:04,110
!وسيرون هكذا ما أنا قادر عليه

206
00:16:16,000 --> 00:16:18,860
.المعذرة أيّها السّيّد سيزار

207
00:16:20,660 --> 00:16:25,330
هل أنت من اخترع ذلك الغاز السّامّ المميت؟

208
00:16:25,880 --> 00:16:27,920
.نعم، صحيح

209
00:16:35,330 --> 00:16:41,810
إنّه يشبه غاز فيغابانك الّذي انتشر في كلّ
.أنحاء الجزيرة بعد الحادثة قبل أربع سنوات

210
00:16:41,810 --> 00:16:44,440
.لذا فالأمر يرعبنا بصراحة

211
00:16:44,440 --> 00:16:46,170
.إنّه فظيع

212
00:17:07,730 --> 00:17:08,760
أيّها السّيّد؟

213
00:17:11,030 --> 00:17:12,220
...هذه

214
00:17:14,750 --> 00:17:17,260
!معركة علم ثأريّة

215
00:17:17,260 --> 00:17:18,960
!يا رجالي

216
00:17:21,390 --> 00:17:25,670
...في ذلك اليوم، حاولتُ إيقاف

217
00:17:25,670 --> 00:17:29,190
!العالِم المجنون فيغابانك

218
00:17:29,480 --> 00:17:32,900
،كلاّ! إن انفجر سلاح كهذا"

219
00:17:33,220 --> 00:17:36,450
"!فما الّذي سيحلّ بالنّاس على الجزيرة؟

220
00:17:36,790 --> 00:17:40,080
"!توقّف يا فيغابانك"

221
00:17:43,580 --> 00:17:46,380
.لكنّ الحادثة وقعت

222
00:17:48,670 --> 00:17:54,570
وفوق ذلك، ما زال يترأسنا ككبير
!القسم العلميّ في البحريّة

223
00:17:55,330 --> 00:17:58,680
!ويُعتبر أعظم علماء العالم على الإطلاق

224
00:17:58,930 --> 00:18:01,220
!لا أستطيع تحمّل ذلك

225
00:18:01,520 --> 00:18:05,350
!إنّه الرّجل الفظيع الّذي آذاكم جميعًا

226
00:18:05,680 --> 00:18:09,900
!ألا تظنّون أنّه من الظّلم أن يبقى العالِم الأوّل في العالم؟

227
00:18:14,730 --> 00:18:15,830
!أيّها السّيّد

228
00:18:17,240 --> 00:18:19,820
!لهذا السّبب أريد إثبات خطئهم

229
00:18:20,050 --> 00:18:22,830
،لم أرد صنع سلاح دمار شامل

230
00:18:23,410 --> 00:18:27,160
!لكنّي أريد أن أريهم أنّ هنالك عالِمًا أعظم منه هنا

231
00:18:27,520 --> 00:18:30,980
!أردت إثبات أنّي أعظم عالِم في العالم

232
00:18:34,640 --> 00:18:39,760
،عندما تعترف البحريّة بذلك
،وأغدو كبير قسم الأبحاث

233
00:18:39,760 --> 00:18:41,510
.سيتحقّق حلمي

234
00:18:41,510 --> 00:18:46,180
!وسأتمكّن بمعرفتي العلميّة من تحقيق السّلام في العالم

235
00:18:49,050 --> 00:18:50,560
!أيّها السّيّد

236
00:18:50,860 --> 00:18:55,360
!آسف أيّها السّيّد! عار علينا لأنّنا شككنا بك

237
00:18:55,360 --> 00:18:58,320
!أنت هو المنقذ في النّهاية

238
00:19:00,500 --> 00:19:12,540
!أيّها السّيّد

239
00:19:12,890 --> 00:19:16,740
!شكرًا لكم! شكرًا لكم جميعًا

240
00:19:21,560 --> 00:19:23,300
!توقّف يا سيزار

241
00:19:23,690 --> 00:19:26,350
!عليك إيقاف التّجربة في الحال

242
00:19:31,230 --> 00:19:36,760
إذا ما انفجر سلاح كهذا، فماذا
!سيكون مصير قاطني الجزيرة؟

243
00:19:36,760 --> 00:19:38,940
!اخرسوا أيّها الحمقى

244
00:19:38,940 --> 00:19:43,640
أين تظنّون أنفسكم؟
!إنّ هذا مختبر أبحاثٍ تابع للقوّات

245
00:19:43,640 --> 00:19:47,320
تريد البحريّة القضاء على أكبر عدد من القراصنة

246
00:19:47,320 --> 00:19:50,620
!وما يحتاجونه هو سلاح يضمن تحقيق ذلك

247
00:19:50,620 --> 00:19:52,060
!أنت مخطئ

248
00:19:52,060 --> 00:19:56,590
!إنّهم لا يريدون سلاحًا من شأنه القضاء على المدنيين أيضًا

249
00:19:58,220 --> 00:19:59,090
!أنت غبيّ للغاية

250
00:19:59,420 --> 00:20:02,340
!تلك تضحية لا بدّ منها

251
00:20:02,340 --> 00:20:05,190
!إنّ من يورّطون أنفسهم أغبياء فحسب

252
00:20:05,190 --> 00:20:08,100
.إن فجّرنا كلّ شيء، بإمكاننا إحلال السّلام في العالم

253
00:20:09,180 --> 00:20:10,900
...ما أنت إلاّ

254
00:20:11,480 --> 00:20:13,600
!أأردت القول رجل قاس؟

255
00:20:14,010 --> 00:20:16,060
!لا بدّ أنّك تمازحني

256
00:20:16,350 --> 00:20:21,800
تستعملون السّجناء كفئران تجارب
!كأنّهم نفايات يجب التّخلّص منها

257
00:20:21,800 --> 00:20:23,610
فأين يكمن الفرق بيننا؟

258
00:20:23,610 --> 00:20:26,990
.أميرال الأسطول الحاليّ سنغوكو رقيق القلب للغاية

259
00:20:26,990 --> 00:20:31,830
.لكنّ الأميرال أكاينو سيرغب في سلاح مثله

260
00:20:32,240 --> 00:20:33,910
!اذهبوا إن كنتم قد فهمتم

261
00:20:33,910 --> 00:20:35,210
.إنّكم تعترضون طريقي

262
00:20:37,210 --> 00:20:41,660
!لا بدّ أنّ فيغابانك يحسدني لأنّني بهذه العبقريّة

263
00:20:41,660 --> 00:20:46,140
.سمعتُ أنّه فشل في تحويل البشر لعمالقة ثانية

264
00:20:46,140 --> 00:20:51,040
لا يمكن جعل النّاس أكبر حجمًا
.في وقت قصير إلاّ إن استعمل السّحر

265
00:20:51,040 --> 00:20:52,730
:لذلك أخبره دائمًا

266
00:20:53,790 --> 00:20:59,820
عليه اختطاف أطفال ما زالوا في طور
.النّموّ ويجرّب عليهم كلّ العقاقير الّتي يعرف

267
00:21:02,310 --> 00:21:04,130
...سيزار

268
00:21:10,160 --> 00:21:13,710
!نعم! نعم

269
00:21:18,800 --> 00:21:20,190
!ما-ما الّذي تفعلونه؟

270
00:21:20,190 --> 00:21:21,670
!لا تقاوم

271
00:21:21,880 --> 00:21:24,380
!أتظنّون أنّ بإمكانكم الحديث معي هكذا؟

272
00:21:24,700 --> 00:21:29,720
أوشكت على الانتهاء من صنع سلاح
!لم ترونه إلاّ في أحلامكم

273
00:21:31,210 --> 00:21:33,430
!فيغابانك! ما الّذي يحدث هنا؟

274
00:21:34,110 --> 00:21:37,310
.أنت مطرود من فريق الأبحاث هذا يا سيزار

275
00:21:37,310 --> 00:21:40,650
لا يسمح بتصرّفك غير المسؤول هنا
.وما عدت أستطيع حمايتك

276
00:21:42,850 --> 00:21:44,280
!!لا تعبثوا معي

277
00:21:44,590 --> 00:21:46,990
!لا تفعلها يا سيزار

278
00:22:06,390 --> 00:22:07,950
!أغبياء

279
00:22:07,950 --> 00:22:12,300
،فيغابانك والبحريّة وقبّعة القشّ والرّجال المتواجدون هنا

280
00:22:12,300 --> 00:22:17,390
!كلّهم أقلّ ذكاء منّي، بل أغبياء ككومة صخور

281
00:22:17,390 --> 00:22:19,900
!والآن، فلنبدأ الأمر

282
00:22:22,820 --> 00:22:25,780
!البوّابة الرّابطة بين "س" و"ب" تُغلق

283
00:22:26,610 --> 00:22:29,570
!البوّابة الرّابطة بين "د" و"ب" تُغلق

284
00:22:30,090 --> 00:22:34,970
"لا يستطيع أحد الدّخول للمبنيين "س" و"د
.من المبنى "ب" حاليًّا

285
00:22:35,780 --> 00:22:37,870
!اركضوا بكلّ قوّتكم

286
00:22:58,450 --> 00:23:00,370
أقلت شيئًا ما؟

287
00:23:01,380 --> 00:23:03,230
!من تكون؟

288
00:23:03,490 --> 00:23:06,650
...مـ

289
00:23:12,090 --> 00:23:13,770
...من

290
00:23:13,770 --> 00:23:16,230
!تكون أنت؟

291
00:23:25,050 --> 00:23:28,250
عميقًا داخل المبنى "س" الّذي قيل
،أنّ الهرب منه مستحيل

292
00:23:28,250 --> 00:23:32,530
يجد لوفي نفسه في وضع يائس
.ثمّ يلتقي بتنّين صغير

293
00:23:32,970 --> 00:23:37,080
يصف التّنّين نفسه بالمحارب
.وقد قهر قدرًا غريبًا

294
00:23:37,080 --> 00:23:40,390
.يقرّر لوفي القيام بخطوة ما بعد لقائهما المفاجئ

295
00:23:40,390 --> 00:23:41,740
:في الحلقة القادمة من وان بيس

296
00:23:41,740 --> 00:23:44,500
"!تنّين صغير! ظهور مومونوسكي"

297
00:23:44,500 --> 00:23:46,560
!ملك القراصنة، لن يكون إلاّ أنا

298
00:23:49,990 --> 00:23:54,990
!!نراكم في الحلقة القادمة