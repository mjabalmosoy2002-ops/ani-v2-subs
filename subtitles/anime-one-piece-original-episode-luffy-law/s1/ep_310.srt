1
00:00:15,570 --> 00:00:17,490
...الثّروة والشّهرة والسّلطة

2
00:00:17,490 --> 00:00:21,370
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

3
00:00:21,370 --> 00:00:25,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

4
00:00:25,080 --> 00:00:28,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

5
00:00:28,840 --> 00:00:32,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

6
00:00:34,800 --> 00:00:39,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

7
00:00:39,720 --> 00:00:42,810
!دخل العالم في عصر قراصنة عظيم

8
00:00:43,520 --> 00:00:48,110
سنجمع كل أحلامنا

9
00:00:49,110 --> 00:00:54,650
ونبحر باحثين عن شيء، باحثين عن

10
00:00:54,950 --> 00:00:56,570
!وان بيس

11
00:01:01,080 --> 00:01:05,920
لا تجلب البوصلات سوى التّأخيرات

12
00:01:06,750 --> 00:01:11,750
أهذي بالحمّى، أمسك بمقود السّفينة

13
00:01:12,460 --> 00:01:17,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

14
00:01:17,760 --> 00:01:23,310
!فإنّها ليست أسطورة إذًا

15
00:01:24,520 --> 00:01:30,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

16
00:01:30,230 --> 00:01:35,400
فاركب إيقاع أحدهم الحيويّ فحسب

17
00:01:35,400 --> 00:01:37,990
!وتظاهر أنّها غير موجودة

18
00:01:38,990 --> 00:01:43,830
سنجمع كلّ أحلامنا

19
00:01:44,830 --> 00:01:50,340
ونبحر باحثين عن شيء

20
00:01:50,340 --> 00:01:53,340
،عملة في جيبي

21
00:01:53,340 --> 00:01:56,590
وتريد أن تصبح صديقي؟

22
00:01:56,590 --> 00:02:01,100
!إنّنا، إنّنا في رحلة بحريّة

23
00:02:01,970 --> 00:02:03,890
!إنّنا كذلك

24
00:02:06,790 --> 00:02:10,000
...الثّروة والشّهرة والسّلطة

25
00:02:11,100 --> 00:02:15,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

26
00:02:16,840 --> 00:02:22,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

27
00:02:23,320 --> 00:02:27,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

28
00:02:27,400 --> 00:02:31,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

29
00:02:32,260 --> 00:02:36,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

30
00:02:37,350 --> 00:02:41,400
!دخل العالم في عصر قراصنة عظيم بالفعل

31
00:02:44,680 --> 00:02:47,990
هل أنتم مجانين؟! لا تظنّوا أنّكم ستنجون

32
00:02:47,990 --> 00:02:49,850
!بعد جعلكم للعالم بأسره عدوًّا لكم

33
00:02:50,500 --> 00:02:54,690
سأطارد تلك المرأة حتّى
...أقاصي الأرض وأقضي عليها

34
00:02:55,190 --> 00:02:57,360
!أريد أن أعيش

35
00:03:00,820 --> 00:03:07,690
!الرّشّاش النّفّاث

36
00:03:45,220 --> 00:03:46,080
!لوفي

37
00:03:46,730 --> 00:03:47,870
!...لوفي

38
00:03:50,010 --> 00:03:51,830
!...العمود الأوّل

39
00:03:55,000 --> 00:03:57,370
.هـ-هذا تقرير إلى كلّ السّفن

40
00:03:57,370 --> 00:03:58,920
!تقرير إلى كلّ السّفن

41
00:03:59,500 --> 00:04:03,090
...السّيّد روب لوتشي من السّي بي 9

42
00:04:03,440 --> 00:04:06,930
الّذي كان يواجه القرصان
...قبّعة القشّ لوفي

43
00:04:07,810 --> 00:04:10,930
!قد هُزم

44
00:04:16,700 --> 00:04:17,730
...لوفي

45
00:04:21,610 --> 00:04:22,920
...انتهى الأمر

46
00:04:23,880 --> 00:04:26,200
.سنكون بخير الآن

47
00:04:30,660 --> 00:04:34,580
!سنعود معًا جميعًا

48
00:04:35,400 --> 00:04:40,050
!روبين

49
00:04:55,890 --> 00:05:00,930
!ومن عُرض البحر، يظهر صديق"
"!رابط قراصنة قبّعة القشّ الأقوى

50
00:05:03,790 --> 00:05:04,490
...هـ

51
00:05:04,870 --> 00:05:06,740
!هـ-هذا غير ممكن

52
00:05:07,120 --> 00:05:10,080
يُعتبر السّيّد روب لوتشي
قائد السّي بي 9 الحاليّ

53
00:05:10,080 --> 00:05:12,510
.الأقوى في تاريخ سايفر بول

54
00:05:12,510 --> 00:05:18,640
يصعب التّصديق أنّ حتّى
!...هو قد هُزم على يد قرصان

55
00:05:36,140 --> 00:05:40,110
!فاز لوفي

56
00:06:06,860 --> 00:06:08,840
.لقد أقلقني عليه لوهلة

57
00:06:08,840 --> 00:06:11,260
!نجحت أخيرًا إذًا يا قبّعة القشّ

58
00:06:11,710 --> 00:06:12,930
!لوفي

59
00:06:15,060 --> 00:06:18,390
يا رفاق! لنصعد سفينة الهروب
!في الحال! سوف نشدّ رحالنا

60
00:06:20,280 --> 00:06:22,610
!فعلتَها يا لوفي

61
00:06:25,310 --> 00:06:27,610
!فعلتَها يا قبّعة القشّ

62
00:06:28,820 --> 00:06:32,030
!أ-أيّها المغفّلون! بإمكانهم سماعنا

63
00:06:32,370 --> 00:06:34,940
!لا بأس بذلك! سنُعلمه بذلك

64
00:06:34,940 --> 00:06:36,910
!أنتم! لمن هذه الأصوات؟

65
00:06:37,350 --> 00:06:40,710
لا ندري! إنّها تصدر من مكان ما
!عبر حلزون الاتّصال

66
00:06:40,710 --> 00:06:42,880
!أخي

67
00:06:50,080 --> 00:06:52,270
...ماذا؟! هذا الصّوت

68
00:07:03,100 --> 00:07:08,220
،توقّفوا! لو أنّنا غادرنا فحسب
!لكنّا أمواتًا في أنظارهم الآن

69
00:07:08,220 --> 00:07:09,650
...يا رفاق

70
00:07:10,320 --> 00:07:11,450
...هؤلاء

71
00:07:15,450 --> 00:07:18,990
أيعقل أنّهم القراصنة الّذين أطحنا
بهم عند البوّابة الرّئيسيّة؟

72
00:07:18,990 --> 00:07:23,790
كلاّ، لا يمكن... أنا واثق أنّهم
!وقعوا جميعًا من الجرف

73
00:07:23,790 --> 00:07:25,460
.من المستحيل أن يكونوا قد نجوا

74
00:07:32,420 --> 00:07:35,170
!سُحقًا! إنّه هجوم مدفع

75
00:07:35,170 --> 00:07:37,390
!أخي

76
00:08:15,870 --> 00:08:17,890
!أيّها الغبيّ! لا تدفع

77
00:08:17,890 --> 00:08:18,980
!لا تتحرّك

78
00:08:18,980 --> 00:08:20,310
!سنسقط

79
00:08:20,310 --> 00:08:21,360
!ستنقطع الحبال

80
00:08:21,360 --> 00:08:24,390
!أيّها الأوغاد! حبال غالي-لا لا تنقطع أبدًا

81
00:08:25,580 --> 00:08:27,480
يا إلهي، مع أنّي أخبرتكم
...أن تلزموا الصّمت

82
00:08:28,480 --> 00:08:30,960
!جميعنا بخير

83
00:08:30,960 --> 00:08:34,730
!تكبّد العملاقان جلّ نيران المدفع

84
00:08:35,490 --> 00:08:38,460
.مدهش! إنّهم أشدّاء بالفعل

85
00:08:38,460 --> 00:08:41,160
!يا جدّتي! جميعهم على قيد الحياة

86
00:08:42,410 --> 00:08:45,060
!سودوم وغومورا بخير أيضًا

87
00:08:45,060 --> 00:08:46,460
!سعيد لسماعي لهذا

88
00:08:46,460 --> 00:08:50,650
،حسنًا، إن أطلنا البقاء هنا أكثر
!فستعود السّفن الحربيّة ثانيةً

89
00:08:50,650 --> 00:08:52,140
!لنسرع ونغادر المكان

90
00:08:52,140 --> 00:08:57,050
،على أيّ حال... لدينا وسيلة هرب
!لذلك لا تقلق علينا

91
00:08:57,050 --> 00:08:58,690
!سنراك بعد أن نخرج من هنا أحياء

92
00:08:58,690 --> 00:08:59,880
!هذا صحيح

93
00:08:59,880 --> 00:09:00,930
!لنسرع

94
00:09:01,460 --> 00:09:04,140
!عليكم الإسراع والتّسلّق بسرعة

95
00:09:04,430 --> 00:09:06,880
!إنّ الدّماء تتدفّق صعودًا إلى رأسي

96
00:09:06,880 --> 00:09:09,150
!بل نزولاً في الواقع

97
00:09:09,670 --> 00:09:11,420
!حسنًا، تسلّقوا

98
00:09:12,230 --> 00:09:13,910
!تسلّقوا ببطء

99
00:09:13,910 --> 00:09:15,170
!سوف نسقط

100
00:09:16,070 --> 00:09:17,910
!لا تهتزّوا

101
00:09:18,440 --> 00:09:21,080
!...يا رفاق...! يا أغبياء

102
00:09:21,080 --> 00:09:25,080
!لم أكن قلقًا عليكم يا رفاق! يا لكم من أغبياء

103
00:09:26,620 --> 00:09:32,040
!هؤلاء الأغبياء أحياء
!أنا... أنا جدّ سعيد بذلك

104
00:09:34,070 --> 00:09:36,750
.نعم. يا لها من راحة بالفعل

105
00:09:37,370 --> 00:09:40,220
لكن لا فائدة إن متّ هنا، صحيح؟

106
00:09:42,110 --> 00:09:43,910
.نعم. معك حقّ

107
00:09:45,310 --> 00:09:47,810
!هل علينا التّوجّه للبوّابة الرّئيسيّة في الحال؟

108
00:09:48,200 --> 00:09:51,230
،افعلوا ذلك لاحقًا. أمّا الآن
.علينا تركيز جهودنا هنا

109
00:09:51,230 --> 00:09:55,240
!ما الّذي تفعلونه جميعًا؟
!واصلوا تنفيذ واجبكم بسرعة

110
00:09:55,240 --> 00:09:56,240
!حاضر

111
00:10:00,820 --> 00:10:04,540
!يا هؤلاء! هلمّوا عليّ بالقدر الّذي تشاؤون

112
00:10:05,450 --> 00:10:08,170
!جوّ الصّاعقة

113
00:10:11,090 --> 00:10:12,590
!فخّ النّمر

114
00:10:13,090 --> 00:10:14,840
!قاطع الغول

115
00:10:15,810 --> 00:10:17,300
!مدفع العنقاء

116
00:10:22,360 --> 00:10:24,060
!مائة زهرة

117
00:10:32,350 --> 00:10:35,270
!راقبوا قبّعة القشّ في العمود الأوّل

118
00:10:35,270 --> 00:10:37,620
...حا-حاضر، لكن

119
00:10:39,240 --> 00:10:43,380
يبدو أنّ قبّعة القشّ لوفي
!مصاب إصابات خطيرة أيضًا

120
00:10:43,380 --> 00:10:46,750
!إنّه لا يتحرّك على الإطلاق

121
00:10:48,440 --> 00:10:49,370
!ماذا قال؟

122
00:11:11,770 --> 00:11:13,730
!يا لوفي

123
00:11:14,070 --> 00:11:17,760
!ما الّذي تفعله؟! أسرع وغادر ذلك المكان

124
00:11:17,760 --> 00:11:19,610
!علينا أن نهرب وإلاّ فلن ننجو

125
00:11:26,500 --> 00:11:29,820
!ما الخطب؟! نكاد ننتهي

126
00:11:29,820 --> 00:11:31,790
!استعمل قوى المطّاط لترمي بنفسك إلى هنا

127
00:11:31,790 --> 00:11:34,080
!سأحملك بمجرّد أن تأتي إلى هنا

128
00:11:39,800 --> 00:11:42,580
نحن محاصرون بين البحر
!ومجموعة سفن حربيّة

129
00:11:42,580 --> 00:11:44,970
!سوف نُقتل إن بقينا هنا

130
00:11:45,500 --> 00:11:49,000
يبدو أنّ القراصنة يحاولون الهرب
.باستعمال سفينة المرافقة

131
00:11:49,000 --> 00:11:49,980
.نعم

132
00:11:50,310 --> 00:11:52,940
!لوفي

133
00:12:00,870 --> 00:12:05,490
!لوفي! أيمكنك سماعي يا لوفي؟

134
00:12:07,930 --> 00:12:09,350
...لا-لا أستطيع

135
00:12:13,480 --> 00:12:14,500
...إنّ جسدي

136
00:12:20,690 --> 00:12:22,630
.يأبى أن يتحرّك

137
00:12:23,360 --> 00:12:24,810
يأبى أن يتحرّك...؟

138
00:12:25,950 --> 00:12:29,890
!لا تكن سخيفًا! هزمتَ العدوّ

139
00:12:29,890 --> 00:12:34,350
!استعدنا روبين أيضًا
!كلّ ما بقي لنا هو العودة

140
00:12:34,350 --> 00:12:36,770
!أرجوك! ابذل جهدًا أكبر

141
00:12:43,880 --> 00:12:44,530
!أوسوبّ

142
00:12:47,490 --> 00:12:50,670
!لنأخذ السّفينة إلى العمود حيث لوفي

143
00:12:50,670 --> 00:12:52,450
!يا رفاق! أسرعوا على متن السّفينة

144
00:12:53,770 --> 00:12:54,370
!أطلقوا

145
00:13:07,260 --> 00:13:08,970
!...كلاّ! سفينة هروبنا

146
00:13:13,810 --> 00:13:16,950
...مصيبة...! الوضع ميؤوس منه الآن

147
00:13:16,950 --> 00:13:20,570
فيما عدا تلك السّفينة، فلا توجد
!طريقة أخرى للهرب من هنا

148
00:13:27,200 --> 00:13:31,030
!كوكورو-سان... تشيمني... غونبي... تشوبّر

149
00:13:52,710 --> 00:13:54,720
...مـ-مستحيل

150
00:14:08,150 --> 00:14:09,530
!سأموت

151
00:14:14,700 --> 00:14:16,870
!إنّهم بخير بطريقة ما

152
00:14:17,410 --> 00:14:18,620
!ابتعدوا عن طريقي

153
00:14:18,620 --> 00:14:20,010
!هذا ممتاز

154
00:14:28,760 --> 00:14:31,800
!سانجي-كُن! أين كنت طوال هذا الوقت؟

155
00:14:34,160 --> 00:14:36,900
.أنا آسف بشأن ذلك
.كان عليّ تولّي أمر ما

156
00:14:39,030 --> 00:14:41,810
.ولكنّ حالنا هذا فظيع
!نحن في وضع لا نحسد عليه

157
00:14:42,500 --> 00:14:44,590
،بما أنّنا أنقذنا روبين-تشان

158
00:14:44,590 --> 00:14:47,530
ظننت أنّهم لن يهاجموا هذه
...المنطقة. لكنّ السّفينة

159
00:14:49,320 --> 00:14:52,570
!هذه نهايتكم يا أوغاد
...دع العجوز الآن و

160
00:14:52,570 --> 00:14:55,160
!لا وقت لذلك

161
00:14:55,700 --> 00:14:57,710
!ركل حوريّة البحر

162
00:15:02,990 --> 00:15:04,000
.أطلقوا

163
00:15:10,610 --> 00:15:12,290
!إنّهم يطلقون على رجالهم أيضًا

164
00:15:12,290 --> 00:15:14,100
!حاصروهم في العمود الثّاني

165
00:15:14,470 --> 00:15:15,310
!أطلقوا

166
00:15:18,730 --> 00:15:21,570
!انتبهوا! اركضوا! اركضوا

167
00:15:23,040 --> 00:15:23,960
!أطلقوا

168
00:16:05,370 --> 00:16:08,950
!سُحقًا! لقد هدموا الجسر بأكمله أخيرًا

169
00:16:08,950 --> 00:16:10,470
!إنّنا محاصرون على هذا العمود

170
00:16:10,470 --> 00:16:12,850
!ليست لدينا أيّ خيارات أخرى

171
00:16:12,850 --> 00:16:15,330
!لا خيار أمامنا سوى قتالهم جميعًا من هنا

172
00:16:15,330 --> 00:16:19,240
لا تكوني غبيّة! سينهالون علينا
!بأمواج من الأشخاص الأقوياء

173
00:16:19,240 --> 00:16:23,360
!جهّزوا كلّ المدافع لتطلق على العمود الأوّل

174
00:16:36,840 --> 00:16:40,270
!أجهزوا على قبّعة القشّ لوفي في الحال

175
00:16:47,300 --> 00:16:49,940
!لوفي

176
00:17:02,810 --> 00:17:05,120
لوفي في خطر! علينا إحضاره
!إلى هنا على الأقل

177
00:17:05,610 --> 00:17:07,460
!...هذا سيّئ

178
00:17:07,860 --> 00:17:09,570
!لوفي

179
00:17:10,420 --> 00:17:12,980
،لن ينجح هذا. فبسبب المسافة البعيدة

180
00:17:12,980 --> 00:17:16,800
.سأسقطه في البحر حتّى إن حاولت سحبه

181
00:17:16,800 --> 00:17:18,760
!لوفي

182
00:17:19,340 --> 00:17:22,160
!هذا سيّئ. إنّهم في وضع خطير

183
00:17:22,160 --> 00:17:26,200
!فاز قبّعة القشّ، لكن لا يستطيع النّهوض
!يبدو أنّ حياته في خطر

184
00:17:26,200 --> 00:17:27,060
!ماذا؟

185
00:17:27,060 --> 00:17:28,310
!قبّعة القشّ

186
00:17:28,310 --> 00:17:30,220
!يا قبّعة القشّ

187
00:17:31,650 --> 00:17:34,650
!قف يا قبّعة القشّ

188
00:17:34,650 --> 00:17:37,060
!تماسك يا فتى

189
00:17:37,060 --> 00:17:38,600
!يا أخي القرصان

190
00:17:39,760 --> 00:17:42,290
!لوفي! قف! أرجوك

191
00:17:42,290 --> 00:17:44,950
!ألا يوجد ما يمكنك فعله يا لوفي؟

192
00:17:44,950 --> 00:17:46,310
!لوفي

193
00:17:46,310 --> 00:17:47,460
!يا قبّعة القشّ

194
00:17:47,460 --> 00:17:50,850
!يا قبّعة القشّ! تماسك

195
00:17:50,850 --> 00:17:52,670
!يا قبّعة القشّ

196
00:17:57,450 --> 00:17:59,760
!...مصيبة... الوضع خطير فعلاً

197
00:18:02,150 --> 00:18:03,520
!لوفي

198
00:18:05,390 --> 00:18:07,600
!افعل شيئًا يا لوفي

199
00:18:08,280 --> 00:18:09,490
!يا قبّعة القشّ

200
00:18:09,490 --> 00:18:12,070
!تماسك يا قبّعة القشّ

201
00:18:12,570 --> 00:18:14,980
!يا قبّعة القشّ

202
00:18:20,280 --> 00:18:21,410
!...ها هو ثانية

203
00:18:22,010 --> 00:18:22,870
!من هذا؟

204
00:18:24,680 --> 00:18:28,620
!أنت! هل تريد أن تُقتل؟
!هذا ليس وقتًا مناسبًا لتشرد

205
00:18:29,390 --> 00:18:32,110
صوت من هذا الّذي أسمع؟

206
00:18:32,900 --> 00:18:36,590
...صـ-صحيح! هذا نفس ذلك الصّوت

207
00:18:44,970 --> 00:18:46,500
!ما الّذي يحدث؟

208
00:18:46,500 --> 00:18:47,810
!يا قبّعة القشّ

209
00:18:47,810 --> 00:18:49,170
!قبّعة القشّ

210
00:18:49,170 --> 00:18:51,920
...الأمر واضح! إنّ أتباعي

211
00:18:51,920 --> 00:18:56,050
!كلاّ! ليست تلك الأصوات
!أنا أسمع هذا الصّوت منذ مدّة

212
00:18:56,050 --> 00:18:56,950
!ماذا؟

213
00:19:09,480 --> 00:19:11,070
في الأسفل...؟

214
00:19:12,740 --> 00:19:14,670
أنظر إلى الأسفل؟

215
00:19:25,950 --> 00:19:29,980
.لستُ مخطئًا. يمكنني سمعاه
ماذا؟ من الأسفل؟

216
00:19:35,480 --> 00:19:36,360
من هذا؟

217
00:19:38,140 --> 00:19:39,440
ما هذا الشّيء؟

218
00:19:45,620 --> 00:19:47,180
!يخبرنا الصّوت أن ننظر للأسفل

219
00:19:47,180 --> 00:19:49,290
!عمّ تتحدّث أيّها الرّنّة-تشان؟

220
00:19:49,790 --> 00:19:54,360
بعد خمس ثوانٍ، أطلقوا على قبّعة
!القشّ لوفي في العمود الأوّل

221
00:19:54,360 --> 00:19:55,380
...إنّ لوفي سوف

222
00:19:55,380 --> 00:19:57,000
!يا قبّعة القشّ

223
00:20:01,760 --> 00:20:05,980
...يا لك من... فعلاً، يا لك من

224
00:20:14,230 --> 00:20:18,020
!اقفزوا للبحر

225
00:20:18,020 --> 00:20:19,150
!أربع ثوانٍ

226
00:20:19,760 --> 00:20:21,570
!إلى البحر

227
00:20:22,490 --> 00:20:23,360
!أوسوبّ؟

228
00:20:23,890 --> 00:20:26,530
روبين! هل يمكنك رمي لوفي إلى البحر؟

229
00:20:26,530 --> 00:20:27,450
!دع الأمر لي

230
00:20:27,450 --> 00:20:29,580
!غبيّ! هل تحاول دفعنا للانتحار؟

231
00:20:30,250 --> 00:20:32,620
!إنّ اليأس لن ينقذنا

232
00:20:33,270 --> 00:20:34,110
!ثلاث

233
00:20:34,870 --> 00:20:38,130
!النّجدة هنا! لقد أتت لنجدتنا

234
00:20:38,500 --> 00:20:42,010
!ما زال لدينا صديق آخر، صحيح؟

235
00:20:43,060 --> 00:20:43,970
!اثنتان

236
00:20:44,400 --> 00:20:46,620
!تشوبّر! أنظرت للأسفل؟

237
00:20:46,620 --> 00:20:47,930
!نظرت

238
00:20:51,730 --> 00:20:53,640
!مائة زهرة

239
00:21:00,370 --> 00:21:01,360
!واحدة

240
00:21:01,360 --> 00:21:03,020
!زهرة العائق

241
00:21:05,270 --> 00:21:07,160
!أنا أتحرّك! أهذا من صنيع روبين؟

242
00:21:10,410 --> 00:21:12,040
!إلى البحر

243
00:21:12,690 --> 00:21:13,960
!...إلى البحر

244
00:21:13,960 --> 00:21:15,960
!إلى البحر

245
00:21:20,700 --> 00:21:23,210
!اتبعوا لوفي

246
00:21:24,180 --> 00:21:25,510
!قادمون

247
00:21:26,810 --> 00:21:29,140
!ونحن قادمون

248
00:21:29,890 --> 00:21:31,970
!إلى البحر

249
00:21:32,400 --> 00:21:35,020
!قفز القراصنة إلى البحر

250
00:21:35,020 --> 00:21:38,690
غباء! من المستحيل أن يستطيعوا
.الهرب بعد قفزهم إلى هذا البحر

251
00:21:39,350 --> 00:21:42,060
!هل فقد القراصنة عقولهم؟

252
00:21:55,660 --> 00:21:57,980
!لنعد يا رفاق

253
00:22:07,320 --> 00:22:08,300
!أطلقوا

254
00:22:15,870 --> 00:22:18,640
!إلى أحضان بحار المغامرات

255
00:22:21,610 --> 00:22:26,610
!اصعدوا على متن ميري

256
00:22:29,220 --> 00:22:32,740
!ميري

257
00:22:34,330 --> 00:22:36,210
!أتيت لأخذكم

258
00:22:45,800 --> 00:22:48,380
.كنتُ وحيدة طوال هذا الوقت

259
00:22:49,200 --> 00:22:51,760
...لا أصدّق أنّ ما قاله ساول تحقّق

260
00:22:53,050 --> 00:22:53,930
...أصدقاء

261
00:22:54,450 --> 00:22:57,230
أنا أقدّرهم على إنقاذهم لي
.من كلّ أعماق قلبي

262
00:22:58,810 --> 00:23:00,480
:في الحلقة القادمة من وان بيس

263
00:23:00,480 --> 00:23:04,940
!هروب الجميع العظيم"
"!طريق النّصر من نصيب القراصنة

264
00:23:04,940 --> 00:23:07,160
!ملك القراصنة، لن يكون إلاّ أنا

265
00:23:10,070 --> 00:23:15,120
نلقاكم في الحلقة القادمة