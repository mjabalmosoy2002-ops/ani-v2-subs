1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:12,420 --> 00:02:15,150
!ستكون لحظة كبيرة من أجلك

29
00:02:15,150 --> 00:02:17,440
!سأشاهدها حتّى النّهاية

30
00:02:21,930 --> 00:02:24,080
!سأمنحك ساعة من الزّمن

31
00:02:30,780 --> 00:02:32,600
!اللّعنة عليك

32
00:02:41,200 --> 00:02:42,890
!من وصفتَ بالسّيّد السّخيف؟

33
00:02:43,160 --> 00:02:45,060
!أيّها القائد، إنّها شينوبو

34
00:02:45,060 --> 00:02:50,370
!إنّ أودن-ساما كان يحمي هذه البلاد طوال الوقت

35
00:02:50,920 --> 00:02:53,190
!والآن، من هو السّيّد السّخيف؟

36
00:02:53,190 --> 00:02:55,330
!أجيبوني

37
00:02:57,970 --> 00:03:01,280
ما كان الأودن ليُسمّى أودن"
".إن لم يكن يغلي

38
00:03:35,940 --> 00:03:38,900
!كان أودن-ساما يحمينا؟

39
00:03:38,900 --> 00:03:40,740
...حتّى إن أخبرتنا الآن

40
00:03:41,030 --> 00:03:43,030
!يصعب تقبّل ذلك

41
00:03:46,180 --> 00:03:48,660
!لم يفت الأوان بعد

42
00:03:48,980 --> 00:03:52,500
!عليكم معرفة حقيقة أودن-ساما

43
00:03:59,570 --> 00:04:00,880
!يكفي يا شينوبو

44
00:04:04,030 --> 00:04:05,780
!فوكوروكوجو

45
00:04:07,120 --> 00:04:10,350
!ستخلق الحقيقة الفوضى لا غير

46
00:04:10,960 --> 00:04:12,620
!اتركني

47
00:04:12,960 --> 00:04:17,900
".مات السّيّد السّخيف الّذي ثار على الشّوغن"
،هذا ما سيعتقده النّاس

48
00:04:18,170 --> 00:04:21,590
!وسينتهي الإعدام قريبًا

49
00:04:22,220 --> 00:04:25,450
.هذا هو الغرض من هذا الإعدام

50
00:04:25,450 --> 00:04:27,320
كيف لك أن تتدخّلي؟

51
00:04:27,320 --> 00:04:30,540
!تعرفين العواقب، صحيح؟

52
00:04:30,770 --> 00:04:34,160
!أنا أتشارك نفس مصيرهم سلفًا

53
00:04:34,440 --> 00:04:36,830
!أنا تابعة أودن-ساما

54
00:04:36,830 --> 00:04:41,050
!لقد صرتم كلابَ أوروتشي، لذلك لن أطيعكم

55
00:04:41,050 --> 00:04:46,010
،إن حصل أيّ شيء لأودن-ساما والبقيّة
!فسأموت معهم

56
00:04:47,580 --> 00:04:52,060
!كلاّ! سننجو جميعًا وسنطيح بكم

57
00:04:55,000 --> 00:04:56,100
!أنت واهم

58
00:04:57,130 --> 00:04:58,610
!أ-أيّها الشّوغن أوروتشي

59
00:04:59,010 --> 00:05:01,610
!أوقف الإعدام رجاءً

60
00:05:05,200 --> 00:05:06,990
!أتوسّل إليك

61
00:05:09,640 --> 00:05:11,140
!رجاءً

62
00:05:11,140 --> 00:05:13,010
!أنا أتوسّل إليك

63
00:05:23,570 --> 00:05:25,380
!إ-إنّهم بحاجة لعناية طبّيّة

64
00:05:34,040 --> 00:05:34,930
!أوروتشي

65
00:05:37,250 --> 00:05:38,980
!حثالة أغبياء

66
00:05:39,420 --> 00:05:41,570
،ليست عائلة الشّوغن فحسب

67
00:05:41,570 --> 00:05:46,570
.لكنّ كافّة عامّة النّاس اضطهدوا عشيرة كوروزومي

68
00:05:46,570 --> 00:05:54,200
أدرك النّاس في الحال مدى بٌغض
.سليلها المنتقم أوروتشي

69
00:05:56,690 --> 00:05:58,460
،في تلك الأثناء

70
00:05:58,460 --> 00:06:04,210
كان السّبب وراء رقص أودن الغريب
،وهو عارٍ لخمس سنوات

71
00:06:04,210 --> 00:06:07,740
.قد شاع بين النّاس في لمح البصر

72
00:06:07,740 --> 00:06:08,720
!ماذا؟

73
00:06:09,290 --> 00:06:13,160
...أي أنّ الشّخص الّذي أنقذني يومها كان

74
00:06:14,640 --> 00:06:18,890
!ومع ذلك سخرنا منه بشدّة

75
00:06:18,890 --> 00:06:22,760
!رغم أنّه كان يتحمّل أكثر من أيّ أحد فينا

76
00:06:22,760 --> 00:06:26,110
!سُحقًا! يا لنا من حمقى

77
00:06:27,890 --> 00:06:31,780
.اندفع الجميع نحو أودن

78
00:06:31,780 --> 00:06:36,750
أدركوا أخيرًا أنّ الإعدام المُطوّل
...الّذي كانوا يشهدوه

79
00:06:36,750 --> 00:06:41,790
في حقّ هذا الرّجل الّذي كان يواجه
...الموت أمام أعينهم

80
00:06:42,040 --> 00:06:46,340
!كان الأمل الوحيد لبلاد وانو

81
00:06:48,570 --> 00:06:50,800
!أودن-ساما، عليك أن تنجو

82
00:06:50,800 --> 00:06:53,760
!آسفة لأنّني لعنتك وأنا جاهلة لكلّ هذا

83
00:06:53,760 --> 00:06:56,470
!شكرًا لك على حمايتنا

84
00:07:02,550 --> 00:07:04,380
!فات الأوان

85
00:07:04,380 --> 00:07:06,530
!يا لهم من أشخاص ذليلين

86
00:07:07,340 --> 00:07:08,690
...أودن-ساما، لا تهتمّ

87
00:07:08,690 --> 00:07:12,450
!شكرًا لكم! سأبذل جهدي

88
00:07:13,060 --> 00:07:14,700
!يا لاستقامته

89
00:07:16,850 --> 00:07:24,080
ولكن، ما كان أوروتشي ليسمح
،بأن يستمرّ حماس النّاس هذا

90
00:07:24,420 --> 00:07:33,090
وقبل أن يدركوا، كانوا محاصرين
.برجال كايدو وأوروتشي المسلّحين

91
00:07:35,540 --> 00:07:41,620
تجاوزت حرارة الزّين 700 درجة
.مئويّة وواصلت الارتفاع

92
00:07:45,630 --> 00:07:48,280
!لن أسلّم

93
00:07:55,220 --> 00:07:59,580
حملت سهام رسائل إلى قلاع
.كلّ منطقة لنشر الحادثة للعلن

94
00:08:05,860 --> 00:08:10,860
بإمكان سهام الرّسائل في بلاد وانو
...السّفر لمسافات بعيدة

95
00:08:11,780 --> 00:08:13,480
!أودن-ساما

96
00:08:15,290 --> 00:08:17,530
!أودن-ساما

97
00:08:28,050 --> 00:08:29,400
!أيّها الرّفاق

98
00:08:30,720 --> 00:08:32,530
ما الأمر يا أودن-ساما؟

99
00:08:33,300 --> 00:08:37,920
...إن تمكّنتُ من النّجاة من هذا الغليان

100
00:08:38,230 --> 00:08:40,180
...فأنا

101
00:08:40,350 --> 00:08:44,000
!أريد فتح هذه البلاد

102
00:08:47,190 --> 00:08:50,050
...إنّهم يتحدّثون عن أمر ما

103
00:08:50,340 --> 00:08:54,590
...كنّا نتحدّث عن فتحها من قبل

104
00:08:54,590 --> 00:09:00,100
.قلتَ أنّ الانعزال مرتبط بشدّة بكوزكي

105
00:09:00,500 --> 00:09:06,620
ما الّذي عثرت عليه في البحر
!خلال ارتحالك مع روجر والبقيّة؟

106
00:09:08,670 --> 00:09:14,440
إنّ المسؤولين عن عزل هذه البلاد
...عن بقيّة العالم منذ مدّة طويلة

107
00:09:14,440 --> 00:09:16,960
!هي عشيرة كوزكي

108
00:09:18,850 --> 00:09:24,810
!وذلك من أجل حماية بلاد وانو من قوّة هائلة

109
00:09:24,810 --> 00:09:27,120
...إنّ بلاد وانو

110
00:09:27,120 --> 00:09:29,380
...بل العالم

111
00:09:29,380 --> 00:09:32,500
!ينتظر شخصًا معيّنًا

112
00:09:33,880 --> 00:09:39,470
،عندما يظهر ذلك الشّخص بعد 800 سنة

113
00:09:39,470 --> 00:09:44,770
!على هذه البلاد أن تكون مرحّبة ومتعاونة

114
00:09:47,670 --> 00:09:49,190
!دعوني أوضّح كلامي

115
00:09:55,180 --> 00:09:57,920
...سيتمكّنون هذا اليوم

116
00:09:58,560 --> 00:10:01,800
!من قتلي بكلّ تأكيد

117
00:10:04,060 --> 00:10:05,410
!مستحيل

118
00:10:05,410 --> 00:10:08,330
!...لكن إن استطعت النّجاة فعلاً من الغليان

119
00:10:09,110 --> 00:10:11,460
!مرّت ثلث المدّة بالفعل

120
00:10:11,780 --> 00:10:15,630
!كيكونوجو! لنستمع لما لدى أودن-ساما ليقوله

121
00:10:19,030 --> 00:10:21,950
...نيابة عنّي

122
00:10:22,580 --> 00:10:26,390
!افتحوا بلاد وانو

123
00:10:37,300 --> 00:10:39,570
...بإمكاننا القيام بذلك معك

124
00:10:40,970 --> 00:10:44,870
!حلمك هو حلمنا نحن

125
00:10:47,690 --> 00:10:50,330
!أحسنت القول

126
00:10:57,160 --> 00:10:59,340
!بقيت ثلاثون دقيقة

127
00:11:04,080 --> 00:11:08,640
.الأمر أشبه بالجحيم حيث حتّى الحرارة قاتلة

128
00:11:08,640 --> 00:11:11,520
.إنّ الزّيت المغليّ يطهو أودن

129
00:11:14,630 --> 00:11:16,580
!أ-أنا آسفة

130
00:11:19,220 --> 00:11:21,360
لماذا لم يمت بعد؟

131
00:11:21,360 --> 00:11:24,050
!لماذا ما زال حيًّا؟

132
00:11:27,540 --> 00:11:30,330
!اجعلوا الزّيت يغلي أكثر

133
00:12:27,250 --> 00:12:28,510
!بقيت عشر دقائق

134
00:12:56,860 --> 00:13:01,020
!لا يمكن للحرارة قتله؟

135
00:13:11,920 --> 00:13:16,310
سننطلق في مغامرة عظيمة
!تفوق ما تستطيع تخيّله

136
00:13:16,810 --> 00:13:18,360
!يا أخي الصّغير

137
00:13:32,600 --> 00:13:34,080
!بقيت خمس دقائق

138
00:13:51,330 --> 00:13:52,600
!دقيقة واحدة

139
00:14:02,130 --> 00:14:03,110
!عشر ثوانٍ

140
00:14:12,990 --> 00:14:17,460
!ثمانية! سبعة! ستّة! خمسة! أربعة

141
00:14:29,490 --> 00:14:30,390
!ثلاث ثوانٍ

142
00:14:37,580 --> 00:14:38,640
!ثانية واحدة

143
00:14:47,090 --> 00:14:51,420
!لقد نجح

144
00:14:51,560 --> 00:14:54,020
!إنّها معجزة

145
00:14:54,020 --> 00:14:57,500
!لقد نجى من الإعدام

146
00:14:58,190 --> 00:14:59,580
...إنّ أودن-ساما

147
00:14:59,580 --> 00:15:02,960
!قاوم الغليان

148
00:15:04,190 --> 00:15:05,940
!نجح

149
00:15:06,420 --> 00:15:08,220
!نجح بالفعل

150
00:15:08,220 --> 00:15:09,450
!هذا مبهر

151
00:15:09,450 --> 00:15:12,010
!إنّه انتصار أودن-ساما

152
00:15:12,010 --> 00:15:14,390
!أودن-ساما

153
00:15:17,680 --> 00:15:20,100
!بُرّئ اسم أودن-ساما أيضًا

154
00:15:20,100 --> 00:15:23,980
!والآن، البلاد بأكملها في صفّنا ثانية

155
00:15:28,760 --> 00:15:31,430
!استعدّ يا كايدو

156
00:15:31,430 --> 00:15:33,560
!لا تثر غضبه أيّها القطّ الغبيّ

157
00:15:33,560 --> 00:15:35,950
!ماذا؟! لقد فاز بالفعل

158
00:15:35,950 --> 00:15:38,540
!اخرس! لا تتحدّث بإهمال هكذا

159
00:15:49,990 --> 00:15:52,260
!ما الّذي يحدث؟

160
00:15:52,260 --> 00:15:56,850
وعدتم أن تطلقوا سراحنا جميعًا
!إن نجونا طيلة ساعة

161
00:15:59,080 --> 00:16:04,770
خطرت على بالي فكرة تغيير حُكمه من الغلي
!إلى الرّمي بالسّهام قبل دقيقة

162
00:16:06,090 --> 00:16:09,480
...ولن نقوم بإعدام أودن وحده

163
00:16:09,480 --> 00:16:12,960
!لكنّ سنعدم كلّ أفراد عائلته

164
00:16:16,020 --> 00:16:18,410
!يا له من عذر طفوليّ

165
00:16:18,410 --> 00:16:21,300
...هذا ليس ما وعدت به! إنّ أودن-ساما

166
00:16:27,400 --> 00:16:29,750
!فليُظهر نفسه كلّ ما يعترض على هذا

167
00:16:29,750 --> 00:16:32,730
!سننخر أجسادكم بالرّصاص

168
00:16:43,790 --> 00:16:46,650
!أعتمد عليكم يا رفاق

169
00:16:48,670 --> 00:16:53,960
!افتحوا بلاد وانو

170
00:17:13,410 --> 00:17:17,010
!اركضوا إلى كوري

171
00:17:19,910 --> 00:17:20,850
!شينوبو

172
00:17:26,670 --> 00:17:29,660
!لا تنظروا للوراء

173
00:17:34,510 --> 00:17:36,070
!كوزكي أودن

174
00:17:37,220 --> 00:17:40,950
.كانت فكرة مثيرة للاهتمام

175
00:17:40,950 --> 00:17:42,740
!أودن-ساما

176
00:17:43,040 --> 00:17:45,790
!اقتلوهم جميعًا

177
00:17:50,320 --> 00:17:55,090
!لاحقوهم! اقضوا على اسم كوزكي

178
00:18:09,300 --> 00:18:13,730
...أعرف أنّ جسدك "ميت" سلفًا على أيّ حال

179
00:18:13,730 --> 00:18:17,950
!هذا أقلّ ما يمكنني فعله من أجل... سأطلق عليك

180
00:18:19,890 --> 00:18:23,490
!ستنتهي حقبة كوزكي هنا

181
00:18:23,730 --> 00:18:26,040
!ستموتون جميعًا

182
00:18:28,020 --> 00:18:31,420
!لا تستخفّ بأتباعي السّاموراي

183
00:18:35,320 --> 00:18:36,420
!أودن-ساما

184
00:18:38,450 --> 00:18:39,630
!كفّا عن الأكل أيّها الشّقيّان

185
00:18:40,490 --> 00:18:42,180
!قلتُ لكما توقّفا

186
00:18:42,180 --> 00:18:43,470
!لن أعطيكما المزيد

187
00:18:55,940 --> 00:18:59,610
!مهلاً! أستسلم! أستسلم! أستسلم
!ظننتُ أنّك شخص ميّت

188
00:19:10,980 --> 00:19:13,750
!أودن-ساما

189
00:19:20,990 --> 00:19:24,720
...أنتم الحمقى الّذين عاشوا في رغد العاصمة

190
00:19:24,720 --> 00:19:27,770
!لا يمكنكم أبدًا فهم مشاعر من عاش في الجحيم

191
00:19:27,770 --> 00:19:31,350
!أهذا ما تريد قوله؟

192
00:19:40,260 --> 00:19:42,920
!عار عليكم أيّها الأوغاد

193
00:19:43,180 --> 00:19:46,080
!كيف تمكّنتم من تعذيب هؤلاء الصّغار؟

194
00:19:52,770 --> 00:19:54,830
...أنا جائع

195
00:19:55,070 --> 00:19:57,800
!هذا لأنّك تواصل إقراض المال للنّاس

196
00:20:07,000 --> 00:20:08,100
!صحيح

197
00:20:08,500 --> 00:20:11,040
!يا رفاق، اذهبوا لسرقة الطّعام

198
00:20:11,040 --> 00:20:13,870
!لا يجدر بدايميو قول ذلك

199
00:20:25,930 --> 00:20:28,090
!أنهِ أمره بسرعة

200
00:20:28,640 --> 00:20:32,830
،حتّى ولو تصرّفت ببؤس الآن

201
00:20:32,830 --> 00:20:37,040
...سيتحدث النّاس عن عظمة موتك البطوليّ لأجيال

202
00:20:37,380 --> 00:20:39,900
...لا أمانع

203
00:20:41,320 --> 00:20:44,090
!أن أُنسى

204
00:20:44,340 --> 00:20:45,780
...لكن

205
00:20:50,290 --> 00:20:54,240
!ستعيش روحي

206
00:20:56,550 --> 00:20:58,360
!ماذا؟

207
00:20:58,880 --> 00:21:02,110
!آسف بشأن العجوز الشّمطاء

208
00:21:07,270 --> 00:21:09,640
...فقد قتلتُها

209
00:21:09,640 --> 00:21:11,720
فعلاً؟

210
00:21:15,980 --> 00:21:17,670
...يا لاستقامتك

211
00:21:18,400 --> 00:21:21,560
!زد قوّتك بينما تستطيع

212
00:21:24,130 --> 00:21:26,440
...إنّني

213
00:21:27,330 --> 00:21:32,390
سأسعد إن تحدّث النّاس عنّي
.وهم يحتسون شرابهم

214
00:21:40,670 --> 00:21:43,080
!أتباعي السّاموراي

215
00:21:43,680 --> 00:21:45,000
!توكي

216
00:21:45,260 --> 00:21:46,740
!مومونوسكي

217
00:21:46,740 --> 00:21:48,200
!هيوري

218
00:21:54,100 --> 00:21:56,510
!إنّي راحل

219
00:22:03,400 --> 00:22:06,820
...ما كان الأودن ليُسمّى أودن

220
00:22:38,230 --> 00:22:42,710
!إن لم يكن يغلي

221
00:23:18,350 --> 00:23:21,750
!تشتعل النّيران في قلعة أودن بعد غارة كايدو

222
00:23:21,750 --> 00:23:25,090
،وبعد هجمات متواصلة
.ما عاد لعشيرة كوزكي من مهرب الآن

223
00:23:25,090 --> 00:23:30,050
وحتّى وهي محاصرة، تصارع توكي لإنقاذ
!حلم أودن ومستقبل البلاد

224
00:23:30,050 --> 00:23:36,360
مؤمنة بشروق الشّمس، تمنّت أمنية متّقدة
.وعهدت بمصير بلاد وانو للبقيّة

225
00:23:36,360 --> 00:23:41,350
:في الحلقة القادمة من وان بيس
"!القلعة تحترق! مصير عشيرة كوزكي"

226
00:23:41,350 --> 00:23:45,730
!ملك القراصنة، لن يكون إلاّ أنا