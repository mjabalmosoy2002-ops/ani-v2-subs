1
00:00:40,430 --> 00:00:45,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,520 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,190 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:59,030 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,790 --> 00:01:07,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,290 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,510 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,090 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,810
هيّا بنا

10
00:01:25,890 --> 00:01:29,110
دون توقّف

11
00:01:29,230 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,490 --> 00:01:39,910
سأواصل النّهوض على قدميّ

13
00:01:40,030 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,540 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,880 --> 00:01:56,010
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,390 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,390 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,810 --> 00:02:14,980
دون توقّف

21
00:02:15,110 --> 00:02:20,160
دون استسلام لمرور الوقت

22
00:02:20,280 --> 00:02:25,830
سأواصل النّهوض على قدميّ

23
00:02:26,000 --> 00:02:31,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:33,910 --> 00:03:36,210
،بعد انفصال لوفي عن بقيّة طاقمه

38
00:03:36,210 --> 00:03:40,420
وصل أخيرًا إلى مارينفورد لإنقاذ أخيه إيس
!الّذي يوشك أن يُعدم

39
00:03:40,940 --> 00:03:45,280
يقاتل لوفي وقراصنة اللّحية البيضاء
،للوصول إلى المنصّة

40
00:03:45,280 --> 00:03:50,670
لكنّ البحريّة فعّلت الجدران المطوّقة
!وأغلقت كلّ طرق الهرب للقراصنة

41
00:03:57,840 --> 00:04:01,430
!مهلاً، ما الخطب؟! يجب أن تُفعّل جميعها

42
00:04:01,640 --> 00:04:07,140
أ-أخشى أنّ ذلك الجدار لن يرتفع
!بسبب جسد أورز العملاق

43
00:04:07,410 --> 00:04:10,230
يبدو أنّ دماءه قد تسرّبت إلى النّظام

44
00:04:10,230 --> 00:04:11,970
!وجعلته أقلّ قوّة

45
00:04:13,560 --> 00:04:16,390
...أورز! إ-إنّك

46
00:04:16,970 --> 00:04:18,230
...لا يمكننا تطويق المكان كلّيًّا

47
00:04:18,750 --> 00:04:20,740
!لكن ابدأ يا أكاينو

48
00:04:38,660 --> 00:04:43,210
!تمّ إصدار أمر الإعدام"
"!اختراق الجدران المطوّقة

49
00:04:49,400 --> 00:04:51,330
!لماذا انقطع البثّ؟

50
00:04:51,330 --> 00:04:52,780
!أرونا ما يجري في مارينفورد

51
00:04:52,780 --> 00:04:54,100
!أصلحوا الأمر بسرعة

52
00:04:54,440 --> 00:04:57,560
!إنّهم يواجهون مشاكل مع حلزون الاتّصال لنقل البثّ

53
00:04:57,560 --> 00:04:59,150
!لا يوجد ما يسعنا فعله

54
00:05:01,780 --> 00:05:05,470
هل صحيح أنّ اللّحية البيضاء
!والبحريّة كان بينهما اتّفاق؟

55
00:05:08,620 --> 00:05:09,950
!افعلوا شيئًا ما

56
00:05:10,650 --> 00:05:12,870
!هل باع اللّحية البيضاء حلفاءه؟

57
00:05:15,630 --> 00:05:17,250
!ما الّذي سيحدث للحرب؟

58
00:05:19,340 --> 00:05:22,040
!ما الّذي سيحدث للعالم؟

59
00:05:31,540 --> 00:05:34,170
!يا لسخافة البحريّة

60
00:05:34,630 --> 00:05:36,860
أيعني أنّ كلّ ذلك كان مجرّد عرض جانبيّ؟

61
00:05:37,020 --> 00:05:40,560
!عدنا فقط لمشاهدة الحرب

62
00:05:40,720 --> 00:05:42,540
!لا أصدّق أنّهم يواجهون مشكلة مع حلزون الاتّصال

63
00:05:42,540 --> 00:05:44,440
إذًا فأنتم تصدّقون ذلك أيضًا؟

64
00:05:44,920 --> 00:05:45,900
أولا تصدّقه أنت؟

65
00:05:46,030 --> 00:05:48,280
!يا لكم من أغبياء

66
00:05:48,280 --> 00:05:50,870
...إنّهم لا يريدون عرضه لأنّ هنالك أمورًا

67
00:05:51,370 --> 00:05:53,830
.لا يريدون منّا أو من العالم أن يروها

68
00:06:04,150 --> 00:06:05,610
...أيّتها القبطانة بوني

69
00:06:06,130 --> 00:06:08,100
!اخرس! دعني وشأني

70
00:06:08,680 --> 00:06:11,130
"باع اللّحية البيضاء حلفاءه؟"

71
00:06:11,130 --> 00:06:12,440
!هذا هراء

72
00:06:12,740 --> 00:06:16,220
.ما كان ليفعل ذلك
!لهذا هو أسطورة حيّة

73
00:06:17,040 --> 00:06:18,280
!لنبحر يا بيبو

74
00:06:18,280 --> 00:06:19,870
!حاضر يا قبطان

75
00:06:19,870 --> 00:06:21,380
!تعال معنا يا جان بار

76
00:06:21,890 --> 00:06:25,120
!هذا صحيح أيّها المكتب الرّئيسيّ
!ولا فرص في استعادة الإشارة

77
00:06:25,120 --> 00:06:28,610
!لذلك لا أعلم ما الّذي يحدث في مارينغورد الآن

78
00:06:33,260 --> 00:06:35,210
!بركان الشّهب

79
00:06:48,060 --> 00:06:49,700
!لا يمكنهم الهرب

80
00:06:50,400 --> 00:06:53,300
!أذب الجليد الّذي يقفون عليه

81
00:07:36,230 --> 00:07:37,350
!الجليد يذوب

82
00:07:47,600 --> 00:07:49,450
...هـ-هذه المياه

83
00:07:50,990 --> 00:07:52,190
!إنّها ساخنة، ساخنة

84
00:07:52,420 --> 00:07:54,320
!إنّ مياه البحر تغلي بسبب الحمم

85
00:07:57,070 --> 00:07:58,510
!اصعدوا على الجليد

86
00:08:00,030 --> 00:08:00,870
!انظروا

87
00:08:12,530 --> 00:08:13,810
!إنّهم يسدّون هذا الجانب

88
00:08:18,560 --> 00:08:21,370
!ألا يمكننا تدمير هذا الجدار؟

89
00:08:41,920 --> 00:08:43,160
!أيّها اللّحية البيضاء

90
00:08:47,300 --> 00:08:50,750
!لم تنفع هجمات والدنا! إنّه ليس جدارًا عاديًّا

91
00:08:52,740 --> 00:08:55,260
!حسنًا، لننهِ هذا الأمر

92
00:09:03,440 --> 00:09:06,160
!أصابت الحمم سفينة موبي ديك

93
00:09:06,160 --> 00:09:07,680
!أخمدوا النّيران

94
00:09:07,990 --> 00:09:09,520
!أسرعوا جميعًا

95
00:09:10,240 --> 00:09:11,860
!افعلوا  كلّ ما بوسعكم

96
00:09:14,610 --> 00:09:16,230
!لا تدعوها تغرق

97
00:09:16,230 --> 00:09:20,090
كنّا نتطلّع قدمًا للإبحار عبر العالم
!مع إيس على تلك السّفينة ثانية

98
00:09:20,610 --> 00:09:23,980
!أيّها اللّحية البيضاء! ولّت أيّامك

99
00:09:40,740 --> 00:09:42,310
...إنّ موبي ديك

100
00:09:43,710 --> 00:09:47,130
!سُحقًا للبحريّة

101
00:09:47,460 --> 00:09:49,820
!هذه السّفينة هي مجدنا

102
00:09:51,450 --> 00:09:53,920
!تبًّا! سفينتنا

103
00:09:53,920 --> 00:09:57,150
لقد أغرقوا السّفينة الّتي حملت
!قراصنة اللّحية البيضاء لسنوات

104
00:10:22,280 --> 00:10:24,240
...أنا آسف

105
00:10:29,740 --> 00:10:32,780
!نفدت منّا السّبل لدخول السّاحة

106
00:10:36,590 --> 00:10:40,060
!ما الّذي يحدث خلف الجدران؟

107
00:10:40,060 --> 00:10:42,110
!الأمر واضح وإن كنّا لا نستطيع رؤيته

108
00:10:42,110 --> 00:10:46,840
لا يمكنهم التّقدّم أو التّراجع
!وهم عرضة لهجمات متتالية

109
00:10:46,840 --> 00:10:52,080
الجدران المطوّقة عبارة عن تابوت
!لقراصنة اللّحية البيضاء الآن

110
00:10:52,920 --> 00:10:54,270
...تابوت

111
00:10:55,460 --> 00:10:57,230
!تسير الخطّة كما يجب

112
00:10:57,590 --> 00:10:58,840
...لننتقل الآن إلى

113
00:10:59,450 --> 00:11:02,970
...إعدام بورتغاس د. إيس

114
00:11:03,680 --> 00:11:05,380
!في الحال

115
00:11:20,470 --> 00:11:22,160
...في مكان لا يمكننا الرّؤية

116
00:11:22,340 --> 00:11:24,450
!لن نسمح لهم بقتل إيس

117
00:11:24,820 --> 00:11:27,800
!نعم! ما زالت هنالك طريقة ما

118
00:11:28,270 --> 00:11:29,580
!واحدة على الأقلّ

119
00:11:30,610 --> 00:11:32,420
!الطّريق الّذي تركه لنا أورز

120
00:11:34,060 --> 00:11:35,600
!سنكون أهدافًا مكشوفة لهم إن سلكناه

121
00:11:35,600 --> 00:11:37,830
!تتوقّع البحريّة أن نسلكه بكلّ تأكيد

122
00:11:47,060 --> 00:11:49,400
!لا وقت لدينا للجدال

123
00:11:49,410 --> 00:11:53,230
..صحيح! تلك الطّريقة الوحيدة لإنقاذ إيس

124
00:12:15,170 --> 00:12:18,130
!إيس

125
00:12:25,570 --> 00:12:26,670
...قبّعة القشّ

126
00:12:26,670 --> 00:12:28,600
!نحن قادمون أيضًا

127
00:12:39,270 --> 00:12:41,400
!لا يجب عليهم سلك طريق واضح كهذا

128
00:12:41,700 --> 00:12:43,910
!ليس بعد! دعوهم يقتربون بقدر الإمكان

129
00:12:45,230 --> 00:12:46,040
!أطلقوا

130
00:12:51,620 --> 00:12:56,070
!سيدافعون عن المدخل الوحيد بكلّ تأكيد

131
00:12:56,070 --> 00:12:57,240
!هذا فخّ واضح

132
00:13:00,220 --> 00:13:01,250
!اطلقوا

133
00:13:09,880 --> 00:13:11,230
!إيس

134
00:13:32,670 --> 00:13:35,090
!إنّنا ننهي أمرهم شيئًا فشيئًا

135
00:13:45,570 --> 00:13:46,470
!إيس

136
00:13:58,380 --> 00:13:59,730
...إيس

137
00:14:22,120 --> 00:14:23,280
...إيس

138
00:14:35,070 --> 00:14:40,650
!إيس

139
00:14:41,110 --> 00:14:41,860
!أطلقوا

140
00:15:00,550 --> 00:15:02,140
!يا فتى قبّعة القشّ

141
00:15:02,140 --> 00:15:03,090
!لوفي-كُن

142
00:15:32,740 --> 00:15:37,960
!لوفي

143
00:15:53,410 --> 00:15:56,420
!أطلقوا على أيّ أحد يمرّ على أورز

144
00:16:04,950 --> 00:16:08,460
!سأنقذك وإن عنى ذلك موتي

145
00:16:13,510 --> 00:16:15,290
.ابدؤوا عمليّة الإعدام

146
00:16:38,350 --> 00:16:42,140
!إيس-كُن

147
00:17:21,910 --> 00:17:25,600
!ليتل أورز جونيور! ما زال حيًّا

148
00:17:26,530 --> 00:17:29,360
!إيس-كُن

149
00:17:31,580 --> 00:17:33,990
!إيس-كُن

150
00:17:37,500 --> 00:17:39,910
!إيس-كُن

151
00:17:40,980 --> 00:17:42,430
!...أورز

152
00:17:43,390 --> 00:17:47,200
!سأحمي إيس-كُن

153
00:17:48,070 --> 00:17:52,720
!أورز

154
00:17:52,860 --> 00:17:54,810
!أورز حيّ

155
00:17:57,360 --> 00:17:59,440
!أيّها القبطان

156
00:17:59,440 --> 00:18:00,880
!يا له من رجل

157
00:18:01,800 --> 00:18:03,440
!أورز

158
00:18:04,130 --> 00:18:05,650
!أيّها القبطان سكوارد

159
00:18:18,740 --> 00:18:20,880
!أيّها القبطان... سكوارد

160
00:18:21,800 --> 00:18:23,340
...إنّكم

161
00:18:29,340 --> 00:18:30,390
!حسنًا

162
00:18:33,990 --> 00:18:36,000
!هل أنت بخير يا لوفي-كُن؟

163
00:18:36,000 --> 00:18:37,720
!إنّك متهوّر كثيرًا بالفعل

164
00:18:42,170 --> 00:18:43,680
!استعدّوا للإطلاق

165
00:18:49,220 --> 00:18:50,810
!نار

166
00:18:52,740 --> 00:18:54,120
!أورز

167
00:18:56,640 --> 00:18:58,290
!إنّهم يهاجمون أورز ثانية

168
00:18:58,290 --> 00:18:59,120
!أورز

169
00:19:04,680 --> 00:19:05,840
!أورز

170
00:19:07,530 --> 00:19:11,240
!علينا فعل شيء ما! علينا أن نسرع

171
00:19:11,240 --> 00:19:14,500
!سيعدمون إيس

172
00:19:14,840 --> 00:19:16,930
!نعم، علينا إيقافهم

173
00:19:17,490 --> 00:19:18,760
!جينبي

174
00:19:22,060 --> 00:19:25,760
!أريدك أن تسديني خدمة

175
00:19:29,440 --> 00:19:31,350
!إيس-كُن

176
00:19:31,850 --> 00:19:34,060
!يا صلابته

177
00:19:34,060 --> 00:19:36,410
!إنّه بالكاد حيّ! واصلوا إطلاق النّار

178
00:19:36,710 --> 00:19:40,400
!حسنًا. دعوا الأمر لي

179
00:19:40,400 --> 00:19:41,170
!كيزارو-سان

180
00:19:42,270 --> 00:19:46,620
!علينا إنهاء الإعدام بسرعة

181
00:19:48,210 --> 00:19:53,970
!من الأفضل التّصويب على رأسه هذه المرّة

182
00:19:54,720 --> 00:19:55,720
!أورز

183
00:19:55,720 --> 00:19:56,830
!أيّها القبطان أورز

184
00:20:00,680 --> 00:20:02,390
!أورز

185
00:20:03,380 --> 00:20:05,460
!انتهى الأمر

186
00:20:09,770 --> 00:20:14,810
!رمية كتف تيّار المحيط

187
00:20:52,440 --> 00:20:53,440
!...لو

188
00:20:55,910 --> 00:20:57,100
!لوفي

189
00:21:24,940 --> 00:21:27,430
!عجبًا! وصلتَ أخيرًا

190
00:21:29,860 --> 00:21:33,440
!ما زلت واقفًا على قدميك يا ابن دراغون

191
00:21:35,520 --> 00:21:39,230
!إنّ شبابه أخافني

192
00:21:45,840 --> 00:21:48,920
!الرّجل الّذي قفز فوق الجدار هو أخو إيس

193
00:21:49,900 --> 00:21:51,120
!ذلك الشّقيّ

194
00:21:56,330 --> 00:22:00,140
.سأثني على عنادك فحسب

195
00:22:00,320 --> 00:22:05,010
.لكنّك لست جيّدًا كفاية لتبلغ هذه الخشبة

196
00:22:05,370 --> 00:22:08,190
ما الّذي جعلك تعتقد أنّ بإمكانك هزيمتنا؟

197
00:22:21,310 --> 00:22:27,950
!سأستعيد إيس

198
