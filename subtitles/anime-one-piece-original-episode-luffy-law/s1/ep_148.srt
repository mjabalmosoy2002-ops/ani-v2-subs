1
00:00:22,250 --> 00:00:25,280
!العالم... نعم

2
00:00:25,820 --> 00:00:27,480
...اسعوا نحو الحرّيّة

3
00:00:27,480 --> 00:00:31,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,360 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:13,460 --> 00:02:16,090
خذي ذلكما الاثنين وغادروا بسرعة

22
00:02:16,090 --> 00:02:19,260
!بينما ما زلتم قيد الحياة أيّها الضّعفاء

23
00:02:23,170 --> 00:02:25,300
.جزيرة السّماء موجودة فعلاً

24
00:02:27,170 --> 00:02:28,270
!زورو

25
00:02:29,210 --> 00:02:30,270
!لوفي

26
00:02:33,140 --> 00:02:37,150
!العصر الجديد الّذي تحدّثوا عنه مجرّد هراء

27
00:02:38,450 --> 00:02:43,090
العصر الّذي يحلم فيه القراصنة
!قد ولّى، أهذا ما قالوه؟

28
00:02:47,790 --> 00:02:50,030
...أحلام النّاس

29
00:02:51,060 --> 00:02:53,130
!لا تنتهي

30
00:02:58,300 --> 00:03:02,270
".عائلة أسطوريّة! نولاند الكذّاب"

31
00:03:04,340 --> 00:03:07,010
...سُحقًا... سُحقًا... سُحقًا

32
00:03:07,410 --> 00:03:10,680
!سُحقًا... لإنسان الغاب ذاك

33
00:03:10,680 --> 00:03:13,920
!لقد دمّر السّفينة أكثر

34
00:03:14,250 --> 00:03:18,190
.بدأت هذه السّفينة تتداعى
ربّما حان الوقت لاستبدالها؟

35
00:03:18,190 --> 00:03:20,960
إيّاك أن تجرؤ على قول أشياء
!غير مراعية كهذه أيضًا

36
00:03:20,960 --> 00:03:22,290
!إيّاك أن تجرؤ

37
00:03:22,290 --> 00:03:26,530
تعرف تمامًا كيف حصلنا على
!هذه السّفينة، صحيح؟

38
00:03:26,530 --> 00:03:28,130
!صحيح؟

39
00:03:28,130 --> 00:03:31,270
.أعلم يا أوسوبّ. لن تفيدنا الشّكوى بأيّ شيء

40
00:03:31,740 --> 00:03:35,170
.غوينغ ميري جزء مهمّ من الطّاقم

41
00:03:33,400 --> 00:03:34,870
!...تعرف تمامًا

42
00:03:34,870 --> 00:03:36,510
...تعرف... تعرف

43
00:03:35,170 --> 00:03:37,740
!لذلك دعنا نعمل بجدّ ونصلح هذه السّفينة

44
00:03:37,570 --> 00:03:41,480
!...تمامًا كيف... تمامًا كيف... تمامًا كيف

45
00:03:38,410 --> 00:03:41,480
...لوفي... إنّك فعلاً

46
00:03:44,180 --> 00:03:48,790
!أيّها الغبيّ! هل تصلحها أم تخرّبها؟

47
00:03:48,790 --> 00:03:50,990
...حسنًا، أحاول فعلاً إصلاحها، لكن

48
00:03:50,990 --> 00:03:52,320
.يا ويحي، تحطّمت ثانية

49
00:03:52,320 --> 00:03:53,920
!لوفي

50
00:03:55,290 --> 00:03:58,900
غادرنا موكتاون واتّجهنا شرقًا عن
.طريق دوراننا حول الجزيرة

51
00:03:59,300 --> 00:04:01,300
.نحن نصل النّقطة على الخريطة

52
00:04:01,570 --> 00:04:03,870
ذلك الرّجل... ما كان اسمه؟

53
00:04:04,130 --> 00:04:06,070
.مونبلان كريكت

54
00:04:06,270 --> 00:04:09,310
إذًا فالرّجل الّذي يتحدّث
عن الأحلام هناك، صحيح؟

55
00:04:09,910 --> 00:04:12,110
!هـ-هذا مذهل

56
00:04:13,010 --> 00:04:16,310
!هذا منزله؟! إنّه قصر

57
00:04:16,310 --> 00:04:21,080
!هل مونبلان كريكت هذا فاحش الثّراء؟

58
00:04:21,080 --> 00:04:23,090
.غبيّان! أمعنا النّظر

59
00:04:23,090 --> 00:04:27,960
.حالم؟ يبدو لي ساعيًا لجلب الانتباه

60
00:04:29,230 --> 00:04:30,160
لماذا؟

61
00:04:33,630 --> 00:04:36,700
!ماذا...؟! إنّه مجّرد لوح

62
00:04:36,700 --> 00:04:38,540
!ماذا؟

63
00:04:38,540 --> 00:04:41,870
.المنزل الحقيقيّ هو نصفه فحسب
.الباقي مجرّد مظاهر خادعة

64
00:04:41,870 --> 00:04:44,040
.يبدو لي رجلاً رخيصًا

65
00:04:44,640 --> 00:04:47,940
أيّ نوع من الأحلام الّتي تحدّث
عنها أدّت به ليُنفى من البلدة؟

66
00:04:47,940 --> 00:04:50,010
،لا أدري ما التّفاصيل

67
00:04:50,450 --> 00:04:54,990
لكنّني سمعتُ أنّه قال أنّ مقدارًا
.هائلاً من الذّهب موجود في جايا

68
00:04:54,990 --> 00:04:56,020
!الذّهب؟

69
00:04:56,020 --> 00:04:58,460
أهو كنز قراصنة مدفون أو ما شابه؟

70
00:04:58,460 --> 00:05:00,790
.أنا لا أدري

71
00:05:01,120 --> 00:05:03,190
!ذهب

72
00:05:03,560 --> 00:05:05,960
!احفر الأرض يا تشوبّر! سنجد الذّهب

73
00:05:05,960 --> 00:05:07,160
سنجده إن حفرت؟

74
00:05:07,500 --> 00:05:09,770
أيعيش وحده في هذا المكان المنعزل؟

75
00:05:09,770 --> 00:05:11,600
.مرحبًا. أستأذن للدّخول

76
00:05:11,600 --> 00:05:12,770
!ألم تستطع الانتظار قليلاً؟

77
00:05:14,400 --> 00:05:17,110
!لا أحد هنا. مرحبًا

78
00:05:17,980 --> 00:05:18,780
...لم يجب أحد

79
00:05:18,780 --> 00:05:21,450
انتظر أيّها الغبيّ! ما الّذي ستفعله
إن كان هذا الرّجل خطيرًا؟

80
00:05:22,010 --> 00:05:24,380
!يا رفاق! لا أحد هنا

81
00:05:26,080 --> 00:05:27,280
...هذا

82
00:05:28,550 --> 00:05:29,720
.كتاب صور

83
00:05:30,490 --> 00:05:32,790
.إنّه كتاب قديم جدًّا

84
00:05:33,560 --> 00:05:35,430
."عنوانه "نولاند الكذّاب

85
00:05:35,890 --> 00:05:39,700
!نعم، إنّه عنوان رائع
!فكرة ممتازة لكتاب

86
00:05:39,700 --> 00:05:41,630
نولاند الكذّاب"؟"

87
00:05:41,630 --> 00:05:43,270
هل تعرفه يا سانجي-كُن؟

88
00:05:43,270 --> 00:05:46,400
.لكن كُتب أنّه نشر في الأزرق الشّماليّ

89
00:05:46,400 --> 00:05:49,640
.نعم. لقد وُلدتُ في الأزرق الشّماليّ

90
00:05:49,640 --> 00:05:51,380
ألم أخبركم بذلك من قبل؟

91
00:05:51,380 --> 00:05:54,680
.هذه معلومة جديدة
.ظننتُك من الشّرقيّ أيضًا

92
00:05:54,680 --> 00:05:55,710
.كبرتُ هناك فحسب

93
00:05:55,710 --> 00:05:57,910
!اهدأ يا تشوبّر! ما الّذي تفعله؟

94
00:05:57,910 --> 00:05:58,850
!ماذا؟

95
00:05:59,850 --> 00:06:02,420
.هذه قصّة مشهورة في الشّماليّ

96
00:06:02,790 --> 00:06:08,860
إنّها قصّة خياليّة، لكن سمعتُ أنّ نولاند
.هذا عاش بالفعل قبل زمن بعيد

97
00:06:10,930 --> 00:06:13,830
...كان يا ما كان قصّة قديمة

98
00:06:13,830 --> 00:06:17,600
.تعود أحداثها لأربعمائة عام من الزّمان

99
00:06:18,870 --> 00:06:23,840
لرجل يُدعى مونبلان نولاند
.عاش في بلاد من الأزرق الشّماليّ

100
00:06:24,940 --> 00:06:30,450
كان نولاند مكتشفًا كثير الحديث
.عن مغامراته المدهشة

101
00:06:30,450 --> 00:06:35,450
ولكن، لم يستطع القرويّون الجزم ما
.إذا كانت قصصه حقيقة أم خيال

102
00:06:36,350 --> 00:06:41,190
وذات يوم، ذهب للقاء الملك
.بعد عودته من ترحاله

103
00:06:42,130 --> 00:06:46,960
رأيت جبلاً من الذّهب على"
".جزيرة في البحر العظيم

104
00:06:47,430 --> 00:06:53,400
أبحر الملك الشّجاع إلى البحر العظيم
،ليرى إن كانت القصّة حقيقيّة

105
00:06:53,400 --> 00:06:56,370
.آخذًا معه ألفَيْ جنديّ

106
00:06:56,370 --> 00:07:00,080
بعد نجاتهم من عواصف عظيمة
،ومقاتلتهم لوحوش كثيرة

107
00:07:00,380 --> 00:07:07,450
لم يصل منهم سوى الملك
.ونولاند ومائة جنديّ للجزيرة

108
00:07:07,950 --> 00:07:12,490
.ولكن، ما وجدوه كان مجرّد غابة

109
00:07:13,360 --> 00:07:17,660
في النّهاية، حُكم على نولاند
.بالموت لقاء جريمة الكذب

110
00:07:18,060 --> 00:07:21,160
:وكانت كلمات نولاند الأخيرة كالتّالي

111
00:07:21,800 --> 00:07:25,440
هذا صحيح! غرق جبل الذّهب
"!عميقًا في البحر

112
00:07:25,870 --> 00:07:28,510
.كان الملك والآخرون مصدومين

113
00:07:28,940 --> 00:07:31,840
لم يصدّق أحد نولاند بعد ذلك

114
00:07:31,840 --> 00:07:36,510
.لأنّه واصل كذبه حتّى لحظة مماته

115
00:07:37,080 --> 00:07:40,350
"عن قصص "نولاند الكذّاب
.من الأزرق الشّماليّ الخياليّة

116
00:07:43,820 --> 00:07:48,490
!مونبلان كريكت خليفة لمونبلان نولاند ذاك؟

117
00:07:48,790 --> 00:07:51,560
.سمعتُ تلك القصّة الخياليّة عندما كنتُ طفلاً

118
00:07:51,560 --> 00:07:54,930
لا يوجد شخص في الأزرق
.الشّماليّ لا يعرفها

119
00:07:55,300 --> 00:07:59,570
،جميعنا من الأزرق الشّماليّ
لذلك قيل لنا في العادة

120
00:07:59,570 --> 00:08:03,540
أنّنا إن كذبنا كثيرًا، فسيُحكم
.علينا بالموت مثل نولاند

121
00:08:05,840 --> 00:08:08,580
!يصبح هذا ممتعًا أكثر فأكثر

122
00:08:08,580 --> 00:08:12,080
ما كنتُ لأتخيّل أبدًا أنّ جايا
.هي الجزيرة المذكورة في القصّة

123
00:08:12,080 --> 00:08:14,950
،وبعد أربعمائة سنة
يبحث خلف نولاند الكذّاب

124
00:08:14,950 --> 00:08:19,260
...عن الذّهب في هذه الجزيرة إذًا

125
00:08:19,690 --> 00:08:24,160
بهدف تبرئة اسم سلفه الّذي نُعت
...بالكاذب وسُخر منه حتى مات

126
00:08:28,270 --> 00:08:31,100
!إنّ هذه العائلة تُضحكني

127
00:08:33,270 --> 00:08:35,740
هل يعتقد فعلاً أنّ بإمكانه تبرئة

128
00:08:35,740 --> 00:08:39,740
اسم سلف له منذ أربعمائة سنة
!بالعثور على بعض الذّهب؟

129
00:08:41,610 --> 00:08:44,380
!يبدو أنّه مخبول

130
00:08:53,120 --> 00:08:57,490
...وللأسف، مات الكذّاب

131
00:08:59,300 --> 00:09:03,270
.قبل حتّى أن يصبح محارب بحر شجاع

132
00:09:03,900 --> 00:09:05,840
!لا تنظري إليّ

133
00:09:05,840 --> 00:09:07,770
ولا تضيفي جملاً مفجعة
!من تلقاء نفسك

134
00:09:09,470 --> 00:09:10,770
!وقع لوفي في البحر

135
00:09:11,140 --> 00:09:12,980
!ما الّذي تفعله؟

136
00:09:13,840 --> 00:09:15,150
!من تكونون؟

137
00:09:15,580 --> 00:09:18,920
يا لجرأتكم وأنتم تسترخون
!في منزل غيركم دون إذن

138
00:09:18,920 --> 00:09:21,120
!هذا الجزء من البحر ضمن منطقتي

139
00:09:21,120 --> 00:09:23,320
!يا أوسوبّ! اذهب لإنقاذ لوفي

140
00:09:23,320 --> 00:09:23,650
!مفهوم

141
00:09:23,920 --> 00:09:26,560
!تسعون خلف الذّهب، صحيح؟ مت

142
00:09:35,170 --> 00:09:36,270
!سانجي

143
00:09:36,270 --> 00:09:37,030
!سانجي-كُن

144
00:09:37,600 --> 00:09:40,240
.لا تقلقا. لم تصبني

145
00:09:42,140 --> 00:09:43,210
!تمهّل

146
00:09:43,370 --> 00:09:45,640
.غبيّ... لا يجب عليك الاستخفاف بخصمك

147
00:09:47,240 --> 00:09:48,680
!ابتعد! سأهتمّ بأمره

148
00:09:57,490 --> 00:09:59,820
!مهلاً، ماذا كنتَ تفعل؟

149
00:09:59,820 --> 00:10:03,130
.رأيت... فقاعات تخرج من الماء

150
00:10:03,490 --> 00:10:06,560
،لذلك كنتُ أنظر للماء
.ثمّ ظهرت حبّة كستناء فجأة

151
00:10:06,560 --> 00:10:10,930
،لكنّ حبّة الكستناء كانت رجلاً
.ثمّ قام بسحبي إلى المياه

152
00:10:11,370 --> 00:10:13,170
!مهلاً، أيّها العجوز

153
00:10:15,440 --> 00:10:19,210
!أحضروا المزيد من المناشف الباردة
!افتحوا النّوافذ

154
00:10:20,540 --> 00:10:21,750
مرض تخفيف الضّغط؟

155
00:10:21,750 --> 00:10:23,710
هل هذا الرّجل مريض؟

156
00:10:23,710 --> 00:10:26,580
.نعم، مرض يصيب الغطّاسين أحيانًا

157
00:10:27,450 --> 00:10:30,890
.لكنّها لا تصبح حالة مُزمنة عادةً

158
00:10:30,890 --> 00:10:34,890
انخفاض الضّغط السّريع عند
،الصّعود لسطح البحر من أعماقه

159
00:10:34,890 --> 00:10:38,560
يُحّرر النيتروجين المتحلّل في الدّم بسرعة

160
00:10:38,560 --> 00:10:39,960
.ويشكّل فقاعات غازيّة حينها

161
00:10:40,630 --> 00:10:43,770
وبما أنّ فقاعات الغاز تتوسّع
،داخل وخارج الأوعية الدّمويّة

162
00:10:43,770 --> 00:10:47,370
تتسبّب بمشاكل في تدفّق الدّم
.والعضلات والمفاصل

163
00:10:47,370 --> 00:10:49,670
أي أنّها ظاهرة غامضة من نوع ما؟

164
00:10:50,270 --> 00:10:54,780
على الأرجح أنّه واصل الغوص كلّ يوم

165
00:10:54,780 --> 00:10:58,420
دون منح الفرصة للفقاعات
.بالاختفاء من جسده

166
00:10:58,680 --> 00:11:00,780
!ولكن لأيّ سبب؟

167
00:11:00,780 --> 00:11:03,890
.لا أدري، لكنّه يخاطر بحياته

168
00:11:04,350 --> 00:11:06,820
في بعض الحالات، يمكن لمرض
...تخفيف الضّغط

169
00:11:07,490 --> 00:11:09,090
.أن يسبّب الموت

170
00:11:21,410 --> 00:11:24,780
.هذا أنت يا ماسيرا. أنت حيّ إذًا

171
00:11:24,780 --> 00:11:26,440
حيّ؟ عمّ تتحدّث؟

172
00:11:26,440 --> 00:11:29,780
،لا تهتمّ. على كلّ حال
ما كان إطلاق النّار ذاك؟

173
00:11:29,780 --> 00:11:32,780
صحيح يا أخي! هل تعتقد
أنّ شيئًا ما حدث للعجوز؟

174
00:11:32,780 --> 00:11:34,890
!لنسرع! أنا بدأت أتحمّس

175
00:11:37,120 --> 00:11:39,720
!أيّها العجوز! هل أنت بخير؟

176
00:11:41,630 --> 00:11:43,790
!سيقتلاننا

177
00:11:43,790 --> 00:11:46,160
!ما الّذي تفعلونه هنا؟

178
00:11:46,160 --> 00:11:47,860
!ما الّذي فعلتموه للعجوز؟

179
00:11:48,230 --> 00:11:52,840
،ماذا؟ نحن نعتني بهذا الرّجل الآن
.لذلك اذهبا لمكان آخر

180
00:11:52,840 --> 00:11:55,870
!غبيّ! لن يستمعا لنا أبدًا

181
00:11:55,870 --> 00:11:57,040
!إنّهما متوحّشان تمامًا

182
00:11:57,040 --> 00:11:57,870
!تمامًا

183
00:11:57,870 --> 00:11:59,880
!لنخلِ المكان جميعًا عبر النّوافذ

184
00:12:01,040 --> 00:12:03,350
!أنتم لطفاء جدًّا

185
00:12:03,510 --> 00:12:05,020
!استمعا لنا فعلاً

186
00:12:20,000 --> 00:12:22,630
تعيشان هنا أيضًا؟

187
00:12:22,900 --> 00:12:27,970
في الواقع، منزل العجوز
.هو مقرّ تحالف ساروياما

188
00:12:27,970 --> 00:12:30,570
لكنّنا ننام في سفننا معظم الوقت

189
00:12:30,910 --> 00:12:34,040
.لأنّ هذا المنزل صغير جدًّا علينا

190
00:12:34,580 --> 00:12:36,580
.هذا لأنّكما ضخمان للغاية

191
00:12:36,580 --> 00:12:40,520
لكن مقارنة بالعمالقة، فأنتما
.تبدوان ككرة صملاخ أذن

192
00:12:41,690 --> 00:12:44,520
لماذا هم على وفاق تامّ هكذا؟

193
00:12:44,520 --> 00:12:46,490
.ربّما لأنّ لديهم الكثير من الأمور المشتركة

194
00:12:46,490 --> 00:12:52,000
لكن من المدهش أنّكم استطعتم
!ركله رغم صغر حجمكم

195
00:12:52,000 --> 00:12:54,060
.فعلاً؟ بإمكانك ذلك أيضًا

196
00:12:54,060 --> 00:12:54,900
فعلاً؟

197
00:12:54,900 --> 00:12:56,770
.نعم، بإمكانك ذلك لأنّك قرد

198
00:12:57,070 --> 00:12:58,740
!لوفي، لقد استعاد وعيه

199
00:12:59,070 --> 00:13:00,140
!استيقظ؟

200
00:13:03,740 --> 00:13:06,010
...إنّه محقّ، بإمكاني ركل ماسيرا

201
00:13:08,150 --> 00:13:10,680
!أيّها العمّ ذو الرّأس الماسيّ
!أريد سؤالك عن شيء ما

202
00:13:15,690 --> 00:13:17,490
.آسف لتسبّبي بالمشاكل لكم

203
00:13:17,490 --> 00:13:21,190
ظننتُ أنّكم مجرّد أغبياء
.يسعون خلف الذّهب

204
00:13:21,190 --> 00:13:23,190
ماذا؟! لديك سبيكة ذهب؟

205
00:13:23,190 --> 00:13:24,190
.لا تسعي خلفها

206
00:13:24,460 --> 00:13:26,900
ما الّذي أردت أن تسألني عنه؟

207
00:13:26,900 --> 00:13:30,430
!أيّها العمّ، نريد الذّهاب لجزيرة السّماء
!أخبرنا رجاءً كيف نذهب إليها

208
00:13:31,070 --> 00:13:32,740
جزيرة السّماء؟

209
00:13:36,870 --> 00:13:39,510
تصدّقون بوجود جزيرة السّماء؟

210
00:13:40,080 --> 00:13:42,250
!توقّفي! إنّه شخص مريض

211
00:13:42,580 --> 00:13:45,150
!هل جزيرة السّماء غير موجودة أيّها العمّ؟

212
00:13:48,190 --> 00:13:49,590
.لا أحد يدري

213
00:13:51,020 --> 00:13:53,860
.أعرف شخصًا قال أنّها موجودة

214
00:13:54,590 --> 00:13:58,060
!لكنّ النّاس يصفونه بالكاذب الكبير الأسطوريّ

215
00:13:58,060 --> 00:14:00,560
.أصبحت عائلته محلّ سخرية للأبد

216
00:14:01,900 --> 00:14:03,470
!ليس أنا

217
00:14:04,130 --> 00:14:07,740
ثمّة قصّة قديمة يعرفها معظم
.ساكنة الأزرق الشّماليّ

218
00:14:07,740 --> 00:14:10,440
."إنّها "نولاند الكذّاب

219
00:14:11,480 --> 00:14:14,240
!قلتُ لك أنّه ليس أنا
!اسمه مختلف تمامًا، مفهوم؟

220
00:14:14,910 --> 00:14:19,480
بالتّفكير في الأمر، اسم نولاند الكامل
.هو مونبلان نولاند إن لم أكن مخطئًا

221
00:14:19,480 --> 00:14:21,650
...هل من الممكن أنّك ونولاند

222
00:14:21,650 --> 00:14:25,560
هل أنت سليل له؟! وهل هذه
!هي الجزيرة في تلك القصّة؟

223
00:14:26,760 --> 00:14:30,260
...إنّه جدُّ جدِّ جدّي

224
00:14:30,260 --> 00:14:34,130
.إنّه سلفي من بعيد... كم هذا مزعج

225
00:14:34,130 --> 00:14:38,400
أشكّ أنّه ما زالت في عروقي
...قطرة دم من دمائه

226
00:14:39,140 --> 00:14:41,770
،رغم أنّ عائلة مونبلان طُردت من البلاد

227
00:14:41,770 --> 00:14:43,270
،ولم تجلب لها الأنظار كثيرًا

228
00:14:43,270 --> 00:14:46,180
إلاّ أنّ النّاس واصلوا استنكار
.عائلتنا ليومنا هذا

229
00:14:46,810 --> 00:14:51,110
.لكنّ لا أحد من العائلة يكرهه

230
00:14:51,110 --> 00:14:52,280
لماذا؟

231
00:14:52,480 --> 00:14:56,720
.لأنّ نولاند كان شخصًا صادقًا بشكل استثنائيّ

232
00:14:56,720 --> 00:14:58,720
...لكنّ كتاب الصّور ذاك

233
00:14:59,160 --> 00:15:02,730
كان عُذر نولاند الأخير في ذلك
...الكتاب على هذا النّحو

234
00:15:02,730 --> 00:15:07,330
هذا صحيح! غرق جبل الذّهب"
"!عميقًا في البحر

235
00:15:07,330 --> 00:15:09,730
رسم وجه تعلوه ملامح
...الغباء في الكتاب

236
00:15:10,930 --> 00:15:15,940
لكنّه ذرف دموعًا كثيرة
.ومات ميتة يملؤها النّدم

237
00:15:16,310 --> 00:15:19,580
كان واثقًا أنّ الجزيرة
،الّتي وصل إليها كانت جايا

238
00:15:19,580 --> 00:15:21,480
.حيث وجد أطلال مدينة من الذّهب

239
00:15:21,480 --> 00:15:24,410
شعر أنّه كان من المستحيل
.أنّها كانت مجرّد وهم

240
00:15:26,250 --> 00:15:30,190
أصرّ نولاند أنّ الأطلال غرقت
،بسبب تحرّكات القشرة الأرضيّة

241
00:15:30,190 --> 00:15:34,690
لكنّ الجميع ظنّوا أنّه يختلق أعذارًا
.بسبب وضعه اليائس

242
00:15:35,760 --> 00:15:39,900
،أُعدم نولاند أمام الحشود السّاخرة

243
00:15:39,900 --> 00:15:42,600
."ولم يبقَ سوى لقب "الكذّاب

244
00:15:42,600 --> 00:15:46,900
صحيح! أنت تبحث عن مدينة
الذّهب في قاع البحر

245
00:15:46,900 --> 00:15:49,040
!بهدف تبرئة اسم عائلة مونبلان

246
00:15:49,040 --> 00:15:50,910
!لا تكن سخيفًا

247
00:15:50,910 --> 00:15:52,340
!أوسوبّ

248
00:15:52,340 --> 00:15:53,880
...ظننتُني سأموت

249
00:15:54,240 --> 00:15:57,550
،كم كان سلفي صادقًا

250
00:15:57,550 --> 00:16:00,850
،أو كم كان مكتشفًا رائعًا
!لا علاقة لهما بي

251
00:16:01,220 --> 00:16:05,990
هل يمكنك إدراك كيف سيشعر
طفل يسخر منه الغرباء

252
00:16:05,990 --> 00:16:08,390
!فقط لأنّه سليل لذلك الغبيّ؟

253
00:16:08,390 --> 00:16:10,060
!هكذا كبرت أنا

254
00:16:13,260 --> 00:16:17,670
ولكن... صحيح، خلال السّنوات
،الأربعمائة الماضية

255
00:16:17,670 --> 00:16:22,440
،أبحر العديد بهدف استعادة شرف عائلتنا

256
00:16:22,440 --> 00:16:25,610
.ولقد فُقدوا جميعًا

257
00:16:26,210 --> 00:16:28,910
.شعرتُ بالخجل من هذه العائلة

258
00:16:28,910 --> 00:16:32,050
.هربتُ من المنزل وأصبحتُ قرصانًا

259
00:16:32,050 --> 00:16:34,720
فعلاً؟ أنت قرصان أيضًا؟

260
00:16:34,720 --> 00:16:37,120
.ليس وكأنّني رغبتُ في أن أصبح قرصانًا

261
00:16:37,120 --> 00:16:40,120
.أردت الهرب من لعنة نولاند فحسب

262
00:16:40,590 --> 00:16:44,830
ومع الوقت، أصبح لي
.طاقم قراصنة خاصّ بي

263
00:16:44,830 --> 00:16:47,430
،وبعد وقت طويل، دخلتُ الغراند لاين

264
00:16:47,430 --> 00:16:49,600
.وكرّستُ كلّ وقتي للمغامرات

265
00:16:50,270 --> 00:16:56,040
لكن وصلت سفينتي لهذه الجزيرة
.بالصّدفة قبل عشر سنوات

266
00:16:57,610 --> 00:16:59,840
وبشكل غريب، كنتُ أنا وحدي

267
00:16:59,840 --> 00:17:03,980
رغم كرهي لعائلة مونبلان ونولاند
.أكثر من غيري، من وصل إلى هنا

268
00:17:04,350 --> 00:17:09,320
لم تكن هنالك مدينة من الذّهب
.على الجزيرة، كما ذُكر في الكتاب

269
00:17:09,750 --> 00:17:12,120
،وبينما أنا واقف على رأس الجزيرة
.شعرتُ أنّ هذا كان قدري

270
00:17:12,620 --> 00:17:14,790
.ما عاد هنالك مكان للهرب

271
00:17:15,360 --> 00:17:18,500
!لننهِ هذا الأمر يا نولاند

272
00:17:19,130 --> 00:17:23,870
مستحيل! أيّها القائد، لن تكون
!لدينا أيّ علاقة بمشكلة عائلتك

273
00:17:23,870 --> 00:17:26,970
إن أصررت على البحث عن
!الذّهب، قم بذلك وحدك

274
00:17:27,600 --> 00:17:31,040
.سنفترق هنا. وداعًا أيّها القائد

275
00:17:35,610 --> 00:17:39,720
.لا بأس إن كانت هناك
.ولا بأس أيضًا إن لم تكن

276
00:17:40,050 --> 00:17:43,390
.فلستُ أريد إثبات براءته

277
00:17:44,490 --> 00:17:49,830
.هذا نزال مع الرّجل الّذي دمّر حياتي

278
00:17:50,730 --> 00:17:55,370
.أريد أن أسوّي الأمر معه قبل أن أموت

279
00:18:00,000 --> 00:18:01,570
...رجل ولا كلّ الرّجال

280
00:18:03,010 --> 00:18:07,280
إذًا ماذا عنهما؟
لماذا ذلكما القردان هنا؟

281
00:18:07,280 --> 00:18:10,380
لا بدّ من وجود قصّة مثيرة

282
00:18:10,380 --> 00:18:14,120
حُبكت أحداثها بقبضات رجال
.كرّسوا حياتهم لاكتشاف الأعماق

283
00:18:14,120 --> 00:18:16,490
.إنّهما مجرّد معجبين بكتاب الصّور

284
00:18:16,490 --> 00:18:17,520
!معجبان؟

285
00:18:17,520 --> 00:18:20,120
.إنّها علاقة بسيطة جدًّا

286
00:18:20,120 --> 00:18:22,060
.أعتقد أنّ ذلك كان قبل خمس أو ستّ سنوات

287
00:18:22,060 --> 00:18:24,630
.سمعا إشاعة عنّي وأتيا إليّ

288
00:18:25,060 --> 00:18:29,730
قالا "نعتقد أنّ ذهب نولاند
!"موجود فعلاً

289
00:18:31,230 --> 00:18:32,300
!شوجو

290
00:18:33,140 --> 00:18:35,510
هل أنت جاهز لمواجهتي بعد
!ركلك لي فجأة هكذا؟

291
00:18:35,510 --> 00:18:37,510
!هذا اتّهام زائف شنيع يا ماسيرا

292
00:18:37,510 --> 00:18:39,510
!لا تغضبني

293
00:18:41,040 --> 00:18:43,010
.البحر في هذه المنطقة عميق

294
00:18:43,010 --> 00:18:47,880
،وفي البحر البارد المظلم
.تطاردك وحدة أعمق بكثير

295
00:18:49,020 --> 00:18:54,020
.كنتُ أغوص وأبحث وحدي كلّ يوم

296
00:18:54,690 --> 00:18:57,690
دخلا حياتي دون سابق إنذار

297
00:18:57,690 --> 00:19:01,630
،وأصبحا تابعين لي دون إذني
.ولزما المكان هنا

298
00:19:02,270 --> 00:19:08,040
...إنّ غبيّين بسيطا الفهم مثلهما
.يشعرانني بالرّاحة بصراحة

299
00:19:08,870 --> 00:19:10,110
هل تفهمون؟

300
00:19:10,110 --> 00:19:16,750
أنا أفهمك. إنّ الزّملاء الحقيقيّين
...يمنحون بعضهم القوّة و

301
00:19:16,750 --> 00:19:19,520
حسنًا، كفانا حديثًا عن قصّة
...ذلكما القردين

302
00:19:19,520 --> 00:19:22,750
!لا تسأل عنها من الأساس وأغلق فمك

303
00:19:23,520 --> 00:19:27,260
كما قلت... أريد الذّهاب
!إلى جزيرة السّماء أيّها العمّ

304
00:19:29,690 --> 00:19:31,460
!أنت قليل الصّبر بالفعل

305
00:19:31,460 --> 00:19:33,830
أخبرتك من قبل، ألم تسمعني؟

306
00:19:33,830 --> 00:19:36,900
الدّليل الوحيد عن جزيرة
.السّماء يعود لنولاند الكذّاب

307
00:19:36,900 --> 00:19:40,400
،إن أصبحت لك أيّ علاقة به
.فسيضحك عليك الجميع مثلي

308
00:19:40,400 --> 00:19:43,040
!ماذا؟! هل زار جزيرة السّماء أيضًا؟

309
00:19:43,470 --> 00:19:46,180
...للأسف، لم يُذكر هنا أنّه فعل، ولكن

310
00:19:46,380 --> 00:19:49,580
!سجلّ سفينة؟! أهو لنولاند؟

311
00:19:49,580 --> 00:19:50,650
.صحيح

312
00:19:51,180 --> 00:19:51,650
...مهلاً

313
00:19:51,650 --> 00:19:52,920
.اقرئي من هناك

314
00:19:53,820 --> 00:19:56,990
...مذهل... سجلّ من أربعمائة سنة مضت

315
00:19:57,650 --> 00:20:02,330
اليوم 21 يونيو من العام 1120 من
.التّقويم الفلكيّ البحريّ، الجوّ مشمس

316
00:20:02,330 --> 00:20:04,530
.غادرنا بلدة فيرا المبهجة

317
00:20:04,530 --> 00:20:10,070
وإن تبعنا البوصلة المسجِّلة، فيجب علينا
.التّوجّه شرق الشّمال الشّرقيّ من الميناء

318
00:20:10,470 --> 00:20:14,640
حصلنا على غرض نادي من قارب
.مؤن عثرنا عليه خلال النّهار

319
00:20:14,640 --> 00:20:17,940
.إنّه قارب متزلّج لشخص واحد يُدعى ويفر

320
00:20:19,240 --> 00:20:23,410
قارب غامض يولّد رياحًا ويتحرّك
.حتّى في الأيّام الّتي لا رياح فيها

321
00:20:23,410 --> 00:20:26,350
يبدو أنّه يجب أن تعتاد عليه
.حتّى تركبه، ولم أستطع ذلك

322
00:20:26,350 --> 00:20:30,090
.والآن، أصبح اللّعبة المثاليّة لطاقمي

323
00:20:30,090 --> 00:20:31,990
!مستحيل! ما هذا؟ أريد واحدًا

324
00:20:31,990 --> 00:20:33,290
!لا تهتمّي لذلك، واصلي القراءة

325
00:20:33,920 --> 00:20:37,330
إنّ مصدر قوّته هو منتج يوجد
،في جزيرة السّماء

326
00:20:37,330 --> 00:20:40,760
وسمعتُ أنّ عدّة أشياء فريدة
.أخرى توجد في السّماء

327
00:20:41,100 --> 00:20:46,240
وبالحديث عن جزيرة السّماء، أراني أحد
.أصدقائي المستكشفين سمكة سماء حيّة

328
00:20:46,540 --> 00:20:49,040
.تفاجأت لغرابة شكل السّمكة

329
00:20:49,040 --> 00:20:50,140
سمكة سماء؟

330
00:20:50,410 --> 00:20:53,380
،ما زالت منطقة مجهولة لسفينتنا

331
00:20:53,380 --> 00:20:57,280
لكن بصفتي بحّارًا، كم أودّ الذّهاب
.لبحر السّماء يومًا ما

332
00:20:57,280 --> 00:20:58,780
...مونبلان نولاند

333
00:20:59,620 --> 00:21:01,220
!"قال "البحر في السّماء

334
00:21:01,220 --> 00:21:03,190
!كما قالت روبين تمامًا

335
00:21:03,190 --> 00:21:07,220
ويبدو أنّ جزيرة السّماء كانت
.أمرًا عاديًّا للغاية للنّاس في الماضي

336
00:21:07,220 --> 00:21:08,830
!إذًا فهي موجودة بالفعل

337
00:21:08,830 --> 00:21:10,830
!أجل

338
00:21:12,230 --> 00:21:14,830
!أيّها العجوز! كيف تشعر؟

339
00:21:14,830 --> 00:21:15,830
!بأفضل حال

340
00:21:16,200 --> 00:21:17,630
!سررت بسماع هذا

341
00:21:18,240 --> 00:21:20,040
...أيّها العجوز، هذا الوغد

342
00:21:20,040 --> 00:21:22,810
اخرسا واستمعا لي، أيروق لكما هؤلاء؟

343
00:21:23,210 --> 00:21:25,110
لماذا تسأل؟

344
00:21:25,340 --> 00:21:29,080
يبدو أنّهم يريدون الذّهاب
.إلى جزيرة السّماء بأيّ ثمن

345
00:21:29,310 --> 00:21:33,780
،جزيرة السّماء... إن كانوا يريدون الذّهاب
.فثمّة طريقة واحدة لذلك

346
00:21:34,220 --> 00:21:37,150
،إن حاولوا من تلقاء أنفسهم
.فسيقتلون في الحال أيّها العجوز

347
00:21:37,550 --> 00:21:43,290
بالضّبط... لذلك لماذا لا نقدّم يد العون لهم؟

348
00:22:09,720 --> 00:22:17,790
آه، خلف السّماء الّتي لا نهاية لها

349
00:22:17,790 --> 00:22:28,400
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

350
00:22:36,280 --> 00:22:43,720
مرّت عليّ أيّام كدت أخسر فيها نفسي

351
00:22:43,720 --> 00:22:52,130
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

352
00:22:52,130 --> 00:23:00,340
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

353
00:23:00,340 --> 00:23:09,180
دفعوا بي للأمام، أليس كذلك؟

354
00:23:09,180 --> 00:23:17,490
آه، إنّ النّجوم تهوي من السّماء

355
00:23:17,490 --> 00:23:20,620
...وهذه اللّحظة الفريدة

356
00:23:25,600 --> 00:23:28,670
!بإمكاننا أخيرًا الذّهاب السّماء! إلى السّماء

357
00:23:28,670 --> 00:23:30,730
أتساءل أيّ نوع من الأماكن
!تكون جزيرة السّماء

358
00:23:30,730 --> 00:23:32,370
!أنا متحمّس جدًّا

359
00:23:32,370 --> 00:23:35,510
!إنّها مغامرة مناسبة للقائد أوسوبّ

360
00:23:35,510 --> 00:23:37,510
.لكنّها ستكون رحلة نخاطر فيها بحياتنا

361
00:23:37,510 --> 00:23:40,440
...نعم، نخاطر فيها بحياتنا
.ماذا؟ مهلاً يا لوفي، انس الأمر

362
00:23:40,440 --> 00:23:41,840
!...أنت

363
00:23:42,250 --> 00:23:43,450
:في الحلقة القادمة من ون بيس

364
00:23:43,450 --> 00:23:46,650
!أديروا الدّفّة نحو السّحاب"
"!الإمساك بطائر الجنوب

365
00:23:46,650 --> 00:23:48,920
!ملك القراصنة، لن يكون إلاّ أنا