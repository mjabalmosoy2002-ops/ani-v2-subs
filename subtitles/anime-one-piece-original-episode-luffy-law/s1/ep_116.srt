5
00:00:35,900 --> 00:00:37,370
!فتجاوزوها

6
00:00:37,670 --> 00:00:40,640
!تحت راية ما تؤمنون به

7
00:00:45,110 --> 00:00:50,720
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,720 --> 00:00:53,950
متّجهًا نحو عالم بلا نهاية

9
00:00:55,360 --> 00:01:00,230
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,230 --> 00:01:08,640
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,640 --> 00:01:14,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,370 --> 00:01:18,810
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,810 --> 00:01:24,450
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,450 --> 00:01:28,320
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,320 --> 00:01:33,260
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,260 --> 00:01:41,000
متّجهين نحو الأفق

17
00:01:41,000 --> 00:01:46,510
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,510 --> 00:01:51,210
متّجهًا نحو عالم بلا نهاية

19
00:01:51,210 --> 00:01:56,450
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,450 --> 00:02:02,720
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:09,730 --> 00:02:11,370
مشاعر أولئك الّذين يعانون من كرب

22
00:02:11,370 --> 00:02:13,770
.لاقت سحقًا من سحابة الرّمال الجافّة

23
00:02:14,400 --> 00:02:18,210
،هنالك من في الأمل ساعٍ
.وهنالك من فيه متشبّث

24
00:02:18,210 --> 00:02:20,410
تشابكت مشاعرهم وهم في ريبةٍ من أمرهم

25
00:02:20,410 --> 00:02:24,240
.واسمةً حقبةً من التّاريخ يختمها الحزن

26
00:02:29,320 --> 00:02:31,220
،في ظلّ هذه المجريات
،في البوّابة الجنوب شرقيّة

27
00:02:31,220 --> 00:02:35,090
كان أوسوبّ وتشوبّر يواجهان المرأة
،الخلد، الآنسة ميري كريسماس

28
00:02:35,590 --> 00:02:38,430
،والضّارب الرّابع، السّيّد 4
.في قتال حياة أو موت

29
00:02:38,990 --> 00:02:43,430
بفضل فطنتهما، تمكّن أوسوبّ
.وتشوبّر من هزيمة خصميهما أخيرًا

30
00:02:44,830 --> 00:02:48,800
في نفس الأثناء، التحم سانجي مع
.السّيّد 2 بون كوري، في قتالٍ مباشر

31
00:02:48,800 --> 00:02:52,040
واجه سانجي خطرًا وشيكًا
من قبل مونتاج النّسخ

32
00:02:52,040 --> 00:02:53,940
.الّذي قام به السّيّد 2، بون كوري

33
00:02:57,740 --> 00:02:59,850
!يـ-يا لظرافتك

34
00:03:08,790 --> 00:03:13,230
التّحوّل إلى نامي! كينبو باليه"
".بون كوري السّريع المتتابع

35
00:03:15,830 --> 00:03:18,630
ينطبق عليك مثل
"!كثير الكلام قليل الفعل"

36
00:03:18,630 --> 00:03:21,700
لا تملك من القوّة ما يكفيك
لتنهض، أليس كذلك؟

37
00:03:23,700 --> 00:03:26,970
إيّاك أن تظنّ أنّني سأرضى
!بالاستلقاء هكذا وأدعك تضربني

38
00:03:26,970 --> 00:03:29,540
،مهما كنت تبدو كنامي-سان

39
00:03:29,540 --> 00:03:31,580
.ما زلت ذلك التّافه في الدّاخل

40
00:03:32,180 --> 00:03:35,350
...أيّها الوغد اللّعين! لا تتبجّح كثيرًا

41
00:03:41,690 --> 00:03:44,220
!سحقًا! إنّها ظريفة حقًّا

42
00:03:44,860 --> 00:03:48,230
يا إلهي، جوّ هذه البلاد
.حارّ جدًّا بالنّسبة لي

43
00:03:48,800 --> 00:03:51,200
.يجعلني أرغب بخلع كلّ ثيابي

44
00:03:51,730 --> 00:03:54,300
!سأساعدك

45
00:03:54,300 --> 00:03:55,070
!صفعة الباليه

46
00:03:56,670 --> 00:03:57,800
!عيناي

47
00:03:57,800 --> 00:04:00,040
!أيّها الغبيّ

48
00:04:01,070 --> 00:04:02,740
!نقطة الرّكل

49
00:04:10,850 --> 00:04:12,820
!لا تجيد سوى الكلام، أليس كذلك؟

50
00:04:15,160 --> 00:04:16,690
!...أيّها الوغد

51
00:04:18,730 --> 00:04:20,190
!هل تعبث معي؟

52
00:04:20,660 --> 00:04:22,960
!خذوف الرّموش المرتدّ

53
00:04:26,230 --> 00:04:27,130
!إلى الجحيم

54
00:04:28,540 --> 00:04:29,440
.لا تركلني

55
00:04:38,450 --> 00:04:40,980
عليّ إرجاع رموشي، أليس كذلك؟

56
00:04:41,550 --> 00:04:47,190
،اللّعب معك ممتع
.لكن لا أملك الوقت للّهو كثيرًا

57
00:04:47,190 --> 00:04:50,490
.إنّ من واجبي قتل الأميرة في النّهاية

58
00:04:52,690 --> 00:04:55,930
.سأعجّل في القضاء عليك

59
00:04:56,830 --> 00:05:00,730
!دوران، دوران، إنّي أدور دورانًا

60
00:05:03,900 --> 00:05:07,170
!ماذا؟! نفجّر القصر الملكيّ؟

61
00:05:07,170 --> 00:05:11,180
نعم. جاءتنا أوامر بتفجير
.القصر الملكيّ

62
00:05:11,180 --> 00:05:13,750
!سوف نفجّر القصر الملكيّ

63
00:05:14,650 --> 00:05:16,180
.هذا غير معقول

64
00:05:16,180 --> 00:05:18,690
.يضمّ القصر تاريخَ 4،000 سنة

65
00:05:24,560 --> 00:05:25,760
...لساني عاجزٌ

66
00:05:26,830 --> 00:05:28,830
.عن التّعبير عن وضعنا الرّاهن

67
00:05:29,230 --> 00:05:30,800
.لا بأس، أفهمك

68
00:05:31,600 --> 00:05:35,540
لم يكن في مقدورك فعل شيء
.عدا صدّ جيش المتمرّدين

69
00:05:36,170 --> 00:05:37,640
،بغضّ النّظر عن إيغارام

70
00:05:37,640 --> 00:05:40,710
أحسنتم صنعًا في قمع
.التّمرّد لأكثر من عامين

71
00:05:41,510 --> 00:05:43,910
.لكنّي لم أكن مخطئة

72
00:05:43,910 --> 00:05:48,820
قابلتُ أصدقاء حقيقيّين
.سينقذون أراباستا

73
00:05:52,720 --> 00:05:56,460
!اسبقوني يا رفاق! يمكنني التّكفّل بهذا

74
00:05:56,990 --> 00:06:01,060
احرصوا على إرجاع فيفي
!إلى ديارها! احرصوا على ذلك

75
00:06:01,400 --> 00:06:02,460
.اسمعي يا فيفي

76
00:06:02,460 --> 00:06:05,670
.سيُبقي كروكودايل قيد السّيطرة

77
00:06:06,100 --> 00:06:08,670
،فور بدء جيش المتمرّدين بالرّكض

78
00:06:08,670 --> 00:06:10,840
.حُدّدت المهلة الزّمنيّة لهذه البلاد

79
00:06:12,340 --> 00:06:15,080
فور اصطدام الجيش الملكيّ
،مع جيش المتمرّدين

80
00:06:15,080 --> 00:06:16,810
.ستفنى هذه البلاد

81
00:06:17,440 --> 00:06:20,550
