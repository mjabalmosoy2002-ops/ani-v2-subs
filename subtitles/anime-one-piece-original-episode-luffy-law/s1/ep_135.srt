1
00:00:22,120 --> 00:00:25,190
!العالم... نعم

2
00:00:25,720 --> 00:00:27,390
...اسعوا نحو الحرّيّة

3
00:00:27,390 --> 00:00:31,530
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,890 --> 00:00:35,260
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,760 --> 00:00:37,130
!فتجاوزوها

6
00:00:37,530 --> 00:00:40,500
!تحت راية ما تؤمنون به

7
00:00:44,970 --> 00:00:50,580
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,580 --> 00:00:53,810
متّجهًا نحو عالم بلا نهاية

9
00:00:55,220 --> 00:01:00,090
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,090 --> 00:01:08,500
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,500 --> 00:01:14,240
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,240 --> 00:01:18,670
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,670 --> 00:01:24,310
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,310 --> 00:01:28,180
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,180 --> 00:01:33,120
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,120 --> 00:01:40,860
متّجهين نحو الأفق

17
00:01:40,860 --> 00:01:46,370
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,370 --> 00:01:51,070
متّجهًا نحو عالم بلا نهاية

19
00:01:51,070 --> 00:01:56,310
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,310 --> 00:02:02,580
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:09,590 --> 00:02:13,660
!صائد القراصنة الخرافيّ"
".زورو السّيّاف المتجوّل

22
00:02:37,110 --> 00:02:40,680
سنشرب كلّ قطرة من هذا
!المشروب في هذا المكان

23
00:02:42,850 --> 00:02:43,990
،على مهلك يا بيلي

24
00:02:43,990 --> 00:02:46,090
كم مكانًا ستفسد قبل أن تشبع؟

25
00:02:46,090 --> 00:02:47,660
وما أدراني؟

26
00:02:49,330 --> 00:02:50,730
...ذلك الرّجل هناك

27
00:02:51,360 --> 00:02:53,430
.على رأسه مكافأة تقدّر بخمسة ملايين بيري

28
00:02:54,430 --> 00:02:56,930
...خمسة ملايين؟ ما قولك

29
00:02:57,900 --> 00:02:59,300
أن نتراجع هذه المرّة يا يوساكو؟

30
00:02:59,670 --> 00:03:00,770
،مهلاً يا جوني

31
00:03:00,770 --> 00:03:03,470
إن كنّا سنسعى خلف الضّعفاء
.فحسب، فلن نصل إلى أيّ مكان

32
00:03:03,470 --> 00:03:07,040
هذا هو الوقت الّذي على صائد المكافآت
.أن يسعى خلف الرّتب الأعلى

33
00:03:07,040 --> 00:03:08,480
،أدرك ما تقوله

34
00:03:08,480 --> 00:03:12,280
لكن إذا كانت المكافأة خمسة
.ملايين، حتّى نحن قد نخسر بالكاد

35
00:03:31,530 --> 00:03:32,870
.أعطني شيئًا لآكله

36
00:03:33,900 --> 00:03:35,040
ألديك مال؟

37
00:03:35,040 --> 00:03:37,570
...ليس الآن. ولكن

38
00:03:38,170 --> 00:03:42,010
،سأجني بعض المال قريبًا جدًّا
.بمجرّد حصولي على مكافأة

39
00:03:45,910 --> 00:03:48,080
لا أستطيع السّماح
!لذلك أن يمرّ مرور الكرام

40
00:03:48,680 --> 00:03:51,750
!سأقطّعك قبل أن تنال منّي

41
00:04:01,460 --> 00:04:04,000
.لا تدعني أتعب نفسي كثيرًا

42
00:04:04,000 --> 00:04:05,330
.أنا جائع

43
00:04:06,700 --> 00:04:10,470
،أجبني عن سؤال واحد
هل هنالك مكافأة على رأسك؟

44
00:04:11,140 --> 00:04:12,540
.ستتفاجأ بسماع قيمتها

45
00:04:12,540 --> 00:04:14,610
!على رأسي مكافأة تقدّر بخمسة ملايين بيري

46
00:04:14,610 --> 00:04:16,540
.هكذا إذًا. هذا كثير

47
00:04:16,540 --> 00:04:17,240
ماذا؟

48
00:04:27,950 --> 00:04:30,520
.كسبت بعض المال
.أعطني شيئًا آكله الآن

49
00:04:30,720 --> 00:04:32,190
!حاضر، سأعود في الحال

50
00:04:34,560 --> 00:04:37,030
.لديه مهارة ممتازة

51
00:04:37,560 --> 00:04:39,660
.إنّه ليس على قائمة المطلوبين

52
00:04:40,030 --> 00:04:42,970
،إن كان صائد مكافآت
.فعلى أحد أن يعلم من يكون

53
00:04:42,970 --> 00:04:46,200
هل يعقل أن يكون صائد القراصنة
الّذي سمعنا عنه مؤخّرًا؟

54
00:04:46,200 --> 00:04:48,540
.سمعتُ أنّه رجل قاسٍ للغاية

55
00:04:48,540 --> 00:04:52,780
لا، يُشاع أنّ صائد القراصنة
.يستعمل ثلاثة سيوف

56
00:04:52,780 --> 00:04:55,950
يقولون أنّ إحداها سيف
.شهير لديه غمد أبيض

57
00:04:56,510 --> 00:04:59,350
والأكثر من ذلك، يقولون
،أنّه أشبه بوحش شيطاني

58
00:04:59,350 --> 00:05:01,390
.أخذ شكل إنسان

59
00:05:01,720 --> 00:05:03,650
.إنّه لا يبدو كذلك بكلّ تأكيد

60
00:05:03,990 --> 00:05:05,320
...في تلك الحالة

61
00:05:05,990 --> 00:05:09,690
لا يمكننا الوقوف بلا حراك
!بينما أُخذت طريدتنا منّا

62
00:05:09,990 --> 00:05:10,790
...مهلاً يا جوني

63
00:05:14,160 --> 00:05:17,700
،أنت أيّها الشّابّ
،إن كنتَ صائد مكافآت أيضًا

64
00:05:17,700 --> 00:05:20,370
.فعليك إذًا أن تتقيّد بالقواعد

65
00:05:20,640 --> 00:05:21,470
ماذا؟

66
00:05:21,810 --> 00:05:24,240
،لم نكن نريد افتعال مشاكل للحانة

67
00:05:24,240 --> 00:05:26,240
.لذلك كنّا ننتظره حتّى يخرج

68
00:05:27,340 --> 00:05:30,710
.سبق ووضعنا أنظارنا عليه أوّلاً
.كان طريدتنا نحن

69
00:05:35,420 --> 00:05:36,320
!أنت، مهلاً

70
00:05:36,790 --> 00:05:38,450
!هل تستمع لي؟

71
00:05:38,450 --> 00:05:40,460
!ثمّة قواعد بين صائدي المكافآت

72
00:05:45,030 --> 00:05:45,930
.عين الصّقر

73
00:05:47,230 --> 00:05:49,730
هل تعرفان عين الصّقر ميهوك؟

74
00:05:49,730 --> 00:05:52,400
ميهوك؟ تقصد أحد الشّيتشيبوكاي؟

75
00:05:52,940 --> 00:05:55,200
،أنا في رحلة هدفي منها هو هزيمته

76
00:05:55,200 --> 00:05:57,670
.وأصبح أعظم سيّافي العالم

77
00:05:58,240 --> 00:06:01,180
،أقوم فعلاً بجمع المكافآت بغرض الأكل

78
00:06:01,640 --> 00:06:03,880
.لكنّ ذلك لا يعني أنّني صائد قراصنة

79
00:06:03,880 --> 00:06:05,910
أعظم سيّافي العالم؟

80
00:06:05,910 --> 00:06:07,250
هل سمعت ذلك يا شريكي؟

81
00:06:07,250 --> 00:06:10,750
!مستحيل! ذلك مستحيل
!لا بدّ أنّك تحلم

82
00:06:11,020 --> 00:06:13,160
.ذلك ما قرّرت فعله مذ كنتُ طفلاً

83
00:06:13,560 --> 00:06:15,520
.لا يهمّ ما قد يقوله أيّ أحد

84
00:06:15,520 --> 00:06:19,030
،حتّى إن كان ذلك حلم طفولتك
...من المستحيل أن

85
00:06:20,730 --> 00:06:23,930
لم أكن أعلم أنّكما كنتما
.تستهدفانه. أنا آسف

86
00:06:24,430 --> 00:06:26,330
.بإمكانكما تسليمه للبحريّة

87
00:06:26,900 --> 00:06:28,600
.مكافأته لكما

88
00:06:28,600 --> 00:06:29,540
هـ-هل أنت جادّ؟

89
00:06:29,940 --> 00:06:30,970
...ولكن

90
00:06:31,610 --> 00:06:33,210
.وجبتي هنا على حسابكما

91
00:06:41,820 --> 00:06:44,790
!نجحنا يا جوني
!حصلنا على خمسة ملايين بيري

92
00:06:44,790 --> 00:06:48,190
،سيكون معنا مال للأكل لوقت طويل
.دون أن نسعى خلف أيّ مكافآت

93
00:06:48,490 --> 00:06:49,690
مهلاً، ما الخطب؟

94
00:06:50,020 --> 00:06:51,290
ألست سعيدًا؟

95
00:06:51,860 --> 00:06:52,760
...لماذا

96
00:06:54,260 --> 00:06:56,160
أصبحت صائد مكافآت؟

97
00:06:56,330 --> 00:06:58,070
ماذا؟ لماذا أصبحت كذلك؟

98
00:06:58,300 --> 00:07:00,970
أليس الأمر واضحًا؟
.لأتمكّن من جني قوت يومي

99
00:07:01,570 --> 00:07:04,770
.كانت القرية الّتي وُلدتُ فيها فقيرة جدًّا

100
00:07:05,270 --> 00:07:09,240
ورغم ذلك، كان قطّاع الطّرق
.يغيرون على أمثالها كثيرًا

101
00:07:09,710 --> 00:07:11,040
،وعندما كانوا يأتون

102
00:07:11,040 --> 00:07:15,720
كان صائدو المكافآت الّذين
.يسعون خلفهم يأتون أيضًا

103
00:07:23,420 --> 00:07:27,990
وعميقًا في داخلي، أردتُ أن أكون
مثل أولئك الرّجال المندفعين

104
00:07:28,290 --> 00:07:30,430
.الّذين تحدّوا قطّاع الطّرق

105
00:07:32,000 --> 00:07:34,270
،قلتُ لنفسي أنّه يومًا ما

106
00:07:34,270 --> 00:07:37,670
آمل فعلاً أن أتمكّن من الإطاحة
.برجال أشرار مثلهم أيضًا

107
00:07:38,140 --> 00:07:40,170
لم أعلم إلاّ بعد وقت لاحق

108
00:07:40,170 --> 00:07:42,640
.أنّهم كانوا يجمعون المكافآت كعمل لهم

109
00:07:42,810 --> 00:07:45,310
،بذكرك للأمر الآن
.أردت أن أصبح مثلهم أيضًا

110
00:07:45,680 --> 00:07:48,250
عندما سمعتُ ما قاله ذلك
،"الرّجل عن "الأعظم في العالم

111
00:07:48,510 --> 00:07:50,850
.ذكّرني بنفسي في الماضي

112
00:07:51,820 --> 00:07:53,790
مهلاً، لماذا تتصرّف بعاطفيّة هكذا؟

113
00:07:53,790 --> 00:07:55,190
.ليس هذا من شيمك

114
00:07:55,190 --> 00:07:56,320
.اخرس

115
00:07:59,890 --> 00:08:00,660
!ما الأمر؟

116
00:08:01,990 --> 00:08:03,760
ما الخطب؟ هل حدث أمر ما؟

117
00:08:04,030 --> 00:08:07,370
قطّاع طرق! تهاجم عصابة ديك
!مزرعة خارج البلدة

118
00:08:07,370 --> 00:08:08,570
قاطع الطّريق ديك؟

119
00:08:11,240 --> 00:08:13,300
!ها هو! مذهل

120
00:08:13,300 --> 00:08:15,570
مكافأة هذا المجرم الخطير
!هي 10 ملايين بيري

121
00:08:20,580 --> 00:08:22,780
!انهبوا كما تشاؤون يا رجال

122
00:08:29,790 --> 00:08:31,720
.كانوا يخفون الكثير

123
00:08:31,720 --> 00:08:33,590
!كان صيدنا وفيرًا اليوم

124
00:08:38,430 --> 00:08:39,430
أهؤلاء هم؟

125
00:08:39,900 --> 00:08:42,800
مهلاً، ما الّذي سنفعله؟
!إنّهم يأخذون كلّ شيء وبسرعة

126
00:08:42,800 --> 00:08:46,240
!إنّه قاطع الطّريق ديك
.نحن لسنا أندادًا له

127
00:08:46,240 --> 00:08:48,370
الأمر لا يستحقّ إن كانت أرواحنا
.هي ما سنخسرها أيضًا

128
00:08:48,370 --> 00:08:49,640
!سُحقًا

129
00:08:52,310 --> 00:08:55,980
!حسنًا، لننتقل للتّالي! خذوا كلّ ما لديهم

130
00:09:01,580 --> 00:09:03,790
ما بال سكّان هذه البلدة؟

131
00:09:03,790 --> 00:09:05,550
.يا لهم من جبناء

132
00:09:05,550 --> 00:09:08,120
ألا يملكون حتّى الشّجاعة لقتالي؟

133
00:09:08,120 --> 00:09:10,260
،حسنًا، ربّما ذلك قرار حكيم
.من ناحية منطقيّة

134
00:09:10,430 --> 00:09:12,700
،هنالك من ينهبون
،وهنالك من يُنهب منهم

135
00:09:12,700 --> 00:09:15,400
ويمكن للمرء أن يكون أحدهما
.أو الآخر في هذه الأيّام

136
00:09:15,400 --> 00:09:18,170
.الضّعف جريمة بحدّ ذاته

137
00:09:18,170 --> 00:09:20,670
المجابهة شيء لا يُقدم عليه
!سوى الحمقى

138
00:09:26,840 --> 00:09:28,940
...ثمّة أحمق بالفعل

139
00:09:29,110 --> 00:09:31,380
!أ-أعد لنا طعامنا

140
00:09:31,380 --> 00:09:34,450
إنّه شيء عملنا جميعًا
!جاهدين على تخزينه

141
00:09:35,080 --> 00:09:36,420
!هاري

142
00:09:39,790 --> 00:09:42,120
.على الأقلّ لديك شجاعة الكبار

143
00:09:43,590 --> 00:09:45,530
!...سُحقًا

144
00:09:45,860 --> 00:09:48,300
!توقّف يا هاري! أنت لست ندًّا له

145
00:09:48,300 --> 00:09:49,430
!هاري

146
00:09:51,430 --> 00:09:52,470
!هيّا بنا

147
00:09:52,770 --> 00:09:56,100
.على رسلك يا شريكي
.حتّى نحن سنخسر أمامه بالكاد

148
00:10:00,510 --> 00:10:03,110
...ذلك ليس السّبب، إنّه

149
00:10:07,820 --> 00:10:09,320
...يُمثّل ما كنتُه ذاك اليوم

150
00:10:13,620 --> 00:10:16,120
لا يعرف كيف يتراجع
.أو الاعتناء بنفسه بعد

151
00:10:20,060 --> 00:10:21,960
.إنّه أنا، عندما كنتُ لا أزال بريئًا

152
00:10:25,570 --> 00:10:27,130
!مهلاً يا جوني

153
00:10:29,140 --> 00:10:31,370
!ما الّذي تعتقد نفسك فاعلاً؟

154
00:10:31,600 --> 00:10:32,440
!من أنت؟

155
00:10:34,940 --> 00:10:37,280
.مجرّد صائد مكافآت مجهول

156
00:10:37,280 --> 00:10:38,880
ماذا قلت؟

157
00:11:10,480 --> 00:11:12,940
أنتما صائدا مكافآت؟

158
00:11:12,940 --> 00:11:14,680
هل تسعيان خلف رأسي؟

159
00:11:14,980 --> 00:11:17,980
.يا للإزعاج. أنتما مجرّد ضبعين انتهازيّين

160
00:11:18,320 --> 00:11:19,380
!بماذا ناديتنا؟

161
00:11:19,380 --> 00:11:22,220
،إن كان المال ما تريدانه
،فسأحسن إليكما ببعضه

162
00:11:22,220 --> 00:11:24,060
.إن كنتما لا تمانعان بعض الفكّة

163
00:11:24,060 --> 00:11:25,960
!لا نريده

164
00:11:25,960 --> 00:11:26,590
ماذا؟

165
00:11:26,960 --> 00:11:31,630
يراودنا شعور بإحلال العدالة
.فحسب هذا اليوم

166
00:11:31,630 --> 00:11:33,060
...ماذا؟ مهلاً يا جوني

167
00:11:33,260 --> 00:11:35,530
شعور بإحلال العدالة؟

168
00:11:40,170 --> 00:11:40,870
...مهلاً

169
00:11:40,870 --> 00:11:41,540
...يا شريكي

170
00:11:42,140 --> 00:11:44,140
هلاّ سمحت لي بأن أكون رجلاً؟

171
00:11:44,140 --> 00:11:44,780
...جوني

172
00:11:48,050 --> 00:11:49,680
جوني، أتقصد...؟

173
00:11:51,580 --> 00:11:52,450
.حسنًا

174
00:11:54,320 --> 00:11:57,390
لا وجود لشيء كالعدالة
!أو الشّرّ في هذه الأيّام

175
00:11:57,390 --> 00:12:00,660
!القوّة هي السّائدة
هذا كلّ ما هنالك، صحيح؟

176
00:12:03,130 --> 00:12:04,890
!نحن جادّان

177
00:12:04,890 --> 00:12:07,000
،نعم! فهذا الصّباح فقط

178
00:12:07,000 --> 00:12:10,870
سلّمنا مجرمًا مكافأته
!خمسة ملايين بيري للبحريّة

179
00:12:11,970 --> 00:12:13,440
سلّمتماه هذا الصّباح للبحريّة؟

180
00:12:17,310 --> 00:12:18,810
...بيلي

181
00:12:18,810 --> 00:12:22,040
!أنتما من سحق أخي الصّغير؟

182
00:12:22,040 --> 00:12:23,180
!ماذا؟

183
00:12:49,470 --> 00:12:51,710
.أنا هنا لاستلام السّيف إن انتهيت منه

184
00:12:52,240 --> 00:12:53,070
.نعم

185
00:13:03,920 --> 00:13:05,390
.موهبتك استثنائيّة

186
00:13:05,890 --> 00:13:07,220
.عملتُ عليه جاهدًا

187
00:13:07,220 --> 00:13:09,960
.أنت متهوّر جدًّا في معاملتك لذلك السّيف

188
00:13:09,960 --> 00:13:11,730
،إن كان سيفًا عاديًّا

189
00:13:11,730 --> 00:13:15,700
لكان لقي نفس مصير
.سيفيك المكسورين هناك

190
00:13:16,160 --> 00:13:18,530
.مفهوم. سأكون حذرًا

191
00:13:34,210 --> 00:13:37,420
!سأصبح أقوى من أجلها أيضًا

192
00:13:37,850 --> 00:13:41,420
سأصبح أقوى بما يكفي
!ليبلغ اسمي عنان السّماء

193
00:13:42,290 --> 00:13:45,260
!سأصبح السّيّاف الأقوى في العالم

194
00:13:52,400 --> 00:13:53,770
.شكرًا على المساعدة

195
00:13:53,770 --> 00:13:57,240
،أودّ أن أدفع لك المزيد
!لكن لسوء الحظّ، أنا مفلس الآن

196
00:13:57,470 --> 00:13:58,840
.لا تقلق حيال ذلك

197
00:13:58,840 --> 00:14:01,310
.لا يتسنّى لي رؤية غرض مثله دائمًا

198
00:14:01,310 --> 00:14:03,180
.كان تُحفة لناظريّ بالفعل

199
00:14:03,180 --> 00:14:06,480
.ليس كهذا السّيف الطّويل معدوم النّفع

200
00:14:08,450 --> 00:14:10,880
!مهلاً، ألم أحذّرك؟

201
00:14:10,880 --> 00:14:12,020
!ترأّف بي

202
00:14:12,020 --> 00:14:14,950
،لا يهمّ كم ستحمل من السّيوف
!لن تكون كافية أبدًا هكذا

203
00:14:14,950 --> 00:14:17,190
.سُحقًا، ها قد فعلتُها ثانية

204
00:14:17,190 --> 00:14:19,590
.آسف، سأحرص على تعويضك

205
00:14:23,330 --> 00:14:25,830
.إنّه ذلك الوغد ديك، حوت الجبل

206
00:14:25,830 --> 00:14:28,530
إنّه قاطع طريق مكافأته عشرة
!ملايين بيري ويستعمل مدفعًا

207
00:14:29,030 --> 00:14:31,440
قاطع طريق بمكافأة على رأسه؟

208
00:14:47,950 --> 00:14:48,950
!سُحقًا

209
00:14:52,160 --> 00:14:55,460
.لا فائدة. إنّه أكثر ممّا يستطيعان تحمّله

210
00:15:03,800 --> 00:15:05,800
ما هذا؟

211
00:15:06,100 --> 00:15:08,810
هل أنتما فعلاً من أطاحا بأخي الصّغير؟

212
00:15:09,670 --> 00:15:11,980
،نحن من سلّم بيلي

213
00:15:11,980 --> 00:15:14,240
!لكنّ شخصًا آخر هزمه أيّها الوغد

214
00:15:14,240 --> 00:15:16,210
لماذا تتفاخران بذلك إذًا؟

215
00:15:16,210 --> 00:15:18,450
.ظننتُ فعلاً أنّكما أضعف من ذلك

216
00:15:18,680 --> 00:15:19,920
!اخرس

217
00:15:36,770 --> 00:15:39,900
.يا إلهي، يا لمثابرتكما

218
00:15:43,610 --> 00:15:44,610
!توقّف

219
00:15:45,740 --> 00:15:46,440
!مهلاً

220
00:15:46,780 --> 00:15:48,040
!...أيّها الـ

221
00:15:48,380 --> 00:15:50,150
!أتريد الموت لهذه الدّرجة؟

222
00:15:57,450 --> 00:15:58,590
!يا زعيم

223
00:15:58,590 --> 00:16:01,460
انتهينا من تحميل كلّ شيء
.نهبناه على العربة

224
00:16:01,460 --> 00:16:05,330
.انتهيتم؟ لنغادر المكان إذًا

225
00:16:05,330 --> 00:16:08,060
لا فائدة من العبث هنا
.مع هؤلاء الضّعفاء

226
00:16:09,700 --> 00:16:11,200
!انتظر

227
00:16:12,770 --> 00:16:15,140
!قلت لك انتظر أيّها المجرم المطلوب

228
00:16:15,640 --> 00:16:20,910
لقد سلّمنا العشرات... بل المئات
!من أصحاب المكافآت بالكاد

229
00:16:21,280 --> 00:16:23,380
،إن سمحنا لك بالإفلات

230
00:16:23,380 --> 00:16:25,580
!فسيلحق بنا العار للأجيال القادمة

231
00:16:26,510 --> 00:16:28,120
.يا للخسارة

232
00:16:28,520 --> 00:16:30,950
الأمر لا يستحقّ، صحيح؟

233
00:16:31,650 --> 00:16:35,460
...ربّما لن نكسب شيئًا... ولكن

234
00:16:36,890 --> 00:16:41,160
هنالك أوقات على الرّجل أن يثبَت
!على ما يؤمن به ويقاتل

235
00:16:43,530 --> 00:16:46,000
.أنتما لن تعيشا طويلاً في هذه الحياة

236
00:16:46,000 --> 00:16:48,140
!عرفنا ذلك عندما بدأنا هذا

237
00:16:48,570 --> 00:16:49,870
.فهمت

238
00:16:50,340 --> 00:16:53,070
!يا رجال! تولّوا أمر هذان الرّجلان في الحال

239
00:16:55,740 --> 00:16:56,710
!لننل منهما

240
00:16:56,710 --> 00:16:57,410
!ابتعد

241
00:17:12,160 --> 00:17:14,960
!ماذا تريد؟! أفلتني
!إنّهما يقاتلان من أجلي

242
00:17:15,230 --> 00:17:16,930
...إن كنت تريد القتال

243
00:17:18,060 --> 00:17:21,830
ففكّر مليًّا. ماذا بمقدورك
فعله بما لديك من قوّة؟

244
00:17:38,220 --> 00:17:40,790
.يا إلهي، مسكينان

245
00:17:41,120 --> 00:17:44,760
لا توجد منطقة في وجهيكما
.لم تُضرب بعد

246
00:17:44,760 --> 00:17:47,190
.أعتقد أنّ الوقت حان لإنهاء هذا

247
00:17:48,930 --> 00:17:53,330
،لم أكسب أيّ فلس من قتلكما

248
00:17:53,600 --> 00:17:56,500
.لكن اعتبرا هذا مصيركما المحتوم

249
00:17:56,870 --> 00:18:00,610
حظّكما التّعيس الّذي كسبتماه
.من محاولتكما السّعي خلف رأسي

250
00:18:00,870 --> 00:18:04,710
لكن استريحا، سأرسلكما
.للعالم الآخر معًا كشريكين

251
00:18:08,050 --> 00:18:09,150
!خذا هذه

252
00:18:10,980 --> 00:18:11,820
!ها أنا ذا

253
00:18:19,360 --> 00:18:21,090
هذا يكفي، ألا تظنّ ذلك؟

254
00:18:21,430 --> 00:18:23,260
.انتهى هذا القتال منذ مدّة

255
00:18:26,960 --> 00:18:27,760
...أنت

256
00:18:28,470 --> 00:18:29,730
...ذلك الرّجل

257
00:18:30,000 --> 00:18:33,940
.سامحاني، لكنّني سآخذ طريدتكما منكما

258
00:18:35,170 --> 00:18:37,740
.فأنا بحاجة شديدة ومفاجئة للمال

259
00:18:37,740 --> 00:18:39,080
...أ-أكيد

260
00:18:39,710 --> 00:18:40,610
.حسنًا

261
00:18:43,610 --> 00:18:44,650
من يكون؟

262
00:18:46,620 --> 00:18:49,820
سـ-سيف بغمد أبيض...؟

263
00:18:52,390 --> 00:18:54,760
.سأحتاج لاستعارة سيفيكما لبعض الوقت

264
00:18:55,160 --> 00:18:57,830
—لا مشكلة، لكن ما الّذي تنوي أن

265
00:18:58,930 --> 00:19:01,460
!...ثلاثة سيوف؟! لا يُعقل

266
00:19:02,600 --> 00:19:05,600
!صائد القراصنة رورونوا زورو؟

267
00:19:08,200 --> 00:19:11,910
فعلاً؟ هذا هو صائد القراصنة الخرافيّ إذًا؟

268
00:19:12,540 --> 00:19:14,880
ما الّذي يحدث هنا إذًا؟

269
00:19:15,440 --> 00:19:18,410
،أكيد أنّني أصبحتُ أقوى في الآونة الأخيرة

270
00:19:18,780 --> 00:19:21,950
لكن بمجرّد أن أستعمل الكثير
.من قوّتي، تُكسر سيوفي

271
00:19:22,520 --> 00:19:25,320
لا يجب أن أقوم بالمبالغة
.في استعمال قوّتي بتهوّر

272
00:19:25,850 --> 00:19:27,390
،مهما كان السّيف

273
00:19:27,390 --> 00:19:30,730
عليّ أن أبلغ النّقطة الّتي أستطيع
.إطلاق 100% من قوّته

274
00:19:34,330 --> 00:19:38,470
حتّى باستعمال ثلاثة سيوف
،يا رورونوا زورو

275
00:19:38,470 --> 00:19:42,740
لا أظنّك ستكون قادرًا على هزيمة
.هذا العدد الكبير من الرّجال دفعةً واحدة

276
00:19:45,040 --> 00:19:49,640
استعمال ثلاثة سيوف لا يشبه
.استعمال أسلوب السّيوف الثّلاثة

277
00:19:49,880 --> 00:19:51,650
أقلت أسلوب السّيوف الثّلاثة؟

278
00:19:51,650 --> 00:19:53,580
لنره إذًا، ما الضّرر من ذلك؟

279
00:19:53,580 --> 00:19:55,120
!نالوا منه يا رجال

280
00:20:09,060 --> 00:20:10,760
!لقد فعلها! مذهل

281
00:20:11,000 --> 00:20:12,230
!هذا ممتاز

282
00:20:14,430 --> 00:20:15,300
!انتبه

283
00:20:23,910 --> 00:20:25,410
!رائع

284
00:20:40,060 --> 00:20:42,390
.أخبرتك ألاّ تقفي قربي

285
00:20:42,690 --> 00:20:44,760
.ستصاب بالزّكام إن لم ترتدي ملابس كافية

286
00:20:45,060 --> 00:20:48,030
إنّ من يصابون بالزّكام هم
.من يرخون دفاعات عقولهم

287
00:20:48,330 --> 00:20:50,770
أتساءل إن وُجد شخص ما

288
00:20:50,770 --> 00:20:53,640
.يروي قصصًا عن صائد القراصنة، زورو

289
00:20:53,840 --> 00:20:56,610
.لم أدعُ نفسي يومًا بصائد القراصنة

290
00:20:56,910 --> 00:21:00,580
إذًا من منحك اسمًا رائعًا كهذا؟

291
00:21:01,450 --> 00:21:04,550
.لا أدري. لا أهمّيّة لذلك عندي

292
00:21:22,500 --> 00:21:24,340
!كـ-كلاّ! نيراني

293
00:21:24,640 --> 00:21:26,500
!قاطع الغول

294
00:21:30,410 --> 00:21:33,780
...هذا إذًا... أسلوب السّيوف الثّلاثة

295
00:21:40,880 --> 00:21:42,550
.حسنًا، لم تنكسر السّيوف

296
00:21:43,450 --> 00:21:44,350
.شكرًا على المساعدة

297
00:21:46,660 --> 00:21:48,090
!رورونوا زورو

298
00:21:48,890 --> 00:21:52,100
.أنا مندهش جدًّا بمهاراتك
هلاّ سمحت لنا بالانضمام لك؟

299
00:21:52,500 --> 00:21:54,460
،نحن ثنائيّ صائدي مكافآت

300
00:21:54,460 --> 00:21:56,800
،مرعبان بما يكفي بالكاد
،لإسكات طفل يبكي

301
00:21:56,800 --> 00:21:58,330
!يوساكو وجوني

302
00:21:59,670 --> 00:22:01,040
.افعلا ما يحلو لكما

303
00:22:06,240 --> 00:22:08,910
!أخي الكبير

304
00:22:09,470 --> 00:22:17,650
آه، خلف السّماء الّتي لا نهاية لها

305
00:22:17,650 --> 00:22:28,260
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

306
00:22:36,130 --> 00:22:43,570
مرّت عليّ أيّام كدت أخسر فيها نفسي

307
00:22:43,570 --> 00:22:51,980
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

308
00:22:51,980 --> 00:23:00,190
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

309
00:23:00,190 --> 00:23:09,030
دفعوا بي للأمام، أليس كذلك؟

310
00:23:09,030 --> 00:23:17,370
آه، إنّ النّجوم تهوي من السّماء

311
00:23:17,370 --> 00:23:20,470
...وهذه اللّحظة الفريدة

312
00:23:25,850 --> 00:23:26,650
!لوفي

313
00:23:26,650 --> 00:23:27,110
ماذا؟

314
00:23:27,110 --> 00:23:29,420
.لنسرع ونغادر هذه الجزيرة

315
00:23:29,420 --> 00:23:31,620
.يبدو أنّها ستسبّب لنا المشاكل فحسب

316
00:23:31,620 --> 00:23:34,790
يراودني شعور من ذلك
.العجوز مماثل لك

317
00:23:34,790 --> 00:23:36,960
فعلاً؟ لا داعي للقلق إذًا، صحيح؟

318
00:23:37,590 --> 00:23:39,460
!كلاّ، لهذا السّبب أنا قلق

319
00:23:39,460 --> 00:23:40,660
فعلاً؟

320
00:23:40,660 --> 00:23:42,060
:في الحلقة القادمة من ون بيس

321
00:23:42,060 --> 00:23:45,560
زيني من جزيرة الجديان"
"!وسفينة القراصنة في الجبال

322
00:23:45,560 --> 00:23:47,800
!ملك القراصنة، لن يكون إلاّ أنا