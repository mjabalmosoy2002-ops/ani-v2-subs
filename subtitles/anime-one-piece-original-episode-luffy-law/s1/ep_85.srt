1
00:00:28,040 --> 00:00:29,440
...إرادة موروثة

2
00:00:29,740 --> 00:00:31,980
...تعاقب الأزمنة... أحلام النّاس

3
00:00:32,580 --> 00:00:34,880
.لا رادع لهذه الأشياء

4
00:00:35,380 --> 00:00:38,480
ما دام النّاس يسعون باحثين
،عن جواب للحرّيّة

5
00:00:38,480 --> 00:00:41,120
!فلن تختفي هذه الأشياء عن الوجود

6
00:00:49,660 --> 00:00:56,030
لا أؤمن سوى بالمستقبل... ولا أهتمّ لضحك أيِّ كان

7
00:00:56,030 --> 00:01:01,540
يجعل ذلك الشّغفُ المتسارعُ المرءَ يتألّق

8
00:01:01,540 --> 00:01:07,540
إنّه شديد السّطوع، لكنّني أريد التّحديق به

9
00:01:07,540 --> 00:01:11,050
أشعر بـ"الجمال" في كلّ مكان

10
00:01:11,050 --> 00:01:14,320
أنا متمسّك بكم بشدّة بالفعل

11
00:01:14,320 --> 00:01:20,960
أنا أتبع وأتبع خطوات حلم
لا يشبه أيّ أحد

12
00:01:20,960 --> 00:01:24,260
إلى أن أحصل عليه بكلّ إثارة

13
00:01:24,260 --> 00:01:31,270
!آمنوا ببلاد العجائب

14
00:01:33,200 --> 00:01:39,410
سأمسك وأمسك بشكل حلم
لا يستطيع أحد رؤيته

15
00:01:39,410 --> 00:01:45,420
سوف أرافقك أيّتها المشاعر الشّغوفة

16
00:01:45,420 --> 00:01:48,490
لا أحتاج فعلاً ليكون كلّ شيء في مكانه

17
00:01:48,490 --> 00:01:51,820
،بل أريدها حياة عاديّة لا غير

18
00:01:51,820 --> 00:01:55,260
فاركضوا نحو النّعيم بدل ذلك

19
00:01:55,290 --> 00:02:00,930
!آمنوا ببلاد العجائب

20
00:02:10,370 --> 00:02:13,910
"!حلمُ منبوذ! هيرولوك الدجّال"

21
00:02:17,050 --> 00:02:20,980
:تشخيص اليوم الثّالث
.٪انخفضت البكتيريا بنسبة 30

22
00:02:34,090 --> 00:02:35,400
!أنت مذهل

23
00:02:35,400 --> 00:02:37,230
!هذا ما أتوقّعه من وحش

24
00:02:37,230 --> 00:02:39,140
لكن ماذا سيحدث إن فعلت هذا؟

25
00:02:39,870 --> 00:02:40,940
...دغدغة، دغدغة

26
00:02:41,830 --> 00:02:43,040
!مـ-ماذا تفعل؟

27
00:02:52,620 --> 00:02:53,820
!مضحك حقًّا

28
00:02:53,980 --> 00:02:56,190
!اخرس! ابتعد عنّي

29
00:02:56,750 --> 00:02:59,060
هلاّ أصبحت صديقي؟

30
00:02:59,490 --> 00:03:01,920
!أعجبتني حقًّا

31
00:03:04,260 --> 00:03:06,300
صـ-صديقك؟

32
00:03:06,660 --> 00:03:08,070
!أصبِح قرصانًا

33
00:03:09,400 --> 00:03:11,870
.لستُ مهتمًّا بالقراصنة بتاتًا

34
00:03:11,870 --> 00:03:14,240
!ولم أرد صديقًا قطّ

35
00:03:14,240 --> 00:03:18,240
!إن أصبحت صديقي، سيسعد بقيّة أصدقائي

36
00:03:18,580 --> 00:03:19,610
!انتظر

37
00:03:19,610 --> 00:03:21,710
!ولِمَ قد أريد أن أكون صديقك؟

38
00:03:21,710 --> 00:03:23,210
!لا تهنّي

39
00:03:31,620 --> 00:03:34,320
!أنت مضحك فعلاً

40
00:03:34,320 --> 00:03:36,460
!سأجعلك صديقي بكلّ تأكيد

41
00:03:38,260 --> 00:03:41,700
،لأجل أن تستعيدي ابتسامتك الصّحيّة

42
00:03:41,700 --> 00:03:45,240
...أعددتُ لك طبقًا مغذّيًا واستثنائيًّا

43
00:03:45,240 --> 00:03:47,070
.شكرًا لك يا سانجي-كن

44
00:03:47,670 --> 00:03:52,280
مع أنّ جمالك يعذّبني
...حتّى بعد ما مرّ به جسدك

45
00:03:52,410 --> 00:03:56,180
يا إلهي! متى استخدمت مطبخي
دون مشاورتي؟

46
00:03:56,350 --> 00:03:58,580
يا سيّدة، طبق اللّحم
.المشويّ هناك لك

47
00:03:58,580 --> 00:04:00,320
إنّه غنيّ بالبروتين ومفيد
—لتجديد الـ

48
00:04:01,350 --> 00:04:02,720
."لستُ "سيّدة

49
00:04:03,320 --> 00:04:06,820
.أنا عازبة بسطوع... وما زلتُ شابّة

50
00:04:06,820 --> 00:04:09,460
ما زلت في شباب الـ139... صحيح؟

51
00:04:09,460 --> 00:04:11,830
!دكتورين! ساعديني

52
00:04:12,030 --> 00:04:13,600
!انتظر! انتظر

53
00:04:15,000 --> 00:04:15,970
!انتظر

54
00:04:19,700 --> 00:04:20,570
!انتظر! انتظر

55
00:04:20,570 --> 00:04:22,470
ما الّذي تفعله؟

56
00:04:23,010 --> 00:04:25,140
!سوف ينضمّ لنا ويصبح صديقنا

57
00:04:26,400 --> 00:04:27,490
!أحقًّا؟

58
00:04:27,610 --> 00:04:29,350
!لم أقل ذلك

59
00:04:29,350 --> 00:04:30,050
.بلى فعلت

60
00:04:30,050 --> 00:04:30,880
!لم أفعل

61
00:04:30,920 --> 00:04:31,460
!فعلت

62
00:04:31,480 --> 00:04:33,080
!اصمتا أنتما الاثنان

63
00:04:33,080 --> 00:04:36,190
!انتظر

64
00:04:36,920 --> 00:04:38,190
صديق؟

65
00:04:38,190 --> 00:04:42,130
ما مدى عمقِ تلك الكلمة
...بالنّسبة له

66
00:04:43,560 --> 00:04:45,130
...حتّى تسأله بجهل

67
00:04:54,370 --> 00:05:00,840
كان هنالك رجل انفتح له
...عندما كان وحيدًا

68
00:05:00,840 --> 00:05:03,350
.كان اسم ذلك الرّجل الدّكتور هيرولوك

69
00:05:04,310 --> 00:05:08,150
.كان دجّالاً وهب تشوبّر اسمًا واتّخذه ولدًا

70
00:05:14,790 --> 00:05:16,630
!انتظر

71
00:05:17,490 --> 00:05:18,230
!هل وجدتماه؟

72
00:05:18,230 --> 00:05:19,800
!لا! لم نتمكّن من إيجاده

73
00:05:19,800 --> 00:05:22,230
!ذلك الدجّال اللّعين هيرولوك

74
00:05:22,230 --> 00:05:25,100
!سوف نقبض عليه مهما كان
!تلك أوامر وابول-ساما

75
00:05:25,100 --> 00:05:25,900
!نعم

76
00:05:38,320 --> 00:05:39,750
!سحقًا

77
00:05:41,320 --> 00:05:42,520
.لا يمكننا الاستمرار هكذا

78
00:05:42,820 --> 00:05:44,320
.لنستدعِ طبيبًا

79
00:05:44,990 --> 00:05:48,030
كلاّ. لا يوجد أيّ أطبّاء
...في هذه البلاد

80
00:05:48,460 --> 00:05:51,430
ما عدا الأطبّاء العشرين الّذين
...يخدمون وابول بشكلٍ خاصّ

81
00:05:51,860 --> 00:05:55,900
سنستجدي وابول ونطلب
.الأطبّاء العشرين. سأذهب

82
00:05:55,900 --> 00:05:57,400
.لستِ بحاجةٍ لذلك

83
00:06:03,540 --> 00:06:04,940
.سأفحصه

84
00:06:04,940 --> 00:06:06,140
!هيرولوك

85
00:06:06,140 --> 00:06:08,650
!لـ-لا شكرًا! لا تفعل رجاءً

86
00:06:08,650 --> 00:06:12,050
انتهى المطاف بمجموعة
!ممّن عالجتهم بأن ساء حالهم

87
00:06:12,320 --> 00:06:13,750
.لا تكن متواضعًا

88
00:06:13,750 --> 00:06:17,250
.طوّرتُ البارحة عقّارًا صالحًا لكلّ العلل

89
00:06:18,190 --> 00:06:19,920
.أنت محظوظ

90
00:06:24,380 --> 00:06:26,900
.ليس ما تظنّ. هذا مسدّس مهدّئ

91
00:06:26,900 --> 00:06:29,000
.أستعمله عندما يشتدّ الألم عند المريض

92
00:06:29,000 --> 00:06:30,670
!سـ-سأذهب لإحضار الحرّاس

93
00:06:32,340 --> 00:06:35,410
،غادر رجاءً! إن أردتَ المال
!فسأدفع لك

94
00:06:37,140 --> 00:06:39,680
.لا أقبل المال من المرضى

95
00:06:39,980 --> 00:06:41,950
.أريد مساعدتك فحسب

96
00:06:41,950 --> 00:06:45,320
!إيّاك! توقّف! لديّ عائلة

97
00:06:56,290 --> 00:06:58,760
هذا غريب. هل استخدمتُ
المكوّن الخاطئ؟

98
00:06:59,030 --> 00:07:01,600
...خلتُ أنّ مُستخرج الضّفدع سينفع

99
00:07:01,870 --> 00:07:03,900
...لكن أظنّني فشلت. يا إلهي

100
00:07:04,300 --> 00:07:06,470
...آ-آسف... لم أقصد حدوث هذا

101
00:07:06,470 --> 00:07:08,540
!هيرولوك! هل أنت هناك؟

102
00:07:10,310 --> 00:07:11,440
!انتظر

103
00:07:24,090 --> 00:07:25,920
هل أنت سعيد أيّها الشّابّ؟

104
00:07:26,690 --> 00:07:28,630
.بلغت مطاردة الأطبّاء مرحلتها الأخيرة

105
00:07:28,630 --> 00:07:32,130
سمعتُ أنّني وأنت الطّبيبان
.الوحيدان في البلاد

106
00:07:33,630 --> 00:07:36,600
.إنّ وابول يحاول جاهدًا الإمساك بنا

107
00:07:36,600 --> 00:07:39,970
،حتّى إن اختلف الوضع
...أنت منبوذ في هذه البلاد سلفًا

108
00:07:40,670 --> 00:07:42,870
.بما أنّك أسوأ الدّجّالين

109
00:07:46,610 --> 00:07:49,050
.لن يُقبض عليّ من طرف مطاردة أطبّاء

110
00:07:49,780 --> 00:07:53,280
سوف أنقذ هذه البلاد
.بواسطة الطّبّ العلميّ يومًا ما

111
00:07:54,150 --> 00:07:57,290
ماذا؟ ألم تقصد قول "تدمير هذه البلاد"؟

112
00:07:57,690 --> 00:07:59,190
!هنالك أناسٌ على الجسر

113
00:07:59,390 --> 00:08:01,190
.أراك لاحقًا أيّها الدّجّال

114
00:08:01,190 --> 00:08:03,660
.لا أريد رؤيتك ثانيةً أيّتها الطّبيبة اللّصّة

115
00:08:12,400 --> 00:08:14,740
!لن أدعهم يقبضون عليّ أبدًا

116
00:08:14,740 --> 00:08:17,610
!سأنقذ أكبر عددٍ ممكن من المرضى

117
00:08:25,680 --> 00:08:27,020
هل أُصبت بطلقة؟

118
00:08:27,020 --> 00:08:29,390
علينا أن نوقف النّزيف فورًا
!وإلاّ ستموت

119
00:08:31,020 --> 00:08:32,720
!لا تقلق. سأنقذك

120
00:08:32,890 --> 00:08:35,360
!إنّه يتّي! أردوه قتيلاً

121
00:08:38,000 --> 00:08:41,770
صنعتُ مرهمًا ينفع حتّى على
.العظام المكسورة من ثلاثة أيّام

122
00:08:41,770 --> 00:08:43,170
.أنت محظوظ

123
00:08:47,300 --> 00:08:48,310
!لا تدعوه يهرب

124
00:08:48,310 --> 00:08:49,740
!اقتلوه

125
00:08:49,870 --> 00:08:51,110
!أطلقوا عليه

126
00:08:56,410 --> 00:08:59,750
.ماذا تكون؟ لا تبدو كإنسان

127
00:08:59,750 --> 00:09:02,890
صحيح. أنت مخلوق اليتّي
...الّذي تحدّثوا عنه

128
00:09:15,830 --> 00:09:17,670
!أجل! أصبته

129
00:09:17,670 --> 00:09:19,840
!لم يكن ذلك كافيًا! أجهزوا عليه

130
00:09:30,980 --> 00:09:34,180
...كـ-كيف تجرؤ

131
00:09:35,450 --> 00:09:36,750
...ماذا تظنّ

132
00:09:38,590 --> 00:09:40,890
!بي؟

133
00:09:40,890 --> 00:09:42,660
!انتظر يا هذا

134
00:09:45,200 --> 00:09:48,370
!لن أطلق عليك أبدًا

135
00:09:51,270 --> 00:09:54,470
!اسمي الدّكتور هيرولوك

136
00:09:55,370 --> 00:09:57,110
!أنا طبيب

137
00:10:51,730 --> 00:10:56,000
.كان ذلك أوّل لقاء لهيرولوك وتشوبّر

138
00:11:11,920 --> 00:11:13,920
...ماذا حلّ إذًا

139
00:11:14,450 --> 00:11:16,890
بالرّنّة الّذي أواه هيرولوك؟

140
00:11:18,520 --> 00:11:21,020
!ماذا؟! أتجيد الحديث؟

141
00:11:25,560 --> 00:11:27,530
لِمَ بقيت صامتًا لثلاثة أيّام إذًا؟

142
00:11:28,400 --> 00:11:31,470
...ظننت أنّك ستكرهني إن نطقت

143
00:11:32,100 --> 00:11:34,400
،عندما تحدّثت مع البشر ذلك اليوم

144
00:11:34,840 --> 00:11:36,040
...أطلقوا عليّ النّار

145
00:11:36,840 --> 00:11:39,240
لأنّ من الغريب على رنّة
...أن تتحدّث

146
00:11:39,380 --> 00:11:41,280
!تتكلّم، وماذا إذًا؟

147
00:11:42,750 --> 00:11:46,320
...يمكنني أن أتكلّم أيضًا
.حتّى أفضل منك

148
00:11:49,250 --> 00:11:50,350
!اهرب يا تشوبّر

149
00:11:57,360 --> 00:11:59,860
!سحقًا! فشلتُ ثانيةً

150
00:11:59,860 --> 00:12:01,730
!هل أنت بخير يا تشوبّر؟

151
00:12:06,230 --> 00:12:09,170
لستَ بخير من الأساس
...على ما أظنّ

152
00:12:15,110 --> 00:12:16,880
لِمَ تدعوني بتشوبّر؟

153
00:12:17,610 --> 00:12:20,120
.أنت توني توني تشوبّر

154
00:12:20,120 --> 00:12:24,920
في النّهاية، أنت رنّة وتملك
.قرنين رائعين يمكنها قطع الأشجار

155
00:12:25,490 --> 00:12:26,590
إنّه اسمٌ رائع، أليس كذلك؟

156
00:12:27,260 --> 00:12:29,190
.هكذا سأناديك

157
00:12:31,530 --> 00:12:32,730
...تشوبّر

158
00:12:36,600 --> 00:12:37,930
.اسمع يا تشوبّر

159
00:12:37,930 --> 00:12:41,570
عليك أن تراقب المريض
.دائمًا وتمنحه العلاج المناسب

160
00:12:41,910 --> 00:12:44,310
.يمكنك إنقاذ حياة النّاس هكذا

161
00:12:47,110 --> 00:12:50,750
لنذهب! إنّ المرضى
.ينتظرونني اليوم ثانيةً

162
00:12:50,910 --> 00:12:52,850
!انقلع من هنا أيّها الدجّال

163
00:12:53,950 --> 00:12:56,450
...خلتُ أنّ مُقل عين السّحليّة ستفلح

164
00:12:57,450 --> 00:12:58,790
!لا تعد ثانيةً

165
00:12:59,390 --> 00:13:00,820
!ارحل

166
00:13:01,390 --> 00:13:03,460
!اهرب! إنّهم الحرس

167
00:13:03,460 --> 00:13:05,730
!تشوبّر! سنستخدم خطّة التّمويه

168
00:13:05,730 --> 00:13:06,660
!ما هي؟

169
00:13:07,000 --> 00:13:08,400
!اعتنِ بنفسك

170
00:13:12,140 --> 00:13:12,800
ماذا؟

171
00:13:13,570 --> 00:13:16,010
!كدتُ أموت بسببك

172
00:13:16,010 --> 00:13:16,710
!هكذا إذًا؟

173
00:13:16,710 --> 00:13:19,780
فشلتَ في الموت بالفعل مرّةً
!يا ذا الأنف الأزرق الأخرق

174
00:13:19,780 --> 00:13:21,780
!لا تدعوني بذي الأنف الأزرق

175
00:13:33,690 --> 00:13:34,590
...أيّها الدّكتور

176
00:13:35,660 --> 00:13:39,930
...هذه أوّل مرّة
...أتشاجر مع أحدهم

177
00:13:42,600 --> 00:13:43,970
...هذا منطقيّ

178
00:13:43,970 --> 00:13:45,940
.تحتاج في البداية لخصم لتُقاتل

179
00:13:45,940 --> 00:13:48,870
أخبرني... أهذه أوّل مرّة
تتلقّى هذه أيضًا؟

180
00:13:54,640 --> 00:13:58,220
...سأعطيها لك. كهديّة
.وكتذكار لمصالحتنا

181
00:13:58,950 --> 00:14:01,690
هديّة؟ مصالحة؟

182
00:14:10,630 --> 00:14:14,200
نمرّ كلانا بالمصاعب كمنبوذين، أليس كذلك؟

183
00:14:14,730 --> 00:14:17,730
.لكن لا تضمر الضّغينة للبشر

184
00:14:18,070 --> 00:14:20,300
.هذه البلاد مريضةٌ الآن

185
00:14:21,240 --> 00:14:23,770
كلّ من الشّعب والملك
.يعانون من مرضٍ في قلبهم

186
00:14:23,770 --> 00:14:27,580
يقول المرء عادةً أنّه لا يمكن
،علاج بلادٍ مريضة

187
00:14:27,580 --> 00:14:28,680
.لكنّ ذلك ليس صحيحًا

188
00:14:29,710 --> 00:14:33,150
،فور أن يكتمل اختراعي
!سأنقذ هذه البلاد

189
00:14:33,880 --> 00:14:37,950
كان هنالك لصّ بارع
.في بلادٍ في أقاصي الغرب

190
00:14:38,290 --> 00:14:41,120
.وكان يعاني من مرضٍ خطير في قلبه

191
00:14:42,060 --> 00:14:45,030
أخذ يزور كلّ طبيبٍ بارعٍ
،وتلقّى منهم العلاج

192
00:14:45,030 --> 00:14:47,200
.لكنّه لم يجد الشّفاء عند أيّ منهم

193
00:14:47,560 --> 00:14:50,170
بعد أن سمع أنّه سيموت، مرّ من جبلٍ

194
00:14:50,170 --> 00:14:52,040
.وهو محبط ومضطرب

195
00:14:52,040 --> 00:14:56,370
ثمّ... رأى هنالك منظرًا لم يرَ
.له مثيلاً في حياته

196
00:15:04,950 --> 00:15:06,020
!أزهار الكرز

197
00:15:06,020 --> 00:15:08,790
رأى أزهار كرز تنبض بالحياة
!تكسو كلّ أرجاء الجبل

198
00:15:09,690 --> 00:15:13,320
،ذهب لزيارة طبيبٍ آخر بعدها
...فإذا به يُصدم

199
00:15:13,320 --> 00:15:15,060
...لأنّه أخبره

200
00:15:15,060 --> 00:15:17,660
".أنت بخير حال"

201
00:15:17,660 --> 00:15:18,560
ماذا؟

202
00:15:18,730 --> 00:15:20,000
!لقد عولِج

203
00:15:20,000 --> 00:15:22,500
كانت معجزةً بالفعل! ألا تظنّ ذلك؟

204
00:15:22,500 --> 00:15:24,470
!لكنّه كان علمًا طبّيًّا ممّا لا شكّ فيه

205
00:15:24,470 --> 00:15:25,670
،بعد أن تحرّكت مشاعره

206
00:15:25,670 --> 00:15:28,770
!طرأ تغييرٌ ما في جسد الرّجل

207
00:15:29,670 --> 00:15:33,740
بمفهومٍ آخر، لا يوجد مرضٌ
.في هذا العالم لا يمكن علاجه

208
00:15:33,740 --> 00:15:35,780
،مهما قال النّاس عنّي

209
00:15:35,780 --> 00:15:38,850
!سوف أنقذ هذه البلاد كطبيب

210
00:15:46,520 --> 00:15:47,490
...جمجمة

211
00:15:47,690 --> 00:15:51,860
!إنّها رمزٌ لمعتقد أنّ لا شيء مستحيل

212
00:15:52,900 --> 00:15:55,370
!سوف أنقذ هذه البلاد كطبيب

213
00:16:01,570 --> 00:16:03,510
!أيّها الرّنّة

214
00:16:04,470 --> 00:16:06,540
!انضمّ لنا وأصبح صديقنا

215
00:16:08,200 --> 00:16:09,550
!يبدو ذلك لذيذًا

216
00:16:16,050 --> 00:16:17,920
!من الرّائع أن تكون قرصانًا

217
00:16:18,820 --> 00:16:21,260
أيّها الدّكتور، ما هم القراصنة؟

218
00:16:21,260 --> 00:16:22,560
القراصنة؟

219
00:16:23,690 --> 00:16:26,530
.القراصنة أشخاص مذهلون في البحر

220
00:16:26,530 --> 00:16:29,200
إنّهم يتمتّعون بأجسادٍ مدرّبة
.جيّدًا وعيون كالصّقر

221
00:16:29,200 --> 00:16:31,870
!أصواتهم أشبه برعدٍ يقسم البحر

222
00:16:41,480 --> 00:16:44,280
!هل أنت... قرصان حقًّا؟

223
00:16:45,650 --> 00:16:47,120
...نعم، أنا كذلك

224
00:16:47,680 --> 00:16:49,590
!كما أخبرتك، انضمّ لنا

225
00:16:49,590 --> 00:16:52,060
!من الممتع أن تكون قرصانًا
.القراصنة يغنّون أيضًا

226
00:16:52,390 --> 00:16:55,190
ماذا؟ يـ-يغنّون؟

227
00:16:55,930 --> 00:16:58,730
!نعم. ويرقصون أيضًا

228
00:16:59,000 --> 00:17:00,960
!أذلك مفهوم القرصان عندك؟

229
00:17:00,960 --> 00:17:02,900
هذا صحيح! كما أنّهم يخوضون
!الكثير من المغامرات

230
00:17:03,370 --> 00:17:04,370
مغامرات؟

231
00:17:04,370 --> 00:17:06,570
يخوض القراصنة مغامرات إذًا؟

232
00:17:07,000 --> 00:17:08,210
!أكيد

233
00:17:08,210 --> 00:17:10,640
يخاطر القراصنة بحياتهم
!للذّهاب في مغامرات

234
00:17:10,640 --> 00:17:12,840
!بوسعك لقاء الكثير من النّاس الرّائعين

235
00:17:13,140 --> 00:17:14,980
!من الرّائع أن تكون قرصانًا

236
00:17:14,980 --> 00:17:17,780
!ثمّة الكثير من الأشخاص المذهلين في البحر

237
00:17:19,420 --> 00:17:22,220
.تشوبّر، اذهب إلى البحر يومًا ما

238
00:17:22,220 --> 00:17:26,620
.إن فعلت، ستفهم مدى تفاهة مشاكلك

239
00:17:26,620 --> 00:17:31,630
هذه الجزيرة الّتي وُلدت فيها
.بهذا الصّغر مقارنةً بالعالم

240
00:17:32,300 --> 00:17:33,430
حقًّا؟

241
00:17:33,430 --> 00:17:37,170
!لا، بل أصغر! هكذا! هذا صحيح

242
00:17:41,840 --> 00:17:45,210
!مستقبلك ينتظرك وراء ذلك البحر

243
00:17:46,310 --> 00:17:49,980
...مرّت الأوقات الجميلة في طرفة عين

244
00:17:51,050 --> 00:17:52,350
...و

245
00:18:00,620 --> 00:18:03,290
...وقتُ الوداع

246
00:18:04,590 --> 00:18:06,300
...لا يسلم منه أحد

247
00:18:11,870 --> 00:18:15,610
.استغرق عامًا، لكن اكتمل علاجك الآن

248
00:18:16,010 --> 00:18:18,580
.تماثلت جراحك للشّفاء الآن يا تشوبّر

249
00:18:19,010 --> 00:18:20,980
!أجل! شكرًا يا دكتور

250
00:18:21,610 --> 00:18:23,910
...حسنًا... اعتنِ بنفسك

251
00:18:24,680 --> 00:18:25,450
ماذا؟

252
00:18:27,020 --> 00:18:30,150
!غادر الآن! عش كما شئت
!أنا مشغول بأبحاثي

253
00:18:31,460 --> 00:18:34,990
ما عدتُ أملك أيّ التزام
!أخلاقيّ للاعتناء بك

254
00:18:36,530 --> 00:18:37,560
!أيّها الدّكتور

255
00:18:37,890 --> 00:18:41,830
لن أسبّب لك المزيد من
!المشاكل أبدًا! دعني أدخل أرجوك

256
00:18:42,130 --> 00:18:45,670
!سأدلك كتفيك كلّ يوم
!سأعدّ لك الشّاي وأنظّف المنزل

257
00:18:45,670 --> 00:18:47,800
!أرجوك! دعني أبقى معك

258
00:18:49,840 --> 00:18:53,280
!لا أملك أيّ أصدقاء
!ولا مكان أقصده

259
00:18:56,850 --> 00:19:00,350
!أيّها الدّكتور

260
00:19:02,290 --> 00:19:05,690
!أيّها الدّكتور

261
00:19:08,060 --> 00:19:09,160
!تشوبّر

262
00:19:12,900 --> 00:19:15,130
.انظر إليّ يا دكتور. أنا مجروح

263
00:19:15,500 --> 00:19:16,770
!أيّها الدّكتور

264
00:19:18,270 --> 00:19:19,160
!انظر إلى هذا

265
00:19:23,740 --> 00:19:25,640
لماذا... أيّها الدّكتور؟

266
00:19:25,880 --> 00:19:28,880
!اذهب... إلى البحر! أو أيّ مكان آخر

267
00:19:29,350 --> 00:19:31,350
!إيّاك أن تعود إلى هنا ثانيةً

268
00:19:46,530 --> 00:19:48,670
!سامحني يا تشوبّر

269
00:20:01,380 --> 00:20:04,080
...سوف... أموت

270
00:20:07,580 --> 00:20:09,590
...نعم، ستموت

271
00:20:09,790 --> 00:20:12,960
أخبريني! كم بقي لي من يوم؟

272
00:20:12,960 --> 00:20:15,490
ماذا؟ إن كنت تطلب منّي
.أن أفحصك، فلن أفعل

273
00:20:15,490 --> 00:20:18,200
.لا تملك مالاً لتدفع رسومي

274
00:20:20,600 --> 00:20:21,500
!أخبريني

275
00:20:27,340 --> 00:20:30,140
!لا يمكنك قتل شخص بمسدّس مهدّئ

276
00:20:32,140 --> 00:20:35,550
لكن سأخبرك. ستموت في الخامسة
.مساءً بعد عشرة أيّام من اليوم

277
00:20:35,550 --> 00:20:36,550
.لن تعاني أكثر

278
00:20:37,580 --> 00:20:40,120
...عشرة أيّام... سيكون ذلك كافيًا

279
00:20:40,580 --> 00:20:41,820
...بعد يومين

280
00:20:41,820 --> 00:20:45,620
سأكمل البحث الّذي واصلتُه
...لثلاثين سنة بعد يومين

281
00:20:45,620 --> 00:20:49,130
!سأجعل... أزهار الكرز تزهر في هذه البلاد

282
00:20:49,390 --> 00:20:50,590
أزهار الكرز؟

283
00:20:50,590 --> 00:20:54,200
إذًا أكان البحث الّذي أجريته لثلاثين سنة

284
00:20:54,200 --> 00:20:56,470
بشأن جعل أزهار الكرز تزهر؟

285
00:20:56,870 --> 00:21:01,440
أزهار الكرز المعجزة الّتي أنقذتك
قبل وقتٍ طويل أيّها اللّصّ البارع؟

286
00:21:01,610 --> 00:21:02,740
!هذا صحيح

287
00:21:02,740 --> 00:21:03,570
ماذا؟

288
00:21:05,340 --> 00:21:06,780
.أنت أحمق

289
00:21:06,780 --> 00:21:09,180
هذه جزيرة شتاء حيث
.البرد قارس طوال العام

290
00:21:09,180 --> 00:21:11,280
.ما كانت أزهار الكرز لتزهر هنا

291
00:21:11,280 --> 00:21:14,280
،بلى ستزهر! كنتُ مجرمًا ميؤوسًا ويُحتضر

292
00:21:14,280 --> 00:21:18,760
.لكنّي عشتُ وتغيّر موقفي بشكلٍ شامل

293
00:21:19,290 --> 00:21:22,460
!يُمكن إنقاذ كلّ امرئٍ في هذا العالم

294
00:21:22,730 --> 00:21:26,330
،أودّ إثبات ذلك هنا في درام
!البلاد الّتي ولدتُ بها

295
00:21:27,000 --> 00:21:28,000
.اسمع

296
00:21:28,470 --> 00:21:32,170
ما تحاول فعله ليس علمًا
.طبّيًّا ولا أيّ علم

297
00:21:32,170 --> 00:21:36,240
،حتّى إن أزهرت أزهار الكرز
.لن تؤثّر بشيءٍ على أجساد النّاس

298
00:21:37,870 --> 00:21:38,940
!هيرولوك

299
00:21:44,820 --> 00:21:47,820
.تشوبّر! نحن مشابهان

300
00:21:47,820 --> 00:21:51,020
...لذا سأعلّمك على الأقلّ قبل موتي

301
00:21:51,920 --> 00:21:54,120
أنّه لا يوجد شيء مستحيل
...في هذا العالم

302
00:21:54,120 --> 00:21:56,830
!وأنّك تستطيع فعل أيّ شيء أيضًا

303
00:21:57,230 --> 00:22:03,770
لكنّ قصّة هذين الاثنين لم تكن
...تحمل بين طيّاتها نهايةً سعيدة

304
00:22:05,000 --> 00:22:06,000
...سأريك

305
00:22:06,770 --> 00:22:09,010
!أزهار الكرز المعجزة

306
00:22:15,380 --> 00:22:24,450
حتّى هذه البلدة الّتي لا تنام غفت الآن

307
00:22:25,690 --> 00:22:36,830
من اليوم فصاعدًا، سيتغيّر شيء

308
00:22:36,830 --> 00:22:47,080
أنا واثق أنّي أستطيع البدء
من جديد، بما أنّي لستُ لوحدي

309
00:22:47,080 --> 00:22:57,550
،بمجرّد كونكم إلى جانبي
أشعر أنّي أستطيع أن أغدو قويًّا

310
00:22:57,550 --> 00:23:08,030
،أتساءل إلى أيّ مدى يمكنني أن أصل
صوب المكان الّذي يقود إلى المستقبل

311
00:23:08,030 --> 00:23:16,310
إنّه يسطع من بعيد، غامرًا العالم

312
00:23:16,310 --> 00:23:20,040
قبل ضياء الفجر

313
00:23:25,380 --> 00:23:27,280
...يا لوفي. هل تنصت

314
00:23:27,280 --> 00:23:28,620
!مهلاً، أين ذهب؟

315
00:23:28,620 --> 00:23:30,950
تبًّا. أتساءل إن كان يلاحق
...توني-كن ثانيةً

316
00:23:31,230 --> 00:23:32,150
!إنّه يرفض

317
00:23:32,290 --> 00:23:34,390
!هذا ليس صحيحًا! هل أنت غبيّة؟

318
00:23:34,390 --> 00:23:36,550
!قرّرتُ أن أجعله ينضمّ لنا ويصبح صديقنا

319
00:23:36,580 --> 00:23:38,560
!لكنّ ذلك ما تريده أنت فقط، صحيح؟

320
00:23:38,720 --> 00:23:40,930
صدقًا... أتساءل إن كان هنالك
...دواء يفلح على الأغبياء

321
00:23:41,130 --> 00:23:42,570
:في الحلقة القادمة من وان بيس

322
00:23:42,570 --> 00:23:45,270
أزهار كرز هيرولوك"
"!والإرادة الّتي ستُورّث

323
00:23:45,270 --> 00:23:47,600
!ملك القراصنة، لن يكون إلاّ أنا