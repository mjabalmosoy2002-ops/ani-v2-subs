1
00:00:22,250 --> 00:00:25,280
!العالم... نعم

2
00:00:25,820 --> 00:00:27,480
...اسعوا نحو الحرّيّة

3
00:00:27,480 --> 00:00:31,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,360 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:09,190 --> 00:02:13,120
!أديروا الدّفّة نحو السّحاب"
"!الإمساك بطائر الجنوب

22
00:02:15,930 --> 00:02:17,430
ما الّذي تريد إخبارنا به أيّها العمّ؟

23
00:02:18,460 --> 00:02:24,300
اسمعوا، سأبدأ بإخباركم كلّ شيء
.أعرفه عن جزيرة السّماء

24
00:02:24,800 --> 00:02:29,010
لا شيء من هذا أكيد، لكنّ تصديقكم
!لكلامي أم لا منوط بكم

25
00:02:29,270 --> 00:02:30,610
!نعم! نحن نصدّقك

26
00:02:30,610 --> 00:02:31,480
!هذا سريع

27
00:02:31,710 --> 00:02:34,910
ثمّة ظاهرة غريبة تحدث
...في هذه المياه

28
00:02:35,450 --> 00:02:39,450
يحلّ اللّيل فجأة أحيانًا حتّى
.إن كنّا في منتصف النّهار

29
00:02:40,020 --> 00:02:43,020
!أجل! رأينا ذلك! صحيح؟

30
00:02:43,020 --> 00:02:47,690
نعم! حلّ اللّيل فجأة
!ثمّ ظهرت بعض الوحوش

31
00:02:49,390 --> 00:02:50,890
العملاقة؟

32
00:02:50,890 --> 00:02:55,230
،ثمّة قصّة تتحدّث عن أصلوها
.لكن انسوا أمرها الآن

33
00:02:55,430 --> 00:02:57,700
...حلول اللّيل المفاجئ هذا

34
00:03:00,870 --> 00:03:04,240
تتسبّب به ظلال سحب
...مضغوطة بشدّة

35
00:03:04,240 --> 00:03:06,240
تقصد المزن الرّكاميّ؟

36
00:03:06,240 --> 00:03:08,580
...لكنّها أغمق من أن تكون سحبًا

37
00:03:09,850 --> 00:03:11,320
!أنت غبيّ أيّها العمّ

38
00:03:11,320 --> 00:03:13,550
يصبح الجوّ غائمًا عند تجمّع
!غيوم كثيرة وليس مظلمًا

39
00:03:13,550 --> 00:03:14,950
!نعم! غائم

40
00:03:14,950 --> 00:03:15,550
!غائم

41
00:03:15,550 --> 00:03:17,520
!اخرسوا واستمعوا

42
00:03:17,920 --> 00:03:21,330
."ثمّة سحب تُعرف بـ"السُّحب الملكيّة

43
00:03:21,330 --> 00:03:26,860
إنّها تتجمّع عاليًا في السّماء
.لكنّها لا تنتج تيّارات هواء أو مطر

44
00:03:26,860 --> 00:03:32,340
،عندما تظهر عاليًا في السّماء
،يُحجب حتّى نور الشّمس

45
00:03:32,340 --> 00:03:34,500
.ويتحوّل النّهار على الأرض إلى ليل

46
00:03:34,970 --> 00:03:37,270
وتقول نظريّة أنّ السّحب الملكيّة

47
00:03:37,270 --> 00:03:42,980
هي سحب متحجّرة طفت في السّماء
.لآلاف آلاف السّنين دونما أيّ تغيير

48
00:03:42,980 --> 00:03:47,420
هذا سخيف! لا يمكن للسّحب
!أن تتشكّل دون تيّارات هوائيّة

49
00:03:47,820 --> 00:03:50,420
.لك حرّيّة تصديق وجودها من عدمه

50
00:03:50,420 --> 00:03:52,890
!أنا لا أطلب منك أن تصدّقيني

51
00:03:53,320 --> 00:03:55,090
إنّها سحب غامضة إذًا؟

52
00:03:55,560 --> 00:03:58,600
.نوعًا ما. ما زال الغموض يلفّها

53
00:03:58,600 --> 00:04:00,000
!أنت مذهل يا لوفي

54
00:04:00,000 --> 00:04:04,000
اسمعوا. إن كانت هنالك
...جزيرة سماء بالفعل

55
00:04:04,300 --> 00:04:05,970
!سيكون ذلك المكان الوحيد الممكن

56
00:04:06,200 --> 00:04:09,140
!حسنًا، مفهوم! لنذهب فوق تلك السّحب

57
00:04:09,140 --> 00:04:10,270
!انهض يا زورو

58
00:04:10,270 --> 00:04:11,340
ماذا؟ أحلّ الصّباح؟

59
00:04:11,340 --> 00:04:14,510
!استعدّوا يا رفاق! أديروا الدّفّة للسّحب

60
00:04:14,510 --> 00:04:17,350
!شكرًا على المعلومات أيّها العمّ

61
00:04:17,650 --> 00:04:19,880
كم مرّة عليّ أن أقول أنّنا لا نعرف
!كيف نذهب إلى هناك؟

62
00:04:22,020 --> 00:04:23,350
.وهنا تبدأ المشكلة الحقيقيّة

63
00:04:23,350 --> 00:04:25,360
...دعوني أبدأ بقول هذا
!ضعوا حياتكم على المحكّ

64
00:04:25,360 --> 00:04:26,860
...نحن على شفير الموت سلفًا

65
00:04:27,190 --> 00:04:30,860
تيّار المحيط الصّاعد هو تيّار
...ينطلق في الهواء

66
00:04:30,860 --> 00:04:35,170
نظريًّا، بإمكانكم صعوده
نحو السّماء، مفهوم؟

67
00:04:35,170 --> 00:04:39,240
إنّه تيّار بإمكانه جعل سفينتنا
تحلّق نحو السّماء، صحيح؟

68
00:04:39,240 --> 00:04:42,140
!فهمت! عليه فقط أن يرسلنا فوق السّحب

69
00:04:42,870 --> 00:04:44,680
!مرحى

70
00:04:45,710 --> 00:04:47,110
على تيّار؟

71
00:04:47,110 --> 00:04:51,550
لكن ألن ينتهي بنا المطاف
محطّمين في المحيط؟

72
00:04:51,550 --> 00:04:55,120
.ذلك صحيح في العادة. التّوقيت هو الحلّ

73
00:04:55,120 --> 00:05:00,090
من السّهل الحديث عن التّحليق
،بواسطة التّيّار

74
00:05:00,590 --> 00:05:04,660
لكن لن تكون رحلة لطيفة
.كما تعتقدون يا رفاق

75
00:05:06,760 --> 00:05:10,200
.تيّار المحيط الصّاعد كارثة طبيعيّة

76
00:05:10,200 --> 00:05:13,200
!إنّه شيء يستدعي تجنّبه في العادة

77
00:05:14,910 --> 00:05:18,280
كيف يتصاعد تيّار مائيّ
!كهذا نحو السّماء عادة؟

78
00:05:18,280 --> 00:05:22,180
...لم نسمع أيّ شيء كهذا من قبل

79
00:05:22,750 --> 00:05:23,750
!نعم

80
00:05:25,750 --> 00:05:30,950
في العادة، بإمكاننا فقط أن نخمّن
.كيف يعمل ذلك التّيّار الوحشيّ

81
00:05:30,950 --> 00:05:34,220
لا يوجد من هو غبيّ كفاية
.ليقفز فيه ويكتشف الأمر

82
00:05:34,930 --> 00:05:36,190
!والنّظريّة المقبولة هي كالتّالي

83
00:05:40,500 --> 00:05:43,970
،عميقًا تحت قاع البحر
،ثمّة تجاويف ضخمة

84
00:05:43,970 --> 00:05:47,040
.وتتسرّب إليها مياه البحر الباردة

85
00:05:47,270 --> 00:05:51,040
وتحوّل الحرارة في باطن
،الأرض تلك المياه لبخار

86
00:05:51,040 --> 00:05:53,880
ويتسبّب الضّغط النّاجم
.بانفجار على قاع البحر

87
00:05:54,310 --> 00:06:00,380
انفجار كبير كفاية لإرسال مياه البحر
!محلّقة ويُنشئ تيّارًا نحو السّماء

88
00:06:03,020 --> 00:06:07,620
ويتواصل البحر بالصّعود نحو
.السّماء لحوالي دقيقة كاملة

89
00:06:07,620 --> 00:06:12,330
دقيقة واحدة؟! ما حجم الانفجار
!الّذي نتحدّث عنه هنا؟

90
00:06:14,870 --> 00:06:16,300
.ويحدث خمس مرّات في الشّهر

91
00:06:17,230 --> 00:06:19,870
!تريدنا أن ننفجر لأشلاء...؟

92
00:06:20,500 --> 00:06:21,840
...ولكن

93
00:06:22,340 --> 00:06:27,180
وصف ظاهرة طبيعيّة كبيرة
.بالكلمات والمنطق حماقة

94
00:06:27,180 --> 00:06:33,450
لـ-لذلك باختصار، علينا ركوب هذا التّيّار
الّذي يظهر خمس مرّات في الشّهر

95
00:06:33,450 --> 00:06:35,190
ونأمل أن يأخذنا لجزيرة السّماء؟

96
00:06:35,550 --> 00:06:43,290
نعم. وإن أخطأتموه، ستسقطون
...عائدين وتصطدمون بالمحيط

97
00:06:44,290 --> 00:06:47,000
.وسينتهي بكم الأمر في قاع البحر

98
00:06:48,600 --> 00:06:51,340
!حـ-حسنًا! لننس أمر جزيرة السّماء

99
00:06:53,700 --> 00:06:55,710
!هذا مستحيل

100
00:06:55,710 --> 00:07:01,010
عليك أن تملك أكبر حظّ
!قد يحظى به أيّ محظوظ

101
00:07:03,380 --> 00:07:05,520
!سنكون بخير! لنذهب

102
00:07:05,520 --> 00:07:06,120
وكيف لي أن أدري؟

103
00:07:06,620 --> 00:07:10,720
سنكون بخير"؟ كيف لك أن تقول"
...أمورًا لا أساس لها بسهولة

104
00:07:10,720 --> 00:07:13,620
!أعني، انظر لحال غوينغ ميري وستعرف

105
00:07:13,620 --> 00:07:16,160
!إنّها في حالة مزرية

106
00:07:16,160 --> 00:07:20,030
!لا يمكنها تحمّل كارثة ضخمة كهذه

107
00:07:20,030 --> 00:07:24,370
هذا صحيح. ما كانت تلك السّفينة
.أن تصمد وإن كانت في أحسن حال

108
00:07:24,670 --> 00:07:25,870
!ماذا؟

109
00:07:25,870 --> 00:07:28,040
...السّرعة والوزن والقوّة

110
00:07:28,040 --> 00:07:31,510
.ستُدمّر تلك السّفينة بسبب ذلك الانفجار

111
00:07:32,080 --> 00:07:36,250
!لكن... نعم! الأمر مستحيل بالفعل

112
00:07:36,450 --> 00:07:38,920
.لكن لا تقلقوا حيال ذلك

113
00:07:38,920 --> 00:07:42,350
سأطلب من ماسيرا وشوجو
.أن يساعداكم في الذّهاب

114
00:07:42,350 --> 00:07:45,220
.وذلك بعد تقوية سفينتكم بالطّبع

115
00:07:45,520 --> 00:07:47,960
!أجل! دعوا الأمر لنا فحسب

116
00:07:47,960 --> 00:07:49,230
!شكرًا لكما

117
00:07:49,530 --> 00:07:51,400
...لم يطلب رأينا حتّى

118
00:07:53,230 --> 00:07:55,230
!هل تدرك الأمر تمامًا؟

119
00:07:55,230 --> 00:07:55,730
أدرك ماذا؟

120
00:07:55,730 --> 00:07:57,670
!في البداية... أجل

121
00:07:57,670 --> 00:08:02,340
أطول مدّة يمكننا البقاء فيها على
!هذه الجزيرة هي يوم واحد فقط

122
00:08:02,340 --> 00:08:06,740
وبعد ذلك، ستبدأ اللوغ بوس
!بتسجيل مجال الجزيرة التّالية

123
00:08:06,740 --> 00:08:10,080
!نعم! نعم! لن ننجح في الوقت المناسب

124
00:08:10,080 --> 00:08:12,750
!كما أنّك لستَ عرّافًا أيّها العمّ

125
00:08:12,750 --> 00:08:14,950
أشكّ أنّك تعرف، ولكن كم يومًا أمامنا

126
00:08:14,950 --> 00:08:19,920
حتّى يتوافق تيّار المحيط الصّاعد
!والسّحب الملكيّة معًا؟

127
00:08:19,920 --> 00:08:24,930
!لا، لا! بل كم شهرًا؟! أو لنقل كم سنة؟

128
00:08:24,930 --> 00:08:28,200
!غدًا عصرًا. عليكم الاستعداد إن كنتم ذاهبين

129
00:08:28,200 --> 00:08:30,200
!لا يمكننا الاستعداد في ذلك الوقت

130
00:08:30,200 --> 00:08:33,170
!ماذا؟ انسوا الأمر إن كنتم مرتابين هكذا

131
00:08:35,440 --> 00:08:36,510
!أنت تكذب

132
00:08:37,270 --> 00:08:42,310
!هذا غير صائب! قابلناك للتّوّ
!ألا تتصرّف بلطف أكثر من اللاّزم؟

133
00:08:42,550 --> 00:08:44,080
...وأيضًا

134
00:08:44,410 --> 00:08:45,550
!تمهّل يا أوسوبّ

135
00:08:45,550 --> 00:08:46,650
!اخرس أنت

136
00:08:47,280 --> 00:08:50,090
شاءت الصّدف أن يكون
الغد أفضل فرصة

137
00:08:50,090 --> 00:08:54,290
للذّهاب إلى جزيرة السّماء
!الأسطوريّة المجهولة هذه؟

138
00:08:54,590 --> 00:08:58,930
كما ستساعدنا على تقوية سفينتنا
!وأخذنا إلى هناك؟

139
00:08:58,930 --> 00:09:00,430
!هذا مناسب أكثر من اللاّزم

140
00:09:00,430 --> 00:09:02,370
!ما الّذي تخطّط له بالتّحديد؟

141
00:09:02,830 --> 00:09:07,770
!كما أنّك سليل نولاند الكذّاب
!لا يمكننا أن نثق بك

142
00:09:11,270 --> 00:09:14,510
!أيّها العجوز! الطّعام جاهز

143
00:09:14,510 --> 00:09:15,310
!ابتعدا

144
00:09:15,580 --> 00:09:17,750
—نامي-سان! الطّعام

145
00:09:20,780 --> 00:09:23,220
!ما-ماذا؟! أتريد القتال؟

146
00:09:23,990 --> 00:09:27,290
،وقتما تأكّدنا من "ليلِ النّهار" في منطقة ماسيرا

147
00:09:27,290 --> 00:09:32,760
ستظهر السّحب الملكيّة في السّماء
.الجنوبيّة في اليوم التّالي

148
00:09:32,760 --> 00:09:35,100
،ونظرًا لمعدّل ظهوره خمس مرّات في الشّهر

149
00:09:35,100 --> 00:09:38,940
فإنّ تيّار المحيط الصّاعد سيكون
.نشطًا غدًا على الأرجح

150
00:09:39,600 --> 00:09:42,540
.سيحدث في مكان ما جنوبًا منّا

151
00:09:42,810 --> 00:09:47,680
الأمر ليس مؤكّدًا 100%، ولكن
.هنالك فرصة كبيرة بحدوثه غدًا

152
00:09:54,180 --> 00:09:58,160
.أنا سعيد بلقائي بحمقى مثلكم

153
00:10:00,460 --> 00:10:05,330
!لذلك، لنذهب ونأكل بعض الطّعام
...اعتبروا منزلي منزلكم اليوم

154
00:10:05,600 --> 00:10:06,900
!يا أصحاب

155
00:10:10,530 --> 00:10:12,570
!وقت الأكل! أسرع يا أوسوبّ

156
00:10:12,570 --> 00:10:13,800
!أجل! هيّا

157
00:10:13,800 --> 00:10:15,610
!تشوبّر! اذهب ونادي على روبين-تشان

158
00:10:15,610 --> 00:10:16,540
!حالاً

159
00:10:18,580 --> 00:10:22,680
يبدو أنّ كلّ ما بوسعنا فعله هو
...بذل جهدنا للذّهاب للسّماء

160
00:10:23,210 --> 00:10:25,150
.رغم أنّ الأمر منوط بالحظّ في النّهاية

161
00:10:25,380 --> 00:10:28,550
نامي. هل أنا بائس وجبان؟

162
00:10:28,820 --> 00:10:30,550
.أضف عليهما "غبيّ" أيضًا

163
00:10:30,790 --> 00:10:34,360
.أعرف كيف تشعر. اذهب واعتذر الآن

164
00:10:36,760 --> 00:10:39,460
!آسف أيّها العمّ

165
00:10:39,460 --> 00:10:43,200
!ما الّذي...؟! هذا مقرف
!لا تمسح أنفك بي أيّها الأحمق

166
00:10:49,270 --> 00:10:52,510
!طعم ساكي اليوم أفضل بكثير

167
00:10:52,510 --> 00:10:56,050
كلوا، كلوا! بدأت وجبة سمك
!الصّوري الكاملة للتّوّ

168
00:10:56,050 --> 00:10:56,510
!تفضّل

169
00:10:57,580 --> 00:11:00,250
!نلت منك يا غبيّ الإنقاذ
!إنّها قنبلة صلصة حارّة

170
00:11:01,020 --> 00:11:03,420
!أيّها الوغد طويل الأنف

171
00:11:04,820 --> 00:11:06,990
!يا فتاة! تعالي واجلسي قربي

172
00:11:06,990 --> 00:11:10,460
وغد! أمامك مائة عام أخرى حتّى
!تستطيع التّقرّب من نامي-سان

173
00:11:19,240 --> 00:11:21,240
...رأيتُ ذهبًا"

174
00:11:22,470 --> 00:11:24,210
"!في عين الجمجمة اليمنى

175
00:11:24,210 --> 00:11:24,710
!ذهب؟

176
00:11:28,510 --> 00:11:33,080
كانت تلك الجملة المغمورة
.بالدّموع آخر ما كتبه نولاند

177
00:11:33,920 --> 00:11:36,990
"...رأيتُ ذهبًا في عين الجمجمة اليمنى"

178
00:11:37,820 --> 00:11:40,460
.أُعدم نولاند في نفس ذلك اليوم

179
00:11:40,890 --> 00:11:44,900
،حتّى بعد المجيء إلى جايا
.كانت تلك الكلمات مجرّدة من المنطق

180
00:11:44,900 --> 00:11:46,730
"...عين الجمجمة اليمنى"

181
00:11:46,730 --> 00:11:50,030
هل يقصد اسم مدينة
كانت موجودة يومًا ما؟

182
00:11:50,030 --> 00:11:52,470
أو ربّما كانت تلميحًا لموته؟

183
00:11:52,840 --> 00:11:56,070
لم يُذكر شيء في الصّفحات
...الفارغة بعد ذلك

184
00:11:56,870 --> 00:11:58,940
!لذلك السّبب نغوص

185
00:11:58,940 --> 00:12:01,280
!فحُلمنا قابع في قاع البحر

186
00:12:02,550 --> 00:12:04,080
!هذا صحيح

187
00:12:06,450 --> 00:12:08,420
!سنحلّق

188
00:12:09,750 --> 00:12:12,060
!ليس إن واصلتَ الأكل هكذا

189
00:12:16,990 --> 00:12:20,700
.تأخّر الوقت كثيرًا، لكنّي أراه يا بيلامي

190
00:12:20,700 --> 00:12:22,330
.استعدّوا لنرسو

191
00:12:23,170 --> 00:12:26,600
يستحقّ الحمقى الّذين يطاردون
!الأحلام أكثر من مجرّد كدمات

192
00:12:42,650 --> 00:12:48,560
.يوم وصولي إلى جايا"
".سجلّ 21 مايو 1122

193
00:12:48,560 --> 00:12:50,760
!نولاند! نولاند

194
00:12:50,760 --> 00:12:53,890
،عندما رسونا على الجزيرة"
سمعنا نداءات طائر غريبة

195
00:12:53,890 --> 00:13:00,570
.وصوت جرس كبير صادر من الغابة

196
00:13:00,570 --> 00:13:06,240
إنّ صدى صوت ذلك الجرس الذّهبيّ
،الضّخم يتردّد بعيدًا وفي كلّ مكان

197
00:13:06,240 --> 00:13:10,740
وكأنّه يُعلن عن مدى ازدهار
!مدينة عريقة التّاريخ

198
00:13:11,310 --> 00:13:16,680
ظننّا أنّنا عرفنا كلّ شيء
"...بعد عيشنا لبضعة عقود

199
00:13:16,680 --> 00:13:19,250
!نولاند! نولاند

200
00:13:19,250 --> 00:13:23,690
لكنّ الوقت العابر الّذي اختبرناه"
من هذه الحضارة الّتي ازدهرت

201
00:13:23,690 --> 00:13:26,730
لوقت طويل في البحر الواسع
!تركنا عاجزين عن الكلام

202
00:13:27,030 --> 00:13:30,730
"!جعلَنا صوت الجرس نجمد في أماكننا

203
00:13:33,600 --> 00:13:35,570
!نولاند رائع جدًّا

204
00:13:36,600 --> 00:13:39,570
!مذهل! جرس ذهبيّ عملاق

205
00:13:39,570 --> 00:13:43,540
!مهلاً أيّها العمّ! أنت تحبّ نولاند بالفعل

206
00:13:45,210 --> 00:13:46,350
!انظروا لهذا

207
00:13:47,110 --> 00:13:48,480
!إنّها أجراس ذهبيّة

208
00:13:49,050 --> 00:13:51,390
لكن، كيف لهذه أن تكون عملاقة؟

209
00:13:52,420 --> 00:13:57,060
.هذه ليست ذلك الجرس
.إنّها سبائك ذهب

210
00:13:57,060 --> 00:13:58,890
.وجدنا هذه السّبائك الثّلاث في قاع البحر

211
00:13:58,890 --> 00:13:59,860
سبائك؟

212
00:13:59,860 --> 00:14:02,330
!هنالك مدينة ذهب بالفعل إذًا

213
00:14:02,330 --> 00:14:05,000
.إنّها لا تثبت ذلك

214
00:14:05,000 --> 00:14:08,840
بالإمكان العثور على ذهب كهذا
.في أيّ أطلال قديمة

215
00:14:09,270 --> 00:14:12,810
لكنّها تثبت بالفعل أنّه كانت هنالك
.حضارة في هذه المنطقة

216
00:14:13,210 --> 00:14:16,740
صُنعت السّبائك بغرض الحصول
.على أوزان موحّدة

217
00:14:17,210 --> 00:14:19,650
.ممّا يعني أنّها استُعملت للمقايضة

218
00:14:19,880 --> 00:14:23,650
نعم. ونداءات الطّائر الغريب
...الّتي ذكرتُها

219
00:14:23,650 --> 00:14:24,750
!يا ماسيرا

220
00:14:27,150 --> 00:14:28,620
!مذهل! ثمّة المزيد؟

221
00:14:28,620 --> 00:14:29,560
!هذه القطعة أكبر

222
00:14:29,920 --> 00:14:30,890
.هذا كلّ شيء

223
00:14:30,890 --> 00:14:32,960
!مذهلة! إنّها جميلة

224
00:14:33,360 --> 00:14:35,260
...أجراس ذهبيّة وطائر

225
00:14:35,260 --> 00:14:38,300
هل تعتقد أنّها كانت رموزًا لجايا القديمة؟

226
00:14:39,500 --> 00:14:43,270
لا أدري، لكن أعتقد
.أنّها كانت جزءًا من نموذج ما

227
00:14:43,770 --> 00:14:48,310
يُسمّى هذا طائر الجنوب، وهي طيور
!ما زالت تعيش على هذه الجزيرة

228
00:14:48,310 --> 00:14:50,610
هل لديها صوت غريب؟

229
00:14:50,610 --> 00:14:52,410
!نعم. كما ذُكر في السّجلّ تمامًا

230
00:14:52,710 --> 00:14:56,850
...استعمل البحّارة طائر الجنوب منذ

231
00:14:59,450 --> 00:15:01,260
!مصيبة

232
00:15:01,260 --> 00:15:02,820
!ما الأمر؟! ما الخطب؟

233
00:15:02,820 --> 00:15:06,360
هذا سيّئ! اذهبوا إلى الغابة
!فورًا يا رفاق! الغابة الجنوبيّة

234
00:15:06,730 --> 00:15:09,400
!ماذا؟! عمّ تتحدّث أيّها العمّ؟
!هل أنت مجنون؟

235
00:15:09,400 --> 00:15:12,200
!اذهبوا للإمساك بهذا الطّائر في الحال

236
00:15:12,200 --> 00:15:13,700
!لماذا؟! من أجل ماذا؟

237
00:15:13,700 --> 00:15:15,040
لماذا نحتاج هذا الطّائر؟

238
00:15:15,040 --> 00:15:20,140
اسمعوا جيّدًا! تيّار المحيط
الصّاعد الّذي ستقصدونه غدًا

239
00:15:20,140 --> 00:15:23,210
.موجود جنوب هذا الرّأس مباشرة

240
00:15:23,210 --> 00:15:25,010
كيف ستصلون إلى هناك؟

241
00:15:25,480 --> 00:15:27,650
سنبحر مباشرة إلى هناك، صحيح؟

242
00:15:27,650 --> 00:15:29,750
!نحن في الغراند لاين كما تعلم

243
00:15:29,750 --> 00:15:33,190
،بمجرّد دخولكم عرض البحر
!من المستحيل أن تعرفوا الاتّجاهات

244
00:15:33,190 --> 00:15:34,820
!هذا صحيح

245
00:15:34,820 --> 00:15:39,460
،نحن ذاهبون لنقطة ما في المحيط
!وليس جزيرة، لا مرشد لنعتمد عليه

246
00:15:39,460 --> 00:15:42,460
كيف نتّجه إلى الجنوب مباشرة؟

247
00:15:42,460 --> 00:15:45,800
!باستعمال تصرّف هذا الطّائر

248
00:15:46,170 --> 00:15:49,570
تملك بعض أنواع الحيوانات
مغانط داخليّة دقيقة

249
00:15:49,570 --> 00:15:51,940
.تسمح لها بالتّعرّف على الاتّجاهات

250
00:15:53,040 --> 00:15:55,410
!إذًا فأنت أقلّ شأنًا من الحيوانات يا زورو

251
00:15:55,640 --> 00:15:57,910
!وكأنّه يحقّ لك أنت الكلام

252
00:15:58,280 --> 00:16:01,110
طيور الجنوب هي الأفضل
!بين هذه الحيوانات

253
00:16:03,250 --> 00:16:06,490
مهما كانت الأرض أو البحر
،الّذي توجد فيها واسعًا

254
00:16:06,490 --> 00:16:10,360
فإنّ أجسادها ستشير دائمًا
.للاتّجاه الصّحيح

255
00:16:12,060 --> 00:16:15,260
على أيّ حال، بدون إحدى هذه
!الطّيور، فلن تستطيعوا الذّهاب

256
00:16:15,260 --> 00:16:18,830
لن تحصلوا حتّى على فرصة
!للذّهاب لجزيرة السّماء

257
00:16:18,830 --> 00:16:20,300
!ماذا؟

258
00:16:20,300 --> 00:16:22,370
!لماذا تخبرنا بذلك الآن؟

259
00:16:23,040 --> 00:16:24,370
!كفاكم جدالاً

260
00:16:25,040 --> 00:16:28,180
!لا وقت أمامنا! لا تماطلوا

261
00:16:28,480 --> 00:16:31,150
تريدنا أن نذهب للغابة
!في منتصف اللّيل؟

262
00:16:31,150 --> 00:16:32,410
!لا تنسوا هذه

263
00:16:34,380 --> 00:16:37,920
!سنبدأ نحن بترميم سفينتكم المتهالكة

264
00:16:37,920 --> 00:16:41,360
،بالتّفكير في الأمر
!لم يكن لدينا وقت للاحتفال

265
00:16:41,360 --> 00:16:43,290
ولماذا تخبرنا بهذا الآن؟

266
00:16:43,490 --> 00:16:48,930
اسمعوا! احرصوا على إمساك طائر
!جنوب واحد على الأقلّ قبل الفجر

267
00:16:50,160 --> 00:16:51,370
!الظّلام حالك

268
00:16:51,370 --> 00:16:53,470
!كفّ عن سحبي

269
00:16:54,200 --> 00:16:57,870
!ليست غلطتي! تتحرّك يداي من تلقاء نفسها

270
00:16:58,240 --> 00:17:02,840
معدتي ممتلئة... لا أعتقد
...أنّ بإمكاني مطاردة الطّيور

271
00:17:02,840 --> 00:17:05,450
!أين هي هذه الطّيور الغريبة؟

272
00:17:05,780 --> 00:17:08,180
لنمسك بإحداها لنستطيع
!العودة للشّرب

273
00:17:08,450 --> 00:17:10,650
!كيف انتهى بنا الأمر نقوم بهذا فجأة؟

274
00:17:11,190 --> 00:17:12,490
!ابتعد عنّي

275
00:17:12,490 --> 00:17:15,120
!ألم يكن بمقدوره إخبارنا خلال النّهار؟

276
00:17:15,720 --> 00:17:16,990
أخبرني، أين الطّيور؟

277
00:17:16,990 --> 00:17:20,460
،إن كنّا نعرف أين هي
!ما كنّا لنبحث عنها

278
00:17:20,760 --> 00:17:23,200
...دليلنا الوحيد هو صرخاتها الغريبة

279
00:17:23,200 --> 00:17:26,200
...وتبدو مثل ذلك التّمثال الذّهبيّ

280
00:17:26,200 --> 00:17:29,770
هل هنالك طائر غبيّ المظهر
!كذاك بالفعل؟

281
00:17:29,770 --> 00:17:33,670
!كما أنّ "صرخة غريبة" هو وصف غامض
!كيف يفترض بنا أن نعرف؟

282
00:17:33,670 --> 00:17:37,140
...قال أنّنا سنعرف بمجرّد دخولنا الغابة

283
00:17:39,950 --> 00:17:41,450
!صرخة غريبة

284
00:17:41,450 --> 00:17:42,420
!هذه هي

285
00:17:42,650 --> 00:17:43,520
!حسنًا

286
00:17:43,720 --> 00:17:46,090
!لا خيار آخر أمامنا الآن

287
00:17:46,090 --> 00:17:48,720
لدينا ثلاث شبكات. لذا سننفصل
!إلى ثلاث مجموعات ونبحث

288
00:17:48,720 --> 00:17:49,690
!أجل

289
00:17:49,690 --> 00:17:54,060
!هيّا بنا! لنوسع تلك الطّيور ضربًا

290
00:17:54,060 --> 00:17:55,960
!تقصد لنمسك بها

291
00:18:02,070 --> 00:18:05,840
،لا تقلقي! مهما كان ما سنلقاه
!فسأحميك يا نامي-سان

292
00:18:05,840 --> 00:18:07,440
!ماذا عنّي يا سانجي-كُن؟

293
00:18:07,440 --> 00:18:09,740
!لا أهتمّ لأمرك
!كفّ عن التّصرّف بقلّة ثقة

294
00:18:09,740 --> 00:18:13,380
في كلّ الأحوال، لنمسك بالطّائر
!لنتمكّن من مغادرة هذه الغابة

295
00:18:13,710 --> 00:18:18,420
لنبدأ بالإصغاء جيّدًا لصرخة
.الطّائر الّتي سمعناها قبل قليل

296
00:18:20,290 --> 00:18:21,290
!تلك هي

297
00:18:21,290 --> 00:18:24,090
!جيو! اخرج! جيو

298
00:18:24,090 --> 00:18:24,560
!وغد

299
00:18:26,990 --> 00:18:28,700
!لماذا تمسك بي أنا؟

300
00:18:28,700 --> 00:18:32,170
!نامي! ذلك الشّيء الّذي عليك رائع
!من أين حصلتِ عليه؟

301
00:18:32,170 --> 00:18:33,530
ماذا؟

302
00:18:36,900 --> 00:18:38,340
!عنكبوت

303
00:18:38,710 --> 00:18:41,610
!إنّه مجرّد عنكبوت
!أيّها المسكين... تعال

304
00:18:41,910 --> 00:18:45,610
!العناكب مقرفة أيّها الغبيّ
!ارمه بعيدًا من هنا

305
00:18:45,610 --> 00:18:48,680
!ابتعد عنه يا أوسوبّ! لا بدّ أنّه سامّ

306
00:18:49,520 --> 00:18:51,250
!إنّها تسقط من الأشجار

307
00:18:51,590 --> 00:18:53,090
!هذا مقرف جدًّا

308
00:18:53,520 --> 00:18:55,890
!لا بدّ أنّها من فصيلة الرّتيلاء

309
00:18:55,890 --> 00:18:59,790
لا بأس! لن تقذفنا بأيّ سمّ
!ما دمنا لن نفعل لها أيّ شيء

310
00:18:59,790 --> 00:19:01,900
!اعتدت أن أقاتل العناكب في الماضي

311
00:19:01,900 --> 00:19:05,800
كلاّ، لا تعتمد عليّ أبدًا عندما يتعلّق
!الأمر بالحشرات المقزّزة مثلها

312
00:19:06,130 --> 00:19:09,970
!وأنا أيضًا! أكرهها بالكامل
!بالكامل! أسرع وارمه بعيدًا

313
00:19:10,900 --> 00:19:14,170
ولكن ألا تنزعجون
من ذلك العثّ والحريش؟

314
00:19:23,280 --> 00:19:24,820
!أكره العثّ والحريش

315
00:19:25,850 --> 00:19:28,160
!كلاّ! لا تتركوني وحدي

316
00:19:30,590 --> 00:19:32,060
...أسمع صرخات

317
00:19:32,060 --> 00:19:32,890
.انسي أمرهم

318
00:19:37,870 --> 00:19:40,430
...حريش؟ إنّه ضخم

319
00:19:40,830 --> 00:19:44,040
.ليس من اللّطيف قتل كلّ شيء
...يا لذلك المسكين

320
00:19:44,570 --> 00:19:46,670
.هذا ما يستحقّه لمحاولته الهجوم عليّ

321
00:19:47,910 --> 00:19:48,840
...لكن

322
00:19:48,840 --> 00:19:49,880
!ماذا؟

323
00:19:50,140 --> 00:19:52,110
.أتينا من هناك للتّوّ

324
00:19:55,280 --> 00:19:57,380
.إنّها صرخة الطّائر... مِن هنا

325
00:19:58,620 --> 00:20:00,690
.انتبه للمستنقع

326
00:20:02,390 --> 00:20:04,320
!...مهلاً! انتظري

327
00:20:08,860 --> 00:20:10,060
!أمسكتك

328
00:20:10,400 --> 00:20:12,570
!انظر يا تشوبّر! إنّها أطلس

329
00:20:12,570 --> 00:20:13,570
أطلس؟

330
00:20:13,570 --> 00:20:14,670
!نعم

331
00:20:14,670 --> 00:20:18,540
خنافس أطلس وهرقل من أكثر الحشرات
!الّتي تحظى بالإعجاب في العالم

332
00:20:18,840 --> 00:20:21,010
فعلاً؟ الخنافس؟

333
00:20:21,010 --> 00:20:23,910
!ألم تسمع بها من قبل؟
!الإمساك بها صعب جدًّا

334
00:20:23,910 --> 00:20:26,250
!أيّهما أفضل، هي أم "ون بيس"؟

335
00:20:27,250 --> 00:20:28,380
!خيار صعب

336
00:20:28,650 --> 00:20:31,080
!لوفي! ثمّة واحدة هنا أيضًا

337
00:20:31,080 --> 00:20:33,090
!إنّها خنفساء الأيل

338
00:20:33,590 --> 00:20:34,960
!أمسكها

339
00:20:36,320 --> 00:20:37,690
!لقد طارت

340
00:20:37,690 --> 00:20:38,530
!...تعالي

341
00:20:41,160 --> 00:20:43,960
!خلفها! لا تدعها تهرب

342
00:20:45,070 --> 00:20:47,530
!خليّة نحل! اهرب

343
00:21:00,550 --> 00:21:02,520
!ما قصّة هذه الغابة؟

344
00:21:03,680 --> 00:21:05,190
!لوفي! انظر هناك

345
00:21:05,190 --> 00:21:06,150
!إنّه ذلك الطّائر

346
00:21:06,150 --> 00:21:08,190
!لقد أوقع خليّة النّحل

347
00:21:10,690 --> 00:21:12,530
!ماذا؟ هل قال شيئًا ما؟

348
00:21:14,330 --> 00:21:17,500
"!قال، "سأقتلكم لاقتحامكم هذه الغابة

349
00:21:29,280 --> 00:21:33,280
!مهلاً، مهلاً يا فتى! لا تثر غضبنا

350
00:21:33,280 --> 00:21:37,420
ليس من اللّطيف الظّهور ليلاً هكذا
!والمطالبة بالذّهب يا أطفال

351
00:21:38,290 --> 00:21:41,560
!غادروا! لدينا عمل لننهيه

352
00:21:43,560 --> 00:21:45,330
هل أنتما حارساه؟

353
00:21:45,330 --> 00:21:48,530
بالتّفكير في الأمر، كان هنالك
...قرصان اسمه كريكت بالفعل

354
00:21:48,800 --> 00:21:52,570
سمعتُ قصّة عائلة مونبلان
.الحزينة في الحانة

355
00:21:52,570 --> 00:21:53,970
.لقد أثّرت بي

356
00:21:54,470 --> 00:21:59,870
الكنوز الّتي كافح أحد آخر للحصول
!عليها لديها طعم خاصّ بها

357
00:22:00,270 --> 00:22:03,840
أتريدون معرفة بماذا يصفني الآخرون؟

358
00:22:03,840 --> 00:22:05,410
!الضّبع

359
00:22:09,550 --> 00:22:17,450
آه، خلف السّماء الّتي لا نهاية لها

360
00:22:17,450 --> 00:22:28,060
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

361
00:22:35,940 --> 00:22:43,380
مرّت عليّ أيّام كدت أخسر فيها نفسي

362
00:22:43,380 --> 00:22:51,790
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

363
00:22:51,790 --> 00:23:00,000
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

364
00:23:00,000 --> 00:23:08,840
دفعوا بي للأمام، أليس كذلك؟

365
00:23:08,840 --> 00:23:17,150
آه، إنّ النّجوم تهوي من السّماء

366
00:23:17,150 --> 00:23:20,280
...وهذه اللّحظة الفريدة

367
00:23:25,590 --> 00:23:27,560
!أيّها العمّ! أمسكنا بالطّائر

368
00:23:27,560 --> 00:23:28,530
!ما-ماذا حدث؟

369
00:23:28,530 --> 00:23:29,430
!أيّها العمّ ذو الرّأس الماسيّ؟

370
00:23:29,430 --> 00:23:31,090
!آ-آسف

371
00:23:31,800 --> 00:23:34,200
!لم يكن بوسعنا فعل أيّ شيء
!كنّا بلا حول ولا قوّة

372
00:23:34,200 --> 00:23:35,930
!سُرق الذّهب أيضًا

373
00:23:35,930 --> 00:23:38,370
!لا بأس! انسوا أمر تلك الخردة

374
00:23:38,370 --> 00:23:39,700
!شعار بيلامي

375
00:23:39,700 --> 00:23:40,770
!سأعود في الصّباح

376
00:23:41,470 --> 00:23:42,870
:في الحلقة القادمة من ون بيس

377
00:23:42,870 --> 00:23:46,110
!الأحلام لا تتحقّق؟"
".بيلامي ضدّ تحالف ساروياما

378
00:23:46,110 --> 00:23:48,280
!ملك القراصنة، لن يكون إلاّ أنا