1
00:00:40,430 --> 00:00:45,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,520 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,190 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:59,030 --> 00:01:01,790
"وأقول "أريد أن أصير أقوى

5
00:01:01,950 --> 00:01:07,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,370 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,510 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,090 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,810
هيّا بنا

10
00:01:25,890 --> 00:01:29,110
دون توقّف

11
00:01:29,230 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,490 --> 00:01:39,910
سأواصل النّهوض على قدميّ

13
00:01:40,030 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,540 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,880 --> 00:01:56,010
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,390 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,390 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,810 --> 00:02:14,980
دون توقّف

21
00:02:15,110 --> 00:02:20,160
دون استسلام لمرور الوقت

22
00:02:20,280 --> 00:02:25,830
سأواصل النّهوض على قدميّ

23
00:02:26,000 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,590 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:34,470 --> 00:03:37,100
،بعد انفصال لوفي عن بقيّة طاقم قبّعة القشّ

38
00:03:37,100 --> 00:03:42,460
اندفع نحو مقرّ البحريّة لإنقاذ أخيه
.إيس الّذي أوشك موعد إعدامه

39
00:03:48,970 --> 00:03:50,090
!مستحيل

40
00:03:53,330 --> 00:03:57,250
.أظنّه سيظهر من آخر مكان نتوقّعه

41
00:03:57,250 --> 00:03:59,040
.ربّما جهّزنا التّشكيلة الخطأ

42
00:04:02,070 --> 00:04:04,050
!أرى ظلاًّ في الخليج

43
00:04:04,480 --> 00:04:07,820
...فهمت الآن! إنّ جميع سفنهم

44
00:04:08,490 --> 00:04:11,520
!مغلّفة واقتربت منّا من تحت البحر

45
00:04:23,250 --> 00:04:25,830
!ها هي السّفينة موبي ديك

46
00:04:39,240 --> 00:04:43,540
"!بداية الحرب! ماضي إيس واللّحية البيضاء"

47
00:04:55,490 --> 00:04:56,580
!مستحيل

48
00:04:56,580 --> 00:04:58,010
ثمّة المزيد؟

49
00:05:03,200 --> 00:05:06,730
!هـ-هنالك ثلاثة سفن أخرى لقراصنة اللّحية البيضاء

50
00:05:11,820 --> 00:05:13,830
!لقد تسلّلوا للخليج

51
00:05:16,600 --> 00:05:18,080
...ذ-ذاك هو

52
00:05:18,600 --> 00:05:20,610
!قائد الوحدة الأولى ماركو

53
00:05:22,390 --> 00:05:24,470
...ثمّة 14 قائدًا

54
00:05:25,170 --> 00:05:26,600
!لقد حضروا جميعًا

55
00:06:08,740 --> 00:06:11,440
.لم أرك منذ مدّة يا سنغوكو

56
00:06:11,990 --> 00:06:13,440
.اللّحية البيضاء

57
00:06:14,020 --> 00:06:16,350
...من الأفضل أن يكون ابني العزيز

58
00:06:17,340 --> 00:06:19,230
.على خير ما يرام

59
00:06:31,360 --> 00:06:33,880
!لا أصدّق أنّنا سمحنا لهم بالاقتراب لهذا الحدّ

60
00:06:40,710 --> 00:06:42,930
...لقد عبرنا البوّابة، ولكن

61
00:06:42,930 --> 00:06:48,490
.ما أنا قلق بشأنه هو هل سيكون أبوكما هنا أم لا

62
00:06:48,570 --> 00:06:49,300
أبونا"؟"

63
00:06:49,690 --> 00:06:54,480
...لا أعتقد أنّ دراغون سيسمح لهم بقتل ابنه

64
00:06:54,720 --> 00:06:57,470
.صحيح، أبي وأبو إيس ليسا نفس الشّخص

65
00:06:59,240 --> 00:07:01,680
،أبي هو دراغون

66
00:07:01,680 --> 00:07:04,700
.بينما أبو إيس هو غولد روجر

67
00:07:06,690 --> 00:07:09,540
.كان أبوه عظيمًا، لكنّه لم يقابله أبدًا

68
00:07:10,130 --> 00:07:12,330
.كان يغضب في كلّ مرّة أذكر ذلك

69
00:07:13,680 --> 00:07:15,590
.ربّما ما كان عليّ قول هذا

70
00:07:30,460 --> 00:07:33,310
.أمهلني لحظة يا إيس

71
00:07:39,680 --> 00:07:41,620
!يا والدي

72
00:08:01,100 --> 00:08:02,400
!ما-ما هذا؟

73
00:08:02,400 --> 00:08:03,880
أحدث صدوعًا في الهواء؟

74
00:08:15,050 --> 00:08:17,280
!ما مصدر ذلك الانفجار؟

75
00:08:17,280 --> 00:08:19,850
!هذا سيّئ! سطح الماء مرتفع جدًّا

76
00:08:20,020 --> 00:08:23,390
!زلزال بحريّ! إنّه يشوّه البحر

77
00:08:24,070 --> 00:08:25,650
!في الجانب الآخر أيضًا

78
00:08:25,940 --> 00:08:27,990
!هذه هي قوّة اللّحية البيضاء

79
00:08:44,660 --> 00:08:46,360
!سأغادر أوّلاً

80
00:08:51,950 --> 00:08:53,720
!اعتنِ بنفسك يا إيس

81
00:08:53,880 --> 00:08:56,420
!أكيد. إلى اللّقاء يا لوفي

82
00:08:56,580 --> 00:08:57,320
!نعم

83
00:08:57,320 --> 00:09:02,140
سأكون أقوى بكثير عندما سأغادر
!بعد ثلاث سنوات

84
00:09:02,280 --> 00:09:03,350
!أكيد

85
00:09:04,990 --> 00:09:07,090
!إيس

86
00:09:16,490 --> 00:09:18,430
!سأريهم كيف تسير الأمور

87
00:09:20,350 --> 00:09:23,340
!ذلك الوغد! صار قرصانًا

88
00:09:23,530 --> 00:09:26,420
!إنّهم قراصنة! لم أر علمهم من قبل

89
00:09:33,460 --> 00:09:37,050
.إنّه قرصان أصبح قويًّا جدًّا بسرعة مؤخّرًا

90
00:09:37,280 --> 00:09:39,530
د"؟ من أين هو؟"

91
00:09:39,530 --> 00:09:42,180
لا يمكننا معرفة ذلك بالتّحديد

92
00:09:42,180 --> 00:09:44,360
.لكنّه يملك قوّة لوغيا مع أنّه ناشئ

93
00:09:47,030 --> 00:09:51,060
.يا له من شابّ مندفع في الغراند لاين

94
00:09:51,060 --> 00:09:53,730
.لقد رفض عرض الانضمام للشّيتشيبوكاي

95
00:09:54,130 --> 00:09:56,920
منذ متى وهو على هذا الحال؟

96
00:09:56,920 --> 00:09:58,210
.ما زالوا يافعين

97
00:09:58,900 --> 00:10:01,460
.ليس عليهم الاستعجال

98
00:10:02,360 --> 00:10:04,790
أأنت واثق يا قبطان؟

99
00:10:05,080 --> 00:10:06,420
...عليّ أن أقابله

100
00:10:06,910 --> 00:10:08,510
.شانكس أحمر الشّعر

101
00:10:10,220 --> 00:10:12,050
قراصنة سبِيْد؟

102
00:10:12,870 --> 00:10:16,930
أتى النّاشئ الخارق ذائع الصّيت
ليلقي التّحيّة عليّ؟

103
00:10:17,830 --> 00:10:19,640
.ليس الأمر كما تظنّ

104
00:10:20,430 --> 00:10:24,340
إنّ أخي لا يكفّ عن الحديث عن إنقاذك لحياته

105
00:10:24,340 --> 00:10:26,600
.لذلك أردت المجيء لشكرك

106
00:10:26,600 --> 00:10:27,770
أنت أخو لوفي؟

107
00:10:27,920 --> 00:10:30,520
.ماذا؟ لم أكن أعرف أنّ له أخًا

108
00:10:31,010 --> 00:10:33,540
!هكذا إذًا، سررت بلقائك

109
00:10:33,700 --> 00:10:35,470
!أخبرني كلّ شيء عنك

110
00:10:36,220 --> 00:10:37,630
!لنقم وليمة

111
00:10:42,370 --> 00:10:46,550
إذًا فما زال يتحدّث عن حلمه
بأن يصير ملك القراصنة؟

112
00:10:46,760 --> 00:10:48,580
.أظنّها جملته المفضّلة

113
00:10:51,720 --> 00:10:53,220
...لكنّي أشعر بالسّوء حياله

114
00:10:54,150 --> 00:10:56,210
.فأنا من سيصير ملك القراصنة التّالي

115
00:10:56,210 --> 00:10:58,710
فعلاً؟ أتظنّ ذلك؟

116
00:10:59,070 --> 00:11:02,640
.أوّلاً، سأدع العالم بأسره يعرف ما مدى قوّتي

117
00:11:02,820 --> 00:11:05,310
فعلاً؟ كيف ستفعل ذلك؟

118
00:11:05,770 --> 00:11:09,230
!عن طريق هزيمة أقوى رجل في العالم

119
00:11:09,430 --> 00:11:11,130
تقصد اللّحية البيضاء؟

120
00:11:14,120 --> 00:11:17,360
أيّها الضّخم، أريد رؤية الرّجل
.المدعوّ اللّحية البيضاء

121
00:11:17,530 --> 00:11:22,500
!لا يمكنني تقديم شابّ يافع ماكر مثلك للوالد

122
00:11:22,630 --> 00:11:24,640
!أيّها القبطان، إنّه جينبي

123
00:11:24,640 --> 00:11:26,830
ماذا؟ أنت شيتشيبوكاي؟

124
00:11:27,820 --> 00:11:29,930
.سأحصل على بعض الهيبة بهزيمته

125
00:11:30,480 --> 00:11:33,700
أنا لستُ جزءًا من قراصنة اللّحية البيضاء

126
00:11:34,120 --> 00:11:36,290
!لكنّني مدين له، لذلك سأقاتلك

127
00:11:47,120 --> 00:11:51,060
.مرّت خمسة أيّام مذ بدؤوا القتال

128
00:11:51,060 --> 00:11:53,020
!سيموت كلاهما

129
00:12:05,540 --> 00:12:07,720
!إيس

130
00:12:15,940 --> 00:12:17,510
!ما هذا؟

131
00:12:18,210 --> 00:12:22,090
من منكم يودّ قتلي؟

132
00:12:24,980 --> 00:12:29,150
.سأقاتلهم كما يحبّون

133
00:12:30,700 --> 00:12:32,690
!قراصنة اللّحية البيضاء

134
00:12:33,690 --> 00:12:36,380
.سأقاتلكم بمفردي

135
00:12:45,420 --> 00:12:47,120
!يا رفاق

136
00:12:47,880 --> 00:12:49,780
!سياج اللّهب

137
00:12:51,610 --> 00:12:52,480
!أيّها القبطان

138
00:12:52,480 --> 00:12:54,490
!ماذا تفعل أيّها القبطان إيس؟

139
00:12:54,670 --> 00:12:56,100
!اهربوا أنتم

140
00:12:56,310 --> 00:12:57,910
!أيّها القبطان

141
00:12:59,920 --> 00:13:03,380
ما الأمر؟ هل تتراجع أخيرًا؟

142
00:13:03,750 --> 00:13:07,270
...دع طاقمي يذهب. وفي المقابل

143
00:13:07,270 --> 00:13:08,440
!سأظلّ أنا

144
00:13:09,460 --> 00:13:10,850
!أيّها الغرّ

145
00:13:11,000 --> 00:13:12,810
!يا لصفاقتك

146
00:13:38,280 --> 00:13:42,070
.إذًا فهذا هو الرّجل الّذي صارعه على السّيادة

147
00:13:47,120 --> 00:13:48,260
...لن

148
00:13:51,000 --> 00:13:52,600
ما زالت تودّ القتال؟

149
00:13:55,380 --> 00:13:58,110
.إنّك أكثر قيمة من أن تكون الآن يا فتى

150
00:13:59,190 --> 00:14:01,160
،إن كنت ما زلت تريد إطلاق عنانك

151
00:14:01,160 --> 00:14:05,580
.فافعل ذلك بقدر ما يحلو لك تحت رايتي

152
00:14:10,680 --> 00:14:12,380
!اغدُ ابني

153
00:14:13,240 --> 00:14:15,360
!سُحقًا لك

154
00:15:04,330 --> 00:15:05,330
!أنت

155
00:15:06,200 --> 00:15:08,260
.أنا قائد الوحدة الرّابعة

156
00:15:10,160 --> 00:15:11,210
.اسمي ثاتش

157
00:15:12,720 --> 00:15:13,980
،إن كنت ستنضمّ لنا

158
00:15:16,060 --> 00:15:17,430
!فعلينا أن نصير صديقين

159
00:15:17,680 --> 00:15:18,800
!اخرس

160
00:15:21,100 --> 00:15:23,230
إذًا يكون مزاجك سيّئًا عندما تستيقظ؟

161
00:15:23,480 --> 00:15:27,190
صحيح، تريد معرفة ما حدث بعد فقدانك للوعي؟

162
00:15:28,060 --> 00:15:31,230
عاد طاقمك لأخذك

163
00:15:31,550 --> 00:15:33,760
.لذلك هزمناهم شرّ هزيمة

164
00:15:34,250 --> 00:15:37,760
.لكنّهم ليسوا أمواتًا. إنّهم على السّفينة أيضًا

165
00:15:39,410 --> 00:15:42,790
ألا يجدر بكم تقييدي بالسّلاسل أو الأصفاد؟

166
00:15:42,790 --> 00:15:45,970
!أصفاد؟ لسنا بحاجتها

167
00:16:08,050 --> 00:16:10,720
!على مهلك! ما الّذي تفعله؟

168
00:16:10,720 --> 00:16:12,780
أتعرف كم السّاعة الآن؟

169
00:16:27,700 --> 00:16:29,490
!لقد سقط عن السّفينة

170
00:16:29,490 --> 00:16:30,810
.لا يمكنه السّباحة

171
00:16:30,810 --> 00:16:32,550
.ليساعده أحد ما

172
00:16:35,120 --> 00:16:36,860
.يومًا تلو يوم

173
00:16:37,120 --> 00:16:39,480
.أعترف بشجاعته

174
00:16:41,100 --> 00:16:42,510
لا بدّ أنّها محاولته المائة الآن؟

175
00:16:42,510 --> 00:16:43,820
.أظنّ ذلك

176
00:17:00,620 --> 00:17:01,700
...لماذا

177
00:17:02,980 --> 00:17:05,530
تنادونه "والدي" جميعكم؟

178
00:17:08,610 --> 00:17:12,610
."لأنّه ينادينا "أبنائي

179
00:17:14,100 --> 00:17:17,260
.يكرهنا العالم جميعنا

180
00:17:18,120 --> 00:17:19,560
.لذا فذلك يسعدنا

181
00:17:19,930 --> 00:17:21,330
.أعلم أنّها مجرّد كلمة

182
00:17:22,570 --> 00:17:23,870
.لكنّها تسعدنا رغم ذلك

183
00:17:32,570 --> 00:17:37,000
أستواصل القيام بهذا بعد أن نجوت بحياتك؟

184
00:17:37,940 --> 00:17:39,750
.عليك اتّخاذ قرارك

185
00:17:40,630 --> 00:17:43,710
.لستَ قادرًا على قتله

186
00:17:44,930 --> 00:17:47,520
...فإمّا أن نغادر هذه السّفينة وتبدأ من جديد

187
00:17:49,280 --> 00:17:50,700
...أو تظلّ هنا

188
00:17:53,050 --> 00:17:55,640
!وتحمل رمز اللّحية البيضاء على ظهرك

189
00:18:03,260 --> 00:18:04,850
هل أنت دوما؟

190
00:18:10,310 --> 00:18:12,470
!فعلها إيس ثانية

191
00:18:12,470 --> 00:18:15,490
!جعل دوما وطاقمه يستسلمون وحده

192
00:18:15,960 --> 00:18:17,980
تريدون منّي قيادة الوحدة الثّانية؟

193
00:18:18,300 --> 00:18:21,050
.كان منصب القائد شاغرًا لمدّة
...إن شغلته أنت

194
00:18:21,050 --> 00:18:22,320
.فلن يعترض أحد على ذلك

195
00:18:25,460 --> 00:18:29,210
أنت أحد الأعضاء الأصليّين، صحيح؟
ألا تمانع هذا على الإطلاق؟

196
00:18:31,000 --> 00:18:33,090
.لا بأس، لا داعي للقلق

197
00:18:33,370 --> 00:18:36,130
.ليس لي طموح كهذا

198
00:18:37,550 --> 00:18:40,470
!قم بذلك من أجلنا أيّها القائد إيس

199
00:19:04,840 --> 00:19:07,080
يا والدي، ألديك بعض الوقت؟

200
00:19:12,150 --> 00:19:14,500
.حسنًا، كان ذلك مفاجئًا

201
00:19:14,500 --> 00:19:16,220
.لم أعلم ذلك

202
00:19:18,800 --> 00:19:21,390
.لا تشبه شخصيّتك روجر على الإطلاق

203
00:19:22,970 --> 00:19:26,390
كان عدوّك، صحيح؟ ألا تريد طردي؟

204
00:19:26,670 --> 00:19:31,820
.قلتَ أنّ الأمر مهمّ لكن اتّضح العكس

205
00:19:33,130 --> 00:19:37,150
.لا يهمّ من يكون أبوك، فجميعنا أبناء البحر

206
00:19:46,470 --> 00:19:49,740
!سيصير إيس قائدًا لوحدتنا الثّانية

207
00:19:55,240 --> 00:19:58,590
!أنت نجم الآن، فلا تنبهر. خذ

208
00:20:12,770 --> 00:20:13,700
!خذ

209
00:20:21,750 --> 00:20:25,580
،على مهلك، لا داعي للعجلة
.ثمّة ما يكفي من الطّعام

210
00:20:25,580 --> 00:20:27,880
...وأنت نجم هذه الوليمة

211
00:20:32,280 --> 00:20:33,620
!غطّ في النّوم

212
00:20:36,960 --> 00:20:40,260
.ضمّ اللّحية البيضاء ناشئًا قويًّا آخر

213
00:20:40,620 --> 00:20:42,640
!سمعتُ أنّه قويّ للغاية

214
00:20:50,870 --> 00:20:52,750
!أتت الوحدة الثّانية لمساعدتنا

215
00:20:56,130 --> 00:20:56,920
!إيس

216
00:20:56,920 --> 00:20:58,100
ثاتش، أأنت بخير؟

217
00:20:58,100 --> 00:21:00,110
!نعم. شكرًا لك

218
00:21:05,360 --> 00:21:07,440
!سترتفع مكافأتك ثانية

219
00:21:07,440 --> 00:21:08,500
.على الأرجح

220
00:21:08,500 --> 00:21:10,920
.إيس، عثرت على شيء مثير للاهتمام

221
00:21:11,260 --> 00:21:13,660
ماذا؟ أتلك فاكهة شيطان؟

222
00:21:13,660 --> 00:21:16,300
.لا أعرف أيّ نوع من الفاكهة بعد

223
00:21:33,930 --> 00:21:36,810
!توقّف يا إيس، هدّئ من روعك

224
00:21:37,160 --> 00:21:39,920
.قال والدي أنّ هذا استثناء

225
00:21:39,920 --> 00:21:41,520
!ليس عليك السّعي خلف تيتش

226
00:21:41,520 --> 00:21:44,610
!دعني! ما زلتُ قائده

227
00:21:45,110 --> 00:21:49,040
!إن لم أفعل أيّ شيء، فلن ترتاح روح ثاتش

228
00:21:49,720 --> 00:21:50,820
.إيس

229
00:21:52,880 --> 00:21:56,200
.لا بأس. هذا استثناء

230
00:21:56,910 --> 00:21:59,460
.يراودني شعور سيّئ حيال هذا

231
00:22:00,250 --> 00:22:03,010
!قتل زميله في الطّاقم وهرب

232
00:22:03,370 --> 00:22:05,800
إنّه يدين لك بالكثير لعقود من الزّمن

233
00:22:05,800 --> 00:22:08,180
!ولكنّه ردّ على النّعمة بالإهانة

234
00:22:10,130 --> 00:22:12,620
وفوق كلّ ذلك، ألحق العار باسم والدي

235
00:22:13,370 --> 00:22:15,030
.وهذا ما لن أسمح به

236
00:22:15,770 --> 00:22:17,780
!سأهتمّ بهذا الأمر

237
00:22:23,690 --> 00:22:25,870
!مهلاً! انتظر! عد يا إيس

238
00:22:42,060 --> 00:22:43,460
هل انتهى الأمر؟

239
00:22:43,770 --> 00:22:46,050
ما سبب ذلك الزّلزال؟

240
00:22:48,860 --> 00:22:49,990
.يا والدي

241
00:22:52,090 --> 00:22:53,170
.يا رفاق

242
00:22:56,540 --> 00:22:59,260
!تجاهلت نصيحتكم ورحلت

243
00:22:59,260 --> 00:23:01,730
!لماذا لم تتخلّوا عنّي فحسب؟

244
00:23:01,880 --> 00:23:03,950
!أنا من تسبّب بكلّ هذا

245
00:23:06,550 --> 00:23:07,700
.كلاّ

246
00:23:11,110 --> 00:23:14,110
.أنا من أخبرك أن تذهب

247
00:23:15,850 --> 00:23:17,040
.يا بنيّ

248
00:23:25,490 --> 00:23:27,160
.حضر الجميع

249
00:23:27,440 --> 00:23:32,390
أحدثت قوّة اللّحية البيضاء الهائلة
أمواجًا عاتية هدّدت بابتلاع

250
00:23:32,390 --> 00:23:35,400
،كلّ الرّجال الشّجعان في مارينفورد
.إضافة إلى السّلام والعدالة هناك

251
00:23:36,220 --> 00:23:39,650
!تبدأ معركة تعبر الأجيال أخيرًا

252
00:23:39,890 --> 00:23:41,400
:في الحلقة القادمة من وان بيس

253
00:23:41,400 --> 00:23:44,890
!القّوة الّتي يمكنها تدمير العالم"
"!قوّة فاكهة الاهتزاز

254
00:23:44,890 --> 00:23:47,190
!ملك القراصنة، لن يكون إلاّ أنا

255
00:23:50,070 --> 00:23:55,080
!!نلقاكم في الحلقة القادمة