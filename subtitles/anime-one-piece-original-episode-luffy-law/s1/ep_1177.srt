1
00:01:43,240 --> 00:01:48,580
"!لعبة رهائن حقيرة! تهديدات سومرز الوقحة"

2
00:02:06,100 --> 00:02:09,090
!ممتاز! تمّ إخماد الحريق

3
00:02:09,090 --> 00:02:11,690
!أنا قادم يا أطفال

4
00:02:16,650 --> 00:02:17,990
ساول؟

5
00:02:25,750 --> 00:02:30,080
...ستكون اللّحظة المثاليّة

6
00:02:33,380 --> 00:02:34,500
...ساول

7
00:02:34,540 --> 00:02:37,630
.اختبئا يا روبين وتشوبّر

8
00:02:37,630 --> 00:02:40,840
.رأيتُ ذلك الرّجل من قبل
...إنّه من

9
00:02:41,340 --> 00:02:43,140
!فرسان الإله

10
00:02:46,060 --> 00:02:49,480
!إنّهم خالدون. لا فرصة لنا أمامه

11
00:02:49,480 --> 00:02:53,440
.اختبئا وانتظرا فرصة لإنقاذ الأطفال

12
00:02:55,020 --> 00:02:58,780
!يا لها من مفاجأة سارّة

13
00:03:01,950 --> 00:03:03,070
...حسنًا

14
00:03:04,910 --> 00:03:08,200
ما الّذي تفعله هنا؟

15
00:03:19,340 --> 00:03:20,970
!يا إلهي

16
00:03:23,090 --> 00:03:25,550
...أعتقد أنّ هذا يعني

17
00:03:25,550 --> 00:03:28,220
.أنّه كان هنالك ناجيان اثنان من أوهارا

18
00:03:28,520 --> 00:03:31,480
.قامت البحريّة بعمل رديء بالفعل

19
00:03:31,640 --> 00:03:33,060
!هذا مؤلم

20
00:03:36,360 --> 00:03:39,240
!هلاّ كنت أكثر لطفًا؟

21
00:03:39,240 --> 00:03:41,610
!يا غونكو

22
00:03:42,700 --> 00:03:45,660
هل أمسكتِ بطاقم قبّعة القشّ؟

23
00:03:47,030 --> 00:03:48,990
.هذا يزيد الأمور حماسة

24
00:03:49,210 --> 00:03:51,880
هل علينا أخذهم معنا يا كيلينغام؟

25
00:03:51,880 --> 00:03:53,120
ماذا نفعل بهم؟

26
00:03:53,120 --> 00:03:55,330
!لا تكن سخيفًا يا سومرز

27
00:03:55,330 --> 00:03:59,590
هل تحاولان إثارة غضب قبّعة القشّ لوفي؟

28
00:03:59,590 --> 00:04:03,050
.لننجز مهمّتنا ونعود أدراجنا فحسب

29
00:04:04,930 --> 00:04:08,560
ساول المسكين يتعذّب
!ونحن سمحنا باختطاف كولون

30
00:04:08,560 --> 00:04:12,040
!كنت معنا يا جينبي
!كيف سمحت بحدوث ذلك؟

31
00:04:12,040 --> 00:04:14,030
!أسرع وقم بشيء ما

32
00:04:14,030 --> 00:04:18,150
ربّما سأتمكّن من التّفكير في شيء
.إن توقّفتِ عن الصّراح

33
00:04:19,190 --> 00:04:20,530
،على أيّ حال

34
00:04:20,530 --> 00:04:24,570
...كنتُ أتساءل كيف تعمل تلك القوى

35
00:04:24,950 --> 00:04:29,700
!تلك الفتاة مخيفة جدًّا
!ظننتُ أنّنا هالكون

36
00:04:30,330 --> 00:04:32,790
...هنالك شيء بخصوص تلك الفتاة

37
00:04:35,580 --> 00:04:39,290
.لا، ربّما أنا أتخيّل أمورًا فحسب

38
00:04:41,840 --> 00:04:45,220
!كلاّ، عادت المرأة الزّومبي

39
00:04:47,390 --> 00:04:49,510
...أ-أيّتها الشّابّة

40
00:04:49,510 --> 00:04:51,060
...أيعقل أنّك

41
00:04:54,440 --> 00:04:55,850
!بروك

42
00:04:57,940 --> 00:04:59,690
...اسمع يا هذا

43
00:05:00,650 --> 00:05:04,110
.أريدك أن تؤلّف أغانٍ لي لبقيّة حياتك

44
00:05:04,700 --> 00:05:07,070
.ستصير عبدي

45
00:05:07,070 --> 00:05:08,280
!ماذا؟

46
00:05:08,280 --> 00:05:12,830
ماذا؟ هل تعرف أغاني بروك؟
!ملك السّول؟

47
00:05:13,000 --> 00:05:16,210
لـ-لدى بروك معجبون حتّى بين
!التّنانين السّماويّين؟

48
00:05:16,500 --> 00:05:20,290
!ويا لها من معجبة

49
00:05:20,290 --> 00:05:23,260
!هذا يكفي يا غونكو

50
00:05:23,260 --> 00:05:27,430
أفضّل ألاّ ندخل في قتالٍ
.مع أحد أباطرة البحر

51
00:05:28,340 --> 00:05:30,300
.لنعد إلى عملنا فحسب

52
00:05:36,560 --> 00:05:40,060
...فهمت، أنت من معجبي ملك السّول

53
00:05:41,320 --> 00:05:44,230
.أنا جدّ آسف أيّتها الشّابّة

54
00:05:45,780 --> 00:05:50,450
لكنّ اليوم الّذي أعطاني فيه القبطان
،قبّعة القشّ فرصة ثانية في الحياة

55
00:05:50,530 --> 00:05:54,330
هو اليوم الّذي أقسمت له فيه

56
00:05:54,420 --> 00:05:57,750
.بولائي له وحد دون سواه

57
00:06:09,830 --> 00:06:12,720
وماذا لو قلتُ أنّي سأقتلك إن رفضت؟

58
00:06:14,680 --> 00:06:16,430
،إذًا فأنا أفضّل الموت

59
00:06:16,680 --> 00:06:19,850
.فهو أهون عندي من العيش بلا مروءة

60
00:06:20,520 --> 00:06:22,310
!انتبه يا بروك

61
00:06:52,430 --> 00:06:55,260
!توقّفي –
!بروك –

62
00:07:01,100 --> 00:07:03,520
أكلّ شيء جاهز الآن يا كيلينغام؟

63
00:07:03,520 --> 00:07:05,690
.نعم، يمكنك أن تبدأ

64
00:07:08,900 --> 00:07:12,630
.اختبار، اختبار. اختبار، اختبار

65
00:07:12,630 --> 00:07:14,870
أتسمعوني يا ساكني إلباف؟

66
00:07:15,030 --> 00:07:17,740
.أتحدّث مباشرة إلى محاربي إلباف

67
00:07:26,590 --> 00:07:28,890
.اختبار، اختبار

68
00:07:28,890 --> 00:07:30,370
من الّذي يتحدّث؟

69
00:07:30,370 --> 00:07:32,260
ما هذا البثّ؟

70
00:07:32,590 --> 00:07:36,210
يا محاربي إلباف، لا بدّ أنّكم مشغولون الآن

71
00:07:36,210 --> 00:07:41,520
بالتّعامل مع الحوادث الغريبة
.الّتي تقع من حولكم

72
00:07:42,560 --> 00:07:46,400
.إنّها من صنيعنا بالطّبع

73
00:08:08,090 --> 00:08:10,420
!أيّها القبطانان

74
00:08:11,050 --> 00:08:12,200
!ماذا؟

75
00:08:12,200 --> 00:08:16,220
أيّها القبطانان! هنالك من يبثّ
!رسالة إلى كلّ أنحاء إلباف

76
00:08:17,050 --> 00:08:19,060
!ما الّذي حدث لأنجي؟

77
00:08:19,060 --> 00:08:21,390
.اختبار، اختبار

78
00:08:21,390 --> 00:08:22,890
أيمكنكم سماعي؟

79
00:08:23,560 --> 00:08:28,610
.إنّنا نلعب لعبة صغيرة في إلباف الآن

80
00:08:28,610 --> 00:08:29,940
...مهلاً

81
00:08:29,940 --> 00:08:32,440
.نسيت التّعريف عن نفسي

82
00:08:35,820 --> 00:08:39,540
...أنا خنجر أرض ماريجوا المقدّسة

83
00:08:40,490 --> 00:08:44,000
!واسمي سومرز من فرسان الإله

84
00:08:44,000 --> 00:08:46,000
!فرسان الإله؟

85
00:08:46,580 --> 00:08:49,710
إنّه يكشف عن هويّته من تلقاء نفسه؟

86
00:08:49,710 --> 00:08:53,800
قرية الحرفيّين
الجنوب الشّرقيّ

87
00:08:49,710 --> 00:08:53,800
!ماريجوا؟! إنّه من حكومة العالم إذًا؟

88
00:08:53,800 --> 00:08:56,130
!لماذا قد يفعلون شيئًا كهذا؟

89
00:08:56,130 --> 00:08:58,600
قرية الصّيّادين
الشّمال الغربيّ

90
00:08:58,600 --> 00:09:01,470
!هل الأطفال بخير؟

91
00:09:01,470 --> 00:09:03,930
،أنا واثق أنّكم تعرفون سلفًا

92
00:09:03,930 --> 00:09:09,020
.أنّنا أخذنا عشرة من أبنائكم كرهائن

93
00:09:10,070 --> 00:09:11,780
...إضافة لذلك

94
00:09:11,780 --> 00:09:15,720
سحقنا الرّجل ذو اللّحية البرتقاليّة
...الّذي هاجمَنا في المدرسة

95
00:09:15,720 --> 00:09:18,370
...وحاول بكلّ يأس أن ينقذهم

96
00:09:20,580 --> 00:09:23,120
.وهو الآن على الأرض غارقًا في دمائه

97
00:09:23,620 --> 00:09:25,580
!هل يتحدّث عن ساول؟

98
00:09:26,670 --> 00:09:28,040
،بتعبير آخر

99
00:09:28,040 --> 00:09:30,240
بينما كنتم تظنّون بكلّ سذاجة

100
00:09:30,240 --> 00:09:34,090
...أنّ شخصًا آخر سيقوم بإنقاذ أطفالكم

101
00:09:35,510 --> 00:09:37,180
،فإنّهم في هذه اللّحظة

102
00:09:37,180 --> 00:09:39,860
.يواصلون السّير إلى خطّ النّهاية

103
00:09:40,470 --> 00:09:43,060
.كم هذا مملّ

104
00:09:45,890 --> 00:09:47,520
...الأطفال

105
00:09:47,520 --> 00:09:50,190
.بدأت اللّعبة الحقيقيّة للتّوّ

106
00:09:50,730 --> 00:09:54,440
.من المؤسف أنّه لا يوجد بثّ مرئيّ

107
00:09:57,400 --> 00:10:00,240
...هل تعرفين أسماء كلّ الأطفال

108
00:10:00,820 --> 00:10:02,950
!الّذين غادروا من هنا مشيًا؟

109
00:10:02,950 --> 00:10:05,200
!بـ-بالطّبع

110
00:10:06,540 --> 00:10:09,540
...إذًا لنبلغ آباءهم بأسمائهم

111
00:10:10,630 --> 00:10:15,460
بما أنّ الأطفال سيستيقظون
.من أحلامهم قريبًا

112
00:10:24,180 --> 00:10:28,220
مهلاً، لماذا تتحرّك أرجلنا من تلقاء نفسها؟

113
00:10:28,220 --> 00:10:29,810
!إلى أين نحن ذاهبون؟

114
00:10:30,100 --> 00:10:33,020
!لا أدري، لكنّه مكان بعيد على الأرجح

115
00:10:33,020 --> 00:10:35,560
!كاذب! هذا الغصن رقم 8

116
00:10:35,560 --> 00:10:37,150
!الطّريق الّتي أسلك إلى المنزل

117
00:10:37,150 --> 00:10:38,730
!نعم، أعلم ذلك

118
00:10:38,730 --> 00:10:42,490
.لكنّنا لا نتحكّم بحركاتنا
!لذلك لا خيار أمامنا سوى السّير

119
00:10:42,830 --> 00:10:45,240
...تعرّضنا للعنة بكلّ تأكيد

120
00:10:45,240 --> 00:10:48,360
!أنا متعب

121
00:10:48,360 --> 00:10:50,920
.إنّ الشّكوى والتّذمّر لن يغيّرا أيّ شيء

122
00:10:50,920 --> 00:10:53,620
!أهذا يعني أنّه لا يمكننا الذّهاب إلى المنزل؟

123
00:10:53,620 --> 00:10:55,920
!لا أحبّ هذا

124
00:10:59,340 --> 00:11:00,760
...كولون

125
00:11:01,090 --> 00:11:03,220
سنستطيع العودة للمنزل، صحيح؟

126
00:11:05,180 --> 00:11:06,890
كولون؟

127
00:11:10,940 --> 00:11:13,340
!لا

128
00:11:13,340 --> 00:11:16,760
!أريد رؤية أبي! أريد رؤية أمّي

129
00:11:16,760 --> 00:11:17,780
!لا

130
00:11:18,030 --> 00:11:20,240
!أبي! أمّي

131
00:11:20,240 --> 00:11:22,240
!لا يمكننا رؤيتهم

132
00:11:27,830 --> 00:11:31,620
!لا يمكننا رؤيتهم! نحن نتعرّض للاختطاف

133
00:11:37,460 --> 00:11:41,590
!ماذا؟! نتعرّض للاختطاف؟

134
00:11:41,590 --> 00:11:44,200
!لا تهلعوا! أنا هنا معكم

135
00:11:44,200 --> 00:11:47,810
،على عكسكم أيّها الجبناء
!فأنا محارب

136
00:11:47,810 --> 00:11:48,970
محارب؟

137
00:11:48,970 --> 00:11:52,140
...هذا صحيح! سأحميكم بالتّأكيد

138
00:11:58,190 --> 00:12:01,900
!وحش –
!شبح –

139
00:12:01,900 --> 00:12:04,070
!ساعدنا يا كولون

140
00:12:04,070 --> 00:12:05,780
!أجل! أنت محارب، صحيح؟

141
00:12:12,120 --> 00:12:15,000
!وحوش

142
00:12:17,340 --> 00:12:19,590
!كولون

143
00:12:24,590 --> 00:12:26,800
!يبدو أنّهم هزموا ساول

144
00:12:27,430 --> 00:12:29,010
!لنستدر

145
00:12:29,010 --> 00:12:31,520
!لنذهب لإنقاذ الأطفال

146
00:12:31,520 --> 00:12:35,480
!ولكن أيّها القبطانان، ثمّة ثقب في قاع السّفينة

147
00:12:35,510 --> 00:12:36,730
!ماذا؟

148
00:12:38,820 --> 00:12:41,490
!وكسروا مجاديفنا أيضًا

149
00:12:43,950 --> 00:12:46,700
!تبًّا! ما هذه القوّة؟

150
00:12:46,700 --> 00:12:49,090
!أيّ نوع من الوحوش هذه؟

151
00:12:49,090 --> 00:12:51,660
!لا أدري! لكنّها وحوشٌ نساء

152
00:12:53,710 --> 00:12:56,860
...ذاك يبدو مثل زوجتي نوعًا ما

153
00:12:56,860 --> 00:12:58,670
!انتبه لكلامك يا رجل

154
00:12:58,670 --> 00:13:02,300
أيّها القبطانان! ذلك الوحش يبدو
!مثل زوجتي أيضًا

155
00:13:02,300 --> 00:13:03,510
!ماذا؟

156
00:13:03,510 --> 00:13:04,970
...مهلاً لحظة

157
00:13:05,470 --> 00:13:07,470
...هذه الوحوش

158
00:13:09,930 --> 00:13:14,060
إنّها جميعًا وليدة مخاوف الأطفال، أليس كذلك؟

159
00:13:14,060 --> 00:13:17,390
.نعم، هذا ما قالته أنجي على أيّ حال

160
00:13:17,390 --> 00:13:20,520
...وزوجتك هذه

161
00:13:21,020 --> 00:13:23,990
هي والدة بينت، صحيح؟

162
00:13:23,990 --> 00:13:25,900
.نعم، بالطّبع

163
00:13:26,450 --> 00:13:29,660
إن كان ذلك هو ما يفكّر فيه بينت

164
00:13:30,030 --> 00:13:33,790
...عندما تخيّل أكثر شيء يخشاه

165
00:13:37,540 --> 00:13:40,420
...فإنّ الوحش الّذي يوجد أمامنا هنا

166
00:13:50,390 --> 00:13:53,680
!"أمّه"

167
00:13:58,270 --> 00:14:01,480
!هذا أكثر ما نخشاه نحن أيضًا

168
00:14:01,480 --> 00:14:05,570
!انتهى أمرنا –
!انهارت معنويّاتنا بالكامل –

169
00:14:07,570 --> 00:14:09,160
...أنا آسف يا عزيـ

170
00:14:19,620 --> 00:14:22,090
!ستندم

171
00:14:23,590 --> 00:14:26,590
!لا فرصة لدينا أمام زوجاتنا

172
00:14:47,150 --> 00:14:49,900
!أهذه إريك العظيمة؟

173
00:14:50,910 --> 00:14:53,490
!توقّفي يا عزيزتي

174
00:14:54,870 --> 00:14:58,000
!آسف لأنّي نسيت رمي القمامة يا عزيزتي

175
00:14:58,000 --> 00:15:01,330
!آسف لأنّي أقضي وقتًا كثير في الشّرب يا عزيزتي

176
00:15:01,330 --> 00:15:04,330
آسف لأنّي أكلت كعكة العسل
!المخصّصة للضّيوف

177
00:15:04,330 --> 00:15:07,010
!كلاّ! إنّ سُحب الجزر تتعرّض للضّرر

178
00:15:07,010 --> 00:15:10,440
!أيّها القبطانان! سوف نقع

179
00:15:10,440 --> 00:15:13,220
!أنا آسف

180
00:15:16,100 --> 00:15:20,560
لقد تحطّمت سفينة طاقم
!القراصنة العمالقة المرعبة

181
00:15:20,560 --> 00:15:23,220
.إنّ بعض تلك النّوميّات وحوش قويّة بالفعل

182
00:15:23,220 --> 00:15:26,360
!ماذا؟ طاقم دوري وبروغي؟

183
00:15:28,320 --> 00:15:30,200
!انظرن، لقد تحطّمت

184
00:15:30,200 --> 00:15:34,120
هذا لا يُصدّق! سفار طاقم
!القراصنة العمالقة؟

185
00:15:34,180 --> 00:15:35,330
!بسرعة

186
00:15:35,330 --> 00:15:37,360
.آمل أن يكون القبطانان بخير

187
00:15:37,360 --> 00:15:39,040
!سنعرف بعد أن نصل إلى هناك

188
00:15:41,120 --> 00:15:42,500
...حسنًا

189
00:15:42,500 --> 00:15:45,290
.سأدخل صلب الموضوع مباشرة

190
00:15:45,490 --> 00:15:48,920
.أيّها المحارب الأسطوريّ لحية الجبل يارول

191
00:15:49,130 --> 00:15:52,720
،بما أنّه لا ملك يجلس على عرش إلباف الآن

192
00:15:52,720 --> 00:15:55,010
.فإنّك هو أعلى سلطة تنوب عنه

193
00:15:56,050 --> 00:15:59,520
.إنّ غرضنا في غاية البساطة

194
00:15:59,770 --> 00:16:03,810
.نريد أن نجعل من العمالقةِ محاربينَ عبيدًا لنا

195
00:16:05,270 --> 00:16:09,150
وكخطوة أولى، عليّ أن أعرف
...ما مدى كفاءة

196
00:16:10,360 --> 00:16:13,070
.هؤلاء الأطفال الأشقياء كرهائن

197
00:16:13,320 --> 00:16:15,670
...لا بدّ أنّكم متشوّقون لمعرفة

198
00:16:15,670 --> 00:16:18,490
.من هم الأطفال العشرة المختطَفون

199
00:16:18,950 --> 00:16:20,250
ما أسماؤهم؟

200
00:16:23,540 --> 00:16:25,460
...هذه هي أسماء

201
00:16:25,920 --> 00:16:28,040
...أولئك الأطفال

202
00:16:28,380 --> 00:16:30,920
...الّذين اختُطفوا

203
00:16:35,590 --> 00:16:37,100
...أوّلاً

204
00:16:37,680 --> 00:16:39,060
.إلفا

205
00:16:39,890 --> 00:16:41,560
!أمّي

206
00:16:41,560 --> 00:16:42,890
!إلفا

207
00:16:42,890 --> 00:16:46,730
!ماذا؟! إلفا هي حفيدةُ حفيدتي

208
00:16:46,730 --> 00:16:49,020
...ثمّ سكالدي

209
00:16:49,020 --> 00:16:51,480
أليس بوسعنا فعل أيّ شيء بالفعل؟

210
00:16:51,480 --> 00:16:52,700
.أولاف

211
00:16:52,700 --> 00:16:54,950
!هذا مجرّد حلم! كابوس لا غير

212
00:16:54,950 --> 00:16:56,320
!أيّها القبطانان

213
00:16:56,320 --> 00:16:59,240
!أولاف هو حفيدي

214
00:16:59,240 --> 00:17:00,490
.كارين

215
00:17:01,620 --> 00:17:04,960
.حظّي عاثر في كلّ مرّة

216
00:17:04,960 --> 00:17:06,230
.ماغ

217
00:17:06,230 --> 00:17:09,030
!أنا قويّ، لكن لا أستطيع إيقاف نفسي

218
00:17:09,030 --> 00:17:10,340
.رونيا

219
00:17:10,370 --> 00:17:13,010
!لا داعي للقلق! سيكون كلّ شيء بخير

220
00:17:13,420 --> 00:17:16,720
!رونيا؟! ابنتي أيضًا؟

221
00:17:16,870 --> 00:17:19,600
!عليّ الإسراع إلى الغصن 8 لإنقاذها

222
00:17:24,020 --> 00:17:25,520
!سأتولّى أنا الأمور هنا

223
00:17:26,980 --> 00:17:29,190
...وبينت

224
00:17:29,400 --> 00:17:32,150
!ستكون أمّي غاضبة جدًّا منّي

225
00:17:33,150 --> 00:17:34,560
.يوهانا

226
00:17:34,560 --> 00:17:37,610
.على الأقلّ لديكم آباؤكم وأمّهاتكم

227
00:17:38,200 --> 00:17:40,580
...مع أنّي لا أريد والدين من الأساس

228
00:17:40,580 --> 00:17:41,860
.بيورن

229
00:17:41,860 --> 00:17:44,610
...آمل أن ينقذوني أنا على الأقلّ

230
00:17:44,610 --> 00:17:47,990
!أنت فظيع! كيف تقول كلامًا كهذا يا بيورن؟

231
00:17:47,990 --> 00:17:49,490
...آ-آسف

232
00:17:49,490 --> 00:17:51,130
!أنت مثلك أخيك تمامًا

233
00:17:51,800 --> 00:17:54,960
لا تضعيني في نفس الكفّة
...مع ذلك المريب

234
00:17:58,470 --> 00:18:00,100
...هذه هي

235
00:18:02,350 --> 00:18:05,520
...كانت هذه هي أسماء الأطفال المختطفين

236
00:18:05,520 --> 00:18:07,310
.من المدرسة

237
00:18:12,230 --> 00:18:14,400
!أيّها القبطانان

238
00:18:15,690 --> 00:18:17,670
...يا لها من كارثة

239
00:18:17,670 --> 00:18:18,780
!يا-سان

240
00:18:19,200 --> 00:18:20,780
!هذه أنت يا ريبلي

241
00:18:20,780 --> 00:18:22,370
!إنّكم جميعًا بخير

242
00:18:22,950 --> 00:18:24,240
ومن تكون...؟

243
00:18:24,240 --> 00:18:26,080
.إنّهم تسعة أطفال

244
00:18:27,750 --> 00:18:31,710
...ولكن، انضمّ إليهم محارب صغير

245
00:18:31,710 --> 00:18:35,710
بعد أن حاول إنقاذ أصدقائه
!يُدعى كولون

246
00:18:36,130 --> 00:18:38,300
.وبهذا، يصير عدد الأطفال عشرة

247
00:18:38,300 --> 00:18:40,260
!ماذا؟! كولون؟

248
00:18:40,470 --> 00:18:44,470
أسمعت ذلك يا ريبلي؟
!أنا فخور بك يا بُنيّ

249
00:18:44,470 --> 00:18:47,020
.هذا ليس وقتًا مناسبًا لذلك

250
00:18:47,980 --> 00:18:50,190
.والآن، إليكم أوامري

251
00:18:50,190 --> 00:18:52,230
.اسمعوا جيّدًا يا عمالقة إلباف

252
00:18:52,650 --> 00:18:55,480
!لا فائدة لمدرستكم في الحرب

253
00:18:56,360 --> 00:19:00,110
ومكتبتكم مليئة بسجلاّت
!الماضي عديمة القيمة

254
00:19:01,530 --> 00:19:04,160
!أريد منكم إحراقهما عن بكرة أبيهما حالاً

255
00:19:11,290 --> 00:19:14,790
!وبعد ذلك، ستقسمون بالولاء لنا

256
00:19:18,630 --> 00:19:20,630
...وإن رفضتم

257
00:19:20,630 --> 00:19:22,180
...فإنّ أطفالكم

258
00:19:23,600 --> 00:19:25,310
...سيلقون حتفهم

259
00:19:25,640 --> 00:19:27,520
.الواحد تلو الآخر

260
00:19:38,150 --> 00:19:40,610
!لقد فقد عقله بالكامل

261
00:19:44,030 --> 00:19:46,330
!نحن نعرف مكان الأطفال

262
00:19:46,660 --> 00:19:47,790
!نعم

263
00:19:48,490 --> 00:19:51,000
...لنذهب ونوسعهم ضربًا

264
00:19:51,000 --> 00:19:53,580
!وننقذ الأطفال

265
00:19:58,380 --> 00:19:59,510
!حسنًا

266
00:19:59,880 --> 00:20:01,880
...والآن أيّها الشّيخ يارول

267
00:20:03,090 --> 00:20:05,470
.أصبح القرار لك

268
00:20:06,260 --> 00:20:08,100
لي؟

269
00:20:10,560 --> 00:20:12,640
!انتظر رجاءً

270
00:20:12,640 --> 00:20:15,020
!هذا قاس للغاية

271
00:20:15,690 --> 00:20:19,400
إنّ المدرسة رمز للسّلام الّذي يخيّم
!على إلباف الآن

272
00:20:19,900 --> 00:20:21,610
...والمكتبة

273
00:20:22,610 --> 00:20:25,990
...تضمّ المكتبة تاريخ إلباف العريق

274
00:20:25,990 --> 00:20:31,910
ومعارف من العالم صارت متوفّرة لدينا
!بفضل تضحيات علماء أوهارا

275
00:20:36,330 --> 00:20:37,590
...روبين

276
00:20:37,590 --> 00:20:39,210
...هذه المكتبة

277
00:20:39,210 --> 00:20:43,170
!ثروة لا تنتمي لإلباف فحسب

278
00:20:43,880 --> 00:20:45,970
...اهدئي يا امرأة

279
00:20:47,180 --> 00:20:49,430
!اهدئي يا روبين

280
00:20:49,430 --> 00:20:50,890
!إيّاكِ

281
00:20:51,770 --> 00:20:53,350
ما قرارك؟

282
00:20:54,140 --> 00:20:55,730
...الأطفال

283
00:20:58,730 --> 00:21:00,820
أم ولاؤكم لنا؟

284
00:21:05,700 --> 00:21:07,700
!رجاءً يا يا-سان

285
00:21:08,830 --> 00:21:09,830
!أجل

286
00:21:18,290 --> 00:21:20,420
...لن أسمح لهم

287
00:21:22,420 --> 00:21:24,170
!بفعل أيّ من ذلك

288
00:21:25,590 --> 00:21:30,600
يُتبع

289
00:23:04,360 --> 00:23:08,150
يتصاعد التّوتّر في إلباف الآن بعد
.أن صار بعض أطفالها رهائن

290
00:23:08,150 --> 00:23:12,700
يهدّد فرسان الإله القساة حياة طفلة
.صغيرة للضّغط على العمالقة

291
00:23:12,700 --> 00:23:15,450
،مع بدء العدّ التّنازليّ المميت

292
00:23:15,450 --> 00:23:19,460
.يواجه يارول خيارًا مستحيلاً
ماذا سيقرّر يا ترى؟

293
00:23:19,610 --> 00:23:21,290
:في الحلقة القادمة من وان بيس

294
00:23:21,290 --> 00:23:25,170
- حماية الماضي والمستقبل"
"روبن وغابان يهاجمان

295
00:23:25,320 --> 00:23:27,590
!ملك القراصنة، لن يكون إلاّ أنا