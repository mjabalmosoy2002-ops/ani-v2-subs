1
00:00:15,570 --> 00:00:17,490
...الثّروة والشّهرة والسّلطة

2
00:00:17,490 --> 00:00:19,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:19,450 --> 00:00:21,370
.ملك القراصنة، غولد روجر

4
00:00:21,370 --> 00:00:25,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:25,080 --> 00:00:28,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:28,840 --> 00:00:32,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:34,800 --> 00:00:39,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:39,720 --> 00:00:42,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:43,520 --> 00:00:48,110
سنجمع كل أحلامنا

10
00:00:49,110 --> 00:00:54,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:54,950 --> 00:00:56,570
!وان بيس

12
00:01:01,080 --> 00:01:05,920
لا تجلب البوصلات سوى التّأخيرات

13
00:01:06,750 --> 00:01:11,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:12,460 --> 00:01:17,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:17,760 --> 00:01:23,310
!فإنّها ليست أسطورة إذًا

16
00:01:24,520 --> 00:01:30,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:30,230 --> 00:01:35,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:35,400 --> 00:01:37,990
!وتظاهر أنّها غير موجودة

19
00:01:38,990 --> 00:01:43,830
سنجمع كلّ أحلامنا

20
00:01:44,830 --> 00:01:50,340
ونبحر باحثين عن شيء

21
00:01:50,340 --> 00:01:53,340
،عملة في جيبي

22
00:01:53,340 --> 00:01:56,590
وتريد أن تصبح صديقي؟

23
00:01:56,590 --> 00:02:01,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:02:01,970 --> 00:02:03,890
!إنّنا كذلك

25
00:02:06,790 --> 00:02:10,000
...الثّروة والشّهرة والسّلطة

26
00:02:11,100 --> 00:02:15,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:16,840 --> 00:02:22,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:23,320 --> 00:02:27,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:27,400 --> 00:02:31,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:32,260 --> 00:02:36,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:37,350 --> 00:02:41,400
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:50,330 --> 00:02:53,810
.عش كما تشاء يا لوفي

33
00:02:53,810 --> 00:02:59,110
في مجرى الزّمن، نتيجةً لظروف
،مختلفة وعزائم قويّة

34
00:02:59,110 --> 00:03:01,670
!يستفهم النّاس العالم الّذي يعيشون فيه

35
00:03:01,670 --> 00:03:05,530
.سيأتي اليوم الّذي نلتقي فيه في مرحلةٍ ما

36
00:03:08,540 --> 00:03:11,370
الجزيرة القضائيّة إنيس لوبي هي الباب الأماميّ

37
00:03:11,370 --> 00:03:15,170
.الّذي يقود إلى حكومة العالم، منظّمة هائلة

38
00:03:15,170 --> 00:03:16,750
،بما أنّهم تسبّبوا في انهيارها

39
00:03:16,750 --> 00:03:19,630
.فلا البحريّة ولا القراصنة سيتركونهم وشأنهم

40
00:03:19,630 --> 00:03:23,930
بإمكانكم القول أنّ اسم طاقم قبّعة القشّ
.انتشر كالنّار في الهشيم في العالم أجمع

41
00:03:24,680 --> 00:03:26,510
.وكذلك ملصقات المطلوبين

42
00:03:28,560 --> 00:03:30,880
!سانجي! أنت الأفضل

43
00:03:32,040 --> 00:03:34,020
!أليس هذا مذهلاً؟! الرّسمة تشبهه تمامًا

44
00:03:45,290 --> 00:03:47,790
!قام بعمل مجنون

45
00:03:48,270 --> 00:03:50,370
!انظروا! إنّها مقالة عن قبّعة القشّ

46
00:03:50,940 --> 00:03:53,190
.يبدو أنّه أسقط برج القانون

47
00:03:53,190 --> 00:03:55,900
!سترتفع مكافأته بجنون بعد ذلك

48
00:03:58,330 --> 00:04:02,260
.إنيس لوبي معروفة بقطار ووتر سيفن البحريّ

49
00:04:02,920 --> 00:04:04,640
...ليست بعيدة جدًّا من هنا

50
00:04:05,280 --> 00:04:07,680
.لا بدّ أنّه تحوُّل للقدر

51
00:04:08,740 --> 00:04:14,870
...بأن يكونوا في نطاقنا
.يا له من طاقم مؤسف ويُرثى له

52
00:04:19,950 --> 00:04:21,150
!هيّا بنا أيّها القائد

53
00:04:22,640 --> 00:04:24,270
!بالطّبع سنذهب

54
00:04:27,500 --> 00:04:29,870
!هيّا! استعدّوا للإبحار

55
00:04:29,870 --> 00:04:31,400
!العمل ينتظرنا

56
00:04:31,400 --> 00:04:32,330
!أنت

57
00:04:32,950 --> 00:04:34,610
!انتظر يا تيتش

58
00:04:34,610 --> 00:04:35,950
.كنتُ أبحث عنك

59
00:04:44,830 --> 00:04:48,960
لنعد ثلاثة أيّام إلى الوراء قبل
أن يُصدم ويُذهل العالم

60
00:04:48,960 --> 00:04:52,140
بملصقات المطلوبين الخاصّة
.بقراصنة قبّعة القشّ

61
00:04:52,690 --> 00:04:55,930
.كان هنالك حدث وقع في جزيرة معيّنة

62
00:04:56,640 --> 00:05:00,150
.هذه جزيرة بانارو في الغراند لاين

63
00:05:02,740 --> 00:05:07,740
القوّة الأكثر شناعة! يهاجم"
"!ظلام اللّحية السّوداء إيس

64
00:05:18,040 --> 00:05:22,880
!عجبًا! إيس! القائد

65
00:05:23,350 --> 00:05:25,910
.لا تدعوني بـ"القائد" بعد كلّ هذا الوقت

66
00:05:25,910 --> 00:05:29,220
يفترض أن تُخصّص تلك الكلمة
.للنّاس الّذين تحترمهم

67
00:05:29,780 --> 00:05:31,380
.لا تسخر منّي

68
00:05:33,020 --> 00:05:35,450
.لا بدّ أنّك "قبضة النّار" إيس

69
00:05:35,450 --> 00:05:37,810
!بلحمه وشحمه. سعيد للقائكم

70
00:05:38,380 --> 00:05:42,440
.أرى أنّك أصبحت قائدًا عظيمًا بنفسك

71
00:05:43,250 --> 00:05:47,390
أليس كذلك يا قائد قراصنة
اللّحية السّوداء، مارشال د. تيتش؟

72
00:05:49,420 --> 00:05:52,410
!عجبًا يا إيس! لم أرك منذ وقتٍ طويل

73
00:05:53,070 --> 00:05:55,700
ما الأمر إذًا؟ كيف عرفت أنّني هنا؟

74
00:05:57,450 --> 00:06:00,540
!كفانا لغوًا يا تيتش

75
00:06:01,380 --> 00:06:06,970
،يجدر بك أن تعرف القواعد
.بما أنّك عشت ضعف ما عاشه البقيّة

76
00:06:07,890 --> 00:06:09,510
أليس كذلك؟

77
00:06:18,570 --> 00:06:20,460
.نعم، فهمت

78
00:06:20,460 --> 00:06:23,090
!لكن دعني أخبرك بشيء أوّلاً

79
00:06:23,090 --> 00:06:26,900
ما رأيك يا إيس؟ لِمَ لا تنضمّ لطاقمي؟

80
00:06:29,190 --> 00:06:31,380
!لنستولِ على العالم معًا

81
00:06:31,380 --> 00:06:33,990
!سبق وخطّطتُ لكيف سأرتفع في سلّم القوّة

82
00:06:34,440 --> 00:06:39,000
!عهد اللّحية البيضاء قد ولّى
!سأصبح ملك القراصنة القادم

83
00:06:39,570 --> 00:06:44,330
كبداية، سأقتل قبّعة القشّ لوفي
،الّذي يتواجد في ووتر سيفن

84
00:06:44,330 --> 00:06:46,910
!كهديّة للحكومة

85
00:06:47,890 --> 00:06:51,340
لوفي؟ ماذا قلت للتّوّ؟

86
00:06:51,750 --> 00:06:54,330
!هل تعرفه؟

87
00:06:54,620 --> 00:06:56,990
!أعطيتني سببًا آخر لكي لا أدعك تذهب

88
00:06:57,680 --> 00:06:59,350
!إنّه أخي

89
00:06:59,350 --> 00:07:00,280
ماذا؟

90
00:07:01,130 --> 00:07:05,690
...وبطبيعة الحال، يستحيل قطعًا أن أنضمّ

91
00:07:08,790 --> 00:07:09,820
.لطاقمك

92
00:07:09,820 --> 00:07:10,700
!تبًّا

93
00:07:20,280 --> 00:07:22,540
!سأقدّم لأحد رجالك درسًا في الأخلاق

94
00:07:22,990 --> 00:07:23,670
!مسدّس النّار

95
00:07:32,260 --> 00:07:33,640
!وصيّة اللّهب

96
00:07:34,580 --> 00:07:35,800
!عمود النّار

97
00:07:42,930 --> 00:07:46,730
!أوغر، بارجس! لا تتدخّلا

98
00:07:46,730 --> 00:07:50,120
!لستما ندّين لذلك الرّجل. تراجعا

99
00:07:50,120 --> 00:07:50,700
!آسف

100
00:07:50,700 --> 00:07:52,150
!قبضة النّار

101
00:08:01,300 --> 00:08:03,390
!حرقني

102
00:08:01,300 --> 00:08:04,740
!أيّها القائد

103
00:08:04,740 --> 00:08:06,960
!هذا ساخن، ساخن، ساخن، ساخن، ساخن

104
00:08:08,370 --> 00:08:10,490
!إنّي أحترق

105
00:08:14,130 --> 00:08:15,390
!هذا ساخن، ساخن، ساخن، ساخن

106
00:08:29,730 --> 00:08:31,490
!ساخن، ساخن

107
00:08:35,270 --> 00:08:36,110
!أيّها القائد

108
00:08:36,110 --> 00:08:39,450
!سحقًا! ساخن، ساخن، ساخن، ساخن

109
00:08:40,420 --> 00:08:43,500
!اخرسوا يا هؤلاء! دعوني لوحدي

110
00:09:20,950 --> 00:09:25,820
فهمت يا إيس. إنّك تشتعل
لهفةً لقتلي، أليس كذلك؟

111
00:09:25,820 --> 00:09:29,790
لا عجب في ذلك. فقتل رفيق
.طاقم يعدّ جريمة جسيمة

112
00:09:30,190 --> 00:09:34,140
!صحيحٌ أنّني قتلت قائد الوحدة الرّابعة ثاتش

113
00:09:34,140 --> 00:09:39,600
لكن لم يكن لي خيار! فقد وضع يديه
!على فاكهة الشّيطان الّتي كنتُ أسعى لها

114
00:09:40,160 --> 00:09:44,280
تقضي قاعدة السّفينة أنّ أيًّا من وجد
الفاكهة يستطيع أكلها، هل نسيت؟

115
00:09:44,280 --> 00:09:47,980
،حفظتُ شكل كلّ فاكهة في الكتاب

116
00:09:47,980 --> 00:09:51,820
لذا عرفتُ أنّها الفاكهة الّتي كنتُ
!أسعى لها لحظة رأيتها

117
00:09:51,820 --> 00:09:55,290
والسّبب الوحيد من قضائي كلّ تلك
العقود على سفينة اللّحية البيضاء

118
00:09:55,290 --> 00:09:59,950
هو لأنّي فكّرت أنّه المكان الأكثر
!احتمالاً لوجودها

119
00:10:01,420 --> 00:10:03,910
،كنتُ لأستسلم لو أنّ الحظّ لم يبتسم لي

120
00:10:04,370 --> 00:10:07,510
!لكنّ تلك الفاكهة وقعت في يدي صديقي

121
00:10:10,110 --> 00:10:14,250
إذًا قتلت ثاتش وسرقتها؟

122
00:10:16,030 --> 00:10:17,720
.حسنٌ، هذه سنّة الحياة

123
00:10:18,860 --> 00:10:22,140
!لقد اختارتني هذه القدرة يا إيس

124
00:10:25,220 --> 00:10:28,690
!وجعلت منّي الشّخص الأقوى يا إيس

125
00:10:29,470 --> 00:10:33,500
.انظر! إنّها نادرة، حتّى بالنّسبة لنوع لوغيا

126
00:10:37,880 --> 00:10:40,950
إيس، أليس جسدك من نار؟

127
00:10:47,880 --> 00:10:50,620
!أمّا جسدي فمن ظلام

128
00:10:51,820 --> 00:10:54,880
انظروا! إنّه نفس الدّخان الأسود
.الّذي رأيناه سابقًا

129
00:10:54,880 --> 00:10:57,260
.ما زال أولئك القراصنة في البلدة

130
00:10:57,260 --> 00:11:02,120
ألم ينتهوا بعد؟
!...إن دمّروا المزيد في قريتنا

131
00:11:02,120 --> 00:11:05,050
!لا تقتربوا منهم! خيارنا الوحيد هو الهرب

132
00:11:11,910 --> 00:11:13,440
ظلام...؟

133
00:11:14,150 --> 00:11:19,750
.هذا صحيح أيّها القائد إيس. لا تستطيع قتلي

134
00:11:19,750 --> 00:11:24,120
يقال أنّ هذه القوّة هي الأكثر شرًّا
.في تاريخ فواكه الشّيطان

135
00:11:24,700 --> 00:11:27,650
.إنّها فاكهة شيطان من نوع لوغيا، فاكهة الظّلام

136
00:11:27,650 --> 00:11:30,520
.أصبحتُ رجلاً مصنوعًا من الظّلام

137
00:11:30,520 --> 00:11:34,840
!سأذيقك من قوّتها

138
00:11:37,240 --> 00:11:38,510
.تفضّل

139
00:11:42,410 --> 00:11:43,960
!ماذا تفعل؟! أسرع

140
00:11:43,960 --> 00:11:45,440
!سيطلق القائد العنان لقوّته

141
00:11:45,440 --> 00:11:49,540
،إلّم نسرع بالابتعاد من هنا
!فسنقع في نطاق هجومه

142
00:11:49,540 --> 00:11:50,980
!قف

143
00:12:23,100 --> 00:12:27,720
!إنّ الظّلام المتدفّق من جسده يزحف على الأرض

144
00:12:27,720 --> 00:12:31,580
،مخيف! إنّه حالك السّواد
.وكأنّه توجد حفرة في الأرض

145
00:12:31,580 --> 00:12:33,480
من المخيف كيف أنّه يُشعرك
.وكأنّه سيلتهمك

146
00:12:33,890 --> 00:12:36,450
ابتعدوا بسرعة! ابتعدوا من هنا
!قدر ما تستطيعون

147
00:12:38,060 --> 00:12:41,190
!اذهبوا من خلال الغابة! اهربوا حتّى الشّاطئ

148
00:12:47,160 --> 00:12:52,060
!الظلاّم هو الجاذبيّة
!يملك القوّة لجذب أيّ شيء

149
00:12:52,060 --> 00:12:57,290
ولا حتّى شعاع من الضّوء يمكنه
!الهرب من جاذبيّته اللاّنهائيّة

150
00:12:58,580 --> 00:13:02,800
.لكنّك تواجهني... وما زلتُ سليمًا

151
00:13:03,240 --> 00:13:05,730
.لم أستهدفك بعد

152
00:13:06,460 --> 00:13:08,850
.يمكنك البقاء هنا والاستماع بمظهر البلدة

153
00:13:11,240 --> 00:13:13,760
!الثّقب الأسود

154
00:14:16,850 --> 00:14:19,700
!إنّ الأرض تبتلع البلدة

155
00:14:19,700 --> 00:14:22,750
لماذا؟ مـ-ما الّذي يجري؟

156
00:14:28,430 --> 00:14:35,270
يستخدم الظّلام قوّته اللاّمحدودة
!لتكثيف الأشياء وسحقها

157
00:14:49,350 --> 00:14:54,530
...أهذا كابوس؟ إنّ قريتنا

158
00:15:02,200 --> 00:15:06,340
.والآن سأريك ماذا حلّ بالقرية المفقودة

159
00:15:06,740 --> 00:15:09,220
!انظر كيف أصبحت في فوضى عارمة

160
00:15:09,740 --> 00:15:11,150
!تحرير

161
00:15:37,860 --> 00:15:41,530
...أمست قريتنا... من ركام

162
00:15:49,690 --> 00:15:51,640
هل فهمت الآن يا إيس؟

163
00:15:51,640 --> 00:15:54,350
!هذه القوّة الّتي اكتسبتها

164
00:15:56,740 --> 00:15:57,720
!ضوء اليراعة

165
00:15:58,200 --> 00:16:00,060
!اشتعال

166
00:16:02,220 --> 00:16:04,340
!ساخن، ساخن، ساخن، ساخن

167
00:16:05,150 --> 00:16:07,520
!هذا يحرق

168
00:16:08,030 --> 00:16:11,950
.أعي تمامًا مدى عظمة قوّة الظّلام

169
00:16:08,030 --> 00:16:11,950
!ساخن، ساخن، ساخن، ساخن

170
00:16:11,950 --> 00:16:13,720
...لكن ما يحيّرني

171
00:16:13,720 --> 00:16:17,530
إن كانت من نوع لوغيا، فيجدر
.بهذه الهجمات أن تخترقك

172
00:16:13,720 --> 00:16:17,530
!سحقًا! هذا ساخن! ساخن، ساخن، ساخن، ساخن

173
00:16:29,760 --> 00:16:33,700
،سبق وأخبرتك أنّ الظّلام يجذب كلّ شيء

174
00:16:33,700 --> 00:16:36,510
وذلك يشمل الرّصاص والسّيوف
!واللّكمات والنّار والبرق

175
00:16:37,170 --> 00:16:40,850
على خلاف بقيّتكم، لا أملك خيار
!أن أدع الأشياء تعبر من خلالي

176
00:16:40,850 --> 00:16:45,440
جسدي يشعر بألم أسوأ بكثير
!من سائر النّاس من كلّ ناحية

177
00:16:47,370 --> 00:16:50,650
،لكن مقابل قبول تلك المخاطرة
...ثمّة شيء آخر

178
00:16:50,650 --> 00:16:53,170
.يمكنني ابتلاعه

179
00:16:53,170 --> 00:16:54,640
!ماء الظّلام

180
00:16:59,020 --> 00:17:03,100
على وجه الدّقّة، تملك جاذبيّة الظّلام القدرة على
.سحب الجسد المادّيّ لحامل قوّة فاكهة الشّيطان

181
00:17:07,540 --> 00:17:08,900
!الجاذبيّة؟

182
00:17:12,810 --> 00:17:14,510
...وجسدي

183
00:17:20,570 --> 00:17:25,440
إذًا؟ هل فهمت الأمر يا إيس؟

184
00:17:27,030 --> 00:17:27,900
!...لا يمكن

185
00:17:53,170 --> 00:17:58,970
لا بدّ أنّه مضى وقتٌ طويل
.مذ لكمك أحد يا إيس

186
00:17:59,790 --> 00:18:04,110
!أظنّ أنّك أدركتَ الأمر عندما أمسكتُ بك

187
00:18:05,670 --> 00:18:08,880
...الشّيء الآخر الّذي يسحبه ظلامي هو

188
00:18:08,880 --> 00:18:10,920
!قوى فاكهة الشّيطان

189
00:18:12,120 --> 00:18:14,480
،ما يعني أنّني بينما ألمسهم

190
00:18:14,480 --> 00:18:18,010
لا يمكن لحاملي قوّة فاكهة الشّيطان
!استخدام أيٍّ من قواهم

191
00:18:19,210 --> 00:18:22,060
!لوغيا وزون وباراميسيا

192
00:18:22,060 --> 00:18:26,560
في وجه عالمٍ من حاملي قوّة فاكهة الشّيطان
،الّذين يملكون ثقةً مفرطة في قدراتهم

193
00:18:26,560 --> 00:18:29,620
!قد اكتسبتُ وسيلةً هجوميّة لا يمكن صدّها

194
00:18:32,050 --> 00:18:33,630
لا يجب أن أدعك تلمسني فحسب، صحيح؟

195
00:18:34,050 --> 00:18:38,240
سبق وأثبتّ لك أنّك لا تستطيع
!الهرب من جاذبيّة ظلامي

196
00:18:38,240 --> 00:18:40,010
!ماء الظّلام

197
00:18:43,930 --> 00:18:45,270
!نار الإله: النّار المجهولة

198
00:18:46,560 --> 00:18:47,680
!خذ هذه

199
00:19:03,060 --> 00:19:06,290
!...سحقًا! رماح النّار

200
00:19:07,360 --> 00:19:09,290
!كسر بعض فِقراتي

201
00:19:11,260 --> 00:19:14,160
!...قوّته الجديدة مزعجة

202
00:19:15,090 --> 00:19:17,110
!نار الصّليب

203
00:19:28,890 --> 00:19:31,600
!إنّ صخرة الموزة... تنهار

204
00:19:32,980 --> 00:19:36,980
!ما الّذي يجري؟ لا يعقل أن يكونا من البشر

205
00:19:38,530 --> 00:19:44,000
!انسوا أمر القرية
!ما الّذي سيحدث... لجزيرتنا؟

206
00:19:53,390 --> 00:19:57,780
افترضتُ أنّ حاملي قوّة فاكهة
الشّيطان منهمكين جدًّا في قواهم

207
00:19:57,780 --> 00:20:01,040
لدرجة أنّهم سيصبحون خصومًا
.ضعاف عندما يفقدونها

208
00:20:01,040 --> 00:20:06,740
لكن كان يجب أن أتوقّع
من أحد قادة اللّحية البيضاء

209
00:20:06,740 --> 00:20:09,270
.أن يكون مقاتلاً مهيبًا في القتال الأساسيّ أيضًا

210
00:20:15,890 --> 00:20:21,400
.وها هو اليوم يقودنا إلى مفترق طرق مصيريّ آخر

211
00:20:37,810 --> 00:20:40,680
!كلّ شيء يُصبح بلا حول ولا قوّة أمام الظّلام

212
00:20:40,680 --> 00:20:43,260
.حتّى شخص بقوّتك

213
00:20:44,020 --> 00:20:47,470
.لكنّ هذا يزيدني شوقًا للحصول على قوّتك

214
00:20:48,380 --> 00:20:51,450
!إيس، انضمّ لطاقمي

215
00:20:58,550 --> 00:21:03,050
إن خنعتُ للقوّة، فلا مغزى
.من أن تلدني أمّي رجلاً

216
00:21:04,270 --> 00:21:07,850
!لن أترك شيئًا أندم عليه لاحقًا في حياتي

217
00:21:07,850 --> 00:21:09,030
هل فهمت أيّها الغبيّ؟

218
00:21:11,100 --> 00:21:13,970
إلى متى تستطيع العيش بهذا
المبدأ في هذا العالم؟

219
00:21:13,970 --> 00:21:17,000
!هذه خسارة يا إيس

220
00:21:19,040 --> 00:21:20,960
!فلتمت في الظّلام

221
00:21:21,690 --> 00:21:24,050
:وصيّة اللّهب العظيمة

222
00:21:31,830 --> 00:21:33,520
!إمبراطور اللّهب

223
00:21:41,990 --> 00:21:45,450
!الشّمس أو الظلاّم... يوجد فائز واحد بينهما

224
00:21:46,650 --> 00:21:50,490
!سأجعل من اللّحية البيضاء الملك

225
00:22:22,110 --> 00:22:25,250
"معركة جزيرة بانارو الحاسمة"
...في الغراند لاين

226
00:22:26,360 --> 00:22:30,320
...سيُعتبر القتال بين هذين الاثنين

227
00:22:30,320 --> 00:22:36,110
.سبب وقوع حادثة هائلة في وقت قريب

228
00:22:45,300 --> 00:22:47,630
!إلى بحر المغامرة

229
00:22:47,630 --> 00:22:49,550
!لنتّجه مباشرةً إلى جزيرة البرمائيّين

230
00:22:49,550 --> 00:22:54,180
لا، لا، لا، لا! بوجودنا قرب العالم
!الجديد، علينا أخذ فائق الحذر

231
00:22:54,180 --> 00:22:55,770
.يا سانجي! ثمّة سفينة

232
00:22:55,770 --> 00:22:57,440
.إنّها تفتقر للشّراع والرّاية

233
00:22:57,440 --> 00:22:59,890
!هل نبحر نحو المشاكل بأقصى سرعة من الآن؟

234
00:22:59,890 --> 00:23:01,230
:في الحلقة القادمة من وان بيس

235
00:23:01,230 --> 00:23:04,940
!عصابة القراصنة الغامضة"
"!ساني والفخّ الخطير

236
00:23:04,940 --> 00:23:07,320
!ملك القراصنة، لن يكون إلاّ أنا

237
00:23:09,990 --> 00:23:15,000
نلقاكم في الحلقة القادمة