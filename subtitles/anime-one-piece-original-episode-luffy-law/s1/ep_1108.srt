1
00:00:10,870 --> 00:00:19,040
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

2
00:00:23,660 --> 00:00:26,500
في نهاية الأحلام، في نهاية البحر

3
00:00:26,500 --> 00:00:29,000
لكلّ واحد منّا مكان يسعى إليه

4
00:00:29,000 --> 00:00:32,010
ولكن أوّلاً، علينا صنع

5
00:00:32,010 --> 00:00:36,890
أسطورة لامعة من أنفسنا

6
00:00:37,190 --> 00:00:39,720
شرارات متطايرة من هنا بلا حدود

7
00:00:39,720 --> 00:00:41,350
!وان بيس

8
00:00:41,350 --> 00:00:43,980
سنخبر جميعنا الرّحّالة

9
00:00:43,980 --> 00:00:47,980
هل ما زالت أحلامكم واضحة؟

10
00:00:49,360 --> 00:00:56,030
خلاياي الّتي لا تنام تدغدغني وتنفجر

11
00:00:56,030 --> 00:01:02,500
وحتّى الآن، جميعنا في خضمّ مغامرة

12
00:01:02,500 --> 00:01:05,120
سنخبر جميعنا الرّحّالة

13
00:01:05,120 --> 00:01:08,880
لا توجد قتالات بلا معنى

14
00:01:10,540 --> 00:01:17,010
إن كان السّياق العشوائيّ بدأ يصير منطقيًّا

15
00:01:17,010 --> 00:01:23,600
فإنّ خيوط الزّمن ستُحاك

16
00:01:23,600 --> 00:01:29,730
معنا، سيستمرّ العالم في التّغيّر

17
00:01:29,730 --> 00:01:36,860
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

18
00:01:42,830 --> 00:01:45,620
!مرحبًا بالجميع، كيف حالكم؟

19
00:01:45,750 --> 00:01:50,580
،معكم موسيقيّ طاقم قبّعة القشّ
!العظام الميتة" بروك"

20
00:01:50,750 --> 00:01:54,550
!إنّك مزعج حقًّا بصراخك هكذا في الصّباح الباكر

21
00:01:54,670 --> 00:01:57,340
هل نسيت يا زورو-سان؟

22
00:01:57,470 --> 00:02:00,010
أخبرتك مئات المرّات
،أنّنا في هذا اليوم الجميل

23
00:02:00,140 --> 00:02:03,060
.سنقدّم تقريرًا عن اليونكو

24
00:02:03,180 --> 00:02:07,100
...اليونكو؟ تذكّرتُ ذلك الآن

25
00:02:07,270 --> 00:02:10,560
.وخاصّة أنّنا قد نضطرّ لمواجهتهم قريبًا

26
00:02:10,730 --> 00:02:12,770
.لذلك لا أرى ضررًا من مراجعة طفيفة

27
00:02:12,900 --> 00:02:14,980
.نعم، لا يمكننا أن نخسر

28
00:02:15,150 --> 00:02:17,950
.لنجهّز خطّة ونستخدم أدمغتنا بالكامل

29
00:02:18,070 --> 00:02:20,610
.مع أنّي لا أملك أيّ دماغ

30
00:02:22,620 --> 00:02:27,410
.تغيّر العالم كثيرًا أثناء تواجدنا في بلاد وانو

31
00:02:27,540 --> 00:02:30,250
.لنراجع ما نعرفه عن اليونكو

32
00:02:30,370 --> 00:02:34,800
،اليونكو... سواء كانوا أقوياء أم لا
.فسأقطع أيّ عدوّ يقف أمامي

33
00:02:34,920 --> 00:02:38,420
،قبل أن نبدأ هذه المراجعة
هل نشرب بعض الشّاي؟

34
00:02:38,550 --> 00:02:40,930
!دع ذلك لوقت لاحق! لنبدأ فحسب

35
00:02:41,050 --> 00:02:42,680
!يا إلهي! كم أنت قاسٍ

36
00:02:42,800 --> 00:02:44,760
...حسنًا إذًا! دعونا

37
00:02:44,890 --> 00:02:46,560
!نبدأ

38
00:02:47,850 --> 00:02:52,980
"!التّاريخ يُكتب! اضطرابات اليونكو القدامى والجدد"

39
00:02:56,120 --> 00:03:00,070
.أوّلاً، لنتطرّق إلى ثلاثة من اليونكو السّابقين

40
00:03:00,490 --> 00:03:05,410
سنبدأ مع إدوارد نيوغيت
.قبطان قراصنة اللّحية البيضاء

41
00:03:05,620 --> 00:03:10,160
.كانت مكافأته 5 مليارات و46 مليون بيري

42
00:03:10,290 --> 00:03:14,630
كان قرصانًا عظيمًا بنفس مستوى
!ملك القراصنة غولد روجر

43
00:03:14,840 --> 00:03:19,380
.لم أقابله أبدًا، لكن يبدو أنّه رجل قويّ بالفعل

44
00:03:19,970 --> 00:03:24,550
،فور أن أدعهم يصعدون على سفينتي
.أعبرتهم أولادي جميعًا، مهما كانوا طائشين

45
00:03:24,800 --> 00:03:28,720
أين ستخلّد روح ابني المقتول؟

46
00:03:28,890 --> 00:03:34,100
من مسؤوليّتي أن أري ذلك الغبيّ تيتش

47
00:03:34,100 --> 00:03:38,780
أنّه لا يستطيع شقّ طريقه في العالم إن كان
!يفتقر إلى الشّريعة الأخلاقيّة، صحيح؟

48
00:03:39,070 --> 00:03:42,360
.ما زال من المبكّر عليك بمائة سنة لتخبرني ما أفعل

49
00:03:48,240 --> 00:03:52,830
!لن يستطيع أيّ أحد إيقاف هذا العصر الطّائش

50
00:03:53,710 --> 00:03:55,880
!لا شيء يدعو للخوف

51
00:03:56,040 --> 00:03:58,940
!أنا اللّحية البيضاء

52
00:04:01,670 --> 00:04:06,140
!ها هو قادم
!الزّلزال البحريّ الّذي أطلقه قبل قليل

53
00:04:06,350 --> 00:04:08,970
!سيأتي على شكل تسونامي

54
00:04:15,230 --> 00:04:17,780
!جعلت منه فاكهة الاهتزاز رجلَ زلازل

55
00:04:17,900 --> 00:04:21,860
!اللّحية البيضاء إدوارد نيوغيت

56
00:04:22,610 --> 00:04:27,660
رجل الزّلازل القادر على إحداث
.زلازل بعد أكله لفاكهة الاهتزاز

57
00:04:27,850 --> 00:04:31,160
.عُرف سابقًا بالقرصان الأقوى في العالم

58
00:04:31,500 --> 00:04:35,110
.وجميع قادته بمن فيهم ماركو-سان أقوياء للغاية

59
00:04:35,250 --> 00:04:38,280
.حتّى كوزكي أودن-سان كان جزءًا من طاقهم

60
00:04:38,490 --> 00:04:42,830
.فهمت الآن. كان رجلاً ليس ككلّ الرّجال إذًا

61
00:04:44,470 --> 00:04:47,180
!كلّي يقين أنّ أحدهم سيجده

62
00:04:48,680 --> 00:04:51,930
!وأنّ ذلك اليوم سيحين

63
00:04:57,560 --> 00:04:59,900
...الوان بيس

64
00:05:01,400 --> 00:05:04,110
!موجود بالفعل

65
00:05:10,030 --> 00:05:13,370
،انطلق لإنقاذ إيس-سان الّذي كان سيُعدم في مارينفورد

66
00:05:13,500 --> 00:05:15,500
،ما أدى إلى نشوب حرب القمّة

67
00:05:15,620 --> 00:05:17,770
.وهناك فارق الحياة

68
00:05:17,900 --> 00:05:20,980
.عاش حياة مذهلة في كلّ الأحوال

69
00:05:22,740 --> 00:05:25,850
،لننتقل الآن إلى قبطانة قراصنة بيغ مام

70
00:05:26,000 --> 00:05:27,800
.شارلوت لينلين

71
00:05:27,940 --> 00:05:32,560
.المكافأة على رأسها 4 مليارات و388 مليون بيري

72
00:05:32,810 --> 00:05:37,560
ويضمّ طاقمها أزيد من مائة عضو
،من عائلتها الحقيقيّة

73
00:05:37,690 --> 00:05:39,270
.ويقومون بدور ضبّاطها

74
00:05:39,650 --> 00:05:44,350
قامت باختطاف سانجي-سان الّذي
.وجد نفسه وسط زواج سياسيّ

75
00:05:44,490 --> 00:05:48,570
.لكان وضعنا أفضل بكثير بدون الطّبّاخ الفاشل

76
00:05:48,730 --> 00:05:50,200
.لا يجب عليك قول ذلك

77
00:05:50,570 --> 00:05:52,790
،بسبب فاكهة الأرواح

78
00:05:52,950 --> 00:05:56,960
صارت قادرة على أخذ أجزاء من
.أعمار النّاس ومزجه بأيّ غرض كان

79
00:05:57,400 --> 00:06:01,840
.والأسوأ من ذلك هو أنّها تحبّ جمع الأجناس

80
00:06:01,980 --> 00:06:04,210
.كاد ينتهي بي الأمر ضمن مجموعتها

81
00:06:06,630 --> 00:06:08,550
...حياة

82
00:06:08,880 --> 00:06:12,700
أم حلوى؟

83
00:06:27,540 --> 00:06:29,610
.أعطني 40 سنة

84
00:06:34,580 --> 00:06:39,420
.اتّحد تورا-أو-سان وكيد-سان للإطاحة بها معًا

85
00:06:39,580 --> 00:06:41,000
.أذكر ذلك

86
00:06:41,130 --> 00:06:44,210
!أتعتقدان أنّ بإمكانكما الإطاحة بي؟
!أنا بيغ مام

87
00:06:45,840 --> 00:06:47,880
!لذلك السّبب بالتّحديد عليّ الإطاحة بك

88
00:06:48,920 --> 00:06:52,090
!المدفع الكهرومغناطيسيّ

89
00:06:53,420 --> 00:06:55,390
...العصر الّذي حكمتم فيه

90
00:06:57,390 --> 00:06:58,810
!قد ولّى الآن

91
00:07:05,240 --> 00:07:06,820
!التّالي هو... يا إلهي، إنّه هو

92
00:07:06,970 --> 00:07:09,830
.القائد الأعلى لقراصنة مملكة الحيوان، كايدو

93
00:07:09,980 --> 00:07:14,060
.المكافأة على رأسه 4 مليار و611 مليون و100 ألف بيري

94
00:07:14,240 --> 00:07:17,930
،كما أكل فاكهة السّمك الخرافيّة
.صنف التّنّين الأزوريّ

95
00:07:18,060 --> 00:07:20,460
.وصار بإمكانه التّحوّل إلى تنّين

96
00:07:20,580 --> 00:07:23,920
.لم أتوقّع أبدًا أن يتحالف مع بيغ مام

97
00:07:25,920 --> 00:07:28,330
!نَفس الانفجار

98
00:07:40,910 --> 00:07:42,900
...سوف نضع

99
00:07:43,050 --> 00:07:45,690
...أيدينا أخيرًا

100
00:07:48,500 --> 00:07:51,400
!على كنز وان بيس العظيم

101
00:07:52,950 --> 00:07:55,410
...إنّ وجود الأسلحة القديمة

102
00:07:56,000 --> 00:07:59,700
!سيجلب معه الخوف والحرب في هذا العالم

103
00:08:00,700 --> 00:08:02,370
!جهّزوا أنفسكم

104
00:08:02,620 --> 00:08:08,210
!ذلك هو عالم العنف الّذي نصبوا إليه

105
00:08:12,130 --> 00:08:14,380
...فاكهة المطّاط

106
00:08:14,760 --> 00:08:17,220
.صعود التّنّين

107
00:08:19,350 --> 00:08:21,860
...مسدّس الإله

108
00:08:22,810 --> 00:08:25,810
!القرد

109
00:08:27,270 --> 00:08:30,110
!باغوا اللّهب

110
00:08:30,910 --> 00:08:34,150
سأبني أقوى جيش في العالم

111
00:08:34,360 --> 00:08:36,560
وسأجعل هذا العالم المملّ

112
00:08:36,700 --> 00:08:39,510
.عالمًا تحكمه القوّة

113
00:08:41,200 --> 00:08:43,620
!لا يوجد من هو أقوى منّي

114
00:08:45,630 --> 00:08:49,090
!ستغادر هذه البلاد

115
00:08:51,670 --> 00:08:54,130
استطاعت لكمة لوفي-سان المشحونة بالقناعات

116
00:08:54,300 --> 00:08:57,570
.هزيمة أقوى مخلوق في العالم أخيرًا

117
00:08:57,720 --> 00:09:00,390
.هذا هو المتوقّع من قبطاننا

118
00:09:00,560 --> 00:09:05,330
وهكذا تمّ إسقاط كايدو وبيغ مام
.من على عرشيهما كيونكو

119
00:09:05,480 --> 00:09:07,770
.وظهر يونكو جدد

120
00:09:08,960 --> 00:09:12,150
.تمّ الإعلان عن أحدهم قبل مدّة ليست ببعيدة

121
00:09:12,280 --> 00:09:14,140
.المهرجّ العبقريّ باغي

122
00:09:14,280 --> 00:09:17,210
.مكافأته 3 مليارات و189 مليون بيري

123
00:09:17,350 --> 00:09:19,670
أنت تعرفه مسبقًا، صحيح يا زورو-سان؟

124
00:09:19,810 --> 00:09:23,280
،نعم، لكنّه عديم الفائدة تمامًا
.ليس قويًّا على الإطلاق

125
00:09:23,420 --> 00:09:28,170
.لا بدّ أنّ منحه هذا اللّقب كان خطأ كما قال لوفي

126
00:09:28,940 --> 00:09:32,300
.حدّدنا من هما المشتبه بهما الرّئيسيّين

127
00:09:32,920 --> 00:09:33,800
بهما؟

128
00:09:34,300 --> 00:09:36,550
!القرصان الملقّب بقبّعة القشّ لوفي

129
00:09:37,380 --> 00:09:40,810
!وقرصان آخر، المهرّج باغي

130
00:09:42,100 --> 00:09:43,560
!لِمَ أنا؟

131
00:09:43,710 --> 00:09:45,020
...لا أصدّق أنّك

132
00:09:45,290 --> 00:09:49,980
.كنتَ عضوًا في طاقم ملك القراصنة غولد روجر،

133
00:09:50,700 --> 00:09:52,150
كيف علمتَ ذلك؟

134
00:09:52,300 --> 00:09:56,650
،نعلم أيضًا أنّك أخ محلّف لـ"أحمر الشّعر" شانكس

135
00:09:56,780 --> 00:09:58,070
.أحد اليونكو

136
00:09:58,200 --> 00:09:59,820
!ماذا؟

137
00:10:00,320 --> 00:10:02,210
!صحيح، مهلاً لحظة

138
00:10:02,400 --> 00:10:06,950
بالغت البحريّة في تقديري
!بالتّأكيد لكنّه ليس بأمر سيّئ

139
00:10:07,080 --> 00:10:10,670
!أجل! لأنّ كلّ ذلك صحيح

140
00:10:10,820 --> 00:10:13,700
!إنّي أطوّر سمعتي هنا

141
00:10:14,060 --> 00:10:17,120
...إن حدث و

142
00:10:18,940 --> 00:10:22,180
،إن حدث وهزمت اللّحية البيضاء

143
00:10:22,350 --> 00:10:25,090
!حينها سأصبح أحد اليونكو

144
00:10:25,220 --> 00:10:27,600
...لا لا لا... سأذهب أبعد من ذلك وأصبح

145
00:10:28,950 --> 00:10:30,890
!ملك القراصنة

146
00:10:31,610 --> 00:10:37,110
وكالة قراصنة مرتزقة
خدمة توصيل باغي

147
00:10:31,690 --> 00:10:35,020
،بعد حرب القمّة، صار واحد من الشّيتشيبوكاي

148
00:10:35,150 --> 00:10:38,470
،وأسّس شركة باغي لخدمات التّوصيل

149
00:10:38,600 --> 00:10:40,120
.وهي وكالة قراصنة مرتزقة

150
00:10:42,780 --> 00:10:43,990
!أيّها القبطان باغي

151
00:10:44,120 --> 00:10:44,990
!ماذا هنالك؟

152
00:10:45,120 --> 00:10:48,160
!لا تتوقّف الطّلبات وحلازين الاتّصال تواصل الرّنين

153
00:10:49,500 --> 00:10:51,210
!جيّد، جيّد

154
00:10:52,460 --> 00:10:53,880
!يا رجال

155
00:10:54,290 --> 00:10:56,180
،كلّ من انتهى منكم من الأكل

156
00:10:56,300 --> 00:10:59,550
اذهبوا لساحات المعارك وعيثوا
!فيها فسادًا وانهبوها

157
00:11:02,510 --> 00:11:05,390
،بعد حلّ نظام الشّيتشيبوكاي

158
00:11:05,520 --> 00:11:10,210
،اتّحد مع كروكودايل وميهوك
،وهما أيضًا شيتشيبوكاي سابقين

159
00:11:10,360 --> 00:11:13,120
.وأسّسوا منظّمة جديدة

160
00:11:13,260 --> 00:11:17,540
.لا أصدّق أنّ عين الصّقر اتّحد مع أيّ أحد

161
00:11:17,690 --> 00:11:22,430
،ناهيك عن أخذ الأوامر من باغي
.ما عدت أفهم أيّ شيء

162
00:11:22,660 --> 00:11:25,580
!ما الّذي سيحلّ بحياتي؟

163
00:11:41,970 --> 00:11:43,890
.انظر يا زورو-سان

164
00:11:44,030 --> 00:11:46,780
ما هذا؟ ظلام؟

165
00:11:46,970 --> 00:11:49,520
.أنا أعرف من التّالي على القائمة

166
00:11:50,880 --> 00:11:54,610
،إنّه عقيد أسطول قراصنة اللّحية السّوداء
.مارشال د. تيتش

167
00:11:54,740 --> 00:11:58,440
.المكافأة على رأسه هي 3 مليارات و996 مليون بيري

168
00:11:58,580 --> 00:12:00,600
...إنّه يوسّع من تأثيره بسرعة

169
00:12:00,730 --> 00:12:03,810
.عن طريق سرقة قدرات آكلي فواكه الشّيطان

170
00:12:03,950 --> 00:12:06,450
.سبق وقابلته في جايا

171
00:12:06,580 --> 00:12:08,990
.كان رجلاً غامضًا جدًّا حينها

172
00:12:10,880 --> 00:12:13,260
!مسار الثّقب المظلم

173
00:12:33,370 --> 00:12:36,690
...الشّيء الآخر الّذي يسحبه ظلامي هو

174
00:12:36,810 --> 00:12:38,690
!قوى فاكهة الشّيطان

175
00:12:39,860 --> 00:12:42,190
،ما يعني أنّني بينما ألمسهم

176
00:12:42,320 --> 00:12:45,740
لا يمكن لحاملي قوّة فاكهة الشّيطان
!استخدام أيٍّ من قواهم

177
00:12:46,950 --> 00:12:49,660
!لوغيا وزون وباراميسيا

178
00:12:49,950 --> 00:12:54,250
في وجه عالمٍ من حاملي قوّة فاكهة الشّيطان
،الّذين يملكون ثقةً مفرطة في قدراتهم

179
00:12:54,370 --> 00:12:57,580
!قد اكتسبتُ وسيلةً هجوميّة لا يمكن صدّها

180
00:13:00,840 --> 00:13:04,190
.كان عضوًا من قراصنة اللّحية البيضاء

181
00:13:04,330 --> 00:13:08,850
،بعد أن قتل زميلاً له في الطّاقم
.هرب آخذًا معه فاكهة شيطان

182
00:13:09,050 --> 00:13:11,640
،والأسوأ من ذلك، عندما اقتحم إمبل داون

183
00:13:11,770 --> 00:13:15,390
.جنّد سجناء خطيرين من المستوى السّادس

184
00:13:15,540 --> 00:13:18,590
.كما استطاعوا الإطاحة باللّحية البيضاء في حرب القمّة

185
00:13:19,230 --> 00:13:22,430
لا يستطيع المرء امتلاك سوى قوّة
فاكهة شيطان واحدة، صحيح؟

186
00:13:22,570 --> 00:13:26,070
لذلك لماذا هو استثناء لتلك القاعدة؟

187
00:13:26,200 --> 00:13:27,320
.لا فكرة لديّ

188
00:13:28,780 --> 00:13:31,330
!أيّتها البحريّة

189
00:13:33,320 --> 00:13:37,040
!سأريكم ما أنا قادر عليه

190
00:13:38,210 --> 00:13:40,960
!سنصبح أعداءً ثانيةً

191
00:13:45,130 --> 00:13:46,860
!مسار الثّقب المظلم

192
00:13:52,260 --> 00:13:56,350
!تلك قوّة فاكهة الظّلام خاصّتي

193
00:13:56,730 --> 00:13:57,890
...والآن

194
00:13:58,770 --> 00:14:00,430
...هذه

195
00:14:04,110 --> 00:14:05,320
!...تلك الوقفة

196
00:14:13,530 --> 00:14:16,370
!جاذبيّة الظّلام تجلب الفناء التّامّ

197
00:14:16,820 --> 00:14:20,130
!وقوّة الزّلزال تدمّر كلّ شيء

198
00:14:20,570 --> 00:14:25,130
!وأنا أمتلك كليهما
!لا يستطيع أيّ أحد منافستي الآن

199
00:14:25,780 --> 00:14:29,050
!فأنا الرّجل الأقوى في العالم

200
00:14:29,180 --> 00:14:34,620
يبدو أنّه يطلق العنان لنفسه في كلّ
.مكان من العالم ويقول أشياء كهذه

201
00:14:35,140 --> 00:14:38,600
واثق تمام الثّقة أنّ كايدو
!لديه واحد على الأقلّ

202
00:14:40,700 --> 00:14:43,290
!أخبرني كم لديكم منها حتّى الآن

203
00:14:43,420 --> 00:14:47,820
سآخذ كلّ بونيغليف الطّريق
!الّتي حصلتم عليها إلى الآن

204
00:14:48,150 --> 00:14:51,990
!سيأخذ الفائز... كلّ شيء

205
00:14:58,480 --> 00:15:02,130
لننتقل إلى قائد قراصنة أحمر
!الشّعر شانكس

206
00:15:02,280 --> 00:15:06,540
مكافأته 4 مليارات و48 مليون
!و900 ألف بيري

207
00:15:06,710 --> 00:15:09,390
.كما أنّه أنقذ حياة لوفي-سان

208
00:15:09,550 --> 00:15:13,260
.حسب ما قاله لي، فهو ليس شخصًا شرّيرًا

209
00:15:21,190 --> 00:15:24,490
.أحسنتَ عملاً يا جنديّ البحريّة اليافع

210
00:15:25,570 --> 00:15:29,060
اللّحظات الجسورة الّتي أنشأتها بمخاطرتك بحياتك

211
00:15:29,190 --> 00:15:31,110
...غيّرت الآن

212
00:15:31,360 --> 00:15:35,370
!مصير العالم بشكل كبير

213
00:15:35,520 --> 00:15:39,770
لِمَ أحد اليونكو من العالم الجديد هنا؟

214
00:15:40,180 --> 00:15:42,540
!أحمر الشّعر شانكس

215
00:15:44,820 --> 00:15:46,740
...أنا هنا

216
00:15:50,470 --> 00:15:52,140
!لإنهاء هذه الحرب

217
00:15:58,770 --> 00:16:00,230
.اسمعوا جميعًا

218
00:16:02,600 --> 00:16:04,080
،حاليًّا

219
00:16:06,900 --> 00:16:09,990
!عليكم أن تفعلوا كما أقول

220
00:16:14,780 --> 00:16:17,200
ماذا؟ –
!سفينة مشبوهة خلفنا –

221
00:16:20,780 --> 00:16:24,500
،ثمّة أعضاء سي بي 9 على متنها
.يبدو هذا مثيرًا للقلق

222
00:16:27,250 --> 00:16:29,590
!لا أهتمّ. انطلقوا

223
00:16:33,130 --> 00:16:35,930
!أطلقوا! لا تدعوا أحمر الشّعر يقترب

224
00:16:43,980 --> 00:16:46,440
ماذا يفعله هؤلاء هنا؟

225
00:16:46,770 --> 00:16:47,860
ما هي غايتهم؟

226
00:16:48,400 --> 00:16:50,610
!لا ننقل أيّ كنوز معنا

227
00:16:51,300 --> 00:16:56,450
!شحنتنا الوحيدة فاكهة شيطان تحوّل آكلها إلى مطّاط

228
00:17:11,630 --> 00:17:13,140
...اسمع يا بيك

229
00:17:16,620 --> 00:17:19,000
أعتقد أنّ الوقت قد حان لنتحرّك
...ونسعى خلف

230
00:17:24,980 --> 00:17:26,740
.الوان بيس

231
00:17:28,060 --> 00:17:31,370
وتركنا الأفضل للنّهاية، وهو قبطاننا العزيز

232
00:17:31,520 --> 00:17:33,410
!مونكي د. لوفي-سان

233
00:17:33,550 --> 00:17:36,070
.المكافأة على رأسه هي 3 مليارات بيري

234
00:17:36,500 --> 00:17:39,780
.يضع العالم بأسره أعينه على هذا القرصان العظيم

235
00:17:39,910 --> 00:17:43,580
.أحبّه من أعماق قلبي، حتّى النّخاع

236
00:17:43,740 --> 00:17:46,350
.إنّ الاستماع للآخرين ليس من أفضل صفاته

237
00:17:46,490 --> 00:17:50,250
.ولكنّه لا يستسلم أبدًا في مواجهة الشّدائد

238
00:17:50,380 --> 00:17:55,020
...أحرق علم حكومة العالم ولكم تنّينًا سماويًّا

239
00:17:55,170 --> 00:17:57,680
!ولكن بالطّبع هناك جانب آخر للقصّة

240
00:17:58,130 --> 00:17:59,320
.سوغيكينغ

241
00:18:01,180 --> 00:18:03,390
.أطلق على ذلك العلم

242
00:18:03,680 --> 00:18:04,890
.عُلم

243
00:18:13,770 --> 00:18:14,530
!مستحيل

244
00:18:15,170 --> 00:18:20,450
!أعلن القراصنة الحرب ضدّ حكومة العالم

245
00:18:20,790 --> 00:18:22,470
!هل أنتم مجانين؟

246
00:18:22,610 --> 00:18:26,160
!لا تظنّوا أنّكم ستنجون بعد جعلكم للعالم بأسره عدوًّا لكم

247
00:18:26,310 --> 00:18:30,960
!تلك غايتي من الأساس

248
00:18:37,080 --> 00:18:39,130
!أنت تزعجني أيضًا-إيه

249
00:19:01,410 --> 00:19:05,820
وفي دريسروزا، قرّر بعض الأشخاص
.أن يخدموا تحت جناح لوفي

250
00:19:05,950 --> 00:19:10,350
أتمنّى لو كنتُ هناك لرؤية مثل تلك
!اللّحظة المثيرة للاهتمام

251
00:19:10,790 --> 00:19:12,630
.ها هو ذا يا لوفي-سينباي

252
00:19:14,510 --> 00:19:18,930
صرنا بعهدنا هذا أتباعًا لقبّعة القشّ لوفي-سينباي

253
00:19:18,930 --> 00:19:24,100
!وسنكون درعه ورمحه في كلّ الأحوال

254
00:19:24,430 --> 00:19:28,270
،ولردّ الجميل الّذي قام به من أجلنا
...فنحن السّبعة

255
00:19:28,270 --> 00:19:31,900
،سنشرب أكواب الأبناء هذه بمحض إرادتنا

256
00:19:31,900 --> 00:19:35,060
!مكرّسين حياتنا وأرواحنا

257
00:19:37,720 --> 00:19:39,340
!أكواب الأبناء؟

258
00:19:46,080 --> 00:19:48,200
!ما الّذي تفعلونه؟

259
00:19:48,360 --> 00:19:53,940
لنحتفل بتشكيل أسطول قبّعة القشّ
!المتكوّن من أزيد من 5600 عضو

260
00:19:54,960 --> 00:19:58,630
!شكرًا جزيلاً مقدّمًا أيّها الزّعيم الكبير قبّعة القشّ

261
00:19:58,780 --> 00:19:59,960
!ماذا؟

262
00:20:00,920 --> 00:20:03,610
!مهلاً! لم أشرب منه، مفهوم؟

263
00:20:04,310 --> 00:20:06,760
!رغم أنّه فارغ لسبب ما

264
00:20:06,890 --> 00:20:07,970
!كان لذيذًا

265
00:20:08,390 --> 00:20:12,690
وأنت أيّها الغرّ، ما العالم
الّذي تظنّ أنّ بإمكانك بناؤه؟

266
00:20:12,980 --> 00:20:14,670
!يا قبّعة القشّ

267
00:20:20,320 --> 00:20:23,140
...عالم يستطيع فيه أصدقائي

268
00:20:29,190 --> 00:20:31,290
...أكل ما يودّون

269
00:20:32,390 --> 00:20:34,210
!من الطّعام

270
00:20:38,040 --> 00:20:41,800
،وفي بلاد وانو، هزم لوفي-سان كايدو
،أقوى مخلوق في العالم

271
00:20:42,010 --> 00:20:44,130
.وصار بعدها يونكو، أحد أباطرة البحر الأربعة

272
00:20:54,190 --> 00:20:57,400
!أجل! كان معكم ملك السّول

273
00:20:57,560 --> 00:21:01,070
.رُفع السّتار عن حقبة جديدة، ويونكو جدد

274
00:21:01,230 --> 00:21:03,480
.إنّه عالم جديد بالفعل

275
00:21:03,630 --> 00:21:07,780
.تنتهي هنا مراجعتنا عن اليونكو يا أعزّائي

276
00:21:07,920 --> 00:21:11,580
.لن يكون التّعامل مع البقيّة سهلاً

277
00:21:11,760 --> 00:21:14,860
.سيجد لوفي-سان طريقة للفوز كالعادة

278
00:21:15,000 --> 00:21:18,900
نعم، ما هذه إلاّ البداية نحو الحصول
.على لقب ملك القراصنة

279
00:21:19,110 --> 00:21:20,850
.سيبدأ كلّ شيء الآن

280
00:21:22,420 --> 00:21:25,670
،وليصير لوفي ملكَ القراصنة

281
00:21:25,810 --> 00:21:29,230
.فمن الأفضل أن نبذل كلّ ما لدينا

282
00:21:29,380 --> 00:21:33,690
.مهلاً، لقد حان الوقت
أتريد بعض الشّاي؟

283
00:21:33,860 --> 00:21:34,580
.شكرًا لك

284
00:21:35,140 --> 00:21:36,540
،سيّداتي وآنساتي وسادتي

285
00:21:36,690 --> 00:21:39,900
!إلى لقاء آخر

286
00:21:45,900 --> 00:21:51,490
إلى أيّ مدى هربنا؟

287
00:21:51,490 --> 00:21:58,620
نعدّ النّدوب دون أن نعرف

288
00:21:58,620 --> 00:22:05,880
وفي بالي دائمًا، خريطة كنز

289
00:22:05,880 --> 00:22:12,350
أبحث باستمرار عن المستقبل

290
00:22:12,350 --> 00:22:25,900
توجد الوعود الحقيقيّة عميقًا في القلب

291
00:22:25,900 --> 00:22:35,370
للجميع أحلام لا يستطيع أحد اللّحاق بها

292
00:22:35,370 --> 00:22:41,000
تمسّكوا بذلك الحلم فقط

293
00:22:41,000 --> 00:22:48,130
إليك يا من تبتسم مثل الشّمس

294
00:22:48,130 --> 00:22:55,100
لنغنّ نفس الأغنية مثل ذلك اليوم

295
00:22:55,100 --> 00:23:02,150
حتّى إن كبر بنا العمر، لا أريد أن أنسى

296
00:23:02,150 --> 00:23:09,570
إلى أن تصلك هذه الأمنية

297
00:23:19,400 --> 00:23:22,900
يُرغِم هجوم السّيرافيم لوفي
!وطاقهم للّجوء إلى الدّفاع

298
00:23:23,040 --> 00:23:26,380
،وفي مثل هذا الوضع اليائس
يتّخذ لوفي قرارًا مفاجئًا

299
00:23:26,520 --> 00:23:28,920
.لمواجهة هذا العدوّ الصّعب

300
00:23:29,090 --> 00:23:31,180
.طاقم قبّعة القشّ وسي بي 0

301
00:23:31,340 --> 00:23:35,350
وهكذا يتشكّل تحالف غير تقليديّ
!يتجاوز عداوتهم

302
00:23:35,500 --> 00:23:36,970
:في الحلقة القادمة من وان بيس

303
00:23:37,110 --> 00:23:40,140
"!قرار صعب! جبهة متحالفة غير اعتياديّة"

304
00:23:40,330 --> 00:23:42,740
!ملك القراصنة، لن يكون إلاّ أنا