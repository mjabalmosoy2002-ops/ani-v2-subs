1
00:00:19,150 --> 00:00:21,660
هل تمّ إصدار أمر "نداء الدّمار"؟

2
00:00:22,110 --> 00:00:23,510
.لا، ما زال علينا أن نكون متأهّبين

3
00:00:24,360 --> 00:00:26,090
!أسرعوا

4
00:00:26,090 --> 00:00:28,120
!لنهرب إلى سفينة الإخلاء

5
00:00:31,540 --> 00:00:34,100
هذا هو البونيغليف إذًا؟

6
00:00:34,250 --> 00:00:38,560
نعم. سمعتُ أنّه حتّى إن حاولنا
.تفجيره، فلن يخدشه ذلك حتّى

7
00:00:39,040 --> 00:00:43,590
يا له من حجر مريب... لا أصدّق
...أنّ هذه الأشياء منتشرة حول العالم

8
00:00:44,690 --> 00:00:50,440
،ابدؤوا الرّكض، ابدؤوا الرّكض
حاملين أعلامنا عاليًا في السّماء

9
00:00:56,780 --> 00:01:02,040
فلنعبر هذا البحر الواسع بحثًا

10
00:01:02,870 --> 00:01:07,920
عن معجزة عالميّة لم يرها أيّ أحد من قبل

11
00:01:08,840 --> 00:01:13,720
سنتقدّم للأمام كما نشاء وقلوبنا تنبض

12
00:01:13,720 --> 00:01:19,600
نتبع خطى أولئك الّذي يلاحقون أحلامهم

13
00:01:20,430 --> 00:01:26,390
،مهما كانت اللّيالي عاصفة
،فإن وحّدنا قلوبنا معًا

14
00:01:26,390 --> 00:01:30,520
فسنتمكّن من الاستمرار

15
00:01:30,650 --> 00:01:31,900
!على الدّوام

16
00:01:32,780 --> 00:01:38,530
،ابدؤوا الرّكض، ابدؤوا الرّكض
حاملين أعلامنا عاليًا في السّماء

17
00:01:38,620 --> 00:01:44,580
،رغم أنّ هنالك دموعًا ستُذرف
فلا نودّ أن يراها أيّ أحد

18
00:01:44,790 --> 00:01:50,500
،لاحقوه، لاحقوه
،إن أردنا تحقيق أحلامنا

19
00:01:50,630 --> 00:01:53,210
علينا التّقدّم مباشرة للأمام دائمًا دون خوف

20
00:01:53,210 --> 00:01:55,380
لا يمكننا التّوقّف

21
00:01:55,510 --> 00:01:58,380
حول العالم

22
00:01:58,550 --> 00:01:59,800
!ابدؤوا معي

23
00:02:02,850 --> 00:02:08,520
،ابدؤوا الرّكض، ابدؤوا الرّكض
وتجاوزوا الجميع

24
00:02:08,650 --> 00:02:14,530
،وما دمنا لن نهرب منه
فبإمكاننا التّمسّك بالغد بأيدينا

25
00:02:14,610 --> 00:02:20,490
،لاحقوه، لاحقوه
،كلّ شيء نراه أمام أعيننا

26
00:02:20,570 --> 00:02:25,370
فلنحفره في صفحات قلوبنا البيضاء

27
00:02:25,660 --> 00:02:28,370
عالم جديد بالكامل

28
00:02:28,580 --> 00:02:29,790
!ابدؤوا معي

29
00:02:38,870 --> 00:02:42,520
"!مأساة أوهارا! رعب نداء الدّماء"

30
00:02:46,230 --> 00:02:47,630
أهذا صحيح؟

31
00:02:47,630 --> 00:02:50,020
.نعم، إنّهم يستحقّون عقوبة الموت

32
00:02:50,800 --> 00:02:54,160
،بما أنّنا حصلنا على الدّليل
.فسننفّذ أوامركم

33
00:02:54,630 --> 00:02:58,480
،ما باليد حيلة. هذا مؤسف للغاية

34
00:02:58,480 --> 00:03:03,110
.ولكنّهم انتهكوا قوانين العالم
.لا يمكننا غضّ النّظر عن ذلك

35
00:03:03,110 --> 00:03:06,710
كفاكم من الحديث السّطحيّ الواضح
.أيّها الشّيوخ النّجوم الخمسة

36
00:03:06,980 --> 00:03:12,280
!ما...! لا تتصرّف بفظاظة
!إنّك تتحدّث مع شيوخ العالم

37
00:03:12,280 --> 00:03:16,240
،أهذا هو الأستاذ كلوفر من أوهارا
كبير علماء الآثار؟

38
00:03:17,510 --> 00:03:22,100
أنا على علم تامّ باسمك بما
.أنّك ساهمت كثيرًا لثقافة العالم

39
00:03:22,370 --> 00:03:25,540
لا أصدّق أنّ شخصًا من مستواك
...قد يسير على الطّريق الخطأ

40
00:03:25,540 --> 00:03:28,320
.ينتمي الماضي لكلّ البشريّة

41
00:03:29,170 --> 00:03:35,580
لا يملك أحد الحقّ لإيقاف الآخر من
!الرّغبة في معرفة تاريخنا المجهول

42
00:03:35,580 --> 00:03:36,450
...أيّها الأستاذ

43
00:03:36,720 --> 00:03:40,770
إنّ قراءة البونيغليف تجعل من السّهل
،إعادة السّلاح العتيق للحياة

44
00:03:40,770 --> 00:03:42,730
.ممّا يضع العالم في خطر

45
00:03:44,020 --> 00:03:46,020
،حتّى إن كان لبحثكم نوايا حسنة

46
00:03:46,020 --> 00:03:49,030
فكلّ ما يتطلّبه الأمر
.هو استغلال أحد ما لبحثكم

47
00:03:50,530 --> 00:03:54,530
مهما حدث في الماضي، إن كانت
،البشريّة من أنشأت ذلك التّاريخ

48
00:03:54,530 --> 00:03:56,250
.فعلينا قبوله بالكامل

49
00:03:56,770 --> 00:03:58,790
،إن لم نستسلم لخوفنا ونتعلّم كلّ التّاريخ

50
00:03:58,790 --> 00:04:01,410
سيكون بإمكاننا أخذ تدابير وقايّة
.مهما كان ما سيحدث

51
00:04:01,410 --> 00:04:02,710
.هذه حجّة مثاليّة

52
00:04:02,710 --> 00:04:07,470
أتظنّ ذلك؟ أليس ذلك التّفكير
مجرّد عذر مناسب لكم؟

53
00:04:08,710 --> 00:04:11,670
،من بين ما تُرك لنا

54
00:04:11,670 --> 00:04:16,300
ما يهمّنا أكثر هو محتوى
البونيغليف، إلى جانب سبب

55
00:04:16,300 --> 00:04:17,860
.تواجدها في المقام الأوّل

56
00:04:18,390 --> 00:04:22,310
لماذا تكبّد القدماء عناء نقش
نصوص على حجارة قاسية

57
00:04:22,310 --> 00:04:25,190
بهدف تمريرها للمستقبل؟

58
00:04:25,190 --> 00:04:27,400
لقد نقشوا التّاريخ على حجارة لا تكسر

59
00:04:27,400 --> 00:04:29,860
.ووزّعوها حول العالم

60
00:04:29,860 --> 00:04:33,610
أليس السّبب هو اعتقادهم
أنّ رسالتهم ستُمحى

61
00:04:33,610 --> 00:04:37,830
إن كتبوها على أوراق في كتب؟

62
00:04:38,120 --> 00:04:41,950
بعبارة أخرى، إنّها دليل أنّ من
تركوا لنا البونيغليف، من الواضح

63
00:04:41,950 --> 00:04:43,850
.أنّه كان لديهم عدوّ

64
00:04:46,330 --> 00:04:49,130
ما الّذي تحاول قوله أيّها الأستاذ كلوفر؟

65
00:04:49,130 --> 00:04:52,090
إذا افترضنا أنّهم هُزموا على يد عدوّ ما

66
00:04:52,090 --> 00:04:54,420
،وأبيدوا من الوجود بعدها

67
00:04:54,420 --> 00:04:57,860
فلا بدّ أنّ هذا العدوّ ما زال موجودًا
.في التّاريخ منذ تلك اللّحظة

68
00:04:59,850 --> 00:05:05,940
وشاءت الصّدف، أنّه عند نهاية
،القرن الفارغ" قبل 800 سنة"

69
00:05:06,480 --> 00:05:10,660
.تمّ تأسيس حكومة العالم

70
00:05:13,780 --> 00:05:18,620
"إن كانت حكومة العالم الحاليّة هي "عدوّ
،أولئك الّذين أبيدوا من الوجود

71
00:05:18,620 --> 00:05:22,120
"يستطيع المرء أن يظنّ أنّ "القرن الفارغ
هو تاريخ غير مناسب

72
00:05:22,120 --> 00:05:25,600
.تمّ التكتّم عليه من طرف حكومة العالم

73
00:05:25,790 --> 00:05:31,310
وعن طريق تحليل الوثائق
،القديمة وبعض البونيغليف

74
00:05:31,630 --> 00:05:35,270
.لاحظنا في النّهاية وجود بلد معيّن

75
00:05:35,550 --> 00:05:41,220
ما ألقت عليه الوثائق النّور
.هو وجود مملكة عظيمة

76
00:05:41,220 --> 00:05:44,180
رغم أنّها كانت تتباهى بقوّتها
،الكبيرة في الماضي

77
00:05:44,180 --> 00:05:48,560
إلاّ أنّ المعلومات عن هذه البلاد
.قد مُحيت بحرص شديد

78
00:05:48,560 --> 00:05:52,450
على الأرجح أنّهم شعروا أنّهم سيُهزمون
،على يد البلدان المتحالفة

79
00:05:52,800 --> 00:05:54,740
،الّتي أصبحت لاحقًا حكومة العالم

80
00:05:54,740 --> 00:05:59,790
فقاموا بنقش الحقيقة كلّها على تلك
.الحجارة لتمريرها لأجيال المستقبل

81
00:06:00,440 --> 00:06:04,260
،وتلك الحجارة هي البونيغليف بالطّبع
.والّتي ما زالت موجودة ليومنا هذا

82
00:06:05,160 --> 00:06:08,210
.فهمت. هذه فرضيّة جريئة

83
00:06:08,210 --> 00:06:11,730
.صحيح أنّ السّلاح العتيق سيهدّد العالم

84
00:06:11,960 --> 00:06:17,550
ولكن، ألا تشعر حكومة العالم
في الحقيقة بتهديد أكبر

85
00:06:17,550 --> 00:06:22,810
من أن يصبح النّاس على علم
بوجود تلك المملكة وأيديولوجيّاتها؟

86
00:06:24,570 --> 00:06:28,190
،ما زال علينا أن نحلّل ما هو هذا التّهديد

87
00:06:28,190 --> 00:06:33,580
لكن اسم هذه المملكة الّتي ازدهرت في
...الماضي وتحمل مفتاح حلّ كلّ شيء

88
00:06:38,360 --> 00:06:39,210
!اقضوا عليه

89
00:06:49,920 --> 00:06:51,960
!أيّها الأستاذ

90
00:06:54,920 --> 00:06:56,440
...إنّ أوهارا

91
00:06:59,910 --> 00:07:00,810
!أوغاد

92
00:07:00,810 --> 00:07:01,810
!كيف تجرؤون...؟

93
00:07:01,810 --> 00:07:03,580
!أيّها الأستاذ كلوفر

94
00:07:04,510 --> 00:07:06,350
.تعرف أكثر ممّا يجب

95
00:07:08,890 --> 00:07:10,950
.أعطوا الإشارة للهجوم

96
00:07:11,770 --> 00:07:13,860
!لا تتحرّكوا

97
00:07:13,860 --> 00:07:16,130
.لا تسمحوا لأيّ أحد بالهرب

98
00:07:23,450 --> 00:07:26,200
حسنًا، باستعمال حلزون الاتّصال الذّهبيّ هذا

99
00:07:26,200 --> 00:07:28,430
...الّذي أعطاه لي الأميرال سنغوكو

100
00:07:28,430 --> 00:07:29,750
!أيّها الأستاذ

101
00:07:29,750 --> 00:07:31,370
...روبين

102
00:07:31,370 --> 00:07:34,880
!حمقاء! لا يجب أن تكوني هنا. اهربي

103
00:07:35,170 --> 00:07:36,860
!"سأطلق "نداء الدّمار

104
00:07:37,590 --> 00:07:39,020
.اهتمّوا بالباقي

105
00:07:40,310 --> 00:07:42,260
!فعل شيئًا ما

106
00:07:43,510 --> 00:07:46,510
.أسرعي نحو سفينة الإخلاء يا روبين

107
00:07:46,510 --> 00:07:48,680
!كلاّ! لا أريد الذّهاب وحدي

108
00:07:48,680 --> 00:07:51,810
.كفاك حماقة في وقت كهذا

109
00:07:53,320 --> 00:07:54,330
...روبين

110
00:07:58,440 --> 00:08:00,160
!"هذا طلب "نداء الدّمار

111
00:08:00,650 --> 00:08:03,880
!لتأخذ كلّ السّفن الحربيّة مواقعها
!استعدّوا لإطلاق النّار

112
00:08:06,410 --> 00:08:07,860
...مهلاً

113
00:08:07,860 --> 00:08:08,740
!انظروا

114
00:08:09,950 --> 00:08:12,250
!شجرة المعرفة تحترق

115
00:08:12,620 --> 00:08:15,170
!ما الّذي تفعلونه يا حكومة العالم؟

116
00:08:15,170 --> 00:08:18,700
!يجب أن يكون القضاء علينا كافيًا

117
00:08:18,700 --> 00:08:22,440
لا علاقة لي بهذا. لا بدّ أنّها احترقت
.بسبب الانفجارات السّابقة

118
00:08:25,140 --> 00:08:26,430
!هذا هراء

119
00:08:26,430 --> 00:08:29,260
!هل تدرك مدى أهمّيّة الوثائق الّتي هناك؟

120
00:08:29,260 --> 00:08:30,430
!أنت! لا تتحرّك

121
00:08:30,720 --> 00:08:32,920
.نعم... ما عدنا نحتاج للمسدّسات

122
00:08:34,640 --> 00:08:36,580
.ليتراجع موظّفو الحكومة

123
00:08:38,220 --> 00:08:40,010
!أسرعوا وأنقذوا الكتب

124
00:08:41,730 --> 00:08:43,670
!أخمدوا الحريق في المكتبة

125
00:08:54,330 --> 00:08:56,090
!أحضروا الماء

126
00:08:58,130 --> 00:08:59,850
!أخرجوا الكتب من المكتبة

127
00:09:14,430 --> 00:09:16,480
.أحضروا تلك المرأة معنا

128
00:09:17,440 --> 00:09:18,340
.تعالي

129
00:09:20,040 --> 00:09:23,290
.ثمّة معلومة معيّنة لا يعرفها سواها

130
00:09:24,280 --> 00:09:25,750
.ستكون مشكلة إن ماتت هنا

131
00:09:30,270 --> 00:09:31,510
.أمّي

132
00:09:35,790 --> 00:09:40,130
.روبين...! أرجوك... اهربي من هنا

133
00:09:40,130 --> 00:09:42,140
!لا تموتي مهما حدث

134
00:09:43,170 --> 00:09:44,490
!هذا أنفك

135
00:09:48,340 --> 00:09:50,600
!روبين! اسرعي

136
00:09:50,600 --> 00:09:52,460
!غادري في الحال

137
00:09:56,230 --> 00:09:56,820
!روبين-تشان

138
00:09:56,820 --> 00:09:57,660
!روبين

139
00:10:06,360 --> 00:10:09,000
هل أنت أمّي؟

140
00:10:14,580 --> 00:10:17,430
أولفيا! هل ستصعدين
على متن السّفينة أم لا؟

141
00:10:17,960 --> 00:10:19,370
!أمّي

142
00:10:19,620 --> 00:10:21,850
!سأمسك بها، اذهبي بسرعة

143
00:10:20,930 --> 00:10:21,850
!أمّي

144
00:10:21,850 --> 00:10:24,500
!لا تذهبي! أمّي

145
00:10:24,500 --> 00:10:27,670
!أمّي! أمّي

146
00:10:27,670 --> 00:10:29,430
.آسفة يا روبين

147
00:10:29,430 --> 00:10:32,680
.لا يمكنني أبدًا وصف نفسي بأمّك ثانية

148
00:10:32,680 --> 00:10:37,450
لا يجب أن يُسمح لي... أن أكون
.أمّك بعد كلّ هذه السّنوات

149
00:10:46,570 --> 00:10:48,740
!وحش

150
00:10:49,110 --> 00:10:51,490
!لقد هجرتها أمّها

151
00:10:51,610 --> 00:10:54,410
!روبين! هذه ملابس ابنتي

152
00:10:54,410 --> 00:10:56,840
!آسفة أيّتها العمّة روجي
!أردت تجربتها لمرّة فحسب

153
00:10:57,160 --> 00:11:00,060
تأكلين الكثير بالنّسبة لشخص
.يعيش هنا بالمجّان

154
00:11:08,670 --> 00:11:10,110
...هل أنت

155
00:11:12,840 --> 00:11:14,400
!هي أمّي؟

156
00:11:20,700 --> 00:11:23,270
ماذا؟ لديك طفلة؟

157
00:11:25,570 --> 00:11:26,620
.لا

158
00:11:27,400 --> 00:11:28,700
...أولفيا-سان

159
00:11:29,650 --> 00:11:31,010
...أنا آسفة

160
00:11:32,660 --> 00:11:36,620
.لكن أظنّك تعتقدين أنّني شخص آخر

161
00:11:36,620 --> 00:11:41,190
سامحيني يا روبين! لا أريد أن أجعلك
!"منك "ابنةَ مجرمة

162
00:11:41,460 --> 00:11:43,130
...أولفيا

163
00:11:43,710 --> 00:11:45,840
.يا لها من فتاة غريبة

164
00:11:45,840 --> 00:11:47,380
.هيّا بنا

165
00:12:02,390 --> 00:12:05,230
!أنا روبين

166
00:12:05,230 --> 00:12:09,360
!لقد كبرت، ألذلك لا تتذكّرينني؟

167
00:12:09,360 --> 00:12:12,320
!كنت في انتظار عودتك طوال هذا الوقت

168
00:12:12,320 --> 00:12:13,730
...هل أنت فعلاً

169
00:12:15,320 --> 00:12:17,030
...لستِ

170
00:12:17,950 --> 00:12:19,490
أمّي؟

171
00:12:21,000 --> 00:12:23,750
...أردتك

172
00:12:23,750 --> 00:12:25,310
...أن تمسكي بيدي

173
00:12:26,750 --> 00:12:29,270
...وتسيري معي يومًا ما

174
00:12:29,270 --> 00:12:34,380
لذلك درست بجدّ وتمكّنت
!من أن أصبح عالمة آثار

175
00:12:34,380 --> 00:12:36,300
!أستطيع قراءة البونيغليف أيضًا

176
00:12:38,510 --> 00:12:39,650
!تلك الشّقيّة؟

177
00:12:39,650 --> 00:12:41,150
!توقّفي يا روبين

178
00:12:41,850 --> 00:12:43,140
...لذلك

179
00:12:43,140 --> 00:12:46,120
!دعيني... أبقى معك أرجوك

180
00:12:46,560 --> 00:12:48,130
!أمّي

181
00:12:48,900 --> 00:12:50,090
!...روبين

182
00:12:51,730 --> 00:12:53,090
...أرجوك

183
00:12:54,150 --> 00:12:55,370
...لا تتركيني

184
00:12:56,660 --> 00:12:58,660
!وحدي بعد الآن

185
00:13:18,340 --> 00:13:21,680
!ماذا؟! ما هذا الهجوم؟

186
00:13:21,680 --> 00:13:23,410
."أنا أنفّذ "نداء الدّمار

187
00:13:24,480 --> 00:13:26,820
!ابدؤوا إطلاق نار مكثّف

188
00:13:26,820 --> 00:13:30,990
،هدفنا هو كلّ ما في أوهارا
!جزيرة علم الآثار

189
00:13:30,990 --> 00:13:36,280
البحث الّذي أنجزه علماء أوهارا
.قد بلغ مستوى لا يمكننا تخيّله

190
00:13:36,280 --> 00:13:40,780
.يمكن للمعرفة أن تنتقل
.لا تدعوها تخرج من هذه الجزيرة

191
00:13:40,780 --> 00:13:45,790
!أبيدوا الشّياطين الّذين في أوهارا
!باسم العدالة

192
00:13:50,130 --> 00:13:52,590
!سُحقًا! ما الّذي يحدث؟

193
00:13:52,590 --> 00:13:56,680
!لن نغادر الجزيرة بعد
!هل يحاولون قتلنا؟

194
00:13:58,040 --> 00:14:00,400
!تضرب القذائف شجرة المعرفة مباشرة أيضًا

195
00:14:00,400 --> 00:14:03,060
لا مجال للشّكّ في أنّ هذه
.هي قوّة المقرّ العسكريّة

196
00:14:03,060 --> 00:14:07,150
على الأرجح أنّ الحكومة كانت ستقوم
بهذا من البداية. يا للحماقة

197
00:14:07,640 --> 00:14:10,660
أيّها الرّئيس. قالت تلك الشّقيّة
.أنّها عالمة آثار أيضًا

198
00:14:10,660 --> 00:14:14,150
.نعم، قالت ذلك بالفعل
،لا أدري إن كان ذلك صحيحًا أم لا

199
00:14:14,450 --> 00:14:17,120
،لكن في حال الشّكّ
.سيحلّ القضاء عليهم المشكلة

200
00:14:17,120 --> 00:14:20,120
تذكّرا وجهها جيّدًا لكي لا تسمحا
.لها بمغادرة الجزيرة

201
00:14:20,490 --> 00:14:21,660
!لننسحب

202
00:14:21,660 --> 00:14:22,750
.سآخذ أولفيا إذًا

203
00:14:24,820 --> 00:14:28,040
!انسيا أمرها! لا وقت لذلك الآن
!دعاها هنا فحسب

204
00:14:28,040 --> 00:14:30,540
!سنُقتل أيضًا إن بقينا هنا

205
00:14:30,790 --> 00:14:33,260
!حياتي هي أكثر ما يهمّني

206
00:14:33,500 --> 00:14:36,060
!تراجعوا جميعًا! عودوا للسّفينة

207
00:14:44,660 --> 00:14:46,660
!افعلوا شيئًا حيال نيران المكتبة

208
00:14:47,000 --> 00:14:48,870
!احموا شجرة المعرفة

209
00:15:10,090 --> 00:15:11,580
...أردت فعل هذا

210
00:15:15,410 --> 00:15:16,800
!منذ وقت طويل

211
00:15:20,080 --> 00:15:21,410
!روبين

212
00:15:24,330 --> 00:15:26,020
!أمّي

213
00:15:29,170 --> 00:15:31,770
...إنّها غلطتي... يا روبين

214
00:15:32,540 --> 00:15:35,740
هل صحيح أنّك تستطيعين قراءة البونيغليف؟

215
00:15:36,820 --> 00:15:39,930
...لو أنّني راقبتك جيّدًا

216
00:15:40,820 --> 00:15:44,410
أنا آسفة. أردت أن أصبح قادرة
—على قراءتها بأيّ ثمن

217
00:15:44,410 --> 00:15:48,380
تفاجأت بالفعل لمعرفتي أنّك أصبحت
.قادرة على فعل أشياء كهذه

218
00:15:48,870 --> 00:15:52,290
.لا بدّ أنّك بذلت جهدًا كبيرًا ودرست كثيرًا

219
00:15:52,290 --> 00:15:56,090
.هذا ليس أمرًا في متناول الكثيرين
!هذا مذهل يا روبين

220
00:16:02,840 --> 00:16:07,120
لحسن الحظّ، أولئك الموظّفون هم
.الوحيدون الّذين يعرفون بالأمر

221
00:16:07,430 --> 00:16:09,680
.لا وقت للجلوس مكتوفي الأيدي

222
00:16:09,680 --> 00:16:12,190
!أولفيا! خذي روبين واهربا

223
00:16:12,190 --> 00:16:15,230
إن تمكّنت من أخذ روبين
،لسفينة الإخلاء خلسة

224
00:16:15,230 --> 00:16:16,580
!فبإمكانكما مغادرة الجزيرة

225
00:16:20,490 --> 00:16:23,700
!روبين! ها أنت ذي
!بحثت في كلّ مكان عنك

226
00:16:23,700 --> 00:16:24,910
!ساول

227
00:16:25,070 --> 00:16:27,160
!إذًا فقد تمكّنت من رؤية أولفيا

228
00:16:27,160 --> 00:16:30,010
!ساول! ما الّذي تفعله على هذه الجزيرة؟

229
00:16:30,010 --> 00:16:35,840
شاء هذا القدر الملتوي، أن تتحطّم
.سفينتي وتنقذني روبين عند الشّاطئ

230
00:16:35,840 --> 00:16:38,030
!لكن الأهمّ من ذلك الآن، نحن في وضع فظيع

231
00:16:38,460 --> 00:16:40,220
!عليكما مغادرة الجزيرة في الحال

232
00:16:40,760 --> 00:16:41,920
!اعتنِ بروبين رجاءً

233
00:16:41,920 --> 00:16:44,140
ساعد ابنتي على الهرب
!من هذه الجزيرة بأيّ ثمن

234
00:16:44,140 --> 00:16:48,320
!ماذا؟! كلاّ! ماذا عنك يا أمّي؟
!ألن تأتين معي؟

235
00:16:49,590 --> 00:16:50,780
...أولفيا... ما الّذي سوف

236
00:16:51,350 --> 00:16:53,700
...ما زال هنالك أمر عليّ فعله هنا

237
00:16:53,940 --> 00:16:58,010
!أمّي! لا أريد أن أفترق عنك
!تمكّنت أخيرًا من لقائك

238
00:16:58,010 --> 00:16:59,330
!سأبقى هنا أيضًا

239
00:16:59,750 --> 00:17:01,360
...روبين

240
00:17:01,360 --> 00:17:04,360
،أنت من علماء أوهارا
.عليك أن تدركي هذا جيّدًا

241
00:17:04,360 --> 00:17:06,320
.التّاريخ هو كنز البشريّة

242
00:17:06,320 --> 00:17:09,540
سوف ينير بكلّ تأكيد مستقبلكم
.أنتم اليافعين الّذين ستعيشون فيه

243
00:17:09,850 --> 00:17:13,290
لكنّ التّاريخ الّذي تلقّيناه
من الماضي سيُدمّر

244
00:17:13,290 --> 00:17:15,880
.ما لم نمرّره إلى الحقبة التّالية

245
00:17:15,880 --> 00:17:16,890
!أخمدوا النّار

246
00:17:16,890 --> 00:17:17,850
!احموا الكتب

247
00:17:18,570 --> 00:17:21,840
الكشف عن التّاريخ ليس
.ما كانت أوهارا تحاول فعله

248
00:17:21,840 --> 00:17:24,310
.أردنا قبول أصوات الماضي وحمايتها فحسب

249
00:17:25,180 --> 00:17:31,000
سينتهي بحثنا الآن، لكن حتّى
...إن أبيدت أوهارا الآن

250
00:17:32,480 --> 00:17:37,460
لا يمكننا التّخلّي عن المستقبل
!الّذي ستعيشون فيه أنتم

251
00:17:38,690 --> 00:17:40,150
!لا أفهم هذا

252
00:17:42,040 --> 00:17:44,400
.ستفهمين يومًا ما

253
00:17:47,120 --> 00:17:49,460
!هيّا خذها يا ساول

254
00:17:52,140 --> 00:17:53,300
هل أنت واثقة من هذا؟

255
00:17:53,640 --> 00:17:54,620
.نعم

256
00:17:55,500 --> 00:17:58,690
!كلاّ! سأبقى هنا أيضًا! أمّي

257
00:17:59,250 --> 00:18:01,670
!أمّي

258
00:18:01,670 --> 00:18:04,450
.كم سعدت بسماعك تناديني بذلك

259
00:18:05,420 --> 00:18:06,660
!شكرًا لك

260
00:18:07,430 --> 00:18:10,360
...من الآن فصاعدًا، من أجل كلتينا

261
00:18:10,360 --> 00:18:11,620
!عيشي يا روبين

262
00:18:30,170 --> 00:18:32,160
!يا نائب الأميرال! يا نائب الأميرال كوزان

263
00:18:32,160 --> 00:18:33,300
!ماذا؟

264
00:18:33,300 --> 00:18:36,130
!على الجزيرة... نعم، لا شكّ في هذا

265
00:18:36,130 --> 00:18:39,670
!ما الّذي يحدث؟! قل ما لديك بسرعة

266
00:18:39,670 --> 00:18:42,220
!إنّه نائب الأميرال ساول الفارّ

267
00:18:42,630 --> 00:18:44,600
!ساول! عد أرجوك

268
00:18:44,600 --> 00:18:46,860
!كلاّ! لا يمكنني ذلك

269
00:18:47,460 --> 00:18:49,810
!روبين! كوني فخورة يا روبين

270
00:18:50,050 --> 00:18:53,770
!أمّك أمرأة مشرِّفة! أوهارا مشرِّفة

271
00:18:53,770 --> 00:18:58,310
عليك يومًا ما، أن تمرّري تاريخ
!هذه الجزيرة يا روبين

272
00:18:58,560 --> 00:19:02,190
!قاتلت أوهارا ضدّ العالم

273
00:19:05,070 --> 00:19:07,720
!توقّفوا! الإمساك بهم كان كافيًا

274
00:19:08,370 --> 00:19:10,670
!إنّهم ليسوا قراصنة عنيفين حتّى

275
00:19:10,670 --> 00:19:13,880
!هل أنتم ضعفاء لدرجة لا تستطيعون إيقافهم؟

276
00:19:13,880 --> 00:19:17,040
أمسكنا بالعديد من سفن اكتشاف
،التّاريخ من قبل

277
00:19:17,040 --> 00:19:20,860
.لكن لا أفهم لماذا عليهم أن يموتوا

278
00:19:21,290 --> 00:19:24,550
!يا نائب الأميرال ساول! وجدنا ناجية

279
00:19:25,310 --> 00:19:26,760
!كيف تجرؤون على قتل رفاقي العلماء؟

280
00:19:28,340 --> 00:19:30,730
هل تسعون خلف السّلاح بالفعل؟

281
00:19:31,130 --> 00:19:32,180
...يا لبؤسكم

282
00:19:32,970 --> 00:19:34,890
،لا تملكون حتّى إرادة خاصّة بكم
...ومع ذلك تطلقون الأحكام علينا

283
00:19:34,890 --> 00:19:36,350
!تمهّلي! إنّه نائب أميرال

284
00:19:36,350 --> 00:19:39,800
لا تشكّكون بالقوانين وتقولون
!أنّها لمنع إعادة السّلاح للحياة

285
00:19:40,940 --> 00:19:44,780
إنّكم خائفون من التّاريخ
!الّذي تجهلونه فحسب

286
00:19:46,480 --> 00:19:47,840
.هذه مهمّة بالغة السّرّيّة

287
00:19:48,140 --> 00:19:50,000
نداء الدّمار"؟"

288
00:19:50,420 --> 00:19:54,100
خمس نوّاب أميرالات يقودون عشر
."سفن حربيّة لتلبية "نداء الدّمار

289
00:19:54,100 --> 00:19:55,500
.أريدك أن تكون واحدًا منهم

290
00:19:55,660 --> 00:19:59,620
إنّهم مجرّد علماء. لماذا علينا
التّمادي لهذا الحدّ؟

291
00:19:59,620 --> 00:20:02,120
!أولئك العلماء الّذين قبضنا عليهم أيضًا

292
00:20:02,120 --> 00:20:05,460
يبدون بالفعل وكأنّهم يريدون
!معرفة التّاريخ فحسب

293
00:20:05,460 --> 00:20:09,230
،إن كان بحثهم خطيرًا لهذه الدّرجة
!على الحكومة مساعدتهم أيضًا

294
00:20:09,630 --> 00:20:12,150
!نحن من عليهم قتل النّاس بالفعل

295
00:20:12,640 --> 00:20:15,680
!أعطني دليلاً بأنّهم أشرار بالكامل

296
00:20:15,680 --> 00:20:18,650
هل تشكّك في الحكومة؟
!لا تعارض! اتّبع الأوامر فحسب

297
00:20:23,810 --> 00:20:27,410
.أودّ أن أسألك بعض الأسئلة

298
00:20:27,410 --> 00:20:31,370
حالة طارئة! أخذ نائب الأميرال
.ساول المجرمة وفرّ هاربًا

299
00:20:32,570 --> 00:20:35,850
.إنّه يعلم كلّ شيء عن العمليّة

300
00:20:36,280 --> 00:20:39,040
!الحقوا بهما! أمسكا بساول وأولفيا مهما كان

301
00:20:39,790 --> 00:20:41,290
!لديكم الإذن بإطلاق النّار عليهما

302
00:20:41,960 --> 00:20:44,990
!إنّهم يطاردوننا! سأتولّى أمرهم

303
00:20:45,170 --> 00:20:47,970
.لن تتمكّن من العودة للبحريّة ثانية يا ساول

304
00:20:48,340 --> 00:20:52,940
لا بأس. لا يمكنني البقاء في البحريّة
.وأنا أحمل هذا الإحساس بعدم الثّقة

305
00:20:53,510 --> 00:20:57,640
،حتّى إن كانوا يمتثلون للأوامر
.فهذه العمليّة استبداديّة كثيرًا

306
00:20:57,640 --> 00:20:59,890
.أنا أتّبع حسّي بالعدالة فحسب

307
00:20:59,890 --> 00:21:02,850
والآن، أسرعي نحو بلدتك
.وأعلمي النّاس هناك

308
00:21:02,850 --> 00:21:04,400
.لن أشكرك على هذا

309
00:21:04,400 --> 00:21:06,340
.وأنا أتمنّى لك حظًّا سعيدًا

310
00:21:10,190 --> 00:21:11,540
!إطلاق

311
00:21:13,700 --> 00:21:15,830
!إنهم يصوّبون عليّ

312
00:21:21,120 --> 00:21:22,700
!ساول

313
00:21:23,040 --> 00:21:24,330
!لقد أصابته

314
00:21:24,330 --> 00:21:25,460
!أنا آسف

315
00:21:25,460 --> 00:21:28,880
!لا تعتذر! إنّه شريك أولئك الشّياطين

316
00:21:28,880 --> 00:21:32,760
.آسف يا روبين. لا بدّ أنّ ذلك أخافك

317
00:21:34,090 --> 00:21:35,850
.انتظري لحظة

318
00:21:36,310 --> 00:21:41,780
لا بدّ أنّه ذاك! تطلقون من هذا القرب؟
!ماذا إن أصبتم روبين؟

319
00:21:42,310 --> 00:21:44,730
!توقّف رجاءً يا نائب الأميرال
!ما الّذي تفعله؟

320
00:21:44,730 --> 00:21:49,900
لا أدري أين تتجلّى العدالة في هذا
!الموقف، لذلك سأحمي صديقتي فحسب

321
00:21:49,900 --> 00:21:52,040
!توقّف يا ساول

322
00:21:52,530 --> 00:21:53,900
!استعدّوا

323
00:21:53,900 --> 00:22:00,220
،إن جعلتم منّي عدوًّا لكم
!فسأُدفعكم الثّمن غاليًا

324
00:22:13,040 --> 00:22:17,140
نقاتل بعزم أكثر ضدّ الجدار الّذي يعترضنا

325
00:22:17,140 --> 00:22:21,060
نندفع للأمام بشدّة بقوّة متدفّقة

326
00:22:21,060 --> 00:22:25,190
لن نخشى شيئًا حتّى إن ضحّينا بكلّ شيء

327
00:22:25,190 --> 00:22:28,190
لأنّ كلّ ذلك لضمان أن نبتسم في النّهاية

328
00:22:29,610 --> 00:22:31,450
سنصبح الرّقم 1

329
00:22:31,450 --> 00:22:33,320
وسيكون هدفنا الحرّيّة في عالم العجائب

330
00:22:33,320 --> 00:22:35,530
انظروا، ثمّة نور خافت يرشدنا في الطّريق نحو الغد

331
00:22:35,530 --> 00:22:37,700
إنّه عصر صُنِع بالمخاطرة بكلّ شيء

332
00:22:37,700 --> 00:22:39,830
!نحاول دائمًا بذل ما بوسعنا، فهيّا بنا

333
00:22:39,830 --> 00:22:41,830
،إن أردنا أن ننال المجد

334
00:22:41,830 --> 00:22:43,210
فالآن هو الوقت لذلك... فلا تخافوا

335
00:22:43,210 --> 00:22:45,130
سنفوز بالمستقبل مع أصدقائنا بكلّ تأكيد

336
00:22:45,130 --> 00:22:49,090
والآن، سنبدأ الرّكض بسرعة نحو عالم واسع

337
00:22:49,090 --> 00:22:53,090
لا يمكننا الانطلاق بقوى مجهولة

338
00:22:53,090 --> 00:22:55,350
فلا خوف بداخلنا ولا تردّد

339
00:22:55,350 --> 00:22:59,060
...مهما حدث، فبالتّأكيد في النّهاية

340
00:22:59,060 --> 00:23:03,100
سنقاتل بعزم أكثر ضدّ الجدار الّذي يعترضنا

341
00:23:03,100 --> 00:23:07,070
نندفع للأمام بشدّة بقوّة متدفّقة

342
00:23:07,070 --> 00:23:11,320
لن نخشى شيئًا حتّى إن ضحّينا بكلّ شيء

343
00:23:11,320 --> 00:23:13,320
لنندفع للأمام

344
00:23:13,320 --> 00:23:15,200
لنبدأ الرّكض نحو الغد

345
00:23:15,200 --> 00:23:18,200
