1
00:00:23,830 --> 00:00:27,290
!تجاوزنا الكثير من العقبات وخلّفناها

2
00:00:38,350 --> 00:00:45,690
[.أنا على وشك الوصول، ولم يبق إلاّ القليل حتّى أصل للجواب]

3
00:00:45,770 --> 00:00:53,400
ذاك ما أؤمن به وأنا أبحر في هذا العالم الجديد

4
00:00:53,440 --> 00:01:00,870
أجل، اتّحدت أجزاء أحلامنا لتصير واحدًا

5
00:01:00,910 --> 00:01:08,960
!نحن مرتبطون بروابط لا تتزعزع، فلنتّجه صوب غد مشرق

6
00:01:17,470 --> 00:01:20,760
!تجاوزنا الكثير من العقبات وخلّفناها

7
00:01:20,850 --> 00:01:24,810
!والآن لنكمل رحلتنا إلى المستقبل

8
00:01:24,890 --> 00:01:26,310
!اصقلوا مهاراتكم أكثر

9
00:01:26,350 --> 00:01:28,520
!أبقوا رؤوسكم شامخة مرفوعة

10
00:01:28,560 --> 00:01:29,940
!ارتقوا دومًا

11
00:01:29,980 --> 00:01:31,860
!وحلّقوا فوق الأمواج

12
00:01:31,900 --> 00:01:35,450
اتّحدت رغباتنا مع بعضها بحذر

13
00:01:35,490 --> 00:01:39,660
!فلنتقدّم الآن نحو المستقبل

14
00:01:39,950 --> 00:01:46,080
نندفع إلى الأمام راكبين الأمواج

15
00:01:46,120 --> 00:01:50,290
نلتقي بأشخاص ونودّعهم، ونعيد الكرّة

16
00:01:50,340 --> 00:01:54,550
...تحت هذا العلم

17
00:01:56,300 --> 00:01:59,680
الألم الّذي لا آبى نسيانه دفين في قلبي

18
00:01:59,760 --> 00:02:03,220
نقشته برويّة هناك ذات يوم

19
00:02:03,310 --> 00:02:06,890
لن أسمح لأيّ أحد بالاستيلاء على حرّيّتي

20
00:02:06,890 --> 00:02:09,770
!فأنا أطبق عليها بين يديّ

21
00:02:18,450 --> 00:02:21,660
!تجاوزنا الكثير من العقبات وخلّفناها

22
00:02:21,700 --> 00:02:25,830
!والآن لنكمل رحلتنا إلى المستقبل

23
00:02:25,870 --> 00:02:27,210
!اصقلوا مهاراتكم أكثر

24
00:02:27,250 --> 00:02:29,540
!أبقوا رؤوسكم شامخة مرفوعة

25
00:02:29,540 --> 00:02:30,920
!ارتقوا دومًا

26
00:02:30,960 --> 00:02:32,750
!وحلّقوا فوق الأمواج

27
00:02:32,790 --> 00:02:36,460
اتّحدت رغباتنا مع بعضها بحذر

28
00:02:36,550 --> 00:02:40,010
!فلنتقدّم الآن نحو المستقبل

29
00:02:49,310 --> 00:02:52,730
...كلّ القراصنة الّذين يسعون وراء الوان بيس

30
00:02:52,730 --> 00:02:57,710
.يقصدون العالم الجديد، الشّطر الثّاني من الغراند لاين

31
00:02:59,970 --> 00:03:06,410
لكن، لم يكتشفه أيّ أحد قطّ
.عدا غولد روجر، ملك القراصنة

32
00:03:07,340 --> 00:03:13,070
.دمّر العالم الجديد أحلام وطموحات الكثير من القراصنة

33
00:03:14,370 --> 00:03:20,680
والآن، مونكي د. لوفي، صبيّ تحوّل جسده
،إلى مطّاط بعد أن أكل فاكهة المطّاط

34
00:03:20,680 --> 00:03:22,380
.وأصدقاؤه يغامرون في ذلك البحر

35
00:03:23,070 --> 00:03:26,500
!ملك القراصنة، لن يكون إلاّ أنا

36
00:03:30,040 --> 00:03:32,470
،بعد نجاتهم من معركة حامية

37
00:03:32,470 --> 00:03:35,270
.يدخل طاقم قبّعة القشّ العالم الجديد أخيرًا

38
00:03:38,410 --> 00:03:42,490
،رسوا في بانك هازارد، جزيرة من جزئين
،أحدها مشتعل بالنّيران والآخر متجمّد

39
00:03:43,110 --> 00:03:45,600
وقد أُسروا في قفص

40
00:03:45,600 --> 00:03:49,120
على يد سيزار كلاون الّذي يحكم الجزيرة

41
00:03:49,120 --> 00:03:52,620
.وتعرّضوا لشينوكوني، سلاح دمار شامل

42
00:03:52,620 --> 00:03:58,210
لكنّهم هربوا من القفص بفضل مناورات
حليفهم الشّيتشيبوكاي ترافالغار لو البارعة

43
00:03:58,210 --> 00:04:00,460
.والتمّ شمل الطّاقم

44
00:04:01,670 --> 00:04:05,370
يمتلك المكان بأكمله بالغاز السّامّ
،خارج هذا المختبر الآن

45
00:04:05,370 --> 00:04:10,310
لكن هنالك ممرّ واحد سيُجنّبنا الهواء
!في الخارج ويقودنا مباشرة للبحر

46
00:04:10,760 --> 00:04:17,820
"ثمّة بوّابة كبيرة كُتب عليها "ر-66
.وهي مدخل للممرّ المؤدّي للبحر

47
00:04:17,820 --> 00:04:22,460
لا أريد التّسبّب في مذبحة، ولكنّ ساعتين
.هي أقصى مدّة يمكنني منحها لكم

48
00:04:23,150 --> 00:04:25,950
،وإنّ من سيبقون منكم أطول من ذلك

49
00:04:25,950 --> 00:04:28,350
.لا يسعني ضمان سلامتهم

50
00:04:30,160 --> 00:04:35,240
!ثمّة في هذا المختبر أطفال اختُطفوا قبل سنتين

51
00:04:35,240 --> 00:04:39,960
!"جدوهم وتوجّهوا نحو البوّابة "ر-66

52
00:04:40,500 --> 00:04:44,510
!انتظرني يا مومونوسكي! سأنقذك مهما كلّف الأمر

53
00:04:44,510 --> 00:04:46,890
!يا لوفي

54
00:04:47,320 --> 00:04:49,650
!لا وقت للتّخاذل

55
00:04:49,650 --> 00:04:51,930
!هذه بداية العالم الجديد فحسب

56
00:04:52,610 --> 00:04:55,520
!نعم، آسف! لن أرخي دفاعاتي ثانية

57
00:04:56,250 --> 00:05:00,080
بينما لوفي في المقدّمة، يبدؤون تحرّكهم

58
00:05:00,080 --> 00:05:03,340
!لإنقاذ الأطفال واختطاف سيزار

59
00:05:05,110 --> 00:05:07,070
...فاكهة المطّاط

60
00:05:17,130 --> 00:05:18,420
!الصّحن الطّائر

61
00:05:38,240 --> 00:05:43,220
"!دموع تاشيغي! خطّة اختراق جي-5 اليائسة"

62
00:06:05,320 --> 00:06:06,880
!لماذا؟

63
00:06:12,470 --> 00:06:14,850
!لماذا هم داخل المبنى؟

64
00:06:18,690 --> 00:06:20,470
!السّماسرة يشاهدون هذا

65
00:06:20,470 --> 00:06:23,210
!سُحقًا! يا للإذلال

66
00:06:25,480 --> 00:06:29,290
...طاقم قبّعة القشّ ومجموعة جنود البحريّة

67
00:06:29,290 --> 00:06:32,030
!يركضون نحو الممرّ للهرب

68
00:06:46,330 --> 00:06:48,880
ماذا أفعل؟ ماذا أفعل؟

69
00:06:49,650 --> 00:06:51,140
!ماذا أفعل؟

70
00:07:03,370 --> 00:07:06,470
!ذلك السّيّد! إنّه أشبه بشيطان

71
00:07:06,470 --> 00:07:10,610
!لكن يبدو أنّ الجميع بخير

72
00:07:13,170 --> 00:07:14,950
.لا أدري من أعطاني هذه الورقة

73
00:07:15,420 --> 00:07:20,410
لكن هل كان يقصد أنّ لوفي
!والبقيّة بإمكانهم الهرب وحدهم؟

74
00:07:21,590 --> 00:07:23,880
كيف هربوا من ذلك القفص؟

75
00:07:23,880 --> 00:07:25,230
من أعطاني هذه؟

76
00:07:27,510 --> 00:07:29,490
.هذا غير مهمّ الآن

77
00:07:29,780 --> 00:07:31,300
!أنا طبيب

78
00:07:32,150 --> 00:07:34,340
!عليّ إنقاذ أولئك الأطفال

79
00:07:35,260 --> 00:07:40,150
!وجدت صيغة المخدّر ولديّ المهدّئات

80
00:07:40,150 --> 00:07:41,550
!انتظروني يا أطفال

81
00:07:41,550 --> 00:07:44,030
!سأعالجكم مهما كلّف الأمر

82
00:08:05,150 --> 00:08:07,670
!لكن عليّ أن أعرف أين أذهب أوّلاً

83
00:08:08,870 --> 00:08:10,810
ما الّذي يفعله جنودي؟

84
00:08:10,810 --> 00:08:14,130
!"انتقل جنود لمواجهتهم في المبنى "أ

85
00:08:14,130 --> 00:08:19,340
الوحدة الرّئيسيّة تتجهّز لاعتراضهم
!"وفي نقطة في مؤخّرة المبنى "ب

86
00:08:22,930 --> 00:08:27,190
.أنا واثق أنّ الهرب من الجزيرة هي غايتهم

87
00:08:27,190 --> 00:08:29,940
...ولذلك، لا بدّ أنّهم في الطّريق إلى

88
00:08:29,940 --> 00:08:34,350
!الممرّ المؤدّي للمبنى "ر" مباشرة، البوّابة 66

89
00:08:53,130 --> 00:08:55,470
!لن أسمح لهم بذلك

90
00:08:55,470 --> 00:08:59,390
!"أغلقوا الممرّ بين المبنيين "أ" و"ب

91
00:09:00,170 --> 00:09:03,690
!"أغلقوا البوّابة هناك واعزلوا المبنى "أ

92
00:09:08,550 --> 00:09:11,940
"وثمّ، دمّروا المبنى "أ

93
00:09:12,720 --> 00:09:14,700
!ودعوا شينوكوني يتسرّب إليه

94
00:09:14,700 --> 00:09:18,910
،ماذا؟! لكن إن فعلنا هذا
...فسيقتل ذلك حرّاسنا أيضًا

95
00:09:18,910 --> 00:09:21,010
!قم بذلك فحسب

96
00:09:21,010 --> 00:09:23,620
!لا تنس وضع حلازين اتّصال المراقبة

97
00:09:23,620 --> 00:09:26,500
...ماذا؟! سـ-سيّدي

98
00:09:26,500 --> 00:09:31,210
.لنبدأ هذه التّجربة المفتوحة من أجل السّماسرة

99
00:09:31,210 --> 00:09:35,330
!لم أرهم بعد كفائتي العلميّة العالية بالكامل

100
00:09:38,010 --> 00:09:39,730
!اذهب فحسب

101
00:09:39,730 --> 00:09:40,470
!حاضر

102
00:09:41,390 --> 00:09:43,220
!لا فائدة منهم

103
00:09:50,110 --> 00:09:52,690
ماذا ستفعل يا فيرغو؟

104
00:09:52,690 --> 00:09:57,070
.وحدهم الأغبياء سيقعون في فخّ كهذا

105
00:09:57,070 --> 00:10:00,580
لستَ الوحيد الّذي سيفقد ماء وجهه

106
00:10:00,580 --> 00:10:02,700
.إذا ما سمحتَ لسموكر ولو بالهرب يا سيزار

107
00:10:02,700 --> 00:10:04,660
.لا أستطيع أن أثق بك لتولّي هذا الأمر

108
00:10:06,210 --> 00:10:08,710
!سأقطع كلّ شيء

109
00:10:10,890 --> 00:10:12,600
.ماذا؟ هذا غريب

110
00:10:12,600 --> 00:10:14,130
.لا أستطيع إيجاد سيفي

111
00:10:14,940 --> 00:10:17,800
.أنت لست سيّافًا

112
00:10:18,620 --> 00:10:21,700
.صحيح، أنا لست سيّافًا

113
00:10:21,700 --> 00:10:25,310
.حسنًا، سأذهب لأطيح بأولئك الضّعفاء

114
00:10:29,470 --> 00:10:32,130
!أين أنت يا سيزار؟

115
00:10:30,850 --> 00:10:34,320
"مبنى المختبر "أ

116
00:10:42,160 --> 00:10:45,580
!لن أسمح لك بالعبور من هنا يا قبّعة القشّ

117
00:10:48,710 --> 00:10:51,210
!أنا حارس البوّابة للمبنى "ب" وقرصان سابق

118
00:10:51,210 --> 00:10:54,210
!يناديني النّاس رون الماتشيتي

119
00:10:54,210 --> 00:10:57,920
!باسم السّيّد سيزار، عالِم الحبّ

120
00:10:57,920 --> 00:10:59,850
!ليس لديك سيقان حيوانات

121
00:10:59,850 --> 00:11:01,840
!لا تروق لي أبدًا

122
00:11:02,580 --> 00:11:04,680
!أيّ نوع من القناطير أنت؟

123
00:11:05,010 --> 00:11:07,310
...أنا

124
00:11:07,310 --> 00:11:08,680
.عنكبوت

125
00:11:15,730 --> 00:11:17,730
!ابتعدوا عن طريقي

126
00:11:24,910 --> 00:11:28,870
"الممرّ بين المبنى "أ" و"ب

127
00:11:34,070 --> 00:11:35,750
!إنّه نفق ضخم

128
00:11:51,960 --> 00:11:54,480
لو! ما هذا الإنذار؟

129
00:11:55,410 --> 00:11:58,770
.إنّه للتّحذير بشأن إغلاق بوّابة ما في هذا المبنى

130
00:11:58,770 --> 00:12:02,200
."وذاك هو الممرّ الوحيد للمبنى "ب

131
00:12:02,510 --> 00:12:03,780
!ماذا؟

132
00:12:03,780 --> 00:12:06,540
.أظنّ أنّه يحاول إبقاءنا خارجًا

133
00:12:07,550 --> 00:12:10,910
.من الأفضل أن تخبر رجالك بأن يسرعوا

134
00:12:56,860 --> 00:13:01,130
لا أدري ما الّذي قصده ترافالغار لو عندما
،قال أنّ بإمكانه منحنا ساعتين فحسب

135
00:13:01,820 --> 00:13:05,030
!لكن لن نسمح لكم بالهرب يا طاقم قبّعة القشّ

136
00:13:05,030 --> 00:13:06,550
!لا مهرب لكم

137
00:13:15,500 --> 00:13:17,020
ما هذا الإنذار؟

138
00:13:17,730 --> 00:13:19,020
!إيّاكم

139
00:13:30,030 --> 00:13:31,620
!لا تقفوا في طريقنا

140
00:13:35,580 --> 00:13:36,670
!هذا مؤلم

141
00:13:37,490 --> 00:13:38,750
!هذا ساخن

142
00:13:40,210 --> 00:13:41,090
!هذا بارد

143
00:13:44,800 --> 00:13:47,360
!كم يُعتمد عليكم أيّها السّيّافون الثّلاثة

144
00:13:47,360 --> 00:13:48,510
!حسنًا، لننطلق

145
00:13:49,040 --> 00:13:50,260
!إنّهم قادمون

146
00:13:56,980 --> 00:14:01,700
أظنّ أنّ بإمكاننا الوصول إلى الأطفال
.بسهولة إن واصلنا على هذه الوتيرة

147
00:14:01,700 --> 00:14:04,150
.شكرا لك على حملنا أيّها اللّحية البنّيّة

148
00:14:04,730 --> 00:14:07,610
لا شكر على واجب. ولكن يا رفاق

149
00:14:07,610 --> 00:14:10,100
لماذا أحضرتم معكم ذلك التّنّين؟

150
00:14:10,100 --> 00:14:10,870
ماذا؟

151
00:14:13,330 --> 00:14:17,580
ظننّا أنّ بإمكاننا الهرب من الغاز
،بالطّيران على متنه

152
00:14:18,170 --> 00:14:20,380
.لكنّه لم يطر على الإطلاق

153
00:14:21,620 --> 00:14:25,210
.إنّه لا يطير الآن لأنّه حُقت بمهدّئات

154
00:14:25,610 --> 00:14:31,180
.لكنّ إدخاله معنا للمختبر لم تكن فكرة جيّدة

155
00:14:31,180 --> 00:14:32,630
أهو خطير؟

156
00:14:32,630 --> 00:14:34,600
...يبدو ظريفًا نوعًا ما

157
00:14:38,560 --> 00:14:41,120
!هذه فرصة نادرة لنا

158
00:14:41,120 --> 00:14:42,920
!لنطح بهم

159
00:14:42,920 --> 00:14:44,940
!سيكون فضل إبادتهم لي

160
00:14:44,940 --> 00:14:47,690
!ألم أقل لكم "إيّاكم"؟

161
00:15:20,190 --> 00:15:22,020
!أ-أيّتها النّقيب-تشان؟

162
00:15:24,150 --> 00:15:28,190
أرى أنّك صرت نقيبًا أيّتها المُقلِّدة؟

163
00:15:28,190 --> 00:15:30,240
.لكن لا روح قتاليّة لك

164
00:15:33,360 --> 00:15:35,370
.صحيح. واصلوا تقدّمكم فحسب

165
00:15:37,470 --> 00:15:39,330
!نعم، نعم

166
00:15:39,330 --> 00:15:40,780
!شكرًا جزيلاً لك

167
00:15:45,250 --> 00:15:46,590
!مهلاً

168
00:15:46,590 --> 00:15:50,900
!يا جي-5! هذا ليس وقتًا مناسبًا للقتال

169
00:15:50,900 --> 00:15:52,930
!اذهبوا للمرّ في الخلف حالاً

170
00:15:52,930 --> 00:15:54,140
!ماذا؟

171
00:15:54,140 --> 00:15:58,180
.البوّابة الوحيدة في هذا المبنى تُغلق الآن

172
00:15:58,810 --> 00:16:02,580
.يحاول سيزار محاصرتنا هنا

173
00:16:03,560 --> 00:16:05,950
،إن لم نستطع الوصول للجانب الآخر من البوّابة

174
00:16:05,950 --> 00:16:08,370
!فلن نستطيع الهرب من بانك هازارد

175
00:16:08,790 --> 00:16:10,110
!هيّا انطلقوا

176
00:16:10,110 --> 00:16:11,360
!ماذا؟

177
00:16:12,860 --> 00:16:14,740
!هذا سيّئ

178
00:16:14,740 --> 00:16:16,330
!أسرعوا يا رجال

179
00:16:16,330 --> 00:16:18,390
!افعلوا ما قالته تاشيغي-تشان

180
00:16:18,390 --> 00:16:20,120
!احملوا المصابين

181
00:16:21,200 --> 00:16:22,380
!أسرعوا

182
00:16:22,380 --> 00:16:25,730
!اذهبوا مباشرة للبوّابة

183
00:16:49,650 --> 00:16:50,980
!كم هذا فظيع

184
00:16:52,440 --> 00:16:54,480
روبين، أين كنت؟

185
00:16:54,480 --> 00:16:55,660
!روبين-تشان

186
00:16:57,070 --> 00:16:59,280
.طلب منّي لوفي القيام بأمر معيّن

187
00:16:59,280 --> 00:17:02,370
على أيّ حال، أسمعتَ ما قالته فتاة البحريّة؟

188
00:17:02,370 --> 00:17:04,560
!تماسك أيّها اللّحية البنّيّة-تشي

189
00:17:04,560 --> 00:17:06,320
!أسرع أكثر

190
00:17:06,320 --> 00:17:07,710
.هذا مستحيل

191
00:17:08,420 --> 00:17:10,430
.لا يمكنني الرّكض أسرع من هذا

192
00:17:12,250 --> 00:17:14,440
!ضقت ذرعًا من الرّكض

193
00:17:14,440 --> 00:17:15,990
هل تشتكي؟

194
00:17:15,990 --> 00:17:16,720
!لا

195
00:17:17,060 --> 00:17:20,680
!لست ساموراي، لذا سأشتكي

196
00:17:20,680 --> 00:17:22,680
!هذا يكفي

197
00:17:23,350 --> 00:17:27,220
!مهلاً، لماذا اللّحية البنّيّة مع أولئك القراصنة؟

198
00:17:27,220 --> 00:17:28,920
!ذلك الوغد

199
00:17:28,920 --> 00:17:30,770
!هل يخون السّيّد؟

200
00:17:30,770 --> 00:17:32,910
!السّيّد هو منقذنا العظيم

201
00:17:32,910 --> 00:17:34,120
!لنركّز في الرّكض فحسب

202
00:17:34,120 --> 00:17:35,760
!نحن في خطر أيضًا

203
00:17:41,600 --> 00:17:43,540
!هيّا يا جي-5

204
00:17:45,870 --> 00:17:47,660
!البوّابة هناك تمامًا

205
00:17:47,660 --> 00:17:48,290
!أسرعوا

206
00:17:48,290 --> 00:17:50,680
!سيُغلق قريبًا بالفعل

207
00:17:50,680 --> 00:17:52,760
!بسرعة، بسرعة

208
00:17:53,350 --> 00:17:56,070
!مدافع التّجربة، استعداد

209
00:18:04,350 --> 00:18:08,310
خارج المختبر

210
00:18:09,920 --> 00:18:14,180
!صوّبوا على الجدار الخارجيّ للمبنى "أ" للمختبر الثّالث

211
00:18:30,920 --> 00:18:32,290
!أطلقوا

212
00:18:38,770 --> 00:18:40,680
!هُدم الجدار

213
00:18:43,180 --> 00:18:45,900
...مـ-مهلاً، لا يمكن

214
00:18:50,650 --> 00:18:52,520
!هذا سيّئ للغاية

215
00:19:05,540 --> 00:19:07,290
!اهربوا! اهربوا

216
00:19:16,880 --> 00:19:18,420
!كلاّ

217
00:19:19,320 --> 00:19:20,660
ماذا هنالك؟

218
00:19:22,040 --> 00:19:23,390
!اخرسوا

219
00:19:23,390 --> 00:19:27,800
!أيّها اللّحية البنّيّة-تشي! أسرع، أسرع

220
00:19:35,360 --> 00:19:37,870
.ساعدي أولئك الحمقى على الهرب

221
00:19:37,870 --> 00:19:38,820
.والأطفال أيضًا

222
00:19:44,040 --> 00:19:45,930
!لا تنظروا للخلف وواصلوا الرّكض

223
00:19:45,930 --> 00:19:47,200
!سأهتمّ بالأمر

224
00:19:48,620 --> 00:19:50,500
!تاشيغي-تشان

225
00:19:58,250 --> 00:19:59,580
...النّجدة

226
00:20:02,010 --> 00:20:03,380
!بسرعة

227
00:20:16,930 --> 00:20:18,730
!اعبروا البوّابة

228
00:20:18,730 --> 00:20:22,030
!ستموتون إن لم تعبروا البوّابة

229
00:20:23,990 --> 00:20:27,280
!بسرعة! بسرعة! بسرعة

230
00:20:32,000 --> 00:20:33,540
!تماسكوا

231
00:20:48,490 --> 00:20:50,010
!أجل، نجحنا

232
00:20:50,010 --> 00:20:52,400
!نجحنا بالفعل

233
00:20:52,400 --> 00:20:53,430
!بالكاد

234
00:20:55,810 --> 00:20:57,770
!مهلاً، أين تاشيغي-تشان؟

235
00:20:57,770 --> 00:21:00,910
!طلبت منّا تاشيغي-تشان أن نسبقها

236
00:21:00,910 --> 00:21:01,820
!ماذا؟

237
00:21:01,820 --> 00:21:04,950
!لا تتوقّفوا واعبروا البوّابة

238
00:21:04,950 --> 00:21:06,700
!هيّا! أسرعوا

239
00:21:06,700 --> 00:21:07,490
!أسرعوا

240
00:21:12,960 --> 00:21:15,790
!ماذا تفعلون؟! أنزلوني

241
00:21:14,160 --> 00:21:15,790
!بسرعة

242
00:21:15,790 --> 00:21:18,380
!تاشيغي-تشان! هذا يكفي

243
00:21:18,720 --> 00:21:20,420
!عليك النّجاة بحياتك

244
00:21:21,570 --> 00:21:23,500
!الوداع

245
00:21:26,510 --> 00:21:29,170
!ماذا؟! حلّقت النّقيب-تشان إلى هنا

246
00:21:29,170 --> 00:21:30,220
!ما الّذي يحدث؟

247
00:21:30,220 --> 00:21:31,850
!كم سرّني هذا

248
00:21:31,850 --> 00:21:33,680
...لكن كيف حلّقت إلى هنا

249
00:21:33,680 --> 00:21:34,820
!ابتعدوا عن طريقي

250
00:21:34,820 --> 00:21:37,360
!ما زال هنالك جنود بحريّة في الخارج

251
00:21:37,360 --> 00:21:39,360
!كلاّ! الغاز يملأ المكان هناك

252
00:21:39,360 --> 00:21:40,250
!ابتعد

253
00:21:40,250 --> 00:21:40,680
!لن أفعل

254
00:21:40,680 --> 00:21:42,210
...إنّ البوّابة سوف

255
00:21:42,210 --> 00:21:45,030
...اتركوني! ما زالوا

256
00:21:45,030 --> 00:21:45,660
...ما زالوا

257
00:21:45,660 --> 00:21:49,030
...لكنّ البوّابة تُغلق

258
00:21:45,660 --> 00:21:49,030
!ما زالوا... اتركوني

259
00:21:49,030 --> 00:21:51,780
...أخبرني سموكر-سان

260
00:21:51,780 --> 00:21:54,160
!أن أساعدهم

261
00:21:54,160 --> 00:21:56,280
!لذلك ابتعدوا عن طريقي

262
00:21:56,280 --> 00:21:59,570
!كلاّ أيّتها النّقيب-تشان، فات الأوان

263
00:21:56,280 --> 00:21:59,570
!بسرعة... الوقت يداهمنا

264
00:22:00,850 --> 00:22:02,600
!ما هذا الهراء السّخيف؟

265
00:22:02,600 --> 00:22:05,590
!ما زال زملاؤكم في الجانب الآخر من البوّابة

266
00:22:05,590 --> 00:22:06,840
!لذلك ابتعدوا عن طريقي

267
00:22:07,250 --> 00:22:10,470
!لا تعني لا أيّتها النّقيب تاشيغي

268
00:22:12,150 --> 00:22:14,470
!أبليتم حسنًا يا رجال

269
00:22:14,470 --> 00:22:19,520
!النّقيب-تشان المحبوبة سالمة بين أيدينا

270
00:23:02,210 --> 00:23:03,700
!يا لهم من حثالة

271
00:23:03,700 --> 00:23:06,610
.لا أصدّق أنّ عددًا كبيرًا منهم قد نجوا

272
00:23:09,150 --> 00:23:11,910
...لكنّي لن أدع أيّ أحد

273
00:23:11,910 --> 00:23:14,450
!يفلت منّي

274
00:23:24,650 --> 00:23:30,130
،رغم عبورهم من البوّابة بنجاح
!يهاجم فيرغو جي-5 البحريّة

275
00:23:30,680 --> 00:23:36,060
بينما تاشيغي تبكي وهي ترى رئيسها الّذي
،وثقت به يُطيح بزملائها الواحد تلو الآخر

276
00:23:36,060 --> 00:23:39,220
!يظهر رجل معيّن من طاقم قبّعة القشّ

277
00:23:39,680 --> 00:23:41,220
:في الحلقة القادمة من وان بيس

278
00:23:41,220 --> 00:23:44,070
"!نائب الأميرال الخائن! شيطان الخيزران فيرغو"

279
00:23:44,070 --> 00:23:46,180
!ملك القراصنة، لن يكون إلاّ أنا

280
00:23:49,990 --> 00:23:54,990
!!نراكم في الحلقة القادمة