1
00:02:20,610 --> 00:02:21,910
!أدون

2
00:02:28,330 --> 00:02:30,290
!سوناتشي

3
00:02:43,720 --> 00:02:46,690
...النّدبة الّتي تركني بها أودن

4
00:02:47,140 --> 00:02:49,160
لماذا تؤلمني؟

5
00:02:49,160 --> 00:02:52,560
كيف اخترق النّصل جسدي؟

6
00:03:00,110 --> 00:03:05,120
!هل يستعملون ريوو أودن؟

7
00:03:08,580 --> 00:03:11,420
!فلتخترقك أنصالنا حتّى الجانب الآخر

8
00:03:39,650 --> 00:03:43,220
.لا أصدّق أنّكم تعاونتم مع قراصنة

9
00:03:43,220 --> 00:03:48,120
...الإشاعة عن الظّلال في أطلال قلعة أودن

10
00:03:48,120 --> 00:03:50,030
.بانك هازارد

11
00:03:50,030 --> 00:03:51,790
.دريسروزا

12
00:03:51,790 --> 00:03:54,460
.الجزيرة الوهميّة زو

13
00:03:54,460 --> 00:03:58,970
!وخلف كلّ ذلك نجد طاقم قبّعة القشّ

14
00:03:59,330 --> 00:04:01,530
،ويا لها من صدفة غريبة

15
00:04:01,530 --> 00:04:07,220
كنتم تختبئون خلف طاقم قبّعة القشّ
.الّذين أعتبرهم أعداءً لي

16
00:04:07,220 --> 00:04:12,370
بعضكم تحمّل لعشرين سنة بينما
،قفز البقيّة عبر الزّمن وهربوا

17
00:04:12,370 --> 00:04:15,270
.وانتهى بكم المطاف بحشد كلّ القوّات

18
00:04:16,560 --> 00:04:20,900
!لكنّ القراصنة سيطعنونكم في الظّهر

19
00:04:23,280 --> 00:04:26,160
!إنّك تهينه بكلامك هذا

20
00:04:27,660 --> 00:04:30,700
!لا يشبهكم لوفي-دونو على الإطلاق

21
00:04:30,700 --> 00:04:34,980
!أنت وكايدو ورجالكما وأوروتشي وكلّ أتباعه

22
00:04:34,980 --> 00:04:38,500
!سأوسعكم ضربًا جميعًا

23
00:04:39,210 --> 00:04:43,550
!إنّه الرّجل الّذي سيقف على قمّة البحر يومًا ما

24
00:04:45,130 --> 00:04:48,490
،حتّى إن كان الموت مصيرنا
!فسيظلّ واقفًا هنا

25
00:04:48,490 --> 00:04:52,060
!سيحلّ الفجر على بلاد وانو ثانية

26
00:04:52,060 --> 00:04:53,480
...لأنّ

27
00:04:54,060 --> 00:04:56,810
!ذلك ما وعدنا به سيّدنا

28
00:05:00,020 --> 00:05:03,650
!ستكون حربًا شاملة

29
00:05:05,980 --> 00:05:10,620
المعركة تحت القمر! المحاربون"
"!الهائجون، سولونغ أسد القمر

30
00:05:29,470 --> 00:05:32,200
!هذا ما توقّعته من أخيك يا إيس

31
00:05:32,200 --> 00:05:35,430
!أنا سعيد بالقتال إلى جانبه

32
00:05:35,930 --> 00:05:40,360
.صمدنا لعشرين سنة ووصلنا لهذا الحدّ أخيرًا

33
00:05:41,520 --> 00:05:46,070
!لا يوجد ما نخشاه الآن

34
00:05:46,070 --> 00:05:50,030
!تشبّثوا برأس كايدو وإن قتلكم ذلك

35
00:06:07,760 --> 00:06:14,060
تسنّت لنا فرصة مواجهتك أخيرًا
.بفضل دعم لوفي-دونو والبقيّة

36
00:06:15,810 --> 00:06:20,150
!لن نسمح لك بالخروج من هنا حيًّا

37
00:06:36,830 --> 00:06:39,310
.لا تختبروا صبري

38
00:06:39,310 --> 00:06:42,540
!لا تتعدّى قوّاتكم بضعة مئات المحاربين

39
00:06:51,640 --> 00:06:54,620
!إنّها محقّة. أغبياء

40
00:06:54,620 --> 00:06:57,080
!لدينا ثلاثون ألف جنديّ

41
00:06:57,080 --> 00:07:00,060
ماذا بوسعكم فعله ببضعة مئات فحسب؟

42
00:07:00,060 --> 00:07:06,300
...رنين، رنين، رنين... رنين، رنين، رنين

43
00:07:06,300 --> 00:07:07,360
.فتح

44
00:07:07,360 --> 00:07:08,280
ماذا؟

45
00:07:08,280 --> 00:07:13,370
!حالة طارئة! الآلاف من الغازين يدخلون من الخلف

46
00:07:14,820 --> 00:07:16,580
!ماذا؟

47
00:07:16,580 --> 00:07:19,670
!كيف يعقل هذا؟

48
00:07:23,960 --> 00:07:25,510
!هيّا بنا

49
00:07:32,300 --> 00:07:35,350
...حسنًا! إن كان هذا ما تريدون

50
00:07:43,350 --> 00:07:45,390
.سأقطّعكم بقدر ما تشاؤون

51
00:07:45,390 --> 00:07:46,650
!سحقًا لك

52
00:07:46,650 --> 00:07:49,740
!نعم، هلاككم مضمون

53
00:07:51,110 --> 00:07:52,580
!لماذا...؟

54
00:07:54,160 --> 00:07:55,530
...ساموراي

55
00:08:01,120 --> 00:08:04,370
!زوروجورو-دونو! سنساعدك

56
00:08:06,170 --> 00:08:08,420
.لا أحتاج لمساعدتكم

57
00:08:11,130 --> 00:08:13,470
!هذه النّقطة ب داخل القلعة

58
00:08:13,470 --> 00:08:16,850
!انضمّ محاربو السّاموراي إلى رورونوا زورو

59
00:08:16,850 --> 00:08:21,180
هذه النّقطة ج! السّاموراي الّذي
...أُسر في عاصمة الزّهور

60
00:08:21,180 --> 00:08:24,440
!وسجناء أودون يثورون أيضًا

61
00:08:29,770 --> 00:08:31,820
!ما الّذي يحدث؟

62
00:08:44,370 --> 00:08:46,210
...الوتر

63
00:08:46,210 --> 00:08:48,260
!المغناطيسيّ

64
00:09:00,810 --> 00:09:04,230
!يا رفاق، لا تتهاونوا

65
00:09:06,980 --> 00:09:11,060
.شكرًا لفتحك الطّريق لنا حتّى الآن

66
00:09:11,060 --> 00:09:13,170
.لا تسيئي فهمي

67
00:09:13,170 --> 00:09:16,570
.أنا هنا لقطع رأس كايدو فحسب

68
00:09:16,570 --> 00:09:20,660
،إن وقفتم في طريقي
.فلن أصفح عن أيّ أحد منكم أيضًا

69
00:09:20,660 --> 00:09:22,960
.شكرًا على التّحذير

70
00:09:23,870 --> 00:09:25,380
!غرفة

71
00:09:27,790 --> 00:09:29,340
!فلتمت

72
00:09:30,540 --> 00:09:31,960
!بتر

73
00:09:33,590 --> 00:09:35,130
!خلط

74
00:09:35,590 --> 00:09:36,760
ماذا؟

75
00:09:46,220 --> 00:09:49,500
...القراصنة الّذين أتى بهم كينييمون-دونو

76
00:09:49,500 --> 00:09:51,650
!يُعتمد عليهم بشدّة

77
00:09:52,350 --> 00:09:55,490
!ما الغاية من كلّ هذا؟

78
00:09:55,490 --> 00:09:57,880
.أتى الشيتشيبوكاي السّابق لو أيضًا

79
00:09:57,880 --> 00:10:01,410
!جميعهم متّحدون وقوّتهم في تزايد

80
00:10:01,410 --> 00:10:02,450
!ماذا؟

81
00:10:02,450 --> 00:10:04,040
!كوين-ساما

82
00:10:04,040 --> 00:10:05,540
!هناك المزيد؟

83
00:10:05,540 --> 00:10:07,810
،في مدخل الجزيرة

84
00:10:07,810 --> 00:10:11,130
...يتقاتل العنقاء ماركو وبيروسبيرو

85
00:10:12,670 --> 00:10:15,170
!مهلاً! ماذا حدث؟

86
00:10:15,170 --> 00:10:17,050
!مرحبًا؟

87
00:10:20,010 --> 00:10:21,760
!عذراء السّكاكر

88
00:10:25,770 --> 00:10:27,350
!ماذا يحدث؟

89
00:10:27,350 --> 00:10:29,560
!لماذا يتّحدون معًا؟

90
00:10:35,400 --> 00:10:39,070
.والآن، بدأت إبادة الغيلان-يوي

91
00:10:39,070 --> 00:10:44,600
سأحوّل كلّ عضو من قراصنة مملكة
.الحيوان إلى رجل سكاكر

92
00:10:44,600 --> 00:10:46,200
!لعق

93
00:10:48,790 --> 00:10:51,980
!اتّحد ماركو وبيروسبيرو؟

94
00:10:51,980 --> 00:10:56,420
،بابانوكي في البداية، ثمّ كيوشيرو
والآن هذا؟ ما الّذي يحدث؟

95
00:10:59,840 --> 00:11:03,140
!أيّها الأوغاد السّكارى في أنحاء أونيغاشيما

96
00:11:05,140 --> 00:11:07,600
!تمّ إلغاء وليمة اللّيلة

97
00:11:08,010 --> 00:11:09,810
!احملوا أسلحتكم

98
00:11:13,770 --> 00:11:16,400
!أغار العدوّ علينا

99
00:11:24,110 --> 00:11:26,080
...يا رفاق

100
00:11:30,040 --> 00:11:34,790
رغم رحيل كايدو، إلاّ أنّه ما زال هنالك
.ثلاثة من كبار النّجوم هنا

101
00:11:35,250 --> 00:11:37,750
!لكنّي واثقة أنّه ستكون هنالك فرصة

102
00:11:38,130 --> 00:11:43,390
...مومونوسكي-ساما! انتظر قليلاً فحسب

103
00:11:44,220 --> 00:11:46,140
!لنقم بهذا

104
00:11:46,140 --> 00:11:48,850
!فوزوا واسترجعوا بلاد وانو

105
00:12:15,630 --> 00:12:18,440
!سمعتك يا قبّعة القشّ

106
00:12:18,440 --> 00:12:21,510
ستوسعني ضربًا؟

107
00:12:21,510 --> 00:12:26,140
!أرني ما لديك! قبلت تحدّيك

108
00:12:34,850 --> 00:12:39,270
!سأريك قوّة أعظم جيوش العالم

109
00:13:01,290 --> 00:13:02,960
!لوفي-دونو

110
00:13:10,260 --> 00:13:12,050
!شكرًا لك

111
00:13:12,050 --> 00:13:14,980
!كينييمون! سأوافيك لاحقًا

112
00:13:17,600 --> 00:13:19,310
!كايدو-سان

113
00:14:03,150 --> 00:14:07,530
.استفقت بالكامل

114
00:14:12,620 --> 00:14:17,080
إن كنتم تريدون قتالاً مميتًا، فمن
.الأفضل خوضه في مكان مفتوح

115
00:14:17,080 --> 00:14:20,000
...كما ذلك اليوم

116
00:14:20,790 --> 00:14:22,710
!كايدو

117
00:14:24,420 --> 00:14:26,890
...كلّ ما أريد فعله

118
00:14:27,670 --> 00:14:29,760
!هو قطع رأس كايدو

119
00:14:30,050 --> 00:14:32,890
!يا له من رجل مضحك

120
00:14:32,890 --> 00:14:35,560
!أسلوب أودن ذو السّيفين

121
00:14:37,140 --> 00:14:38,730
!توتسكا الفردوس

122
00:14:42,100 --> 00:14:45,700
!لا يمكنني أن أخسر

123
00:14:46,440 --> 00:14:49,320
!توتسكا الفردوس

124
00:14:59,080 --> 00:15:03,920
.لكن على خلاف ذلك اليوم، أودن ميت فعلاً

125
00:15:14,510 --> 00:15:17,390
.هنالك أمر مختلف عن ذلك اليوم

126
00:15:17,390 --> 00:15:20,480
،استنتجنا أنّه عندما تتحوّل إلى تنّين

127
00:15:20,480 --> 00:15:24,440
.فلن تتمكّن من القتال داخل القبّة

128
00:15:45,420 --> 00:15:50,050
!تجهل تمامًا كم كنت أتوق شوقًا لهذا اليوم

129
00:15:50,050 --> 00:15:54,220
!أردت منك أن تتذوّق مدى غضبنا بأقسى الطّرق

130
00:15:54,220 --> 00:15:55,840
...قبيلة المينك

131
00:15:55,840 --> 00:16:00,100
.أحضرنا المحاربين من مملكتنا

132
00:16:06,520 --> 00:16:08,860
.ثمّة ثلوج خفيفة في سماء صافية

133
00:16:09,360 --> 00:16:13,870
.والقمر البدر واضح تمامًا

134
00:16:15,450 --> 00:16:17,310
...صحيح

135
00:16:17,310 --> 00:16:23,790
تتحوّلون أنتم المينك إلى محاربين هائجين
.يُدعون السّولونغ عندما يكون القمر بدرًا

136
00:16:41,140 --> 00:16:42,650
!جاك

137
00:16:48,440 --> 00:16:52,280
!لا أصدّق أنّكم قمتم بهذا أيّها السّاموراي الأوغاد

138
00:16:52,610 --> 00:16:56,950
.السّماح بدخول الكثير منكم كان خطأنا

139
00:16:57,610 --> 00:17:02,750
!لن تقتربوا من كايدو-سان ثانية

140
00:17:05,700 --> 00:17:08,510
!مهلاً، يا رفاق-غارا

141
00:17:08,750 --> 00:17:15,220
جاك عدّونا نحن اللّدود الّذي حطّم
.مملكتنا الّتي عمّرت لألف سنة

142
00:17:17,640 --> 00:17:21,940
...أخبرناه عدّة مرّات أنّ السّاموراي لم يكن هناك

143
00:17:29,520 --> 00:17:32,260
!حسنًا، أعطوه لنا الآن

144
00:17:32,260 --> 00:17:37,200
أعلم أنّ محاربًا من بلاد وانو
!يُدعى رايزو موجود هنا

145
00:17:38,150 --> 00:17:41,160
محارب من بلاد وانو؟ رايزو؟

146
00:17:41,160 --> 00:17:42,950
!لا نعرف أيّ أحد بهذا الاسم

147
00:18:06,180 --> 00:18:08,320
!أجيبوا على السّؤال

148
00:18:09,150 --> 00:18:11,350
أين المحارب من بلاد وانو؟

149
00:18:11,350 --> 00:18:12,780
!إنّه ليس هنا

150
00:18:24,320 --> 00:18:27,960
!لن أنسى هذا حتّى إن متّ يا جاك

151
00:18:27,960 --> 00:18:32,170
حتّى اليوم الّذي سألعنك-غارا حتّى
!الموت بضغينة القطط خاصّتي

152
00:18:39,510 --> 00:18:43,470
!المحارب الّذي قالوا أنّه ليس موجودًا هو أنا يا جاك

153
00:18:44,470 --> 00:18:46,100
...إنّه أنت

154
00:18:46,100 --> 00:18:52,060
!أنقذوا حياتي! وسأردّ الدّين بأكثر من صاع

155
00:18:52,060 --> 00:18:54,710
!أرني أفضل ما لديك

156
00:18:54,710 --> 00:18:57,950
!لديّ حساب أصفّيه معكم أيضًا

157
00:19:22,380 --> 00:19:26,100
!أريدكم أن تسدّدوه بحياتكم

158
00:19:26,100 --> 00:19:27,970
!أرينا ما لديك

159
00:19:27,970 --> 00:19:30,440
!قم بكلّ ما تستطيع

160
00:19:45,330 --> 00:19:47,160
...كلاّ، أنت يا سيّدي ورفاقك

161
00:19:47,160 --> 00:19:49,250
.عليكم الاستعداد لكايدو

162
00:19:49,250 --> 00:19:51,000
!أنت أيضًا أيّها الدّوق-ساما

163
00:20:05,420 --> 00:20:07,890
.سأترك أمرهم لكم إذًا

164
00:20:07,890 --> 00:20:09,550
!شكرًا لكم

165
00:20:09,550 --> 00:20:14,600
في تلك الحالة، سأستعمل كلّ ما
!بوسعي للإطاحة بكايدو

166
00:21:55,870 --> 00:21:59,580
!لا تخشوا شيئًا! مدّة السّولونغ قصيرة

167
00:21:59,580 --> 00:22:03,210
!أرونا ما لديكم! نحن وحوش أيضًا

168
00:22:25,360 --> 00:22:26,690
!ماذا؟

169
00:22:50,760 --> 00:22:53,430
!جاريني يا نيكو

170
00:22:53,430 --> 00:22:56,270
!اقلق على نفسك-غارا فحسب يا إينو

171
00:23:18,160 --> 00:23:21,670
.الوقت غير مناسب للخسارة بينما يضعف مومونوسكي أكثر

172
00:23:21,670 --> 00:23:23,770
.تتعرّض شينوبو الّتي تحاول المساعدة لهجوم كينغ

173
00:23:23,770 --> 00:23:28,530
يدافع لوفي والبقيّة عن أنفسهم
.ضدّ تهديدات بيغ مام بيأس

174
00:23:36,560 --> 00:23:41,140
:في الحلقة القادمة من وان بيس
"!خيانة زوس؟! نامي محاصرة"

175
00:23:41,140 --> 00:23:44,340
!ملك القراصنة، لن يكون إلاّ أنا