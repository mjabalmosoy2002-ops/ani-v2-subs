1
00:00:40,390 --> 00:00:45,400
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,400 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,150 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:58,910 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,740 --> 00:01:07,250
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,250 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,380 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,050 --> 00:01:23,640
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,850
هيّا بنا

10
00:01:25,850 --> 00:01:29,190
دون توقّف

11
00:01:29,190 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,440 --> 00:01:39,990
سأواصل النّهوض على قدميّ

13
00:01:39,990 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,410 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,840 --> 00:01:56,170
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,260 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,520 --> 00:02:09,400
أوه

19
00:02:09,400 --> 00:02:11,690
هيّا بنا

20
00:02:11,690 --> 00:02:14,980
دون توقّف

21
00:02:14,980 --> 00:02:20,200
دون استسلام لمرور الوقت

22
00:02:20,200 --> 00:02:25,870
سأواصل النّهوض على قدميّ

23
00:02:25,870 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:37,760
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:33,830 --> 00:03:37,820
،بعد أن فقد أخاه إيس في حرب القمّة ضدّ البحريّة

38
00:03:37,820 --> 00:03:41,150
.اُجتيح لوفي بحزن لا يطاق

39
00:03:42,100 --> 00:03:45,640
...إلاّ أنّ هنالك قصّة لم تُحكَ عن الإخوة

40
00:03:45,640 --> 00:03:50,920
.قبل 10 سنوات في الأزرق الشّرقيّ، لوفي وإيس كانا طفلين

41
00:03:56,560 --> 00:04:00,800
"!اعتن به جيّدًا! رسالة من الأخ"

42
00:04:03,510 --> 00:04:06,030
!إيس لم يمت

43
00:04:06,030 --> 00:04:09,900
.هوّن عليك، أعلم. أعلم كيف تشعر

44
00:04:09,900 --> 00:04:12,550
لكن من الخطير جدًّا أن تذهب إلى غري ترمينال الآن

45
00:04:12,550 --> 00:04:14,770
!بما أنّك مصاب وهناك قوّات في كلّ مكان

46
00:04:14,770 --> 00:04:15,860
!—لكن

47
00:04:15,860 --> 00:04:19,400
...كان حريقًا هائلاً! والاحتمالات

48
00:04:20,030 --> 00:04:25,630
ضئيلة لكنّنا نريد جميعًا أن نعتقد
.أنّ الزّعيمة وإيس ما زالا قيد الحياة

49
00:04:25,630 --> 00:04:28,990
ذهب دوغرا إلى هناك للبحث
.عنهما الآن لذا ثق به وانتظر

50
00:04:30,030 --> 00:04:33,710
.الجميع يواجهون وقتًا صعبًا، وليس أنت فقط يا لوفي

51
00:04:37,800 --> 00:04:39,550
!أصيب قارب الصّيد

52
00:04:39,550 --> 00:04:40,880
كيف حال الطّفل؟

53
00:04:40,880 --> 00:04:43,510
!لقد أغضب التّنّين السّماويّ

54
00:04:44,130 --> 00:04:45,090
!سابو

55
00:04:46,160 --> 00:04:49,140
!سحقًا! السّفينة تحترق

56
00:04:49,140 --> 00:04:50,810
لِمَ أطلقوا عليّ هكذا؟

57
00:04:51,560 --> 00:04:54,430
!أيّها القدّيس جالماك! هناك طفل على السّفينة

58
00:04:59,340 --> 00:05:01,440
...لكن الأهمّ

59
00:05:06,060 --> 00:05:06,910
!سحقًا

60
00:05:07,230 --> 00:05:11,410
!لا يجب على عامّيّ أن يسير في طريق سفينتي

61
00:05:32,350 --> 00:05:35,260
مهلاً! ما الّذي تفعله تلك السّفينة؟

62
00:05:35,260 --> 00:05:37,200
!هذا حفل مهمّ

63
00:05:37,200 --> 00:05:40,650
!لا نريد تعكير مزاج التّنّين السّماويّ

64
00:05:40,650 --> 00:05:43,400
!أزيحوا حطام السّفينة بسرعة

65
00:06:05,760 --> 00:06:07,050
!يا رفاق

66
00:06:07,050 --> 00:06:09,550
...رفاق، ذلكما الاثنان

67
00:06:09,550 --> 00:06:10,720
أين؟

68
00:06:12,130 --> 00:06:14,060
!لقد عادا

69
00:06:34,990 --> 00:06:36,950
!حمدًا لهذا

70
00:06:37,680 --> 00:06:40,250
...إيس... الزّعيمة

71
00:06:40,250 --> 00:06:44,230
!إنّها مصابة بشدّة! أسرعوا وعالجوها

72
00:06:44,860 --> 00:06:46,400
هل أنت بخير؟

73
00:06:48,210 --> 00:06:50,010
!إيس

74
00:06:50,600 --> 00:06:51,660
!لوفي

75
00:06:54,050 --> 00:06:57,140
هل ظننت أنّني متّ؟

76
00:06:57,140 --> 00:06:58,310
...لكن

77
00:06:58,310 --> 00:06:59,440
!لماذا تبكي؟

78
00:07:00,860 --> 00:07:03,470
!لم أمت أيّها الأحمق

79
00:07:03,470 --> 00:07:06,320
.على رسلك، هذا يكفي

80
00:07:06,820 --> 00:07:08,930
.لوفي فرح فحسب

81
00:07:14,860 --> 00:07:17,210
أيمكنني أن أسالك عن ليلة الحريق؟

82
00:07:17,210 --> 00:07:19,530
،بعد أن غادرنا مع لوفي

83
00:07:19,530 --> 00:07:22,510
ماذا حدث لك وللزّعيمة؟

84
00:07:22,920 --> 00:07:25,630
...قاتلنا بلوجام

85
00:07:52,910 --> 00:07:54,700
.وهزمناه بشقّ الأنفس

86
00:07:58,390 --> 00:08:01,210
وحاولنا أن نتبعكم على الفور

87
00:08:02,330 --> 00:08:05,000
.لكنّ النّار وقفت حائلاً بيننا

88
00:08:05,000 --> 00:08:07,170
!سحقًا! لا يوجد مهرب

89
00:08:07,170 --> 00:08:10,010
!لا خيار أمامنا

90
00:08:10,010 --> 00:08:11,050
!انتظر

91
00:08:11,050 --> 00:08:12,090
!ماذا تفعلين؟

92
00:08:12,550 --> 00:08:16,630
لا أملك خيارًا بما أنّني أخبرتهم

93
00:08:16,630 --> 00:08:19,280
...أنّني سأتحمّل مسؤوليّة إحضارك إلى البيت

94
00:08:21,240 --> 00:08:26,190
!اتبعني. لا تنفصل عنّي مهما كان

95
00:08:27,650 --> 00:08:28,610
!دادان

96
00:08:39,120 --> 00:08:42,450
!يا دادان! هل أنت بخير يا دادان؟

97
00:08:42,450 --> 00:08:45,260
تجاوزنا النّار أخيرًا

98
00:08:45,260 --> 00:08:47,540
.لكنّ دادان حرقت بشكل شديد

99
00:08:48,060 --> 00:08:51,990
.تمكنّا من الوصول إلى ضفّة النّهر في الغابة الوسطى

100
00:08:57,780 --> 00:09:01,010
!تماسكي! لا يمكنك أن تموتي

101
00:09:01,010 --> 00:09:02,470
!لصّ

102
00:09:02,470 --> 00:09:04,770
!انتظر! توقّف

103
00:09:05,600 --> 00:09:09,650
ذهبت إلى البلدة لسرقة بعض
الأدوية وأحصل على شيء نأكله

104
00:09:10,570 --> 00:09:13,070
.وحاولت إنقاذ حياة دادان

105
00:09:20,280 --> 00:09:24,080
،لست بحاجة للقلق بشأني
.لذا اذهب فحسب يا إيس

106
00:09:24,480 --> 00:09:28,360
كفى هراءً! يفترض أنّك المسؤولة
!عن إحضاري إلى البيت

107
00:09:29,170 --> 00:09:32,380
!لن أدعك تموتين

108
00:09:32,380 --> 00:09:33,300
!اسمعوا

109
00:09:33,300 --> 00:09:36,840
!قد يكون بعض النّاجين هنا

110
00:09:36,840 --> 00:09:39,090
!لا تدعوا أيّ أحد يهرب! نالوا منهم

111
00:09:39,090 --> 00:09:40,220
!حاضر

112
00:09:43,850 --> 00:09:45,690
.حسنًا، حسنًا، فهمنا

113
00:09:45,690 --> 00:09:48,940
!على أيّ حال، أنا مسرور لأنّكما نجوتما

114
00:09:48,940 --> 00:09:50,810
.آسفة لإقلاقكم

115
00:09:51,860 --> 00:09:55,580
.لا أصدّق ما حدث في غري ترمينال

116
00:09:55,580 --> 00:09:57,570
.أتساءل إن كان سابو قلقًا علينا

117
00:09:57,570 --> 00:10:00,910
!يحيا

118
00:10:00,910 --> 00:10:05,290
.قد يظهر عامّيّ وقح آخر في أيّ لحظة

119
00:10:05,290 --> 00:10:07,710
.راقبا جيّدًا

120
00:10:07,710 --> 00:10:08,500
!حاضر

121
00:10:14,020 --> 00:10:16,350
.أتساءل كيف يبلي سابو

122
00:10:16,350 --> 00:10:21,300
.لكنّي مسرور لأنّ إيس عاد ودادان تتعافى

123
00:10:22,560 --> 00:10:24,770
...إيس، في تلك اللّحظة

124
00:10:25,850 --> 00:10:28,600
!لن أهرب

125
00:10:30,060 --> 00:10:31,440
لِمَ لم تهرب؟

126
00:10:31,980 --> 00:10:35,230
.لا أستطيع سوى أن أتحمّس أحيانًا

127
00:10:35,230 --> 00:10:39,560
،أنا خائف دائمًا أنّه إن هربت
.سأترك شيئًا مهمًّا خلفي

128
00:10:39,950 --> 00:10:40,910
...في تلك اللّحظة

129
00:10:43,520 --> 00:10:46,660
.كان لوفي خلفي

130
00:10:47,670 --> 00:10:50,450
.لا أدري لكن أظنّ لذلك السّبب

131
00:10:53,670 --> 00:10:57,420
،حتّى عندما واجه حشدًا من الأعداء يفوقون طاقته

132
00:10:58,130 --> 00:11:00,590
.لم يهرب روجر أبدًا

133
00:11:00,590 --> 00:11:03,850
.أكان انتحاريًّا؟ الهرب يعدّ استراتيجيّة أيضًا

134
00:11:03,850 --> 00:11:06,000
.هذا صحيح لكنّه لا يفعل ذلك أبدًا

135
00:11:06,000 --> 00:11:09,520
.لأنّه بذلك سيترك من يحبّ خلفه

136
00:11:09,520 --> 00:11:13,190
.إن هرب، سيعرّض طاقمه للخطر

137
00:11:13,640 --> 00:11:17,320
في الواقع، ليس من الصّائب القول
."أنّه "ما كان ليهرب

138
00:11:17,320 --> 00:11:21,950
.بل لن يدع للعدوّ فرصة لمهاجمة طاقمه

139
00:11:21,950 --> 00:11:25,330
.كان يتحوّل إلى شيطان في تلك اللّحظات

140
00:11:25,330 --> 00:11:27,620
دمّر جيش دولةٍ بأكمله ذات مرّة

141
00:11:27,620 --> 00:11:29,960
.لأنّهم تحدّثوا بسوء عن طاقمه

142
00:11:30,720 --> 00:11:33,080
.يصبح عنيفًا عندما يغضب

143
00:11:33,080 --> 00:11:34,740
.كان حادّ المزاج وأنانيًّا

144
00:11:34,740 --> 00:11:40,340
.وكان ساذجًا وصريحًا كالأطفال في نفس الوقت

145
00:11:40,340 --> 00:11:43,680
.ذلك لأنّ حياته المبكّرة كانت كحياة إيس

146
00:11:43,680 --> 00:11:47,810
.كره أن يخسر من يحبّ

147
00:11:51,400 --> 00:11:53,920
،كان طائشًا لكنّه كان ينجو

148
00:11:53,920 --> 00:11:57,070
.وأصبح ملك القراصنة

149
00:11:58,280 --> 00:12:03,530
،مع أنّه كان يملك سمعةً شائنة
.إلاّ أنّ طاقمه وثق به ثقةً عمياء

150
00:12:03,530 --> 00:12:08,740
.حتّى أنا كجنديّ بحريّة لم أستطع سوى احترامه

151
00:12:09,290 --> 00:12:12,210
.ولهذا قرّرت الاعتناء بإيس

152
00:12:12,210 --> 00:12:14,210
!نحن من نعتني به

153
00:12:14,210 --> 00:12:17,090
ماذا؟ أتريدين قول شيء؟

154
00:12:17,090 --> 00:12:18,420
.لا، لا شيء

155
00:12:20,010 --> 00:12:23,510
.ما زالت شعوب العالم تكره روجر

156
00:12:23,510 --> 00:12:25,090
،وبينما يكره إيس والده

157
00:12:25,920 --> 00:12:28,760
."ينطبق عليه مثل "من شابه أباه فما ظلم

158
00:12:28,760 --> 00:12:32,600
...حسنًا! لنرَ أيّكما سيفوز

159
00:12:32,600 --> 00:12:33,810
!دوغرا

160
00:12:35,520 --> 00:12:38,450
كنت تبحث عن إيس ودادان، صحيح؟

161
00:12:38,450 --> 00:12:40,300
!لقد عادا

162
00:12:40,300 --> 00:12:44,860
.حقًّا؟ هذا ممتاز

163
00:12:45,610 --> 00:12:48,450
...مـ-ماذا؟! سابو

164
00:12:49,790 --> 00:12:53,660
!كفّ عن الكذب أيّها الأحمق
!إيّاك حتّى أن تمزح في ذلك

165
00:12:53,660 --> 00:12:54,710
!توقّف يا إيس

166
00:12:54,710 --> 00:12:58,960
!لستُ أكذب أو أمزح! حدث ذلك فجأةً

167
00:12:58,960 --> 00:13:01,460
!بالكاد استطعت تصديق ما رأيت

168
00:13:01,460 --> 00:13:04,590
!ظننت أنّني أحلم

169
00:13:04,590 --> 00:13:08,050
!اخرس! عاد سابو إلى بيت عائلته

170
00:13:08,460 --> 00:13:10,640
!فكيف أمكنه أن يكون في البحر؟

171
00:13:10,640 --> 00:13:12,640
!هذا صحيح! عاد إلى بيته

172
00:13:12,640 --> 00:13:15,840
!يمكن لقاطع طريق مثلي أن يفهم كيف يشعر

173
00:13:15,840 --> 00:13:18,560
!ليس كلّ النّاس يريدون العودة إلى منازلهم

174
00:13:19,480 --> 00:13:24,900
!لو أنّه كان سعيدًا حقًّا، لما قصد البحر

175
00:13:24,900 --> 00:13:30,780
ولَما ذهب إلى البحر لوحده رافعًا
!علمًا أسودًا على سفينته

176
00:13:40,290 --> 00:13:41,840
...سابو

177
00:13:42,630 --> 00:13:46,680
!لم يكن سعيدًا

178
00:13:46,840 --> 00:13:50,010
!كنتُ وحيدًا حتّى وأنا أملك أبوين

179
00:13:50,470 --> 00:13:54,930
!لماذا؟! لِمَ لم نعد إلى هناك لإعادته؟

180
00:13:56,080 --> 00:14:00,270
!أين الشّخص الّذي قتل سابو الآن؟! سأقتله

181
00:14:00,270 --> 00:14:02,900
...تـ-تقتل التّنّين السّماويّ؟! هذا مستحيل

182
00:14:02,900 --> 00:14:04,780
!سأجعله يدفع الثّمن

183
00:14:04,780 --> 00:14:05,900
!انتظر يا إيس

184
00:14:07,450 --> 00:14:09,780
!توقّف أيّها الحقير

185
00:14:09,780 --> 00:14:10,950
...تنحّي

186
00:14:11,200 --> 00:14:12,830
!تنحّي عن طريقي

187
00:14:12,830 --> 00:14:17,210
أنّى لك أن تكون بهذه الثّقة
!مع أنّك لست بتلك القوّة؟

188
00:14:17,210 --> 00:14:20,460
!ماذا يمكنك أن تفعل؟! سيقتلونك فحسب

189
00:14:20,460 --> 00:14:22,860
!ستموت وسينساك النّاس غدًا

190
00:14:22,860 --> 00:14:25,860
!ما أنت سوى صبيّ مغمور

191
00:14:26,630 --> 00:14:31,010
!قُتل سابو من قبل هذه البلاد! هذا العالم

192
00:14:31,010 --> 00:14:33,930
!ماذا يمكنك أن تفعل بشأن ذلك؟

193
00:14:34,990 --> 00:14:37,600
!غيّر والدك العالم بموته

194
00:14:37,600 --> 00:14:40,130
،عندما تصبح رجلاً بتلك الأهمّيّة

195
00:14:40,130 --> 00:14:42,810
!حينها افعل ما يحلو لك

196
00:14:46,400 --> 00:14:48,650
!اربطوا هذا الأحمق

197
00:14:48,650 --> 00:14:49,820
!حـ-حاضر

198
00:14:50,550 --> 00:14:54,450
!سابو

199
00:14:54,450 --> 00:14:55,410
!سحقًا

200
00:14:57,790 --> 00:15:02,360
!اخرس! الرّجال لا يبكون يا لوفي

201
00:15:32,820 --> 00:15:35,660
هل عدت لصوابك يا إيس؟

202
00:15:39,770 --> 00:15:41,120
.فكّ وثاقه

203
00:15:41,120 --> 00:15:41,710
.حاضر

204
00:15:43,720 --> 00:15:45,320
.تمهّل

205
00:15:45,320 --> 00:15:46,340
أين لوفي؟

206
00:15:46,340 --> 00:15:48,960
.كان يبكي طوال اللّيل وهو نائم الآن

207
00:15:50,210 --> 00:15:53,260
!أيّتها الزّعيمة! لن تصدّقي هذا

208
00:15:53,260 --> 00:15:55,970
!وردتنا رسالة من سابو

209
00:15:55,970 --> 00:15:58,930
!لا بدّ أنّه أرسلها قبل ذهابه إلى البحر

210
00:16:00,440 --> 00:16:01,720
!أعطني إيّاها

211
00:16:01,720 --> 00:16:05,520
لن أذهب إلى البلدة! إنّها لنا، أليس كذلك؟

212
00:16:12,060 --> 00:16:16,320
.إيس، لوفي، آمل أنّكما لم تتأذّيا في الحريق"

213
00:16:16,320 --> 00:16:19,200
.أنا قلق بشأنكما لكن أعتقد أنّكما بخير

214
00:16:20,000 --> 00:16:25,460
آسف لقول هذا يا رفاق، لكن عندما
...تصلكما هذه الرّسالة، سأكون قد

215
00:16:26,710 --> 00:16:28,480
.أبحرت بالفعل

216
00:16:29,740 --> 00:16:33,090
.حصل ما حصل وقرّرت أن أبحر قبلكما

217
00:16:39,010 --> 00:16:43,310
.ستكون وجهتي أيّ مكان غير هذا المكان

218
00:16:44,120 --> 00:16:48,940
!سأصبح أقوى وسأصبح قرصانًا

219
00:16:50,230 --> 00:16:52,440
.علينا أن نصبح أكثر قراصنة أحرار على الإطلاق

220
00:16:52,440 --> 00:16:56,200
.ونلتقي نحن الثّلاثة في مكان ما ثانيةً يومًا ما

221
00:16:56,700 --> 00:17:02,180
!مكان في البحر الواسع! يومًا ما بالتّأكيد

222
00:17:04,410 --> 00:17:09,920
بالمناسبة يا إيس، من منّا تظنّ أنّه الأخ الأكبر؟

223
00:17:10,700 --> 00:17:14,150
.أخوان كبيران وأخ صغير

224
00:17:15,280 --> 00:17:18,850
.هذا غريب لكنّ أخوّتنا هي كنزي

225
00:17:24,430 --> 00:17:29,310
...ما زال لوفي طفلاً بكّاءً ولكن

226
00:17:34,820 --> 00:17:38,730
"!إنّه أخونا الصّغير فاعتنِ به جيّدًا

227
00:18:05,940 --> 00:18:09,770
كيف يعتبرون أنفسهم مراقبين
!وهم يحتفلون كلّ يوم؟

228
00:18:11,980 --> 00:18:15,350
...لم يغطّوا قصّة سابو

229
00:18:15,350 --> 00:18:17,570
.سمعت أنّ أبويه لم يقوما بأيّ خطوة

230
00:18:17,990 --> 00:18:19,910
أبواه نبيلان

231
00:18:19,910 --> 00:18:24,670
لكن لا حول لهما ولا قوّة أمام
.حكومة العالم والتّنانين السّماويّين

232
00:18:25,620 --> 00:18:27,290
كيف يبلي لوفي؟

233
00:18:27,290 --> 00:18:30,000
.ما زال لا يأكل كثيرًا

234
00:18:30,000 --> 00:18:32,290
!لكنّه مع ذلك يأكل ضعف ما نأكله نحن

235
00:18:32,290 --> 00:18:35,420
...أراهن أنّ موت سابو أثّر عليه كثيرًا

236
00:19:01,070 --> 00:19:02,740
!إيس! لوفي

237
00:19:03,420 --> 00:19:06,580
!علينا أن نبحر يومًا ما

238
00:19:06,580 --> 00:19:09,710
!لنخرج من هذه البلاد ونعش أحرارًا

239
00:19:11,540 --> 00:19:13,250
،لذا من الآن فصاعدًا

240
00:19:14,360 --> 00:19:15,880
!نحن إخوة

241
00:19:37,780 --> 00:19:39,740
إلى متى ستظلّ مستلقيًا هناك؟

242
00:19:42,860 --> 00:19:47,120
.لقد ذهب كلّ الكنز الّذي كنّا نخبّئه في الغابة

243
00:19:48,360 --> 00:19:53,260
.أخذه النّاجون من طاقم بلوجام أو ربّما وجده العسكر

244
00:19:53,790 --> 00:19:55,790
.لا أدري أين ذهب

245
00:19:56,280 --> 00:20:00,120
.لكنّي ما عدت أهتمّ للكنز

246
00:20:00,120 --> 00:20:05,430
كانت مدّخرات القراصنة الّتي كنت سأشاركها مع سابو

247
00:20:05,430 --> 00:20:08,890
.لكنّ سابو لم يحتجها في النّهاية

248
00:20:08,890 --> 00:20:13,140
.لذا سأنسى أمرها أيضًا

249
00:20:13,140 --> 00:20:16,570
لا فائدة من امتلاك الكنز إن كنت
.لا تستطيع حتّى حمايته

250
00:20:17,200 --> 00:20:19,980
...إ-إيس... أنا

251
00:20:23,030 --> 00:20:25,110
!أريد أن أصير أقوى

252
00:20:26,280 --> 00:20:28,620
...أكثر وأكثر

253
00:20:29,160 --> 00:20:32,580
...أكثر وأكثر وأكثر

254
00:20:32,580 --> 00:20:37,510
...أكثر وأكثر وأكثر وأكثر

255
00:20:37,510 --> 00:20:41,380
...أكثر وأكثر... وأكثر وأكثر

256
00:20:41,380 --> 00:20:43,090
!أريد أن أصبح أقوى أكثر

257
00:20:43,720 --> 00:20:49,310
!حينها سأستطيع حماية أيّ شيء أو أيّ أحد
!ولن أعود بحاجة لفقدان أيّ أحد

258
00:20:51,020 --> 00:20:53,430
!أترجّاك

259
00:20:53,430 --> 00:20:57,770
!إيس، لا تمت أرجوك

260
00:20:57,770 --> 00:21:02,530
!يكفي! اقلق على نفسك أوّلاً

261
00:21:02,530 --> 00:21:04,650
!فأنت أضعف منّي بكثير

262
00:21:05,160 --> 00:21:07,620
!اسمع جيّدًا يا لوفي

263
00:21:08,730 --> 00:21:10,290
!لن أموت أبدًا

264
00:21:15,300 --> 00:21:18,240
.أخبرني سابو أن أعتني بك أيضًا

265
00:21:18,850 --> 00:21:22,050
!أعدك أنّني لن أموت أبدًا

266
00:21:23,100 --> 00:21:27,000
كيف لي أن أترك أخًا بكّاءً مثلك وأرحل؟

267
00:21:29,600 --> 00:21:35,730
.لستُ ذكيًّا لذا لا أعرف ما قتل سابو بالضّبط بعد

268
00:21:36,160 --> 00:21:40,610
.لكن لا بدّ أنّه شيء يناقض الحرّيّة

269
00:21:40,610 --> 00:21:43,900
.مات سابو قبل أن يعرف معنى الحرّيّة

270
00:21:44,520 --> 00:21:47,620
!تبادلنا نفس كأس السّاكي وما زلنا حيّين

271
00:21:51,660 --> 00:21:54,700
.لذا أنصت يا لوفي

272
00:21:54,700 --> 00:21:58,940
.علينا أن نعيش بلا أيّ ندم

273
00:22:13,960 --> 00:22:16,230
...الأولاد من العائلات النّبيلة

274
00:22:16,230 --> 00:22:19,850
.يصبحون نبلاء معترف بهم عندما يدركون الـ18

275
00:22:21,280 --> 00:22:24,610
!لهذا أنا بحاجة لمغادرة هذا المكان قبل إكمال الـ17

276
00:22:27,710 --> 00:22:32,260
...علينا أن نبحر يومًا ما

277
00:22:33,000 --> 00:22:37,190
.ونعيش كما نريد. أكثر حرّيّة من أيّ أحد

278
00:22:40,010 --> 00:22:44,960
.ما يعني أنّني سنكسب الكثير من الأعداء

279
00:22:44,960 --> 00:22:47,230
.وحتّى العجوز سيصبح عدوّنا

280
00:22:47,230 --> 00:22:48,820
.عليك أن تخاطر بكلّ شيء

281
00:22:49,470 --> 00:22:52,230
!لنبحر في سنّ الـ17

282
00:22:52,230 --> 00:22:55,800
!وسنصبح... قراصنة

283
00:23:25,490 --> 00:23:28,090
،لوفي وإيس غارقان في الحزن

284
00:23:28,090 --> 00:23:31,150
لكنّهما يتشبّثان بحلمهما في أن يصبحا قرصانين

285
00:23:31,150 --> 00:23:34,010
.ويمضيان نحو المستقبل ثانيةً

286
00:23:34,010 --> 00:23:36,470
...سيحين يوم مغادرتهما

287
00:23:36,470 --> 00:23:40,480
!لتحقيق الحلم الّذي لم يستطع سابو تحقيقه

288
00:23:40,480 --> 00:23:41,960
:في الحلقة القادمة من وان بيس

289
00:23:41,960 --> 00:23:45,110
"!للوفاء بالوعد! مغادرة كلّ منهما"

290
00:23:45,110 --> 00:23:47,510
!ملك القراصنة، لن يكون إلاّ أنا

291
00:23:50,030 --> 00:23:55,030
!!نلقاكم في الحلقة القادمة