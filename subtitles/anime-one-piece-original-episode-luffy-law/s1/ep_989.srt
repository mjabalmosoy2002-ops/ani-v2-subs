1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:14,150 --> 00:02:18,610
"!العهد بين الرّجال! قتال دبّابة براكيو الضّاري"

29
00:02:29,790 --> 00:02:33,040
!بيغ مام؟! لماذا هي هنا؟

30
00:02:36,920 --> 00:02:39,090
!كلاّ! كلاّ! ستأكلني

31
00:02:42,050 --> 00:02:43,430
...كلاّ! كلاّ

32
00:02:43,430 --> 00:02:46,850
!يا قائد الدّبّابة تشوبّر! يا قائد الدّبّابة تشوبّر

33
00:02:47,220 --> 00:02:51,580
،بما أنّنا متنكّرون بهيئة طاقم قراصنة مملكة الحيوان

34
00:02:51,580 --> 00:02:54,860
!أنا واثق أنّها ستظنّنا حلفاءها

35
00:02:54,860 --> 00:02:55,980
!ماذا؟

36
00:02:55,980 --> 00:02:58,030
!حـ-حسنًا

37
00:02:58,030 --> 00:03:01,950
!نسيت أنّنا متنكّرون على هيئة العدوّ

38
00:03:02,160 --> 00:03:04,290
!حسنًا، لنقم بهذا

39
00:03:04,570 --> 00:03:09,290
!لديّ تقرير! هذا قائد الدّبّابة تشوبّر

40
00:03:09,290 --> 00:03:13,210
!لقد قدّم نفسه كتشوبّر للتّوّ

41
00:03:13,210 --> 00:03:17,340
!أنا من حرّاس أمن الوليمة

42
00:03:22,840 --> 00:03:26,350
.أنت في دوريّة إذًا

43
00:03:27,010 --> 00:03:29,890
!لقد صدّقته

44
00:03:33,480 --> 00:03:35,860
!كان ذلك وشيكًا

45
00:03:36,440 --> 00:03:40,820
...يبدو مألوفًا جدًّا

46
00:03:44,990 --> 00:03:46,370
!إنّه هو

47
00:03:47,030 --> 00:03:48,040
!مهلاً

48
00:03:49,990 --> 00:03:53,540
!أنت هو التّانوكي من طاقة قبّعة القشّ

49
00:03:53,540 --> 00:03:57,340
!أيّها السّائق أوسوبّ! تراجع بأقصى سرعة
!تراجع بأقصى سرعة

50
00:03:57,340 --> 00:03:58,590
!عُلم

51
00:04:02,970 --> 00:04:05,510
!لن أسمح لكما بالهرب

52
00:04:05,510 --> 00:04:07,300
!عرفتُ أنّ ذلك لن ينفع

53
00:04:07,300 --> 00:04:08,850
!بالطّبع لا

54
00:04:08,850 --> 00:04:11,890
!أيّها التّانوكي

55
00:04:11,890 --> 00:04:13,730
!تراجع بأقصى سرعة

56
00:04:17,690 --> 00:04:19,060
!لقد اختفوا

57
00:04:19,060 --> 00:04:20,860
!أخي تشو

58
00:04:20,860 --> 00:04:22,490
...يا لها من امرأة شرسة

59
00:04:24,650 --> 00:04:26,620
!حظًّا سعيدًا

60
00:04:35,660 --> 00:04:41,260
في الطّريق إلى هنا، قطع الحبال
!وحاول الهرب، لذلك أفقدته وعيه

61
00:04:41,260 --> 00:04:44,010
!لا تقلق، ما زال حيًّا

62
00:04:49,430 --> 00:04:53,980
كيف أمكنك فعل ذلك لوريث كوزكي
الّذي كان سيّدك في الماضي...؟

63
00:04:54,600 --> 00:04:57,730
!لديك قلب بارد ومن حجر

64
00:04:58,310 --> 00:05:02,190
انتهيت من لعب الدّور، لذلك
.فهو الآن مجرّد شقيّ لا أعرفه

65
00:05:02,900 --> 00:05:06,660
.لقد تفاجأت! أتذكّر ذلك بالفعل

66
00:05:06,990 --> 00:05:13,160
أنت واحد من الأكازايا التّسعة
.الّذين واجهتهم قبل 20 سنة

67
00:05:16,500 --> 00:05:20,380
.نعم... أتذكّرك جيّدًا أيضًا

68
00:05:20,580 --> 00:05:27,180
خاب ظنّي عندما سمعت أنّك ابن أودن الشّجاع
!ذاك من 20 سنة مضت ولم تتغيّر قطّ

69
00:05:30,260 --> 00:05:33,220
!نعم، إنّه مجرّد شقيّ قذر الآن

70
00:05:33,220 --> 00:05:36,390
...كلّ ما يميّزه هو سلالته العظيمة

71
00:05:47,440 --> 00:05:49,950
!فتى مسكين

72
00:05:50,860 --> 00:05:54,700
كيف أمكنك لكم صبيّ مثله حتّى أدميتَه؟

73
00:06:01,960 --> 00:06:06,150
!أبليتَ حسنًا بقيامك بدور الجاسوس لوقت طويل

74
00:06:06,150 --> 00:06:07,930
!أحسنت عملاً

75
00:06:07,930 --> 00:06:09,800
!لا يا أوروتشي-ساما

76
00:06:09,800 --> 00:06:12,620
...بل فشلت في اعتراض خطّة الأكازايا

77
00:06:12,620 --> 00:06:19,520
بسبب هجوم طاقم قبّعة القشّ
!وبقيّة طواقم القراصنة المفاجئ

78
00:06:19,520 --> 00:06:21,440
!ماذا؟! فشلت؟

79
00:06:21,440 --> 00:06:28,410
،قوّات المتمرّدين، 5400 محاربًا
!يتقدّمون الآن نحو أونيغاشيما

80
00:06:28,990 --> 00:06:30,410
!لوفي؟

81
00:06:30,410 --> 00:06:33,200
هـ-هل ما زالوا أحياء؟

82
00:06:33,200 --> 00:06:38,750
!أ-أي أنّك تقول أنّ الـ-الأكازايا ما زالوا موجودين؟

83
00:06:40,000 --> 00:06:42,170
!سُحقًا لك

84
00:06:42,170 --> 00:06:45,380
!فشلت في اعتراض خطّتهم؟

85
00:06:45,380 --> 00:06:47,850
!أنا جدّ آسف

86
00:06:47,850 --> 00:06:53,510
!أنت من أخبرني أنّهم سيلتقون في ميناء توكاغي

87
00:06:53,510 --> 00:06:55,720
!لماذا لم تقضِ عليهم؟

88
00:06:55,720 --> 00:06:58,810
!كـ-كان كينييمون أمكر منّي

89
00:07:00,100 --> 00:07:02,920
،عرفته لوقت طويل

90
00:07:02,920 --> 00:07:06,110
!لكن لم أكن أعرف أنّه مُخطِّط جيّد لتلك الدّرجة

91
00:07:06,110 --> 00:07:08,570
!لا تقدّم أعذارًا

92
00:07:08,570 --> 00:07:10,840
!أخبرني يا كانجورو

93
00:07:10,840 --> 00:07:15,030
!هل سيأتي أسطول السّاموراي لأونيغاشيما؟

94
00:07:15,030 --> 00:07:18,160
.يبدو أنّ الوضع ما زال آمنًا هنا يا أوروتشي-ساما

95
00:07:18,490 --> 00:07:19,790
!فوكوروكوجو

96
00:07:20,240 --> 00:07:23,830
.لا توجد سفن مثيرة للشّبهة في الميناء

97
00:07:24,080 --> 00:07:29,470
.ولكن، لم تعد ثلاث من سفننا الحربيّة

98
00:07:29,920 --> 00:07:31,720
...أنا

99
00:07:31,720 --> 00:07:36,850
.رأيت سفينتين منها تغرقان على يد القراصنة اللّعناء

100
00:07:45,230 --> 00:07:50,400
في تلك الحالة، من المنطقيّ افتراض
.أنّ السّفينة الأخرى غرقت أيضًا

101
00:07:50,400 --> 00:07:56,240
في الحقيقة، تأكّدنا من وجود أربعة
.قراصنة على ساحة العرض

102
00:07:58,780 --> 00:08:01,080
.قبّعة القشّ لوفي

103
00:08:03,660 --> 00:08:05,960
.صائد القراصنة زورو

104
00:08:08,090 --> 00:08:10,760
.يوستاس "كابتن" كيد

105
00:08:13,090 --> 00:08:15,590
.جنديّ المجازر" كيلر"

106
00:08:15,590 --> 00:08:20,850
على الأرجح أنّ أعضاءً من طاقميهم
.قد تسلّلوا للجزيرة أيضًا

107
00:08:20,850 --> 00:08:23,730
!إن كنت تعرف ذلك، لماذا لم تبلّغني به؟

108
00:08:23,730 --> 00:08:26,980
،كان كوين-دونو يتولّى الأمر

109
00:08:26,980 --> 00:08:31,440
...لذلك فكّرتُ أنّه ما من داع لإفساد الوليمة

110
00:08:31,440 --> 00:08:37,700
سواء كانوا هنا أم لا، فكلّ قوّاتنا
.موجودة على أونيغاشيما

111
00:08:38,150 --> 00:08:43,250
!مهما حدث، يظلّ هذا أكثر الأماكن أمنًا في البلاد

112
00:08:45,290 --> 00:08:47,440
!أنت على حقّ

113
00:08:47,440 --> 00:08:49,290
!اشرب يا أوروتشي

114
00:08:49,290 --> 00:08:52,340
.خذ! تفضّل بالشّرب

115
00:08:53,550 --> 00:08:55,470
...حـ... حسنًا

116
00:08:58,010 --> 00:09:02,430
!لا... لا أريد لأيّ أحد أن يواسيني

117
00:09:02,800 --> 00:09:06,810
أفضّل سماع تقرير عن مقتل
!أولئك السّاموراي الملاعين

118
00:09:08,690 --> 00:09:11,420
!أنا واثق أنّ كلّ شيء سيكون بخير

119
00:09:11,420 --> 00:09:14,780
!لا بدّ أنّ الجميع على أونيغاشيما الآن

120
00:09:14,980 --> 00:09:18,530
!لأنّ لوفي على هذه الجزيرة

121
00:09:18,530 --> 00:09:20,780
!انجُ كيفما تستطيع

122
00:09:20,780 --> 00:09:25,380
!سآتي لإنقاذك

123
00:09:27,290 --> 00:09:30,320
!عليّ الهرب

124
00:09:30,320 --> 00:09:32,530
...عليّ النّجاة

125
00:09:32,530 --> 00:09:34,720
!مهما كلّف الأمر

126
00:09:35,880 --> 00:09:37,510
!بلاك ماريا

127
00:09:37,510 --> 00:09:39,300
!أعطني إيّاه

128
00:09:39,300 --> 00:09:45,400
!هذا صحيح! لا يجب أن ننسى
!إنّه قائد العدوّ

129
00:09:46,720 --> 00:09:50,020
!جهّزوا منصّة الإعدام

130
00:09:50,020 --> 00:09:56,570
،إن انتهى نسل عائلة كوزكي البارزة
!فإنّ ولاءهم المتعفّن سينهار أيضًا

131
00:09:56,570 --> 00:09:59,160
!وسينتهي الأمر

132
00:10:02,490 --> 00:10:04,540
...لوفي

133
00:10:04,740 --> 00:10:06,880
...رفاق

134
00:10:07,160 --> 00:10:09,170
...أبتاه

135
00:10:15,790 --> 00:10:18,010
هل جميعهم بخير؟

136
00:10:18,300 --> 00:10:20,680
!نعم، بالطّبع هم بخير

137
00:10:21,930 --> 00:10:23,090
!إيزو

138
00:10:23,090 --> 00:10:25,180
.شكرًا على كلّ شيء يا نيكو

139
00:10:25,180 --> 00:10:30,730
قال أنّ الجميع قد نزلوا على الجزيرة
!سلفًا، لذلك أظنّ أنّ الغارة قائمة

140
00:10:31,230 --> 00:10:35,360
تلك الجزيرة الوحيدة تُدعى أونيغاشيما الآن؟

141
00:10:36,770 --> 00:10:37,820
...كيكو

142
00:10:37,820 --> 00:10:42,220
،على أيّ حال، غادرتَ قبلي
.لكنّنا وصلنا في نفس الوقت

143
00:10:42,220 --> 00:10:46,370
لم أكن بحاجة لأعهد لك برسالتي
!إلى قبّعة القشّ لوفي-يوي

144
00:10:48,290 --> 00:10:51,710
!أنت على حقّ! سأرمي هذه الرّسالة إذًا

145
00:10:58,500 --> 00:11:00,550
قلتَ أنّك ستذهب إلى بلاد وانو؟

146
00:11:00,550 --> 00:11:01,380
.نعم

147
00:11:01,380 --> 00:11:04,430
ما الّذي تنوي فعله هناك؟

148
00:11:06,970 --> 00:11:09,640
!سنطيح بكايدو

149
00:11:09,640 --> 00:11:13,250
!سنقوم بذلك! سنثأر لأودن-ساما

150
00:11:13,250 --> 00:11:16,360
!سيساعدنا طاقم قبّعة القشّ أيضًا

151
00:11:17,060 --> 00:11:18,570
...حسنًا

152
00:11:18,570 --> 00:11:21,950
.لديّ سبب إضافيّ إذًا لأذهب معك

153
00:11:22,660 --> 00:11:26,160
.على أيّ حال، لا أصدّق أنّك أتيت يا ماركو

154
00:11:26,160 --> 00:11:29,580
...صحيح، لطالما أحببت أودن

155
00:11:33,370 --> 00:11:37,800
إنّه موطن صديقي الّذي خاطر بحياته
لإنقاذه. فأنّى لي ألاّ أساعد؟

156
00:11:37,800 --> 00:11:40,470
.شكرًا لك. أنا مدين لك

157
00:11:40,470 --> 00:11:43,210
.لا عليك. وجب أن أقوم بشيء ما أبكر

158
00:11:43,210 --> 00:11:49,010
...لا أصدّق كم أنّ بلاد أودن قد تغيّرت

159
00:11:49,010 --> 00:11:51,830
.لا تعبر المعلومات عن بلاد وانو البحار

160
00:11:51,830 --> 00:11:56,190
لم أكن أعرف أنّ بلاد وانو المزدهرة
...صارت على هذا الحال

161
00:11:56,600 --> 00:11:59,360
.كلّ هذا بسبب كايدو

162
00:11:59,360 --> 00:12:03,030
!أظنّ أنّك عازم الآن! لنسرع إلى أونيغاشيما

163
00:12:03,030 --> 00:12:05,660
!علينا اللّحاق بالجميع

164
00:12:05,660 --> 00:12:09,220
لكن ماذا علينا أن نفعل؟
.بدأت غارتهم بالفعل

165
00:12:09,220 --> 00:12:11,790
كيف ننضمّ لهم والعدوّ في كلّ مكان؟

166
00:12:11,790 --> 00:12:16,040
!اعتمد عليّ! لديّ فكرة

167
00:12:19,630 --> 00:12:25,800
كما هو مخطّط، يقود دنجيرو القوّات
.الجنوبيّة نحو المدخل الخلفيّ للقلعة

168
00:12:26,760 --> 00:12:28,800
!ثمّة بوّابة ليست في التّصاميم

169
00:12:28,800 --> 00:12:30,720
.لا بدّ أنّهم وسّعوا المكان

170
00:12:32,230 --> 00:12:33,610
!اختبئوا

171
00:12:36,350 --> 00:12:38,820
!أهو من كبار الجنود؟ كم هذا مزعج

172
00:12:38,820 --> 00:12:41,570
!اسمعوا! جدوه بأسرع وقت ممكن

173
00:12:41,570 --> 00:12:42,070
!حاضر

174
00:12:42,070 --> 00:12:44,610
.لا، لن يكون هذا مزعجًا على الإطلاق

175
00:12:44,820 --> 00:12:46,530
.أنا أعرفه

176
00:12:46,780 --> 00:12:48,700
...سأذهب للحديث معه

177
00:12:48,950 --> 00:12:50,160
!من هناك؟

178
00:12:50,160 --> 00:12:51,780
!مهلاً، هذا أنا

179
00:12:51,780 --> 00:12:52,990
...أنت

180
00:12:52,990 --> 00:12:54,830
...لم أرك منذ مدّة

181
00:12:55,120 --> 00:12:56,410
!يا ساساكي

182
00:12:56,410 --> 00:13:00,300
!كيوشيرو! سمعتُ أنّك لن تأتي هذه السّنة

183
00:13:00,300 --> 00:13:02,420
!صحيح، لا تخبر أيّ أحد عنّي

184
00:13:02,420 --> 00:13:06,050
أتيت خلسة؟ ما الّذي حدث لتسريحتك المزيّفة؟

185
00:13:06,050 --> 00:13:09,100
.ليس من عادتك أن تغادر وليمة ما

186
00:13:09,100 --> 00:13:13,390
.صحيح. ابن كايدو-سان مفقود

187
00:13:13,390 --> 00:13:16,020
على أيّ حال، أتودّ الشّرب؟

188
00:13:16,020 --> 00:13:17,060
!بالطّبع

189
00:13:17,060 --> 00:13:20,000
!يا رجال، عودوا إلى قبّة الجمجمة

190
00:13:20,000 --> 00:13:22,320
.سأنضمّ لكم لاحقًا

191
00:13:22,900 --> 00:13:28,090
.البوّابة الّتي لم تكن في التّصاميم
.وساسكي، واحد من التّوبي روبّو

192
00:13:28,090 --> 00:13:33,730
ولكن، بفضل كيوشيرو الّذي كان محلّ
،ثقة العدوّ لوقت طويل

193
00:13:33,730 --> 00:13:36,410
.كانتا عقبتين سهلتَيْ التّخطّي

194
00:13:40,790 --> 00:13:44,210
!حجر بحريّ؟! ما الّذي تفعله يا كيوشيرو؟

195
00:13:44,460 --> 00:13:46,260
!شدّوا وثاقه

196
00:13:46,260 --> 00:13:47,050
!حاضر

197
00:13:47,760 --> 00:13:50,640
!ما الّذي يحدث؟! أجبني

198
00:13:50,640 --> 00:13:52,560
!كمّموا فمه أيضًا

199
00:13:52,560 --> 00:13:53,430
!حاضر

200
00:13:53,430 --> 00:13:55,430
!أجبني يا كيوشيرو

201
00:13:55,430 --> 00:13:57,640
...اسمع يا ساساكي

202
00:13:57,640 --> 00:14:02,150
هل تعرف تاريخ بلاد وانو؟

203
00:14:02,860 --> 00:14:04,280
!أذلك...؟

204
00:14:09,240 --> 00:14:12,700
،بعد تقييد أحد التّوبي روبّو الأقوياء

205
00:14:12,700 --> 00:14:17,160
قسّم دنجيرو مجموعته إلى نصفين
.كما حدث مع القوّات الشّرقيّة

206
00:14:17,160 --> 00:14:19,330
!اذهبوا إلى داخل القبّة

207
00:14:19,330 --> 00:14:21,310
!حظًّا موفّقًا

208
00:14:21,920 --> 00:14:28,050
.بالتّالي، تدنو القوّات الجنوبيّة من كايدو بوتيرة ثابتة

209
00:14:52,110 --> 00:14:55,290
!كم أنّ هؤلاء الحمقى مزعجين

210
00:14:55,490 --> 00:14:57,640
!أين ذهبت أيّها التّانوكي؟

211
00:14:57,640 --> 00:15:01,250
!عليكم دفع ما فعلتموه بكعكة الزّفاف خاصّتي

212
00:15:01,250 --> 00:15:02,790
!يا صاحبة الجلالة بيغ مام

213
00:15:04,540 --> 00:15:08,500
،سمعنا أنّك تريدين تدمير دبّابة
!فأتينا على عجل

214
00:15:08,500 --> 00:15:14,550
حسنًا. لماذا لا تأخذون مواقعكم إذًا
!وتعثرون عليهم بالفعل؟

215
00:15:14,550 --> 00:15:15,510
!حاضر

216
00:15:15,510 --> 00:15:17,850
!يا قائد الدّبّابة تشوبّر، ماذا نفعل؟

217
00:15:17,850 --> 00:15:23,400
هذا سيّئ! يضعون جميعهم أفخاخًا
!ونيّتهم الإطلاق علينا

218
00:15:23,400 --> 00:15:24,680
!لا فائدة

219
00:15:24,680 --> 00:15:26,730
!نحن هالكون

220
00:15:26,730 --> 00:15:28,190
!يا قائد الدّبّابة تشوبّر

221
00:15:28,190 --> 00:15:31,690
!ألا تتذكّر هدفنا؟

222
00:15:31,690 --> 00:15:33,070
هدفنا؟

223
00:15:33,070 --> 00:15:37,790
مهمّتنا هي الانضمام لفرانكي ودرّاجة
،وحيد القرن الأسود على التّلّة الموعودة

224
00:15:37,790 --> 00:15:41,610
!والاندماج لنصبح الجنرال فرانكي

225
00:15:41,610 --> 00:15:42,870
...صحيح

226
00:15:42,870 --> 00:15:45,920
!ذلك الاندماج هو أفضل فرصنا

227
00:15:45,920 --> 00:15:51,380
غرائزك الحيوانيّة هي أملنا الوحيد
!للخروج من هذا الوضع

228
00:15:51,880 --> 00:15:54,220
...أيّها السّائق أوسوبّ

229
00:15:55,050 --> 00:15:59,350
.أنت محقّ. أظنّني كنت متعبًا

230
00:16:01,810 --> 00:16:06,360
،إن لم نثق في دبّابة براكيو هذه
!فمن غيرنا سيفعل؟

231
00:16:08,190 --> 00:16:11,440
!يا قائد الدّبّابة تشوبّر، ما هي أوامرك؟

232
00:16:13,480 --> 00:16:15,990
!لننطلق بأقصى سرعة ممكنة

233
00:16:15,990 --> 00:16:17,370
!عُلم

234
00:16:20,160 --> 00:16:23,580
!يضع العدوّ فخًّا عند الشّقّ في الجدار

235
00:16:23,580 --> 00:16:26,250
!استدر عن طريق الانزلاق عندما أعطيك الإشارة

236
00:16:27,210 --> 00:16:28,380
!الآن

237
00:16:28,800 --> 00:16:30,460
!انطلقي يا براكيو

238
00:16:32,750 --> 00:16:33,970
!أطلقوا

239
00:16:36,550 --> 00:16:38,300
!حسنًا، أطلق بدورك

240
00:16:43,100 --> 00:16:45,100
!أطلقوا هجمات مدافع الهاون

241
00:16:53,230 --> 00:16:55,200
!دع الأمر لي

242
00:17:01,370 --> 00:17:03,830
!ثمّة مدافع ضخمة أمامنا

243
00:17:03,830 --> 00:17:07,460
!تقدّم بلا تردّد! سننال منهم من مدى قريب

244
00:17:19,510 --> 00:17:23,520
!الآن! أرهم ما لديك أيّها السّائق أوسوبّ

245
00:17:23,520 --> 00:17:25,440
!دع الأمر لي

246
00:17:34,230 --> 00:17:37,950
.أطاحا بهم جميعًا... ليسا سيّئين

247
00:17:37,950 --> 00:17:40,620
!لكنّني صرت أعرف أين التّانوكي الآن

248
00:17:44,790 --> 00:17:47,190
أتعرفان ما نقطة ضعف الدّبّابة؟

249
00:17:47,190 --> 00:17:50,400
!إنّها الهجمات من الأعلى

250
00:17:50,400 --> 00:17:53,090
!هجمات قنابل بيغ مام

251
00:17:55,090 --> 00:17:58,010
!إنّها فوقنا! لنهرب بأسرع ما لدينا

252
00:18:05,220 --> 00:18:06,680
!أوقف الدّبّابة

253
00:18:06,680 --> 00:18:08,560
!لماذا أيّها القائد؟

254
00:18:08,560 --> 00:18:14,070
!ثق بصلابة درع دبّابة براكيو
!لا بدّ من مخرج من هذا

255
00:18:15,440 --> 00:18:20,160
.حسنًا، لنعهد بمصيرنا لدبّابة براكيو

256
00:18:28,330 --> 00:18:31,080
!ها هو ذا الهجوم المفجّر

257
00:18:39,050 --> 00:18:41,020
!موتا

258
00:18:41,390 --> 00:18:43,930
!أيّها السّائق أوسوبّ، الآن

259
00:18:44,220 --> 00:18:46,850
!حسنًا! الطّلقة المباشرة

260
00:18:49,100 --> 00:18:51,900
!إليك بعض الحلوى الإضافيّة! استمتعي

261
00:19:06,200 --> 00:19:09,330
فزنا، أليس كذلك أيّها السّائق أوسوبّ؟

262
00:19:09,330 --> 00:19:12,920
!يا قائد الدّبّابة، إنّه فوز كامل

263
00:19:12,920 --> 00:19:16,840
!قُدتنا ببراعة يا قائد الدّبّابة تشوبّر

264
00:19:16,840 --> 00:19:22,090
!كلاّ، نجونا بفضل مهاراتك في التّصويب

265
00:19:22,090 --> 00:19:25,590
...على أيّ حال، كانت معركة صعبة

266
00:19:25,590 --> 00:19:28,430
!أيّها القائد، لنذهب للقاء البقيّة

267
00:19:28,430 --> 00:19:30,480
!حسنًا. لنعد

268
00:19:33,150 --> 00:19:39,780
أنتما، لا تظنّان فعلاً أنّ بإمكانكما
،الإطاحة بي بهذه السّهولة

269
00:19:39,780 --> 00:19:43,280
!أليس كذلك؟

270
00:19:43,490 --> 00:19:46,080
!لا تعبثا معي

271
00:19:46,700 --> 00:19:49,490
أيّها القائد، ما-ما أوامرك...؟

272
00:19:49,490 --> 00:19:52,250
...تـ-تعرف ما قد أقوله

273
00:19:54,170 --> 00:19:56,750
!لنقم بتراجع تخطيطيّ

274
00:19:56,750 --> 00:19:58,550
!عرفتُ أنّ الأمر لن ينجح

275
00:19:58,550 --> 00:20:00,130
!بالطّبع لن ينجح

276
00:20:00,130 --> 00:20:03,060
!أيّها التّانوكي

277
00:20:06,470 --> 00:20:10,700
،رغم أنّهما كانا خائفين
...هربا في الاتّجاه المعاكس

278
00:20:10,700 --> 00:20:14,730
...شكرًا لكما أيّها القائد تشوبّر والسّائق أوسوبّ

279
00:20:15,360 --> 00:20:16,860
!لنواصل

280
00:20:16,860 --> 00:20:17,980
!أجل

281
00:20:17,980 --> 00:20:21,990
!يا رفاق! لا تدعوا هذه التّضحية تضيع هباءً

282
00:20:21,990 --> 00:20:24,030
!مهلاً، ألا يجدر بنا فعل شيء ما؟

283
00:20:24,030 --> 00:20:29,160
أظنّ أنّ ذلك المرأة النّاضجة المتوحّشة
!أكثر ممّا يمكن لذلكما الفتيين تحمّله

284
00:20:29,160 --> 00:20:31,580
!معها حقّ! إنّها بيغ مام

285
00:20:31,580 --> 00:20:35,020
!أعلم، لهذا السّبب ليس بوسعنا فعل شيء

286
00:20:35,020 --> 00:20:38,230
!لنشكرهما على استدراجها فحسب

287
00:20:38,230 --> 00:20:41,380
على أيّ حال، لماذا المكان حارّ هنا؟

288
00:20:41,380 --> 00:20:44,880
!نامي! انظري للأعلى! نحن في ورطة

289
00:20:46,510 --> 00:20:48,390
!وجدتك

290
00:20:48,880 --> 00:20:53,270
!إنّها المرأة الّتي سرقت زوس يا ماما

291
00:20:55,350 --> 00:20:57,530
!نالوا منه

292
00:21:00,940 --> 00:21:02,570
!ريوو

293
00:21:07,070 --> 00:21:08,320
!اللّعنة عليك

294
00:21:14,210 --> 00:21:16,050
!أيّها الوغد

295
00:21:23,340 --> 00:21:26,260
!بي-تان! بي-تان! بي-تان

296
00:21:26,260 --> 00:21:30,560
!انطلق يا بي-تان

297
00:21:30,800 --> 00:21:33,730
!اسمعي! اذهبي للبحث في مكان آخر يا غبيّة

298
00:21:33,730 --> 00:21:38,020
!أنت يا بي-تان! ماذا قلت؟

299
00:21:38,020 --> 00:21:42,400
!اخرسي! أنت غبيّة! غبيّة، غبيّة، غبيّة

300
00:21:42,400 --> 00:21:45,050
!قل أنّني أخت كبيرة رائعة

301
00:21:45,050 --> 00:21:46,240
...لكن

302
00:21:47,030 --> 00:21:48,760
...لا يمكنني الرّكض أكثر

303
00:21:48,760 --> 00:21:53,040
!يا بي-تان! أنا متعبة-أرينسو

304
00:21:53,040 --> 00:21:55,200
!لا أهتمّ! هيّا بنا

305
00:21:55,200 --> 00:22:00,880
لا طاقة لديّ... حتّى أخي العزيز
...يعتبرني حمقاء

306
00:22:00,880 --> 00:22:04,590
!يا لي من مسكينة

307
00:22:04,590 --> 00:22:08,300
!لا تؤخّريني! اجلسي هناك فحسب إن كنت متعبة

308
00:22:08,300 --> 00:22:10,350
...لماذا لا يمكنك أن تقول

309
00:22:12,260 --> 00:22:13,560
!مصيبة

310
00:22:14,220 --> 00:22:17,350
"!دعني أحملك على ظهري؟"

311
00:22:17,720 --> 00:22:20,610
!ابتعدي عنّي! هيّا

312
00:22:20,610 --> 00:22:23,740
!مهلاً! اتركيني يا أختي

313
00:22:24,440 --> 00:22:25,780
...أيّها الـ

314
00:22:25,780 --> 00:22:27,650
!اسمعي! أنا جادّ! توقّفي

315
00:22:30,240 --> 00:22:31,450
!بي-تان؟

316
00:22:31,990 --> 00:22:34,620
!بي-تان! بي-تان! بي-تان

317
00:22:34,620 --> 00:22:37,910
!تماسك، تماسك، تماسك

318
00:22:37,910 --> 00:22:43,340
!يا أخي بي-تان

319
00:22:47,500 --> 00:22:48,510
ماذا؟

320
00:22:49,210 --> 00:22:50,910
!بي-تان

321
00:22:50,910 --> 00:22:56,100
!ضحّى بي-تان بنفسه لإنقاذي

322
00:22:59,970 --> 00:23:02,110
!من تكون يا هذا؟

323
00:23:02,110 --> 00:23:03,650
!ومن تكونين؟

324
00:23:18,200 --> 00:23:20,120
!اعتُرف به كعدوّ قويّ

325
00:23:20,120 --> 00:23:26,300
هاكي لون الملك الأسمى الّذي استعمله الرّجل الّذي
!يسعى ليكون ملك القراصنة يفاجئ أولتي وبيج وان

326
00:23:26,300 --> 00:23:29,470
وعندما يوشكان على مهاجمة لوفي
،في هيئة الوحش خاصّتهما

327
00:23:29,470 --> 00:23:35,980
يظهر غريب يرتدي قناع شيطان
.وصوت قباقيب خشبيّة

328
00:23:36,600 --> 00:23:41,080
:في الحلقة القادمة من وان بيس
"!باغوا الرّعد! ها قد أتى ابن كايدو"

329
00:23:41,080 --> 00:23:45,690
!ملك القراصنة، لن يكون إلاّ أنا