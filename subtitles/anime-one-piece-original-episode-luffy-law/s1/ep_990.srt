1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:13,940 --> 00:02:19,530
في الطّريق إلى هنا، قطع الحبال
!وحاول الهرب، لذلك أفقدته وعيه

29
00:02:19,530 --> 00:02:22,280
!لا تقلق، ما زال حيًّا

30
00:02:27,700 --> 00:02:32,340
كيف أمكنك فعل ذلك لوريث كوزكي
الّذي كان سيّدك في الماضي...؟

31
00:02:32,870 --> 00:02:35,880
!لديك قلب بارد ومن حجر

32
00:02:35,880 --> 00:02:39,880
انتهيت من لعب الدّور، لذلك
.فهو الآن مجرّد شقيّ لا أعرفه

33
00:02:39,880 --> 00:02:44,120
!أبليتَ حسنًا بقيامك بدور الجاسوس لوقت طويل

34
00:02:44,120 --> 00:02:45,850
!أحسنت عملاً

35
00:02:45,850 --> 00:02:47,730
!لا يا أوروتشي-ساما

36
00:02:47,730 --> 00:02:50,580
...بل فشلت في اعتراض خطّة الأكازايا

37
00:02:50,580 --> 00:02:57,440
بسبب هجوم طاقم قبّعة القشّ
!وبقيّة طواقم القراصنة المفاجئ

38
00:02:57,440 --> 00:02:59,440
!ماذا؟! فشلت؟

39
00:02:59,440 --> 00:03:06,160
،قوّات المتمرّدين، 5400 محاربًا
!يتقدّمون الآن نحو أونيغاشيما

40
00:03:06,910 --> 00:03:08,330
!لوفي؟

41
00:03:08,330 --> 00:03:11,120
هـ-هل ما زالوا أحياء؟

42
00:03:11,120 --> 00:03:16,670
!أ-أي أنّك تقول أنّ الـ-الأكازايا ما زالوا موجودين؟

43
00:03:18,000 --> 00:03:20,360
!سُحقًا لك

44
00:03:20,360 --> 00:03:23,390
!فشلت في اعتراض خطّتهم؟

45
00:03:23,840 --> 00:03:25,430
!بلاك ماريا

46
00:03:25,430 --> 00:03:27,260
!أعطني إيّاه

47
00:03:27,260 --> 00:03:33,360
!هذا صحيح! لا يجب أن ننسى
!إنّه قائد العدوّ

48
00:03:34,690 --> 00:03:37,980
!جهّزوا منصّة الإعدام

49
00:03:37,980 --> 00:03:44,530
،إن انتهى نسل عائلة كوزكي البارزة
!فإنّ ولاءهم المتعفّن سينهار أيضًا

50
00:03:44,530 --> 00:03:47,080
!وسينتهي الأمر

51
00:03:50,490 --> 00:03:52,040
...لوفي

52
00:03:52,950 --> 00:03:54,800
...رفاق

53
00:03:55,160 --> 00:03:57,130
...أبتاه

54
00:03:58,550 --> 00:04:01,140
!ها هو ذا الهجوم المفجّر

55
00:04:09,270 --> 00:04:11,270
!موتا

56
00:04:11,560 --> 00:04:14,330
!أيّها السّائق أوسوبّ، الآن

57
00:04:14,330 --> 00:04:17,060
!حسنًا! الطّلقة المباشرة

58
00:04:19,230 --> 00:04:22,030
!إليك بعض الحلوى الإضافيّة! استمتعي

59
00:04:30,410 --> 00:04:36,860
أنتما، لا تظنّان فعلاً أنّ بإمكانكما
،الإطاحة بي بهذه السّهولة

60
00:04:36,860 --> 00:04:40,380
!أليس كذلك؟

61
00:04:40,590 --> 00:04:43,300
!لا تعبثا معي

62
00:04:43,800 --> 00:04:46,590
أيّها القائد، ما-ما أوامرك...؟

63
00:04:46,590 --> 00:04:49,350
...تـ-تعرف ما قد أقوله

64
00:04:51,270 --> 00:04:53,850
!لنقم بتراجع تكتيكيّ

65
00:04:53,850 --> 00:04:55,640
!عرفتُ أنّ الأمر لن ينجح

66
00:04:55,640 --> 00:04:57,230
!بالطّبع لن ينجح

67
00:04:57,230 --> 00:05:00,110
!أيّها التّانوكي

68
00:05:03,520 --> 00:05:07,760
،رغم أنّهما كانا خائفين
...هربا في الاتّجاه المعاكس

69
00:05:07,760 --> 00:05:11,950
...شكرًا لكما أيّها القائد تشوبّر والسّائق أوسوبّ

70
00:05:13,700 --> 00:05:15,580
!اللّعنة عليك

71
00:05:21,380 --> 00:05:23,340
!أيّها الوغد

72
00:05:34,680 --> 00:05:35,680
ماذا؟

73
00:05:41,150 --> 00:05:43,360
!من تكون يا هذا؟

74
00:05:43,360 --> 00:05:44,900
!ومن تكونين؟

75
00:05:55,490 --> 00:06:00,830
"!باغوا الرّعد! ها قد أتى ابن كايدو"

76
00:06:25,940 --> 00:06:27,240
!أخيرًا

77
00:06:27,690 --> 00:06:30,280
!وصلت أخيرًا

78
00:06:43,870 --> 00:06:45,670
!كنت في الانتظار

79
00:06:45,670 --> 00:06:48,630
!انتظرت كلّ هذا الوقت

80
00:06:56,520 --> 00:06:58,730
...لأراك

81
00:07:00,690 --> 00:07:05,440
!انتظرت كلّ هذا الوقت من أجل هذه اللّحظة

82
00:07:31,800 --> 00:07:36,010
!كيد! التّسلّل بشكل مباشرة أمر متهوّر كما توقّعت

83
00:07:37,260 --> 00:07:40,310
!كفّ عن الشّكوى واحمِ ظهري

84
00:07:40,310 --> 00:07:43,650
!بإمكاننا أن ننجح معًا

85
00:07:44,350 --> 00:07:45,480
!أنت على حقّ

86
00:07:46,190 --> 00:07:49,860
...لقد افترقنا عن هيت والبقيّة

87
00:07:49,860 --> 00:07:52,090
،ممّن كانوا يقاتلون معنا

88
00:07:52,090 --> 00:07:54,530
.لكنّهم سيكونون بخير بطريقة ما

89
00:07:59,700 --> 00:08:01,000
!تنافر

90
00:08:10,170 --> 00:08:15,470
!إن قتلناكم، سنحصل على فرصة لنترقّى

91
00:08:15,470 --> 00:08:18,140
...إن كان هدفكم عاليًا لهذه الدّرجة

92
00:08:18,720 --> 00:08:22,600
!فجهّزوا أنفسكم وأروني ما لديكم

93
00:08:26,230 --> 00:08:27,690
!توقّف رجاءً

94
00:08:27,690 --> 00:08:29,480
!كايدو-ساما يبحث عنك

95
00:08:29,480 --> 00:08:32,610
!كفّوا عن مضايقتي! دعوني وشأني

96
00:08:32,610 --> 00:08:35,740
!يا سيّدي الصّغير! توقّف رجاءً

97
00:08:35,740 --> 00:08:40,080
!إن أرخيتم دفاعاتكم، فستموتون

98
00:08:46,210 --> 00:08:49,210
!بي-تان

99
00:08:49,210 --> 00:08:53,170
!بي-تان! هل أنت بخير؟

100
00:08:53,170 --> 00:08:58,560
!تماسك-أرينسو

101
00:08:58,890 --> 00:09:00,470
!أنت

102
00:09:01,640 --> 00:09:03,180
...كيف أمكنك

103
00:09:03,180 --> 00:09:06,230
!كيف أمكنك فعل هذا ببي-تان؟

104
00:09:06,230 --> 00:09:10,980
!لا تتنمّر لأخي بي-تان

105
00:09:14,900 --> 00:09:18,370
.أنت من تزلّج فوقه على الدّرج وكأنّه مزلجة

106
00:09:32,300 --> 00:09:34,900
!قل أنّني أخت كبيرة مذهلة

107
00:09:34,900 --> 00:09:36,220
...لكن

108
00:09:36,920 --> 00:09:38,660
.لا يمكنني الرّكض أكثر

109
00:09:38,660 --> 00:09:42,930
!يا بي-تان! أنا متعبة-أرينسو

110
00:09:42,930 --> 00:09:45,100
!لا أهتمّ! هيّا بنا

111
00:09:45,100 --> 00:09:50,770
لا طاقة لديّ... حتّى أخي العزيز
...يعتبرني حمقاء

112
00:09:50,770 --> 00:09:53,910
!يا لي من مسكينة

113
00:09:54,480 --> 00:09:58,200
!لا تؤخّريني! اجلسي هناك فحسب إن كنت متعبة

114
00:09:58,200 --> 00:10:00,530
...لماذا لا يمكنك أن تقول

115
00:10:02,160 --> 00:10:03,460
!مصيبة

116
00:10:04,120 --> 00:10:07,620
"!دعني أحملك على ظهري؟"

117
00:10:07,620 --> 00:10:10,580
!ابتعدي عنّي! هيّا

118
00:10:10,580 --> 00:10:13,590
!مهلاً! اتركيني يا أختي

119
00:10:14,130 --> 00:10:15,090
...أيّها الـ

120
00:10:15,090 --> 00:10:17,340
!اسمعي! أنا جادّ! توقّفي

121
00:10:19,930 --> 00:10:21,310
!بي-تان؟

122
00:10:21,680 --> 00:10:24,390
!بي-تان! بي-تان! بي-تان

123
00:10:24,390 --> 00:10:27,510
!تماسك، تماسك، تماسك

124
00:10:27,600 --> 00:10:32,320
!يا أخي بي-تان

125
00:10:34,770 --> 00:10:35,780
ماذا؟

126
00:10:36,440 --> 00:10:38,050
!بي-تان

127
00:10:38,050 --> 00:10:43,200
!ضحّى بي-تان بنفسه لإنقاذي

128
00:10:46,750 --> 00:10:49,540
!كلاّ! لم أفعل أيّ شيء

129
00:10:51,170 --> 00:10:55,670
ما اسمك؟! تحت إمرة من تعمل
!وإلى أيّ وحدة تنتمي؟

130
00:10:55,670 --> 00:10:58,260
...لا يا أختي

131
00:10:59,130 --> 00:11:00,840
.إنّه متسلّل

132
00:11:00,840 --> 00:11:02,910
!ماذا؟

133
00:11:02,910 --> 00:11:06,560
!أنت! من تكون يا هذا؟

134
00:11:13,360 --> 00:11:15,070
!أنا لوفي

135
00:11:16,320 --> 00:11:19,030
!الرّجل الّذي سيصير ملك القراصنة

136
00:11:29,450 --> 00:11:34,420
أتعرف في قلعة من أنت الآن؟

137
00:11:34,420 --> 00:11:39,920
!لا مجال للشّكّ أنّ كايدو-ساما سيصير ملك القراصنة

138
00:11:43,010 --> 00:11:46,100
!أيّها المغفّل

139
00:11:46,810 --> 00:11:51,020
!سأحطّم جمجمتك

140
00:11:51,310 --> 00:11:52,890
!نطحة؟

141
00:11:53,600 --> 00:11:56,230
!مدفع رأس أولتي

142
00:13:17,100 --> 00:13:19,940
!يا أختي

143
00:13:20,480 --> 00:13:22,780
...أعلم

144
00:13:28,530 --> 00:13:30,450
أنت أيضًا يا بي-تان؟

145
00:13:30,450 --> 00:13:31,790
!نعم

146
00:14:00,480 --> 00:14:04,030
...المعذرة، لكن

147
00:14:04,030 --> 00:14:07,490
!لماذا تحوّلتما؟

148
00:14:08,900 --> 00:14:11,000
!أولتي-ساما

149
00:14:13,570 --> 00:14:15,830
!بيج وان-ساما

150
00:14:18,120 --> 00:14:20,790
...أولتي-ساما؟ عفوًا

151
00:14:20,790 --> 00:14:23,000
!اخرس

152
00:14:23,590 --> 00:14:25,680
...لأنّنا

153
00:14:26,260 --> 00:14:30,180
!اعترفنا به كعدوّ قويّ

154
00:14:30,180 --> 00:14:35,060
!لا، لا، لا، تحطّم رأسه وقد مات

155
00:14:39,900 --> 00:14:42,770
!كيف تفسّر إذًا ذلك الهاكي؟

156
00:14:42,770 --> 00:14:45,230
!آلمني ذلك

157
00:14:52,860 --> 00:14:57,670
...ثمّة الكثير من الأقوياء هنا

158
00:15:04,710 --> 00:15:07,180
.كنت أقلّل من شأنهم

159
00:15:08,210 --> 00:15:10,140
.كنت مخطئًا

160
00:15:12,050 --> 00:15:14,520
!تنتمي هذه القلعة لأحد اليونكو

161
00:16:11,700 --> 00:16:15,620
!سأدمّرك

162
00:16:48,610 --> 00:16:51,110
...فاكهة المطّاط

163
00:17:08,380 --> 00:17:10,250
!أختي

164
00:17:25,770 --> 00:17:27,650
...فاكهة المطّاط

165
00:17:28,900 --> 00:17:32,070
!مسدّس الفيل

166
00:17:37,900 --> 00:17:40,490
!بيج وان-ساما! هل أنت بخير؟

167
00:17:40,490 --> 00:17:42,500
...بيج وان-ساما

168
00:17:44,700 --> 00:17:47,670
!أيّها الوغد

169
00:17:47,790 --> 00:17:52,210
!كيف تجرؤ على فعل ذلك لبي-تان؟

170
00:17:57,590 --> 00:17:59,970
!سأدمّرك

171
00:17:59,970 --> 00:18:02,220
!تحوّلت أولتي-ساما لديناصور أيضًا

172
00:18:02,220 --> 00:18:04,760
!رجاءً! لن تتحمّل القلعة أكثر

173
00:18:04,760 --> 00:18:08,700
!اخرس! لا تملِ عليّ ما أفعله

174
00:18:08,700 --> 00:18:11,060
!مدفع رأس أولتي

175
00:18:16,320 --> 00:18:19,590
!يا لصلابة رأسك

176
00:18:19,590 --> 00:18:25,120
!لن ينتهي هذا حتّى يُحطَّم بالكامل

177
00:18:37,300 --> 00:18:40,810
!إنّها... شديدة القوّة

178
00:18:46,050 --> 00:18:51,520
!سوف أفتح رأسك

179
00:18:55,980 --> 00:19:00,160
!مدفع رأس أولتي

180
00:19:16,960 --> 00:19:18,250
!كلاّ

181
00:19:18,250 --> 00:19:20,680
!المستوى الرّابع

182
00:19:42,700 --> 00:19:45,450
!باغوا الرّعد

183
00:21:20,330 --> 00:21:22,590
!قبّعة القشّ لوفي

184
00:21:26,420 --> 00:21:27,930
!هذا أنت، صحيح؟

185
00:21:33,300 --> 00:21:34,940
!هذا صحيح

186
00:21:36,310 --> 00:21:40,150
...أنا

187
00:21:48,280 --> 00:21:49,610
!من أنت؟

188
00:21:49,610 --> 00:21:50,740
!إنّه يهرب

189
00:21:50,740 --> 00:21:51,450
!ياماتو-ساما

190
00:21:51,450 --> 00:21:53,830
!أمسكوه

191
00:21:59,120 --> 00:22:02,670
!أنا أعتذر! لن ألحق بك أيّ ضرر

192
00:22:09,090 --> 00:22:13,770
...أعلم، لا يبدو أنّك قد تفعل ذلك

193
00:22:14,100 --> 00:22:17,110
!اسمع، عليّ الذّهاب

194
00:22:17,640 --> 00:22:19,730
!كنتُ في انتظارك

195
00:22:24,230 --> 00:22:27,150
!أخيرًا! أتيتَ إلى هنا أخيرًا

196
00:22:28,230 --> 00:22:32,160
!انتظرتك لوقت طويل

197
00:22:32,160 --> 00:22:34,660
!وقت طويل جدًّا

198
00:22:42,500 --> 00:22:44,930
!اسمي ياماتو

199
00:22:45,510 --> 00:22:48,220
!أنا ابن كايدو

200
00:23:18,120 --> 00:23:20,440
!كالمستجير من الرّمضاء بالنّار

201
00:23:20,440 --> 00:23:26,170
،هرب لوفي من عضوي توبي روبّو مرعبين
.ليجد ياماتو، ابن كايدو، واقفًا في طريقه

202
00:23:26,170 --> 00:23:31,410
!إنّه يخفي طموحه ويظهر قوّته الوحشيّة
!ما الّذي يريده من لوفي؟

203
00:23:31,410 --> 00:23:36,020
.عندما يتصادم الاثنان، ستُكشف حقيقة أخرى

204
00:23:36,390 --> 00:23:40,730
:في الحلقة القادمة من وان بيس
"!عدوّ أم صديق؟ لوفي وياماتو"

205
00:23:40,730 --> 00:23:45,650
!ملك القراصنة، لن يكون إلاّ أنا