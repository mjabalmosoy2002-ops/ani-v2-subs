1
00:00:11,020 --> 00:00:19,040
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

2
00:00:23,660 --> 00:00:26,500
في نهاية الأحلام، في نهاية البحر

3
00:00:26,500 --> 00:00:29,000
لكلّ واحد منّا مكان يسعى إليه

4
00:00:29,000 --> 00:00:32,010
ولكن أوّلاً، علينا صنع

5
00:00:32,010 --> 00:00:36,890
أسطورة لامعة من أنفسنا

6
00:00:37,340 --> 00:00:39,720
شرارات متطايرة من هنا بلا حدود

7
00:00:39,720 --> 00:00:41,350
!وان بيس

8
00:00:41,350 --> 00:00:43,980
سنخبر جميعنا الرّحّالة

9
00:00:43,980 --> 00:00:47,980
هل ما زالت أحلامكم واضحة؟

10
00:00:49,360 --> 00:00:56,030
خلاياي الّتي لا تنام تدغدغني وتنفجر

11
00:00:56,030 --> 00:01:02,500
وحتّى الآن، جميعنا في خضمّ مغامرة

12
00:01:02,500 --> 00:01:05,120
سنخبر جميعنا الرّحّالة

13
00:01:05,120 --> 00:01:08,880
لا توجد قتالات بلا معنى

14
00:01:10,540 --> 00:01:17,010
إن كان السّياق العشوائيّ بدأ يصير منطقيًّا

15
00:01:17,010 --> 00:01:23,600
فإنّ خيوط الزّمن ستُحاك

16
00:01:23,600 --> 00:01:29,730
معنا، سيستمرّ العالم في التّغيّر

17
00:01:29,730 --> 00:01:36,860
(جميعنا الحلم ينقذنا)
نحن، نحن، نحن، جميعنا

18
00:01:44,290 --> 00:01:46,710
...فاكهة المطّاط

19
00:01:46,870 --> 00:01:48,080
!توقّف

20
00:01:52,090 --> 00:01:53,920
!أتوسّل إليكم

21
00:01:53,920 --> 00:01:56,970
!لا تؤذوا أبي

22
00:01:56,970 --> 00:01:58,590
!اهربي أيّتها الغبيّة

23
00:01:58,830 --> 00:02:00,300
!إنّه باسيفيستا

24
00:02:10,490 --> 00:02:14,860
"!يتعمّق الغموض أكثر! طابق مختبر إيغهيد"

25
00:02:32,630 --> 00:02:36,420
أخبريني! هل كوما هو والدك بالفعل؟

26
00:02:36,670 --> 00:02:39,440
نعم! لماذا كنتُ لأكذب عليكم؟

27
00:02:39,500 --> 00:02:41,510
!كان ذلك مفاجئًا

28
00:02:41,710 --> 00:02:44,720
ألهذا السّبب أتيت لرؤية فيغابانك؟

29
00:03:02,230 --> 00:03:03,370
!أيّها الوغد

30
00:03:03,440 --> 00:03:06,580
.إنّه بخير. أنا أوفّر لنا الوقت فحسب

31
00:03:06,580 --> 00:03:07,570
.لنغادر

32
00:03:07,570 --> 00:03:08,760
...أبي

33
00:03:13,530 --> 00:03:15,510
بوني! ما الّذي تفعلينه؟

34
00:03:18,710 --> 00:03:19,890
!أنت، اتركني

35
00:03:19,960 --> 00:03:21,520
.غبيّة، لنغادر المكان

36
00:03:25,210 --> 00:03:28,180
!لم يوفّر ذلك أيّ وقت لنا

37
00:03:38,490 --> 00:03:40,030
.الإمساك بالمشتبه بهم

38
00:03:45,520 --> 00:03:46,580
.من هنا

39
00:03:47,870 --> 00:03:49,080
.إنّه طريق مسدود

40
00:03:49,240 --> 00:03:50,290
.لا خيار آخر أمامنا

41
00:03:50,490 --> 00:03:52,870
،أنا آسف يا بوني

42
00:03:53,450 --> 00:03:56,340
.لكنّي سأوقفه باستعمال القوّة

43
00:03:56,340 --> 00:03:57,570
!كلاّ

44
00:03:57,570 --> 00:03:59,050
.آسف يا بوني

45
00:03:59,260 --> 00:04:01,020
.أغلقي عينيك لوهلة

46
00:04:01,020 --> 00:04:01,760
...حسنًا

47
00:04:01,960 --> 00:04:03,590
ما الّذي ستفعلونه؟

48
00:04:03,590 --> 00:04:05,990
.لا ترخيا دفاعكما

49
00:04:05,990 --> 00:04:09,560
.إنّنا على إيغهيد. جزيرة فيغابانك

50
00:04:09,560 --> 00:04:14,270
!ربّما يكون مختلفًا عن الباسيفيستا الّذين نعرفهم

51
00:04:14,590 --> 00:04:15,400
!هيّا بنا

52
00:04:15,400 --> 00:04:17,360
!توقّفوا

53
00:04:21,990 --> 00:04:22,830
ماذا؟

54
00:04:25,530 --> 00:04:26,870
ما الّذي يحدث؟

55
00:04:30,540 --> 00:04:31,620
!نحن في مشكلة

56
00:04:31,620 --> 00:04:33,730
...الإمساك بالـ

57
00:04:42,670 --> 00:04:44,350
ما كان ذلك؟

58
00:04:44,710 --> 00:04:46,810
...يا إلهي

59
00:04:47,640 --> 00:04:49,400
لكن لماذا؟

60
00:04:49,590 --> 00:04:52,920
شعرتُ بضعف مفاجئ
...في كلّ جسدي

61
00:04:52,920 --> 00:04:55,500
...لا أستطيع حتّى التّحرّك

62
00:05:00,770 --> 00:05:04,180
!لوفي! تشوبّر! كلاكما صار عجوزًا

63
00:05:04,180 --> 00:05:07,160
...وأنت صرت طفلاً

64
00:05:07,230 --> 00:05:08,460
ماذا؟

65
00:05:09,980 --> 00:05:11,200
.هكذا إذًا

66
00:05:11,430 --> 00:05:15,050
.ما عاد يتعرّف إلينا الآن

67
00:05:15,230 --> 00:05:18,210
...هذه أخبار جيّدة

68
00:05:18,210 --> 00:05:19,790
!لنستغلّ هذا الوضع

69
00:05:20,380 --> 00:05:21,590
...يا إلهي

70
00:05:24,500 --> 00:05:25,470
ماذا؟

71
00:05:25,630 --> 00:05:27,680
.يؤلمني ظهري بشدّة

72
00:05:27,750 --> 00:05:30,140
أأنت بخير يا لوفي؟

73
00:05:32,760 --> 00:05:34,220
...أنا أتألّم

74
00:05:34,380 --> 00:05:35,270
!لوفي

75
00:05:35,470 --> 00:05:38,430
...اختفى لوفي

76
00:05:54,160 --> 00:05:57,870
.يبدو أنّ الباسيفيستا قد توقّف عن البحث

77
00:05:58,280 --> 00:06:00,230
...بوني

78
00:06:00,290 --> 00:06:04,840
ولكن يا بوني، أما كان بمقدورك
تغييري لسنّ أفضل...؟

79
00:06:08,260 --> 00:06:11,470
.أفهم كيف تشعرين، لكنّه ليس الحقيقيّ

80
00:06:11,670 --> 00:06:16,500
إن لم تدعيني أوسعه ضربًا
...فسنكون في خطر كبير

81
00:06:16,500 --> 00:06:18,470
.تمهّل يا لوفي

82
00:06:19,260 --> 00:06:21,130
.المعذرة يا بوني

83
00:06:21,130 --> 00:06:26,280
كلّ ما هنالك هو أنّ لدينا
...تاريخًا سيّئًا مع الباسيفيستا

84
00:06:28,550 --> 00:06:33,380
هل يمكنك إعادتي لجسدي الطّبيعيّ؟

85
00:06:35,990 --> 00:06:37,640
.هذا لا يناسبنا

86
00:06:37,640 --> 00:06:41,400
،بما أنّهم نسخ عن شخص كان بشرًا في الأصل

87
00:06:41,400 --> 00:06:43,770
.من المنطقيّ أن تكون له عائلة

88
00:06:44,630 --> 00:06:47,010
،لا تسيئي فهمي يا بوني

89
00:06:48,120 --> 00:06:50,580
.لكن هذا هو ما أعرفه عن كوما

90
00:06:50,580 --> 00:06:53,400
،بدأ كملك شرّير لمملكة سوربي

91
00:06:53,400 --> 00:06:56,060
.إلى أن طرده الشّعب وصار قرصانًا

92
00:06:56,350 --> 00:06:58,740
،كان عضوًا من الجيش الثّوريّ أيضًا

93
00:06:58,740 --> 00:07:02,540
حتّى أمسكت به البحريّة
.وحكمت عليه بالسّجن المؤبّد

94
00:07:03,350 --> 00:07:06,090
لكنّ فيغابانك كان منبهرًا بقوّته الهائلة

95
00:07:06,090 --> 00:07:09,050
.وقدراته الكامنة

96
00:07:09,050 --> 00:07:13,070
لذلك مقابل المشاركة في تجارب
،لتعزيز الجسد وتطوير النّسخ

97
00:07:13,070 --> 00:07:17,090
استعاد كوما حرّيّته وعاد للبحر
!كواحد من الشّيتشيبوكاي

98
00:07:18,120 --> 00:07:19,460
هل أنا مخطئ؟

99
00:07:20,970 --> 00:07:24,550
يمكنني فهم جعله شيتشيبوكاي
...وإنشاء نسخ عنه

100
00:07:24,870 --> 00:07:27,900
لكنّ تحويله إلى سايبورغ
!هو بمثابة حكم بالإعدام

101
00:07:27,900 --> 00:07:31,270
من كان ليوافق على صفقة
إن علم بنتائجها من البداية؟

102
00:07:31,630 --> 00:07:33,340
.هذا صحيح

103
00:07:33,460 --> 00:07:36,190
.لكنّ السّجن المؤبّد أمر مروّع أيضًا

104
00:07:36,750 --> 00:07:39,810
من يدري كم من الجرائم
ارتكب الطّاغية كوما؟

105
00:07:46,930 --> 00:07:49,130
!لم يكن أبي طاغية أبدًا

106
00:07:49,130 --> 00:07:53,300
!كان يكره حكومة العالم
!ما كان أبدًا ليعمل معهم

107
00:07:53,300 --> 00:07:55,450
!أجروا عليه تجاربهم بالقوّة

108
00:07:55,450 --> 00:07:59,600
كلاّ! هل تحاولين قتلنا؟
!هذا خطير للغاية

109
00:07:59,600 --> 00:08:02,040
أرأيت ما كانت تحمله؟

110
00:08:02,530 --> 00:08:05,960
!إنّه سيف ليزر! لا أصدّق هذا

111
00:08:06,710 --> 00:08:11,090
.هذا مكبّ نفايات
.إنّه مليء ببقايا اختراعات فيغابانك

112
00:08:11,550 --> 00:08:12,810
.سيكون مفيدًا لنا

113
00:08:13,920 --> 00:08:17,930
،بغضّ النّظر عن الظّروف
.إنّه قتلٌ باسم العلم

114
00:08:30,950 --> 00:08:34,850
.أخبرني أبي أنّه من قبيلة خاصّة

115
00:08:35,730 --> 00:08:37,210
وماذا في ذلك؟

116
00:08:37,270 --> 00:08:39,790
لا يمنح ذلك الحقّ لأيّ أحد
!لإجراء تجارب عليه بالقوّة

117
00:08:40,060 --> 00:08:42,500
!لا يمنحهم الحقّ لقتله

118
00:08:42,500 --> 00:08:44,020
!نعم، أوافقك الرّأي

119
00:08:44,020 --> 00:08:45,710
!قبيلة خاصّة؟

120
00:08:47,490 --> 00:08:48,670
...بوني

121
00:08:49,910 --> 00:08:52,320
.أعيديني لسنّي الحقيقيّ أيضًا

122
00:09:01,510 --> 00:09:02,680
!لننطلق

123
00:09:10,110 --> 00:09:12,190
.هذا رائع

124
00:09:13,480 --> 00:09:14,890
!إنّنا نطير

125
00:09:14,890 --> 00:09:17,160
!إنّ الرّوبوت يحلّق في السّماء

126
00:09:18,120 --> 00:09:21,190
أهذه الجزيرة أمامنا هي جزيرة فيغابانك؟

127
00:09:39,640 --> 00:09:43,850
عندما يعرف لوفي وتشوبّر
،أنّنا طرنا باستعمال روبوت ضخم

128
00:09:43,850 --> 00:09:46,440
.فسيحسداننا كثيرًا

129
00:09:46,660 --> 00:09:49,290
كيف لشيء بهذه الضّخامة
أن يحلّق عاليًا هكذا؟

130
00:09:49,290 --> 00:09:50,650
.بسبب مضادّ الجاذبيّة

131
00:09:51,100 --> 00:09:55,010
إنّ فيغافورس-01 يستعمل النّفّاثات
الّتي على ظهره

132
00:09:55,010 --> 00:09:56,860
.ويحلّق باستعمال أجهزة مضادّة للجاذبيّة

133
00:09:56,860 --> 00:09:58,700
مضادّ الجاذبيّة؟

134
00:09:58,700 --> 00:10:03,330
،هذا ممكن فقط بفضل مكيّف هواء الجزيرة
!لكنّ هذا سيصير واقعًا للعالم بأسره قريبًا

135
00:10:06,020 --> 00:10:08,170
!يا لها من مدينة رائعة

136
00:10:08,950 --> 00:10:11,960
.لم أرَ أيّ هندسة مماثلة لهذه من قبل

137
00:10:12,200 --> 00:10:13,420
.سنصعد أكثر

138
00:10:21,340 --> 00:10:25,060
!يوجد وحش ضخم هناك! كم هذا رائع

139
00:10:25,060 --> 00:10:28,770
!هناك روبوت عملاق! كم عددها يا ترى؟

140
00:10:28,770 --> 00:10:30,490
!الأسماك تطير

141
00:10:30,490 --> 00:10:33,230
أتستعمل أجهزة مضادّة للجاذبيّة أيضًا؟

142
00:10:33,230 --> 00:10:34,940
!إنّها مدينة المستقبل بالفعل

143
00:10:35,160 --> 00:10:36,280
.هذا صحيح

144
00:10:36,280 --> 00:10:38,900
.هذه هي الجزيرة حيث نبني المستقبل

145
00:10:41,270 --> 00:10:44,460
!مرحبًا في جزيرة المستقبل إيغهيد

146
00:10:47,330 --> 00:10:50,290
،ستجدون فوق السّحاب اللاّبوفيز
.وهو طابق البحوث

147
00:10:50,470 --> 00:10:53,210
.وفي الأسفل طابق المصنع الفابريوفيز

148
00:10:53,210 --> 00:10:55,920
.يعيش العمّال والباحثون هناك

149
00:10:55,920 --> 00:10:59,380
يبدو أنّ قبطانكم تسبّب
.في فوضى هناك في الأسفل

150
00:10:59,540 --> 00:11:01,310
.حسنًا، على الأقلّ هو بخير

151
00:11:09,810 --> 00:11:11,270
.وصلنا

152
00:11:15,850 --> 00:11:20,370
.ينبض قلبي بسرعة فائقة
ما الّذي ينتظرنا تاليًا؟

153
00:11:21,560 --> 00:11:25,030
!ألن تأتيا معنا أيضًا يا زورو وبروك؟

154
00:11:25,030 --> 00:11:26,440
.سأبقى لحراسة السّفينة

155
00:11:26,440 --> 00:11:27,520
.وأنا كذلك

156
00:11:27,520 --> 00:11:30,120
!أواثقان؟ إنّها جزيرة المستقبل

157
00:11:30,120 --> 00:11:32,750
.أنا لا أثق في تلك المرأة

158
00:11:33,540 --> 00:11:35,650
...يا له من مغفّل

159
00:11:36,110 --> 00:11:40,300
بإمكانك تجاهل رأس الطّحلب ذاك
!يا ليليث-تشان

160
00:11:42,290 --> 00:11:43,430
ماذا الآن؟

161
00:11:43,430 --> 00:11:44,690
.سر وستعرف

162
00:11:44,750 --> 00:11:46,050
أسير...؟

163
00:11:49,450 --> 00:11:51,390
!يشبه هذا جزيرة السّماء –
!ألم أقل لك؟ –

164
00:11:51,390 --> 00:11:52,420
فعلاً؟

165
00:11:52,420 --> 00:11:53,960
!أريد أن أجرّب أيضًا

166
00:11:55,760 --> 00:11:57,190
!هذا رائع

167
00:11:57,190 --> 00:11:58,970
!ذكّرني هذا بالكثير

168
00:11:58,970 --> 00:12:03,180
.فعلاً؟ هذه أوّل تجربة لي
!أنا مندهش تمامًا

169
00:12:03,180 --> 00:12:04,910
أهذا من اختراع فيغابانك أيضًا؟

170
00:12:05,370 --> 00:12:07,370
!استنتاج في محلّه

171
00:12:07,900 --> 00:12:11,310
عن طريق السّيطرة
،على جوّ الجزيرة بالكامل

172
00:12:11,310 --> 00:12:15,270
بإمكاننا تعديل كثافة البايروبلوين
...والرّطوبة في نوى التّكاثف

173
00:12:15,270 --> 00:12:18,780
ونستطيع بالتّالي إعادة تشكيل سحب
.الجزر وسحب البحر الّتي في جزر السّماء

174
00:12:18,780 --> 00:12:20,460
.لم نستنتج أيًّا من هذا

175
00:12:21,440 --> 00:12:23,430
!هذا هو مدخل المختبر

176
00:12:23,430 --> 00:12:25,050
!هذا مذهل

177
00:12:25,370 --> 00:12:26,760
!وهذا رائع

178
00:12:28,710 --> 00:12:31,100
سيكون عليكم ارتداء بذلات
!مختبر قبل الدّخول

179
00:12:31,410 --> 00:12:34,310
.غرف تغيير الملابس على الجانب

180
00:12:34,310 --> 00:12:36,270
عن أيّ نوع من الملابس نتحدّث؟

181
00:12:36,270 --> 00:12:37,750
.لا أطيق الانتظار حتّى أرى ذلك

182
00:12:37,750 --> 00:12:40,780
!يحيا المستقبل! كم أنا توّاق لهذا

183
00:12:40,780 --> 00:12:43,340
كيف ستبدو الملابس؟ –
.سنعرف قريبًا –

184
00:12:43,340 --> 00:12:44,780
!لا أطيق الانتظار

185
00:12:44,780 --> 00:12:46,620
!مكانك يا هذا

186
00:12:47,700 --> 00:12:49,280
!أيّها الغبيّ

187
00:12:49,410 --> 00:12:53,370
من يدري ما الّذي ينتظرنا؟
!عليّ حماية نامي-سان وروبين-تشان

188
00:12:53,370 --> 00:12:55,670
.حمايتهما من واجبي

189
00:12:56,030 --> 00:12:58,150
هذا كلّ شيء. مفهوم؟

190
00:12:58,150 --> 00:13:00,380
.وحدهم الأغبياء من يتخلّون عن النّساء

191
00:13:00,950 --> 00:13:03,090
!أنت الغبيّ! غادر في الحال

192
00:13:04,660 --> 00:13:09,260
.مرحبًا. اختاروا الزّيّ الّذي تحبّون

193
00:13:09,510 --> 00:13:11,470
كيف نقوم بذلك؟

194
00:13:11,670 --> 00:13:13,770
أنضغط على أزرار ما؟

195
00:13:22,060 --> 00:13:23,740
ما الّذي يجري هنا؟

196
00:13:23,740 --> 00:13:26,410
.اسحبوا الرّافعة على أحذية القبّة بأنفسكم

197
00:13:26,480 --> 00:13:28,200
!ستتناسب مع أرجلكم

198
00:13:28,400 --> 00:13:30,270
هكذا، صحيح؟

199
00:13:30,900 --> 00:13:32,300
...تبدو ثقيلة

200
00:13:33,570 --> 00:13:34,450
!على الإطلاق

201
00:13:36,880 --> 00:13:38,420
.تبدو ظريفة

202
00:13:38,880 --> 00:13:41,520
.إنّها تناسبك تمامًا يا روبين
.تبدو مثاليّة

203
00:13:41,520 --> 00:13:45,050
.يمكن لهذه الملابس أن تخنق صاحبها بامتياز

204
00:13:45,050 --> 00:13:47,130
...لا تخيفيني

205
00:13:49,250 --> 00:13:51,560
!لقد حمّستني أزياء المستقبل هذه كثيرًا

206
00:13:51,560 --> 00:13:55,140
!فيغابانك هذا عبقريّ بالفعل
!حتّى الملابس تتناسب مع مقاسي

207
00:13:55,680 --> 00:13:57,640
!هذا خارق

208
00:13:57,640 --> 00:14:00,300
!هذا مجرّد قميص ألوها عاديّ فحسب

209
00:14:01,610 --> 00:14:05,110
لكنّ نامي-سان وروبين-تشان
!ظريفتان، لذلك فهذا لا يهمّ

210
00:14:05,330 --> 00:14:06,950
!لم أرَ هذه الصّيحة من قبل

211
00:14:06,950 --> 00:14:09,030
!روبين، تبدين رائعة وقويّة

212
00:14:09,030 --> 00:14:09,780
فعلاً؟

213
00:14:09,780 --> 00:14:10,910
وأنا؟

214
00:14:10,910 --> 00:14:12,750
!أنت منحرف مهما نظرنا إليك

215
00:14:12,750 --> 00:14:14,370
!يا لها من مجاملة كبيرة

216
00:14:15,470 --> 00:14:17,570
!أنا منحرف

217
00:14:23,250 --> 00:14:26,130
ألا تريد الذّهاب معهم؟

218
00:14:26,130 --> 00:14:31,090
.هذه جزيرة تابعة للحكومة
من سيساعدهم إن أمسكوا بهم؟

219
00:14:32,360 --> 00:14:35,200
.ذلك ما توقّعته أيضًا

220
00:14:35,200 --> 00:14:36,690
أتريد بعض الشّاي؟

221
00:14:36,690 --> 00:14:37,730
.نعم

222
00:14:37,730 --> 00:14:38,560
.حسنًا

223
00:14:38,560 --> 00:14:39,440
.شكرًا لك

224
00:14:39,440 --> 00:14:41,520
!يا سيّداي

225
00:14:41,520 --> 00:14:43,000
أما زلت هنا؟

226
00:14:43,000 --> 00:14:46,280
.سبق وغادرنا بلاد وانو منذ مدّة. وداعًا

227
00:14:46,280 --> 00:14:48,610
!مهلاً، مهلاً لحظة

228
00:14:48,610 --> 00:14:50,890
...صحيح أنّي أردتكم أن توصلوني

229
00:14:50,890 --> 00:14:54,400
بشرط أن تكون أيّ جزيرة
...خارج بلاد وانو

230
00:14:54,710 --> 00:14:58,330
!ولكن إلاّ هذه يا سيّدي
!إنّها جزيرة حكوميّة

231
00:14:58,330 --> 00:15:01,600
.شكرًا على مساعدتك لقبطاننا

232
00:15:01,600 --> 00:15:02,540
.ارحل

233
00:15:04,100 --> 00:15:06,670
!سأجعلهم يدفعون الثّمن

234
00:15:13,600 --> 00:15:15,060
!يبدو هذا ممتعًا

235
00:15:15,060 --> 00:15:16,460
!حسنًا

236
00:15:18,060 --> 00:15:20,300
!هذا ممتع بالفعل

237
00:15:21,900 --> 00:15:23,650
!الدّرج يتحرّك

238
00:15:23,650 --> 00:15:26,400
!إنّ الدّرج يخرج من الأسفل

239
00:15:36,870 --> 00:15:39,580
ما الآليّة المستخدمة هنا؟
ما الّذي يشغّلها؟

240
00:15:39,580 --> 00:15:42,040
!مصدر طاقة هذه الجزيرة هي النّار

241
00:15:42,040 --> 00:15:45,000
.يمكن تحويل النّار لكلّ أشكال الطّاقة

242
00:15:45,000 --> 00:15:46,920
أهنالك الكثير من الموارد هنا؟

243
00:15:46,920 --> 00:15:50,380
.كنتُ أبحث عمّا يمكنني حرقه

244
00:15:51,590 --> 00:15:56,300
ظننتُ أنّه بإمكاني حتّى صنع شمس
...إن وُجد لهيب لا ينطفئ

245
00:15:56,300 --> 00:15:57,640
!شمس؟

246
00:16:01,200 --> 00:16:03,690
!أنت في طريقنا –
!ابتعد يا فرانكي –

247
00:16:03,690 --> 00:16:05,060
.آسف، آسف

248
00:16:06,770 --> 00:16:07,610
!ماذا؟

249
00:16:07,610 --> 00:16:09,070
!سرتِ عبر جدار

250
00:16:12,290 --> 00:16:13,450
ما الّذي يحدث؟

251
00:16:13,450 --> 00:16:15,480
هذا جدار، صحيح؟

252
00:16:15,880 --> 00:16:16,950
!مرحبًا

253
00:16:17,670 --> 00:16:20,540
!افتحي الباب –
!ليليث-تشان –

254
00:16:20,540 --> 00:16:24,210
!ما الّذي تفعلونه؟ سيروا عبره فحسب
.لا تنخدعوا بما تراه أعينكم

255
00:16:25,680 --> 00:16:27,420
!ليليث! ليليث

256
00:16:27,810 --> 00:16:29,170
ما الخطب يا إديسون؟

257
00:16:31,520 --> 00:16:33,870
!ليليث-تشان

258
00:16:37,680 --> 00:16:40,640
...لا يمكنني سماع أيّ شيء

259
00:16:40,990 --> 00:16:42,850
!عنقه! رأسه

260
00:16:42,850 --> 00:16:47,150
،لا داعي للقلق. إن قُطع عنقه
.فستكون هنالك دماء كثيرة

261
00:16:47,150 --> 00:16:50,110
!شكرًا على تحليلك العقلانيّ
!إنك تخيفينني

262
00:16:50,660 --> 00:16:52,910
!سانجي! هل أنت بخير؟

263
00:16:52,910 --> 00:16:53,700
.نعم

264
00:16:53,700 --> 00:16:55,580
.بالإمكان العبور من خلاله

265
00:16:55,580 --> 00:16:57,490
...لكنّه لا يبدو كذلك

266
00:16:57,490 --> 00:16:59,020
.حسنًا –
ماذا؟ –

267
00:16:59,460 --> 00:17:01,500
.سأذهب أيضًا –
...مـ-مهلاً –

268
00:17:01,500 --> 00:17:02,610
.مع السّلامة

269
00:17:04,300 --> 00:17:05,440
...عبرت من خلاله

270
00:17:05,930 --> 00:17:06,900
لماذا؟

271
00:17:14,350 --> 00:17:16,910
لماذا جعلوا هذا مربكًا جدًّا؟

272
00:17:16,910 --> 00:17:17,830
!ماذا؟

273
00:17:20,010 --> 00:17:24,760
ماذا؟! إنّه مجرّد باب حديديّ
!بعد أن مررنا عبره! كيف يعمل؟

274
00:17:25,570 --> 00:17:27,100
!لقد اختفت ليليث-تشان

275
00:17:27,100 --> 00:17:28,690
!مرحبًا

276
00:17:28,690 --> 00:17:30,470
!واصلوا السّير مباشرة

277
00:17:30,750 --> 00:17:31,690
من قال ذلك؟

278
00:17:31,690 --> 00:17:33,950
!أنا فيغابانك إديسون

279
00:17:33,950 --> 00:17:35,530
فيغابانك آخر؟

280
00:17:35,530 --> 00:17:38,620
.سرّني وصولكم بخير. اتبعوني رجاءً

281
00:17:44,180 --> 00:17:46,120
.واصلوا السّير مباشرة

282
00:17:48,890 --> 00:17:50,450
.استديروا يمينًا

283
00:17:51,840 --> 00:17:52,990
.ثمّ يسارًا

284
00:17:58,640 --> 00:18:00,390
ألم نصل بعد؟

285
00:18:00,390 --> 00:18:02,600
.أتساءل ماذا يوجد أمامنا

286
00:18:03,680 --> 00:18:05,690
!"عليّ البحث عن "كنز مستقبليّ

287
00:18:05,690 --> 00:18:07,440
وما هو "الكنز المستقبليّ"؟

288
00:18:07,440 --> 00:18:10,360
شيء مثل زهور مصنوعة
!من الأحجار الكريمة

289
00:18:10,360 --> 00:18:13,350
لا يمكنني التّمييز إن كان ذلك
...طفوليًّا أو عفى عليه الزّمن

290
00:18:14,120 --> 00:18:15,350
!ركلة المستقبل

291
00:18:24,740 --> 00:18:27,830
ما هذا المكان؟ –
أهي نهاية مسدودة؟ –

292
00:18:27,830 --> 00:18:29,750
...إنّها تبدو مثل أبواب

293
00:18:29,750 --> 00:18:31,460
.سأفتحها لأجلكم

294
00:18:41,110 --> 00:18:42,220
!هناك شخص في الدّاخل

295
00:18:46,070 --> 00:18:48,350
!ماذا؟ –
!مهلاً، لماذا؟ –

296
00:18:48,910 --> 00:18:50,220
!جينبي؟

297
00:18:50,830 --> 00:18:52,650
.لكنّه يبدو يافعًا جدًّا

298
00:18:53,240 --> 00:18:55,050
.وشكله مختلف

299
00:18:59,820 --> 00:19:03,070
!الاحتمال الأوّل. إنّه طفل جينبي

300
00:19:04,300 --> 00:19:07,660
!الاحتمال الثّاني. تمّ تحويل جينبي لطفل

301
00:19:08,130 --> 00:19:09,060
...كلاّ

302
00:19:09,060 --> 00:19:11,620
!الاحتمال الثّالث. شبيه جينبي

303
00:19:12,140 --> 00:19:13,590
.إنّ لديه أجنحة

304
00:19:13,590 --> 00:19:15,450
...ويراودني شعور غريب حياله

305
00:19:16,170 --> 00:19:18,410
!أنت! من تكون؟

306
00:19:21,970 --> 00:19:26,310
!يبدو مثل طفل، لكنّه كبير كِبر جينبي

307
00:19:29,160 --> 00:19:30,210
...مهلاً

308
00:19:32,690 --> 00:19:34,610
!يراودني شعور غريب

309
00:19:36,070 --> 00:19:37,650
!الاحتمال الرّابع

310
00:19:37,650 --> 00:19:39,640
!إنّه باسيفيستا

311
00:19:46,590 --> 00:19:51,160
...بإمكان العباقرة رؤية حتّى مستقبلهم

312
00:19:51,160 --> 00:19:54,240
ما الّذي تتحدّث عنه يا فيغابانك؟

313
00:19:54,640 --> 00:19:56,210
...أنا

314
00:19:58,560 --> 00:20:00,200
...سأموت قريبًا

315
00:20:00,510 --> 00:20:03,760
!كفاك مزاحًا لو سمحت
.هذا ليس مضحكًا

316
00:20:04,650 --> 00:20:07,180
...أردت إبلاغك فحسب

317
00:20:07,690 --> 00:20:08,710
.يا دراغون

318
00:20:15,930 --> 00:20:21,570
إلى أيّ مدى هربنا؟

319
00:20:21,570 --> 00:20:28,700
نعدّ النّدوب دون أن نعرف

320
00:20:28,700 --> 00:20:35,960
وفي بالي دائمًا، خريطة كنز

321
00:20:35,960 --> 00:20:42,470
أبحث باستمرار عن المستقبل

322
00:20:42,470 --> 00:20:56,020
توجد الوعود الحقيقيّة عميقًا في القلب

323
00:20:56,020 --> 00:21:05,490
للجميع أحلام لا يستطيع أحد اللّحاق بها

324
00:21:05,490 --> 00:21:11,080
تمسّكوا بذلك الحلم فقط

325
00:21:11,080 --> 00:21:18,210
إليك يا من تبتسم مثل الشّمس

326
00:21:18,210 --> 00:21:25,220
لنغنّ نفس الأغنية مثل ذلك اليوم

327
00:21:25,220 --> 00:21:32,270
حتّى إن كبر بنا العمر، لا أريد أن أنسى

328
00:21:32,270 --> 00:21:39,700
إلى أن تصلك هذه الأمنية

329
00:21:46,060 --> 00:21:50,740
!أخبريني يا روبين
!أريد تعلّم المزيد أيّها الأحمق" مع تشوبّر"

330
00:21:51,030 --> 00:21:55,000
مرحبًا يا رفاق! أنا طبيب سفينة
!طاقم قبّعة القشّ واسمي تشوبّر

331
00:21:55,000 --> 00:21:56,840
.وأنا عالمة الآثار روبين

332
00:21:56,840 --> 00:21:59,130
لا أطيق الانتظار حتّى أتعلّم
.منك كالعادة يا روبين

333
00:21:59,410 --> 00:22:03,500
.يمكن للمعلومات أن تكون سلاحًا قويًّا
.لنواصل التّعلّم دائمًا

334
00:22:03,870 --> 00:22:07,050
.سنتحدّث اليوم عن بارثولوميو كوما

335
00:22:07,190 --> 00:22:11,210
إنّه قرصان وشيتشيبوكاي سابق
."يُعرف أيضًا بـ"الطّاغية

336
00:22:11,310 --> 00:22:15,850
لقد أكل فاكهة الكفّ الّتي تسمح له
،بصدّ أيّ شيء بوسائد كفّه

337
00:22:15,850 --> 00:22:18,940
.وقد يرسله محلّقًا لمسافات بعيدة

338
00:22:18,940 --> 00:22:22,870
وُلد في التّاسع من فبراير
.ويحبّ العسل والسّلمون

339
00:22:22,870 --> 00:22:28,240
،كان واحدًا من الشّيتشيبوكاي
.لكنّه كان أيضًا من قادة الجيش الثّوريّ

340
00:22:28,320 --> 00:22:30,510
،سبق وقابلنا كوما

341
00:22:30,510 --> 00:22:34,080
.لكنّه أنقذنا من كيزارو وسنتومارو

342
00:22:34,080 --> 00:22:36,370
!لذلك ندين له بالكثير

343
00:22:36,370 --> 00:22:38,880
.أنا من قادة الجيش الثّوريّ

344
00:22:39,170 --> 00:22:42,670
،لديّ صلة معهم
.وأريد مساعدتهم على الخروج من هنا

345
00:22:43,080 --> 00:22:47,840
تمّ تعديل جسد كوما وصار سايبورغ
.شيئًا فشيئًا من طرف البحريّة

346
00:22:47,840 --> 00:22:50,030
،ولكن قبل أن يفقد إرادته الحرّة

347
00:22:50,030 --> 00:22:54,350
.قدّم طلبًا ليُبرمج على حماية ساني

348
00:22:55,640 --> 00:22:57,930
.اكتملت مهمّتي

349
00:23:01,050 --> 00:23:06,030
ثمّ فقد إرادته الحرّة بالكامل
.قبل حرب القمّة

350
00:23:06,460 --> 00:23:10,120
.أتساءل لماذا كان عليه أن يصير سايبورغ

351
00:23:10,650 --> 00:23:13,810
!هذا كلّ شيء لهذا الأسبوع
!نلتقي في المرّة القادمة

352
00:23:13,810 --> 00:23:15,210
!مع السّلامة

353
00:23:19,710 --> 00:23:21,540
!إمكانيّات العلم لا حدود لها

354
00:23:21,910 --> 00:23:24,190
!بدأ البحث سلفًا

355
00:23:24,190 --> 00:23:27,880
إنّ روحهم الفضوليّة لأبعد الحدود
!تطغى على طاقم قبّعة القشّ

356
00:23:28,210 --> 00:23:30,300
.طيبة وشرّ. حكمة وطمع

357
00:23:30,300 --> 00:23:31,970
.فكرة وانفجار

358
00:23:32,030 --> 00:23:36,430
عقول موهوبة تتدفّق من كلّ
!الجهات مجتمعة هنا الآن

359
00:23:36,430 --> 00:23:37,930
:في الحلقة القادمة من وان بيس

360
00:23:37,930 --> 00:23:40,810
"!عقل العبقريّ! فيغابانك السّتّة"

361
00:23:41,060 --> 00:23:43,480
!ملك القراصنة، لكن يكون إلاّ أنا