1
00:00:40,430 --> 00:00:45,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,520 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,190 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:59,030 --> 00:01:01,790
"وأقول "أريد أن أصير أقوى

5
00:01:01,950 --> 00:01:07,290
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,370 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,510 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,090 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,810
هيّا بنا

10
00:01:25,890 --> 00:01:29,110
دون توقّف

11
00:01:29,230 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,490 --> 00:01:39,910
سأواصل النّهوض على قدميّ

13
00:01:40,030 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,540 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,880 --> 00:01:56,010
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,390 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,390 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,810 --> 00:02:14,980
دون توقّف

21
00:02:15,110 --> 00:02:20,160
دون استسلام لمرور الوقت

22
00:02:20,280 --> 00:02:25,830
سأواصل النّهوض على قدميّ

23
00:02:26,000 --> 00:02:31,460
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,590 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:34,520 --> 00:03:36,940
،بعد انفصال لوفي عن بقيّة طاقم قبّعة القشّ

38
00:03:36,940 --> 00:03:39,760
اندفع نحو مقرّ البحريّة لإنقاذ أخيه إيس

39
00:03:39,760 --> 00:03:41,740
!الّذي اقترب موعد إعدامه

40
00:03:42,220 --> 00:03:46,580
أثناء ذلك، يغير قراصنة اللّحية
...البيضاء على مارينفورد

41
00:03:46,580 --> 00:03:50,000
!وتنشب بينهم وبين الحربيّة حرب شاملة

42
00:03:52,330 --> 00:03:54,120
...إيس-كُن

43
00:03:54,120 --> 00:03:56,590
!أورز

44
00:04:01,880 --> 00:04:05,430
!تسلّقوا جسد أورز وتقدّموا

45
00:04:10,570 --> 00:04:11,880
ما هذا؟

46
00:04:15,650 --> 00:04:17,350
!مرحى

47
00:04:32,080 --> 00:04:36,870
!وصول فريق قبّعة القشّ"
"!يتصاعد التّوتّر على ساحة المعركة

48
00:04:39,390 --> 00:04:42,120
!أشعر أنّ قلبي سيتوقّف

49
00:04:42,120 --> 00:04:44,800
!يا شريكي! أبإمكانك فعل شيء ما؟

50
00:04:44,800 --> 00:04:48,010
!هل تظنّ فعلاً أنّ الشّمع سيساعد في وضعنا هذا؟

51
00:04:48,930 --> 00:04:51,970
لماذا لوفي والبقيّة يسقطون من السّماء؟

52
00:04:51,970 --> 00:04:57,400
علينا الرّجوع للوراء بعض الوقت
.لمعرفة ما الّذي حدث لهم

53
00:04:58,440 --> 00:05:03,530
السّفينة الّتي كانوا على متنها علقت
.في زلزال اللّحية البيضاء البحريّ

54
00:05:04,080 --> 00:05:06,280
!إنّها تسرع

55
00:05:09,490 --> 00:05:12,490
!مـ-مهلاً! انظروا هناك

56
00:05:15,750 --> 00:05:18,130
!ما-ما هذا؟

57
00:05:19,550 --> 00:05:22,220
!إنّها تسونامي

58
00:05:22,920 --> 00:05:24,010
!إنّها ضخمة

59
00:05:24,010 --> 00:05:25,220
!سنعلق فيها

60
00:05:27,930 --> 00:05:32,250
تراجع البحر فجأة وها هي ذي
.تسونامي ضخمة بعد ذلك

61
00:05:32,250 --> 00:05:33,400
...لا بدّ أنّه

62
00:05:33,400 --> 00:05:36,100
...يا جينبي! علينا فعل شيء ما وإلاّ

63
00:05:38,480 --> 00:05:42,900
!لا أريد أن أُهزم على يد تسونامي هنا

64
00:05:42,900 --> 00:05:45,940
!عليّ... عليّ إنقاذ إيس

65
00:05:46,990 --> 00:05:48,950
!أنزلوا الأشرعة

66
00:05:48,950 --> 00:05:51,410
!لوفي-كُن، لنركب التسونامي

67
00:05:51,410 --> 00:05:54,080
!ألا يجب علينا الهرب؟

68
00:05:54,080 --> 00:05:57,250
!ما الّذي تقوله أيّها المغفّل؟

69
00:05:57,250 --> 00:05:59,000
!استدر في الحال

70
00:05:59,000 --> 00:06:00,710
!توقّف يا هذا

71
00:06:00,710 --> 00:06:02,210
!علينا أن نسرع

72
00:06:02,210 --> 00:06:03,250
!اقفزوا للبحر

73
00:06:03,250 --> 00:06:04,920
!النّجدة! النّجدة

74
00:06:05,420 --> 00:06:07,840
منذ متى وأنتم قراصنة؟

75
00:06:09,510 --> 00:06:11,800
هل أنتم مجرّد حفنة هواة؟

76
00:06:12,970 --> 00:06:17,610
إن استدرنا الآن، فسنخاطر أن تضربنا الموجة
.من الجانب وستغرق السّفينة

77
00:06:18,100 --> 00:06:20,730
.لا خيار آخر أمامنا

78
00:06:20,730 --> 00:06:22,310
!هذا صحيح

79
00:06:22,310 --> 00:06:26,190
!تمسّكوا جيّدًا لكي لا تنجرفوا بسبب الموجة العاتية

80
00:06:26,190 --> 00:06:27,610
!سُحقًا

81
00:06:27,610 --> 00:06:29,030
!بسرعة

82
00:06:29,030 --> 00:06:31,530
!تمسّك بشيء ما فحسب

83
00:06:31,530 --> 00:06:32,870
.وجهي كبير للغاية

84
00:07:27,170 --> 00:07:28,430
ما الّذي حدث؟

85
00:07:28,430 --> 00:07:30,300
!توقّفت الموجة عن التّحرّك

86
00:07:30,300 --> 00:07:32,430
!ماذا حدث؟

87
00:07:33,180 --> 00:07:35,000
!ما هذا؟

88
00:07:35,000 --> 00:07:39,890
!تجمّدت السّفينة وحوصرنا بالكامل

89
00:07:40,980 --> 00:07:43,350
...لا بدّ أنّ هذا من صنيع

90
00:07:45,920 --> 00:07:49,990
.انزلوا للأسفل. بالإمكان رؤية ما يحدث

91
00:07:51,780 --> 00:07:52,910
...الوالد

92
00:07:52,910 --> 00:07:54,910
.بدأت الحرب بالفعل

93
00:07:55,650 --> 00:07:59,830
.لا بدّ أنّ الوالد قد أطلق تلك التسونامي كإعلان حرب

94
00:07:59,830 --> 00:08:04,210
.وبعدها قام الأميرال أوكيجي بتجميدها

95
00:08:04,210 --> 00:08:05,880
!اسمعوا جميعًا

96
00:08:06,340 --> 00:08:08,800
!لديّ فكرة لتخطّي هذا الوضع

97
00:08:08,800 --> 00:08:14,430
علينا الإسراع! أمامنا أقلّ
!من 3 ساعات قبل إعدام إيس

98
00:08:14,430 --> 00:08:16,010
نعم. وبعد؟

99
00:08:16,010 --> 00:08:17,470
!ماذا؟

100
00:08:18,020 --> 00:08:21,390
!تريد أن تجعل السّفينة تنزلق من الموجة المجمّدة؟

101
00:08:21,800 --> 00:08:26,230
إنّها الطّريقة الوحيدة! علينا تحرير
!السّفينة من الجليد أوّلاً

102
00:08:30,360 --> 00:08:32,360
!هذا صحيح أيّها الغبيّ

103
00:08:32,360 --> 00:08:35,910
!بإمكاننا ذلك إن عملنا معًا

104
00:08:35,910 --> 00:08:38,990
.يجعلني ذلك أظنّ أنّنا نستطيع

105
00:08:39,400 --> 00:08:44,290
،أجل! لدينا القبطان باغي
!ملك القراصنة التّالي في صفّنا

106
00:08:44,290 --> 00:08:48,750
،عندما يقول القبطان أنّه يستطيع
!فسيقوم بذلك بكلّ تأكيد

107
00:08:49,290 --> 00:08:51,510
...رنين، رنين، رنين

108
00:08:52,040 --> 00:08:56,340
!انتباه لكلّ السّفن والجنود
!"الهدف "تي أو تي تي زد

109
00:08:56,340 --> 00:08:59,470
.غيّروا الخطّ وانتقلوا للعمليّة 3

110
00:08:59,890 --> 00:09:02,140
.إنّها رسالة عمليّات البحريّة

111
00:09:02,140 --> 00:09:03,520
!ابدؤوا الاستعدادات

112
00:09:03,520 --> 00:09:06,440
تي أو تي"... ماذا؟"

113
00:09:06,440 --> 00:09:08,770
.لا أدري. لا بدّ أنّها شيفرة من نوع ما

114
00:09:09,190 --> 00:09:12,100
...عندما تجهزون جميعًا، سنسرّع جدولنا

115
00:09:12,100 --> 00:09:15,280
.وسنعدم إيس في الحال. هذا كلّ شيء

116
00:09:18,750 --> 00:09:19,950
...لوفي-كُن

117
00:09:19,950 --> 00:09:21,120
!لننطلق

118
00:09:21,120 --> 00:09:24,790
!لا يمكن الانتظار أكثر! لا وقت لدينا للجدال

119
00:09:24,790 --> 00:09:28,540
!لنبدأ العمل بخطّة الفتى قبّعة القشّ جميعًا

120
00:09:31,210 --> 00:09:33,010
!هيّا بنا

121
00:09:39,090 --> 00:09:40,140
!مـ-مهلاً

122
00:09:41,510 --> 00:09:43,890
!كلاّ! ذلك ليس الجانب الصّحيح

123
00:09:47,820 --> 00:09:51,720
!وهكذا سقط لوفي والبقيّة من السّماء

124
00:10:25,240 --> 00:10:29,060
ما الّذي حدث للتّوّ؟! هل سقطت
!سفينة بحريّة من السّماء؟

125
00:10:30,650 --> 00:10:34,020
.إنّها مياه، لقد نجونا. سقطنا في الماء

126
00:10:34,020 --> 00:10:37,190
!ظننتُ أنّني سأموت بسقوطي على الجليد

127
00:10:37,600 --> 00:10:40,160
لماذا البحر ليس متجمّدًا هنا؟

128
00:10:40,160 --> 00:10:45,080
انظروا! سقطت السّفينة في المنطقة
!الّتي أزال منها جوزو الجليد

129
00:10:46,620 --> 00:10:48,660
أهو هجوم مفاجئ من البحريّة؟

130
00:10:48,660 --> 00:10:51,080
.كلاّ، لا يبدون كالبحريّة

131
00:10:51,080 --> 00:10:53,340
!اصعدوا! اصعدوا للأعلى

132
00:10:53,340 --> 00:10:57,010
.هذا لا شيء مقارنة بالتّعذيب بالماء في الجحيم

133
00:11:07,320 --> 00:11:10,270
.عجز آكلي فاكهة الشّيطان عن السّباحة مزعج للغاية

134
00:11:25,700 --> 00:11:27,740
أين أنا؟

135
00:11:29,520 --> 00:11:33,670
.صحيح، سقطت من هناك

136
00:11:38,960 --> 00:11:40,390
!إيس

137
00:12:00,390 --> 00:12:02,650
!أين أنت؟ أين أنت يا إيس؟

138
00:12:02,650 --> 00:12:03,990
...إيس

139
00:12:17,210 --> 00:12:19,000
!اصعدوا السّفينة

140
00:12:19,000 --> 00:12:21,130
!ليس على هذا الجانب

141
00:12:29,960 --> 00:12:31,770
!أين أنت يا إيس؟

142
00:12:36,900 --> 00:12:40,150
!انتظرني يا إيس! سأوافيك قريبًا

143
00:12:49,820 --> 00:12:52,660
!لا تقفوا في طريقي

144
00:13:04,480 --> 00:13:06,130
!إيس

145
00:14:04,530 --> 00:14:05,780
...إيس

146
00:14:28,390 --> 00:14:38,230
!إيس

147
00:14:40,110 --> 00:14:43,520
!لوفي

148
00:14:45,030 --> 00:14:50,450
!إيس

149
00:14:54,360 --> 00:14:56,240
!أستطيع رؤيتك أخيرًا

150
00:15:11,830 --> 00:15:13,470
!لوفي

151
00:15:14,170 --> 00:15:17,060
...إيس! تماسك! فأنا

152
00:15:17,900 --> 00:15:19,980
!...مـ-مهلاً، أيعقل أنّه

153
00:15:20,310 --> 00:15:21,690
!كروكودايل

154
00:15:21,690 --> 00:15:24,940
!إنّه ليس وحده! من معه أيضًا؟

155
00:15:25,570 --> 00:15:29,240
!كلّ القوّات هنا من كِلا الجانبين
!ثمّة الكثير من الأسماء الكبيرة

156
00:15:30,400 --> 00:15:32,680
!على العالم أن يستعدّ لهذا

157
00:15:34,370 --> 00:15:36,830
!إيس، أتينا لإنقاذك

158
00:15:37,160 --> 00:15:40,000
!نحن هنا لأجلك

159
00:15:41,500 --> 00:15:44,790
!غارب! إنّها عائلتك ثانية

160
00:15:45,130 --> 00:15:46,710
!لوفي

161
00:15:46,710 --> 00:15:49,420
!انظروا! ليس قبّعة القشّ فحسب

162
00:15:49,420 --> 00:15:53,100
!جينبي وإيفانكوف من الجيش الثّوريّ أيضًا

163
00:15:53,100 --> 00:15:57,150
وخلفهم العديد من القراصنة الّذين
!صنعوا اسمًا لأنفسهم في الماضي

164
00:15:57,150 --> 00:15:59,720
!لا بدّ أنّهم الهاربون من إمبل داون

165
00:16:00,170 --> 00:16:03,940
.يتسبّب في المشاكل دائمًا... قبّعة القشّ ذاك

166
00:16:03,940 --> 00:16:07,520
!قبّعة القشّ

167
00:16:07,520 --> 00:16:10,320
ما الّذي أتى به إلى هنا؟

168
00:16:10,320 --> 00:16:12,700
.إنّه ليس مع طاقمه

169
00:16:13,200 --> 00:16:16,620
!لوفي! أنا سعيدة لأنّك على قيد الحياة

170
00:16:16,620 --> 00:16:18,620
!انظر يا هيلميبّو-سان

171
00:16:18,620 --> 00:16:21,960
...ماذا؟! لا يوجد ما قد يفاجئني أكثر

172
00:16:21,960 --> 00:16:23,460
!قبّعة القشّ

173
00:16:23,460 --> 00:16:28,210
سمعتُ أنّهم أمسكوا به
!في إمبل داون! إنّه مذهل فعلاً

174
00:16:28,640 --> 00:16:31,170
!أحضر معه بعض الوجوه المهمّة

175
00:16:33,470 --> 00:16:37,600
.لم أتوقّع رؤيته ثانية بهذه السّرعة

176
00:16:37,930 --> 00:16:41,060
.إنّه الأخ الّذي كان إيس يتحدّث عنه

177
00:16:41,060 --> 00:16:44,140
!ثمّة شيتشيبوكاي سابق وحاليّ معًا

178
00:16:45,440 --> 00:16:50,650
،ويفترض أنّ ذاك هو قبّعة القشّ
!النّاشئ مفتعل المشاكل

179
00:16:51,050 --> 00:16:52,980
!سموكر-سان، انظر

180
00:16:53,450 --> 00:16:54,780
!مت

181
00:16:57,510 --> 00:17:01,830
قبّعة القشّ وكروكودايل... لماذا هما معًا؟

182
00:17:02,580 --> 00:17:04,790
.هذا هو إذًا

183
00:17:05,120 --> 00:17:11,090
.حفيد البطل غارب وابن الثّوريّ دراغون

184
00:17:13,210 --> 00:17:16,630
!سأتولّى أمره للأبد

185
00:17:21,310 --> 00:17:26,900
من بين كلّ الاحتمالات، قرّرت العمل
...مع قبّعة القشّ لوفي

186
00:17:26,900 --> 00:17:29,520
!أهذا هو جوابك يا جينبي؟

187
00:17:29,520 --> 00:17:32,780
!هذا صحيح! أنا أتخلّى عن لقبي كشيتشيبوكاي

188
00:17:33,280 --> 00:17:37,200
.من الغريب أنّ هؤلاء تحالفوا معًا

189
00:17:38,320 --> 00:17:41,480
سجناء وقائد في الجيش الثّوريّ

190
00:17:41,480 --> 00:17:44,660
...وبعض الأشخاص غريبو المنظر

191
00:17:45,910 --> 00:17:47,620
.وكروكودايل

192
00:17:47,620 --> 00:17:51,800
.لا أظنّ أنّ لهم هدفًا مشتركًا

193
00:17:51,800 --> 00:17:54,340
.في هذه المعركة على الأقلّ

194
00:18:33,000 --> 00:18:34,460
أين الفتى كروكو؟

195
00:18:34,460 --> 00:18:38,630
...ماذا؟ أعتقد أنّ جبُن و

196
00:18:38,630 --> 00:18:40,370
!ها هو هناك

197
00:18:43,890 --> 00:18:46,090
!لقد سبقني

198
00:18:47,520 --> 00:18:50,060
!يستهدف كروكودايل اللّحية البيضاء

199
00:18:50,060 --> 00:18:50,690
!والدي

200
00:18:51,010 --> 00:18:53,900
.لم أرك منذ مدّة أيّها اللّحية البيضاء

201
00:18:53,900 --> 00:18:56,320
.أنت لا تتعلّم أبدًا

202
00:19:19,260 --> 00:19:24,220
.إنّه يعرف تمام المعرفة كيف يقاتل ضدّي

203
00:19:24,350 --> 00:19:28,850
.لا يمكنك التّحوّل لرمال بمجرّد أن تتبلّل

204
00:19:34,170 --> 00:19:39,900
.بما أنّنا وصلنا إلى هنا، فقد انتهى اتّفاقنا

205
00:19:39,900 --> 00:19:42,450
!لماذا تريد حماية اللّحية البيضاء؟

206
00:19:42,450 --> 00:19:45,320
.كما توقّعت، هذا العجوز هو اللّحية البيضاء

207
00:19:45,320 --> 00:19:47,160
!دعه وشأنه إذًا

208
00:19:47,160 --> 00:19:49,830
!يحبّ إيس هذا العجوز

209
00:19:49,830 --> 00:19:53,170
.أخو إيس مقاتل ممتاز

210
00:19:54,750 --> 00:19:56,590
!لا تدعوه يقترب من والدنا

211
00:20:12,190 --> 00:20:17,420
نزل خبر فقدان شخص من مقامك
لذراعه في الأزرق الشّرقيّ

212
00:20:17,420 --> 00:20:19,570
.كالصّاعقة على الجميع

213
00:20:20,350 --> 00:20:25,030
أيّ عدوّ تمكّن من سلبك ذراعك؟

214
00:20:28,810 --> 00:20:32,870
.راهنتُ بها... على عصرٍ جديد

215
00:20:32,870 --> 00:20:36,670
...أيّها الولد، قبّعة القشّ الّتي ترتديها

216
00:20:36,670 --> 00:20:40,340
.تبدو مثل الّتي كان يرتديه أحمر الشّعر في الماضي

217
00:20:41,010 --> 00:20:43,760
أتعرف شانكس أيّها العجوز؟

218
00:20:43,760 --> 00:20:46,840
.تركها شانكس في عهدتي

219
00:20:47,470 --> 00:20:51,290
!انظر يا والدي! هذا هو أخي الصّغير

220
00:20:54,940 --> 00:20:57,770
أتيتَ لتنقذ أخاك الكبير؟

221
00:20:57,770 --> 00:20:58,990
.صحيح

222
00:20:58,990 --> 00:21:02,320
!أتعرف مع من تعبث؟

223
00:21:07,530 --> 00:21:11,550
!سينتهي المطاف بشقيّ مثلك جثّة هادمة

224
00:21:31,650 --> 00:21:35,350
!اخرس! ذلك ليس شيئًا تقرّره أنت

225
00:21:39,520 --> 00:21:41,480
!أعرف ما هدفك

226
00:21:41,480 --> 00:21:44,490
!تريد أن تصير ملك القراصنة، صحيح؟

227
00:21:47,610 --> 00:21:51,740
!ملك القراصنة، لن يكون إلاّ أنا

228
00:22:30,200 --> 00:22:32,450
!يا لك من وقح

229
00:22:33,640 --> 00:22:37,370
لن أسامحك إن تسبّبت لي بالمشاكل
!أيّها الشّقيّ المدلّل

230
00:22:37,720 --> 00:22:39,920
!سأقوم بما يحلو لي

231
00:22:42,740 --> 00:22:44,550
!سأنقذ إيس

232
00:22:44,550 --> 00:22:46,420
...إ-إنّه ينافس

233
00:22:46,420 --> 00:22:47,710
!اللّحية البيضاء

234
00:22:47,710 --> 00:22:49,550
!مستحيل

235
00:22:57,400 --> 00:23:02,860
،بإمكاننا معاقبتهم جميعًا بالموت
صحيح يا سنغوكو-سان؟

236
00:23:03,520 --> 00:23:04,570
.بالطّبع

237
00:23:05,310 --> 00:23:08,280
...لوفي... والدي

238
00:23:08,280 --> 00:23:10,700
!انتظر يا إيس

239
00:23:11,530 --> 00:23:13,160
...سآتي إليك

240
00:23:14,470 --> 00:23:16,950
!سآتي إليك قريبًا

241
00:23:25,480 --> 00:23:30,130
في مقرّ البحريّة، يندفع لوفي مهاجمًا
.ضدّ حشد كبير من القوّات

242
00:23:30,130 --> 00:23:33,140
،وبينما يتوافد رجال بحريّة مهاجمين لوفي

243
00:23:33,140 --> 00:23:35,600
.يصرخ إيس طالبًا منه الرّحيل

244
00:23:35,970 --> 00:23:39,730
ماذا ستكون إجابة لوفي لرغبة أخيه؟

245
00:23:39,730 --> 00:23:41,100
:في الحلقة القادمة من وان بيس

246
00:23:41,100 --> 00:23:44,650
!وإن عنى ذلك الموت"
"!بداية معركة لوفي ضدّ البحريّة

247
00:23:44,650 --> 00:23:47,230
!ملك القراصنة، لن يكون إلاّ أنا

248
00:23:50,070 --> 00:23:55,080
!!نلقاكم في الحلقة القادمة