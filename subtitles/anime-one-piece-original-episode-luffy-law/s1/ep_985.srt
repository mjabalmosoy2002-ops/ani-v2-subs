1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:12,370 --> 00:02:17,570
تغزو مجموعة كينييمون أونيغاشيما
.للإطاحة بكايدو والتّخلّص من أوروتشي

29
00:02:17,570 --> 00:02:23,660
ويستقلّ ساموراي الأكازايا غوّاصة لو
.في اتّجاه المدخل الخلفيّ للجزيرة

30
00:02:23,660 --> 00:02:26,430
!حسنًا! علينا التّحرّك نحن أيضًا

31
00:02:26,430 --> 00:02:27,790
!أجل

32
00:02:29,810 --> 00:02:32,710
!أنا من سيطيح برأس كايدو

33
00:02:33,770 --> 00:02:34,880
!وأنا

34
00:02:37,900 --> 00:02:40,590
!حمقى

35
00:02:40,590 --> 00:02:41,260
!حسنًا

36
00:02:41,260 --> 00:02:43,680
!سأذهب لإيقافهم

37
00:02:43,680 --> 00:02:45,220
!مهلاً يا لوفي

38
00:02:46,910 --> 00:02:49,850
.سيزيد الطّين بلّة فحسب

39
00:02:50,140 --> 00:02:51,600
!سأذهب لإيقافه

40
00:02:51,600 --> 00:02:52,520
...لكن

41
00:02:55,120 --> 00:02:56,280
!يا لوفي

42
00:02:56,280 --> 00:02:57,930
!انتظر

43
00:03:08,680 --> 00:03:11,580
!مهلاً

44
00:03:11,580 --> 00:03:14,960
!أيّها المسنّن

45
00:03:34,290 --> 00:03:36,210
!أيّها المسنّن

46
00:03:36,210 --> 00:03:39,360
!أين أنت؟

47
00:03:42,510 --> 00:03:47,030
"!أوتاما في البال! هجوم لوفي الغاضب"

48
00:03:58,400 --> 00:04:00,380
إلى أين ذهب؟

49
00:04:03,110 --> 00:04:05,470
...لوفي

50
00:04:08,450 --> 00:04:10,180
...حسنًا

51
00:04:10,530 --> 00:04:14,090
.أظنّني سأجده بمجرّد وصولي لكايدو

52
00:04:29,050 --> 00:04:33,010
يا أخي! هل تشرب؟

53
00:04:33,010 --> 00:04:35,670
!إلى أين أنت ذاهب؟

54
00:04:35,670 --> 00:04:38,600
أخبرني، أين كايدو؟

55
00:04:38,600 --> 00:04:43,300
!لماذا تسألني؟ لا تقل لي أنّك ستذهب للشّرب معه

56
00:04:43,300 --> 00:04:48,390
،كايدو-سان خلف قاعة العروض هناك في الأعلى

57
00:04:48,390 --> 00:04:51,180
...لكنّه لا يشرب معنا أبدًا

58
00:04:51,910 --> 00:04:53,670
!مهلاً

59
00:05:04,630 --> 00:05:06,120
.لقد أحضرتهم

60
00:05:06,120 --> 00:05:07,870
!ادخلوا

61
00:05:26,400 --> 00:05:30,400
!كايدو-ساما-أرينسو! لم نتقابل منذ مدّة-أرينسو

62
00:05:30,400 --> 00:05:32,720
أيّ نوع من اللّغات هذه؟

63
00:05:47,420 --> 00:05:49,370
هل شربتم؟

64
00:05:51,300 --> 00:05:53,620
.لا طائل من الشّرب مع الضّعفاء

65
00:05:54,120 --> 00:05:57,210
!أريد الشّرب معك يا كايدو-سان

66
00:05:57,210 --> 00:06:00,290
.حسنًا، لا بأس

67
00:06:00,290 --> 00:06:02,960
.لنقصد القاعة لاحقًا

68
00:06:02,960 --> 00:06:05,170
.لا مراسم وقوف اليوم

69
00:06:05,460 --> 00:06:06,730
لاحقًا؟

70
00:06:06,730 --> 00:06:08,880
لماذا لا يمكننا الذّهاب الآن؟

71
00:06:09,240 --> 00:06:14,140
...كنتُ سأعرّفكم إلى لينلين أوّلاً

72
00:06:14,360 --> 00:06:15,560
لينلين؟

73
00:06:16,200 --> 00:06:18,020
ستعرّفنا إلى بيغ مام؟

74
00:06:18,390 --> 00:06:19,730
...نعم

75
00:06:25,880 --> 00:06:28,780
...أحمر وملّمع الشّفاه هذين

76
00:06:30,170 --> 00:06:32,700
.لونهما جيّد

77
00:06:32,700 --> 00:06:34,700
.أعجباني

78
00:06:35,080 --> 00:06:37,040
!شكرًا على الانتظار

79
00:06:37,640 --> 00:06:39,750
.تفضّلي حساء الفاصولياء الحمراء

80
00:06:39,750 --> 00:06:42,710
!حساء الفاصولياء الحمراء

81
00:06:42,710 --> 00:06:45,550
!كنت أنتظره

82
00:06:45,960 --> 00:06:50,010
.سمعتُ أنّها تغيّر ملابسها الآن. لنلتقِ بها لاحقًا

83
00:06:50,340 --> 00:06:51,260
لاحقًا؟

84
00:06:51,680 --> 00:06:58,230
،على أيّ حال، وقعت حادثة صغيرة
.لذلك كنت في انتظاركم

85
00:06:58,580 --> 00:07:00,100
!أتسمّي هذا تخطيطًا؟

86
00:07:00,100 --> 00:07:01,350
!توقّفي

87
00:07:01,830 --> 00:07:07,750
حسنًا، هذا صحيح، لستُ أنا
.من استدعاكم في المقام الأوّل

88
00:07:07,750 --> 00:07:09,170
!ماذا؟

89
00:07:09,170 --> 00:07:12,070
من استدعانا إذًا؟

90
00:07:14,680 --> 00:07:15,870
.أنا

91
00:07:17,680 --> 00:07:21,170
.أنا من استدعاهم يا كايدو-سان

92
00:07:21,170 --> 00:07:24,980
!كينغ... أنت من كان بحاجتنا إذًا؟

93
00:07:24,980 --> 00:07:28,090
!كيف خدعتنا؟

94
00:07:28,090 --> 00:07:32,220
كنتُ أعلم أنّ بعضكم ما كان ليحضر
.إن عرف أنّ الدّعوة منّي

95
00:07:32,220 --> 00:07:34,430
!هوز-هو! ساساكي

96
00:07:37,910 --> 00:07:39,350
.هذا صحيح

97
00:07:39,740 --> 00:07:42,480
أنتما ممّن كنتما في السّابق قبطانين
...لطاقمَيْ قراصنة تابعان لكما

98
00:07:42,850 --> 00:07:46,360
.تسعيان لأخذ أماكننا ككبار النّجوم

99
00:07:46,570 --> 00:07:49,590
.بلغنا هذه المناصب بفضي مجهوداتنا

100
00:07:49,590 --> 00:07:51,740
!بالطّبع نطمح لذلك

101
00:07:52,090 --> 00:07:53,610
.الزم حدودك

102
00:08:02,370 --> 00:08:04,500
!مهلاً، توقّفوا

103
00:08:06,390 --> 00:08:11,340
لماذا القتال في يوم وليمة مبهج كهذا؟

104
00:08:11,340 --> 00:08:14,430
كينغ! لماذا استدعيتهم؟

105
00:08:14,860 --> 00:08:20,220
.لأنّني سمعتُ بحادثتك الصّغيرة قبل الجميع

106
00:08:20,220 --> 00:08:21,560
ألست بحاجتهم؟

107
00:08:22,910 --> 00:08:24,810
...أحتاجهم بالفعل

108
00:08:25,750 --> 00:08:27,520
!باو فوان

109
00:08:27,920 --> 00:08:29,440
!نعم

110
00:08:52,560 --> 00:08:54,970
ما جدولي اليوم؟

111
00:08:58,780 --> 00:09:06,190
لاحقًا على خشبة المهرجان الذّهبيّ حيث
...يقدّم كوين-ساما عرضه الآن

112
00:09:06,910 --> 00:09:13,150
...سيقوم النّجوم الكبار الثّلاثة وفوكوروكوجو-ساما

113
00:09:14,630 --> 00:09:19,160
...وبعد ذلك، سيقدّم أوروتشي-ساما وكايدو-ساما

114
00:09:19,160 --> 00:09:20,530
!خطابًا

115
00:09:20,970 --> 00:09:27,620
...ثمّ عندما تصل سفينة قراصنة بيغ مام

116
00:09:28,230 --> 00:09:35,050
سيقدّم كلّ من كايدو-ساما
...وبيغ مام-ساما إعلانًا عن أقوى

117
00:09:35,050 --> 00:09:38,510
!تحالف قراصنة في العالم

118
00:09:39,320 --> 00:09:42,970
...وبعد ذلك، سيقدّم كايدو-ساما

119
00:09:42,970 --> 00:09:48,270
!إعلانًا مهمًّا

120
00:09:48,700 --> 00:09:49,980
.هذا كلّ شيء

121
00:09:50,310 --> 00:09:54,570
.إعلان مهمّ؟! ليس من عادتك إخفاء الأمور عنّا

122
00:09:54,860 --> 00:09:56,500
!هذا مزعج للغاية-أرينسو

123
00:09:56,500 --> 00:10:02,030
،نعم، أعلم. لكن إن شاركتكم به الآن
.فسيسبّب الارتباك

124
00:10:02,350 --> 00:10:06,540
.لذلك، إليكم ما أريد منكم فعله

125
00:10:06,890 --> 00:10:10,000
،اختفى ابني الغبيّ ياماتو اليوم

126
00:10:10,000 --> 00:10:13,000
!وأريد منكم إحضاره لي

127
00:10:14,420 --> 00:10:17,630
.ماذا...؟ يا لها من مهمّة

128
00:10:17,630 --> 00:10:22,780
هذا يعني أنّ إعلانك له علاقة
بالسّيّد الصّغير ياماتو؟

129
00:10:22,780 --> 00:10:24,740
.هذا صحيح

130
00:10:24,740 --> 00:10:26,030
.فهمت

131
00:10:26,030 --> 00:10:28,740
!كم هذا مزعج! هذه أمور عائليّة فحسب

132
00:10:28,740 --> 00:10:29,830
!توقّفي

133
00:10:29,830 --> 00:10:33,250
حسنًا... ماذا بعد أن نعيده بأمان؟

134
00:10:33,250 --> 00:10:37,280
.سأمنحكم الحقّ لتتحدّوا أحد كبار النّجوم من اختياركم

135
00:10:38,300 --> 00:10:39,740
ما قولكم؟

136
00:10:39,740 --> 00:10:42,880
!فعلاً؟ أنا موافق

137
00:10:42,880 --> 00:10:45,450
!وأنا أيضًا

138
00:10:46,050 --> 00:10:48,160
لا تمانعان، صحيح؟

139
00:10:48,160 --> 00:10:50,870
!لا، على الإطلاق

140
00:11:09,120 --> 00:11:12,060
!مهلاً! إنّ الحساء يغطّيك بالكامل

141
00:11:12,060 --> 00:11:15,920
!لا يأكل المرء حساء الفاصولياء الحمراء
!بل يغطّي نفسه به

142
00:11:17,290 --> 00:11:21,200
!أحضروا الحساء! سنسكبه على بعضنا

143
00:11:21,200 --> 00:11:23,570
!اسكبوه بالكامل

144
00:11:29,810 --> 00:11:31,210
...تاما

145
00:11:43,650 --> 00:11:46,720
...الحساء يغطّيني بالكامل. رائحته مقرفة

146
00:11:46,720 --> 00:11:48,820
!المزيد! المزيد

147
00:11:48,820 --> 00:11:51,560
!واصلوا إحضاره! خذ

148
00:12:01,240 --> 00:12:02,990
.دعونا نمرّ

149
00:12:04,050 --> 00:12:07,660
.نريد مقابلة كايدو. ابتعدوا عن طريقنا

150
00:12:07,660 --> 00:12:12,120
واثق أنّ كايدو-سان سيظهر
.في النّهاية على المسرح هناك

151
00:12:12,120 --> 00:12:13,330
.انتظرا حتّى ذلك الحين

152
00:12:17,810 --> 00:12:21,210
.لنشرب معًا ونشاهده عندما يحضر

153
00:12:21,670 --> 00:12:22,920
.لنشرب

154
00:12:33,950 --> 00:12:35,310
!ما الّذي...؟

155
00:12:36,500 --> 00:12:37,480
!أنت

156
00:12:41,630 --> 00:12:43,900
.أغلق فمك

157
00:12:44,150 --> 00:12:45,660
!اسمعوا

158
00:12:45,660 --> 00:12:50,540
...اهتمّ بي كايدو-سان جيّدًا

159
00:12:50,540 --> 00:12:56,250
.لذلك عليّ مقابلته شخصيًّا لأشكره كما يجب

160
00:12:56,250 --> 00:12:58,900
أتعرفون ما يعنيه ذلك؟

161
00:13:00,270 --> 00:13:01,910
.حسنًا

162
00:13:03,520 --> 00:13:07,260
...ذ-ذلك جيّد جدًّا

163
00:13:07,260 --> 00:13:09,350
...نـ-نعم

164
00:13:09,350 --> 00:13:12,890
.أبلغوا سلامي لكايدو-سان

165
00:13:24,670 --> 00:13:29,470
هذا التّنكّر جيّد. بإمكاننا تفادي
.قتالات لا ضرورة منها

166
00:13:29,470 --> 00:13:34,580
.بإمكاننا الوصول إلى كايدو سالمين بفضله

167
00:13:34,930 --> 00:13:38,630
...بإمكاننا دقّ عنقه أخيرًا

168
00:13:38,630 --> 00:13:40,490
...نعم

169
00:13:44,230 --> 00:13:46,300
!مرحى

170
00:13:51,990 --> 00:13:57,140
...أعتقد أنّني مررت من هنا سابقًا

171
00:13:58,700 --> 00:14:01,790
ماذا؟ عدت ثانية؟

172
00:14:01,790 --> 00:14:04,420
!هل غيّرتما أماكنكما؟

173
00:14:04,420 --> 00:14:08,110
.ماذا؟ كنّا هنا طوال الوقت

174
00:14:08,110 --> 00:14:10,370
.مستحيل

175
00:14:10,370 --> 00:14:15,260
.مشيتُ كثيرًا، لذلك لا بدّ أنّني قريب من كايدو

176
00:14:15,260 --> 00:14:17,210
أثملت وأضعتَ طريقك؟

177
00:14:17,210 --> 00:14:20,360
.أنت رجل بالغ تُحرج نفسك

178
00:14:23,590 --> 00:14:26,520
.حسنًا، لا تغضب واشرب

179
00:14:26,520 --> 00:14:29,180
.بإمكانك الأكل بقدر ما تشاء
!الطّعام لذيذ

180
00:14:34,570 --> 00:14:38,890
،الطّعام والسّاكي هنا جيّدان بالفعل

181
00:14:38,890 --> 00:14:41,190
...أما وجوهكم

182
00:14:41,810 --> 00:14:43,940
!فلا تسرّ النّاظر أبدًا

183
00:14:43,940 --> 00:14:45,540
!ماذا قلت؟

184
00:14:45,540 --> 00:14:48,740
!حسنًا! أتريد القتال؟

185
00:14:50,510 --> 00:14:52,410
!إلمَ تنظر؟

186
00:14:53,680 --> 00:14:55,990
!قل شيئًا

187
00:15:08,760 --> 00:15:10,510
!ماذا تفعل؟

188
00:15:10,510 --> 00:15:12,010
!أفعلتَ هذا؟

189
00:15:15,570 --> 00:15:18,430
!هل تعبث معنا؟

190
00:15:27,580 --> 00:15:28,990
...أنا أتضوّر جوعًا

191
00:15:28,990 --> 00:15:32,170
!أمّي! أنا جائع

192
00:15:32,170 --> 00:15:33,910
.اصبر قليلاً

193
00:15:43,770 --> 00:15:45,750
!لا تغتر بنفسك

194
00:15:49,210 --> 00:15:54,140
!أنا محبط نوعًا ما. سأقاتلكم

195
00:15:57,510 --> 00:16:01,200
!ماذا؟! إنّ الحساء يغطّي اللّحم أيضًا

196
00:16:01,200 --> 00:16:05,460
!لدينا الكثير من الطّعام. أرمه فحسب

197
00:16:05,460 --> 00:16:09,360
!وحدهم سكّان بلدة أوكوبوري من كانوا ليأكلوه

198
00:16:09,360 --> 00:16:11,640
!معك حقّ

199
00:16:16,340 --> 00:16:18,540
!لماذا؟

200
00:16:18,540 --> 00:16:24,960
لماذا هنالك الكثير من الطّعام
!من أجل أغبياء أمثالكم؟

201
00:16:28,100 --> 00:16:29,750
!ألديك مشكلة في ذلك؟

202
00:17:13,610 --> 00:17:15,360
!ما الّذي يفعله؟

203
00:17:15,360 --> 00:17:18,340
!هل حساء الفاصولياء الحمراء لذيذ لذلك الحدّ؟

204
00:17:24,330 --> 00:17:29,270
.نعم، إنّه لذيذ. لا يوجد ما هو ألذّ منه

205
00:17:54,440 --> 00:17:56,630
لماذا لا تأكل المزيد إذًا؟

206
00:17:56,630 --> 00:17:58,690
...تعال ونل ما تستحقّ

207
00:17:58,690 --> 00:18:00,510
!بدءًا برأسك

208
00:18:16,920 --> 00:18:20,320
!إنّه لذيذ

209
00:18:20,610 --> 00:18:24,120
!هذا الحساء لذيذ للغاية

210
00:18:27,010 --> 00:18:30,100
!ماذا؟ أهذه أوّل مرّة تتناولينه فيها؟

211
00:18:30,100 --> 00:18:31,170
!نعم

212
00:18:35,880 --> 00:18:36,800
...كيف

213
00:18:39,880 --> 00:18:41,260
...كيف

214
00:18:41,260 --> 00:18:45,220
!لا يتسنّى لتاما أكل شيء كهذا؟

215
00:18:56,840 --> 00:19:01,280
،إنّه مجرّد حساء فاصولياء حمراء
!فلا تغضب كثيرًا حياله

216
00:19:34,750 --> 00:19:37,110
...فاكهة المطّاط

217
00:19:38,420 --> 00:19:41,110
!مسدّس الفيل

218
00:20:16,370 --> 00:20:18,270
!اهربوا

219
00:20:18,270 --> 00:20:20,240
!وإلاّ نال منكم أيضًا

220
00:20:23,590 --> 00:20:26,740
.لا بدّ أنّه لوفي

221
00:20:30,010 --> 00:20:31,660
!يا قبطان، انظر

222
00:20:38,230 --> 00:20:42,340
!قبّعة القشّ! ما الّذي يفعله ذلك الغبيّ؟

223
00:20:47,550 --> 00:20:53,180
إننا نحاول التّسلّل عبر قاعة الوليمة
...دون لفت الانتباه متنكّرين

224
00:20:53,520 --> 00:20:55,160
...لا بأس

225
00:20:55,160 --> 00:20:56,160
!كيد؟

226
00:20:56,160 --> 00:20:58,260
!دعوه وشأنه

227
00:20:59,150 --> 00:21:04,610
.إنّه يجلب الأنظار له، لذلك من السّهل علينا التّحرّك

228
00:21:05,800 --> 00:21:11,160
عليّ أن أهدّئه الآن وإلاّ فلن أستطيع
...النّظر لوجه كينييمون

229
00:21:14,760 --> 00:21:17,480
!أعتمد عليك يا إنما

230
00:21:39,410 --> 00:21:40,820
!ماذا؟

231
00:22:10,530 --> 00:22:12,500
...يا إلهي

232
00:22:13,200 --> 00:22:15,600
!أثرت الكثير من الجلبة

233
00:22:17,490 --> 00:22:20,980
...أتيتُ مباشرة إلى هنا حيث الفوضى

234
00:22:22,420 --> 00:22:24,900
!ووجدت المكان هكذا مسبقًا

235
00:22:25,250 --> 00:22:30,110
!لماذا لا تستطيع التّسلّل بهدوء؟

236
00:22:30,130 --> 00:22:34,740
...التّسلّل بهدوء. اتّبع نصيحتك أوّلاً

237
00:22:34,740 --> 00:22:39,080
!هل يعلم ما الّذي يتفوّه به؟

238
00:22:42,020 --> 00:22:45,510
!هل نسيت ما هي الخطّة؟

239
00:22:45,720 --> 00:22:48,030
!لم أنس شيئًا

240
00:22:48,650 --> 00:22:51,010
...هؤلاء الحمقى

241
00:22:53,240 --> 00:22:56,390
!كانوا يسكبون حساء الفاصولياء الحمراء قصدًا

242
00:22:56,870 --> 00:22:58,520
!حساء الفاصولياء الحمراء؟

243
00:22:58,520 --> 00:23:02,550
!هذا الحساء لذيذ للغاية

244
00:23:04,120 --> 00:23:07,530
!في تلك الحالة، عليّ تقطيعهم جميعًا

245
00:23:18,390 --> 00:23:22,130
!صار مكان المهرجان الذّهبيّ ساحة معركة على الفور

246
00:23:22,130 --> 00:23:26,700
!يقف سكراتشمن أبو في طريق لوفي وزورو الغاضبين

247
00:23:26,700 --> 00:23:28,510
.اللّحن المرعب

248
00:23:28,510 --> 00:23:35,510
وبينما يصارعون في ساحة المعركة
!بلا مهرب، يصل كيد وهو يحمل ضغينة

249
00:23:36,240 --> 00:23:41,190
:في الحلقة القادمة من وان بيس
"!موسيقى القتال! قدرة تؤذي لوفي"

250
00:23:41,190 --> 00:23:43,860
!ملك القراصنة، لن يكون إلاّ أنا