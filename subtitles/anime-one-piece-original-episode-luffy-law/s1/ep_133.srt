1
00:00:22,290 --> 00:00:25,360
!العالم... نعم

2
00:00:25,890 --> 00:00:27,560
...اسعوا نحو الحرّيّة

3
00:00:27,560 --> 00:00:31,700
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:32,060 --> 00:00:35,430
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,930 --> 00:00:37,300
!فتجاوزوها

6
00:00:37,700 --> 00:00:40,670
!تحت راية ما تؤمنون به

7
00:00:45,140 --> 00:00:50,750
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,750 --> 00:00:53,980
متّجهًا نحو عالم بلا نهاية

9
00:00:55,390 --> 00:01:00,260
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,260 --> 00:01:08,670
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,670 --> 00:01:14,410
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,410 --> 00:01:18,840
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,840 --> 00:01:24,480
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,480 --> 00:01:28,350
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,350 --> 00:01:33,290
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,290 --> 00:01:41,030
متّجهين نحو الأفق

17
00:01:41,030 --> 00:01:46,540
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,540 --> 00:01:51,240
متّجهًا نحو عالم بلا نهاية

19
00:01:51,240 --> 00:01:56,480
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,480 --> 00:02:02,750
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:14,700 --> 00:02:17,430
سأغليه لثلاث ليالٍ ويومين
...لأزيل المذاق المرّ

22
00:02:18,540 --> 00:02:21,540
!انتظرا فحسب يا نامي-سان وروبين-تشان

23
00:02:21,540 --> 00:02:23,470
!سيكون هذا فطورًا مميّزًا

24
00:02:26,710 --> 00:02:30,650
!وصفة متوارثة"
".سانجي، رجل الكاري الحديديّ

25
00:02:36,450 --> 00:02:37,820
،سُحقًا

26
00:02:37,820 --> 00:02:41,360
وكأنّ هنالك من سكب حليبًا على هذا
.الضّباب. لا يمكنني رؤية أيّ شيء

27
00:02:41,360 --> 00:02:43,060
لوفي، هل ترى أيّ شيء؟

28
00:02:48,170 --> 00:02:50,070
!مهلاً، أرى شيئًا ما

29
00:02:53,070 --> 00:02:56,340
!مصيبة! ثمّة سفينة ضخمة أمامنا

30
00:02:56,740 --> 00:02:59,210
!سانجي-كُن! تولّ المقود
!استدر إلى أقصى الميمنة

31
00:02:59,440 --> 00:03:01,210
!حالاً يا نامي-سان

32
00:03:01,650 --> 00:03:04,110
—حبّ سانجي المميّز سوف

33
00:03:05,680 --> 00:03:07,450
!هـ-هذا سيّئ

34
00:03:07,450 --> 00:03:10,450
!نحن محاصرون بسفن البحريّة، صحيح؟

35
00:03:10,450 --> 00:03:11,460
!مذهل

36
00:03:12,060 --> 00:03:16,130
حتّى البحريّة لا يستطيعون
التّحرّك في هذا الضّباب؟

37
00:03:16,490 --> 00:03:19,960
قد يكون من الأفضل لنا الهروب
.مستغلّين هذا الضّباب الكثيف

38
00:03:20,400 --> 00:03:21,570
.معك حقّ

39
00:03:21,570 --> 00:03:24,570
واصلوا التّوجّه للأمام
.ولنلزم الصّمت جميعًا

40
00:03:24,570 --> 00:03:25,570
.خاصّة أنت يا لوفي

41
00:03:25,570 --> 00:03:26,370
!حاضر

42
00:03:28,240 --> 00:03:29,240
...نامي-سان

43
00:03:30,570 --> 00:03:32,440
.انتظري للحظة

44
00:03:34,410 --> 00:03:37,110
.طفل؟ أتساءل ما الّذي يفعله

45
00:03:46,220 --> 00:03:47,220
!انتبه

46
00:03:47,220 --> 00:03:48,160
.دع الأمر لي

47
00:04:00,140 --> 00:04:02,940
إنّه بخير الآن. يبدو أنّ أملاح
.الشّمّ أدّت مفعولها

48
00:04:04,410 --> 00:04:05,680
أ-أين أنا؟

49
00:04:05,680 --> 00:04:08,150
.أنت على سفينة قراصنة لوفي

50
00:04:08,380 --> 00:04:09,750
!قـ-قراصنة؟

51
00:04:09,910 --> 00:04:10,780
.نعم

52
00:04:10,780 --> 00:04:14,620
هل تتذكّر أيّ شيء؟
.وقعتَ من سفينة البحريّة

53
00:04:18,320 --> 00:04:21,690
!تـ-تراجعوا! تنوون مهاجمة البحريّة، صحيح؟

54
00:04:21,990 --> 00:04:24,330
!ما باله؟ هل نسي أنّنا أنقذنا حياته؟

55
00:04:24,330 --> 00:04:26,400
.لا يمكنك لومه. إنّه من البحريّة

56
00:04:28,270 --> 00:04:29,730
.كُل شيئًا أوّلاً

57
00:04:29,730 --> 00:04:32,370
!لا أريده! لا أحتاج لمساعدة قراصنة

58
00:04:33,740 --> 00:04:37,070
ترفض شرب حساء أعدّه طبّاخ
على سفينة قراصنة، صحيح؟

59
00:04:37,540 --> 00:04:39,340
.إنّه ليس مسمومًا أو ما شابه

60
00:04:39,980 --> 00:04:43,280
.سترتاح بمجرّد أن تملأ معدتك ببعض الطّعام

61
00:04:45,420 --> 00:04:47,080
!هذا الحساء مذهل

62
00:04:47,520 --> 00:04:49,950
!لا أصدّق مدى صفاء هذا الكونسومي

63
00:05:06,470 --> 00:05:07,740
.شكرًا على الطّعام

64
00:05:08,240 --> 00:05:09,840
.بالهناء والشّفاء

65
00:05:09,840 --> 00:05:12,940
.أنا تاجيو. أنا طبّاخ متدرّب في البحريّة

66
00:05:13,180 --> 00:05:14,450
.أنا سانجي

67
00:05:14,610 --> 00:05:17,150
أنت طبّاخ إذًا؟

68
00:05:17,580 --> 00:05:21,520
سانجي-سان، إنّك تضيّع وقتك بالطّبخ
!على متن سفينة قراصنة متهالكة كهذه

69
00:05:21,520 --> 00:05:22,850
!مهاراتك لا مثيل لها

70
00:05:23,050 --> 00:05:26,320
ماذا قلت؟! هذه السّفينة
!ليست متهالكة

71
00:05:26,320 --> 00:05:29,590
نعم! هذه السّفينة من قرية
—سيروب حيث كنت أعيش

72
00:05:29,590 --> 00:05:30,690
أهي حلوة؟

73
00:05:30,690 --> 00:05:33,000
.لا، اسمها يعني شراب فحسب
،كانت هنالك فتاة تُدعى كايا

74
00:05:33,000 --> 00:05:36,170
،أعطتنا هذه السّفينة
!لذلك فهي غالية علينا

75
00:05:33,000 --> 00:05:36,170
...مهلاً، مهلاً، مهلاً، على رسلك

76
00:05:40,100 --> 00:05:41,810
...في الحقيقة، أنا

77
00:05:49,810 --> 00:05:52,180
سكبتُ الكاري الّذي كانوا
.سيتناولونه على الغذاء

78
00:05:53,150 --> 00:05:54,250
!أنا جدّ آسف

79
00:05:55,820 --> 00:05:57,120
.ستعدّه أنت

80
00:05:58,490 --> 00:06:00,120
أنت من سكبه، صحيح؟

81
00:06:00,120 --> 00:06:02,530
،لذلك إن كنت آسفًا فعلاً حيال ذلك

82
00:06:02,530 --> 00:06:06,700
فقم بإعداد الكاري ثانية
.ليقدّم وقت الغداء

83
00:06:07,630 --> 00:06:09,770
.كان الطّاهي على حقّ
.لا شكّ في ذلك

84
00:06:09,770 --> 00:06:10,940
.نعم

85
00:06:11,300 --> 00:06:14,440
،لذلك حاولتُ إعداده مرارًا وتكرارًا

86
00:06:14,440 --> 00:06:15,970
.لكنّ النّتيجة لا تكون جيّدة

87
00:06:16,210 --> 00:06:18,610
تاجيو-كُن، هل لديك أيّ خبرة في الطّبخ؟

88
00:06:18,610 --> 00:06:22,150
بدأت كطبّاخ متدرّب قبل
.ستّة أشهر فحسب

89
00:06:22,550 --> 00:06:24,620
.يجب أن تكون تلك مدّة كافية

90
00:06:25,050 --> 00:06:28,850
لا أستطيع! كلّ ما أفعله كلّ يوم
!هو غسل الأطباق وتقشير الخضروات

91
00:06:28,850 --> 00:06:31,390
!لم أقم بطبخ أيّ طعام فعليّ

92
00:06:32,460 --> 00:06:33,560
...والأسوأ من ذلك

93
00:06:34,990 --> 00:06:38,000
لدى كلّ قادة السّفن عادة

94
00:06:38,000 --> 00:06:41,530
بحيث يجتمعون مرّة كلّ أسبوع
.ويتناولون الكاري على الغداء

95
00:06:41,830 --> 00:06:45,470
.وسفينتنا هي من ستستضيفهم هذا الأسبوع

96
00:06:45,900 --> 00:06:50,570
كيف يُفترض للكاري الّذي أعدّه
أن يرتقي لأذواق كبار البحريّة؟

97
00:06:51,180 --> 00:06:53,240
.كاري البحريّة مشهور

98
00:06:53,240 --> 00:06:56,110
سمعتُ أنّ الطّهاة من كلّ السّفن
،يتنافسون مع بعضهم

99
00:06:56,110 --> 00:06:58,580
.ولكلّ واحد نكهته الخاصّة بسفينته

100
00:06:58,780 --> 00:07:00,990
فعلاً؟ يبدو ذلك لذيذًا، صحيح؟

101
00:07:01,320 --> 00:07:02,920
،بعد قضائك ستّة أشهر في المطبخ

102
00:07:02,920 --> 00:07:04,990
،إن لم تمتلك أيّ ثقة بنفسك

103
00:07:04,990 --> 00:07:07,930
.فعد واعتذر لطاهيك ثانية

104
00:07:08,790 --> 00:07:09,690
.مستحيل

105
00:07:10,690 --> 00:07:13,430
!إن أخبرتُه بذلك، سيطردني من السّفينة

106
00:07:13,860 --> 00:07:15,900
وهل يجب أن تكون على
تلك السّفينة بالتّحديد؟

107
00:07:15,900 --> 00:07:17,540
هل من سبب لذلك أو ما شابه؟

108
00:07:18,070 --> 00:07:18,970
...في الواقع

109
00:07:19,670 --> 00:07:20,440
...الأزرق

110
00:07:22,470 --> 00:07:24,010
!هل تعرفون بشأن الأزرق الكامل؟

111
00:07:27,810 --> 00:07:30,080
الأزرق الشّرقيّ والأزرق الغربيّ

112
00:07:30,080 --> 00:07:31,850
...والأزرق الجنوبيّ والأزرق الشّماليّ

113
00:07:32,280 --> 00:07:35,590
إنّه حيث تجتمع كلّ مأكولات
.هذه البحار الأربعة اللّذيذة

114
00:07:36,490 --> 00:07:40,060
وبصفتي طبّاخًا، فإنّه بحر من الكنوز
.أودّ زيارته يومًا ما

115
00:07:40,860 --> 00:07:44,460
،يسخر الطّبّاخون الكبار من حلمي هذا

116
00:07:44,730 --> 00:07:46,360
!لكنّي أؤمن بوجوده

117
00:07:46,800 --> 00:07:48,930
!واثق أنّ الأزرق الكامل موجود

118
00:07:49,470 --> 00:07:53,370
،إن كنتُ على متن سفينة حربيّة للبحريّة
فستزداد فرصي بالذّهاب إليه، صحيح؟

119
00:07:53,500 --> 00:07:56,740
لذلك... لذلك لا أستطيع
!ترك هذه السّفينة

120
00:07:57,210 --> 00:07:59,540
الأزرق الكامل؟ أليس ذاك...؟

121
00:08:05,250 --> 00:08:07,820
كم أودّ مغادرة هذا المكان
...بأسرع ما يمكننا

122
00:08:07,820 --> 00:08:12,120
،صحيح، إن اكتشفوا وجودنا
...فسيطلقون وابل هجمات علينا

123
00:08:12,790 --> 00:08:14,960
،لكن ونظرًا للظّروف الرّاهنة

124
00:08:14,960 --> 00:08:17,460
،علينا إعادة هذا الفتى لسفينته
صحيح يا سانجي-كُن؟

125
00:08:20,100 --> 00:08:22,300
،سأعيده إلى سفينته فحسب
.لا أكثر ولا أقلّ

126
00:08:22,830 --> 00:08:24,900
.لوفي، ساعدنا للصّعود

127
00:08:26,700 --> 00:08:30,340
!غومو غومو نوو: الحبل الرّابط

128
00:08:31,980 --> 00:08:33,840
.يا سانجي، أنا أمسك بالسّفينة الآن

129
00:08:34,180 --> 00:08:36,780
،بمجرّد حلول وقت الظّهيرة
.سينقشع هذا الضّباب

130
00:08:37,080 --> 00:08:39,920
.وإن تأخّرنا أكثر، فسنكون في خطر كبير

131
00:08:40,280 --> 00:08:41,420
.تلك مدّة كافية

132
00:08:42,450 --> 00:08:44,120
إلى أيّ حدّ تنوي مساعدته؟

133
00:08:44,420 --> 00:08:46,620
سألقي نظرة على الوضع بنفسي فحسب

134
00:08:46,620 --> 00:08:48,330
.لأرى كيف يبدو مطبخ سفينة تابعة للبحريّة

135
00:08:48,530 --> 00:08:49,660
!سانجي

136
00:08:51,030 --> 00:08:54,000
!حسنًا، تمسّكا جيّدًا

137
00:09:03,270 --> 00:09:05,840
بالمناسبة، لماذا أتيت معنا أيضًا؟

138
00:09:05,840 --> 00:09:07,610
وكيف كنتَ لتعود بدوني؟

139
00:09:07,950 --> 00:09:09,980
،إذًا انتظر هنا فحسب
.وأحسن التّصرّف

140
00:09:09,980 --> 00:09:10,850
.أ-أكيد

141
00:09:14,690 --> 00:09:16,020
.هذا هو المطبخ

142
00:09:16,520 --> 00:09:20,260
،نعم. أظنّني سألقي نظرة عليه
.بما أنّني هنا

143
00:09:27,400 --> 00:09:30,200
.هذا متوقّع من البحريّة
.هذه الأغراض غالية الثّمن

144
00:09:30,940 --> 00:09:33,100
.والأكثر من ذلك، جميعها في حالة جيّدة

145
00:09:34,970 --> 00:09:35,840
ما هذا؟

146
00:09:35,840 --> 00:09:37,310
.إنّه صادر من مخزن طعام السّفينة

147
00:09:41,110 --> 00:09:42,250
...أفزعني ذلك

148
00:09:42,810 --> 00:09:44,720
!لوفي! ما الّذي تفعله هنا؟

149
00:09:45,150 --> 00:09:47,650
!سانجي! أستطلع! أقوم بالاستطلاع

150
00:09:47,920 --> 00:09:50,350
.لا يحصل المرء على فرصة كهذه كلّ يوم

151
00:09:53,220 --> 00:09:55,760
.لذلك، سأقوم بالمزيد من الاستطلاع فحسب

152
00:09:55,760 --> 00:09:57,290
،افعل ما يحلو لك

153
00:09:57,290 --> 00:09:59,830
،لكن إن وجدتك البحريّة
.فلن يتساهلوا معك

154
00:09:59,830 --> 00:10:00,560
...وأيضًا

155
00:10:01,330 --> 00:10:03,370
.اترك ما حشوت به جيوبك هنا

156
00:10:04,300 --> 00:10:05,470
إنّه تفّاح، صحيح؟

157
00:10:09,270 --> 00:10:11,310
.هذا هو كاري البحريّة

158
00:10:17,750 --> 00:10:20,020
...عندما كنتُ في المطعم البحريّ

159
00:10:21,790 --> 00:10:24,890
.لم يُعلّمني المالك زيف أيّ شيء

160
00:10:28,690 --> 00:10:32,760
يومًا بعد آخر، كلّ ما جعلني
.أفعله هو غسل الأطباق

161
00:10:35,870 --> 00:10:37,170
!أيّها الشّقيّ

162
00:10:37,900 --> 00:10:41,370
.عليك فعل ما هو أكثر من بذل جهدك

163
00:10:41,770 --> 00:10:44,110
لِمَ تظنّ أنّني أسمح لك
بالتّواجد في مطبخي

164
00:10:44,110 --> 00:10:47,210
وأطلب منك القيام بأعمال روتينيّة
!لنصف سنة أو سنة تقريبًا؟

165
00:10:47,210 --> 00:10:49,050
!فاستعمل رأسك ذاك وفكّر مليًّا

166
00:10:55,150 --> 00:10:58,590
،ذلك ما أخبرني به زيف
.بينما كان عدم الرّضا باديًا عليّ

167
00:10:59,190 --> 00:11:04,030
فهمت. سمح لي الطّاهي بالتّواجد
.هنا لأتعلّم مهاراته في الطّبخ

168
00:11:05,400 --> 00:11:07,700
.الطّبخ ليس أمرًا يمكن تعليمه ببساطة

169
00:11:13,300 --> 00:11:15,710
!سانجي-سان، سوف أجرّب بنفسي

170
00:11:18,740 --> 00:11:22,750
لنرَ... ما الّذي كان يقوله الطّاهي؟

171
00:11:23,880 --> 00:11:27,380
الوصفة الأساسيّة للكاري هي
.المسحوق والحساء والمكوّنات

172
00:11:27,890 --> 00:11:30,420
!يمزج مسحوق الكاري خاصّته بعناية

173
00:11:32,660 --> 00:11:34,260
...يا لها من رائحة

174
00:11:35,060 --> 00:11:36,730
،يأخذون مسحوق كاري معدّ سلفًا

175
00:11:36,730 --> 00:11:39,730
.ويضيفون له بعض الغارام ماسالا الطّازج

176
00:11:46,270 --> 00:11:49,840
لا تكن كسولاً لدرجة أن تستعمل
!المسحوق المعدّ سلفًا فحسب

177
00:11:51,040 --> 00:11:53,880
!إنّ نكهة التّوابل تتناقص يومًا بعد يوم

178
00:11:55,410 --> 00:11:56,910
!إنّه الغارام ماسالا

179
00:12:05,390 --> 00:12:07,630
.حاسّة شمّه جيّدة

180
00:12:33,680 --> 00:12:35,520
!إنّها ضخمة

181
00:12:35,950 --> 00:12:37,290
...في هذا الضّباب

182
00:12:37,720 --> 00:12:39,390
.لن نتحرّك لوقت طويل

183
00:12:40,890 --> 00:12:43,030
.على الأرجح أنّه سينقشع عند الظّهيرة

184
00:12:43,460 --> 00:12:45,860
بالمناسبة، هل سمعت
عن اجتماع الغداء المعتاد؟

185
00:12:46,530 --> 00:12:49,830
نعم، وعن أنّ الطّبّاخ المتدرّب
تاجيو هو من يعدّه؟

186
00:12:49,830 --> 00:12:52,600
.أتساءل ما الّذي سيطعمه لنا بالتّحديد

187
00:12:52,740 --> 00:12:53,840
!لا شكّ في ذلك

188
00:12:57,610 --> 00:12:58,610
،بالنّسبة للمرق

189
00:12:58,610 --> 00:13:01,510
بإمكاني استعمال أشياء جاهزة
.سلفًا تمّ غليها بشكل مكثّف

190
00:13:03,050 --> 00:13:04,950
.والآن، حان وقت تجهيز المكوّنات

191
00:13:07,280 --> 00:13:10,150
.أوّلاً، عليّ تقطيع لحم البقر وأقليه

192
00:13:21,170 --> 00:13:25,000
ثمّة نوع من كاري لحم
البقر حيث نجد عصارته

193
00:13:25,000 --> 00:13:27,610
.مخزّنة في لحم البقر نفسه

194
00:13:28,270 --> 00:13:30,610
لكنّ استنادًا على نكهة
،الكاري الخفيفة هذه

195
00:13:30,610 --> 00:13:32,910
فإنّه ليس من النّوع الّذي يُبقي
،جوهر اللّحم بداخله

196
00:13:32,910 --> 00:13:35,510
.بل يسمح له بالذّوبان خارجًا في الحساء

197
00:13:36,380 --> 00:13:41,490
.في تلك الحالة، فإنّ الفتى أخطأ من البداية

198
00:13:44,360 --> 00:13:45,260
هل من خطب ما؟

199
00:13:49,260 --> 00:13:53,130
يا فتى، الطّبخ ليس شيئًا
.عليك القيام به بعجالة

200
00:13:54,570 --> 00:13:58,300
تذكّروا، يعتمد كلّ شيء
.في الطّبخ على التّحضيرات

201
00:13:58,870 --> 00:14:02,340
.التّأنّي ضروريّ. هذا كلّ شيء

202
00:14:10,850 --> 00:14:11,980
...سأضيف الثّوم

203
00:14:13,750 --> 00:14:14,750
...والزّنجبيل

204
00:14:16,720 --> 00:14:18,160
،والكركم

205
00:14:19,020 --> 00:14:21,060
.ثمّ بعض الزّبادي

206
00:14:56,460 --> 00:14:58,260
.بهذا أكون اهتممتُ بالتّحضيرات

207
00:15:00,000 --> 00:15:01,830
.والآن، عليّ قلي البصل

208
00:15:19,980 --> 00:15:21,950
!كيف تدخّن في مكان أعدُّ فيه الطّعام؟

209
00:15:22,390 --> 00:15:24,260
!هل تعتقد أنّ ذلك مقبول كطبّاخ؟

210
00:15:24,620 --> 00:15:27,420
قلتُ سابقًا أنّك أفضل بكثير
،من أن تطبخ على سفينة قراصنة

211
00:15:28,130 --> 00:15:29,230
!لكنّني أسحب كلامي

212
00:15:29,660 --> 00:15:33,200
.يا ويحي، لقد حرقت شعري

213
00:15:42,240 --> 00:15:45,480
تذكّروا أن تقلوا البصل
.بشكل وجيز على نار قويّة

214
00:15:45,980 --> 00:15:47,950
.واصلوا تحريكه، لكي لا يحترق

215
00:15:48,450 --> 00:15:50,780
،بمجرّد أن يصبح البصل ناعمًا
.قلّلوا من النّار تحته

216
00:15:51,250 --> 00:15:54,250
قوموا بذلك ببطء ولطف
،بينما يُطهى فوق نار خفيفة

217
00:15:54,250 --> 00:15:56,050
.إلى أن يكتسب لونًا ذهبيًّا بنّيًّا

218
00:15:56,050 --> 00:15:57,350
أفهمتم؟

219
00:15:59,160 --> 00:16:02,960
كان سانجي-سان يحذّرني
...بشأن مستوى النّار

220
00:16:19,080 --> 00:16:21,480
.كم هذا مرتفع

221
00:16:21,710 --> 00:16:24,450
.المنظر من هنا مختلف تمامًا

222
00:16:27,820 --> 00:16:28,990
!مـ-من أنت؟

223
00:16:28,990 --> 00:16:30,820
!كُشف أمري

224
00:16:31,060 --> 00:16:32,090
!تمهّل

225
00:16:32,090 --> 00:16:33,760
!لن أتمهّل أبدًا

226
00:16:37,130 --> 00:16:38,860
...سأذيب بعض شحم الخنزير

227
00:16:40,230 --> 00:16:41,830
...وأضيف الدّقيق

228
00:16:43,800 --> 00:16:46,670
...وأحرّك بلطف حتّى لا يحترق

229
00:16:51,910 --> 00:16:53,340
...ثمّ سأضيف مسحوق الكاري

230
00:16:54,410 --> 00:16:57,280
إضافة إلى غارام ماسالا لتعزيز النّكهة

231
00:17:02,890 --> 00:17:05,720
...ثمّ ولجمع كلّ المكوّنات معًا

232
00:17:09,090 --> 00:17:10,490
...سأضيف المرق

233
00:17:12,930 --> 00:17:13,830
...ثمّ الطّماطم

234
00:17:19,770 --> 00:17:21,270
...والبصل أيضًا

235
00:17:25,980 --> 00:17:27,680
.وسأضيف اللّحم المتبّل

236
00:17:50,970 --> 00:17:52,340
...ثمّة خطب ما

237
00:17:53,770 --> 00:17:54,970
.لا قوام له

238
00:17:58,910 --> 00:18:01,580
.واضح تمامًا أنّني عاجز

239
00:18:08,690 --> 00:18:09,950
!...نكهات خفيّة

240
00:18:11,120 --> 00:18:12,220
!سانجي-سان

241
00:18:18,530 --> 00:18:19,800
...يا لحلاوة

242
00:18:21,530 --> 00:18:22,670
.هذه التّفّاحة

243
00:18:24,700 --> 00:18:25,640
...سانجي-سان

244
00:18:27,400 --> 00:18:28,770
.شكرًا جزيلاً لك

245
00:18:28,770 --> 00:18:30,040
علام تشكرني؟

246
00:18:31,280 --> 00:18:34,610
.لم أفعل أيّ شيء يتطلّب الشّكر

247
00:18:35,110 --> 00:18:37,980
سانجي-سان، تظاهرت بمجيئك
،لتفقّد السّفينة فحسب

248
00:18:37,980 --> 00:18:40,120
.لكنّك كنت تحاول تعليمي

249
00:18:40,280 --> 00:18:41,620
.لا تسئ الفهم

250
00:18:41,620 --> 00:18:44,120
!هناك! لقد هرب إلى هناك

251
00:18:45,090 --> 00:18:47,790
!سانجي! لنذهب

252
00:18:48,060 --> 00:18:49,460
...ذلك الغبيّ

253
00:18:50,090 --> 00:18:51,230
!تمهّل

254
00:18:52,030 --> 00:18:53,660
...غومو غومو نوو

255
00:18:53,900 --> 00:18:55,400
!الحبل الرّابط

256
00:18:57,430 --> 00:18:58,240
!حسنًا

257
00:18:58,440 --> 00:18:59,640
!تمسّك

258
00:19:02,010 --> 00:19:02,970
...تاجيو

259
00:19:03,770 --> 00:19:05,410
.أعتقد أنّه موجود أيضًا

260
00:19:06,480 --> 00:19:07,980
.الأزرق الكامل

261
00:19:09,150 --> 00:19:10,510
!سانجي! تمسّك

262
00:19:10,510 --> 00:19:11,280
!حالاً

263
00:19:21,760 --> 00:19:24,900
يا تاجيو، كان هنالك رجل
مريب هنا للتّوّ، صحيح؟

264
00:19:24,900 --> 00:19:25,900
إلى أين ذهب؟

265
00:19:25,900 --> 00:19:27,830
.ماذا؟ لا أدري

266
00:19:27,830 --> 00:19:29,600
أواثق أنّك لا تتخيّل الأمر فحسب؟

267
00:19:29,870 --> 00:19:32,570
واصلوا البحث! لا بدّ أنّه يختبئ
!في مكان ما على السّفينة

268
00:19:33,100 --> 00:19:34,410
!جدوه

269
00:19:40,740 --> 00:19:41,880
!...أيّها الـ

270
00:19:41,880 --> 00:19:44,250
هل تحمل ضغينة ما ضدّي؟

271
00:19:44,620 --> 00:19:45,550
.آسف

272
00:19:45,980 --> 00:19:48,590
!كلاّ، لا يبدو الأسف على وجهك

273
00:19:48,590 --> 00:19:49,650
.لذلك السّبب أنا آسف

274
00:19:49,920 --> 00:19:51,490
!...سأقطّعك لشرائح

275
00:19:53,190 --> 00:19:54,460
ما الخطب يا لوفي؟

276
00:19:55,190 --> 00:19:58,130
!لقد ألحقت ضررًا بغوينغ ميري ثانية

277
00:19:58,460 --> 00:20:00,730
!أوسوبّ، نامي، آسف

278
00:20:00,730 --> 00:20:03,900
كشفت البحريّة أمري، لذلك
.كان علينا المجيء بسرعة

279
00:20:04,270 --> 00:20:07,300
!ماذا؟! مـ-مهلاً، ما الّذي تقصده بذلك؟

280
00:20:07,300 --> 00:20:10,770
!إنّها سفينة غالية أهدتها لنا كايا

281
00:20:10,770 --> 00:20:13,080
!كم مرّة عليّ إخبارك بذلك؟

282
00:20:13,080 --> 00:20:14,180
!لا يمكننا البقاء هنا طويلاً

283
00:20:14,180 --> 00:20:16,350
،أوسوبّ، سانجي-كُن
!سنغادر في الحال

284
00:20:16,350 --> 00:20:17,850
!حالاً يا نامي-سان

285
00:20:17,850 --> 00:20:20,120
...كلاّ، لا يمكنني التّحرّك

286
00:20:35,500 --> 00:20:36,430
.قدّمه

287
00:20:36,730 --> 00:20:37,540
!حاضر

288
00:20:52,550 --> 00:20:54,850
.استمتعوا بوجبتكم رجاءً

289
00:21:06,960 --> 00:21:09,230
.هذا لذيذ

290
00:21:09,230 --> 00:21:10,940
إنّه كثيف بما يكفي والنّكهة الحارّة

291
00:21:10,940 --> 00:21:12,440
.تنتشر عبر فمي كلّه

292
00:21:12,440 --> 00:21:14,840
...اللّحم ناعم جدًّا

293
00:21:14,840 --> 00:21:16,770
!أريد المزيد في الحال

294
00:21:18,080 --> 00:21:19,040
...تاجيو

295
00:21:19,040 --> 00:21:20,210
!نعم أيّها الطّاهي

296
00:21:20,610 --> 00:21:23,310
.احرص على التّنظيف

297
00:21:24,180 --> 00:21:25,750
!حا-حاضر

298
00:21:37,730 --> 00:21:38,800
...سانجي-سان

299
00:21:42,370 --> 00:21:45,500
.أعتقد أنّه موجود أيضًا... الأزرق الكامل

300
00:21:56,610 --> 00:21:58,280
،سأعمل بجدّ أكبر

301
00:21:58,950 --> 00:22:02,520
ويومًا ما، سأصبح طبّاخًا جيّدًا
.مثلك يا سانجي-سان

302
00:22:09,060 --> 00:22:17,230
آه، خلف السّماء الّتي لا نهاية لها

303
00:22:17,230 --> 00:22:27,850
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

304
00:22:35,720 --> 00:22:43,160
مرّت عليّ أيّام كدت أخسر فيها نفسي

305
00:22:43,160 --> 00:22:51,570
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

306
00:22:51,570 --> 00:22:59,780
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

307
00:22:59,780 --> 00:23:08,620
دفعوا بي للأمام، أليس كذلك؟

308
00:23:08,620 --> 00:23:16,960
آه، إنّ النّجوم تهوي من السّماء

309
00:23:16,960 --> 00:23:20,060
...وهذه اللّحظة الفريدة

310
00:23:27,570 --> 00:23:30,940
إنّ الألعاب النّاريّة رائعة، صحيح؟
!إنّها جميلة جدًّا

311
00:23:30,940 --> 00:23:34,210
.كم أريد إطلاق بعض منها
ماذا؟ ستسمح لي بذلك؟

312
00:23:34,210 --> 00:23:38,120
،أنا جدّ سعيد! والأكثر من ذلك
!ستسمح لي بإطلاق الكبيرة؟

313
00:23:38,120 --> 00:23:40,720
مذهل! ولكن، أليست هذه كبيرة جدًّا؟

314
00:23:41,050 --> 00:23:42,420
:في الحلقة القادمة من ون بيس

315
00:23:42,420 --> 00:23:45,790
سأجعلها تتفتّح! الرّجل أوسوبّ"
".وكرة الثّمانية شاكو

316
00:23:45,790 --> 00:23:48,350
!ملك القراصنة، لن يكون إلاّ أنا