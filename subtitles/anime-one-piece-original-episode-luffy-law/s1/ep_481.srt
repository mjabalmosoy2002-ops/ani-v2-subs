1
00:00:40,430 --> 00:00:45,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,520 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,190 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:59,030 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,790 --> 00:01:07,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,290 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,510 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,090 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,810
هيّا بنا

10
00:01:25,890 --> 00:01:29,110
دون توقّف

11
00:01:29,230 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,490 --> 00:01:39,910
سأواصل النّهوض على قدميّ

13
00:01:40,030 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,540 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,880 --> 00:01:56,010
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,390 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,390 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,810 --> 00:02:14,980
دون توقّف

21
00:02:15,110 --> 00:02:20,160
دون استسلام لمرور الوقت

22
00:02:20,280 --> 00:02:25,830
سأواصل النّهوض على قدميّ

23
00:02:26,000 --> 00:02:31,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:35,730 --> 00:03:38,000
،بعد أن فُرّق عن بقيّة طاقمه

38
00:03:38,000 --> 00:03:43,070
!وصل لوفي إلى مارينفورد لينقذ أخاه إيس الّذي سيُعدَم

39
00:03:43,070 --> 00:03:50,100
تمكّن هو وطاقم اللّحية البيضاء أخيرًا من
!تخطّي الجدران المحيطة للوصول إلى المنصّة

40
00:03:50,100 --> 00:03:56,540
في خضمّ هجوم البحريّة، يركض لوفي صوب
!إيس بمساعدة من طاقم اللّحية البيضاء

41
00:04:04,700 --> 00:04:07,680
...أخيرًا... أخيرًا

42
00:04:09,200 --> 00:04:11,020
!وصلت

43
00:04:11,330 --> 00:04:12,790
!لوفي

44
00:04:14,030 --> 00:04:16,310
!...أنت حقًّا

45
00:04:16,310 --> 00:04:20,030
!أطلقوا! فجّروهم

46
00:04:30,060 --> 00:04:33,410
!ثمّة نفق من النّار في الدّخان

47
00:04:34,200 --> 00:04:36,670
!لطالما كنت هكذا

48
00:04:37,100 --> 00:04:38,500
!يا لوفي

49
00:04:41,870 --> 00:04:44,220
...لم تصغ إليّ قطّ

50
00:04:49,530 --> 00:04:52,310
!ودائمًا ما فعلتَ أشياء جنونيّة

51
00:04:58,730 --> 00:05:02,610
!إيس

52
00:05:10,200 --> 00:05:15,220
"!تمّ إنقاذ إيس! أمر اللّحية البيضاء الأخير"

53
00:05:37,830 --> 00:05:40,860
...قـ-قبضة النّار" إيس"

54
00:05:41,930 --> 00:05:44,860
!قد تحرّر الآن

55
00:05:45,180 --> 00:05:48,360
!رائع! نجحتَ يا قبّعة القشّ

56
00:05:48,360 --> 00:05:50,570
!لقد أنقذ إيس

57
00:05:50,990 --> 00:05:57,000
!كان يعمل بلا هوادة منذ إمبل داون
...ذلك الشّخص حقًّا

58
00:05:57,370 --> 00:05:59,790
!استثناء

59
00:06:03,460 --> 00:06:05,210
!حمدًا لهذا

60
00:06:06,090 --> 00:06:11,180
!أتممت مهمّتك أخيرًا يا لوفي

61
00:06:11,680 --> 00:06:14,890
...إن استطعنا الهروب من هنا بسلام

62
00:06:15,200 --> 00:06:16,680
!سنتزوّج

63
00:06:19,730 --> 00:06:24,570
!انظر يا كوبي! قبّعة القشّ اللّعين نجح أخيرًا

64
00:06:25,190 --> 00:06:28,740
!لوفي-سان، أنت مذهل

65
00:06:28,920 --> 00:06:33,120
!لا تفقدوا هدوءكم! استعدّوا للإطلاق

66
00:06:33,120 --> 00:06:34,950
!أطلقوا عليهم أثناء نزولهم

67
00:06:34,950 --> 00:06:35,370
!حاضر

68
00:06:37,580 --> 00:06:40,870
!ابق متيقّظًا يا لوفي! لنتفرّق حاليًّا

69
00:06:40,870 --> 00:06:42,040
!حسنًا

70
00:06:42,880 --> 00:06:44,710
!لا

71
00:06:47,720 --> 00:06:50,010
!وصيّة اللّهب

72
00:06:51,370 --> 00:06:52,760
!عمود النّار

73
00:07:26,800 --> 00:07:28,670
!إنّه قويّ جدًّا! احذروا

74
00:07:32,840 --> 00:07:34,930
هل يمكنك القتال يا لوفي؟

75
00:07:34,930 --> 00:07:36,140
!بالطّبع

76
00:07:37,890 --> 00:07:40,350
!إيس-سان! لوفي-كن

77
00:07:42,060 --> 00:07:45,860
لا تنسوا! قبضّة النّار إيس صاحب
!فاكهة النّار من نوع لوغيا

78
00:07:45,860 --> 00:07:51,530
!لم أتخيّل قطّ أنّك ستنقذني يومًا ما

79
00:07:51,530 --> 00:07:53,240
!شكرًا يا لوفي

80
00:07:56,280 --> 00:07:59,290
!ساعدني اللّحية البيضاء والبقيّة على فعل ذلك

81
00:08:00,700 --> 00:08:03,180
!لا تظنّا أنّكما في مأمن الآن

82
00:08:04,830 --> 00:08:07,790
!أصبحت الآن هذه ساحة إعدامكم

83
00:08:19,240 --> 00:08:19,890
!إنّها فرصتنا

84
00:08:19,890 --> 00:08:21,850
!سأمزّقك إربًا

85
00:08:26,400 --> 00:08:29,940
!إنّه أخي! لا تقربوه

86
00:08:33,200 --> 00:08:34,840
!قبضة النّار

87
00:08:44,830 --> 00:08:46,420
!المستوى الثّاني

88
00:08:46,420 --> 00:08:47,460
!الانتقال الآنيّ

89
00:08:53,170 --> 00:08:55,590
...فاكهة المطّاط

90
00:08:55,590 --> 00:08:58,230
!الطّابع النّفّاث

91
00:09:00,550 --> 00:09:01,880
!مسدّس النّار

92
00:09:07,910 --> 00:09:09,390
!فلتمت

93
00:09:16,570 --> 00:09:20,410
!لنسرع يا لوفي! علينا أن نخرج من هذا المكان

94
00:09:23,080 --> 00:09:24,160
!حسنًا

95
00:09:26,330 --> 00:09:28,630
!إنّهما ثنائيّ مثاليّ

96
00:09:28,630 --> 00:09:31,460
!أفسحوا لهما الطّريق للهرب

97
00:09:35,590 --> 00:09:38,050
!لا تدعوهما يهربان بأيّ ثمن

98
00:09:40,550 --> 00:09:41,640
!ضوء اليراعة

99
00:09:43,290 --> 00:09:44,600
!اشتعال

100
00:09:48,100 --> 00:09:50,900
!أعدموا قبضة النّار وقبّعة القشّ

101
00:09:51,650 --> 00:09:53,360
...فاكهة المطّاط

102
00:09:53,900 --> 00:09:57,320
!الرشّاش النّفّاث

103
00:10:43,490 --> 00:10:46,160
!أصبحت أقوى يا لوفي

104
00:10:56,250 --> 00:10:58,720
!سأصبح أقوى منك يومًا ما

105
00:11:05,220 --> 00:11:07,930
!إذًا، دعني أحميك الآن

106
00:11:08,560 --> 00:11:12,310
.أقلتَ "يومًا ما"؟ لا غد لكما

107
00:11:12,310 --> 00:11:15,900
هل تظنّان أنّكما تستطيعان الهرب؟

108
00:11:15,900 --> 00:11:17,190
!الأميرال كوزان

109
00:11:17,850 --> 00:11:19,530
!ذاك الوغد

110
00:11:21,030 --> 00:11:22,910
!كتلة الجليد

111
00:11:22,910 --> 00:11:24,990
.تراجع يا لوفي

112
00:11:36,990 --> 00:11:38,980
!منقار التّدرّج الهائج

113
00:11:38,980 --> 00:11:40,550
!لهب نار المرآة

114
00:12:26,250 --> 00:12:30,310
!لقد تخبّر جليد أوكيجي-سان على الفور

115
00:12:32,430 --> 00:12:37,230
!إنّه قائد وحدتنا الثّانية
!فمن الطّبيعيّ أن يستطيع فعل ذلك

116
00:12:37,230 --> 00:12:38,270
!رائع

117
00:12:38,270 --> 00:12:40,400
!يا لهما من أخوين

118
00:12:40,400 --> 00:12:44,860
!كفّوا عن الانبهار أيّها الأغبياء

119
00:12:44,860 --> 00:12:48,280
!أصلح حلزون الاتّصال بسرعة

120
00:12:48,760 --> 00:12:50,830
!حـ-حاضر

121
00:12:53,460 --> 00:12:59,800
...والآن، أتساءل إلى أيّ مدى يمكنه الهرب
!الجزء المهمّ يبدأ الآن يا قبّعة القشّ

122
00:13:00,520 --> 00:13:08,180
على أيّ حال، إن كان يمكنني أن أجهز على اللّحية
...البيضاء الّذي يُحتضر بالفعل في هذا التّشابك

123
00:13:09,680 --> 00:13:12,720
!فسأصير أحد اليونكو

124
00:13:12,720 --> 00:13:18,860
!مذهل! إنّه مسترخٍ في خضمّ وضعٍ كهذا
!هذا هو قبطاننا باغي

125
00:13:21,640 --> 00:13:24,030
...سيّد 2

126
00:13:24,570 --> 00:13:28,960
.بالكاد حقّقتُ أمنيّتك

127
00:13:30,160 --> 00:13:32,830
...والآن، عليّ أن أهرب وأختبئ

128
00:13:32,830 --> 00:13:35,080
!لمن يدين هذا الخائن بالولاء؟

129
00:13:36,580 --> 00:13:39,880
!لا، بل هو سجين متنكّر كحارس

130
00:13:39,880 --> 00:13:41,550
!لا

131
00:13:43,840 --> 00:13:45,090
!أميرال الأسطول-دونو

132
00:13:46,010 --> 00:13:49,800
!لا أصدّق هذا الخطأ الفادح
!حتّى أنا لم أستطع إيقافه

133
00:13:52,510 --> 00:13:57,060
!دعوهما يذهبان
!هكذا ستكون الأمور مثيرة للاهتمام أكثر

134
00:13:57,060 --> 00:13:58,650
!كفاك هراءً

135
00:13:59,440 --> 00:14:02,080
!حتّى قوّة الأميرال بلا جدوى أمامهما

136
00:14:02,080 --> 00:14:04,070
!فكيف لنا أن نقاتلهما؟

137
00:14:04,070 --> 00:14:06,070
!لا تهلعا

138
00:14:07,820 --> 00:14:09,530
!الأميرال ساكازوكي

139
00:14:11,030 --> 00:14:14,740
!لن ندعهما يهربان من هنا

140
00:14:17,870 --> 00:14:21,210
!لا تخافوا! لنهزمهما

141
00:14:27,140 --> 00:14:29,220
!مـ-ماذا الآن؟

142
00:14:34,810 --> 00:14:38,940
!انتبهوا جميعًا! سفينتهم تتحرّك

143
00:14:38,940 --> 00:14:42,150
!لا تقتربوا! إنّها تسير في الأرض بمجاديفها

144
00:14:42,900 --> 00:14:44,940
!مهلاً، من على متنها؟

145
00:14:52,120 --> 00:14:53,580
!سكوارد

146
00:14:53,580 --> 00:14:55,620
!قراصنة عنكبوت الدّوّامة

147
00:14:57,620 --> 00:15:01,790
!والدي، جميعًا، اهربوا

148
00:15:02,190 --> 00:15:05,710
!دعوا الحرب لنا

149
00:15:10,380 --> 00:15:13,010
!أولئك الحمقى

150
00:15:38,160 --> 00:15:41,080
!لا تكن سخيفًا يا سكوارد

151
00:15:41,080 --> 00:15:43,750
!من الواضح أنّك تشتهي الموت

152
00:15:47,800 --> 00:15:50,170
.بالطّبع أشتهيه

153
00:15:50,970 --> 00:15:54,220
.ما فعلته لوالدي كان فظيعًا

154
00:16:00,350 --> 00:16:03,480
،حتّى إن كان هذا لا يصلّح الأمر

155
00:16:03,480 --> 00:16:06,890
!لا يمكنني أن أدع الأمور على هذا الحال

156
00:16:09,610 --> 00:16:13,950
.آسف يا رفاق. ما كان يجب أن أدعهم تركبون

157
00:16:13,950 --> 00:16:17,240
!لا بأس أيّها القبطان! لا تقلق

158
00:16:17,250 --> 00:16:19,160
!تبعناك لأنّنا أردنا ذلك

159
00:16:19,580 --> 00:16:21,710
!سنختار أين سنموت بأنفسنا

160
00:16:22,010 --> 00:16:25,260
!أيّها القبطان! سنتبعك حتّى النّهاية

161
00:16:26,110 --> 00:16:27,810
...أنا آسف

162
00:16:29,200 --> 00:16:32,550
!جميعًا، خذوا إيس واهربوا

163
00:16:32,550 --> 00:16:35,260
!نار الإله: النّار المجهولة

164
00:16:40,900 --> 00:16:41,680
!سكوارد

165
00:16:48,820 --> 00:16:50,110
!أحمق

166
00:16:51,610 --> 00:16:56,610
!سكوارد اللّعين! تلك ليست الطّريقة الذكيّة للقيام بالأمر

167
00:16:56,610 --> 00:17:00,120
!أنت! أسرع وفكّ وثاقي

168
00:17:03,320 --> 00:17:07,080
!رفاق! هل أنتم بخير؟

169
00:17:11,100 --> 00:17:14,150
!تقدّموا

170
00:17:25,880 --> 00:17:27,900
!والدي

171
00:17:38,070 --> 00:17:39,520
!ماذا حدث؟

172
00:17:39,520 --> 00:17:42,290
!توقّفت هذه السّفينة

173
00:18:00,970 --> 00:18:02,760
!والدي

174
00:18:02,760 --> 00:18:05,770
...بـ-بيد واحدة فقط

175
00:18:07,140 --> 00:18:09,770
!أوقف السّفينة

176
00:18:23,080 --> 00:18:29,670
...ألا تعي كم من الجُحد لطفل

177
00:18:29,670 --> 00:18:34,340
!أن يموت أمام والده يا سكوارد؟

178
00:18:43,520 --> 00:18:45,220
!لا تسلّم لثقتك

179
00:18:46,110 --> 00:18:51,980
!تلك الطّعنة الصّغيرة الّتي تسبّبت بها لا تهدّد حياتي حقًّا

180
00:18:52,410 --> 00:18:55,610
!لكلّ امرئ مدّة من حياته

181
00:19:04,830 --> 00:19:08,000
!لقد حقّقنا هدفنا هنا

182
00:19:08,000 --> 00:19:12,420
!ما عاد سبب يبقينا هنا

183
00:19:12,420 --> 00:19:13,340
!الوالد العجوز

184
00:19:13,340 --> 00:19:15,040
!والدي

185
00:19:19,380 --> 00:19:24,230
!أصغوا جيّدًا يا قراصنة اللّحية البيضاء

186
00:19:27,020 --> 00:19:32,060
!سأوّجه لكم أمرًا من القبطان للمرّة الأخيرة

187
00:19:32,360 --> 00:19:36,690
!ماذا تقصد بـ"الأخيرة؟!" انتظر يا والدي، هذا محزن حقًّا

188
00:19:36,690 --> 00:19:38,940
!لا أريد أن أسمع مثل هذا الكلام

189
00:19:39,310 --> 00:19:41,610
!لنعد إلى العالم الجديد معًا

190
00:19:43,620 --> 00:19:45,830
!نار الصّليب

191
00:19:46,560 --> 00:19:47,870
!والدي

192
00:19:47,870 --> 00:19:51,460
!ستفترق سبلنا ها هنا

193
00:19:51,800 --> 00:19:58,090
!جميعًا، انجوا بأيّ ثمن وعودوا إلى العالم الجديد بسلام

194
00:20:06,260 --> 00:20:09,640
!و-والدي! هل تخطّط للموت هنا؟

195
00:20:12,360 --> 00:20:16,610
!أنا أثرٌ من العصر القديم

196
00:20:17,240 --> 00:20:22,450
!لا توجد أيّ سفينة تحملني في العصر الجديد

197
00:20:30,580 --> 00:20:34,870
!اذهبوا يا رفاق

198
00:20:45,340 --> 00:20:46,720
!اللّحية البيضاء

199
00:20:54,560 --> 00:20:57,320
!لا يا والدي

200
00:20:57,320 --> 00:20:59,520
!هذا أمر! علينا الذّهاب

201
00:20:59,520 --> 00:21:00,940
!العجوز

202
00:21:00,940 --> 00:21:02,740
!والدي

203
00:21:16,790 --> 00:21:18,960
!لا تنظروا للوراء

204
00:21:20,080 --> 00:21:22,700
!لأنّ العصر يتغيّر

205
00:22:07,970 --> 00:22:11,770
...بدأ كلّ شيء في ذلك البحر

206
00:22:16,180 --> 00:22:18,480
!هذا لا يصدّق

207
00:22:19,060 --> 00:22:22,370
أنت، لِمَ تبدو خاملاً؟

208
00:22:22,370 --> 00:22:25,500
!انضمّ لنا! هناك كنز أكثر من كافٍ

209
00:22:25,500 --> 00:22:28,070
.دعك منه

210
00:22:28,070 --> 00:22:32,940
...ماذا؟ ماذا تقصد؟ حصلنا على هذه الكنوز بفضله

211
00:22:32,950 --> 00:22:37,110
.دعه فحسب! ليس مهتمًّا بالكنوز

212
00:22:37,110 --> 00:22:41,420
هذا غريب! أيّ قرصان هو؟

213
00:22:41,960 --> 00:22:44,760
ماذا ترغب به؟

214
00:22:44,760 --> 00:22:47,240
!يا نيوغيت

215
00:23:03,960 --> 00:23:08,860
.كنتُ أرتحل لوقت طويل حقًّا

216
00:23:13,800 --> 00:23:16,990
!لننه الأمر

217
00:23:17,380 --> 00:23:19,080
!أيّتها البحريّة

218
00:23:25,460 --> 00:23:29,660
،خانعين لأمر اللّحية البيضاء الأخير
.يتجرّع القراصنة حزنهم وينسحبون

219
00:23:29,660 --> 00:23:33,530
إلاّ أنّ كلمات أكاينو القاسية بحقّ اللّحية البيضاء

220
00:23:33,530 --> 00:23:35,980
.أوقفت إيس

221
00:23:35,980 --> 00:23:40,350
يتجاهل إيس احتجاجات أصدقائه
!ويتقدّم إلى الأمام ليلقى قبضة أكاينو

222
00:23:40,350 --> 00:23:41,820
:في الحلقة القادمة من وان بيس

223
00:23:41,820 --> 00:23:45,260
!القوّة الّتي تستطيع حرق حتّى النّار"
"!ملاحَقة أكاينو القاسية

224
00:23:45,260 --> 00:23:47,520
!ملك القراصنة، لن يكون إلاّ أنا

225
00:23:49,990 --> 00:23:54,990
!!نلقاكم في الحلقة القادمة