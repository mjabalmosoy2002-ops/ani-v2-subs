1
00:00:40,430 --> 00:00:45,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,520 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,190 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:59,030 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,790 --> 00:01:07,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,290 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,510 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,090 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,810
هيّا بنا

10
00:01:25,890 --> 00:01:29,110
دون توقّف

11
00:01:29,230 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,490 --> 00:01:39,910
سأواصل النّهوض على قدميّ

13
00:01:40,030 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,540 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,880 --> 00:01:56,010
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,390 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,390 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,810 --> 00:02:14,980
دون توقّف

21
00:02:15,110 --> 00:02:20,160
دون استسلام لمرور الوقت

22
00:02:20,280 --> 00:02:25,830
سأواصل النّهوض على قدميّ

23
00:02:26,000 --> 00:02:31,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:34,910 --> 00:03:36,980
،بعد انفصال لوفي عن بقيّة طاقمه

38
00:03:36,980 --> 00:03:41,230
وصل أخيرًا إلى مارينفورد لإنقاذ أخيه إيس
!الّذي يوشك أن يُعدم

39
00:03:42,010 --> 00:03:44,590
يحاول لوفي وقراصنة اللّحية البيضاء
،للوصول إلى المنصّة

40
00:03:44,850 --> 00:03:49,060
!لكن تمّت محاصرتهم

41
00:03:49,680 --> 00:03:53,080
لكن بمساعدة جينبي، تمكّن
لوفي من تجاوز الجدار

42
00:03:53,460 --> 00:03:55,750
!ووصل إلى السّاحة أخيرًا

43
00:03:56,900 --> 00:03:57,680
!لوفي

44
00:03:58,050 --> 00:03:59,310
!أنا قادم

45
00:04:00,780 --> 00:04:03,600
!إيس

46
00:04:08,370 --> 00:04:09,390
!ما-ما هذا؟

47
00:04:18,950 --> 00:04:20,310
!نحن محاصرون

48
00:04:20,630 --> 00:04:22,290
!ما هذا؟

49
00:04:24,140 --> 00:04:26,160
!ابدأ يا أكاينو

50
00:04:30,280 --> 00:04:32,120
!بركان الشّهب

51
00:04:41,910 --> 00:04:44,260
!إنّه يطلق حممًا نحو السّماء

52
00:04:46,870 --> 00:04:48,570
!لا يمكنهم الهرب

53
00:04:49,250 --> 00:04:52,350
!أذب الجليد الّذي يقفون عليه

54
00:05:15,570 --> 00:05:17,390
...أنا آسف

55
00:05:18,030 --> 00:05:19,780
!تسير الخطّة كما يجب

56
00:05:20,160 --> 00:05:21,880
...لننتقل الآن إلى

57
00:05:21,880 --> 00:05:25,270
...إعدام بورتغاس د. إيس

58
00:05:26,110 --> 00:05:27,590
!في الحال

59
00:05:32,080 --> 00:05:33,060
!جينبي

60
00:05:34,410 --> 00:05:37,860
!أريدك أن تسديني خدمة

61
00:05:37,860 --> 00:05:42,890
!رمية كتف تيّار المحيط

62
00:05:46,400 --> 00:05:49,030
!عجبًا! وصلتَ أخيرًا

63
00:05:49,720 --> 00:05:53,630
!ما زلت واقفًا على قدميك يا ابن دراغون

64
00:05:53,700 --> 00:05:57,750
!إنّ شبابه أخافني

65
00:05:57,760 --> 00:06:04,420
!سأستعيد إيس

66
00:06:09,280 --> 00:06:11,390
...فاكهة المطّاط

67
00:06:11,390 --> 00:06:14,930
!مدفع الطّابع الرّشّاش

68
00:06:31,380 --> 00:06:36,030
!الانتقال للمرحلة الأخيرة"
"!خطّة اللّحية البيضاء لقلب الموازين

69
00:06:53,480 --> 00:06:58,010
لا أصدّق أنّه يهاجم ثلاثة أميرالات
!بشكل مباشر هكذا

70
00:06:58,010 --> 00:07:01,470
!واضح أنّه مغفّل! سيقتلونه

71
00:07:07,710 --> 00:07:09,360
!المستوى الثّاني

72
00:07:13,340 --> 00:07:16,500
!لا وقت لديّ لمقاتلة هؤلاء

73
00:07:17,790 --> 00:07:19,960
!لقد خدَعنا

74
00:07:26,570 --> 00:07:28,430
!أنت بطيء

75
00:07:39,920 --> 00:07:41,420
!لوفي-سان

76
00:07:41,850 --> 00:07:43,520
!هذا ما خشيته

77
00:07:52,950 --> 00:07:54,200
!سُحقًا

78
00:08:06,720 --> 00:08:07,880
!استعدّا

79
00:08:08,200 --> 00:08:08,960
!حاضر

80
00:08:14,750 --> 00:08:15,650
!ابدآ

81
00:08:20,290 --> 00:08:21,570
!إيس

82
00:08:21,750 --> 00:08:23,020
!إيس-سان

83
00:08:23,190 --> 00:08:25,060
!إيس

84
00:08:45,840 --> 00:08:49,720
!إيس

85
00:09:18,620 --> 00:09:19,730
!من كان الفاعل؟

86
00:09:28,280 --> 00:09:29,880
!أيّها الوغد

87
00:09:31,300 --> 00:09:34,240
ظننتُ أنّ تواجدك هنا سيكون لمصلحتنا

88
00:09:34,240 --> 00:09:37,280
.بما أنّك تكنّ ضغينة تجاه اللّحية البيضاء

89
00:09:38,570 --> 00:09:40,350
!كروكودايل

90
00:09:44,840 --> 00:09:45,780
!...يا له من

91
00:09:48,100 --> 00:09:51,230
.ماذا؟ ظننتُ أنّ هذه لحظتي لأتألّق-يوي

92
00:09:51,950 --> 00:09:55,520
.كان يحاول قتل العجوز من قبل

93
00:09:55,520 --> 00:09:58,210
!أرى أنّ الرّياح تهبّ لصالحنا

94
00:10:02,400 --> 00:10:07,220
.بإمكاني قتل ذلك العجوز الخرِف المحتضر لاحقًا

95
00:10:08,930 --> 00:10:10,330
،لكن قبل ذلك

96
00:10:11,100 --> 00:10:15,300
!لا أريد أن أسمح لكم بتذوّق النّصر

97
00:10:28,190 --> 00:10:30,610
!مهلاً، مهلاً أيّها التّمساح

98
00:10:31,010 --> 00:10:32,500
!د-دوفلامينغو

99
00:10:32,900 --> 00:10:36,360
،رفضت عرضي قبل قليل
والآن تريد التّحالف مع اللّحية البيضاء؟

100
00:10:41,230 --> 00:10:43,970
.يدفعني ذلك للشّعور بالغيرة

101
00:10:48,260 --> 00:10:51,120
.لن أتحالف مع أيّ أحد

102
00:10:51,690 --> 00:10:56,170
.هذا يعني أنّك ما زلت تدير ظهرك لي

103
00:10:56,920 --> 00:10:58,280
.ذلك ما يبدو

104
00:11:16,270 --> 00:11:19,830
!لا أدري ما الغاية من كلّ هذا، لكنّه أنقذني

105
00:11:20,160 --> 00:11:22,740
!هذه نهايتك يا قبّعة القشّ

106
00:11:23,420 --> 00:11:24,610
!مت

107
00:11:35,600 --> 00:11:37,330
...لا تقفوا أبدًا

108
00:11:38,340 --> 00:11:40,720
!في طريقي

109
00:11:49,930 --> 00:11:51,720
!توقّف يا قبّعة القشّ

110
00:11:52,210 --> 00:11:53,940
!لن أسمح لك بالتّقدّم أكثر

111
00:11:54,130 --> 00:11:54,940
!ابتعد

112
00:11:54,940 --> 00:11:55,740
!انتقال

113
00:11:56,910 --> 00:11:57,770
!مشية القمر

114
00:11:59,700 --> 00:12:01,230
...الجسد الحديديّ

115
00:12:01,230 --> 00:12:02,040
!سحق

116
00:12:08,870 --> 00:12:10,290
...فاكهة المطّاط

117
00:12:10,290 --> 00:12:11,570
!الجسد الحديديّ

118
00:12:11,900 --> 00:12:13,550
!الرّصاصة

119
00:12:20,900 --> 00:12:23,000
!أوقفوا قبّعة القشّ

120
00:12:23,010 --> 00:12:24,960
!لا تسمحوا له بالتّقدّم أكثر

121
00:12:27,200 --> 00:12:28,520
!الأميرال ساكازوكي

122
00:12:41,660 --> 00:12:44,810
!هذا مؤلم! سُحقًا

123
00:12:45,210 --> 00:12:48,180
أدين بخدمة لجدّك

124
00:12:48,820 --> 00:12:50,820
!لكن لا خيار لديّ

125
00:12:50,970 --> 00:12:54,300
!فقد اخترتَ المخاطرة بحياتك

126
00:12:54,430 --> 00:12:57,460
...أيّها المغفّل! لن أسمح لك بفعل ذلك بلوفي

127
00:13:07,790 --> 00:13:08,830
!أيّها الأميرال

128
00:13:09,600 --> 00:13:10,640
!...ذلك

129
00:13:12,950 --> 00:13:15,750
!قائد الوحدة الأولى ماركو

130
00:13:19,300 --> 00:13:20,980
!شكرًا لك! أنقذت حياتي

131
00:13:21,940 --> 00:13:23,600
!على الرّحب والسّعة-يوي

132
00:13:27,610 --> 00:13:30,160
!لدينا ثلاثة متعدّين في السّاحة

133
00:13:30,500 --> 00:13:33,590
!بإمكان آكلي فاكهة الشّيطان تجاوز الجدار

134
00:13:35,260 --> 00:13:37,170
ثـ... ثلاثة؟

135
00:13:37,610 --> 00:13:42,210
هـ-هل أنا واحد من الثّلاثة الّذين يتحدّثون عنهم؟

136
00:13:42,590 --> 00:13:45,970
!لكن متى اكتشفوا أمري؟

137
00:13:46,540 --> 00:13:49,900
بالكاد هربت من هجوم الأميرال أوكيجي

138
00:13:50,270 --> 00:13:53,010
!ونجوت من عدّة أزمات

139
00:13:53,230 --> 00:13:55,610
!ووصلت أخيرًا إلى هنا

140
00:13:56,600 --> 00:13:59,500
!لكنّني لست آمنًا هنا أيضًا

141
00:13:59,500 --> 00:14:02,660
!ألا يوجد أيّ مكان آمن؟

142
00:14:05,280 --> 00:14:06,290
!أحدهم قادم

143
00:14:12,380 --> 00:14:13,570
...لقد كانوا

144
00:14:20,330 --> 00:14:23,510
!اعبروا البحر نحو أورز

145
00:14:24,170 --> 00:14:27,810
!اذهبوا للسّاحة مهما كلّف الأمر

146
00:14:31,860 --> 00:14:33,390
!يا أميرال الأسطول

147
00:14:33,880 --> 00:14:37,100
!يتصرّف القراصنة داخل الخليج بغرابة

148
00:15:12,340 --> 00:15:16,060
!اعبروا البحر نحو أورز

149
00:15:16,790 --> 00:15:21,140
!اذهبوا للسّاحة مهما كلّف الأمر

150
00:15:21,980 --> 00:15:24,220
.إنّهم يائسون

151
00:15:24,710 --> 00:15:26,550
!احموا الثّغرة المفتوحة في الجدار

152
00:15:26,550 --> 00:15:27,400
!حاضر

153
00:15:31,720 --> 00:15:35,010
فقدوا رشدهم بعد خسارتهم لسفنهم
والجليد الّذي يقفون عليه

154
00:15:35,010 --> 00:15:36,810
!يا لهم من قراصنة أغبياء

155
00:15:37,180 --> 00:15:39,450
!إنّهم أهداف سهلة لنا! أطلقوا

156
00:16:04,970 --> 00:16:08,400
!لا تتردّدوا! واصلوا التّقدّم

157
00:16:09,650 --> 00:16:12,380
!اتّجهوا نحو أورز

158
00:16:17,580 --> 00:16:19,390
!اذهبوا للسّاحة

159
00:16:20,440 --> 00:16:22,700
ما-ما خطبهم؟

160
00:16:22,700 --> 00:16:25,250
كيف لهم أن يحافظوا على معنويّاتهم
!في وضع كهذا؟

161
00:16:25,650 --> 00:16:27,760
!تقدّموا

162
00:17:29,980 --> 00:17:33,200
!ليصعد الجميع

163
00:17:35,280 --> 00:17:37,320
!تمسّكوا جيّدًا

164
00:17:37,640 --> 00:17:39,850
!كـ-كلاّ! إنّها سفينة

165
00:17:40,750 --> 00:17:45,200
!لدينا مشكلة! دخلت سفينة مغلّفة أخرى الخليج

166
00:17:49,970 --> 00:17:53,090
سُحقًا! لا بدّ أنّها كانت مخبّأة
!في قاع البحر كلّ هذا الوقت

167
00:18:13,840 --> 00:18:18,120
.لا أذكر أنّني قلتُ أنّ تلك كانت كلّ سفننا

168
00:18:25,410 --> 00:18:29,210
إنّها سفينة بمجاديف وهي قادمة
!نحونا بكلّ سرعتها

169
00:18:29,980 --> 00:18:31,000
!ماذا؟

170
00:18:34,370 --> 00:18:37,390
!أغرقوها كما أغرقتم موبي ديك

171
00:18:50,890 --> 00:18:54,780
!كلاّ! ليس السّفينة! بل أطلقوا على أورز

172
00:18:55,050 --> 00:18:56,820
!ماذا؟ أورز؟

173
00:18:57,680 --> 00:18:59,320
!فات الأوان الآن

174
00:18:59,650 --> 00:19:01,700
!استعدّوا جميعًا

175
00:19:22,450 --> 00:19:25,500
!لقد أخرج السّفينة من المياه

176
00:19:25,810 --> 00:19:28,950
!لقد حطّموا الجدران المطوّقة بأكملها

177
00:19:38,320 --> 00:19:40,370
!وصلنا إلى السّاحة

178
00:19:41,660 --> 00:19:44,320
!لننقذ إيس

179
00:19:44,790 --> 00:19:47,330
!لنحرق مقرّ البحرية عن بكرة أبيه

180
00:19:47,930 --> 00:19:51,210
!انتظرنا يا إيس

181
00:19:52,180 --> 00:19:53,850
!نالوا منّا

182
00:19:53,850 --> 00:19:56,350
!كانت مجرّد ثغرة بحجم جُحر جرذ

183
00:19:56,800 --> 00:19:59,210
!لكنّهم استغلّوها بدهاء

184
00:20:00,040 --> 00:20:03,940
!قد تصير الجدران عائقًا لنا هذه المرّة

185
00:20:05,020 --> 00:20:07,690
!يا والدي

186
00:20:07,950 --> 00:20:09,450
!اللّحية البيضاء

187
00:20:10,570 --> 00:20:14,660
!ما زال رأسك بين كتفيك، صحيح يا إيس؟

188
00:20:17,780 --> 00:20:19,680
!نجحنا

189
00:20:20,710 --> 00:20:25,750
...بإمكاننا إنقاذ إيس-كُن

190
00:20:29,210 --> 00:20:30,460
!أورز

191
00:20:36,650 --> 00:20:40,890
...أنقذوا إيس-كُن مهما كلّف

192
00:20:59,460 --> 00:21:00,810
...أورز

193
00:21:48,800 --> 00:21:52,010
!نزل اللّحية البيضاء إلى السّاحة

194
00:21:58,400 --> 00:22:02,080
!تراجعوا يا أبنائي

195
00:22:35,250 --> 00:22:39,160
...يا رجال! أنقذوا إيس

196
00:22:39,580 --> 00:22:43,720
!ودمّروا البحريّة

197
00:22:50,350 --> 00:22:51,670
.غارب

198
00:22:52,180 --> 00:22:53,170
.نعم

199
00:22:57,660 --> 00:23:02,530
!لا أظنّ أنّ بإمكاننا النّجاة سالمين من هذا

200
00:23:13,040 --> 00:23:16,130
!أنا قادم يا إيس

201
00:23:25,380 --> 00:23:28,050
