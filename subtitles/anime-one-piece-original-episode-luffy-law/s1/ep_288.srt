1
00:00:15,570 --> 00:00:17,490
...الثّروة والشّهرة والسّلطة

2
00:00:17,490 --> 00:00:19,450
،الرّجل الّذي نال كلّ شيء في العالم

3
00:00:19,450 --> 00:00:21,370
.ملك القراصنة، غولد روجر

4
00:00:21,370 --> 00:00:25,080
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

5
00:00:25,080 --> 00:00:28,840
!كنزي؟ سأعطيكم إيّاه إن أردتموه

6
00:00:28,840 --> 00:00:32,380
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

7
00:00:34,800 --> 00:00:39,140
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة أحلامهم

8
00:00:39,720 --> 00:00:42,810
!دخل العالم في عصر قراصنة عظيم

9
00:00:43,520 --> 00:00:48,110
سنجمع كل أحلامنا

10
00:00:49,110 --> 00:00:54,650
ونبحر باحثين عن شيء، باحثين عن

11
00:00:54,950 --> 00:00:56,570
!وان بيس

12
00:01:01,080 --> 00:01:05,920
لا تجلب البوصلات سوى التّأخيرات

13
00:01:06,750 --> 00:01:11,750
أهذي بالحمّى، أمسك بمقود السّفينة

14
00:01:12,460 --> 00:01:17,760
إن تمّ التّحقّق من خريطة الكنز المغبرة

15
00:01:17,760 --> 00:01:23,310
!فإنّها ليست أسطورة إذًا

16
00:01:24,520 --> 00:01:30,230
،عندما يتعلّق الأمر بالأعاصير الشّخصيّة

17
00:01:30,230 --> 00:01:35,400
فاركب إيقاع أحدهم الحيويّ فحسب

18
00:01:35,400 --> 00:01:37,990
!وتظاهر أنّها غير موجودة

19
00:01:38,990 --> 00:01:43,830
سنجمع كلّ أحلامنا

20
00:01:44,830 --> 00:01:50,340
ونبحر باحثين عن شيء

21
00:01:50,340 --> 00:01:53,340
،عملة في جيبي

22
00:01:53,340 --> 00:01:56,590
وتريد أن تصبح صديقي؟

23
00:01:56,590 --> 00:02:01,100
!إنّنا، إنّنا في رحلة بحريّة

24
00:02:01,970 --> 00:02:03,890
!إنّنا كذلك

25
00:02:06,790 --> 00:02:10,000
...الثّروة والشّهرة والسّلطة

26
00:02:11,100 --> 00:02:15,990
،الرّجل الّذي نال كلّ شيء في العالم
.ملك القراصنة، غولد روجر

27
00:02:16,840 --> 00:02:22,870
قادت كلماته الّتي ألقاها قبل
.موته بالنّاس إلى البحار

28
00:02:23,320 --> 00:02:27,400
!كنزي؟ سأعطيكم إيّاه إن أردتموه

29
00:02:27,400 --> 00:02:31,830
جدوه! تركت كلّ ما هو موجود
!في هذا العالم فيه

30
00:02:32,260 --> 00:02:36,840
وبهذا، يتوجّه الرّجال نحو
!الغراند لاين لملاحقة الرّومانسيّة

31
00:02:37,350 --> 00:02:41,400
!دخل العالم في عصر قراصنة عظيم بالفعل

32
00:02:46,150 --> 00:02:48,280
،بإمكاني رؤية بوّابات العدالة الآن

33
00:02:48,280 --> 00:02:50,390
لكن هل يمكن بلوغها بقارب عاديّ؟

34
00:02:51,070 --> 00:02:54,730
.لا أملك متّسعًا من الوقت على أيّ حال

35
00:02:55,080 --> 00:02:56,230
!ها أنا ذا

36
00:02:58,620 --> 00:03:01,250
!عجبًا! أخي القرصان

37
00:03:01,250 --> 00:03:03,050
!ماذا تفعل؟

38
00:03:09,340 --> 00:03:10,790
...سانجي-كن

39
00:03:11,190 --> 00:03:13,060
ألم تستطع هزيمتها حقًّا؟

40
00:03:13,770 --> 00:03:15,540
هل قاتلت بجديّة فعلاً؟

41
00:03:16,890 --> 00:03:19,010
قاتلت تلك المرأة، أليس كذلك؟

42
00:03:19,180 --> 00:03:21,510
.أنت ضعيف أمام النّساء

43
00:03:22,610 --> 00:03:25,260
.آسف بشأن المفتاح

44
00:03:25,450 --> 00:03:26,610
!ليس هكذا

45
00:03:26,610 --> 00:03:31,190
أخبرك بهذا لأنّك قد تفقد حياتك
!بسبب شهامتك السّخيفة تلك

46
00:03:31,740 --> 00:03:34,240
!هل ستتمسّك بها حتّى إن تأذّيت هكذا؟

47
00:03:34,240 --> 00:03:35,900
!ماذا إن متّ؟

48
00:03:36,810 --> 00:03:38,070
...ليس وكأنّني

49
00:03:38,820 --> 00:03:40,910
.أريد أن أموت

50
00:03:41,040 --> 00:03:42,030
...لكنّي

51
00:03:42,470 --> 00:03:46,210
.كبرتُ بمبدأ ألاّ أركل النّساء

52
00:03:46,210 --> 00:03:47,250
...لذا

53
00:03:48,770 --> 00:03:50,540
...حتّى إن كلّفني ذلك حياتي

54
00:03:50,800 --> 00:03:53,210
!لن أركل امرأة

55
00:03:58,140 --> 00:03:59,590
.يا لك من أحمق

56
00:03:59,840 --> 00:04:00,670
!أحمق

57
00:04:01,140 --> 00:04:03,510
!مهلاً! ماذا تفعلين يا نامي؟

58
00:04:03,900 --> 00:04:06,320
،إن كان الهرب يخالف شهامتك أيضًا

59
00:04:06,320 --> 00:04:08,600
!فتخلّص من تلك الشّهامة

60
00:04:08,830 --> 00:04:12,020
.لا تستحقّ أن تموت هباءً من أجلها

61
00:04:13,030 --> 00:04:15,850
.دع تلك المرأة لي

62
00:04:16,950 --> 00:04:18,250
...و

63
00:04:18,870 --> 00:04:21,860
.أحترم شهامتك أكثر من السّابق

64
00:04:22,110 --> 00:04:22,890
!ماذا؟

65
00:04:22,890 --> 00:04:25,080
هل قالت للتّوّ أنّها تحبّني أكثر من السّابق؟

66
00:04:25,080 --> 00:04:26,530
!كلاّ، لم تقل

67
00:04:32,680 --> 00:04:35,420
.لستُ لطيفة

68
00:04:36,310 --> 00:04:37,650
.ولا أنا

69
00:04:37,650 --> 00:04:39,480
.يبدو أنّنا سنتفاهم

70
00:04:54,140 --> 00:04:55,600
!يويوي

71
00:04:55,600 --> 00:04:58,240
!انتظري

72
00:04:58,240 --> 00:04:59,230
!رجل الأخطبوط

73
00:04:59,480 --> 00:05:00,900
...لن

74
00:05:00,900 --> 00:05:06,250
!لن أدعك تهربين

75
00:05:06,620 --> 00:05:08,040
!نامي، اذهبي وتكفّلي بتلك المرأة

76
00:05:08,040 --> 00:05:09,660
!سأفعل شيئًا حيال هذا الشّخص

77
00:05:10,940 --> 00:05:12,030
!حسنًا

78
00:05:12,660 --> 00:05:15,090
!يوي! يوي! يويوي

79
00:05:15,090 --> 00:05:17,350
!هل ستعترض طريقي؟

80
00:05:17,350 --> 00:05:18,420
...حوافر أزهار الكرز

81
00:05:19,670 --> 00:05:20,380
!المتقاطعة

82
00:05:36,000 --> 00:05:39,530
!كيف تجرؤ؟

83
00:05:39,530 --> 00:05:42,270
!هربت ثانيةً

84
00:05:42,780 --> 00:05:45,020
!أنا هو خصمك

85
00:05:45,330 --> 00:05:46,280
!هيّا

86
00:05:49,150 --> 00:05:53,710
!خطأ فوكورو التّقديريّ"
"!الكولا خاصّتي هي ماء الحياة

87
00:06:07,180 --> 00:06:10,850
بربّك، يستحيل أن تعبر مياهًا كهذه
بمثل هذا القارب، أليس كذلك؟

88
00:06:10,850 --> 00:06:12,350
!هل أنت غبيّ؟

89
00:06:13,570 --> 00:06:17,180
!لكنّهم أخذوا روبين إلى تلك البوّابات

90
00:06:17,430 --> 00:06:21,270
!لن أتمكّن من استرجاعها ما لم أسرع

91
00:06:24,180 --> 00:06:27,440
يجدر أن أستطيع الوصول إلى المبنى
الّذي أمامها، صحيح؟

92
00:06:27,620 --> 00:06:29,360
!مهلاً! ما الّذي تفعله؟

93
00:06:29,360 --> 00:06:30,820
!انتظر يا أخي القرصان

94
00:06:30,820 --> 00:06:32,320
!اهدأ

95
00:06:32,520 --> 00:06:34,910
،إن كنت لا أستطيع عبور البحر
!فلا خيار أمامي سوى القفز

96
00:06:35,120 --> 00:06:39,710
أتينا لندلّك على الطّريق للوصول
!إلى بوّابات العدالة

97
00:06:40,890 --> 00:06:41,750
ماذا؟

98
00:06:59,160 --> 00:07:00,420
ما هذا المكان؟

99
00:07:00,420 --> 00:07:01,490
قبو؟

100
00:07:01,490 --> 00:07:03,200
.إنّه ممرّ تحت البحر

101
00:07:03,400 --> 00:07:06,610
،للوصول إلى بوّابات العدالة
.عليك الذّهاب تحت البحر

102
00:07:07,300 --> 00:07:08,580
.فهمت

103
00:07:09,200 --> 00:07:09,940
!حسنًا إذًا

104
00:07:09,940 --> 00:07:12,160
!انتظر! هل تعرف كيف تصل إلى هناك؟

105
00:07:19,470 --> 00:07:21,280
.أنت مذهلة على أيّ حال

106
00:07:21,280 --> 00:07:23,290
!أنا منبهر لأنّك تعرفين عن ممرّ كهذا

107
00:07:24,420 --> 00:07:29,640
رأيت خادم لوتشي ينزل الدّرج
.وهو يضحك بصخب

108
00:07:29,640 --> 00:07:31,300
.لذا تبعتهم

109
00:07:34,360 --> 00:07:37,400
!لا يمكنهم ملاحقنا إن كانوا لا يعرفون أين المدخل

110
00:07:37,400 --> 00:07:38,770
!هذا ما يستحقّونه

111
00:07:39,090 --> 00:07:42,730
دخل لوتشي وتلك الآنسة سوداء
.الشّعر من تلك الأبواب أيضًا

112
00:07:57,070 --> 00:07:58,490
هذه هي إذًا؟

113
00:08:02,910 --> 00:08:05,420
.إنّها أبواب حديديّة قويّة للغاية

114
00:08:05,570 --> 00:08:07,400
هل تعرفين كيف تُفتح؟

115
00:08:08,100 --> 00:08:10,960
،كان الخادم يلمس هذا المكان

116
00:08:11,220 --> 00:08:14,290
لذا أعتقد أنّه يشتغل من خلال
...ثقب المفتاح هذا

117
00:08:14,970 --> 00:08:16,550
.إلاّ أنّنا لا نملك المفتاح

118
00:08:24,020 --> 00:08:25,630
.تراجعا

119
00:08:26,060 --> 00:08:28,280
ماذا؟ ماذا ستفعل؟

120
00:08:30,880 --> 00:08:33,450
بوسعنا الذّهاب إلى بوّابات العدالة
إن دخلنا من هنا، صحيح؟

121
00:08:46,680 --> 00:08:48,250
!المستوى الثّالث

122
00:09:26,930 --> 00:09:28,250
...فُتِحت

123
00:09:37,770 --> 00:09:39,470
!حسنًا! سأدخل

124
00:09:40,230 --> 00:09:42,930
!ماذا؟! لِمَ أصبحت صغيرًا الآن؟

125
00:09:57,880 --> 00:10:00,620
!أخي القرصان مثير لاهتمام بالفعل

126
00:10:02,340 --> 00:10:04,890
!حسنًا، لنباشر نحن أيضًا

127
00:10:07,540 --> 00:10:10,180
.سـ-سمعتُ ضجيجًا صاخبًا للتّوّ

128
00:10:10,180 --> 00:10:11,250
أكنت أتخيّل فحسب؟

129
00:10:11,250 --> 00:10:13,020
.كلاّ، مستحيل

130
00:10:13,730 --> 00:10:17,020
هل يمكن أن يكون ذلك الضّجيج
ناجمًا عن كسر القراصنة للأبواب؟

131
00:10:17,020 --> 00:10:19,430
!ماذا؟! ذلك مستحيل

132
00:10:19,700 --> 00:10:22,030
!إنّها أبواب حديديّة سميكة

133
00:10:22,030 --> 00:10:25,850
كما أنّه يستحيل عليهم إيجاد
!تلك الأبواب من الأساس

134
00:10:25,850 --> 00:10:30,980
في الواقع، يجدر بهم أن يعرفوا مكانها
.بما أنّ طفلةً وحيوانها الأليف كانا يتبعاننا

135
00:10:30,980 --> 00:10:32,200
!ماذا؟

136
00:10:32,200 --> 00:10:34,820
!مـ-ما دمت تعلم ذلك، لِمَ لم تقتلهما؟

137
00:10:38,670 --> 00:10:40,190
...لأنّني

138
00:10:40,750 --> 00:10:42,410
.لم أتلقّ أمرًا بذلك

139
00:10:42,820 --> 00:10:43,740
...ما

140
00:10:44,410 --> 00:10:46,410
!ماذا؟! أيّها الغبيّ

141
00:10:46,820 --> 00:10:49,310
!بإمكانك استخدام تقديرك إن كان الأمر تافهًا هكذا

142
00:10:49,310 --> 00:10:51,330
ألا يمكنك أن تعرف ما قد يحدث
!إن تجاهلت الأمر؟

143
00:10:52,140 --> 00:10:53,730
!ماذا تقول إذًا؟

144
00:10:53,730 --> 00:10:55,810
!هل تقصد أنّ أحدًا متّجهًا إلى هنا؟

145
00:10:55,810 --> 00:10:57,890
.أظنّ ذلك

146
00:10:57,890 --> 00:10:59,680
!أنا خائف

147
00:11:00,280 --> 00:11:02,010
!اخرس

148
00:11:02,010 --> 00:11:03,180
.كان ذلك أنا

149
00:11:03,620 --> 00:11:05,150
!اسمع يا لوتشي

150
00:11:05,150 --> 00:11:09,200
!أولى أولويّاتك هي حماية حياتي

151
00:11:09,200 --> 00:11:10,140
!مفهوم؟

152
00:11:10,560 --> 00:11:14,270
!وأيضًا، اقتل أيّ من يحاول اعتراض طريقي

153
00:11:14,840 --> 00:11:19,000
!عصياني يعدّ تمرّدًا على حكومة العالم

154
00:11:19,000 --> 00:11:20,320
!يستحقّون الموت

155
00:11:24,780 --> 00:11:28,200
!ماذا؟! ما هذه النّظرة؟

156
00:11:33,930 --> 00:11:37,150
لا تملكين الوقت للقلق على الآخرين
.يا نيكو روبين

157
00:11:37,320 --> 00:11:39,630
.لقد اقتربت من الجحيم بالفعل

158
00:11:39,920 --> 00:11:42,450
.لوتشي! أحضرها حالاً

159
00:12:03,250 --> 00:12:05,440
!حسنًا! عاد جسدي إلى طبيعته

160
00:12:08,050 --> 00:12:10,120
!انتظري فحسب يا روبين

161
00:12:13,410 --> 00:12:17,090
!سأحرص على إيساع صاحب الحمامة ذاك ضربًا

162
00:12:22,300 --> 00:12:26,220
...حسنًا، خسر سانجي-كن بسبب خطئه

163
00:12:28,820 --> 00:12:31,580
لكن ماذا فعلت به بالضّبط؟

164
00:12:58,050 --> 00:13:01,050
ما بال هذه المرأة؟

165
00:13:04,930 --> 00:13:07,090
.يا لجرأتها

166
00:13:28,220 --> 00:13:32,850
سحقًا! بينما عليّ أن أعيد ملأ
...الكولا خاصّتي قريبًا

167
00:13:33,890 --> 00:13:37,850
،بالنّسبة لشخصٍ ضخم البنية
.إنّه يحبّ القفز حقًّا

168
00:13:41,770 --> 00:13:44,550
.تشابابا... أنا هنا

169
00:13:46,900 --> 00:13:49,260
.يبدو أنّك سريع في الهرب على الأقلّ

170
00:13:49,690 --> 00:13:51,070
...تشابابا

171
00:13:51,070 --> 00:13:55,770
.لستُ ملزمًا على تلقّي لكماتك الفخورة

172
00:13:56,040 --> 00:13:58,440
!سوالف فرانكي المثلّثة

173
00:14:02,860 --> 00:14:04,090
.تشابابا

174
00:14:04,090 --> 00:14:05,320
...يستحيل

175
00:14:06,300 --> 00:14:07,700
!أن أُضرَب بسوالف كتلك

176
00:14:08,880 --> 00:14:09,530
!نلت منك

177
00:14:12,370 --> 00:14:14,380
!سلاح اليد اليسرى

178
00:14:20,230 --> 00:14:21,960
.يبدو أنّ الكولا تكاد تنفد منّي

179
00:14:22,350 --> 00:14:23,980
!من الأفضل أن أسرع إلى المطبخ

180
00:14:23,980 --> 00:14:25,300
!انتظر

181
00:14:25,770 --> 00:14:27,920
!سحقًا! تفادى هجماتي

182
00:14:28,310 --> 00:14:30,510
!إنّك خبير في الهرب أيّها الجبان اللّعين

183
00:14:30,820 --> 00:14:32,030
!تشابا

184
00:14:32,440 --> 00:14:33,390
!ماذا قلت؟

185
00:14:35,860 --> 00:14:37,760
ما الخطب يا جبان؟

186
00:14:37,970 --> 00:14:39,810
ألن تهرب هذه المرّة؟

187
00:14:40,040 --> 00:14:41,760
!أيّها الوغد

188
00:14:42,390 --> 00:14:45,230
!أغضبتني بتلك الكلمة

189
00:14:46,540 --> 00:14:48,830
!فلتتلقّ قبضتي القاتلة

190
00:14:48,830 --> 00:14:52,160
إنّها لكمة ثقيلة للغاية مدمجة
!مع سرعة مسدّس الإصبع

191
00:14:52,160 --> 00:14:53,320
!الوحش العنيف

192
00:15:00,890 --> 00:15:03,000
!...تشابابا

193
00:15:04,560 --> 00:15:07,370
...يا لها من لكمة متواضعة وغير فعّالة

194
00:15:08,770 --> 00:15:10,010
...المطرقة

195
00:15:10,430 --> 00:15:11,090
!الجسد الحديديّ

196
00:15:11,480 --> 00:15:12,390
!القويّة

197
00:15:18,480 --> 00:15:21,810
.يا لها من لكمة سخيفة

198
00:15:21,810 --> 00:15:23,480
!الوحش العنيف

199
00:15:38,970 --> 00:15:42,170
.لكماتك مترهّلة

200
00:15:43,730 --> 00:15:44,900
.لا

201
00:15:44,900 --> 00:15:47,810
.لكماتك ضعيفة

202
00:15:47,810 --> 00:15:50,710
.إذًا فلكماتك رقيقة

203
00:15:50,710 --> 00:15:53,750
.سراويلك بليدة

204
00:15:55,460 --> 00:15:56,850
سراويلي؟

205
00:16:01,480 --> 00:16:03,320
!ليست لكمات

206
00:16:03,320 --> 00:16:05,360
!بل هي سراويل فحسب

207
00:16:05,360 --> 00:16:07,320
!أيّها الوغد ذو حمّالات الصّدر

208
00:16:07,320 --> 00:16:09,280
!اخرس يا ذا الجوارب

209
00:16:09,280 --> 00:16:10,150
!ملابس داخليّة طويلة

210
00:16:10,150 --> 00:16:11,260
!سراويل فضفاضة

211
00:16:11,260 --> 00:16:12,090
!مئزر

212
00:16:12,090 --> 00:16:14,190
!تشابابابابا

213
00:16:22,940 --> 00:16:24,300
!إليك عنّي أيّها الوغد

214
00:16:24,300 --> 00:16:25,960
!اخرس يا محفظة الفكّة

215
00:16:26,560 --> 00:16:27,690
!حسنًا

216
00:16:27,690 --> 00:16:29,580
!استطعتُ دخول المطبخ

217
00:16:31,020 --> 00:16:34,040
!ها هي ذي! ثلاّجة ضخمة

218
00:16:39,440 --> 00:16:40,610
أهذا هو؟

219
00:16:40,810 --> 00:16:42,890
...حامل قوى الغوريلاّ... على الأغلب

220
00:16:43,200 --> 00:16:44,480
!سحقًا

221
00:16:44,720 --> 00:16:46,890
هل مضت ثلاث دقائق بالفعل؟

222
00:16:47,340 --> 00:16:50,090
.استخدمتُ كرة رامبل مبكّرًا

223
00:16:50,790 --> 00:16:51,690
ما العمل؟

224
00:16:54,500 --> 00:16:55,570
!يويوي

225
00:16:58,200 --> 00:17:01,300
!اختفِ من هذا العالم

226
00:17:01,300 --> 00:17:04,160
!هذه الضّربة القاضية

227
00:17:04,480 --> 00:17:05,370
!...يويو

228
00:17:06,460 --> 00:17:07,420
!أيّها الوغد

229
00:17:09,160 --> 00:17:10,420
!جيّد! حبسته

230
00:17:11,390 --> 00:17:12,960
!تشابا! كومادوري

231
00:17:15,100 --> 00:17:17,010
!أجل! لقد حبسته

232
00:17:17,360 --> 00:17:18,340
كيف تجرؤ...؟

233
00:17:18,340 --> 00:17:19,890
!انتظر لحظة أيّها الغوريلاّ

234
00:17:20,040 --> 00:17:22,390
!أحتاج تلك الثّلاّجة

235
00:17:22,660 --> 00:17:24,990
!عضو من السّي بي 9 ورعاع

236
00:17:24,990 --> 00:17:27,260
!أنا فرانكي! أنا في صفّك، هل نسيت؟

237
00:17:27,260 --> 00:17:28,410
!من نعتّ بالغوريلاّ؟

238
00:17:28,410 --> 00:17:29,150
!أنت بطيء الاستيعاب

239
00:17:29,910 --> 00:17:30,900
.اسمع

240
00:17:30,900 --> 00:17:34,310
.كما حال لوفي، لم أسامحك بعد

241
00:17:34,510 --> 00:17:36,740
...سبب فراق أوسوبّ لنا

242
00:17:38,570 --> 00:17:40,850
!يقع عليك وحدك

243
00:17:40,850 --> 00:17:42,510
!أعد لنا أوسوبّ

244
00:17:42,510 --> 00:17:45,540
.كما أخبرتكم، كنتم معه سابقًا

245
00:17:45,970 --> 00:17:48,060
!وهذا لا يهمّ الآن

246
00:17:48,060 --> 00:17:50,060
!ألا تريد إنقاذ نيكو روبين؟

247
00:17:50,060 --> 00:17:53,000
!بلى! روبين

248
00:17:53,270 --> 00:17:57,100
إذًا أخرج ثلاث قنّينات كولا
!من تلك الثّلاّجة وأعطها لي

249
00:17:57,100 --> 00:17:59,250
!بإمكاني تعزيز قوّتي بالكولا

250
00:17:59,250 --> 00:18:03,400
ثمّ سأتولّى أمر هذين الاثنين بسرعة
!وأحصل على مفتاحيهما

251
00:18:03,680 --> 00:18:06,110
أيّ غبيّ يصبح أقوى بواسطة الكولا؟

252
00:18:06,110 --> 00:18:07,870
!اخرس! إنّه أنا

253
00:18:09,920 --> 00:18:11,280
...إلى متى

254
00:18:11,600 --> 00:18:13,860
!ستواصلان هذا العرض الكوميديّ؟

255
00:18:14,950 --> 00:18:18,310
وفوق ذلك، كنتما تحاولان
أخذ استراحة شاي أثناء القتال؟

256
00:18:18,310 --> 00:18:20,220
!يا لوقاحتكما

257
00:18:20,820 --> 00:18:22,610
:مهارة الوحش العنيف السّرّيّة

258
00:18:25,710 --> 00:18:26,750
!درّاس البومة

259
00:18:30,420 --> 00:18:31,920
!تشابابابابا

260
00:18:33,420 --> 00:18:35,360
!فاصوليا اليسرى

261
00:18:43,150 --> 00:18:44,890
!ما كان ذلك؟

262
00:18:48,530 --> 00:18:49,870
!هذا فظيع

263
00:18:49,870 --> 00:18:52,120
!صحيح! إنّه في صفّنا الآن

264
00:18:52,120 --> 00:18:53,060
.سأفعل ما قال لي

265
00:18:56,340 --> 00:18:59,150
!إن فتحت الباب وأغلقته في ثانية، لن يخرج

266
00:19:01,540 --> 00:19:02,740
!يويوي

267
00:19:02,740 --> 00:19:07,580
...الباب قد

268
00:19:08,180 --> 00:19:08,750
!حسنًا

269
00:19:09,250 --> 00:19:10,270
!فرانكي

270
00:19:11,800 --> 00:19:12,540
!شكرًا

271
00:19:20,220 --> 00:19:24,180
!انتعاش

272
00:19:26,070 --> 00:19:27,640
ما الّذي...؟

273
00:19:30,130 --> 00:19:33,440
!الانتعاش هو الأهمّ! لكمة الخضراوات! خذ هذه

274
00:19:33,980 --> 00:19:34,560
.الوحش العنيف

275
00:19:37,580 --> 00:19:39,750
!أنت! كان ذلك عصير الخضراوات

276
00:19:41,130 --> 00:19:43,240
!لِمَ قد أعطي الأولويّة للصّحّة الآن أيّها الوغد؟

277
00:19:43,240 --> 00:19:45,120
!أعطني الكولا

278
00:19:45,370 --> 00:19:47,200
.لم يرد الكولا لأنّه عطش إذًا

279
00:19:48,300 --> 00:19:51,160
...يويوي! الباب

280
00:19:51,160 --> 00:19:51,960
!خذ

281
00:19:52,240 --> 00:19:53,420
!شكرًا

282
00:19:56,800 --> 00:20:00,380
!أشعر بخير

283
00:20:00,980 --> 00:20:03,340
...حسنًا

284
00:20:03,570 --> 00:20:05,110
.دعني أجلس

285
00:20:05,110 --> 00:20:08,400
.انتهى عملي في الحقل الآن

286
00:20:08,400 --> 00:20:10,000
.كفاكم غضبًا

287
00:20:10,000 --> 00:20:11,310
.لا تقاتلوا

288
00:20:11,780 --> 00:20:13,910
ما رأيكم بشرب بعض الشّاي؟

289
00:20:13,910 --> 00:20:15,400
...ما كان الشّاي

290
00:20:15,830 --> 00:20:18,320
!ليمنحني الطّاقة! أيّها البليد

291
00:20:20,120 --> 00:20:22,150
.إنّه... مضحك

292
00:20:22,500 --> 00:20:23,360
!أنت

293
00:20:23,360 --> 00:20:27,810
لِمَ يبدو من تعبيرك وكأنّك تتساءل كيف
!ستكون النّتيجة مع المشروبات الأخرى؟

294
00:20:28,590 --> 00:20:30,540
!هذه فرصتك الأخيرة أيّها الغزال اللّعين

295
00:20:30,970 --> 00:20:32,970
إذًا لا يعتمد الأمر على مشاعرك؟

296
00:20:32,970 --> 00:20:34,120
!أحتاج الكولا فقط

297
00:20:36,190 --> 00:20:39,210
!إنّها الكولا! لا شكّ في ذلك

298
00:20:39,600 --> 00:20:40,840
!شكرًا

299
00:20:43,600 --> 00:20:47,440
لا أدري ما الأمر، لكنّي لن أدعك
!تفعل ما يحلو لك

300
00:20:47,680 --> 00:20:48,690
!ساق العاصفة

301
00:20:50,520 --> 00:20:51,640
!فرانكي

302
00:21:02,360 --> 00:21:05,970
!خارق

303
00:21:30,190 --> 00:21:32,780
تشابابا... ما الأمر؟

304
00:21:32,780 --> 00:21:35,390
.ليس وكأنّ شرب الكولا سيحدث أيّ تغيير

305
00:21:38,370 --> 00:21:39,360
.احمِ نفسك

306
00:21:39,950 --> 00:21:42,180
.تشابا؟ يا لك من أحمق

307
00:21:42,330 --> 00:21:45,320
هل ستضربني بلكمة تافهة أخرى؟

308
00:21:45,830 --> 00:21:49,070
!المطرقة... القويّة

309
00:22:08,180 --> 00:22:10,090
!مذهل

310
00:22:29,470 --> 00:22:31,140
.آسف

311
00:22:31,540 --> 00:22:34,040
...كانت لكماتي في السّابق

312
00:22:34,490 --> 00:22:36,950
.تافهة بالفعل

313
00:22:45,490 --> 00:22:47,680
زورو-كن، ما فكرتك لنزع هذه الأصفاد؟

314
00:22:47,680 --> 00:22:50,360
،نعم. بما أنّ الوضع آل إلى هذا
سنلعب حجر-ورقة-مقص

315
00:22:50,360 --> 00:22:52,020
...لنقرّر أيّ معصم سنقوم بحزم بـ

316
00:22:52,020 --> 00:22:54,060
!ماذا دهاك تأتي بفكرة مخيفة كهذه؟

317
00:22:54,060 --> 00:22:55,020
!يستحيل أن نفعل ذلك

318
00:22:55,020 --> 00:22:56,150
حقًّا؟

319
00:22:56,150 --> 00:22:58,020
.إذًا، لديّ فكرة أخرى

320
00:22:58,020 --> 00:23:00,240
!لا أريد سماعها

321
00:23:00,240 --> 00:23:01,600
:في الحلقة القادمة من وان بيس

322
00:23:01,600 --> 00:23:05,690
!يفجّر زورو تقنيته الجديدة
اسم السّيف هو سوغيكينغ؟

323
00:23:05,690 --> 00:23:08,120
!ملك القراصنة، لن يكون إلاّ أنا

324
00:23:10,070 --> 00:23:15,120
نلقاكم في الحلقة القادمة