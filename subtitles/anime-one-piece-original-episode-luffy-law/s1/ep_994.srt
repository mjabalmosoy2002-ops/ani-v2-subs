1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:12,600 --> 00:02:17,890
"!مواجهة الأكازايا! كيكونوجو ضدّ كانجورو"

29
00:02:25,410 --> 00:02:26,920
...يا إلهي

30
00:02:27,410 --> 00:02:28,960
!بيغ مام؟

31
00:02:31,790 --> 00:02:35,170
.مرحبًا بعودتك يا زوس

32
00:02:35,170 --> 00:02:37,280
...ما... ما

33
00:02:37,280 --> 00:02:38,300
!ماما

34
00:02:41,380 --> 00:02:44,850
!تبدو مخيفة جدًّا عن قرب

35
00:02:44,850 --> 00:02:47,680
!إنّها أقوى شمطاء في العالم

36
00:02:52,610 --> 00:02:53,900
!زوس

37
00:02:54,980 --> 00:02:55,690
!نامي؟

38
00:02:56,250 --> 00:02:57,740
!أمسكوا بهم؟

39
00:02:59,200 --> 00:03:02,450
!أتيتِ أخيرًا يا لينلين

40
00:03:02,450 --> 00:03:05,080
!ما الّذي أخّرك؟

41
00:03:05,320 --> 00:03:08,810
!لا تكن متشدّدًا يا كايدو

42
00:03:08,810 --> 00:03:11,090
.وصلت في الوقت المناسب

43
00:03:16,250 --> 00:03:18,800
،كما قال كايدو

44
00:03:18,800 --> 00:03:23,640
!لقد شكّلنا تحالفًا لسبب وجيه

45
00:03:24,170 --> 00:03:25,760
سبب وجيه؟

46
00:03:25,760 --> 00:03:28,910
،إن كنّا على خصام دائمًا فيما بيننا
،فسيكون بعيدًا عن متناولنا

47
00:03:28,910 --> 00:03:32,480
!لكن إن وحّدنا جهودنا، فسيكون في متناولنا سلفًا

48
00:03:32,480 --> 00:03:34,900
!أهذا مفهوم؟

49
00:03:34,900 --> 00:03:38,510
!سنركّز على القرصنة

50
00:03:38,510 --> 00:03:40,740
...سوف نضع

51
00:03:40,740 --> 00:03:43,530
...أيدينا أخيرًا

52
00:03:46,240 --> 00:03:49,330
!على كنز وان بيس العظيم

53
00:03:55,710 --> 00:03:57,460
...الوان بيس

54
00:03:58,020 --> 00:04:00,970
!ذلك شيء أنا من سيحصل عليه

55
00:04:00,970 --> 00:04:03,130
!يا لهما من وغدين

56
00:04:04,550 --> 00:04:07,620
...إنّ وجود الأسلحة القديمة

57
00:04:07,620 --> 00:04:11,980
!سيجلب معه الخوف والحرب في هذا العالم

58
00:04:12,310 --> 00:04:14,310
!جهّزوا أنفسكم

59
00:04:14,310 --> 00:04:20,030
!ذلك هو عالم العنف الّذي نصبوا إليه

60
00:04:24,650 --> 00:04:26,570
...الأسلحة القديمة

61
00:04:26,570 --> 00:04:31,930
قيل أنّ ثلاثة منها موجودة
...وهي تحمل أسماء آلهة

62
00:04:31,930 --> 00:04:33,250
.بلوتون

63
00:04:34,580 --> 00:04:36,130
.أورانوس

64
00:04:37,410 --> 00:04:39,710
.بوسيدون

65
00:04:39,710 --> 00:04:46,470
إن حصلا على هذه القوّة، فسيفقد
.العالم توازنه وسيتّجه نحو دماره

66
00:04:47,010 --> 00:04:48,930
هل الأمر خطير لتلك الدّراجة؟

67
00:04:48,930 --> 00:04:50,390
.بكلّ تأكيد

68
00:04:53,270 --> 00:04:55,150
!هذا حماسيّ

69
00:04:56,730 --> 00:05:01,280
!لذلك استمعوا يا أتباع أوروتشي

70
00:05:02,320 --> 00:05:05,120
.عليكم أن تختاروا

71
00:05:07,030 --> 00:05:09,070
نختار ماذا؟

72
00:05:11,240 --> 00:05:13,330
...هذه البلاد

73
00:05:13,330 --> 00:05:17,480
،حصن طبيعيّ تحيط به الشّلاّلات

74
00:05:17,480 --> 00:05:21,320
وهو ما يمنع البحريّة وحكومة
.العالم من اقتحامها بسهولة

75
00:05:21,320 --> 00:05:24,300
،إن بنينا المزيد من مصانع الأسلحة

76
00:05:25,880 --> 00:05:29,780
،وأجبرنا حتّى سكّان عاصمة الزّهور على العمل

77
00:05:29,780 --> 00:05:35,890
،فسيصير هذا المكان أرضًا بلا قانون
!فردوسًا للقراصنة

78
00:05:43,610 --> 00:05:47,030
كايدو-ساما... ماذا تعني؟

79
00:05:47,030 --> 00:05:48,990
.أنا واثق أنّكم سمعتموني

80
00:05:51,280 --> 00:05:52,910
...أنت

81
00:05:55,240 --> 00:05:56,580
!أنت

82
00:05:56,580 --> 00:05:59,730
!أيّها الوغد كايدو

83
00:05:59,730 --> 00:06:03,530
!ما الّذي تتحدّث عنه؟

84
00:06:03,530 --> 00:06:07,550
!عاصمة الزّهور هي منطقتي أنا

85
00:06:08,170 --> 00:06:11,390
،فقط لأنّني من الكوروزومي

86
00:06:11,590 --> 00:06:15,270
...فهل تعلم... هل تعلم كم من الألم

87
00:06:15,350 --> 00:06:20,020
تسبّبت به عشيرة كوزكي لي طوال
!كلّ هذه السّنوات؟

88
00:06:20,560 --> 00:06:25,050
،لقد ظُلمتُ وكُرهتُ فقط لأنّني ما زلت حيًّا

89
00:06:25,050 --> 00:06:29,700
!وقد سلبوني كلّ شيء

90
00:06:32,780 --> 00:06:34,740
!الضّغينة ضدّ عشيرة كوزكي

91
00:06:34,740 --> 00:06:37,140
!وضدّ بلاد وانو

92
00:06:37,140 --> 00:06:40,870
...والرّغبة في الانتقام منهم جميعًا

93
00:06:40,870 --> 00:06:45,590
!ذلك ما كان يدفعني كلّ هذا الطّريق

94
00:06:46,750 --> 00:06:52,450
!بطريقة ما، عاصمة الزّهور هي رمز ثأر عشيرة كوروزومي

95
00:06:52,450 --> 00:06:55,700
...أراضيهم وحياتهم

96
00:06:55,700 --> 00:06:59,060
!كلّها لي أنا

97
00:07:00,140 --> 00:07:01,940
...حتّى أنت

98
00:07:01,940 --> 00:07:07,200
!لا يمكنك العبث بها كما يحلو لك

99
00:07:16,080 --> 00:07:18,040
!هل تسمعني؟

100
00:07:18,990 --> 00:07:24,980
سأجعل أشقياء عشيرة كوزكي
،الّذين عذّبوا عشيرة كوروزومي يركعون

101
00:07:24,980 --> 00:07:31,090
،ولمنعهم من التّمرّد عليّ
!سأستعرض الأهوال أمامهم

102
00:07:31,090 --> 00:07:36,100
!لأبد الآبدين

103
00:07:36,100 --> 00:07:38,950
!أنا من سيدمّر بلاد وانو

104
00:07:38,950 --> 00:07:42,580
!هذه البلاد لي

105
00:07:42,580 --> 00:07:46,610
!الزم حدودك يا كايدو

106
00:07:46,610 --> 00:07:49,070
!أنت هنا منذ وقت قصير فحسب

107
00:07:54,550 --> 00:07:59,200
!لا يمكن أن تتواجد بلاد وانو بدوني
!آمل أنك مدرك لذلك

108
00:08:04,580 --> 00:08:07,040
.أرى أنّك تفهم

109
00:08:07,040 --> 00:08:09,030
...ما علينا فعله الآن

110
00:08:09,030 --> 00:08:12,050
...هو قتل ذاك الشّقيّ هناك

111
00:08:52,500 --> 00:08:54,470
!لا أهتمّ

112
00:08:54,470 --> 00:08:57,590
!ما عدنا بحاجته

113
00:09:24,700 --> 00:09:26,420
!هراء

114
00:09:30,540 --> 00:09:32,800
...بالنّسبة لي

115
00:09:37,590 --> 00:09:39,260
...كلّ من عشيرة كوروزومي

116
00:09:39,760 --> 00:09:41,760
...وعشيرة كوزكي

117
00:09:44,980 --> 00:09:47,770
!لا يعنيان شيئًا

118
00:10:05,530 --> 00:10:06,580
!مومو

119
00:10:06,580 --> 00:10:09,000
!ذاك هو مومو

120
00:10:09,920 --> 00:10:11,790
!مومو، انتظرني

121
00:10:11,790 --> 00:10:13,420
!أنت، أخفض صوتك

122
00:10:18,380 --> 00:10:20,510
!ما هذا؟

123
00:10:20,510 --> 00:10:22,220
!ما الّذي حدث؟

124
00:10:24,470 --> 00:10:26,940
!كايدو

125
00:10:27,520 --> 00:10:29,730
!أيّها المغفّل! ما الّذي تفعله؟

126
00:10:30,270 --> 00:10:33,270
!اسمع! علينا أن ننقذ مومو

127
00:10:33,270 --> 00:10:34,860
!أرني الطّريق

128
00:10:34,860 --> 00:10:36,740
!حـ-حسنًا

129
00:10:37,730 --> 00:10:40,700
!ياماتو-ساما! توقّف رجاءً

130
00:10:42,070 --> 00:10:45,250
!أنا قادم إليك يا مومو

131
00:11:24,620 --> 00:11:25,240
!ماذا؟

132
00:11:34,330 --> 00:11:38,300
،أعلم عاداتك في المسايفة

133
00:11:38,710 --> 00:11:41,470
!لكنّك لا تعرفين تقنياتي، صحيح؟

134
00:12:08,450 --> 00:12:11,580
!اقضي عليه يا كيكو

135
00:12:16,540 --> 00:12:20,980
...أ-أوكيكو، أنا آسف

136
00:12:20,980 --> 00:12:27,450
...أستطيع العيش فقط كعضو من عشيرة كوروزومي

137
00:12:27,450 --> 00:12:30,440
!لذلك اقتليني بسرعة

138
00:12:31,390 --> 00:12:37,910
ما زلت أذكر الأيّام الّتي قضيناها
...معًا كالأشقّاء

139
00:12:37,910 --> 00:12:42,090
...كان العيش وأنا أخدعك

140
00:12:42,090 --> 00:12:45,400
!مؤلمًا لي على الدّوام

141
00:12:45,400 --> 00:12:52,020
أعتقد فعلاً أنّني قمت بأمور فظيعة
...لمومونوسكي-ساما أيضًا

142
00:12:52,020 --> 00:12:55,120
،وُلدت من عائلة كوروزومي

143
00:12:55,120 --> 00:12:58,800
...ولا يمكنني العيش إلاّ كذلك

144
00:12:59,710 --> 00:13:01,800
!سامحيني

145
00:13:02,630 --> 00:13:06,070
...أنا

146
00:13:06,590 --> 00:13:11,430
!أردت العيش جنبًا إلى جنب معكم يا رفاق

147
00:13:11,430 --> 00:13:13,640
!كيكو! قومي بذلك

148
00:13:14,850 --> 00:13:19,000
!كانجورو-سان... لم يفت الأوان بعد

149
00:13:19,310 --> 00:13:21,230
!لنطح بكايدو

150
00:13:21,230 --> 00:13:23,330
...كيف أمكنك

151
00:13:23,900 --> 00:13:26,620
...كيف أمكنك أن تصدّقي وغدًا مثلي

152
00:13:28,320 --> 00:13:30,280
...إنّك فعلاً

153
00:13:30,280 --> 00:13:31,750
!ساذجة

154
00:13:34,120 --> 00:13:36,040
!كيكو

155
00:13:38,920 --> 00:13:41,880
.أخبرني أنّ كلّ هذا كذب

156
00:13:42,500 --> 00:13:44,840
...أنّ كانجورو-سان هذا

157
00:13:45,800 --> 00:13:47,470
!مزيّف

158
00:13:47,470 --> 00:13:50,010
...أنّ كانجورو-سان الّذي أواجهه الآن

159
00:13:50,010 --> 00:13:52,180
!ما هو إلاّ متصنّع

160
00:13:53,100 --> 00:13:55,150
!أوكيكو

161
00:13:55,810 --> 00:13:56,640
!هيّا

162
00:13:56,640 --> 00:13:58,650
!ما الّذي تفعلينه؟

163
00:13:58,650 --> 00:14:02,730
!كيف تجرئين على قطعي بدم بارد وأنا كأخ لك؟

164
00:14:03,230 --> 00:14:08,070
!هذه الخيانة مؤلمة للغاية
!سأجعلك تدفعين الثّمن

165
00:14:08,070 --> 00:14:09,110
!أنت الخائن

166
00:14:09,110 --> 00:14:12,410
!أين يقبع قلبك الحقيقيّ؟

167
00:14:12,410 --> 00:14:15,950
!من تكون أنت؟

168
00:14:19,040 --> 00:14:25,280
كانجورو-سان الّذي ضحك وبكى
...معنا في تلك الأيّام

169
00:14:25,280 --> 00:14:26,970
!أعده لنا

170
00:14:29,130 --> 00:14:32,480
!ماذا؟! مستحيل

171
00:14:32,480 --> 00:14:37,430
...ظننتُ أنّنا سنكون أصدقاء مهما كان

172
00:14:37,430 --> 00:14:40,650
!لم أصدّق ذلك من الأساس

173
00:14:40,650 --> 00:14:43,690
!ما أمامك الآن هو أنا على حقيقتي

174
00:14:43,690 --> 00:14:45,440
...حياتي كعضو من الأكازايا

175
00:14:45,440 --> 00:14:47,780
!كانت مجرّد تمثيل

176
00:14:47,780 --> 00:14:51,740
!لم أتشارك أيّ أفراح أو أحزان معكم

177
00:14:52,200 --> 00:14:55,700
!لا أهتمّ إطلاقًا لكم

178
00:14:55,700 --> 00:14:58,000
!قمتُ بكلّ شيء من أجل عشيرة كوروزومي

179
00:14:58,000 --> 00:14:58,960
!فموتي

180
00:15:03,000 --> 00:15:06,130
!انظروا لهذا

181
00:15:06,130 --> 00:15:09,680
!هذا العرض المذهل الضّخم

182
00:15:11,760 --> 00:15:14,380
...كان كلّ شيء مزيّفًا

183
00:15:14,800 --> 00:15:17,460
...كلّ حياتك كانت تمثيلاً

184
00:15:18,020 --> 00:15:22,560
...عشتَ مؤدّيًا دورك فحسب

185
00:15:25,400 --> 00:15:27,440
!لم تكن حياتي مزيّفة

186
00:15:27,440 --> 00:15:31,970
...بل كنت أعيش لأداء دوري طوال حياتي

187
00:15:32,450 --> 00:15:35,870
،إن كنت قد أثرت عاطفتك

188
00:15:35,870 --> 00:15:38,200
!فأنا أشعر بالفخر لأنّني ممثّل جيّد

189
00:15:40,660 --> 00:15:41,750
!ماذا؟

190
00:15:50,550 --> 00:15:52,180
...لقد قطعتُ

191
00:15:52,180 --> 00:15:55,970
!قلبي أنا الّذي كان يحاول تصديقك

192
00:15:56,390 --> 00:15:59,400
!انتهت هذه المهزلة

193
00:16:00,680 --> 00:16:04,900
.كنتُ أتمنّى لو قلتَ أنّ خيانتك كانت تمثيلاً

194
00:16:05,440 --> 00:16:10,410
...لن نتمكّن أبدًا من رؤية كانجورو-سان الّذي عهدناه

195
00:16:11,900 --> 00:16:15,530
...الأفراح والأحزان الّتي تشاركناها

196
00:16:15,530 --> 00:16:17,480
!كانت مجرّد وهم

197
00:16:17,950 --> 00:16:20,750
...كانجرو-سان الّذي عرفتُه

198
00:16:20,750 --> 00:16:22,330
!كان مجرّد رسمة

199
00:16:22,830 --> 00:16:25,250
.ليس لديك أيّ أحد لتودّعه

200
00:16:26,130 --> 00:16:27,630
...في تلك الحالة

201
00:16:27,630 --> 00:16:30,050
!في تلك الحالة، لن أرحمك

202
00:16:32,300 --> 00:16:35,340
!ممتاز! هذا تغيّر أحداث غير متوقّع

203
00:16:43,100 --> 00:16:45,310
!سيف الثّلج المتساقط

204
00:16:52,070 --> 00:16:54,490
!بإمكاني توقّع كلّ حركاتك

205
00:16:59,240 --> 00:17:01,660
!هذه حركة بسيطة

206
00:17:01,660 --> 00:17:06,170
!أوكيكو، ما زلت طيّبة كعادتك

207
00:17:07,290 --> 00:17:10,590
!الرّجل الّذي أمامي ليس كانجورو

208
00:17:11,130 --> 00:17:12,920
...كانجورو-سان

209
00:17:12,920 --> 00:17:14,300
!ما عاد موجودًا

210
00:17:16,130 --> 00:17:18,010
!لماذا؟

211
00:17:19,890 --> 00:17:21,640
!لماذا؟

212
00:17:22,020 --> 00:17:24,730
!قلتَ أنّ كلّ شيء كان تمثيلاً

213
00:17:25,600 --> 00:17:27,850
!ظننت أنّنا أصدقاء

214
00:17:27,850 --> 00:17:30,900
!أخبرني يا كانجورو

215
00:17:31,650 --> 00:17:34,900
!لماذا؟

216
00:17:44,700 --> 00:17:46,750
...ممتاز

217
00:17:46,750 --> 00:17:51,000
!ممتاز! أحسنت يا أوكيكو

218
00:17:51,000 --> 00:17:53,300
....كنتُ أبحث عن

219
00:17:53,300 --> 00:17:55,920
!مكان لأموت فيه

220
00:17:57,720 --> 00:17:59,090
...إن

221
00:17:59,840 --> 00:18:00,600
...أمكنني

222
00:18:01,430 --> 00:18:04,720
،الموت على مسرح ضخم

223
00:18:05,560 --> 00:18:08,020
!فسأكون بغاية السّعادة

224
00:18:11,110 --> 00:18:12,360
!هذا مثاليّ

225
00:18:14,570 --> 00:18:16,110
!جيّد

226
00:18:16,110 --> 00:18:18,320
...يراودني شعور

227
00:18:18,320 --> 00:18:19,910
!رائع

228
00:18:49,480 --> 00:18:51,020
...كين-سان

229
00:18:51,310 --> 00:18:53,860
.نعم. لنذهب

230
00:18:53,860 --> 00:18:57,070
!كينييمون-دونو! دنجيرو-دونو

231
00:18:57,070 --> 00:18:58,530
!بالتّوفيق

232
00:18:59,110 --> 00:19:00,570
!ولكم أيضًا

233
00:19:32,520 --> 00:19:35,230
!ليس من العدل مهاجمتي من الخلف

234
00:19:35,230 --> 00:19:38,690
!يا كاواماتسو! تلك فرشاتي

235
00:19:38,690 --> 00:19:40,240
!مهلاً، مهلاً

236
00:19:40,240 --> 00:19:42,700
!كونوا لطفاء مع بعضكم

237
00:19:45,830 --> 00:19:48,240
!لا مال لدينا يا أودن-ساما

238
00:19:48,240 --> 00:19:49,200
!ماذا؟

239
00:19:49,580 --> 00:19:51,920
!ولا طعام لدينا للعشاء

240
00:19:51,920 --> 00:19:54,290
!لا عشاء اليوم أيضًا يا أودن-ساما؟

241
00:19:54,290 --> 00:19:56,630
!هيّا سامحني

242
00:19:56,630 --> 00:20:01,090
!حسنًا، لديكم عمل لتقوموا به
!توسّلوا من أجل الطّعام في البلدة

243
00:20:01,090 --> 00:20:02,010
!ثانية؟

244
00:20:02,010 --> 00:20:05,220
!لم أسمع دايميو يقول ذلك من قبل

245
00:20:05,220 --> 00:20:07,890
.معك حقّ. ولا أنا

246
00:20:28,660 --> 00:20:31,040
.اسمي كانجورو

247
00:20:31,370 --> 00:20:33,960
!اسمي كينييمون! سررت بلقائك

248
00:20:34,420 --> 00:20:38,630
.نحبّ كلانا أودن-سان، لذلك سنكون على وفاق

249
00:20:40,050 --> 00:20:42,380
!نعم، يبدو ذلك جيّدًا

250
00:20:43,800 --> 00:20:47,390
.لا بدّ أنّه كان أمرًا صعبًا يا رفاق

251
00:20:48,260 --> 00:20:49,850
...كين-سان

252
00:20:52,600 --> 00:20:55,230
.لنواصل التّقدّم للأمام الآن

253
00:20:55,810 --> 00:20:57,400
...إيزو

254
00:21:03,360 --> 00:21:07,070
ألا بأس أن تموت هنا؟

255
00:21:07,070 --> 00:21:10,450
.لا أريد أن أفوّت فرصة أخرى للموت

256
00:21:12,620 --> 00:21:14,660
.حسنًا. هيّا بنا

257
00:21:18,080 --> 00:21:19,420
.أوكيكو

258
00:21:49,320 --> 00:21:52,700
.وها قد ماتت الذّبابة الّتي كانت منجذبة للقراصنة

259
00:21:52,700 --> 00:21:57,460
!قرّروا ما العمل خلال خمس ثوانٍ يا رجال أوروتشي

260
00:21:57,790 --> 00:22:01,420
أتريدون أن تصيروا قراصنة وتتبعوني؟

261
00:22:01,420 --> 00:22:05,130
!أم تريدون أن تتحدّونا هنا وتموتون؟

262
00:22:05,590 --> 00:22:09,390
،بغرض الاستعداد للحرب العالميّة القادمة

263
00:22:09,390 --> 00:22:14,180
!سأحوّل هذه البلاد إلى إمبراطوريّة قراصنة

264
00:22:16,020 --> 00:22:19,600
.سنخرج في استكشافات أكثر من أجل أعمالنا الأساسيّة

265
00:22:20,480 --> 00:22:21,400
،لذلك فاللّيلة

266
00:22:21,400 --> 00:22:24,780
،سننقل أونيغاشيما هذه إلى عاصمة الزّهور

267
00:22:24,780 --> 00:22:27,030
!وستسقط بلاد وانو

268
00:22:27,700 --> 00:22:29,410
!ذلك الوغد

269
00:22:29,410 --> 00:22:32,870
.سأعيد تسمية هذه البلاد بأونيغاشيما الجديدة

270
00:22:32,870 --> 00:22:35,950
...والشّوغن الجديد لها هو ابني

271
00:22:35,950 --> 00:22:38,000
!ياماتو

272
00:22:41,040 --> 00:22:42,920
...ما الّذي

273
00:22:44,050 --> 00:22:48,050
!قاله للتّوّ؟

274
00:22:54,430 --> 00:22:56,470
!لا يمكنك إجباري على ذلك

275
00:22:56,930 --> 00:22:59,230
!أيّها الأب الفظيع

276
00:22:59,690 --> 00:23:02,400
!بسرعة! سيُقتل مومو هكذا

277
00:23:02,400 --> 00:23:04,150
!حسنًا! لنأخذ طريقًا مختصرًا

278
00:23:04,150 --> 00:23:04,940
!حسنًا

279
00:23:18,120 --> 00:23:23,840
بعد 20 سنة من اليأس، يتقدّم الأكازايا
!التّسعة للهجوم مطيحين بالأعداء

280
00:23:23,840 --> 00:23:25,960
!الهدف هو عدوّهم اللّدود كايدو

281
00:23:25,960 --> 00:23:28,710
ومومونوسكي الّذي يرتعد وهو على
.وشك أن يُعدم يواجه قرارًا صعبًا

282
00:23:28,710 --> 00:23:33,220
،ومن أجل بلاد وانو وعشيرة كوزكي
!أقسموا بالأرض والسّماء

283
00:23:33,220 --> 00:23:35,930
!راهنوا بحياتكم على هذه الضّربة

284
00:23:36,560 --> 00:23:40,690
:في الحلقة القادمة من وان بيس
"!غارة! إرادة أودن الموروثة"

285
00:23:40,690 --> 00:23:44,480
!ملك القراصنة، لن يكون إلاّ أنا