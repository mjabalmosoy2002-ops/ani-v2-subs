1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:13,880 --> 00:02:18,180
!لوفي-دونو! يا لسروري
!أنا جدّ مسرور بقدومك

29
00:02:18,680 --> 00:02:23,950
في ليلة مهرجان النّار، بعد أن عرفوا
،أنّ رفيقهم كانجورو هو جاسوس العدوّ

30
00:02:23,950 --> 00:02:27,910
،بدا وكأنّ كلّ آمال ساموراي الأكازايا قد فقدت

31
00:02:27,910 --> 00:02:31,670
!لكنّ لوفي وبقيّة القراصنة أتوا بنصر لهم

32
00:02:31,670 --> 00:02:33,960
!لماذا مجموعة لوفي هنا؟

33
00:02:33,960 --> 00:02:37,870
!ليس هم فحسب، سمعتُ أنّ لو كان محبوسًا

34
00:02:39,220 --> 00:02:41,180
!أنا آسف يا لوفي-دونو

35
00:02:41,970 --> 00:02:45,430
...تسرّبت خطّتنا بالكامل

36
00:02:45,430 --> 00:02:47,810
!هل علينا القتال من دونهم؟

37
00:02:47,810 --> 00:02:50,390
!ماذا؟! مستحيل

38
00:02:50,390 --> 00:02:54,000
!ما زال هنالك أمر واحد لم نخبركم به

39
00:02:54,000 --> 00:02:58,530
آسف. لم نكن نودّ إغراقكم
...في المزيد من اليأس

40
00:02:58,970 --> 00:03:00,280
!ماذا؟

41
00:03:00,680 --> 00:03:05,030
وليمة اليوم ليست مجرّد وليمة أخرى
...في ليلة مهرجان النّار

42
00:03:05,030 --> 00:03:07,790
...إنّها وليمة للاحتفال أيضًا

43
00:03:07,790 --> 00:03:13,030
بالتّحالف بيننا نحن قراصنة مملكة الحيوان
!وقراصنة بيغ مام المشهورين

44
00:03:14,740 --> 00:03:17,300
!اخرسا! سأنافسكما

45
00:03:48,620 --> 00:03:50,690
!الرّجل الواثب

46
00:03:58,530 --> 00:04:00,380
!طلقة الحَقن

47
00:04:25,930 --> 00:04:28,240
!سفينة عائلة كيوشيرو

48
00:04:28,240 --> 00:04:30,490
!لقد حضر كيوشيرو

49
00:04:30,490 --> 00:04:32,940
!أنا في مأمن الآن

50
00:04:33,400 --> 00:04:35,870
.يبدو أنّكم في ورطة

51
00:04:35,870 --> 00:04:38,670
ما الّذي بإمكاني فعله للمساعدة؟

52
00:04:42,030 --> 00:04:43,010
!كلاّ

53
00:05:00,090 --> 00:05:01,320
...ذلك الرّجل

54
00:05:01,680 --> 00:05:04,490
ما الّذي يدور في باله؟

55
00:05:11,310 --> 00:05:15,460
"!حظّ موفّق؟! خطّة القائد كينييمون"

56
00:05:20,400 --> 00:05:23,340
!ما الّذي تفعله أيّها الزّعيم-سان؟

57
00:05:35,770 --> 00:05:37,230
!ما الّذي يحدث؟

58
00:05:40,550 --> 00:05:42,520
.لم أكن أريد إغراق السّفينة

59
00:05:42,520 --> 00:05:46,820
.لذلك عطّلتُ المدافع الموجّهة لنا فحسب

60
00:05:46,820 --> 00:05:49,320
!ما-ما الّذي يحدث؟

61
00:05:49,320 --> 00:05:52,330
!كونوا حذرين! مهاراته لا يستهان بها

62
00:05:52,330 --> 00:05:54,500
!إنّه كلب الشّوغن

63
00:05:54,500 --> 00:05:59,110
!إنّه الياكوزا الّذي أخذ مكان الزّعيم هيوغورو

64
00:06:00,940 --> 00:06:03,490
!يا ساموراي الأكازايا

65
00:06:03,700 --> 00:06:09,930
،أنا ياكوزا من عاصمة الزّهور
!يناديني النّاس بكيوشيرو الغافي

66
00:06:10,160 --> 00:06:16,100
تضمّ عائلة كيوشيرو 200 محارب
!ونودّ مساعدتكم في غارتكم

67
00:06:17,600 --> 00:06:18,820
!ماذا؟

68
00:06:19,080 --> 00:06:20,310
!لا بدّ أنّك تمزح أيّها الزّعيم

69
00:06:20,310 --> 00:06:22,420
أيريد الانضمام إلينا؟

70
00:06:22,420 --> 00:06:24,780
.ظننتُ أنّه عدوّنا

71
00:06:24,780 --> 00:06:26,320
...ذلك ما يفترض أن يكون

72
00:06:33,980 --> 00:06:35,370
ما الّذي يريده؟

73
00:06:35,370 --> 00:06:40,360
!ما الّذي تعنيه؟! أنت تابع أوروتشي
!ما الجميل الّذي تدين لنا به؟

74
00:06:43,530 --> 00:06:48,300
أنا مدين لعشيرة كوزكي بأعداد
...لا تحصى من الجمائل والدّيون

75
00:06:51,290 --> 00:06:54,220
!تخطر على بالي كثيرًا يا كين-سان

76
00:06:55,000 --> 00:06:56,390
!كين-سان؟

77
00:06:56,390 --> 00:07:00,770
حادثة إله الجبل الّتي وقعت
!في العاصمة قبل 40 سنة

78
00:07:04,190 --> 00:07:08,320
...ظنّ النّاس أنّ أودن-ساما فقد صوابه فحسب

79
00:07:08,320 --> 00:07:10,070
.لكنّ الأمر ليس كذلك

80
00:07:10,070 --> 00:07:17,370
حدث ذلك بسبب طمعك في صغرك
!عندما حاولتَ بيع الخنزير الصّغير

81
00:07:37,920 --> 00:07:40,210
!شلاّل الفردوس

82
00:07:46,800 --> 00:07:48,030
ماذا؟

83
00:07:48,030 --> 00:07:51,240
!ثمّة شخص واحد فقط يعلم بذلك الأمر

84
00:07:53,240 --> 00:07:56,060
!لهذا السّبب يسمّونه إله الجبل

85
00:07:56,060 --> 00:07:57,280
!ماذا؟

86
00:07:57,280 --> 00:08:01,690
!...كلاّ! كان خطئي أنّ العاصمة قد

87
00:08:03,400 --> 00:08:04,750
...لا يُعقل

88
00:08:05,030 --> 00:08:06,740
!هل أنت دنجيرو؟

89
00:08:06,740 --> 00:08:07,600
!ماذا؟

90
00:08:07,620 --> 00:08:08,380
!دنجيرو-سان؟

91
00:08:12,370 --> 00:08:14,160
!دنجيرو

92
00:08:14,760 --> 00:08:16,640
...الكثير من الأعداء

93
00:08:16,640 --> 00:08:18,960
!ساعدني يا أشورا

94
00:08:18,960 --> 00:08:19,850
!حسنًا

95
00:08:28,400 --> 00:08:31,680
!دنجيرو! أشورا

96
00:08:32,340 --> 00:08:35,160
!تقدّم يا كينييمون

97
00:08:35,160 --> 00:08:39,520
احمل مستقبل حلم عشيرة كوزكي
!وأودن-ساما على عاتقك

98
00:08:43,830 --> 00:08:46,780
...أنت حيّ

99
00:09:12,630 --> 00:09:17,780
هذا صحيح! أنا من أتباع عشيرة كوزكي
!وواحد من الأكازايا التّسعة

100
00:09:17,780 --> 00:09:19,850
!دنجيرو

101
00:09:22,410 --> 00:09:24,900
!ما-ماذا؟

102
00:09:25,770 --> 00:09:28,480
...أعتقد أنّ التّعرّف إليّ صعب

103
00:09:28,880 --> 00:09:33,840
،عندما أُبغلتُ بعودة كين-سان والبقيّة
،أردت أن آتي إليكم في الحال

104
00:09:33,840 --> 00:09:37,570
.ظللتُ عدوًّا لكم من  باب الحيطة

105
00:09:37,570 --> 00:09:40,430
،وطبعًا إذا كنت قد كشفت هويّتي

106
00:09:40,430 --> 00:09:45,310
لكان الجاسوس قد كشف أمري
!ولكان أوروتشي قد قضى عليّ

107
00:09:46,840 --> 00:09:48,170
!دنجيرو

108
00:09:48,170 --> 00:09:49,630
!اخرس

109
00:09:50,060 --> 00:09:53,690
ولكن، بما أنّني واصلت كسب ثقة
،أوروتشي حتّى النّهاية

110
00:09:53,690 --> 00:09:58,740
تمكّنت من تحرير ألف ساموراي
!في سجن بلدة راستسو

111
00:09:58,740 --> 00:10:00,020
!انظروا هناك

112
00:10:00,050 --> 00:10:01,950
!تعزيزات للأعداء؟

113
00:10:02,310 --> 00:10:04,370
.كلاّ، ليسوا كذلك

114
00:10:08,480 --> 00:10:10,110
...تلك العلامات

115
00:10:17,220 --> 00:10:18,370
...لا يُعقل

116
00:10:18,370 --> 00:10:19,970
!شعارات عشائر السّاموراي

117
00:10:24,290 --> 00:10:28,920
!ما مجموعه 1200 محارب! نحن معكم

118
00:10:34,820 --> 00:10:38,530
!أتى هذا اليوم أخيرًا! سيتسنّى لنا القتال

119
00:10:38,530 --> 00:10:42,930
!الـ-الزّعيم كيوشيرو واحد من الأكازايا؟

120
00:10:42,930 --> 00:10:45,310
!اتّصلوا بأونيغاشيما حالاً

121
00:10:45,310 --> 00:10:47,080
!حا-حاضر

122
00:10:59,030 --> 00:11:00,950
...دنجيرو

123
00:11:00,950 --> 00:11:02,980
!الآن يا كين-سان

124
00:11:02,980 --> 00:11:05,640
!يا لك من رجل ذكيّ

125
00:11:05,640 --> 00:11:10,270
!تشير العلامة إلى تاريخ ومكان اللّقاء للمعركة الكبيرة

126
00:11:10,270 --> 00:11:12,650
...طائران محترقان

127
00:11:12,880 --> 00:11:14,820
...وهابو، أي أفعى حفر، و

128
00:11:14,820 --> 00:11:18,940
!هلالٌ معكوس يرمز للثّورة

129
00:11:18,940 --> 00:11:22,810
.في يوم مهرجان النّار"
.الشّفق، ساعة الطّائر الثّانية

130
00:11:22,810 --> 00:11:25,240
".عند ميناء هابو

131
00:11:25,240 --> 00:11:28,190
.لم تكن العلامة الأصليّة تحمل ذلكما الخطّين

132
00:11:29,750 --> 00:11:33,750
...سُرّب هذا المنشور لأوروتشي والبقيّة

133
00:11:34,280 --> 00:11:39,720
.لكنّ ياسويي-ساما غيّره قبل أن يموت

134
00:11:39,720 --> 00:11:42,340
...هذين الخطّين اللّذين أضيفا حديثًا

135
00:11:42,340 --> 00:11:46,200
!يقطعان الحروف الوسطى

136
00:11:46,200 --> 00:11:51,440
هذا يعني أنّ مكان اللّقاء الجديد هو
...هابوميناتو (ميناء هابو) دون الجزء الأوسط

137
00:11:51,440 --> 00:11:52,730
!أي هاتو

138
00:11:55,880 --> 00:12:01,930
لذا فإنّه الرّصيف في ميناء هابو ذو الإطلالة الممتازة
.على غابة أشجار القيقب الّتي أحبّها ياسويي-ساما

139
00:12:03,140 --> 00:12:04,030
ماذا؟

140
00:12:04,030 --> 00:12:05,910
!ماذا؟

141
00:12:05,910 --> 00:12:11,440
،بسماع وجود خطّين على هابو
.فإنّ أيّ أحد كان ليفهم الرّسالة بسهولة

142
00:12:13,460 --> 00:12:17,250
،لكنّ فكرة وجود جاسوس لأوروتشي بينكم

143
00:12:17,250 --> 00:12:22,800
!جعلتك تخبر النّاس أنّه ميناء توكاغي عمدًا

144
00:12:22,800 --> 00:12:28,010
يملك كلّ ميناء في بلاد وانو اسمًا
.قد يعني اسم حيوان أيضًا

145
00:12:28,010 --> 00:12:32,430
،قد يبدو الجسم طويلاً نوعًا ما
.لكنّ إضافة أطراف للأفعى يجعلها سحليّة

146
00:12:32,430 --> 00:12:35,210
.يقع ميناء توكاغي (سحليّة) في أودون

147
00:12:36,860 --> 00:12:41,130
.هذا صحيح، لم تبدُ تلك الصّورة كسحليّة

148
00:12:41,130 --> 00:12:45,320
...صدّقت الأمر لأنّ كين-ساما كان واثقًا جدًّا

149
00:12:45,320 --> 00:12:48,830
،وقع الجاسوس في الفخّ مباشرة

150
00:12:48,830 --> 00:12:53,650
وأخبر أوروتشي أنّ ميناء توكاغي
!هو مكان اللّقاء الجديد

151
00:12:54,270 --> 00:12:58,320
كانت حماقةَ مَن تصرّف كما يحلو له
!في العاصمة لمدّة طويلة

152
00:12:58,320 --> 00:13:03,620
أخطأ أوروتشي في تقدير المسافة بين كلّ مكان
!ولم يخطُ أيّ خطوة حتّى اللّيلة الماضية

153
00:13:04,630 --> 00:13:08,120
!سأذيقهم الجحيم

154
00:13:08,300 --> 00:13:10,310
هل وجدتم السّفينة؟

155
00:13:10,400 --> 00:13:11,100
!نعم

156
00:13:23,690 --> 00:13:28,950
لكن في ذلك الوقت، كان الجميع
،قد عبروا تلك الجسور العظيمة

157
00:13:28,950 --> 00:13:31,830
!والسّفن الّتي احتاجوها غادرت موانئها

158
00:13:31,830 --> 00:13:34,450
!كلّ ما دُمّر هي السّفن الّتي بقيت

159
00:13:34,450 --> 00:13:39,070
...كما خطّطتَ، المحاربون الـ4200 الّذين جمعتَهم

160
00:13:39,280 --> 00:13:43,200
كانوا متوارين عن الأنظار في رصيف
!ميناء هابو حتّى الوقت المناسب

161
00:13:44,400 --> 00:13:46,370
!هذا يعني أنّهم بخير؟

162
00:14:40,570 --> 00:14:45,080
حتّى بعد 20 سنة، ما زلتُ أتذكّر موت
!أودن-ساما الأسطوريّ

163
00:14:45,450 --> 00:14:49,250
!عشنا حياتنا مؤمنين بعودة عشيرة كوزكي

164
00:14:49,540 --> 00:14:52,960
!نحن قادمون معكم يا ساموراي الأكازايا

165
00:14:52,960 --> 00:14:55,520
!نحن في أهبة الاستعداد

166
00:14:57,400 --> 00:15:02,000
!خطّة الإغارة على أونيغاشيما لم تُحبط على الإطلاق

167
00:15:02,940 --> 00:15:07,420
!بإضافة 1200 من محاربينا، صرنا 5400 في المجمل

168
00:15:07,420 --> 00:15:10,120
!والآن، هيّا بنا جميعًا

169
00:15:14,220 --> 00:15:16,430
!إلى أونيغاشيما

170
00:15:22,270 --> 00:15:24,060
!ثمّة الكثير منهم

171
00:15:24,060 --> 00:15:27,930
!هذا سيّئ! هل من خبر من أونيغاشيما؟

172
00:15:27,930 --> 00:15:32,930
كنت أتّصل بهم، لكنّهم لم يلاحظوا
!بسبب انشغالهم في الوليمة

173
00:15:33,280 --> 00:15:35,660
!مهلاً، هذا رائع

174
00:15:35,660 --> 00:15:38,790
!بعد كلّ هذه المتاعب، صار لنا حلفاء أكثر

175
00:15:38,790 --> 00:15:41,770
.لكنّنا كنّا سنقوم بالأمر في كلّ الأحوال

176
00:15:41,770 --> 00:15:44,770
.كلّما زاد عددنا، كان أفضل

177
00:15:44,910 --> 00:15:47,000
.من الجيّد وجودهم معنا

178
00:15:47,000 --> 00:15:50,510
!بإمكاننا الآن هزيمة قراصنة مملكة الحيوان بسهولة

179
00:15:51,450 --> 00:15:53,120
!هذا ممتاز

180
00:15:54,620 --> 00:15:58,330
،لا أعرف ما الّذي يحدث بالتّحديد
!لكنّ كلّ شيء بخير الآن

181
00:15:58,330 --> 00:16:02,230
.لا ترخِ دفاعاتك. بيغ مام في أونيغاشيما أيضًا

182
00:16:02,230 --> 00:16:06,060
!كلاّ! لم يتغيّر أيّ شيء

183
00:16:06,060 --> 00:16:09,320
!سُحقًا لك يا كينييمون

184
00:16:09,680 --> 00:16:13,200
!كين-سان! هذا هو قائدنا

185
00:16:13,200 --> 00:16:16,200
!أنت جدير بالاحترام كما توقّعت

186
00:16:22,500 --> 00:16:24,540
!هذا هو قائدنا كينييمون-سان

187
00:16:24,540 --> 00:16:26,580
!أنت الوحيد الّذي يمكنه قيادتنا

188
00:16:26,580 --> 00:16:28,780
!سنتبعك حتّى النّهاية

189
00:16:39,040 --> 00:16:41,310
...لم يكن "توكاغي (سحليّة)" إذًا

190
00:16:41,630 --> 00:16:44,210
..."(بل "هاتو (رصيف

191
00:17:09,960 --> 00:17:13,260
.كن صريحًا يا كينييمون

192
00:17:13,260 --> 00:17:18,180
نعرف أنّك لست قادرًا على قول
.كذبة ماكرة كهذه

193
00:17:19,100 --> 00:17:22,080
.انتهى الأمر على خير
.لن نغضب منك إن اعترفت

194
00:17:22,080 --> 00:17:22,920
.توقّف

195
00:17:23,480 --> 00:17:26,540
ظننتَ فعلاً أنّه "توكاغي"، صحيح؟

196
00:17:26,540 --> 00:17:27,590
!هذا يكفي

197
00:17:27,600 --> 00:17:31,440
!لكن انتهى كلّ شيء على ما يرام
.كان خطأ محظوظًا

198
00:17:34,510 --> 00:17:38,280
!ربّما قد أموت في هذه المعركة

199
00:17:39,270 --> 00:17:42,790
!أشعر وكأنّني أنفقت حظّ عُمري بالكامل

200
00:17:44,400 --> 00:17:47,040
!أكيد، قد كنتَ محظوظًا بشكل مذهل

201
00:17:47,040 --> 00:17:48,570
!كينييمون-دونو

202
00:17:48,620 --> 00:17:50,030
!هذا هو قائدنا العزيز

203
00:17:50,030 --> 00:17:56,340
،لكن بما أنّنا نتشارك نفس الهدف
!كان لذلك نصيب من حظّنا أيضًا

204
00:17:59,720 --> 00:18:03,560
!إنّه محقّ يا كين-ساما! لن ندعك تموت وحدك

205
00:18:04,080 --> 00:18:06,640
!لقد خدمنا أودن-ساما كساموراي معًا

206
00:18:06,640 --> 00:18:11,400
،صحيح أنّنا ولدنا وتربّينا بشكل مختلف
!لكنّنا سنموت معًا! فلا تنسَ ذلك

207
00:18:19,470 --> 00:18:23,890
.لستُ سعيدًا بسماع هذا من رجال مزعجين مثلكم

208
00:18:36,110 --> 00:18:38,800
!قبلتُ مصيري

209
00:18:39,080 --> 00:18:42,040
!مرّت 20 سنة على موت أودن-ساما المأساويّ

210
00:18:42,950 --> 00:18:48,330
كانت بلاد وانو منغمسة في ظلمة
!أحلك من هذه السّماء الغائمة

211
00:18:48,810 --> 00:18:52,050
!لكن آن الأوان

212
00:18:53,130 --> 00:18:55,150
!هيّا بنا إلى أونيغاشيما

213
00:18:55,150 --> 00:18:58,280
!لنثأر من موت أودن-ساما معًا

214
00:18:59,430 --> 00:19:01,720
!كينييمون-دونو

215
00:19:01,720 --> 00:19:05,790
!سنغيّر بلاد وانو بأيّ ثمن كان

216
00:19:29,170 --> 00:19:30,370
!لنتراجع حاليًّا

217
00:19:30,510 --> 00:19:31,710
!حا-حاضر

218
00:19:32,060 --> 00:19:33,140
!ما هذا؟

219
00:19:33,220 --> 00:19:34,520
!ما الّذي يحدث؟

220
00:19:34,910 --> 00:19:36,310
!ما الّذي سنفعله؟

221
00:19:36,370 --> 00:19:37,800
!علينا الهرب

222
00:19:44,680 --> 00:19:50,040
لا تظنّوا أنّ بإمكانكم العودة
!سالمين بعد سخريتكم منّي

223
00:19:53,900 --> 00:19:56,240
...اسمعا! لسنا بحاجة للسّعي خلفهم

224
00:19:57,450 --> 00:19:58,950
...يا إلهي

225
00:20:03,510 --> 00:20:06,850
.يا لكينييمون اللّعين... عليّ إبلاغ أونيغاشيما

226
00:20:06,850 --> 00:20:10,460
!قمتُ بدوري الّذي أوكلني إيّاه أوروتشي-ساما

227
00:20:12,100 --> 00:20:14,230
!بقي لي أمر واحد فقط لأفعله

228
00:20:16,260 --> 00:20:17,470
!كاواماتسو؟

229
00:20:28,490 --> 00:20:31,620
!لم أكن أعرف أنّك بارع في الرّسم هكذا

230
00:20:32,830 --> 00:20:33,960
!لن أسمح لك بالذّهاب

231
00:20:34,750 --> 00:20:37,990
!لن أسمح لك بخطف مومونوسكي-ساما

232
00:20:42,370 --> 00:20:44,620
!كاواماتسو! أنا قادم أيضًا

233
00:20:44,620 --> 00:20:47,040
!إيّاك! ستغرق

234
00:20:49,000 --> 00:20:52,640
!تشاركنا جميعًا سنوات عديدة من الألم والمعاناة

235
00:20:52,640 --> 00:20:56,050
!خدمنا تحت راية أودن-ساما معًا وفقدناه معًا

236
00:20:56,980 --> 00:21:00,690
هل تستمتع بخداع وخيانة أصدقاء كهؤلاء؟

237
00:21:00,860 --> 00:21:05,240
هل تستمتع بدوسك على أمنياتنا وتخييب أمالنا؟

238
00:21:05,240 --> 00:21:06,990
!كانجورو

239
00:21:08,570 --> 00:21:11,440
!أجل! أستمتع كثيرًا

240
00:21:12,450 --> 00:21:15,160
!الخداع والتّحايل والنّهاية المفاجئة

241
00:21:15,160 --> 00:21:18,130
لا يوجد دور في العالم بأسره
!جدير بأن ألعبه أكثر من هذا

242
00:21:19,740 --> 00:21:23,590
!وأعجبني كيف تظاهرتم بالغباء أيضًا

243
00:21:26,620 --> 00:21:29,290
!كانجورو

244
00:21:34,100 --> 00:21:38,340
!سننهي المسرحيّة بتلطيخ الخشبة بدماء كوزكي

245
00:21:48,780 --> 00:21:50,390
!كاواماتسو

246
00:21:50,390 --> 00:21:52,440
!مومونوسكي-ساما

247
00:21:52,450 --> 00:21:57,170
.لا تقلق يا مومونوسكي
.سأجعل أختك تتبعك إلى حتفك

248
00:21:57,170 --> 00:22:01,590
!كاواماتسو! أقسم أنّني سأجد هيوري وأقتلها أيضًا

249
00:22:01,590 --> 00:22:04,240
!أعلم أنّها حيّة الآن

250
00:22:07,720 --> 00:22:09,300
!كانجورو

251
00:22:09,300 --> 00:22:12,430
!لا أصدّق أنّك رسمتَ طائرًا يمكنه الطّيران ببراعة

252
00:22:12,430 --> 00:22:18,500
كلّ ما رأيناه منك هي رسومات بلا فائدة
!تختفي إن لمست الماء

253
00:22:18,500 --> 00:22:20,710
!كان ذلك جزءًا من دوري أيضًا

254
00:22:21,210 --> 00:22:22,770
!نحن على ارتفاع شاهق

255
00:22:22,770 --> 00:22:26,610
!أنزلني! أنا خائف! النّجدة

256
00:22:31,240 --> 00:22:33,100
!أغرقناهم في نفس الوقت ثانية

257
00:22:33,100 --> 00:22:35,160
!سأغرق السّفينة الأخيرة

258
00:22:35,160 --> 00:22:36,770
!بل أنا من سيغرقها

259
00:22:36,800 --> 00:22:38,120
!قلتُ أنّني سأغرقها

260
00:22:38,120 --> 00:22:40,570
!مومونوسكي-ساما

261
00:22:42,240 --> 00:22:44,750
كانجورو؟ مومو؟

262
00:22:44,750 --> 00:22:46,420
!مهلاً! إلى أين تذهبان؟

263
00:22:46,420 --> 00:22:48,740
!الوداع أيّها الحمقى

264
00:22:51,790 --> 00:22:56,270
!في كلّ الأحوال، لستم ندًّا لجيش كايدو-ساما

265
00:22:56,270 --> 00:22:59,060
!لا يمكنكم حتّى دخول الجزيرة

266
00:23:02,550 --> 00:23:05,470
!النّجدة

267
00:23:17,770 --> 00:23:19,910
،بينما يحلّق بعيدًا

268
00:23:19,910 --> 00:23:25,800
يتحمّل القائد الصّغير مومونوسكي خوفه الشّديد
.ويصرخ من أعماق قلبه ويشجّع رفاقه

269
00:23:25,800 --> 00:23:33,680
يبعد طاقم قبّعة القشّ هجوم العدوّ وكذا الأمواج
!العاتية وكلّهم غضب على خيانة كانجورو

270
00:23:33,680 --> 00:23:36,360
!سينقذون صديقهم مهما كلّف الأمر

271
00:23:36,360 --> 00:23:40,810
:"في الحلقة القادمة من وان بيس
"!وعد بدموع! مومونوسكي المختطَف"

272
00:23:40,810 --> 00:23:44,510
!ملك القراصنة، لن يكون إلاّ أنا