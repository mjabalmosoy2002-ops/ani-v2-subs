1
00:00:22,290 --> 00:00:25,330
!العالم... نعم

2
00:00:25,860 --> 00:00:27,530
...اسعوا نحو الحرّيّة

3
00:00:27,530 --> 00:00:31,570
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:32,030 --> 00:00:35,370
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,900 --> 00:00:37,370
!فتجاوزوها

6
00:00:37,670 --> 00:00:40,640
!تحت راية ما تؤمنون به

7
00:00:45,110 --> 00:00:50,720
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,720 --> 00:00:53,950
متّجهًا نحو عالم بلا نهاية

9
00:00:55,360 --> 00:01:00,230
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,230 --> 00:01:08,640
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,640 --> 00:01:14,370
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,370 --> 00:01:18,810
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,810 --> 00:01:24,450
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,450 --> 00:01:28,320
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,320 --> 00:01:33,260
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,260 --> 00:01:41,000
متّجهين نحو الأفق

17
00:01:41,000 --> 00:01:46,510
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,510 --> 00:01:51,210
متّجهًا نحو عالم بلا نهاية

19
00:01:51,210 --> 00:01:56,450
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,450 --> 00:02:02,720
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:07,690 --> 00:02:09,330
مشاعر أولئك الّذين يعانون من كرب

22
00:02:09,330 --> 00:02:11,600
.لاقت سحقًا من سحابة الرّمال الجافّة

23
00:02:12,500 --> 00:02:15,900
،هنالك من في الأمل ساعٍ
.وهنالك من فيه متشبّث

24
00:02:16,300 --> 00:02:18,440
تشابكت مشاعرهم وهم في ريبةٍ من أمرهم

25
00:02:18,770 --> 00:02:22,540
.واسمةً حقبةً من التّاريخ يختمها الحزن

26
00:02:23,980 --> 00:02:27,410
تستمرّ فيفي وأصدقاؤها في القتال
.من أجل إنقاذ أراباستا من أزمتها

27
00:02:29,850 --> 00:02:32,920
...إضافةً لانتصار أوسوبّ وتشوبّر

28
00:02:34,720 --> 00:02:38,290
.تمكّن سانجي من سحق السّيّد 2 بون كوري

29
00:02:50,040 --> 00:02:54,340
في نفس الأثناء، خاضت نامي
،قتالاً حاميًا ضدّ الآنسة دبلفينغر

30
00:02:54,340 --> 00:02:56,080
.الّتي تملك قوى فاكهة الأشواك

31
00:02:56,680 --> 00:02:58,380
!خذي هذه

32
00:02:58,750 --> 00:03:00,750
!جوّ الزّوبعة

33
00:03:16,530 --> 00:03:17,460
ماذا؟

34
00:03:17,460 --> 00:03:19,300
!...شبكت الحمامتان على جسدي

35
00:03:41,390 --> 00:03:45,830
وفي النّهاية، استطاعت نامي الفوز بالمعركة
.بفضل اختراع أوسوبّ، عصا الطّقس

36
00:03:47,390 --> 00:03:52,170
ليبقى قتال واحد قائم
.بين السّيّد 1 وزورو

37
00:03:55,370 --> 00:03:58,670
.إذًا أساسًا، جسدك صلب كالفولاذ

38
00:03:58,670 --> 00:04:01,840
،ما لم أكن قادرًا على قطع حتّى الفولاذ
فلن أستطيع الإطاحة بك، صحيح؟

39
00:04:02,280 --> 00:04:04,180
.كلامك صحيح

40
00:04:04,980 --> 00:04:07,410
.هجمات التّحطيم والقطع لا تفلح ضدّي

41
00:04:08,820 --> 00:04:11,280
.فهمت. هذا مزعج

42
00:04:11,280 --> 00:04:14,790
،بما أنّني لا أستطيع قطع الفولاذ بعد
.لا أستطيع أن أهزمك في الوقت الرّاهن

43
00:04:15,860 --> 00:04:17,160
وماذا ستفعل إذًا؟

44
00:04:17,160 --> 00:04:20,260
.لنرَ... سأتعاطف معك

45
00:04:20,260 --> 00:04:21,230
ماذا؟

46
00:04:22,130 --> 00:04:24,630
.كنتُ منتظرًا لوضع صعب كهذا

47
00:04:25,400 --> 00:04:29,240
فكّرتُ أنّه حان الوقت
.لأتقدّم بمستواي خطوةً

48
00:04:30,270 --> 00:04:32,410
،عندما أهزمك

49
00:04:32,740 --> 00:04:36,540
سأكون الرّجل الّذي يستطيع
.قطع حتّى الفولاذ

50
00:04:41,050 --> 00:04:46,250
سرّ المسايفة القويّة! القدرة"
".على قطع الفولاذ ونفَس كلّ شيء

51
00:04:49,260 --> 00:04:51,930
عندما تهزمني؟

52
00:04:52,530 --> 00:04:54,860
،قد يُحبط هذا حماسك

53
00:04:55,800 --> 00:04:59,430
،لكن مذ حصلتُ على قوى فاكهة القطع

54
00:04:59,430 --> 00:05:02,970
لم أتكبّد ولو خدشًا ممّن
.يسمّون أنفسهم سيّافة

55
00:05:04,040 --> 00:05:07,640
.لا يستطيع أيّ سيّاف هزيمتي

56
00:05:07,940 --> 00:05:10,480
...فهمت ما تقصد

57
00:05:10,480 --> 00:05:13,880
لكن يمكنك أن تحتفظ
.بكلّ حكاياتك لنفسك

58
00:05:14,280 --> 00:05:17,880
،لا أدري كم واجهت من سيّاف في الماضي

59
00:05:19,020 --> 00:05:22,120
.لكنّنا لم نتواجه من قبل

60
00:05:26,490 --> 00:05:28,800
.يبدو أنّ لسانك حادّ على الأقلّ

61
00:05:30,000 --> 00:05:32,200
.شكرًا يا أصلع

62
00:05:37,070 --> 00:05:38,910
.سنرى إلى متى ستصمد

63
00:05:39,270 --> 00:05:40,370
.وأنت أيضًا

64
00:06:23,620 --> 00:06:24,350
...قاطع

65
00:06:26,390 --> 00:06:27,590
!الغول

66
00:06:32,160 --> 00:06:33,310
...صيد

67
00:06:33,790 --> 00:06:35,030
!النّمور

68
00:07:07,190 --> 00:07:08,430
أولم أخبرك؟

69
00:07:12,900 --> 00:07:16,840
.من المفاجئ أنّك لم تتلقّ ولو خدشًا واحدًا

70
00:07:17,340 --> 00:07:20,610
هذه أوّل مرّة أيضًا يظلّ
...خصمي واقفًا

71
00:07:20,610 --> 00:07:22,410
.بعد أن ظننتُ أنّني أصبته بشدّة

72
00:07:23,010 --> 00:07:24,810
.بالطّبع

73
00:07:25,380 --> 00:07:29,020
.بما أنّنا لم نتواجه من قبل

74
00:07:38,860 --> 00:07:39,660
!صحيح

75
00:07:40,860 --> 00:07:43,400
.جسده كلّه من سيوف

76
00:07:43,400 --> 00:07:46,370
!لذا فإنّ سيوفه لا تملك مقدّمة أو مؤخّرة

77
00:07:50,340 --> 00:07:52,570
!الأقحوان المتلألئ

78
00:07:59,750 --> 00:08:02,120
...هـ-هذا

79
00:08:04,080 --> 00:08:05,090
.سأعصف بك

80
00:08:46,730 --> 00:08:49,430
،إن تعلّق الأمر بالتّدريب
.لقد تدرّبتُ أكثر من الجميع

81
00:08:52,930 --> 00:08:57,340
كما مررتُ بالكثير من المواقف
.الّتي كادت تودي بحياتي

82
00:08:59,640 --> 00:09:05,810
عندما أهزمك، سأكون الرّجل
.الّذي يستطيع قطع حتّى الفولاذ

83
00:09:06,180 --> 00:09:11,050
لم أتكبّد ولو خدشًا ممّن
.يسمّون أنفسهم سيّافة

84
00:09:12,590 --> 00:09:15,120
!ما الّذي ينقصني؟

85
00:09:17,590 --> 00:09:20,530
!سينسي! سينسي

86
00:09:21,560 --> 00:09:22,430
نعم؟

87
00:09:23,760 --> 00:09:28,440
أصحيحٌ أنّه يوجد في هذا العالم من
يستطيع قطع أيّ شيء، حتّى الفولاذ؟

88
00:09:31,140 --> 00:09:33,310
.نعم، ذلك صحيح

89
00:09:35,080 --> 00:09:38,450
.والآن، راقب هذه الورقة بإمعان يا زورو

90
00:09:45,050 --> 00:09:47,350
.سينسي، لم تقطعها

91
00:09:47,350 --> 00:09:49,190
.اسمع يا زورو

92
00:09:49,190 --> 00:09:54,730
.هنالك سيّافة لا يستطيعون قطع أيّ شيء

93
00:09:56,930 --> 00:10:02,870
،لكن بوسعهم قطع أيّ شيء أيضًا
.حتّى الفولاذ... وباستخدام السّيف عينه

94
00:10:04,200 --> 00:10:08,380
أقوى السّيافة يمكنهم حماية
ما يريدون حمايته

95
00:10:08,380 --> 00:10:10,680
.كما قطع ما يريدون قطعه

96
00:10:11,780 --> 00:10:15,950
...أمّا المسايفة الّتي تؤذي أيّ ما تمسّه

97
00:10:15,950 --> 00:10:18,050
.لا أعتبرها مسايفة حقيقيّة

98
00:10:18,450 --> 00:10:19,850
هل فهمت؟

99
00:10:42,710 --> 00:10:46,210
سينسي، سأكون سيّافًا
!يستطيع قطع أيّ شيء

100
00:10:47,280 --> 00:10:50,380
زورو، هل أصغيت لما قلت؟

101
00:11:03,590 --> 00:11:06,400
.أسرع وحاول قطعي

102
00:11:07,100 --> 00:11:10,570
.لا يمكنك قطعي بالدّفاع وحده

103
00:11:11,810 --> 00:11:17,880
مع الأسف، لا أظنّك تستطيع
...رؤية بسالتي وأنا أقطع الفولاذ

104
00:11:22,680 --> 00:11:27,620
.لأنّي عندما أقطعه، ستموت

105
00:11:29,090 --> 00:11:30,590
.كلامك منطقيّ

106
00:11:39,330 --> 00:11:43,200
!سأقطّع كلّ شيء... إربًا

107
00:11:45,410 --> 00:11:49,810
المسايفة الّتي لا تقطع أيّ شيء؟

108
00:12:09,130 --> 00:12:10,660
...لا فائدة

109
00:12:12,300 --> 00:12:16,040
!سأقطّع كلّ شيء... إربًا

110
00:12:17,370 --> 00:12:19,770
المسايفة الّتي لا تقطع أيّ شيء؟

111
00:12:20,770 --> 00:12:24,140
...لا أقطع أيّ شيء، لكن أقطع الفولاذ

112
00:12:24,140 --> 00:12:26,410
!لا أفهم ما يعنيه ذلك على الإطلاق

113
00:12:27,880 --> 00:12:29,320
!اطعن واطعن

114
00:12:29,320 --> 00:12:31,790
!هذا هو سرّ المسايفة القويّة

115
00:12:32,190 --> 00:12:34,250
!القطع الذّريّ

116
00:12:36,860 --> 00:12:38,390
!سأقطعك فحسب

117
00:13:07,220 --> 00:13:08,420
...قبضة

118
00:13:08,420 --> 00:13:09,360
!السّلطعون

119
00:13:31,110 --> 00:13:33,410
!يا لك من وغدٍ خبيث

120
00:13:34,720 --> 00:13:36,380
.وأنت أيضًا

121
00:13:37,150 --> 00:13:41,290
...دعني أخبرك شيئًا
.لا تعتبرني سيّافًا

122
00:13:41,990 --> 00:13:46,090
.أملك أسلحة كثيرة تستطيع تمزيقك إربًا

123
00:13:52,200 --> 00:13:53,570
!الحافر اللّولبيّ

124
00:13:58,340 --> 00:14:01,480
!إلّم تكن سيّافًا... هل أنت حفّار؟

125
00:14:01,880 --> 00:14:03,110
!أنا قاتل

126
00:14:08,580 --> 00:14:12,450
!شرارات؟! ما مدى سرعة دورانها؟

127
00:14:14,860 --> 00:14:16,020
!ستُصدّ

128
00:14:18,430 --> 00:14:20,660
...لا يمكنني أن أحفر

129
00:14:21,510 --> 00:14:23,830
.لأنّني سأقطع كلّ شيء إن حفرت

130
00:14:25,130 --> 00:14:26,030
!سحقًا

131
00:14:41,480 --> 00:14:44,250
...أسئ تقدير خصمك للحظة وسوف

132
00:14:45,950 --> 00:14:46,790
!تموت

133
00:15:18,220 --> 00:15:19,620
...ما زلتَ تتنفّس

134
00:15:25,460 --> 00:15:28,130
...لن أري ظهري له

135
00:15:30,260 --> 00:15:32,800
كيف ستكافح بيديك العاريتين؟

136
00:15:38,870 --> 00:15:44,180
.لستَ سيّافًا أساسًا
.لذا لن تفهم حتّى إن شرحت لك

137
00:15:45,680 --> 00:15:47,910
.لستُ مهتمًّا أساسًا

138
00:15:50,850 --> 00:15:53,520
!القاطع الفوضويّ

139
00:16:11,370 --> 00:16:12,970
...ارقد بسلام

140
00:16:16,040 --> 00:16:20,710
...حظّي سيّئ مع الصّخور اليوم

141
00:16:51,980 --> 00:16:56,580
يا رفاق! احرصوا على إرجاع
!فيفي إلى ديارها

142
00:16:57,320 --> 00:16:59,250
!لنتقابل في قصر ألوبارنا

143
00:17:03,820 --> 00:17:07,430
أهم بخير... جميعًا؟

144
00:17:23,210 --> 00:17:24,780
أنّى له أن يقف؟

145
00:17:25,450 --> 00:17:27,210
...بعد أن قطعتُه عدّة مرّات

146
00:17:27,750 --> 00:17:29,680
هل تجنّب كلّ تلك الصّخور المتساقطة؟

147
00:17:36,420 --> 00:17:39,230
تجنّبتُ... الصّخور؟

148
00:17:40,030 --> 00:17:40,860
...لا

149
00:17:41,900 --> 00:17:46,330
بل عرفتُ... المكان الّذي
...لن تسقط فيه

150
00:17:51,240 --> 00:17:52,370
...السّيوف

151
00:17:53,340 --> 00:17:57,010
...يمكنني أن أعرف أنّ إحداها
...تحت تلك الصّخرة

152
00:18:00,810 --> 00:18:02,180
ما الّذي يفعله؟

153
00:18:11,260 --> 00:18:13,790
...سبق وأن اختبرتُ هذا الشّعور

154
00:18:18,000 --> 00:18:20,000
...حيث يخيّم الصّمت من حولي

155
00:18:21,640 --> 00:18:24,170
...وأسمع دقّات قلبي بوضوح

156
00:18:27,940 --> 00:18:31,380
أهكذا... نشعر بالضّبط
عندما نكون على شفير الموت؟

157
00:18:34,310 --> 00:18:40,450
شعرتُ بتلميح من الصّخور
...المتساقطة وكأنّها كائنات حيّة

158
00:18:41,990 --> 00:18:45,430
...كلّا، لم يكن تلميحًا
...بل كان أكثر وضوحًا من ذلك

159
00:18:46,330 --> 00:18:47,530
...نفَس

160
00:18:49,100 --> 00:18:51,670
...نفس... الصّخور

161
00:18:52,470 --> 00:18:54,300
...للأشجار نفَسها

162
00:18:55,600 --> 00:18:57,500
...التّربة أيضًا

163
00:18:58,370 --> 00:19:00,110
أهذا ما في الأمر؟

164
00:19:01,340 --> 00:19:07,650
اسمع. هنالك سيّافة
.لا يستطيعون قطع أيّ شيء

165
00:19:10,020 --> 00:19:15,190
هل المقصود بـ"عدم قطع
أيّ شيء" هو معرفة النّفَس؟

166
00:19:16,390 --> 00:19:20,030
تلك هي... القدرة على
...قطع حتّى الفولاذ

167
00:19:21,900 --> 00:19:24,870
أيّها الوغد... ما الّذي فعلته؟

168
00:19:25,330 --> 00:19:27,670
...بعد أن تكبّدتَ هجومًا بليغًا

169
00:19:27,670 --> 00:19:29,900
...بعد أن نزفتَ كلّ هذا القدر

170
00:19:29,900 --> 00:19:32,070
!يستحيل أن تكون حيًّا

171
00:19:40,250 --> 00:19:44,750
...يمكنني سماع... نفَس فولاذه

172
00:19:46,050 --> 00:19:48,420
...إنّ إرادتي تتدفّق في السّيف

173
00:20:05,070 --> 00:20:10,010
فليكن... سأجهز عليه
.كليًّا بالهجوم التّالي

174
00:20:12,210 --> 00:20:13,350
...يبقى السّؤال

175
00:20:14,450 --> 00:20:19,250
.ما إن كنتُ قادرًا حقًّا على قطع الفولاذ

176
00:20:21,860 --> 00:20:25,760
من الصّعب أن أتخيّلك تدافع
.ضدّ هجومي بسيفٍ واحد فحسب

177
00:20:28,400 --> 00:20:31,730
.أصبت. اكتفيتُ من الدّفاع

178
00:20:32,800 --> 00:20:35,540
!أصبحت جاهزًا إذًا؟ فليكن

179
00:20:38,540 --> 00:20:42,910
:أسلوب السّيف الواحد
!أنشودة أسد الموت

180
00:20:43,580 --> 00:20:45,250
!التّدفّق الذّريّ

181
00:21:07,970 --> 00:21:09,370
...أشكرك

182
00:21:11,300 --> 00:21:13,870
!ما زال بوسعي أن أغدو أقوى

183
00:21:18,650 --> 00:21:24,920
...أصبح أقوى... في هذا القتال... بالفعل

184
00:21:29,320 --> 00:21:35,000
هل ستقطع... الماسّ أو ما شابه تاليًا؟

185
00:21:38,100 --> 00:21:40,070
...سيكون ذلك إسرافًا

186
00:21:42,600 --> 00:21:44,300
...لقد خسرت

187
00:22:20,640 --> 00:22:26,750
إلى أيّ اتّجاه عليّ أن أركض
لأرى غدًا أروع بكثير؟

188
00:22:26,750 --> 00:22:32,690
أمسكت مقود السّفينة وفتحت الخريطة
الأعجوبيّة الّتي خزّنتُها في قلبي

189
00:22:32,690 --> 00:22:38,930
،جعلتُ السّماء هدفي وتبعت أحلامي
رغم أنّني أضيع أحيانًا

190
00:22:38,930 --> 00:22:44,360
،لم يكن حلمًا عندما التقيت بك
فقد اكتشفت الشّخص الرّائع بداخلي

191
00:22:44,360 --> 00:22:50,600
وببعض الشّجاعة، اكتسبتُ شيئًا عظيمًا

192
00:22:50,600 --> 00:22:56,040
والآن هو الوقت المناسب
لأمنيتي لتصبح عهدي

193
00:22:56,810 --> 00:22:59,810
أيّها الشّعاع اللاّمع! جد طريقك الجديد تمامًا

194
00:22:59,810 --> 00:23:03,580
دعنا نرسم قصّة المستقبل

195
00:23:03,880 --> 00:23:08,820
سأضع كلّ مشاعري
في رياح جديدة تمامًا الآن

196
00:23:08,820 --> 00:23:11,830
أيّها الشّعاع اللاّمع! جد طريقك الجديد تمامًا

197
00:23:11,830 --> 00:23:14,830
رحلة لا نهاية لها لنكون معًا

198
00:23:14,830 --> 00:23:20,030
سألحق بك أينما ذهبت أيّها الشّعاع اللاّمع

199
00:23:25,240 --> 00:23:26,640
لماذا تبكي؟

200
00:23:26,640 --> 00:23:29,540
لأنّ تلك الخلد الشّمطاء
...قالت أنّ لوفي مات

201
00:23:29,540 --> 00:23:30,680
!أهذا صحيح؟

202
00:23:30,680 --> 00:23:32,180
وهل تصدّقان ذلك؟

203
00:23:32,180 --> 00:23:33,780
!بالطّبع لا

204
00:23:33,780 --> 00:23:35,250
.امسحا مخاطكما إذًا

205
00:23:36,220 --> 00:23:38,620
!ما عدتم تملكون سببًا للقتال

206
00:23:38,620 --> 00:23:41,190
!استسلموا الآن! أيّها الجيش الملكيّ

207
00:23:41,190 --> 00:23:42,560
:في الحلقة القادمة من ون بيس

208
00:23:46,060 --> 00:23:48,330
!ملك القراصنة، لن يكون إلّا أنا