1
00:00:11,240 --> 00:00:13,860
افتح الخريطة الّتي لا حدود لها

2
00:00:13,860 --> 00:00:16,820
نحو المكان الّذي لا نهاية له

3
00:00:21,410 --> 00:00:24,250
ولنلتحق بالرّياح

4
00:00:29,750 --> 00:00:33,880
لا تستسلم، فإن كنتُ عازمًا

5
00:00:33,880 --> 00:00:36,930
فلن أتراجع أبدًا

6
00:00:36,930 --> 00:00:40,310
سنواجه المياه المضطربة بضحكاتنا

7
00:00:40,720 --> 00:00:45,140
اصرخ، لتنقذ روحنا من أن تنكسر

8
00:00:45,140 --> 00:00:47,650
فأصدقاؤك يقفون إلى جانبك

9
00:00:47,650 --> 00:00:53,900
اسمع، ليس عليك التّظاهر بالقوّة أبدًا

10
00:00:53,900 --> 00:00:57,990
حتّى عندما تحاول الظّلمة أن تمزّقك لأشلاء

11
00:00:57,990 --> 00:00:59,280
هيّا، تشجّع

12
00:00:59,280 --> 00:01:00,870
كلّ شيء سيكون بخير

13
00:01:00,870 --> 00:01:04,580
فالرّوابط القويّة ستستمر

14
00:01:04,580 --> 00:01:07,330
افتح الخريطة الّتي لا حدود لها

15
00:01:07,330 --> 00:01:10,540
نحو المكان الّذي لا نهاية له

16
00:01:10,540 --> 00:01:16,010
تحلّ بالشّجاعة واخطُ خطوة للأمام

17
00:01:16,010 --> 00:01:18,760
افتح الخريطة الّتي لا حدود لها

18
00:01:18,760 --> 00:01:21,470
الرّاية الّتي تنادي وعودنا

19
00:01:21,470 --> 00:01:24,310
تواصل القتال

20
00:01:24,310 --> 00:01:28,900
فابقَ صادقًا مع نفسك

21
00:01:28,900 --> 00:01:33,280
تمسّك بالحلم وواصل

22
00:01:33,730 --> 00:01:38,700
لا يمكنني أن أخسر، ولن أهرب أبدًا

23
00:01:39,370 --> 00:01:42,120
تجاوز لحظات اللّقاء والفراق وواصل التّقدّم

24
00:01:42,120 --> 00:01:46,540
جميعها كنوز

25
00:01:46,960 --> 00:01:49,750
افتح الخريطة الّتي لا حدود لها

26
00:01:49,750 --> 00:01:52,800
نحو المكان الّذي لا نهاية له

27
00:01:52,800 --> 00:01:57,510
تحلّ بالشّجاعة واخطُ خطوة للأمام

28
00:02:23,530 --> 00:02:25,890
!أيّها الحمقى

29
00:02:25,890 --> 00:02:28,120
!توقّفوا عن الشّرب

30
00:02:28,870 --> 00:02:30,500
!احملوا أسلحتكم

31
00:02:30,500 --> 00:02:33,040
!نتعرّض لغارة

32
00:02:34,080 --> 00:02:39,350
!افتحوا بلاد وانو

33
00:02:48,350 --> 00:02:53,610
"!شغب في أونيغاشيما! تبدأ حرب لوفي الشّاملة"

34
00:03:07,700 --> 00:03:08,750
!أودن

35
00:03:15,210 --> 00:03:17,170
!سوناتشي

36
00:03:45,820 --> 00:03:48,420
!أسلوب أودن ذو السّيفين

37
00:03:48,950 --> 00:03:51,660
!توتسكا الفردوس

38
00:03:59,080 --> 00:04:02,440
...النّدبة الّتي أعطانيها أودن

39
00:04:02,440 --> 00:04:04,530
لماذا تؤلمني؟

40
00:04:04,530 --> 00:04:07,930
كيف اخترق النّصل جسدي؟

41
00:04:08,140 --> 00:04:11,760
!لا تستخفّ بتابعيّ السّاموراي

42
00:04:11,760 --> 00:04:14,480
...لا أمانع

43
00:04:15,810 --> 00:04:18,820
!إن نُسيت

44
00:04:18,820 --> 00:04:20,320
...لكنّ

45
00:04:24,860 --> 00:04:28,950
!روحي ستستمرّ في العيش

46
00:04:38,000 --> 00:04:43,010
!هل يستعملون ريوو أودن؟

47
00:04:46,470 --> 00:04:49,310
!فلتخترقك أنصالنا حتّى الجانب الآخر

48
00:05:26,420 --> 00:05:28,090
!كايدو

49
00:05:44,060 --> 00:05:45,780
!كايدو-ساما

50
00:05:50,120 --> 00:05:53,870
!يا-يا رفاق

51
00:05:57,240 --> 00:06:00,440
!إنّهم الأكازايا التّسعة

52
00:06:00,440 --> 00:06:02,790
!أتباع أودن الحقيقيّون

53
00:06:02,790 --> 00:06:05,300
!إنّهم أقوياء

54
00:06:06,210 --> 00:06:09,050
!هذه وليمة خطيرة

55
00:06:09,460 --> 00:06:12,050
!هل مات كايدو؟

56
00:06:12,930 --> 00:06:15,430
!مستحيل

57
00:06:15,430 --> 00:06:18,250
!لا يعقل أن يموت كايدو-ساما المنيع

58
00:06:18,250 --> 00:06:22,480
!قاتلوهم! اقتلوا جرذان الأكازايا

59
00:06:24,940 --> 00:06:30,570
قبّعة القشّ وكيد والبقيّة سابقًا كانوا مجرّد
!تشتيت للقيام بهذا الهجوم المفاجئ؟

60
00:06:30,570 --> 00:06:32,470
!ابقوا متأهّبين يا رفاق

61
00:06:32,470 --> 00:06:35,990
!قد لا يزال هنالك متسلّلون في مكان ما

62
00:06:35,990 --> 00:06:37,870
!هذا صحيح

63
00:07:10,950 --> 00:07:13,530
!استمعوا أيّها الضّعفاء

64
00:07:13,530 --> 00:07:17,240
!لن نسمح لكم بأذيّة كينييمون والبقيّة

65
00:07:17,240 --> 00:07:19,530
!حسنًا! سننضمّ إليهم

66
00:07:19,530 --> 00:07:22,000
!لنوسع كايدو ضربًا ثانية

67
00:07:22,000 --> 00:07:23,630
!ها أنا ذي

68
00:07:24,880 --> 00:07:26,380
!ياماتو

69
00:07:28,500 --> 00:07:29,670
!نطحة

70
00:07:33,170 --> 00:07:34,300
!أولتي

71
00:07:42,560 --> 00:07:44,940
!أتيتم بأعداد كبيرة ثانية

72
00:07:44,940 --> 00:07:47,570
!كيف تجرؤ على ضربي؟

73
00:07:47,980 --> 00:07:50,990
!آلمني ذلك كثيرًا

74
00:07:52,860 --> 00:07:55,010
،لقد هاجمتني رغم أنّني حليفتك

75
00:07:55,010 --> 00:07:58,660
...كما أنّك تركض رفقة قبّعة القشّ

76
00:07:58,660 --> 00:08:00,580
!ما الّذي تفعله-أرينسو؟

77
00:08:02,200 --> 00:08:04,290
...لا يوجد أيّ خطأ

78
00:08:04,290 --> 00:08:08,550
!لقد حان اليوم الّذي أصبح فيه كوزكي أودن أخيرًا

79
00:08:10,260 --> 00:08:12,210
!كوزكي أودن؟

80
00:08:12,510 --> 00:08:15,720
!عمّ تتكلّم؟! هل أنت مجنون؟

81
00:08:16,640 --> 00:08:18,430
!أنا جادّ

82
00:08:20,930 --> 00:08:22,620
!هل أنت بخير؟

83
00:08:22,620 --> 00:08:25,650
!لنوسعهم ضربًا ونواصل تحرّكنا

84
00:08:25,650 --> 00:08:26,400
!أجل

85
00:08:27,980 --> 00:08:30,820
!يا سيّدي الصّغير ياماتو، لدينا مشكلة

86
00:08:30,820 --> 00:08:36,410
تعرّض والدك للهجوم للتّوّ
!وثمّة العديد من الأعداء في الطّابق

87
00:08:36,410 --> 00:08:38,530
!كفاك عبثًا في الأرجاء

88
00:08:38,530 --> 00:08:39,660
!أعلم

89
00:08:39,660 --> 00:08:40,620
ماذا؟

90
00:08:40,620 --> 00:08:43,850
،ما عدت حليفًا لكم

91
00:08:43,850 --> 00:08:46,000
!ولا أهتمّ إن مات والدي

92
00:08:47,920 --> 00:08:49,090
!ماذا؟

93
00:08:53,630 --> 00:08:55,360
...فاكهة المطّاط

94
00:08:55,360 --> 00:08:57,310
!السّوط

95
00:09:09,690 --> 00:09:11,860
ما الأمر هذه المرّة؟

96
00:09:11,860 --> 00:09:14,770
...يحدث الكثير في هذه الوليمة بالفعل

97
00:09:15,240 --> 00:09:17,700
...فاكهة المطّاط

98
00:09:18,110 --> 00:09:21,080
!مسدّس الفيل

99
00:09:23,750 --> 00:09:25,080
...لا بدّ أنّه

100
00:09:39,050 --> 00:09:40,180
!كلاّ

101
00:09:40,180 --> 00:09:41,640
!لقد رأت لوفي

102
00:09:51,480 --> 00:09:54,150
!كلاّ! بيغ مام

103
00:09:54,150 --> 00:09:56,070
!ليس وأنا مشغول جدًّا

104
00:09:57,950 --> 00:09:59,800
.وجدتك أخيرًا

105
00:09:59,800 --> 00:10:04,210
!يا قبّعة القشّ

106
00:11:03,510 --> 00:11:04,770
!غرفة

107
00:11:16,690 --> 00:11:18,360
!مهلاً

108
00:11:19,070 --> 00:11:25,200
ياماتو موجود هنا! تريد الإمساك به والفوز
بحقّ تحدّي أحد كبار النّجوم، صحيح؟

109
00:11:25,780 --> 00:11:27,660
.لديّ شأن آخر

110
00:11:41,460 --> 00:11:43,320
!ابتعدي عن طريقي يا أولتي

111
00:11:43,320 --> 00:11:46,890
!أنا كوزكي أودن! وسأطيح بكايدو

112
00:11:46,890 --> 00:11:49,250
!من أودن أيّها الغبيّ

113
00:11:49,250 --> 00:11:52,440
!عليك تقدير عائلتك

114
00:11:55,350 --> 00:11:56,960
!لا يحقّ لك الكلام

115
00:11:56,960 --> 00:11:59,650
!في تلك الحالة، كوني لطيفة مع بيج وان

116
00:11:59,650 --> 00:12:02,780
!ماذا؟! لا تمل عليّ ما أفعل

117
00:12:03,740 --> 00:12:05,160
...أنا

118
00:12:05,160 --> 00:12:10,040
أعامل بي-تان بلطف أكثر
!من أيّ أحد آخر في العالم

119
00:12:22,550 --> 00:12:24,720
...مدفع

120
00:12:26,300 --> 00:12:27,850
!نطحة أولتي

121
00:12:50,820 --> 00:12:53,910
!هيّا بنا! علينا إنقاذه الآن

122
00:12:53,910 --> 00:12:54,920
!مهلاً

123
00:12:56,660 --> 00:12:58,160
!انظري هناك

124
00:12:58,160 --> 00:13:00,130
...ماذا؟! أهذه

125
00:13:03,960 --> 00:13:05,890
!شينوبو-تشان

126
00:13:08,260 --> 00:13:11,040
!لا تقلقي يا نيكو روبين

127
00:13:11,040 --> 00:13:13,680
!لدينا أصدقاء يُعتمد عليهم

128
00:13:14,060 --> 00:13:15,640
!أيّها الزّعيم-سان

129
00:13:23,400 --> 00:13:25,450
...كحال شينوبو

130
00:13:26,360 --> 00:13:30,370
!عدم جلب الأنظار إلينا سيساعدنا في مرحلة معيّنة

131
00:13:30,370 --> 00:13:33,830
!لذلك تحلّي بالصّبر حاليًّا

132
00:13:34,330 --> 00:13:36,670
!نعم، فهمت

133
00:13:36,670 --> 00:13:41,040
!عندما سيحين الوقت، سنظهر كلّ ما في جعبتنا

134
00:13:41,040 --> 00:13:44,800
!سأعتمد عليك أيّها الزّعيم-سان

135
00:13:56,510 --> 00:13:58,810
!كاروت! لنهرب من هنا

136
00:13:59,560 --> 00:14:00,860
!حسنًا

137
00:14:02,650 --> 00:14:08,370
!ذلك مستحيل-جدار! أوامر ماما مطلقة

138
00:14:09,820 --> 00:14:12,250
!هذا صحيح

139
00:14:16,030 --> 00:14:17,910
!جهّزوا أنفسكم

140
00:14:19,540 --> 00:14:21,670
!كرات سوداء

141
00:14:25,420 --> 00:14:28,100
!هل أنت بخير؟

142
00:14:28,430 --> 00:14:30,390
!ها أنا ذي

143
00:14:30,390 --> 00:14:32,600
!وأنا أيضًا

144
00:14:32,600 --> 00:14:34,810
!غيوم العاصفة

145
00:14:40,520 --> 00:14:42,060
!مخلب الكهرباء

146
00:14:47,360 --> 00:14:50,740
!نينبو: إكتوبلازم البرق

147
00:15:08,170 --> 00:15:09,880
!نجحنا

148
00:15:09,880 --> 00:15:11,840
!هيّا بنا يا كاروت

149
00:15:11,840 --> 00:15:12,970
!حسنًا

150
00:15:12,970 --> 00:15:15,470
!إلى حيث توجد بيغ مام

151
00:15:15,470 --> 00:15:17,450
!أجل

152
00:15:17,450 --> 00:15:20,770
!مهلاً... ماذا؟! لماذا؟

153
00:15:20,770 --> 00:15:23,360
!لقد تكبّدنا عناء الهرب منها للتّوّ

154
00:15:26,020 --> 00:15:27,360
...إنّني

155
00:15:27,360 --> 00:15:32,610
أملك مبدأ ينصّ على أنّني لن أتخلّى
!أبدًا على كنز وضعت يدي عليه

156
00:15:33,700 --> 00:15:35,700
هل تتحدّثين عن زوس؟

157
00:15:35,700 --> 00:15:40,710
!انتظرني! سأستعيده مهما كلّف الأمر

158
00:15:46,840 --> 00:15:49,710
!يا قبّعة القشّ

159
00:15:50,840 --> 00:15:52,850
...فاكهة المطّاط

160
00:15:56,890 --> 00:16:00,600
!مسدّس الفيل

161
00:16:29,420 --> 00:16:35,470
لقد جعلتَ من طاقم قراصنتي
...أضحوكة، وبهدف قتلك

162
00:16:37,470 --> 00:16:42,600
!أتيتُ كلّ هذه المسافة من توتولاند

163
00:16:43,140 --> 00:16:45,940
!يا قبّعة القشّ

164
00:16:55,740 --> 00:16:59,060
.كلاّ... هذا سيّئ

165
00:16:59,060 --> 00:17:02,950
!عليّ القتال أيضًا وإلاّ قتلتني ماما

166
00:17:07,880 --> 00:17:10,270
!لذيذ! لذيذ! لذيذ

167
00:17:10,270 --> 00:17:13,190
!لذيذ! لذيذ! لذيذ! لذيذ

168
00:17:13,190 --> 00:17:14,590
!لذيذ

169
00:17:18,260 --> 00:17:21,560
!زوس-تشان

170
00:17:23,430 --> 00:17:25,480
!نا... مي

171
00:17:27,140 --> 00:17:30,130
.أنا سعيدة لأنّك بخير

172
00:17:30,130 --> 00:17:32,450
.كنت قلقة حيالك

173
00:17:36,030 --> 00:17:40,200
.كنت قلقًا حيالك أيضًا. أنا جادّ

174
00:17:40,200 --> 00:17:41,760
!أنا سعيدة

175
00:17:41,760 --> 00:17:45,950
!إنّ الرّابط الّذي بيننا أعمق ممّا ظننت

176
00:17:45,950 --> 00:17:50,970
!إنّك تؤلمينني يا نامي! اتركيني

177
00:17:52,420 --> 00:17:55,170
!لن أتركك أبدًا

178
00:17:58,010 --> 00:18:00,310
...نامي

179
00:18:12,730 --> 00:18:14,590
!أجل، بإمكاني رؤيته

180
00:18:14,590 --> 00:18:18,570
!الرّابط الّذي يجمعكما يلمع كأنّه كنز

181
00:18:18,820 --> 00:18:20,950
!إنّها محقّة يا زوس

182
00:18:22,200 --> 00:18:27,750
...أنت كنزي النّفيس الخاصّ

183
00:18:59,110 --> 00:19:02,240
.أيا قمرًا غافلاً عن الفجر

184
00:19:03,660 --> 00:19:05,890
...لعلّ مرادك يتحقّق

185
00:19:05,890 --> 00:19:10,690
وتُلقى الظّلال التّسعة في اللّيلة
المحبوكة لعشرين سنة

186
00:19:10,690 --> 00:19:14,500
!ولتعرفنّ ضِياء الفجر

187
00:19:14,500 --> 00:19:17,690
،آن أواننا. إن أطحنا برأس كايدو

188
00:19:17,690 --> 00:19:23,390
!سنثأر بذلك لسيّدنا كوزكي أودن

189
00:19:37,770 --> 00:19:41,910
!اركضوا إلى كوري

190
00:19:44,200 --> 00:19:47,210
!لا تنظروا للوراء

191
00:19:58,250 --> 00:19:59,550
!أودن-ساما

192
00:20:02,460 --> 00:20:05,350
!أودن-ساما

193
00:20:14,520 --> 00:20:16,190
!أودن-ساما

194
00:20:39,550 --> 00:20:44,070
!يا قبّعة القشّ! لماذا أنت هنا؟

195
00:20:44,070 --> 00:20:49,930
،لا تقل لي أنّك أتيت للإطاحة بكايدو
.فذلك مضحك للغاية

196
00:20:49,930 --> 00:20:52,140
!صحيح! لستُ هنا لذلك السّبب

197
00:20:52,140 --> 00:20:53,310
ماذا؟

198
00:20:54,560 --> 00:20:55,730
!لوفي؟

199
00:21:00,560 --> 00:21:03,610
!يا فتى قبّعة القشّ... ماذا قلت؟

200
00:21:03,610 --> 00:21:06,080
!ليس ذلك هدفك يا لوفي؟

201
00:21:07,030 --> 00:21:09,660
...كلاّ! أنا

202
00:21:13,200 --> 00:21:19,170
بعد عشرين سنة، سيأتي ساموراي
...الأكازايا للظّفر بانتقامهم

203
00:21:19,420 --> 00:21:25,390
توقُّع أوروتشي الّذي لم يصدّقه
!أيّ أحد كان مرتبطًا بكلّ شيء

204
00:21:28,670 --> 00:21:32,290
.لا أصدّق أنّكم تعاونتم مع قراصنة

205
00:21:32,290 --> 00:21:37,170
...الإشاعة عن الظّلال في أطلال قلعة أودن

206
00:21:37,170 --> 00:21:39,170
.بانك هازارد

207
00:21:39,170 --> 00:21:40,940
.دريسروزا

208
00:21:40,940 --> 00:21:43,570
.الجزيرة الوهميّة زو

209
00:21:43,570 --> 00:21:48,110
!وخلف كلّ ذلك نجد طاقم قبّعة القشّ

210
00:21:48,440 --> 00:21:50,600
،ويا لها من صدفة غريبة

211
00:21:50,600 --> 00:21:56,290
كنتم تختبئون خلف طاقم قبّعة القشّ
.الّذين أعتبرهم أعداءً لي

212
00:21:56,290 --> 00:22:01,270
بعضكم تحمّل لعشرين سنة بينما
،قفز البقيّة عبر الزّمن وهربوا

213
00:22:01,270 --> 00:22:04,340
.وانتهى بكم المطاف بحشد كلّ القوّات

214
00:22:05,590 --> 00:22:09,970
!لكنّ القراصنة سيطعنونكم في الظّهر

215
00:22:11,220 --> 00:22:15,120
،في اللّحظة الّتي سيرون فيها هزيمتكم
.سيتخلّون عنكم وسيهربون

216
00:22:15,120 --> 00:22:21,360
إضافة لذلك، سبق أن أذقت الهزيمة
!لقبّعة القشّ سابقًا

217
00:22:22,520 --> 00:22:25,400
!إنّك تهينه بكلامك هذا

218
00:22:26,860 --> 00:22:29,700
!لا يشبهكم لوفي-دونو على الإطلاق

219
00:22:30,030 --> 00:22:34,180
!أنت وكايدو ورجالكما وأوروتشي وكلّ أتباعه

220
00:22:34,180 --> 00:22:37,750
!سأوسعكم ضربًا جميعًا

221
00:22:40,620 --> 00:22:42,710
...لوفي

222
00:22:45,340 --> 00:22:49,680
!إنّه الرّجل الّذي سيقف على قمّة البحر يومًا ما

223
00:22:51,260 --> 00:22:54,700
،حتّى إن كان الموت مصيرنا
!فسيظلّ واقفًا هنا

224
00:22:54,700 --> 00:22:58,140
!سيحلّ الفجر على بلاد وانو ثانية

225
00:22:58,140 --> 00:22:59,820
...لأنّ

226
00:23:00,180 --> 00:23:02,940
!ذلك ما وعدنا به سيّدنا

227
00:23:06,150 --> 00:23:09,530
!ستكون حربًا شاملة

228
00:23:18,000 --> 00:23:19,870
!انقلبت الموازين

229
00:23:19,870 --> 00:23:24,630
يعاني قراصنة مملكة الحيوان
!ضدّ قوّات السّاموراي المتصاعدة

230
00:23:24,630 --> 00:23:27,990
!يستخفّ كايدو بلوفي الّذي بدأ القتال

231
00:23:27,990 --> 00:23:29,970
!إنّها ليلة القمر البدر

232
00:23:29,970 --> 00:23:35,770
ويظهر المينك أشكالهم الحقيقيّة وهم
!يقاتلون بينما يفكّرون في موطنهم المدمّر

233
00:23:36,470 --> 00:23:37,770
:في الحلقة القادمة من وان بيس

234
00:23:37,770 --> 00:23:40,960
المعركة تحت القمر! المحاربون"
"!الهائجون، سولونغ أسد القمر

235
00:23:40,960 --> 00:23:44,400
!ملك القراصنة، لن يكون إلاّ أنا