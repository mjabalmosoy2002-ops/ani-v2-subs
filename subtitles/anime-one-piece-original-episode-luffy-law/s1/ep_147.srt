1
00:00:22,250 --> 00:00:25,280
!العالم... نعم

2
00:00:25,820 --> 00:00:27,480
...اسعوا نحو الحرّيّة

3
00:00:27,480 --> 00:00:31,660
.وسيمتدّ العالم بأسره أمام أنظاركم

4
00:00:31,990 --> 00:00:35,390
،إن كانت أحلامكم اللاّمتناهية هي مرشدكم

5
00:00:35,890 --> 00:00:37,260
!فتجاوزوها

6
00:00:37,660 --> 00:00:40,630
!تحت راية ما تؤمنون به

7
00:00:45,100 --> 00:00:50,710
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

8
00:00:50,710 --> 00:00:53,940
متّجهًا نحو عالم بلا نهاية

9
00:00:55,350 --> 00:01:00,220
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

10
00:01:00,220 --> 00:01:08,630
باحثًا عن ضياء لم يرها أحد بعد

11
00:01:08,630 --> 00:01:14,360
عندما تُأرجح شمس الصّيف أشرعة قلبي

12
00:01:14,360 --> 00:01:18,800
"حلّق بعيدًا أيّها البحر الأزرق الكئيب"

13
00:01:18,800 --> 00:01:24,440
تكون تلك إشارة لفتح الباب نحو عالم جديد

14
00:01:24,440 --> 00:01:28,310
"حلّقي بعيدًا أيّتها السّماء الزّرقاء الكئيبة"

15
00:01:28,310 --> 00:01:33,250
نبحر عبر أمواج اليأس الوعرة

16
00:01:33,250 --> 00:01:40,990
متّجهين نحو الأفق

17
00:01:40,990 --> 00:01:46,500
بدأتُ بحثي للتّوّ، محدثًا رذاذ مياه

18
00:01:46,500 --> 00:01:51,200
متّجهًا نحو عالم بلا نهاية

19
00:01:51,200 --> 00:01:56,440
بقلبٍ يتدفّق حماسًا، سأذهب حتّى نهاية الأرض

20
00:01:56,440 --> 00:02:02,710
باحثًا عن ضياء لم يرها أحد بعد

21
00:02:05,920 --> 00:02:08,520
اسمع يا سيّدي! نبحث عن
!معلومات عن جزيرة السّماء

22
00:02:08,520 --> 00:02:10,420
...هل تعرف شيئًا؟ إن كنتَ تعرف

23
00:02:14,290 --> 00:02:15,430
!"قالت "جزيرة السّماء

24
00:02:15,430 --> 00:02:18,360
!لكنّ البوصلة المسجِّلة تشير للسّماء بالفعل

25
00:02:16,490 --> 00:02:18,000
!هذا لا يصدّق

26
00:02:21,570 --> 00:02:22,330
!لوفي

27
00:02:27,240 --> 00:02:28,740
!زورو! تمهّل لحظة

28
00:02:28,740 --> 00:02:31,740
!اخرسي! إنّه يسعى للقتال وأنا أقدّمه له

29
00:02:35,180 --> 00:02:35,910
!لوفي

30
00:02:37,410 --> 00:02:38,920
!غادروا هذه البلدة

31
00:02:40,580 --> 00:02:44,020
،لوفي! زورو! انسيا أمر الوعد
!أوسعاهم ضربًا بسرعة

32
00:02:45,390 --> 00:02:48,130
.لا تقاتلهم مهما حدث

33
00:02:55,600 --> 00:03:00,470
قراصنة في القمّة! رجل يتحدّث عن"
"!الأحلام وملك اكتشاف الأعماق

34
00:03:12,950 --> 00:03:15,220
!انظروا إليهم! ما زالوا واقفين

35
00:03:16,220 --> 00:03:19,890
!نالوا من أولئك الجبناء

36
00:03:19,890 --> 00:03:23,360
!هذه البلدة ليست للحالمين الجبناء

37
00:03:26,660 --> 00:03:27,760
ما هذه الضّجّة؟

38
00:03:27,760 --> 00:03:30,030
سمعتُ أنّ قراصنة بيلامي
.يقيمون إعدامًا علنيًّا

39
00:03:30,370 --> 00:03:34,170
!لوفي! زورو! ألن تقوما بالرّدّ عليهم؟

40
00:03:34,170 --> 00:03:37,670
!قاتلاهم! لماذا لا توسعاهم ضربًا فحسب؟

41
00:03:38,780 --> 00:03:41,580
.لا فائدة يا آنسة. إنّهما ذكيّان

42
00:03:41,580 --> 00:03:45,250
.أدركا أنّ خصومهما ليسوا أندادًا لهما

43
00:03:45,720 --> 00:03:50,520
...لكن عدم قتال خصم قويّ
.حركة مشينة

44
00:03:52,060 --> 00:03:54,830
.أعتقد أنّ لا كرامة له كقائد

45
00:03:54,830 --> 00:03:56,960
،إنّ البحريّة كرماء هذه الأيّام

46
00:03:56,960 --> 00:04:01,570
وضعوا مكافأة 30 مليون بيري
!على رأس مغفّل بلا قيمة مثله

47
00:04:02,600 --> 00:04:06,170
.زورو، لا تقاتلهم مهما حدث

48
00:04:07,970 --> 00:04:10,810
لماذا... أنتما...؟

49
00:04:11,170 --> 00:04:16,050
...مبدأ عدم المقاومة

50
00:04:21,590 --> 00:04:24,190
.إضافة لكونكما ضعيفين، لا كبرياء لكما

51
00:04:24,190 --> 00:04:26,590
.لا يمكنكما خوض ولو قتال واحد

52
00:04:26,590 --> 00:04:28,990
.لكنّ رأسيكما مليئان بالأحلام

53
00:04:30,360 --> 00:04:31,860
.أنتما كالحشرات

54
00:04:31,860 --> 00:04:33,960
!بكلّ تأكيد

55
00:04:39,840 --> 00:04:41,740
.اكتفيت، اكتفيت

56
00:04:42,740 --> 00:04:46,140
...شقيّ قصير ضعيف يساوي 30 مليون

57
00:04:46,140 --> 00:04:48,550
.أتساءل أيّ نوع من الرّجال يكون

58
00:04:49,180 --> 00:04:52,280
!هذا ليس مخيّبًا فحسب، بل مملاًّ

59
00:04:52,280 --> 00:04:55,120
.لم ألتقِ أبدًا بجبناء مثلهما

60
00:05:07,060 --> 00:05:09,770
.نعم، أبعداهما عن وجهي

61
00:05:10,700 --> 00:05:11,770
.منظرهما يضرّ العين

62
00:05:17,410 --> 00:05:19,340
!انظروا لهما

63
00:05:27,750 --> 00:05:29,990
!لوفي! زورو

64
00:05:30,650 --> 00:05:32,220
.يا امرأة

65
00:05:34,320 --> 00:05:38,100
لن تتمكّني من التّقدّم للأمام
.في العصر الجديد إن بقيت معه

66
00:05:38,100 --> 00:05:40,100
ما رأيك أن أشتريك؟

67
00:05:40,560 --> 00:05:42,070
كم سيكلّفني مجيئك معي؟

68
00:05:47,340 --> 00:05:50,840
ماذا قالت؟ ستقوم بشرائي؟

69
00:05:51,240 --> 00:05:54,950
.هذا صحيح. انضمّي لنا
.سيكون ذلك ممتعًا

70
00:05:59,080 --> 00:06:00,450
،أكره قول هذا

71
00:06:01,020 --> 00:06:05,090
لكنّني أفضل بكثير من أن أنضمّ
!لفريق ضعفاء مثلكم

72
00:06:09,630 --> 00:06:10,860
!إنّها غالية الثّمن

73
00:06:14,460 --> 00:06:17,500
!طاقمهم مجرّد مجموعة حمقى

74
00:06:17,500 --> 00:06:20,240
!لا أمل يُرجى منهم

75
00:06:27,580 --> 00:06:30,710
خذي ذلكما الاثنين وغادروا بسرعة

76
00:06:30,710 --> 00:06:33,850
!بينما ما زلتم قيد الحياة أيّها الضّعفاء

77
00:06:37,320 --> 00:06:40,390
!أجل، لا تعودوا أبدًا

78
00:06:46,030 --> 00:06:48,330
.جزيرة السّماء موجودة فعلاً

79
00:06:59,780 --> 00:07:03,010
!فطائر الكرز هذه هي الأفضل بالفعل

80
00:07:03,510 --> 00:07:04,780
...أنت ذلك الرّجل

81
00:07:05,320 --> 00:07:07,820
لماذا أنت غاضبة أيّتها الشّابّة؟

82
00:07:07,820 --> 00:07:11,490
.هما من فازا بهذا القتال

83
00:07:11,490 --> 00:07:12,190
ماذا؟

84
00:07:16,330 --> 00:07:18,930
فعلاً؟ تريد التّغلّب علينا؟

85
00:07:20,630 --> 00:07:23,670
،عندما نلتقي في المرّة القادمة
!سنكون كلانا في قمّة القراصنة

86
00:07:27,170 --> 00:07:30,410
.كان ردّك اللاّذع مبهرًا بكلّ تأكيد

87
00:07:30,410 --> 00:07:32,910
.أنت امرأة شجاعة بالفعل

88
00:07:34,240 --> 00:07:35,180
!زورو

89
00:07:36,210 --> 00:07:37,310
!لوفي

90
00:07:42,890 --> 00:07:47,060
!العصر الجديد الّذي تحدّثوا عنه مجرّد هراء

91
00:07:48,330 --> 00:07:53,530
العصر الّذي يحلم فيه القراصنة
!قد ولّى، أهذا ما قالوه؟

92
00:07:53,530 --> 00:07:54,500
ما الّذي يحدث؟

93
00:08:00,440 --> 00:08:05,610
!أحلام النّاس... لا تنتهي

94
00:08:10,250 --> 00:08:11,620
!أليس كذلك؟

95
00:08:14,920 --> 00:08:16,250
...مهلاً، مهلاً

96
00:08:17,150 --> 00:08:20,090
ما الّذي تصرخ به فجأة هكذا؟

97
00:08:20,090 --> 00:08:22,090
ما هراء أحلام النّاس هذا؟

98
00:08:22,090 --> 00:08:25,030
!التّفوّق على الآخرين ليس سهلاً

99
00:08:28,200 --> 00:08:29,570
!هل فقدت عقلك؟

100
00:08:32,040 --> 00:08:34,810
.ما الّذي يحدث؟ أسمع ضجّة في الخارج

101
00:08:35,410 --> 00:08:39,440
لا تهتمّ. ربّما يحدثون فوضى
.في الخارج لأنّهم غاضبون

102
00:08:39,910 --> 00:08:41,210
!كم هذا محزن

103
00:08:43,580 --> 00:08:46,020
.بإمكانهم السّخرية منّا كما يشاؤون

104
00:08:46,020 --> 00:08:50,350
فعندما تكون القمّة هدفك، تقابل في
.طريقك قتالات لا تستحقّ الخوض فيها

105
00:08:50,590 --> 00:08:51,890
!أولستُ محقًّا؟

106
00:08:56,330 --> 00:08:57,090
.لنذهب

107
00:08:58,460 --> 00:09:00,700
حسنًا... لوفي؟

108
00:09:08,910 --> 00:09:09,740
!لوفي

109
00:09:10,970 --> 00:09:13,780
.يبدو أنّني قاطعتكم

110
00:09:14,310 --> 00:09:15,710
هل أنتم في عجلة من أمركم؟

111
00:09:17,180 --> 00:09:20,380
!أتمنّى أن تستطيعوا الذّهاب لجزيرة السّماء

112
00:09:39,070 --> 00:09:43,370
لحظة، ربّما يعرف شيئًا ما
.عن جزيرة السّماء

113
00:09:43,370 --> 00:09:44,610
.أتساءل من ذلك الشّخص

114
00:09:44,610 --> 00:09:47,940
."لا أدري... كما أنّه ليس "شخصًا

115
00:09:47,940 --> 00:09:51,780
ماذا؟ ليس "شخصًا"؟ ماذا إذًا؟

116
00:09:51,780 --> 00:09:54,120
...بل "أشخاص"، على الأرجح

117
00:09:55,790 --> 00:09:57,250
ماذا تقصدان؟

118
00:09:57,520 --> 00:10:02,730
هل تقصدان أنّه كان هنالك
!آخرون معه؟ أين؟! انتظرا

119
00:10:08,100 --> 00:10:11,570
!مذاق السّاكي جيّد جدًّا اليوم

120
00:10:21,180 --> 00:10:21,680
!لوح

121
00:10:21,680 --> 00:10:22,310
!تفضّل

122
00:10:25,720 --> 00:10:26,350
!مسمار

123
00:10:26,350 --> 00:10:27,120
!تفضّل

124
00:10:30,520 --> 00:10:31,050
!لوح

125
00:10:31,050 --> 00:10:31,790
!تفضّل

126
00:10:32,520 --> 00:10:33,160
!هذا مؤلم

127
00:10:33,860 --> 00:10:34,560
!تفضّل

128
00:10:37,160 --> 00:10:37,960
...تفضّل

129
00:10:38,300 --> 00:10:43,600
يا إلهي... أعلم أنّني أصلحها بنفسي
.لكنّني لستُ نجّار سفن

130
00:10:44,030 --> 00:10:46,170
.لكنّك بارع في هذا يا أوسوبّ

131
00:10:46,170 --> 00:10:49,710
.فعلاً؟! هذا هو المدهش بشأني

132
00:10:49,710 --> 00:10:51,910
.علينا شراء سفينة جديدة فحسب

133
00:10:51,910 --> 00:10:56,850
هل جننت؟! أتدري كيف حصلنا
!على هذه السّفينة؟

134
00:10:55,910 --> 00:10:58,520
.أعلم، أعلم، سمعتُ ذلك كثيرًا

135
00:10:58,520 --> 00:11:01,350
أعطتها لكم فتاة جميلة
من قريتك، صحيح؟

136
00:11:02,350 --> 00:11:05,760
ومع ذلك، من الخطير مواصلة
.الإبحار على سفينة بهذه الحالة

137
00:11:05,760 --> 00:11:09,830
!لذلك أواصل إصلاحها
!تعال وساعدنا

138
00:11:09,830 --> 00:11:13,660
إصلاح؟ أتسمّي هذا إصلاحًا؟
.أنت ترقّعها فحسب

139
00:11:14,160 --> 00:11:15,470
!اخرس

140
00:11:15,470 --> 00:11:17,870
!مهلاً، هذا وجه مضحك يا أوسوبّ

141
00:11:17,870 --> 00:11:18,700
!أتقصد هذا؟

142
00:11:19,240 --> 00:11:22,440
!اخرس

143
00:11:22,810 --> 00:11:25,740
...صحيح... بشأن العشاء

144
00:11:25,740 --> 00:11:27,910
!اخرس

145
00:11:27,910 --> 00:11:28,850
لستما جائعين إذًا؟

146
00:11:29,410 --> 00:11:33,550
!لا! بل جائعان! جائعان يا سانجي-كُن

147
00:11:30,210 --> 00:11:34,480
.حسنًا، أتساءل هل نضج حساء النّوارس

148
00:11:33,550 --> 00:11:34,480
!دعنا نأكل أرجوك

149
00:11:34,480 --> 00:11:35,990
!سانجي-كُن

150
00:11:35,250 --> 00:11:37,350
!أتساءل إن كان سيعجبهم

151
00:11:38,490 --> 00:11:49,470
...إنقاذ، إنقاذ

152
00:11:45,530 --> 00:11:47,760
ما... ما قصّة تلك السّفينة؟

153
00:11:49,470 --> 00:11:52,000
...إنقاذ

154
00:11:50,300 --> 00:11:52,000
!...هذه الأغنية

155
00:12:22,220 --> 00:12:24,490
!لو-لو-لو-لوفي! زورو

156
00:12:24,490 --> 00:12:27,420
!لماذا أنتما مصابان؟! ماذا حدث؟

157
00:12:27,420 --> 00:12:29,790
!نامي-سان! هل أنت بخير؟

158
00:12:30,990 --> 00:12:33,060
!نا-نادوا الطّبيب

159
00:12:33,060 --> 00:12:34,370
!أنت هو، فاذهب لتفقّدهما

160
00:12:34,370 --> 00:12:35,370
...هذا مؤلم

161
00:12:38,200 --> 00:12:42,810
حسنًا، أيّ نوع من وحوش موغيرا قاتلتما؟

162
00:12:43,970 --> 00:12:47,440
،كانوا قراصنة. لكن لا بأس
.انتهى الأمر الآن

163
00:12:47,440 --> 00:12:48,010
.نعم

164
00:12:48,480 --> 00:12:52,350
،حتّى إن كان انتهى في نظركما
!فلم ينتهِ في نظري أنا

165
00:12:52,350 --> 00:12:53,980
!ما بالكما؟! أنتما رجلان، صحيح؟

166
00:12:53,980 --> 00:12:57,320
،عندما يستفزّكما شخص ما
!عليكما الذّهاب وإيساعه ضربًا

167
00:12:57,320 --> 00:13:02,130
في الحقيقة، أو بالأحرى، لماذا لا تفجّران
!هذه البلدة المزعجة بالكامل؟

168
00:13:02,760 --> 00:13:04,960
!إذًا ما كان ما قلتِه قبل قليل؟

169
00:13:05,460 --> 00:13:08,470
ما فات قد مات! لا تتحدّث
!عمّا أمسى تاريخًا الآن

170
00:13:08,470 --> 00:13:09,730
!أتريدني أن أضربك أنا؟

171
00:13:10,100 --> 00:13:13,640
مهلاً، لماذا هي في مزاج سيّئ
رغم أنّها لم تتأذَّ؟

172
00:13:13,970 --> 00:13:15,610
.لا أدري

173
00:13:16,240 --> 00:13:18,880
صحيح! هل حصلتم على أيّ
معلومات عن جزيرة السّماء؟

174
00:13:19,280 --> 00:13:21,450
جزيرة... السّماء...؟

175
00:13:23,150 --> 00:13:26,980
،"من يهتمّ؟! كلّ ما فعلتُه هو ذكر "جزيرة السّماء

176
00:13:26,980 --> 00:13:28,820
.وبدأ كلّ من في الحانة بالضّحك

177
00:13:28,820 --> 00:13:31,420
!هل قلتُ شيئًا مضحكًا؟

178
00:13:32,160 --> 00:13:33,460
!ما بالهم؟

179
00:13:33,460 --> 00:13:35,160
!الهجوم الخاصّ: نجم الكتشب

180
00:13:35,160 --> 00:13:36,890
!نقطة تعزيز الحماية

181
00:13:37,160 --> 00:13:40,500
.المكان صاخب هنا
لماذا كلّ هذا الانزعاج؟

182
00:13:41,370 --> 00:13:43,370
!مرحبًا يا روبين-تشان

183
00:13:43,370 --> 00:13:46,340
هل أجهّز لك حمّامك
أم تريدين الأكل أوّلاً؟

184
00:13:46,340 --> 00:13:48,540
هل ذهبتِ لمكان ما يا روبين؟

185
00:13:49,170 --> 00:13:53,510
نعم. اشتريتُ بعض الملابس وحصلت
.على معلومات عن جزيرة السّماء

186
00:13:53,880 --> 00:13:55,880
!هذا صحيح! أنت يا روبين

187
00:13:55,880 --> 00:13:57,210
!نقطة تعزيز القفز

188
00:13:55,880 --> 00:13:59,120
حدث كلّ هذا لأنّك بدأت الحديث
!عن جزيرة السّماء تلك

189
00:13:59,120 --> 00:14:00,480
،إن كانت غير موجودة

190
00:14:00,480 --> 00:14:01,520
!مهلاً يا تشوبّر

191
00:14:00,480 --> 00:14:02,690
!فسأرسلك إلى قبر من الماء

192
00:14:03,050 --> 00:14:05,590
!دعيها وشأنها الآن

193
00:14:05,590 --> 00:14:09,490
أو بالأحرى، لا تقتربي منها لكي
.لا تسبّبي فوضى أكثر على السّفينة

194
00:14:11,400 --> 00:14:12,900
.تفضّل أيّها القائد

195
00:14:12,900 --> 00:14:14,730
!إنّها خريطة كنز

196
00:14:14,730 --> 00:14:17,970
ماذا؟ أليست مجرّد خريطة عاديّة؟
لأيّ مكان هي؟

197
00:14:17,970 --> 00:14:18,900
.إنّها لهذه الجزيرة

198
00:14:19,640 --> 00:14:22,910
البلدة الّتي على اليسار هي
.موكتاون حيث نحن الآن

199
00:14:23,210 --> 00:14:26,540
وهل ترون علامة × على الجانب الآخر؟

200
00:14:26,910 --> 00:14:30,180
سمعتُ أنّ رجلاً لا ينتمي
.إلى جايا يعيش هناك

201
00:14:30,180 --> 00:14:31,580
!لا ينتمي لها؟

202
00:14:31,820 --> 00:14:34,320
.اسمه مونبلان كريكت

203
00:14:35,690 --> 00:14:38,920
رجل يتحدّث عن الأحلام
.ونُفي من هذه البلدة

204
00:14:38,920 --> 00:14:40,560
قد تكون لديكما مواضيع
.مشتركة للحديث عنها

205
00:14:43,230 --> 00:14:44,700
حسنًا، لماذا لا نجرّب الذّهاب إلى هناك؟

206
00:14:44,700 --> 00:14:49,830
لكن مهلاً يا لوفي. لستُ واثقًا
...أنّ علينا الذّهاب الآن لأنّ

207
00:14:49,830 --> 00:14:51,600
صحيح يا تشوبّر، رأيتها أيضًا، أليس كذلك؟

208
00:14:55,310 --> 00:14:57,370
ما الّذي تفعلانه؟

209
00:14:57,370 --> 00:14:59,080
!طننتُ أنّني سأموت

210
00:14:59,310 --> 00:15:01,710
.يا إلهي، أنت مزعج فعلاً

211
00:15:01,710 --> 00:15:03,080
...لكنّ نامي كانت

212
00:15:03,080 --> 00:15:05,420
!ماذا؟! كنتُ ماذا؟

213
00:15:05,420 --> 00:15:07,280
!أتحاول القول أنّني مجرّد غبيّة؟

214
00:15:11,620 --> 00:15:16,030
!أيّها الزّعيم الكبير
!اكتملت التّجهيزات تحت البحر

215
00:15:16,030 --> 00:15:17,360
!الميكروفون جاهز أيضًا

216
00:15:17,360 --> 00:15:20,560
!حسنًا! لنبدأ البحث بالسّونار

217
00:15:54,800 --> 00:15:58,270
!معكم غطّاس الأوتان رقم 27
!تمّ تأكيد استجابة للسّونار

218
00:15:58,270 --> 00:16:00,100
تمّ كشف سرب من الأسماك
!على يسارنا مباشرة

219
00:16:00,100 --> 00:16:02,940
،وفق سرعة سباحتها
.حدّدنا أنّها أسماك الصّوري

220
00:16:03,340 --> 00:16:05,540
!حسنًا! سنشويها جميعها على العشاء

221
00:16:06,940 --> 00:16:09,380
!معكم الغطّاس رقم 4
!تمّ تأكيد استجابة للسّونار

222
00:16:09,650 --> 00:16:12,580
!تمّ اكتشاف سفينة صغيرة على البحر

223
00:16:13,680 --> 00:16:17,550
!ماذا؟! سفينة؟ حدّدوا اتّجاهها بالضّبط

224
00:16:17,960 --> 00:16:21,730
!إنّها... تبحر أمامنا مباشرة

225
00:16:22,060 --> 00:16:24,290
!إنّها قريبة كفاية لنراها بالفعل

226
00:16:25,060 --> 00:16:28,970
أوقفوا البحث وعودوا للسّفينة
!يا غطّاسي الأوتان

227
00:16:37,410 --> 00:16:40,310
لم نتأخّر كثيرًا حتّى التقينا
...بشيء غريب آخر

228
00:16:40,310 --> 00:16:44,180
.لكنّهم لا يبدون كالأشخاص السّابقين يا أوسوبّ

229
00:16:44,180 --> 00:16:47,750
حسنًا، سواء كان ذلك شيئًا جيّدًا
.أم سيّئًا، فتلك قصّة أخرى

230
00:16:48,350 --> 00:16:51,160
!على أيّ حال، رأيناهم بالفعل، صحيح؟

231
00:16:51,160 --> 00:16:55,690
نعم. منقذ السّفن ذاك
!من هذه الجزيرة كما توقّعنا

232
00:16:55,690 --> 00:16:57,700
!رأينا سفينته تعود

233
00:16:58,730 --> 00:17:01,330
.لكنّني لا أمانع رؤيته ثانية

234
00:17:01,700 --> 00:17:07,340
!مهلاً، يا رجال! كفاكم ثرثرة

235
00:17:10,110 --> 00:17:13,740
!يا إلهي، تحمّست كثيرًا متسائلاً من تكونون

236
00:17:16,150 --> 00:17:19,120
!لديك وجه متهوّر يا هذا
!من أيّ نوع أنت؟

237
00:17:19,120 --> 00:17:20,720
!أنا بشريّ أيّها الغبيّ

238
00:17:20,720 --> 00:17:24,490
!أيّها الأوغاد! ألا تعرفون شوجو-ساما؟

239
00:17:24,490 --> 00:17:27,560
إنّه الزّعيم الكبير لقراصنة شوجو
!وملك اكتشاف الأعماق

240
00:17:27,560 --> 00:17:29,790
!لا تغضبوا زعيمنا الكبير

241
00:17:30,590 --> 00:17:32,760
...لا بأس، لا بأس

242
00:17:33,560 --> 00:17:36,300
.يبدو أنّكم قراصنة

243
00:17:36,670 --> 00:17:41,840
هل تعرفون أنّ الشّيتشيبوكاي
كروكودايل هُزم؟

244
00:17:41,840 --> 00:17:48,510
،عند التّفكير في قدراتي
.فقد يكون ذلك المنصب لي

245
00:17:48,510 --> 00:17:51,550
.لذلك بدأت أتحمّس كثيرًا منتظرًا الدّعوة

246
00:17:52,280 --> 00:17:55,390
هكذا إذًا... تريد أن تصبح أحد الشّيتشيبوكاي؟

247
00:17:55,390 --> 00:17:59,960
حسنًا، على أيّ حال، أعظم جانب منّي

248
00:17:59,960 --> 00:18:04,700
هو أنّني لم أقصّ شعري طوال حياتي
.ذات الخمسة والعشرين سنة

249
00:18:04,700 --> 00:18:08,000
حسنًا، ألستم متفاجئين؟

250
00:18:09,230 --> 00:18:10,130
.يبدو هذا غبيًّا

251
00:18:10,530 --> 00:18:12,100
!فاجأتني

252
00:18:12,440 --> 00:18:14,100
!انتبه لكلامك أيّها الوغد

253
00:18:14,100 --> 00:18:19,580
لا بأس، لا بأس... ما تقوله
.يزيدني حماسًا بالفعل

254
00:18:20,110 --> 00:18:27,420
اسمع. ستخرجون من نفق
.غضبي إلى بحر من الدّم

255
00:18:28,090 --> 00:18:31,060
.لا يهمّ... لكن ثمّة مكان نريد الذّهاب إليه

256
00:18:31,060 --> 00:18:31,960
.لذلك ابتعد عن الطّريق

257
00:18:32,390 --> 00:18:36,030
!غبيّ! هذه المنطقة منطقتي أنا

258
00:18:36,030 --> 00:18:39,130
!إن أردتَ المرور، فعليك الدّفع

259
00:18:39,760 --> 00:18:43,570
ما الّذي يقصده بمنطقته؟
.إنّه يتحدّث مثل ماسيرا

260
00:18:43,570 --> 00:18:45,900
ماذا؟ هل قال ماسيرا أشياءً كهذه؟

261
00:18:45,900 --> 00:18:49,410
ماذا؟ ماسيرا؟ ماذا بشأن ماسيرا؟

262
00:18:49,410 --> 00:18:54,040
...لقد ركلناه خارج سفينتنا، لكن

263
00:18:53,240 --> 00:18:55,880
!ر-ركلتموه... ركلتموه...؟

264
00:18:56,350 --> 00:18:57,050
!أيّها الزّعيم الكبير

265
00:18:57,050 --> 00:18:59,680
ركلتموه؟ كيف تجرؤون
!على فعل ذلك بأخي؟

266
00:18:59,680 --> 00:19:02,520
!هذا انتقام لماسيرا

267
00:18:59,820 --> 00:19:02,520
.مهلاً، انتظر لحظة

268
00:19:02,520 --> 00:19:04,120
!لقد ركلناه بالفعل، لكنّه ما زال حيًّا

269
00:19:06,820 --> 00:19:09,160
!الموجة الصّوتيّة

270
00:19:09,490 --> 00:19:11,560
!سونار الدّمار

271
00:19:27,540 --> 00:19:28,580
...إنّ السّفينة

272
00:19:33,780 --> 00:19:36,650
حسنًا... ما الّذي يفعلونه؟

273
00:19:35,420 --> 00:19:36,650
!أيّها الزّعيم الكبير

274
00:19:36,650 --> 00:19:38,460
...إن استعملتَ ذلك على السّفينة، فسوف

275
00:19:36,650 --> 00:19:39,120
.من يدري؟ لكنّ ذلك رائع

276
00:19:38,460 --> 00:19:41,130
!كلاّ! لقد أعماه الغضب

277
00:19:39,120 --> 00:19:41,730
.إنّه يدمّر سفينتهم بصوته

278
00:19:42,130 --> 00:19:46,430
يا رفاق! كفاكم تفرّجًا
!ولنغادر بينما نستطيع ذلك

279
00:19:46,630 --> 00:19:48,070
!حسنًا

280
00:19:48,070 --> 00:19:50,100
.مهلاً، لم تعد نامي شيطانة

281
00:19:50,100 --> 00:19:51,300
!فعلاً؟

282
00:19:51,300 --> 00:19:54,340
نعم، يجب أن تكون هدأت
.بعد تفريغ كلّ غضبها

283
00:19:57,640 --> 00:19:59,140
!مـ-مهلاً لحظة

284
00:20:00,610 --> 00:20:03,580
!هذا سيّئ! وصلت الموجات إلى سفينتها

285
00:20:03,810 --> 00:20:06,820
،بدأت السّفينة تتداعى
!وخاصّة المناطق المرمّمة

286
00:20:06,820 --> 00:20:09,650
!هيكل السّفينة متهالك بما يكفي كما هو

287
00:20:10,120 --> 00:20:13,620
!ستتداعى السّفينة أكثر إن بقينا هنا

288
00:20:13,920 --> 00:20:17,230
!انطلقوا بأقصى سرعة
!لنبتعد عن موجات صوته

289
00:20:52,060 --> 00:20:54,300
.لكنّني كنت متفاجئًا

290
00:20:54,300 --> 00:20:56,170
،ثمّ قالت تلك المرأة الجميلة

291
00:20:56,400 --> 00:21:01,110
"!أخبروني أين يعيش كريكت هذا"

292
00:21:02,210 --> 00:21:03,740
!يا لها من امرأة جريئة

293
00:21:03,740 --> 00:21:06,780
!جريئة؟ لقد كانت قويّة

294
00:21:06,780 --> 00:21:09,750
كانت لديها أيادٍ غامضة
،تنبثق من كلّ مكان

295
00:21:09,750 --> 00:21:13,450
.وأطاحت بكلّ من كان في الحانة
!لم يكن ذلك مضحكًا

296
00:21:17,050 --> 00:21:20,860
لكن ما الّذي تريده من العجوز كريكت؟

297
00:21:21,430 --> 00:21:25,000
.البحر حولنا هنا تابع للأخوين القردين

298
00:21:25,700 --> 00:21:28,630
،وأيضًا، إن كان للأمر علاقة بذلك العجوز

299
00:21:29,300 --> 00:21:31,240
.فستُصاب بغبائه

300
00:21:32,300 --> 00:21:33,400
.ستكون تلك مشكلة

301
00:21:34,300 --> 00:21:37,610
ما تسعى إليه تلك المرأة
.هو سبيكة الذّهب بلا شكّ

302
00:21:37,610 --> 00:21:38,640
!سبيكة ذهب؟

303
00:21:38,640 --> 00:21:40,710
نعم. سمعتُ أنّه عُثر
.حديثًا على سبيكة ذهب

304
00:21:40,710 --> 00:21:42,250
فعلاً؟ أين؟

305
00:21:42,250 --> 00:21:43,910
...يا رجال

306
00:21:45,380 --> 00:21:46,650
!بيلامي

307
00:21:47,320 --> 00:21:49,450
ما سبيكة الذّهب هذه الّتي تتحدّثون عنها؟

308
00:21:50,350 --> 00:21:56,030
...ذلك المدعوّ كريكت
.أريد فعلاً أن ألقاه أيضًا

309
00:22:01,030 --> 00:22:03,430
!أخبروني بكلّ شيء عنه

310
00:22:09,350 --> 00:22:17,420
آه، خلف السّماء الّتي لا نهاية لها

311
00:22:17,420 --> 00:22:28,030
المستقبل الّذي رأيتُه مرّة أخذ يصبح واقعًا

312
00:22:35,910 --> 00:22:43,350
مرّت عليّ أيّام كدت أخسر فيها نفسي

313
00:22:43,350 --> 00:22:51,760
وعندما حدث ذلك، كان هنالك مكان
دافئ أستطيع أن أقصُده

314
00:22:51,760 --> 00:22:59,970
الأصدقاء الّذين افتخرتُ بهم
دائمًا وبلا أدنى شكّ

315
00:22:59,970 --> 00:23:08,810
دفعوا بي للأمام، أليس كذلك؟

316
00:23:08,810 --> 00:23:17,120
آه، إنّ النّجوم تهوي من السّماء

317
00:23:17,120 --> 00:23:20,250
...وهذه اللّحظة الفريدة

318
00:23:25,730 --> 00:23:27,630
إذًا فهذا هو... ما كان اسمه؟

319
00:23:27,630 --> 00:23:28,660
.مونبلان كريكت

320
00:23:28,660 --> 00:23:30,230
هذا منزله، صحيح؟

321
00:23:30,230 --> 00:23:33,230
!"ثمّة كتاب صور! عنوانه "نولاند الكذّاب

322
00:23:33,230 --> 00:23:35,500
!يا له من عنوان جيّد

323
00:23:35,500 --> 00:23:38,170
.يعيد هذا الذّكريات لي
.قرأته كثيرًا عندما كنت طفلاً

324
00:23:38,170 --> 00:23:38,870
أتعرفه؟

325
00:23:38,870 --> 00:23:41,510
.نعم. سمعتُ أنّه كان رجلاً حقيقيًّا

326
00:23:41,810 --> 00:23:43,110
:في الحلقة القادمة من ون بيس

327
00:23:43,480 --> 00:23:46,080
".عائلة أسطوريّة! نولاند الكذّاب"

328
00:23:46,080 --> 00:23:48,110
!ملك القراصنة، لن يكون إلاّ أنا