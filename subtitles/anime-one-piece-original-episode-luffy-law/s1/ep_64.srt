1
00:00:27,920 --> 00:00:29,450
...إرادة موروثة

2
00:00:29,450 --> 00:00:31,690
...تعاقب الأزمنة... أحلام النّاس

3
00:00:32,360 --> 00:00:35,190
.لا رادع لهذه الأشياء

4
00:00:35,190 --> 00:00:38,290
ما دام النّاس يسعون باحثين
،عن جواب للحرّيّة

5
00:00:38,290 --> 00:00:40,930
!فلن تختفي هذه الأشياء عن الوجود

6
00:00:49,540 --> 00:00:55,910
لا أؤمن سوى بالمستقبل... ولا أهتمّ لضحك أيِّ كان

7
00:00:55,910 --> 00:01:01,420
يجعل ذلك الشّغفُ المتسارعُ المرءَ يتألّق

8
00:01:01,420 --> 00:01:07,420
إنّه شديد السّطوع، لكنّني أريد التّحديق به

9
00:01:07,420 --> 00:01:10,930
أشعر بـ"الجمال" في كلّ مكان

10
00:01:10,930 --> 00:01:14,230
أنا متمسّك بكم بشدّة بالفعل

11
00:01:14,230 --> 00:01:20,870
أنا أتبع وأتبع خطوات حلم
لا يشبه أيّ أحد

12
00:01:20,870 --> 00:01:24,170
إلى أن أحصل عليه بكلّ إثارة

13
00:01:24,170 --> 00:01:31,180
!آمنوا ببلاد العجائب

14
00:01:33,080 --> 00:01:39,290
سأمسك وأمسك بشكل حلم
لا يستطيع أحد رؤيته

15
00:01:39,290 --> 00:01:45,290
سوف أرافقك أيّتها المشاعر الشّغوفة

16
00:01:45,290 --> 00:01:48,400
لا أحتاج فعلاً ليكون كلّ شيء في مكانه

17
00:01:48,400 --> 00:01:51,730
،بل أريدها حياة عاديّة لا غير

18
00:01:51,730 --> 00:01:54,970
فاركضوا نحو النّعيم بدل ذلك

19
00:01:55,170 --> 00:02:04,910
!آمنوا ببلاد العجائب

20
00:02:13,690 --> 00:02:17,890
بلدة ترحّب بالقراصنة؟"
".الوصول إلى ويسكي بيك

21
00:02:32,940 --> 00:02:35,340
ما قصّة هذا الثّلج؟

22
00:02:35,340 --> 00:02:37,910
.كان الجوّ ساخنًا قبل مدّة قصيرة

23
00:02:40,480 --> 00:02:42,080
!حسنًا! انتهيت

24
00:02:42,580 --> 00:02:45,820
هذا هو الرّجل الّذي سقط
!من السّماء، السّيد برميل الثّلج

25
00:02:47,350 --> 00:02:50,220
...يا له من رجل ثلج بشع

26
00:02:50,220 --> 00:02:50,860
!ماذا؟

27
00:02:51,820 --> 00:02:56,060
انظر لعمليّ الفنّيّ المليء
!بالرّوح، ملكة الثّلج

28
00:02:56,330 --> 00:02:58,060
!مذهل! ذلك رائع

29
00:02:58,060 --> 00:03:00,030
!حسنًا! لكمة برميل الثّلج

30
00:03:05,400 --> 00:03:07,640
!ما الّذي تفعله؟

31
00:03:08,270 --> 00:03:09,670
!السّيّد برميل الثّلج

32
00:03:09,670 --> 00:03:10,810
!كيف تجرؤ؟

33
00:03:11,140 --> 00:03:12,740
!سُحقًا لك! سُحقًا لك! سُحقًا لك

34
00:03:12,940 --> 00:03:15,050
!ما رأيك في هذه؟

35
00:03:15,050 --> 00:03:17,250
!أيّها الوغد! تمهّل يا لوفي

36
00:03:19,350 --> 00:03:23,050
لماذا هما مفعمان بالحيويّة
في هذا الجوّ البارد؟

37
00:03:27,460 --> 00:03:30,360
نامي-سان! كم من تجريف
ثلج الحبّ تريدين منّي أن أفعل؟

38
00:03:30,360 --> 00:03:32,960
واصل حتّى تتوقّف الثّلوج
!يا سانجي-كُن

39
00:03:32,960 --> 00:03:34,700
!حاضر يا نامي-سان

40
00:03:35,100 --> 00:03:39,040
أنتِ. ألا يوجد سخّان في هذه السّفينة؟

41
00:03:39,040 --> 00:03:40,540
.أشعر بالبرد

42
00:03:40,540 --> 00:03:45,010
!اخرسا! أنتما لستما ضيفين
!اخرجا لتجرفا الثّلج أو ما شابه

43
00:03:47,780 --> 00:03:48,780
!برق؟

44
00:03:49,750 --> 00:03:52,750
!ما الّذي يحدث مع هذا الطّقس هنا؟

45
00:03:57,120 --> 00:03:59,190
.كان الجوّ صحوًا قبل مدّة قصيرة

46
00:03:59,190 --> 00:04:02,320
...ثمّ بدأت السّماء تُثلج والآن تُبرق

47
00:04:02,320 --> 00:04:05,230
إنّ المواسم وكذلك الطّقس
.تحدث بشكل عشوائيّ

48
00:04:05,230 --> 00:04:07,200
.تمامًا كما قال كروكس-سان

49
00:04:07,460 --> 00:04:10,170
.هكذا هو الحال في الغراند لاين

50
00:04:10,170 --> 00:04:12,670
.يبدو أنّك جاهلة بأحوال الغراند لاين

51
00:04:13,370 --> 00:04:16,540
لم تقومي بتوجيه السّفينة لمدّة طويلة
الآن. ألا بأس بذلك بالفعل؟

52
00:04:17,940 --> 00:04:20,110
.تحقّقتُ للتّوّ من الاتّجاه

53
00:04:24,010 --> 00:04:24,850
ماذا هناك؟

54
00:04:24,850 --> 00:04:25,950
ما الخطب؟

55
00:04:25,950 --> 00:04:27,780
!هل من خطب ما يا نامي-سان؟

56
00:04:29,050 --> 00:04:30,090
!مستحيل

57
00:04:30,450 --> 00:04:33,150
!أديروا السّفينة 180 درجة! بسرعة

58
00:04:33,150 --> 00:04:36,120
‫180 درجة؟! لماذا سنعود أدراجنا؟!

59
00:04:36,120 --> 00:04:37,290
هل نسينا شيئًا ما؟

60
00:04:37,630 --> 00:04:40,800
استدارت السّفينة وهي تسير
!الآن في الاتّجاه المعاكس

61
00:04:40,800 --> 00:04:43,600
عندما أبعدتُ نظري عن اللوغ
...بوس للحظة

62
00:04:44,230 --> 00:04:45,930
...كانت الأمواج هادئة قبل قليل

63
00:04:46,270 --> 00:04:49,070
هل أنت ملاّحة بالفعل؟

64
00:04:49,940 --> 00:04:55,740
لا يمكن الوثوق بالرّياح والسّماء والأمواج
...والغيوم أو أيّ شيء في هذا البحر

65
00:04:55,740 --> 00:04:59,980
الشّيء الوحيد الّذي لا يتغيّر هو الاتّجاه
.الّذي تشير إليه اللوغ بوس

66
00:04:59,980 --> 00:05:01,550
هل تفهمين ذلك؟

67
00:05:02,880 --> 00:05:06,520
كفاكما من أمرًا ونهيًا عليّ والبطّانيّات
!تلفّكما واخرجا للمساعدة

68
00:05:07,090 --> 00:05:08,420
!شدّوا عمود الشّراع

69
00:05:08,420 --> 00:05:11,830
!واجهوا الرّياح من الميمنة
!أديروا السّفينة 180 درجة يسارًا

70
00:05:11,830 --> 00:05:12,930
!أوسوبّ! تولّ الشّراع المثلّث

71
00:05:12,930 --> 00:05:13,260
!حاضر

72
00:05:13,260 --> 00:05:14,360
!سانجي-كُن! تولّ المقود

73
00:05:14,360 --> 00:05:15,230
!أنا لها يا نامي-سان

74
00:05:15,530 --> 00:05:17,000
!أنتما! أعتمد عليكما

75
00:05:17,000 --> 00:05:19,200
.إنّها تشغّلنا كالعبيد

76
00:05:19,730 --> 00:05:21,970
.مهلاً! تغيّرت الرّياح

77
00:05:21,970 --> 00:05:22,940
!مستحيل

78
00:05:26,840 --> 00:05:28,240
!إنّها أولى نفحات الرّبيع

79
00:05:28,240 --> 00:05:29,010
لماذا؟

80
00:05:29,340 --> 00:05:32,250
!لا تنم فحسب والثّلوج تتراكم عليك

81
00:05:34,580 --> 00:05:37,850
!يا رفاق! رأيتُ دلفينًا يقفز هناك
.لنذهب إليه

82
00:05:37,850 --> 00:05:39,320
!أنت اخرس

83
00:05:43,560 --> 00:05:45,360
!إنّ الأمواج ترتفع

84
00:05:45,360 --> 00:05:47,090
أرى جبلاً جليديًّا في اتّجاه
!السّاعة العاشرة

85
00:05:47,460 --> 00:05:48,930
!نامي-سان! الضّباب ينتشر

86
00:05:48,930 --> 00:05:51,200
!ما خطب هذا البحر؟

87
00:05:51,530 --> 00:05:54,770
!ما-ما... سنصطدم به

88
00:06:11,080 --> 00:06:13,180
اسمعي! ثمّة مياه تتسرّب
!من أسفل السّفينة

89
00:06:13,180 --> 00:06:14,320
!علينا ترقيع التّسرّب حالاً

90
00:06:14,320 --> 00:06:14,950
!أنا لها

91
00:06:19,090 --> 00:06:20,630
!تتحرّك السّحب بسرعة

92
00:06:25,460 --> 00:06:26,700
!ثمّة رياح قادمة

93
00:06:27,800 --> 00:06:28,370
!إنّها قويّة

94
00:06:29,100 --> 00:06:30,000
!إنّها قادمة

95
00:06:32,040 --> 00:06:34,410
!لفّوا الأشرعة! الرّياح قويّة جدًّا

96
00:06:34,410 --> 00:06:36,410
!سوف ننقلب إن واجهناها مباشرة

97
00:06:36,940 --> 00:06:39,540
!يا رفاق! وقت الطّعام
!لنستجمع قوّتنا

98
00:06:42,350 --> 00:06:43,980
!أنت تأكل الكثير

99
00:06:47,150 --> 00:06:49,290
!مصيبة! سيتمزّق الشّراع

100
00:06:49,290 --> 00:06:51,490
.انس بشأن الأمور هنا
!أصلح أسفل السّفينة

101
00:06:51,490 --> 00:06:53,220
!تضرّر جزء آخر من أسفل السّفينة

102
00:06:53,220 --> 00:06:54,390
!سُحقًا

103
00:07:20,450 --> 00:07:22,620
.كان ذلك جيّدًا

104
00:07:31,960 --> 00:07:36,400
،لا يهمّ كم أنّ الجوّ صحو
.لا يجب عليكم أن تتكاسلوا

105
00:07:37,400 --> 00:07:39,400
.من الأفضل أن نكون في الطّريق الصّحيح

106
00:07:39,770 --> 00:07:42,040
...يا لك من

107
00:07:43,640 --> 00:07:45,440
لماذا أنتما على متن هذه السّفينة؟

108
00:07:45,440 --> 00:07:46,610
!فهمك بطيء

109
00:07:47,440 --> 00:07:51,510
.نحن في طريقنا إلى بلدتهما الآن
.إنّها تدعى ويسكي بيك

110
00:07:51,510 --> 00:07:55,380
تقصد أنّنا سنعيدهما لبلدتهما؟
.لا تدين لهما بأيّ شيء

111
00:07:55,380 --> 00:07:56,980
.نعم، معك حقّ

112
00:07:57,690 --> 00:07:59,350
...حسنًا، ذلك لا يهمّني

113
00:08:00,190 --> 00:08:03,320
نعم، نعم، واضح من وجهيكما
.أنّكما لا تنويان على خير

114
00:08:03,690 --> 00:08:05,590
ما كانت أسماؤكما؟

115
00:08:06,430 --> 00:08:08,960
.أ-أنا سيّد 9

116
00:08:09,430 --> 00:08:11,300
.وأنا آنسة وينزداي

117
00:08:11,670 --> 00:08:16,870
صحيح... هنالك شيء ما يزعجني
...مذ أن سمعتُ باسميكما

118
00:08:17,400 --> 00:08:21,110
أشعر وكأنّني سمعتها من قبل
...أو ما شابه

119
00:08:22,340 --> 00:08:24,010
...حسنًا، في كلّ الأحوال

120
00:08:26,880 --> 00:08:31,020
كيف تجرؤ على النّوم بكلّ
راحة طوال هذا الوقت...؟

121
00:08:31,020 --> 00:08:34,120
...تواصل النّوم مهما حاولنا إيقاظك

122
00:08:34,120 --> 00:08:35,360
!ماذا؟

123
00:08:40,460 --> 00:08:44,430
!لا ترخوا دفاعاتكم يا رفاق
.لا ندري ما قد يحدث ثانية

124
00:08:44,800 --> 00:08:47,270
تمكّنت أخيرًا من إدراك
.خطر هذا البحر للتّوّ

125
00:08:47,700 --> 00:08:50,240
.تمكّنت من إدراك سبب تسميته بالغراند لاين

126
00:08:51,600 --> 00:08:56,480
لا شكّ في الأمر، بما أنّ مهاراتي
.الملاحيّة لا تفيد على الإطلاق

127
00:08:57,280 --> 00:09:00,780
يا للصّراحة... هل سنكون بخير؟

128
00:09:01,710 --> 00:09:04,720
.سنكون بخير! سننجح في رحلتنا بكلّ تأكيد

129
00:09:05,150 --> 00:09:06,820
...في الحقيقة

130
00:09:06,820 --> 00:09:10,290
.انظروا! انتهت رحلتنا الأولى

131
00:09:22,900 --> 00:09:24,370
!إنّها جزيرة

132
00:09:26,570 --> 00:09:28,410
...تلك هي ويسكي بيك

133
00:09:29,510 --> 00:09:32,410
.لكنّها جزيرة غريبة المظهر بالفعل

134
00:09:32,410 --> 00:09:34,680
!أشجار الصّبّار تلك ضخمة

135
00:09:38,780 --> 00:09:40,820
.سنغادر الآن

136
00:09:40,820 --> 00:09:43,120
.شكرًا لإيصالنا لموطننا يا أعزّائي

137
00:09:43,120 --> 00:09:44,760
!سنلتقي ثانية إن كان القدر سيجمعنا

138
00:09:45,690 --> 00:09:47,220
!مع السّلامة يا أعزّائي

139
00:09:53,800 --> 00:09:55,200
...لقد ذهبا

140
00:09:55,200 --> 00:09:57,500
من كانا من الأساس؟

141
00:09:57,500 --> 00:09:59,640
!من يهتمّ؟ سوف نُرسي

142
00:10:00,670 --> 00:10:04,440
ثمّة نهر أمامنا. يبدو أنّ بإمكاننا
.الإبحار فيه بالسّفينة

143
00:10:06,980 --> 00:10:10,480
هـ-هل ممكن أنّ هنالك
وحوشًا أو ما شابه؟

144
00:10:10,910 --> 00:10:14,550
.ذلك احتمال وارد بالتّأكيد
.نحن في الغراند لاين

145
00:10:14,550 --> 00:10:17,520
سنغادر الجزيرة ببساطة
.إن قابلنا وحوشًا

146
00:10:18,150 --> 00:10:19,560
.مهلاً لحظة

147
00:10:19,560 --> 00:10:24,490
لا تنس أنّ علينا البقاء على
.هذه الجزيرة لمدّة معيّنة

148
00:10:25,190 --> 00:10:26,200
لماذا؟

149
00:10:26,860 --> 00:10:30,200
ما لم نسجّل مجال هذه الجزيرة
،المغناطيسيّ في اللوغ بوس

150
00:10:30,200 --> 00:10:32,570
.فلن نستطيع الذّهاب للجزيرة التّالية

151
00:10:32,570 --> 00:10:35,700
بما أنّ كلّ جزيرة تحتاج لوقت
،مختلف لتسجيل مجالها

152
00:10:35,700 --> 00:10:38,670
تتطلّب بعض الجزر بضع
.ساعات فقط، بينما أخرى أيّامًا

153
00:10:39,140 --> 00:10:43,080
إ-إذًا حتّى إن كانت جزيرة وحوش
،نودّ الهرب منها في الحال

154
00:10:43,080 --> 00:10:47,120
فمن الممكن أن يكون علينا البقاء هنا
لعدّة أيّام إلى أن نسجّل المجال؟

155
00:10:47,120 --> 00:10:48,520
.هذا صحيح

156
00:10:49,250 --> 00:10:52,720
حسنًا، بإمكاننا التّفكير في ذلك
!عندما يحدث. فدعونا نذهب

157
00:10:53,050 --> 00:10:57,030
.لوفي على حقّ. فلنذهب
.لا يستحقّ الأمر التّفكير فيه

158
00:10:57,030 --> 00:11:00,730
.سأحمي نامي-سان مهما حدث

159
00:11:01,200 --> 00:11:05,170
...مـ-مهلاً يا رفاق. مرضي المزمن قد

160
00:11:05,170 --> 00:11:07,170
..."أعاني مرض "لا تذهب للجزيرة

161
00:11:07,170 --> 00:11:08,400
.لنذهب إذًا

162
00:11:08,400 --> 00:11:11,640
اسمعوا. كونوا متأهّبين للهرب
.كما أنتم متأهّبين للقتال

163
00:11:09,140 --> 00:11:09,840
...كلاّ

164
00:11:11,640 --> 00:11:16,380
...حسنًا... كما قلت، مرضي المزمن

165
00:11:16,380 --> 00:11:18,110
...أعتقد أنّكم لا تستمعون لي

166
00:11:18,410 --> 00:11:20,580
...أتساءل ما الّذي سيظهر

167
00:11:21,050 --> 00:11:22,980
...أ-أرجوك

168
00:11:35,900 --> 00:11:38,300
.انظروا، سفينة قراصنة

169
00:11:40,170 --> 00:11:42,000
!أتى القراصنة

170
00:12:11,030 --> 00:12:13,270
.ماذا؟ ثمّة شيء يتحرّك

171
00:12:13,600 --> 00:12:15,770
!بشر؟ إنّهم بشر

172
00:12:16,970 --> 00:12:18,540
.يا رفاق، كونوا حذرين

173
00:12:18,840 --> 00:12:22,240
،سُحقًا! بما أنّ الأمر آل إلى هذا
.فقد جهّزت نفسي

174
00:12:23,180 --> 00:12:27,310
،سواء كنتم وحوشًا أم لا
!فأظهروا أنفسكم

175
00:12:38,820 --> 00:12:40,660
!مرحبًا بكم في الغراند لاين

176
00:12:40,660 --> 00:12:42,390
!مرحبًا بكم في بلدتنا

177
00:12:42,390 --> 00:12:44,630
!إنّها البلدة المضيافة ويسكي بيك

178
00:12:45,200 --> 00:12:49,200
!لـ... ليسوا وحوشًا، إنّهم يرحّبون بنا

179
00:12:51,870 --> 00:12:53,370
ما الّذي يحدث؟

180
00:12:53,370 --> 00:12:56,140
!أيّها القراصنة! مرحبًا في بلدتنا

181
00:12:56,140 --> 00:12:59,440
!مرحى لأبطال البحار

182
00:13:03,880 --> 00:13:05,720
!ثمّة الكثير من الفتيات الجميلات

183
00:13:05,980 --> 00:13:08,790
!انظروا إلى هنا! إنّهم وسيمون

184
00:13:10,650 --> 00:13:15,260
.ربّما القراصنة هم أبطال النّاس

185
00:13:15,530 --> 00:13:17,430
!مرحبًا

186
00:13:21,500 --> 00:13:22,770
...مرحـ

187
00:13:25,140 --> 00:13:27,040
...ما-ما-ما

188
00:13:27,040 --> 00:13:28,400
.مرحبًا بكم

189
00:13:31,640 --> 00:13:36,610
.اسمي إيغارابّوي. أنا عمدة ويسكي بيك

190
00:13:36,610 --> 00:13:39,220
.أنا لوفي. سررت بلقائك

191
00:13:39,580 --> 00:13:41,450
.أيّها العمّ، لقد تماديت في لفّ شعرك

192
00:13:41,780 --> 00:13:45,520
ويسكي بيك بلدة تزدهر بصناعة
.الخمور والموسيقى

193
00:13:45,520 --> 00:13:47,920
.الضّيافة هي فخر بلدتنا

194
00:13:47,920 --> 00:13:50,560
،أمّا خمورنا الّتي نفخر بها
.فهي وفيرة وفرة مياه البحر

195
00:13:50,560 --> 00:13:53,530
هلاّ سمحتم لنا بإقامة حفلة لكم

196
00:13:53,530 --> 00:13:55,900
...لنستمع للقصص الّتي ستروونها

197
00:13:57,800 --> 00:14:00,500
...ما-ما-ما

198
00:14:01,100 --> 00:14:02,640
!عن مغامراتكم؟

199
00:14:02,970 --> 00:14:04,770
!سيسرّنا ذلك

200
00:14:05,910 --> 00:14:06,910
!ممتاز

201
00:14:07,280 --> 00:14:08,410
...ثلاثة أغبياء

202
00:14:08,980 --> 00:14:10,410
،بالمناسبة

203
00:14:10,410 --> 00:14:12,880
كم ستحتاج البوصلة إلى
أن يتمّ تسجيل المجال؟

204
00:14:12,880 --> 00:14:16,720
.تسجيل المجال؟ انسي تلك الأمور المملّة

205
00:14:16,720 --> 00:14:18,620
.ارتاحي فقط بعد رحلتكم الطّويلة

206
00:14:19,020 --> 00:14:23,890
!يا رفاق! استعدّوا للحفلة
!غنوّا للتّرفيه عن المغامرين

207
00:14:24,230 --> 00:14:26,990
!وقت الاحتفال

208
00:14:55,990 --> 00:14:58,930
،ثمّ قلتُ بكلّ روعة

209
00:14:58,930 --> 00:15:02,000
."يا ملوك البحر، لا تلمسوا أصدقائي"

210
00:15:02,530 --> 00:15:05,630
!أنت مذهل

211
00:15:02,530 --> 00:15:05,630
!قائد أوسوبّ

212
00:15:06,000 --> 00:15:10,970
،ولكن بالنّسبة للحزام الهادئ
.فحتّى أنا ارتعشت

213
00:15:10,970 --> 00:15:12,140
!ارتعشتُ حماسًا

214
00:15:12,140 --> 00:15:13,210
!مذهل

215
00:15:13,210 --> 00:15:14,910
!في صّحة أوسوبّ-سان

216
00:15:14,910 --> 00:15:17,880
.حسنًا، اشربي ولا تتهاوني

217
00:15:17,880 --> 00:15:21,010
.لا، شكرًا. أفضّل ألاّ أشرب الكحول

218
00:15:21,010 --> 00:15:22,520
...لا تقلـ

219
00:15:23,720 --> 00:15:26,420
...ما-ما-ما

220
00:15:26,420 --> 00:15:27,890
.لا تقلقي

221
00:15:27,890 --> 00:15:33,030
إنّه مشروب خاصّ مُعدّ من عنب
.فاخر يُستعمل لصنع نبيذ فاخر

222
00:15:33,430 --> 00:15:37,360
،مذاقه كمذاق النّبيذ بعينه
.لكنّه لا يحتوي أيّ كحول

223
00:15:37,660 --> 00:15:39,000
...هكذا إذًا

224
00:15:40,330 --> 00:15:42,170
!معك حقّ! إنّه لذيذ

225
00:15:42,470 --> 00:15:44,770
.كان حصاد العنب وفيرًا هذه السّنة أيضًا

226
00:15:44,770 --> 00:15:49,170
والآن، سنقيم مسابقة تقديم النّخب
.الاعتياديّة احتفالاً بالحصاد

227
00:15:49,810 --> 00:15:55,080
سنقوم بتقديم نخب تلو الآخر
.وآخر المتبقّين هو الفائز

228
00:15:55,080 --> 00:15:56,380
.انضمّوا لمسابقتنا رجاءً

229
00:15:56,920 --> 00:15:59,780
.لا، شكرًا. لا يمكنني شرب كلّ ذلك

230
00:15:59,780 --> 00:16:03,450
!مبلغ جائزة الفائز هو 100 ألف بيري

231
00:16:04,760 --> 00:16:05,860
!كأس أخرى

232
00:16:06,360 --> 00:16:09,390
!زورو! شارك أنت أيضًا
لا مال لديك، صحيح؟

233
00:16:09,390 --> 00:16:10,190
!ماذا؟

234
00:16:10,190 --> 00:16:11,500
!في صحّتكم

235
00:16:15,370 --> 00:16:17,600
!مهلاً! هذا رائع! لقد أنهى الكأس العاشرة

236
00:16:18,270 --> 00:16:21,170
.يكفي. لا يمكنني شرب المزيد

237
00:16:22,240 --> 00:16:24,880
!أنهت الفتاة كأسها الثّاني عشر

238
00:16:26,480 --> 00:16:28,050
!أجل

239
00:16:28,050 --> 00:16:29,610
!المزيد من الطّعام

240
00:16:29,610 --> 00:16:33,080
!مذهل! أنهى القائد وجبة لعشرين شخص

241
00:16:33,080 --> 00:16:34,620
!انهار الطّبّاخ

242
00:16:35,320 --> 00:16:36,750
...لا يمكنني المواصلة

243
00:16:37,950 --> 00:16:41,860
يحاول هذا الشّابّ مغازلة
!عشرين فتاة في آن واحد

244
00:16:41,860 --> 00:16:43,760
!ما هذا الطّاقم؟

245
00:16:45,400 --> 00:16:47,060
...إنّهم مرحون فعـ

246
00:16:48,630 --> 00:16:51,170
...ما-ما-ما

247
00:16:51,170 --> 00:16:52,670
!مرحون فعلاً

248
00:16:52,670 --> 00:16:56,210
.أنا سعيد لأنّكم تبدون جميعًا مستمتعين

249
00:17:01,380 --> 00:17:04,550
...بل أنا جدّ سعيد بالفعل

250
00:17:05,550 --> 00:17:12,150
ولذلك السّبب، فشلنا في
...مهمّة تأمين الطّعام

251
00:17:12,150 --> 00:17:16,730
ولكن، نودّ أن نبلغكم أنّنا نجحنا

252
00:17:16,730 --> 00:17:22,130
في استدراج الطّاقم لجزيرة
.الصّبّار يا أعزّائي

253
00:17:22,130 --> 00:17:26,700
حسنًا! إن أرسلنا هذه، فسنكون قادرين
.على تبرئة اسمينا بطريقة ما

254
00:17:27,070 --> 00:17:29,670
صحيح. سأضعها في صندوق
.المشؤومين في الحال

255
00:17:35,340 --> 00:17:37,250
...سيوصلانه من أجلنا

256
00:17:41,650 --> 00:17:42,820
...إلى الزّعيم

257
00:17:43,820 --> 00:17:45,720
.هذا يكفي. أستسلم. سأخلد للنّوم

258
00:17:46,590 --> 00:17:50,690
مهلاً! بلغ الشّابّ حدوده أخيرًا
.بعد الكأس الثّالث عشر

259
00:17:50,690 --> 00:17:54,030
!ماذا؟! لا أمل منك يا زورو

260
00:17:54,030 --> 00:17:55,500
.بقي اثنتان فحسب

261
00:17:55,500 --> 00:17:57,670
.لقد وصلا لكأسهما الخامس عشر
.إنّها تنافس الأخت

262
00:17:58,600 --> 00:18:01,200
،عليك أن تتوقّفي قريبًا أيضًا
.من أجل مصلحتك

263
00:18:01,200 --> 00:18:06,340
لا تكوني سخيفة! لن أستسلم بكلّ
.تأكيد حتّى أحصل على الجائزة

264
00:18:09,240 --> 00:18:12,380
.شكرًا على الطّعام
.لا يمكنني أكل المزيد

265
00:18:12,380 --> 00:18:14,580
!انهار ثلاثة طبّاخين أيضًا

266
00:18:14,580 --> 00:18:16,150
.سعيد لأنّ الطّعام أعجبك

267
00:18:18,280 --> 00:18:19,690
.لا يمكنني المواصلة

268
00:18:20,020 --> 00:18:21,790
!لقد فزت

269
00:18:24,560 --> 00:18:26,590
!كم هذا ممتع

270
00:18:26,590 --> 00:18:28,160
.انهارت أخيرًا

271
00:18:30,200 --> 00:18:32,470
...يا لها من بلدة رائعة

272
00:18:33,570 --> 00:18:36,040
.أنا في النّعيم

273
00:18:45,710 --> 00:18:48,080
إذًا فقد أنهكوا أنفسهم
...بالاحتفال وخلدوا للنّوم

274
00:18:51,650 --> 00:18:52,990
...أحلامًا سعيدة

275
00:18:54,790 --> 00:18:56,520
...أيّها المغامرون

276
00:18:58,590 --> 00:19:03,130
صخور الصّبّار جميلة اليوم أيضًا
.وهي ترقص تحت ضوء القمر

277
00:19:06,900 --> 00:19:11,700
.أنت شاعر بارع يا إيغارابّوي... بل يا سيّد 8

278
00:19:12,100 --> 00:19:13,300
...هذا أنتما

279
00:19:15,270 --> 00:19:16,210
ماذا حدث لهم؟

280
00:19:16,770 --> 00:19:18,010
...لقد انهاروا

281
00:19:21,950 --> 00:19:23,410
...وفي طريقهم للجحيم

282
00:19:26,420 --> 00:19:32,520
،يا إلهي... بما أنّهم كانوا عنيدين جدًّا
.أضفت القليل من الكحول لمشروباتهم

283
00:19:32,790 --> 00:19:35,090
وإلاّ لكانوا لا يزالون مستيقظين
.ويستمتعون بوقتهم

284
00:19:35,460 --> 00:19:40,230
لكن هل كان من الضّروريّ فعلاً
...التّخطيط لكلّ هذا بالتّفصيل

285
00:19:43,370 --> 00:19:45,900
من أجل خمسة ضعفاء فحسب؟

286
00:19:46,370 --> 00:19:52,210
.كان علينا هزيمتهم في الميناء
.تفتقر البلدة للطّعام من الأساس

287
00:19:52,680 --> 00:19:55,150
وأيضًا، لم ترتفع آمالنا من أجل
.لحم الحوت من البداية

288
00:19:55,150 --> 00:19:58,550
!لا داعي لقول ذلك
!لقد بذلنا كلّ ما بوسعنا

289
00:19:58,950 --> 00:20:03,520
.اهدآ. انظروا لهذا
.تحقّقت من أمرهم مسبقًا

290
00:20:04,720 --> 00:20:06,890
!ثـ-ثلاثون مليون بيري؟

291
00:20:06,890 --> 00:20:08,220
!هؤلاء؟

292
00:20:08,520 --> 00:20:13,330
من الغباء الحكم على قدرات القراصنة
...من مظهرهم فحسب يا آنسة مانـ

293
00:20:15,730 --> 00:20:17,470
...ما-ما-ما

294
00:20:17,470 --> 00:20:19,100
.يا آنسة مانداي

295
00:20:19,500 --> 00:20:21,470
.آ-آسفة

296
00:20:22,140 --> 00:20:24,610
.لكنّنا اهتممنا بالأمر سلفًا

297
00:20:24,610 --> 00:20:26,780
يبدو أنّ بإمكاننا إرسال
.تقرير جيّد للزّعيم

298
00:20:26,780 --> 00:20:29,850
صادروا كلّ المال والأشياء الثّمينة
.الّتي على سفينتهم في الحال

299
00:20:29,850 --> 00:20:31,650
وماذا عنهم؟

300
00:20:31,650 --> 00:20:32,550
ماذا سنفعل؟

301
00:20:33,120 --> 00:20:36,020
إن قتلناهم، ستنقص المكافأة
.بنسبة 30 بالمائة

302
00:20:36,380 --> 00:20:39,720
.تسعى الحكومة دائمًا للإعدامات العلنيّة

303
00:20:42,590 --> 00:20:44,730
!اذهبوا! أمسكوهم أحياء

304
00:20:45,530 --> 00:20:48,200
...عفوًا... أنا آسف

305
00:20:50,430 --> 00:20:52,970
لكن هلاّ تركتموهم نائمين؟

306
00:20:52,970 --> 00:20:55,370
.إنّهم متعبون جرّاء رحلتهم هذا المساء

307
00:21:01,510 --> 00:21:03,010
!سيّد 8! آنسة مانداي

308
00:21:03,010 --> 00:21:05,410
لقد هرب الرّجل ذو حزام الهاراماكي
!من الغرفة في غفلةٍ منّا

309
00:21:06,410 --> 00:21:07,580
.إنّه يقف هناك

310
00:21:08,020 --> 00:21:11,290
!وغد! ظننتُ أنّك تغطّ في نوم عميق

311
00:21:12,120 --> 00:21:16,760
إنّ السّيّافين لا يخطئون أبدًا
.ويرخون دفاعاتهم لذلك الحدّ

312
00:21:17,320 --> 00:21:21,230
.لذلك، دعوني أرى إن كنتُ محقًّا
.هذا وكر لصيّادي المكافآت

313
00:21:22,560 --> 00:21:28,000
تخدعون القراصنة ذوي الرّوح العالية
.جرّاء دخولهم توًّا للغراند لاين

314
00:21:28,940 --> 00:21:32,110
.يبدو أنّ ثمّة حوالي 100 صائد مكافآت هنا

315
00:21:33,510 --> 00:21:37,310
!سأقاتلكم جميعًا... يا باروك وركس

316
00:21:37,580 --> 00:21:40,280
!أيّها الوغد! كيف تعرف اسم شركتنا؟

317
00:21:41,150 --> 00:21:46,420
تمّ تجنيدي من طرف شركتكم إحدى
.المرّات عندما كنتُ أمارس نفس عملكم

318
00:21:46,420 --> 00:21:48,250
.لكنّني رفضتُ طبعًا

319
00:21:48,520 --> 00:21:53,160
لا يعرف العاملون هويّات بعضهم
.بعضًا ويستعملون أسماء رمزيّة

320
00:21:53,160 --> 00:21:56,960
وطبعًا يظلّ مخبأ الزّعيم
.وهويّته سرًّا حتّى لهم

321
00:21:56,960 --> 00:22:01,970
الباروك وركس جماعة إجراميّة
.تنفّذ أوامرها بكلّ إخلاص

322
00:22:03,740 --> 00:22:04,800
أكان ذلك سرًّا؟

323
00:22:06,370 --> 00:22:08,210
...هذا مفاجئ

324
00:22:09,470 --> 00:22:13,280
إن كنت تعرف أسرارنا، فلا خيار
.آخر أمامنا سوى قتلك

325
00:22:16,450 --> 00:22:17,820
...سيُضاف شاهد قبر آخر

326
00:22:19,120 --> 00:22:21,790
...لمقبرة صخور الصّبّار

327
00:22:47,540 --> 00:22:48,710
!اقتلوه

328
00:22:53,980 --> 00:22:55,850
!...لـ... لقد اختفى

329
00:23:10,770 --> 00:23:14,600
!أنا إلى جانبك

330
00:23:14,600 --> 00:23:18,310
آهٍ يا لها من أغنية رقيقة

331
00:23:18,310 --> 00:23:24,650
تصل إلى كلينا

332
00:23:25,550 --> 00:23:31,720
هدمت الأمواج تلك القلعة الرّمليّة الصّغيرة

333
00:23:33,160 --> 00:23:40,600
ونظرتَ إلى الغيوم المارّة بابتسامة كئيبة

334
00:23:41,330 --> 00:23:48,570
،حتّى إن امتلأ العالم بأعداء لنا

335
00:23:48,940 --> 00:23:52,240
فأنا أحمي ظهرك دائمًا

336
00:23:52,670 --> 00:24:00,680
فلا تفقد ثقتك

337
00:24:00,680 --> 00:24:04,550
!أنا إلى جانبك

338
00:24:04,550 --> 00:24:08,260
آهٍ يا حبّي

339
00:24:08,260 --> 00:24:14,460
سأمسك بك بين ذراعيّ للأبد

340
00:24:16,160 --> 00:24:19,930
!أنا إلى جانبك

341
00:24:25,240 --> 00:24:27,440
البلدة المضيافة هي
.وكر لصيّادي المكافآت

342
00:24:27,440 --> 00:24:29,410
هل أنت واثق أنّ عليك
إضافة شاهد قبر واحد؟

343
00:24:29,410 --> 00:24:31,810
ألن يأكل أحد ذلك اللّحم؟
.أريد أكله

344
00:24:31,810 --> 00:24:34,380
إنّها فرصة جيّدة لتجربة
كيتتسو الثّالث ويوباشيري

345
00:24:34,380 --> 00:24:35,720
اللّذين حصلتُ عليهما
.في لوغتاون

346
00:24:35,720 --> 00:24:37,780
.يا آنساتي، اقتربن أكثر

347
00:24:37,780 --> 00:24:39,750
!أنا القائد أوسوبّ

348
00:24:39,750 --> 00:24:41,860
!سأقدّم كلّ ما لديّ

349
00:24:42,120 --> 00:24:43,560
:في الحلقة القادمة من ون بيس

350
00:24:43,560 --> 00:24:46,230
!أسلوب السّيوف الثّلاثة المتفجّر"
"!زورو ضدّ شركة باروك وركس

351
00:24:46,230 --> 00:24:48,460
!ملك القراصنة، لن يكون إلاّ أنا