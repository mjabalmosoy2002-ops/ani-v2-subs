1
00:00:40,430 --> 00:00:45,440
في كلّ مرّة أنظر للسّماء بعد أن أمطرت

2
00:00:45,520 --> 00:00:51,150
تأخذني ذكرياتي لوقت كنت فيه بكّاء

3
00:00:51,190 --> 00:00:58,910
كنتُ أطارد ظهر شخص ما

4
00:00:59,030 --> 00:01:01,740
"وأقول "أريد أن أصير أقوى

5
00:01:01,790 --> 00:01:07,210
كلمة "شكرًا" قد اختفت مع الرّياح الآن

6
00:01:07,290 --> 00:01:12,380
فهل أصبح أقوى؟

7
00:01:12,510 --> 00:01:18,050
ما زلت أجهل الإجابة

8
00:01:18,090 --> 00:01:23,390
لهذا السّبب سأواصل السّير للأمام

9
00:01:23,640 --> 00:01:25,810
هيّا بنا

10
00:01:25,890 --> 00:01:29,110
دون توقّف

11
00:01:29,230 --> 00:01:34,440
دون استسلام لمرور الوقت

12
00:01:34,490 --> 00:01:39,910
سأواصل النّهوض على قدميّ

13
00:01:40,030 --> 00:01:45,410
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

14
00:01:45,540 --> 00:01:50,840
ذلك الصّوت في داخلي

15
00:01:50,880 --> 00:01:56,010
يواصل دعمي

16
00:01:56,170 --> 00:02:01,260
والأمطار المخادعة ستعترض طريقي

17
00:02:01,390 --> 00:02:06,100
لكنّني لم أهرب بعيدًا

18
00:02:06,390 --> 00:02:09,400
أوه

19
00:02:09,520 --> 00:02:11,690
هيّا بنا

20
00:02:11,810 --> 00:02:14,980
دون توقّف

21
00:02:15,110 --> 00:02:20,160
دون استسلام لمرور الوقت

22
00:02:20,280 --> 00:02:25,830
سأواصل النّهوض على قدميّ

23
00:02:26,000 --> 00:02:31,380
لأنّني لا أريد أن أخسر شيئًا عزيزًا عليّ

24
00:02:31,460 --> 00:02:39,680
...نحو المستقبل الّذي أؤمن به

25
00:02:47,890 --> 00:02:50,980
.إنّه عصر القراصنة العظيم

26
00:02:50,980 --> 00:02:55,940
حيث يقاتل عدد لا يحصى من
،القراصنة باستماتة من أجل الوان بيس

27
00:02:55,940 --> 00:02:58,610
.الكنز الّذي تُركَ من قبل غولد روجر، ملك القراصنة

28
00:02:59,650 --> 00:03:02,740
مونكي د. لوفي، صبيّ تحوّل جسده إلى مطّاط

29
00:03:02,740 --> 00:03:04,660
،بعد أن أكل فاكهة المطّاط

30
00:03:04,660 --> 00:03:07,540
.قصدَ البحر بدوره سعيًا ليُصبح ملك القراصنة التّالي

31
00:03:07,540 --> 00:03:11,540
،بينما يتجاوز لوفي وأصدقاؤه العديد من المغامرات

32
00:03:11,540 --> 00:03:16,250
أمست حكومة العالم غير قادرة
.على تجاهل وجدوهم أكثر فأكثر

33
00:03:17,460 --> 00:03:19,130
!هذا شيّق

34
00:03:19,840 --> 00:03:22,760
!أيّ مغامرة تنتظرنا يا ترى؟

35
00:03:22,760 --> 00:03:26,340
،بينما يشقّ الطّاقم طريقه إلى العالم الجديد

36
00:03:26,340 --> 00:03:29,650
!فسيتسارعون في الغراند لاين ثانيةً اليوم

37
00:03:34,200 --> 00:03:36,630
،بعد أن فُرّق عن بقيّة طاقمه

38
00:03:36,630 --> 00:03:40,650
وصل لوفي إلى مارين فورد لإنقاذ أخيه
!إيس الّذي كان على وشك أن يُعدَم

39
00:03:41,700 --> 00:03:43,990
!تمكّن لوفي من إنقاذ إيس أخيرًا

40
00:03:44,360 --> 00:03:48,240
لكن، أصاب الأميرال أكاينو إيس في مقتل

41
00:03:48,830 --> 00:03:52,000
!ومات إيس بين ذراعَي لوفي

42
00:03:53,360 --> 00:03:58,930
...الرّجل الّذي ينتظره روجر

43
00:03:59,460 --> 00:04:04,090
!ليس أنت بأيّ حال من الأحوال يا تيتش

44
00:04:05,960 --> 00:04:09,600
.سامحوني يا أبنائي

45
00:04:10,630 --> 00:04:15,100
.ربّيتُ أحمقًا سخيفًا

46
00:04:16,930 --> 00:04:22,150
.لقد منحتموني كلّ شيء

47
00:04:23,060 --> 00:04:24,820
.تقديري لكم عميق

48
00:04:26,600 --> 00:04:30,480
!الوداع يا أولادي

49
00:04:34,800 --> 00:04:39,350
"!يبدأ العرض! تُكشف حبكة اللّحية السّوداء"

50
00:04:40,960 --> 00:04:43,170
!المكتب الرّئيسيّ! المكتب الرّئيسيّ

51
00:04:43,170 --> 00:04:45,760
!هناك أخبار مهمّة من مارينفورد

52
00:04:45,760 --> 00:04:47,600
!أهذا صحيح؟

53
00:04:47,600 --> 00:04:51,130
!هل اللّحية البيضاء فعلاً...؟! هل أنت واثق؟

54
00:04:51,130 --> 00:04:52,980
!...لا أصدّق أنّ اللّحية البيضاء قد

55
00:04:53,560 --> 00:04:56,100
!انتشرت الأخبار عبر العالم كالنّار في الهشيم

56
00:04:56,100 --> 00:05:00,500
"!فشل طاقم اللّحية البيضاء في إنقاذ ابن روجر إيس"

57
00:05:00,500 --> 00:05:04,930
".وموت اللّحية البيضاء، قبطان القراصنة الأسطوريّ"

58
00:05:04,930 --> 00:05:07,820
!المزيد! استعدّوا لطباعة إصدار آخر

59
00:05:08,130 --> 00:05:09,950
!إليكم أخبارًا عاجلة

60
00:05:10,400 --> 00:05:16,030
!مات اللّحية البيضاء بعد موت قبضة النّار إيس بلحظات! أكرّر

61
00:05:16,030 --> 00:05:17,790
...في مارينفورد

62
00:05:16,030 --> 00:05:17,790
...اللّحية البيضاء

63
00:05:17,790 --> 00:05:19,420
!مات

64
00:05:19,420 --> 00:05:22,830
!إذًا هذه نهاية قراصنة اللّحية البيضاء

65
00:05:22,830 --> 00:05:24,670
!ستنتهي الحرب قريبًا

66
00:05:24,670 --> 00:05:26,680
!يمكننا العيش في سلام أخيرًا

67
00:05:27,880 --> 00:05:31,310
النّاس الّذين شهدوا بأعينهم

68
00:05:31,310 --> 00:05:33,250
...الحدث التّاريخيّ الّذي يتمّ تبليغه الآن

69
00:05:33,600 --> 00:05:39,130
.يقفون مذهولين وعاجزين عن الكلام

70
00:05:45,970 --> 00:05:48,910
...رحل اللّحية البيضاء إذًا

71
00:06:03,750 --> 00:06:05,980
.كان في الـ72 من العمر

72
00:06:06,760 --> 00:06:10,550
.وقف في وجه حتّى ملك القراصنة في عصره

73
00:06:10,950 --> 00:06:13,260
كان قبطان قراصنة اللّحية البيضاء

74
00:06:13,260 --> 00:06:15,770
...وكان القرصان العظيم إدوارد نيوغيت

75
00:06:15,770 --> 00:06:18,090
.الملقّب باللّحية البيضاء

76
00:06:18,770 --> 00:06:23,770
...مات في الحرب الحاسمة في خليج مارينفورد بين

77
00:06:23,770 --> 00:06:27,010
قراصنة اللّحية البيضاء ومقرّ البحريّة

78
00:06:27,010 --> 00:06:30,330
.وحلفاؤهم الشّيتشيبوكاي

79
00:06:36,160 --> 00:06:38,250
!هذا مثير للاهتمام

80
00:06:38,250 --> 00:06:41,380
!ستتغيّر الأمور في العالم حقًّا

81
00:06:41,380 --> 00:06:42,800
،لكن حتّى قبل ذلك

82
00:06:43,320 --> 00:06:46,380
!لا أظنّ أنّ الأمور ستسوّى بتلك السّهولة أيضًا

83
00:06:47,090 --> 00:06:52,260
،مع أبشع المجرمين ومدير سجن إمبل داون

84
00:06:52,260 --> 00:06:57,640
.أتساءل ما الّذي ينوي اللّحية السّوداء فعله

85
00:06:58,100 --> 00:06:59,640
ما الّذي سيحدث؟

86
00:06:59,640 --> 00:07:02,400
أهذه نهاية الحرب حقًّا؟

87
00:07:02,400 --> 00:07:06,610
...وأيضًا، الكلام الّذي نطق به اللّحية البيضاء قبل موته

88
00:07:06,650 --> 00:07:09,190
...الوان بيس

89
00:07:10,450 --> 00:07:13,620
!موجود فعلاً

90
00:07:16,160 --> 00:07:19,960
!إنّها مسألة وقت إلى أن يعلم العالم

91
00:07:19,960 --> 00:07:22,880
!أتساءل كيف سيتفاعل القراصنة

92
00:07:22,880 --> 00:07:27,170
لكن حتّى قبل ذلك، أيمكننا أن نقول
أنّ هذه الحرب انتهت حقًّا؟

93
00:07:27,170 --> 00:07:30,880
لِمَ أتى اللّحية السّوداء إلى مارينفورد؟

94
00:07:47,690 --> 00:07:49,780
!ذلك الوغد

95
00:07:49,780 --> 00:07:53,530
!ماركو! الجميع يشعرون مثلك

96
00:07:53,530 --> 00:07:56,370
!لكن من الأفضل أن تحتمل

97
00:07:56,370 --> 00:07:58,560
!أعلم يا فيستا

98
00:08:00,160 --> 00:08:04,830
أسرعوا واصعدوا إلى السّفينة! ألا تذكرون آخر أوامر قبطاننا؟

99
00:08:04,830 --> 00:08:06,290
!إيس

100
00:08:06,290 --> 00:08:07,540
!والدي

101
00:08:18,720 --> 00:08:21,890
!جينبي! أسرع وأحضر أخا إيس

102
00:08:21,890 --> 00:08:23,100
!حسنًا

103
00:08:24,980 --> 00:08:27,320
!إيس-سان! الوالد العجوز

104
00:08:27,320 --> 00:08:31,690
!لم أستطع أن أفعل أيّ شيء لمساعدتكما

105
00:08:31,690 --> 00:08:35,660
!أريد أن أساعد لوفي-كن على الأقلّ

106
00:08:35,660 --> 00:08:38,160
!لا تدعوا القراصنة يهربون

107
00:08:38,160 --> 00:08:40,240
!اقتلوهم جميعًا

108
00:09:21,790 --> 00:09:24,250
!أيّها القبطان باغي، إلى أين أنت ذاهب؟

109
00:09:24,250 --> 00:09:27,920
!هل أنت غبيّ؟! سأخرج من هنا

110
00:09:27,920 --> 00:09:30,670
!لا أستطيع قتل اللّحية البيضاء لأنّه مات بالفعل

111
00:09:30,670 --> 00:09:32,710
!القبطان باغي

112
00:09:32,710 --> 00:09:34,590
!لم أستطع فعلها

113
00:09:34,590 --> 00:09:36,130
!مسار الثّقب المظلم

114
00:09:37,970 --> 00:09:40,640
!أيّها القبطان باغي، هذه فرصتك

115
00:09:40,640 --> 00:09:42,220
!أسرع واقتل اللّحية البيضاء

116
00:09:42,220 --> 00:09:45,770
!واثق أنّك تستطيع تجاوز هذا الشّقّ

117
00:09:45,770 --> 00:09:50,480
!كفّ عن إخباري ما أفعل
!لن يكون من الذّكاء مهاجمته بلا تفكير

118
00:09:50,480 --> 00:09:53,190
!إنّي أنتظر اللّحظة المناسبة

119
00:09:53,190 --> 00:09:55,140
!يظنّون أنّ الأمر سهل

120
00:09:55,140 --> 00:09:55,740
!ماء الظّلام

121
00:09:58,570 --> 00:10:00,660
!ما يعني أنّك ما عدت تستطيع إنشاء الزّلازل

122
00:10:00,660 --> 00:10:04,540
!صحيح! عرف القبطان باغي هذا وانتظر هذه اللّحظة

123
00:10:04,540 --> 00:10:05,960
!دعنا نساعدك

124
00:10:05,960 --> 00:10:07,000
...لا، انتظروا

125
00:10:07,000 --> 00:10:09,380
!ها أنت ذا أيّها القبطان باغي

126
00:10:09,380 --> 00:10:11,340
!مهلاً، مهلاً، مهلاً! انتظروا يا رفاق

127
00:10:11,840 --> 00:10:15,010
!هذا مؤلم! سحقًا

128
00:10:25,950 --> 00:10:29,980
!أ-أذلك ما يستطيع رجل عجوز يُحتضر فعله؟

129
00:10:30,980 --> 00:10:37,820
!لـ-لا! بل ذلك ما يجعله اللّحية البيضاء الأسطوريّ

130
00:10:37,820 --> 00:10:40,680
!كنتُ خائفًا ولم أستطع حتّى الاقتراب منه

131
00:10:40,680 --> 00:10:42,600
!كان اللّحية البيضاء مخيفًا

132
00:10:42,600 --> 00:10:46,330
!ذلك الرّجل في القمّة مخيف، حتّى إن كان ميّتًا

133
00:10:47,880 --> 00:10:54,040
!لا أهتمّ إن ظننتم أنّ أمري ميؤوس
!هذا الوداع أيّها الحمقى

134
00:10:55,420 --> 00:10:56,590
!القبطان باغي

135
00:10:57,000 --> 00:10:59,510
...إنّه يبكي... القبطان باغي

136
00:10:59,510 --> 00:11:01,890
"!فهمت! "عدوّ البارحة قد يكون صديق اليوم

137
00:11:02,160 --> 00:11:07,470
شعر بالشّفقة على منافسه اللّحية البيضاء
!دون أن حتّى أن يُدرك

138
00:11:07,470 --> 00:11:10,100
!أمكنه أن يقتل ذلك الرّجل

139
00:11:10,100 --> 00:11:12,850
!والآن يحاول أن يغادرنا دون أن يصطنع أعذارًا

140
00:11:13,440 --> 00:11:19,070
!ذلك اللّئيم! أرانا شيئًا أكثر أهمّيةً من قتل اللّحية البيضاء

141
00:11:19,510 --> 00:11:25,000
لا أصدّق أنّه اختار الشّفقة بدلاً
!من كلّ الشّهرة الّتي كان سيدركها

142
00:11:26,910 --> 00:11:31,020
!إنّه رجل منقطع النّظير كما علمنا طوال هذا الوقت

143
00:11:31,830 --> 00:11:33,960
!أنت رائع بحقّ أيّها القبطان باغي

144
00:11:33,960 --> 00:11:35,960
!انتظر أيّها القبطان باغي

145
00:11:35,960 --> 00:11:37,300
!دعنا نأتي معك

146
00:11:37,300 --> 00:11:39,280
!أيّها القبطان

147
00:11:48,830 --> 00:11:53,020
!كان عنيدًا حقًّا! من الجيّد رؤيته يسقط ميّتًا أخيرًا

148
00:11:53,020 --> 00:11:57,860
.الأمر يسير كما خطّطنا له حتّى الآن
.حان الوقت أيّها القبطان

149
00:11:58,400 --> 00:12:03,160
!حسنًا، لنبدأ

150
00:12:09,490 --> 00:12:11,500
!إنّهم يخطّطون لفعل شيء ثانيةً

151
00:12:11,500 --> 00:12:13,000
!تيتش، ذلك الوغد

152
00:12:13,000 --> 00:12:15,250
!ماذا سيفعل لوالدي الآن؟

153
00:12:18,090 --> 00:12:19,880
!سأقدّم عرضًا

154
00:12:20,880 --> 00:12:25,090
!إنّه عرض سيهزّ العالم أجمع

155
00:12:26,090 --> 00:12:28,310
!ما ذلك القماش الأسود؟

156
00:12:28,310 --> 00:12:30,890
!دخل اللّحية السّوداء تحته مع جسد اللّحية البيضاء

157
00:12:32,140 --> 00:12:35,560
!والآن، لا تتعدّوا لفترة

158
00:12:36,000 --> 00:12:38,130
!ماذا تفعلون بظنّكم؟

159
00:12:38,130 --> 00:12:41,450
إنّه شخص خدعنا بانضمامه إلى
!الشّيتشيبوكاي الملكيّين فقط لخيانتنا

160
00:12:41,450 --> 00:12:42,490
!ابقوا فطنين

161
00:12:44,700 --> 00:12:46,280
!لا أطيق الانتظار

162
00:12:46,280 --> 00:12:49,660
هل سيحلّ طاقمنا إن فشلنا؟

163
00:12:55,920 --> 00:12:58,630
!أسرعوا! إلى البحر

164
00:12:59,750 --> 00:13:01,550
!لوفي-كن

165
00:13:01,550 --> 00:13:03,160
!تماسك

166
00:13:03,160 --> 00:13:07,390
عليك أن تواصل في هذا العالم حيث
...ما عاد إيس يعيش فيه

167
00:13:07,390 --> 00:13:10,320
!لغدٍ وبعد غد

168
00:13:11,180 --> 00:13:12,430
!أطلقوا

169
00:13:13,270 --> 00:13:17,600
!عليك أن تعيش بقوّة

170
00:13:18,390 --> 00:13:21,940
...جينبي، إلّم أنجُ من الموت

171
00:13:24,260 --> 00:13:28,490
آسف لكن هلاّ اعتنيت بأخي؟

172
00:13:31,940 --> 00:13:34,290
،آسف على مناقضتك يا إيس-سان

173
00:13:34,290 --> 00:13:39,540
.لكن لا ينبغي أن تبالغ في تقديري
.لستُ طيّبًا كما تظنّ

174
00:13:39,540 --> 00:13:43,920
.حتّى إن كان أخاك، نحن في عالم القراصنة

175
00:13:43,920 --> 00:13:49,220
!إنّي أساعد أو أحمي فقط من أحترمه كثيرًا

176
00:13:51,840 --> 00:13:57,440
!لم تتغيّر مشاعري إطلاقًا يا إيس-سان

177
00:13:57,440 --> 00:14:00,880
!لستُ أساعده لأنّه أخوك

178
00:14:07,400 --> 00:14:12,280
!...أحترم لوفي-كن كثيرًا! ولهذا السّبب

179
00:14:19,670 --> 00:14:23,300
!أسرع يا جينبي! عالج لوفي

180
00:14:23,300 --> 00:14:25,920
!أيّها الباسيفيستا! اقتلا قبّعة القشّ

181
00:14:25,920 --> 00:14:30,000
!مع أنّه شيتشيبوكاي، إلاّ أنّ جينبي عدوّنا الآن

182
00:14:30,000 --> 00:14:31,490
!مسموح لنا قتله

183
00:14:34,630 --> 00:14:36,020
!السّاق العطِرة

184
00:14:40,730 --> 00:14:44,270
!بوا هانكوك! هل ستقفين في طريقنا ثانيةً؟

185
00:14:46,680 --> 00:14:50,410
!قبضة النّار إيس واللّحية البيضاء ماتا بالفعل

186
00:14:50,410 --> 00:14:53,370
!لا أحبّ الرّجال العنيدين

187
00:14:57,120 --> 00:15:01,370
!جينبي! اعتن بلوفي جيّدًا رجاءً

188
00:15:01,370 --> 00:15:03,500
!جينبي! اركب هذه السّفينة

189
00:15:03,500 --> 00:15:04,380
!حسنًا

190
00:15:05,800 --> 00:15:06,960
!ما هذا؟

191
00:15:10,630 --> 00:15:13,350
!سحقًا! لقد جمّد البحر

192
00:15:13,350 --> 00:15:14,600
!لا يمكننا المغادرة

193
00:15:14,600 --> 00:15:16,640
!أسرع وافعل شيئًا

194
00:15:16,640 --> 00:15:18,480
!إنّه الأميرال أوكيجي

195
00:15:18,480 --> 00:15:21,060
!أوقفوا أوكيجي

196
00:15:23,310 --> 00:15:25,980
!لا خيار لديّ! سأبحث عن طريق آخر

197
00:15:35,910 --> 00:15:38,540
،عندما أقول أنّني لن أدعكم تهربون

198
00:15:39,130 --> 00:15:42,250
!لِمَ لا تسلّم حياتك أيّها الأحمق

199
00:16:06,520 --> 00:16:10,400
!سلّم لي ابن دراغون

200
00:16:10,400 --> 00:16:13,620
!أكاينو! ليس ميّتًا

201
00:16:13,620 --> 00:16:15,700
!خلتُ أنّه هُزم على يد والدي

202
00:16:15,700 --> 00:16:17,200
...لقد انتقل تحت الأرض

203
00:16:17,200 --> 00:16:18,950
!عبر صنع طريق بالحمم

204
00:16:19,410 --> 00:16:20,850
!جينبي

205
00:16:20,850 --> 00:16:25,880
!لا يمكنني أن أفعل ذلك
...لأنّني حسمتُ أمري بالفعل

206
00:16:25,880 --> 00:16:29,130
!بأن أنقذ حياته وإن كلّفني ذلك حياتي

207
00:16:29,130 --> 00:16:33,010
!حسنًا إذًا، لن أسألك ثانيةً

208
00:16:36,200 --> 00:16:40,850
!كوبي! يريد أكاينو-سان قتل قبّعة القشّ بأيّ ثمن

209
00:16:40,850 --> 00:16:44,690
!فور أن يراك هدفًا، لا يمكنك الهرب منه

210
00:16:45,690 --> 00:16:47,060
...لوفي-سان

211
00:16:50,150 --> 00:16:53,070
!سنحمي أخا إيس

212
00:16:53,070 --> 00:16:55,160
!ذلك أمر والدنا أيضًا

213
00:16:55,160 --> 00:16:58,410
!أجل! عائلة إيس هي عائلتنا أيضًا

214
00:16:59,780 --> 00:17:02,830
!عائلة"؟ كفاكم تفاهةً"

215
00:17:03,160 --> 00:17:10,840
"لقد تركتم قبضة النّار إيس و"والدكم
!اللّحية البيضاء لحتفهما وهربتم

216
00:17:10,840 --> 00:17:11,920
!ماذا قلت؟

217
00:17:11,920 --> 00:17:13,210
!خذ هذه

218
00:17:19,600 --> 00:17:20,850
!هـ-هذا لا يفلح إطلاقًا

219
00:17:21,230 --> 00:17:24,100
!ابتعدوا عن طريقي أيّها الجبناء

220
00:17:24,100 --> 00:17:25,310
!تنحّ جانبًا يا جينبي

221
00:17:25,310 --> 00:17:30,110
!هورمونات إمبوريو لتكبير الوجه

222
00:17:30,960 --> 00:17:34,860
!إيفا-سان، دعني أساعدك

223
00:17:37,320 --> 00:17:38,950
!المقصّ العظيم

224
00:17:40,830 --> 00:17:43,750
!لا تلمس فتى قبّعة القشّ

225
00:17:43,750 --> 00:17:46,500
!سأقتل ابن دراغون بالتّأكيد

226
00:17:46,500 --> 00:17:48,170
...غمزة

227
00:17:48,170 --> 00:17:49,750
!الجحيم

228
00:17:57,730 --> 00:18:02,000
منذ إمبل داون، كان فتى قبّعة
...القشّ يتعرّض للهجوم

229
00:18:02,000 --> 00:18:06,900
!جسديًّا وعقليًّا وقد دفعه ذلك لأكثر من طاقته

230
00:18:08,440 --> 00:18:14,030
...إن تركتُ مكروهًا يصبه، فلن أستطيع أن أواجه

231
00:18:14,030 --> 00:18:17,530
!رفيقي دراغون لما تبقّى من حياتي

232
00:18:17,530 --> 00:18:18,740
!أوافقك

233
00:18:20,820 --> 00:18:24,740
!لا أملك الوقت لألهو معكما الآن

234
00:18:25,160 --> 00:18:27,000
!لذا تراجعا أنتما الاثنان

235
00:18:27,000 --> 00:18:29,210
!هلمّ إليّ

236
00:18:29,210 --> 00:18:34,960
!أنا أحترق بحرارة أكثر منك الآن

237
00:18:51,100 --> 00:18:53,730
!يبدو أنّه جاهز الآن

238
00:18:53,730 --> 00:18:56,070
!دعني أراه يا قبطان

239
00:19:05,870 --> 00:19:10,330
!حسنًا جميعًا، شكرًا لكم من أجل الانتظار

240
00:19:10,330 --> 00:19:12,300
إنّه العرض الأعظم في العالم

241
00:19:12,300 --> 00:19:16,170
!بتقديم من القبطان تيتش من قراصنة اللّحية السّوداء

242
00:19:16,170 --> 00:19:19,050
!استمتعوا به رجاءً

243
00:19:23,050 --> 00:19:25,560
!ا-اللّحية السّوداء

244
00:19:29,230 --> 00:19:31,560
!ما الّذي كان يفعله هناك؟

245
00:19:32,160 --> 00:19:34,300
!لم يتغيّر شيء على جسد اللّحية البيضاء

246
00:19:36,730 --> 00:19:38,480
!وعلى جسم اللّحية السّوداء أيضًا

247
00:19:39,940 --> 00:19:43,030
!أيّتها البحريّة

248
00:19:43,990 --> 00:19:48,110
!سأريكم ما أنا قادر عليه

249
00:19:49,250 --> 00:19:52,170
!سنصبح أعداءً ثانيةً

250
00:19:56,340 --> 00:19:58,270
!مسار الثّقب المظلم

251
00:20:00,090 --> 00:20:02,090
!ما الّذي يجري؟

252
00:20:07,880 --> 00:20:11,850
!تلك قوّة فاكهة الظّلام خاصّتي

253
00:20:12,300 --> 00:20:13,390
...والآن

254
00:20:16,770 --> 00:20:18,190
...هذه

255
00:20:22,120 --> 00:20:23,400
!...تلك الوقفة

256
00:20:49,560 --> 00:20:50,850
...تلك

257
00:20:51,720 --> 00:20:54,520
!قوّة فاكهة الزّلزال

258
00:20:54,520 --> 00:20:59,650
!لـ-لماذا يملك قوّة اللّحية البيضاء الرّاحل؟

259
00:21:04,740 --> 00:21:06,530
!نجحت يا قبطان

260
00:21:06,530 --> 00:21:09,470
لن يحلّ طاقمنا إذًا؟

261
00:21:09,470 --> 00:21:14,290
!يبدو أنّني اتّخذتُ القرار الصّائب بالانضمام لهم

262
00:21:16,080 --> 00:21:18,880
!قوّة زلزال والدي؟

263
00:21:18,880 --> 00:21:21,750
!ما الّذي فعله ذلك الوغد تيتش

264
00:21:24,510 --> 00:21:27,470
!جاذبيّة الظّلام تجلب الفناء التّامّ

265
00:21:28,000 --> 00:21:31,260
!وقوّة الزّلزال تدمّر كلّ شيء

266
00:21:31,760 --> 00:21:36,300
!وأنا أمتلك كليهما! لا يستطيع أيّ أحد منافستي الآن

267
00:21:36,920 --> 00:21:40,230
!فأنا الرّجل الأقوى في العالم

268
00:21:43,150 --> 00:21:45,730
...لا أدري كيف فعل هذا لكن

269
00:21:45,730 --> 00:21:48,460
!حصل على قوّة اللّحية البيضاء

270
00:21:48,460 --> 00:21:50,220
!كيف يعقل؟

271
00:21:50,220 --> 00:21:55,330
!ما يعني أنّه ما زال علينا الخوف من قوّة فاكهة الزّلزال؟

272
00:21:55,760 --> 00:22:01,160
إن كنتُ صائبًا، يستحيل على المرء أن يمتلك
!قوى فاكهتَي شيطان في نفس الوقت

273
00:22:01,160 --> 00:22:04,340
.ذلك مستحيل على النّاس العاديّين بالتّأكيد

274
00:22:04,340 --> 00:22:08,570
.لكنّ تيتش مختلف قليلاً كما تعلمان

275
00:22:08,570 --> 00:22:12,310
.بنيته الجسديّة مختلفة مقارنةً مع سائر النّاس

276
00:22:13,590 --> 00:22:15,980
!ولهذا استطاع فعل ذلك

277
00:22:15,980 --> 00:22:18,850
!هل رأيتم ذلك؟

278
00:22:21,150 --> 00:22:26,320
!أخبروا النّاس في العالم
،الأشخاص المملّين الّذين يحبّون السّلام

279
00:22:26,320 --> 00:22:29,740
!وجنود البحريّة وحكومة العالم والقراصنة

280
00:22:30,380 --> 00:22:32,530
!لا بدّ أنّ هذا كابوس

281
00:22:32,530 --> 00:22:35,870
!مستقبل هذا العالم محسوم

282
00:22:38,330 --> 00:22:42,630
!أجل، ها قد حان العصر الّذي أغزوه

283
00:22:45,800 --> 00:22:50,180
!ظننت أنّ اللّحية البيضاء مات وانتصرت البحريّة

284
00:22:50,180 --> 00:22:53,600
!لا أصدّق أنّه الآن يملك قوى فاكهتَي شيطان

285
00:22:54,120 --> 00:22:57,020
!من يكون اللّحية السّوداء بالضّبط؟

286
00:22:57,020 --> 00:23:00,350
!ظننت أنّ الحرب ستنتهي قريبًا

287
00:23:00,350 --> 00:23:03,770
!إذًا لٍمَ يحدث هذا؟! يا كوبي

288
00:23:04,530 --> 00:23:11,160
مع أنّ أخا لوفي-سان واللّحية البيضاء
!ماتا، إلاّ أنّ هذه الحرب لم تنتهِ؟

289
00:23:25,430 --> 00:23:30,210
يستخدم اللّحية السّوداء القوّة الّتي سرقها
.من اللّحية البيضاء بحريّة ليعيث فسادًا

290
00:23:30,210 --> 00:23:32,970
في نفس الأثناء، أكاينو وبقيّة البحريّة

291
00:23:32,970 --> 00:23:35,880
.يلاحقون القراصنة باسم العدالة

292
00:23:35,880 --> 00:23:38,510
،لا يبدو أنّ الحرب ستنتهي

293
00:23:38,510 --> 00:23:40,690
!بل يحمي وطيسها أكثر

294
00:23:40,690 --> 00:23:41,890
:في الحلقة القادمة من وان بيس

295
00:23:41,890 --> 00:23:45,480
"!أكاينو الجشع! قبضة الحمم تضرب لوفي"

296
00:23:45,480 --> 00:23:47,840
!ملك القراصنة، لن يكون إلاّ أنا

297
00:23:49,990 --> 00:23:54,990
!!نلقاكم في الحلقة القادمة