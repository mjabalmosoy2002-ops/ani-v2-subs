1
00:00:13,280 --> 00:00:14,360
انتهيت

2
00:00:14,780 --> 00:00:17,870
أحسنت صنعاً يا تاتسويا! كيف
حال المرأة المُختطَفة؟

3
00:00:18,530 --> 00:00:19,870
يبدو أنّها بأمان

4
00:00:19,870 --> 00:00:20,870
يسرّني سماع ذلك

5
00:00:21,450 --> 00:00:24,910
لكن حتّى لو لم يكونوا متورّطين
،في الحملة المُضادّة للسّحرة

6
00:00:24,910 --> 00:00:30,420
اختطاف ابنة رئيس محطّة تلفزيونيّة
لَهو عمل عدوانيّ جدّاً

7
00:00:32,010 --> 00:00:34,130
حضرة الملازم أوّل، انتظري لحظة رجاء

8
00:00:44,390 --> 00:00:45,730
انتهيت

9
00:00:45,730 --> 00:00:47,100
ماذا حدث؟

10
00:00:47,100 --> 00:00:51,070
قوّة منفصلة عن الجناة كانت
تستهدفنا من سفينة جوّية

11
00:00:51,070 --> 00:00:56,490
لقد قضيتُ عليهم وعلى السّفينة، لذا
احذفي سجلّ استهلاك السّحر لاحقاً رجاء

12
00:00:56,860 --> 00:00:58,280
عُلِم

13
00:01:03,620 --> 00:01:05,540
حسناً، مفهوم

14
00:01:07,420 --> 00:01:11,920
القضاء على إتباعي، من سفينة جوّية
وخلافه لَهو أمر مُغيظ جدّاً

15
00:01:12,710 --> 00:01:15,010
هل كان ذلك الرّجل وراء ما جرى مرّة أخرى؟

16
00:01:17,380 --> 00:01:18,970
ماهيسفارا

17
00:01:21,050 --> 00:01:25,390
يبدو أنّه سيترتّب علينا معرفة حقيقته

18
00:02:59,070 --> 00:03:01,820
...فيما يخصّ تجربة الفرن النّجمي أمس

19
00:03:01,820 --> 00:03:07,160
لم أتوقّع أن أرى تلاميذَ مدرسة ثانويّة يمتلكون
مثل هذه المهارة السّحريّة المُتقدِّمة

20
00:03:07,160 --> 00:03:11,660
اندهشتُ من رؤية المعايير التّكنولوجيّة
...العالية الّتي تمتلكها اليابان

21
00:03:08,950 --> 00:03:11,660
!اللّعنة! سايغوسا الأوغاد

22
00:03:20,260 --> 00:03:23,180
أبليتِ بلاء حسناً حقّاً يا سايغوسا

23
00:03:23,510 --> 00:03:24,550
عمّاذا تتكلّم؟

24
00:03:24,970 --> 00:03:27,470
في عرض الأمس

25
00:03:27,470 --> 00:03:31,180
ترتيب الأمر لينشر الإعلام ذلك
في كلّ مكان أمر مُبهر جدّاً

26
00:03:31,600 --> 00:03:34,190
شيبّو، أعتقد بأنّك تسيء فهم شيء

27
00:03:34,190 --> 00:03:36,020
!لا تتظاهري بالجهل

28
00:03:36,020 --> 00:03:40,780
رتّبتِ الأمر وأنتِ على علم بأنّ عضواً في البرلمان
كثير الانتقاد للسّحرة سيكون هنا، صحيح؟

29
00:03:40,780 --> 00:03:44,070
استغللتِ اسم السيّد شيبا لصنع اسم لنفسكِ

30
00:03:44,450 --> 00:03:46,570
!احتفظ باتّهاماتك الغريبة لنفسك

31
00:03:47,030 --> 00:03:48,700
كان ينبغي أن أعلم ذلك

32
00:03:48,700 --> 00:03:51,330
كان ذلك الشّخص ذا شعبيّة في نهاية المطاف

33
00:03:51,330 --> 00:03:53,710
مُحال أن تفوّتي أمراً كهذا يا سايغوسا

34
00:03:54,460 --> 00:03:57,250
هل تشبّهتِ بأختكِ الكبرى وأغويته
ليفعل ذلك لأجلكِ؟

35
00:03:57,250 --> 00:04:00,550
أعني من حيث المظهر فقط، أختاكِ
هما من النّخبة الأولى

36
00:04:00,550 --> 00:04:02,090
...كيف تجرؤ

37
00:04:02,880 --> 00:04:07,050
نحن، السّايغوسا، مُحال أن نلجأ
لاستخدام الإغواء كأداة

38
00:04:07,050 --> 00:04:10,850
من الواضح أنّ عقلك يبتعد إلى
أماكن بذيئة يا شيبّو

39
00:04:12,230 --> 00:04:14,600
أتريدين مقاتلتي يا سايغوسا؟

40
00:04:14,600 --> 00:04:19,150
شيبّو، أنت من أشعل قتالاً معي أوّلاً

41
00:04:19,150 --> 00:04:21,530
وألا تتذكّر ما قلتُه؟

42
00:04:21,530 --> 00:04:25,990
بأنّني مستعدّة وبكلّ سرور أن أقبل التحدّي
وأحرص على ألّا تسعى للشّجار معي ثانية؟

43
00:04:30,950 --> 00:04:32,120
!أنتما هناك

44
00:04:32,450 --> 00:04:33,750
!أخفضي يديكِ

45
00:04:37,630 --> 00:04:38,920
!ربحت

46
00:04:44,050 --> 00:04:46,010
!"كان ذلك "بلا سحب

47
00:04:46,630 --> 00:04:53,600
تقنيّة وسيطة لإطلاق التّعويذات من دون
!سحب الجهاز المُساعد في التّعويذ

48
00:04:54,270 --> 00:04:58,020
السّينباي قادرون على القيام
بمثل هذه الحركات

49
00:04:58,020 --> 00:05:00,690
!ما زال أمامي الكثير من العمل لأقوم به

50
00:05:00,690 --> 00:05:02,150
...كاسومي

51
00:05:11,910 --> 00:05:15,290
هاتّوري، كيف برأيك ينبغي أن نتعامل مع هذا؟

52
00:05:15,290 --> 00:05:17,580
شيبّو واحد منّا

53
00:05:17,580 --> 00:05:20,540
لا أدري ما إن كنتُ أستطيع الحكم بإنصاف

54
00:05:20,540 --> 00:05:24,460
بشكل مماثل، كاسومي هي عضو
!في لجنة الانضباط

55
00:05:24,460 --> 00:05:27,130
كطرف مُحايد، ما رأي مجلس الطّلبة؟

56
00:05:27,590 --> 00:05:32,470
قيل لي أنّه رغمّ كونها كانت مُحاولة، كان
شيبّو قد بدأ باستخدام جهازه المُساعد بالفعل

57
00:05:32,470 --> 00:05:34,720
في أسوأ الاحتمالات، يستحقّ الطّرد

58
00:05:34,720 --> 00:05:38,270
مقارنةً به، كانت محاولة كاسومي مُخالفة أخفّ

59
00:05:39,440 --> 00:05:41,520
إذاً يجب طرد شيبّو؟

60
00:05:41,520 --> 00:05:42,730
لا

61
00:05:42,730 --> 00:05:46,900
التّاريخ بينهما يوحي إليّ بأنّ معاقبتهما فقط
لن يزيل الضّغينة بينهما

62
00:05:46,900 --> 00:05:49,030
لذا لِمَ لا ندعهما يتواجهان في نِزال؟

63
00:05:49,780 --> 00:05:52,780
إنّ استخدام السّحر بشكل غير مُخوّل
...لَهو خرق خطير

64
00:05:52,780 --> 00:05:56,120
لكن لا حاجة لمعاقبة التّلاميذ الّذين
حاولوا فقط استخدامه كذلك

65
00:05:56,120 --> 00:05:59,000
هذا يحدث كثيراً بين التّلاميذ الجدُد

66
00:05:59,000 --> 00:06:01,210
،إذا وضع كلاهما كبرياءه على المحكّ

67
00:06:01,210 --> 00:06:06,170
فإنّ استخدام مهاراتهما لتسوية النّتيجة
ينبغي أن يبدّد ضغينتهما

68
00:06:06,420 --> 00:06:10,300
إذا كنت ستسمح بهذا النّزال
!مع سايغوسا، فلديّ طلب

69
00:06:10,640 --> 00:06:12,010
كلّي آذان صاغية

70
00:06:12,010 --> 00:06:15,810
من فضلكم دعوني أواجه كلّاً من كاسومي
!سايغوسا وإيزومي سايغوسا

71
00:06:15,810 --> 00:06:18,690
أنت، أتسخر منّي؟

72
00:06:18,940 --> 00:06:19,940
ما سببك؟

73
00:06:20,350 --> 00:06:23,820
هذا نِزال سيضع كلّاً من كبرياء شيبّو
وسايغوسا على المحكّ

74
00:06:23,820 --> 00:06:30,200
وفضلاً عن ذلك، الجميع يعلمون بأنّ توأمتي
سايغوسا تُظهِرا قيمتهما الحقيقيّة وهما معاً

75
00:06:30,200 --> 00:06:35,410
،إذاً ما لم تهزمهما معاً في نفس الوقت
فلن تعتبره حينها نصراً حقيقيّاً؟

76
00:06:35,410 --> 00:06:36,790
تماماً

77
00:06:36,790 --> 00:06:39,080
سمعتِ ما قاله شيبّو. ما رأيكِ
بذلك يا كاسومي؟

78
00:06:39,080 --> 00:06:43,080
لا مانع لديّ! سأجعله يندم
!على سلوكه المتعجرف

79
00:06:43,710 --> 00:06:45,710
إذاً لنعتمد هذه الطّريقة

80
00:06:59,770 --> 00:07:02,440
"سيُخاض هذا النّزال تحت قواعد "بلا احتكاك

81
00:07:03,020 --> 00:07:05,270
أنتم ممنوعون من لمس جسد الخصم

82
00:07:05,690 --> 00:07:08,110
وسيتمّ إقصاؤكم إذا لمس سلاحُكم سلاحَ الخصم

83
00:07:08,360 --> 00:07:09,030
...في المقابل

84
00:07:10,280 --> 00:07:13,490
استخدام سحر بعيد المدى للتحكّم بسلاحكم
لن يُعتبَر على أنّه مخالفة

85
00:07:13,910 --> 00:07:19,660
أخيراً، توجيه هجمة قاتلة أو التسبّب بضرر
يتعذّر إصلاحه للخصم ممنوع أيضاً

86
00:07:19,660 --> 00:07:25,250
إذا شعرتُ بأنّ الوضع أمسى خطيراً، فسوف أتدخّل
بالقوّة لإنهاء النّزال، لذا ضعوا ذلك في الحسبان

87
00:07:25,750 --> 00:07:27,750
!حسناً إذاً، كلا الطّرفين، استعدّا

88
00:07:36,260 --> 00:07:36,890
!بدء

89
00:07:42,890 --> 00:07:44,600
ما رأيكِ؟

90
00:07:44,600 --> 00:07:47,270
الطّرفان الآن متكافئان

91
00:07:49,150 --> 00:07:50,610
...في هذه الحالة

92
00:07:54,860 --> 00:07:56,830
!لن أصل إلى نتيجة بهذا

93
00:07:58,490 --> 00:07:59,580
!تبّاً

94
00:08:06,790 --> 00:08:07,840
...هذا

95
00:08:23,020 --> 00:08:24,140
!الآن هي فرصتي

96
00:08:27,810 --> 00:08:30,230
هل أنتِ بخير يا كاسومي؟

97
00:08:30,230 --> 00:08:32,900
!مزعج للغاية! كان ذلك وشيكاً

98
00:08:33,360 --> 00:08:35,280
!إيزومي، سنفعل ذلك الشّيء

99
00:08:35,660 --> 00:08:38,280
!أجل يا كاسومي. كما نفعل دوماً

100
00:08:38,830 --> 00:08:40,330
!سوف أطلق

101
00:08:40,330 --> 00:08:42,080
!وأنا سأعزِّز

102
00:08:42,410 --> 00:08:44,290
!حسناً، هيّا بنا! العدّ التّنازليّ

103
00:08:44,620 --> 00:08:45,290
...ثلاثة

104
00:08:45,620 --> 00:08:46,290
...اثنان

105
00:08:46,580 --> 00:08:47,290
...واحد

106
00:08:47,580 --> 00:08:48,540
!إطلاق -
!إطلاق -

107
00:08:52,670 --> 00:08:56,010
!نسبة النّيتروجين في تيّارات الهواء تتزايد

108
00:08:56,010 --> 00:09:01,600
هل هذه التّعويذة هي لتحييد الخصم وذلك بتخفيف
نسبة الأكسجين، عاصفة النّيتروجين؟

109
00:09:01,600 --> 00:09:02,680
هذا صحيح

110
00:09:02,680 --> 00:09:05,980
...أعتقد لقد أتقنتا تعويذة رفيعة المستوى كهذه

111
00:09:05,980 --> 00:09:09,560
لا ينبغي أن نتوقّع أقلّ من ذلك
من أقرباء السيّدة سايغوسا

112
00:09:09,560 --> 00:09:13,030
لم يتقناها تماماً، لكن يبقى هذا إنجازاً عظيماً

113
00:09:14,150 --> 00:09:17,160
إذاً هذا هو الإلقاء التّعويذي المُضاعَف المُشاع عنه

114
00:09:17,160 --> 00:09:19,030
...لهذا يقولون

115
00:09:19,030 --> 00:09:23,160
توأمتا سايغوسا تُظهرا قيمتهما"
"الحقيقيّة عندما تكونان معاً

116
00:09:35,170 --> 00:09:37,510
!هيّا، حافّة المليون

117
00:09:40,260 --> 00:09:42,010
!عاصفة الحرارة -
!عاصفة الحرارة -

118
00:09:53,480 --> 00:09:54,980
!نهاية النِّزال

119
00:10:03,370 --> 00:10:06,120
!كلا الطّرفين أُقصيا من هذا النّزال

120
00:10:06,120 --> 00:10:07,370
لكن لماذا؟

121
00:10:08,080 --> 00:10:10,210
أخبرتكم قبل النّزال

122
00:10:10,210 --> 00:10:13,250
بأنّني إذا شعرتُ بأي خطر، سأوقفه

123
00:10:13,550 --> 00:10:16,460
...بخلاف حافّة المليون

124
00:10:16,460 --> 00:10:20,390
عاصفة النّيتروجين ليست سحراً قاتلاً
ولا تسبّب ضرراً غير قابل للإصلاح

125
00:10:20,720 --> 00:10:27,270
صحيح، بعاصفة النّيتروجين، يمكنكما التحكّم
بقوّة التّعويذة بحيث لا تخلّف آثاراً بعديّة

126
00:10:27,270 --> 00:10:30,900
لكن يا إيزومي، كلتاكما غير مؤهّلتين بعد
للسّيطرة عليها كما ينبغي

127
00:10:32,730 --> 00:10:34,020
!انتظر لحظة من فضلك

128
00:10:34,020 --> 00:10:37,440
!فشل سحرُ سايغوسا في إيقاف حافّة المليون

129
00:10:37,780 --> 00:10:40,110
هل تعني بأنّك ربحت؟

130
00:10:40,110 --> 00:10:41,360
!هذا صحيح

131
00:10:41,360 --> 00:10:44,660
قبل أن تخترق عاصفةُ النّيتروجين درعي
...مُحكَم السدّ

132
00:10:44,660 --> 00:10:47,660
أنا متأكّد بأنّ هجمتي كانت ستُصيب سايغوسا

133
00:10:47,660 --> 00:10:50,040
...بصيغة أخرى، لو لم أتدخّل

134
00:10:50,040 --> 00:10:54,290
كانت تلك الشّظايا الورقيّة المشتعلة
المليون لتطعن التّوأمتين

135
00:10:54,290 --> 00:10:55,710
أهذه حجّتك؟

136
00:10:57,010 --> 00:11:00,470
في هذه الحالة يا شيبّو، خسرتَ
هذا النّزال بسبب مخالفتك القواعد

137
00:11:00,970 --> 00:11:04,220
ماذا كان سيحدث لو ألحقتَ ضرراً بهما
باستخدام حافّة المليون بكامل قوّتها؟

138
00:11:04,720 --> 00:11:06,970
لا تقل لي بأنّك لا تعلم

139
00:11:07,390 --> 00:11:12,100
إذاً هل كنتُ سأخسر دوماً إذا
استخدمتُ حافّة المليون؟

140
00:11:12,100 --> 00:11:15,820
ما دمتَ عاجزاً عن التحكّم بقوّة
هجومك، ستبقى هذه مُخالفة

141
00:11:15,820 --> 00:11:17,230
...ويا شيبّو

142
00:11:17,230 --> 00:11:20,280
لم تكن قادراً على إخماد قوّة التقنيّة

143
00:11:20,280 --> 00:11:24,200
هذا كذِب! كنتُ أتحكّم بالتّسلسل السّحريّ
!بصورة جيّدة فحسب

144
00:11:24,200 --> 00:11:26,160
أنا الحكم في هذا النّزال

145
00:11:26,160 --> 00:11:27,870
أنا من يصنع القواعد

146
00:11:27,870 --> 00:11:32,460
إذاً هل استخدام حافّة المليون
يوازي استخدام هجمة مُفرِطة؟

147
00:11:32,460 --> 00:11:35,630
!إذاً كان ينبغي لك أن تقول ذلك من البداية

148
00:11:35,630 --> 00:11:38,630
!لو كنتُ أعلم ذلك، لاستخدمتُ شيئاً آخر

149
00:11:38,630 --> 00:11:40,420
هذا يكفي يا شيبّو

150
00:11:40,420 --> 00:11:44,140
لم تستطع التحكّم بقوّة تقنيّتك
لأنّك لستَ جاهزاً ببساطة

151
00:11:44,430 --> 00:11:49,350
لم تلتزم بالشّروط الّتي فُرِضتْ عليك بسبب
نقص في مهارتك، هذا كلّ ما في الأمر

152
00:11:49,770 --> 00:11:51,020
ماذا قلت؟

153
00:11:51,890 --> 00:11:54,650
!لا أريد سماع ذلك من مُصنَّف كـ"عشبة" مثلك

154
00:11:59,650 --> 00:12:02,320
!شيبّو، لقد سئمتُ منك

155
00:12:02,780 --> 00:12:04,280
توميتسوكا؟

156
00:12:04,660 --> 00:12:09,580
!لستَ سوى مجرّد أنانيّ ووقح

157
00:12:09,580 --> 00:12:12,290
هل تعتقد بأنّ الثّمانية والعشرين بتلك الأهمّية؟

158
00:12:12,790 --> 00:12:14,460
—لم أقصد أبداً

159
00:12:14,460 --> 00:12:16,630
شيبّو، قاتلني

160
00:12:16,630 --> 00:12:17,420
ماذا؟

161
00:12:17,420 --> 00:12:19,460
سيُقام النّزال بعد يومين من الآن

162
00:12:19,460 --> 00:12:24,340
إذا أردت إثبات مهاراتك، فسأكون
!مسروراً لمواجهتك

163
00:12:24,760 --> 00:12:29,220
كان معك الفاشل من عائلة توميتسوكا
!المُلقَّب بالمدى صفر

164
00:12:34,060 --> 00:12:38,820
استخدام هجمة قاتلة أو التسبُّب بضرر
يتعذّر إصلاحه على الخصم ممنوع

165
00:12:39,150 --> 00:12:43,190
لكن فيما يخصّ حافّة المليون، يمكن
استخدامها من دون قيود

166
00:12:51,330 --> 00:12:51,950
!بدء

167
00:13:04,840 --> 00:13:05,800
...ما

168
00:13:08,300 --> 00:13:10,050
تهديم غرام؟

169
00:13:10,050 --> 00:13:13,430
شخص في هذه المدرسة غير
تاتسويا يستطيع استخدامها؟

170
00:13:13,430 --> 00:13:16,850
تهديم غرام من نوع الاحتكاك" هو وصف أدقّ"

171
00:13:18,520 --> 00:13:20,360
أبطلَ حافّة المليون؟

172
00:13:23,070 --> 00:13:27,240
لا، كلّ ما في الأمر هي أنّها لن تفلح
!عليه إذا كانت هجمة أماميّة

173
00:13:54,930 --> 00:13:55,930
!الآن

174
00:14:03,110 --> 00:14:03,940
!نلتُ منه

175
00:14:15,910 --> 00:14:17,290
!نهاية المباراة

176
00:14:17,290 --> 00:14:19,080
!الرّابح توميتسوكا

177
00:14:22,460 --> 00:14:23,550
...شيبّو

178
00:14:23,550 --> 00:14:24,840
هل يمكنك النّهوض؟

179
00:14:24,840 --> 00:14:25,880
أجل

180
00:14:25,880 --> 00:14:27,800
استرح عند الجدار

181
00:14:27,800 --> 00:14:28,550
حسناً

182
00:14:37,350 --> 00:14:38,390
ما الأمر؟

183
00:14:38,690 --> 00:14:41,980
هل يمكنني مُبارزتك يا شيبا؟

184
00:14:41,980 --> 00:14:44,900
!أريدك أن تُثبِت لشيبّو كم أنت قويّ

185
00:14:45,480 --> 00:14:47,650
أواجه صعوبة في ربط النّقاط هنا

186
00:14:47,650 --> 00:14:49,860
...ما أعنيه هو

187
00:14:49,860 --> 00:14:54,620
هل تمانع أن تُري شيبّو معنى النّزال
بين خصمين ماهرين فعليّاً؟

188
00:14:54,620 --> 00:14:59,790
حينها ألن يكون من الأفضل إقامة نِزال
بينك وبين السيّد ساواكي؟

189
00:14:59,790 --> 00:15:04,290
شيبا، استعراض ما أنت قادر عليه
هنا سيكون ذا معنى

190
00:15:04,790 --> 00:15:07,960
أخي، أعتقد ستكون الأمور على ما يُرام

191
00:15:07,960 --> 00:15:10,800
إذا كان هدفك هو تقديم نفسك
،كنموذج يحتذي به الكوهاي

192
00:15:10,800 --> 00:15:13,930
فستكون حينئذ مهمّة ملائمة كعضو
في مجلس الطّلبة

193
00:15:14,260 --> 00:15:21,190
وفضلاً عن ذلك، كنتُ أقول لنفسي بأنّني أرغب
في أن تستعرض مهاراتك على الأرض

194
00:15:22,850 --> 00:15:25,270
حسنٌ إن كان هذا رأيكِ

195
00:15:31,860 --> 00:15:33,700
هل أنتما جاهزان؟

196
00:15:38,120 --> 00:15:39,040
!بدء

197
00:15:42,000 --> 00:15:43,210
انتشار السُّحب؟

198
00:15:46,090 --> 00:15:48,210
كما توقّعت، تمّ تحييدها؟

199
00:15:49,260 --> 00:15:52,970
جسد توميتسوكا مُغطّى بدرع
جزيئات فكريّة ثخينة

200
00:16:09,900 --> 00:16:12,740
هل استخدم للتوّ تعويذة تعديل
...الظّاهرة المُتقطِّع

201
00:16:12,740 --> 00:16:16,780
كحجر أساس لتفعيل تعويذة تسارُع
جديدة؟ هل هذا ممكن أصلاً؟

202
00:16:21,330 --> 00:16:25,790
من كان يعلم بأنّ لدينا زميل في الصفّ
يمتلك مهارات قتاليّة نظيرة لمهارات تاتسويا؟

203
00:16:31,090 --> 00:16:32,550
!لا أستطيع القضاء عليه

204
00:16:32,880 --> 00:16:35,800
عرفتُ ذلك سلفاً، لكن لم أتوقّع
!أن يكون الأمر بهذا السّوء

205
00:16:37,180 --> 00:16:38,720
!لكن لن أخسر

206
00:16:38,720 --> 00:16:40,810
!من هذه المسافة، لن أسمح لنفسي بالخسارة

207
00:16:52,150 --> 00:16:53,530
!أخي

208
00:16:56,320 --> 00:16:59,160
!مذهل، سمحَ لنفسه بأن يُقذَف إذاً

209
00:16:59,160 --> 00:17:02,700
لا أصدّق بأنّه تحمّل تحكُّم الدُّمى
الذّاتي الخاصّ بتوميتسوكا

210
00:17:02,700 --> 00:17:04,290
!لا بأس يا شيبا

211
00:17:04,870 --> 00:17:07,130
توميتسوكا همجيّ حقّاً

212
00:17:07,130 --> 00:17:10,550
كان يستهدف طبلة أذن شيبا

213
00:18:00,090 --> 00:18:01,760
!الرّابح شيبا

214
00:18:07,230 --> 00:18:08,100
...توميتسوكا

215
00:18:09,060 --> 00:18:10,480
شكراً

216
00:18:11,980 --> 00:18:14,980
أنت قويٌّ كما تخيّلتُ يا شيبا

217
00:18:15,280 --> 00:18:18,360
!أنت أيضاً يا توميتسوكا! كانت ضربة لعينة

218
00:18:22,160 --> 00:18:23,160
ماذا؟

219
00:18:23,160 --> 00:18:24,620
!شيبّو

220
00:18:25,870 --> 00:18:30,120
!اللّعنة

221
00:18:30,420 --> 00:18:32,130
!اللّعنة! اللّعنة

222
00:18:33,340 --> 00:18:35,630
—اللّعنة -
!هذا يكفي يا شيبّو -

223
00:18:38,510 --> 00:18:40,260
انظر، أنت تنزف

224
00:18:40,550 --> 00:18:41,720
—سايغوسا، هل أنتِ

225
00:18:41,720 --> 00:18:44,100
!لا تسئ الفهم

226
00:18:44,100 --> 00:18:47,180
وجودي هنا هو مجرّد صدفة

227
00:18:47,520 --> 00:18:48,600
...ما الّذي

228
00:18:48,600 --> 00:18:51,770
انظر إلى ما فعلته لنفسك

229
00:18:52,900 --> 00:18:54,610
ينبغي لهذا أن يفي بالغرض

230
00:18:55,690 --> 00:18:58,530
لا تنسَ أن تمرّ بالمشفى، حسناً؟

231
00:19:01,070 --> 00:19:03,870
يبدو أنّك خسرت بطريقة مُدهشة، صحيح؟

232
00:19:04,910 --> 00:19:08,660
إذاً السّينباي بمستوى مختلف تماماً

233
00:19:09,120 --> 00:19:10,080
لماذا؟

234
00:19:10,420 --> 00:19:11,790
لماذا ماذا؟

235
00:19:12,210 --> 00:19:15,300
لماذا أولئك الأشخاص أقوياء جدّاً؟

236
00:19:16,300 --> 00:19:18,460
إنّهم تلاميذ مدرسة ثانويّة مثلنا، صحيح؟

237
00:19:18,460 --> 00:19:20,840
!إنّهم أكبر منّا بعام واحد فقط

238
00:19:20,840 --> 00:19:24,850
فلماذا هم بهذه القوّة؟

239
00:19:26,060 --> 00:19:27,640
غالباً لا يوجد سبب

240
00:19:27,640 --> 00:19:28,310
ماذا؟

241
00:19:28,600 --> 00:19:31,310
إنّهم أقوياء لأنّهم أقوياء

242
00:19:31,310 --> 00:19:32,480
صحيح

243
00:19:32,480 --> 00:19:36,980
إذا بحثتُ عن سبب، فهو لأنّهم
عملوا جاهدين ليصبحوا أقوياء؟

244
00:19:37,440 --> 00:19:38,820
!وكذلك أنا

245
00:19:39,150 --> 00:19:40,200
أجل

246
00:19:40,200 --> 00:19:42,820
أنا متأكّدةٌ بأنّك عملتَ جاهداً
طوال هذا الوقت أيضاً

247
00:19:42,820 --> 00:19:45,240
أحاول جاهدة بنفسي أيضاً

248
00:19:45,780 --> 00:19:52,040
لكن حقيقة أنّهم أقوى تعني بأنّهم عملوا
جاهدين أكثر منّا، صحيح؟

249
00:19:53,170 --> 00:19:55,080
لا أنكر موهبتك، حسناً؟

250
00:19:55,080 --> 00:20:00,050
في حالتي أيضاً، أعتقد بأنّني قويّة
بشكل رئيسيّ بفضل موهبتي

251
00:20:01,170 --> 00:20:05,050
...لكن القوّة الّتي تركَتْك مصدوماً

252
00:20:05,050 --> 00:20:09,060
،غالباً تنبع من مكان مختلف غير الموهبة
ألا تعتقد ذلك؟

253
00:20:23,820 --> 00:20:28,540
حسناً، ليس وكأنّني مهتمّة
"بما تطلق عليه بـ"القوّة

254
00:20:28,790 --> 00:20:33,080
إذا أردت أن تصبح قويّاً، فتلك مشكلتك

255
00:20:33,080 --> 00:20:37,380
فقوّتك هي قوّتك أنت يا شيبّو

256
00:20:46,180 --> 00:20:47,760
!اللّعنة

257
00:22:15,480 --> 00:22:19,810
يبدو وكأنّ سمعة السيّد تاتسويا
مُشرِقة أكثر من اللّازم

258
00:22:21,060 --> 00:22:25,490
أعتقد بأنّني أفهم ما تقلق بشأنه
يا سيّد هاياما

259
00:22:25,820 --> 00:22:30,240
ذاك الفتى قد يخون عائلة يوتسوبا في أيّ وقت

260
00:22:30,240 --> 00:22:31,570
المعذرة

261
00:22:32,080 --> 00:22:37,580
سيل النّيزك الخاصّ بي لا يتوافق
جيّداً مع قدرة ذلك الفتى الغريبة

262
00:22:37,580 --> 00:22:41,580
،إذا استخدمنا كامل قوانا في المعركة
فاحتمالات خسارتي عالية

263
00:22:41,920 --> 00:22:45,420
...لكن حتّى لو خانَ تاتسويا عائلةَ يوتسوبا

264
00:22:45,420 --> 00:22:47,970
مُحال أن يخون ميوكي

265
00:22:47,970 --> 00:22:52,350
وميوكي بالمقابل مُحال أن تُعادي اليوتسوبا

266
00:22:52,890 --> 00:22:58,020
لا يمكن أن تتهرّب ميوكي من المسؤوليّة
الّتي كلّفت نفسها بها

267
00:22:58,020 --> 00:23:01,270
لأنّ هكذا ربّتها أختي الكبرى

268
00:23:01,270 --> 00:23:06,940
ومُحال أن يفعل تاتسويا شيئاً
يؤذي ميوكي مهما كلّف الأمر

269
00:23:06,940 --> 00:23:09,240
...ولأجل تلك الغاية

270
00:23:09,570 --> 00:23:16,080
،أجل. هذا مؤسف بالنّسبة للمرشّحين الآخرين
لكن ستكون ميوكي رئيستنا التّالية

271
00:23:16,540 --> 00:23:21,120
للحرص على عدم إثارة عداوة
تاتسويا. ذلك الوحش

272
00:23:21,710 --> 00:23:27,130
نحتاج أن تقبل فخامتها ميوكي
بمنصب الرّئيس مهما كلّف الأمر

273
00:23:27,630 --> 00:23:30,180
لا داعي للقلق يا سيّد هاياما

274
00:23:30,180 --> 00:23:34,550
لديّ خطّة لتحقيق ذلك