1
00:00:16,990 --> 00:00:21,620
"صرتُ أسطورة بعد صمودي لعشر سنوات طويلة"

2
00:01:30,650 --> 00:01:33,110
زعيم مصّاصي دماء سامٍ؟

3
00:01:33,110 --> 00:01:34,250
.نعم

4
00:01:34,250 --> 00:01:38,110
نقوم في قبيلة الوحشيّين بكلّ ما في وسعنا

5
00:01:38,110 --> 00:01:40,500
.لكشف خطّته ووضع حدّ لها

6
00:01:40,500 --> 00:01:42,370
.إنّه ليس خصمًا سهلاً

7
00:01:42,710 --> 00:01:46,750
الزّعيم السّامي وحشٌ ذو قدراتٍ
.تُضاهي قدرات الشّياطين

8
00:01:47,050 --> 00:01:52,000
يؤلمني أن أقول، إنّ والدي
.لم يتعافَ تمامًا بعد

9
00:01:52,000 --> 00:01:56,140
ألم تقولي أنّه أُصيب إصابةً بالغةً
أثناء مطاردة زعيم مصّاصي الدّماء؟

10
00:01:56,140 --> 00:01:58,850
.لم يستعد بعد كامل قوّته القتاليّة

11
00:01:58,850 --> 00:02:01,720
عندما حضرتُ اجتماع مجلس
،القبيلة نيابةً عن والدي

12
00:02:01,720 --> 00:02:04,520
.صوّتتُ ضدّ أيّ هجوم

13
00:02:04,520 --> 00:02:07,130
لكنّ أعضاء المجلس في غالبيّتهم
...من المتشدّدين، لذا

14
00:02:07,130 --> 00:02:10,520
.بهذا المعدّل، هناك احتمال أن نُباد

15
00:02:10,520 --> 00:02:15,350
لهذا السّبب تريدين مساعدتي
في هزيمة زعيم مصّاصي الدّماء؟

16
00:02:15,350 --> 00:02:17,600
.نعم. هذا صحيح بعد إذنك

17
00:02:17,600 --> 00:02:18,600
...لكن

18
00:02:18,600 --> 00:02:19,650
لكن ماذا؟

19
00:02:19,900 --> 00:02:24,290
في الحقيقة، هناك أمرٌ آخر عليّ
.إنجازه بسرعة أوّلاً

20
00:02:24,290 --> 00:02:27,080
أمرٌ له الأولويّة على هزيمة الزّعيم السّامي؟

21
00:02:27,080 --> 00:02:28,660
.لا بدّ أنّه مهمّ

22
00:02:28,660 --> 00:02:31,790
...نعم. لو سمحت، الأمر أنّه

23
00:02:31,790 --> 00:02:36,540
يبحث مصّاصو الدّماء بيأس
.عن ديك معيّن

24
00:02:37,790 --> 00:02:43,910
.علينا أن نجد ذلك الدّيك أوّلاً ونحميه

25
00:02:46,050 --> 00:02:48,740
!كنتُ أعرف أنّك ستفهم الأمر هكذا

26
00:02:48,740 --> 00:02:50,730
!أنا أفهم تمامًا ما يشعر به حضرتك

27
00:02:50,730 --> 00:02:53,930
"لماذا علينا أن نذهب لحماية ديك؟"

28
00:02:53,930 --> 00:02:55,860
...لا، بخصوص الدّيك

29
00:02:55,860 --> 00:02:57,440
!فهمت، فهمت بعد إذنك

30
00:02:57,860 --> 00:03:01,410
،حسب ما سمعت
بإمكانه إغلاق البوّابات البُعديّة

31
00:03:01,410 --> 00:03:04,570
.والدّفاع ضدّ تحوّلات مصّاصي الدّماء

32
00:03:04,820 --> 00:03:09,250
كنتُ أعرف ذلك. إنّها تتحدّث
.عن غيربيرغا المُبجّل

33
00:03:10,080 --> 00:03:13,860
!لا ألوم حضرتك على عدم تصديقي

34
00:03:13,860 --> 00:03:14,950
.لا، أنا أصدّقك

35
00:03:14,950 --> 00:03:17,900
.لا بأس. أشعر بنفس الشّيء

36
00:03:17,900 --> 00:03:20,690
!أعني، أنّنا نتحدّث عن ديك هنا قبل كلّ شيء

37
00:03:20,690 --> 00:03:22,140
.قلتُ للتّوّ أنّني أصدّقك

38
00:03:22,140 --> 00:03:24,670
!يا للطف حضرتك

39
00:03:24,670 --> 00:03:26,760
.في الواقع، لقد قابلتِه بالفعل

40
00:03:26,760 --> 00:03:27,530
ماذا؟

41
00:03:27,850 --> 00:03:29,580
...قبل قليل فحسب

42
00:03:32,240 --> 00:03:33,380
سيّد لوك؟

43
00:03:33,380 --> 00:03:35,730
.ربّما حان وقت التّعارف

44
00:03:43,740 --> 00:03:46,260
...هذا مؤلم

45
00:03:47,750 --> 00:03:49,870
.مـ-مساء الخير

46
00:03:49,870 --> 00:03:51,610
.يا إلهي منك

47
00:03:51,900 --> 00:03:55,460
.لهذا حاولتُ إخبارك ألاّ تتجسّسي عليهما

48
00:03:55,460 --> 00:03:58,250
!كـ-كلاّ، ذلك ليس ما كنتُ أفعله

49
00:03:58,250 --> 00:03:59,970
ماذا كنت تفعلين إذًا؟

50
00:03:59,970 --> 00:04:03,880
...حسنًا، كما ترى... لقد

51
00:04:07,880 --> 00:04:09,420
!أنا آسفة

52
00:04:10,420 --> 00:04:13,560
.لم تجد عذرًا

53
00:04:13,560 --> 00:04:15,520
.اعتذري لسيا أيضًا

54
00:04:16,140 --> 00:04:18,130
.أ-أنا آسفة

55
00:04:18,130 --> 00:04:22,540
لا بأس، لا بأس. لا أمانع ما دمت
.لن تخبري أيّ أحد آخر

56
00:04:23,040 --> 00:04:25,130
.تفضّل بالدّخول أنت أيضًا يا لوتشيرا

57
00:04:25,910 --> 00:04:29,030
.سيا، هذا لوتشيرا، من قبيلة الشّياطيّين

58
00:04:29,420 --> 00:04:34,910
وهذا هو غيربيرغا المُبجّل، الطّائر
.المقدّس الّذي تبحث عنه قبيلتك

59
00:04:34,910 --> 00:04:36,720
طائر مقدّس؟

60
00:04:38,420 --> 00:04:41,160
!ماذا؟

61
00:04:41,160 --> 00:04:43,890
!هـ-هل وجدته بالفعل يا سيّدي؟

62
00:04:43,890 --> 00:04:46,560
.حسنًا، كانت مجرّد صدفة

63
00:04:46,840 --> 00:04:49,640
.لقد رأيت قوّته بنفسي

64
00:04:49,640 --> 00:04:52,080
.تحوّل مصّاص دماء إلى رماد في لحظة

65
00:04:52,080 --> 00:04:55,030
.إذًا لا بدّ أنّ الأسطورة حقيقيّة

66
00:04:57,120 --> 00:05:00,820
.تشرّفتُ بلقائك يا سيّدي الطّائر المقدّس

67
00:05:02,820 --> 00:05:08,090
الطّائر المقدّس بأمان، لذا لم يتبقَّ
.سوى تدمير الزّعيم السّامي

68
00:05:08,090 --> 00:05:08,820
.حاضرة

69
00:05:09,720 --> 00:05:14,430
يبدو أنّ الزّعيم السّامي وأتباعه
.يتربّصون في مكان ما في هذه المنطقة

70
00:05:14,430 --> 00:05:18,100
آمل أن نتمكّن من تضييق
.نطاق البحث قليلاً

71
00:05:18,100 --> 00:05:21,210
بذلنا جهدًا كبيرًا للحصول
.على هذه المعلومات

72
00:05:21,210 --> 00:05:26,230
،تعجّ المنطقة بمصّاصي الدّماء
.وليس من السّهل الاقتراب منها

73
00:05:26,230 --> 00:05:28,750
!أنا متحمّسة الآن

74
00:05:28,750 --> 00:05:30,350
ما الأمر؟

75
00:05:30,350 --> 00:05:34,940
أعني، أنا والآنسة سيا والسّيّد لوك
.سنقاتل قوّات الزّعيم السّامي

76
00:05:34,940 --> 00:05:37,080
!بالطّبع أنا متحمّسة

77
00:05:37,080 --> 00:05:38,960
.لن آخذك معي يا سيليس

78
00:05:38,960 --> 00:05:40,700
ماذا؟ لماذا؟

79
00:05:40,700 --> 00:05:42,560
.لأنّه أمر خطير بالطّبع

80
00:05:42,560 --> 00:05:45,080
حـ-حسنًا، ماذا عن الآنسة سيا إذًا؟

81
00:05:45,080 --> 00:05:46,910
.إنّها من الرّتبة ب

82
00:05:46,910 --> 00:05:50,710
وعليها الذّهاب في هذه المطاردة
.بسبب قوانين قبيلتها

83
00:05:51,120 --> 00:05:53,150
.وضعها مختلف عن وضعك

84
00:05:53,150 --> 00:05:54,070
...لكن

85
00:05:54,070 --> 00:05:55,050
...إلى جانب ذلك

86
00:05:55,890 --> 00:05:59,580
.أحتاجكِ لحماية غيربيرغا المُبجّل

87
00:05:59,580 --> 00:06:00,810
حماية غير الصّغير؟

88
00:06:00,810 --> 00:06:02,720
!"ناديه "غيربيرغا المبجّل

89
00:06:02,720 --> 00:06:07,990
لا يمكننا اصطحاب غيربيرغا المُبجّل
.مباشرةً إلى معقل من يطاردونه

90
00:06:07,990 --> 00:06:09,940
...هذا صحيح

91
00:06:10,600 --> 00:06:13,080
،لكن إذا تركناه

92
00:06:13,080 --> 00:06:15,480
.فهناك خطر من هجوم مصّاصي الدّماء

93
00:06:15,790 --> 00:06:17,670
،العاصمة محاطة بسور

94
00:06:17,670 --> 00:06:21,070
لذا من غير المرجّح أن يتمكّن مصّاصو
.الدّماء من طبقة الزّعماء من الدّخول

95
00:06:21,070 --> 00:06:24,930
.لكنّنا ما زلنا بحاجة إلى مغامرٍ بارعٍ ليحرسه

96
00:06:25,220 --> 00:06:27,380
مغامر بارع؟

97
00:06:27,380 --> 00:06:28,700
.هذا صحيح

98
00:06:28,700 --> 00:06:30,180
بارع؟

99
00:06:30,180 --> 00:06:32,300
.نعم، بارع

100
00:06:32,300 --> 00:06:35,450
!إ-إذا كان هذا رأيك، فأعتقد أنّ عليّ ذلك

101
00:06:38,250 --> 00:06:40,740
!يبدو أنّا بابا قد عاد

102
00:06:41,270 --> 00:06:42,470
بابا؟

103
00:06:42,470 --> 00:06:46,350
.صحيح، لم أذكر ذلك. سيليس ابنة غوران

104
00:06:46,350 --> 00:06:48,960
ماذا؟! ابنة اللّورد مورتون؟

105
00:06:48,960 --> 00:06:51,980
قال أنّي مغامِرة بارعة؟

106
00:06:53,180 --> 00:06:54,340
!مرحبًا

107
00:06:54,340 --> 00:06:55,890
!لا... لوك

108
00:06:55,890 --> 00:06:57,660
!حرصتَ على العودة إلى المنزل اليوم

109
00:06:57,660 --> 00:07:00,030
لماذا تتصرّف كأمّي ثانية؟

110
00:07:00,030 --> 00:07:04,910
.أخبرني أحد الموظّفين
!شكرًا لك على رعاية سيليس

111
00:07:04,910 --> 00:07:08,580
.كلاّ، إنّها محاربة رائعة حقًّا

112
00:07:08,580 --> 00:07:10,470
!أعلم، أتظنّ ذلك أيضًا؟

113
00:07:10,470 --> 00:07:13,820
!يُسعدني جدًّا سماع مدحك لها

114
00:07:13,820 --> 00:07:15,070
.بابا

115
00:07:15,910 --> 00:07:17,830
!مرحبًا يا سيليس

116
00:07:17,830 --> 00:07:20,480
!تهانينا على إتمام مهمّتك الأولى

117
00:07:20,480 --> 00:07:22,590
.اسمع يا بابا

118
00:07:23,630 --> 00:07:25,070
.أنا آسفة

119
00:07:25,070 --> 00:07:26,590
ما الّذي دفعك إلى هذا؟

120
00:07:28,840 --> 00:07:30,830
!سـ-سيليس؟

121
00:07:31,170 --> 00:07:34,680
...لقد كنتُ وقحة معك للغاية

122
00:07:34,680 --> 00:07:37,590
!كـ-كلاّ، أنا... لا حاجة للبكاء

123
00:07:37,590 --> 00:07:39,970
.أنا حقًّا آسفة

124
00:07:39,970 --> 00:07:40,740
!لا بأس

125
00:07:40,740 --> 00:07:42,930
!لا يزعجني الأمر الآن على الإطلاق

126
00:07:42,930 --> 00:07:43,980
مفهوم؟

127
00:07:43,980 --> 00:07:46,230
كلّ شيء بخير الآن، صحيح؟ صحيح؟

128
00:07:46,510 --> 00:07:49,950
بـ-بالمناسبة، لماذا كنتِ غاضبةً هكذا؟

129
00:07:49,950 --> 00:07:52,610
لأنّني كنتُ أعارض أن تصبحي مغامِرة؟

130
00:07:52,610 --> 00:07:54,860
...لا، لأنّك

131
00:07:54,860 --> 00:07:57,870
مهلاً... كان الأمر متعلّقًا بي إذًا؟

132
00:07:58,240 --> 00:08:01,110
.ظننتُ أنّه كان لديك ابن غير شرعيّ

133
00:08:01,110 --> 00:08:02,840
ماذا تقولين؟

134
00:08:03,920 --> 00:08:06,160
!مستحيل أن يكون لديّ أبناء غير شرعيّين

135
00:08:06,160 --> 00:08:07,540
!نعم، مستحيل

136
00:08:07,540 --> 00:08:09,100
!بكلّ تأكيد

137
00:08:09,100 --> 00:08:12,920
لا أصدّق أنّني تسرّعت في استنتاج
!أنّ لوك هو أخي الصّغير

138
00:08:16,590 --> 00:08:19,930
...سيليس، أنا متأكّد أنّ الإجابة هي لا

139
00:08:19,930 --> 00:08:22,430
لكن هل سبّبتِ أيّ مشكلة للاك؟

140
00:08:22,430 --> 00:08:24,870
!سأذهب لأحضر الجميع

141
00:08:25,740 --> 00:08:27,690
.لقد هربت

142
00:08:27,690 --> 00:08:29,360
.لا... لوك

143
00:08:29,360 --> 00:08:31,320
!توقّف عن هذا الخطأ

144
00:08:31,320 --> 00:08:32,330
.آسف

145
00:08:32,810 --> 00:08:34,480
!أعطِ ابنتي فرصة

146
00:08:34,480 --> 00:08:37,190
.لم أكن أعلم أنّها كارثة لهذا الحدّ

147
00:08:37,190 --> 00:08:39,070
.لا أدري من أين ورثت هذا السّلوك

148
00:08:39,370 --> 00:08:42,660
حسنًا، لديّ ذكريات كثيرة عنّي وعن إريك

149
00:08:42,660 --> 00:08:46,750
.ونحن نخسر بسبب تسرّعك في إصدار الأحكام

150
00:08:47,160 --> 00:08:51,330
!قـ-قد يخدعها رجل شرّير في المستقبل

151
00:08:51,330 --> 00:08:52,300
.مهلاً، مهلاً

152
00:08:52,300 --> 00:08:54,790
.ربّما عليّ منعها من أن تصبح مغامِرة بالفعل

153
00:08:54,790 --> 00:08:57,810
.ستكون بخير. سأحرص على مراقبتها

154
00:08:57,810 --> 00:08:59,300
...لوك

155
00:08:59,300 --> 00:09:01,570
.سأمنعها من فعل أيّ شيء مجنون

156
00:09:01,570 --> 00:09:03,100
!يا صديقي

157
00:09:03,090 --> 00:09:07,560
!اللّحية! اللّحية! كلاّ

158
00:09:03,100 --> 00:09:05,570
!شكرًا! شكرًا

159
00:09:08,090 --> 00:09:09,880
...بابا، الجميع قد

160
00:09:19,320 --> 00:09:21,430
.خـ-خذا وقتكما

161
00:09:23,070 --> 00:09:23,940
أترى؟

162
00:09:23,940 --> 00:09:25,580
!وما دخلي أنا

163
00:09:30,420 --> 00:09:36,090
"منهكان"

164
00:09:30,860 --> 00:09:33,500
.وأخيرًا أوضحنا الأمور

165
00:09:33,500 --> 00:09:36,090
.لا أصدّق أنّ الأمر استغرق ساعة

166
00:09:36,090 --> 00:09:38,100
—أنا آسفة، لكنّني

167
00:09:38,100 --> 00:09:40,750
.لا تُعقّدي الأمور أكثر

168
00:09:40,750 --> 00:09:43,220
.لننتقل إلى المهمّ

169
00:09:43,220 --> 00:09:47,850
صحيح، بخصوص مصّاصي الدّماء
.الّذين يُدبّرون ​​شيئًا ما

170
00:09:47,850 --> 00:09:52,020
.بحسب كلام سيا، هناك زعيمٌ سامٍ يقودهم

171
00:09:52,020 --> 00:09:53,690
!زعيمٌ سامٍ؟

172
00:09:53,690 --> 00:09:56,840
."هذا يتجاوز مستوى "المتاعب

173
00:09:57,160 --> 00:10:00,900
على أيّ حال، علينا حماية سلاحنا
،السّرّيّ، غيربيرغا المُبجّل

174
00:10:00,900 --> 00:10:04,280
بينما نهاجم معقل مصّاصي
.الدّماء وزعيمهم السّامي

175
00:10:04,280 --> 00:10:06,260
...نعم، لكن

176
00:10:07,280 --> 00:10:10,590
إذا كانت قوّة غيربيرغا المُبجّل
،عظيمة إلى هذا الحدّ

177
00:10:10,590 --> 00:10:12,800
فهل من الممكن أن نستعين به؟

178
00:10:13,270 --> 00:10:18,800
قوّة غيربيرغا المبجّل لا تعمل
.إلاّ عندما يتحوّل مصّاصو الدّماء

179
00:10:18,800 --> 00:10:22,980
إضافةً إلى ذلك، كيف لنا أن نقاتل
ونحميه في الوقت نفسه؟

180
00:10:22,980 --> 00:10:25,170
.إذا حدث أي خطأ، فسنكون في ورطة

181
00:10:26,060 --> 00:10:28,070
،نسيت أن أذكر هذا

182
00:10:28,070 --> 00:10:31,020
لكن إذا شرب الزّعيم السّامي
،دماء الطّائر المقدّس

183
00:10:31,020 --> 00:10:33,320
،فستتراكم اللّعنة بسرعة كبيرة في قلادته

184
00:10:33,320 --> 00:10:35,950
.لدرجة أنّ بوّابة بُعديّة ستنفتح في الحال

185
00:10:35,950 --> 00:10:36,830
!ماذا؟

186
00:10:36,830 --> 00:10:38,520
!هل هذا صحيح؟

187
00:10:39,070 --> 00:10:41,120
...لـ-لم أكن أعلم

188
00:10:42,080 --> 00:10:45,070
.يبدو أنّ الطّائر نفسه لم يكن يعلم

189
00:10:45,070 --> 00:10:49,640
.تنشأ اللّعنة من تدنيس الحياة

190
00:10:49,640 --> 00:10:52,130
،كلّما كان الشّيء الّذي يُدنَّس أكثر قدسيّة

191
00:10:52,130 --> 00:10:55,580
.زادت اللّعنة الّتي قد تتراكم عليه

192
00:10:55,580 --> 00:10:57,560
،في هذه الحالة

193
00:10:57,560 --> 00:11:01,340
هذا سببٌ إضافيّ لعدم اصطحاب غيربيرغا
.المبجّل بالقرب من ساحة المعركة

194
00:11:01,340 --> 00:11:04,590
لوك، هل يُمكننا طلب المساعدة من إريك؟

195
00:11:04,590 --> 00:11:06,270
إريك؟

196
00:11:06,270 --> 00:11:07,600
!القصر الملكيّ

197
00:11:07,600 --> 00:11:12,850
نعم. إذا كانّ الطائر مقدّسًا، فلن تواجه
.العائلة المالكة أيّ مشكلة في حراسته

198
00:11:12,850 --> 00:11:14,600
!ا-العائلة المالكة؟

199
00:11:14,600 --> 00:11:17,310
!نعم يا بابا! فكرة رائعة

200
00:11:17,310 --> 00:11:19,720
.لم يخطر ببالي هذا

201
00:11:19,720 --> 00:11:21,950
.سيكون بالتّأكيد أكثر أمانًا في القصر

202
00:11:21,950 --> 00:11:24,820
.فقبل كلّ شيء، كان الملك بطلاً

203
00:11:25,770 --> 00:11:28,110
أظنّ أنّهما يقصدان الملك
."عندما يقولان "إريك

204
00:11:28,450 --> 00:11:30,450
.حسنًا، فلنغتنم الفرصة

205
00:11:30,810 --> 00:11:33,990
.سأرسل رسولاً إلى القصر فورًا

206
00:11:38,670 --> 00:11:40,310
.تفضّلوا بالانتظار هنا

207
00:11:40,710 --> 00:11:41,760
.شكرًا لك

208
00:11:48,590 --> 00:11:49,610
.تفضّلوا

209
00:11:49,610 --> 00:11:51,730
!بعد إذنك لو سمحت

210
00:11:55,840 --> 00:11:56,970
!إنّه لذيذ

211
00:11:56,970 --> 00:11:59,810
.واضح أنّه شاي يليق بالقصر

212
00:11:59,810 --> 00:12:03,210
.كان كبير الخدم الّذي رافقنا شابًا بالتّأكيد

213
00:12:03,210 --> 00:12:06,740
.ستندهش من عدد المتّدرّبين لدى إريك

214
00:12:06,740 --> 00:12:08,230
متدرّبون؟

215
00:12:08,660 --> 00:12:13,410
.فرسان متدرّبون وخدم متدرّبون وطُهاة متدرّبون

216
00:12:13,410 --> 00:12:15,880
.ربّما حوالي ألفين إجمالاً

217
00:12:15,880 --> 00:12:17,400
أليس هذا عددًا كبيرًا؟

218
00:12:17,400 --> 00:12:19,450
.إنّها سياسة رعاية اجتماعيّة

219
00:12:19,450 --> 00:12:22,530
إنّهم ثاني وثالث الأبناء
.للعائلات النّبيلة الفقيرة

220
00:12:22,530 --> 00:12:26,280
أبناء الفرسان الّذين توفّوا
.في الحرب ضدّ ملك الشّياطين

221
00:12:26,280 --> 00:12:29,390
ألن يجعلهم التّدريب في القصر
الملكيّ أكثر قابليّة للتّوظيف؟

222
00:12:29,390 --> 00:12:31,300
.هذا منطقيّ

223
00:12:31,300 --> 00:12:33,400
.يبدو إريك ملكًا عظيمًا

224
00:12:33,400 --> 00:12:38,410
."شعار الملك إريك هو "التّعليم يُنمّي المملكة

225
00:12:38,410 --> 00:12:39,400
.لاك

226
00:12:43,840 --> 00:12:47,030
.سمعتُ أنّك هزمت زعيم مصّاصي دماء

227
00:12:49,200 --> 00:12:50,910
.مساء الخير

228
00:12:51,200 --> 00:12:54,480
.لم تلتقوا من قبل، أليس كذلك؟ هؤلاء بناتي

229
00:12:54,480 --> 00:12:55,830
هكذا إذًا؟

230
00:12:55,830 --> 00:12:58,310
.كيف حالك؟ أنا شارلوت

231
00:12:58,310 --> 00:13:01,090
!كيف حالك؟ أنا ماري

232
00:13:01,090 --> 00:13:03,290
.كم أنتما مهذّبتين

233
00:13:03,640 --> 00:13:08,550
.تشرّفت بلقائكما. أنا لاك، صديق والدكما

234
00:13:08,820 --> 00:13:12,540
إنّه لشرف لي أن ألتقي بك
.أيّها الأرشيدوق فرانزِن

235
00:13:13,270 --> 00:13:15,400
!إنّه القدّيس لاك العظيم

236
00:13:15,400 --> 00:13:16,940
هلّي بتوقيعك؟

237
00:13:18,310 --> 00:13:23,820
هل أنا مخطئ أم أنّ العنوان
هو "مغامرات لاك"؟

238
00:13:24,910 --> 00:13:28,500
تُحبّ ماري كتابها المصوّر
.لقصصك البطوليّة

239
00:13:28,500 --> 00:13:29,280
!ماذا؟

240
00:13:29,280 --> 00:13:31,200
.وقّعه لها لاحقًا

241
00:13:31,200 --> 00:13:33,490
!لحظة! أيّ كتاب مصوّر؟

242
00:13:33,490 --> 00:13:35,620
ألم يكن حضرتك على دراية بهذا؟

243
00:13:35,620 --> 00:13:40,620
إنّ كلّ طفل في هذه المملكة
.نشأ وهو يسمع قصصًا عنك

244
00:13:40,620 --> 00:13:42,030
!ماذا؟

245
00:13:42,030 --> 00:13:46,420
.كان هذا ثاني شيء فعله إريك بعد التّمثال

246
00:13:46,420 --> 00:13:50,310
.ينظر جميع الأطفال إليك كبطل يا سيّد لاك

247
00:13:50,710 --> 00:13:53,550
.تحوّل هذا إلى غسيل أدمغة

248
00:13:53,550 --> 00:13:57,090
.يُحبّ غيربيرغا المُبجّل كتاب صورك أيضًا

249
00:13:57,940 --> 00:13:59,650
...حتّى إله مثله

250
00:14:01,100 --> 00:14:04,060
اسمه غيربيرغا المبجّل؟

251
00:14:04,700 --> 00:14:05,650
.نعم

252
00:14:06,570 --> 00:14:10,000
إنّه ظريف جدًّا. هل يُمكنني لمسه؟

253
00:14:10,000 --> 00:14:11,050
.تفضّلي

254
00:14:12,890 --> 00:14:14,950
!كم هو ناعم

255
00:14:15,940 --> 00:14:18,270
!المسيه أنت أيضًا يا شارلوت

256
00:14:18,270 --> 00:14:19,940
لن ينقرني، صحيح؟

257
00:14:19,940 --> 00:14:21,470
!لا تقلقي

258
00:14:24,980 --> 00:14:27,720
.معك حقّ! إنّه ناعم

259
00:14:28,450 --> 00:14:32,460
.سيليس، اذهبي والعبي مع الأميرتان

260
00:14:32,460 --> 00:14:33,670
.حاضرة

261
00:14:33,670 --> 00:14:36,470
هل تودّان اللّعب معي في غرفة أخرى؟

262
00:14:36,850 --> 00:14:38,220
!نعم

263
00:14:38,500 --> 00:14:41,400
.خذي الفتيات إلى غرفة أخرى

264
00:14:41,400 --> 00:14:42,790
.نعم يا صاحب جلالة

265
00:14:50,120 --> 00:14:54,420
.غوران، شكرًا لك على لطفك

266
00:14:54,930 --> 00:14:57,870
،كنت أعلم أنّ هذا أمر عاجل

267
00:14:57,870 --> 00:15:01,240
لكنّني لم أستطع تفويت فرصة
.تعريف فتاتيّ بك

268
00:15:01,240 --> 00:15:02,240
بي أنا؟

269
00:15:02,680 --> 00:15:08,320
،بفضل صدّك للقوى الشّيطانيّة قبل عشر سنوات

270
00:15:08,320 --> 00:15:12,640
.رُزقتُ بهاتين الفتاتين. إنّهما نور حياتي

271
00:15:13,010 --> 00:15:17,440
.والآن، سعادتي مرتبطة بشارلوت وماري

272
00:15:17,830 --> 00:15:21,630
.أنت من أعطاني ذلك يا لاك

273
00:15:22,030 --> 00:15:23,630
.كفى

274
00:15:23,630 --> 00:15:25,160
.وأنا كذلك

275
00:15:25,770 --> 00:15:30,410
.شاهدتُ سيليس تكبر أمامي بفضلك

276
00:15:30,410 --> 00:15:32,430
.ولسنا الوحيدين

277
00:15:33,770 --> 00:15:38,910
،كلّ من في هذه المملكة
.بل وفي هذه القارّة، ممتنّ لك

278
00:15:39,240 --> 00:15:43,100
.أردتُ بشدّة أن تُدرك ذلك

279
00:15:43,760 --> 00:15:46,930
.هكذا إذًا... شكرًا

280
00:15:46,930 --> 00:15:49,450
.لكنّ الكتاب المصوّر لا يزال مبالغة كبيرة

281
00:15:49,450 --> 00:15:52,190
.حقًّا؟ هناك مسرحيّة أيضًا

282
00:15:52,190 --> 00:15:54,060
!لا مكان للجلوس، في كلّ عرض

283
00:15:54,060 --> 00:15:55,600
!توقّفا

284
00:15:57,220 --> 00:16:00,050
بالمناسبة، كيف حال ليفي؟

285
00:16:00,050 --> 00:16:04,480
.جيّدة، أرادت رؤيتك عندما علمت بعودتك

286
00:16:04,480 --> 00:16:09,070
لكنّ ليفي هذه الأيّام ترأس
.التّنظيم المقدّس للمملكة

287
00:16:09,290 --> 00:16:12,070
.إنّها متمركزة في الكاتدرائيّة

288
00:16:12,070 --> 00:16:13,810
.هكذا إذًا

289
00:16:13,810 --> 00:16:15,670
.سأعود لاحقًا إذًا

290
00:16:16,510 --> 00:16:18,910
.تفضّلن باستخدام هذه الغرفة

291
00:16:18,910 --> 00:16:20,400
.شكرًا لك يا روانا

292
00:16:22,450 --> 00:16:24,980
.سأحضر لكنّ بعض الحلويات

293
00:16:27,690 --> 00:16:31,180
فهمت. سيفتحون بوّابةً بين الأبعاد

294
00:16:31,180 --> 00:16:33,490
.ويستدعون آلهة الظّلام

295
00:16:33,970 --> 00:16:39,780
لا بدّ أنّ هذه الخطّة هي سبب
.نشاط مصّاصي الدّماء مؤخّرًا

296
00:16:39,780 --> 00:16:43,860
مهما يكن، يجب علينا حماية
،دماء الطّائر المقدّس

297
00:16:44,340 --> 00:16:46,860
.وإلاّ سيُفعّل اللّعنة دفعة واحدة

298
00:16:46,860 --> 00:16:48,120
.مفهوم

299
00:16:48,500 --> 00:16:52,350
سيحرص القصر الملكيّ على سلامة
.لوتشيرا والطّائر المقدّس

300
00:16:52,350 --> 00:16:53,240
.شكرًا لك

301
00:16:53,240 --> 00:16:55,660
.أ-أقدّر لكم هذا بشدّة

302
00:16:56,060 --> 00:16:59,940
هذا سيُتيح لنا التّفرّغ للقضاء
.على الزّعيم السّامي

303
00:16:59,940 --> 00:17:01,080
!نعم

304
00:17:01,310 --> 00:17:03,060
.بخصوص تلك الحملة

305
00:17:03,440 --> 00:17:07,080
ما هي خطّتك بالضّبط لهزيمة زعيم سامٍ؟

306
00:17:07,080 --> 00:17:09,180
.فكّرتُ في شيء

307
00:17:09,180 --> 00:17:10,970
!أجل، أودّ سماعه

308
00:17:10,970 --> 00:17:14,830
أوّلاً، سأقوم أنا وسيا بتجميع
.صيّادين من الوحشيّين

309
00:17:14,830 --> 00:17:15,840
.نعم

310
00:17:15,840 --> 00:17:19,140
.ثم، سنقتحم أنا وهي المكان مباشرةً

311
00:17:19,140 --> 00:17:20,200
!ماذا؟

312
00:17:20,200 --> 00:17:21,270
—ثمّ

313
00:17:21,270 --> 00:17:22,210
!انتظر لحظة

314
00:17:22,210 --> 00:17:25,040
!ما هذا؟! إنّها بالتّأكيد ليست خطّة

315
00:17:25,040 --> 00:17:27,480
.استمعا لي فحسب

316
00:17:27,480 --> 00:17:31,570
أوّلاً، سأقوم أنا وسيا بتشتيت
.انتباه حشد الزّعماء

317
00:17:31,570 --> 00:17:36,510
،حالما يُفتح الطّريق إلى الزّعيم السّامي
.سنرسل فرقة هجوميّة من الوحشيّين

318
00:17:37,480 --> 00:17:41,780
ألا تعتقد أنّك عكست ترتيب المهامّ؟

319
00:17:41,980 --> 00:17:43,240
هل تعتقد ذلك؟

320
00:17:43,240 --> 00:17:45,160
،قد يكون الزّعيم السّامي قويًّا

321
00:17:45,160 --> 00:17:49,050
لكنّني ظننت أنّ مواجهة عدّة
.زعماء ستكون أصعب

322
00:17:49,050 --> 00:17:51,610
.هذا صحيح يا سيّدي

323
00:17:51,610 --> 00:17:53,360
،لكن حتّى لو لم يقضوا عليهم

324
00:17:53,360 --> 00:17:57,420
.فبإمكان فرقة الوحشيّين إشغال الزّعماء

325
00:17:59,670 --> 00:18:04,090
وربّما تكون الوحيد القادر على
.القضاء على الزّعماء السّامين

326
00:18:06,680 --> 00:18:10,260
لكن بهذه الطّريقة، سنخسر على
.الأرجح بعضًا من الوحشيّين

327
00:18:10,260 --> 00:18:11,790
.هذا يناسبنا تمامًا يا سيّدي

328
00:18:12,710 --> 00:18:17,020
.هذا أفضل بمائة مرّة من هروب الزّعيم السّامي

329
00:18:17,810 --> 00:18:20,020
!يا غيربيرغا المُبجّل، أنت سريعًا جدًّا

330
00:18:19,370 --> 00:18:20,940
!أسرعي يا ماري

331
00:18:23,300 --> 00:18:26,690
.انتبها، وإلاّ سيقبض عليكما غير الصّغير

332
00:18:28,880 --> 00:18:31,150
.لن آخذك معي يا سيليس

333
00:18:31,900 --> 00:18:34,090
.لأنّه أمر خطير بالطّبع

334
00:18:34,090 --> 00:18:37,780
.أحتاجكِ لحماية غيربيرغا المُبجّل

335
00:18:38,500 --> 00:18:43,660
تحدّث عن وجود مغامرٍ بارع
،لحماية غيربيرغا المُبجّل

336
00:18:43,660 --> 00:18:47,540
.لكنّني أراهن أنّه كان يُقنعني فقط

337
00:18:47,950 --> 00:18:49,610
...ما زلتُ

338
00:18:50,190 --> 00:18:51,770
.غير جديرة بالثّقة

339
00:18:53,090 --> 00:18:55,730
.ما زلتُ في الرّتبة ف قبل كلّ شيء

340
00:18:57,810 --> 00:19:01,470
،أُسمّي نفسي تلميذة السّيّد لوك

341
00:19:01,470 --> 00:19:05,710
لكن بمستواي هذا، سأكون
.عائقًا في طريقه لو رافقته

342
00:19:05,710 --> 00:19:07,210
.يا أختي سيليس

343
00:19:07,870 --> 00:19:09,500
.آسفة، آسفة

344
00:19:09,500 --> 00:19:11,990
ماذا تريدان أن تلعبا بعد هذا؟

345
00:19:11,990 --> 00:19:13,740
ما هذا؟

346
00:19:22,980 --> 00:19:24,890
...أختي سيليس

347
00:19:27,330 --> 00:19:28,540
!اخرجا بسرعة

348
00:19:30,650 --> 00:19:31,640
!الباب لا يُفتح

349
00:19:31,640 --> 00:19:32,650
!ماذا؟

350
00:19:32,650 --> 00:19:34,230
.آسف يا لاك

351
00:19:34,230 --> 00:19:36,920
أودّ أن أعرض عليك المساعدة
،من نقابة المغامرين

352
00:19:37,270 --> 00:19:39,860
لكنّ مصّاصي الدّماء يستخدمون
.سحرهم الخاصّ بهم

353
00:19:39,860 --> 00:19:41,160
.نعم

354
00:19:41,160 --> 00:19:44,750
،صحيح أنّ الوحشيّين لديهم مقاومة لذلك السّحر

355
00:19:44,750 --> 00:19:48,380
لكن في حالة البشر، قد ينتهي
.الأمر بقتل الرّفاق بعضهم بعضًا

356
00:19:48,380 --> 00:19:51,670
،ولا يمكنني إرسال فرسان أو جنود
.لأسباب مماثلة

357
00:19:51,670 --> 00:19:54,320
البشر الّذين تحوّلوا بامتصاص دمائهم

358
00:19:54,320 --> 00:19:56,640
،يتمتّعون بقدرات جسديّة خارقة

359
00:19:56,640 --> 00:19:59,550
.لكنّنا نستطيع تمييزهم فورًا

360
00:19:59,970 --> 00:20:05,310
مع ذلك، لا نستطيع معرفة متى
.يكون الإنسان مسحورًا بسهولة

361
00:20:13,560 --> 00:20:15,300
!أختي سيليس

362
00:20:15,300 --> 00:20:16,960
!هناك شيء ما

363
00:20:18,020 --> 00:20:19,290
!سيفي

364
00:20:26,070 --> 00:20:27,830
.مصّاصو دماء أدنى

365
00:20:28,270 --> 00:20:30,790
هل أستطيع الانتصار ضدّ ثلاثة منهم؟

366
00:20:37,800 --> 00:20:39,320
.لا يهمّ إن كنت سأفوز أم لا

367
00:20:39,780 --> 00:20:40,960
!يجب أن أفعل هذا

368
00:20:42,520 --> 00:20:45,840
!هذا الخطّ هو عزمي

369
00:20:46,220 --> 00:20:48,970
!لن أدعهم يتجاوزونه

370
00:20:48,970 --> 00:20:50,910
!أختي سيليس

371
00:20:51,360 --> 00:20:52,610
!لا داعي للقلق

372
00:20:53,630 --> 00:20:57,350
!سأحمي الأميرتان والطّائر المقدّس

373
00:21:09,010 --> 00:21:12,040
!لا تنظري في أعينهم، وإلاّ ستُسحرين

374
00:21:20,040 --> 00:21:21,290
!كلاّ

375
00:21:24,560 --> 00:21:26,550
.أرأيتما؟ كلّ شيء على ما يرام

376
00:21:50,530 --> 00:21:51,990
!سيّد لوك

377
00:21:52,410 --> 00:21:54,410
.أبليتِ حسنًا يا سيليس

378
00:21:54,730 --> 00:21:56,920
.كما توقّعت من تلميذتي

379
00:22:02,010 --> 00:22:04,160
.سأتولّى الأمر من هنا