1
00:01:38,070 --> 00:01:40,060
...هذا يؤلم

2
00:01:41,250 --> 00:01:43,260
.يؤلم بشدّة

3
00:01:44,200 --> 00:01:45,770
!ساعدوني

4
00:01:48,520 --> 00:01:51,020
هـ-هل يمكن أن يكون من الموتى الأحياء؟

5
00:01:51,020 --> 00:01:52,360
.ربّما

6
00:02:04,380 --> 00:02:05,930
.سأوفرّ بعض الضّوء

7
00:02:05,930 --> 00:02:06,850
.شكرًا لك

8
00:02:23,640 --> 00:02:25,400
!أنا تلميذتك

9
00:02:28,410 --> 00:02:32,040
!شـ-شـ-شـ-شبح

10
00:02:32,370 --> 00:02:34,260
.أنزلني

11
00:02:34,950 --> 00:02:36,710
.اهدأ يا لوتشيرا

12
00:02:37,380 --> 00:02:39,310
.وفّر لي بعض الضّوء مجدّدًا

13
00:02:43,790 --> 00:02:46,060
.هذا يؤلم

14
00:02:46,060 --> 00:02:49,030
!ساعدوني! أنزلوني

15
00:02:49,430 --> 00:02:51,190
.لا أظنّه شبحًا

16
00:02:54,890 --> 00:02:57,150
.تمهّل، سأنزلك

17
00:02:57,150 --> 00:02:58,760
.أسرع أرجوك

18
00:03:01,620 --> 00:03:03,070
هل أنت مصابة؟

19
00:03:04,700 --> 00:03:07,090
.شكرًا، لقد أنقذتني

20
00:03:09,040 --> 00:03:11,460
ماذا كنت تفعلين هنا؟

21
00:03:11,710 --> 00:03:13,840
!إ-إ-إنها لصّة

22
00:03:13,840 --> 00:03:15,690
!لنسلّمها للسّلطات

23
00:03:15,690 --> 00:03:16,830
.لا، لنتمهّل

24
00:03:17,160 --> 00:03:19,330
.لنستمع إليها أوّلاً

25
00:03:21,930 --> 00:03:23,080
ما اسمك؟

26
00:03:23,080 --> 00:03:24,600
!أنا ميلكا

27
00:03:24,820 --> 00:03:27,160
.أنا لوك، وهذا منزلي

28
00:03:27,160 --> 00:03:30,080
.هذان أفراد عائلتي، لوتشيرا وغيربيرغا المُبجّل

29
00:03:30,080 --> 00:03:31,840
.إنّه ديك ظريف

30
00:03:31,840 --> 00:03:33,040
...ديك

31
00:03:33,040 --> 00:03:34,530
!اسمعي يا هذه

32
00:03:35,750 --> 00:03:37,740
حسنًا، ماذا كنت تفعلين؟

33
00:03:37,740 --> 00:03:39,710
.معذرةً يا سيّد لوك

34
00:03:39,710 --> 00:03:42,140
.ظننتُ أنّ لا أحد يسكن هنا

35
00:03:42,140 --> 00:03:43,980
.كنتُ أريد مكانًا أنام فيه

36
00:03:44,270 --> 00:03:46,630
هنا؟ ليس لديك منزل؟

37
00:03:47,010 --> 00:03:48,030
.ليس لديّ

38
00:03:50,090 --> 00:03:53,460
.توفّي والداي منذ زمن طويل

39
00:03:53,460 --> 00:03:57,960
.كان جدّي يربّيني، لكنّه توفّي مؤخّرًا أيضًا

40
00:04:01,930 --> 00:04:04,040
ماذا حدث للمنزل الّذي كنتما تعيشان فيه؟

41
00:04:04,040 --> 00:04:07,190
.يبدو أنّ جدّي وقع ضحيّة خدعة جعلته مدينًا

42
00:04:07,190 --> 00:04:08,760
.ثمّ جاؤوا وأخذوه

43
00:04:08,760 --> 00:04:14,150
هل هربت لأنّك شعرت أنّهم
سيستعبدونك لسداد الدّين؟

44
00:04:14,150 --> 00:04:15,890
.لم تكن هذه مشكلة

45
00:04:16,250 --> 00:04:20,130
.ألغى الملك تجارة العبيد

46
00:04:20,130 --> 00:04:23,190
.كان ذلك قبل عشر سنوات
أو ربّما ثمانية؟

47
00:04:23,190 --> 00:04:24,710
حقًّا؟

48
00:04:25,230 --> 00:04:27,700
.يبدو أنّ إريك ملك صالح

49
00:04:27,700 --> 00:04:31,390
،على أيّ حال، بحثت عن مأوى
.وجئت إلى هنا

50
00:04:31,390 --> 00:04:33,750
.لم أكن أتوقّع أيّ فخاخ

51
00:04:33,750 --> 00:04:37,000
لحظة. كيف دخلتِ إلى القبو؟

52
00:04:37,840 --> 00:04:41,750
.إنّه متّصل بالصّرف الصّحّيّ

53
00:04:44,000 --> 00:04:45,250
الصّرف الصّحّيّ؟

54
00:04:45,250 --> 00:04:47,450
.نعم، من هناك

55
00:04:52,930 --> 00:04:54,760
.كنتُ مهملاً

56
00:04:55,230 --> 00:04:57,510
،عند الانتقال إلى مكان جديد

57
00:04:57,510 --> 00:05:01,230
أوّل ما يجب فعله هو البحث عن
.أبواب مخفيّة وفخاخ وما إلى ذلك

58
00:05:01,780 --> 00:05:06,210
يبدو أنّ عشر سنوات من القتال
.قد أضعفت مهاراتي في الاستطلاع

59
00:05:06,210 --> 00:05:07,460
يا سيّد لوك؟

60
00:05:07,460 --> 00:05:08,530
.لا تبالي

61
00:05:08,800 --> 00:05:14,530
مع ذلك، ما الّذي يفعله ممرٌّ
خفيٌّ في قصر بارون عاديّ؟

62
00:05:14,530 --> 00:05:16,050
.سأنزل إلى هناك

63
00:05:16,050 --> 00:05:19,190
على أيّ حال، عليّ سدّ الفتحة
.المؤدّية إلى المجاري

64
00:05:19,190 --> 00:05:20,290
.سأذهب معك

65
00:05:20,290 --> 00:05:22,400
.وأنا سأريك الطّريق

66
00:05:26,090 --> 00:05:29,550
.أتساءل لماذا بُني هذا الممرّ

67
00:05:29,820 --> 00:05:32,050
.هذا سؤال وجيه بالفعل

68
00:05:33,010 --> 00:05:36,570
.كنتُ في العادة لأقول أنّها وسيلة للهروب

69
00:05:36,880 --> 00:05:39,710
لكنّ الأمر ليس كما لو أنّ العائلة
.المالكة عاشت هنا

70
00:05:39,710 --> 00:05:41,560
.مهلاً، ها هو هناك

71
00:05:41,840 --> 00:05:44,570
.ظننتُ أنّني سأضطرّ للنّوم في المجاري

72
00:05:44,570 --> 00:05:47,320
لكن بعدما مشيت قليلاً، وجدتُ
.هذه الحفرة، وخرجتُ منها

73
00:05:51,050 --> 00:05:53,970
.لا يبدو أنّ الحفرة قد صُنعت عمدًا

74
00:05:53,970 --> 00:05:55,850
.لا بدّ أنّها انهارت صدفةً

75
00:05:57,580 --> 00:05:58,920
...ومع ذلك

76
00:05:58,920 --> 00:06:01,210
.يبدو أنّ الطّريق طويل

77
00:06:01,210 --> 00:06:05,920
.نعم، لنكمل المسير. يمكننا سدّ الفتحة لاحقًا

78
00:06:06,960 --> 00:06:08,960
...عفوًا يا سيّد لوك

79
00:06:09,790 --> 00:06:12,460
،أعلم أنّ هذا طلب كبير

80
00:06:12,460 --> 00:06:15,970
لكن هل تمانع إن نمتُ هنا لبعض الوقت؟

81
00:06:15,970 --> 00:06:18,880
ماذا؟ تريدين النّوم هنا؟

82
00:06:18,880 --> 00:06:21,630
أنت لا تستخدم هذا الممرّ الآن، أليس كذلك؟

83
00:06:21,630 --> 00:06:23,930
.سيحميني من تقلّبات الطّقس

84
00:06:24,490 --> 00:06:27,350
وأشكّ في أنّ أيّ شخص بالغ
.خطير سيدخل إلى هنا

85
00:06:27,350 --> 00:06:32,230
.لنرَ إلى أين يؤدّي هذا الممرّ قبل أن نقرّر

86
00:06:32,550 --> 00:06:33,760
!مفهوم

87
00:06:34,250 --> 00:06:36,760
.انتظري، لا تتقدّمينا

88
00:06:37,240 --> 00:06:39,200
ماذا لو كانت هناك فخاخ؟

89
00:06:39,200 --> 00:06:41,010
.لهذا السّبب سأتقدّمكم أنا

90
00:06:41,010 --> 00:06:42,490
.أنا من سيتقدّمكم

91
00:06:42,800 --> 00:06:45,250
.وستسيران أنت ولوتشيرا خلفي

92
00:06:45,250 --> 00:06:46,810
.حسنًا

93
00:06:46,810 --> 00:06:50,970
،إذا جعلتني أتقدّمكم
.فأنا من ستقع في أيّ فخّ موجود

94
00:06:50,970 --> 00:06:53,930
هذا صحيح. ما المشكلة؟

95
00:06:53,930 --> 00:06:58,460
،ظننتُ أنّه بينما أنا عالقة
.سيتمكّن البقيّة من الهرب

96
00:07:00,550 --> 00:07:04,780
هل أبدو لك كقاطع طريق أو ما شابه
قد يستخدم طفلة كدرع؟

97
00:07:05,180 --> 00:07:09,020
كـ-كلاّ، لكن أليس هذا ما يفعله الأثرياء عادةً؟

98
00:07:09,270 --> 00:07:11,670
.أنا لا أؤيّد هذا النّوع من التّصرّفات

99
00:07:11,670 --> 00:07:14,170
.لا بدّ أنّك رجل ثريّ لطيف

100
00:07:14,170 --> 00:07:18,830
أوّلاً، لن يقع مغامر مخضرم
.مثلي في أيّ فخّ

101
00:07:18,830 --> 00:07:21,920
يا للعجب! أنت مغامر مخضرم
يا سيّد لوك؟

102
00:07:22,170 --> 00:07:25,140
!أجل! مغامر مخضرم من الرّتبة ف

103
00:07:31,630 --> 00:07:33,330
طريق مسدود؟

104
00:07:36,200 --> 00:07:37,420
.لا

105
00:07:38,150 --> 00:07:40,250
.أشعر بقوّة سحريّة تنبعث من الجدار

106
00:07:40,250 --> 00:07:41,330
.نعم

107
00:07:41,330 --> 00:07:44,130
.يبدو أنّ هناك تعويذة قويّة تسدّ الطّريق

108
00:07:44,130 --> 00:07:45,740
تعويذة قويّة؟

109
00:07:45,740 --> 00:07:47,070
.هذا صحيح

110
00:07:47,300 --> 00:07:50,380
.مثل تلك الّتي نجدها تحرس خزائن القصور

111
00:07:50,380 --> 00:07:51,580
!هذا مذهل

112
00:07:51,580 --> 00:07:55,580
هل يعني هذا أنّ هناك كنزًا
ينتظرنا في الجانب الآخر؟

113
00:07:55,820 --> 00:07:58,680
.لقد قطعنا كلّ هذه المسافة، فلنلقِ نظرة

114
00:07:59,460 --> 00:08:00,630
.تحليل

115
00:08:05,460 --> 00:08:06,470
.تتّبع

116
00:08:10,970 --> 00:08:15,380
،هذا مذهل. كان ذلك سريعًا
.مع أنّه كان قفلاً سحريًّا معقّدًا

117
00:08:15,710 --> 00:08:16,910
.تبديد

118
00:08:26,820 --> 00:08:27,980
!يا إلهي

119
00:08:28,270 --> 00:08:31,980
.هذه... غرفة رائعة حقًّا

120
00:08:32,530 --> 00:08:34,990
سيّد لوك! هل هذا منزل فارغ؟

121
00:08:34,990 --> 00:08:37,100
!إن كان كذلك، فأريد النّوم هنا

122
00:08:37,100 --> 00:08:39,350
.بالطّبع ليس فارغًا

123
00:08:39,350 --> 00:08:41,660
،حتّى لو كان كذلك
.فسيظلّ دخوله غير قانونيًّا

124
00:08:41,660 --> 00:08:43,560
...هـ-هذا صحيح

125
00:08:44,750 --> 00:08:45,880
.أحدهم قادم

126
00:08:45,880 --> 00:08:47,320
!سيّد لوك! سيّد لوك

127
00:08:47,320 --> 00:08:47,970
!أسرع

128
00:08:47,970 --> 00:08:49,190
.ماذا؟ حسنًا

129
00:08:49,190 --> 00:08:51,360
.لا بأس يا غيربيرغا المُبجّل

130
00:08:59,290 --> 00:09:00,700
من هناك؟

131
00:09:01,810 --> 00:09:03,260
.آسف، أعلم أنّ الوقت متأخّر

132
00:09:03,920 --> 00:09:04,880
...لا

133
00:09:06,480 --> 00:09:09,770
لوك، ماذا تفعل هنا في هذه السّاعة؟

134
00:09:10,130 --> 00:09:14,090
أليس من المفترض أن يحضر
الحرّاس في مثل هذا الوقت؟

135
00:09:14,090 --> 00:09:16,550
.لم أظنّ أنّك ستأتي لتتفقّد الأمر بنفسك

136
00:09:16,550 --> 00:09:19,290
.غرفتي مجاورة لهذه الغرفة

137
00:09:19,290 --> 00:09:21,060
هل هذا صحيح؟

138
00:09:21,060 --> 00:09:23,230
.أنا آسف حقًّا لما حدث

139
00:09:23,230 --> 00:09:26,110
،لقد فهمتُ معظم الأمور في طريقي إلى هنا

140
00:09:26,110 --> 00:09:29,900
لكن عندما دخلتُ ورأيتُ ورق
.الحائط، عرفتُ أنّني في القصر

141
00:09:29,900 --> 00:09:32,290
.لا بأس. يمكنكما الخروج

142
00:09:32,290 --> 00:09:36,190
.عجبًا، لوتشيرا وغيربيرغا المُبجّل معك أيضًا

143
00:09:39,380 --> 00:09:40,820
لكن من الفتاة؟

144
00:09:41,910 --> 00:09:44,440
.ميلكا. التقينا منذ قليل

145
00:09:44,660 --> 00:09:46,080
.هكذا إذًا

146
00:09:46,080 --> 00:09:48,840
.أنا إريك، صديق لوك

147
00:09:48,840 --> 00:09:49,800
.تشرّفت بلقائك

148
00:09:50,190 --> 00:09:52,090
!وأنا أيضًا

149
00:09:52,850 --> 00:09:58,070
بمعنى آخر، يتّصل ذلك القصر
بهذا المكان عبر ممرّ تحت الأرض؟

150
00:09:58,070 --> 00:10:01,840
.نعم، لقد تمّ إغلاق هذا الطّرف بإحكام

151
00:10:03,460 --> 00:10:05,830
.لا يبدو أنّ هذا الأمر مفاجئ لك تمامًا

152
00:10:07,380 --> 00:10:09,460
.لكنّ القصّة محرجة

153
00:10:10,340 --> 00:10:14,880
.كان لجدّي، الملك الّذي قبلي بملكين، عشيقة

154
00:10:14,880 --> 00:10:17,880
.بارونة توفّي زوجها وهي صغيرة

155
00:10:17,880 --> 00:10:19,170
.مهلاً لحظة

156
00:10:19,460 --> 00:10:21,970
تقصد في قصري الجديد؟

157
00:10:21,970 --> 00:10:23,230
.نعم

158
00:10:23,400 --> 00:10:27,500
على ما يبدو، كان قد جهّز ذلك
.القصر للبارونة

159
00:10:27,500 --> 00:10:30,570
وهذا يعني أنّ الملك
الّذي سبق الملك السّابق

160
00:10:30,570 --> 00:10:34,480
كان يستخدم الممرّ السّرّيّ
.للتّنقّل بين القصرين

161
00:10:34,480 --> 00:10:37,110
لماذا انقرض نسل البارون؟

162
00:10:37,110 --> 00:10:38,980
.لم يكن هناك ورثة

163
00:10:39,270 --> 00:10:42,400
،كان لها وللبارون ابن واحد

164
00:10:42,400 --> 00:10:47,040
لكنّه كان قد تبنّته عائلة ماركيز
.أخرى ليكون وريثهم

165
00:10:47,040 --> 00:10:49,440
تقصد عمّك؟

166
00:10:49,440 --> 00:10:50,490
.تمامًا

167
00:10:50,490 --> 00:10:52,500
.هذا يوضّح لي الأمر

168
00:10:52,830 --> 00:10:55,010
ماذا تريد أن تفعل بشأن الممرّ؟

169
00:10:55,010 --> 00:10:58,250
.لا أمانع بما أنّه يؤدي إلى منزلك

170
00:10:58,250 --> 00:10:59,720
لا تمانع؟

171
00:10:59,720 --> 00:11:01,830
.في الواقع، هذا مطمئن

172
00:11:01,830 --> 00:11:05,150
لكنّ ربطه بشبكة الصّرف الصّحّيّ
.ليس بالأمر الجيّد

173
00:11:05,380 --> 00:11:08,760
.بإمكاني سدّ الثّقب في الجدار بالسّحر

174
00:11:09,000 --> 00:11:10,660
.سأكون ممتنًّا لذلك

175
00:11:16,210 --> 00:11:18,210
.سأصلحه ثانية غدًا

176
00:11:18,210 --> 00:11:20,320
.هذا يكفي كإصلاح مؤقّت

177
00:11:20,320 --> 00:11:21,420
.لنعد الآن

178
00:11:25,760 --> 00:11:28,780
.لا ألومها، نحن في منتصف اللّيل

179
00:11:31,530 --> 00:11:33,870
حسنًا، هل نعود للمنزل؟

180
00:11:34,920 --> 00:11:36,290
.يا سيّد لوك

181
00:11:36,600 --> 00:11:40,290
هل يمكنك... السّماح لميلكا بالبقاء في القصر؟

182
00:11:41,260 --> 00:11:43,800
...تلك الفاكهة الّتي أحضرتها معها

183
00:11:43,800 --> 00:11:48,540
،إنّها حامضة جدًّا وهي غير ناضجة
.وليست صالحة للأكل

184
00:11:49,600 --> 00:11:52,270
.كنتُ أنوي السّماح لها بالبقاء منذ البداية

185
00:11:54,560 --> 00:11:56,430
!شكرًا لك

186
00:12:08,860 --> 00:12:12,710
أين... أنا؟

187
00:12:14,560 --> 00:12:17,170
!يا له من قصر ضخم

188
00:12:17,170 --> 00:12:19,940
هل عدتُ إلى تلك الغرفة من الأمس؟

189
00:12:22,220 --> 00:12:24,130
.معدتي تُصدر أصواتًا

190
00:12:26,290 --> 00:12:28,490
.لا بدّ أنّني جائعة جدًّا

191
00:12:28,490 --> 00:12:30,220
.إنّه صوت عال جدًّا

192
00:12:36,740 --> 00:12:38,230
!توقّف

193
00:12:38,230 --> 00:12:39,580
!لا تأكلني

194
00:12:39,580 --> 00:12:42,190
!النّجدة! ليساعدني أحد

195
00:12:42,190 --> 00:12:44,230
.حسنًا يا غارب، يكفي هذا

196
00:12:44,490 --> 00:12:45,950
!سيّد لوك

197
00:12:47,400 --> 00:12:49,810
ظننتَ أنّك أمسكتَ بلصّة، أليس كذلك؟

198
00:12:49,810 --> 00:12:52,850
.أحسنت. هيّا، أطلق سراحها

199
00:12:56,770 --> 00:12:57,880
!ما هذا؟

200
00:12:57,880 --> 00:13:01,430
!أين أنا؟! ماذا أفعل هنا؟

201
00:13:01,430 --> 00:13:03,920
ما كلّ هذه الضّجّة؟

202
00:13:03,920 --> 00:13:06,060
.سمعتُ صراخًا بعد إذنكم

203
00:13:06,060 --> 00:13:07,640
.صباح الخير

204
00:13:10,860 --> 00:13:13,210
.ستعيش معنا ابتداءً من اليوم

205
00:13:13,210 --> 00:13:14,840
.مـ-مرحبًا

206
00:13:14,840 --> 00:13:17,050
!لحظة، ماذا؟! هل يُمكنني ذلك؟

207
00:13:17,050 --> 00:13:19,770
.بالتّأكيد، إذا كنت ترغبين في ذلك

208
00:13:19,770 --> 00:13:22,160
.تشرّفت بمعرفتك. أنا سيليس

209
00:13:22,160 --> 00:13:23,530
!وأنا سيا

210
00:13:23,790 --> 00:13:27,570
.سأُكلّف ميلكا بأعمال التّنظيف والمنزل

211
00:13:27,570 --> 00:13:29,400
!بالتّأكيد! دع الأمر لي

212
00:13:29,640 --> 00:13:32,090
،إذا كان هناك أيّ شيء لا تعرفينه
.فاسألي لوتشيرا

213
00:13:32,090 --> 00:13:33,770
.هو من يعتني بالمكان حاليًّا

214
00:13:33,770 --> 00:13:36,390
.مسرورة بالعمل معك يا لوتشيرا

215
00:13:36,390 --> 00:13:38,290
.يمكنك أن تسألني عن أيّ شيء

216
00:13:38,910 --> 00:13:40,790
.لقد كبرت العائلة

217
00:13:40,790 --> 00:13:42,090
.بالتّأكيد

218
00:13:46,290 --> 00:13:48,040
.إنّها جائعة

219
00:13:48,040 --> 00:13:50,060
.حسنًا، لنتناول الفطور

220
00:13:50,060 --> 00:13:51,730
.سأجهّزه قريبًا

221
00:13:51,730 --> 00:13:53,280
.اسمح لي بالمساعدة

222
00:13:53,280 --> 00:13:54,790
!و-وأنا أيضًا

223
00:13:58,180 --> 00:14:00,770
.احتجتَ ليلة واحدة فقط لجلب ساكن آخر

224
00:14:00,770 --> 00:14:02,950
.لا تهدأ الأمور من حولك أبدًا يا لوك

225
00:14:02,950 --> 00:14:04,310
.أنت محقّ تمامًا

226
00:14:04,310 --> 00:14:06,990
.هذا هو ما يعنيه أن تكون حكيمًا عظيمًا

227
00:14:06,990 --> 00:14:09,570
!هذا لذيذ! لذيذ جدًّا! وهذا لذيذ أيضًا

228
00:14:09,570 --> 00:14:11,640
!وكذلك هذا

229
00:14:12,950 --> 00:14:15,580
ممرّ سرّيّ يؤدّي إلى القصر؟

230
00:14:16,300 --> 00:14:20,040
.الآن فهمتُ سبب وجود برج المراقبة المبالغ فيه

231
00:14:20,040 --> 00:14:24,340
سأقوم اليوم بتدعيم النّفق
.بالكامل، وسدّ الفتحة تمامًا

232
00:14:24,650 --> 00:14:27,450
ماذا عن الفتحة المؤدّية إلى القصر؟

233
00:14:27,450 --> 00:14:31,130
.أخطّط لتركيب باب قابل للقفل من جهة القصر

234
00:14:31,130 --> 00:14:32,200
باب؟

235
00:14:32,200 --> 00:14:34,590
.ولم يستطع إلاّ قلّة مختارة من المرور منه

236
00:14:34,970 --> 00:14:38,410
ألن يكون من الجيّد وجود مخرج
طوارئ، تحسّبًا لأيّ طارئ؟

237
00:14:38,410 --> 00:14:39,770
.هذا منطقيّ

238
00:14:39,770 --> 00:14:41,230
...ومع ذلك

239
00:14:41,570 --> 00:14:45,920
لماذا نصبت البارونة فخًّا بعد إذنكم؟

240
00:14:45,920 --> 00:14:51,320
لا يبدو ذلك ضروريًّا إذا كانت
.هي والملك يتردّدان على ذلك الممرّ

241
00:14:51,320 --> 00:14:55,760
أليس ذلك تحسّبًا لمرور شخص آخر غيرهما؟

242
00:14:55,760 --> 00:14:57,370
شخص آخر غيرهما؟

243
00:14:57,370 --> 00:15:00,550
.كزوجة ذلك الملك السّابق مثلاً

244
00:15:00,550 --> 00:15:04,240
حسنًا، أعتقد أنّها ستكون مشكلة
.لو خرجت من ذلك الممرّ

245
00:15:04,240 --> 00:15:06,450
هكذا الأمر إذًا؟

246
00:15:06,450 --> 00:15:08,250
!لذيذ! لذيذ جدًّا

247
00:15:08,250 --> 00:15:10,640
.ميلكا. هذا لذيذ أيضًا

248
00:15:10,830 --> 00:15:13,130
هل لي ببعضٍ يا أختي سيليس؟

249
00:15:13,910 --> 00:15:15,770
!يا فرحتي

250
00:15:16,130 --> 00:15:18,610
!أ-أختي". كم أعجبني ذلك"

251
00:15:18,610 --> 00:15:19,830
!هل تريدين بعضًا من هذا أيضًا؟

252
00:15:19,830 --> 00:15:22,150
!شكرًا يا أختي سيليس

253
00:15:23,120 --> 00:15:25,700
!قوليها ثانية

254
00:15:26,380 --> 00:15:29,470
.سأذهب لأمرّ على النّقابة

255
00:15:29,470 --> 00:15:32,520
لديّ بعض الأعمال في النّقابة
أيضًا. هل تريدين الذّهاب معي؟

256
00:15:32,520 --> 00:15:34,250
!يشرّفني ذلك يا سيّدي

257
00:15:34,250 --> 00:15:36,640
.سلّمي على أريو وجيني إن رأيتهما

258
00:15:36,640 --> 00:15:38,370
.أخبريهما عن هذا المنزل أيضًا

259
00:15:38,370 --> 00:15:39,530
.بكلّ سرور

260
00:15:39,890 --> 00:15:43,190
لوتشيرا، أين أدوات التّنظيف؟

261
00:15:43,190 --> 00:15:45,930
.عفوًا، لكن لم نشترها بعد

262
00:15:45,930 --> 00:15:47,690
.انتقلنا حديثًا فحسب

263
00:15:47,690 --> 00:15:49,870
.لكنّني فكّرتُ في القيام بالتّنظيف

264
00:15:50,290 --> 00:15:53,530
.حسنًا، أحتاج أنا أيضًا إلى حجارة لترميم الجدار

265
00:15:53,530 --> 00:15:54,980
.أعتقد أنّني سأذهب لشراء بعضه

266
00:15:54,980 --> 00:15:56,260
!سأذهب أنا أيضًا

267
00:15:56,260 --> 00:15:59,920
.وأنا كذلك. سأريك متجرًا لبيع الحجارة

268
00:15:59,920 --> 00:16:03,400
هل لي أن أطلب منك الاعتناء
بالمنزل يا لوتشيرا؟

269
00:16:03,400 --> 00:16:06,450
.نعم، وسأرتّب الوضع في الدّاخل

270
00:16:08,790 --> 00:16:10,700
.هذا تاجر الحجارة

271
00:16:10,700 --> 00:16:14,650
،حسنًا. ميلكا وغارب
هل يمكنكما الانتظار هنا؟

272
00:16:14,650 --> 00:16:16,580
سنذهب للبحث عن أدوات
.التّنظيف حالما ننتهي

273
00:16:16,580 --> 00:16:17,440
.أكيد

274
00:16:23,960 --> 00:16:25,400
.هذا متجر أدوات

275
00:16:25,950 --> 00:16:29,410
سأذهب لإلقاء نظرة على
!أدوات التّنظيف. انتظر هنا

276
00:16:31,800 --> 00:16:34,460
...فرشاة وممسحة و

277
00:16:34,960 --> 00:16:37,450
.نحتاج أيضًا إلى رماد ورمل تلميع

278
00:16:44,480 --> 00:16:46,610
غارب، أين ميلكا؟

279
00:16:51,450 --> 00:16:53,050
!يا سيّد لوك، هناك مشكلة

280
00:16:53,050 --> 00:16:55,860
قالوا أنّ بعض الأشخاص
!السّيّئين قد أخذوا ميلكا

281
00:16:55,860 --> 00:16:58,390
!أخذوها؟! غارب

282
00:17:04,860 --> 00:17:07,630
.وجدناك أخيرًا أيّتها الشّقيّة

283
00:17:07,630 --> 00:17:10,050
.ستأتين معنا الآن

284
00:17:10,050 --> 00:17:11,160
لماذا؟

285
00:17:11,410 --> 00:17:14,210
.أليس هذا واضحًا؟ أنت مدينة لنا بالمال

286
00:17:14,460 --> 00:17:18,460
،سبق وأخذتم منزل جدّي
!والآن تريدون المزيد من المال؟

287
00:17:18,700 --> 00:17:21,980
!ذلك المكان المتهالك لا يكفي لسداد الدّين

288
00:17:21,980 --> 00:17:26,610
قال لي شخص مهمّ أنّني لستُ
!مُلزمة بسداد دين جدّي

289
00:17:26,610 --> 00:17:28,370
.غارب، ابقَ بعيدًا عن هذا

290
00:17:26,900 --> 00:17:28,370
!وكأنّني أهتمّ

291
00:17:28,370 --> 00:17:31,190
!أنت حفيدته، بالطّبع عليك السّداد

292
00:17:33,750 --> 00:17:35,480
ومن تكون يا هذا؟

293
00:17:35,880 --> 00:17:37,610
.وصيّ تلك الفتاة

294
00:17:37,610 --> 00:17:38,850
!سيّد لوك

295
00:17:38,850 --> 00:17:43,420
حقًّا؟ ستقوم بسداد ديونها بدلاً منها إذًا؟

296
00:17:43,650 --> 00:17:46,030
ألم تكن تستمع إليها؟

297
00:17:46,030 --> 00:17:48,660
.ليس عليها سداد دين جدّها

298
00:17:48,660 --> 00:17:49,850
أرأيت؟

299
00:17:49,850 --> 00:17:54,300
—اخرسي! سنجعلك تعملين حتّى تدفعي

300
00:17:58,500 --> 00:17:59,730
!وغد

301
00:17:59,730 --> 00:18:01,290
!أتظنّ أنّك تستطيع العبث معنا؟

302
00:18:06,810 --> 00:18:08,040
!ميلكا

303
00:18:08,600 --> 00:18:10,230
!أختي سيليس

304
00:18:11,470 --> 00:18:12,720
هل أنت بخير؟

305
00:18:12,720 --> 00:18:13,840
.نعم

306
00:18:13,840 --> 00:18:16,740
!لن أسمح بهذا! سأسلّمهم للسّلطات

307
00:18:16,740 --> 00:18:19,070
.انتظري، ليس بعد

308
00:18:24,270 --> 00:18:28,750
يا حثالة، أتظنّون أنّ بإمكانكم
!فعل ما تشاؤون في منطقتي؟

309
00:18:29,580 --> 00:18:30,810
!سا-سامحني

310
00:18:30,810 --> 00:18:33,120
!كنّا ننفّذ الأوامر فقط

311
00:18:33,120 --> 00:18:34,750
أوامر من؟

312
00:18:34,750 --> 00:18:39,640
،أنا أعمل لدى السّيّد كافينو
.وهو مُقرض أموال في الأحياء الفقيرة

313
00:18:41,070 --> 00:18:44,680
!ماذا يفعل رجل يعمل لديه هنا؟

314
00:18:44,680 --> 00:18:49,420
إنّنا نحاول تحصيل دين من
!حفيدة مُدين عجوز متوفٍّ

315
00:18:49,420 --> 00:18:52,250
!حفيدة؟ لكنّها مجرّد طفلة

316
00:18:52,250 --> 00:18:54,320
!كـ-كنّا سنبيعها

317
00:18:54,320 --> 00:18:56,770
!ستُباع بسعر باهظ في السّوق السّوداء

318
00:18:57,190 --> 00:19:01,780
،كان السّيّد كافينو تاجر عبيد
.لذا لديه معارف كُثُر

319
00:19:01,780 --> 00:19:03,370
...أرجوك

320
00:19:04,230 --> 00:19:07,750
.قدّم هذا الرّجل معلومات لا تصدّق

321
00:19:07,750 --> 00:19:10,240
.حسنًا، الآن نسلّمهم للسّلطات

322
00:19:11,230 --> 00:19:13,620
اسمه كافينو إذًا؟

323
00:19:13,950 --> 00:19:16,380
هل هناك مشكلة ما؟

324
00:19:16,670 --> 00:19:19,580
...سأخبرك بهذا لأنّك ابنة اللّورد مورتون

325
00:19:19,890 --> 00:19:24,150
لكنّ كافينو دونوفان شخصيّة
.نافذة تسيطر على الأحياء الفقيرة

326
00:19:24,150 --> 00:19:27,130
.لديه جيش خاصّ به

327
00:19:27,880 --> 00:19:31,270
وحسب ما سمعت، تربطه علاقات
.وثيقة ببعض أفراد الطّبقة الأرستقراطيّة

328
00:19:31,810 --> 00:19:35,600
كلّما حصلنا على دليل على
،جرائم كافينو في الماضي

329
00:19:36,190 --> 00:19:39,000
.اختفى ذلك الدّليل بطريقة ما

330
00:19:39,520 --> 00:19:41,350
ماذا تقول؟

331
00:19:43,930 --> 00:19:46,550
تشاجروا مع بعض المغامرين؟

332
00:19:46,550 --> 00:19:49,360
!هؤلاء الحمقى أفسدوا كلّ شيء

333
00:19:49,580 --> 00:19:52,860
وذلك في الوقت الّذي لدينا فيه
.عمل مهمّ قادم

334
00:19:52,860 --> 00:19:56,780
،يمكنني إبقاء السّلطات بعيدًا عنّي
.لكنّ نقابة المغامرين ستجلب المتاعب

335
00:19:56,780 --> 00:19:59,370
.ففي النّهاية، اللّورد مورتون هو المسؤول

336
00:19:59,370 --> 00:20:00,850
ماذا نفعل؟

337
00:20:00,850 --> 00:20:03,080
.ما زالت أعدادنا قليلة

338
00:20:03,650 --> 00:20:06,700
،في الوقت الحاليّ
.سننقل البضائع إلى مكان آخر

339
00:20:06,700 --> 00:20:07,640
!جهّزوا الأمور

340
00:20:07,640 --> 00:20:08,540
.حاضر

341
00:20:09,710 --> 00:20:14,010
،إذا تسبّب أيّ مغامر في مشاكل
.فهنا يحين دوركم للتّدخّل

342
00:20:14,010 --> 00:20:17,400
.لنر ما يمكن لمغامري الرّتبة ج فعله

343
00:20:17,400 --> 00:20:20,320
.أنت مخطئ يا سيّد كافينو

344
00:20:20,320 --> 00:20:23,400
.كانت هذه رتبتنا عندما غادرنا النّقابة

345
00:20:23,400 --> 00:20:26,660
.نعدّ الآن من الرّتبة ب

346
00:20:27,280 --> 00:20:29,410
.هذه فرصة مثاليّة

347
00:20:29,410 --> 00:20:35,040
.أجل. لننتقم من النّقابة لطردها لنا

348
00:20:36,080 --> 00:20:38,410
!هيّا، تحرّكوا

349
00:20:43,770 --> 00:20:47,170
...جئتُ لأشتكي ممّا حدث لفتاتي

350
00:20:48,920 --> 00:20:52,920
لكن يبدو أنّ لديّ الآن ما يكفي من
.الأدلّة ضدّكم لأزجّ بكم في السّجن

351
00:20:53,220 --> 00:20:55,190
من تكون يا هذا؟

352
00:20:57,000 --> 00:20:59,940
!مغامرٌ مخضرم من الرّتبة ف

353
00:20:59,940 --> 00:21:02,690
!أتظنّ نفسك مضحكًا؟ أمسكوا به

354
00:21:04,820 --> 00:21:07,650
.أجل، أجل. هذا أفضل

355
00:21:15,190 --> 00:21:16,830
...هل هذا الرّجل حقًّا

356
00:21:17,590 --> 00:21:19,570
!من الرتبة ف؟

357
00:21:19,840 --> 00:21:22,350
.تنحّوا جانبًا، لا داعي للعناء

358
00:21:22,560 --> 00:21:25,340
.لا يمكنكم تولّي أمره

359
00:21:25,670 --> 00:21:30,100
!سنواجهك نحن يا ذا الرّتبة ف

360
00:21:30,370 --> 00:21:33,100
.لأنّنا من الرّتبة ب

361
00:21:33,100 --> 00:21:38,170
.كما تعلم، لن نتساهل معك لمجرّد أنّك أعزل

362
00:21:38,170 --> 00:21:40,580
.يمكنك ترك هذين الاثنين لتلميذتك

363
00:21:41,100 --> 00:21:43,730
.لا داعي لأن يُشغِل حضرتك نفسه بهما