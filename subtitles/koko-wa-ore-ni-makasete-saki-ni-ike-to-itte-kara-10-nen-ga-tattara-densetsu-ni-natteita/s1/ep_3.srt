1
00:00:08,030 --> 00:00:09,360
...أنت

2
00:00:12,150 --> 00:00:14,090
!أنت ابن بابا غير الشّرعيّ، أليس كذلك؟

3
00:01:45,290 --> 00:01:47,740
!ا-ابن غير شرعيّ؟

4
00:01:47,740 --> 00:01:48,760
.كنتُ أعرف ذلك

5
00:01:48,760 --> 00:01:51,000
.لا، أنت مخطئة تمامًا

6
00:01:51,000 --> 00:01:51,920
.هذه كذبة

7
00:01:51,920 --> 00:01:53,380
كيف وصلنا إلى هذا؟

8
00:01:53,380 --> 00:01:55,770
.ماذا؟ إنّه استنتاج بسيط

9
00:01:56,570 --> 00:01:58,260
.هناك ثلاثة دلائل

10
00:01:58,790 --> 00:02:03,590
أوّلاً، انتظر بابا حتّى غابت ماما
.ليسمح لك بالدّخول إلى المنزل

11
00:02:04,020 --> 00:02:09,910
.ثانيًا، بدا بابا سعيدًا للغاية منذ ظهورك

12
00:02:10,270 --> 00:02:16,950
ثالثًا، الطّريقة الّتي كان بابا قلقًا
.للغاية أثناء غيابك لثلاثة أيّام

13
00:02:16,950 --> 00:02:18,520
!هل هو أمّي؟

14
00:02:19,740 --> 00:02:21,540
.بابا غبيّ بالفعل

15
00:02:21,790 --> 00:02:27,030
يبدو الأمر وكأنّ عائلة غوران
.على وشك الانهيار

16
00:02:29,130 --> 00:02:33,040
في نظراته ضغطٌ هائل يقول
."افعل شيئًا حيال هذا"

17
00:02:35,180 --> 00:02:36,870
...بخصوص ذلك

18
00:02:36,870 --> 00:02:41,560
كان قلقًا على صديقٍ كان يقاتل
.بعيدًا منذ عشر سنوات

19
00:02:41,560 --> 00:02:43,550
.هذا غير منطقيّ

20
00:02:43,550 --> 00:02:47,330
.أوّلاً، أنا أحد أصدقاء غوران المغامرين

21
00:02:47,330 --> 00:02:49,060
.أنا أكبر سنًّا ممّا أبدو عليه

22
00:02:51,410 --> 00:02:53,670
.لا بدّ أنّها فهمت الآن

23
00:02:53,670 --> 00:02:54,990
...بمعنى آخر

24
00:02:54,990 --> 00:02:56,560
.هكذا هو الأمر

25
00:02:57,340 --> 00:03:00,700
.لا بدّ أنّك أخي الأكبر الشّرعيّ

26
00:03:02,740 --> 00:03:05,730
!أخبرتك أنّي لستُ أخاك الأكبر

27
00:03:05,730 --> 00:03:07,190
!إذًا أنت أخي الأصغر

28
00:03:07,190 --> 00:03:09,700
.تحدّثنا عن عمري للتّوّ

29
00:03:10,250 --> 00:03:12,460
."يمكنك مناداتي "أختي العزيزة

30
00:03:12,460 --> 00:03:16,960
!يا لها من قفزة منطقيّة
!خيالها واسع جدًّا

31
00:03:17,330 --> 00:03:19,470
.لم تتركي لي خيارًا

32
00:03:19,980 --> 00:03:21,800
.انظري إلى هذه

33
00:03:21,800 --> 00:03:23,710
بطاقة مغامر؟

34
00:03:23,710 --> 00:03:26,450
.انظري جيّدًا إلى الاسم

35
00:03:26,450 --> 00:03:27,970
".لوك"

36
00:03:28,320 --> 00:03:31,230
"لا يوجد اسم "مورتون
في أيّ مكان عليها، صحيح؟

37
00:03:32,940 --> 00:03:36,110
!هذا يعني أنّ بابا لا يعترف بك

38
00:03:36,110 --> 00:03:39,100
هـ-هذا ما فهمته؟

39
00:03:39,510 --> 00:03:42,990
.يا له من أمر فظيع. إنّه خطأ بابا

40
00:03:43,350 --> 00:03:45,370
.لم تقترف أيّ خطأ

41
00:03:45,990 --> 00:03:48,100
.اترك كلّ شيء لأختك العزيزة

42
00:03:48,100 --> 00:03:50,490
!سأقنعه بالاعتراف بك

43
00:03:50,490 --> 00:03:51,950
.لا، لا، لا

44
00:03:51,950 --> 00:03:53,360
.لا تمنعني

45
00:03:53,360 --> 00:03:56,260
،قد تغضب ماما وتؤدّب بابا بشدّة

46
00:03:56,260 --> 00:03:57,990
.لكنّها ستلقّنه درسًا

47
00:03:58,330 --> 00:04:02,130
!هل عائلة غوران مُعرّضة للانهيار؟

48
00:04:02,760 --> 00:04:04,600
.اسمعي جيّدًا يا سيليس

49
00:04:04,600 --> 00:04:06,220
!"نادني "أختي العزيزة

50
00:04:07,820 --> 00:04:09,250
...أختي العزيزة

51
00:04:10,060 --> 00:04:12,020
ماذا يا لوك؟

52
00:04:21,160 --> 00:04:23,290
هل يمكنك كتم سرّ؟

53
00:04:23,290 --> 00:04:25,780
.بالتّأكيد. أنا أختك

54
00:04:27,130 --> 00:04:29,050
.سأزيل التّمويه

55
00:04:33,380 --> 00:04:36,050
".لاك لوك فرانزِن"

56
00:04:36,050 --> 00:04:37,790
!الرّتبة س؟

57
00:04:37,790 --> 00:04:41,120
،إذا كنتِ ابنة غوران
.فأنا متأكّد أنّك فهمت الآن

58
00:04:41,120 --> 00:04:44,040
،الحكيم العظيم ومنقذنا

59
00:04:44,040 --> 00:04:49,080
،السّاحر العظيم
...الأرشيدوق لاك لوك فرانزِن

60
00:04:49,540 --> 00:04:51,060
!كيف يُعقل هذا؟

61
00:04:51,330 --> 00:04:55,560
.عدتُ للتّوّ من الصّدع البُعديّ قبل أيّام قليلة

62
00:04:56,090 --> 00:04:58,400
.مـ-مستحيل

63
00:04:59,670 --> 00:05:01,070
.هذا لا يُعقل

64
00:05:04,280 --> 00:05:09,080
هل الحكيم العظيم لاك
هو أخي الصّغير؟

65
00:05:11,020 --> 00:05:12,320
،بالمناسبة

66
00:05:12,320 --> 00:05:16,090
لطالما ظننتُ أنّ تمثال القدّيس
.العظيم لاك يُشبه بابا نوعًا ما

67
00:05:16,090 --> 00:05:18,080
.ذلك لأنّكما أب وابن

68
00:05:20,090 --> 00:05:22,220
!لا، إنّه لا يُشبهه

69
00:05:22,220 --> 00:05:24,230
.كنّا إخوة طوال هذا الوقت

70
00:05:24,230 --> 00:05:27,260
!لا! لستُ أخاك الصّغير

71
00:05:27,260 --> 00:05:28,760
أخي الكبير إذًا؟

72
00:05:31,070 --> 00:05:35,820
!اسمعي... إليّ

73
00:05:41,740 --> 00:05:45,480
!أ-أنا آسفة جدًّا أيّها القدّيس العظيم لاك

74
00:05:45,480 --> 00:05:48,180
.يُفترض أنّ هذا سرّ

75
00:05:48,180 --> 00:05:49,230
.حاضرة

76
00:05:49,740 --> 00:05:54,050
سيليس، أنت حقًّا تُبالغين
.في الاقتناع بالأمور

77
00:05:54,050 --> 00:05:55,870
.أسمع هذا كثيرًا

78
00:05:55,870 --> 00:06:00,720
أظنّ أنّني فهمت الآن سبب معارضة
.غوران لخروجك في مغامرات

79
00:06:01,980 --> 00:06:06,800
.لكنّ العزيمة القويّة تعني أيضًا الإرادة القويّة

80
00:06:08,110 --> 00:06:09,410
.سيليس

81
00:06:10,140 --> 00:06:12,090
أترغبين في الانضمام إليّ لوقت وجيز؟

82
00:06:16,110 --> 00:06:20,580
دعوتُ سيليس لمرافقتي في مهمّة
.من النّقابة ليست صعبة للغاية

83
00:06:21,100 --> 00:06:26,220
،وكما كان غوران يخشى
.فقد تسجّلت بالفعل كمغامِرة

84
00:06:28,100 --> 00:06:30,530
،لو لم أصطحبها معي بهذه الطّريقة

85
00:06:30,530 --> 00:06:33,580
لربّما كانت ستذهب
.في مهمّة أخرى على أيّ حال

86
00:06:39,690 --> 00:06:41,110
!لنأخذ استراحة هنا

87
00:06:40,060 --> 00:06:44,960
متأكّد من أنّها أرادت تجربة المغامرة
.في العالم الخارجيّ بشروطها الخاصّة

88
00:07:15,300 --> 00:07:19,170
،كما ذكر وصفُ إعلان المهمّة
.فقد شوهدت وحوش خرافيّة هنا

89
00:07:19,450 --> 00:07:24,950
سربيروس وهيدرا وكيميرا
.وسايكلوبس وحتّى تنّين عملاق

90
00:07:25,420 --> 00:07:28,750
ومع ذلك، يبدو أنّه لم تكن
.هناك أيّ خسائر بشريّة

91
00:07:29,090 --> 00:07:31,500
رغم وجود تنّين؟

92
00:07:31,800 --> 00:07:34,960
،إذا كان هذا صحيحًا
.فهذه ليست مهمّة من الرّتبة إي

93
00:07:34,960 --> 00:07:38,270
أنت محقّ. ماذا يعني هذا؟

94
00:07:38,560 --> 00:07:42,010
وحوش خرافيّة هنا، على مقربة
...من العاصمة الملكيّة

95
00:07:42,340 --> 00:07:45,780
لا بدّ أنّ النّقابة قرّرت أنّ هذه
.الوحوش غير موجودة في الواقع

96
00:07:45,780 --> 00:07:46,790
ماذا؟

97
00:07:46,790 --> 00:07:49,520
.فكّري في الأمر بعقل متفتّح

98
00:07:50,100 --> 00:07:53,800
،وحوش خرافيّة غير موجودة
...ولكن تمّ رصدها

99
00:07:53,800 --> 00:07:56,400
...لم يلحق أيّ أذى بالبشر

100
00:07:57,820 --> 00:07:59,030
أهي أوهام؟

101
00:07:59,720 --> 00:08:01,410
.أعتقد ذلك أيضًا

102
00:08:03,940 --> 00:08:06,620
هل هذا هو المكان المذكور
في شهادات شهود العيان؟

103
00:08:06,620 --> 00:08:07,540
.نعم

104
00:08:18,270 --> 00:08:20,060
!سـ-سيّد لوك؟

105
00:08:20,060 --> 00:08:22,900
!هذا وهم حقًّا، أليس كذلك؟

106
00:08:22,900 --> 00:08:24,310
!أشعر بحرارة صادرة منه بالفعل

107
00:08:24,310 --> 00:08:27,800
،نعم. لا أشعر بكتلة تنّين حقيقيّ

108
00:08:27,800 --> 00:08:30,420
.أو بدفء كائن حيّ

109
00:08:30,420 --> 00:08:33,940
.لكنّه دقيق للغاية، بالنّسبة لمجرّد وهم

110
00:08:40,090 --> 00:08:42,290
!هيّا يا سيليس

111
00:08:42,290 --> 00:08:44,460
!حسنًا! سأنطلق

112
00:09:20,690 --> 00:09:21,900
.ممتاز

113
00:09:22,330 --> 00:09:25,090
،حتّى بدون تحيّز غوران الأبويّ

114
00:09:25,090 --> 00:09:28,580
.فقدرات سيليس كمحاربة تضعها في الرّتبة ب

115
00:09:29,360 --> 00:09:33,880
.مع ذلك، هذا وهم دقيق بشكل مذهل

116
00:09:34,220 --> 00:09:37,960
هذا يتجاوز بكثير مجرّد
.عرض شخص ما لشبح

117
00:09:37,960 --> 00:09:40,880
.إنّها كتلة هائلة من القوّة السّحريّة

118
00:09:41,410 --> 00:09:46,640
،لهذا السّبب يستطيع سيفها إصابته
.وأراهن أنّ تلك الضّربات تبدو قويّة

119
00:09:47,040 --> 00:09:51,650
لقد تمّ تجسيد ذلك الشّيء، لكنّها
.انخدعت تمامًا وصدّقت أنّه حقيقيّ

120
00:09:57,270 --> 00:09:58,900
.هذه إشارتي

121
00:09:59,690 --> 00:10:00,770
.التّحليق

122
00:10:02,270 --> 00:10:03,330
.السّرعة الفائقة

123
00:10:06,460 --> 00:10:07,610
.التّعلّم

124
00:10:09,240 --> 00:10:12,170
!سأستغلّ هذه السّحر

125
00:10:19,290 --> 00:10:20,800
.لمسة الاستنزاف

126
00:10:35,200 --> 00:10:36,950
.يمكنك التّوقّف في أيّ وقت الآن

127
00:10:39,000 --> 00:10:40,290
ماذا؟

128
00:10:40,290 --> 00:10:42,450
.لم أحترق

129
00:10:42,450 --> 00:10:44,330
.لأنّه مجرّد وهم

130
00:10:44,610 --> 00:10:47,390
.إذا واجهتِ وهمًا وجهًا لوجه، ستخسرين

131
00:10:47,390 --> 00:10:50,840
!ليتك قلت هذا مسبقًا

132
00:10:51,600 --> 00:10:53,700
لا يمكن محاربته؟

133
00:10:53,700 --> 00:10:55,670
حسنًا، ما العمل إذًا؟

134
00:10:56,080 --> 00:10:58,370
.اعثري على من أطلقه، واهزميه

135
00:10:58,370 --> 00:11:01,220
،إذا لم تتمكّني من تحديد مكانه
.فمن الأفضل أن تهربي

136
00:11:01,220 --> 00:11:04,470
.أهرب؟ سيكون ذلك مزعجًا

137
00:11:04,470 --> 00:11:06,230
.إنّه أفضل من الموت

138
00:11:06,230 --> 00:11:09,110
...هـ-هذا صحيح، لكن

139
00:11:10,760 --> 00:11:14,100
!أعلم أنّك تستمع يا مطلق الأوهام

140
00:11:19,120 --> 00:11:21,710
ما رأيك أن نتحدّث بشأن هذا؟

141
00:11:22,110 --> 00:11:25,120
!نعلم أنّك لم تؤذِ أيّ قرويّ

142
00:11:25,120 --> 00:11:29,620
لا بدّ أنّ لديك سببًا لمحاولة
إبعادهم، أليس كذلك؟

143
00:11:33,120 --> 00:11:36,040
!نحن هنا بناءً على طلب من النّقابة

144
00:11:36,800 --> 00:11:40,380
!علينا أن نتحقّق من الأمر، شئت أم أبيت

145
00:11:47,820 --> 00:11:52,020
.هناك... شيءٌ يجب عليّ حمايته

146
00:11:52,850 --> 00:11:54,090
أهو طفل؟

147
00:11:54,090 --> 00:11:57,150
هل يجب أن يبقى ذلك الشّيء هنا؟

148
00:11:57,650 --> 00:12:00,900
.نقله... ليس بالأمر السّهل

149
00:12:00,900 --> 00:12:02,380
.فهمت

150
00:12:02,380 --> 00:12:07,390
لكن في الوضع الحاليّ، علينا إخبار
.النّقابة أنّنا فشلنا في المهمّة

151
00:12:07,390 --> 00:12:08,300
ماذا؟

152
00:12:08,300 --> 00:12:09,830
.لا أمانع في كلّ الأحوال

153
00:12:09,830 --> 00:12:11,170
!لا تمانع؟

154
00:12:11,170 --> 00:12:13,250
!مـ-مهلاً لحظة يا سيّد لوك

155
00:12:13,250 --> 00:12:15,790
!لا أريد أن أفشل من الآن

156
00:12:15,790 --> 00:12:18,340
!لا تقلقي بشأن الإخفاقات البسيطة

157
00:12:18,340 --> 00:12:19,800
!لكنّني سأقلق

158
00:12:20,700 --> 00:12:25,050
!ماذا سأقول لبابا؟

159
00:12:22,830 --> 00:12:25,050
.لنعد إلى الموضوع

160
00:12:25,660 --> 00:12:30,430
،إذا فشلنا في هذا
.سيظهر مغامرون آخرون

161
00:12:30,430 --> 00:12:35,160
قد يكونون من النّوع
.الّذي يجبرك على كشف سرّك

162
00:12:35,710 --> 00:12:38,590
.بل قد يهاجمونك

163
00:12:38,940 --> 00:12:42,070
.حينها، لن يحصل أحد على نهاية سعيدة

164
00:12:42,690 --> 00:12:44,690
.أفضّل حقًّا تجنّب ذلك

165
00:12:46,720 --> 00:12:48,250
...حسنًا

166
00:13:13,410 --> 00:13:14,730
!إنّه شيطانيّ

167
00:13:15,870 --> 00:13:18,020
.كان ذلك وهمًا بارعًا

168
00:13:18,710 --> 00:13:21,170
.كما أخفيتَ وجودك ببراعةٍ تامّة

169
00:13:21,170 --> 00:13:24,240
!أحسنت! أثرت إعجابي بشدّة

170
00:13:24,980 --> 00:13:28,110
.شـ-شكرًا لك

171
00:13:28,110 --> 00:13:31,570
.أنا لوك، مجرّد مغامر من الرّتبة ف

172
00:13:31,570 --> 00:13:33,250
.هذه سيليس

173
00:13:35,630 --> 00:13:37,990
.أنا لوتشيرا من قبيلة الشّيطانيّين

174
00:13:38,470 --> 00:13:42,320
أليس الشّيطانيّون كائنات شرّيرة؟

175
00:13:42,320 --> 00:13:44,260
.هذا مفهوم خاطئ

176
00:13:44,260 --> 00:13:48,750
،إنّهم سحرة ومقاتلون أقوياء
.لكنّهم ليسوا محاربين

177
00:13:48,750 --> 00:13:51,480
ماذا؟ أهكذا إذًا؟

178
00:13:51,960 --> 00:13:55,760
لوتشيرا، ما الّذي تحاول حمايته؟

179
00:13:55,760 --> 00:13:58,640
.حسنًا، سأريك

180
00:14:00,400 --> 00:14:03,000
ما الّذي جعلك تثق بي؟

181
00:14:03,450 --> 00:14:07,160
.لم ينفع الوهم ضدّك يا سيّد لوك

182
00:14:07,160 --> 00:14:09,900
.لا بدّ أنّك ساحر أقوى منّي بكثير

183
00:14:10,380 --> 00:14:14,170
.ومع ذلك، لم تحاول التّحقيق في الأمر بالقوّة

184
00:14:14,420 --> 00:14:17,710
.لهذا السّبب قرّرتُ أن أثق بك

185
00:14:22,390 --> 00:14:23,670
.لقد وصلنا

186
00:14:23,670 --> 00:14:26,660
أطلال من العصور القديمة؟

187
00:14:38,010 --> 00:14:40,930
.لقد عدتُ يا غيربيرغا المُبجّل

188
00:14:54,570 --> 00:14:56,270
...هـ-هذا

189
00:14:56,270 --> 00:14:58,450
.ماذا؟ إنّه مجرّد ديك

190
00:15:00,010 --> 00:15:05,080
كيف تجرؤين على وصف الطّائر
!المقدّس غيربيرغا المُبجّل بالدّيك؟

191
00:15:05,080 --> 00:15:07,070
—لأنّ ذلك واضح، إنّه ديـ

192
00:15:07,070 --> 00:15:08,090
!توقّفي عن ذلك

193
00:15:08,090 --> 00:15:09,370
.لوتشيرا

194
00:15:09,370 --> 00:15:10,320
نعم؟

195
00:15:10,320 --> 00:15:13,470
...إنّ هذا... غـ... غير

196
00:15:13,470 --> 00:15:15,080
.غيربيرغا المبجّل

197
00:15:15,080 --> 00:15:19,480
من يكون... غيربيرغا المبجّل هذا؟

198
00:15:19,480 --> 00:15:23,730
.إنّه طائر مقّدس. ديك يملك قوى مقدّسة

199
00:15:24,460 --> 00:15:26,720
.أرأيت؟ إنّه ديك إذًا

200
00:15:27,020 --> 00:15:30,610
.مرحبًا يا سيّد ديك
أنت ديك بالفعل، صحيح؟

201
00:15:32,170 --> 00:15:35,370
.أخبرني المزيد عن تلك القوى المقدّسة

202
00:15:35,690 --> 00:15:36,920
.حاضر

203
00:15:36,920 --> 00:15:42,070
يُقال أنّ سلف غيربيرغا المُبجّل
.أيقظ العالم بصياحه

204
00:15:42,070 --> 00:15:45,310
.تُبجّل قبيلتي الطّائر المقدّس

205
00:15:46,150 --> 00:15:49,740
،رسم الصّياح الخطّ الفاصل بين اللّيل والنّهار

206
00:15:49,740 --> 00:15:52,870
.مُوضّحًا الحدود بين العوالم

207
00:15:58,390 --> 00:16:03,650
لهذا السّبب يمكنه أيضًا منع الأشياء من
.الذّهاب إلى أبعاد أخرى أو القدوم منها

208
00:16:04,390 --> 00:16:09,760
بمعنى آخر، يمكنه إغلاق مدخلِ صدعٍ بُعديّ؟

209
00:16:09,760 --> 00:16:10,390
.نعم

210
00:16:10,730 --> 00:16:12,350
.هذا صحيح

211
00:16:12,350 --> 00:16:17,310
بمجرّد أن تُفتح البوابة، ستندفع جحافل
.من الشّياطين لتكتسح هذا العالم

212
00:16:17,310 --> 00:16:23,490
!ومن البُعد الآخر، ستأتي آلهتنا المظلمة

213
00:16:24,120 --> 00:16:29,800
مفهوم. هذا يُفسّر سبب استهداف
.مصّاصي الدّماء لغيربيرغا المبجّل

214
00:16:30,970 --> 00:16:35,670
كانت قبيلتي تعيش على سلسلة
.جبال في أقصى الشّمال

215
00:16:36,190 --> 00:16:40,970
لكن في أحد الأيّام، هاجمنا
.سرب من مصّاصي الدّماء فجأة

216
00:16:45,310 --> 00:16:47,930
.كنتُ النّاجي الوحيد

217
00:16:49,010 --> 00:16:54,700
،عهد إليّ زعيمنا بغيربيرغا المبجّل
.وشققت طريقي إلى هنا

218
00:16:55,460 --> 00:16:58,410
لكن لماذا هنا تحديدًا، في هذه الأطلال؟

219
00:16:58,410 --> 00:17:00,200
،هذا معبد قديم

220
00:17:00,580 --> 00:17:04,480
وقال زعيمنا أنّه يحتوي على
.حاجز يصدّ مصّاصي الدّماء

221
00:17:06,620 --> 00:17:08,080
حاجز؟

222
00:17:08,080 --> 00:17:11,570
إذًا لم تتعرّض للهجوم منذ مجيئك إلى هنا؟

223
00:17:11,570 --> 00:17:14,200
.كلاّ، تعرّضنا للهجوم باستمرار

224
00:17:14,880 --> 00:17:17,750
لوتشيرا، لِمَ لا تأتي معنا إلى العاصمة الملكيّة؟

225
00:17:17,750 --> 00:17:18,760
ماذا؟

226
00:17:18,760 --> 00:17:21,100
.لا يوجد حاجز هنا

227
00:17:21,100 --> 00:17:22,770
!ذ-ذلك مستحيل

228
00:17:26,690 --> 00:17:28,980
!أنا سأحمي غيربيرغا المُبجّل

229
00:17:29,990 --> 00:17:34,990
سيف ملك الشّياطين معي هنا
.لسبب واحد فقط

230
00:17:35,460 --> 00:17:37,740
!وهو أنّني هزمت ملك الشّياطين

231
00:17:38,020 --> 00:17:42,430
!هـ-هل أنت... القدّيس لاك، الحكيم العظيم؟

232
00:17:43,800 --> 00:17:45,960
عدتَ من مغامراتك سالمًا؟

233
00:17:45,960 --> 00:17:47,500
!لمعان

234
00:17:46,260 --> 00:17:47,190
.نعم

235
00:17:50,510 --> 00:17:56,260
أقسم باسمي أنّني سأحمي الطّائر
.المقدّس غيربيرغا المبجّل بحياتي

236
00:17:59,020 --> 00:18:03,530
.إنّه يملك القوّة الوحيدة الّتي ستنقذ العالم

237
00:18:04,040 --> 00:18:06,200
.أبليتَ حسنًا بحمايته حتّى الآن

238
00:18:06,780 --> 00:18:13,420
،نيابةً عن سكّان هذا العالم
.أشكرك أنت وقبيلتك

239
00:18:14,340 --> 00:18:20,120
...حسنًا... أنا فقط

240
00:18:20,120 --> 00:18:23,540
.فعلتُ كلّ هذا من أجل أبناء قبيلتي

241
00:18:24,160 --> 00:18:30,960
يا رفاق... الطّائر المقدّس الّذي
حميناه جميعًا... سينقذ العالم؟

242
00:18:32,200 --> 00:18:37,480
...لقد شكرني
...القدّيس العظيم لاك للتّوّ

243
00:18:38,610 --> 00:18:42,840
!لا شيء... يُمكن أن يجعلني أكثر فخرًا

244
00:18:48,730 --> 00:18:53,240
،لكن يا سيّد لوك
.أنت مجرّد مُتطفّل في منزلنا

245
00:18:53,240 --> 00:18:55,890
أتظنّ أنّ بابا سيسمح لك
بالاحتفاظ بحيوان أليف؟

246
00:18:55,890 --> 00:18:58,780
!غيربيرغا المبجّل ليس حيوانًا أليفًا

247
00:19:14,340 --> 00:19:15,830
!إنّهم ثلاثة؟

248
00:19:15,830 --> 00:19:18,340
!من تكون يا هذا؟

249
00:19:18,650 --> 00:19:21,590
.لن أبوح باسمي لمصّاص دماء دنيء مثلك

250
00:19:22,580 --> 00:19:25,590
!أتسخر منّي؟

251
00:19:25,590 --> 00:19:26,710
!تعزيز؟

252
00:19:26,710 --> 00:19:30,350
.من الواضح أنّهم يطاردون لوتشيرا

253
00:19:30,620 --> 00:19:32,680
.وهذا يعني أنّهم يريدون الطّائر المقدّس

254
00:19:33,090 --> 00:19:36,840
في هذه الحالة، لا يمكننا
.السّماح لأيّ منهم بالهروب

255
00:19:37,360 --> 00:19:38,650
!السّهم السّحريّ

256
00:19:42,640 --> 00:19:43,860
!الجحيم الآسر

257
00:20:04,920 --> 00:20:09,800
أظنّ... أنّ الطّائر المقدّس
.لن يسمح بالهروب

258
00:20:14,270 --> 00:20:16,100
!ماذا؟ ماذا؟

259
00:20:16,660 --> 00:20:18,160
ماذا حدث؟

260
00:20:18,160 --> 00:20:20,910
هل كانت تلك قوّة الطّائر المقدّس؟

261
00:20:20,910 --> 00:20:26,410
،نعم. عندما تحوّل مصّاص الدّماء
.رسم حدودًا بالقوّة

262
00:20:26,410 --> 00:20:28,790
،أمام قوّة الطّائر المقدّس

263
00:20:28,790 --> 00:20:31,740
لا يُسمح لأيّ شيء بالبقاء
.في مرحلة منتصف التّحوّل

264
00:20:32,340 --> 00:20:34,300
.لهذا السّبب تحوّل إلى رماد

265
00:20:34,300 --> 00:20:39,410
،إذا كان يمتلك هذه القوى الخارقة
فهل من داعٍ للهرب من مصّاصي الدّماء؟

266
00:20:39,410 --> 00:20:43,800
.إنّ مثل هذه القوّة لا تعمل إلاّ عند تحوّلهم

267
00:20:43,800 --> 00:20:45,390
.هذا منطقيّ

268
00:20:45,390 --> 00:20:48,730
.أكبر مشكلة مع مصّاصي الدّماء هي هروبهم

269
00:20:48,730 --> 00:20:50,680
.صحيح، معك حقّ

270
00:20:50,680 --> 00:20:52,190
.أنت رائع يا سيّد ديك

271
00:20:52,190 --> 00:20:53,510
!إنّه غيربيرغا المبجّل

272
00:20:53,510 --> 00:20:55,190
.هيّا بنا نذهب

273
00:21:06,940 --> 00:21:08,100
!سيا

274
00:21:08,690 --> 00:21:11,890
!سيّد لوك! كنتُ أنتظرك

275
00:21:11,890 --> 00:21:13,950
هل عدتِ من قريتك بهذه السّرعة؟

276
00:21:13,950 --> 00:21:16,460
!نعم! كلّ شيء على ما يرام

277
00:21:16,850 --> 00:21:18,060
من هذه؟

278
00:21:18,060 --> 00:21:21,950
سيا، مغامِرة من الرّتبة ب
.وصائدة مصّاصي دماء

279
00:21:21,950 --> 00:21:23,720
.تشرّفت بلقائك

280
00:21:24,570 --> 00:21:27,910
!أنا سيليس، تلميذة السّيّد لوك

281
00:21:27,910 --> 00:21:30,700
عجبًا! تلميذة؟

282
00:21:31,720 --> 00:21:34,360
.في الحقيقة، لديّ أمر عاجل لأخبرك به

283
00:21:35,470 --> 00:21:38,310
.حسنًا. أخبريني في الدّاخل

284
00:21:40,480 --> 00:21:42,730
أخبريني، ما الّذي حدث؟

285
00:21:43,120 --> 00:21:47,550
.يبدو أنّ مصّاصي الدّماء يُخطّطون لشيءٍ كبير

286
00:21:47,550 --> 00:21:48,500
.هكذا إذًا

287
00:21:48,500 --> 00:21:53,370
ويبدو أنّ هناك زعيمًا ساميًا
.لمصّاصي الدّماء يقودهم

288
00:21:53,370 --> 00:21:54,310
ماذا؟

289
00:21:55,170 --> 00:22:01,100
ملكُ ملوكٍ يتحكّم في زعماء مصّاصي
!الدّماء. زعيم مصّاصي دماء سامٍ