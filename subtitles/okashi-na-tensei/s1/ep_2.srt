1
00:00:14,010 --> 00:00:16,320
أهذا كلّ ما لديهم له أيّ قيمة؟

2
00:00:16,320 --> 00:00:18,910
.نعم، ليس بالكثير

3
00:00:18,910 --> 00:00:20,980
.لا يملكون طعامًا كافيًا لنا جميعًا

4
00:00:22,850 --> 00:00:25,770
.أعتقد أنّنا سنذهب لنرى ما الّذي لدى مورتلن لننهبه

5
00:00:34,510 --> 00:00:36,790
!احرصوا على غرس تلك الأوتاد جيّدًا وعميقًا

6
00:00:36,790 --> 00:00:37,440
!حاضر

7
00:00:37,440 --> 00:00:38,470
.أيّها القائد

8
00:00:39,020 --> 00:00:40,900
.يبدو أنّ لديك أخبارًا سيّئة

9
00:00:41,690 --> 00:00:47,190
تعرّضت قرية في إقطاعيّة الفارس
.ليبتافر لهجوم قطّاع الطّرق ودمّروها

10
00:00:48,150 --> 00:00:50,890
.مرّت ثلاثة أيّام فحسب منذ عودتنا من العاصمة

11
00:00:50,890 --> 00:00:52,490
وقد وصلوا إلى ليبتافر بهذه السّرعة؟

12
00:00:52,890 --> 00:00:56,110
هذا يعني أنّهم سيصلون قبل
.الشّهرين اللّذين توقّعناهما

13
00:00:56,110 --> 00:00:58,190
.أنت محقّ تمامًا

14
00:00:58,580 --> 00:01:00,580
.بيس. بلّغ هذه الرّسالة

15
00:01:01,080 --> 00:01:03,840
.نحتاج لقائد كلّ قرية هنا في أقرب وقت

16
00:01:03,840 --> 00:01:04,800
!حاضر

17
00:01:04,800 --> 00:01:08,210
.أخبر كوانترو وغلاساج أن يحضرا في الحال

18
00:01:08,520 --> 00:01:09,650
!مفهوم

19
00:01:10,050 --> 00:01:12,490
.سيصل قطّاع الطّرق أقرب ممّا توقّعنا

20
00:01:12,980 --> 00:01:15,240
!عليّ إيقافهم

21
00:01:15,710 --> 00:01:18,330
.حلمي بإنشاء بلاد للحلويّات

22
00:01:18,330 --> 00:01:20,550
!لن أسمح لقطّاع الطّرق بتدمير ذلك

23
00:01:23,270 --> 00:01:28,270
،هذه قصّة حلوانيّ عبقريّ مات قبل أوانه

24
00:01:28,270 --> 00:01:32,520
وولد من جديد كابن لنبيل فقيل في عالم آخر

25
00:01:32,520 --> 00:01:35,730
.للسّعي خلف عالم مليء بالحلويّات والابتسامات

26
00:01:36,550 --> 00:01:41,310
.إنّها قصّة باردة وقاسية وحلوة في نفس الوقت

27
00:01:42,670 --> 00:01:49,140
!حلمه هو إنشاء بلاد حلويّات خاصّة بهذا العالم

28
00:03:23,430 --> 00:03:25,930
.قيّم أبي الوضع وبدأ التّحرّك في الحال

29
00:03:26,490 --> 00:03:29,330
.لقد قام بإغلاق القريتين الصّغيرتين بشكل مؤقّت

30
00:03:29,660 --> 00:03:33,310
.كما أمر بملء آبارهم وتجريد حقولهم ومنازلهم

31
00:03:34,380 --> 00:03:37,080
.انتقل سكّان القريتين إلى القرية الرّئيسيّة

32
00:03:37,080 --> 00:03:39,110
.وسنستدرج قطّاع الطّرق إلى هناك

33
00:03:39,580 --> 00:03:41,970
.كان الهدف تفادي قتال متفرّق

34
00:03:42,450 --> 00:03:43,910
!أيّها القائد

35
00:03:44,870 --> 00:03:47,620
.جمعت أكبر عدد من الرّجال قدر الإمكان

36
00:03:48,200 --> 00:03:50,600
إلى متى سنصمد في رأيك؟

37
00:03:50,600 --> 00:03:52,190
.لثلاثة أيّام

38
00:03:52,190 --> 00:03:54,360
،لكن إن خصّصنا لأنفسنا وجبة واحدة في اليوم

39
00:03:54,360 --> 00:03:56,750
.فبإمكاننا الاستمرار لسبعة أيّام

40
00:04:01,700 --> 00:04:03,540
.قوّاتنا قليلة

41
00:04:04,650 --> 00:04:09,600
،إلى جانب أبي وعمّاله شيتس وكوانترو وغلاساج

42
00:04:09,600 --> 00:04:11,060
.فجميعهم مجنّدون من الفلاّحين

43
00:04:11,560 --> 00:04:14,470
.سيغمرنا العدو في نهاية المطاف إن طال القتال

44
00:04:14,470 --> 00:04:17,520
.ولا بدّ أنّ أبي وشيتس يعرفان ذلك

45
00:04:18,260 --> 00:04:20,180
.نحتاج لخطّة

46
00:04:20,180 --> 00:04:21,990
!سيّدي بيس

47
00:04:21,990 --> 00:04:23,700
!مارك! لومي

48
00:04:23,700 --> 00:04:25,200
!سنساعد أيضًا

49
00:04:25,200 --> 00:04:28,580
!نحن مُلازماك قبل كلّ شيء

50
00:04:28,580 --> 00:04:29,910
مُلازماي؟

51
00:04:29,910 --> 00:04:33,690
والدانا من عمّال حاكم هذه الإقطاعيّة، صحيح؟

52
00:04:33,690 --> 00:04:39,420
ما يجعلنا عاملان للحاكم الإقطاعيّ
!التّالي، ألا وهو أنت

53
00:04:40,710 --> 00:04:43,610
معاملتي كنبيل من صديقَيْ طفولتي
.يجعل بدني يقشعرّ

54
00:04:43,610 --> 00:04:45,880
.أتمنّى لو تكفّا عن ذلك

55
00:04:47,850 --> 00:04:51,780
في العادة، لكنتُ ألعب معهما الآن
—في مثل هذا الوقت ومع بقيّة

56
00:04:52,910 --> 00:04:54,550
بيس؟ ما الأمر؟

57
00:04:54,550 --> 00:04:57,220
.هناك ما أودّ طلبه منكما

58
00:04:57,220 --> 00:04:59,570
!أكيد، جاهزان لأيّ شيء

59
00:04:59,570 --> 00:05:01,560
هل يمكنكما جمع صخور؟

60
00:05:01,560 --> 00:05:02,320
صخور؟

61
00:05:02,320 --> 00:05:06,940
.نعم. لا شيء مميّز، فقط حجارة مناسبة للرّمي

62
00:05:06,940 --> 00:05:07,780
!مفهوم

63
00:05:08,280 --> 00:05:11,660
إنّ قطّاع الطّرق عند حدود الإقطاعيّة سلفًا، صحيح؟

64
00:05:12,050 --> 00:05:15,540
،إن سمعتما أيّ ضجّة بعيدة أو أيّ شيء خارج المعتاد

65
00:05:15,540 --> 00:05:18,500
.احتميا خلف الأسوار قبل التّحرّي أكثر عن الأمر

66
00:05:18,500 --> 00:05:20,350
!علم يا سيّدي بيس

67
00:05:20,350 --> 00:05:22,770
!أخبرتكما ألاّ تعاملاني كنبيل

68
00:05:29,290 --> 00:05:30,720
!ظهري يؤلمني

69
00:05:31,180 --> 00:05:32,890
!تبدو مثل رجل عجوز

70
00:05:32,890 --> 00:05:34,330
ماذا تقصدين بذلك؟

71
00:05:34,330 --> 00:05:37,190
...درنا حول القرية عشر مرّات حتّى الآن

72
00:05:37,190 --> 00:05:40,900
بالمناسبة، أيّ نوع من السّحر حصل عليه بيس؟

73
00:05:40,900 --> 00:05:42,230
.لا أدري

74
00:05:42,230 --> 00:05:44,870
.قال أنّه ما زال يتدرّب ولم يخبرني ما هو

75
00:05:44,870 --> 00:05:47,120
.لكن ما زال ذلك رائعًا

76
00:05:47,120 --> 00:05:49,230
.لقد تجاوزَنا أكثر وأكثر الآن

77
00:05:49,230 --> 00:05:51,120
ماذا تقصدين بأكثر وأكثر؟

78
00:05:51,120 --> 00:05:54,340
!ما زلت أفضل منه بكثير في العراك

79
00:05:54,340 --> 00:05:55,390
.نعم، نعم

80
00:05:55,390 --> 00:05:58,310
—راقبيني فحسب! سأوسع قطّاع الطّرق أولـ

81
00:05:59,910 --> 00:06:02,110
مهلاً، هل سمعت شيئًا ما؟

82
00:06:02,110 --> 00:06:02,940
ماذا؟

83
00:06:02,940 --> 00:06:06,130
.مستحيل. لا بدّ أنّ أذناك فيهما عيب ما

84
00:06:15,250 --> 00:06:16,470
...كلاّ

85
00:06:23,720 --> 00:06:25,320
!لقد وصلوا

86
00:06:25,320 --> 00:06:26,810
!قطّاع الطّرق

87
00:06:26,810 --> 00:06:28,280
!قطّاع الطّرق هنا

88
00:06:28,670 --> 00:06:29,890
!أغلقوا البوّابة

89
00:06:29,890 --> 00:06:31,570
!اسحبوا الجسر

90
00:06:31,570 --> 00:06:33,550
!لا تسمحوا لقطّاع الطّرق بالدّخول

91
00:06:33,550 --> 00:06:34,700
!أبي

92
00:06:35,080 --> 00:06:37,750
.ابقيا مع السّيّد بيس

93
00:06:37,750 --> 00:06:38,660
!نعم

94
00:06:41,160 --> 00:06:44,500
!أمّي، خذي الصّغار وادخلوا في الحال

95
00:06:44,500 --> 00:06:47,730
هـ-هل وصل قطّاع الطّرق بالفعل؟

96
00:06:47,730 --> 00:06:50,080
أتظنّ فعلاً أنّنا سنكون كافين لإيقافهم؟

97
00:06:50,820 --> 00:06:52,900
!اثبتوا جميعًا

98
00:06:54,740 --> 00:06:56,090
!إنّه الحاكم الإقطاعيّ

99
00:06:57,680 --> 00:06:59,310
!اسمعوا جيّدًا

100
00:06:59,690 --> 00:07:01,260
،إن نجح قطّاع الطّرق باختراقنا

101
00:07:01,260 --> 00:07:05,770
!فسيقتلوننا ويسرقون طعامنا ويحرقون منازلنا

102
00:07:05,770 --> 00:07:08,180
!أرفض السّماح بحدوث ذلك

103
00:07:08,180 --> 00:07:10,490
!أطلب تفانٍ مماثل لذلك منكم

104
00:07:10,830 --> 00:07:13,030
إنّ كلّ من يتشارك هذه الرّغبة
في حماية عائلاتنا

105
00:07:13,030 --> 00:07:16,600
!الاتّحاد معًا لطرد قطّاع الطّرق من هنا

106
00:07:17,200 --> 00:07:20,300
.لا يوجد رجل واحد هنا فيه ذرّة جبن

107
00:07:20,300 --> 00:07:21,920
!أطلب منكم مشاركتي هذا الإيمان

108
00:07:22,330 --> 00:07:24,500
!هل أنتم جاهزون لهذا؟

109
00:07:26,750 --> 00:07:28,390
!هذا هو أبي

110
00:07:28,800 --> 00:07:31,580
!كان القرويّون متردّدون، لكنّه ملأهم بالشّجاعة

111
00:07:34,930 --> 00:07:36,980
.سيحلّ الظّلام قريبًا

112
00:07:36,980 --> 00:07:38,940
!وسيضرنا قطّاع الطّرق حينها

113
00:07:38,940 --> 00:07:40,350
!أروني روحكم القتاليّة

114
00:07:42,310 --> 00:07:44,140
.كوانترو، اقصد القناة الغربيّة

115
00:07:44,140 --> 00:07:44,910
!حاضر

116
00:07:45,190 --> 00:07:48,020
.وستقصد أنت المنطقة شرق المركز يا غلاساج

117
00:07:48,020 --> 00:07:48,980
.دع الأمر لي

118
00:07:48,980 --> 00:07:50,480
!اتبعوني جميعًا

119
00:07:51,610 --> 00:07:52,450
.أيّها القائد

120
00:07:52,800 --> 00:07:55,430
.لا يعرف قطّاع الطّرق المنطقة كما نعرفها

121
00:07:55,430 --> 00:07:57,380
.ستكون لدينا الأفضليّة في الظّلام

122
00:07:57,810 --> 00:08:01,800
ألا تظنّ أنّهم سينتظرون حتّى الفجر للهجوم؟

123
00:08:02,540 --> 00:08:07,050
لا، أفترض أنّهم لا يملكون
.ما يكفي من الطّعام والمؤن

124
00:08:07,050 --> 00:08:12,770
لا بدّ أنّ صقيع السّنة الماضية أدرّ
.بمحاصيل قليلة للإقطاعيّات المجاورة

125
00:08:13,200 --> 00:08:15,710
.سيودّون الهجوم في أقرب وقت ممكن

126
00:08:15,710 --> 00:08:18,720
.سيهاجمون ليلاً حتّى إن لم يكن ذلك لصالحهم

127
00:08:18,720 --> 00:08:20,750
،ولكن إن لم يهاجموا

128
00:08:20,750 --> 00:08:24,770
!سيتعب الرّجال إن بقوا مستيقظين طوال اللّيل

129
00:08:24,770 --> 00:08:26,190
ما رأيك يا بيس؟

130
00:08:27,270 --> 00:08:29,110
.إنّنا نجهل الكثير

131
00:08:29,110 --> 00:08:34,660
أعتقد أنّ علينا معرفة ما لدى
.العدوّ من مؤن وقوّات بالتّفاصيل

132
00:08:36,200 --> 00:08:37,870
.ينطبق نفس الأمر على صناعة الحلويّات

133
00:08:37,870 --> 00:08:40,500
قبل البدء بالعمل، علينا معرفة ما نحتاجه بالضّبط

134
00:08:40,500 --> 00:08:44,540
.من ناحية المكوّنات والوقت ودرجة الحرارة وكلّ شيء

135
00:08:45,010 --> 00:08:47,990
في بداياتي، عندما كنت أعدّ
—أوّل كعكة شكولاطة

136
00:08:48,620 --> 00:08:51,130
!لا، لا! لديك أمورًا أهمّ للتّركيز عليها

137
00:08:51,130 --> 00:08:51,990
.حسنًا

138
00:08:52,760 --> 00:08:54,350
إلى أين ستذهب يا أبي؟

139
00:08:54,350 --> 00:08:56,360
.استطلاع عدائيّ

140
00:08:56,360 --> 00:08:58,360
.ستأتي معي يا شيتس

141
00:08:58,360 --> 00:09:01,320
.ما زال الوقت باكرًا على الكرّ والفرّ

142
00:09:01,320 --> 00:09:05,020
.يا إلهي. كم يحبّ قائدنا إساءة استعمال رجاله

143
00:09:05,020 --> 00:09:08,380
.بيس، أنت المسؤول في غيابي

144
00:09:08,380 --> 00:09:09,480
!حاضر

145
00:09:11,690 --> 00:09:14,030
،سنضرب قطّاع الطّرق بقوّة وننسحب

146
00:09:14,030 --> 00:09:18,370
.وسنأخذ طريق عودة طويلاً عبر المدخل الشّماليّ

147
00:09:18,840 --> 00:09:20,030
!كونا حذرين

148
00:09:20,610 --> 00:09:24,660
.عليّ فعل ما أستطيعه وحدي قبل عودتهما

149
00:09:26,380 --> 00:09:27,530
.مارك

150
00:09:27,530 --> 00:09:31,060
.أبلغ رسالة لكوانترو في القناة الغربيّة

151
00:09:31,060 --> 00:09:33,800
.سنستعمل سهامًا ملتهبة للإشارة على وصول العدوّ

152
00:09:34,240 --> 00:09:38,010
واذهبي أنت يا لومي لإخبار غلاساج
.بتجهيز الأسهم الملتهبة

153
00:09:38,990 --> 00:09:40,910
،أخبريه أنّه بعد رؤية أبي وشيتس

154
00:09:40,910 --> 00:09:44,470
،وبعد سماعه لأخفت صوت للحوافر ثانية

155
00:09:44,470 --> 00:09:47,130
.أن يطلق السّهام الملتهبة في اتّجاه الصّوت

156
00:09:48,280 --> 00:09:49,520
أواثق من ذلك؟

157
00:09:49,520 --> 00:09:52,400
.قد تصيب السّهام الحاكم أيضًا

158
00:09:52,400 --> 00:09:56,780
أتظنّان أنّ أبي سيسمح لسهم طائش
أُطلق من تلك المسافة أن يصيبه؟

159
00:09:57,670 --> 00:09:59,410
!يصعب حتّى تخيّل ذلك

160
00:10:00,050 --> 00:10:02,370
...لقد أراني شيئًا لم أره من قبل

161
00:10:04,750 --> 00:10:06,790
!تفادى صخرة ساقطة

162
00:10:06,790 --> 00:10:10,360
.صحيح! ثمّ وبّخنا كثيرًا على ذلك

163
00:10:10,360 --> 00:10:12,970
!ووبّخ والدكِ على ذلك أيضًا

164
00:10:14,940 --> 00:10:17,000
،رغم أنّ أبي وشيتس يعرفان المنطقة جيّدًا

165
00:10:17,000 --> 00:10:21,400
فإنّ مطاردة قطّاع طرق
.قد تشوّه حسّهما بالاتّجاهات

166
00:10:21,400 --> 00:10:23,720
.ستساعدهما السّهام الملتهبة للعودة

167
00:10:24,100 --> 00:10:26,660
لماذا لا يستطيع الانتقال آنيًّا بسحره؟

168
00:10:26,660 --> 00:10:29,560
إنّ تعويذة الانتقال الآنيّ يمكنها
.نقل وزن محدّد فحسب

169
00:10:29,560 --> 00:10:33,190
سيكون من الصّعب عليه استعمالها
.على نفسه وشيتس وحصانيهما

170
00:10:33,190 --> 00:10:35,810
!فعلاً؟ مفهوم

171
00:10:35,810 --> 00:10:37,400
!والآن، إلى مهمّتيكما

172
00:10:37,400 --> 00:10:38,300
!حالاً

173
00:10:40,810 --> 00:10:42,230
!أنا خائفة

174
00:10:43,220 --> 00:10:45,340
ماذا سيحدث للقرية؟

175
00:10:45,340 --> 00:10:47,620
.سنكون بخير. سنكون بخير جميعًا

176
00:10:48,040 --> 00:10:53,000
.والدي ووالداكما سيبقياننا آمنين

177
00:10:53,000 --> 00:10:54,450
.هذا صحيح

178
00:10:54,450 --> 00:10:56,920
.هيّا يا جوزي. ادخلن أنتنّ أيضًا

179
00:10:57,580 --> 00:10:58,620
.هيّا بنا

180
00:10:59,180 --> 00:11:00,160
.بيس

181
00:11:02,640 --> 00:11:03,850
.كن حذرًا

182
00:11:03,850 --> 00:11:04,670
!حاضر

183
00:11:05,610 --> 00:11:09,020
ظننتُ أنّ الحلويّات هي الشّيء الوحيد
.الّذي سيكون عليّ التّفكير به

184
00:11:09,640 --> 00:11:13,460
ولكن في هذا العالم، الطّريقة الوحيدة
.لتحقيق حلمي هي بحماية هذه الإقطاعيّة

185
00:11:13,460 --> 00:11:15,730
!وسأحقّق ذلك بكلّ تأكيد

186
00:11:16,230 --> 00:11:19,040
بحماية هؤلاء النّاس ورسم الابتسامة
—على وجوههم

187
00:11:19,040 --> 00:11:20,200
.ذاك ما يعنيه حلمي

188
00:11:20,950 --> 00:11:22,990
!ذلك ما تعنيه بلاد من الحلويّات

189
00:11:26,710 --> 00:11:30,070
،يريد أبي إنهاء المعركة اللّيلة

190
00:11:30,070 --> 00:11:32,700
.حتّى إن كان عليه أن يكون الطّعم

191
00:11:34,270 --> 00:11:36,820
.أنت المسؤول في غيابي

192
00:11:40,260 --> 00:11:42,690
!استعدّوا لمواجهة قطّاع الطّرق

193
00:11:44,670 --> 00:11:47,620
!اجمعوا كلّ الصّبية هنا

194
00:12:10,390 --> 00:12:12,790
.أيّها القائد، لدينا أخبار سيّئة

195
00:12:13,830 --> 00:12:18,000
.قطّاع الطّرق جنود سابقون في سلاح الفرسان

196
00:12:18,650 --> 00:12:22,430
.لديهم خمسة أحصنة قويّة وفي حالة جيّدة

197
00:12:22,430 --> 00:12:25,180
.ويبدو أنّهم يعرفون كيف يمتطونها

198
00:12:25,180 --> 00:12:26,990
كم عدد قطّاع الطّرق؟

199
00:12:27,340 --> 00:12:30,690
.خمسون؟ ستّـ— بل سبعون

200
00:12:30,690 --> 00:12:34,590
.أشكّ أنّهم صاروا قطّاع طرق بدافع الجوع

201
00:12:35,360 --> 00:12:39,220
.لا بدّ أنّهم مجموعة من المحترفين

202
00:12:39,220 --> 00:12:40,400
...وأيضًا

203
00:12:40,810 --> 00:12:43,750
.أرى بعض الأسرى القرويّين معهم

204
00:12:43,750 --> 00:12:47,120
.على الأرجح أنّهم يستعملونهم كعبيد

205
00:12:47,660 --> 00:12:51,790
!لن أسمح لهم أبدًا بفعل ذلك بعائلاتنا وزملائنا

206
00:12:51,790 --> 00:12:53,760
.لا تتهاون يا شيتس

207
00:12:53,760 --> 00:12:55,500
مع من تتكلّم في رأيك؟

208
00:12:55,500 --> 00:12:56,590
.أنا قلق أكثر عليك

209
00:12:56,590 --> 00:13:00,090
!اركض بسرعة كي لا تصيبك الأسهم أيّها القائد

210
00:13:06,510 --> 00:13:10,390
.يا زعيم، لا يبدو أنّ هنالك أحدًا في القرى المجاورة

211
00:13:10,390 --> 00:13:12,560
.ملؤوا كلّ الآبار بالتّراب ولا يمكننا استعمالها

212
00:13:13,150 --> 00:13:15,340
.توقّعت ذلك

213
00:13:15,760 --> 00:13:19,580
لقد أغلقوا القرى الأخرى لتركيز
.قوّاتهم في مكان واحد

214
00:13:20,280 --> 00:13:22,030
...حسنًا

215
00:13:22,380 --> 00:13:24,270
.غربت الشّمس بالكامل

216
00:13:24,270 --> 00:13:25,410
.لننطلق

217
00:13:25,410 --> 00:13:26,280
!حالاً

218
00:13:38,990 --> 00:13:41,050
جنود من مورتلن؟

219
00:13:47,070 --> 00:13:50,730
إنّهما لا يركّزان على القتل بل
.مرّا من خلالنا فحسب

220
00:13:51,550 --> 00:13:54,770
...يا لها من تقنيّات فرسان مذهلة

221
00:13:55,330 --> 00:13:57,500
!لا بدّ أنّهما محترفان

222
00:13:57,500 --> 00:14:00,060
!سيمرّان خلالنا ثانية! كونوا جاهزين

223
00:14:04,120 --> 00:14:06,700
!أغبياء! لا تعترضوا حصانيهما

224
00:14:07,080 --> 00:14:08,760
!سيدوسانكم حتّى الموت

225
00:14:09,350 --> 00:14:11,830
.إنّ أوامره ذكيّة

226
00:14:12,850 --> 00:14:15,330
.لن ينجح هجوم الفرسان التّالي

227
00:14:17,080 --> 00:14:18,730
!انتهى دورنا هنا أيّها القائد

228
00:14:18,730 --> 00:14:20,720
!هناك الكثير منهم

229
00:14:20,720 --> 00:14:24,140
!حسنًا، لنعد أدراجنا ونعزّز دفاعنا

230
00:14:25,050 --> 00:14:26,530
!لا تسمحوا لهما بالهرب

231
00:14:26,530 --> 00:14:28,680
!اتبعوهما! لا تدعوهما يعودان للقرية

232
00:14:28,680 --> 00:14:30,410
!إنّهما فارسان فحسب

233
00:14:28,680 --> 00:14:30,410
!مهلاً، اللّعنة

234
00:14:30,410 --> 00:14:32,680
!سنمسك بهما ونسلبهما كلّ شيء

235
00:14:33,690 --> 00:14:34,890
!أغبياء

236
00:14:36,260 --> 00:14:38,300
.يبدو أنّهم التقطوا الطّعم

237
00:14:38,690 --> 00:14:40,350
!لنعد بأمان

238
00:14:45,900 --> 00:14:48,030
سـ-سيّدي غلاساج؟

239
00:14:54,480 --> 00:14:55,310
!أطلقوا الأسهم

240
00:14:55,310 --> 00:14:56,700
!حا-حاضر

241
00:15:09,510 --> 00:15:10,880
...سيّدي

242
00:15:14,330 --> 00:15:15,210
!الإشارة

243
00:15:15,210 --> 00:15:17,720
!لقد وصلوا! وصل قطّاع الطّرق

244
00:15:21,840 --> 00:15:24,190
!سهم ناريّ! إنّه صادر من القرية

245
00:15:24,190 --> 00:15:25,710
.إنّه بيس

246
00:15:25,710 --> 00:15:28,720
،يريد القيام بذلك لإرشادنا

247
00:15:28,720 --> 00:15:32,610
...لكن إن كان لا يمانع إخبارهم بمكان القرية

248
00:15:33,070 --> 00:15:34,820
!فلا بدّ أنّه جهّز فخًّا

249
00:15:36,360 --> 00:15:39,110
.كانوا ليدمّروا الحقول لو كنّا في الجانب الشّرقيّ

250
00:15:39,110 --> 00:15:40,990
.علينا الذّهاب غربًا

251
00:15:40,990 --> 00:15:43,840
!لا أدري ما الّذي يخطّط له، ولكن هيّا بنا

252
00:15:45,960 --> 00:15:48,100
!سيّدي بيس! أمر طارئ

253
00:15:49,530 --> 00:15:52,970
!قطّاع الطّرق يطاردون الحاكم وشيتس-ساما

254
00:15:52,970 --> 00:15:53,840
والأسهم الملتهبة؟

255
00:15:53,840 --> 00:15:55,700
.أطلقنا اثنين سلفًا

256
00:15:55,700 --> 00:15:58,280
!إنّهما يتّجهان غربًا

257
00:16:00,910 --> 00:16:02,210
!استعدّوا للقتال

258
00:16:11,110 --> 00:16:13,310
!سنقتلهم جميعًا

259
00:16:14,320 --> 00:16:15,490
!حان وقت تغيير مسارنا

260
00:16:26,840 --> 00:16:28,710
!أطلقوا

261
00:16:30,390 --> 00:16:31,260
...ما الّذي

262
00:16:37,440 --> 00:16:38,670
!سُحقًا

263
00:16:38,670 --> 00:16:39,720
!عرفتُ أنّه كان فخًّا

264
00:16:40,460 --> 00:16:41,340
!الموجة التّالية

265
00:16:44,250 --> 00:16:45,580
!أطلقوا

266
00:16:50,610 --> 00:16:52,420
!أطلقوا

267
00:16:54,200 --> 00:16:57,570
لم أفكّر أبدًا أنّ اللّهب بالمقالع
!سيكون مفيدًا هكذا

268
00:16:59,230 --> 00:17:03,170
،بمجرّد أن يباغت أبي وشيتس قطّاع الطّرق ويعودان

269
00:17:03,680 --> 00:17:06,040
.فسيريدان تفادي الحقول عن طريق سلك الطّريق الغربيّ

270
00:17:06,380 --> 00:17:10,750
على الأرجح أنّ قطّاع الطّرق
.سيطاردونهما على شكل صفّ مباشر

271
00:17:11,300 --> 00:17:14,260
.سيكون جانب ذلك الصّفّ هو نقطة ضعفهم

272
00:17:14,580 --> 00:17:16,720
!لذلك سنضرب ضربتنا هناك

273
00:17:16,720 --> 00:17:19,540
و-وسنطلب من الأطفال فعل ذلك؟

274
00:17:19,540 --> 00:17:21,290
!ما الّذي تقوله؟

275
00:17:21,290 --> 00:17:24,180
.بإمكاننا استعمال المقالع أفضل منكم بكثير

276
00:17:25,640 --> 00:17:27,730
.إنّنا نلعب بها كلّ يوم

277
00:17:27,730 --> 00:17:29,170
!نعم! نعم

278
00:17:29,170 --> 00:17:31,650
!يمكننا أن نكون مفيدين أيضًا

279
00:17:31,650 --> 00:17:33,400
.لا تغترّ كثيرًا بنفسك يا فتى

280
00:17:34,000 --> 00:17:35,860
.ما زال هذا مجرّد كمين

281
00:17:36,470 --> 00:17:37,650
...ولكن

282
00:17:37,650 --> 00:17:41,060
إن استطعنا تشتيت تشكيلتهم
،وزرع الفوضى في صفوفهم

283
00:17:41,060 --> 00:17:44,730
.فسيسمح ذلك لأبي وشيتس بالتّحرّك بحرّيّة أكثر

284
00:17:47,810 --> 00:17:50,170
،إن قاتل الأطفال معنا

285
00:17:50,170 --> 00:17:52,730
.يمكننا التّعويض عن نقص أعدادنا

286
00:17:54,010 --> 00:17:56,010
،بمجرّد تجاوز العدوّ للقناة

287
00:17:56,010 --> 00:17:58,080
،فسيتراجع الأطفال

288
00:17:58,080 --> 00:18:00,260
.وسيقابلهم القرويّون المسلّحون

289
00:18:01,360 --> 00:18:02,950
.مفهوم

290
00:18:02,950 --> 00:18:06,860
.أخبرنا الحاكم بحماية القرية معًا

291
00:18:06,860 --> 00:18:09,540
!لنقم بتنفيذ خطّة السّيّد بيس

292
00:18:09,540 --> 00:18:10,730
!أجل

293
00:18:11,100 --> 00:18:14,690
!حسنًا! لنرِ أولئك العجائز ما نحن قادرون عليه

294
00:18:15,340 --> 00:18:16,480
...لومي

295
00:18:17,040 --> 00:18:18,970
.أنت فتاة قبل كلّ شيء

296
00:18:18,970 --> 00:18:21,350
.أفضّل لو تتراجعين هذه المرّة

297
00:18:21,350 --> 00:18:23,400
ماذا تقصد؟

298
00:18:23,400 --> 00:18:25,260
أنا استثناء، صحيح؟

299
00:18:25,260 --> 00:18:28,080
لا يمكنك إخبار أحد عمّال الحاكم
.التّالي أنّها لا تستطيع المشاركة

300
00:18:28,080 --> 00:18:31,360
.أظنّ ذلك... شكرًا لك

301
00:18:31,360 --> 00:18:33,320
.لستُ واثقًا أنّي أستطيع

302
00:18:38,030 --> 00:18:39,320
...سيّدي بيس

303
00:18:39,320 --> 00:18:41,250
.لا بأس. يمكنكما ذلك

304
00:18:41,580 --> 00:18:44,090
.اعتبرا نفسيكما وكأنّكما تلعبان كالعادة

305
00:18:44,960 --> 00:18:45,970
!حاضر

306
00:18:46,670 --> 00:18:50,040
!لن أسمح بتعرّض الأطفال للأذى

307
00:18:50,040 --> 00:18:51,510
!أطلقوا

308
00:18:55,460 --> 00:18:57,210
!أحسنت يا فتى

309
00:18:57,210 --> 00:18:59,000
!هيّا بنا يا شيتس! واصل التّقدّم

310
00:18:59,000 --> 00:19:00,790
!لك ذلك أيّها القائد

311
00:19:01,950 --> 00:19:04,000
...أطفال لعناء

312
00:19:09,150 --> 00:19:11,040
!هناك واحد ستّجه صوبنا

313
00:19:11,040 --> 00:19:12,500
!أطلقوا

314
00:19:16,640 --> 00:19:17,710
!لا مزيد من الألاعيب

315
00:19:29,110 --> 00:19:31,560
!اتبعوا الزّعيم

316
00:19:32,780 --> 00:19:34,270
!لـ-لقد وصلوا

317
00:19:36,770 --> 00:19:38,790
!اهرب يا سيّدي بيس

318
00:19:54,320 --> 00:19:57,270
!تعالوا لمواجهتي إن كنتم تريدون الموت

319
00:20:02,560 --> 00:20:04,360
.خصومكم ها هنا

320
00:20:06,780 --> 00:20:07,790
!أرني ما لديك

321
00:20:14,780 --> 00:20:18,280
!أيّها القائد، يسعى زعيمهم خلف الأطفال

322
00:20:22,450 --> 00:20:25,410
!هذا ساخن! ساخن

323
00:20:32,850 --> 00:20:36,140
!نلت كفايتي من لعبكم

324
00:20:43,180 --> 00:20:44,520
!سيّدي بيس

325
00:20:44,520 --> 00:20:46,390
.خذوا الأطفال للدّاخل

326
00:20:46,870 --> 00:20:48,240
!سيّدي بيس

327
00:20:48,240 --> 00:20:49,600
!لا تتحرّكوا

328
00:20:50,670 --> 00:20:51,710
!سيّدي بيس

329
00:20:53,720 --> 00:20:55,270
.ولا خطوة واحدة

330
00:20:55,660 --> 00:20:57,270
.يا لها من خدعة جبانة

331
00:21:02,170 --> 00:21:03,460
...هذا الرّجل

332
00:21:04,000 --> 00:21:05,360
!يمكنني استغلاله

333
00:21:05,900 --> 00:21:08,370
!أيّها الأوغاد! نالوا منهم

334
00:21:12,610 --> 00:21:13,750
!نسخ

335
00:21:20,350 --> 00:21:21,880
...ما-ما الّذي

336
00:21:30,310 --> 00:21:35,730
!وجهي... وجهي يحترق

337
00:21:38,970 --> 00:21:42,350
!ا-اللّعنة... ماذا فعلت بي؟

338
00:21:42,840 --> 00:21:44,570
.لا شيء مهمّ

339
00:21:45,630 --> 00:21:48,070
.كلّ ما فعلته هو نسخ إصابة رفيقك

340
00:21:49,150 --> 00:21:51,870
نـ-نسختَ إصابته؟

341
00:21:52,610 --> 00:21:53,870
—هل يعقل

342
00:21:54,310 --> 00:21:56,080
...أنّك تستعمل

343
00:21:56,080 --> 00:21:58,550
السّحر؟

344
00:21:59,510 --> 00:22:00,570
.لا

345
00:22:01,090 --> 00:22:03,020
.أنا مجرّد حلوانيّ

346
00:23:37,160 --> 00:23:39,110
...في الحلقة القادمة

347
00:23:39,020 --> 00:23:44,980
فــطــيرة تفّاح وابتسامات

348
00:23:39,440 --> 00:23:41,830
".فطيرة تفّاح وابتسامات"

349
00:23:41,830 --> 00:23:43,240
!شهيّة طيّبة