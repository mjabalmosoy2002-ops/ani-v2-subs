1
00:00:01,550 --> 00:00:03,850
.مات الشّاه

2
00:00:07,430 --> 00:00:09,900
.أرخيت دفاعاتي لأنّه طفل

3
00:00:10,720 --> 00:00:13,380
،استعمل السّيف الّذي سقط لقطع قيوده

4
00:00:14,060 --> 00:00:16,700
.وهزم ملازمي في رمشة عين

5
00:00:24,860 --> 00:00:27,760
...هـ-هذا

6
00:00:29,090 --> 00:00:30,760
!سنقتحم المكان

7
00:00:30,760 --> 00:00:32,900
!لا تسمحوا لأيّ جرذ بالهرب

8
00:00:34,400 --> 00:00:36,090
!تماسكوا

9
00:00:39,290 --> 00:00:44,350
،هذه قصّة حلوانيّ عبقريّ مات قبل أوانه

10
00:00:44,580 --> 00:00:48,330
وولد من جديد كابن لنبيل فقيل في عالم آخر

11
00:00:48,640 --> 00:00:52,280
.للسّعي خلف عالم مليء بالحلويّات والابتسامات

12
00:00:52,570 --> 00:00:57,290
.إنّها قصّة باردة وقاسية وحلوة في نفس الوقت

13
00:00:58,750 --> 00:01:05,130
!حلمه هو إنشاء بلاد حلويّات خاصّة بهذا العالم

14
00:02:37,720 --> 00:02:38,650
!ها هم

15
00:02:38,650 --> 00:02:40,650
!لا تدعوهم يهربون! أمسكوا بهم

16
00:02:43,320 --> 00:02:45,180
...سيّد بيستري

17
00:02:45,720 --> 00:02:48,560
.سنكون بخير. وصلت المساعدة

18
00:02:50,250 --> 00:02:53,050
...هذا سيّئ. سيّئ جدًّا

19
00:02:53,720 --> 00:02:57,610
.يبدو أنّ التّراجع هو خياري الوحيد

20
00:02:58,110 --> 00:03:00,590
أتظنّ أنّي سأسمح لك بالهرب بسهولة؟

21
00:03:03,380 --> 00:03:04,310
!بيس

22
00:03:04,710 --> 00:03:06,790
!سيّدي بيس! هل أنت بخير؟

23
00:03:07,290 --> 00:03:08,800
!أنا بخير

24
00:03:08,800 --> 00:03:10,090
!اعتن بالآنسة ليكوريش

25
00:03:10,090 --> 00:03:10,900
!غلاساج

26
00:03:10,900 --> 00:03:11,500
!حاضر

27
00:03:19,640 --> 00:03:21,850
.الوضع ليس لصالحي

28
00:03:22,640 --> 00:03:28,600
صار استعمال الغرفة الّتي يصعب الهرب
...منها كزنزانة لا يصبّ في صالحي الآن

29
00:03:29,250 --> 00:03:31,310
!لا مهرب لك الآن

30
00:03:32,770 --> 00:03:35,310
!إن لم يكن هنالك مهرب، فسأصنع واحدًا

31
00:03:39,340 --> 00:03:40,150
سحر؟

32
00:03:40,390 --> 00:03:41,780
!الوداع

33
00:03:42,110 --> 00:03:42,820
!مهلاً

34
00:03:43,130 --> 00:03:44,360
!لا يا بيس

35
00:03:45,540 --> 00:03:46,770
.لا تلاحقه

36
00:03:48,290 --> 00:03:49,420
.مفهوم

37
00:03:53,030 --> 00:03:56,460
...بصراحة يا بُنيّ

38
00:03:56,910 --> 00:03:58,830
.لا حدود لقلقي عليك

39
00:04:00,670 --> 00:04:02,040
.أنا آسف

40
00:04:05,480 --> 00:04:07,850
.أنا مسرور لأنّكما بخير

41
00:04:08,530 --> 00:04:09,460
.نعم

42
00:04:10,890 --> 00:04:11,540
—سيّد بيـ

43
00:04:11,540 --> 00:04:12,420
!يا فتاي

44
00:04:14,090 --> 00:04:15,250
هل أنت بخير؟

45
00:04:16,480 --> 00:04:17,530
!آنسة ليكوريش

46
00:04:17,530 --> 00:04:19,230
!أما مسرور لأنّك بخير

47
00:04:21,000 --> 00:04:24,800
.هذا رجلان من عائلتَيْ كادليتشيك وهوباريك

48
00:04:24,800 --> 00:04:25,860
!آنسة ليكوريش

49
00:04:29,530 --> 00:04:30,470
هل تأذّيت؟

50
00:04:30,470 --> 00:04:32,150
.لا... أنا بخير

51
00:04:32,150 --> 00:04:35,290
.أعدها إلى والدها في أسرع وقت ممكن

52
00:04:35,290 --> 00:04:35,980
!حاضر

53
00:04:37,150 --> 00:04:39,000
.سنغادر الآن

54
00:04:46,730 --> 00:04:48,470
من كان خلف كلّ هذا؟

55
00:04:48,970 --> 00:04:52,680
.اعتقلنا رجلاً يُدعى الدّوق لوهاينغو آرماير

56
00:04:53,500 --> 00:04:56,260
.كان يحاول الهرب من الخلف

57
00:04:57,100 --> 00:04:58,580
من عائلة آرماير؟

58
00:04:59,000 --> 00:05:01,080
،خلال الحرب قبل عشرين سنة

59
00:05:01,080 --> 00:05:03,690
.تمّ التّحقيق في أمرهم وجُرّدوا من لقبهم

60
00:05:03,690 --> 00:05:04,780
.نعم

61
00:05:04,780 --> 00:05:07,870
.اشتُبه بتسريبهم لمعلومات للعدوّ

62
00:05:09,190 --> 00:05:10,830
أتفهم يا بيس؟

63
00:05:11,220 --> 00:05:18,260
إنّ أفعال حاكم إقطاعيّ بإمكانها
.أن تغيّر مصير العائلة بأكملها

64
00:05:18,260 --> 00:05:19,020
.نعم

65
00:05:19,600 --> 00:05:20,840
!أيّها الحاكم مورتلن

66
00:05:21,730 --> 00:05:25,950
ينتظر صاحب السّيادة في قصره
.لتبليغه بتفاصيل الحادثة

67
00:05:26,910 --> 00:05:29,080
هلاّ رافقتنا في هذه العربة؟

68
00:05:31,400 --> 00:05:32,470
!بالطّبع

69
00:05:32,470 --> 00:05:35,110
.علينا الاهتمام بأمر المنفصلين الهاربين

70
00:05:35,110 --> 00:05:37,620
!شيتس، تولّ أمر التّقرير

71
00:05:37,620 --> 00:05:38,410
!مهلاً

72
00:05:38,410 --> 00:05:43,050
،بما أنّ الخصم استعمل السّحر للهرب
!نحن الوحيدان اللّذان نستطيع ملاحقته

73
00:05:43,050 --> 00:05:43,690
!نعم

74
00:05:43,690 --> 00:05:44,690
!لنذهب يا بيس

75
00:05:44,690 --> 00:05:45,480
!حاضر

76
00:05:46,940 --> 00:05:48,910
!قلتُ مهلاً

77
00:05:50,500 --> 00:05:54,120
والآن، إلى أين هرب ذلك الرّجل في رأيك؟

78
00:05:58,360 --> 00:05:59,250
ما الخطب؟

79
00:06:00,250 --> 00:06:03,800
كيف يعقل له أن يهرب تحت تلك الظّروف؟

80
00:06:04,830 --> 00:06:06,590
...عندما اقتربت من الحفرة

81
00:06:07,810 --> 00:06:11,780
.لم أشعر بالكثير من القوّة من إلقائه لتعويذته

82
00:06:13,170 --> 00:06:17,570
أتقترح أنّه لم يكن يملك قوّة سحريّة كافية؟

83
00:06:19,270 --> 00:06:21,380
،حتّى إن حفر حفرة للهرب

84
00:06:21,380 --> 00:06:24,620
.ما كان ليملك قوّة كافية للابتعاد كثيرًا

85
00:06:25,370 --> 00:06:28,400
.تحاصر قوّاتنا المنطقة

86
00:06:28,870 --> 00:06:32,020
هل يعقل أنّه هرب دون أن يلحظه أحد؟

87
00:06:38,310 --> 00:06:43,060
،إن كنت تعجز عن الهرب
...وبحاجة لمخرج من ورطة كهذه

88
00:06:43,910 --> 00:06:47,430
،اجعل الأمر يبدو وكأنّك هربت ووفّر الوقت

89
00:06:47,430 --> 00:06:50,970
.ثمّ اهرب كيفما تشاء عندما ينسحب العدوّ

90
00:06:52,000 --> 00:06:54,680
.هذا ما قد يحدث

91
00:06:55,000 --> 00:06:58,040
.مذهل. اكتشفتَ كلّ شيء

92
00:06:59,840 --> 00:07:04,820
.لكن يبدو أنّ عليّ القضاء عليكما للهرب

93
00:07:06,810 --> 00:07:09,990
.سأسوّي الأمور مع هذا الهمجيّ

94
00:07:11,600 --> 00:07:13,200
.لنرَ إن كانت ستدعم أفعالكَ أقوالك

95
00:07:15,740 --> 00:07:18,400
.اسمي بيستري ميل مورتلن

96
00:07:18,910 --> 00:07:20,130
ما اسمك؟

97
00:07:21,690 --> 00:07:24,590
.تخلّيت عن اسم عائلتي منذ زمن

98
00:07:25,250 --> 00:07:27,800
.يمكنك مناداتي سترودل فحسب

99
00:07:28,640 --> 00:07:33,260
.من المناسب أنّ هذا الفتى يريد نزال رجل لرجل

100
00:07:33,620 --> 00:07:38,050
.قد يكون بارعًا، لكنّه لا يزال طفلاً

101
00:07:38,050 --> 00:07:40,580
،إن استطعتُ تثبيته أرضًا وأخذه كرهينة

102
00:07:40,580 --> 00:07:43,190
!فقد أخرج نفسي من هذا الوضع

103
00:07:46,300 --> 00:07:49,070
!لا شيء في هذا شخصيّ يا فتى

104
00:07:49,070 --> 00:07:51,280
!هذا سيّئ! وضعيّته مثاليّة

105
00:07:54,920 --> 00:07:55,880
!ماذا؟

106
00:08:04,340 --> 00:08:07,710
...ما الخدعة... الّتي

107
00:08:08,260 --> 00:08:10,020
.إليك تحذيرًا

108
00:08:10,020 --> 00:08:14,580
في ساحة القتال، لا تبعد سلاح
.الخصم عن نظرك أبدًا

109
00:08:17,210 --> 00:08:19,210
.أحسنت يا بيس

110
00:08:25,690 --> 00:08:28,250
...هذا السّيف. هل

111
00:08:28,250 --> 00:08:29,070
.نعم

112
00:08:33,140 --> 00:08:33,990
!نسخ

113
00:08:38,200 --> 00:08:39,630
.فهمت

114
00:08:39,630 --> 00:08:43,450
منحت خصمك سيفًا مكسورًا
...واستفززته لاستعماله في نزال

115
00:08:44,540 --> 00:08:46,280
.أخفتني كثيرًا

116
00:08:46,800 --> 00:08:48,630
.يا لك من ماكر صغير

117
00:08:48,630 --> 00:08:51,240
..."أفضّل وصف "ذكيّ

118
00:08:52,590 --> 00:08:56,630
...ولكن... على هذا المعدّل

119
00:08:57,340 --> 00:09:01,140
هل سأستطيع إنشاء بلاد الحلويّات خاصّتي يومًا ما؟

120
00:09:10,520 --> 00:09:11,980
،بعد شهر من ذلك

121
00:09:12,540 --> 00:09:14,500
أُقيم الحفل الرّسميّ لخطوبة السّيّد سكوال

122
00:09:14,500 --> 00:09:18,690
.بالآنسة بيترا في القصر الملكيّ

123
00:09:22,070 --> 00:09:23,980
.شكرًا جزيلاً

124
00:09:22,780 --> 00:09:25,830
!تبدو الآنسة بيترا سعيدة

125
00:09:25,830 --> 00:09:29,440
هذا حدث ضخم بالنّسبة لشيء تمّ
...الإعلان عنه بشكل خاصّ

126
00:09:29,440 --> 00:09:31,810
!أيّها الحاكم مورتلن

127
00:09:33,180 --> 00:09:34,970
.كنت هنا إذًا

128
00:09:35,420 --> 00:09:37,270
!الدّوق كادليتشيك

129
00:09:37,270 --> 00:09:39,380
.تهانينا على الخطبة

130
00:09:39,380 --> 00:09:42,430
.لا كلمات لديّ لأشكرك على الدّعوة

131
00:09:42,430 --> 00:09:43,820
...لا عليك

132
00:09:43,820 --> 00:09:45,740
.أنا من عليه أن يشكرك

133
00:09:45,740 --> 00:09:50,150
.أنت سبب خروجنا من تلك المشاكل سالمين

134
00:09:50,720 --> 00:09:52,000
...سيّد بيستري

135
00:09:52,640 --> 00:09:57,830
لك كلّ امتناني لحمايتك أخت خطيبة
.حفيدي الآنسة ليكوريش

136
00:09:58,290 --> 00:10:00,780
.لم أفعل إلاّ ما هو واجب على أيّ فارس

137
00:10:01,590 --> 00:10:03,950
.يبدو السّيّد سكوال في حالة ممتازة

138
00:10:03,950 --> 00:10:07,440
.لا، إنّه متوتّر ومرتعب

139
00:10:07,440 --> 00:10:10,050
،فلا يتمّ معاملته كغرض للعرض فحسب

140
00:10:10,050 --> 00:10:14,600
لكنّه أيضًا يجلس إلى جانب عروسه
.المستقبليّة الّتي أحبّها من أوّل نظرة

141
00:10:14,600 --> 00:10:19,240
.يبدو السّيّد سكوال بخير في نظري
.بل ومستمتع بوقته

142
00:10:19,240 --> 00:10:24,980
...كنتُ آمل أن تجعله الخطوبة أكثر نضجًا

143
00:10:25,770 --> 00:10:29,320
ولكن إن قال رجل بمثل إنجازاتك
،العسكريّة أنّه يبدو بخير

144
00:10:29,320 --> 00:10:32,400
.فربّما عليّ إعادة النّظر في تقييمي لحفيدي

145
00:10:32,870 --> 00:10:35,570
.أشكرك أيّها السّيّد بيستري

146
00:10:35,570 --> 00:10:36,890
.هذا شرف لي

147
00:10:38,560 --> 00:10:39,960
...بالمناسبة يا صاحب السّيادة

148
00:10:41,260 --> 00:10:45,080
.هنالك أمر أودّ التّأكّد منه بشان هذا الحدث

149
00:10:45,320 --> 00:10:46,540
فعلاً؟

150
00:10:46,910 --> 00:10:48,780
...حادثة الاختطاف

151
00:10:48,780 --> 00:10:51,770
...لاحظتُ بعض الأشياء الغريبة حيالها

152
00:10:52,090 --> 00:10:53,600
أشياء غريبة؟

153
00:10:53,600 --> 00:10:54,290
.نعم

154
00:10:54,840 --> 00:10:59,530
،بين مهارة الجاني ودقّته في تأمين عدّة معاقل له

155
00:10:59,530 --> 00:11:01,800
.بدا لي أنّه كان مستعدًّا تمامًا

156
00:11:02,340 --> 00:11:08,310
ومع ذلك اقترف خطأ قاتلاً وأساسيًّا
.عندما اختطف الفتاة الخطأ

157
00:11:08,760 --> 00:11:13,120
هل يعقل أنّ هذا كان نتيجة حصوله

158
00:11:13,120 --> 00:11:16,780
على معلومات مضلّلة بخصوص الآنسة بيترا؟

159
00:11:17,290 --> 00:11:20,250
وامتلاك نبيل منبوذ للصّلات المناسبة

160
00:11:20,250 --> 00:11:23,740
...لتحضير عدّة قواعد لعمليّاته داخل العاصمة

161
00:11:24,210 --> 00:11:25,680
هل شيء كهذا ممكن بالفعل؟

162
00:11:26,590 --> 00:11:29,910
لا أستطيع التّخلّص من شعور
.أنّ هنالك شيئًا ما ليس في محلّه

163
00:11:32,180 --> 00:11:36,330
إضافة لذلك، ما قد يفسّر ذلك

164
00:11:36,330 --> 00:11:39,090
هو وجود طرف ثالث في الحادثة

165
00:11:39,310 --> 00:11:41,300
.وله هدفه الخاصّ منها

166
00:11:42,120 --> 00:11:43,740
طرف ثالث؟

167
00:11:43,740 --> 00:11:45,590
،سرّب الطّرف الثّالث المعلومة المضلّلة

168
00:11:45,590 --> 00:11:47,560
،وجهّز صلات بطرق ملتوية

169
00:11:47,890 --> 00:11:52,310
.وأشرف على آرماير بشكل عامّ في العاصمة

170
00:11:53,210 --> 00:11:56,190
فعلاً؟ ومن قد يكون الطّرف الثّالث؟

171
00:11:57,660 --> 00:12:01,400
.إنّه طبعًا  الشّخص الّذي سيستفيد أكثر من هذا

172
00:12:02,650 --> 00:12:03,610
سيستفيد؟

173
00:12:03,950 --> 00:12:06,970
،إن حصل على غضب عائلة آرماير

174
00:12:07,420 --> 00:12:10,180
.فلا بدّ أنّه شخص اكتسب القوّة بعد سقوطهم

175
00:12:12,000 --> 00:12:16,250
وسيستعمل ذلك الشّخص الحادثة لقطع

176
00:12:16,250 --> 00:12:19,770
...أيّ فرصة متبقّية لعودة عائلة آرماير السّاخطة

177
00:12:19,770 --> 00:12:21,080
!يكفي

178
00:12:23,490 --> 00:12:26,720
هل تقترح أنّ هذا "الشّخص" هو أنا؟

179
00:12:31,780 --> 00:12:33,010
.بالطّبع لا يا سيادتك

180
00:12:33,010 --> 00:12:34,920
.لديّ خيال جامح لا غير

181
00:12:35,250 --> 00:12:39,360
.يحبّ الأطفال القصص والرّوايات

182
00:12:40,460 --> 00:12:43,290
...استخففتُ به كثيرًا

183
00:12:43,290 --> 00:12:44,920
.لكنّ هذا سخيف

184
00:12:44,920 --> 00:12:47,970
!هذا هو التّعريف الفعليّ لعضّ اليد الّتي تطعمك

185
00:12:48,830 --> 00:12:49,370
...بيس

186
00:12:54,820 --> 00:12:56,180
.عفوًا يا سيادتك

187
00:12:56,180 --> 00:12:58,500
...بخصوص مسألة مختلفة تمامًا

188
00:12:59,980 --> 00:13:01,940
،حسب معلوماتك

189
00:13:01,940 --> 00:13:04,620
.إقطاعيّتنا هي أرض قليلة المحاصيل

190
00:13:05,060 --> 00:13:07,130
،لديّ بعض الإجراءات الّتي أودّ اتّخاذها

191
00:13:07,130 --> 00:13:08,920
...لكنّي أفتقر للأساس المطلوب

192
00:13:10,090 --> 00:13:11,770
تقصد المال؟

193
00:13:12,920 --> 00:13:17,030
سأسرّ حقًّا إن قام رجل بمثل حكمة سيادتك

194
00:13:17,030 --> 00:13:20,150
.بإظهار عطفه لوضعنا، وربّما يقدّم يد العون

195
00:13:21,840 --> 00:13:24,750
لا تفوتك فائتة، صحيح؟

196
00:13:24,750 --> 00:13:30,120
وأيضًا... وإن قلتُ أنّي لا مساعدتك؟

197
00:13:30,890 --> 00:13:33,830
.قد يزلّ لساني

198
00:13:34,160 --> 00:13:34,930
!ماذا؟

199
00:13:35,950 --> 00:13:38,590
هل ترى المارغريف هناك؟

200
00:13:39,610 --> 00:13:42,750
.كنّا نوشك على الذّهاب لتحيّته

201
00:13:43,740 --> 00:13:48,720
وإن زلّ لساني أنا الطّفل الصّغير المتهوّر
—بخصوص ما تحدّثنا عنه قبل

202
00:13:48,720 --> 00:13:50,840
.لا بأس! أستسلم

203
00:13:51,550 --> 00:13:54,220
.سأوفّر كلم كلّ العون الّذي تحتاجونه

204
00:13:57,570 --> 00:13:59,190
.هذا شرف لي يا سيّدي

205
00:13:59,190 --> 00:14:01,090
.تغلّبت عليّ

206
00:14:02,230 --> 00:14:05,150
.سأقول شيء ما الآن، لكنّه كلام موجّه لي

207
00:14:05,540 --> 00:14:06,610
عفوًا؟

208
00:14:07,520 --> 00:14:10,730
.أطلب منكما تجاهلي بينما أكلّم نفسي

209
00:14:12,070 --> 00:14:16,830
.تبيّنت لي فرصة لتدمير فصيل معارض بضربة واحدة

210
00:14:17,370 --> 00:14:22,290
أعطيت الأمر بتسريب معلومات
.من شأنها أن تشجّع على الاختطاف

211
00:14:22,900 --> 00:14:23,850
...ولكن

212
00:14:24,750 --> 00:14:31,720
لم يكن هدفي أن أضع خطيبة حفيدي
.أو أختها في أيّ خطر على الإطلاق

213
00:14:32,390 --> 00:14:37,430
.أعترف أنّني رتّبت الأمر برمّته

214
00:14:37,890 --> 00:14:39,990
،ومهما كان العذر الّذي قد أقدّمه

215
00:14:39,990 --> 00:14:42,890
.فالحقيقة هي أنّي وضعت الآنسة ليكوريش في خطر

216
00:14:42,890 --> 00:14:44,900
،اعترف بكلّ تواضع بالتّهامات

217
00:14:44,900 --> 00:14:46,610
.وسأفكّر مليًّا في أفعالي من الآن فصاعدًا

218
00:14:47,070 --> 00:14:49,500
.أقدّر هذا التّحذير

219
00:14:49,500 --> 00:14:50,160
...ولكن

220
00:14:50,510 --> 00:14:54,660
.إنّ ابتزازي بهذا الشّكل والوقاحة لهو أمر ماكر للغاية

221
00:14:54,660 --> 00:14:56,550
ما زلت تكلّم نفسك، صحيح؟

222
00:14:56,550 --> 00:14:58,150
!بالطّبع

223
00:14:58,150 --> 00:14:59,530
!أيّها الحاكم مورتلن

224
00:15:00,670 --> 00:15:03,450
.سيّدي هوباريك. كنّا قادمان إليك لتحيّتك

225
00:15:03,450 --> 00:15:04,940
!سيّد كاسرول

226
00:15:04,940 --> 00:15:07,340
!ابنك هنا أيضًا

227
00:15:07,980 --> 00:15:11,270
.عليّ أن أقدّم امتناني للسّيّد بيستري أيضًا

228
00:15:11,270 --> 00:15:12,850
.أشكرك مرّة أخرى

229
00:15:12,850 --> 00:15:14,800
...هـ-هذا شرف لي

230
00:15:14,800 --> 00:15:19,180
لقد خضت مراسم التّقديس خاصّتك، أليس كذلك؟

231
00:15:19,560 --> 00:15:21,760
.نـ-نعم

232
00:15:21,760 --> 00:15:24,380
هل سيدخلني في خطّة لجني المال أو ما شابه؟

233
00:15:24,380 --> 00:15:30,900
حسنًا، إنّ رجلاً بقدراتك هذه
.قد يكون محطّ أعجاب الكثيرين قريبًا

234
00:15:30,900 --> 00:15:34,820
!وطبعًا لا يكون الوقت باكرًا أبدًا على الاستقرار

235
00:15:35,110 --> 00:15:37,040
...نـ-نعم

236
00:15:37,040 --> 00:15:40,750
هل هنالك شخص معيّن في قلبك بعد؟

237
00:15:41,020 --> 00:15:44,960
.لا... لا أزال طفلاً قبل كلّ شيء

238
00:15:44,960 --> 00:15:47,010
،أي أنّك إن عثرت على الشّخص المناسب

239
00:15:47,010 --> 00:15:50,670
فستستقرّان معًا في المستقبل؟

240
00:15:51,530 --> 00:15:51,840
—بيـ

241
00:15:51,840 --> 00:15:55,330
.لكن أخشى أنّي لم أقابل الشّخص المناسب بعد

242
00:15:56,280 --> 00:15:59,850
ما رأيك في ابنتي إذًا؟

243
00:16:02,090 --> 00:16:03,770
.يا إلهي

244
00:16:05,980 --> 00:16:09,940
...لـ-لكن... الآنسة بيترا مخطوبة

245
00:16:10,210 --> 00:16:12,130
.لا تكن سخيفًا

246
00:16:12,130 --> 00:16:15,570
.بيترا ليست الوحيدة الّتي بلغت سنّ الرّشد

247
00:16:16,490 --> 00:16:18,080
.أنا أقصد ليكوريش

248
00:16:19,850 --> 00:16:22,080
ا-الآنسة ليكوريش؟

249
00:16:22,370 --> 00:16:25,570
.يبدو أنّها راضية تمامًا بالفكرة

250
00:16:25,570 --> 00:16:28,550
...ما... أنا... لستُ

251
00:16:29,040 --> 00:16:31,020
...هذا شرف لي، ولكن

252
00:16:31,760 --> 00:16:34,170
.أنا غير جدير بذلك

253
00:16:34,630 --> 00:16:37,830
...واثق أنّ الآنسة ليكوريش ستفضّل شريكًا أفضل

254
00:16:39,640 --> 00:16:43,860
قلتَ قبل قليل أنّك ستستقرّ مع
...الشّخص المناسب

255
00:16:43,860 --> 00:16:48,980
هل يعني هذا أنّك تجد ابنتي غير مناسبة بما يكفي؟

256
00:16:49,440 --> 00:16:51,210
...بالطّبع لا

257
00:16:51,210 --> 00:16:52,030
.هذا سيّئ

258
00:16:52,850 --> 00:16:54,990
!يستحقّ هذا

259
00:16:54,990 --> 00:16:57,720
...أ-أنا طبعًا لم أقصد ذلك

260
00:16:57,720 --> 00:17:00,450
إذًا فأنت تقبل بابنتي؟

261
00:17:02,550 --> 00:17:05,900
...عفوًا... ماذا؟ ما الّذي

262
00:17:06,330 --> 00:17:07,890
هل اتّفقنا إذًا؟

263
00:17:08,420 --> 00:17:15,400
أ-أنا... لا يمكنني إنكار أنّ الآنسة
...ليكوريش فتاة مذهلة، ولكن

264
00:17:16,420 --> 00:17:18,550
هل توافق أيضًا أيّها السّيّد كاسرول؟

265
00:17:19,330 --> 00:17:22,010
.هذا أشبه بتهديد

266
00:17:23,190 --> 00:17:25,770
.سيكون هذا شرفًا لعائلتنا

267
00:17:25,770 --> 00:17:27,730
!أبي؟

268
00:17:28,090 --> 00:17:30,000
!اتّخذ القرار إذًا

269
00:17:31,850 --> 00:17:34,080
!اجمع العائلة

270
00:17:34,080 --> 00:17:34,940
!حاضر

271
00:17:34,940 --> 00:17:37,930
!إذًا سأجمع عائلة كادليتشيك أيضًا

272
00:17:37,930 --> 00:17:40,410
!أيّها الموظّفون

273
00:17:44,890 --> 00:17:46,090
...سيّد بيس

274
00:17:46,090 --> 00:17:47,330
مع ليكوريش؟

275
00:17:47,730 --> 00:17:51,200
!إنّ وريث إقطاعيّة مورتلن مخطوب سلفًا

276
00:17:51,200 --> 00:17:54,720
!أرسلوا الخبر لكلّ المناطق في الحال

277
00:17:54,720 --> 00:17:59,610
كم هذا رائع! لقد أنقذ الآنسة
!ليكوريش بنفسه قبل كلّ شيء

278
00:17:59,610 --> 00:18:01,430
...هذا غريب

279
00:18:01,430 --> 00:18:04,160
،أشعر أنّني كنت أظنّني سأصنع حلوى بالقشدة

280
00:18:04,160 --> 00:18:08,850
...لكن انتهى بي المطاف بكعكة زفاف ضخمة

281
00:18:07,600 --> 00:18:08,850
!ها هي ذي

282
00:18:10,100 --> 00:18:11,270
ما هذه الرّائحة؟

283
00:18:17,200 --> 00:18:18,930
...سيّد بيستري

284
00:18:18,930 --> 00:18:23,210
.عليّ أن أشكرك بالفعل على إنقاذي ذلك اليوم

285
00:18:23,550 --> 00:18:25,930
...سامحني لأنّي لم أشكرك من قبل

286
00:18:27,210 --> 00:18:30,540
!كم هي جميلة

287
00:18:28,590 --> 00:18:31,170
هل كانت ظريفة هكذا دائمًا؟

288
00:18:31,600 --> 00:18:33,880
!انتباه أيّها الحضور

289
00:18:34,290 --> 00:18:37,520
،أنا دوناشيل ميل هوباريك

290
00:18:37,520 --> 00:18:42,170
!وجدتُ في هذا اليوم شريكَيْ حياة لكلتا ابنتَيّ

291
00:18:42,490 --> 00:18:45,490
!الأوّل هو السّيّد سكوال كادليتشيك

292
00:18:46,880 --> 00:18:51,110
!والثّاني هو السّيّد بيستري مورتلن

293
00:18:53,690 --> 00:18:58,720
ما يعني أنّ عائلة كادليتشيك لم تتّخذ
،هاتين الجميلتين كحفيدتين فحسب

294
00:18:58,720 --> 00:19:02,660
!بل واتّخذت ابن البطل العظيم السّيّد كاسرول أيضًا

295
00:19:05,620 --> 00:19:07,830
!بصحّتكم

296
00:19:13,540 --> 00:19:14,520
!سيّد بيس

297
00:19:15,070 --> 00:19:17,750
.صرنا صِهرين الآن

298
00:19:23,470 --> 00:19:25,730
أليس هذا رائعًا؟

299
00:19:26,110 --> 00:19:27,860
.أنا سعيدة أيضًا

300
00:19:28,700 --> 00:19:31,660
...سيّد سكوال... آنسة بيترا

301
00:19:32,170 --> 00:19:34,120
!يمكنك مناداتي أخي الكبير

302
00:19:34,530 --> 00:19:36,940
.وأنا... نادني أختي الكبيرة

303
00:19:36,940 --> 00:19:39,610
...ما زال... الوقت باكرًا على ذلك

304
00:19:53,410 --> 00:19:56,810
.حدث كلّ شيء بسرعة ولا أشعر أنّه حقيقيّ

305
00:19:57,180 --> 00:19:58,570
سيّد بيستري؟

306
00:19:59,880 --> 00:20:01,770
.الآنسة ليكوريش

307
00:20:02,640 --> 00:20:03,600
...أنا

308
00:20:04,120 --> 00:20:05,010
ماذا هنالك؟

309
00:20:06,840 --> 00:20:10,430
هل خيّبت أملك؟

310
00:20:13,880 --> 00:20:15,020
.على الإطلاق

311
00:20:16,170 --> 00:20:17,700
!أنا سعيد جدًّا بوجودك معي

312
00:20:18,860 --> 00:20:22,530
!و-وأنا كذلك... سعيدة جدًّا

313
00:20:22,880 --> 00:20:25,650
.اعتني بي رجاءً

314
00:20:26,040 --> 00:20:27,080
.أطلب المثل منك

315
00:20:28,280 --> 00:20:30,400
...لذلك

316
00:20:30,710 --> 00:20:35,710
.جرّبت إعداد بعض الحلويّات حسب ما قدّمته لنا

317
00:20:35,960 --> 00:20:37,670
قدّمته لكم؟

318
00:20:42,030 --> 00:20:43,690
!تقصدين البسكويت

319
00:20:45,160 --> 00:20:48,550
أكانت هذه هي الرّائحة الزّكيّة الّتي شممتها؟

320
00:20:48,910 --> 00:20:51,510
!تفضّل، جرّبها رجاءً

321
00:20:51,510 --> 00:20:52,410
!بكلّ سرور

322
00:20:54,960 --> 00:20:57,040
!لون بنّيّ جميل

323
00:20:57,040 --> 00:21:00,930
.أحسنت بخصوص وقت الخبز وزمن إراحة العجين

324
00:21:03,030 --> 00:21:05,450
!أعتقد أنّها استعملت دقيقًا عالي الجودة

325
00:21:06,850 --> 00:21:08,380
...لا بدّ أنّها

326
00:21:17,380 --> 00:21:18,630
...هذه

327
00:21:19,790 --> 00:21:21,690
.مالحة قليلاً

328
00:21:24,030 --> 00:21:25,970
...عفوًا

329
00:21:27,250 --> 00:21:28,510
!إنّها... لذيذة

330
00:21:28,770 --> 00:21:30,120
!فعلاً؟

331
00:21:30,120 --> 00:21:33,080
أهي كذلك بالفعل؟

332
00:21:33,080 --> 00:21:34,360
.سرّني سماع هذا

333
00:21:40,080 --> 00:21:43,620
.سأحمي ابتسامتها لبقيّة حياتي

334
00:21:44,890 --> 00:21:47,530
.سأعمل بجدّ مهما كانت الصّعاب الّتي سنواجهها

335
00:21:48,160 --> 00:21:50,850
...بوجودها إلى جانبي، واثق أنّي سأنجح

336
00:21:49,060 --> 00:21:50,850
هلّي بواحدة أخرى؟

337
00:21:50,850 --> 00:21:51,830
!نعم

338
00:21:53,510 --> 00:21:55,930
.بلاد الحلويّات الخاصّة بهذا العالم

339
00:22:02,940 --> 00:22:04,410
...جيّدة ومالحة

340
00:23:37,050 --> 00:23:39,220
...في الحلقة القادمة

341
00:23:39,220 --> 00:23:42,270
".عسل للحلويّات وخزّان للقرى"

342
00:23:42,610 --> 00:23:43,890
!شهيّة طيّبة