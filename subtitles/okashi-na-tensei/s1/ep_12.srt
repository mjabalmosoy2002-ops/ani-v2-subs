1
00:00:10,530 --> 00:00:13,280
!أنا مسرور لأنّك بخير يا سيّد سكوال

2
00:00:14,710 --> 00:00:16,000
.لم نلتق منذ مدّة

3
00:00:16,000 --> 00:00:19,260
سمعنا عن نشر قوّاتك الأوّل
!وأتينا للمساعدة

4
00:00:19,690 --> 00:00:20,480
...والآن

5
00:00:22,040 --> 00:00:24,570
!لنعد والنّصر حليفنا

6
00:01:58,560 --> 00:02:01,150
.أنا مسرور جدًّا لأنّك بخير يا سيّد سكوال

7
00:02:02,290 --> 00:02:04,890
...أنقذتموني في أكثر أوقات شدّتي

8
00:02:05,260 --> 00:02:07,210
.لا توجد كلمات للتّعبير عن امتناني

9
00:02:14,890 --> 00:02:16,490
!أقلت مورتلن؟

10
00:02:16,820 --> 00:02:18,530
...يا لهوباريك ذاك

11
00:02:18,530 --> 00:02:21,660
روّض حتّى وحشًا مثله؟

12
00:02:21,980 --> 00:02:24,510
،بوجود مورتلن إلى جانبهم

13
00:02:24,510 --> 00:02:28,540
فمن المحتمل أيضًا أنّ الدّوق كادليتشيك
.قد أرسل تعزيزات أيضًا

14
00:02:31,740 --> 00:02:33,960
هل نسحب قوّاتنا؟

15
00:02:39,970 --> 00:02:42,700
!اللّعنة عليهم

16
00:02:43,350 --> 00:02:45,850
.سيّد سكوال، أنا مسرور لأنّك بخير

17
00:02:46,330 --> 00:02:50,810
.كنت قلقًا جدًّا على صهري المستقبليّ

18
00:02:51,050 --> 00:02:52,390
.أنا جدّ آسف

19
00:02:52,390 --> 00:02:56,700
.وضعك افتقاري إلى التّحقيق المعمّق في خطر محدق

20
00:02:57,450 --> 00:02:59,150
.الخطأ ليس خطأك

21
00:02:59,530 --> 00:03:01,940
.أمّأ أنتما، فأنا مدين لكما

22
00:03:01,940 --> 00:03:03,370
!لكم منّي أصدق امتناني

23
00:03:04,220 --> 00:03:06,830
.قام السّيّد سكوال بعمل ممتاز

24
00:03:07,160 --> 00:03:10,860
.رفض الاستسلام حتّى وهو محاصر بالعدوّ

25
00:03:10,860 --> 00:03:13,320
.كان عازمًا إيجاد مهرب بالقتال

26
00:03:14,810 --> 00:03:19,710
...كلاّ. لو لم تصلا، ما كنتُ

27
00:03:20,800 --> 00:03:25,640
.يبدو أنّ جيش لوتوروت عاقد إلى منطقته الآن

28
00:03:25,640 --> 00:03:27,510
.هذه أخبار ممتازة

29
00:03:27,890 --> 00:03:30,890
.حان الوقت للاحتفال بمن حقّقوا إنجازات في المعركة

30
00:03:31,370 --> 00:03:35,480
.وقبل كلّ شيء، إخلاص السّيّد سكوال

31
00:03:35,480 --> 00:03:37,030
.هذا صحيح

32
00:03:38,380 --> 00:03:39,690
.لا أستحقّ هذا

33
00:03:40,890 --> 00:03:42,920
.تبدو متعبًا

34
00:03:42,920 --> 00:03:44,140
.لا ألومك

35
00:03:44,140 --> 00:03:46,290
.عليك أن ترتاح لبعض الوقت

36
00:03:46,290 --> 00:03:48,190
.أظنّني سأفعل

37
00:03:51,070 --> 00:03:52,370
!سيّد سكوال

38
00:03:52,780 --> 00:03:53,930
!حمدًا على هذا

39
00:03:53,930 --> 00:03:55,330
لم تتعرّض للأذى، صحيح؟

40
00:03:56,970 --> 00:03:58,800
،شكرًا جزيلاً لك

41
00:03:59,110 --> 00:04:01,870
.لكنّها مجرّد خدوش طفيفة لا غير

42
00:04:02,340 --> 00:04:05,200
.أنا مسرورة حدًّا لأنّك بخير

43
00:04:10,720 --> 00:04:12,490
سيّد سكوال؟

44
00:04:14,040 --> 00:04:17,130
.أنا متعب. لنتحدّث لاحقًا

45
00:04:17,460 --> 00:04:18,690
هل أوصلك إلى غرفتك إذًا؟

46
00:04:19,090 --> 00:04:20,430
.المعذرة

47
00:04:20,430 --> 00:04:23,900
.دعيني وحدي رجاءً

48
00:04:24,150 --> 00:04:25,540
!سيّد سكوال؟

49
00:04:27,310 --> 00:04:30,090
.أنا قلق على ذلك الفتى

50
00:04:30,410 --> 00:04:32,920
إنّ من يمرّون بنشرِ قوّاتٍ أوّلَ مؤلمٍ كهذا

51
00:04:32,920 --> 00:04:37,290
يجدون أنفسهم أحيانًا مدمّرين
.بسبب ثقل عبء الصّدمة

52
00:04:37,290 --> 00:04:41,380
.يبدو أنّ الأمر كان صعبًا عليه بالفعل

53
00:04:41,380 --> 00:04:42,490
.نعم

54
00:04:42,490 --> 00:04:46,760
ولكن بالنّسبة لوريث لقب الدّوق الّذي
،يُشرف على جيش العاصمة الملكيّة

55
00:04:46,760 --> 00:04:49,470
...كانت تجربة ضروريّة له

56
00:04:53,680 --> 00:04:57,230
...لكنّ تعبيره ذاك

57
00:04:57,770 --> 00:04:59,370
.هذه أوّل مرّة أراه فيها

58
00:05:02,190 --> 00:05:05,900
ماذا يمكنني أن أفعله لمساعدته؟

59
00:05:07,850 --> 00:05:13,010
هل هناك شيء يمكنني فعله لأخفّف عنه؟

60
00:05:14,610 --> 00:05:15,670
.بيس

61
00:05:15,670 --> 00:05:19,920
،عندما هزمنا قطّاع الطّرق أولئك
،وقام مارك بخطأ فادح

62
00:05:19,920 --> 00:05:21,990
.أذكر أنّك وجدت طريقة لتخفّف عنه

63
00:05:23,880 --> 00:05:27,140
صحيح... تقصد عندما أعددت فطيرة البونكا؟

64
00:05:27,980 --> 00:05:30,830
.أنت قريب من سنّ السّيّد سكوال أيضًا

65
00:05:30,830 --> 00:05:32,300
هل يمكنك تولّي الأمر؟

66
00:05:32,300 --> 00:05:34,480
أنا؟

67
00:05:34,850 --> 00:05:37,310
.أرجوك يا سيّد بيستري

68
00:05:37,310 --> 00:05:38,670
...حـ-حسنًا

69
00:05:39,120 --> 00:05:44,780
ولكن إن كانت حتّى الآنسة بيترا عجزت
في التّخفيف عنه، فماذا يمكنني فعله؟

70
00:05:44,780 --> 00:05:50,110
أكثر ما أرغب فيه الآن هو رؤية
.ابتسامته المشرقة ثانية

71
00:05:50,110 --> 00:05:51,740
.لا أكثر ولا أقلّ

72
00:05:53,000 --> 00:05:53,850
ابتسامة؟

73
00:05:55,750 --> 00:05:58,920
...إن كان بإمكانهم أكل النّتيجة الأخيرة بابتسامة

74
00:05:59,550 --> 00:06:05,260
!فإنّ كلّ من في العالم يمكنه أن يصير سعيدًا وفرحًا

75
00:06:05,860 --> 00:06:09,030
!تُسعد الحلويّات الجميع

76
00:06:09,890 --> 00:06:12,100
!هناك تحلية خلف كلّ ابتسامة

77
00:06:12,500 --> 00:06:13,500
ابتسامة؟

78
00:06:14,120 --> 00:06:15,970
!بالطّبع... الابتسامة

79
00:06:16,210 --> 00:06:18,230
.يبدو أنّه خطرت في بالك فكرة ما

80
00:06:18,810 --> 00:06:20,760
.هناك شيء أريد إعداده

81
00:06:20,760 --> 00:06:22,940
هل يمكنك تجهيز ما أحتاج إليه؟

82
00:06:23,660 --> 00:06:24,900
أيّ نوع من التّحلية ستكون؟

83
00:06:24,900 --> 00:06:25,730
ماذا؟

84
00:06:26,050 --> 00:06:27,110
إنّها تحلية، صحيح؟

85
00:06:27,330 --> 00:06:28,810
...إنّها... أنا

86
00:06:28,810 --> 00:06:33,660
أبي، أنا لا أقوم بهذا بسبب رغبة
...شخصيّة منّي لإعداد الحلوى

87
00:06:33,660 --> 00:06:35,000
.افعل ما يحلو لك

88
00:06:36,370 --> 00:06:37,450
!أبي

89
00:06:37,750 --> 00:06:39,380
.سأترك الأمر لك

90
00:06:39,380 --> 00:06:41,830
!أرجوك يا سيّد بيستري

91
00:06:42,170 --> 00:06:44,960
.سأجهّز لك كلّ ما تحتاجه

92
00:06:44,960 --> 00:06:46,480
!شكرًا جزيلاً لك

93
00:06:46,790 --> 00:06:49,430
هل يمكنك توفير بعض البونكا إذًا؟

94
00:06:50,390 --> 00:06:51,530
بونكا؟

95
00:06:51,530 --> 00:06:53,390
هل ستعدّ فطيرة بونكا؟

96
00:06:54,420 --> 00:06:55,250
.لا

97
00:07:01,770 --> 00:07:07,780
انعزل السّيّد سكوال بنفسه عن
.العالم لأنّه يشعر أنّه غير كفؤ

98
00:07:10,090 --> 00:07:13,200
...أريد أن أقدّم له نور ابتسامة

99
00:07:13,770 --> 00:07:16,990
!طريقة العودة للسّعادة الّتي تمثّله الابتسامة

100
00:07:29,590 --> 00:07:31,950
!نخب النّصر

101
00:07:31,950 --> 00:07:33,260
!النّصر

102
00:07:33,830 --> 00:07:36,350
!هذا أفضل نبيذ في إقطاعيّتنا

103
00:07:36,350 --> 00:07:38,210
!اشربوا بقدر ما تشاؤون

104
00:08:05,670 --> 00:08:08,990
،ظننتُ أنّها ستكون حملة طويلة
لكنّها كانت مجرّد مناوشة صغيرة؟

105
00:08:08,990 --> 00:08:11,570
.نعم، كنتُ آمل الحصول على بعض التّقدير منها

106
00:08:11,570 --> 00:08:17,680
لكنّ الوحيد الّذي خرج من الأمر ويحقّ له
!التّباهي هو ذلك الدّخيل المدلّل

107
00:08:17,680 --> 00:08:19,730
أظنّ أنّ الحظّ إلى جانبه، صحيح؟

108
00:08:25,420 --> 00:08:27,150
.لا تعرهم أيّ اهتمام

109
00:08:27,150 --> 00:08:29,060
.يريدون الشّكوى فحسب

110
00:08:29,580 --> 00:08:32,780
.لا... إنّهم على حقّ

111
00:08:34,810 --> 00:08:38,640
.إنّه لأمر مؤسف، لكنّ الحرب تتطلّب التّضحيات

112
00:08:39,370 --> 00:08:42,550
،بصفتك حفيد الدّوق كادليتشيك

113
00:08:42,550 --> 00:08:46,290
.عليك استيعاب هذه الحقيقة أكثر من معظم النّاس

114
00:08:47,210 --> 00:08:48,750
.معك حقّ

115
00:08:49,210 --> 00:08:54,620
.مُنحتُ منصبًا بارزًا بفضل مكانتي كدوق مستقبليّ

116
00:08:55,210 --> 00:08:58,760
حتّى أنّ المارغريف قد جهّز حملةً
...أولى مثاليّة لي، ومع ذلك

117
00:08:59,100 --> 00:09:02,600
.لا أدري كيف سأواجه جدّي

118
00:09:03,010 --> 00:09:05,600
.واجهتُ وقتًا عصيبًا في حملتي الأولى أيضًا

119
00:09:05,600 --> 00:09:08,610
.لقد أبليتَ حسنًا يا سيّد سكوال

120
00:09:08,610 --> 00:09:11,010
.مسموح لك أن تشعر بالفخر

121
00:09:11,930 --> 00:09:13,500
.شكرًا جزيلاً لك

122
00:09:15,010 --> 00:09:16,530
.لا أستطيع إزالة تلك الصّور من رأسي

123
00:09:17,570 --> 00:09:19,650
...جميعهم... بسبب قلّة خبرتي

124
00:09:26,810 --> 00:09:28,380
.آسف على التّأخير

125
00:09:29,580 --> 00:09:34,170
.صاحب السّعادة، أقدّم لك أحرّ تهانيّ على نصركم

126
00:09:34,170 --> 00:09:37,960
وأنا أشكرك جزيل الشّكر على توفيركم
.يد العون رغم بعد المسافة

127
00:09:39,300 --> 00:09:40,950
،إن سمحت لي

128
00:09:40,950 --> 00:09:45,320
تُعتبر قيادتك الحاسمة والحازمة والرّشيدة

129
00:09:45,320 --> 00:09:47,990
.إحدى السّلطات الرّائدة في هذه المملكة

130
00:09:47,990 --> 00:09:51,440
!أنت لطيف للغاية
.لا أعرف كيف أردّ عليك

131
00:09:51,760 --> 00:09:56,230
لقد استعرتُ مطبخكم لبعض
.الوقت للاحتفال بهذه المناسبة

132
00:09:56,230 --> 00:09:57,690
هل يمكنني الكشف عمّا أعددت؟

133
00:09:57,690 --> 00:09:59,310
!بالطّبع

134
00:10:29,850 --> 00:10:31,190
...أهذه

135
00:10:32,250 --> 00:10:34,900
!يمكنني شمّها من هنا
!يا لها من رائحة زكيّة

136
00:10:35,510 --> 00:10:37,860
هل هذه تحلية مخبوزة؟

137
00:10:38,690 --> 00:10:40,860
!لم أرَ مثيلاً لها من قبل

138
00:10:46,380 --> 00:10:48,250
.تفضّل يا سيّد سكوال

139
00:10:57,050 --> 00:10:59,540
...ذلك الشّيء الأحمر البنّيّ فوقها

140
00:10:59,540 --> 00:11:00,920
أهو فاكهة ما؟

141
00:11:02,350 --> 00:11:04,210
ماذا تسمّى هذه؟

142
00:11:04,520 --> 00:11:06,540
.تارت تاتان

143
00:11:06,540 --> 00:11:08,600
تارت... تاتان؟

144
00:11:08,880 --> 00:11:10,890
.إنّها تحلية مخبوزة مُعدّة من البونكا

145
00:11:10,890 --> 00:11:13,440
.أعددتها لك خصّيصًا

146
00:11:14,010 --> 00:11:17,460
هذا الجزء في الأعلى... بونكا؟

147
00:11:17,460 --> 00:11:19,440
بونكا مخبوزة؟

148
00:11:19,440 --> 00:11:20,120
.نعم

149
00:11:20,780 --> 00:11:24,690
.نيكولو، أحضر التّارت تاتان الّتي في المطبخ للبقيّة

150
00:11:24,690 --> 00:11:26,240
.تحت أمرك

151
00:11:27,210 --> 00:11:29,730
...رائحة البونكا الطّازجة والحلوة

152
00:11:29,730 --> 00:11:32,580
...الرّائحة المنشّطة للقشرة المخبوزة حديثًا

153
00:11:33,060 --> 00:11:34,200
...لا يسعني إلاّ

154
00:11:35,300 --> 00:11:37,160
.أن اشعر بالجوع في الحال

155
00:11:42,580 --> 00:11:44,680
هذه... بونكا؟

156
00:11:44,680 --> 00:11:46,300
!يا للذّتها

157
00:11:46,550 --> 00:11:51,390
إنّ إضافة الحرارة لها يمنح عُمقًا
.للحموضة ويركّز الحلاوة

158
00:11:51,820 --> 00:11:54,240
،هشاشة السّطح

159
00:11:54,240 --> 00:11:55,980
،وليونة البونكا

160
00:11:56,420 --> 00:11:58,700
...وقرمشة قشرة التّارت

161
00:11:58,700 --> 00:12:00,750
إنّ التّباين بين كلّ هذه العناصر
!هو ما يجعل هذا الطّبق رائعًا

162
00:12:01,210 --> 00:12:04,950
.لم أذق تحلية لذيذة كهذه من قبل

163
00:12:04,950 --> 00:12:06,220
.هذا شرف لي

164
00:12:06,650 --> 00:12:08,340
لماذا تُدعى "تارت تاتان"؟

165
00:12:08,900 --> 00:12:13,040
يقال أنّ مصدرها هم خبراء
.إعداد التّارت، الأختان تاتان

166
00:12:13,270 --> 00:12:14,780
الأختان تاتان؟

167
00:12:15,860 --> 00:12:20,460
في العادة، يتمّ إعداد التّارت
.بوضع الفواكه على القشرة وخبزها

168
00:12:20,460 --> 00:12:24,150
،ولكن في أحد الأيّام
،نسيتا وضع القشرة في الوعاء

169
00:12:24,150 --> 00:12:26,680
.وانتهى بهما المطاف بخبز الفاكهة فقط

170
00:12:27,440 --> 00:12:28,350
،لم يكن لديهما خيار آخر

171
00:12:28,350 --> 00:12:31,670
فوضعت الأختان عجينة القشرة فوق
.الفاكهة شبه المخبوزة وتركاها تكمل الخَبز

172
00:12:33,080 --> 00:12:36,350
.وكانت هذه التّارت تاتان هي النّتيجة

173
00:12:36,350 --> 00:12:38,070
هذا هو أصلها؟

174
00:12:38,070 --> 00:12:43,270
بتعبير آخر، حصلتا على التّارت تاتان
.عندما فشلتا في إعداد التّارت

175
00:12:46,290 --> 00:12:48,330
فشل؟

176
00:12:50,690 --> 00:12:55,850
لكن أعتقد أنّ هذه التّحلية
.شيء رائع وأعجوبيّ

177
00:12:56,920 --> 00:12:58,040
أعجوبيّ؟

178
00:12:58,370 --> 00:13:00,970
لو أقدمت الأختان تاتان بعد إدراك فشلهما

179
00:13:00,970 --> 00:13:04,550
،على رمي الفاكهة والبدء من جديد

180
00:13:04,970 --> 00:13:07,160
.ما كنّا لنحصل على تحلية تارت تاتان

181
00:13:08,880 --> 00:13:11,790
...تحلية كان ليرميها أيّ أحد آخر

182
00:13:11,790 --> 00:13:16,370
لكن لأنّ الأختان تاتان رفضتا
،السّماح للفشل أن يسود

183
00:13:16,370 --> 00:13:18,980
.صار بإمكاننا الاستمتاع بلذّتها الآن

184
00:13:19,610 --> 00:13:23,440
رفضتا... السّماح للفشل أن يسود؟

185
00:13:23,840 --> 00:13:27,010
،في كلّ مرّة أفشل في إعداد حلوى ما

186
00:13:27,010 --> 00:13:29,530
.أفكّر في قصّة التّارت تاتان

187
00:13:29,780 --> 00:13:32,120
.الفشل ليس خسارة أبدًا

188
00:13:32,600 --> 00:13:35,030
،الجزء الأهمّ هو أنّه رغم الفشل

189
00:13:35,030 --> 00:13:37,600
.عليك مواصلة التّطلّع للأمام والعمل بجدّ

190
00:13:38,520 --> 00:13:42,130
!الفشل ليس مقبولاً بصفتك وريث عائلة كادليتشيك

191
00:13:43,210 --> 00:13:44,800
!لا تظهر أيّ ضعف على الإطلاق

192
00:13:45,210 --> 00:13:47,810
!تذكّر أنّك قائد

193
00:13:48,440 --> 00:13:53,130
.لكن... فشلي ليس مثل فشل بقيّة النّاس

194
00:13:53,860 --> 00:13:56,500
!لم تفشل يا سيّد سكوال

195
00:13:57,640 --> 00:13:59,310
هل نسيت؟

196
00:13:59,310 --> 00:14:03,360
...ما قلتُه لك قبل رحيلك

197
00:14:04,740 --> 00:14:07,800
!عد سالمًا رجاءً

198
00:14:09,630 --> 00:14:13,460
.حافظت على وعدك

199
00:14:13,460 --> 00:14:17,850
لكن... سبب عودتي سالمًا

200
00:14:17,850 --> 00:14:20,040
.هو بفضل تضحيات الجنود الّذين كنت أقودهم

201
00:14:20,040 --> 00:14:23,750
.أشعر بالأسى حيالهم

202
00:14:23,750 --> 00:14:28,970
أليس هذا ما على القائد أن يشعر به؟

203
00:14:29,730 --> 00:14:32,930
،بدل الاحتفال بنصر حملتك الأولى

204
00:14:33,490 --> 00:14:36,640
.أنت تفكّر في الرّجال الّذين ماتوا من أجلك

205
00:14:37,390 --> 00:14:42,400
.أنا فخورة بك على تواضعك هذا

206
00:14:43,460 --> 00:14:44,830
...آنسة بيترا

207
00:14:46,540 --> 00:14:52,410
.لا يوجد ما يسعدني أكثر من عودتك سالمًا

208
00:15:02,110 --> 00:15:04,210
.شكرًا لك يا آنسة بيترا

209
00:15:07,480 --> 00:15:09,670
.شكرًا لك يا سيّد بيستري

210
00:15:10,010 --> 00:15:13,140
.سأصير رجلاً أقوى

211
00:15:13,910 --> 00:15:15,700
.لن أدع هذا الفشل يضيع هباءً

212
00:15:16,890 --> 00:15:18,460
...سيّد سكوال

213
00:15:20,410 --> 00:15:23,970
هل تعتقد... أنّ بإمكاني أخذ قطعة أخرى؟

214
00:15:23,970 --> 00:15:25,050
!بالطّبع

215
00:15:26,030 --> 00:15:30,720
آنسة بيترا، هل تودّين الاستمتاع بهذا
معي في الجانب المشمس من الحديقة؟

216
00:15:31,160 --> 00:15:32,000
.نعم

217
00:15:34,390 --> 00:15:36,790
.يبدو أنّ معنويّاته ارتفعت ثانية

218
00:15:36,790 --> 00:15:37,760
!أجل

219
00:15:38,970 --> 00:15:43,270
.إنّ صدمة الحملة الأولى أمر عليك تجاوزه وحدك

220
00:15:43,270 --> 00:15:46,960
.مررت بنفس الشّيء في شبابي

221
00:15:46,960 --> 00:15:48,510
.نعم، هذا صحيح

222
00:15:48,510 --> 00:15:51,720
!عانيتُ الكثير من المصاعب في شبابي أيضًا

223
00:15:51,720 --> 00:15:53,280
...يا إلهي

224
00:15:53,280 --> 00:15:57,560
.ولكن يا سيّد بيستري، عليّ أن أشكرك أيضًا

225
00:15:57,860 --> 00:16:01,030
!إن كان هناك أيّ شيء تتمنّاه، فأسمعني إيّاه

226
00:16:01,030 --> 00:16:03,020
!أيّ شيء؟

227
00:16:03,020 --> 00:16:05,130
...لكنّ ما أريده

228
00:16:05,130 --> 00:16:09,010
...ما احتاجه لبناء أرض الحلوى خاصّتي

229
00:16:11,370 --> 00:16:14,200
!يا صاحب السّعادة، هناك شيء أريده بشدّة

230
00:16:21,770 --> 00:16:24,000
!مرحبًا بعودتك يا بيس

231
00:16:24,000 --> 00:16:25,800
!لقد عدت

232
00:16:26,410 --> 00:16:28,160
!انظري لكلّ هذه الأغراض

233
00:16:28,160 --> 00:16:29,710
هل صاروا تجّارًا الآن؟

234
00:16:30,080 --> 00:16:32,920
.إنّها عربون امتنان من السّيّد هوباريك

235
00:16:32,920 --> 00:16:34,680
!أنا مسرورة لأنّك بخير

236
00:16:35,010 --> 00:16:37,600
!أعطاني والدك هذه الرّسالة لك أيضًا

237
00:16:38,070 --> 00:16:39,050
!أجل

238
00:16:39,420 --> 00:16:40,960
!شكرًا جزيلاً لك

239
00:16:42,640 --> 00:16:45,190
نخوض المفاوضات لصالحنا"؟"

240
00:16:45,430 --> 00:16:49,520
ألهذا السّبب بقي القائد في المارغريفيّة؟

241
00:16:49,520 --> 00:16:50,300
.نعم

242
00:16:51,220 --> 00:16:56,850
!سأجعل البارون لونزفاج يدفع ثمن أخذه لما هو لي

243
00:16:56,850 --> 00:16:59,960
.بدا متحمّسًا كثيرًا

244
00:16:59,960 --> 00:17:02,620
هذا الشّبل من ذاك الأسد، صحيح؟

245
00:17:02,620 --> 00:17:08,910
فقبل كلّ شيء، بدأ كلّ هذا بسبب شراء البارون لماعزي

246
00:17:08,910 --> 00:17:11,840
!بينما يدّعي أنّه بحاجة لمؤن الحرب

247
00:17:12,140 --> 00:17:15,490
واثق أنّه لن يشتكي إن اشترينا كلّ الموادّ والماشية

248
00:17:15,490 --> 00:17:17,510
!الّتي كان سيحصل عليها في المقابل

249
00:17:17,960 --> 00:17:19,300
شرائها؟

250
00:17:19,660 --> 00:17:24,010
قبل كلّ شيء، كانت مساهمة مورتلن
،هي الأكبر في الحملة

251
00:17:24,010 --> 00:17:27,830
لذلك فالسّماح للأمر بالمرور مرور
الكرام بضعف ما أخذه منّا

252
00:17:27,830 --> 00:17:30,460
.سيساعدنا في المفاوضات

253
00:17:32,560 --> 00:17:34,890
!يا له من تعبير مخيف

254
00:17:34,890 --> 00:17:37,060
—بالطّبع الأمر منوط بأبي

255
00:17:37,060 --> 00:17:38,740
.انتهت المفاوضات

256
00:17:38,970 --> 00:17:39,890
!أبي

257
00:17:39,890 --> 00:17:40,450
بهذه السّرعة؟

258
00:17:40,800 --> 00:17:41,470
.هيّا

259
00:17:42,170 --> 00:17:43,430
.سنعود في الحال

260
00:17:43,430 --> 00:17:45,370
!ماذا؟ لماذا؟

261
00:17:45,740 --> 00:17:48,340
.سيأخذ الأمر وقتًا طويلاً بانتقالي وحدي

262
00:17:48,650 --> 00:17:51,680
سيكون أسرع إن نسخت سحري
.وساعدت في حمل كلّ شيء

263
00:17:52,000 --> 00:17:54,130
هـ-هل هناك الكثير لهذا الحدّ؟

264
00:17:54,130 --> 00:17:56,670
ما كانت نتيجة المفاوضات؟

265
00:18:03,670 --> 00:18:05,480
...ما-ما

266
00:18:05,780 --> 00:18:07,940
!ما كلّ هذا؟

267
00:18:08,520 --> 00:18:12,380
!أيّها القائد! هذا كثير جدًّا

268
00:18:12,380 --> 00:18:13,900
!انتظر لهذه الخيول الرّائعة

269
00:18:13,900 --> 00:18:17,530
،كانت تخضع للفصل قبل أن يتمّ شحنها

270
00:18:17,530 --> 00:18:22,380
لكنّي أصررت على بيعها لنا
.قبل أن تُمنح للبارون لونزفاج

271
00:18:22,380 --> 00:18:24,080
العين بالعين؟

272
00:18:24,440 --> 00:18:27,930
يبدو أنّ البارون دفع الكثير من المال مقدّمًا

273
00:18:27,930 --> 00:18:30,540
.لتُربّى مذ كانت مهورًا

274
00:18:30,760 --> 00:18:34,260
...لكنّ أخذها من طرف نبيل متدنّي المستوى

275
00:18:34,260 --> 00:18:37,790
.سيجعله ذلك يتلوّى من الإحباط

276
00:18:37,790 --> 00:18:42,070
.أيّها القائد، يبدو وجهك مخيفًا أكثر من وجه الفتى

277
00:18:44,320 --> 00:18:47,890
ماذا؟ أهذه هي الّتي تُستعمل للنّبيذ؟

278
00:18:47,890 --> 00:18:49,730
العصّارة؟

279
00:18:50,190 --> 00:18:52,560
،كلّما أدرنا هذا المقبض

280
00:18:52,780 --> 00:18:54,600
،يتمّ سحق المزيد من الفاكهة بالدّاخل

281
00:18:54,600 --> 00:18:56,650
.وسينتج هكذا عصير أكثر

282
00:18:57,840 --> 00:18:59,530
!لنجرّبها

283
00:19:12,960 --> 00:19:15,240
أمّي؟ هل ناديتني؟

284
00:19:15,240 --> 00:19:19,370
!عليك الذّهاب إلى العاصمة الملكيّة مع كاسرول

285
00:19:19,370 --> 00:19:20,430
العاصمة؟

286
00:19:20,430 --> 00:19:21,600
،في الحقيقة

287
00:19:21,600 --> 00:19:24,290
كانت رسالة أبي دعوة

288
00:19:24,290 --> 00:19:28,390
.لبيترا ولي إلى العاصمة في نهاية الصّيف

289
00:19:28,390 --> 00:19:32,600
،لكنّي لم أستطع اختيار ماذا أرتدي
...لذلك أردت رأي الجميع

290
00:19:32,600 --> 00:19:36,870
لذلك جمعنا كلّ الملابس الّتي
...في المنزل، لكن

291
00:19:36,870 --> 00:19:39,820
!لا تبدو أيّ واحدة منها مناسبة

292
00:19:41,300 --> 00:19:44,690
،اعتقد أنّه سيكون علينا تحضير لباس جديد

293
00:19:44,690 --> 00:19:48,770
لكن لا يوجدّ خيّاطون في إقطاعيّتنا
!ماهرون كفاية لخياطة ملابس نبيلة

294
00:19:48,770 --> 00:19:51,070
لذلك تردن خيّاطين من العاصمة؟

295
00:19:51,420 --> 00:19:54,880
.نريدك أن تطلب فستانًا بمقاس ليكوريش

296
00:19:54,880 --> 00:19:57,130
،إن استطعنا الحصول على التّصميم الأساسيّ

297
00:19:57,130 --> 00:19:59,380
.بإمكاننا تزيينه كما نشاء هنا

298
00:19:59,380 --> 00:20:02,090
ألا يستطيع أبي تولّي ذلك الأمر؟

299
00:20:02,090 --> 00:20:03,260
!بالطّبع لا

300
00:20:03,260 --> 00:20:07,730
!لا تريد ليكوريش أن يعرف الرّجال مقاسها

301
00:20:07,730 --> 00:20:09,450
...لكنّ رجل أيضًا

302
00:20:09,450 --> 00:20:11,810
!اخرس! أنت مسموح لك لأنّك خطيبها

303
00:20:12,070 --> 00:20:14,040
صحيح يا عزيزتي ليكوريش؟

304
00:20:14,430 --> 00:20:17,510
.لا بأس إن كان... بيس

305
00:20:17,510 --> 00:20:19,030
!يا إلهي

306
00:20:20,400 --> 00:20:22,590
!حـ-حسنًا

307
00:20:22,590 --> 00:20:24,410
...إنّها خطيبتي في نهاية المطاف

308
00:20:24,410 --> 00:20:26,490
!هذا صحيح

309
00:22:04,700 --> 00:22:07,390
أبي، هل أنت على ما يرام؟

310
00:22:08,010 --> 00:22:10,990
.مرّ شهر على وصولي إلى مورتلن

311
00:22:11,720 --> 00:22:13,970
هل تخبز شيئًا ما؟

312
00:22:14,440 --> 00:22:16,930
.إنّه ما كنتِ بانتظاره

313
00:22:19,750 --> 00:22:21,600
!الرّائحة رائعة

314
00:22:21,600 --> 00:22:24,610
.إنّه كعكة جبن من حليب الماعز

315
00:22:25,330 --> 00:22:26,590
!فعلاً؟

316
00:22:27,140 --> 00:22:31,130
!الحلويّات الّتي يعدّها بيس كالسّحر

317
00:22:34,450 --> 00:22:35,710
!هيّا

318
00:22:36,480 --> 00:22:37,750
!أختي

319
00:22:37,750 --> 00:22:39,840
!الجميع في انتظارك

320
00:22:40,300 --> 00:22:41,740
بيس؟

321
00:22:41,740 --> 00:22:43,470
.يا لك من شقيّ

322
00:22:43,470 --> 00:22:45,360
!أستطيع أكل الكعك هنا

323
00:22:45,360 --> 00:22:46,650
—احضره إلى هـ

324
00:22:46,650 --> 00:22:48,720
!لا، لا! ليكو؟

325
00:22:48,720 --> 00:22:50,690
!منذ متى وأنت هنا؟

326
00:22:50,690 --> 00:22:52,650
.مذ كنتِ نائمة

327
00:22:55,290 --> 00:22:57,890
.يعاملني الجميع بلطف هنا

328
00:22:58,550 --> 00:23:00,820
.أستمتع بوقتي كلّ يوم

329
00:23:01,670 --> 00:23:03,050
.مع حبّي، ليكوريش

330
00:23:03,750 --> 00:23:06,560
!سرّني هذا، لكنّي أفتقدها

331
00:23:08,400 --> 00:23:10,880
بيس، ماذا ستعدّ اليوم؟

332
00:23:14,010 --> 00:23:15,910
!يبدو هذا لذيذًا

333
00:23:18,360 --> 00:23:19,030
!نعم