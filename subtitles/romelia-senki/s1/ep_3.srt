1
00:00:17,830 --> 00:00:19,730
!سـ-سيّدتي

2
00:00:21,450 --> 00:00:23,520
.أستطيع الاهتمام بحصانكِ

3
00:00:23,520 --> 00:00:24,880
.شكرًا يا راي

4
00:00:25,210 --> 00:00:27,290
.لكنّني أريد فعل هذا بنفسي

5
00:00:27,290 --> 00:00:28,260
...لكن

6
00:00:34,330 --> 00:00:35,390
أمن خطب ما؟

7
00:00:36,450 --> 00:00:40,340
لا، خطر ببالي أنّك بارعة
...في التعامل مع ذلك الحصان

8
00:00:40,560 --> 00:00:43,380
تعلّمتُ الكثير أثناء
.ترحالي مع الأمير

9
00:00:43,380 --> 00:00:46,070
.أستطيع قيادة عربة إن اقتضت الحاجة

10
00:00:46,070 --> 00:00:48,030
حـ-حقًا؟

11
00:00:48,030 --> 00:00:51,480
كنتُ أقود أحيانًا زلّاجة تجرّها
.الكلاب في المناطق الثلجية

12
00:00:51,480 --> 00:00:52,860
قدتِ زلّاجة أيضًا؟

13
00:00:53,190 --> 00:00:57,040
يبدو أنّكما معتادان على
.التعامل مع الخيول أيضًا

14
00:00:57,400 --> 00:00:59,950
كان لدينا حصان في المزرعة
.بالوطن وبه تعلّمت

15
00:00:59,950 --> 00:01:01,460
أكان لديكم حصان أيضًا يا راي؟

16
00:01:01,460 --> 00:01:03,660
...أنا... في الواقع

17
00:01:03,980 --> 00:01:06,990
...نشأتُ في ميتم تابع للكنيسة

18
00:01:06,990 --> 00:01:10,080
تجيد القراءة والكتابة إذًا؟

19
00:01:10,080 --> 00:01:14,450
...نعم، وكان الكاهن ملمًا بالطب أيضًا

20
00:01:14,450 --> 00:01:18,320
،لذا عندما يمرض أحد في القرية
.كنتُ أركب الحصان لاستدعاء الكاهن

21
00:01:18,320 --> 00:01:19,480
.فهمت

22
00:01:19,770 --> 00:01:21,550
.هذا رائع

23
00:01:22,360 --> 00:01:25,870
...لا، كلّ ما فعلته هو ركوب الحصان

24
00:01:25,870 --> 00:01:28,260
لِم كلّ هذا التواضع؟

25
00:01:28,700 --> 00:01:32,460
تعلّمتَ ركوب الخيل والقراءة والكتابة

26
00:01:32,460 --> 00:01:35,020
كي تستطيع مساعدة النّاس، صحيح؟

27
00:01:35,370 --> 00:01:38,980
استطعتَ استخدام تلك المهارات
.لإنقاذ الآخرين

28
00:01:39,240 --> 00:01:41,270
.هذا أمر عظيم

29
00:01:44,100 --> 00:01:47,570
سنصلُ إلى وجهتنا بعد يوم
.آخر من السير نحو الجنوب

30
00:01:48,090 --> 00:01:49,990
.لنتأكد أنّنا مستعدون

31
00:01:49,990 --> 00:01:51,050
!نـ-نعم

32
00:01:51,710 --> 00:01:52,770
.حسنًا

33
00:03:43,290 --> 00:03:45,780
أولئك... شياطين دُنيا؟

34
00:03:45,780 --> 00:03:48,650
!عددهم كبير

35
00:03:48,940 --> 00:03:51,700
.تتجه القرود الشيطانية نحو الحصن

36
00:03:51,700 --> 00:03:54,260
.لعلّ مخزون الحبوب هو هدفهم

37
00:03:54,260 --> 00:03:57,280
أوقفوهم قبل أن يتمكّنوا
!من إسقاط الحصن

38
00:04:01,040 --> 00:04:02,420
!هيّا

39
00:04:02,720 --> 00:04:04,500
!لا تخافوا

40
00:04:04,500 --> 00:04:06,540
ماذا ترتدون؟

41
00:04:06,540 --> 00:04:08,300
ماذا تحملون؟

42
00:04:08,300 --> 00:04:12,230
أستفرّون خوفًا من تلك
القرود الصغيرة؟

43
00:04:12,540 --> 00:04:14,520
!هيّا بنا

44
00:04:18,780 --> 00:04:20,770
.سننقسم إلى ثلاث وحدات

45
00:04:20,980 --> 00:04:22,060
،كما خطّطنا

46
00:04:22,060 --> 00:04:24,230
ستتجه وحدة آل نحو الحصن
.من الجهة اليسرى

47
00:04:24,460 --> 00:04:27,220
أمّا راي، فسيتجه إلى اليمين
.ويهاجم من الجانب الآخر

48
00:04:27,220 --> 00:04:28,350
!حـ-حسنًا

49
00:04:28,350 --> 00:04:30,360
!لا تدعوا أحدًا منهم يفرّ

50
00:04:31,150 --> 00:04:32,900
!نحن سنهاجم من الأمام

51
00:04:33,340 --> 00:04:35,900
!هيّا بنا! اتبعوني

52
00:04:43,010 --> 00:04:44,770
ما بالكم واقفين دون حراك؟

53
00:04:44,770 --> 00:04:46,460
.اتبعوا السيّدة

54
00:04:46,460 --> 00:04:47,160
!حسنًا

55
00:04:47,160 --> 00:04:48,820
!هيّا بنا

56
00:04:58,460 --> 00:04:59,810
!براي! أوتو

57
00:05:00,280 --> 00:05:01,860
!تولّيا إجلاء السكان

58
00:05:01,860 --> 00:05:02,770
!أ-أمرك

59
00:05:02,770 --> 00:05:05,150
.مذهل... إنّها لا تخاف إطلاقًا

60
00:05:05,150 --> 00:05:06,030
.نعم

61
00:05:10,190 --> 00:05:12,910
..لـ-لكنّها ليست بارعة في استخدام ذلك السيف

62
00:05:12,910 --> 00:05:14,830
!اتبعوها

63
00:05:31,290 --> 00:05:33,000
!تمسّكي جيدًا

64
00:05:36,250 --> 00:05:37,640
!افتحوا البوابة

65
00:05:37,910 --> 00:05:39,180
من أنت؟

66
00:05:39,180 --> 00:05:40,770
!نحن من حصن كارولوس

67
00:05:40,770 --> 00:05:42,610
!أنا آل من حرس كاشو

68
00:05:43,000 --> 00:05:44,860
!سنحمي الحصن

69
00:05:44,860 --> 00:05:47,570
دعوا القرويين الذين لم يهربوا بعد
!يدخلون للحصن حين يصبح الوضع آمنًا

70
00:05:47,570 --> 00:05:49,030
!فـ-فهمت

71
00:05:49,030 --> 00:05:51,120
!افتحوا البوابة! افتحوا البوابة

72
00:05:54,420 --> 00:05:56,140
!من هنا! اتبعوني

73
00:05:57,780 --> 00:06:00,040
!لتُواجه كلّ الوحدات القرود الشيطانية

74
00:06:00,040 --> 00:06:02,440
!ستُباد القرية إن تراجعنا

75
00:06:02,440 --> 00:06:03,870
!احموهم مهما كلّف الأمر

76
00:06:04,130 --> 00:06:06,440
!لا تدعوا أحدهم يقترب

77
00:06:15,090 --> 00:06:17,230
.لكن يا لهُ من حريق مروّع

78
00:06:17,230 --> 00:06:18,900
هل أحرقوا قريتهم؟

79
00:06:19,430 --> 00:06:20,900
!يا راي

80
00:06:28,900 --> 00:06:31,500
!أيعقل أنّهم من أشعلوا الحريق؟

81
00:06:31,500 --> 00:06:33,000
!لم تُشعَل النّار لإبعاد القرود الشيطانية

82
00:06:33,000 --> 00:06:35,000
!بل يستخدمونها بأنفسهم

83
00:06:39,690 --> 00:06:41,010
!اهدأ

84
00:06:41,010 --> 00:06:42,480
!لا تخافوا من النيران

85
00:06:42,480 --> 00:06:44,970
!إن طالتكم النيران فأطفئوها فحسب

86
00:06:45,430 --> 00:06:47,790
!استخدموا دروعكم! اصطفّوا

87
00:06:48,440 --> 00:06:50,240
!تذكّروا تدريبكم

88
00:06:50,240 --> 00:06:51,930
!ساندوا بعضكم بعضًا

89
00:06:56,870 --> 00:06:57,970
!راي

90
00:06:58,650 --> 00:07:01,760
.كانت مهمتك قيادة هذه الوحدة

91
00:07:02,240 --> 00:07:04,410
...أ-أنا آسف

92
00:07:04,410 --> 00:07:05,490
.راغن. غران

93
00:07:05,720 --> 00:07:07,820
.سأعود إلى المركز

94
00:07:07,820 --> 00:07:09,800
.القيادة لكما

95
00:07:09,800 --> 00:07:11,060
.حـ-حسنًا

96
00:07:11,320 --> 00:07:15,110
.تعاونوا فيما بينكم
.لا تدعوا أحدًا منهم يفرّ

97
00:07:15,630 --> 00:07:16,990
!اصطفّوا

98
00:07:16,990 --> 00:07:19,320
!تقدّموا وأبيدوا القرود الشيطانية

99
00:07:19,320 --> 00:07:20,940
!سنلتقي في المركز

100
00:07:24,990 --> 00:07:26,150
!اللّعنة

101
00:07:34,690 --> 00:07:36,360
!لا تقاتل بمفردك

102
00:07:36,800 --> 00:07:39,680
!ابقوا معًا! واعرفوا أماكن رفاقكم

103
00:07:40,050 --> 00:07:43,030
.ستصل وحدة راي إلى هنا قريبًا

104
00:07:53,070 --> 00:07:55,540
...يظهرون بلا نهاية

105
00:07:55,930 --> 00:07:57,420
كم عددهم؟

106
00:07:58,070 --> 00:08:00,140
هل الجميع بخير؟

107
00:08:02,710 --> 00:08:03,490
ماذا؟

108
00:08:04,820 --> 00:08:05,720
!آل

109
00:08:09,700 --> 00:08:13,170
أنت القائد. لِم تقاتل
في الصفوف الأمامية؟

110
00:08:13,630 --> 00:08:15,380
.أحضر حصانك إلى هنا

111
00:08:16,130 --> 00:08:17,590
!استدرجوا القرود الشيطانية

112
00:08:17,590 --> 00:08:19,340
!انتشروا أمام الحصن

113
00:08:34,220 --> 00:08:35,570
سنستغل خفة خيولنا

114
00:08:35,570 --> 00:08:37,870
لتوجيه ما تبقّى من قرود
.شيطانية إلى حيث نريدهم

115
00:08:38,490 --> 00:08:43,020
أوهموهم بأنّهم يستطيعون الفتك
.برجالنا هناك

116
00:08:43,630 --> 00:08:48,290
.استدرجوهم إلى المركز، كما يفعل كلب الرعي

117
00:08:52,260 --> 00:08:53,340
!مذهل

118
00:08:53,340 --> 00:08:55,300
!إنّهم يندفعون مباشرة نحو رماحنا

119
00:08:55,300 --> 00:08:56,470
!يمكننا الفوز

120
00:08:56,730 --> 00:08:59,710
...هذه هي قوّة السيّدة روميليا إذًا

121
00:09:00,520 --> 00:09:03,850
.لا أملك القوّة اللازمة للقتال

122
00:09:04,580 --> 00:09:10,510
لكن لو منحني ربّي قوّة تحقّق
...لي النصر، لسبب لا أعلمه

123
00:09:11,610 --> 00:09:16,800
...حتّى لو لم تكن سوى حظٍ ضئيل

124
00:09:23,960 --> 00:09:27,510
.وسأجلب النحس والبؤس لأعدائي

125
00:09:29,280 --> 00:09:31,630
في اللّيلة التي سبقت انطلاقي
،في رحلتي مع الأمير

126
00:09:31,630 --> 00:09:35,310
.سمعتُ صوتًا مهيبًا ومُنحت قوّة

127
00:09:36,580 --> 00:09:39,310
".اسم تلك القوة هو "النعمة

128
00:09:39,910 --> 00:09:42,350
حتّى ملك الشياطين زيلغيس
.عجز عن مواجهتها

129
00:09:43,160 --> 00:09:46,070
.إنّها قوّة صغيرة لكنّها عظيمة الأثر

130
00:10:02,100 --> 00:10:03,440
.أيّها القائد آل

131
00:10:04,520 --> 00:10:06,180
.تولّ الأمور هنا

132
00:10:06,180 --> 00:10:08,750
تعاون مع الجميع للقضاء
.على بقية الشياطين الدنيا

133
00:10:08,750 --> 00:10:09,670
.حسنًا

134
00:10:09,670 --> 00:10:11,920
هل أستطيع الاستعانة براي؟

135
00:10:20,410 --> 00:10:23,810
.كما توقعت. رأيتُ أحدهم يفرّ فعلًا

136
00:10:23,810 --> 00:10:25,910
.سمحنا لأحدهم بالفرار

137
00:10:25,910 --> 00:10:29,400
.لـ-لا يبدو قويًا بما يكفي للقتال

138
00:10:29,960 --> 00:10:32,630
هل تحبّ الحيوانات يا راي؟

139
00:10:32,820 --> 00:10:34,350
...نـ-نعم، أظنّ ذلك

140
00:10:34,650 --> 00:10:36,040
.وأنا أحبّها أيضًا

141
00:10:41,100 --> 00:10:42,940
.إنّه صلب المراس

142
00:10:44,140 --> 00:10:45,780
.أجهز عليه يا راي

143
00:10:46,250 --> 00:10:48,620
.لـ-لسنا مُضطرّين إلى فعل هذا

144
00:10:48,620 --> 00:10:49,640
...لا يقوى حتّى على التحرّك

145
00:10:49,030 --> 00:10:50,380
.هذا شيطان أدنى

146
00:10:50,700 --> 00:10:55,850
أضرم النّار في القرية. التهم
.القرويين. وبثّ الرعب في نفوسهم

147
00:10:56,990 --> 00:11:01,690
لن أقبل في صفوفي جنديًا
.يعجزُ عن قتله أعدائه

148
00:11:03,560 --> 00:11:04,600
.أجهِز عليه

149
00:11:12,940 --> 00:11:14,520
.صوّب بدقة

150
00:11:17,060 --> 00:11:18,810
.اقتله بضربة واحدة

151
00:11:25,170 --> 00:11:27,190
!اللّعنة! اللّعنة! اللّعنة

152
00:11:30,800 --> 00:11:31,990
!فعلتُها

153
00:11:31,990 --> 00:11:33,360
.أحسنتَ

154
00:11:33,360 --> 00:11:35,010
.سنعود إلى الآخرين

155
00:11:53,330 --> 00:11:56,120
.أنقذ أيّ قرويين متبقين يا راي

156
00:11:56,120 --> 00:11:57,070
.حسنًا

157
00:11:57,070 --> 00:12:00,280
اقضِ على ما تبقّى من
.القرود الشيطانية يا آل

158
00:12:00,280 --> 00:12:01,280
.عُلم

159
00:12:01,280 --> 00:12:05,860
،غران، راغن، أوتو، تارث وزيزي
.ساعدوا آل على قتل من تبقّى منهم

160
00:12:05,860 --> 00:12:07,060
.عُلم

161
00:12:07,060 --> 00:12:11,850
أمّا بالنسبة للمتفرغين، فأطفئوا
.النيران واجمعوا الجثث

162
00:12:12,980 --> 00:12:15,850
تُحمّلنا السيّدة عملًا كثيرًا

163
00:12:15,850 --> 00:12:17,010
!حسنًا، هيّا بنا

164
00:12:17,010 --> 00:12:18,030
!حسنًا

165
00:12:20,480 --> 00:12:23,710
!أنا روميليا فون غراهام

166
00:12:23,710 --> 00:12:25,790
!أتينا لمساعدتكم

167
00:12:25,790 --> 00:12:29,440
سأتولى أنا وحرّاسي حماية
.كاشو من الآن فصاعدًا

168
00:12:29,440 --> 00:12:31,250
.يسعدنا لقاؤكم

169
00:12:33,730 --> 00:12:37,510
.شكرًا لكم على قدومكم لإنقاذنا

170
00:12:37,510 --> 00:12:40,190
كان معظم الرجال خارج القرية
،لتوصيل ضرائبنا

171
00:12:40,190 --> 00:12:43,230
.لذا بقيت القرية بلا دفاع

172
00:12:43,230 --> 00:12:46,830
،بصفتي رئيس القرية
.لا أجد الكلمات لشكركم

173
00:12:46,830 --> 00:12:49,270
.لا عليك، يسرني أنّكم بخير

174
00:12:49,270 --> 00:12:51,260
هل تخلّصتم من الوحوش المخيفة؟

175
00:12:55,000 --> 00:12:55,830
.نعم

176
00:12:55,830 --> 00:12:57,250
.لم يبقَ منهم أحد

177
00:13:02,640 --> 00:13:04,710
!شكرًا يا آنسة

178
00:13:09,510 --> 00:13:11,050
!يا سارا

179
00:13:11,420 --> 00:13:13,420
.سيّدتي روميليا

180
00:13:13,730 --> 00:13:18,360
ليس لدينا الكثير لكنّنا
نودّ أن نقدم لكم

181
00:13:18,360 --> 00:13:22,020
.وليمة متواضعة لاحقًا الليلة

182
00:13:22,020 --> 00:13:26,010
.لدينا بعض اللّحم والشراب

183
00:13:26,010 --> 00:13:27,570
.شكرًا جزيلًا

184
00:13:27,770 --> 00:13:30,020
.نقبل بكلّ سرور

185
00:13:30,430 --> 00:13:32,200
!بصحتكم

186
00:13:37,320 --> 00:13:38,770
!هذا رائع

187
00:13:41,840 --> 00:13:43,290
!حسنًا يا جماعة

188
00:13:43,290 --> 00:13:46,370
...بخصوص مكافأتكم على هذه المهمة

189
00:13:46,960 --> 00:13:51,800
ستُضاف قطعة فضية إلى
.أجركم المعتاد جميعًا

190
00:13:54,480 --> 00:13:55,730
...أمّا آل

191
00:14:02,060 --> 00:14:06,440
.وتقديرًا لذلك، سأمنحك قطعتين فضيتين

192
00:14:08,350 --> 00:14:11,630
.شـ-شكرًا جزيلًا

193
00:14:14,490 --> 00:14:15,630
!يا رفاق

194
00:14:15,630 --> 00:14:19,000
تريدون جميعًا بعض اللّحم الشهي، صحيح؟

195
00:14:20,280 --> 00:14:23,030
!أحضر لنا خروفًا آخر يا زعيم

196
00:14:23,310 --> 00:14:25,010
!اشوِه لنا على سيخ

197
00:14:28,300 --> 00:14:31,320
.أرجو أن تشاركينا الطعام أيضًا

198
00:14:31,900 --> 00:14:33,130
ألا بأس؟

199
00:14:33,130 --> 00:14:34,090
.نعم

200
00:14:34,350 --> 00:14:36,970
غطّاكِ الطين، الرماد، ودماء أعدائك

201
00:14:36,970 --> 00:14:39,180
.وأنتِ تقاتلين إلى جانبنا

202
00:14:39,180 --> 00:14:40,820
.سأقبل دعوتك إذًا

203
00:14:40,820 --> 00:14:44,270
.أحسنتم القتال جميعًا اليوم

204
00:14:44,630 --> 00:14:47,280
،لكن رغم انتهاء معركة اليوم

205
00:14:47,600 --> 00:14:50,270
.تنتظرنا القرية التالية

206
00:14:50,640 --> 00:14:54,840
،سنجدُ هناك مزيدًا من الشياطين
.تذيق النّاس العذاب

207
00:14:55,390 --> 00:15:00,630
لكنّنا لن نتوقف حتّى نقضي
.على كلّ شيطان في كاشو

208
00:15:00,960 --> 00:15:03,450
.أعلم أنّكم قادرون على ذلك

209
00:15:05,810 --> 00:15:08,880
!نخب السيّدة روميليا

210
00:15:08,880 --> 00:15:10,930
!بصحتكم

211
00:15:28,360 --> 00:15:31,690
!هذا شهي
!إنّه لذيذ عندما يكون مطهوًا للتو

212
00:15:31,690 --> 00:15:34,220
إنّه مختلف عن اللحم المجفف
!الذي اعتدنا أكله

213
00:15:34,220 --> 00:15:35,810
ما الخطب؟

214
00:15:35,810 --> 00:15:37,500
!هذا اللّحم لذيذ

215
00:15:37,500 --> 00:15:40,360
.آسف. ليست لديّ شهية

216
00:15:40,740 --> 00:15:41,870
.يمكنك أكل حصّتي

217
00:15:41,870 --> 00:15:43,040
جديًا؟

218
00:15:43,040 --> 00:15:45,160
.سأخرج لاستنشاق بعض الهواء النقي

219
00:15:45,160 --> 00:15:48,190
ما الأمر يا راي؟
هل أفرطت في الشرب؟

220
00:15:48,500 --> 00:15:49,510
.نعم

221
00:15:49,510 --> 00:15:52,030
أتُرى معدته مضطربة؟

222
00:15:52,030 --> 00:15:55,190
!حسنًا إذًا... سآخذ هذا اللّحم

223
00:15:55,660 --> 00:15:57,340
ماذا تفعل يا أوتو؟

224
00:15:57,540 --> 00:15:59,260
!هذه حصّة راي

225
00:15:59,990 --> 00:16:03,770
!لا تكن بخيلًا هكذا

226
00:16:13,230 --> 00:16:16,070
...انظروا! يا لجمال الأميرة إليزابيث

227
00:16:16,070 --> 00:16:18,340
!يا لها من رقّة ونبل

228
00:16:18,340 --> 00:16:21,360
!إنّها تستحق حقًا لقب القديسة

229
00:16:21,360 --> 00:16:26,090
أنا متأكدة أنَّها ستجعل مملكة
.ليونيل مكانًا جميلًا

230
00:16:26,090 --> 00:16:31,290
لا توجد فتاة أنسب منها
!لخطبة الأمير هنري

231
00:16:31,290 --> 00:16:33,560
.لا يزال الأمير يقاتل الشياطين

232
00:16:33,560 --> 00:16:36,780
.سمعتُ أنّهم مُنيوا بهزيمة ساحقة في الشمال

233
00:16:36,780 --> 00:16:38,530
،بفضل جهودهما معًا

234
00:16:38,530 --> 00:16:42,550
ستخلو قارة أكسيس من الشياطين
!إلى الأبد قريبًا

235
00:16:42,550 --> 00:16:48,060
عندها، ستفرض ليونيل سيطرتها
!على الممالك المجاورة بلا شك

236
00:16:48,060 --> 00:16:49,590
!أيتها الأميرة إليزابيث

237
00:16:49,590 --> 00:16:52,320
عندما تُطرَد الشياطين من روبان

238
00:16:52,320 --> 00:16:55,410
أرجو أن تساعدي أسرتي، آل
!بارياتيف على إعادة البناء

239
00:16:55,410 --> 00:16:58,440
نحن أسرة إسكوك، أصحاب
إيمان وجديرون بمهمة

240
00:16:58,440 --> 00:17:01,610
!نشر تعاليم كنيسة الخلاص

241
00:17:01,610 --> 00:17:04,900
.نحن آل بولوراه لن نجلب العار على أنفسنا

242
00:17:04,900 --> 00:17:07,560
.اسمحوا لنا بمساعدة الأسرة الملكية رجاء

243
00:17:07,560 --> 00:17:09,190
.شكرًا جزيلًا

244
00:17:09,470 --> 00:17:11,510
،عندما يعود الأمير من الحرب

245
00:17:11,510 --> 00:17:13,830
.سأتحدث معهم

246
00:17:15,170 --> 00:17:17,320
!الأميرة إليزابيث نبيلة وجميلة

247
00:17:22,090 --> 00:17:23,550
.أيتها الأميرة إليزابيث

248
00:17:37,680 --> 00:17:39,370
.إليزابيث

249
00:17:40,730 --> 00:17:42,600
كيف أستطيع مساعدتك؟

250
00:17:42,950 --> 00:17:44,490
.أيّها الكاردينال فارمين

251
00:17:46,670 --> 00:17:47,500
...لا

252
00:17:47,910 --> 00:17:49,220
.بل أبي

253
00:17:50,280 --> 00:17:51,880
هل يوجد أحد بالقرب؟

254
00:17:52,170 --> 00:17:53,660
.المكان آمن

255
00:17:53,660 --> 00:17:55,700
.أخبرني بما تريده من فضلك

256
00:17:55,700 --> 00:18:00,540
أُرسِل المعالج الخاص بالملك
.إلى الأمير هنري

257
00:18:01,130 --> 00:18:04,380
هل تتحسّن حالة الملك؟

258
00:18:04,680 --> 00:18:07,140
هل نسيتِ يا إليزابيث؟

259
00:18:07,140 --> 00:18:13,150
!هدفنا هو حكم مملكة ليونيل

260
00:18:13,350 --> 00:18:15,530
،أثناء غياب الأمير

261
00:18:15,530 --> 00:18:18,990
عليكِ أن تكوني الأميرة الجميلة
.التي ترعى الملك

262
00:18:18,990 --> 00:18:21,790
،لكن إن غاب مُعالج الملك

263
00:18:21,790 --> 00:18:23,960
.فلا بدّ أن يلاحظ أنّ هناك أمرًا مريبًا

264
00:18:23,960 --> 00:18:27,740
أخبرته أنَّ أيّ مكروه قد يصيب ابنه
،وهو في صفوف القتال الأمامية

265
00:18:27,740 --> 00:18:30,110
.سيعرّض المملكة نفسها للخطر

266
00:18:30,390 --> 00:18:33,920
.وأرسل المعالج بنفسه

267
00:18:34,390 --> 00:18:36,170
.رجل فظيع

268
00:18:36,420 --> 00:18:38,880
.لن أقدم على اغتياله

269
00:18:38,880 --> 00:18:40,660
.لا داعي لذلك

270
00:18:41,010 --> 00:18:45,020
.سيلقى حتفه قريبًا على أيّ حال

271
00:18:45,440 --> 00:18:48,270
.أعتمد عليك يا إليزابيث

272
00:18:48,810 --> 00:18:51,650
.يا ابنتي العزيزة

273
00:19:22,450 --> 00:19:23,860
!عددهم كبير

274
00:19:24,900 --> 00:19:26,870
!أرسلوا مبعوثًا إلى الملك فورًا

275
00:19:33,450 --> 00:19:35,010
.يا سيّد غاليوس

276
00:19:35,010 --> 00:19:37,550
.نعتذر عن استدعائك

277
00:19:37,550 --> 00:19:39,880
.الجنرال عالي ينتظرك

278
00:19:40,870 --> 00:19:43,280
.لا تكذب عليّ يا غامين

279
00:19:43,280 --> 00:19:46,780
لِم تتحدث بلغة البشر؟

280
00:19:46,780 --> 00:19:51,960
...لم أرد أن يسمعني الآخرون

281
00:19:51,960 --> 00:19:53,580
أتعني أمر أخي؟

282
00:19:53,580 --> 00:19:55,830
مات أخي فعلًا إذًا؟

283
00:19:55,830 --> 00:19:58,970
كنتَ تعلم بالفعل إذًا يا سيّدي؟

284
00:19:59,310 --> 00:20:01,620
،انقطع اتصالنا بالوطن أولًا

285
00:20:01,620 --> 00:20:03,660
،ثم عجزنا عن استخدام مجاذيف الشياطين

286
00:20:03,660 --> 00:20:05,490
.بعدها استدعيتني أنت

287
00:20:05,490 --> 00:20:10,280
ما التفسير الآخر لهذه
الأحداث سوى وفاة أخي؟

288
00:20:10,280 --> 00:20:12,310
.بالطبع يا سيّدي

289
00:20:12,310 --> 00:20:14,230
إذًا؟ من قتله؟

290
00:20:14,230 --> 00:20:16,490
أيعقل أنّك تريد الانتقام؟

291
00:20:16,920 --> 00:20:19,510
.بالطبع لا. فأنا لستُ عجوزًا

292
00:20:19,920 --> 00:20:21,660
...كلّ ما أريده هو قتال

293
00:20:21,660 --> 00:20:26,580
.الرجل الذي هزم أخي

294
00:20:26,920 --> 00:20:29,590
.لم يكن أخي خصمًا يُستهان به

295
00:20:29,590 --> 00:20:32,470
لم أكُن أعلم أنَّ لدى
!البشر شخصًا بتلك القوة

296
00:20:32,470 --> 00:20:34,330
ألن يكون ذلك ممتعًا؟

297
00:20:34,330 --> 00:20:38,930
.يبدو أنّ الفاعل موجود في ليونيل

298
00:20:38,930 --> 00:20:40,140
.فهمت

299
00:20:40,520 --> 00:20:43,100
لهذا استدعيتني إذًا يا غامين؟

300
00:20:44,830 --> 00:20:46,630
تعرف ما عليكَ فعله، صحيح؟

301
00:20:46,630 --> 00:20:49,220
.دعني أقاتله

302
00:20:49,990 --> 00:20:52,630
.مهما كلّف الأمر

303
00:21:00,420 --> 00:21:03,020
ما الخطب يا راي؟

304
00:21:09,650 --> 00:21:13,570
.بالغوا جميعًا في حماسهم بانتصار واحد

305
00:21:13,980 --> 00:21:17,150
.قد نواجه أعداء أشدّ قوّة قريبًا

306
00:21:17,800 --> 00:21:21,090
.لم أستطع حتّى قتل أحد منهم

307
00:21:22,190 --> 00:21:24,620
...ولاحظت السيّدة روميليا ذلك

308
00:21:25,450 --> 00:21:28,430
قالت أنّها لن تقبل
.شخصًا عديم الفائدة

309
00:21:28,890 --> 00:21:30,960
عليك أن تمتلكَ موهبة مثلي

310
00:21:30,960 --> 00:21:33,760
إن أردتَ تحقيق نجاح
.باهر في معركتك الأولى

311
00:21:34,390 --> 00:21:38,640
من الطّبيعي أن تشعر بالخوف في ساحة
.المعركة، وأن تعجز عن التحرك كعادتك

312
00:21:38,640 --> 00:21:40,460
...لكنّك

313
00:21:40,460 --> 00:21:43,640
تتدرّب باجتهاد دائمًا
...رغم ضعفك

314
00:21:44,200 --> 00:21:46,360
.ستصبح شخصًا مميزًا يومًا ما

315
00:21:48,320 --> 00:21:51,740
.لن أتركك خلفي

316
00:21:51,740 --> 00:21:54,350
.لذا... يمكنك أكل حصّتي

317
00:21:56,170 --> 00:21:58,870
.آسف... شكرًا

318
00:21:59,280 --> 00:22:02,120
.لا تبكِ يا أحمق