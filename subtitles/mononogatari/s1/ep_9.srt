1
00:00:03,220 --> 00:00:08,070
،هذا يشير إلى أنّهم هوجموا وعُذِّبوا
حتّى أصبحوا على شفير الموت فقط

2
00:00:09,100 --> 00:00:11,560
،سيكونون على قيد الحياة

3
00:00:11,560 --> 00:00:14,260
لكن غالباً لن يعملوا كساينومي ثانية

4
00:00:15,210 --> 00:00:16,150
!اللّعنة

5
00:00:17,290 --> 00:00:20,490
بقايا الدُّمى الّتي جُلِبَت كحُرّاس شخصيّين

6
00:00:20,490 --> 00:00:22,500
أحدهم قُطِع إلى نصفين

7
00:00:23,050 --> 00:00:25,040
والآخر حُرِق حتّى صار رماداً

8
00:00:25,040 --> 00:00:26,920
وآخر مُحطّم

9
00:00:27,840 --> 00:00:31,260
،سيكون هناك ثلاثة مهاجمين على الأقلّ

10
00:00:31,610 --> 00:00:33,740
ومجموعة تتلذّذ بالتّعذيب فوق ذلك

11
00:00:35,040 --> 00:00:36,090
...هل يُعقل

12
00:00:36,920 --> 00:00:41,020
إنّها السوغينبي

13
00:00:42,360 --> 00:00:45,020
مضى وقت منذ تقاتل أحد معنا

14
00:00:45,700 --> 00:00:48,810
لنبحث عنهم ونسحقهم

15
00:02:25,470 --> 00:02:27,180
...كُن حذراً

16
00:02:27,180 --> 00:02:30,250
!كُن حذراً على ألّا تتأذّى

17
00:02:30,250 --> 00:02:34,750
سئمتُ من عودتك إلى المنزل مليئاً بالجروح والكدمات

18
00:02:34,750 --> 00:02:36,120
حـ-حسناً

19
00:02:36,700 --> 00:02:39,010
—سأبذل جهدي أن أكون آمناً يا ناغاتسكي

20
00:02:41,520 --> 00:02:42,230
...بـ

21
00:02:43,520 --> 00:02:44,640
بوتان

22
00:02:45,730 --> 00:02:46,640
!نعم

23
00:02:48,760 --> 00:02:49,710
!عدائيّة؟

24
00:02:49,710 --> 00:02:50,570
!أنت

25
00:02:52,870 --> 00:02:56,110
!لا تشريف؟ استخدم "سان" على الأقلّ

26
00:02:56,110 --> 00:02:57,370
—لكن ناغا

27
00:02:58,060 --> 00:02:59,610
بوتان من أخبرتني أن أقول ذلك

28
00:02:59,610 --> 00:03:00,860
!من جديد؟

29
00:03:01,360 --> 00:03:02,670
هذا ليس بالأمر الجلل

30
00:03:02,670 --> 00:03:05,370
إنّه لا يستخدم "سان" مع اسم أيّ شخص آخر

31
00:03:05,690 --> 00:03:09,750
!فضلاً عن ذلك، يبدو وكأنّ ذلك التّدريب قد أثمر

32
00:03:12,040 --> 00:03:13,370
...بـ... بـ

33
00:03:13,370 --> 00:03:14,750
...بوت... بوتا

34
00:03:14,750 --> 00:03:16,710
!تكاد تصل! ابذل جهدك

35
00:03:19,400 --> 00:03:21,700
هل كان الأمر يستحقّ كلّ تلك الجهود حقّاً؟

36
00:03:25,010 --> 00:03:27,560
آمل أن يكونا بخير معاً

37
00:03:28,110 --> 00:03:30,200
أليس عليكم الانضمام لهما؟

38
00:03:30,750 --> 00:03:33,690
!لا، على عاتقنا واجب منزليّ اليوم

39
00:03:37,020 --> 00:03:38,430
...رغم ذلك

40
00:03:38,430 --> 00:03:42,300
أن يطلبوا ذلك ليس منّي فحسب، بل
...من عائلة ناغاتسكي أيضاً

41
00:03:42,810 --> 00:03:45,030
لا بدّ أنّ الخصم قويّ جدّاً

42
00:03:45,030 --> 00:03:49,040
"أجل، إنّها مجموعة تسوكوموغامي تُعرَف بـ"سوغينبي

43
00:03:49,620 --> 00:03:52,040
إحدى كبرى الجماعات في كيوتو

44
00:03:52,520 --> 00:03:54,200
،والجدير ذكره

45
00:03:54,200 --> 00:03:57,420
الأجسام المُضيفة لأعضائهم كلّها أدوات

46
00:03:57,420 --> 00:04:01,800
إعدام وتعذيب وأدوات أخرى تمثّل معاناة البشر

47
00:04:02,280 --> 00:04:07,540
قبل أربع سنوات، خاضَ السّاينومي
الخاصّين بكيوتو حرباً لإسقاطهم

48
00:04:08,860 --> 00:04:14,090
لا بدّ أنّ هذه الحادثة الأخيرة هي صنيع
ثلاثة من قادتهم النّاجين

49
00:04:15,190 --> 00:04:17,050
يبدون خطيرين للغاية

50
00:04:20,540 --> 00:04:23,710
هل أنتِ متأكّدة أنّنا لا نحتاج
لإحضار ناغي والآخرين؟

51
00:04:23,710 --> 00:04:28,080
أجل. كنّا جزءاً من الفريق الّذي أسقطهم في المرّة الماضية

52
00:04:28,950 --> 00:04:31,830
،إذا كانت غايتهم الانتقام

53
00:04:32,270 --> 00:04:35,900
فقد يحاولون أسر بوتان كرهينة

54
00:04:37,750 --> 00:04:41,930
كوشيغي، قد يكون من الأفضل توسيع حاجز القصر قليلاً

55
00:04:48,880 --> 00:04:49,880
هكذا إذاً

56
00:04:50,470 --> 00:04:54,650
أم... أنّك خائف من دونهم؟

57
00:04:54,650 --> 00:04:55,840
لا تكوني حمقاء

58
00:04:56,780 --> 00:05:00,110
نحن نواجه تسوكوموغامي يؤذون البشر

59
00:05:00,960 --> 00:05:04,870
أنا مسرور لأنّني لن أضطرّ للتحفّظ

60
00:05:11,920 --> 00:05:14,630
كان هذا مكان اللّقاء

61
00:05:14,630 --> 00:05:17,040
!هيوما-تشان

62
00:05:19,700 --> 00:05:20,750
—أنتِ

63
00:05:21,440 --> 00:05:22,760
!عرّفي عن نفسكِ

64
00:05:24,280 --> 00:05:25,760
كيف حالك؟

65
00:05:26,580 --> 00:05:29,260
!أنتِ... كادوموري تسوباكي

66
00:05:29,260 --> 00:05:31,050
!أصبت

67
00:05:31,050 --> 00:05:33,390
!يبدو أنّنا سنعمل معاً اليوم

68
00:05:34,640 --> 00:05:37,870
على أيّ حال، لماذا لم تُراسلني؟

69
00:05:37,870 --> 00:05:39,230
!انتظرتُ فترة طويلة جدّاً

70
00:05:39,520 --> 00:05:41,300
—كانت لديّ أسبابي

71
00:05:45,740 --> 00:05:49,600
تعرف امرأة في كلّ بلدة، أليس كذلك؟

72
00:05:49,600 --> 00:05:52,080
سأبلِغ بوتان

73
00:05:52,080 --> 00:05:53,330
!هذا غير صحيح

74
00:05:54,610 --> 00:05:56,810
آسفة للعبث معكِ هكذا

75
00:05:57,360 --> 00:05:59,450
يسرّني العمل معكِ يا يو

76
00:06:00,460 --> 00:06:02,000
تعرفان بعضكما الآخر؟

77
00:06:02,000 --> 00:06:03,550
بالطبع

78
00:06:03,550 --> 00:06:08,840
تفاجأتُ أكثر من رؤيتكما مُقرّبين هكذا

79
00:06:09,820 --> 00:06:14,510
بالطبع، تسوباكي هي المُرشّحة لتكون
مُمثّلة السّاينومي الخاصّين بكيوتو التّالية

80
00:06:14,510 --> 00:06:19,000
من صالح عائلة كوناتو أن تكونا مُقرّبين

81
00:06:19,000 --> 00:06:20,520
!أتمنّى لكما حياة رغيدة

82
00:06:20,810 --> 00:06:22,150
!الأمر ليس كذلك

83
00:06:22,150 --> 00:06:26,030
على سبيل المُصادفة، هي وأنا نحتسي
القهوة بين الحين والآخر

84
00:06:26,330 --> 00:06:29,260
يو تعشق القهوة، صحيح؟

85
00:06:29,680 --> 00:06:31,030
...أ-أجل

86
00:06:31,720 --> 00:06:33,880
أين السّاينومي الآخرون؟

87
00:06:33,880 --> 00:06:35,080
ليس في أيّ مكان

88
00:06:35,540 --> 00:06:37,540
ما تراه هو عين الحقيقة

89
00:06:37,950 --> 00:06:40,790
أنتم تخوضون مهمّتكم الخاصّة

90
00:06:41,150 --> 00:06:44,340
سوف نُرشدكم إلى وجهتكم

91
00:06:44,760 --> 00:06:47,690
ولمعلوماتكم فقط، الإرشاد هو كلّ ما ستحصلون عليه

92
00:06:47,690 --> 00:06:50,680
لا تتأمّلوا منّا المُشاركة في المعركة

93
00:06:50,680 --> 00:06:53,930
المُخبر... أوغي، أليس كذلك؟

94
00:06:54,360 --> 00:06:56,030
مرحباً يا صاح

95
00:06:56,030 --> 00:06:57,930
لم أرك منذ وقت

96
00:06:57,930 --> 00:07:00,690
لماذا نحن نخوض مهمّتنا الخاصّة؟

97
00:07:00,690 --> 00:07:03,150
التّمثيلي وفرقته الرّئيسيّة

98
00:07:03,530 --> 00:07:08,650
،في مكان حيث حدث ذلك الهُراء
يهيّئون شبكة رادار من الطلاسم

99
00:07:09,180 --> 00:07:13,740
حالما تكتمل، ستكون كلّ كيوتو
تحت أنظارهم ورقابتهم

100
00:07:14,660 --> 00:07:18,920
،في هذه الأثناء، ستؤدّون مهمّتكم

101
00:07:18,920 --> 00:07:22,370
تفتّشون الأماكن المُريبة الّتي سيختبئون فيها غالباً

102
00:07:23,010 --> 00:07:25,380
وهذا هو ما تعرفه أنت؟

103
00:07:25,380 --> 00:07:28,100
!أصبت! تستحقّ جائزة على ذلك

104
00:07:30,290 --> 00:07:31,900
...مخبأهم

105
00:07:32,510 --> 00:07:37,430
لا أرجّح استخدامهم له الآن بعد أن كشفوا نواياهم بالطبع

106
00:07:38,020 --> 00:07:42,020
لكن آمل فقط أن يكونوا قد تركوا طرف خيط ما

107
00:07:42,490 --> 00:07:43,900
انتظر لحظة

108
00:07:43,900 --> 00:07:46,520
أتقول لي أنّك اكتشفت مخبأهم للتو؟

109
00:07:47,040 --> 00:07:49,370
...أوغي، أنت

110
00:07:52,220 --> 00:07:53,510
!أنت مُبهر

111
00:07:56,110 --> 00:07:57,820
أوغي، أبليت بلاء حسناً

112
00:07:57,820 --> 00:07:59,160
...فـ-في الواقع

113
00:07:59,160 --> 00:08:02,350
هيوما-تشان لا يعرف شيئاً عن التّغاضي؟

114
00:08:02,350 --> 00:08:04,790
سيغضب غالباً إذا عَلِمَ

115
00:08:05,230 --> 00:08:11,300
التّغاضي... هو السّماح لتسوكوموغامي خارج
عن القانون بالهرب، إذا كان تحت الإشراف

116
00:08:12,050 --> 00:08:15,950
كان كادوموري قد منح "التّغاضي" لبقايا سوغينبي

117
00:08:15,950 --> 00:08:19,180
بينما استخدمَ أوغي وأوتشيكي
لتفقّدهم بين الحين والآخر

118
00:08:19,180 --> 00:08:23,440
هذا يسهّل تتبُّع تحرّكات المُجرمين الأصغر شأناً

119
00:08:23,440 --> 00:08:25,130
الّذين يأتون سعياً للحصول على موافقتهم

120
00:08:25,840 --> 00:08:28,280
"نترككم تتجوّلون بحرّية، بالمقابل لا تنقلبون علينا"

121
00:08:28,910 --> 00:08:31,560
كان السّوغينبي يعلمون أنّ هذا هو الأمثل لهم

122
00:08:32,690 --> 00:08:35,670
ظلّوا هادئين لسنوات في نهاية المطاف

123
00:08:36,370 --> 00:08:40,080
فلماذا يكسرون ذلك القانون الخفيّ الآن؟

124
00:08:41,240 --> 00:08:46,200
أصبحنا مُنتهكي القانون بحدّ ذاتنا في نظرهم على ما أفترض

125
00:08:46,880 --> 00:08:51,500
أنت تغدو نقطة خِلاف يا كوناتو هيوما

126
00:08:52,590 --> 00:08:55,590
عـ-على أيّ حال، هذا أبعد ما يمكنني الوصول إليه

127
00:08:55,590 --> 00:08:57,690
لنفترق عند هذه النّقطة

128
00:08:57,690 --> 00:09:00,440
لن نبقى هنا فترة أطول ممّا يلزم

129
00:09:00,440 --> 00:09:02,220
تعال يا أوتشيكي-كن

130
00:09:05,160 --> 00:09:05,940
!أوغي

131
00:09:05,940 --> 00:09:07,770
ماذا الآن؟

132
00:09:07,770 --> 00:09:09,190
—لا تحاول إيقافـ

133
00:09:17,260 --> 00:09:18,370
!إنّهم هنا؟

134
00:09:21,720 --> 00:09:25,290
واحد... اثنان... ثلاثة

135
00:09:25,640 --> 00:09:27,000
...حسناً، حسناً

136
00:09:27,000 --> 00:09:29,290
عددكم ليس كبيراً، صحيح؟

137
00:09:29,290 --> 00:09:32,970
!مهلاً. هناك اثنان منهم فقط

138
00:09:32,970 --> 00:09:34,220
ثلاثة

139
00:09:37,940 --> 00:09:39,660
...أجل، هكذا إذاً

140
00:09:39,660 --> 00:09:42,560
وضع كادوموري تايجو البلدة تحت الرّقابة؟

141
00:09:42,960 --> 00:09:44,960
...كم هذا مُثير للشفقة

142
00:09:44,960 --> 00:09:46,560
أقصدكم أنتم

143
00:09:50,060 --> 00:09:52,220
لذا قرّرنا الانتظار

144
00:09:53,070 --> 00:09:55,130
...ذلك السّاينومي في اللّيلة الماضية

145
00:09:55,130 --> 00:09:57,070
كان جنديّاً قويّاً

146
00:10:05,020 --> 00:10:08,710
لنرَ كم بوسعكم أن تتحمّلوا

147
00:10:16,970 --> 00:10:18,720
...مـ-مهلاً

148
00:10:18,720 --> 00:10:22,570
!كيف انتهى المطاف بمُحاصرتنا؟

149
00:10:26,920 --> 00:10:28,200
...سوغينبي

150
00:10:28,780 --> 00:10:31,850
ما الهدف من أذيّتكم البشر؟

151
00:10:33,270 --> 00:10:36,360
هل هاجمتُم أولئك السّاينومي بهدف الانتقام؟

152
00:10:36,810 --> 00:10:38,440
ما الهدف؟

153
00:10:38,860 --> 00:10:42,100
نفعل ذلك لنسبّب المُعاناة للبشر

154
00:10:42,770 --> 00:10:47,140
هذا ليس سوى مصيرنا بصفتنا نتّخذ
أدوات العِقاب كأجسام مُضيفة لنا

155
00:10:48,280 --> 00:10:49,420
هكذا إذاً

156
00:10:50,330 --> 00:10:52,560
،وعندما هاجمْنا السّاينومي

157
00:10:52,560 --> 00:10:55,880
كنّا نحوّلهم من عقبة إلى هدف، لا أكثر

158
00:10:56,420 --> 00:10:57,700
...هل أنتم

159
00:10:58,240 --> 00:11:00,890
أجل، فهمت

160
00:11:03,160 --> 00:11:04,550
!سأحطّمكم

161
00:11:04,910 --> 00:11:08,120
أعتقد أنّكم ترون الناغاتسكي كعقبة كذلك

162
00:11:08,120 --> 00:11:10,560
من صالحنا سحقكم الآن إذاً

163
00:11:10,560 --> 00:11:13,710
صادفَ وجود هيوما-تشان

164
00:11:13,710 --> 00:11:15,820
أعتقد عليّ أن أقدّم عرضاً جيّداً

165
00:11:16,340 --> 00:11:18,220
...المعذرة، إذاً

166
00:11:19,810 --> 00:11:21,570
أوتشيكي-كن؟

167
00:11:21,570 --> 00:11:24,570
هذا ليس يوماً جيّداً

168
00:11:25,160 --> 00:11:27,330
...مجموعة تسوكوموغامي، سوغينبي

169
00:11:31,060 --> 00:11:32,660
!فلترحلوا عن هذا العالم

170
00:11:39,880 --> 00:11:42,010
...قبضة الباب المؤدّي إلى الكوناتو

171
00:11:42,010 --> 00:11:44,180
...إنّه هو إذاً

172
00:11:45,010 --> 00:11:47,510
أرِني يا هيوما-تشان

173
00:11:47,920 --> 00:11:51,690
القوّة الّتي يتبجّح فيها كلّ من هاياتو-سان وكوسوي-سان

174
00:11:51,690 --> 00:11:54,470
...إذا أريتني هذا هنا

175
00:11:54,900 --> 00:11:59,370
فسأتأكّد بأنّك الشّخص الّذي كنتُ أنتظره

176
00:12:00,800 --> 00:12:03,640
أشعر وكأنّنا نُقحَم في هذه المعركة

177
00:12:03,640 --> 00:12:04,910
!هذا غير ممكن

178
00:12:07,400 --> 00:12:11,080
،سأضطرّ للتّظاهر بأنّني أساعد السّاينومي

179
00:12:11,080 --> 00:12:12,480
!ثمّ أتسلّل بعيداً في خِضمِّ الفوضى

180
00:12:12,480 --> 00:12:13,230
...حسناً

181
00:12:13,230 --> 00:12:13,830
!خُذ

182
00:12:14,610 --> 00:12:16,840
...ماذا؟ هل هذا

183
00:12:17,200 --> 00:12:18,840
!طلسم تحكّم؟

184
00:12:18,840 --> 00:12:21,550
!أتمنّى لك وقتاً طيّباً يا أوغي

185
00:12:22,450 --> 00:12:24,970
!مـ-مهلاً

186
00:12:24,970 --> 00:12:26,800
!أنتِ شرّيرة حقيقيّة

187
00:12:31,930 --> 00:12:33,850
!حان وقت اللّوذ بالفرار

188
00:12:35,300 --> 00:12:35,940
!مؤلم

189
00:12:48,570 --> 00:12:49,430
!تسوباكي

190
00:12:52,710 --> 00:12:56,790
سأواجهك بنفسي

191
00:13:13,040 --> 00:13:15,940
...ناغاتسكي، وكوناتو

192
00:13:16,320 --> 00:13:21,100
البشريّ الّذي انتهك القانون بالاقتراب
...من عائلة ناغاتسكي، كوناتو هيوما

193
00:13:22,210 --> 00:13:23,610
أنا مُمتنّ لك

194
00:13:24,400 --> 00:13:29,180
تصرّفاتك حرّرتنا من ذلك الالتزام السّخيف

195
00:13:29,180 --> 00:13:32,450
وسمحت لنا بالتصرّف

196
00:13:32,910 --> 00:13:34,580
كنتُ السّبب؟

197
00:13:37,960 --> 00:13:41,290
—هيوما، الآن ليس الوقت المناسب للتفكير في

198
00:13:44,840 --> 00:13:46,300
...إنّه

199
00:13:47,080 --> 00:13:49,550
لن أدع هذا الهُراء يُضلّلني

200
00:13:49,550 --> 00:13:51,810
!هاجميه بسرعة يا يو

201
00:13:52,520 --> 00:13:55,680
يا إلهي. كم هو أحمق

202
00:13:57,400 --> 00:13:59,670
لطفاً لا تأمرني

203
00:14:11,840 --> 00:14:13,880
ليسوا سوى مجرّد خدم

204
00:14:14,660 --> 00:14:16,780
...أومي، ماتسو

205
00:14:16,780 --> 00:14:18,360
دعهما لي

206
00:14:19,960 --> 00:14:22,010
!مهلاً لحظة يا شيموتو

207
00:14:22,010 --> 00:14:23,960
نحن صديقان، أليس كذلك؟

208
00:14:23,960 --> 00:14:27,240
فضلاً عن ذلك، نحن نفعل فقط ما تُمليه
!علينا طلاسم التحكّم

209
00:14:27,240 --> 00:14:28,720
!لسنا هنا للقتال حقّاً

210
00:14:29,040 --> 00:14:32,590
ماذا؟ لم أحبّكما يوماً

211
00:14:32,590 --> 00:14:36,100
...الطريقة التي تلهوان فيها، وتنفّذان مخطّطاتكما

212
00:14:37,710 --> 00:14:42,510
سمعتُم بدُمى كادوموري الّذين دمّرناهم في اللّيلة الماضية؟

213
00:14:42,510 --> 00:14:46,990
أنتما لا تختلفان عنهم من وجهة نظرنا

214
00:14:47,410 --> 00:14:50,740
هل تقصدين أنّنا دُمى؟

215
00:14:50,740 --> 00:14:53,990
!لا يمكنكما الإفلات من هذا

216
00:14:57,210 --> 00:14:59,290
...حسناً، اللّعنة

217
00:14:59,290 --> 00:15:01,710
أغاظني هذا الكلام

218
00:15:02,350 --> 00:15:04,490
لنفعلها يا أوتشيكي-كن

219
00:15:05,460 --> 00:15:08,600
...لا أريد أن أسمع عن الكبرياء

220
00:15:08,600 --> 00:15:11,230
!من مُنافق للبشر مثلك

221
00:15:11,230 --> 00:15:14,930
لا أريد سماع هذا الكلام من شخص
!حصل على "تغاضي" من البشر

222
00:15:45,750 --> 00:15:47,220
دمّر نفسه ذاتيّاً؟

223
00:15:47,640 --> 00:15:48,250
...لا

224
00:15:56,090 --> 00:15:56,810
!هيوما

225
00:16:01,620 --> 00:16:03,480
...دبّوس شعرك

226
00:16:03,880 --> 00:16:07,440
تختم أيّ شيء تصيبه في مكانه. خطيرة جدّاً

227
00:16:08,310 --> 00:16:11,400
لكن أجسامنا هي شكل مُفترَض بالفعل

228
00:16:11,900 --> 00:16:17,240
،إذا أعدنا تحويل أنفسنا حيث تُصيبنا
فليس من الصّعب تجنّبها

229
00:16:17,990 --> 00:16:20,600
الزمي مكانكِ لبعض الوقت فحسب

230
00:16:26,340 --> 00:16:28,380
الآن نأتي إليك

231
00:16:28,930 --> 00:16:31,400
في عينيك بعض الحيويّة

232
00:16:32,770 --> 00:16:37,300
أيّ شيء يعبر طريق "مقابض الباب" تلك يُمحى فوراً

233
00:16:38,050 --> 00:16:40,140
...أثر الكوناتو العتيق

234
00:16:40,140 --> 00:16:42,490
"مقابض الباب، "تشيبيكي-إيوا

235
00:16:42,830 --> 00:16:45,260
إذاً كانت الإشاعات صحيحة

236
00:16:47,110 --> 00:16:50,890
المقابض الفعليّة للباب المؤدّي إلى أرض الموتى

237
00:16:53,600 --> 00:16:55,360
الاحتكاك معهم

238
00:16:55,360 --> 00:16:57,700
هو خطوة لعبور ذلك الباب

239
00:16:58,180 --> 00:17:00,220
وذلك التغيّر في قانونهم الطبيعي

240
00:17:00,220 --> 00:17:03,000
يجعل الأشياء في عالم الأحياء تختفي

241
00:17:05,020 --> 00:17:06,850
مُرعب

242
00:17:06,850 --> 00:17:08,080
...لكن

243
00:17:08,080 --> 00:17:10,840
القدرة على استخدامها يعتمد على مهارة الحامل

244
00:17:11,180 --> 00:17:14,840
وإذا كانت ساقك بهذه الحالة، فإنّ
مرونتك الحركيّة انخفضت للنصف

245
00:17:15,360 --> 00:17:19,100
حان وقت تحقيق هدفي إذاً

246
00:17:19,880 --> 00:17:23,350
سأمزّقك إرباً، رويداً وبعناية

247
00:17:25,560 --> 00:17:27,740
حان وقت التّعذيب

248
00:17:27,740 --> 00:17:29,650
...اصرخ، ابكِ

249
00:17:50,590 --> 00:17:53,880
ثمّ افقد كلّ الأمل

250
00:18:00,680 --> 00:18:02,550
لا يمكنك الرّجوع، صحيح؟

251
00:18:06,110 --> 00:18:07,390
...مستحيل

252
00:18:07,920 --> 00:18:12,900
لا تتحمّل الخسارة في مكان
...كهذا وضدّ خصم كهذا

253
00:18:13,210 --> 00:18:18,660
لأنّ الشّيء الّذي يجب عليك تدميره أقوى بكثير

254
00:18:18,970 --> 00:18:21,660
رؤيتك تحمل مقابض الباب الّتي تركوها لك

255
00:18:21,930 --> 00:18:24,870
توضّح بأنّنا نركّز على الشّيء ذاته

256
00:18:25,300 --> 00:18:27,020
...أخيراً، التقينا

257
00:18:31,440 --> 00:18:33,960
يا من يبحث عن المِظلّة الورقيّة

258
00:18:38,270 --> 00:18:40,970
أهذا أفضل ما لديكم أيّها السّوغينبي؟

259
00:18:41,720 --> 00:18:43,970
يا زميلي

260
00:18:49,370 --> 00:18:50,520
...إنّها

261
00:18:51,880 --> 00:18:54,360
...فقط لأنّنا برتبة أقلّ

262
00:18:54,360 --> 00:18:56,230
!لا يعني أن تشيحي بنظركِ بعيداً

263
00:18:56,230 --> 00:18:57,340
—أنت

264
00:18:58,740 --> 00:19:01,610
!إلى اللّقاء يا شيموتو-سان

265
00:19:09,000 --> 00:19:10,860
!أحسنت صنعاً يا عزيزي

266
00:19:10,860 --> 00:19:13,320
نحفت قليلاً حسبما أرى

267
00:19:13,320 --> 00:19:15,750
كم طبقة قد بقي يا أوتشيكي-كن؟

268
00:19:18,010 --> 00:19:20,760
داهمنا الوقت على ما أعتقد

269
00:19:23,350 --> 00:19:26,120
،قد يكون الوقت قد حان للاستسلام

270
00:19:26,120 --> 00:19:27,770
يا سيّد هيكيكيري

271
00:19:32,260 --> 00:19:36,520
لدى أدوات التّعذيب هدف

272
00:19:39,500 --> 00:19:43,160
...تعلّمتُ خلال أربع سنوات من الصّمت الخانق

273
00:19:43,860 --> 00:19:48,600
!أنّ العيش بالنسبة لنا هو تمثيل هدفنا

274
00:19:48,600 --> 00:19:49,620
...هذا غير ممكن

275
00:19:49,620 --> 00:19:53,630
!لن أتوقّف! لن أتوقّف! لن أتوقّف

276
00:19:55,590 --> 00:19:58,130
،لتحقيق هدفي في الحياة

277
00:19:58,440 --> 00:20:00,280
...يجب عليكم جميعاً

278
00:20:00,720 --> 00:20:02,260
!أن تموتوا...

279
00:20:06,680 --> 00:20:09,060
...أ-أنت

280
00:20:14,880 --> 00:20:16,670
هل هي غاضبة؟

281
00:20:16,670 --> 00:20:18,320
...مهلاً

282
00:20:19,010 --> 00:20:20,570
...إنّ البناء

283
00:20:21,320 --> 00:20:23,070
...مـ-مستحيل

284
00:20:24,450 --> 00:20:27,580
!ربطت البناء بأكمله؟

285
00:20:27,580 --> 00:20:29,690
هذا شيء لم أكن أعرفه

286
00:20:29,690 --> 00:20:31,990
تصبحين مُخيفة عندما تغضبين يا يو

287
00:20:35,800 --> 00:20:38,090
اخرج من هنا. أنت جريح

288
00:20:40,400 --> 00:20:41,590
عُلِم

289
00:20:45,470 --> 00:20:48,810
!ابتعدوا عن طريقي أيّها الناغاتسكي

290
00:20:50,310 --> 00:20:53,600
!لا تستهن بي

291
00:20:53,600 --> 00:20:55,400
!هذا صحيح

292
00:20:55,710 --> 00:20:59,150
!فلتُدرِك وزن مِطرقة العدالة

293
00:20:59,420 --> 00:21:00,650
!ماذا تفعل؟

294
00:21:00,960 --> 00:21:02,900
!أنا أتّبع خطّتكِ يا يو

295
00:21:02,900 --> 00:21:04,140
—أنا لم

296
00:21:04,140 --> 00:21:06,700
!حـ-حسناً، افعل ما تشاء

297
00:21:14,200 --> 00:21:17,130
!كوناتو

298
00:21:23,960 --> 00:21:25,930
!يا للحماقة

299
00:21:33,070 --> 00:21:35,690
!تعاون مُبهر

300
00:21:39,190 --> 00:21:41,230
!لماذا فعلت ذلك بالضبط؟

301
00:21:41,230 --> 00:21:42,300
—لكن قلتِ

302
00:21:42,300 --> 00:21:43,360
!لم أقل ذلك أبداً

303
00:21:43,360 --> 00:21:47,560
!وألم تقل بوتان ألّا تجرح نفسك؟

304
00:21:47,560 --> 00:21:49,150
—بلى، لكن

305
00:21:49,150 --> 00:21:52,020
!غبيّ

306
00:21:49,720 --> 00:21:50,450
—لـ-لكن

307
00:21:52,020 --> 00:21:53,920
!ما خطبك؟

308
00:21:53,030 --> 00:21:54,950
!أليس هذا ما أردته؟