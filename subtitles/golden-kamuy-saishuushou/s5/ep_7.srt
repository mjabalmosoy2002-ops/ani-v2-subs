1
00:00:09,480 --> 00:00:13,490
،قتل السبعة آينو بعضهم البعض

2
00:00:14,340 --> 00:00:17,380
"سيّان بالنسبة إلى "ويلك" و"كيرورانكي

3
00:00:18,040 --> 00:00:20,890
،أما سجناء سجن أباشيري

4
00:00:21,630 --> 00:00:24,870
السجناء ذوو الجلود الموشمة

5
00:00:25,420 --> 00:00:27,440
... هيجيكاتا توشيزو وصحبته

6
00:00:27,440 --> 00:00:29,250
يحاولون جميعًا قتل بعضهم

7
00:00:29,800 --> 00:00:31,760
شيرايشي يوشيتاكي

8
00:00:32,410 --> 00:00:34,510
سوغيموتو سايتشي

9
00:00:34,890 --> 00:00:38,770
كل من تحبينه سيموت

10
00:00:40,260 --> 00:00:44,770
... تمامًا مثل "فينا" و"أولغا" اللتان أحببتهما

11
00:00:48,560 --> 00:00:51,870
"سلّمي لي الذهب "أسيربا

12
00:00:52,190 --> 00:00:55,860
أنتِ تعرفين بالفعل كيفية فك شيفرة الوشم صحيح؟

13
00:00:55,860 --> 00:00:57,360
"لا تفعلي "أسيربا

14
00:01:04,770 --> 00:01:05,620
توقف

15
00:01:06,530 --> 00:01:11,510
علمتُ منذ البدء أن التهديدات لن تحرك فيكِ شعرة

16
00:01:11,940 --> 00:01:15,470
ولكن إذا كنتِ في حاجة محفز فلا أمانع مساعدتكِ

17
00:01:19,730 --> 00:01:22,220
"أخبريني "أسيربا

18
00:01:29,510 --> 00:01:33,250
... لديّ فكرة

19
00:01:34,100 --> 00:01:38,360
ولكني لستُ متأكدةً ... بعد

20
00:01:39,100 --> 00:01:42,620
أخبريني بتلك الفكرة

21
00:01:43,730 --> 00:01:49,630
... إسم "آتشا" بالآينو. هذا كل ما اعرفه

22
00:01:49,630 --> 00:01:52,460
ماذا يكون "اسيربا"؟

23
00:01:53,100 --> 00:01:54,550
أخبريني

24
00:02:01,690 --> 00:02:04,120
هوركيو أوسكوني

25
00:03:38,570 --> 00:03:42,590
هل أنت حي عريف "أريكو"؟

26
00:03:42,930 --> 00:03:46,940
"نعم أنا حي يا ضابط الصف "كيكوتا

27
00:03:47,780 --> 00:03:50,540
"حدثني عن شيء ما "أريكو

28
00:03:51,070 --> 00:03:53,710
بما أن كلانا يعلم أننا أحياء

29
00:03:54,120 --> 00:03:57,420
ماذا ينبغي أن أقول؟

30
00:03:57,940 --> 00:03:59,310
أي شيء

31
00:03:59,850 --> 00:04:02,900
عمّا ترغب في تناوله عند عودتك

32
00:04:03,260 --> 00:04:05,310
عمّا ترغب في فعله

33
00:04:06,370 --> 00:04:08,330
شيء في المستقبل سيَفي

34
00:04:11,830 --> 00:04:15,770
أرغب في التدرب على صنع ماكيري

35
00:04:16,280 --> 00:04:20,220
ماكيري، خناجر الآينو تلك؟

36
00:04:20,220 --> 00:04:21,280
نعم

37
00:04:21,590 --> 00:04:25,050
الرجل يمنح المرأة التي يحبها ماكيري

38
00:04:25,400 --> 00:04:29,740
المرأة يمكنها معرفة كم الرجل مناسب لها بالنظر في جودة الماكيري

39
00:04:30,520 --> 00:04:33,790
لذا على الرجل أن يسعه صنع ماكيري

40
00:04:34,610 --> 00:04:38,420
تخشى أن ترفضك المرأة التي تحبها؟

41
00:04:38,870 --> 00:04:39,870
لا

42
00:04:40,500 --> 00:04:43,320
أرغب في صنع واحد لنفسي

43
00:04:44,950 --> 00:04:49,260
بعض الآباء يأخذون وقتهم في تعليم أطفالهم

44
00:04:50,040 --> 00:04:55,710
ولكن عوضًا، والدي جعلني أراقبه يصنع واحدًا خطوة بخطوة

45
00:04:56,120 --> 00:04:59,480
كي يمكنني صنع واحد لنفسي عندما أصير بالغًا

46
00:05:01,650 --> 00:05:06,490
لأنه أدرك إذا أجبرني على صنع واحد سأرفض

47
00:05:07,650 --> 00:05:12,050
... لكن لا بُدَّ أنه شعر بإحباطٍ جمّ

48
00:05:14,290 --> 00:05:16,250
،كي تصنع ماكيري

49
00:05:16,580 --> 00:05:20,250
أنت بحاجة خشب من شجرة إيزو إيتايا التي هي خفيفة وصلبة

50
00:05:20,830 --> 00:05:22,770
،إذا صنعته بخشبٍ آخر

51
00:05:22,770 --> 00:05:27,760
سينكسر المقبض قبل أن تنهي سلخ أيل واحد

52
00:05:28,220 --> 00:05:31,390
بعض الأيام كان يتمتم بكلام مثل هذا بصوت عالٍ كفاية كي أسمع

53
00:05:34,380 --> 00:05:38,020
ولكن .. لم أهتم حقًا

54
00:05:40,470 --> 00:05:45,320
إذا سخر أحدهم مني لأنني آينو سأرد عليه بكل ما أوتيت

55
00:05:46,020 --> 00:05:49,420
وإذا طلب أحدهم مساعدتي سأساعده حتى ولو كان يابانيًا

56
00:05:50,700 --> 00:05:57,040
لا أهتم بكل تلك الأشياء ولكن الجميع يعاملني كآينو

57
00:05:58,010 --> 00:06:01,530
أتذكر أنني كنت أعتقد أن كونك فردًا من الآينو يجلب المتاعب

58
00:06:02,710 --> 00:06:06,750
ولكن النمط على ماكيري والدي تم تناقله لأجيال

59
00:06:07,610 --> 00:06:10,920
لذا على الأرجح أراد أن يحرص على تعليمي

60
00:06:11,890 --> 00:06:17,180
عندما رحلت إلى الحرب، بدأ في صنع ماكيري لأجلي كما سمعتُ

61
00:06:17,910 --> 00:06:23,460
"إذا كان لديه واحدًا" كما قال، "يمكنه أن يتعلّمَ كيف يصنع واحدًا بنفسه يومًا ما"

62
00:06:24,350 --> 00:06:29,090
لكن وصلني أنه مات قبل أن ينهيه

63
00:06:30,910 --> 00:06:33,370
ولا أحد يدري أين إختفى الماكيري

64
00:06:35,060 --> 00:06:38,690
... كان عليّ الإنتباه أكثر

65
00:06:40,500 --> 00:06:43,870
هل ما زلتَ حيًّا يا ضابط الصف "كيكوتا"؟

66
00:06:44,290 --> 00:06:46,840
قل شيئًا إذا كنت تتنفس

67
00:06:47,630 --> 00:06:50,470
المعذرة

68
00:06:51,560 --> 00:06:54,300
"أعتذر "أريكو

69
00:07:01,880 --> 00:07:05,020
من أين أتى هذا الماكيري؟

70
00:07:05,340 --> 00:07:06,890
... للأسف

71
00:07:06,890 --> 00:07:11,530
نسيتَ القمر الذي شاهدناه من الخندق أليس كذلك؟

72
00:07:23,300 --> 00:07:25,720
هوركيو أوسكوني

73
00:07:38,810 --> 00:07:40,250
"ملازم "تسورومي

74
00:07:41,270 --> 00:07:42,220
أريكو؟؟

75
00:07:43,310 --> 00:07:46,150
"أتيتُ حاملاً معلومات عن أين يختبئ "هيجيكاتا توشيزو

76
00:07:46,530 --> 00:07:50,940
إذا باغتناهم الآن سنقتلهم ونحصل على جميع الجلود

77
00:07:55,650 --> 00:07:57,830
أريكو ريكيماتسو

78
00:07:58,280 --> 00:08:01,810
أنت متأكد من هذا الطريق الذي إخترته؟

79
00:08:04,030 --> 00:08:07,500
!اعطني كل الجلود

80
00:08:15,370 --> 00:08:16,970
"اهربي فورًا "أسيربا

81
00:08:20,850 --> 00:08:23,440
هل تلك الطلقات من الكنيسة؟

82
00:08:31,610 --> 00:08:32,740
!عالق

83
00:08:36,200 --> 00:08:37,270
!انطلقي! انطلقي

84
00:08:39,490 --> 00:08:40,790
!أسيربا سان

85
00:08:42,620 --> 00:08:44,620
"اقفزي الآن "أسيربا تشان

86
00:08:57,090 --> 00:08:58,440
"أُصيب "إيبوبتي

87
00:08:58,440 --> 00:08:59,720
"توقف "سوغيموتو

88
00:09:00,010 --> 00:09:01,560
!لا تتوقف! انطلق

89
00:09:01,930 --> 00:09:03,640
!اخفضي رأسكِ! قد تصابين

90
00:09:03,930 --> 00:09:06,110
!"اخفضي رأسكِ! "أسيربا سان

91
00:09:06,520 --> 00:09:08,940
"اذهبي "أسيربا

92
00:09:13,630 --> 00:09:15,610
....إنه نورابو

93
00:09:16,050 --> 00:09:18,450
!إنه كيكوتا سان

94
00:09:23,560 --> 00:09:24,870
أريكو؟

95
00:09:25,610 --> 00:09:26,790
ما الذي تفعله هنا؟

96
00:09:30,370 --> 00:09:32,800
"ضابط الصف "كيكوتا

97
00:09:39,450 --> 00:09:40,550
!إيبوبتي

98
00:10:01,150 --> 00:10:02,810
!تم إخماد الحريق إلى حد ما

99
00:10:02,810 --> 00:10:06,860
إنه طوب بأي حال. لن ينتشر الحريق به

100
00:10:06,860 --> 00:10:10,380
أحسنتم عملاً. لدينا ما يكفي من الرجال لذا خذوا قسطًا من الراحة

101
00:10:25,480 --> 00:10:27,430
أتساءل، هل تردد؟

102
00:10:29,710 --> 00:10:33,270
تعلمت تلك الحيلة من "هيجيكاتا توشيزو" في باراتو

103
00:10:39,750 --> 00:10:42,030
"لا تقسو على نفسك "كادوكورا

104
00:10:42,030 --> 00:10:43,410
لنحظَ ببعض الراحة

105
00:10:47,370 --> 00:10:50,590
اجلسي "أسيربا سان" قد يصيبكِ مكروه

106
00:10:54,210 --> 00:10:55,370
... إيبوبتي

107
00:11:24,780 --> 00:11:26,040
!إنه أوشياما

108
00:11:32,520 --> 00:11:34,820
"استدعِ "هيجيكاتا توشيزو

109
00:11:34,820 --> 00:11:37,500
أعلم كيف نميّز المزيفة

110
00:11:50,390 --> 00:11:52,060
"لا تمت بين يديَّ "أريكو

111
00:11:52,060 --> 00:11:53,000
أريكو

112
00:11:54,980 --> 00:11:56,160
!افق يا هذا

113
00:11:56,160 --> 00:11:58,530
لا زلت لم تصنع الماكيري خاصتك صحيح؟

114
00:12:04,340 --> 00:12:05,430
أريكو

115
00:12:07,550 --> 00:12:09,830
أنقذَ والدك حياتك هاه؟

116
00:12:10,830 --> 00:12:15,330
وقتنا الحاضر في مكان ما عند متحف ثقافي بهوكايدو

117
00:12:15,610 --> 00:12:19,470
ماكيري معروض وقد نُسيَّ

118
00:12:20,010 --> 00:12:24,710
"مكتوب أنه من صُنع "اريكو إيبوبتي

119
00:12:25,260 --> 00:12:28,720
قلّدَ ماكيري والده بالضبط

120
00:12:28,720 --> 00:12:33,560
ولكنه أضاف لمسته في موضعٍ واحد

121
00:12:34,040 --> 00:12:38,350
... ولكن تلك قصة أخرى

122
00:12:39,340 --> 00:12:41,370
"ضابط الصف "كيكوتا

123
00:12:41,890 --> 00:12:45,030
لن أنسَ معروفك هذا لإنقاذ حياتي

124
00:12:45,490 --> 00:12:51,030
ولكن فور أن أتعافى سأقاتل رفقة "أسيربا" ومن معها

125
00:12:51,530 --> 00:12:53,870
لن أساعد الحكومة المركزية

126
00:12:53,870 --> 00:12:55,470
هوّن عليك

127
00:12:55,470 --> 00:12:57,960
لن تحرك ساكنًا بتلك الجروح لفترة

128
00:12:57,960 --> 00:12:59,380
خذ وقتك

129
00:12:59,850 --> 00:13:03,050
"ولنذهب إلى ينابيع ساخنة مرة أخرى "أريكو

130
00:13:08,940 --> 00:13:11,970
"الرقيب "تسوكيشيما" هرولَ خلف "أسيربا

131
00:13:12,450 --> 00:13:15,350
هل أُرسل خلفهم تعزيزات؟

132
00:13:19,240 --> 00:13:20,480
نيكايدو

133
00:13:21,910 --> 00:13:23,690
تسوكيشيما يلاحق أسيربا"

134
00:13:23,690 --> 00:13:25,150
"هل أُرسل تعزيزات خلفه؟

135
00:13:26,290 --> 00:13:29,800
تسوكيشيما يلاحق أسيربا"

136
00:13:29,800 --> 00:13:32,910
"هل أُرسل تعزيزات خلفه؟

137
00:13:33,140 --> 00:13:34,390
أو كما قال

138
00:13:34,780 --> 00:13:37,920
"كلا، اعيدوا "تسوكيشيما

139
00:13:40,200 --> 00:13:43,580
أظن أن مفتاح فك الشيفرة صحيح

140
00:13:43,900 --> 00:13:45,920
"لم نعد بحاجة "اسيربا

141
00:13:47,070 --> 00:13:51,430
رأيت؟ الملازم "تسورومي" رائع

142
00:13:51,910 --> 00:13:57,820
علمتُ! كان كل هذا مسرحية لجعل "اسيربا" تبوح

143
00:13:59,190 --> 00:14:02,340
هل أنت تشرب "نيكايدو"؟

144
00:14:03,030 --> 00:14:06,150
هل أنفك في حالة سيّئة لدرجة لا يمكنك الإدراك؟

145
00:14:07,790 --> 00:14:11,070
لم أدرك لأننا كنّا في مصنع جعة للتو

146
00:14:11,070 --> 00:14:15,410
لكن تفوح منك رائحة كما لو صبَّ أحدهم كأس جعة فوق رأسك

147
00:14:25,410 --> 00:14:26,420
... تسوكيشيما

148
00:14:28,610 --> 00:14:29,470
... لا

149
00:14:30,570 --> 00:14:33,980
،حتى ولو كان يعلم أننا نسترق السمع بالغرفة المجاورة

150
00:14:33,980 --> 00:14:36,580
لا يعني هذا أن كل ما تفوه به كذبًا صحيح؟

151
00:14:37,770 --> 00:14:39,850
ميناء روسي حربي

152
00:14:39,850 --> 00:14:43,160
"مباشرة خلف البحر والذي يعني إسمه "حكم الشرق الأقصى

153
00:14:43,610 --> 00:14:47,410
لا يزال تهديدًا جمًّا على اليابان

154
00:14:48,390 --> 00:14:49,950
لا ضير من الإعتقاد بأن

155
00:14:50,380 --> 00:14:54,620
غايته الحقيقية هي حماية وإزدهار اليابان صحيح؟

156
00:14:55,630 --> 00:14:58,580
...وأكثر من أي شيء، الرقيب "تسوكيشيما"، الذي ضحى بكل ما يملك

157
00:14:59,210 --> 00:15:03,630
!لا شك أنه كان يرغب في سماع تلك الكلمات التي قالها بحق

158
00:15:29,910 --> 00:15:32,230
.شكرًا أيها الملك

159
00:15:33,910 --> 00:15:36,660
تذكرت ما قالته لي إمرأة

160
00:15:37,220 --> 00:15:40,310
،قالت بأن كيمونو آتوس مصنوع من خيوط لحاء الشجر

161
00:15:40,700 --> 00:15:44,040
كانت جميلة جدًا لدرجة لم يستطع تقليدها أحد

162
00:15:44,620 --> 00:15:49,460
خيوط آدوس مصبوغة بعصارة شجر الألدر الياباني الذي نسميه كيني

163
00:15:49,810 --> 00:15:54,800
لكن يصعُب القيام بالأمر. إذا زلَّت يدك قد يتحول إلى لون بني

164
00:15:55,350 --> 00:15:58,250
لكن المرأة كانت مهووسة بإتقان الأمر

165
00:15:58,690 --> 00:16:02,690
كانت خيوطها أكثر لون أحمر جمالاً قد رآه أحد

166
00:16:03,490 --> 00:16:07,690
إستعملت ذلك الخيط لحياكة كيمونو لزوجها الحبيب

167
00:16:08,250 --> 00:16:12,200
إرتداه يومًا كي يذهب إلى العمل في الجبال

168
00:16:12,750 --> 00:16:17,200
لكن المطر كان غزيرًا ذلك اليوم لذا عاد مهرولاً

169
00:16:17,830 --> 00:16:21,200
ولاحظ أن المنطقة قرب الفخذ تحولت إلى اللون البني

170
00:16:21,980 --> 00:16:24,710
كان يحمل فأسًا في تلك المنطقة

171
00:16:25,100 --> 00:16:27,840
هذا لم يكن ليحدث مع الآتوس العادي

172
00:16:28,260 --> 00:16:31,840
أدركوا أن المطر جعل العصارة تنحلّ من الكيمونو

173
00:16:32,530 --> 00:16:35,740
والجزء الذي لامست فيه الصلب تغير لونه

174
00:16:36,590 --> 00:16:41,100
هوسها جعله هشًّا أكثر مما ينبغي

175
00:16:42,040 --> 00:16:47,640
جلود "كادوكورا"وقعت في الماء ثم إحتكت بمعدن الخزان

176
00:16:48,410 --> 00:16:52,900
لاحظت أن بعضهم تحول إلى الأسود والبقية لم يفعل

177
00:16:53,510 --> 00:16:56,290
توجد عدّة طرق لدباغة الجلود

178
00:16:56,680 --> 00:17:00,790
استعمل "سوغيموتو" الشَّبَة والتي هي بخسة وسهلة المنال

179
00:17:01,150 --> 00:17:03,290
نحن فعلنا أيضًا

180
00:17:03,580 --> 00:17:10,300
لكن لأنعَم وأزهد دباغة يمكنك إستعمال عصارة النبات

181
00:17:10,980 --> 00:17:13,750
ستاتشيوروس برايكوكس على سبيل المثال أو عصارة الكيني

182
00:17:14,710 --> 00:17:17,800
المُحنِط الذي صنع الجلود المزيفة

183
00:17:18,490 --> 00:17:21,480
لعله كان لديه هوسه الخاص بخصوص الدباغة

184
00:17:23,090 --> 00:17:26,770
ربما صنع مزيفًا يفوق الأصلي

185
00:17:34,410 --> 00:17:38,320
علمتُ. الجلود التي تطابق ما ذكرتُهُ كانت مزيفة

186
00:17:39,390 --> 00:17:45,210
"وكان هناك 2 حقيقيان وسط الجلود التي أحضرها "إيبوبتي

187
00:17:48,030 --> 00:17:51,710
خلطَ الحقيقي بالمزيف لمنعنا من فك الشيفرة

188
00:17:51,950 --> 00:17:53,870
يا لها من جراءة

189
00:17:54,710 --> 00:17:59,590
... والمفتاح لفك الشيفرة هو إسم والدي

190
00:18:00,740 --> 00:18:03,600
في لغة الآينو : اللحاق بالذئب

191
00:18:04,020 --> 00:18:05,620
هوركيو أوسكوني

192
00:18:06,220 --> 00:18:07,600
أنا متأكدة

193
00:18:07,890 --> 00:18:09,750
هوركيو أوسكوني

194
00:18:10,520 --> 00:18:11,690
... فهمتُ

195
00:18:12,600 --> 00:18:17,980
كل جلد عليه كانجي مختلف يمكن نطقه بنفس الطريقة

196
00:18:18,570 --> 00:18:20,260
... أدركت ذلك ولكن

197
00:18:21,020 --> 00:18:23,110
... اللحاق بالذئب

198
00:18:23,580 --> 00:18:26,710
"أحسنت "كيرو تشان

199
00:18:31,770 --> 00:18:35,530
أخبرتِ الملازم "تسورومي" بهذا، صحيح يا آنسة؟

200
00:18:35,530 --> 00:18:38,340
أجل. بدأ بالفعل في فك الشيفرة

201
00:18:44,220 --> 00:18:47,350
إذا لم نسرع ونفك الشيفرة سيسبقنا إلى هناك

202
00:18:47,640 --> 00:18:50,850
لا توجد سوى طريقة واحدة لمباغتتهم

203
00:18:51,620 --> 00:18:55,090
"سنراهن على آخر كلمة من المعلومات التي أمدنا بها "بوتارو

204
00:18:56,220 --> 00:19:00,750
أول مكان خبّأَ الآينو الذهب فيه عندما جمعوه منذ أعوام

205
00:19:01,640 --> 00:19:05,010
سنتجه إلى هناك ونفك الشيفرة في الطريق

206
00:19:06,530 --> 00:19:08,620
"وجدت مجموعة "كادوكورا

207
00:19:08,620 --> 00:19:11,290
إنتظرونا

208
00:19:14,570 --> 00:19:20,490
المساحة ضيّقة لوضع الجلود وفك الشيفرة

209
00:19:20,490 --> 00:19:22,800
هل نزيح بعض المقاعد؟

210
00:19:25,730 --> 00:19:27,720
.توجد مساحة كافية هنا

211
00:19:29,060 --> 00:19:32,310
ويحي. الدرجة الثالثة في الخلف

212
00:19:32,740 --> 00:19:36,610
تذكرة الدرجة الأولى تكلّف أربعة أضعاف على ما اظن

213
00:19:36,610 --> 00:19:38,320
لم تدروا بذلك كما أرى

214
00:19:38,790 --> 00:19:42,100
يغطيكم الوسخ لذا يستحسن أن تعودوا

215
00:19:42,100 --> 00:19:44,320
ستزعجون الركاب الذين سيأتون لاحقًا

216
00:19:52,300 --> 00:19:57,420
كل جلد عليه كانجي مختلف يمكن نطقه بنفس الطريقة

217
00:19:57,980 --> 00:20:01,650
لكن كل ما هو غير "هوركيو أوسكوني" مزيف

218
00:20:02,100 --> 00:20:04,680
يوجد على الأقل 4 كانجي على كل جلد

219
00:20:05,130 --> 00:20:09,680
"يُطابق أحرف "هوركيو أوسكوني

220
00:20:10,210 --> 00:20:14,940
والبعض يتطابق عند وضعهم فوق بعض

221
00:20:14,940 --> 00:20:18,500
علِمَ أنّ إبنته لن تعرف الكانجي

222
00:20:18,500 --> 00:20:21,960
ولكنه أعطاها شيفرة بالكانجي بأي حال

223
00:20:22,490 --> 00:20:26,690
لعلها أيضًا رسالة من "ويلك" أنّ عليكِ العمل

224
00:20:27,020 --> 00:20:30,180
رفقة اليابانيين لتعثري على الذهب؟

225
00:20:33,400 --> 00:20:36,690
،أو ربما كانت

226
00:20:36,690 --> 00:20:39,370
اخدعي أولئك اليابانيون لمساعدة الآينو" على حد علمنا"

227
00:20:39,370 --> 00:20:44,840
لا عجب أن تكوني فعلتِ ذلك مع الملازم "تسورومي" صحيح؟

228
00:20:45,550 --> 00:20:48,210
"تلك العملة الذهبية التي أعطاها لي "بوتارو

229
00:20:48,210 --> 00:20:50,890
آتشا" صنعها وفقدها في بحيرة شيكوتسو"

230
00:20:51,310 --> 00:20:54,600
بعض أنماط العملات تشبه التي على الجلود

231
00:20:55,550 --> 00:20:59,890
تلك بها خط واحد لا يتقاطع مع آخر

232
00:21:00,200 --> 00:21:02,360
موجود أيضًا على الجلود الموشومة

233
00:21:03,250 --> 00:21:06,070
هل لهذا معنى ربما؟

234
00:21:07,210 --> 00:21:11,620
،هل هذا يعني أن الآينو عندما صنعوا الذهب

235
00:21:11,620 --> 00:21:17,210
كانوا قد خططوا لهروب السجناء بالفعل؟

236
00:21:17,780 --> 00:21:20,890
هل أصبح "نوبيرابو" عن عمد؟

237
00:21:22,410 --> 00:21:23,460
لا

238
00:21:24,200 --> 00:21:28,470
،آتشا" لم يكن ليتخيل أن الآينو سيقتلون بعضهم البعض"

239
00:21:28,870 --> 00:21:31,180
"أو أنه سيصبح "نوبيرابو

240
00:21:32,050 --> 00:21:36,730
مقابلتي لعلها كانت جزءًا من الخطة أيضًا

241
00:21:37,050 --> 00:21:38,750
هذا مذهل

242
00:21:38,750 --> 00:21:41,070
سنحظى بمقاعد الدرجة الأولى لأنفسنا

243
00:21:42,250 --> 00:21:43,180
أجل

244
00:21:52,600 --> 00:21:55,830
حجزتُ مقعدًا درجة أولى نحو الجحيم

245
00:21:57,650 --> 00:21:59,080
إنسَ أمري

246
00:22:00,200 --> 00:22:03,140
وكل ما يتعلق بـ"هانزاوا يوساكو" أيضًا

247
00:23:35,310 --> 00:23:39,610
في الحلقة القادمة : قصة حب في طوكيو