189
00:11:29,180 --> 00:11:31,040
إنّها تحفة فنّية مُصمّمة لتسريع عملية التطوّر

190
00:11:31,040 --> 00:11:32,880
بنيتها على أساس سماد لفاح

191
00:11:32,880 --> 00:11:35,540
...لا عجب أنّ أوجهها بدت مألوفة

192
00:11:35,540 --> 00:11:39,060
أعتذر على ذلك، سأعتني بالأمر فوراً

193
00:11:39,060 --> 00:11:40,550
كلّا، لا داعي

194
00:11:40,550 --> 00:11:41,550
!ماذا؟

195
00:11:42,050 --> 00:11:44,300
!فلم أتلقَّ أيّة أضرار

196
00:11:44,630 --> 00:11:48,730
!هذه الصغار حلوة ولذيذة، إنّها الأروع

197
00:11:48,730 --> 00:11:49,800
...بطاطا

198
00:11:50,790 --> 00:11:52,560
تتضاعف دون أن أتدخّل

199
00:11:53,310 --> 00:11:55,060
!وتمشي من تلقاء نفسها

200
00:11:55,060 --> 00:11:58,570
!بطاطا

201
00:11:55,730 --> 00:11:57,360
...مع أنّها تصرخ

202
00:11:57,360 --> 00:11:58,570
!تلك الأضرار

203
00:11:58,570 --> 00:12:00,860
!لنجعلها ترجعها لطبيعتها

204
00:12:00,860 --> 00:12:02,710
!أجل، هذا خطر

205
00:12:02,710 --> 00:12:05,460
حسناً، من الصحيح أنّ بعضها يصعب تحصيله

206
00:12:05,460 --> 00:12:07,330
ربما لكونها مشاغبة قليلاً

207
00:12:07,330 --> 00:12:08,800
سأذهب لجلب ليرا-سان

208
00:12:08,800 --> 00:12:10,330
!توقّفي

209
00:12:10,760 --> 00:12:12,500
لا بأس

210
00:12:12,500 --> 00:12:14,790
إنّها مخلوقات غير ضارّة

211
00:12:14,790 --> 00:12:17,410
مثل بطاطاليبر، البطاطا الذي
يستطيع المُختار فحسب حملها

212
00:12:17,410 --> 00:12:19,590
!ستبدأ أسطورة

213
00:12:19,590 --> 00:12:21,460
!يا إلهي

214
00:12:21,460 --> 00:12:23,590
!كلّا! إنّها تحبّ هذه الأشياء

215
00:12:23,590 --> 00:12:27,080
أين المشكلة؟ يبدو هذا أكثر تسلية
!من حفر البطاطا العاديّ

216
00:12:27,750 --> 00:12:30,700
يراودني شعورٌ سيّئ، دعني أطّلع على البقيّة أيضاً

217
00:12:30,700 --> 00:12:31,850
!بالطبع

218
00:12:32,860 --> 00:12:34,700
انظري للخلف هناك

219
00:12:35,100 --> 00:12:37,220
ذلك بطاطابوروس

220
00:12:37,220 --> 00:12:38,860
!غرابات بالفعل

221
00:12:38,860 --> 00:12:43,850
ألا تذكّركِ بأوروبورس، الأفعى التي
تمثّل اللا نهايّة والأبديّة؟

222
00:12:43,850 --> 00:12:47,620
أجل، أيعني ذلك أنّ البطاطا ستعيش للأبد؟

223
00:12:48,810 --> 00:12:51,400
لا، إنّها تلعق ذيلها وحسب

224
00:12:52,670 --> 00:12:55,000
كنت تتكلّم عن المظهر فحسب إذاً؟

225
00:12:57,500 --> 00:12:59,800
أيلاحظ أحدٌ رائحة زكيّة؟

226
00:12:59,800 --> 00:13:01,520
!لعلّه عطري

227
00:13:01,970 --> 00:13:04,010
من أين لك هذه الثقة؟

228
00:13:05,270 --> 00:13:06,510
!إنّها من هناك

229
00:13:06,980 --> 00:13:08,510
!ذلك خطر

230
00:13:08,510 --> 00:13:11,300
إنّه يودّ الحرص على أن يُؤكل
،كبطاطا مشويّة وحسب

231
00:13:11,300 --> 00:13:13,020
لذا يحترق ذاتيّاً

232
00:13:13,020 --> 00:13:14,700
!نحتاج لماء

233
00:13:14,700 --> 00:13:18,420
أسميته بطاطريت، من العفريت الأسطوريّ

234
00:13:18,420 --> 00:13:20,100
!هذا ليس وقت التلاعب

235
00:13:20,100 --> 00:13:23,300
لا تقلق، تحرق تلك النيران بطاطريت فحسب

236
00:13:23,300 --> 00:13:24,950
حقّاً؟

237
00:13:25,710 --> 00:13:27,530
ماما، انظري هناك

238
00:13:29,690 --> 00:13:31,540
أرى المُسمّى سلفاً

239
00:13:33,850 --> 00:13:35,290
إنّها بطاطريّة

240
00:13:35,290 --> 00:13:37,040
كنتُ أتوقّع قولك لذلك

241
00:13:37,040 --> 00:13:40,080
بالمناسبة، يمكنكما وقاية
البطاطا المقطوعة من الاسمرار

242
00:13:40,080 --> 00:13:42,050
عبر وضعها في الماء

243
00:13:42,050 --> 00:13:43,480
حقّاً؟

244
00:13:43,480 --> 00:13:45,800
!لا تستعملها كأداة تعليم

245
00:13:50,020 --> 00:13:54,540
ألديك.. أصناف أكثر أماناً؟

246
00:13:54,540 --> 00:13:56,310
أكثر أماناً؟

247
00:13:56,310 --> 00:13:58,060
...حسناً

248
00:14:03,040 --> 00:14:04,710
ماذا عن بطاطأة؟

249
00:14:04,710 --> 00:14:07,720
!مرحى، إنّه عاديّ بالمقارنة

250
00:14:09,570 --> 00:14:11,600
أعتقد أنّ عيبها الوحيدة هو تغيير لهيئتها

251
00:14:11,600 --> 00:14:14,040
لشيء صادم عندما تستخرجينها من الأرض

252
00:14:14,040 --> 00:14:15,580
!ذلك الأكثر سوءاً

253
00:14:18,080 --> 00:14:21,990
لا أصدّق أنّ أوّل صنف
...رأيناه كان العاديّ

254
00:14:21,990 --> 00:14:24,120
بدت تبدو ظريفة

255
00:14:24,120 --> 00:14:26,970
،حسناً إذاً، بعد تقديمها لكما

256
00:14:26,970 --> 00:14:28,840
!فلتستمعا بحفر البطاطا

257
00:14:28,840 --> 00:14:32,000
كلّا، سأستدعي غيريكو لإرجاعها

258
00:14:32,000 --> 00:14:33,350
!ماذا؟

259
00:14:33,350 --> 00:14:34,990
!هذا بديهيّ

260
00:14:34,990 --> 00:14:38,910
!لمَ تعتقد أنّ هذا مقبول؟
!إنّها لا تحوي سوى المشاكل

261
00:14:38,910 --> 00:14:42,360
!كيف لكِ؟! قمت بتنشئتها لهذا الحدّ

262
00:14:42,360 --> 00:14:47,160
ابني مراهقٌ ولا يأبه بي
...البتّة هذه الأيام

263
00:14:47,160 --> 00:14:51,870
!قبل هؤلاء الصغار حبّي ومنحوه منفذاً

264
00:14:51,870 --> 00:14:54,040
هذا ما يحصل إذاً عندما يلجأ للزراعة

265
00:14:54,040 --> 00:14:57,820
للتشافي من احتراقه الأبويّ

266
00:14:58,870 --> 00:15:02,130
...عمّي المسكين

267
00:15:02,480 --> 00:15:07,490
!لن أستطيع تحمّل عدم اهتمام ماما بي أبداً

268
00:15:07,490 --> 00:15:09,130
!أنتِ مُفرطة الحساسيّة

269
00:15:09,130 --> 00:15:11,260
!فلندعها وشأنها

270
00:15:11,260 --> 00:15:13,260
!أتوسّل رحمتك

271
00:15:14,520 --> 00:15:17,140
!أأنا الغريبة هنا؟

272
00:15:17,530 --> 00:15:19,740
سمعتُ كلّ شيء

273
00:15:20,270 --> 00:15:21,740
ليرا-سان؟

274
00:15:21,740 --> 00:15:23,770
أيّها الزوج الغبيّ

275
00:15:23,770 --> 00:15:25,500
لـ-لمَ أنتِ هنا؟

276
00:15:25,500 --> 00:15:27,810
ظننتكِ خارج البلدة للتسوّق اليوم

277
00:15:27,810 --> 00:15:32,080
رجعتُ باكراً لأنّك كنت تتصرّف بغرابة

278
00:15:32,780 --> 00:15:34,470
...كما

279
00:15:36,170 --> 00:15:40,290
أليس قبول حبّك عملي؟

280
00:15:41,150 --> 00:15:43,790
!سأعطيكِ إيّاه كلّه

281
00:15:43,790 --> 00:15:46,040
لم أعد أهتمّ

282
00:15:47,070 --> 00:15:49,960
فلتقبل أنت مشاعري أيضاً

283
00:15:52,680 --> 00:15:55,580
!شعور غضبي المتراكم

284
00:15:55,580 --> 00:15:58,800
!بطاطاليبر؟

285
00:15:58,800 --> 00:16:01,310
أشعر بالقوّة تتأجّج بداخلي

286
00:16:01,930 --> 00:16:05,860
،شعرت أنّي أُجذب نحوه بشكلٍ ما
فسحبته في طريقي

287
00:16:05,860 --> 00:16:07,320
!اختاركِ؟

288
00:16:07,660 --> 00:16:11,070
لا تفعل شيئاً سوى إحداث الفوضى

289
00:16:11,070 --> 00:16:15,140
لذا أنا من تقوم بالتنظيف دوماً

290
00:16:16,450 --> 00:16:21,460
!أفكّرت بذلك؟

291
00:16:25,330 --> 00:16:27,720
لا يمكن استلطاف العمّة

292
00:16:27,720 --> 00:16:29,840
بخلاف البطاطا

293
00:16:32,340 --> 00:16:34,340
وصلت

294
00:16:34,340 --> 00:16:40,600
رجعت البطاطا في النهاية
إلى طبيعتها بمساعدة غيريكو

295
00:16:44,230 --> 00:16:46,230
نعتذر

296
00:16:46,230 --> 00:16:47,340
لا بأس

297
00:16:48,230 --> 00:16:53,240
وتلقّت أليسا وفيولا البطاطا
كما كان هدفهما الأوّل

298
00:16:53,240 --> 00:16:56,740
!وجبة اليوم خفيفة هي شرائح بطاطا حلوة

299
00:16:56,740 --> 00:16:59,490
شكراً على الطعام

300
00:17:02,880 --> 00:17:04,340
بطاطا مشويّة

301
00:17:05,310 --> 00:17:10,870
أكلوا وجبات مقتصرة على البطاطا
للأسبوع التالي وفقما يبدو

302
00:17:17,190 --> 00:17:19,410
ما هذا؟

303
00:17:27,450 --> 00:17:29,480
!ما الذي يجري؟

304
00:17:39,490 --> 00:17:44,560
اللفاح! إنّها نباتات شبه بشريّة
تُستعمل في السحر والكيمياء

305
00:17:44,560 --> 00:17:48,120
عند استخراجها، تطلق صرخة تقود
من يسمعها للجنون

306
00:17:49,500 --> 00:17:51,360
لفاح؟

307
00:17:51,360 --> 00:17:54,900
...لا أتذكّر زرعي لواحدة هنا

308
00:17:55,990 --> 00:17:57,330
لا تتكلّمي يا ماما

309
00:17:57,330 --> 00:17:59,500
—فيولا؟ أقمتِ

310
00:18:00,290 --> 00:18:02,260
ادخلي السقيفة وسأشرح لكِ

311
00:18:02,750 --> 00:18:04,640
امشي بصمت

312
00:18:08,910 --> 00:18:10,420
يُفترض أن نكون بأمان للوقت الراهن

313
00:18:10,420 --> 00:18:12,630
!فيولا، فلتوضّحي هذا

314
00:18:12,630 --> 00:18:15,870
...حسناً، ثارت بعض الشيء

315
00:18:15,870 --> 00:18:17,030
ثارت؟

316
00:18:19,270 --> 00:18:20,500
ما هذا؟

317
00:18:24,830 --> 00:18:28,290
!بطاطا

318
00:18:28,290 --> 00:18:30,350
...كارثة بطاطا

319
00:18:30,350 --> 00:18:33,260
!كلّا! أيّ شيء إلّا هذا

320
00:18:34,420 --> 00:18:35,980
"تنوير"

321
00:18:34,420 --> 00:18:36,170
"العنوان: "تنوير

322
00:18:36,920 --> 00:18:38,300
"خجل"

323
00:18:36,920 --> 00:18:38,680
"العنوان: "خجل

324
00:18:39,430 --> 00:18:41,180
"العنوان: "خصوبة

325
00:18:39,430 --> 00:18:41,180
"خصوبة"

326
00:18:41,930 --> 00:18:43,680
"العنوان: "امتهان

327
00:18:41,930 --> 00:18:43,680
"امتهان"

328
00:18:45,880 --> 00:18:49,560
!اللفاح غريبة الشكل كهذه لا تُقدّر بثمن

329
00:18:49,560 --> 00:18:52,940
تتصرّفين كما لو أنّها
أكثر سلعنا مبيعاً

330
00:18:53,360 --> 00:18:57,440
...لحظة، تبدو تلك كبطاطا بوندو-سان

331
00:18:57,970 --> 00:18:59,320
لمَ؟

332
00:18:59,320 --> 00:19:00,930
...في الواقع

333
00:19:01,670 --> 00:19:04,950
قمتُ بتحسين السماد

334
00:19:05,330 --> 00:19:08,120
أيمكنكِ تجربته على لفاحٍ لي؟

335
00:19:08,120 --> 00:19:09,640
!بالطبع

336
00:19:10,360 --> 00:19:14,710
حسناً... كم أستعمل منه؟

337
00:19:15,750 --> 00:19:18,150
!حسناً، كلّما زاد كان أفضل

338
00:19:18,720 --> 00:19:21,720
!اكبري كثيراً

339
00:19:24,570 --> 00:19:26,270
وها نحن

340
00:19:26,270 --> 00:19:28,760
!غيريكو

341
00:19:32,500 --> 00:19:35,900
!لا صراخ! إنّها تستجيب للصوت

342
00:19:35,900 --> 00:19:37,070
ماذا نفعل؟

343
00:19:37,070 --> 00:19:39,240
فلندعهما يتقاتلان للوقت الراهن

344
00:19:39,240 --> 00:19:42,670
سنمسك بهما بعد نهاية المعركة عندما يتراخيان

345
00:19:42,670 --> 00:19:44,240
فكرة جيّدة

346
00:19:44,240 --> 00:19:47,280
بالمناسبة، الأكبر يُدعى بطاطموث

347
00:19:44,240 --> 00:19:50,250
بطاطموث

348
00:19:44,240 --> 00:19:50,250
بطاحصان

349
00:19:47,690 --> 00:19:50,250
ينمو بأكل البطاطا الأخرى

350
00:19:50,930 --> 00:19:55,470
هكذا لم يمتلئ حقل العمّ بوندو بالدرنات

351
00:19:55,470 --> 00:19:58,250
لحظة، إنّه آكل لحوم؟

352
00:20:02,580 --> 00:20:04,870
لا... يأكل البشر، صحيح؟

353
00:20:04,870 --> 00:20:06,290
لا أظنّ ذلك

354
00:20:06,290 --> 00:20:07,890
!انظري في عيني

355
00:20:09,090 --> 00:20:12,280
بأيّ حال، يبدو أنّ المعركة انتهت

356
00:20:13,010 --> 00:20:16,960
،إذا كنّا سنتعامل مع بطاطموث فحسب
فسيمكننا تدبّر أمره بسحرنا

357
00:20:17,820 --> 00:20:19,700
سنرى

358
00:20:20,760 --> 00:20:22,780
ذلك بطاحصان

359
00:20:22,780 --> 00:20:25,410
قسمه العلويّ لبطاطا، والسفليّ لحصان

360
00:20:25,730 --> 00:20:30,290
يركض بسرعة عالية جدّاً بحيث
حتّى العمّة غيريكو عانت في الإمساك به

361
00:20:30,600 --> 00:20:34,040
!ما الذي سنفعله؟! قد تستمرّ هذه المعركة للأبد

362
00:20:34,040 --> 00:20:36,790
ستنتهي، في أيّ لحظة الآن

363
00:20:44,850 --> 00:20:48,560
بعد القتال بكامل قوّتهما، أصبح من الجليّ لهما

364
00:20:48,560 --> 00:20:51,080
أن الضربة التالية ستكون الأخيرة

365
00:20:51,080 --> 00:20:53,560
نحن نتكلّم عن البطاطا، صحيح؟

366
00:21:01,130 --> 00:21:03,700
!حسناً؟ من فاز؟

367
00:21:14,210 --> 00:21:17,210
فائق

368
00:21:14,580 --> 00:21:16,670
!اندمجا

369
00:21:14,750 --> 00:21:17,210
اندماج

370
00:21:15,250 --> 00:21:17,210
حصاموث

371
00:21:18,450 --> 00:21:22,300
!يبدو أقوى، ألا يبدو أقوى؟

372
00:21:28,720 --> 00:21:31,310
!مُذهل! رائعٌ جدّاً

373
00:21:31,310 --> 00:21:33,730
!غيريكو، تعالي هنا! فوراً

374
00:21:34,200 --> 00:21:39,620
حوّلتهما غيريكو إلى بطاطا عاديّة
...من فورها، وكان ذلك جيّداً، لكن

375
00:21:40,230 --> 00:21:41,980
!عنقاء

376
00:21:41,980 --> 00:21:44,370
أأنت مهتمٌّ بالاندماج؟

377
00:21:44,780 --> 00:21:45,990
!توقّفي

378
00:21:45,990 --> 00:21:50,990
ظلّت فيولا مهووسةً بالاندماج لفترة بعدها

379
00:22:58,540 --> 00:22:59,540
أنا أليسا

380
00:22:59,540 --> 00:23:00,540
أنا فيولا

381
00:23:00,540 --> 00:23:04,140
بتوجيه جنّية أزهار لنا، نذهب أنا وفيولا في رحلة

382
00:23:04,140 --> 00:23:06,700
ونصل حديقة نست الإزهار

383
00:23:06,700 --> 00:23:08,010
جنّي أزهار؟

384
00:23:08,010 --> 00:23:10,910
إنّها قصّة موضوعها الأزهار
وعن مشاعر الناس

385
00:23:11,210 --> 00:23:13,990
الحلقة القادمة في "الظروف العائليّة
:"للساحرة اللا اعتياديّة

386
00:23:13,990 --> 00:23:15,930
ظروف مؤخرة"
"حديقة الأزهار

387
00:23:15,930 --> 00:23:16,840
!تطلّعوا لها

388
00:23:16,840 --> 00:23:18,020
—أنحن متأكّدون أنّها ليست جنّية، بل مؤخـ

