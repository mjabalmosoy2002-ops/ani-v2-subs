1
00:00:04,650 --> 00:00:06,340
مرحباً

2
00:00:06,340 --> 00:00:08,150
!أتينا للزيارة

3
00:00:08,150 --> 00:00:11,260
لونا، غيريكو، أتيتما باكرتين

4
00:00:12,910 --> 00:00:16,350
!أشتمّ رائحة الشاي والمخبوزات الزكيّة بالفعل

5
00:00:18,810 --> 00:00:22,410
،حصلتُ على قِرفة جيّدة
لذا خبزتُ فطيرة تفّاح

6
00:00:22,410 --> 00:00:24,520
ادخلا

7
00:00:25,920 --> 00:00:29,420
أخبريني، ما مقدار الفطيرة التي أعددتِها؟

8
00:00:29,420 --> 00:00:32,300
جلبتُ معي ألفائي اليوم

9
00:00:32,300 --> 00:00:33,470
ارحلوا

10
00:00:34,050 --> 00:00:37,730
كيرن الرباط، إنّه يحب التقييد

11
00:00:38,800 --> 00:00:40,180
ارحلوا

12
00:00:40,560 --> 00:00:43,830
روبيرو المازوخيّ، إنّه يحب الألم

13
00:00:45,250 --> 00:00:47,440
!أرجوكِ، ارحلوا

14
00:00:47,830 --> 00:00:51,450
روس الخجول، إنّه يحبّ الشعور بالإحراج

15
00:00:52,330 --> 00:00:53,920
!أتستمعين إليّ؟

16
00:00:53,920 --> 00:00:56,450
ماما، هل العمّتان هنا؟

17
00:00:57,000 --> 00:00:59,990
!هذا ليس مشهداً يصلح للأطفال
!اجلبيهم عندما لا تكون فيولا موجودة

18
00:00:59,990 --> 00:01:02,220
!سأعطيكِ فطيرة لتأخذوها معكم

19
00:01:02,220 --> 00:01:04,460
أنتِ مُفرطة الحماية

20
00:01:04,460 --> 00:01:06,860
حسناً، التفّوا يساراً

21
00:01:08,900 --> 00:01:09,960
الوجار

22
00:01:17,220 --> 00:01:20,220
أنا جلبتُ لكِ هديّة لائقة

23
00:01:20,220 --> 00:01:21,470
هديّة؟

24
00:01:21,470 --> 00:01:23,020
مُفاجأة

25
00:01:23,840 --> 00:01:25,060
كتاب؟

26
00:02:58,170 --> 00:03:00,860
الظروف الحنينيّة لفتيات"
"جلسات الساحرات

27
00:03:02,670 --> 00:03:04,530
كتاب استذكار سحريّ؟

28
00:03:04,530 --> 00:03:08,290
ببساطة، إنّه نسخة الساحرات
من ألبوم الصور

29
00:03:08,700 --> 00:03:12,670
عندما تضيفين به بعض السحر، يعرض
الذكرى التي تفكّرين بها

30
00:03:12,670 --> 00:03:14,290
!مُذهل

31
00:03:14,580 --> 00:03:17,420
لكن ألم يتبقَ لديكنّ صور عاديّة؟

32
00:03:17,420 --> 00:03:20,840
لم تكن هناك صور في الماضي

33
00:03:20,840 --> 00:03:23,260
الأريحيّات الحديثة رائعة حقّاً

34
00:03:21,840 --> 00:03:24,930
السنّ

35
00:03:23,260 --> 00:03:24,930
فهمت

36
00:03:25,170 --> 00:03:28,430
!أريني صور أمّي في صغرها إذاً

37
00:03:29,540 --> 00:03:33,070
ظننتُكِ ستقولين ذلك، فجهّزتها سلفاً

38
00:03:33,070 --> 00:03:35,100
!ماذا؟ مهلاً

39
00:03:35,100 --> 00:03:35,970
هاكِ

40
00:03:40,440 --> 00:03:41,700
!الجائزة الأولى

41
00:03:41,700 --> 00:03:42,760
في ماذا؟

42
00:03:48,950 --> 00:03:51,730
يا إلهي، إنّها ظريفةٌ جدّاً

43
00:03:51,730 --> 00:03:54,400
ألم تُخطف باستمرار؟

44
00:03:54,400 --> 00:03:55,960
أتتصوّرين أرضاً معدومة النظام؟

45
00:03:56,420 --> 00:03:58,210
!لم تُختطف؟

46
00:03:58,210 --> 00:04:02,080
مع أنّها كانت بهذه الظرافة؟
أكان هنالك خطبٌ ما في بلدتها؟

47
00:04:02,080 --> 00:04:04,470
لا، ولذا لم تُختطف

48
00:04:04,470 --> 00:04:08,720
معكِ حقّ، من الأمثل ألّا تحصل تلك الأشياء

49
00:04:08,720 --> 00:04:11,980
لكن لو كنتُ أمّها، لتملّكني القلق

50
00:04:12,470 --> 00:04:15,420
وأضع أشواكاً على ثيابها

51
00:04:15,420 --> 00:04:17,770
!تفكّر مثل القنفذ

52
00:04:18,230 --> 00:04:20,290
...أنتِ يا فيولا

53
00:04:20,290 --> 00:04:23,160
!تعرفين أنّ تلك كانت فكرتي

54
00:04:24,250 --> 00:04:27,740
تحمّلي مسؤوليّة كيفيّة تربيتكِ لها

55
00:04:28,090 --> 00:04:30,650
!أريد مشاهدة المزيد! المزيد

56
00:04:30,650 --> 00:04:31,760
حسناً، ها هي

57
00:04:32,550 --> 00:04:34,000
!مهلاً

58
00:04:35,680 --> 00:04:38,150
...كنّا هنا في قرابة الخمسين

59
00:04:39,270 --> 00:04:41,210
وهذه عند قرابة 150 عاماً

60
00:04:41,210 --> 00:04:43,500
!كانت ظريفةً جدّاً بحيث أوقفت الزمن

61
00:04:43,500 --> 00:04:44,750
صحيح

62
00:04:44,750 --> 00:04:46,140
!لم أفعل

63
00:04:46,140 --> 00:04:49,800
يا إلهي، كفّا عن محورة الأمر حولي
!وأرياها صوركما أيضاً

64
00:04:49,800 --> 00:04:52,140
حسناً، حسناً، انتظري لحظة

65
00:04:53,340 --> 00:04:54,880
!إنّها العمّة لونا

66
00:04:54,880 --> 00:04:57,900
!إنّها تلعب التاروت، يا لظرافتها

67
00:04:57,900 --> 00:05:01,140
أنحدر من سلاسة طويلة
من قارئي الطالع

68
00:05:01,140 --> 00:05:03,900
فكنتُ أدرسه بكثافة مُذ نعومة أظفاري

69
00:05:05,250 --> 00:05:09,160
يمكن أن ترشد قراءة الطالع
الأشخاص الذين يشعرون بالتوتّر

70
00:05:09,160 --> 00:05:11,160
إنّه سحرٌ رائع

71
00:05:12,310 --> 00:05:18,520
أدلّل الصغار المساكين الذين لا يستطيعون
النجاح بمفردهم، أتكفّل بكلّ شيء

72
00:05:19,790 --> 00:05:21,600
إنّها مُنحرفة

73
00:05:22,930 --> 00:05:26,720
!كنتِ ظريفة أيضاً يا عمّة غيريكو
ما الذي تفعلينه هنا؟

74
00:05:26,720 --> 00:05:29,550
أصنع أدوات سحريّة

75
00:05:29,920 --> 00:05:34,670
بخلاف لونا، كان ذلك لأجلي وحسب

76
00:05:34,670 --> 00:05:38,660
لكنّي جعلته عملاً بنهاية المطاف

77
00:05:39,370 --> 00:05:42,070
ما الذي تصنعينه مؤخراً؟

78
00:05:42,430 --> 00:05:44,070
بوق ترايتون مُثير

79
00:05:44,070 --> 00:05:46,590
ما كانت حالتكِ الذهنيّة
عندما فكّرتِ به؟

80
00:05:49,290 --> 00:05:51,200
!لا داعي لتنفخي به

81
00:05:51,940 --> 00:05:55,050
بالمناسبة، اطّلعي على أليسا
وهي تقوم بالبستنة

82
00:05:55,050 --> 00:05:57,220
!هل ظرافتها تجعل الأزهار تتفتّح؟

83
00:05:57,220 --> 00:05:59,210
لا، بل الماء والسماد

84
00:05:59,210 --> 00:06:03,100
لعلّنا جميعاً مارسنا هواياتنا

85
00:06:03,100 --> 00:06:04,710
إلى أن أصبحت عملنا

86
00:06:04,710 --> 00:06:10,220
بائعة
أدوات

87
00:06:04,710 --> 00:06:10,220
قارئة
طالع

88
00:06:04,710 --> 00:06:10,220
أعشابيّة

89
00:06:05,020 --> 00:06:06,400
معكِ حقّ

90
00:06:06,400 --> 00:06:09,870
تبرع فيما تستمتع به" كما يُقال"

91
00:06:10,220 --> 00:06:13,490
تحوّل هوايتك المُفضّلة إلى عملك
يبدو أمراً رائعاً

92
00:06:13,490 --> 00:06:17,310
عندما أكبر، أريد عملاً يتضمّن أمّي

93
00:06:17,310 --> 00:06:19,480
ما سيكون ذلك بالضبط؟

94
00:06:19,480 --> 00:06:23,380
لكن لا شيء أفضل من
الاستمتاع في العمل

95
00:06:23,380 --> 00:06:25,980
ما الذي تحبّينه بخلاف أليسا؟

96
00:06:25,980 --> 00:06:29,280
!حسناً... أحبّ الدواجن

97
00:06:29,690 --> 00:06:32,000
أي أنّكِ تحبّيني؟

98
00:06:32,000 --> 00:06:33,620
كنت هنا يا عنقاء؟

99
00:06:34,450 --> 00:06:36,620
،وفقما أذكر

100
00:06:37,170 --> 00:06:41,630
العمل" هو نشاط غامض حيث"
تمارسونه أيّها الفانون بامتعاض

101
00:06:41,630 --> 00:06:44,630
على حساب عمركم القصير الثمين

102
00:06:44,630 --> 00:06:46,880
هذا انحيازٌ كبير

103
00:06:47,310 --> 00:06:50,630
بامتعاض أم لا، علينا فعله
لكسب قوت يومنا

104
00:06:51,850 --> 00:06:53,200
،إذا لم يكن لديكم طعام

105
00:06:53,200 --> 00:06:56,140
ألا يمكنكم استهلاك الطاقة
التي تتدفق في العالم الطبيعيّ؟

106
00:06:56,500 --> 00:06:59,020
سموّ ذاك الخالد يثير أعصابي

107
00:06:58,070 --> 00:07:00,890
!لا يقصد الإهانة! نواياه صالحة

108
00:07:03,400 --> 00:07:06,520
عنقاء، أرني كيف كنت
!في صغرك أيضاً

109
00:07:07,340 --> 00:07:09,480
تريدين رؤية ظرافتي؟

110
00:07:11,660 --> 00:07:14,400
هذا أنا قبل 500 عام

111
00:07:15,530 --> 00:07:17,910
هذا أنا قبل 200 عام

112
00:07:17,910 --> 00:07:20,660
ألم نقم بهذا قبلاً؟

113
00:07:20,660 --> 00:07:21,970
الطيور تقع على أشكالها

114
00:07:22,360 --> 00:07:24,540
...ر-ربما ذلك

115
00:07:27,050 --> 00:07:31,550
كنتنّ الثلاثة معاً مُذ صغركنّ؟

116
00:07:31,990 --> 00:07:35,580
أنا صغيرة البنية، ولم أكن قويّة بدنيّاً

117
00:07:35,580 --> 00:07:38,060
فساعدتاني كثيراً

118
00:07:42,600 --> 00:07:45,580
!لونا! لا يصحّ أن تجلسي على الناس

119
00:07:45,580 --> 00:07:47,820
ليس شخصاً، إنّه مقعد

120
00:07:52,070 --> 00:07:55,650
!غيريكو! عليكِ ألّا تصنعي أشياء خطيرة

121
00:07:55,650 --> 00:07:59,580
"ليس خطيراً، إنّه "فانوس جي-أو الإصدار الثاني

122
00:07:59,580 --> 00:08:03,510
...حسناً، قمت بمجالستهما أيضاً

123
00:08:03,510 --> 00:08:04,830
ماذا قلتِ؟

124
00:08:04,830 --> 00:08:06,080
!يا للفظاظة

125
00:08:07,530 --> 00:08:10,740
لكنّهما ساعدتاني أكثر

126
00:08:15,530 --> 00:08:17,350
!أيّتها الباكية

127
00:08:30,240 --> 00:08:35,070
،أتذكّر كلّ شيء بوضوح
بألبوم صور أو دونه

128
00:08:36,490 --> 00:08:39,620
أنا مسرورة لكونكما صديقتيّ حقّاً

129
00:08:41,340 --> 00:08:42,570
شكراً لكِ

130
00:08:42,570 --> 00:08:46,250
!مهلاً! لا تستبعدنني من هذه الملاطفة

131
00:08:46,250 --> 00:08:47,720
!آسفة، آسفة

132
00:08:47,720 --> 00:08:48,500
...يا إلهي

133
00:08:48,500 --> 00:08:53,380
أيضاً، من يكون هؤلاء؟ أصدقاء لا أعرفهم؟

134
00:09:00,510 --> 00:09:04,360
!يا إلهي، لا بدّ أنّي فكّرت بهم لوهلة

135
00:09:06,870 --> 00:09:08,610
!يا إلهي

136
00:09:09,560 --> 00:09:12,550
!أحسنا السلوك

137
00:09:10,210 --> 00:09:11,780
!آسفة

138
00:09:11,780 --> 00:09:14,660
!لم أفعل شيئاً

139
00:09:12,550 --> 00:09:15,620
!ارجعا

140
00:09:27,840 --> 00:09:28,830
...كلّا

141
00:09:30,670 --> 00:09:31,840
...لا يمكن

142
00:09:34,160 --> 00:09:35,220
!ليس صحيحاً

143
00:09:35,220 --> 00:09:36,880
فيولا، اهدئي

144
00:09:36,880 --> 00:09:38,470
!أرفض التصديق

145
00:09:38,470 --> 00:09:40,080
!أبداً

146
00:09:41,270 --> 00:09:43,150
إنّه زكام

147
00:09:43,150 --> 00:09:44,730
!كلّا

148
00:09:44,730 --> 00:09:48,480
للوقت الراهن، سنعطيكِ حصّة ثلاثة
أيّام من المسحوق الطبّي

149
00:09:52,150 --> 00:09:54,410
شكراً لكما

150
00:09:58,790 --> 00:10:01,160
الظروف الزكاميّة"
"للابنة الصحيّة

151
00:10:02,490 --> 00:10:06,510
أنتم مخطئون، ليس زكاماً

152
00:10:06,510 --> 00:10:09,000
عليكِ تقبّل الأمر

153
00:10:09,000 --> 00:10:11,130
لمَ هي بهذا العناد؟

154
00:10:11,130 --> 00:10:17,510
،لطالما كانت فيولا مفعمةً بالحيويّة
وبالكاد أُصيبت بمرض

155
00:10:17,510 --> 00:10:20,090
لذا ليست معتادةً على توعّك حالتها

156
00:10:20,090 --> 00:10:21,970
وتحاول تجاوز الأمر بالمعنويات

157
00:10:21,970 --> 00:10:24,270
!إنّها مخيّلتي وحسب

158
00:10:24,890 --> 00:10:26,640
يا للعفريتة الصغيرة

159
00:10:26,640 --> 00:10:30,650
يُقال أنّ الأمراض تبدأ في الدماغ، صحيح؟
!المعنويات العالية دواء جيّد

160
00:10:31,590 --> 00:10:34,650
عليكِ ألّا تبالغي في تقدير
تأثير العلاج الوهميّ

161
00:10:34,960 --> 00:10:38,400
تكره أخذ الدواء أيضاً، فتحاول تجنّبه

162
00:10:38,400 --> 00:10:42,410
لأنّ مذاقه فظيع! تكرهه أيضاً، صحيح يا عنقاء؟

163
00:10:43,400 --> 00:10:46,910
لا أعرف، فلم يصبني المرض قطّ

164
00:10:47,670 --> 00:10:50,670
!سموّ الخالد من جديد

165
00:10:55,350 --> 00:10:58,050
حسناً، سأعترف بأنّه زكام

166
00:10:58,420 --> 00:11:00,550
فلتعترفي من البداية المرّة القادمة، حسناً؟

167
00:11:00,550 --> 00:11:02,990
!لكنّي لم أخسر بعد

168
00:11:02,990 --> 00:11:04,050
أمام من؟

169
00:11:07,890 --> 00:11:10,010
أخبرتِني عندما كنت طفلة

170
00:11:10,010 --> 00:11:13,560
أنّنا نصاب بالحُمى لأنّ
أجسادنا تكافح المرض

171
00:11:13,560 --> 00:11:18,570
داخل جسد فيولا

172
00:11:14,940 --> 00:11:18,570
جرثوم

173
00:11:14,940 --> 00:11:18,570
!أنا جرثوم

174
00:11:21,700 --> 00:11:25,710
المناعة

175
00:11:24,280 --> 00:11:27,360
!سأهزمه هنا والآن

176
00:11:30,580 --> 00:11:32,710
!لن أدعه يمسّ ماما

177
00:11:32,710 --> 00:11:37,890
لم يسبق وأن رأيتُ بشريّاً يستجمع
روحاً قتاليّة هكذا على زكام

178
00:11:41,670 --> 00:11:43,970
!كفّي عن الاهتياج

179
00:11:46,810 --> 00:11:49,310
فلتبقي في السرير وحسب اليوم، اتّفقنا؟

180
00:11:49,810 --> 00:11:51,820
أهنالك ما يمكنني فعله لكِ؟

181
00:11:53,730 --> 00:11:57,230
استدعي جاك فروست لي

182
00:11:59,650 --> 00:12:03,740
جاك فروست

183
00:11:59,650 --> 00:12:03,740
روح الثلج والجليد

184
00:12:00,830 --> 00:12:03,040
سأجلب لكِ كمّادة باردة

185
00:12:04,390 --> 00:12:05,740
أيمكنكِ الأكل؟

186
00:12:06,280 --> 00:12:08,850
إن كان هنالك ما تشعرين برغبة
في أكله، فسأعدّه لكِ فوراً

187
00:12:09,990 --> 00:12:12,000
أريد حساءً بالدجاج

188
00:12:14,120 --> 00:12:16,250
!سأصنعه بشكلٍ طبيعيّ

189
00:12:19,660 --> 00:12:22,340
لكنّي مُغذٍّ أكثر

190
00:12:25,550 --> 00:12:29,020
!أقدّر شعورك، لكن لا تتنافس مع الدجاج

191
00:12:31,520 --> 00:12:35,510
حسناً، خذي غفوةً بينما أعدّ الحساء

192
00:12:40,150 --> 00:12:42,900
النوم ضروريّ للتشافي

193
00:12:43,740 --> 00:12:45,910
...أعرف ذلك، لكن

194
00:12:46,750 --> 00:12:51,740
لا يروقني أن أنام عندما تصيبني
الحمّي لأنّي أرى أحلاماً غريبة

195
00:12:53,070 --> 00:12:56,420
!رقص! رقص! رقص

196
00:12:56,420 --> 00:13:02,000
وبدواخ دماغي، يصعب التفريق
بين الحلم والواقع

197
00:13:06,180 --> 00:13:07,440
فيولا؟

198
00:13:08,810 --> 00:13:13,930
في مثل هذه الأوقات يثور سحري
ويقوم بتجسيد أشياء

199
00:13:13,930 --> 00:13:15,940
ثمّ يصعب التمييز أكثر

200
00:13:16,320 --> 00:13:18,820
...كنت هكذا في طفولتي، لكن

201
00:13:18,820 --> 00:13:23,260
مكوّنات الشواء تلمع في ألوان
!قوس المطر وتلعب لعبة الدفع

202
00:13:23,690 --> 00:13:25,690
كوابيس لا مفرّ منها

203
00:13:31,050 --> 00:13:32,150
أشعر بالملل

204
00:13:34,610 --> 00:13:36,820
أمنعكِ من النهوض

205
00:13:36,820 --> 00:13:41,320
!أفهم ذلك، لكنّي أشعر بالملل
!أودّ التحسن فوراً

206
00:13:41,320 --> 00:13:43,540
ربما عليكِ شرب دم حياتي؟

207
00:13:43,540 --> 00:13:45,620
هذا مقرفٌ أكثر من الدواء

208
00:13:46,570 --> 00:13:50,970
ماذا لو خلطته مع طعامٍ
برائحة ومذاق قويّين؟

209
00:13:47,010 --> 00:13:50,970
زباديّ

210
00:13:50,970 --> 00:13:55,600
إنّه يعرض لي دم حياته
...كما لو كان دواءً طبيعيّاً

211
00:13:59,360 --> 00:14:00,360
إنّه قادم

212
00:14:00,670 --> 00:14:02,100
لديّ سطل

213
00:14:02,100 --> 00:14:04,230
...إنّه قادم... سأتقيّح

214
00:14:08,360 --> 00:14:10,430
!فشل تصفية سحر

215
00:14:10,430 --> 00:14:12,220
يحصل هذا عندما يتسبّب مرض أو حادث

216
00:14:12,220 --> 00:14:15,750
بدوران السحر بشكل غير مُنتظم في الجسد

217
00:14:15,750 --> 00:14:18,730
وتتحوّل أيّ طاقة سحريّة غير مُصفّاة
إلى كتلة وتخرج عبر الفم

218
00:14:15,750 --> 00:14:21,000
لمعان وجمال

219
00:14:15,750 --> 00:14:21,000
يصدر صوتاً جميلاً
أثناء خروجه

220
00:14:18,730 --> 00:14:21,000
!فيما يُعرف بالتقيّح

221
00:14:21,000 --> 00:14:22,580
ليس تقيّؤاً

222
00:14:22,580 --> 00:14:24,840
أشعر بتحسّن

223
00:14:24,840 --> 00:14:28,140
لا يشكّل مشاكلاً، ويختفي في دقائق

224
00:14:28,140 --> 00:14:29,890
إنّه عديم الرائحة ونظيف

225
00:14:30,660 --> 00:14:34,640
آسفةٌ يا فيولا، نسيت أنّ الدجاج نفد

226
00:14:34,640 --> 00:14:36,350
...سأذهب لغلي

227
00:14:36,350 --> 00:14:39,410
سأذهب لشراء بعضه، بالإضافة لأيّ ما قد نحتاجه

228
00:14:40,010 --> 00:14:42,900
!كلّا! لا تذهبي يا ماما

229
00:14:42,900 --> 00:14:46,290
أعرف أنّكِ تشعرين بوهن، لكنّي سأرجع سريعاً

230
00:14:46,290 --> 00:14:47,890
انتظري هنا مع عنقاء

231
00:14:48,400 --> 00:14:53,410
!أنتِ ظريفةٌ على الذهاب للبلدة بمفردكِ، ستُختطفين

232
00:14:53,410 --> 00:14:55,430
!فلتقلقي على نفسكِ فحسب

233
00:14:55,880 --> 00:14:58,500
!إذا لم تأخذيني معكِ، خذي بابا

234
00:15:00,590 --> 00:15:01,520
!مرحباً

235
00:15:01,520 --> 00:15:03,420
!مـ-مضى وقتٌ طويل

236
00:15:03,420 --> 00:15:06,310
!لا، أشعر بقلقٍ كبير! سآتي أيضاً

237
00:15:06,310 --> 00:15:08,540
!تعرفين أنّه لا يمكنكِ فعل ذلك

238
00:15:08,890 --> 00:15:10,430
...يا إلهي

239
00:15:11,080 --> 00:15:15,440
سأُخلد مُتعاقدتي للنوم بتهويدة

240
00:15:15,440 --> 00:15:17,430
يمكنكِ الذهاب أثناء نومها

241
00:15:17,430 --> 00:15:20,190
!تهويدة؟ لستُ طفلة لذاك الحدّ

242
00:15:28,250 --> 00:15:29,610
عمتِ مساءً

243
00:15:29,610 --> 00:15:32,820
!كان ذلك آمناً، صحيح؟! أخبرني أنّه كان آمناً

244
00:15:35,660 --> 00:15:37,450
تعاني فيولا-تشان من زكام؟

245
00:15:37,450 --> 00:15:39,660
ذلك نادر

246
00:15:40,100 --> 00:15:41,920
هاكِ، أعطيتكِ إضافةً من عندي

247
00:15:41,920 --> 00:15:43,810
شكراً جزيلاً لكِ

248
00:15:43,810 --> 00:15:46,460
لم تمرض منذ وقتٍ طويل، فاجأني هذا

249
00:15:46,780 --> 00:15:51,200
،كنتُ بخلافها في طفولتي
ويصيبني الزكام طوال الوقت

250
00:15:51,710 --> 00:15:56,900
لذا أتفهّم الشعور من الطرف الآخر تماماً

251
00:15:56,900 --> 00:16:00,290
!من الحسن استغلالكِ لخبرتكِ بشكلٍ بنّاء

252
00:16:00,290 --> 00:16:05,820
.لم يصبني المرض قطّ، فأجد نفسي مكتوفة
لا أعرف ما يحتاجه المرضى أبداً

253
00:16:05,820 --> 00:16:08,520
!قطّ؟ ولو لمرّة واحدة؟

254
00:16:08,870 --> 00:16:09,610
صحيح

255
00:16:10,790 --> 00:16:13,830
بأيّ حال، جعلني هذا أدرك من جديد

256
00:16:13,830 --> 00:16:18,620
يكفي الآباء أن يكون أطفالهم بصحّة وعافية فحسب

257
00:16:18,620 --> 00:16:22,870
أصبتِ، مع أنّ قول ذلك
أسهل من فعله أحياناً

258
00:16:22,870 --> 00:16:26,900
إياكِ ونسيان المضمضة وغسل يديكِ
!عند العودة للمنزل

259
00:16:26,900 --> 00:16:27,880
أجل

260
00:16:28,370 --> 00:16:30,380
...بالمناسبة

261
00:16:30,380 --> 00:16:32,680
ما ذاك المخلوق المفعم بالحيويّة؟

262
00:16:33,100 --> 00:16:35,030
سؤالٌ جيّد

263
00:16:35,890 --> 00:16:36,890
يثير القلق

264
00:16:38,830 --> 00:16:40,120
...أرجوكِ

265
00:16:42,230 --> 00:16:45,080
تذكّريني أنا فحسب

266
00:16:47,160 --> 00:16:49,900
...انسي كلّ شيءٍ عن ذاك الشخص

267
00:16:51,930 --> 00:16:54,640
واكرهيني أنا فقط

268
00:17:00,030 --> 00:17:02,070
آسفة، هل أيقظتكِ؟

269
00:17:07,070 --> 00:17:08,480
سأجلب لكِ منه

270
00:17:09,420 --> 00:17:12,780
هل جسّدت أيّاً من أحلامي؟

271
00:17:13,620 --> 00:17:15,430
كلّا، لم تفعلي

272
00:17:16,150 --> 00:17:17,900
أراودكِ حلمٌ غريب؟

273
00:17:20,480 --> 00:17:22,120
لا أتذكّر

274
00:17:27,720 --> 00:17:29,360
!تعافيت

275
00:17:29,360 --> 00:17:31,940
!ماذا؟! مضى يومٌ واحد فحسب

276
00:17:31,940 --> 00:17:34,940
!رجعت لكامل عافيتي! لم أعد أعاني من أيّ خطب

277
00:17:35,340 --> 00:17:38,540
!هزمتُ كلّ الجراثيم، لذا اطمئنّي يا ماما

278
00:17:39,300 --> 00:17:40,830
شكراً لك

279
00:17:51,650 --> 00:17:53,460
آسفةٌ يا عنقاء

280
00:17:53,460 --> 00:17:57,840
يبدو أنّ مرض الساحرة يؤثر على أليفها

281
00:17:57,840 --> 00:18:00,350
عنقاء، ما الذي تريد أكله؟

282
00:18:00,910 --> 00:18:02,640
ساكي مع بيض نيء

283
00:18:02,640 --> 00:18:06,720
لننتبه جميعاً كي نتفادى
دورة العدوى في منازلنا

284
00:18:12,110 --> 00:18:15,110
قبل 10 أعوام

285
00:18:19,800 --> 00:18:21,800
...صباح الخير يا فيولا

286
00:18:23,550 --> 00:18:24,800
ما الخطب؟

287
00:18:24,800 --> 00:18:26,940
لم أفعلها

288
00:18:34,730 --> 00:18:36,640
!لم أفعلها

289
00:18:38,130 --> 00:18:41,260
!لم ألوّث السرير

290
00:18:48,380 --> 00:18:52,040
هيّا، لا تبكي. أمّكِ ليست غاضبة

291
00:18:53,770 --> 00:18:55,720
هوّني عليكِ

292
00:19:01,370 --> 00:19:03,180
...فيولا، انظري

293
00:19:06,870 --> 00:19:09,300
إنّها... روح ماء

294
00:19:11,680 --> 00:19:13,290
روح؟

295
00:19:30,310 --> 00:19:33,380
أتساءل ما إن انجذبت لسحر فيولا

296
00:19:33,380 --> 00:19:34,810
!ماما

297
00:19:35,330 --> 00:19:38,820
تريد الروح مصادقتكِ

298
00:19:45,870 --> 00:19:51,440
الأرواح كيانات خارقة تسكن كلّ الأشياء

299
00:19:51,890 --> 00:19:53,580
كيانات خارقة؟

300
00:19:53,580 --> 00:19:57,090
آسفة، كان شرحي مُعقّداً، صحيح؟

301
00:19:57,340 --> 00:19:59,130
الأرواح

302
00:19:57,540 --> 00:19:59,130
!الأرواح

303
00:20:01,870 --> 00:20:06,520
حسناً، الأرواح ليست مخلوقات حيّة حقّاً

304
00:20:06,520 --> 00:20:09,360
ببساطة، إنّها السحر نفسه بشكلٍ عام

305
00:20:09,360 --> 00:20:11,250
السحر نفسه؟

306
00:20:11,950 --> 00:20:15,580
،هنالك أرواح في الكثير من الأشياء

307
00:20:15,580 --> 00:20:18,140
مثل الماء كما رأينا، والنار والرياح

308
00:20:18,910 --> 00:20:22,990
لكن لا يتسنّى لنا رؤيتها عادةً، لذا
أعتقد أنّكِ كنتِ محظوظة يا فيولا

309
00:20:22,990 --> 00:20:25,570
حقّاً ذلك؟

310
00:20:26,990 --> 00:20:28,030
...حسناً

311
00:20:28,030 --> 00:20:30,250
!الجنّيات

312
00:20:28,030 --> 00:20:30,250
الجنّيات

313
00:20:31,040 --> 00:20:37,110
الجنّيات هي مخلوقات تُولد
من طاقة العالم الطبيعيّ

314
00:20:37,650 --> 00:20:39,880
إنّها مخلوقات حيّة من ناحية

315
00:20:46,850 --> 00:20:49,950
ماما، هل أنقليس الجنّ جنّيات؟

316
00:20:49,950 --> 00:20:51,890
...حسناً

317
00:20:51,890 --> 00:20:54,770
أنقليس الجنّ عبارة عن وحوش في الواقع

318
00:20:54,770 --> 00:20:56,340
!حقّاً ذلك؟

319
00:20:56,770 --> 00:20:59,770
كلمة "جنّ" تعني الروح

320
00:20:59,770 --> 00:21:03,890
لكنّ سُمّي الأنقليس بذاك الاسم للاشتباه خطأً
بكونه روحاً في الماضي البعيد

321
00:21:03,890 --> 00:21:06,780
فلا نزال نطلق عليهم بالجنّ

322
00:21:06,780 --> 00:21:09,370
لكن بدقّة، فهم وحوش

323
00:21:09,370 --> 00:21:13,000
!لم أعلم أنّهم وحوش

324
00:21:19,260 --> 00:21:21,920
!فيولا، حان وقت الأكل

325
00:21:21,920 --> 00:21:22,800
فيولا؟

326
00:21:24,400 --> 00:21:26,050
لا تزالين تقرئين هذا؟

327
00:21:26,050 --> 00:21:27,090
!ماما

328
00:21:27,550 --> 00:21:28,890
ما الخطب؟

329
00:21:29,890 --> 00:21:34,100
!تبدو الوحوش الخياليّة رائعة! أحبّها

330
00:21:34,910 --> 00:21:38,060
فهمت، آمل أن تلتقي أحداً منها يوماً ما

331
00:21:38,060 --> 00:21:40,570
!أجل! أودّ جلب الكثير منها للمنزل

332
00:21:40,570 --> 00:21:42,830
...ماذا؟ ذلك ليس فكرةً جيّدة

333
00:21:42,830 --> 00:21:44,190
!ستعيش معنا

334
00:21:44,190 --> 00:21:46,950
!لكنّ الوحوش الخياليّة كبيرةٌ جدّاً

335
00:21:46,950 --> 00:21:48,900
!تعيش معنا

336
00:22:59,770 --> 00:23:00,860
!أنا فيولا

337
00:23:00,860 --> 00:23:01,600
!أنا أليسا

338
00:23:01,600 --> 00:23:04,270
الحلقة القادمة في "الظروف العائليّة
:"للساحرة اللا اعتياديّة

339
00:23:04,270 --> 00:23:06,980
!ماذا؟ حصلت فيولا على صديقٍ جديد؟

340
00:23:06,980 --> 00:23:09,610
!ماذا؟ ماما! ما تلك البيضة؟

341
00:23:09,960 --> 00:23:12,140
ظروف الطلب"
"!للغول متأخّر البلوغ

342
00:23:12,140 --> 00:23:14,500
ظروف المراقبة"
"!للبيضة والأخت الكبيرة

343
00:23:14,500 --> 00:23:16,560
!إذاً، كيف هو؟! أخبريني

344
00:23:16,560 --> 00:23:18,960
!ما الذي يجري؟! ما الذي يجري؟