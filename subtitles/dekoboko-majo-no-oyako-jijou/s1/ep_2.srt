1
00:00:04,470 --> 00:00:07,230
!عمّة ليرا، مرحباً

2
00:00:07,550 --> 00:00:09,980
أهلاً بكِ

3
00:00:11,290 --> 00:00:13,240
ما الذي تبحثين عنه اليوم؟

4
00:00:13,240 --> 00:00:17,740
!أعشاب سامّة رجاءً! أحتاجها لهزيمة العدوّ

5
00:00:19,590 --> 00:00:23,000
من تقاتلين بالضبط؟

6
00:01:54,260 --> 00:01:57,030
الظروف الشائعة"
"لتربية الساحرة لطفلة

7
00:02:01,080 --> 00:02:02,560
انتظري قليلاً

8
00:02:03,360 --> 00:02:10,820
لا أصدّق أنّ فيولا الصغيرة كبرت
بما يكفي للتسوّق بمفردها

9
00:02:11,430 --> 00:02:13,570
!لا عجب أن أشعر بتقدّمي في السنّ

10
00:02:13,970 --> 00:02:17,320
تقولين هذا طوال الوقت يا عمّة

11
00:02:17,690 --> 00:02:20,110
بالطبع

12
00:02:20,570 --> 00:02:23,770
...فأتذكّر الأمر كما لو حصل بالأمس

13
00:02:25,240 --> 00:02:27,830
قبل 16 عاماً

14
00:02:25,240 --> 00:02:27,830
قبل 16 عام

15
00:02:25,850 --> 00:02:27,830
...قبل 16 عام

16
00:02:31,770 --> 00:02:35,590
انتظرتُ لفترة، لكن لم يظهر أحد

17
00:02:38,130 --> 00:02:43,230
!عندما سأجد من هجرها، سأسحق جمجمته

18
00:02:42,260 --> 00:02:44,970
ليرا، السنّ 24

19
00:02:44,970 --> 00:02:46,870
!اهدئي رجاءً

20
00:02:46,870 --> 00:02:50,750
!كيف لي؟! كان يمكن أن تموت كما تعرفين

21
00:02:50,750 --> 00:02:53,730
لكنّنا نجهل ظروفه

22
00:02:53,730 --> 00:02:57,680
سأحدّد أيّة عظام أكسر
بناء على دوافعه إذاً

23
00:02:57,680 --> 00:03:00,460
!توقّفي عن نزعتكِ العنيفة قليلاً رجاءً

24
00:03:04,400 --> 00:03:07,400
لمَ تقومين أنتِ بتربيتها؟

25
00:03:07,400 --> 00:03:10,250
بإمكانكِ البحث عن مُتبنّين لها بدل ذلك

26
00:03:11,180 --> 00:03:14,640
تمتلك هذه الطفلة سحراً كثيراً على بشريّة

27
00:03:14,640 --> 00:03:16,500
ولا تستطيع التحكّم به بعد

28
00:03:17,190 --> 00:03:23,860
تستطيع الساحرات والسحرة التحكّم بسحرهم
مُذ ولادتهم بشكلٍ طبيعيّ

29
00:03:24,470 --> 00:03:27,240
لذا أرى أنّ تعليمها استعمال السحر

30
00:03:27,240 --> 00:03:31,270
قد يكون صعباً حتّى بالنسبة
لساحرة، ناهيك عن بشريّ

31
00:03:31,720 --> 00:03:37,270
لم أكن عاديّةً أيضاً، فأعتقد
أنّي قد أستطيع مساعدتها

32
00:03:45,810 --> 00:03:48,040
حسناً، سأساعدكِ

33
00:03:48,360 --> 00:03:49,780
!لا تمانعين؟

34
00:03:49,780 --> 00:03:52,390
هذا ما أتيتِ لطلبه منّي، صحيح؟

35
00:03:52,390 --> 00:03:55,790
أنجبتُ ابناً لتويّ

36
00:03:57,540 --> 00:03:59,800
دعي حليب الرضاعة لي

37
00:03:59,800 --> 00:04:03,630
لذا أملك ثديين

38
00:04:03,630 --> 00:04:05,850
ذلك مُطمئنٌ جدّاً

39
00:04:07,210 --> 00:04:11,960
كنتِ ترضعين صدري لحدٍّ
أشعر زوجي بالغيرة

40
00:04:11,960 --> 00:04:14,460
كنتِ أشبه بوحشٍ مفترس

41
00:04:14,870 --> 00:04:17,310
!لا تستعملي هذا الوصف رجاءً

42
00:04:22,030 --> 00:04:23,320
!شكراً لك

43
00:04:23,830 --> 00:04:26,840
أنا أدين لكِ حقّاً

44
00:04:28,350 --> 00:04:31,190
على الأطفال ألّا يهتمّوا بتلك الأشياء

45
00:04:31,190 --> 00:04:35,600
كما أرى أنّ أليسا مرّت بعناءٍ أكبر

46
00:04:35,600 --> 00:04:36,720
ماما؟

47
00:04:36,720 --> 00:04:37,580
أجل

48
00:04:38,660 --> 00:04:42,760
تميل للركض في اتّجاهات غريبة
عندما تفرط في التفكير كما تعرفين

49
00:04:42,760 --> 00:04:46,580
كانت غارقة في الحيرة حيال
تربية طفل أيضاً

50
00:04:47,220 --> 00:04:51,010
بدأت بالبحث في سحر حليب الصدر حتّى

51
00:04:51,010 --> 00:04:52,790
عانت بحقّ

52
00:04:54,450 --> 00:04:57,650
!لا جدوى... لا أستطيع النجاح

53
00:04:57,650 --> 00:05:01,590
!لمَ تفعلين هذا؟ أنتِ ترضعينها حليباً كافياً سلفاً

54
00:05:03,690 --> 00:05:05,100
لكن كتب التربية هذه

55
00:05:05,100 --> 00:05:07,930
،تقول أنّه ما لم أرضعها من صدري
!فلستُ أحبّها بما يكفي

56
00:05:10,240 --> 00:05:12,290
!هراء مزخرف

57
00:05:12,290 --> 00:05:13,250
!بيديكِ العاريتين؟

58
00:05:13,250 --> 00:05:16,510
استغلّي هذا الوقت لغناء أغنية لها

59
00:05:16,510 --> 00:05:18,630
!بدل إهداره على كتب مُريبة

60
00:05:18,630 --> 00:05:22,740
سيستمرّ نبض قلبها وهضم معدتها

61
00:05:22,740 --> 00:05:24,700
!سواءً أرضعتِها من صدرك أم لا

62
00:05:24,700 --> 00:05:26,010
!أ-أجل

63
00:05:26,010 --> 00:05:29,280
أخبريني بكلّ ما يقلقكِ الآن

64
00:05:29,280 --> 00:05:30,790
سأساعدكِ

65
00:05:30,790 --> 00:05:32,890
ستزيدين الطين بلّة إن فزعتِ من جديد

66
00:05:34,350 --> 00:05:36,390
شكراً جزيلاً لكِ

67
00:05:36,710 --> 00:05:38,850
...هنالك شيء آخر في الواقع

68
00:05:38,850 --> 00:05:41,650
...بشأن تحكّمها بالسحر

69
00:05:41,650 --> 00:05:46,150
تستدعي فيولا وحوشاً في نومها

70
00:05:46,860 --> 00:05:50,660
أقلق من استمرار ذلك في بلوغها

71
00:05:50,660 --> 00:05:53,310
فهمت، إنّها تلوّث السرير

72
00:05:53,040 --> 00:06:00,550
سحر السرير

73
00:05:53,310 --> 00:05:54,920
!تلويث السرير

74
00:05:54,920 --> 00:05:58,230
تتوقّف تلك الحوادث مع البلوغ

75
00:05:58,230 --> 00:06:00,670
فلا تقلقي كثيراً حيالها الآن

76
00:06:00,670 --> 00:06:03,550
!لا تقارني السحر بالتبوّل رجاءً

77
00:06:03,550 --> 00:06:06,240
هل تبكي ليلاً؟ أأنت بخير؟

78
00:06:06,240 --> 00:06:10,680
ذلك مُتفاوت، لكنّنا لا نستطيع
النوم أبداً في الليالي السيّئة

79
00:06:10,680 --> 00:06:14,340
ذلك أشبه بالمشي أثناء النوم للأطفال

80
00:06:14,340 --> 00:06:17,060
راقبيها لمدّة دقيقة وستتوقّف عن البكاء

81
00:06:17,060 --> 00:06:20,690
يتفاوت حسب الشخص

82
00:06:18,720 --> 00:06:20,690
!ماذا؟

83
00:06:22,590 --> 00:06:24,740
،رأيتُ بأن نبقى مُستيقظتين إذا أبت النوم

84
00:06:24,740 --> 00:06:27,210
لكن أدّى ذلك لجولة مكنسة
!في آخر الليل

85
00:06:28,200 --> 00:06:31,700
أنتِ تتميّزين بالجرأة أحياناً

86
00:06:31,700 --> 00:06:33,800
...هناك أيضاً

87
00:06:33,800 --> 00:06:37,610
تعرفين كيف أنّ الرضّع أقوى مما يبدو عليهم؟

88
00:06:37,700 --> 00:06:40,210
قبضة
قويّة

89
00:06:37,960 --> 00:06:39,870
!قبضاتهم قويّة

90
00:06:41,210 --> 00:06:43,590
ركلات
قويّة

91
00:06:41,880 --> 00:06:43,590
!ركلاتهم قويّة

92
00:06:44,030 --> 00:06:46,880
حسناً، لا يعرفون التقليل من حدّتهم

93
00:06:46,880 --> 00:06:50,760
في حالة فيولا تحديداً، تمتلك قوّة ضخمة

94
00:06:54,730 --> 00:06:57,350
إنّها وحش صغير حرفيّاً

95
00:06:58,760 --> 00:07:00,950
!قد نكون مُتآلفتين

96
00:07:00,950 --> 00:07:05,760
قال والدايّ أنّي كنت أحطّم المنزل
عندما كنت رضيعة أيضاً

97
00:07:06,490 --> 00:07:09,240
كانت تلك قوّتكِ البدنيّة وحسب، صحيح؟

98
00:07:09,500 --> 00:07:13,990
لكن ألا يشغلكِ ذلك على
القيام بالأعمال المنزليّة؟

99
00:07:13,990 --> 00:07:16,230
لا أواجه مشاكلاً من تلك الناحية

100
00:07:16,230 --> 00:07:19,120
يمكنني تدبّر المهام البسيطة بالسحر

101
00:07:19,750 --> 00:07:22,250
ذلك مُذهل

102
00:07:22,250 --> 00:07:26,490
من يربّون الأطفال دون السحر مُذهلون أكثر

103
00:07:26,490 --> 00:07:30,130
تواجهين صعوبةً أكبر بقيامكِ
...بكلّ شيء بنفسك، بينما أنا

104
00:07:31,190 --> 00:07:36,010
إنسانة فظيعة تأخذ طرق
مُختصرة في كلّ شيء

105
00:07:36,010 --> 00:07:38,130
حسناً، توقّفي عندكِ

106
00:07:38,130 --> 00:07:40,490
الطرق المُختصرة من أساسيّات الأعمال المنزليّة

107
00:07:40,490 --> 00:07:45,830
كنتُ آكل القمح من الكيس
!مباشرةً لتفادي الطهو

108
00:07:45,830 --> 00:07:47,520
!أليس ذلك مُختصراً جدّاً؟

109
00:07:47,520 --> 00:07:50,160
لا تقلّدوا هذا من فضلكم

110
00:07:51,890 --> 00:07:55,420
لا داعي للطهو عندما لا يكون زوجي في البيت

111
00:07:55,420 --> 00:07:57,660
أنتِ مُذهلةٌ يا ليرا-سان

112
00:07:58,290 --> 00:08:02,660
وأنا بالمقارنة، أُقدم على أخطاء وحسب

113
00:08:02,660 --> 00:08:04,840
لستُ أمّاً جيّدة

114
00:08:05,410 --> 00:08:07,450
ما الذي تقولينه؟

115
00:08:08,300 --> 00:08:13,880
انتباهكِ للتفاصيل أنقذني أنا أيضاً

116
00:08:15,070 --> 00:08:17,090
يكفي هذا كطعام أطفال، صحيح؟

117
00:08:17,090 --> 00:08:19,810
!لا يستطيع معظم الناس أكل هذا القدر

118
00:08:20,290 --> 00:08:24,310
لا نعرف ما هي الأخطاء إلى أن نُقدم عليها

119
00:08:24,310 --> 00:08:28,350
أتفهّم قلقكِ لاهتمامكِ برضيعتكِ

120
00:08:28,350 --> 00:08:32,590
لكن تربّى كلّ عائلة صغرها بشكلٍ مُختلف

121
00:08:33,120 --> 00:08:37,070
،إذا استمرّت ابتسامات عائلتكم معاً
فذلك يعني أنّكِ على الطريق الصحيح

122
00:08:38,530 --> 00:08:39,960
...ليرا-سان

123
00:08:45,810 --> 00:08:49,840
أنجبتِ طفلكِ الأوّل للتوّ، صحيح؟

124
00:08:50,240 --> 00:08:52,500
من أين لكِ هذا الإحساس بالسلطة؟

125
00:08:52,500 --> 00:08:55,140
ليس مهمّاً

126
00:08:56,440 --> 00:08:57,840
!مرحباً

127
00:08:57,840 --> 00:08:59,850
هل رأيتِ فيولا؟

128
00:09:00,650 --> 00:09:01,940
!ماما

129
00:09:02,570 --> 00:09:05,500
كنّا نتكلّم عنكِ

130
00:09:05,500 --> 00:09:08,730
ماذا؟ لا شيء سيّئ، صحيح؟

131
00:09:09,870 --> 00:09:12,000
كلّا! تريدين أن تعرفي؟

132
00:09:12,000 --> 00:09:13,120
!أجل

133
00:09:13,120 --> 00:09:14,490
هل أخبركِ يا ترى؟

134
00:09:13,120 --> 00:09:14,490
...أليسا

135
00:09:14,490 --> 00:09:16,460
!هيّا، أخبريني

136
00:09:14,860 --> 00:09:18,950
لا أعتقد أنّكِ أخطأتِ أبداً

137
00:09:16,460 --> 00:09:18,070
سأفكّر بالأمر

138
00:09:18,070 --> 00:09:20,240
لمَ تضايقينني؟

139
00:09:20,240 --> 00:09:22,020
سأفكّر

140
00:09:20,790 --> 00:09:23,330
مشاهدتكما تُشعرني أنّ عليّ

141
00:09:23,330 --> 00:09:26,250
تحسين علاقتي مع ابني

142
00:09:26,800 --> 00:09:29,300
إنّه يمرّ بالمراهقة وحسب

143
00:09:29,650 --> 00:09:32,250
لم أره مؤخراً، أهو بخير؟

144
00:09:32,250 --> 00:09:35,880
انتظري قليلاً، سأنادي عليه

145
00:09:36,950 --> 00:09:40,690
!أيّها الطفل المُدلّل! أتت فيولا وأمّها

146
00:09:40,690 --> 00:09:44,470
اصمتي أيّتها الشمطاء! سهرتُ
!طوال الليل، لذا دعيني أنام

147
00:09:50,190 --> 00:09:52,880
!كيف تخاطب أمّك بهذه النبرة؟

148
00:09:52,880 --> 00:09:54,750
!لا تقتحمي غرفتي هكذا

149
00:09:54,750 --> 00:09:56,280
!خُذ هذه

150
00:09:56,280 --> 00:09:59,460
!آسفٌ على تطاولي

151
00:09:59,460 --> 00:10:04,240
...يبدو أنّ كلّ عائلة تربّي أطفالها بشكلٍ مُختلف

152
00:10:18,170 --> 00:10:22,220
ماما، أنهيتُ قطف الأعشاب هنا

153
00:10:22,220 --> 00:10:24,720
حسناً، انتظري قليلاً

154
00:10:25,330 --> 00:10:28,060
...قطفنا أعشاب طبيّة تكفي، لذا المرّة التالية سنقطف أوراق

155
00:10:28,060 --> 00:10:29,480
!أليسا

156
00:10:32,160 --> 00:10:33,610
!فينيل-كن

157
00:10:37,890 --> 00:10:40,950
الظروف العاطفيّة"
"!لمقام الأخ الصغير

158
00:10:42,130 --> 00:10:43,910
هل الوقت مناسبٌ الآن؟

159
00:10:43,910 --> 00:10:44,740
أجل

160
00:10:45,190 --> 00:10:48,190
أتيتُ لشراء بضاعة هذا الشهر

161
00:10:51,500 --> 00:10:54,750
شكراً على قدومك إلى هنا دوماً

162
00:10:55,440 --> 00:11:00,100
كلّا، أنا أتطلّع للقائكِ
كلّ شهر يا أليسا-سان

163
00:11:05,670 --> 00:11:07,790
!ما الذي تحرقينه أيّتها الحقيرة؟

164
00:11:07,790 --> 00:11:08,890
سمّ

165
00:11:08,890 --> 00:11:11,400
!لا تقتليني فور وصولي هنا

166
00:11:14,450 --> 00:11:16,290
!أعتذر على ما فعلته ابنتي

167
00:11:16,290 --> 00:11:17,900
هل تأذّيت؟

168
00:11:17,900 --> 00:11:20,900
لا تقلقي يا أليسا-سان

169
00:11:20,900 --> 00:11:24,910
!يا إلهي! لمَ تتنمّرين على فينيل-كن؟

170
00:11:24,910 --> 00:11:26,460
!اعتذري له

171
00:11:26,460 --> 00:11:29,160
هو من ابتدأ الأمر عند لقائنا الأوّل

172
00:11:29,960 --> 00:11:31,420
فيولا، سنّ السادسة

173
00:11:29,960 --> 00:11:31,420
سُررت بلقائكِ

174
00:11:32,170 --> 00:11:35,920
يمكنكِ اعتباري والدك

175
00:11:40,420 --> 00:11:43,090
!كرهتُك مُذ حينها

176
00:11:43,090 --> 00:11:45,430
!أنتِ تتمادين بضغينتك

177
00:11:45,430 --> 00:11:49,060
!أنت ترمق أمّي بنظراتك! إنّك عدويّ

178
00:11:49,060 --> 00:11:52,310
!لا-لا-لا أرمقها يا حمقاء

179
00:11:52,310 --> 00:11:54,630
!صحيح، أنتِ تتصرّفين بفظاظة

180
00:11:54,630 --> 00:11:58,080
لا شيء بيني وبين فينيل-كن
!من ذاك القبيل

181
00:11:58,470 --> 00:12:01,060
!إنّه بمثابة أخي الصغير

182
00:12:01,950 --> 00:12:04,600
...صـ-صحيح

183
00:12:07,010 --> 00:12:08,860
!أيّتها الطفلة الكريهة

184
00:12:09,580 --> 00:12:13,620
كنت لا تزال طفلاً عند لقائنا الأوّل

185
00:12:13,210 --> 00:12:20,460
قبل مئة عام

186
00:12:13,620 --> 00:12:17,340
!كبرت كثيراً، يا للذكريات

187
00:12:17,340 --> 00:12:20,460
لم يتغيّر مظهركِ أبداً يا أليسا-سان

188
00:12:21,020 --> 00:12:24,100
كنتُ معها مذ كنت رضيعةً بالطبع

189
00:12:24,100 --> 00:12:25,720
وما في ذلك؟

190
00:12:26,150 --> 00:12:30,930
أتذكّر مرافقتك في المشي ليلاً
لأنّك كنت تخاف الوحوش

191
00:12:30,930 --> 00:12:33,230
!فلتنسي ذلك رجاءً

192
00:12:33,230 --> 00:12:36,380
غيّرت حفّاظاتي حتّى

193
00:12:36,380 --> 00:12:38,980
!أيّ مُنافسة هذه؟

194
00:12:38,980 --> 00:12:42,860
حسناً، حسناً، ما رأيكما باحتساء الشاي؟

195
00:12:42,860 --> 00:12:45,210
فينيل-كن، اجلس وانتظرني رجاءً

196
00:12:45,210 --> 00:12:47,490
...ليس عليكِ أن

197
00:12:53,930 --> 00:12:56,100
هيّا يا فيولا، خذيه له

198
00:12:56,100 --> 00:12:57,500
حسناً

199
00:13:00,890 --> 00:13:01,850
هاك

200
00:13:01,850 --> 00:13:03,630
!ما أنت؟ طاهية رامين شرّيرة؟

201
00:13:03,630 --> 00:13:06,130
!هذه قذارة! لا يصحّ بك

202
00:13:06,130 --> 00:13:08,330
!ستشربينه عقاباً

203
00:13:08,330 --> 00:13:10,300
!وحضّري كأساً آخراً له

204
00:13:11,260 --> 00:13:12,640
!آسفة

205
00:13:14,030 --> 00:13:16,230
تعرّضتِ للتوبيخ

206
00:13:23,630 --> 00:13:27,320
لا... كانت تخطّط لهذا من البداية

207
00:13:27,320 --> 00:13:30,940
!كيلا أشرب الشاي الذي حضّرته أليسا-سان

208
00:13:36,430 --> 00:13:40,040
حسناً، هذه بضاعة هذا الشهر

209
00:13:40,040 --> 00:13:42,610
شكراً جزيلاً لك

210
00:13:43,170 --> 00:13:47,540
شراؤك لهذا القدر شهريّا يُساعدني كثيراً

211
00:13:47,540 --> 00:13:50,340
أنا من يتلقّى المساعدة

212
00:13:50,340 --> 00:13:54,180
فأدويتكِ وأعشابكِ تلقى رواجاً كبيراً

213
00:13:54,180 --> 00:13:58,850
ماذا عن اليبْروح المسلي من انتقائي الخاصّ؟

214
00:13:59,290 --> 00:14:01,860
أكره الاعتراف، لكنّ شعبيّته كبيرة

215
00:14:02,820 --> 00:14:06,970
هلّ تودّ جواهر الوحل الثمينة التي صقلتُها؟

216
00:14:06,970 --> 00:14:08,930
إنّها محض كرات وحل

217
00:14:07,070 --> 00:14:11,070
محض كرات وحل

218
00:14:08,930 --> 00:14:11,070
!لحظة، مـ-من تكون؟

219
00:14:11,070 --> 00:14:14,130
إنّه عنقاء، أصبح أليفي

220
00:14:14,130 --> 00:14:16,830
أليس أقرب لخربشة قمتِ بتجسيدها؟

221
00:14:17,360 --> 00:14:22,650
لا تضايقي أليسا-سان بأخذ
...المزيد من... الغرباء

222
00:14:22,650 --> 00:14:23,840
!ابتعد

223
00:14:23,840 --> 00:14:26,840
ماذا؟! لا داعي لتخبرني بذلك

224
00:14:27,620 --> 00:14:31,340
ودّعت بابا أيضاً كما طلبت ماما

225
00:14:33,640 --> 00:14:38,100
!بـ-بابا؟! ودّعتِ؟! ماذا؟

226
00:14:38,100 --> 00:14:41,100
!غولم! إنّها تتكلّم عن غولم

227
00:14:42,430 --> 00:14:46,480
!تبّاً! كان سوء فهم، لكن لا يسعني الاطمئنان

228
00:14:47,090 --> 00:14:49,940
يجب أن أتملّص من مقام الأخ الصغير فوراً

229
00:14:47,930 --> 00:14:49,940
أحببتِه لذاك الحدّ؟

230
00:14:49,940 --> 00:14:51,400
أجل

231
00:14:49,940 --> 00:14:51,740
!وإلّا سيفوت الأوان حقّاً

232
00:14:52,110 --> 00:14:55,780
لكنّ إعلان حُبّي الآن
فوق ما أستطيع فعله

233
00:14:55,780 --> 00:14:58,500
لم أمضِ قرناً وإعجابي معلّق بها للتسلية فقط

234
00:14:58,840 --> 00:15:02,850
يجب أن أبدأ بجعلها تلاحظ أنّي رجل بالغ

235
00:15:03,500 --> 00:15:06,870
!سأفعلها! سأفعلها

236
00:15:06,870 --> 00:15:10,510
!سأقول شيئاً رائعاً بحيث سيتعيّن عليها ملاحظتي

237
00:15:13,550 --> 00:15:19,140
...حسناً... حسناً... حسناً

238
00:15:20,210 --> 00:15:22,270
أليسا-سان؟

239
00:15:22,900 --> 00:15:26,720
ماذا ستفعلين لو تحوّلت يديّ إلى قرنبيط؟

240
00:15:26,320 --> 00:15:28,280
ابن غابة

241
00:15:28,280 --> 00:15:29,200
!ماذا؟

242
00:15:29,200 --> 00:15:30,530
!سأقلق

243
00:15:31,780 --> 00:15:34,780
!أ-أأنت بخير؟ أتعاني من إنهاك؟

244
00:15:35,780 --> 00:15:40,940
كلّا... لم أردها أن تلاحظني هكذا

245
00:15:41,490 --> 00:15:45,440
!وجدتُها! سأجلب لك شيئاً حلواً! كعكة ربما

246
00:15:45,440 --> 00:15:47,170
!لا تكلّفي نفسكِ رجاءً

247
00:15:48,060 --> 00:15:50,080
اسمع يا فينيل

248
00:15:50,080 --> 00:15:51,420
ماذا تريدين؟

249
00:15:51,420 --> 00:15:55,400
تريديني أن أخبرك سبب عدم إزالتي لك بعد؟

250
00:15:55,400 --> 00:15:57,560
هذه افتتاحيّة مُرعبة

251
00:15:57,560 --> 00:16:01,560
ذلك لثقتي

252
00:16:01,560 --> 00:16:05,310
!بأنّك تافهٌ ولا تستطيع تحقيق أيّ شيء

253
00:16:05,310 --> 00:16:06,820
!تهزئين بي؟

254
00:16:06,820 --> 00:16:08,870
لكن لا يمكنني التراخي

255
00:16:08,870 --> 00:16:11,210
سأواصل التدخّل، لذا كن على استعداد

256
00:16:11,210 --> 00:16:13,820
لن أستعدّ لكِ أيّتها الحمقاء

257
00:16:14,180 --> 00:16:16,920
إنّكِ لا تتّعظين أبداً

258
00:16:16,920 --> 00:16:19,770
تثيرين غضب أليسا-سان منكِ دوماً

259
00:16:19,770 --> 00:16:22,830
!ربما عليكِ أن تكوني أذكى في تدخّلاتكِ قليلاً

260
00:16:22,830 --> 00:16:24,460
!النَفس النهائيّ

261
00:16:26,770 --> 00:16:30,610
من الآن فصاعداً، سأستعمل غطاء
حادثة" أثناء اللعب مع عنقاء"

262
00:16:30,610 --> 00:16:32,590
!شكراً على شرحك

263
00:16:33,210 --> 00:16:35,840
!حسناً، ها هو الكعك

264
00:16:37,350 --> 00:16:38,900
!ما الذي تفعله؟

265
00:16:39,240 --> 00:16:42,110
أعطيته قُبلة صداقة

266
00:16:42,110 --> 00:16:43,980
!كان رأسه بأكمله في فمك

267
00:16:44,390 --> 00:16:46,480
فينيل-كن، أأنت بخير؟

268
00:16:48,070 --> 00:16:51,560
!أنفاس المسكين مُتسارعة من الصدمة

269
00:16:51,560 --> 00:16:54,990
!كلّا، إنّه يلهث لأنّه في حضنك

270
00:16:55,360 --> 00:16:57,870
آسفة

271
00:16:57,870 --> 00:17:00,120
تلقّت توبيخاً شديداً

272
00:17:02,620 --> 00:17:05,990
!آسفة! آسفة! أنا آسفة حقّاً

273
00:17:05,990 --> 00:17:09,070
لا تقلقي، لا حاجة للانحناء

274
00:17:09,070 --> 00:17:11,580
لا يمكننا إيقاف ثوران الابنة
المُولعة بالأمّ تلك

275
00:17:11,580 --> 00:17:14,390
بدل تغييرها، لنجرّب التعايش معها

276
00:17:14,390 --> 00:17:16,010
!كأنّها حيوان بريّ؟

277
00:17:16,650 --> 00:17:20,370
لكن، لا تشعري بتأنيب الضمير حقّاً

278
00:17:21,200 --> 00:17:24,020
أعرفها مُذ كانت طفلة

279
00:17:24,690 --> 00:17:28,130
أعرف أنّ هذا هو مزاحها الخشن

280
00:17:29,000 --> 00:17:35,530
كـ-كان موضوع الأب دعابة، لكني
...قد أعتبرها من العائلة

281
00:17:35,530 --> 00:17:38,210
آسف، هذا تمادٍ منّي

282
00:17:38,210 --> 00:17:40,530
!لا، البتّة

283
00:17:43,660 --> 00:17:47,100
شكراً على مجاراتك لها

284
00:17:51,000 --> 00:17:55,180
آمل أن تواصل الاعتناء بها

285
00:17:58,970 --> 00:18:03,560
!يستحيل أن أنافس ابنتها، صحيح؟

286
00:18:04,170 --> 00:18:07,490
،فينيل-كن، تعال لزيارتنا في أيّ وقت
حتّى في غير يوم الشراء

287
00:18:08,410 --> 00:18:09,310
حسناً

288
00:18:17,430 --> 00:18:20,020
في المرّة القادمة، سأنصب فخاخاً سحريّة

289
00:18:20,470 --> 00:18:23,820
!أقرّ على روحكِ المُثابرة

290
00:18:36,940 --> 00:18:41,070
أنا سعيدٌ لأنّ أليسا-سان كانت مسرورة

291
00:18:41,070 --> 00:18:43,530
لا شيء يُسعد التاجر أكثر

292
00:18:51,610 --> 00:18:54,380
ما الذي تفعلينه؟

293
00:19:01,510 --> 00:19:02,870
ستجرّب، صحيح؟

294
00:19:05,610 --> 00:19:07,120
بالطبع ستجرّب

295
00:19:15,570 --> 00:19:18,130
!ماذا؟

296
00:19:19,160 --> 00:19:21,970
ستجرّب صيد أنقليس الجنّ، صحيح؟

297
00:19:21,970 --> 00:19:22,760
ماذا؟

298
00:19:22,760 --> 00:19:28,770
صيد أنقليس الجنّ

299
00:19:24,660 --> 00:19:28,050
!صيد أنقليس الجنّ

300
00:19:29,570 --> 00:19:31,950
هاك، صنّارتك

301
00:19:31,950 --> 00:19:34,650
لن ألعب هذه اللعبة المُريبة

302
00:19:34,650 --> 00:19:37,810
لا تقلق، لا خطّاف بها

303
00:19:37,810 --> 00:19:43,310
عندما يبتلع إنقليس جنٍّ الطعم، سيعرض نفسه

304
00:19:43,310 --> 00:19:43,910
راقب

305
00:19:47,040 --> 00:19:49,910
إن أمسكت بثلاثة منها خلال
ثلاث دقائق، ستفوز

306
00:19:49,910 --> 00:19:52,520
!أخبرتكِ، لن أفعلها

307
00:19:53,990 --> 00:19:56,920
الجائزة هي صورة جذّابة سرّية

308
00:19:59,720 --> 00:20:01,930
أيمكن أن تكون لأيسا-سان؟

309
00:20:01,930 --> 00:20:06,930
!حسناً! سأصطادها كلّها

310
00:20:06,930 --> 00:20:08,640
...استعداد

311
00:20:08,990 --> 00:20:09,930
!انطلاق

312
00:20:21,320 --> 00:20:24,320
!ماذا؟ لا تبتلع الطعم أبداً

313
00:20:28,080 --> 00:20:31,450
!إنّها تضايقني حقّاً

314
00:20:34,920 --> 00:20:37,700
!فلتقم بهزّها الآن! كلّا، للأسفل

315
00:20:37,700 --> 00:20:40,450
اصمتي، أنتِ تشتّتين انتباهي

316
00:20:43,220 --> 00:20:44,610
ما هذا؟

317
00:20:44,610 --> 00:20:46,520
!ها هي! فرصتك الكبيرة

318
00:20:46,520 --> 00:20:48,780
!الذهبيّ! سيظهر الذهبيّ

319
00:20:48,780 --> 00:20:51,720
...الذهبيّ؟ أتقصدين أنّه

320
00:20:56,530 --> 00:21:00,540
ها هو! أنقليس الجنّ الذهبيّ
!نادرٌ جدّاً ومحظوظ

321
00:21:00,540 --> 00:21:02,840
!تحتاج واحداً للفوز فحسب

322
00:21:03,240 --> 00:21:05,160
!حسنٌ

323
00:21:05,160 --> 00:21:12,320
،سأصطادك مهما تطلّب الأمر
!وأحصل على صورة أليسا-سان

324
00:21:13,620 --> 00:21:14,830
!ها هو

325
00:21:15,350 --> 00:21:16,620
!إنّه قويٌّ جدّاً

326
00:21:17,470 --> 00:21:19,840
!أشعر أنّه يسحبني

327
00:21:25,880 --> 00:21:29,380
!تعال

328
00:21:30,260 --> 00:21:34,240
!هل رأيتِ؟ فعلتُها

329
00:21:36,840 --> 00:21:40,150
!مؤسف، حصلت على عنقاء

330
00:21:41,110 --> 00:21:42,340
...أنتِ

331
00:21:44,090 --> 00:21:48,740
لم تنويا تركي أصطاد واحدة منذ البداية، صحيح؟

332
00:22:58,930 --> 00:23:00,090
أنا أليسا

333
00:23:00,090 --> 00:23:01,290
أنا فيولا

334
00:23:01,290 --> 00:23:04,210
الحلقة القادمة في "الظروف العائليّة
:"للساحرة اللا اعتياديّة

335
00:23:04,210 --> 00:23:06,820
!ألبوم صور لماما؟ دعيني أرى
!دعيني أرى! دعيني أرى

336
00:23:06,820 --> 00:23:09,450
!اهدئي يا فيولا! أنتِ تعانين من حمّى

337
00:23:09,450 --> 00:23:11,290
الظروف الحنينيّة لفتيات"
"!جلسات الساحرات

338
00:23:11,290 --> 00:23:13,680
الظروف الزكاميّة"
"!للابنة الصحيّة

339
00:23:15,250 --> 00:23:19,080
!أخبرتكِ بملازمة الفراش