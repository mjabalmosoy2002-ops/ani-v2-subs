1
00:00:01,270 --> 00:00:04,440
!حسناً، سنعلن النتيجة الآن

2
00:00:07,320 --> 00:00:11,820
...الفائزة بهذه المعركة ومن ستتقدّم لمسرح الغروب هي

3
00:00:12,820 --> 00:00:15,160
!"هابّي آراوند"

4
00:00:17,780 --> 00:00:19,130
!نجحنا

5
00:00:19,130 --> 00:00:20,900
!شكراً لكم

6
00:01:59,970 --> 00:02:02,010
"صوت التطوّر"

7
00:02:00,980 --> 00:02:02,010
،إذاً

8
00:02:02,010 --> 00:02:05,770
احتفالاً بحصولنا على مكان
...في مسرح الغروب

9
00:02:05,770 --> 00:02:09,130
!نخبكنّ

10
00:02:09,130 --> 00:02:11,840
أهناك ما يحتفلن به؟

11
00:02:11,840 --> 00:02:13,420
يبدو ذلك

12
00:02:18,360 --> 00:02:19,830
!لذيذة

13
00:02:20,780 --> 00:02:24,390
!أدّت أغنية ري الجديدة مفعولها حقّاً

14
00:02:24,810 --> 00:02:25,740
!أجل

15
00:02:25,740 --> 00:02:28,000
!فزنا بفضلك على الأغلب يا ري-تشان

16
00:02:28,000 --> 00:02:31,560
كلا، لم تكن أنا فحسب

17
00:02:31,560 --> 00:02:33,250
كلّكن اجتهدتن

18
00:02:33,250 --> 00:02:36,810
لكنّي أظنّك أكثر من اجتهدت يا ري-تشان

19
00:02:36,810 --> 00:02:40,260
ريكو، لا تتكلمي وفمكِ ممتلئ

20
00:02:40,260 --> 00:02:44,390
صحيحٌ أنّه كان لغناء ري تأثيرٌ كبير

21
00:02:44,390 --> 00:02:47,240
مكّننا ذلك من فعل المزيد في عرضنا

22
00:02:47,240 --> 00:02:49,890
وأرى أنّ قوّتنا ارتفعت بالتأكيد

23
00:02:49,890 --> 00:02:53,160
لكن لا يمكننا التخاذل الآن

24
00:02:53,160 --> 00:02:54,900
فالمنافسة الحقيقيّة بانتظارنا

25
00:02:56,280 --> 00:03:00,030
صحيح، المنافسة الحقيقيّة هي
مسرح الغروب في مهرجان يوبا

26
00:03:00,030 --> 00:03:04,490
كما قد نواجه بيكي بي-كي هناك

27
00:03:04,490 --> 00:03:07,410
...مواجهة بيكي بي-كي على مسرح الغروب

28
00:03:07,780 --> 00:03:10,160
!سيكون ذلك رائعاً جدّاً

29
00:03:16,450 --> 00:03:20,260
"بخصوص المنافسة ضدّ "هابّي آراوند
...في اليوم الفائت

30
00:03:21,760 --> 00:03:24,140
تبقى النتائج نتائجاً، لا تغيير لها

31
00:03:24,910 --> 00:03:26,390
سيكون هذا درساً مفيداً لكنّ

32
00:03:26,390 --> 00:03:29,390
أتأمّل منكنّ جهوداً أكبر في المستقبل

33
00:03:29,390 --> 00:03:30,640
نهاية كلامي

34
00:03:30,640 --> 00:03:33,650
"غرفة التبديل"

35
00:03:31,110 --> 00:03:33,650
كانت أقلّ قسوّةً مما توقّعت

36
00:03:33,950 --> 00:03:34,860
!أجل، أجل

37
00:03:34,860 --> 00:03:37,210
!ظننتُها ستغضب بشدّة

38
00:03:37,210 --> 00:03:41,920
صحيح، ظننتُها ستكون أشدّ علينا

39
00:03:41,920 --> 00:03:43,030
...لكن

40
00:03:43,510 --> 00:03:46,620
"أتأمّل منكنّ جهوداً أكبر في المستقبل"

41
00:03:46,620 --> 00:03:49,260
أيّ جهود علينا بذلها بالضبط؟

42
00:03:49,260 --> 00:03:52,640
أعتقد أنّها تعني أنّ علينا
الاجتهاد أكثر في التمارين بدايةً

43
00:03:52,640 --> 00:03:53,830
صحيح

44
00:03:53,830 --> 00:03:57,430
هذا كلّ ما يسعنا فعله الآن

45
00:04:08,500 --> 00:04:09,850
...اسمعي

46
00:04:09,850 --> 00:04:11,050
ألا تشعرين بالتعب؟

47
00:04:11,890 --> 00:04:13,470
،بلى

48
00:04:13,470 --> 00:04:15,730
لكن لن يكون تمريناً بخلاف ذلك

49
00:04:13,480 --> 00:04:16,470
!أجل، كانت تلك "فلور كيلر" لمير4ميد

50
00:04:16,870 --> 00:04:19,770
!إنّها أغنية قاتلة كما يُوحي العنوان

51
00:04:19,770 --> 00:04:25,800
حسناً، الأغنية التالية هي من الوحدة التي
غلبت فوتون ميدين، وستشارك في مسرح الغروب

52
00:04:25,800 --> 00:04:28,920
!"آخر أغنية لـ "هابّي آراوند

53
00:04:28,920 --> 00:04:33,100
!فلتستمعوا لها رجاءً! "براند نيو ورلد" لـ هابّي آراوند

54
00:04:40,180 --> 00:04:43,130
ماذا؟ يمكن لـ "هابّي آراوند" غناء أغانٍ كهذه أيضاً؟

55
00:04:43,130 --> 00:04:46,390
إنّها ناعمةٌ جدّاً، وتخالف صورتهنّ بشكلٍ مفاجئ

56
00:04:46,750 --> 00:04:48,640
لكن نالت إعجاباً في العرض

57
00:04:49,750 --> 00:04:53,640
ماذا؟ أكنتِ تشاهدين عرضهنّ الأخير يا شينوبو؟

58
00:05:05,810 --> 00:05:06,810
ساكي

59
00:05:07,450 --> 00:05:09,480
ما الذي يشغل تركيزك؟

60
00:05:10,310 --> 00:05:12,890
رأيتُ لوناً جديداً

61
00:05:13,990 --> 00:05:16,590
إنّه مختلف عن لونهنّ الفاقع قبلاً

62
00:05:16,590 --> 00:05:20,090
إنّه هادئ، لكن عميقٌ وأزرق متوسّع

63
00:05:21,020 --> 00:05:23,880
تقصدين الأغنية التي تُبثّ حالياً؟

64
00:05:29,970 --> 00:05:34,810
معكِ حقّ، تملك هذه الأغنية جوّاً
مختلفاً عن أغاني "هابّي آراوند" السابقة

65
00:05:39,020 --> 00:05:43,630
لم يخطر لي أن تغنّي "هابّي آراوند" أغانياً كهذه

66
00:05:43,630 --> 00:05:48,840
!حسناً، كانت تلك "براند نيو ورلد" لـ هابّي آراوند

67
00:05:48,840 --> 00:05:50,480
...للأغنية التالية

68
00:05:50,480 --> 00:05:55,980
لكن قبل ذلك، سنعلن عن نتائج مسابقة
!إعادة التوليف المعتادة

69
00:05:55,980 --> 00:05:57,610
،القواعد ككلّ مرّة

70
00:05:57,610 --> 00:06:01,380
،ستعيدون توليف الأغنية التالية
!ومرحّبٌ بمشاركة الجميع

71
00:06:01,380 --> 00:06:03,790
!لنستمع للأغنية إذاً

72
00:06:03,790 --> 00:06:05,980
"قطار المجرّة السريع 999"

73
00:06:35,660 --> 00:06:37,640
سيكون هذا درساً مفيداً لكنّ

74
00:06:37,640 --> 00:06:40,380
أتأمّل منكنّ جهوداً أكبر في المستقبل

75
00:06:58,980 --> 00:07:01,230
"مسابقة إعادة توليف أكاديميّة يوبا"

76
00:07:04,060 --> 00:07:06,150
"اسم المنسّق الموسيقيّ"

77
00:07:10,700 --> 00:07:12,610
"المنسّقة الموسيقيّة دراغون"

78
00:07:12,610 --> 00:07:14,780
"إرسال"

79
00:07:14,780 --> 00:07:16,990
"تمّ الإرسال"

80
00:07:17,910 --> 00:07:19,770
أنتم تستمعون

81
00:07:19,770 --> 00:07:21,620
!لألحان وقت الغداء

82
00:07:22,040 --> 00:07:27,640
!حسناً، وقت إعلان نتائج مسابقة إعادة التوليف

83
00:07:27,640 --> 00:07:30,080
...الحاصل على المركز الأوّل هذه المرّة

84
00:07:30,080 --> 00:07:35,660
أرجّح أنّكم عرفتموها سلفاً، لكن حصلت المنسّقة
!الموسيقية كونويتشي على المركز الأوّل مُجدداً

85
00:07:35,660 --> 00:07:37,760
إنّها قويّة حقّاً

86
00:07:37,760 --> 00:07:40,600
كم مركز أوّل لديها الآن؟

87
00:07:40,600 --> 00:07:46,360
إنّها تعلو البقيّة بمراحل، فلا مهرب من اختيارها

88
00:07:46,360 --> 00:07:50,040
ثمّ، في المركز الثاني هي المنسّقة
!الموسيقيّة وايلد كوين

89
00:07:50,040 --> 00:07:52,170
ثمّ المنسّقة الموسيقيّة مارو في المركز الثالث

90
00:07:52,170 --> 00:07:53,760
وفي الرابع، المنسّقة الموسيقيّة ماتشي

91
00:07:53,760 --> 00:07:55,160
وفي الخامس، الملكة سوزوكي

92
00:07:55,160 --> 00:07:56,480
!وهذا كلّهنّ

93
00:07:56,480 --> 00:07:59,080
!تهانينا لكلّ الفائزين

94
00:08:01,120 --> 00:08:02,620
"المركز الأوّل: المنسّقة الموسيقيّة كونويتشي"
"توليفة هجوميّة"

95
00:08:02,080 --> 00:08:05,500
شينوبو-سان قويّة للغاية حقّاً

96
00:08:06,750 --> 00:08:08,000
"المفضّلة لميساميسا"

97
00:08:08,570 --> 00:08:13,820
صحيح، أتى الناس لعرضي الأوّل مع رينكو

98
00:08:13,820 --> 00:08:18,140
لأنّه صادفت أن عرضت هذه
على برنامج وقت الغداء

99
00:08:18,140 --> 00:08:19,010
"المفضّلة لميساميسا"

100
00:08:19,010 --> 00:08:21,640
"المنسّقة الموسيقيّة دراغون"

101
00:08:31,860 --> 00:08:36,870
كانت إعادة توليف المنسّقة
الموسيقيّة دراغون رائعةً حقّاً

102
00:08:37,150 --> 00:08:39,420
،حافظت على صورة الأغنية الأصليّة

103
00:08:39,420 --> 00:08:42,350
ودمجت الأصوات الحيّة بسلاسة

104
00:08:42,350 --> 00:08:45,480
لكن كانت هناك مشكلة واحدة

105
00:08:45,480 --> 00:08:48,630
ربما كان ذلك ما أسقطها من المراكز الأولى

106
00:08:48,630 --> 00:08:54,540
كنتُ أعاني نفس المشكلة، عندما تقوم بإعادة
...توليف لأوّل مرّة، دائماً ما

107
00:08:54,540 --> 00:08:57,140
يا إلهي، علينا العودة للفصل

108
00:08:57,860 --> 00:08:59,890
استراحة الغداء قصيرة حقّاً

109
00:08:59,890 --> 00:09:02,760
أجل، يُفترض أن تكون خمس ساعات عل الأقل

110
00:09:06,520 --> 00:09:08,190
!ماهو-تشان

111
00:09:08,190 --> 00:09:09,650
!صباح الخير

112
00:09:09,650 --> 00:09:10,820
صباح الخير

113
00:09:11,910 --> 00:09:14,010
ماذا آكل للغداء اليوم؟

114
00:09:14,010 --> 00:09:16,380
أنتِ تأكلين كرات أرزّ للغداء يومياً

115
00:09:16,380 --> 00:09:18,840
!رأيتُ جندباً ورديّاً قبل قليل

116
00:09:18,840 --> 00:09:21,660
جندب ورديّ؟ أين رأيتِ ذلك؟

117
00:09:21,660 --> 00:09:24,370
كان المونت بلانك الذي تناولناه
!ذاك اليوم لذيذاً حقّاً

118
00:09:24,370 --> 00:09:26,120
!أجل، أجل

119
00:09:26,120 --> 00:09:29,200
الرسمة التي رسمتها بالأمس
!حصلت على إعجابات كثيرة

120
00:09:29,200 --> 00:09:30,780
!كما يُتوقّع من موني-تشان

121
00:09:31,290 --> 00:09:32,550
ما الخطب يا ماهو-تشان؟

122
00:09:32,960 --> 00:09:37,130
أشعر أنّ أحدهم يراقبني

123
00:09:37,710 --> 00:09:38,510
ماذا؟

124
00:09:38,510 --> 00:09:39,890
تتظاهرين بالشهرة؟

125
00:09:39,890 --> 00:09:42,940
!كلا! شعرتُ بذلك حقّاً

126
00:09:52,400 --> 00:09:54,890
تواصلين اللحاق بي

127
00:09:54,890 --> 00:09:56,110
ما الذي تريدينه؟

128
00:10:00,420 --> 00:10:01,960
...أريدك أن تخبريني

129
00:10:02,780 --> 00:10:04,630
أين أخطأت؟

130
00:10:05,890 --> 00:10:09,370
ماذا؟ أنتِ صاحبة إعادة التوليف
تلك يا إيزومو-سان؟

131
00:10:10,630 --> 00:10:15,260
،سمعتُك وأنت تتكلّمين عن المشكلة بها

132
00:10:15,260 --> 00:10:17,220
فأردتُ معرفة المزيد

133
00:10:17,220 --> 00:10:21,900
أكنتُ أتكلّم عن ذلك
في استراحة غداء الأمس؟

134
00:10:21,900 --> 00:10:25,770
...لكن لو سألتِ فحسب، كنتُ لأخبرك

135
00:10:25,770 --> 00:10:26,800
!حقّاً؟

136
00:10:26,800 --> 00:10:29,310
ستخبريني كيف أتحسّن؟

137
00:10:29,310 --> 00:10:31,660
أ-أجل

138
00:10:31,660 --> 00:10:34,140
إذا كان شيئاً أستطيع المساعدة به

139
00:10:38,120 --> 00:10:40,380
!مرحباً لجميع مشاهدي القناة

140
00:10:40,380 --> 00:10:41,290
أنا سيتو ريكا

141
00:10:41,290 --> 00:10:42,380
أنا ميزوشيما ماريكا

142
00:10:42,380 --> 00:10:43,340
أنا هيداكا ساوري

143
00:10:43,340 --> 00:10:44,530
أنا ماتسوياما داليا

144
00:10:45,490 --> 00:10:46,700
!موني-تشان

145
00:10:47,910 --> 00:10:49,540
ماذا؟ أين ماهو؟

146
00:10:49,540 --> 00:10:53,180
اتّصلت قبل قليل، ستتأخّر قليلاً اليوم

147
00:10:54,880 --> 00:10:59,920
بشكلٍ عام، الأصوات ليست منظّمة
كما يجب، فيكون مسمعهما فوضوياً

148
00:10:59,920 --> 00:11:03,050
كانت لديكِ أفكار رائعة، لكنّها لم تصل

149
00:11:03,050 --> 00:11:06,680
لذا أرى أنّ عليكِ الانتباه
لذلك وستتحسّنين

150
00:11:06,680 --> 00:11:07,430
حسنا

151
00:11:08,020 --> 00:11:10,390
شكراً لك، هذا درسٌ مفيد

152
00:11:11,600 --> 00:11:15,400
تأخّرت في ذكر هذا، لكنّك
ساكي-سان من فوتون ميدين، صحيح؟

153
00:11:16,400 --> 00:11:18,900
!آسفة! لم أعرّف بنفسي

154
00:11:18,900 --> 00:11:21,910
لا، لا مشكلة

155
00:11:21,910 --> 00:11:26,060
تفاجأتُ قليلاً لعدم قيامك
بإعادة توليف قبلاً لا أكثر

156
00:11:26,790 --> 00:11:30,290
غناء ورقص فوتون ميدين
،على مستوى عالٍ من المهارة

157
00:11:30,290 --> 00:11:34,570
فظننتُ أنّكنّ متعمّقات في صنع الموسيقى أيضاً

158
00:11:36,480 --> 00:11:43,010
أغاني وحدتنا تُختار كلّها من قِبل
المنتجة لتطابق صورتنا

159
00:11:43,440 --> 00:11:47,200
لكنّي أريد لوناً جديداً

160
00:11:47,200 --> 00:11:48,810
لوناً جديداً؟

161
00:11:48,810 --> 00:11:53,640
صنعتنّ لوناً جديداً مختلفاً
ومضيتنّ للأمام

162
00:11:54,150 --> 00:11:59,740
لذا أريد الحصول على لون
جديد لنا والمضيّ قدماً أيضاً

163
00:12:00,060 --> 00:12:07,210
فهمت، لذا أردتِ صنع موسيقاك
بنفسك، وبدأتِ إعادة التوليف؟

164
00:12:07,210 --> 00:12:08,100
أجل

165
00:12:10,330 --> 00:12:12,500
أيمكنني سؤالك عن أمرٍ آخر؟

166
00:12:13,040 --> 00:12:16,250
لم كان اسمك "المنسّقة الموسيقيّة دراغون" في المسابقة؟

167
00:12:16,560 --> 00:12:19,630
لا تبدين كتنّين حقّاً

168
00:12:20,010 --> 00:12:21,130
...هذا

169
00:12:21,470 --> 00:12:23,880
لأنّي أحبّ فاكهة التنّين

170
00:12:23,880 --> 00:12:26,630
...فـ-فهمت

171
00:12:50,870 --> 00:12:52,780
!يوم تمارين آخر مسلٍّ

172
00:12:55,670 --> 00:12:56,670
!ساكي؟

173
00:12:57,920 --> 00:12:58,590
!ساكي

174
00:12:58,590 --> 00:12:59,150
!ساكي-تشان

175
00:12:59,150 --> 00:12:59,920
!أأنتِ بخير؟

176
00:13:06,710 --> 00:13:08,300
كنتُ أستمع لأغنية

177
00:13:09,160 --> 00:13:11,930
يا إلهي، لا تخيفينا

178
00:13:11,930 --> 00:13:14,360
كنتِ تستمعين لأغنية؟ ما هي؟

179
00:13:27,720 --> 00:13:30,030
إعادة التوليف هذه من صنعك يا ساكي؟

180
00:13:30,550 --> 00:13:31,540
أجل

181
00:13:31,540 --> 00:13:34,220
شعورها مختلف

182
00:13:34,220 --> 00:13:37,420
إنّها أغنية مختلفة تماماً، لكن لا تبدو كذلك

183
00:13:39,090 --> 00:13:42,670
عندما أتممتُ إعادة التوليف هذه، رأيتُ لوناً جديداً

184
00:14:16,020 --> 00:14:19,830
لون مختلف عن لوننا الآن، لون جديد

185
00:14:28,340 --> 00:14:29,840
"عجّة بالأزر رقيقة"

186
00:14:29,840 --> 00:14:35,080
أتعرفين، تناولتُ الغداء قبلاً رفقة
رينكو-تشان من هابّي آرا

187
00:14:35,080 --> 00:14:38,100
تقصدين عندما ذهبتُ للكافتيريا لجلبك؟

188
00:14:38,100 --> 00:14:39,040
أجل

189
00:14:39,040 --> 00:14:41,310
...كنتُ أتكلّم معها آنذاك، و

190
00:14:41,580 --> 00:14:42,540
!بالطبع

191
00:14:42,540 --> 00:14:45,280
!كلّ أغانيكنّ بهيجة! تشعرني برغبة بالرقص

192
00:14:45,630 --> 00:14:48,320
!أريد غناء أغانٍ كتلك

193
00:14:48,320 --> 00:14:49,280
ذلك ما حصل

194
00:14:49,280 --> 00:14:52,280
لكن لمَ تخبريني بهذا الآن؟

195
00:14:53,180 --> 00:14:54,920
...حسناً، في الواقع

196
00:14:54,920 --> 00:14:56,040
لا سبب معيّن

197
00:15:15,310 --> 00:15:16,590
أأنتِ بخير؟

198
00:15:16,590 --> 00:15:19,890
أ-أجل، لا داعي للقلق

199
00:15:21,900 --> 00:15:24,270
آسفةٌ على إخافتك

200
00:15:24,270 --> 00:15:28,070
كلا، أنا فُزعت لا أكثر

201
00:15:29,360 --> 00:15:31,070
تتمرّنين باجتهاد

202
00:15:32,380 --> 00:15:33,260
...أنا

203
00:15:33,740 --> 00:15:37,440
لا-لا أزال غير بارعةٍ في الرقص

204
00:15:37,440 --> 00:15:39,930
وأحتاج لتمرينٍ أكثر

205
00:15:39,930 --> 00:15:41,960
كما ليس غنائي بالمستوى المطلوب بعد

206
00:15:41,960 --> 00:15:47,960
من الصعب سماعك بهذا التواضع بما
أنّنا خسرنا أمامكنّ في المواجهة

207
00:15:47,960 --> 00:15:49,710
...لا، لم أقصد

208
00:15:49,710 --> 00:15:52,150
أمزح فحسب، لا تقلقي

209
00:15:53,630 --> 00:15:57,660
الأغنية التي غنيّتِها آنذاك كانت جميلةً حقّاً

210
00:15:58,390 --> 00:16:00,220
شكراً لك

211
00:16:00,220 --> 00:16:07,940
،لم نكن متأكّدات من غنائي لتلك الأغنية من عدمه
"وما إن كنّا سنؤديها كـ "هابّي آراوند

212
00:16:09,420 --> 00:16:11,950
كانت مختلفةً عن الأغاني التي
غنّيناها حتّى حينذاك

213
00:16:11,950 --> 00:16:14,630
"وظننتُ أنّها لن تلائم "هابّي آراوند

214
00:16:15,710 --> 00:16:17,700
...لكن قالت رينكو-تشان

215
00:16:17,700 --> 00:16:20,080
أنا وماهو-تشان

216
00:16:20,080 --> 00:16:21,040
وموني-تشان

217
00:16:21,040 --> 00:16:21,900
!وري-تشان

218
00:16:21,900 --> 00:16:23,290
!"كلّنا "هابّي آرا

219
00:16:23,290 --> 00:16:27,860
لذا يستحيل ألّا توافق أغنية
"لري-تشان صورة "هابّي آرا

220
00:16:28,800 --> 00:16:33,220
بعدما قالت ذلك، عقدتُ عزيمتي

221
00:16:43,680 --> 00:16:49,850
أنا وماهو-تشان وموني-تشان وري-تشان
كلّنا "هابّي آرا" إذاً؟

222
00:16:55,280 --> 00:16:58,950
أؤدي إعادة توليف ساكي-تشان على المسرح؟

223
00:16:58,950 --> 00:17:00,490
!انتظري، انتظري

224
00:17:00,490 --> 00:17:03,660
لكنّ الأشياء التي أدّيناها
...على المسرح حتّى الآن

225
00:17:03,660 --> 00:17:06,600
أجل، اُختيرت الأغاني والتنظيمات والرقصات

226
00:17:06,600 --> 00:17:10,670
من قِبل منتجتنا لمطابقة صورتنا

227
00:17:10,670 --> 00:17:16,510
أجل! لذا حتّى لو قلنا أنّنا نريد أداء
!إعادة التوليف تلك، لن تسمح لنا

228
00:17:16,510 --> 00:17:17,720
صحيح

229
00:17:17,720 --> 00:17:20,600
إذا كانت ستحطّم صورة
،فوتون ميدين التي بنيناها

230
00:17:20,600 --> 00:17:23,560
فاحتماليّة رفضها عالية

231
00:17:26,270 --> 00:17:27,340
...لكن

232
00:17:27,340 --> 00:17:29,400
،لنفترض أنّها وافقت

233
00:17:29,400 --> 00:17:33,500
فأريد أداء إعادة التوليف تلك على المسرح

234
00:17:33,920 --> 00:17:37,510
ليس السبب أنّي لا أحبّ الأغاني
،التي نؤديها كـ فوتون الآن

235
00:17:37,910 --> 00:17:41,910
لكنّي أريد تجربة أنواع
متنوّعة من الموسيقى

236
00:17:41,910 --> 00:17:43,190
...توا

237
00:17:46,790 --> 00:17:53,170
إذا وافقتنّ جميعاً، فسأطلب من المنتجة السماح لنا
بأداء إعادة التوليف تلك

238
00:17:56,850 --> 00:17:59,340
استمعتُ لإعادة توليف إيزومو

239
00:18:08,400 --> 00:18:10,360
الجودة كافية للأداء

240
00:18:10,360 --> 00:18:13,400
أسمح لكنّ بإضافتها للائحة
تشكيلة عرضكنّ التالي

241
00:18:16,230 --> 00:18:17,050
...المعذرة

242
00:18:17,050 --> 00:18:18,740
أأنتِ متأكّدة؟

243
00:18:18,740 --> 00:18:20,640
ما هذه التعابير؟

244
00:18:20,640 --> 00:18:23,180
أنتنّ من طلب ذلك

245
00:18:23,180 --> 00:18:24,740
...صحيح، لكن

246
00:18:24,740 --> 00:18:27,560
،أظن أنّي أخبرتكنّ قبلاً

247
00:18:27,560 --> 00:18:32,540
،سيكون هذا درساً مفيداً لكنّ"
"أتأمّل منكنّ جهوداً أكبر في المستقبل

248
00:18:32,540 --> 00:18:37,480
سترنني نتائج جهودكنّ الجديدة

249
00:18:38,170 --> 00:18:40,180
"ولادة جديدة"
"فوتون ميدين"

250
00:18:42,430 --> 00:18:46,160
!ما العمل؟ ستبدأ قريباً

251
00:18:46,160 --> 00:18:48,730
ما الفائدة من الهلع الآن؟

252
00:18:48,730 --> 00:18:55,230
لكن، لكن! ماذا لو أدّينا إعادة التوليف تلك
!وقالوا أنّها لا تبدو كـ فوتون ميدين؟

253
00:18:55,230 --> 00:18:57,530
تلك المخاطرة موجودة بالفعل

254
00:18:58,610 --> 00:19:02,870
لكن لا نؤدي نحن الأربعة
،موسيقى فوتون ميدين

255
00:19:03,450 --> 00:19:06,950
بل موسيقى فوتون ميدين
هي ما نؤدّيه نحن الأربعة

256
00:23:25,480 --> 00:23:26,750
!موني-تشان! موني-تشان

257
00:23:26,750 --> 00:23:28,190
أيمكنني القدوم لمنزلك اليوم؟

258
00:23:28,190 --> 00:23:29,200
لا أمانع

259
00:23:29,200 --> 00:23:31,550
!رائع! سأهزم الزعيم الأخير اليوم حتماً

260
00:23:31,550 --> 00:23:35,100
يجدر بك إعادة يد التحكّم لمكانها
بعدما تنتهين من اللعب

261
00:23:35,100 --> 00:23:35,850
!حسناً

262
00:23:35,850 --> 00:23:37,760
الحلقة القادمة: صديقتا طفولة

263
00:23:36,640 --> 00:23:40,060
"صديقتا طفولة"

264
00:23:37,760 --> 00:23:40,060
!يا إلهي! تركتِها مجدداً