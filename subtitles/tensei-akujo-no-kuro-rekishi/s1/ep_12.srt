1
00:00:00,470 --> 00:00:05,480
راية الموت 12: طيبة وقوّة والرّجل الّذي عليّ محوه

2
00:00:03,950 --> 00:00:04,860
...سول

3
00:00:05,350 --> 00:00:08,980
.أدركتُ للتّوّ ما هو أهمّ شيء بالنّسبة لي

4
00:00:10,990 --> 00:00:12,240
.ضحكة

5
00:00:12,240 --> 00:00:13,720
.دماء كونوها

6
00:01:46,090 --> 00:01:47,890
.اللّيلة ليلة جيّدة

7
00:01:48,750 --> 00:01:51,250
.صار أولئك الإلف المزعجون تابعين لي

8
00:01:51,490 --> 00:01:54,580
.كلّ ما بقي هو جعل كونوها كعقيلتي

9
00:01:57,670 --> 00:01:59,830
.ستعملين لصالحي يا إيانا

10
00:02:00,350 --> 00:02:02,470
!وكلّ ذلك من أجلي أنا ملك مصّاصي الدّماء

11
00:02:03,660 --> 00:02:06,110
.بالطّبع يا مولاي

12
00:02:06,410 --> 00:02:07,760
.دع كلّ شيء لي رجاءً

13
00:02:09,000 --> 00:02:12,490
لا أصدّق أنّك تعرّضت لعضّة من
.شوكونا وما زلت محتفظة بهويّتك

14
00:02:12,830 --> 00:02:16,770
قد تكونين بشعة، لكن يبدو
.أنّك أخت كونوها بالفعل

15
00:02:17,280 --> 00:02:21,490
!آه يا ملك مصّاصي الدّماء
.يا لجسدك القويّ والمهيب

16
00:02:22,150 --> 00:02:24,860
،بشان ذلك الخادم يا سيّدة إيانا
...هل قمتِ

17
00:02:25,040 --> 00:02:25,890
.نعم

18
00:02:25,890 --> 00:02:29,120
.قمتُ بعضّه لإسكاته قبل وصول مولاي

19
00:02:29,580 --> 00:02:32,410
فقبل كلّ شيء، سيكون
.من المزعج كثيرًا إن صار عدوًّا

20
00:02:32,410 --> 00:02:34,310
.من الأفضل التّعامل معه بسرعة

21
00:02:34,630 --> 00:02:37,690
.أظنّ أنّه سيكون بيدقًا مفيدًا لمولاي

22
00:02:38,580 --> 00:02:40,630
.أنا أتطلّع قدمًا للوقت الّذي يستيقظ فيه

23
00:02:40,630 --> 00:02:43,350
.إنّها امرأة غبيّة بالفعل

24
00:02:43,470 --> 00:02:47,610
واثق أنّها أرادت نيل استحسان ملك مصّاصي
...الدّماء بخيانة شخص قريب لها، لكن

25
00:02:48,100 --> 00:02:49,030
أواثق من هذا؟

26
00:02:49,390 --> 00:02:51,060
.دعها تفعل ما تريد

27
00:02:51,260 --> 00:02:53,750
قد تكون بشعة، لكنّنا بحاجة
.لهذه المرأة الآن

28
00:02:54,110 --> 00:02:57,400
ليت كونوها كانت سهلة
.المنال إلى هذا الحدّ

29
00:02:57,400 --> 00:03:00,570
.لا أعتقد أنّ الأمر سيكون بهذه البساطة

30
00:03:00,900 --> 00:03:03,330
.السّيّدة هي نقيض هذه المرأة بالكامل

31
00:03:03,470 --> 00:03:05,630
.إنّها لطيفة وقويّة الإرادة

32
00:03:06,660 --> 00:03:08,540
من السّهل أن يظنّ المرء أنّها شابّة
،بلا حول ولا قوّة

33
00:03:08,970 --> 00:03:11,580
،ولكن عندما قاومتُ الحصول على علاج

34
00:03:11,580 --> 00:03:13,920
.أصرّت هي بكلّ عناد

35
00:03:11,580 --> 00:03:13,920
!سيّد شوكونا، لن تشفى أبدًا هكذا

36
00:03:13,920 --> 00:03:14,720
...لا، أنا في الحقيقة

37
00:03:14,720 --> 00:03:16,130
!دع كلّ شيء لي رجاءً

38
00:03:16,370 --> 00:03:19,290
،بما أنّني إلف، فنحن من عرقين مختلفين

39
00:03:19,290 --> 00:03:21,220
لكنّ تفكيرها متفتّح لدرجة
.أنّ ذلك لا يهمّها

40
00:03:22,270 --> 00:03:25,390
حملتني معها بذراعيها النّحيلتين
.وأخذتني للقصر عندما فقدت الوعي

41
00:03:25,390 --> 00:03:31,060
...كلاّ
...كم هو ثقيل

42
00:03:25,610 --> 00:03:27,690
!هل أنت بخير؟! لا تستسلم رجاءً

43
00:03:27,690 --> 00:03:30,940
لكنّها أذابت قلبي مع أنّي كنت أخاف البشر

44
00:03:30,940 --> 00:03:33,650
أتشعر بتحسّن؟ أأكلت جيّدًا؟

45
00:03:30,940 --> 00:03:33,650
.عن طريق إصرارها بالحديث معي

46
00:03:31,140 --> 00:03:33,650
علاجات

47
00:03:34,270 --> 00:03:38,650
في منطقة البشر، كانت ابتسامتها
.وقلبها هما ما أنقذاني

48
00:03:38,830 --> 00:03:40,960
.قلبها قويّ بشكل لا يُصدّق

49
00:03:40,960 --> 00:03:42,660
.واثق أنّها ستقاوم بكلّ قوّتها

50
00:03:49,450 --> 00:03:50,460
ما هذا؟

51
00:03:50,460 --> 00:03:54,140
.بعد سماع تلك القصّة، تحمّس الجميع

52
00:03:55,060 --> 00:03:57,620
!سنستدرج كونوها الفاتنة إلى هذه القرية

53
00:03:57,750 --> 00:03:58,840
!وسأغرس أنيابي فيها

54
00:03:59,190 --> 00:04:02,970
!وستصير الحسناءُ عروسيَ المطيعة

55
00:04:03,220 --> 00:04:05,720
آااه

56
00:04:06,880 --> 00:04:09,720
!ليحتفل الجميع بزواج الملك والعذراء

57
00:04:11,330 --> 00:04:16,080
ابتهجوا بعودة ملك مصّاصي
!الدّماء للحياة وبمستقبل مشرق

58
00:04:17,610 --> 00:04:18,860
...ذلك المستقبل

59
00:04:20,070 --> 00:04:20,790
.لن يحلّ أبدًا

60
00:04:24,570 --> 00:04:27,230
أ-أيّها الـ... كيف؟

61
00:04:28,370 --> 00:04:28,580
صليل

62
00:04:29,660 --> 00:04:30,740
!مولاي

63
00:04:31,230 --> 00:04:35,290
!إيانا! جراحي تحرق
!أسرعي واقضي على هذا الوغد

64
00:04:37,420 --> 00:04:39,370
!ما هذا؟

65
00:04:39,370 --> 00:04:41,410
.أنا جدّ آسفة يا ملك مصّاصي الدّماء

66
00:04:41,760 --> 00:04:43,410
...أخفينا خدعة في جعبتنا

67
00:04:44,170 --> 00:04:46,390
!الدّواء الأكثر قوّة

68
00:04:46,390 --> 00:04:48,390
قبل ساعة

69
00:04:46,390 --> 00:04:48,390
الكنيسة

70
00:04:48,650 --> 00:04:50,570
.يكاد تحوّلي لمصّاصة دماء يكتمل

71
00:04:51,660 --> 00:04:53,680
.يمكنني حتّى شمّ الدّماء الآن

72
00:04:53,680 --> 00:04:54,730
ولكن من أين؟

73
00:04:56,500 --> 00:04:58,680
عندما وصلنا لمنطقة الاستراحة
...وذهبنا إلى الصّيف

74
00:04:58,680 --> 00:05:00,460
!مسحتُ دماء كونوها بمنديلي

75
00:05:00,700 --> 00:05:02,300
.ما زال في جيبي

76
00:05:02,650 --> 00:05:06,450
سول، أدركتُ للتّوّ ما هو أهمّ
.شيء بالنّسبة لي

77
00:05:06,860 --> 00:05:07,550
!جلوس

78
00:05:07,550 --> 00:05:08,880
!دماء كونوها

79
00:05:08,880 --> 00:05:10,790
!قد نكون قادرين على الخروج من هذا الوضع

80
00:05:11,460 --> 00:05:13,580
.الخطّة لإنقاذ قرية الإلف

81
00:05:14,030 --> 00:05:16,590
،كونوها، الّتي كانت تقاتل مصّاصي الدّماء

82
00:05:16,590 --> 00:05:18,750
تحمي أصدقاءها وينتهي بها
.المطاف أسيرة نتيجة لذلك

83
00:05:18,980 --> 00:05:22,170
حاول ملك مصّاصي الدّماء
جعل كونوها الفاتنة زوجة له

84
00:05:22,170 --> 00:05:24,860
عن طريق غرس أنيابه
.في كلّ شبر من جسدها

85
00:05:25,140 --> 00:05:29,350
،ولكنّ دم كونوها المقدّس يحميها
.ويحُول دون تحوّلها لمصّاصة دماء

86
00:05:29,770 --> 00:05:31,890
في الحقيقة، ملك مصّاصي
،الدّماء الّذي شرب دماءها

87
00:05:31,890 --> 00:05:35,400
.تأثّر بقوّتها المُطهّرة وأصبح عاجزًا عن الحركة

88
00:05:36,200 --> 00:05:39,740
ولذلك السّبب كانت كونوها قادرة على
!جعل ملك مصّاصي الدّماء يستسلم وحدها

89
00:05:40,000 --> 00:05:42,160
لم توقظ قواها كقدّيسة بالكامل
...بعد، لكنّ دماءها

90
00:05:42,160 --> 00:05:43,880
!تستحقّ أن نخوض المخاطرة من أجلها

91
00:05:44,360 --> 00:05:44,770
...أنا

92
00:05:45,320 --> 00:05:46,760
!قرأتُ ذلك في كتاب

93
00:05:46,760 --> 00:05:50,480
ذكر السّيّد شوكونا دماء العذراء
.الّتي كان حتّى الإلف ليعترف بنقائها

94
00:05:50,480 --> 00:05:52,830
!إنّ تلك الدمّاء قادرة على التّطهير

95
00:05:53,470 --> 00:05:56,130
إن استطعتُ تذويبها في مياه مقدّسة
...من هذه الكنيسة وشربتها

96
00:05:56,130 --> 00:05:58,370
فسأستطيع إبطاء عمليّة تحوّلي
!لمصّاصة دماء

97
00:06:01,360 --> 00:06:05,140
هذا ليس صائبًا! يملك ذلك
.الوتد القوّة للختم فحسب

98
00:06:05,140 --> 00:06:06,590
!لماذا لا أستطيع التّحرّك؟

99
00:06:06,590 --> 00:06:12,150
تمّ رشّ هذا الوتد
.وسكّين سول بنفس الدّواء

100
00:06:12,430 --> 00:06:16,660
،وبالنّسبة لمصّاص دماء خالص مثلك
!فإنّه أسوأ سمّ على الإطلاق

101
00:06:19,060 --> 00:06:21,410
،لم أستطع تقديمك لأختي

102
00:06:21,760 --> 00:06:25,300
.ولكن في المقابل، سأقدّمك إلى إله الموت

103
00:06:26,280 --> 00:06:30,170
!يا-يا لك من شرّيرة

104
00:06:30,630 --> 00:06:34,390
...عندما كنتُ في الإعداديّة
.كان من السّهل التّأثير على قلبي

105
00:06:34,390 --> 00:06:38,180
بالمناسبة يا ساتو-سان، جميع الشّخصيّات
.الّتي ترسمينها نحيفة، ومتشابهة

106
00:06:38,180 --> 00:06:40,840
.في الحقيقة، إنّها متشابهة بالفعل
!لا يمكنني التّمييز بينها

107
00:06:41,230 --> 00:06:42,720
.أنا آسفة

108
00:06:42,720 --> 00:06:45,050
لا أجيد التّمييز بين الشّخصيّات
.إلاّ إن جلبت الانتباه لها

109
00:06:45,050 --> 00:06:47,550
.يملك الجميع في السّلاسل المشهورة نفس الوجه

110
00:06:49,030 --> 00:06:50,670
ليس لديهم ما يميّزهم؟

111
00:06:51,540 --> 00:06:54,300
لا يمكنني إظهارها لأيّ أحد
!لا يستطيع التّمييز بينها

112
00:06:54,300 --> 00:06:55,050
!تحسينات

113
00:06:54,300 --> 00:06:56,810
تحسينات

114
00:06:55,350 --> 00:06:56,810
!النّوع ذي العضلات الشّبيهة بالكرات

115
00:06:56,810 --> 00:07:02,560
موزة أخرى
بلا أي سبب

116
00:06:56,810 --> 00:07:02,560
تصميم مصّاص دماء وسيم تمّ إلغاؤه

117
00:06:56,990 --> 00:07:00,240
.مذاق الدّماء ليس لذيذًا، لكنّي أشربه

118
00:07:00,650 --> 00:07:02,560
.يبدو أنّه تمّ إلغاء تصميمي

119
00:07:02,560 --> 00:07:07,570
حاولت جعله
أكثر وسامة

120
00:07:02,560 --> 00:07:07,570
مصّاص دماء من النّوع ذي العضلات الشّبيهة بالكرات

121
00:07:02,790 --> 00:07:05,560
،لكن حتّى عندما أضعهم في قصّتي
.لم أستطع أن أحبّهم

122
00:07:05,560 --> 00:07:07,570
.بدل أن يكونوا أبطالاً، كانوا الأعداء الأقوى

123
00:07:07,570 --> 00:07:08,380
...استنتاج

124
00:07:07,570 --> 00:07:08,630
استنتاج

125
00:07:09,480 --> 00:07:11,740
عندما أؤلّف شخصيّة عدوّ
،بالمظهر المفضّل لي

126
00:07:11,740 --> 00:07:14,050
!لا أرغب في السّماح لهم بالموت
!وأرغب في حبّهم

127
00:07:14,510 --> 00:07:16,080
!لذلك لا بأس بالأمر كما هو الآن

128
00:07:16,490 --> 00:07:19,450
أحببتُ تصميم مصّاص الدّماء
.الوسيم الّذي ألغيتُه

129
00:07:19,670 --> 00:07:21,740
.أنا مسرور لأنّك أحببتني

130
00:07:21,740 --> 00:07:23,170
...لكنّ هذا الشّخص

131
00:07:23,570 --> 00:07:29,940
!إيانا، أنقذيني
!سوف... سوف أجعلك عقيلتي

132
00:07:30,760 --> 00:07:32,760
.هذا ليس مغريًا على الإطلاق

133
00:07:32,760 --> 00:07:35,290
!إنّك لا تناسب ما أفضّله على الإطلاق

134
00:07:38,470 --> 00:07:41,780
وكما أستعمل الممحاة لجعل صفحة
...دفتري ناصعة البياض ثانية

135
00:07:42,520 --> 00:07:45,090
.هذه شخصيّة عليّ محوها

136
00:07:49,250 --> 00:07:50,060
!سيّدتي إيانا

137
00:07:50,320 --> 00:07:51,280
!فزع

138
00:07:51,470 --> 00:07:52,880
.فقد شوكونا وعيه

139
00:07:52,880 --> 00:07:54,110
ما الّذي تودّين فعله؟

140
00:07:55,370 --> 00:07:57,690
.أعتقد أنّه لم يعد مصّاص دماء بعد الآن

141
00:07:57,690 --> 00:07:59,970
...ويجب أن يكون ذلك حال بقيّة الإلف أيضًا

142
00:08:00,750 --> 00:08:01,250
أحّم

143
00:08:02,110 --> 00:08:03,370
...عفوًا يا سول

144
00:08:04,790 --> 00:08:07,370
.سول، نجوتُ لأنّك اخترت مساعدتي

145
00:08:07,690 --> 00:08:10,400
لم أكن واثقة أنّه سيكون لذلك
.أيّ تأثير. كانت مجازفة

146
00:08:11,090 --> 00:08:14,640
،ولكن لأنّك وثقت بي
.عثرتُ على الشّجاعة لخوضها

147
00:08:14,920 --> 00:08:16,130
.أسعدني ذلك كثيرًا

148
00:08:16,650 --> 00:08:17,890
.شكرًا لك

149
00:08:19,080 --> 00:08:19,920
سول؟

150
00:08:20,010 --> 00:08:21,460
ما الّذي تحاولين فعله؟

151
00:08:21,520 --> 00:08:22,390
ماذا؟

152
00:08:22,710 --> 00:08:26,060
.لم أفعل أيّ شيء يستحقّ كلمات الامتنان هذه

153
00:08:26,060 --> 00:08:27,900
ماذا؟ بعد كلّ هذا؟

154
00:08:27,900 --> 00:08:31,070
هل كان تعبيري سيّئ؟
"مثل "ما قصدك بأنّها كانت مجازفة؟

155
00:08:31,070 --> 00:08:34,080
،لكن إن أجبرته على قبول امتناني
أسيكون ذلك إساءة استغلال للسّلطة؟

156
00:08:34,080 --> 00:08:36,210
هذا سيّئ! أنا أرى سول
.كأنّه تابعي في المكتب

157
00:08:36,210 --> 00:08:38,330
!عليّ أن أكون حذرة جدًّا بشأن مشاعره

158
00:08:39,190 --> 00:08:41,530
.لا أريده أن يشعر بتأهّب دائم قربي

159
00:08:44,540 --> 00:08:47,640
أين هما يومي وكاغورا؟
هل ما زالا على الجانب الآخر من الباب؟

160
00:08:47,640 --> 00:08:48,480
.ذلك صحيح

161
00:08:48,480 --> 00:08:51,450
!كلاّ، سمحت لنفسي بالاسترخاء كثيرًا
!لنسرع وننقذهما

162
00:08:51,590 --> 00:08:53,860
...في هذه اللّحظة، كنتُ لم أدرك بعد

163
00:08:54,280 --> 00:08:57,440
هذه الحادثة الّتي ظننتُ أنّي
...سبقتها واستطعتُ إيقافها

164
00:08:57,440 --> 00:08:59,460
لماذا كان التّوقيت مثاليًّا هكذا؟

165
00:09:00,220 --> 00:09:01,300
أكان هنالك سبب ما؟

166
00:09:06,060 --> 00:09:07,060
!يومي

167
00:09:07,060 --> 00:09:08,770
!يومي، تماسك

168
00:09:08,770 --> 00:09:10,020
.إنّه ينزف

169
00:09:10,020 --> 00:09:11,420
.علينا إيقاف النّزيف

170
00:09:11,420 --> 00:09:12,110
!سول

171
00:09:12,950 --> 00:09:14,090
...إيانا

172
00:09:14,090 --> 00:09:17,800
عنقك... هل يؤلمك؟

173
00:09:17,800 --> 00:09:19,440
!يومي! أنت مستيقظ

174
00:09:19,440 --> 00:09:21,900
!سنعيدك في الحال! ستكون بخير

175
00:09:21,900 --> 00:09:23,790
...أنا بخير. أمّا أنت يا إيانا

176
00:09:24,150 --> 00:09:26,020
!أنا بأحسن حال

177
00:09:26,020 --> 00:09:28,220
.هزمنا مصّاص الدّماء
!لا يوجد ما يدعو للقلق الآن

178
00:09:28,220 --> 00:09:29,290
...هذه الإصابة

179
00:09:29,590 --> 00:09:32,030
.لم يتعرّض لهجوم من مصّاص دماء

180
00:09:32,170 --> 00:09:32,750
ماذا؟

181
00:09:37,070 --> 00:09:38,140
.كان هو

182
00:09:38,140 --> 00:09:40,720
.على الأرجح أنّه كان هكذا مذ وصلنا للمنتجع

183
00:09:39,400 --> 00:09:40,720
ما هذا؟

184
00:09:40,720 --> 00:09:43,320
آنسة إيانا؟ هل أنتما بخير؟

185
00:09:44,790 --> 00:09:47,510
.ضحكة

186
00:09:47,680 --> 00:09:49,410
.ضحكة، ضحكة

187
00:09:52,910 --> 00:09:54,930
.هذا سيّئ

188
00:09:57,950 --> 00:09:59,230
.ضحكة، ضحكة

189
00:09:59,600 --> 00:10:01,120
.ضحكة

190
00:10:02,450 --> 00:10:05,420
كان عليكما السّماح لنفسيكما
.أن تهلكا في القرية

191
00:10:05,420 --> 00:10:07,960
.كنتُ أتطلّع قُدمًا لرؤيتكما تتلوّيان من الألم

192
00:10:07,960 --> 00:10:09,610
.هذا الصّوت. إنّه كاغورا

193
00:10:09,610 --> 00:10:10,330
!سول

194
00:10:19,950 --> 00:10:23,420
،لو أنّكم لم تتدخّلوا
.كانت قوى كونوها لتستيقظ

195
00:10:23,420 --> 00:10:25,400
كيف ستكفّرون عن ذلك يا حثالة؟

196
00:10:27,200 --> 00:10:30,060
.لم يتصرّف أيّ أحد منكم بالطّريقة الّتي أردتُها

197
00:10:30,390 --> 00:10:33,150
!لهذا السّبب أكره الأحياء! إنّهم مزعجون جدًّا

198
00:10:33,150 --> 00:10:34,340
...كاغورا

199
00:10:34,340 --> 00:10:36,360
هل يعرف معلومات داخليّة؟

200
00:10:36,700 --> 00:10:37,960
أهو من التّاريخ المظلم؟

201
00:10:37,960 --> 00:10:40,580
لا، لم أكن مهتمّة بهذا النّوع
.الأدبيّ إلى أن بدأت العمل

202
00:10:40,710 --> 00:10:42,790
ما كنتُ لأؤلّف شخصيّة مثله
.عندما كنتُ في الإعداديّة

203
00:10:43,080 --> 00:10:45,080
...لكن إن صحّ ذلك

204
00:10:45,080 --> 00:10:48,540
مع أنّي هاجمتُ شوكونا وتركته
.قرب منطقة البشر أيضًا

205
00:10:48,830 --> 00:10:50,390
.هذا ليس ممتعًا

206
00:10:50,480 --> 00:10:51,900
من أنت بالضّبط؟

207
00:10:53,000 --> 00:10:53,590
هيه

208
00:10:53,540 --> 00:10:55,070
ما الّذي ستفعلينه إن عرفت؟

209
00:10:55,340 --> 00:10:57,520
.أنت شرّيرة بلا فائدة

210
00:10:57,520 --> 00:10:59,590
إن عرفتِ من أكون، هل ستحاولين إيقافي؟

211
00:10:59,880 --> 00:11:01,090
.مع أنّك لا تستطيعين أصلاً

212
00:11:01,910 --> 00:11:06,770
في هذا العالم، الوحيدون الّذين على صواب
.هم نحن، شوارتز لو شوفاليي

213
00:11:07,280 --> 00:11:08,740
.وليس أنت

214
00:11:11,600 --> 00:11:12,540
!حسنًا

215
00:11:13,640 --> 00:11:15,640
.لا مشكلة لديّ في الاعتراف بالهزيمة اليوم

216
00:11:15,640 --> 00:11:17,520
،بما أنّك بذلت الكثير من الجهد

217
00:11:17,520 --> 00:11:19,640
.لن يكون من الممتع قتلك على الفور

218
00:11:19,840 --> 00:11:21,870
...لنلعب أكثر في المرّة القادمة

219
00:11:22,050 --> 00:11:23,490
.يا إيانا ماغنوليا

220
00:11:25,620 --> 00:11:26,680
!انتظر

221
00:11:26,190 --> 00:11:27,020
.سيّدتي إيانا

222
00:11:27,020 --> 00:11:28,320
.لا يجب عليك أن تتبعيه

223
00:11:28,320 --> 00:11:29,400
!سول

224
00:11:31,330 --> 00:11:32,500
...إيانا

225
00:11:32,910 --> 00:11:35,340
.لا تذهبي... رجاءً

226
00:11:36,100 --> 00:11:38,020
.لنعد للمنزل بسرعة يا يومي

227
00:11:38,680 --> 00:11:41,950
شوارتز لو شوفاليي. من يكونون؟

228
00:11:42,670 --> 00:11:45,130
ما الّذي يحدث في هذه القصّة؟

229
00:11:46,310 --> 00:11:47,430
.يا أغني

230
00:11:47,430 --> 00:11:49,810
.قيل لك ألاّ تتصرّف على هواك

231
00:11:49,810 --> 00:11:52,460
.لقد عصيتَ الأوامر ولم تكسب أيّ شيء

232
00:11:52,460 --> 00:11:54,290
.سيغضب عليك كايلوم ثانية

233
00:11:54,290 --> 00:11:56,060
.لا أهتمّ لاكتساب أيّ شيء

234
00:11:56,280 --> 00:11:58,470
.كلّ ما تفعله تلك المرأة هو اعتراض طريقي

235
00:11:58,470 --> 00:12:00,610
أريدها أن تعاني بقدر
.الإمكان قبل أن أقتلها

236
00:12:01,080 --> 00:12:04,410
.فِنتوس، ليس عليك الاعتناء بأغني

237
00:12:01,580 --> 00:12:03,710
!كلاّ، هذا يثير غضبي بشدّة

238
00:12:04,410 --> 00:12:06,580
.إنّه طفل يهتمّ بالجثث فحسب

239
00:12:06,940 --> 00:12:11,140
،لكن إن كانت حماية القدّيسة بهذه القوّة
.علينا إعادة التّفكير في حركاتنا التّالية

240
00:12:12,230 --> 00:12:16,770
.نحن نعمل لعرض القدّيسة كونوها ليونيفرسم

241
00:12:20,460 --> 00:12:21,920
فيلاّ عائلة دانديلايون

242
00:12:21,020 --> 00:12:24,680
في الصّباح التّالي، عندما رأونا
،وقد عدنا بحالة يُرثى لها

243
00:12:24,680 --> 00:12:29,040
أجّلت كونوها وغينوفورد أسئلتهما حتّى
.وقت لاحق وطلبا من الطّبيب فحصنا

244
00:12:29,390 --> 00:12:31,050
.يعاني سول من خدوش فحسب

245
00:12:31,050 --> 00:12:34,310
وتعاني السّيّدة إيانا من كدمات
.وآثار عضّ على عنقها

246
00:12:34,310 --> 00:12:36,250
،أمّا طعنة السّيّد يومي

247
00:12:36,350 --> 00:12:39,940
.فلم تكن عميقة كما ظننت
.ولا يبدو أنّ حياته في خطر

248
00:12:40,170 --> 00:12:42,940
،حمدًا على هذا. سيكون بخير إذًا
صحيح أيّها الطّبيب؟

249
00:12:42,940 --> 00:12:45,970
ولكن السّيّد يومي قد استعمل
.الكثير من السّحر

250
00:12:45,970 --> 00:12:47,570
.إنّ نظام مناعته ضعيف الآن

251
00:12:47,820 --> 00:12:52,320
أعتقد أنّ علاجَ مشاكله في مكان آخرَ
.بتجهيزات أحسن سيكون أفضل

252
00:12:52,720 --> 00:12:53,960
،آنسة إيانا

253
00:12:54,150 --> 00:12:57,710
،عند استغلال مستعمل سحر
.فقد تتعرّض حياته للخطر

254
00:12:57,710 --> 00:13:00,400
آمل أن تأخذي هذه الفرصة
.وتتعلّمي من هذا

255
00:13:00,400 --> 00:13:03,290
.أرواح النّاس ليست لعبة

256
00:13:03,770 --> 00:13:04,890
.إنّه ليس مخطئًا

257
00:13:05,090 --> 00:13:07,700
أيّها الطّبيب، ما الّذي تقوله
لسيّدةٍ من آل ماغنوليا؟

258
00:13:07,700 --> 00:13:10,310
!كلّ ما فعلتُ هو قول الحقيقة

259
00:13:10,310 --> 00:13:13,360
إن لم يعجبها هذا، فعليها التّخلّص
!مع هذا الأحمق العجوز فحسب

260
00:13:13,950 --> 00:13:14,600
.سيّدتي إيانا

261
00:13:20,180 --> 00:13:22,380
.أنت محقّ تمامًا في كلامك أيّها الطّبيب

262
00:13:24,980 --> 00:13:27,690
...هذه الأحداث، وإصابات سول ويوري

263
00:13:27,950 --> 00:13:31,160
،عرَّضتْهما تصرّفاتي للخطر
.وكانت هذه هي العواقب

264
00:13:31,760 --> 00:13:34,810
عندما رأيتُ الإلف الشّابّ
،الّذي مكث هنا معنا

265
00:13:34,810 --> 00:13:37,920
،لم أستطع منع فضولي
.وذهبتُ ساعية لإيجاد القرية الخفيّة

266
00:13:37,920 --> 00:13:39,040
كيف أمكنها القيام بذلك؟

267
00:13:39,040 --> 00:13:40,670
هل يعني ذلك أنّها انتهكت العهد؟

268
00:13:40,670 --> 00:13:43,920
.لم أصغِ عندما حاولوا إيقافي
...وكانت تصرّفاتي الاستبداديّة

269
00:13:44,430 --> 00:13:46,810
.سببًا في وقوع هذه النّتيجة

270
00:13:47,070 --> 00:13:49,160
.أنا فعلاً جدُّ آسفة

271
00:13:51,180 --> 00:13:53,040
.شرّيرة تتظاهر بالبراءة

272
00:13:53,040 --> 00:13:53,750
!أيّها الطّبيب

273
00:13:53,750 --> 00:13:54,160
—أنا

274
00:13:54,160 --> 00:13:54,940
.إيانا

275
00:13:54,940 --> 00:13:57,060
.تعالي معي. لنناقش الباقي وحدنا

276
00:13:57,310 --> 00:13:59,430
كونوها، أيمكنني ترك هذا لك؟

277
00:13:59,870 --> 00:14:00,620
.أكيد

278
00:14:00,750 --> 00:14:03,440
.وسأقدّم لكما بعض الشّاي عندما تعودان

279
00:14:03,440 --> 00:14:04,050
.هيّا بنا

280
00:14:04,050 --> 00:14:04,520
.أكيد

281
00:14:04,520 --> 00:14:08,740
سيّد غينوفورد، إن كانت هذه الشّرّيرة
!متورّطة، فعليك استدعاء الشّرطة

282
00:14:08,740 --> 00:14:09,870
.لا داعي لذلك

283
00:14:10,060 --> 00:14:13,050
.سأتولّى هذه المسألة من الآن فصاعدًا

284
00:14:13,360 --> 00:14:17,710
وبناء على هذا، يُحظر أيّ استجواب
.أو تحقيق إضافيّ من أيّ شخص

285
00:14:17,930 --> 00:14:19,670
،وإن كان هناك من هو غير راض عن ذلك

286
00:14:19,830 --> 00:14:21,340
.فليتحدّث إليّ مباشرة

287
00:14:22,630 --> 00:14:23,250
.هيّا بنا

288
00:14:23,790 --> 00:14:26,810
تختلف هذه الحادثة عن سابقاتها
.الّتي حدثت حتّى الآن

289
00:14:27,050 --> 00:14:29,720
...القصّة الّتي حاولتُ أن أسبقها وأوقفها

290
00:14:29,720 --> 00:14:32,720
.قد سبقتني أنا وحدثت في كلّ الأحوال

291
00:14:33,150 --> 00:14:36,810
كان يُفترض أن يُدمَّر كتاب
،التّاريخ المظلم "عند إعادة تجسّدي"

292
00:14:36,810 --> 00:14:39,310
.لذا لا أفهم كيف حدث كلّ هذا

293
00:14:39,520 --> 00:14:43,820
،ولكن في هذه المرّة
.سمعتُ قصص سول ويومي وكاغورا

294
00:14:44,070 --> 00:14:48,240
،لو أنّكم لم تتدخّلوا
.كانت قوى كونوها لتستيقظ

295
00:14:49,150 --> 00:14:51,450
أكان كلّ هذا خطّة لإيقاظ قوى كونوها؟

296
00:14:52,060 --> 00:14:53,700
.شوارتز لو شوفاليي

297
00:14:54,080 --> 00:14:58,070
،لا أعرف من يكون كاغورا بالضّبط
...لكنّي واثقة من شيء واحد

298
00:14:58,790 --> 00:15:02,500
إنّ شيئًا ما لا يمكنني تولّي
.أمره وحدي يستهدف كونوها

299
00:15:03,860 --> 00:15:04,340
.إيانا

300
00:15:04,660 --> 00:15:07,720
هل تحدّث السّيّد يومي بصدق
بشأن الهجوم؟

301
00:15:09,460 --> 00:15:10,970
—سيّد غينوفورد

302
00:15:09,900 --> 00:15:12,420
من الّذي هاجمه وأين وقع ذلك وبأيّ وسيلة؟

303
00:15:12,720 --> 00:15:17,250
،سأطلب من سول تقديم تقرير لاحقًا
.لكنّي أريد سماع نسختك عمّا جرى أيضًا

304
00:15:20,120 --> 00:15:21,900
هل يمكنك إخباري بكلّ شيء؟

305
00:15:22,640 --> 00:15:25,030
هل سيشكّ فيّ ثانية؟

306
00:15:33,450 --> 00:15:37,010
أعتقد أنّ هذه القرية قد تعرّضت
.لهجوم من قِبل مصّاص دماء

307
00:15:37,410 --> 00:15:41,410
إن لم نتصرّف، فحينها بلدات البشر
.وحتّى أختي كونوها قد تكون في خطر

308
00:15:41,930 --> 00:15:43,560
.لذلك سأطلب المساعدة من كليكما

309
00:15:44,110 --> 00:15:48,450
في تلك اللّحظة، كان كلّ شيء مخطّط له
.على يد السّيّدة إيانا كما أشار السّيّد يومي

310
00:15:48,710 --> 00:15:52,290
ربّما فشلتْ في السّيطرة على الإلف
.وتسبّبتْ في هذه الظّروف

311
00:15:52,470 --> 00:15:54,430
.إنّ جزءًا منّي يعتبر هذا احتمالاً واردًا

312
00:15:55,080 --> 00:15:57,630
قبل نصف سنة، قبلتُ عرض
.اغتيالٍ قدّمه السّيّد غينوفورد

313
00:15:57,860 --> 00:16:01,180
،وحتّى بعد أن سحبه
.ظلّ حسٌّ عميق من الشّكّ داخلي

314
00:16:02,300 --> 00:16:06,340
،لكن بعد أنّ عضّها مصّاص دماء
...في اللّحظة الّتي رأيتها تحاول إيذاء نفسها

315
00:16:09,130 --> 00:16:10,910
!سول، أنا آسفة

316
00:16:18,910 --> 00:16:21,290
سول، أيُعقل أنّك قلق حيال أمر ما؟

317
00:16:21,540 --> 00:16:22,480
.سيّدتي كونوها

318
00:16:22,480 --> 00:16:23,780
.يبدو هذا غريبًا

319
00:16:24,320 --> 00:16:26,480
...لا أصدّق أنّي قد رأيتُك قلقًا

320
00:16:27,360 --> 00:16:30,010
عندما التقينا أوّل مرّة، ما كنتُ
.لأتخيّل أبدًا حدوث أمر كهذا

321
00:16:30,300 --> 00:16:33,850
لكن نظرًا للشّخص الّذي كنتَه
.مؤخّرًا، يبدو ذلك طبيعيًّا لي

322
00:16:34,550 --> 00:16:36,810
—سيّدتي كونوها، لستُ قلقًا حيال

323
00:16:36,950 --> 00:16:37,480
.ضحكة

324
00:16:37,480 --> 00:16:39,310
!لا داعي لنكران الأمر

325
00:16:39,520 --> 00:16:41,840
!من الطّبيعيّ أن يقلق النّاس

326
00:16:41,840 --> 00:16:44,810
!أعتقد أنّ هنالك إجابة تحاول العثور عليها

327
00:16:43,690 --> 00:16:44,810
إمساك

328
00:16:44,810 --> 00:16:48,820
تغريد

329
00:16:44,810 --> 00:16:48,820
.مع أنّي لا أتحدّث عن الأمر كخبيرة أو ما شابه

330
00:16:48,820 --> 00:16:49,780
...ولكن

331
00:16:50,000 --> 00:16:52,160
.آمل ألاّ تحاول تجاهل حيرتك أو إقصاء شكوكك

332
00:16:52,570 --> 00:16:54,590
.لأنّنا نتحدّث عن قلبك هنا

333
00:16:55,750 --> 00:16:56,480
قلبي؟

334
00:16:58,560 --> 00:16:59,790
...إنّ شيئًا كهذا ليس

335
00:17:01,620 --> 00:17:02,470
.إيانا

336
00:17:02,800 --> 00:17:03,710
.أنا آسفة

337
00:17:04,200 --> 00:17:07,960
كما شرحتُ سابقًا، ذهبتُ
.لقرية الإلف بدافع الفضول

338
00:17:07,960 --> 00:17:09,960
.ثمّ تورّطنا في الحادثة بعد ذلك

339
00:17:10,230 --> 00:17:11,770
،لا يمكنني إخباره أنّ كونوها قدّيسة

340
00:17:11,770 --> 00:17:15,430
أو أنّي كنتُ أحاول استباق الأحداث
.لإيقافها، لذلك عليّ توخّي الحذر

341
00:17:15,940 --> 00:17:20,040
...بعد انتهاء كلّ شيء، قام كاغورا
.هاجم كاغورا أيفي يومي

342
00:17:20,040 --> 00:17:22,730
