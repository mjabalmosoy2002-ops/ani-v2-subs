1
00:00:00,560 --> 00:00:01,820
،عندما كنتُ في الإعداديّة

2
00:00:02,160 --> 00:00:07,240
كتبتُ قصّة ومنحتُ البطلة
.الجميلة اسمي، كونوها

3
00:00:07,240 --> 00:00:10,870
...تضمّنت الحبّ والسّحر
!مغامرة فانتازيّة

4
00:00:13,160 --> 00:00:16,570
لكن في طريقي للمنزل
.من العمل، تعرّضتُ لحادث

5
00:00:17,960 --> 00:00:22,680
ثمّ تجسّدتُ ثانية في عالم القصّة
،"الّتي كتبتُها، "التّاريخ المظلم

6
00:00:19,870 --> 00:00:23,620
"التّاريخ المظلم"

7
00:00:23,010 --> 00:00:25,920
ولكن ليس ككونوها، الشّخصيّة
،الرّئيسيّة الّتي وددتُ أن أكون

8
00:00:26,250 --> 00:00:28,700
.بل كالشّخصيّة الشّرّيرة الّتي تحاول قتلها

9
00:00:28,700 --> 00:00:31,410
.وُلدتُ ثانية بصفتي إيانا ماغنوليا

10
00:00:36,660 --> 00:00:39,060
.سأنهي أمره من أجلك

11
00:00:39,630 --> 00:00:45,520
قال يومي أنّه سيقتل سول، القاتل
.ذو المواصفات العاليّة، من أجلي

12
00:00:45,520 --> 00:00:52,530
"راية موت"

13
00:00:50,750 --> 00:00:52,260
.سأشرح الأمر ليسهل فهمه

14
00:00:52,740 --> 00:00:56,530
"...إن قتل يومي سول"

15
00:00:53,360 --> 00:00:56,020
...إن قتل يومي سول

16
00:00:56,520 --> 00:01:00,540
أوّلاً: سيكون هناك بحث عن الجاني
.الّذي قتل سول وأحزن كونوها

17
00:00:57,240 --> 00:01:00,540
من؟ من الفاعل؟

18
00:01:01,000 --> 00:01:03,530
.ثانيًا: سيكتشفون أنّ يومي قتله من أجلي

19
00:01:04,210 --> 00:01:06,660
ثالثًا: سيشكّون في أنّي العقل
.المدبّر وسيعدمونني

20
00:01:07,330 --> 00:01:11,050
"...إن لم يستطع يومي قتل سول"

21
00:01:08,090 --> 00:01:10,550
...إن لم يستطع يومي قتل سول

22
00:01:11,230 --> 00:01:14,040
.أوّلاً: ستنكشف محاولة يومي لقتل سول

23
00:01:14,280 --> 00:01:17,040
ثانيًا: سيشتبهون أنّي العقل
.المدبّر وسيعدمونني

24
00:01:17,040 --> 00:01:19,120
!هذا صحيح! سأُعدم في كلّ الأحوال

25
00:01:19,050 --> 00:01:21,310
"حفيف"

26
00:01:19,400 --> 00:01:21,300
ألن يكون إقناعه كافيًا؟

27
00:01:21,300 --> 00:01:24,730
لا يهمّ كيف أتصرّف، إلاّ أنّ رايات
!الموت هذه تظهر مثل الحشائش

28
00:01:24,350 --> 00:01:27,850
"!!كلاّ"

29
00:01:28,230 --> 00:01:33,980
"قلق، قلق، قلق"

30
00:01:28,960 --> 00:01:33,440
،إن لم أوقفه عند حدّه بالكامل
!فسينتهي كلّ شيء

31
00:03:04,070 --> 00:03:08,370
راية الموت 4: بغضّ النّظر عمّن يموت، سأصبح مشتبهًا بها

32
00:03:14,980 --> 00:03:17,630
.سيّدتي كونوها، إليك شايك وكعكتك

33
00:03:17,630 --> 00:03:18,720
.شكرًا لك يا سول

34
00:03:19,020 --> 00:03:22,480
.إنّ سول إلى جانب كونوها دائمًا ويخدمها

35
00:03:22,480 --> 00:03:24,230
!سـ-سيّدتي إيانا؟

36
00:03:24,620 --> 00:03:26,510
!ويومي... في مكان ما قريب

37
00:03:28,340 --> 00:03:31,640
ظننتُ أنّي تذكّرتُ كلّ شيء
،"في "التّاريخ المظلم

38
00:03:31,640 --> 00:03:35,230
لكنّي لستُ واثقة جدًّا حيال
.الأحداث خارج القصّة الرّئيسيّة

39
00:03:53,160 --> 00:03:54,310
ماذا؟ رياح؟

40
00:03:57,420 --> 00:03:58,330
!سول

41
00:04:06,670 --> 00:04:08,650
هل حدث شيء ما يا سيّدتي إيانا؟

42
00:04:09,600 --> 00:04:12,100
!أنا من تريد أن تعرف ماذا حدث

43
00:04:12,440 --> 00:04:14,370
...هـ-هل أنت بخير؟ إنّ ركبتيك

44
00:04:14,370 --> 00:04:16,240
أظهرك بخير؟ وهل لديك
أيّ عظام مكسورة؟

45
00:04:16,230 --> 00:04:17,610
"!كلاّ! تخيّلت كلّ ذلك للتّوّ"

46
00:04:16,240 --> 00:04:18,410
!كلاّ! تخيّلت كلّ ذلك للتّوّ

47
00:04:18,400 --> 00:04:20,600
لا تضغط على نفسك كثير
!فقط لأنّك شابّ

48
00:04:23,010 --> 00:04:26,760
أيُعقل... أنّك قلقة عليّ؟

49
00:04:28,120 --> 00:04:32,380
!مصيبة! إ-إنّه يشتبه بي سلفًا

50
00:04:28,120 --> 00:04:37,130
"كلاّاااا"

51
00:04:32,530 --> 00:04:36,180
ألا تخجلين من نفسك أيّتها الشّرّيرة؟
ما الّذي تخطّطين له؟

52
00:04:37,880 --> 00:04:39,630
.لا أواجه أيّ صعوبات

53
00:04:40,500 --> 00:04:41,240
!سيّدتي كونوها

54
00:04:41,700 --> 00:04:44,000
!سول! سأذهب لإحضار شخص ما

55
00:04:46,770 --> 00:04:50,250
،شعرتُ بوجودٍ مثير للشّبهات
.لكنّي تأخّرتُ في الاستجابة له

56
00:04:50,650 --> 00:04:53,550
تفاديه للهجوم بتلك الطّريقة كانت
.استجابة بطيئة"؟ هذا مثير للاهتمام"

57
00:04:53,800 --> 00:04:55,410
...على الأرجح أنّه كان سحرًا

58
00:04:56,530 --> 00:04:59,460
المعذرة، على الأرجح
.أنّها كانت هبّة رياح مفاجئة

59
00:04:59,610 --> 00:05:01,920
.نعم، هذا صحيح

60
00:05:01,920 --> 00:05:05,150
قبل كلّ شيء، لا يوجد أيّ شخص
.بإمكانه استعمال السّحر في القصر

61
00:05:05,630 --> 00:05:07,480
.نعم، نعم. ذلك صحيح

62
00:05:08,280 --> 00:05:09,670
!مهلاً. بل هنالك شخص

63
00:05:10,240 --> 00:05:11,400
هل من خطب ما؟

64
00:05:11,400 --> 00:05:13,040
!لا، لا، لا! ما من خطب

65
00:05:13,460 --> 00:05:15,610
إن سارت الأمور حسب القصّة
،"في "التّاريخ المظلم

66
00:05:15,850 --> 00:05:18,120
.كانت قدرات كونوها السّحريّة لتستيقظ

67
00:05:18,370 --> 00:05:22,410
لذلك فالكثير من الشّخصيّات
.الّتي تعارضها لديها سحر أيضًا

68
00:05:24,550 --> 00:05:25,520
!أنا أتذكّر الآن

69
00:05:25,520 --> 00:05:30,500
ركّز يومي في دراساته في الخارج
!على السّحر والسّمّ في المجال الطّبّيّ

70
00:05:30,790 --> 00:05:33,030
على الأرجح أنّ تلك الرّياح
.كانت من صنيع يومي

71
00:05:33,310 --> 00:05:38,150
"ضرب، ضرب"

72
00:05:33,560 --> 00:05:38,320
لكنّي أتمنّى لو لم يطلق سحرًا على خادم
!باستطاعته تفادي هجوم مفاجئ بكلّ أناقة

73
00:05:38,550 --> 00:05:39,260
!سيتمّ الإمساك به

74
00:05:47,070 --> 00:05:48,450
"في اليوم التّالي"

75
00:05:47,290 --> 00:05:48,120
.في اليوم التّالي

76
00:05:49,640 --> 00:05:53,250
سأتمالك نفسي وأقضي اليوم
!مع يومي في الحديقة

77
00:05:53,760 --> 00:05:55,320
الورود جميلة، أليس كذلك؟

78
00:05:57,680 --> 00:05:59,790
!إنّهما أختي والسّيّد غينوفورد

79
00:06:00,000 --> 00:06:01,270
.لا بأس بالنّوم إن كنت تشعرين بالنّعاس

80
00:06:02,080 --> 00:06:04,150
سهرتِ لوقت متأخّر البارحة
وأنت تُطالعين، صحيح؟

81
00:06:06,780 --> 00:06:07,680
...لكن

82
00:06:07,680 --> 00:06:10,480
.نامي فحسب. سأكون هنا معك

83
00:06:14,310 --> 00:06:14,820
ماذا هنالك؟

84
00:06:15,180 --> 00:06:17,820
أتستمتعان بأشعة الشّمس أيضًا
يا سيّد يومي وإيانا؟

85
00:06:19,250 --> 00:06:21,130
إنّه ليس مُحرَجًا ولو قليلاً؟

86
00:06:22,100 --> 00:06:23,910
!سول! أنت هنا أيضًا؟

87
00:06:24,610 --> 00:06:26,180
.لم أرَ أيّ شيء

88
00:06:26,460 --> 00:06:27,860
!خادم خفيّ

89
00:06:27,850 --> 00:06:29,000
...عفوًا

90
00:06:27,860 --> 00:06:30,040
!هذان هما البطل والبطلة الرّئيسيّان

91
00:06:30,260 --> 00:06:31,080
!بالمناسبة

92
00:06:31,280 --> 00:06:36,290
ما رأيك بشرب الشّاي معنا حتّى
تستيقظ كونوها يا سيّد غينوفورد؟

93
00:06:36,290 --> 00:06:37,130
!يومي

94
00:06:37,310 --> 00:06:41,640
سمعتُ أنّهم يبذلون جهدًا كبيرًا في زراعة
!الشّاي في أراضي السّيّد غينوفورد

95
00:06:41,640 --> 00:06:44,410
أحضرتُ بعض الشّاي عالي
الجودة من مملكة ليلي

96
00:06:44,410 --> 00:06:46,390
.وأودّ تجربته معًا

97
00:06:46,770 --> 00:06:49,770
مزيج أوراق شاي من ليلي؟
.ستكون توليفة غير عاديّة

98
00:06:50,080 --> 00:06:50,940
.أودّ تجربة القليل منه

99
00:06:51,720 --> 00:06:54,980
،ثمّة خدعة صغيرة بخصوص تحضيره
.لذلك سأعدّ الشّاي بنفسي

100
00:06:55,790 --> 00:06:56,590
.ولك أنت أيضًا

101
00:06:57,160 --> 00:06:58,550
—لا، أنا لن

102
00:06:58,550 --> 00:06:59,900
لا بأس من وقت لآخر، صحيح؟

103
00:07:00,680 --> 00:07:01,180
.حاضر

104
00:07:02,240 --> 00:07:03,600
!لا، هذا سيّئ

105
00:07:04,050 --> 00:07:06,500
!قبل كلّ شيء، يومي خبير بالسّموم

106
00:07:11,190 --> 00:07:12,850
...ذلك وبكلّ تأكيد

107
00:07:13,320 --> 00:07:15,330
!يحتوي على سمّ

108
00:07:15,330 --> 00:07:17,830
!يا إلهي! لمست قطّة قدماي

109
00:07:21,150 --> 00:07:23,250
.آسفة يا يومي. تعثّرت قدماي

110
00:07:23,650 --> 00:07:24,220
".ضحك"

111
00:07:24,220 --> 00:07:26,040
.لا، لا بأس

112
00:07:26,490 --> 00:07:28,640
.لا بدّ أنّك لم تحبّي فكرة القتل بالسّمّ

113
00:07:28,640 --> 00:07:29,350
.هذا مؤسف

114
00:07:29,610 --> 00:07:32,550
مهلاً، يمكنك على الأقلّ محاولة
!خيانة توقّعاتي

115
00:07:32,840 --> 00:07:34,320
هل أنتما بخير؟

116
00:07:34,610 --> 00:07:37,650
.سأنظّف هذا في الحال
.احرصا على ألاّ تلمسا أيّ شظايا

117
00:07:37,650 --> 00:07:39,060
...سول! إنّ ذلك

118
00:07:39,740 --> 00:07:41,160
...هذه الرّائحة

119
00:07:42,130 --> 00:07:43,560
!سول! لا داعي للنّظر لذلك

120
00:07:43,760 --> 00:07:46,270
لا يمكنني أن أسمح له برؤية
!شيء مثل شاي مسموم

121
00:07:46,270 --> 00:07:49,960
سول قاتل، لذلك إن أمعن النّظر
!فيه، فسيكتشف كلّ شيء بالفعل

122
00:07:49,960 --> 00:07:50,560
"!عطسة"

123
00:07:51,490 --> 00:07:52,880
كونوها، أتشعرين بالبرد؟

124
00:07:53,420 --> 00:07:55,440
.أنا آسفة يا سيّد غينوفورد

125
00:07:55,440 --> 00:07:56,240
أرأيت؟

126
00:07:56,240 --> 00:08:00,400
دع هذا لنا. اذهب وضع
.بطّانيّة على كونوها

127
00:08:00,400 --> 00:08:01,030
...لكن

128
00:08:01,030 --> 00:08:02,960
سيكون علينا إحضار أدوات
!تنظيف في كلّ الأحوال

129
00:08:02,960 --> 00:08:04,840
!لنذهب يا يومي! هيّا بنا

130
00:08:05,350 --> 00:08:06,310
!مهلاً، إيانا

131
00:08:06,680 --> 00:08:09,680
.سيكون من السّيّئ إن وقعتِ
.لنأخذ وقتنا

132
00:08:10,260 --> 00:08:11,470
.حـ-حسنًا

133
00:08:12,010 --> 00:08:14,170
.إنّ يداه لطيفتان جدًّا وهو يلمسني

134
00:08:15,410 --> 00:08:19,970
،بصفته عضوًا من عائلة كونت
.خضع يومي لتعليم جيّد

135
00:08:19,970 --> 00:08:24,680
.قد يكون شرّيرًا، لكنّه ليس غاشمًا أو غبيًّا

136
00:08:27,940 --> 00:08:33,880
وعندما كان طفلاً، كان يفتقر للثّقة
.بنفسه، وسخر منه إخوته كثيرًا

137
00:08:35,730 --> 00:08:37,520
،ومع أنّ من حولها يتحدّثون بالسّوء حيالها

138
00:08:37,760 --> 00:08:41,360
.إلاّ أنّ الشّرّيرة إيانا تظلّ صامدة
...لو أنّه لم يلتقيها

139
00:08:42,030 --> 00:08:43,350
...لو أنّه لم يُعجب بها

140
00:08:46,440 --> 00:08:50,070
،بغضّ النّظر لعلاقته بإيانا
!يومي شخص رائع

141
00:08:50,070 --> 00:08:52,680
.مكانته الاجتماعيّة عالية
.وسامته شديدة. شخصيّته جيّدة

142
00:08:53,000 --> 00:08:55,510
لماذا وقع في حبّ شخص مثلي؟

143
00:08:58,680 --> 00:08:59,440
...ذلك

144
00:09:01,240 --> 00:09:03,140
!ذلك لأنّي كتبتُ القصّة هكذا

145
00:09:03,140 --> 00:09:04,020
!هذه جريمة

146
00:09:04,020 --> 00:09:04,680
إيانا؟

147
00:09:04,060 --> 00:09:04,690
"هذه جريمة"

148
00:09:05,990 --> 00:09:09,950
كبداية، البطلة مستهدفة من
...صديق طفولتها الوسيم

149
00:09:08,970 --> 00:09:09,950
!أنت شرّير؟

150
00:09:10,530 --> 00:09:13,390
ستتعرّض البطلة للأذى لأنّ عليها
...هزيمة صديق طفولتها

151
00:09:13,390 --> 00:09:14,090
!يومي

152
00:09:14,820 --> 00:09:18,460
سيُشفى قلب البطلة بفضل
...كلّ الرّجال الوسيمين حولها

153
00:09:19,280 --> 00:09:21,300
.كونوها، هذا ليس خطأك

154
00:09:21,580 --> 00:09:22,460
!يا رفاق

155
00:09:22,710 --> 00:09:25,320
ولتحقيق كلّ هذه النّقاط
،الثّلاثة حسبما أريد

156
00:09:22,950 --> 00:09:24,770
!سيُبكي هذا المشهد الجميع

157
00:09:25,320 --> 00:09:27,380
...فمصير يومي الوحيد هو الموت

158
00:09:27,680 --> 00:09:31,280
إنّ أنا السّابقة مجرّد حثالة
!لأنّي فكّرتُ في سيناريو مريع كهذا

159
00:09:31,840 --> 00:09:35,590
"شخصيّة ثانويّة"

160
00:09:32,220 --> 00:09:35,330
مع أنّي كنتُ غير سعيدة
.حيال أمور عدّة وقتها

161
00:09:35,590 --> 00:09:41,220
"حمل كراسي قابلة للطّيّ"

162
00:09:35,590 --> 00:09:41,220
"ابتسامة" "صرخة"

163
00:09:36,010 --> 00:09:38,280
!تبدو هذه ثقيلة. سأحمل نصفها عنك

164
00:09:38,510 --> 00:09:41,220
.ليس عليك هذا. شكرًا لك

165
00:09:41,220 --> 00:09:42,830
ساتو، يمكنك حمل أربعة، صحيح؟

166
00:09:41,220 --> 00:09:44,220
"حمل كراسي قابلة للطّيّ"

167
00:09:41,220 --> 00:09:44,220
"بكلّ صراحة"

168
00:09:43,030 --> 00:09:44,220
.نـ-نعم

169
00:09:44,220 --> 00:09:47,420
!أريد أن أُعامَل كبطلة

170
00:09:47,420 --> 00:09:50,220
ورغم ذلك، لماذا لم أدرك الأمر؟

171
00:09:50,500 --> 00:09:53,880
.ليس لديّ الحقّ لأنزعج من يومي

172
00:09:54,190 --> 00:09:57,740
اسمع رجاءً يا يومي. ما فعلتَه
—من قبل، ليس عليك أن

173
00:10:01,500 --> 00:10:04,640
.يا لك من مسكين، إنّك ترتعدين

174
00:10:05,040 --> 00:10:07,070
كان ذلك الخادم مخيفًا، صحيح؟

175
00:10:10,240 --> 00:10:10,680
".ضحكة"

176
00:10:11,340 --> 00:10:12,720
.لا بأس يا إيانا

177
00:10:13,280 --> 00:10:14,320
.لا داعي للقلق

178
00:10:14,680 --> 00:10:18,760
يجدر بالسّحر الّذي جهّزته
.أن يعمل في أيّ لحظة الآن

179
00:10:18,760 --> 00:10:22,510
"سيعمل السّحر الّذي جهّزه"

180
00:10:19,000 --> 00:10:22,510
سيعمل السّحر الّذي جهّزه؟

181
00:10:22,760 --> 00:10:24,510
"سيعمل"

182
00:10:23,580 --> 00:10:24,510
!سيعمل؟

183
00:10:25,100 --> 00:10:26,520
!ما كان هذا الضّجيج؟

184
00:10:26,520 --> 00:10:27,430
"سيعمل"

185
00:10:26,680 --> 00:10:29,310
!لا، لا نريد أن يعمل أيّ شيء

186
00:10:30,370 --> 00:10:31,030
إيانا؟

187
00:10:31,310 --> 00:10:35,520
على الأرجح أنّ سحر يومي بين
.المنخفض والمتوسّط من ناحية القوّة

188
00:10:35,520 --> 00:10:37,240
.لم يستيقظ سحري بعد

189
00:10:37,520 --> 00:10:40,640
،إن كان سحر كونوها قد استيقظ
،فما كان ذلك ليشكّل أيّ تهديد

190
00:10:40,640 --> 00:10:42,480
.لكنّ كونوها الحاليّة معرّضة للخطر

191
00:10:43,280 --> 00:10:46,280
.واثقة أنّ سول وغينوفورد سيحميانها

192
00:10:46,560 --> 00:10:48,440
...لكن إن أخذهما على حين غرّة

193
00:10:48,990 --> 00:10:49,790
!هذا سيّئ

194
00:10:50,290 --> 00:10:51,160
!سيّدتي كونوها

195
00:10:51,990 --> 00:10:52,690
!كونوها

196
00:10:58,900 --> 00:10:59,760
!كونوها

197
00:11:02,360 --> 00:11:04,350
!كونوها

198
00:11:05,070 --> 00:11:05,840
!إيانا

199
00:11:06,900 --> 00:11:07,760
!هذا مؤلم

200
00:11:07,390 --> 00:11:09,640
"ساقي"

201
00:11:07,760 --> 00:11:09,640
!ساقي

202
00:11:10,580 --> 00:11:14,850
لا يعرف يومي أيّ شيء وهو موجود من
!أجلي فقط. ليس من العادل أن يموت

203
00:11:15,760 --> 00:11:17,930
الوحيد الّذي عليه أن يعاني
.من أفعاله هو أنا

204
00:11:20,650 --> 00:11:23,910
...سأحميه. وكما سأفعل برايات موتي

205
00:11:26,160 --> 00:11:29,000
سأفعله برايات موت يومي
!أيضًا وأكسرها

206
00:11:38,960 --> 00:11:41,720
"!كلاّ! لقد قُطّعت لأشلاء"

207
00:11:39,090 --> 00:11:41,390
!كلاّ! لقد قُطّعت لأشلاء

208
00:11:41,720 --> 00:11:44,520
.أخذ الأمر لحظة واحدة
ما مدى كفاءة مواصفاتهما العالية؟

209
00:11:44,940 --> 00:11:45,560
!كونوها

210
00:11:46,100 --> 00:11:46,880
!سيّدتي كونوها

211
00:11:47,830 --> 00:11:51,280
!إن تواجه مع ذلك، فسيُقتل يومي بالتّأكيد

212
00:11:51,280 --> 00:11:53,400
!آهٍ يا يومي

213
00:11:53,400 --> 00:11:54,890
هل أنت بخير يا إيانا؟

214
00:11:57,560 --> 00:11:58,540
.أنا آسف

215
00:12:00,520 --> 00:12:00,950
...يو

216
00:12:01,550 --> 00:12:04,860
مؤخّرًا، شعرتُ بشخص
.له نيّة شرّيرة في الجوار

217
00:12:06,040 --> 00:12:07,400
،هذا ليس أكثر من مجرّد تخمين

218
00:12:07,840 --> 00:12:11,040
ولكنّني أعتقد أنّ هذه الزّهرة آكلة
.البشر ربّما كانت تستهدفني أيضًا

219
00:12:11,350 --> 00:12:13,280
أنت يا سول؟ لكن من كان ليفعل ذلك؟

220
00:12:14,930 --> 00:12:17,820
...في الحديقة، ذلك الشّاي المُراق

221
00:12:19,000 --> 00:12:20,990
.كانت رائحته مثل سمّ شممتُه منذ مدّة

222
00:12:21,600 --> 00:12:23,110
.لم أستطع التّحرّك

223
00:12:25,000 --> 00:12:27,220
!سول! لا داعي للنّظر لذلك

224
00:12:27,830 --> 00:12:32,240
سيّدتي إيانا، تبدو تصرّفاتك
.غريبة نوعًا ما مؤخّرًا

225
00:12:33,410 --> 00:12:35,840
هل تعرفين شيئًا عن هذه الحوادث؟

226
00:12:36,720 --> 00:12:37,300
ماذا؟

227
00:12:39,510 --> 00:12:41,480
!إذًا فأنت تشتبه بي بالفعل

228
00:12:44,580 --> 00:12:47,360
.كان أنا. كان أنا الفاعل

229
00:12:49,650 --> 00:12:51,230
.لا علاقة لإيانا بأيّ من هذا

230
00:12:51,710 --> 00:12:53,960
!لن أسمح ولو بذرّة شبهات أن تحوم حولها

231
00:12:56,410 --> 00:12:57,250
يومي؟

232
00:12:57,460 --> 00:13:01,210
احمله. إنّ حمل ذلك القفّاز
!يعني قبولك للنّزال

233
00:13:07,590 --> 00:13:11,720
!سول نيموفيرا، لنخض أنا وأنت نزالاً

234
00:13:11,720 --> 00:13:13,930
!ماذا؟

235
00:13:20,980 --> 00:13:23,940
"التّاريخ المظلم للشّرّيرة المتجسّدة"

236
00:13:23,940 --> 00:13:28,700
"قفّاز يومي"

237
00:13:24,440 --> 00:13:25,360
.احمله

238
00:13:25,560 --> 00:13:28,240
!إنّ حمل ذلك القفّاز يعني قبولك للنّزال

239
00:13:29,000 --> 00:13:31,990
نلت كفايتي من هذه الطّرق
.الملتوية. لنخض نزالاً

240
00:13:31,990 --> 00:13:34,500
!لا-لا تفعلا

241
00:13:35,400 --> 00:13:36,390
!لا تحمله يا سول

242
00:13:36,390 --> 00:13:39,270
إن كنتَ قاتلاً بارد الأعصاب، فسوِّ
!هذه المسألة بمحاولات اغتيال

243
00:13:39,530 --> 00:13:40,390
.سول

244
00:13:41,160 --> 00:13:45,800
!لا أذكر أنّي ربّيتُك لتكون رجلاً حامي الأعصاب

245
00:13:49,870 --> 00:13:51,110
.أنا أقبل تحدّيك

246
00:13:51,620 --> 00:13:52,980
!كلاّ يا سول

247
00:13:53,150 --> 00:13:54,250
لماذا حملته؟

248
00:13:54,520 --> 00:14:03,480
"...بلع"

249
00:13:54,560 --> 00:13:56,180
.بلع"... أنا أفهم الآن"

250
00:13:56,570 --> 00:13:59,810
.وضعت تلك الزّهرة آكلة البشر كونوها في خطر

251
00:13:59,810 --> 00:14:03,480
لا بدّ أنّه غاضب كثيرًا
.وإن لم يبدُ ذلك على وجهه

252
00:14:03,620 --> 00:14:06,410
،مهما كان الوضع، بما أنّها قصّة كتبتُها

253
00:14:06,410 --> 00:14:09,790
من المستحيل للشّرّير أن يقاتل
!شخصًا في جانب الخير ويفوز

254
00:14:09,990 --> 00:14:10,990
!عليّ إيقاف هذا

255
00:14:11,210 --> 00:14:11,960
!يومي

256
00:14:12,230 --> 00:14:13,100
!لا تفعلا

257
00:14:14,870 --> 00:14:17,000
!واثقة أنّ هنالك سوء فهم ما في الأمر

258
00:14:18,590 --> 00:14:20,980
لا تلحقا الأذيّة ببعضكما بدون
...مناقشة الأمر أوّلاً

259
00:14:21,200 --> 00:14:22,390
!توقّفا فحسب

260
00:14:23,210 --> 00:14:27,630
"تلويح"

261
00:14:23,680 --> 00:14:24,520
!كونوها

262
00:14:24,520 --> 00:14:27,630
!صحيح، كان ذلك خيارًا أيضًا
!لا يمكن دحض قوى البطلة

263
00:14:27,630 --> 00:14:39,640
"دعم"

264
00:14:27,750 --> 00:14:30,160
!صوت كونوها هو صوت السّلطة

265
00:14:30,160 --> 00:14:33,410
!هـ-هذا صحيح! إنّها محقّة! هذا خطير

266
00:14:33,410 --> 00:14:36,100
!أختي كونوها محقّة تمامًا

267
00:14:36,100 --> 00:14:39,650
!أوقفا النّزال! تحدّثا معًا أوّلاً! تحدّثا

268
00:14:40,350 --> 00:14:41,370
نتحدّث أوّلاً؟

269
00:14:42,700 --> 00:14:44,130
.لا فائدة في ذلك بعد كلّ هذا الوقت

270
00:14:48,560 --> 00:14:50,400
...إن كنتِ عازمة على التّدخّل يا كونوها

271
00:14:53,870 --> 00:14:57,960
فهل عليّ رمي القفّاز الآخر على وجهك أيضًا؟

272
00:14:59,420 --> 00:15:00,370
!يومي

273
00:15:03,550 --> 00:15:07,680
ثمّة عدّة مشاهد نزال لا علاقة
.لها بالقصّة الرّئيسيّة

274
00:15:08,760 --> 00:15:10,840
...والدّافع خلفها دائمًا

275
00:15:11,900 --> 00:15:12,570
.هو البطلة

276
00:15:16,010 --> 00:15:17,850
،أنا جدّ آسف يا سيّدتي كونوها

277
00:15:18,900 --> 00:15:23,320
لكنّ رفض نزال بعد قبوله
.هو بمثابة إدارة ظهورنا لإله المعارك

278
00:15:23,510 --> 00:15:24,320
...لكن

279
00:15:24,690 --> 00:15:31,200
"دعم 2"

280
00:15:24,920 --> 00:15:28,830
!"هذا صحيح! أختي تقول "لكن

281
00:15:28,830 --> 00:15:31,520
!لا تقلقوا حيال أشياء كهذه

282
00:15:31,940 --> 00:15:33,200
.أنت محقّ تمامًا يا سول

283
00:15:34,220 --> 00:15:35,380
سيّد غينوفورد؟

284
00:15:35,630 --> 00:15:38,640
في هذا العالم، إنّ حمل القفّاز
الّذي تمّ إلقاؤه

285
00:15:38,640 --> 00:15:41,900
هو مثل إعلانك للآلهة
.أنّك ستخاطرين بحياتك في مبارزة

286
00:15:42,440 --> 00:15:43,620
.تعرفين ذلك يا كونوها

287
00:15:45,070 --> 00:15:48,850
!لا تقرأ محاولتي لبناء هذا العالم علنًا
!هذا محرج للغاية

288
00:15:49,470 --> 00:15:51,090
،بالنّظر لحادثة الزّهرة آكلة البشر

289
00:15:51,650 --> 00:15:54,540
،أودّ استجوابك في الحال

290
00:15:55,160 --> 00:15:58,290
لكن بما أنّه تمّت الموافقة على هذا
.النّزال، فلن أضغط عليك الآن

291
00:16:00,040 --> 00:16:02,310
،لا أعتقد أنّ سول سيخسر

292
00:16:03,280 --> 00:16:04,680
...لكن إن حدث ووقع ذلك

293
00:16:05,440 --> 00:16:05,980
"!!رغبة قتل"
"ضرب"

294
00:16:06,200 --> 00:16:07,320
...تفتّت، تفتّت

295
00:16:07,440 --> 00:16:08,640
.كفانا من المقدّمات

296
00:16:09,090 --> 00:16:10,750
كلّ ما يمكننا فعله الآن
.هو القتال حتّى الموت

297
00:16:18,330 --> 00:16:21,220
وفقًا للطّقوس، سوف تقاتلان
.باستخدام يدكما المهيمنة فقط

298
00:16:21,520 --> 00:16:24,870
سيّد يومي، أنت ماهر في استخدام اليدين
.معًا، صحيح؟ اختر واحدة فقط رجاءً

299
00:16:25,390 --> 00:16:26,130
.سأختار يمناي

300
00:16:30,590 --> 00:16:32,900
إذًا لن يُسمح إلاّ بيد السّيّد يومي
اليمنى ويد سول اليسرى

301
00:16:32,900 --> 00:16:34,680
.بحمل السّيف في هذا النّزال

302
00:16:35,430 --> 00:16:38,580
سيُحدّد الفوز في هذا النّزال إمّا
،باعتراف أحد المنازلين بالهزيمة

303
00:16:39,410 --> 00:16:42,060
.أو بخسارة حياة أحدهما

304
00:16:43,160 --> 00:16:44,530
!خسارة حياة أحدهما؟

305
00:16:44,530 --> 00:16:46,800
لا تدعيهما يضيّعان حياتهما
!هكذا يا أنا السّابقة

306
00:16:46,800 --> 00:16:47,700
".ضحكة"

307
00:16:47,110 --> 00:16:50,110
"من أجل البطلة فسأخاطر بحياتي"

308
00:16:47,700 --> 00:16:50,120
!من أجل البطلة، فسأخاطر بحياتي

309
00:16:50,430 --> 00:16:52,640
!أيّها المنازلين، المسا سيفيكما

310
00:16:54,570 --> 00:16:56,360
!ابدآ النّزال

311
00:17:06,540 --> 00:17:08,620
!سيُقتل يومي على يد سول

312
00:17:09,810 --> 00:17:10,370
.إيانا

313
00:17:09,920 --> 00:17:10,300
"إمساك"

314
00:17:11,200 --> 00:17:15,240
إلى أن نعرف الدّوافع الحقيقيّة خلف
.هذه المؤامرات، فلا يُسمح لك بالتّحرّك

315
00:17:16,170 --> 00:17:19,080
هل قال السّيّد غينوفورد "مؤامرات"؟

316
00:17:20,310 --> 00:17:24,280
في الإعداديّة، عندما كانت الأمور
،لا تسير كما يجب مهما حاولت

317
00:17:21,390 --> 00:17:26,060
"زيارة ضريح مع مجموعة في رحلة مدرسيّة"

318
00:17:24,280 --> 00:17:26,060
.كان ذلك يجعلني أرغب في امتلاك سحر

319
00:17:26,600 --> 00:17:29,680
في الحقيقة، كنتُ أعتقد
،أنّي كنتُ أملك سحرًا بالفعل

320
00:17:29,680 --> 00:17:33,560
لذلك كنتُ أقدّم طلبات غريبة كثيرة
.لأولئك الّذين يدعون أنفسهم بالآلهة

321
00:17:34,070 --> 00:17:35,530
هل ستتمنّين شيئًا ما؟

322
00:17:35,530 --> 00:17:36,570
!إنّه سرّ

323
00:17:39,000 --> 00:17:41,160
!آمل أن أحقّق علامة كاملة

324
00:17:41,690 --> 00:17:43,860
!آمل أن يحبّني الفتى الّذي أحبّه

325
00:17:44,910 --> 00:17:53,270
أيّتها الآلهة، امنحيني سحر النّار
!والماء والرّياح والأرض والشّفاء

326
00:17:53,270 --> 00:17:55,880
.هذا ضروريّ جدًّا بالنّسبة لبطلة

327
00:17:55,880 --> 00:17:57,240
.حسب بحوث من إنجاز ساتو

328
00:17:57,480 --> 00:18:00,630
سأحاول أن أضع كمّيّة غير
...طبيعيّة من القوّة في يدي

329
00:18:00,920 --> 00:18:01,290
!نار

330
00:18:05,360 --> 00:18:08,320
.بدأت حرارة يدي ترتفع.. على ما أظنّ

331
00:18:08,840 --> 00:18:12,260
جرّبتُ تمائم وزينة هواتف تُظهر
،المشاعر الصّحيحة

332
00:18:09,350 --> 00:18:14,780
"كلّ ذلك من أجل طاقتي السّحريّة"

333
00:18:12,260 --> 00:18:14,380
.لكن بلا فائدة. من ناحية السّحر بالطّبع

334
00:18:19,080 --> 00:18:22,410
،أعلم أنّي لا أستطيع استعمال السّحر

335
00:18:23,440 --> 00:18:25,780
،لكن بما أنّي عالقة هنا
.سيُقطَّع يومي إلى أشلاء صغيرة

336
00:18:26,410 --> 00:18:29,880
إنّ عجزي يثير فيّ نفس تلك المشاعر
.الّتي كانت لديّ آنذاك بداخلي

337
00:18:30,870 --> 00:18:32,760
...لو كنتُ أملك قوّةً خاصّة

338
00:18:35,510 --> 00:18:37,960
ماذا؟ لم ينتهِ النّزال بعد؟

339
00:18:38,520 --> 00:18:42,680
،أشعر بالأسف تجاه يومي لقولي هذا
.لكن من حيث المهارة، سول أفضل بكثير

340
00:18:42,890 --> 00:18:44,830
هل يُعقل أنّه يكبح نفسه؟

341
00:18:44,830 --> 00:18:46,260
.لا، هذا مستحيل

342
00:18:46,260 --> 00:18:49,050
،طالما أنّ لكونوها علاقة بالأمر
.يجب أن يُقاتل سول بجدّيّة

343
00:18:46,810 --> 00:18:50,020
،طالما أنّ لكونوها علاقة بالأمر"
"يجب أن يُقاتل سول بجدّيّة

344
00:18:50,150 --> 00:18:52,280
.يواجه سول وقتًا عصيبًا

345
00:18:52,280 --> 00:18:53,110
ماذا؟

346
00:18:58,180 --> 00:19:01,640
بعد ذكره لذلك، فإنّ حركات
.سول غريبة بالفعل

347
00:19:13,630 --> 00:19:22,550
"وقع من السّطح من قبل"
"يده المهيمنة"

348
00:19:23,350 --> 00:19:25,870
!مهلاً! أيعقل أنّ ذلك هو السّبب؟

349
00:19:27,320 --> 00:19:30,530
أيُعقل أنّه إن استمرّت الأمور
هكذا، فسيخسر سول؟

350
00:19:30,530 --> 00:19:31,660
إيانا؟

351
00:19:32,140 --> 00:19:33,100
ما الأمر يا إيانا؟

352
00:19:34,070 --> 00:19:36,400
.من الجيّد أنّ يومي لن يُقتل

353
00:19:36,400 --> 00:19:42,660
"سول"

354
00:19:36,740 --> 00:19:38,440
.لكنّ ذلك يعني أنّ سول سيموت

355
00:19:39,530 --> 00:19:40,350
إيانا؟

356
00:19:40,610 --> 00:19:41,260
.إيانا

357
00:19:42,660 --> 00:19:47,330
"موت"

358
00:19:42,660 --> 00:19:47,330
"مرحى"

359
00:19:42,900 --> 00:19:46,820
،صحيح أنّه إن مات سول
...فستختفي رايات الموت، ولكن

360
00:19:48,190 --> 00:19:49,960
.لا، لن تختفي

361
00:19:51,670 --> 00:19:55,280
،في الوقت الحاليّ
.أنا الشّرّيرة إيانا ماغنوليا

362
00:19:55,280 --> 00:19:56,670
.إيانا. أخبرتك ألاّ تتحرّكي

363
00:19:56,920 --> 00:19:57,420
"صفحة"

364
00:19:58,340 --> 00:19:59,600
!سيّد غينوفورد

365
00:20:01,420 --> 00:20:03,930
!إنّ رايات الموت تحبّني كثيرًا فحسب

366
00:20:06,630 --> 00:20:07,390
!إيانا

367
00:20:09,390 --> 00:20:15,400
"إسراع"

368
00:20:09,600 --> 00:20:14,020
،بغضّ النّظر عمّن يموت
!سأصبح مشتبهًا بها

369
00:20:15,400 --> 00:20:16,440
...في تلك الحالة

370
00:20:18,350 --> 00:20:19,880
!لن أفكّر في الأمر بعد الآن

371
00:20:20,840 --> 00:20:22,000
!مهلاً لحظة

372
00:20:27,090 --> 00:20:27,570
.تبًّا

373
00:20:29,920 --> 00:20:33,420
،كان القفز بينهما لإيقافهما جيّدًا
لكن ماذا أفعل بعدها؟

374
00:20:34,450 --> 00:20:38,060
ابتعدي يا إيانا. لن أسامح
.أيّ أحد يحاول أذيّتك

375
00:20:39,810 --> 00:20:43,190
.لا أريد التّواجد هنا أيضًا

376
00:20:43,190 --> 00:20:46,130
!أسرعا وأوقفا هذا النّزال

377
00:20:46,140 --> 00:20:47,560
!أوقفا هذا النّزال

378
00:20:46,180 --> 00:20:46,680
"(أوقفا)"

379
00:20:46,680 --> 00:20:47,180
"(هذا)"

380
00:20:47,180 --> 00:20:47,550
"(النّزال)"

381
00:20:50,200 --> 00:20:50,920
!إيانا

382
00:20:51,880 --> 00:20:53,550
هل يتلاعبون بك؟

383
00:20:53,920 --> 00:20:55,530
!بالطّبع ستكون هذه ردّة فعلك

384
00:20:53,940 --> 00:20:56,190
"لااااا"

385
00:20:58,120 --> 00:21:02,190
.ابتعدي رجاءً يا سيّدتي إيانا
.سبق وقبلتُ بهذا النّزال

386
00:21:02,840 --> 00:21:05,520
!إنّ اعتراضه فيه قلّة احترام للآلهة

387
00:21:05,740 --> 00:21:06,630
!ما مدى تفانيك لها يا ترى؟

388
00:21:07,350 --> 00:21:09,280
!وإن كان، هذا خطير جدًّا

389
00:21:09,520 --> 00:21:11,800
.تعرّضت السّيّدة كونوها للخطر

390
00:21:12,170 --> 00:21:14,790
!ما فعله السّيّد يومي لا يُغتفر

391
00:21:14,790 --> 00:21:18,540
"طحن، طحن"

392
00:21:14,930 --> 00:21:18,540
...كلاّ! إن كنتُ كونوها

393
00:21:18,540 --> 00:21:25,050
"توقّفا... كلاكما"

394
00:21:18,730 --> 00:21:21,290
!توقّفا كلاكما

395
00:21:25,270 --> 00:21:26,140
...لسبب ما

396
00:21:26,370 --> 00:21:28,340
.تلاشى كلّ سخطي

397
00:21:31,050 --> 00:21:32,240
!توقّفا

398
00:21:31,380 --> 00:21:34,970
!أحبّ القصّة الّتي للدّموع فيها قوى أعجوبيّة

399
00:21:36,060 --> 00:21:42,820
"طحن، طحن"

400
00:21:36,250 --> 00:21:39,600
!لاستطعتُ إيقاف هذا بدمعة واحدة...

401
00:21:40,480 --> 00:21:42,810
...بما أنّ الأمر آل لهذا

402
00:21:42,810 --> 00:21:46,480
يدك مصابة، أليس كذلك يا سول؟

403
00:21:47,640 --> 00:21:50,430
...القتال في نزال وأنت في حالتك هذه

404
00:21:48,570 --> 00:21:52,330
"...اهدئي. اهدئي"

405
00:21:50,430 --> 00:21:52,330
!هو الإهانة الحقيقيّة للآلهة

406
00:22:02,790 --> 00:22:04,090
!أنا هي خصمك الآن

407
00:22:06,930 --> 00:22:07,520
!يا يومي

408
00:23:39,890 --> 00:23:54,910
الحلقة القادمة: تُقاس درجة حرارة الشّخص المريض من الجبهة إلى الجبهة

409
00:23:40,560 --> 00:23:42,180
!أوقفا هذا النّزال

410
00:23:42,180 --> 00:23:44,910
!يُحرّم القانون النّزالات

411
00:23:45,300 --> 00:23:49,120
!لكنّ هذا العالم من بنائي أنا
!ماذا أفعل؟

412
00:23:49,130 --> 00:23:49,840
ماذا؟

413
00:23:49,840 --> 00:23:51,010
ما الخطب يا إيانا؟

414
00:23:51,010 --> 00:23:52,450
هل أصبتِ بالحمّى يا سيّدتي إيانا؟

415
00:23:52,450 --> 00:23:54,270
!جزء آخر محرج من بناء العالم