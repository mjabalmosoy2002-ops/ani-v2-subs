1
00:00:02,720 --> 00:00:05,430
.هذه نافذة غرفة نوم إيانا ماغنوليا

2
00:00:05,760 --> 00:00:09,730
...ومنها تتدلّى ملاءة وملاءة ومنامة وستارة

3
00:00:10,730 --> 00:00:16,240
وستارة أخرى وملاءة وقماش عليه صورة
...أماريليس بالحجم الطّبيعيّ، وفي النّهاية

4
00:00:16,240 --> 00:00:17,540
.توجد إيانا ماغنوليا

5
00:00:22,750 --> 00:00:24,460
!ظننتُ أنّي سأموت

6
00:00:24,460 --> 00:00:26,000
"خفقان"
!كان الارتفاع عاليًا جدًّا –

7
00:00:26,000 --> 00:00:28,540
!سأجد مينوا والبقيّة

8
00:00:28,540 --> 00:00:31,120
إنّ عزيمتي السّابقة تبدو
.مثل راية موت الآن

9
00:00:31,360 --> 00:00:37,280
لكنّي لا أستطيع السّماح لشانو
!باعتقالي، لذلك فهذا خياري الوحيد

10
00:00:38,950 --> 00:00:39,840
أيّها المفتّش شانو؟

11
00:00:40,680 --> 00:00:42,000
.ثمّة أمر عليّ القيام به

12
00:00:43,110 --> 00:00:47,810
في القصّة، تقتل روزا الدّمويّة
.ضحاياها في القبو

13
00:00:48,890 --> 00:00:51,660
.هذا يعني أنّ عليّ إيجاد القبو

14
00:00:51,660 --> 00:00:55,060
!لكنّ منازل النّبلاء في قصّتي ضخمة للغاية

15
00:00:56,040 --> 00:00:58,180
.كلاّ، سأبحث في كلّ مكان فحسب

16
00:00:58,440 --> 00:01:03,370
ولأنّي غيّرتُ القصّة، أجهل كم
.سيساعد ذلك في المستقبل

17
00:01:03,900 --> 00:01:06,000
،قد تنقد التّغييرات بعض الأشخاص

18
00:01:06,000 --> 00:01:08,500
لكنّ تلك التّغييرات قد تعني
.أيضًا التّضحية بآخرين

19
00:01:08,920 --> 00:01:10,060
...ذلك ليس أمرًا عليّ أن

20
00:01:10,060 --> 00:01:11,170
!عفوًا، أعتذر على التّطفّل

21
00:01:11,670 --> 00:01:14,120
!تفضّلي لو سمحت

22
00:01:15,480 --> 00:01:17,350
.أنا الهيكل العظميّ ماغنوليا

23
00:01:17,700 --> 00:01:19,770
.إنّ من يناديني بذلك في غاية الجمال

24
00:01:21,430 --> 00:01:23,350
!عرفتُ أنّك تحاولين الهرب

25
00:01:23,350 --> 00:01:25,460
كـ-كـ-كيف عرفت؟

26
00:01:25,460 --> 00:01:27,610
كم سنة وأنا أطاردك في رأيك؟

27
00:01:27,610 --> 00:01:29,120
أتتربّص بي خلسة؟

28
00:01:29,120 --> 00:01:31,000
!أأنت غبيّة؟ أنت المجرمة هنا

29
00:01:31,440 --> 00:01:32,610
!كفّ عن ملاحقتي

30
00:01:32,610 --> 00:01:34,500
!كفّي عن الهرب

31
00:01:38,070 --> 00:01:39,070
"اندفاع"
"وقوع"

32
00:01:39,320 --> 00:01:41,500
!عليّ الآن أن أضيّع شانو فحسب

33
00:01:42,760 --> 00:01:44,360
"يا إلهي"
!إنّها نهاية مسدودة –

34
00:01:45,040 --> 00:01:48,400
...ماغنوليا

35
00:01:48,720 --> 00:01:52,330
!أي، إي، يو، إ، أو

36
00:01:52,530 --> 00:01:55,330
استسلمي فحسب. ما الّذي تحاولين فعله؟

37
00:01:56,130 --> 00:01:57,960
.أريد فضح أعمال الدّوقة الشّرّيرة

38
00:02:00,000 --> 00:02:02,760
الدّوقة أماريليس هي من
!تختطف الفتيات الجميلات

39
00:02:02,760 --> 00:02:05,560
.ثمّة قبو في مكان ما هنا
!واثقة أنّهنّ محتجزات فيه

40
00:02:07,240 --> 00:02:08,040
وما دليلك؟

41
00:02:08,350 --> 00:02:11,810
...ذلك... إنّ... لقد

42
00:02:13,050 --> 00:02:16,080
لا يوجد دليل إذًا. ذلك واضح
.من طريقة هربك منّي

43
00:02:16,560 --> 00:02:20,130
الدّوقة أماريليس حزينة للغاية
.بشأن عمليّات الاختطاف

44
00:02:20,580 --> 00:02:24,240
حتّى أنّها بكت عند
.اختطاف أختي الصّغيرة

45
00:02:24,870 --> 00:02:27,840
إلى أيّ مدى يجب عليك أن تستهتري
!بالآخرين حتّى تشعري بالرّضا؟

46
00:02:28,190 --> 00:02:31,340
لذلك سأحرص على جرّ امرأة
.مثلك إلى حبل المشنقة بنفسي

47
00:02:32,040 --> 00:02:33,040
،بصراحة

48
00:02:33,360 --> 00:02:37,640
أنا لست متأكّدة بنسبة كاملة من
.أنّ الدّوقة أماريليس هي روزا الدّمويّة

49
00:02:38,120 --> 00:02:40,380
...قد أقترف خطأ ما

50
00:02:40,720 --> 00:02:44,080
!لكن عليّ إنقاذ الجميع

51
00:02:44,600 --> 00:02:47,160
،ربّما تكون مينوا والبقيّة بخير حتّى الآن

52
00:02:47,160 --> 00:02:50,280
لكنّي لا أعرف متى قد تتغيّر
!الأمور ويُقتلن

53
00:02:51,320 --> 00:02:52,400
.هذه أوهام

54
00:02:52,400 --> 00:02:53,130
!شانو

55
00:02:54,600 --> 00:02:58,300
إن كنتُ مخطئة، فسأتحمّل مسؤوليّة الجرائم

56
00:02:58,300 --> 00:03:01,320
وسأصعد الدّرج إلى مشنقتي
!أو مهما كان بنفسي

57
00:03:02,260 --> 00:03:03,140
...لذلك

58
00:03:04,270 --> 00:03:06,830
!عليك أن تساعدني يا شانو كليماتيس

59
00:03:09,400 --> 00:03:13,300
هذا تاريخي المظلم. إن كان
...بمقدوري إعادة كتابة أيّ شيء

60
00:03:18,130 --> 00:03:19,960
.فحينها سأخاطر بحياتي للقيام بذلك

61
00:03:25,830 --> 00:03:31,120
"التّاريخ المظلم للشّرّيرة المتجسّدة"

62
00:04:54,690 --> 00:04:58,520
"راية الموت 8: أصليّة هي مجموعة حروف سحريّة"

63
00:04:58,680 --> 00:05:01,620
!ستساعدني يا شانو كليماتيس

64
00:05:04,700 --> 00:05:07,230
من غير المرجّح أن تهدأ
.هذه العاصفة حتّى الغد

65
00:05:09,310 --> 00:05:10,740
،وبينما نحن عالقون هنا

66
00:05:11,140 --> 00:05:14,600
.يمكن القيام بما يحلو لك لإثبات صحّة أوهامك

67
00:05:15,540 --> 00:05:19,440
لكن إن لم تستطيعي إثبات أيّ
...شيء قبل نهاية العاصفة

68
00:05:20,360 --> 00:05:21,990
.سأعتقلك

69
00:05:26,610 --> 00:05:27,410
أهذا مفهوم؟

70
00:05:29,450 --> 00:05:32,300
،إن لم أعقد عزيمتي
.فلن أستطيع إنقاذ أيّ أحد

71
00:05:34,660 --> 00:05:37,450
حسب قصّتك، يجب أن يكون
هنالك قبو، صحيح؟

72
00:05:39,280 --> 00:05:39,970
.لنذهب

73
00:05:41,370 --> 00:05:42,040
.حسنًا

74
00:05:48,040 --> 00:05:49,720
الآنسة إيانا غير موجودة؟

75
00:05:50,390 --> 00:05:52,430
.لاحظ خادمنا ذلك قبل قليل فقط

76
00:05:53,160 --> 00:05:55,290
.آمل أنّ إيانا لم تتورّط في شيء ما أيضًا

77
00:05:56,120 --> 00:05:57,050
تتورّط في ماذا؟

78
00:05:57,050 --> 00:05:59,780
قلتَ أنّ هنالك دليلاً على
أنّها هربت من النّافذة، صحيح؟

79
00:06:00,250 --> 00:06:02,610
.لا يسعني إلاّ أن أظنّ أنّها غادرت بإرادتها

80
00:06:06,120 --> 00:06:11,260
،عندما استجوبتُ الآنسة إيانا
.بدت وكأنّها تخفي أمرًا ما

81
00:06:12,070 --> 00:06:17,000
أمّا بالنّسبة للأدلّة الّتي تبدو أنّها
،تربطها باختفاء الفتيات الجميلات

82
00:06:17,610 --> 00:06:20,730
.فعلى الأرجح أنّها هربت لإخفاء تورّطها

83
00:06:21,510 --> 00:06:23,440
هل تعرف أيّ شيء؟

84
00:06:24,550 --> 00:06:25,560
.سيّد غينوفورد

85
00:06:25,760 --> 00:06:30,360
.أرجوك، لا تخبر أحدًا أنّ القرط كان معي

86
00:06:34,670 --> 00:06:35,670
.لا

87
00:06:41,540 --> 00:06:42,540
...حسنًا

88
00:06:43,110 --> 00:06:45,690
.إنّنا نبحث منذ ساعة الآن

89
00:06:46,050 --> 00:06:49,550
عليك تضييق نطاق البحث على
!الأقلّ! هل نحن لصوص أم ماذا؟

90
00:06:49,550 --> 00:06:51,610
!آسفة بشأن ذ— مهلاً

91
00:06:51,610 --> 00:06:55,430
ألم تأتِ إلى هنا كرجل أمن؟! كان يجب
!أن تحفظ مخطّط المكان عن ظهر قلب

92
00:06:55,430 --> 00:06:59,070
!وذلك ما فعلت! ولا يوجد فيها أيّ قبو

93
00:06:59,230 --> 00:07:00,480
"غررر"

94
00:07:00,560 --> 00:07:04,480
ليكون في علمك، أنا لا أتعاون معك
.فقط لكي أقبض عليك في النّهاية

95
00:07:04,940 --> 00:07:07,920
وذلك أيضًا لإثبات أنّ الدّوقة
.ليست من النّوع الّذي وصفتِها به

96
00:07:08,320 --> 00:07:10,630
.إنّها لطيفة جدًّا

97
00:07:11,470 --> 00:07:13,320
...في لحظة كهذه، لو كنتُ كونوها

98
00:07:13,610 --> 00:07:14,690
،لو كنتُ البطلة

99
00:07:15,080 --> 00:07:20,020
ربّما يمكنها استخدام قواها المقدّسة للعثور على
.القبو الّذي لا يستطيع النّاس العاديّون إيجاده

100
00:07:20,560 --> 00:07:21,520
!وجدتُها

101
00:07:22,090 --> 00:07:27,120
إيانا، قالت الدّوقة أنّها تريد التّحدّث
،معي على انفراد ودعتني لتناول الشّاي

102
00:07:27,120 --> 00:07:30,000
لكنّني سأكون متوتّرة جدًّا
وحدي. هل ستأتين معي؟

103
00:07:30,260 --> 00:07:31,760
"منع"
"أنا أفكّر الآن"

104
00:07:32,120 --> 00:07:36,010
بما أنّ كونوها بخير، ظننت
...أنّ الأمر لا علاقة له بها، لكن

105
00:07:38,160 --> 00:07:39,120
...أخبرني يا شانو

106
00:07:39,440 --> 00:07:40,060
ماذا؟

107
00:07:40,560 --> 00:07:43,340
إذا كان الخاطف وحده مع
،الشّخص الّذي يريد اختطافه

108
00:07:43,340 --> 00:07:45,700
،لكنّه لم يستطع ذلك
فما هو السّبب في رأيك؟

109
00:07:46,220 --> 00:07:48,000
لماذا قد تسأليني عن ذلك؟

110
00:07:48,680 --> 00:07:51,330
قد تكون هنالك مشكلة مع
...الهدف بحدّ ذاته، أو

111
00:07:51,640 --> 00:07:53,280
.ربّما لم يكن هنالك فرصة سانحة

112
00:07:53,700 --> 00:07:55,280
.من الممكن أنّ الوضع قد تغيّر

113
00:07:56,020 --> 00:08:01,290
إذا كانا يتوقّعان أن يكونا وحدهما، لكنّ
.شخصًا ثالثًا تدخّل، فلن يتمكّن من التّصرّف

114
00:08:04,250 --> 00:08:06,600
.أنا مسرور لأنّي رافقها

115
00:08:06,600 --> 00:08:07,410
!سول

116
00:08:08,700 --> 00:08:09,450
!إمساك

117
00:08:09,560 --> 00:08:10,530
ماذا هنالك؟

118
00:08:10,530 --> 00:08:14,210
شانو، شكرًا لك! أعتقد أنّي بدأت
!أرى الصّورة بشكل كامل بفضلك

119
00:08:14,800 --> 00:08:15,800
!هيّا بنا

120
00:08:16,080 --> 00:08:18,600
سنذهب إلى الغرفة الّتي دعت
—الدّوقةُ كونوها إليها

121
00:08:18,600 --> 00:08:20,590
الشّرفة الزّجاجيّة الّتي في الجهة
!الغربيّة الوسطى من الطّابق الأوّل

122
00:08:28,420 --> 00:08:29,510
.لا يوجد أيّ شيء هنا

123
00:08:30,160 --> 00:08:33,480
يبدو أنّ هذه الشّرفة الزّجاجيّة مخصّصة
.في العادة لتستخدمها الدّوقة وحدها

124
00:08:33,790 --> 00:08:37,420
لقد تمّ فتحها بشكل مؤقّت من
.أجل البحث عن السّيّدة كاميليا

125
00:08:38,080 --> 00:08:40,370
يجدر بالقائد وميكا أن يكونا
.قد بحثا فيها بدقّة

126
00:08:40,860 --> 00:08:42,050
.لكنّي واثقة أنّ هذا هو المكان

127
00:08:45,600 --> 00:08:47,490
"حفيف"
!ربّما يكون في مكان لا نراه –

128
00:08:47,490 --> 00:08:48,800
!بين هذه الشّجيرات مثلاً

129
00:08:48,800 --> 00:08:52,000
!أو ربّما هنالك مفتاح سرّيّ خفيّ
!أو رافعة غريبة

130
00:08:52,000 --> 00:08:53,120
...حفيف، حفيف، حفيف

131
00:08:53,120 --> 00:08:55,550
!هذا لا يختلف أبدًا عمّا فعلتِه في الأسفل

132
00:08:55,790 --> 00:08:57,200
.تمّ البحث هنا سلفًا

133
00:08:57,730 --> 00:09:00,940
من غير المرجّح أن يكون شيئًا
.يفكّر فيه الشّخص عادة

134
00:09:00,940 --> 00:09:03,010
...لا بأس بقول ذلك، ولكن

135
00:09:04,680 --> 00:09:06,110
!لا تنظر إليّ

136
00:09:06,310 --> 00:09:07,440
"طقطقة"

137
00:09:08,590 --> 00:09:10,020
طقطقة؟

138
00:09:10,020 --> 00:09:10,960
لقد تحرّك؟

139
00:09:11,500 --> 00:09:12,320
!الماء

140
00:09:17,450 --> 00:09:21,450
"هدير"

141
00:09:32,800 --> 00:09:33,800
...هذا

142
00:09:34,600 --> 00:09:35,660
!شانو؟

143
00:09:44,990 --> 00:09:45,990
كونوها؟

144
00:09:47,180 --> 00:09:49,480
هل استيقظت يا سيّدتي كونوها؟

145
00:09:51,830 --> 00:09:53,980
.سول. سيّد غينوفورد

146
00:09:58,160 --> 00:09:58,880
سيّدتي كونوها؟

147
00:09:59,330 --> 00:10:00,990
هل تتألّمين يا كونوها؟

148
00:10:02,430 --> 00:10:04,650
.أنا خائفة. أشعر بالظّلمة

149
00:10:05,430 --> 00:10:08,240
.إنّ ظُلمة عميقة لشخص ما تغلّف القصر

150
00:10:08,500 --> 00:10:10,160
.إنّها تحاول فرض سيطرتها

151
00:10:10,590 --> 00:10:12,030
!أجل

152
00:10:13,980 --> 00:10:16,690
.الظُّلمة عميقة جدًّا لدرجةٍ تُحزنني

153
00:10:24,480 --> 00:10:27,330
.مرحبًا بكما في نعيمي

154
00:10:27,860 --> 00:10:31,390
ما رأيكما؟ أليست هذه الفتيات ظريفات؟

155
00:10:33,840 --> 00:10:36,600
الجمال رائع، أليس كذلك؟

156
00:10:36,600 --> 00:10:38,260
أتريدان الاستمتاع بوقتكما معهنّ أيضًا؟

157
00:10:38,840 --> 00:10:42,530
!آسفة، لكن لا يحقّ لكما ذلك على الإطلاق

158
00:10:43,260 --> 00:10:44,000
الدّوقة؟

159
00:10:44,200 --> 00:10:45,740
هذا ليس حقيقيًّا، صحيح؟

160
00:10:46,790 --> 00:10:50,340
الدّوقة أماريليس حزينة للغاية
.بشأن عمليّات الاختطاف

161
00:10:50,820 --> 00:10:54,530
حتّى أنّها بكت عند
.اختطاف أختي الصّغيرة

162
00:10:56,760 --> 00:11:00,670
رجل غبيّ. هل صدّقتني بالفعل؟

163
00:11:01,300 --> 00:11:03,010
.ضحكة

164
00:11:04,020 --> 00:11:07,560
.ألم تحزر بعد؟ أختك الصّغيرة العزيزة هنا

165
00:11:07,700 --> 00:11:08,370
...ما

166
00:11:08,920 --> 00:11:13,670
...أغرقتها بحبّي في غرفتي المفضّلة

167
00:11:15,730 --> 00:11:19,320
طوال ستّة أشهر بينما
.كنتَ تبحث عنها بكلّ يأس

168
00:11:19,840 --> 00:11:21,380
!أخي الكبير

169
00:11:21,380 --> 00:11:23,570
إيانا؟ هل أمسكت بك أيضًا؟

170
00:11:23,720 --> 00:11:24,690
!تبًّا

171
00:11:24,690 --> 00:11:26,080
!مينوا هنا أيضًا

172
00:11:26,480 --> 00:11:27,570
...أيّتها الـ

173
00:11:29,660 --> 00:11:30,440
!سُحقًا

174
00:11:32,510 --> 00:11:35,200
.يا إلهي، كم أنت غير متحضّر

175
00:11:35,560 --> 00:11:38,120
.لكن لحسن حظّك أنّي أحبّ وجهك الوسيم هذا

176
00:11:38,120 --> 00:11:42,340
أعتقد أنّ الوجوه الباكية
.تناسبكما أيّها الشّقيقان كثيرًا

177
00:11:42,500 --> 00:11:43,740
!شانو

178
00:11:44,860 --> 00:11:47,550
إذا أخذتُك أنت أيّها الجميل
الّذي أتى لإنقاذها

179
00:11:47,550 --> 00:11:50,610
وخلعتُ ملابسك هنا أمام
،الجميع ودنّستك بالكامل

180
00:11:50,610 --> 00:11:54,240
أتساءل، هل ستُظهران لي
تلك الّتعابير الظّريفة؟

181
00:11:55,440 --> 00:11:58,490
!يا أخي! لا

182
00:12:00,350 --> 00:12:03,260
!هذه جريمة –
...قبلة، قبلة –

183
00:12:03,460 --> 00:12:04,200
...سُحقًا

184
00:12:04,590 --> 00:12:07,360
.الآن، اخلع ملابسك حتّى تصير كما ولدت

185
00:12:07,560 --> 00:12:09,760
!يجب أن أنقذه! لكن كيف؟ –
!هلع –

186
00:12:10,620 --> 00:12:12,120
"فكرة"

187
00:12:15,330 --> 00:12:18,160
هل ستتمكّنين حقًّا من خلع ملابسه؟

188
00:12:22,260 --> 00:12:24,140
!ما الّذي أقوله؟

189
00:12:24,920 --> 00:12:25,640
!ماذا؟

190
00:12:25,640 --> 00:12:28,420
هل تقصدين أنّ هناك لعنة موت
على ملابسه أو شيء من هذا؟

191
00:12:29,360 --> 00:12:29,960
.هذا صحيح

192
00:12:30,700 --> 00:12:33,840
من الممكن ألاّ تتمكّن الدّوقة
.من خلع تلك الملابس

193
00:12:34,140 --> 00:12:36,310
مشكلة الملابس الخياليّة"
"!الأصليّة غير المفهومة

194
00:12:36,440 --> 00:12:39,150
مشكلة الملابس الخياليّة
!الأصليّة غير المفهومة

195
00:12:39,560 --> 00:12:43,450
كلمة "أصليّة" بالنّسبة لحياتي السّابقة
،حيث كانت هوايتي هي التّخيّل

196
00:12:43,450 --> 00:12:46,270
كانت مجموعة حروف سحريّة
أستمتع بها كثيرًا

197
00:12:46,270 --> 00:12:47,760
.وتجعلني أنتشي بشعور ابتكار شيء جديد

198
00:12:48,390 --> 00:12:50,770
ماذا؟ ساتو-سان، أريد أن أرى
!شخصيّتك الأصليّة

199
00:12:50,770 --> 00:12:52,880
!ماذا؟ أكنت ترسمين؟ أرينا

200
00:12:52,880 --> 00:12:56,600
.فعلاً؟ لكنّها تبدو غريبة قليلاً
.انظرا

201
00:12:56,600 --> 00:12:59,550
كنتُ أقول ذلك، لكنّه كان
.مجرّد تواضع مزيّف

202
00:12:59,550 --> 00:13:02,160
إنّها رائعة! لكن كيف يعمل هذا الحزام؟

203
00:13:02,160 --> 00:13:03,160
ماذا؟

204
00:13:03,480 --> 00:13:04,590
كيف يلبسه؟

205
00:13:04,950 --> 00:13:05,950
"لا نيّة سيّئة"
ماذا؟ –

206
00:13:09,560 --> 00:13:10,320
.بالسّحر

207
00:13:10,940 --> 00:13:13,410
"كان هذه بداية استعمال عبارة بالسّحر"
...بشكل أساسيّ، إذا كان الزّيّ يبدو جيّدًا –

208
00:13:13,410 --> 00:13:16,040
.فإنّ كيفية عمله لا تهمّ على الإطلاق

209
00:13:16,600 --> 00:13:18,970
"لا ملابس" "تغيير ملابس"
...أريد أن أركع وأعتذر لشخصيّاتي –

210
00:13:18,970 --> 00:13:21,070
"ارتداء ملابس"
.لأنّي جعلتُ ملابسهم صعبة الارتداء أو الخلع

211
00:13:21,070 --> 00:13:24,320
بالنّسبة لشخصيّات مثل شانو
،والآخرين بلا خلفيّة واضحة

212
00:13:24,320 --> 00:13:26,950
أنا متأكدّة أنّي صمّمت زيّ الشّرطة
...خاصّتهم هكذا

213
00:13:26,950 --> 00:13:29,200
!كلاّ... لا أستطيع خلعها! ما مشكلتها؟ –
!أي أنّ الشّخصيّة وحدها يُمكنها خلعها –

214
00:13:29,200 --> 00:13:31,950
!هذا محبط جدًّا –
!توقّفي –

215
00:13:32,160 --> 00:13:35,030
،سأموت بسبب تاريخي المظلم
!لذلك توقّفي فحسب

216
00:13:35,030 --> 00:13:37,170
!وكأنّ هذا قد فتح حفرة في صدري

217
00:13:37,170 --> 00:13:39,960
"فووو"

218
00:13:40,640 --> 00:13:42,320
.فهمت

219
00:13:42,320 --> 00:13:45,370
لم تبدئي بالتّفتيش قبل
.أن تضمني سلامة شريكك

220
00:13:45,370 --> 00:13:47,940
.أنت لست امرأة غبيّة

221
00:13:50,370 --> 00:13:52,640
...اسمعي يا آنسة إيانا

222
00:13:52,640 --> 00:13:55,950
لماذا لا نعمل معًا؟

223
00:14:04,110 --> 00:14:07,070
"التّاريخ المظلم للشّرّيرة المتجسّدة"

224
00:14:07,800 --> 00:14:09,040
.إنّك مشهورة جدًّا

225
00:14:09,490 --> 00:14:14,430
كنتِ غيورة جدًّا من تلك الآنسة كونوها
،الملائكيّة ومن الجميلات أخريات

226
00:14:14,430 --> 00:14:18,130
لدرجة أنّك كنتِ تتنقّلين من حفلة
إلى أخرى وتتنمّرين عليهنّ، أليس كذلك؟

227
00:14:18,130 --> 00:14:21,790
ماذا لو جمعنا قوانا وجلبنا مثل
هؤلاء الجميلات إلى هنا؟

228
00:14:21,790 --> 00:14:23,460
تكرهين النّساء الجميلات، أليس كذلك؟

229
00:14:26,720 --> 00:14:29,640
!إيّاك يا ماغنوليا
!لا تدعيها تقنعك بأيّ شيء

230
00:14:29,640 --> 00:14:31,730
ستنقذين الآنسة كاميليا، صحيح؟

231
00:14:31,730 --> 00:14:33,240
هل ستزيدين على جرائمك؟

232
00:14:33,240 --> 00:14:35,960
.يا لك من فتاة مطيعة
—بوجودي معك، سوف

233
00:14:35,960 --> 00:14:39,360
.آسفة، لكنّ ذوقي يختلف عن ذوقك

234
00:14:40,240 --> 00:14:44,180
.سبق وتخلّيت عن مثل تلك الأمور

235
00:14:44,180 --> 00:14:45,360
"ساتو الرّاشدة العاملة"
!لا أريد تذكّر ذلك –

236
00:14:45,360 --> 00:14:48,920
تخلّيت عن ذلك؟

237
00:14:49,280 --> 00:14:51,100
هل هذا ما قلته للتّوّ؟

238
00:14:52,080 --> 00:14:53,580
"أنا كونوها"
...أيّتها الدّوقة أماريليس –

239
00:14:53,580 --> 00:14:55,980
.إنّك تشبهين ما كنتُه في حياتي السّابقة

240
00:14:56,390 --> 00:15:00,360
أنا الّتي كنتُ توّاقة للجمال
...وحاولتُ التّخلّي عن نفسي

241
00:15:00,360 --> 00:15:02,750
"!أحبّ تعذيب الفتيات الجميلات"
...أنا الّتي رفضت الاعتراف بالقبح –

242
00:15:02,750 --> 00:15:04,510
...داخلها وانحرفت...

243
00:15:07,760 --> 00:15:08,400
!سُحقًا

244
00:15:09,310 --> 00:15:10,880
.يكفي

245
00:15:11,090 --> 00:15:13,310
،إذا لم يكن لديكِ نيّة للانضمام إليّ

246
00:15:13,540 --> 00:15:16,630
.فستموتين لتغذّي جمالي

247
00:15:20,280 --> 00:15:23,600
!تغذّي جمالك؟ مهلاً
ماذا ستفعلين بها؟

248
00:15:27,100 --> 00:15:28,880
...سأشقّ جسدها

249
00:15:30,370 --> 00:15:32,910
.وأشرب الدّم الموجود بداخله

250
00:15:34,720 --> 00:15:38,120
...يُقال أنّ أشخاصًا في بلاد في الشّرق

251
00:15:38,440 --> 00:15:42,120
يشربون دماء الشّابّات الأحياء
.للحفاظ على جمالهم

252
00:15:42,350 --> 00:15:43,280
.هذا سيّئ

253
00:15:43,280 --> 00:15:48,850
أريد أن أبقى جميلة بينما أشارك
.حبّي مع النّساء الجميلات

254
00:15:48,850 --> 00:15:50,630
.سأُقتل على هذه الوتيرة

255
00:15:51,430 --> 00:15:54,640
!تمالكي نفسك يا ماغنوليا
!لا تفقدي وعيك

256
00:15:54,910 --> 00:15:55,550
!سُحقًا

257
00:15:56,270 --> 00:15:58,990
.تُختطف كونوها على يد الدّوقة أماريليس

258
00:16:01,230 --> 00:16:05,060
لكنّ رفاقها يحمونها ويجبرون
.الدّوقة على الاستسلام

259
00:16:05,720 --> 00:16:08,990
كانت كونوها قد سمعت عن ماضي
،هذه السّيّدة من ملك روز

260
00:16:08,990 --> 00:16:11,400
.فشعرت بالحزن تجاه الدّوقة المعذّبة

261
00:16:12,080 --> 00:16:16,100
منذ زمن بعيد، فقدت الدّوقة
.أختها الصّغيرة الجميلة بسبب المرض

262
00:16:16,550 --> 00:16:21,160
أحّبت تلك الأخت الّتي كرهها المرض
.وعاملتها بالحنان والمحبّة

263
00:16:21,680 --> 00:16:22,760
...وفي يوم بارد

264
00:16:23,640 --> 00:16:26,000
...همست أختها على فراش الموت

265
00:16:26,700 --> 00:16:30,990
يا أختي الكبيرة، أرجو أن تبقي
.دائمًا جميلة كما أنت الآن

266
00:16:33,130 --> 00:16:36,930
.في تلك اللّحظة، بدأ قلب الدّوقة يختلّ

267
00:16:37,240 --> 00:16:40,920
.سيكون الجمال بحدّ ذاته ذكراي لك

268
00:16:40,920 --> 00:16:44,440
!ويجب أن أكون جميلة أيضًا

269
00:16:44,870 --> 00:16:48,250
،وكونوها، الّتي فقدت أختها الصّغيرة إيانا

270
00:16:48,250 --> 00:16:50,610
...نظرت إلى الدّوقة مباشرة وقالت لها

271
00:16:50,610 --> 00:16:53,650
...أيّتها الدّوقة، حتّى لو فعلت ذلك –
...حتّى لو فعلت ذلك –

272
00:16:54,450 --> 00:16:56,210
!فلن يُسعدها هذا

273
00:17:00,200 --> 00:17:05,280
.ما رأته هو القلب الّذي حماها واعتنى بها

274
00:17:06,180 --> 00:17:10,360
!قلبك الطّيب! ذلك كان الجمال بالنّسبة لها

275
00:17:16,840 --> 00:17:20,470
كيف... تعرفين ما قالته؟

276
00:17:20,470 --> 00:17:24,220
أجل! إنّ الجُمل من القصّة تؤدّي
!مفعولها بشكل أفضل

277
00:17:24,220 --> 00:17:26,400
شكرًا أيّتها الأخت الصّغيرة
!الّتي بالكاد أذكرها

278
00:17:26,400 --> 00:17:28,720
!بالكاد نجح هذا الأمر

279
00:17:29,680 --> 00:17:32,760
،والآن، تمامًا كما في القصّة
،سيتطهّر قلب الدّوقة

280
00:17:32,760 --> 00:17:34,720
.وستستعيد طيبتها

281
00:17:35,930 --> 00:17:39,150
!كونوها، لامست تلك الكلمات قلبي

282
00:17:40,010 --> 00:17:42,490
...إيانا، تلك الكلمات

283
00:17:42,600 --> 00:17:46,340
!لا ينبغي لامرأة قبيحة مثلك أن تقولها أبدًا

284
00:17:48,840 --> 00:17:52,250
!لن تتقبّلها إلاّ إذا صدرت من كونوها؟

285
00:17:52,470 --> 00:17:55,490
!أيّتها الدّوقة أماريليس! أنت ترتكبين جريمة

286
00:17:55,490 --> 00:17:57,000
!لن تسمح الشّرطة بهذا

287
00:18:01,670 --> 00:18:07,230
أنت لا تفهم، أليس كذلك؟
!أنت حقًّا لا تفهم

288
00:18:08,210 --> 00:18:09,980
...أيّها المفتّش شانو

289
00:18:10,210 --> 00:18:12,140
.أنت من أخبرني

290
00:18:12,140 --> 00:18:16,790
الشّرّيرة إيانا ماغنوليا مشتبه بها
.في خطف الفتيات الجميلات

291
00:18:17,450 --> 00:18:23,020
.إذا متّم جميعًا هنا، فسيُنسَب كلّ شيء لإيانا

292
00:18:23,020 --> 00:18:25,740
.ولن يذكر أحد اسمي

293
00:18:34,670 --> 00:18:37,510
إن كنت تفهمين، فكوني فتاة
.مطيعة وقدّمي لي دمك

294
00:18:54,300 --> 00:18:55,160
!إيانا

295
00:18:55,730 --> 00:18:56,890
!أخي الكبير

296
00:18:58,960 --> 00:18:59,920
!شانو

297
00:19:00,140 --> 00:19:02,380
.اصمتي. ابقي هادئة لدقيقة فحسب

298
00:19:02,850 --> 00:19:04,000
.سُحقًا

299
00:19:04,270 --> 00:19:07,600
لم أعد قادرًا على استخدام يديّ
.لأنّي خلعتُهما من القيود بالقوّة

300
00:19:08,000 --> 00:19:09,020
ماذا يمكنني أن أفعل؟

301
00:19:16,950 --> 00:19:18,030
.يا ماغنوليا

302
00:19:19,480 --> 00:19:21,000
.سأجد طريقة لأُبعدها

303
00:19:21,360 --> 00:19:24,420
.اصعدي إلى السّطح واستدعي القائد أو ميكا

304
00:19:24,420 --> 00:19:26,140
وماذا ستفعل أنت؟

305
00:19:26,640 --> 00:19:30,210
.ما زالت أختي وبقيّة الضّحايا هنا

306
00:19:31,020 --> 00:19:34,920
وفي أسوأ الحالات، سأضمن
ألاّ تتوجّه رغباتها نحو الفتيات

307
00:19:35,260 --> 00:19:37,150
.بتقديم نفسي بدلاً عنهنّ
.هذا ما أعنيه

308
00:19:37,840 --> 00:19:41,060
أم ستشتكين بأنّك لا تستطيعين الذّهاب
إلى أيّ مكان وأنت تبدين هكذا؟

309
00:19:41,460 --> 00:19:42,460
ماذا؟

310
00:19:44,440 --> 00:19:46,610
...أشعر أنّني أكاد أخلع هذه الأشياء، لكن

311
00:19:46,610 --> 00:19:49,340
".لن أكون عائقًا. أريد أن أساعد"

312
00:19:49,610 --> 00:19:51,800
.تلك جُمَلٌ للبطلة المثاليّة

313
00:19:52,310 --> 00:19:54,560
.لا يجب أن أقولها، حتّى لو أردت ذلك

314
00:19:56,320 --> 00:20:00,670
،أكره أن أتركك أنت والبقيّة
.لكنّني سأكون عائقًا هكذا

315
00:20:00,860 --> 00:20:02,980
.سيكون إحضار المساعدة أكثر فائدة بكثير

316
00:20:03,240 --> 00:20:04,020
.أعطني الإشارة فحسب

317
00:20:04,410 --> 00:20:06,680
.أظهرتِ للتّوّ مقدارًا هائلاً من الجاذبيّة

318
00:20:07,310 --> 00:20:10,690
ما الّذي تتهامسان به؟

319
00:20:14,830 --> 00:20:15,440
!اذهبي

320
00:20:16,320 --> 00:20:19,000
!لا تهربي

321
00:20:20,360 --> 00:20:21,590
!عليّ أن أذهب بأقصى سرعة

322
00:20:27,690 --> 00:20:28,520
!شانو

323
00:20:29,880 --> 00:20:30,890
!إيانا

324
00:20:30,890 --> 00:20:31,670
.ضحكة

325
00:20:32,420 --> 00:20:33,780
!أخي الكبير

326
00:20:33,780 --> 00:20:34,840
.ضحكة، ضحكة

327
00:20:36,690 --> 00:20:37,670
!مينوا

328
00:20:37,670 --> 00:20:39,170
!وأخت شانو الصّغيرة أيضًا

329
00:20:40,440 --> 00:20:41,170
.ضحكة

330
00:20:41,810 --> 00:20:46,150
...لا أريد أن أرى امرأة جميلة تتأذّى

331
00:20:47,320 --> 00:20:51,700
،لكن عندما لا تتصرّف الفريسة كفريسة
.يصبح الأمر قبيحًا جدًّا. أنا أكره هذا

332
00:20:52,400 --> 00:20:56,680
.إن هربتِ، سيقتل عبيدي الفتاتين

333
00:20:57,600 --> 00:20:58,930
!اذهبي

334
00:20:59,750 --> 00:21:00,950
.يا للقبح

335
00:21:02,130 --> 00:21:06,960
في حياتي السّابقة، كان بإمكاني التّلويح
.بقلمي وإحياء الشّخصيّات الميتة

336
00:21:07,220 --> 00:21:09,950
.لكن الآن، أصبحت تلك القصّة واقعًا

337
00:21:12,190 --> 00:21:14,450
!من يموت هنا لن يعود إلى الحياة

338
00:21:14,970 --> 00:21:16,970
!شانو

339
00:21:21,580 --> 00:21:22,690
!إيانا

340
00:21:23,550 --> 00:21:25,500
أنت... ماذا حدث لقيودك؟

341
00:21:26,040 --> 00:21:29,080
اصطدمتُ بحافّة الدّرج عندما
.سقطت، فانفكّت

342
00:21:29,080 --> 00:21:30,240
ماذا؟

343
00:21:30,240 --> 00:21:31,480
.كانت مرتخية أصلاً

344
00:21:31,680 --> 00:21:35,510
إذًا لماذا عدتِ؟ أعرف أنّك قادرة
.على اتّخاذ قرارات سريعة

345
00:21:37,200 --> 00:21:39,440
.في حياتي السّابقة، ما كنتُ لأعود أبدًا

346
00:21:40,000 --> 00:21:42,200
.لأنّي أعرف أنّي كنتُ عاجزة حينها

347
00:21:46,200 --> 00:21:47,730
.يا إلهي

348
00:21:48,830 --> 00:21:50,410
.امرأة حمقاء

349
00:21:50,410 --> 00:21:54,960
.عدتِ رغم أنّك لا تستطيعين فعل أيّ شيء

350
00:21:55,640 --> 00:21:58,100
.قد لا أكون قادرة على فعل أيّ شيء حقًّا

351
00:21:58,320 --> 00:21:59,010
!مهلاً

352
00:21:59,580 --> 00:22:02,710
لكنّني الآن لستُ الفتاة
.الّتي كنتُها في حياتي السّابقة

353
00:22:03,310 --> 00:22:07,110
!أنا الشّرّيرة الاستثنائيّة إيانا ماغنوليا

354
00:23:40,580 --> 00:23:43,850
"الحلقة القادمة: تقييمات الذّات غير موثوقة"
.مهما ظهرت رايات الموت، سأخدعها وأتجاوزها –

355
00:23:44,200 --> 00:23:46,700
!ما زال لديّ ذلك الشّكل

356
00:23:46,700 --> 00:23:50,090
،إن أضفتُ ذلك الشّيء إلى الرُّكب
أتساءل إن كانوا سيخافون؟

357
00:23:50,090 --> 00:23:54,440
سيّدتي إيانا، هل تدركين
أنّك في وضع خطير جدًّا؟