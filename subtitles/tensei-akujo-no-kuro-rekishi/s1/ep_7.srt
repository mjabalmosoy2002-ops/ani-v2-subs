1
00:00:03,250 --> 00:00:07,130
"التّاريخ المظلم للشّرّيرة المتجسّدة"

2
00:01:30,460 --> 00:01:35,130
راية الموت 7: هذه الصّور الذّهنيّة"
"مُصنَّفة لجميع الأعمار

3
00:01:38,750 --> 00:01:41,960
.لا أعتقد أنّي سأجدها بسرعة وسط كلّ هذا

4
00:01:42,380 --> 00:01:44,960
التقيتُ فتاة في الحفلة الّتي
،أُقيمت في قصر الدّوق أماريليس

5
00:01:45,080 --> 00:01:47,330
.تُدعى مينوا، وقد أوقعت هذا

6
00:01:47,830 --> 00:01:51,420
وبصراحة، يبدو هذا قيّمًا جدًّا
.ولا أريد الاحتفاظ به طويلاً

7
00:01:51,580 --> 00:01:53,040
!ستقع كارثة إن أخذه أحد ما منّي

8
00:01:53,920 --> 00:01:56,460
ليته كانت هناك أنظمة نداء
.داخليّ في هذا العالم

9
00:01:56,750 --> 00:01:59,670
توقّفي. كيف تفسّرين ذلك الفستان؟

10
00:02:00,380 --> 00:02:04,250
،سبق وأخبرتك يا أختي
،سكبت النّبيذ على فستاني

11
00:02:04,670 --> 00:02:06,540
لذلك استعرتُ هذا الفستان
.من صديقة بعُجالة

12
00:02:06,790 --> 00:02:08,330
!مينوا! ها هي هناك

13
00:02:08,460 --> 00:02:09,580
!تكذبين

14
00:02:09,830 --> 00:02:13,460
وصلتِ للتّوّ. كيف يُعقل
أن يكون لديك أيّ أصدقاء؟

15
00:02:13,750 --> 00:02:15,460
توسّلتِ والدي ليقدّمه لك، صحيح؟

16
00:02:17,210 --> 00:02:19,960
لا يعاملني والدي بلطفٍ أكثر
.ممّا تقتضيه الضّرورة

17
00:02:20,380 --> 00:02:21,380
!يا إلهي

18
00:02:21,790 --> 00:02:27,250
لقد اكتفى بالحدّ الأدنى حين
.أخذني للعيش معه بعد وفاة أمّي

19
00:02:27,710 --> 00:02:30,790
ومع ذلك، أنا واثقة أنّه سيشتري
.لكِ أيّ عدد تريدين منها

20
00:02:31,420 --> 00:02:33,290
!سأخبر والدي بكلّ شيء إذًا

21
00:02:33,420 --> 00:02:36,250
سأقول له أنّك أهنْتِني
!أمام الجميع في الحفلة

22
00:02:37,290 --> 00:02:40,290
—أختي الجميع يراقب. اهدئي أرجو

23
00:02:40,420 --> 00:02:42,000
!اخرسي! اخرسي

24
00:02:42,130 --> 00:02:45,880
،لا يحقّ لابنة عشيقةٍ البقاء في بيتِ كونت

25
00:02:46,130 --> 00:02:48,540
وفوق ذلك وتحاولين التّقرّب
!من دوقة أماريليس

26
00:02:48,670 --> 00:02:52,960
بالنّسبة لمن هم من طبقتك، كونك
.خادمتي هو أكثر ممّا تستحقّينه

27
00:02:54,080 --> 00:02:57,040
شانو، يبدو أنّ شجارًا اندلع
.في وسط القاعة

28
00:02:57,170 --> 00:02:59,210
.ماذا؟ بما أنّك رأيته، فاذهب أنت

29
00:02:59,710 --> 00:03:01,580
.رجالي في طريقهم إلى هناك

30
00:03:01,710 --> 00:03:02,750
لكن هل أنت متأكّد؟

31
00:03:04,040 --> 00:03:07,460
ففي قلب الفوضى، تقف
...الفتاة الّتي تبغضها

32
00:03:09,920 --> 00:03:11,790
.إنّها إيانا ماغنوليا

33
00:03:16,920 --> 00:03:20,790
إ–إيانا ماغنوليا؟ لماذا...؟

34
00:03:21,330 --> 00:03:24,710
عجبًا، هل من الخطأ أن أقف أمامك؟

35
00:03:24,830 --> 00:03:25,830
ماذا؟

36
00:03:26,170 --> 00:03:29,710
مهلاً! كيف أصبحت الأمور هكذا فجأة؟

37
00:03:29,960 --> 00:03:33,460
،قفزتُ أمامها من دون تفكير
عليّ فقط تهدئتها، صحيح؟

38
00:03:33,750 --> 00:03:35,920
!بلطف... وابتسمي! ابتسمي

39
00:03:36,380 --> 00:03:41,330
كفّي عن محاولة جعل هذه الفتاة
.عبدتك. ليست عبدة على الإطلاق

40
00:03:41,830 --> 00:03:42,960
—لكنّ فلاّحة مثـ

41
00:03:43,080 --> 00:03:44,080
فلاّحة؟

42
00:03:44,330 --> 00:03:47,710
.إنّها... صديقتي

43
00:03:48,630 --> 00:03:51,750
!إيانا ماغنوليا؟! هذا مستحيل

44
00:03:53,790 --> 00:03:55,080
.أ-أعتذر

45
00:03:55,500 --> 00:03:58,330
!سامحيني رجاءً –
.لقد أبكتها. كم هي مخيفة –

46
00:03:58,460 --> 00:04:01,880
.ابتسامة شرّيرة –
...لقد جلبت انتباه شرّيرة مثلها –

47
00:04:02,000 --> 00:04:03,040
"ارتعاش"

48
00:04:03,170 --> 00:04:05,380
.يبدو أنّ آل كاميليا قد انتهى أمرهم الآن

49
00:04:05,500 --> 00:04:07,210
!لا، لن يحدث ذلك

50
00:04:07,710 --> 00:04:10,960
.ظننت أنّني ابتسمتُ ابتسامتي العاديّة فقط

51
00:04:11,080 --> 00:04:13,750
!وأنّ كلامي كان كلامًا عاديًّا فحسب

52
00:04:14,420 --> 00:04:15,630
.إيانا ماغنوليا

53
00:04:19,040 --> 00:04:20,750
.إذًا أنتِ من تسبّبت بهذا الشّجار

54
00:04:21,000 --> 00:04:22,000
!هذا سيّئ

55
00:04:22,130 --> 00:04:24,710
!لماذا فعلتُ شيئًا يجعلني في الواجهة هكذا؟

56
00:04:24,880 --> 00:04:27,880
التّحقيق الّذي حدث سابقًا
!أنت الجانية! خطفتِ أختي الصّغيرة –

57
00:04:28,330 --> 00:04:31,210
!على هذا المعدّل، سيريد التّحقيق معي ثانية

58
00:04:31,670 --> 00:04:32,670
!مهلاً

59
00:04:33,380 --> 00:04:37,960
!هذا اليوم هو حفلة ميلاد الدّوقة
!سيُحزن كلّ هذا الدّوقة

60
00:04:39,920 --> 00:04:42,080
!هذا المتوقّع من كونوها
!هل هي ملاك أم ماذا؟

61
00:04:42,630 --> 00:04:45,630
!توقّفي يا إيانا –
!أيّها المفتّش شانو! جئتَ لتساعدنا –

62
00:04:45,750 --> 00:04:46,920
...لا، أنا

63
00:04:47,580 --> 00:04:51,460
!وجود رجال الشّرطة يُشعر المرء بالأمان فعلاً

64
00:04:51,670 --> 00:04:52,830
"هالة فاضلة"

65
00:04:54,460 --> 00:04:55,830
!سامحيني أيّتها الآلهة

66
00:04:55,960 --> 00:04:56,960
!أريد الهرب من هنا فحسب –
!سيّدتي إيانا –

67
00:04:57,130 --> 00:04:58,960
سول؟ –
.من هنا –

68
00:04:59,460 --> 00:05:00,710
.لنبتعد عن أنظارهم

69
00:05:01,790 --> 00:05:03,880
...مثل الشّبهات الّتي تمطر فوق رأسي

70
00:05:04,920 --> 00:05:08,170
يجب أوّلاً أن أتدبّر أمر النّبيذ
.الّذي سُكب عليّ

71
00:05:10,000 --> 00:05:13,670
لماذا لا يخرج من الصّنبور إلاّ الماء البارد؟

72
00:05:13,790 --> 00:05:15,000
!أنا أتجمّد

73
00:05:16,920 --> 00:05:19,460
"إيانا ماغنوليا، ن ح: 1"
هل نحن في منتصف الشّتاء هنا؟ –

74
00:05:20,540 --> 00:05:21,540
.سيّدتي إيانا

75
00:05:21,710 --> 00:05:25,290
أنا آسفة يا سول، لكن هل كلّ
شيء بخير في قاعة الحفل؟

76
00:05:25,420 --> 00:05:26,420
.نعم

77
00:05:26,540 --> 00:05:29,540
.هدّأت كلمات السّيّدة كونوها الجميع

78
00:05:29,960 --> 00:05:30,960
وماذا عن مينوا؟

79
00:05:31,130 --> 00:05:32,170
.لا مشكلة

80
00:05:32,830 --> 00:05:35,000
.حقًّا؟ هذا مطمئن

81
00:05:36,250 --> 00:05:37,250
.سيّدتي إيانا

82
00:05:38,500 --> 00:05:41,420
،في هذا الوقت من اليوم
.لا يتوفّر سوى الماء البارد

83
00:05:41,830 --> 00:05:43,210
.أظنّ أنّني أخبرتك بذلك

84
00:05:43,830 --> 00:05:44,830
ماذا؟

85
00:05:44,960 --> 00:05:48,130
الخادمات في طريقهنّ
.بالماء السّاخن الّذي طلبتُه

86
00:05:48,880 --> 00:05:51,670
لم يكن حمّامك السّريع
.مجرّد تبليل طائر صغير

87
00:05:52,540 --> 00:05:55,630
.أترين؟ رائحة النّبيذ ما زالت عالقة بك

88
00:05:56,330 --> 00:05:59,130
...سول –
!توقّف –

89
00:05:59,250 --> 00:06:01,130
!أيّها الوغد المنحرف

90
00:06:01,250 --> 00:06:02,750
!خُذ هذه! وهذه! وهذه

91
00:06:03,880 --> 00:06:04,880
!من هنا

92
00:06:05,040 --> 00:06:06,790
مهلاً! مينوا؟

93
00:06:07,960 --> 00:06:09,460
!ماذا؟

94
00:06:09,750 --> 00:06:12,500
ماذا؟ لم يكن ذلك المنحرف يتحرّش بك؟

95
00:06:12,920 --> 00:06:15,170
!إنّه خادم شخصيّ
التقيتِ به في غرفتي، أتذكرين؟

96
00:06:15,920 --> 00:06:17,080
.حسنًا، لندع الأمر يمرّ على أنّه حادث لا أكثر

97
00:06:17,210 --> 00:06:18,210
بهذه السّرعة؟

98
00:06:18,540 --> 00:06:20,710
لماذا جاءت مينوا إلى هنا؟

99
00:06:21,040 --> 00:06:24,040
هل كان سماعها لشرّيرة
تناديها صديقة مشكلةً لها؟

100
00:06:24,710 --> 00:06:27,250
!عفوًا، أنا آسفة بشأن ما حدث سابقًا

101
00:06:27,500 --> 00:06:31,040
.ناديتك صديقة دون تفكير
!أظنّ أنّ ذلك سبّب لك المتاعب

102
00:06:34,540 --> 00:06:38,210
عمّ تتحدّثين؟
لماذا يسبّب ذلك المتاعب؟

103
00:06:40,250 --> 00:06:41,250
...لكن

104
00:06:41,380 --> 00:06:44,830
بل إنّه رائع! كلّ من كان يعيق
!طريقي اختفى دفعة واحدة

105
00:06:44,960 --> 00:06:46,210
!مرحى

106
00:06:46,960 --> 00:06:49,580
تحمّلتُ كثيرًا من معاملة أختي
،الّتي تفعل بي ما تشاء

107
00:06:50,080 --> 00:06:53,750
لكن بفضل إعلانك أمام
...الجميع أنّني صديقتك

108
00:06:54,040 --> 00:06:56,380
لا يمكنني التّدخّل في شؤون
!صديقة السّيّدة إيانا

109
00:06:56,880 --> 00:06:58,540
!ستنتقم منّا! سنُقتَل

110
00:06:58,750 --> 00:07:00,380
،أصبحت أختي تُحسن التّصرّف

111
00:07:00,500 --> 00:07:02,540
!والنّبلاء الّذين كانوا يحاولون استغلالي توقّفوا

112
00:07:02,670 --> 00:07:05,500
إن لم يكن هذا مثاليًّا، فما المثاليّ إذًا؟

113
00:07:06,420 --> 00:07:09,830
وإذا كنتِ قلقة بشأن سمعة
،الشّرّيرة الّتي تُنسب إليك

114
00:07:10,250 --> 00:07:13,960
فأنا أسعى للتّأكّد من الحقيقة
.بنفسي، فلا داعي للاعتذار

115
00:07:15,420 --> 00:07:19,130
وكما هو الحال في العلاقات البشريّة
.العاديّة، إن لم تعجبيني، سأبتعد عنك

116
00:07:19,460 --> 00:07:22,130
.وإن أعجبتِني، سأقترّب منك أكثر

117
00:07:22,580 --> 00:07:25,170
.وعلى الأقلّ، لم أكره جرأتك في قاعة الحفل

118
00:07:25,580 --> 00:07:28,420
.أريد أن أكون أكثر صراحة... مع صديقتي

119
00:07:31,130 --> 00:07:33,500
.أ-أشعر وكأنّها تستغلّني

120
00:07:33,960 --> 00:07:35,710
...لكن... لكن

121
00:07:36,880 --> 00:07:37,880
.ذلك يجعلني سعيدة

122
00:07:38,420 --> 00:07:41,210
!آنسة مينوا! أتطلّع لصداقتنا

123
00:07:41,330 --> 00:07:42,580
.توقّفي، أنت تخنقينني

124
00:07:43,170 --> 00:07:44,170
!قاسية

125
00:07:44,290 --> 00:07:46,130
.كنتُ سعيدة بعض الشّيء

126
00:07:47,130 --> 00:07:51,750
أردت قضاء وقت مع أوّل صديقة
.أحصل عليها في حفلة متلألئة

127
00:07:52,790 --> 00:07:56,750
"لذلك لم ألاحظ "التّاريخ المظلم
.الّذي يقترب منّي بريبة

128
00:07:57,960 --> 00:08:00,710
"فووو"

129
00:08:00,830 --> 00:08:02,710
.هذه العاصفة شديدة منذ الصّباح

130
00:08:03,630 --> 00:08:06,250
طلبت الدّوقة أماريليس توخّي الحذر

131
00:08:06,380 --> 00:08:08,630
.وتقترح تأجيل مغادرتنا حتّى الغد

132
00:08:08,920 --> 00:08:10,210
.فهمت يا سول

133
00:08:10,920 --> 00:08:12,580
.من الغريب ألاّ نتمكّن من المغادرة

134
00:08:12,920 --> 00:08:15,540
.استطعنا رؤية النّجوم البارحة في الحفلة

135
00:08:16,250 --> 00:08:17,250
.نعم

136
00:08:18,880 --> 00:08:19,880
.سيّدتي إيانا

137
00:08:20,170 --> 00:08:21,540
ماذا تفعلين؟

138
00:08:21,670 --> 00:08:23,210
!لا شيء

139
00:08:23,710 --> 00:08:25,670
.أنت راقصة رائعة يا إيانا

140
00:08:27,630 --> 00:08:28,790
!لا تهتمّ بي

141
00:08:29,080 --> 00:08:30,880
...تقولين ألاّ أهتمّ، ولكن

142
00:08:31,080 --> 00:08:35,830
جعلني عدم قدرتي على تذكّر مجريات
.القصّة متوتّرة جدًّا بشأن هذه الحفلة

143
00:08:36,210 --> 00:08:38,830
"!مينوا ظريفة جدًّا"
!لم أتخيّل يومًا أنّني سأحصل على صديقة

144
00:08:39,080 --> 00:08:40,250
...أقول صديقة

145
00:08:40,380 --> 00:08:43,420
!لكنّها أصغر ممّا كنتُ في حياتي السّابقة –
!مينوا، لنشرب الشّاي معًا –

146
00:08:43,630 --> 00:08:45,080
أتساءل هل سأكون بخير؟

147
00:08:45,380 --> 00:08:47,040
...في المرّة القادمة الّتي نلتقي فيها –
كيف حالك هذه الأيام؟ –

148
00:08:47,170 --> 00:08:49,130
هل سأستطيع التّصرّف بطبيعيّة؟ –
هل يعجبك أحد؟ –

149
00:08:49,250 --> 00:08:50,250
ماذا؟

150
00:08:50,380 --> 00:08:52,830
...عليّ الانتباه لكلّ ما أقوله وأفعله، وإلاّ

151
00:08:53,250 --> 00:08:56,830
أنا متأكّدة أنّنا كنّا صديقتين
!حتّى في حياةٍ سابقة

152
00:08:56,960 --> 00:08:57,960
.هذا مريب

153
00:08:58,330 --> 00:08:59,670
!هذا ما سيحدث

154
00:09:00,130 --> 00:09:02,920
،ليس الأمر أنّني لم أملك أصدقاء أبدًا

155
00:09:03,170 --> 00:09:06,880
لكنّها أوّل صديقة أحصل عليها منذ
!أن أصبحتُ إيانا، وهذا أسعدني كثيرًا

156
00:09:07,250 --> 00:09:10,000
رغم أنّ نظرتها كانت تقول بوضوح
.أنّ استغلالي هو أولويّتها

157
00:09:10,290 --> 00:09:13,330
،الآن بعد أن أصبحت الشّرّيرة صديقتي
!أصبحت كلّ الحشرات الصّغيرة هادئة

158
00:09:14,670 --> 00:09:18,000
على أيّ حال، وجود شخص مثلها
!شيء نادر! يجب أن أقدّرها

159
00:09:20,210 --> 00:09:21,460
.إيانا، لقد أسقطتِ هذا

160
00:09:21,960 --> 00:09:23,880
ما هذا؟ قرط؟

161
00:09:24,790 --> 00:09:27,790
!هذا... القرط الّذي أسقطته مينوا

162
00:09:27,920 --> 00:09:29,210
!نسيت أن أعيده لها

163
00:09:29,330 --> 00:09:30,330
ماذا أفعل؟

164
00:09:30,460 --> 00:09:32,540
جعلتني حادثةُ سكب النّبيذ
!عليّ أنسى تمامًا

165
00:09:32,670 --> 00:09:35,290
.وجدتُ هذا البارحة. إنّه قرطك

166
00:09:35,500 --> 00:09:37,210
لماذا لم تعيديه حين رأيتني؟

167
00:09:37,330 --> 00:09:39,000
!لا تقولي أنّك كنت تحاولين سرقته

168
00:09:39,790 --> 00:09:40,830
!ستكرهني

169
00:09:41,580 --> 00:09:42,580
.سيّد غينوفورد

170
00:09:44,290 --> 00:09:50,040
!أرجوك، لا تخبر أحدًا أنّ القرط كان معي

171
00:09:50,500 --> 00:09:51,500
...حسنًا

172
00:09:52,170 --> 00:09:53,460
.أعتقد أنّي لا أمانع

173
00:09:54,960 --> 00:09:55,960
لكن لماذا؟

174
00:09:56,080 --> 00:09:59,790
صحيح! سأخبر مينوا
!أنّني وجدته للتّوّ في الرّواق

175
00:10:00,670 --> 00:10:05,960
إيانا، قالت الدّوقة أنّها تريد التّحدّث
،معي على انفراد ودعتني لتناول الشّاي

176
00:10:06,460 --> 00:10:09,630
لكنّني سأكون متوتّرة جدًّا
وحدي. هل ستأتين معي؟

177
00:10:10,460 --> 00:10:12,500
.هل أذهب؟ لست جادًّا طبعًا

178
00:10:12,670 --> 00:10:14,420
!لـ-لا، لا تذهب

179
00:10:14,540 --> 00:10:18,250
لا يمكنك الاستماع لحديثنا عن مساحيق
!التّجميل وما إلى ذلك يا سيّد غينوفورد

180
00:10:18,420 --> 00:10:20,040
!كونوها لطيفة جدًّا

181
00:10:20,420 --> 00:10:22,290
!أنا آسفة يا أختي العزيزة

182
00:10:22,420 --> 00:10:25,380
!أنا ذاهبة لرؤية صديقتي الآن

183
00:10:25,500 --> 00:10:28,250
!سأعود قريبًا، لذا اسبقيني

184
00:10:29,750 --> 00:10:32,420
سأكون في الشّرفة الزّجاجيّة في الجهة
!الغربيّة الوسطى من الطّابق الأوّل

185
00:10:33,080 --> 00:10:35,710
،إن لم تتمكّن من العثور عليه
!فليدُلّك أحدهم على المكان

186
00:10:36,630 --> 00:10:41,250
كانت مينوا أمس ترتدي فستانًا
.يُعدّ ذكرى من والدتها

187
00:10:42,380 --> 00:10:45,290
.وربّما يكون هذا القرط عزيزًا عليها أيضًا

188
00:10:45,960 --> 00:10:47,500
.لكنّي نسيت الأمر

189
00:10:50,500 --> 00:10:51,960
!هذا مؤلم

190
00:10:53,290 --> 00:10:56,130
أنا متأكّدة أنّها في مكان ما
...في هذا الطّابق، ولكن

191
00:10:56,960 --> 00:10:58,710
.هذا أشبه بعربة قطار مكتظّة

192
00:10:59,170 --> 00:11:02,210
!لهذا قلتُ لكم أن تبحثوا

193
00:11:02,420 --> 00:11:05,960
.اهدئي رجاءً يا سيّدة كاميليا

194
00:11:06,630 --> 00:11:10,500
،إن حدث شيء لتلك الفتاة
!فأبي سيغضب منّي أنا

195
00:11:10,830 --> 00:11:12,420
.تلك هي أخت مينوا الكبرى

196
00:11:12,750 --> 00:11:14,130
هل حدث شيء ما يا تُرى؟

197
00:11:14,580 --> 00:11:17,210
!أريد إعادة هذا لمينوا بأسرع وقت ممكن

198
00:11:17,330 --> 00:11:19,580
لكن بما أنّ هذا المكان قريب
!من غرفتها، لا أستطيع التّحرّك

199
00:11:19,960 --> 00:11:21,290
"كانت هذه هي الخطّة"
.شكرًا لك يا إيانا –

200
00:11:21,500 --> 00:11:24,170
ما يحتاجه الجميع أكثر من أيّ شيء
.هو صديق. لا، بل أفضل صديق

201
00:11:24,290 --> 00:11:25,290
"بداية" "هدف"
.لا –

202
00:11:25,420 --> 00:11:28,580
إن خفّفتُ خطواتي وسرتُ خلفهم
...وتسلّلت إلى الغرفة

203
00:11:30,330 --> 00:11:32,580
مهلاً! ألم تتولّ أمر هذا بعد يا ميكا؟

204
00:11:32,710 --> 00:11:34,000
!شانو

205
00:11:35,380 --> 00:11:36,380
.المعذرة على التّطفّل

206
00:11:36,500 --> 00:11:40,670
لقد أنهينا تفتيش جميع المخارج
.الّتي ربّما استخدمتها أختك

207
00:11:40,960 --> 00:11:42,330
!شانو

208
00:11:43,500 --> 00:11:44,500
كيف سار الأمر؟

209
00:11:44,920 --> 00:11:49,920
يبدو أنّ أختك غير موجودة
!في أيّ مكان كما قلت

210
00:11:51,580 --> 00:11:52,580
مينوا؟

211
00:11:54,290 --> 00:11:56,540
ورغم هذا الطّقس، لا يمكننا استبعاد
.احتمال أنّها خرجت من المنزل

212
00:11:57,500 --> 00:12:00,880
.لكن في هذه المرحلة، لا شكّ أنّها مختفية

213
00:12:01,460 --> 00:12:02,750
ما الّذي قاله للتّوّ؟

214
00:12:03,170 --> 00:12:05,580
مينوا... اختفت؟

215
00:12:08,210 --> 00:12:10,040
هل سمعتُه بشكل خاطئ؟

216
00:12:11,540 --> 00:12:13,040
.إيانا ماغنوليا

217
00:12:14,580 --> 00:12:16,170
.بدا الأمر غريبًا بالفعل

218
00:12:16,880 --> 00:12:22,000
،لم تصر مينوا من النّبلاء إلاّ حديثًا
فلماذا تصادقينها؟

219
00:12:23,380 --> 00:12:28,080
ماذا فعلتِ بتلك الفتاة الجاهلة
الّتي انتقلت للتّوّ من فلاّحة إلى نبيلة؟

220
00:12:28,960 --> 00:12:30,080
!أنا أعرف كلّ شيء

221
00:12:30,210 --> 00:12:34,460
أعرف أنّك حاولت قتل أختك
السّيّدة كونوها بـ"التّاريخ المظلم"؟

222
00:12:35,540 --> 00:12:39,000
أنا متأكّدة أنّ هذه المرأة
!قتلت مينوا بالطّريقة نفسها

223
00:12:39,460 --> 00:12:41,710
يقولون أنّ المجرم يعود دومًا
!إلى مسرح الجريمة

224
00:12:41,830 --> 00:12:42,880
!يا لها من امرأة فظيعة

225
00:12:43,000 --> 00:12:45,540
هل تجري في عروقها نفس
دماء السّيّدة كونوها بالفعل؟

226
00:12:45,670 --> 00:12:47,080
.إنّها شرّيرة حقيقيّة

227
00:12:47,210 --> 00:12:48,250
.فاسدة حتّى النّخاع

228
00:12:48,540 --> 00:12:49,830
...لـ-لماذا

229
00:12:52,250 --> 00:12:53,790
،سيّدة إيانا ماغنوليا

230
00:12:54,000 --> 00:12:55,250
.تعالي معنا رجاءً

231
00:12:55,420 --> 00:12:57,500
!ولكن لماذا؟

232
00:13:05,000 --> 00:13:07,920
"التّاريخ المظلم للشّرّيرة المتجسّدة"

233
00:13:11,420 --> 00:13:13,210
!آسفة يا سعادتك

234
00:13:13,330 --> 00:13:14,500
كيف أكون بهذا التّهاون؟

235
00:13:14,960 --> 00:13:17,040
هل أصبت يا سيّدتي كونوها؟

236
00:13:17,790 --> 00:13:19,460
.كـ-كلاّ

237
00:13:20,290 --> 00:13:22,210
.لقد تسبّبتُ بإرباكك

238
00:13:22,790 --> 00:13:25,000
.من الأفضل أن تستريحي في غرفتك اليوم

239
00:13:25,750 --> 00:13:26,750
.نعم

240
00:13:27,710 --> 00:13:31,420
أعتذر يا سول. خاصّة بعد
.أن تفضّلتَ بمرافقتي

241
00:13:31,630 --> 00:13:36,040
بل أنا من يجب أن يعتذر
.لتطفّلي على لقائك الخاصّ

242
00:13:36,750 --> 00:13:39,540
.لكن الأهمّ... يبدو وجهك شاحبًا

243
00:13:40,500 --> 00:13:44,750
.ر-ربّما لأنّني شعرتُ بشيء من القلق

244
00:13:45,380 --> 00:13:47,920
.خُيّل لي أنّني سمعتُ صراخًا

245
00:13:48,750 --> 00:13:52,630
!كلاّ! اتركنني! اتركنني –
.كانت محقّة –

246
00:13:52,750 --> 00:13:58,040
!لستُ الفاعلة! أنا بريئة! أنا بريئة –
!رائحة الجميع هنا رائعة –

247
00:13:58,750 --> 00:14:00,920
.مرحبًا يا سيّدتي ماغنوليا

248
00:14:01,830 --> 00:14:04,960
،أنا قائد وحدة الهايدرانجيا
!ياماتو هايدرانجيا

249
00:14:05,710 --> 00:14:07,290
.ويسوء حظّي أكثر وأكثر

250
00:14:07,670 --> 00:14:11,420
ومن بين كلّ الاحتمالات، ترافقني
.الشّرطة نفسها الّتي تشكّ بي

251
00:14:11,790 --> 00:14:14,460
...والآن، إن تكرّمتِ بالشّرح

252
00:14:15,000 --> 00:14:19,000
لماذا كنتِ في ذلك المكان
بينما غرفتك في طابق آخر؟

253
00:14:19,500 --> 00:14:24,040
وقد عُثر على قرط
.السّيّدة مينوا أثناء تفتيشك

254
00:14:24,960 --> 00:14:26,960
لماذا هو بحوزتك؟

255
00:14:27,210 --> 00:14:28,710
.أنتِ فتاة مطيعة، أجيبي بصراحة

256
00:14:33,290 --> 00:14:36,540
،عليّ أن أُبعد الشّبهات عنّي بسرعة
!لأتمكّن من البحث عن مينوا

257
00:14:37,710 --> 00:14:40,580
.وجدتُ ذلك القرط للتّوّ

258
00:14:41,210 --> 00:14:45,250
إنّه يشبه تمامًا الأقراط الّتي كانت
،السّيّدة مينوا ترتديها في حفلة الأمس

259
00:14:45,540 --> 00:14:46,880
.لذلك كنتُ أنوي إعادته لها

260
00:14:49,330 --> 00:14:50,330
.فهمت

261
00:14:50,750 --> 00:14:55,500
وهل تقرّبت منها بما يكفي
لتتعرّفي على تصميم أقراطها؟

262
00:14:56,460 --> 00:14:57,500
وهل يُعدّ ذلك خطأً؟

263
00:14:58,040 --> 00:15:01,040
،قد تكون حفلة عيد ميلاد الدّوقة
.لكنّها كانت حدثًا اجتماعيًّا

264
00:15:01,380 --> 00:15:02,670
.والاختلاط أمر طبيعيّ فيه

265
00:15:03,460 --> 00:15:07,630
،حتّى لو تحدّثتُ عن مينوا الآن
.لا يجدر بذلك أن يثير شكوكهم مباشرة

266
00:15:09,380 --> 00:15:14,080
وفوق ذلك، الشّجار الّذي وقع
.في القاعة رآه الضّيوف والمفتّش شانو أيضًا

267
00:15:14,880 --> 00:15:17,330
،قد أكون قد التقيتُ مينوا بعد الحفل

268
00:15:17,630 --> 00:15:19,380
.لكنّ سول كان بصحبتي حينها

269
00:15:20,000 --> 00:15:21,000
...ومع ذلك

270
00:15:21,960 --> 00:15:23,580
.وأخيرًا، سأطرح السّؤال مرّة أخرى

271
00:15:24,000 --> 00:15:26,960
هل وجدت ذلك القرط اليوم فعلاً؟

272
00:15:28,380 --> 00:15:29,460
.هذا صحيح

273
00:15:30,250 --> 00:15:33,330
إن اكتشفوا أنّني احتفظتُ به
...منذ اللّيلة الماضية

274
00:15:33,750 --> 00:15:37,500
فلن ألومهم لو اعتقدوا
.أن شيئًا ما حدث بيني وبين مينوا

275
00:15:39,630 --> 00:15:40,880
.سأحرص على أن يصل القرط إليها

276
00:15:41,420 --> 00:15:42,420
.هذا مريح

277
00:15:42,750 --> 00:15:46,460
،لو قرّروا احتجازي
.لما استطعت البحث عن مينوا

278
00:15:48,710 --> 00:15:49,960
...أريد أن أكون أكثر صدقًا

279
00:15:50,920 --> 00:15:51,920
.مع صديقتي

280
00:15:52,040 --> 00:15:54,290
!اسمعي! أحضري أمتعتك

281
00:15:54,710 --> 00:15:56,420
من قال أنّنا سنُطلِق سراحك؟

282
00:15:58,290 --> 00:16:02,710
سنبدأ تحقيقًا حقيقيًّا في واقعة
.الاختفاء ابتداءً من الآن

283
00:16:03,040 --> 00:16:06,080
ستكونين تحت إشرافي، وستبقين
.في غرفة أخرى بانتظار التّعليمات

284
00:16:06,880 --> 00:16:09,170
!ماذا قال للتّوّ؟

285
00:16:11,830 --> 00:16:13,830
هذا فقط كي لا تهربي، أليس الأمر واضحًا؟

286
00:16:14,330 --> 00:16:18,290
أنتِ مشتبه بها في قضيّة
.الجميلات المخطوفات

287
00:16:19,420 --> 00:16:23,670
،غادرتِ الحفل، ثمّ اختفت إحدى الجميلات

288
00:16:23,790 --> 00:16:25,250
"كلاّ"
.من الطّبيعيّ أن نشكّ فيك –

289
00:16:26,880 --> 00:16:29,630
،إلى أن يكشف أحد ما عن دليل

290
00:16:29,960 --> 00:16:31,420
.سننتظر ذلك بفارغ الصّبر

291
00:16:32,420 --> 00:16:34,540
!كيف يفترض بي أن أتشوّق لشيء كهذا؟

292
00:16:34,960 --> 00:16:37,960
.تغيير الغرف. الشّرطة مستعجلة هذه المرّة

293
00:16:38,420 --> 00:16:42,580
على ما يبدو، يريدون مكانًا هادئًا
.ليستمعوا إلى ما سأقوله فقط

294
00:16:42,960 --> 00:16:44,630
.تحدّثتُ مع مينوا بالفعل

295
00:16:44,750 --> 00:16:48,750
لا أستطيع إخباره بأنّهم
!يشكّون بي كثيرًا! سيقتلني

296
00:16:49,330 --> 00:16:53,500
بـ-بالمناسبة، هل صحيح أنّ أختي ليست بخير؟

297
00:16:54,210 --> 00:16:55,210
.نعم

298
00:16:55,330 --> 00:16:58,540
،كانت تتحدّث مع الدّوقة قبل قليل

299
00:16:58,830 --> 00:17:00,880
.ثمّ شعرت بقشعريرة مفاجئة

300
00:17:01,460 --> 00:17:03,750
.أنا سعيد أنّي كنت معها كمرافق

301
00:17:07,750 --> 00:17:08,750
.كونوها

302
00:17:09,920 --> 00:17:11,130
.نامت للتّوّ

303
00:17:11,630 --> 00:17:14,580
لكنّ الطّبيب قال أنّها ستتعافى
.بعد قليل من الرّاحة

304
00:17:15,080 --> 00:17:17,040
.فـ-فهمت

305
00:17:18,460 --> 00:17:20,330
،ربّما هذا لأنّها جميلة شاحبة

306
00:17:20,790 --> 00:17:23,790
.لكنّها تبدو كدمية مصنوعة بإتقان وهي نائمة

307
00:17:23,920 --> 00:17:25,380
دمية متقنة الصّنع: تحدّق روزا الدّمويّة"
"بشدّة في وجه كونوها وتضحك

308
00:17:26,080 --> 00:17:27,420
...بعد التّفكير في الأمر

309
00:17:27,710 --> 00:17:32,460
هناك جزء في القصّة حيث
.تكاد كونوها تتحوّل إلى محنَّطة

310
00:17:32,830 --> 00:17:36,170
في "التّاريخ المظلم"، يبدأ ذلك
.حين يرسل ملك روز دعوة إليها

311
00:17:36,830 --> 00:17:39,250
.يستدعي الملك كونوها إلى الحديقة

312
00:17:39,580 --> 00:17:41,170
هل تعرفين بهذا؟

313
00:17:41,330 --> 00:17:46,500
هناك أرض في هذه المملكة تُقدَّم
.فيها الفتيات الصّغيرات كقرابين

314
00:17:46,710 --> 00:17:51,420
وقد تبنّى أحد أفراد العائلة
.الملكيّة هذا الفعل المشين

315
00:17:51,880 --> 00:17:54,460
أرجوكِ، استخدمي قوّتك المقدّسة
.لتطهير هذا الشّرّ

316
00:17:55,880 --> 00:18:00,040
تشعر كونوها الألم الّذي يخفيه
،الملك تجاه قريبه

317
00:18:00,170 --> 00:18:01,630
.فتقبل طلبه

318
00:18:03,130 --> 00:18:06,250
إن كانت قواي قادرة على إنقاذ
!ذلك الشّخص، فبالطّبع سأساعد

319
00:18:07,210 --> 00:18:10,920
،لكن بعد هذه المحادثة مباشرة
.يتمّ اختطاف كونوها

320
00:18:11,330 --> 00:18:13,330
!أنت مميّزة

321
00:18:13,460 --> 00:18:17,630
،بعد أن أتجرّع كلّ دماك
!سأُحنّطك وأغرقك بالحبّ

322
00:18:18,040 --> 00:18:21,330
اختُطِفت على يد الشّخصيّة الّتي ابتكرتها
...فقط لأنّي ربطت النّبيذ المسكوب بالدّم

323
00:18:21,580 --> 00:18:23,000
.روزا الدّمويّة

324
00:18:24,040 --> 00:18:25,330
"كفّي عن تخيّل الأمور"
.لكن لا علاقة لذلك بما يحدث الآن –

325
00:18:26,040 --> 00:18:28,170
تلك الورود جميلة، أليس كذلك؟

326
00:18:28,460 --> 00:18:31,460
نعم. أحضرتها الدّوقة عندما
.جاءت لزيارتها قبل قليل

327
00:18:31,960 --> 00:18:32,960
الدّوقة؟

328
00:18:33,290 --> 00:18:35,210
،جاءت إحدى أفراد العائلة الملكيّة بنفسها

329
00:18:35,330 --> 00:18:37,670
وجلبت معها الورود، الزّهرة الّتي
.تشتهر بها البلاد. كان الأمر مفاجئًا

330
00:18:38,210 --> 00:18:40,080
.ويبدو أنّها أصبحت متعلّقة بكونوها كثيرًا

331
00:18:41,170 --> 00:18:42,210
زهرة البلاد؟

332
00:18:42,880 --> 00:18:43,880
.هذا صحيح

333
00:18:43,960 --> 00:18:47,630
إنّ كلّ من يحمل دماءً ملكيّة
.يحمل اسم "روزا" كاسم أوسط

334
00:18:48,960 --> 00:18:49,960
إيانا؟

335
00:18:50,080 --> 00:18:51,250
روزا؟

336
00:18:51,830 --> 00:18:55,000
وقد تبنّى أحد أفراد العائلة
.الملكيّة هذا الفعل المشين

337
00:18:55,540 --> 00:18:57,040
...شخص بدماء ملكيّة

338
00:18:58,460 --> 00:18:59,460
.روزا

339
00:18:59,750 --> 00:19:01,920
.سوسيلينا روزا أماريليس

340
00:19:02,830 --> 00:19:05,130
...لا يُعقل أنّ روزا الدّمويّة هي

341
00:19:06,750 --> 00:19:08,290
إيانا، هل أنت بخير؟

342
00:19:08,830 --> 00:19:09,830
.لا فائدة

343
00:19:10,420 --> 00:19:12,750
،هناك أفراد آخرون من العائلة الملكيّة
.ولا يوجد دليل

344
00:19:14,000 --> 00:19:15,000
.أنا بخير

345
00:19:15,330 --> 00:19:16,330
.تذكّري

346
00:19:17,000 --> 00:19:19,540
تذكّري من كنتِ عندما
!ابتكرتِ روزا الدّمويّة

347
00:19:19,670 --> 00:19:21,330
"ها ها ها"

348
00:19:21,460 --> 00:19:24,460
"تشاهد الأنمي من الأصدقاء"
.أيّتها الأميرة، أنت لي –

349
00:19:24,580 --> 00:19:25,830
"تميل للأمام"
!توقّف أيّها الوغد –

350
00:19:25,960 --> 00:19:30,250
لماذا تتظاهرين بالشّجاعة؟
.كوني صادقة مع نفسك

351
00:19:30,380 --> 00:19:33,290
!لن أستسلم أبدًا لملك الظّلام

352
00:19:33,670 --> 00:19:35,920
!سيأتي الأمير لينقذني

353
00:19:36,040 --> 00:19:39,500
إلى متى ستستمرّين بالتّظاهر بالشّجاعة؟

354
00:19:40,420 --> 00:19:42,330
!أميرتي –
ما هذا؟ –

355
00:19:42,460 --> 00:19:44,630
!دع الأميرة

356
00:19:44,750 --> 00:19:46,250
"غوااااه"
"دلو قمامة"

357
00:19:46,380 --> 00:19:47,460
!أميري

358
00:19:47,710 --> 00:19:49,830
"لعبة قطط مغطّاة بالدّم"
.مات الأمير

359
00:19:50,460 --> 00:19:55,290
لا خيار لكِ الآن سوى أن تقضي
!حياتك كدمية عزيزة لديّ

360
00:19:55,420 --> 00:19:56,420
"نهاية سيّئة"

361
00:19:56,540 --> 00:19:58,080
"القصّة الرّئيسيّة"
.من المشهد 4 وما بعد... من خيالي فحسب –

362
00:19:58,210 --> 00:19:59,210
.هذه هي القصّة الحقيقيّة

363
00:19:59,330 --> 00:20:00,330
.أميرتي

364
00:20:00,460 --> 00:20:02,210
.آمنتُ دائمًا بأنّك ستأتي

365
00:20:02,460 --> 00:20:05,630
سأعيش في هذا الجوّ، أو بالأحرى
!خيالاتي عنه، لفترة طويلة

366
00:20:05,880 --> 00:20:07,960
"متحمّسة للإهانات"
!صوري الذّهنيّة مصنّفة لكلّ الأعمار –

367
00:20:08,250 --> 00:20:09,250
!جيّد

368
00:20:09,380 --> 00:20:11,710
مع ذلك، هذا لا يعني
.أنّ الأمور خالية من التّعقيدات

369
00:20:11,920 --> 00:20:13,000
"لهذه التّعابير علاقة بأحلام اليقظة"
!لن أستسلم أبدًا –

370
00:20:13,670 --> 00:20:14,670
!ما عدت أستطيع

371
00:20:14,790 --> 00:20:16,000
"لن يقود هذا لأيّ رومانسيّة بالتّأكيد"
...أتساءل باستمرار –

372
00:20:16,250 --> 00:20:17,330
"!هذا سيّئ"

373
00:20:19,170 --> 00:20:22,750
كدتُ أتحوّل إلى وحش لأمحو كلّ
.من رأى وجهي بينما كنت أتخيّل

374
00:20:23,210 --> 00:20:24,210
...حسب الخطّ الزّمنيّ

375
00:20:24,460 --> 00:20:26,380
أوّلاً، توقظ كونوها سحرها
.وتغادر في رحلة

376
00:20:26,750 --> 00:20:27,750
.ثانيًا، الوضع الحاليّ

377
00:20:27,960 --> 00:20:30,580
.ثالثًا، حدث الكثير وتمّ الاعتراف بها كقدّيسة

378
00:20:31,170 --> 00:20:33,500
رابعًا، يزداد الأعداء قوّة
.ويظهر ملك الشّياطين

379
00:20:33,960 --> 00:20:36,330
.خامسًا، تظهر روزا الدّمويّة في مرحلة ما هنا

380
00:20:37,500 --> 00:20:40,420
لم أتذكّر لأنّ ذلك لا يُذكر
،إلاّ في مشاهد استرجاع الماضي

381
00:20:40,710 --> 00:20:46,420
لكن في البداية، لم تكن روزا الدّمويّة تفعل
.سوى إغراق الفتيات المختطفات بالحبّ

382
00:20:47,750 --> 00:20:52,330
وعندما تلتقي كونوها في منتصف
.القصة، تكون قد سئمت من ذلك

383
00:20:52,460 --> 00:20:53,960
،تقتل الفتيات باسم الجمال

384
00:20:54,630 --> 00:20:56,630
.وتبدأ بشرب دمائهنّ

385
00:20:57,630 --> 00:20:58,880
،عندما يظهر شانو

386
00:20:59,210 --> 00:21:03,290
لم يكن قد مرّ سوى ستّة أشهر
.تقريبًا على بدء اختفاء الفتيات

387
00:21:04,080 --> 00:21:06,380
إذا كانت الدّوقة أماريليس
،هي نفسها روزا الدّمويّة

388
00:21:06,500 --> 00:21:10,500
وقبل ظهورها في القصّة، وقبل
...استيقاظ رغبتها في شرب الدّم

389
00:21:11,170 --> 00:21:16,080
فهذا يعني أنّ احتمال بقاء مينوا وباقي
.الفتيات على قيد الحياة أعلى بكثير

390
00:21:16,750 --> 00:21:18,500
!عليّ أن أفعل أيّ شيء للعثور عليهنّ

391
00:21:19,250 --> 00:21:20,250
.سيّدتي إيانا

392
00:21:20,960 --> 00:21:23,380
.أخبرني المحقّق شانو بكلّ شيء

393
00:21:24,130 --> 00:21:26,210
،ومهما كانت الشّبهات حول الاختطاف

394
00:21:26,460 --> 00:21:28,580
.فسأرافقك إلى غرفتك الجديدة

395
00:21:30,330 --> 00:21:32,750
.لا، لا داعي لأن ترافقني

396
00:21:33,000 --> 00:21:35,040
،طالما أنّ الشّرطة تشكّ بي

397
00:21:35,460 --> 00:21:37,750
،فعيونهم ستكون عليّ دائمًا
.وهذا سيجعلني بأمان

398
00:21:38,170 --> 00:21:41,460
...لكنّ سلامة أختي كونوها وبقيّة الفتيات

399
00:21:42,210 --> 00:21:43,750
.احمِ أختي

400
00:21:46,420 --> 00:21:50,630
أيًّا كان الأمر، حتّى لو تحدّثت الآن
،عن جرائم الدّوقة أماريليس

401
00:21:51,000 --> 00:21:53,290
.فعلى الأرجح أنّ سول لن يثق بأحد

402
00:21:54,500 --> 00:21:56,420
ألم تنتهي بعد؟

403
00:21:57,500 --> 00:21:58,920
!سأذهب لأغيّر ملابسي

404
00:22:01,580 --> 00:22:03,330
!لهذا يجب أن أكشف كلّ شيء بنفسي

405
00:22:04,580 --> 00:22:07,920
!سأعثر على مينوا وعلى الأخريات

406
00:23:40,420 --> 00:23:42,210
"أصليّة هي مجموعة حروف سحريّة"
!تذكّرت! روزا الدّمويّة –

407
00:23:42,330 --> 00:23:44,880
!فكّرتُ في اسم رائع، إن جاز لي التّعبير

408
00:23:45,000 --> 00:23:47,040
!لا تقولي ذلك الآن
.حتّى مينوا اختُطفت

409
00:23:47,170 --> 00:23:49,500
وهل ستكون التّالية أختي كونوها؟

410
00:23:49,630 --> 00:23:51,330
ألم تنتهي بعد؟

411
00:23:51,960 --> 00:23:54,290
عليّ أن أجد حلاًّ لهذا الشّرطيّ
!عديم اللّباقة شانو