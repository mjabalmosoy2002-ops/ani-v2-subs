4
00:00:08,290 --> 00:00:09,860
!ابذل كُلّ ما لديك

5
00:00:09,860 --> 00:00:12,180
أعلم بأنّه يمكنك تمريغ أنفه في التّراب

6
00:00:15,350 --> 00:00:18,570
!اللّحظة الّتي أحرز فيها هوم ران

7
00:00:30,080 --> 00:00:32,080
!يسحقها ياماوكا

8
00:00:32,790 --> 00:00:33,960
...لقد

9
00:00:33,960 --> 00:00:35,060
!حلّقت بعيداً

10
00:00:36,880 --> 00:00:38,470
!لم أستطع إدراكها

11
00:00:38,470 --> 00:00:39,470
!إنّها تبتعد

12
00:00:39,470 --> 00:00:40,920
!الميدان الأيسر

13
00:00:40,920 --> 00:00:42,800
!هيّا

14
00:00:43,180 --> 00:00:44,140
!آسو

15
00:00:44,140 --> 00:00:45,740
...لن تفلتي

16
00:00:46,090 --> 00:00:47,260
!تبّاً

17
00:00:51,440 --> 00:00:52,710
نِكاية بكم

18
00:02:31,080 --> 00:02:35,050
مُواجهة الإصرار

19
00:02:42,580 --> 00:02:46,800
!صمدَ لاعب الميدان الأيسر آسو

20
00:02:47,090 --> 00:02:50,890
!اصطدمَ بحائط السّياج لكن قدّمَ أداءً مُبهراً

21
00:02:51,710 --> 00:02:54,190
!آسو، أحسنتَ الإمساك

22
00:02:54,700 --> 00:02:55,940
هل أنت بخير؟

23
00:02:55,940 --> 00:02:57,770
!سيكون هذا الخروج رقم ثلاثة

24
00:02:56,970 --> 00:02:58,640
!ارتطم رأسه

25
00:02:58,230 --> 00:03:01,610
!نجا سيدو من ظرف خطير لتحقيق نقطة

26
00:02:58,900 --> 00:03:00,300
!أحضروا نقّالة

27
00:03:01,970 --> 00:03:06,330
سقطتْ قُبيل السّياج بقليل بسبب
القوّة الّتي بذلتَها فيها

28
00:03:06,740 --> 00:03:08,810
كانت هناك حياة نابضة في رميتك

29
00:03:09,920 --> 00:03:13,300
لكن لو لم يُمسكها، لكانوا نقطتين

30
00:03:13,660 --> 00:03:15,620
آسو أنقذنا حقّاً

31
00:03:15,620 --> 00:03:17,310
أنا بخير

32
00:03:17,310 --> 00:03:19,150
فهمت. لا تتحرّك من فضلك

33
00:03:21,420 --> 00:03:24,300
!أداء مُمتاز يا آسو-سينباي

34
00:03:24,830 --> 00:03:26,270
أتعتقد بأنّه سيشتهر؟

35
00:03:26,270 --> 00:03:27,480
!سيشتهر بالتّأكيد يا رجل

36
00:03:27,740 --> 00:03:28,990
!مُحال

37
00:03:31,590 --> 00:03:32,800
...آسو

38
00:03:34,480 --> 00:03:36,630
!آسو، لعِب رائع

39
00:03:36,630 --> 00:03:38,340
!يتطلّب ذلك جرأة

40
00:03:39,150 --> 00:03:44,400
تقدّمنا عنهم، لكن لا أحد يتذكّر ذلك
بسبب ذلك الأداء

41
00:03:45,300 --> 00:03:47,550
هذا يستفزّني

42
00:03:49,200 --> 00:03:52,580
إيّاكم والاعتقاد بأنّ هذا يعني
بأنّ الزّخم لصالحنا

43
00:03:53,050 --> 00:03:55,200
سيتمّ إيقاف اللّعب مؤقّتاً بسبب
صيانة الملعب

44
00:03:55,590 --> 00:03:58,040
استمرّوا في الدِّفاع كما لو أنّ
الشّوط الأوّل قد عاد

45
00:04:02,030 --> 00:04:04,140
بقيت أربعة أشواط

46
00:04:04,960 --> 00:04:08,030
حان وقت إزالة قيودي

47
00:04:09,430 --> 00:04:13,360
إذا خرجَ آسو، سيضطرّ يوكي
للانتقال إلى الميدان الأيسر

48
00:04:13,360 --> 00:04:19,150
ضرباته ممتازة، لكن دِفاعه ليس
بديلاً عن دِفاع آسو

49
00:04:19,370 --> 00:04:23,040
في النّهائي، نقطة واحدة يمكنها
أن تصنع كُلَّ الفرق

50
00:04:23,040 --> 00:04:27,040
لا أصدِّق بأنّ الثّغرة الرّئيسيّة في فريقنا
...قد برزت الآن

51
00:04:27,960 --> 00:04:30,670
آسو أوقفَ زخمَ إيناشيرو

52
00:04:30,980 --> 00:04:33,820
وسيبدأ كوراموتشي في الشّوط التّالي

53
00:04:33,820 --> 00:04:35,960
!آمل أن نتمكّن من الانتقال للهجوم مُباشرة

54
00:04:36,420 --> 00:04:38,850
!لقد تقدَّموا، لكنّها ليست إلّا نقطة واحدة

55
00:04:40,330 --> 00:04:43,880
سيترتّب علينا إضافة نقاط إلى
اللّائحة للفوز على أيّ حال

56
00:04:43,880 --> 00:04:46,590
التّلويح بتملمُل نحو الرّميات الصّعبة

57
00:04:46,980 --> 00:04:48,810
هو ما يريده ناروميا الآن

58
00:04:49,540 --> 00:04:53,260
يبقى هدفنا نفسه. مفهوم؟

59
00:04:55,000 --> 00:04:58,090
...الإصرار الّذي أظهرتموه في نصف النّهائي

60
00:04:58,090 --> 00:04:59,970
هذه هي قوّتكم

61
00:05:00,580 --> 00:05:03,630
الجهد اليوميّ الّذي بذلتموه سيُمهِّد الطّريق

62
00:05:04,340 --> 00:05:06,150
!انطلقوا إلى الأمام بلا تردُّد

63
00:05:06,150 --> 00:05:07,780
!أعلم بأنّكم تستطيعون فعلها

64
00:05:07,780 --> 00:05:09,940
!أجل

65
00:05:10,690 --> 00:05:13,570
،النّصف الأوّل من الشّوط السّادس
سيدو في موقعة الضّرب

66
00:05:14,450 --> 00:05:18,170
النّصف الأوّل من الشّوط السّادس

67
00:05:14,790 --> 00:05:17,380
!عدنا إلى مُقدِّمة ترتيب الضّاربين مع كوراموتشي

68
00:05:18,460 --> 00:05:23,350
يسدّد الضّارب الأوّل السّريع ضربات
!سريعة في هذه البطولة

69
00:05:23,780 --> 00:05:27,440
هل يستطيع الوصول إلى القاعدة ومنحهم
الفُرصة الّتي يحتاجونها للتّسجيل؟

70
00:05:28,870 --> 00:05:31,260
!تشي-ساما، تشي-ساما

71
00:05:31,260 --> 00:05:32,810
!أتوسّل إليك

72
00:05:32,810 --> 00:05:33,910
!يوه-سان

73
00:05:34,300 --> 00:05:36,270
صِل إلى القاعدة يا كوراموتشي

74
00:05:36,270 --> 00:05:38,060
!هيّا يا كوراموتشي

75
00:05:38,060 --> 00:05:39,510
!لنفعلها

76
00:05:42,560 --> 00:05:45,060
احرص على تفريش أسنانك قبل النّوم

77
00:05:45,060 --> 00:05:46,550
!أعلم، تبّاً

78
00:05:46,840 --> 00:05:49,110
أخبرنا إن حصلت على حبيبة

79
00:05:49,110 --> 00:05:50,570
!اصمتي أيّتها العجوز

80
00:05:51,480 --> 00:05:53,650
هذا سيّئ

81
00:05:54,520 --> 00:05:55,530
إلى اللّقاء

82
00:06:03,080 --> 00:06:04,660
إليّ بها

83
00:06:05,390 --> 00:06:07,650
!هيّا. إليّ بها

84
00:06:08,420 --> 00:06:12,890
إذا استطعتُ هزيمته، فسوف أستردّ
زخمَ التّلويح

85
00:06:12,890 --> 00:06:15,780
...كُن حذراً، والتزم بالطّرُق المُستهلَكة

86
00:06:16,660 --> 00:06:18,060
!وأسقطه

87
00:06:22,010 --> 00:06:25,150
الرّمية الأولى هي كُرة سريعة
!خارجيّة، وبالتّالي كُرة

88
00:06:25,980 --> 00:06:28,230
!ممتاز! عين ثاقبة

89
00:06:28,230 --> 00:06:30,060
!لنفعلها يا يوه-تشان

90
00:06:30,310 --> 00:06:31,680
مرّة أُخرى

91
00:06:32,320 --> 00:06:33,730
!كُرة سريعة

92
00:06:35,220 --> 00:06:38,360
!كُرة سريعة داخليّة، خطأ ضربة

93
00:06:38,590 --> 00:06:40,740
يتأخّر في التّلويح

94
00:06:40,740 --> 00:06:43,840
هذا يُثبت كم أنّ تلك الرّميات سريعة

95
00:06:43,840 --> 00:06:46,670
حقيقة رميه اثنتين منها على
...التّوالي تعني

96
00:06:49,560 --> 00:06:52,510
!رمية مُتغيِّرة تُصبح مُنخفضة جدّاً
!إنّها كُرة

97
00:06:52,510 --> 00:06:54,260
!التّعداد هو 1-2

98
00:06:54,970 --> 00:06:57,780
مي-سان مُنفعِل قليلاً

99
00:06:58,680 --> 00:07:01,540
...تحيط به هالةٌ مُميتة بلا شكّ

100
00:07:02,640 --> 00:07:05,600
هذه نظرات قاتل

101
00:07:05,600 --> 00:07:08,300
!كان الفهد يتسلّل خلسة

102
00:07:08,300 --> 00:07:10,310
...حان وقت انتهاز الفُرصة

103
00:07:10,310 --> 00:07:12,420
!اغرس أسنانك في حنجرته

104
00:07:12,420 --> 00:07:13,770
ما المُشكلة؟

105
00:07:14,120 --> 00:07:17,500
ساوامورا وفورويا كلاهما أصبحا مُدهشين

106
00:07:17,500 --> 00:07:19,570
!انتظر رميتك

107
00:07:19,570 --> 00:07:20,940
!كوراموتشي

108
00:07:20,940 --> 00:07:23,670
من الأفضل ألّا أفسد الأجواء هنا

109
00:07:25,710 --> 00:07:27,640
!سوف نُسجِّل

110
00:07:33,000 --> 00:07:35,130
!هذه هي الرّمية المُتباطئة

111
00:07:35,450 --> 00:07:37,230
!إصابتان

112
00:07:37,230 --> 00:07:40,160
!تبّاً، كانت تلك الرّمية لعينة

113
00:07:40,160 --> 00:07:42,340
لكن يمكن القول أيضاً بأنّه اضُطرَّ

114
00:07:42,340 --> 00:07:44,960
...لاستخدام أفضل رمية له قبل الإصابة الثّانية

115
00:07:45,190 --> 00:07:47,750
!اصمد مكانك يا كوراموتشي

116
00:07:51,240 --> 00:07:53,230
!التّعداد هو 2-2

117
00:07:53,230 --> 00:07:57,110
،يبدأ الضّارب الأوّل كوراموتشي في إصابته الأخيرة
!لكنّه ما زال صامداً

118
00:07:57,710 --> 00:08:00,400
هل يستطيع مُجاراة تلك الرّميات أيضاً؟

119
00:08:01,400 --> 00:08:04,380
...أنت أفضل من العام الماضي

120
00:08:04,810 --> 00:08:06,360
!في العِناد على الأقلّ

121
00:08:13,130 --> 00:08:16,090
!لمسَ الرّمية المُتباطئة

122
00:08:16,090 --> 00:08:17,780
!لن يسمح لموقعته في الضّرب تنتهي

123
00:08:17,780 --> 00:08:20,520
!يصمد الضّارب الأوّل كوراموتشي بعِناد

124
00:08:20,520 --> 00:08:22,700
!أجل، يمكنك فعلها

125
00:08:22,700 --> 00:08:25,230
!إنّه يُجاري ناروميا

126
00:08:25,230 --> 00:08:28,190
بئساً، لم تصل إلى أيّ مكان حتّى

127
00:08:28,400 --> 00:08:30,680
إظهار اثنتين منها سيجعله مُتأهّباً

128
00:08:31,320 --> 00:08:33,290
استخدم كُرةً سريعة في الرّمية الأخيرة

129
00:08:33,290 --> 00:08:34,380
لا

130
00:08:34,800 --> 00:08:37,170
!لا مُشكلة. يمكنك إسقاطه

131
00:08:37,490 --> 00:08:39,120
مُحال يا رجل

132
00:08:39,320 --> 00:08:40,640
!مي-سان

133
00:08:40,640 --> 00:08:42,070
!أعلم

134
00:08:42,280 --> 00:08:44,440
إنّه يتجاهل التّحذير

135
00:08:44,440 --> 00:08:47,030
أتعتقد بأنّ ناروميا مغتاظ؟

136
00:08:47,400 --> 00:08:49,360
ارمِ أيّ شيء فحسب

137
00:08:49,700 --> 00:08:51,500
واجعلها مُفاجئة

138
00:08:52,210 --> 00:08:53,810
لا تتعقّبها بالعين

139
00:08:54,220 --> 00:08:56,430
...استشعرها بالجسد

140
00:08:56,890 --> 00:09:00,800
تفاعل مع الخلايا

141
00:09:00,800 --> 00:09:02,510
...هل يعتقد ذلك الغبيّ

142
00:09:02,790 --> 00:09:05,430
!بأنّه مُكافئ لي؟

143
00:09:09,890 --> 00:09:12,330
!إنّه عالية بالنّسبة لسَير

144
00:09:12,870 --> 00:09:15,070
!يصل الضّارب الأوّل كوراموتشي إلى القاعدة

145
00:09:15,790 --> 00:09:17,270
!أجل

146
00:09:17,530 --> 00:09:19,530
!عين ثاقبة يا كوراموتشي

147
00:09:19,530 --> 00:09:22,510
!كان ذلك هائلاً! والآن رُدّ الهجمة

148
00:09:24,360 --> 00:09:27,270
لِسان هذا الرّجل قذر

149
00:09:27,270 --> 00:09:29,790
وحتّى أنّه يُسيئ الردّ على زميله السّينباي

150
00:09:29,790 --> 00:09:32,750
لكنّه مُدافع رائع

151
00:09:32,750 --> 00:09:35,720
وهناك ذلك الوقح في سنَتي

152
00:09:35,720 --> 00:09:38,710
لكنّه ضارب رهيب

153
00:09:38,710 --> 00:09:41,430
—وسينباي الّذي أُشاركه الغرفة

154
00:09:42,090 --> 00:09:43,780
!كوراموتشي

155
00:09:42,830 --> 00:09:44,620
!كوراموتشي-سينباي

156
00:09:44,620 --> 00:09:47,060
!ها نحن أولاء! أحسنت صنعاً

157
00:09:47,810 --> 00:09:51,220
أجل، من المؤكّد أنّني أسبّب لك عقدة

158
00:09:53,730 --> 00:09:56,000
اتبع حُكمك الخاصّ

159
00:09:58,200 --> 00:10:00,930
لم يؤدِّ أي ضربة رقيقة في هذه البطولة

160
00:10:00,930 --> 00:10:02,990
أتعتقد بأنّه سيُحرز ضربة؟

161
00:10:02,990 --> 00:10:05,990
...فُرصة للردّ بعد فقدان المُبادرة الأولى

162
00:10:05,990 --> 00:10:08,410
...يجب التّعامل مع الأمر بحرص، لكن

163
00:10:08,970 --> 00:10:12,300
...الخشونة الّتي يتمتّع بها سيدو

164
00:10:12,300 --> 00:10:14,950
إلى أيّ مدى يمكنها أن توصلهم؟

165
00:10:19,880 --> 00:10:22,250
ناروميا أعسر

166
00:10:22,250 --> 00:10:25,340
حتّى كوراموتشي سيفكِّر مرّتين في الهرب

167
00:10:25,570 --> 00:10:28,670
لقد حُصِدَ في مُباراة إتشيدايسان بالفعل

168
00:10:28,670 --> 00:10:31,000
أتعتقد بأنّه استطاع تخطّي ذلك؟

169
00:10:31,900 --> 00:10:34,700
هذه هي اللّحظة الّتي عليك التّعامل
معها بعناية

170
00:10:34,930 --> 00:10:38,210
قد يكون ذلك مُستحيلاً إذا حظي ببداية جيّدة

171
00:10:38,560 --> 00:10:42,660
لكن تمرّنتُ كثيراً مع كارلوس

172
00:10:43,570 --> 00:10:45,940
،إذا تأخّرتْ بدايته ولو جزء من الثّانية

173
00:10:46,320 --> 00:10:48,130
!فأستطيع إسقاطه

174
00:10:50,000 --> 00:10:52,340
،إذا كانوا مُتأهِّبين حيال سرعة يوه-سان

175
00:10:52,340 --> 00:10:54,210
فسوف نشهد مزيداً من الكُرات السّريعة

176
00:10:58,890 --> 00:11:00,500
!الرّمية الأولى، مُتباطئة

177
00:11:00,500 --> 00:11:02,070
!تلويحة وإخفاق

178
00:11:02,790 --> 00:11:05,310
لا تلامُس؟

179
00:11:05,310 --> 00:11:07,630
كنتُ أتمنّى لعِباً مُزدوَجاً

180
00:11:08,550 --> 00:11:10,210
الوغد

181
00:11:10,210 --> 00:11:13,720
كان يعلم بأنّني لن أجري في الرّمية الأولى
ورمى رمية بطيئة

182
00:11:14,110 --> 00:11:15,840
لا مانع لديّ

183
00:11:15,840 --> 00:11:20,140
توقّعتُ بأنّ إضعاف ثُنائي رامٍ وماسك
مثلكما يتطلّب أكثر من ذلك

184
00:11:24,360 --> 00:11:27,080
ستفعلها، أليس كذلك يا يوه-سان؟

185
00:11:38,220 --> 00:11:39,670
اثبت مكانك أيّها الفاشل

186
00:11:42,080 --> 00:11:44,830
سأراقب يوه-سان من طرف عيني

187
00:11:45,970 --> 00:11:47,840
وأنتظر رميةً جيّدة

188
00:11:56,540 --> 00:11:57,470
!لقد غادر

189
00:11:58,490 --> 00:11:59,700
!بجدّية؟

190
00:11:59,700 --> 00:12:00,940
!بداية جيّدة

191
00:12:01,700 --> 00:12:02,660
!نلتُ منه

192
00:12:07,250 --> 00:12:09,700
!إنّه بأمان

193
00:12:10,200 --> 00:12:13,740
!سرعة رهيبة! شجاعة رهيبة

194
00:12:14,180 --> 00:12:17,720
!من دون خروج، هناك رجل في القاعدة الثّانية
!سجّل سيدو نقطة

195
00:12:18,020 --> 00:12:20,670
!تشي-ساما، الإله تشي، الملك تشي

196
00:12:20,670 --> 00:12:23,630
!فعلَها! يوه-تشان

197
00:12:23,850 --> 00:12:27,340
هناك كثير من الجلبة على سرقة صغيرة واحدة

198
00:12:27,650 --> 00:12:31,550
هل توقّعَ بداية كوراموتشي وقرّر ألّا يُلوّح؟

199
00:12:31,550 --> 00:12:35,140
من الصّعب فعل ذلك، حتّى لو كنت تتوقّع ذلك

200
00:12:35,530 --> 00:12:38,200
...كان تعاونك الجماعيّ مُختلفاً عن تعاوني الجماعيّ

201
00:12:38,740 --> 00:12:41,120
أرِني كيف يا هارويتشي

202
00:12:46,000 --> 00:12:48,330
لاعبو خارج الميدان، ادخلوا إلى نِطاق الرّمي

203
00:12:49,690 --> 00:12:51,970
يلعبون قربَ القاعدة الرّئيسيّة

204
00:12:52,460 --> 00:12:56,240
لكن استبعاد كُرة طويلة سيرتدّ عليك سلباً

205
00:12:57,320 --> 00:12:59,490
أليس كذلك يا هارويتشي؟

206
00:12:59,870 --> 00:13:02,660
لنرَ من المُتخلِّف هنا

207
00:13:03,480 --> 00:13:05,080
!اضربها إن استطعت

208
00:13:06,620 --> 00:13:08,650
هل تُسايرني؟

209
00:13:11,500 --> 00:13:13,440
لا تتبعني بعد الآن

210
00:13:14,120 --> 00:13:17,980
شقّ دربك بنفسك يا هارويتشي

211
00:13:19,490 --> 00:13:21,740
تعلّق بأي كُرة تراها

212
00:13:21,740 --> 00:13:23,500
إعداد الطّاولة هو كُلّ ما تُجيده

213
00:13:23,500 --> 00:13:25,310
تستطيع مُقدِّمة ترتيب الضّاربين
إحراز نقاط أيضاً

214
00:13:25,890 --> 00:13:28,290
هذا ما أريده منكما

215
00:13:28,980 --> 00:13:33,030
استخدم مِضربك لتصبح الصّاروخ
المُعزِّز لتشكيلة سيدو

216
00:13:43,490 --> 00:13:48,180
أرضيّة كوميناتو إلى القاعدة الثّانية
!ترسل كوراموتشي إلى الثّالثة

217
00:13:50,400 --> 00:13:52,880
!أجل، أجل! هذه مضمونة

218
00:13:52,880 --> 00:13:54,350
!تقدُّم ممتاز

219
00:13:54,590 --> 00:13:56,910
،كانت النّتيجة هي الحدّ الأدنى

220
00:13:56,910 --> 00:13:59,560
لكن كان إصابة الرّمية المُتباطئة أمراً هائلاً

221
00:14:00,060 --> 00:14:01,320
...في المرّة المُقبلة

222
00:14:02,120 --> 00:14:04,490
خروج واحد، وراكض في الثّالثة

223
00:14:04,490 --> 00:14:07,030
قلب ترتيب ضاربي سيدو هم التّالون

224
00:14:07,350 --> 00:14:12,110
لاعب الحفرة 3 كينجيرو شيراسو، الّذي
أحرزَ مُزدوجة في موقعته السّابقة في الضّرب

225
00:14:13,070 --> 00:14:14,870
تولَّ الباقي

226
00:14:15,680 --> 00:14:18,160
!هيّا بنا يا شيراسو

227
00:14:18,160 --> 00:14:20,880
هيسّاتسو شيغوتونين

228
00:14:18,410 --> 00:14:20,220
!إنّها لحظك

229
00:14:20,860 --> 00:14:24,200
تشتعل المُباراة حالما تُضاف
!نقطة في اللّائحة

230
00:14:24,200 --> 00:14:27,150
يستطيع كوراموتشي إحراز نقطة
!من أيّ كرة تصطدم في الأرض

231
00:14:27,150 --> 00:14:28,530
!بوسعه تجربة حشر أيضاً

232
00:14:29,300 --> 00:14:31,520
!افعلها يا شيراسو

233
00:14:31,770 --> 00:14:34,650
أيّ نوع من الاحتكاك سيجعلني أحرز نقطة

234
00:14:34,650 --> 00:14:39,040
مُجرّد وجود كوراموتشي في القاعدة الثّالثة
سوف يُنهِك ثنائي الرّامي والماسك

235
00:14:39,400 --> 00:14:41,380
!انتظر رميتك يا شيراسو

236
00:14:45,930 --> 00:14:48,530
لاعبو إيناشيرو الميدانيّون يُقاومون

237
00:14:48,530 --> 00:14:50,590
!إنّهم عازمون على منع إحراز نقطة

238
00:14:51,160 --> 00:14:55,180
في موقعته الأخيرة في الضّرب، ضربَ
مُنزلِقة نحو الميدان الأيسر

239
00:14:55,840 --> 00:14:58,280
كيف نجعله يتنبّه للرّميات الدّاخلية؟

240
00:14:58,870 --> 00:15:01,120
أنا مُتوتّر للغاية

241
00:15:01,440 --> 00:15:03,050
لنُلقّنه درساً قاسياً

242
00:15:04,380 --> 00:15:05,840
خريف عامنا الأوّل

243
00:15:06,800 --> 00:15:09,640
تمّ اختيارهما كبادئين باكراً

244
00:15:09,950 --> 00:15:11,660
بقيا في ذهني منذ ذلك الحين

245
00:15:13,550 --> 00:15:15,650
لم أرِد أن أخسر

246
00:15:18,610 --> 00:15:21,390
ما زلت تفعل ذلك يا كينجيرو؟

247
00:15:21,730 --> 00:15:24,060
هوّن على نفسك

248
00:15:24,060 --> 00:15:26,240
عاد الآخرون إلى المنزل بالفعل

249
00:15:26,610 --> 00:15:29,340
لا أستطيع البقاء للأبد أيضاً

250
00:15:30,120 --> 00:15:33,030
لا يجدر بك أن تتّخذ الرّياضة بهذه الجدّية

251
00:15:36,240 --> 00:15:38,740
حرَم سيدو سبيريت

252
00:15:38,740 --> 00:15:41,330
ما زالوا يفعلون ذلك؟

253
00:15:41,330 --> 00:15:43,460
أجل. هذا رائع

254
00:15:43,700 --> 00:15:46,980
هذا المكان رهيبٌ حقّاً

255
00:15:47,730 --> 00:15:49,930
أتعتقدون بأنّنا نستطيع مُجاراتهم؟

256
00:15:50,790 --> 00:15:52,730
...في الكمّية الّتي أكلتُها

257
00:15:55,840 --> 00:15:57,660
...في تمرين التّلويح الّذي مارستُه

258
00:16:01,230 --> 00:16:02,960
...في الأثقال الّتي رفعتُها

259
00:16:06,120 --> 00:16:09,510
لم أُرِد الخسارة. أمام أحد

260
00:16:10,110 --> 00:16:12,660
...تبدو هادئاً جدّاً بوقوفك هناك

261
00:16:13,110 --> 00:16:15,060
!سأعطيك شيئاً يجعلك تتجهّم

262
00:16:23,450 --> 00:16:25,670
!كُرة ميّتة

263
00:16:25,950 --> 00:16:28,760
!ضربة بواسطة الرّمي

264
00:16:29,890 --> 00:16:32,380
أصابَ ظهره؟ هل هو بخير؟

265
00:16:35,640 --> 00:16:36,710
!تبّاً

266
00:16:41,400 --> 00:16:43,870
يتوجّه شيراسو بصمت نحو القاعدة الأولى

267
00:16:43,870 --> 00:16:45,450
!يبدو أنّه بخير

268
00:16:46,070 --> 00:16:47,690
...شيراسو

269
00:16:47,690 --> 00:16:49,660
...شيراسو-سينباي

270
00:16:50,050 --> 00:16:51,540
!غاضب

271
00:16:51,860 --> 00:16:56,230
!إلى هذا الحدّ كان مُتحمّساً! أرادَ تحقيق ضربة

272
00:16:56,230 --> 00:16:58,110
أهذا ما تعتقده؟

273
00:16:58,110 --> 00:17:01,570
لو لم أضربه، لكان قد ضربَ الكُرة؟

274
00:17:01,570 --> 00:17:02,820
...مي-سان

275
00:17:04,750 --> 00:17:06,490
أوقف اللّعب رجاء

276
00:17:06,800 --> 00:17:09,000
!خروج واحد مع راكضين في الزّوايا

277
00:17:09,000 --> 00:17:10,470
!اعفوني من اجتماع التلّة

278
00:17:10,470 --> 00:17:13,250
!الماسك تادانو يطلب إيقاف اللّعب

279
00:17:13,250 --> 00:17:15,330
من الواضح أنّه مضطرب

280
00:17:16,260 --> 00:17:19,130
،النّصف الأوّل من الشّوط السّادس
...بوجود سيدو في القاعدة الرّئيسيّة

281
00:17:19,130 --> 00:17:21,000
احسم هذا الأمر يا قائد

282
00:17:21,000 --> 00:17:25,070
!التّالي هو لاعب الحفرة 4 لسيدو، كازويا ميوكي

283
00:17:25,710 --> 00:17:29,420
شخصيّة عنيدة حتّى الماسِك
لا يستطيع التحكُّم به

284
00:17:30,000 --> 00:17:34,180
هذه هي قوّة مي، ونقطة ضعفه الوحيدة

285
00:17:35,570 --> 00:17:36,900
سأحقّق إصابة من خلال ذلك

286
00:17:37,950 --> 00:17:39,520
مي-سان، مي-سان

287
00:17:39,520 --> 00:17:40,640
هل كنت تعلم هذا؟

288
00:17:40,990 --> 00:17:44,790
الوضعيّة الّتي تتّخذها قطّة في الهواء
...وهي تهوي

289
00:17:45,450 --> 00:17:48,120
!تُدعى بالتواء القطّة

290
00:17:48,120 --> 00:17:49,660
!أنت تكذب

291
00:17:49,660 --> 00:17:51,620
!صدّقني

292
00:17:51,620 --> 00:17:53,500
!سأريك صفحة الويكي لاحقاً

293
00:17:53,500 --> 00:17:55,580
!كانت دُعاباتك سخيفة مُؤخّراً

294
00:17:55,580 --> 00:17:58,520
!أريد شيئاً أكثر طرافة

295
00:17:58,520 --> 00:18:01,050
لديّ دُعابة رائعة وفّرتُها للمرّة المُقبلة

296
00:18:01,050 --> 00:18:03,270
!إذاً اروِها لي! فوراً

297
00:18:04,610 --> 00:18:07,770
لا تُحاول تهدئته بهذه السّرعة

298
00:18:08,130 --> 00:18:11,020
دور الرّجل المُنظِّف بخروج واحد وراكضين

299
00:18:11,020 --> 00:18:13,970
!آمل أن يتمكّنا من تحقيق التّعادل على الأقلّ

300
00:18:14,340 --> 00:18:18,830
،بشكل مُماثل، إذا لم يستطع سيدو التّسجيل هنا
فسوف يهلك على ما يبدو

301
00:18:20,430 --> 00:18:21,900
التواء قطّة؟

302
00:18:22,140 --> 00:18:25,950
لم أخبر مي-سان، لكن ما زلنا
في مُنتصف المُباراة

303
00:18:26,290 --> 00:18:27,960
نقطة واحدة لا تهمّ

304
00:18:28,440 --> 00:18:29,400
...لكن

305
00:18:29,890 --> 00:18:32,630
،إذا استطاع إسقاط هذا الرّجل الآن

306
00:18:33,190 --> 00:18:35,230
فذلك سيُحوّل المُباراة إلى صالحنا

307
00:18:36,590 --> 00:18:38,550
لحن لوبن الثّالث

308
00:18:39,360 --> 00:18:42,580
مي-سان هو ماسكٌ يستطيع فعلها

309
00:18:43,130 --> 00:18:45,720
...سأحقّق إصابة ثلاثيّة

310
00:18:45,720 --> 00:18:47,720
!لكن أُفضِّل لعِباً مُزدوَجاً

311
00:18:48,190 --> 00:18:49,800
دعه يمسّها

312
00:18:49,800 --> 00:18:51,920
نحن نوفّر لك التّغطية

313
00:18:55,240 --> 00:18:57,060
لاعب الارتكاز عند القاعدة الثّانية

314
00:18:57,430 --> 00:18:59,190
يتناوب لاعبو الميدان في مُنتصف الطّريق

315
00:18:59,480 --> 00:19:01,040
خطّ القاعدة الأولى قد أُغلِق

316
00:19:01,270 --> 00:19:06,220
،إذا كانوا يسعون وراء لعِب مُزدوج
فسنشهد مزيداً من الرّميات السّاقطة

317
00:19:07,010 --> 00:19:10,450
سأتجاهل الكُرات المُنخفضة حتّى
أبلغ إصابتين

318
00:19:11,030 --> 00:19:13,330
!خروج واحد، وراكضين في الزّوايا

319
00:19:13,710 --> 00:19:15,710
!الرّمية الأولى الحاسمة

320
00:19:19,080 --> 00:19:21,750
!إنّها مُنخفضة وداخليّة بالتّالي كُرة

321
00:19:22,380 --> 00:19:26,850
!بُعيد أن ضربَ شيراسو، يرمي قاطِعة داخليّة

322
00:19:26,850 --> 00:19:28,800
!لا ندم على الإطلاق

323
00:19:28,800 --> 00:19:31,680
يبدو أنّ ذلك قد صدمَك، صحيح؟

324
00:19:32,170 --> 00:19:34,380
لم أتوقّع ذلك حتماً

325
00:19:34,970 --> 00:19:36,550
...في هذه الحالة

326
00:19:38,230 --> 00:19:40,580
!الرّمية الثّانية، سريعة نحو الخارج

327
00:19:40,580 --> 00:19:41,690
!خطأ ضربة

328
00:19:41,690 --> 00:19:44,440
أجل، إنّه على المحكّ

329
00:19:45,660 --> 00:19:47,620
أرسل التّالية ضمن نفس المسار

330
00:19:51,560 --> 00:19:55,740
منذ لقائنا أوّل مرّة، أثرتَ اهتمامي

331
00:20:01,670 --> 00:20:06,910
كنتَ الضّارب الّذي لم يُلوّح بوحشيّة

332
00:20:06,910 --> 00:20:08,860
من الرّمية الأولى

333
00:20:09,470 --> 00:20:12,490
لم تُلوّح نحو هذه أثناء موقعتك
...السّابقة في الضّرب

334
00:20:12,490 --> 00:20:14,110
لذا لا يمكنك ضربها، صحيح؟

335
00:20:19,800 --> 00:20:20,860
!أنت

336
00:20:21,140 --> 00:20:23,080
...تلك الرّمية الأولى في موقعتك الثّالثة في الضّرب

337
00:20:23,080 --> 00:20:24,720
هل كنتَ تتمنّاها؟

338
00:20:24,720 --> 00:20:28,060
لم أرَ شخصاً يردّ رميةً بتلك الأناقة
منذ زمن بعيد

339
00:20:28,280 --> 00:20:32,700
.سألعب معك ثانية يوماً ما
لن أخبرك بنقطة ضعفك

340
00:20:32,700 --> 00:20:35,050
نقطة ضعفي؟! ماذا تقصد؟

341
00:20:35,250 --> 00:20:39,180
!لم ننتهِ! عُد

342
00:20:39,480 --> 00:20:43,010
كان ذلك اليوم الّذي التقيتُ فيه بكازويا أوّل مرّة

343
00:20:49,340 --> 00:20:53,160
!يرى شيراسو الكُرة الطّليقة ويحرز نقطة

344
00:20:53,160 --> 00:20:56,470
لا يُكلِّف نفسه بالرّمي! ينتقل
!الرّاكض إلى القاعدة الثّانية

345
00:20:56,470 --> 00:20:57,950
!أجل

346
00:20:57,950 --> 00:20:59,440
!شيراسو، أحسنت

347
00:20:59,440 --> 00:21:01,770
!لا آمال بلعِب مُزدوج الآن

348
00:21:01,770 --> 00:21:03,550
!لكن القاعدة الأولى مُتاحة

349
00:21:03,550 --> 00:21:06,560
!مُحال أن يُسيّره ناروميا

350
00:21:07,160 --> 00:21:08,490
أنا آسف

351
00:21:08,490 --> 00:21:12,950
لا مُشكلة. كُلّ ما عليّ هو ألّا أدعه
يمسّ الكُرة، صحيح؟

352
00:21:13,310 --> 00:21:15,630
!يقترب لاعبو الميدان أكثر

353
00:21:16,200 --> 00:21:18,180
أسقطهم الواحد تِلو الآخر إذاً؟

354
00:21:18,460 --> 00:21:20,190
تقليص النّزيف

355
00:21:20,830 --> 00:21:22,950
راقب الرّاكض في القاعدة الثّانية

356
00:21:23,540 --> 00:21:26,290
ابقَ جِوار الأسود

357
00:21:26,290 --> 00:21:31,090
،حتّى لو أدّى ذلك إلى سَير
سيقبل ناروميا ذلك

358
00:21:40,340 --> 00:21:41,900
!اضربها بقوّة

359
00:21:42,360 --> 00:21:43,970
!هذا هو عملُك

360
00:21:44,320 --> 00:21:47,780
!المُواجهة النّاريّة! إنّها ذروة دراميّة للقائد

361
00:23:26,190 --> 00:23:30,180
الحلقة القادمة من اللّاعب الأوّل الماسيّ
-الفصل 2 -الموسم الثّاني

362
00:23:30,490 --> 00:23:32,170
"الفريق الّذي أريد أن أكون فيه"

363
00:23:31,010 --> 00:23:36,980
الحلقة القادمة

364
00:23:31,010 --> 00:23:36,980
