1
00:00:05,270 --> 00:00:06,980
ربّما لم أحرّك ساكنًا

2
00:00:07,410 --> 00:00:10,870
.لأنّ الخوف من العواقب جعلني أتردّد

3
00:00:12,720 --> 00:00:15,490
.لكنّني اكتفيت من العيش بتلك الطّريقة

4
00:00:17,390 --> 00:00:20,280
.هذان الشّيطانان هما كلّ ما أستطيع أن أعيره لك

5
00:00:20,280 --> 00:00:23,170
.فأنا الوحيدة القادرة على السّيطرة على هذا

6
00:00:23,170 --> 00:00:24,000
ما الّذي ستفعله؟

7
00:00:24,690 --> 00:00:26,270
.سأساعد كاغاري

8
00:00:26,270 --> 00:00:27,540
.سأفعل كلّ ما بيدي

9
00:00:28,280 --> 00:00:29,380
.فهمت

10
00:00:30,160 --> 00:00:31,150
أين كاغاري؟

11
00:00:31,840 --> 00:00:32,760
.جيّد، إنّي أراها

12
00:00:34,570 --> 00:00:38,770
.أتساءل أيّ شعورٍ انتابها وهي تحدّق بتلك المدينة

13
00:00:39,490 --> 00:00:43,020
ما هي "الذّكريات الجميلة" يا ترى؟

14
00:00:44,270 --> 00:00:45,270
.سأكتشف ذلك بنفسي

15
00:00:46,320 --> 00:00:49,320
.أنا تابع كاغاري، منارتي الهادية

16
00:02:29,550 --> 00:02:31,130
.سيفي هذا بالغرض

17
00:02:31,130 --> 00:02:33,510
.كما لو أنّي ألعب لعبة تقمّص أدوارٍ بعد توقّفٍ طويل

18
00:02:35,550 --> 00:02:37,640
يتمّ اصطيّاد شياطين الاستطلاع؟

19
00:02:38,100 --> 00:02:41,270
.إن كنتم نعرف المكان ، فأرسلوا فريق تحقيق

20
00:02:41,640 --> 00:02:42,390
.حاضر

21
00:02:43,100 --> 00:02:44,390
.اذهب أيضًا

22
00:02:45,390 --> 00:02:47,560
.ستبدأ المرحلة الثّانية قريبًا

23
00:02:57,780 --> 00:02:59,530
لم تجدوا شيئًا؟

24
00:03:00,120 --> 00:03:02,160
.سأعيّن المزيد من الرّجال

25
00:03:02,660 --> 00:03:04,830
.لا شكّ أنّ شيئًا ما هناك

26
00:03:04,830 --> 00:03:06,290
...شيءٌ ما

27
00:03:27,140 --> 00:03:28,190
.مزّقوهم إربًا إربًا

28
00:03:28,770 --> 00:03:30,020
.لا تتركا منهم قطعةً واحدة

29
00:03:32,190 --> 00:03:35,530
.عُثر على جثث فرقة البحث المفقودة

30
00:03:35,860 --> 00:03:37,660
أيعقل أنّها فعلة المفتاح؟

31
00:03:39,030 --> 00:03:43,040
!أرسلوا جميع الفرق الّتي لدينا إلى هناك

32
00:04:06,680 --> 00:04:08,020
.آسفٌ يا كاغاري

33
00:04:08,020 --> 00:04:09,940
.أحتاجكِ لتكوني طعمي حاليًّا

34
00:04:11,190 --> 00:04:11,770
ألم يحن الوقت؟

35
00:04:15,940 --> 00:04:17,240
!ها هم

36
00:04:17,240 --> 00:04:17,900
!حسنًا، عليكما بهم

37
00:04:22,370 --> 00:04:24,910
.تخلّص من المستحضر وستختفي شياطينه

38
00:04:26,950 --> 00:04:29,580
.انتهى عملي هنا لهذه اللّيلة

39
00:04:29,580 --> 00:04:32,420
.كلّ ما تبقّى هو الخوض في كابوسٍ آخر

40
00:04:33,000 --> 00:04:36,670
.مع ذلك، عليّ أن أمضي قدمًا

41
00:04:37,130 --> 00:04:41,010
".مارتيل تُظهر علامات الاستعداد لعمليّةٍ واسعة النّطاق"

42
00:04:45,680 --> 00:04:47,220
هل هذا صحيح؟

43
00:04:47,220 --> 00:04:47,890
.نعم

44
00:04:48,810 --> 00:04:50,440
.سنلتقي في وقتٍ لاحق

45
00:04:56,320 --> 00:04:58,360
.هذا أونيشي. كان ضمن فريق ميكوني

46
00:04:58,360 --> 00:04:59,280
أتتذكّره؟

47
00:04:59,820 --> 00:05:01,740
.نعم، نوعًا ما

48
00:05:01,740 --> 00:05:03,160
.أهلًا، لم أرك منذ وقتٍ طويل

49
00:05:03,160 --> 00:05:04,530
أنت تينّوجي، صحيح؟

50
00:05:04,530 --> 00:05:06,910
.سمعت أنّك اكتسبت خبرةً قتاليّة كبيرة خارج البلاد

51
00:05:07,200 --> 00:05:08,120
.أجل

52
00:05:08,120 --> 00:05:09,540
!هذا رائع

53
00:05:09,540 --> 00:05:11,790
.تبدو أقوى بكثيرٍ الآن

54
00:05:12,040 --> 00:05:16,210
.إذًا فهو صاحب العينين اللّتان تستطيعان رؤية كاغاري

55
00:05:12,790 --> 00:05:14,790
.مسرورٌ بالعمل معكم

56
00:05:21,760 --> 00:05:23,590
من هؤلاء الأشخاص؟

57
00:05:23,590 --> 00:05:25,050
.إنّهنّ المنشدات

58
00:05:25,510 --> 00:05:27,810
.نجمات مراسيم مهرجان الحصاد

59
00:05:34,980 --> 00:05:36,940
.سيشرع فريق إماميا بالتّحقيق

60
00:05:39,490 --> 00:05:40,440
ما الخطب؟

61
00:05:40,440 --> 00:05:43,530
.لا، أعتقد أنّي رأيت شيئًا ما هناك للتّو

62
00:05:43,530 --> 00:05:44,370
ماذا؟

63
00:05:44,370 --> 00:05:46,490
!هناك! متطرّفو غايّا

64
00:05:46,490 --> 00:05:47,490
!إنّهم الصّيادون

65
00:05:48,040 --> 00:05:50,950
!عُد إلى المقرّ وأبلغهم بالوضع واطلب الدّعم أيضًا

66
00:05:51,290 --> 00:05:52,080
.حاضر

67
00:05:52,960 --> 00:05:56,340
.شياطين الاستكشاف ليست ندًّا لهم

68
00:05:56,340 --> 00:05:58,460
.فوز الغارديان حتميّ هذه المرّة

69
00:05:59,630 --> 00:06:00,920
.ب36

70
00:06:02,630 --> 00:06:04,010
.انتقلوا إلى ب37

71
00:06:04,010 --> 00:06:05,220
ب37؟

72
00:06:05,890 --> 00:06:07,600
...مهلًا، هناك حيث

73
00:06:07,930 --> 00:06:10,100
!لقد رصدت المفتاح

74
00:06:10,430 --> 00:06:12,100
!ذلك اللّعين أونيشي

75
00:06:12,100 --> 00:06:15,230
أيمكنه استشعار كاغاري من تلك المسافة البعيدة؟

76
00:06:16,310 --> 00:06:17,940
ماذا بوسعي أن أفعل حتّى لو ذهبت إلى هناك؟

77
00:06:17,940 --> 00:06:20,230
!إنّهم بشرٌ خارقون عديدون

78
00:06:20,740 --> 00:06:22,030
بةالكتا لا تعد

79
00:06:20,740 --> 00:06:22,740
أعد الكتابة

80
00:06:28,870 --> 00:06:30,990
!جيّد، أستطيع اللّحاق بهم الآن

81
00:06:40,210 --> 00:06:42,710
أليس هذا هو الشّيطان الّذي قتل ميكوني؟

82
00:06:51,220 --> 00:06:52,470
أهذا أنت يا تينّوجي؟

83
00:06:53,020 --> 00:06:54,600
.سأستدعي المساعدة في الحال

84
00:06:54,600 --> 00:06:57,020
.انس ذلك. ابحث عن أونيشي

85
00:06:57,020 --> 00:06:58,900
.لقد وجده

86
00:06:58,900 --> 00:07:00,820
.يجب أن نقتله مهما كلّف الأمر

87
00:07:01,280 --> 00:07:02,650
.اذهب

88
00:07:02,650 --> 00:07:05,200
.أستطيع الاعتناء بنفسي

89
00:07:17,330 --> 00:07:18,540
.أونيشي

90
00:07:18,540 --> 00:07:19,540
تينّوجي؟

91
00:07:19,540 --> 00:07:21,090
.من الجيّد أنّك هنا

92
00:07:21,750 --> 00:07:24,090
.خُضنا قتالًا مع المستحضرين

93
00:07:24,090 --> 00:07:25,170
.كانوا أقويّاء

94
00:07:25,170 --> 00:07:26,930
.لقد نالوا من الجميع

95
00:07:26,930 --> 00:07:27,970
مستحضرون؟

96
00:07:28,590 --> 00:07:29,850
.إنّهم يدافعون عن المفتاح

97
00:07:30,390 --> 00:07:31,510
كم عددهم؟

98
00:07:31,510 --> 00:07:33,100
.ثلاثة شياطين

99
00:07:33,100 --> 00:07:34,980
،قضيت على أحدهم

100
00:07:35,430 --> 00:07:38,350
...لكن الاثنان الآخران... إنّهما

101
00:07:41,570 --> 00:07:44,030
...تـ-تيـ... ـنّو

102
00:07:51,580 --> 00:07:54,910
هل أرسلتِ شياطينكِ خلفهم؟

103
00:07:54,910 --> 00:07:56,410
.نـ-نعم

104
00:07:56,830 --> 00:08:00,170
.توقّعت أنّكِ ستقدمين على شيءٍ طائشٍ كهذا

105
00:08:01,000 --> 00:08:02,540
...لكن أنا

106
00:08:02,790 --> 00:08:06,420
!لستِ ملزمةً على خوض هذه الحرب

107
00:08:11,760 --> 00:08:12,550
أين كاغاري؟

108
00:08:17,390 --> 00:08:19,060
.تخلّصت من عيناي الغارديان

109
00:08:19,060 --> 00:08:22,980
.ينبغي ألّا يستطيع مستحضرو غايّا التصرّف في الوقت الرّاهن

110
00:08:33,910 --> 00:08:35,450
هل هذا أثرٌ جانبيّ لإعادة الكتابة؟

111
00:08:39,620 --> 00:08:40,460
كاغاري؟

112
00:08:44,460 --> 00:08:45,340
!كاغاري

113
00:08:47,880 --> 00:08:49,170
!هل أنتِ بخير؟

114
00:08:49,170 --> 00:08:50,180
!سُحقًا

115
00:08:50,180 --> 00:08:51,590
...كـ-كـ

116
00:08:51,890 --> 00:08:52,720
!كاغاري

117
00:09:01,650 --> 00:09:03,150
...كوتارو

118
00:09:05,150 --> 00:09:08,110
.آسفٌ على استخدامكِ كطعم

119
00:09:17,870 --> 00:09:20,790
إذًا فقد فشلت في العثور على المفتاح؟

120
00:09:20,790 --> 00:09:21,620
.نعم

121
00:09:22,710 --> 00:09:23,750
ما بال يدك تلك؟

122
00:09:24,040 --> 00:09:26,500
.تأذّت قليلًا

123
00:09:50,240 --> 00:09:51,070
ما الّذي يحدث؟

124
00:10:02,750 --> 00:10:04,580
!لا تستخفّوا بنا أيّها الغارديان

125
00:10:08,800 --> 00:10:10,210
.يا إلهي

126
00:10:10,760 --> 00:10:13,180
.يبدو أنّكم جريئون حقًّا

127
00:10:14,760 --> 00:10:15,470
...والآن

128
00:10:16,050 --> 00:10:17,720
هلّا أتيت معنا؟

129
00:10:24,940 --> 00:10:26,810
.دعوني أحذّركم مقدّمًا

130
00:10:26,810 --> 00:10:30,480
.إذا حدث و اختفيت، فإنّ مارتيل ستخرج عن السّيطرة

131
00:10:31,110 --> 00:10:35,110
.لقد أطلقتم العنان لذلك الوحش

132
00:10:36,870 --> 00:10:38,160
...أ-أنت

133
00:10:41,620 --> 00:10:45,670
.يبدو أنّي أسأت الظّن بأنّهم يمتلكون المفتاح

134
00:10:46,250 --> 00:10:48,170
.يجب أن نرسل المزيد من الرّجال للبحث

135
00:10:50,840 --> 00:10:54,340
.الصّراع يحتدم يومًا بعد يوم

136
00:10:54,340 --> 00:10:56,430
...لا وقت

137
00:10:56,930 --> 00:10:58,010
كاغاري؟

138
00:10:58,010 --> 00:11:00,470
...سيفوت... الأوان

139
00:11:01,140 --> 00:11:05,560
.فقدت كاغاري قدرتها على ربط الكلمات منذ ذلك اليوم

140
00:11:05,560 --> 00:11:06,850
.أسرع

141
00:11:06,850 --> 00:11:07,940
.يجب الإسراع

142
00:11:08,270 --> 00:11:09,560
.أعلم

143
00:11:09,560 --> 00:11:11,730
.لكن المكان هناك خطيرٌ حاليًّا

144
00:11:11,730 --> 00:11:13,690
.الجميع يبحثون عنك

145
00:11:13,690 --> 00:11:15,320
...محزن

146
00:11:15,320 --> 00:11:17,110
...محزنٌ جدًّا

147
00:11:17,110 --> 00:11:19,320
ما رأيكِ بأن نشاهد التّلفاز؟

148
00:11:19,700 --> 00:11:25,710
.اكتُشف كوكبٌ يبعد 18 سنةً ضوئية يحوي الماء وغلافًا جوّيًّا مثل الأرض

149
00:11:25,710 --> 00:11:26,580
كوكب؟

150
00:11:26,580 --> 00:11:30,340
...فريق أبحاث ناسا يقوم حاليًّا

151
00:11:28,000 --> 00:11:29,580
...كوكب

152
00:11:29,580 --> 00:11:30,340
.ماء

153
00:11:31,000 --> 00:11:32,960
.تسمى كواكب شبيهة بالأرض

154
00:11:32,960 --> 00:11:34,760
.كما أنّها قريبة

155
00:11:34,760 --> 00:11:37,800
.ما يقرب 20 إلى 30 سنة ضوئيّة من هنا

156
00:11:37,800 --> 00:11:39,090
.اذهب

157
00:11:39,090 --> 00:11:40,800
.مستحيل

158
00:11:40,800 --> 00:11:41,640
.قريب

159
00:11:41,640 --> 00:11:43,720
.قصدت ذلك مقارنةً بالخيال العلمي

160
00:11:43,720 --> 00:11:45,350
.ليس وكأنّنا نملك صواريخ قادرة على الذّهاب إلى هناك

161
00:11:45,350 --> 00:11:46,390
.شراء

162
00:11:46,390 --> 00:11:47,480
.تبضّع

163
00:11:47,480 --> 00:11:48,850
!كما لو أنّ ذلك ممكن

164
00:11:48,850 --> 00:11:49,980
.على الإنترنت

165
00:11:49,980 --> 00:11:51,150
.لا تباع

166
00:11:52,360 --> 00:11:56,070
.على أيٍّ، قد يتمكّن البشر من الذّهاب يومًا ما

167
00:11:56,070 --> 00:11:58,360
.مسافرين عبر سفينةٍ فضائيّة

168
00:11:59,910 --> 00:12:01,580
ما-ما الأمر؟

169
00:12:01,580 --> 00:12:03,200
.أكمل من فضلك

170
00:12:03,200 --> 00:12:06,710
.لكن الهجرة إلى كوكبٍ آخر مهمّةٌ عسيرة

171
00:12:06,710 --> 00:12:08,870
.قد يستغرق ذلك آلاف السّنين

172
00:12:08,870 --> 00:12:10,330
.أسرع

173
00:12:10,330 --> 00:12:12,380
.أخبرتك أنّ ذلك مستحيلٌ حاليًّا

174
00:12:12,790 --> 00:12:15,840
.لكنّني سأجلب لكِ ذكرياتٍ جميلة عوضًا عن ذلك

175
00:12:18,720 --> 00:12:20,720
.غدًا هو عشيّة مهرجان الحصاد

176
00:12:20,720 --> 00:12:23,970
.قوّات الطّرفين تتصادم، وأصبحت الغابة ساحة حرب

177
00:12:23,970 --> 00:12:26,020
.ولم نجد المفتاح حتّى الآن

178
00:12:26,560 --> 00:12:28,100
هل شفيّت جروحك؟

179
00:12:28,100 --> 00:12:31,940
.إذا انسحبت بسبب ذلك، فلا أستحقّ أن أكون بشريًّا خارقًا

180
00:12:31,940 --> 00:12:32,610
ماذا عنك؟

181
00:12:32,610 --> 00:12:34,400
ألم تُشفَ يدك بعد؟

182
00:12:34,400 --> 00:12:35,030
.لا

183
00:12:35,320 --> 00:12:36,650
...بالمناسبة

184
00:12:37,150 --> 00:12:37,940
متى رُزقتِ بأطفال؟

185
00:12:37,940 --> 00:12:39,610
.لم أفعل

186
00:12:39,610 --> 00:12:42,990
.هاتان ناكاتسو شيزورو-تشان وكونوهانا لوسيا-تشان

187
00:12:42,990 --> 00:12:44,410
.بشريّتان خارقتان مثلنا

188
00:12:45,200 --> 00:12:48,790
.أريد أن أكون مدرّسةً هنا يومًا ما

189
00:12:48,790 --> 00:12:50,040
ماذا؟ في ثانويّة كازا؟

190
00:12:50,370 --> 00:12:53,710
.الغارديان تدرس مشروعًا لإرسال تلاميذ إلى هناك

191
00:12:53,710 --> 00:12:56,130
.وسأكون هناك لمساندتهم

192
00:12:56,130 --> 00:12:57,800
...إذًا هاتان

193
00:12:57,800 --> 00:12:59,800
.أجل. إنّهما مرشّحتان

194
00:12:59,800 --> 00:13:02,890
.تضعين رقعة عينٍ أنيقة يا آنستي الصّغيرة

195
00:13:03,550 --> 00:13:04,640
.وهذه تأكل طعمًا صحيًّا

196
00:13:04,640 --> 00:13:05,720
هل لي بالقليل؟

197
00:13:05,720 --> 00:13:06,680
.لا

198
00:13:07,220 --> 00:13:08,930
أليس هذا مبكّرًا؟

199
00:13:08,930 --> 00:13:11,060
.بعد بضع سنوات فقط

200
00:13:11,060 --> 00:13:13,270
،عندما كنت أرتاد المدرسة

201
00:13:13,270 --> 00:13:14,690
.استمتعت كثيرًا

202
00:13:15,190 --> 00:13:18,690
.أريد أن تعيش هاتان الفتاتان نفس السّعادة أيضًا

203
00:13:19,240 --> 00:13:20,110
.فهمت

204
00:13:20,110 --> 00:13:21,320
.أنا أدعمك

205
00:13:21,320 --> 00:13:23,070
إذًا نحن الفاشلون الثّلاثة

206
00:13:23,070 --> 00:13:26,080
.وجدنا الآن الدّرب الّذي سنسلكه

207
00:13:26,080 --> 00:13:28,080
.مسرورٌ بالعمل معكما مجدّدًا

208
00:13:30,370 --> 00:13:32,540
يُفترض بكما أن تضعا يديكما على يدي، صحيح؟

209
00:13:32,540 --> 00:13:34,880
!لنظهر أنّنا رفاق! ألا تفهمان؟

210
00:13:34,880 --> 00:13:36,340
أهذا ما تقصده؟

211
00:13:37,630 --> 00:13:38,710
.حسنًا إذًا

212
00:13:38,710 --> 00:13:39,920
...أظهروا

213
00:13:39,920 --> 00:13:40,720
.أنّنا رفاق

214
00:13:41,170 --> 00:13:41,840
.أجل

215
00:13:49,520 --> 00:13:51,350
.كان سوزاكي محقًّا

216
00:13:52,020 --> 00:13:55,110
.بدأت كاشيما ساكورا في تنفيذ خطّتها

217
00:13:56,900 --> 00:13:58,690
.انتهى دور سوزاكي بوندو

218
00:13:59,480 --> 00:14:02,200
.حان الوقت لعودة تينّوجي كوتارو

219
00:14:45,410 --> 00:14:49,240
الحقيقة الّتي تستّرت عليها غايّا والغارديان

220
00:14:49,240 --> 00:14:51,790
.سترى النّور قريبًا

221
00:14:51,790 --> 00:14:54,160
.سيتغيّر البشر حالما يعرفون كلّ شيء

222
00:14:54,160 --> 00:14:56,750
.لا، سيتحتّم عليهم أن يتغيّروا

223
00:14:56,750 --> 00:14:58,920
،مع الموت البطيء والحتميّ للكوكب

224
00:14:58,920 --> 00:15:01,210
.المورد الوحيد المتبقّي هو الحياة نفسها

225
00:15:01,670 --> 00:15:03,670
.وقد حان وقت التدخّل

226
00:15:04,970 --> 00:15:05,800
،كاغاري

227
00:15:06,470 --> 00:15:08,220
.سيبدأ الأمر غدًا

228
00:15:09,390 --> 00:15:12,470
.فلنذهب لنشهد على تلك اللّحظة معًا

229
00:15:13,310 --> 00:15:15,560
.ذكرياتٌ جميلة تعمّ الأرض بأكملها

230
00:15:15,560 --> 00:15:17,850
،سواءً كان ذلك جميلًا أم لا

231
00:15:20,270 --> 00:15:21,150
.دعينا نكتشف ذلك

232
00:15:22,650 --> 00:15:24,400
.فلنشاهد ذلك من أعلى تلك التلّة

233
00:15:27,110 --> 00:15:28,570
.محال

234
00:15:28,570 --> 00:15:30,780
كلّ هذا العدد من المستحضرين؟

235
00:15:30,780 --> 00:15:32,620
.لا بدّ أنّه أمرٌ من كاشيما ساكورا

236
00:15:32,620 --> 00:15:34,330
.تلك العجوز الشّمطاء

237
00:15:34,330 --> 00:15:35,120
ماذا سنفعل؟

238
00:15:35,750 --> 00:15:37,370
!تعبّؤا لعمليّة الطّوارئ

239
00:15:37,790 --> 00:15:40,250
.اطلبي التّعزيزات من المقرّ يا نيتشيكوجو

240
00:15:40,250 --> 00:15:41,630
!حـ-حاضر

241
00:15:51,600 --> 00:15:52,600
كاغاري؟

242
00:16:04,280 --> 00:16:06,570
...مكانان يحتمل أن تذهب إليهما كاغاري

243
00:16:06,570 --> 00:16:09,410
.بقعة الطّاقة حيث وُلدت أو تلك التلّة

244
00:16:11,370 --> 00:16:12,660
.وجدتك أخيرًا

245
00:16:14,370 --> 00:16:15,370
.كوتوري

246
00:16:15,370 --> 00:16:17,910
.أنا خائفةٌ نوعًا ما يا كوتارو-كُن

247
00:16:17,910 --> 00:16:20,420
.شعرت أنّك ستختفي إن تركتك وحيدًا

248
00:16:21,130 --> 00:16:23,800
أخبرني، لماذا تساعد كاغاري؟

249
00:16:24,840 --> 00:16:25,800
.أتساءل لماذا

250
00:16:26,460 --> 00:16:29,720
ألست تملك الخيار لعدم مساعدتها؟

251
00:16:29,720 --> 00:16:31,300
.هذا الكوكب سيفنى

252
00:16:31,300 --> 00:16:32,800
وماذا عسانا نفعل؟

253
00:16:33,140 --> 00:16:37,520
.أملنا الوحيد أن نخلق ذكرياتٍ جميلة

254
00:16:37,520 --> 00:16:40,400
.يجب أن نُثبت للكوكب أنّ للبشريّة إمكانياتٍ متبقية

255
00:16:40,400 --> 00:16:41,060
...بعبارةٍ أخرى

256
00:16:41,060 --> 00:16:42,560
.لا آبه لأيّ من ذلك

257
00:16:43,020 --> 00:16:43,940
...ذلك

258
00:16:43,940 --> 00:16:46,740
!ذلك ليس ما أسألك عنه

259
00:16:46,740 --> 00:16:48,450
...الوعد

260
00:16:48,450 --> 00:16:49,400
الوعد؟

261
00:16:50,990 --> 00:16:53,450
!لم تصحبني مطلقًا في جولةٍ عبر مهرجان الحصاد

262
00:16:54,240 --> 00:16:56,870
ما زلتِ تتذكّرين شيئًا قديمًا كهذا؟

263
00:16:57,830 --> 00:16:59,660
...أعتقد أنّنا متشابهون

264
00:16:59,660 --> 00:17:02,460
.أنا وأنتِ وكاغاري

265
00:17:02,460 --> 00:17:03,840
كاغاري أيضًا؟

266
00:17:03,840 --> 00:17:05,000
.نعم

267
00:17:05,000 --> 00:17:06,710
.كاغاري وحيدةٌ أيضًا

268
00:17:07,590 --> 00:17:09,970
،ليس وكأنّي لا أتعاطف معك

269
00:17:10,760 --> 00:17:11,970
.لكنّني آسف

270
00:17:13,050 --> 00:17:14,890
.سأختار كاغاري

271
00:17:20,270 --> 00:17:21,770
لماذا؟

272
00:17:21,770 --> 00:17:23,610
!لماذا فعلت هذا؟

273
00:17:23,610 --> 00:17:25,770
.كنت أنوي فعلها منذ مدّة طويلة

274
00:17:26,110 --> 00:17:28,400
...لماذا أنت دائمًا

275
00:17:28,400 --> 00:17:29,820
،في الحقيقة يا كوتوري

276
00:17:29,820 --> 00:17:32,910
.لطالما اعتبرتكِ عائقًا في طريقي

277
00:17:33,530 --> 00:17:36,080
.كنتِ مصدر إزعاجٍ حقيقيّ

278
00:17:36,080 --> 00:17:37,790
.لكنّه أزيح الآن

279
00:17:38,040 --> 00:17:40,290
،لطالما أثرتِ اشمئزازي

280
00:17:40,290 --> 00:17:41,790
.تستحقّين هذا

281
00:17:44,750 --> 00:17:46,170
...أنا

282
00:17:46,170 --> 00:17:47,670
!أنا أكرهك

283
00:17:47,670 --> 00:17:48,670
!مُت فحسب

284
00:17:52,220 --> 00:17:53,970
.إلى اللّقاء يا كوتوري

285
00:18:03,140 --> 00:18:05,940
.مخبرونا أبلغوا عن رصدهم لشيءٍ يشتبه أن يكون المفتاح

286
00:18:05,940 --> 00:18:08,070
.حسنًا. أعطهم الأمر للتحرّك

287
00:18:14,200 --> 00:18:16,320
.سأستعير تقنيّتك يا لويس

288
00:18:16,830 --> 00:18:18,080
لا تفعل

289
00:18:16,830 --> 00:18:18,830
أعد الكتابة

290
00:18:22,500 --> 00:18:25,540
!إلى هناك

291
00:18:27,340 --> 00:18:29,920
...المسافة إلى الهدف: 500

292
00:18:30,550 --> 00:18:31,760
...400

293
00:18:33,760 --> 00:18:36,010
تحطّمت المروحيّة؟

294
00:18:36,010 --> 00:18:37,850
ما كان ذلك؟

295
00:18:37,850 --> 00:18:38,720
رمح؟

296
00:18:38,720 --> 00:18:39,680
أكانت فعلة بشريّ خارق؟

297
00:18:39,680 --> 00:18:42,180
.أيعقل أنّه ذلك الشّقيّ

298
00:18:52,280 --> 00:18:53,110
.كاغاري

299
00:18:53,110 --> 00:18:55,160
.أُلغيّت رحلة المشي

300
00:18:55,160 --> 00:18:56,780
.علينا أن نهرب

301
00:18:56,780 --> 00:18:58,070
...أنت

302
00:18:58,070 --> 00:18:59,240
.أحسنتِ يا كاغاري

303
00:18:59,240 --> 00:19:01,040
.حاولي المحافظة على وعيك

304
00:19:01,540 --> 00:19:03,910
...الكوكب سيندثر

305
00:19:03,910 --> 00:19:05,370
.لا نعلم ذلك بعد

306
00:19:05,370 --> 00:19:07,330
.العالم على وشك أن يتغيّر

307
00:19:07,330 --> 00:19:10,170
.والصّراع بين غايّا والغارديان سينتهي قريبًا

308
00:19:10,170 --> 00:19:12,380
...البشريّة ستفنى

309
00:19:12,380 --> 00:19:14,170
.لا تستسلمي إلى أن تري ما سيحدث

310
00:19:16,930 --> 00:19:18,930
...الأنشودة تزداد شدّة

311
00:19:21,680 --> 00:19:22,390
ماذا؟

312
00:19:22,390 --> 00:19:23,730
!ظهر هذا الشّيء فجأة

313
00:19:22,810 --> 00:19:23,730
ما هذا؟

314
00:19:23,730 --> 00:19:24,680
!يبدو هذا خطيرًا

315
00:19:32,030 --> 00:19:34,190
.فلتفني أيّتها البشريّة

316
00:19:41,870 --> 00:19:43,200
ما الّذي يحدث؟

317
00:19:44,200 --> 00:19:46,460
...يبدو أنّها النّهاية

318
00:19:46,460 --> 00:19:47,540
!سحقًا

319
00:19:51,710 --> 00:19:53,630
...هذا الضّغط

320
00:19:53,630 --> 00:19:54,960
!عدوٌّ قويّ هنا

321
00:19:56,680 --> 00:19:57,430
بة ثم اعترضالكتا أعد

322
00:19:56,680 --> 00:19:57,470
أعد الكتابة ثم اعترض

323
00:19:57,470 --> 00:19:58,930
.آسفٌ يا كاغاري

324
00:19:58,930 --> 00:20:00,220
.امنحيني بعض الوقت

325
00:20:19,490 --> 00:20:21,620
.كما توقّعت

326
00:20:32,460 --> 00:20:32,880
...اعترض بالذّراع

327
00:20:34,590 --> 00:20:36,510
!تحويل دمي إلى حالةٍ تشبه الزّيت

328
00:20:37,010 --> 00:20:37,510
من اليسار

329
00:20:38,050 --> 00:20:38,510
يده

330
00:20:39,010 --> 00:20:39,510
استخدم كلتا اليدين

331
00:20:39,510 --> 00:20:40,050
اضرب

332
00:20:39,510 --> 00:20:40,050
تماسك

333
00:20:39,510 --> 00:20:40,510
القيام بضربة قاضية

334
00:20:51,980 --> 00:20:53,730
هل هي النّهاية؟

335
00:20:54,230 --> 00:20:55,480
لا تستسلم

336
00:20:54,230 --> 00:20:56,230
استسلم

337
00:21:20,550 --> 00:21:23,340
.فلنكتفِ اليوم بهذا

338
00:21:23,340 --> 00:21:25,890
.آسفٌ يا إساكا-سان

339
00:21:25,890 --> 00:21:27,470
.استخدمتُ خدعةً رخيصة

340
00:21:27,770 --> 00:21:29,310
ما هذا الّذي تقوله؟

341
00:21:29,310 --> 00:21:32,560
.حتّى الضّعفاء يمكنهم أن يصبحوا نزيهين

342
00:21:32,560 --> 00:21:36,230
.لكن، وحدهم الأقويّاء ينتصرون

343
00:21:37,190 --> 00:21:38,900
.أنت قويّ

344
00:21:41,740 --> 00:21:44,160
كنتُ أخونك منذ مدّةٍ طويلة

345
00:21:44,990 --> 00:21:48,870
.وأحمي ما تسمّونه المفتاح

346
00:21:48,870 --> 00:21:50,790
ما الّذي ستفعله بالمفتاح؟

347
00:21:51,120 --> 00:21:53,830
.سأريها عملي الأخير

348
00:21:53,830 --> 00:21:56,170
،إن أقنعها ذلك بأن تعدل عن إبادتنا

349
00:21:56,500 --> 00:21:58,090
.فسنحظى بفرصةٍ جديدة

350
00:21:58,880 --> 00:22:00,420
.هكذا إذًا

351
00:22:00,420 --> 00:22:02,550
.إذًا فلكين

352
00:22:02,550 --> 00:22:05,930
.لن أدع جهد الجميع يذهب سدى

353
00:22:05,930 --> 00:22:07,810
.هذه هي خطّتي

354
00:22:07,810 --> 00:22:08,890
.جيّد

355
00:22:08,890 --> 00:22:10,810
.اذهب الآن

356
00:22:10,810 --> 00:22:13,480
.البشر لا يموتون بهذه السّهولة

357
00:22:13,900 --> 00:22:17,690
.لن أنسى أبدًا ما علّمتني إيّاه

358
00:22:18,360 --> 00:22:19,730
!شكرًا جزيلًا لك

359
00:22:21,070 --> 00:22:22,010
...اذهب

360
00:22:22,440 --> 00:22:23,240
.أسرع

361
00:22:31,330 --> 00:22:41,840
العالم الّذي تحيَين فيه عالمٌ لا يغفو ونقيٌّ أصيل

362
00:22:43,050 --> 00:22:53,980
إن كان لكِ أثرٌ باقٍ هنا، فليكن على الأقلّ خيالك

363
00:22:54,770 --> 00:23:08,280
لا أستطيع حتّى فعل شيءٍ بسيط كالتّحديق إلى السّماء، لِذا سأغمض عيناي فحسب

364
00:23:08,120 --> 00:23:18,670
لكنّني أريدكِ أن تجدي شيئًا واحدًا

365
00:23:18,790 --> 00:23:30,430
حبّي المدفون في الذّكريات

366
00:23:30,560 --> 00:23:42,280
ليكون الفجر الّذي نبلغه بعد عبور الأزمان

367
00:23:42,360 --> 00:23:48,200
قدرًا يباركه الخلاص

368
00:23:49,320 --> 00:23:59,080
ما دامت هذه الأنشودة تصلك