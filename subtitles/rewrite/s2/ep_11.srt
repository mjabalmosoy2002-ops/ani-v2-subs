1
00:00:01,370 --> 00:00:04,480
.ذات يوم، أدركتُ أنّي لا أمتلك شيئًا

2
00:00:05,700 --> 00:00:06,980
،انفصلت عن عائلتي

3
00:00:07,530 --> 00:00:09,320
،خُنت رفاقي ومنظّمتي

4
00:00:09,570 --> 00:00:10,940
.حتّى أنّي قتلت معلّمي

5
00:00:13,280 --> 00:00:15,320
،أبكيت أصدقائي، فقدتهم

6
00:00:16,450 --> 00:00:18,450
.وأدرت ظهري لمن أحبّني

7
00:00:19,450 --> 00:00:20,270
...و

8
00:00:21,490 --> 00:00:23,960
.كنتُ أهمل نفسي حتّى، لِذا فالأمر طبيعي

9
00:00:32,400 --> 00:00:36,270
لكن الجيوب الّتي ظننت أنّها فارغة

10
00:00:36,270 --> 00:00:38,430
.كان ما يزال بها شيءٌ واحد

11
00:00:43,390 --> 00:00:47,690
،لأجل الوفاء بالوعد الّذي لم أنسه لكن لا أتذكّره

12
00:00:50,800 --> 00:00:51,700
...أنا

13
00:00:53,280 --> 00:00:54,410
سأعيد كتابة

14
00:01:00,970 --> 00:01:06,950
.قدر الفتاة الّتي عليها أن تعيش وحيدةً إلى الأبد

15
00:01:41,060 --> 00:01:44,900
.هذه الأنشودة تجعل كاغاري تعاني وتجبرها على جلب الفناء

16
00:01:44,900 --> 00:01:45,960
.يجب أن أوقفها

17
00:01:46,960 --> 00:01:48,970
.أستطيع سماع الأنشودة قادمةً من هناك

18
00:01:49,860 --> 00:01:52,720
،لكن إن أردت القضاء على كلّ الشّياطين الّتي أصادفها في طريقي

19
00:01:52,720 --> 00:01:55,340
.فستنفذ طاقتي قبل أن أصل إلى هناك

20
00:01:57,640 --> 00:01:58,720
...تينّوجي

21
00:01:59,080 --> 00:02:02,610
.لديك بعض الشّجاعة لتظهر وجهك أيّها الخائن

22
00:02:09,960 --> 00:02:13,070
هل أنت جاسوسٌ لغايّا؟

23
00:02:13,070 --> 00:02:14,080
.لا

24
00:02:14,080 --> 00:02:16,320
.أنا تينّوجي كوتارو، الرّجل

25
00:02:17,750 --> 00:02:20,110
ألا تريد أن تموت بسلام؟

26
00:02:20,510 --> 00:02:22,490
.لا أستطيع أن أموت بعد

27
00:02:22,490 --> 00:02:24,790
ليس قبل أن أُريها

28
00:02:24,790 --> 00:02:27,790
.إمكانيّات هذا الكوكب والذّكريات السّعيدة الّتي تسعى إليها

29
00:02:28,920 --> 00:02:32,290
.أجبني عن هذا فحسب قبل أن تلقى حتفك

30
00:02:35,070 --> 00:02:37,170
من أنت بحقّ؟

31
00:02:37,720 --> 00:02:38,670
...أنا

32
00:02:40,050 --> 00:02:42,180
.الصيّاد منقذ الأرض

33
00:02:48,600 --> 00:02:49,530
!انتظر

34
00:02:53,590 --> 00:02:54,300
!أنت

35
00:02:56,180 --> 00:02:57,840
...ذلك الاتّجاه

36
00:02:57,840 --> 00:02:59,380
!معبد غايّا

37
00:02:59,380 --> 00:03:00,500
!الحقوا به

38
00:03:00,500 --> 00:03:03,120
!سنسحقه مع قاعدة غايّا بضربةٍ واحدة

39
00:03:09,840 --> 00:03:12,500
.يبدو أنّه كان يخفي قوّته طوال الوقت

40
00:03:12,500 --> 00:03:14,040
...ذلك اللّعين

41
00:03:16,600 --> 00:03:18,220
.هذا المكان غير محميّ بشكلٍ مبالغ

42
00:03:18,220 --> 00:03:22,110
.ممّا يعني أنّ شيئًا خطيرًا يقبع في الأمام

43
00:03:34,030 --> 00:03:35,600
.أعتمد عليكم في إفساح الطّريق

44
00:03:42,070 --> 00:03:43,070
!شيميزو-سان

45
00:03:46,190 --> 00:03:47,330
.يا لسخرية القدر

46
00:03:47,710 --> 00:03:51,130
.وحدنا نحن الفاشلان من نجى

47
00:03:51,130 --> 00:03:51,870
!سحقًا

48
00:04:03,780 --> 00:04:05,020
.تراجعا

49
00:04:14,020 --> 00:04:15,740
.لم أعد أفهم شيئًا

50
00:04:15,740 --> 00:04:18,020
!ظننت أنّك تخوننا

51
00:04:18,590 --> 00:04:20,120
ما خطبك؟

52
00:04:20,120 --> 00:04:22,890
.أخفيت عنّا تلك القوّة الجبّارة طوال الوقت

53
00:04:22,890 --> 00:04:24,650
.كنت تخدعنا طوال الوقت

54
00:04:24,650 --> 00:04:26,780
ما هدفك بالضّبط؟

55
00:04:27,530 --> 00:04:30,740
.كما سبق وأخبرتك، أنا أحاول إنقاذ الكوكب

56
00:04:30,740 --> 00:04:33,870
.ثمّة فتاةٌ لن أستطيع إغواءها ما لم أفعل

57
00:04:35,520 --> 00:04:38,130
ما-ما الّذي تقصده بإنقاذ الأرض؟

58
00:04:38,380 --> 00:04:39,850
.سأوقف هذه الأنشودة

59
00:04:39,850 --> 00:04:43,630
.رغم أنّ ذلك سيجعلنا نترنّح على حافّة الهاوية لا غير

60
00:04:45,640 --> 00:04:49,340
.لكن دعاني أمرّر عصى الإمكانيّات

61
00:04:49,340 --> 00:04:52,640
.لنرَ... إلى تلاميذ نيتشيكوجو المستقبليّين

62
00:04:56,170 --> 00:04:58,070
...وبما أنّني ذكرت هذا

63
00:04:59,500 --> 00:05:01,490
،إنّها شقيّةٌ سليطة اللّسان

64
00:05:01,490 --> 00:05:04,200
.لكنّها فتاةٌ طيّبة القلب

65
00:05:04,200 --> 00:05:06,570
.لا أملك لها غير تلك الصّورة

66
00:05:06,570 --> 00:05:08,390
.عنوانها مدوّنٌ هناك أيضًا

67
00:05:08,390 --> 00:05:10,200
...ماذا؟ مهلًا، هذا

68
00:05:10,560 --> 00:05:12,910
.إمامييا، نيتشيكوجو

69
00:05:12,910 --> 00:05:14,460
.أعهد لكما بالمستقبل

70
00:05:15,670 --> 00:05:17,840
لماذا تقولها بهذه الطّريقة؟

71
00:05:17,840 --> 00:05:19,960
...كما لو أنّك

72
00:05:45,040 --> 00:05:47,430
صيّادٌ واحد فقط؟

73
00:05:51,790 --> 00:05:56,760
.لا بدّ وأنّك فردٌ متفوّقٌ اختاره القدر

74
00:05:58,120 --> 00:06:02,100
.الشّياطين الّذين يعمّرون زمنًا طويلًا، تصبح لديهم إرادةٌ خاصّة

75
00:06:02,100 --> 00:06:03,380
.ملاك غايّا الحارس

76
00:06:03,730 --> 00:06:04,950
.بالفعل

77
00:06:04,950 --> 00:06:08,160
.أعتبر سلالة غايّا كأطفالي

78
00:06:10,280 --> 00:06:15,880
.جميع أشكال الحياة لها الحقّ في تقرير نهايتها كما تشاء

79
00:06:15,880 --> 00:06:18,560
،وإن كانت هذه النّهاية رغبتهم

80
00:06:18,560 --> 00:06:21,400
.فسألبّي رغبتهم تلك

81
00:06:22,310 --> 00:06:25,900
،من أجل تلبية رغبة أطفالي

82
00:06:26,360 --> 00:06:30,030
.لن أدعك تخطو أيّ خطوةٍ أبعد من هذا أيّها الصيّاد

83
00:06:31,660 --> 00:06:32,910
لا تعد الكتابة

84
00:06:31,660 --> 00:06:33,660
إعادة الكتابة

85
00:06:43,330 --> 00:06:46,530
.إذًا فقد بلغت هذا الحدّ

86
00:06:47,360 --> 00:06:50,680
.هذا لم يعد دمي بعد الآن، بل حياتي نفسها

87
00:06:53,310 --> 00:06:54,580
.حان وقت استجماعها

88
00:07:02,650 --> 00:07:04,480
...نقطة اللّاعودة

89
00:07:05,230 --> 00:07:08,860
.لقد تخطّيت للتّو حدًّا لا عودة منه

90
00:07:53,820 --> 00:07:55,910
!فلتسقطي يا غايّا

91
00:08:21,230 --> 00:08:23,520
.كاشيما ساكورا

92
00:08:24,160 --> 00:08:28,110
أكان لكلّ ما فعلتُه أيّ معنى؟

93
00:08:30,430 --> 00:08:33,060
.لا أثر الآن لكلّ تلك الشّياطين

94
00:08:33,060 --> 00:08:36,910
.توقّفت الأنشودة، لكنّ العالم لم يفنَ بعد

95
00:08:36,910 --> 00:08:39,370
.هذا يعني أنّ كاغاري ما تزال صامدة

96
00:08:39,370 --> 00:08:42,670
.الصّراع بين غايّا والغارديان سينتهي قريبًا

97
00:08:42,670 --> 00:08:45,890
ألن يخلق ذلك ذكرياتٍ سعيدة؟

98
00:08:45,890 --> 00:08:47,750
.أخبريني يا كاغاري

99
00:08:55,970 --> 00:08:57,010
إكو-سان؟

100
00:08:59,260 --> 00:09:01,020
كوتارو-كُن؟

101
00:09:01,470 --> 00:09:02,770
لما أنتِ هنا؟

102
00:09:03,640 --> 00:09:05,390
...فقد كنتِ تعملين بجدّ

103
00:09:05,940 --> 00:09:07,190
فلماذا؟

104
00:09:07,760 --> 00:09:12,170
.لأنّ لا مستقبل لأطفالي

105
00:09:12,170 --> 00:09:16,290
.لكنّني واثقٌ أنّ أكاني كانت تتحسّن شيئًا فشيئًا

106
00:09:16,290 --> 00:09:20,690
.لأنّ ساكورا-سان أخذتها تحت وصايتها

107
00:09:21,360 --> 00:09:23,750
أين أكاني حاليًّا؟

108
00:09:23,750 --> 00:09:26,330
.أرسلتها إلى مدينة الحجر

109
00:09:27,210 --> 00:09:29,840
أخبرني، كيف يبدو العالم؟

110
00:09:31,040 --> 00:09:32,330
.ما زال حيًّا

111
00:09:32,330 --> 00:09:35,590
...قذر، كئيب، وقاسٍ

112
00:09:36,290 --> 00:09:38,080
...إنّه على حافّة الفناء

113
00:09:38,700 --> 00:09:39,970
.لكنّه ما زال حيًّا

114
00:09:40,280 --> 00:09:42,400
.إذًا فقد فشلت

115
00:09:43,730 --> 00:09:48,100
...ربّما عليّ أن أعيد أكاني-تشان إلى هنا

116
00:09:51,930 --> 00:09:53,280
...سحقًا لذلك

117
00:09:53,750 --> 00:09:54,990
!سحقًا لذلك

118
00:09:56,270 --> 00:09:59,400
...لا أنا أو كاغاري نملك ذلك المتّسع من الوقت

119
00:10:10,800 --> 00:10:14,610
.أكاني، ما يزال لديّ عملٌ لأكمله

120
00:10:14,610 --> 00:10:17,260
.لِذا عليكِ أن تنقذي نفسكِ الآن

121
00:10:19,510 --> 00:10:21,390
.سأمدّكِ ببعض الحرّاس

122
00:10:21,390 --> 00:10:23,010
.ديما، ليوبا

123
00:10:33,400 --> 00:10:35,070
يمكنكِ السّيطرة عليهما؟

124
00:10:35,070 --> 00:10:36,460
دون أيّ تدريب؟

125
00:10:38,840 --> 00:10:40,430
.أحسنتِ يا أكاني

126
00:10:40,430 --> 00:10:41,450
.أصغي

127
00:10:41,450 --> 00:10:43,500
اذهبي إلى مكانٍ آمن

128
00:10:43,500 --> 00:10:46,530
،وأخبري ألطف شخصٍ تجيدنه هناك بهذا

129
00:10:46,530 --> 00:10:48,310
".ساعدني"

130
00:10:48,310 --> 00:10:49,860
...ساعد

131
00:10:49,860 --> 00:10:51,750
.أجل، هكذا

132
00:10:51,750 --> 00:10:53,530
.لكن ابتعدي عن المتحرّشين بالأطفال

133
00:10:53,530 --> 00:10:54,550
متحرّش...؟

134
00:10:55,290 --> 00:10:57,470
.قولي ما أخبرتكِ به سابقًا

135
00:10:57,470 --> 00:10:58,300
فهمتِ؟

136
00:10:59,760 --> 00:11:01,080
.من هذا الطّريق

137
00:11:01,080 --> 00:11:02,140
.اذهبي

138
00:11:04,700 --> 00:11:07,550
.لا أصدّق مدى هدوئها في ظلّ هذا الوضع

139
00:11:10,720 --> 00:11:13,520
.يكاد الوقت ينفذ منّي

140
00:11:27,970 --> 00:11:31,120
...كاغاري، أريد رؤيتك

141
00:11:35,730 --> 00:11:40,760
لمٙ أتوق لرؤيتها بشدّة علي أيّ حال؟

142
00:12:05,430 --> 00:12:07,370
.صحيح، فهمت

143
00:12:07,840 --> 00:12:10,750
.كنتُ أسعى إليها منذ الأزل

144
00:12:17,500 --> 00:12:18,500
كاغاري؟

145
00:12:19,280 --> 00:12:20,630
.شكرًا لك

146
00:12:20,630 --> 00:12:22,070
كانت ذكرياتٍ جميلة

147
00:12:22,800 --> 00:12:23,880
.أعظم ما شهِدت

148
00:12:24,390 --> 00:12:26,430
هل فعلتها في الوقت المناسب؟

149
00:12:27,160 --> 00:12:29,930
.لا، مع الأسف

150
00:12:30,810 --> 00:12:34,470
...لو أنّي رأيت هذا العالم أبكر بقليلٍ فحسب

151
00:12:35,340 --> 00:12:37,940
.لا أستطيع التوقّف عن التّفكير بذلك

152
00:12:38,590 --> 00:12:40,190
...هكذا إذًا

153
00:12:42,150 --> 00:12:44,220
.لا شيء لتخجل منه

154
00:12:44,220 --> 00:12:48,350
.لقد أبليت حسنًا باعتبارك فردًا واحدًا

155
00:12:54,450 --> 00:12:55,580
.هيّا

156
00:12:59,260 --> 00:13:01,220
افعلها

157
00:13:08,350 --> 00:13:09,440
...كاغاري

158
00:13:18,270 --> 00:13:20,570
.كان عليك فعل هذا أبكر بكثير

159
00:13:21,290 --> 00:13:23,670
.لطالما أنرتِ طريقي

160
00:13:24,360 --> 00:13:27,480
...لكن إن لم يتغيّر شيء، فإنّنا أبدًا لن

161
00:13:28,130 --> 00:13:31,750
...لهذا قرّرت أن أفعل هذا بنفسي

162
00:13:31,750 --> 00:13:32,960
...لكن

163
00:13:32,960 --> 00:13:33,830
...لكنّني

164
00:13:34,620 --> 00:13:36,440
أزهقت أرواحًا عديدة

165
00:13:36,440 --> 00:13:39,950
!خُنت ثقتهم وحبّهم لأصل إلى هنا

166
00:13:39,950 --> 00:13:42,180
!أعطيتُ الأمل للعالم

167
00:13:42,180 --> 00:13:45,010
!ومع ذلك، تحتّم عليّ قتلك

168
00:13:45,870 --> 00:13:47,190
.لا بأس

169
00:13:47,190 --> 00:13:49,850
.هذه نعمة

170
00:13:50,500 --> 00:13:52,380
!أيّ نعمةٍ هذه؟

171
00:13:52,380 --> 00:13:54,870
!هذه محض لعنة

172
00:13:54,870 --> 00:13:56,930
!لجعلي أُعاني

173
00:13:57,860 --> 00:14:00,720
...القوّة والإرادة لتمهيد الطّريق نحو المستقبل

174
00:14:02,030 --> 00:14:05,310
،حتّى لو تحتّم عليكم استنفاذ كوكبكم الأمّ لفعلها

175
00:14:05,310 --> 00:14:08,190
.يجب أن تبلغوا آفاق جديدة

176
00:14:08,190 --> 00:14:11,120
.ذلك ما سيخلق ذكرياتٍ جميلة

177
00:14:13,620 --> 00:14:17,370
.لقد أبليتٙ حسنًا دون أن أرشدك

178
00:14:18,040 --> 00:14:20,510
أكان هذا كافيًّا؟

179
00:14:20,510 --> 00:14:22,770
.ثمّة إمكانيّة متبقية

180
00:14:22,770 --> 00:14:24,250
.فهمت

181
00:14:24,250 --> 00:14:28,580
.كلّ ما فعلته كان بسبب انجذابي إليك فقط

182
00:14:28,580 --> 00:14:30,350
انجذبت إليّ؟

183
00:14:30,350 --> 00:14:32,140
.أقصد أنّي أحبّك

184
00:14:32,140 --> 00:14:34,360
.لم ألحظ ذلك

185
00:14:34,360 --> 00:14:36,620
.لأنّكِ بلهاء نوعًا ما

186
00:14:37,370 --> 00:14:41,330
.لكنّ المشاعر غير المتبادلة ستكون جوفاء فقط

187
00:14:41,330 --> 00:14:43,150
.لا بأس بذلك

188
00:14:43,150 --> 00:14:44,360
.أحمق بالفعل

189
00:14:46,250 --> 00:14:48,150
...أنت محض فردٍ واحد

190
00:15:00,590 --> 00:15:02,130
.هذا صحيح

191
00:15:02,130 --> 00:15:05,100
.قصّة الحبّ هذه تلائمني

192
00:15:14,570 --> 00:15:17,560
.عاش شابٌ في أحد الأزمان

193
00:15:17,560 --> 00:15:21,560
.كانت له نفس المخاوف والأحزان مثل أقرانه

194
00:15:21,950 --> 00:15:24,250
.شابٌّ مرهف الإحساس

195
00:15:25,320 --> 00:15:26,940
.كان جنديًّا

196
00:15:27,530 --> 00:15:31,450
.روحٌ آثمة أزهقت أرواح الكثيرين

197
00:15:31,780 --> 00:15:35,950
،لكنّه أنقذ أرواحًا عديدةً أيضًا

198
00:15:36,430 --> 00:15:38,450
.مضحّيًا بقلبه وحياته

199
00:15:46,180 --> 00:15:49,110
وما خلّفه وراءه

200
00:15:50,090 --> 00:15:52,890
،كان ضوءًا يُرشد الضّعفاء

201
00:15:52,890 --> 00:15:56,850
.والبشر اليائسين على هذا الكوكب الجريح

202
00:15:57,810 --> 00:16:00,310
سنحترم أمنيّته

203
00:16:00,310 --> 00:16:03,740
،وسنكشف عمّا كان يحتكره البعض

204
00:16:03,740 --> 00:16:05,670
،الضّوء الّذي سيرشدنا نحو النّجاة

205
00:16:05,670 --> 00:16:07,560
.إلى العالم أجمع

206
00:16:15,490 --> 00:16:16,490
،بينما تسير الأرض نحو الفناء

207
00:16:17,150 --> 00:16:19,730
.تبقّى للبشريّة موردٌ واحد لتلجأ إليه

208
00:16:20,500 --> 00:16:23,250
إنّه موجودٌ داخلنا

209
00:16:23,250 --> 00:16:26,750
.إنّها الحياة المحدودة واللّامتناهية

210
00:16:30,420 --> 00:16:34,730
خطيئة العيش باستنزاف حيوات النّاس والكوكب

211
00:16:34,730 --> 00:16:36,370
.الكوكب سيغفرها لنا بكلّ تأكيد

212
00:16:37,510 --> 00:16:40,830
لأنّ الولد الّذي وطأ على أمّه كعتبةٍ للانطلاق في رحلته

213
00:16:40,830 --> 00:16:45,270
.محالٌ أن تكون ذكرى محزنة

214
00:16:46,370 --> 00:16:48,990
لِذا أرجوكم لا تنسوا

215
00:16:49,680 --> 00:16:53,210
.لا تنسوا الشّاب المجهول الّذي مهّد لنا الطّريق

216
00:16:53,210 --> 00:16:55,700
،الرّائد الّذي أرشدنا

217
00:16:55,700 --> 00:16:57,790
.حاملُ المشعل المرشد

218
00:17:04,950 --> 00:17:07,370
،هل وجدت كوكبًا جيّد

219
00:17:07,370 --> 00:17:08,920
يا عزيزي؟

220
00:17:15,000 --> 00:17:16,930
أهذه هي؟

221
00:17:16,930 --> 00:17:19,630
نمت بطول خمسمائة مترٍ في ظرف ثلاث سنوات؟

222
00:17:19,630 --> 00:17:20,790
.يا له من إزعاج

223
00:17:20,790 --> 00:17:22,200
.إنّها مهيبة

224
00:17:22,200 --> 00:17:23,770
.لديها لونٌ رائعٌ أيضًا

225
00:17:23,770 --> 00:17:25,910
!تبدو راسخةً للغاية

226
00:17:25,910 --> 00:17:27,640
هل هذا تعريض؟

227
00:17:27,640 --> 00:17:28,480
.كلّا

228
00:17:28,480 --> 00:17:30,300
.تفكيرك منحرفٌ فحسب

229
00:17:30,300 --> 00:17:32,320
.اللّوم يقع على جيناتي

230
00:17:38,910 --> 00:17:40,140
ما الأمر يا كوتوري؟

231
00:17:41,990 --> 00:17:45,250
.أشعر أنّ هذا مألوفٌ لسببٍ ما

232
00:17:45,250 --> 00:17:48,940
لكن ألا بأس بأن نستخدمها دون إذن؟

233
00:17:48,940 --> 00:17:51,690
هذا المكان في ملكيّة البلديّة، صحيح؟

234
00:17:51,690 --> 00:17:54,530
.لا يهمّ ما لم يكتشف أحدٌ ذلك

235
00:17:54,530 --> 00:17:57,630
!إذا اكتشفوا ذلك فستوبّخنا توكا-سينسي

236
00:17:57,890 --> 00:18:00,390
إذًا هلّا بدأنا بالأمر؟

237
00:18:01,310 --> 00:18:03,140
.حان وقت العدّ العكسي

238
00:18:03,140 --> 00:18:04,140
!خمسة

239
00:18:04,140 --> 00:18:05,140
!أربعة

240
00:18:05,140 --> 00:18:06,140
!ثلاثة

241
00:18:06,140 --> 00:18:07,140
!اثنان

242
00:18:07,140 --> 00:18:08,150
!واحد

243
00:18:08,780 --> 00:18:10,400
!فلتظهر

244
00:18:32,700 --> 00:18:34,610
.إنّه نجاحٌ باهر

245
00:18:34,610 --> 00:18:35,910
أيمكنك سماعنا؟

246
00:18:35,910 --> 00:18:38,430
.أنت شيطاننا

247
00:18:38,430 --> 00:18:39,610
.نعم

248
00:18:39,610 --> 00:18:43,900
.عملك هو أن ترتدي زيّ الخادم وتخدمنا كالعبد

249
00:18:43,900 --> 00:18:44,560
.نعم

250
00:18:44,560 --> 00:18:47,050
أتفهم ما نقوله؟

251
00:18:47,050 --> 00:18:47,560
.نعم

252
00:18:48,070 --> 00:18:50,190
ألا يستطيع قول شيءٍ آخر غير "نعم"؟

253
00:18:49,100 --> 00:18:54,900
عندما تظهر الشقوق في الليل كسنوات لا تحصى تمرّ علينا

254
00:18:50,450 --> 00:18:52,560
.لقد وُلد للتّو. هذا طبيعيّ

255
00:18:53,110 --> 00:18:55,840
.بالمناسبة، هذا المكان دافئ

256
00:18:55,110 --> 00:19:00,910
نرى أنفسنا في السماء كأنوارٍ وهمية

257
00:18:55,840 --> 00:18:57,660
.رغم أنّنا في العصر الجليديّ حاليًّا

258
00:18:57,660 --> 00:18:59,700
.البرد قارسٌ خارج المدينة

259
00:19:00,490 --> 00:19:02,200
.إذًا هذا ما في الأمر

260
00:19:01,070 --> 00:19:07,120
أودّ لو أصبح شخصًا مختلفًا عن الأمس

261
00:19:02,620 --> 00:19:05,960
.كما لو أنّ المدينة محميّةٌ بطبقةٍ من الحياة

262
00:19:05,960 --> 00:19:08,960
أتدرك من تكون؟

263
00:19:07,120 --> 00:19:11,960
وأمتلك ذاتي الحقيقيّة بدلًا

264
00:19:08,960 --> 00:19:10,240
.نعم

265
00:19:10,240 --> 00:19:11,970
أنا شيطان، صحيح؟

266
00:19:11,960 --> 00:19:18,720
دليل وجودنا يتلاشى وراء الأفق

267
00:19:11,970 --> 00:19:17,710
.عملي أن أرتدي بذلةً سوداء وأخدمكنّ، أنتنّ المتعاقدات معي

268
00:19:17,710 --> 00:19:19,120
!كما قلنا تمامًا

269
00:19:18,720 --> 00:19:26,930
حياتك وصلت إلى طريقٍ مسدود كسكّة صدئة

270
00:19:19,120 --> 00:19:20,940
!كان ذلك فعّالًا

271
00:19:21,590 --> 00:19:23,340
.لكنّني أرفض باحترام

272
00:19:23,980 --> 00:19:26,610
،إمكانيّاتي أكبر من ذلك بكثير

273
00:19:26,610 --> 00:19:29,090
.لأنّني أمتلك قوّةً مميّزة

274
00:19:26,930 --> 00:19:33,360
ما دام هذا اللّهب الأزرق يسري في عروقي

275
00:19:31,590 --> 00:19:35,550
.بدأ يتحدّث فجأةً كطالبٍ جامعيّ لا يريد الحصول على وظيفة

276
00:19:33,360 --> 00:19:38,820
سأشدّ بيدك بينما تستدير

277
00:19:35,550 --> 00:19:39,540
.في الواقع، هذه أوّل مرّةٍ أرى شيطانًا يعصي سيّده

278
00:19:38,900 --> 00:19:45,330
وأتعهّد للنّجوم المولودة من الرّماد ألّا أتخلّى عنك أبدًا

279
00:19:39,540 --> 00:19:42,450
.لهذا قلت لكنّ أن نتجنّب ذوي هيئة البشر

280
00:19:42,450 --> 00:19:44,760
.لأنّه سيتحوّل إلى مجرفي

281
00:19:44,760 --> 00:19:46,120
مجرفك؟

282
00:19:45,330 --> 00:19:52,040
سأعيد كتابة هذه القصيدة

283
00:19:46,580 --> 00:19:47,990
.لأنّه متعجرف

284
00:19:48,260 --> 00:19:51,270
.فلندع تلك الطّرفة السّخيفة لوقتٍ لاحق

285
00:19:51,270 --> 00:19:52,370
!متعجرف

286
00:19:52,370 --> 00:19:55,380
.أطلب أن أُعامل بمعاملةٍ تلائم قدراتي

287
00:19:55,380 --> 00:19:57,270
،طالما أنكنّ تمدنني بالحياة

288
00:19:57,270 --> 00:20:01,260
.يمكنني أن أُبدع في استخدامها وفعل أيّ شيء

289
00:20:01,850 --> 00:20:03,760
.لا أملك أدنى فكرةٍ عمّا يتحدّث

290
00:20:02,840 --> 00:20:09,270
ما دام هذا اللّهب الأزرق يسري في عروقي

291
00:20:04,030 --> 00:20:06,730
إذًا، أيمكنك الطّيران؟

292
00:20:06,730 --> 00:20:09,440
.يمكنني أن أُنمّي الأجنحة أو الأشرعة إن لزم الأمر

293
00:20:09,270 --> 00:20:14,730
سأشدّ بيدك بينما تستدير

294
00:20:09,440 --> 00:20:11,660
.إذًا دعنا نجرّب ذلك

295
00:20:11,660 --> 00:20:15,030
.خُذنا إلى مكانٍ ما فورًا

296
00:20:14,810 --> 00:20:21,240
وأتعهّد للنّجوم المولودة من الرّماد ألّا أتخلّى عنك أبدًا

297
00:20:15,030 --> 00:20:17,070
.طلبٌ هيّن

298
00:20:17,070 --> 00:20:20,710
.لكنّني لم أُمدّ إلّا بخمس قطراتٍ من الحياة حاليًا

299
00:20:20,710 --> 00:20:21,780
.هذا لا يكفي

300
00:20:21,240 --> 00:20:27,950
سأعيد كتابة كلّ شيء

301
00:20:21,780 --> 00:20:24,400
إذًا إلى كم تحتاج؟

302
00:20:24,400 --> 00:20:27,830
.عشرات الآلاف من المتعاقدين على الأقلّ

303
00:20:27,830 --> 00:20:30,040
.أنت تستهلك بفظاعة

304
00:20:30,040 --> 00:20:32,040
إلى أيّ حدٍّ يمكننا الذّهاب بذلك العدد؟

305
00:20:32,320 --> 00:20:34,880
.يمكنني مغادرة النّظام الشّمسيّ حتّى إن أردتن

306
00:20:34,880 --> 00:20:37,590
ولمٙ عسانا نذهب إلى الفضاء؟

307
00:20:37,590 --> 00:20:39,850
أتساءل لماذا؟

308
00:20:39,850 --> 00:20:41,940
.فكّرن في سببٍ لذلك بأنفسكن

309
00:20:41,940 --> 00:20:43,840
.ذلك هو عمل البشريّة

310
00:20:43,840 --> 00:20:44,760
.يا رائد الفضاء

311
00:20:44,760 --> 00:20:47,850
إلى أيّ مدى يمكن أن نذهب بمساهمة خمسة أشخاصٍ فقط؟

312
00:20:48,080 --> 00:20:50,220
.في هذه الحالة، إلى هناك تقريبًا

313
00:20:53,020 --> 00:20:55,100
.ما الأمر؟ سنكون هناك في لمح البصر

314
00:23:43,450 --> 00:23:45,270
.أوفيت بوعدي أخيرًا

315
00:23:45,520 --> 00:23:46,520
أريد أن أراك

316
00:23:46,760 --> 00:23:47,810
.مجدّدًا يومًا ما