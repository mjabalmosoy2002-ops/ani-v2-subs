177
00:14:16,920 --> 00:14:21,300
.هي بنسيان كلّ ما يتعلّق بالدّراسة والقيام بشيءٍ مخالفٍ تمامًا

178
00:14:21,300 --> 00:14:25,510
.واثقٌ أنّ القيام بنفس الشّيء دائمًا ينهك عقلك

179
00:14:25,510 --> 00:14:28,760
.وستنهارين في النّهاية إن استمررتِ في إجهاد نفسك

180
00:14:31,270 --> 00:14:33,770
.نظرتِ إليّ أخيرًا

181
00:14:33,770 --> 00:14:34,650
.حسنًا

182
00:14:34,650 --> 00:14:36,270
.دعينا نفعل شيئًا يليق بكونه موعدًا

183
00:14:41,690 --> 00:14:44,950
.ربّما بسبب لمسي لنظريّتكِ واكتساب معارف كثيرة

184
00:14:44,950 --> 00:14:46,910
.يبدو أنّني أستطيع الآن القيام بهكذا أمور

185
00:14:49,410 --> 00:14:52,160
هلّا منحتني شرف الرّقص معك؟

186
00:15:10,310 --> 00:15:12,680
.المكان موحشٌ لعدم وجود أحدٍ غيرنا

187
00:15:16,690 --> 00:15:19,150
.نحن الآن محطّ الأنظار

188
00:15:52,720 --> 00:15:53,850
!والآن

189
00:15:59,810 --> 00:16:01,270
.آسف. آسف

190
00:16:05,070 --> 00:16:06,700
...كاغاري

191
00:16:11,370 --> 00:16:12,200
كاغاري؟

192
00:16:15,330 --> 00:16:17,620
...هذا عداء

193
00:16:17,620 --> 00:16:19,210
.حقدٌ وكراهية

194
00:16:19,210 --> 00:16:22,040
.البشر وحدهم من يمتلك تلك المشاعر

195
00:16:23,250 --> 00:16:26,590
.البشر الّذين يريدون قتل كاغاري، المفتاح

196
00:16:26,590 --> 00:16:27,590
هل هم الغارديان؟

197
00:16:29,590 --> 00:16:31,680
...مهلًا، هذه الهالة

198
00:16:31,680 --> 00:16:32,970
.تراجعي يا كاغاري

199
00:16:38,600 --> 00:16:40,190
!إذًا فقد كان شيطانًا كما توقّعت

200
00:16:46,360 --> 00:16:48,780
!لا أستطيع إكمال تلويحي؟

201
00:16:50,910 --> 00:16:51,910
!لن أسمح لك

202
00:16:54,120 --> 00:16:54,990
!كاغاري

203
00:17:15,310 --> 00:17:16,720
ما كان ذلك؟

204
00:17:18,730 --> 00:17:20,390
من أرسله؟

205
00:17:22,150 --> 00:17:24,610
.قراءة المعلومات

206
00:17:26,980 --> 00:17:28,530
كاشيما ساكورا؟

207
00:17:29,150 --> 00:17:31,280
!قدّيسة غايّا؟

208
00:17:31,910 --> 00:17:33,410
!محال

209
00:17:33,410 --> 00:17:37,160
!أهذا يعني أنّها تعبث بهذا العالم من أحد العوالم الفرعيّة؟

210
00:17:37,160 --> 00:17:40,580
.كاشيما ساكورا بغضت كلّ شيء

211
00:17:40,580 --> 00:17:42,620
.ليس فقط المجتمع البشري

212
00:17:42,620 --> 00:17:45,670
.بل نظام الحياة بأكمله

213
00:17:46,170 --> 00:17:49,090
هل تنشد الخراب إلى هذا الحدّ؟

214
00:17:49,090 --> 00:17:51,630
...العوالم الفرعية ليست كافية

215
00:17:51,630 --> 00:17:54,800
تريد محو كلّ احتمالات البقاء؟

216
00:17:57,930 --> 00:17:58,810
.كاغاري

217
00:18:01,060 --> 00:18:02,690
.سوف أحميك

218
00:18:02,690 --> 00:18:06,940
.أراهن أنّ هذا هو سبب إرسالي إلى هنا

219
00:18:15,530 --> 00:18:16,660
...أنا

220
00:18:17,370 --> 00:18:21,080
!ماذا كنتُ أحاول فعله بيديّ؟

221
00:18:25,920 --> 00:18:28,210
إنّها ترسل مجموعةً من الشّياطين؟

222
00:18:37,760 --> 00:18:41,100
إلى أيّ مدى تصل وحشيّة كاشيما ساكورا؟

223
00:18:45,730 --> 00:18:47,400
.كما توقّعت

224
00:18:47,400 --> 00:18:49,820
.يصير جسدي واهنًا كلّما واجهت الشّياطين

225
00:18:49,820 --> 00:18:50,820
..فهمت

226
00:18:50,820 --> 00:18:52,110
!هذا ما يحدث إذًا

227
00:18:52,440 --> 00:18:58,370
.سحقًا لكلّ هذا

228
00:19:13,380 --> 00:19:16,890
!فلتختفِ

229
00:19:44,910 --> 00:19:46,500
.كاشيما ساكورا

230
00:19:46,500 --> 00:19:48,750
.أنا تينّوجي كوتارو

231
00:19:48,750 --> 00:19:50,790
لِم أنا في هذا المكان؟

232
00:19:50,790 --> 00:19:52,750
.فكّرت كثيرًا بالسّبب وراء ذلك

233
00:19:53,420 --> 00:19:54,880
،حتّى قبل لحظات

234
00:19:54,880 --> 00:19:57,720
.ظننتُ أنّه تمّ استدعائي لحماية كاغاري

235
00:19:57,720 --> 00:20:00,930
.لكنّ هجومكِ ساعدني على إدراك الحقيقة

236
00:20:01,390 --> 00:20:03,970
.أردت إنقاذ الجميع في البداية

237
00:20:03,970 --> 00:20:06,310
،لكن، تبيّن أنّ الأمر مستحيل

238
00:20:06,310 --> 00:20:06,690
.سوف نتزوّج

239
00:20:06,310 --> 00:20:06,690
.شكرًا على كلّ شيء

240
00:20:06,310 --> 00:20:06,690
.تينّوجي كوتارو وكوتوري

241
00:20:06,640 --> 00:20:11,520
.لِذا كلّ ما استطعت فعله هو اختيار أحد الاحتمالات الّتي لا حصر لها

242
00:20:06,690 --> 00:20:08,560
.سوف نتزوّج

243
00:20:06,690 --> 00:20:08,560
.شكرًا على كلّ شيء

244
00:20:06,690 --> 00:20:08,560
.تينّوجي كوتارو وكوتوري

245
00:20:11,520 --> 00:20:14,570
وفي جلّها، الخيار الّذي اتّخذته

246
00:20:14,570 --> 00:20:16,820
...أدّى إلى فقدان شيء

247
00:20:16,820 --> 00:20:18,160
.كاغاري

248
00:20:19,740 --> 00:20:23,540
،مثلما ظهر المفتاح دائمًا على هيئة كاغاري

249
00:20:23,540 --> 00:20:27,790
.أنا أيضًا، ظهرت كنظيرٍ لها

250
00:20:27,790 --> 00:20:29,080
...يا إلهي

251
00:20:29,080 --> 00:20:32,500
.ظننت أنّي أحمي أحدهم، لكنّني في الواقع كنتُ قاتلها

252
00:20:32,500 --> 00:20:34,460
.لكنّني تغيّرت

253
00:20:34,460 --> 00:20:36,880
.أريد الآن أن أحمي كاغاري

254
00:20:36,880 --> 00:20:38,430
.والفضل يعود إليك

255
00:20:38,430 --> 00:20:40,720
،لأنّكِ أخذتِ مكاني

256
00:20:40,720 --> 00:20:43,470
.لقد تحرّرت من ذلك الدّور

257
00:20:44,010 --> 00:20:46,430
.أشكركِ يا كاشيما ساكورا

258
00:20:46,430 --> 00:20:48,730
...وبهذا أعلن الحرب

259
00:20:48,730 --> 00:20:49,890
،بدءًا من الآن

260
00:20:50,310 --> 00:20:51,440
!أنا عدوّك

261
00:20:53,190 --> 00:20:54,650
.هذا منعطفٌ حاسم

262
00:20:54,650 --> 00:20:57,240
.بحثكِ يقترب من الاكتمال

263
00:20:57,240 --> 00:21:01,200
.لهذا أرسلت كاشيما ساكورا شياطينها

264
00:21:01,200 --> 00:21:04,280
.أصغي، إنّكِ على الطّريق الصّحيح هنا

265
00:21:04,280 --> 00:21:06,870
يجب أن تبذلي كلّ ما بوسعكِ للوصول إلى هدفك

266
00:21:06,870 --> 00:21:09,000
.والعثور على أملٍ للحياة

267
00:21:09,000 --> 00:21:09,870
،ولأجل ذلك

268
00:21:10,330 --> 00:21:11,880
.أريد أن أحصل على بعض المساعدة

269
00:21:11,880 --> 00:21:15,000
.أكره الاعتراف بالأمر، لكنّني لا أستطيع حمايتكِ بمفردي

270
00:21:16,920 --> 00:21:18,260
ما الّذي سأفعله؟

271
00:21:18,260 --> 00:21:19,380
.هذا واضح

272
00:21:26,890 --> 00:21:28,980
.لمّ الجميع معًا لأجل آخر نشاطٍ للنّادي

273
00:21:34,400 --> 00:21:35,770
،إذًا فقد أتيت

274
00:21:36,530 --> 00:21:37,900
.يا كوتوري

275
00:21:37,900 --> 00:21:38,940
.أجل

276
00:21:38,940 --> 00:21:41,360
.لقد جئتُ يا كوتارو-كُن

277
00:21:41,360 --> 00:21:42,780
.لأمدّ يد المساعدة لك

278
00:21:44,200 --> 00:21:45,530
.مرحبًا أيّها الأخ

279
00:21:45,530 --> 00:21:48,910
.يبدو أنّ عرضًا رائعًا ينتظرنا

280
00:21:50,710 --> 00:21:53,380
أنت من قام باستدعائهم. فما الخطب؟

281
00:21:53,380 --> 00:21:55,750
...لا، ما تمنّيته هو

282
00:21:55,750 --> 00:21:58,050
.لقد تأخّرت يا تينّوجي

283
00:22:00,300 --> 00:22:01,380
.يوشينو

284
00:22:02,050 --> 00:22:03,550
هل ستساعدني؟

285
00:22:03,550 --> 00:22:05,140
.كلّا

286
00:22:05,140 --> 00:22:07,510
.أنا أفعل هذا لأسبابي الخاصّة

287
00:22:07,510 --> 00:22:09,310
.لا تغتّر بنفسك كثيرًا

288
00:22:10,730 --> 00:22:13,440
.انظروا من يتكلّم أيّها الجانح

289
00:22:22,320 --> 00:22:25,070
.يا إلهي، لقد تأخّرت كثيرًا

290
00:22:25,070 --> 00:22:25,910
.كوتارو

291
00:22:25,910 --> 00:22:27,200
.بوركت جهودك

292
00:22:27,200 --> 00:22:30,830
استدعيتنا إلى هنا وتأخّرت في الحضور؟ من تظنّ نفسك؟

293
00:22:31,370 --> 00:22:33,620
.تمنّيت عالمًا مثاليًا فشلتُ في بلوغه

294
00:22:33,620 --> 00:22:36,000
.وُعودًا لم أفِ بها

295
00:22:36,000 --> 00:22:39,710
.أقحمتهم في وضعٍ يتطلّب المخاطرة

296
00:22:39,710 --> 00:22:43,590
هل هذا تجسيدٌ لرغباتي الأنانيّة فحسب؟

297
00:22:44,090 --> 00:22:45,930
.أنت مخطئٌ يا كوتارو-كُن

298
00:22:48,760 --> 00:22:50,470
...نحن هنّ نحن

299
00:22:51,470 --> 00:22:53,480
.مثلك تمامًا

300
00:22:53,480 --> 00:22:54,730
فهمت؟

301
00:22:54,730 --> 00:22:56,350
...أنتنّ

302
00:23:00,820 --> 00:23:03,280
!نادي الخوارق عاد للعمل