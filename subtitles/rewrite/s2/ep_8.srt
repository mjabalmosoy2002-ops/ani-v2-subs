1
00:00:03,400 --> 00:00:06,490
أكان عليّ أن أتّصل بك أبكر من هذا؟

2
00:00:06,820 --> 00:00:09,610
.نحن في شهر أبريل الآن، وبدأت بتلات الكرز تتساقط

3
00:00:10,030 --> 00:00:11,240
.لا بأس

4
00:00:11,240 --> 00:00:12,490
على أيّ، كيف هو الوضع؟

5
00:00:13,240 --> 00:00:17,500
.حاليًّا، لا نحن أو غايّا نقوم بتحرّكاتٍ كبيرة

6
00:00:17,500 --> 00:00:19,710
.وكذلك بالنّسبة للمفتاح

7
00:00:19,710 --> 00:00:20,630
...المفتاح

8
00:00:21,000 --> 00:00:25,090
.المفتاح يعود دائمًا إلى حيث وُلد بعد فترة حضانته

9
00:00:25,090 --> 00:00:28,760
.أفضل رهانٍ لدينا هو أن نطوّق المنطقة، لكنّنا نفتقر للقوى العاملة

10
00:00:29,220 --> 00:00:30,680
هل أنت واثقٌ أنّني سأفيدك؟

11
00:00:30,680 --> 00:00:33,390
.لم أكن سوى حملٍ ثقيلٍ على الآخرين هناك

12
00:00:34,390 --> 00:00:37,140
.لم تتغيّر البتّة

13
00:00:37,140 --> 00:00:39,520
.لكنّك جيّد كما أنت

14
00:02:15,160 --> 00:02:17,830
،عندما تقصّيت عن المفتاح أنا وياسمين

15
00:02:17,830 --> 00:02:19,370
.ما وجدناه كان مروّعًا

16
00:02:20,750 --> 00:02:23,620
،حالما وُلد من الأرض على هيأة بشري

17
00:02:23,620 --> 00:02:25,500
.جاب المفتاح الأرض على قدميه

18
00:02:26,170 --> 00:02:28,880
.ليتحقّق في أمر البشريّة المستخلفين في الأرض

19
00:02:29,670 --> 00:02:32,970
،وعندما يحين الوقت لينطق بحكمه

20
00:02:32,970 --> 00:02:36,510
.يسبّب دمارًا هائلًا يكون هو مركزه

21
00:02:44,520 --> 00:02:45,440
...أيعقل

22
00:02:55,320 --> 00:02:56,820
ليست هنا؟

23
00:02:57,280 --> 00:02:58,320
.هذا بديهيّ

24
00:03:00,830 --> 00:03:03,710
أيعقل أنّها استدعتني إلى هنا؟

25
00:03:10,170 --> 00:03:11,840
أنتِ هي المفتاح، صحيح؟

26
00:03:12,920 --> 00:03:13,720
.كاغاري

27
00:03:15,220 --> 00:03:16,130
كاغاري؟

28
00:03:17,680 --> 00:03:19,760
،يفترض أنّها أوّل مرّةٍ أسمع فيها ذلك الاسم

29
00:03:19,760 --> 00:03:21,390
،لكنّه بدا مألوفًا بغرابة

30
00:03:21,390 --> 00:03:23,600
.شعرت بوقعه الجميل على مسمعي

31
00:03:24,810 --> 00:03:25,850
.تينّوجي كوتارو

32
00:03:27,690 --> 00:03:32,190
.ذكريات الكوكب تكتنفها الأحزان حاليًّا

33
00:03:32,190 --> 00:03:36,360
.إن استمرّ هذا، فسيؤول كلّ شيءٍ إلى الخراب

34
00:03:36,360 --> 00:03:37,240
الخراب؟

35
00:03:37,240 --> 00:03:38,950
!ا-انتظري لحظة

36
00:03:38,950 --> 00:03:40,740
سيؤول كلّ شيءٍ إلى الخراب؟

37
00:03:41,200 --> 00:03:42,410
تقصدين الأرض جمعاء؟

38
00:03:42,410 --> 00:03:46,790
،في العادة، الخراب تعقبه إعادة التطوّر

39
00:03:46,790 --> 00:03:49,380
.لكنّ الأرض تفتقر حاليًّا للحيويّة لدعم ذلك

40
00:03:49,710 --> 00:03:51,250
إعادة التطوّر؟

41
00:03:51,630 --> 00:03:55,380
ستبدأ الحياة مجدّدًا من الصّفر وتكرّر نفس التّاريخ قدر الإمكان

42
00:03:55,380 --> 00:03:59,140
.إلى أن تولد الحياة الذكيّة مرّةً أخرى

43
00:03:59,140 --> 00:04:02,430
،مع ذلك، بسبب زيادة استهلاك الموارد الطّبيعيّة

44
00:04:02,430 --> 00:04:04,270
.تضاءلت حيويّة الكوكب

45
00:04:04,930 --> 00:04:08,640
.في ظلّ هذا الوضع، لن تطرأ إعادة تطوّر، حتّى بعد الخراب

46
00:04:09,310 --> 00:04:10,520
وما الّذي سيحدث إذًا؟

47
00:04:10,520 --> 00:04:11,900
.سيموت الكوكب

48
00:04:12,770 --> 00:04:15,400
.هذا مهوِلٌ حقًّا

49
00:04:15,900 --> 00:04:17,400
لماذا تخبرينني بهذا؟

50
00:04:17,400 --> 00:04:21,160
.لأنّ كاغاري وتينّوجي مرتبطان

51
00:04:21,570 --> 00:04:24,290
.لا أحد آخر يستطيع رؤية هيئة كاغاري

52
00:04:24,290 --> 00:04:26,250
هل حدث ذلك عندما تركتكِ تذهبين؟

53
00:04:26,250 --> 00:04:28,160
.تواصلنا أيضًا عندما كنتُ أتبرعم

54
00:04:30,120 --> 00:04:32,750
.كان ذلك أوّل شيءٍ تعلّمته

55
00:04:32,750 --> 00:04:38,590
.أعتقد أنّ ما فعلته كان تجلٍّ للحبّ أو الإخلاص

56
00:04:38,590 --> 00:04:39,340
...ذ-ذلك كان

57
00:04:39,340 --> 00:04:43,760
.بعبارةٍ أخرى، أنت متيّمٌ بي

58
00:04:43,760 --> 00:04:45,640
!مهلًا، مهلًا، مهلًا

59
00:04:46,850 --> 00:04:49,850
أنتِ من ستُحدث ذلك "الخراب،" صحيح؟

60
00:04:49,850 --> 00:04:51,650
هل من طريقةٍ لأجعلكِ تعدلين عن ذلك؟

61
00:04:54,900 --> 00:05:01,450
.الخراب يحدث تلقائيًّا عندما تغمرني الذّكريات الحزينة

62
00:05:01,450 --> 00:05:03,160
،ثمّة طريقةٌ واحدة لمنعه

63
00:05:03,570 --> 00:05:04,780
.ذكريات جميلة

64
00:05:05,030 --> 00:05:07,200
ذكريات جميلة؟ مثل ماذا؟

65
00:05:07,200 --> 00:05:08,830
.لا أعرف

66
00:05:08,830 --> 00:05:11,870
.كلّ ما يمكنني قوله هو أنّها ذكريات سأعتبرها جميلة

67
00:05:11,870 --> 00:05:16,300
.وأحتاج خادمًا لأؤثّر على الإنسان العاقل

68
00:05:16,300 --> 00:05:17,170
خادم؟

69
00:05:17,800 --> 00:05:20,420
.ألتمس مساعدتك لتحقيق تلك الغاية

70
00:05:20,420 --> 00:05:22,930
.اجلب لي الذّكريات الجميلة

71
00:05:25,300 --> 00:05:27,100
،وعرفانًا لمساعدتك

72
00:05:27,100 --> 00:05:29,060
.لن أمانع تلبية رغباتك الجنسيّة

73
00:05:29,060 --> 00:05:30,020
!مهلًا

74
00:05:30,020 --> 00:05:31,810
.لا تضيفي كلماتٍ مضلّلة

75
00:05:33,150 --> 00:05:36,070
إ-إذًا، هل ستسمحين لي بتحسّس صدركِ مثلًا؟

76
00:05:36,320 --> 00:05:38,360
،إن ساعدتني على إنقاذ هذا الكوكب

77
00:05:38,360 --> 00:05:42,150
.فسأزني معك حتّى في أسوأ الحالات

78
00:05:42,150 --> 00:05:44,570
مهلًا، أقلتِ في أسوأ الحالات؟

79
00:05:44,820 --> 00:05:47,660
كما أنّ اسمك سيخلّد في التّاريخ

80
00:05:47,660 --> 00:05:54,210
".باعتبارك "البشريّ الّذي أنقذ الكوكب وتحسّس صدر كاغاري كمكافأة

81
00:05:54,210 --> 00:05:55,750
!أفضّل أن أبقى مجهولًا

82
00:05:58,670 --> 00:06:00,590
إنقاذ الأرض؟

83
00:06:01,090 --> 00:06:02,380
ارفض

84
00:06:01,090 --> 00:06:03,090
ساعدها

85
00:06:04,470 --> 00:06:05,800
.سأساعدكِ

86
00:06:05,800 --> 00:06:07,050
هل أنت واثق؟

87
00:06:07,050 --> 00:06:08,390
.لن أتراجع عن كلامي

88
00:06:08,390 --> 00:06:09,720
ما هو وضعنا الآن؟

89
00:06:10,020 --> 00:06:12,140
.لا وقت لنضيّعه

90
00:06:12,140 --> 00:06:14,230
يجب أن نجد الذّكريات الجميلة بأقرب وقتٍ ممكن

91
00:06:14,230 --> 00:06:16,860
.لتجنّب بدء إعادة التطوّر

92
00:06:17,440 --> 00:06:19,980
الذّكريات الجميلة؟

93
00:06:19,980 --> 00:06:22,150
،لا فكرة لديّ عن ماهيّتها لأصارحكِ القول

94
00:06:22,150 --> 00:06:23,450
.لكن لا بدّ لنا من فعلها

95
00:06:23,450 --> 00:06:28,120
.للأسف، لا أفهم البشر بما يكفي لأحدّدها لك

96
00:06:28,450 --> 00:06:31,700
لكنّني أشعر أنّ أحد الأسباب الرّئيسيّة للذّكريات الحزينة

97
00:06:31,700 --> 00:06:34,750
.هو الصّراع الدّائر بين الإنسان العاقل وأخيه

98
00:06:34,750 --> 00:06:36,540
صراع؟

99
00:06:36,540 --> 00:06:39,340
هل إيقاف أحدها سيجلب لكِ ذكرى جميلة؟

100
00:06:39,340 --> 00:06:41,670
،ماذا لو لم يكن صراعًا محدودًا

101
00:06:41,670 --> 00:06:43,510
بل صراعًا يشمل العالم أجمع؟

102
00:06:44,720 --> 00:06:47,260
مثل الصّراع بين غيّا والغارديان؟

103
00:06:47,850 --> 00:06:49,390
أيمكنني حقًّا فعلها؟

104
00:06:49,390 --> 00:06:52,180
.لا، أنا الوحيد القادر على ذلك

105
00:06:52,680 --> 00:06:54,230
،كنت متورّطًا مع كلا الطّرفين

106
00:06:54,520 --> 00:06:57,190
.لكنّني لم أشعر قطّ بالانتماء لأحدهما

107
00:06:57,940 --> 00:06:59,440
.وأنا الوحيد

108
00:06:59,940 --> 00:07:03,820
.الأعداء مهولون والوقوف في وجههم جنونٌ حقيقيّ

109
00:07:03,820 --> 00:07:04,950
...لكن

110
00:07:05,240 --> 00:07:10,200
كاغاري، ما رأيكِ بأن نحاول منع موت الكوكب معًا؟

111
00:07:10,740 --> 00:07:13,000
.لطالما كان هذا ما أبتغيه

112
00:07:20,670 --> 00:07:22,630
أهذا أنت يا تينّوجي؟

113
00:07:22,920 --> 00:07:24,300
ومن غيري؟

114
00:07:24,300 --> 00:07:26,550
.تبدو شخصًا مختلفًا كلّيًّا

115
00:07:26,550 --> 00:07:27,640
.الأمر ينطبق عليكما أيضًا

116
00:07:28,470 --> 00:07:30,050
المناطق الرّئيسيّة الّتي علينا مراقبتها

117
00:07:30,050 --> 00:07:33,060
.هي المحطّة والشّارع الرّئيسيّ الّذي يمرّ عبر وسط المدينة

118
00:07:33,060 --> 00:07:35,350
.ثم لدينا المنطقة المحيطة بالمعبد

119
00:07:35,350 --> 00:07:37,110
،ثمّة العديد من الأهداف لمراقبتها

120
00:07:37,110 --> 00:07:38,520
...لكن أكثرها أهميّة بالطّبع

121
00:07:38,810 --> 00:07:40,520
.المفتاح

122
00:07:40,520 --> 00:07:43,990
...سمعت أنّ بشرًا خارقين يستطيعون رصده

123
00:07:43,990 --> 00:07:46,900
أتذكر أونيشي من فريق ميكوني؟

124
00:07:46,900 --> 00:07:47,660
أونيشي؟

125
00:07:49,030 --> 00:07:51,490
.هو إذًا

126
00:07:52,660 --> 00:07:53,540
.حسنًا

127
00:07:53,540 --> 00:07:56,910
ما رأيكما أن أتولّى هذه المنطقة ذات الأولويّة المنخفضة؟

128
00:07:56,910 --> 00:07:59,580
.نعم، منطقة الغابة لن تشكّل مشكلة

129
00:07:59,580 --> 00:08:03,170
لكن لا تنس نفسك وتصطاد الشّياطين في الأنحاء، أفهمت يا أيّها البطل العظيم؟

130
00:08:03,170 --> 00:08:04,300
.إمامييا

131
00:08:04,300 --> 00:08:05,720
.أعرف

132
00:08:05,720 --> 00:08:07,170
.لم أعد طفلًا بعد الآن

133
00:08:07,170 --> 00:08:08,430
.سأركّز على المراقبة

134
00:08:08,760 --> 00:08:11,100
.أنا بارعٌ في تلك المهام المملّة

135
00:08:11,100 --> 00:08:13,310
.لقد نضجت كثيرًا

136
00:08:14,970 --> 00:08:17,810
.سعيدٌ لمجيئي إلى هنا أوّلًا يا إمامييا

137
00:08:17,810 --> 00:08:20,810
...حصلت على تصريحٍ للعمل منفردًا وتلقّيت معلوماتٍ سريّة

138
00:08:21,230 --> 00:08:24,070
.إنّها هديّةٌ مثاليّة لخائنٍ مثلي

139
00:08:26,530 --> 00:08:29,360
.رتّبت الأمور لأتمكّن من العمل بحريّة

140
00:08:29,360 --> 00:08:32,070
.حتّى أنّي دبّرت مخبئًا آمنًا في حالة احتجته

141
00:08:34,620 --> 00:08:35,580
...التّالي

142
00:08:39,580 --> 00:08:42,670
،متطرّفو غايّا يتشاركون في صفاتٍ عدّة

143
00:08:42,670 --> 00:08:45,460
،يفتقرون للثّقة، ويبغضون العالم

144
00:08:45,460 --> 00:08:49,590
.إنّهم أُناسٌ سلبيّون يرون أنّ الحياة عقيمة

145
00:08:49,590 --> 00:08:51,840
.أجل. إنّهم أُناسٌ مثلي تمامًا

146
00:08:53,800 --> 00:08:54,470
،ولهذا

147
00:08:54,930 --> 00:08:56,680
.لم أحتج للتّظاهر

148
00:08:56,680 --> 00:08:59,440
.يمكن القول أنّ من الطّبيعيّ أنّهم اختاروني

149
00:09:01,690 --> 00:09:05,650
لا بدّ أنّ جميع الحاضرين هنا قد سئموا من هذا العالم

150
00:09:05,650 --> 00:09:08,940
.وعهدتم آمالكم وأحلامكم للحياة القادمة

151
00:09:09,950 --> 00:09:11,200
،ولأجل ذلك

152
00:09:11,200 --> 00:09:15,080
.يجب عليكم تطهير حيواتكم إلى جوهرها

153
00:09:15,080 --> 00:09:17,750
.وهذه طريقة فعلها

154
00:09:23,040 --> 00:09:24,380
،أنظروا إلى هذا الشّيطان

155
00:09:24,380 --> 00:09:26,130
فقط لأنّني منحته بعضًا من روحي

156
00:09:26,130 --> 00:09:29,590
.اتّخذ هذا الشّكل الشّنيع

157
00:09:29,590 --> 00:09:32,640
.هذا دليلٌ على أنّ أرواح كلّ البشر فاسدة

158
00:09:32,640 --> 00:09:35,140
إذٔا فأرواحنا ملوّثةٌ حقًّا؟

159
00:09:35,390 --> 00:09:37,260
.لا يمكننا مواصلة العيش في هذا العالم

160
00:09:37,260 --> 00:09:38,850
،لكن في الوقت نفسه

161
00:09:38,850 --> 00:09:42,900
.هذه الشّياطين هي أيضًا تجلٍّ للرّغبة النّبيلة لتغيير العالم

162
00:09:43,150 --> 00:09:46,730
،إن كان بإمكانهم جعل العالم أفضل ولو قليلًا

163
00:09:46,730 --> 00:09:50,530
،وتطهير الحيوات المستقبليّة الملوثّة

164
00:09:50,530 --> 00:09:53,160
.فذلك لا يمكن وصفه إلّا بالخلاص الحقيقيّ

165
00:09:54,280 --> 00:09:55,530
.أيّها الرّفاق

166
00:09:55,530 --> 00:09:58,160
.انضمّوا إليّ لنسير معًا في الدّرب نحو الخلاص

167
00:09:58,950 --> 00:10:01,540
.بدأنا التّدريب على فنون الاستحضار

168
00:10:06,500 --> 00:10:08,500
الخطوة الأولى لتصبح مستحضرًا

169
00:10:08,500 --> 00:10:10,920
هي عبر ما يسمّى إبرام العقد

170
00:10:10,920 --> 00:10:12,920
.وذلك بربط حياتك إلى شيطان

171
00:10:16,260 --> 00:10:17,300
...رابط العقد

172
00:10:18,010 --> 00:10:21,810
.الدّليل على أنّ قوّة حياتي تجذّرت في شيءٍ كشكل حياةٍ عابر

173
00:10:22,140 --> 00:10:24,310
.الخطوة الثّانية هي اكتساب الخبرة

174
00:10:24,650 --> 00:10:26,940
.إبرام العقود مع الشّياطين والتحكّم بها

175
00:10:31,610 --> 00:10:33,110
،إن قُطع رابط العقد

176
00:10:33,110 --> 00:10:35,320
.فستفقد السّيطرة على الشّياطين

177
00:10:35,570 --> 00:10:37,950
،صنف الحيوان سيموت على الفور

178
00:10:37,950 --> 00:10:39,740
،لكنّ صنف الحشرات أكثر مقاومة

179
00:10:39,740 --> 00:10:43,040
.فيجلون في الأنحاء ويتبعون غرائزهم لبعض الوقت

180
00:10:43,040 --> 00:10:44,210
،وأستطرد

181
00:10:44,210 --> 00:10:46,670
الإشاعات عن ظهور اليوما في الغابة

182
00:10:46,670 --> 00:10:50,210
.كانت على ما يبدو بسبب الشّياطين الخارجة عن السّيطرة كهذه

183
00:10:51,210 --> 00:10:55,840
.ويبدو أنّي لا أبرع كمستحضر

184
00:10:56,550 --> 00:10:59,600
.لستُ بمستوى ياسمين والآخرين، اللّذين تعلّموا بأنفسهم

185
00:11:01,310 --> 00:11:03,350
.وأخيرًا، الخلق

186
00:11:03,350 --> 00:11:04,600
،كما يوحي الاسم

187
00:11:04,600 --> 00:11:06,850
.يتعلّق الأمر بخلق شيطانٍ من الصّفر

188
00:11:06,850 --> 00:11:10,320
...يفترض أن يكون ذلك أصعب من التحكّم بأحدها، لكن

189
00:11:12,530 --> 00:11:16,360
.اندهشت من نفسي لتمكّني من فعلها

190
00:11:16,360 --> 00:11:17,620
...لكن بسبب هذا

191
00:11:23,120 --> 00:11:25,920
.أصبحت عضوًا رسميًّا في غايّا

192
00:11:29,500 --> 00:11:32,590
.لقد تسلّلت بنجاحٍ إلى مارتيل... غايّا

193
00:11:32,590 --> 00:11:34,510
.سأبدأ في التحرّي عن شؤونهم الدّاخليّة

194
00:11:34,510 --> 00:11:38,220
.إن أمكنني، فسأحاول إيقاف بحثهم عنك

195
00:11:38,220 --> 00:11:40,180
أتظنّ أنّنا نملك الوقت لذلك؟

196
00:11:40,180 --> 00:11:43,270
.تحضّر للقضاء على غايّا في الحال

197
00:11:43,600 --> 00:11:45,940
.لا تطلبي المستحيل يا كاغاري

198
00:11:45,940 --> 00:11:48,770
.أنا لستُ بطلًا خارقًا يستطيع فعل كلّ شيء

199
00:11:48,770 --> 00:11:50,900
.إذًا فلتعزّز نفسك

200
00:11:53,400 --> 00:11:56,280
أتظنّني عمياء؟

201
00:11:56,280 --> 00:12:00,280
.أعرف أنّك تملك القدرة على تغيير قواك

202
00:12:00,780 --> 00:12:04,540
.افعل ذلك واقضِ على غيّا ومن بعدها الغارديان

203
00:12:09,000 --> 00:12:12,340
لماذا تواصلين طلب ما يستحيل عليّ فعله؟

204
00:12:12,340 --> 00:12:13,920
...كما أنّ تلك القدرة

205
00:12:14,170 --> 00:12:18,550
.إذًا ستنزل كاغاري الحكم على غايّا والغارديان بنفسها

206
00:12:18,550 --> 00:12:20,180
.لا حاجة للقلق

207
00:12:20,180 --> 00:12:23,060
.الإنسان العاقل لا يستطيع رؤيتي

208
00:12:23,890 --> 00:12:25,560
.أنتِ تستخفّين بهم

209
00:12:25,850 --> 00:12:29,560
.يوجد بشرٌ وشياطين يمتلكون القدرة على استشعارك

210
00:12:29,940 --> 00:12:33,320
.أنتِ تملكين قوّةً كبيرة، لكنّها ليست ملائمةً للقتال

211
00:12:33,320 --> 00:12:35,320
.لا تملكين ذرّة معرفةٍ بالمعارك حتّى

212
00:12:35,690 --> 00:12:37,650
.لا وقت لدينا

213
00:12:37,650 --> 00:12:39,700
لماذا لا تسير الأمور كما أبتغي؟

214
00:12:41,120 --> 00:12:42,950
.أعدكِ أن أجد حلًّا بطريقةٍ ما

215
00:12:42,950 --> 00:12:44,990
،قد يستغرق ذلك بعض الوقت

216
00:12:44,990 --> 00:12:46,370
.لكن ثقي بي

217
00:12:46,370 --> 00:12:48,540
.أنا لن أخونك

218
00:12:48,540 --> 00:12:49,830
.بالطّبع لن تفعل

219
00:12:49,830 --> 00:12:52,210
.الخيانة ليست خيارًا متاحًا

220
00:12:55,420 --> 00:12:56,260
،كاغاري

221
00:12:57,090 --> 00:12:58,300
ما الّذي حدث هنا؟

222
00:12:58,300 --> 00:13:00,590
.شيءٌ تخلّصت منه هذه

223
00:13:00,590 --> 00:13:02,090
،لأتأّكّد فقط

224
00:13:02,090 --> 00:13:04,100
هذه أوّل مرّةٍ يحدث هذا، صحيح؟

225
00:13:04,350 --> 00:13:07,270
عدد الأجسام الّتي تجرّأت على الاقتراب منّي وقضيت عليها

226
00:13:07,270 --> 00:13:10,690
.سجّل في سبعة آلاف وخمسمائةٍ وثمانيةٌ وأربعون

227
00:13:10,690 --> 00:13:11,650
هل أنتِ حمقاء؟

228
00:13:12,900 --> 00:13:15,270
!لا تقتلي شياطين غايّا دون سبب

229
00:13:15,270 --> 00:13:17,780
!سيجعلهم ذلك يكتشفون أنّ شيئًا ما مختبئٌ هنا

230
00:13:17,780 --> 00:13:19,860
،وإن تيقّنوا أنّ المفتاح هنا

231
00:13:19,860 --> 00:13:22,660
!فستنفّذ كلّ من غيّا والغارديان عمليّاتهم الخاصّة

232
00:13:22,660 --> 00:13:24,990
!وسينتهي كلّ شيءٍ في غمضة عين

233
00:13:24,990 --> 00:13:28,250
أيمكن للبشر أن يتعاونوا معًا بهذه السّرعة؟

234
00:13:28,250 --> 00:13:31,540
أتدرين كم مرًةً قُتل المفتاح عبر التّاريخ؟

235
00:13:31,540 --> 00:13:36,300
.البشر هم أبرع الكائنات في التقفّي وصيد الأنواع الغريبة

236
00:13:39,010 --> 00:13:41,470
لم تقتلي أيّ بشريّ، صحيح؟

237
00:13:41,470 --> 00:13:44,890
.لن تمسّ كاغاري أبدًا أيّ إنسانٍ عاقل بمكروهٍ دون سبب

238
00:13:45,140 --> 00:13:46,510
.فهمت

239
00:13:46,510 --> 00:13:49,390
.حاولي الاختباء من تلك الأشياء من الآن فصاعدًا

240
00:13:51,480 --> 00:13:53,400
.يتعذّر عليّ الفهم

241
00:13:53,400 --> 00:13:56,650
كيف يمكن للبشر رغم ذكائهم وإدراكهم الواسع

242
00:13:56,650 --> 00:13:58,610
أن يفشلوا في خلق ذكرياتٍ جميلة؟

243
00:13:58,610 --> 00:14:01,150
لماذا هم راكدون إلى هذا الحدّ؟

244
00:14:02,240 --> 00:14:03,320
...هذا

245
00:14:03,320 --> 00:14:05,280
أتساءل لماذا؟

246
00:14:06,580 --> 00:14:08,120
.أنا أيضًا لا أعرف الجواب

247
00:14:12,290 --> 00:14:14,880
.سوزاكي شويتشيرو، اثنان وخمسون سنة

248
00:14:15,580 --> 00:14:18,170
قائد مجموعة مارتيل اليابان والمسؤول عن عمليّاتها التّجاريّة

249
00:14:18,170 --> 00:14:21,050
.وأحد الدّوافع الرّئيسيّة لازدهارها

250
00:14:23,930 --> 00:14:26,300
أغلب الأشخاص الّذين يأتون إلى مارتيل

251
00:14:26,300 --> 00:14:29,680
.يسعون إلى الهروب من هذا العالم

252
00:14:29,680 --> 00:14:32,140
ألست كذلك يا سوزوكي-كُن؟

253
00:14:33,640 --> 00:14:35,310
.نعم، هذا صحيح

254
00:14:36,560 --> 00:14:40,980
،لـ-لكن بعد أن عرفت أنّي أمتلك مثل تلك القوّة

255
00:14:40,980 --> 00:14:45,280
.حسنٌ، أعتقد أنّي أستطيع فعل شيء

256
00:14:45,570 --> 00:14:48,950
تقصد أنّك تريد تسلّق القمّة؟

257
00:14:51,790 --> 00:14:55,420
،على خلاف طائفة القدّيسة، عبدة كاشيما ساكورا الّذين سئموا من العالم

258
00:14:55,420 --> 00:14:58,540
.طائفة سوزاكي تولي الأهميّة إلى تحقيق الأرباح من هذا العالم

259
00:14:58,920 --> 00:15:03,340
.استغلال طبيعتهم مكّنني من التقرّب منه، رغم كوني مستجدًّا

260
00:15:03,670 --> 00:15:06,340
.نمت مارتيل لتصبح منظّمةً كبرى

261
00:15:06,340 --> 00:15:09,350
.وذلك جعلها تعاني من تسريبٍ متكرّر للمعلومات

262
00:15:10,510 --> 00:15:13,230
تريدني أن أجري تحقيقًا داخليًّا؟

263
00:15:13,680 --> 00:15:17,060
.لستُ أطلب منك القيام بعملٍ احترافيّ

264
00:15:17,060 --> 00:15:19,400
عليك فقط أن تنتبه للإشاعات

265
00:15:19,400 --> 00:15:22,360
.وتمدّني بآرائك الصّريحة

266
00:15:22,360 --> 00:15:25,110
.وبالطّبع سيكون أفضل إن اكتشفت من يقف خلفها

267
00:15:25,110 --> 00:15:27,950
.إذًا فهدفه هو طائفة القدّيسة

268
00:15:27,950 --> 00:15:30,950
.يريد إضعاف سيطرة كاشيما ساكورا على المنظّمة

269
00:15:30,950 --> 00:15:31,950
.فهمت

270
00:15:31,950 --> 00:15:33,500
.سأفعل كلّ ما بوسعي

271
00:15:36,620 --> 00:15:38,630
.استخدم هذه الشّياطين

272
00:15:39,040 --> 00:15:41,920
،إنّها من صنف النّبات ولا تحتاج الأوكسجين

273
00:15:41,920 --> 00:15:44,050
.لِذا لن تنقص فترة حياتك كثيرًا

274
00:15:44,050 --> 00:15:47,380
.ويمكنك استخدام هذا لإجراء تحضيراتك

275
00:15:52,720 --> 00:15:54,270
.شكرًا جزيلًا لك

276
00:15:54,520 --> 00:15:56,690
.طائفة القدّيسة وطائفة سوزاكي

277
00:15:56,690 --> 00:15:59,270
...يمكنني استغلال هذا الانقسام في شيء

278
00:16:00,270 --> 00:16:01,150
!سحقًا

279
00:16:01,150 --> 00:16:02,650
!إنّها بالفعل ليست هنا

280
00:16:02,650 --> 00:16:05,490
.عادةً ما تظهر حتّى وإن لم أقل شيئًا

281
00:16:05,490 --> 00:16:07,400
...لكن لا أثر لها على الإطلاق، ممّا يعني

282
00:16:08,740 --> 00:16:12,660
ألا تدرك أنّ أمرها سينتهي حالما يجدونها؟

283
00:16:14,660 --> 00:16:16,910
.لم أتوقّع أنّي سأعتمد على هذه بهذه السّرعة

284
00:16:18,500 --> 00:16:20,380
،لا يمتلكون نظرًا ثاقبًا

285
00:16:20,380 --> 00:16:22,040
.لكنّهم يمتلكون حاسّة شمّ قويّة

286
00:16:22,340 --> 00:16:24,130
.إنّهم مثاليّون لهذا العمل

287
00:16:24,130 --> 00:16:26,880
!تقفّوا أقوى رائحة خُضرةٍ يمكنكم التقاطها

288
00:16:26,880 --> 00:16:28,130
!إنّها كاغاري

289
00:16:32,220 --> 00:16:33,810
لِم فعلتِ هذا؟

290
00:16:34,140 --> 00:16:36,230
!لا أصدّق أنّكِ ذهبتِ إلى المدينة

291
00:16:36,230 --> 00:16:39,850
.كان ذلك ضروريّا لزيادة فهمي للإنسان العاقل

292
00:16:39,850 --> 00:16:42,730
.رأيت أنّ ذلك سيساعدني في بلوغ هدفي

293
00:16:42,730 --> 00:16:46,280
ما الفائدة من ذلك إن قصدتي مرمى أعدائكِ مباشرةً؟

294
00:16:47,320 --> 00:16:49,490
.إيّاك أن تظهر العداء تجاه كاغاري

295
00:16:49,490 --> 00:16:51,410
!أنا غاضبٌ لأنّني قلقٌ عليك

296
00:16:53,700 --> 00:16:55,830
.كاغاري متردّدةٌ الآن

297
00:16:56,200 --> 00:16:58,710
.لا أعرف إن كان عليّ اتّباع قراراتك

298
00:16:58,710 --> 00:17:00,870
ألا تريدين إنقاذ الأرض؟

299
00:17:00,870 --> 00:17:03,250
.بلى، لكنّنا ما زلنا لم نحرّك ساكنًا

300
00:17:04,670 --> 00:17:06,340
كم مرّةً عليّ أن أعيد نفس الكلام؟

301
00:17:06,710 --> 00:17:08,050
!أرجوك

302
00:17:10,090 --> 00:17:11,640
.فهمت

303
00:17:11,640 --> 00:17:12,550
.سأنتظر

304
00:17:14,600 --> 00:17:15,640
.شكرًا لك

305
00:17:17,520 --> 00:17:19,770
.لا تخذل كاغاري

306
00:18:14,360 --> 00:18:15,990
.سأبقي ذلك في بالي

307
00:18:23,170 --> 00:18:25,290
قلقة؟

308
00:18:34,550 --> 00:18:36,300
ما هذا؟

309
00:18:42,140 --> 00:18:43,060
!ا-انتظر

310
00:18:44,520 --> 00:18:47,810
أ-أنت كوتارو-كُن، صحيح؟

311
00:18:49,320 --> 00:18:51,400
أهذه أنتِ يا كوتوري؟

312
00:18:52,030 --> 00:18:55,320
هل أقمتِ ذلك الحاجز يا كوتوري؟

313
00:18:55,990 --> 00:18:59,080
لِم أنتما معًا؟

314
00:19:00,580 --> 00:19:02,000
...هذا

315
00:19:04,370 --> 00:19:05,830
،قبل ثلاث سنوات

316
00:19:05,830 --> 00:19:07,580
،في اليوم الّذي تركت فيه المنزل

317
00:19:07,880 --> 00:19:09,840
.تعرّضت عائلة كانبي لحادثة سير في أحد الجبال

318
00:19:10,840 --> 00:19:12,800
،النّاجي الوحيد كان كوتوري

319
00:19:12,800 --> 00:19:18,350
.وورثت قوّة الكهنة، المستحضرون القدماء الّذين يعبدون كاغاري

320
00:19:18,800 --> 00:19:22,140
.بالإضافة إلى واجب حماية كاغاري

321
00:19:22,140 --> 00:19:23,100
...وبعدها

322
00:19:23,100 --> 00:19:25,770
،التقت كوتوري وكاغاري قبل سنتين

323
00:19:25,770 --> 00:19:28,810
.والغريب في الأمر، أنّه نفس اليوم الّذي قابلت فيه كاغاري

324
00:19:28,810 --> 00:19:31,980
،ومن حينها وهي تزور كاغاري بانتظام

325
00:19:31,980 --> 00:19:35,240
.لكنّنا لم نلتقِ من قبل حتّى يومنا هذا

326
00:19:35,240 --> 00:19:36,450
.يا له من أمرٍ مضحك

327
00:19:36,450 --> 00:19:37,280
.لا

328
00:19:37,280 --> 00:19:39,620
.ليس كذلك مطلقًا

329
00:19:47,120 --> 00:19:48,380
...هل هذا

330
00:19:49,080 --> 00:19:52,960
.كنتُ أخبّئ كاغاري-سان داخل الحاجز طوال الوقت

331
00:19:52,960 --> 00:19:56,220
.لكنّها لا تلازم مكانها أبدًا

332
00:19:56,220 --> 00:19:59,760
.كنتُ أعزّز الحاجز اليوم وحينها ظهرت

333
00:20:00,550 --> 00:20:02,890
إذًا فقد كنتِ تحمين كاغاري طوال الوقت، صحيح؟

334
00:20:03,310 --> 00:20:04,560
،لو لم أفعل

335
00:20:04,560 --> 00:20:08,060
.لما اكتسبت القوّة لإنقاذ أمّي وأبي

336
00:20:08,270 --> 00:20:09,440
.هكذا إذًا

337
00:20:11,980 --> 00:20:13,530
.لحظة يا كوتوري

338
00:20:13,530 --> 00:20:16,110
كيسكي-سان وريكاكو-سان

339
00:20:16,110 --> 00:20:17,900
فارقا الحياة، صحيح؟

340
00:20:17,900 --> 00:20:20,570
.نعم، لكنّهما عادا إلى الحياة

341
00:20:20,570 --> 00:20:22,450
.لكنّهما ما يزالان يتصرّفان بغرابةٍ قليلًا

342
00:20:22,910 --> 00:20:24,450
...مهلًا، أهذا يعني

343
00:20:24,750 --> 00:20:25,830
جعلتِ منهما شيطانين؟

344
00:20:26,580 --> 00:20:29,080
حوّلتِ جثثًا بشريّة إلى شياطين؟

345
00:20:30,500 --> 00:20:33,040
هل أنتِ حمقاء؟ ما الّذي تفكّرين فيه؟

346
00:20:33,040 --> 00:20:35,130
!ذلك لن يعيدهم للحياة

347
00:20:35,130 --> 00:20:36,420
!إنّهما محض شيطانين

348
00:20:36,420 --> 00:20:38,010
!زومبي

349
00:20:38,010 --> 00:20:40,180
.هذا ليس صحيحًا

350
00:20:40,180 --> 00:20:44,470
...سيستغرق ذلك بعض الوقت، لكن يومًا ما

351
00:20:44,470 --> 00:20:46,810
!يستحيل أن يعود الموتى إلى الحياة

352
00:20:47,730 --> 00:20:49,020
!اعقلي

353
00:20:49,020 --> 00:20:52,440
!أنتِ فتاةٌ نبيهة، لِذا ينبغي أن تعرفي أنّ ما تفعلينه ليس صائبًا

354
00:20:52,440 --> 00:20:54,900
أنى لي أن أعرف؟

355
00:20:55,980 --> 00:20:58,780
.هذه الفتاة بالتّأكيد ستحمي كاغاري

356
00:20:59,030 --> 00:21:03,030
.ينبغي أن تكون الآن قادرًا على صبّ تركزيك على القتال دون القلق عليّ

357
00:21:03,030 --> 00:21:04,410
!سحقًا لذلك

358
00:21:04,410 --> 00:21:05,990
!لا تورّطي طفلةً في هذا

359
00:21:05,990 --> 00:21:08,540
!حرّري كوتوري حالًا ودعيها تعود إلى المنزل

360
00:21:08,540 --> 00:21:11,790
.إن مات الكوكب، فالأطفال والكبار سيلقون المصير نفسه

361
00:21:11,790 --> 00:21:13,960
!هذا ليس حديثنا الآن

362
00:21:13,960 --> 00:21:15,420
—على أيّ، سأعيد كوتوري إلى

363
00:21:15,420 --> 00:21:16,300
!لن أعود

364
00:21:17,170 --> 00:21:21,380
،لا أعرف ما أسباب كونك هنا مع كاغاري-سان

365
00:21:21,380 --> 00:21:23,930
!لكن، لديّ أيضًا أسبابي لتواجدي هنا

366
00:21:25,220 --> 00:21:27,430
ليس لديكِ أدنى فكرةٍ عن مدى خطورة هذا، أليس كذلك؟

367
00:21:27,430 --> 00:21:32,770
.بلى

368
00:21:28,350 --> 00:21:29,560
.لستِ كذلك

369
00:21:30,390 --> 00:21:31,730
.لستِ كذلك مطلقًا

370
00:21:34,440 --> 00:21:35,690
.لا يهم

371
00:21:35,690 --> 00:21:37,070
.اغربي عن وجهي

372
00:21:37,070 --> 00:21:38,690
.لا أحتاج لجوابك

373
00:21:39,110 --> 00:21:40,780
كوتارو-كُن؟

374
00:21:40,780 --> 00:21:42,990
.لا حاجة لوجودكِ هنا

375
00:21:42,990 --> 00:21:45,080
—إن رفضتِ، فسأجبركِ

376
00:21:46,450 --> 00:21:47,700
لماذا؟

377
00:21:47,700 --> 00:21:50,410
!رغم أنّي لم أعش سوى الحزن

378
00:21:50,410 --> 00:21:52,830
لماذا لا تكون ألطف معي؟

379
00:21:53,170 --> 00:21:55,540
ألم يكن هذا حالنا دائمًا؟

380
00:21:55,540 --> 00:21:59,130
أتريدني أن أعيش بقية حياتي دون أحدٍ إلى جانبي؟

381
00:22:01,590 --> 00:22:06,220
!أبي وأمّي الوحيدان اللّذان عاملاني بلطف

382
00:22:10,060 --> 00:22:12,770
،كانت المرّة الثّانية الّتي أرى فيها دموع كوتوري

383
00:22:12,770 --> 00:22:16,980
.ولم أتوقّع أبدًا أنّ ذلك سيفطر قلبي

384
00:22:16,980 --> 00:22:22,780
،إن آلت الأرض إلى الخراب وآنت نهايتنا

385
00:22:22,780 --> 00:22:26,160
آمل ألّا يكون آخر ما تقع عليه عيناي

386
00:22:26,160 --> 00:22:28,330
.دموع فتاة

387
00:22:31,330 --> 00:22:41,840
العالم الّذي تحيَين فيه عالمٌ لا يغفو ونقيٌّ أصيل

388
00:22:43,050 --> 00:22:53,980
إن كان لكِ أثرٌ باقٍ هنا، فليكن على الأقلّ خيالك

389
00:22:54,770 --> 00:23:08,280
لا أستطيع حتّى فعل شيءٍ بسيط كالتّحديق إلى السّماء، لِذا سأغمض عيناي فحسب

390
00:23:08,120 --> 00:23:18,670
لكنّني أريدكِ أن تجدي شيئًا واحدًا

391
00:23:18,790 --> 00:23:30,430
حبّي المدفون في الذّكريات

392
00:23:30,560 --> 00:23:42,280
ليكون الفجر الّذي نبلغه بعد عبور الأزمان

393
00:23:42,360 --> 00:23:48,200
قدرًا يباركه الخلاص

394
00:23:49,320 --> 00:23:59,080
ما دامت هذه الأنشودة تصلك