1
00:00:01,400 --> 00:00:04,280
،مضت فترةٌ قصيرة بعد ذلك

2
00:00:04,280 --> 00:00:06,650
.ووطأتُ إلى محيطٍ جديدٍ كليًّا

3
00:00:06,650 --> 00:00:09,280
.لكن كلّ ما فعلته هو أنّي تخرّجت من الإعداديّة

4
00:01:42,960 --> 00:01:44,710
،حتّى بعد أن قرّرت مغادرة مارتيل

5
00:01:45,250 --> 00:01:48,460
.كنتُ أحضر اللّقاءات مع والديّ

6
00:01:50,420 --> 00:01:53,970
.خطّتي كانت أن أبتعد شيئًا فشيئًا بدل خلق ضجّةٍ بالمغادرة فجأة

7
00:01:54,470 --> 00:01:55,890
.قرارٌ جبان، أعلم

8
00:01:55,890 --> 00:01:57,220
.أنا جبان

9
00:02:13,570 --> 00:02:16,530
هل أنت ابن عائلة تينّوجي؟

10
00:02:17,870 --> 00:02:21,870
.ركيزة مارتيل، كاشيما ساكورا

11
00:02:21,870 --> 00:02:26,750
.حتّى أنّ الأعضاء المخلصين في المنظمّة يدعونها بالقدّيسة

12
00:02:29,340 --> 00:02:33,300
.طلب منّي والديك أن أتحدّث إليك

13
00:02:33,300 --> 00:02:35,510
بشأن تغيّبي عن اللّقاءات؟

14
00:02:35,510 --> 00:02:38,180
.كلّا. مجرّد دردشةٍ غير رسميّة

15
00:02:38,180 --> 00:02:39,680
...دعني أرى

16
00:02:39,680 --> 00:02:41,020
هل تستمتع بوقتك في المدرسة؟

17
00:02:41,020 --> 00:02:43,730
المدرسة؟

18
00:02:43,730 --> 00:02:46,520
.انهالت عليّ بوابلٍ من الأسئلة

19
00:02:46,520 --> 00:02:50,110
.تخلّلتها بعض الكلمات الغريبة

20
00:02:50,110 --> 00:02:50,940
.ليل

21
00:02:50,940 --> 00:02:51,860
.غابة

22
00:02:51,860 --> 00:02:52,690
.شيطان

23
00:02:52,690 --> 00:02:53,610
.صيد

24
00:02:53,610 --> 00:02:54,900
.قدرات خارقة

25
00:02:55,740 --> 00:02:57,910
.بدا الأمر وكأنّها تحقّق معي

26
00:03:00,410 --> 00:03:02,200
.أظنّني فهمت

27
00:03:02,200 --> 00:03:04,830
.أنت في عمرٍ حيث تشغل بالك أمورٌ كثيرة يا كوتارو

28
00:03:04,830 --> 00:03:05,750
...صحيح

29
00:03:07,500 --> 00:03:10,250
.أجبني عن سؤالٍ أخير

30
00:03:10,250 --> 00:03:14,970
ماذا تفعل في العادة عندما تصادف شيئًا لا تستطيع تقبّله؟

31
00:03:14,970 --> 00:03:16,380
ما قصدك؟

32
00:03:16,800 --> 00:03:21,890
هل تسعى جاهدًا لتغيير نفسك أم تحاول تغيير محيطك؟

33
00:03:21,890 --> 00:03:24,600
أم شيءٌ غير ذلك؟

34
00:03:24,600 --> 00:03:25,890
...أنا

35
00:03:31,360 --> 00:03:34,400
.لا أدري. لم أفكّر بذلك من قبل

36
00:03:36,240 --> 00:03:37,410
.فهمت

37
00:03:37,410 --> 00:03:40,030
.لا بدّ أنّك هائم

38
00:03:43,660 --> 00:03:45,660
!شكرًا لكما

39
00:03:45,660 --> 00:03:48,420
.كعكة الشّكولاتة لهذا اليوم كانت رائعة

40
00:03:48,750 --> 00:03:49,420
.بالفعل

41
00:03:49,420 --> 00:03:54,050
.كانت لذيذةً بقدر تلك الّتي أكلتها في محلّ "كريم شانتيّ" أحد المرّات

42
00:03:54,510 --> 00:03:58,050
.أعتقد أنّنا بهذا نكون قد قصدنا جميع محلّات الحلويّات في المدينة

43
00:03:58,050 --> 00:03:58,930
.بالفعل

44
00:04:01,680 --> 00:04:04,060
.المعذرة يا إساكا-سان

45
00:04:05,310 --> 00:04:09,190
.أشكرك على قضاء الوقت معي دائمًا

46
00:04:09,190 --> 00:04:10,350
.تينّوجي-كُن

47
00:04:10,350 --> 00:04:11,310
نعم؟

48
00:04:11,310 --> 00:04:15,400
.صداقةٌ لا تشوبها مصالح خاصّة لهي شيءٌ نادرٌ وثمين

49
00:04:15,400 --> 00:04:18,240
.الصّداقة المبنيّة على المصلحة تشعر بالأسى

50
00:04:18,240 --> 00:04:19,320
.بالفعل

51
00:04:19,320 --> 00:04:23,580
.لكن، اليوم قد يكون نهاية هذه العلاقة

52
00:04:25,040 --> 00:04:27,080
.أريد أن أتحدّث معك حول شيءٍ ما

53
00:04:27,080 --> 00:04:28,370
أيمكنك الإنصات؟

54
00:04:36,170 --> 00:04:40,720
.أنأ أفكّر بأن أجنّدك معنا يا تينّوجي-كُن

55
00:04:40,720 --> 00:04:43,220
.يجب أن تنضمّ إلى منظّمتنا

56
00:04:43,680 --> 00:04:45,850
.حيث ينتمي البشر الخارقون أمثالك

57
00:04:45,850 --> 00:04:47,520
".بشرٌ خارقون"

58
00:04:47,520 --> 00:04:49,640
.هذا ما قاله إساكا-سان

59
00:04:49,640 --> 00:04:52,150
.أشخاصٌ يمتلكون قدراتٍ مثلي

60
00:04:52,150 --> 00:04:54,020
،وإساكا-سان أحدهم

61
00:04:54,020 --> 00:04:57,740
.وهو عضوٌ في منظّمةٍ تحارب الشّياطين

62
00:04:57,740 --> 00:05:01,660
.ما رأيته في الغابة تلك اللّيلة كان في الواقع حقيقيًّا

63
00:05:02,280 --> 00:05:07,040
شعرت أنّ كلّ ذلك الوقت الّذي قضيته
.في اصطيّاد الوحوش محض لعب أطفال

64
00:05:07,040 --> 00:05:08,660
.اجتاحني الخجل من نفسي

65
00:05:09,040 --> 00:05:11,790
"الصيّاد منقذ الأرض"؟ بما كنت أهذي؟

66
00:05:13,380 --> 00:05:16,130
.في تلك اللّيلة، خُضت جدلًا مع والديّ

67
00:05:16,670 --> 00:05:20,630
.أخبرتهم أنّي أريد مغادرة مارتيل نهائيًا

68
00:05:21,180 --> 00:05:23,390
،تعالت أصواتنا حتّى وقتٍ متأخّر

69
00:05:24,100 --> 00:05:26,640
.وفي النّهاية تبادرت الأفكار إلى ذهني

70
00:05:27,470 --> 00:05:30,310
.أو بالأحرى استجمعت أفكاري

71
00:05:32,980 --> 00:05:33,770
.هذا أنا

72
00:05:34,480 --> 00:05:36,570
.أريد أن أترك المنزل

73
00:05:36,570 --> 00:05:39,030
.إن كنت ستهرب كطفلٍ، فلن أساعدك

74
00:05:39,030 --> 00:05:42,530
.لكن إن كنت ستغادر كرجل، فسأوافق

75
00:05:42,530 --> 00:05:43,410
.أجل

76
00:05:43,780 --> 00:05:45,160
.استعدّ جيّدًا

77
00:05:45,160 --> 00:05:47,330
.ستصبح الأمور أصعب بدءًا من الآن

78
00:05:47,330 --> 00:05:49,660
.ما تبع ذلك كان فترة اضطراباتٍ في حياتي

79
00:06:02,720 --> 00:06:06,510
.صباح الخير

80
00:06:06,510 --> 00:06:08,600
عذرًا، هل أنتم ذاهبون في رحلةٍ عائليّة؟

81
00:06:08,600 --> 00:06:09,680
.هذا صحيح

82
00:06:10,140 --> 00:06:12,560
.تأثرت كوتوري بموت بيرو

83
00:06:13,020 --> 00:06:16,060
.لا بدّ أنّهم يفعلون هذا للرّفع من معنويّاتها

84
00:06:18,570 --> 00:06:22,070
.لسببٍ ما، أشعر أنّ عليّ منعهم

85
00:06:22,070 --> 00:06:26,200
المعذرة، أمن الضّروريّ أن تذهبوا اليوم؟

86
00:06:27,530 --> 00:06:28,450
لمٙ تسأل؟

87
00:06:28,450 --> 00:06:31,200
...لا أدري

88
00:06:31,660 --> 00:06:33,000
أتساءل لماذا؟

89
00:06:38,290 --> 00:06:39,090
ماذا؟

90
00:06:39,590 --> 00:06:42,170
.تعلّمت الكثير من تجاربك في الحياة

91
00:06:42,170 --> 00:06:44,260
.أردت أن أشكركِ على ذلك

92
00:06:44,260 --> 00:06:45,890
لِم الآن فجأة؟

93
00:06:45,890 --> 00:06:47,180
.هذا كلّ ما لديّ لقوله

94
00:06:47,180 --> 00:06:47,720
.إلى اللّقاء

95
00:06:47,720 --> 00:06:49,100
!انتظر

96
00:06:49,470 --> 00:06:50,470
أين أنت ذاهب؟

97
00:06:50,930 --> 00:06:52,810
.إلى تداريب كرة المضرب

98
00:06:52,810 --> 00:06:55,230
.إنّها رياضةٌ جديدة حيث نلعب الكرة بالمضارب

99
00:06:55,230 --> 00:06:56,480
.كاذب

100
00:06:57,730 --> 00:06:59,230
هل ستعود؟

101
00:06:59,230 --> 00:07:01,280
.يا لها من نبيهة

102
00:07:02,280 --> 00:07:04,650
.قرّرت مغادرة مارتيل أيضًا

103
00:07:04,650 --> 00:07:09,030
.لكن والديّ لن يتقبّلا الأمر، لِذا سأذهب عند أحد معارفي

104
00:07:09,030 --> 00:07:10,160
.هكذا إذًا

105
00:07:11,040 --> 00:07:12,700
...مهرجان الحصاد

106
00:07:13,330 --> 00:07:16,120
سينعقد مهرجان الحصاد هنا، صحيح؟

107
00:07:16,120 --> 00:07:16,870
.نعم

108
00:07:18,380 --> 00:07:19,500
.اصحبني إليه

109
00:07:19,880 --> 00:07:21,090
لمٙ أنا؟

110
00:07:21,090 --> 00:07:24,920
.لا أملك أيّ أصدقاء، لِذا ستصحبني إليه يا كوتارو-كُن

111
00:07:24,920 --> 00:07:27,130
.لا أفهم منطقك هذا جيّدًا

112
00:07:27,130 --> 00:07:27,890
!افعلها فحسب

113
00:07:27,890 --> 00:07:30,390
...يا لكِ من لحوحة

114
00:07:30,390 --> 00:07:31,260
.لا بأس

115
00:07:31,850 --> 00:07:33,720
.سأصحبكِ عندما أعود

116
00:07:34,770 --> 00:07:35,890
.إنّه وعد

117
00:07:35,890 --> 00:07:38,150
.اغرز إبرةً في عينك إن أخلفته

118
00:07:40,270 --> 00:07:41,150
.إلى اللّقاء

119
00:07:41,150 --> 00:07:42,690
.أبلغ والديك تحيّاتنا

120
00:07:42,690 --> 00:07:43,650
.سأفعل

121
00:07:44,440 --> 00:07:46,650
.حصلت على صديقةٍ أخيرًا عندما قرّرت المغادرة

122
00:07:46,950 --> 00:07:49,660
.يا لسخرية القدر

123
00:07:54,040 --> 00:07:56,410
،عبرنا جبالًا عدّة وانتهى بنا المطاف إلى بلدة

124
00:07:56,790 --> 00:07:59,420
.حيثُ تتواجد منظّمةٌ لا تحمل اسمًا رسميًّا

125
00:07:59,420 --> 00:08:03,170
،لكن الجميع يسمّونها

126
00:08:03,630 --> 00:08:05,170
".الغارديان"

127
00:08:05,170 --> 00:08:07,340
أهذه رائحة المجاري؟

128
00:08:07,340 --> 00:08:09,430
.الواقع نتن

129
00:08:09,430 --> 00:08:15,020
.أمثالك الّذين يعيشون في طبقةٍ مرموقةٍ من المجتمع، ينسون ذلك غالبًا

130
00:08:15,020 --> 00:08:18,060
.لقد تركت كازاماتسوري خلفك يا تينّوجي

131
00:08:18,060 --> 00:08:20,230
.لا تنس ذلك

132
00:08:20,230 --> 00:08:21,310
.فهمت

133
00:08:22,060 --> 00:08:23,690
.هذا أقصى ما أستطيع إيصالك إليه

134
00:08:23,690 --> 00:08:26,070
.اذهب. أخبرتهم أنّك قادم

135
00:08:26,070 --> 00:08:27,320
ألن تأتي؟

136
00:08:27,320 --> 00:08:31,280
أتريد أن تكون جنديًّا يحتاج لمن يشدّ بيده طوال الوقت؟

137
00:08:31,280 --> 00:08:32,200
.لا

138
00:08:32,530 --> 00:08:35,580
.حاليًّا، ركّز على التّدريبات الأساسيّة لتغدو نصف رجل

139
00:08:35,950 --> 00:08:38,330
.لأنّك الآن لست كذلك حتّى

140
00:08:39,960 --> 00:08:41,460
...المعذرة

141
00:08:43,000 --> 00:08:44,710
ألا أحد هنا؟

142
00:08:48,340 --> 00:08:49,720
...المعذرة

143
00:08:49,720 --> 00:08:51,090
...مهلًا

144
00:08:54,720 --> 00:08:55,890
.إذًا فقد أتيت

145
00:08:55,890 --> 00:08:56,970
.من هنا

146
00:08:56,970 --> 00:08:58,560
.حـ-حاضر

147
00:09:06,650 --> 00:09:11,610
...أشخاصٌ لم يتمكنّوا من عيش حياةٍ طبيعيّة بسبب قدراتهم الخارقة

148
00:09:11,990 --> 00:09:13,660
.وأنا واحدٌ منهم

149
00:09:16,950 --> 00:09:18,250
...ومع ذلك

150
00:09:18,250 --> 00:09:21,500
.هؤلاء الأشخاص أشدّاء للغاية

151
00:09:22,370 --> 00:09:24,040
أينبغي أن أستعملها؟

152
00:09:24,040 --> 00:09:27,170
.إن دُست المسرّع فسأتمكّن زيادة قدرتي قدر ما أشاء

153
00:09:27,170 --> 00:09:29,550
.أحتاج فقط لأن أتمنّى ذلك، وسيحدث

154
00:09:29,550 --> 00:09:31,880
.لم أكن بحاجةٍ للتّدريب من قبل

155
00:09:31,880 --> 00:09:33,720
من أيّ إعداديّةٍ أنت؟

156
00:09:32,300 --> 00:09:34,760
.لا، ينبغي أن أنتظر إلى حين تبيّن الأمور

157
00:09:33,720 --> 00:09:34,970
.الثّانية

158
00:09:34,970 --> 00:09:37,520
!الثّانية؟ صديقي يرتادها أيضًا

159
00:09:36,890 --> 00:09:38,470
...ذلك الفتى

160
00:09:37,520 --> 00:09:38,140
حقًّا؟

161
00:09:38,140 --> 00:09:39,430
!نعم

162
00:09:38,470 --> 00:09:40,100
.إنّه من نفس إعداديّتي

163
00:09:40,100 --> 00:09:41,520
!تجمّعوا

164
00:09:41,850 --> 00:09:46,150
.توجد قيودٌ صارمة على المعلومات المتعلّقة بمنظّمتنا، نظرًا لطبيعتها

165
00:09:46,650 --> 00:09:49,740
.ستخضعون لتدريبٍ جسديّ في هذه المنشأة

166
00:09:49,740 --> 00:09:53,950
.بالإضافة إلى تدربٍ خاص لاكتساب "مهارات الصّيد" كما نسمّيها

167
00:09:53,950 --> 00:09:55,410
.سيكون تدريبًا شاقًا

168
00:09:55,410 --> 00:09:57,660
.وفي أسوأ الأحوال، قد يموت بعضكم

169
00:09:57,660 --> 00:09:58,910
.كونوا في أتمّ التّركيز دائمًا

170
00:09:58,910 --> 00:10:02,580
.جميعكم تمتلكون قوى لا تضاهى

171
00:10:02,580 --> 00:10:05,080
،ربّما تحتّم عليكم إخفائها عن المجتمع العاديّ

172
00:10:05,080 --> 00:10:07,840
.لكن يمكنكم إبراز أقصى ما لديكم في هذا المكان

173
00:10:07,840 --> 00:10:11,970
.تعلّموا كيف تستخدمونها بطريقةٍ تليق بالبشر الخارقين

174
00:10:12,590 --> 00:10:14,180
أيّ أسئلة؟

175
00:10:14,180 --> 00:10:14,930
.نعم

176
00:10:14,930 --> 00:10:17,430
أنت... تينّوجي، صحيح؟

177
00:10:17,890 --> 00:10:20,520
إساكا-سان أوصى بك، أليس كذلك؟

178
00:10:20,520 --> 00:10:24,440
ما عملنا هنا بالضّبط؟

179
00:10:24,440 --> 00:10:26,440
،لأبسّط الأمر

180
00:10:26,440 --> 00:10:30,150
.نحن نبيد الشّياطين ونبقي وجودها طيّ الكتمان

181
00:10:30,150 --> 00:10:30,940
.صحيح

182
00:10:31,440 --> 00:10:35,910
.يمكنك اعتبار الأمر مماثلًا لما اعتدت القيام به في الغابة

183
00:10:35,910 --> 00:10:37,950
.إذًا فهم يعلمون عن ذلك

184
00:10:41,040 --> 00:10:42,370
...إنّه

185
00:10:46,420 --> 00:10:48,000
.وهكذا بدأ التّدريب

186
00:10:48,380 --> 00:10:51,760
.قضينا أوّل أسبوعين في المشي

187
00:10:52,210 --> 00:10:54,760
،ثمّ تلتها التّداريب الأساسيّة

188
00:10:54,760 --> 00:10:55,760
،التّمارين التّطبيقيّة

189
00:10:55,760 --> 00:10:57,510
.والدّروس النّظريّة

190
00:10:58,930 --> 00:11:02,020
.تصنيفات الشّياطين كانت أكثر ما استرعى انتباهي

191
00:11:02,350 --> 00:11:07,020
.تعلّمت أنّ لكلّ شيطانٍ مستدعيًّا

192
00:11:07,020 --> 00:11:09,270
...الأشخاص الّذين يخلقون الشّياطين ويستخدمونها

193
00:11:09,940 --> 00:11:12,530
"،منظّمتهم تدعى "غايّا

194
00:11:12,530 --> 00:11:15,240
.وهم في عداءٍ مع الغارديان

195
00:11:15,240 --> 00:11:17,780
.غايّا... مستخدمو الشّياطين

196
00:11:18,320 --> 00:11:22,540
.في النّهاية كان هذا صراعًا بين النّاس وبين الأيديولوجيّات

197
00:11:22,910 --> 00:11:24,710
.يبدو لي أمرًا معقّدًا للغاية

198
00:11:24,710 --> 00:11:26,790
.مرحبًا يا بطل-سينسي

199
00:11:27,330 --> 00:11:28,290
إمامييا؟

200
00:11:28,750 --> 00:11:30,130
ما قصّة البطل هذه؟

201
00:11:30,130 --> 00:11:32,710
أوليس لديك خبرةً فعليّةً في القتال؟

202
00:11:32,710 --> 00:11:34,510
.يجب أن نكنّ لك الاحترام

203
00:11:34,510 --> 00:11:37,840
.رغم أنّه من الغريب أنّك كنت تصيد الشّياطين في الخفاء

204
00:11:38,720 --> 00:11:39,930
أيمكنني أن أخدمك في شيء؟

205
00:11:39,930 --> 00:11:44,310
.قد لا يدوم ذلك طويلًا، لكن نحن زملاء بدءًا من اليوم

206
00:11:44,310 --> 00:11:46,310
.أتوقّع منك الكثير

207
00:11:46,310 --> 00:11:50,560
.ذلك الوحش ميكوني من النّخبة، يضعك نصب عينيه أيضًا

208
00:11:51,570 --> 00:11:54,570
.ليكن في علمك أنّني لست قويًّا إلى ذلك الحدّ

209
00:11:54,570 --> 00:11:56,650
.هيّا، لا داعي للتّواضع

210
00:11:56,650 --> 00:11:59,240
أليس إساكا-سان من أوصى بك؟

211
00:11:59,240 --> 00:12:01,700
.كان عليّ أن أصاحبك في الإعداديّة

212
00:12:01,700 --> 00:12:03,660
صادفنا بعضنا البعض عدّة مرّات، صحيح؟

213
00:12:03,660 --> 00:12:04,950
.أتساءل

214
00:12:04,950 --> 00:12:07,080
.على أيّ حال، أعتمد عليك يا رفيق

215
00:12:07,080 --> 00:12:07,830
.أجل

216
00:12:08,500 --> 00:12:10,290
أتريد أن أشتري لك مشروبًا أو ما شابه؟

217
00:12:10,290 --> 00:12:12,590
...كنت في نظرهم متفوّقًا، لكن

218
00:12:13,300 --> 00:12:16,970
.سأعلن الآن عن نتائج الاختبار التطبيقيّ الأخير

219
00:12:16,970 --> 00:12:18,680
.الأوّل، ميكوني

220
00:12:19,470 --> 00:12:21,140
.الثّاني، كوروكاوا

221
00:12:21,140 --> 00:12:22,680
...الثّالث

222
00:12:21,390 --> 00:12:25,890
.في الاختبار الأول، أتيت في المرتبة 22 من أصل 22

223
00:12:25,890 --> 00:12:27,480
،كنتُ فاشلًا كليًّا

224
00:12:27,980 --> 00:12:29,850
.وانحطّت سمعتي في لمح البصر

225
00:12:29,850 --> 00:12:31,650
.الواحدة والعشرون، ناغاي

226
00:12:32,360 --> 00:12:34,110
.الأخير، تينّوجي

227
00:12:34,110 --> 00:12:36,740
...ما.... ما-ماذ

228
00:12:39,820 --> 00:12:42,240
.مرحبًا أيّها الكذّاب

229
00:12:42,240 --> 00:12:44,290
أين سكّيني المزيّف؟

230
00:12:44,290 --> 00:12:45,740
.ابحث عنه بنفسك

231
00:12:45,740 --> 00:12:49,210
.ماذا؟ أنت عديم الفائدة

232
00:12:49,210 --> 00:12:53,590
إن كانت قدرتك بذلك السّوء، أفلا يجدر بك المساهمة بطريقةٍ أخرى؟

233
00:12:53,590 --> 00:12:55,750
أتنصت إلى ما أقول؟

234
00:12:57,590 --> 00:12:59,760
لمٙ فعلتِ ذلك يا نيتشيكوجو؟

235
00:12:59,760 --> 00:13:02,260
ألم تحتلّ المرتبة السّادسة من القاع؟

236
00:13:02,260 --> 00:13:05,180
.رغم ذلك، أنا الأفضل في هذا الفريق

237
00:13:05,180 --> 00:13:06,640
.الأفضل في الفريق الأسوأ

238
00:13:07,100 --> 00:13:08,640
.نيتشيكوجو توكا

239
00:13:08,640 --> 00:13:10,730
.زميلةٌ أخرى في الفريق

240
00:13:10,730 --> 00:13:13,520
.كفاك من اختلاق مشاجراتٍ بلا معنى

241
00:13:13,520 --> 00:13:14,980
.حسنًا، حسنًا

242
00:13:14,980 --> 00:13:16,190
.هيّا بنا يا ناغاي

243
00:13:16,190 --> 00:13:18,030
.أ-أجل

244
00:13:18,030 --> 00:13:19,030
.ولدينا ناغاي

245
00:13:19,450 --> 00:13:22,280
.آخر عضوٍ في فريقنا

246
00:13:24,410 --> 00:13:27,160
.آسف. لقد بالغت في فعلها

247
00:13:27,160 --> 00:13:29,620
.أظنّ أنّ اسمه ميكوني

248
00:13:29,620 --> 00:13:31,670
.أحد النّخبة الّذين يعتلون صدارة التّصنيف

249
00:13:32,830 --> 00:13:34,170
فعل ذلك بيديه المجرّدتين؟

250
00:13:38,760 --> 00:13:42,550
.سمعت أنّ إساكا-سان أحضرك إلى هنا

251
00:13:42,550 --> 00:13:44,180
أليس ذلك مذهلًا؟

252
00:13:44,180 --> 00:13:46,930
.آسف. لم أفهم ما ترمي إليه

253
00:13:46,930 --> 00:13:48,520
،إساكا سوغين

254
00:13:48,520 --> 00:13:52,100
.بطلٌ مخضرم يعرفه كلّ من في هذا المجال

255
00:13:52,940 --> 00:13:56,690
.بالنّظر إلى درجاتك، أنا لا أفهم الأمر

256
00:13:56,690 --> 00:14:00,610
لماذا قام إساكا-سان بتجنيد شخصٍ مثلك؟

257
00:14:00,610 --> 00:14:02,740
هل من سببٍ محدّد وراء ذلك؟

258
00:14:02,740 --> 00:14:04,450
،حتّى وإن كان ورائه سبب

259
00:14:04,450 --> 00:14:07,450
ما شأنك بذلك؟

260
00:14:07,450 --> 00:14:09,700
أتظنّني ضعيفًا لا يستحقّ أن يتواجد هنا؟

261
00:14:09,700 --> 00:14:10,700
.بالطّبع لا

262
00:14:10,700 --> 00:14:13,500
.على الضّعفاء أن يكونوا أكثر حذرًا من غيرهم

263
00:14:13,500 --> 00:14:16,500
إذًا فهذا يعني أنّ ثمّة سبب، صحيح؟

264
00:14:16,500 --> 00:14:18,960
.أنت تبالغ في قراءة ما بين السّطور

265
00:14:19,960 --> 00:14:22,050
.نواياك الحقيقيّة واضحة

266
00:14:22,050 --> 00:14:24,930
.أنت لا تجيد قراءة الآخرين

267
00:14:24,930 --> 00:14:28,640
.كما أنّ استصغارك لي بهذه الطّريقة واضحٌ جدًّا

268
00:14:28,640 --> 00:14:30,180
.يا لها من كلماتٍ جريئة

269
00:14:32,430 --> 00:14:34,770
.أنت محض فاشل

270
00:14:38,360 --> 00:14:40,360
.لا جدال في ذلك

271
00:14:40,820 --> 00:14:45,280
.أنا فاشل لم يستطع حتّى هزيمة الفتيات في تداريب القتال

272
00:14:55,000 --> 00:14:58,250
.إذًا فقدرتك من النّوع القاطع

273
00:14:59,670 --> 00:15:01,090
.كشفتني

274
00:15:01,090 --> 00:15:03,760
،تُصنّف قدرات البشر الخارقين بوجهٍ عام إلى ثلاثة أنواع

275
00:15:04,090 --> 00:15:06,300
،صنف القنص متخصّصٌ في الصّيد

276
00:15:06,300 --> 00:15:09,050
.وصنف التّقطيع متخصّصٌ في التّقطيع

277
00:15:09,050 --> 00:15:12,810
.والصّنف الملوّث يمكنه التحكّم بأعضاء الدّورة الدّمويّة

278
00:15:12,810 --> 00:15:16,900
.بالمناسبة، قدرتي من النّوع الملوّث، تسمح لي بالتحكّم بالدّم

279
00:15:16,900 --> 00:15:19,560
.بالتّفكير في الأمر، كنتِ سيّئةً في التّصويب يا ناغاي

280
00:15:19,560 --> 00:15:21,570
.لستِ من صنف القنص

281
00:15:21,570 --> 00:15:23,610
.أرجوك لا تخبر أحدًا

282
00:15:23,610 --> 00:15:24,990
.لن أفعل

283
00:15:24,990 --> 00:15:26,200
.لا أملك أحدًا لأخبره

284
00:15:26,200 --> 00:15:27,780
.آسفة

285
00:15:27,780 --> 00:15:31,620
.سأحتلّ المرتبة الأخيرة إن خسرت أمامك

286
00:15:32,450 --> 00:15:33,950
.ميؤوسٌ منك بالكامل

287
00:15:33,950 --> 00:15:35,580
.تسهل قراءة تحرّكاتك

288
00:15:36,290 --> 00:15:37,330
...كما سبق وقلت

289
00:15:37,790 --> 00:15:40,210
،أنت تفتقر للقوّة والسّرعة

290
00:15:40,210 --> 00:15:41,960
.استخدم عقلك قليلًا

291
00:15:41,960 --> 00:15:42,710
.سحقًا

292
00:15:43,170 --> 00:15:45,720
في هذه الحالة، أينبغي أن أفعلها؟

293
00:15:45,720 --> 00:15:47,890
.القوّة الّتي تمنحني قدر ما أشاء من القوّة

294
00:15:48,640 --> 00:15:50,050
.لحظة

295
00:15:50,050 --> 00:15:53,470
،إن كانت قدرتي هي التّلاعب بسوائل جسمي

296
00:15:53,890 --> 00:15:55,600
فما تلك القدرة؟

297
00:15:56,140 --> 00:15:59,230
.تلك القدرة لتعزيز قدراتي البدنيّة كما أشاء

298
00:15:59,900 --> 00:16:02,360
يمكن تسميتها أيضًا القدرة على إعادة كتابة نفسي؟

299
00:16:03,110 --> 00:16:05,860
...القدرة الّتي تجعلني قويًّا كما أتمنّى

300
00:16:06,200 --> 00:16:07,610
.غريب

301
00:16:07,610 --> 00:16:09,910
.إنّها وسيلةٌ مريحةٌ للغاية

302
00:16:09,910 --> 00:16:13,410
،إن أعدت كتابة قدراتي بما يكفي فلن أتجاوز إمامييا ونيتشيكوجو فحسب

303
00:16:13,410 --> 00:16:15,120
.بل سأكون أفضل بكثير من ميكوني أيضًا

304
00:16:15,790 --> 00:16:18,580
كيف تعمل تلك القدرة؟ ماذا ستكلّفني؟

305
00:16:19,250 --> 00:16:21,080
.أشعر أنّها خطيرة

306
00:16:21,080 --> 00:16:23,340
.لا ينبغي عليّ استعمالها كثيرًا

307
00:16:30,010 --> 00:16:31,600
.إساكا-سان

308
00:16:31,600 --> 00:16:32,720
تينّوجي؟

309
00:16:32,720 --> 00:16:34,260
كيف تبلي؟

310
00:16:34,260 --> 00:16:35,390
.ليس جيّدًا

311
00:16:35,390 --> 00:16:37,230
ما الّذي تقوله أيّها الأحمق؟

312
00:16:37,980 --> 00:16:41,020
.أشعر أنّي أخيّب ظنّك

313
00:16:41,020 --> 00:16:42,690
هل رأيت درجاتي؟

314
00:16:42,690 --> 00:16:47,110
.نعم، لكن رتبتك في هذه المرحلة لا تعني شيئًا

315
00:16:47,110 --> 00:16:50,700
.نحن لا نبحث عن منهم جيّدون في الاختبارات، بل من يبلون جيدًا في القتال

316
00:16:50,700 --> 00:16:51,740
القتال؟

317
00:16:51,740 --> 00:16:53,740
.دعني أدرّبك قليلًا

318
00:16:53,740 --> 00:16:55,990
.سيكون ذلك مجحفًا

319
00:16:55,990 --> 00:16:57,000
لماذا؟

320
00:16:57,370 --> 00:16:59,960
.يبدو أنّ لك شعبيّةً كبيرة

321
00:16:59,960 --> 00:17:02,000
...إن احتكرك شخصٌ مثلي

322
00:17:03,500 --> 00:17:04,750
.كفّ عن استصغار نفسك

323
00:17:05,130 --> 00:17:07,420
.ستجعل من نفسك حثالة

324
00:17:07,420 --> 00:17:08,510
.آسف

325
00:17:08,510 --> 00:17:11,680
.يبدو أنّك تحتاج لمن يلقّنك بعض الأساسيّات

326
00:17:16,140 --> 00:17:18,020
.توقّف نزيفك

327
00:17:18,020 --> 00:17:20,770
.حسنٌ، إنّها قدرتي

328
00:17:20,770 --> 00:17:22,230
.أنت صريح

329
00:17:22,230 --> 00:17:24,610
.لا أمانع إن عرفت بشأنها

330
00:17:24,610 --> 00:17:26,020
.صريحٌ وأحمق

331
00:17:26,440 --> 00:17:28,440
.لن أهاجم

332
00:17:28,440 --> 00:17:29,280
.هلمّ إليّ

333
00:17:50,130 --> 00:17:51,420
أهذا كلّ ما لديك؟

334
00:17:51,880 --> 00:17:54,430
...عشر جولات، وخسرتها كلّها

335
00:17:54,430 --> 00:17:59,930
،فقط بعد أن تستخدم قوّتك إلى حدّها الأقصى
.ستبلغ الفرصة لتحسين قدراتك

336
00:18:02,020 --> 00:18:04,940
أتريد القيام بجولةٍ أخيرة؟

337
00:18:07,940 --> 00:18:10,190
...سأفعل

338
00:18:11,190 --> 00:18:12,200
.جيّد

339
00:18:36,010 --> 00:18:37,510
.تينّوجي

340
00:18:37,510 --> 00:18:38,390
نعم؟

341
00:18:38,390 --> 00:18:42,560
.شعرتُ بشيءٍ مختلفٍ في حركتك الأخيرة

342
00:18:42,560 --> 00:18:45,560
.لقد عصرت ذهني لأتوصّل إلى تلك الخطّة

343
00:18:45,560 --> 00:18:47,110
هل استخدمت قدرتك؟

344
00:18:47,110 --> 00:18:48,860
.كلّا. إطلاقًا

345
00:18:48,860 --> 00:18:51,190
فهمت. إذًا هل هي مصادفة؟

346
00:18:51,190 --> 00:18:53,820
.انتابني شعورٌ سيّئٌ حيالها

347
00:18:53,820 --> 00:18:56,410
هل كان هجومي جيّدًا؟

348
00:18:56,410 --> 00:18:58,160
.لا، كان قمامة

349
00:18:59,200 --> 00:19:02,290
.اجعل هجماتك بسيطةً وقويّة

350
00:19:02,290 --> 00:19:04,830
.لا تحوّل كلّ شيءٍ إلى رهانٍ ومعارك نفسيّة

351
00:19:04,830 --> 00:19:09,960
.الاستخدام البسيط والفعّال للقوّة هو أساس المعارك الحقيقيّة

352
00:19:09,960 --> 00:19:10,840
.فهمت

353
00:19:11,420 --> 00:19:13,590
.فلنكتفِ اليوم بهذا

354
00:19:15,760 --> 00:19:17,640
.قرأت عن إساكا-سان

355
00:19:18,050 --> 00:19:23,640
.فرسان سيف بايرن الأخضر، أقوى مجموعةٍ في الغارديان

356
00:19:23,640 --> 00:19:27,900
.هم من أنقذوني آنذاك في الغابة

357
00:19:27,900 --> 00:19:30,150
.وإساكا-سان هو قائدهم

358
00:19:31,150 --> 00:19:35,530
.ركّزت على التّدريب خلال النّهار وقراءة الكتب التّعليميّة ليلًا

359
00:19:35,900 --> 00:19:39,910
.لم أكن من قبل بهذه الجدّية حيال أيّ شيء

360
00:19:39,910 --> 00:19:41,950
،وبعد أربعة أسابيع

361
00:19:41,950 --> 00:19:46,120
أنا وزملائي في الفريق

362
00:19:46,120 --> 00:19:48,170
.كنّا مستعدّين لآخر مرحلةٍ في التّدريب الأساسيّ، المعركة الوهميّة

363
00:19:48,170 --> 00:19:50,630
.الإمساك بأسدٍ راقص يبدو أمرًا يسيرًا

364
00:19:50,630 --> 00:19:52,920
.إنّهم يمنحون لنا الأفضلية

365
00:19:57,090 --> 00:19:59,300
.لا يعقل هذا

366
00:19:59,300 --> 00:20:01,680
...ذهب ذلك الفريق قبل ثلاث دقائق فحسب

367
00:20:03,140 --> 00:20:05,310
.التّالي، فريق إماميا. تقدّموا

368
00:20:05,310 --> 00:20:08,150
.اسمعوا، ستموتون إن لم تركّزوا

369
00:20:08,150 --> 00:20:09,310
!خذوا حذركم

370
00:20:09,310 --> 00:20:10,940
.لا بدّ لنا من فعلها

371
00:20:10,940 --> 00:20:13,190
!أعتمد عليكم يا رفاق

372
00:20:14,650 --> 00:20:17,150
.سحقًا، هذا يغيظني

373
00:20:17,150 --> 00:20:19,240
.لا أحد يستطيع هزيمتهم

374
00:20:20,700 --> 00:20:24,450
هل أنا بشريّ خارق حقًّا؟

375
00:20:25,830 --> 00:20:27,710
.ميكونيتشي

376
00:20:27,710 --> 00:20:29,080
.لقد فعلوها

377
00:20:29,080 --> 00:20:31,460
.النّخبة من البشر في مستوى مغايرٍ تمامًا

378
00:20:31,790 --> 00:20:34,960
أسدان؟ هل هزموا أربعة مدرّبين؟

379
00:20:34,960 --> 00:20:37,220
،في قصّة السّلحفاة والأرنب

380
00:20:37,220 --> 00:20:41,970
.لو لم يتخاذل الأرنب، لما لحقته السّلحفاة

381
00:20:41,970 --> 00:20:45,890
.وفي العالم الواقعيّ، الأرانب الّتي لا تتخاذل هي الفائزة

382
00:20:48,230 --> 00:20:49,100
!هنيئًا لكم

383
00:20:49,100 --> 00:20:50,730
!مبروك

384
00:20:50,730 --> 00:20:53,400
،في اليوم الأخير من التّدريب الأساسيّ

385
00:20:53,400 --> 00:20:55,730
.أقيمت حفلةٌ صغيرة على شرفنا

386
00:20:55,730 --> 00:20:57,280
.استمعوا

387
00:20:57,280 --> 00:21:01,490
.عمل المستجدّين هو خلق المتاعب للجميع أينما حلوا ورتحلوا

388
00:21:01,490 --> 00:21:04,620
!سأتألقّ عندما تبدأ الأمور الجدّية

389
00:21:04,620 --> 00:21:07,500
.لا تحاولوا استمالتي في وقتٍ كهذا

390
00:21:09,750 --> 00:21:11,750
ما الخطب يا تينّوجي؟

391
00:21:11,750 --> 00:21:13,960
.ينبغي عليك أن تحتفل، لكن تبدو متشائمًا

392
00:21:13,960 --> 00:21:15,170
.إساكا-سان

393
00:21:15,170 --> 00:21:20,050
.تعلّمت الكثير هنا، لكن لا أعتقد أنّني حقّقت الكثير

394
00:21:20,050 --> 00:21:22,050
.أنت سلبيٌّ حقًّا يا تينّوجي

395
00:21:22,050 --> 00:21:24,760
.لكن قد يكون هذا أفضل من كونك مغرورًا

396
00:21:24,760 --> 00:21:27,520
،لقد تحسّنت قليلًا

397
00:21:27,520 --> 00:21:30,100
.لكنّ الآخرين أظهروا تطوّرًا أكبر بكثير

398
00:21:30,100 --> 00:21:32,060
.أصغِ يا تينّوجي

399
00:21:32,060 --> 00:21:34,860
.ثمّة سبلٌ عديدة للعيش وإثبات جدارتك

400
00:21:34,860 --> 00:21:37,610
،إن كان الجميع "أبطالًا" مثل ميكوني

401
00:21:37,610 --> 00:21:39,360
.فستنهار المنظّمة

402
00:21:39,740 --> 00:21:43,240
.حتّى بقدراتك الحاليّة، أنت مؤهلٌ لأن تصبح جنديًّا

403
00:21:43,240 --> 00:21:44,910
.تمتلك ما يلزم

404
00:21:44,910 --> 00:21:46,240
.شكرًا لك

405
00:21:46,240 --> 00:21:49,700
.سننفّذ عمليّةً كبيرة في كازاماتسوري قريبًا

406
00:21:49,700 --> 00:21:53,670
.واثقٌ أنّ أشخاصًا عديدين من هذه المنشأة سيطلب منهم المشاركة فيها

407
00:21:53,670 --> 00:21:56,130
في كازاماتسوري؟

408
00:21:56,130 --> 00:22:00,630
.لطالما كانت تلك المدينة مقدّسةً لدى غايّا

409
00:22:00,630 --> 00:22:02,380
.إساكا-سان

410
00:22:05,010 --> 00:22:07,310
...بالمناسبة يا إساكا-سان

411
00:22:07,310 --> 00:22:09,930
.لا أرى ناغاي في الأنحاء

412
00:22:09,930 --> 00:22:11,270
.لقد استقالت

413
00:22:13,690 --> 00:22:15,810
.يبدو أنّها شعرت أنّها بلغت حدّها

414
00:22:15,810 --> 00:22:16,820
...ناغاي

415
00:22:16,820 --> 00:22:21,030
.العديد من البشر الخارقين لا يمتلكون الحافز لمواجهة الفشل

416
00:22:22,740 --> 00:22:24,530
.لا تدع نفسك تنهار بسهولة

417
00:22:31,330 --> 00:22:41,840
العالم الّذي تحيَين فيه عالمٌ لا يغفو ونقيٌّ أصيل

418
00:22:43,050 --> 00:22:53,980
إن كان لكِ أثرٌ باقٍ هنا، فليكن على الأقلّ خيالك

419
00:22:54,770 --> 00:23:08,280
لا أستطيع حتّى فعل شيءٍ بسيط كالتّحديق إلى السّماء، لِذا سأغمض عيناي فحسب

420
00:23:08,120 --> 00:23:18,670
لكنّني أريدكِ أن تجدي شيئًا واحدًا

421
00:23:18,790 --> 00:23:30,430
حبّي المدفون في الذّكريات

422
00:23:30,560 --> 00:23:42,280
ليكون الفجر الّذي نبلغه بعد عبور الأزمان

423
00:23:42,360 --> 00:23:48,200
قدرًا يباركه الخلاص

424
00:23:49,320 --> 00:23:59,080
ما دامت هذه الأنشودة تصلك