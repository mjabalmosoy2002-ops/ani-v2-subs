1
00:00:08,820 --> 00:00:10,410
مدينة كازاماتسوري؟

2
00:00:10,410 --> 00:00:12,120
.أشعر وكأنّي غبت لعقود

3
00:00:12,700 --> 00:00:15,620
.حسنًا، تعال إلى المقرّ بعد ثلاثة أيّام

4
00:00:16,700 --> 00:00:17,500
.حاضر

5
00:00:22,000 --> 00:00:23,500
.والآن

6
00:00:24,500 --> 00:00:28,010
سوزوكي بوندو، عشرون سنة"؟"

7
00:02:04,100 --> 00:02:05,690
.النّظارة لن تكفي

8
00:02:05,690 --> 00:02:08,820
.سيتعرّف عليّ أيّ أحدٍ يعرفني جيّدًا

9
00:02:10,610 --> 00:02:13,780
.سأحاول تغيير ملامحي بالتحكّم بالدّم في وجهي

10
00:02:16,070 --> 00:02:16,780
.انتهيت

11
00:02:18,160 --> 00:02:20,790
.لكن هذا ليس سوى قناعٍ يظهره للعالم

12
00:02:20,790 --> 00:02:23,710
،هويته الحقيقية هي الجاسوس الأسطوري

13
00:02:23,710 --> 00:02:26,460
!سوزوكي بوندو

14
00:02:37,550 --> 00:02:40,310
.تذكّرت، نسيت أن آكل

15
00:02:51,440 --> 00:02:54,240
.لسوف أكمل مهامي

16
00:02:54,240 --> 00:02:56,450
.لن أستقيل مثل ناغاي

17
00:03:03,080 --> 00:03:05,830
...ماذا؟ أشعر أنّي قد قابلت هذه الفتاة من قبل

18
00:03:07,580 --> 00:03:10,590
،ةحيدو ءنحالأا في لتتجوّ يتهاأر نإ
.فئكسنكا .ءًجار بنا تّصلا

19
00:03:07,580 --> 00:03:10,590
رحاملأا بيت :ميتم

20
00:03:07,580 --> 00:03:10,590
كوإ كوفو :صيّلوا

21
00:03:22,720 --> 00:03:25,600
ما هذا السّلوك؟

22
00:03:26,060 --> 00:03:28,980
أنتِ هادئةٌ جدًا. أما زلتِ تعجزين عن الكلام؟

23
00:03:31,070 --> 00:03:32,900
.على أيّ حال، سأجري مكالمة

24
00:03:37,360 --> 00:03:39,280
.مرحبًا، هذا بيت الأرحام

25
00:03:39,280 --> 00:03:41,240
...حسنٌ

26
00:03:41,240 --> 00:03:43,620
.سينري أكاني-تشان معي الآن

27
00:03:43,620 --> 00:03:46,330
!يا إلهي! شكرًا جزيلًا لك

28
00:03:46,330 --> 00:03:48,500
.إكو-سان... هذا يعيد إليّ الذّكريات

29
00:03:48,500 --> 00:03:50,130
أيمكنك إطلاعي على اسمك؟

30
00:03:50,500 --> 00:03:53,250
!أنا سوزوكي بوندو

31
00:03:55,670 --> 00:03:58,010
.شكرًا جزيلًا لك على مساعدتك اليوم

32
00:03:58,010 --> 00:04:02,010
حسنٌ، هل تقابلنا من قبل يا سوزوكي-سان؟

33
00:04:02,010 --> 00:04:05,520
،حـ-حسنٌ، أعمل في مجال التّرفيه

34
00:04:05,520 --> 00:04:07,770
.وقد ظهرت على التّلفاز ذات مرّة

35
00:04:07,770 --> 00:04:10,270
مجال التّرفيه؟

36
00:04:10,270 --> 00:04:11,860
.بدأت لتوّي في هذا المجال

37
00:04:11,860 --> 00:04:13,780
.تذكّرت

38
00:04:13,780 --> 00:04:17,530
.أحضرت أكاني-تشان إلى هنا، لهذا عليّ أن أكافئك

39
00:04:17,860 --> 00:04:19,410
.لا، لا داعي

40
00:04:19,410 --> 00:04:22,160
إدارة ميتمٍ تتطلّب الكثير من المال، صحيح؟

41
00:04:22,160 --> 00:04:24,370
.هذا ليس صحيحًا إطلاقًا

42
00:04:24,370 --> 00:04:26,830
.انتظر هنا. سأذهب لجلبها

43
00:04:26,830 --> 00:04:28,540
...لـ-لا

44
00:04:29,790 --> 00:04:31,040
.اقبلها رجاءً

45
00:04:32,170 --> 00:04:33,670
...حسنٌ

46
00:04:33,670 --> 00:04:36,960
،نتلقّى حاليًّا المساعدات الماليّة من الفرع اليابانيّ لمجموعة ماتيل

47
00:04:36,960 --> 00:04:38,170
.فلا تقلق حيال ذلك

48
00:04:38,630 --> 00:04:41,050
أسمعت بالفرع اليابانيّ لمجموعة مارتيل؟

49
00:04:41,050 --> 00:04:44,680
تـ-تلك المجموعة المشهورة الّتي تهتمّ بحماية البيئة؟

50
00:04:52,270 --> 00:04:53,230
!عجبًا

51
00:04:53,230 --> 00:04:56,730
أنتِ تحبّين حقًّا المشاهير، صحيح؟

52
00:04:57,320 --> 00:04:59,030
...هذا ليس تصرّفًا صائبًا

53
00:04:59,030 --> 00:05:00,280
.إنّها خجولةٌ فحسب

54
00:05:00,910 --> 00:05:03,240
.وجهها يقول عكس ذلك

55
00:05:03,570 --> 00:05:06,790
.الأطفال هنا يتطلبّون رعايةً خاصّة

56
00:05:06,790 --> 00:05:08,500
.العديد منهم لا يستطيعون الكلام

57
00:05:08,500 --> 00:05:09,870
هي، أيضًا؟

58
00:05:10,370 --> 00:05:15,090
.لكن، عدم مقدرتهم على الاندماج في المجتمع هو سبب وجودنا هنا

59
00:05:15,090 --> 00:05:17,000
.هكذا إذًا

60
00:05:20,760 --> 00:05:22,260
هل استمتعت بعطلتك؟

61
00:05:22,680 --> 00:05:24,050
.الشّكر لك

62
00:05:24,050 --> 00:05:26,560
إذًا، ما هي مهمّتي؟

63
00:05:26,560 --> 00:05:29,020
.ستساعد في البحث عن المفتاح

64
00:05:29,020 --> 00:05:29,640
المفتاح؟

65
00:05:31,230 --> 00:05:35,190
السّبب في أنّ كازاماتسوري مقدّسةٌ لدى غايّا

66
00:05:35,190 --> 00:05:38,900
.هو أنّ المفتاح يُتوقّع أن يظهر هنا

67
00:05:38,900 --> 00:05:42,450
وما هو المفتاح بالضّبط؟

68
00:05:42,450 --> 00:05:43,870
.شيطان

69
00:05:43,870 --> 00:05:46,910
.لكن ليس أيّ شيطان

70
00:05:46,910 --> 00:05:51,910
.إنّه كائنٌ فريدٌ للغاية ويمتلك قوّةً هائلة

71
00:05:52,330 --> 00:05:55,210
وما الّذي يستطيع أن يفعل؟

72
00:05:55,210 --> 00:05:56,420
.الخلاص

73
00:05:56,420 --> 00:05:57,170
الخلاص؟

74
00:05:57,500 --> 00:05:59,590
.إنّه المصطلح الّذي تستخدمه غايّا

75
00:05:59,590 --> 00:06:01,630
.ويشير إلى فناء البشريّة

76
00:06:01,630 --> 00:06:05,680
.إنّه نوعٌ من سيناريوهات يوم الحساب، مثل يوم القيامة

77
00:06:06,100 --> 00:06:11,310
.المفتاح سيدفع متطرّفي غايّا لاتّخاذ تدابير صارمة

78
00:06:11,310 --> 00:06:16,190
.لهذا علينا التخلّص من المفتاح مهما كلّف الأمر

79
00:06:17,650 --> 00:06:19,320
هل ستشاركان أيضًا؟

80
00:06:19,320 --> 00:06:21,240
.بالطّبع

81
00:06:21,240 --> 00:06:22,990
وما تلك البذلة؟

82
00:06:22,990 --> 00:06:25,070
.من الواضح أنّها لا تلائمك

83
00:06:25,070 --> 00:06:27,830
.كفّ عن استفزازه بلا سبب

84
00:06:27,830 --> 00:06:28,830
ماذا؟

85
00:06:28,240 --> 00:06:32,120
ألا أحد منهما سيتطرّق إلى استقالة ناغاي؟

86
00:06:28,830 --> 00:06:30,700
.لا تجادلني

87
00:06:30,700 --> 00:06:32,120
...لكن

88
00:06:32,120 --> 00:06:34,330
.لسانك الطّويل هو ما يحرّض النّاس ضدّك

89
00:06:34,330 --> 00:06:36,920
فريق إمامييا، جميعكم هنا؟

90
00:06:36,920 --> 00:06:37,710
.تعالوا

91
00:06:38,670 --> 00:06:41,710
...والآن، بالنّسبة لعملكم أيّها المستجدّون

92
00:06:42,720 --> 00:06:44,720
.أعتقد أنّكم ستكونون عملاء مراقبة

93
00:06:44,720 --> 00:06:48,220
.تظاهروا بأنّكم شباب يتجوّلون في المدينة وقوموا بالاستطلاع

94
00:06:48,220 --> 00:06:51,930
.عذرًا، أنا وتينّوجي من هذه المدينة

95
00:06:51,930 --> 00:06:52,980
ألا بأس بذلك؟

96
00:06:52,980 --> 00:06:54,270
.لا مشكلة

97
00:06:54,270 --> 00:06:55,310
.نيتشيكوجو

98
00:06:55,310 --> 00:06:58,230
.نودّ منكِ ارتياد مدرسةٍ محليّة خلال النّهار

99
00:06:58,230 --> 00:06:59,900
مدرسة؟

100
00:06:59,900 --> 00:07:00,730
!مرحى

101
00:07:00,730 --> 00:07:02,440
.مؤقّتًا فحسب

102
00:07:02,440 --> 00:07:04,280
،عندما ينتهي عملنا هنا

103
00:07:05,990 --> 00:07:07,240
.مفهوم

104
00:07:07,240 --> 00:07:08,990
ألم تتجاوزي ذلك بعد؟

105
00:07:08,990 --> 00:07:11,370
.عليكِ أن تتعوّدي على هذه الحياة بسرعة

106
00:07:11,370 --> 00:07:13,160
!اخرس

107
00:07:13,160 --> 00:07:14,870
،إن أبليتِ جيّدًا

108
00:07:14,870 --> 00:07:18,250
.فقد ننظر إلى منحكِ شهادة تدريسٍ في الثّانويّة

109
00:07:18,250 --> 00:07:20,380
!ماذا؟ حـ-حقًّا؟

110
00:07:20,380 --> 00:07:23,510
!المعذرة، أنا حقًّا أرغب بذلك

111
00:07:23,510 --> 00:07:26,590
.إذًا فلتنجزي عملكِ باحترافيّة

112
00:07:26,590 --> 00:07:28,720
أيمكننا الحصول عليها أيضًا؟

113
00:07:28,720 --> 00:07:29,260
.بالطّبع

114
00:07:30,300 --> 00:07:32,470
.لم أهتمّ لأيّ من ذلك

115
00:07:32,470 --> 00:07:34,270
.لا أملك أيّ ذكرياتٍ سعيدة عن المدرسة

116
00:07:35,390 --> 00:07:36,770
،سنتمركز في هذا المكان

117
00:07:36,770 --> 00:07:39,310
.أحد نقاط الولوج إلى الغابة

118
00:07:39,310 --> 00:07:41,110
.راقبوا الدّاخلين والخارجين منها

119
00:07:41,110 --> 00:07:43,070
أتريد منّا منعهم؟

120
00:07:43,070 --> 00:07:45,030
.في الغالب ستقومون بالمراقبة والإبلاغ فحسب

121
00:07:45,030 --> 00:07:47,110
أهذا كلّ شيء؟

122
00:07:47,110 --> 00:07:49,030
.أنتم محض مستجدّين. لا تكونوا جشعين

123
00:07:49,490 --> 00:07:51,280
.نفّذوا العمل الموكل إليكم

124
00:07:51,280 --> 00:07:53,290
.مفهوم

125
00:07:53,910 --> 00:07:55,290
!سحقًا

126
00:07:55,620 --> 00:07:57,790
.أوكلونا أحد أسخف المهام

127
00:07:57,790 --> 00:08:00,840
.لا ألومهم. فدرجاتنا لا تشفع لنا

128
00:08:00,840 --> 00:08:02,880
.تبدين في مزاجٍ جيّد

129
00:08:02,880 --> 00:08:04,590
ألأنّكِ سترتادين المدرسة؟

130
00:08:04,590 --> 00:08:05,300
ألديك اعتراض؟

131
00:08:05,630 --> 00:08:06,760
.لا يهم

132
00:08:06,760 --> 00:08:09,180
.سأنجز عملي مهما كان تافهًا

133
00:08:09,180 --> 00:08:11,300
.أريد تسلّق القمّة

134
00:08:18,270 --> 00:08:19,440
!مرحبًا يا ميكوني-كُن

135
00:08:19,440 --> 00:08:20,690
أين تمّ تعيينك؟

136
00:08:21,230 --> 00:08:22,690
.فريق الاستطلاع

137
00:08:22,690 --> 00:08:24,190
.هذا كلّ ما أستطيع إخبارك به

138
00:08:24,190 --> 00:08:26,490
.إذًا فستدخلون إلى الغابة

139
00:08:26,490 --> 00:08:27,700
.لكن هذا بديهيّ

140
00:08:27,700 --> 00:08:29,200
.لم أذكر شيئًا عن ذلك

141
00:08:29,610 --> 00:08:31,700
.لا تقحم نفسك في القتال فتجلب المتاعب لنفسك

142
00:08:31,700 --> 00:08:33,490
.لن يحدث ذلك

143
00:08:33,490 --> 00:08:35,200
.ليس معي

144
00:08:36,410 --> 00:08:40,960
!يا لها من ثقةٍ كبيرة بالنّفس

145
00:08:46,840 --> 00:08:49,970
.أتمنّى لو أنّي عيّنت في فريق المخابرات أيضًا

146
00:08:49,970 --> 00:08:52,390
.كنت لتكون حملًا ثقيلًا عليهم لا غير

147
00:08:52,390 --> 00:08:54,720
اسمعا، ألا تظنّان أنّنا نجذب الأنظار إلينا؟

148
00:08:54,720 --> 00:08:56,430
!اللّوم يقع عليكما

149
00:08:56,430 --> 00:09:00,600
لماذا ترتديان بذلةً رسميّة وزيًّا مدرسيًّا في حين يفترض بنا أن نكون رعاعًا؟

150
00:09:00,600 --> 00:09:02,480
.عليكما أن تتماشيا معي

151
00:09:02,480 --> 00:09:05,230
أتيت للتّو من المدرسة. ماذا عساي أفعل؟

152
00:09:06,110 --> 00:09:11,280
.حسنٌ، أتفهّم أنّ قلبكِ الأنثويّ يريد أن يظهر مدى ظرافتكِ في ذلك الزّي

153
00:09:11,280 --> 00:09:12,490
أتريد أن تموت؟

154
00:09:12,490 --> 00:09:14,240
!حـ-حاولي إن استطعتِ

155
00:09:14,240 --> 00:09:16,410
!لا تستهيني بسرعتي في الهروب

156
00:09:16,410 --> 00:09:17,490
ستهرب؟

157
00:09:18,040 --> 00:09:20,370
.معقل غايّا، كازاماتسوري

158
00:09:20,370 --> 00:09:23,130
.النّاس والشّركات تمّت دعوتهم للاستقرار هنا

159
00:09:23,130 --> 00:09:25,880
.العديد من النّاس والمسؤولين تربطهم علاقات بغايّا

160
00:09:26,380 --> 00:09:29,630
.نحن في أرض العدوّ، وعلينا أن نجد المفتاح

161
00:09:29,630 --> 00:09:31,010
...سحقًا

162
00:09:31,010 --> 00:09:34,970
.يفترض أن يكون هذا وقتي للتألّق باعتباري من صنف القنص

163
00:09:34,970 --> 00:09:36,180
أهذا صحيح؟

164
00:09:36,180 --> 00:09:39,640
تعقّب الهدف هو أهمّ شيءٍ في الصّيد، صحيح؟

165
00:09:39,640 --> 00:09:42,350
.أنت حقًّا لا تعرف شيئًا رغم جدّيتك المبالغ فيها

166
00:09:42,350 --> 00:09:44,150
.في الواقع أنت مجرّد فاشل

167
00:09:44,150 --> 00:09:47,270
.وصنف القنص لديه فئات فرعيّة مختلفة

168
00:09:47,270 --> 00:09:50,650
.ثمّة أشخاصٌ متخصّصون في الأسلحة بعيدة المدى وآخرون في المطاردة

169
00:09:50,650 --> 00:09:52,280
.والبعض متخصّصٌ في الهرب

170
00:09:52,280 --> 00:09:54,990
ميكوني من صنف القنص على ما أذكر، أليس كذلك؟

171
00:09:54,990 --> 00:09:57,910
بالمناسبة، ماذا باستطاعتك أن تفعل؟

172
00:09:57,910 --> 00:09:59,160
.إيقاف نزيفي بسرعة

173
00:09:59,160 --> 00:10:00,290
غير ذلك؟

174
00:10:00,290 --> 00:10:02,540
.زيادة قدرتي على التحمّل وما إلى ذلك

175
00:10:02,540 --> 00:10:04,630
وبماذا سيفيدنا كونك عدّاء ماراثون؟

176
00:10:04,630 --> 00:10:06,500
.لن يفيدك ذلك في القتال

177
00:10:06,500 --> 00:10:08,670
.لهذا أكره الصّنف الملوّث

178
00:10:08,670 --> 00:10:12,050
.سمعتُ أنّ أشخاصًا تُنتج أجسامهم السّم

179
00:10:12,050 --> 00:10:14,800
.شيءٌ كهذا مستحيلٌ بالنّسبة لي

180
00:10:14,800 --> 00:10:16,930
.مع أنّي أمتلك مناعةً ضدّ المخدّرات

181
00:10:16,930 --> 00:10:18,970
.يا لك من ضعيف يا سينسي

182
00:10:18,970 --> 00:10:22,350
.ليس وكأنّنا نملك قدراتٍ أفضل

183
00:10:22,350 --> 00:10:23,270
.هذا ممل

184
00:10:23,270 --> 00:10:24,690
.أريد أن أقاتل أيضًا

185
00:10:24,690 --> 00:10:28,190
أتظنّنا قادرين على هزيمة شيطانٍ مجهّزٍ للقتال؟

186
00:10:28,190 --> 00:10:29,940
.100% سنُسحق

187
00:10:29,940 --> 00:10:32,740
.أنا لن أُسحق لأنّني سأهرب

188
00:10:32,740 --> 00:10:36,320
.حتّى صنف كلاب الصّيد أسرع منّا، لِذا سرعتك لن تنقذك

189
00:10:36,320 --> 00:10:38,580
.أعلم ذلك أيّها البطل العظيم

190
00:10:38,580 --> 00:10:41,200
.لا تناديني بالبطل مجدّدًا

191
00:10:41,200 --> 00:10:43,000
عجبًا، أصبحت تردّ الكلام؟

192
00:10:43,000 --> 00:10:45,120
من أين لك بهذه الجرأة اليوم؟

193
00:10:45,120 --> 00:10:47,920
.إن بدأت الشّجار فستتمّ تنحيّتك من هذه المهمّة

194
00:10:47,920 --> 00:10:49,920
.أعلم هذا أيضًا

195
00:10:50,710 --> 00:10:53,340
.كلّ هذا يصيبني بالملل

196
00:10:58,680 --> 00:10:59,470
ما الخطب؟

197
00:10:59,470 --> 00:11:00,140
.لا شيء

198
00:11:03,310 --> 00:11:04,940
!رائع

199
00:11:04,940 --> 00:11:05,560
.تفضّلي

200
00:11:05,560 --> 00:11:06,940
!أريده أيضًا

201
00:11:06,940 --> 00:11:08,900
.انتظر قليلًا فحسب

202
00:11:10,400 --> 00:11:12,150
ماذا؟ أكاني-تشان؟

203
00:11:15,400 --> 00:11:18,700
.يبدو أنّ العامّة يستمتعون بوقتهم هناك

204
00:11:18,700 --> 00:11:21,030
".أنت لست محترفًا بعد لتصف النّاس بـ"العامّة

205
00:11:21,030 --> 00:11:25,330
.سأصبح محترفًا حالما يسمحون لي باكتساب الخبرة

206
00:11:26,830 --> 00:11:28,420
...أكان ذلك

207
00:11:28,420 --> 00:11:29,670
.إشارة استغاثة

208
00:11:29,670 --> 00:11:32,670
أيعني هذا أنّ أحد الفرق القريبة تتعرّض لهجوم؟

209
00:11:32,670 --> 00:11:35,220
مهلًا، هل حدث شيءٌ ما؟

210
00:11:35,220 --> 00:11:37,430
!خُذ الأمر على محمل الجدّ أيّها الأحمق

211
00:11:37,430 --> 00:11:39,300
!هيّا بنا يا نيتشيكوجو

212
00:11:39,300 --> 00:11:41,300
.هذا يعدّ عصيانًا للأوامر كما تعلم

213
00:11:41,300 --> 00:11:43,060
ألا تريدين السّعي للمجد؟

214
00:11:43,060 --> 00:11:44,060
.لا

215
00:11:44,060 --> 00:11:46,060
.سنكون مسؤولين ونلتزم بمهمّتنا

216
00:11:46,060 --> 00:11:49,440
!من يدري متى سنحصل على فرصةٍ أخرى لنظهر مدى علوّ كعبنا

217
00:11:50,940 --> 00:11:52,940
—مهلًا، فيم تفكّر

218
00:11:54,690 --> 00:11:56,570
.لم يسألك أحد

219
00:11:58,450 --> 00:11:59,910
!هيّا بنا يا نيتشيكوجو

220
00:11:59,910 --> 00:12:01,200
!لا يجب أن نفوّت هذه الفرصة

221
00:12:01,200 --> 00:12:01,700
...لكن

222
00:12:01,700 --> 00:12:05,700
!حتّى لو فشلنا، ليس لدينا ما نخسره

223
00:12:05,700 --> 00:12:07,710
...لكن إن أمسكنا المفتاح

224
00:12:09,710 --> 00:12:11,590
.الأمر خطيرٌ للغاية

225
00:12:11,590 --> 00:12:12,590
.فهمت

226
00:12:12,590 --> 00:12:13,960
.ابقَ هنا يا تينّوجي

227
00:12:13,960 --> 00:12:15,590
!أنتِ أيضًا يا نيتشيكوجو؟

228
00:12:15,590 --> 00:12:18,300
.إن لم نتسلّق القمّة، فسنبقى في القاع إلى الأبد

229
00:12:18,300 --> 00:12:20,590
.نعتمد عليك في المراقبة يا أيّها البطل العظيم

230
00:12:23,050 --> 00:12:23,600
!انتظرا

231
00:12:40,740 --> 00:12:43,620
.هذا سيّئ. لا أثر لهما

232
00:12:47,370 --> 00:12:49,370
،إن رأيتها تتجوّل في الأنحاء وحيدة
.اتّصل بنا رجاءً. سنكافئك
الميتم: بيت الأرحام
الوصيّ: فوكو إكو

233
00:12:47,370 --> 00:12:49,370
:الهاتف

234
00:12:47,370 --> 00:12:49,370
!أكاني؟ لا يعقل

235
00:12:50,000 --> 00:12:50,620
!سحقًا

236
00:12:51,420 --> 00:12:53,340
!ينتابني شعورٌ سيّئٌ حيال هذا

237
00:12:59,050 --> 00:13:00,130
!لا جدوى

238
00:13:02,050 --> 00:13:03,550
...مؤلم

239
00:13:03,550 --> 00:13:05,890
ما هذا بحق؟

240
00:13:06,560 --> 00:13:07,890
...أ-أهذا

241
00:13:13,900 --> 00:13:15,650
ما هذا الوحش بحقّ؟

242
00:13:17,400 --> 00:13:18,400
!هذا جنون

243
00:14:28,220 --> 00:14:30,890
.إن واصلت القتال، فسأموت يومًا ما

244
00:14:31,470 --> 00:14:32,980
.حتّى العباقرة يموتون

245
00:14:32,980 --> 00:14:34,600
.أيًّا كان سيموت

246
00:14:34,600 --> 00:14:37,560
.حتّى ميكوني وإساكا-سان

247
00:14:37,560 --> 00:14:39,900
.وأنا الأقرب لأن يهلك

248
00:14:39,900 --> 00:14:40,900
...أنا الأكثر

249
00:14:40,900 --> 00:14:43,900
.لا، أكاني في مكانٍ ما هنا

250
00:14:43,900 --> 00:14:46,240
!يجب أن أنقذها

251
00:14:57,170 --> 00:14:58,790
...أكاني

252
00:15:01,800 --> 00:15:02,670
.هناك

253
00:15:03,590 --> 00:15:05,720
ألا تستطيع النّزول من هناك؟

254
00:15:05,720 --> 00:15:06,430
ما العمل؟

255
00:15:08,930 --> 00:15:10,680
لكن كيف؟

256
00:15:14,560 --> 00:15:15,940
شيطان؟

257
00:15:16,310 --> 00:15:17,190
!هذا محال

258
00:15:28,160 --> 00:15:29,030
ما العمل؟

259
00:15:50,970 --> 00:15:52,350
.فعلتها

260
00:15:59,100 --> 00:16:00,940
!مؤلم

261
00:16:04,990 --> 00:16:06,740
!انتصرت

262
00:16:06,740 --> 00:16:08,990
.أعتقد أنّي أبليت جيّدًا

263
00:16:08,990 --> 00:16:10,660
.جدّيًّا

264
00:16:12,240 --> 00:16:14,620
.يجب أن أفعل شيئًا بشأن أكاني أوّلًا

265
00:16:18,620 --> 00:16:21,170
هل صدمت رأسها في مكانٍ ما؟

266
00:16:22,290 --> 00:16:23,500
ما هذا؟

267
00:16:31,390 --> 00:16:33,180
.سأذهب لألقي نظرة

268
00:16:33,180 --> 00:16:35,390
.قد يكون الوضع خطيرًا هناك، لِذا ابقي هنا

269
00:16:39,640 --> 00:16:43,150
.ماذا؟ يبدو هذا مألوفًا

270
00:16:46,610 --> 00:16:48,950
.صحيح. آنذاك

271
00:16:58,500 --> 00:17:01,210
أنتِ المفتاح، صحيح؟

272
00:17:01,210 --> 00:17:03,790
،كعضوٍ في الغارديان

273
00:17:03,790 --> 00:17:07,710
.يتوجّب عليّ أن أتخلّص منها

274
00:17:32,450 --> 00:17:33,990
.أعتقد أنّي فهمت الوضع

275
00:17:34,320 --> 00:17:36,740
.يتمّ استرجاع جثّة ميكوني

276
00:17:36,740 --> 00:17:38,660
.كلّ شيءٍ يطابق تقريرك

277
00:17:38,660 --> 00:17:40,500
.إنّه لأمرٌ مخزٍ

278
00:17:40,500 --> 00:17:42,420
إذًا فقد قاموا باستدعاء تنّين الأرض؟

279
00:17:42,420 --> 00:17:46,000
.يبدو أنّ متطرّفي غايّا بدؤوا يتخلّصون من غبائهم

280
00:17:46,000 --> 00:17:48,050
...الملاك الحارس لغايّا

281
00:17:48,050 --> 00:17:49,510
.الأمور ستصبح أشدّ صعوبة

282
00:17:49,960 --> 00:17:52,010
أيمكنني أن أنصرف الآن؟

283
00:17:52,010 --> 00:17:53,890
.نعم. أحسنت عملًا

284
00:17:53,890 --> 00:17:55,010
.يمكنك الانصراف

285
00:17:55,010 --> 00:17:56,470
.في الواقع. انتظر

286
00:17:56,470 --> 00:17:57,010
نعم؟

287
00:17:57,010 --> 00:18:02,770
هل لمحت أيّ شيءٍ غريب بالقرب من ذلك الشّيطان الضّخم الّذي رأيته؟

288
00:18:02,770 --> 00:18:07,400
مثل أعدادٍ غفيرة من الشّياطين أو فرط نموٍّ للنّباتات؟

289
00:18:07,400 --> 00:18:09,280
،كما ذكرت في التّقرير

290
00:18:09,280 --> 00:18:11,900
.صادفت كلب صيد

291
00:18:11,900 --> 00:18:13,660
لا شيء آخر؟

292
00:18:13,660 --> 00:18:14,530
.لا

293
00:18:14,530 --> 00:18:15,570
.فهمت

294
00:18:15,570 --> 00:18:16,450
.انصرف

295
00:18:16,450 --> 00:18:17,990
.عن إذنك

296
00:18:21,450 --> 00:18:23,710
،كذبت بشأن أمرين

297
00:18:23,710 --> 00:18:25,420
،بشأن أكاني

298
00:18:25,420 --> 00:18:26,710
.وبشأن المفتاح

299
00:18:27,380 --> 00:18:31,840
.آمل فقط أن لا أندم على هذه الخيانات الطّفيفة

300
00:18:33,840 --> 00:18:35,470
.تلقّينا توبيخًا لاذعًا

301
00:18:35,840 --> 00:18:38,430
.لقد صفعني المدرّب

302
00:18:38,430 --> 00:18:39,470
ماذا عنك؟

303
00:18:39,470 --> 00:18:41,390
...حـ-حسنٌ

304
00:18:41,390 --> 00:18:43,180
.عاقبني إساكا-سان

305
00:18:43,180 --> 00:18:44,480
.يبدو ذلك قاسيًا

306
00:18:44,480 --> 00:18:47,940
.لا أصدّق أنّك تمكّنت من قتل أحدهم

307
00:18:47,940 --> 00:18:49,690
—هذا هو بطلنا

308
00:18:49,690 --> 00:18:51,610
.لحظة. لا أستطيع أن أناديك بذلك

309
00:18:51,610 --> 00:18:53,110
!هذا هو شجاعنا

310
00:18:53,110 --> 00:18:56,660
أنت لا تجيد الإنجليزيّة، صحيح؟

311
00:18:56,660 --> 00:18:58,070
هل صادفتما أيّ شياطين؟

312
00:18:58,070 --> 00:19:01,120
.وجدنا طائر استطلاع لكنّنا لم نتمكّن من إسقاطه

313
00:19:02,200 --> 00:19:04,870
.لا أصدّق أنّ ميكونيتشي قد قضى نحبه

314
00:19:04,870 --> 00:19:06,540
.ذلك الرّجل كان قويًّا حقًّا

315
00:19:06,540 --> 00:19:08,040
.يا له من عالمٍ قاسٍ

316
00:19:08,040 --> 00:19:09,380
.أعتذر عن التّأخير

317
00:19:09,380 --> 00:19:10,500
!وصل أخيرًا

318
00:19:10,500 --> 00:19:14,130
.طبق لازانيا من الحجم الكبير على طريقة جنوة، مع ريحانٍ إضافيّ

319
00:19:18,050 --> 00:19:19,890
!لذيذ

320
00:19:19,890 --> 00:19:22,310
ألم تكن مكتئبًا قبل قليل؟

321
00:19:22,310 --> 00:19:23,520
.صحيح

322
00:19:23,520 --> 00:19:25,890
هل تمكّنوا من العثور على الشّيء المسمّى المفتاح؟

323
00:19:25,890 --> 00:19:26,900
.لا يبدو ذلك

324
00:19:27,270 --> 00:19:31,070
.حالما ينتهي المهرجان، ستنتهي هذه المهمّة أيضًا

325
00:19:51,290 --> 00:19:53,670
لِم تركت المفتاح يذهب؟

326
00:19:53,670 --> 00:19:56,010
ألأنّه ظهر على هيئة فتاة؟

327
00:19:56,760 --> 00:19:59,090
.لا أفهم نفسي حتّى

328
00:20:00,180 --> 00:20:01,180
ماذا؟

329
00:20:01,180 --> 00:20:03,390
تريد تعلّم استخدام المسدّس؟

330
00:20:03,390 --> 00:20:04,430
.نعم

331
00:20:04,430 --> 00:20:05,930
،أفتقر للقوّة الهجوميّة

332
00:20:06,270 --> 00:20:09,440
.لِذا أظنّني سأكون أكثر فائدة مع المسدّس

333
00:20:09,440 --> 00:20:12,440
.كما أنّي أشعر أنّه سيلائمني أكثر

334
00:20:12,440 --> 00:20:15,820
هل يشغل بالك شيء؟

335
00:20:15,820 --> 00:20:18,570
.تبدو وكأنّك تسعى لمعاقبة نفسك

336
00:20:18,570 --> 00:20:21,450
.أنا... لا أعرف

337
00:20:21,740 --> 00:20:23,700
.أصغِ يا تينّوجي

338
00:20:23,700 --> 00:20:25,950
.البشر الخارقون قد يركبهم الغرور

339
00:20:26,410 --> 00:20:28,460
.لأنّ فخرنا هو ما يغذّي قوانا

340
00:20:29,080 --> 00:20:34,460
.ومن لم تُمرّغ كبرياؤه من قبل، لن يتمكّن حتّى من تجاوز نكسةٍ واحدة

341
00:20:34,460 --> 00:20:37,510
.فقدت ناغاي قدرتها

342
00:20:37,510 --> 00:20:38,470
فقدتها؟

343
00:20:38,470 --> 00:20:43,260
.إن كان عقل البشرّيّ الخارق واهنًا، فسيضعف مع مرور الوقت

344
00:20:43,260 --> 00:20:48,230
.وهذا يعني أنّ قوّة البشريّ الخارق مرتبطةٌ بحالته العقليّة

345
00:20:48,230 --> 00:20:50,480
.إذًا فلن نصبح أقوى إن كنّا نفتقر للثّقة

346
00:20:50,480 --> 00:20:52,480
.والإفراط فيها يعدّ مشكلةً أيضًا

347
00:20:52,480 --> 00:20:53,940
.مثل ما حدث لميكوني

348
00:20:54,770 --> 00:20:58,440
.رأيت العديد من الأشخاص أرادوا أن يصبحوا أبطالًا

349
00:20:58,440 --> 00:21:02,070
.ورأيتهم جميعًا يزهقون أرواحهم عندما حاولوا الاستبسال

350
00:21:02,070 --> 00:21:07,620
.هدفي أن أمتلك القوّة الّتي أحتاجها

351
00:21:07,620 --> 00:21:10,080
.لستُ أصبو لأكون بطلًا

352
00:21:11,540 --> 00:21:14,380
إحدى واجهاتنا العامّة

353
00:21:14,380 --> 00:21:17,090
.هي شركة أمنٍ خاصّة

354
00:21:17,090 --> 00:21:21,470
".لكن إن انضممت إليها فسيتحتّم عليك القيام بعملٍ "فعليّ

355
00:21:21,470 --> 00:21:22,550
.لا أمانع

356
00:21:22,550 --> 00:21:27,850
.أنا أيضًا درّبت نفسي في الحرب عندما كنت في أيّام شبابي

357
00:21:27,850 --> 00:21:32,100
.ربّما خوض تجارب شاقّة هو ما تحتاجه أيضًا للمواصلة قدمًا

358
00:21:33,100 --> 00:21:34,980
،إن عدت من هناك حيًّا

359
00:21:34,980 --> 00:21:37,110
فهل ستكون أحد جنودي المخلصين؟

360
00:21:37,110 --> 00:21:38,110
.نعم

361
00:21:38,110 --> 00:21:39,900
.ممتاز

362
00:21:39,900 --> 00:21:41,360
.اذهب لتشهد بعض المآسي

363
00:21:47,990 --> 00:21:49,620
لم يشربه؟

364
00:21:50,540 --> 00:21:54,630
.شعرت أنّ حياتي الّتي عشتها حتّى الآن قد مرّت أمام عيناي

365
00:21:55,170 --> 00:21:57,460
.حياةٌ مغلقة، بلا هدفٍ أو معنى

366
00:21:57,920 --> 00:22:02,470
.كنتُ أواصل البحث عن شيءٍ لينتشلني من تلك الحلقة المفرغة

367
00:22:03,090 --> 00:22:06,930
،لكنّه لم يكن في الفصل الدّراسي، لم يكن في المنزل

368
00:22:06,930 --> 00:22:09,020
،لم يكن في مارتيل

369
00:22:09,020 --> 00:22:11,980
.ولم أجده حتّى في الغارديان

370
00:22:12,560 --> 00:22:17,270
في النّهاية، خيانتي للمنظّمة بترك المفتاح يذهب

371
00:22:17,270 --> 00:22:20,990
.كان في الأساس ما أنقذني

372
00:22:20,990 --> 00:22:23,860
.لهذا لا أستطيع العمل في اليابان بعد الآن

373
00:22:23,860 --> 00:22:25,950
.أنا أهرب إلى العالم الخارجيّ

374
00:22:27,030 --> 00:22:29,990
...أنا واثق

375
00:22:31,290 --> 00:22:41,800
العالم الّذي تحيَين فيه عالمٌ لا يغفو ونقيٌّ أصيل

376
00:22:43,010 --> 00:22:53,940
إن كان لكِ أثرٌ باقٍ هنا، فليكن على الأقلّ خيالك

377
00:22:54,730 --> 00:23:08,240
لا أستطيع حتّى فعل شيءٍ بسيط كالتّحديق إلى السّماء، لِذا سأغمض عيناي فحسب

378
00:23:08,070 --> 00:23:18,630
لكنّني أريدكِ أن تجدي شيئًا واحدًا

379
00:23:18,750 --> 00:23:30,390
حبّي المدفون في الذّكريات

380
00:23:30,510 --> 00:23:42,230
ليكون الفجر الّذي نبلغه بعد عبور الأزمان

381
00:23:42,320 --> 00:23:48,160
قدرًا يباركه الخلاص

382
00:23:49,280 --> 00:23:59,040
ما دامت هذه الأنشودة تصلك