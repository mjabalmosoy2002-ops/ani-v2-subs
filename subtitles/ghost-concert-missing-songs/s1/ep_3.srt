1
00:00:16,820 --> 00:00:19,460
سيتي. لن نصل إلى نتيجة هكذا

2
00:00:19,690 --> 00:00:22,670
أعلم. إنّهم يجمعون قوّة عظيمة ما

3
00:00:25,890 --> 00:00:26,950
مثل الّتي هناك؟

4
00:00:26,950 --> 00:00:27,720
!انتظري

5
00:00:27,720 --> 00:00:29,500
!ينبغي أن نُطهّر المنطقة أوّلاً

6
00:00:29,500 --> 00:00:32,230
!لا نملك وقتاً لذلك

7
00:00:44,580 --> 00:00:45,980
!هذا هو زعيمهم

8
00:00:48,260 --> 00:00:50,740
تبّاً. هذه الرّوح الظّلاميّة لديها
عقل قائم بذاته؟

9
00:01:01,810 --> 00:01:06,910
بجدّية؟ ثقبتْ هالة شظيّة الرُّوح خاصّتي

10
00:01:11,380 --> 00:01:13,530
...أيّها المُتعاقد مع روحي

11
00:01:13,530 --> 00:01:16,850
كُن الجدار الّذي يفصل الحقيقة عن الوهم

12
00:01:16,850 --> 00:01:18,920
اعزل اللّحم والدّم والرُّوح

13
00:01:19,290 --> 00:01:20,230
،اِقطع

14
00:01:20,230 --> 00:01:21,100
!عالم الطّيف

15
00:01:22,210 --> 00:01:23,560
تبّاً

16
00:01:29,930 --> 00:01:32,990
...كوندو-سان

17
00:03:08,460 --> 00:03:10,280
لماذا فعلتِ ذلك يا روي؟

18
00:03:10,280 --> 00:03:11,980
هذا ما تستحقّينه لأنّكِ بالغتِ

19
00:03:11,980 --> 00:03:14,650
أكيد، لكن مَن يضرب شخصاً ساعده فحسب؟

20
00:03:14,650 --> 00:03:17,240
تحقّقتُ من أنّ استجابتكِ طبيعيّة

21
00:03:17,240 --> 00:03:18,900
تبدين بخير

22
00:03:19,510 --> 00:03:22,010
!مهلاً، انتظري! أنتِ

23
00:03:23,800 --> 00:03:28,020
تبّاً. سوف أقتلها

24
00:03:28,280 --> 00:03:30,030
يا له من لسان سليط

25
00:03:30,030 --> 00:03:32,440
إنّها ليست لغة مُلائم بالنّسبة لمعبد

26
00:03:38,250 --> 00:03:40,140
ماذا يجدر بنا أن نفعل أيّها الرّاهب؟

27
00:03:40,140 --> 00:03:42,830
لا نملك وقتاً لانتظار تعافي آكاري

28
00:03:42,830 --> 00:03:44,120
في هذه الحالة، أستطيع فعلها أنا

29
00:03:44,370 --> 00:03:47,080
أنا مُرهَقة جدّاً من المعارك المُتكرّرة

30
00:03:47,080 --> 00:03:48,230
...لكن

31
00:03:48,230 --> 00:03:50,830
يويتشي بحاجة راحة أيضاً

32
00:03:52,980 --> 00:03:54,500
هل حان دوري؟

33
00:03:54,500 --> 00:03:56,840
واجهنا عدداً كبيراً من الأرواح الظّلاميّة الضّعيفة

34
00:03:57,410 --> 00:03:59,640
قوّتكِ مثاليّة على ذلك

35
00:03:59,640 --> 00:04:03,410
لكن ذكرتْ آكاري روحاً سيّافة

36
00:04:03,410 --> 00:04:06,130
لا أستطيع هزيمة عدوّ واحد قويّ

37
00:04:06,130 --> 00:04:09,480
لكن أستطيع إكساب الوقت للأبد رُبّما

38
00:04:09,480 --> 00:04:14,220
،هذا صحيح. لا أعرف من تكون تلك الرُّوح
لكنّها مُميّزة

39
00:04:14,220 --> 00:04:18,530
إنّها غالباً شبح عظيم أو أقوى مثل كليوباترا

40
00:04:18,530 --> 00:04:20,530
شبح عظيم؟

41
00:04:21,020 --> 00:04:22,830
أرواح الأشخاص العُظماء

42
00:04:22,830 --> 00:04:25,240
أشباح النّاس الّذين تركوا بصمة لهم في العالم

43
00:04:25,240 --> 00:04:27,350
هي أشباح قويّة

44
00:04:28,890 --> 00:04:30,670
إذاً استخدموا قوّتنا

45
00:04:31,340 --> 00:04:32,930
نُقدّمها لسيريا

46
00:04:32,930 --> 00:04:34,320
ماذا؟

47
00:04:35,210 --> 00:04:37,850
من المُزعج لنا أن نُخاطبكِ من داخل
عقلكِ مُباشرة، أليس كذلك؟

48
00:04:37,850 --> 00:04:40,090
ومن المُزعج أيضاً أن تظهروا فجأة

49
00:04:40,090 --> 00:04:42,390
أعتقد هذا صحيح. سامحينا

50
00:04:42,620 --> 00:04:45,860
لكن لا بُدّ أنّ آيبا-سان مُرهَقة أيضاً

51
00:04:47,930 --> 00:04:50,250
سيريا لم تستهلك كثيراً من قوّتها

52
00:04:50,250 --> 00:04:53,270
لا بُدّ أنّها تستخدم طاقة الأرواح
الّتي تستحوذ عليها

53
00:04:54,740 --> 00:04:57,290
كان ذلك اليوم سهلاً للغاية

54
00:04:57,290 --> 00:04:58,900
والآن، لنذهب

55
00:04:58,900 --> 00:05:00,740
هل أنتِ متأكّدة يا كليو؟

56
00:05:00,740 --> 00:05:02,010
ماذا تقصدين؟

57
00:05:02,010 --> 00:05:07,450
وعدتُ أن نبحث عن ابنكِ سايساريون

58
00:05:07,450 --> 00:05:09,490
لا نعلم من أين نبدأ في البحث

59
00:05:09,490 --> 00:05:12,780
أحياناً نُصادف أُناساً في أقلّ الأماكن توقُّعاً

60
00:05:12,780 --> 00:05:18,800
أجل، ويمكننا كسب ودّ السّياف
ببساطة ودفعه لمُساعدتنا

61
00:05:18,800 --> 00:05:21,260
القول أسهل من الفعل

62
00:05:21,610 --> 00:05:24,540
هل من شيء يمكنك فعله
لتحفيز التّزامن الرُّوحيّ؟

63
00:05:25,240 --> 00:05:27,560
لا. هذا أمرٌ طوعيّ

64
00:05:27,560 --> 00:05:28,760
هكذا إذاً

65
00:05:29,420 --> 00:05:31,870
لكن حتّى من دون موسيقى عزاء
،التّزامن الرُّوحيّ خاصّتكِ

66
00:05:31,870 --> 00:05:33,900
ما زال لديكِ قوّة وافرة

67
00:05:34,440 --> 00:05:37,980
نفّذي أوامري. اختبار قدراتكِ أمرٌ جدير

68
00:05:37,980 --> 00:05:38,980
أنتم

69
00:05:38,980 --> 00:05:40,750
آكاري

70
00:05:38,980 --> 00:05:41,990
حريّ بكم ألّا تُفكّروا في تَرْكي والذّهاب

71
00:05:42,320 --> 00:05:44,450
سنفعل. ستُشكّلين عقبة

72
00:05:44,450 --> 00:05:47,280
لا، سأتحسّن بعد أيّام قليلة

73
00:05:47,280 --> 00:05:50,320
هذا مُتأخّر جدّاً. إذا فشلتْ مُحاولتنا
التّالية، فسوف آخذكِ بعدها

74
00:05:50,320 --> 00:05:51,500
ابقي هادئة وانتظري هنا

75
00:05:51,500 --> 00:05:52,620
...لكن

76
00:05:53,960 --> 00:05:55,920
لا تستعجلي على الموت يا آكاري

77
00:05:55,920 --> 00:05:58,100
فحياتكِ لا تنتمي لكِ فقط

78
00:05:59,240 --> 00:06:00,520
حسناً

79
00:06:02,250 --> 00:06:03,840
آكاري-سان؟

80
00:06:07,140 --> 00:06:09,170
ما الأمر يا آكاري موراياما-سان؟

81
00:06:09,170 --> 00:06:11,180
!اصمت! فلتمُت أيّها الرّاهب

82
00:06:15,090 --> 00:06:17,480
لماذا آكاري-سان هكذا؟

83
00:06:18,180 --> 00:06:19,290
المعذرة

84
00:06:19,290 --> 00:06:20,810
مـ-مرحباً

85
00:06:20,810 --> 00:06:22,960
شكراً على المجيء يا يوتيتسو

86
00:06:29,380 --> 00:06:31,620
أرى بأنّك ما زلت ميّالاً للفتيات الصّغيرات

87
00:06:32,180 --> 00:06:33,230
أحمق

88
00:06:34,400 --> 00:06:36,130
وما زلت تضرب النّاس أيضاً

89
00:06:36,660 --> 00:06:38,640
حسناً، ماذا قال المقرّ؟

90
00:06:39,460 --> 00:06:41,000
سيريا آيبا-سان

91
00:06:41,000 --> 00:06:42,420
حـ-حاضرة؟

92
00:06:43,820 --> 00:06:47,140
تيرا ستستأجركِ كوسيط

93
00:06:47,140 --> 00:06:49,040
وسيط؟

94
00:06:49,040 --> 00:06:51,100
ستُمنَحين غرفة مع مأكل ومشرب

95
00:06:51,100 --> 00:06:56,800
رسميّاً، ستكونين ميّتة، لكن تعترف تيرا بوجودك

96
00:06:56,800 --> 00:06:58,810
ما-ماذا ينبغي أن أفعل؟

97
00:06:59,270 --> 00:07:02,190
هدف تيرا هو احتلال عالم الطّيف

98
00:07:02,190 --> 00:07:05,530
نسعى لتأمين أكبر قدر مُمكن من المساحات

99
00:07:05,530 --> 00:07:09,450
بحسب مُساهماتكِ، ستُكافئين

100
00:07:09,450 --> 00:07:12,430
ويمكنكِ طلب الانتقال إلى فرع آخر كذلك

101
00:07:13,220 --> 00:07:17,170
لكن أريد مُساعدة الرّاهب، وليس تيرا

102
00:07:17,170 --> 00:07:20,540
في أهداف سيتي-سان الشّخصيّة؟

103
00:07:21,540 --> 00:07:24,510
لـ-لا يهمّ. انسَ بأنّني قلتُ شيئاً

104
00:07:24,510 --> 00:07:26,790
أنا مُدرك لأهدافه

105
00:07:26,790 --> 00:07:32,350
تطوّعتُ للإدارة والمُساعدة في فرع
إيباراكي لتحقيق تلك الأهداف

106
00:07:33,020 --> 00:07:34,810
حقّاً؟

107
00:07:34,810 --> 00:07:36,310
يوتيتسو، متى ستُغادر؟

108
00:07:36,310 --> 00:07:38,460
في مساء الغد

109
00:07:38,460 --> 00:07:40,020
إذاً ساعدني إلى ذلك الحين

110
00:07:40,300 --> 00:07:42,540
لديك كثير من وقت الفراغ، أليس كذلك؟

111
00:07:42,540 --> 00:07:43,730
بالطّبع

112
00:07:44,180 --> 00:07:47,250
سنُغادر لوضع بِلاط حجريّ في صباح الغد

113
00:07:47,250 --> 00:07:50,090
ريكو، سيريا، يوتيتسو. أعتمد عليكم

114
00:07:50,090 --> 00:07:50,970
حاضر

115
00:07:50,970 --> 00:07:52,450
عُلِم

116
00:07:53,490 --> 00:07:55,410
آكاري

117
00:07:57,880 --> 00:07:59,830
أعطيني تلك الأسطوانة الّتي هناك

118
00:08:00,160 --> 00:08:02,620
أين؟ زو ترو بي؟

119
00:08:02,620 --> 00:08:04,710
لا، الّتي على يمينها

120
00:08:05,190 --> 00:08:07,500
هذه المهجورة

121
00:08:08,810 --> 00:08:11,200
غِلاف رائع، صحيح؟

122
00:08:11,200 --> 00:08:12,470
ماذا؟ أجل

123
00:08:13,200 --> 00:08:16,930
.لكن وجه هذا الشّخص غير واضح
ما قصّة هذه الأسطوانة؟

124
00:08:17,220 --> 00:08:19,510
ذهبتُ لشرائها مع إيريكو

125
00:08:19,510 --> 00:08:21,120
مع جدّتي؟

126
00:08:21,120 --> 00:08:24,530
لهذا لم أشترِ واحدة جديدة أبداً لاستبدالها

127
00:08:24,870 --> 00:08:30,030
رؤيتها تُذكّرني بالموسيقى
وكيف كانت الأمور آنذاك

128
00:08:30,460 --> 00:08:33,990
بعض الذّكريات تبقى عالقة بالأشياء

129
00:08:33,990 --> 00:08:39,130
.لكن حتّى من بينها، هذا الشّيء مُميّز
فهو مع موسيقى أيضاً

130
00:08:39,130 --> 00:08:41,670
لهذا أحبّ الأسطوانات

131
00:08:41,670 --> 00:08:45,110
ما زلتُ لا أستطيع رميها رغم أنّني
لم أعد أستمع إليها

132
00:08:46,170 --> 00:08:48,600
كم مرّة أخبرتني بهذا؟

133
00:08:48,600 --> 00:08:50,600
هل لديك شيء كهذا؟

134
00:08:50,600 --> 00:08:52,790
ماذا؟ مثل ماذا؟

135
00:08:53,610 --> 00:08:54,810
وعاء

136
00:08:54,810 --> 00:08:56,160
للشّاي؟

137
00:08:56,160 --> 00:08:57,930
لا، للنّباتات

138
00:08:57,930 --> 00:09:01,520
صنعناه عندما ذهبنا إلى إيزو، أتتذكّر؟

139
00:09:01,800 --> 00:09:05,740
أعتقد بأنّ الأمر مُختلف هنا بما أنّنا
ما زلنا نستطيع استعماله

140
00:09:05,740 --> 00:09:08,610
صحيح. أيّ شيء يُزرع فيه ينمو جيّداً

141
00:09:08,880 --> 00:09:11,010
أليس كذلك؟ من الأفضل الاحتفاظ به
حتّى لو انكسر

142
00:09:11,010 --> 00:09:12,100
معكِ حقّ

143
00:09:16,490 --> 00:09:18,160
ليتني أستطيع الاستماع لهذه

144
00:09:19,640 --> 00:09:21,370
ستتمكّن من ذلك يوماً ما

145
00:09:22,370 --> 00:09:23,180
!مهلاً

146
00:09:24,080 --> 00:09:28,230
تمّ كشف موسيقى. من فضلك
توقّف عن الغناء فوراً

147
00:09:29,740 --> 00:09:32,030
نُقدّر تعاونك

148
00:09:32,030 --> 00:09:36,480
كتعبير عن الشّكر، ستُزوّدك ميوكس بأغنية
مُؤلَّفة خصّيصاً لك يا ماسانوري-ساما

149
00:09:36,480 --> 00:09:38,210
هل ترغب في سماعها؟

150
00:09:38,210 --> 00:09:39,390
قطعاً لا

151
00:09:39,690 --> 00:09:44,420
عُلِم. من فضلك أبلغنا إن احتجتها في المُستقبل

152
00:09:44,420 --> 00:09:46,160
ميوكس معك دوماً

153
00:09:46,160 --> 00:09:48,610
طاب يومك

154
00:09:48,850 --> 00:09:52,620
سأحرص على أن تتمكّن من الغناء ثانية يوماً ما

155
00:09:53,580 --> 00:09:54,460
ماذا كان ذلك؟

156
00:09:56,000 --> 00:09:59,130
آسفة أحضرتُ دواءكِ

157
00:09:59,130 --> 00:10:00,300
صديقتكِ؟

158
00:10:00,300 --> 00:10:01,250
أجل

159
00:10:01,250 --> 00:10:02,520
تفضّلي بالدّخول

160
00:10:03,040 --> 00:10:04,590
المعذرة

161
00:10:05,060 --> 00:10:06,630
هذه من روي-سان

162
00:10:07,140 --> 00:10:08,090
شكراً

163
00:10:10,370 --> 00:10:12,420
...أنا، في الواقع

164
00:10:12,810 --> 00:10:14,800
هل يُشبه هذا "كشفت الخادمةُ كلَّ شيء"؟

165
00:10:14,800 --> 00:10:16,530
...ماذا؟ في الواقع

166
00:10:16,530 --> 00:10:19,720
.شكراً على المجيء يا آنسة
هل تريدين بعض القهوة؟

167
00:10:21,120 --> 00:10:22,180
أجل، من فضلك

168
00:10:26,180 --> 00:10:28,020
هل أنتِ مُتفاجئة؟

169
00:10:28,020 --> 00:10:32,940
أجل. لم أكن أعلم بأنّ جدّتكِ
كانت في الواقع جدّكِ

170
00:10:33,420 --> 00:10:35,040
هل تقولين هذا عمداً يا سيريان؟

171
00:10:35,040 --> 00:10:38,000
جدّتي ميّتة. إنّها في قبر قريب

172
00:10:38,000 --> 00:10:42,540
...ماذا؟ هـ-هكذا إذاً. جدّتكِ بالفعل

173
00:10:42,970 --> 00:10:45,280
لحظة، مَن سيريان؟

174
00:10:46,210 --> 00:10:47,380
لقبكِ

175
00:10:47,380 --> 00:10:51,890
تبدين في الواقع... ككائن فضائيّ حقّاً

176
00:10:51,890 --> 00:10:53,420
لذا... تعلمين

177
00:10:53,420 --> 00:10:56,540
لا أعرف ما تقصدينه بالضّبط

178
00:10:56,540 --> 00:10:59,390
حقّاً؟ آسفة. إذاً سوف أغيّره

179
00:10:59,390 --> 00:11:01,120
لا داعي لذلك

180
00:11:01,120 --> 00:11:04,640
حقّاً؟ إذاً يسرّني لقائكِ يا سيريان

181
00:11:05,130 --> 00:11:07,850
يسرّني لقاؤكِ أيضاً يا آكارين

182
00:11:07,850 --> 00:11:12,070
أجل، أنتِ من بلوتو حتماً

183
00:11:12,070 --> 00:11:13,300
ألا يُعجبكِ آكارين؟

184
00:11:13,300 --> 00:11:15,500
ليست هذه مُشكلتي الوحيدة

185
00:11:15,500 --> 00:11:19,180
لا تملكين سبباً لمُناداتي بذلك، صحيح؟
هذا ليس جيّداً بما يكفي

186
00:11:19,180 --> 00:11:21,640
ناديني آكاري فحسب. هذا
ما يُناديني به الجميع

187
00:11:21,640 --> 00:11:22,740
حسناً

188
00:11:22,740 --> 00:11:24,060
جيّد

189
00:11:29,380 --> 00:11:34,810
آكاري-سا— آكاري، أنتِ تُقاتلين
لأجل جدّكِ وجدّتكِ، صحيح؟

190
00:11:34,810 --> 00:11:35,340
أجل

191
00:11:36,160 --> 00:11:41,580
أريد من جدّي أن يتمكّن من الاستماع للموسيقى
والغناء كما كان من قبل

192
00:11:42,510 --> 00:11:46,740
وأريد حماية الأشياء الّتي أحبَّها

193
00:11:46,740 --> 00:11:48,890
ميوكس تُهدّد قتل شخص ما لم

194
00:11:48,890 --> 00:11:50,250
يتخلّص من أسطواناته

195
00:11:50,250 --> 00:11:51,770
ولهذا أنتِ شغوفة جدّاً

196
00:11:51,770 --> 00:11:54,650
قد لا يبقى جدّي لفترة طويلة

197
00:11:54,650 --> 00:11:59,650
لكن بما أنّكِ أثبتِّ بأنّه يمكنك الغناء
،إن مُتِّ قبل موتكِ الفعليّ

198
00:11:59,650 --> 00:12:00,820
فقد أدعه يفعل ذلك

199
00:12:01,490 --> 00:12:05,060
لكن هذا مُزعج جدّاً

200
00:12:05,580 --> 00:12:07,870
ترتّب عليّ المجيء إلى هنا
دون استخدام جي.بي.أس

201
00:12:08,480 --> 00:12:11,100
وأنا ميّتة في نظر العالم

202
00:12:11,100 --> 00:12:13,550
حرّيتي أضيق ممّا تعتقدين

203
00:12:13,900 --> 00:12:17,550
فهمت. أظنّني كنتُ لأختار هذا على الغناء

204
00:12:17,770 --> 00:12:22,040
لا أنكر بأنّ بعض الأمور لا نشعر
بنعمتها إلّا بعد أن نفقدها

205
00:12:22,040 --> 00:12:24,000
أتساءل كيف هو شعور جدّي

206
00:12:24,000 --> 00:12:26,640
ليس وكأنّني أريده أن يموت

207
00:12:26,640 --> 00:12:29,100
لكن تريدين تلبية أُمنيته

208
00:12:29,100 --> 00:12:30,780
أجل، لكن هذا ليس كلّ شيء

209
00:12:30,780 --> 00:12:31,520
ماذا؟

210
00:12:31,520 --> 00:12:33,930
!انسي الأمر! لا يوجد شيء

211
00:12:33,930 --> 00:12:35,570
يُراودني الفضول الآن

212
00:12:38,690 --> 00:12:43,130
إذاً أدّي خدعة أو ما شابه لإضحاك جدّتي

213
00:12:43,130 --> 00:12:46,540
حينئذ سأخبركِ بالسّبب الآخر
الّذي يجعلني أُقاتل

214
00:12:46,540 --> 00:12:49,180
خدعة؟ جدّتكِ؟

215
00:12:49,180 --> 00:12:53,040
إنّها تُحبّ الدّعابات الجريئة والقذرة

216
00:12:53,410 --> 00:12:56,000
شيء ما على الأقلّ بمستوى
"لا تقلق. أنا ألبس ذلك"

217
00:12:58,010 --> 00:13:00,440
ماذا؟

218
00:13:01,650 --> 00:13:04,640
!لا تقلق. أنا ألبس ذلك

219
00:13:07,220 --> 00:13:09,320
من هذا الرّجل؟

220
00:13:10,520 --> 00:13:13,320
تونيكاكو أكاروي تاكامورا؟

221
00:13:13,320 --> 00:13:14,610
!يا له من اسم

222
00:13:14,900 --> 00:13:17,510
كان مشهوراً عندما كنتُ في سنّكن

223
00:13:17,510 --> 00:13:20,570
ثمّ اشتهر في أوروبّا الجنوبيّة لسبب ما

224
00:13:21,400 --> 00:13:23,660
ويُفترض أن تفعلي شيئاً كهذا؟

225
00:13:23,660 --> 00:13:27,330
أجل. ألا يُراودكِ فضول عندما يكتم
شخصٌ سرّاً عنكِ؟

226
00:13:30,040 --> 00:13:31,710
سايونجي-سان

227
00:13:31,710 --> 00:13:37,210
جدّة، صحيح؟ أتفهّم سبب عدم مُمانعتكِ
اللّقب الّذي منحتكِ إيّاه آكاري

228
00:13:37,210 --> 00:13:38,340
يسرّني ذلك

229
00:13:38,340 --> 00:13:40,420
—إذاً سأناديكِ أيضاً

230
00:13:38,890 --> 00:13:40,420
لا تفعلي

231
00:13:41,840 --> 00:13:44,370
ليس عليكِ أن تعرفي فوراً، صحيح؟

232
00:13:44,370 --> 00:13:46,690
ينبغي أن تنمنَ كي تُصبحن جاهزات ليوم غد

233
00:13:46,690 --> 00:13:47,760
معك حقّ

234
00:13:48,300 --> 00:13:50,240
حسناً، ينبغي أن أذهب

235
00:13:50,240 --> 00:13:52,110
تصبحين على خير سايونجي-سان

236
00:13:53,400 --> 00:13:55,310
تصبحين على خير يا آيبا-سان

237
00:13:55,400 --> 00:13:57,520
تصبحين على خير يا كاي-تشان

238
00:13:57,520 --> 00:13:59,900
تصبحين على خير يا سيري-تشان

239
00:14:03,890 --> 00:14:04,780
ما الأمر؟

240
00:14:06,060 --> 00:14:08,030
لا شيء. المعذرة

241
00:14:10,940 --> 00:14:16,180
لأجل جدّ آكاري، يجب أن أُدمّر ميوكس

242
00:14:16,500 --> 00:14:20,100
...وأجد خدعة أؤدّيها

243
00:14:28,500 --> 00:14:30,350
إنّه أثخن من السّابق

244
00:14:31,210 --> 00:14:32,560
السّواد حالك

245
00:14:32,870 --> 00:14:34,650
سأوفّر درعاً روحيّاً

246
00:14:34,650 --> 00:14:35,540
شكراً

247
00:14:39,000 --> 00:14:40,320
ريكو، تولّي أولئك

248
00:14:40,680 --> 00:14:42,990
عددهم أكبر ممّا توقّعت

249
00:14:43,200 --> 00:14:44,380
لكن لا يهمّ

250
00:14:45,080 --> 00:14:47,490
...يا أرواح الموتى الملعونة المسكينة

251
00:14:47,490 --> 00:14:49,450
الحياة الّتي تبحثين عنها موجودة هنا

252
00:14:49,770 --> 00:14:53,190
!تزامني معي، وتجلّي كقوّة لي

253
00:15:07,140 --> 00:15:08,380
مُذهل

254
00:15:08,380 --> 00:15:09,850
قيد الموت

255
00:15:09,850 --> 00:15:13,430
يسمح لها بأمر أيّ روح أقلّ قوّة منها

256
00:15:15,260 --> 00:15:16,270
هل أنتِ بخير؟

257
00:15:17,740 --> 00:15:19,510
أجل، أنا بخير

258
00:15:19,510 --> 00:15:24,070
هناك الكثير منهم فحسب، وقد
كانوا أقوياء في الحياة

259
00:15:31,450 --> 00:15:34,400
تجمّعوا حول ذلك الشّخص؟

260
00:15:34,400 --> 00:15:36,770
هاجمي بشكل مُباشر. سأُساندكِ

261
00:15:36,770 --> 00:15:37,670
حسناً

262
00:15:39,050 --> 00:15:43,180
كليوباترا، سيزر، أنطونيوس

263
00:15:43,680 --> 00:15:46,640
مدّوني بقوّتكم جميعاً

264
00:16:19,890 --> 00:16:21,170
تبدين جميلة

265
00:16:21,170 --> 00:16:22,430
ها أنا ذي

266
00:16:22,430 --> 00:16:25,260
!ابتعدوا رجاء! نحتاج هذه المساحة

267
00:16:33,050 --> 00:16:35,270
...إنّهم سريعون، لكن

268
00:16:36,080 --> 00:16:37,770
إنّها صامدة

269
00:16:37,770 --> 00:16:41,680
لا عجب، مع الأشباح العظيمة الّتي بداخلها

270
00:16:42,730 --> 00:16:45,550
لا أُمانع لعب دور ثانويّ

271
00:16:45,550 --> 00:16:46,460
هل يمكنكِ فعلها؟

272
00:16:46,460 --> 00:16:47,110
أجل

273
00:16:48,180 --> 00:16:50,960
أيّتها الأرواح، تمركزي بحيث
لا يستطيعون الدّخول إلى هنا

274
00:16:54,620 --> 00:16:56,840
بقيّتكم، ادعموا سيريا-تشان

275
00:17:10,010 --> 00:17:10,970
إنّه يبكي؟

276
00:17:16,780 --> 00:17:19,670
...كوندو-سان

277
00:17:20,190 --> 00:17:22,190
كوندو-سان؟ أيُعقَل؟

278
00:17:23,960 --> 00:17:24,690
هل أنت بخير؟

279
00:17:39,620 --> 00:17:40,580
توقّعت

280
00:18:57,300 --> 00:18:59,830
هل كنت تنتظر هنا لسماع أخبار؟

281
00:19:00,370 --> 00:19:01,180
أجل

282
00:19:02,420 --> 00:19:05,470
،في 25 أبريل من العام كيو 4

283
00:19:05,920 --> 00:19:09,590
تمّ اعتقال كوندو إيسامي وقطع رأسه

284
00:19:09,930 --> 00:19:14,480
بعد ذلك، تحاربَ هيجيكاتا توشيزو
مع ياماغوتشي جيرو

285
00:19:14,480 --> 00:19:19,630
تقلّص نفوذ الشّينسينغومي، وتمّ إرداء
هيجيكاتا توشيزو برصاصة

286
00:19:20,050 --> 00:19:23,460
رحل الشّينسينغومي الآن

287
00:19:25,080 --> 00:19:26,600
هكذا إذاً

288
00:19:30,220 --> 00:19:30,980
شكراً لكِ

289
00:19:30,980 --> 00:19:32,080
انتظر

290
00:19:35,170 --> 00:19:37,160
ما زالت هنا

291
00:19:40,880 --> 00:19:45,950
،دون ضجيج، ستغرق في الظّلام
زهرة وماء

292
00:20:23,540 --> 00:20:26,120
!درّبني أرجوك

293
00:20:30,460 --> 00:20:31,460
حسناً

294
00:20:31,870 --> 00:20:33,090
!مرحى

295
00:20:33,090 --> 00:20:37,010
لكن لا بُدّ أنّ هذا السّلاح من الصّعب حمله

296
00:20:37,010 --> 00:20:39,430
لا بُدّ أن يكون هذا

297
00:20:39,430 --> 00:20:43,350
طول السّيف هو 3 شاكو و 7 سان
و 3 بو، مثل طولي

298
00:20:43,780 --> 00:20:45,500
لا طائل منكِ

299
00:20:50,310 --> 00:20:51,830
!لنبدأ

300
00:20:52,800 --> 00:20:53,920
أهذا كلّ ما لديكِ؟

301
00:20:53,920 --> 00:20:55,680
!لم أنتهِ بعد

302
00:21:05,480 --> 00:21:07,160
هناك المزيد؟

303
00:21:07,160 --> 00:21:10,870
أتخلّص ممّا لا نحتاجه منذ توقّفنا
عن استخدام السّيوف

304
00:21:10,870 --> 00:21:13,120
ماذا؟ لكن ماذا عن الذّكريات؟

305
00:21:13,120 --> 00:21:14,500
ليس لديّ أي ذكريات

306
00:21:14,500 --> 00:21:15,840
...لكن

307
00:21:17,000 --> 00:21:19,220
إنّها مثلهم فحسب

308
00:21:19,570 --> 00:21:20,800
ماذا تقصد؟

309
00:21:21,090 --> 00:21:22,840
أتدّعي الجهل؟

310
00:21:22,840 --> 00:21:25,040
—سيتي-سان، هدفك هو

311
00:21:25,040 --> 00:21:26,260
تدمير ميوكس

312
00:21:26,260 --> 00:21:28,470
لا، هذا ليس كلّ شيء

313
00:21:30,440 --> 00:21:33,590
أنا أساعدك في تحقيق انتقامك

314
00:21:33,590 --> 00:21:37,780
أنا أيضاً أبحث عن طُرُق للتّعامل
مع المُنظّمة الّتي قتلتهم

315
00:21:37,780 --> 00:21:39,630
لم أطلب منك فعل ذلك

316
00:21:39,630 --> 00:21:43,760
بئساً، ينبغي أن أذهب. أراك لاحقاً

317
00:21:47,940 --> 00:21:49,910
إنّه أوبون

318
00:21:50,330 --> 00:21:53,080
دعني أسترسل في عواطفي

319
00:21:58,130 --> 00:22:00,650
حسناً، افعليها

320
00:22:00,650 --> 00:22:01,580
حسناً

321
00:22:06,700 --> 00:22:07,720
!سأرنّم

322
00:22:07,950 --> 00:22:09,390
أحسنتِ