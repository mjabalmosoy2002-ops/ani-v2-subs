1
00:00:03,440 --> 00:00:04,970
سنغادر

2
00:00:04,970 --> 00:00:06,570
إلى اللّقاء

3
00:00:06,570 --> 00:00:07,860
بالتّوفيق

4
00:00:09,630 --> 00:00:10,740
ها نحن أولاء

5
00:00:11,170 --> 00:00:12,500
شكراً على القيادة

6
00:00:12,500 --> 00:00:13,700
!هيّا، هيّا

7
00:00:17,320 --> 00:00:19,500
رحلنَ

8
00:00:28,830 --> 00:00:33,320
هل من شيء يمكنني فعله للمُساعدة؟

9
00:00:33,320 --> 00:00:35,570
لا. ستُشكّلين عقبة فحسب

10
00:00:36,680 --> 00:00:40,760
لكن المدرسة بدأت بالنّسبة لسايونجي-سان
وآكاري وريكو-سان

11
00:00:41,970 --> 00:00:44,290
بالمناسبة يا روي-تشان، أليس
لديكِ مدرسة؟

12
00:00:45,350 --> 00:00:47,250
أنا ميّتة بالفعل

13
00:00:47,250 --> 00:00:48,110
ماذا؟

14
00:00:48,110 --> 00:00:50,240
أنتِ جزء مُهمّ من قوّاتنا

15
00:00:50,240 --> 00:00:53,610
ينبغي أن تتدرّبي لتحسين قوّتكِ الرّوحيّة

16
00:00:53,610 --> 00:00:55,650
أتدرّب؟ كيف؟

17
00:00:56,070 --> 00:00:58,070
اسألي أبي

18
00:00:58,890 --> 00:01:00,750
أبوكِ؟

19
00:01:03,810 --> 00:01:05,290
لم يخبركِ أحدٌ بعد

20
00:01:05,980 --> 00:01:10,820
يوكيهيتو ماياتا، 47 سنة، والمعروف
أيضاً بالرّاهب سيتّي

21
00:01:11,250 --> 00:01:12,790
إنّه أبي

22
00:01:12,790 --> 00:01:14,040
تمزحين، صحيح؟

23
00:02:45,510 --> 00:02:46,890
أنا لا أمزح

24
00:02:46,890 --> 00:02:48,740
لكنّنا لسنا مُرتبطين بالدّم

25
00:02:50,450 --> 00:02:51,440
أنتِ مُتبنّاة؟

26
00:02:52,440 --> 00:02:53,800
شيء من هذا القبيل

27
00:02:57,810 --> 00:03:00,610
منذ زمن بعيد، عشتُ في جزيرة أُخرى

28
00:03:03,110 --> 00:03:05,020
الجزيرة هي عبارة عن مُجتمع مُنغلق

29
00:03:05,020 --> 00:03:08,080
إنّها بلا اسم رسميّ وغير ظاهرة في الخرائط

30
00:03:08,500 --> 00:03:10,540
من تقاليد الجزيرة القديمة

31
00:03:10,800 --> 00:03:16,920
هي التّضحية بفتاة صغيرة لإله الشّرّ
الّذي يسكن هناك كعروس طاهرة

32
00:03:17,910 --> 00:03:21,630
العروسات يُحبسنَ في قفص
في مزار صغير

33
00:03:22,770 --> 00:03:24,510
في الحقيقة، لا يوجد إله شرّير

34
00:03:25,210 --> 00:03:29,350
إنّها مُمارسة سياسيّة ضروريّة
لضمان عدم فقدان

35
00:03:29,350 --> 00:03:31,890
السكّان لإيمانهم

36
00:03:33,730 --> 00:03:35,560
تُستخدَم المُمارسة أيضاً

37
00:03:35,930 --> 00:03:39,850
لمُعاقبة النُّبلاء المُتشاجرين
وأيّ شخص يُخطّط لتمرُّد

38
00:03:40,690 --> 00:03:46,120
يتمّ التّضحية ببنات النُّبلاء الخوَنة كعروسات

39
00:03:49,390 --> 00:03:53,260
تمّ شرائي لأحلّ مكان ابنة كهذه

40
00:03:57,070 --> 00:04:00,180
تمّت تهيئتي بحيث أشبهها تماماً

41
00:04:01,690 --> 00:04:04,590
لم أعُد أتذكّر كيف كان شكلي فعليّاً

42
00:04:04,840 --> 00:04:06,070
هذا فظيع

43
00:04:06,070 --> 00:04:08,220
،بعد قمرهن الجديد السّادس

44
00:04:08,220 --> 00:04:12,790
الفتيات اللّواتي تمّ اختيارهن كعروسات
يُلتهمنَ بواسطة إله الشّرّ

45
00:04:12,790 --> 00:04:15,940
ويختفينَ دون أثر

46
00:04:15,940 --> 00:04:17,650
يُلتهمن؟

47
00:04:18,500 --> 00:04:20,210
يُقتلنَ ببساطة

48
00:04:20,210 --> 00:04:24,370
كانت تلك مُجرّد أداة للتحكُّم بالنّاس

49
00:04:24,370 --> 00:04:26,510
كيف انتهى المطاف بكِ هنا؟

50
00:04:27,140 --> 00:04:30,750
مُسِستُ بواسطة أرواح القرابين السّابقة

51
00:04:30,750 --> 00:04:31,870
مُسستِ؟

52
00:04:31,870 --> 00:04:33,310
مثلكِ

53
00:04:33,870 --> 00:04:36,460
لكن لا أستطيع فعل ما تفعلينه

54
00:04:36,880 --> 00:04:42,200
لم أستطع التحكُّم بالأرواح الّتي مسّتْني

55
00:04:43,380 --> 00:04:46,600
هربتُ من المزار وهجتُ في البلدة

56
00:04:53,310 --> 00:04:58,010
نتيجة يأسهم، استأجر النّبلاءُ تنظيماً
بوذيّاً خاصّاً للقضاء عليّ

57
00:04:58,730 --> 00:05:02,890
كدتُ أُقتَل بواسطة المُمارِسين كجزء من تدريبهم

58
00:05:04,780 --> 00:05:07,990
لكن أحدهم أنقذني

59
00:05:08,670 --> 00:05:09,990
تقصدين الرّاهب؟

60
00:05:10,710 --> 00:05:12,700
كنّا معاً منذ ذلك الحين

61
00:05:12,700 --> 00:05:17,540
علّمني الكلام وساعدني في اكتشاف
كيفيّة صنع هذه

62
00:05:17,540 --> 00:05:19,250
وحوشكِ الرّوحيّة المُقطَّبة

63
00:05:20,360 --> 00:05:23,390
وحتّى أنّه منحني اسماً وصفّف شعري هكذا

64
00:05:23,800 --> 00:05:26,090
أعتقد هذا ما يجعلني أنا

65
00:05:26,790 --> 00:05:29,020
شكراً على إخباري

66
00:05:29,700 --> 00:05:32,530
لكن لماذا تخبرينني بشيء هامّ كهذا؟

67
00:05:32,530 --> 00:05:36,770
منذ ولادتي، الموسيقى الوحيدة في هذا
العالم كانت موسيقى ميوكس

68
00:05:56,870 --> 00:06:00,380
شعرتُ وكأنّني سمعتُ موسيقى
حقيقيّة لأوّل مرّة

69
00:06:00,380 --> 00:06:02,060
بئساً

70
00:06:02,060 --> 00:06:04,090
لن أُقتَل إذا غنّيتُ

71
00:06:04,090 --> 00:06:07,370
لكن لا أستطيع الغناء مثلكِ

72
00:06:07,370 --> 00:06:09,680
أريد تعلُّم الغناء مثلكِ

73
00:06:11,690 --> 00:06:13,640
أنا متأكّدة بأنّكِ ستتعلّمين يوماً ما

74
00:06:13,640 --> 00:06:18,550
قصدتُ ذلك عندما قلتُ بأنّكِ جزء مُهمّ
في قوّاتنا، لكن هذا ليس كلّ شيء

75
00:06:18,950 --> 00:06:22,650
...أريد سماعكِ تغنّين أكثر، لذا

76
00:06:23,170 --> 00:06:27,270
حسناً. سأكون أقوى وأتدرّب لأجلكِ أيضاً

77
00:06:27,610 --> 00:06:30,950
ولأجل الرّاهب... لأجل أبيكِ

78
00:06:31,560 --> 00:06:32,840
،اثنان وعشرون

79
00:06:33,450 --> 00:06:36,860
ثلاثة وعشرون، أربعة وعشرون

80
00:06:37,590 --> 00:06:39,330
خمسة وعشرون

81
00:06:39,800 --> 00:06:41,250
لقد عاد

82
00:06:47,460 --> 00:06:48,630
ما الأمر يا سيريا؟

83
00:06:48,630 --> 00:06:50,630
أهلاً بعودتك يا سيتّي-سان

84
00:06:50,980 --> 00:06:53,020
أريد أن أصبح أقوى

85
00:06:53,020 --> 00:06:54,770
ماذا يجدر بي أن أفعل؟

86
00:06:54,770 --> 00:06:56,190
تريدين أن تتدرّبي؟

87
00:06:56,660 --> 00:06:59,020
مع الأسف، لستِ بحاجة لفعل ذلك

88
00:06:59,020 --> 00:07:00,270
ماذا؟ لِمَ لا؟

89
00:07:00,500 --> 00:07:03,480
الأرواح الّتي تستحوذ عليكِ قويّة جدّاً

90
00:07:03,480 --> 00:07:06,530
وفي حين أنّ الوسيط العاديّ

91
00:07:06,530 --> 00:07:09,450
،كان ليحتاج تعزيز قوّته الرّوحانيّة والجسديّة

92
00:07:09,450 --> 00:07:12,150
إلّا أنّ قوّتكِ الرّوحيّة عالية جدّاً

93
00:07:12,470 --> 00:07:15,630
في عالم الطّيف، القوّة الرّوحيّة مُهمّة
أكثر من اللّحم والدّم

94
00:07:16,260 --> 00:07:19,640
ما دمتِ مُلائمة هناك، فستكونين بخير

95
00:07:19,640 --> 00:07:21,420
...هكذا إذاً

96
00:07:21,420 --> 00:07:26,090
لا أنكر بأنّه سيكون من المثاليّ لو تستطيعين
،تعزيز قوّتكِ كوسيطة روحيّة

97
00:07:26,660 --> 00:07:29,620
لكن لا جدوى من تَرك أيّ روح قديمة تمسّكِ

98
00:07:30,420 --> 00:07:32,520
وليس من الحكمة المُجازفة بدخول

99
00:07:32,520 --> 00:07:35,460
عالم الطّيف دون أوامر من تيرا

100
00:07:37,720 --> 00:07:39,890
ذلك المخزن هو بمثابة مكتبة

101
00:07:39,890 --> 00:07:41,460
مكتبة؟

102
00:07:41,460 --> 00:07:44,690
لعلّنا نُصادف شبحاً عظيماً آخر

103
00:07:45,020 --> 00:07:47,520
لدينا كثير من كُتُب التّاريخ. اقرئيها

104
00:07:47,520 --> 00:07:50,010
كُتُب تاريخ؟ شكراً لك

105
00:07:50,010 --> 00:07:52,210
مهلاً، إنّها مُقفَلة

106
00:07:53,430 --> 00:07:55,070
سأحضر المفتاح من روي-تشان

107
00:07:56,360 --> 00:07:57,160
هكذا إذاً

108
00:07:58,030 --> 00:08:00,870
...تُحبّ التّاريخ إذاً؟ لهذا السّبب

109
00:08:01,100 --> 00:08:03,500
مُذهل، يا لها من كُتُب كثيرة

110
00:08:03,500 --> 00:08:05,320
أستطيع قراءة كلّ هذه؟

111
00:08:05,320 --> 00:08:06,890
إنّها صعبة جدّاً بالنّسبة لي

112
00:08:07,830 --> 00:08:09,410
استعمليه متى أردتِ

113
00:08:09,410 --> 00:08:10,780
شكراً لكِ

114
00:08:11,320 --> 00:08:15,830
لا يمكننا قراءة الكُتُب على الإنترنت بعد
الآن، لذا سأقرأ كُتُباً ورقيّة

115
00:08:16,740 --> 00:08:17,780
هناك مُلاحظة

116
00:08:17,780 --> 00:08:19,710
تبدين مُستمتعة

117
00:08:21,170 --> 00:08:22,480
لا شيء

118
00:08:22,480 --> 00:08:23,380
ماذا؟

119
00:08:26,900 --> 00:08:28,610
شكراً على الطّعام

120
00:08:28,940 --> 00:08:31,700
مظهره أروع من المعتاد

121
00:08:33,700 --> 00:08:34,570
هذا لذيذ

122
00:08:34,570 --> 00:08:38,840
وصلَ راتبُ سيريا من تيرا. نحن نحتفل

123
00:08:38,840 --> 00:08:40,650
لكن سيريا-تشان ليست هنا

124
00:08:40,650 --> 00:08:42,630
إنّها تأكل في المكتبة

125
00:08:42,630 --> 00:08:44,370
قالت بأنّها لا تريد إهدار أي لحظة

126
00:08:44,370 --> 00:08:46,880
إنّها تقرأ؟ أنا مُتفاجئة

127
00:08:46,880 --> 00:08:49,750
لعلّها ممسوسة بواسطة روح
كينجيرو الشّرّيرة

128
00:08:49,750 --> 00:08:52,210
لا تقلقي. يبدو أنّها مُستمتعة

129
00:08:52,910 --> 00:08:55,180
يبدو أنّها تُحبّ التّاريخ

130
00:08:55,800 --> 00:08:59,010
حقّاً؟ يسرّني ذلك إذاً

131
00:09:44,010 --> 00:09:45,120
أهذا أنت يا يوتيتسو؟

132
00:09:45,120 --> 00:09:46,020
أجل

133
00:09:46,020 --> 00:09:47,090
ماذا تريد؟

134
00:09:47,090 --> 00:09:50,610
أعتقد ينبغي أن نعطي الأولويّة لتنصيب
ذلك البلاط الحجريّ هناك

135
00:09:51,150 --> 00:09:56,220
،هذا ليس مُهمّاً لإستراتيجيّة تيرا
لكنّه طريق مُختصر لميوكس

136
00:09:57,250 --> 00:09:58,630
لم يكن هناك أي أثر

137
00:09:58,630 --> 00:10:01,810
لتشويش من مُنظّمات أُخرى أو أرواح
ظلاميّة لبضعة أيّام

138
00:10:02,270 --> 00:10:06,570
حقّاً؟ لكن لا يمكننا التّضحية بهن

139
00:10:08,050 --> 00:10:10,290
إذاً هل ستتنكّر من جديد؟

140
00:10:14,900 --> 00:10:16,010
التّبديل الطّيفيّ

141
00:10:18,720 --> 00:10:21,240
حسناً. والآن أستطيع إغواء إيميتسو

142
00:10:40,210 --> 00:10:42,950
يوتيتسو، هل أتيت إلى هنا للسّخرية منّي فقط؟

143
00:10:43,540 --> 00:10:46,700
لا، رغم أنّ هذا يبدو مُمتعاً

144
00:10:47,130 --> 00:10:49,920
أمّنتْ لي السّيّدة كاسوغا صفقة

145
00:10:50,920 --> 00:10:55,380
سنُوفّر امرأةً يدعوها الحاكم إيميتسو
إلى غرفة نومه

146
00:10:56,010 --> 00:10:58,460
إذا فعلنا ذلك، فسوف تُسلّمُ هي المنطقة

147
00:10:58,460 --> 00:11:00,590
أبرمتُ الاتّفاقَ معها بالفعل

148
00:11:00,590 --> 00:11:04,850
لكن مُجرّد دعوة لن يُلبّي أُمنية
السّيّدة كاسوغا

149
00:11:04,850 --> 00:11:07,990
علينا أن ندعه يهتمّ بامرأة من الأساس

150
00:11:07,990 --> 00:11:12,560
يبحثون عن طُرُق أُخرى لإيجاد
وريث على هيئة روح

151
00:11:12,560 --> 00:11:16,110
فهمت. إذاً، كيف تنوي مُعالجة هذا الأمر؟

152
00:11:16,110 --> 00:11:20,320
.سوف نستخدم سيريا آيبا-سان
ألن تكون قدرتها نافعة؟

153
00:11:20,320 --> 00:11:21,250
ماذا؟

154
00:11:24,780 --> 00:11:26,100
قلعة إيدو؟

155
00:11:26,100 --> 00:11:28,470
استخدام القوّة لن ينفع هنا

156
00:11:28,470 --> 00:11:32,080
وافقت السّيّدة كاسوغا على تسليم
هذه المنطقة إذا حقّقنا شروطها

157
00:11:32,350 --> 00:11:37,510
أمنية السّيّدة كاسوغا هي أن يعبّر الحاكم
توكوغاوا إيميتسو عن اهتمامه بامرأة

158
00:11:37,820 --> 00:11:42,180
لـ-لكن أليست سايونجي-سان أو ريكو-سان
أنسب لهذه المهمّة؟

159
00:11:42,180 --> 00:11:44,380
لا، أنتِ هي الأنسب

160
00:11:44,380 --> 00:11:45,150
ماذا؟

161
00:11:46,530 --> 00:11:47,600
!ماذا؟

162
00:11:47,600 --> 00:11:51,180
هذا صحيح. لا تزال روح الحاكم
إيميتسو تُفضّل الرّجال

163
00:11:51,180 --> 00:11:54,780
مُتّبعين التّاريخ، سوف نرسل امرأة
تستطيع التنكُّر بهيئة رجل

164
00:11:54,780 --> 00:11:55,880
...هل تقصد

165
00:11:55,880 --> 00:11:58,630
سيزر، أنطونيوس، أوكيتا

166
00:11:58,630 --> 00:11:59,940
تحرير التّزامن الرّوحيّ

167
00:12:01,770 --> 00:12:03,990
من فضلك لا تُخرجنا بهذا الشّكل

168
00:12:03,990 --> 00:12:05,490
هذه مُشكلة

169
00:12:05,490 --> 00:12:07,580
لكنّنا نتفهّم الوضع

170
00:12:07,580 --> 00:12:10,390
سيريا، سوف نُساعدكِ. صحيح؟

171
00:12:10,390 --> 00:12:11,910
إن ترتّب علينا ذلك

172
00:12:11,910 --> 00:12:13,710
لنُجرّب الأمر

173
00:12:14,120 --> 00:12:15,080
!ماذا؟

174
00:12:17,300 --> 00:12:19,570
مـ-ماذا حدث للتو؟

175
00:12:19,570 --> 00:12:20,970
لا بأس، صحيح؟

176
00:12:27,290 --> 00:12:28,220
لا بأس

177
00:12:28,840 --> 00:12:30,280
،لكن يا سيريا

178
00:12:30,280 --> 00:12:33,940
جاذبيّتكِ لوحدها قد لا تكون كافية
لجعل الحاكم إيميتسو يقع في حُبّك

179
00:12:34,780 --> 00:12:35,880
أوتظنّين ذلك؟

180
00:12:35,880 --> 00:12:38,770
إذا احتجتِ المُساعدة، فتواصلي معي

181
00:12:38,770 --> 00:12:41,160
لِمَ لا نختبر جاذبيّتنا الأنثويّة؟

182
00:12:42,760 --> 00:12:44,000
أنا مُمتنّ للمُساعدة

183
00:12:44,000 --> 00:12:46,050
لا يوجد قلق بشأن اكتشاف السّيّدة كاسوغا

184
00:12:46,050 --> 00:12:49,910
للأرواح الذّكوريّة والتذمُّر بشأن ذلك

185
00:12:49,910 --> 00:12:54,500
فهمت. لستُ واثقة تماماً، لكن
...إذا كان هذا ما تريدينه يا كليو

186
00:12:54,720 --> 00:12:55,640
بالفعل

187
00:12:57,450 --> 00:12:59,690
أوّلاً، نحتاج رتبة رفيعة بما يكفي
للتمكُّن من تأمين مُقابلة معه

188
00:12:59,690 --> 00:13:02,370
هل التّواجُد هنا سيُساهم في ذلك حقّاً؟

189
00:13:02,370 --> 00:13:05,540
قد يكون من الصّعب لفت انتباه الشّوغن

190
00:13:05,540 --> 00:13:08,690
من دون التبنّي بواسطة دايميو

191
00:13:08,690 --> 00:13:12,160
انحرفَتِ السّيّدةُ كاسوغا عن الواقع التّاريخيّ

192
00:13:12,160 --> 00:13:14,770
إنّها تمنح فُرصاً لأولئك الّذين يعملون بجدّ

193
00:13:14,770 --> 00:13:18,610
فهمت. رغم ذلك، لا أمتلك أي مهارات خاصّة

194
00:13:18,610 --> 00:13:22,070
سأساعدكِ في تحقيق سجلّ إيجابيّ

195
00:13:22,070 --> 00:13:23,910
شكراً يا روي-تشان

196
00:13:23,910 --> 00:13:26,790
سنبذل قصارى جهدنا دون أن نكون وقحتين

197
00:13:26,790 --> 00:13:27,780
حسناً

198
00:13:31,370 --> 00:13:34,390
انتهينا هنا. سنتوجّه إلى هناك تالياً

199
00:13:37,920 --> 00:13:39,350
أيُعقَل...؟

200
00:13:42,760 --> 00:13:44,630
!يا لجمالكما

201
00:13:44,950 --> 00:13:49,230
هل أنتما الفتاتان اللّتان أُرسِلتا
بواسطة سيتّي-دونو؟

202
00:13:49,230 --> 00:13:50,730
أنا سيريا آيبا

203
00:13:50,730 --> 00:13:51,630
روي

204
00:13:59,190 --> 00:14:01,640
أنا كاسوغا نو تسوبوني

205
00:14:01,640 --> 00:14:06,600
أدير القصر الدّاخليّ بالنّيابة عن زوجة الشّوغن

206
00:14:06,600 --> 00:14:10,510
كما تريان، يوجد الكثير من الخادمات هنا

207
00:14:10,510 --> 00:14:13,410
،رغم أنّه تمّ إرسالكما بواسطة سيتّي-دونو

208
00:14:13,410 --> 00:14:15,880
لا تزال مُقابلته صعبة

209
00:14:15,880 --> 00:14:18,670
بما أنّكما لستُما بنات قادة عسكريّين

210
00:14:19,010 --> 00:14:25,130
يجب أن أحكم أيضاً فيما إذا
كنتُما جديرتين بالشّوغن

211
00:14:25,130 --> 00:14:26,630
حـ-حاضرة

212
00:14:26,870 --> 00:14:29,090
عظيم. والآن، أستأذن بالانصراف

213
00:14:29,750 --> 00:14:35,010
بالمناسبة. الفتاة المُكلَّفة بتنظيف الحمّامات
مريضة وفي الفِراش اليوم

214
00:14:35,010 --> 00:14:38,520
أوسيري، هل يمكنكِ فعلها بالنّيابة عنها؟

215
00:14:38,520 --> 00:14:42,430
الحمّامات؟ أمركِ

216
00:14:45,650 --> 00:14:46,540
سيريا؟

217
00:14:46,540 --> 00:14:48,590
هذه فُرصة لنا

218
00:14:48,590 --> 00:14:52,330
كان الحاكم إيميتسو قد أقام علاقة
مع السّيّدة أوناتسو في الحمّامات

219
00:14:52,330 --> 00:14:56,200
إذاً إنّها فُرصة للّقاء بإيميتسو
دون بلوغ مرتبة أعلى

220
00:14:56,750 --> 00:14:59,220
...لكن إذا حاول إقامة علاقة معي

221
00:14:59,220 --> 00:15:00,790
دعيني أتولّى هذا الأمر

222
00:15:00,790 --> 00:15:01,580
كليو؟

223
00:15:01,580 --> 00:15:04,750
ثِقي بي في تولّي مثل هذه المسائل

224
00:15:04,750 --> 00:15:08,280
أنا أفضل بكثير في التّعامل مع الرّجال

225
00:15:08,280 --> 00:15:10,650
...هذا صحيح، لكن

226
00:15:11,180 --> 00:15:13,220
سنُحافظ على عفّتكِ

227
00:15:13,220 --> 00:15:17,900
إذا أراد المُتابعة، فيمكننا صدّه

228
00:15:17,900 --> 00:15:19,640
حسناً

229
00:15:22,180 --> 00:15:24,930
كـ-كيف هو الماء؟

230
00:15:25,550 --> 00:15:27,060
لا بأس به

231
00:15:27,060 --> 00:15:28,270
هكذا إذاً

232
00:15:32,620 --> 00:15:35,330
ماذا تفعلين؟ أسرعي وامسحي جسدي

233
00:15:38,210 --> 00:15:39,890
المعذرة

234
00:15:55,300 --> 00:15:58,940
هل من مُشكلة؟ هل أهنتُك؟

235
00:15:58,940 --> 00:16:00,470
لا، لم تفعلي

236
00:16:00,470 --> 00:16:02,380
هذا يكفي. سوف أخرج

237
00:16:02,380 --> 00:16:03,060
حسناً يا مولايّ

238
00:16:16,620 --> 00:16:17,780
أبليتِ حسناً

239
00:16:17,780 --> 00:16:21,050
إنّه يعرف من تكونين الآن، وقد تأكّدنا
من تفضيلاته وميوله

240
00:16:21,050 --> 00:16:23,250
لا تدعي الأمر يُحبطكِ

241
00:16:23,250 --> 00:16:26,170
قيل لنا بأنّه ليس مهتمّاً بالنّساء

242
00:16:26,170 --> 00:16:27,430
...أجل، لكن

243
00:16:27,430 --> 00:16:29,300
ينبغي أن ننتقل إلى إستراتيجيّتنا التّالية

244
00:16:29,610 --> 00:16:31,250
أنا أفعل هذا لأجل كليو أيضاً

245
00:16:31,250 --> 00:16:35,240
سأفعل المستحيل لصعود السّلّم
وأجعله يقع في حُبّي

246
00:16:41,000 --> 00:16:42,270
هذه لكما

247
00:16:44,440 --> 00:16:45,370
!مرحى

248
00:16:49,230 --> 00:16:53,150
هل يُسمَح لي حقّاً أن أرتدي
شيئاً جميلاً كهذا؟

249
00:16:53,150 --> 00:16:55,780
إنّه يلائمكِ يا أوسيري-ساما

250
00:16:55,780 --> 00:16:57,360
يسرّني ذلك

251
00:16:57,360 --> 00:16:59,560
نستأذن بالانصراف

252
00:17:02,520 --> 00:17:04,330
ابتداء من الغد، ستحضرين الإعلان العامّ

253
00:17:04,330 --> 00:17:07,630
ستحين فُرصتكِ عندما يُعاين جميع الحاضرين

254
00:17:07,630 --> 00:17:10,260
أعلم. لنتّبع الخطّة

255
00:17:44,520 --> 00:17:46,870
ما هو اسمكِ؟

256
00:17:47,260 --> 00:17:48,210
يا إلهي

257
00:17:49,540 --> 00:17:50,640
!مرحى

258
00:17:50,640 --> 00:17:51,460
!ممتاز

259
00:17:51,460 --> 00:17:52,910
بالطّبع

260
00:17:54,670 --> 00:17:58,130
لحظة، لماذا؟ ظننتُ بأنّ عليه أن يدعوني
إلى غرفة نومه وينتهي الأمر

261
00:17:58,750 --> 00:18:01,600
لا أستطيع أن أدعكِ تُغادرين الآن

262
00:18:03,870 --> 00:18:05,500
لن أفعل هذا

263
00:18:06,860 --> 00:18:07,880
...في هذه الحالة

264
00:18:09,600 --> 00:18:12,980
إراقة الدّماء محظورة في القصر الدّاخليّ

265
00:18:12,980 --> 00:18:16,190
لا يمكن فضّ الاتّفاقيّات أيضاً

266
00:18:16,190 --> 00:18:17,420
...لكن

267
00:18:17,420 --> 00:18:21,380
أوسيري، جذبتِ اهتمام الشّوغن

268
00:18:21,380 --> 00:18:23,990
أطلب منكِ أن تحملي بأطفاله

269
00:18:23,990 --> 00:18:25,230
...لـ-لا

270
00:18:25,230 --> 00:18:26,870
هيّا، تعالي

271
00:18:28,300 --> 00:18:29,290
!ماذا؟

272
00:18:29,760 --> 00:18:30,940
ما هذا؟

273
00:18:30,940 --> 00:18:32,130
لا بُدّ أنّه حدث شيء

274
00:18:32,500 --> 00:18:33,500
هيّا بنا

275
00:18:33,500 --> 00:18:34,210
حاضر

276
00:18:36,420 --> 00:18:38,050
ما-ماذا يجدر بي أن أفعل؟

277
00:18:38,050 --> 00:18:41,800
لا يمكننا فعل شيء إذا كنت
لا تستطيعين حمل سيف

278
00:18:42,040 --> 00:18:43,510
ليس هذا ما اتّفقنا عليه

279
00:18:43,510 --> 00:18:45,680
قيل لنا بأنّنا نحتاج لأن نتلقّى دعوة فقط

280
00:18:45,680 --> 00:18:47,450
اسمحي لنا بالاستحواذ عليكِ

281
00:18:47,450 --> 00:18:49,390
سوف نحمي عفّتكِ

282
00:18:49,390 --> 00:18:54,300
،لكن نحتاج هذه المنطقة للوصول إلى ميوكس
وهو مُجرّد شبح

283
00:18:54,300 --> 00:19:01,110
...فضلاً عن ذلك، أنا ميّتة جوهريّاً، صحيح؟ أنا

284
00:19:01,110 --> 00:19:03,620
ينبغي أن نُمكِّن أنفسنا كذلك

285
00:19:03,620 --> 00:19:04,630
!ماذا؟

286
00:19:05,370 --> 00:19:07,580
سيريا، تمالكي نفسكِ

287
00:19:11,420 --> 00:19:14,760
هـ-هذا... يمكنك المرور

288
00:19:14,760 --> 00:19:15,590
شكراً

289
00:19:17,130 --> 00:19:20,340
نحن جاهزون لأجلك يا مولايّ

290
00:19:20,340 --> 00:19:21,470
جيّد

291
00:19:27,810 --> 00:19:30,140
دعيني أرى وجهكِ

292
00:19:30,140 --> 00:19:31,290
حاضرة

293
00:19:37,900 --> 00:19:40,040
آسفة جميعاً

294
00:19:40,040 --> 00:19:42,110
لا عليكِ. أنتِ تُبلين حسناً

295
00:19:43,250 --> 00:19:44,820
توقّعت

296
00:19:45,090 --> 00:19:45,950
ماذا؟

297
00:19:45,950 --> 00:19:48,300
التقينا سابقاً في الحمّامات

298
00:19:48,300 --> 00:19:51,040
ظننتِ بأنّكِ تستطيعين خِداعي؟
كم هذا مُضحك

299
00:19:51,040 --> 00:19:53,750
ما الخدعة الّتي تستخدمينها؟ أريني

300
00:19:53,750 --> 00:19:55,130
...أنا

301
00:19:56,000 --> 00:19:57,170
لم أفعل ذلك

302
00:19:57,710 --> 00:20:01,100
ماذا؟ سيَفي هذا بالغرض

303
00:20:01,100 --> 00:20:02,220
اقتربي أكثر

304
00:20:02,760 --> 00:20:05,870
ماذا؟ لـ-لا، انتظر

305
00:20:05,870 --> 00:20:09,160
لا يمكن عصيان أوامر الشّوغن. هذا سيّئ

306
00:20:09,160 --> 00:20:10,930
لدينا مشاكل أكبر الآن

307
00:20:10,930 --> 00:20:14,120
لقد مكّنتُ عزيمتي

308
00:20:18,520 --> 00:20:19,540
!ها أنا ذا

309
00:20:19,540 --> 00:20:20,450
!توقّف

310
00:20:22,100 --> 00:20:23,740
من أنت؟

311
00:20:23,740 --> 00:20:26,320
!سلّميه

312
00:20:26,320 --> 00:20:27,740
!لا

313
00:20:28,910 --> 00:20:30,060
هيّا بنا

314
00:20:38,370 --> 00:20:39,300
من هنا

315
00:20:40,550 --> 00:20:41,970
ماذا؟

316
00:20:43,070 --> 00:20:45,670
!مولايّ؟ أوسيري، الحقي بهما

317
00:20:45,670 --> 00:20:47,140
!ماذا؟ حاضرة

318
00:20:47,140 --> 00:20:48,390
!بسرعة

319
00:20:52,190 --> 00:20:54,660
ماساموري؟ شيغيزومي؟

320
00:20:54,660 --> 00:20:55,980
يسرّني أنّك أتيت لأجلي

321
00:20:59,430 --> 00:21:00,800
!توقّف

322
00:21:00,800 --> 00:21:02,990
!انتظر

323
00:21:02,990 --> 00:21:04,090
ها أنا ذا

324
00:21:09,230 --> 00:21:11,160
يسرّني ذلك

325
00:21:11,160 --> 00:21:12,120
بالفعل

326
00:21:12,120 --> 00:21:14,450
حسناً، ماذا حدث بعد ذلك؟

327
00:21:15,690 --> 00:21:19,290
اختفى القصر الدّاخليّ، ونجحنا في تنصيب
البلاط الحجريّ تشياكو

328
00:21:19,550 --> 00:21:22,760
على أيّ حال، أتساءل غُلام مَن كان ذلك

329
00:21:22,760 --> 00:21:24,030
لا نعلم

330
00:21:24,890 --> 00:21:29,010
غالباً كنتُ لأعرفه لو كان شخصيّة
تاريخيّة شهيرة

331
00:21:29,010 --> 00:21:31,470
هل كان بتلك الوسامة حقّاً؟

332
00:21:34,040 --> 00:21:34,730
رُبّما؟

333
00:21:34,730 --> 00:21:36,030
ما معنى هذا؟

334
00:21:36,030 --> 00:21:38,980
%الظّروف جعلَتْه أكثر إثارة بنسبة 30

335
00:21:38,980 --> 00:21:44,440
رُبّما، لكن سوف أشكره إذا رأيتُه ثانية

336
00:21:44,710 --> 00:21:46,920
!مثل "الكثير من الجعجعة عن الحُبّ"؟

337
00:21:49,020 --> 00:21:50,830
على أيّ حال، حقّقنا هدفنا

338
00:21:54,850 --> 00:21:57,000
شكراً على مُساعدتكما يا سيريا وروي

339
00:21:58,550 --> 00:21:59,210
العفو

340
00:22:06,290 --> 00:22:09,490
شكراً لك يا سيتّي-سان