1
00:00:07,850 --> 00:00:09,570
أوديسيوس

2
00:00:10,680 --> 00:00:13,620
لا أشعر بترحيب كبير

3
00:00:14,810 --> 00:00:16,740
!موتي

4
00:00:18,660 --> 00:00:19,670
لماذا تفعل هذا؟

5
00:00:34,800 --> 00:00:35,390
...ميو

6
00:00:38,520 --> 00:00:42,150
هل تشعر برغبة في السّماح
لي بالكلام أخيراً؟

7
00:00:52,410 --> 00:00:53,660
الكلام؟

8
00:00:54,190 --> 00:00:56,990
لم أتوقّع أبداً أن تأتي لرؤيتنا

9
00:00:59,440 --> 00:01:00,830
تسرّني رؤيتكم من جديد

10
00:01:00,830 --> 00:01:02,190
!كفى هُراء

11
00:01:02,870 --> 00:01:04,040
ماذا تريدين؟

12
00:01:04,440 --> 00:01:06,700
أتيتُ لرؤيتهم

13
00:01:07,120 --> 00:01:11,760
يستحقّون المديح لإفلاتهم
من سيطرة ميوكس

14
00:01:11,760 --> 00:01:12,980
سيطرة؟

15
00:01:12,980 --> 00:01:14,720
تقصدين اليعاسيب السّوداء؟

16
00:01:15,670 --> 00:01:18,090
هل أتيت لتجنيدهم؟

17
00:01:18,090 --> 00:01:23,440
أجل. فهُم ينتمون لميوكس العظيمة

18
00:01:24,490 --> 00:01:25,860
!أين ميوكس؟

19
00:01:25,860 --> 00:01:27,470
أين بالفعل؟

20
00:01:27,470 --> 00:01:30,650
نصّبتُ نسخةً هنا، لذا رُبّما الأصليّة
قد زالت بالفعل

21
00:01:31,780 --> 00:01:34,170
نسختِ ذلك البرنامج؟

22
00:01:34,170 --> 00:01:36,700
لكن لا يمكن أن يعمل من دون قوّة روحيّة

23
00:01:36,920 --> 00:01:41,400
ليس هذا فحسب، لكنّها تدمج
...الدّارتين الرّوحيّة والكهربائيّة

24
00:01:41,940 --> 00:01:42,920
أيُعقَل ذلك؟

25
00:01:42,920 --> 00:01:49,130
يمكننا تحويل الطّاقة الرّوحيّة الخاصّة
بعالم الطّيف بأعلى كفاءة

26
00:01:49,480 --> 00:01:53,890
،"فأساساً، لدى آكت بلوتو "إديسون
مُهندس استثنائيّ

27
00:01:54,560 --> 00:01:57,720
كيف تنوين استخدام ميوكس؟

28
00:01:57,720 --> 00:02:00,340
أستخدم؟ أنت مُخطئ

29
00:02:00,340 --> 00:02:05,780
آكت وبلوتو وأنا نتصرّف بناء
على أُمنيات ميوكس

30
00:02:06,440 --> 00:02:09,190
نحن ننسج رؤى ميوكس

31
00:02:09,190 --> 00:02:12,650
عالم بلا صِراعات

32
00:02:12,650 --> 00:02:15,110
هل تحتاجين حقّاً لتخليصنا من الموسيقى
للقيام بذلك؟

33
00:02:16,820 --> 00:02:18,740
هذا أمرٌ مُؤقَّت

34
00:02:18,740 --> 00:02:24,290
حالما نسيطر بشكل كامل على الخبث
البشريّ، سوف نُحرّر الموسيقى

35
00:02:24,290 --> 00:02:26,500
السّيطرة على الخبث؟

36
00:02:26,500 --> 00:02:28,100
هذا مُستحيل

37
00:02:28,100 --> 00:02:30,710
لن أُهزَم بواسطة موسيقى العزاء خاصّتكِ

38
00:02:30,710 --> 00:02:33,420
لهذا أتيتُ لضمّكم

39
00:02:34,100 --> 00:02:36,800
...لديهم سبب خلف ما يفعلونه، لكن

40
00:02:38,350 --> 00:02:40,260
عالم بِلا صِراع

41
00:02:40,710 --> 00:02:45,160
ملايين ومليارات النّاس قد تمنّوا ذلك

42
00:02:45,900 --> 00:02:47,620
لكن هذا غير قابل للإنجاز

43
00:02:47,620 --> 00:02:50,110
!لا يمكنك مسح عواطف البشر

44
00:02:51,020 --> 00:02:54,320
يبدو أنّكم عدوّ ميوكس

45
00:02:54,320 --> 00:02:55,120
يوكيهيتو

46
00:02:55,120 --> 00:02:55,780
أعلم

47
00:02:58,370 --> 00:02:59,620
ماذا تفعل؟

48
00:03:00,740 --> 00:03:03,200
ألا يمكنكِ معرفة ذلك؟

49
00:03:04,060 --> 00:03:07,210
لا يهمّ. تعالي يا ريكو

50
00:03:07,960 --> 00:03:08,790
حسناً

51
00:03:08,790 --> 00:03:09,420
أيُعقَل؟

52
00:03:09,420 --> 00:03:09,740
ريكو

53
00:03:09,740 --> 00:03:11,140
!انتظري

54
00:03:11,140 --> 00:03:14,420
آسفة. الأولويّة لأهدافي الشّخصيّة

55
00:03:14,420 --> 00:03:15,110
ريكو

56
00:03:15,110 --> 00:03:17,600
فضلاً عن ذلك. لم يعُد لـ تيرا وجود الآن

57
00:03:17,600 --> 00:03:20,220
سأحقّق لها أُمنيتها

58
00:03:20,490 --> 00:03:23,610
يوماً ما سنبني الفضاء للوُسطاء الرُّوحيّين

59
00:03:22,310 --> 00:03:24,390
!ريكو

60
00:03:24,390 --> 00:03:27,340
هذه أوّل مرّة أسمع فيها صرختكِ

61
00:03:27,340 --> 00:03:28,770
ستفقدين صوتكِ

62
00:03:28,770 --> 00:03:33,610
ما رأيكم؟ إحدى صديقاتكم انضمّتْ
لآكت بلوتو بالفعل

63
00:03:33,610 --> 00:03:37,480
...آكت بلوتو؟ حسناً، سأذهب معكِ

64
00:03:38,280 --> 00:03:40,620
!وذلك كي أُسقطكم جميعاً

65
00:03:40,620 --> 00:03:42,950
!سأعيش مع شكوكي

66
00:03:42,950 --> 00:03:44,790
!سأستعيد الجميع

67
00:03:47,910 --> 00:03:49,210
هكذا إذاً

68
00:03:49,660 --> 00:03:52,300
في هذه الحالة، لستُ بحاجة
لسّماح لكُن بالعيش

69
00:03:52,300 --> 00:03:53,590
سوف أفعلها أنا

70
00:03:53,910 --> 00:03:55,800
دعيني أحسم هذا الأمر

71
00:03:56,090 --> 00:03:57,340
كما تشائين

72
00:03:58,310 --> 00:04:01,680
تعالينَ إليّ أيّتها السّاحرات الحمقاوات
!اللّواتي استسلمنَ لي

73
00:04:02,020 --> 00:04:06,850
،ماري ديسبيليكيت، إزابو تشيني
!آليس كيتيلر، مازر شيبتون

74
00:04:06,850 --> 00:04:08,870
!اقتلنَ ذلك الرّجل

75
00:04:08,870 --> 00:04:09,530
عُلِم

76
00:04:09,530 --> 00:04:12,110
جميعهن بقوّة الأشباح العظيمة؟

77
00:04:12,110 --> 00:04:14,280
لا أستطيع حتّى رؤية أعدائنا

78
00:04:14,670 --> 00:04:15,900
سايونجي-سان

79
00:04:16,260 --> 00:04:17,110
ما هذا؟

80
00:04:17,110 --> 00:04:21,360
كنتُ قد احتفظتُ بها، نظراً إلى وجود
خطر إيقاظها لقدراتكِ الرُّوحيّة

81
00:04:21,360 --> 00:04:23,120
لقد مكّنتُ نفسي بالفعل

82
00:04:23,120 --> 00:04:26,060
!موراماسا، ساعدينا في طرد الظّلام

83
00:04:26,060 --> 00:04:29,040
!تزامُن الرُّوح والسّلاح: التّشكيل المُتعدّد

84
00:04:29,040 --> 00:04:32,500
!بوكودين تسوكاهارا، ويليام تيل، زاو يون

85
00:04:32,500 --> 00:04:34,710
!مُريهم يا يويتشي

86
00:04:34,710 --> 00:04:36,270
!خذي كُلّ ما لديّ

87
00:04:36,270 --> 00:04:37,430
!لن أسمح بحدوث ذلك

88
00:04:37,430 --> 00:04:38,990
!هالة شظيّة الرُّوح

89
00:04:38,990 --> 00:04:40,840
!وحوش الاستحضار

90
00:04:41,220 --> 00:04:42,720
!الاستحواذ المُزدوج

91
00:04:42,720 --> 00:04:45,350
!إيريك، يوراي يانوشيك

92
00:04:46,320 --> 00:04:47,600
أنتِ عديمة الرّحمة

93
00:04:47,600 --> 00:04:50,270
ريكو، هذه آخر فُرصة لتقولي بأنّكِ تمزحين

94
00:04:51,210 --> 00:04:54,150
أتعتقدين بأنّها مزحة؟ هيّا

95
00:04:54,150 --> 00:04:56,920
!اقتلنَ كُلّ من يعترض طريقنا

96
00:04:57,820 --> 00:04:59,400
!ختم الحصن

97
00:05:01,070 --> 00:05:03,370
!ماذا سنفعل؟ هذا سيّئ للغاية

98
00:05:04,100 --> 00:05:06,600
لا أريد أذيّة أحد بالخطأ

99
00:05:07,830 --> 00:05:09,530
!انفجار الحصن

100
00:05:14,790 --> 00:05:15,720
آليس

101
00:05:15,720 --> 00:05:17,000
إيزابو

102
00:05:17,000 --> 00:05:18,250
!يا للطّيش

103
00:05:18,250 --> 00:05:20,480
هل يحاولون إسقاطنا معهم؟

104
00:05:21,220 --> 00:05:23,430
!مُحال

105
00:05:23,720 --> 00:05:25,940
أتعتقدين بأنّكِ قادرة على مُقاتلتنا بمفردكِ؟

106
00:05:25,940 --> 00:05:27,390
هذا مُضحك

107
00:05:27,390 --> 00:05:31,360
!أنتن تحلمنَ أيّتها الأشباح

108
00:05:32,500 --> 00:05:34,780
اثنتان منكم؟ كم هذا مُلائم

109
00:05:34,780 --> 00:05:38,790
لم أتوقّع أن أقاتل جنباً إلى جنب
معك يا أبي

110
00:05:38,790 --> 00:05:40,310
هذه هي المرّة الأولى والوحيدة

111
00:05:40,310 --> 00:05:41,530
لنُنهِ هذا هنا

112
00:05:41,530 --> 00:05:43,020
حسناً

113
00:05:45,160 --> 00:05:46,560
!سيكون هذا سهلاً

114
00:05:47,900 --> 00:05:51,120
كم من المدّة تستطيعان تحمُّل
حجارة الظّلام خاصّتي؟

115
00:05:52,280 --> 00:05:53,330
...على هذا المُعدّل

116
00:05:53,330 --> 00:05:55,410
!هيّا! قيّدوها

117
00:05:55,860 --> 00:05:57,220
!يا للوقاحة

118
00:05:59,710 --> 00:06:00,840
من جديد

119
00:06:02,090 --> 00:06:04,050
!تبّاً لكِ

120
00:06:04,320 --> 00:06:06,180
!لن أموت ثانية

121
00:06:11,230 --> 00:06:12,480
!لا

122
00:06:22,320 --> 00:06:23,320
مُدهش

123
00:06:24,080 --> 00:06:25,880
آسفة يا سيريا-تشان

124
00:06:25,880 --> 00:06:27,740
هكذا تضغطين على نفسكِ

125
00:06:29,000 --> 00:06:30,700
أما زال في جعبتكِ المزيد من الخدع؟

126
00:06:30,700 --> 00:06:32,370
بالطّبع

127
00:06:33,100 --> 00:06:36,130
!اخرجي. سأستخدمها كلّها

128
00:06:36,430 --> 00:06:38,080
!هالة شظيّة الرُّوح

129
00:06:38,080 --> 00:06:39,800
لا ينبغي أن تكون ريكو قادرة
على فعل ذلك

130
00:06:43,800 --> 00:06:46,200
!ريكو

131
00:06:48,550 --> 00:06:50,950
!استسلمي فحسب

132
00:06:51,700 --> 00:06:54,100
قنابل؟

133
00:06:54,100 --> 00:06:55,480
!لا أستطيع التّحليق بعد الآن

134
00:06:55,480 --> 00:06:56,480
!سأُنهي هذا

135
00:06:57,560 --> 00:07:00,960
!كافحي! فُرصة واحدة

136
00:07:05,040 --> 00:07:06,660
!اصمتي

137
00:07:07,580 --> 00:07:08,550
!أستطيع التّحليق ثانية

138
00:07:08,550 --> 00:07:12,970
!ما مُشكلتكِ؟ موتي فحسب

139
00:07:11,880 --> 00:07:12,970
!سأُنهي هذا

140
00:07:15,180 --> 00:07:16,880
شكراً على القيام بهذا

141
00:07:16,880 --> 00:07:18,460
هل عزّزنا قدرتها؟

142
00:07:18,890 --> 00:07:20,540
ما الّذي يجري؟

143
00:07:21,100 --> 00:07:22,170
انشطرتْ

144
00:07:22,630 --> 00:07:23,390
كيف يمكننا هزيمتها؟

145
00:07:23,390 --> 00:07:25,050
لا تخافي يا كايدي

146
00:07:25,050 --> 00:07:26,550
لكلّ شيء حدوده

147
00:07:26,550 --> 00:07:29,680
!أريهم قدرات البشر

148
00:07:29,680 --> 00:07:30,700
!حاضرة

149
00:07:36,560 --> 00:07:38,910
!تشيل، مي، توتسو، تين

150
00:07:38,910 --> 00:07:40,400
!تشيمايرا الرّوحيّة

151
00:07:40,400 --> 00:07:41,980
!سارعوا إلى ريكو

152
00:07:41,980 --> 00:07:44,280
!سيبولد، خذي هذه

153
00:07:45,530 --> 00:07:46,530
روي

154
00:07:47,390 --> 00:07:48,560
!موتي

155
00:07:59,330 --> 00:08:01,250
!ريكو

156
00:08:04,120 --> 00:08:05,170
!ها هي ذي

157
00:08:11,430 --> 00:08:16,230
ليت تأنيب الضّمير غير موجود

158
00:08:17,430 --> 00:08:19,900
كسبتُ بعض الوقت

159
00:08:21,860 --> 00:08:24,530
بقي القليل فقط

160
00:08:25,590 --> 00:08:27,070
إلى اللّقاء

161
00:08:27,070 --> 00:08:28,200
ريكو؟

162
00:08:37,400 --> 00:08:38,420
!لا

163
00:08:47,000 --> 00:08:49,420
كان ذلك أداء ممتازاً

164
00:08:49,420 --> 00:08:51,300
أليس كذلك، ماما؟

165
00:08:53,110 --> 00:08:56,520
لا تُناديني بذلك

166
00:08:56,890 --> 00:08:58,980
!سأرسلكِ إلى الجحيم

167
00:09:00,750 --> 00:09:03,690
سيريا-تشان. جيّد

168
00:09:04,810 --> 00:09:06,650
لماذا تبكين؟

169
00:09:06,940 --> 00:09:10,450
يوكيهيتو، ينتهي دوري هنا

170
00:09:10,760 --> 00:09:12,360
أعلم بأنّ ميو على قيد الحياة

171
00:09:12,360 --> 00:09:14,380
يجب عليك إنقاذها

172
00:09:15,580 --> 00:09:17,080
أراك لاحقاً يا يوكيهيتو

173
00:09:17,450 --> 00:09:18,820
أنا متأكّدة بأنّنا سنلتقي ثانية

174
00:09:25,450 --> 00:09:27,210
توقّفي

175
00:09:28,440 --> 00:09:31,580
هل أنتِ سيريا، الّتي لم يصلها صوتنا؟

176
00:09:31,580 --> 00:09:33,540
أرجوكِ، انضمّي لآكت بلوتو

177
00:09:33,540 --> 00:09:37,100
لنبنِ رؤية ميوكس للأرض الفاضلة معاً

178
00:09:37,960 --> 00:09:40,350
أحبّ الأشياء على طبيعتها

179
00:09:40,350 --> 00:09:46,360
،حتّى مع كلّ المُعاناة، والحزن
،والغضب، والألم

180
00:09:46,360 --> 00:09:48,820
!أحبّ الأشياء كما هي

181
00:09:49,390 --> 00:09:52,780
حقّاً؟ هذا مُؤسف

182
00:09:53,450 --> 00:09:54,990
ما-ما هذا؟

183
00:09:54,990 --> 00:09:57,270
إله العصر الجديد

184
00:09:57,270 --> 00:10:00,200
ستكونون أوّل من يشهده

185
00:10:00,780 --> 00:10:02,160
إله؟

186
00:10:02,160 --> 00:10:03,370
هذا هُراء

187
00:10:04,330 --> 00:10:07,540
سيتّي-سان، أمهلني بعض الوقت

188
00:10:12,000 --> 00:10:17,080
،كليو، سيزَر، أنطونيوس، سوجي
،فلو، يوشيتسوني

189
00:10:17,080 --> 00:10:22,400
،لاكشميباي، جان، زو يو
ريمبراند، سانا-سان، نيكولا

190
00:10:23,370 --> 00:10:25,050
مدّوني بقوّتكم

191
00:10:27,360 --> 00:10:30,700
سيريا، يسرّني أن أعود إليكِ

192
00:10:30,700 --> 00:10:32,980
شكّلنا عبئاً كبيراً عليكِ

193
00:10:32,980 --> 00:10:35,510
!نُقدّم كُلّ قوّتنا لكِ

194
00:10:35,510 --> 00:10:36,700
!لا تفعليها يا سيري-تشان

195
00:10:36,700 --> 00:10:39,430
!لا يستطيع جسدكِ تحمُّل كلّ هذه الأرواح

196
00:10:39,430 --> 00:10:42,370
!إنّها الطريقة الوحيدة لهزيمتها

197
00:10:42,370 --> 00:10:43,720
!ثِقوا بي

198
00:10:46,250 --> 00:10:47,670
سيري-تشان

199
00:10:47,990 --> 00:10:50,460
سأحافظ على جسدكِ

200
00:10:50,880 --> 00:10:52,550
!اجعلي سيوفنا قوّة لكِ

201
00:10:52,550 --> 00:10:53,480
!وحكمتي

202
00:10:53,480 --> 00:10:54,640
!فرشاتي

203
00:10:54,640 --> 00:10:55,970
!قلبي

204
00:10:56,270 --> 00:10:58,510
!سوف تحمين مُستقبلنا

205
00:11:01,230 --> 00:11:02,410
هذا صحيح

206
00:11:03,390 --> 00:11:05,560
يجب أن أفعل هذا

207
00:11:09,660 --> 00:11:12,030
تلقّي تعميد الإله

208
00:11:39,070 --> 00:11:43,220
!تجسيد خوف النّاس، أوديسيوس

209
00:11:43,220 --> 00:11:47,600
!بقبضتي الحُبّ خاصّتي، تطهّري

210
00:11:51,650 --> 00:11:54,420
!لن أغنّي لأجلكِ

211
00:12:13,850 --> 00:12:14,560
!سيري-تشان

212
00:12:14,560 --> 00:12:15,140
سيريان

213
00:12:15,140 --> 00:12:16,010
سيريا

214
00:12:16,410 --> 00:12:17,440
سيتّي-سان

215
00:12:17,440 --> 00:12:19,080
خذنا إلى ميوكس

216
00:12:19,080 --> 00:12:20,060
حسناً

217
00:12:24,310 --> 00:12:25,390
أين نحن؟

218
00:12:25,390 --> 00:12:27,850
هل تأخّرنا كثيراً؟

219
00:12:27,850 --> 00:12:29,900
هل هذا المكان الّذي أتينا إليه من قبل؟

220
00:12:29,900 --> 00:12:31,900
ذلك البناء، صحيح؟

221
00:12:33,100 --> 00:12:35,030
لا تفقدوا الأمل

222
00:12:35,450 --> 00:12:36,700
معكِ حقّ

223
00:12:38,240 --> 00:12:38,990
!سيتّي-سان

224
00:12:40,540 --> 00:12:42,030
من فضلك يا فلو

225
00:12:43,280 --> 00:12:44,540
لماذا؟

226
00:12:44,540 --> 00:12:46,620
إنّها مُدرِكة لوضعكِ

227
00:12:47,160 --> 00:12:48,160
ماذا يجدر بي أن أفعل؟

228
00:12:48,160 --> 00:12:52,130
نشر عالم الطّيف والانتقال الآنيّ
...خارج المنطقة المأهولة

229
00:12:52,130 --> 00:12:55,300
القيام بالشّيئين معاً يُكلّف
أكثر من مُجرّد قوّة روحيّة

230
00:12:54,120 --> 00:12:56,670
اصمت. هيّا بنا

231
00:13:07,390 --> 00:13:08,640
لا تُحمّل نفسك ما هو فوق طاقتك

232
00:13:10,700 --> 00:13:11,350
أنزلني

233
00:13:11,350 --> 00:13:14,770
أهذا ما يُطلق عليه النّاسُ بـ"العزيز"؟

234
00:13:14,770 --> 00:13:16,480
الوقت ليس مُناسباً للمُزاح الآن

235
00:13:16,720 --> 00:13:18,680
...لـ-لا أعتقد ذلك

236
00:13:18,680 --> 00:13:20,760
عيونه الأربعة أصبحت اثنتين

237
00:13:21,660 --> 00:13:25,870
...هذا ليس وقت المُزاح، لكن حتّى الآن

238
00:13:25,870 --> 00:13:27,330
ما زال بمقدورنا أن نضحك

239
00:13:27,680 --> 00:13:28,660
معك حقّ

240
00:13:30,250 --> 00:13:31,320
هيّا بنا

241
00:13:36,910 --> 00:13:38,140
ما هذا؟

242
00:13:40,340 --> 00:13:41,090
!ميو

243
00:13:41,800 --> 00:13:43,190
!ميو-تشان

244
00:13:43,190 --> 00:13:45,540
...ميوكس بالفعل

245
00:13:47,870 --> 00:13:48,940
هناك

246
00:13:49,740 --> 00:13:51,310
عدت

247
00:13:51,310 --> 00:13:52,770
صوت ميو-تشان؟

248
00:13:53,000 --> 00:13:55,070
جيّد

249
00:13:55,480 --> 00:13:57,140
لكن ماذا ينبغي أن نفعل؟

250
00:13:57,140 --> 00:14:00,070
لا أعلم كيف يمكننا احتجازها لدينا

251
00:14:00,070 --> 00:14:03,200
معك حقّ، لكن لنستمتع بهذه اللّحظة

252
00:14:03,200 --> 00:14:05,750
كيف أمكنكم القيام بهذا؟

253
00:14:05,750 --> 00:14:07,960
لن أكون على طبيعتي إذا لم أغضب

254
00:14:07,960 --> 00:14:09,290
ألا يُؤلم ذلك؟

255
00:14:09,290 --> 00:14:10,910
ماذا؟ أجل

256
00:14:10,910 --> 00:14:12,710
هل تحتاجين قلقَكِ؟

257
00:14:12,710 --> 00:14:14,880
إنّه مُهمٌّ جدّاً بالنّسبة لي

258
00:14:14,880 --> 00:14:16,340
وحزنك؟

259
00:14:17,610 --> 00:14:20,120
هكذا إذاً. لكن لماذا؟

260
00:14:20,120 --> 00:14:23,090
بابا أعاد ماما إلى الحياة

261
00:14:23,340 --> 00:14:25,470
لماذا عدت؟

262
00:14:25,470 --> 00:14:27,890
لم يفت الأوان كثيراً على استدعاء ماما

263
00:14:28,100 --> 00:14:29,080
!سيري-تشان

264
00:14:29,080 --> 00:14:31,810
...أجزاء قوّة ميو الّتي تبعثرتْ

265
00:14:32,120 --> 00:14:33,700
!كيف لكم أن تتحلّوا بالهدوء؟

266
00:16:12,510 --> 00:16:13,990
شكراً لكِ يا سيريا

267
00:16:13,990 --> 00:16:15,750
لا شكر على واجب

268
00:16:15,750 --> 00:16:19,500
فهمتُ الآن لماذا بابا وماما لم يمنعا الأغاني

269
00:16:19,500 --> 00:16:20,210
هكذا إذاً

270
00:16:20,420 --> 00:16:22,610
،الأغاني تُرشد النّاس

271
00:16:22,610 --> 00:16:26,840
حتّى لو كانت تُشجّع على الخبث
والتعطُّش للدّماء أيضاً

272
00:16:26,840 --> 00:16:31,590
كان من الغرور أن نعتقد بأنّنا
نستطيع إنقاذ البشريّة

273
00:16:31,590 --> 00:16:33,340
لكن هذا ما تريدونه فعلاً

274
00:16:33,340 --> 00:16:35,090
أليس هذا جيّداً بما يكفي؟

275
00:16:35,090 --> 00:16:35,840
أجل

276
00:16:36,510 --> 00:16:37,820
هل ستستمرّين؟

277
00:16:38,190 --> 00:16:41,380
أجل. سأحقّق هدفي

278
00:16:41,380 --> 00:16:46,230
لتحقيق تلك الغاية، سأحرّر الموسيقى
وأستمع لمزيد من الأغاني

279
00:16:46,230 --> 00:16:48,390
حسناً! سيكون جدّي سعيداً

280
00:16:48,390 --> 00:16:50,700
...مزايا الشّخص الميّت خاصّتي

281
00:16:50,700 --> 00:16:52,960
أنا آسفة جميعاً

282
00:16:52,960 --> 00:16:55,120
أخذتُ شيئاً مُهمّاً منكم

283
00:16:55,120 --> 00:16:56,550
أجل، صحيح

284
00:16:56,550 --> 00:17:00,100
لكن لأنّكِ فعلتِ ذلك، نحن هنا الآن

285
00:17:00,100 --> 00:17:03,590
إن لم تستطيعي التحكُّم بالخبث
...في تلك الأُغنية

286
00:17:03,590 --> 00:17:05,710
ستتحوّل آكاري إلى قاتلة فوراً

287
00:17:05,710 --> 00:17:06,550
أنتِ

288
00:17:06,780 --> 00:17:09,320
لعلّنا رأينا عالَماً لم نُرِد رؤيته

289
00:17:09,320 --> 00:17:14,010
أنا مسرورة وأشعر في نفس الوقت
بتأنيب الضّمير لحصولي على دعمكم

290
00:17:14,790 --> 00:17:16,580
لا تقلقي بشأن ذلك

291
00:17:17,280 --> 00:17:17,970
ميو

292
00:17:18,300 --> 00:17:19,180
نعم؟

293
00:17:19,470 --> 00:17:21,350
هل ترغبين في زيارة العالم البشريّ؟

294
00:17:22,520 --> 00:17:24,670
وُلِدتُ هنا

295
00:17:24,670 --> 00:17:27,110
لا أستطيع العيش في أيّ مكان آخر

296
00:17:27,750 --> 00:17:29,180
هكذا إذاً

297
00:17:29,180 --> 00:17:30,130
بابا

298
00:17:30,840 --> 00:17:32,410
هل ستأتي لرؤيتي ثانية؟

299
00:17:35,480 --> 00:17:37,620
أجل، أعدك

300
00:17:37,620 --> 00:17:41,110
لم نستطع إغلاق عالم الطّيف

301
00:17:41,110 --> 00:17:45,710
سيترتّب على سوجيك إعادة النّظر
في مُخطّطاتها للمُستقبل

302
00:17:46,230 --> 00:17:49,210
الأمر لن يكون بتلك الصّعوبة

303
00:17:49,210 --> 00:17:51,710
سوف نتبع أهواءنا

304
00:17:52,910 --> 00:17:55,770
سيريا، سأنتظر أغنيتكِ

305
00:17:56,090 --> 00:17:58,560
سأوفّر الغناء المُصاحب الجميل

306
00:17:58,560 --> 00:18:02,400
حسناً. أعدكِ بأنّني سأُغنّي في مكانٍ آخر

307
00:18:02,400 --> 00:18:04,490
بالتّوفيق يا ميو-تشان

308
00:18:06,030 --> 00:18:06,850
حسناً

309
00:19:32,810 --> 00:19:34,070
كُلي بشكل أسرع

310
00:19:34,070 --> 00:19:36,030
سأذهب إلى المدرسة أيضاً

311
00:19:36,920 --> 00:19:38,740
هل اعتدتِ على المدرسة؟

312
00:19:38,740 --> 00:19:40,860
ليس بعد، لكنّها مُمتعة

313
00:19:40,860 --> 00:19:42,360
في الجانب الشّماليّ من الجبل؟

314
00:19:42,360 --> 00:19:45,790
أجل. بما أنّه رُمِّم، فهي رحلة
سريعة عبر الحافلة

315
00:19:45,790 --> 00:19:49,080
لا أصدّق بأنّهم اشتروا الجبل بأكمله

316
00:19:49,080 --> 00:19:51,590
لا يمكن الاستهانة بمجموعة سايونجي

317
00:19:51,590 --> 00:19:54,460
استعرضوا مكانة رابع أثرى مُنظّمة في العالم

318
00:19:54,460 --> 00:19:57,310
بهذا المال، أستطيع شراء دوجو أحلامي

319
00:19:57,310 --> 00:19:59,430
نستطيع مُساعدة كلّ طفل
ذي قدرات روحيّة

320
00:19:59,430 --> 00:20:02,090
على أيّ حال يا روي، كنتِ
تتكلّمين كثيراً مؤخّراً

321
00:20:02,090 --> 00:20:03,140
أنتِ تتخيّلين ذلك

322
00:20:03,350 --> 00:20:04,360
حقّاً؟

323
00:20:04,360 --> 00:20:09,240
تخرجين عن السّيطرة بسرعة دون وجود
ريكو، لذا أتكلّم نيابة عنها

324
00:20:11,870 --> 00:20:12,660
كاي-تشان

325
00:20:12,660 --> 00:20:13,940
ما الأمر؟

326
00:20:15,320 --> 00:20:16,610
بئساً

327
00:20:17,000 --> 00:20:18,570
هناك أرزّ على وجهك

328
00:20:22,840 --> 00:20:25,360
...سيري-تشان، أُحبّ

329
00:20:26,960 --> 00:20:29,650
...بالمُناسبة، وعدنا برؤية شروق الشّمس

330
00:20:30,420 --> 00:20:31,560
لم نفعل ذلك بعد

331
00:20:32,230 --> 00:20:33,420
لنذهب ونرها يوماً ما

332
00:20:34,380 --> 00:20:35,590
جميعنا معاً

333
00:20:36,890 --> 00:20:37,690
حسناً

334
00:20:43,110 --> 00:20:44,180
كاي-تشان؟

335
00:20:46,410 --> 00:20:47,230
حمقاء

336
00:20:47,820 --> 00:20:48,690
ماذا؟

337
00:20:48,690 --> 00:20:50,520
!حمقاء! أكرهكِ

338
00:20:50,520 --> 00:20:52,560
!ماذا؟

339
00:20:59,670 --> 00:21:03,060
هذا ليس جيّداً لصحّتك يا سيتّي-سان

340
00:21:08,780 --> 00:21:11,040
اعفيني من هذا الانطباع الفظيع

341
00:21:12,270 --> 00:21:13,700
أليس هذا مُنافياً للقواعد؟

342
00:21:13,700 --> 00:21:15,840
أنا ميّت. يُسمَح لي بذلك

343
00:21:16,250 --> 00:21:17,390
أتريدين واحدة؟

344
00:21:18,160 --> 00:21:19,620
شكراً لك

345
00:21:19,620 --> 00:21:21,850
ماذا؟ كنتُ أمزح. لا تفعلي

346
00:21:21,850 --> 00:21:22,710
ماذا؟

347
00:21:22,710 --> 00:21:24,680
من يتّخذ هذا بجدّية؟

348
00:21:27,440 --> 00:21:29,640
لماذا خرجت إلى هنا؟

349
00:21:31,600 --> 00:21:33,290
شعرتُ برغبةٍ في ذلك فحسب

350
00:21:42,760 --> 00:21:44,990
سيتّي-سان، أُحبّك

351
00:21:46,780 --> 00:21:48,450
أنا أحبّ نفسي أيضاً

352
00:21:49,310 --> 00:21:50,910
في الواقع، أكرهك

353
00:21:51,320 --> 00:21:52,360
حقّاً؟

354
00:21:55,370 --> 00:21:56,880
لا مُشكلة إذاً

355
00:21:57,320 --> 00:21:58,550
أستطيع فعل ذلك

356
00:21:58,550 --> 00:21:59,590
ماذا؟

357
00:22:02,330 --> 00:22:05,250
تعلّمتُ التّدخين لتقليد شخص أيضاً

358
00:22:05,900 --> 00:22:07,900
إنّه ليس شيئاً أردتُ فعله

359
00:22:09,300 --> 00:22:11,810
لكنّه أصبح الآن عادة؟

360
00:22:12,180 --> 00:22:13,480
لستُ أدري

361
00:22:13,940 --> 00:22:17,300
سأقضي الأشهر الثّلاثة المُقبلة
أفعل ما يحلو لي

362
00:22:18,230 --> 00:22:21,600
...إذا كنت ستفعل ما يحلو لك

363
00:22:28,840 --> 00:22:32,190
فلا تمُت فحسب. أرجوك

364
00:22:37,080 --> 00:22:39,210
حتّى لو مُتُّ، سنرى بعضنا الآخر ثانية

365
00:22:40,100 --> 00:22:41,320
لا تقلقي

366
00:23:14,560 --> 00:23:17,330
سيتّي-سان

367
00:23:18,660 --> 00:23:21,790
لِمَ لا أقلق؟

368
00:23:23,090 --> 00:23:25,800
الجميع يخشون الموت

369
00:23:27,460 --> 00:23:31,610
لكن ينبغي أن نبتسم عندما نحزن

370
00:23:36,220 --> 00:23:38,970
لذا سأُغنّي