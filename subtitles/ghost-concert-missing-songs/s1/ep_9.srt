1
00:00:01,570 --> 00:00:03,860
حسناً، ماذا ينبغي أن نفعل؟

2
00:00:03,860 --> 00:00:06,480
ستتجمّع الكثير من الأرواح الظّلاميّة
في قلعة نيرو

3
00:00:06,790 --> 00:00:11,610
عملنا هو توجيهها نحو أداة جمع الأرواح

4
00:00:14,050 --> 00:00:16,380
ستُغنّي سيريا كفصل افتتاحيّ لنيرو

5
00:00:16,380 --> 00:00:19,030
ستتجمّع غالبيّة الأرواح حينها

6
00:00:20,970 --> 00:00:23,050
سيري-تشان ستُغنّي؟

7
00:00:23,380 --> 00:00:25,770
وسيُغنّي نيرو بعدها؟

8
00:00:25,770 --> 00:00:27,750
،حتّى لو غنّيا

9
00:00:27,750 --> 00:00:30,850
سنكون مرئيّين بوضوح أمامهم
وسط الجمهور، صحيح؟

10
00:00:30,850 --> 00:00:32,530
ما هي خطّتكم؟

11
00:00:33,630 --> 00:00:35,470
سأُحطّم الأداة

12
00:00:36,570 --> 00:00:38,720
ستخرج الأرواح الظّلاميّة منها دُفعة واحدة

13
00:00:38,720 --> 00:00:40,430
سنستغلّ أفضليّة الفوضى

14
00:00:40,720 --> 00:00:46,310
لكن ألن ينتهي أمرنا إذا اكتشفوا
بأنّنا هنا لإنقاذ سيريا؟

15
00:00:46,540 --> 00:00:48,150
أخبرتُهم بالفعل

16
00:00:48,150 --> 00:00:49,550
ماذا؟

17
00:00:49,550 --> 00:00:51,850
نيرو لا يهتمّ إلّا بمصالحه

18
00:00:52,230 --> 00:00:54,440
لن يقتلنا فوراً

19
00:00:54,440 --> 00:00:57,900
عدم الوثوق بنا منذ البداية سيجعله
في موضع ضعف

20
00:01:00,260 --> 00:01:03,080
سانا-سان، هل أنتِ مُستعدّة لخيانة نيرو؟

21
00:01:06,980 --> 00:01:07,690
أجل

22
00:01:08,760 --> 00:01:10,960
أُحبّ سيريا

23
00:01:10,960 --> 00:01:13,870
أريدها أن تتحرّر

24
00:01:13,870 --> 00:01:15,570
لكن هل أنتِ حقّاً سوف...؟

25
00:01:15,920 --> 00:01:16,560
أجل

26
00:01:18,300 --> 00:01:20,160
حاليّاً، ركّزنَ على تنفيذ الخطّة

27
00:01:20,720 --> 00:01:23,190
أُخفي ورقةً رابحة تحسُّباً فقط

28
00:01:23,920 --> 00:01:24,900
حسناً

29
00:01:24,900 --> 00:01:27,070
ورقة رابحة؟

30
00:03:12,920 --> 00:03:17,500
مُذهل. إنّها مُحترفة حقيقيّة لفنون
السّيف القصير هوكوشين إيتّو-ريو

31
00:03:17,500 --> 00:03:19,270
كم عددهم؟

32
00:03:19,270 --> 00:03:23,510
أربعة وعشرون. لم يبقَ إلّا مُقاتل واحد

33
00:03:23,910 --> 00:03:25,810
أحسنتِ صنعاً يا تشيبا سانا

34
00:03:25,810 --> 00:03:29,010
لهذا السّبب هي خياري الأوّل كعروسة لي

35
00:03:29,010 --> 00:03:33,270
الكثير من الأرواح الظّلاميّة انجذبتْ نحو قوّتها

36
00:03:34,240 --> 00:03:39,360
سيكون جمع ما يكفي من طاقة في المهرجان
لتنصيب بوّابات عوالم سهلاً

37
00:03:41,370 --> 00:03:48,030
حالما أؤدّي، سيتجمّع حتّى مزيد من الأرواح
الهائمة المُتعطّشة للفنّ

38
00:03:50,970 --> 00:03:52,610
كلّ شيء يسير بسلاسة

39
00:03:55,820 --> 00:03:59,090
إنّهم يخدمونني عمليّاً

40
00:03:59,090 --> 00:04:02,040
لن أدع مُجرّد قطعة ورق تُقيّدني

41
00:04:02,040 --> 00:04:04,530
إلى أين ستأخذ الأرواح المُتجمِّعة؟

42
00:04:05,640 --> 00:04:09,100
نصّبنا أداة تخزين خاصّة تحت الأرض

43
00:04:09,340 --> 00:04:11,260
ما زالت تحتوي على كثير من المساحات

44
00:04:12,330 --> 00:04:14,060
سوف تُغنّين، أليس كذلك؟

45
00:04:14,770 --> 00:04:16,840
...شكراً لك

46
00:04:22,400 --> 00:04:24,960
فاتَني ذلك

47
00:04:25,390 --> 00:04:29,260
ينبغي أن تُجهّزي نفسكِ. عرض السّيف قد انتهى

48
00:04:29,260 --> 00:04:30,480
حـ-حسناً

49
00:04:30,480 --> 00:04:32,790
مهلاً. لا أستطيع الانتظار

50
00:04:32,790 --> 00:04:36,880
سيريا، سأغنّي أوّلاً. ابقي مكانكِ

51
00:04:36,880 --> 00:04:39,340
ماذا؟ لكن لا يمكنك

52
00:04:39,340 --> 00:04:41,180
ماذا؟ لا يمكنني؟

53
00:04:41,180 --> 00:04:47,670
أعني بأنّه سيكون من الأسهل للجمهور
أن يسمعك تُغنّي إذا أدّيتُ أوّلاً

54
00:04:48,750 --> 00:04:50,080
لا تقلقي

55
00:04:50,080 --> 00:04:53,380
لن أهدر الدّروسَ الّتي تعلّمتُها منكِ

56
00:04:53,920 --> 00:04:55,350
حـ-حسناً

57
00:04:55,680 --> 00:04:59,020
لن نتمكّن من سماع سيريا تُغنّي؟ خسارة

58
00:04:59,390 --> 00:05:00,730
تفضّل من هنا يا نيرو-ساما

59
00:05:00,730 --> 00:05:01,440
أنا قادم

60
00:05:05,550 --> 00:05:08,050
لن يدع سيريا تُغنّي؟

61
00:05:08,890 --> 00:05:12,190
هذا سيّئ. يُفترَض بنا أن نلتقي
في غرفة الاستراحة

62
00:05:40,310 --> 00:05:42,080
ما هذه الأُغنية؟

63
00:05:42,080 --> 00:05:44,020
إنّها ليست ما تمرنّا عليه إطلاقاً

64
00:05:44,020 --> 00:05:46,320
هذه أغنية أصليّة له

65
00:05:46,930 --> 00:05:48,320
الأرواح الظّلاميّة تهرب؟

66
00:05:48,320 --> 00:05:50,320
كم هذا فظيع. هذه ليست موسيقى

67
00:05:50,560 --> 00:05:52,760
!لن ندعها تهرب

68
00:05:58,380 --> 00:06:02,090
سيتّي، اكبحي وحش الرّوح الظّلاميّة
!هذا وضعيه في الأداة

69
00:06:02,090 --> 00:06:03,500
عُلِم

70
00:06:03,500 --> 00:06:04,800
كايدي، انتظري هنا

71
00:06:04,800 --> 00:06:07,180
بقيّتنا سنُدمّرها ونُوجّهها نحو الأداة

72
00:06:07,850 --> 00:06:09,050
تعالي معي

73
00:06:09,370 --> 00:06:10,120
هيّا

74
00:06:10,830 --> 00:06:11,390
حسناً

75
00:06:12,140 --> 00:06:14,050
لنتفقّد الأداة أوّلاً

76
00:06:28,100 --> 00:06:29,320
دُس عليه

77
00:06:33,730 --> 00:06:35,360
!قناة الرُّوح

78
00:06:41,800 --> 00:06:43,760
سأصرف انتباه نيكولا

79
00:06:43,760 --> 00:06:45,470
أحضري سيريا في هذه الأثناء

80
00:06:45,470 --> 00:06:48,050
لكن قوّتكِ كبيرة زيادة عن اللّزوم

81
00:06:48,370 --> 00:06:49,660
أستطيع إخفاء وجودي

82
00:06:51,260 --> 00:06:53,220
لا عجب في أنّكِ أعزّ صديقة لسيريا

83
00:06:53,220 --> 00:06:53,930
ماذا؟

84
00:06:54,250 --> 00:06:58,890
أخبرَتْني عن صديقتها الأعزّ الرّائعة والحسناء

85
00:07:00,130 --> 00:07:01,860
أنتِ كايدي، أليس كذلك؟

86
00:07:02,360 --> 00:07:05,310
أجل. سيريا-تشان قالت ذلك؟

87
00:07:05,860 --> 00:07:07,860
نكاد نصل. كوني حذرة

88
00:07:07,860 --> 00:07:09,570
أتخونيننا؟

89
00:07:12,080 --> 00:07:12,990
سيري-تشان

90
00:07:13,860 --> 00:07:14,910
كاي-تشان

91
00:07:16,090 --> 00:07:19,910
نيكولا تيسلا، هلّا سلّمت سيريا؟

92
00:07:20,340 --> 00:07:22,820
أوّلاً، أجيبي عن سؤالي

93
00:07:22,820 --> 00:07:25,790
الأشخاص صلبو الإرادة مُزعجون دوماً

94
00:07:26,130 --> 00:07:27,050
أيّ سؤال؟

95
00:07:29,210 --> 00:07:34,470
صحيح. انعتني بالخائنة إذا أردت

96
00:07:34,800 --> 00:07:36,180
هكذا إذاً

97
00:07:38,790 --> 00:07:39,460
ماذا؟

98
00:07:39,800 --> 00:07:41,640
دعيني أنضمّ لكِ إذاً

99
00:07:42,310 --> 00:07:46,290
لا أستطيع تحمّل رؤية العالم
يمتلئ بهذا الصّوت

100
00:07:47,320 --> 00:07:49,780
أريد سماع غناء سيريا

101
00:07:49,780 --> 00:07:50,900
نيكولا

102
00:07:50,900 --> 00:07:53,620
أشعر بأنّنا نستطيع الوثوق به

103
00:07:53,620 --> 00:07:54,990
إذاً ساعدنا على الهرب

104
00:07:55,340 --> 00:07:56,240
استخدمنَ هذه

105
00:07:56,610 --> 00:07:57,520
ما هذه؟

106
00:07:57,520 --> 00:07:59,150
بوّابة عالَم

107
00:07:59,150 --> 00:08:01,530
ستنقلنا مُباشرة إلى عالم البشر

108
00:08:02,050 --> 00:08:03,750
يمكننا تحديد إحداثيّاتنا الخاصّة

109
00:08:04,210 --> 00:08:05,570
متى صنعت هذه؟

110
00:08:05,910 --> 00:08:07,680
أنا الوحيد الّذي يعلم بأمر هذه

111
00:08:07,680 --> 00:08:11,590
الجميع لديهم أسرار

112
00:08:11,910 --> 00:08:15,030
معك حقّ. نحن في نفس المركب

113
00:08:15,990 --> 00:08:18,240
حاليّاً، ادخلوا إلى هنا

114
00:08:18,240 --> 00:08:20,790
لا نريد أن تتحوّلوا إلى أرواح شرّيرة هناك

115
00:08:20,790 --> 00:08:21,810
أنتِ أيضاً يا سانا-سان

116
00:08:21,810 --> 00:08:25,040
لا يمكننا ضمان ذلك من دون عواطف قويّة

117
00:08:25,040 --> 00:08:25,820
أجل

118
00:08:26,490 --> 00:08:27,770
ماذا عن سيتّي-سان والآخرين؟

119
00:08:28,060 --> 00:08:30,260
هدفنا هو إنقاذكِ

120
00:08:30,260 --> 00:08:33,680
إعطاء الأولويّة لذلك سيُسهّل عليهم التصرُّف

121
00:08:33,680 --> 00:08:34,520
...لكن

122
00:08:34,920 --> 00:08:38,110
ببعض الطّرُق، السّفر إلى هنا
من عالم البشر سهل

123
00:08:38,110 --> 00:08:40,370
ينبغي أن نستعدّ للمُغادرة باكراً

124
00:08:40,370 --> 00:08:42,500
...هكذا إذاً. في هذه الحالة

125
00:08:43,080 --> 00:08:45,390
سأنشر بوّابةَ العالم

126
00:08:46,900 --> 00:08:47,790
افعليها

127
00:08:48,060 --> 00:08:48,700
حسناً

128
00:08:50,120 --> 00:08:51,790
!يا مُتعاقد الحديد

129
00:08:51,790 --> 00:08:54,810
!اربط سانا تشيبا ونيكولا تيسلا بي

130
00:08:55,150 --> 00:08:57,530
!دع القوّة الّتي هي الثّمن تلتهمني

131
00:08:59,010 --> 00:08:59,850
كاي-تشان؟

132
00:09:00,180 --> 00:09:01,250
أنا بخير

133
00:09:01,250 --> 00:09:02,680
!امتصاص الرُّوح

134
00:09:09,260 --> 00:09:10,360
مُذهل

135
00:09:11,510 --> 00:09:12,480
أنتِ أوّلاً

136
00:09:12,760 --> 00:09:13,460
حسناً

137
00:09:27,110 --> 00:09:30,240
لا بُدّ أنّه جمع حتّى مزيداً
من الأرواح الظّلاميّة

138
00:09:41,720 --> 00:09:45,300
جميعهم في الأداة من الآن؟

139
00:09:46,540 --> 00:09:50,190
أدّيتُ دوري، لذا سأُغادر الآن

140
00:09:51,620 --> 00:09:55,530
أحسنتِ صنعاً. والآن يمكن
اكتمال بوّابات العالم

141
00:09:57,030 --> 00:09:57,990
إلى اللّقاء

142
00:10:02,940 --> 00:10:07,750
!خنتُماني يا تشيبا سانا ونيكولا تيسلا

143
00:10:07,750 --> 00:10:09,930
لم ننتهِ بعد

144
00:10:10,670 --> 00:10:12,540
!هل تريد أن تموت أيُّها الرّاهب؟

145
00:10:16,920 --> 00:10:20,430
أخبرتُك أن تفعل ما يحلو لك حالما أستعيدها

146
00:10:23,850 --> 00:10:26,650
الحرّيّة الّتي منحتُك إيّاها جعلَتْك تغترّ

147
00:10:26,650 --> 00:10:29,650
أعدهم حالاً، وسأُغفر لك

148
00:10:29,920 --> 00:10:33,230
مُحال. إنّهم ليسوا مُلكك

149
00:10:34,400 --> 00:10:37,490
!سيتّي

150
00:10:37,490 --> 00:10:38,620
!الدّرع الرُّوحيّ

151
00:10:39,450 --> 00:10:41,160
!موتوا

152
00:10:44,830 --> 00:10:46,390
!مهلاً

153
00:10:50,150 --> 00:10:51,310
أيّها الحمقى التّافهون

154
00:10:51,630 --> 00:10:54,130
لكن ما زلتُ أشعر بقوّة روحيّة

155
00:10:54,350 --> 00:10:55,150
ماذا؟

156
00:10:55,610 --> 00:10:57,900
كنّا لنموت فوراً لولا هذا

157
00:10:58,540 --> 00:11:00,090
ماذا سنفعل الآن؟

158
00:11:00,330 --> 00:11:01,550
هل أنت بخير؟

159
00:11:03,300 --> 00:11:04,510
تعالوا إليّ

160
00:11:04,510 --> 00:11:06,160
سأنصب حاجزاً

161
00:11:06,160 --> 00:11:07,470
عُلِم

162
00:11:07,750 --> 00:11:09,120
ختم الحصن

163
00:11:11,170 --> 00:11:14,910
تبّاً لهم. إنّهم يهدرون وقتي بإطالة حياتهم

164
00:11:14,910 --> 00:11:16,820
هل أقتلهم؟

165
00:11:16,820 --> 00:11:21,420
لا يا غاودي، أحضر الصّعاليك لي

166
00:11:21,420 --> 00:11:23,280
اقتل نيكولا حالاً

167
00:11:23,990 --> 00:11:24,990
أمرك

168
00:11:29,710 --> 00:11:33,920
.ستنفد طاقته في نهاية المطاف
حالما يخرج، سأقتله

169
00:11:33,920 --> 00:11:35,470
ماذا يجدر بنا أن نفعل؟

170
00:11:35,470 --> 00:11:37,640
لا أشعر بسيريا هنا

171
00:11:38,040 --> 00:11:40,130
لا بُدّ أنّها هربتْ إلى عالم البشر

172
00:11:40,130 --> 00:11:41,470
هل كان رايكاكو؟

173
00:11:41,470 --> 00:11:42,380
من يدري؟

174
00:11:42,780 --> 00:11:47,180
،حتّى لو تشاركنا قوّتنا معك
أليس نيرو على حقّ؟

175
00:11:47,180 --> 00:11:49,030
إنّها مسألة وقت

176
00:11:51,060 --> 00:11:52,350
سنرى ذلك

177
00:12:01,500 --> 00:12:03,160
!أخبرتُك بذلك

178
00:12:04,380 --> 00:12:05,870
هل انتهى الأمر بالفعل؟

179
00:12:25,570 --> 00:12:26,500
ريكو

180
00:12:29,210 --> 00:12:30,690
آسفة لإثارة قلقكم

181
00:12:40,350 --> 00:12:42,860
لا تقلقوا. أنا صاحية

182
00:12:44,080 --> 00:12:46,730
أيّها الرّاهب، بدِّد الحاجز وانتقل آنيّاً

183
00:12:47,060 --> 00:12:48,020
...لكن

184
00:12:50,860 --> 00:12:53,500
لا توجد هالةٌ روحيّة في الهواء

185
00:12:53,500 --> 00:12:55,750
حسناً، كانت تلك قدرة غريبة

186
00:12:55,750 --> 00:12:58,460
!لحظة يا ريكو-ني! لديك وشوم

187
00:12:59,710 --> 00:13:01,420
سأُخبرك بالأمر لاحقاً

188
00:13:02,270 --> 00:13:03,150
أيُعقَل ذلك؟

189
00:13:04,420 --> 00:13:08,350
أجل. انفجارات نيرو لا تقع فوراً

190
00:13:08,780 --> 00:13:12,410
إنّها تتنقّل عبر الهالة الرُّوحيّة في الهواء

191
00:13:12,880 --> 00:13:14,850
لم أكن أدري

192
00:13:15,750 --> 00:13:18,240
رأيتُ قُدراته أكثر من أيّ شخص آخر

193
00:13:18,570 --> 00:13:20,770
أُرسِلتُ مِراراً لمُقاتلته

194
00:13:22,350 --> 00:13:23,370
هذا صحيح

195
00:13:25,000 --> 00:13:25,780
أنتم تستهينون بي

196
00:13:26,010 --> 00:13:27,860
سأضربكم بنفسي فحسب

197
00:13:28,860 --> 00:13:30,660
الأمر ليس بتلك السّهولة

198
00:13:30,660 --> 00:13:33,260
ماذا يجدر بنا أن نفعل؟ إلى أين
ينبغي أن أذهب؟

199
00:13:33,260 --> 00:13:35,910
ويليام تيل، مُدّني بقوّتك

200
00:13:41,420 --> 00:13:44,750
لا أستطيع الوصول إليكم، لكن
ما زال بمقدوري الاقتراب أكثر

201
00:13:46,380 --> 00:13:48,090
كايدي، أين سيريا؟

202
00:13:48,560 --> 00:13:50,220
أرسلتُها إلى عالم البشر

203
00:13:50,220 --> 00:13:52,080
سنتولّى هذا

204
00:13:52,080 --> 00:13:53,850
كفى مُماطلة وانتقل آنيّاً

205
00:13:54,120 --> 00:13:55,590
شكراً

206
00:13:55,960 --> 00:13:59,100
سأحمي الرّاهب. نعتمد عليكم

207
00:13:59,100 --> 00:14:00,210
عُلِم

208
00:14:03,020 --> 00:14:04,780
سأقتلها أوّلاً

209
00:14:05,820 --> 00:14:07,030
!حمقى

210
00:14:07,030 --> 00:14:08,740
يمكنه قذفها؟

211
00:14:08,740 --> 00:14:09,640
!لا

212
00:14:10,690 --> 00:14:12,410
!لن يفلح هذا

213
00:14:16,290 --> 00:14:17,170
غود

214
00:14:17,170 --> 00:14:18,100
!ماذا؟

215
00:14:20,610 --> 00:14:21,840
سأُشفيك

216
00:14:22,960 --> 00:14:24,970
ماذا؟ هل اقتربنا؟

217
00:14:37,130 --> 00:14:39,110
لن نضطرّ للهرب بعد الآن

218
00:14:43,090 --> 00:14:48,990
"!أيّ فنانٍ يفقده العالم فيّ"

219
00:14:54,680 --> 00:14:55,970
هل استسلم؟

220
00:14:55,970 --> 00:14:57,330
أهذا كلّ شيء؟

221
00:14:57,330 --> 00:14:58,580
ما هذا؟

222
00:14:58,580 --> 00:15:03,700
!أغريبّينا

223
00:15:04,660 --> 00:15:06,370
ماذا؟ من؟

224
00:15:14,320 --> 00:15:17,430
حسناً، هذا غير مُتوقَّع

225
00:15:17,780 --> 00:15:19,310
هل أنتم بخير؟

226
00:15:19,310 --> 00:15:21,490
أجل. هذا ليس بالأمر الجلل

227
00:15:22,560 --> 00:15:25,670
ذلك الضّخم قويّ جدّاً

228
00:15:25,670 --> 00:15:26,730
تراجعوا

229
00:15:26,960 --> 00:15:27,640
...لكن

230
00:15:27,640 --> 00:15:28,570
ماذا؟

231
00:15:31,010 --> 00:15:31,820
غود

232
00:15:35,110 --> 00:15:37,910
هذا مُثير للشّفقة يا نيرو

233
00:15:45,410 --> 00:15:46,260
!هذا سيّئ

234
00:15:53,150 --> 00:15:55,760
لا أعرف من تكون، لكن اقتربنا كثيراً

235
00:15:55,760 --> 00:15:57,990
أجل، أعلم

236
00:16:02,910 --> 00:16:03,820
غود

237
00:16:08,440 --> 00:16:10,240
بسرعة أيُّها الرّاهب

238
00:16:11,960 --> 00:16:14,200
لا أملك خياراً

239
00:16:14,530 --> 00:16:18,050
،لا أعرف ما الّذي يحاولون فعله

240
00:16:18,050 --> 00:16:21,150
لكن أتوا إلى عالم الطّيف لفعل ذلك

241
00:16:21,530 --> 00:16:23,870
لديهم شيء يجب عليهم فعله

242
00:16:24,390 --> 00:16:30,550
إن سألتني، أقول لك بأنّ
...حلمهم أعظم من فنّك

243
00:16:30,860 --> 00:16:36,390
!ورفضي للتخلّي عن عالم الطّيف

244
00:16:37,550 --> 00:16:41,270
!أكاري، هذا لكِ الآن

245
00:16:41,820 --> 00:16:43,000
مانبي؟

246
00:16:47,690 --> 00:16:48,900
ها نحن أولاء

247
00:16:58,110 --> 00:17:04,790
!لم أعرف يوماً معنى الاستسلام

248
00:17:06,200 --> 00:17:07,000
!أنت

249
00:17:20,760 --> 00:17:23,770
!مانبي

250
00:17:34,380 --> 00:17:35,740
أين مانبي؟

251
00:17:47,230 --> 00:17:49,040
...مانبي

252
00:17:58,080 --> 00:17:59,090
مستحيل

253
00:18:03,230 --> 00:18:04,200
لا

254
00:18:06,830 --> 00:18:08,850
أيّها الضُّعفاء البائسون

255
00:18:08,850 --> 00:18:09,940
أيُعقَل ذلك؟

256
00:18:10,460 --> 00:18:13,480
ماذا يُفترض بنا أن نفعل؟

257
00:18:14,270 --> 00:18:15,770
الدّرع الرّوحيّ

258
00:18:18,160 --> 00:18:19,280
الرّاهب؟

259
00:18:19,970 --> 00:18:22,780
سنعود على قيد الحياة

260
00:18:22,780 --> 00:18:25,500
لا أعتقد ذلك

261
00:18:34,500 --> 00:18:38,570
أيّها الرّاهب. أحضر سيريا لي

262
00:18:38,570 --> 00:18:41,430
سأحتفظ بهم رهينة إلى ذلك الحين

263
00:18:43,420 --> 00:18:47,020
أيُّها الرّاهب، ليس عليك القيام بذلك

264
00:18:47,020 --> 00:18:49,480
!اصمتي أيّتها الخنزيرة

265
00:18:52,740 --> 00:18:54,520
...ريكو

266
00:18:58,720 --> 00:18:59,740
روي

267
00:19:00,850 --> 00:19:01,840
سأُطلق عليه

268
00:19:03,830 --> 00:19:05,700
هل أنتِ مُتلهّفة إلى هذا الحدّ للموت؟

269
00:19:12,130 --> 00:19:14,490
بسرعة يا سيتّي

270
00:19:14,490 --> 00:19:17,270
وعدتَ أن تُساعدني

271
00:19:17,270 --> 00:19:21,840
سأملأ هذا العالم بفنّي

272
00:19:25,430 --> 00:19:27,880
ما خطبك؟

273
00:19:29,430 --> 00:19:32,860
كُفّ عن فرض فنّك علينا

274
00:19:33,490 --> 00:19:35,850
لماذا تفعل كلّ هذا الهُراء؟

275
00:19:36,560 --> 00:19:39,000
إن كان هذا هدفك، فدمِّر ميوكس أوّلاً إذاً

276
00:19:39,490 --> 00:19:40,560
ماذا؟

277
00:19:42,880 --> 00:19:45,770
مانبي، سأستعير قوّتك

278
00:19:45,770 --> 00:19:48,440
أكره الاعتراف بذلك، لكن
لا أستطيع فعلها بمُفردي

279
00:20:00,420 --> 00:20:02,630
!تعالي إليّ أيّتها الطّفلة الشّقيّة

280
00:20:02,630 --> 00:20:04,840
!فلتمُت أيّها اللّعين

281
00:20:16,110 --> 00:20:17,080
!ماذا؟

282
00:20:17,080 --> 00:20:18,540
...في هذه الحالة

283
00:20:30,750 --> 00:20:31,720
...أكاري

284
00:20:33,500 --> 00:20:34,430
مُذهل

285
00:21:02,530 --> 00:21:05,380
حسناً، انتهينا هنا. هيّا بنا

286
00:21:05,380 --> 00:21:07,000
أين سيري-تشان؟

287
00:21:07,740 --> 00:21:09,240
يجب علينا إيجادها

288
00:21:09,610 --> 00:21:10,560
معكِ حقّ

289
00:21:10,940 --> 00:21:12,330
سأجهّز الحمّام

290
00:21:14,140 --> 00:21:15,780
هذه غلطتك

291
00:21:16,570 --> 00:21:18,480
...لو كنتُ أحمل إيبوكيمارو

292
00:21:18,480 --> 00:21:20,880
أشكّ في ذلك

293
00:21:20,880 --> 00:21:23,950
لم أرَ انهياراً بهذا السّوء من قبل

294
00:21:23,950 --> 00:21:27,510
وإلى أين يذهبون دون تفكير؟

295
00:21:28,140 --> 00:21:30,710
من أنت بالضّبط على أيّ حال؟

296
00:21:30,710 --> 00:21:31,720
صحيح

297
00:21:32,040 --> 00:21:35,440
أنا مانبي إتشينوميا، المُقامر

298
00:21:35,770 --> 00:21:36,770
مانبي؟

299
00:21:36,770 --> 00:21:39,500
ماذا تفعل في عالم الطّيف؟

300
00:21:39,500 --> 00:21:41,480
هل يوجد قُرى أُخرى كهذه؟

301
00:21:41,480 --> 00:21:44,600
يوجد، لكنّها ليست بالكثيرة

302
00:21:44,600 --> 00:21:46,700
إنّهم موتى، لكن لدينا أرواح

303
00:21:47,340 --> 00:21:49,730
ألا تُفضّلين ألّا تفقدي صوابكِ؟

304
00:21:49,730 --> 00:21:53,410
ماذا؟ لا أُصدّق بأنّه يوجد أشباح مثلك

305
00:21:54,150 --> 00:21:57,460
ألا تريدين أن تكوني صالحة قدر المُستطاع؟