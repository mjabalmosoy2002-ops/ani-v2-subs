1
00:00:05,460 --> 00:00:08,000
لم أتوقّع أبداً أن نقع في قبضة نيرو ثانية

2
00:00:08,000 --> 00:00:10,860
لِمَ لا تطلب مُساعدتنا؟

3
00:00:11,120 --> 00:00:15,700
لعلّ سيريا تتحرّى حول الرّابط
بين نيرو وميوكس

4
00:00:16,140 --> 00:00:18,490
لا ينبغي أن يكون هناك أيّ رابط

5
00:00:18,490 --> 00:00:21,290
إذاً يجب علينا تحرير سيريا بالقوّة إن لزم الأمر

6
00:00:21,290 --> 00:00:24,460
إنّه قويّ. ينبغي أن نتجنّب المعركة

7
00:00:24,460 --> 00:00:26,010
هل هو قويّ إلى هذا الحدّ؟

8
00:00:26,010 --> 00:00:26,710
أجل

9
00:00:27,470 --> 00:00:30,690
من الأفضل أن نبحث عن فُرصة للهرب

10
00:00:33,070 --> 00:00:36,430
سوف نُراقبها ونظهر في اللّحظة
الّتي يقع فيها أي مكروه

11
00:00:37,100 --> 00:00:38,250
معك حقّ

12
00:00:40,130 --> 00:00:42,730
ملابسكِ قذرة

13
00:00:43,220 --> 00:00:45,020
ارتدي هذا الفُستان

14
00:00:45,020 --> 00:00:47,650
ألا تُفضّلين أن تبدي جميلة؟

15
00:00:50,630 --> 00:00:52,530
مفتونة لدرجة العجز عن الكلام؟

16
00:00:58,780 --> 00:01:00,430
هل طلبَتِ المُساعدة؟

17
00:01:01,930 --> 00:01:03,270
...هذا الفُستان

18
00:01:07,620 --> 00:01:08,380
ما الّذي يجري؟

19
00:01:08,380 --> 00:01:10,580
معقول؟ هل نحن...؟

20
00:01:15,760 --> 00:01:18,900
تمّ ختمنا في الدّاخل

21
00:01:19,630 --> 00:01:20,700
...سيريا

22
00:03:17,430 --> 00:03:20,860
كما توقّعت، إنّها جديرة بأن
تكون فصلي الافتتاحيّ

23
00:03:20,860 --> 00:03:22,300
هل تُعجبك؟

24
00:03:22,300 --> 00:03:25,490
لكن هذا لا يكفي

25
00:03:25,490 --> 00:03:29,230
أما من طريقة لجعل صوتها مُلكي؟

26
00:03:29,460 --> 00:03:34,940
لن تسنح لنا فُرصة أُخرى لكسب
صوت عذب كهذا؟

27
00:03:34,940 --> 00:03:39,650
لكن لا جدوى من مُجرّد امتلاك حِبال صوتيّة

28
00:03:39,650 --> 00:03:43,160
إذاً الخيار الوحيد هو جعلها كُلّها مُلكي

29
00:03:43,430 --> 00:03:46,860
لكن لديها جسد من لحم ودم

30
00:03:46,860 --> 00:03:48,490
هذا يُلائمني

31
00:03:48,490 --> 00:03:51,780
سأدعها تُرشدني عبر العالم البشريّ
عندما أحصل على هيئة جسديّة

32
00:03:52,500 --> 00:03:54,420
ألن تتفسّخ هي قبل ذلك الحين؟

33
00:03:55,220 --> 00:03:59,130
طوّرتُ تقنيّةً للحِفاظ على جسدٍ مادّي
في عالم الطّيف

34
00:03:59,660 --> 00:04:02,230
بفضل سيريا، تمكّنتُ من التحقُّق
من نجاح ذلك

35
00:04:02,550 --> 00:04:04,430
إذاً لا نملك خياراً

36
00:04:04,430 --> 00:04:08,850
لكن يجب أن نجمع الكثير من القوّة الرّوحيّة
للمُجازفة ودخول عالم البشر

37
00:04:08,850 --> 00:04:11,610
هذا ما حضّرنا أنفسنا لأجله

38
00:04:11,610 --> 00:04:14,440
المهرجان سيجذب جمهوراً بلا شكّ

39
00:04:14,440 --> 00:04:18,400
ماذا؟ ظننتُ أنّ نيّتك هي تسلية نفسك فقط

40
00:04:19,670 --> 00:04:21,160
هذا هو هدفي الرّئيسيّ

41
00:04:21,160 --> 00:04:25,490
تروقينني يا سانا. أنتِ لا تخشيني

42
00:04:27,510 --> 00:04:28,840
أخطأتُ ثانية

43
00:04:29,370 --> 00:04:32,280
لا أريد أن أصبح زوجتك

44
00:04:33,700 --> 00:04:36,710
أنتِ خياري الأوّل لتكوني عروستي

45
00:04:37,930 --> 00:04:40,700
نيرو، تنوي اكتساب جسد مادّي، أليس كذلك؟

46
00:04:40,700 --> 00:04:43,420
ألن تكون تلك المُغنّية مثاليّة؟

47
00:04:43,420 --> 00:04:47,140
رُبّما. إنّها مُغنّية جيّدة

48
00:04:47,360 --> 00:04:50,980
لكن هل ستكون غير خائفة منّي فعلاً مثلكِ؟

49
00:04:50,980 --> 00:04:54,680
أنا ذات وجهين بخِلاف ما تعتقد، وأخشاك أيضاً

50
00:04:54,680 --> 00:04:55,390
ماذا؟

51
00:04:59,670 --> 00:05:02,190
كايدي، استيقظي رجاء

52
00:05:03,110 --> 00:05:03,860
كايدي

53
00:05:06,190 --> 00:05:08,260
تمّ إنقاذي؟

54
00:05:09,300 --> 00:05:10,160
يويتشي

55
00:05:10,650 --> 00:05:12,870
يسرّني أنّك بخير

56
00:05:13,110 --> 00:05:17,960
وكذلك أنا، لكن حان الوقت لفُراقنا

57
00:05:18,280 --> 00:05:18,940
ماذا؟

58
00:05:18,940 --> 00:05:21,670
مُضيفي يقترب من بلوغ حدوده

59
00:05:22,700 --> 00:05:24,220
إذاً تعال وادخلني

60
00:05:24,580 --> 00:05:26,900
أنا متأكّدة بأنّني أستطيع تحمُّل ذلك مُؤقّتاً

61
00:05:26,900 --> 00:05:29,510
لا أستطيع. إذا حدث شيء، فسيكون
الأوان قد فات

62
00:05:29,510 --> 00:05:30,280
...لكن

63
00:05:33,900 --> 00:05:36,270
...الرّايكاكو الخاص بأبي

64
00:05:37,230 --> 00:05:39,730
أين الآخرون؟ أين سيري-تشان؟

65
00:05:40,190 --> 00:05:42,060
سحبنَ أساورهن

66
00:05:42,500 --> 00:05:44,690
مثلكِ، ستتمّ إعادتهم في نهاية المطاف

67
00:05:44,690 --> 00:05:46,530
سوف أنقذهم

68
00:05:47,290 --> 00:05:48,220
...لكن

69
00:05:48,220 --> 00:05:48,950
كايدي

70
00:05:49,410 --> 00:05:51,910
لستِ قويّة بما يكفي

71
00:05:52,390 --> 00:05:56,620
ماذا ستفعلين إذا واجهتِ شبحاً عظيماً آخر؟

72
00:05:56,620 --> 00:05:59,770
...لكن لا يمكننا أن نتحمّل

73
00:06:01,630 --> 00:06:02,670
ما الأمر؟

74
00:06:04,050 --> 00:06:08,050
لا شيء. تَرك الرّايكاكو الخاصّ بأبي
يتولّون ذلك هو الخيار الحكيم

75
00:06:08,050 --> 00:06:08,910
كايدي؟

76
00:06:09,750 --> 00:06:10,470
آكاري

77
00:06:10,470 --> 00:06:11,470
روي

78
00:06:11,470 --> 00:06:12,510
وريكو-سان

79
00:06:13,410 --> 00:06:15,470
جميعهن أقوى منّي

80
00:06:15,850 --> 00:06:17,660
لا سيّما سيري-تشان

81
00:06:18,050 --> 00:06:19,990
سأنتظر عودتهن بهدوء

82
00:06:21,310 --> 00:06:23,130
هل أنتِ...؟

83
00:06:24,530 --> 00:06:26,010
لا يهمّ

84
00:06:26,010 --> 00:06:32,380
الآن بعد سقوط تيرا، ستتحكّم عائلة
سايونجي بوُسطاء هذه الدّولة الرّوحيّين

85
00:06:32,920 --> 00:06:34,550
تيرا سقطت؟

86
00:06:34,550 --> 00:06:40,150
المُقاومة المُعادية للحكومة اليابانيّة
التّيليجيست هاجمة المقرّ

87
00:06:40,630 --> 00:06:42,870
لهذا انهار النّظام؟

88
00:06:43,220 --> 00:06:48,590
،أردتُ استدعاءكِ قبل حدوث هذا

89
00:06:48,990 --> 00:06:52,210
،لكن الخطّ الرُّوحيّ قد قُطِع
ولم تبلغكِ تعويذاتي

90
00:06:52,210 --> 00:06:53,310
أنا آسف

91
00:06:53,310 --> 00:06:54,140
لا عليك

92
00:06:54,470 --> 00:06:57,810
في نهاية المطاف، تمّ إيقاف تدمير ميوكس

93
00:06:57,810 --> 00:07:00,610
هل هناك علاقة عفويّة بين

94
00:07:00,950 --> 00:07:04,290
التمرُّد المُعادي لتيرا وهدفنا الّذي
هو تدمير ميوكس؟

95
00:07:04,600 --> 00:07:07,690
لن يكون من الغريب وجود مُنظّمة ضخمة

96
00:07:07,690 --> 00:07:09,110
تريد حماية ميوكس

97
00:07:09,110 --> 00:07:15,660
من المُمكن أن تكون المُنظّمة هي من حرّض
أطفال تيرا، التّيليجيست

98
00:07:15,660 --> 00:07:19,410
ظننتُ بالخطأ بأنّك أنت من كان
يفعل ذلك يا أبي

99
00:07:20,330 --> 00:07:23,280
ظننتُك أردت التحكُّم بالوُسطاء الرّوحيّين

100
00:07:23,280 --> 00:07:24,750
مُحال أن يفعل

101
00:07:24,750 --> 00:07:26,010
هذا كلام فارغ

102
00:07:26,010 --> 00:07:28,250
رغم أنّني سأفعل ذلك لو اضطرّ الأمر

103
00:07:29,150 --> 00:07:30,840
سامحني

104
00:07:31,190 --> 00:07:33,050
ثمّة أمر غير طبيعيّ

105
00:07:33,530 --> 00:07:35,390
أتّفق

106
00:07:35,390 --> 00:07:36,820
بخصوص ميوكس؟

107
00:07:37,380 --> 00:07:38,890
سمعتُ غناء

108
00:07:39,140 --> 00:07:42,480
كانت أُغنية مُسالمة جدّاً ومُريحة

109
00:07:42,930 --> 00:07:46,270
لكن أشعر وكأنّ شيئاً قد أُخِذ منّي

110
00:07:46,270 --> 00:07:47,690
أُخِذ منكِ؟

111
00:07:47,970 --> 00:07:53,910
لدى ميوكس تطبيق طُوِّر لإزالة الخبث من الموسيقى

112
00:07:54,470 --> 00:08:00,120
ربّما جزء من مشاعركِ السّلبيّة قد انتُزِعت منكِ

113
00:08:00,120 --> 00:08:03,820
لا أشعر بخوف فيكِ

114
00:08:04,420 --> 00:08:06,170
لديّ مخاوف

115
00:08:06,500 --> 00:08:11,740
لكن التوتُّر الّذي كنتُ أشعر به... قد زال

116
00:08:11,740 --> 00:08:12,950
توتُّر؟

117
00:08:14,010 --> 00:08:17,600
حاولتُ حتّى إخبار سيري-تشان بحقيقتي

118
00:08:17,600 --> 00:08:18,420
ماذا؟

119
00:08:19,170 --> 00:08:22,850
بأنّني كنتُ مسرورة عندما اختارت
سيري-تشان الموت

120
00:08:23,310 --> 00:08:26,770
شعرتُ وكأنّه لا مُشكلة إن أخبرتُها

121
00:08:26,770 --> 00:08:29,860
فهمت. لكن هل أنتِ متأكّدة من هذا؟

122
00:08:29,860 --> 00:08:30,920
ماذا؟

123
00:08:30,920 --> 00:08:33,810
ألا تريدين البقاء مع آيبا سيريا؟

124
00:08:34,170 --> 00:08:34,940
بلى

125
00:08:34,940 --> 00:08:38,690
حتّى لو كان ذلك يؤذيها؟

126
00:08:39,160 --> 00:08:40,080
لا

127
00:08:40,080 --> 00:08:43,290
ألستِ قلقة عليها الآن؟

128
00:08:46,360 --> 00:08:47,630
لا

129
00:08:48,340 --> 00:08:49,800
ما هذا؟

130
00:09:01,990 --> 00:09:03,020
أبي؟

131
00:09:08,850 --> 00:09:10,100
!سايونجي-سان

132
00:09:12,290 --> 00:09:13,150
!اخرج

133
00:09:13,150 --> 00:09:15,030
ماذا تفعل لابنتي؟

134
00:09:15,350 --> 00:09:16,430
...أبي

135
00:09:19,280 --> 00:09:20,670
سايونجي-سان؟

136
00:09:20,670 --> 00:09:24,100
!هذا جنون! من فضلك توقّف يا سايونجي-سان

137
00:09:24,100 --> 00:09:25,620
!اصمت أيّها الرّاهب

138
00:09:26,830 --> 00:09:29,980
!اخرج

139
00:09:32,490 --> 00:09:35,300
ما الأمر؟ ما الّذي يجري؟

140
00:09:35,650 --> 00:09:37,550
الظّلام يتدفّق من كايدي-ساما

141
00:09:37,550 --> 00:09:39,350
الغرفة تصبح حالكة السّواد

142
00:09:44,020 --> 00:09:46,200
!ليس هنا

143
00:09:46,200 --> 00:09:47,160
!ليس في أيّ مكان

144
00:09:47,160 --> 00:09:49,480
!لا مكان لك

145
00:09:49,740 --> 00:09:52,110
!اخرج

146
00:09:55,410 --> 00:09:56,550
فراشة؟

147
00:09:57,330 --> 00:09:58,330
!كايدي

148
00:10:04,350 --> 00:10:07,040
...سايونجي-سان، كايدي-سان

149
00:10:07,610 --> 00:10:09,110
...أبي

150
00:10:09,430 --> 00:10:11,190
أنتِ بأمان الآن

151
00:10:11,190 --> 00:10:13,750
أنا آسف لقساوتي معكِ

152
00:10:15,710 --> 00:10:17,970
لطالما كنتَ كذلك يا أبي

153
00:10:17,970 --> 00:10:20,680
ليس عليك الاعتذار الآن

154
00:10:21,670 --> 00:10:23,460
تأمّلي حالكِ

155
00:10:27,240 --> 00:10:28,270
كايدي

156
00:10:28,270 --> 00:10:29,140
نعم؟

157
00:10:29,390 --> 00:10:31,010
هل أنتِ قلقة عليها؟

158
00:10:32,010 --> 00:10:36,510
أجل. قلقة جدّاً

159
00:10:41,340 --> 00:10:44,280
هكذا إذاً يا كايدي

160
00:10:44,600 --> 00:10:47,000
يجب أن تتعايشي مع قلقكِ

161
00:10:47,000 --> 00:10:50,650
حتّى لو آلمكِ ذلك، هنا تكمن قوّتكِ

162
00:10:52,090 --> 00:10:53,840
حسناً يا أبي

163
00:10:54,200 --> 00:10:56,300
يوتيتسو، أحضر ذلك لنا

164
00:10:56,300 --> 00:10:57,340
أُحضر ماذا؟

165
00:10:58,580 --> 00:11:00,260
لكن ما زال مُجرّد نموذج أوّلي

166
00:11:00,260 --> 00:11:03,530
إنّه السّلاح المُغذّى روحيّاً والأقوى
لدى عائلة سايونجي

167
00:11:03,530 --> 00:11:04,300
...لكن

168
00:11:04,300 --> 00:11:06,600
من فضلك امنحني القوّة

169
00:11:06,950 --> 00:11:10,560
إذا رصدتِ أيّ خلل، فتخلّصي منه فوراً

170
00:11:10,560 --> 00:11:11,520
حاضرة

171
00:11:12,740 --> 00:11:17,480
حسناً. على الأقلّ دعيني أضع أكبر
قدر مُمكن من الحواجز الرُّوحيّة

172
00:11:17,970 --> 00:11:20,500
سأتمكّن من منعه من الخروج عن السّيطرة

173
00:11:21,020 --> 00:11:21,970
شكراً لك

174
00:11:22,500 --> 00:11:24,430
بسرعة لو سمحت

175
00:11:24,430 --> 00:11:26,450
يجب عليّ إنقاذ سيري-تشان

176
00:11:26,840 --> 00:11:31,670
تحتاجين عدّة أيّام لتتعلّمي كيفيّة استخدامه

177
00:11:31,670 --> 00:11:32,620
حسناً

178
00:11:33,380 --> 00:11:35,630
أنا آسف يا يوتيتسو

179
00:11:36,460 --> 00:11:37,840
على ماذا؟

180
00:11:41,610 --> 00:11:44,260
لم أتوقّع أبداً ألّا أكره شخصاً

181
00:11:44,260 --> 00:11:47,720
بعد تعرُّضي لهجوم جسديّ وشفهيّ

182
00:11:48,300 --> 00:11:53,650
سأفعل ما يستطيع فعله راهبٌ
فقط يا سايونجي-سان

183
00:11:59,280 --> 00:12:00,550
لا أستطيع خلعه

184
00:12:01,110 --> 00:12:03,570
كليو والآخرون عالقون بداخلي غالباً

185
00:12:03,910 --> 00:12:05,770
لحظة، كيف أستعمل دورة المياه؟

186
00:12:06,130 --> 00:12:07,780
أبلغيني إذا احتجتِ لذلك

187
00:12:07,780 --> 00:12:10,730
سأزيل بعضاً من أربطتكِ

188
00:12:10,730 --> 00:12:11,790
من أنتِ؟

189
00:12:12,840 --> 00:12:14,500
اسمي تشيبا سانا

190
00:12:14,920 --> 00:12:17,990
سأدعكِ تكسبين ودّ نيرو

191
00:12:19,820 --> 00:12:22,510
أكسب ودّ نيرو؟

192
00:12:23,460 --> 00:12:25,460
لحظة، ماذا؟ تشيبا سانا؟

193
00:12:25,460 --> 00:12:27,340
خطيبة ريوما؟

194
00:12:31,250 --> 00:12:33,700
...أنا آسفة. أنا

195
00:12:33,700 --> 00:12:35,020
ما أدراكِ بذلك؟

196
00:12:35,020 --> 00:12:35,560
ماذا؟

197
00:12:35,850 --> 00:12:39,510
كيف عرفتِ بأمري وأمر ريوما؟

198
00:12:39,510 --> 00:12:40,480
أجيبيني

199
00:12:40,480 --> 00:12:45,000
بالنّسبة لنا، أنتِ شخصيّة تاريخيّة عظيمة

200
00:12:45,400 --> 00:12:48,240
أنا؟ عظيمة؟

201
00:12:48,240 --> 00:12:50,490
أجل. أنتِ مُدهشة

202
00:12:50,490 --> 00:12:51,740
،أنتِ غير مذكورة في كُتُب التّاريخ فحسب

203
00:12:51,740 --> 00:12:54,740
بل في الرّوايات والمُسلسلات التّلفزيونيّة
والأنمي والألعاب كذلك

204
00:12:55,170 --> 00:12:57,410
كُتُب التّاريخ؟

205
00:12:59,350 --> 00:13:01,840
...القصّة الّتي رُويَتْ لنا هي

206
00:13:02,180 --> 00:13:04,500
أنّكِ كنتِ الابنة الثّانية لتشيبا ساداكيتشي

207
00:13:04,500 --> 00:13:06,900
وأتقنتِ فنّ المُبارزة بالسّيف هوكوشين
إيتّو-ريو بالكامل خلال فترة مُراهقتكِ

208
00:13:06,900 --> 00:13:11,350
كان الرّجال يخشون حسناء تشيبا الشّرِسة
وينجذبون إلى جمالكِ في نفس الوقت

209
00:13:11,350 --> 00:13:15,350
،في السّابعة عشر، عندما كنتِ في مثل سنّي
التقيتِ بريوما وخطبتما لاحقاً

210
00:13:15,350 --> 00:13:18,130
لكن انتقل ريوما إلى كيوتو وتزوّج أوريو

211
00:13:18,130 --> 00:13:21,500
أثناء وبعد تلك الفترة، أحببتِ ريوما
—حتّى سمعتِ نبأ وفاته

212
00:13:21,500 --> 00:13:23,960
لا، حتّى بعد ذلك

213
00:13:23,960 --> 00:13:27,290
رغم أنّكِ أحببتِ رجلاً واحداً
،فقط طوال حياتكِ

214
00:13:27,290 --> 00:13:29,580
تزوّجتِ من ياماغوتشي كيكوجيرو، دايميو توتّوري

215
00:13:29,580 --> 00:13:31,140
تطلّقتُما بعد سنوات عديدة

216
00:13:31,140 --> 00:13:34,010
وعملتِ كمُعالِجة بكَي الجلد
قبل وفاتكِ في ميجي 29

217
00:13:34,010 --> 00:13:36,480
دُفِنت بعض رفاتكِ في قبر في كوفو

218
00:13:36,480 --> 00:13:38,330
"ونُحِت عليه "زوجة ساكاموتو ريوما

219
00:13:38,330 --> 00:13:40,380
...وأيضاً

220
00:13:41,010 --> 00:13:42,730
هل أخطأتُ في شيء؟

221
00:13:42,730 --> 00:13:45,080
لم أفهم شيئاً ممّا قلتِه

222
00:13:45,080 --> 00:13:48,670
آسفة. على أيّ حال، أنتِ مشهورة

223
00:13:48,670 --> 00:13:51,570
وأيضاً هناك العديد من النّظريّات
بخصوص الكمّ الواحد

224
00:13:51,570 --> 00:13:54,390
سيكون من الرّائع أن تخبريني بالحقيقة

225
00:13:54,390 --> 00:13:56,600
كمّ؟ تقصدين هذا؟

226
00:13:56,600 --> 00:13:59,270
أجل. هذا هو؟

227
00:13:59,490 --> 00:14:02,640
النظريّة الأولى، أعطاكِ إيّاه ريوما
عندما افترقتُما

228
00:14:02,640 --> 00:14:07,030
الثّانية، كانت هديّة من عائلة تشيبا لريوما

229
00:14:07,030 --> 00:14:08,690
أيُّهما؟

230
00:14:09,670 --> 00:14:13,450
ليتها كانت الأُولى، لكن مع الأسف، إنّها الثّانية

231
00:14:13,450 --> 00:14:18,120
مع الأسف؟ هل هذا يعني بأنّكِ ما زلتِ...؟

232
00:14:20,670 --> 00:14:22,590
أجل. أحبُّ ريوما

233
00:14:23,610 --> 00:14:26,690
صحيح أنّني تزوّجت، لكن فعلتُ
ذلك لحماية نفسي

234
00:14:27,140 --> 00:14:29,750
أنا نادمة على ما فعلتُه لكيكوجيرو

235
00:14:30,650 --> 00:14:32,430
إذاً هذا صحيح أيضاً

236
00:14:32,690 --> 00:14:36,390
لكن لا أنوي الزّواج من أحد آخر

237
00:14:36,390 --> 00:14:40,380
لذا يا سيريا، سوف تحلّين مكاني

238
00:14:42,710 --> 00:14:44,400
أحلّ مكانكِ؟

239
00:14:44,400 --> 00:14:46,650
ماذا تفعلين مع نيرو على أيّ حال؟

240
00:14:46,990 --> 00:14:48,960
هل تعرفين ما الّذي يحاول نيرو فعله؟

241
00:14:48,960 --> 00:14:50,240
لا

242
00:14:50,240 --> 00:14:52,860
غزو كُلّ من عالم الطّيف وعالم البشر

243
00:14:53,250 --> 00:14:57,200
سوف يبني عالماً مليئاً بالفنّ الّذي يتخيّله

244
00:14:57,200 --> 00:14:59,690
لا تبدين مُهتمّة

245
00:14:59,690 --> 00:15:01,210
لستُ كذلك

246
00:15:02,440 --> 00:15:03,490
وأنتِ؟

247
00:15:03,930 --> 00:15:04,830
لا

248
00:15:07,300 --> 00:15:10,340
يجب على نيرو أن يُنصّب بوّابات عوالم

249
00:15:10,340 --> 00:15:12,390
عليه أن يكون قادراً على التنقُّل بحرّيّة

250
00:15:12,390 --> 00:15:15,850
بين عوالم الطّيف والرّوح والبشر

251
00:15:15,850 --> 00:15:19,190
بالإضافة إلى ذلك، يجب أن يكون الأرواح والبشر
قادرين على الحِفاظ على صوابهم

252
00:15:19,190 --> 00:15:23,360
في عالم البشر وأجسادهم في عالم الطّيف

253
00:15:23,360 --> 00:15:25,570
لديه حليف يجري بحثاً على مواد التّجارب تلك

254
00:15:26,140 --> 00:15:27,780
نيكولا تيسلا؟

255
00:15:27,780 --> 00:15:30,820
أجل. استخدمكِ لاختبار بحثه المادّيّ

256
00:15:30,820 --> 00:15:32,710
لا بُدّ أنّه اقترب من إتمامه

257
00:15:33,530 --> 00:15:36,990
خطّطتُ لانتظار اكتمال بوّابات العوالم

258
00:15:37,370 --> 00:15:42,280
لكن يا سيريا، إذا ذهبتُ معكِ، أستطيع
الحِفاظ على عقلي، أليس كذلك؟

259
00:15:42,630 --> 00:15:45,000
ماذا؟ هذا ما أظنّه

260
00:15:45,000 --> 00:15:49,260
أتمنّى أن أرى نهاية العالم الّتي
تخيّلها ريوما في أسرع وقت مُمكن

261
00:15:49,610 --> 00:15:50,630
...نهاية العالم

262
00:15:51,040 --> 00:15:53,630
هلّا أخذتِني معكِ إلى عالم البشر؟

263
00:15:53,970 --> 00:15:55,830
سأُخرجكِ من هنا

264
00:15:56,830 --> 00:16:01,100
سانا-سان، لا أعرف كيف أعود
إلى عالم البشر

265
00:16:01,100 --> 00:16:06,160
،كلّ ما يمكنني فعله هو انتظار سيتّي-سان
صديقي في تيرا، ليأتي ويُنقذني

266
00:16:06,160 --> 00:16:09,870
ذلك الرّاهب؟ قاتلنا معاً بضع مرّات

267
00:16:09,870 --> 00:16:10,550
ماذا؟

268
00:16:11,240 --> 00:16:13,610
كان حلفاً مُؤقّتاً

269
00:16:13,970 --> 00:16:16,300
نعمل معاً فقط عندما نحتاج بعضنا الآخر

270
00:16:16,700 --> 00:16:18,150
...سيتّي-سان

271
00:16:18,150 --> 00:16:19,420
هل أنتِ قلقة عليه؟

272
00:16:19,420 --> 00:16:22,600
أجل. آمل أن يكون الجميع بخير

273
00:16:22,600 --> 00:16:23,550
هكذا إذاً

274
00:16:24,250 --> 00:16:26,190
غناؤكِ يلقى صدى واسعاً

275
00:16:26,510 --> 00:16:30,300
استخدمي موسيقى عزاء الاستحواذ خاصّتكِ
لجمع القوّة بينما تنتظرين الإنقاذ

276
00:16:30,300 --> 00:16:31,960
قوّتي؟

277
00:16:32,290 --> 00:16:36,200
حدّثني نيكولا عن ذلك. أودّ الغناء معكِ لاحقاً

278
00:16:36,200 --> 00:16:39,960
يبدو هذا مُسلّياً. أنا جاهزة في أيّ وقت

279
00:16:41,140 --> 00:16:42,110
حسناً، ينبغي أن أذهب

280
00:16:42,820 --> 00:16:45,770
سأعود للاطمئنان عليكِ

281
00:16:47,670 --> 00:16:49,000
شكراً لكِ

282
00:16:51,940 --> 00:16:54,420
أين الجميع؟

283
00:17:01,540 --> 00:17:04,540
قطعتُ شيئاً عديم القيمة آخر

284
00:17:04,920 --> 00:17:08,340
من الأفضل أن يأتي أولئك الرّهبان
الأوغاد ليأخذوني قريباً

285
00:17:08,870 --> 00:17:12,150
حتّى جسدي المليء بالحيويّة البالغ
أربعة عشر عاماً سوف يذبل

286
00:17:13,450 --> 00:17:14,670
ها أنا ذي

287
00:17:14,670 --> 00:17:18,340
،على الأقلّ، ينبغي أن يفي هذا بالغرض
لكنّني أزداد ضعفاً

288
00:17:18,340 --> 00:17:19,600
أفقد بريقي

289
00:17:19,600 --> 00:17:24,680
!إيبوكيمارو

290
00:17:20,810 --> 00:17:22,020
ماذا؟

291
00:17:22,020 --> 00:17:26,800
إنّه ليس شبحاً عظيماً... صحيح؟

292
00:17:26,800 --> 00:17:28,190
!هذا السّيف

293
00:17:28,190 --> 00:17:30,900
!إنّه لي

294
00:17:30,900 --> 00:17:34,090
من تكون بالضّبط يا عجوز؟ إيغاشيرا؟

295
00:17:34,090 --> 00:17:35,360
ماذا أفعل؟

296
00:17:35,630 --> 00:17:39,800
اسمعي يا آنسة. هذه المنطقة هي مُستوطنتي

297
00:17:39,800 --> 00:17:42,830
لا يمكنكِ فعل ما تشائين هنا

298
00:17:44,670 --> 00:17:46,210
قتلتِهم، أليس كذلك؟

299
00:17:46,210 --> 00:17:46,700
ماذا؟

300
00:17:46,700 --> 00:17:50,750
!هُم! إنّهم خائفون

301
00:17:53,180 --> 00:17:55,170
يبدو أنّه ما كان ينبغي أن أفعل ذلك

302
00:17:55,410 --> 00:17:56,550
آسفة

303
00:17:56,550 --> 00:18:00,040
ألم تكوني مُدرِكة؟

304
00:18:00,040 --> 00:18:02,350
سأعطيكِ مالاً كمصروف

305
00:18:02,870 --> 00:18:05,740
يوجد متجر هناك يُقدّم طعاماً
يستطيع البشر أكله

306
00:18:05,740 --> 00:18:07,760
جسدكِ المادّي يضعف، أليس كذلك؟

307
00:18:07,760 --> 00:18:09,780
تناولي طعاماً لاسترجاع قوّتكِ

308
00:18:09,780 --> 00:18:11,560
ماذا؟ شكراً

309
00:18:12,360 --> 00:18:14,820
!أتعتقدين حقّاً بأنّه يوجد شيء كهذا؟

310
00:18:17,650 --> 00:18:20,340
!ستدفعين ثمن هذا أيّتها السّاذجة اللّعينة

311
00:18:20,340 --> 00:18:22,060
!ما هو لي يبقى لي

312
00:18:22,060 --> 00:18:24,990
!سأسترجع إيبوكيمارو

313
00:18:24,990 --> 00:18:28,160
!تبّاً لك أيّها الوغد اللّعين

314
00:18:30,300 --> 00:18:33,720
أعتقد كان له في الأصل

315
00:18:33,720 --> 00:18:36,140
ليس وكأنّني أعرف ما إن كان يقول الحقيقة

316
00:18:38,050 --> 00:18:40,720
!أجل! خاصّتي طارَتْ لأبعد مسافة

317
00:18:40,720 --> 00:18:42,040
تبّاً

318
00:18:40,950 --> 00:18:42,970
ماذا؟ خاصّتي ابتعدتْ أكثر

319
00:18:43,190 --> 00:18:46,400
لحظة. لم أرمِ خاصّتي بعد

320
00:18:46,400 --> 00:18:47,940
آسف

321
00:18:47,940 --> 00:18:49,700
ها أنا ذا

322
00:18:53,900 --> 00:18:56,540
!أنتِ، لا تُمسكيها

323
00:18:56,540 --> 00:18:58,360
!حسناً! ربحتُ أنا

324
00:19:03,550 --> 00:19:05,490
...لحظة، هذا المكان

325
00:19:09,630 --> 00:19:13,000
كيف ما زلتُم تبدون بهذا الشّكل؟

326
00:19:13,000 --> 00:19:14,770
نبدو مثل ماذا؟

327
00:19:15,720 --> 00:19:18,000
،يتحوّل البعض إلى أرواح شرّيرة

328
00:19:18,000 --> 00:19:20,630
لكن مانبي يُطعمنا كي لا يحدث لنا ذلك

329
00:19:20,630 --> 00:19:22,170
مانبي؟

330
00:19:22,170 --> 00:19:25,660
قال بأنّه توجد هالةٌ روحيّة بيضاء فيه

331
00:19:25,660 --> 00:19:27,390
هكذا إذاً

332
00:19:33,270 --> 00:19:35,060
إنّها أُمّي

333
00:19:35,060 --> 00:19:36,520
إنّها تتّصل بي

334
00:19:36,880 --> 00:19:38,530
وداعاً يا سيّد

335
00:19:38,530 --> 00:19:40,040
وداعاً يا سيّد. أراك لاحقاً

336
00:19:40,490 --> 00:19:45,700
!سيّد؟ لستُ سيّداً

337
00:19:46,270 --> 00:19:47,370
!ادخلوا

338
00:19:49,030 --> 00:19:50,120
ما الّذي يحدث؟

339
00:19:50,120 --> 00:19:52,140
!النّجدة

340
00:19:52,140 --> 00:19:53,740
!لا

341
00:19:52,580 --> 00:19:53,740
!لحظة

342
00:19:57,130 --> 00:19:58,590
!تبّاً

343
00:20:10,600 --> 00:20:12,220
هالة شظيّة الرُّوح

344
00:20:15,810 --> 00:20:19,100
اتركيني واذهبي

345
00:20:19,100 --> 00:20:20,820
عمّاذا تتكلّمين يا عجوز؟

346
00:20:20,820 --> 00:20:23,190
!اهربوا! اصعدوا الضفّة

347
00:20:38,290 --> 00:20:41,310
!تبّاً

348
00:20:48,190 --> 00:20:50,470
تأخّرتُ كثيراً

349
00:20:51,390 --> 00:20:52,680
...أنتِ

350
00:20:56,940 --> 00:20:58,360
هذه غلطتك

351
00:20:59,270 --> 00:21:01,010
...لو كنتُ أحمل إيبوكيمارو

352
00:21:01,010 --> 00:21:03,320
أشكّ في ذلك

353
00:21:03,320 --> 00:21:06,470
لم أرَ انهياراً بهذا السّوء من قبل

354
00:21:06,470 --> 00:21:10,020
وإلى أين يذهبون دون تفكير؟

355
00:21:10,700 --> 00:21:13,270
من أنت بالضّبط على أيّ حال؟

356
00:21:13,270 --> 00:21:14,290
صحيح

357
00:21:14,290 --> 00:21:18,000
أنا مانبي إتشينوميا، المُقامِر

358
00:21:18,280 --> 00:21:19,340
مانبي؟

359
00:21:19,340 --> 00:21:21,980
ماذا تفعل في عالم الطّيف؟

360
00:21:21,980 --> 00:21:24,050
هل يوجد قُرى أُخرى كهذه؟

361
00:21:24,050 --> 00:21:27,170
يوجد، لكنّها ليست بالكثيرة

362
00:21:27,170 --> 00:21:29,260
إنّهم موتى، لكن لدينا أرواح

363
00:21:29,890 --> 00:21:32,440
ألا تُفضّلين ألّا تفقدي صوابكِ؟

364
00:21:32,440 --> 00:21:35,970
ماذا؟ لا أُصدّق بأنّه يوجد أشباح مثلك

365
00:21:36,690 --> 00:21:40,010
ألا تريدين أن تكوني صالحة قدر المُستطاع؟

366
00:21:41,690 --> 00:21:43,110
...صالحة

367
00:21:45,080 --> 00:21:46,880
ما هذا؟

368
00:21:46,880 --> 00:21:47,820
سيريان؟

369
00:21:48,070 --> 00:21:49,050
أحد أصدقائكِ؟

370
00:21:49,050 --> 00:21:50,080
أجل

371
00:21:50,080 --> 00:21:52,540
حسناً، لنفعل ذلك. هيّا بنا

372
00:21:52,540 --> 00:21:53,750
!أجل

373
00:21:58,780 --> 00:22:00,040
...مُستحيل

374
00:22:00,040 --> 00:22:01,790
ماذا تنتظرين؟

375
00:22:01,790 --> 00:22:03,960
!اصمت! أنا قادمة

376
00:22:06,190 --> 00:22:07,900
أنا أعوم قليلاً

377
00:22:08,630 --> 00:22:10,010
لديكِ الإمكانيّة

378
00:22:12,600 --> 00:22:14,730
لا أستطيع فعل ذلك

379
00:22:16,510 --> 00:22:19,460
!انتظرني يا مانبي