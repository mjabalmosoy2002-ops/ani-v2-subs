1
00:00:00,770 --> 00:00:02,940
قمتِ باتّصال روحيّ وأنتِ طفلة؟

2
00:00:02,940 --> 00:00:07,230
أجل، في فترة الحضانة. كان
عمري أربع سنوات

3
00:00:07,900 --> 00:00:11,070
كانت هناك فتاة أُخرى تستطيع رؤية الأشباح

4
00:00:11,070 --> 00:00:14,920
.كنّا نفهم بعضنا الآخر حقّاً
كانت صديقتي الحقيقيّة الوحيدة

5
00:00:14,920 --> 00:00:16,290
كنّا قد استمتعنا معاً

6
00:00:16,920 --> 00:00:21,500
لكن تناغمنا مع بعضنا الآخر واستمرّت
قِوانا في التحسُّن

7
00:00:21,940 --> 00:00:24,100
ما كانت سايونجي لتسمح بذلك

8
00:00:24,460 --> 00:00:29,180
آنذاك، لم يردني أبي أن أصبح أقوى

9
00:00:29,180 --> 00:00:33,520
وعدتُ ألّا أكشف أبداً عن هويّتي
إذا التقينا ثانية

10
00:00:34,130 --> 00:00:40,350
بالمُقابل، وعدَ أبي بأنّه سيترك آيبا-سان وشأنها

11
00:00:40,600 --> 00:00:44,570
ألا تتذكّركِ فعلاً؟

12
00:00:44,820 --> 00:00:46,080
لا أعتقد ذلك

13
00:00:46,410 --> 00:00:50,030
كنّا صغيرتين، وأشكّ في أنّها ستكذب بشأن ذلك

14
00:00:50,380 --> 00:00:52,990
يستطيع النّاس إخفاء الأشياء
دون الكذِب بشأنها

15
00:00:53,680 --> 00:00:55,960
آمل أن يكون الأمر كذلك

16
00:00:55,960 --> 00:00:58,450
حينها لن أضطرّ للقلق بشأن وجودي حولها

17
00:00:59,740 --> 00:01:01,670
لكن الوضع قد تغيّر

18
00:01:01,890 --> 00:01:06,260
وضعتكِ سايونجي تحت رعايتي
لتعزيز قوّتكِ الرّوحيّة

19
00:01:06,260 --> 00:01:07,160
أجل

20
00:01:07,160 --> 00:01:12,890
إذا كان التّفاعل معها ثانية سوف يجعلكِ
أقوى، ألن يكون هذا ما يريده؟

21
00:01:12,890 --> 00:01:17,020
ربّما. سأسأل أبي عن الأمر

22
00:01:18,050 --> 00:01:19,500
!ها هي ذي! بسرعة

23
00:01:19,500 --> 00:01:21,390
عُلِم. سأدور

24
00:01:22,200 --> 00:01:24,980
سأحمي سيري-تشان

25
00:03:12,560 --> 00:03:14,910
نمتُ جيّداً

26
00:03:25,930 --> 00:03:26,670
ماذا؟

27
00:03:27,190 --> 00:03:27,940
!انخفضي

28
00:03:30,620 --> 00:03:31,750
!مهلاً

29
00:03:43,130 --> 00:03:47,930
أزلتُ رقاقتكِ، لكن مع ذلك يستطيعون
رصد الأجسام القريبة. آسف

30
00:03:47,930 --> 00:03:48,620
لا عليك

31
00:03:48,910 --> 00:03:51,470
.استمرّي في الضّغط عليها
سوف تُعالَج قريباً

32
00:03:51,470 --> 00:03:53,200
شكراً لك

33
00:03:54,530 --> 00:03:56,510
رقاقة مُصادقة بيومتريّة

34
00:03:56,960 --> 00:04:01,940
لم أكن أعلم بأنّ هذه كانت
مزروعة داخل النّاس

35
00:04:02,930 --> 00:04:05,600
،لكن الأهمّ من ذلك

36
00:04:05,600 --> 00:04:11,400
أخبرتُ النّاس بحقيقة نفسي، ولم يتقبّلوها

37
00:04:11,400 --> 00:04:17,040
لم أعرف ماذا أفعل بمشاعري
حيال الكذبة الّتي كنتُ أعيشها

38
00:04:29,960 --> 00:04:34,760
...كنتُ أكذب على الجميع

39
00:04:34,760 --> 00:04:37,340
الجميع يكذبون

40
00:04:39,050 --> 00:04:40,920
لكن ماذا يجدر بي أن أفعل؟

41
00:04:40,920 --> 00:04:42,550
لديكِ خياران

42
00:04:42,780 --> 00:04:47,380
الأوّل، التخلّي عن اسم آيبا سيريا
والعيش كشخص آخر

43
00:04:48,020 --> 00:04:52,820
والثّاني، قبول الموت والعيش كآيبا سيريا

44
00:04:52,820 --> 00:04:54,060
—أيضاً

45
00:04:52,820 --> 00:04:57,470
أيضاً، ليس "ماذا ينبغي أن تفعلي؟" بل
"ماذا تريدين أن تفعلي؟"

46
00:04:57,470 --> 00:05:01,160
إنّه قراركِ. استغرقي بعض الوقت
للتّفكير في ذلك

47
00:05:01,370 --> 00:05:02,360
صحيح؟

48
00:05:02,360 --> 00:05:03,960
لا تسرقي عباراتي

49
00:05:03,960 --> 00:05:07,450
عباراتك؟ أجل، أعتقد بأنّك
لا تعني ما تقول فعليّاً

50
00:05:07,450 --> 00:05:08,520
هذا غير صحيح

51
00:05:09,080 --> 00:05:11,460
جيّد. إنّها تضحك

52
00:05:13,740 --> 00:05:17,210
ابقي هنا حاليّاً. لديّ شأن معك

53
00:05:18,290 --> 00:05:19,170
سيّد كاهن

54
00:05:20,330 --> 00:05:21,340
آسف

55
00:05:21,340 --> 00:05:24,800
سأشغّل الحمّام. لا نريدكِ أن توسّخي الفِراش

56
00:05:25,040 --> 00:05:28,070
ماذا؟ شكراً

57
00:05:40,490 --> 00:05:44,040
!هذا يبعث على الاسترخاء. يا للهدوء

58
00:05:44,040 --> 00:05:46,160
أشعر وكأنّني وحيدة للمرّة الأولى

59
00:05:47,410 --> 00:05:51,370
أفتقد آيكو ويوزورو

60
00:05:53,130 --> 00:05:54,110
...لكن

61
00:06:18,730 --> 00:06:21,090
هذا صحيح. أستطيع الغناء

62
00:06:21,090 --> 00:06:22,110
آيبا-سان

63
00:06:22,960 --> 00:06:24,700
سايونجي-سان؟

64
00:06:24,700 --> 00:06:26,660
الفطور جاهز

65
00:06:27,000 --> 00:06:28,460
هل ترغبين في الانضمام لنا؟

66
00:06:28,460 --> 00:06:29,280
!أجل، من فضلك

67
00:06:30,320 --> 00:06:31,690
لنأكل

68
00:06:31,690 --> 00:06:33,520
شكراً على الطّعام

69
00:06:39,100 --> 00:06:40,920
!لذيذ جدّاً

70
00:06:41,690 --> 00:06:43,260
أنتِ تأكلين بسرعة

71
00:06:43,260 --> 00:06:47,090
آسفة يا ريكو-سان. لم آكل شيئاً منذ مدّة

72
00:06:47,090 --> 00:06:50,240
هل أنتِ من أعدّ هذا يا روي-تشان؟

73
00:06:50,650 --> 00:06:53,100
زرعتُ مُعظم الخضراوات بنفسي

74
00:06:54,320 --> 00:06:56,390
أنتِ مُكتفية ذاتيّاً إذاً

75
00:06:58,000 --> 00:06:58,810
أجل

76
00:06:58,810 --> 00:07:02,530
لدينا قطعة أرض ولا نحبّ السّماح
للغُرباء بالدّخول

77
00:07:02,530 --> 00:07:05,800
أجل، هذا الرّاهب الفاسد يرمي
بكافّة الأعمال الرّتيبة

78
00:07:05,800 --> 00:07:09,170
على فتيات صغيرات ظريفات
وذلك كي يُمارس التأمُّل

79
00:07:09,170 --> 00:07:12,490
لا يدع أحداً يرى ذلك

80
00:07:12,490 --> 00:07:14,530
من تنعتينه بالفاسد يا أكاري؟

81
00:07:14,530 --> 00:07:16,880
التّركيز على التأمُّل ليس سيّئاً جدّاً

82
00:07:16,880 --> 00:07:19,060
إذاً أنت لا تنكر بأنّك ترمي بالأعمال
الرّتيبة على عاتقنا

83
00:07:19,400 --> 00:07:20,710
إنّها الحقيقة

84
00:07:25,180 --> 00:07:26,680
ما الأمر يا آيبا-سان؟

85
00:07:26,680 --> 00:07:30,970
...في المدرسة، لم أركِ تضحكين هكذا أبداً

86
00:07:30,970 --> 00:07:32,450
في الواقع، لا شيء

87
00:07:32,450 --> 00:07:35,100
طبخ روي-تشان لذيذ حقّاً

88
00:07:35,100 --> 00:07:40,810
أليس كذلك؟ أكلتُ في المنزل، لكن دائماً
ما ينتهي المطاف بأكلي هنا أيضاً

89
00:07:40,810 --> 00:07:41,770
!مُذهل

90
00:07:49,700 --> 00:07:51,950
أنا آسفة. كانت تلك مزحة

91
00:07:51,950 --> 00:07:52,660
ماذا؟

92
00:07:53,580 --> 00:07:55,700
أنتِ في حالة ممتازة ثانية اليوم
يا كايدي-تشان

93
00:07:55,700 --> 00:07:57,330
من الصّعب تمييز ما إن كنتِ تمزحين أم لا

94
00:07:57,330 --> 00:08:01,130
،شكراً على الطّعام. على أيّ حال
أنت مُرحّب بكِ هنا

95
00:08:01,400 --> 00:08:02,090
...حسناً

96
00:08:02,300 --> 00:08:04,710
،قد يكون ذلك مؤقّتاً فقط

97
00:08:04,710 --> 00:08:08,550
،لكن كي أثبت بأنّني أعني ما أقول
سأشتري لحماً على العشاء اللّيلة

98
00:08:08,550 --> 00:08:10,300
الكهنة يأكلون اللّحم؟

99
00:08:16,640 --> 00:08:19,100
سايونجي-سان، هل ستذهبين إلى المدرسة الآن؟

100
00:08:19,100 --> 00:08:21,380
هل أنت مُنضمّة لأيّ نادٍ؟

101
00:08:21,380 --> 00:08:22,060
لا

102
00:08:22,060 --> 00:08:25,570
فهمت. ظننتُ بأنّكِ ذاهبة بما أنّكِ
ترتدين زيّكِ الرّسميّ

103
00:08:25,570 --> 00:08:30,320
آسفة. أصبح ذلك عادة، وأُفضّل ارتداء هذا

104
00:08:30,600 --> 00:08:33,250
لدى الجدّة إحساس جنونيّ بالموضة

105
00:08:33,250 --> 00:08:34,930
الجدّة؟ أتنادينها بذلك؟

106
00:08:34,930 --> 00:08:36,040
ماذا؟ ألا ينبغي لي ذلك؟

107
00:08:36,380 --> 00:08:37,180
ماذا؟

108
00:08:38,560 --> 00:08:40,520
لا أُمانع

109
00:08:40,520 --> 00:08:43,180
أستمتع بمراسم الشّاي وخطّ اليد
والرّماية بالقوس

110
00:08:43,180 --> 00:08:46,420
لديّ كثير من الهوايات قديمة الطّراز

111
00:08:46,420 --> 00:08:49,170
لا أمانع لقب الجدّة

112
00:08:49,550 --> 00:08:52,270
ماذا؟ لا تُمانعين؟

113
00:08:51,290 --> 00:08:52,270
آيبا-سان

114
00:08:52,940 --> 00:08:54,850
أشكر لكِ اهتمامكِ

115
00:08:54,850 --> 00:08:59,340
العفو. إن كنتِ لا تُمانعين ذلك، فأنا كذلك أيضاً

116
00:08:59,340 --> 00:09:00,320
حسناً، هذا مُحرج

117
00:09:00,320 --> 00:09:01,560
سأذهب إلى منزل جدّتي

118
00:09:01,560 --> 00:09:04,160
إلى اللّقاء

119
00:09:04,160 --> 00:09:06,530
لحظة، كم عمر "الجدّة"؟

120
00:09:06,840 --> 00:09:09,920
آكاري تشير إلى جدّتها الفعليّة

121
00:09:09,920 --> 00:09:11,240
هكذا إذاً

122
00:09:11,240 --> 00:09:13,240
ينبغي أن أذهب أيضاً

123
00:09:13,470 --> 00:09:15,380
لديّ شيء لأفعله في المنزل

124
00:09:15,970 --> 00:09:17,540
إلى اللّقاء

125
00:09:20,040 --> 00:09:23,950
غيا تي غيا تي هارا غيا تي

126
00:09:23,950 --> 00:09:27,960
هارا سو غيا تي بو جي سو وا كا

127
00:09:25,620 --> 00:09:27,080
هذا المكان ضخم

128
00:09:27,080 --> 00:09:28,790
أين روي-تشان يا ترى؟

129
00:09:27,960 --> 00:09:32,720
هان نيا شين غيو

130
00:09:34,930 --> 00:09:36,680
هل تبحثين عن دورة المياه؟

131
00:09:36,680 --> 00:09:41,310
لا. تساءلتُ عمّا إذا كان هناك
ما يمكنني المُساعدة فيه

132
00:09:41,310 --> 00:09:45,180
نحن نتكفّل بذلك. ستُشكّلين عقبة إذا فعلتِ

133
00:09:45,180 --> 00:09:46,060
!سيّد كاهن

134
00:09:46,320 --> 00:09:47,660
...جرحك في الأمس

135
00:09:48,010 --> 00:09:50,930
أنا بخير. ماذا عنكِ؟

136
00:09:50,930 --> 00:09:53,820
أنا بخير. إنّه لا يؤلمني

137
00:09:53,820 --> 00:09:56,530
هكذا إذاً. هذا جيّد

138
00:10:01,700 --> 00:10:04,740
روي-سان، سأقدّم المُساعدة

139
00:10:04,740 --> 00:10:08,230
تكفّلتُ بالأمر. ستُشكّلين عقبة إذا فعلتِ

140
00:10:11,610 --> 00:10:14,290
تلك حيوانات، أليس كذلك؟

141
00:10:14,290 --> 00:10:17,500
إنّها وحوش روحيّة مُخيَّطة. صنعتها روي

142
00:10:17,920 --> 00:10:21,310
تحتوي على سحابة روحيّة مُشبعة
بقوّة روي الرّوحيّة

143
00:10:21,580 --> 00:10:22,890
سحابة روحيّة؟

144
00:10:23,130 --> 00:10:27,150
أجل. إنّها الطّاقة الرّوحيّة العائمة في الهواء

145
00:10:27,460 --> 00:10:29,790
تستطيع روي-سان فعل ذلك؟

146
00:10:30,100 --> 00:10:31,130
ألا تُخيفك؟

147
00:10:31,130 --> 00:10:33,260
ماذا؟ حسناً

148
00:10:33,260 --> 00:10:37,620
لا أفهم آليّة عملها، لكن من الواضح
أنّها ليست مُخيفة

149
00:10:38,130 --> 00:10:42,980
تبدو مثل هالة... روي-سان؟
قوّتها الرّوحيّة

150
00:10:45,040 --> 00:10:46,380
منذ متى تمكّنتِ من رؤية الأشباح؟

151
00:10:47,740 --> 00:10:49,130
لطالما كنتُ كذلك

152
00:10:49,130 --> 00:10:52,620
تمّ مسّي منذ كنتُ صغيرة

153
00:10:52,620 --> 00:10:56,510
يمكنك القول بأنّني أتآلف معها
أكثر من البشر الأحياء

154
00:10:56,770 --> 00:10:57,800
هكذا إذاً

155
00:10:58,240 --> 00:11:01,940
على أيّ حال، هذا المكان هادئ
وباعث على الاسترخاء فعلاً

156
00:11:01,940 --> 00:11:04,940
لا توجد أي أرواح شرّيرة أو أشباح هنا

157
00:11:04,940 --> 00:11:09,400
،لدينا حاجز. في نهاية المطاف
الجميع هنا حسّاسون

158
00:11:09,400 --> 00:11:13,960
عملكم هو هزيمة الأرواح الشرّيرة، صحيح؟

159
00:11:13,960 --> 00:11:17,610
حتّى سايونجي-سان. رأيتُ مدى قوّتها

160
00:11:17,960 --> 00:11:22,080
أجل. نحن ننتمي لمُنظّمة دوليّة تُدعى تيرا

161
00:11:22,780 --> 00:11:25,410
تيرا؟ تبدو مألوفة

162
00:11:25,410 --> 00:11:26,920
إنّها مزار أيضاً

163
00:11:27,670 --> 00:11:28,290
كنز

164
00:11:28,290 --> 00:11:29,070
ت

165
00:11:29,070 --> 00:11:29,830
تطويق

166
00:11:29,830 --> 00:11:30,180
ي

167
00:11:30,180 --> 00:11:31,030
استخلاص

168
00:11:31,030 --> 00:11:31,650
ر

169
00:11:31,650 --> 00:11:32,370
تخزين

170
00:11:32,370 --> 00:11:33,070
أ

171
00:11:33,070 --> 00:11:35,630
هدف تيرا هو احتلال عالم الأرواح الهائمة

172
00:11:35,890 --> 00:11:37,340
عالم ماذا؟

173
00:11:37,560 --> 00:11:40,300
يُعرَف أيضاً بالخطّ المزدوج في العالم
النّاطق بالإنجليزيّة

174
00:11:41,080 --> 00:11:44,720
هناك عالم البشر، وعالم الأرواح
،حيث تقطن الأشباح

175
00:11:44,720 --> 00:11:47,520
والعالم حيث يتشابك العالمان ويتعايشان

176
00:11:47,520 --> 00:11:49,940
هذا هو عالم الأرواح الهائمة

177
00:11:49,940 --> 00:11:51,310
لم يذكر أحدٌ ذلك أبداً

178
00:11:51,560 --> 00:11:52,820
لا يعلمون

179
00:11:53,600 --> 00:11:56,420
مضى أقلّ من 20 عاماً منذ تمّ
تحديد عالم الأرواح الهائمة

180
00:11:56,420 --> 00:11:58,200
دُول العالم والشّخصيّات البارزة

181
00:11:58,200 --> 00:12:01,320
لا يكشفون إلّا القليل من تلك المعلومات

182
00:12:01,320 --> 00:12:06,040
هذا سيُغيّر العالم بالتّأكيد بالنّسبة
للنّاس العاديّين

183
00:12:06,280 --> 00:12:08,900
لكنّه مُختلف بالنّسبة لنا نحن
ذوي القوى الرّوحيّة

184
00:12:08,900 --> 00:12:11,750
لقد تمّ جرّنا نحوه، شئنا أم أبينا

185
00:12:12,560 --> 00:12:13,460
ماذا تقصد؟

186
00:12:13,950 --> 00:12:16,820
ماذا لو طاقة ما من عالم الأرواح الهائمة

187
00:12:16,820 --> 00:12:19,840
يمكن استخدامها كطاقة في عالم البشر؟

188
00:12:19,840 --> 00:12:22,100
ستصبح مورِداً هامّاً حينئذ

189
00:12:22,100 --> 00:12:24,850
...تماماً، لهذا السّبب نحن

190
00:12:27,810 --> 00:12:29,520
سيشعل ذلك حرباً؟

191
00:12:31,760 --> 00:12:34,860
هل ينبغي أن تخبرني بهذا؟

192
00:12:34,860 --> 00:12:37,600
لن يُصدّقك أحد حتّى لو أخبرتهم

193
00:12:37,600 --> 00:12:41,320
حتّى لو أريتِهم الدّليل، لا جدوى، صحيح؟

194
00:12:41,810 --> 00:12:44,030
هذا صحيح

195
00:12:45,320 --> 00:12:47,120
لديّ سؤال لكِ

196
00:12:47,870 --> 00:12:48,830
لي أنا؟

197
00:12:48,830 --> 00:12:54,510
تحمّلتِ الاستحواذ بواسطة شبح
قويّ مثل كليوباترا

198
00:12:54,510 --> 00:12:56,050
وماذا كان ذلك؟

199
00:12:56,320 --> 00:12:57,760
لماذا غنّيتِ؟

200
00:12:58,060 --> 00:13:03,220
لستُ متأكّدة بحدّ ذاتي، لكن
لطالما كنتُ هكذا

201
00:13:03,790 --> 00:13:06,430
ذكريات الشّبح ومشاعره تتدفّق إلى داخلي

202
00:13:06,890 --> 00:13:09,140
أستطيع مُخاطبتهم ذهنيّاً

203
00:13:09,760 --> 00:13:12,360
وكنتُ أعرف كليو من وقت سابق

204
00:13:12,360 --> 00:13:16,840
كنتُ أحاول طرح كثير من الأسئلة عليها

205
00:13:16,840 --> 00:13:17,780
وجاء ذلك على شكل أغنية؟

206
00:13:17,780 --> 00:13:22,240
رغبتكِ في الغناء الّتي قُمِعت بواسطة
ميوكس دفعتكِ إلى فعل ذلك؟

207
00:13:23,600 --> 00:13:24,700
أيّها الكاهن

208
00:13:25,930 --> 00:13:27,950
أنا آسفة. لا أعلم

209
00:13:27,950 --> 00:13:33,170
منذ صغري، عدم الغناء كان عاديّاً بالنّسبة لي

210
00:13:33,820 --> 00:13:35,300
...موسيقى العزاء

211
00:13:35,680 --> 00:13:39,980
...تسمح للأشباح بمسّها والتّناغم مع ميوكس

212
00:13:51,840 --> 00:13:53,730
جاءتنا أوامر من المقرّ

213
00:13:54,260 --> 00:13:56,990
اليوم، بين 14:00 و 16:00

214
00:13:56,990 --> 00:13:58,820
أوامر من تيرا؟

215
00:13:59,090 --> 00:14:00,530
تعالي معنا

216
00:14:00,970 --> 00:14:03,240
سنُريكِ ما نفعله

217
00:14:03,240 --> 00:14:05,250
إذا تفرّقنا، فارتدي هذه

218
00:14:05,250 --> 00:14:07,420
ستعيدكِ إلى عالمنا

219
00:14:07,810 --> 00:14:09,200
حسناً

220
00:14:09,200 --> 00:14:12,170
نحن الثّلاثة فقط إذاً؟

221
00:14:12,170 --> 00:14:16,230
أجل. ستبقى روي هنا. في حال
—حدث أيّ شيء

222
00:14:15,090 --> 00:14:16,580
سأذهب أنا

223
00:14:16,960 --> 00:14:19,420
ثمّة أمر أودّ قوله لآيبا-سان

224
00:14:20,320 --> 00:14:21,160
أهلاً بعودتكِ

225
00:14:21,160 --> 00:14:22,120
عدتِ باكراً

226
00:14:22,120 --> 00:14:24,960
إذاً سأدع كايدي-تشان تتولّى الأمر

227
00:14:24,960 --> 00:14:28,350
هذا أفضل غالباً، بما أنّكما زميلتان في الصّفّ

228
00:14:28,350 --> 00:14:29,400
حسناً

229
00:14:34,300 --> 00:14:36,720
هذا هو عالم الأرواح الهائمة؟

230
00:14:36,720 --> 00:14:37,940
سأعدُّ البلاط الحجريّ

231
00:14:38,350 --> 00:14:40,410
كايدي، راقبي المنطقة

232
00:14:38,680 --> 00:14:40,410
البلاط الحجريّ؟

233
00:14:40,410 --> 00:14:41,010
عُلِم

234
00:14:41,010 --> 00:14:42,440
ماذا يجدر بي أن أفعل؟

235
00:14:42,700 --> 00:14:44,570
ابتعدي عن الطّريق

236
00:14:44,570 --> 00:14:46,160
حسناً

237
00:14:46,160 --> 00:14:50,490
يا أرواح الأرض، استسلمي للجذور
المُمتدّة من الشّجرة العظيمة

238
00:14:50,490 --> 00:14:52,220
!البلاط الحجريّ الأرضيّ

239
00:14:54,580 --> 00:14:55,750
...سيّد كاهن

240
00:14:59,160 --> 00:15:00,420
أحدهم قادم

241
00:15:00,860 --> 00:15:03,060
الاستحواذ المُسلَّح: ناسو نو يويتشي

242
00:15:03,060 --> 00:15:04,130
أنا هنا

243
00:15:04,130 --> 00:15:05,470
هيّا بنا

244
00:15:05,470 --> 00:15:07,890
الرّياح السّوداء: وميض جناح العنقاء

245
00:15:21,190 --> 00:15:22,150
مُذهل

246
00:15:22,520 --> 00:15:23,990
ينبغي أن يكون ذلك كافياً

247
00:15:28,690 --> 00:15:30,940
خليط بين الشّيء المادّي وقوّة الرُّوح

248
00:15:31,370 --> 00:15:33,350
ظاهرة يتمّ تشكيلها بواسطة خيال المُستخدِم

249
00:15:33,350 --> 00:15:35,160
وتصرُّفات الرُّوح المُساعِدة

250
00:15:35,160 --> 00:15:38,000
...مُبهر بحقّ. لكن

251
00:15:44,380 --> 00:15:46,120
لن يكون هذا سهلاً

252
00:15:47,050 --> 00:15:48,380
نيكولا تيسلا

253
00:15:48,380 --> 00:15:49,720
هل تعمل لصالح نيرو؟

254
00:15:50,210 --> 00:15:55,480
،لم نستطع القبض على حلفائك
لكن لن نفشل ثانية

255
00:15:55,480 --> 00:15:56,420
غادر الآن

256
00:15:56,420 --> 00:15:57,780
هل أنت متأكّد من هذا؟

257
00:15:57,780 --> 00:16:00,940
...كليوباترا، سيزر، وأنطوني

258
00:16:00,940 --> 00:16:04,110
أعلم بأنّهم داخل تلك المرأة

259
00:16:04,350 --> 00:16:07,220
أخبر نيرو بأنّهم اختاروا البقاء هناك

260
00:16:07,220 --> 00:16:08,610
حقّاً؟

261
00:16:08,610 --> 00:16:14,220
بغضّ النّظر، سأستردّهم، بمن
في ذلك هي إن لزم الأمر

262
00:16:17,210 --> 00:16:19,000
استطاع مُجاراة طول موجتنا؟

263
00:16:19,000 --> 00:16:19,620
!سيري-تشان

264
00:16:22,060 --> 00:16:25,800
والآن هيّا بنا نعود إلى نيرو-ساما

265
00:16:26,390 --> 00:16:27,760
لا أستطيع التحرُّك

266
00:16:28,020 --> 00:16:31,720
قوّتي الرّوحيّة تتوافق مع قوّتكِ الرّوحيّة الآن

267
00:16:32,960 --> 00:16:34,220
مُدهش

268
00:16:34,220 --> 00:16:38,690
لديكِ تقريباً 23 ضعف قوّة الرُّوح
المُتراكمة الّتي أملكها

269
00:16:38,690 --> 00:16:40,400
لكنّكِ تهدرين وقتكِ

270
00:16:41,860 --> 00:16:43,310
ساقايّ تتحرّكان من تلقاء نفسها

271
00:16:43,310 --> 00:16:44,770
والآن لنذهب

272
00:16:49,130 --> 00:16:49,900
ماذا؟

273
00:16:50,490 --> 00:16:53,130
هذه الفتاة، سيريا، هي سيّدتنا الجديدة

274
00:16:53,130 --> 00:16:56,120
أخبر نيرو-ساما، لا بل أخبر نيرو بأنّنا سنُغادر

275
00:16:56,120 --> 00:17:00,620
للبحث عن سايساريون، أملنا من أجل روما

276
00:17:00,620 --> 00:17:02,130
أحقّاً ذلك؟

277
00:17:02,360 --> 00:17:03,320
ماذا؟

278
00:17:06,010 --> 00:17:07,130
استسلم

279
00:17:08,130 --> 00:17:09,880
لا تُعقّدوا الأمر

280
00:17:21,400 --> 00:17:23,050
لا تُجهِد نفسك

281
00:17:23,050 --> 00:17:26,520
يمكنك الحِفاظ على عدد محدود
من الدّارات في آن واحد فقط

282
00:17:26,520 --> 00:17:28,030
غادر حالاً، وسنتجاهل الأمر

283
00:17:28,510 --> 00:17:30,990
!كيف تجرؤون؟

284
00:17:33,360 --> 00:17:33,990
!سيريا

285
00:17:33,990 --> 00:17:36,560
إذا بقينا هنا، سيتمّ التهامنا
!بواسطة نيكولا

286
00:17:36,560 --> 00:17:37,370
!يجب أن نخرج

287
00:19:27,800 --> 00:19:29,080
...نيكولا

288
00:19:32,560 --> 00:19:33,900
هل أفلح ذلك؟

289
00:19:34,280 --> 00:19:38,380
ربط البلاطات الحجريّة يجعل منطقةً
جزءاً من مستوطنتنا

290
00:19:38,380 --> 00:19:40,830
أهكذا تُقاتلون للسّيطرة على منطقة؟

291
00:19:41,700 --> 00:19:46,500
نستبدل طاقةَ الرّوح الهائمة هنا
ونربطها بالعالم البشريّ

292
00:19:46,500 --> 00:19:48,310
لكن كيف؟

293
00:19:48,690 --> 00:19:50,800
،عندما تمّ تعريف هذا العالم

294
00:19:50,800 --> 00:19:53,880
تحرّرت أرواح الشّخصيّات التّاريخيّة من السّماء

295
00:19:54,540 --> 00:19:58,510
،قمنا بمُحاكاة اختراعات إيديسون
على سبيل المثال

296
00:19:59,130 --> 00:20:01,470
وهذا يحدث حول العالم؟

297
00:20:01,470 --> 00:20:03,700
استغرقَ ذلك بعض الوقت

298
00:20:03,700 --> 00:20:05,970
من الخطير البقاء هنا فترة أطول

299
00:20:05,970 --> 00:20:06,680
أجل

300
00:20:06,900 --> 00:20:10,020
آيبا-سان، هلّا أخذتُ قليلاً
من وقتكِ عندما نعود؟

301
00:20:10,020 --> 00:20:11,400
بالطّبع

302
00:20:12,050 --> 00:20:15,350
عمّاذا أردتِ أن تتكلّمي يا سايونجي-سان؟

303
00:20:15,840 --> 00:20:20,680
قضينا وقتاً معاً عندما كنّا صغيرتين جدّاً

304
00:20:21,090 --> 00:20:22,770
توقّعتُ هذا

305
00:20:22,770 --> 00:20:23,950
...سيري

306
00:20:23,950 --> 00:20:26,540
آيبا-سان، لاحظتِ كذلك؟

307
00:20:26,540 --> 00:20:33,480
أجل، لكن افترضتُ بأنّكِ غادرتِ بسبب قوّتي

308
00:20:34,000 --> 00:20:36,980
لذا كنتُ أراقبكِ من بعيد

309
00:20:36,980 --> 00:20:38,550
...آيبا-سان

310
00:20:38,550 --> 00:20:40,190
لا تقلقي

311
00:20:40,190 --> 00:20:42,820
حصلتُ على إذن أبي اليوم

312
00:20:43,680 --> 00:20:44,760
...في هذا المكان، يمكننا

313
00:20:45,720 --> 00:20:48,820
لا، لا يهمّ. هذا قراركِ أنتِ

314
00:20:50,260 --> 00:20:55,530
لم أتوقّع أبداً أن يترتّب عليّ الاختيار
ما بين الحياة والموت

315
00:20:57,850 --> 00:20:59,060
!ماذا؟

316
00:20:59,060 --> 00:21:01,190
نفد البيض النيّئ لدينا من الآن؟

317
00:21:01,190 --> 00:21:03,910
أحصيتُ بشكل خاطئ لأنّ لدينا
عدد أكبر من النّاس

318
00:21:03,910 --> 00:21:05,820
لن يكون هذا كافياً

319
00:21:06,720 --> 00:21:08,830
أنا آسفة. هذه غلطتي

320
00:21:09,960 --> 00:21:11,120
يمكنك تناول خ اصّتي

321
00:21:15,010 --> 00:21:15,920
لا، لا أستطيع

322
00:21:16,330 --> 00:21:17,630
حقّاً؟

323
00:21:19,140 --> 00:21:21,590
إذاً فشلتِ في إقناعهم هذه المرّة؟

324
00:21:21,590 --> 00:21:24,910
إقناعهم؟ لم أكن أحاول فعل ذلك

325
00:21:24,910 --> 00:21:27,960
هذا أشبه بالتكلّم مع شخص فحسب

326
00:21:27,960 --> 00:21:30,560
التكلُّم؟ سمعتكِ تغنّين

327
00:21:30,560 --> 00:21:34,310
محظوظة. ربّما سأزيل رقاقتي أيضاً

328
00:21:34,310 --> 00:21:35,730
هذا ملاذ أخير

329
00:21:35,730 --> 00:21:38,040
البقاء على قيد الحياة أنسب
من نواحٍ عديدة

330
00:21:38,690 --> 00:21:42,160
على أيّ حال، تحقّقنا من قدرات آيبا-سان

331
00:21:42,160 --> 00:21:46,370
الدّعم الرّوحيّ من الأشباح في داخلها
يُعزّز قدراتها القتاليّة

332
00:21:46,370 --> 00:21:50,020
إنّها تحبس أرواحاً شرّيرة في داخلها
وتغنّي كثنائي معهم

333
00:21:50,020 --> 00:21:53,250
إذا بلغَتْهم تلك الأغنية، فيمكنها
حتّى أن تُطهّرهم

334
00:21:53,250 --> 00:21:56,900
يراودني فضول بشأن ارتباطها بميوكس أيضاً

335
00:21:56,900 --> 00:21:58,090
ارتباط؟

336
00:21:58,340 --> 00:22:00,800
أليس ميوكس مُجرّد تطبيق؟

337
00:22:01,800 --> 00:22:04,640
تطبيق لديه الصّلاحية بقتل النّاس

338
00:22:05,600 --> 00:22:09,950
إنّه يجعل النّاس يعتقدون بأنّ ما ينبغي
أن يكون غير مُمكن عاديّاً

339
00:22:09,950 --> 00:22:11,560
هذا يحدث كثيراً

340
00:22:11,560 --> 00:22:15,760
لكن من الطّبيعيّ والعاديّ أيضاً الشّعور
بالرّغبة في فعل شيء حالما تُلاحظين

341
00:22:15,760 --> 00:22:20,090
الاعتقاد بأنّ هذا عاديّ قد يكون وهماً أيضاً

342
00:22:20,090 --> 00:22:21,360
بحسب الظّرف

343
00:22:22,250 --> 00:22:23,820
ماذا تريدون جميعاً؟

344
00:22:27,730 --> 00:22:32,440
يجب ألّا تتخلّف اليابان عن باقي
العالم وتزداد ضعفاً

345
00:22:32,440 --> 00:22:33,940
أؤيّد هذا الرّأي

346
00:22:33,940 --> 00:22:35,680
لكن هذا ليس كلّ شيء

347
00:22:37,600 --> 00:22:40,360
هدفنا هو تدمير ميوكس

348
00:22:40,760 --> 00:22:42,670
لاسترجاع الموسيقى للجنس البشريّ

349
00:22:44,580 --> 00:22:46,580
استرجاع الموسيقى من ميوكس؟

350
00:22:47,860 --> 00:22:52,080
عرفتُ أخيراً ما أريد فعله

351
00:22:52,560 --> 00:22:56,280
أريد أن أغنّي. أريد من الجميع أن يغنّوا

352
00:22:56,280 --> 00:22:58,020
لذا أعرف ماذا أفعل

353
00:22:59,260 --> 00:23:01,130
أنا آيبا سيريا

354
00:23:01,130 --> 00:23:05,700
من فضلك اقتلني وذلك كي أستمرّ
في العيش كـ آيبا سيريا

355
00:23:06,660 --> 00:23:10,100
شو كين غو أون كاي كو

356
00:23:09,120 --> 00:23:11,220
لِمَ كان عليها أن تسقط؟

357
00:23:10,100 --> 00:23:14,430
دو إيسّاي كو ياكو شا ري شي

358
00:23:11,580 --> 00:23:14,430
أردتُ مُصالحتها

359
00:23:14,430 --> 00:23:16,510
شيكيفو يي كو

360
00:23:15,120 --> 00:23:19,310
ما كانت سيريا لتريدنا أن نبكي لأجلها

361
00:23:16,510 --> 00:23:18,760
كو فو يي شيكي

362
00:23:18,760 --> 00:23:20,800
شيكي سوكو زي كو

363
00:23:20,520 --> 00:23:21,800
لا أُبالي

364
00:23:20,800 --> 00:23:23,460
كو سوكو زي شيكي

365
00:23:22,420 --> 00:23:24,300
...سيريا

366
00:23:23,460 --> 00:23:25,410
جو سو غيو شيكي

367
00:23:25,410 --> 00:23:27,500
ياكو بو نيو زي

368
00:23:27,500 --> 00:23:29,320
شا ري شي

369
00:23:29,320 --> 00:23:32,000
زي شو هو كو سو

370
00:23:30,210 --> 00:23:31,440
أنا آسفة

371
00:23:32,000 --> 00:23:35,920
فو شو فو ميتسو فوكو فو

372
00:23:32,260 --> 00:23:37,230
في مثل هذا الوقت، كنتُ سعيدة لأنّني
شعرتُ كما لو أنّ سيري-تشان

373
00:23:35,920 --> 00:23:39,020
جو فو زو فو غين

