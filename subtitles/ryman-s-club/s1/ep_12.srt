!انطلق انطلق هيا

199
00:15:27,410 --> 00:15:28,690
!انطلق انطلق سانبيف

200
00:15:29,090 --> 00:15:30,570
!انطلق انطلق هيا

201
00:15:30,570 --> 00:15:32,450
!انطلق انطلق سانبيف

202
00:15:32,450 --> 00:15:34,030
!انطلق انطلق هيا

203
00:15:34,030 --> 00:15:35,770
!انطلق انطلق سانبيف

204
00:15:34,350 --> 00:15:36,160
...مذهل

205
00:15:35,770 --> 00:15:37,390
!انطلق انطلق هيا

206
00:15:37,390 --> 00:15:39,090
!انطلق انطلق سانبيف

207
00:15:39,090 --> 00:15:40,620
!انطلق انطلق هيا

208
00:15:40,620 --> 00:15:42,400
!انطلق انطلق سانبيف

209
00:15:41,730 --> 00:15:44,830
ميكوتو، هل تمانع لو تصرفت بجشع قليلا؟

210
00:15:42,400 --> 00:15:44,220
!انطلق انطلق هيا

211
00:15:44,220 --> 00:15:45,850
!انطلق انطلق سانبيف

212
00:15:45,850 --> 00:15:47,560
!انطلق انطلق هيا

213
00:15:46,200 --> 00:15:49,180
.أريد الفوز بهذه المباراة

214
00:15:47,560 --> 00:15:49,180
!انطلق انطلق سانبيف

215
00:15:49,180 --> 00:15:53,420
.لا أريد السماح لأيّ شخص بالوقوف إلى جانبك

216
00:15:49,190 --> 00:15:50,780
!انطلق انطلق هيا

217
00:15:50,780 --> 00:15:52,540
!انطلق انطلق سانبيف

218
00:15:55,470 --> 00:15:58,300
تخبرني بذلك الآن؟

219
00:16:10,000 --> 00:16:11,610
.أنت تمزح

220
00:16:13,590 --> 00:16:15,870
!سأفوز

221
00:16:17,200 --> 00:16:19,870
.سأبذل ما في وسعي

222
00:16:21,100 --> 00:16:22,970
...في وضعنا الحاليّ

223
00:16:24,680 --> 00:16:25,670
!يمكننا الفوز

224
00:16:29,250 --> 00:16:30,670
.نقطة الفوز

225
00:16:30,670 --> 00:16:33,090
!نقطة إضافية أخرى

226
00:16:33,370 --> 00:16:35,010
.سأهتمّ بالخلف

227
00:16:36,710 --> 00:16:39,100
.أجل، أنا بخير. سأهتمّ بالخلف

228
00:16:53,190 --> 00:16:54,570
!تاتسورو

229
00:17:09,590 --> 00:17:16,590
فاز بالمباراة ميازومي تاتسورو شيراتوري ميكوتو
.من سانلايت للمشروبات

230
00:17:18,600 --> 00:17:20,280
!أجل

231
00:17:23,510 --> 00:17:25,560
!مذهل

232
00:17:25,560 --> 00:17:27,520
!شكرا لك

233
00:17:27,980 --> 00:17:29,230
!رائع

234
00:17:29,230 --> 00:17:30,940
!مذهل

235
00:17:32,650 --> 00:17:34,360
!مباراة رائعة

236
00:17:36,930 --> 00:17:38,490
.سنعقد اجتماعا عند العودة

237
00:17:46,470 --> 00:17:48,880
.اذهبا للاستراحة لبعض الوقت

238
00:17:48,880 --> 00:17:50,050
.حاضر

239
00:17:59,300 --> 00:18:00,880
لمَ أنت عابس هكذا؟

240
00:18:03,620 --> 00:18:04,770
.أخي

241
00:18:06,400 --> 00:18:11,690
.في المرة القادمة، فلنتواجه في النهائيات

242
00:18:13,700 --> 00:18:17,680
.بالمناسبة، طلبت منا أمي زيارة المنزل في وقت ما

243
00:18:18,910 --> 00:18:20,850
.أرسلت لي رسالة أنا أيضا

244
00:18:20,850 --> 00:18:24,370
.يجدر بنا زيارتها وتناول شريحة اللحم التي تعدّها

245
00:18:24,990 --> 00:18:26,500
أنت تحبها، صحيح؟

246
00:18:27,200 --> 00:18:28,980
هل تذكر كم مضى على ذلك حتى؟

247
00:18:31,910 --> 00:18:34,840
.خسرت الرهان

248
00:18:35,610 --> 00:18:40,820
.أعلم أنك تهتمّ لأمر الشركة أكثر من أيّ شخص

249
00:18:42,380 --> 00:18:47,570
.صحيح أنّ رياضات الشركات لا تنتج أيّ ربح مباشر

250
00:18:47,570 --> 00:18:49,520
.ولها تكاليفها أيضا

251
00:18:50,100 --> 00:18:51,260
...لكن

252
00:18:52,250 --> 00:18:55,110
!شكرا على دعمكم

253
00:18:55,490 --> 00:18:57,570
!شكرا لكم

254
00:18:59,310 --> 00:19:02,420
.هذا الحماس لا يعني أنّ لا قيمة له

255
00:19:02,420 --> 00:19:07,000
.مجهوداتهم توحّد قلوب الكثيرين

256
00:19:07,860 --> 00:19:13,590
.قد يبدو تأثيرا خفيّا، لكني أراه ضروريا

257
00:19:24,590 --> 00:19:26,160
.هذا جيّد

258
00:19:26,970 --> 00:19:27,540
.تبا

259
00:19:27,540 --> 00:19:29,580
ماذا؟ أهي ركبتك؟

260
00:19:30,320 --> 00:19:31,980
.تقطّع الشريط المطاطي في ملابسي الداخلية

261
00:19:52,510 --> 00:19:54,810
—شكرا على دعمكم المتـ

262
00:19:54,810 --> 00:19:57,250
ماذا؟ مزر الزنجبيل بالبصل الأخضر؟

263
00:19:57,250 --> 00:19:59,260
!مئة صندوق؟

264
00:20:05,180 --> 00:20:07,600
!ما هذا؟

265
00:20:07,600 --> 00:20:11,520
!مرحبا، هنا شركة سانلايت للمشروبات. ماذا؟! شكرا لك

266
00:20:07,980 --> 00:20:11,520
.مزر الزنجبيل بالبصل الأخضر؟ لحظة رجاءً، دعني أتفقد المخزون

267
00:20:08,490 --> 00:20:11,520
.ذلك القدر؟ كلا، شكرا لك

268
00:20:12,430 --> 00:20:14,150
!حسنا، مجددا

269
00:20:14,610 --> 00:20:15,990
!ركّز على النقطة التالية

270
00:20:15,990 --> 00:20:17,070
!مفهوم

271
00:20:17,670 --> 00:20:20,240
.تعوّد أزوما على الفريق حقا

272
00:20:20,840 --> 00:20:23,200
ماذا تريدين؟

273
00:20:23,200 --> 00:20:25,580
.أريد إنشاء فرقة تشجيع

274
00:20:25,580 --> 00:20:27,920
!كنت آمل في أن تقومي بتعليمي يا معلمة

275
00:20:27,920 --> 00:20:29,990
معلمة؟ أنا؟

276
00:20:31,170 --> 00:20:33,170
.حسنا على ما أعتقد

277
00:20:33,660 --> 00:20:38,420
.أعلنت أنك ستتقاعد عن عرض الأزياء وتركّز على تنس الريشة

278
00:20:38,720 --> 00:20:42,590
.سأبذل ما في وسعي لأكون عند حسن ظنّ الجميع في الموسم القادم

279
00:20:42,910 --> 00:20:44,760
.أقدّر دعم الجميع

280
00:20:45,060 --> 00:20:47,350
!لا تنسوا دعمي أنا أيضا

281
00:20:47,350 --> 00:20:49,450
.وقناة ياغاماتسو لتنس الريشة

282
00:20:49,450 --> 00:20:51,470
!لا تنسوا الاشتراك

283
00:20:51,470 --> 00:20:53,940
.توقفوا، أنتم تحرجون الفريق

284
00:21:02,700 --> 00:21:03,710
.جيّد

285
00:21:05,900 --> 00:21:06,990
ماذا؟

286
00:21:11,940 --> 00:21:15,160
.استراحة خمس دقائق! بعد ذلك، سنقوم بالتمارين الجسدية

287
00:21:15,160 --> 00:21:17,580
.كو-سان صارم للغاية

288
00:21:17,580 --> 00:21:18,580
.هذا مستحيل

289
00:21:19,540 --> 00:21:21,880
.بطولة الشركات على الأبواب

290
00:21:22,170 --> 00:21:23,840
!أظهروا بعض الحماس

291
00:21:23,840 --> 00:21:25,170
.حاضر

292
00:21:25,860 --> 00:21:27,800
أيها المدرب، أين هما؟

293
00:21:27,800 --> 00:21:29,800
هما؟

294
00:21:30,470 --> 00:21:33,850
وهذه هي خطتنا التجارية في التوزيع على الصعيد الوطني

295
00:21:33,850 --> 00:21:34,770
.لمشروب مزر الزنجبيل بالبصل الأخضر

296
00:21:35,400 --> 00:21:37,230
!شكرا على حسن الاستماع

297
00:21:37,470 --> 00:21:39,920
.يا رئيس القسم ميازومي، حان الوقت

298
00:21:40,440 --> 00:21:42,640
.في تلك الحالة، أستأذن

299
00:21:44,100 --> 00:21:47,180
اليوم هو موعد آخر فحص لركبته؟

300
00:21:47,180 --> 00:21:51,620
.أجل. تحسنت كثيرا. ستكون بخير مع حلول البطولة

301
00:21:55,810 --> 00:21:57,580
أنت مذهل، أتعلم ذلك؟

302
00:21:58,240 --> 00:22:01,210
.أعجب بك واوكو من أول يوم

303
00:22:02,540 --> 00:22:04,010
تحب السيارات؟

304
00:22:04,010 --> 00:22:07,520
.بحثت في اهتمامات الرئيس قبل الزيارة فحسب

305
00:22:07,520 --> 00:22:09,260
.لا يهمني أمر السيارات

306
00:22:09,520 --> 00:22:11,160
.فهمت

307
00:22:11,660 --> 00:22:16,620
أليست زيارة الزبائن يوميا حتى يتذكروك هي مضيعة للوقت؟

308
00:22:22,190 --> 00:22:25,410
.هذا ليس ممتعا

309
00:22:26,520 --> 00:22:27,910
ما الذي يعنيه ذلك؟

310
00:22:27,910 --> 00:22:32,160
لا تقلق أيها المستجدّ. سأعلمك كل ما يتعلق

311
00:22:32,470 --> 00:22:35,080
.بمتعة أن تكون بادوريمان