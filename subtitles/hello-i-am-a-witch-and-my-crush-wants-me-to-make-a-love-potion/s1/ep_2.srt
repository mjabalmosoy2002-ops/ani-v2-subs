1
00:00:03,260 --> 00:00:06,600
علاج يجذب النّساء عندما يُستخدَم
لغسل إبط الشّخص

2
00:00:06,600 --> 00:00:09,630
عِلاج يُخفّف الحكّة عندما يُستخدَم
على أخمص القدم

3
00:00:10,150 --> 00:00:13,360
علاج تحرقه لطرد الحشرات

4
00:00:13,360 --> 00:00:15,070
أجل، جميعهم هنا

5
00:00:15,910 --> 00:00:18,610
سأهتمّ ببضاعتك

6
00:00:19,340 --> 00:00:24,150
بالمُناسبة، كان هذا العِلاج يُحقّق مبيعات
جيّدة منذ غيّرتِ التّغليف

7
00:00:24,150 --> 00:00:24,910
حسناً

8
00:00:24,910 --> 00:00:28,700
أنا أراقب المبيعات جيّداً، لذا لا تقلقي

9
00:00:28,700 --> 00:00:31,250
"يُدعى هذا بـ"طريقة العجوز في الصّرافة{?}

10
00:00:31,240 --> 00:00:32,980
ما زلت تقول ذلك؟

11
00:00:32,980 --> 00:00:35,070
ويا له من اسم مُريب

12
00:00:35,070 --> 00:00:36,480
من المُؤكّد أنّك تختلس

13
00:00:36,480 --> 00:00:39,230
أريدكِ أن تثقي بي حقّاً في هذه المسألة

14
00:00:39,230 --> 00:00:42,710
إذا كان شيئاً تحتاجينه، فسأحرص
،على أن تحصلي عليه

15
00:00:42,710 --> 00:00:44,420
سواء كان مالاً أو علاجاً أو أيّ شيء

16
00:00:54,310 --> 00:00:56,250
لا معنى عميق خلف الأمر

17
00:00:56,650 --> 00:00:59,790
أريد فقط بديلاً لأنّ الّذي أرتديه يهترئ

18
00:00:59,790 --> 00:01:00,700
لا سبب وراء ذلك

19
00:01:01,040 --> 00:01:02,400
...على ذِكر الأمر

20
00:01:03,170 --> 00:01:05,360
هل أحضرت أي رِداء معك؟

21
00:01:05,360 --> 00:01:07,130
لا يهمّ أيّاً كان

22
00:01:07,980 --> 00:01:10,080
لم أحضرهم اليوم

23
00:01:10,530 --> 00:01:11,700
حسناً

24
00:01:12,880 --> 00:01:14,600
لكن أتعلمين؟

25
00:01:15,590 --> 00:01:17,440
!سأحضرهم حالاً

26
00:01:17,440 --> 00:01:19,760
!وأقصد فوراً! بعجالة

27
00:01:24,720 --> 00:01:27,400
هو ما تحدّثنا عنه البارحة

28
00:01:29,610 --> 00:01:31,570
...واليوم

29
00:01:50,090 --> 00:01:55,130
مرحباً، أنا ساحرة

30
00:01:50,090 --> 00:01:55,130
وحبيبي يريدني أن أصنع جرعةَ حُبّ

31
00:03:09,000 --> 00:03:13,460
:الحلقة 2
ساحرة البُحيرة الطيّبة

32
00:03:13,460 --> 00:03:16,770
هذه القماشة مُطرّزة بخرَز مُستخدَم بواسطة الملكيّين

33
00:03:16,770 --> 00:03:19,600
على شكل زهرة لا تتفتّح إلّا في تلك اللّوحة

34
00:03:20,080 --> 00:03:24,640
وهذه لفراء وحش يظهر فقط
في يوم شمس مُنتصف اللّيل

35
00:03:25,220 --> 00:03:26,060
أجل

36
00:03:26,060 --> 00:03:27,510
وهذه القماشة أيضاً

37
00:03:27,510 --> 00:03:31,470
أجل. إنّه مصبوغ بالماء المُقدّس
من دولة الثّلج، لذا هو نابض بالحيويّة

38
00:03:31,470 --> 00:03:33,840
واللّون لا يتلاشى، مهما غسلتِه من مرّات

39
00:03:32,960 --> 00:03:36,430
لم أتوقّع أن يحضر كُلّ هذه الكمّية
في اليوم المُوالي مُباشرة

40
00:03:36,430 --> 00:03:40,860
هيّا! ماذا أحضر لكِ يا روز، ساحرة البُحيرة؟

41
00:03:42,070 --> 00:03:45,530
بالمُناسبة، المُفضّل لديّ سيكون غالباً
هذا ذا اللّون الخُزاميّ

42
00:03:45,530 --> 00:03:47,690
!أجل، سيليق بكِ كثيراً

43
00:03:48,490 --> 00:03:51,700
لكن للأمانة، أريدكِ حقّاً أن ترتدي
...واحداً ورديّاً، إنّما

44
00:03:51,700 --> 00:03:53,160
!قطعاً لا

45
00:03:53,160 --> 00:03:56,190
أجل، توقّعتُ هذا. كنتُ أعلم

46
00:03:56,190 --> 00:03:58,120
هذا بالضّبط ما أتحدّث عنه يا روز

47
00:03:58,480 --> 00:04:00,710
هـ-هذا الرّجل

48
00:04:00,710 --> 00:04:03,690
هل أعدّ العِلاج الّذي يجعل حتّى الوحوش
السّوداء تقطع لِسانه{?}

49
00:04:03,690 --> 00:04:06,020
عندما تُوضَع في زاوية منزل؟

50
00:04:06,020 --> 00:04:09,620
...لا، قد يكون من الأفضل حتّى استعمال هذا

51
00:04:10,280 --> 00:04:13,020
لا، لا. أعتقد سيكون هذا مُبالغاً به

52
00:04:14,160 --> 00:04:17,230
لماذا لم تُحضر سوى الألوان المُبهرَجة؟

53
00:04:17,230 --> 00:04:18,940
...تسألين هذا، لكن

54
00:04:19,510 --> 00:04:21,770
روز، الّتي لم ترتدِ سوى ملابس
،مُستعملة حصلتْ عليها من أمّها

55
00:04:21,770 --> 00:04:24,990
مُدّعيةً بأنّها ما زالت قابلة للاستعمال، ولم تُبدِ
!ذرّة اهتمام في تجميل نفسها

56
00:04:24,990 --> 00:04:27,370
وحتّى عندما حصلتِ على لقب
،"ساحرة البُحيرة"

57
00:04:27,370 --> 00:04:30,870
اقترحتُ بشدّة أن تطرّزي لِباساً
!حسناً لنفسكِ، ولم تفعلي

58
00:04:30,870 --> 00:04:32,580
!نحن نتكلّم عن تلك

59
00:04:33,240 --> 00:04:34,790
!لكنّكِ مُهتمّة الآن

60
00:04:35,180 --> 00:04:38,500
فكيف لي ألّا أطلق العنان؟

61
00:04:39,740 --> 00:04:42,750
على رسلكِ، ليس عليكِ القلق بشأن الكمّية

62
00:04:42,750 --> 00:04:46,500
تأخّر الوقت، لكن اسمحي لي أن أعطيكِ
هذا كهديّة احتفال

63
00:04:47,130 --> 00:04:50,840
لذا، اختاري زيّاً هنا، ومُفاجأة، اجعليه ظريفاً

64
00:04:50,840 --> 00:04:52,650
ماذا تقصد بـ"ظريف"؟

65
00:04:53,160 --> 00:04:58,100
لا بُدّ أنّني توقّفتُ في الزّمن عند
عشر سنوات في نظر تيين

66
00:04:58,640 --> 00:05:01,090
التقينا أوّل مرّة خلف تنّورة جدّتي

67
00:05:01,460 --> 00:05:05,410
قبل ذلك، كان والد تيين يأتي
لمُمارسة العمل فالتقيتُ بتيين

68
00:05:05,410 --> 00:05:07,670
عندما قرّرَ تولّي الأمور

69
00:05:08,840 --> 00:05:12,860
،عندما تُوفّيت جدّتي أيضاً
،لولا عائلة كونغ

70
00:05:12,860 --> 00:05:15,490
لما تمكّنتُ غالباً من منحها دفناً مُناسباً

71
00:05:15,810 --> 00:05:18,350
كلاهما كانا لطيفين جدّاً معي

72
00:05:21,560 --> 00:05:26,480
،لهذا السّبب عندما يقول كلاماً كهذا
فمن الصّعب عليّ أن أردّ بكلام مُسيئ

73
00:05:27,210 --> 00:05:29,180
هيّا، ماذا ستختارين؟

74
00:05:29,500 --> 00:05:32,890
لا أعرف أن أقيس ظرافة أو جمال
...الملابس، لكن

75
00:05:32,890 --> 00:05:37,100
ما أعرفه هو أنّ هناك أشياء يستحيل لي
أن ألبسها أثناء خلط عِلاجاتي

76
00:05:37,340 --> 00:05:40,690
مُجرّد حقيقة معرفتكِ بذلك تُثبت بأنّكِ تحسّنتِ

77
00:05:40,690 --> 00:05:42,250
،عندما يتعلّق الأمر بكِ وبالملابس

78
00:05:42,250 --> 00:05:44,820
كنتِ تُوسّخين أيّ شيء ترتدينه
دون أدنى تفكير

79
00:05:44,820 --> 00:05:47,040
!لا تتكلّم كما لو أنّني لا أتمتّع بذرّة إدراك

80
00:05:47,040 --> 00:05:48,570
!لم أكن مُهتمّة فحسب

81
00:05:48,570 --> 00:05:51,240
لا تتكلّمي كما لو أنّكِ تتمتّعين بإدراك

82
00:05:51,240 --> 00:05:55,030
رغم ذلك، يسرّني أن أرى اهتمامكِ
بالأمر ولو قليلاً

83
00:05:55,030 --> 00:05:58,380
...ليس وكأنّني لستُ كذلك إطلاقاً

84
00:06:01,750 --> 00:06:03,890
ماذا؟ أيراودكِ فضول حيال هذا؟

85
00:06:03,890 --> 00:06:05,210
لنُجرّب إلباسكِ إيّاه

86
00:06:04,710 --> 00:06:05,420
توقّف

87
00:06:06,530 --> 00:06:08,140
تيين، توقّف أرجوك

88
00:06:10,350 --> 00:06:13,590
هذا عمليّاً بمثابة إخباره بأنّه
!يُراودني فضول حياله

89
00:06:14,590 --> 00:06:16,450
لكن لا أستطيع

90
00:06:16,450 --> 00:06:18,920
،أنا متأكّدة بإنّني طلبتُ تطريز رِداء من هذا

91
00:06:18,920 --> 00:06:22,380
فسيبدو غالباً وكأنّني مُغلَّفة بعباءته

92
00:06:23,590 --> 00:06:25,600
قد أبدأ بإساءة الفهم

93
00:06:25,600 --> 00:06:28,480
...قد أبدأ برؤية حلم كهذا و

94
00:06:31,410 --> 00:06:33,070
انظري هنا

95
00:06:33,070 --> 00:06:34,910
هذا هو اللّون الّذي يليق بكِ

96
00:06:36,360 --> 00:06:39,770
،هذا القماش وهذا قد يبدوان جافّين قليلاً

97
00:06:39,770 --> 00:06:43,080
لكن نُسِجَ بهذه الطّريقة عمداً
لجعله يبدو كزهرة

98
00:06:43,450 --> 00:06:45,540
سترينه بشكل أوضح عندما تكونين
تحت أشعّة الشّمس

99
00:06:45,910 --> 00:06:49,520
،لا أخرج تحت أشعّة الشّمس كثيراً
لذا لا أُمانع شيئاً آمناً وبسيطاً

100
00:06:49,910 --> 00:06:51,460
إذاً هذا اللّون سيكون مُناسباً

101
00:06:51,820 --> 00:06:55,690
يُدعى بالأزرق الزبرجديّ، وهو لون
الغابة الّذي تُحبّينه

102
00:06:56,520 --> 00:06:59,080
لون الغابة المُنعكسة في البُحيرة

103
00:06:59,390 --> 00:07:00,830
!لنعتمد هذا

104
00:07:00,830 --> 00:07:03,370
،خيوط الحرير والذّهب قد حيكَتْ به عندما صُنِع

105
00:07:03,370 --> 00:07:06,730
،لذا عندما يُسلّط عليه ضوء المصباح
فإنّه يبدو جميلاً أخّاذاً

106
00:07:07,020 --> 00:07:10,420
ليس وكأنّني أريد أن أُري الآخرين
مدى جماله أو من هذا القبيل

107
00:07:10,420 --> 00:07:15,700
اسمعي، حتّى لو لم تُريدي، أنا مُلزَم
بشرح مُنتجاتي، اتّفقنا؟

108
00:07:19,710 --> 00:07:22,480
بما أنّنا نفعل ذلك، ما رأيكِ بمُرطّب للشّفاه
وأحمر الخدود أيضاً؟

109
00:07:22,480 --> 00:07:23,920
سيُبرز ذلك ملامحكِ وبشرتكِ

110
00:07:23,920 --> 00:07:27,120
إذا كانت البشرة، فمُجرّد صفع خدَّي يكفي

111
00:07:27,120 --> 00:07:29,610
لا أتحمّل رؤية ساحرتي الظّريفة

112
00:07:29,610 --> 00:07:32,360
تستمرّ في صفع خدّيها هكذا

113
00:07:32,360 --> 00:07:36,500
لديكِ بشرة جميلة، لذا لون الورديّ ذي درجة
هادئة سيليق بكِ كثيراً

114
00:07:36,500 --> 00:07:38,980
...حتّى لو اشتريتُه، متى سوف

115
00:07:39,280 --> 00:07:41,100
لا أريد مالاً

116
00:07:41,100 --> 00:07:43,430
أريد شراءه لأجلكِ يا روز

117
00:07:45,430 --> 00:07:47,450
والآن، ماذا تختارين؟

118
00:07:47,450 --> 00:07:50,080
هذا الحجر الكريم هنا هو الّذي يعرفه
الجميع في العاصمة الملكيّة

119
00:07:49,250 --> 00:07:50,960
لا جدوى من مُحاولة منعه

120
00:07:50,080 --> 00:07:51,970
...وهو أحدث صيحات الموضة

121
00:07:50,960 --> 00:07:52,520
سأعود إلى العمل

122
00:08:44,420 --> 00:08:49,380
إذا بدأتُ بارتداء رِداء جديد كُلّياً
فسيغدو ذلك مكشوفاً تماماً

123
00:09:09,710 --> 00:09:10,850
حسناً

124
00:09:19,420 --> 00:09:23,410
...عشرة، تسعة، ثمانية، سبعة

125
00:09:25,380 --> 00:09:28,840
أربعة، ثلاثة، اثنان

126
00:09:33,960 --> 00:09:38,420
مرحباً. هل تمكّنت من الحصول على
الأشياء الّتي طلبتُها؟

127
00:09:38,630 --> 00:09:39,640
أجل

128
00:09:52,720 --> 00:09:54,020
تفقّديها من فضلكِ

129
00:10:03,610 --> 00:10:06,730
المعذرة، هل أنت مُرهَق؟

130
00:10:06,730 --> 00:10:10,230
لديّ عِلاج يُخفّف الإعياء فوراً

131
00:10:10,230 --> 00:10:11,570
لستُ بحاجة له

132
00:10:11,940 --> 00:10:14,110
نظرة الشكّ تلك في وجهه

133
00:10:14,110 --> 00:10:16,510
ألا يُؤمن بعِلاجات السّاحرة السّرّية؟

134
00:10:19,000 --> 00:10:21,610
إذاً لماذا يطلب جرعةَ حُبّ؟

135
00:10:21,610 --> 00:10:27,230
وكأنّني لم أُفكِّر مليّاً في أسباب
رغبته في جرعة حُبّ

136
00:10:29,520 --> 00:10:32,120
كنتُ مُحقّة. يسرّني أنّني لم أضع
مُرطِّب الشِّفاه

137
00:10:43,660 --> 00:10:44,660
ما الّذي يجري؟

138
00:10:46,540 --> 00:10:48,830
ألا يمكنكِ أن تُرتّبي قليلاً؟

139
00:10:51,290 --> 00:10:55,930
مع الأسف، لا أملك سحراً يُرتّب غرفةً تلقائيّاً

140
00:10:56,410 --> 00:10:58,250
يمكنكِ استخدام يديكِ فحسب، أليس كذلك؟

141
00:10:59,470 --> 00:11:04,050
لعلّ هاتين اليدين تستطيعان استخدام
سحر، لكن لا تستطيعان التّرتيب

142
00:11:04,050 --> 00:11:05,600
لأنّني ساحرةٌ في نهاية المطاف

143
00:11:06,100 --> 00:11:08,020
لأنّني... ساحرةٌ في نهاية المطاف

144
00:11:09,140 --> 00:11:11,230
ما هذا؟

145
00:11:11,230 --> 00:11:14,890
ماذا؟! هذا خسٌّ مضى عليه أيّام قليلة

146
00:11:16,780 --> 00:11:20,370
آنسة ساحرة، يبدو دوماً أنّكِ
لا تأكلين سِوى الخسّ

147
00:11:20,370 --> 00:11:21,630
هل هو تفضيل لديكِ؟

148
00:11:21,630 --> 00:11:25,660
لا. كُلّ ما في الأمر هو أنّ الخسّ هو الخُضار
الوحيد الّذي يُزرَع في رقعة الحديقة

149
00:11:25,660 --> 00:11:27,950
فأساساً، يمكنك أكله حتّى دون طبخه

150
00:11:28,790 --> 00:11:29,710
ماذا؟

151
00:11:31,850 --> 00:11:33,000
ماذا؟

152
00:11:33,320 --> 00:11:34,950
قالَها مرّتان

153
00:11:35,260 --> 00:11:37,510
لم تكوني تأكلين غير الخسّ؟

154
00:11:37,510 --> 00:11:41,100
أنا آكل أشياء أُخرى متى دخلتُ
...البلدة، لكن

155
00:11:41,100 --> 00:11:42,920
أجل، جوهريّاً

156
00:11:58,760 --> 00:12:01,780
ساق دجاجة فيها لحم أكثر من هذه

157
00:12:01,780 --> 00:12:03,480
هذا كلام فارغ

158
00:12:06,320 --> 00:12:08,360
هاريج-ساما ينظر إليّ

159
00:12:08,360 --> 00:12:10,690
إنّه قريبٌ جدّاً. رموشه طويلة، ووجهه وسيم

160
00:12:10,690 --> 00:12:13,830
لا أصدّق بأنّني أستطيع التنعُّم بملامح
...وجه من مسافة مُباشرة

161
00:12:17,630 --> 00:12:18,900
المعذرة

162
00:12:18,900 --> 00:12:19,840
لا عليك

163
00:12:23,510 --> 00:12:26,700
حاليّاً، سأواصل باستخدام المُكوّنات الّتي تلقّيتُها

164
00:12:26,700 --> 00:12:28,760
من فضلك عُد ثانية بعد شهر

165
00:12:30,020 --> 00:12:31,980
سيستغرق ذلك وقتاً طويلاً ثانية، صحيح؟

166
00:12:32,020 --> 00:12:35,980
مرحباً، أنا ساحرة
وحبيبي يريدني أن أصنع جرعةَ حُبّ

167
00:12:35,980 --> 00:12:38,990
وحبيبي يريدني أن أصنع جرعةَ حُبّ

168
00:12:35,980 --> 00:12:38,990
مرحباً، أنا ساحرة

169
00:12:46,470 --> 00:12:48,850
أشعر وكأنّنا في الصّيف الآن

170
00:12:49,700 --> 00:12:54,190
مؤخّراً، بدأتُ أستحمّ أكثر، حتّى
لو كان ذلك شاقّاً

171
00:12:59,900 --> 00:13:02,170
لا بُدّ وأنّ السّبب هو لأنّ الحرّ أصبح شديداً

172
00:13:02,170 --> 00:13:04,080
ليس وكأنّه يوجد سبب وراء ذلك

173
00:13:06,880 --> 00:13:09,000
...شهر واحد

174
00:13:09,300 --> 00:13:14,410
مدّة شهر هي الوقت الفعليّ المطلوب
لمُعالجة لمُعالجة المواد

175
00:13:14,980 --> 00:13:18,730
إلى ذلك الحين، لن يأتي هاريج-ساما إلى هنا

176
00:13:20,300 --> 00:13:24,660
وأنا هنا الّتي ظننتُ بأنّني ماهرة
في إخفاء مشاعري أيضاً

177
00:13:24,930 --> 00:13:27,120
عشتُ حياتي كُلّها أتكتّم على ذلك

178
00:13:27,120 --> 00:13:28,900
لأنّني ساحرة

179
00:13:29,400 --> 00:13:32,650
هناك سبب وراء قدرة السّاحرات فقط
على إنشاء عِلاجات ذات فعاليّة

180
00:13:32,650 --> 00:13:35,140
تفوق ما يقدر على إنتاجه البشر بكثير

181
00:13:35,910 --> 00:13:40,690
السّبب هو لأنّ السّاحرة الّتي تستخدم كذبةً تُعرَف
بالسّحر، لا تستطيع استخدام أيّ نوع كذبة آخر

182
00:13:41,260 --> 00:13:44,120
سبب كوننا غير اجتماعيّات ومشؤومات

183
00:13:44,120 --> 00:13:46,880
هو لمنع الآخرين من معرفة بأنّنا
لا نستطيع أن نكذب

184
00:13:47,420 --> 00:13:50,960
كُلّ هذا هو لإبعاد الآخرين

185
00:13:51,510 --> 00:13:57,000
رغم أنّنا لا نستطيع أن نكذب، ما زال بمقدورنا
إخفاء الحقيقة أو حرف مسار المُحادثة

186
00:13:57,450 --> 00:14:00,850
حتّى الآن، هكذا تمكّنتُ من النّجاة من تلقاء نفسي

187
00:14:01,620 --> 00:14:06,570
وسأستمرّ في العيش هكذا للأبد، بمُفردي

188
00:14:14,780 --> 00:14:15,620
!حسناً

189
00:14:15,620 --> 00:14:18,070
الطّقس جميل، لذا سأغسل قميصي
!الدّاخليّ أيضاً

190
00:14:36,970 --> 00:14:38,360
هل هو غزال؟

191
00:14:38,360 --> 00:14:40,350
هل هو ذلك الغزال المعتدّ بنفسه ثانية؟

192
00:14:38,480 --> 00:14:40,350
اعتداد بالنّفس

193
00:14:41,610 --> 00:14:42,460
ماذا؟

194
00:14:54,420 --> 00:14:55,770
!ا-المعذرة

195
00:15:06,160 --> 00:15:08,580
!هل رآني؟ لقد رآني. رآني

196
00:15:08,800 --> 00:15:13,470
لا أصدِّق بأنّ هاريج-ساما، بالتّحديد، سيَراني
،ببشرتي الشّاحبة

197
00:15:13,470 --> 00:15:16,060
!وقوامي الهزيل غير المُقيّد بمشدّ حتّى

198
00:15:16,060 --> 00:15:18,010
!بالأحرى، لماذا هو هنا؟

199
00:15:18,010 --> 00:15:21,110
لم يمضِ شهرٌ بعد حتّى، ونحن
!في مُنتصف اليوم

200
00:15:23,890 --> 00:15:26,010
حاليّاً، دعني أرتدي رداءً على الأقلّ

201
00:15:39,500 --> 00:15:41,220
شكراً على الانتظار

202
00:15:41,220 --> 00:15:42,750
تعال إلى هنا من فضلك

203
00:15:51,460 --> 00:15:53,670
أعتذر حقّاً بشأن ما حدث قبل قليل

204
00:15:53,670 --> 00:15:56,220
لا، أنا من يجب عليه الاعتذار

205
00:15:56,220 --> 00:15:59,130
لم أتخيّل أبداً أن تأتي إلى هنا الآن
يا هاريج-ساما

206
00:16:01,010 --> 00:16:03,440
تعرفين من أكون؟

207
00:16:04,900 --> 00:16:06,230
!بئساً

208
00:16:06,230 --> 00:16:08,600
لم يعرّف هاريج-ساما عن اسمه من قبل

209
00:16:10,630 --> 00:16:12,280
تعرفين، أليس كذلك؟

210
00:16:12,940 --> 00:16:15,550
أجل. أجل، أعرف

211
00:16:15,550 --> 00:16:16,730
منذ متى؟

212
00:16:18,050 --> 00:16:20,710
لا أجد المُبرّر المُناسب لتجنُّب السّؤال

213
00:16:21,250 --> 00:16:22,800
سأدعكِ تُجيبينني

214
00:16:23,900 --> 00:16:25,400
قبل أربع سنوات

215
00:16:25,400 --> 00:16:27,010
كُلّ هذه المدّة الطّويلة؟

216
00:16:29,970 --> 00:16:32,630
!المعذرة، ارحمني أرجوك

217
00:16:32,630 --> 00:16:35,780
لن أفصح أبداً عن معلومات زبوني
!العزيز لأيّ شخص

218
00:16:35,780 --> 00:16:39,130
!أ-أنا الآن في وضع شاذّ تماماً

219
00:16:39,130 --> 00:16:40,870
!أُعاني من مُشكلة ما

220
00:16:40,870 --> 00:16:42,120
...إذا طُرِح عليّ المزيد من الأسئلة

221
00:16:42,120 --> 00:16:42,960
ماذا؟

222
00:16:43,630 --> 00:16:47,860
ينفد الأكسجين لديّ. رأسي يدور

223
00:16:48,510 --> 00:16:49,570
ماذا تقصدين بذلك؟

224
00:16:50,960 --> 00:16:54,540
هاريج-ساما ينظر إليّ. إنّه يُحدّق بي

225
00:16:55,700 --> 00:16:57,430
...سـ-ساحرات

226
00:16:57,430 --> 00:17:01,910
مُقابل استخدام السّحر، لا تستطيع
!السّاحرات الكذِب

227
00:17:02,230 --> 00:17:04,110
لا تستطيع الكذِب؟

228
00:17:04,370 --> 00:17:05,580
انتهى الأمر

229
00:17:05,870 --> 00:17:07,900
،كشفتُ حتّى سرَّ السّاحرات

230
00:17:07,900 --> 00:17:10,550
وهو الشّيء الّذي يجب علينا ألّا
نفصح عنه لأحد

231
00:17:11,080 --> 00:17:12,400
—ما الّذي

232
00:17:12,400 --> 00:17:14,850
!من فضلك! أنا آسفة حقّاً

233
00:17:14,850 --> 00:17:16,510
...لـ-لا أستطيع ذِكر المزيد

234
00:17:18,460 --> 00:17:22,010
أتفهّم بأنّ لديكِ أسبابكِ الخاصّة
يا آنسة ساحرة

235
00:17:22,460 --> 00:17:26,220
لكن كفارِس، لديّ أسئلة يجب
أن أطرحها كذلك

236
00:17:26,520 --> 00:17:31,550
إذا استمرّ في سؤالي هكذا، فسينتهي
المطاف بإخباري كُلّ شيء لهاريج-ساما

237
00:17:31,550 --> 00:17:35,040
...بعد معرفتي من أربع سنوات مضتْ

238
00:17:35,320 --> 00:17:38,980
لا يسعني فعل شيء الآن بعد
أن عرف نقطة ضعف السّاحرة

239
00:17:39,740 --> 00:17:43,660
لكن ماذا لو اكتشفَ مشاعري تجاهه؟

240
00:17:44,250 --> 00:17:47,220
ماذا لو عَلمَ بأنّ ساحرةً تعيسة وضعيفة وبغيضة

241
00:17:47,220 --> 00:17:51,930
وقعتْ في حُبّ رجل جميل وقويّ ونبيل مثله؟

242
00:17:52,460 --> 00:17:54,870
إن كان الأمر كذلك، فأُفضِّل الموت

243
00:17:55,710 --> 00:17:56,340
!مهلاً

244
00:17:58,280 --> 00:18:01,380
كان من الواضح أنّني نسيتُ الأمر برمّته

245
00:18:01,760 --> 00:18:04,340
ذلك النّوع من العِلاجات هو اختصاصي

246
00:18:06,260 --> 00:18:08,720
فأنا ساحرة في نهاية المطاف

247
00:18:10,160 --> 00:18:11,690
!ماذا تفعلين؟

248
00:18:18,820 --> 00:18:21,820
...لـ-ليس وكأنّني امرأة شبِقة! أنا ساحرة، و

249
00:18:21,820 --> 00:18:22,680
!هذا صحيح

250
00:18:22,680 --> 00:18:25,650
مُعظم مُكتسباتي تُنفَق على مُكوّنات
،لدُفعة العِلاجات التّالية

251
00:18:25,650 --> 00:18:28,730
وبما أنّني غير مُبالية لمظهري، لا أملك
—ملابسَ احتياطيّة

252
00:18:27,870 --> 00:18:30,030
فهمت. مهلاً، أعتذر

253
00:18:30,030 --> 00:18:31,330
من أعماق قلبي

254
00:18:31,330 --> 00:18:34,670
أفهم بوضوح بأنّ كُلّ هذا قد أثّر
عليكِ بعمق يا آنسة ساحرة

255
00:18:49,100 --> 00:18:50,340
المعذرة

256
00:18:53,490 --> 00:18:55,310
...فـ-في الواقع

257
00:18:55,580 --> 00:19:00,250
أقدِّم اعتذاري لأنّني تسبّبتُ بكشفكِ سرّاً
قد يدفعكِ لاختيار الموت

258
00:19:00,560 --> 00:19:04,480
بالطّبع، سأتكتّم على ما حدث قبل قليل سرّاً

259
00:19:04,480 --> 00:19:06,500
لن أتفوّه بأي كلمة لأحد

260
00:19:06,500 --> 00:19:07,650
كفارِس، أُقسم بذلك

261
00:19:07,900 --> 00:19:09,050
عسى أن تُصدِّقيني

262
00:19:12,420 --> 00:19:14,770
كيف عرفتَ بأنّه كان سُمّاً؟

263
00:19:14,770 --> 00:19:17,420
،لم أعرف نوعيّته كعِلاج

264
00:19:17,420 --> 00:19:19,430
لكن تذكّرتُ بأنّني رأيتُ تلك
النّظرة في عينيكِ

265
00:19:19,630 --> 00:19:23,630
النّاس الّذين يشعرون بأنّهم مُحاصَرون غالباً
ما ترتسم تلك النّظرة في وجوههم

266
00:19:24,030 --> 00:19:26,610
لذا، يسرّني أنّني فعلتُها في الوقت

267
00:19:27,000 --> 00:19:29,370
هذا صحيح

268
00:19:29,370 --> 00:19:31,760
هذه هي طبيعة هاريج-ساما

269
00:19:32,180 --> 00:19:36,550
شخص  لطيف يهتمّ حتّى بحياة مُجرّد ساحرة

270
00:19:41,860 --> 00:19:43,560
هل هدأتِ قليلاً؟

271
00:19:44,990 --> 00:19:46,660
أنا مسرورٌ إذاً

272
00:19:46,660 --> 00:19:49,840
انتهى المطاف بأكلي كُلّ هذا بمُفردي

273
00:19:52,910 --> 00:19:54,130
خبز

274
00:19:54,130 --> 00:19:56,720
،لم تكوني تأكلين طعاماً مُغذّياً

275
00:19:56,720 --> 00:19:58,080
لم تأكلي سِوى الخسّ

276
00:19:58,530 --> 00:20:00,680
...على أيّ حال، أنتِ

277
00:20:00,680 --> 00:20:05,310
شابّة، لذا تحتاجين لزيادة وزنكِ قليلاً

278
00:20:05,310 --> 00:20:07,090
إنّه قلقٌ عليّ

279
00:20:05,850 --> 00:20:07,880
على أيّ حال، أنتِ تتعاملين مع العِلاجات

280
00:20:07,610 --> 00:20:10,760
حتّى ولو لوهلة فقط، لقد فكّرَ فيّي

281
00:20:07,880 --> 00:20:10,750
...تُواجهين خطراً أكبر من الشّخص العاديّ

282
00:20:10,760 --> 00:20:14,200
هذه هي البهجة

283
00:20:10,770 --> 00:20:14,030
،وإذا مرضتِ بهذا الجسد الخالي من اللّحم
فلن تنجي

284
00:20:14,970 --> 00:20:16,540
يبدو شهيّاً

285
00:20:16,540 --> 00:20:17,730
شكراً لك

286
00:20:17,730 --> 00:20:18,430
!انتظري

287
00:20:18,430 --> 00:20:20,120
هل تنوين أكله هناك؟

288
00:20:20,120 --> 00:20:22,270
ماذا؟ كنتُ كذلك؟

289
00:20:22,270 --> 00:20:25,170
أوّلاً، فرِّغي هذه الطّاولة

290
00:20:29,100 --> 00:20:31,650
—لهذا السّبب النُّبلاء

291
00:20:31,650 --> 00:20:33,130
أسمعك

292
00:20:33,130 --> 00:20:34,670
أنا أحرص على أن تسمعني

293
00:20:45,660 --> 00:20:47,100
نيّق جدّاً

294
00:20:47,100 --> 00:20:48,670
من يعتقد نفسه؟ حماتي؟

295
00:20:50,220 --> 00:20:51,680
حسناً، أعتقد هذا مُناسب

296
00:20:52,130 --> 00:20:53,860
يسرّني سماع ذلك

297
00:20:57,380 --> 00:20:59,930
مـ-ماذا؟ لا تزال هناك بعض الأوساخ؟

298
00:20:59,930 --> 00:21:01,280
في وجهي؟ هل هو وجهي؟

299
00:21:01,280 --> 00:21:03,200
!لا يسعني فعل شيء حيال ذلك

300
00:21:03,580 --> 00:21:04,740
ألن تجلسي؟

301
00:21:04,740 --> 00:21:06,690
حـ-حسناً

302
00:21:17,390 --> 00:21:19,080
إنّه ليس وهماً

303
00:21:19,450 --> 00:21:22,460
هاريج-ساما يقف أمامي

304
00:21:22,460 --> 00:21:24,460
لم أتخيّل أن يأتي يومٌ كهذا أبداً

305
00:21:28,770 --> 00:21:29,780
ما الأمر؟

306
00:21:30,430 --> 00:21:33,590
لا. لستُ معتادة على هذا فحسب

307
00:21:33,590 --> 00:21:35,140
هل هذه زبدة؟

308
00:21:35,140 --> 00:21:37,090
يبدو أنّها زبدة تفّاح

309
00:21:37,090 --> 00:21:38,860
سمعتُ بأنّ مذاقها شهيّ عندما تُدهن على خبزة

310
00:21:38,860 --> 00:21:42,310
أحبُّ التُفّاح، لذا هذا يُسعدني

311
00:21:42,310 --> 00:21:44,310
فهمت. تفضّلي

312
00:21:44,310 --> 00:21:45,780
شكراً لك

313
00:21:51,040 --> 00:21:53,190
رائحة تُفّاح حُلوة