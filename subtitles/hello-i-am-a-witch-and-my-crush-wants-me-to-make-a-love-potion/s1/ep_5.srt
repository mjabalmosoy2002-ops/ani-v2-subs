1
00:00:02,470 --> 00:00:06,520
ما إن صرخت الفتاة، "لا أستطيع
"،الذّهاب إلى الحفل الرّاقص هكذا

2
00:00:06,520 --> 00:00:09,170
لوّحت السّاحرةُ بعصاها

3
00:00:09,660 --> 00:00:13,250
،بلمح البصر، تحوّل اليقطين إلى عربة

4
00:00:13,250 --> 00:00:15,810
وأصبحت ملابسها المُهترئة فُستاناً

5
00:00:16,210 --> 00:00:18,820
—ثمّ تابعت السّاحرةُ وأعطتها

6
00:00:18,820 --> 00:00:21,150
هذه السّاحرة غريبة أطوار

7
00:00:21,150 --> 00:00:22,170
غريبة؟

8
00:00:22,170 --> 00:00:26,750
لماذا تُقدّم لها عربةً وفُستاناً دون
الحصول على شيء مُقابلهما؟

9
00:00:28,190 --> 00:00:29,940
من يدري؟

10
00:00:29,940 --> 00:00:31,540
لماذا برأيكِ يا روز؟

11
00:00:32,390 --> 00:00:34,410
لأنّها ستدفع ثمنَ ذلك لاحقاً؟

12
00:00:34,410 --> 00:00:37,580
!عبقريّة! يا لكِ من فتاة! ظريفة للغاية

13
00:00:37,580 --> 00:00:40,480
كُفّ عن ذلك. أجبني كما ينبغي فحسب

14
00:00:40,810 --> 00:00:45,730
ربّما كانت تلك الفتاة طيّبة وأحبّتْها كثيراً

15
00:00:46,190 --> 00:00:47,340
...فضلاً عن ذلك

16
00:00:48,470 --> 00:00:50,300
لعلّها كانت ساحرة جيّدة

17
00:00:50,600 --> 00:00:52,820
ساحرة جيّدة؟

18
00:00:54,470 --> 00:00:56,550
لا توجد ساحرات جيّدات أو سيّئات

19
00:00:56,550 --> 00:01:00,470
وُجِدت السّاحرات ببساطة تمنح
الأُمنيات مُقابل ثمن

20
00:01:00,470 --> 00:01:02,240
فنحن نعمل بالمُقايضة المُتكافئة

21
00:01:03,950 --> 00:01:05,340
بكلّ تأكيد

22
00:01:06,150 --> 00:01:07,800
توقّف عن ذلك

23
00:01:07,800 --> 00:01:10,460
أليست لديك قصص أنسب عن السّاحرات؟

24
00:01:10,460 --> 00:01:14,800
زبونتي الصّغيرة طلباتها صعبة
جدّاً حسبما أرى

25
00:01:14,800 --> 00:01:19,140
وأليس عملك هو تلبية تلك
الطّلبات الصّعبة يا تيين؟

26
00:01:19,140 --> 00:01:23,770
إذاً سأروي قصّةَ ساحرة تعيش
على ضفّة بُحيرة؟

27
00:01:24,190 --> 00:01:28,860
،تلك السّاحرة تُنقذ النّاس وتُرشدهم أحياناً

28
00:01:28,860 --> 00:01:31,230
وتتغذّى على رغباتهم في أحيان أُخرى

29
00:01:31,230 --> 00:01:33,330
تلك السّاحرة ليست غريبة أطوار

30
00:01:33,690 --> 00:01:35,770
ساحرتي الظّريفة

31
00:01:36,210 --> 00:01:39,140
أتساءل أيّ نوع من السّاحرات ستُصبحين

32
00:01:53,050 --> 00:01:58,090
مرحباً، أنا ساحرة

33
00:01:53,050 --> 00:01:58,090
وحبيبي يريدني أن أصنع جرعةَ حُبّ

34
00:03:12,000 --> 00:03:15,970
الحلقة 5: أن تكوني ساحرة

35
00:03:20,410 --> 00:03:24,590
أصبحتِ ساحرة حقيقيّة، أليس كذلك؟

36
00:03:24,940 --> 00:03:27,060
ماذا تقصد بذلك؟

37
00:03:27,060 --> 00:03:31,260
في الواقع، قصدتُ ذلك كمديح
على طريقتي الخاصّة

38
00:03:31,780 --> 00:03:34,790
يبدو أنّكِ تُبقين نفسكِ مُنشغلة جدّاً مؤخّراً

39
00:03:34,790 --> 00:03:36,320
ليس تماماً

40
00:03:36,320 --> 00:03:39,950
العمل الّذي كنتُ أقوم به لفترة طويلة
على وشك أن ينتهي قريباً أيضاً

41
00:03:39,950 --> 00:03:43,150
يسرّني سماع ذلك

42
00:03:57,420 --> 00:03:59,330
تفضّل الشّاي

43
00:03:59,330 --> 00:04:03,850
شكراً لكِ. يا له من لون ورائحة غير مألوفتين

44
00:04:03,850 --> 00:04:08,590
أجل، جرّبتُ إضافة الحليب وغيّرتُ
أوراقَ الشّاي والتّوابل

45
00:04:08,590 --> 00:04:12,800
حقّاً؟ فعلتِ ذلك رغم عدم اهتمامكِ
بوجبات الطّعام؟

46
00:04:19,490 --> 00:04:21,630
أجل. إنّه بدرجة حرارة مُناسبة

47
00:04:21,630 --> 00:04:25,130
عندما يبرد الجوّ، من اللّطيف تناول شيء دافئ

48
00:04:25,700 --> 00:04:28,660
لا تُعلِّق على الدّفء فحسب. ما رأيك بالمذاق؟

49
00:04:30,830 --> 00:04:32,830
إنّه لذيذٌ بالطّبع

50
00:04:32,830 --> 00:04:35,570
أصبح الجوّ أبرد بشكل ملحوظ مؤخّراً

51
00:04:35,570 --> 00:04:37,790
كُفّ عن الحديث عن الحرارة

52
00:04:37,790 --> 00:04:40,910
كلام فارغ، من المُهمّ الحديث
عن درجة الحرارة

53
00:04:40,910 --> 00:04:42,880
إنّه الشّتاء تقريباً، أليس كذلك؟

54
00:04:42,880 --> 00:04:47,670
إنّها تلك الفترة من العام والّتي يشتكي
فيها كبار السنّ من آلام الظّهر والكتف

55
00:04:47,670 --> 00:04:50,610
لهذا السّبب أردتُ تخزين كمّيات
كبيرة من الكمّادات

56
00:04:51,260 --> 00:04:53,990
،وهناك تحضيرات أيضاً للخضراوات الشّتائيّة

57
00:04:53,990 --> 00:04:56,480
لذا أحتاج عِلاجات للتخلُّص من الحشرات

58
00:04:56,480 --> 00:04:58,940
وأيضاً مُنوَّعات أُخرى مثل أشياء مُصحِّية

59
00:05:00,690 --> 00:05:03,770
،أعي تماماً بأنّ ما أطلبه منكِ غير منطقيّ

60
00:05:03,770 --> 00:05:05,430
لكن هذه هي طلباتي

61
00:05:05,430 --> 00:05:06,530
أتعتقدين بأنّكِ تستطيعين تلبيتها؟

62
00:05:09,640 --> 00:05:12,440
إذا ذهبتُ للتسوُّق، فأستطيع حينها
...تدبُّر الأمر بطريقة ما

63
00:05:12,440 --> 00:05:15,070
—لكن هذه الكمّية هي بعض الشّيء

64
00:05:18,790 --> 00:05:22,790
حسناً، فهمت. سأفعلها هذه المرّة

65
00:05:22,790 --> 00:05:25,040
أنا ساحرة البُحيرة الطيّبة في نهاية المطاف

66
00:05:25,520 --> 00:05:28,710
ساحرة البُحيرة... الطيّبة؟

67
00:05:28,710 --> 00:05:30,120
السّاحرة الطيّبة

68
00:05:34,330 --> 00:05:36,650
أرى بأنّه يُشكّل تأثيراً كبيراً

69
00:05:41,590 --> 00:05:43,350
أصبحتِ بالغة حقّاً

70
00:05:43,350 --> 00:05:46,740
ماذا؟ عمّاذا يتحدّث هذا الرّجل حتّى؟

71
00:05:48,190 --> 00:05:50,810
...رغم أنّني سعيد برؤيتكِ تكبرين

72
00:05:50,810 --> 00:05:55,310
أتساءل ما هو هذا الشُّعور. عندما أراكِ تبدئين
...تبتعدين أكثر فأكثر

73
00:05:57,150 --> 00:06:01,140
ربّما هذا ما يشعر به الأب

74
00:06:01,140 --> 00:06:03,460
تيين، متى أنجبت طفلاً؟

75
00:06:03,460 --> 00:06:05,600
بالفعل، متى أنجبتُ واحداً؟

76
00:06:05,600 --> 00:06:07,760
سرعان ما وجدتُ ابنتي قد نمتْ
إلى هذا الحجم

77
00:06:07,760 --> 00:06:09,100
!أنا لستُ ابنتك

78
00:06:09,100 --> 00:06:11,410
أنا متأثِّر بشدّة فحسب

79
00:06:11,410 --> 00:06:15,400
روز الّتي عرفتُها تقدّم لي الشّاي الآن

80
00:06:15,880 --> 00:06:17,010
...و

81
00:06:17,810 --> 00:06:22,530
،أن يستخدم حتّى غطاء مائدة
هذا تحسُّن ملحوظ

82
00:06:22,530 --> 00:06:23,740
أنت تُبالغ

83
00:06:23,740 --> 00:06:27,680
كنتِ تستخدمين قطعة القماش هذه قبل
أيّام أيضاً. أهي المُفضّلة لديكِ؟

84
00:06:27,680 --> 00:06:30,070
ليس وكأنّها المُفضّلة لديّ أو ما شابه

85
00:06:31,650 --> 00:06:34,010
إذاً لا بُدّ أنّها تُلائم ذوقه

86
00:06:36,080 --> 00:06:37,940
فهمت. فهمت

87
00:06:37,940 --> 00:06:42,290
أدّوا عملاً مُمتازاً باستخدام قطن عالي
الجودة لحياكة شيء بهذه الفخامة

88
00:06:42,290 --> 00:06:45,840
أحقّاً ذلك؟ لم أكن أعلم ذلك

89
00:06:45,840 --> 00:06:48,110
هل تُمانعين إذا استعرتُ هذا لبعض الوقت؟

90
00:06:48,110 --> 00:06:49,080
لا يمكنك

91
00:06:49,080 --> 00:06:51,530
...إنّه ليس لي، لذا

92
00:06:55,250 --> 00:06:57,510
فهمت. هذا مُؤسف

93
00:06:57,510 --> 00:06:59,720
كنتُ آمل أن أستخدمه كمرجِع

94
00:06:59,720 --> 00:07:03,530
،لكن حسناً، لديّ فكرة جيّدة عن تفضيلاتكِ
لذا لا مشاكل من هذه النّاحية

95
00:07:03,530 --> 00:07:06,640
كلّ ما بقي هو صندوق ملابس النّسائيّ
ومجموعة أغطية موائد مُتوافقة

96
00:07:06,640 --> 00:07:09,220
وسيكون من الجيّد امتلاك منضدة تزيين أيضاً

97
00:07:09,220 --> 00:07:11,630
أتساءل كم حماراً سأحتاج

98
00:07:11,630 --> 00:07:13,150
عمّاذا تتكلّم؟

99
00:07:13,430 --> 00:07:16,460
مهلاً، مهلاً، سيكون شيئاً يمكنك
التطلُّع له في وقت لاحق

100
00:07:17,050 --> 00:07:18,880
ستزدحم الأمور بالأعمال

101
00:07:31,460 --> 00:07:33,050
...الكثير

102
00:07:33,050 --> 00:07:34,970
هناك الكثير من الأعمال

103
00:07:35,670 --> 00:07:40,010
،كمّادات طبّية، عِلاجات لقتل الحشرات
وعِلاجات للصحوة

104
00:07:40,010 --> 00:07:42,690
و... جرعة الحُبّ

105
00:07:50,710 --> 00:07:53,760
حالما تكتمل الجرعة، سيترتّب
عليّ إعادة هذا أيضاً

106
00:07:57,390 --> 00:08:01,110
...إذا صُنِعت الجرعة، فهو لن يأتي بعد الآن

107
00:08:04,360 --> 00:08:06,060
ينبغي أن أذهب للتسوُّق

108
00:08:44,420 --> 00:08:45,870
تفضّلي بالدّخول

109
00:08:49,370 --> 00:08:51,470
...أعشاب طبّية وأعشاب عاديّة

110
00:08:51,830 --> 00:08:53,850
لكِ ذلك. كالعادة، صحيح؟

111
00:08:53,850 --> 00:08:54,910
لا

112
00:08:55,540 --> 00:08:57,510
ضاعف تلك الكمّية

113
00:08:57,510 --> 00:08:59,980
أضاعف؟ كالمعتاد؟

114
00:08:59,980 --> 00:09:02,050
على رسلكِ

115
00:09:02,050 --> 00:09:03,970
ستُفرّغين كلّ ما لدينا أيضاً

116
00:09:03,970 --> 00:09:06,680
إذاً... المعتاد

117
00:09:08,970 --> 00:09:11,690
حسناً، كنتِ زبونة وفيّة لنا

118
00:09:11,980 --> 00:09:13,410
انتظري لحظة

119
00:09:14,000 --> 00:09:17,150
متى ستصل شحنتُنا التّالية؟

120
00:09:22,980 --> 00:09:24,840
حسناً، آسف على الانتظار

121
00:09:25,270 --> 00:09:28,440
إنّها ليست مُضاعفة، لكن هذا
ما لدينا الآن

122
00:09:29,060 --> 00:09:31,500
شـ-شكراً جزيلاً لك

123
00:09:31,790 --> 00:09:34,550
سأضع الباقي جانباً لأجلكِ حالما
تصل الشّحنة الجديدة

124
00:09:34,550 --> 00:09:35,710
زوريني ثانية، اتّفقنا؟

125
00:09:45,380 --> 00:09:47,400
تفضّل. شكراً لك كالعادة

126
00:09:47,400 --> 00:09:49,060
...وبالنّسبة للفكّة

127
00:09:49,060 --> 00:09:49,930
احتفظي بها

128
00:09:51,710 --> 00:09:53,860
!نتطلّع قُدماً لزياراتك المُستمرّة

129
00:09:53,860 --> 00:09:56,250
أجل. سأحرص على المرور ثانية

130
00:09:56,650 --> 00:09:58,080
!بسرعة، بسرعة

131
00:09:58,080 --> 00:10:00,080
!سنفقد أثرها! بسرعة

132
00:10:00,080 --> 00:10:02,250
!لنصل إليها قبل عودتها إلى مخبئها

133
00:10:02,250 --> 00:10:04,070
!لا تصرخ أيّها الأحمق! ستكشف أمرنا

134
00:10:04,080 --> 00:10:07,960
مرحباً، أنا ساحرة
وحبيبي يريدني أن أصنع جرعةَ حُبّ

135
00:10:07,960 --> 00:10:10,960
وحبيبي يريدني أن أصنع جرعةَ حُبّ

136
00:10:07,960 --> 00:10:10,960
مرحباً، أنا ساحرة

137
00:10:35,110 --> 00:10:36,530
!يا ساحرة

138
00:10:43,740 --> 00:10:46,190
رأيتم؟ أخبرتكم، أليس كذلك؟

139
00:10:46,190 --> 00:10:47,670
لقد راقبتُها

140
00:10:47,670 --> 00:10:48,630
!معك حقّ

141
00:10:48,630 --> 00:10:50,460
!كانت قادمة من الغابة

142
00:10:52,430 --> 00:10:53,960
!أيّتها السّاحرة الحمقاء

143
00:10:53,960 --> 00:10:57,620
!لسنا خائفين منكِ إطلاقاً

144
00:10:59,560 --> 00:11:00,550
!خُذي هذه

145
00:11:00,550 --> 00:11:01,550
!لا تدعوها تهرب

146
00:11:00,980 --> 00:11:02,980
ماذا؟ مـ-مهلاً

147
00:11:01,550 --> 00:11:03,510
!أسقطوها في البُحيرة

148
00:11:04,470 --> 00:11:05,750
!مُكوّناتي

149
00:11:06,310 --> 00:11:08,710
!ارموا المزيد! واصلوا ذلك

150
00:11:08,710 --> 00:11:10,270
!اهزموا السّاحرة

151
00:11:12,660 --> 00:11:13,820
!خذي هذه

152
00:11:17,770 --> 00:11:19,690
مؤلم

153
00:11:19,690 --> 00:11:20,910
!هل هزمناها؟

154
00:11:20,910 --> 00:11:22,150
!مرحى

155
00:11:22,150 --> 00:11:24,970
!ما رأيكِ؟! تستحقّين ذلك

156
00:11:59,780 --> 00:12:00,880
الآنسة السّاحرة؟

157
00:12:08,580 --> 00:12:09,620
ماذا حدث؟

158
00:12:10,170 --> 00:12:11,030
هل أنتِ بخير؟

159
00:12:11,400 --> 00:12:13,500
!أجل، كلّ شيء على ما يُرام

160
00:12:25,130 --> 00:12:27,850
شـ-شكراً جزيلاً لك

161
00:12:32,260 --> 00:12:33,670
كانوا هم، أليس كذلك؟

162
00:12:37,390 --> 00:12:38,510
ماذا؟

163
00:12:39,940 --> 00:12:42,000
!لا! أنزلني

164
00:12:41,720 --> 00:12:42,770
!لا

165
00:12:42,000 --> 00:12:43,650
!أنا آسف

166
00:12:45,600 --> 00:12:48,210
!أ-أنزلني! أنزلني

167
00:12:48,210 --> 00:12:49,410
!أيّها العجوز

168
00:12:49,410 --> 00:12:50,980
!قلتُ أنزلني

169
00:12:50,980 --> 00:12:52,120
أهؤلاء هم جميعهم؟

170
00:12:52,120 --> 00:12:54,320
ماذا؟ لا أتذكّر عددهم

171
00:12:54,320 --> 00:12:55,670
!أيّها الغريب الخطير

172
00:12:55,670 --> 00:12:57,890
!أيّها الجبان! أنزلني

173
00:12:58,490 --> 00:13:01,100
إن اعتذرتم بصدق، فسأنزلكم

174
00:13:01,100 --> 00:13:04,200
!مُحال أن نفعل! أنزلنا فحسب

175
00:13:04,200 --> 00:13:04,960
!من هنا

176
00:13:04,960 --> 00:13:06,940
!من هنا! بسرعة! هيّا

177
00:13:09,400 --> 00:13:10,570
!انظروا، هناك

178
00:13:10,570 --> 00:13:12,060
!أُمسِكَ الجميع

179
00:13:12,060 --> 00:13:13,100
!ساعدونا

180
00:13:17,570 --> 00:13:19,530
...المعذرة

181
00:13:19,530 --> 00:13:22,980
...سمعنا بوجود خاطِف، فأتينا، لكن

182
00:13:22,980 --> 00:13:25,990
رمى هؤلاء الأطفال وحلاً على هذه المرأة

183
00:13:25,990 --> 00:13:27,950
وكان هجوماً من طرف واحد فوق ذلك

184
00:13:31,310 --> 00:13:32,900
!أنا آسف حقّاً

185
00:13:32,900 --> 00:13:36,390
.يا آنسة، نحن آسفون بشأن ذلك
هل تأذّيتِ؟

186
00:13:36,390 --> 00:13:37,990
نحن آسفون حقّاً

187
00:13:37,990 --> 00:13:41,220
،توسّختِ كثيراً بسببهم... إن أردتِ
خذي هذا

188
00:13:41,220 --> 00:13:42,370
...لا

189
00:13:42,370 --> 00:13:44,580
...تفاقمت الأمور إلى مسألة جادّة بعض الشّيء

190
00:13:47,550 --> 00:13:50,810
حاولتُ إقناعهم بالتّكفير عن خطاياهم
كما ينبغي

191
00:13:50,810 --> 00:13:53,590
لكم كما رأيتِ، لم يبدوا نادمين إطلاقاً

192
00:13:53,590 --> 00:13:55,770
لذا فعلتُها على طريقتي الخاصّة

193
00:13:55,770 --> 00:13:58,100
!أنتم! كيف تجرؤون على فعل شيء كهذا؟

194
00:13:58,100 --> 00:14:00,300
!ترمون وحلاً على امرأة

195
00:14:00,300 --> 00:14:01,440
...لكن

196
00:14:01,440 --> 00:14:02,990
...إنّها

197
00:14:03,540 --> 00:14:04,990
!ساحرة

198
00:14:06,170 --> 00:14:09,510
أيّ هراء تتفوّه به يا فتى؟

199
00:14:09,510 --> 00:14:12,590
.آسف بشأن ذلك يا آنسة
عن نعته لكِ بالسّاحرة

200
00:14:18,790 --> 00:14:21,210
!صدّقونا! رأينا ذلك

201
00:14:21,210 --> 00:14:23,520
!رأينا السّاحرةَ تخرج من ذلك المنزل

202
00:14:23,520 --> 00:14:25,440
!ظللنا نُراقبها طوال الوقت

203
00:14:25,440 --> 00:14:28,690
!كانت ستذهب إلى البلدة وتفعل أشياء سيّئة

204
00:14:28,690 --> 00:14:30,220
إنّهن يختطفنَ الأطفال، أليس كذلك؟

205
00:14:30,220 --> 00:14:32,260
!يجب علينا إسقاطها قبل أن تفعل

206
00:14:32,260 --> 00:14:34,220
!اصمتوا يا أطفال

207
00:14:34,220 --> 00:14:39,660
يا آنسة، المعذرة، هل أنتِ فعلاً... ساحرة؟

208
00:14:44,510 --> 00:14:45,580
أجل

209
00:14:48,600 --> 00:14:50,530
سامحينا أرجوكِ

210
00:14:51,270 --> 00:14:53,180
اعفي عنّا

211
00:14:53,180 --> 00:14:55,870
أرجوكِ، أرجوكِ سامحينا

212
00:14:55,870 --> 00:15:00,260
هؤلاء الأطفال ما زالوا صغاراً، ولم يعلموا
بأنّكِ ساحرةٌ عظيمة

213
00:15:00,260 --> 00:15:04,200
ما الّذي يعتقدون بأنّ ساحرة ستفعل
لهم بالضّبط؟

214
00:15:06,130 --> 00:15:08,620
لم يتغيّر شيء منذ أربع سنوات

215
00:15:09,120 --> 00:15:11,170
كما هو مُتوقَّع، تبقى السّاحرة ساحرة

216
00:15:12,000 --> 00:15:16,750
سامحينا أرجوكِ يا ساحرة البُحيرة العظيمة

217
00:15:17,210 --> 00:15:19,180
لستُ عظيمة

218
00:15:19,780 --> 00:15:23,940
لا تحاولوا التستُّر على المُشكلة بالمديح

219
00:15:24,480 --> 00:15:26,820
لا يهمّ إن كانت عظيمة أو ساحرة

220
00:15:26,820 --> 00:15:29,580
من الخطأ رمي وحل على شخص

221
00:15:29,580 --> 00:15:31,190
!لكنّها ساحرة

222
00:15:31,190 --> 00:15:35,240
تُسبّب مشاكلَ للجميع، لذا ينبغي
لها أن تُغادر الغابةَ فحسب

223
00:15:35,240 --> 00:15:36,150
!كُفّ عن ذلك

224
00:15:36,150 --> 00:15:38,860
ما الأشياء الفظيعة الّتي فعلَتْها
الآنسة ساحرة لكم؟

225
00:15:39,440 --> 00:15:42,320
لـ... لا شيء بعد

226
00:15:42,320 --> 00:15:45,300
إذاً ما المُشكلة الّتي تُسبّبها لكم بالتّحديد؟

227
00:15:50,910 --> 00:15:52,560
النّاس ضُعفاء

228
00:15:52,560 --> 00:15:55,130
خُلِقنا نخشى المجهول

229
00:15:58,180 --> 00:16:00,110
هل يمكنني إخبارهم؟

230
00:16:00,590 --> 00:16:01,400
ماذا؟

231
00:16:01,400 --> 00:16:04,180
عن نوع العِلاجات الّتي تصنعينها
يا آنسة ساحرة

232
00:16:04,180 --> 00:16:05,740
هل سيُزعجكِ لو فعلت؟

233
00:16:08,630 --> 00:16:09,650
لا

234
00:16:13,990 --> 00:16:16,290
هل تزرعون المحاصيل؟

235
00:16:16,290 --> 00:16:18,900
أ-أجل، قمح وخضراوات

236
00:16:18,900 --> 00:16:22,140
إذاً لا بُدّ أنّكم تستخدمون شيئاً
للتخلُّص من الحشرات

237
00:16:22,140 --> 00:16:24,470
أجل، بالطّبع

238
00:16:24,470 --> 00:16:27,260
،الّذين يُعانون من آلام ظهر
هل تضعون كمّادات؟

239
00:16:27,260 --> 00:16:29,490
أجل، أكيد

240
00:16:29,960 --> 00:16:32,870
الآنسة ساحرة تصنع هذه الأنواع
من العِلاجات كذلك

241
00:16:35,180 --> 00:16:38,500
لا أقول بأنّ جميعها صُنِعت بواسطة
،الآنسة ساحرة

242
00:16:38,500 --> 00:16:41,140
لكن أنا متأكّد بأنّ بضعة منكم تلقّى عنايتها

243
00:16:41,140 --> 00:16:43,760
قد يكون المجهول مُرعباً

244
00:16:43,760 --> 00:16:49,240
لكن تفريغ ذلك الخوف على الأبرياء
هو فعل مقيت

245
00:16:49,920 --> 00:16:52,070
اعتذروا الآن

246
00:16:54,040 --> 00:16:56,030
أنا آسف جدّاً

247
00:16:58,480 --> 00:17:00,220
إذاً لم تترك لي خياراً

248
00:17:01,830 --> 00:17:05,520
ستتأمّل ما فعلتَه أثناء وجودك
في هذه البُحيرة الباردة

249
00:17:05,520 --> 00:17:08,820
هذا غير مُمكن! يكفي! أنزلني

250
00:17:08,080 --> 00:17:10,920
عزيزي الزّبون، هذا يكفي

251
00:17:09,410 --> 00:17:11,630
!أنزلني أيّها العجوز

252
00:17:10,920 --> 00:17:12,430
أنا بخير، صدّقني

253
00:17:12,430 --> 00:17:13,510
لا، هذا لا يكفي بعد

254
00:17:15,470 --> 00:17:17,930
!أنا آسفٌ جدّاً

255
00:17:17,930 --> 00:17:20,140
لا يجدر بك أن تُكرّر فعلتك

256
00:17:20,140 --> 00:17:22,450
وإلّا ستغضب منك الآنسة ساحرة، مفهوم؟

257
00:17:23,700 --> 00:17:27,610
لا تُحمّليها عواقبَ فشلكِ في رعاية طفلك

258
00:17:29,320 --> 00:17:33,260
لا يحتاج المرء ليكون ساحرة
من أجل مُعاقبة النّاس

259
00:17:33,260 --> 00:17:35,970
لأنّنا بالغون واعون نستطيع
تمييز الصّح من الخطأ

260
00:17:36,480 --> 00:17:41,710
إن فهمتُم، فيجدر بكم مُحاولة
رؤية الأمور بأمّ أعينكم

261
00:17:47,670 --> 00:17:49,760
أمعِنوا النّظر كذلك

262
00:17:49,760 --> 00:17:53,540
انظروا وتأمّلوا الشّخصَ الّذي فعلتُم به ذلك

263
00:18:04,640 --> 00:18:07,240
أنا... آسف

264
00:18:18,130 --> 00:18:19,450
...آنسة ساحرة

265
00:18:19,740 --> 00:18:22,610
...بخصوص متجرنا

266
00:18:26,450 --> 00:18:31,150
إن استطعتِ المجيء، جهّزتُ لكِ الطّلبات

267
00:18:39,380 --> 00:18:40,880
،أعتذر

268
00:18:41,910 --> 00:18:43,670
لأنّني تركتُكِ هكذا

269
00:18:43,670 --> 00:18:44,800
لا بُدّ أنّكِ بردانة

270
00:18:47,010 --> 00:18:48,000
—عزيزي الزبو

271
00:18:48,000 --> 00:18:49,730
استمرّي في ارتدائه

272
00:18:56,190 --> 00:18:59,280
إذاً سأستعير هذا بكلّ امتنان

273
00:18:59,620 --> 00:19:00,590
حسناً

274
00:19:11,450 --> 00:19:14,820
،لو كنتُ بمفردي، كما العادة

275
00:19:14,820 --> 00:19:18,110
،لما تمكّنتُ من فعل أيّ شيء
كما في ذلك الوقت

276
00:19:18,530 --> 00:19:21,810
ولا تمكّنتُ من تبرئة كافّة ساحرات البُحيرة

277
00:19:32,180 --> 00:19:33,870
...هذا

278
00:19:33,870 --> 00:19:35,220
في المرّة المُقبلة، لا عليكِ

279
00:19:36,190 --> 00:19:38,820
رغم ذلك، سبّبوا لكِ كثيراً من الأذى

280
00:19:39,270 --> 00:19:41,290
هل يوجد حوض استحمام في هذا المنزل؟

281
00:19:41,290 --> 00:19:43,940
لا يوجد بالطّبع

282
00:19:43,940 --> 00:19:46,390
إن لم يكن لديكِ مُشكلة، أستطيع إعارتكِ
حوض الاستحمام في منزلي

283
00:19:46,390 --> 00:19:48,270
هذه مُشكلة كبيرة

284
00:19:48,270 --> 00:19:50,620
إذاً اسمحي لي بمُساعدتكِ في غلي الماء

285
00:19:50,620 --> 00:19:53,030
من فضلك، كُفّ عن هذه الدُّعابات

286
00:19:55,680 --> 00:19:59,680
إذاً، اسمحي لي على الأقلّ بالقيام بهذا

287
00:20:09,720 --> 00:20:11,550
!قلتُ لك يكفي

288
00:20:13,500 --> 00:20:14,930
ما الأمر؟

289
00:20:16,700 --> 00:20:20,130
في حال، ولأيّ سبب كان، وقعت مُشكلة
،في حياتكِ اليوميّة

290
00:20:20,130 --> 00:20:23,170
،أو وقع أيّ مكروه قد يُزعزع سلامكِ
،يا آنسة ساحرة

291
00:20:23,170 --> 00:20:24,120
فأبلغيني رجاء

292
00:20:24,710 --> 00:20:26,290
سأساعدكِ حتماً

293
00:20:29,830 --> 00:20:30,980
لا

294
00:20:31,540 --> 00:20:34,000
صدقاً، هذا يكفي

295
00:20:34,000 --> 00:20:36,340
أنا مُمتنّة لمُساعدتك

296
00:20:36,340 --> 00:20:38,030
...لكن اعتباراً من الآن، أنا سوف

297
00:20:38,030 --> 00:20:39,930
تتدبّرين الأمر بمفردكِ؟

298
00:20:39,930 --> 00:20:40,770
أجل

299
00:20:41,490 --> 00:20:44,660
فقد تدبّرتُ أمري منذ البداية

300
00:20:44,970 --> 00:20:46,080
...رغم ذلك

301
00:20:46,920 --> 00:20:51,420
وُجِدت السّاحرات ببساطة تمنح
الأُمنيات مُقابل ثمن

302
00:20:51,420 --> 00:20:52,970
فنحن نعمل بالمُقايضة المُتكافئة

303
00:20:53,640 --> 00:20:57,580
هو يدفع الثّمن، وأنا أصنع له الجرعة

304
00:20:58,080 --> 00:21:01,840
هذه هي حدود علاقتنا، ولا شيء يتعدّى ذلك

305
00:21:02,620 --> 00:21:05,250
لذا، هذا يكفي

306
00:21:05,710 --> 00:21:08,070
لا أستطيع تحمُّل المزيد

307
00:21:08,620 --> 00:21:10,850
لا يهمّ إن كانت عظيمة أو ساحرة

308
00:21:13,790 --> 00:21:17,940
ما دامت تلك الكلمات في صدري، فأستطيع
العيش بمفردي من الآن فصاعداً

309
00:21:18,490 --> 00:21:21,490
شكراً جزيلاً لك على اليوم

310
00:21:21,490 --> 00:21:24,950
سأعيد مِعطفك في المرّة المُقبلة
الّتي نلتقي فيها

311
00:21:29,470 --> 00:21:31,470
سوف أكمل الجرعة

312
00:21:31,470 --> 00:21:32,970
بأسرع وقت مُمكن

313
00:21:53,780 --> 00:21:56,190
مضى حوالي أسبوع منذ ذلك الحين

314
00:21:56,670 --> 00:21:59,900
انتهيتُ من آخر التّعديلات دون
أن أنعم بلحظة نوم

315
00:22:00,740 --> 00:22:03,710
والجرعة قد اكتملت

316
00:22:04,410 --> 00:22:08,070
جرعة الحُبّ الّتي رغبَها هاريج-ساما