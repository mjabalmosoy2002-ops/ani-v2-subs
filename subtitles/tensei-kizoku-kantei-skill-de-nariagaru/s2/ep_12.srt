1
00:00:04,130 --> 00:00:05,840
توماس إذًا؟

2
00:00:05,840 --> 00:00:07,900
.سيكون مؤسفًا أن نضطر لقتله

3
00:00:07,900 --> 00:00:09,530
!لندخل أيضًا

4
00:00:09,530 --> 00:00:10,300
!أمرك

5
00:00:17,260 --> 00:00:18,220
.روسيل

6
00:00:18,910 --> 00:00:20,930
أثمة ما يؤرقك؟

7
00:00:20,930 --> 00:00:22,000
...لا

8
00:02:02,560 --> 00:02:04,890
...قد تكونين عبقرية يا ميري

9
00:02:05,790 --> 00:02:11,230
.لكنّني من سأحقق النصر النهائي لسيّدي

10
00:02:14,150 --> 00:02:15,290
!لورد كوران

11
00:02:15,290 --> 00:02:17,420
!تمركز السحرة

12
00:02:17,920 --> 00:02:18,860
.جيّد

13
00:02:20,330 --> 00:02:20,870
!استعدوا

14
00:02:25,650 --> 00:02:26,620
.هيّا

15
00:02:28,560 --> 00:02:29,560
.روسيل

16
00:02:30,160 --> 00:02:33,000
.ميري ليست الخبيرة الاستراتيجية الوحيدة لـ لامبرغ

17
00:02:36,900 --> 00:02:37,920
!استعدوا للحرق

18
00:02:37,920 --> 00:02:39,880
!مـ-مهلًا لحظة

19
00:02:43,990 --> 00:02:46,140
.ما الخطب؟ إنّها لا تنفجر

20
00:02:46,540 --> 00:02:49,490
انتشرت قوّاتهم بالفعل، صحيح؟

21
00:02:49,490 --> 00:02:52,980
...نعم، توقعتَ أن يهاجموا الآن

22
00:02:56,840 --> 00:02:58,570
ماذا حدث للتو؟

23
00:03:00,530 --> 00:03:02,780
.لتبدأ المعركة

24
00:03:13,120 --> 00:03:14,920
!إ-إنّها غارة

25
00:03:18,820 --> 00:03:20,740
!ألقى سيّدي أوامره

26
00:03:20,740 --> 00:03:23,740
!اقضوا على الضعفاء وأخلوا الطريق

27
00:03:23,740 --> 00:03:24,850
!لستَ قائدنا

28
00:03:25,170 --> 00:03:27,220
!غارة! غارة

29
00:03:33,480 --> 00:03:35,730
!فعّلوا المفجرات

30
00:04:00,990 --> 00:04:02,100
كيف؟

31
00:04:02,100 --> 00:04:03,180
كيف توقعت هذا؟

32
00:04:06,440 --> 00:04:08,180
!ميري

33
00:04:11,900 --> 00:04:13,270
!لورد كوران

34
00:04:13,270 --> 00:04:15,620
!المكان خطير! تراجع

35
00:04:15,620 --> 00:04:16,900
.لا تبالوا

36
00:04:16,900 --> 00:04:18,740
!اقبضوا على وحدة العدو أحياء

37
00:04:18,740 --> 00:04:20,360
!لا تقتلوا توماس

38
00:04:22,630 --> 00:04:23,820
لورد كوران؟

39
00:04:23,820 --> 00:04:25,820
...إن استطعت سلب رأسك

40
00:04:27,780 --> 00:04:28,600
...هذا

41
00:04:29,480 --> 00:04:31,180
!توماس غرانجيون

42
00:04:32,150 --> 00:04:33,810
!أوقفوا جنرالهم

43
00:04:41,950 --> 00:04:43,630
!اتبعوا اللورد توماس

44
00:04:45,000 --> 00:04:46,280
!عـ-علينا المساعدة

45
00:04:46,280 --> 00:04:47,160
!لا

46
00:04:47,160 --> 00:04:49,420
.لا تزال المفجرات قريبة

47
00:04:49,420 --> 00:04:51,900
.قد نصيب أرس

48
00:04:51,900 --> 00:04:53,770
.اصمد يا أرس

49
00:04:56,310 --> 00:04:58,450
!أرس! ابقَ مع اللورد كوران

50
00:04:58,450 --> 00:04:59,270
!أمرك

51
00:05:02,630 --> 00:05:05,240
،إحصائيات اللورد كوران أعلى

52
00:05:05,610 --> 00:05:06,400
...لكن

53
00:05:06,400 --> 00:05:07,610
!لورد كوران

54
00:05:10,610 --> 00:05:12,140
...هذه الحدّة

55
00:05:16,820 --> 00:05:17,370
أرس؟

56
00:05:18,720 --> 00:05:19,880
.أرس

57
00:05:23,900 --> 00:05:25,870
!تنحَّ عن سبيلي

58
00:05:25,870 --> 00:05:27,050
!سيّدي أرس

59
00:05:34,430 --> 00:05:35,230
!ريتز

60
00:05:38,180 --> 00:05:41,820
!لن أدعك تقترب من سيّدي أرس

61
00:05:54,920 --> 00:05:57,120
.ريتز... شكرًا

62
00:06:03,320 --> 00:06:05,110
...لـ-ليس بعد

63
00:06:11,190 --> 00:06:12,720
...ما زلت

64
00:06:17,630 --> 00:06:19,230
...ميري

65
00:06:19,230 --> 00:06:21,640
.لم أرك منذ مدة يا توماس

66
00:06:33,240 --> 00:06:37,520
سيّدي أرس! إيّاك، إيّاك وفعل
!شيء متهور مثل ذلك مجددًا

67
00:06:37,520 --> 00:06:39,370
!آ-آ-آ-آسف

68
00:06:39,740 --> 00:06:41,660
لِم اندفعت بتلك الطريقة؟

69
00:06:42,510 --> 00:06:44,310
.لستُ متأكدًا

70
00:06:44,310 --> 00:06:48,470
كنتُ أعلم أنَّ اللورد كوران
...مُتمكّن أكثر منّي ولكن

71
00:06:49,020 --> 00:06:53,100
عندما فكرتُ فيما قد يحدث
.لم أستطع كبح نفسي

72
00:06:55,190 --> 00:06:57,980
.هذه هي طبيعة أرس

73
00:06:57,980 --> 00:07:02,550
لا تنسي أنّني أعرفه
.منذ فترة أطول منك

74
00:07:02,550 --> 00:07:04,800
ماذا، أتحاول استخدام الأقدمية؟

75
00:07:04,800 --> 00:07:06,760
!هوّنا عليكما

76
00:07:06,760 --> 00:07:10,360
...على أيّ حال، آمل أن يكونوا بخير

77
00:07:12,640 --> 00:07:16,050
.لم أرك منذ فترة يا رجل
.تبدو بحالة مزرية

78
00:07:16,050 --> 00:07:17,240
!اخرسي

79
00:07:17,240 --> 00:07:19,200
.خسرت أمامك مجددًا

80
00:07:19,200 --> 00:07:20,290
!اقتليني الآن

81
00:07:20,630 --> 00:07:23,650
.لا تزال تبالغ جدًا

82
00:07:23,650 --> 00:07:25,760
.أعتقد أنّك مخطئ رغم ذلك

83
00:07:25,760 --> 00:07:29,190
.لستُ من اكتشفت خطتك

84
00:07:29,720 --> 00:07:31,090
هذا الطفل هو المسؤول؟

85
00:07:31,390 --> 00:07:33,500
!لكن كان ذلك وشيكًا

86
00:07:33,500 --> 00:07:37,290
.لو كنتُ بمفردي، لكنّا في عداد الموتى الآن

87
00:07:37,290 --> 00:07:39,340
.شكرًا يا روسيل

88
00:07:39,340 --> 00:07:40,350
!ا-العفو

89
00:07:40,730 --> 00:07:42,950
!كيف اكتشفت خطّتي؟

90
00:07:43,480 --> 00:07:48,000
يعتمد نجاح الخّطة على مقدار
!قدرتك على توقع خصمك

91
00:07:48,000 --> 00:07:50,270
،أنا أعرف ميري جيدًا

92
00:07:50,270 --> 00:07:51,950
!لكنّك لا تعرف شيئًا عنّي

93
00:07:51,950 --> 00:07:54,800
!نـ-نعم، هذا صحيح

94
00:07:54,800 --> 00:07:58,200
لكنّني أمضيتُ وقتًا طويلًا أفكر
...في ميري أيضًا

95
00:07:59,700 --> 00:08:05,460
لـ-لهزيمة عدوك، من المهم أن تفكر
.في كيفية هزيمة عدوك

96
00:08:05,460 --> 00:08:09,630
!لذا كان عليّ التفكير في كيفية التغلب على ميري

97
00:08:10,710 --> 00:08:12,130
!استعدوا للحرق

98
00:08:11,220 --> 00:08:12,130
!مـ-مهلًا لحظة

99
00:08:12,440 --> 00:08:15,000
!قد تكون هناك قنابل في الغابة

100
00:08:15,000 --> 00:08:17,640
وكان روسيل محقًا

101
00:08:17,640 --> 00:08:20,000
.إنّه تلميذي لكنّ عليّ أن أعترف له بهذا

102
00:08:20,820 --> 00:08:24,020
.كلّ ما فكّرتَ فيه هو هزيمتي

103
00:08:24,020 --> 00:08:28,230
لم تفكر أبدًا أنّ شخصًا آخر قد
.يتوصل لنفس أفكارك

104
00:08:29,480 --> 00:08:31,780
.أنت أخ أحمق حقًا

105
00:08:34,340 --> 00:08:38,780
إنّهما شقيقان، لكن لا بدَّ أنّ هناك عداوة
.بينهما نظرًا لأنّهما عدُوّان

106
00:08:41,900 --> 00:08:42,790
أرس؟

107
00:08:49,170 --> 00:08:51,440
...أصلًا، منذ أن كنتَ طفلًا

108
00:08:51,440 --> 00:08:52,870
!مـ-ميري

109
00:08:53,550 --> 00:08:58,180
عفوًا، عليك أن تقولي حقًا
!ما تفكرين به في الواقع

110
00:08:58,720 --> 00:09:01,890
...ماذا؟ ماذا تقصد

111
00:09:10,450 --> 00:09:11,690
.أعتقد أنّك محق

112
00:09:12,740 --> 00:09:15,560
!هزمتني حقًا هذه المرة

113
00:09:15,560 --> 00:09:21,120
لكن تلميذي أنقذني لذا
.أعتقد أنّه تعادل

114
00:09:23,370 --> 00:09:26,480
...ما أحاول قوله

115
00:09:29,120 --> 00:09:30,970
.صرت بارعًا في هذا

116
00:09:36,290 --> 00:09:38,860
.لكن لا يزال لدينا العقل والفم

117
00:09:38,860 --> 00:09:42,260
.نستطيع مواصلة النجاة بأسلحة كهذه

118
00:09:54,200 --> 00:09:56,780
...في النهاية، ربّما

119
00:10:07,590 --> 00:10:13,160
في النهاية، ربّما أردتُ فقط
.أن تعترف بي ميري

120
00:10:15,420 --> 00:10:17,000
ما المضحك؟

121
00:10:17,520 --> 00:10:18,180
.لا شيء

122
00:10:19,420 --> 00:10:21,180
.أعترف بالهزيمة

123
00:10:24,090 --> 00:10:25,160
.توماس

124
00:10:26,680 --> 00:10:28,440
...لورد كوران

125
00:10:28,830 --> 00:10:32,060
.اخدمني وأعدك أنّك ستحظى بمعاملة حسنة

126
00:10:33,020 --> 00:10:36,460
.أقسمتُ بالولاء للورد فاسمارك

127
00:10:36,460 --> 00:10:39,700
.حتّى لو خسرت، لا أستطيع التنازل عن هذا

128
00:10:41,140 --> 00:10:43,230
.فهمت. هذا مؤسف

129
00:10:44,450 --> 00:10:45,820
.خذوه إلى زنزانة

130
00:10:45,820 --> 00:10:46,610
!أمرك

131
00:10:48,700 --> 00:10:50,720
.نستطيع تنفس الصعداء الآن

132
00:10:50,720 --> 00:10:51,720
!نعم

133
00:10:53,370 --> 00:10:54,430
!يا طفل

134
00:10:55,850 --> 00:10:57,390
.أحسنت صنعًا

135
00:10:57,820 --> 00:11:01,970
...لـ-لا، لو لم يُشجّعني سيّدي أرس

136
00:11:04,220 --> 00:11:06,720
.لا تدع ميري تؤثر عليك كثيرًا

137
00:11:07,850 --> 00:11:09,380
!حـ-حسنًا

138
00:11:16,480 --> 00:11:19,740
فشل خطّة توماس

139
00:11:19,740 --> 00:11:23,490
.أدّى لتوقف قلعة فيرزود عن المقاومة واستسلموا

140
00:11:39,410 --> 00:11:41,800
!أحسنتم صنعًا جميعًا

141
00:11:43,450 --> 00:11:49,630
بهذا، يسيطر جيشنا على مدينتين من المدن
.الثلاث الكبرى سمبلار، أركانتيز وفيرزود

142
00:11:50,180 --> 00:11:52,440
.كلّ ذلك بفضل عملكم الدؤوب

143
00:11:53,120 --> 00:11:56,440
.سأمنح التكريم الآن

144
00:11:58,530 --> 00:12:03,340
أولًا، أودُّ تعيين رؤساء جُدد
.لإقليمي فيرزود وسمخ

145
00:12:04,160 --> 00:12:05,200
.فريدور

146
00:12:05,200 --> 00:12:09,390
أخشى أنّ عليّ أن أطلب منك التنحي
.عن منصب رئاسة سمخ

147
00:12:09,390 --> 00:12:11,050
.كما تشاء يا سيّدي

148
00:12:11,870 --> 00:12:16,430
سيكون كلا الإقليمين بغاية الأهمية
.في المعركة المقبلة

149
00:12:16,430 --> 00:12:20,210
من سيُعيّن اللورد كوران مسؤولًا عنهما؟

150
00:12:20,510 --> 00:12:23,220
.بالنسبة لرئاسة فيرزود، أعيّن لومير بايربس

151
00:12:28,850 --> 00:12:31,800
!لورد لومير... هذا رائع

152
00:12:32,450 --> 00:12:35,600
.لأنّ قوات كاناري حققت أكثر الإنجازات

153
00:12:39,220 --> 00:12:42,990
.ولرئاسة سمخ، أعيّن لوبا لوزتون

154
00:12:44,240 --> 00:12:46,490
!لـ-لوبا؟

155
00:12:48,080 --> 00:12:50,990
تنصيب العدو المستسلم لوبا إذًا؟

156
00:12:50,990 --> 00:12:55,960
ليست خطّة إدارة سيئة لتشجيع
،المزيد من المنشقين من الأعداء

157
00:12:55,960 --> 00:12:58,130
.لكنّها ستحدث ضجة بكل تأكيد

158
00:12:58,410 --> 00:13:01,630
.لكن أعلم أنَّ اللورد لوبا يستطيع تولي هذه المهمة

159
00:13:06,570 --> 00:13:08,640
.أقبل بكلّ تواضع

160
00:13:10,140 --> 00:13:12,520
.إنّه اختبار ممتاز

161
00:13:13,850 --> 00:13:16,810
لكن ماذا سيحدث لكاناري الآن؟

162
00:13:20,190 --> 00:13:23,020
،بشغل لومير حاليًا منصب رئاسة كاناري

163
00:13:23,020 --> 00:13:25,830
.لكن كاناري وفيرزود بعيدتان عن بعضهما

164
00:13:25,830 --> 00:13:28,390
.سيكون صعبًا إدارة كليهما

165
00:13:28,390 --> 00:13:29,280
...وبالتالي

166
00:13:31,060 --> 00:13:32,700
سأترك حكم كاناري

167
00:13:32,700 --> 00:13:34,620
.لـ أرس لوفنت

168
00:13:41,250 --> 00:13:42,490
!سـ-سيدي أرس

169
00:13:42,490 --> 00:13:43,600
!اهدأ

170
00:13:43,600 --> 00:13:48,970
لـ-لا أقود لامبرغ فقط الآن
بل إقليم كاناري أيضًا؟

171
00:13:49,340 --> 00:13:51,460
.أخبرتك بهذا من قبل

172
00:13:51,460 --> 00:13:53,720
.حدث الأمر أبكر قليلًا مما توقعت فقط

173
00:13:55,150 --> 00:13:56,940
...إن انتصرنا في الحرب القادمة

174
00:13:58,040 --> 00:14:00,400
.سأعيّنك رئيسًا لكاناري

175
00:14:01,040 --> 00:14:04,380
ما قاله آنذاك... أكان جادًا؟

176
00:14:06,750 --> 00:14:07,950
!مهلًا لحظة

177
00:14:08,540 --> 00:14:11,420
هل تريد ترقيته إلى مستوانا؟

178
00:14:11,420 --> 00:14:14,370
ألا تظن أنّه يافع قليلًا على المنصب؟

179
00:14:14,900 --> 00:14:18,860
!هذا متسرع! لن أقبل الأمر

180
00:14:20,650 --> 00:14:24,670
حكم إقليم يعني اعتماد العديد
...من الناس عليك

181
00:14:25,910 --> 00:14:27,980
.ربّما لا يزال هذا مبكرًا عليّ

182
00:14:28,680 --> 00:14:31,220
...لمجرد أنّك تملك عددًا من الأتباع الماهرين

183
00:14:31,220 --> 00:14:33,180
.هذا تصرف لا يليق

184
00:14:33,810 --> 00:14:37,000
.نحن نعرف أرس جيدًا

185
00:14:37,000 --> 00:14:39,860
،لا شك في أنّ أتباعه بارعون

186
00:14:39,860 --> 00:14:44,000
.لكن أتباعه يخدمونه بسبب امتيازه

187
00:14:44,000 --> 00:14:48,340
لا نتصور شخصًا أفضل منه ليشغل
.منصب رئاسة كاناري فوقنا

188
00:14:48,340 --> 00:14:50,660
...لورد كرال... لورد هاموند

189
00:14:50,660 --> 00:14:56,120
ربّما كنتُ سألتحق بصفوف العدو
!لولا وجود أرس أيضًا

190
00:14:56,120 --> 00:14:59,080
...رئيسا بيرينا وماسا

191
00:14:59,080 --> 00:15:04,410
سمعتُ أنّ انقلاب اللوردين فرايدور ولوبا
.كان بفضل أرس أيضًا

192
00:15:05,480 --> 00:15:08,470
.إنّه يتمتع بالقدرة على تحفيز الآخرين للتصرف

193
00:15:08,470 --> 00:15:11,010
!نعم، هذا صحيح

194
00:15:11,310 --> 00:15:14,770
!أرس هو أكثر من حقق إنجازات بيننا

195
00:15:14,770 --> 00:15:16,070
!صحيح

196
00:15:16,070 --> 00:15:17,850
!أ-أظن ذلك أيضًا

197
00:15:18,320 --> 00:15:22,100
لم أكُن لأفعل كلّ ما أنجزته
.لو لم يكن أرس من طلب منّي ذلك

198
00:15:22,740 --> 00:15:26,920
.سيؤدي سيّدي أرس عملًا ممتاز كرئيس لكاناري

199
00:15:26,920 --> 00:15:28,820
!إنّه سيّد سيّدي

200
00:15:29,310 --> 00:15:30,510
...يا رفاق

201
00:15:30,510 --> 00:15:31,820
!هيّا

202
00:15:36,330 --> 00:15:37,810
!لورد كوران

203
00:15:37,810 --> 00:15:42,460
!أقبل رسميًا دور رئيس كاناري

204
00:15:44,320 --> 00:15:46,460
.أعتمد عليك يا أرس

205
00:15:46,460 --> 00:15:47,410
!أمرك

206
00:15:49,210 --> 00:15:53,010
!مرحى للرئيس الجديد أرس

207
00:15:53,010 --> 00:15:54,590
...الجميع، أرجوكم

208
00:16:03,660 --> 00:16:04,730
.ادخل

209
00:16:05,790 --> 00:16:06,870
.المعذرة

210
00:16:07,460 --> 00:16:09,090
.أتيت يا أرس

211
00:16:13,360 --> 00:16:17,270
.نادرًا ما تستقبلني يا لورد لومير

212
00:16:17,270 --> 00:16:18,740
.أنا سعيد

213
00:16:19,520 --> 00:16:23,130
أشغلتنا الحملة ولم يُتح لنا
.وقت كثير للتحدث

214
00:16:23,130 --> 00:16:27,220
.تهانينا على ترقيتك الأخيرة

215
00:16:28,950 --> 00:16:30,560
...بخصوص ذلك

216
00:16:30,560 --> 00:16:32,720
.أنا لستُ سعيدًا بشأنه

217
00:16:34,080 --> 00:16:38,380
.لم أستطع ذكر ذلك هناك والجميع يحتفل

218
00:16:38,380 --> 00:16:39,850
لكن لماذا؟

219
00:16:40,300 --> 00:16:43,000
...لا أشعر أنّني مستعد لقيادة فيرزود

220
00:16:43,000 --> 00:16:47,020
.بل لا أريد التخلي عن كاناري

221
00:16:47,560 --> 00:16:53,820
مدن فيرزود أكثر اتساعًا ومواردها
.الطبيعية أكبر من كاناري بكثير

222
00:16:54,730 --> 00:16:57,560
...رغم أنّني أعلم أنّ عليّ الشعور بالشرف

223
00:16:58,820 --> 00:17:01,280
،نشأتُ في كاناري

224
00:17:02,170 --> 00:17:04,940
.على أرض توارثتها عائلتي عبر أجيال

225
00:17:05,860 --> 00:17:09,180
عملتُ جاهدًا لمساعدة أكبر
.عدد ممكن من شعبي

226
00:17:10,050 --> 00:17:15,050
لم تكُن جهودي كافية لكنّني
.نويت مواصلة المحاولة

227
00:17:15,550 --> 00:17:21,070
في الحقيقة، أُفضّل أن أواصل الاعتناء بوطني
.بدل أرض فيرزود الغريبة عنّي

228
00:17:22,000 --> 00:17:23,360
...لورد لومير

229
00:17:24,180 --> 00:17:28,990
لكن هناك شخصًا واحدًا أشعر
.بالراحة في ترك منطقتي له

230
00:17:30,020 --> 00:17:31,690
.وهو أنت يا أرس

231
00:17:34,190 --> 00:17:39,710
رأيتُ نجاحاتك ونجاحات لامبرغ
.أثناء هذه الحرب

232
00:17:40,330 --> 00:17:43,940
رأيتُ نموك عبر الثقة
،التي تضعها في شعبك

233
00:17:44,480 --> 00:17:48,720
.وشعرتُ بالمستقبل الذي تمنيته لكاناري في لامبرغ

234
00:17:49,720 --> 00:17:55,470
أرس، هل تستطيع جعل كاناري
.مكانًا أفضل من ذي قبل؟

235
00:18:09,240 --> 00:18:11,280
.أستطيع يا لورد لومير

236
00:18:14,230 --> 00:18:16,480
.أترك الأمر لك يا أرس

237
00:18:17,900 --> 00:18:20,870
،وهكذا انتهت معركة فيرزود"

238
00:18:21,270 --> 00:18:24,120
"وعُيّنت رئيسًا لكاناري

239
00:18:24,620 --> 00:18:26,870
هل المشروبات جاهزة؟

240
00:18:26,870 --> 00:18:30,120
!ليساعدني أحدكم في حمل الطعام

241
00:18:30,120 --> 00:18:35,050
حاليًا، سنعود إلى لامبرغ"
"للتحضير للحملة القادمة

242
00:18:35,520 --> 00:18:39,740
،بحلول الوقت التي تصلك فيه هذه الرسالة
".يفترض أنّنا قد ممرنا بكاناري

243
00:18:40,280 --> 00:18:42,430
"انتظري قليلًا من فضلك"

244
00:18:43,270 --> 00:18:45,430
!عاد اللورد أرس

245
00:18:47,810 --> 00:18:49,810
!مرحبًا بعودتك يا سيّدي أرس

246
00:18:49,520 --> 00:18:50,780
!عدنا

247
00:18:49,810 --> 00:18:51,360
!مرحبًا بعودتكم

248
00:18:51,920 --> 00:18:54,260
!هذه لك يا سيّدي أرس

249
00:18:54,260 --> 00:18:55,820
!شكرًا

250
00:18:56,660 --> 00:18:59,670
!كبرت حقًا منذ آخر مرة رأيناك فيها

251
00:18:59,670 --> 00:19:00,970
حقًا؟

252
00:19:04,780 --> 00:19:07,040
.عائلة أحد الجنود القتلى

253
00:19:07,040 --> 00:19:08,200
...ا-المعذرة

254
00:19:09,660 --> 00:19:11,190
...سيّدي أرس

255
00:19:11,190 --> 00:19:12,960
.شكرًا على الرسالة التي أرسلتها لنا

256
00:19:13,690 --> 00:19:18,970
كانت هذه الحرب صعبة جدًا لكن
.اللطف الذي أظهرته لنا أسعدنا

257
00:19:19,740 --> 00:19:22,600
...سنفتقد ابننا الراحل

258
00:19:22,600 --> 00:19:24,750
.لكن لنواصل جميعًا بذل ما بوسعنا معًا

259
00:19:25,800 --> 00:19:26,620
.بالطبع

260
00:19:27,620 --> 00:19:29,600
.هيّا، عدتَ منتصرًا

261
00:19:29,600 --> 00:19:32,290
.لا ينبغي أن تبكي يا سيّدي أرس

262
00:19:32,290 --> 00:19:34,370
.نعم... أنا آسف

263
00:19:35,340 --> 00:19:36,530
!سيّدي أرس

264
00:19:39,070 --> 00:19:40,570
!ليشيا

265
00:19:44,240 --> 00:19:44,820
.توقفي

266
00:19:45,090 --> 00:19:49,540
.هناك أناس من حولنا
.عائلات الجنود الموتى هنا أيضًا

267
00:19:50,070 --> 00:19:53,090
.عليّ أن أكون محترمة كزوجة لورد

268
00:19:59,050 --> 00:20:03,130
!سيّدي أرس! ا... اشتقت إليك كثيرًا

269
00:20:03,520 --> 00:20:04,690
...ليشيا

270
00:20:05,330 --> 00:20:08,630
.حققتُ نجاحًا كبيرًا بفضل الجميع

271
00:20:08,630 --> 00:20:09,590
...نعم

272
00:20:09,590 --> 00:20:11,890
!ووقع عليّ الاختيار لأكون رئيسًا لكاناري

273
00:20:11,890 --> 00:20:13,830
قرأتِ رسالتي، صحيح؟

274
00:20:13,830 --> 00:20:15,680
...نعم... نعم

275
00:20:15,680 --> 00:20:17,880
.رأيتُ الكثير من الأشياء المذهلة

276
00:20:18,820 --> 00:20:20,170
...سيّدي أرس

277
00:20:21,010 --> 00:20:25,030
.لنبقى هكذا لبعض الوقت

278
00:20:25,380 --> 00:20:27,530
.حسنًا يا ليشيا

279
00:20:32,160 --> 00:20:33,790
!أخي الكبير

280
00:20:33,790 --> 00:20:36,470
!أخي الكبير! عانقني أيضًا

281
00:20:36,470 --> 00:20:37,790
!أنا أيضًا

282
00:20:38,240 --> 00:20:40,130
!كرايز! رين

283
00:20:41,670 --> 00:20:46,140
.عاد سيّدي أرس يا سيدتي صوفيا

284
00:20:46,140 --> 00:20:46,930
.نعم

285
00:20:49,210 --> 00:20:51,620
.مرحبًا بعودتك يا أرس

286
00:20:52,100 --> 00:20:55,430
!والآن جميعًا، يمكننا الحديث لاحقًا

287
00:20:55,430 --> 00:20:56,730
!تفضلوا من هنا

288
00:20:57,210 --> 00:20:59,610
!صحيح! لنذهب

289
00:21:03,710 --> 00:21:05,760
!وأنتما من هنا

290
00:21:07,740 --> 00:21:10,290
ماذا سيفعلون؟

291
00:21:15,190 --> 00:21:18,360
.لم يقيما واحدًا بعد

292
00:21:19,200 --> 00:21:20,830
.لننضم إليهما

293
00:21:20,830 --> 00:21:23,320
.سنشرب مشروبات لذيذة

294
00:21:23,320 --> 00:21:24,770
ما-ماذا؟

295
00:21:24,770 --> 00:21:28,390
.إنّه يوم مثالي للاحتفال

296
00:21:34,800 --> 00:21:36,140
!من هنا يا أخي

297
00:21:41,950 --> 00:21:43,330
...هذا

298
00:21:44,880 --> 00:21:46,780
.بناءً على طلبي

299
00:21:48,160 --> 00:21:50,310
.إنّه حفل زفافكما

300
00:21:50,310 --> 00:21:53,290
.لم تقيماه بعد بسبب عنفوان الحرب

301
00:21:54,550 --> 00:21:56,200
!انظري يا أختاه

302
00:22:07,580 --> 00:22:08,840
...سيّدي أرس

303
00:22:09,610 --> 00:22:13,690
...أ-أنت بغاية الجمال يا ليشيا

304
00:22:15,310 --> 00:22:16,830
.أنت أيضًا يا سيّدي أرس

305
00:22:26,160 --> 00:22:28,950
!أتيت للاحتفال أيضًا يا أرس

306
00:22:42,310 --> 00:22:43,210
...أبي

307
00:22:44,000 --> 00:22:48,050
.واجهتُ العديد من المصاعب أثناء هذه الحرب

308
00:22:48,840 --> 00:22:49,730
...لكن

309
00:22:51,590 --> 00:22:56,350
.أستطيع التغلب على أيّ مصاعب لرؤيتهم يبتسمون

310
00:22:56,350 --> 00:22:59,200
.كمحارب وكسيّد

311
00:23:06,330 --> 00:23:09,240
.سأبذل قصارى جهدي يا ليشيا

312
00:23:09,720 --> 00:23:12,360
!وسأكون بجانبك لدعمك يا سيّدي أرس