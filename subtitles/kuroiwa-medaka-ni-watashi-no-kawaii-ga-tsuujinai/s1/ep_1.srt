1
00:00:34,920 --> 00:00:38,350
.يا مونا-تشان، ثمّة قشدة عليك

2
00:00:42,650 --> 00:00:45,730
!إنّها ظريفة للغاية

3
00:00:47,130 --> 00:00:51,350
...واحد، اثنان، ثلاثة

4
00:00:51,730 --> 00:00:55,490
...أربعة، خمسة، ستّة

5
00:00:52,670 --> 00:00:53,980
!علينا الإسراع

6
00:00:53,980 --> 00:00:55,490
!ستأتي خلفنا

7
00:00:55,830 --> 00:00:58,740
...سبعة، ثمانية

8
00:00:56,930 --> 00:00:58,740
لماذا تقفون هناك فحسب؟

9
00:00:58,740 --> 00:01:01,240
!تسعة، عشرة

10
00:01:03,480 --> 00:01:05,480
.أ-أمسكي بي

11
00:01:05,480 --> 00:01:06,450
.وأنا أيضًا

12
00:01:06,450 --> 00:01:07,250
.وأنا كذلك

13
00:01:07,250 --> 00:01:10,090
!هذا ليس عدلاً! أمسكيني أيضًا

14
00:01:10,090 --> 00:01:11,210
!وأنا

15
00:01:11,210 --> 00:01:15,500
.مهلاً، لا تُلعب المطاردة هكذا

16
00:01:21,440 --> 00:01:24,630
.هذا صحيح. أنا أشبه ملكة النّحل

17
00:01:58,470 --> 00:02:00,420
.صباح الخير لي

18
00:03:54,170 --> 00:03:55,420
!صباح الخير

19
00:03:55,420 --> 00:03:56,960
.صباح الخير يا مونا-تشان

20
00:03:56,960 --> 00:03:58,050
!صباح الخير

21
00:03:58,050 --> 00:03:59,000
.صباح الخير

22
00:03:59,000 --> 00:04:00,420
.صباح الخير لك

23
00:04:00,420 --> 00:04:01,800
.صباح الخير يا مونا-تشان

24
00:04:01,800 --> 00:04:02,930
!صباح الخير

25
00:04:02,930 --> 00:04:04,220
.صباح الخير لك أيضًا

26
00:04:04,220 --> 00:04:05,300
.صـ-صباح الخير

27
00:04:05,300 --> 00:04:06,850
!صباح الخير

28
00:04:06,850 --> 00:04:09,220
.صباح الخير يا مونا-سينباي

29
00:04:12,430 --> 00:04:13,520
!صباح الخير لكم

30
00:04:13,520 --> 00:04:15,020
!صباح الخير

31
00:04:15,020 --> 00:04:16,770
.صباح الخير

32
00:04:19,280 --> 00:04:21,320
.صباح الخير يا كورويوا-كُن

33
00:04:27,240 --> 00:04:28,370
.صباح الخير

34
00:04:31,250 --> 00:04:36,250
لماذا هذا المغفّل وحده من ينظر
لي بنظر عدم اهتمام كلّ صباح؟

35
00:04:36,710 --> 00:04:41,510
لم تحصل على زيّك المدرسيّ بعد؟
هل اعتدت على فصلنا؟

36
00:04:41,510 --> 00:04:45,010
عفوًا، مرّ أسبوعان على انتقالك
إلى هنا، صحيح؟

37
00:04:48,010 --> 00:04:50,760
.صحيح، بالطّبع لا تزال متوتّرًا

38
00:04:50,760 --> 00:04:53,730
وجدتُها! ما رأيك أن آخذك
في جولة في المدرسة ثانية؟

39
00:04:53,730 --> 00:04:57,730
إن احتجت لأيّ شيء، فلا تتردّد
في طلب مساعدتي، مفهوم؟

40
00:04:57,730 --> 00:04:58,480
مفهوم؟

41
00:04:58,770 --> 00:05:01,780
يحصل ميداكا-كُن على بَركة
.مونا-تشان مرّة أخرى

42
00:05:01,780 --> 00:05:04,450
.تبًّا. أكرهه

43
00:05:04,450 --> 00:05:05,950
.اسمعي

44
00:05:05,950 --> 00:05:06,990
ماذا؟

45
00:05:07,240 --> 00:05:10,700
دعيني... وشأني فحسب، أيمكنك ذلك؟

46
00:05:15,790 --> 00:05:18,790
.ماذا؟ هذا غير منطقيّ أبدًا

47
00:05:18,790 --> 00:05:21,960
كيف يُعقل وجود فتى يرفض
حتّى منحي وقته؟

48
00:05:22,250 --> 00:05:26,930
ثمّة فتاة بالغة الظّرافة تجلس قربك
!تمامًا! ألا تفهم بالإشارات أبدًا؟

49
00:05:27,260 --> 00:05:31,140
.إنّ كرامتي كملكة النّحل تُداس هنا

50
00:05:38,770 --> 00:05:39,980
صور قطط؟

51
00:05:39,980 --> 00:05:42,900
!كما أنّه ضغط زرّ الإعجاب على تلك

52
00:05:42,900 --> 00:05:45,900
.إذًا فهذا ما يحبّه

53
00:05:46,150 --> 00:05:49,110
أتحبّ القطط يا كورويوا-كُن؟

54
00:05:50,240 --> 00:05:51,830
...كم أودّ

55
00:05:52,200 --> 00:05:53,790
...إلقاء نظرة

56
00:05:54,200 --> 00:05:56,620
!عليها معك

57
00:06:00,210 --> 00:06:01,590
أمزح فحسب... ربّما لا؟

58
00:06:01,590 --> 00:06:02,710
ما رأيك بهذا؟

59
00:06:02,960 --> 00:06:05,260
!ظريفة

60
00:06:06,300 --> 00:06:09,050
!أخبروه، أخبروه

61
00:06:10,550 --> 00:06:12,640
.حصلتُ على ردّ فعل منه

62
00:06:12,640 --> 00:06:15,020
!لا بدّ أنّ ذلك جعل قلبه يتوقّف للحظة

63
00:06:16,930 --> 00:06:18,480
.لن أريك أيّ صور

64
00:06:22,440 --> 00:06:24,020
!لا-لا بدّ أنّه يمزح

65
00:06:24,020 --> 00:06:25,900
إنّه يسخر منها؟

66
00:06:25,900 --> 00:06:28,530
!كما أنّه يتحدّث مثل القطط أيضًا

67
00:06:28,530 --> 00:06:32,870
!سـ-سحقًا لك يا كورويوا! لا تحرجها هكذا

68
00:06:32,870 --> 00:06:34,740
!لقد باركتك للتّوّ

69
00:06:34,740 --> 00:06:36,120
.اسمعي

70
00:06:36,120 --> 00:06:37,250
ماذا؟

71
00:06:37,640 --> 00:06:41,210
هل يمكنك التّوقّف عن الحديث
معي إلاّ في حالة الضّرورة؟

72
00:06:41,710 --> 00:06:43,630
!كيف يُعقل هذا؟

73
00:06:44,460 --> 00:06:46,000
.لنلعب يا مونا-تشان

74
00:06:46,000 --> 00:06:47,420
!إنّه دوري اليوم

75
00:06:47,420 --> 00:06:49,170
!ليس صحيحًا! بل دوري

76
00:06:49,550 --> 00:06:51,640
...طوال حياتي

77
00:06:52,220 --> 00:06:55,850
.أعتقد أنّي معجب بك أو ما شابه

78
00:06:56,230 --> 00:06:58,520
...طوال حياتي

79
00:06:59,560 --> 00:07:02,310
هل تعرفين ما ترمز له الورود؟

80
00:07:02,310 --> 00:07:04,270
.إنّها الرّومانسيّة

81
00:07:04,570 --> 00:07:06,730
...طوال حياتي

82
00:07:07,940 --> 00:07:12,030
!والجميع يُغرقني بالاهتمام والإعجاب

83
00:07:12,990 --> 00:07:16,330
!هذا سيّئ

84
00:07:13,370 --> 00:07:15,620
!حتّى طريقة ركضها ظريفة

85
00:07:15,620 --> 00:07:16,870
صحيح؟

86
00:07:17,790 --> 00:07:21,030
لماذا لا يمكنني أن أفتنه بعد؟

87
00:07:22,000 --> 00:07:23,830
...عليّ أن

88
00:07:26,300 --> 00:07:30,470
!انظر إلى ساقيّ القاتلين
!لا يكتفي الفتية منهما أبدًا

89
00:07:30,920 --> 00:07:32,260
!أجل

90
00:07:32,260 --> 00:07:35,300
يجعلانك ترغب في التّوقّف
والنّظر إليهما، صحيح؟

91
00:07:44,150 --> 00:07:45,610
...لا بأس

92
00:07:45,610 --> 00:07:46,730
!سأستعمل ملابسي الدّاخليّة

93
00:07:47,110 --> 00:07:49,440
مو-مونا-تشان، أأنت بخير؟

94
00:07:49,440 --> 00:07:50,940
...مو-مو

95
00:07:50,940 --> 00:07:53,820
.هذا مؤلم... لقد وقعت

96
00:07:55,320 --> 00:07:57,990
هـ-هل رأيتم شيئًا؟

97
00:08:03,710 --> 00:08:05,000
.كـ-كلاّ

98
00:08:05,000 --> 00:08:07,170
.أقسم أنّي لم أرَ شيئًا

99
00:08:07,170 --> 00:08:09,800
حتّى ذلك لم ينجح؟

100
00:08:09,800 --> 00:08:12,840
حتّى ذلك لم يكن كافيًا للنّيل منه؟

101
00:08:12,840 --> 00:08:15,390
.إ-إذًا لم يعد لديّ أيّ خيار آخر

102
00:08:15,640 --> 00:08:16,970
!إلى الملاذ الأخير

103
00:08:17,600 --> 00:08:23,230
.ما يعنيه هذا، باختصار... تعرفون المقصود

104
00:08:23,640 --> 00:08:25,060
.سينسي

105
00:08:25,520 --> 00:08:27,020
ما الخطب يا كاواي؟

106
00:08:31,440 --> 00:08:35,530
هل يمكنني الذّهاب لمكتب الممرّضة؟
.لا أشعر أنّني بخير

107
00:08:35,530 --> 00:08:38,530
.هكذا إذًا. ليرافقها أحد ما

108
00:08:38,530 --> 00:08:39,660
.سأرافقها أنا

109
00:08:42,410 --> 00:08:46,000
.لا عليك، سيرافقني كورويوا-كُن

110
00:08:46,460 --> 00:08:47,830
.لذلك لا بأس

111
00:08:47,830 --> 00:08:50,920
.هكذا إذًا؟ اعتن بها يا كورويوا

112
00:08:59,350 --> 00:09:03,060
.ظـ-ظننتُ أنّك قلتِ أنّك لا تشعرين بخير

113
00:09:04,560 --> 00:09:09,230
يا كورويوا-كُن، لا تكون ممرّضة المدرسة
.حاضرة في مثل هذا الوقت من اليوم

114
00:09:12,320 --> 00:09:16,610
.أنت أوّل فتى يجعلني أتمادى لهذا الحدّ

115
00:09:17,780 --> 00:09:21,910
أخبرني... كيف تشعر حيالي؟

116
00:09:23,750 --> 00:09:25,960
.تعاملك معي بارد دائمًا

117
00:09:25,960 --> 00:09:29,330
أنا قلقة من أنّي فعلتُ شيئًا ما
.ليجعلك تكرهني

118
00:09:29,330 --> 00:09:32,420
.كـ-كلاّ، الأمر ليس كذلك

119
00:09:32,840 --> 00:09:33,920
.أجل

120
00:09:36,590 --> 00:09:38,510
!النّصر في المتناول

121
00:09:40,100 --> 00:09:40,970
!كلاّ

122
00:09:41,540 --> 00:09:43,970
!لـ-ليس تلك النّظرة ثانية

123
00:09:46,440 --> 00:09:47,890
!فات الأوان للتّراجع الآن

124
00:09:48,730 --> 00:09:50,440
أيمكننا الحديث؟

125
00:09:50,440 --> 00:09:52,270
—اسمع، لدينا بعض الـ

126
00:10:00,490 --> 00:10:03,120
!كلاّ! لقد تجاوزتُ الحدود

127
00:10:03,120 --> 00:10:05,700
.آ-آسفة. لقد تعثّرت

128
00:10:09,580 --> 00:10:13,550
أ-أنا موجودة فوقه الآن
!ومع ذلك لا يزال غاضبًا؟

129
00:10:15,710 --> 00:10:20,640
كلاّ... من المستحيل أنّ سحر
.جمالي لا يؤثّر به على الإطلاق

130
00:10:21,850 --> 00:10:26,020
!أنا ملكة النّحل

131
00:10:26,020 --> 00:10:28,520
!ويحي، انزلقت يداي

132
00:10:28,520 --> 00:10:29,480
!ما رأيك الآن؟

133
00:10:30,770 --> 00:10:34,360
!كـ-كلاّ! لا أستطيع التّمادي أكثر

134
00:10:34,360 --> 00:10:38,360
!أظهِر تأثّرك بي بسرعة رجاءً يا ميداكا

135
00:10:39,320 --> 00:10:42,780
!ذهن نقيّ، روح نقيّة

136
00:10:46,910 --> 00:10:49,540
لِـ-لِماذا؟

137
00:10:50,170 --> 00:10:52,250
!لا... لا

138
00:10:52,250 --> 00:10:55,840
!أنت لئيم! لماذا تواصل التّحديق بي؟

139
00:11:08,270 --> 00:11:10,100
هل أنت بخير يا مونا-تشان؟

140
00:11:23,450 --> 00:11:27,740
.عـ-عفوًا، أنا بخير. يمكنك تركي الآن

141
00:11:27,990 --> 00:11:28,750
!كلاّ

142
00:11:29,450 --> 00:11:33,630
...مـ-مهلاً، لا! لم أكن أحاول أن

143
00:11:35,540 --> 00:11:38,460
.سأعود إلى الفصل

144
00:11:53,100 --> 00:12:00,360
بالمناسبة، ربّما من الأفضل أن توفّري
.تلك الأشياء لشخص تحبّينه

145
00:12:03,160 --> 00:12:05,240
...ما الّذي

146
00:12:12,960 --> 00:12:16,960
!لماذا أنا من فُتِنتُ هنا؟

147
00:12:26,890 --> 00:12:28,680
.يا مونا-تشان

148
00:12:29,180 --> 00:12:30,680
أتشعرين بتحسّن؟

149
00:12:30,970 --> 00:12:34,140
.نعم، شكرًا على السّؤال

150
00:12:38,060 --> 00:12:43,320
شـ-شكرًا لمرافقتي إلى مكتب
.الممرّضة قبل قليل

151
00:12:43,320 --> 00:12:44,320
.العفو

152
00:12:47,870 --> 00:12:50,740
لماذا أشعر وكأنّ هنالك من يحدّق بي؟

153
00:12:55,460 --> 00:12:58,840
.إضافة لذلك، لا يمكنني النّظر إليه مباشرة

154
00:12:59,460 --> 00:13:01,130
ولكن لماذا؟

155
00:13:02,210 --> 00:13:06,340
لماذا أشعر بهذا الارتباك؟

156
00:13:06,890 --> 00:13:09,850
...إنّ هذا يكاد يجعل الأمر يبدو

157
00:13:10,890 --> 00:13:14,060
.يبدو وكأنّني واقعة في حبّه أو ما شابه

158
00:13:15,350 --> 00:13:16,770
!سُحقًا

159
00:13:16,770 --> 00:13:18,100
!مونا-تشان؟

160
00:13:22,030 --> 00:13:24,610
.انتظر فحسب يا ميداكا

161
00:13:28,490 --> 00:13:34,830
!أقسم... أقسم بحياتي أنّي سأجعلك تُفتَن بي

162
00:13:48,680 --> 00:13:52,140
،يومًا بعد يوم

163
00:13:52,560 --> 00:13:55,140
.أكون أجمل

164
00:13:53,770 --> 00:13:55,140
.صباح الخير يا مونا-تشان

165
00:13:55,140 --> 00:13:56,390
.صباح الخير

166
00:13:56,390 --> 00:13:59,150
،يومًا بعد يوم

167
00:13:59,560 --> 00:14:01,690
.أكون أجمل

168
00:13:59,560 --> 00:14:01,690
.ظريفة اليوم كالعادة

169
00:14:01,960 --> 00:14:06,240
!صباح الخير

170
00:14:02,480 --> 00:14:06,650
!مونا أجمل وأجمل وأجمل

171
00:14:10,160 --> 00:14:11,410
.صباح الخير

172
00:14:12,160 --> 00:14:15,580
وصل زيّك المدرسيّ أخيرًا؟

173
00:14:15,580 --> 00:14:16,410
.نعم

174
00:14:18,620 --> 00:14:22,380
ميداكا هو الوحيد الّذي ينظر
.إليّ بنظرة اشمئزاز

175
00:14:22,380 --> 00:14:26,170
بأيّ حقّ ينظر إلى فتاة ظريفة
مثلي بنظرة عدم اهتمام؟

176
00:14:32,550 --> 00:14:34,680
هل من خطب ما يا أساهي؟

177
00:14:35,180 --> 00:14:36,470
.لا شيء

178
00:14:49,700 --> 00:14:50,660
!أجل

179
00:14:50,660 --> 00:14:52,660
!يا له من تمرين فتح حوض مثاليّ

180
00:14:52,660 --> 00:14:54,780
!احرصوا على التّمدّد جيّدًا

181
00:14:55,620 --> 00:14:57,910
!انظر إليّ يا ميداكا

182
00:14:57,910 --> 00:15:00,080
!انظر كم أنا ناهدة ومرنة

183
00:15:00,960 --> 00:15:02,500
!كورويوا-كُن

184
00:15:03,290 --> 00:15:06,050
.لنتمدّد معًا

185
00:15:06,050 --> 00:15:08,210
.أنت. إنّها تناديك

186
00:15:08,510 --> 00:15:11,430
أهنالك خطب في أذنَيْ ذلك المغفّل؟

187
00:15:11,430 --> 00:15:13,470
.يا فتيات، استعددن للّعب

188
00:15:13,890 --> 00:15:17,180
ما الّذي يمكنني أن أؤثّر به عليه؟

189
00:15:17,970 --> 00:15:19,890
،ساقاي، ومؤخّرتي

190
00:15:19,890 --> 00:15:21,900
.وحتّى صدري... لا شيء من ذلك نفع معه

191
00:15:24,940 --> 00:15:26,730
!و-وجدتها

192
00:15:27,030 --> 00:15:34,370
بالمناسبة، ربّما من الأفضل أن توفّري
.تلك الأشياء لشخص تحبّينه

193
00:15:36,030 --> 00:15:38,750
.كلاّ، لا أهتمّ

194
00:15:37,370 --> 00:15:40,370
.سأعلن عن الفِرق

195
00:15:39,660 --> 00:15:41,370
.وذلك غير مهمّ

196
00:15:41,370 --> 00:15:43,920
.سأوقعك في شباكي، مهما حدث

197
00:15:48,920 --> 00:15:50,510
.حسنًا، انتهينا

198
00:15:52,680 --> 00:15:55,760
.كم أنا متعبة

199
00:15:57,260 --> 00:15:59,220
،أنا ألمع بسبب العرق

200
00:16:01,350 --> 00:16:03,060
.كما تقوم أناملي الرّقيقة بمسحه

201
00:16:06,560 --> 00:16:08,020
...إضافة إلى

202
00:16:12,780 --> 00:16:17,450
إ-إنّ مناطق مونا-تشان المحرّمة
!المخفيّة في العادة مكشوفة الآن

203
00:16:17,450 --> 00:16:20,410
!شكرًا للآلهة

204
00:16:20,410 --> 00:16:24,500
،كلّ من صدري مؤخّرتي لم ينجحا
!لكن لا بدّ أنّه يحبّ منطقة البطن

205
00:16:24,500 --> 00:16:26,460
ما رأيك بي الآن يا ميداكا؟

206
00:16:31,380 --> 00:16:35,050
.ذهن نقيّ، روح نقيّة

207
00:16:37,180 --> 00:16:39,350
!ولكن لماذا؟

208
00:16:48,310 --> 00:16:53,320
.اسمع، لم أتبعك إلى هنا أو ما شابه يا ميداكا

209
00:16:53,320 --> 00:16:59,950
أردتُ فقط أن أنظر جيّدًا للفتى
.الّذي استطاع مقاومة سحر جمالي

210
00:17:05,620 --> 00:17:10,380
.أجل، عرفتُ هذا. لن ينظر إليّ حتّى

211
00:17:12,010 --> 00:17:13,720
.سُحقًا

212
00:17:14,630 --> 00:17:16,430
.اكتفيتُ اليوم

213
00:17:34,440 --> 00:17:37,490
هل كان عاجزًا عن إشاحة نظهره عنّي للتّوّ؟

214
00:17:40,950 --> 00:17:43,230
...قبضتُ على يدي بالخطأ

215
00:17:50,090 --> 00:17:50,670
ماذا؟

216
00:17:52,130 --> 00:17:53,800
!كلاّ

217
00:17:54,090 --> 00:17:56,090
!لا! لا، لا

218
00:17:56,510 --> 00:17:57,550
...أنا

219
00:17:57,550 --> 00:18:01,220
!هذا ليس جيّدًا! إنّي أُظهر أكثر ممّا يجب

220
00:18:01,220 --> 00:18:03,850
!لا يوجد ما هو أسوأ

221
00:18:03,850 --> 00:18:07,440
!لماذا عليّ إحراج نفسي هكذا من أجل ميداكا؟

222
00:18:17,990 --> 00:18:19,910
.ارتدي هذا

223
00:18:28,750 --> 00:18:31,840
.سوف... أعود الآن

224
00:18:34,710 --> 00:18:37,550
.شـ... شكرًا لك

225
00:18:39,990 --> 00:18:40,980
.العفو

226
00:18:43,350 --> 00:18:47,480
!هكذا يكون التّأثير بمنطقة البطن على الآخرين

227
00:18:51,100 --> 00:18:54,270
أعطاها كورويوا-كُن قميص الرّياضة خاصّته؟

228
00:19:04,330 --> 00:19:07,750
.مهلاً، لا بدّ أنّ رائحة القميص نتنة

229
00:19:09,870 --> 00:19:10,830
!مهلاً

230
00:19:10,830 --> 00:19:12,630
.كورويوا ميداكا

231
00:19:12,630 --> 00:19:13,540
ماذا؟

232
00:19:13,540 --> 00:19:18,460
كورويوا -كُن، ألا تظنّ أنّك تتصرّف
بلؤم شديد مع مونا-تشان؟

233
00:19:21,470 --> 00:19:26,720
،إنّها تحاول جاهدة أن تكون ودودة
.أتدري؟ أحسن التّصرّف معها

234
00:19:26,720 --> 00:19:28,140
.تعال معنا لبعض الوقت

235
00:19:41,780 --> 00:19:43,740
!وريث معبد؟

236
00:19:43,740 --> 00:19:46,330
.نعم، معبد قطّ

237
00:19:46,330 --> 00:19:49,200
.ممنوع عليّ الاقتراب كثيرًا من الفتيات

238
00:19:49,580 --> 00:19:52,460
أي أنّه لم تكن لديك حبيبة من قبل؟

239
00:19:53,880 --> 00:19:57,800
.لم يكن هنالك إلاّ عجائز وماعز حيث أعيش

240
00:20:00,300 --> 00:20:04,300
.لا أعرف حتّى بماذا أحدّث الفتيات

241
00:20:06,600 --> 00:20:07,810
.مفهوم

242
00:20:07,810 --> 00:20:10,560
.لا عجب أنّ الأمر انتهى بك بالتّصرّف بلؤم معها

243
00:20:12,270 --> 00:20:16,560
لم أرَ فتيات ظريفات وجميلات
.مثلها إلاّ على التّلفاز

244
00:20:16,560 --> 00:20:18,520
.لكنّ ذلك ليس كلّ شيء

245
00:20:26,410 --> 00:20:28,120
...إنّ طوكيو

246
00:20:29,290 --> 00:20:31,750
!مليئة بالإغراءات الدّنيويّة

247
00:20:31,750 --> 00:20:36,750
ولكن من المؤكّد أنّك لن تُعاقَب
.إن حاولتَ التّصرّف بلطف أكثر

248
00:20:37,460 --> 00:20:39,940
.نعم، ربّما

249
00:20:39,940 --> 00:20:42,420
،بصراحة، حسب سير الأمور

250
00:20:42,420 --> 00:20:44,180
!فسأقع في شباكها

251
00:20:44,180 --> 00:20:47,300
!لكن لا يمكنني ذلك! كرّستُ حياتي للدّين

252
00:20:47,300 --> 00:20:50,060
!وعقائدي تحرّم الرّومانسيّة

253
00:20:51,680 --> 00:20:52,520
.لقد تسمّر في مكانه

254
00:20:52,980 --> 00:20:57,650
...ولكن عندما أتخيّل مواعدة فتاة مثلها

255
00:20:58,820 --> 00:21:00,150
.كلاّ، هذا مريب

256
00:21:01,360 --> 00:21:03,070
!اختفي أيّها الأفكار النّجسة

257
00:21:04,200 --> 00:21:14,410
.ذهن نقيّ، روح نقيّة

258
00:21:08,910 --> 00:21:12,450
إذًا فهو يحاول تصفية ذهنه
عندما تعلو وجهه تلك التّعابير؟

259
00:21:13,080 --> 00:21:15,620
كان يبذل جهده ليقاوم، صحيح؟

260
00:21:15,900 --> 00:21:18,790
.تذكّر، أنت في مرحلة التّدريب

261
00:21:18,790 --> 00:21:22,760
انتقلتُ إلى مدرسة مختلطة
!فقط لصقل عقلي

262
00:21:23,360 --> 00:21:27,390
عليّ أن أعيش حياتي بلا أيّ إغراءات
!أو رغبات دنيويّة

263
00:21:32,140 --> 00:21:33,220
!صباح الخير

264
00:21:33,980 --> 00:21:35,890
.شكرًا على البارحة

265
00:21:35,890 --> 00:21:37,310
.أ-أكيد

266
00:21:37,980 --> 00:21:39,810
.لا تقلق، لقد غسلتُه

267
00:21:39,810 --> 00:21:42,190
.لـ-لم يكن عليك ذلك

268
00:21:45,740 --> 00:21:48,870
هل كنت تريدني أن أعيده ورائحتي تفوح منه؟

269
00:21:50,240 --> 00:21:54,830
!ذهن نقيّ، روح نقيّة

270
00:21:55,460 --> 00:21:59,170
.أنا كاواي مونا، في السّابعة عشرة
.ولدتُ وتربّيتُ في أوساكا

271
00:21:59,170 --> 00:22:01,000
.انتقلتُ إلى طوكيو قبل سنة

272
00:22:01,000 --> 00:22:04,960
لم ألتق طوال حياتي بفتى
.استطاع مقاومة سحر جمالي

273
00:22:05,380 --> 00:22:09,970
أقسم أنّي سأوقعك في شباكي
!يا كورويوا ميداكا

274
00:23:46,820 --> 00:23:49,590
."في الحلقة القادمة: "واقعة في حبّه