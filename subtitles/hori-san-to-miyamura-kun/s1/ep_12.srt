1
00:00:07,210 --> 00:00:10,770
.ذهبتُ لمنزل تورو أمس لأول مرة

2
00:00:10,800 --> 00:00:13,480
!حقًا؟! وماذا حدث بعدها؟

3
00:00:13,510 --> 00:00:16,360
.لم نتحدث عن شيءٍ كهذا

4
00:00:16,390 --> 00:00:19,570
،ولكن كان لديه تلفازًا ضخمًا معلقًا على حائطه

5
00:00:19,600 --> 00:00:22,030
...والعديد من الغرف الفارغة في الطابق الثاني والثالث من بيته

6
00:00:22,060 --> 00:00:23,820
!ظننته من العامة الفقراء مثلي

7
00:00:23,850 --> 00:00:25,700
...لـ- لا عليكِ

8
00:00:25,730 --> 00:00:27,530
ما الخطب؟

9
00:00:27,560 --> 00:00:28,790
!اخرس أيها الغني

10
00:00:28,820 --> 00:00:30,340
ما بالك؟

11
00:00:29,400 --> 00:00:30,910
أتريدين طلب كعكة؟

12
00:00:30,940 --> 00:00:33,250
.أجل، فقد نسيت حجز واحدة هذا العام

13
00:00:33,280 --> 00:00:35,040
.سيكون كل شيءٍ على ما يرام

14
00:00:35,070 --> 00:00:39,670
،لا نحصل على الكثير من الحجوزات
.لذا فنحن لم نتأخر

15
00:00:39,700 --> 00:00:41,460
أي نوعٍ من الكعك تريدين؟

16
00:00:41,490 --> 00:00:44,220
!إذَن أريد واحدة عليها الكثير من القشدة

17
00:00:44,250 --> 00:00:45,310
.حسنًا

18
00:00:48,080 --> 00:00:50,770
!دعوتُ يونا-تشان لقضاء عيد الميلاد معنا

19
00:00:50,800 --> 00:00:54,350
...إذَن ستحضر أنتَ ويونا-تشان وميامورا

20
00:00:54,380 --> 00:00:56,600
مهلًا، أسيستطيع ميامورا المجيء؟

21
00:00:56,630 --> 00:01:00,360
.عليكِ دعوته بالتأكيد

22
00:01:00,390 --> 00:01:05,280
،لا أهتم إن لم تقدري على الحضور
.ولكن احرصي على مجيء ميامورا

23
00:01:05,310 --> 00:01:07,830
.يبدو أنك ستنام على الرصيف في عيد الميلاد هذا

24
00:01:09,190 --> 00:01:11,290
عيد الميلاد؟

25
00:01:11,320 --> 00:01:14,590
.سأكون مشغولٌ على الأغلب في المتجر بداية من يوم 23

26
00:01:15,070 --> 00:01:16,790
.مـ- معك حق

27
00:01:16,820 --> 00:01:20,590
!ولكن إن تفرغتُ سآتي حتمًا

28
00:01:20,620 --> 00:01:23,260
.لا عليك، فلا يجب أن تضغط وقتك من أجلي

29
00:01:23,290 --> 00:01:25,680
.فبمجرد تناول العشاء سينتهي اليوم

30
00:01:25,710 --> 00:01:26,840
.أعتذر

31
00:01:26,870 --> 00:01:29,720
ماذا؟! ألن تأتي في عيد الميلاد يا ميامورا-كن؟

32
00:01:29,750 --> 00:01:33,390
.أعتذر، لكن لدي أعمال كثيرة أؤديها بالمنزل اليوم

33
00:01:33,420 --> 00:01:37,440
!ألن تأتي في عيد الميلاد؟
!تعال أرجوك! أريدك أن تأتي

34
00:01:37,470 --> 00:01:39,520
...أ- آسف يا سوتا

35
00:01:39,550 --> 00:01:40,610
!غير موافق

36
00:01:40,640 --> 00:01:41,440
!أنا حقًا آسف

37
00:01:41,470 --> 00:01:42,690
!أخي الكبير

38
00:01:42,720 --> 00:01:44,240
!ميامورا-كن

39
00:01:44,270 --> 00:01:46,150
!أخي الكبير

40
00:01:46,180 --> 00:01:47,910
ألا تعلمان أنه يواعدني أنا؟

41
00:01:47,940 --> 00:01:49,320
!ميامورا-كن

42
00:01:49,350 --> 00:01:52,020
!أخي الكبير

43
00:02:03,600 --> 00:02:15,820
هوريميا

44
00:03:24,990 --> 00:03:28,520
.كما تعلمان، منذ فترة وأنا معجبٌ بهوري

45
00:03:29,870 --> 00:03:31,180
منذ فترة؟

46
00:03:31,210 --> 00:03:34,140
.ظننته قد نسيها منذ زمن

47
00:03:34,170 --> 00:03:37,180
أتعلمان أيضًا ما حدث مع كونو-سان؟

48
00:03:37,210 --> 00:03:39,230
لمَ يظننا نعلم بشأن ما حدث؟

49
00:03:39,260 --> 00:03:42,520
.لا علم لي بما حدث مع كونو-سان

50
00:03:42,550 --> 00:03:45,610
،أما أنا ويوشيكاوا أكثر من مجرد صديقين

51
00:03:45,640 --> 00:03:48,110
.لكن ليس وكأنني أواعدها أو ما شابه

52
00:03:48,140 --> 00:03:48,910
ماذا؟
ماذا؟

53
00:03:49,320 --> 00:03:55,290
ماذا؟

54
00:03:55,690 --> 00:03:57,910
.ظننتهما يتواعدان سلفًا

55
00:03:57,940 --> 00:04:00,660
!كنتُ أعلم أن هذه ستكون ردة فعلكما

56
00:04:00,690 --> 00:04:05,300
!علمتُ أنكما ستظنان: ظننتهما يتواعدان سلفًا

57
00:04:05,740 --> 00:04:08,550
!كُف عن الظن وإلا أصبتَ إيورا-كن بتمدد في الأوعية الدموية

58
00:04:08,580 --> 00:04:10,340
...ظننتَ... ظننتَ

59
00:04:10,370 --> 00:04:12,550
!في الحقيقة، نحن لا نتواعد

60
00:04:12,580 --> 00:04:15,260
أتفهم ذلك، ولكن ألستَ معجبًا بها؟

61
00:04:15,290 --> 00:04:16,890
!بالطبع تعجبني

62
00:04:16,920 --> 00:04:19,820
كيف لا يحرجك قولها بصوتٍ عال؟

63
00:04:20,550 --> 00:04:23,320
أتظنان الأمر غريبًا؟

64
00:04:23,840 --> 00:04:27,190
.ليس غريبًا لكني متفاجئ

65
00:04:27,220 --> 00:04:31,530
،ما أريد قوله إن عليك القلق بشان رأيها هي

66
00:04:31,560 --> 00:04:34,880
.بدلًا من رأينا فيك

67
00:04:35,560 --> 00:04:41,080
.إن كنتما سعيدان بعلاقتكما الحالية فلا بأس

68
00:04:41,110 --> 00:04:43,720
.فليس دوري أن أخبركما ما هو صواب وما هو خاطئ

69
00:04:44,740 --> 00:04:46,380
ماذا؟

70
00:04:46,410 --> 00:04:48,250
!أنت رائع يا سينجوكو-سان

71
00:04:48,280 --> 00:04:51,920
.تأتيك النصائح بواقعٍ مُختلف حين يقولها سيد الغرام

72
00:04:51,950 --> 00:04:54,660
!متى صرتُ "سيد الغرام"؟

73
00:04:59,920 --> 00:05:02,600
!وجدتكَ يا تورو

74
00:05:02,630 --> 00:05:05,020
هل يمكنني أن آتي وألعب بألعاب الفيديو في منزلك اليوم؟

75
00:05:05,050 --> 00:05:07,360
.أود إنهاء اللعبة التي بدأناها منذ فترة

76
00:05:07,390 --> 00:05:08,430
حقًا؟

77
00:05:08,430 --> 00:05:11,080
.ولمَ لا؟ يمكنكِ المجيء

78
00:05:12,350 --> 00:05:14,450
...مهلًا، ليس اليوم

79
00:05:14,480 --> 00:05:16,450
هل أنت مشغولٌ اليوم؟

80
00:05:16,480 --> 00:05:19,490
.لستُ مشغولًا

81
00:05:19,520 --> 00:05:21,230
...ولكن هناك أمرٌ آخر

82
00:05:22,730 --> 00:05:25,170
.لا عليكِ، يمكنكِ المجيء

83
00:05:25,200 --> 00:05:28,210
!أكيد؟ لا مشكلة إن كنتَ مشغولًا اليوم

84
00:05:28,240 --> 00:05:32,010
...كلا، فسيحدث هذا عاجلًا أم آجلًا

85
00:05:33,660 --> 00:05:36,270
.أتفاجأ بحجم منزلك في كل مرة

86
00:05:38,580 --> 00:05:40,600
.عدتُ إلى المنزل

87
00:05:40,630 --> 00:05:42,140
لمَ تهمس؟

88
00:05:42,170 --> 00:05:45,160
.هيا يا يوشيكاوا، أسرعي إلى الأعلى

89
00:05:45,160 --> 00:05:46,480
!هيا أسرعي

90
00:05:46,510 --> 00:05:47,930
ماذا؟

91
00:05:48,340 --> 00:05:50,190
!هيا أسرعي

92
00:05:51,350 --> 00:05:54,110
!لمَ هذا الممر طويلٌ جدًا؟

93
00:05:54,140 --> 00:05:58,910
.لعل والداه في المنزل

94
00:05:58,940 --> 00:06:01,700
ألا يريدني أن أقابلهما؟

95
00:06:01,730 --> 00:06:04,830
.أعتذر على تعجيلك يا يوشيكاوا

96
00:06:04,860 --> 00:06:08,460
.لا عليك، ليتني كنتُ فتًى مثيرًا

97
00:06:08,490 --> 00:06:12,890
مهلًا، ماذا؟ عمّ تتحدثين يا يوشيكاوا؟

98
00:06:13,490 --> 00:06:16,090
...أعني أنني لو كنتُ

99
00:06:16,120 --> 00:06:18,680
مـ- مهلًا، لم تُغلق الباب بالمفتاح؟

100
00:06:18,710 --> 00:06:21,550
ماذا؟ وما المشكلة...؟

101
00:06:21,580 --> 00:06:23,890
!لـ- لمَ تفك ربطة عنقك؟

102
00:06:23,920 --> 00:06:25,100
!ماذا؟

103
00:06:25,130 --> 00:06:28,400
.دائمًا ما أخلع ربطة عنقي عند عودتي للمنزل

104
00:06:31,050 --> 00:06:32,160
...يوشيكاوا

105
00:06:37,980 --> 00:06:39,270
.تفضلي

106
00:06:40,270 --> 00:06:41,370
ماذا؟

107
00:06:41,400 --> 00:06:44,410
،لن أحاول فعل شيءٍ مريب معكِ

108
00:06:44,440 --> 00:06:47,590
.ولا أريدك أن تشعري بعدم الراحة هنا

109
00:06:49,890 --> 00:06:52,960
.لا أدري أي خطأ ارتكبت

110
00:06:52,990 --> 00:06:54,880
!هـ- هذا ليس خطأك

111
00:06:55,580 --> 00:07:00,460
.لستُ خائفة أو غير مرتاحة أو ما شابه

112
00:07:00,460 --> 00:07:03,190
حقًا؟

113
00:07:03,540 --> 00:07:05,350
.أجل

114
00:07:05,380 --> 00:07:07,070
.حسنًا

115
00:07:10,300 --> 00:07:11,810
تورو-كن؟

116
00:07:11,840 --> 00:07:13,820
!لقد نسيت

117
00:07:13,850 --> 00:07:14,640
ماذا؟

118
00:07:14,640 --> 00:07:18,030
هذا غريب، لمَ تغلق الباب في وجهي؟

119
00:07:18,060 --> 00:07:18,990
هل أحضرتَ صديقًا؟

120
00:07:19,020 --> 00:07:23,990
!هذا صحيح! لذا لا تقتحمي الغرفة

121
00:07:24,020 --> 00:07:27,090
!أهذه والدتك؟ أهي والدتك؟

122
00:07:27,480 --> 00:07:30,540
!إذَن دعني أحضر لكما مشروبًا

123
00:07:30,570 --> 00:07:33,040
!لا، شكرًا! لا نريد شرب شيء

124
00:07:33,070 --> 00:07:34,960
.أوقفت الباب بقدمها

125
00:07:34,990 --> 00:07:37,760
!ما بالك فظٌ مع ضيفك؟

126
00:07:37,790 --> 00:07:41,040
!يمكنني الرحيل إن كنتُ سأسبب إزعاجًا يا تورو

127
00:07:41,750 --> 00:07:44,220
!لن تسببي إزعاجًا! فقط ابقي مكانك يا يوشيكاوا

128
00:07:44,250 --> 00:07:46,220
!حسنًا

129
00:07:46,250 --> 00:07:48,380
إذَن فاسمها يوشيكاوا-سان؟

130
00:07:49,590 --> 00:07:51,350
أتحبين الكعك؟

131
00:07:51,380 --> 00:07:53,060
.أ- أجل

132
00:07:53,090 --> 00:07:54,560
.سأحضر لكِ بعضًا إذَن

133
00:07:54,590 --> 00:07:56,780
!أخبرتكِ أننا لا نريد شيئًا

134
00:07:56,810 --> 00:07:58,440
مَن تكون هي؟

135
00:07:56,810 --> 00:07:59,120
!ولكنها ضيفتنا

136
00:07:58,470 --> 00:08:01,620
!وما أطولها

137
00:08:02,140 --> 00:08:04,280
.سأذهب إذَن لإحضار الكعك

138
00:08:04,310 --> 00:08:05,660
.طيب

139
00:08:05,690 --> 00:08:08,610
.ولا تدخلي دون قرع الباب مجددًا

140
00:08:09,610 --> 00:08:12,500
!ألن تذهبي لجلب الكعك؟

141
00:08:12,530 --> 00:08:15,740
.حسنًا، يا لك من عجول

142
00:08:18,080 --> 00:08:19,520
أهذه والدتك؟

143
00:08:20,120 --> 00:08:21,500
.بالطبع لا

144
00:08:21,500 --> 00:08:24,770
.إنها تساعدنا فقط في أعمال المنزل واسمها ياشيرو-سان

145
00:08:25,460 --> 00:08:28,670
.دائمًا ما تنهال علي بأسئلةٍ عنكِ

146
00:08:28,670 --> 00:08:29,420
حقًا؟

147
00:08:29,420 --> 00:08:32,520
مثل: مع مَن كنتَ تتمشي ذلك اليوم؟

148
00:08:32,550 --> 00:08:35,280
ومَن تلك الفتاة التي تدعوها دومًا؟

149
00:08:35,890 --> 00:08:37,610
.إنها حقًا غريبة

150
00:08:37,640 --> 00:08:40,240
عمن تتحدث؟ أتقصدني؟

151
00:08:40,270 --> 00:08:42,950
.أخبرتكِ أن تقرعي الباب

152
00:08:42,980 --> 00:08:44,410
.لا عليك

153
00:08:44,980 --> 00:08:48,620
أتفضلين كعكة الفراولة أم كعكة الجبن؟

154
00:08:48,650 --> 00:08:51,420
.كعكة الفراولة... بل كعكة الجبن

155
00:08:53,700 --> 00:08:57,880
.تورو-كن، إن حاولتَ فعل شيءٍ ما فسأخبر والدتك

156
00:08:57,910 --> 00:09:01,550
!لن أحاول فعل أي شيءٍ وأنا أعلم بوجودكِ هنا يا ياشيرو-سان

157
00:09:01,580 --> 00:09:03,590
!نادياني إن احتجتما شيئًا

158
00:09:03,620 --> 00:09:05,640
.حسنًا

159
00:09:05,670 --> 00:09:07,760
.أ- أعتذر

160
00:09:07,790 --> 00:09:11,730
.إنها متحمسة لإحضاري فتاةً إلى البيت

161
00:09:11,760 --> 00:09:13,180
.ولكنها طيبة

162
00:09:13,210 --> 00:09:14,190
.لا مشكلة

163
00:09:14,670 --> 00:09:18,840
!لن أحاول فعل أي شيءٍ وأنا أعلم بوجودكِ هنا يا ياشيرو-سان

164
00:09:19,700 --> 00:09:24,200
دوران دوران دوران

165
00:09:20,100 --> 00:09:24,020
...إ- إذَن لولا وجودها هنا لكان قد فـ- فـ- فـ

166
00:09:24,020 --> 00:09:25,740
يوشيكاوا؟

167
00:09:25,770 --> 00:09:28,740
!ماذا؟! هل أغضبكِ شيءٌ مجددًا؟

168
00:09:28,770 --> 00:09:29,740
ما الخطب؟

169
00:09:29,770 --> 00:09:31,710
!لـ- لا خطب بي

170
00:09:33,530 --> 00:09:36,700
!ماذا بكَ؟! كف عن التحديق بي

171
00:09:45,000 --> 00:09:46,500
مسح مسح مسح

172
00:09:48,540 --> 00:09:50,820
ألم تأتي للعب؟

173
00:09:54,050 --> 00:09:55,220
!هذا صحيح

174
00:09:56,220 --> 00:09:58,730
!سأنهيها اليوم

175
00:09:58,760 --> 00:10:01,730
!شغل اللعبة يا تورو

176
00:10:01,760 --> 00:10:05,890
.أنا سعيدٌ بوضعنا الحالي

177
00:10:08,140 --> 00:10:11,990
.كعك ذلك المخبز رائع! لذا كُلا ما طاب لكما

178
00:10:12,020 --> 00:10:16,130
مخبز إيوري

179
00:10:12,770 --> 00:10:15,660
.إنها من مخبز ميامورا

180
00:10:19,010 --> 00:10:21,510
غرفة مجلس الطلبة

181
00:10:22,580 --> 00:10:24,010
!سينجوكو-كن

182
00:10:24,410 --> 00:10:25,380
فزع

183
00:10:25,580 --> 00:10:26,880
.مرحبًا ريمي

184
00:10:26,910 --> 00:10:28,260
!ويحك

185
00:10:28,290 --> 00:10:29,720
ما خطبك يا صاح؟

186
00:10:29,750 --> 00:10:31,290
.أعتذر

187
00:10:32,460 --> 00:10:34,140
...قل لي

188
00:10:34,170 --> 00:10:37,660
ما رأيك أن تأتي إلي منزلي في عيد الميلاد؟

189
00:10:39,130 --> 00:10:40,230
ماذا؟

190
00:10:40,260 --> 00:10:42,380
.تعال معي في عيد الميلاد

191
00:10:41,180 --> 00:10:43,050
ماذا؟ ماذا؟

192
00:10:43,050 --> 00:10:43,730
...سين

193
00:10:43,760 --> 00:10:44,680
ماذا؟

194
00:10:45,470 --> 00:10:47,540
ألا يمكنكِ المجيء إلى منزلي أنا؟

195
00:10:48,100 --> 00:10:50,280
!أريد قضاءه في غرفتي

196
00:10:50,310 --> 00:10:52,290
...لـ- لا، لا يمكنني

197
00:10:56,280 --> 00:10:57,260
!سينجوكو أيها الوغد

198
00:10:57,260 --> 00:10:58,700
!لقد أبكيتها

199
00:10:59,610 --> 00:11:01,380
.لا عليكِ يا ريمي-تشان

200
00:11:01,410 --> 00:11:02,920
.لا بد أن الأمر كان صادمًا

201
00:11:02,950 --> 00:11:05,800
!عليك به يا ميامورا! ابعث فيه شيئًا من العقلانية

202
00:11:05,830 --> 00:11:07,200
!بكل سرور

203
00:11:07,910 --> 00:11:10,890
.مهلًا، لنسأله عن سبب عدم رغبته في الذهاب أولًا

204
00:11:10,920 --> 00:11:12,760
!أنتم لا تعلمون شيئًا

205
00:11:12,790 --> 00:11:15,310
!لو كنتم تعلمون لتفهمتم

206
00:11:15,340 --> 00:11:18,940
!لا أريد حتى التحدث في هذا الشأن ولكن سأخبركم

207
00:11:21,430 --> 00:11:23,390
.أهلًا وسهلًا

208
00:11:24,300 --> 00:11:25,970
الكثير من الحشرات

209
00:11:26,350 --> 00:11:29,240
!السرعوف، السرعوف يحدق فيّ

210
00:11:29,270 --> 00:11:31,950
!أ- أنت مخطئ! فهي لأبي وليست لي

211
00:11:31,950 --> 00:11:33,370
!سأزيلهم

212
00:11:33,400 --> 00:11:35,440
سرعوف...؟

213
00:11:36,820 --> 00:11:39,180
أحضرتِ اجتماع نهاية الفصل الدراسي اليوم؟

214
00:11:39,180 --> 00:11:40,540
كيف كان؟

215
00:11:42,240 --> 00:11:44,240
بطاقة تقرير الفصل الدراسي لهوري كيوكو

216
00:11:44,320 --> 00:11:48,670
انظر! لقد حصلت على علامة كاملة في كل المواد
!ما عدا مادتي الفنون والتربية البدنية

217
00:11:48,700 --> 00:11:51,930
.يبدو أن كيوكو ذكيةٌ كوالدها

218
00:11:51,960 --> 00:11:55,430
،لا أتفق معك دائمًا لكنك محق

219
00:11:55,460 --> 00:11:57,640
.يبدو أنها ورثت قدراتك في الرياضيات أيضًا

220
00:11:57,670 --> 00:11:59,230
ما بال تلك المقدمة؟

221
00:11:59,260 --> 00:12:02,060
!يا لها من لحظةٍ عاطفية

222
00:12:02,090 --> 00:12:02,810
لماذا؟

223
00:12:02,840 --> 00:12:04,520
.مهلًا يا يوري-تشان، ردي علي

224
00:12:04,550 --> 00:12:09,240
المرة القادمة التي تحصلين فيها على درجاتكِ
!سيكون يوم تخرجك

225
00:12:12,020 --> 00:12:14,980
!أخفقتِ في العديد من الاختبارات في بداية عامكِ الأخير

226
00:12:12,560 --> 00:12:14,450
،هذا صحيح

227
00:12:14,480 --> 00:12:17,680
.لن أكون طالبة ثانوية بدايةً من إبريل القادم

228
00:12:14,980 --> 00:12:18,600
.لكَم أمقتُ فيك تذكرك للتفاصيل التافهة

229
00:12:18,610 --> 00:12:20,250
!انظري يا أختي

230
00:12:20,280 --> 00:12:22,260
!مدهش، أحسنت صنعًا

231
00:12:23,570 --> 00:12:28,010
.أتساءل عما سأفعله العام القادم في مثل هذا الوقت

232
00:12:29,160 --> 00:12:33,230
بعد تخرجي... كيف ستكون حياتي؟

233
00:12:34,210 --> 00:12:39,180
!أختاه، أتنظرين؟ انظري إلى درجاتي

234
00:12:39,210 --> 00:12:43,350
مهلًا، قلتِ توًا إن كلينا برع في الرياضيات! أتستمعين أصلًا؟

235
00:12:39,300 --> 00:12:43,350
أتستمعين إلي؟

236
00:12:43,380 --> 00:12:44,660
!اخرسوا

237
00:12:47,350 --> 00:12:49,280
!شكرًا على مجيئك

238
00:13:01,690 --> 00:13:03,940
...يا لها من شجرة عيد ميلاد ضخمة

239
00:13:05,360 --> 00:13:07,590
.احذر أين تسير وإلا تعثرت

240
00:13:07,620 --> 00:13:10,660
!أنت أخت يوشيكاوا-سان الكبيرة

241
00:13:11,660 --> 00:13:14,340
.أنت لا ترتدي نظاراتك اليوم

242
00:13:14,370 --> 00:13:16,970
.أنا أرتدي عدساتٍ لاصقة

243
00:13:17,000 --> 00:13:21,560
.تبدو جيدة، سأفكر في شراء عدساتٍ لاصقة

244
00:13:21,590 --> 00:13:24,640
أترغبين في أن أشتري لكِ زوجين؟

245
00:13:24,670 --> 00:13:25,940
لماذا؟

246
00:13:25,970 --> 00:13:27,950
.لأن اليوم هو عيد الميلاد

247
00:13:28,050 --> 00:13:32,200
من الغريب أن يشتري طالب ثانوية
.عدساتٍ لاصقة لطالبة جامعية

248
00:13:32,560 --> 00:13:34,320
لمَ ترتدين زيًا رسميًا اليوم؟

249
00:13:34,350 --> 00:13:38,160
.كنتُ أقوم بمقابلات عمل، الأمر حقًا متعب

250
00:13:38,190 --> 00:13:41,820
.بينما تقضي أختي الغبية كل وقتها في التسكع

251
00:13:44,740 --> 00:13:47,380
.يمكنك الضحك، الأمر مُضحك لأنه حقيقي

252
00:13:47,410 --> 00:13:51,000
.اضحك فهي أغبى من كومة حجارة

253
00:13:51,030 --> 00:13:53,700
...كلا، أعني

254
00:13:55,910 --> 00:13:58,710
...لنلقي نظرةً

255
00:14:00,420 --> 00:14:02,970
أتريدني أن أشتري لك بعض الحلوى؟

256
00:14:03,000 --> 00:14:04,100
.لا، شكرًا

257
00:14:04,130 --> 00:14:09,400
!ابتعد عن طريقي يا أخي
!كيف لي أن أشاهد التلفاز؟

258
00:14:09,430 --> 00:14:12,320
!كيف تكلمني بهذا الأسلوب؟
!لا أهتم أن كنتَ أخي، سأقتلك

259
00:14:12,350 --> 00:14:15,740
!وألقِ مناديلك المقرفة في سلة المهملات أيها الغبي

260
00:14:15,770 --> 00:14:19,540
!ألقيتُها في السلة ولكن كيكو أخرجها

261
00:14:20,190 --> 00:14:23,400
!طبعًا

262
00:14:24,610 --> 00:14:27,460
!لقد انتهى، اللعنة

263
00:14:27,490 --> 00:14:30,320
!أبعد جراثيمك عني

264
00:14:34,660 --> 00:14:36,630
اختبار الثانوية في الكانجي

265
00:14:36,660 --> 00:14:38,540
مراجعة الرياضيات للمرحلة المتوسطة

266
00:14:41,080 --> 00:14:43,850
.حان وقت العشاء يا موتو

267
00:14:43,880 --> 00:14:45,920
.حسنًا

268
00:14:47,050 --> 00:14:48,900
!يا لكل هذا الطعام

269
00:14:50,220 --> 00:14:51,780
!سينجوكو-كن

270
00:14:54,640 --> 00:14:57,360
.الحشرات ليست بذلك السوء

271
00:14:57,390 --> 00:15:01,790
.ألن تقابل ريمي في السابعة؟ الساعة السادسة والنصف الآن

272
00:15:02,730 --> 00:15:06,290
أستقضين عيد الميلاد وحدكِ يا ساكورا؟

273
00:15:06,320 --> 00:15:08,920
!هذا ما أفعله كل عام! فأنا بوذية

274
00:15:10,610 --> 00:15:12,280
.سأذهب إذَن

275
00:15:16,080 --> 00:15:17,260
!ماذا حدث؟

276
00:15:17,290 --> 00:15:17,920
انهيار

277
00:15:17,290 --> 00:15:21,800
!كيف سأتناول العشاء بعد رؤية تلك الحشرات أمامي؟

278
00:15:21,830 --> 00:15:25,170
.لن تتناول العشاء مع الحشرات بل مع ريمي

279
00:15:29,050 --> 00:15:32,160
.ربما سأعيد السنة وأتخلف عن البقية

280
00:15:34,680 --> 00:15:38,110
.أسرع وتخرج يا كويتشي

281
00:15:38,140 --> 00:15:40,100
.أتمنى لو أستطيع

282
00:15:46,420 --> 00:15:49,710
.انتظريني لعامٍ آخر

283
00:15:52,320 --> 00:15:54,370
عامٌ واحد فقط، اتفقنا؟

284
00:15:55,580 --> 00:15:59,220
!أخبرتكم يا جماعة أن ميامورا مشغول

285
00:15:59,580 --> 00:16:02,640
.وما في ذلك؟ فإحضاره إلى هنا مهمتكِ

286
00:16:02,670 --> 00:16:04,350
أتريدن مني الإضرار بمبيعاتهم في عيد الميلاد؟

287
00:16:04,880 --> 00:16:07,430
.ولكنه سيأتي لإحضار كعكة

288
00:16:07,460 --> 00:16:09,600
!حقًا؟

289
00:16:09,630 --> 00:16:11,980
أتظنين أنه سيدخل؟

290
00:16:12,010 --> 00:16:15,400
.لا أعلم، غالبًا سيبقى على الباب

291
00:16:15,430 --> 00:16:17,360
.هذا جد مؤسف

292
00:16:17,390 --> 00:16:19,900
!لـ- لست حزينة إن كنتِ قلقةً عليّ

293
00:16:19,930 --> 00:16:22,820
.ولكننا نشعر بالحزن

294
00:16:26,440 --> 00:16:27,910
.أختاه

295
00:16:27,940 --> 00:16:30,360
.شكرًا لكِ

296
00:16:30,880 --> 00:16:33,130
رسالة جديدة من: ميامورا

297
00:16:31,740 --> 00:16:33,290
!إنه ميامورا

298
00:16:33,320 --> 00:16:36,290
!مرحى، إن ميامورا هنا

299
00:16:36,320 --> 00:16:37,840
.مرحبًا

300
00:16:37,870 --> 00:16:39,550
!لنلعب بأوراق اللعب يا أخي

301
00:16:39,580 --> 00:16:40,880
!أجل

302
00:16:40,910 --> 00:16:43,600
.أعتذر ولكن لا أستطيع البقاء

303
00:16:44,580 --> 00:16:47,720
!إن يداك باردتان، تعال وأدفئهما

304
00:16:47,750 --> 00:16:50,270
!سأجلب لك مشروبًا دافئًا

305
00:16:50,300 --> 00:16:53,810
.حسنًا، ولكني سأرحل مباشرةً بعد شربه

306
00:16:53,840 --> 00:16:55,940
!مرحى، لنلعب لعبة الخادمة العجوزة

307
00:16:55,970 --> 00:16:58,640
.اليوم مختلفٌ عما كان العام الماضي

308
00:16:59,140 --> 00:17:00,860
بعد ساعة

309
00:17:00,890 --> 00:17:03,870
مُنهك

310
00:17:01,270 --> 00:17:04,160
.المعذرة، عليّ العودة حقًا

311
00:17:04,190 --> 00:17:05,450
!ماذا؟

312
00:17:05,480 --> 00:17:06,570
."لا تقولوا "ماذا

313
00:17:06,600 --> 00:17:07,820
.سأذهب إذَن

314
00:17:09,980 --> 00:17:12,120
.سأمشي معه للبيت

315
00:17:12,150 --> 00:17:13,940
!لا تتبعونا

316
00:17:14,700 --> 00:17:16,250
.لا يجب عليكِ ذلك، فالجو باردٌ بالخارج

317
00:17:16,280 --> 00:17:17,780
!سأذهب معك

318
00:17:18,950 --> 00:17:20,260
.فالجو ليس بتلك البرودة

319
00:17:27,630 --> 00:17:29,770
.الجو هادئ في وجود كل تلك الثلوج

320
00:17:33,470 --> 00:17:35,780
.هوري-سان هادئة أيضًا

321
00:17:42,140 --> 00:17:44,250
.سنتخرج قريبًا

322
00:17:45,100 --> 00:17:47,790
.حقًا؟ ما زال لدينا الكثير من الوقت

323
00:17:49,940 --> 00:17:51,980
...في الحقيقة، أنا

324
00:17:54,440 --> 00:17:59,260
.ما زلتُ لا أعلم الكثير عنك يا ميامورا

325
00:18:01,660 --> 00:18:03,810
.أجهل عنك الكثير

326
00:18:07,620 --> 00:18:10,350
...هوري سان، أنا

327
00:18:10,380 --> 00:18:14,110
.لا أعلم الكثير عنكِ

328
00:18:17,630 --> 00:18:18,900
...ولكني

329
00:18:18,930 --> 00:18:21,690
،أريد أن أبقى معكَ

330
00:18:21,720 --> 00:18:24,880
!حـ- حتى بعد التخرج

331
00:18:27,060 --> 00:18:31,690
.مـ-ما دمت لا تمانع

332
00:18:36,360 --> 00:18:40,570
.قـ- قل شيئًا رجاءً

333
00:18:42,530 --> 00:18:44,290
،إذَن

334
00:18:51,420 --> 00:18:52,730
!لنتزوج

335
00:19:02,470 --> 00:19:04,070
.يا إلهي

336
00:19:04,100 --> 00:19:05,490
!سأرحل

337
00:19:05,520 --> 00:19:08,110
!سأحرص على إسعادك

338
00:19:08,140 --> 00:19:08,990
!ماذا؟

339
00:19:09,020 --> 00:19:13,590
!قلت إنني سأحرص على إسعادك يا ميامورا

340
00:19:14,110 --> 00:19:17,040
!أليس من المفترض أن يقولها الرجل للفتاة؟

341
00:19:17,070 --> 00:19:18,460
!لا تبدو منطقيةً في هذه الحالة

342
00:19:18,490 --> 00:19:21,670
!فأنا أنانية، وكل ما أجيده هو الدراسة والأعمال المنزلية

343
00:19:20,530 --> 00:19:21,670
جلد ذات

344
00:19:21,700 --> 00:19:22,920
!ولستُ لطيفةً مع الناس كذلك

345
00:19:22,950 --> 00:19:24,300
!ماذا؟

346
00:19:24,330 --> 00:19:28,010
!لذا فيجب عليّ أنا قولها

347
00:19:28,040 --> 00:19:33,970
.لا أظن أن هكذا تسري الأمور، ولكن هذا لا يهم

348
00:19:34,000 --> 00:19:36,100
.أتطلع لمستقبلنا معًا

349
00:19:36,130 --> 00:19:38,720
.أجل، وأنا كذلك

350
00:19:48,430 --> 00:19:49,290
فزع

351
00:19:51,560 --> 00:19:55,580
...حاضر! حاضر! أنا آتٍ

352
00:19:55,610 --> 00:19:57,500
!أعتذر ولكن يجب عليّ العودة للمتجر

353
00:19:57,530 --> 00:19:59,940
!حظًا موفقًا

354
00:20:08,120 --> 00:20:11,600
!بدأت أتجمد! سأذهب للبيت أيضًا

355
00:20:21,130 --> 00:20:23,760
وجهي ساخن

356
00:21:58,400 --> 00:22:00,790
أتذهب للضريح في بداية كل عام؟

357
00:22:01,520 --> 00:22:04,370
أحاول ذلك، ماذا عنكِ؟

358
00:22:05,280 --> 00:22:08,070
.أذهب فقط عندما يقل الازدحام

359
00:22:09,320 --> 00:22:12,790
أتودين الذهاب هذا العام؟

360
00:22:13,240 --> 00:22:15,160
تحريك تحريك

361
00:22:15,500 --> 00:22:17,210
حظ

362
00:22:17,670 --> 00:22:20,180
ماذا تقول ورقتك؟

363
00:22:20,210 --> 00:22:22,970
ملخصها: حافظ على رزانتك، وواصل التقدم

364
00:22:23,000 --> 00:22:25,020
أواثقٌ أن هذا كل شيء؟

365
00:22:25,050 --> 00:22:30,240
.ما دمت مبتسمة، فأنا راضٍ كل الرضى

366
00:22:31,720 --> 00:22:33,610
.ماذا قلت؟ لم أسمعك

367
00:22:33,640 --> 00:22:37,690
.لم أقل شيئًا

368
00:22:34,470 --> 00:22:35,280
أحقًا؟

369
00:22:39,270 --> 00:22:43,440
.أنا سعيدة ما دمت مبتسمًا أيضًا

370
00:22:45,030 --> 00:22:46,710
.لقد سمعتيني

371
00:22:46,740 --> 00:22:48,410
سمعت ماذا؟

372
00:22:48,490 --> 00:22:50,740
أمازاكي

373
00:22:50,950 --> 00:22:53,590
.يا له من شعورٍ غريب

374
00:22:53,620 --> 00:22:56,340
،أنت آخر شخصٌ أراه هذا العام

375
00:22:56,370 --> 00:22:59,480
.وأول مَن أراه العام المقبل

376
00:23:02,590 --> 00:23:05,520
.معكِ حق

377
00:23:05,550 --> 00:23:09,670
.أتمنى أن يستمر هذا الحال كل عام

378
00:23:26,900 --> 00:23:29,460
يا ميامورا؟

379
00:23:29,490 --> 00:23:32,210
هل سنبقى معًا للأبد؟

380
00:23:32,240 --> 00:23:34,300
.نعم، إلى الأبد

381
00:23:43,500 --> 00:23:45,180
.دائمًا أبدًا