1
00:00:07,840 --> 00:00:09,920
!أهلًا وسهلًا

2
00:00:13,930 --> 00:00:15,910
تدريبات على القواعد الإنجليزية: +700 سؤال صعب

3
00:00:26,060 --> 00:00:27,950
هل وجدت ما تبحثين عنه؟

4
00:00:27,980 --> 00:00:32,040
...لا، ربما عليّ طلبه فحسب

5
00:00:32,070 --> 00:00:34,000
لمَ لا تطلبين مساعدة الموظف؟

6
00:00:34,030 --> 00:00:37,380
.كلا، سأواصل البحث عنه

7
00:00:37,410 --> 00:00:39,670
.سأشتري هذا إذَن

8
00:00:39,700 --> 00:00:43,500
.سآتي معكِ يا هوري-سان، فسأشتري شيئًا ما أيضًا

9
00:00:58,640 --> 00:00:59,770
!مؤلم

10
00:00:59,800 --> 00:01:04,210
!توجد في المتجر مجلات ألعاب رائعة! دعني أريك إياها

11
00:01:07,900 --> 00:01:09,650
.بالطبع

12
00:01:20,550 --> 00:01:32,770
هوريميا

13
00:02:39,950 --> 00:02:42,170
!تورو

14
00:02:42,200 --> 00:02:45,130
ماذا؟ أتتخلصين من القمامة؟

15
00:02:45,160 --> 00:02:47,800
.أجل، احملها معي

16
00:02:47,830 --> 00:02:51,140
.ولمَ أساعدكِ الآن؟ يا للهول

17
00:02:51,170 --> 00:02:52,430
.يا لشدة ثقله

18
00:02:52,430 --> 00:02:54,680
.فهمت ما تحاولين فعله يا يوشيكاوا، فهمت

19
00:02:54,710 --> 00:02:56,820
ماذا؟ عمّ تتحدث؟

20
00:03:00,090 --> 00:03:04,360
.صحيح! صدر القرص الذي أردتُه اليوم

21
00:03:04,390 --> 00:03:05,690
.تعال معي لأشتريه لاحقًا

22
00:03:05,720 --> 00:03:07,190
...يا إلهي

23
00:03:07,220 --> 00:03:09,740
!سأدعك تستعيره لاحقًا

24
00:03:09,770 --> 00:03:12,990
!الممثل الذي أدى دور صاحب المتجر رائع للغاية

25
00:03:13,020 --> 00:03:15,190
...وليس هذا فحسب

26
00:03:13,780 --> 00:03:16,410
...منذ أن بدأ ميامورا وهوري بالمواعدة

27
00:03:16,440 --> 00:03:19,210
.ويوشيكاوا تهتم لأمري كثيرًا

28
00:03:19,240 --> 00:03:20,360
أتصغي إليّ؟

29
00:03:20,360 --> 00:03:22,080
.أجل أصغي

30
00:03:22,110 --> 00:03:24,530
...على أيٍ، أنت مزعجة

31
00:03:31,330 --> 00:03:33,010
!كونو-سان

32
00:03:33,040 --> 00:03:35,510
!أأنتِ بخير؟ أنا آسف

33
00:03:35,540 --> 00:03:38,810
.لا بأس، كنتُ أنا من اصطدم بك

34
00:03:38,840 --> 00:03:40,440
.يا للإحراج

35
00:03:40,470 --> 00:03:42,730
!تمهلي لحظة

36
00:03:42,760 --> 00:03:44,150
!سأعود في الحال

37
00:03:44,180 --> 00:03:46,930
.حـ-حسنًا

38
00:03:48,810 --> 00:03:51,240
.آسفة! كان علينا الانتباه لطريقنا

39
00:03:51,270 --> 00:03:53,200
.لا بأس أبدًا

40
00:03:53,230 --> 00:03:57,580
.أرجو حقًا ألا يترك بقعة خلفه

41
00:03:58,980 --> 00:04:00,680
...يا يوشيكاوا-سان

42
00:04:02,380 --> 00:04:06,140
أ-أتواعدين إشيكاوا-كن؟

43
00:04:08,030 --> 00:04:10,100
.كلا، لا نتواعد

44
00:04:11,040 --> 00:04:12,540
.هكذا إذَن

45
00:04:19,130 --> 00:04:23,060
.كونو-سان، خشيت ألا تستطعي العودة إلى منزلك مرتدية ما عليك

46
00:04:23,090 --> 00:04:27,070
...ورأيت أن زي يوشيكاوا سيكون صغيرًا غالبًا

47
00:04:27,100 --> 00:04:32,240
!قد يكون زيي كبيرًا، ولكن ما زال شيئًا ترتديه. آسف حقًا

48
00:04:32,270 --> 00:04:35,530
ماذا؟! أتريد مني ارتداءه؟

49
00:04:35,560 --> 00:04:38,910
!بئسًا، كان علي إحضار زيّكِ فحسب

50
00:04:38,940 --> 00:04:39,880
!لا

51
00:04:39,880 --> 00:04:43,280
!سأستعير زيّك! شكرًا لك

52
00:04:43,920 --> 00:04:46,450
غرفة مجلس الطلبة

53
00:04:49,580 --> 00:04:52,180
ما خطب هذا المعطف؟

54
00:04:53,540 --> 00:04:55,800
.قصة طويلة

55
00:04:55,830 --> 00:04:56,930
أين ريمي؟

56
00:04:56,960 --> 00:05:00,640
.ذهبت إلى المنزل لتنجز بعض الأمور

57
00:05:00,670 --> 00:05:02,760
.ولكنها فتحت لنا النافذة

58
00:05:04,800 --> 00:05:08,180
أوليست تحافظ على واجبها المتعلق بالنافذة؟

59
00:05:09,260 --> 00:05:13,200
ما الذي تحبه فيها يا سينجوكو-كن؟

60
00:05:15,190 --> 00:05:17,870
.لا أصدق أنك تسألينني هذا السؤال أيضًا

61
00:05:17,900 --> 00:05:20,910
!أ-أمن المفاجئ أن أسأل؟

62
00:05:20,940 --> 00:05:23,070
.عذرًا، عذرًا

63
00:05:30,330 --> 00:05:36,180
.أظنها حقيقة ضعفها التي تجعلها تحتاجني إلى جانبها

64
00:05:36,210 --> 00:05:40,260
إذَن تريد من شخص ضعيف أن يمكث تحت ظلك حتى تبدو قويًا؟

65
00:05:40,290 --> 00:05:41,560
!كلا، لا أقصد هذا

66
00:05:41,560 --> 00:05:45,810
.أنا لا أتحكم فيها، الأمر أشبه بأني أود حمايتها

67
00:05:47,680 --> 00:05:50,610
.هي تجعلني راغبًا في حمايتها

68
00:05:50,640 --> 00:05:56,150
.ولكنه سبب إعجابي بها نوعًا ما

69
00:05:56,180 --> 00:05:59,030
.وما أنا بتلك القوة في الأساس

70
00:05:59,060 --> 00:06:04,500
.ولكن ريمي تجعلني أود الغدو قويًا لأجلها

71
00:06:04,530 --> 00:06:06,870
،ولأنها خلفي تدفعني للأمام

72
00:06:06,900 --> 00:06:13,670
.يكون لدي القوة لأعِينها كذلك

73
00:06:13,700 --> 00:06:17,840
.وفي النهاية، هي من تحميني

74
00:06:17,870 --> 00:06:20,520
تمامًا كما تحميك يا ساكورا، ألست محقًا؟

75
00:06:24,840 --> 00:06:27,360
!أنتِ لطيفة حقًا يا ساكورا

76
00:06:30,970 --> 00:06:34,780
.أجل، تحميني

77
00:06:34,810 --> 00:06:38,600
.فيوكي تمدني بالشجاعة

78
00:06:43,610 --> 00:06:50,320
!الشجاعة لأبذل جهدًا أكبر ولو بقليل

79
00:06:52,950 --> 00:06:55,130
إشيكاوا-كن؟

80
00:06:55,160 --> 00:06:58,220
.أهلًا يا كونو-سان

81
00:06:58,250 --> 00:07:00,840
.شكرًا على إعارتي هذا

82
00:07:00,870 --> 00:07:04,680
.أعتذر، تأخرت في إعادته. فقد أردت غسله أولا

83
00:07:04,710 --> 00:07:08,980
.لم يكن عليكِ فعل هذا أبدًا

84
00:07:09,010 --> 00:07:10,770
.لا بأس. أشكرك على مساعدتي حقًا

85
00:07:10,800 --> 00:07:12,940
هلّا أتيت لحظة يا إشيكاوا؟

86
00:07:12,970 --> 00:07:14,070
!آتٍ

87
00:07:14,720 --> 00:07:15,790
!أراك لاحقًا

88
00:07:18,730 --> 00:07:19,940
...المعذرة

89
00:07:24,810 --> 00:07:29,840
...كنت قد أعددت الكثير من الكعك، لهذا

90
00:07:30,280 --> 00:07:32,230
ماذا؟ أهذا من أجلي؟

91
00:07:32,230 --> 00:07:34,090
!جميل، شكرًا

92
00:07:34,490 --> 00:07:37,580
!أ-أرجو أن يعجبك

93
00:07:38,580 --> 00:07:41,140
!عجبًا، إنه لذيذ! أنا منبهر

94
00:07:42,170 --> 00:07:45,380
!ولا سيما ذوات اللون الوردي

95
00:07:47,880 --> 00:07:49,850
أ-أتحب اللون الوردي؟

96
00:07:49,880 --> 00:07:52,850
.الوردي؟ أجل، أحبه

97
00:07:52,880 --> 00:07:53,980
!إشيكاوا

98
00:07:54,010 --> 00:07:55,650
!قلت إني آتٍ

99
00:07:55,680 --> 00:07:57,030
!أعتذر منك

100
00:07:57,060 --> 00:08:01,360
!ولكن متى صنعت هذه مجددًا، فأعطيني بعضها! لكم أحببتها

101
00:08:01,390 --> 00:08:02,700
!تأخرت يا صاح

102
00:08:02,730 --> 00:08:04,500
!أعلم هذا

103
00:08:11,820 --> 00:08:14,420
...يا لحظي! حصلت على آخر نسخة

104
00:08:25,330 --> 00:08:29,670
!لم فعلتِ هذا يا يوكي؟ فقد كنتِ تبحثين عنه منذ وقت طويل

105
00:08:30,670 --> 00:08:35,900
.بدت وكأنها أرادته أيضًا، وبإمكاني إيجاد غيره فيما بعد

106
00:08:35,930 --> 00:08:37,530
.لا بأس، لا بأس

107
00:08:39,720 --> 00:08:41,860
!إشيكاوا، طلبك أحدهم

108
00:08:41,890 --> 00:08:43,160
!قادم

109
00:08:45,810 --> 00:08:47,660
.يا يوكي

110
00:08:47,690 --> 00:08:50,160
.لم أرك ترافقين تورو منذ فترة

111
00:08:50,160 --> 00:08:51,300
أكل شيء على ما يرام؟

112
00:08:51,860 --> 00:08:56,960
.أجل. لعله في مكانٍ ما يأكل الكعك

113
00:08:56,990 --> 00:08:58,990
ماذا تقصدين؟

114
00:09:00,330 --> 00:09:02,830
شاي الخوخ

115
00:09:05,250 --> 00:09:09,260
،عرفتها منذ ثلاثة أعوام فحسب
.ولكن بوسعي معرفة ما تفكر فيه جيدًا

116
00:09:09,290 --> 00:09:14,350
!سنذهب للغرفة الدراسية في الحصة القادمة! رائع

117
00:09:14,380 --> 00:09:17,960
.كلما قلت رغبتها في أن يعرف الناس عن حزنها، اتسعت ابتسامتها

118
00:09:19,300 --> 00:09:24,650
.وإن أرادت شيئًا ما باستماتة، فلن تبوح بذلك أبدًا

119
00:09:24,680 --> 00:09:28,080
."ولن تصارح أبدًا لتقول "أحب هذا" أو "أريد هذا

120
00:09:33,320 --> 00:09:38,590
.لذا لا تنال الأشياء التي تحبها أو تريدها

121
00:09:42,580 --> 00:09:46,820
.أردت شكرك على إعارتي ذاك المنديل

122
00:09:48,880 --> 00:09:50,110
.لا أريده

123
00:09:51,460 --> 00:09:54,560
!عجبًا، لكم أحب الكعك

124
00:09:54,590 --> 00:09:56,420
!أشكرك يا كونو-سان

125
00:09:56,930 --> 00:09:58,730
.أشكرك حقًا يا كونو-سان

126
00:09:58,760 --> 00:10:00,480
.يسرني أنك أحببته

127
00:10:00,510 --> 00:10:02,780
!بالطبع! فهو في غاية اللذة

128
00:10:12,440 --> 00:10:13,920
.أردت شكرك

129
00:10:23,180 --> 00:10:25,090
.مذاقها لذيذ

130
00:10:25,120 --> 00:10:28,440
.قد آخذها إن كانت بهذه اللذة

131
00:10:32,540 --> 00:10:34,690
.أنا قبيحة جدًا

132
00:10:35,840 --> 00:10:37,690
ماذا؟ كعكة؟

133
00:10:38,340 --> 00:10:42,610
.أجل، لم يسبق لي صنع واحدة

134
00:10:42,640 --> 00:10:46,490
.ولا داع لأن تكون باهرة، أريدها لذيذة فحسب

135
00:10:46,520 --> 00:10:49,210
.ولكني أظن هذا صعبًا على أي حال

136
00:10:49,980 --> 00:10:55,500
.يوشيكاوا-سان، أنا لم أولد أعرف كيف أعِد الكعك

137
00:10:55,530 --> 00:10:56,620
ماذا؟

138
00:10:56,650 --> 00:10:59,340
.لا يجيد أحد شيئًا من أول محاولة

139
00:10:59,780 --> 00:11:02,340
.وإن أخفقت، فحاولي مجددًا

140
00:11:05,490 --> 00:11:07,500
!حسنًا

141
00:11:11,500 --> 00:11:13,010
.يا للهول

142
00:11:13,040 --> 00:11:15,760
استغرقكِ إعداد هذا أسبوعًا؟

143
00:11:16,760 --> 00:11:19,980
أوليس هذا كعكًا معلبًا؟

144
00:11:20,010 --> 00:11:22,200
!أستبدأ تعليمي إعداده من الصفر؟

145
00:11:22,550 --> 00:11:25,900
بالمناسبة، لم لا تريدين إشراك تورو في هذا؟

146
00:11:25,930 --> 00:11:28,650
!لـ-لأنه سيجعل مني أضحوكة

147
00:11:28,680 --> 00:11:32,700
.لن يفعل، لا سيما إن علم أنك تعدينه من أجله

148
00:11:32,730 --> 00:11:34,950
.أنا لا أعده من أجله

149
00:11:34,980 --> 00:11:37,280
!وجدتكم

150
00:11:38,490 --> 00:11:40,580
أتقيمون حفلًا؟ لمَ لستُ مدعوًا؟

151
00:11:40,610 --> 00:11:42,180
!لا تنظر

152
00:11:46,160 --> 00:11:47,800
!أهذا كعك معلب؟

153
00:11:47,830 --> 00:11:49,160
!أعده لي

154
00:11:53,960 --> 00:11:55,970
.يا للهول، طعمها سيئ جدًا

155
00:11:56,000 --> 00:11:57,680
!مهلًا

156
00:11:57,710 --> 00:11:59,430
.سيئ حقًا

157
00:11:59,460 --> 00:12:01,110
.أعلم هذا

158
00:12:02,570 --> 00:12:04,740
!متشوق لتجربة المحاولة القادمة

159
00:12:07,590 --> 00:12:08,740
.وكذلك أنا

160
00:12:09,100 --> 00:12:10,500
.وأنا أيضًا

161
00:12:12,310 --> 00:12:13,930
!دعوا الأمر لي

162
00:12:22,200 --> 00:12:26,090
هل ذهب ميامورا إلى هوكايدو؟

163
00:12:26,120 --> 00:12:31,550
.أجل، زيارة عائلية لخمسة أيام

164
00:12:31,580 --> 00:12:34,800
.إذَن لن يكون هنا طوال الأسبوع

165
00:12:34,830 --> 00:12:38,810
.مهلًا، هذا يعني أني سأضطر إلى قراءة سطور مختلفة في الحصة

166
00:12:38,840 --> 00:12:41,980
...كان ميامورا سيقرأ السطر الخامس، لذا

167
00:12:42,010 --> 00:12:44,100
!يا للهول، سطري طويل للغاية

168
00:12:44,130 --> 00:12:47,470
.عجبًا، سطري أسهل بكثير

169
00:12:51,810 --> 00:12:57,110
.وصلت هوكايدو. الجو رائع هنا

170
00:12:58,150 --> 00:13:00,360
.تكاد بطاريتي تنفد

171
00:13:01,560 --> 00:13:03,910
...ونسيت شاحني

172
00:13:05,630 --> 00:13:08,920
هل لي باستعارة شاحن هاتفك يا عمي؟

173
00:13:08,950 --> 00:13:11,210
بالطبع، أسينفع شاحني مع هاتفك؟

174
00:13:11,240 --> 00:13:12,640
.صحيح

175
00:13:14,080 --> 00:13:15,350
...لن ينفع

176
00:13:20,590 --> 00:13:22,350
أبوسعنا الذهاب إلى المتجر؟

177
00:13:22,380 --> 00:13:27,230
.نحن مشغولات يا عزيزي
.لا يمكنني إيصالك حاليًا

178
00:13:27,260 --> 00:13:29,850
هلّا انتظرت قليلًا؟

179
00:13:36,640 --> 00:13:37,870
أستشربين كلاهما؟

180
00:13:38,360 --> 00:13:41,410
.أجل، فأنا عطشة

181
00:13:41,440 --> 00:13:43,960
.على المرء الحفاظ على رطوبته في هذا الحر

182
00:13:43,990 --> 00:13:46,920
.واصلي شرب هذه المشروبات السكرية وستسمنين يا يوشيكاوا-سان

183
00:13:46,950 --> 00:13:48,640
.تبقت ثلاثة أيام

184
00:14:04,010 --> 00:14:05,770
.وداعًا يا هوري-سان

185
00:14:05,800 --> 00:14:07,310
!نراك في الغد

186
00:14:10,930 --> 00:14:12,660
أتنتظرين أحدًا؟

187
00:14:13,180 --> 00:14:13,990
.لا

188
00:14:14,020 --> 00:14:14,860
.فهمت

189
00:14:14,890 --> 00:14:16,380
!وداعًا

190
00:14:20,810 --> 00:14:23,330
.كيوكو، هذا ليس صحني

191
00:14:23,360 --> 00:14:25,000
!إنه صحن أخي

192
00:14:25,030 --> 00:14:26,920
أتحاولين إغاظتي؟

193
00:14:26,950 --> 00:14:30,290
.كلا! نسيت فحسب

194
00:14:30,320 --> 00:14:33,700
.فهمت، من النادر رؤيتك تغفلين

195
00:14:54,830 --> 00:14:57,830
مزرعة الألبان

196
00:14:55,350 --> 00:14:58,320
ألن يعود ميامورا اليوم؟

197
00:14:58,350 --> 00:15:00,830
سيعود هذا المساء. أم قد يتأخر؟

198
00:15:03,690 --> 00:15:05,400
.لا فكرة لدي

199
00:15:06,190 --> 00:15:11,630
!يا أختي، أريد مشاهدة نجمة الإعصار! بدأ العرض بالفعل

200
00:15:11,660 --> 00:15:13,750
لم تشاهدين الأخبار؟

201
00:15:13,780 --> 00:15:19,430
...والخبر التاني بليلتنا: تستمر القيود المفروضة على المطارات

202
00:15:19,460 --> 00:15:21,360
مهلًا، ماذا؟

203
00:15:28,710 --> 00:15:30,460
!كيوكو

204
00:15:37,270 --> 00:15:38,820
.وها قد عاد

205
00:15:38,850 --> 00:15:40,490
...شيندو، شيندو

206
00:15:40,520 --> 00:15:45,270
...إشيكاوا-كن يقول إن الاختبار تأجل. بحقك

207
00:15:45,320 --> 00:15:46,320
"هوري-سان"

208
00:15:49,610 --> 00:15:50,760
إيزومي؟

209
00:16:13,680 --> 00:16:15,180
...المعذ

210
00:16:31,170 --> 00:16:32,550
.أيها الغبي

211
00:16:39,260 --> 00:16:43,060
...لَم أدرك مسبقًا كيف لخمسة أيام أن تطول

212
00:16:43,790 --> 00:16:45,300
.مرحبًا بعودتك

213
00:16:45,330 --> 00:16:48,930
.لقد عدت

214
00:16:48,960 --> 00:16:52,560
.ولكني الآن مدركة

215
00:16:59,580 --> 00:17:02,080
غرفة مجلس الطلبة

216
00:17:00,180 --> 00:17:02,400
ما الذي لا يحبه؟

217
00:17:02,430 --> 00:17:05,410
.لا يحب ميامورا أفلام الرعب

218
00:17:05,440 --> 00:17:10,080
.ولكنه يشاهدها معي دومًا، لذا لربما يحبها

219
00:17:10,110 --> 00:17:11,870
.لأنك تجعلينه يشاهدها

220
00:17:11,900 --> 00:17:13,500
،يا هوري

221
00:17:13,530 --> 00:17:16,880
.سيبدأ بتجنبك إن استمريتِ في مشاهدة تلك الأفلام المخيفة

222
00:17:16,910 --> 00:17:18,380
حقًا؟

223
00:17:18,410 --> 00:17:23,050
...مشاهدة فتاة حسناء لأفلام دموية باستمتاع أمر مريب

224
00:17:23,080 --> 00:17:26,470
.هيا، لست بحسناء

225
00:17:26,500 --> 00:17:29,060
.هوري، هذا ليس بيت القصد

226
00:17:29,420 --> 00:17:34,480
.أتفق مع يوشيكاوا-سان في أن ميامورا-كن سيفقد اهتمامه بك

227
00:17:34,510 --> 00:17:36,070
أ-أهذا ما تظنينه؟

228
00:17:40,640 --> 00:17:43,080
.استعرت هذه من أجلنا يا هوري-سان

229
00:17:43,640 --> 00:17:46,240
!به الكثير من الكلاب

230
00:17:46,270 --> 00:17:48,910
هلّا شاهدنا "خلفك مباشرة: الكابوس الثالث" بدلًا منه؟

231
00:17:48,940 --> 00:17:50,090
.أجل

232
00:17:53,280 --> 00:17:57,230
.سيبدأ بتجنبك إن استمريتِ في مشاهدة تلك الأفلام المخيفة

233
00:17:58,410 --> 00:18:02,880
...أتعلم يا ميامورا، هذا الفيلم

234
00:18:02,910 --> 00:18:04,630
!سيكون مخيفًا حقًا

235
00:18:04,660 --> 00:18:06,090
عمّ تتحدثين؟

236
00:18:06,120 --> 00:18:10,260
،مقارنة بالأفلام الدموية ذات تصنيف 13 عامًا التي نشاهدها دومًا

237
00:18:10,290 --> 00:18:11,850
!فهذا الفيلم لا يعد شيئًا

238
00:18:11,880 --> 00:18:13,600
!يوكي

239
00:18:15,590 --> 00:18:18,120
.ينبغي عليكِ ادعاء الخوف

240
00:18:19,430 --> 00:18:20,620
!أنا خائفة

241
00:18:22,140 --> 00:18:23,690
...لقد أخفتِني

242
00:18:23,720 --> 00:18:25,740
!أياساكي-سان

243
00:18:26,100 --> 00:18:28,450
...ربما لن يفلح هذا

244
00:18:28,480 --> 00:18:31,130
لمَ لا تجربين إمساك يده؟

245
00:18:33,270 --> 00:18:35,900
!...عجبًا، كم أنا خائفة

246
00:18:40,910 --> 00:18:43,760
...لا أود سوى الاستمتاع بمشاهدة فيلمًا معه

247
00:18:44,160 --> 00:18:47,010
.أنا آسف، آسف على كوني فتًى خوّاف

248
00:18:47,040 --> 00:18:51,600
.كـ-كلا، لا تعتذر! ليس خطأك يا ميامورا

249
00:18:51,630 --> 00:18:55,020
.اعذريني قليلًا، أريد قضاء لحظة بمفردي

250
00:18:56,170 --> 00:18:59,030
...يأس مني تمامًا

251
00:18:59,550 --> 00:19:01,030
!تمامًا

252
00:19:02,300 --> 00:19:03,980
!يا لخيبتي

253
00:19:04,850 --> 00:19:06,140
هوري-سان؟

254
00:19:10,520 --> 00:19:11,700
هوري-سان؟

255
00:19:14,340 --> 00:19:16,740
.لستُ لطيفة على الإطلاق

256
00:19:17,570 --> 00:19:20,420
.ماذا تعنين؟ أنتِ لطيفة حقًا

257
00:19:20,450 --> 00:19:22,710
.أنا لا أخاف، ولا يمكنني حتى التظاهر بالخوف

258
00:19:22,740 --> 00:19:25,340
.ليس بوسعي إبداء فعل لطيف. لا رجاء مني

259
00:19:27,000 --> 00:19:31,180
مهلًا، أكنتِ تبدين تلك التصرفات لأجلي؟

260
00:19:31,210 --> 00:19:33,260
!ومن يدري أيها الغبي؟

261
00:19:33,290 --> 00:19:38,480
...يا هوري-سان، كنتُ مفزوعًا وخائفًا فلم ألاحظ، لذا أعتذ

262
00:19:38,510 --> 00:19:41,940
!لمَ تواصل الاعتذار مني؟

263
00:19:41,970 --> 00:19:43,480
!لا تنظر يا غبي

264
00:19:43,510 --> 00:19:46,280
.أنتِ الغبية هنا يا هوري-سان

265
00:19:46,310 --> 00:19:50,290
.ما وقعتُ في حب "فتاة عادية"، وإنما وقعت في حبك أنتِ

266
00:19:51,900 --> 00:19:55,130
.لنذهب ونشاهد بقية الفيلم

267
00:19:58,650 --> 00:20:01,040
.المطر غزير في الخارج

268
00:20:01,070 --> 00:20:02,480
.هذا صحيح

269
00:20:04,370 --> 00:20:05,840
.وكذلك أنا

270
00:20:06,700 --> 00:20:08,720
.وقعت في حبه

271
00:20:09,160 --> 00:20:13,510
،في رموشه الطويلة، في فزعه عند خوفه

272
00:20:13,540 --> 00:20:18,600
،في دعاباته الساخرة، في نحافة جسده بين ذراعيّ

273
00:20:18,630 --> 00:20:22,600
...في صوته، وفي... وفي

274
00:20:22,630 --> 00:20:24,390
.إيزومي

275
00:20:37,860 --> 00:20:39,870
ما الخطب؟

276
00:20:39,900 --> 00:20:42,860
.أُنصِتُ لقلبك

277
00:20:47,870 --> 00:20:50,010
ماذا يقول؟

278
00:20:51,290 --> 00:20:53,300
.كم أن الجو بارد

279
00:20:58,130 --> 00:21:01,640
.يداك وأذناك باردتان جدًا يا ميامورا

280
00:21:01,670 --> 00:21:04,060
.بسبب المطر على الأغلب

281
00:21:04,090 --> 00:21:05,900
.ربما

282
00:21:05,930 --> 00:21:09,350
.لن تستطيع الذهاب إلى منزلك في هذا المطر الغزير

283
00:21:11,020 --> 00:21:13,150
...سَكَن قلبي دفءٌ

284
00:21:13,180 --> 00:21:15,890
.أردت أن يشعر به ميامورا

285
00:21:21,220 --> 00:21:23,300
!هذا أنت وأنا وأختي الكبيرة

286
00:21:26,670 --> 00:21:28,000
سوتا؟

287
00:21:28,030 --> 00:21:31,800
.إن أختي... هي أختي أنا

288
00:21:33,830 --> 00:21:37,760
أأنت قلق من أني سآخذها عنك بعيدًا؟

289
00:21:39,530 --> 00:21:43,730
.لن أفعل. فهي أختك الكبيرة يا سوتا

290
00:21:43,760 --> 00:21:44,980
وماذا عنك يا أخي؟

291
00:21:45,010 --> 00:21:48,690
.وأنا أخوك الكبير

292
00:21:48,720 --> 00:21:51,820
.لن آخذ أختك بعيدًا عنك يا سوتا

293
00:21:51,850 --> 00:21:53,830
لذا أبإمكاني أن أكون خليلها؟

294
00:21:55,300 --> 00:21:56,630
.أجل

295
00:23:28,650 --> 00:23:30,210
...هذا مؤلم

296
00:23:30,240 --> 00:23:32,250
.شعرك يطول

297
00:23:32,280 --> 00:23:36,320
.إذا قصصته مجددًا، فسيرى الجميع هذه العلامة

298
00:23:37,040 --> 00:23:38,970
لم قد تعضك؟

299
00:23:39,000 --> 00:23:41,140
.لا أملك أدنى فكرة

300
00:23:41,620 --> 00:23:46,070
.تبدو رمزًا يفيد الملكية، ولكن ربما لا ينبغي عليّ إخباره