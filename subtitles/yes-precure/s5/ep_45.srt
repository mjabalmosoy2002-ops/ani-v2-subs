1
00:00:17,050 --> 00:00:18,110
!أمسكتُ به

2
00:00:18,110 --> 00:00:19,680
!رائع

3
00:00:19,680 --> 00:00:22,310
!أصبح لدينا الآن 54 بينكي

4
00:00:22,310 --> 00:00:24,740
!أجل. بقي واحد فقط

5
00:00:26,080 --> 00:00:26,960
ماذا؟

6
00:00:27,820 --> 00:00:29,130
...أليس هذا

7
00:00:29,130 --> 00:00:32,550
أجل، إنّه حيث أقامت ميكو-سان زفافها

8
00:00:34,510 --> 00:00:37,740
هل كانت ميكو-سان بهذا الجمال؟

9
00:00:37,740 --> 00:00:38,470
!أجل

10
00:00:41,200 --> 00:00:44,680
!وهذه أيضاً! يا لها من شجرة ضخمة

11
00:00:44,680 --> 00:00:49,940
!أنا واثقة بأنّها ستكون جميلة وهي مُضيئة ليلاً

12
00:00:50,310 --> 00:00:51,740
!أجل

13
00:00:53,620 --> 00:00:56,700
!الثّلوج تتساقط! مرحى

14
00:00:56,700 --> 00:00:58,870
لِمَ أنتما سعيدتان، ميرو؟

15
00:00:58,870 --> 00:01:01,620
!لأنّ غداً هو عشيّة الكريسماس

16
00:01:01,620 --> 00:01:04,250
،إذا تكدّس الثّلج في الأرض
!فسيكون كريسماس أبيض

17
00:01:04,250 --> 00:01:06,680
ورد في تنبّؤات الطّقس أنّها ستتساقط

18
00:01:06,680 --> 00:01:07,920
!حقّاً؟

19
00:01:07,920 --> 00:01:11,080
!مرحى! إنّه كريسماس أبيض

20
00:01:12,000 --> 00:01:15,600
!لم يبقَ إلّا واحد من 55 بينكي، ناتسو

21
00:01:18,080 --> 00:01:21,100
لم يبقَ على وجودنا في هذا العالم
!إلّا القليل من الوقت، كوكو

22
00:03:13,600 --> 00:03:16,500
سيتحقّق حلمك قريباً! ألست مُتحمّساً يا كوكو؟

23
00:03:18,460 --> 00:03:20,540
،حالما تُحيا المملكة

24
00:03:20,540 --> 00:03:23,680
إمّا كوكو-ساما أو ناتس-ساما
!سيصبح الملك، ميرو

25
00:03:26,800 --> 00:03:30,770
تقاعد الملِك قُبيل ظهور نايتمير، ميرو

26
00:03:30,770 --> 00:03:34,150
!لذا سيترتّب علينا اختيار ملِك جديد، ميرو

27
00:03:34,150 --> 00:03:38,110
...حقّاً؟ من الطبيعيّ أن يخلفه أمير

28
00:03:38,110 --> 00:03:39,690
وبعد؟ من سيكون الوريث منهما؟

29
00:03:41,220 --> 00:03:43,910
سيتمكّن كوكو من الاستماع لهموم النّاس

30
00:03:43,910 --> 00:03:46,370
!وإسداء نصيحة جيّدة لهم، ناتسو

31
00:03:46,680 --> 00:03:50,170
لكن يجب على الملِك أن يمتلك
مبادئ شديدة، كوكو

32
00:03:50,170 --> 00:03:54,380
!شخصيّة ناتس العازمة ستكون مثاليّة، كوكو

33
00:03:54,380 --> 00:03:59,020
كفاك هُراء، ناتسو. الجميع في المملكة
!يحبّونك، ناتسو

34
00:03:59,020 --> 00:04:02,090
!من الواضح أنّك ستصبح الملك المقبل، ناتسو

35
00:04:03,710 --> 00:04:07,970
أنت تعمل خلف الكواليس لأجل
!المملكة كلّ يوم، كوكو

36
00:04:07,970 --> 00:04:10,080
!الجميع يعلمون ذلك، كوكو

37
00:04:10,080 --> 00:04:12,940
!جميعهم يحترمونك أكثر منّي، كوكو

38
00:04:15,250 --> 00:04:18,270
!سأكون مسرورة بتبوّء أي منكما العرش

39
00:04:19,080 --> 00:04:23,610
الملك التّالي سوف يُحدّده اقتراع
على مستوى المملكة، ميرو

40
00:04:24,000 --> 00:04:26,910
!ملِك؟ هذا رائع

41
00:04:26,910 --> 00:04:29,280
الملِك هو شيء عظيم، أليس كذلك؟

42
00:04:29,280 --> 00:04:32,220
!ليس "عظيم" فحسب. إنّه مسؤول عن كلّ شيء

43
00:04:33,710 --> 00:04:36,460
حتّى لو أصبح أحدكما ملِكاً، استمرّا
في المجيء والتنزّه معنا، اتّفقنا؟

44
00:04:36,460 --> 00:04:37,970
—لن نتمكّن من ذلك، ناتسو

45
00:04:38,640 --> 00:04:41,670
قد لا يكون من الممكن المجيء
!والذّهاب بحرّية، كوكو

46
00:04:42,000 --> 00:04:46,110
حقّاً؟ لكن حتّى الملوك لديهم
عطلة، أليس كذلك؟

47
00:04:46,110 --> 00:04:48,890
تحدّثتم عن السّفر كثيراً سابقاً

48
00:04:50,540 --> 00:04:53,890
يستطيع الأمير الإفلات بذلك، لكن
الملِك لا يستطيع، ناتسو

49
00:04:55,060 --> 00:04:58,850
يجب أن يبقى الملِك والأمير
في المملكة طوال الوقت، ميرو

50
00:04:58,850 --> 00:05:02,780
كوكو-ساما وناتس-ساما كلاهما
!يدعمان النّاس، ميرو

51
00:05:03,110 --> 00:05:04,200
هكذا إذاً

52
00:05:04,710 --> 00:05:07,490
إذاً أعتقد سيحين وقت الوداع

53
00:05:10,450 --> 00:05:13,650
جميعنا كنّا نعلم ذلك، لكن
يبقى هذا مُحزناً للغاية

54
00:05:13,650 --> 00:05:19,130
لكن أنا متأكّدة بأنّهم سيكونون أسعد
بعودتهم إلى الدّيار مع شعبهم

55
00:05:19,130 --> 00:05:23,960
!أنتِ تستبقين الأحداث، كوكو
!لم تُحيَ المملكة بعد، كوكو

56
00:05:24,340 --> 00:05:27,200
...لكن سنجمع كلّ البينكي قريباً

57
00:05:27,200 --> 00:05:28,800
!مـ-مهلاً لحظة

58
00:05:29,680 --> 00:05:31,370
...المعذرة

59
00:05:31,370 --> 00:05:35,640
حالما يتحقّق حلمكم، لن نتمكّن
من رؤيتكم ثانية؟

60
00:05:39,600 --> 00:05:42,080
!قسَم الكريسماس الخاصّ بنوزومي وكوكو

61
00:05:44,140 --> 00:05:48,110
حالما تُحيا مملكة بالمير، لن نراكم ثانية؟

62
00:05:48,540 --> 00:05:49,540
نوزومي؟

63
00:05:51,410 --> 00:05:56,710
أ-أجل... أقدّر هذا. من الطّبيعيّ
أن ترغبوا في العودة إلى الدّيار

64
00:05:56,710 --> 00:06:00,420
...وهذا ما كنّا نكافح لأجله على أيّ حال

65
00:06:03,400 --> 00:06:05,840
اشرب شايك قبل أن يبرد

66
00:06:05,840 --> 00:06:09,760
واجهت هادينيا-سان نهاية مأساويّة

67
00:06:10,340 --> 00:06:14,970
،كنتُ قد عقدتُ آمالاً كبيرة على هذا القسم
لكنّه كان مُخيّباً يا بلودي-سان

68
00:06:15,280 --> 00:06:18,850
لماذا وضعتَ ذلك القناع على وجه
هادينيا بالقوّة؟

69
00:06:19,220 --> 00:06:21,940
لم نكن نستخدم مثل هذه الأشياء

70
00:06:21,940 --> 00:06:27,320
،منذ أصبحتَ مُساعداً لديسبارايا-ساما
بدأ توازن نايتمير يتزعزع

71
00:06:28,080 --> 00:06:31,490
كاوارينو. ما هو هدفك بالضّبط؟

72
00:06:31,490 --> 00:06:34,000
خدمة ديسبارايا-ساما بالطّبع

73
00:06:34,000 --> 00:06:36,700
وهل هناك هدف آخر غير ذلك؟

74
00:06:47,050 --> 00:06:49,220
!انتبه يا بلودي-سان

75
00:06:49,510 --> 00:06:52,800
سأحصد النّتائج. باستخدام طُرُقي الخاصّة

76
00:06:56,680 --> 00:06:59,730
هل ما زت هناك يا بونبي-سان؟

77
00:06:59,730 --> 00:07:01,810
ما-ماذا؟ "ما زلت"؟

78
00:07:01,810 --> 00:07:04,570
إن كنت تعتقد بأنّك تستطيع البقاء هنا للأبد

79
00:07:04,570 --> 00:07:09,050
،دون توفير قيمة لديسبارايا-ساما
فأنت مُخطئ

80
00:07:11,280 --> 00:07:13,000
ماذا يجدر بي أن أفعل؟

81
00:07:17,540 --> 00:07:19,400
!ما الّذي تنظرون إليه؟

82
00:07:19,400 --> 00:07:23,850
!هذا يشملكم جميعاً أيضاً

83
00:07:26,710 --> 00:07:27,820
!جميعكم

84
00:07:30,740 --> 00:07:34,200
...لا يوجد ما يُحفّز أُناساً غرقوا في اليأس

85
00:07:34,560 --> 00:07:36,250
!تمالك نفسك يا بونبي

86
00:07:39,050 --> 00:07:40,430
!مرحباً

87
00:07:41,150 --> 00:07:42,390
...نوزومي

88
00:07:42,800 --> 00:07:45,020
!رين-تشان. هديّة لكِ

89
00:07:45,020 --> 00:07:46,340
حـ-حسناً

90
00:07:46,340 --> 00:07:48,230
!شكراً على الزّيارة

91
00:07:52,650 --> 00:07:55,340
هل نوزومي-سان بخير؟

92
00:07:55,340 --> 00:07:58,080
...بدتْ بأنّها تحاول أن تبدو مبتهجة

93
00:07:58,480 --> 00:08:01,250
أظنّها تُعاني من صدمة حقيقيّة

94
00:08:01,250 --> 00:08:04,170
،كانت تعمل بجدّ للتحقيق حلمهم

95
00:08:04,170 --> 00:08:07,000
لم تكن تفكّر فيما سيحدث بعد ذلك

96
00:08:07,000 --> 00:08:10,800
،سوف نفتقد للبالميريّين أيضاً

97
00:08:10,800 --> 00:08:13,220
لكن غالباً سيكون وقع هذا أكبر على نوزومي

98
00:08:13,220 --> 00:08:14,740
أجل

99
00:08:14,740 --> 00:08:18,720
كان لقاء نوزومي-سان بكوكو بداية لكلّ هذا

100
00:08:20,680 --> 00:08:23,000
أعرف شعور نوزومي، ميرو

101
00:08:23,000 --> 00:08:27,000
لكن المملكة تحتاج كوكو-ساما
!وناتس-ساما، ميرو

102
00:08:27,000 --> 00:08:29,900
أعتقد أنّ نوزومي-سان تعلم ذلك أيضاً

103
00:08:31,860 --> 00:08:33,850
!شكراً على الزّيارة

104
00:08:37,650 --> 00:08:39,620
!حسناً، ينبغي لهذا أن يفي بالغرض

105
00:08:41,570 --> 00:08:45,580
هل نوزومي بخير؟ بدتْ تُعاني كثيراً

106
00:08:45,580 --> 00:08:51,170
أجل... لكن ستكون بخير. فهي
تتمتّع بقلب قويّ

107
00:08:51,170 --> 00:08:52,140
...لكنّك

108
00:08:53,480 --> 00:08:56,050
هل أنت راضٍ عن ترك نوزومي؟

109
00:09:05,510 --> 00:09:07,100
!مُذهل

110
00:09:07,510 --> 00:09:08,940
ما كلّ هذا؟

111
00:09:08,940 --> 00:09:12,540
!تعاونّا معاً صنع كعكة كريسماس، كوكو

112
00:09:12,540 --> 00:09:14,540
!إنّها هديّة لكُن جميعاً، كوكو

113
00:09:14,540 --> 00:09:18,280
!مجرّد إظهار بسيط لامتناننا، ناتسو

114
00:09:18,280 --> 00:09:22,540
باجتماع الجميع معاً، يكون مذاق
!الكعكة أطيب، ميرو

115
00:09:23,710 --> 00:09:26,420
!حسناً! المشروبات جاهزة

116
00:09:26,800 --> 00:09:28,040
!وهذه جاهزة

117
00:09:28,370 --> 00:09:30,040
!لنحتفل بالنّخب

118
00:09:30,040 --> 00:09:32,840
!حسناً! ها نحن أولاء

119
00:09:45,680 --> 00:09:46,730
نوزومي؟

120
00:09:47,660 --> 00:09:50,510
...ا-المعذرة... في الواقع

121
00:09:50,510 --> 00:09:54,110
!لـ-لنبحث عن البينكي الأخير
!ميري كريسماس

122
00:09:54,110 --> 00:09:58,280
!بصحّتكم

123
00:09:58,280 --> 00:09:59,870
!بصحّتكم، ميرو

124
00:09:58,280 --> 00:09:59,870
!بصحّتكم، ناتسو

125
00:09:58,280 --> 00:09:59,870
!بصحّتكم، كوكو

126
00:10:03,820 --> 00:10:05,120
!هذا شهيّ

127
00:10:05,120 --> 00:10:07,910
!أنا من قام بالتّزيين، ميرو

128
00:10:08,340 --> 00:10:09,790
إنّها جذّابة جدّاً

129
00:10:10,110 --> 00:10:11,460
!شكراً لكِ، ميرو

130
00:10:13,600 --> 00:10:15,510
نوزومي؟ ما الأمر، كوكو؟

131
00:10:17,280 --> 00:10:19,740
...عادةً ما تأكلين أسرع من الباقي

132
00:10:19,740 --> 00:10:21,180
ألم تُعجبكِ، ميرو؟

133
00:10:21,480 --> 00:10:24,170
المسألة ليست كذلك. إنّها لذيذة

134
00:10:24,170 --> 00:10:28,770
كلّ ما في الأمر أنّني لا أشعر
برغبة في أكلها

135
00:10:29,220 --> 00:10:30,770
غريب، أليس كذلك؟

136
00:10:32,220 --> 00:10:35,620
...إنّ رؤية "شكراً" على الكعكة ذكّرتني

137
00:10:36,650 --> 00:10:41,490
بالفترة الّتي سنبقى فيها معاً

138
00:10:43,650 --> 00:10:45,700
هذه هي نهاية المطاف

139
00:10:48,040 --> 00:10:49,580
!نايتمير

140
00:10:49,580 --> 00:10:51,910
هل استمتعتم بحفلتكم؟

141
00:10:51,910 --> 00:10:55,840
!والآن سأجعلكم وليمة لنايتمير

142
00:11:03,010 --> 00:11:04,930
!جميعكم! اخرجوا من هنا، ناتسو

143
00:11:11,080 --> 00:11:12,940
!كوكو! ناتس! ميلك

144
00:11:28,910 --> 00:11:33,750
والآن، لنبدأ بعشائنا الأخير... أيّتها
!المُحاربات الأسطوريّات، بريكيور

145
00:11:34,140 --> 00:11:35,750
!يا فتيات. هيّا بنا

146
00:11:38,970 --> 00:11:42,710
!تحوُّل بريكيور

147
00:11:50,740 --> 00:11:53,420
!قوّة الأمل العظيمة

148
00:11:53,420 --> 00:11:54,650
!كيور دريم

149
00:11:56,570 --> 00:11:58,770
!لهب الشّغف الأحمر

150
00:12:00,200 --> 00:12:01,650
!كيور روج

151
00:12:02,820 --> 00:12:04,990
!رائحة اللّيمون الفوّاحة

152
00:12:05,660 --> 00:12:06,990
!كيور ليمونيد

153
00:12:09,110 --> 00:12:10,940
بلاد السّكينة الخضراء

154
00:12:12,480 --> 00:12:13,940
!كيور مينت

155
00:12:15,680 --> 00:12:17,380
!ربيع الذّكاء الأزرق

156
00:12:18,480 --> 00:12:19,680
!كيور آكوا

157
00:12:22,310 --> 00:12:23,510
!قوّة الأمل

158
00:12:24,000 --> 00:12:25,390
!نور المستقبل

159
00:12:26,540 --> 00:12:29,260
!القلوب الخمسة تُحلّق بجمال

160
00:12:30,400 --> 00:12:32,680
!أجل! بريكيور 5

161
00:12:34,390 --> 00:12:40,080
علّمتني معاركنا السّابقة بأّنكن
تُشكّلن فريقاً ممتازاً

162
00:12:40,080 --> 00:12:44,030
...لكن لديكن نقطة ضعف قاتلة

163
00:12:52,910 --> 00:12:57,250
إذا دمّرتُ عمودكن الفقريّ، ستنهرنَ لا محالة

164
00:13:02,420 --> 00:13:03,550
!دريم

165
00:13:06,050 --> 00:13:06,930
!يا  فتيات

166
00:13:08,600 --> 00:13:11,470
لا أعتقد بأنّ لديكِ الوقت للقلق بشأن الأُخريات

167
00:13:19,820 --> 00:13:24,440
يا لها من حركات بليدة. لا يمكنكِ
هزيمتي بهذا الشّكل

168
00:13:24,440 --> 00:13:27,610
...أجل، يمكننا ذلك! إذا تعاونّا معاً، يمكننا

169
00:13:29,740 --> 00:13:32,200
هناك شكّ في داخلكِ

170
00:13:33,410 --> 00:13:37,860
"ماذا سيحدث تالياً؟ هل أنا في الطّريق الصّحيح؟"

171
00:13:37,860 --> 00:13:40,630
بدأتِ بالتّشكيك في حلمكِ

172
00:13:40,630 --> 00:13:42,090
!هذا غير صحيح

173
00:13:48,310 --> 00:13:49,970
عدم يقينكِ واضح في قتالكِ

174
00:13:51,350 --> 00:13:56,770
أدركتِ بأنّ تحقيق حلمكِ يعني
فقدان النّاس الّذين تهتمّين لأمرهم

175
00:14:00,080 --> 00:14:03,410
لكن إذا لم يتحقّق حلمكِ، لن يكون
عليكِ قول الوداع

176
00:14:03,410 --> 00:14:04,820
أليس هذا ما تفكّرين فيه؟

177
00:14:04,820 --> 00:14:06,150
!لا

178
00:14:06,150 --> 00:14:10,160
لا تريدين خسارة حلمكِ، أو الأشخاص
...الّذين تهتمّين لأمرهم

179
00:14:10,160 --> 00:14:12,620
...أنتِ تقلقين وتتردّدين وتُشكّكين

180
00:14:12,740 --> 00:14:15,370
في النّهاية، تشعرين بالإرهاق
...وترفضين كلّ شيء فحسب

181
00:14:18,280 --> 00:14:20,080
!وهذا هو اليأس

182
00:14:21,420 --> 00:14:22,460
!دريم

183
00:14:27,080 --> 00:14:28,170
الوداع

184
00:14:38,270 --> 00:14:40,200
!من الطّبيعيّ أن تتردّد

185
00:14:40,200 --> 00:14:42,270
!لا ضير من التأمّل لفترة

186
00:14:43,800 --> 00:14:46,850
...لعلّها لن تجد الإجابة فوراً

187
00:14:46,850 --> 00:14:49,820
!لكن سنكون دوماً بجانب دريم لمساعدتها

188
00:14:50,450 --> 00:14:51,620
...أنتن

189
00:14:51,910 --> 00:14:55,700
فات الأوان. لم تعُد تملك قوّة النُّهوض

190
00:14:55,700 --> 00:14:58,000
!دريم! لا تستسلمي، ناتسو

191
00:14:58,000 --> 00:14:59,920
!لا تخسري أمام نايتمير، ميرو

192
00:15:01,880 --> 00:15:03,280
!دريم

193
00:15:19,250 --> 00:15:22,810
...شكراً للجميع. لا أنكر بأنّه ساورتني شكوك

194
00:15:26,310 --> 00:15:30,990
...لكن أنتم من دمّرتم مملكتهم الثّمينة

195
00:15:30,990 --> 00:15:32,950
!ولن أخسر أمامكم

196
00:15:34,770 --> 00:15:37,250
قطعتُ وعداً على كوكو

197
00:15:37,250 --> 00:15:39,910
!قلتُ بأنّني سأحيي مملكة بالمير

198
00:15:40,310 --> 00:15:43,710
!أعتقد هذا أفضل شيء بالنّسبة لكوكو

199
00:15:43,710 --> 00:15:45,170
!دريم

200
00:15:51,850 --> 00:15:53,930
!أريد تحقيق حلم كوكو

201
00:15:53,930 --> 00:15:56,930
!مهما حدث، أريد تحقيق حلمه

202
00:16:00,230 --> 00:16:04,170
اشعر بالقوّة المُطلَق عنانها
!من أحلام فتاة صغيرة

203
00:16:05,360 --> 00:16:08,730
!طلقة بريكيور الكريستاليّة

204
00:16:25,210 --> 00:16:28,420
ديسبارايا-ساما، لديّ تقرير

205
00:16:28,420 --> 00:16:31,510
لم يبقَ إلّا بينكي واحد

206
00:16:31,510 --> 00:16:36,370
سينشط عمل الدريم كوليت عمّا قريب

207
00:16:40,880 --> 00:16:42,200
!أحسنتُن صنعاً اليوم

208
00:16:42,200 --> 00:16:44,000
!نراكما غداً

209
00:16:44,000 --> 00:16:47,020
تأخّر الوقت. سوف نقلكن إلى منازلكن

210
00:16:47,910 --> 00:16:48,730
تصبحين على خير

211
00:16:49,200 --> 00:16:51,190
أجل... وداعاً

212
00:16:58,220 --> 00:16:59,030
نوزومي؟

213
00:17:00,420 --> 00:17:03,000
...ا-المعذرة

214
00:17:03,000 --> 00:17:06,050
كوكو. أوصل نوزومي إلى المنزل مشياً

215
00:17:07,110 --> 00:17:07,870
تفضّل

216
00:17:08,760 --> 00:17:10,540
...شـ-شكراً

217
00:17:10,540 --> 00:17:12,010
هيّا. اذهب

218
00:17:14,470 --> 00:17:17,140
دعيه يمشي معكِ يا نوزومي

219
00:17:20,850 --> 00:17:22,890
ارتدِ هذا. الجوّ بارد

220
00:17:24,800 --> 00:17:26,020
...ناتس

221
00:17:36,540 --> 00:17:37,570
هل نفعل؟

222
00:17:37,570 --> 00:17:38,530
حسناً

223
00:17:51,750 --> 00:17:55,050
لم يمشِ أحدٌ في هذا الطّريق

224
00:17:57,940 --> 00:17:59,510
...واحد، اثنان

225
00:18:05,620 --> 00:18:10,110
ستزول آثار الأقدام هذه عندما يذوب الثّلج

226
00:18:12,250 --> 00:18:13,570
:سأطرح عليك سؤالاً

227
00:18:13,570 --> 00:18:17,710
ما الّذي يبقى بعد ذوبان الثّلج؟

228
00:18:17,710 --> 00:18:19,000
ما الّذي يبقى؟

229
00:18:19,000 --> 00:18:20,740
الجواب هو: الذّكريات

230
00:18:23,800 --> 00:18:27,540
لن أنسى المشي معكِ أبداً يا نوزومي

231
00:18:27,540 --> 00:18:29,080
...حتّى بعد ذوبان الثّلج

232
00:18:30,480 --> 00:18:31,970
لن أنسى أبداً

233
00:18:31,970 --> 00:18:34,380
أجل. وأنا لن أنسى أيضاً

234
00:18:39,370 --> 00:18:42,050
...صحيح. يؤدّي هذا الطّريق إلى

235
00:18:52,150 --> 00:18:54,000
أليس هذا جميلاً؟

236
00:18:56,200 --> 00:18:59,740
وجدتُها، ما رأيك أن تضع شجرة
في مملكة بالمير أيضاً؟

237
00:18:59,740 --> 00:19:02,310
!يستطيع الجميع تغطيتها بمُختلف أشكال الزّينة

238
00:19:02,310 --> 00:19:03,510
!سيكون ذلك ممتعاً للغاية

239
00:19:03,510 --> 00:19:05,710
!أجل، قد نُجرّب ذلك

240
00:19:05,710 --> 00:19:07,880
أعتقد بأنّ هذا سوف يُسعد الجميع

241
00:19:34,480 --> 00:19:35,450
نوزومي؟

242
00:19:37,340 --> 00:19:41,320
ماذا؟ يا إلهي... لماذا أبكي؟

243
00:19:43,420 --> 00:19:46,050
أنا سعيدة، حسناً؟

244
00:19:46,050 --> 00:19:50,400
،جميعنا عملنا بجدّ لتحقيق حلمكم

245
00:19:50,400 --> 00:19:53,110
...والآن سوف يتحقّق أخيراً

246
00:19:53,110 --> 00:19:56,500
...أنا سعيدة... حقّاً

247
00:19:59,600 --> 00:20:02,370
ترعرعتُ في مملكة بالمير

248
00:20:02,370 --> 00:20:05,010
إنّه مكانٌ رائع بحقّ

249
00:20:07,020 --> 00:20:12,140
كنتُ سعيداً بوجود كافّة أصدقائي الأعزّاء، وناتس

250
00:20:13,600 --> 00:20:17,450
لكن بعدها خسرتُ كلّ شيء وانتهى
المطاف بي وحيداً

251
00:20:18,340 --> 00:20:22,800
فقدتُ آمالي وأحلامي. كان كابوساً فعلاً

252
00:20:23,650 --> 00:20:27,700
ثمّ يا نوزومي... أنقذتِني أنتِ

253
00:20:33,210 --> 00:20:36,920
مدّتْني ابتسامتكِ بالشّجاعة ثانية

254
00:20:37,940 --> 00:20:39,250
أنا فعلتُ ذلك؟

255
00:20:39,770 --> 00:20:45,400
منذ ذلك الحين، لطالما جعلتُ
ابتسامتكِ تُنير ما بداخلي

256
00:20:45,890 --> 00:20:48,350
قلبكِ القويّ الّذي يخاف على أصدقائكِ

257
00:20:48,350 --> 00:20:50,890
شجاعتكِ وعدم تخلّيكِ عن حلمكِ

258
00:20:52,140 --> 00:20:54,800
نوزومي. مهما شكرتُكِ لا أوفيكِ حقّكِ

259
00:20:54,800 --> 00:20:58,110
وصلتُ إلى هذا الحدّ بفضلكِ

260
00:20:58,600 --> 00:21:01,070
...أنا... أنا حقّاً

261
00:21:01,480 --> 00:21:04,070
!أريدك أن تبقى هنا للأبد حقّاً

262
00:21:04,600 --> 00:21:06,400
وأنا كذلك

263
00:21:07,000 --> 00:21:09,020
أريد أن أبقى معكِ للأبد

264
00:21:09,970 --> 00:21:12,710
لكن... عليك أن تعود إلى الدّيار

265
00:21:12,710 --> 00:21:16,580
البالميريّون يحتاجونك

266
00:21:17,080 --> 00:21:19,480
ناتس وأنا أميران

267
00:21:19,970 --> 00:21:24,940
يجب على أُمراء بالمير أن يعملوا لأجل شعبهم

268
00:21:27,310 --> 00:21:30,260
سنضطرّ لوداع بعضنا يوماً ما

269
00:21:30,620 --> 00:21:34,770
لذا أريد تقدير الوقت الّذي نعيشه معاً الآن

270
00:21:37,570 --> 00:21:38,420
!أجل

271
00:21:39,080 --> 00:21:43,600
أحببتُ الوقت الّذي قضيناه معاً أيضاً

272
00:21:45,110 --> 00:21:46,110
شكراً لكِ

273
00:23:46,150 --> 00:23:49,860
!بقي واحد فقط حتّى نجمع 55 بينكي جميعهم

274
00:23:49,860 --> 00:23:53,620
ذلك الشّيء عى كتفك... هل هو بينكي؟

275
00:23:53,620 --> 00:23:55,950
!رائع! جمعناهم كلّهم

276
00:23:55,950 --> 00:23:58,200
...لا وقت للاحتفال! إنّ نايتمير

277
00:23:58,200 --> 00:24:01,620
!لن أدعكم تحصلون عليه... على الإطلاق

278
00:24:01,620 --> 00:24:03,960
!لا! لا تقعي ضحيّة مكيدته

279
00:24:05,170 --> 00:24:07,250
:أجل! بريكيور 5

280
00:24:07,250 --> 00:24:09,670
"!خطّة كاوارينو عديمة الرّحمة"

281
00:24:09,670 --> 00:24:11,220
!شاهدوها، شاهدوها، شاهدوها، حسناً؟