1
00:00:21,000 --> 00:00:22,210
!من فضلك

2
00:00:30,600 --> 00:00:33,640
!تمّت عمليّة النّسخ! حصلنا على نشراتنا

3
00:00:35,350 --> 00:00:36,520
...حسناً

4
00:00:36,520 --> 00:00:41,560
والآن سنُزيّن المتجر من أجل
...مبيعات الكريسماس

5
00:00:41,940 --> 00:00:43,360
!وهذا ما في الأمر

6
00:00:43,650 --> 00:00:44,770
!أجل

7
00:00:59,710 --> 00:01:01,710
هكذا؟

8
00:01:02,000 --> 00:01:04,630
أو بالأحرى... هكذا؟

9
00:01:05,840 --> 00:01:07,880
أورارا؟ ما الّذي تفعلينه؟

10
00:01:07,880 --> 00:01:09,860
أفكّر في الإضاءة

11
00:01:09,860 --> 00:01:14,140
يختلف شكل الشّيء باختلاف
طريقة تسليط الضّوء عليه

12
00:01:14,140 --> 00:01:15,680
حقّاً؟

13
00:01:16,680 --> 00:01:20,480
مُهندس الإضاءة في برنامجي التّلفزيونيّ
!علّمني كلّ شيء عن الأمر

14
00:01:20,480 --> 00:01:22,100
!يمكنكِ جعله يبدو لامعاً حقّاً

15
00:01:22,570 --> 00:01:26,690
!أنتِ مُذهلة يا أورارا. كمُمثّلة محترفة

16
00:01:27,370 --> 00:01:29,410
!شكراً لكِ

17
00:01:35,200 --> 00:01:37,660
"ليلة مُقدّسة في يوم مُقدّس"

18
00:01:37,660 --> 00:01:40,750
"أعلم بأنّك هناك، تحت نفس هذه السّماء"

19
00:01:40,750 --> 00:01:44,840
سأتجوّل في محيط النّجوم هذا"
"...مرّة أخرى بحثاً عنك

20
00:01:44,840 --> 00:01:46,170
!من فضلك يا كارين

21
00:01:46,800 --> 00:01:48,760
!إنّها جميلة يا كوماتشي

22
00:01:49,720 --> 00:01:53,180
ألّفتِ قصيدة حُبّ من أجل بطاقة المُنتج، صحيح؟

23
00:01:53,510 --> 00:01:56,970
...لـ-ليس عليكِ قراءتها. هذا مُحرج

24
00:01:57,520 --> 00:02:02,440
الكريسماس عجيب حقّاً. ما زلنا
...في بداية ديسمبر

25
00:02:02,440 --> 00:02:05,150
أعتقد لا بأس بذلك. فالجميع يستمتعون

26
00:02:05,150 --> 00:02:06,740
...حسناً، إنّه الكريسماس

27
00:02:07,070 --> 00:02:11,280
!إنّه حدث مهمّ جدّاً للفتيات الصّغيرات

28
00:02:11,280 --> 00:02:15,290
!نحن لا نستمتع فحسب! نحن نتّخذ الأمر بجدّية

29
00:02:15,990 --> 00:02:17,280
حـ-حقّاً؟

30
00:02:17,660 --> 00:02:18,660
أجل

31
00:02:19,820 --> 00:02:22,040
!نسينا الزّهور

32
00:02:22,380 --> 00:02:23,960
الزّهور؟

33
00:02:23,960 --> 00:02:26,000
...بالنّسبة لهذا

34
00:02:28,260 --> 00:02:31,760
!إنّهما كارين-سان ورين-تشان، وهذا ما في الأمر

35
00:02:31,760 --> 00:02:33,090
كلتانا؟

36
00:02:33,090 --> 00:02:34,510
مسؤولتان عن الزّهور؟

37
00:02:34,510 --> 00:02:36,960
!أجل! كلتاكما مسؤولتان عن الزّهور

38
00:04:18,200 --> 00:04:22,580
شعور جميل، صحيح؟ ما رأيكِ بهذا؟

39
00:04:22,580 --> 00:04:26,300
!ليّن جدّاً. شدّ عزمك أكثر

40
00:04:26,300 --> 00:04:30,880
...حاضر، حاضر... أكثر... أكثر

41
00:04:30,880 --> 00:04:33,120
أجل، هكذا

42
00:04:34,470 --> 00:04:35,970
تستحقّين هذا

43
00:04:35,970 --> 00:04:37,310
ماذا قلت؟

44
00:04:37,310 --> 00:04:40,730
...لا شيء. بالمناسبة

45
00:04:40,730 --> 00:04:44,050
لم أعُد أرى بلودي-سان مؤخّراً

46
00:04:44,050 --> 00:04:49,240
.أجل. بلودي هو رجل واثق
نادراً ما يأتي إلى هنا

47
00:04:49,240 --> 00:04:51,810
ما دام العمل قد أُنجِز، فهذا ما يهمّ

48
00:04:51,810 --> 00:04:55,440
أجل... لكن ألن يُوبَّخ على عدم مجيئه؟

49
00:04:55,440 --> 00:05:00,160
يُوبَّخ بواسطة كاوارينو؟ هذا هُراء

50
00:05:00,160 --> 00:05:03,710
بالإضافة إلى ذلك، هناك أمور
...أهمّ للقلق بشأنها

51
00:05:04,860 --> 00:05:06,170
بالنّسبة لكِ؟ أم بالنّسبة لي؟

52
00:05:06,170 --> 00:05:10,050
تأتي إلى هنا كلّ يوم بلا هدف حقيقيّ

53
00:05:10,050 --> 00:05:12,490
هل يجدر بك أن تهدر الوقت بالتّدليك؟

54
00:05:12,490 --> 00:05:14,050
أنا؟

55
00:05:14,050 --> 00:05:18,010
قِسمك السّابق قد حُلّ، أنسيت؟

56
00:05:18,010 --> 00:05:24,130
إن لم تفعل شيئاً بسرعة... فقد تُسلَّم
تلك الورقة السّوداء

57
00:05:24,810 --> 00:05:28,010
كاوارينو هو من حلّه... لن أحصل
على ورقة سوداء

58
00:05:29,940 --> 00:05:31,610
سنرى ذلك

59
00:05:37,260 --> 00:05:39,840
الوعد السرّي لرين وكارين

60
00:05:42,870 --> 00:05:44,210
!عُدت

61
00:05:44,210 --> 00:05:45,820
أهلاً بعودتك يا رين

62
00:05:45,820 --> 00:05:47,790
في الوقت المناسب

63
00:05:47,790 --> 00:05:49,920
ماذا؟ مينازوكي-سان؟

64
00:05:49,920 --> 00:05:51,300
مرحباً

65
00:05:51,300 --> 00:05:53,380
أمّي؟ ما الأمر؟

66
00:05:53,380 --> 00:05:56,930
عليّ أخذ يو وآي

67
00:05:56,930 --> 00:05:59,500
آسفة لمفاجأتكما بهذا، لكن
هل يمكنكما مراقبة المتجر؟

68
00:06:00,200 --> 00:06:00,460
تفضّلي

69
00:06:00,650 --> 00:06:01,600
...مـ-مهلاً

70
00:06:01,600 --> 00:06:03,180
من فضلكِ

71
00:06:04,690 --> 00:06:09,650
آسفة يا مينازوكي-سان، الوضع فوضويّ
قليلاً. اعتبري نفسكِ في المنزل

72
00:06:09,650 --> 00:06:10,780
حـ-حسناً

73
00:06:11,780 --> 00:06:14,240
حسناً يا رين. أعتمد عليكِ

74
00:06:15,490 --> 00:06:19,200
.لا أعتقد بأنّنا نملك خياراً
آسفة يا كارين-سان

75
00:06:19,200 --> 00:06:24,080
تريدين إعادة الزّهور من دوني؟

76
00:06:24,080 --> 00:06:26,400
ستواجهين صعوبة بمفردك، أليس كذلك؟
سوف أساعدكِ

77
00:06:27,330 --> 00:06:30,700
لا تقلقي بشأن ذلك! إنّه عمل
صعب في حال لم تعتادي عليه

78
00:06:30,960 --> 00:06:34,280
أنا واثقة بأنّني أستطيع مساعدتكِ

79
00:06:34,280 --> 00:06:35,840
فأنا أراكِ تعملين من وقت لآخر

80
00:06:36,430 --> 00:06:38,960
المشاهدة شيء والقيام به شيء مختلف

81
00:06:39,350 --> 00:06:40,600
!سأكون بخير

82
00:06:43,310 --> 00:06:45,940
نعم؟ متجر ناتسكي للزّهور

83
00:06:45,940 --> 00:06:48,560
طلباتك؟

84
00:06:48,560 --> 00:06:51,570
نعم. شكراً

85
00:06:51,570 --> 00:06:53,490
نعم، نعم

86
00:06:53,490 --> 00:06:54,570
المعذرة

87
00:06:54,900 --> 00:06:56,270
...نحن

88
00:06:58,240 --> 00:06:59,870
أ-أجل، حسناً

89
00:06:59,870 --> 00:07:01,950
...لا بدّ أنّهم مشغولون

90
00:06:59,870 --> 00:07:05,230
خمس سلل زهور حمراء لمركز الجالية؟

91
00:07:01,950 --> 00:07:03,560
هذا ما أعتقده

92
00:07:04,000 --> 00:07:05,250
سنغادر

93
00:07:05,230 --> 00:07:07,570
وتريدون حيوانات محشوّة مع الزّهور أيضاً؟

94
00:07:06,540 --> 00:07:07,580
!تفضّلا بالدّخول

95
00:07:08,920 --> 00:07:10,750
أنا آسفة لأنّني تركتكما تنتظران

96
00:07:09,810 --> 00:07:10,930
!أجل، شكراً لك

97
00:07:10,750 --> 00:07:12,630
عمّاذا تبحثان؟

98
00:07:17,760 --> 00:07:19,510
!شكراً على زيارتكما

99
00:07:23,430 --> 00:07:25,980
!آمل أن تتفتّح قريباً

100
00:07:25,980 --> 00:07:27,520
هذا حماسيّ، أليس كذلك؟

101
00:07:27,520 --> 00:07:30,380
الطّقس بارد في الخارج، لذا سوف
نزرعها في أماكن مغلقة

102
00:07:30,380 --> 00:07:31,180
!حسناً

103
00:07:32,230 --> 00:07:37,260
ننصح بزرع نبتة كهذه في الحديقة
بدلاً من أصيص

104
00:07:37,860 --> 00:07:41,530
التعرّض للهواء البارد في الخارج
!سوف يزيدها جمالاً

105
00:07:41,950 --> 00:07:44,120
حقّاً؟ سنفعل ذلك إذاً

106
00:07:44,120 --> 00:07:45,200
!شكراً

107
00:07:45,200 --> 00:07:46,870
!شكراً على الزّيارة

108
00:07:52,670 --> 00:07:55,630
المعذرة... هل يمكنني الحصول على بعض الزّهور؟

109
00:07:55,630 --> 00:07:58,090
أهلاً بكِ. عمّاذا تبحثين؟

110
00:07:58,090 --> 00:07:59,930
...في الواقع

111
00:08:02,100 --> 00:08:03,670
!مرحباً بكِ

112
00:08:03,670 --> 00:08:06,140
!هل أنتِ بمفردكِ؟ يا لكِ من فتاة ناضجة

113
00:08:06,140 --> 00:08:10,210
هل هي هديّة؟ أم أمّكِ أرسلتكِ؟

114
00:08:10,770 --> 00:08:11,940
...في الحقيقة

115
00:08:12,520 --> 00:08:14,760
...إنّها هديّة عيد ميلاد لأمّي

116
00:08:14,760 --> 00:08:18,780
عظيم! سأساعدكِ في الاختيار إذاً

117
00:08:18,780 --> 00:08:19,280
حقّاً؟

118
00:08:19,280 --> 00:08:20,660
!أجل، حقّاً

119
00:08:22,820 --> 00:08:25,650
...كارين ورين-سان تأخّرتا كثيراً

120
00:08:25,650 --> 00:08:27,830
مضى وقت تطويل

121
00:08:27,830 --> 00:08:35,750
هل يُعقل أنّهما تتشاجران بشأن الزّهور ثانية؟

122
00:08:39,010 --> 00:08:41,340
أجل، كنتُ قد نسيتُ ذلك

123
00:08:41,340 --> 00:08:42,750
!هذا فظيع، ميرو

124
00:08:42,750 --> 00:08:46,220
كان من الخطأ تكليفهما بالعمل على الزّهور

125
00:08:46,220 --> 00:08:48,180
!لا حاجة للقلق

126
00:08:48,180 --> 00:08:51,840
!رين-تشان وكارين-سان ستكونان بخير

127
00:08:55,230 --> 00:08:57,480
تفضّل. اعتنِ بها جيّداً، اتّفقنا؟

128
00:08:57,480 --> 00:08:59,190
!حسناً! وداعاً

129
00:08:59,740 --> 00:09:00,990
!وداعاً

130
00:09:05,450 --> 00:09:06,830
كارين-سان

131
00:09:06,830 --> 00:09:10,160
معلوماتكِ وافرة حول الزّهور، أليس كذلك؟

132
00:09:10,160 --> 00:09:12,750
...إطلاقاً، مقارنةً بكِ

133
00:09:13,920 --> 00:09:16,750
ساعدتِني كثيراً. شكراً جزيلاً

134
00:09:16,750 --> 00:09:20,010
لا شكر على واجب. استمتعتُ بذلك أيضاً

135
00:09:24,010 --> 00:09:26,970
أنتِ تعشقين الزّهور، أليس كذلك؟

136
00:09:27,960 --> 00:09:31,180
في الواقع... أقصد، أنتِ تعشقين
الزّهور أيضاً، أليس كذلك؟

137
00:09:31,810 --> 00:09:34,600
ليس هذا ما أقصده. أنتِ بائعة زهور

138
00:09:35,360 --> 00:09:39,150
تفكّرين ما يريده الزّبون تماماً

139
00:09:39,150 --> 00:09:42,350
وتتعاملين معهم بلطف ومُراعاة

140
00:09:42,820 --> 00:09:46,620
لا أعتقد بأنّكِ تستطيعين فعل ذلك
ما لم تحبّيها حقّاً

141
00:09:47,240 --> 00:09:51,900
أتوقّع بأنّكِ ستمارسين هذه
المهنة في المستقبل

142
00:09:53,120 --> 00:09:57,040
فـ-في الواقع... أحبّ هذا العمل

143
00:09:57,380 --> 00:10:02,260
لكن ما زلتُ لم أحدّد ماذا أريد
أن أكون في المستقبل

144
00:10:02,970 --> 00:10:05,720
من الصّعب أن يرسو المرء على شيء

145
00:10:06,300 --> 00:10:10,180
لا أعتقد بأنّني عثرتُ على ما أريد فعله فعليّاً

146
00:10:10,470 --> 00:10:13,640
...هذا صحيح. ليس من السّهل أن نقرّر ذلك

147
00:10:14,640 --> 00:10:19,430
لا أعرف ماذا أريد أن أفعل أيضاً

148
00:10:20,610 --> 00:10:25,110
لكنّكِ تعملين بجدّ في مجلس الطّلبة
...وتجتهدين في دراستكِ

149
00:10:25,110 --> 00:10:28,870
!وأسعدتِ ذلك الزّبون قبل قليل

150
00:10:28,870 --> 00:10:32,500
يمكنكِ فعل شيء. فما الّذي يجعلكِ قلقة؟

151
00:10:32,500 --> 00:10:37,030
أعمل بجدّ في أيّ شيء أركّز عليه حاليّاً

152
00:10:37,500 --> 00:10:42,800
لكن لا أعرف ما إن كان هذا بالضّرورة
هو ما أريد فعله في المستقبل

153
00:10:43,550 --> 00:10:45,740
هذا ما أقوله لنفسي أحياناً

154
00:10:47,680 --> 00:10:52,000
لذا أحسد الأشخاص مثل كوماتشي وأورارا

155
00:10:52,000 --> 00:10:56,810
اللّتين لديهما حلم وتكرّسان نفسيهما له

156
00:10:57,550 --> 00:11:02,510
هذا ما كنتُ أقوله لنفسي من قبل
بينما كنتُ أراقبهما

157
00:11:02,510 --> 00:11:06,240
بدأتُ أتمنّى أن يكون لديّ حلم

158
00:11:10,400 --> 00:11:13,150
حسناً، يجدر بنا أن نعود إلى الأُخريات

159
00:11:13,500 --> 00:11:14,660
...أنا

160
00:11:15,320 --> 00:11:20,080
أستمتع بكُرة الصّالات والمساعدة
في المنزل أيضاً

161
00:11:20,080 --> 00:11:23,840
الوقت الّذي قضيتُه أفعل ذلك
يبدو مُرضياً حقّاً

162
00:11:23,840 --> 00:11:28,750
،لكن كلّما نظرتُ إلى نوزومي
...أسأل نفسي أحياناً

163
00:11:29,970 --> 00:11:32,600
لمساعدة البالمين، أصبحتْ بريكيور

164
00:11:32,970 --> 00:11:37,310
وتولّت قيادتنا... هذا مذهل جدّاً

165
00:11:38,020 --> 00:11:43,230
أتمنّى حقّاً لو أستطيع تكريس نفسي
لشيء أريد فعله بشدّة

166
00:11:43,230 --> 00:11:49,980
لكن لستُ أدري ما إن كنتُ سأجد
شيئاً أريد فعله مثلما تفعل نوزومي

167
00:11:50,410 --> 00:11:53,270
لذا أنا مثلكِ بعض الشّيء

168
00:11:54,450 --> 00:11:57,400
وجدتُها. لنقطع وعداً

169
00:11:57,400 --> 00:11:58,610
وعد؟

170
00:11:59,000 --> 00:12:03,880
،إذا وجدنا ما نريد فعله في المستقبل
!فسوف نخبر بعضنا الآخر أوّلاً

171
00:12:04,460 --> 00:12:05,340
فكرة سديدة

172
00:12:05,340 --> 00:12:09,180
!أنا متحمّسة لرؤية من يجده أوّلاً

173
00:12:15,860 --> 00:12:19,710
!شيء تريدان فعله حقّاً؟ لن تجداه أبداً

174
00:12:20,440 --> 00:12:24,180
...لأنّه لا مستقبل لكما

175
00:12:31,250 --> 00:12:33,370
تأخّر الوقت، أليس كذلك؟

176
00:12:33,370 --> 00:12:35,830
رين، لنسرع. الأُخريات ينتظرننا

177
00:12:35,830 --> 00:12:39,130
!أجل، سئمتُ الانتظار كثيراً

178
00:12:41,630 --> 00:12:42,590
!نايتمير

179
00:12:42,920 --> 00:12:48,350
ما كان ينبغي أن أهدر الوقت في التّدليك حقّاً

180
00:12:49,260 --> 00:12:50,370
عمّاذا تتكلّم؟

181
00:12:50,370 --> 00:12:54,660
!عليّ أن أتحرّك بين الحين والآخر أيضاً

182
00:13:06,780 --> 00:13:07,610
!ثمّة شيء هنا

183
00:13:07,610 --> 00:13:08,120
...أجل

184
00:13:13,450 --> 00:13:14,370
!رين

185
00:13:14,370 --> 00:13:15,190
!حسناً

186
00:13:17,580 --> 00:13:21,460
!تحوُّل بريكيور

187
00:13:33,980 --> 00:13:36,540
!لهب الشّغف الأحمر

188
00:13:37,250 --> 00:13:38,650
!كيور روج

189
00:13:42,070 --> 00:13:46,110
!تحوُّل بريكيور

190
00:13:58,580 --> 00:14:01,150
!ربيع الذّكاء الأزرق

191
00:14:01,520 --> 00:14:02,840
!كيور آكوا

192
00:14:29,780 --> 00:14:36,120
يمكنني منح قوّة حتّى للأوراق المُتساقطة

193
00:14:36,620 --> 00:14:39,900
ألا تُريدان قوّة أيضاً؟

194
00:14:41,040 --> 00:14:41,860
ماذا؟

195
00:14:42,250 --> 00:14:47,120
استمعتُ لكما قبل قليل. لا تملكان شيئاً، صحيح؟

196
00:14:47,420 --> 00:14:49,880
...لا آمال ولا أحلام للمستقبل

197
00:14:51,840 --> 00:14:55,060
أهذا ما ندعوه باليأس؟

198
00:14:55,060 --> 00:15:00,400
ارتأيتُ بأنّكما قد تحتاجان لقليل
!من قوّة اليأس

199
00:15:01,480 --> 00:15:02,380
!ما الّذي تقوله؟

200
00:15:02,810 --> 00:15:04,090
!ستكون لدينا أحلام

201
00:15:06,030 --> 00:15:08,740
!سوف نجدها بكلّ تأكيد

202
00:15:14,870 --> 00:15:17,370
أوتظنّان ذلك حقّاً؟

203
00:15:17,950 --> 00:15:23,670
!لكن الأحلام ليست إلّا وهم

204
00:15:34,390 --> 00:15:38,850
لن تجدا هذا الهُراء مهما بحثتُما طويلاً

205
00:15:38,850 --> 00:15:39,350
!مُخطئ

206
00:15:40,600 --> 00:15:41,940
...نوزومي، أورارا

207
00:15:41,940 --> 00:15:42,960
...وكوماتشي...

208
00:15:43,310 --> 00:15:46,360
!عثرنَ على أحلامهن! إنّها ليست أوهاماً...

209
00:15:46,360 --> 00:15:47,750
!اصمتا

210
00:15:50,650 --> 00:15:53,990
!حتّى لو وجدتُنّ أحلامكن، تبقى أوهاماً ما لم تتحقّق

211
00:15:53,990 --> 00:15:57,680
!وخلف تلك الأوهام يكمن اليأس

212
00:15:57,680 --> 00:16:03,350
الأحلام والآمال بلا معنى! اليأس
!هو القوّة المُطلَقة الوحيدة

213
00:16:04,560 --> 00:16:05,480
!ماذا؟

214
00:16:08,420 --> 00:16:09,920
...الآمال والأحلام

215
00:16:09,920 --> 00:16:11,530
!لها معنى...

216
00:16:20,270 --> 00:16:22,890
أنا قويّ اليوم

217
00:16:39,790 --> 00:16:42,500
والآن... استعدّا

218
00:16:52,880 --> 00:16:54,510
!انتظر لحظة فقط

219
00:16:54,510 --> 00:16:55,640
...كارين

220
00:16:55,640 --> 00:16:56,800
...ورين-سان...

221
00:16:56,800 --> 00:16:59,010
!لن تغرقا في يأس أبداً...

222
00:16:59,350 --> 00:17:00,490
!أنتن

223
00:17:04,060 --> 00:17:08,230
!تحوُّل بريكيور

224
00:17:25,540 --> 00:17:27,650
!قوّة الأمل العظيمة

225
00:17:28,140 --> 00:17:29,540
!كيور دريم

226
00:17:31,340 --> 00:17:33,610
!رائحة اللّيمون الفوّاحة

227
00:17:34,110 --> 00:17:35,720
!كيور ليمونيد

228
00:17:37,590 --> 00:17:40,030
بلاد السّكينة الخضراء

229
00:17:40,990 --> 00:17:42,560
!كيور مينت

230
00:18:04,500 --> 00:18:06,540
!هل أنتِ بخير، كوكو؟

231
00:18:07,040 --> 00:18:08,330
!تماسكي، ميرو

232
00:18:10,540 --> 00:18:12,840
روج! آكوا! هل أنتما بخير؟

233
00:18:12,840 --> 00:18:14,230
!أجل

234
00:18:14,960 --> 00:18:18,610
لا جدوى! كلتاهما مُحطّمتان بالفعل

235
00:18:19,720 --> 00:18:24,810
روج وآكوا علّمتاني الكثير من الأمور الهامّة

236
00:18:25,020 --> 00:18:26,230
ماذا؟

237
00:18:26,230 --> 00:18:30,230
...كيفيّة الاعتناء بالآخرين... وإظهار المشاعر لهم

238
00:18:30,610 --> 00:18:34,820
...أجل! إكليل الزّفاف الّذي صنعَتْه رين-سان

239
00:18:34,820 --> 00:18:40,340
بذلَتْ جهداً كبيراً فيه. كان
!يعبّر عن مشاعرها حقّاً

240
00:18:42,410 --> 00:18:44,510
،وعندما كنتُ مريضة

241
00:18:44,990 --> 00:18:48,000
اعتنتْ كارين بي طوال الوقت، ميرو

242
00:18:48,460 --> 00:18:51,730
كانت يدا كارين دافئتين جدّاً، ميرو

243
00:18:52,210 --> 00:18:53,210
...ميلك

244
00:18:53,550 --> 00:18:56,960
...قوّة الاعتناء بشخص ورسم البسمة في وجهه

245
00:18:57,340 --> 00:19:00,550
!هذا هو الحلم... هذا هو الأمل فعليّاً

246
00:19:02,470 --> 00:19:03,160
...رسم البسمة

247
00:19:04,930 --> 00:19:05,990
!في وجه الجميع...

248
00:19:28,870 --> 00:19:31,500
!بريكيور

249
00:19:47,850 --> 00:19:50,370
هل انتهيتن بهذه السّرعة يا بريكيور؟

250
00:19:50,850 --> 00:19:54,230
!لا. لم ينتهِ الأمر بعد

251
00:19:55,610 --> 00:19:56,400
!ماذا؟

252
00:19:57,110 --> 00:19:58,880
!روج! آكوا

253
00:19:59,780 --> 00:20:00,740
...جميعهن

254
00:20:00,740 --> 00:20:02,410
!على حقّ

255
00:20:02,860 --> 00:20:07,040
بذلنا كلّ ما لدينا في كلّ شيء فعلناه

256
00:20:07,040 --> 00:20:09,800
...إذا كان هذا يُسعد شخصاً

257
00:20:10,040 --> 00:20:11,580
...فهذا وحده

258
00:20:11,580 --> 00:20:12,920
!يُسعدنا حقّاً...

259
00:20:13,710 --> 00:20:14,850
!كلام فارغ

260
00:20:19,860 --> 00:20:24,140
اشعر بالقوّة المُشتعلة من قلب
!فتاة صغيرة نقيّ

261
00:20:25,090 --> 00:20:28,680
!اشتعال بريكيور روج

262
00:20:37,070 --> 00:20:41,280
اشعر بالقوّة المُحطِّمة للصّخور
!الخاصّة بدوّامة فتاة صغيرة

263
00:20:42,200 --> 00:20:46,010
!زوبعة بريكيور آكوا

264
00:20:59,680 --> 00:21:02,340
!سأعود إلى التّدليك على ما أعتقد

265
00:21:06,260 --> 00:21:07,970
!حسناً، هيّا بنا نعود

266
00:21:07,970 --> 00:21:08,930
!أجل

267
00:21:09,640 --> 00:21:11,060
!تفضّلوا هذه الزّهور

268
00:21:12,980 --> 00:21:15,850
!إنّهما نوعان مختلفان تماماً

269
00:21:15,850 --> 00:21:18,270
كاتليا وبخور مريم، صحيح؟

270
00:21:19,440 --> 00:21:23,650
ارتأيتُ أنّه سيكون من اللّطيف
الاستمتاع بنوعين مختلفين

271
00:21:23,650 --> 00:21:25,510
ناقشنا الأمر واتّفقنا على ذلك

272
00:21:25,510 --> 00:21:27,970
...أجل. في نهاية المطاف

273
00:21:28,910 --> 00:21:31,470
!أردنا رسم البسمة في وجه الجميع

274
00:21:34,000 --> 00:21:36,350
!رأيتم؟ كما قلتُ تماماً

275
00:21:36,350 --> 00:21:39,210
!إنّهما مُتناغمتان تماماً

276
00:21:40,170 --> 00:21:43,760
،حسناً! سوف نحتسي الشّاي

277
00:21:43,760 --> 00:21:44,880
!وهذا ما في الأمر

278
00:21:44,880 --> 00:21:47,640
بئساً يا نوزومي. كلّ ما تفكّرين
...فيه هو الطّعام

279
00:21:47,640 --> 00:21:48,390
رين

280
00:21:48,390 --> 00:21:49,320
نعم؟

281
00:21:49,760 --> 00:21:55,020
أظنّني عثرتُ على لمحة فيما
يخصّ ما أريد فعله

282
00:21:56,060 --> 00:21:58,940
أظنّني كذلك أيضاً

283
00:22:00,820 --> 00:22:03,110
هل يعزو الفضل لهُن؟

284
00:22:04,030 --> 00:22:06,200
هذا وارد

285
00:23:46,680 --> 00:23:49,240
كوماتشي-سان! اكتملت قصّتك؟

286
00:23:49,940 --> 00:23:52,440
...يبدو أنّني عالقة في المشهد الأخير

287
00:23:52,440 --> 00:23:55,020
!حسناً! سألقي نظرة إليها

288
00:23:55,020 --> 00:23:57,200
يمكنكِ ذلك... بعد أن تكتمل

289
00:23:57,200 --> 00:23:59,860
حسناً، حسناً، هل ستسألين ناتس عنها؟

290
00:23:59,860 --> 00:24:02,330
!لا، لا أستطيع! أبداً أبداً أبداً

291
00:24:02,700 --> 00:24:04,960
...أ-أقصد

292
00:24:07,250 --> 00:24:08,890
:أجل! بريكيور 5

293
00:24:08,890 --> 00:24:11,350
"قرار كوماتشي ومستقبل ناتس"

294
00:24:11,340 --> 00:24:12,680
!شاهدوها، شاهدوها، شاهدوها، حسناً؟