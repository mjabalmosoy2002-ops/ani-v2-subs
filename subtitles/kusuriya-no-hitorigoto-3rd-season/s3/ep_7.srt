1
00:00:06,400 --> 00:00:13,530
مُذكّرات الصّيدلانيّة

2
00:00:06,400 --> 00:00:13,530
مُذكّرات الصّيدلانيّة

3
00:01:30,990 --> 00:01:33,990
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

4
00:01:33,270 --> 00:01:38,660
أُرافق الطّبيبَ الدجّال إلى دياره بناء
على طلب مولايّ جينشي

5
00:01:39,300 --> 00:01:43,640
لكن لماذا يُرافقنا مُتخفِّياً؟
هل هناك خطبٌ ما في هذه القرية؟

6
00:01:45,280 --> 00:01:46,090
أجل

7
00:01:56,420 --> 00:02:00,680
.أعتقد بأنّك تستطيع التكلُّم الآن
هذه الغرفة مُنعزِلة عن الآخرين

8
00:02:01,190 --> 00:02:02,870
هل كنتِ تستحمّين؟

9
00:02:02,870 --> 00:02:07,150
أغسل شعري فقط. أنا آسفة
لأنّني غير لائقة المظهر

10
00:02:08,140 --> 00:02:09,530
لماذا هو هنا؟

11
00:02:10,700 --> 00:02:13,460
هل يمكنكِ إعادة تكرار هذا المكياج؟

12
00:02:13,870 --> 00:02:17,120
يمكنني، إذا امتلكتُ الأدوات المُناسبة

13
00:02:17,120 --> 00:02:18,180
افعليها إذاً

14
00:02:24,410 --> 00:02:26,850
سأحضر ماء ساخناً جديداً

15
00:02:26,850 --> 00:02:29,420
لا تُكلّفي نفسكِ. لا بأس في هذا

16
00:02:31,280 --> 00:02:34,430
...غسلتُ قدمَي بعد شعري، لكن

17
00:02:34,740 --> 00:02:35,780
ما المُشكلة؟

18
00:02:35,780 --> 00:02:37,700
لا، لا شيء

19
00:02:37,700 --> 00:02:41,770
إن لم يكُن يُبالي، فسأبقي ذلك سرّاً

20
00:02:51,910 --> 00:02:54,820
تخفُّ النُّدَب مع مرور الوقت

21
00:02:55,570 --> 00:02:57,700
لكنّها لا تزول تماماً

22
00:02:58,780 --> 00:03:00,460
بالمُناسبة يا مولايّ جينشي

23
00:03:00,460 --> 00:03:01,700
ما الأمر؟

24
00:03:01,700 --> 00:03:05,290
لماذا زرتَ منزل عائلة الطّبيب؟

25
00:03:06,080 --> 00:03:09,790
هذه مُجرّد محطّة عبور، لكن ثمّة
أمر يُثير قلقي

26
00:03:09,790 --> 00:03:11,600
محطّة عبور؟

27
00:03:11,600 --> 00:03:14,050
ما هو الشّيء المُقلِق؟

28
00:03:14,550 --> 00:03:18,680
ابن عمّكِ المحبوب قالَ ذلك أثناء
اللّعب بالمعداد الخاصّ به

29
00:03:19,710 --> 00:03:21,180
لاهان؟

30
00:03:21,630 --> 00:03:25,990
ثمّة مُشكلة ما في كمّية الأرزّ من هذه
المنطقة في السّنوات القليلة الماضية

31
00:03:26,310 --> 00:03:30,100
لاهان مُتعصِّب للأرقام كثيراً

32
00:03:30,100 --> 00:03:32,840
يبدو هذا شيئاً يستحقّ التحرّي عنه

33
00:03:33,310 --> 00:03:37,450
...لكن سماع رواية كهذه

34
00:03:38,050 --> 00:03:40,900
،المالِك الحاليّ، الّذي يملك حقوقَ الأرض

35
00:03:40,900 --> 00:03:45,960
يحاول طرد صانعي الورق ليبدأ
في صنع الورق بنفسه

36
00:03:48,130 --> 00:03:52,320
صنع الورق هو مجال تجاريّ هامّ
يحتاج عنايةً أكبر من الآن فصاعداً

37
00:03:53,080 --> 00:03:55,800
لا يمكننا تقبُّل استبدال حِرفيّين مُعلّمين
بواسطة هُواة

38
00:03:56,270 --> 00:03:58,500
!كم هذا مُزعج

39
00:03:58,500 --> 00:04:02,490
،هل تريدني أن أُشكّل نُدبةً جديدة الآن
أم أفعل ذلك في الصّباح؟

40
00:04:02,890 --> 00:04:04,100
الآن من فضلكِ

41
00:04:04,530 --> 00:04:08,620
،إذا طردتُه من هذه الغرفة الآن
فستكون كارثة حقيقيّة

42
00:04:10,760 --> 00:04:13,270
ألن يفعلها السّيّد باسين لأجلك؟

43
00:04:13,520 --> 00:04:16,030
لا يملك المهارات اللّازمة

44
00:04:16,030 --> 00:04:18,990
ألهذا السّبب أحضرتني معك؟

45
00:04:19,250 --> 00:04:20,610
ليس هذا السّبب فقط

46
00:04:29,170 --> 00:04:33,500
لا تنم من فضلك. سأحضر السّيّد
باسين قبل أن تفعل

47
00:04:33,500 --> 00:04:36,930
حتّى لو كان هنا، هل يمكنكما
فعل أيّ شيء لي؟

48
00:04:36,930 --> 00:04:40,740
،غالباً لا. بخلاف أبيه، السّيّد غاوشون

49
00:04:40,740 --> 00:04:42,900
لا يزال السّيّد باسين يفتقر للمهارة

50
00:04:42,900 --> 00:04:44,810
لماذا أحضرت السّيّد باسين؟

51
00:04:46,030 --> 00:04:53,180
في الواقع، إنّه... يستطيع الاهتمام
ببعض الأمور أيضاً

52
00:04:53,180 --> 00:04:54,920
كأنّك تتملّص من السّؤال

53
00:04:56,400 --> 00:05:00,510
حسناً، أعتقد بأنّ القدرة على التسكُّع مع مولايّ
جينشي دون أفكار طريفة

54
00:05:00,510 --> 00:05:02,610
هي موهبة نادرة بحدّ ذاتها

55
00:05:04,620 --> 00:05:06,740
حسناً، انتهيت

56
00:05:19,660 --> 00:05:22,210
ماذا؟ انتهيتِ؟

57
00:05:25,630 --> 00:05:26,680
!هذا فظيع

58
00:05:31,150 --> 00:05:33,350
تـ-توقّفي رجاء

59
00:05:33,350 --> 00:05:37,690
هذا يجعلني أرغب في المُتابعة أكثر بالطّبع

60
00:05:38,780 --> 00:05:39,540
سأدخل

61
00:05:39,540 --> 00:05:41,150
—بربّكِ، يكفي

62
00:05:56,790 --> 00:06:00,040
كان ذلك أفضل تنسيق يجري بيننا

63
00:06:02,970 --> 00:06:06,850
الحلقة 55: الرِّهان

64
00:06:12,450 --> 00:06:15,440
نِقاش؟

65
00:06:16,170 --> 00:06:18,550
هل ذلك هو مالِك الأرض في الوسط؟

66
00:06:22,560 --> 00:06:24,990
هل كنتِ بحاجة للمجيء؟

67
00:06:24,990 --> 00:06:27,160
الطّبيب مَن طلب منّي ذلك

68
00:06:27,160 --> 00:06:29,710
لا تريد أن يشعر بالوحشة، أليس كذلك؟

69
00:06:30,110 --> 00:06:32,260
...لا حاجة للتّعبير عن الأمر بهذه الطّريقة

70
00:06:35,090 --> 00:06:38,590
على أيّ حال، لديهم كثير من المشروبات
رغم مساحة المكان الصّغيرة

71
00:06:39,670 --> 00:06:43,300
المشروب الرّئيسيّ المُقدَّم هنا هو
المشروب العكِر في الرّفوف

72
00:06:43,300 --> 00:06:46,220
القِدر الكبير في الخلف يحتوي
على شراب صافٍ

73
00:06:46,770 --> 00:06:50,790
في المدينة، المشروبات الصّافية والمشروبات
المُقطَّرة ذات شعبيّة أكبر

74
00:06:50,790 --> 00:06:54,710
لا بُدّ أنّ الشّراب العكِر مُخصّص
للسكّان المحلّيين هنا

75
00:06:54,710 --> 00:06:57,320
هل لديك المال؟

76
00:06:57,320 --> 00:06:59,860
من الواضح بأنّهم يفوقوننا عدداً

77
00:06:59,860 --> 00:07:01,980
إلى أين ينبغي أن أهرب إذا تحوّل
الأمر إلى عِراك؟

78
00:07:01,980 --> 00:07:04,090
الموعد النّهائي لم يحن بعد

79
00:07:04,090 --> 00:07:07,300
إن كنت لا تستطيع الدّفع، فسيترتّب
عليكم مُغادرة هذا المكان

80
00:07:07,300 --> 00:07:09,950
هل يمكنك منحنا مزيداً من الوقت؟

81
00:07:09,950 --> 00:07:12,050
هل هذا هو العقد؟

82
00:07:12,450 --> 00:07:16,140
أخبرتُك سلفاً، أستطيع الانتظار
حتّى العام المُقبل

83
00:07:16,140 --> 00:07:19,710
نريد فقط أن نتلقّى جزءاً من تعاليمكم
في هذه الأثناء

84
00:07:20,120 --> 00:07:21,880
!يا له من مأزق

85
00:07:21,880 --> 00:07:26,440
حتّى مع ذلك الوقت الإضافيّ، إذا قُضي
،في تعليمهم كيفيّة صنع الورق

86
00:07:26,440 --> 00:07:28,890
فسوف يسرقون كافّة تقنيّاتهم حتماً

87
00:07:29,410 --> 00:07:32,810
في نفس الوقت، سيسعون لانتزاع
،منصِب المُزوِّد الإمبراطوريّ

88
00:07:32,810 --> 00:07:36,210
وطرد الحِرفيّين، واستبدالهم

89
00:07:37,390 --> 00:07:40,300
لكن... لِمَ يُكلّفون أنفسهم كُلّ هذا العناء؟

90
00:07:40,300 --> 00:07:43,610
،لِمَ لا يجعلونهم يعملون تحت جناحه فحسب
باستخدام القرض كنفوذ؟

91
00:07:43,610 --> 00:07:45,860
هل يكره الغُرباء إلى هذا الحدّ حقّاً؟

92
00:07:58,400 --> 00:08:02,670
،يُفترض أن يزيد عمرها عن عشر سنوات
لكن لا يزال الورق نظيفاً

93
00:08:03,200 --> 00:08:06,420
،لو كانت الورقة ذات جودة رديئة
لكانت مُمزّقة الآن

94
00:08:06,880 --> 00:08:09,260
،مذكور بأنّ السّداد سيكتمل بعد عشرين عام

95
00:08:09,260 --> 00:08:12,120
وتفاصيل مقدار القسط الشّهريّ

96
00:08:12,820 --> 00:08:16,950
يبدو عقداً سليماً تماماً. فكيف تكون
هناك مساحة لأي نِزاع؟

97
00:08:17,470 --> 00:08:20,160
يقولون بأنّ العقد باطل

98
00:08:20,160 --> 00:08:21,620
حتّى مع الختم المونوغراميّ؟

99
00:08:22,030 --> 00:08:24,600
هذا صالحٌ مثل التّوقيع تماماً، صحيح؟

100
00:08:25,100 --> 00:08:26,820
...أجل، لكن

101
00:08:26,820 --> 00:08:30,070
يُقال بأنّ المالك السّابق لا يستطيع القراءة

102
00:08:30,070 --> 00:08:33,390
كمالِك، نظراً إلى عدد الوثائق الّتي
،يترتّب عليه مُراجعتها

103
00:08:33,390 --> 00:08:36,500
...من الغريب ألّا يتعلّم القِراءة

104
00:08:36,500 --> 00:08:38,820
تزوّجَ من العائلة

105
00:08:38,820 --> 00:08:41,430
الآن قد فهمت

106
00:08:39,160 --> 00:08:44,620
الزّوجة

107
00:08:41,430 --> 00:08:45,000
ضمّوا أحد المُزارعين المُجدّين
في العمل إلى العائلة

108
00:08:42,290 --> 00:08:44,620
الزّوج

109
00:08:44,620 --> 00:08:47,260
الزّوج

110
00:08:45,000 --> 00:08:47,260
لم تسنح له الفُرصة للدّراسة

111
00:08:47,530 --> 00:08:51,630
،زوجته تولّت القِراءة، لكن بعد وفاتها

112
00:08:51,630 --> 00:08:55,470
استأجروا كاتبَ عدلٍ لكتابة العقد

113
00:08:56,960 --> 00:09:01,770
ألم يكن هناك أي شهود على توقيع العقد؟
مثل كاتب العدل؟

114
00:09:01,770 --> 00:09:04,770
شاهد

115
00:09:01,770 --> 00:09:03,760
كاتب العدل

116
00:09:01,770 --> 00:09:08,810
الزّوج

117
00:09:02,040 --> 00:09:05,460
كاتب العدل والشّاهد كلاهما قد تُوفّيا

118
00:09:05,460 --> 00:09:08,820
كانا كبيرين في السنّ بالفعل عندما
وُقِّع العقد قبل 15 عاماً

119
00:09:09,120 --> 00:09:11,210
إنّه مأزق حقيقيّ بالفعل

120
00:09:12,060 --> 00:09:15,670
إن لم تُغادروا الآن، فلا نملك خياراً إذاً

121
00:09:15,670 --> 00:09:17,580
سنُرسل عُمّالنا الصِّغار إليكم

122
00:09:17,580 --> 00:09:20,560
احرصوا على تعليمهم كيفيّة أداء
العمل مع نهاية العام

123
00:09:21,620 --> 00:09:24,060
!أعتقد حُسِمَ الأمر إذاً

124
00:09:24,060 --> 00:09:26,830
!أحضروا المشروبات! جولة لأجل الفتيان أيضاً

125
00:09:35,890 --> 00:09:38,890
هذا هو الخمر الصّافي، وليس العكِر

126
00:09:45,220 --> 00:09:47,370
يتناول المالكُ المشروب المُقطَّر

127
00:09:47,370 --> 00:09:49,650
يبدو أنّه يتحمّل الكحول بشكل جيّد

128
00:09:50,440 --> 00:09:56,580
سخاء منه أن يشتري الشّرابَ النّقيّ
للمجموعة بأكملها

129
00:09:56,860 --> 00:09:59,600
لدى هذا المكان مشروبات أرخص أيضاً

130
00:10:00,220 --> 00:10:01,540
سيّدتي

131
00:10:01,540 --> 00:10:02,370
ما الأمر؟

132
00:10:02,370 --> 00:10:05,330
واحد لي أيضاً، نفس الشّراب

133
00:10:07,260 --> 00:10:09,410
مولايّ جينشي لاحظَ أيضاً

134
00:10:15,420 --> 00:10:18,020
هذا شرابٌ لذيذ، بمذاق حلو

135
00:10:18,020 --> 00:10:21,540
،إنّه ليس مُصقولاً كشراب من المدينة
لكن لا بأس به

136
00:10:21,540 --> 00:10:25,140
لكن الكحول ثقيل، بالرّغم من مذاقه الخفيف

137
00:10:25,810 --> 00:10:29,770
المعذرة. هل يوجد مصنع بيرة
في هذه الأرجاء؟

138
00:10:29,770 --> 00:10:33,520
لا، ليس على حدّ علمي

139
00:10:33,520 --> 00:10:34,450
بالطّبع

140
00:10:36,350 --> 00:10:40,630
ثمّة مُشكلة ما في كمّية الأرزّ من هذه
المنطقة في السّنوات القليلة الماضية

141
00:10:48,750 --> 00:10:51,260
ما الأمر أيّتها الآنسة الصّغيرة؟

142
00:10:51,260 --> 00:10:53,130
هل ستكونين ساقيتي في هذه اللّيلة؟

143
00:10:54,030 --> 00:10:56,760
!أ-أيّتها الآنسة الصّغيرة، ماذا تفعلين؟

144
00:11:02,120 --> 00:11:04,960
هل ترغب في إقامة مُسابقة شرب؟

145
00:11:09,330 --> 00:11:12,780
!مُسابقة شرب؟ يا لكِ من جريئة

146
00:11:18,100 --> 00:11:20,770
كم بقي من القرض؟

147
00:11:21,920 --> 00:11:24,120
ألف فضّية عن كلّ عام

148
00:11:24,120 --> 00:11:29,090
سدّدنا نصفه هذا العام، لذا بقي 4500
لمدّة أربع سنوات

149
00:11:29,090 --> 00:11:30,000
هكذا إذاً

150
00:11:33,380 --> 00:11:35,970
لِمَ لا نجعل الأمر مُشوِّقاً برِهان؟

151
00:11:35,970 --> 00:11:39,220
هذا مُثير للاهتمام. على ماذا تُراهنين؟

152
00:11:39,220 --> 00:11:40,850
على هذا بالطّبع

153
00:11:42,380 --> 00:11:45,520
بِعني لقوّاد. ستجني 300 فضّية بسهولة

154
00:11:49,740 --> 00:11:53,500
أيّتها الصّغيرة! هل تعرفين حتّى
ثمن الأشياء؟

155
00:11:53,500 --> 00:11:58,570
أعرف بالطّبع. كم فتاة رأيتُها تُباع برأيك؟

156
00:11:58,570 --> 00:12:01,560
حتّى أروع فتاة لا تُحقّق 100 فضّية

157
00:12:01,560 --> 00:12:03,780
!لكن 300...؟

158
00:12:08,530 --> 00:12:15,380
إذا بيعَتْ فجلة بتُرابِها كما هي فلن تُحقّق
خمسين فضّية. هذا واضح

159
00:12:15,380 --> 00:12:17,920
من الواضح أنّك لا تعرف شيئاً

160
00:12:17,920 --> 00:12:19,410
ماذا؟

161
00:12:23,570 --> 00:12:28,190
جيّد، فهِموا بأنّ الفجلة كانت تعبيراً
عن فتيات الرّيف

162
00:12:28,720 --> 00:12:30,700
!ماذا قلتِ؟

163
00:12:30,700 --> 00:12:35,380
،إن كنت لا تُجيد القراءة أو الكتابة
فلن تتمكّن من استخدام الورق أبداً

164
00:12:35,380 --> 00:12:38,550
أنا واثقة بأنّك لن تتعلّم صنع شيء
جيّد ولو علّموك

165
00:12:39,710 --> 00:12:41,360
!...أنتِ

166
00:12:49,240 --> 00:12:53,620
ستكون هذه الفتاة لِقاء 300 فضّية
صفقة مُجزية

167
00:12:53,890 --> 00:12:57,410
،في العادة لا أنصح بالتّباهي بثروته هكذا

168
00:12:57,410 --> 00:12:58,840
لكن حاليّاً، أنا مُضطرّة للمُسايرة

169
00:13:01,710 --> 00:13:04,760
رأيت؟ من يعرف، يعرف

170
00:13:05,930 --> 00:13:09,740
!أنتم، لنُلقّنهم درساً

171
00:13:10,660 --> 00:13:12,600
!من سمح لك بتولّي القيادة؟

172
00:13:13,580 --> 00:13:17,980
حسناً إذاً. إن كان لديك المال، فلا أُمانع

173
00:13:18,800 --> 00:13:20,570
جيّد. لقد وافق

174
00:13:24,080 --> 00:13:27,290
حسناً، من يريد البدء أوّلاً؟

175
00:13:32,380 --> 00:13:34,500
!سأواجهكِ أوّلاً

176
00:13:34,970 --> 00:13:37,310
حسناً، لنبدأ

177
00:13:50,440 --> 00:13:51,850
هذا غير مُمكن

178
00:13:52,570 --> 00:13:54,310
هل انتهى بهذه السّرعة؟

179
00:13:55,510 --> 00:13:57,900
هذا الشّراب المُقطَّر، صحيح؟

180
00:14:00,020 --> 00:14:05,020
حاولوا إسقاطي بسرعة بإحضار شراب
ذي مُحتوى كحوليّ أعلى

181
00:14:05,020 --> 00:14:07,080
هذه غلطتهم. أنا معتادة على ذلك

182
00:14:07,990 --> 00:14:11,390
ثلاثمئة. ليست صفقة سيّئة

183
00:14:11,390 --> 00:14:15,320
لا أريد أن أُشتَرى بواسطة هذا
الرّجل من جديد. لن أخسر

184
00:14:16,710 --> 00:14:18,130
صاروا أربعة

185
00:14:18,600 --> 00:14:21,430
بثلاثمئة لكلّ شخص، ومُضاعَفة
،الرِّهان في كلّ مرّة

186
00:14:21,430 --> 00:14:25,130
...‏600، 1200، 2400

187
00:14:25,550 --> 00:14:30,200
بما أنّ مقدار القرض هو 4500، فأحتاج
لهزيمة رجل إضافيّ واحد فقط

188
00:14:30,690 --> 00:14:34,870
،وقّعنا سنَداً بسيطاً معهم ببصمة يد
من باب الحيطة فقط

189
00:14:37,300 --> 00:14:39,020
هل ستُرغمينني؟

190
00:14:39,480 --> 00:14:45,020
،هل يمكنني فعلها؟ بعد أربع جولات
بدأ ذلك يتراكم

191
00:14:45,480 --> 00:14:47,990
إيّاكِ والظنّ بأنّني كالآخرين

192
00:14:49,890 --> 00:14:52,700
وأنت، لا تُحاول سحب مالك

193
00:14:57,150 --> 00:14:59,390
!مهلاً، ماذا تفعلين؟

194
00:14:59,390 --> 00:15:01,170
أغيِّر المذاقَ قليلاً

195
00:15:05,630 --> 00:15:08,140
لحظة. أعطيني بعضاً من هذا أيضاً

196
00:15:12,820 --> 00:15:13,600
تفضّل

197
00:15:15,550 --> 00:15:19,560
هذا ليس دواء لتخفيف أثر الثّمالة، صحيح؟

198
00:15:42,070 --> 00:15:43,610
!سـ-سيّدي

199
00:15:44,350 --> 00:15:46,690
!أنتِ! ماذا أضفتِ إلى مشروبه؟

200
00:15:46,690 --> 00:15:52,430
ماذا؟ شربتُ نفس الشّراب. رأيتُم ذلك

201
00:15:52,430 --> 00:15:54,330
...أجل، لكن

202
00:15:54,330 --> 00:15:56,880
أظنّني ربحتُ الرِّهان

203
00:16:01,390 --> 00:16:03,240
أين دورة المياه؟

204
00:16:03,830 --> 00:16:05,560
من هذا الاتّجاه ثمّ إلى اليمين

205
00:16:05,560 --> 00:16:06,930
شكراً لكِ

206
00:16:19,780 --> 00:16:22,310
حسناً، ماذا فعلتِ؟

207
00:16:22,310 --> 00:16:27,590
لا شيء، أضفتُ فقط مزيداً
من الكحول لتغيير المذاق

208
00:16:28,580 --> 00:16:33,050
أحمل معي كحولاً مُطهِّرة، من باب الحيطة فقط

209
00:16:33,050 --> 00:16:35,570
،إنّه أكثر سماكة من أيّ شراب عاديّ

210
00:16:35,570 --> 00:16:38,130
لذا فهو يطيح بأيّ شخص عاديّ بسهولة

211
00:16:38,130 --> 00:16:39,990
هلّا طرحتُ عليك سؤالاً؟

212
00:16:39,990 --> 00:16:41,140
تفضّل

213
00:16:41,140 --> 00:16:45,770
شربتِ من نفس الشّراب، صحيح؟

214
00:16:46,050 --> 00:16:48,020
هذا ليس كافياً للتأثير بي

215
00:16:48,020 --> 00:16:50,110
أردتُ فقط أن ينتهي الأمر بسرعة

216
00:16:53,420 --> 00:16:55,980
يسرّني أنّني وصلتُ إلى دورة المياه

217
00:16:57,030 --> 00:17:02,470
مهما كنتِ واثقة، الرّهان على نفسكِ سيّئ

218
00:17:02,470 --> 00:17:04,540
...وأن تفعلي ذلك لأجلنا

219
00:17:06,230 --> 00:17:08,990
يبدو أنّك أسأت الفهم

220
00:17:09,720 --> 00:17:11,630
هذه لي أنا

221
00:17:12,710 --> 00:17:16,790
،ما-ماذا؟ أيّتها الآنسة الصّغيرة
...لا تكوني قاسية رجاء

222
00:17:16,790 --> 00:17:19,010
!أنتِ، لحظة

223
00:17:19,010 --> 00:17:21,140
ينبغي أن تبقى مُستلقياً لفترة أطول

224
00:17:21,140 --> 00:17:22,940
!هذا الرِّهان باطل ولاغٍ

225
00:17:23,330 --> 00:17:27,140
وقّعتَ سنَداً هنا بخطّ يدك مع بصمة

226
00:17:27,140 --> 00:17:29,190
هل ستزعم بأنّك لا تُجيد القراءة؟

227
00:17:29,190 --> 00:17:31,290
!من يأبه لذلك؟

228
00:17:31,290 --> 00:17:35,000
!كان ذلك من باب التّسلية فقط
!انتهى الأمر الآن

229
00:17:35,000 --> 00:17:37,360
إذاً أعتقد بأنّني لا أملك خياراً

230
00:17:37,360 --> 00:17:42,660
سأبلغ السّلطات بأنّك تتهرّب من الضّرائب

231
00:17:50,170 --> 00:17:52,380
أتهرّب... من الضّرائب؟

232
00:17:52,380 --> 00:17:54,020
عمّاذا تتحدّثين؟

233
00:17:54,020 --> 00:17:57,260
تحتاج إذناً من الحكومة لصنع الكحول

234
00:17:57,560 --> 00:17:59,070
،رُبّما ليس للاستمتاع الشّخصيّ

235
00:17:59,070 --> 00:18:03,220
لكن إن كنت تبيع لمتجر، فيترتّب على ذلك ضريبة

236
00:18:03,720 --> 00:18:09,360
كنتُ أتساءل لماذا سمحَ هذا المحلّ
بإجراء هذا "النّقاش" هنا

237
00:18:10,070 --> 00:18:14,780
امتلاك الكثير من المشروبات اللّذيذة
والرّخيصة نافع جدّاً للمحلّ

238
00:18:14,780 --> 00:18:16,780
،إذا طلبَ المُزوِّد

239
00:18:16,780 --> 00:18:19,780
،فأنا متأكّدة بأنّهم سيسمحون لهم باستخدام الموقع
ولو كان ذلك مُزعجاً قليلاً{?}

240
00:18:20,450 --> 00:18:24,780
...إن كانوا يستخدمون مُزارعين لصنع كحول عكِرة

241
00:18:24,780 --> 00:18:27,320
فأتفهّم سبب تقديمهم للمشروب النّقيّ لهم

242
00:18:27,320 --> 00:18:30,920
من يطلب خمراً يصنعه بنفسه ويشربه كُلّ يوم؟

243
00:18:31,350 --> 00:18:36,000
رُبّما تقتصدون في كلفة مُكوِّن الخمر كذلك؟

244
00:18:36,000 --> 00:18:39,680
تحتاجون كثيراً من الأرزّ والشّعير لصنع الكحول

245
00:18:39,680 --> 00:18:42,440
سمعتُ بأنّك أخبرت صانعي الورق بأنّهم

246
00:18:42,740 --> 00:18:47,180
لوَّثوا الماء وسبّبوا نقصاناً في حصاد الأرزّ

247
00:18:47,180 --> 00:18:49,470
هذه كذبة، أليس كذلك؟

248
00:18:49,470 --> 00:18:52,940
في الواقع، ألا تُنتِجون أرزّاً أكثر
حتّى من السّابق؟

249
00:18:53,380 --> 00:18:57,460
المُكوِّنات في الورق هي نخالة أرزّ
وقُشارات خشب

250
00:18:57,460 --> 00:19:01,410
الماء الّذي يحمل تلك الأشياء ينبغي في الواقع
أن يعمل كسمادٍ جيّد

251
00:19:02,310 --> 00:19:05,310
من المُؤكَّد أنّ المالك السّابق يعلم ذلك

252
00:19:05,310 --> 00:19:10,920
لكن لا بُدّ أنّ المالك الحاليّ بدأ بصنع
الكحول لإخفاء حقيقة ازدياد الحصاد

253
00:19:11,590 --> 00:19:14,340
تهرُّب ضريبيّ مُزدوج؟ هذه جريمة خيطرة

254
00:19:16,100 --> 00:19:19,300
بحسب ردّة فعله، أنا مُتيقّنة تماماً

255
00:19:19,300 --> 00:19:21,710
!هـ-هل لديكِ دليل؟

256
00:19:21,710 --> 00:19:24,380
،لا مُشكلة. إن كنتَ بريئاً

257
00:19:24,380 --> 00:19:27,520
فلا ينبغي أن تخشى المُفتّشين الحكوميّين

258
00:19:29,150 --> 00:19:31,910
تتصرّفين بصلابة أيّتها الفتاة الصّغيرة

259
00:19:31,910 --> 00:19:35,190
ما الّذي يجعلكِ تعتقدين بأنّكِ ستخرجين
من هذا سليمة؟

260
00:19:35,190 --> 00:19:38,530
يمكنني توجيه نفس الكلام إليك

261
00:19:38,530 --> 00:19:40,650
أَدرِك وضعَك قبل أن تتكلّم

262
00:19:47,840 --> 00:19:50,390
تفضّل، اطلب المُساعدة

263
00:19:50,390 --> 00:19:53,710
سأستدعي السّلطات كذلك

264
00:19:54,190 --> 00:19:58,590
في الحقيقة، النّاس هنا مُرعِبون أكثر
من أيّ سلطة محلّية

265
00:20:00,330 --> 00:20:04,460
أيّتها الآنسة الصّغيرة، أنتِ مختلفة
...تماماً عن المعتاد

266
00:20:05,670 --> 00:20:09,390
إن أردت تهديد شخص، فكُن جاهزاً
لتلقّي تهديدٍ بالمُقابل على الأقلّ

267
00:20:13,140 --> 00:20:16,950
لِمَ بذلت كُلّ هذا الجهد لكي تكون
بهذه القسوة؟

268
00:20:21,620 --> 00:20:23,660
!أرجوكم! أتوسّل رحمتكم

269
00:20:25,710 --> 00:20:27,580
لا، لم نكن نحن

270
00:20:27,580 --> 00:20:32,100
أنا آسفة! أعلم بأنّ أبي كان يتصرّف
بشكل غير عقلانيّ ثانية

271
00:20:32,100 --> 00:20:34,880
!أرجوكم، سامحوا أبي الأحمق

272
00:20:36,190 --> 00:20:39,750
لن نفعل ذلك لأبيكِ

273
00:20:41,270 --> 00:20:44,280
!أنت! ابتعد عن ابنتي

274
00:20:44,280 --> 00:20:45,140
!أبي

275
00:20:45,140 --> 00:20:45,880
!أبي

276
00:20:45,880 --> 00:20:48,620
!لستُ أبيك

277
00:20:48,620 --> 00:20:51,100
ما هذه الأجواء؟

278
00:20:51,100 --> 00:20:52,520
...إذاً، هل هذا

279
00:20:53,010 --> 00:20:55,440
كما تعتقدين غالباً

280
00:20:56,040 --> 00:20:59,160
أجل، فهمتُ الآن سبب ميول
،الابن الأكبر إلى جانب المُزارعين

281
00:20:59,160 --> 00:21:03,430
وسبب كره المالِك للغُرباء ورغبته في طردهم

282
00:21:05,650 --> 00:21:06,860
!يا للسّخافة

283
00:21:07,240 --> 00:21:09,520
أخي مُحبٌّ مُخلص

284
00:21:10,750 --> 00:21:14,750
هذا ليس سبباً لتدمير قرية كاملة

285
00:21:14,750 --> 00:21:19,920
على ذكر الأمر، الابن الأكبر قريب
الطّبيب الدجّال

286
00:21:21,880 --> 00:21:25,490
...أعتقد سأتجاهل هذا الأمر، لأجل الدجّال

287
00:21:25,910 --> 00:21:27,800
!أو لا! مُستحيل

288
00:21:27,800 --> 00:21:30,300
المعذرة. المزيد من الخمر رجاء

289
00:21:30,640 --> 00:21:32,270
!ستشربين المزيد؟

290
00:21:32,270 --> 00:21:34,180
أستطيع تحمّل المزيد

291
00:21:45,210 --> 00:21:49,700
في النّهاية، قرّرتْ قرية صانعي الورق تسديد
القرض على مدى خمس سنوات

292
00:21:50,610 --> 00:21:52,840
،بالنّسبة للرِّهان مع المالك

293
00:21:52,840 --> 00:21:57,870
قرّرتُ أن أدعهم يُرسلون الأرزّ إلى بيت
الزنجار خلال العشر سنوات المُقبلة

294
00:21:59,390 --> 00:22:04,610
...وبالنّسبة للابن الأكبر وابنة المُزارِع

295
00:22:06,050 --> 00:22:07,640
لا أُبالي

296
00:23:45,070 --> 00:24:00,000
الحلقة القادمة

297
00:23:53,510 --> 00:23:57,440
"الحلقة القادمة: "القِنَّب والدّين الشّعبيّ

298
00:23:53,580 --> 00:24:00,000
الحلقة 56: القِنَّب والدّين الشّعبيّ