1
00:00:06,400 --> 00:00:13,530
مُذكّرات الصّيدلانيّة

2
00:00:06,400 --> 00:00:13,530
مُذكّرات الصّيدلانيّة

3
00:01:31,030 --> 00:01:33,990
.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة
.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة

4
00:01:35,490 --> 00:01:39,500
الحلقة 54: قرية الورق

5
00:01:41,870 --> 00:01:44,230
أنت مُدهشٌ حقّاً يا لومين

6
00:01:44,630 --> 00:01:48,550
يمكنك صنع أي دواء بكفاءة عالية

7
00:01:48,960 --> 00:01:51,840
هذا لأنّك تُساعدني يا غوين

8
00:01:52,090 --> 00:01:53,380
حقّاً؟

9
00:01:53,380 --> 00:01:57,260
حسناً، يسرّني أنّك هنا

10
00:01:57,260 --> 00:02:01,180
الفتاة الصّغيرة وصديقها أنهيا مدّة خدمتهما

11
00:02:03,520 --> 00:02:06,690
المعذرة. هذه للسّيّد غوين

12
00:02:07,690 --> 00:02:10,110
ما هذه؟

13
00:02:19,830 --> 00:02:22,290
ماذا أفعل؟

14
00:02:22,290 --> 00:02:26,920
من أي يأتي مولايّ جينشي بكلّ
هذه القضايا المُزعجة؟

15
00:02:26,920 --> 00:02:29,550
...مع أنّني لا أستطيع رفض طلباته

16
00:02:34,510 --> 00:02:37,470
سيترتّب عليّ إيجاد طريقة لإقناع السّيّدة العجوز

17
00:02:45,730 --> 00:02:49,570
!فطائر حبَق الرّاعي! فطائر حبَق الرّاعي

18
00:02:52,150 --> 00:02:53,490
!انتظر مكانك

19
00:02:54,360 --> 00:02:55,990
!مهلاًّ! ماذا تفعلين؟

20
00:02:58,570 --> 00:03:03,580
ما الخطأ العجيب الّذي اقترفتَه حتّى وجدت
نبات خانق الذّئب في هذه المنطقة؟

21
00:03:03,580 --> 00:03:05,960
!ماذا؟ إنّه ليس حبَق الرّاعي؟

22
00:03:05,960 --> 00:03:07,670
يُشبهه، لكنّه ليس هو

23
00:03:07,670 --> 00:03:09,750
إذا أعددت فطائرَ منه، فستموت

24
00:03:09,750 --> 00:03:12,760
!ماذا؟! إذاً ماذا عن فطائري؟

25
00:03:12,760 --> 00:03:13,800
استسلم

26
00:03:15,550 --> 00:03:18,180
!إذاً شاركينا بعضاً من حبَق الرّاعي

27
00:03:18,180 --> 00:03:20,390
وجدتِ بعضاً في الأمس، أليس كذلك؟

28
00:03:21,010 --> 00:03:23,060
أحتاجه للكَيّ

29
00:03:23,320 --> 00:03:24,680
!بخيلة

30
00:03:25,520 --> 00:03:28,100
!أنتِ فظيعة

31
00:03:28,100 --> 00:03:29,690
من الفظيع هنا؟

32
00:03:29,690 --> 00:03:32,820
فضلاً عن ذلك، حذّرتُك من التسكُّع بمفردك

33
00:03:33,780 --> 00:03:36,110
!كان سازين معنا

34
00:03:36,450 --> 00:03:37,400
ماذا؟

35
00:03:37,400 --> 00:03:40,030
!لا تبتعد عنّي

36
00:03:40,370 --> 00:03:42,870
لم أعُد صغيراً

37
00:03:43,200 --> 00:03:48,870
إذا لم يتعلّم الطّفل، فأعتقد بأنّه يترتّب
عليّ تعليم المُرافِق

38
00:03:50,000 --> 00:03:51,420
انتظروا لحظة

39
00:03:57,050 --> 00:03:59,760
هل تعرف ما هذه؟

40
00:04:02,350 --> 00:04:05,270
أجل، حبَق الرّاعي وخانق الذّئب، صحيح؟

41
00:04:06,270 --> 00:04:11,730
كنتُ سأستبدلها لاحقاً، لكنّه هرب

42
00:04:11,730 --> 00:04:13,770
تفضّلا

43
00:04:13,770 --> 00:04:15,190
!حبَق الرّاعي

44
00:04:16,780 --> 00:04:17,990
!هيّا بنا

45
00:04:20,070 --> 00:04:21,660
هذا لأجلكِ

46
00:04:22,450 --> 00:04:24,490
جذر خانق الذّئب

47
00:04:24,490 --> 00:04:26,790
،استخرجتُه لأنّه خطير

48
00:04:26,790 --> 00:04:29,890
لكنّه نافع في الدّواء إن جفّفتِه، صحيح؟

49
00:04:29,890 --> 00:04:31,500
درنة البيش، أليس كذلك؟

50
00:04:31,500 --> 00:04:33,790
سيكون من الهدر تركه يتعفّن فحسب

51
00:04:34,130 --> 00:04:36,420
ماذا قال للتو؟

52
00:04:36,420 --> 00:04:40,430
ما أدراه باسم الشّكل الدّوائيّ
من جذر خانق الذّئب؟

53
00:04:40,760 --> 00:04:46,880
غالباً أحضره شخصٌ من الجبل
—لأنّ الزّهرة كانت

54
00:04:52,560 --> 00:04:53,860
ما هذا؟

55
00:04:55,190 --> 00:04:56,650
ورَق مِشمَلة

56
00:04:56,650 --> 00:04:57,440
الآثار؟

57
00:04:57,740 --> 00:05:01,990
يمنع السُّعال والإسهال، وأشياء أُخرى على ما أعتقد

58
00:05:01,990 --> 00:05:03,120
وهذا؟

59
00:05:03,120 --> 00:05:05,580
خيط الذّهب، مُفيد للمعدة

60
00:05:05,580 --> 00:05:07,870
والاستقرار الذّهنيّ على ما أظنّ

61
00:05:07,870 --> 00:05:08,950
وهذا؟

62
00:05:08,950 --> 00:05:10,500
...لِسان الحمَل بالطّبع

63
00:05:10,910 --> 00:05:13,290
لِمَ هذه الأسئلة؟

64
00:05:13,290 --> 00:05:15,000
!تابع فحسب

65
00:05:15,000 --> 00:05:16,380
ماذا؟

66
00:05:18,090 --> 00:05:21,680
أعتقد بأنّك تعرف حوالي نصفها

67
00:05:22,340 --> 00:05:24,600
بجدّية، ما خطبكِ؟

68
00:05:24,600 --> 00:05:26,760
هل تُجيد القراءة؟

69
00:05:26,760 --> 00:05:30,310
ماذا؟ أجل، علّمَني العجوز في الحصن

70
00:05:30,640 --> 00:05:33,810
هل علّمَك عن الأعشاب أيضاً؟

71
00:05:33,810 --> 00:05:34,810
أجل

72
00:05:35,360 --> 00:05:36,820
هكذا إذاً

73
00:05:37,190 --> 00:05:39,150
هذا ما لم أتوقّعه

74
00:05:39,150 --> 00:05:41,320
سيكون عملاً عاجلاً، لكن قد يفلح

75
00:05:41,320 --> 00:05:43,820
!حسناً، احفظ هذا

76
00:05:44,370 --> 00:05:47,240
وتعال واعمل معي أثناء النّهار
من الآن فصاعداً

77
00:05:47,240 --> 00:05:49,290
—ماذا؟! لديّ عملي الخاصّ أيضاً

78
00:05:49,290 --> 00:05:52,290
سأتكلّم مع السّيّدة العجوز وأوكيو

79
00:05:52,290 --> 00:05:56,590
بالإضافة إلى ذلك، لا تُجيد العمل
كخادِم أيضاً، أليس كذلك؟

80
00:05:57,460 --> 00:05:59,420
...المعذرة... في الواقع

81
00:05:59,800 --> 00:06:03,380
رُبّما ستكون أفضل حالاً كصيدلانيّ؟

82
00:06:04,220 --> 00:06:08,890
بما أنّني مُرتبطة بمولايّ جينشي، سأكون
بعيدة عن هذا المكان كثيراً

83
00:06:08,890 --> 00:06:11,270
...إن استطاع سازين أن يكون صيدلانيّاً

84
00:06:13,390 --> 00:06:15,980
أنا مُجرّد مُزارع

85
00:06:16,400 --> 00:06:19,400
السّبب الوحيد وراء ذهابي إلى ذلك الحصن
هو لأنّني كنتُ مُفلساً

86
00:06:27,580 --> 00:06:32,260
لذا أقصد بأنّني كنتُ أتّبع تعليمات
...العجوز بالنّسبة للأعشاب

87
00:06:32,260 --> 00:06:33,490
وماذا يعني؟

88
00:06:34,290 --> 00:06:37,960
يؤمّن بعض النّاس قوتَ يومهم بإلقاء لعنات
غريبة على النّاس المُصابين بنزلة برد

89
00:06:38,210 --> 00:06:41,880
بينما أنت من النّاحية الأُخرى تستطيع
صنع عِلاج بسيط للحُمّى، صحيح؟

90
00:06:42,460 --> 00:06:45,800
صحيح، لكن... ماذا عن المُصابين بأمراض خطيرة؟

91
00:06:45,800 --> 00:06:49,260
إن كنت لا تستطيع عِلاجها، فقُل ذلك فحسب

92
00:06:49,630 --> 00:06:50,370
ماذا؟

93
00:06:51,140 --> 00:06:54,980
بعض النّاس يموتون، سواء تناولوا دواءً أو لا

94
00:06:54,980 --> 00:06:57,980
أرسلهم إلى شخص آخر. هذا خيرٌ من التّظاهر
بأنّ لديك عِلاج

95
00:06:58,480 --> 00:07:02,360
ستتفاجأ إذا عرفتَ كم عدد الأطبّاء
الّذين يُعدّون أسوأ منك في صنع الدّواء

96
00:07:02,690 --> 00:07:04,360
كطبيب دجّال أعرفه

97
00:07:04,820 --> 00:07:06,740
حسناً، حُسِمَ الأمر

98
00:07:08,490 --> 00:07:09,410
مهلاً

99
00:07:10,120 --> 00:07:13,410
اِحفظ كُلّ هذه. سأذهب وأتكلّم مع السيّدة العجوز

100
00:07:14,790 --> 00:07:17,000
أليس هذا مُفاجئاً جدّاً؟

101
00:07:17,000 --> 00:07:19,420
يجب أن أسرع. الوقت يُداهمني

102
00:07:23,300 --> 00:07:27,180
كما توقّعت، كان سازين سريع التعلُّم

103
00:07:27,680 --> 00:07:33,850
تعلّمَ وصفات بسيطة بسرعة، ويستطيع
قِراءة الكُتُب، لكن بطريقة غير مُتقَنة

104
00:07:34,730 --> 00:07:37,440
،أحاول تعليم تشو-يو كذلك، تحسُّباً فقط

105
00:07:37,440 --> 00:07:40,060
لكن الطّفل لا يُبدي اهتماماً إطلاقاً

106
00:07:49,870 --> 00:07:52,330
سأسلّم الدّواءَ للجوار

107
00:07:52,330 --> 00:07:53,240
حسناً

108
00:07:55,370 --> 00:07:57,250
سيفلح هذا

109
00:08:03,420 --> 00:08:05,510
ماذا تفعلين هنا؟

110
00:08:08,090 --> 00:08:11,390
!ماوماو، انتظريني

111
00:08:15,970 --> 00:08:19,310
الآنسة الصّغيرة، لم أركِ منذ مدّة

112
00:08:24,610 --> 00:08:28,900
التقطتُ أنفاسي أخيراً

113
00:08:28,900 --> 00:08:31,110
على أيّ حال، ما الّذي جاء بك إلى هنا؟

114
00:08:31,450 --> 00:08:33,490
—ماذا عن عملك في القصر الخلفـ

115
00:08:34,370 --> 00:08:36,370
لا بُدّ أنّه طُرِدَ أخيراً

116
00:08:36,370 --> 00:08:40,250
إنّه لطيفٌ حقّاً، لكنّه عديم القيمة كطبيب

117
00:08:40,250 --> 00:08:41,580
لا يهمّ

118
00:08:41,960 --> 00:08:45,590
أيّتها الآنسة الصّغيرة، أرى بأنّكِ أسأتِ الفهم

119
00:08:45,590 --> 00:08:47,510
سُمِح لي بقضاء إجازة

120
00:08:47,510 --> 00:08:50,550
سأزور عائلتي في الدّيار

121
00:08:50,840 --> 00:08:53,850
تمّ إرسالك إلى المنزل

122
00:08:53,850 --> 00:08:55,600
تفعلين هذا عمداً، صحيح؟

123
00:08:56,060 --> 00:08:59,890
لكن أضافوا شرطاً غريباً على رحلتي

124
00:08:59,890 --> 00:09:02,350
هل حدّثَكِ أحدٌ حول الأمر بالمُناسبة؟

125
00:09:03,360 --> 00:09:05,070
ما الشّرط؟

126
00:09:05,070 --> 00:09:09,280
قيل لي بأنّ ثمّة شخص يريد مُرافقتي

127
00:09:09,280 --> 00:09:13,490
طلبَ منّي رئيس المخصيّين. بدا أنّه شخص مُهمّ

128
00:09:13,490 --> 00:09:16,490
أرادني أن ألتقي به هنا

129
00:09:16,490 --> 00:09:17,870
هكذا إذاً

130
00:09:18,830 --> 00:09:22,040
كنتُ آمل أن يكون لديّ مُتّسع من الوقت

131
00:09:24,250 --> 00:09:27,170
سأخرج في رحلة. تعالي معي

132
00:09:28,380 --> 00:09:30,840
كانت رسالة مولايّ جينشي من جانب واحد

133
00:09:30,840 --> 00:09:34,890
ولم يرِد فيها شيء عن المدّة والوجهة
أو حتّى تاريخ المُغادرة

134
00:09:36,010 --> 00:09:40,270
لذا علّمتُ سازين الطبَّ بأسرع ما يمكن

135
00:09:40,270 --> 00:09:43,270
وصنعتُ أيضاً الكثير من الأدوية سلفاً

136
00:09:43,270 --> 00:09:46,610
لكن لماذا الطّبيب الدجّال؟

137
00:09:46,610 --> 00:09:47,860
...وأيضاً

138
00:09:49,860 --> 00:09:51,610
!قطّة

139
00:09:53,360 --> 00:09:56,580
!مؤلم! انتظري

140
00:09:57,870 --> 00:09:59,580
!شكراً على الطّعام

141
00:10:05,080 --> 00:10:06,590
ما هذا؟

142
00:10:09,500 --> 00:10:10,710
!مهلاً

143
00:10:10,710 --> 00:10:13,260
!ما مُشكلة هذه القطّة؟

144
00:10:13,260 --> 00:10:14,430
!غرفة الطّعام

145
00:10:20,680 --> 00:10:22,310
من أنت؟

146
00:10:22,890 --> 00:10:24,940
أنا آسفٌ حقّاً

147
00:10:24,940 --> 00:10:27,560
مهلاً، كوني لطيفة يا ماوماو

148
00:10:28,940 --> 00:10:31,490
ماوماو؟ أيّ اسم هو هذا؟

149
00:10:31,490 --> 00:10:32,690
اصمت

150
00:10:33,780 --> 00:10:35,160
اعتنيا بها

151
00:10:37,070 --> 00:10:38,450
لا تدعاها تهرب

152
00:10:38,450 --> 00:10:39,530
!حسناً

153
00:10:40,700 --> 00:10:44,290
قرّرتُ أن أطلب من عائلتي الاعتناء بماوماو

154
00:10:44,670 --> 00:10:49,250
أنا الوحيد الّذي يستطيع الاعتناء بها
في القصر الخلفيّ

155
00:10:49,250 --> 00:10:53,340
الأميرة لينغلي غادرت القصر الخلفيّ
مع الإمبراطورة غيوكويو، صحيح؟

156
00:10:53,340 --> 00:10:56,640
لم يُسمَح لهما بأخذ القطّة معهما

157
00:10:56,640 --> 00:10:59,970
أعتقد بأنّهما عُزِلتا بواسطة المُحيطين بهما{?}

158
00:10:59,970 --> 00:11:02,100
أنا متأكّدة بأنّ هناك قواعد أكثر
ممّا يوجد في القصر الخلفيّ

159
00:11:02,350 --> 00:11:07,440
ستكون أختي الصّغيرة مسرورة
بامتلاك صيّادة جرذان

160
00:11:08,770 --> 00:11:13,030
هل هي من أرسلتْ لك رسائلَ
بخصوص صنع الورق؟

161
00:11:13,820 --> 00:11:15,150
هذا صحيح

162
00:11:15,150 --> 00:11:18,990
لكن هذه المرّة، أرسلَتْ لي شيئاً مُقلِقاً

163
00:11:18,990 --> 00:11:19,660
ماذا كان؟

164
00:11:20,030 --> 00:11:22,120
...لا ينبغي أن أتحدّث عنه هنا

165
00:11:22,120 --> 00:11:24,620
سأشرح عندما نصل إلى القرية

166
00:11:30,170 --> 00:11:31,840
هل أنتِ جاهزة للمُغادرة؟

167
00:11:37,550 --> 00:11:39,550
—سيّد باسين. لماذا لِباسك

168
00:11:42,100 --> 00:11:45,930
هل أنا جاهزة؟ أليس هذا مُفاجئاً قليلاً؟

169
00:11:46,270 --> 00:11:48,850
لدينا أسبابنا

170
00:11:48,850 --> 00:11:52,400
سبب هامّ بما يكفي للتنكُّر؟

171
00:11:57,570 --> 00:12:01,660
عمل مُتقَن. وكأنّه خادِم السّيّد باسين

172
00:12:01,660 --> 00:12:04,240
الطّبيب الدجّال لم يشعر حتّى

173
00:12:04,700 --> 00:12:07,790
لكن لا يبدو السّيّد باسين مرتاحاً

174
00:12:07,790 --> 00:12:11,210
اصعدي. حضّرنا أمتعتكِ بالفعل

175
00:12:12,590 --> 00:12:13,880
حسناً

176
00:12:13,880 --> 00:12:17,470
يبدو أنّها ستكون رحلة سرّية طويلة

177
00:12:22,510 --> 00:12:25,220
لا بُدّ أنّ هذا صعب عليه. إنّه مشغول بما يكفي

178
00:12:25,220 --> 00:12:29,140
يحبّ الإمبراطور أن يُشغِّل أخاه الصّغير حقّاً

179
00:12:30,100 --> 00:12:33,860
...كما لو أنّه يُدرّب خليفةً

180
00:12:35,480 --> 00:12:36,900
ليس إلى هذا الحدّ

181
00:12:37,740 --> 00:12:39,860
هناك أميرٌ بالفعل

182
00:12:39,860 --> 00:12:42,570
مولاتي ريفا أنجبتْ فتى أيضاً

183
00:12:42,570 --> 00:12:44,910
والإمبراطور بحدِّ ذاته لا يزال صغيراً

184
00:12:54,710 --> 00:12:57,800
لا جدوى من أفكار مُشوِّشة كهذه

185
00:13:02,390 --> 00:13:05,220
يومان في عربة حصان

186
00:13:05,220 --> 00:13:08,850
يقع ديار الطّبيب الدجّال في جنوب غرب العاصمة

187
00:13:14,060 --> 00:13:15,860
هذا شعير

188
00:13:17,070 --> 00:13:20,280
يبدو الرّيّ مُتطوّراً حقّاً هنا

189
00:13:20,280 --> 00:13:22,740
هذا لأجل زِراعة الأرزّ في الصّيف

190
00:13:22,740 --> 00:13:26,200
أرزّ وشعير. نزرع محصولين في عام واحد

191
00:13:26,200 --> 00:13:30,660
يمكن للأرزّ الخام أن يُزرَع على نفس
التّربة دون إفقارها

192
00:13:30,660 --> 00:13:33,210
لا بُدّ أنّها منطقة خصبة

193
00:13:33,210 --> 00:13:36,380
النّهر قريبٌ أيضاً. لا بُدّ أنّه مُناسب للنّقل

194
00:13:39,010 --> 00:13:41,470
إنّه غير معتاد على القطط؟

195
00:13:41,470 --> 00:13:43,930
لدى هذا الرّجل نقاط ضعف كثيرة

196
00:13:51,690 --> 00:13:52,850
ماذا كان ذلك؟

197
00:14:04,740 --> 00:14:07,620
أخي العزيز! أهلاً بعودتك إلى الدّيار

198
00:14:09,370 --> 00:14:11,250
أجل، أهلاً بكِ

199
00:14:11,910 --> 00:14:14,370
أهذه هي القطّة؟

200
00:14:16,960 --> 00:14:19,590
!ما أظرفها

201
00:14:20,010 --> 00:14:23,470
المُهمّ، هل هؤلاء هم ضيوفك؟

202
00:14:23,470 --> 00:14:25,260
أ-أجل

203
00:14:25,590 --> 00:14:30,390
حقّاً؟ مُديرك في العمل ومُساعده؟

204
00:14:30,390 --> 00:14:31,680
مُساعد؟

205
00:14:33,560 --> 00:14:35,550
شكراً لكِ على الضّيافة

206
00:14:35,850 --> 00:14:39,110
لا شكر على واجب. استمتعوا بإقامتكم

207
00:14:43,190 --> 00:14:44,280
!لذيذة

208
00:14:44,280 --> 00:14:46,030
!يا إلهي

209
00:14:46,320 --> 00:14:52,200
لوهلة، ظننتُ أنّ أخي المخصيّ أحضر
!معه زوجةً شابّة

210
00:14:52,200 --> 00:14:55,250
هذا مُستحيل

211
00:14:55,250 --> 00:14:56,750
بالفعل

212
00:15:04,880 --> 00:15:07,390
يا للهول! هل أنت بخير؟

213
00:15:14,890 --> 00:15:16,770
،إن كنت تتظاهر بأنّك خادم

214
00:15:16,770 --> 00:15:19,810
فابقَ في العربة وكُل طعاماً محفوظاً فحسب

215
00:15:19,810 --> 00:15:22,110
بالطّبع، ما كان السّيّد باسين ليسمح بذلك

216
00:15:22,440 --> 00:15:24,740
سيكون من المُخجل إفساد تنكّره المثاليّ

217
00:15:24,740 --> 00:15:27,360
لذا آمل ألّا يتصرّف بطريقة غريبة

218
00:15:28,740 --> 00:15:30,200
عُدت

219
00:15:30,200 --> 00:15:32,370
!أنا جائع للغاية

220
00:15:32,370 --> 00:15:34,580
أخي! لم أرك منذ مدّة

221
00:15:35,040 --> 00:15:36,710
!بالفعل، لم أرك منذ مدّة طويلة

222
00:15:36,710 --> 00:15:38,920
تسرّني رؤيتك ثانية يا خالي

223
00:15:39,290 --> 00:15:42,090
أجل، لقد نموتَ وكبرتَ كثيراً

224
00:15:52,430 --> 00:15:55,430
!مهلاً، أين آداب سلوكك؟

225
00:15:56,100 --> 00:15:57,350
...أخي

226
00:15:58,190 --> 00:16:00,310
هذا ابن أخت الدجّال، صحيح؟

227
00:16:00,610 --> 00:16:03,820
الابن الأكبر وقح جدّاً

228
00:16:03,820 --> 00:16:07,450
إنّه مخصيّ غاب لسنوات

229
00:16:07,900 --> 00:16:10,120
لماذا تُرجعينه الآن؟

230
00:16:10,620 --> 00:16:14,240
وبرفقة مجموعة من الضّيوف

231
00:16:14,240 --> 00:16:15,700
!لماذا تقول ذلك؟

232
00:16:25,670 --> 00:16:28,170
سأتناول هذا، فأنا لا أريده أن يبرد

233
00:16:30,970 --> 00:16:32,010
...ما

234
00:16:35,020 --> 00:16:36,180
أين حسائي؟

235
00:16:36,180 --> 00:16:38,350
!أليس لديك أيّ كلام آخر تقوله أوّلاً؟

236
00:16:43,270 --> 00:16:44,440
تبّاً

237
00:16:44,440 --> 00:16:50,530
أنا آسف. إنّه لا يفهم كم خدمتَ القريةَ يا أخي

238
00:16:50,990 --> 00:16:54,950
لا عليك. أنا معتاد على مثل هذه الأمور

239
00:16:57,290 --> 00:17:02,040
حسبما أذكر، ذهبَ الطّبيبُ الدجّال للعمل
في القصر الخلفيّ بدلاً عنها

240
00:17:02,750 --> 00:17:04,960
لا بُدّ أنّ ذلك آلمها كثيراً

241
00:17:05,550 --> 00:17:06,800
...لكن

242
00:17:10,430 --> 00:17:14,050
لا، يجب أن أعتذر عن المجيء فجأة دون موعد

243
00:17:15,060 --> 00:17:19,480
على أيّ حال، تواصلتُم معي لأنّكم أردتُم
منّي شيئاً، أليس كذلك؟

244
00:17:19,520 --> 00:17:22,230
هل لديكم ما تُناقشونه؟

245
00:17:23,900 --> 00:17:25,360
...بصراحة

246
00:17:25,360 --> 00:17:27,860
!ثمّة طلب نريد أن نطلبه من الإمبراطور

247
00:17:28,150 --> 00:17:28,780
!ماذا؟

248
00:17:29,690 --> 00:17:33,530
أخي، أنت طبيبٌ عظيمٌ ساهمَ في ولادة
!أطفال الإمبراطور، صحيح؟

249
00:17:42,210 --> 00:17:44,830
...كان ذلك أبي، لكن

250
00:17:44,830 --> 00:17:48,050
أعتقد بأنّه تباهى بذلك أمام عائلته

251
00:17:48,050 --> 00:17:50,130
...لن أفضح أمره، لكن

252
00:17:50,720 --> 00:17:52,630
إنّهما مُندهشان تماماً

253
00:17:53,130 --> 00:17:58,060
أنا غير جدير بذلك! لستُ في منصب
!يسمح لي بالتكلُّم معه

254
00:17:58,470 --> 00:18:00,020
أما من طريقة؟

255
00:18:00,850 --> 00:18:02,020
...في الواقع

256
00:18:02,440 --> 00:18:07,360
لا أستطيع التحدُّث مع الإمبراطور، لكن
رُبّما هناك آخرون يمكنني التكلُّم معهم

257
00:18:07,360 --> 00:18:08,650
عمّاذا يدور الأمر على أيّ حال؟

258
00:18:16,620 --> 00:18:18,790
هلّا شاركتمونا الموضوع؟

259
00:18:18,790 --> 00:18:21,120
...لا أعلم ما إن كان بمقدرنا المُساعدة، لكن

260
00:18:21,410 --> 00:18:25,630
لا تقلقوا. إنّهما مُوظَّفان حقيقيّان

261
00:18:26,960 --> 00:18:28,500
...بما أنّ الأمر كذلك

262
00:18:32,090 --> 00:18:36,470
المسألة تخصُّ الحقوق المُتعلِّقة
بالأرض الّتي تقع القرية ضمنها

263
00:18:36,970 --> 00:18:40,060
كانت هذه قطعة مُستعارة في الأصل

264
00:18:40,470 --> 00:18:44,810
وفقاً للزوج، كان مالِك الأرض السّابق سخيّاً

265
00:18:45,100 --> 00:18:48,310
سمحَ لأهل القرية باستعارة الأرض ضمن
صفقة، باعتباره لم يكن يستخدمها

266
00:18:48,650 --> 00:18:54,820
مع مضيّ السّنين، بدؤوا بمُناقشة شِراء الأرض

267
00:18:56,320 --> 00:19:00,830
وقّفوا صفقةً لشراء الأرض والغابة
على مدى 20 عاماً

268
00:19:00,830 --> 00:19:03,910
واستمرّ سداد الأقساط دون مشاكل

269
00:19:05,420 --> 00:19:09,590
لكن قبل سنوات قليلة، تُوفّي مالك الأرض

270
00:19:09,590 --> 00:19:13,170
تولّى ابنُه زمام الأمر، وتغيّرت الأمور منذ ذلك الحين

271
00:19:13,970 --> 00:19:16,680
،لا يحبّ المالكُ الجديد الغُرباء

272
00:19:16,680 --> 00:19:19,600
ولا يحترم الحِرفيّين بشكل عام

273
00:19:20,470 --> 00:19:24,600
كان مستاء كيف أنّ ورقَهم جعلَهم
مُورِّدين للإمبراطور

274
00:19:24,600 --> 00:19:27,440
،عندما انخفضتْ جودةُ الورق في تلك المرّة

275
00:19:27,440 --> 00:19:30,230
ظلَّ يتردّد عليهم ليطلب قسطاً من القرض

276
00:19:32,110 --> 00:19:36,030
كان يُزعجنا كثيراً في السّابق

277
00:19:36,030 --> 00:19:40,160
،كان يخبرنا بأنّنا نُلوّث الماء ونُفسد محاصيل الأرزّ

278
00:19:40,530 --> 00:19:43,410
أو بأنّنا نستهلك الماء ولا يستطيعون
الآن زِراعة الأرزّ

279
00:19:44,160 --> 00:19:47,540
لكن هذه المرّة، كان الأمر أكثر خطورة

280
00:19:47,540 --> 00:19:51,420
طلب منّا التّسديد فوراً أو نُغادر

281
00:19:52,340 --> 00:19:54,550
كم سنة من الأقساط قد تبقّى؟

282
00:19:55,090 --> 00:19:59,180
خمسة. مُحال أن نتمكّن من تسديد
القرض كُلّه دُفعة واحدة

283
00:19:59,180 --> 00:20:02,850
يريد المالكُ الحاليّ أن يستولي
على حِرفة صنع الورق

284
00:20:02,850 --> 00:20:06,390
لماذا؟ لماذا لا يدعنا نقوم بعملنا فحسب؟

285
00:20:06,810 --> 00:20:11,610
هذا لأنّ الضّرائب على الحبوب ارتفعتْ
كثيراً بشكل مُفاجئ في هذا العام

286
00:20:12,690 --> 00:20:16,440
بينما انخفضت الضّرائب على صنع
الورق قبل سنوات قليلة

287
00:20:16,440 --> 00:20:18,530
لا بُدّ أنّ ذلك أزعجَه أيضاً

288
00:20:19,780 --> 00:20:23,660
لا بُدّ أنّ تخفيف الضّرائب على الورق كان
الغاية منه محو الأمّية

289
00:20:24,290 --> 00:20:28,330
بينما ارتفاع الضّرائب على الحبوب من النّاحية
الأُخرى سببه غالباً وباء الجراد

290
00:20:28,960 --> 00:20:32,170
،نظراً للمحصول المُضاعَف من هذه المنطقة

291
00:20:32,170 --> 00:20:34,880
لا ينبغي أن يكون ارتفاع الضّرائب
كافياً ليُسبّب أي مُشكلة حقيقيّة

292
00:20:35,710 --> 00:20:40,470
لكن رغم ذلك، ليس من السّهل
تحمُّل نتائج هذا الأمر

293
00:20:40,720 --> 00:20:44,310
وعلاوة على ذلك، هو أيضاً

294
00:20:44,760 --> 00:20:47,430
لبضعة أسباب، اصطفَّ ابني الأكبر مع المُزارعين

295
00:20:47,770 --> 00:20:51,310
ويؤمن أيضاً بأنّ كافّة البيروقراطيّين مُتشابهون

296
00:20:51,690 --> 00:20:56,820
لهذا السّبب أردتُ أن أرى ما إن كنّا نستطيع
أن نطلب خصماً على ضرائب الحبوب

297
00:20:58,700 --> 00:21:02,200
أنا مُجرّد مخصيّ

298
00:21:03,620 --> 00:21:04,700
فهمت

299
00:21:06,870 --> 00:21:10,110
حسناً، في هذه الحالة، سنجري نِقاشاً غداً

300
00:21:10,110 --> 00:21:11,290
هل يمكنك المجيء؟

301
00:21:11,670 --> 00:21:13,580
أستطيع فعل ذلك

302
00:21:13,580 --> 00:21:15,300
هل يمكنني الانضمام كذلك؟

303
00:21:17,820 --> 00:21:20,840
لـ... لا أعلم ما إن كان الطّرف الآخر
سيُوافق على ذلك

304
00:21:20,840 --> 00:21:24,550
قد يكون وجود طرف ثالث مُفيداً بطريقة ما

305
00:21:25,220 --> 00:21:29,560
لن أُقاطع أحداً. إن رفضوا، فأستطيع التحدُّث معهم

306
00:21:29,560 --> 00:21:32,310
أعتقد بأنّه قلِق، بما أنّه جزءٌ من الأمر

307
00:21:32,810 --> 00:21:35,020
...في هذه الحالة، حسناً

308
00:21:35,570 --> 00:21:38,690
!سأحرص على الحضور أيضاً

309
00:21:38,690 --> 00:21:41,450
ليس وكأنّك ستنفع في شيء

310
00:21:52,040 --> 00:21:54,540
مهلاً، لا تبكي. رجاء

311
00:21:56,130 --> 00:21:58,760
...لكن... في هذه الحالة

312
00:22:01,880 --> 00:22:03,010
لا تقلقي

313
00:22:03,890 --> 00:22:05,720
سأتولّى هذا

314
00:23:45,070 --> 00:24:00,000
الحلقة القادمة

315
00:23:55,290 --> 00:23:57,580
"الحلقة القادمة: "الرِّهان

316
00:23:55,370 --> 00:24:00,000
الحلقة 55: الرِّهان