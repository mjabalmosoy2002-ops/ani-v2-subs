1
00:00:09,650 --> 00:00:12,800
...تقدّموا وألقوا نظرة

2
00:00:12,800 --> 00:00:17,760
.حان موعد ياميشيباي

3
00:00:19,650 --> 00:00:25,490
...هذه قصّة صبيّ معيّن

4
00:00:25,490 --> 00:00:28,220
.تخفي أمّي سرًّا

5
00:00:28,640 --> 00:00:31,880
.إنّها صديقة لشيطان

6
00:00:32,350 --> 00:00:35,510
.كان أبي يعيش معنا قبل مدّة

7
00:00:36,830 --> 00:00:40,720
.كانت الأمور سعيدة حينها وكان كلّ يوم ممتع

8
00:00:40,720 --> 00:00:44,290
.لكن يومًا ما، غادر أبي فجأة

9
00:00:44,290 --> 00:00:47,520
.ومذّاك الحين، ما عاد أحد يضحك في البيت

10
00:00:44,560 --> 00:00:46,520
.أنهِ وجبتك وإلّا تأخّرت على المدرسة

11
00:00:47,530 --> 00:00:49,510
هل ستقيمون حفلة رمي الفول؟

12
00:00:48,960 --> 00:00:52,140
.لكن لا أظنّني تعيس الحظّ

13
00:00:49,510 --> 00:00:53,200
.قيل أنّها ستقام بعد الفترة الدّراسيّة غدًا

14
00:00:52,140 --> 00:00:54,600
".السّعادة شيء يجب أن تحصل عليه بنفسك"

15
00:00:53,200 --> 00:00:56,190
.لا أستطيع أخذ اليوم عطلة. آسفة

16
00:00:54,600 --> 00:00:56,870
.كان أبي من علّمني ذلك

17
00:00:56,190 --> 00:00:56,840
.حسنًا

18
00:00:57,310 --> 00:00:59,610
.تذكّروا، سوف نرمي الفول غدًا

19
00:00:59,610 --> 00:01:02,550
.أتساءل لمَ نرمي الفول كلّ عام

20
00:01:00,270 --> 00:01:03,640
هل تعرفون ما يُقال جميعًا عندما نرميه؟

21
00:01:02,550 --> 00:01:06,860
لمَ لا يزال هناك شياطين حتّى عندما نفعل ذلك؟

22
00:01:03,920 --> 00:01:06,130
"!نبعد الشّياطين، نقرّب التّوفيق"

23
00:01:06,130 --> 00:01:07,070
!هذا صحيح

24
00:01:06,860 --> 00:01:08,640
ما هو الشّيطان أصلًا؟

25
00:01:07,380 --> 00:01:09,360
.الشّياطين لا تحبّ الفول

26
00:01:08,640 --> 00:01:14,020
عندما أرى نسوة عجائز غاضبات أو رجال
.عجائز ثملون، فالكبار يبدون كشياطين لي

27
00:01:09,360 --> 00:01:11,030
لهذا، إن رميتموه

28
00:01:11,030 --> 00:01:14,020
.وقلتم "نبعد الشّياطين،" يمكنكم طردها

29
00:01:14,020 --> 00:01:16,500
.أتساءل ما هو الاختلاف بين الشّياطين والبشر

30
00:01:14,020 --> 00:01:17,930
!وثمّ عندما تقولون، "نقرّب التّوفيق،" يمكنكم جذب الحظّ الحسن

31
00:01:16,500 --> 00:01:18,890
هل الأنياب والقرون؟

32
00:01:18,890 --> 00:01:19,870
.أستاذة

33
00:01:19,870 --> 00:01:21,940
نعم يا سانادا-كن، ماذا هناك؟

34
00:01:22,360 --> 00:01:25,410
لمَ علينا إبعاد الشّياطين؟

35
00:01:25,410 --> 00:01:26,890
!هذا سؤال سديد

36
00:01:26,890 --> 00:01:30,480
.قيل منذ فجر التّاريخ أنّ الشّياطين تتسبّب في أمور سيّئة

37
00:01:30,480 --> 00:01:32,560
...تتسبّب في أمور سيّئة

38
00:01:31,270 --> 00:01:34,400
.أي إن كانت الشّياطين حولنا، فسوف تتسبّب بالمشاكل للنّاس

39
00:01:33,020 --> 00:01:36,890
دعونا نبذل جهودنا جميعًا في رمي الفول غدًا، اتّفقنا؟

40
00:01:34,400 --> 00:01:37,570
.أظنّ أنّها فكرة سيّئة أن تكوّن صداقة مع شيطان إذًا

41
00:01:37,220 --> 00:01:38,410
!نعم

42
00:01:38,630 --> 00:01:40,930
.أظنّ أنّ أمّي وحيدة

43
00:01:40,930 --> 00:01:43,530
،إن كانت أمّي سعيدة كما كانت عندما كان أبي معنا

44
00:01:43,530 --> 00:01:45,700
.لما كوّنت صداقة مع شيطان أبدًا

45
00:01:45,700 --> 00:01:48,690
".فهي تقول دائمًا، "اختر أصدقائك بعناية

46
00:01:52,710 --> 00:01:56,530
.قيل منذ فجر التّاريخ أنّ الشّياطين تتسبّب في أمور سيّئة

47
00:01:56,530 --> 00:01:57,940
.لا أستطيع الهرب

48
00:01:57,940 --> 00:02:02,360
...عليّ أن أحمي أمّي. قبل حدوث أيّ شيء سيّئ

49
00:02:04,910 --> 00:02:07,970
.أتساءل من يريد أن يقيم حفلات رمي الفول

50
00:02:05,720 --> 00:02:09,600
!نبعد الشّياطين! نقرّب التّوفيق

51
00:02:07,970 --> 00:02:09,070
أشخاص تعساء؟

52
00:02:09,070 --> 00:02:10,990
أشخاص يريدون الحظّ الحسن؟

53
00:02:09,600 --> 00:02:11,990
يوتا، ألن ترمي الفول؟

54
00:02:11,990 --> 00:02:14,470
.عليّ أن أتخلّص من الشّياطين الّتي في بيتي

55
00:02:15,870 --> 00:02:20,050
".قرأتُ في كتابٍ مرّةً أنّ "السّعادة تختلف من شخص لآخر

56
00:02:16,770 --> 00:02:18,760
كيف كان حفل رمي الفول؟

57
00:02:18,760 --> 00:02:20,830
.أنا آسفة لأنّي لم أستطع الحضور

58
00:02:20,050 --> 00:02:23,850
،لم نكن أثرياء قطّ، لكنّ أبي كان يلعب معي دائمًا

59
00:02:20,830 --> 00:02:21,890
يوتا؟

60
00:02:22,390 --> 00:02:25,720
.قيل أنّ الشّياطين تتسبّب في أمور سيّئة

61
00:02:23,850 --> 00:02:28,120
وكان طبخ أمّي طيّبًا، وعندما كنّا
،نشاهد التّلفاز بينما نأكل سويًّا

62
00:02:26,130 --> 00:02:28,110
هل علّموك ذلك في حفل رمي الفول؟

63
00:02:28,120 --> 00:02:30,380
.كان ذلك الشّيء المفضّل عندي

64
00:02:28,500 --> 00:02:31,000
أمّي، هل أنت صديقة لشيطان؟

65
00:02:30,380 --> 00:02:35,950
حتّى الآن، ما زلت فرحًا لتناول الطّعام
.مع أمّي، لكنّها تبدو حزينة نوعًا ما

66
00:02:31,260 --> 00:02:32,130
ماذا؟

67
00:02:32,480 --> 00:02:35,730
.رأيت ذلك. ثمّة شيطان في غرفتك

68
00:02:35,730 --> 00:02:38,980
...ربّما مات أبي لأنّ الشّيطان تسبّب في شيء سيّئ

69
00:02:35,950 --> 00:02:38,850
.أتساءل إن كانت لا تحبّ كوني معها

70
00:02:38,850 --> 00:02:41,850
.ربّما كانت السّعادة بالنّسبة لها هي عندما كان أبي معنا

71
00:02:38,980 --> 00:02:40,110
!كيف تقول ذلك؟

72
00:02:40,630 --> 00:02:42,680
!لا توجد شياطين

73
00:02:41,850 --> 00:02:43,250
إذًا أهي تعيسة الآن؟

74
00:02:43,010 --> 00:02:46,880
!لكنّي رأيته! لا يمكنك أن تصادقي شيطانًا يا أمّي

75
00:02:43,250 --> 00:02:46,860
ربّما تشعر بوحدة كبيرة لدرجة أن
!تقترف خطأً كتكوين صداقة مع شيطان

76
00:02:46,860 --> 00:02:49,820
.في تلك الحالة، ينبغي أن أعلّمها عن خطئها

77
00:02:46,880 --> 00:02:48,680
!سيجعلنا ذلك تعيسين

78
00:02:48,680 --> 00:02:50,150
!عليك أن تتوقّف حالًا

79
00:02:49,820 --> 00:02:51,650
.الشّياطين سيّئة

80
00:02:50,150 --> 00:02:51,470
!يوتا

81
00:02:56,840 --> 00:02:59,960
.عندما غضبت أمّي، بدا وجهها كشيطان

82
00:02:59,960 --> 00:03:02,820
.لم تبدُ كأمّي اللّطيفة بعد الآن

83
00:03:02,200 --> 00:03:03,330
يوتا؟

84
00:03:02,820 --> 00:03:05,680
لمَ يرحل كلّ من أحبّهم؟

85
00:03:04,450 --> 00:03:07,310
.يوتا، آسفة بشأن السّابق

86
00:03:08,720 --> 00:03:12,820
.ما زالت أمّي هي أمّي. لا ينبغي أن أهدر الوقت في القلق

87
00:03:12,820 --> 00:03:15,340
،يجب أن أتحلّى بالشّجاعة وأتخلّص منه

88
00:03:15,660 --> 00:03:17,620
!قبل أن تتحوّل أمّي إلى شيطان

89
00:03:18,340 --> 00:03:20,560
...أظنّه يفهم

90
00:03:19,930 --> 00:03:22,480
.لن أدع أيّ أحد يؤذي أمّي وينفد بفعلته

91
00:03:20,560 --> 00:03:22,180
.كان من المحتّم أن يعرف عاجلًا أم آجلًا

92
00:03:22,180 --> 00:03:24,060
...يا ليته لم يضطرّ لذلك

93
00:03:22,480 --> 00:03:24,460
!وحدي أستطيع حمايتها

94
00:03:24,460 --> 00:03:27,130
!وسأفعل

95
00:03:27,140 --> 00:03:27,980
!اخرج أيّها الشّيطان

96
00:03:27,980 --> 00:03:28,880
!نبعد الشّياطين

97
00:03:28,170 --> 00:03:30,750
.رميت الفول على الشّيطان بكلّ ما تيسّر لي

98
00:03:28,880 --> 00:03:30,140
!توقّف يا يوتا

99
00:03:29,080 --> 00:03:34,210
!نبعد الشّياطين! نقرّب التّوفيق

100
00:03:30,750 --> 00:03:35,020
.علمتُ أنّه إن غادر، فستعود الابتسامة لأمّي وتصير حنونة ثانيةً

101
00:03:31,460 --> 00:03:32,730
!يوتا، يكفي

102
00:03:33,250 --> 00:03:34,550
!توقّف! توقّف يا يوتا

103
00:03:33,820 --> 00:03:36,240
!أرجوك يا يوتا! توقّف

104
00:03:34,650 --> 00:03:37,050
!نبعد الشّياطين! نقرّب التّوفيق

105
00:03:35,020 --> 00:03:38,070
.وسوف نستطيع عيش حياة جديدة كلّيًّا

106
00:03:42,710 --> 00:03:44,670
.طردتُ الشّيطان

107
00:03:44,480 --> 00:03:45,690
أمّي؟

108
00:03:44,670 --> 00:03:48,900
.أنا واثق أنّ هذا سيُسعد عائلتي ثانيةً

109
00:03:48,900 --> 00:03:50,120
أمّي؟

110
00:03:53,380 --> 00:03:54,300
ماذا؟

111
00:03:58,950 --> 00:04:01,070
.النّهاية