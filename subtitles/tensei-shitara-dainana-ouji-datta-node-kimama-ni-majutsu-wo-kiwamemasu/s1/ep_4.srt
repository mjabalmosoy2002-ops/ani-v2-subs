1
00:00:54,230 --> 00:00:55,900
انظر هناك

2
00:02:43,260 --> 00:02:45,630
والوحش في هذه الغابة؟

3
00:02:45,630 --> 00:02:49,100
لا، سمعتُ أنّه عند البحيرة في نقطة
أبعد من هذا الطّريق

4
00:02:49,620 --> 00:02:50,630
!هكذا إذاً

5
00:02:50,630 --> 00:02:53,610
يبدو أنّك تتطلّع قُدماً لهذا
يا سموّ الأمير لويد

6
00:02:53,610 --> 00:02:55,150
!بالتّأكيد

7
00:02:55,150 --> 00:02:57,870
!فنادراً ما يُسمَح لي بمغادرة القلعة

8
00:02:58,330 --> 00:03:01,170
وأريد أن أرى جودة أسلحتي المُفتَتنة أيضاً

9
00:03:05,900 --> 00:03:09,360
،أنتِ لا تنفكّين تراقبين لويد بحرص
أليس كذلك يا سيلفا؟

10
00:03:09,650 --> 00:03:15,490
أنا ممتنّة لسماحك لي بمرافقتك
يا سموّ الأمير آلبيرت

11
00:03:15,490 --> 00:03:16,860
لا عليكِ

12
00:03:16,860 --> 00:03:20,140
فأنتِ مُدرِّسة لويد وحارسته الشّخصيّة

13
00:03:20,370 --> 00:03:23,630
فضلاً عن ذلك... أنا متأكّدٌ بأنّكِ سوف تفتقدينه

14
00:03:24,690 --> 00:03:26,890
هذا لأنّني مُدرِّسته

15
00:03:26,890 --> 00:03:29,040
أهذا كلّ شيء حقّاً؟

16
00:03:29,040 --> 00:03:33,150
لا تراودكِ مشاعر خاصّة أخرى ربّما؟

17
00:03:34,200 --> 00:03:36,280
!أمزح بالطّبع

18
00:03:36,970 --> 00:03:39,010
يبدو أنّنا لدينا زوّار

19
00:03:39,570 --> 00:03:41,520
!هجوم من العدوّ

20
00:03:41,520 --> 00:03:42,540
!كوبولد

21
00:03:42,540 --> 00:03:45,130
!ولديهم أسلحة فولاذيّة

22
00:03:45,680 --> 00:03:47,920
!سيكون هذا إحماء جيّداً للوحش

23
00:03:47,920 --> 00:03:49,540
!احموا الأمير آلبيرت

24
00:03:49,810 --> 00:03:51,670
أنا خائف

25
00:03:52,440 --> 00:03:54,430
أعلم بأنّك شعرت بقدومهم

26
00:03:55,810 --> 00:03:56,660
...بالطّبع

27
00:03:57,430 --> 00:04:00,720
إحدى تقنيّات الكي الّتي علّمَتْني إيّاها
تاو هي الكشف الطّيفيّ

28
00:04:01,100 --> 00:04:05,270
باستخدام تنفُّس الكي أستطيع الشُّعور
بمُحيطي طوال الوقت

29
00:04:05,270 --> 00:04:08,170
...إنّها إحدى التقنيّات الأساسيّة الّتي علّمَتْني إيّاها

30
00:04:08,680 --> 00:04:10,440
لكنّها نافعة جدّاً

31
00:04:10,710 --> 00:04:13,540
...يستخدم دوماً الكشف الطّيفيّ مع حاجز

32
00:04:13,540 --> 00:04:16,450
!يزداد هذا الفتى رُعباً يوماً بعد يوم

33
00:04:16,450 --> 00:04:18,910
!انظر! لقد بدأتْ

34
00:04:20,150 --> 00:04:21,410
!خذ هذه

35
00:04:28,170 --> 00:04:29,670
!إنّه حادٌّ جدّاً

36
00:04:30,140 --> 00:04:32,670
!يقطع العتاد الفولاذيّ وكأنّه ورق

37
00:04:33,920 --> 00:04:36,160
!يبدو أنّ سحر الافتتان كان ناجحاً

38
00:04:36,160 --> 00:04:39,170
الأسلحة أحدّ بكثير لدرجة جعلَت
الجنود يرتعدون كأطفال

39
00:04:39,170 --> 00:04:41,170
...يمسكون بسكّين للمرّة الأولى في حياتهم

40
00:04:43,430 --> 00:04:47,420
!أرأيتم؟! هذه هي قوّة أخي

41
00:04:47,690 --> 00:04:50,920
!يبدو أنّ لويد نابغة في الافتتان

42
00:04:50,920 --> 00:04:53,090
!إنّه من لحمي ودمي، وحتّى أنا مندهش

43
00:04:53,090 --> 00:04:54,650
...أ-أجل

44
00:04:55,670 --> 00:04:58,490
أجل! سموّ الأمير لويد رائع

45
00:04:59,850 --> 00:05:03,740
ماذا؟ أنا متأكّد بأنّني لم أفتن سلاحَ سيلفا

46
00:05:15,230 --> 00:05:19,840
شعرتُ بوجود وسيم مُثير... أقصد
!بوجود وحش، فأتيتُ مُسرعة

47
00:05:19,840 --> 00:05:22,550
!تاو المُغامِرة قد أتت لتقديم المساعدة

48
00:05:22,550 --> 00:05:23,890
!تاو؟

49
00:05:26,620 --> 00:05:30,150
كان ذلك وشيكاً. كنتُ لأناديها
...كما كنتُ أفعل بهيئة روبيرت

50
00:05:30,470 --> 00:05:33,530
لم أتوقّع أن تظهر في وقت كهذا

51
00:05:35,190 --> 00:05:37,970
أنت... تتنفّس بطريقة الكي، أليس كذلك؟

52
00:05:37,970 --> 00:05:40,650
...أكاد أقسم بأنّني شعرتُ بروبيرت

53
00:05:41,890 --> 00:05:46,490
وطريقتك في فعل ذلك... أنت
تشبهه بعض الشّيء أيضاً

54
00:05:51,270 --> 00:05:53,730
...أشكرك على مساعدتكِ، لكن

55
00:05:53,730 --> 00:05:56,420
حاولي ألّا تشكّلي عقبة أثناء ذلك

56
00:05:56,420 --> 00:05:59,790
ولا تتكلّمي بأريحيّة هكذا مع الأمير لويد

57
00:05:59,790 --> 00:06:01,090
لم أكن أفعل

58
00:06:01,090 --> 00:06:03,800
واستطعتُ الشّعور بوجود ذلك المخلوق خلفي

59
00:06:03,800 --> 00:06:05,180
لا تستهيني بتقنيّات الكي

60
00:06:09,320 --> 00:06:11,610
!حسناً، فهمت، شكراً على المساعدة

61
00:06:11,610 --> 00:06:14,000
ما رأيكِ بالانضمام إلينا في الطّريق إلى البُحيرة؟

62
00:06:24,860 --> 00:06:26,140
!أشكركِ

63
00:06:26,140 --> 00:06:28,700
تمكنّا من بلوغ وجهتنا بمساعدتكِ

64
00:06:29,060 --> 00:06:30,640
اسمي آلبيرت

65
00:06:30,640 --> 00:06:32,310
أنا الأمير الثّاني لمملكة سالوم

66
00:06:33,280 --> 00:06:35,230
!أنت أمير؟

67
00:06:35,230 --> 00:06:36,990
!سامحني على وقاحتي

68
00:06:36,990 --> 00:06:38,320
!إنّه وسيم

69
00:06:38,590 --> 00:06:42,720
،لكن هذا غريب، الأمير آلبيرت وروبيرت متشابهان

70
00:06:42,720 --> 00:06:45,650
...لكن لا أظنّه الشّخص الوسيم الّذي شعرتُ به

71
00:06:45,650 --> 00:06:47,850
يمكنكِ الشّعور بالوسيمين؟

72
00:06:48,250 --> 00:06:50,330
هل أبدو كشخص تعرفينه؟

73
00:06:50,330 --> 00:06:52,590
...على الأقلّ ذلك الفتى

74
00:06:52,940 --> 00:06:54,820
ماذا؟ إلى أين ذهب؟

75
00:06:54,820 --> 00:06:56,090
تقصدين لويد؟

76
00:06:56,350 --> 00:06:59,130
إنَّ استخدام تنفُّس الكشف الطّيفيّ
...ارتدّ سلباً عليّ

77
00:06:59,650 --> 00:07:03,470
لم أتوقّع أن تكون حساسيّة تاو بهذه الدقّة

78
00:07:03,470 --> 00:07:07,100
،وإذا توقّفت عن القيام بذلك الآن
فسيبدو ذلك مشبوهاً بنفس الدّرجة

79
00:07:07,460 --> 00:07:11,570
أنا عالِق... أظنّني سأختبر في هذه
الخيمة ريثما يظهر الوحش

80
00:07:15,050 --> 00:07:17,580
!ماذا تفعلين يا سيلفا؟

81
00:07:18,200 --> 00:07:20,080
المعذرة

82
00:07:20,080 --> 00:07:23,060
وجدتُ بقعَ دماء عليّ، لذا
ارتأيتُ أن أبدّل ملابسي

83
00:07:23,060 --> 00:07:26,460
!السّؤال هو لماذا تبدّلين ملابسكِ في خيمتي؟

84
00:07:26,730 --> 00:07:29,660
لأنّني سوف أنام في هذه الخيمة اللّيلة

85
00:07:31,010 --> 00:07:34,540
الجنود في الخارج جميعهم
حُرّاس الأمير آلبيرت

86
00:07:34,540 --> 00:07:37,680
أنا الوحيدة هنا الّتي تحميك يا سموّ
...الأمير لويد، لهذا السّبب

87
00:07:37,680 --> 00:07:40,740
...لا داعي، أنا بخير بمفردي

88
00:07:42,650 --> 00:07:43,790
!لستَ كذلك

89
00:07:43,790 --> 00:07:46,730
نظراً إلى وجود هرّة تتسكّع أكثر
...رُعباً من أي وحش أعرفه

90
00:07:46,730 --> 00:07:49,740
...كأنّني شعرتُ بوجود روبيرت هنا

91
00:07:50,230 --> 00:07:52,980
ما-ما-ماذا تفعلين بالضّبط؟

92
00:07:53,820 --> 00:07:54,750
!يا للهول

93
00:07:55,010 --> 00:07:56,990
...المعذرة

94
00:07:56,990 --> 00:07:59,660
كأنّني شعرتُ بأحمق

95
00:07:59,660 --> 00:08:02,750
!من تنعتينه بالأحمق أيّتها الخادمة المنحرفة؟

96
00:08:02,750 --> 00:08:07,550
آمل أن تتوقّفي عن النّظر بطريقة
غير لائقة للأمير لويد

97
00:08:07,550 --> 00:08:10,010
!لـ-لـ-لم أنظر بأي طريقة غير لائقة

98
00:08:10,010 --> 00:08:12,700
لستُ متأكّدة من ذلك

99
00:08:10,450 --> 00:08:14,760
يا للفوضى... سيكون هذا خانقاً أكثر من القلعة

100
00:08:12,700 --> 00:08:14,750
!بل تأكّدي

101
00:08:14,750 --> 00:08:17,360
!يا لك من ساحر للنساء يا لويد

102
00:08:17,750 --> 00:08:19,690
كفاك مُزاحاً

103
00:08:20,300 --> 00:08:21,520
أنا لا أمزح

104
00:08:21,770 --> 00:08:25,080
تغيّرت سيلفا كثيراً منذ بدأت تعتني بك

105
00:08:25,510 --> 00:08:28,870
لماذا أنتِ هنا في المقام الأوّل؟

106
00:08:28,870 --> 00:08:32,350
!كما قلتُ، شعرتُ بوحوش بينما كنتُ أعمل

107
00:08:32,350 --> 00:08:34,120
لكن هل هذا صحيح؟

108
00:08:34,120 --> 00:08:37,880
تنظر إليك بطريقة نظر امرأة إلى رجل

109
00:08:39,070 --> 00:08:41,270
يبدو أنّ لديك شعبيّة بين الجميلات
يا سموّ الأمير لويد

110
00:08:41,900 --> 00:08:46,220
حسناً... كن حذراً فحسب. فالعلاقات
...مع النّساء يمكن أن تكون

111
00:08:46,620 --> 00:08:48,370
مُرعبة جدّاً

112
00:08:57,230 --> 00:08:59,750
صدّقني... أنا جادّ

113
00:09:00,390 --> 00:09:01,200
أجل

114
00:09:04,100 --> 00:09:07,680
!تمّ استئجاري لإصلاح مزر قديم

115
00:09:08,770 --> 00:09:12,410
!انظري! إنّه المكان هناك أعلى التلّة

116
00:09:12,750 --> 00:09:14,110
...مزار

117
00:09:14,110 --> 00:09:16,310
ينبغي أن تغادري بسرعة إذاً

118
00:09:16,310 --> 00:09:17,870
!ليس عليكِ إخباري بذلك

119
00:09:17,870 --> 00:09:19,170
!مهلاً لحظة

120
00:09:19,170 --> 00:09:20,860
من الخطير الذّهاب لوحدكِ

121
00:09:21,270 --> 00:09:24,610
فضلاً عن ذلك، قدرتكِ في الشّعور
بالتّهديدات مفيدة حقّاً

122
00:09:24,930 --> 00:09:28,330
إن لم تمانعي، يمكنكِ البقاء مع مجموعتنا
...حتّى الصّباح، لتعملي كمُراقِبة

123
00:09:30,750 --> 00:09:31,950
—لا أعتقد

124
00:09:34,440 --> 00:09:36,890
ستحتاجون واحدة في هذه المرحلة

125
00:09:37,880 --> 00:09:39,380
هكذا يبدو

126
00:09:40,910 --> 00:09:43,030
!لا بدّ أنّه الوحش

127
00:10:02,110 --> 00:10:04,660
!بالغتُ في فعلها ثانية... التّالي

128
00:10:06,340 --> 00:10:09,330
أنا متأكّد... بأنّ هذا سيف مسحور يا زعيم

129
00:10:09,330 --> 00:10:12,140
أظنّه لآلبيرت

130
00:10:12,140 --> 00:10:15,000
ربّما اختلط بين الآخرين

131
00:10:15,000 --> 00:10:16,770
لنضعه جانباً

132
00:10:16,770 --> 00:10:17,750
...لا

133
00:10:17,750 --> 00:10:23,080
أنا واثقٌ بأنّه أدرك بأنّني سأضجر من العمل فقط
على سيوف فولاذيّة، فرماه لي كإضافة

134
00:10:23,080 --> 00:10:24,590
!في الحقيقة، أنا متأكّد من ذلك

135
00:10:24,950 --> 00:10:28,850
!مرحى! جميل! شكراً

136
00:10:28,310 --> 00:10:30,400
!الأمير لويد! هذه ليست فكرة جيّدة

137
00:10:30,400 --> 00:10:32,600
...ما زال بإمكاني إضافة المزيد... قليلاً فقط

138
00:10:36,570 --> 00:10:38,670
...حاولتُ تحذيرك

139
00:10:41,370 --> 00:10:43,400
!كانت النّتيجة سليمة بطريقة ما

140
00:10:41,440 --> 00:10:44,020
!بالكاد فعلتُها! انتهيت

141
00:10:44,020 --> 00:10:45,970
!مرحى

142
00:10:45,970 --> 00:10:47,420
!النّهاية

143
00:10:59,090 --> 00:11:00,300
!إنّه ذئب الدبّ

144
00:11:00,300 --> 00:11:01,550
!انتبهوا على أنفسكم

145
00:11:01,550 --> 00:11:03,660
!ابقوا بعيدين وانتظروا ثغرة

146
00:11:03,660 --> 00:11:05,960
سموّ الأمير لويد، ابقَ خلفي

147
00:11:05,960 --> 00:11:06,810
!حسناً

148
00:11:10,760 --> 00:11:13,370
الذّئاب الدّببة سريعة جدّاً رغم
!ضخامة حجمها

149
00:11:13,370 --> 00:11:14,570
أليس كذلك يا غريم؟

150
00:11:15,220 --> 00:11:16,280
ما الأمر؟

151
00:11:18,170 --> 00:11:21,830
ذلك المزار المنهار... أيُعقَل...؟

152
00:11:27,880 --> 00:11:29,070
!شكراً على ذلك

153
00:11:32,060 --> 00:11:33,590
!إنّه قويّ

154
00:11:41,090 --> 00:11:43,270
آسف يا ذئب الدبّ

155
00:11:43,270 --> 00:11:47,850
المسألة ليست شخصيّة، لكن سكّان القرية
المحلّيين يعانون بسببك

156
00:11:48,620 --> 00:11:51,370
...لأجل سلام سالوم

157
00:11:53,570 --> 00:11:55,090
!كُرة النّار الملتهبة

158
00:12:09,110 --> 00:12:11,060
!أحسنت صنعاً يا سموّ الأمير آلبيرت

159
00:12:11,060 --> 00:12:13,820
!يا لها من قوّة ناريّة! هزمه بطلقة واحدة فقط

160
00:12:14,160 --> 00:12:17,750
لا، في العادة لا تكون بتلك القوّة

161
00:12:18,510 --> 00:12:22,570
كان ذلك مُمكناً بفضل الافتتان
الّذي استخدمه لويد

162
00:12:23,720 --> 00:12:27,740
فعلناها يا لويد! أنت مذهل حقّاً

163
00:12:26,300 --> 00:12:29,590
يبدو أنّ الافتتان الإضافي للسّيف المسحور
!الخاصّ بآلبيرت قد نجح

164
00:12:29,590 --> 00:12:33,490
...اِنسَ ذلك. سموّ الأمير لويد، تذكّرتُ للتو

165
00:12:34,620 --> 00:12:37,930
...في السّابق، ذلك المكان أعلى تلك التلّة

166
00:12:37,930 --> 00:12:40,360
!ثمّة شيطان مختوم في ذلك المزار

167
00:12:48,610 --> 00:12:49,910
...ما

168
00:12:50,630 --> 00:12:53,760
كيف لا يزال الوحش الّذي هزمتُه واقفاً؟

169
00:12:56,870 --> 00:13:00,130
من أين أتى بقيّتهم؟

170
00:13:02,450 --> 00:13:05,180
...أيُّها الفانون الصّاغرون

171
00:13:05,180 --> 00:13:09,390
كيف تجرؤون على أذيّة أحد أتباعي؟

172
00:13:15,460 --> 00:13:18,100
!أنا الشّيطان، بازوزو

173
00:13:18,530 --> 00:13:23,520
وستدفعون ثمن خطيئتكم أرواحَكم

174
00:13:24,670 --> 00:13:26,770
!يوجد شيطانٌ داخل فمه؟

175
00:13:27,240 --> 00:13:28,350
اقضوا عليهم

176
00:13:39,410 --> 00:13:40,400
!ماذا؟

177
00:13:44,740 --> 00:13:48,840
!هذه مُصيبة حقّاً! يتجدّدون فوراً

178
00:13:48,840 --> 00:13:49,790
بالفعل

179
00:13:53,650 --> 00:13:57,030
من الواضح أنّ هؤلاء مختلفون عن ذئاب
...الدبّ الّذين التقيتُهم سابقاً

180
00:13:59,530 --> 00:14:01,700
يبدو أنّ بعضهم مُهجّنون أيضاً

181
00:14:02,370 --> 00:14:06,070
أعتقد بأنّ الشّيطان الّذي يتحكّم
!بهم هو من يقف وراء هذا

182
00:14:07,810 --> 00:14:10,380
إذاً، بازوزو ذاك هو الشّيطان الّذي
،خُتِم عليه في ذلك المزار

183
00:14:10,380 --> 00:14:12,300
والّذي تمكّن من الهرب

184
00:14:12,300 --> 00:14:15,000
كلاكما شيطانان، هل تعرفه أو ما شابه؟

185
00:14:15,000 --> 00:14:17,590
...لا. لكن هذا واضح

186
00:14:17,590 --> 00:14:21,610
إنّه يحوّل المانا خاصّته كي يتحكّم بالوحوش

187
00:14:21,610 --> 00:14:22,920
هكذا إذاً؟

188
00:14:24,550 --> 00:14:28,520
هذا أشبه بصنع خيوط من المانا تدعك
...تتحكّم بشخص كما الدُّمية

189
00:14:28,520 --> 00:14:33,970
المانا المُتحوِّلة تجعل الذّئاب الدّببة
يعتقدونه قائدهم أو ما شابه

190
00:14:34,410 --> 00:14:36,670
لهذا يطيعونه

191
00:14:36,930 --> 00:14:40,890
ليس ذلك فقط، لكن يمكنه تزويد
،المانا من خلال الخيوط

192
00:14:40,890 --> 00:14:43,190
ممّا يسمح لهم بالتجدُّد هكذا

193
00:14:43,190 --> 00:14:46,190
...ما لم يسقط بازوزو، لن ينتهي هذا

194
00:14:49,690 --> 00:14:51,940
!علّمني تحويل المانا

195
00:14:51,940 --> 00:14:53,690
!ماذا؟ الآن؟

196
00:14:56,010 --> 00:14:58,340
افعلي شيئاً بسرعة

197
00:14:58,340 --> 00:15:00,930
!بوسعكِ المساعدة

198
00:15:01,320 --> 00:15:03,740
...لا أعتقد أنّ الوقت مناسب لذلك

199
00:15:03,740 --> 00:15:06,870
الآخرون يقاتلون وأرواحهم على المحكّ

200
00:15:06,870 --> 00:15:09,080
!لا مشكلة، تعال الآن

201
00:15:10,720 --> 00:15:12,840
!ضعفاء، ضعفاء جدّاً

202
00:15:13,480 --> 00:15:16,890
...رغم أنّ بعضكم قد يمتلك المهارة

203
00:15:17,200 --> 00:15:19,930
لكن بقيّتكم عديمو القيمة
ولا يخلّصكم سوى أسلحتكم

204
00:15:19,930 --> 00:15:23,430
بالإضافة إلى طفل رضيع مثير
!للشّفقة هو وحاضنته

205
00:15:24,690 --> 00:15:27,330
!ما مشكلة هذا الطّفل الصّغير؟

206
00:15:27,330 --> 00:15:29,780
!هل تبوّل على حفاضه من شدّة الخوف؟

207
00:15:29,780 --> 00:15:34,080
لا بدّ أنّ الاعتناء بكتلة لحم تافهة
!كهذه مُرهِق للغاية

208
00:15:41,710 --> 00:15:45,380
...سموّ الأمير لويد، اعذرني لحظة لو سمحت

209
00:15:45,380 --> 00:15:46,710
افعلي ما تشائين

210
00:15:52,380 --> 00:15:53,920
ماذا؟

211
00:15:55,280 --> 00:15:58,800
هل قرّرتِ التخلّي عن الجرو التّافه وخدمتي؟

212
00:15:59,170 --> 00:16:03,550
...موافق! سوف أضمّكِ إلى أتباعي

213
00:16:02,410 --> 00:16:08,800
أتباع كتلك السجّادة الشّعثاء الضّخمة
الّتي تختبئ فيها؟

214
00:16:08,800 --> 00:16:09,820
ماذا؟

215
00:16:10,100 --> 00:16:13,020
...رائحتها كريهة لدرجة أنّ أنفي يكاد يسقط

216
00:16:13,020 --> 00:16:16,570
من ناحية أخرى، ربّما تكمن المشكلة الحقيقيّة
داخل أنفاس ذلك القرد الغبيّ

217
00:16:17,200 --> 00:16:19,660
أنت تلوّث هواء الأمير لويد النّقيّ

218
00:16:22,360 --> 00:16:24,570
لذا سوف أقتلك

219
00:16:35,730 --> 00:16:37,260
!يا للحماقة

220
00:16:37,670 --> 00:16:43,480
!الذّئب الدبّ الّذي حرقتموه قد شُفي كلّياً

221
00:16:43,480 --> 00:16:44,980
هل تفهمون؟

222
00:16:44,980 --> 00:16:48,260
...ما دمتُ أحوّل المانا خاصّتي إليهم

223
00:16:48,260 --> 00:16:53,030
!سيتجدّد أتباعي بلا نهاية

224
00:16:53,460 --> 00:16:56,020
لا تتأمّلوا أن تنفد الكمّية لديّ أيضاً

225
00:16:56,020 --> 00:16:59,390
!الشّياطين لديهم مانا غير محدودة

226
00:17:02,030 --> 00:17:07,910
—لا داعي للانزعاج. لن تنجوا مهما بكيتم

227
00:17:07,910 --> 00:17:10,430
لا، إنّها الرّائحة فقط. أنفاسك

228
00:17:10,770 --> 00:17:12,740
هلّا توقّفت عن الكلام رجاء؟

229
00:17:21,700 --> 00:17:22,840
!سيلفا

230
00:17:31,200 --> 00:17:33,580
...لستُ أبالي، لكن

231
00:17:33,850 --> 00:17:37,420
ربّما يجدر بك أن تتخلّص من الفراء

232
00:17:37,420 --> 00:17:40,200
لن تتمكّن من مُجاراة السّرعة على هذا المُعدّل

233
00:17:40,510 --> 00:17:42,550
!...اللّعنة عليكِ

234
00:17:50,660 --> 00:17:54,420
ما هذا؟ توقّفوا عن الحركة فجأة كذلك

235
00:17:54,840 --> 00:17:57,590
!إنّهم يتجدّدون ببطء أكثر أيضاً

236
00:17:57,590 --> 00:17:58,840
!هكذا إذاً

237
00:17:58,840 --> 00:18:03,360
يركّز الشّيطان المانا خاصّته على تجديد
!ذئب الدبّ الخاصّ به بدلاً من ذلك

238
00:18:03,760 --> 00:18:06,610
!عندما يُجرَح، تكون لدينا فُرصة

239
00:18:07,080 --> 00:18:12,350
سيلفا! ألحقي الضّرر بالشّيطان قدر المستطاع
!حتّى نتمكّن من الانضمام لكِ

240
00:18:14,280 --> 00:18:15,600
كما سمعته

241
00:18:15,880 --> 00:18:17,280
!كلام فارغ

242
00:18:18,350 --> 00:18:23,870
وهكذا، كما أظهرتُ لك، تحويل المانا
خاصّتك هو عمل دقيق جدّاً

243
00:18:24,240 --> 00:18:26,430
،لا بدّ أنّ بازوزو هناك يتقنه جيّداً

244
00:18:26,430 --> 00:18:29,900
لأنّه لديه المانا المضبوط على طبيعة
،تلائم الوحوش

245
00:18:29,900 --> 00:18:32,510
...ممّا يساعده في الحفاظ على السّيطرة عليهم

246
00:18:32,880 --> 00:18:37,160
واسمح لي أن أخبرك، هذه ليست بالمهمّة
السّهلة، حتّى بالنّسبة لشيطان

247
00:18:38,150 --> 00:18:42,210
يمكنك البدء بشي أساسيّ كأن
تضفي لوناً إلى المانا خاصّتك

248
00:18:42,210 --> 00:18:44,890
...بعد ذلك يأتي صياغتها، وإضافة الرّوائح

249
00:18:44,890 --> 00:18:46,270
!انتهيت

250
00:18:46,270 --> 00:18:48,140
بهذه السّرعة؟

251
00:18:48,470 --> 00:18:52,700
جعلتُها ورديّة! على شكل زهرة
!وأضفتُ رائحة

252
00:18:53,570 --> 00:18:56,650
!كيف جعلتها مثاليّة بهذه السّرعة؟
!اللّعنة

253
00:18:56,650 --> 00:18:58,090
...شمّ، شمّ

254
00:19:00,750 --> 00:19:02,350
!رائحة طيّبة

255
00:19:03,410 --> 00:19:05,900
!كيف؟

256
00:19:10,250 --> 00:19:14,000
أستميحك عذراً، لكن هل يمكنني
استعارة سيفك؟

257
00:19:16,690 --> 00:19:19,540
ما... ما هذه الخادمة؟

258
00:19:19,850 --> 00:19:22,700
!وكأنّها لا تترك أي ثغرة

259
00:19:22,700 --> 00:19:26,820
كيف لشخص موهوب مثلها
!أن يكون مجرّد حاضنة؟

260
00:19:30,140 --> 00:19:34,050
...هذه إحدى السّيوف الّتي فتنَها الأمير لويد

261
00:19:34,600 --> 00:19:35,950
!انتهيت

262
00:19:36,820 --> 00:19:39,080
...أنا فخورة جدّاً به

263
00:19:42,320 --> 00:19:47,420
يراودني فضول الآن بشأن هذا الطّفل الشّقيّ
!الّذي أنتِ مستميتة لحمايته

264
00:19:47,420 --> 00:19:56,010
في البداية سوف أشرّحه، ثمّ سأفحص
!أعضاءه الحيويّة الدّاخليّة، قطعة قطعة

265
00:19:56,010 --> 00:20:03,140
صحيح أنّ كلّ ما سأجده غالباً هو
مجموعة من كتل اللّحم غير النّاضجة

266
00:20:11,380 --> 00:20:16,490
لماذا البشر أغبياء جدّاً! يقعون
—ضحيّة استفزاز بِدائي كهذا

267
00:20:16,710 --> 00:20:18,100
...عمّن

268
00:20:21,100 --> 00:20:24,340
عمّن... تعتقد بأنّك كنت تتكلّم للتو؟

269
00:20:33,420 --> 00:20:38,370
:بيت لانغليس، فنّ النّصل المزدوج
صعود تنّينَي التّوأم

270
00:20:39,170 --> 00:20:40,370
...ما

271
00:20:40,630 --> 00:20:44,630
:متبوعاً ببيت لانغليس، فنّ النّصل المزدوج

272
00:20:50,740 --> 00:20:52,340
عصفور الغوص

273
00:20:58,040 --> 00:21:02,390
!أنتِ مجرّد خادمة

274
00:21:12,920 --> 00:21:15,670
:بيت لانغليس، فنّ النّصل المزدوج

275
00:21:19,000 --> 00:21:20,580
!النّمر المزدوج، مخلب وناب

276
00:21:26,280 --> 00:21:28,680
...يبدو أنّني كشفتُ أخيراً

277
00:21:28,680 --> 00:21:31,170
أحشاءك العفِنة

278
00:21:36,940 --> 00:21:39,220
...هذه هي سيلفا عندما تصبح جادّة إذاً

279
00:21:41,940 --> 00:21:43,240
تمّ الحفظ

280
00:21:45,640 --> 00:21:49,200
...فكرة أن تقوم كتلة أحشاء شائنة مثلك

281
00:21:49,560 --> 00:21:52,910
بلمس الأمير لويد حتّى كافية
لإثارتي على الضّحك

282
00:21:55,030 --> 00:21:59,990
...الشّيء الوحيد الّذي تستحقّ الشّعور به
هو سيف مُعلّمي

283
00:23:35,560 --> 00:23:37,980
!أخيراً، تحقّق طموحي

284
00:23:37,980 --> 00:23:41,390
بوضع سيّافة فضّية الشّعر ومُمارِسة
،فنون قتاليّة تحت سيطرتي

285
00:23:41,390 --> 00:23:43,460
يحين وقت فريق النّساء الورديّات
!الخاصّ ببازوزو

286
00:23:43,460 --> 00:23:44,190
:الحلقة القادمة، الحلقة 5

287
00:23:44,190 --> 00:23:46,050
"الشّيطان غاضب"

288
00:23:46,050 --> 00:23:48,580
!ستشهدون أعماق السّحر