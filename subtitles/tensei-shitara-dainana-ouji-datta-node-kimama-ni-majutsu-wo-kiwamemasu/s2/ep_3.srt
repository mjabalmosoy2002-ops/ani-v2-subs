1
00:00:05,800 --> 00:00:09,360
شعوذة فئة التجسُّد الإلَهيّة: كوبو

2
00:00:15,200 --> 00:00:17,130
كم هذا عمليّ

3
00:00:15,690 --> 00:00:19,370
لا أصدّق بأنّني أُجبِرتُ على منح الشّعوذة
الإلهيّة لهؤلاء الحمقى

4
00:00:17,130 --> 00:00:18,450
جميعها أمستْ مُختلفة

5
00:00:18,450 --> 00:00:20,750
رأيتُ لغة ما لم أستطع قراءتها

6
00:00:19,800 --> 00:00:21,190
لا يروقني هذا بصراحة

7
00:00:21,430 --> 00:00:26,160
بحثي حول السّحر الإلهيّ سيحرز تقدُّماً
أكبر مع مُستخدمين عديدين

8
00:00:26,160 --> 00:00:29,730
تابع واخلق طريقاً للجميع وذلك كي
لا يحتاجوا لإجراء طقوس

9
00:00:30,410 --> 00:00:32,730
،لعلّي قدّمتُ لك استثناء أيّها الأمير لويد

10
00:00:32,730 --> 00:00:35,090
لكن لم أفعل ذلك إلّا لشخص واحد
—في تاريخ

11
00:00:34,320 --> 00:00:37,330
وأيضاً، أنت تُلفت الأنظار كثيراً هكذا

12
00:00:37,330 --> 00:00:39,480
ألا يمكنك أن تنكمش أكثر مثل غريم؟

13
00:00:40,110 --> 00:00:44,320
أتريدني أن أتّخذ هيئة الغريملين
!الفظيعة هذه أيّها الأمير لويد؟

14
00:00:44,320 --> 00:00:46,720
أجل، كما سمعت. هيّا، بسرعة

15
00:00:46,720 --> 00:00:51,170
أم أنّك تريد أن تقول لي بأنّك لا تُجيد
أساسيّات التحوُّل؟

16
00:00:51,170 --> 00:00:52,230
هل هذا لأنّك أحمق؟

17
00:00:52,230 --> 00:00:53,980
!كيف تجرؤ أيّها الشّيطانيّ الأحمق؟

18
00:00:54,560 --> 00:00:58,370
فلتشهدوا الفخامة الإلهيّة الّتي
!يتحوّل إليها ملاك

19
00:01:00,350 --> 00:01:02,350
ما رأيك أيّها الأمير لويد؟

20
00:01:02,350 --> 00:01:05,110
تعتريك رغبة في مُعانقتي، أليس كذلك؟

21
00:01:05,110 --> 00:01:07,190
تفضّل يا لويد

22
00:01:08,940 --> 00:01:10,350
إنّه لا ينظر حتّى

23
00:02:43,950 --> 00:02:48,760
إذاً إنشاد إيشر بأكمله كان
شعوذة إلهيّة أيضاً، صحيح؟

24
00:02:48,760 --> 00:02:51,890
أجل. شعوذة إلهيّة من فئة تطهير

25
00:02:51,890 --> 00:02:56,880
تشفي الجروح، وكذلك طرد الأحياء الموتى
والأثيريّين والشّياطين

26
00:02:57,180 --> 00:02:58,310
...الأحياء الموتى

27
00:03:01,060 --> 00:03:03,340
عدنا يا زعيم

28
00:03:03,340 --> 00:03:06,140
...أشعر وكأنّني رأيتُ حلماً سيّئاً

29
00:03:07,800 --> 00:03:10,550
!أنت ذلك الطّفل المزعج من الكنيسة

30
00:03:10,550 --> 00:03:13,280
أنتما من لوردوست؟

31
00:03:14,290 --> 00:03:16,720
!قُضي عليك الآن بعد أن عثرنا عليك

32
00:03:16,220 --> 00:03:18,680
!لنركل مؤخّرته النّحيلة يا زعيم

33
00:03:20,420 --> 00:03:21,570
!زعيم؟

34
00:03:21,570 --> 00:03:23,410
،لستُ مُطّلعاً على التّفاصيل

35
00:03:23,670 --> 00:03:26,610
لكن آمل أن تكون إصبع واحدة
كافية للتّعويض عن ذلك

36
00:03:26,610 --> 00:03:28,050
مهلاً، مهلاً، لا داعي لذلك الآن

37
00:03:28,050 --> 00:03:30,560
آسفة بشأنهم يا لويد

38
00:03:30,560 --> 00:03:33,420
شعب لوردوست مُشاغبون جدّاً

39
00:03:33,420 --> 00:03:36,320
لحسن الحظّ، التّسلسل الهرميّ هنا
يُحدَّد بواسطة الأقوى

40
00:03:36,320 --> 00:03:37,970
ممّا يُوفّر علينا الكثير من العناء

41
00:03:37,970 --> 00:03:42,310
الزّعيمة الآنسة تاليا والزّعيم كرو، لماذا
!تتعاملان بلطف مع هذا القزم؟

42
00:03:42,310 --> 00:03:44,930
!إن لم يفعلوا شيئاً، فسنفعل نحن إذاً

43
00:03:44,930 --> 00:03:47,440
!اتلُ صلاوتك أيّها القزم الأحمق

44
00:03:47,780 --> 00:03:49,000
!وهج

45
00:03:51,740 --> 00:03:54,640
!نحن آسفان حقّاً بشأن ما حدث

46
00:03:55,450 --> 00:03:57,670
!أجل! أجل! آسفان حقّاً

47
00:03:56,490 --> 00:03:59,140
هل أنا أتوهّم أم أنّ هذا الثّنائي
!ألغيا شخصيّتهما تماماً؟

48
00:03:59,140 --> 00:04:03,220
،لا تكون بهذه الفعاليّة في العادة
لكن الخاصّة بالأمير لويد استثنائيّة

49
00:04:03,220 --> 00:04:06,260
نعلم بأنّ ما فعلناه لم يكن جيّداً

50
00:04:06,260 --> 00:04:08,650
سنذهب ونعتذر من الأخت الآن

51
00:04:09,110 --> 00:04:12,460
ما قصّة الاعتذار هذه من الأخت؟

52
00:04:12,460 --> 00:04:17,620
حاول هذان الشّخصان فعل شيء
بإيشر والأميرة ساريا

53
00:04:19,990 --> 00:04:23,140
!ماذا فعلا بإيشر وساريا؟

54
00:04:23,140 --> 00:04:24,960
كان هناك بعض المُداعبة وما شابه أيضاً

55
00:04:24,960 --> 00:04:27,500
!مُـ-مُـ-مُداعبة؟

56
00:04:27,770 --> 00:04:31,120
أيّها السّافلان! حان وقت العقوبة
!الإلهيّة، عقوبة قاتلة

57
00:04:31,120 --> 00:04:36,570
دعني! أريد إنزال العقاب عليهم
!بأكثر طريقة مُؤلمة

58
00:04:31,260 --> 00:04:35,740
لحظة، رين وبابيلون لم يعرفا
هؤلاء الأشخاص إطلاقاً

59
00:04:35,740 --> 00:04:38,170
،كانت رين تعيش في القلعة
،لذا من الطّبيعيّ ألّا تعلم

60
00:04:36,570 --> 00:04:39,910
طرفاً تِلو الطّرف! ستُقطَّع أطرافهم كلّ
!واحد على حِدة، تبّاً

61
00:04:38,170 --> 00:04:41,100
وبابيلون يتكتّم حول ما يخصّ مُواطني الجزيرة

62
00:04:39,910 --> 00:04:43,500
!ثمّ سأعيدها وأنتزعها مرّة أخرى
!أسمعتما أيّها الحثالة؟

63
00:04:41,100 --> 00:04:43,510
أين هو على أيّ حال؟

64
00:04:43,510 --> 00:04:46,640
...يُنظّف مُخلّفات الأمير لويد

65
00:04:47,390 --> 00:04:49,230
!شهيّ

66
00:04:50,060 --> 00:04:52,950
!مهلاً! تحلّينَ ببعض آداب السّلوك

67
00:04:52,950 --> 00:04:54,980
!مذاقه مُذهل حقّاً

68
00:04:54,980 --> 00:04:57,880
يسرّني أنّك قرّرت البقاء يا بابيلون

69
00:04:59,240 --> 00:05:02,730
...نظراً لهرب الأمير بعد يوم واحد

70
00:05:07,280 --> 00:05:09,890
ستتمكّن لآن من استخدام الشّعوذة الإلهيّة أيضاً

71
00:05:10,250 --> 00:05:12,840
تولّ زمام الأمور هنا يا بابيلون

72
00:05:17,130 --> 00:05:19,960
الأمير لويد. أهلاً بعودتك

73
00:05:19,960 --> 00:05:22,340
الأمير لويد، ما رأيك أن تنضمّ إليّ في الحمّام؟

74
00:05:22,340 --> 00:05:25,070
!الأمير لويد، ينبغي أن تنام معي اللّيلة

75
00:05:25,070 --> 00:05:29,550
لـ-لـ-لم أكن أعلم بأنّ لديك كلّ هذه
!الشّعبيّة يا حضرة الأمير لويد

76
00:05:29,820 --> 00:05:34,300
!هذه هي حياة الأمير؟! الأمير السّابع؟
!إنّه النّعيم

77
00:05:34,300 --> 00:05:36,960
!اتّخذتُ القرار الصّحيح بالبقاء معك

78
00:05:38,760 --> 00:05:41,610
إذا أردت العيش هنا، فأبقِ مؤخّرتك هنا

79
00:05:39,380 --> 00:05:44,450
!دماء! أنا أنزف

80
00:05:42,830 --> 00:05:44,450
أنا ذاهب لاحتساء بعض الشّاي

81
00:05:45,810 --> 00:05:47,460
!هناك اثنان من الأمير لويد؟

82
00:05:47,460 --> 00:05:50,690
هذه الدّمية الخشبيّة الّتي صنعها
الأمير لويد من نفسه

83
00:05:50,690 --> 00:05:53,330
تستطيع مُعالجة أمور بسيطة تلقائيّاً

84
00:05:51,970 --> 00:05:53,530
فنجان واحد وطبقان طائران صغيران آخران

85
00:05:56,860 --> 00:05:58,590
فهمت، فهمت

86
00:05:58,590 --> 00:06:02,850
إذاً أنت دُمية. أجوف تماماً من الدّاخل

87
00:06:03,500 --> 00:06:04,800
!أيّها الملاك الأحمق

88
00:06:04,800 --> 00:06:08,300
أنا مُولَع بهذا الصّغير، لذا إن كنت
!لا تُريد الموت، فكفّ عنه

89
00:06:09,760 --> 00:06:11,440
صيد الغول؟

90
00:06:11,440 --> 00:06:16,720
أجل. الغيلان الأحياء الموتى هم المادّة المثاليّة
إذا أردنا تطبيق الشّعوذة الإلهيّة

91
00:06:17,130 --> 00:06:20,230
هل يوجد الكثير من الغيلان هناك؟

92
00:06:20,230 --> 00:06:23,380
في الواقع حصلتُ على بعض المعلومات
...أثناء رحلتنا إلى لوردوست مفادها

93
00:06:25,520 --> 00:06:26,490
!تفضّل

94
00:06:29,860 --> 00:06:31,520
هل ناديتني؟

95
00:06:31,520 --> 00:06:36,080
،أجل! إن لم يكن لديكِ شيء تفعلينه
ما رأيكِ بالانضمام لي في صيد غيلان؟

96
00:06:42,990 --> 00:06:45,300
يا لها من مُثيرة! تروقني

97
00:06:48,480 --> 00:06:49,860
!أنا مُتفرّغة

98
00:06:58,580 --> 00:07:02,280
!هذا الجسر ضخم! وهناك الكثير من النّاس

99
00:07:02,280 --> 00:07:07,150
إنّه جسر دين العظيم، محور المرور الّذي
يربط الشّرق بالغرب في المدينة

100
00:07:07,470 --> 00:07:10,140
رغم ذلك، من الصّعب بعض الشّيء تصديق

101
00:07:10,740 --> 00:07:16,190
أنّ الغيلان يقبعون في جزء
...مُزدهر من البلدة

102
00:07:16,190 --> 00:07:21,400
تلقّتْ نقابة المُغامرين أكبر عدد شهادات
عن رؤيتهم في هذه المنطقة

103
00:07:21,400 --> 00:07:24,380
لا يمكن تعقّب عرشهم من الرّائحة فقط؟

104
00:07:25,220 --> 00:07:28,170
نظراً إلى أنّ رائحتهم تُشبه رائحة
،اللّحم الفاسد

105
00:07:28,170 --> 00:07:31,800
في المناطق المأهولة، من الصّعب
تمييز الرّائحة عن نفايات الطّعام

106
00:07:31,800 --> 00:07:36,400
وكشفي الطّيفي لن يكون مُفيداً
نظراً للازدحام الكبير

107
00:07:36,400 --> 00:07:38,430
!لويد

108
00:07:38,920 --> 00:07:41,810
إيشر؟ وساريا

109
00:07:41,810 --> 00:07:46,000
من دون حارس شخصيّ ثانية. ما الّذي
جاء بكما إلى البلدة اليوم؟

110
00:07:46,000 --> 00:07:49,160
قرّرنا تناول بعض البانكيك اللّذيذ على الغداء

111
00:07:49,160 --> 00:07:50,450
هل تريدون الانضمام لنا؟

112
00:07:50,450 --> 00:07:53,330
!الأمير لويد! هيّا بنا! ينبغي أن نذهب

113
00:07:53,330 --> 00:07:54,830
لدينا أمور يجب فعلها، تبّاً

114
00:07:55,780 --> 00:07:56,970
لويد؟

115
00:07:57,320 --> 00:07:59,780
!بانكيك

116
00:08:07,430 --> 00:08:09,210
يا لها من صدمة

117
00:08:09,210 --> 00:08:10,910
هذه أوّل مرّة أراك فيها

118
00:08:10,910 --> 00:08:12,850
مُتحمّساً لشيء مثلما أنت تجاه
السّحر يا أمير لويد

119
00:08:12,850 --> 00:08:16,360
غريم، البانكيك هي سحر

120
00:08:17,890 --> 00:08:20,960
قوامها المنفوش المليء بهواء
...من اللّذّة والشّهيّة

121
00:08:20,960 --> 00:08:24,780
مع إضافة زينة فوقيّة من قَطر العسل
وزبدة غنيّة تتزامن مع بعضها الآخر

122
00:08:24,780 --> 00:08:28,710
بينما تُسبّب الرّائحة النّاشئة التواءة
...لا إراديّة في زوايا الفم

123
00:08:28,710 --> 00:08:30,850
...لتُحفّز الغدد اللّعابيّة بشكل مُفرط

124
00:08:30,850 --> 00:08:33,340
إن لم يكن ذلك سحراً، فما يكون؟

125
00:08:33,340 --> 00:08:34,610
!معك حقّ

126
00:08:34,970 --> 00:08:39,770
،لويد، إذا كانت هذه أوّل مرّة تأكل البانكيك فيها هنا
فابدأ بطلبها سادة

127
00:08:39,770 --> 00:08:42,200
تحتاج بلا شكّ النّكهة الأساسيّة كذا كذا كذا

128
00:08:42,200 --> 00:08:43,920
!بلا أدنى شكّ يا أختي العزيزة ساريا

129
00:08:43,920 --> 00:08:47,170
الزّينة الفوقيّة هي كذا كذا كذا للبانكيك نفسها

130
00:08:47,170 --> 00:08:49,950
...وحتّى أنّهما يحبّان نفس الأطعمة

131
00:08:50,750 --> 00:08:52,480
تفضّلوا وكلوا

132
00:08:53,220 --> 00:08:58,640
ما هذا حتّى؟! طريقة نفشها داخل
...فمك قبل أن تذوب

133
00:08:58,640 --> 00:09:02,350
سيلفا، هل تعتقدين بأنّنا نستطيع
البدء بتقديم هذا في القلعة؟

134
00:09:02,350 --> 00:09:05,610
بالطّبع!  أعِدُ بأنّني سأنسخ الوصفة

135
00:09:05,610 --> 00:09:09,170
على ذكر الأمر، لم تذكروا أبداً ما الّذي
كنتُم تفعلونه جميعاً في البلدة اليوم

136
00:09:09,170 --> 00:09:10,400
...في الواقع

137
00:09:11,530 --> 00:09:13,200
نصطاد غيلان

138
00:09:14,650 --> 00:09:16,740
هل سمعت أيّ شيء يا إيشر؟

139
00:09:16,740 --> 00:09:21,830
كان هناك الكثير من النّاس يلجؤون إلى الكنيسة
بعد تعرّضهم لهجوم بواسطة غيلان

140
00:09:21,830 --> 00:09:24,390
مُعظم الرّؤى تمحورتْ حول جسر دين العظيم

141
00:09:24,390 --> 00:09:27,420
المقبرة الشّماليّة الكبيرة، والأزقّة في الجنوب

142
00:09:27,800 --> 00:09:32,630
وبعض المُغامرين الّذين أُرسِلوا للتّعامل
مع الأمر قد فُقِدوا كذلك

143
00:09:32,630 --> 00:09:34,680
مُغامرون مفقودون؟

144
00:09:38,750 --> 00:09:40,020
...بالنّسبة لي

145
00:09:40,700 --> 00:09:44,180
كلّ ما أهتمّ لأمره هو عدم إلغاء الإنشاد

146
00:09:44,480 --> 00:09:46,960
!هل ستؤدّيان إنشاداً آخر؟

147
00:09:46,960 --> 00:09:49,690
!هذه المرّة سيكون أفضل حتّى

148
00:09:49,990 --> 00:09:53,910
،إنّه في اليوم الّذي يحتفل بولادة إله
مهرجان المجيء العظيم

149
00:09:53,910 --> 00:09:57,190
!كلّاً من الملك والبابا سيكونان حاضرين

150
00:09:57,640 --> 00:09:59,950
حبّذا لو تنضمّون إليّ جميعاً

151
00:10:01,000 --> 00:10:04,000
...هذا إن كان من المُمكن إقامته

152
00:10:09,100 --> 00:10:13,280
!حسناً! سوف نتخلّص من أولئك الغيلان

153
00:10:13,280 --> 00:10:15,260
يبدو أحدهم مُتحفّزاً

154
00:10:19,260 --> 00:10:24,320
...الأغاني الّتي يغنّيها الجميع
...متاجر البانكيك الشّهيّة

155
00:10:24,320 --> 00:10:27,630
...بعد رؤية الكثير ممّا لم أكن أعرفه في السّابق

156
00:10:28,260 --> 00:10:33,640
!أعشق هذا البلد، ولا أريد أحداً أن يؤذيها

157
00:10:35,890 --> 00:10:40,290
حسناً، بخصوص وكر الغيلان، قلّصنا نطاق
أهدافنا بشكل كبير

158
00:10:40,290 --> 00:10:44,200
يبدو أنّ جسر دين العظيم هو أكثر
مكان شُوهِدت فيه الغيلان

159
00:10:44,200 --> 00:10:49,110
لكنّني لا أستطيع تخيُّل وكر غيلان
في مكان كهذا حقّاً

160
00:10:52,620 --> 00:10:53,790
...لا تنظروا للأعلى

161
00:10:54,590 --> 00:10:55,830
!إنّما للأسفل

162
00:10:58,550 --> 00:11:01,720
تحت الجسر، عند المدخل المُؤدّي
إلى المجارير

163
00:11:01,720 --> 00:11:04,100
حسناً، أمسى هذا واضحاً بعد أن وصلنا إلى هنا

164
00:11:04,100 --> 00:11:05,570
كيف الرّائحة؟

165
00:11:08,140 --> 00:11:11,610
يستحيل التّمييز. أشعر وكأنّ أنفي سينهار

166
00:11:11,970 --> 00:11:15,610
لكن من المُؤكّد أنّه يوجد شيء فاسد في الدّاخل

167
00:11:15,610 --> 00:11:20,090
سيترتّب علينا فقط الدّخول والتفقّد. أنا
قلق بعض الشّيء بخصوص شيء سمعتُه

168
00:11:20,090 --> 00:11:23,870
فيما يخصّ المُغامرين المفقودين؟

169
00:11:23,870 --> 00:11:25,630
هل هو شخص تعرفه؟

170
00:11:25,980 --> 00:11:32,390
في الواقع، سبب معرفتي بهؤلاء الغيلان
...هو لأنّها حضرَتْ حفلتنا

171
00:11:32,810 --> 00:11:36,670
غالباً سبقَتْنا، كجزء من العمل، لذا أنا قلق

172
00:11:36,670 --> 00:11:38,090
...هل يُعقَل

173
00:11:38,090 --> 00:11:40,420
إذا كان شخصاً وقحاً لدرجة

174
00:11:40,420 --> 00:11:42,830
يدعو فيها أمير دولة إلى عمليّة
—صيد غيلان، فإذاً

175
00:11:43,480 --> 00:11:45,170
!لويد

176
00:11:45,170 --> 00:11:47,980
تاو! أنتِ بخير

177
00:11:49,590 --> 00:11:52,390
هل كنتَ قلقاً عليّ؟

178
00:11:52,390 --> 00:11:55,490
أنتِ ظريف قليلاً يا لويد

179
00:11:55,490 --> 00:11:58,740
!هل أردت رؤيتي بهذا الإلحاح؟

180
00:11:58,740 --> 00:12:00,160
...سيلفا

181
00:12:00,160 --> 00:12:01,160
ضربة قاطعة

182
00:12:02,710 --> 00:12:07,840
تولّى الأمير لويد عمليّة صيد الغيلان
هذه لاختبار شعوذته الإلهيّة

183
00:12:07,840 --> 00:12:09,450
أنتِ مُجرّد إضافة

184
00:12:09,450 --> 00:12:10,160
!إضافة؟

185
00:12:10,160 --> 00:12:15,530
،إذاً يا تاو، بما أنّكِ خرجتِ من المجارير
فهل هذا هو وكر الغيلان؟

186
00:12:11,980 --> 00:12:15,340
...إنّها مُثيرة جدّاً! قد تصبح أحد المُفضَّلات لديّ

187
00:12:15,340 --> 00:12:16,430
—تاو

188
00:12:15,530 --> 00:12:18,790
هذا ما ظننتُه، لكن لم أستطع إيجاد شيء

189
00:12:18,790 --> 00:12:21,630
...إنّه قذر ورائحته كريهة وقد تهتُ

190
00:12:20,790 --> 00:12:23,130
!أين أنا؟

191
00:12:21,630 --> 00:12:26,670
تطلّب الأمر الشّعور بوجودك لإيجاد
مخرجي من تلك المتاهة

192
00:12:23,850 --> 00:12:26,670
!لا بُدّ أنّه إمّا لويد أو روبيرت

193
00:12:27,160 --> 00:12:30,850
ليست بيئة مُناسبة للقدرة على التّركيز
على تحويل الكي

194
00:12:32,160 --> 00:12:34,220
سوف أعود إلى نُزُلي

195
00:12:34,220 --> 00:12:37,250
...سقطت منّي أشياء عديدة، مثل شعلتي

196
00:12:37,720 --> 00:12:39,860
لا. لن تكون تلك مُشكلة

197
00:12:40,660 --> 00:12:45,020
!شعوذة من فئة تطهير الإلهيّة: هيليوس

198
00:12:46,970 --> 00:12:50,720
معك حقّ! لا حاجة لشعلة الآن

199
00:12:50,720 --> 00:12:55,160
ولأنّ هيليوس مُطهِّر، يستطيع فعل أشياء أُخرى

200
00:12:58,040 --> 00:13:01,180
!كلّ التّربة... وإعيائي قد زالا أيضاً

201
00:13:01,790 --> 00:13:05,540
!ماء مجارير نظيف كجدول غابة نقيّ؟

202
00:13:05,540 --> 00:13:07,640
!ليس ذلك فقط

203
00:13:07,640 --> 00:13:12,550
!الهواء نظيف كسهل عصفتْ به الرّياح

204
00:13:13,590 --> 00:13:16,570
...هذا النّور قاسٍ عليّ بعض الشّيء

205
00:13:19,690 --> 00:13:24,560
بهواء نظيف كافٍ، يمكنني تعبئة
!رئتَي وتحويل الكي فعليّاً

206
00:13:24,560 --> 00:13:27,090
!تقنيّة الكي: الكشف الطّيفيّ

207
00:13:34,440 --> 00:13:37,110
!شكراً على غيار الملابس يا رين

208
00:13:37,460 --> 00:13:40,060
...إنّه ضيّق قليلاً من الأعلى، لكن

209
00:13:40,950 --> 00:13:43,780
حسناً إذاً، أين هو وكر الغيلان؟

210
00:13:43,780 --> 00:13:46,980
هذه المنطقة بأكملها تبدو مشبوهة

211
00:13:47,760 --> 00:13:51,090
سوف تطرد الغيلان؟

212
00:13:51,780 --> 00:13:53,650
كُن حذراً يا شيرو

213
00:13:53,650 --> 00:13:57,130
وحالما تخرج من نِطاق تعويذة هيليوس
...الخاصّة بالأمير لويد

214
00:13:58,890 --> 00:14:00,690
ستشتمّ رائحة كريهة

215
00:14:06,030 --> 00:14:09,090
بهذه الرّائحة الكريهة، حاسّة الشمّ
لدى شيرو سوف تُغمَر

216
00:14:09,090 --> 00:14:10,910
قد يستغرق هذا بعض الوقت

217
00:14:10,910 --> 00:14:13,720
أظنّني سأستخدم الكشف الطّيفيّ
لإجراء مسح للمنطقة أيضاً

218
00:14:15,490 --> 00:14:18,020
أمسكتُ بك بالجرم المشهود
!هذه المرّة يا لويد

219
00:14:18,020 --> 00:14:19,870
كان ذلك تنفُّس كي، أليس كذلك؟

220
00:14:19,870 --> 00:14:20,890
...تبّاً

221
00:14:20,890 --> 00:14:23,680
أين تعلّمت ذلك يا ترى؟

222
00:14:23,680 --> 00:14:24,950
سيلفا؟

223
00:14:27,480 --> 00:14:30,750
بالمُناسبة، لماذا لم تُحضري معك "هلاك الشّيطان"؟

224
00:14:30,750 --> 00:14:33,510
لا، أفضّل إبقاءه نظيفاً

225
00:14:33,760 --> 00:14:36,110
...ونظراً إلى أنّك طلبت منّي مُرافقتك

226
00:14:36,700 --> 00:14:39,800
أنا متأكّدة بأنّ هناك شيئاً آخر
تريدني أن أحمله

227
00:14:43,780 --> 00:14:47,780
أعتقد بأنّ هذه قد تكون الفُرصة المثاليّة

228
00:14:47,780 --> 00:14:49,550
لماذا بالضّبط؟

229
00:14:49,550 --> 00:14:53,200
لنرَ من الأقوى

230
00:14:53,200 --> 00:14:55,410
ما رأيكِ بحسم الأمر بلعبة صغيرة؟

231
00:14:55,410 --> 00:14:56,920
يا للسّخافة

232
00:14:57,210 --> 00:15:02,750
كما صرّحتُ سابقاً، هذه المهمّة هي كي يختبر
الأمير لويد شعوذته الإلهيّة

233
00:15:02,750 --> 00:15:04,460
—لن نحظى بوقت لذلك النّو

234
00:15:03,890 --> 00:15:06,920
...لديّ فكرة. يحصل الرّابح على جائزة

235
00:15:07,370 --> 00:15:10,550
!وهي مُواعدة فرديّة طوال اليوم مع لويد

236
00:15:11,690 --> 00:15:14,920
تاو، عمّاذا تتكلّمين؟

237
00:15:14,920 --> 00:15:17,150
،إن كنّا نُساعدك في تجربتك

238
00:15:17,150 --> 00:15:19,860
فأقلّ ما يمكننا توقّعه هو مُكافأة ما، صحيح؟

239
00:15:21,640 --> 00:15:25,200
لا تدعي جنونكِ يتجاوز فكرة تحدّيي يا فتاة

240
00:15:25,200 --> 00:15:27,450
!مـ-مهلاً، لديّ أسبابي

241
00:15:27,450 --> 00:15:30,440
حسناً، ما رأيكِ؟ هل ستُشاركين أم لا؟

242
00:15:30,440 --> 00:15:35,190
أ-أظنّني سأجرّب ذلك... ربّما

243
00:15:36,230 --> 00:15:38,210
!القواعد بسيطة جدّاً

244
00:15:39,980 --> 00:15:43,470
!من يقتل عدداً أكبر من الغيلان، يربح

245
00:15:44,930 --> 00:15:47,530
!حتّى خادمة غبيّة تستطيع فهم ذلك

246
00:15:47,530 --> 00:15:50,630
،آمل أن تُدركي بأنّني أستطيع، بغبائي
أن أقتلكِ بالخطأ

247
00:15:57,340 --> 00:16:01,340
إنّها كوبو. جرّبنَها، وأخبرنَني عن رأيكن

248
00:16:01,340 --> 00:16:03,080
هل فهم الجميع؟

249
00:16:03,080 --> 00:16:06,610
من يقضي على أكبر عدد من الغيلان
!يحظى بمُواعدة مع لويد

250
00:16:06,610 --> 00:16:10,900
يا للسّخافة المُطَقة. لِمَ المُزاح
بهذه الفكرة الهزليّة أصلاً؟

251
00:16:10,900 --> 00:16:13,860
أ-أليس كذلك؟ سيكون الخروج
في مُواعدة وقاحة

252
00:16:14,980 --> 00:16:15,980
...إذاً

253
00:16:25,770 --> 00:16:27,000
ها نا ذي

254
00:16:37,100 --> 00:16:38,750
!استمرّوا في الظّهور

255
00:16:38,750 --> 00:16:41,760
!صاروا الآن خمسة وستّة

256
00:16:42,810 --> 00:16:47,810
يا فتاة عائلة لانغليس الانسيابيّة الطيّبة

257
00:16:47,810 --> 00:16:50,070
فتاة طيّبة

258
00:16:51,330 --> 00:16:52,150
!قضيتُ عليهما

259
00:16:52,720 --> 00:16:55,150
!ماذا تعني بـ"قضيتُ عليهما"؟

260
00:16:56,070 --> 00:16:58,000
أنا آسفة

261
00:16:58,000 --> 00:17:00,650
هل كنتِ تفعلين شيئاً؟

262
00:17:01,080 --> 00:17:02,200
—أيّتها

263
00:17:06,650 --> 00:17:08,780
!مهلاً، كفّي عن اللّحاق بي

264
00:17:08,780 --> 00:17:12,720
لا، لا، أنا أختبر فقط لأرى مدى
حدّة سلاح الكوبو هذا

265
00:17:12,980 --> 00:17:15,050
والآن هلّا أفسحتِ الطّريق رجاء؟

266
00:17:15,050 --> 00:17:16,490
!لا تغترّي بنفسكِ

267
00:17:16,490 --> 00:17:19,630
!في واقع الأمر، ألم تكوني توجّهين الرّكلات فقط؟

268
00:17:21,950 --> 00:17:24,450
!استخدمي تلك القفّازات الّتي صنعها الأمير لويد

269
00:17:24,450 --> 00:17:26,310
!ألا تعلمين عمّا تتمحور حوله هذه التّجربة؟

270
00:17:26,310 --> 00:17:28,390
!السّبعة الّذين هزمتِهم لا ينبغي احتسابهم حتّى

271
00:17:28,390 --> 00:17:32,610
انظروا من كان يحصي من البداية
!أيّتها الخادمة الفاسدة

272
00:17:32,610 --> 00:17:35,340
...إذا أردتِ أن تكوني كذلك

273
00:17:53,150 --> 00:17:56,090
تمكّنتْ من القضاء على أربعة من الخمسة
!الّذين كنتُ أستهدفهم

274
00:17:56,300 --> 00:17:58,940
!سيلفا بارعة إلى حدّ مُخيف

275
00:17:58,940 --> 00:18:02,980
إنّها لا تستخدم كي أو شعوذة، لكن كلّ حركة
!من حركاتها مدروسة

276
00:18:02,980 --> 00:18:08,230
تاو... أن تُلحقي الضّرر بسلاحي، حتّى لو كان
...واحداً لستُ معتادة عليه

277
00:18:08,230 --> 00:18:09,980
لقد زدتِ قوّة

278
00:18:09,980 --> 00:18:13,700
!لويد! هذا الكوبو لا يُلحق ضرراً كافياً

279
00:18:13,700 --> 00:18:14,980
!أريد واحداً جديداً

280
00:18:14,980 --> 00:18:17,160
هذا فقط بسبب عيوبك

281
00:18:17,160 --> 00:18:22,580
الأمير لويد، يؤسفني القول بأنّ هذا السّيف ضعيف
!من حيث المتانة! لقد انكسر

282
00:18:23,210 --> 00:18:25,120
أجل، أجل. فهمت

283
00:18:25,120 --> 00:18:27,690
كلتاهما مُذهلتان جدّاً

284
00:18:27,690 --> 00:18:30,050
،بينما تُقاتلان الغيلان، وبعضهما الآخر

285
00:18:30,050 --> 00:18:32,540
تمنحان أيضاً لويد بيانات قتاليّة حول سحره

286
00:18:32,540 --> 00:18:35,600
أريد فعل شيء لمُساعدته أيضاً

287
00:18:35,600 --> 00:18:36,920
!أريد تلك البيانات

288
00:18:38,530 --> 00:18:39,640
!وجدتُها

289
00:18:40,100 --> 00:18:41,500
!لويد

290
00:18:41,880 --> 00:18:43,880
!انظر إلى هذا

291
00:18:47,640 --> 00:18:50,720
إنّها تمنحه تأثيراً سامّاً. مُثير

292
00:18:50,720 --> 00:18:54,160
!إنّها تعبث بالشّعوذة المُقدّسة المُقدَّمة من الآلهة

293
00:18:54,640 --> 00:18:56,350
لكنّها ظريفة، لذا سأسمح بذلك

294
00:18:57,920 --> 00:19:00,950
،الآن بعد أن صار مسموماً أيضاً
!ازدادت قوّته

295
00:19:02,440 --> 00:19:05,690
!انكسر؟! لم يفلح ذلك إطلاقاً

296
00:19:05,690 --> 00:19:07,390
تغيّر لونه

297
00:19:07,390 --> 00:19:09,750
...الشّعوذة الإلهيّة حسّاسة

298
00:19:09,750 --> 00:19:12,330
اعبث به باستهتار وستجد أنّ تأثيره
قد هبط بشكل جذريّ

299
00:19:12,330 --> 00:19:16,590
!آسفة! لم يفلح ذلك

300
00:19:14,960 --> 00:19:18,420
في الحقيقة، منحتِني فكرة ممتازة

301
00:19:20,600 --> 00:19:22,260
!جرّبي هذا يا رين

302
00:19:24,390 --> 00:19:26,780
لكن يبدو نفس السّابق؟

303
00:19:35,760 --> 00:19:38,390
!تفتّتَ كما كان مسموماً

304
00:19:38,390 --> 00:19:40,120
!والسّلاح بخير

305
00:19:40,120 --> 00:19:44,310
جرّبتُ شيئاً استمدّ الإلهام
من تأثيرات شعوذة السُّمّ

306
00:19:44,310 --> 00:19:48,290
يمكنكِ اعتباره نوعاً من الشّعوذة الإلهيّة
يلحق ضرراً مع مرور الوقت

307
00:19:48,290 --> 00:19:49,480
!هكذا إذاً

308
00:19:49,480 --> 00:19:53,690
إنّه ليس سامّاً فعليّاً، لكن الشّعوذة
الإلهيّة فعّالة بالذّات على الغيلان

309
00:19:53,690 --> 00:19:57,430
حتّى خدشاً سيؤدّي إلى انتشار تأثير
التّطهير، مثلما يفعل السُّمّ

310
00:19:57,430 --> 00:19:59,520
هل كنتَ تعلم بأنّه يمكن أن يعمل هكذا؟

311
00:20:01,410 --> 00:20:03,310
أتفهّم عدم معرفتك بذلك على ما أعتقد

312
00:20:03,590 --> 00:20:09,470
الشّعوذة الإلهيّة قد أُعِدّتْ بواسطة
الآلهة لمُقاتلة الشّياطين

313
00:20:09,470 --> 00:20:14,070
وكانت فعّالة بما يكفي لدرجة أنّهم
لم يحتاجوا لتحسينها أكثر من ذلك

314
00:20:14,070 --> 00:20:17,890
...والآن بعد أن حصل عليها الطّفل الشّقي

315
00:20:18,300 --> 00:20:23,070
الشّعوذة الإلهيّة على وشك التطوُّر
!كما لو أنّها تُعوّض عن الوقت المفقود

316
00:20:23,070 --> 00:20:24,340
—ليس ذلك فقط

317
00:20:29,240 --> 00:20:33,320
لكن لديه أفضل المُساعدين الّذين
!يمكن أن تحلم بهم

318
00:20:33,320 --> 00:20:37,330
!الأمير لويد، هذا السّيف يتأرجح بشكل غريب

319
00:20:37,330 --> 00:20:40,670
.أضفتُ بعض مزايا الماء إليه
لن ينكسر الآن

320
00:20:42,850 --> 00:20:46,370
!صحيح، لكن من المُحرج استخدامه حقّاً

321
00:20:52,860 --> 00:20:54,850
!بقيا اثنان

322
00:20:55,470 --> 00:20:57,190
!المعركة حامية بينهن

323
00:20:57,600 --> 00:21:00,060
...من ينال من هذا يحظى مع لويد

324
00:21:00,060 --> 00:21:01,830
...الأمير لويد

325
00:21:01,830 --> 00:21:03,450
!بمُواعدة

326
00:21:22,340 --> 00:21:26,430
الحرب الأهليّة تشغل الدّخلاء
في الأسفل في هذه اللّحظة

327
00:21:29,140 --> 00:21:32,890
يبدو أنّه من الأفضل أن أُعزّز الحراسة الأمنيّة هنا

328
00:21:33,460 --> 00:21:37,400
حسنا، ماذا تريدني أن أفعل؟
هل أستحوذ على جسده؟

329
00:21:37,820 --> 00:21:43,360
أجل. جسد الخوريّ سيمنحك حرّية
التحرُّك في أرجاء الكنيسة

330
00:21:53,210 --> 00:21:57,030
ماذا... تفعل؟

331
00:21:59,200 --> 00:22:03,910
كومة لحم مُفيدة أُخرى

332
00:23:38,020 --> 00:23:39,880
...مع العلم أنّني أجوع حتّى عندما لا أُغنّي

333
00:23:40,230 --> 00:23:43,020
!على أيّ حال، يبدو أنّني في ورطة كبيرة

334
00:23:43,520 --> 00:23:45,360
:الحلقة القادمة، الحلقة 16

335
00:23:45,360 --> 00:23:46,700
"حرب أهليّة"

336
00:23:46,700 --> 00:23:49,720
ستشهدون أعماق الشّعوذة