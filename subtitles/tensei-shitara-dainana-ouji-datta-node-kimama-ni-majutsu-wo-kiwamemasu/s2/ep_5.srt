1
00:00:07,190 --> 00:00:09,190
القلب إذاً؟

2
00:00:09,190 --> 00:00:13,240
ستكتشف بأنّه لا مكسب من استهداف قلبي

3
00:00:15,740 --> 00:00:17,610
...أخبرتُك بذلك

4
00:00:17,900 --> 00:00:21,140
ليس لديك ما تُريني إيّاه

5
00:00:23,880 --> 00:00:28,580
أخفقت في إصابة الهدف بحدِّ ذاتك
!أيّها الخوريّ اللّعين

6
00:02:03,230 --> 00:02:04,760
...قوّتي

7
00:02:05,180 --> 00:02:06,950
تجعل جسدي مرناً للغاية

8
00:02:06,950 --> 00:02:09,520
وقادراً على جعل أطرافي تلتوي
أكثر من مُعظم النّاس

9
00:02:09,730 --> 00:02:13,570
إحدى أفضل إيجابيّات ذلك هو كيف
أنّ العدوّ لن يُلاحظ ذلك عموماً

10
00:02:13,570 --> 00:02:16,010
،دون أيّ تغيير يطرأ على شكلي

11
00:02:16,010 --> 00:02:20,150
أستطيع أن أجعل ما بداخلي يلتوي
تجنُّباً لضربات قاتلة دون أي مُؤشّرات

12
00:02:20,550 --> 00:02:21,640
...أضف إلى ذلك

13
00:02:22,320 --> 00:02:25,460
القدرة على ثَني هيكلي العظميّ
وعضلاتي لأقصى حدودها

14
00:02:25,460 --> 00:02:29,540
من أجل توليد دُفعة من الطّاقة
!وقويّة بما يكفي لتحطيم حجر

15
00:02:30,140 --> 00:02:32,670
الجرذ المُحاصَر: طعن القطّ

16
00:02:36,170 --> 00:02:38,520
!إنّه صلبٌ جدّاً! هذا سيّئ

17
00:02:38,520 --> 00:02:41,420
تلقّيتُ ضرراً أكبر منه فقط بفعل
!تأثير الصّدمة

18
00:02:41,420 --> 00:02:43,440
لكن أحتاج المزيد

19
00:02:43,440 --> 00:02:48,650
أن أُوجّه ضربة أقرب وأعماق بكامل قوّتي
وبكلّ ما لديّ من مانا

20
00:02:48,650 --> 00:02:52,180
!ونقل التّطهير إلى داخل روحه مباشرة

21
00:02:52,180 --> 00:02:54,940
!الجرذ المُحاضَر: شكل التنّين

22
00:02:55,470 --> 00:02:58,000
أشعر وكأنّني سأتقيّأ أحشائي

23
00:02:58,000 --> 00:03:01,190
تنفد المانا لديّ. ذراعايّ مُخدَّرتان

24
00:03:01,500 --> 00:03:03,950
!توقّف. توقّف فحسب

25
00:03:04,300 --> 00:03:06,090
!بابيلون

26
00:03:06,090 --> 00:03:09,450
!أرجوك، دعها تهرب

27
00:03:14,980 --> 00:03:16,500
مُتألِّق

28
00:03:21,680 --> 00:03:24,720
أتفهّم شعورك تماماً

29
00:03:27,830 --> 00:03:32,360
"!تبّاً، كم هي الشّعوذة الإلهيّة رائعة؟"
هذا يُلخّص كلّ شيء، صحيح؟

30
00:03:33,690 --> 00:03:38,990
رغم ذلك، ثمّة تعويذة واحدة
...أنا مُولع بها

31
00:03:39,590 --> 00:03:40,870
كوبو

32
00:03:47,160 --> 00:03:50,190
الإكسكاليبار النّجس

33
00:03:52,350 --> 00:03:57,990
أعترف. جسدك مُثير جدّاً للاهتمام

34
00:03:58,630 --> 00:04:02,540
أين يجب أن أوجّه ضربتي كي أقتلك؟

35
00:04:11,780 --> 00:04:12,880
!هذا لا يُصدَّق

36
00:04:13,180 --> 00:04:16,050
لا يُفترَض أن تكون النّقابة
مأوى من المطر لكم

37
00:04:16,050 --> 00:04:20,920
تقول ذلك فتراها تهرع من مكان
لآخر تُوزّع المناشف

38
00:04:22,280 --> 00:04:25,500
المزيد من الزُّوار الّذين لا يُمارسون
عملاً حقيقيّاً؟

39
00:04:26,200 --> 00:04:27,560
!إيشر؟

40
00:04:37,490 --> 00:04:39,710
!ماذا حدث بالضّبط؟

41
00:04:39,710 --> 00:04:41,170
...في الواقع

42
00:04:42,380 --> 00:04:44,900
هل واجهتِ مُشكلة يا إيشر؟

43
00:04:44,900 --> 00:04:48,660
إذا كان لأجلكِ، فسوف نُساهم، دون أجر

44
00:04:49,200 --> 00:04:50,450
...الجميع

45
00:04:52,630 --> 00:04:54,800
لا تطلبي المُساعدة

46
00:04:58,220 --> 00:05:02,340
الأمور بخير. زلّتْ قدم أبتاه
وسقط تحت المطر فحسب

47
00:05:02,340 --> 00:05:04,770
كنتُ آمل أن يرتاح هنا قليلاً

48
00:05:05,260 --> 00:05:09,170
...عليّ أن أذهب في الواقع، لذا

49
00:05:09,950 --> 00:05:12,700
من فضلكم، اعتنوا به

50
00:05:23,090 --> 00:05:27,840
أنا حمقاء للغاية. لماذا لم أطلب المُساعدة؟

51
00:05:28,550 --> 00:05:31,740
بدوا جميعهم أقوياء

52
00:05:35,020 --> 00:05:36,460
هذا صحيح

53
00:05:36,460 --> 00:05:41,490
،لأنّني أعي ذلك. في أعماقي
...أستطيع أن أجزم

54
00:05:42,980 --> 00:05:44,880
أنّ الجميع سيموتون

55
00:05:45,750 --> 00:05:47,460
لا يستطيع أحدٌ إيقافه

56
00:05:48,310 --> 00:05:51,740
يجب عليّ... يجب عليّ اكتشاف
...طريقة ما لإنقاذه

57
00:05:52,280 --> 00:05:53,840
!وإلّا سيموت بابيلون

58
00:05:54,690 --> 00:05:58,860
كنتُ قد سئمتُ من غنائها على أيّ حال

59
00:06:00,270 --> 00:06:07,010
يا إلهي... الشّيء الوحيد الّذي أنا بارعة
فيه هو الغناء فيرفض ذلك أيضاً؟

60
00:06:07,010 --> 00:06:08,750
!كيف لي أن أوقفه؟

61
00:06:09,240 --> 00:06:13,020
!أرجوك! أنا مُستعدّة لوهب حياتي

62
00:06:13,020 --> 00:06:16,810
!لذا أرجوك يا إلهي

63
00:06:17,920 --> 00:06:23,030
هُراء. وهذا هو سبب انضمامك للكنيسة؟

64
00:06:25,000 --> 00:06:28,120
أنا مُندهشة لأنّكِ تعتبرين نفسكِ
،امرأة مُقدّسة

65
00:06:33,810 --> 00:06:37,050
رغم ذلك... لا أعترض فعليّاً

66
00:06:37,950 --> 00:06:43,760
ومهما حدث، يراودني إحساس بأنّ
صوتك سوف يصل للسّماوات

67
00:06:45,150 --> 00:06:46,340
...إيشر

68
00:06:50,670 --> 00:06:54,180
!عرفتُ أنّها أنتِ! يا له من تعثُّر

69
00:06:54,750 --> 00:06:58,170
بدأت تُمطر بينما كنّا في طريقنا
للتوجُّه إلى النّقابة

70
00:06:58,490 --> 00:06:59,840
اصبري قليلاً

71
00:06:59,840 --> 00:07:03,960
،سيلفا والآخرون يشترون معاطف مطريّة
ثمّ سنأخذكِ إلى الكنيسة

72
00:07:07,430 --> 00:07:10,940
!أرجوك! يجب عليك إنقاذ بابيلون

73
00:07:14,710 --> 00:07:16,700
...أنا آسفة، أنا

74
00:07:18,630 --> 00:07:20,940
لِمَ أطلب منك ذلك؟

75
00:07:22,600 --> 00:07:23,820
أنا آسفة

76
00:07:24,260 --> 00:07:27,450
...لا شيء. انسَ بأنّني قلتُ شيئاً

77
00:07:45,660 --> 00:07:47,480
حسناً، ها قد فعلتِها الآن

78
00:07:54,970 --> 00:07:56,880
لِمَ أشتكي وأتذمّر؟

79
00:07:56,880 --> 00:08:00,880
كانت حياتي بائسة قبل أن ألتقي بك

80
00:08:01,420 --> 00:08:04,420
وبذلتُ قصارى جهدي لمُساعدة الزّعيم

81
00:08:05,360 --> 00:08:07,450
أجل، أجل... سأعترف بذلك

82
00:08:08,640 --> 00:08:11,430
أحببتُ غناء إيشر

83
00:08:11,890 --> 00:08:13,810
أنا واثق بأنّ الزّعيم أحبّه أيضاً

84
00:08:14,780 --> 00:08:17,490
لذا يمكنني القول بأنّ الأمر
سار على ما يُرام

85
00:08:18,760 --> 00:08:21,980
هل لدى هذا المكان أيّ شيء للشّرب؟

86
00:08:26,760 --> 00:08:30,030
!مُؤلم، مُؤلم! ما مُشكلتك؟

87
00:08:30,030 --> 00:08:31,770
التقينا مُجدّداً أخيراً وهذا ما تفعله؟

88
00:08:47,030 --> 00:08:50,800
أظنّك على حقّ. سندّخر المشروبات
للمرّة المُقبلة

89
00:09:07,060 --> 00:09:10,530
،سأحاول وأعيش بعض القصص الجميلة لمُشاركتها
في المرّة المُقبلة الّتي آتي فيها

90
00:09:30,740 --> 00:09:34,460
!استيقظ بابيلون

91
00:09:32,630 --> 00:09:34,460
!ماذا؟ ما الّذي يجري؟

92
00:09:34,680 --> 00:09:36,460
!كم هذا مُطمئن

93
00:09:36,460 --> 00:09:40,130
...يسرّني أنّك... حسناً

94
00:09:40,130 --> 00:09:40,980
!غابت عن الوعي

95
00:09:41,280 --> 00:09:45,280
آسف، لكن هلّا أطلعني أحدٌ على ما حدث؟

96
00:09:45,940 --> 00:09:47,910
كلّ ما حدث أثناء الأيّام الثّلاثة الّتي
...كان فيها بابيلون

97
00:09:47,910 --> 00:09:48,890
!غائباً عن الوعي

98
00:09:48,890 --> 00:09:52,160
حملَ لويد الجريح بابيلون ونقله
!إلى لوردوست للعلاج

99
00:09:52,160 --> 00:09:54,250
بعد ثلاثة أيّام، استيقظ بابيلون

100
00:09:54,250 --> 00:09:55,410
نحن هنا الآن

101
00:09:55,410 --> 00:09:58,480
وبما أنّ الكنيسة تبدو وكأنّها
،اختُرقت ثانية

102
00:09:58,480 --> 00:10:00,010
طلبَ من شخص أن يبقى
ويستمرّ في المُراقبة

103
00:10:00,010 --> 00:10:01,800
طلبَ من شخص أيضاً أن يتوجّه
إلى نقابة المُغامرين

104
00:10:01,800 --> 00:10:03,410
...للإبلاغ عمّا حدث للكنيسة

105
00:10:03,410 --> 00:10:04,890
وصيد الغيلان

106
00:10:04,890 --> 00:10:08,030
وكذلك إبلاغ الأمير آلبيرت عمّا حدث

107
00:10:08,030 --> 00:10:09,400
في قلعة سالوم

108
00:10:09,400 --> 00:10:13,060
نقلَ إيشر والخوريّ إلى لوردوست أيضاً

109
00:10:13,060 --> 00:10:14,330
من أجل سلامتهما

110
00:10:14,330 --> 00:10:16,950
بالإضافة إلى نقل الأخوات من الكنيسة
إلى القلعة

111
00:10:16,950 --> 00:10:17,890
لأجل سلامتهن أيضاً

112
00:10:17,890 --> 00:10:22,150
أخيراً، طلب من الرّجلين اللّطيفين العمل
...على ترميم الكنيسة ممّا يقودنا

113
00:10:22,150 --> 00:10:23,110
إلى الحاضر

114
00:10:24,000 --> 00:10:25,260
هكذا إذاً

115
00:10:26,160 --> 00:10:28,910
"فهمتُ الصُّورة، بمعزل عن "الرّجلين اللّطيفين

116
00:10:28,910 --> 00:10:30,310
...الزُعيم

117
00:10:30,670 --> 00:10:31,890
أين الأمير لويد؟

118
00:10:31,890 --> 00:10:35,820
.ابتسم لك الحظّ يا بابيلون
...فلو لم تستيقظ اليوم

119
00:10:35,820 --> 00:10:40,430
حسناً! حان وقت تجاربي الخاصّة بفرض
!استعادة الوعي على بابيلون

120
00:10:40,430 --> 00:10:42,190
!تجربة فرض استعادة الوعي؟

121
00:10:42,190 --> 00:10:45,490
بابيلون... أنت مُستيقظ

122
00:10:45,490 --> 00:10:46,960
هذا مُطمئن

123
00:10:46,960 --> 00:10:48,450
!لماذا تبدو مُحبَطاً؟

124
00:10:49,350 --> 00:10:52,190
أظنّني نجوتُ بسهولة أكبر
من المُتوقَّع بسبب

125
00:10:52,190 --> 00:10:54,720
حجم الضّغط الّذي فرضتُه على أعضائي
الحيويّة بقوى المرونة خاصّتي

126
00:10:54,720 --> 00:10:56,790
لعلّ أنقذ ذلك حياتي

127
00:10:56,790 --> 00:11:00,980
!أحمق! كدتَ تموت

128
00:11:01,360 --> 00:11:05,730
لويد وجيريل كانا يستخدمان سحر شفاء
،عليك لأكثر من عشر ساعات

129
00:11:05,730 --> 00:11:08,190
!ومع ذلك لم تستيقظ

130
00:11:08,190 --> 00:11:09,370
!عشر ساعات؟

131
00:11:10,200 --> 00:11:12,750
لا بُدّ أنّني أثرتُ قلقكم حقّاً

132
00:11:12,750 --> 00:11:15,700
إذا أردت أن تشكر أحداً، فوفّر
شكرك لإيشر وجيد

133
00:11:16,480 --> 00:11:21,770
كان إيشر يُطهِّرك بلا توقُّف عندما
لم تسترجع وعيك

134
00:11:22,250 --> 00:11:29,000
والأهمّ من ذلك، من دون أن تطلب هي
...مُساعدتي... ولو لم أستطع الانتقال آنيّاً

135
00:11:29,550 --> 00:11:31,840
لكنتَ في عداد الموتى

136
00:11:33,770 --> 00:11:34,820
صحيح

137
00:11:35,500 --> 00:11:41,080
لذا، لديّ بعض الأسئلة حول
ما حدث في الكنيسة

138
00:11:42,050 --> 00:11:48,010
إذاً يستطيع العدوّ تغيير شكله
!كوحش ويستخدم كوبو؟

139
00:11:48,010 --> 00:11:49,260
!كفاك هُراء

140
00:11:49,260 --> 00:11:54,730
تُصوّر الأمر وكأنّني منحتُ الشّعوذة
!الإلهيّة لوحش

141
00:11:54,730 --> 00:12:00,060
في الحقيقة، الغول الّذي تحت الأرض الّذي
واجهناه فجّر نفسه بالشّعوذة الإلهيّة

142
00:12:00,350 --> 00:12:03,320
لا أستطيع... شرح ذلك بحدّ ذاتي

143
00:12:03,840 --> 00:12:08,810
أصبتُ ذلك الخوريّ بما لا يقلّ
عن 30 طلقة من وهج

144
00:12:08,810 --> 00:12:13,460
لكن لم يكن هناك أي تأثير عليه إطلاقاً

145
00:12:13,460 --> 00:12:14,660
...معنى هذا إذاً

146
00:12:14,980 --> 00:12:18,990
غالباً لم يشعر وكأنّه كان
يرتكب أيّ خطأ

147
00:12:20,680 --> 00:12:24,800
يُؤثّر التّطهير عموماً على الضّمير
الّذي يشعر بالتّأنيب

148
00:12:25,070 --> 00:12:27,840
...لا يستطيع خلق مشاعر لم توجد مُسبقاً

149
00:12:28,890 --> 00:12:34,310
أو ربّما لديه اعتقاد راسخ بأنّ تطهير
بابيلون لا يستطيع اختراقه

150
00:12:35,580 --> 00:12:39,410
أيّاً كانت الحالة، يبدو شخصاً مُزعجاً

151
00:12:41,820 --> 00:12:47,640
أمسكني من حنجرتي وبدأ يتفوّه
...حول تعزيز الحراسة

152
00:12:48,500 --> 00:12:51,350
إذاً أراد أن يدع الأطياف تستحوذ
على البابا وإيشر

153
00:12:51,350 --> 00:12:54,340
...لنشر المزيد من الجواسيس في الكنيسة

154
00:12:54,340 --> 00:12:56,150
لكن ما الغاية؟

155
00:12:56,150 --> 00:12:58,020
إنّه أشبه بمُتحرٍّ

156
00:12:58,640 --> 00:13:02,990
في أيّ وقت التقيت بالخوريّ
الغامض يا بابيلون؟

157
00:13:02,990 --> 00:13:06,100
،كنتُ أُراقب الحديقة الدّاخليّة

158
00:13:06,100 --> 00:13:08,600
باعتبار أنّه كان المكان الّذي
التقيتُ فيه به أوّل مرّة

159
00:13:09,040 --> 00:13:13,350
وعندما رحتُ لأتفقّدها في يوم
الحادثة، كان قد عاد

160
00:13:13,740 --> 00:13:16,480
...الحديقة الدّاخليّة من جديد

161
00:13:17,070 --> 00:13:18,980
...على ذكر الأمر، قالت إيشر

162
00:13:19,250 --> 00:13:24,600
صوّرَ الأمر وكأنّ غنائي قد جعله يشمئزّ دوماً

163
00:13:24,600 --> 00:13:27,360
دوماً"؟"

164
00:13:27,660 --> 00:13:29,860
!تلك الحديقة الدّاخليّة مُريبة

165
00:13:29,860 --> 00:13:31,490
!أجل، مُريبة

166
00:13:31,490 --> 00:13:32,630
!ظريف للغاية

167
00:13:32,630 --> 00:13:34,120
الزّعيم ليس دُميتكم

168
00:13:34,450 --> 00:13:35,890
!أنتم

169
00:13:37,270 --> 00:13:39,460
أحسنتُم صنعاً في مُراقبة الكنيسة

170
00:13:39,460 --> 00:13:40,740
!شكراً

171
00:13:40,740 --> 00:13:41,640
!زعيم

172
00:13:41,640 --> 00:13:43,290
!الأمير لويد

173
00:13:43,290 --> 00:13:45,800
تبدو الحديقة الدّاخليّة كأنّها جديدة

174
00:13:45,800 --> 00:13:46,550
!أجل

175
00:13:46,550 --> 00:13:49,050
عليّ فقط ردم الفجوة في الجدار

176
00:13:49,050 --> 00:13:50,770
!أجل

177
00:13:49,490 --> 00:13:51,730
هل كانوا يتصرّفون هكذا من قبل؟

178
00:13:51,730 --> 00:13:54,150
سنحرص على الانتهاء

179
00:13:54,150 --> 00:13:59,060
قبل وصول البابا من أجل مهرجان
المجيء العظيم بعد ثلاثة أيّام

180
00:14:01,160 --> 00:14:03,960
!تسرّني رؤية بابيلون يُبلي حسناً يا لويد

181
00:14:03,960 --> 00:14:05,800
أنت مُحقّق ممتاز

182
00:14:05,800 --> 00:14:08,830
أجل! شكراً على مُراقبة الأمور يا تاو

183
00:14:10,960 --> 00:14:13,580
هل حدث شيء من ناحيتك؟

184
00:14:13,580 --> 00:14:15,640
!إطلاقاً

185
00:14:15,640 --> 00:14:20,410
لكن أتتْ كاتارينا، وأطلعتُها على التّفاصيل

186
00:14:20,410 --> 00:14:22,670
وماذا قالت؟

187
00:14:22,670 --> 00:14:24,360
!أنّها مُحرَجة

188
00:14:24,360 --> 00:14:26,170
!عدتِ؟

189
00:14:26,170 --> 00:14:29,670
أجل، وأنا أُعيد النّظر في عملي
!مع نقابة المُغامرين

190
00:14:29,670 --> 00:14:32,210
ماذا حدث بالضّبط؟

191
00:14:32,210 --> 00:14:33,560
...بعد أن أخبرتِني

192
00:14:34,210 --> 00:14:39,020
تواصلتُ مع مقرّ الكنيسة وأعطيتُهم
أوصاف ذلك الخوريّ

193
00:14:39,910 --> 00:14:44,440
هذه من نقابة المُغامرين والأمير الثّاني آلبيرت

194
00:14:44,730 --> 00:14:46,920
كلاهما مُهتمّان بنفس المسألة

195
00:14:48,370 --> 00:14:51,400
،يبدو أنّ هذا الرّجل قد هاجم كنيسة منطقة دين

196
00:14:51,400 --> 00:14:55,110
ويسألون ما إن كنّا نعرف من قد يكون

197
00:14:55,110 --> 00:14:57,720
هل أُصيبَ أحدٌ بجروح؟

198
00:14:57,720 --> 00:14:59,590
هربَ الجاني، وأحد الكهنوت التّلاميذ

199
00:14:59,590 --> 00:15:02,050
الّذي كان يُقاتل مُدافِعاً أصيبَ بجروح بليغة

200
00:15:02,050 --> 00:15:05,190
وبقيّة طاقم الكنيسة نُقِلوا إلى مكان آمن

201
00:15:07,750 --> 00:15:10,500
ويسألون إن كنّا نعرف من قد يكون؟

202
00:15:11,000 --> 00:15:16,890
أثناء الهجوم، الرّجل المرسوم في تلك الصّورة
ألقى التّعويذة الإلهيّة، كوبو

203
00:15:18,310 --> 00:15:19,570
!هذا غير مُمكن

204
00:15:19,570 --> 00:15:24,270
هل يُلمّحون إلى أنّ هذا الرّجل المجنون هو
واحد منّا نحن، !أكثر الخدم إخلاصاً للإله؟

205
00:15:24,270 --> 00:15:28,200
!من المسؤول عن هذه الإشاعات التّدليسيّة؟

206
00:15:28,850 --> 00:15:31,660
غالباً التّلميذ الّذي قاتل دفاعاً عن الكنيسة

207
00:15:32,070 --> 00:15:34,240
رغم ذلك، كان في السّابق مُجرماً مطلوباً

208
00:15:34,790 --> 00:15:37,670
يعمل حاليّاً كمُحافظ لجزيرة لوردوست

209
00:15:37,670 --> 00:15:40,230
!ويُصدِّقون شقيّاً كهذا؟

210
00:15:40,230 --> 00:15:43,320
!جزيرة لوردوست هي وكر للعنف والبطش

211
00:15:43,320 --> 00:15:46,040
سمعنا إشاعات عن أعمال شغب
!هناك قبل أيّام

212
00:15:46,300 --> 00:15:47,680
هدوء

213
00:15:48,110 --> 00:15:52,180
لا تتّهموا الآخرين دون تيقُّن

214
00:15:52,180 --> 00:15:54,630
...لـ-لكن فخامتك

215
00:15:54,630 --> 00:15:58,430
هم من يفترون علينا من دون أيّ أساس

216
00:15:58,740 --> 00:16:02,580
...هذا صحيح. لذا، سيكون هذا هو ردّنا

217
00:16:02,930 --> 00:16:06,440
قالوا، "إن كنتُم تتّهمون الكنيسة، فمن
"الأفضل أن يكون لديكم دليل

218
00:16:06,440 --> 00:16:10,330
!زعيمي غاضب منّي كثيراً

219
00:16:11,920 --> 00:16:14,320
!أصلحنا تلك النّافذة للتو

220
00:16:14,320 --> 00:16:16,360
!لكن لا مُشكلة على ما أعتقد

221
00:16:16,360 --> 00:16:18,070
إنّهما لطيفان حقّاً

222
00:16:18,430 --> 00:16:22,340
لن تتمكّن النّقابة من فعل شيء
للمُساعدة في هذه الحادثة

223
00:16:22,340 --> 00:16:25,840
لا يمكننا حتّى تعليق مُلصَقات
...مطلوبين بأوصافه

224
00:16:25,840 --> 00:16:27,800
أنا آسفة للغاية

225
00:16:28,340 --> 00:16:30,760
!إذاً نحتاج ذلك الدّليل

226
00:16:31,090 --> 00:16:33,470
!انبشوا كلّ حجر

227
00:16:33,470 --> 00:16:34,730
!حاضر سيّدي

228
00:16:35,620 --> 00:16:38,100
!لكنّنا أصلحنا الحديقة للتو

229
00:16:38,100 --> 00:16:39,780
!لكن لا مُشكلة على ما أعتقد

230
00:16:39,780 --> 00:16:41,290
لطيفان للغاية؟

231
00:16:41,290 --> 00:16:43,090
!لا شيء لطيف في ذلك

232
00:16:48,170 --> 00:16:51,200
إنّ البحث دون إحداث جلبة
...يُعقّد الأمور

233
00:16:51,200 --> 00:16:55,730
أنف شيرو موثوق جدّاً لكنّه
يتجنّبني لسبب ما

234
00:16:56,070 --> 00:17:00,240
وكأنّه لاحظ شيئاً لكنّه يتظاهر
بأنّه لم يلحظ

235
00:17:00,750 --> 00:17:02,010
!نعيب

236
00:17:07,990 --> 00:17:11,760
!نعيب! نعيب

237
00:17:12,160 --> 00:17:14,360
أطلب منهم مُساعدتنا في البحث

238
00:17:14,360 --> 00:17:18,520
يتمتّعون ببصر حادّ، وهناك ما يكفي
منهم لتفقُّد أيّ شيء مُريب

239
00:17:18,870 --> 00:17:20,870
!أحسنت يا كرو

240
00:17:20,870 --> 00:17:24,830
تستخدم "الخِطاب الملعون" للتحكُّم
!بحاملي اسمك! لقد تحسّنت

241
00:17:25,470 --> 00:17:27,800
شيرو حائر حقّاً

242
00:17:27,800 --> 00:17:30,780
لكن مع ذلك لا يُقدّم المُساعدة

243
00:17:31,060 --> 00:17:35,800
على ذكر الأمر، كان شيرو خائفاً حقّاً
عندما جاء إلى هنا أوّل مرّة

244
00:17:35,800 --> 00:17:38,280
أعتقد فعلاً بأنّه يوجد شيء هنا

245
00:17:41,070 --> 00:17:42,260
!ساريا

246
00:17:43,400 --> 00:17:44,950
ماذا تفعلين هنا؟

247
00:17:44,130 --> 00:17:48,250
!بابيلون! يسرّني أنّك استيقظت

248
00:17:47,020 --> 00:17:49,080
!الأمير لويد

249
00:17:49,520 --> 00:17:52,460
...المعذرة... أنا

250
00:17:54,920 --> 00:17:57,720
يسرّني أنّكِ بخير

251
00:17:59,720 --> 00:18:00,710
!...ساريا

252
00:18:02,530 --> 00:18:05,710
هذه عقوبتك لتوقّفك عن التّمرين
!دون أن تخبريني

253
00:18:05,710 --> 00:18:08,240
!مُذهل! كأنّها تعزف موسيقى بهذه الطّريقة

254
00:18:08,600 --> 00:18:11,490
إذاً، هل ستكونين بخير اليوم أثناء الإنشاد؟

255
00:18:14,690 --> 00:18:16,830
...المعذرة، الأميرة ساريا

256
00:18:17,740 --> 00:18:21,060
شكراً لك على إنقاذ إيشر، يا بافلوف

257
00:18:21,060 --> 00:18:22,170
اسمي بابيلون

258
00:18:23,130 --> 00:18:26,570
كما سمعتِ. هوجِمت إيشر بواسطة
بعض الأشرار

259
00:18:26,570 --> 00:18:29,710
قد تُستهدَف ثانية

260
00:18:29,710 --> 00:18:33,270
لهذا قد يكون من الأفضل
إلغاء الإنشاد

261
00:18:36,570 --> 00:18:37,620
هكذا إذاً

262
00:18:38,620 --> 00:18:42,230
سأؤدّي بمفردي إذاً

263
00:18:50,550 --> 00:18:51,600
!رِفاق

264
00:19:27,770 --> 00:19:31,350
قبو؟! كيف لم أعلم بهذا؟

265
00:19:31,970 --> 00:19:34,770
...لم ألحظه أبداً

266
00:19:40,280 --> 00:19:46,560
الباب... إنّه مصنوع من خشب رقائقي خاصّ
يحجب كلّاً من المانا والكي

267
00:19:47,810 --> 00:19:49,410
لا عجب في أنّه لم يُلحَظ

268
00:19:49,850 --> 00:19:52,490
ما الّذي يجري تحت الكنيسة؟

269
00:19:52,490 --> 00:19:55,370
وما هذه الرّائحة؟

270
00:19:58,430 --> 00:19:59,840
لا ينبغي أن تري هذا

271
00:20:03,870 --> 00:20:09,170
بالطّبع لا. ابقي هنا مع الخوريّ يا إيشر

272
00:20:12,600 --> 00:20:15,750
!من فضلكم! دعوني أذهب معكم

273
00:20:17,530 --> 00:20:19,710
لن أُسبّب أي مُشكلة

274
00:20:19,710 --> 00:20:21,420
!لن يحدث هذا

275
00:20:21,810 --> 00:20:24,660
—أنتِ مُستهدَفة

276
00:20:24,660 --> 00:20:29,360
أجل، وأنت جريح، لذا يجدر بك
أن تبقى هنا مع الخوريّ

277
00:20:29,360 --> 00:20:32,230
!حمقاء! هل تدركين ما تفعلينه؟

278
00:20:29,870 --> 00:20:31,310
يمكنك أخذ هذا الرّداء

279
00:20:31,310 --> 00:20:32,990
ماذا؟ يمكنني ذلك؟

280
00:20:32,230 --> 00:20:33,810
!سيكون الأمر أخطر بكثير في الأسفل هناك

281
00:20:32,990 --> 00:20:34,950
ينتابني شعور بأنّ الجوّ
بارد في الأسفل هناك

282
00:20:33,810 --> 00:20:34,950
!هيّا

283
00:20:36,250 --> 00:20:38,210
لا أريد أن يُحبطها هذا

284
00:20:39,940 --> 00:20:43,650
بما أنّني من مُعجباتها أيضاً

285
00:20:44,480 --> 00:20:46,830
منذ متى انسجمتُما؟

286
00:20:46,830 --> 00:20:48,600
بينما كنتَ نائماً في الواقع

287
00:20:52,260 --> 00:20:55,200
بابيلون... أنا آسفة

288
00:20:55,940 --> 00:20:59,750
...لكن إذا أشحتُ بنظري الآن

289
00:21:00,610 --> 00:21:04,260
فأظنّني لن أتمكّن أبداً من النّظر
للأمام والغناء ثانية

290
00:21:05,240 --> 00:21:09,760
،يجب أن أتغلّب على هذا الخوف
وأتمكّن من النُّهوض

291
00:21:15,290 --> 00:21:16,570
ما الأمر؟

292
00:21:16,570 --> 00:21:19,080
هل ستذهب؟ أم لا؟

293
00:21:19,080 --> 00:21:22,340
...أنا خائف. لكن

294
00:21:22,740 --> 00:21:25,890
!أرجوكم! دعوني أذهب معكم

295
00:21:31,860 --> 00:21:34,400
!أجل! لهذا أنت مُطيع يا شيرو

296
00:21:43,640 --> 00:21:46,270
!أيّ تجديف هو هذا؟

297
00:21:47,870 --> 00:21:50,500
فهمتُ سبب خوف شيرو الآن

298
00:23:35,460 --> 00:23:38,790
كنتُ على وشك مُشاركة مشروب
مشروب في الحياة الآخرة

299
00:23:39,170 --> 00:23:42,290
لكن عدتُ بفضل غنائها

300
00:23:42,830 --> 00:23:44,690
:الحلقة القادمة، الحلقة 18

301
00:23:44,690 --> 00:23:45,950
"إرادة إيشر"

302
00:23:46,320 --> 00:23:48,990
ستشهدون اعماق الشّعوذة