1
00:00:00,790 --> 00:00:02,980
هل أنتما جاهزتان للطّلب؟

2
00:00:03,820 --> 00:00:06,250
!زيّ هذه الآنسة طريف

3
00:00:07,880 --> 00:00:10,740
ريريكا والفتيات الأُخريات سيُقِمن
إعادة الافتتاح، صحيح؟

4
00:00:11,160 --> 00:00:15,360
،لم يبقَ لدينا شيء في المُدّخرات
ومُنافسنا المحلّي عائد

5
00:00:15,750 --> 00:00:18,800
...ربّما استعجلتُ كثيراً لمساعدتها

6
00:00:18,800 --> 00:00:21,620
هاياتشي! لِمَ أنت عابس هكذا؟

7
00:00:22,140 --> 00:00:25,250
أحسدكِ على عدم مُبالاتكِ
لأيّ شيء في العالم

8
00:00:25,500 --> 00:00:28,070
!بطل العدالة ليس لديه ما يقلق بشأنه

9
00:00:29,690 --> 00:00:32,340
!سأحمي السّلامَ في عالمنا

10
00:00:33,980 --> 00:00:35,760
مطعم تشيودا"؟"

11
00:00:36,010 --> 00:00:37,690
...يبدو

12
00:00:37,690 --> 00:00:40,010
مختلفاً تماماً الآن، صحيح؟

13
00:00:43,720 --> 00:00:45,450
!تفضّلوا بالدّخول

14
00:00:45,450 --> 00:00:48,700
!أهلاً بكم في مطعم تشيودا

15
00:02:19,530 --> 00:02:22,170
!اليوم هو يوم إعادة افتتاح مطعم تشيودا

16
00:02:22,170 --> 00:02:23,490
!جرّبوا هذه جميعاً

17
00:02:23,490 --> 00:02:25,620
!يبدو لذيذاً

18
00:02:26,590 --> 00:02:29,120
جرّبتُن إذاً قائمة بطراز يابانيّ؟

19
00:02:29,390 --> 00:02:32,000
لن يكون هناك الآن أي تضارُب مع فاميليا

20
00:02:32,000 --> 00:02:34,190
!لنبدأ بالأكل

21
00:02:34,190 --> 00:02:37,510
يؤنّبني ضميري أن أراكُن تعملن حولنا

22
00:02:37,510 --> 00:02:39,020
لا تقلق بشأن ذلك

23
00:02:39,020 --> 00:02:42,640
تقول مويمي-تشان بأنّها أفضل في إعداد
الطّعام اليابانيّ على أيّ حال

24
00:02:43,010 --> 00:02:48,770
نحن على وِفاق مع بائع الأسماك
والسيّدات في سوق المُزارعين الآن

25
00:02:49,040 --> 00:02:54,650
ارتأينا بأنّهم سيكونون سُعداء بدعم
مطعم يستخدم مُكوِّنات محلّية طازجة

26
00:02:56,020 --> 00:02:57,280
!لذيذ

27
00:02:57,890 --> 00:02:59,810
هذا لذيذ حقّاً

28
00:02:59,810 --> 00:03:02,660
تتمتّع مويمي-تشان بمهارات احترافيّة

29
00:03:02,660 --> 00:03:07,660
والداها يُديران مطعماً يابانيّاً
يُدعى سويا كادان

30
00:03:07,950 --> 00:03:12,170
ماذا؟! تقصدين المطعم التّقليديّ الشّهير
الّذي ذاع صيته منذ فترة إيدو؟

31
00:03:12,900 --> 00:03:16,160
"!كنتُ أساعدهم منذ صغري"

32
00:03:16,160 --> 00:03:17,300
هذا ما قالته...

33
00:03:17,560 --> 00:03:19,860
!مويمي-تشان مذهلة حقّاً

34
00:03:19,860 --> 00:03:22,570
...أجل، هي كذلك، لكن

35
00:03:22,570 --> 00:03:24,800
هل هناك مشكلة ما؟

36
00:03:25,260 --> 00:03:28,560
أخبرتُكِ بأنّ ترشيح البونيتو داشي
،يخلق مذاقاً مُرّاً

37
00:03:28,560 --> 00:03:32,560
ولهذا لا ينبغي أن تُصفِّيه يا هيكيرو-سان

38
00:03:32,560 --> 00:03:35,810
أنا آسفة! ظننتُ بأنّني سأستخرج
!مزيداً من الدّاشي منه هكذا

39
00:03:36,190 --> 00:03:39,530
وهذا الكونبو داشي فقد نكهته

40
00:03:39,530 --> 00:03:40,690
...هيكيرو-سان

41
00:03:41,120 --> 00:03:42,820
غليتِه، أليس كذلك؟

42
00:03:42,820 --> 00:03:46,080
أنا آسفة! ظننتُ بأنّني سأستخرج
!داشي أكثر منه بهذه الطّريقة

43
00:03:46,080 --> 00:03:49,240
أصبح جادّة حقّاً عندما أضع"
"!غِطاء الطبّاخ

44
00:03:49,240 --> 00:03:50,190
هذا ما قالته...

45
00:03:50,190 --> 00:03:52,080
!إنّها شخصٌ مختلفٌ تماماً

46
00:03:52,680 --> 00:03:54,920
حسناً، حظّاً سعيداً يوم غد وما بعد غد

47
00:03:55,200 --> 00:03:56,840
سنُروّج لكُن في مطعمنا أيضاً

48
00:03:56,840 --> 00:03:57,840
شكراً

49
00:03:57,840 --> 00:04:01,670
!وجدتُها! لنطبع منشورات ونوزّعها بين مطعمينا

50
00:03:59,720 --> 00:04:00,720
...سينباي

51
00:04:01,670 --> 00:04:03,720
تسوكيشيما-سينباي، هنا

52
00:04:04,110 --> 00:04:05,480
هل لي بلحظة؟

53
00:04:05,900 --> 00:04:07,220
ما الأمر؟

54
00:04:07,220 --> 00:04:08,570
تفضّلي. هذه لكِ

55
00:04:09,660 --> 00:04:13,350
ربحتُها في سحب اليانصيب
في حيّ التسوُّق أمس

56
00:04:13,720 --> 00:04:16,720
لا أستطيع الذّهاب، بما أنّني سأنشغل بالمطعم

57
00:04:17,360 --> 00:04:19,580
!لذا يمكنكِ أخذها يا سينباي

58
00:04:19,580 --> 00:04:22,730
لكن هذا نُزُل جميل حقّاً

59
00:04:22,730 --> 00:04:24,610
هل أنتِ متأكّدة من أنّكِ تريدينني أن آخذها؟

60
00:04:24,610 --> 00:04:26,220
!بالطّبع

61
00:04:26,570 --> 00:04:28,980
فعلتِ الكثير لأجلي في نهاية المطاف

62
00:04:29,540 --> 00:04:33,500
استخدميها للذّهاب إلى رحلة نبع
ساخن بمفردكِ مع هاياتو-كن

63
00:04:33,980 --> 00:04:34,870
ماذا؟

64
00:04:35,310 --> 00:04:39,000
لـ-لماذا ينبغي لهاياتو-كن وأنا
!أن نقضي رحلة بمفردنا؟

65
00:04:39,310 --> 00:04:43,010
أيّ شخص ينظر إليكِ سيعرف
فوراً بأنّكِ تحبّينه

66
00:04:44,090 --> 00:04:45,700
...لـ-لكن

67
00:04:46,300 --> 00:04:51,010
إذا فعلتُ ذلك، فذلك سيجعل الأمور
...مُحرِجة في المقهى

68
00:04:51,010 --> 00:04:52,270
...سينباي

69
00:04:52,540 --> 00:04:55,700
لماذا تتكلّمين كطالبة إعداديّة؟

70
00:04:56,460 --> 00:04:59,150
!إذا أردتِ شيئاً، فتأخذينه بالقوّة

71
00:04:59,490 --> 00:05:02,150
!أليس هكذا تسير الأمور في العمل؟

72
00:05:02,460 --> 00:05:03,450
حقّاً؟

73
00:05:03,450 --> 00:05:05,160
!أجل، حقّاً

74
00:05:05,160 --> 00:05:06,280
...لكن

75
00:05:06,280 --> 00:05:12,620
لا أتخيّل هاياتو-كن سيقبل برحلة
...معي بمفردنا فقط

76
00:05:12,990 --> 00:05:13,880
...وأيضاً

77
00:05:13,880 --> 00:05:15,620
،إذا ظللتِ تتكلّمين هكذا

78
00:05:15,620 --> 00:05:17,570
فستأخذه إحداهن منكِ

79
00:05:17,570 --> 00:05:21,120
أنتِ جميلة، لذا يمكنكِ أن تستعملي الخشونة

80
00:05:21,120 --> 00:05:24,510
حـ-حقّاً؟ أنا جميلة؟

81
00:05:24,510 --> 00:05:27,580
!أجل! أنت فطيرة جبنة ظريفة

82
00:05:27,580 --> 00:05:28,400
ماذا؟

83
00:05:28,400 --> 00:05:30,010
بئساً، آسفة

84
00:05:30,480 --> 00:05:33,390
ماذا تفعلين يا ريهو؟ سنعود إلى المنزل

85
00:05:33,390 --> 00:05:34,700
!قـ-قادمة

86
00:05:34,700 --> 00:05:36,650
!عليك بهن يا سينباي

87
00:05:37,770 --> 00:05:40,270
!غطاء الطبّاخ هو شكلها الحقيقيّ؟

88
00:05:40,270 --> 00:05:42,560
الدّاشي أساسيّ في الطّبخ اليابانيّ

89
00:05:42,560 --> 00:05:44,240
...إذا استهترت في إعداده

90
00:05:44,880 --> 00:05:47,440
!وإلّا ستجعل الدّاشي المسكين يبكي

91
00:05:48,080 --> 00:05:51,620
...نيّة تقديم أجود نكهة مُمكنة لزبائننا

92
00:05:52,400 --> 00:05:55,810
هامّة حقّاً! إذا لم نستطع فعل
!ذلك، فسأبكي أيضاً

93
00:05:57,870 --> 00:05:59,290
!كفى لهواً

94
00:06:04,880 --> 00:06:07,550
حسناً، لديّ درس بعد الظّهر

95
00:06:07,900 --> 00:06:10,170
سنذهب للتسوُّق

96
00:06:10,170 --> 00:06:11,550
!إكسباندر

97
00:06:12,010 --> 00:06:14,680
إلى اللّقاء. أنا ذاهبة لتمرين الفرقة

98
00:06:18,280 --> 00:06:21,000
،إذا أردتُ دعوته إلى هذه الرّحلة
!فهذه هي الفُرصة

99
00:06:22,730 --> 00:06:25,190
...ا-المعذرة

100
00:06:27,690 --> 00:06:30,830
...في الواقع... أنا

101
00:06:30,830 --> 00:06:31,820
ما الأمر؟

102
00:06:32,670 --> 00:06:35,080
أتريد أن نذهب إلى نُزُل نبع ساخن
ونتناول العشاء

103
00:06:35,080 --> 00:06:37,450
...ونسترخي معاً، و... و... و

104
00:06:37,450 --> 00:06:41,200
...ندخل حمّام هواء طلق معاً... ربّما

105
00:06:41,200 --> 00:06:42,700
!ريهو-سان

106
00:06:43,960 --> 00:06:45,020
ريهو؟

107
00:06:45,020 --> 00:06:49,430
هـ-هل مقهانا بخير؟
أقصد من حيث العمل؟

108
00:06:50,910 --> 00:06:54,430
لا تقلقي. الجوّ يبرد، لذا سيأتينا
مزيد من الزّبائن

109
00:06:55,060 --> 00:06:56,900
...آمل ذلك

110
00:06:56,900 --> 00:07:01,210
لكن العمل بلا توقُّف لمدّة طويلة
كان مُرهِقاً جدّاً، أليس كذلك؟

111
00:07:01,210 --> 00:07:02,440
...مؤخّراً

112
00:07:02,880 --> 00:07:06,320
كنتُ أقول لنفسي أنّه سيكون من اللّطيف
الاسترخاء في نبع ساخن كنوع من التّغيير

113
00:07:06,670 --> 00:07:07,820
أجل، ربّما

114
00:07:08,130 --> 00:07:10,450
لكن لا نملك المال الكافي

115
00:07:11,950 --> 00:07:14,060
إذاً ستذهب إذا كان ذلك مجّاناً؟

116
00:07:14,060 --> 00:07:16,700
ماذا؟ أقصد، أجل، إذا كان مجّاناً

117
00:07:17,140 --> 00:07:21,710
في الحقيقة، أعطتني ريريكا-تشان تذكرة
لشخصين للذّهاب إلى مُنتجع نبع ساخن

118
00:07:23,780 --> 00:07:24,710
ها هي

119
00:07:25,060 --> 00:07:27,660
قالت أن أذهب مع الشّخص الّذي أحبّ

120
00:07:40,750 --> 00:07:43,850
هيّا. اذهب معي

121
00:07:45,750 --> 00:07:48,610
لا مانع، صحيح؟ يمكننا أن نُغلق
المقهى لبعض الوقت

122
00:07:48,970 --> 00:07:49,630
حسناً؟

123
00:07:50,770 --> 00:07:52,610
لكن... رحلة؟

124
00:07:52,610 --> 00:07:55,710
...نحن الاثنان فقط... سيكون ذلك

125
00:07:55,710 --> 00:07:59,240
لكن ليس باليد حيلة. إنّها تذكرة لشخصين

126
00:07:59,240 --> 00:08:03,120
إذاً اذهبي مع شيراغيكو. فأنتما
صديقتان حميمتان، صحيح؟

127
00:08:03,120 --> 00:08:05,380
لماذا تقول ذلك؟

128
00:08:05,630 --> 00:08:09,050
...هل تكره فكرة الخروج معي
إلى هذه الدّرجة؟

129
00:08:09,050 --> 00:08:11,520
...لـ-لا أقول بأنّني أكره ذلك

130
00:08:12,380 --> 00:08:13,580
...إذاً

131
00:08:14,760 --> 00:08:16,320
إذاً ما المشكلة؟

132
00:08:18,760 --> 00:08:20,270
!عدنا

133
00:08:21,310 --> 00:08:24,020
!أجل، من الواضح بأنّه تسوُّس
!دعني أمعن النّظر أكثر

134
00:08:24,340 --> 00:08:26,270
ماذا تفعلان؟

135
00:08:26,270 --> 00:08:28,120
!على أي حال، انظرا إلى هذا

136
00:08:28,120 --> 00:08:33,280
ربحتُ تذكرة لشخصين إلى نُزُل نبع ساخن
!من سحب اليانصيب في حيّ التسوُّق

137
00:08:33,570 --> 00:08:34,530
ماذا؟

138
00:08:34,530 --> 00:08:36,720
هذا رائع، صحيح؟

139
00:08:36,720 --> 00:08:38,200
عُدنا

140
00:08:38,960 --> 00:08:40,500
!انظروا إلى هذا

141
00:08:40,500 --> 00:08:44,670
ربحتُ تذكرة لشخصين إلى نُزُل نبع ساخن
!من سحب اليانصيب في حيّ التسوُّق

142
00:08:45,070 --> 00:08:46,580
ماذا؟-

143
00:08:47,210 --> 00:08:50,280
شيراغيكو-سان، ربحتِ تذكرة أيضاً؟

144
00:08:50,280 --> 00:08:54,050
،لحظة، تلك التّذكرة... ريهو
!لديكِ واحدة أيضاً؟

145
00:08:54,320 --> 00:08:56,610
ربحتنّها أيضاً يا فتيات كذلك؟

146
00:08:56,610 --> 00:08:58,120
!هذا مذهل

147
00:08:58,120 --> 00:08:59,770
لدينا ما يكفي لستّة إذاً

148
00:08:59,770 --> 00:09:02,340
!مرحى! يمكننا الذّهاب جميعنا

149
00:09:04,190 --> 00:09:07,320
!كم تذكرة يوجد لشخصين بالتّحديد؟

150
00:09:07,320 --> 00:09:08,310
!ريهو-تشان؟

151
00:09:08,310 --> 00:09:10,880
!وهاياتو-كن، لا تجلس مكانك مذهولاً فحسب

152
00:09:14,200 --> 00:09:17,570
!انظروا! إنّه المُحيط

153
00:09:17,570 --> 00:09:20,010
نرى المُحيط طوال الوقت

154
00:09:20,010 --> 00:09:22,080
أنتِ مُتحمِّسة حقّاً يا أوكا-تشان

155
00:09:22,520 --> 00:09:24,920
!لأنّنا خرجنا جميعنا معاً في رحلة

156
00:09:24,920 --> 00:09:29,590
لا بدّ أنّ هذه مُكافأة من الجدّة
!على عملنا الدّؤوب

157
00:09:29,880 --> 00:09:31,580
أجل، قد تكونين على حقّ

158
00:09:31,580 --> 00:09:33,840
كيف نجحت احتمالات أن نحصل
على تذاكر لستّة أشخاص؟

159
00:09:34,140 --> 00:09:37,540
عجباً. فعلَتْها الجدّة هذه المرّة

160
00:09:37,540 --> 00:09:43,350
على أيّ حال، كان من السّخاء أن تدفع
تعرِفة ركوب الجميع في القطار

161
00:09:43,630 --> 00:09:47,210
حسناً، تُعَدُّ هذه عمليّاً كرحلة شركة

162
00:09:47,210 --> 00:09:49,860
بالإضافة إلى أنّ أسهمي
ارتفعت بشكل كبير مؤخّراً

163
00:09:49,860 --> 00:09:53,170
ما زال يفعل ذلك؟ لا يتعلّم أبداً

164
00:09:53,170 --> 00:09:55,870
آمل ألّا تنخفض من جديد فحسب

165
00:09:55,870 --> 00:09:56,740
!هذا يكفي

166
00:09:58,810 --> 00:10:01,870
على أيّ حال، آمي-تشان
هادئة جدّاً اليوم

167
00:10:04,190 --> 00:10:07,400
.لن أوبّخكِ على كلامكِ الفارغ اليوم
لن أتعب نفسي

168
00:10:11,130 --> 00:10:14,630
هذا هو المكان؟ يبدو أجمل بكثير ممّا توقّعت

169
00:10:16,120 --> 00:10:17,640
أهلاً وسهلاً

170
00:10:17,640 --> 00:10:19,120
...مذهل

171
00:10:19,120 --> 00:10:20,900
!هذا باهر الجمال

172
00:10:20,900 --> 00:10:23,260
"لدينا حجز لستّة أشخاص باسم "كاسوكابي

173
00:10:23,610 --> 00:10:26,040
شكراً لكم على السّفر إلى هنا

174
00:10:26,040 --> 00:10:29,120
،لديكم ثلاث تذاكر

175
00:10:29,120 --> 00:10:32,330
لذا سأجهّز ثلاث غرف، كل غرفة لشخصين

176
00:10:33,140 --> 00:10:34,780
...لشخصين

177
00:10:35,580 --> 00:10:37,780
...لوحدي مع هاياتو-كن

178
00:10:38,340 --> 00:10:40,190
...في نفس الغرفة...

179
00:10:41,400 --> 00:10:43,220
لنقضِ وقت استرخاء كما نشاء؟

180
00:10:44,610 --> 00:10:45,620
ما المشكلة؟

181
00:10:45,620 --> 00:10:47,240
على أحدهم أن يضحّي

182
00:10:47,240 --> 00:10:50,290
حسناً، أعتقد يمكنني تحمّل
—مُشاركة غرفة مع هايات

183
00:10:50,290 --> 00:10:52,220
!مؤلم

184
00:10:50,730 --> 00:10:53,130
كفى مُزاحاً

185
00:10:53,470 --> 00:10:55,640
حسناً، هل نفعل يا هاياتو-كن؟

186
00:10:55,640 --> 00:10:57,260
...حسناً

187
00:10:57,810 --> 00:10:59,760
ماذا تفعلين يا كيكو-تشان؟

188
00:10:59,760 --> 00:11:01,890
أنا مصدومة. لا، بجدّية

189
00:11:02,160 --> 00:11:06,010
حسناً، كفى سخافة ولنقم بقرعة سحب

190
00:11:06,010 --> 00:11:07,990
قرعة سحب؟

191
00:11:12,270 --> 00:11:16,020
.حسناً، فهمت. سأوبّخكِ بشأن النظّارة
اخلعيها فحسب

192
00:11:16,360 --> 00:11:19,530
شيراغيكو-سان، تعال إلى هنا! توجد
!أسرّة في هذه الغرفة

193
00:11:19,530 --> 00:11:23,610
حسناً... لكن لِمَ لا نستمع
إلى شرح الموظّفة أوّلاً؟

194
00:11:23,610 --> 00:11:25,850
!أتساءل كيف هو شكل دورة المياه

195
00:11:26,990 --> 00:11:29,290
حسناً، أعتقد نحن بأمان إذا كانت آمي

196
00:11:29,710 --> 00:11:32,250
ألن تتناولي بعض الفطائر؟ إنّها لذيذة

197
00:11:32,250 --> 00:11:33,310
لا أريد

198
00:11:44,550 --> 00:11:48,030
...ها هي ذي! آمل أنّها تبلي... حسناً

199
00:11:48,030 --> 00:11:48,700
ماذا؟

200
00:11:49,390 --> 00:11:51,110
لحظة، ما هذا؟

201
00:11:51,620 --> 00:11:52,890
ما معنى هذا؟

202
00:11:53,990 --> 00:11:55,650
هذا جميل حقّاً، أليس كذلك؟

203
00:11:56,110 --> 00:11:59,020
...بالفعل. إطلالة على الشّفق الخريفيّ

204
00:11:59,020 --> 00:12:01,150
بينما نجلس في حمّام هواء طلق

205
00:12:01,150 --> 00:12:02,400
لا شيء يفوق ذلك

206
00:12:02,400 --> 00:12:04,410
ماذا تفعل يا فتى؟

207
00:12:04,410 --> 00:12:06,530
!اغطس فحسب

208
00:12:06,530 --> 00:12:08,290
!لكن... لا أستطيع

209
00:12:08,290 --> 00:12:09,410
!افعلها فحسب

210
00:12:08,850 --> 00:12:10,910
ماذا؟ هاياتو-كن؟

211
00:12:09,980 --> 00:12:10,910
!اغطس

212
00:12:11,960 --> 00:12:12,790
!هذا ساخن

213
00:12:12,790 --> 00:12:15,290
يُحدِث جلبة دوماً

214
00:12:13,810 --> 00:12:15,290
...يا إلهي

215
00:12:17,100 --> 00:12:20,750
!مهلاً! إنّ **** كبير لديك يا فتى

216
00:12:21,230 --> 00:12:22,920
!إنّه أشبه بلُفافة سوشي كاملة

217
00:12:24,470 --> 00:12:26,260
!ليس كبيراً إلى هذه الدّرجة

218
00:12:26,260 --> 00:12:27,800
...لُفافة سوشي كاملة

219
00:12:28,350 --> 00:12:32,310
يا لها من طريقة لإفساد هذه
الإطلالة المذهلة

220
00:12:32,600 --> 00:12:34,410
أعتقد بأنّه كبير حقّاً

221
00:12:34,410 --> 00:12:35,530
هكذا يبدو

222
00:12:35,530 --> 00:12:37,810
مُقارنة السّوشي تجعله يبدو
حقيقيّاً أكثر لسبب ما

223
00:12:38,230 --> 00:12:40,140
!كفى كلاماً داعراً

224
00:12:40,140 --> 00:12:42,440
!وآمي-تشان، اخلعي هذه النظّارة فحسب

225
00:12:43,880 --> 00:12:48,510
هذا فظيع. ربّما سأدخل
الحمّام العائليّ لاحقاً

226
00:12:48,510 --> 00:12:50,330
ماذا؟ الحمّام العائليّ؟

227
00:12:50,330 --> 00:12:54,270
أجل. رأيتُه في دليل النُّزُل قبل قليل

228
00:12:54,270 --> 00:12:55,960
يمكن حجز حمّام مُقدّماً

229
00:12:55,960 --> 00:12:59,830
...للاستخدام الخاص لعائلتك

230
00:13:00,680 --> 00:13:01,840
ماذا؟

231
00:13:01,840 --> 00:13:03,630
لن أدعكِ تسبقينني إلى ذلك

232
00:13:03,630 --> 00:13:05,180
عـ-عمّاذا تتكلّمين؟

233
00:13:05,180 --> 00:13:06,240
ماذا عنّي إذاً؟

234
00:13:06,240 --> 00:13:07,420
!شيراغيكو-
!كيكو-تشان-

235
00:13:08,050 --> 00:13:09,720
...سَخُن جسدي

236
00:13:10,510 --> 00:13:14,600
صحيح... عليّ أن أسأل ريريكا
عن حال ساتشيكو

237
00:13:14,600 --> 00:13:17,650
...يأكل الكثير من الطّعام

238
00:13:17,650 --> 00:13:18,860
عُدت

239
00:13:20,460 --> 00:13:23,630
...أ-أنتِ. كنتِ في الحمّام

240
00:13:23,630 --> 00:13:25,110
...منذ مدّة طويلة

241
00:13:25,420 --> 00:13:28,180
قالوا بأنّ العشاء جاهز

242
00:13:28,180 --> 00:13:28,980
هيّا بنا

243
00:13:28,980 --> 00:13:29,740
!انتظري

244
00:13:30,260 --> 00:13:32,740
ماذا؟ الجميع ينتظرون

245
00:13:33,300 --> 00:13:34,500
...هل هناك

246
00:13:34,900 --> 00:13:38,260
هل هناك شخص لا تريدين رؤيته هنا؟

247
00:13:39,530 --> 00:13:43,260
هدأتِ فجأة بعد أن علمتِ
،بأنّنا سوف نأتي إلى هنا

248
00:13:43,260 --> 00:13:46,380
.ولا يمكن أن تكون هذه النظّارة للفُكاهة
كنتِ تضعينها منذ مدّة طويلة

249
00:13:47,090 --> 00:13:50,500
ذكرتِ من قبل بأنّكِ ترعرعتِ
في منطقة توهاكو، صحيح؟

250
00:13:51,140 --> 00:13:54,590
هذا موطنكِ في الأساس، أليس كذلك؟

251
00:13:54,590 --> 00:13:57,140
!بالطّبع لا

252
00:13:57,140 --> 00:14:00,420
الاستمرار في نفس الفُكاهة هو نوع من الكوميديا

253
00:14:00,420 --> 00:14:01,880
ألم تكن مُضحكة؟

254
00:14:01,880 --> 00:14:04,660
حتّى أثناء الاستراحة الطّويلة وموسم
الأوبون، اختلقتِ أعذاراً

255
00:14:04,660 --> 00:14:06,330
لتجنُّب العودة إلى الدّيار

256
00:14:06,860 --> 00:14:10,420
...حسناً إذاً! بالنّسبة للمرحلة الثّانية

257
00:14:10,420 --> 00:14:12,120
سأعتمد هذه

258
00:14:13,370 --> 00:14:16,120
!أنتِ! هل تسمعينني؟

259
00:14:16,120 --> 00:14:18,420
!بسرعة يا هاياتشي

260
00:14:30,870 --> 00:14:34,760
!يبدو لذيذاً جدّاً

261
00:14:35,420 --> 00:14:38,480
يا جماعة! من أين ينبغي أن نبدأ؟

262
00:14:41,270 --> 00:14:44,650
ما-ما الّذي يجري؟ لماذا هذا الهدوء؟

263
00:14:45,070 --> 00:14:47,840
إذاً ما رأيكن بحجز الحمّام العائليّ

264
00:14:47,840 --> 00:14:51,100
وجعل هاياتو-كن يغطس فيه بنفسه؟

265
00:14:49,150 --> 00:14:50,630
كلّ شيء هنا يبدو خلّاباً

266
00:14:51,100 --> 00:14:52,570
لا اعتراضات على ذلك؟

267
00:14:51,240 --> 00:14:53,450
هل مصدر كافّة المكوِّنات محلّي؟

268
00:14:52,570 --> 00:14:53,740
أنا أعترض

269
00:14:53,740 --> 00:14:54,780
ماذا؟

270
00:14:55,210 --> 00:14:58,800
إنّه ليس من النّوع الّذي يوافق إذا طلبتْ
إحدانا الدّخول معه لوحدهما

271
00:14:58,800 --> 00:14:59,960
أجل

272
00:14:59,960 --> 00:15:00,920
ماذا؟

273
00:15:04,320 --> 00:15:05,300
!إنّه شهيّ

274
00:15:05,650 --> 00:15:08,120
...لكن إذا انضمّت إحدانا له لاحقاً

275
00:15:08,120 --> 00:15:11,790
سيرتعد قليلاً غالباً، لكن
لا أعتقد بأنّه سيهرب

276
00:15:11,790 --> 00:15:14,570
أجل. من الأفضل أن نكون لحوحات قليلاً

277
00:15:14,570 --> 00:15:17,930
يبدو من النّوع الّذي يرضخ بسهولة للضّغوطات

278
00:15:18,250 --> 00:15:21,330
لم نعُد فتيات مدرسة إعداديّة بعد الآن

279
00:15:21,330 --> 00:15:23,560
ينبغي أن نتوقّف عن صدّ بعضنا الآخر

280
00:15:23,980 --> 00:15:26,490
يمكننا أن نتّفق بأن ندخل معه جميعنا

281
00:15:26,490 --> 00:15:29,110
وألّا نعترض طريق بعضنا، صحيح؟

282
00:15:29,950 --> 00:15:31,290
أنا موافقة

283
00:15:31,290 --> 00:15:34,180
،الحجز الفرديّ مدّته 30 دقيقة

284
00:15:34,180 --> 00:15:36,200
ما يمنحنا عشر دقائق لكلّ واحدة منّا

285
00:15:36,590 --> 00:15:38,450
...هذا جيّد، لكن

286
00:15:38,450 --> 00:15:43,080
ينبغي أن نقرّر على الأقلّ ما هي
الحدود الّتي ينبغي أن نلتزم بها

287
00:15:43,330 --> 00:15:46,420
أقترح أن نفعل ما نشاء ونتخطّى كلّ الحدود

288
00:15:46,420 --> 00:15:47,960
...لـ-لكن

289
00:15:48,240 --> 00:15:51,840
هذا يعني أنّ ترتيب دخولنا
سيُشكّل فرقاً كبيراً

290
00:15:53,090 --> 00:15:55,240
هذه وجهة نظر جيّدة

291
00:15:55,710 --> 00:16:00,980
إذا قام هاياتو بـ ***، فقد تكون
**** عشر دقائق كافية لـ

292
00:16:01,330 --> 00:16:06,110
ثمّ إذا هو **** ، فكائناً من يأتي
لاحقاً سيكون في موقف سلبيّ

293
00:16:07,490 --> 00:16:09,970
،**** لكن من ناحية أخرى، إذا هو

294
00:16:09,970 --> 00:16:11,990
فمن يأتي تالياً سيحظى بالأفضليّة

295
00:16:11,990 --> 00:16:14,490
فهمت. ستكون مُجازفة إذاً

296
00:16:14,490 --> 00:16:20,000
!لكن ***** سيكون كثيراً جدّاً

297
00:16:21,310 --> 00:16:23,860
!يمكننا الدّخول جميعنا في آن واحد حينها

298
00:16:23,860 --> 00:16:25,150
!نحن عائلة

299
00:16:25,150 --> 00:16:28,800
هلّا توقّفتن عن ذلك؟! أنتن
!تجعلنَ هذه الرّحلة غريبة

300
00:16:28,800 --> 00:16:31,020
!هلّا أخفضتُن أصواتكن؟

301
00:16:33,790 --> 00:16:37,090
آمي، من المؤكّد أنّكِ تواجهين مشكلة

302
00:16:37,090 --> 00:16:38,160
آمي-تشان؟

303
00:16:39,890 --> 00:16:44,810
هذه أنتِ، أليس كذلك؟ كان يجدر بكِ
أن تخبريني بأنّكِ عائدة إلى المنزل

304
00:16:46,400 --> 00:16:49,260
أنا آسفة على مُقاطعة وجبتكم

305
00:16:49,890 --> 00:16:52,900
آمي-تشان، تواصلي معي طاقم النُّزُل

306
00:16:53,170 --> 00:16:55,940
أخبروني بأنّ شخصاً يشبهكِ يقيم هنا

307
00:16:56,770 --> 00:16:59,030
حسناً، من قد تكونين؟

308
00:16:59,360 --> 00:17:03,160
أنا متأكّدة بأنّ جدّتي تتمنّى رؤيتكِ أيضاً

309
00:17:04,880 --> 00:17:07,290
!لحظة، تقصدين بأنّ جدّتي تحسّنت؟

310
00:17:07,930 --> 00:17:08,720
ماذا؟

311
00:17:09,500 --> 00:17:10,920
...فـ-في الواقع

312
00:17:13,690 --> 00:17:16,180
طفلة من أنتِ؟

313
00:17:20,450 --> 00:17:22,330
!أنتِ كاذبة يا إيري-نيتشان

314
00:17:22,330 --> 00:17:24,680
قلتُ بأنّني لن أعود إلى المنزل
!ما لم تتعافَ

315
00:17:25,110 --> 00:17:26,440
...آمي-تشان

316
00:17:27,950 --> 00:17:31,260
فقدت والديها بحادِث عندما كانت صغيرة

317
00:17:31,780 --> 00:17:34,070
جدّتها هي الوحيدة المُتبقّية من أقربائها

318
00:17:34,950 --> 00:17:37,210
،بعد الحادثة بفترة قصيرة

319
00:17:37,210 --> 00:17:39,680
،أنشأت جدّتُها عملاً سمّته بالبيت العائليّ

320
00:17:39,680 --> 00:17:44,080
حيث تبنّت ورعت أطفالاً ذوي
حالات مضطربة مختلفة

321
00:17:44,580 --> 00:17:47,020
،كنتُ تحت رعايتها في فترة وجودي في المدرسة

322
00:17:47,020 --> 00:17:50,140
وكنتُ أعينها حتّى الآونة الأخيرة

323
00:17:51,320 --> 00:17:55,590
كانت جدّتي تعمل في طوكيو
مع إقامة عندما كانت صغيرة

324
00:17:55,890 --> 00:17:58,720
قالت بأنّ الوقت الّذي قضَتْه مع زميلاتها
في العمل والعائلة هناك

325
00:17:58,720 --> 00:18:01,120
كان مُمتعاً جدّاً بالنّسبة لها

326
00:18:01,880 --> 00:18:06,060
لعلّ هذا هو سبب قرارها بافتتاح البيت

327
00:18:06,680 --> 00:18:10,730
وهل... هل تعاني جدّة آمي-تشان من مشكلة؟

328
00:18:11,070 --> 00:18:14,360
قالت بأنّها لن تعود إلى المنزل
حتّى تتعافى جدّتها

329
00:18:14,360 --> 00:18:17,610
أليس هذا سبباً آخر يدفع
للعودة إلى المنزل أسرع؟

330
00:18:17,990 --> 00:18:21,330
أجل... أعتقد أنّ هذا صحيح

331
00:18:21,330 --> 00:18:22,490
...لكن

332
00:18:22,760 --> 00:18:25,740
،عندما عادت آمي-تشان إلى المنزل في مارس

333
00:18:25,740 --> 00:18:27,870
أُصيبَتْ بصدمة حقيقيّة

334
00:18:28,440 --> 00:18:30,630
!عدتُ يا جدّتي

335
00:18:31,950 --> 00:18:33,250
!جدّتي

336
00:18:33,820 --> 00:18:36,630
مـ... من أنتِ الآن؟

337
00:18:37,950 --> 00:18:40,640
!آسفة! هذه أنا، آمي

338
00:18:42,180 --> 00:18:43,640
جدّتي؟

339
00:18:43,890 --> 00:18:46,800
طفلة من أنتِ؟

340
00:18:51,240 --> 00:18:52,600
فهمت

341
00:18:53,910 --> 00:18:56,780
إنّها مثلي

342
00:18:57,470 --> 00:18:59,780
...لا، من ناحية

343
00:19:01,310 --> 00:19:03,210
حالها أسوأ حتّى

344
00:19:31,720 --> 00:19:33,190
...هاياتشي

345
00:19:33,930 --> 00:19:35,060
ماذا؟

346
00:19:36,090 --> 00:19:39,220
هل يمكنني... النّوم بجانبك؟

347
00:19:45,530 --> 00:19:47,060
إذا أردت

348
00:19:48,250 --> 00:19:52,070
هل أخبرتك إيري-نيتشان... عن جدّتي؟

349
00:19:52,860 --> 00:19:53,720
أجل

350
00:19:54,440 --> 00:19:58,100
يبدو أنّها بحالة سيّئة جدّاً لدرجة لم تعُد
قادرة فيه على العناية بالأطفال

351
00:19:58,590 --> 00:20:00,920
،ولم تستطع العيش بمفردها

352
00:20:00,920 --> 00:20:03,480
لذا وضعتها أختكِ بالتبنّي في دار تمريض

353
00:20:04,210 --> 00:20:09,100
لكن بعد فترة قريبة، سيخترعون
دواء أفضل، صحيح؟

354
00:20:11,100 --> 00:20:15,360
وإذا تناولته، ستعود جدّتي إلى ما كانت
عليه، أليس كذلك؟

355
00:20:16,340 --> 00:20:19,510
حينها ستتذكّر من أكون، صحيح؟

356
00:20:20,450 --> 00:20:23,350
حسناً... أعتقد هذا احتمال وارد

357
00:20:23,740 --> 00:20:26,360
لذا لن أعود إلى المنزل قبل ذلك الحين

358
00:20:26,360 --> 00:20:29,120
الجدّة الّتي هناك الآن ليست
...الحقيقيّة، لذلك

359
00:20:29,740 --> 00:20:30,730
لن أراها

360
00:20:31,620 --> 00:20:34,870
فهمت. حسناً، إنّها حياتكِ

361
00:20:35,200 --> 00:20:37,220
يمكنكِ فعل ما تشائين

362
00:20:38,090 --> 00:20:38,920
أجل

363
00:20:40,630 --> 00:20:45,000
...لكن لمعلوماتكِ فقط

364
00:20:46,850 --> 00:20:48,970
حتّى يومنا هذا، ما زلتُ نادماً

365
00:20:49,900 --> 00:20:54,310
على عدم رؤية جدّتي بينما
كانت لا تزال على قيد الحياة

366
00:20:59,330 --> 00:21:02,300
حسناً، تصبحين على خير

367
00:21:10,430 --> 00:21:12,660
ماذا تفعلين أيّتها الجنديّة تاتسوتا؟

368
00:21:13,190 --> 00:21:16,080
كم فنجاناً يجب أن تكسري؟

369
00:21:17,410 --> 00:21:18,920
!تعثّرت

370
00:21:18,920 --> 00:21:20,170
—أيّتها

371
00:21:20,170 --> 00:21:22,120
!آ-آسفة يا قائد

372
00:21:22,730 --> 00:21:24,100
...بئس الأمر

373
00:21:24,100 --> 00:21:26,430
إنّها مُشاكسة حقّاً، أليس كذلك؟

374
00:21:27,540 --> 00:21:32,000
،اعتنِ بكاتسويو-تشان لأجلي
اتّفقنا يا هاياتو؟

375
00:21:40,050 --> 00:21:41,910
...مجرّد حلم

376
00:21:42,660 --> 00:21:45,020
لماذا رأيتُ جدّتي في أيّام شبابها؟

377
00:21:45,540 --> 00:21:48,800
صباح الخير يا هاياتشي! استيقظت أخيراً؟

378
00:21:48,800 --> 00:21:50,840
!الفطور جاهز

379
00:21:51,990 --> 00:21:54,700
ما الأمر؟ أراكِ مبتهجة فجأة

380
00:21:55,020 --> 00:21:57,980
!هذه هي طبيعتي

381
00:21:57,980 --> 00:22:00,460
!يجب أن يكون بطل العدالة مبتهجاً دوماً

382
00:22:03,980 --> 00:22:08,260
هاياتشي... سأذهب لرؤية جدّتي

383
00:22:08,700 --> 00:22:09,970
هكذا إذاً

384
00:23:40,590 --> 00:23:43,470
كيف ربحنا جميعنا تذاكر نُزُل نبع
!ساخن في سحب اليانصيب؟

385
00:23:43,470 --> 00:23:46,190
تمتلك الشّخصيّات الرّئيسيّة في الكوميديا
الرّومانسيّة قوّة خاصّة

386
00:23:46,190 --> 00:23:48,780
تجعلهم يجذبون التّذاكر لشخصين
من سحب اليانصيب

387
00:23:48,780 --> 00:23:50,350
!إنّها قوّة خاصّة؟

388
00:23:50,350 --> 00:23:51,940
لا يوجد تفسير آخر

389
00:23:51,940 --> 00:23:54,680
أشعر بأنّنا لا ينبغي أن نتطرّق
...إلى هذا الموضوع أكثر