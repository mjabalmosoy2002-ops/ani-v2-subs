1
00:00:00,620 --> 00:00:03,480
!ينبغي أن تفعليها قطعاً يا سينباي

2
00:00:03,840 --> 00:00:04,880
حقّاً؟

3
00:00:04,880 --> 00:00:06,720
!بالطّبع ينبغي لكِ ذلك

4
00:00:06,720 --> 00:00:08,360
!هذه فُرصتك الذّهبيّة

5
00:00:08,360 --> 00:00:09,780
!يجب أن تفعليها

6
00:00:10,060 --> 00:00:11,780
ما كلّ هذه الضجّة هنا؟

7
00:00:11,780 --> 00:00:14,510
حصلتْ سينباي على عرض
!للتّمثيل في دراما تلفزيونيّة

8
00:00:14,510 --> 00:00:16,500
!برنامج تحرّيات شهير جدّاً

9
00:00:16,500 --> 00:00:17,030
—مهلاً

10
00:00:17,030 --> 00:00:18,830
!الشّرطة الذّهبيّة

11
00:00:18,830 --> 00:00:19,480
ماذا؟

12
00:00:19,790 --> 00:00:23,290
المُخرج الّذي ظهر في كوخ الشّاطئ
...لإجراء مُقابلة معي

13
00:00:23,690 --> 00:00:26,290
!لديّ الدّور المثاليّ لكِ

14
00:00:26,290 --> 00:00:28,260
ما رأيكِ؟ أتريدين تجربة ذلك؟

15
00:00:28,790 --> 00:00:29,690
قال ذلك...

16
00:00:29,690 --> 00:00:31,310
لِمَ لا تقبلين إذاً؟

17
00:00:31,730 --> 00:00:34,680
...لكن لديّ مناوبة في المقهى في ذلك اليوم

18
00:00:34,680 --> 00:00:37,760
!ستحلّ إحدى الفتيات الأُخريات مكانكِ

19
00:00:37,760 --> 00:00:41,310
!لكن هذا عمل لا يستطيع سواكِ فعله

20
00:00:41,310 --> 00:00:42,560
حقّاً؟

21
00:00:42,560 --> 00:00:44,850
—أجل، أيّتها الغبـ

22
00:00:44,850 --> 00:00:45,560
المعذرة؟

23
00:00:46,190 --> 00:00:47,940
آسفة

24
00:00:48,420 --> 00:00:49,760
...رغم ذلك

25
00:00:49,760 --> 00:00:53,190
المقصد هو أنّكِ إذا أثبتِّ له
،كم أنتِ مُتألِّقة في التّلفزيون

26
00:00:53,190 --> 00:00:57,050
!سيحبّكِ هاياتو-كن أكثر حتّى

27
00:00:57,860 --> 00:00:58,510
ماذا؟

28
00:01:01,400 --> 00:01:04,180
!حسناً! سوف أفعلها

29
00:01:05,310 --> 00:01:07,800
تسوكياما ريسا، العمر 21

30
00:01:07,800 --> 00:01:11,460
كانت مُمثّلة طفلة عبقريّة، لكن
،لم تعُد تحصل على أعمال تلفزيونيّة

31
00:01:11,460 --> 00:01:14,120
لذا بدأتْ بالعمل بدوام جزئيّ في مقهى

32
00:01:14,120 --> 00:01:16,670
أتعتقد بأنّه كان انتحاراً يا ساكيو-سان؟

33
00:01:16,670 --> 00:01:17,970
لا أستطيع الجزم

34
00:01:17,970 --> 00:01:23,390
نظراً للحياة الّتي عاشتها، هذا منطقيّ

35
00:01:18,570 --> 00:01:19,950
ما هذا الدّور؟

36
00:01:19,950 --> 00:01:22,970
قال بأنّه الدّور المثاليّ لي، أليس كذلك؟

37
00:01:23,400 --> 00:01:26,480
بل أرى أنّهم بنوا هذا الدّور عليّ

38
00:01:26,480 --> 00:01:28,890
سأضرب ذلك المُخرج

39
00:01:28,890 --> 00:01:31,150
أقسم بأنّني سأوسعه ضرباً لاحقاً

40
00:01:31,150 --> 00:01:33,480
!حسناً، إيقاف! انتهينا

41
00:01:34,120 --> 00:01:36,240
!كان ذلك رائعاً

42
00:01:36,610 --> 00:01:39,620
!لعبتِ دور جثّة بشكل ممتاز يا ريهو-تشان

43
00:01:39,880 --> 00:01:41,590
—هذا ما توقّعتُه من طفلة عبقـ

44
00:01:44,360 --> 00:01:46,010
!اللّعنة عليك

45
00:01:46,010 --> 00:01:48,390
!ماذا؟ ماذا؟! ما الأمر يا ريهو-تشان؟

46
00:03:19,590 --> 00:03:22,130
لا بدّ أنّ التّصوير سيبدأ الآن

47
00:03:22,130 --> 00:03:23,930
إنّها غالباً فقرة قصيرة

48
00:03:23,930 --> 00:03:27,510
!مستحيل! طلب من ريهو-سان فعلها شخصيّاً

49
00:03:27,510 --> 00:03:29,140
!إنّه دور رئيسيّ

50
00:03:29,140 --> 00:03:31,480
!أتساءل ما نوع الوحش الّذي ستقتله

51
00:03:31,480 --> 00:03:32,920
...لا أدري

52
00:03:37,150 --> 00:03:38,900
!لـ-لحظة، ليس ثانية

53
00:03:44,350 --> 00:03:45,490
...ا-المعذرة

54
00:03:46,050 --> 00:03:47,870
هل أنت من عائلة هوجو؟

55
00:03:47,870 --> 00:03:49,020
ماذا؟

56
00:03:49,020 --> 00:03:50,120
...أ-أقصد

57
00:03:50,120 --> 00:03:52,800
اجلس حيث تريد من فضلك

58
00:03:52,800 --> 00:03:54,120
ربّما لا

59
00:03:56,810 --> 00:03:58,570
مضى على وجوده ستّ ساعات الآن

60
00:03:59,140 --> 00:04:04,280
وأليس من الغريب ألّا يخلع قبّعته
ومعطفه في المقهى؟

61
00:04:05,220 --> 00:04:07,390
قد يكون مُنحرفاً

62
00:04:07,710 --> 00:04:10,130
تتفوّهين بكلام عجيب مرّة أخرى

63
00:04:10,130 --> 00:04:13,270
أنا واثق بأنّه لا يرتدي شيئاً
!من الخصر إلى ما دون

64
00:04:13,270 --> 00:04:15,660
لا، رأيتُ بنطاله

65
00:04:15,660 --> 00:04:17,550
!إذاً وصولاً إلى الرّكبة

66
00:04:17,550 --> 00:04:19,280
!ماذا يُسمّى هذا حينها؟

67
00:04:19,280 --> 00:04:21,600
!سيخلع ملابسه أمامنا فجأة

68
00:04:21,600 --> 00:04:23,470
لن يكون حينها مجرّد اختلاس نظر
كما حدث معك

69
00:04:23,470 --> 00:04:25,280
!سيكون بكامل شكله

70
00:04:26,690 --> 00:04:30,890
...لا! كنتُ قد نسيتُ الشّيء الخاصّ بهاياتو-كن

71
00:04:30,890 --> 00:04:33,120
!لماذا أقحمتِني في الأمر؟

72
00:04:33,120 --> 00:04:34,290
المعذرة

73
00:04:34,660 --> 00:04:37,000
هل لي بلحظة؟

74
00:04:37,000 --> 00:04:39,220
حسناً، اذهبي

75
00:04:39,220 --> 00:04:40,910
ولماذا أنا؟

76
00:04:43,190 --> 00:04:45,720
هـ-هل تريد أن تطلب؟

77
00:04:46,870 --> 00:04:49,720
...المعذرة... هل من شيء

78
00:04:51,400 --> 00:04:54,630
أريد أن أريكِ شيئاً

79
00:05:00,190 --> 00:05:02,810
!لا! النّجدة

80
00:05:02,810 --> 00:05:04,030
!ا-انتظري

81
00:05:04,030 --> 00:05:05,900
!كنتُ مُحقّة إذاً

82
00:05:08,660 --> 00:05:10,660
...وغد مثلك يستحقّ

83
00:05:11,410 --> 00:05:13,000
!هذا

84
00:05:17,690 --> 00:05:18,920
...دارتْ به

85
00:05:19,220 --> 00:05:21,800
ألم تُبالغي؟ كدتِ تقتلينه

86
00:05:21,800 --> 00:05:24,170
!هذه حركة بايلدرايفر الدوّارة

87
00:05:24,840 --> 00:05:29,180
!سأدافع عن سلام عالمنا وفتيات هذا المقهى

88
00:05:29,180 --> 00:05:32,110
!حمقاء! ماذا فعلتِ لزبوننا للتو؟

89
00:05:32,110 --> 00:05:35,090
!إنّه ليس زبوناً! إنّه شخص سيّئ

90
00:05:35,090 --> 00:05:36,560
عُدت

91
00:05:36,910 --> 00:05:41,820
ما كلّ هذه الضجّة هنا؟
...سمعتُكم... من الخارج

92
00:05:45,690 --> 00:05:47,350
!أبي

93
00:05:50,770 --> 00:05:52,050
...المعذرة

94
00:05:52,050 --> 00:05:54,330
!نحن آسفتان جدّاً

95
00:05:55,290 --> 00:05:56,880
لا مُشكلة

96
00:05:57,540 --> 00:05:59,790
فهمنا. انصرفا فحسب

97
00:05:59,790 --> 00:06:02,010
نريد نحن الثّلاثة أن نتكلّم هنا

98
00:06:05,510 --> 00:06:08,490
حسناً، ما سبب مجيئك إلى هنا؟

99
00:06:09,430 --> 00:06:12,440
أردتُ رؤية ريهو حقّاً

100
00:06:13,510 --> 00:06:17,020
تنكّرتُ وجئتُ إلى هنا
،للاطمئنان عليها

101
00:06:17,020 --> 00:06:19,340
،لكن انتظرتُ لساعات ولم تأتِ

102
00:06:19,340 --> 00:06:22,070
لذ قرّرتُ أخيراً أن أسأل فحسب

103
00:06:22,570 --> 00:06:24,490
،ارتأيتُ بأنّني إذا أظهرتُ هذه الصُّورة

104
00:06:24,490 --> 00:06:27,020
ستعرفون بأنّني والدها

105
00:06:28,840 --> 00:06:30,540
!نحن آسفتان حقّاً

106
00:06:30,540 --> 00:06:31,820
!اخرجا

107
00:06:32,120 --> 00:06:35,210
لا مُشكلة. أريدهما أن يسمعا هذا أيضاً

108
00:06:35,210 --> 00:06:36,870
إنّهما عائلتي الآن

109
00:06:37,930 --> 00:06:42,250
لكن تفاجأتُ عندما علمتُ بأنّكِ تعملين هنا

110
00:06:43,450 --> 00:06:45,500
،عندما كنتِ لا تزالين صغيرة

111
00:06:46,120 --> 00:06:50,980
أتَتْ عائلتنا بأكملها إلى هذه المنطقة في نزهة

112
00:06:53,140 --> 00:06:58,470
لذا كنّا هنا من قبل، عندما كانت
جدّتك لا تزال حيّة

113
00:07:00,360 --> 00:07:01,940
...هكذا إذاً

114
00:07:01,940 --> 00:07:05,900
هذه صورة التقطتها زوجتي في ذلك اليوم

115
00:07:06,680 --> 00:07:08,540
إنّه كنزي الأثمن

116
00:07:09,410 --> 00:07:11,890
لماذا اختفيت فجأة إذاً؟

117
00:07:11,890 --> 00:07:15,700
غادرتَ دون سابق إنذار عندما كانت
ريهو-سان لا تزال صغيرة، أليس كذلك؟

118
00:07:15,700 --> 00:07:18,410
لماذا لم تستطيعوا أنتم الثّلاثة
!الاستمرار في العيش معاً؟

119
00:07:18,410 --> 00:07:19,910
رويدكِ يا آمي-تشان

120
00:07:20,460 --> 00:07:24,490
،بينما بدأت ريهو تشتهر كمُمثّلة طفلة

121
00:07:24,490 --> 00:07:26,550
تغيّرت زوجتي

122
00:07:27,330 --> 00:07:30,940
كانت قد تخلّت عن الأعمال التّلفزيونيّة
،عندما لم يتحقّق حلمها

123
00:07:30,940 --> 00:07:34,900
لذا أعتقد بأنّها أرادت باستماتة
من ابنتها أن تنجح

124
00:07:36,350 --> 00:07:38,780
،اختلفنا على كيفيّة تربيتها

125
00:07:38,780 --> 00:07:40,890
وسرعان ما تفاقم الأمر إلى شِجار

126
00:07:41,970 --> 00:07:46,140
ذات يوم، استدعتني إلى المحكمة
...من أجل إجراءات طلاق

127
00:07:46,930 --> 00:07:51,700
وكنتُ قد وعدتُ بألّا أرى ابنتي
حتّى تبلغ سنّ العشرين

128
00:07:52,020 --> 00:07:52,800
!ماذا؟

129
00:07:52,800 --> 00:07:56,330
إذاً لم تتخلّ عنّي فحسب؟

130
00:07:57,130 --> 00:07:59,850
أنا آسف. كلّها مجرّد أعذار

131
00:08:00,620 --> 00:08:02,920
أعلم بأنّني جرحتُكِ

132
00:08:10,970 --> 00:08:13,400
لا عليك. مجرّد معرفة ذلك تكفيني

133
00:08:14,180 --> 00:08:16,470
شكراً يا أبي

134
00:08:16,800 --> 00:08:19,440
!كلّا يا ريهو-سان! لا تدعيه يخدعكِ

135
00:08:19,440 --> 00:08:20,410
!أجل

136
00:08:20,410 --> 00:08:23,730
لماذا لم تأتِ لرؤيتها حالما بلغت
!سنَّ العشرين إذاً؟

137
00:08:23,730 --> 00:08:26,730
أردتُ رؤيتها في أسرع وقت مُمكن بالطّبع

138
00:08:27,170 --> 00:08:32,110
لكن عندما كبرتْ ريهو، لم تعُد
تظهر في التّلفزيون كثيراً

139
00:08:32,860 --> 00:08:37,240
قلتُ لنفسي بأنّها إذا كانت تستمتع
...بالحياة كفتاة عاديّة الآن

140
00:08:37,660 --> 00:08:40,880
...إذا كان لديها عائلة جديدة بالفعل

141
00:08:41,790 --> 00:08:44,370
فما الفائدة من ظهوري وتصرُّفي كأبٍ لها؟

142
00:08:44,910 --> 00:08:47,290
سأكون عقبة في وجهها فحسب

143
00:08:47,290 --> 00:08:48,750
!نحن آسفتان جدّاً

144
00:08:49,550 --> 00:08:52,150
هذا ما قلتُه لنفسي على الأقلّ

145
00:08:52,150 --> 00:08:54,910
حتّى رأيتُ فيديو الأخبار الأخيرة ذاك

146
00:08:56,050 --> 00:08:57,970
،قالوا فيه بأنّها عانت كثيراً

147
00:08:57,970 --> 00:09:01,500
وغادرت المنزل وأصبحت الآن عاملة
بدوام جزئيّ في مقهى

148
00:09:01,990 --> 00:09:03,480
،عندما علمتُ بذلك

149
00:09:03,770 --> 00:09:09,270
،رحتُ لرؤية زوجتي، بالأحرى، زوجتي السّابقة
وأسألها عمّا يجري

150
00:09:13,610 --> 00:09:17,400
من؟ إذا أردت مالاً، فلا أملك مالاً

151
00:09:17,400 --> 00:09:18,620
!مهلاً يا روري

152
00:09:18,620 --> 00:09:20,230
!ماذا حدث هنا؟

153
00:09:22,570 --> 00:09:25,620
هذا أنت فقط

154
00:09:26,030 --> 00:09:27,370
!ماذا حدث لريهو؟

155
00:09:27,950 --> 00:09:31,190
لا أدري. أنا متأكّدة بأنّها تعيش
في مكانٍ ما

156
00:09:34,050 --> 00:09:35,510
...هذا فظيع

157
00:09:36,350 --> 00:09:39,260
عملتِ بجدٍّ بمفردكِ

158
00:09:44,420 --> 00:09:46,040
!من فضلك ضعني بعين الاعتبار

159
00:09:46,040 --> 00:09:48,530
...لا أدري ماذا أفعل

160
00:09:48,530 --> 00:09:50,170
!سأقبل بأيّ دور

161
00:09:51,380 --> 00:09:52,400
!أمّي

162
00:09:52,730 --> 00:09:55,780
حصلتُ على دور عابرة سبيل
!في مشهد تذكُّر للماضي

163
00:09:56,830 --> 00:09:58,910
استسلمي فحسب. أنتِ مُثيرة للشّفقة

164
00:09:58,910 --> 00:10:00,880
أنتِ تحرجينني

165
00:10:00,880 --> 00:10:04,660
!لكن إذا لم أعمل بجدّ، فلن يساعدني أحد

166
00:10:05,640 --> 00:10:08,030
!وهذا ما يجعلكِ مزعجة

167
00:10:08,030 --> 00:10:10,140
!أنتِ كثيرة التّنازُلات

168
00:10:10,140 --> 00:10:13,740
!تستفزّينني عندما تنظرين إليّ بهذا الشّكل

169
00:10:21,340 --> 00:10:23,500
ماذا؟ زبونة؟

170
00:10:23,500 --> 00:10:25,180
...أغلقنا اليوم بالفعل

171
00:10:25,460 --> 00:10:28,940
هل أتيتِ إلى هنا كزبونة من قبل؟

172
00:10:29,480 --> 00:10:32,190
...أجل، قبل مدّة طويلة

173
00:10:32,750 --> 00:10:35,800
...مع أبي... وأمّي

174
00:10:38,730 --> 00:10:41,320
هذا فظيع حقّاً

175
00:10:41,950 --> 00:10:46,830
في هذه الحالة، هل تريدين العيش
هنا والعمل معي بدوام جزئيّ؟

176
00:10:47,090 --> 00:10:48,730
...ماذا؟ لكن

177
00:10:49,850 --> 00:10:53,090
يمكنكِ العيش لأجل نفسكِ فطق

178
00:10:53,540 --> 00:10:57,210
،إن كان هناك ما تريدين فعله
فافعليه فحسب

179
00:10:59,490 --> 00:11:02,550
سأعتني بكِ

180
00:11:02,550 --> 00:11:05,610
يمكنكِ البقاء هنا وألّا تقلقي
حيال أيّ شيء آخر

181
00:11:08,280 --> 00:11:11,860
وجدتُ مكاناً حيث أريد أن أعمل
وأقيم فيه بنفس الوقت

182
00:11:13,140 --> 00:11:15,730
إن كنتِ ستُغادرين، فهلّا أسرعتِ؟

183
00:11:15,730 --> 00:11:17,690
هل ظننتِ بأنّكِ سأمنعكِ؟

184
00:11:18,570 --> 00:11:20,660
لِمَ تقولين كلاماً كهذا؟

185
00:11:21,360 --> 00:11:23,910
!بئساً، أنتِ مزعجة للغاية

186
00:11:23,910 --> 00:11:27,240
،لو كنتُ أعلم بأنّكِ ستكونين هكذا
!لما أنجبتُكِ أبداً

187
00:11:35,290 --> 00:11:39,140
!أنا بخير! لديّ عائلة كبيرة الآن

188
00:11:41,350 --> 00:11:44,410
!هذا صحيح! نحن عائلة ريهو-سان

189
00:11:44,410 --> 00:11:45,970
يمكنكِ البقاء هنا على المدى الطّويل

190
00:11:45,970 --> 00:11:48,970
لا سبب يدفعكِ لرؤية أمّ كهذه ثانية

191
00:11:48,970 --> 00:11:53,380
في الحقيقة، هلّا ذهبتِ وقابلتِها
ولو لمرّة فقط؟

192
00:11:54,350 --> 00:11:59,580
اعذرني على كلامي، لكن لا أعتقد
بأنّ رؤيتها الآن سيحلُّ شيئاً

193
00:12:00,270 --> 00:12:02,490
...أعلم. لكن

194
00:12:03,660 --> 00:12:05,380
إنّها مُصابة بسرطان مُزمن

195
00:12:05,860 --> 00:12:07,990
قالوا لها بأنّها ستعيش ثلاثة أشهر

196
00:12:11,860 --> 00:12:14,820
،ما رأيكم؟ لا يزال هذا المقطع غير المُحرّر

197
00:12:14,820 --> 00:12:17,140
!لكن أصررتُ على أن يرسله لي المُخرج

198
00:12:17,140 --> 00:12:19,290
أُجيد التّمثيل كجثّة، صحيح؟

199
00:12:19,290 --> 00:12:21,260
...أ... أجل

200
00:12:21,700 --> 00:12:23,180
ماذا؟ هل هذا غريب؟

201
00:12:23,180 --> 00:12:25,810
...الأمر ليس كذلك. في الواقع

202
00:12:25,810 --> 00:12:29,110
الأهمّ من ذلك، ماذا ستفعلين
بخصوص أمّكِ؟

203
00:12:30,140 --> 00:12:32,190
هل أخبرتِها يا أوكا-تشان؟

204
00:12:32,190 --> 00:12:37,230
فـ-في الواقع... بما أنّنا عائلة، فلم يبدُ
...من الصّواب الاحتفاظ بذلك سرّاً

205
00:12:37,930 --> 00:12:40,280
لا أعرف حقّاً كيف أُجيب على ذلك

206
00:12:40,280 --> 00:12:44,150
ليس وكأنّها ستتعافى من السّرطان إذا زرتُها

207
00:12:44,590 --> 00:12:47,460
متى يظهر الوحش؟

208
00:12:47,460 --> 00:12:48,620
ماذا؟

209
00:12:52,130 --> 00:12:56,920
تعلم بشأن مرضها، ورفضت العِلاج

210
00:12:58,170 --> 00:13:01,300
هلّا ذهبتِ لمُقابلتها ولو لمرّة رجاء؟

211
00:13:03,340 --> 00:13:07,930
إنّ رؤيتكِ تذكّرني بنفسي عندما
،لم أستطع الحصول على أيّ عمل

212
00:13:07,930 --> 00:13:09,890
!وهذا يستفزّني

213
00:13:17,410 --> 00:13:19,190
إنَّ رؤيتها الآن لن تُغيّر شيئاً

214
00:13:19,800 --> 00:13:23,220
الأمّ الّتي كانت لديّ آنذاك
قد ولّت منذ زمن بعيد

215
00:13:24,690 --> 00:13:25,750
تفضّل

216
00:13:30,780 --> 00:13:33,450
مساء الخير. اسمي غوريلّا

217
00:13:33,450 --> 00:13:37,000
ماذا تفعلين في مثل هذه السّاعة؟
أفزعتِني

218
00:13:38,240 --> 00:13:42,900
أيّتها الشابّة، هل تُمانعين الإصغاء لغوريلّا
عجوز في هذه اللّيليّة الخريفيّة الطّويلة؟

219
00:13:42,900 --> 00:13:44,460
إنّنا في منتصف الشّتاء

220
00:13:44,810 --> 00:13:49,120
،عندما خضنا تلك الرّحلة
أخبرني هاياتشي بأمر

221
00:13:49,120 --> 00:13:51,600
اختاري شخصيّة واثبتي عيها

222
00:13:52,230 --> 00:13:54,600
قال بأنّه لطالما ندم على ذلك

223
00:13:55,020 --> 00:13:55,600
ماذا؟

224
00:13:56,300 --> 00:13:59,780
ندم على عدم رؤيته لجدّته
بينما كانت لا تزال حيّة

225
00:14:00,900 --> 00:14:02,210
هكذا إذاً

226
00:14:02,210 --> 00:14:05,540
لهذا قرّرت إذاً الذّهاب لرؤية جدّتك
أيُّها الغوريلّا إذاً

227
00:14:06,760 --> 00:14:07,400
وبعد؟

228
00:14:08,170 --> 00:14:09,110
ماذا؟

229
00:14:09,450 --> 00:14:15,370
ماذا؟ هذا غريب... ظننتُ بأنّ
الأمور ستبدو ألطف بكثير

230
00:14:15,950 --> 00:14:17,500
حسناً، أيّاً يكن

231
00:14:22,090 --> 00:14:24,130
شكراً لكِ. سيخرج الغوريلّا

232
00:14:29,310 --> 00:14:31,390
لِمَ عليّ الذّهاب؟

233
00:14:31,390 --> 00:14:34,640
!عليك ذلك بالطّبع! فأنت مُديرها

234
00:14:38,120 --> 00:14:40,030
رافقتكما السّلامة

235
00:14:40,650 --> 00:14:44,350
سأعدُّ لك دجاجك المقليّ المُفضّل
عندما تعودين

236
00:14:44,350 --> 00:14:47,400
يجب أن تتذوّقي الفاصولياء الجديدة عند عودتكِ

237
00:14:47,400 --> 00:14:49,550
!الغوريلّا يُشجّعكِ أيضاً

238
00:14:49,970 --> 00:14:51,410
...أنتن

239
00:14:52,210 --> 00:14:54,360
حسناً. إلى اللّقاء

240
00:14:55,740 --> 00:14:58,660
ما الّذي جعلكِ تغيّرين رأيكِ على أيّ حال؟

241
00:14:59,210 --> 00:15:01,670
حتّى الأمس، بدا أنّكِ لا تُريدين الذّهاب

242
00:15:02,020 --> 00:15:04,170
حصلتُ على نصيحة من غوريلّا

243
00:15:04,500 --> 00:15:06,690
قال بأنّني يجب أن أذهب لرؤيتها

244
00:15:06,690 --> 00:15:07,920
ماذا يعني هذا؟

245
00:15:09,790 --> 00:15:10,930
ها هي

246
00:15:11,810 --> 00:15:14,050
انتظرني هنا، اتّفقنا يا هاياتو-كن؟

247
00:15:14,050 --> 00:15:17,430
ماذا؟ هل أنتِ متأكّدة بأنّكِ لا تريدينني
أن أذهب معكِ؟

248
00:15:18,550 --> 00:15:19,300
أجل

249
00:15:20,130 --> 00:15:22,680
هناك بعض الأشياء الّتي لا أريد
من الشّخص الّذي أحبُّه أن يراها

250
00:15:24,040 --> 00:15:25,690
...ماذا

251
00:15:31,390 --> 00:15:33,760
ريهو! أتيتِ؟

252
00:15:36,960 --> 00:15:40,010
حسناً، أراكِ مُبهرَجة

253
00:15:40,010 --> 00:15:42,710
هل تواعدين غبيّاً ما أو ما شابه؟

254
00:15:42,710 --> 00:15:44,330
!مـ-مهلاً

255
00:15:44,330 --> 00:15:46,390
ثلاثة أشهر للعيش؟

256
00:15:46,390 --> 00:15:47,210
ماذا؟

257
00:15:47,560 --> 00:15:51,740
تستحقّين هذا بعد أن عشتِ حياتكِ بأنانيّة

258
00:15:55,530 --> 00:15:57,470
على أيّ حال، يسرّني أنّكِ أتيتِ

259
00:15:57,470 --> 00:16:01,230
من فضلكِ ساعديني في إقناعها
بتلقّي علاج

260
00:16:01,500 --> 00:16:02,510
لماذا؟

261
00:16:02,510 --> 00:16:03,350
ماذا؟

262
00:16:03,350 --> 00:16:06,610
لا يهمّني ما يحدث لها

263
00:16:06,990 --> 00:16:10,360
إذا قالت بأنّها تريد الموت، فلتمُت

264
00:16:10,360 --> 00:16:13,400
!ر-ريهو! ما الّذي تقولينه بالضّبط؟

265
00:16:13,400 --> 00:16:14,990
!هذه أمّكِ

266
00:16:15,640 --> 00:16:21,450
لا أتذكّر بأنّ هذه المرأة فعلَتْ
أيّ شيء أموميّ لأجلي

267
00:16:22,130 --> 00:16:26,250
استخدمَتْ ابنتها فقط لإرضاء
،حاجتها للقبول

268
00:16:26,250 --> 00:16:29,640
،وعندما لم تعُد تستفيد منها
رمَتْها. إنّها قمامة

269
00:16:31,370 --> 00:16:35,180
لم تعمل حتّى. قضتْ حياتها
تشرب الخمر وتثمل طوال الوقت

270
00:16:35,630 --> 00:16:39,010
.إنّها ليست إلّا طفلة فاسدة قد كَبُرَتْ
!يا للخزيّ

271
00:16:39,400 --> 00:16:40,590
...ريهو

272
00:16:40,590 --> 00:16:42,670
أتذكّر عندما كنتِ تقولين لي

273
00:16:42,670 --> 00:16:47,220
بأنّ رؤيتي تستفزّكِ لأنّها تذكّركِ
بنفسكِ في أيّام شبابكِ

274
00:16:47,220 --> 00:16:48,020
أجل

275
00:16:48,940 --> 00:16:50,830
ويحكِ

276
00:16:50,830 --> 00:16:53,390
لستُ نسخة مُتدنّية عنكِ

277
00:16:53,900 --> 00:16:58,960
مجرّد فكرة مشاركة الدّم مع شخص
مثلكِ تثير اشمئزازي

278
00:16:58,960 --> 00:17:00,540
!أنتِ! توقّفي

279
00:17:00,540 --> 00:17:02,480
!أيّاً كان ما حدث، أنتِ تتمادين

280
00:17:02,480 --> 00:17:03,790
!لا تلمسني

281
00:17:07,200 --> 00:17:09,130
أتريد أن تعرف سبب
مجيئي إلى هنا اليوم؟

282
00:17:09,130 --> 00:17:13,670
!لأنّني أردتُ أن أقول لها هذا الكلام بشدّة

283
00:17:13,670 --> 00:17:20,430
آمل أن تقضي آخر ثلاثة أشهر لكِ
!بيأس قبل أن تموتي ميتة الكِلاب

284
00:17:23,740 --> 00:17:25,690
!هـ-هذا يكفي

285
00:17:25,690 --> 00:17:29,280
قد تكونين ابنتي، لكن لن أسمح لكِ
!بالشّتم والإهانات هكذا

286
00:17:35,820 --> 00:17:39,730
...ماذا... لا، أنا... فقط

287
00:17:39,730 --> 00:17:41,830
،لا أعرف ماذا حدث

288
00:17:42,180 --> 00:17:44,740
لكن يبدو أنّكِ نضجتِ قليلاً يا ريهو

289
00:17:45,210 --> 00:17:48,160
لكن كانت تلك الجزئيّة الأخيرة غير مقبولة

290
00:17:48,160 --> 00:17:50,460
الأجواء برمّتها كانت أشبه بفترة شووا

291
00:17:54,350 --> 00:17:58,470
كانت جدّتي لتمدحني على ذلك

292
00:18:00,300 --> 00:18:01,070
وداعاً

293
00:18:01,070 --> 00:18:04,510
ا-نتظري يا ريهو! لا تقولي
...لي أنّ ذلك كان كلّ

294
00:18:07,860 --> 00:18:09,130
انتهيتِ؟

295
00:18:09,620 --> 00:18:11,360
أجل. لنعُد إلى المنزل

296
00:18:14,060 --> 00:18:15,050
ماذا؟

297
00:18:15,360 --> 00:18:20,370
أخبرتُكِ من قبل، لطالما كان يبدو
تمثيلكِ مُصطنعاً في النّهاية

298
00:18:21,100 --> 00:18:23,050
لم يكُن من المُفترض أن تتنصّت

299
00:18:23,810 --> 00:18:28,810
قبل 25 سنة، حصلتُ على دور
صغير في فيلم، لمرّة واحدة فقط

300
00:18:28,810 --> 00:18:29,480
ماذا؟

301
00:18:29,870 --> 00:18:33,880
كانت تلك أوّل مرّة لي ألتقي فيها بمُمثّل حقيقيّ

302
00:18:34,460 --> 00:18:37,880
سحرَني تمثيلها. كان أخّاذاً

303
00:18:38,420 --> 00:18:40,660
وحينئذ ذقتُ اليأس

304
00:18:41,380 --> 00:18:45,640
رؤية موهبة بمستوى مختلف كلّياً
عن مستوايّ

305
00:18:46,090 --> 00:18:49,290
جعلني أفكّر في التخلّي عن التّمثيل

306
00:18:50,400 --> 00:18:54,620
كانت أمّك، الّتي يصفونها بالمُمثِّلة
...العظمى في فترة شووا

307
00:18:54,620 --> 00:18:56,280
أنيكاوا يوميكو

308
00:18:56,700 --> 00:19:00,680
،عندما كنّا سنتزوّج ورحتُ لزيارة والديك

309
00:19:00,680 --> 00:19:02,190
انصدمتُ من رؤيتها هناك

310
00:19:02,190 --> 00:19:04,660
...لم تخبريني بأيّ من هذا

311
00:19:05,980 --> 00:19:08,260
كنتُ قد نسيتُ تماماً

312
00:19:08,260 --> 00:19:10,540
،قبل أن تكون ريهو ابنتي

313
00:19:11,330 --> 00:19:13,350
كانت حفيدتها

314
00:19:13,790 --> 00:19:14,950
...روري

315
00:19:22,010 --> 00:19:24,930
لا، إنّها ابنتكِ حتماً

316
00:19:25,410 --> 00:19:26,270
ماذا؟

317
00:19:26,270 --> 00:19:31,190
هاياتو-كن، مالك المقهى حيث
تعمل هي، أرسل هذه

318
00:19:32,110 --> 00:19:35,320
قال بأنّه دراما تلفزيونيّة شاركتْ
فيه يوم أمس

319
00:19:35,320 --> 00:19:39,680
إنّه جزء ارتجلَتْ فيه الكلام، لكن
سيُقَصّ من الفيديو النّهائيّ

320
00:19:41,870 --> 00:19:47,370
سأدع أمّي تقول بأنّها مسرورة
لأنّها أنجبتني

321
00:19:51,890 --> 00:19:54,490
ربّما سأقبل بالعلاج

322
00:19:54,490 --> 00:19:56,340
!ماذا؟ حقّاً؟

323
00:19:56,670 --> 00:19:59,330
أريد أن أعيش مدّة طويلة كافية لرؤية

324
00:19:59,330 --> 00:20:02,940
ما إن كانت الطّفلة الّتي أنجبتُها
...ستغدو ضفدعاً

325
00:20:03,770 --> 00:20:04,990
أم صقراً

326
00:20:05,510 --> 00:20:08,680
أدركتُ بأنّ هناك طُرُقاً مختلِفة
للتّعبير عن العاطفة

327
00:20:09,650 --> 00:20:11,600
...بعد رؤية عائلات الفتيات الأُخريات

328
00:20:12,080 --> 00:20:14,600
،جميعهن تصرّفن بشكل مختلف

329
00:20:14,600 --> 00:20:17,200
لكن كان من الواضح بأنّهم
مُهِمُّون لبعضهم الآخر

330
00:20:17,610 --> 00:20:21,110
لذا أردتُ أن أدع أمّي تعلم ذلك

331
00:20:21,110 --> 00:20:23,640
بالطّريقة الّتي تتّبعها عائلتي

332
00:20:24,400 --> 00:20:27,120
بعد كلّ سبّباه لكِ من معاناة؟

333
00:20:27,420 --> 00:20:29,870
أيّاً كان ما فعلاه، يبقيان والدايّ

334
00:20:33,800 --> 00:20:35,380
...وفي النّهاية

335
00:20:35,660 --> 00:20:38,060
سماع أمّي تمدحني أسعدَني

336
00:20:39,490 --> 00:20:44,630
أعتقد أنّ من النّوع الّذي يتغذّى
!على تجاربه كي ينمو وينضج

337
00:20:44,630 --> 00:20:47,310
قالت بأنّ تمثيلكِ قريب من طابع فترة شووا

338
00:20:47,310 --> 00:20:50,500
التحمُّس والرّضا تجاه نفسكِ هو عادة سيّئة

339
00:20:50,500 --> 00:20:52,640
!كُفّ عن تحليلي

340
00:20:53,400 --> 00:20:56,730
ربّما استمدتِ تمثيلكِ ذا طابع فترة
شووا من جدّتكِ

341
00:20:58,380 --> 00:21:02,170
ماذا؟ هاياتو-كن، تعلم بشأن جدّتي؟

342
00:21:02,170 --> 00:21:02,740
أجل

343
00:21:03,100 --> 00:21:07,620
بدا اسمها مألوفاً، لذا تساءلتُ
حول الأمر وأجريتُ بحثاً

344
00:21:07,620 --> 00:21:09,490
كانت مُمثّلة عظيمة على ما يبدو

345
00:21:10,150 --> 00:21:12,480
كنتَ تعلم إذاً

346
00:21:13,290 --> 00:21:16,620
ستعودين إلى عالم البرامج وتحاولين
أن تكوني مُمثّلة ثانية؟

347
00:21:16,980 --> 00:21:19,300
لا أعلم بصراحة

348
00:21:19,300 --> 00:21:22,380
إنّه ليس عملاً أستطيع فعله
فقط لأنّني أرغب في ذلك

349
00:21:22,640 --> 00:21:25,710
لكن أشعر وكأنّكِ ستتلقّين عرضاً آخر قريباً

350
00:21:25,710 --> 00:21:26,630
حقّاً؟

351
00:21:26,920 --> 00:21:30,640
إذاً أعتقد بأنّني سأحتاج مساعدتك

352
00:21:30,940 --> 00:21:32,640
ماذا؟ لماذا أنا؟

353
00:21:33,180 --> 00:21:34,270
...في الواقع

354
00:21:34,850 --> 00:21:37,100
لا أعلم أيّ نوع من الأدوار سيكون، صحيح؟

355
00:21:37,810 --> 00:21:41,060
،لذا امنحني كثيراً من الخبرة
!بما في ذلك الرّومانسيّة منها

356
00:21:46,050 --> 00:21:48,270
!أنا مستعدّة للبدء الآن حتّى

357
00:21:49,320 --> 00:21:52,390
!تمهّلي! أنتِ تتسرّعين هنا

358
00:23:26,000 --> 00:23:27,480
!أنا من ميامي الأسبوعيّة

359
00:23:27,480 --> 00:23:29,710
هل هناك أي عبارات من هذا
الدّور عالق في ذهنك؟

360
00:23:29,710 --> 00:23:31,380
لا. كنتُ ميّتة طوال الوقت

361
00:23:31,380 --> 00:23:32,970
هل من شيء حفظتِه عند التّحضير للدّور؟

362
00:23:32,970 --> 00:23:33,890
الموت فقط

363
00:23:33,890 --> 00:23:35,480
هل لديكِ رسالة للمُشاهدين؟

364
00:23:35,480 --> 00:23:37,470
!انظروا كم أنا جثّة رائعة

365
00:23:37,470 --> 00:23:40,020
وأيضاً سوف ألكم ذلك المُخرج وأقذفه بعيداً