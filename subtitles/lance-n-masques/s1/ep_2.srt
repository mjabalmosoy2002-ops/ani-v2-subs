1
00:00:20,580 --> 00:00:22,200
.صباح الخير

2
00:00:29,510 --> 00:00:34,880
استيقظت متأخّرًا جدًّا يا يوتارو-سان

3
00:00:41,860 --> 00:00:43,860
اسمعي يا شيروهيمي

4
00:00:43,860 --> 00:00:46,960
يوتارو-سان على وشك أن يبدأ تمارينه الصباحية

5
00:00:46,960 --> 00:00:49,140
لذا لا تعيقيه، اتفقنا؟

6
00:00:57,070 --> 00:00:58,860
صباح الخير يا شيروهيمي

7
00:01:00,300 --> 00:01:02,040
انتظري يا شيروهيمي

8
00:01:03,740 --> 00:01:07,620
!كيف تجرّأتِ يا شيروهيمي

9
00:01:08,150 --> 00:01:11,590
!لا تعيقيه

10
00:01:13,490 --> 00:01:16,020
!أنتما الاثنان! لا تتشاجرا

11
00:01:16,020 --> 00:01:17,890
أليس-سان، شيروهيمي-سان

12
00:01:20,040 --> 00:01:23,370
هل تنويان إزعاج يوتارو-سان خلال تمارينه؟

13
00:01:25,720 --> 00:01:27,390
مهلاً يا يوريكو-سان

14
00:01:28,380 --> 00:01:29,860
هل لديك شيءٌ لتقوله؟

15
00:01:32,700 --> 00:01:34,240
!أنتِ

16
00:01:34,240 --> 00:01:36,400
ما الذي تفعلينه؟

17
00:01:39,190 --> 00:01:40,950
!احذري يا ماكيو

18
00:01:40,950 --> 00:01:47,680
...لا تتنمّري... على يوتارو

19
00:02:00,970 --> 00:02:04,010
هل تأذيّتِ يا سيّدتي؟

20
00:02:06,690 --> 00:02:09,980
!الفارس الرّمّاح

21
00:03:41,100 --> 00:03:43,160
راودني حلمٌ عن الفارس الرمّاح

22
00:03:43,160 --> 00:03:45,110
حقًّا؟

23
00:03:45,110 --> 00:03:48,810
أنقذني في حلمي أيضًا

24
00:03:48,810 --> 00:03:50,910
إنّه بطلٌ حقيقيّ

25
00:03:51,260 --> 00:03:54,340
ماكيو-سان، فطورك جاهز

26
00:03:53,540 --> 00:03:55,790
هذه الفتاة هي كيدوين ماكيو

27
00:03:54,340 --> 00:03:56,420
حسنًا، شكرًا لك يا يوريكو

28
00:03:56,420 --> 00:03:58,700
ابنة عائلة تُجّار من النّخبة

29
00:03:59,040 --> 00:04:02,380
لنبدأ الأكل

30
00:03:59,180 --> 00:04:02,280
عندما تراني مرتديًا قناعًا

31
00:04:03,030 --> 00:04:04,930
تحسبني بطلاً

32
00:04:05,310 --> 00:04:09,550
كنت لا تزال مثيرًا للشفقة في حلمي أيضًا

33
00:04:11,160 --> 00:04:16,190
لم تدرِك ماكيو بعد أنّي بطلها

34
00:04:16,960 --> 00:04:18,910
أنا فارس

35
00:04:19,710 --> 00:04:23,280
يمتدّ تاريخ أخويّتي إلى ما قبل تسعمئة سنة

36
00:04:24,500 --> 00:04:29,160
لكنّي أفضّل عيش حياةٍ عاديّة على أن أكون فارسًا

37
00:04:29,500 --> 00:04:33,660
أرتدي ذلك القناع كي لا يُدرِك الناس أني فارس

38
00:04:39,890 --> 00:04:41,280
هذه الفتاة هي أليس

39
00:04:41,660 --> 00:04:43,670
إنّها فارسة أُدَرّبها

40
00:04:45,290 --> 00:04:47,050
إنّها تلميذتي

41
00:04:49,000 --> 00:04:53,000
شيروهيمي هي فرسٌ أنثى بيضاء تربّت لخدمتي

42
00:04:55,010 --> 00:04:56,060
...وأيضًا

43
00:04:56,330 --> 00:04:58,430
هل تريدين المزيد يا ماكيو-سان؟

44
00:04:58,430 --> 00:05:00,140
شكرًا يا يوريكو

45
00:05:01,000 --> 00:05:02,500
هلّا فعلت ذلك رجاءً

46
00:05:02,500 --> 00:05:03,960
حاضر

47
00:05:04,990 --> 00:05:06,710
هذه يوريكو-سان

48
00:05:07,130 --> 00:05:10,130
اعتنت بي منذ صغري

49
00:05:10,130 --> 00:05:13,850
إنها مسؤولة عن متلازمة الفارس الأبيض خاصتي

50
00:05:15,040 --> 00:05:18,420
أتصرّف كالفارس بغضّ النظر عن نواياي

51
00:05:19,250 --> 00:05:22,340
لهذا أدعوها متلازمة الفارس الأبيض

52
00:05:21,590 --> 00:05:22,880
يوتارو-سان

53
00:05:23,260 --> 00:05:25,130
أنت لا تأكل

54
00:05:25,540 --> 00:05:27,340
هل طعامي غير مناسب؟

55
00:05:27,340 --> 00:05:29,370
لـ-لا، على الإطلاق

56
00:05:29,370 --> 00:05:32,610
لكن لمَ حضّرت الفطور؟

57
00:05:32,610 --> 00:05:35,960
لدينا من يُعِدّ الفطور

58
00:05:35,960 --> 00:05:37,900
وأيضًا، ماذا عن يويفا-سان؟

59
00:05:37,900 --> 00:05:39,990
!المزيد رجاءً

60
00:05:40,790 --> 00:05:42,560
أليس تأكل كثيرًا

61
00:05:42,560 --> 00:05:45,150
!كلاّ، لا آكل كثيرًا

62
00:05:46,280 --> 00:05:48,920
هذا لا يختلف عن وجودي في الجزيرة

63
00:05:48,920 --> 00:05:52,580
لا أصدّق أنّ الأخريات لحقن بي

64
00:05:55,670 --> 00:05:57,870
...يوريكو-سان

65
00:06:04,210 --> 00:06:06,050
!يوتارو

66
00:06:10,250 --> 00:06:11,610
!يوتارو

67
00:06:11,610 --> 00:06:12,550
ماكيو

68
00:06:12,870 --> 00:06:14,920
!لا تُقلق الآخرين

69
00:06:14,920 --> 00:06:16,060
!أنت لا تستَحقّ ذلك

70
00:06:16,530 --> 00:06:18,310
آ-آسف

71
00:06:18,730 --> 00:06:19,910
لقد أخبرَتني عنك

72
00:06:19,910 --> 00:06:23,030
اختفيت من المنزل فجأة

73
00:06:23,030 --> 00:06:24,320
...في الواقع

74
00:06:30,910 --> 00:06:33,600
أتساءل إن كنت سأُضطرّ للعودة

75
00:06:33,600 --> 00:06:35,950
إلى الجزيرة لأعيش كفارس

76
00:06:36,580 --> 00:06:38,190
لكن هذا جيّد

77
00:06:39,000 --> 00:06:41,450
بما أنّ يوريكو والبقية هنا

78
00:06:41,450 --> 00:06:43,920
يمكنني توديعك دون أن أقلق

79
00:06:45,220 --> 00:06:46,420
هذا صحيح

80
00:06:46,420 --> 00:06:49,960
ستبقى ماكيو وحيدة مجدّدًا عندما أغادر

81
00:06:50,490 --> 00:06:51,680
المعذرة

82
00:06:52,600 --> 00:06:56,540
...في الواقع

83
00:07:02,030 --> 00:07:05,470
ولهذا السبّب أريد أن أبقى هنا لوقتٍ أطول

84
00:07:06,560 --> 00:07:08,690
لا يمكنني أن أترك ماكيو بمفردها

85
00:07:09,520 --> 00:07:15,570
كما أنّها تظنني بطلاً عندما أرتدي قناعي

86
00:07:15,570 --> 00:07:19,460
لذا كوني فارسًا هو سرّ

87
00:07:21,840 --> 00:07:24,000
كنت أتساءل متى ستذكر الأمر

88
00:07:25,170 --> 00:07:28,070
لم أخبر ماكيو-سان أنّك فارس

89
00:07:28,740 --> 00:07:32,190
أفترض أنّ هذا ما تريده بما أنّك تختار إخفاء وجهك

90
00:07:32,620 --> 00:07:34,850
لديّ تنظيف أقوم به

91
00:07:35,970 --> 00:07:38,650
مـ-مهلاً، هل ستبقين هنا أنت أيضًا يا يوريكو-سان؟

92
00:07:39,190 --> 00:07:40,940
!نحن أيضًا

93
00:07:41,760 --> 00:07:44,050
!البقاء إلى جانب فتاةٍ وحيدة

94
00:07:44,050 --> 00:07:45,570
!هذا هو يوتارو-ساما

95
00:07:47,320 --> 00:07:48,910
أليس هذا مفاجئًا قليلاً؟

96
00:07:48,910 --> 00:07:50,360
هل ماكيو موافقة؟

97
00:07:50,360 --> 00:07:51,990
!أنتم مُرَحب بكم

98
00:07:51,990 --> 00:07:53,570
حـ-حقًّا؟

99
00:07:53,570 --> 00:07:55,790
يمكنكم البقاء إلى متى شئتم

100
00:07:55,790 --> 00:07:57,890
لدينا الكثير من الغرف

101
00:07:57,890 --> 00:07:59,450
شكرًا لك

102
00:07:59,450 --> 00:08:00,940
أنا أتطلّع لذلك

103
00:08:05,070 --> 00:08:06,640
!شيـ-شيروهيمي

104
00:08:08,470 --> 00:08:10,410
يوتارو-ساما فارس ممتاز

105
00:08:10,410 --> 00:08:12,090
!أليس

106
00:08:19,120 --> 00:08:21,320
آمل أن يعجبك

107
00:08:21,320 --> 00:08:22,980
لقد أعددت الكثير يا يوريكو-سان

108
00:08:24,940 --> 00:08:27,480
تساهلي معها يا يوريكو-سان

109
00:08:27,980 --> 00:08:30,230
سأعاقبك معها إذًا

110
00:08:36,740 --> 00:08:43,210
وهكذا هزم الفارس الرمّاح الرجال الأشرار

111
00:08:43,460 --> 00:08:45,130
—هذا هو يوتا

112
00:08:46,570 --> 00:08:48,590
أقصد الفارس الرمّاح

113
00:08:48,590 --> 00:08:52,150
!أجل، إنّه بطل الأبطال

114
00:08:52,150 --> 00:08:54,040
يبدو مذهلاً

115
00:08:54,040 --> 00:08:56,650
هذا رسمٌ جيّدٌ للفارس الرّمّاح

116
00:08:56,650 --> 00:08:58,600
شكرًا لك

117
00:09:00,290 --> 00:09:02,180
...استمتعت معكم كثيرًا يا رفاق

118
00:09:02,180 --> 00:09:05,230
لقد نسيت، حان وقت التدريب

119
00:09:12,210 --> 00:09:13,740
أين نحن؟

120
00:09:19,510 --> 00:09:21,040
!ماكيو

121
00:09:23,170 --> 00:09:25,290
!أنت، لا تُعق تدريبي

122
00:09:25,290 --> 00:09:27,440
تتدرّبين لأيّ سبب؟

123
00:09:27,440 --> 00:09:29,540
أتدرّب لأصبح بطلة

124
00:09:30,450 --> 00:09:32,650
تتدرّبين لتصبحي بطلة؟

125
00:09:33,470 --> 00:09:36,720
هكذا وقعتِ تلك المرة إذًا؟

126
00:09:37,190 --> 00:09:38,590
لا تقاطع تدريبي

127
00:09:39,050 --> 00:09:40,630
لكنّه خطير

128
00:09:40,630 --> 00:09:42,180
لديّ الفارس الرّمّاح

129
00:09:42,960 --> 00:09:46,700
سيساعدني الفارس الرمّاح مجدّدًا إن أحدق بي الخطر

130
00:09:46,700 --> 00:09:48,230
لذا سأكون بخير

131
00:09:56,770 --> 00:09:58,210
لقد ضربتني

132
00:09:58,210 --> 00:09:59,960
الزم حدودك يا يوتارو

133
00:09:59,960 --> 00:10:01,560
لم أضربك

134
00:10:02,590 --> 00:10:04,330
الفارس الرّمّاح ضربك

135
00:10:05,570 --> 00:10:07,130
عمّاذا تتحدث؟

136
00:10:07,130 --> 00:10:10,080
!أنت لست الفارس الرّمّاح يا يوتارو

137
00:10:10,460 --> 00:10:12,590
لكنّ الفارس الرّمّاح كان ليفعل ذلك

138
00:10:13,820 --> 00:10:19,040
لقولك أنّه بإمكانك المخاطرة بنفسك فقط لأنّه سيساعدك

139
00:10:22,240 --> 00:10:23,930
معك حقّ

140
00:10:24,980 --> 00:10:29,640
الفارس الرّمّاح يكرهني الآن

141
00:10:34,770 --> 00:10:36,060
لا تقلقي

142
00:10:36,770 --> 00:10:42,510
ما كان الفارس الرّمّاح ليكرهك لارتكابك خطأً

143
00:10:54,140 --> 00:10:58,020
!قناعه الأبيض قناع عدالة

144
00:10:58,020 --> 00:11:01,810
!يأتي لإنقاذك أينما كنت

145
00:11:01,810 --> 00:11:08,810
!ها هو فارسنا المقنّع قادم

146
00:11:03,680 --> 00:11:05,030
يا لظرافتها

147
00:11:05,030 --> 00:11:06,150
إنّها كذلك

148
00:11:08,810 --> 00:11:11,940
ماكيو، غنّي بصوت منخفض أكثر

149
00:11:11,940 --> 00:11:13,250
حسنًا

150
00:11:13,560 --> 00:11:17,820
...أطلقت عليّ اسمًا في البداية، والآن ألّفت أغنية للفارس الرّمّاح

151
00:11:21,530 --> 00:11:25,160
...ذلك هو

152
00:11:21,770 --> 00:11:22,820
تعال بسرعة

153
00:11:22,820 --> 00:11:23,940
انتظر

154
00:11:28,300 --> 00:11:29,540
يوتارو؟

155
00:11:31,730 --> 00:11:33,270
...المدرسة

156
00:11:34,460 --> 00:11:37,050
تذكّرت. ماذا عن المدرسة يا ماكيو؟

157
00:11:38,440 --> 00:11:39,360
ماكيو؟

158
00:11:40,180 --> 00:11:42,550
ما الذي علينا فعله للذهاب إلى المدرسة؟

159
00:11:55,940 --> 00:12:01,130
وعندها ضربني يوتارو على رأسي وقال أنّه من السيّئ أن أعرّض نفسي للخطر

160
00:12:02,410 --> 00:12:05,370
حقًّا؟ يوتارو-ساما فعل ذلك؟

161
00:12:06,440 --> 00:12:10,270
يو-يوريكو-سان، فعل يوتارو-ساما ذلك لأنّه يكترث لأمر ماكيو-تشان

162
00:12:11,460 --> 00:12:13,580
هكذا إذًا، فعل ذلك؟

163
00:12:13,980 --> 00:12:14,910
أجل

164
00:12:14,910 --> 00:12:15,680
ماذا؟

165
00:12:15,680 --> 00:12:17,150
ألست غاضبة؟

166
00:12:17,150 --> 00:12:18,140
أليس-سان

167
00:12:18,140 --> 00:12:19,210
نعم يا يوريكو-سان؟

168
00:12:19,500 --> 00:12:21,220
يداك ثابتتان

169
00:12:23,430 --> 00:12:24,750
أنا آسفة

170
00:12:31,320 --> 00:12:34,330
شكرًا لسماحك لماكيو بامتطائك اليوم

171
00:12:39,510 --> 00:12:40,790
أجل

172
00:12:41,700 --> 00:12:44,680
لا يمكنني أن أدع الأمر يستمرّ

173
00:13:06,740 --> 00:13:09,180
أعتمد عليك إذًا يا كونغوجي

174
00:13:09,340 --> 00:13:11,960
حاضر أيّها القائد كيدوين

175
00:13:47,750 --> 00:13:50,470
لا يبدو أنّ ماكيو-ساما أدركت الأمر

176
00:13:51,170 --> 00:13:53,440
...ذلك الفارس المقنّع

177
00:13:53,440 --> 00:13:56,850
يبدو أنّه أخفى هويّته مذ غادر الجزيرة

178
00:13:57,510 --> 00:14:00,340
...ظننت أنّه هنا لاختطاف ماكيو-ساما

179
00:14:00,340 --> 00:14:02,190
يا له من سوء فهمٍ لا يُصَدَّق

180
00:14:02,190 --> 00:14:03,390
بالمناسبة

181
00:14:04,690 --> 00:14:09,780
أخبرتني ماكيو-سان أنّها تعيش هنا بمفردها

182
00:14:09,780 --> 00:14:11,790
...هـ-هذا

183
00:14:12,180 --> 00:14:15,540
ألا تظنون أنّ هنالك خطبٌ في ذلك بتاتًا؟

184
00:14:18,130 --> 00:14:19,310
فهمت

185
00:14:20,410 --> 00:14:23,020
سنعيش هنا من الآن فصاعدًا

186
00:14:23,350 --> 00:14:26,070
ماذا؟ هذا أمر مفاجئ

187
00:14:26,070 --> 00:14:30,800
أخبري الخادمات الأخريات أنّه لا حاجة لقدومهنّ بعد الآن

188
00:14:31,100 --> 00:14:32,210
...لكن

189
00:14:32,210 --> 00:14:34,060
وذلك يشملك أنت أيضًا بالطّبع

190
00:14:47,090 --> 00:14:48,790
...يو-يويين

191
00:14:49,380 --> 00:14:50,610
علمت بالأمر يا جيجي

192
00:14:51,270 --> 00:14:53,640
علمتُ أنه تمّت مضايقتك وعدتِ إلى هنا باكيةً

193
00:14:55,030 --> 00:14:57,830
تم إنقاذنا نحن الشقيقان من قِبَل رئيسنا

194
00:14:58,570 --> 00:15:00,400
...أيًّا كان من يبكيكِ

195
00:15:08,210 --> 00:15:10,260
لا تستعمل ذلك

196
00:15:10,260 --> 00:15:11,390
...نحن لسنا

197
00:15:16,220 --> 00:15:17,980
لا تقلقي

198
00:15:20,310 --> 00:15:22,230
أنا ذاهب الآن

199
00:15:27,540 --> 00:15:30,520
هل أحضرت هذه السيارة من الجزيرة أيضًا؟

200
00:15:40,730 --> 00:15:42,250
شكرًا يا يوريكو-سان

201
00:15:51,240 --> 00:15:53,010
ألا يمكنني مقابلته؟

202
00:15:53,590 --> 00:15:57,330
لـ-لكنّي أريد رؤية والد ماكيو

203
00:15:58,060 --> 00:15:59,330
أريد التّحدّث معه

204
00:15:59,960 --> 00:16:00,800
أنت

205
00:16:04,450 --> 00:16:06,800
كـ-كونغوجي-سان

206
00:16:08,500 --> 00:16:10,280
لم أرك منذ وقت طويل يا كونغوجي-سان

207
00:16:11,120 --> 00:16:14,260
لم أتوقّع أن ألتقيك في مكان كهذا

208
00:16:15,310 --> 00:16:17,160
لقد كبرت يا يوتارو

209
00:16:20,240 --> 00:16:22,350
أنت مسؤول عن الأمن هنا؟

210
00:16:22,660 --> 00:16:23,870
أجل، هذا صحيح

211
00:16:25,190 --> 00:16:28,500
في الواقع، أريد رؤية والد ماكيو

212
00:16:29,240 --> 00:16:32,120
فأنا لا أظنّ

213
00:16:32,740 --> 00:16:37,010
أنّ عيش ماكيو بمفردها أمرٌ صائب

214
00:16:38,550 --> 00:16:41,070
هل يمكنك التحدث إلى والد ماكيو أنت أيضًا؟

215
00:16:41,070 --> 00:16:41,930
لا يمكنني ذلك

216
00:16:43,700 --> 00:16:51,220
قناعه الأبيض قناع العدالة

217
00:16:51,220 --> 00:16:53,350
أنت تجيدين الغناء يا شيروهيمي

218
00:16:54,540 --> 00:16:58,410
ماكيو-تشان، شيروهيمي، حان وقت تناول الوجبة الخفيفة

219
00:16:58,410 --> 00:16:59,410
حسنًا

220
00:17:00,230 --> 00:17:03,800
ألم يعودا يوتارو ويوريكو بعد؟

221
00:17:04,910 --> 00:17:06,230
لن

222
00:17:06,950 --> 00:17:08,670
يرحلا مجدّدًا، أليس كذلك؟

223
00:17:09,110 --> 00:17:11,260
لـ-لا تقلقي

224
00:17:11,260 --> 00:17:13,090
سيعودان قريبًا

225
00:17:14,010 --> 00:17:15,300
حسنًا

226
00:17:26,560 --> 00:17:28,150
سيرسلون ماكيو خارج البلاد؟

227
00:17:28,720 --> 00:17:30,520
لماذا يا كونغوجي-سان؟

228
00:17:30,820 --> 00:17:32,580
...لمَ قد

229
00:17:33,210 --> 00:17:35,900
هذا ما يظنّه القائد صوابًا

230
00:17:38,460 --> 00:17:43,290
هل ستعيش مع والدها خارج البلاد؟

231
00:17:48,400 --> 00:17:52,280
هل ستحظى بشخصٍ ليكون عائلة لها؟

232
00:17:53,760 --> 00:17:56,450
هذا ليس أمرًا صائبًا

233
00:17:56,450 --> 00:17:58,970
هل ستكون ماكيو وحيدة مجدّدًا؟

234
00:17:59,720 --> 00:18:01,430
جزءٌ من ذلك هو خطئي

235
00:18:03,290 --> 00:18:05,560
...أولئك الرجال الذين اقتحموا المنزل

236
00:18:09,290 --> 00:18:13,850
إنّهم من بقوا من منظّمة قمت بإبادتها تدعى بان

237
00:18:14,560 --> 00:18:17,570
لا بدّ أنّهم علموا بشأن ماكيو-ساما بينما كانوا يحاولون

238
00:18:17,570 --> 00:18:19,660
إيجاد معلومات عنّي لينتقموا منّي

239
00:18:20,130 --> 00:18:21,910
ألهذا السبب ستذهب إلى الخارج؟

240
00:18:22,600 --> 00:18:25,400
سمعت أنّها كانت لتواجه خطرًا لو لم تكُن هناك

241
00:18:26,550 --> 00:18:27,460
أنا أشكرك

242
00:18:28,270 --> 00:18:29,870
...لـ-لكن

243
00:18:29,870 --> 00:18:33,400
لا تكترث لذلك، دعني أرى والد ماكيو

244
00:18:36,730 --> 00:18:37,720
لا يمكنني أن أسمح لك بذلك

245
00:18:38,500 --> 00:18:40,850
لمَ لا يا كونغوجي-سان؟

246
00:18:44,320 --> 00:18:45,630
لا بأس

247
00:18:45,630 --> 00:18:47,620
لن أطلب منك المساعدة

248
00:18:47,620 --> 00:18:48,810
سأذهب بنفسي

249
00:18:57,540 --> 00:19:01,070
!كونغوجي-سان

250
00:19:13,300 --> 00:19:14,380
اتخّذت وضعيّتك

251
00:19:16,020 --> 00:19:20,740
أبوك المُلَقَّب بالفارس الأسطوري

252
00:19:20,740 --> 00:19:24,470
لطالما أحضر رمحه معه إلى المعارك

253
00:19:25,900 --> 00:19:29,390
وهناك يلتقي عدوّه أو نفسه

254
00:19:29,390 --> 00:19:31,400
كان مستعدًّا لكلا الوضعين

255
00:19:31,880 --> 00:19:36,410
هل أنت مستعد؟

256
00:19:38,680 --> 00:19:39,730
!يوتارو

257
00:19:44,930 --> 00:19:46,020
...أنتَ

258
00:19:50,110 --> 00:19:52,590
لستَ بفارس

259
00:20:29,160 --> 00:20:31,260
هل ظننت حقًّا أنّ بإمكانك الفوز؟

260
00:20:32,550 --> 00:20:37,310
رتبة كونغوجي غاي هي الثالثة من بين المناصب التسعة

261
00:20:37,720 --> 00:20:39,140
إنّه فارس سولوني

262
00:20:39,870 --> 00:20:43,070
ومن جهةٍ أخرى، أنت أصبحت فارسًا مؤخّرًا فقط

263
00:20:43,070 --> 00:20:45,590
لست سوى فارسًا ضمن أدنى فئة

264
00:20:45,590 --> 00:20:47,100
...لكنني

265
00:20:47,520 --> 00:20:51,100
ظننت أنّ كونغوجي-سان سيتفهّم

266
00:20:51,640 --> 00:20:53,580
الولاء جزءٌ من واجب الفارس

267
00:20:54,150 --> 00:20:57,740
إنه مُلزَم بتأدية العمل الذي يتقاضى أجرًا عليه

268
00:20:58,330 --> 00:20:59,910
أجر؟

269
00:20:59,910 --> 00:21:01,110
لأجل المال؟

270
00:21:01,860 --> 00:21:04,080
هذا ليس صائبًا

271
00:21:04,080 --> 00:21:07,900
ألا يُفترض بالفرسان أن يقاتلوا لأجل الضعفاء؟

272
00:21:07,900 --> 00:21:09,870
لحماية العُزَّل؟

273
00:21:10,300 --> 00:21:14,870
يحتاج المرء للمال لحماية العُزَّل

274
00:21:22,950 --> 00:21:26,390
حسنًا، سأهتمّ بهم

275
00:21:26,670 --> 00:21:28,720
اعتنِ بنفسك يا أبي

276
00:21:36,190 --> 00:21:37,400
يويين؟

277
00:21:39,280 --> 00:21:41,100
!لقد فعلتها يا جيجي

278
00:21:41,100 --> 00:21:43,210
!انتقمت لك

279
00:21:47,390 --> 00:21:49,410
...أليس

280
00:21:50,030 --> 00:21:51,160
!أليس

281
00:21:52,240 --> 00:21:53,740
ما الذي حدث؟

282
00:21:53,740 --> 00:21:55,020
!أليس

283
00:22:01,090 --> 00:22:02,480
...ماكيو

284
00:22:04,090 --> 00:22:06,800
!ماكيو

285
00:23:39,810 --> 00:24:09,590
عرضٌ مُسبَق

286
00:23:40,910 --> 00:23:42,710
يا إلهي! هل أنت بخير يا شيروهيمي؟

287
00:23:42,710 --> 00:23:44,240
لقد انتهى أمري

288
00:23:44,240 --> 00:23:45,620
حياة فرسٍ تتلاشى

289
00:23:45,620 --> 00:23:46,290
فرس...؟

290
00:23:46,290 --> 00:23:47,510
...أظنّ ذلك، لكن

291
00:23:47,510 --> 00:23:50,740
سينهض يوتارو مجدّدًا رمحٌ وأقنعة في الحلقة القادمة من

292
00:23:50,740 --> 00:23:52,850
!هذا ليس الوقت المناسب لعرضٍ مُسبَقٍ للحلقة القادمة

293
00:23:52,850 --> 00:23:54,750
لديّ دورٌ كبير

294
00:23:54,750 --> 00:23:55,970
عليكم أن تشاهدوها

295
00:23:55,970 --> 00:23:56,810
!شيروهيمي

296
00:23:56,810 --> 00:24:00,020
شكرًا لكم جميعًا على محبّة شيروهيمي الظريفة

297
00:24:00,020 --> 00:24:01,250
!شيروهيمي

298
00:24:01,250 --> 00:24:02,470
أنا بخيرٍ تمامًا

299
00:24:02,470 --> 00:24:04,320
أنا ظريفة، لذا لن يقتلوني

300
00:24:04,320 --> 00:24:05,210
!شيروهيمي

301
00:24:05,670 --> 00:24:07,610
...قلت أني لست ميتة