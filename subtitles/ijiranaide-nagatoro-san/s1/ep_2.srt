1
00:00:09,730 --> 00:00:11,230
يبدو هذا جيّداً

2
00:00:12,740 --> 00:00:16,990
!سينباي

3
00:00:25,800 --> 00:00:27,880
ما رأيك بحركاتِ وركي؟

4
00:00:27,880 --> 00:00:30,050
!ادخل الآن

5
00:00:30,250 --> 00:00:32,640
!جِد اللّحظة المناسبة وادخل

6
00:00:32,640 --> 00:00:35,310
!هيّا، بسرعة

7
00:00:35,310 --> 00:00:37,250
لا، لكن متى؟

8
00:00:46,020 --> 00:00:48,170
!يا لك من منحرف

9
00:02:47,130 --> 00:02:49,780
"تلهّفتُ لشراء "مصّاصات دماء ذوات صدر كبير

10
00:02:49,780 --> 00:02:52,650
اشتريتُها في طريقي إلى المدرسة

11
00:02:52,930 --> 00:02:56,320
إنّه المُجلّد الذي يحتوي على فصل النبع
!السّاخن الذي يتحدّث عنه الجميع

12
00:02:56,880 --> 00:02:57,650
!مُنحرف

13
00:02:57,650 --> 00:02:59,210
!كفّ عن التّحديق

14
00:03:06,410 --> 00:03:08,570
!ناغاتورو

15
00:03:08,910 --> 00:03:12,170
...سينباي

16
00:03:13,370 --> 00:03:14,420
!ما الأخبار؟

17
00:03:14,420 --> 00:03:16,670
ما الأخبار؟

18
00:03:17,720 --> 00:03:19,700
ماذا كنتَ تأكل بمفردك؟

19
00:03:19,700 --> 00:03:21,760
يـ-ياكيسوبا

20
00:03:22,520 --> 00:03:24,020
أتريدين منه؟

21
00:03:24,020 --> 00:03:26,610
لماذا تقدّم هذا لفتاة؟

22
00:03:26,610 --> 00:03:29,560
لهذا لا تحظى بشعبيّة بين الفتيات

23
00:03:32,560 --> 00:03:33,950
...على أي حال

24
00:03:34,950 --> 00:03:38,570
هل كنتُ أتوهّم أم أنّ نظراتك
كانت مُريبة قبل قليل؟

25
00:03:39,730 --> 00:03:41,120
مـ-ما الذي تتحدّثين عنه؟

26
00:03:41,120 --> 00:03:42,660
كنتَ هكذا

27
00:03:42,660 --> 00:03:46,580
انتابني شعور غريب منك

28
00:03:46,580 --> 00:03:50,200
لـ-لا أفهم ما تقولينه

29
00:03:51,890 --> 00:03:54,830
كنتَ تنظر إلى شيء مُنحرف

30
00:03:57,520 --> 00:03:58,900
!دعني أرى

31
00:03:58,900 --> 00:04:01,760
!ليس مُنحرفاً

32
00:04:01,760 --> 00:04:03,420
أنت مكشوف تماماً

33
00:04:03,420 --> 00:04:05,600
أنت مُنحرف بالخفاء

34
00:04:05,600 --> 00:04:08,130
تحبّ الأشياء الجنسيّة

35
00:04:08,130 --> 00:04:11,930
غـ-غـ-غـ-غير صحيح

36
00:04:13,860 --> 00:04:19,190
إذا كان هذا ما تريده يا سينباي، أستطيع
أن أدعك تفعل ذلك

37
00:04:19,930 --> 00:04:21,150
!أ-أفعل ذلك؟

38
00:04:21,150 --> 00:04:21,820
!أخذتُه

39
00:04:22,770 --> 00:04:23,200
!مهلاً

40
00:04:23,200 --> 00:04:27,160
!أعيديه

41
00:04:30,360 --> 00:04:33,080
أنت سهل الخِداع يا سينباي

42
00:04:33,690 --> 00:04:36,990
مُحال أن أفعل ذلك معك

43
00:04:40,480 --> 00:04:45,140
عليك أن تُدرك حجمك يا سينباي المُنحرف

44
00:04:49,080 --> 00:04:51,220
!توقّعت ذلك! إنّها أشياء مُنحرفة

45
00:04:51,220 --> 00:04:56,510
لا! مثل هذه المشاهد الجنسيّة أساسيّة
دوماً في مانغا الشونين

46
00:04:56,510 --> 00:04:58,610
!دائماً ما أشتريها لأجل القصّة

47
00:04:58,610 --> 00:04:59,850
...أعني، المعذرة، أنا

48
00:04:59,850 --> 00:05:01,320
أصبحتَ تتكلّم بسرعة فجأة الآن

49
00:05:01,320 --> 00:05:03,040
أنت مُقرف للغاية يا سينباي

50
00:05:03,040 --> 00:05:04,600
...لا، أنا

51
00:05:04,600 --> 00:05:06,240
...تقول كلّ هذا الكلام

52
00:05:06,680 --> 00:05:09,620
لكن هذا ما تحبّ، أليس كذلك؟

53
00:05:09,950 --> 00:05:12,600
ما هذا؟ محظوظ بالمُصادفات؟

54
00:05:12,600 --> 00:05:13,870
...هـ-هذا

55
00:05:13,870 --> 00:05:18,000
تريد أن تُداعب صدر إحداهن عندما
تسقط، أليس كذلك يا سينباي؟

56
00:05:18,000 --> 00:05:21,050
كـ-كفّي عن الخلط بين الخيال والواقع

57
00:05:21,050 --> 00:05:23,380
سينباي، أنت مُنحرف

58
00:05:23,860 --> 00:05:26,560
هـ-هذا مجرّد فصل إضافي سخيف

59
00:05:26,560 --> 00:05:29,890
ما أريد قراءته هو قصّة مصّاصي الدّماء الرئيسيّة

60
00:05:30,890 --> 00:05:32,390
قصّة مصّاصي دِماء؟

61
00:06:02,560 --> 00:06:05,430
كانت مُنحرفة، لكنّها جيّدة جدّاً

62
00:06:05,430 --> 00:06:06,260
حقّاً؟

63
00:06:06,790 --> 00:06:09,340
الحبّ والرومانسيّة مع شخص خالد

64
00:06:09,340 --> 00:06:13,140
أحبّ قصص مصّاصي الدّماء

65
00:06:13,350 --> 00:06:17,140
لكن إحدى الشخصيّات تُشبهك، أليس كذلك؟

66
00:06:17,440 --> 00:06:21,260
يجري من مكانٍ لآخر حاملاً بعض الثّوم
والذي لا يؤثّر أصلاً

67
00:06:21,260 --> 00:06:24,580
...يقع ضحيّة لأنياب مصّاصة الدِّماء

68
00:06:26,500 --> 00:06:29,910
وتُنتزَع الحياة منه

69
00:06:42,690 --> 00:06:44,800
إ-إنّه لا يشبهني بتاتاً

70
00:06:45,170 --> 00:06:49,680
لكن ستكون بخير إذا هوجِمت
بواسطة مصّاصة دِماء

71
00:06:49,680 --> 00:06:50,930
ماذا؟ لماذا؟

72
00:06:52,200 --> 00:06:53,800
لأنّك بِكر

73
00:06:55,380 --> 00:06:58,070
...لو لم تكن بِكراً

74
00:07:01,540 --> 00:07:02,880
!لانتهى الحال بك بالتحوّل إلى غول

75
00:07:02,880 --> 00:07:05,570
!غول أبله لا عقل له

76
00:07:06,120 --> 00:07:07,940
لكن ستكون بخير يا سينباي

77
00:07:07,940 --> 00:07:10,450
جيّد أنّك بِكر

78
00:07:10,820 --> 00:07:12,570
!اصمتي

79
00:07:12,970 --> 00:07:18,350
ما-ما أ-أدراكِ أنّني بـ-بكر؟

80
00:07:18,350 --> 00:07:20,240
هل أنتِ مصّاصة دماء أو ما شابه؟

81
00:07:20,240 --> 00:07:21,390
هذا صحيح

82
00:07:26,640 --> 00:07:30,620
هل تريد أن تتحقّق من ذلك إذاً؟

83
00:07:38,580 --> 00:07:39,850
أمزح

84
00:07:41,720 --> 00:07:44,300
أ-أكيد، بالطبع

85
00:07:49,380 --> 00:07:50,530
...هل يمكنني محاولة

86
00:07:50,820 --> 00:07:52,030
هل يمكنني محاولة...؟

87
00:07:52,580 --> 00:07:55,040
عضّك؟...

88
00:07:55,040 --> 00:07:55,740
!لا

89
00:07:55,740 --> 00:07:57,340
لن أمصّ

90
00:07:57,340 --> 00:07:59,810
أريد فقط مُحاولة العضّ

91
00:07:58,690 --> 00:07:59,810
!ما خطبكِ؟

92
00:07:59,810 --> 00:08:01,660
هل تخلّيتِ عن بشريّتكِ؟

93
00:08:01,660 --> 00:08:03,520
سأتظاهر فقط أنّني أمصّ دمك

94
00:08:03,520 --> 00:08:04,510
مجرّد تظاهر

95
00:08:05,010 --> 00:08:09,300
انظر. نابي حادّ جدّاً

96
00:08:09,300 --> 00:08:12,050
أريد فقط أن أجرّب منحك وخزة بهذا

97
00:08:19,850 --> 00:08:23,390
أشعر نفسي مصّاصة دماء فعلاً

98
00:08:23,650 --> 00:08:25,720
!يكفي

99
00:08:33,850 --> 00:08:35,520
ا-ابتعدي عنّي

100
00:08:35,520 --> 00:08:36,900
لا

101
00:08:36,900 --> 00:08:40,800
أنت فريستي الآن يا سينباي

102
00:08:40,800 --> 00:08:44,670
إ-إذا رآنا أحد فسوف يفهمنا بشكل خاطئ

103
00:08:44,670 --> 00:08:45,650
أهذا ما تريدينه؟

104
00:08:46,660 --> 00:08:49,100
ماذا تقصد بأنّه سيفهمنا بشكل خاطئ؟

105
00:08:50,580 --> 00:08:53,340
أ-أعني، تلك الأمور وما شابه

106
00:08:56,360 --> 00:08:58,640
لديك رقبة نحيلة يا سينباي

107
00:08:59,110 --> 00:09:01,280
!توقّفي! توقّفي

108
00:09:01,960 --> 00:09:03,640
!تـ-تمهّلي لحظة

109
00:09:03,990 --> 00:09:07,370
لمَ لا تدفعني بعيداً إذا لم يكن ذلك يُعجبك؟

110
00:09:07,370 --> 00:09:10,000
هذا إذا استطعت أصلاً

111
00:09:16,610 --> 00:09:17,410
!انتظري

112
00:09:20,900 --> 00:09:21,910
!مُقرف

113
00:09:21,910 --> 00:09:23,640
!رائحة ثوم

114
00:09:24,640 --> 00:09:25,750
!لن تفلت

115
00:09:28,000 --> 00:09:30,200
...هذا مُؤلم

116
00:09:42,540 --> 00:09:45,200
!حقّقتَ أمنيتك يا سينباي

117
00:09:45,200 --> 00:09:46,520
!حالفَك حظّ المُصادفات

118
00:09:46,520 --> 00:09:48,510
!الأمر ليس هكذا

119
00:10:06,160 --> 00:10:10,240
سينباي، هل كانت المرّة الأولى التي
تلمسك فيها فتاة؟

120
00:10:10,240 --> 00:10:13,250
تـ-تلمسني؟ تلمس ماذا؟

121
00:10:13,250 --> 00:10:15,590
كانت المرّة الأولى إذاً؟

122
00:10:15,590 --> 00:10:17,630
!لـ-لا أعلم

123
00:10:18,580 --> 00:10:20,510
وجهك أحمر يا سينباي

124
00:10:20,770 --> 00:10:23,510
...دعني أخمّن

125
00:10:24,610 --> 00:10:25,640
هل أصبح قاسياً؟

126
00:10:27,220 --> 00:10:29,620
!اصمتي

127
00:10:30,670 --> 00:10:33,320
أتريدني أن أعصره ثانية؟

128
00:10:42,010 --> 00:10:43,490
...مؤلم

129
00:10:45,540 --> 00:10:46,540
!أنتِ

130
00:10:52,210 --> 00:10:54,670
إلى اللّقاء يا سينباي

131
00:11:09,310 --> 00:11:10,980
سينباي

132
00:11:11,590 --> 00:11:12,730
هاك

133
00:11:13,090 --> 00:11:18,140
...عصر

134
00:11:42,760 --> 00:11:45,640
حسناً، هيّا بنا نبدأ

135
00:11:47,350 --> 00:11:48,990
!مرحباً يا سينباي

136
00:11:48,990 --> 00:11:51,650
لـ-لماذا أنتِ هنا؟

137
00:11:51,650 --> 00:11:53,440
كنتُ على وشك البدء بالرّسم

138
00:11:53,440 --> 00:11:54,900
لنلعب لعبة

139
00:11:56,350 --> 00:11:57,650
لعبة؟

140
00:11:59,050 --> 00:12:01,700
!لعبة تخمين مكان الحلمة

141
00:12:02,990 --> 00:12:04,190
القواعد بسيطة

142
00:12:04,190 --> 00:12:07,200
يجب عليك تخمين مكان حلمة الشّخص
الآخر من فوق ملابسه

143
00:12:07,740 --> 00:12:09,620
!هنا

144
00:12:14,660 --> 00:12:16,320
هذا كل ما عليك فعله

145
00:12:16,320 --> 00:12:17,320
اتّفقنا؟

146
00:12:17,320 --> 00:12:19,050
!أي اتّفاق هذا؟

147
00:12:19,450 --> 00:12:24,290
...بـ-بالإضافة إلى ذلك، إنَّ تخمين حـ-حلمة فتاة

148
00:12:24,290 --> 00:12:26,000
لا أحبّ اللّمس

149
00:12:26,000 --> 00:12:29,810
تتصرّف كبِكر حقّاً يا سينباي

150
00:12:30,060 --> 00:12:32,120
ما-ما علاقة الأمر بكوني بِكراً؟

151
00:12:32,120 --> 00:12:35,740
لا جدوى من اللّعب، حتّى لو فزتُ

152
00:12:35,740 --> 00:12:37,060
لا، بل يوجد

153
00:12:37,780 --> 00:12:39,260
جائزة كُبرى

154
00:12:44,280 --> 00:12:48,070
"تذكرة "يمكنك أن تطلب منّي فعل أي شيء

155
00:12:48,420 --> 00:12:50,780
...متى عبثتُ معك

156
00:12:55,500 --> 00:12:56,930
...يمكنك استعمال هذه

157
00:12:57,930 --> 00:12:59,120
!توقّفي

158
00:12:59,120 --> 00:13:00,340
حسناً

159
00:13:00,340 --> 00:13:03,340
يمكنك أن تُوقفني بهذه الطريقة

160
00:13:03,720 --> 00:13:07,180
لا داعي لأن يكون طلباً مُملّاً أيضاً

161
00:13:07,180 --> 00:13:10,350
يمكنك استعمالها لتطلب منّي فعل
شيء أكثر جنوناً

162
00:13:10,520 --> 00:13:12,460
شيء أكثر جنوناً؟

163
00:13:12,460 --> 00:13:17,540
ماذا؟ تريدني أن أرتدي زيّ السّباحة
!في غرفة النّادي؟

164
00:13:17,540 --> 00:13:18,970
!لم أقل ذلك أبداً

165
00:13:18,970 --> 00:13:23,440
!ماذا؟ تريدني أن أكون عارِضة مُتعرّية؟

166
00:13:23,440 --> 00:13:25,610
!ليس عليك فعل ذلك

167
00:13:25,610 --> 00:13:26,950
...لا أعلم

168
00:13:26,950 --> 00:13:28,960
لماذا تستخدم التّذكرة في هذه الأمور؟

169
00:13:28,960 --> 00:13:34,620
أنت فاحش جدّاً يا سينباي

170
00:13:31,620 --> 00:13:34,620
"لا أبالي لاستخدامها في "أمور مجنونة

171
00:13:34,990 --> 00:13:38,630
...لكن إذا استطعتُ استخدامها لإيقافها

172
00:13:38,630 --> 00:13:40,450
أنت فاحش جدّاً يا سينباي

173
00:13:39,010 --> 00:13:40,450
مـ-موافق

174
00:13:40,810 --> 00:13:41,730
سألعب

175
00:13:41,730 --> 00:13:43,180
هكذا هي المعنويات يا سينباي

176
00:13:43,180 --> 00:13:44,960
هذا ما أردتُ سماعه

177
00:13:47,330 --> 00:13:49,450
حسناً، لنبدأ

178
00:13:50,130 --> 00:13:52,390
سـ-ستكون مُحاولة واحدة، اتّفقنا؟

179
00:13:58,480 --> 00:14:00,020
يـ-يمكنني فعلها

180
00:14:01,000 --> 00:14:04,030
لن تخمّن بشكل صحيح من البداية

181
00:14:32,080 --> 00:14:36,680
!إ-إصابة مُباشرة

182
00:14:39,800 --> 00:14:41,640
لحظة، أخفقتْ

183
00:14:42,160 --> 00:14:44,260
إنّها بعيدة بفارق بسيط

184
00:14:44,960 --> 00:14:47,690
،لستُ أدري، لكن هذا أمر ذاتيّ

185
00:14:48,100 --> 00:14:50,400
لذا أستطيع أن أخبرها أنّها أخفقت فحسب

186
00:14:50,400 --> 00:14:52,300
أ-أخفقتِ

187
00:14:54,480 --> 00:14:56,100
ما رأيك يا سينباي؟

188
00:14:56,100 --> 00:14:57,790
هل نلتُ منك؟

189
00:14:59,160 --> 00:15:00,140
!لـ-لا

190
00:15:01,490 --> 00:15:02,740
هل أخفقت؟

191
00:15:02,740 --> 00:15:03,960
—أنتِ تـ-تـ

192
00:15:04,400 --> 00:15:05,060
ما رأيك؟

193
00:15:05,060 --> 00:15:08,970
هل نلتُ منك؟ سينباي؟

194
00:15:11,010 --> 00:15:12,970
!سينباي

195
00:15:15,450 --> 00:15:17,720
!نلتِ منّي

196
00:15:23,680 --> 00:15:25,730
حسناً، دورك يا سينباي

197
00:15:26,260 --> 00:15:29,490
مع أنّك لا تملك الجرأة لفعل ذلك

198
00:15:29,940 --> 00:15:34,850
حسناً، تذكرة "يمكنك أن تطلب منّي فعل
أي شيء" هي لي إذاً

199
00:15:34,850 --> 00:15:36,420
على ماذا ينبغي أن أستخدمها؟

200
00:15:36,420 --> 00:15:37,490
سأفعل ذلك

201
00:15:37,820 --> 00:15:39,760
هل أنت متأكّد أنّك تستطيع فعل ذلك؟

202
00:15:40,160 --> 00:15:42,430
قلتُ سأفعلها

203
00:15:43,380 --> 00:15:44,830
هكذا إذاً

204
00:15:46,130 --> 00:15:48,100
حسناً، تعال

205
00:16:16,870 --> 00:16:18,960
!انتهى الوقت

206
00:16:18,960 --> 00:16:19,630
!ماذا؟

207
00:16:19,630 --> 00:16:22,290
!لم تذكري شيئاً عن الوقت

208
00:16:22,290 --> 00:16:24,850
!نسيتُ أنّه عليّ اللّقاء بأصدقائي

209
00:16:25,920 --> 00:16:27,790
...مـ-مهلاً

210
00:16:35,390 --> 00:16:38,810
،إحدى مطاعم العائلة المُفضّلة لديّ
بعيداً عن طريق مدرستي

211
00:16:39,730 --> 00:16:43,360
يمكنني أخيراً أن أسترخي وأعمل على المانغا خاصّتي

212
00:16:43,360 --> 00:16:46,060
مرحى، أعتقد أنَّ المكان كلّه لنا

213
00:16:46,060 --> 00:16:47,460
أخبرتُك

214
00:16:51,090 --> 00:16:52,320
!ناغاتورو

215
00:16:52,920 --> 00:16:54,740
أين ينبغي أن نجلس؟

216
00:16:56,240 --> 00:16:58,060
ما رأيكم هناك؟

217
00:17:02,160 --> 00:17:06,330
ماذا؟ مُعلّمكِ في الأدب المُعاصر هو
كوبا-سينسي يا ناغاتورو-تشان؟

218
00:17:07,140 --> 00:17:09,860
يظلّ يُثرثر، أليس كذلك؟

219
00:17:09,860 --> 00:17:14,090
هذان الصبيّان من الصفّ المُجاور لصفّي

220
00:17:14,450 --> 00:17:18,480
سمعتُ أنّك مُنتسب لفرقة غنائيّة، أليس كذلك يا سينباي؟

221
00:17:18,480 --> 00:17:21,790
أجل. يؤلّف هذه الأغاني الرّائعة

222
00:17:21,790 --> 00:17:23,560
لا تخبرهما

223
00:17:24,100 --> 00:17:27,100
مثل يابا بي؟

224
00:17:27,280 --> 00:17:30,420
لا، الأمر ليس كذلك

225
00:17:30,420 --> 00:17:34,580
إذا كان عليّ وصف الأمر، فهو بمثابة امتداد للفنون

226
00:17:34,580 --> 00:17:37,860
هل تريدان الاستماع؟

227
00:17:38,800 --> 00:17:42,610
إنّها ليست من الألحان البسيطة التي تُرضي
الجمهور التي نسمعها طوال الوقت

228
00:17:42,610 --> 00:17:47,870
موسيقايّ تدمج العناصر الفنّية المُستوحاة
من السّول والهيب هوب

229
00:17:49,670 --> 00:17:52,160
أنا ذاهبة لنافورة الشّرب

230
00:17:52,160 --> 00:17:54,220
أنا أيضاً

231
00:17:55,200 --> 00:17:56,900
إلى اللّقاء

232
00:17:57,800 --> 00:18:01,980
على أي حال، أعتقد أنَّ الفنّ غير مفهوم حقّاً

233
00:18:01,980 --> 00:18:04,850
في الواقع، إنّه فنّ لأنّه غير مفهوم

234
00:18:04,850 --> 00:18:08,650
تبدو ناغاتورو منزعجة جدّاً

235
00:18:08,990 --> 00:18:13,400
لا أعتقد أنّ هذا الفتى يعلم كم هي ساديّة

236
00:18:13,400 --> 00:18:16,080
إنّه كفراشة تنجذب نحو النّار

237
00:18:17,420 --> 00:18:19,030
هذه موسيقى؟

238
00:18:19,030 --> 00:18:21,920
ظننتُها خطأ برمجيّاً من نوع ما

239
00:18:24,160 --> 00:18:27,410
!لنرَ كيف ستعبث معك

240
00:18:30,410 --> 00:18:32,530
لستُ أفهمها

241
00:18:32,530 --> 00:18:33,420
ماذا؟

242
00:18:33,620 --> 00:18:35,120
حـ-حقّاً؟

243
00:18:35,540 --> 00:18:37,800
أعتقد إنّها مُعقّدة زيادة عن اللّزوم

244
00:18:38,310 --> 00:18:40,270
...ليست مُعقّدة بقدر ما

245
00:18:42,260 --> 00:18:44,590
أنّني لم أشعر بشيء فعليّاً

246
00:18:45,270 --> 00:18:47,930
يبدو أنّك غير مهتمّ بها أصلاً

247
00:18:48,720 --> 00:18:49,940
هل كلامي خاطئ؟

248
00:18:51,920 --> 00:18:53,440
...فـ-في الواقع

249
00:18:54,040 --> 00:18:57,580
لم تكن هذه ردّة الفعل التي كنتُ أتوقّعها

250
00:18:58,560 --> 00:19:00,010
أنا ذاهب إلى دورة المياه

251
00:19:02,000 --> 00:19:03,200
ماذا تقول؟

252
00:19:03,640 --> 00:19:04,820
آسف بشأنه

253
00:19:04,820 --> 00:19:07,170
إنّه سيّئ في فهم الأجواء المُحيطة

254
00:19:07,170 --> 00:19:11,960
لم أكن سأحضره، لكن أصرّ على المجيء

255
00:19:12,480 --> 00:19:16,210
أنتِ مُحتاطة جدّاً، أليس كذلك يا ناغاتورو-تشان؟

256
00:19:16,740 --> 00:19:17,960
أنا كذلك؟

257
00:19:18,290 --> 00:19:21,460
!ليس عليكِ أن تكوني يقِظة إلى هذا الحدّ بيننا

258
00:19:20,110 --> 00:19:23,240
هذا الرّجل مُلِحّ

259
00:19:21,460 --> 00:19:24,040
،ذهبتُ إلى مدرسة إعداديّة للذكور

260
00:19:24,040 --> 00:19:27,470
لذا لا أجيد التّعامل مع الفتيات تماماً

261
00:19:27,870 --> 00:19:30,230
لم ألعب بصدر فتاة من قبل أيضاً

262
00:19:30,480 --> 00:19:32,140
أنا جادّ

263
00:19:33,030 --> 00:19:33,860
ماذا؟

264
00:19:34,230 --> 00:19:36,280
!لا تعلم ما ينتظرك

265
00:19:36,280 --> 00:19:38,430
،لا أعلم ما إن كنتَ تحاول أن تُرخي دفاعها

266
00:19:38,430 --> 00:19:40,240
لكن جعلتَ نفسك هدفاً سهلاً الآن

267
00:19:40,650 --> 00:19:42,250
!بجدّية؟

268
00:19:42,250 --> 00:19:45,860
أصبحتَ بهذا السنّ ولم تلمس صدر فتاة
من قبل أبداً؟ كم هذا قاسٍ

269
00:19:45,860 --> 00:19:47,890
اذهب والعب بجيلي كونياك أو ما شابه

270
00:19:47,890 --> 00:19:49,500
سيلائمك

271
00:19:49,500 --> 00:19:53,000
!تلقَّ التنمُّر وابكِ مثلما بكيتُ أنا

272
00:19:53,590 --> 00:19:59,010
لا أعتقد أنَّ هذا كلام ملائم لتقوله
لفتاة تلتقيها لأوّل مرّة

273
00:20:06,140 --> 00:20:07,970
أ-أنا ذاهب إلى دورة المياه

274
00:20:11,340 --> 00:20:12,560
ماذا؟

275
00:20:14,060 --> 00:20:17,660
تورو-تشان، لستِ مهتمّة بالشّباب؟

276
00:20:17,660 --> 00:20:19,040
ليس تماماً

277
00:20:19,040 --> 00:20:21,860
كلّ ما في الأمر أنّهما مُملّان

278
00:20:21,860 --> 00:20:25,330
أظنّهما مُعجبان بكِ

279
00:20:25,330 --> 00:20:27,940
لهذا رتّبتُ لقاء بينكم

280
00:20:27,940 --> 00:20:32,610
!قلتُ لكِ أن تتوقّفي عن ذلك

281
00:20:32,610 --> 00:20:33,650
!تبّاً

282
00:20:33,650 --> 00:20:36,040
!لكنّهما وسيمان

283
00:20:44,770 --> 00:20:46,180
...مهلاً

284
00:20:46,180 --> 00:20:50,520
هل أنا الوحيد الذي تعبث معه ناغاتورو؟

285
00:20:53,530 --> 00:20:55,070
ما الأخبار يا سينباي؟

286
00:20:55,070 --> 00:20:57,190
هل أنت في طريقك إلى المنزل أيضاً يا سينباي؟

287
00:20:57,190 --> 00:20:58,750
أ-أجل

288
00:20:59,760 --> 00:21:03,230
لديك ظلّ مُميّز يا سينباي

289
00:21:03,230 --> 00:21:05,650
أستطيع تمييزك من بعيد حقّاً

290
00:21:05,650 --> 00:21:08,920
كأن أقول، "انظروا إلى ذلك الشيء
"!المُريب الذي هناك

291
00:21:08,920 --> 00:21:10,790
!كفّي عن نعتي بالمُريب

292
00:21:12,910 --> 00:21:15,730
أنت مُتعرّج حقّاً

293
00:21:16,540 --> 00:21:25,680
تعرُّج، تعرُّج

294
00:21:23,570 --> 00:21:25,680
...المعذرة يا ناغاتورو

295
00:21:27,180 --> 00:21:28,850
ما الأمر يا سينباي؟

296
00:21:28,850 --> 00:21:30,680
لا، لا شيء

297
00:21:30,680 --> 00:21:32,430
ماذا؟ ماذا؟

298
00:21:32,430 --> 00:21:33,430
أريد أن أعرف

299
00:21:33,840 --> 00:21:36,350
قـ-قلتُ لا شيء

300
00:21:36,350 --> 00:21:38,490
إنّه يتعرّج من جديد

301
00:21:38,490 --> 00:21:39,470
مُقرف

302
00:21:40,150 --> 00:21:41,940
!ا-اصمتي

303
00:21:41,940 --> 00:21:43,940
سينباي مُقرف جدّاً

304
00:21:45,980 --> 00:21:47,940
!مُقرف جدّاً

305
00:21:48,560 --> 00:21:53,170
!إنّه مُقرف جدّاً

306
00:21:49,620 --> 00:21:52,020
!كفّي عن نعتي بالمُقرف

307
00:21:53,170 --> 00:21:54,950
!سيكون مُقرفاً غداً أيضاً

308
00:23:25,900 --> 00:23:27,450
!نقاط التحسّن لهذا اليوم

309
00:23:27,450 --> 00:23:28,710
هل سنفعل هذا كلّ أسبوع؟

310
00:23:28,710 --> 00:23:30,500
أهذا مثل المانغا التي رسمتها؟

311
00:23:30,500 --> 00:23:31,680
هذا مُشابه

312
00:23:31,680 --> 00:23:37,030
أنا واثقة أنّ البطل مثلك، ويتمّ امتصاصه
بواسطة مصّاصة دماء

313
00:23:37,030 --> 00:23:37,990
...لـ-لا

314
00:23:37,990 --> 00:23:39,990
أنت مكشوف بشكلٍ فاضح يا سينباي