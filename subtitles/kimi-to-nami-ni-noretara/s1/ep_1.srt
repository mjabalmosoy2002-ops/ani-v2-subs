.منذ صغري وأنا أعيش في هذه الأرجاء

827
00:51:18,880 --> 00:51:22,800
.أمارس الرّكمجة يوميًا وأعلو الأمواج في كلّ مرّة

828
00:51:23,680 --> 00:51:25,010
...لكنّني الآن

829
00:51:25,930 --> 00:51:31,600
.ما عدت أعرف كيف أجابه البرّ أو البحر

830
00:51:35,860 --> 00:51:37,990
،مهما كانت الأمواج صغيرة

831
00:51:37,990 --> 00:51:40,410
.تظلّ لديها القوّة لقطع لمسافاتٍ طويلة

832
00:51:41,280 --> 00:51:44,160
.وتلك القوّة هي ما يثبط همّتكِ الآن

833
00:51:45,030 --> 00:51:47,500
.وأنا واحدٌ من بحر الأمواج تلك

834
00:51:47,500 --> 00:51:49,870
.من اللّازم أن تستعدّي للموجة التّالية

835
00:51:50,870 --> 00:51:52,880
.لا تقل ما يفطر القلب

836
00:51:52,880 --> 00:51:54,420
!أنا لا أريد أحدًا سواك

837
00:51:54,420 --> 00:51:56,920
!أريد أن أكون معك مدى الحياة

838
00:51:56,920 --> 00:51:58,510
.سأهبّ دائمًا لمساعدتكِ

839
00:51:58,510 --> 00:52:00,090
.وسأستمرّ في دعمكِ

840
00:52:00,800 --> 00:52:03,090
.إلى أن تقوي على ركوب موجتك

841
00:52:45,090 --> 00:52:46,600
.أهلًا وسهلًا

842
00:52:46,600 --> 00:52:47,970
ماذا؟ ما الأمر؟

843
00:52:48,640 --> 00:52:51,640
.سمعت من أمّكِ أنّكِ بدأتِ العمل هنا بدوامٍ جزئيّ

844
00:52:51,640 --> 00:52:53,730
.ولديّ ما أحدّثكِ حوله

845
00:52:53,730 --> 00:52:56,900
!سآخذ استراحةً أيّها المدير

846
00:52:56,900 --> 00:52:58,270
.تفضّل. اشرب

847
00:52:58,270 --> 00:53:00,400
ما الّذي دفعك للقدوم إلى هنا؟

848
00:53:03,280 --> 00:53:06,570
.لا تقلق. ما دمت تتصرّف على طبيعتك

849
00:53:06,570 --> 00:53:07,370
...يوكو-تشان

850
00:53:07,370 --> 00:53:09,120
.لقد أخبرك أخي بذلك أيضًا

851
00:53:09,120 --> 00:53:10,540
.ابتهج

852
00:53:10,540 --> 00:53:14,830
.حسنٌ، لستُ هنا للتحدّث عن إخفاقي في العمل

853
00:53:14,830 --> 00:53:15,880
ألستَ كذلك؟

854
00:53:16,960 --> 00:53:18,800
.الأمر يتعلّق بهيناكو-سان

855
00:53:20,340 --> 00:53:22,260
.فهمت

856
00:53:22,260 --> 00:53:23,550
.إنّها تتصرّف بغرابة

857
00:53:23,550 --> 00:53:24,800
.تلك طبيعتها

858
00:53:25,640 --> 00:53:28,560
.إنّها تتحدّث دائمًا إلى قنّينة ماء

859
00:53:28,560 --> 00:53:31,350
.وتتمشّى مع دمية خنزير البحر الخاصّة بميناتو-سان

860
00:53:31,980 --> 00:53:35,560
.كما لو أنّه يخيّل لها أن السّينباي في الماء

861
00:53:35,560 --> 00:53:37,310
أكنت تتعقّبها؟

862
00:53:38,190 --> 00:53:39,520
.كنتُ قلقًا عليها

863
00:53:39,520 --> 00:53:40,320
لماذا؟

864
00:53:41,110 --> 00:53:42,440
...أتساءل لماذا

865
00:53:43,400 --> 00:53:47,450
لطالما كان السّينباي يراقبها من سطح
.قسم الإطفاء أثناء ركوبها الأمواج

866
00:53:47,450 --> 00:53:50,080
.وقد شدّت انتباهي أيضًا

867
00:53:50,080 --> 00:53:52,870
...لكن لكونها صديقة ميناتو

868
00:53:52,870 --> 00:53:55,620
.المعذرة، هذا ليس ما أردت التحدّث عنه

869
00:53:55,620 --> 00:53:59,590
.لا ينفكّ القلق يساورني حيال حالة هيناكو-سان الحالية

870
00:53:59,590 --> 00:54:00,380
!أيّها الأحمق واسابي

871
00:54:00,380 --> 00:54:01,170
ماذا؟

872
00:54:01,170 --> 00:54:03,510
!إن كنت قلقًا عليها، فاذهب إليها

873
00:54:03,510 --> 00:54:04,550
!اعترف لها مباشرةً

874
00:54:04,550 --> 00:54:05,630
ألستَ تحبّها؟

875
00:54:05,630 --> 00:54:07,470
!لماذا جئت لتخبرني بذلك؟

876
00:54:08,760 --> 00:54:11,680
!فليكن في علمك أنّ الحبّ للحمقى

877
00:54:12,310 --> 00:54:14,640
!لقد انقضت استراحتي أيّها المدير

878
00:54:29,450 --> 00:54:30,740
.آسف

879
00:54:31,870 --> 00:54:34,830
.المعذرة، لطالما أردت أن أعيد لكِ هذه المنشفة

880
00:54:36,000 --> 00:54:38,580
أأنت رجل الإطفاء ذاك؟

881
00:54:38,580 --> 00:54:41,250
ألم تتعرّفي عليّ من قبل؟

882
00:54:41,250 --> 00:54:42,800
.آسفة

883
00:54:42,800 --> 00:54:44,840
.لا عليك. الأمر لا يستدعي منشفة

884
00:54:45,470 --> 00:54:46,880
أتريد شراء باقة زهور؟

885
00:54:46,880 --> 00:54:48,180
!أجل

886
00:54:54,890 --> 00:54:58,810
.آمل أن تنال هذه الزّهور إعجاب من ستقدمها لها

887
00:54:58,810 --> 00:54:59,400
ماذا؟

888
00:55:00,730 --> 00:55:04,650
.اخترت زهورًا زرقاء وبيضاء لأنّها فتاةٌ تحبّ البحر

889
00:55:04,650 --> 00:55:05,900
لكن هل كان اختياري خائبًا؟

890
00:55:05,900 --> 00:55:07,490
.على العكس تمامًا

891
00:55:07,490 --> 00:55:09,320
!إنّها جميلةٌ جدًا

892
00:55:09,320 --> 00:55:10,490
.هذا مطمئن

893
00:55:12,080 --> 00:55:13,910
ألم تحضريها معكِ اليوم؟

894
00:55:13,910 --> 00:55:14,870
ماذا؟

895
00:55:14,870 --> 00:55:17,500
ألستِ تحملينها معكِ على الدّوام مؤخّرًا؟

896
00:55:17,500 --> 00:55:19,620
.قنينة الماء وما شابه

897
00:55:19,620 --> 00:55:21,080
.أنا في خضمّ العمل

898
00:55:21,080 --> 00:55:22,920
.ودمية خنزير البحر البلاستيكية تلك

899
00:55:22,920 --> 00:55:24,750
ماذا؟! كيف عرفت؟

900
00:55:25,300 --> 00:55:30,760
حسنٌ، أراكِ عندما تمرّين قرب
.قسم الإطفاء أو أصادفكِ في أماكن أخرى

901
00:55:30,760 --> 00:55:32,300
.لكن لم أجرأ على محادثتكِ

902
00:55:33,100 --> 00:55:36,100
!كنتِ كما لو أنّكِ تحدّثين القنّينة على أنّ السّينباي بداخلها

903
00:55:36,100 --> 00:55:37,680
!آسفة. كنت أحادث نفسي فقط

904
00:55:37,680 --> 00:55:38,350
...ولكن

905
00:55:38,350 --> 00:55:40,900
!عجّل بتسليم الزّهور قبل أن تذبل

906
00:55:41,400 --> 00:55:43,440
!المعذرة، إنّها لكِ يا هيناكو-سان

907
00:55:43,440 --> 00:55:44,110
ماذا؟

908
00:55:45,070 --> 00:55:47,440
.لكنّك قلت أنّها لشخصٍ يحبّ البحر

909
00:55:47,440 --> 00:55:50,910
.لطالما نظرت إليك أيضًا بنظرة إعجاب

910
00:55:50,910 --> 00:55:53,120
أم أنّ لا فرصة لديّ؟

911
00:55:53,120 --> 00:55:55,700
أتعتقدين أنّني لا أستطيع أن أسعدكِ؟

912
00:55:56,200 --> 00:55:58,710
!أنا أريد أن أسعدكِ يا هيناكو-سان

913
00:55:58,710 --> 00:56:00,000
!لأنّني أحبّكِ

914
00:56:00,000 --> 00:56:02,880
...لـ-لـ-لكنّني

915
00:56:04,170 --> 00:56:05,380
.آسفة

916
00:56:13,800 --> 00:56:18,520
♪ما خطف بصرك♪

917
00:56:18,520 --> 00:56:19,520
ما الخطب يا هيناكو؟

918
00:56:19,520 --> 00:56:21,560
...واسابي-سان... واسابي-سان

919
00:56:21,560 --> 00:56:23,100
!ما به؟

920
00:56:23,100 --> 00:56:24,810
!قال أنّه يحبّني

921
00:56:26,820 --> 00:56:28,780
وماذا عنكِ؟

922
00:56:28,780 --> 00:56:30,610
تسألني رأيي؟

923
00:56:30,610 --> 00:56:32,160
!أنا لا حبّ سواك

924
00:56:32,820 --> 00:56:35,950
!أنا لا أستطيع أن أشدّ على يدكِ

925
00:56:35,950 --> 00:56:37,490
.ولا أن أحضنكِ

926
00:56:37,490 --> 00:56:38,330
.ولا أن أقبّلكِ

927
00:56:41,500 --> 00:56:43,710
.إنّه شخصٌ صالح

928
00:56:43,710 --> 00:56:45,290
...ميناتو

929
00:56:45,290 --> 00:56:48,130
.إنّه أكثر استقامةً ولطفًا منّي

930
00:56:48,130 --> 00:56:50,170
لماذا تقول هذا الكلام؟

931
00:56:50,170 --> 00:56:52,090
.أنا راضيةٌ بهذا الوضع

932
00:56:52,090 --> 00:56:54,470
يمكنني أن أراك عندما أغنّي
،حتّى إن لم نستطع أن نشابك يدينا

933
00:56:54,470 --> 00:56:56,010
...وحتّى إن لم تحضنّي

934
00:56:56,010 --> 00:56:57,890
سنكون معًا إلى الأبد، أليس كذلك؟

935
00:56:57,890 --> 00:56:58,810
!ذلك يكفيني

936
00:56:58,810 --> 00:57:00,480
!اهدئي يا هيناكو

937
00:57:00,480 --> 00:57:03,440
.سيعتقد النّاس أنّكِ شخصٌ غريب الأطوار يتحدّث إلى الحمّام

938
00:57:05,480 --> 00:57:07,400
.لم أتمالك نفسي

939
00:57:08,320 --> 00:57:09,980
.أصغي يا هيناكو

940
00:57:10,740 --> 00:57:13,780
.الأمواج الجديدة ستستمرّ في القدوم

941
00:57:13,780 --> 00:57:15,490
.وليست كلّ الأمواج هيّنة

942
00:57:15,490 --> 00:57:17,160
.وأحيانًا عليكِ التخلّي عنها

943
00:57:18,160 --> 00:57:19,910
،إن أفنيتِ عمركِ تحت الماء

944
00:57:20,700 --> 00:57:22,710
.فإنّ ركوب الأمواج عليكِ محال

945
00:57:42,480 --> 00:57:43,890
!هيناكو-سان

946
00:57:47,900 --> 00:57:48,690
!حريق

947
00:57:48,690 --> 00:57:50,570
!اتّصلوا بالطّوارئ

948
00:57:49,860 --> 00:57:50,570
!حادث

949
00:57:51,280 --> 00:57:52,990
!لم يخرج سائق السيّارة الصّغيرة

950
00:57:52,990 --> 00:57:54,400
!لا فائدة! لا يمكننا مساعدته

951
00:57:54,400 --> 00:57:55,660
!لكن ما زال أحدهم داخلها

952
00:57:55,660 --> 00:57:56,740
!احذري

953
00:57:55,950 --> 00:57:57,280
...لو كان ميناتو هنا

954
00:57:57,280 --> 00:57:59,280
!لو كان ميناتو هنا لأنجده

955
00:58:00,080 --> 00:58:04,410
♪ما خطف بصرك♪

956
00:58:02,950 --> 00:58:04,410
.هيناكو-سان

957
00:58:04,410 --> 00:58:09,340
♪.أديم ماءٍ يشعّ بريقًا♪

958
00:58:06,120 --> 00:58:07,500
!هيناكو-سان

959
00:58:09,340 --> 00:58:13,970
♪تتغيّر ألوانه شيئًا فشيئًا♪

960
00:58:41,490 --> 00:58:42,580
ميناتو؟

961
00:58:42,580 --> 00:58:43,660
ما الخطب؟

962
00:58:43,660 --> 00:58:45,580
!لا أستطيع سماع صوت ميناتو

963
00:58:45,580 --> 00:58:46,580
.هيناكو-سان

964
00:58:46,580 --> 00:58:48,120
!ميناتو

965
00:58:48,710 --> 00:58:50,080
!سيختفي ميناتو

966
00:58:50,080 --> 00:58:51,250
.هيناكو-سان

967
00:58:50,460 --> 00:58:52,670
!يكاد ميناتو يختفي

968
00:58:52,670 --> 00:58:54,760
!تمالكي نفسكِ يا هيناكو-سان

969
00:58:54,760 --> 00:58:57,470
!أكره قول هذا، لكن السّينباي لم يعد معنا

970
00:58:57,470 --> 00:58:58,930
!لا وجود للأشباح

971
00:58:58,180 --> 00:59:00,720
،لعلّك غير قادرٍ على رؤيته يا واسابي-سان

972
00:59:00,720 --> 00:59:03,100
!لكنّ ميناتو موجودٌ في الماء

973
00:59:03,100 --> 00:59:05,180
!يظهر عندما أغنّي

974
00:59:05,180 --> 00:59:07,190
!يمكنني رؤيته

975
00:59:07,190 --> 00:59:10,350
!إنّك مخطئٌ بقولك أنّه ليس معنا

976
00:59:10,350 --> 00:59:13,190
!إنّ ميناتو بجواري دائمًا

977
00:59:14,190 --> 00:59:18,820
.صحيحٌ أنّي لن أستغرب من عودة السّينباي من شدّة حبّه لك

978
00:59:18,820 --> 00:59:22,990
!لكنّني أعتقد أنّه لن يشاء رؤيتكِ في هذه الحالة

979
00:59:23,990 --> 00:59:26,000
...كان السّينباي يقول

980
00:59:26,000 --> 00:59:28,500
.أنّكِ بطلته

981
00:59:27,500 --> 00:59:38,630
مـرأب

982
00:59:28,500 --> 00:59:32,380
ألم تكوني دائمًا تركبين الأمواج لوحدكِ في زهوّ؟

983
00:59:32,380 --> 00:59:33,710
ما الّذي تغيّر الآن؟

984
00:59:34,340 --> 00:59:35,670
.أعرف

985
00:59:36,090 --> 00:59:37,720
...أعرف ذلك، ولكن

986
00:59:38,630 --> 00:59:39,840
مـرأب

987
00:59:39,840 --> 00:59:44,060
إن استمررتِ على هذا الحال فإنّ
!روح السّينباي لن تعرف الخلاص

988
00:59:44,060 --> 00:59:45,720
!هيناكو-سان

989
00:59:44,060 --> 00:59:47,060
مـرأب

990
00:59:49,480 --> 00:59:50,390
!ميناتو

991
00:59:56,730 --> 01:00:00,860
♪ما خطف بصرك♪

992
01:00:00,860 --> 01:00:05,080
♪.أديم ماءٍ يشعّ بريقًا♪

993
01:00:05,080 --> 01:00:05,830
!كوهينا

994
01:00:05,830 --> 01:00:06,290
!هيناكو

995
01:00:06,290 --> 01:00:07,910
!إنّي آسفةٌ يا ميناتو

996
01:00:07,910 --> 01:00:10,290
!لقد أثقلت عليك بطلباتي

997
01:00:10,290 --> 01:00:13,080
!لم أنفكّ عن مناداتك

998
01:00:13,080 --> 01:00:15,090
ماذا سأفعل؟

999
01:00:15,090 --> 01:00:17,880
ماذا سأفعل إن رحلت عنّي؟

1000
01:00:17,880 --> 01:00:19,380
.أنا آسفة

1001
01:00:39,400 --> 01:00:41,200
...ما♪

1002
01:00:48,740 --> 01:00:50,750
.تفضّلي بالجلوس أينما شئتِ

1003
01:00:54,880 --> 01:00:59,210
يتميّز مقهانا بالعديد من الطّرق للاستمتاع بتوليفتنا

1004
01:00:59,210 --> 01:01:00,630
.وأصيكِ بالتّخمير بالتّنقيط

1005
01:01:00,630 --> 01:01:03,510
.وبغضّ النّظر عن طلبك، أرجو ألّا يكون صودا الفراولة

1006
01:01:04,390 --> 01:01:06,050
!كان هذا مبهرًا يا يوكو-تشان

1007
01:01:06,050 --> 01:01:07,430
أجئتِ للسّخريّة منّي؟

1008
01:01:07,430 --> 01:01:08,600
.بالطّبع لا

1009
01:01:08,600 --> 01:01:11,060
.سمعت أنّكِ تعملين هنا بدوامٍ جزئيّ

1010
01:01:11,060 --> 01:01:12,020
من واسابي؟

1011
01:01:12,020 --> 01:01:12,850
.أجل

1012
01:01:12,850 --> 01:01:14,020
هل أخبركِ بشيءٍ آخر؟

1013
01:01:14,020 --> 01:01:14,400
ماذا؟

1014
01:01:14,980 --> 01:01:16,900
...لا، لا شيء يستحقّ الذّكر

1015
01:01:17,730 --> 01:01:20,190
!في الواقع، أتمنّى حقًا لو كنت أخطبوطًا أزرق الحلقات

1016
01:01:20,190 --> 01:01:21,900
!أنا حقًا أريد أن أعضّك

1017
01:01:21,900 --> 01:01:22,490
ماذا؟

1018
01:01:24,110 --> 01:01:25,410
.لا تهتمّي

1019
01:01:27,280 --> 01:01:29,330
لماذا تعملين هنا يا يوكو-تشان؟

1020
01:01:29,330 --> 01:01:31,410
.لقد قرّرت افتتاح مقهى

1021
01:01:31,410 --> 01:01:32,290
ماذا؟

1022
01:01:32,290 --> 01:01:34,710
.كان حلم أخي أن يمتلك مقهى

1023
01:01:34,710 --> 01:01:36,130
.وأنا سأحقّقه

1024
01:01:37,080 --> 01:01:40,380
