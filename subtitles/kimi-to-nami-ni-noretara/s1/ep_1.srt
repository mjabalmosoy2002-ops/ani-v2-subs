.لم يبلغ ذلك المستوى بين عشيّةٍ وضحاها

224
00:13:22,820 --> 00:13:26,910
.فقط أولئك الّذين يعملون بلا كللٍ يمكنهم بلوغ ذلك المستوى

225
00:13:26,910 --> 00:13:30,080
.إنّك موهوب ويمكنك أن تتفوّق عليّ

226
00:13:30,580 --> 00:13:31,490
.سأنصرف قبلك

227
00:13:31,490 --> 00:13:32,370
.سينباي

228
00:13:33,160 --> 00:13:35,120
.تبدو سعيدًا

229
00:13:36,080 --> 00:13:37,370
.لأنّني سأركب الأمواج

230
00:13:49,600 --> 00:13:50,890
هل أبكرنا القدوم؟

231
00:13:50,890 --> 00:13:52,140
!ماذا؟ لا

232
00:13:52,140 --> 00:13:54,890
.لست نعسانةً على الإطلاق

233
00:13:54,890 --> 00:13:56,770
.ماذا؟ هذا غريب

234
00:13:57,560 --> 00:13:59,440
.يمكنكِ النّوم حتّى نصل

235
00:13:59,440 --> 00:14:01,190
.لا شكّ أنّ توضيب المنزل كان متعبًا

236
00:14:01,190 --> 00:14:04,110
انتقلت فقط من الطّابق الثّامن إلى
.الثّاني والأمور على ما يرام الآن

237
00:14:04,110 --> 00:14:05,440
.كلّ شيءٍ في مكانه

238
00:14:05,440 --> 00:14:08,280
.المواد الّتي بنيت بها شُرف ذلك المبنى سريعة الاشتعال

239
00:14:08,280 --> 00:14:11,830
.لهذا انتقلت النّيران عبرها صعودًا بسرعة

240
00:14:12,330 --> 00:14:13,410
.توخّي الحذر

241
00:14:13,410 --> 00:14:15,200
.أجل. سآخذ حذري

242
00:14:15,580 --> 00:14:17,250
.لكن لا بدّ أنّ الأمر شاقٌ عليكم

243
00:14:17,250 --> 00:14:19,790
مجموعةٌ من الشّباب اقتحموا مبنى
قيد الإنشاء ليعبثوا بالألعاب النّارية، صحيح؟

244
00:14:19,790 --> 00:14:22,340
.لا أصدّق أنّ عليكم التّعامل مع أمثالهم

245
00:14:22,340 --> 00:14:24,340
.أتمنّى حقًا أن أرتاح منهم

246
00:14:24,880 --> 00:14:28,050
يبدو أنّ ارتكاب تلك الأفعال
.وتصويرها ثمّ نشرها صار شائعًا

247
00:14:28,380 --> 00:14:31,140
،لقد ترعرعت في هذه المدينة

248
00:14:31,140 --> 00:14:34,140
لكنّنا انتقلنا بسبب عمل أبي

249
00:14:34,140 --> 00:14:36,390
.لكن لطالما تُقت إلى العودة

250
00:14:36,390 --> 00:14:38,390
.ولهذا اخترت الدّراسة في الجامعة المتواجدة هنا

251
00:14:39,520 --> 00:14:41,270
...حسنٌ

252
00:14:41,860 --> 00:14:43,070
.ذكّرني باسمك

253
00:14:43,070 --> 00:14:43,940
ماذا؟

254
00:14:43,940 --> 00:14:48,200
.آسفة. لا أعرف كيف أنطق اسمك العائليّ

255
00:14:48,900 --> 00:14:50,110
.اسمي هيناغيشي

256
00:14:50,110 --> 00:14:50,820
ماذا؟

257
00:14:50,820 --> 00:14:52,830
.إذن هذا يُقرأ هيناغيشي

258
00:14:52,830 --> 00:14:54,830
.هيناغيشي ميناتو

259
00:14:55,790 --> 00:14:57,370
.يمكنكِ مناداتي بميناتو فقط

260
00:14:57,370 --> 00:14:59,330
."اسمي العائليّ لا يقرأ "كو

261
00:14:59,330 --> 00:15:01,710
.بالمناسبة، اسمي موكايميزو

262
00:15:02,330 --> 00:15:05,210
."لكنّ الجميع يلفظونه خطأً "موكوميزو

263
00:15:05,210 --> 00:15:06,510
.هكذا إذن

264
00:15:06,510 --> 00:15:09,720
.في حالة وقوع حريق، من الأفضل أن تهربي نزولًا

265
00:15:10,300 --> 00:15:12,220
هل هذه تميمة خنزير بحر؟

266
00:15:12,220 --> 00:15:13,390
!هذا صحيح

267
00:15:13,390 --> 00:15:14,680
.وليس حوتًا أبيض

268
00:15:14,680 --> 00:15:15,850
.كما توقّعت

269
00:15:15,850 --> 00:15:19,350
!لا شكّ أنّك تحبّها. فحتّى مقدّمة السيارة تبدو مثله

270
00:15:19,350 --> 00:15:21,400
.أنا أيضًا أحبّه

271
00:15:22,060 --> 00:15:24,610
إنّها تشبه طراز بارشيتا، ألا توافقني؟

272
00:15:25,270 --> 00:15:26,480
ما رأيكِ بالاستماع للموسيقى؟

273
00:15:27,030 --> 00:15:28,530
ماذا تفضّلين؟

274
00:15:28,530 --> 00:15:30,280
.أيما تحبّ

275
00:15:31,410 --> 00:15:32,200
...في هذه الحالة

276
00:15:37,080 --> 00:15:39,710
.هذه الأغنية تعيد إليّ الذّكريات

277
00:15:39,710 --> 00:15:42,170
.لقد ذاع صيتها مجدّدًا بعد استخدامها في أحد الأفلام

278
00:15:42,750 --> 00:15:46,920
♪ما خطف بصرك♪

279
00:15:42,750 --> 00:15:46,920
ما خطف بصرك

280
00:15:46,920 --> 00:15:51,630
♪.أديم ماءٍ يشعّ بريقًا♪

281
00:15:46,920 --> 00:15:51,630
.أديم ماءٍ يشعّ بريقًا

282
00:15:51,630 --> 00:15:55,970
♪تتغيّر ألوانه شيئًا فشيئًا♪

283
00:15:51,630 --> 00:15:55,970
تتغيّر ألوانه شيئًا فشيئًا

284
00:15:55,970 --> 00:15:59,890
♪.وإشراقه لا يخبو♪

285
00:15:55,970 --> 00:15:59,890
.وإشراقه لا يخبو

286
00:15:59,890 --> 00:16:03,850
أحيانًا يقودنا المصير

287
00:16:03,850 --> 00:16:04,900
—نحو

288
00:16:06,110 --> 00:16:07,650
.أرى أنّك جلبت لوح الرّكمجة

289
00:16:07,650 --> 00:16:09,740
.ظننت أنّي بهذا سأتعلّم سريعًا

290
00:16:10,440 --> 00:16:11,610
،كما أنّني

291
00:16:12,150 --> 00:16:14,780
.لطالما أردت التّباهي بوضع لوح ركمجة على سطح سيّارتي

292
00:16:17,740 --> 00:16:21,290
.بذلة سباحةٍ كاملة في عزّ الصّيف

293
00:16:21,580 --> 00:16:23,290
!تبدو متألّقًا

294
00:16:23,290 --> 00:16:24,790
.ستتعلّم بسرعة

295
00:16:25,420 --> 00:16:26,790
.قوّم صدرك

296
00:16:27,210 --> 00:16:28,800
!جذّف، جذّف، جذّف

297
00:16:28,800 --> 00:16:30,880
!جذّف، جذّف، جذّف، جذّف

298
00:16:30,880 --> 00:16:32,470
!انتصب عندما تأتي الأمواج

299
00:16:34,300 --> 00:16:35,590
!جذّف، جذّف

300
00:16:36,510 --> 00:16:37,510
!انتصب

301
00:16:37,510 --> 00:16:38,810
!بروية

302
00:16:44,730 --> 00:16:46,360
!جذّف، جذّف، جذّف

303
00:16:49,110 --> 00:16:50,360
!أحسنت. والآن انتصب

304
00:16:50,690 --> 00:16:52,070
!حافظ على توازنك

305
00:16:57,280 --> 00:16:58,910
أأنت بخير؟

306
00:16:58,910 --> 00:17:00,990
...بعد الظّهر

307
00:17:02,960 --> 00:17:05,330
.سأبذل جهدًا أكبر

308
00:17:10,380 --> 00:17:11,590
.سأحضّر القهوة

309
00:17:11,590 --> 00:17:12,840
ستبدأ بذلك؟

310
00:17:15,130 --> 00:17:16,640
.ما أزكى رائحتها

311
00:17:18,300 --> 00:17:20,680
.إنّها نوعيّةٌ تتلاءم مع الشّطائر

312
00:17:23,730 --> 00:17:25,980
.البنّ المطحون طازجًا يتضخّم جيّدًا

313
00:17:25,980 --> 00:17:27,480
ما السّبب؟

314
00:17:27,480 --> 00:17:31,230
.لأنّها تفرز أكسيد الكربون عندما تفور

315
00:17:31,570 --> 00:17:33,240
.يبدو هذا معقّدًا

316
00:17:38,700 --> 00:17:40,370
.سأعدّ شطائر البيض

317
00:17:46,040 --> 00:17:49,630
.إنّك تجيد كلّ شيءٍ يا هيناغيشي-سان

318
00:17:49,630 --> 00:17:50,380
أأنت فضائيّ؟

319
00:17:50,380 --> 00:17:51,590
أم رجلٌ خارق؟

320
00:18:01,390 --> 00:18:03,060
!مذهل

321
00:18:04,850 --> 00:18:07,020
...عندما أنقذتني من الحريق قلت في نفسي

322
00:18:07,020 --> 00:18:10,190
.أنّك أشبه ببطلٍ يا هيناغيشي-سان

323
00:18:10,190 --> 00:18:11,400
.إنّكِ تبالغين

324
00:18:11,940 --> 00:18:14,280
."كما أنّني قلت أنّ بإمكانكِ مناداتي بـ"ميناتو

325
00:18:14,900 --> 00:18:16,990
."فأنا أريد أن أناديك بـ"هيناكو

326
00:18:20,990 --> 00:18:22,410
!لقد سرق طعامي

327
00:18:23,040 --> 00:18:24,450
!جذّف، جذّف

328
00:18:28,500 --> 00:18:29,250
!أحسنت

329
00:18:29,250 --> 00:18:30,500
!انتصب

330
00:18:33,000 --> 00:18:35,380
!جيّد، أنت تبلي حسنًا

331
00:19:06,330 --> 00:19:07,910
!أعتذر

332
00:19:07,910 --> 00:19:11,040
رغم أنّنا تكبّدنا عناء القدوم إلى
!مكانٍ تكون فيه الأمواج هادئة

333
00:19:11,040 --> 00:19:14,710
.حتّى إن فشلت، يمكنك دائمًا أن تركب الموجة التّالية

334
00:19:17,590 --> 00:19:21,680
.كما أنّني استطعت رؤية هذا المقهى الرّائع بسبب مجيئنا

335
00:19:23,100 --> 00:19:24,100
...هذا المقهى

336
00:19:24,100 --> 00:19:26,100
.كان يثير اهتمامي منذ مدّة

337
00:19:27,810 --> 00:19:29,890
.طفايات الحريق موزّعة كما ينبغي

338
00:19:29,890 --> 00:19:30,640
.المعذرة

339
00:19:31,900 --> 00:19:36,480
عندما تكون إلى جانبي يا هيناغيشي—ميناتو
.أحسّ أنّك ستهبّ لنجدتي في كلّ ضائقة

340
00:19:36,480 --> 00:19:38,860
!أجل. حتمًا سأهبّ لنجدتكِ

341
00:19:38,860 --> 00:19:39,740
!أعدكِ

342
00:19:43,410 --> 00:19:45,580
.أعتقد أن علينا الذّهاب

343
00:19:45,580 --> 00:19:46,660
.حسنًا

344
00:19:47,370 --> 00:19:48,500
.سأجمعها بنفسي

345
00:19:49,040 --> 00:19:50,790
.لا داعي

346
00:19:51,290 --> 00:19:52,580
!انتظري

347
00:19:59,050 --> 00:20:00,300
.أعتذر بشدّة

348
00:20:00,300 --> 00:20:02,630
.لا عليك. لا تهتمّي

349
00:20:02,630 --> 00:20:04,590
.إنّها آلةٌ يدوية قديمة

350
00:20:05,180 --> 00:20:06,560
هل أنتِ من طوكيو؟

351
00:20:06,560 --> 00:20:07,470
.أنا من محافظة تشيبا

352
00:20:07,470 --> 00:20:09,430
.هكذا إذن

353
00:20:09,430 --> 00:20:12,810
.موظّفٌ قديمٌ عندنا، افتتح مقهًى هناك

354
00:20:13,310 --> 00:20:14,860
.تفضّلي بزيارته متى أمكنك

355
00:20:14,860 --> 00:20:18,280
.المعدّات الّتي لديهم هناك أحدث ممّا لدينا

356
00:20:20,780 --> 00:20:24,110
.أتمنّى أن أملك مقهًى كهذا في يومٍ ما

357
00:20:24,700 --> 00:20:27,030
.أعتذر من ارتباكي

358
00:20:27,530 --> 00:20:28,990
أترغبين بأن نعود مرّةً أخرى؟

359
00:20:30,580 --> 00:20:32,210
.أن نركب الأمواج مرّةً أخرى

360
00:20:32,790 --> 00:20:34,880
.رغم أنّني لم أتعلّم الرّكمجة بعد

361
00:20:35,580 --> 00:20:37,630
.أن نحتسي القهوة هنا مرّةً أخرى

362
00:20:37,630 --> 00:20:39,710
.وأن نزور أماكن أخرى

363
00:20:40,170 --> 00:20:41,210
!ماذا؟

364
00:20:41,210 --> 00:20:42,090
...حسنٌ

365
00:20:43,550 --> 00:20:44,680
!موافقة

366
00:20:46,260 --> 00:20:50,770
ما خطف بصرك

367
00:20:50,770 --> 00:20:56,400
.أديم ماءٍ يشعّ بريقًا

368
00:20:56,400 --> 00:21:01,190
تتغيّر ألوانه شيئًا فشيئًا

369
00:20:59,770 --> 00:21:01,190
من هنّ؟

370
00:21:01,190 --> 00:21:05,610
.وإشراقه لا يخبو

371
00:21:05,610 --> 00:21:10,440
أحيانًا يقودنا المصير

372
00:21:10,440 --> 00:21:15,210
.نحو طريقٍ عسير

373
00:21:15,210 --> 00:21:20,090
لكنّنا نقف راسخين

374
00:21:20,090 --> 00:21:26,130
.لندحر هذا الألم ونتخطّاه

375
00:21:27,010 --> 00:21:32,140
هذا صحيح. لحظة أن فتحنا أعيننا

376
00:21:32,560 --> 00:21:37,100
.افتتحنا قصةً جديدة

377
00:21:37,100 --> 00:21:42,190
الخطوات الّتي تخطوها

378
00:21:42,190 --> 00:21:47,160
ستنير لك دربًا جديدًا

379
00:21:47,160 --> 00:21:51,030
لتصل إلى مكاننا الموعود

380
00:21:51,030 --> 00:21:55,500
.حيث سنلتقي من جديد

381
00:22:00,460 --> 00:22:10,850
.هناك أوقاتٌ تغلب فيها الدّموع على الابتسامات

382
00:22:10,850 --> 00:22:20,440
.لكن الحزن لن يدوم وسيتبدّد يومًا ما

383
00:22:20,440 --> 00:22:24,940
الأمواج رغم تشابهها

384
00:22:24,940 --> 00:22:29,820
.إلا أنّ نفس الموجة لا تتكرّر

385
00:22:29,820 --> 00:22:34,540
تواجدنا هنا الآن

386
00:22:34,540 --> 00:22:41,420
.دليلٌ على أنّ الصّعب هان أمامنا

387
00:22:41,420 --> 00:22:47,130
هذا صحيح. اسرح في مخيّلتك

388
00:22:47,130 --> 00:22:51,470
.واجعلها قصّةً جديدة أكثر جمالًا وإشراقًا

389
00:22:51,470 --> 00:22:56,850
كلما مرّت الفصول وانقضت

390
00:22:52,220 --> 00:22:54,350
!إنّك وسيمٌ يا بائع الورود

391
00:22:54,350 --> 00:22:55,350
!هذا صحيح

392
00:22:55,350 --> 00:22:56,850
!لا. أنا زبونٌ فقط

393
00:22:56,850 --> 00:22:58,600
من أين أنت؟

394
00:22:56,850 --> 00:23:01,440
تنامت تلك المشاعر

395
00:22:58,600 --> 00:23:01,810
.نحن ذاهبات لمشاهدة الألعاب النّارية

396
00:23:01,440 --> 00:23:08,150
.الّتي أسرّها في صدري

397
00:23:01,810 --> 00:23:04,320
أترغب بمرافقتنا؟

398
00:23:05,360 --> 00:23:06,690
.لديّ التزاماتٌ أخرى اليوم

399
00:23:08,150 --> 00:23:11,990
الأيام الّتي عشناها معًا

400
00:23:11,990 --> 00:23:17,200
والمشاعر الّتي خلّفتها لن تختفي

401
00:23:17,200 --> 00:23:21,290
وسيستمرّ نورها إشراقًا

402
00:23:21,290 --> 00:23:26,300
.في وجداننا

403
00:23:27,340 --> 00:23:30,510
.أبد الدّهر

404
00:23:31,590 --> 00:23:37,470
لهذا انظر نحو الأمام

405
00:23:37,470 --> 00:23:41,440
.وتحلّ بقليلٍ من الشّجاعة

406
00:23:41,440 --> 00:23:47,110
هذا صحيح. لحظة أن فتحنا أعيننا

407
00:23:47,110 --> 00:23:51,610
.افتتحنا قصةً جديدة

408
00:23:51,610 --> 00:23:56,530
الخطوات الّتي تخطوها

409
00:23:54,950 --> 00:23:56,530
!مفاجأة

410
00:23:56,530 --> 00:24:01,540
ستنير لك دربًا جديدًا

411
00:24:01,540 --> 00:24:05,040
لتصل إلى مكاننا الموعود

412
00:24:05,040 --> 00:24:10,090
.حيث سنلتقي من جديد

413
00:24:13,840 --> 00:24:15,010
...واحد، اثنان

414
00:24:15,010 --> 00:24:19,430
.قصّتي الجديدة

415
00:24:32,280 --> 00:24:33,910
...هكذا

416
00:24:35,070 --> 00:24:37,200
.جربّي تذوّقها الآن

417
00:24:41,790 --> 00:24:44,040
!طعمها صار ألذّ وأقلّ حلاوة حقًا

418
00:24:44,370 --> 00:24:46,380
.أنتما حلوان بما يكفي

419
00:24:46,960 --> 00:24:48,750
.أعتذر من فظاظة أختي

420
00:24:48,750 --> 00:24:50,670
!لا تعتذر عنّي يا أخي

421
00:24:51,260 --> 00:24:52,170
.إنّها غليظة الطّبع

422
00:24:52,670 --> 00:24:54,090
.لكنّي أشعر أنّنا سننسجم مع بعض

423
00:24:54,380 --> 00:24:55,220
ماذا؟

424
00:24:55,220 --> 00:24:58,100
.صديقتاي فظّتان وغليظتا الطّبع أيضًا

425
00:24:58,100 --> 00:25:00,850
.الشبدعة جون-تشان- والكوبرا أي-تشان

426
00:25:00,850 --> 00:25:02,480
ما هذه الألقاب؟

427
00:25:02,930 --> 00:25:05,400
.إذن سنلقّب يوكو بالأخطبوط أزرق الحلقات

428
00:25:05,400 --> 00:25:06,190
أخطبوط؟

429
00:25:06,190 --> 00:25:11,030
.رغم صغر حجمه إلّا أنّه ينفث سمًا زعافًا

430
00:25:11,030 --> 00:25:13,820
.أرى أنّك واسع الإطّلاع أيّها الأخ

431
00:25:13,820 --> 00:25:15,070
!سأغادر

432
00:25:15,070 --> 00:25:17,320
.جئت فقط لأرى كيف تبدو صديقتك

433
00:25:17,320 --> 00:25:19,450
!وقد استوعبت تمامًا

434
00:25:19,450 --> 00:25:20,490
استوعبتِ ماذا؟

435
00:25:21,160 --> 00:25:23,370
!الحبّ ليس إلّا للحمقى

436
00:25:23,370 --> 00:25:27,080
.الأخطبوط أزرق الحلقات سيعود إلى منزله فهو مسموم

437
00:25:27,080 --> 00:25:27,540
.عن إذنكما

438
00:25:28,210 --> 00:25:29,880
.أراكِ لاحقًا يا يوكو-تشان

439
00:25:29,880 --> 00:25:30,880
لاحقًا؟

440
00:25:31,460 --> 00:25:33,510
.لا مشكلة، فلديّ مناعةٌ قوية

441
00:25:33,510 --> 00:25:34,170
!لا أهتم

442
00:25:37,720 --> 00:25:39,890
.طبيعتكِ هذه خير سند

443
00:25:40,890 --> 00:25:44,680
.بسبب شخصيّتها تلك، لم تحظى بأيّ أصدقاء

444
00:25:44,680 --> 00:25:46,690
.وانقطعت عن الدّراسة لفترة

445
00:25:47,310 --> 00:25:48,270
...ولكن

446
00:25:48,270 --> 00:25:50,610
.مؤخّرًا بدأت ترتاد المدرسة مجدّدًا

447
00:25:50,610 --> 00:25:51,480
.فهمت

448
00:25:52,070 --> 00:25:54,570
.رغم طباعها أتمنّى أن تنسجما

449
00:25:54,570 --> 00:25:55,490
.بالطّبع

450
00:26:03,080 --> 00:26:04,330
!إنّه جبل فوجي

451
00:26:04,330 --> 00:26:05,960
!جبل فوجي بادٍ

452
00:26:11,670 --> 00:26:13,300
!مذهل

453
00:26:14,590 --> 00:26:18,130
:رسالة من ناميكو شوتو-سان إلى الآنسة أوشيدا ماي-سان

454
00:26:18,130 --> 00:26:20,050
!عيد ميلادٍ مجيد"

455
00:26:20,050 --> 00:26:22,310
".فلنبقى معًا إلى الأبد

456
00:26:22,310 --> 00:26:23,600
"!تزوّجيني"

457
00:26:24,020 --> 00:26:26,600
!مذهل! كم هذا رومنسي

458
00:26:26,600 --> 00:26:27,940
أتظنين؟

459
00:26:27,940 --> 00:26:31,190
.إن قمتِ بالحجز، فسيبثّون رسالتكِ على ما يبدو

460
00:26:32,400 --> 00:26:33,900
هلّا صعدنا إلى الأعلى؟

461
00:26:34,860 --> 00:26:37,450
:رسالة من كاميتشي يوشيكو-سان

462
00:26:37,450 --> 00:26:40,200
.أنا ممتنٌّ لكِ على الدّوام يا أمّي"

463
00:26:40,700 --> 00:26:41,870
"!عيد ميلادٍ مجيد

464
00:26:42,280 --> 00:26:43,790
!يا لها من إطلالة جميلة

465
00:26:43,790 --> 00:26:45,870
أيمكنني رؤية حيّنا من هنا يا ترى؟

466
00:26:48,040 --> 00:26:49,080
.عجبًا

467
00:26:49,750 --> 00:26:51,130
ما رأيكِ بأن نكتب واحدةً أيضًا؟

468
00:26:51,540 --> 00:26:52,210
ماذا؟

469
00:26:52,210 --> 00:26:54,420
.لا داعي. فأنا لا أعرف ماذا سأكتب

470
00:26:54,420 --> 00:26:56,880
.بالفعل، فأنتِ لا تستطيعين كتابة اسمي

471
00:26:56,880 --> 00:26:58,470
!بل أستطيع

472
00:26:58,470 --> 00:26:59,180
.إذن هاكِ

473
00:27:05,770 --> 00:27:06,520
...والآن

474
00:27:11,730 --> 00:27:14,860
.اسمك العائليّ صعب الكتابة يا ميناتو

475
00:27:14,860 --> 00:27:16,990
ماذا ستفعلين إذا أصبح اسمك الأخير؟

476
00:27:17,440 --> 00:27:17,860
ماذا؟

477
00:27:18,400 --> 00:27:19,280
ما قصدك؟

478
00:27:22,570 --> 00:27:23,410
.أخبرني

479
00:27:23,990 --> 00:27:25,120
.فلنصطفّ في طابور التقاط الصور

480
00:27:25,620 --> 00:27:27,330
.إنّكما متألّقان

481
00:27:27,330 --> 00:27:29,790
.أنتما تليقان لبعضكما

482
00:27:30,160 --> 00:27:31,290
!ممتاز

483
00:27:34,590 --> 00:27:35,340
.هيناكو

484
00:27:35,340 --> 00:27:36,090
.من هنا

485
00:27:36,090 --> 00:27:37,300
.تعالي إلى هنا

486
00:27:43,510 --> 00:27:45,180
.قفل على شكل قلب

487
00:27:47,020 --> 00:27:47,770
.تفضّلي

488
00:27:53,310 --> 00:27:54,480
.إنّها تثلج

489
00:27:57,730 --> 00:28:00,030
.غدًا سأداوم في العمل

490
00:28:00,030 --> 00:28:01,700
.رغم أنّنا في عطلة الكريسماس

491
00:28:02,320 --> 00:28:04,070
،أتعلم أنّه بعد تساقط الثّلوج

492
00:28:04,070 --> 00:28:06,280
.يزيد علوّ الأمواج

493
00:28:06,780 --> 00:28:10,830
.وتقول الأساطير أنّك إن ركبتها فستتحقّق أمنيتك

494
00:28:10,830 --> 00:28:12,710
.لكنّني لم أفعل ذلك من قبل

495
00:28:26,680 --> 00:28:27,850
!مذهل

496
00:28:28,310 --> 00:28:30,640
كيف أمكنك أن تضعها بإتقان؟

497
00:28:31,180 --> 00:28:34,600
إن جعلتِ الطّبقة الخارجية مستوية والداخلية طرية

498
00:28:34,600 --> 00:28:36,940
.فإنّها تصبح مرنة ما يسهل لفّها

499
00:28:38,900 --> 00:28:39,440
.كما ترين

500
00:28:39,780 --> 00:28:41,070
.هكذا

501
00:28:41,780 --> 00:28:42,700
أتودّين وضعها على الأرزّ؟

502
00:28:43,200 --> 00:28:43,910
.أجل

503
00:28:46,780 --> 00:28:47,990
.لا تهلعي

504
00:28:47,990 --> 00:28:49,080
—ما زال بالإمكان

505
00:28:52,830 --> 00:28:55,960
رغم أنّه الكريسماس إلّا أنّنا ههنا
نأكل عجّة البيض والأرزّ. أيناسبكِ هذا؟

506
00:28:55,960 --> 00:28:59,800
.أجل، فعجّة البيض والأرزّ كانت طبقي للاحتفال منذ الصّغر

507
00:29:00,710 --> 00:29:03,170
.كما أنّني أردت أن نقضي الوقت وحدنا

508
00:29:03,760 --> 00:29:05,510
ألن يصعب عليكِ الأكل بيدكِ اليسرى؟

509
00:29:05,510 --> 00:29:06,470
.لا مشكلة

510
00:29:06,470 --> 00:29:07,720
.فقد كنت أتدرّب على ذلك

511
00:29:07,720 --> 00:29:10,810
.لكي نستطيع إمساك يدي بعضنا حتّى ونحن نأكل

512
00:29:11,680 --> 00:29:14,390
.عندما أكون بقربك، أودّ ألّا أنفكّ عن ملامستك

513
00:29:15,060 --> 00:29:16,900
.إذن فلنعش معًا

514
00:29:16,900 --> 00:29:18,360
.سأغادر منزل العائلة

515
00:29:18,360 --> 00:29:21,070
.إن قلت هذا فقد أقبل

516
00:29:21,070 --> 00:29:22,610
لا مانع لديّ. متى؟

517
00:29:23,530 --> 00:29:25,780
...أنا ما زلت

518
00:29:29,280 --> 00:29:31,290
.عندما أرتّب أموري

519
00:29:32,500 --> 00:29:35,500
.كنت أعوّل عليك في كلّ شيء إلى الآن

520
00:29:35,500 --> 00:29:38,580
.لكنّني أريد أيضًا أن أقف على قدامي

521
00:29:39,000 --> 00:29:42,260
.حتّى أجد هدفي في الحياة مثلك

522
00:29:42,260 --> 00:29:46,220
.إنّكِ متفوّقةٌ في الكثير من الأمور وستجدين غايتكِ بسرعة

523
00:29:46,220 --> 00:29:48,260
.أما أنا فلم أكن أجيد شيئًا

524
00:29:48,640 --> 00:29:50,010
هل هذا تهكّم؟

525
00:29:50,970 --> 00:29:53,270
،عندما كنت صغيرًا تعرّضت للغرق في البحر

526
00:29:53,680 --> 00:29:57,020
.وأتذكّر بوضوح عندما أُنقذت

527
00:29:57,020 --> 00:29:59,560
.أنا أيضًا أردت أن أصير قويًا

528
00:29:59,560 --> 00:30:01,570
.لكن كلّ جهودي باءت بالفشل

529
00:30:02,860 --> 00:30:06,360
.لكن في أحد الأيّام رأيت بالصدفة سلاحف بحر تفقس

530
00:30:06,360 --> 00:30:07,570
سلاحف بحر؟

531
00:30:07,570 --> 00:30:09,160
.الّتي تتواجد على الشّاطئ

532
00:30:09,160 --> 00:30:10,580
ألا تعرفينها؟

533
00:30:11,370 --> 00:30:12,870
ما هذا؟

534
00:30:13,490 --> 00:30:14,660
سلاحف؟

535
00:30:16,290 --> 00:30:19,040
،بعد أن رأيت إصرارها لبلوغ البحر

536
00:30:19,040 --> 00:30:21,340
.قرّرت أن أبذل جهدي أيضًا

537
00:30:22,550 --> 00:30:25,550
وبعد أن بدأت مرافقة جدّي في دورياته الساحلية

538
00:30:25,550 --> 00:30:28,380
.بدأ مساري المهنيّ يتّضح لي

539
00:30:28,380 --> 00:30:31,680
.أردت أن أزاول أيضًا عملًا يمكّنني من إنقاذ النّاس

540
00:30:31,680 --> 00:30:33,010
.هذا كان دافعي

541
00:30:33,930 --> 00:30:35,430
!إنّك مذهلٌ حقًا

542
00:30:36,430 --> 00:30:40,770
.أنا لا أستطيع رعاية نفسي حتّى، فما بالك بالآخرين

543
00:30:40,770 --> 00:30:43,020
.ودائمًا ما ينقذني الآخرون

544
00:30:43,020 --> 00:30:45,990
.أمّا أنت فتستطيع التغلّب على كلّ الصّعاب بسهولة

545
00:30:45,990 --> 00:30:49,110
.أنا لست بمثل مهارتكِ في ركوب الأمواج

546
00:30:49,780 --> 00:30:52,330
.انظري إلى الأمور الأخرى كما تفعلين في البحر

547
00:30:52,330 --> 00:30:54,540
.اسبحي، استريحي إذا تعبتِ

548
00:30:54,540 --> 00:30:55,870
.ثمّ اسبحي من جديد

549
00:30:57,000 --> 00:30:59,210
.سأكون مرفأك

550
00:30:59,710 --> 00:31:01,000
.عندما تحتاجين للرّاحة

551
00:31:01,000 --> 00:31:03,250
.اتّصلي بي متى ما احتجتِ لشيء

552
00:31:03,250 --> 00:31:06,260
إلى متى ستواصل مساعدتي يا ترى؟

553
00:31:07,170 --> 00:31:08,930
لعشر سنوات وعشرين سنة

554
00:31:08,930 --> 00:31:11,300
.وحتّى بعد أن تشيخي

555
00:31:11,300 --> 00:31:14,100
.إلى أن تستطيعي ركوب الدّهر وحدك

556
00:31:24,820 --> 00:31:29,070
♪ما خطف بصرك♪

557
00:31:29,070 --> 00:31:34,490
♪.أديم ماءٍ يشعّ بريقًا♪

558
00:31:43,250 --> 00:31:44,500
!لا أصدّق

559
00:32:27,420 --> 00:32:29,340
!ويحك يا ميناتو

560
00:32:29,340 --> 00:32:31,420
!كيف لك أن تذهب للرّكمجة من دوني؟

561
00:33:11,510 --> 00:33:12,260
هيناكو-سان؟

562
00:33:15,260 --> 00:33:16,680
!هيناكو-سان

563
00:33:35,610 --> 00:33:36,860
.مرحبًا

564
00:33:45,210 --> 00:33:49,590
المخاطب الّذي تطلبونه لا يستطيع الإجابة حاليًا
.أو خارج منطقة التغطية

565
00:33:49,590 --> 00:33:54,220
.المرجو ترك رسالة بعد سماع الإشارة الصوتية

566
00:33:55,630 --> 00:33:57,800
.مرحبًا يا هيناكو

567
00:33:57,800 --> 00:33:59,010
هل أنتِ بخير؟

568
00:34:00,140 --> 00:34:02,600
.عاودي الاتّصال بي عندما تتحسّنين

569
00:34:02,600 --> 00:34:03,770
.سأكون بانتظارك

570
00:34:07,560 --> 00:34:13,110
.14:42 رسالة واردة في 16 من الشهر على السّاعة

571
00:34:22,620 --> 00:34:25,910
المعذرة، أنتِ في الدّاخل، صحيح؟

572
00:34:25,910 --> 00:34:27,670
!افتحي الباب رجاءً

573
00:34:32,800 --> 00:34:35,800
.نعتذر على المجيء دون موعد

574
00:34:37,300 --> 00:34:40,090
.لقد انتقلتِ هذه المرّة إلى مكانٍ بعيدٍ عن البحر

575
00:34:40,760 --> 00:34:43,760
.انتقلت إلى هنا لأنّي لم أعد أريد رؤية البحر

576
00:34:44,640 --> 00:34:48,230
.هذه بعض ممتلكات أخي الّتي تركها في قسم الإطفاء

577
00:34:46,770 --> 00:34:48,230
خنزير بحــر

578
00:34:48,230 --> 00:34:49,980
أمن بينها ما تودّين الاحتفاظ به؟

579
00:34:51,190 --> 00:34:53,690
...آ-آسف

580
00:34:53,690 --> 00:34:56,440
...لقد جلبت هذه الأغراض دون تفكير

581
00:34:56,440 --> 00:34:58,320
.لا شكّ أنّها ستعيد لكِ ذكرياتٍ مؤلمة

582
00:34:58,320 --> 00:35:00,110
علامَ تبكي؟

583
00:35:00,110 --> 00:35:01,450
...هذا لأنّي

584
00:35:01,450 --> 00:35:03,830
لم أتخيّل يومًا أنّ السينباي

585
00:35:03,830 --> 00:35:05,950
.سيغادرنا هكذا

586
00:35:08,660 --> 00:35:10,500
...فقد كان دائمًا السبّاق

587
00:35:11,130 --> 00:35:12,710
.لإنقاذ الآخرين

588
00:35:13,420 --> 00:35:14,840
.مغامرًا بحياته

589
00:35:14,840 --> 00:35:15,460
!إنّك مخطئ

590
00:35:20,010 --> 00:35:24,430
أنا الّتي أخبرته أنّ الأمواج تصير
.أفضل للرّكمجة بعد تساقط الثلوج

591
00:35:24,430 --> 00:35:25,640
.هذا يكفي

592
00:35:25,640 --> 00:35:28,350
.لوم نفسكِ لن يعيد أخي للحياة

593
00:35:30,060 --> 00:35:34,610
.آسفة

594
00:35:37,110 --> 00:35:39,450
.هذا هاتف أخي

595
00:35:39,450 --> 00:35:41,280
.سأترك هذه الأغراض هنا وافعلي بها ما تشائين

596
00:35:41,280 --> 00:35:42,870
!ولا أهتمّ إن تخلّصتِ منها

597
00:35:42,280 --> 00:35:42,870
!يوكو-تشان

598
00:35:42,870 --> 00:35:44,580
!وذلك أفضل لك

599
00:35:45,280 --> 00:35:48,500
.هـ-هذه بطاقة عملي

600
00:35:48,500 --> 00:35:51,580
.إذا احتجتِ لأي مساعدة فاتّصلي بي

601
00:35:52,580 --> 00:35:53,710
!يوكو-تشان

602
00:36:08,720 --> 00:36:10,180
هل هذه تميمة خنزير بحر؟

603
00:36:10,730 --> 00:36:13,060
.هذا تطبيقٌ يعرض معلوماتٍ عن حالة الموج

604
00:36:13,060 --> 00:36:14,440
.لم أكن أعلم بوجود تطبيقٍ مماثل

605
00:36:15,020 --> 00:36:17,860
.سأنصّبه في هاتفكِ أيضًا

606
00:36:27,740 --> 00:36:32,250
.مخاطبكم مشغولٌ حاليًا أو خارج منطقة التغطية

607
00:36:32,620 --> 00:36:38,210
.المرجو ترك رسالة بعد سماع الإشارة الصوتية

608
00:36:35,630 --> 00:36:38,710
!ليس مشغولًا ولا خارج منطقة الخدمة

609
00:36:38,710 --> 00:36:41,170
!رغم أنّه أخبرني أنّه سيظلّ إلى جانبي دائمًا

610
00:36:48,600 --> 00:36:49,600
ميناتو؟

611
00:37:12,370 --> 00:37:13,250
.هاكِ

612
00:37:13,250 --> 00:37:14,580
.تناوليه

613
00:37:18,250 --> 00:37:20,210
.وهذا فنجان قهوة

614
00:37:23,420 --> 00:37:24,720
.بربّكِ

615
00:37:27,600 --> 00:37:28,890
.فهمت

616
00:37:28,890 --> 00:37:31,020
.كلّ شيءٍ يذكّركِ به

617
00:37:31,020 --> 00:37:32,140
.آسفة

618
00:37:32,140 --> 00:37:34,480
.لا بأس فما باليد حيلة

619
00:37:34,480 --> 00:37:37,310
.جون-تشان وأي-تشان، أنتما لطيفتان

