1
00:00:02,510 --> 00:00:05,020
،بالتّصويت بالإجماع

2
00:00:05,600 --> 00:00:09,110
نعترف نحن الوُزراء بوليّ العهد
ملِكاً جديداً لنا

3
00:00:10,900 --> 00:00:13,880
هل وردت أي أنباء من الملكة الأرملة؟

4
00:00:13,880 --> 00:00:14,620
أجل

5
00:00:14,620 --> 00:00:19,980
فخامتها باقية في قصرها وعاجزة
عن الحضور اليوم

6
00:00:19,980 --> 00:00:23,950
لكن يمكننا تفسير صمتها كمُوافقة

7
00:00:25,520 --> 00:00:27,920
سوف نستعدّ للتّتويج

8
00:00:28,410 --> 00:00:30,840
تتويج؟ يا للرّوعة

9
00:00:30,840 --> 00:00:33,980
سنرى الأمير كايل يصبح ملِكاً أخيراً

10
00:00:33,980 --> 00:00:34,760
حقّاً؟

11
00:00:35,220 --> 00:00:38,740
ينبغي أن نُلبِس يوري-ساما أجمل
الثّياب من أجل هذه المُناسبة

12
00:00:38,740 --> 00:00:41,940
بالفعل. إنّها عقيلة سموّه الوحيدة

13
00:00:41,940 --> 00:00:44,690
يجب أن تكون الأكثر أناقة هناك

14
00:00:44,690 --> 00:00:47,340
سنحضر اللّباس الّذي كنّا نخبئه

15
00:00:47,340 --> 00:00:50,030
لدينا كثير من الأحجار الكريمة
الّتي لم ترتدِها أيضاً

16
00:00:50,030 --> 00:00:52,420
—ينبغي أن نُزيّنها لأقصى حدّ

17
00:00:52,420 --> 00:00:53,520
لن أذهب

18
00:00:54,580 --> 00:00:56,380
ماذا تقولين؟

19
00:00:56,380 --> 00:00:58,830
لن أذهب للتّتويج

20
00:00:59,130 --> 00:01:01,460
ماذا؟ لِمَ لا؟

21
00:01:02,810 --> 00:01:03,980
…أورسولا

22
00:01:11,930 --> 00:01:18,060
النّهر الأحمر

23
00:02:35,010 --> 00:02:40,010
قرار المُغادرة

24
00:02:36,640 --> 00:02:38,200
قرار المُغادرة

25
00:02:42,020 --> 00:02:44,290
سيبدأ التّتويج قريباً

26
00:02:44,290 --> 00:02:48,400
يوري-ساما، نتوسّل إليك أن
ترتدي هذه الملابس

27
00:02:48,700 --> 00:02:50,970
أخبرتُكن بأنّني لن أذهب إلى المراسم

28
00:02:50,970 --> 00:02:52,320
لا تكوني عنيدة

29
00:02:52,630 --> 00:02:57,540
حتّى إيلباني-ساما يقول بأنّكِ
مُلزمة بحضور التّتويج

30
00:02:57,540 --> 00:03:01,280
لكن ظننتُ بأنّ المحظيّات لا يُفترض
بهن الحضور

31
00:03:01,280 --> 00:03:03,250
…أ-أجل، لكن

32
00:03:03,510 --> 00:03:06,510
هذا التّقليد بالضّبط هو السّبب
الّذي ينبغي لكِ الذّهاب لأجله

33
00:03:06,960 --> 00:03:11,390
أنتِ الآن عقيلة سموّه الوحيدة

34
00:03:11,390 --> 00:03:14,730
وأنتِ معروفةٌ أيضاً كـ عشتار المُقدّسة

35
00:03:14,730 --> 00:03:17,380
لكن لا تمتلكين النّسب لحضور التّتويج

36
00:03:17,780 --> 00:03:21,210
،مع ذلك إن حضرتِ المراسم على أيّ حال

37
00:03:21,210 --> 00:03:27,790
ستُقنعين الوُزراء والنُّبلاء بأنّكِ
لستِ مُجرّد محظيّة

38
00:03:27,790 --> 00:03:30,410
لستُ بحاجة لأن يقبَلني أحد

39
00:03:30,410 --> 00:03:34,150
جميعكم تعلمون بأنّني محظيّته
المُزيّفة على أيّ حال

40
00:03:34,460 --> 00:03:37,350
وفضلاً عن ذلك، سيحين الرّبيع قريباً

41
00:03:37,870 --> 00:03:40,640
ينبغي أن أبقى بعيدة عن الأمير

42
00:03:41,390 --> 00:03:46,440
أحبُّ الأمير كايل، لكن لا أستطيع
تقبُّل سياسات البلاط

43
00:03:46,970 --> 00:03:51,290
إذا حضرتُ المراسم، فسيعني ذلك
بأنّني قبلتُ موتَ أورسولا

44
00:03:53,710 --> 00:03:56,010
لن أحضر التّتويج

45
00:04:00,760 --> 00:04:04,890
قبل التّتويج، أريد ضمانات منكم جميعاً

46
00:04:05,630 --> 00:04:10,770
كما تعلمون، جاء تتويجي نتيجة الاغتيال
المأساويّ لسلَفي

47
00:04:10,770 --> 00:04:12,690
،بسبب قلّة خبرتي

48
00:04:12,690 --> 00:04:18,460
أطلب من الوُزراء والأُمراء دعماً
في حكم الإمبراطوريّة

49
00:04:19,210 --> 00:04:23,000
رويس تيليبينو، ستستمرّ في العمل
كمُحافِظ لحلب

50
00:04:24,240 --> 00:04:28,910
مالي بياشيلي، أريدكِ أيضاً أن تبقي
مُحافِظة كركميش

51
00:04:29,540 --> 00:04:31,920
وجودا هاسباسروبي

52
00:04:32,290 --> 00:04:36,740
أبقيناك هنا في هاتّوسا نظراً لسنّك الصّغير

53
00:04:36,740 --> 00:04:39,010
لكن أعتبرك الآن بالغاً كاملاً

54
00:04:39,010 --> 00:04:43,120
عقب التّتويج، ستذهب إلى كانيش
وتتبوّأ مقعدك كمُحافظ

55
00:04:43,690 --> 00:04:45,350
حاضر يا أخي

56
00:04:45,680 --> 00:04:48,310
ا-اللّعنة عليك يا كايل

57
00:04:48,310 --> 00:04:51,500
بعد مقتل أورهي، أرسلتَ جودا بعيداً

58
00:04:51,500 --> 00:04:53,940
تنوي عزلي، أليس كذلك؟

59
00:04:54,220 --> 00:04:57,110
جلالتك، حان وقت التّتويج

60
00:04:57,110 --> 00:04:58,900
أجل. فلنذهب

61
00:04:59,360 --> 00:05:00,490
!سموّك

62
00:05:01,720 --> 00:05:05,580
،ترفض يوري-ساما حضور المراسم
مهما حاولنا أن نقول

63
00:05:07,890 --> 00:05:09,510
اتركيها

64
00:05:09,510 --> 00:05:11,930
السّياسة مُلطَّخة دوماً بالخطايا

65
00:05:12,360 --> 00:05:17,000
إنّها روحٌ صادقة وسترفض
الطّريقَ الّذي اخترتُه

66
00:05:18,150 --> 00:05:19,000
هيّا بنا

67
00:05:19,000 --> 00:05:19,920
حاضر

68
00:05:31,130 --> 00:05:32,140
!إنّه الملِك

69
00:05:32,140 --> 00:05:35,000
!وصلَ الملكُ الجديد

70
00:05:36,610 --> 00:05:38,170
!يحيا الملك

71
00:05:38,170 --> 00:05:39,280
!الملك كايل

72
00:05:39,280 --> 00:05:40,570
!الأمير كايل

73
00:05:47,710 --> 00:05:54,340
سنبدأ الآن بتتويج الملك الجديد
لإمبراطوريّة هيتّايتي

74
00:05:54,710 --> 00:05:59,670
،باسم الإله العظيم، تيشوب، وبقيّة آلهتنا

75
00:05:59,670 --> 00:06:02,720
نعلن عن تتويج كايل مورسيلي ملِكاً

76
00:06:09,930 --> 00:06:10,930
!ملِكنا

77
00:06:10,930 --> 00:06:13,440
!يحيا الملك الجديد

78
00:06:13,440 --> 00:06:15,180
!يحيا الملك كايل

79
00:06:15,180 --> 00:06:17,440
!يحيا الملك مورسيلي الثّاني

80
00:06:17,440 --> 00:06:20,570
ماذا؟ أليست عشتار معه؟

81
00:06:20,570 --> 00:06:23,030
معك حقّ. لا أراها هناك

82
00:06:23,030 --> 00:06:24,680
أين عشتار المُقدّسة؟

83
00:06:24,680 --> 00:06:26,780
لماذا عشتار المُقدّسة ليست معنا؟

84
00:06:26,780 --> 00:06:32,840
سموّ الأمير كايل، لا بل جلالة الملِك يجب
أن يحضر عشتار المُقدّسة إلى جانبه

85
00:06:32,840 --> 00:06:34,330
اسمعوا، اسمعوا

86
00:06:34,330 --> 00:06:36,400
!أحضروا لنا عشتار المُقدّسة

87
00:06:36,400 --> 00:06:38,960
!اكشفي عن نفسكِ رجاء يا عشتار المُقدّسة

88
00:06:38,960 --> 00:06:40,840
!عشتار العظيمة

89
00:06:40,840 --> 00:06:43,090
!عشتار المُقدّسة

90
00:06:40,840 --> 00:06:54,100
!عشتار! عشتار! عشتار

91
00:06:45,040 --> 00:06:46,590
!يـ-يا للهول

92
00:06:51,140 --> 00:06:54,100
النّاس أصدق منّي في رغباتهم

93
00:06:54,100 --> 00:06:56,600
!عشتار! عشتار! عشتار

94
00:06:56,600 --> 00:07:01,280
يوري-ساما، هل تسمعين الجمهور؟
جميعكم يتوسّلون إليكِ للحضور

95
00:07:01,280 --> 00:07:06,530
النّاس لا يقبلون سموّه دون
وجودكِ بجانبه

96
00:07:08,520 --> 00:07:10,740
تعالي يا يوري-ساما. حان وقت التّغيير

97
00:07:10,740 --> 00:07:14,180
ستكونين الشّخصيّة الأكثر إبهاراً في المراسم

98
00:07:14,180 --> 00:07:15,910
نُصرّ على ذلك يا يوري-ساما

99
00:07:17,350 --> 00:07:19,570
حسناً. سأبدّل ملابسي

100
00:07:19,920 --> 00:07:46,700
!عشتار! عشتار! عشتار

101
00:07:27,310 --> 00:07:29,180
لن يتوقّفوا عن الهتاف

102
00:07:29,640 --> 00:07:33,020
فخامتك، هل نستدعي يوري-ساما؟

103
00:07:33,020 --> 00:07:35,980
لا، لا داعي. لن نُجبرها على المجيء

104
00:07:35,980 --> 00:07:38,500
لكن من دونها، لن يتوقّف هذا الصّخب

105
00:07:38,890 --> 00:07:43,490
إذاً سنُلزم الجمهور على اعتباري وحيداً

106
00:07:44,590 --> 00:07:46,700
في هذه الحالة، سنتابع

107
00:07:48,110 --> 00:07:49,510
!انظروا

108
00:07:50,750 --> 00:07:51,770
!إنّها هي

109
00:07:51,770 --> 00:07:52,950
!إنّها عشتار المُقدّسة

110
00:07:52,950 --> 00:07:54,240
!عشتار المُقدّسة

111
00:07:54,240 --> 00:07:55,910
!عشتار العظيمة

112
00:07:55,910 --> 00:07:57,260
!عشتار المُقدّسة

113
00:07:57,260 --> 00:07:58,870
!إنّها عشتار المُقدّسة

114
00:07:58,870 --> 00:08:00,540
!عشتار المُقدّسة

115
00:08:02,320 --> 00:08:03,370
يوري؟

116
00:08:03,800 --> 00:08:05,780
ما نوع هذا اللّباس؟

117
00:08:05,780 --> 00:08:08,760
اعتُرِفَ بيوري-ساما بأنّها عشتار الحقيقيّة

118
00:08:09,190 --> 00:08:10,940
،بسبب تلك المكانة

119
00:08:10,940 --> 00:08:14,260
أردتُها أن يُعترَف بها رسميّاً
كعقيلة فعليّة للملِك

120
00:08:14,260 --> 00:08:17,630
وحتّى أنّنا حضّرنا فُستاناً رسميّاً لهذه المُناسبة

121
00:08:17,630 --> 00:08:19,140
سامحنا

122
00:08:19,430 --> 00:08:22,770
أصرّتْ يوري-ساما على ارتداء
هذا في المراسم

123
00:08:28,180 --> 00:08:29,430
جلالتك

124
00:08:29,430 --> 00:08:33,850
كلانا نعلم بأنّني لا أستطيع أن
أصبح محظيّتك الشّرعيّة أبداً

125
00:08:34,430 --> 00:08:35,540
…رغم ذلك

126
00:08:35,540 --> 00:08:39,860
أريد أن أكون نافعة لك. لذا ريثما
،أعود إلى دياري

127
00:08:40,380 --> 00:08:43,040
اسمح لي بخدمتك كـ عشتار

128
00:08:47,360 --> 00:08:52,000
،أمنح بتواضُع وبصدق برَكةَ عشتار
يا ملِك الجديد

129
00:08:52,430 --> 00:08:54,540
!يحيا الملك الجديد

130
00:08:54,540 --> 00:08:56,360
!تحيا عشتار المُقدّسة

131
00:08:56,360 --> 00:08:58,250
!يحيا الملك كايل

132
00:09:19,350 --> 00:09:25,450
يا إلهي. من العرف أن ينتقل الملكُ
الجديد إلى القصر الرّئيسيّ

133
00:09:25,450 --> 00:09:28,550
لكن لم تكن المهمّة سهلة أبداً

134
00:09:28,550 --> 00:09:29,990
…الأمير كايل

135
00:09:29,990 --> 00:09:34,140
المعذرة. لطالما عاشَ جلالته
حياةً تقشُّفيّة

136
00:09:34,140 --> 00:09:36,190
هذا ينطبق بالذّات على نسائه

137
00:09:36,190 --> 00:09:39,700
،يستطيع الملك الحصول على 100 محظيّة

138
00:09:39,700 --> 00:09:43,230
ويستغرق تحضير كافّة الغرف شهراً

139
00:09:43,230 --> 00:09:48,370
بصراحة، وصيفاتنا الخمسمئة
قد لا يملكنَ أعمالاً يقمنَ بها

140
00:09:48,370 --> 00:09:51,610
يوري-ساما موجودة بجانب الملِك كايل

141
00:09:52,310 --> 00:09:54,450
وصلَ جلالته

142
00:09:58,890 --> 00:10:00,060
…سموّ الأمير

143
00:10:00,060 --> 00:10:03,210
لحظة. يجب القول "جلالتك" الآن، صحيح؟

144
00:10:06,210 --> 00:10:09,880
كيف تسير الأمور؟ هل أحرزتِ تقدُّماً؟

145
00:10:09,880 --> 00:10:11,800
لم أحتج لنقل شيء

146
00:10:12,520 --> 00:10:15,620
اتّسعتْ كُلّ أغراضي داخل ذلك الصّندوق

147
00:10:16,510 --> 00:10:21,140
عشتار المُقدّسة، يحقّ لكِ اختيار
الغرفة الّتي ترغبينها

148
00:10:21,530 --> 00:10:25,550
لكن الغرفة الكُبرى في الجناح الجنوبي

149
00:10:25,550 --> 00:10:29,440
،كانت محجوزة دوماً للعقيلة الملِكة

150
00:10:29,440 --> 00:10:31,190
لذا بقيتْ شاغرة

151
00:10:32,820 --> 00:10:35,370
غرفة للملِكة؟

152
00:10:37,650 --> 00:10:42,290
أمين البلاط الملكيّ، كانت يوري-ساما
تُشارك غرفةً دوماً مع جلالته

153
00:10:42,290 --> 00:10:44,830
هل يمكنهما الحِفاظ على هذا التّرتيب هنا؟

154
00:10:44,830 --> 00:10:48,250
قطعاً لا. جلالته لم يعُد الأمير

155
00:10:48,250 --> 00:10:54,220
ليس من المُلائم أن يُدخل مزيداً من المحظيّات

156
00:10:54,220 --> 00:10:56,780
يوري-ساما ليست محظيّة ببساطة

157
00:10:56,780 --> 00:10:58,570
إنّها عشتار المُقدّسة

158
00:10:58,570 --> 00:11:00,000
اهدئي يا هادي

159
00:11:00,640 --> 00:11:03,280
أحبّ غرفتي الخاصّة

160
00:11:03,280 --> 00:11:05,890
حتّى عشتار لا يجوز أن تنتهك القواعد هنا

161
00:11:06,490 --> 00:11:09,370
سأقبل بأي غرفة، ما دامت مُشمسة

162
00:11:09,370 --> 00:11:13,070
حضرة أمين البلاط الملكيّ، يمكنك
أن تختار الغرفة لأجلي

163
00:11:13,510 --> 00:11:16,280
حاضر مولاتي. أرجو أن تتبعيني

164
00:11:19,170 --> 00:11:20,660
يجب أن أفعل هذا

165
00:11:20,660 --> 00:11:25,790
،يجب عليّ رسم هذه الحدود
وإلّا لن أنسى الأمير كايل

166
00:11:27,960 --> 00:11:31,720
،في كلّ مرّة أحاول فيها التخلّي عنه
أنجذب إليه أكثر فأكثر

167
00:11:32,190 --> 00:11:35,520
لكن هذه المرّة، يجب أن أضع حدّاً لهذا

168
00:11:36,310 --> 00:11:38,500
،الشّؤون السّياسيّة مُقرفة

169
00:11:38,500 --> 00:11:41,070
لكن الملك يتزوّج ملكةً في نهاية المطاف

170
00:11:41,540 --> 00:11:44,520
لن أتحمّل إذا تزوّج شخصاً آخر

171
00:11:45,260 --> 00:11:47,360
لذا يجب عليّ إنهاء الأمور الآن

172
00:11:48,030 --> 00:11:51,360
يجب أن أنسى ذلك الرّجل
قبل أن أذهب إلى المنزل

173
00:11:55,260 --> 00:11:56,310
جلالتك

174
00:11:57,340 --> 00:11:59,680
تناول بعض الخمر قبل الخلود إلى النّوم

175
00:11:59,680 --> 00:12:01,660
شكراً

176
00:12:01,940 --> 00:12:04,990
أصبح نسيم المساء أدفأ

177
00:12:04,990 --> 00:12:08,040
يُقال بأنّ الرّبيع سيأتي باكراً
في هذا العام

178
00:12:08,540 --> 00:12:11,970
حالما يأتي الرّبيع، سيصعد نجم الصّباح ثانية

179
00:12:12,540 --> 00:12:16,300
سـ-سامحني. لم أقصد شيئاً بذلك

180
00:12:16,300 --> 00:12:21,260
لا، اقتربَ الرّبيع. سنحتاج شيئاً
للتّحضير لمهرجانات العام المُقبل

181
00:12:21,260 --> 00:12:23,810
ا-المعذرة، أنا أعني ذلك فعلاً

182
00:12:24,660 --> 00:12:26,930
هذا يكفي. يمكنك الانصراف

183
00:12:26,930 --> 00:12:27,950
حاضر

184
00:12:28,430 --> 00:12:29,760
أستأذن بالانصراف

185
00:12:34,820 --> 00:12:38,700
سيكون هذا الرّبيع الثّالث منذ وصول يوري

186
00:12:39,510 --> 00:12:42,870
عذراء أتَتْني من بلاد مجهولة

187
00:12:42,870 --> 00:12:45,130
عذراء ستكون في نهاية المطاف جزءاً منّي

188
00:12:45,830 --> 00:12:51,130
عندما التقيتُ بها أوّل مرّة، لم أتخيّل أبداً
مثل هذا التحوُّل السّاخر في القدَر

189
00:12:51,910 --> 00:12:56,710
من كان يتوقّع بأن تكون تلك العذراء
الأنسب لتصبح ملِكتي؟

190
00:12:57,090 --> 00:12:59,420
من كان يتوقّع بأن ينتهي المطاف بحُبّي لها؟

191
00:13:05,460 --> 00:13:08,340
وأكثر من أي امرأة أُخرى

192
00:13:09,100 --> 00:13:14,080
…كنتُ مُستعدّاً لليوم الّذي أودّعها فيه، لكن

193
00:13:14,940 --> 00:13:17,470
يصبح قلبي مضطرباً في هذه اللّيلة

194
00:14:18,340 --> 00:14:19,510
جلالتك؟

195
00:14:20,940 --> 00:14:22,840
جلالتك؟ ماذا تفعل؟

196
00:14:23,810 --> 00:14:24,720
يوري

197
00:14:27,240 --> 00:14:28,760
يجب أن نصبح واحداً

198
00:14:32,930 --> 00:14:36,470
لحظة. ما هذا؟ جلالتك؟

199
00:14:37,350 --> 00:14:41,390
ما الّذي يجري؟ هذا ليس من طِباعه

200
00:14:41,940 --> 00:14:43,190
جلالتك

201
00:14:43,650 --> 00:14:46,320
تتصرّف مثل رمسيس الآن

202
00:14:53,550 --> 00:14:55,790
لا أريد أن أسمعكِ تلفظين
!اسم رجل آخر

203
00:14:58,460 --> 00:15:00,610
جـ-جلالتك؟

204
00:15:02,940 --> 00:15:04,070
ماذا أصابه؟

205
00:15:08,430 --> 00:15:09,940
…بجدّية

206
00:15:10,890 --> 00:15:12,430
هذا ليس ما أريده

207
00:15:12,790 --> 00:15:13,890
إطلاقاً

208
00:15:14,180 --> 00:15:17,060
!لا

209
00:15:18,940 --> 00:15:19,980
أختي

210
00:15:19,980 --> 00:15:21,270
هل كانت تلك صرخة؟

211
00:15:22,450 --> 00:15:23,400
!النّجدة

212
00:15:23,400 --> 00:15:26,040
!فليُساعدني أحدٌ ما

213
00:15:26,040 --> 00:15:26,880
يوري

214
00:15:28,410 --> 00:15:32,260
الآن، أنا السّلطة العليا في هذه البلاد

215
00:15:32,690 --> 00:15:35,160
لا ينبغي أن تُرفَض رغباتي

216
00:15:36,020 --> 00:15:38,040
وما أرغبه هو أنتِ

217
00:15:38,420 --> 00:15:39,360
يوري

218
00:15:41,110 --> 00:15:42,440
رغبة"؟"

219
00:15:43,030 --> 00:15:47,410
تلك الكلمة لا يمكنها حتّى أن تصِف
شعوري تجاه يوري

220
00:15:48,260 --> 00:15:49,710
مُحال أن أتخلّى عنكِ

221
00:15:50,840 --> 00:15:53,880
سأؤدّي كُلّ فعل يجعني أتّحد معها

222
00:15:55,050 --> 00:15:57,310
!هادي

223
00:15:57,310 --> 00:15:58,880
!هادي

224
00:15:59,310 --> 00:16:02,070
!هادي! هادي

225
00:16:02,070 --> 00:16:04,120
!لا تفعل

226
00:16:04,440 --> 00:16:06,440
!هادي

227
00:16:07,010 --> 00:16:09,410
!هادي! هادي

228
00:16:08,220 --> 00:16:09,410
أختي

229
00:16:09,410 --> 00:16:11,330
!هادي

230
00:16:11,330 --> 00:16:13,660
!هادي! هادي

231
00:16:14,160 --> 00:16:15,160
!هادي

232
00:16:15,540 --> 00:16:17,500
!جلالتك! سامحني

233
00:16:17,500 --> 00:16:18,640
هادي؟

234
00:16:19,000 --> 00:16:20,300
أنتِ هنا يا هادي؟

235
00:16:20,300 --> 00:16:22,540
لم أستدعكِ. اتركينا

236
00:16:22,860 --> 00:16:25,300
لا أنوي الإهانة

237
00:16:25,300 --> 00:16:28,750
لكن من فضلك، أتوسّل إليك أن تطلق
سراح يوري-ساما من بين ذِراعيك

238
00:16:28,750 --> 00:16:30,550
يوري محظيّتي شرعاً

239
00:16:30,980 --> 00:16:32,800
ما نفعله ليس من شأنكِ

240
00:16:32,800 --> 00:16:34,900
سأقبل بالتّوبيخ بكلِّ سرور

241
00:16:34,900 --> 00:16:38,900
،لكن من فضلك، ارحم يوري-ساما
لهذه اللّيلة على الأقلّ

242
00:16:38,900 --> 00:16:39,810
هادي؟

243
00:16:40,220 --> 00:16:41,810
!هادي

244
00:16:41,810 --> 00:16:42,900
!يوري-ساما

245
00:17:15,890 --> 00:17:17,090
!هادي

246
00:17:17,090 --> 00:17:18,520
يوري-ساما

247
00:17:20,350 --> 00:17:22,790
أشكرك من أعماق قلبي، جلالتك

248
00:17:32,810 --> 00:17:34,780
هذا ليس من طِباعك إطلاقاً

249
00:17:36,280 --> 00:17:40,910
لم تخطئ يوماً في نهجك مع الشّؤون
العسكريّة أو النّساء

250
00:17:40,910 --> 00:17:45,290
إلّا مع يوري-ساما ارتكبتَ خطأ فادحاً

251
00:17:45,290 --> 00:17:47,420
لن أصغي لموعظتك لي

252
00:17:47,420 --> 00:17:50,290
ليست لدي أي نيّة سيّئة خلف الأمر

253
00:17:50,290 --> 00:17:55,820
من الطّبيعيّ لرجل مثلك أن يرغب
في مُعاشرة امرأة

254
00:17:55,820 --> 00:17:59,560
إن كنت ترغب، يمكننا استدعاء
عذراء فاتنة لأجلك

255
00:18:01,060 --> 00:18:02,880
،إن كنت ترغب، جلالتك

256
00:18:02,880 --> 00:18:07,570
فهناك كثير من الشّابّات الرّاغبات في قضاء
ولو ليلة واحدة معك

257
00:18:07,570 --> 00:18:10,070
!لا أري أي امرأة أُخرى

258
00:18:11,820 --> 00:18:14,800
اتركني. قلتَ ما عندك

259
00:18:26,660 --> 00:18:29,670
يوري-ساما، تناولي بعض ماء العسل السّاخن

260
00:18:29,670 --> 00:18:33,720
حالما تهدأ أعصابك، يمكنك النّوم هنا معنا

261
00:18:34,560 --> 00:18:35,540
شكراً

262
00:18:35,540 --> 00:18:39,960
أرجو أن تعلمي بأنّ جلالته
يهتمّ لأمركِ كثيراً

263
00:18:40,630 --> 00:18:42,350
…اللّيلة كانت فقط

264
00:18:43,530 --> 00:18:44,740
أعي ذلك

265
00:18:45,480 --> 00:18:48,070
أحبُّ جلالته أيضاً

266
00:18:49,180 --> 00:18:52,820
لكن نظلّ نتعثّر ونُفوّت الفُرَص

267
00:18:53,500 --> 00:18:55,110
،مهما أحببتُه

268
00:18:55,500 --> 00:19:00,180
يتمّ تذكيري دوماً بأنّه ليس مُقدّر
لنا أن نبقى معاً

269
00:19:06,860 --> 00:19:08,660
،الآن بعد أن سقطت ميتانّي

270
00:19:08,660 --> 00:19:11,340
القوّة التّالية الّتي ستبدأ بتحرُّكاتها
هي مصر على الأغلب

271
00:19:11,340 --> 00:19:14,310
لكن لسنا قلقين إطلاقاً

272
00:19:14,310 --> 00:19:17,720
بالفعل. جيشنا في أوج قوّته اليوم

273
00:19:24,250 --> 00:19:28,100
لعلّ هذه المُحادثة لم تكُن مُلائمة
أثناء تناول الفطور

274
00:19:28,420 --> 00:19:30,810
افعلا شيئاً بشأن هذه الأجواء

275
00:19:30,810 --> 00:19:32,730
ماذا؟ لماذا نحن؟

276
00:19:33,310 --> 00:19:35,740
…المعذرة، لنرَ

277
00:19:35,740 --> 00:19:38,990
يوري-ساما، لا تبدين طمّاعة إطلاقاً

278
00:19:38,990 --> 00:19:40,660
هذا مُحرِج للغاية

279
00:19:40,660 --> 00:19:44,750
وجدتُها! يوري-ساما، لِمَ لا تطلبين
من جلالته هديّة؟

280
00:19:46,680 --> 00:19:48,040
أجل، يجدر بكِ ذلك

281
00:19:48,040 --> 00:19:51,660
فأنتِ لم تطلبي شيئاً من جلالته
حتّى يومنا هذا

282
00:19:51,660 --> 00:19:54,070
هذا سيُخلّد ذِكرى تتويجه

283
00:19:54,070 --> 00:19:58,330
عِقد من ياقوت أو سِوار من يشب
ستكون هديّة جميلة

284
00:19:58,330 --> 00:20:02,810
بما أنّكِ عقيلة الملِك، يمكنكِ حتّى
أن تطلبي قصراً على ضفّة بُحيرة

285
00:20:03,510 --> 00:20:05,680
لا أريد أي هديّة فعليّاً

286
00:20:05,680 --> 00:20:07,820
لا حاجة للعِناد

287
00:20:07,820 --> 00:20:10,650
يستطيع جلالته منحكِ أيّ شيء تُريدين

288
00:20:10,910 --> 00:20:11,950
صحيح

289
00:20:12,510 --> 00:20:15,510
معكن حقّ. فهو ذو نفوذ كامل الآن

290
00:20:17,020 --> 00:20:20,040
إذاً أريد شيئاً واحداً ليس إلّا

291
00:20:23,670 --> 00:20:27,870
في المرّة المُقبلة الّتي يصعد فيها نجمُ
الصّباح، احرص على إعادتي

292
00:20:29,780 --> 00:20:32,740
أريد العودة إلى الدّيار حقّاً هذه المرّة

293
00:20:36,010 --> 00:20:38,600
حسناً. لكِ ذلك

294
00:20:41,810 --> 00:20:42,930
شكراً

295
00:20:56,110 --> 00:20:57,600
ستكون الأمور بخير

296
00:20:57,600 --> 00:20:59,500
سأنسى أمره

297
00:21:01,460 --> 00:21:04,860
هذه المرّة، سأعود إلى دياري

298
00:21:06,880 --> 00:21:11,900
ووقتي هنا سيبقى حلماً غريباً منسيّاً

299
00:22:45,090 --> 00:22:50,100
نيران الحرب تندلع