1
00:01:57,910 --> 00:02:03,760
.ها قد التقينا أخيرًا يا كاديس إيتراما دي رايزل

2
00:02:07,160 --> 00:02:08,950
...ذلك إذًا

3
00:02:08,950 --> 00:02:10,520
ماذا ستفعلين بهما؟

4
00:02:12,850 --> 00:02:14,800
أليس هذا واضحًا؟

5
00:02:14,800 --> 00:02:18,060
أيّ من يتعاطف مع مجرم كبير مثلك

6
00:02:18,060 --> 00:02:19,780
.لا يمكن أن يعيش

7
00:02:20,870 --> 00:02:22,280
...رايزل-ساما

8
00:02:22,710 --> 00:02:27,150
.أعتذر بشدّة للسّماح بحدوث كلّ هذا

9
00:02:27,540 --> 00:02:31,990
،مع أنّي أتألّم لإثقال كاهلك برغبة عجوز على عتبة الموت

10
00:02:31,990 --> 00:02:36,300
.إلّا أنّي أطلب منك بتواضع أن تعتني بهما

11
00:02:37,790 --> 00:02:39,480
.لن أدعك تقتليهما

12
00:02:44,890 --> 00:02:47,060
!خائن خسيس

13
00:02:47,450 --> 00:02:51,520
!أنا، كي رو، لن أدعك تقترب من السّيّدة

14
00:02:51,520 --> 00:02:53,520
!ازأر يا غارانت

15
00:02:53,520 --> 00:02:54,660
!توّقف

16
00:03:09,910 --> 00:03:12,250
!هجوم كي-ساما لم يفلح؟

17
00:03:28,300 --> 00:03:31,190
.أظنّ أنّ هذا ما نتوقّعه من نوبلس

18
00:03:34,980 --> 00:03:37,020
.أنا روزاريا إلينور

19
00:03:37,020 --> 00:03:39,110
...تعال وامرح معي أيضًا

20
00:03:40,060 --> 00:03:41,360
.أيّها الوسيم

21
00:03:57,800 --> 00:03:59,760
!تعال يا إزاروك

22
00:04:01,950 --> 00:04:03,300
!روزاريا-ساما

23
00:04:04,010 --> 00:04:06,880
!لوديس ميرغاس سيواجهك الآن

24
00:04:10,390 --> 00:04:13,790
ميرغاس... العشيرة الّتي تتولّى الحماية؟

25
00:04:13,790 --> 00:04:15,400
.ليس ذلك فحسب

26
00:04:15,400 --> 00:04:16,780
!اندثر

27
00:04:16,780 --> 00:04:19,110
.قوّة إزاروك ليست مقيّدة بالدّفاع

28
00:04:19,110 --> 00:04:21,020
!ولآن، اختفٍ

29
00:04:30,660 --> 00:04:32,070
...لا يمكن

30
00:04:33,850 --> 00:04:35,920
...كي-ساما... روزاريا-ساما

31
00:04:35,920 --> 00:04:37,220
.لا فائدة

32
00:04:38,670 --> 00:04:40,800
...جـ-جسدي بأكمله

33
00:04:40,800 --> 00:04:42,880
...هل... يعقل

34
00:04:42,880 --> 00:04:45,380
!التحكّم بالعقل

35
00:04:45,650 --> 00:04:49,960
ظننتُ أنّ السّيّد فقط يستطيع التحكّم بعقول زعماء العشائر؟

36
00:04:49,960 --> 00:04:55,310
،السيّد هو أسمى النّبلاء الّذي يقودهم

37
00:04:55,310 --> 00:04:58,680
،بيد أنّ نوبلس هو كائن ذو قوّة أعظم

38
00:04:58,680 --> 00:05:01,780
.الّذي يستطيع حماية السّيّد وكذا عقابه

39
00:05:01,780 --> 00:05:06,180
.قوّته تفوق حتّى قوّة السّيّد

40
00:05:08,650 --> 00:05:10,150
.تراجعوا

41
00:05:10,490 --> 00:05:13,950
.حتّى وإن كنتم مجتمعين، لستم أندادًا له

42
00:05:14,710 --> 00:05:16,460
...فقط أنا

43
00:05:16,930 --> 00:05:18,720
!سأهزمه

44
00:05:23,150 --> 00:05:24,260
...هذه الهالة

45
00:05:24,260 --> 00:05:25,460
!السّيّدة؟

46
00:05:28,930 --> 00:05:31,040
!أخي! شيء ما يجري في القلعة

47
00:05:32,040 --> 00:05:33,220
...مولاي

48
00:05:34,230 --> 00:05:35,180
ما الّذي يجري؟

49
00:05:37,390 --> 00:05:38,580
...هذه

50
00:05:39,500 --> 00:05:41,360
!قوّة السّيّدة

51
00:06:04,630 --> 00:06:05,970
!السّيّدة

52
00:06:06,330 --> 00:06:07,630
!تراجعوا

53
00:06:08,820 --> 00:06:11,140
...بإمكاني أن أضع نهايةً له أخيرًا

54
00:06:11,140 --> 00:06:14,720
.للرّجل الشّنيع الّذي جعلني أعاني كثيرًا

55
00:06:15,670 --> 00:06:18,060
.لن أقبل المساعدة من أيّ أحد

56
00:06:18,060 --> 00:06:20,020
...سأفعل هذا بنفسي

57
00:06:20,020 --> 00:06:22,940
!كي أظلّ السّيّدة

58
00:06:25,720 --> 00:06:27,360
ما الّذي يخيفك؟

59
00:06:28,360 --> 00:06:32,370
.يجدر أن تمتلكي نفس قوّتي

60
00:06:32,370 --> 00:06:34,740
فلمَ لا تسخّرينها بجدّيّة؟

61
00:06:35,590 --> 00:06:40,810
!لستُ بحاجة لاستخدام كامل قوّتي لأسحق خائنًا جبانًا

62
00:06:40,810 --> 00:06:42,570
أهذه هي حجّتك؟

63
00:06:43,520 --> 00:06:47,760
وليس لأنّك قلقة من أنّك قد تخسرين أمامي؟

64
00:06:48,080 --> 00:06:51,260
.وإلّا، قاتليني بكلّ قوّتك

65
00:06:51,970 --> 00:06:55,020
!حسنًا. سأريك

66
00:07:01,060 --> 00:07:03,130
!هذا لأجلك

67
00:07:03,130 --> 00:07:04,690
!حقل الدّماء

68
00:07:13,380 --> 00:07:14,620
!مستحيل

69
00:07:14,620 --> 00:07:16,490
...حقل الدّماء قد

70
00:07:23,880 --> 00:07:27,060
إذًا... يجب أن أخسر أمامك ثانيةً؟

71
00:07:28,050 --> 00:07:31,090
...كما تلك المرّة

72
00:07:31,820 --> 00:07:37,420
!الشّخص الوحيد الّذي رغبتُ اعترافه لم يخترني

73
00:07:38,350 --> 00:07:40,160
.أنا وحيدة

74
00:07:41,010 --> 00:07:42,940
!كنتُ وما زلتُ وحيدة

75
00:07:43,630 --> 00:07:45,150
.قفي رجاءً

76
00:07:46,560 --> 00:07:51,320
.واثقٌ أنّ الشّعلة الّتي تحترق داخلك لم تُخمد بعد

77
00:07:51,320 --> 00:07:57,080
!سيّدتنا ليست شخصًا ضعيفًا لكي تستسلم لخائن

78
00:07:57,080 --> 00:07:59,420
.وقفتُ إلى جانبك طوال هذا الوقت

79
00:07:59,420 --> 00:08:01,580
!أعلم كم أنت قويّة

80
00:08:02,350 --> 00:08:04,210
...أنتم

81
00:08:04,210 --> 00:08:07,840
...التّعاون ضدّ عدوّ ينتهك كبرياء زعيم العشيرة

82
00:08:08,320 --> 00:08:11,580
...لكنّ إهانة شخصٍ عزيز علينا

83
00:08:11,580 --> 00:08:14,840
.لم تترك لنا خيارًا عدا فعل ما يجب فعله

84
00:08:15,280 --> 00:08:16,400
.تهدرون وقتكم

85
00:08:16,850 --> 00:08:22,350
،إلى أن تتقن استخدام القوّة الممنوحة للأسياد فقط

86
00:08:22,350 --> 00:08:25,480
.فلن تستطيع حتّى مسّني بخدش

87
00:08:26,100 --> 00:08:27,690
!وقح

88
00:08:39,360 --> 00:08:40,370
!روزاريا-ساما

89
00:08:50,230 --> 00:08:51,460
...لماذا

90
00:09:01,450 --> 00:09:07,360
...إلى أن تتقن استخدام القوّة الممنوحة للأسياد فقط

91
00:09:24,830 --> 00:09:26,250
.انتهى الأمر

92
00:09:37,220 --> 00:09:38,390
...إنّه

93
00:09:38,390 --> 00:09:40,180
!حقل الدّماء

94
00:09:49,060 --> 00:09:51,150
!حقل الدّماء

95
00:10:16,760 --> 00:10:19,750
.أجل... لستِ وحيدة

96
00:10:19,750 --> 00:10:23,560
...القوّة الّتي يمتلكها السّيّد والّتي تفوق كلّ سواها

97
00:10:26,540 --> 00:10:29,320
...ما دمت تملكينهم

98
00:10:33,670 --> 00:10:36,860
.بالغتَ حقًّا هذه المرّة

99
00:10:51,360 --> 00:10:55,220
.لا بأس. أهّبتُ نفسي لهذا منذ وقت طويل

100
00:11:13,560 --> 00:11:15,070
...ذلك

101
00:11:15,070 --> 00:11:16,960
...أ-أخي

102
00:11:16,960 --> 00:11:18,460
...لا أصدّق

103
00:11:18,460 --> 00:11:20,950
!ثمّة راغناروك آخر

104
00:11:47,610 --> 00:11:50,380
أ-أبي؟

105
00:11:59,400 --> 00:12:00,990
...راسكريا

106
00:12:02,720 --> 00:12:05,350
.أتساءل إن كان يمكنك رؤيتي

107
00:12:05,970 --> 00:12:10,010
،هذه فكرة متبقّية تركتها في راغناروك

108
00:12:10,010 --> 00:12:13,000
.ما يعني أنّني فارقتُ هذا العالم

109
00:12:13,410 --> 00:12:17,500
.أنا واثق أنّ قراري خلّف فوضى عارمة

110
00:12:17,500 --> 00:12:20,310
...سأشرح لك الآن

111
00:12:21,590 --> 00:12:24,430
،الأحداث الّتي قادت إلى سباتي الأبديّ

112
00:12:24,430 --> 00:12:29,910
.والسّبب الّذي دفعني لاتّخاذ قرار إنهاء حياتي

113
00:12:29,910 --> 00:12:30,770
ماذا؟

114
00:12:33,280 --> 00:12:38,460
.كما تعلمين، نحن النّبلاء نستطيع أن نعيش عيشًا نصف دائم

115
00:12:39,270 --> 00:12:43,730
وفقًا للقوانين العتيقة، أولئك الّذين
يعيشون حياة مديدة بغرض المتعة

116
00:12:43,730 --> 00:12:46,570
.لا يُدركهم التّغيير لكي يقودوا عشائرهم

117
00:12:47,440 --> 00:12:49,790
وكيف يقارن البشر بذلك؟

118
00:12:50,230 --> 00:12:53,500
،بينما يعيشون حياتهم القصيرة

119
00:12:53,500 --> 00:12:56,820
،فهم ضعفاء جدًّا وعابرون

120
00:12:57,470 --> 00:13:01,450
.لكن في بعض الأوقات، جشعون وحتّى جميلون

121
00:13:02,550 --> 00:13:07,550
،يحاولون يائسين ليعيشوا ولو يومًا آخر، وأن يصبحوا أقوى

122
00:13:07,550 --> 00:13:09,340
.ويتغيّروا

123
00:13:10,430 --> 00:13:12,940
".ندعو هذا بـ"التطوّر

124
00:13:15,500 --> 00:13:18,650
،أخبرني إنسان متحاذق ذات مرّة

125
00:13:18,650 --> 00:13:22,230
".إن كان هناك قانون لا يعجبك، تخلّص منه"

126
00:13:23,320 --> 00:13:24,910
.كانت مفاجأة كبيرة

127
00:13:24,910 --> 00:13:28,880
.إنّها فكرة بسيطة، إلّا أنّها لم تخطر لي قطّ

128
00:13:29,390 --> 00:13:34,210
.مهما بلغت قوّتنا، لم نكن أحرارًا

129
00:13:34,210 --> 00:13:39,190
.ثمّ فكّرتُ أنّها ربّما علينا نحن النّبلاء أن نتطوّر بدورنا

130
00:13:40,710 --> 00:13:44,880
.شاركتُ خطّتي مع كبار زعماء العشائر الّذين وثقت بهم كثيرًا

131
00:13:45,450 --> 00:13:49,490
أخبرتهم أنّه من أجل أن نأتمن
،مستقبل لوكيدونيا للجيل الجديد

132
00:13:49,490 --> 00:13:51,640
.أردتُ أن أدخل السّبات الأبديّ طوعًا

133
00:13:53,490 --> 00:13:55,590
وافق بعضهم

134
00:13:55,590 --> 00:13:58,530
.وعرضوا أن يدخلوا السّبات الأبديّ معي

135
00:13:59,320 --> 00:14:04,620
.لكنّي أمرتُ غيجتيل أن يظلّ ويراقب مستقبلنا

136
00:14:08,990 --> 00:14:10,740
...أيعني هذا

137
00:14:10,740 --> 00:14:14,010
هل كنت تعرف هذا يا غيجتيل-ساما؟

138
00:14:14,010 --> 00:14:20,020
.لهذا أردتنا أن نعود إلى لوكيدونيا ونثبت براءتنا

139
00:14:20,500 --> 00:14:22,740
!لـ-لكنّ هذا ليس منطقيًّا

140
00:14:22,740 --> 00:14:25,710
!لمَ لم تخبرنا بالحقيقة؟

141
00:14:26,910 --> 00:14:30,340
بعد موت السّيّد السّابق وزعماء العشائر الكبار

142
00:14:30,340 --> 00:14:34,860
،ودُفع ورثاؤهم فجأةً إلى تولّي منصب زعيم العشيرة

143
00:14:34,860 --> 00:14:37,630
.كان الارتباك الّذي أحدث ذلك بهم أكبر ممّا توقّعت

144
00:14:38,720 --> 00:14:41,980
،كما كان قلب راسكريا-ساما، الشّخص الّذي عليه قيادتهم

145
00:14:41,980 --> 00:14:44,150
.مضطّربًا كثيرًا أيضًا

146
00:14:44,980 --> 00:14:50,490
قام بعض الّذين أرادوا استغلال
،السّيّدة الصّغيرة بنشر شائعة شنيعة

147
00:14:50,490 --> 00:14:55,240
.وسرعان ما اعتُبر رايزل-ساما خائنًا

148
00:14:56,100 --> 00:15:00,470
،انتعشت راسكريا-ساما من قبل كراهيّتها لعدوّ غير موجود

149
00:15:00,470 --> 00:15:05,450
.وتوحّد زعماء العشائر في اتّفاقهم معها

150
00:15:06,620 --> 00:15:09,360
،نجحتُ في دحض الإشاعة

151
00:15:09,360 --> 00:15:13,130
.لكنّي امتنعتُ عن الكلام

152
00:15:13,130 --> 00:15:19,560
.شوّهتُ الحقيقة بإخبار نفسي أنّ هذا في صالح لوكيدونيا

153
00:15:20,440 --> 00:15:24,240
.وأنا مستعدّ لأعرض حياتي كتكفير

154
00:15:24,810 --> 00:15:28,420
أتقصد... أنّ تلك كانت غايتك من البداية؟

155
00:15:28,420 --> 00:15:31,780
...لهذا أخبرتنا بذلك في النّهاية

156
00:15:32,590 --> 00:15:37,890
كي تظلّ قلوبنا متّحدة في كلّ شيء، حتّى بعد موتك؟

157
00:15:45,720 --> 00:15:47,710
...والآن يا سيّدتي

158
00:15:47,710 --> 00:15:50,960
.أنزلي عليّ عقابك رجاءً

159
00:15:55,000 --> 00:15:56,550
!انتظروا لحظة

160
00:15:59,140 --> 00:16:03,060
!أنا، ريجيس ك. لانديغر، لديّ اقتراح للسّيّدة

161
00:16:03,060 --> 00:16:06,120
.إثم زعيم العشيرة يقع على سائر العشيرة

162
00:16:06,120 --> 00:16:11,360
!إن كان يجب أن يُعدم الآن، أعدميني معه رجاءً

163
00:16:11,360 --> 00:16:12,860
...ريجيس

164
00:16:14,050 --> 00:16:18,880
.كما ترين، آل لانديغر عنيدون للغاية

165
00:16:18,880 --> 00:16:21,330
.لن يتراجع قيد أنملة

166
00:16:21,330 --> 00:16:25,190
لهذا تركته يقنعك على إحضاره إلى هنا؟

167
00:16:25,190 --> 00:16:26,850
.غير معقول

168
00:16:26,850 --> 00:16:28,940
.أجل، ربّما

169
00:16:30,180 --> 00:16:31,300
!سيّدتي

170
00:16:31,300 --> 00:16:36,490
.بصراحة، أظنّ أنّ نبالة ريجيس تفوق أيًّا منّا

171
00:16:36,840 --> 00:16:41,360
،إن قتلتِ زعيم عشيرة مستقبليّ واعد هنا

172
00:16:42,190 --> 00:16:44,170
.فستُدنّسين اسم السيّد

173
00:16:44,170 --> 00:16:45,560
...كارياس-ساما

174
00:16:46,710 --> 00:16:48,900
.أعرض نفس الاقتراح

175
00:16:49,320 --> 00:16:51,860
يُجدر بريجيس أن يصبح زعيم عشيرة

176
00:16:51,860 --> 00:16:54,850
.وأحد الأعمدة الّتي تدعم لوكيدونيا

177
00:16:55,310 --> 00:16:57,180
...كما أخي الطّائش رايل

178
00:16:57,570 --> 00:16:59,950
.وسيرا أيضًا

179
00:16:59,950 --> 00:17:04,810
.إنّهم أعمدة ثمينة تدعم مجتمع النّبلاء والسّيّد

180
00:17:04,810 --> 00:17:06,560
.لا ينبغي أن تقتليهم

181
00:17:07,370 --> 00:17:09,940
.وآمل أن تعدلي عن إعدام غيجتيل-ساما أيضًا

182
00:17:11,280 --> 00:17:14,820
هلّا أصغيت لطلبات زعماء العشائر

183
00:17:14,820 --> 00:17:18,410
الّذين يبجّلونك من صميم قلوبهم؟

184
00:17:39,780 --> 00:17:41,430
...راسكريا-ساما

185
00:17:42,480 --> 00:17:47,220
.عندما كنتُ وحيدةً، كنتَ إلى جانبي

186
00:17:48,270 --> 00:17:51,170
.أحببتني

187
00:17:51,170 --> 00:17:56,190
.ما أمكنني... أن أقتلك أبدًا

188
00:17:58,430 --> 00:18:04,180
.سأخدمك إلى آخر رمق يا سيّدتي

189
00:18:16,090 --> 00:18:17,530
...راسكريا

190
00:18:18,510 --> 00:18:22,280
أنا واثق أنّ رايزل وغيجتيل والبقيّة

191
00:18:22,790 --> 00:18:27,690
.يمنحونك ما لم أستطع منحك إيّاه

192
00:18:29,530 --> 00:18:31,890
...كلّهم يحبّونك

193
00:18:33,380 --> 00:18:35,540
.كما أحببتك

194
00:18:36,960 --> 00:18:39,840
.سامحيني رجاءً لأنّي متُّ دون أن أخبرك

195
00:18:40,550 --> 00:18:45,430
.فلو أنّني رأيتُك تبكين، أخشى أنّ ذلك كان ليجعلني أتردّد

196
00:18:45,430 --> 00:18:49,280
.وداعًا يا راسكريا. كوني بخير

197
00:19:00,880 --> 00:19:04,980
.إنّه ينتمي لك أيّتها السّيّدة

198
00:19:08,830 --> 00:19:10,450
...أبي

199
00:19:21,770 --> 00:19:24,330
هل شُفيت جراحك يا رقم 4؟

200
00:19:24,850 --> 00:19:27,510
ماذا عنك يا رقم 3؟

201
00:19:27,510 --> 00:19:31,950
.أصابني الضّجر من انتظار شفائكم جميعًا

202
00:19:31,950 --> 00:19:33,350
.شكرًا على ذلك

203
00:19:33,830 --> 00:19:35,860
!لا سبب يدعوك لشكري

204
00:19:35,860 --> 00:19:37,730
انتظرتني، أليس كذلك؟

205
00:19:37,730 --> 00:19:39,400
!ذلك ليس ما عنيت

206
00:19:39,400 --> 00:19:40,500
.لا تخجل

207
00:19:40,500 --> 00:19:41,280
!سأقتلك

208
00:19:41,280 --> 00:19:42,000
.جرّب

209
00:19:41,280 --> 00:19:43,140
.ها هما مجدّدًا

210
00:19:42,000 --> 00:19:43,120
!سأفعل

211
00:19:43,120 --> 00:19:43,980
.كاذب

212
00:19:43,140 --> 00:19:44,760
.هذا يثبت أنّهما أفضل حالًا

213
00:19:43,980 --> 00:19:45,040
!أستطيع

214
00:19:45,040 --> 00:19:46,080
تستطيع؟

215
00:19:46,820 --> 00:19:49,270
.مسرور لأنّكم تعافيتم

216
00:19:49,270 --> 00:19:51,750
!الرّئيس! سيرا-سان

217
00:19:51,750 --> 00:19:54,370
.كما ترى، يمكننا الحراك الآن

218
00:19:54,370 --> 00:19:56,750
إذًا، ماذا سنفعل الآن؟

219
00:19:56,750 --> 00:19:59,970
.اكتملت تجهيزات العودة إلى اليابان

220
00:19:59,970 --> 00:20:03,550
.كما استلم ريجيس وسيرا تصريح العودة معنا

221
00:20:03,550 --> 00:20:04,710
حقًّا؟

222
00:20:04,710 --> 00:20:08,770
أجل، كفترة دراسيّة لنتعرّف
.على العالم إلى أن نُدرك سنّ الرّشد

223
00:20:09,870 --> 00:20:11,180
ماذا عنه؟

224
00:20:12,090 --> 00:20:16,580
.ذلك قرار يجب على مولاي أن يتّخذه

225
00:20:18,180 --> 00:20:19,350
.رايزل

226
00:20:20,030 --> 00:20:21,780
أيمكنني الانضمام لك؟

227
00:20:22,330 --> 00:20:23,520
.أكيد

228
00:20:29,240 --> 00:20:31,040
هلّا أخبرتني شيئًا؟

229
00:20:31,840 --> 00:20:35,760
كيف كان أبي برأيك؟

230
00:20:39,720 --> 00:20:41,550
...أخبرني يا رايزل

231
00:20:41,550 --> 00:20:44,690
ألا تملك أيّ اهتمام لتصبح السّيّد؟

232
00:20:45,320 --> 00:20:47,580
ما الّذي جعلك تطرح هذا السّؤال؟

233
00:20:47,580 --> 00:20:50,510
.أقصدُ أنّني إن قرّرتُ أن أتقاعد

234
00:20:50,510 --> 00:20:53,230
ألا تملك راسكريا-ساما؟

235
00:20:54,560 --> 00:20:57,570
.لكنّها لا تزال صغيرة

236
00:20:57,570 --> 00:21:02,740
.أودّ منك أن تكون مثالًا تحتدي به إلى أن تصير أكبر قليلًا

237
00:21:03,740 --> 00:21:07,700
.لعلمك، دورُ السّيّد أصعب ممّا تظنّ

238
00:21:07,700 --> 00:21:09,510
.لا يبدو كذلك

239
00:21:09,510 --> 00:21:12,310
.هذا ليس عرضًا سيّئًا لك

240
00:21:12,830 --> 00:21:17,380
.إن أصبحتَ السّيّد، فسيكون لديك الكثير من الخدم ليطيعوا أمرك

241
00:21:17,380 --> 00:21:19,500
.سيكون أحد معك دائمًا

242
00:21:20,950 --> 00:21:25,470
يجدر بذلك أن يكون أفضل من أن تكون نوبلس، صحيح؟

243
00:21:26,550 --> 00:21:27,970
.أرفض

244
00:21:30,110 --> 00:21:34,600
.سأستمرّ في دعمك كوني نوبلس

245
00:21:35,020 --> 00:21:37,850
.كما فعلت دائمًا

246
00:21:41,580 --> 00:21:45,740
صدقًا... لا تفعل ما تُؤمر به أبدًا، أليس كذلك؟

247
00:21:48,470 --> 00:21:52,990
.لم يكن والدك سوى أبًا فخورًا وشغوفًا

248
00:22:12,390 --> 00:22:14,140
هل أنت واثق من هذا؟

249
00:22:15,230 --> 00:22:16,190
.أجل

250
00:22:17,270 --> 00:22:21,330
قد يأتي يومٌ لا تعود قوّة نوبلس

251
00:22:21,330 --> 00:22:23,810
،مُحتاجة في لوكيدونيا

252
00:22:24,530 --> 00:22:29,800
.في مجتمع النّبلاء الجديد الّذي رغب به السّيّد السّابق

253
00:22:30,450 --> 00:22:36,990
ما دامت السّيّدة العظيمة محاطة بزعماء عشائر مُؤتمنين؟

254
00:22:46,680 --> 00:22:47,950
...فرانكن

255
00:22:47,950 --> 00:22:48,770
نعم؟

256
00:22:49,590 --> 00:22:52,870
.عندما نعود للدّيار، أريد بعض الرّامن

257
00:22:55,990 --> 00:22:58,060
.حاضر يا مولاي