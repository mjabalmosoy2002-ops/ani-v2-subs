1
00:00:12,970 --> 00:00:15,390
أواثق أنّ هذا الطّريق الصّحيح؟

2
00:00:15,390 --> 00:00:18,440
أيّ نبيل لا يعرف الطّريق إلى قلعة السّيّد؟

3
00:00:18,930 --> 00:00:20,950
.سأتركك خلفي إن ضعنا

4
00:00:20,950 --> 00:00:21,900
!عذرًا؟

5
00:00:21,900 --> 00:00:24,500
.بربّكما. هذا ليس وقت الشّجار حقًّا

6
00:00:24,820 --> 00:00:29,000
تقضي مهمّتنا بأن نحرص على
.وصول الرّئيس ومولاه إلى الملاذ

7
00:00:29,000 --> 00:00:33,320
عليكما أن تدخلا أوّلاً لتقوما بدور
،الطّعم واستدراج الأعداء بعيدًا

8
00:00:33,320 --> 00:00:34,510
.لذا تمالكا نفسيكما

9
00:00:35,160 --> 00:00:36,760
.وسندعمكما

10
00:00:36,760 --> 00:00:38,150
.شكرًا

11
00:00:48,150 --> 00:00:49,520
...ريجيس

12
00:00:50,330 --> 00:00:52,030
.رايل

13
00:02:30,940 --> 00:02:32,540
...روزاريا-ساما

14
00:02:32,540 --> 00:02:37,080
سيرا، ما الّذي تهدفين له بهربك من زنزانتك؟

15
00:02:37,600 --> 00:02:41,180
.لا بدّ أن أوقف سبات غيجتيل-ساما القسريّ

16
00:02:41,180 --> 00:02:43,680
.لا يمكنك. عودي إلى زنزانتك

17
00:02:43,680 --> 00:02:47,180
.إن فعلت الآن، سأسكت عن هذا الهروب المحرّم

18
00:02:47,990 --> 00:02:49,810
.تنحّي عن طريقي رجاءً

19
00:02:51,310 --> 00:02:54,350
أترفضين فعل ما تقوله لك أختك الكبرى؟

20
00:02:54,350 --> 00:02:55,440
.فتاة سيّئة

21
00:03:06,200 --> 00:03:10,710
.أنا أيضًا زعيمة عشيرة مثلك يا روزاريا-ساما

22
00:03:11,190 --> 00:03:12,910
.ومستعدّة لفعل ما يجب

23
00:03:14,600 --> 00:03:18,180
عدتَ للوكيدونيا رغمًا عن أوامر السّيّدة؟

24
00:03:18,180 --> 00:03:20,470
.لا بدّ أنّك تسعى للموت

25
00:03:20,470 --> 00:03:22,720
هل سيرا بخير؟

26
00:03:23,370 --> 00:03:25,050
.إنّها في الحجز

27
00:03:25,050 --> 00:03:28,050
!هل... بلّغت عنها؟

28
00:03:28,050 --> 00:03:29,770
!قلت أنّك تحبّها

29
00:03:29,770 --> 00:03:33,150
!اخرس! كلّ هذا بسببكم يا آل لانديغر

30
00:03:33,450 --> 00:03:35,900
!تورّطت سيرا في كلّ ذلك فحسب

31
00:03:35,900 --> 00:03:37,270
!ماذا تقصد؟

32
00:03:38,340 --> 00:03:41,580
حُكم على غيجتيل ك. لانديغر
بالسّبات الأبديّ القسريّ

33
00:03:41,580 --> 00:03:45,780
.بسبب تواصله مع الخائن وخيانة السّيّدة

34
00:03:46,550 --> 00:03:48,790
.وبصفتك حفيده، فأنت مذنب بقدره

35
00:03:49,170 --> 00:03:51,110
،إن أتيت معي بهدوء

36
00:03:51,110 --> 00:03:53,790
!سأكون كريمًا وأترك فيك ذراعًا وساقًا سليمتين

37
00:03:58,990 --> 00:04:00,190
!لا تدعه يخدعك

38
00:04:00,190 --> 00:04:01,550
...إم-21

39
00:04:02,330 --> 00:04:03,590
.اذهب يا ريجيس

40
00:04:03,590 --> 00:04:05,930
!لا تكن غبيًّا! لا أستطيع فعل ذلك لوحدي

41
00:04:05,930 --> 00:04:09,100
أيّها الحثالة! من سمح لك بالهرب؟

42
00:04:09,100 --> 00:04:11,600
—لن يغادر أحد دون إذ

43
00:04:11,600 --> 00:04:12,390
!إيّاك

44
00:04:12,390 --> 00:04:13,520
!أيّها الوغد

45
00:04:13,520 --> 00:04:15,210
أولستَ مشاكسًا؟

46
00:04:17,730 --> 00:04:19,610
!رقم 3، اذهب الآن

47
00:04:19,610 --> 00:04:20,690
!تاو؟

48
00:04:20,690 --> 00:04:24,570
.لا تقلق. لن نُهزم بسهولة كالمرّة السّابقة

49
00:04:24,570 --> 00:04:27,820
.أعطانا الرّئيس تمّيمة حظّ

50
00:04:29,550 --> 00:04:32,050
!رفاق... أنا مدين لكم

51
00:04:33,800 --> 00:04:36,580
.لا أصدّق أنّك آذيتني

52
00:04:37,070 --> 00:04:39,460
!حثالة مثلك

53
00:04:39,460 --> 00:04:41,840
—يستحيل أن

54
00:04:45,840 --> 00:04:48,070
.يا إلهي، تسبّبت بجلبة

55
00:04:48,070 --> 00:04:50,720
لا تنوين أن تطلبي الغفران من السّيّدة؟

56
00:04:59,640 --> 00:05:02,820
.فهمت. هذا جوابك إذًا

57
00:05:03,620 --> 00:05:04,450
...في تلك الحالة

58
00:05:07,770 --> 00:05:10,410
!أفيقي يا ساحرة الدّم

59
00:05:21,590 --> 00:05:25,800
.صدقًا أنّ تلك المرأة لا تعرف أيّ حدّ

60
00:05:31,270 --> 00:05:32,540
ريجيس؟

61
00:05:35,230 --> 00:05:36,600
.سأذهب

62
00:05:37,170 --> 00:05:39,790
.لا تتصرّف بإهمال لأنّه بمثابة أخيك الصّغير

63
00:05:49,600 --> 00:05:52,600
!كفّ عن الاختباء وأظهر نفسك أيّها القذر

64
00:05:52,600 --> 00:05:55,000
فور أن أجدك، سأفعل بك
!ما هو أسوأ من تمزيق أطرافك

65
00:05:55,510 --> 00:05:59,000
،حتّى بعد أن تناولنا تي-2
.لا يمكننا أن نهمل دفاعنا للحظة

66
00:05:59,000 --> 00:06:02,500
،علينا أن نقترب منه أكثر
.وإلاّ حتّى هذا المسدّس لن يصل له

67
00:06:02,850 --> 00:06:05,300
.رقم 4، وقتُ التّنفيذ

68
00:06:05,300 --> 00:06:07,010
هل سنفعل هذا حقًّا؟

69
00:06:07,010 --> 00:06:08,860
.واثق أنّك تستطيع فعلها

70
00:06:08,860 --> 00:06:11,380
.تفعل نفس الشّيء مع ريجيس طوال الوقت

71
00:06:11,760 --> 00:06:14,040
!أظهر نفسك أيّها القمامة

72
00:06:14,750 --> 00:06:16,240
.لا تدفعني للضّحك

73
00:06:17,410 --> 00:06:22,270
بالنّسبة لشخص لم يفعل شيئًا سوى
.الاستخفاف بنا، لستَ قويًّا على الإطلاق

74
00:06:22,270 --> 00:06:24,020
...أيّها الـ

75
00:06:24,020 --> 00:06:30,030
أتدري أنّ مجموع سنّنا نحن الثّلاثة
يساوي نصف سنّك فحسب؟

76
00:06:30,030 --> 00:06:33,780
.ها هو ذا آلة الاستفزاز اللاّذعة خاصّتنا

77
00:06:34,730 --> 00:06:36,680
.أرني ما لديك

78
00:06:36,680 --> 00:06:39,300
أم أنّك مجرّد عجوز هرم لا يجيد سوى الكلام؟

79
00:06:40,180 --> 00:06:41,840
!سأقتلك

80
00:06:41,840 --> 00:06:44,690
!سأقتلع قلبك من صدرك

81
00:06:49,270 --> 00:06:50,720
!وهدف

82
00:07:06,000 --> 00:07:08,960
!أيّها القمامة القذرة

83
00:07:08,960 --> 00:07:12,320
!لن أدع أيّ لطخة منكم خلفي

84
00:07:13,320 --> 00:07:15,050
!غرانديا

85
00:07:23,730 --> 00:07:24,980
هل أنت قلق؟

86
00:07:29,460 --> 00:07:33,990
واثق أنّنا نستطيع الاعتماد عليهم
.ليؤدّوا واجبهم بخبرة كبيرة

87
00:07:34,720 --> 00:07:36,850
.هيّا، يجب أن نسرع

88
00:07:40,960 --> 00:07:42,270
مولاي؟

89
00:07:42,270 --> 00:07:45,020
أليس هناك ما تريد؟

90
00:07:50,380 --> 00:07:53,410
.لم أتوقّع منك قطّ أن تتسبّب بهكذا معمعة

91
00:07:53,410 --> 00:07:55,300
.أعتذر

92
00:07:55,300 --> 00:07:58,910
لكن عندما سمعت أنّ زعيم عشيرتي
—خان السّيّدة، توجّب أن أعرف

93
00:07:58,910 --> 00:08:01,410
.ريجيس، غادر لوكيدونيا

94
00:08:03,160 --> 00:08:04,690
هل تخبرني أن أهرب؟

95
00:08:04,690 --> 00:08:06,200
.على الإطلاق

96
00:08:06,200 --> 00:08:10,170
.يمكنك أن ترجع بعد أن يتمّ إثبات أن كلّ هذا خطأ

97
00:08:10,170 --> 00:08:12,690
!لا أقوى على شيء بهذا الجبن

98
00:08:12,690 --> 00:08:15,540
،إن اقترف زعيم عشيرتي ما يثير الشّبهات

99
00:08:15,540 --> 00:08:17,510
!فلا بدّ أنّه يملك سببًا

100
00:08:18,250 --> 00:08:20,520
وإن كانت هذه الخيانة متعمّدة؟

101
00:08:21,940 --> 00:08:25,710
،في تلك الحالة، كذي دم نقيّ من سلالة لانديغر

102
00:08:25,710 --> 00:08:28,020
.فسأقبل بأيّ عقوبة مناسبة

103
00:08:31,590 --> 00:08:34,280
.تجاوزني إن كنت بهذا العزم

104
00:08:35,420 --> 00:08:40,160
إلّم تستطع حتّى تجاوزي، فماذا في حولك
أن تفعل من أجل غيجتيل-ساما؟

105
00:08:42,220 --> 00:08:45,110
،إن استطعت ولو خدشي

106
00:08:45,110 --> 00:08:48,170
.فسأساعدك على مقابلة غيجتيل-ساما

107
00:08:48,730 --> 00:08:49,670
ما رأيك؟

108
00:08:51,190 --> 00:08:54,700
يمنحني كارياس-ساما أفضل
.فرصة يمكنني أن أتمنّاها

109
00:08:55,790 --> 00:08:58,300
.لنبدأ بسرعة. فوقتنا قصير

110
00:09:04,250 --> 00:09:07,810
.من المبهر أنّك جعلتني ألجأ لاستخدام غرانديا

111
00:09:08,860 --> 00:09:10,310
!إم-21

112
00:09:13,200 --> 00:09:15,780
هل تظنّ أنّ ذلك سيفلح عليّ الآن؟

113
00:09:15,780 --> 00:09:16,920
!سحقًا

114
00:09:16,920 --> 00:09:18,250
!لسنا قريبين كفايةً

115
00:09:23,140 --> 00:09:26,030
.هذا جزاء القمامة عندما تتدخّل فيما لا يعنيها

116
00:09:26,340 --> 00:09:27,250
!فلتمت

117
00:09:32,960 --> 00:09:35,240
!أكوام قمامة قذرة

118
00:09:35,240 --> 00:09:38,890
،لو أنّكما بقيتما مختبئين
!لربّما تمكّنتما من العيش أطول قليلاً

119
00:09:44,380 --> 00:09:46,180
!لستم سوى قمامة

120
00:09:47,440 --> 00:09:49,450
!قمامة! حثالة

121
00:09:51,190 --> 00:09:52,400
.توقّف

122
00:09:52,400 --> 00:09:55,640
!إيّاك أن تلمسني بيديك القذرتين

123
00:09:56,750 --> 00:09:58,780
أتحسب نفسك نبيلاً؟

124
00:09:59,830 --> 00:10:04,130
.الشّقيّ المدلّل الّذي أعرفه نبيلٌ فخور حقيقيّ

125
00:10:04,440 --> 00:10:07,290
!ما كان ليلجأ لفعل شيء بهذا الجبن

126
00:10:07,980 --> 00:10:09,850
!أيّها الوغد

127
00:10:16,500 --> 00:10:18,760
رايل، ماذا تفعل؟

128
00:10:18,760 --> 00:10:20,060
!أخي

129
00:10:20,060 --> 00:10:21,470
...هذا

130
00:10:21,470 --> 00:10:23,960
.برّر فعلتك لاحقًا

131
00:10:23,960 --> 00:10:25,840
.بعد أن أهتمّ بهؤلاء الأعداء

132
00:10:25,840 --> 00:10:28,980
...عمّ تتحدّث؟ سبق وأن

133
00:10:32,120 --> 00:10:33,320
...أنت

134
00:10:34,310 --> 00:10:37,280
.أرى أنّه هزمكم شرّ هزيمة

135
00:10:37,840 --> 00:10:39,030
!الرّئيس

136
00:10:39,490 --> 00:10:42,030
رايل، هل تعرفه؟

137
00:10:42,030 --> 00:10:45,160
.نعم. كان هناك عندما ذهبت لإحضار سيرا

138
00:10:45,160 --> 00:10:48,550
—أصفحتُ عنه من باب الاحترام لسيرا، لكن الآن

139
00:10:51,210 --> 00:10:53,960
.لا أملك الوقت للّهو

140
00:10:54,390 --> 00:11:00,280
،على خلافك، عشتُ معارك حياة أو موت لا تحصى

141
00:11:00,280 --> 00:11:03,970
.بما فيها معركة مع زعيم عشيرة كيرتيا السّابق

142
00:11:03,970 --> 00:11:05,720
!ماذا؟

143
00:11:07,270 --> 00:11:09,190
.تراجع يا رايل

144
00:11:09,190 --> 00:11:10,970
...أخي... لكن

145
00:11:10,970 --> 00:11:14,730
.لا فرصة أمامك إن كنت لا تدرك حتّى مستواه

146
00:11:17,050 --> 00:11:20,800
.أعتذر. لم أعلم أنّك قاتلت زعيمنا السّابق

147
00:11:21,160 --> 00:11:25,420
.في تلك الحالة، سأظهر لك الآداب الّتي تستحقّ

148
00:11:26,150 --> 00:11:29,370
غير معقول! هل يستخدم أخي سلاح روح؟

149
00:11:31,840 --> 00:11:34,680
!رنّ يا رمح الظّلام

150
00:11:37,380 --> 00:11:41,380
.تراجعوا. ستموتون إن اقتربتم كثيرًا

151
00:11:50,980 --> 00:11:53,580
.كفاك عنادًا وغادر لوكيدونيا الآن

152
00:11:53,580 --> 00:11:55,590
.قبل أن يفوت الأوان

153
00:11:58,340 --> 00:11:59,770
.ليس بعد

154
00:12:00,330 --> 00:12:01,950
.ما زال بإمكاني القتال

155
00:12:03,130 --> 00:12:05,870
.لا يمكنني أن أستسلم

156
00:12:06,170 --> 00:12:07,200
ماذا؟

157
00:12:07,200 --> 00:12:11,500
.إن تركتني أذهب، ستُتّهم بجريمة خطيرة

158
00:12:12,090 --> 00:12:15,520
،لن أسامح نفسي إن هربت

159
00:12:15,520 --> 00:12:17,210
!وأنا أعلم أنّ ذلك سيحدث

160
00:12:17,670 --> 00:12:22,220
سيرا في الطّريق الّذي يمكنكما
.أن تقولا عنه بفخر أنّه حياة النّبلاء

161
00:12:22,970 --> 00:12:24,420
،وفوق كلّ ذلك

162
00:12:24,420 --> 00:12:29,510
لن أستطيع أبدًا أن أنظر في وجه الأشخاص
!الّذين قاتلوا مخاطرين بحياتهم كي أصل له

163
00:12:31,730 --> 00:12:37,180
.أبي، أنا واثقة أنّك ستعارض على قتالي له

164
00:12:37,650 --> 00:12:41,430
.لكنّه المتسبّب الوحيد في سلسلة الأحداث هذه

165
00:12:42,030 --> 00:12:48,530
سأصحّح خطأ ثقتك بشخص
.ما كان يجب أن تثق به

166
00:12:50,030 --> 00:12:52,540
.لوديس، أحضر غيجتيل إلى هنا

167
00:12:54,090 --> 00:12:56,040
.مفهوم

168
00:12:58,360 --> 00:12:59,420
.روزاريا

169
00:13:03,850 --> 00:13:06,090
.سيرا، آن الأوان لنذهب

170
00:13:06,670 --> 00:13:08,600
.السّيّدة تستدعينا

171
00:13:21,710 --> 00:13:24,690
.اختفى... دون ترك أثر

172
00:13:26,030 --> 00:13:27,610
.انتهى الأمر الآن

173
00:13:27,980 --> 00:13:31,620
.لن يجد أخي أبدًا فور أن يندمج مع المحيط

174
00:13:43,890 --> 00:13:45,260
.وجدتك

175
00:13:45,560 --> 00:13:47,520
!وجده بالفعل؟

176
00:14:00,520 --> 00:14:02,650
!رئيسنا مذهل حقًّا

177
00:14:03,770 --> 00:14:06,020
!لا تتبجّحوا أيّها القمامة

178
00:14:14,370 --> 00:14:16,120
!أيّها الرّئيس! لقد تأذّيت

179
00:14:18,150 --> 00:14:20,540
!هذا جزاؤك لحماية القمامة أيّها المغفّل

180
00:14:20,540 --> 00:14:21,980
!نلت ما تستحقّ

181
00:14:22,460 --> 00:14:23,380
!أحمق

182
00:14:25,920 --> 00:14:28,390
،لو أنّ أخي لم يتدخّل

183
00:14:28,390 --> 00:14:31,330
.لما كان هجومي أصابك على الأغلب

184
00:14:33,550 --> 00:14:34,760
!أخي

185
00:14:36,460 --> 00:14:38,230
.افهم هذا

186
00:14:38,230 --> 00:14:41,320
.تعتمد مهارات عشيرة كيرتيا على التّخفّي لا أكثر

187
00:14:41,320 --> 00:14:43,520
.لا ينبغي لروح مستخدمها أن تكون جبانة

188
00:14:45,300 --> 00:14:50,280
فهمت الآن لِمَ اختارك
.زعيم العشيرة السّابق كخليفته

189
00:14:52,160 --> 00:14:54,460
.بدأنا للتّوّ

190
00:15:02,330 --> 00:15:04,850
.فهمت نواياك الآن

191
00:15:04,850 --> 00:15:06,300
.فعلت ما يكفي

192
00:15:07,650 --> 00:15:09,930
...أنا آسف حقًّا

193
00:15:09,930 --> 00:15:11,780
...هذا خطئي

194
00:15:11,780 --> 00:15:14,140
.بربّك. ما زلت صبيًّا

195
00:15:14,140 --> 00:15:15,760
...كارياس-ساما

196
00:15:16,630 --> 00:15:19,900
.احرص أن تفي بوعدك رجاءً

197
00:15:24,940 --> 00:15:29,690
.ريجيس، عيشك مع البشر قد غيّرك حقًّا

198
00:15:31,280 --> 00:15:33,190
حقًّا؟

199
00:15:33,840 --> 00:15:35,510
...هذا مؤسف

200
00:15:43,030 --> 00:15:47,630
سيرا، هل هربت من زنزانتك
آملةً حماية غيجتيل؟

201
00:15:48,640 --> 00:15:49,630
.نعم

202
00:15:49,970 --> 00:15:52,160
،إن اعترفت بحماية خائن

203
00:15:52,160 --> 00:15:55,390
.فسيُحكم عليك أيضًا بالسّبات الأبديّ

204
00:15:55,390 --> 00:15:56,420
!سيّدتي

205
00:15:56,420 --> 00:15:57,260
...لا يعقل

206
00:15:57,260 --> 00:15:59,320
!هذه مبالغة

207
00:15:59,320 --> 00:16:01,150
.لا داعي لذلك

208
00:16:04,360 --> 00:16:09,430
سيّدتي، لا ترغبين إرغام سيرا
على دخول سبات أبديّ، أليس كذلك؟

209
00:16:09,430 --> 00:16:14,800
ولهذا استدعيتنا جميعًا إلى هذا
.المكان المقدّس حيث يرقد السّيّد السّابق

210
00:16:15,350 --> 00:16:19,240
هل حسبت أنّني سأتوسّل مغرفتك هنا؟

211
00:16:19,610 --> 00:16:20,870
.اصمت

212
00:16:20,870 --> 00:16:22,300
!لن أصمت

213
00:16:22,300 --> 00:16:26,210
!لا هو ولا سيرا ارتكبا أيّ جريمة

214
00:16:26,210 --> 00:16:30,030
.أرى أنّك تنوي التّستّر على ذلك الخائن حتّى النّهاية

215
00:16:30,640 --> 00:16:32,760
.انتظر قليلاً بعد

216
00:16:32,760 --> 00:16:36,470
فقريبًا سأحكم عليه هو الآخر
.بدخول السّبات الأبديّ هنا

217
00:16:36,470 --> 00:16:38,510
.هذا مستحيل

218
00:16:39,190 --> 00:16:41,270
أنا واثق أنّك لم تنسي

219
00:16:41,270 --> 00:16:45,350
.الرّجل الّذي إلى جانبه دائمًا

220
00:16:45,810 --> 00:16:48,400
،ليس نبيلاً حتّى

221
00:16:48,400 --> 00:16:51,030
،إلاّ أنّه يملك قوّة تعادل قوّة زعيم عشيرة

222
00:16:51,030 --> 00:16:55,430
ما يجعل منه الإنسان الوحيد
...الّذي كسب اعتراف السّيّد السّابق

223
00:16:56,480 --> 00:16:58,300
.فرانكنشتاين

224
00:17:02,830 --> 00:17:05,370
ماذا تكون فحسب؟

225
00:17:12,100 --> 00:17:16,940
لو أنّني رميتُ غرانديا
...وتركت كارتاس يمتصّ قوّته

226
00:17:20,310 --> 00:17:21,510
!أخي

227
00:17:22,070 --> 00:17:24,230
!تراجع! ستعيقني

228
00:17:25,030 --> 00:17:28,120
!أخي، خذ سلاحي الرّوحيّ

229
00:17:28,120 --> 00:17:30,810
...إن استخدمته مع كارتاس

230
00:17:30,810 --> 00:17:32,400
!يكفي

231
00:17:32,930 --> 00:17:38,420
.ائتمن أبونا ذلك السّلاح الرّوحيّ لك فقط

232
00:17:41,340 --> 00:17:45,990
ينبغي أن يُورث السّلاح الرّوحيّ
،لزعيم العشيرة القادم دون سواه

233
00:17:45,990 --> 00:17:49,850
.إلاّ أنّ أبانا قسّمه إلى قسمين وترك واحدًا لكلّ منّا

234
00:17:49,850 --> 00:17:53,160
.فعل شيئًا لا ينبغي أن يُسمح به أبدًا

235
00:17:53,160 --> 00:17:55,420
!فكّر ما يعنيه ذلك

236
00:17:57,550 --> 00:18:03,980
يعني أنّ لديّ واجب فقط
.أنا أستطيع تأديتك، كما تملك أنت

237
00:18:03,980 --> 00:18:07,020
إلاّ أنّك مستعدّ للتّخلّي عنه بتلك السّهولة؟

238
00:18:07,020 --> 00:18:09,690
!هل تريد أن تضرب برغبات أبينا عرض الحائط؟

239
00:18:11,700 --> 00:18:14,070
،والدكما، رايغا

240
00:18:14,070 --> 00:18:18,020
.هو الرّجل الّذي علّمني كيف أستخدم قوّتي

241
00:18:19,220 --> 00:18:24,360
وأيًّا ما فعل، فقد كان صارمًا وصامتًا
.وغير محبوب بأيّ طريقة... وفخور

242
00:18:24,360 --> 00:18:26,330
.أنت تشبهه تمامًا

243
00:18:28,480 --> 00:18:34,090
والآن يا زعيمَيْ عشيرة كيرتيا
...اللّذين ورثا دمه

244
00:18:34,670 --> 00:18:36,510
.لنتابع

245
00:18:37,590 --> 00:18:43,600
.سيّدتي، لا تعرفين شيئًا عن فرانكنشتاين ولا عنه

246
00:18:45,560 --> 00:18:51,060
لست جاهزة بعد لتكوني السّيّد
.الّذي يجمع بين النّبلاء

247
00:18:51,060 --> 00:18:53,080
!غيجتيل-ساما

248
00:18:53,080 --> 00:18:59,030
لا أحد منكم يعرف لِمَ تكره السّيّدة
ذلك الرّجل كرهًا شديدًا، أليس كذلك؟

249
00:18:59,030 --> 00:19:03,780
!ذلك لأنّه... الشّخص الّذي قتل السّيّد السّابق

250
00:19:03,780 --> 00:19:06,370
،ربّما هذا ما يعنيه لكم

251
00:19:06,370 --> 00:19:09,810
...لكنّ كره راسكريا-ساما نابع

252
00:19:09,810 --> 00:19:14,540
عن اقتراح السّيّد السّابق أن يجعله
.السّيّد الّذي يخلفه

253
00:19:18,800 --> 00:19:24,660
راسكريا-ساما، لو أنّني ارتكبتُ
،أيّ جريمة تستحقّ السّبات الأبديّ

254
00:19:24,660 --> 00:19:28,380
فهي لأنّني فشلتُ في إرشادك
...إلى طريق الصّواب

255
00:19:28,380 --> 00:19:33,810
.وفشلتُ في تربيتك لتكوني نبيلةً جديرة بالعرش

256
00:19:34,220 --> 00:19:38,490
لِمَ ساور السّيّد السّابق الشّكوك
في تنصيبك كسيّدة؟

257
00:19:38,490 --> 00:19:43,820
ولِمَ رفض عرض السّيّد السّابق لخلافته؟

258
00:19:44,080 --> 00:19:47,960
لم تتّخذي على عاتقك حتّى محاولة
.فهم كيف شعرا فعلاً

259
00:19:47,960 --> 00:19:50,550
.لم تفعلي شيئًا سوى ترك مشاعرك تسيطر عليك

260
00:19:50,550 --> 00:19:54,060
،ما دمتٍ أسيرة لهذا الغرور الجبان

261
00:19:54,060 --> 00:19:58,340
!فلا مستقبل للوكيدونيا أو النّبلاء

262
00:19:58,340 --> 00:20:00,300
!يكفي

263
00:20:00,300 --> 00:20:03,430
،كزعيم عشيرة كبير، تستحقّ احترامنا

264
00:20:03,430 --> 00:20:07,390
!لكن لا يمكننا أن نصدّق كلّ ذلك دون تردّد

265
00:20:07,390 --> 00:20:11,180
!لن نتجاهل هذه الإهانات الموجّهة لسيّدتنا

266
00:20:11,660 --> 00:20:13,100
...غيجتيل-ساما

267
00:20:15,340 --> 00:20:20,320
أفترض أنّ قلوب زعماء العشيرة الصّغار
.قد أدركتك على الأقلّ

268
00:20:23,680 --> 00:20:27,180
.تكلّمتُ أكثر ممّا يجب

269
00:20:27,180 --> 00:20:30,200
.افعلي ما تشعرين أنّه يجب فعله الآن رجاءً

270
00:20:33,430 --> 00:20:34,860
.حسنًا

271
00:20:34,860 --> 00:20:37,840
.سأحكم عليك بالسّبات الأبديّ فورًا

272
00:20:38,920 --> 00:20:41,340
.اتّخذت القرار الصّائب

273
00:20:48,240 --> 00:20:49,720
...السّلاح الرّوحيّ

274
00:20:49,720 --> 00:20:51,180
!راغناروك

275
00:21:02,920 --> 00:21:04,610
،باسمي كسيّدة

276
00:21:05,450 --> 00:21:10,220
،أحكم عليك يا زعيم عشيرة لانديغر
،غيجتيل ك. لانديغر

277
00:21:10,220 --> 00:21:12,720
.بالسّبات الأبديّ

278
00:23:34,850 --> 00:23:36,530
.أخطأتُ الغرفة