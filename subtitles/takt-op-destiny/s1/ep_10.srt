1
00:00:09,420 --> 00:00:13,480
كلّ شخص رآه يوجّه موسيقيّاً يقول دوماً

2
00:00:18,510 --> 00:00:20,490
أنّه رأى نوراً في صوته

3
00:00:22,930 --> 00:00:26,770
أتساءل ما إن كنتُ أستطيع أن أكون نور أحد أيضاً

4
00:00:27,880 --> 00:00:30,090
نور مُبهر كهذا

5
00:02:21,640 --> 00:02:22,610
هل هو لذيذ؟

6
00:02:23,140 --> 00:02:23,940
!أجل

7
00:02:24,230 --> 00:02:27,440
!كلّ شيء شهيّ عندما آكله معك يا مايسترو

8
00:02:27,960 --> 00:02:30,800
لا أعلم كيف ينبغي أن يكون شعوري
تجاه هذا المديح

9
00:02:31,180 --> 00:02:32,830
لكنّه يُسعدني بغضّ النظر

10
00:02:34,100 --> 00:02:38,170
حسناً يا مايسترو، لنتناول طعاماً أكثر معاً

11
00:02:41,090 --> 00:02:44,090
هل تتذكّر الوعد الّذي قطعناه؟

12
00:02:44,660 --> 00:02:45,780
بالطبع

13
00:02:46,600 --> 00:02:48,230
ينبغي أن ننطلق

14
00:02:48,600 --> 00:02:50,920
لا نريد أن نتأخّر

15
00:02:50,920 --> 00:02:51,710
!أجل

16
00:02:54,490 --> 00:02:58,510
كُن حذراً. لا يمكننا أن نتجاهل سماع
،قدر لذلك الصّوت

17
00:02:58,510 --> 00:03:00,700
ولا أحد يعلم ما قد يحدث

18
00:03:01,020 --> 00:03:04,950
لعلّ ليني يعرف شيئاً عن ذلك أيضاً

19
00:03:05,280 --> 00:03:07,640
أوصل سلامي إلى ليني

20
00:03:07,640 --> 00:03:10,800
فقد ساعدنا كثيراً

21
00:03:11,020 --> 00:03:14,430
إنّه بمثابة معلّم لك

22
00:03:14,690 --> 00:03:16,350
هو؟ مُعلّمي؟

23
00:03:16,760 --> 00:03:18,680
هل هذه نكتة؟ إنها غير مضحكة

24
00:03:19,460 --> 00:03:21,160
...يا إلهي

25
00:03:23,830 --> 00:03:24,910
...مايسترو

26
00:03:25,490 --> 00:03:28,210
لا بدّ أنّ هذا مثال عن إخفاء تعابير الإحراج

27
00:03:28,690 --> 00:03:29,520
اصمتي

28
00:03:29,520 --> 00:03:32,120
اسمح لي أن أعيد الصّياغة. أنت مُعاكس للتيّار

29
00:03:32,120 --> 00:03:33,450
أغلقي فمكِ حرفيّاً

30
00:03:34,060 --> 00:03:37,300
يبدو أنّهما تقرّبا أكثر من بعضهما

31
00:03:42,940 --> 00:03:46,500
!تاكت-تان! قدر-تان

32
00:03:48,180 --> 00:03:50,510
حسناً، حسناً. يبدو أنّنا عثرنا على شابّة

33
00:03:50,510 --> 00:03:52,430
وشابّ يستمتعان بلقاء في هذه السّاعة

34
00:03:52,740 --> 00:03:55,000
هل قاطعنا موعدكما الغراميّ؟

35
00:03:55,000 --> 00:03:58,180
مهلك. أنت من استدعانا إلى هنا

36
00:03:58,180 --> 00:03:59,800
ماذا يعني موعد غرامي؟

37
00:04:00,540 --> 00:04:02,060
...في الحقيقة

38
00:04:02,060 --> 00:04:06,420
إنّه عندما تخرجين وتفعلين شيئاً ممتعاً
!مع شخص آخر يجذب اهتمامكِ

39
00:04:06,640 --> 00:04:08,900
لقد عشنا هذه المناسبة في الأمس

40
00:04:09,360 --> 00:04:11,700
هل ما تقوله صحيح؟

41
00:04:12,970 --> 00:04:15,680
ليني، كفاك مُزاحاً

42
00:04:16,280 --> 00:04:20,270
أريد أن أعرف حقيقة السيمفونيكا ومأساة بوسطن

43
00:04:20,270 --> 00:04:23,320
وليس ذلك فقط. أخبرني بكلّ ما تعرفه

44
00:04:24,010 --> 00:04:26,570
حسناً. فلنبدأ

45
00:04:26,570 --> 00:04:29,580
أودّ سماع هذا أيضاً

46
00:04:33,400 --> 00:04:34,460
...ساغان

47
00:04:35,230 --> 00:04:37,530
أنت من السيمفونيكا

48
00:04:38,370 --> 00:04:40,040
تاكت أساهينا

49
00:04:40,420 --> 00:04:43,480
كنتُ أتطلّع قدماً للقائك

50
00:04:44,150 --> 00:04:48,220
فأنت ابن الرّوستا، كينجي أساهينا

51
00:04:49,690 --> 00:04:52,230
ماذا تفعل هنا؟

52
00:04:52,460 --> 00:04:54,550
ينبغي أن يكون هذا سؤالي يا ليني

53
00:04:54,550 --> 00:04:57,770
كان من المُفترض أن تأتي لرؤيتي، أنسيت؟

54
00:04:58,520 --> 00:05:01,730
فهمت. كشفت الأمور إذاً

55
00:05:01,730 --> 00:05:03,030
يبدو أنّ كلينا قد اكتشف ذلك

56
00:05:05,560 --> 00:05:08,240
لكن ما زالت أمامك خيارات

57
00:05:09,020 --> 00:05:12,320
ما رأيك أن نبقى صديقين؟

58
00:05:12,850 --> 00:05:16,290
وذلك كي ينتهي المطاف بي كما انتهى بشيندلر؟

59
00:05:18,790 --> 00:05:21,620
حصلتُ على كلّ المعلومات منه

60
00:05:22,990 --> 00:05:24,110
هكذا إذاً

61
00:05:30,760 --> 00:05:34,760
هذا مؤسف للغاية. كنتَ صديقاً جيّداً

62
00:05:35,120 --> 00:05:36,860
لا أصدّق أنّنا سنفترق هكذا

63
00:05:37,120 --> 00:05:39,250
لا تدخل صلب الموضوع فوراً، صحيح؟

64
00:05:39,800 --> 00:05:44,000
لطالما... كرهتُ هذا الجانب منك

65
00:05:44,760 --> 00:05:45,600
...ليني

66
00:05:46,240 --> 00:05:50,360
هل ما زالت تلك الشّوكة الرنّانة ترنّ بسببه؟

67
00:05:50,850 --> 00:05:53,920
أجل. إنّه من يقف وراء كلّ هذا

68
00:05:53,920 --> 00:05:57,450
كلّ ما كنتُ أفعله كان لأتأكّد ما إن كان
ذلك صحيحاً أم لا

69
00:05:58,190 --> 00:06:02,340
إن لم نوقفه هنا، ستحدث مزيد من الأشياء المروّعة

70
00:06:02,340 --> 00:06:04,840
إذاً هناك عمل واحد لنفعله

71
00:06:17,300 --> 00:06:20,520
هل يمكنني تحطيمهم هذه المرّة؟

72
00:06:20,740 --> 00:06:25,090
إن كانوا سيعترضوننا، فلا يترك لنا ذلك خياراً

73
00:06:25,860 --> 00:06:29,470
ستكون تلك خسارة، لكنّه أمر ضروريّ

74
00:06:35,950 --> 00:06:37,190
لن تؤذيها

75
00:06:39,270 --> 00:06:42,620
ما رأيك أن نريهم ما يستطيع فعله
هذا المُعلّم والتلميذ؟

76
00:06:42,620 --> 00:06:44,610
لم أوافق على أن أكون تلميذك

77
00:06:44,610 --> 00:06:46,500
يا لبرود مشاعرك

78
00:06:46,840 --> 00:06:47,990
تلميذ؟

79
00:06:48,480 --> 00:06:52,270
ليني، أرى أنّك ما زلت تحاول أن تعوّض

80
00:06:54,730 --> 00:06:57,160
...مأساة بوسطن التي حدثت قبل عشر سنوات

81
00:06:57,630 --> 00:06:59,600
كان حاضراً أيضاً

82
00:07:00,630 --> 00:07:04,930
وأصبح كونداكتر للتكفير عن ذلك

83
00:07:05,160 --> 00:07:06,960
أليس كذلك يا ليني؟

84
00:07:09,330 --> 00:07:11,680
لا بدّ أنّك ليونارد

85
00:07:12,120 --> 00:07:14,910
نادني "ليني" رجاء يا معلّم

86
00:07:15,130 --> 00:07:19,610
في هذه الحالة يا ليني، سمعتُ أنّك
تريد أن تكون تلميذي

87
00:07:19,960 --> 00:07:22,790
لكن لديّ شرط واحد

88
00:07:23,290 --> 00:07:24,550
ما هو؟

89
00:07:24,980 --> 00:07:29,380
في الواقع، كنتُ آمل أن تصبح معلّمي أيضاً

90
00:07:29,720 --> 00:07:34,440
أودّ أن أتعلّم منك، مثلما ستتعلّم منّي

91
00:07:35,400 --> 00:07:39,000
رغم ما يوحي به مظهري، هناك أمور كثيرة لا أعرفها

92
00:07:39,360 --> 00:07:41,990
لا أعرف حتّى كيفيّة إعداد بانكيك لذيذ

93
00:07:44,010 --> 00:07:45,050
،في هذه الحالة

94
00:07:45,050 --> 00:07:50,730
سأعلّمك كيفيّة تحضير بانكيك مميّزة
جدّاً سيستمتع بها ابنك بكلّ تأكيد

95
00:07:51,010 --> 00:07:53,350
!يبدو هذا رائعاً

96
00:08:06,160 --> 00:08:09,090
معلّم، أما من فرصة لتعيد النّظر؟

97
00:08:09,500 --> 00:08:11,970
الخطر من دي 2 يستمرّ ويزداد يوماً بعد يوم

98
00:08:11,970 --> 00:08:15,350
سقطت العديد من المدُن في السّاحل الشرقي

99
00:08:15,860 --> 00:08:18,340
سمعتُ أنّه وقع الكثير من الضحايا

100
00:08:18,830 --> 00:08:21,220
...القيام بجولة حفلات غنائيّة في خضمّ كلّ هذا

101
00:08:23,750 --> 00:08:26,190
...إذا أصابك أيّ مكروه

102
00:08:26,990 --> 00:08:28,410
هذا خطير جدّاً

103
00:08:28,410 --> 00:08:29,940
ولهذا بالتحديد أفعل ذلك

104
00:08:30,810 --> 00:08:34,550
شُلّت حركة النّاس الآن بواسطة الخوف والقلق

105
00:08:34,550 --> 00:08:36,840
بسبب اللّانهائي الّذي ينتظرهم

106
00:08:37,750 --> 00:08:40,250
من أين نستمدّ السّعادة؟

107
00:08:40,950 --> 00:08:42,520
من الأمل

108
00:08:43,170 --> 00:08:46,830
يحتاج النّاس لنور الأمل

109
00:08:47,590 --> 00:08:52,080
وواجبي أن أخبر النّاس بذلك من خلال الموسيقى

110
00:08:53,140 --> 00:08:55,340
لأجل المستقبل القادم أيضاً

111
00:08:57,170 --> 00:08:58,500
...معلّم

112
00:09:00,740 --> 00:09:03,260
لا أستطيع... رؤية شيء

113
00:09:03,940 --> 00:09:05,560
...أين أنا

114
00:09:07,950 --> 00:09:09,220
صوت؟

115
00:09:10,820 --> 00:09:16,570
!أبي

116
00:09:17,750 --> 00:09:20,020
...معلّم

117
00:09:23,100 --> 00:09:27,060
أتساءل ما إن كنتُ أستطيع أن أكون نور أحد أيضاً

118
00:09:28,420 --> 00:09:30,640
نور مُبهر كهذا

119
00:09:41,000 --> 00:09:42,440
لماذا؟

120
00:09:45,990 --> 00:09:47,320
هل تتألّم؟

121
00:09:49,040 --> 00:09:53,910
سيّد فلايهارت، أمامك خياران

122
00:09:54,570 --> 00:09:58,440
الأوّل، بمقدورك أن تستمرّ في الشّفاء
وتتقدّم بقيّة حياتك

123
00:09:58,950 --> 00:10:00,310
...أو الثّاني

124
00:10:02,120 --> 00:10:04,080
يمكنك المقاومة في وجه هذه المأساة

125
00:10:06,050 --> 00:10:07,710
،بفضل بعض الاختبارات

126
00:10:07,710 --> 00:10:11,320
تمّ التأكيد بأنّك تمتلك التركيبة
الطبيعيّة لتصبح كونداكتر

127
00:10:13,080 --> 00:10:16,850
هذا يعني أنّك تمتلك القوّة لمقاتلة الـ دي 2

128
00:10:17,980 --> 00:10:20,360
...قوّة القتال

129
00:10:23,270 --> 00:10:26,170
...هكذا إذاً. لهذا السّبب أنا

130
00:10:34,530 --> 00:10:36,730
!من دواعي سروري أن ألتقيك يا مايسترو

131
00:10:36,730 --> 00:10:38,010
!اسمي تايتان

132
00:10:38,010 --> 00:10:39,100
!أتطلّع قدماً للعمل معك

133
00:10:42,080 --> 00:10:43,130
أنا ليني

134
00:10:44,010 --> 00:10:47,140
ستقاتلين بجانبي من الآن فصاعداً إذاً؟

135
00:10:47,140 --> 00:10:48,130
!أجل

136
00:10:48,480 --> 00:10:50,050
يا لها من ابتسامة جميلة

137
00:10:50,050 --> 00:10:52,270
لمَ لا تبتسم يا مايسترو؟

138
00:10:52,650 --> 00:10:56,010
في الواقع... قد يكون ذلك صعباً بالنسبة لي الآن

139
00:10:56,450 --> 00:10:57,850
هكذا إذاً

140
00:10:57,850 --> 00:11:01,380
!في هذه الحالة، سأبتسم بما يكفي لكلينا

141
00:11:02,970 --> 00:11:06,850
حينئذ لن تكون حزيناً جداً، صحيح؟

142
00:11:06,850 --> 00:11:11,070
!لذا لا تقلق! سأبتسم دوماً لأجلك

143
00:11:12,030 --> 00:11:13,310
!أعدك

144
00:11:17,700 --> 00:11:18,700
هكذا إذاً

145
00:11:19,380 --> 00:11:21,370
في هذه الحالة، سأعدكِ بشيء أيضاً

146
00:11:21,980 --> 00:11:24,760
،إذا حزنتِ يوماً يا تايتان

147
00:11:25,840 --> 00:11:28,020
سأبتسم عنكِ بدلاً من ذلك

148
00:11:28,610 --> 00:11:30,790
وذلك كي تتمكّني من الابتسام من جديد

149
00:11:31,640 --> 00:11:34,200
حسناً! يبدو أنّنا اتّفقنا

150
00:11:45,630 --> 00:11:48,990
مايسترو، هل هذا يعني أنّ القتال انتهى؟

151
00:11:48,990 --> 00:11:51,970
،أجل. بسبب هذه الخطّة واسعة النّطاق

152
00:11:51,970 --> 00:11:54,510
تمكنّا من القضاء على معظم الـ دي 2

153
00:11:55,060 --> 00:11:59,760
تمّ التأكيد بأنّ الـ دي 2 من كلّ مكان
قد دخلوا في حالة خمول

154
00:12:00,400 --> 00:12:03,250
إن كان كذلك، فينبغي أن نكون بأمان لبعض الوقت

155
00:12:03,990 --> 00:12:06,030
!هكذا إذاً. هذا رائع

156
00:12:06,760 --> 00:12:10,330
أخبرني، هل من شيء تريد فعله
بعد انتهاء المعركة يا مايسترو؟

157
00:12:10,730 --> 00:12:14,240
!أودّ الذهاب للسفر

158
00:12:14,240 --> 00:12:15,660
!ربّما حتّى إلى الطرف الآخر من المحيط

159
00:12:16,300 --> 00:12:19,660
حسناً، ثمّة أمر واحد

160
00:12:19,920 --> 00:12:20,910
ما هو؟

161
00:12:21,440 --> 00:12:22,550
...إنّه

162
00:12:46,450 --> 00:12:48,960
!هذه ليست نفس اللّعبة التي لعبناها آخر مرّة

163
00:12:51,190 --> 00:12:52,070
!قدر-تان

164
00:12:54,440 --> 00:12:57,580
...كان شعوراً رائعاً

165
00:12:57,950 --> 00:12:59,980
أيّتها العملاقة الصّغيرة-تان

166
00:13:04,370 --> 00:13:06,810
أؤمن بأنّه يُفترض أن تواجهيني أنا

167
00:13:07,180 --> 00:13:08,420
...جنّة

168
00:13:25,440 --> 00:13:27,820
أعتقد لا ينبغي أن أتفاجأ

169
00:13:28,260 --> 00:13:31,280
هاتان الاثنتان مُعضلة عندما يجتمعان معاً

170
00:13:33,030 --> 00:13:35,640
هذا غير مهمّ

171
00:13:35,640 --> 00:13:38,940
،إن كان هناك جدار في طريقنا

172
00:13:38,940 --> 00:13:40,920
...فمهما كان صلباً

173
00:13:40,920 --> 00:13:43,420
سأدمّره بيديّ هاتين

174
00:13:45,830 --> 00:13:47,480
يبدو أنّكِ أصبتِ الوتر الحسّاس

175
00:13:48,440 --> 00:13:52,690
اتّخذتُ قراري بإعادة الموسيقى إلى هذا العالم

176
00:13:53,210 --> 00:13:55,110
وأنّنا سنقاتل لفعل ذلك

177
00:13:55,780 --> 00:14:00,290
حسناً، لقد نضجتُما خلال الفترة
القصيرة التي لم أركما فيها

178
00:14:02,640 --> 00:14:03,740
!فليبدأ الأداء

179
00:14:05,670 --> 00:14:07,620
!هذا تماماً ما كنتُ أنتظره

180
00:14:21,360 --> 00:14:24,640
مهلاً، مهلاً، لا تشيحي بنظرك لشخص آخر

181
00:14:33,360 --> 00:14:34,320
!قدر

182
00:14:37,150 --> 00:14:38,130
!حرّري الصّوت

183
00:14:50,850 --> 00:14:51,880
!لا تتوقّفي

184
00:15:10,540 --> 00:15:11,970
...مايسترو

185
00:15:14,210 --> 00:15:15,990
...تاكت أساهينا

186
00:15:16,800 --> 00:15:20,590
لحن عزفك مذهل حقّاً

187
00:15:21,150 --> 00:15:23,930
اسمح لي بالتصفيق لك على هذا الأداء

188
00:15:38,390 --> 00:15:39,840
لن أدعكِ

189
00:15:57,180 --> 00:15:58,690
—ليني، أنت

190
00:16:02,820 --> 00:16:03,680
!مايسترو

191
00:16:05,020 --> 00:16:08,070
لا، لن تذهبي إلى أيّ مكان

192
00:16:08,410 --> 00:16:11,060
!ماذا تفعل يا ليني؟ أوقف هذا

193
00:16:21,830 --> 00:16:24,350
...أقسمتُ آنذاك

194
00:16:26,170 --> 00:16:28,250
...استمع جيداً

195
00:16:34,620 --> 00:16:36,730
!إلى موسيقايّ

196
00:16:58,130 --> 00:16:59,220
لنفعلها

197
00:17:01,410 --> 00:17:02,490
...إنّها

198
00:17:03,370 --> 00:17:06,010
!حان... وقت العرض

199
00:17:29,410 --> 00:17:31,830
كنت تخفي شيئاً خرافياً طوال هذا الوقت؟

200
00:17:33,280 --> 00:17:35,590
جيّد، لكن لنرَ حجم صمودك

201
00:17:38,140 --> 00:17:39,720
قدر ما أشاء

202
00:17:41,950 --> 00:17:44,030
لم أكن أتكلّم معك

203
00:17:50,550 --> 00:17:52,500
ليس... بعد

204
00:17:52,500 --> 00:17:56,550
لم ينتهِ الأداء بعد

205
00:17:59,880 --> 00:18:02,260
هذا جميل جدّاً

206
00:18:02,770 --> 00:18:04,550
كيف لشيء أن يكون بهذا الجمال؟

207
00:18:05,030 --> 00:18:09,020
الألم والبهجة يتوحّدان من خلالك

208
00:18:09,910 --> 00:18:12,800
!هذا حقّاً لحن الحياة

209
00:18:13,780 --> 00:18:19,900
ساغان... أنت من استدعى دي 2
إلى بوسطن آنذاك، صحيح؟

210
00:18:20,210 --> 00:18:23,790
أجل. بدأ كلّ شيء حينها

211
00:18:25,220 --> 00:18:27,540
هل تكرهني يا ليني؟

212
00:18:27,900 --> 00:18:29,140
لا

213
00:18:29,140 --> 00:18:31,480
أشفق عليك في الواقع

214
00:18:31,480 --> 00:18:35,770
فأنت لم ترَ النّور يوماً، أليس كذلك؟

215
00:18:36,530 --> 00:18:37,820
أيّ نور؟

216
00:18:47,950 --> 00:18:49,600
!المُنتصر

217
00:19:12,860 --> 00:19:15,460
كان ذلك بديعاً بحقّ يا ليني

218
00:19:15,970 --> 00:19:18,470
...استمتعتُ بكلّ لحظة منه

219
00:19:19,430 --> 00:19:21,430
لحن خاتمتك

220
00:19:25,300 --> 00:19:26,970
...تاكت أساهينا

221
00:19:27,520 --> 00:19:31,610
أتطلّع قدماً لسماعك بلحن أعظم حتّى

222
00:19:48,520 --> 00:19:49,740
...مايسترو

223
00:19:50,180 --> 00:19:51,710
...تايتان

224
00:20:00,130 --> 00:20:02,870
وعدتُك، أليس كذلك؟

225
00:20:08,820 --> 00:20:10,540
...تاكت

226
00:20:13,220 --> 00:20:17,640
هذا هراء. ماذا تفعل بالضبط؟

227
00:20:20,860 --> 00:20:25,150
تتدخّل باستمرار، والآن تفعل هذا؟

228
00:20:30,070 --> 00:20:32,570
إلى أيّ درجة... أنت غبيّ؟

229
00:20:34,160 --> 00:20:36,930
...أقسمتُ آنذاك

230
00:20:45,740 --> 00:20:48,350
كيف يُفترض بي حتّى أن أواجهه؟

231
00:21:04,220 --> 00:21:09,170
الاعتذار من ذاك الفتى ليس ما ينبغي
لي أن أفعله الآن

232
00:21:10,720 --> 00:21:14,740
...أقسم لك، سأبني عالماً

233
00:21:15,530 --> 00:21:19,770
عالماً يمكنك فيه عزف لحن قلبك

234
00:21:24,260 --> 00:21:28,090
نضجتَ كثيراً

235
00:21:28,660 --> 00:21:30,470
تبدو كموسيقيّ فعلاً الآن

236
00:21:33,280 --> 00:21:36,330
يعزو كلّ الفضل لكِ يا قدر

237
00:21:37,200 --> 00:21:39,970
ألن نرى بعضنا الآخر بعد الآن؟

238
00:21:44,390 --> 00:21:46,040
الموسيقى لن تموت

239
00:21:47,190 --> 00:21:50,580
ليني، أؤلّف أغنية الآن

240
00:21:53,290 --> 00:21:56,510
أنوي وضع كلّ تجاربي وخبرتي إلى الآن في الأغنية

241
00:21:58,230 --> 00:22:00,170
أنت جزء منّي أيضاً

242
00:22:02,390 --> 00:22:03,960
أنت تناغُمي

243
00:22:04,360 --> 00:22:05,790
علّمتني ذلك، أتذكر؟

244
00:22:07,720 --> 00:22:09,260
يبدو ذلك مذهلاً

245
00:22:11,460 --> 00:22:15,060
...كنتُ قد قرّرتُ أنّه عندما ينتهي كلّ هذا

246
00:22:15,470 --> 00:22:17,790
سأعزف الموسيقى من جديد

247
00:22:18,230 --> 00:22:20,730
أجل. لنعزف معاً

248
00:22:21,420 --> 00:22:24,790
فأنت مُعلّمي

249
00:22:25,740 --> 00:22:29,190
مع أنّني لستُ متأكّداً ما إن كنت ستتمكّن
من مجاراة عزفي على البيانو

250
00:22:29,770 --> 00:22:32,390
أرى أنّك ستبقى فتى شقيّاً حتّى النّهاية

251
00:22:33,550 --> 00:22:35,900
...لكن أتطلّع قدماً لذلك

252
00:22:40,790 --> 00:22:42,310
إنّي أسمع ذلك

253
00:23:09,110 --> 00:23:10,240
...معلّم

254
00:23:10,790 --> 00:23:13,500
بدا ذلك مذهلاً يا ليني