1
00:00:06,850 --> 00:00:08,610
أراداما تستخدم أوتسوشي؟

2
00:00:08,610 --> 00:00:12,990
كان الحراس النخبة يستخدمونها
.أيضًا، لذا هذا ليس مفاجئًا

3
00:00:16,840 --> 00:00:18,320
...مذهل

4
00:00:18,320 --> 00:00:21,040
ردّت ضربات من درع الإعصار لوحدها؟

5
00:00:22,440 --> 00:00:25,370
أعتقد أنّ بإمكانكما القول
أنّ تلك المعدات قامت بعمل جيّد

6
00:00:25,370 --> 00:00:29,130
إن كانت قاتلت طليعتي
والتي هي درعي و

7
00:00:29,130 --> 00:00:31,240
.الحراس النخبة الذين يحملون الأراداما

8
00:00:32,360 --> 00:00:33,790
.هذا ممتع

9
00:00:33,790 --> 00:00:35,000
!ماذا؟

10
00:00:35,840 --> 00:00:38,300
.سيخفّف هذا من استيائي

11
00:00:38,300 --> 00:00:42,930
!سأنجز المهمّة التي تركتها والدتي

12
00:00:43,300 --> 00:00:44,640
.فلتحاولي ذلك

13
00:00:44,640 --> 00:00:48,480
سأسألك شيئًا أخيرًا، هل أنتِ أوريغامي يوكاري؟

14
00:00:48,480 --> 00:00:50,780
أم الأميرة تاغيتسو؟

15
00:00:51,250 --> 00:00:53,820
هل لديك وقت للتحدّث؟

16
00:00:56,700 --> 00:00:59,680
!اضربيها بكل ما أوتيتِ يا كانامي

17
00:00:59,680 --> 00:01:00,500
!حسنًا

18
00:02:41,970 --> 00:02:42,970
نيني؟

19
00:02:44,420 --> 00:02:45,510
...سحقًا

20
00:02:47,440 --> 00:02:49,060
يا أيلين

21
00:02:51,890 --> 00:02:53,300
لقد ماتت؟

22
00:02:54,040 --> 00:02:56,480
.لا تقرري أنّي ميتة من تلقاء نفسك

23
00:02:57,200 --> 00:02:59,110
.تلك الطفلة ليست موجودة

24
00:03:00,050 --> 00:03:03,060
.لقد ألحقنا بها ضررًا كبيرًا إلى حدٍّ ما

25
00:03:06,330 --> 00:03:09,210
تتواجد الأراداما العظيمة هناك، أليس كذلك؟

26
00:03:09,210 --> 00:03:11,870
ستكون الأمور أسهل بكثير إن
.تمكنتا هيوري وكانامي من هزيمتها

27
00:03:12,450 --> 00:03:15,710
لم يبقَ لدينا إلّا وقت قليل
.حتّى نهاية الحدّ الزمني للمعدّات

28
00:03:15,710 --> 00:03:16,970
ماذا علينا أن نفعل؟

29
00:03:17,360 --> 00:03:19,700
.لقد تضررنا كثيرًا

30
00:03:20,630 --> 00:03:23,670
.لن نجلب أيّ فائدة حتّى وإن انضممنا لهما

31
00:03:23,670 --> 00:03:27,390
.أريد أخذ قيلولة هنا فحسب

32
00:03:27,890 --> 00:03:31,890
،ولكنّنا سنذهب مع ذلك
.هذا ما يفعله الأبطال

33
00:03:34,770 --> 00:03:36,330
!أنا معك

34
00:03:41,850 --> 00:03:45,450
يفترض أن تكوني ميّتة بعد
.فقدان كلّ هذا المقدار من الدماء

35
00:03:45,450 --> 00:03:48,780
.أنتما من سينتهي أمره أولًا

36
00:03:48,780 --> 00:03:49,850
.استمري

37
00:03:49,850 --> 00:03:51,710
يفترض أن تكونا قريبتين
.من الحدّ التشغيلي لهما

38
00:03:52,580 --> 00:03:56,710
أريد منك أن تكبحي الأراداما
.للقليل من الوقت يا ساياكا-تشان

39
00:03:57,330 --> 00:03:59,180
.سأقوم بقطعها

40
00:03:59,650 --> 00:04:00,740
.مفهوم

41
00:04:01,940 --> 00:04:05,720
.سأستخدم هذه القوّة بما أراه مناسبًا

42
00:04:17,030 --> 00:04:19,900
هذا أسلوب نيتين إيتشي الخاص بأوريغامي يوكاري؟

43
00:04:20,220 --> 00:04:22,170
!ليس لدينا وقت للتردّد

44
00:04:22,170 --> 00:04:24,280
!سنحسم هذا في الضربة القادمة يا كانامي

45
00:04:24,280 --> 00:04:25,200
!حسنًا

46
00:04:45,360 --> 00:04:46,470
انتهيتما؟

47
00:04:46,470 --> 00:04:47,590
!هيوري-تشان

48
00:04:49,520 --> 00:04:50,830
...هيوري-تشان

49
00:04:50,830 --> 00:04:54,180
كيف تمكنت من ضدّ هجماتنا؟

50
00:04:54,660 --> 00:04:57,810
هل تتنبّأ بتحرّكات سيفينا بالكامل؟

51
00:04:58,170 --> 00:05:03,650
.نعم، أستطيع التنبؤ بكلّ شيء

52
00:05:09,380 --> 00:05:10,660
...ساياكا

53
00:05:21,110 --> 00:05:22,680
.أحسنتِ

54
00:05:30,160 --> 00:05:31,600
!ساياكا

55
00:05:32,070 --> 00:05:34,220
أتجرؤين على توجيه موراماسا نحوي؟

56
00:05:36,440 --> 00:05:37,670
!ساياكا-تشان

57
00:05:39,960 --> 00:05:40,940
.إنّها ساخنة

58
00:05:42,530 --> 00:05:45,140
.يداي اللتان تلقيتا سيف كانامي ساخنتان

59
00:05:45,990 --> 00:05:48,660
.كتفاي اللذان ضممتهما ماي ساخنان

60
00:05:49,460 --> 00:05:54,160
ولكن عندما أوجّه الأوكاتانا
.خاصتي نحوك، فإنّ صدري يؤلمني

61
00:05:55,000 --> 00:05:56,540
...ساياكا-تشان

62
00:05:59,570 --> 00:06:03,520
.حتّى دمية مثلك لديها مشاعرٌ كهذه

63
00:06:03,520 --> 00:06:05,920
لا، بل ربما نمت لك؟

64
00:06:06,820 --> 00:06:09,930
حسنًا يا ساياكا، سأعلّمك

65
00:06:09,930 --> 00:06:13,210
.كيف تزيلين ذلك الألم

66
00:06:13,680 --> 00:06:15,950
.توسلّي لي لأسامحك

67
00:06:15,950 --> 00:06:18,250
سأعلّمك حينها كيف تتخلصين
—من مثل هذه المشاعر الغير

68
00:06:18,250 --> 00:06:19,260
...تفهمين

69
00:06:20,310 --> 00:06:21,540
.لا تفهمين

70
00:06:22,400 --> 00:06:25,780
.الألم الذي أشعر به هو لأنّي أشفق عليك

71
00:06:29,830 --> 00:06:32,200
.لنذهب ونلحق بكانامي وهيوري بسرعة

72
00:06:32,680 --> 00:06:33,480
.حسنًا

73
00:06:39,060 --> 00:06:40,790
...ساياكا

74
00:06:53,350 --> 00:06:57,720
.انطلقي نحو يوكاري-ساما يا ماكي-سان

75
00:06:58,920 --> 00:07:03,050
.مع الأسف، لا أملك القوّة للقتال أكثر

76
00:07:03,740 --> 00:07:06,570
.سأبقى هنا وأتعامل مع جثّة يومي

77
00:07:06,570 --> 00:07:07,930
تتعاملين معها؟

78
00:07:07,930 --> 00:07:11,540
.ستتحوّل إلى أراداما إن تركناها هكذا

79
00:07:11,960 --> 00:07:12,990
.صحيح

80
00:07:13,570 --> 00:07:15,400
...ستصبح يومي ثانية

81
00:07:15,400 --> 00:07:16,280
!ماكي-سان

82
00:07:16,700 --> 00:07:20,740
.ألا تفهمين؟ لم تعد هذه يومي

83
00:07:21,970 --> 00:07:25,300
إنّه أراداما سيستغل يومي
.وكأنّها مشتل زهور مجهّز

84
00:07:25,960 --> 00:07:29,630
.سنضطر لقتل يومي ثانيةً حينها

85
00:07:30,580 --> 00:07:33,020
.أنا سأعتني بها

86
00:07:33,020 --> 00:07:34,970
.سيكون ذلك صعبًا عليك

87
00:07:35,830 --> 00:07:41,100
لا يسمح لنا بالموت طبيعيًّا حتّى؟

88
00:07:41,830 --> 00:07:44,440
.كنّا مستعدين لهذا منذ البداية

89
00:07:45,440 --> 00:07:47,660
.منذ أن قبِلنا الأراداما

90
00:07:48,360 --> 00:07:52,490
!والآن، اذهبي، أيّتها العضو الأوّل في الحراس النخبة

91
00:08:04,080 --> 00:08:06,910
.تتنبّأ عيناي بكلّ شيء

92
00:08:06,910 --> 00:08:11,420
...قدراتكما الجسديّة، قوتكما الكامنة، أفكاركما

93
00:08:12,020 --> 00:08:14,460
،أتنبأ بكلّ احتماليّة

94
00:08:14,460 --> 00:08:17,370
.وأقرّر أيّ حركة هي الأفضل حينها

95
00:08:17,960 --> 00:08:20,180
.سأجيب عن سؤالك السابق

96
00:08:21,120 --> 00:08:23,140
.أنا الأميرة تاغيتسو

97
00:08:31,320 --> 00:08:33,070
أيمكنها التنبّؤ بالأشياء حقًّا؟

98
00:08:33,070 --> 00:08:35,070
!لا أستطيع التفكير سوى بذلك

99
00:08:35,630 --> 00:08:39,740
صحيح، سبب تمكنها من صدّ
—كلّ ضربة من سيفي كان

100
00:08:39,740 --> 00:08:42,880
.صحيح، أستطيع التنبؤ بكلّ شيء

101
00:08:42,880 --> 00:08:45,650
،كان بالإمكان قتلك ببساطة

102
00:08:45,650 --> 00:08:47,500
.ولكنّي أفلتّك عمدًا

103
00:08:48,080 --> 00:08:53,450
ونتيجة ذلك، حرّكت جميع
.الأوتار، وتدمرت موكسا

104
00:08:53,880 --> 00:08:57,760
.والآن عدتِ لكي أقتلك

105
00:08:58,780 --> 00:08:59,850
!أيّتها الوغدة

106
00:08:59,850 --> 00:09:00,640
!كلّا

107
00:09:02,100 --> 00:09:03,060
.يمكنني التنبّؤ بها

108
00:09:05,520 --> 00:09:06,520
!مـ-ما الذي—؟

109
00:09:09,200 --> 00:09:11,190
ألم تتنبّأ بضربتي للتو؟

110
00:09:11,190 --> 00:09:12,310
!ابتعدي يا كانامي

111
00:09:13,240 --> 00:09:14,260
...إذًا

112
00:09:22,330 --> 00:09:24,180
.لا، هذا لن ينفع

113
00:09:26,960 --> 00:09:28,670
لمَ لا تهاجم؟

114
00:09:30,290 --> 00:09:32,170
.إنّها تتنبّأ بأمور أكثر من اللازم

115
00:09:32,680 --> 00:09:36,300
إن هاجمت، فيمكنها حصر
.ما يتبع الهجمة إلى حدّ معيّن

116
00:09:36,670 --> 00:09:39,850
ولكن بهذه الحالة، فإنّها
تتنبّأ باحتمالات أكثر من اللازم

117
00:09:39,850 --> 00:09:41,560
.ولا يمكنها تحديد ما ستفعله

118
00:09:55,240 --> 00:09:56,590
.فهمت

119
00:09:56,590 --> 00:10:00,580
يبدو أنّ أيّ حسابات إضافيّة
.ستكون صعبة على هذا الوعاء

120
00:10:00,580 --> 00:10:01,580
—ولكن

121
00:10:08,180 --> 00:10:09,580
!تشيدوري

122
00:10:16,670 --> 00:10:19,000
.تشيدوري وكوغاراسومارو

123
00:10:19,680 --> 00:10:23,440
لم أتصوّر أن يوجد أحدٌ في الزمن الحاضر

124
00:10:23,440 --> 00:10:25,340
.مثل فوجيوارا ميناتو وهيراغي كاغاري

125
00:10:26,150 --> 00:10:28,540
.وجودٌ مساوٍ لي

126
00:10:29,360 --> 00:10:32,150
لمَ لم أتنبّأ بذلك الاحتمال؟

127
00:10:33,080 --> 00:10:34,070
!فهمت

128
00:10:36,750 --> 00:10:37,930
!...يوكاري

129
00:10:39,010 --> 00:10:39,820
!اضرباني

130
00:10:40,400 --> 00:10:40,990
ماذا؟

131
00:10:40,990 --> 00:10:43,030
!اضرباني بالأوكاتانا هذه

132
00:10:54,480 --> 00:10:56,090
!هذا مثل تلك المرّة

133
00:11:00,620 --> 00:11:02,740
.إنّها تحدث ثانية يا أكاني-ساما

134
00:11:03,360 --> 00:11:04,490
...ني-ساما

135
00:11:16,500 --> 00:11:18,940
شيطان؟

136
00:11:49,730 --> 00:11:51,350
!ساياكا-تشان

137
00:11:53,100 --> 00:11:55,060
!ستأتي الضربة التالية يا هيوري-تشان

138
00:12:03,950 --> 00:12:05,180
!انسحبي

139
00:12:06,830 --> 00:12:08,160
.أنا آسفة

140
00:12:08,160 --> 00:12:09,160
.لا بأس

141
00:12:09,570 --> 00:12:12,660
.أنا خائفة لأوّل مرّة

142
00:12:12,660 --> 00:12:13,830
.أنا أيضًا

143
00:12:14,420 --> 00:12:16,310
.إنّها كذلك على الأرجح

144
00:12:24,720 --> 00:12:26,470
...عليّ التأكّد

145
00:12:35,520 --> 00:12:36,730
!مستحيل

146
00:12:36,730 --> 00:12:38,680
!أين اختفى كلّ ذلك النورو؟

147
00:12:38,680 --> 00:12:40,730
هل فهمتِ الوضع إذًا؟

148
00:12:41,520 --> 00:12:43,450
ما هذا المكان؟

149
00:12:43,450 --> 00:12:46,700
.مخزن كلّ النورو الذي جمعته عائلة أوريغامي

150
00:12:46,970 --> 00:12:51,910
حتّى قبل بضع سويعات، كان يوجد
.ما يعادل مقدار عشرين سنة من النورو هنا

151
00:12:52,390 --> 00:12:56,920
إذًا قاموا بجمعها كلّها وأنعشوا ذلك الوحش؟

152
00:12:57,210 --> 00:13:00,120
لا يصبح نورو طيفًا إن تم
تعريضه إلى تيار كهربائي طوال الوقت

153
00:13:00,120 --> 00:13:02,320
.حسب طول موجته

154
00:13:02,320 --> 00:13:04,810
يمكن التحكم بها بشكل منتظم
أكثر من تقديمها في أماكن عديدة

155
00:13:04,810 --> 00:13:06,590
.بكميّات صغيرة

156
00:13:06,590 --> 00:13:08,800
.هذه كذبة مع الأسف

157
00:13:08,800 --> 00:13:11,280
كانت النورو تتظاهر أنّها خامدة

158
00:13:11,280 --> 00:13:13,770
.تحت تحكّم الأميرة تاغيتسو

159
00:13:14,840 --> 00:13:17,980
ما يعني أنّ هذه الدولة
،مخدوعة من قِبلها لعشرين سنة

160
00:13:17,980 --> 00:13:20,690
.بينما كانت تجمع النورو بجد

161
00:13:21,100 --> 00:13:22,570
.تحملي المسؤوليّة

162
00:13:23,030 --> 00:13:26,270
ولكن الحوادث المتسببة
من قِبل الأراداما انخفضت

163
00:13:26,270 --> 00:13:28,590
.منذ أن بدأت عائلة أوريغامي بإدارة نورو

164
00:13:28,590 --> 00:13:30,340
.وعدد التوجي الموتى أيضًا

165
00:13:30,800 --> 00:13:33,330
.كلّ هذا مسرحيّة للتجهيز لهذا اليوم

166
00:13:33,330 --> 00:13:35,960
الأراداما، والتي هي تجسيد للنجاسة لن تموت

167
00:13:35,960 --> 00:13:38,080
.حتّى لو أُبيدت بلا توقّف

168
00:13:38,490 --> 00:13:41,740
.يجب أن تكون هناك قوّة مساوية لصدّها

169
00:13:41,740 --> 00:13:45,550
كلّ ما عليك فعله هو مقاتلة
—السم بالسم، والنجاسة بالنجاسة

170
00:13:45,550 --> 00:13:48,090
أهذا هو سبب قبولك للأراداما؟

171
00:13:48,090 --> 00:13:50,170
.المعنى هو أنّك خائفة فحسب

172
00:13:50,170 --> 00:13:50,850
!ماذا؟

173
00:13:51,200 --> 00:13:54,090
تُكره الأراداما لكونها نجسة

174
00:13:54,090 --> 00:13:57,020
.بسبب مخاوف أمثالك

175
00:14:08,260 --> 00:14:09,410
يوكاري-ساما؟

176
00:14:09,880 --> 00:14:11,700
...لا، ذلك

177
00:14:15,320 --> 00:14:16,260
!انتظري

178
00:14:22,920 --> 00:14:24,920
!كاورو-تشان، أيلين-تشان

179
00:14:28,620 --> 00:14:30,230
.يستخدم العدو أسلوب الستة سيوف

180
00:14:30,230 --> 00:14:33,000
!هذا مثالي لوجود ستة منّا

181
00:14:35,140 --> 00:14:37,160
!تراجعي قليلًا يا كانامي-تشان

182
00:14:37,160 --> 00:14:38,480
!خلفك يا أيلين-تشان

183
00:14:52,990 --> 00:14:55,120
!لا تقتربي كثيرًا يا كاورو-تشان

184
00:14:57,580 --> 00:14:58,870
!ماي

185
00:15:00,370 --> 00:15:02,080
!ماي-تشان، ساياكا-تشان

186
00:15:17,720 --> 00:15:22,490
هل أستخدمها؟ نفس التقنية السريّة لوالدتي؟

187
00:15:22,490 --> 00:15:24,480
.أنا إله الشر

188
00:15:33,690 --> 00:15:36,270
.أعطيني أوامرك من فضلك يا يوكاري-ساما

189
00:15:36,270 --> 00:15:37,700
.سننجز مهمتنا

190
00:15:37,700 --> 00:15:38,980
مهمتنا؟

191
00:15:39,430 --> 00:15:40,460
!يوكاري-ساما

192
00:15:41,510 --> 00:15:42,960
.أرجوك يا كاغاري

193
00:15:44,150 --> 00:15:46,210
.اختمي الأميرة تاغيتسو

194
00:15:46,210 --> 00:15:47,180
.حاضرة

195
00:15:47,180 --> 00:15:48,240
!انتظري

196
00:15:48,240 --> 00:15:51,530
أعتذر عن اضطرارك لأخذ
.قرار مؤلم كهذا

197
00:15:52,820 --> 00:15:57,810
الأيّام المدرسيّة التي قضيتها رفقة
.الجميع هي كنزي الذي لا يقدّر بثمن

198
00:15:58,290 --> 00:16:02,780
،عانيت معك أحيانًا بصراحة يا ميناتو-سينباي

199
00:16:02,780 --> 00:16:05,920
.ولكنّي ممتنة جدًّا لك

200
00:16:05,920 --> 00:16:07,190
كاغاري؟

201
00:16:07,520 --> 00:16:10,300
!سأختمك أيّتها الأميرة تاغيتسو

202
00:16:10,710 --> 00:16:13,200
!أنا هنا لهذا السبب

203
00:16:14,680 --> 00:16:15,450
!كاغاري

204
00:16:24,200 --> 00:16:27,590
!ميناتو

205
00:16:37,350 --> 00:16:40,720
!ميناتو-سينباي؟ لا! ليس أنتِ أيضًا

206
00:16:40,720 --> 00:16:43,150
!لن أسلّم كاغاري لك أبدًا

207
00:16:51,480 --> 00:16:55,410
...كاغاري... ميناتو... ما الذي

208
00:17:00,570 --> 00:17:02,750
...أوريغامي يوكاري

209
00:17:02,750 --> 00:17:05,610
.لديّ عرضٌ لك

210
00:17:07,120 --> 00:17:13,860
.وجدت نفسي مستيقظة في مخزن بارد ومظلم

211
00:17:14,740 --> 00:17:18,600
.كان هناك شعور بالضياع في بادئ الأمر

212
00:17:19,300 --> 00:17:22,160
،شعور أنّ جزءٌ منّي قد اُنتزع

213
00:17:22,160 --> 00:17:25,850
،شيءٌ ثمين سُرق

214
00:17:25,850 --> 00:17:28,920
...والرغبة باستعادته

215
00:17:28,920 --> 00:17:32,150
.كانت كالجوع

216
00:17:32,780 --> 00:17:36,470
.أصبحت إله الشرّ مع الوقت

217
00:17:36,470 --> 00:17:41,880
.أصبح الانتقام هو حافزي حينها

218
00:17:43,200 --> 00:17:48,870
.استمرّ ذكائي بالتطوّر بينما أُبعد الأسوأ عنّي

219
00:17:49,330 --> 00:17:52,840
.تنبّأت باستنتاج واحد لاحقًا

220
00:17:53,280 --> 00:17:55,840
،أنا من تحوّلت إلى إله الشر

221
00:17:55,840 --> 00:17:59,900
.سأُدمّر من قِبل البشر يومًا ما

222
00:18:00,360 --> 00:18:03,840
.بحثت عن طريقة للنجاة

223
00:18:03,840 --> 00:18:07,100
.كان يجب أن تُنفّذ فحسب

224
00:18:07,100 --> 00:18:08,390
...لا يمكن

225
00:18:08,880 --> 00:18:12,840
احتواء إينوشيما وإرسال
...وحدات الجيش الخاصّة

226
00:18:12,840 --> 00:18:15,930
.صحيح يا أوريغامي يوكاري

227
00:18:15,930 --> 00:18:19,980
.كلّ ذلك كان لاستدراجك

228
00:18:19,980 --> 00:18:23,990
ماذا عن كاغاري وميناتو إذًا؟

229
00:18:24,380 --> 00:18:26,330
.اتحدي معي

230
00:18:26,330 --> 00:18:31,610
افعلي ذلك وستُحفظ حياة
.فوجيوارا ميناتو وهيراغي كاغاري

231
00:18:32,250 --> 00:18:34,600
،سأتحد معك

232
00:18:34,600 --> 00:18:38,570
وسأختبئ في سطح العالم
.السفلي وأشافي جروحي

233
00:18:38,570 --> 00:18:42,270
.سأمنحك فترة رحمة حتّى عشر سنوات

234
00:18:42,270 --> 00:18:46,940
ستفوزين إن استطعتِ
.تدميري إلى ذلك الحين

235
00:18:46,940 --> 00:18:49,100
لمَ قد أقبل عرضًا سخيفًا كهذا؟

236
00:18:49,100 --> 00:18:52,250
.لقد اتخذتِ قرارك بالفعل

237
00:18:53,840 --> 00:18:57,280
إنّها مهمّة عائلة أوريغامي
.التي أورثت باستمرار

238
00:18:57,690 --> 00:19:01,160
.ولكن اختارت يوكاري نجاتهما

239
00:19:06,490 --> 00:19:07,720
!كـ-كانامي

240
00:19:08,130 --> 00:19:12,280
.إنّك بارعة، لكنّك لا تقارنين بوالدتك

241
00:19:15,090 --> 00:19:16,730
...أمّي

242
00:19:19,160 --> 00:19:21,870
حسنًا، ما الذي ستفعلينه؟

243
00:19:21,870 --> 00:19:24,560
هل ستستخدمين نفس
التقنية السريّة لوالدتك؟

244
00:19:24,560 --> 00:19:28,140
هذا إن كنتِ تستطيعين اختراق
.جسدي بذلك الأوكاتانا بالطبع

245
00:19:29,960 --> 00:19:33,360
.لا يمكن لسيفك أن يصلني

246
00:19:33,360 --> 00:19:36,360
لا توجد توجي في هذا العالم
.يمكنها أن تتفوّق على أوريغامي يوكاري

247
00:19:39,280 --> 00:19:41,860
!لم أرك منذ وقت طويل يا يوكاري

248
00:19:42,560 --> 00:19:43,570
ميناتو؟

249
00:19:45,600 --> 00:19:46,870
كانامي؟

250
00:19:46,870 --> 00:19:48,420
.مستحيل

251
00:19:56,580 --> 00:19:57,760
.مستحيل

252
00:19:57,760 --> 00:19:59,050
!بل ممكن

253
00:19:59,920 --> 00:20:01,050
كانامي؟

254
00:20:02,950 --> 00:20:04,680
.مستحيل

255
00:20:04,680 --> 00:20:07,970
!فوجيوارا ميناتو ميّتة

256
00:20:10,020 --> 00:20:11,430
.يبدو ذلك

257
00:20:12,000 --> 00:20:14,160
.لا يفترض أن يوجد هذا المستقبل

258
00:20:14,160 --> 00:20:16,310
!ولكنّنا هنا مع ذلك

259
00:20:23,910 --> 00:20:25,050
!كانامي

260
00:21:41,260 --> 00:21:44,190
!هذا سيفي الوحيد الحقيقي

261
00:21:45,080 --> 00:21:46,320
.أحسنت

262
00:21:46,320 --> 00:21:50,160
ستنزلين معي إلى أعماق
!العالم السفلي الآن

263
00:22:00,500 --> 00:22:02,250
!لا تفعليها يا هيوري-تشان

264
00:22:11,360 --> 00:22:13,220
إنّ الأميرة تاغيتسو...؟