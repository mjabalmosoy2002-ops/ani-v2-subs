1
00:01:33,520 --> 00:01:34,620
أأنت قلق؟

2
00:01:34,620 --> 00:01:36,670
بخصوص ماذا؟

3
00:01:36,670 --> 00:01:38,730
.آسفة، رأيت شاشتك

4
00:01:39,640 --> 00:01:41,730
.يمكنك الذهاب إن كنت قلقًا

5
00:01:42,730 --> 00:01:44,460
أنت منزعج، أليس كذلك؟

6
00:01:44,460 --> 00:01:48,240
ولكن ارجع حين يحل الأمر، حسنًا؟

7
00:01:49,960 --> 00:01:51,250
.وعوضني

8
00:01:51,640 --> 00:01:53,740
.ولكن تكاد المباراة أن تبدأ

9
00:01:54,220 --> 00:01:55,640
ولكنّك قلق، أليس كذلك؟

10
00:01:56,630 --> 00:01:59,390
.سأكون كاذبًا إن قلت أنّي لست كذلك

11
00:01:59,660 --> 00:02:03,140
.تدين لي مقابل هذا. يستحسن أن تعوضني

12
00:02:03,750 --> 00:02:05,640
أأنت متأكدة؟

13
00:02:05,970 --> 00:02:08,530
.سأختلق عذرًا للآخرين

14
00:02:08,530 --> 00:02:12,630
.مقابل ذلك، أخبرني ماذا حدث لاحقًا

15
00:02:15,100 --> 00:02:19,410
.حسنًا. شكرًا يا ناوري

16
00:02:22,150 --> 00:02:24,150
أين قبلة الذهاب؟

17
00:02:24,150 --> 00:02:24,990
ماذا؟

18
00:02:27,990 --> 00:02:30,160
.خيّبت أملي

19
00:02:30,890 --> 00:02:32,540
.هيّا، اذهب

20
00:02:42,880 --> 00:02:45,030
لماذا على خدي؟

21
00:02:45,030 --> 00:02:49,850
...لـ-لماذا؟ أنا ممتن لك، ولكن

22
00:02:49,850 --> 00:02:51,050
.لا أستطيع فعل المزيد

23
00:02:58,240 --> 00:02:59,960
!هيّا، اذهب

24
00:02:59,960 --> 00:03:02,390
.رومي في أوميا على الأرجح

25
00:03:02,390 --> 00:03:04,860
.قالت أنّها ستشتري تمائم حظ لزملائها الكبار في الفريق

26
00:03:08,670 --> 00:03:12,130
.تبًا، أنا امرأة طيّبة حقًا

27
00:03:12,130 --> 00:03:13,710
ألست رائعة جدًا؟

28
00:03:16,900 --> 00:03:19,540
.لم آت إلى هنا منذ وقت طويل

29
00:03:19,540 --> 00:03:20,690
حقًا؟

30
00:03:20,690 --> 00:03:22,320
.ربما منذ الابتدائية

31
00:03:22,920 --> 00:03:23,840
حقًا؟

32
00:03:25,190 --> 00:03:27,770
...كنت أتساءل منذ مدة

33
00:03:27,770 --> 00:03:30,410
هل كنتِ في الأصل عسراء؟

34
00:03:30,410 --> 00:03:32,460
.لأنّك ترتدين سوار معصمك على يدك اليمين

35
00:03:34,190 --> 00:03:38,310
هذا لأنّي أحرزت رمية في الإعداديّة
.حين كنت أرتدي واحدة على معصمي الأيمن

36
00:03:38,310 --> 00:03:40,060
ماذا؟ هذا ما بالأمر؟

37
00:03:43,190 --> 00:03:44,190
.نعم

38
00:03:44,190 --> 00:03:46,450
.الأمر أشبه بخرافتي الخاصة

39
00:03:46,860 --> 00:03:49,360
.ولكن هذه الأمور تساعد

40
00:03:49,360 --> 00:03:52,040
،لا نجلب تمائم كما تفعلن أيّتها الفتيات

41
00:03:52,040 --> 00:03:55,840
ولكنّنا نعطي زملاءنا الكبار قمصان
.عليها رسائل مكتوبة باليد أيضًا

42
00:03:56,150 --> 00:03:59,810
.رسائل تجعل لبسها أمام العامة أمرًا مستحيلًا

43
00:03:59,810 --> 00:04:03,690
ستحصلون على نفس الشيء حين
يحين دوركم، ألا تمانعون ذلك؟

44
00:04:03,690 --> 00:04:04,530
.نعم

45
00:04:05,110 --> 00:04:07,220
.أنا سأرتديها

46
00:04:07,750 --> 00:04:09,320
.هذا يليق بك

47
00:04:12,330 --> 00:04:13,500
...أخبريني

48
00:04:14,270 --> 00:04:16,570
ما الذي يعجبك بشيروساكي؟

49
00:04:19,900 --> 00:04:23,560
.لـ-لا أدري

50
00:04:24,100 --> 00:04:25,520
ما هذا؟

51
00:04:26,470 --> 00:04:28,060
ألا يوجد ما يعجبك فيه تحديدًا؟

52
00:04:28,450 --> 00:04:31,580
.ماذا يا ترى... لطالما كنّا معًا

53
00:04:32,000 --> 00:04:34,580
.لذا الأمر افتراضي على ما أظن

54
00:04:35,050 --> 00:04:39,280
أكنت سأملك فرصة إلّم يكن موجودًا

55
00:04:39,800 --> 00:04:43,390
.من يدري؟ لا أعرف هذا. آسفة

56
00:04:43,390 --> 00:04:47,080
.لا تعتذري. يؤلمني الأمر حين تفعلين ذلك

57
00:04:48,380 --> 00:04:49,110
...آسفـ

58
00:04:49,680 --> 00:04:51,600
.من؟ أخبرني

59
00:04:51,600 --> 00:04:53,080
عمّاذا تتحدثين؟

60
00:04:51,600 --> 00:04:54,610
!أخبرني! هيّا

61
00:04:55,020 --> 00:04:56,970
ألا تنوي العودة؟

62
00:04:58,270 --> 00:04:59,440
.إلى ماي

63
00:05:02,910 --> 00:05:04,780
.هذا هو الشعور إذًا

64
00:05:05,540 --> 00:05:06,960
.فهمت الآن

65
00:05:07,970 --> 00:05:09,460
.أنا مثلك

66
00:05:09,910 --> 00:05:13,870
.لا أكرهها، ولكنّي لا أكن لها مشاعر أبدًا

67
00:05:15,050 --> 00:05:19,220
.ولكنّها ظلّت تحاول، وظننتها مزعجة بصراحة

68
00:05:19,750 --> 00:05:20,740
ألست كذلك أيضًا؟

69
00:05:22,870 --> 00:05:25,690
.لا شيء يسير كما ينبغي

70
00:05:28,770 --> 00:05:33,360
ماذا عنك؟ أيمكن أن تسير
الأمور بينك وبين شيروساكي  جيّدًا؟

71
00:05:34,100 --> 00:05:38,260
.لا شيء يسير جيّدًا في الحياة

72
00:05:42,830 --> 00:05:44,940
هل نبدأ؟

73
00:05:45,520 --> 00:05:46,360
.نعم

74
00:05:50,930 --> 00:05:52,920
.خذي اللون الأبيض

75
00:05:53,290 --> 00:05:55,150
.سأقبل هذا

76
00:06:03,990 --> 00:06:05,970
.لا بدّ أنّك ذكية

77
00:06:05,970 --> 00:06:07,040
لماذا تظن ذلك؟

78
00:06:07,040 --> 00:06:12,220
.لأنّك تعرفين طريقة لعب الشطرنج
أعلمك ذلك الصبي؟

79
00:06:12,220 --> 00:06:14,820
.نعم. إنّه يحب الشطرنج

80
00:06:15,890 --> 00:06:18,310
.أشعر أنّي قد أتوافق معه

81
00:06:18,310 --> 00:06:21,390
.أظن ذلك أيضًا. يحب الخيال  العلمي أيضًا

82
00:06:21,860 --> 00:06:24,240
.كنت تقرأن هاينلاين في ذلك اليوم

83
00:06:24,880 --> 00:06:29,560
.فهمت. يبدو أنّي لم أخطئ باختيارك

84
00:06:29,560 --> 00:06:31,360
"،اليرقة، وكذلك الشرنقة"

85
00:06:31,670 --> 00:06:33,740
".أظهرتا الفراشة المشرقة المستقبلية"

86
00:06:34,190 --> 00:06:35,500
.مفيستوفيليس

87
00:06:35,500 --> 00:06:37,490
أتغازلني؟

88
00:06:42,080 --> 00:06:45,650
.لست سيّئة. بل أفضل بكثير ممّا ظننت

89
00:06:45,650 --> 00:06:47,260
أأنت معجبة بغوته؟

90
00:06:47,260 --> 00:06:50,290
ليس تمامًا. قرأت الكتب لأنّها
.كانت موجودة في منزلنا فحسب

91
00:06:50,290 --> 00:06:53,040
".غوته هو من كتب "لا تغسل اليد إلّا اليد

92
00:06:53,380 --> 00:06:56,270
.فهمت. أنا متفاجئ لمعرفته له

93
00:06:56,270 --> 00:06:59,670
.جميع أصدقائي هكذا

94
00:07:00,420 --> 00:07:02,240
.يبدو هذا ممتعًا

95
00:07:02,240 --> 00:07:03,730
.صحيح

96
00:07:06,770 --> 00:07:08,220
.حسنًا. لا بأس

97
00:07:08,750 --> 00:07:11,110
.سأمنحكم الغرفة

98
00:07:11,850 --> 00:07:13,750
!حقًا؟ شكرًا

99
00:07:13,750 --> 00:07:15,850
!عرفت أنّ نياو-نياو ستكون خيارًا أفضل من زاكي

100
00:07:15,850 --> 00:07:17,510
!نياو-نياو الأفضل

101
00:07:17,510 --> 00:07:19,800
!اصمتي يا شيينا

102
00:07:18,740 --> 00:07:23,660
أهذا يعني أنّك ستعطينا غرفة النادي
سواءً فزت أو خسرت، أليس كذلك؟

103
00:07:23,660 --> 00:07:24,290
!بروفيسور

104
00:07:24,660 --> 00:07:26,460
.نعم، صحيح

105
00:07:26,460 --> 00:07:28,430
.شكرًا جزيلًا لك

106
00:07:28,430 --> 00:07:31,460
أيمكنك أن تكتب ذلك لنا احتياطًا؟

107
00:07:31,460 --> 00:07:35,040
.أنوقعها بدمه؟ لديّ مشرط ورق

108
00:07:34,330 --> 00:07:36,060
.هذه مبالغة يا سينسي

109
00:07:37,410 --> 00:07:39,530
أيمكننا أن نكمل لعبتنا إلّم تمانعي؟

110
00:07:39,930 --> 00:07:42,260
.أريد أن ألعب بغض النظر عن مسألة غرفة النادي

111
00:07:45,670 --> 00:07:48,380
.لم أكن متعلقًا بالغرفة أصلًا

112
00:07:48,900 --> 00:07:52,520
.لم تعجبني فكرة طلب تسليمها فجأة فحسب

113
00:07:52,930 --> 00:07:54,280
.لنكمل المباراة

114
00:07:54,710 --> 00:07:57,210
.هذا هو شرطي للتنازل عن الغرفة

115
00:07:58,070 --> 00:07:58,770
ما رأيك؟

116
00:08:01,020 --> 00:08:02,800
"،قبل أن أودعك"

117
00:08:03,190 --> 00:08:05,450
".سأريك مدى قوّتي"

118
00:08:11,310 --> 00:08:13,160
.قالت أنّها ستشتري تمائم حظ لزملائها الكبار في الفريق

119
00:08:19,460 --> 00:08:20,720
كيف يسير الأمر؟

120
00:08:28,340 --> 00:08:29,770
.لا يزالان يلعبان

121
00:08:29,770 --> 00:08:32,250
.ولكنّه وافق على منحنا الغرفة

122
00:08:32,250 --> 00:08:33,230
ماذا؟

123
00:08:33,230 --> 00:08:34,920
ما معنى هذا؟

124
00:08:37,890 --> 00:08:39,970
.أخبريني حين ينتهيان

125
00:09:00,390 --> 00:09:02,250
أدخلا محلًا ما؟

126
00:09:02,250 --> 00:09:04,510
.لا، عليّ أن أتحقق من الحديقة أولًا

127
00:09:05,360 --> 00:09:06,520
!سحقًا

128
00:09:07,110 --> 00:09:10,330
!سأعيش حياة لن أضطر فيها إلى الركض أبدًا

129
00:09:20,370 --> 00:09:21,410
.هذا فظيع

130
00:09:21,410 --> 00:09:23,900
.بل أنت الفظيعة

131
00:09:23,900 --> 00:09:25,170
.ربما أكون كذلك أيضًا

132
00:09:25,170 --> 00:09:28,070
.لن أنكر هذا

133
00:09:28,070 --> 00:09:29,170
.أعرف

134
00:09:29,170 --> 00:09:30,160
!رومي

135
00:09:32,610 --> 00:09:34,990
جون؟ لماذا أنت هنا؟

136
00:09:35,960 --> 00:09:37,170
.أتيت إذًا

137
00:09:37,170 --> 00:09:41,070
!هذا لأنّك أرسلت تلك الرسالة

138
00:09:41,070 --> 00:09:44,740
.كلّ ما فعلته هو إخبارك بمشاعري

139
00:09:45,270 --> 00:09:49,220
لماذا أتيت إلى هنا إذًا؟
لتخبرني ألّا أسلب فتاتك؟

140
00:09:50,860 --> 00:09:54,900
أنت تلهث. هل ركضت إلى هنا؟

141
00:09:54,900 --> 00:09:57,170
اصمت. خطأ من هذا؟

142
00:09:57,690 --> 00:10:01,290
...حكمًا على الرسالة التي أرسلتها لي

143
00:10:01,870 --> 00:10:04,610
فثمة ما تريد أن تخبرني إيّاه، أليس كذلك؟

144
00:10:05,210 --> 00:10:08,800
.ماذا يجري؟ أفهماني الأمر

145
00:10:08,800 --> 00:10:10,970
.آسف. انتظري قليلًا

146
00:10:11,360 --> 00:10:12,600
...عليّ أن أتحدث إلى أنغو

147
00:10:12,600 --> 00:10:16,210
.الأمر يتعلق برومي أيضًا. عليك أن تخبرها

148
00:10:16,510 --> 00:10:19,930
.وإلّا لن أقتنع أيضًا

149
00:10:21,740 --> 00:10:22,920
.حسنًا

150
00:10:23,840 --> 00:10:26,810
.ثمة ما أريد إخبارك إيّاه يا رومي

151
00:10:27,700 --> 00:10:30,050
ما الأمر فجأة؟

152
00:10:30,610 --> 00:10:32,640
.آسف لأنّي لم أوضّح الأمور

153
00:10:32,640 --> 00:10:35,930
.أعتذر على كلّ شيء آخر أيضًا

154
00:10:37,450 --> 00:10:38,400
.آسف

155
00:10:38,400 --> 00:10:40,400
لحظة... ما خطبك فجأة؟

156
00:10:40,400 --> 00:10:45,910
.سعدت جدًا بحبك لي وطلب مواعدتي

157
00:10:46,730 --> 00:10:48,950
،انفصلنا فجأة

158
00:10:49,410 --> 00:10:52,880
.ولكنّي بقيت أظن أنّنا نستطيع العودة معًا

159
00:10:54,170 --> 00:10:57,500
.ولكنّي بدأت أدرك أنّ هذا لم يكن صحيحًا

160
00:10:58,330 --> 00:11:01,470
.ولا يعني ذلك أنّي بدأت بتفضيل ناوري أو أيّ شيء

161
00:11:01,470 --> 00:11:04,160
.ما أزال عاجزًا عن وصف الأمر بالكلمات

162
00:11:05,620 --> 00:11:09,970
،كلّما تحدثت عن الأمر أكثر
.أنجرف أبعد عن مشاعري الحقيقيّة

163
00:11:10,760 --> 00:11:13,010
.لهذا لم أتمكن من توضيح الأمر

164
00:11:14,260 --> 00:11:15,430
...لا

165
00:11:16,070 --> 00:11:18,600
.أخبرت نفسي أنّ لا يوجد داعٍ لتوضيح الأمر

166
00:11:19,100 --> 00:11:23,620
.لكنني لم أعد قادرًا على ذلك
.أشعر أن هذا ليس صحيحًا

167
00:11:24,010 --> 00:11:27,620
.أنا أحبك أنت وناوري معًا

168
00:11:27,980 --> 00:11:30,990
!لأكون واضحًا، أحبكما بنفس القدر

169
00:11:31,430 --> 00:11:34,620
...أعرف أنّ هذا يبدو غير عادلًا، ولكن

170
00:11:35,140 --> 00:11:40,220
لا أستطيع الاختيار بينكما بعد
.كلّ الوقت الذي قضيناه معًا

171
00:11:41,450 --> 00:11:46,680
.بالطبع، أعلم أنّ هذا ليس عذرًا مقبولًا

172
00:11:47,380 --> 00:11:50,970
.أعترف أنّي كنت أهرب فحسب

173
00:11:51,570 --> 00:11:57,230
آذاكما ضعفي وأقلقكما، ولكنّي
.تظاهرت أنّي لا أرى ذلك

174
00:11:58,220 --> 00:12:02,770
...قد أبقيكما تنتظران أكثر، وأقلقكما أكثر

175
00:12:03,260 --> 00:12:04,170
...لكن

176
00:12:05,360 --> 00:12:07,240
.سأتخذ قرارًا حتمًا

177
00:12:08,170 --> 00:12:13,400
،إن كنت تنوين قبول ضعفي والتغاضي عنه

178
00:12:14,100 --> 00:12:16,590
هلّا تمنحيني وقتًا للتغلب عليه؟

179
00:12:18,230 --> 00:12:19,910
ماذا؟

180
00:12:19,910 --> 00:12:21,760
.ا-انتظر

181
00:12:22,320 --> 00:12:24,940
.يسعدني هذا، ولكنّه يؤلمني أيضًا

182
00:12:28,170 --> 00:12:29,310
.فهمت

183
00:12:30,260 --> 00:12:31,920
.سأنتظر

184
00:12:33,140 --> 00:12:34,450
...إنّه دورك الآن

185
00:12:34,450 --> 00:12:37,310
ألست تؤجل الإجابة فحسب؟

186
00:12:38,330 --> 00:12:40,510
.لم تتخذ أيّ قرار في نهاية المطاف

187
00:12:41,550 --> 00:12:45,240
ولا أستطيع قبول ذلك بما أنّي
.طلبت مواعدة رومي

188
00:12:45,990 --> 00:12:46,990
...ميزوما

189
00:12:46,990 --> 00:12:50,500
انتظريني؟ كيف لك أن تقول هذا ببساطة؟

190
00:12:50,910 --> 00:12:52,590
من تظن نفسك؟

191
00:12:53,320 --> 00:12:58,790
.ولكنّي سعيدة بمعرفتي أنّه يأخذ الأمر على محمل الجد

192
00:12:58,790 --> 00:13:03,430
.أنت متساهلة معه. لهذا لديه هذه الثقة الزائدة بالنفس

193
00:13:04,260 --> 00:13:05,520
.لست متساهلة معه

194
00:13:04,540 --> 00:13:06,280
.لا املك ثقة زائدة بالنفس

195
00:13:06,730 --> 00:13:09,940
سيكون الاختيار دون التفكير
.بالأمر بعمق إهانة لهما

196
00:13:09,940 --> 00:13:12,170
.لو أنا مكانك لاخترت رومي

197
00:13:12,520 --> 00:13:14,670
.أنت جشع جدًا

198
00:13:14,670 --> 00:13:17,120
.اختر الدرجات أم الفتاة

199
00:13:17,120 --> 00:13:19,550
.لا تسلب كلّ شيء لنفسك

200
00:13:19,550 --> 00:13:21,610
هل تزوجت من امرأة الكركي في حياتك الماضية؟

201
00:13:22,560 --> 00:13:25,620
.غضبت الآن. دعني ألكمك

202
00:13:25,620 --> 00:13:27,560
.ها نحن ثانيةً

203
00:13:27,560 --> 00:13:30,370
احتفظ ببعض الجليكوجين لعقلك
.وليس فقط لعضلاتك

204
00:13:30,370 --> 00:13:32,870
ما الذي يعجبك فيه يا رومي؟

205
00:13:33,750 --> 00:13:36,680
.لن يحميك إن حدث شيء بالتأكيد

206
00:13:36,680 --> 00:13:40,110
.أ-أجل... قالت ناوري شيئًا مشابهًا أيضًا

207
00:13:40,110 --> 00:13:40,910
!مهلك يا رومي

208
00:13:41,260 --> 00:13:46,010
.ولكنّه دائمًا ما يعطينا الأولويّة

209
00:13:46,460 --> 00:13:49,560
...حين أتشاجر مع ناوري، أو توبخني أمي

210
00:13:49,560 --> 00:13:51,680
.وحين شعرت بالإحباط، ساندني

211
00:13:52,480 --> 00:13:57,240
.قد يُهزم بسهولة، ولكنّه سيحميني

212
00:13:58,150 --> 00:13:58,890
أليس كذلك؟

213
00:13:59,220 --> 00:14:01,230
ماذا تعنين أنّي سأُهزم بسهولة؟

214
00:14:01,920 --> 00:14:04,540
.يضع القانون حدودًا على استخدام الشخص للقوّة

215
00:14:05,030 --> 00:14:09,230
،إن كنت لا تستطيع التفاهم
...فمن الأفضل الاعتماد على حالة

216
00:14:09,560 --> 00:14:11,660
.صحيح، سيُهزم بلحظة

217
00:14:11,660 --> 00:14:13,170
.اخرس

218
00:14:13,170 --> 00:14:15,900
.أنتما هكذا دائمًا

219
00:14:15,900 --> 00:14:16,740
ماذا؟

220
00:14:17,320 --> 00:14:20,500
...على أيّ حال، أردت أن أسأل

221
00:14:21,010 --> 00:14:23,010
لماذا أنت هنا؟

222
00:14:24,040 --> 00:14:27,400
وكيف عرفت أنّنا هنا؟

223
00:14:27,400 --> 00:14:28,340
...ميزوما، هل

224
00:14:28,340 --> 00:14:31,560
.لم أخبره. لكنّي أطلقت الشرارة الأولى

225
00:14:31,980 --> 00:14:33,970
.أردت معرفة مشاعره الحقيقيّة

226
00:14:33,970 --> 00:14:39,850
.حققت هدفك يا أنغو. أصبتني مباشرة بين العينين

227
00:14:40,210 --> 00:14:41,110
...وأيضًا

228
00:14:42,730 --> 00:14:44,730
.أخبرتني ناوري أنّك ستكونين هنا

229
00:14:44,730 --> 00:14:45,890
.عرفت ذلك

230
00:14:45,890 --> 00:14:47,460
.فهمت

231
00:14:47,460 --> 00:14:49,500
.أطلت البقاء

232
00:14:49,500 --> 00:14:51,070
.سأرجع

233
00:14:51,070 --> 00:14:53,810
.ماذا؟ أنا من عليه أن يغادر

234
00:14:53,810 --> 00:14:56,810
.احرص على إيصال رومي إلى المنزل

235
00:14:56,810 --> 00:14:58,860
...أنا عليّ أن

236
00:14:58,860 --> 00:15:02,370
.لا تقل هذا. ضع نفسك مكاني قليلًا

237
00:15:03,100 --> 00:15:04,760
.حسنًا. فهمت

238
00:15:08,410 --> 00:15:09,690
.إل اللقاء

239
00:15:14,130 --> 00:15:15,600
.أنسحب

240
00:15:15,600 --> 00:15:18,030
.نلت منّي. أعترف بالهزيمة

241
00:15:19,870 --> 00:15:23,270
.أود لعب مباراة انتقاميّة إلّم تمانعي

242
00:15:23,270 --> 00:15:26,090
.يا للمسكين. أشعر بالشفقة عليك

243
00:15:26,090 --> 00:15:28,320
.ولكن عليك أن تقدم لي شيئًا مقابل مباراة ثانية

244
00:15:28,320 --> 00:15:30,450
.العبي معه فحسب يا سينسي

245
00:15:30,450 --> 00:15:35,190
.لا بدّ أنّك تفكرين بعرض شرط مهين ما

246
00:15:35,640 --> 00:15:39,950
.ولكن تنازل فوروما-سينباي عن غرفة النادي لنا
.علينا أن نكون ممتنين

247
00:15:39,950 --> 00:15:44,920
لا يمكنك أن تطلبي منه أن يكون
.كرسيًا بشريًا أو يغير طريقة كلامه

248
00:15:46,370 --> 00:15:47,820
.سأفكر بالأمر

249
00:15:47,820 --> 00:15:49,500
.شكرًا جزيلًا لك على وقتك اليوم

250
00:15:49,870 --> 00:15:52,060
مهلك يا سينسي! إلى أين ستذهبين؟

251
00:15:52,060 --> 00:15:53,230
.الحمّام

252
00:15:53,230 --> 00:15:54,670
!سآتي أيضًا

253
00:15:54,670 --> 00:15:56,460
.يا لهما من حرّتين

254
00:15:56,460 --> 00:15:57,790
.صحيح

255
00:15:58,750 --> 00:16:01,380
ماذا نفعل الآن يا نياو-نياو؟

256
00:16:01,680 --> 00:16:04,100
.سأعود إلى المنزل وأستعد أولًا

257
00:16:04,100 --> 00:16:06,800
ماذا عنك؟ هل ستنتظرين مع الرئيسة؟

258
00:16:06,800 --> 00:16:11,230
لماذا لا تأتين إلى منزلي؟
.لنتناول العشاء هناك

259
00:16:11,230 --> 00:16:14,160
.أخبرتهم أنّك ستبيتين عندي على أيّ حال

260
00:16:14,160 --> 00:16:16,000
.معك حق. شيينا الحكيمة

261
00:16:16,000 --> 00:16:17,620
!امدحيني أكثر

262
00:16:17,620 --> 00:16:20,910
.ولكنّي أشعر بالشفقة على روميتشي قليلًا

263
00:16:20,910 --> 00:16:24,330
سمحت لرومي بأخذ جون-كن الآن، أليس كذلك؟

264
00:16:24,330 --> 00:16:25,900
.لذا فإنّنا متعادلتان

265
00:16:27,950 --> 00:16:29,560
.لا يزال معها

266
00:16:30,290 --> 00:16:32,760
.أترين؟ لا بأس على الإطلاق

267
00:16:32,760 --> 00:16:34,970
.لا داعي للتهاون

268
00:16:36,510 --> 00:16:38,560
في يوم عرض الألعاب الناريّة؟

269
00:16:39,100 --> 00:16:42,530
.كان الهرب أسهل من البحث عنهم لاحقًا

270
00:16:42,530 --> 00:16:44,640
.من المؤكد أننا كنا نبدو مشبوهين جدًا

271
00:16:44,640 --> 00:16:47,910
وجعلت الأمور أسوأ حين قلت
"أضعت أيضًا يا رومي؟"

272
00:16:48,260 --> 00:16:52,120
لولا أن موريواكي أسقط التاكوياكي وتسبب
.في تلك الفوضى، لكنا في ورطة كبيرة

273
00:16:52,120 --> 00:16:54,180
كيف تتذكرين هذا؟

274
00:16:54,180 --> 00:16:55,740
.أتذكر بالطبع

275
00:16:56,700 --> 00:16:57,990
.أتذكر

276
00:17:00,490 --> 00:17:01,760
هل نذهب؟

277
00:17:03,560 --> 00:17:04,400
.نعم

278
00:17:07,450 --> 00:17:08,130
ماذا؟

279
00:17:09,540 --> 00:17:11,010
ناوري ليست هنا؟

280
00:17:11,010 --> 00:17:14,220
.قالت أنّها ستبيت في منزل أماميا-سان مع كامي-تشان

281
00:17:14,220 --> 00:17:16,920
.أتت لأخذ ملابسها وغادرت فورًا

282
00:17:17,690 --> 00:17:19,640
.لم تخبرني

283
00:17:19,640 --> 00:17:22,030
.اشتريت كيلو من اللحم

284
00:17:22,030 --> 00:17:24,600
.جون-كن هنا، لذا لا بأس

285
00:17:24,600 --> 00:17:25,520
.أجل

286
00:17:31,000 --> 00:17:32,950
سنتناول العشاء مع جون اليوم

287
00:17:33,380 --> 00:17:36,150
.أعرف. لا أستطيع اليوم

288
00:17:36,560 --> 00:17:39,390
.رومي، استحمي بسرعة وتعالي لمساعدتي

289
00:17:40,470 --> 00:17:41,660
.حسنًا

290
00:17:43,370 --> 00:17:45,750
على ماذا تنوي؟

291
00:17:46,180 --> 00:17:48,340
هل استسلمت؟

292
00:17:48,340 --> 00:17:50,210
.لا، مستحيل

293
00:17:51,470 --> 00:17:53,050
.لا يهم

294
00:17:54,250 --> 00:17:58,460
.هي فقط من تعرف بماذا تفكر

295
00:17:58,820 --> 00:18:02,300
.حقًا؟ كان لدينا الكثير لنتحدث عنه

296
00:18:02,810 --> 00:18:04,910
لماذا أنت محبط إلى هذه الدرجة؟

297
00:18:04,910 --> 00:18:06,910
لحظة، لم تعرف أيضًا؟

298
00:18:06,910 --> 00:18:07,700
.لا

299
00:18:08,410 --> 00:18:09,900
أتريد الاتصال بها لاحقًا؟

300
00:18:09,900 --> 00:18:11,430
.لا، أستطيع الانتظار حتّى أراها

301
00:18:14,110 --> 00:18:15,180
أهذا بشأن ما حدث اليوم؟

302
00:18:15,540 --> 00:18:18,690
.نعم. أريد إخبار ناوري أيضًا

303
00:18:19,530 --> 00:18:21,960
...فهمت... ولكن

304
00:18:21,960 --> 00:18:23,280
.عدت

305
00:18:23,280 --> 00:18:25,200
.مساء الخير يا جون-كن

306
00:18:25,940 --> 00:18:28,320
.مساء الخير. أتيت لتناول العشاء

307
00:18:29,660 --> 00:18:32,960
.سنتناول الشابو شابو المبرد الليلة، بناءً على طلب جون

308
00:18:38,710 --> 00:18:42,730
!ما رأيكما؟ ألم أطبخه بشكل مثالي؟ إنّه فن

309
00:18:42,730 --> 00:18:45,750
!إنّه ليّن ولكن ليس مبللًا أبدًا

310
00:18:45,750 --> 00:18:47,310
أليس كذلك؟

311
00:18:47,310 --> 00:18:51,250
.جربي شرائح الثم أيضا يا نياو-نياو
.إنّها معدة بالمنزل

312
00:18:51,250 --> 00:18:52,110
.لا أريد اليوم

313
00:18:52,110 --> 00:18:55,220
.ولكنّك تحبينها يا سينسي

314
00:18:55,220 --> 00:18:57,400
.ولكن لا أريد اليوم

315
00:18:57,400 --> 00:18:58,350
ماذا؟

316
00:19:00,430 --> 00:19:03,960
شيينا-تشان، خذي اللحم وقدمي
.لها الطماطم النيئة

317
00:19:04,890 --> 00:19:09,260
،إن كنت قلقة بشأن رائحة الثوم
.فلا بدّ أنّ ثمة رجل بالأمر

318
00:19:09,260 --> 00:19:12,200
!أيّتها الخنزيرة المنحرفة الفاسقة

319
00:19:12,530 --> 00:19:16,900
،لحظة... لن أنكر طبيعتي المنحرفة

320
00:19:16,900 --> 00:19:19,590
!ولكني أنكر بشدة أن أكون خنزيرة فاسقة

321
00:19:19,860 --> 00:19:22,580
.صحيح، تنوين باتخاذ خطوة تجاه زاكي الليلة

322
00:19:22,580 --> 00:19:23,980
!لحظة! شيينا

323
00:19:24,250 --> 00:19:26,740
،لا أود أن أتركك تذهبين، ولكنّي أشجعك

324
00:19:26,740 --> 00:19:28,380
.سيمنحك الثوم الطاقة

325
00:19:28,380 --> 00:19:30,280
!لا يبدو أنّك تشجعينني هكذا

326
00:19:30,280 --> 00:19:33,370
.فهمت الأمر الآن

327
00:19:33,370 --> 00:19:34,880
.فظيعة. مشينة

328
00:19:34,880 --> 00:19:39,400
!هذا ما تقولينه، لكن بالنسبة لي، هذا وقت مصيري أيضًا

329
00:19:39,700 --> 00:19:41,880
لماذا لم تخبريني؟

330
00:19:41,880 --> 00:19:42,700
!أهذه هي مشكلتك؟

331
00:19:42,700 --> 00:19:46,160
!أتشعرين بالغيرة أيضًا يا ريريبون؟ يا لظرافتك

332
00:19:46,160 --> 00:19:46,980
.لكن لا

333
00:19:46,980 --> 00:19:49,200
!نياو-نياو لي

334
00:19:50,440 --> 00:19:51,310
...لأنّ

335
00:19:51,310 --> 00:19:56,090
لو أخبرتك، لكنت لتناديني ملكة
!جميلة ولكن خنزيرة منحرفة وفاسقة

336
00:19:56,090 --> 00:19:57,540
!وهذا ما فعلتِه

337
00:19:57,540 --> 00:19:59,920
انتظري. من أين أتيت بالملكة الجميلة؟

338
00:20:00,340 --> 00:20:04,670
.أفهم رغبتك في إثارة شهوته وما إلى ذلك

339
00:20:04,670 --> 00:20:07,880
!لا! أريد أن أذهب معك

340
00:20:07,160 --> 00:20:09,940
.تحول حفل نصرنا إلى حفل وداع

341
00:20:09,940 --> 00:20:12,390
هل يمكنك ألّا تجعلي الأمر يبدو حزينًا؟

342
00:20:12,390 --> 00:20:14,830
.لأنّنا نتحدث عن شيروساكي-كن

343
00:20:14,830 --> 00:20:18,140
.أستطيع تخيلك تعانين من متاعب مختلفة

344
00:20:18,140 --> 00:20:21,360
.أخبرتك أنّ هذا وقت مصيري بالنسبة لي

345
00:20:21,360 --> 00:20:24,580
أظننت أّي سأذهب دون خطة؟

346
00:20:24,580 --> 00:20:27,600
.آمل ألّا تضطري للانسحاب بسرعة

347
00:20:29,190 --> 00:20:32,300
،غالبًا ما يتم السخرية من أفلام الخيال العلمي اليابانية

348
00:20:32,300 --> 00:20:35,330
.ولكنني أعتقد أن هذا الفيلم يُعد تحفة كلاسيكية

349
00:20:35,330 --> 00:20:37,470
.لم أشاهده من قبل

350
00:20:37,470 --> 00:20:41,990
.يذكرني بـ شين غودزيلا، ولكن هذا الأصل على ما أظن

351
00:20:41,990 --> 00:20:44,350
.إنّه ينفصل عن فئة توكوساتسو

352
00:20:44,650 --> 00:20:47,310
جون، أتريد أن نذهب إلى البقالة؟

353
00:20:47,770 --> 00:20:48,460
ماذا؟

354
00:20:49,340 --> 00:20:50,190
.حسنًا

355
00:20:51,040 --> 00:20:53,710
.اشتري حليبًا بهذه الحالة

356
00:20:53,710 --> 00:20:55,090
.مفهوم

357
00:20:55,090 --> 00:20:58,230
.رومي، يبدو أنّك بدأت تصبحين أنانيّة مثل ناوري

358
00:20:58,230 --> 00:21:01,770
.أنا ذاهبة لقضاء حاجة. لا تعتبرني مثلها

359
00:21:02,120 --> 00:21:04,520
.حتّى إنكارك بدأ يشبه إنكارها

360
00:21:04,520 --> 00:21:06,510
.اصمت فحسب

361
00:21:06,510 --> 00:21:07,500
.هيّا، لنذهب

362
00:21:08,760 --> 00:21:12,260
أثمة ما تريده يا جون؟
.سأشتريه لك كعربون شكر

363
00:21:12,940 --> 00:21:15,380
.ظننت أنّك أردت شيئًا

364
00:21:16,110 --> 00:21:18,240
.أردت التحدث معك لوحدنا فحسب

365
00:21:18,990 --> 00:21:22,260
.لكنّي أشعر أنّنا تحدثنا كثيرًا اليوم

366
00:21:23,170 --> 00:21:24,350
.كان ذلك ممتعًا

367
00:21:25,330 --> 00:21:26,980
أكان ذلك ممتعًا بالنسبة لك؟

368
00:21:27,350 --> 00:21:28,950
ما خطبك فجأة؟

369
00:21:28,950 --> 00:21:30,960
.أسألك ما إن كنت استمتعت

370
00:21:31,520 --> 00:21:32,870
.استمتعت

371
00:21:33,530 --> 00:21:34,490
.جيّد

372
00:21:43,650 --> 00:21:46,490
.سأشعر بألم في كل أنحاء جسمي غدًا

373
00:21:46,490 --> 00:21:49,220
.حقًا؟ لم تمش كثيرًا

374
00:21:49,700 --> 00:21:52,010
ركضت حتّى الحديقة فحسب، أليس كذلك؟

375
00:21:53,580 --> 00:21:54,490
.صحيح

376
00:21:55,360 --> 00:21:58,510
.عليك أن تتمرن قليلًا

377
00:21:58,510 --> 00:22:01,020
.لا، لن أفعل ذلك

378
00:22:01,020 --> 00:22:04,240
.قررت أن أعيش حياة خاليةً من الركض

379
00:22:04,240 --> 00:22:05,030
.يا إلهي

380
00:22:05,560 --> 00:22:08,520
.أنت تكره التمرن حقًا

381
00:22:08,520 --> 00:22:10,480
...لا بأس، لن أقترح الأمر عليك

382
00:22:10,850 --> 00:22:12,120
.كثيرًا

383
00:22:12,770 --> 00:22:16,220
.شكرًا لك على كلّ شيء اليوم. تصبح على خير

384
00:22:16,650 --> 00:22:17,780
.تصبحين على خير

385
00:23:23,650 --> 00:23:25,270
.اهدأ

386
00:23:27,380 --> 00:23:31,490
لماذا أنت هنا؟ ألم تكوني في منزل أماميا؟

387
00:23:31,490 --> 00:23:32,670
.عدت

388
00:23:32,670 --> 00:23:34,300
أحدث أمر ما؟

389
00:23:35,460 --> 00:23:36,380
ما الخطب؟

390
00:23:38,120 --> 00:23:39,170
.دعني أبيت عندك