1
00:00:02,170 --> 00:00:06,980
لا أظنّني فهمتُ جيّدًا من قبل

2
00:00:06,980 --> 00:00:10,990
.ما أعرفه وما أجهله

3
00:00:11,840 --> 00:00:17,910
لا أعرف حتّى ما الّذي أجهله
.بشأن الرّجال

4
00:00:17,910 --> 00:00:19,650
.أنا فقط لا أفهم حقًّا

5
00:00:22,760 --> 00:00:24,500
سيغي-كن، هل تنصت؟

6
00:00:26,850 --> 00:00:28,470
ألم يحن الوقت؟

7
00:00:31,210 --> 00:00:33,840
.سأذهب إلى مقابلة زواجي

8
00:02:24,220 --> 00:02:26,940
هل أبليتَ سيّئًا في امتحانٍ ما؟

9
00:02:27,340 --> 00:02:30,250
ترسمُ ملامحًا على وجهك
.وكأنّ العالم سيهلك

10
00:02:32,620 --> 00:02:34,840
.اقتلني فحسب

11
00:02:39,200 --> 00:02:42,340
.تانيموتو-سان ذاهبة إلى مقابلة زواج

12
00:02:43,570 --> 00:02:45,960
.بل أظنّها وصلت بالفعل

13
00:02:46,540 --> 00:02:49,890
...ما يعني أنّني لا أملك فرصة

14
00:02:49,890 --> 00:02:53,860
أخاطر بكلّ شيء؟ لا أملك أيّ شيء
...أخاطر به من الأساس

15
00:02:56,470 --> 00:02:59,110
هلاّ احتفظت بهذا لفترة؟

16
00:03:02,530 --> 00:03:05,370
هل تعرف كلمات مكيافيلي؟

17
00:03:05,370 --> 00:03:06,810
مكيافيلي؟

18
00:03:06,810 --> 00:03:13,750
يندم المرء على ما لم يفعل
.أكثر من على ما فعل

19
00:03:19,380 --> 00:03:21,130
!إنّهما جميلان

20
00:03:21,760 --> 00:03:24,260
.كلاهما حجران لهما صلة بالبحر

21
00:03:25,770 --> 00:03:29,770
.يُدعى اللاّزورد أحيانًا بـ"أولترامارين" أيضًا

22
00:03:30,220 --> 00:03:33,410
.مارين" تعني البحر، و"أولترا" تعني ما وراء"

23
00:03:33,410 --> 00:03:34,700
أولترا؟

24
00:03:34,700 --> 00:03:35,860
.نعم

25
00:03:35,860 --> 00:03:39,550
اللاّزورد الّذي تمّ إحضاره
من أفغانستان إلى أوروبا

26
00:03:39,550 --> 00:03:43,300
."كان "الأزرق الّذي أتى من وراء البحر

27
00:03:43,300 --> 00:03:45,070
.فهمت

28
00:03:45,970 --> 00:03:50,930
تمّ استخراج هذا الزّبرجد
.في سانتا في البرازيل

29
00:03:52,020 --> 00:03:55,650
.ويعني اسم الحجر "ماء البحر" باللاّتينية

30
00:03:55,650 --> 00:03:59,390
استخدم البحّارة الزّبرجد كتميمة
.حظّ منذ أقدم العصور

31
00:04:00,650 --> 00:04:05,530
،إضافةً إلى دلالتها على الحظّ الجيّد
.إلاّ أنّها تُدعى أيضًا بحجر الملاك

32
00:04:06,580 --> 00:04:08,480
...ملاك

33
00:04:08,480 --> 00:04:10,220
.إنّها ممتازة من أجل تانيموتو-سان

34
00:04:12,750 --> 00:04:16,610
"هل عرفتَ أنّ "إيترانجي
يعرض خصمًا للموظّفين؟

35
00:04:19,420 --> 00:04:20,530
!سأشتريه

36
00:04:30,210 --> 00:04:31,080
.سيغي

37
00:04:32,260 --> 00:04:34,470
هل أنت متفرّغ اللّيلة؟

38
00:04:34,470 --> 00:04:36,740
.نعم، أنا متفرّغ

39
00:04:39,760 --> 00:04:42,510
.إذًا، سأدعوك على العشاء

40
00:04:44,530 --> 00:04:47,470
.يا لك من شخصٍ طيّب

41
00:04:47,470 --> 00:04:49,500
.لكن سأعتذر اللّيلة

42
00:04:49,500 --> 00:04:50,560
.فهمت

43
00:04:50,560 --> 00:04:54,390
...شكرًا. أقدّر لك تفكيرك حقًّا، لكن

44
00:04:54,390 --> 00:04:56,770
.لا تقلق بشأن ذلك

45
00:05:12,020 --> 00:05:12,830
ماذا؟

46
00:05:14,110 --> 00:05:16,080
هومورا-سان؟

47
00:05:19,160 --> 00:05:21,230
.يسعدني أن أراه بخير

48
00:05:26,800 --> 00:05:29,470
ما الّذي... تفعله تانيموتو-سان هنا؟

49
00:05:37,540 --> 00:05:39,690
ناكاتا-كن، صحيح؟

50
00:05:39,690 --> 00:05:42,450
.هذا أنا، هومورا. لم أرك منذ مدّة

51
00:05:42,450 --> 00:05:43,650
.مرحبًا

52
00:05:44,170 --> 00:05:46,240
.شكرًا على مساعدتك في ذلك اليوم

53
00:05:46,610 --> 00:05:47,640
.لا عليك

54
00:05:48,360 --> 00:05:49,940
...عذرًا يا هومورا-سان

55
00:05:49,940 --> 00:05:50,740
نعم؟

56
00:05:53,070 --> 00:05:55,160
.لا... لا شيء

57
00:05:57,540 --> 00:06:00,670
أنا هو الشّخص الّذي كانت
.تلتقي به شوكو-تشان

58
00:06:02,120 --> 00:06:06,390
.أخبرتني أنّكما صديقان من المدرسة

59
00:06:06,870 --> 00:06:08,300
.فاجأني ذلك

60
00:06:08,300 --> 00:06:10,800
شوكو-تشان"؟"

61
00:06:11,070 --> 00:06:14,540
.كنتُ أعرفها منذ وقتٍ طويل

62
00:06:14,540 --> 00:06:16,310
.وكان آباؤنا أصدقاء

63
00:06:16,310 --> 00:06:20,160
.كان آباؤنا أصدقاء
.وكان يلهو معي كثيرًا

64
00:06:21,650 --> 00:06:23,860
.نعم، ذكرت ذلك

65
00:06:23,860 --> 00:06:26,780
أعلم أنّها قالت أنّها سعيدة
لامتلاكها صديقًا

66
00:06:26,780 --> 00:06:29,100
،تناقش معه بشأن مقابلة الزّواج

67
00:06:29,420 --> 00:06:31,600
لكنّها أخبرتك بذلك أيضًا؟

68
00:06:31,910 --> 00:06:35,370
لقد تفاجأت. لم أستطع أن أصدّق أنّ
.لدى طالبة في الجامعة مقابلة زواج

69
00:06:36,120 --> 00:06:39,120
،والداي متحمّسان بشأن ذلك
.لكنّي لستُ كذلك

70
00:06:40,040 --> 00:06:43,090
ماذا عن تانيموتو-سان؟ كيف تشعر؟

71
00:06:43,720 --> 00:06:46,570
لِمَ لا تسألها بنفسك؟

72
00:06:47,430 --> 00:06:49,280
.حسنٌ، سأذهب

73
00:06:49,740 --> 00:06:51,680
.آسف على تأخيرك

74
00:07:02,240 --> 00:07:03,650
سيغي-كن، هل تنصت؟

75
00:07:06,820 --> 00:07:08,550
ألم يحن الوقت؟

76
00:07:10,980 --> 00:07:12,730
.حسنًا، سأذهب

77
00:07:16,290 --> 00:07:18,540
...انتظري يا تانيموتو-سان

78
00:07:24,400 --> 00:07:25,790
!لا تذهبي

79
00:07:35,060 --> 00:07:36,550
...مجرّد حلم

80
00:07:57,950 --> 00:07:59,630
!تانيموتو-سان

81
00:08:00,050 --> 00:08:01,580
.سيغي-كن

82
00:08:02,970 --> 00:08:06,130
.سمعتُ أنّك تعرف هومورا-سان

83
00:08:06,130 --> 00:08:08,080
.يا لها من مفاجأة

84
00:08:08,080 --> 00:08:09,950
...صحيح

85
00:08:11,160 --> 00:08:12,340
سيغي-كن؟

86
00:08:12,340 --> 00:08:15,480
...تانيموتو-سان

87
00:08:17,950 --> 00:08:22,230
...بشأن هومورا-سان
هل ترغبين الزّواج منه حقًّا؟

88
00:08:24,580 --> 00:08:25,560
لماذا؟

89
00:08:25,560 --> 00:08:29,570
...لماذا؟ لأنّ

90
00:08:30,020 --> 00:08:36,030
...أظنّ أنّه يمكنك القول
.أنّني قلق بشأنك

91
00:08:39,290 --> 00:08:44,460
لا أدري ما يعنيه أن تكون
.المرأة مع رجل حقًّا

92
00:08:45,430 --> 00:08:47,430
.أنا معجبة بهومورا-سان

93
00:08:47,430 --> 00:08:50,210
.مثل إعجابي بأبي وأمّي

94
00:08:50,480 --> 00:08:54,340
لكن لا أدري ما يعنيه أن تُعجب
.بشخصٍ بطريقةٍ أخرى

95
00:08:56,230 --> 00:08:58,930
،أخبرني شخصٌ اعتربتُه صديقًا ذات مرّة

96
00:08:58,930 --> 00:09:02,720
أنا معجب بك. اخرجي معي"
".في موعد رجاءً

97
00:09:03,610 --> 00:09:08,770
،كنّا مستمتعين كثيرًا كوننا صديقين
.لكن أظنّ أنّ ذلك لم يكن كافيًا

98
00:09:10,050 --> 00:09:11,780
،لكن، فور أن أتزوّج

99
00:09:12,360 --> 00:09:16,660
لن أحتاج للقلق بشأن الرّومانسيّة
بعد ذلك، صحيح؟

100
00:09:17,470 --> 00:09:19,910
.لذا أريد أن أتزوّج

101
00:09:21,690 --> 00:09:23,440
أنا الأسوأ، أليس كذلك؟

102
00:09:25,140 --> 00:09:30,990
أحيانًا أرى نفسي كحجر كريم
.وُضعَ للعرض بالخطأ

103
00:09:31,850 --> 00:09:35,760
بين البيريل، ثمّة الزّبرجد
،الّذي يحتوي على الحديد

104
00:09:35,760 --> 00:09:37,950
،والزّمرّد الّذي يحتوي على الكروم

105
00:09:37,950 --> 00:09:41,220
والغوشينايت الّذي لا يحتوي
على أيّ شيء، صحيح؟

106
00:09:41,530 --> 00:09:47,190
لكن بدون ألوان، يبدو الزّبرجد
،الشّفّاف والغوشينايت متشابهين

107
00:09:47,670 --> 00:09:51,730
بحيث أنّ الغوشينايت يوضع
...للعَرض أحيانًا على أنّه زبرجد

108
00:09:52,650 --> 00:09:56,800
مع أنّه بيريل مختلف تمامًا
.لا يحتوي على الحديد

109
00:09:58,060 --> 00:10:00,340
تمامًا كاختيار المرء ألاّ يقع في الحبّ

110
00:10:00,340 --> 00:10:04,450
.مختلف عن عدم فهمه من الأساس

111
00:10:09,640 --> 00:10:13,870
،ربّما هكذا يسري الحبّ
.لكن أظنّ أنّ الزّواج مختلف

112
00:10:15,360 --> 00:10:18,360
.أمّي مطلّقة

113
00:10:18,860 --> 00:10:20,930
.كان أبي شخصًا فظيعًا

114
00:10:21,630 --> 00:10:25,520
تزوّجت للمرّة الثّانية الآن، لكن أظنّها
.فعلت ذلك لأجلي على الأغلب

115
00:10:26,760 --> 00:10:29,390
أظنّ أنّ لا بأس لبعض الأزواج
.أن يكونوا هكذا

116
00:10:29,390 --> 00:10:32,770
...إن قال أحدٌ خلاف ذلك، إذًا

117
00:10:33,960 --> 00:10:35,400
إذًا؟

118
00:10:35,920 --> 00:10:37,400
...إذًا، فإنّه

119
00:10:42,650 --> 00:10:46,240
لا بد أنّه من النّوع الّذي يقول
.أنّ جميع الأحجار الكريمة مماثلة

120
00:10:46,860 --> 00:10:48,870
.مع أنّ جميعها فريد من نوعه

121
00:10:50,260 --> 00:10:53,920
هل تذكر ما قلته بشأني يا سيغي-كن؟

122
00:10:54,290 --> 00:10:55,670
...أنت رائعة

123
00:10:56,370 --> 00:11:00,720
جعلني ذلك أسعد بكثير
.من دعوتي بظريفة أو جميلة

124
00:11:03,010 --> 00:11:04,790
.أتمنّى لك كلّ التّوفيق

125
00:11:07,250 --> 00:11:09,300
.شكرًا لك يا سيغي-كن

126
00:11:18,450 --> 00:11:20,400
.قرّرتُ أن أدعمها

127
00:11:22,060 --> 00:11:23,410
تدعم من؟

128
00:11:23,690 --> 00:11:27,150
سأدعم مقابلات الزّواج الخاصّة
.بتانيموتو-سان

129
00:11:27,150 --> 00:11:29,040
.ذلك للأفضل حقًّا

130
00:11:29,440 --> 00:11:31,830
أيمكنني أن أشاركك رأيي؟

131
00:11:32,370 --> 00:11:33,480
.تفضّل

132
00:11:35,040 --> 00:11:36,090
.أنت أحمق

133
00:11:38,650 --> 00:11:40,470
.قل ما شئت

134
00:11:41,360 --> 00:11:43,120
.حسمتُ أمري بالفعل

135
00:11:43,460 --> 00:11:48,600
.أفضل ما يمكنني فعله ليس طلب مواعدتها

136
00:11:48,890 --> 00:11:53,700
إنّها تواعد هومورا-سان
.من متحف العلوم الآن

137
00:11:53,700 --> 00:11:55,190
.هذا للأفضل

138
00:11:56,800 --> 00:12:00,580
،إن كنتَ متفرّغًا اليوم يا ريتشارد
.دعنا نخرج سويًّا

139
00:12:03,310 --> 00:12:05,240
...أظنّك ستطلب بارفيه

140
00:12:11,840 --> 00:12:16,070
سيغي، دعني أروي لك قصّةً
.مثيرة للاهتمام

141
00:12:16,070 --> 00:12:18,730
هل تتجاهلني؟

142
00:12:18,730 --> 00:12:22,730
،قبل وقتٍ طويل، في مكانٍ ما في إنجلترا

143
00:12:22,730 --> 00:12:26,070
.كان هنالك ولدٌ بوجهٍ في غاية الجمال

144
00:12:28,350 --> 00:12:31,020
،مهما فعل

145
00:12:31,020 --> 00:12:37,230
حلّت عليه لعنة أن يكون
.وجهه حديث النّاس دائمًا

146
00:12:43,290 --> 00:12:47,180
.في أحد الأيام، التقى بفتاة

147
00:12:48,200 --> 00:12:50,660
.التقيا في القسم اليابانيّ

148
00:12:50,660 --> 00:12:54,210
بعد أن رأت ذلك الولد وهو مهمومٌ
،بوجهه، قالت له بكلّ صراحة

149
00:12:55,340 --> 00:12:57,330
."لا تقلق بشأنه"

150
00:12:58,080 --> 00:13:00,230
.لم يلتقِ أيّ أحد مثلها من قبل

151
00:13:02,920 --> 00:13:06,900
.وسرعان ما وقع في حبّها

152
00:13:07,870 --> 00:13:12,720
:لكنّ الولد كان يملك لعنةً ثانية

153
00:13:13,500 --> 00:13:17,510
.ميراث جدّه الأكبر

154
00:13:18,770 --> 00:13:22,900
،وهي تواجه تلك الثّروة الهائلة
:قالت الفتاة

155
00:13:23,440 --> 00:13:27,410
أخشى أنّني سأختار المال"
".إن حدث مكروه ما

156
00:13:27,410 --> 00:13:31,350
أفضّل أن أنفصل عنك على"
".أن أكون هكذا شخص

157
00:13:36,930 --> 00:13:42,550
،سؤالي لك: إن كنتَ محلّه
كيف كنت ستجيبها؟

158
00:13:44,080 --> 00:13:48,800
كنتُ لأودّ أن أخبرها ألاّ تقلق بشأن
.ذلك وأن تظلّ معي إلى الأبد

159
00:13:49,760 --> 00:13:51,760
...لكن يصعب قول ذلك

160
00:13:51,760 --> 00:13:52,760
.بالفعل

161
00:13:53,330 --> 00:13:57,770
،لكن حتّى دون وجود الميراث
،إن أرادت الانفصال

162
00:13:57,770 --> 00:14:01,020
كان ليجعله التّشبّث بها
.أكثر بؤسًا ليس إلاّ

163
00:14:01,980 --> 00:14:05,400
.بالتّالي، اختار الصّمت

164
00:14:05,810 --> 00:14:08,280
لم يقل أيّ شيء؟

165
00:14:08,820 --> 00:14:13,910
.لهذا شاركتك كلمات مكيافيلي ذلك اليوم

166
00:14:15,320 --> 00:14:19,540
نندم على الأشياء الّتي لم نفعلها
.أكثر من الأشياء الّتي فعلناها

167
00:14:19,540 --> 00:14:20,770
.صحيح

168
00:14:22,690 --> 00:14:28,820
إن كنتُ مكانك، لأسرعتُ إليها
.بدل الجلوس هنا

169
00:14:29,990 --> 00:14:35,390
،هل تُدرك؟ أنت تثني على مظهري غالبًا

170
00:14:35,730 --> 00:14:38,360
لكنّك تواجه مشاكلاً
في التّعبير عن إحساسك

171
00:14:38,360 --> 00:14:41,470
تجاه الأشخاص الّذين لا تريد
.منهم أن ينفروا منك

172
00:14:42,400 --> 00:14:46,400
ذكرتَ سابقًا أنّك تخاف
.من أن ينفر منك النّاس

173
00:14:46,800 --> 00:14:48,870
لكن ألم يمضِ ما يكفي من الوقت؟

174
00:14:48,870 --> 00:14:52,460
.حان الوقت لكي تنسى بطل العدالة الجبان

175
00:14:54,120 --> 00:14:57,790
.سيغي، تخلّ عن الغطرسة والعار

176
00:14:58,580 --> 00:15:03,270
ألستَ الرّجل الّذي يتبع قلبه
ويحتضن تدخّلاته الفطريّة

177
00:15:03,270 --> 00:15:10,130
لأجل قيادة النّاس الّذين من حوله
إلى مستقبل مشرق؟

178
00:15:12,180 --> 00:15:14,280
.اذهب إلى متحف العلوم

179
00:15:19,020 --> 00:15:23,440
.أنا معجب بك حقًّا

180
00:15:25,610 --> 00:15:29,280
.وأنا معجب بك كثيرًا أيضًا يا سيغي

181
00:15:29,280 --> 00:15:31,950
.ومسرور لأنّني التقيتُ بك

182
00:15:31,950 --> 00:15:35,940
.ذلك شيءٌ لم يتغيّر منذ لحظة لقائنا

183
00:15:37,390 --> 00:15:40,500
،إن كنتَ لا تزال في المحلّ حينما أنتهي
.سأعود بأقصى سرعتي

184
00:15:40,870 --> 00:15:43,770
.ادعوها على العشاء على الأقلّ

185
00:15:43,770 --> 00:15:44,720
.نعم

186
00:16:06,450 --> 00:16:08,270
...أخبرني ريتشارد ذات مرّة

187
00:16:09,390 --> 00:16:16,940
أنّ الأحجار الكريمة تقود النّاس
.إلى الإجابات الّتي يبتغونها حقًّا

188
00:16:24,370 --> 00:16:26,040
ماذا؟ سيغي-كن؟

189
00:16:31,130 --> 00:16:33,630
.شوكو-تشان، سأذهب لإجراء اتّصال

190
00:16:33,630 --> 00:16:34,820
.حسنًا

191
00:16:36,850 --> 00:16:38,970
.يا لها من مفاجأة

192
00:16:40,540 --> 00:16:42,980
...تانيموتو-سان، أنا

193
00:16:44,720 --> 00:16:49,350
ذلك اليوم، أخبرتك أنّني أظنّ أنّه
.لا بأس لبعض الأزواج أن يكونوا كذلك

194
00:16:49,850 --> 00:16:53,260
.وأنّني سأدعم قرارك

195
00:16:53,260 --> 00:16:55,490
.لكن أنا آسف... لا أستطيع في النّهاية

196
00:16:55,780 --> 00:16:57,350
سيغي-كن؟

197
00:17:08,010 --> 00:17:09,500
...زبرجد

198
00:17:10,560 --> 00:17:13,510
.كنتُ منتظرًا منحك إيّاه

199
00:17:13,510 --> 00:17:15,190
إيّاي؟

200
00:17:15,190 --> 00:17:16,080
.نعم

201
00:17:16,860 --> 00:17:19,850
،في اللّحظة الّتي أراني إيّاه ريتشارد

202
00:17:20,320 --> 00:17:23,310
.فكّرتُ أنّه يناسبك بشكلٍ مثاليّ

203
00:17:24,100 --> 00:17:27,330
.أنت مثل الملاك

204
00:17:30,340 --> 00:17:33,940
.هكذا أنت بالنّسبة لي

205
00:17:35,570 --> 00:17:39,690
سيغي-كن، أتقصد أنّك تراني هكذا؟

206
00:17:39,700 --> 00:17:40,690
.نعم

207
00:17:41,060 --> 00:17:44,500
.لا أظنّ أنّ كلّ الأحجار الكريمة مماثلة

208
00:17:44,940 --> 00:17:50,820
،لكن في المستقبل القريب
.قد تجدين شخصًا تعجبين به

209
00:17:51,410 --> 00:17:54,260
.وقد تودّين أن تقعي في الحبّ

210
00:17:55,620 --> 00:17:58,320
.لا أظنّك بحاجة لأن تتخلّي عن ذلك بعد

211
00:17:59,210 --> 00:18:02,350
...لذا... لذا أنا

212
00:18:02,720 --> 00:18:07,100
.لا أريدك أن تتزوجي

213
00:18:15,490 --> 00:18:21,950
كنتُ لأرفضه غالبًا إن عُرضَ عليّ
.من شخصٍ آخر

214
00:18:23,660 --> 00:18:26,370
...لكن بما أنّه أنت يا سيغي-كن

215
00:18:30,090 --> 00:18:32,090
.أريد أن أشكرك

216
00:18:34,090 --> 00:18:37,340
.أنت بطل العدالة حقًّا

217
00:18:40,770 --> 00:18:44,430
سيغي-كن، هل تذكر حينما تقابلنا أوّل مرّة؟

218
00:18:44,430 --> 00:18:47,350
.بالطّبع

219
00:18:47,690 --> 00:18:52,110
حينما تكون الأمور لا تسري
،بخير بالنّسبة لي أو أنّي محتارة

220
00:18:52,110 --> 00:18:54,720
.أودّ أن أساعد المحتاجين

221
00:18:54,720 --> 00:19:00,200
تظاهرتُ بكوني شخصًا طيّبًا
.لأشعر بشكلٍ أفضل تجاه نفسي

222
00:19:00,690 --> 00:19:04,030
لكن لك أن تتخيّل دهشتي حينما
."قابلتُ شخصًا طيّبًا "بالفعل

223
00:19:06,960 --> 00:19:10,710
،طيبتي ناجمة عن الرّضى النّفسيّ
.لكنّك مختلف

224
00:19:11,440 --> 00:19:17,050
أنت شخصٌ يسمع صرخات النّجدة
.ويمدّ يده للمساعدة

225
00:19:17,050 --> 00:19:18,930
...لستُ

226
00:19:18,930 --> 00:19:23,690
سيغي-كن، تذكّرتَ ما قلتُه
ذلك اليوم، أليس كذلك؟

227
00:19:25,460 --> 00:19:28,840
،بعد حديثي بشأنه

228
00:19:28,840 --> 00:19:33,730
شعرتُ أنّني لم أستطع الزّواج
.لأهرب من شيء

229
00:19:34,000 --> 00:19:36,900
.إن فعلتُ ذلك، ما كنتُ لأحبّ نفسي

230
00:19:37,260 --> 00:19:38,990
.وما كنتُ لأسامح نفسي

231
00:19:39,780 --> 00:19:41,000
...لذا

232
00:19:41,360 --> 00:19:42,440
لذا؟

233
00:19:43,210 --> 00:19:45,530
.سأرفض هومورا-سان

234
00:19:46,610 --> 00:19:49,790
.ساعدتني على إدراك مشاعري

235
00:19:53,120 --> 00:19:55,290
.شكرًا لك يا سيغي-كن

236
00:20:06,450 --> 00:20:09,850
.أنت رائعة حقًّا يا تانيموتو-سان

237
00:20:12,190 --> 00:20:14,930
.أنت جبان

238
00:20:15,860 --> 00:20:18,440
.أعلم. أكره نفسي

239
00:20:19,230 --> 00:20:22,370
في المرّة القادمة، من الأفضل
.أن تخبرها أنّك معجب بها

240
00:20:25,170 --> 00:20:29,580
بالمناسبة، تلقّيتُ اتّصالاً
.من ريتشارد-سان ذلك اليوم

241
00:20:30,490 --> 00:20:33,320
إلى أين هو ذاهب؟

242
00:20:33,320 --> 00:20:36,580
أين؟ ماذا تقصد؟

243
00:20:37,020 --> 00:20:40,710
ألن يُغلق "إيترانجي" لفترة بدءًا من الغد؟

244
00:20:41,450 --> 00:20:43,580
إيترانجي" سيُغلق؟"

245
00:20:44,240 --> 00:20:46,220
.لم أسمع عن ذلك

246
00:20:47,600 --> 00:20:49,850
.يجب أن تتّصل بالمحلّ

247
00:20:57,000 --> 00:20:58,050
.هذا سيغي

248
00:20:58,050 --> 00:20:59,170
كيف سار الأمر؟

249
00:20:59,170 --> 00:21:03,520
.لم يسر بشكل فظيع

250
00:21:03,520 --> 00:21:07,760
،فشلتُ في دعوتها على العشاء
.لكن سأخبرك بالأمر حينما أعود

251
00:21:07,760 --> 00:21:09,950
.لست بحاجةٍ للعودة اليوم

252
00:21:10,270 --> 00:21:12,070
ماذا؟ لِمَ لا؟

253
00:21:12,070 --> 00:21:16,580
،بالتّفكير في الأمر
.إنّنا نعرف بعضنا منذ فترة

254
00:21:16,840 --> 00:21:19,130
ماذا؟ ماذا تقول؟

255
00:21:19,640 --> 00:21:22,640
.دفعتُ راتبك بالكامل

256
00:21:22,640 --> 00:21:24,720
.لا تقلق بشأن الباقي

257
00:21:25,240 --> 00:21:26,960
عمّ تتحدّث؟

258
00:21:26,960 --> 00:21:28,660
...وشيءٌ أخير

259
00:21:28,660 --> 00:21:30,340
.انتظر

260
00:21:30,340 --> 00:21:32,220
.أنا في طريق عودتي إلى المحلّ الآن

261
00:21:41,500 --> 00:21:44,070
.أنت تثق في النّاس كثيرًا

262
00:21:45,060 --> 00:21:50,780
.سيؤذيك ذلك أحيانًا، لكن هذه سنّة الحياة

263
00:21:50,780 --> 00:21:52,950
.تذكّر ذلك

264
00:21:53,250 --> 00:21:54,720
.الوداع

265
00:21:54,720 --> 00:21:58,440
الرّقم الّذي اتّصلتم به إمّا
خارج نطاق الخدمة

266
00:21:58,440 --> 00:22:00,150
.أو مُغلق

267
00:22:00,150 --> 00:22:01,880
...ذاك الأحمق