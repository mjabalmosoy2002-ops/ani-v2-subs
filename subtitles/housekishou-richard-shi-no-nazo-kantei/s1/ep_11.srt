1
00:00:12,520 --> 00:00:13,890
.دعيني أحملها عنك

2
00:00:18,330 --> 00:00:19,930
...لكن

3
00:02:01,240 --> 00:02:02,580
.مِن هنا

4
00:02:02,580 --> 00:02:04,470
.آسف على تكليفك

5
00:02:04,770 --> 00:02:06,330
ماذا تقول؟

6
00:02:06,330 --> 00:02:10,150
ستعاقبني الآلهة بكلّ تأكيد إلّم
.أعزمك على بعض الشّاي على الأقلّ

7
00:02:22,640 --> 00:02:23,620
ماذا؟

8
00:02:23,620 --> 00:02:25,310
...أليس هذا

9
00:02:26,880 --> 00:02:28,630
.شكرًا على الانتظار

10
00:02:35,830 --> 00:02:37,720
هل تحبّ هوغو؟

11
00:02:38,690 --> 00:02:41,310
.أنا بصدد قراءة هذا الكتاب الآن بتوصية

12
00:02:41,310 --> 00:02:44,680
وصلتُ إلى الجزء الّذي يسرق
.فيه الآنية الفضّيّة

13
00:02:44,680 --> 00:02:48,060
.أشعر بالأسى حقًّا تجاه البطل

14
00:02:48,900 --> 00:02:53,120
إنّ كلّ من يشعر بالأسى على جان
فالجان قبل لقائه مع الأسقف

15
00:02:53,120 --> 00:02:54,570
.لا يُعدّ شخصًا طالحًا

16
00:02:56,480 --> 00:03:00,860
إنّ كلّ من يشعر بالأسى على جان
فالجان قبل لقائه مع الأسقف

17
00:03:00,860 --> 00:03:02,660
.لا يُعدّ شخصًا طالحًا

18
00:03:05,770 --> 00:03:07,970
هل يوجد شيء على وجهي؟

19
00:03:07,970 --> 00:03:09,240
.لا

20
00:03:12,100 --> 00:03:13,200
...البودينغ

21
00:03:14,040 --> 00:03:17,310
ألا تحبّ البودينغ؟

22
00:03:17,310 --> 00:03:19,220
.بلى، أحبّه

23
00:03:20,700 --> 00:03:22,100
.شكرًا على العزيمة

24
00:03:27,140 --> 00:03:30,050
هذا ليس سكّرًا عاديًّا، أليس كذلك؟

25
00:03:30,050 --> 00:03:31,920
.أنا مندهشة لأنّك عرفت

26
00:03:32,830 --> 00:03:37,400
إنّه عسل... لا، سكّر أسود؟

27
00:03:38,130 --> 00:03:39,740
.أحسنت

28
00:03:39,740 --> 00:03:40,780
ما...؟

29
00:03:40,780 --> 00:03:43,590
.آسفة. يصعب التّخلّص من العادات القديمة

30
00:03:44,190 --> 00:03:47,240
،على خلاف مظهري الآن
.فقد كنتُ أستاذة

31
00:03:47,240 --> 00:03:48,350
حقًّا؟

32
00:03:48,350 --> 00:03:51,800
.كنتُ مدرّسة خاصّة قبل أن أصبح أستاذة

33
00:03:51,800 --> 00:03:56,590
دائمًا ما كنتُ أخبر الأطفال أنّهم
.أبلوا حسنًا قبل أن أكافأهم بالبودينغ

34
00:03:56,930 --> 00:03:57,740
ماذا؟

35
00:03:58,240 --> 00:04:02,300
عذرًا، أيمكنني أن أسألك سؤالاً غريبًا؟

36
00:04:02,300 --> 00:04:03,940
نعم؟

37
00:04:04,690 --> 00:04:07,080
التُقطت تلك الصّورة في إنجلترا، أليس كذلك؟

38
00:04:07,080 --> 00:04:07,810
.نعم

39
00:04:08,530 --> 00:04:11,730
ذلك مسكن الكونت كليرمونت، صحيح؟

40
00:04:13,750 --> 00:04:17,900
هل تعرفين شخصًا يُدعى "ريتشارد" بالصّدفة؟

41
00:04:19,920 --> 00:04:21,700
...ريتشارد-سان

42
00:04:21,700 --> 00:04:24,740
.أنا أعمل في محلّ ريتشارد

43
00:04:25,140 --> 00:04:31,050
وفكّرتُ أنّها ستكون مصادفة
.مذهلة لو كنتِ مربّية ريتشارد

44
00:04:34,410 --> 00:04:37,920
.سأعدّ المزيد من الشّاي

45
00:04:44,760 --> 00:04:48,200
.أشكرك جزيلاً على اليوم
.أقدّر لك المساعدة

46
00:04:48,200 --> 00:04:51,370
.كلاّ، بل شكرًا لك على الشّاي والبودينغ

47
00:04:52,210 --> 00:04:53,230
...المعذرة

48
00:04:55,210 --> 00:05:00,940
أكره أن أطلب هكذا شيء
،من شابٍّ لطيفٍ مثلك

49
00:05:01,520 --> 00:05:04,950
.لكن أرجو أن يظلّ لقاؤنا سرًّا بيننا

50
00:05:04,950 --> 00:05:05,990
ماذا؟

51
00:05:20,750 --> 00:05:22,920
مذاقه مختلف اليوم، أليس كذلك؟

52
00:05:24,040 --> 00:05:25,670
.أطلب تفسيرًا

53
00:05:26,400 --> 00:05:28,300
تفسير؟

54
00:05:28,300 --> 00:05:29,990
قلتَ تفسيرًا؟

55
00:05:29,990 --> 00:05:35,560
قبل أيّام، حينما ذهبتُ
...لزيارة أمّي، هيموري

56
00:05:35,560 --> 00:05:36,640
.سيغي

57
00:05:37,320 --> 00:05:41,270
.أنا آسف، لكن لا أستطيع إخبارك

58
00:05:41,710 --> 00:05:47,470
...فهمت. إذًا، هذا هو تفسيرك الوحيد

59
00:05:52,800 --> 00:05:54,230
،بالتّفكير في الأمر

60
00:05:54,230 --> 00:06:00,540
لم أخبرك بعد لِمَ ما زلتُ
."أستخدم اسم "دو فولبيان

61
00:06:00,540 --> 00:06:03,300
ألذلك أيّ علاقة بهذا؟

62
00:06:03,970 --> 00:06:09,320
.إنّي أبحث عن امرأةٍ يابانيّة كانت تعتني بي

63
00:06:09,320 --> 00:06:11,890
أخذتُ اسم والدتي قبل الزّواج

64
00:06:11,890 --> 00:06:16,090
.لكي تتعرّف عليّ على الفور إن رأته

65
00:06:16,770 --> 00:06:21,680
،لثلاث سنوات، بين سنّ السّادسة والتّاسعة

66
00:06:21,680 --> 00:06:23,780
.تعلّمتُ اليابانيّة منها

67
00:06:24,820 --> 00:06:28,320
قبل 22 سنة

68
00:06:27,250 --> 00:06:31,040
،في ذلك الوقت، كان والداي قد تطلّقا بالفعل

69
00:06:31,040 --> 00:06:33,920
.وكنتُ أعيش مع عمّي

70
00:06:36,700 --> 00:06:40,040
.علامة كاملة لكما أنتما الاثنان. أحسنتما

71
00:06:40,040 --> 00:06:42,100
!نعم! سنحصل على البودينغ

72
00:06:42,100 --> 00:06:44,450
!سأري أمّي

73
00:06:52,160 --> 00:06:55,650
،سيّدي الصّغير ريتشارد
.قمتَ بعمل جيّد جدًّا أيضًا

74
00:07:01,980 --> 00:07:05,020
بعد 3 سنوات

75
00:07:12,310 --> 00:07:14,660
ماذا سنفعل بشأن أشكروفت؟

76
00:07:16,380 --> 00:07:19,660
هل حدث شيء لوالد السّيّد الصّغير ريتشارد؟

77
00:07:20,330 --> 00:07:24,500
.سيتصالح مع كاثرين وسينتقلان إلى الأمازون

78
00:07:24,930 --> 00:07:26,540
الأمازون؟

79
00:07:27,550 --> 00:07:30,230
.ذلك لأجل المظاهر غالبًا

80
00:07:30,230 --> 00:07:36,970
من السّهل على عالِم حشرات
.أن يجتاز الحدود إن كان مع عائلة

81
00:07:36,970 --> 00:07:39,910
إذًا، هل سيذهب السّيّد الصّغير
ريتشارد إلى الأمازون أيضًا؟

82
00:07:39,910 --> 00:07:40,730
.بالفعل

83
00:07:41,180 --> 00:07:43,930
،لكن إن كانت العائلة ستكون مجتمعة

84
00:07:43,930 --> 00:07:46,280
.فسيكون ذلك رائعًا بالنّسبة له

85
00:07:47,300 --> 00:07:50,260
.كاثرين ممثّلة عن ظهر قلب

86
00:07:50,260 --> 00:07:52,310
.وليست أمًّا

87
00:08:12,420 --> 00:08:13,990
!ريتشارد

88
00:08:13,990 --> 00:08:15,180
...ماما

89
00:08:15,180 --> 00:08:17,050
.لا تناديني هكذا

90
00:08:17,050 --> 00:08:19,930
.أنا آسف يا كاثرين

91
00:08:20,350 --> 00:08:23,390
.رافقني يا ريتشارد

92
00:08:45,020 --> 00:08:46,970
.عيد ميلاك مجيد

93
00:08:46,970 --> 00:08:48,840
!عيد ميلاد مجيد

94
00:08:50,300 --> 00:08:54,190
...حدث ذلك في ليلة عيد الميلاد

95
00:08:58,230 --> 00:09:00,390
ما الأمر يا كاثرين؟

96
00:09:00,390 --> 00:09:03,890
!لقد اختفت... اختفت قلادتي

97
00:09:05,340 --> 00:09:11,050
كانت القطعة المعنيّة عبارة عن قطعة أثريّة
.من القرن التّاسع عشر تضمّ حجر زبرجد كبير

98
00:09:11,050 --> 00:09:14,780
.كانت حلية قابلة للتّحويل والتّفكيك

99
00:09:24,440 --> 00:09:26,910
.بحثنا عنها في كلّ مكان ولم نجدها

100
00:09:26,910 --> 00:09:30,990
.لعلّك نسيت أنّك تركتها في مكانٍ آخر

101
00:09:30,990 --> 00:09:33,760
،كانت هناك حينما ذهبت للاستراحة في غرفتي

102
00:09:33,760 --> 00:09:36,150
!وحينما استيقظت، وجدتها اختفت

103
00:09:36,500 --> 00:09:38,260
.لا بدّ أنّ أحدًا قد أخذها

104
00:09:39,000 --> 00:09:41,450
.دعوني أفتّش أغراضكم

105
00:09:43,210 --> 00:09:45,270
...ها نحن أولاء مجدّدًا

106
00:09:45,270 --> 00:09:47,730
.الملكة ثائرة

107
00:09:47,730 --> 00:09:50,020
.كاثرين، هذا يكفي

108
00:09:50,830 --> 00:09:52,980
!لا يوجد أيّ لصوص هنا

109
00:09:53,780 --> 00:09:55,500
هل أنت واثق من ذلك؟

110
00:09:55,500 --> 00:09:56,320
ماذا؟

111
00:09:56,920 --> 00:09:59,380
أتظنّين أنّ تشيكو أخذتها؟

112
00:09:59,380 --> 00:10:03,290
.تحتاج طالبةٌ فقيرة إلى المال في النّهاية

113
00:10:07,380 --> 00:10:09,290
.يكفي يا كاثرين

114
00:10:11,860 --> 00:10:14,000
.عجبًا، عجبًا، انظروا إلى هذا

115
00:10:16,260 --> 00:10:21,510
ما الّذي يفعله مشبك قلادتي داخل حقيبتك؟

116
00:10:27,150 --> 00:10:30,730
من الاستعجال أن نفترض أنّها
.الفاعلة من ذلك الأساس فحسب

117
00:10:31,370 --> 00:10:35,070
.تشيكو، نحن إلى جانبك جميعًا

118
00:10:35,070 --> 00:10:37,400
.إن كنت تملكين تفسيرًا لهذا، سنسمعك

119
00:10:40,060 --> 00:10:41,450
...أنا

120
00:10:53,170 --> 00:10:56,490
.في النّهاية، لم نجد القلادة أبدًا

121
00:10:56,490 --> 00:11:00,340
،وبسبب ذلك، إضافة إلى أسبابٍ أخرى
...لم يتوصّل والداي إلى الصّلح

122
00:11:00,750 --> 00:11:04,220
.وكانت تلك آخر مرّة أرى فيها تشيكو

123
00:11:05,080 --> 00:11:06,720
.فهمت

124
00:11:07,050 --> 00:11:11,810
.لكن لا بدّ أن أراها مجدّدًا

125
00:11:13,630 --> 00:11:18,840
سيغي، لدى اليابان عادة لزيارة
.النّاس بغرض شكرهم

126
00:11:19,330 --> 00:11:22,090
ويُعتبر من التّهذيب أن تأخذ هديّةً

127
00:11:22,090 --> 00:11:25,850
.لبيتِ أحدٍ أكرمك بضيافته

128
00:11:26,240 --> 00:11:27,740
.إنّه تقليد رائع

129
00:11:28,560 --> 00:11:30,420
ألا توافقني؟

130
00:11:32,920 --> 00:11:34,590
.أوافقك

131
00:11:43,600 --> 00:11:45,160
.آسف

132
00:11:45,160 --> 00:11:47,470
.لم أستطع كتمان السّرّ

133
00:11:47,920 --> 00:11:50,270
.شعرتُ أنّ هذا سيحصل

134
00:11:50,700 --> 00:11:54,450
،لكن كما أخبرتك ذلك اليوم

135
00:11:54,450 --> 00:11:57,320
.حدث الكثير بيني وبين السّيّد الصّغير ريتشارد

136
00:11:57,320 --> 00:12:02,450
.عذرًا... أتيتُ برسالةٍ منه اليوم

137
00:12:02,860 --> 00:12:03,910
رسالة؟

138
00:12:03,910 --> 00:12:05,040
.نعم

139
00:12:05,390 --> 00:12:09,370
بخصوص تفاصيل ما حدث في ليلة
.عيد الميلاد قبل تسعة عشرة سنة

140
00:12:14,690 --> 00:12:17,460
ما الّذي أخبرك به السّيّد الصّغير ريتشارد؟

141
00:12:18,980 --> 00:12:21,970
.كلاّ، بل يجب أن أشرح لك بنفسي

142
00:12:22,910 --> 00:12:27,940
.لا أدري إن كنتُ قد فعلتُ الصّواب

143
00:12:29,120 --> 00:12:36,140
كلّ ما يمكنني الجزم فيه هو
.أنّني أذيتُ السّيّد الصّغير ريتشارد

144
00:12:38,540 --> 00:12:43,400
...اليوم... يومٌ... ميمون جدًّا

145
00:12:38,770 --> 00:12:43,110
قبل 22 سنة

146
00:12:43,400 --> 00:12:45,610
.والآن، ألقيا التّحيّة باليابانيّة

147
00:12:45,610 --> 00:12:48,330
.سعيد للقائك يا تشيكو

148
00:12:48,330 --> 00:12:51,500
.من الجيّد مقابلتك

149
00:12:52,540 --> 00:12:54,810
.أحسنتما

150
00:12:56,500 --> 00:12:58,710
.تفضّلا. هذه مكافأتكما

151
00:13:03,130 --> 00:13:06,730
.الأطفال يحبّونك

152
00:13:07,140 --> 00:13:09,160
.واصلي العمل الجيّد

153
00:13:09,670 --> 00:13:11,930
.سأبذل جهدي حتّى لا أخيّبكم

154
00:13:21,770 --> 00:13:23,870
...البؤساء

155
00:13:24,460 --> 00:13:26,370
!شكرًا لك يا تشيكو

156
00:13:28,500 --> 00:13:32,930
لِمَ لا تنفكّ هذه الأحداث
تحدث لجان فالجان؟

157
00:13:32,930 --> 00:13:34,370
.أشعر بالأسى لأجله

158
00:13:35,180 --> 00:13:39,340
إنّ كلّ من يشعر بالأسى على جان
فالجان قبل لقائه مع الأسقف

159
00:13:39,340 --> 00:13:40,840
.لا يُعتبر شخصًا طالحًا

160
00:13:41,410 --> 00:13:43,820
.أنت ولدٌ طيّب يا سيّدي الصّغير ريتشارد

161
00:13:45,060 --> 00:13:46,730
أين السّيّد الصّغير جيفري؟

162
00:13:47,270 --> 00:13:49,100
.إنّه يعاني من زكام

163
00:13:49,100 --> 00:13:52,100
.وعمّتي إلى جانبه تعتني به

164
00:13:59,600 --> 00:14:04,490
.إن أصبتَ بزكام، سأعتني بك

165
00:14:11,660 --> 00:14:13,020
.هذا وعد

166
00:14:15,820 --> 00:14:19,270
،مرّت ثلاث سنوات بسرعة

167
00:14:16,160 --> 00:14:21,170
بعد 3 سنوات

168
00:14:19,270 --> 00:14:22,630
.وكان يوم عودتي إلى اليابان قد اقترب

169
00:14:23,170 --> 00:14:27,470
،تشيكو، إن عملتِ معنا بشكلٍ رسميّ

170
00:14:27,470 --> 00:14:29,950
.سندفع لك بشكلٍ لائق

171
00:14:29,950 --> 00:14:33,140
...ماذا؟ لكنّي عائدة إلى اليابان

172
00:14:33,860 --> 00:14:38,570
إن عدتِ إلى الدّيار، ألا ينتظرك
الزّواج وأن تصبحي ربّة بيت فقط؟

173
00:14:38,570 --> 00:14:43,430
،عليك أن تظلّي هنا بدلاً من ذلك
.حيث يمكنك أن تدرسي كما تشائين

174
00:14:43,430 --> 00:14:45,650
...أقدّر لك عرضك، لكن

175
00:14:46,100 --> 00:14:49,030
.لا داعي لتكبحي نفسك يا تشيكو

176
00:14:49,030 --> 00:14:53,710
أساسًا، هل تعرفين كم سيحزن
ريتشارد عندما تغادرين؟

177
00:14:53,710 --> 00:14:57,530
.ريتشارد يحبّك وكأنّك أمّه

178
00:14:57,530 --> 00:15:00,730
لا تريدين أن تفارقيه أيضًا، صحيح؟

179
00:15:00,730 --> 00:15:01,670
...أنا

180
00:15:03,040 --> 00:15:08,650
.أثق أنّك لن تخوني ثقتي فيك يا تشيكو

181
00:15:20,600 --> 00:15:24,280
...حينها، أتى يوم عيد الميلاد الموعود

182
00:15:25,760 --> 00:15:31,370
استدعتني السّيّدة كاثرين
.إلى الحديقة عند حافّة البستان

183
00:15:32,370 --> 00:15:34,030
.أملك طلبًا

184
00:15:35,040 --> 00:15:37,480
منّي؟

185
00:15:40,040 --> 00:15:44,040
فكّري في الأمر وكأنّك تساعدين
.ريتشارد، وليس أنا

186
00:15:44,380 --> 00:15:45,220
ماذا؟

187
00:15:45,860 --> 00:15:49,150
تعلمين أنّ أشكروفت ينوي
التّصالح معي، صحيح؟

188
00:15:49,150 --> 00:15:49,970
.نعم

189
00:15:50,920 --> 00:15:52,800
.أريد نسيان الماضي

190
00:15:53,720 --> 00:15:56,260
ألن ترجعا إلى بعضكما؟

191
00:15:56,790 --> 00:16:02,300
.كلاّ. أدركتُ أنّ هذا أفضل لريتشارد

192
00:16:04,590 --> 00:16:11,290
.للأمانة، أردتُ أن أسترجعه منكِ في البداية

193
00:16:11,290 --> 00:16:13,500
.ما جعلني أريد التّصالح

194
00:16:13,500 --> 00:16:17,800
.لكنّ ذلك الفتى فردٌ من عائلة الكونت

195
00:16:17,800 --> 00:16:20,820
.يجب أن يتلقّى تعليمًا لائقًا

196
00:16:21,540 --> 00:16:25,340
.من الأفضل لريتشارد أن يظلّ هنا

197
00:16:27,120 --> 00:16:29,420
هل توافقين على البقاء هكذا؟

198
00:16:30,280 --> 00:16:32,750
أنا؟

199
00:16:33,930 --> 00:16:38,720
.أثق أنّك لن تخوني ثقتي فيك يا تشيكو

200
00:16:43,740 --> 00:16:47,110
.دعيني أساعدك رجاءً يا سيّدة كاثرين

201
00:16:48,270 --> 00:16:49,070
هل أنت واثقة؟

202
00:16:52,450 --> 00:16:55,980
.شكرًا لك يا تشيكو

203
00:16:59,650 --> 00:17:04,460
.خبّأتُ القلادة داخل هديّة عيد الميلاد

204
00:17:11,120 --> 00:17:14,490
!لقد اختفت... اختفت قلادتي

205
00:17:15,370 --> 00:17:19,810
وفي الصّباح الموالي، استعادت
.السّيّدة كاثرين القلادة

206
00:17:21,530 --> 00:17:25,000
ادّعت أنّها لا تستطيع التّصالح

207
00:17:25,000 --> 00:17:28,200
.مع رجلٍ عوملت من عائلته ككاذبة

208
00:17:28,200 --> 00:17:30,890
،تقبّل السّيّد أشكروفت ذلك

209
00:17:30,890 --> 00:17:33,620
تاركًا السّيّد الصّغير ريتشارد مع عائلة الكونت

210
00:17:33,620 --> 00:17:36,530
.وغادر إلى الأمازون لوحده

211
00:17:38,770 --> 00:17:40,710
في النّهاية، عدتُ إلى اليابان

212
00:17:40,710 --> 00:17:45,460
.دون حتّى أن أودّع السّيّد الصّغير ريتشارد

213
00:17:46,340 --> 00:17:49,600
،في ظلّ تلك الأوضاع
كنتُ سأظلّ في خدمةِ الكونت إلى الأبد

214
00:17:49,600 --> 00:17:51,610
.وما كنتُ لأرجع إلى اليابان أبدًا

215
00:17:51,610 --> 00:17:56,730
.ومن شدّة خوفي، خنتُ السّيّد الصّغير

216
00:18:02,890 --> 00:18:04,470
...سيّدي الصّغير ريتشارد

217
00:18:05,280 --> 00:18:08,720
.كان ريتشارد يبحث عنك طوال هذا الوقت

218
00:18:11,130 --> 00:18:12,230
...رجاءً

219
00:18:36,610 --> 00:18:37,630
.تشيكو

220
00:18:43,100 --> 00:18:45,050
.مضى وقتٌ طويل

221
00:18:45,710 --> 00:18:47,880
...و

222
00:18:49,430 --> 00:18:51,810
ما الّذي كنتُ أحاول قوله؟

223
00:18:52,660 --> 00:18:55,610
.لا أستطيع فعل هذا... تخونني العبارات

224
00:18:59,370 --> 00:19:04,740
تشيكو، أنا آسف للتّسبّب لك
.بالألم طوال هذا الوقت

225
00:19:10,600 --> 00:19:12,760
.بل أنا من يجب عليها الاعتذار

226
00:19:13,420 --> 00:19:17,830
.كلّ ما فكّرتُ فيه هو الفرار من القصر

227
00:19:19,140 --> 00:19:24,100
،عرفتُ أنّ ما حدث لم يكن غلطتك

228
00:19:24,380 --> 00:19:29,100
.وأنّك ستواصلين لوم نفسك عليه

229
00:19:30,160 --> 00:19:35,140
لم أتوقّف يومًا عن التّفكير
.كم عاملتك بقسوة

230
00:19:35,900 --> 00:19:38,820
.أنا آسفة حقًّا

231
00:19:39,170 --> 00:19:42,330
".جافير، لا ألومك على أيّ شيء"

232
00:19:42,330 --> 00:19:45,830
".قمت بواجبك، ليس إلاّ"

233
00:19:47,470 --> 00:19:50,750
.كانت تلك كلمات فالجان إلى جافير

234
00:19:51,310 --> 00:19:54,790
.دعي الماضي للماضي يا تشيكو

235
00:19:56,960 --> 00:20:00,800
.شكرًا لك يا سيّدي الصّغير ريتشارد

236
00:20:01,090 --> 00:20:04,080
.كبرتُ على أن أُدعى بالسّيّد الصّغير

237
00:20:04,870 --> 00:20:08,120
.في الماضي، كنتَ أقصر منّي

238
00:20:08,900 --> 00:20:11,770
.كبرتَ كثيرًا

239
00:20:13,050 --> 00:20:16,830
.تشيكو، أملك طلبًا

240
00:20:17,920 --> 00:20:19,170
.صافحيني

241
00:20:20,540 --> 00:20:21,440
...لا

242
00:20:22,220 --> 00:20:24,110
.دعيني أعانقك

243
00:20:42,860 --> 00:20:46,050
أهذا نصف القلادة؟

244
00:20:46,050 --> 00:20:53,020
،قبل عودتي إلى اليابان
.تركت السّيّدة كاثرين نصفها

245
00:20:53,440 --> 00:20:55,450
.لم أتمكّن من إرجاعه أبدًا

246
00:20:56,210 --> 00:20:57,760
.أنا كلصّة

247
00:20:57,760 --> 00:20:59,020
.أنت مخطئة

248
00:20:59,670 --> 00:21:02,470
،كما لم يسرق جان فالجان أيّ شيء

249
00:21:02,470 --> 00:21:05,860
.كانت هذه هديّة لك من كاثرين-سان

250
00:21:06,800 --> 00:21:10,590
...أكان السّبب من اقتراحه عليك هذا الكتاب

251
00:21:11,830 --> 00:21:13,800
.صحيح

252
00:21:13,800 --> 00:21:17,080
.لقد كسبتَ صديقًا جيّدًا يا سيّدي الصّغير

253
00:21:19,700 --> 00:21:24,840
،بخصوص قطعة المجوهرات هذه
لِمَ لا تنتهز هذه الفرصة لإعادة صنعها؟

254
00:21:25,280 --> 00:21:27,960
.أعرف حِرفيًّا ماهرًا

255
00:21:28,500 --> 00:21:31,220
.لقد أصبحتَ رجلاً رائعًا بحقّ

256
00:21:32,180 --> 00:21:33,680
.بفضلك

257
00:21:57,210 --> 00:21:58,500
.سيغي

258
00:22:01,710 --> 00:22:04,840
.مضى وقتٌ طويل. هذا أنا، والدك