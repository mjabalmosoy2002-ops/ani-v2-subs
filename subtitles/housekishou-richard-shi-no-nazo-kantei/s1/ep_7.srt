1
00:00:13,880 --> 00:00:14,780
!ثلاثون مليونًا

2
00:00:14,780 --> 00:00:16,280
...ريتشارد

3
00:02:02,300 --> 00:02:04,300
.أعتمد عليك

4
00:02:04,740 --> 00:02:06,060
.أكيد

5
00:02:07,460 --> 00:02:10,060
.سيغي، هذا إيتو-ساما من شركة إيتو شوبين

6
00:02:10,470 --> 00:02:13,570
.مرحبًا. سعيد بلقائك

7
00:02:13,570 --> 00:02:14,530
.وأنا أيضًا

8
00:02:14,530 --> 00:02:15,560
...إذًا

9
00:02:20,830 --> 00:02:23,550
شركة إيتو شوبين؟

10
00:02:23,550 --> 00:02:27,210
سيغي، هل أنت متفرّغ الأسبوع القادم؟

11
00:02:27,210 --> 00:02:29,770
.أودّ أن أصطحبك معي إلى مزاد

12
00:02:29,770 --> 00:02:30,830
مزاد؟

13
00:02:33,290 --> 00:02:38,420
أتقصد مثل المزادة الّتي نراها
في التّلفاز والأفلام؟

14
00:02:38,420 --> 00:02:41,270
هل سيعرضون شيئًا مدهشًا للبيع؟

15
00:02:41,270 --> 00:02:46,580
نعم. مجموعة أزوما سويتشي
.الّذي توفّي الشّهر الماضي

16
00:02:46,580 --> 00:02:48,730
.وتُعرف أيضًا بمجموعة أزوما

17
00:02:51,740 --> 00:02:57,270
كان أزوما مدير إدارة يتمتّع
.بمعرفة ثقافيّة عميقة

18
00:02:57,270 --> 00:02:59,210
جعلت منه مجموعته

19
00:02:59,210 --> 00:03:02,920
أحد أشهر جامعي الأحجار الكريمة
.والتّحف في اليابان

20
00:03:04,000 --> 00:03:06,920
،لكن منذ وفاته

21
00:03:06,920 --> 00:03:10,690
كانت هنالك بعض الضّجّة
.بشأن وراثة ثروته

22
00:03:10,690 --> 00:03:12,050
.يمكنني أن أتخيّل

23
00:03:12,050 --> 00:03:15,020
،ابنته الكبرى، المديرة الجديدة لعائلة أزوما

24
00:03:15,020 --> 00:03:17,620
.أتت بحلّ ذكيّ

25
00:03:17,620 --> 00:03:22,970
اقترحت أن تُعهد مجموعة أبيها
إلى شركة مزاد

26
00:03:22,970 --> 00:03:25,470
.وتصفيتها بالكامل

27
00:03:25,740 --> 00:03:27,960
.ذلك صارم للغاية

28
00:03:27,960 --> 00:03:32,490
أظنّ أنّ ذلك أكثر حكمةً من التّسبّب
.في خلاف غير ضروريّ في العائلة

29
00:03:32,490 --> 00:03:34,230
.نعم، أظنّ ذلك

30
00:03:35,770 --> 00:03:37,790
صحيح! أتريد شايًا؟

31
00:03:41,920 --> 00:03:44,410
.هذه المجموعة الّتي ستُعرض في المزاد

32
00:03:48,140 --> 00:03:51,140
أهذه كلّ مجموعة أزوما؟

33
00:03:51,140 --> 00:03:52,000
.نعم

34
00:03:52,000 --> 00:03:54,420
.القطعة الأبرز هي أترج يد بوذا

35
00:03:54,420 --> 00:03:55,630
يد بوذا...؟

36
00:03:56,020 --> 00:03:59,030
.ألق نظرة على القطعة رقم 865

37
00:04:01,980 --> 00:04:04,590
إذًا، هذه تُقرأ "أترج يد بوذا"؟

38
00:04:05,240 --> 00:04:07,160
إنّها قطعة يشم عمرها 200 سنة

39
00:04:07,160 --> 00:04:11,020
تعود إلى فترة حكم الإمبراطور
.تشيان لونغ من سلالة تشينغ الحاكمة

40
00:04:11,020 --> 00:04:12,730
عمرها 200 سنة؟

41
00:04:13,350 --> 00:04:16,660
.طُلب منّي أن أفوز بهذه القطعة في المزاد

42
00:04:16,660 --> 00:04:18,910
أتقصد من قِبل ذلك الشّخص
الّذي أتى قبل قليل؟

43
00:04:18,910 --> 00:04:19,730
.نعم

44
00:04:20,100 --> 00:04:24,530
تُعدّ شركة إيتو شوبين متجر
.تحف راسخ في غينزا

45
00:04:24,930 --> 00:04:27,210
.تنحدر كلمة يشم في الّيابانية من الرّفراف

46
00:04:27,210 --> 00:04:29,870
،"لأنّ الرّفراف يُدعى أحيانًا بـ"شوبين

47
00:04:29,870 --> 00:04:32,370
."كما يُمكن قراءة كلمة يشم كـ"شوبين

48
00:04:33,750 --> 00:04:37,120
كان مؤسّس شركة شوبين متيّمًا جدًّا باليشم

49
00:04:37,120 --> 00:04:39,800
.لدرجة أنّه سمّى متجره عليه

50
00:04:40,090 --> 00:04:42,980
.وانتهت هذه القطعة في حوزة أزوما-سان

51
00:04:43,760 --> 00:04:48,890
بعد وفاة أزوما، كان يسعى
.لإعادة شرائها بأيّ طريقة

52
00:04:48,890 --> 00:04:54,140
إذًا، لِمَ لا يشتريها بنفسه؟
لِمَ عيّنك بذلك؟

53
00:04:54,140 --> 00:04:59,240
.حُظرت شركة شوبين من قاعة المزاد

54
00:04:59,240 --> 00:05:01,530
حُظرت؟ لماذا؟

55
00:05:01,930 --> 00:05:05,050
،حتّى بعد أن عُهدت المجموعة إلى شركة مزاد

56
00:05:05,050 --> 00:05:08,970
عرض إيتو مرارًا شراء
،أترج يد بوذا بثمن باهظ

57
00:05:08,970 --> 00:05:11,250
.الأمر الّذي أضرّ بسمعته

58
00:05:11,250 --> 00:05:15,350
،ثمّ لجأ إلى أحد معارفه، مُعلّمي

59
00:05:15,350 --> 00:05:18,540
.والّذي نقل طلبه إليّ

60
00:05:18,540 --> 00:05:22,010
معلّم؟ هل تملك معلّمًا يا ريتشارد؟

61
00:05:22,010 --> 00:05:23,970
أهذا غريب؟

62
00:05:23,970 --> 00:05:25,050
.في الواقع... لا

63
00:05:25,050 --> 00:05:29,460
سيغي، إن كنتَ متفرّغًا، فهلاّ أتيت
معي إلى العرض المسبق أيضًا؟

64
00:05:29,460 --> 00:05:30,760
العرض المسبق؟

65
00:05:31,090 --> 00:05:35,820
.إنّها فرصة لرؤية قِطع المزاد شخصيًّا

66
00:05:36,160 --> 00:05:37,480
حتّى أترج يد بوذا؟

67
00:05:39,410 --> 00:05:40,810
.أكيد

68
00:05:47,100 --> 00:05:52,300
اعتُبرت أترج يد بوذا فاكهة تجلب
الحظّ الجيّد في الصّين

69
00:05:52,300 --> 00:05:54,570
.والّتي ترمز إلى يد بوذا

70
00:05:54,570 --> 00:05:57,960
.إنهّا كذلك بالفعل
أقلت أنّ عمرها 200 سنة؟

71
00:05:57,960 --> 00:06:03,960
تمّ الاعتناء بها جيّدًا لفترة
...طويلة حتّى قبل أن أولد

72
00:06:04,480 --> 00:06:08,050
.لكنّها تبدو كزمرّد أكثر منها كيشم

73
00:06:08,050 --> 00:06:10,770
اليشم ليس بهذه الشّفافيّة عادةً، صحيح؟

74
00:06:10,770 --> 00:06:12,290
.أحسنت

75
00:06:12,290 --> 00:06:14,470
.لقد طوّرت ملاحظتك عن الأحجار الكريمة

76
00:06:14,760 --> 00:06:19,860
يُدعى اليشم عالي الشّفافيّة ذو
.اللّون الأزرق والأخضر بالجاديت

77
00:06:19,860 --> 00:06:21,360
.وهو قيّم للغاية

78
00:06:21,360 --> 00:06:24,330
.إذًا، هذا من الطّراز الأوّل

79
00:06:25,570 --> 00:06:27,160
!ثـ-ثلاثون مليونًا؟

80
00:06:27,160 --> 00:06:28,320
.صمتًا

81
00:06:28,320 --> 00:06:29,670
.آسف

82
00:06:29,670 --> 00:06:32,130
.هذا سعر البيع المقدّر

83
00:06:32,130 --> 00:06:34,710
.يُجدر أن يكون السّعر الأوّليّ أقلّ بكثير

84
00:06:34,710 --> 00:06:36,160
...مذهل

85
00:06:47,250 --> 00:06:48,360
...ريتشارد

86
00:06:48,850 --> 00:06:50,140
ماذا؟

87
00:06:50,140 --> 00:06:51,220
ريتشارد؟

88
00:06:53,370 --> 00:06:55,020
.يا لها من مصادفة

89
00:06:55,020 --> 00:06:58,230
.لم أتوقّع أن أراك هنا يا سيّد كليرمونت

90
00:06:59,000 --> 00:07:00,730
.أخطأتني مع شخص آخر

91
00:07:01,410 --> 00:07:07,300
صحيح، بالتّفكير في الأمر، سمعتُ أنّك تستخدم
.اسم ريتشارد راناشينها دو فولبيان الآن

92
00:07:08,190 --> 00:07:10,970
هل تسعى لشراء يد اليشم أيضًا؟

93
00:07:10,970 --> 00:07:14,450
هل استأجرك رجلٌ فرنسيّ؟
أو ربّما إنجليزيّ؟

94
00:07:16,450 --> 00:07:20,460
،إن كنتَ تملك عملاً مع المالك
.سأسمع ما لديك قوله

95
00:07:20,460 --> 00:07:24,460
المالك"؟ هل تعمل لديه؟"

96
00:07:25,080 --> 00:07:26,210
.صحيح

97
00:07:36,080 --> 00:07:38,200
.نسيت أن أقدّم نفسي

98
00:07:38,600 --> 00:07:41,600
.اسمي شين غاناباتي بيرتشيو

99
00:07:42,060 --> 00:07:43,480
—أنا ناكاتا

100
00:07:43,480 --> 00:07:45,310
.لست بحاجة لإخباره باسمك

101
00:07:45,310 --> 00:07:50,200
عرقلة الأعمال هو اختصاصك
.يا سيّد كليرمونت

102
00:07:50,200 --> 00:07:52,630
.هذا مسلٍّ للغاية

103
00:07:52,630 --> 00:07:55,580
هل تخلّيت عن إيجاد السّعادة مع مواطنك

104
00:07:55,580 --> 00:07:58,340
واخترت أجنبيًّا بدلاً منه؟

105
00:07:59,320 --> 00:08:01,410
.أنت لا تعرفني

106
00:08:01,410 --> 00:08:06,960
أنت... ابقَ معه طويلاً وستلاقي
.نهاية مأساويّة

107
00:08:06,960 --> 00:08:08,890
.كن حذرًا

108
00:08:08,890 --> 00:08:13,010
.حسنًا يا سيّد كليرمونت، أبلغ سلامي لراناشينها

109
00:08:13,010 --> 00:08:14,130
راناشينها؟

110
00:08:19,360 --> 00:08:22,490
أنت... لست بخير، أليس كذلك؟

111
00:08:24,320 --> 00:08:26,970
.آسف لأنّه كان عليك رؤية ذلك

112
00:08:26,970 --> 00:08:28,520
.أعتذر

113
00:08:28,990 --> 00:08:32,660
.كان منافسي سابقًا

114
00:08:32,660 --> 00:08:36,990
.ودائمًا ما يردّد أنّني سرقت زبائنه

115
00:08:38,660 --> 00:08:42,530
،ما دمت أنت من يبيعه
.سيشتري زبونك حتّى الحجر العاديّ

116
00:08:42,530 --> 00:08:45,680
إنّهم يفتنون جدًّا بوجهك
.لأن يركّزوا على ما بين أيديهم

117
00:08:46,120 --> 00:08:48,070
.كانت فترة مزعجة

118
00:08:48,070 --> 00:08:52,080
...أين كنت تعمل سابقًا
هل في متجر معلّمك؟

119
00:08:52,080 --> 00:08:53,000
.نعم

120
00:08:53,460 --> 00:08:56,210
.يدير معلّمي المتجر الرّئيسيّ في سيرلانكا

121
00:08:56,210 --> 00:08:57,980
،وثمّة متجر ثانٍ في هونغ كونغ

122
00:08:57,980 --> 00:09:01,350
.والثّالث هو "إيترانجي" في طوكيو

123
00:09:01,350 --> 00:09:05,600
إذًا، من يكون "راناشينها" الّذي ذكره للتّو؟

124
00:09:05,600 --> 00:09:09,780
.ساوول راناشينها، معلّمي

125
00:09:11,490 --> 00:09:13,320
أهو من أقاربك أو ما شابه؟

126
00:09:13,320 --> 00:09:17,860
.كلاّ. أنا أستعير اسمه، لظروف معيّنة

127
00:09:17,860 --> 00:09:19,630
.لا تجمعنا قرابة دم

128
00:09:21,840 --> 00:09:23,230
هل لديك سؤال آخر؟

129
00:09:26,700 --> 00:09:29,870
.كلاّ، لا بأس. لقد أخبرتني بالكثير بالفعل

130
00:09:30,290 --> 00:09:31,250
.شكرًا لك

131
00:09:33,690 --> 00:09:35,590
.أقدّر اهتمامك

132
00:09:36,370 --> 00:09:38,510
.أنت شخص طيّب جدًّا

133
00:09:39,130 --> 00:09:42,580
.أنت كرجلٍ يسحب وجهه قبل قبلةٍ بلحظة

134
00:09:42,580 --> 00:09:44,140
ماذا؟ قبلة؟

135
00:09:47,250 --> 00:09:52,150
قصدت فقط أنّه لا بأس إن كان
.هناك شيء لا تريد إخباري به

136
00:09:52,460 --> 00:09:55,400
هل أنت مُحسن أو جبان؟

137
00:09:56,120 --> 00:09:58,900
.من الصّعب حلّ هذا السّؤال

138
00:09:58,900 --> 00:10:01,200
!لا يهمّ على أيّ حال

139
00:10:01,200 --> 00:10:04,430
أنا فقط أكره النّاس الّذين يحشرون أنفسهم

140
00:10:04,430 --> 00:10:08,420
!مع النّاس الّذين لا يريدون تقبيلهم

141
00:10:11,910 --> 00:10:14,050
...عـ... عفوًا

142
00:10:14,680 --> 00:10:20,470
بعبارة أخرى، لا أريد
.أن أرغمك على فعل أيّ شيء

143
00:10:21,240 --> 00:10:25,470
.أنا معجب بك ومدين لك

144
00:10:27,580 --> 00:10:30,490
.ماذا؟ لا تنظر إليّ هكذا

145
00:10:30,490 --> 00:10:35,610
.آسف... أدركتُ للتّوّ كيف تشعر بشأني

146
00:10:36,230 --> 00:10:39,950
أكان يجب أن أقول هذا جهرًا حتّى تدركه؟

147
00:10:40,410 --> 00:10:41,830
.أنا ممتنّ

148
00:10:42,370 --> 00:10:46,500
.معك حقّ. يجب أن أخبرك بنفسي

149
00:10:48,820 --> 00:10:50,110
...ريتشارد

150
00:10:51,100 --> 00:10:55,750
.لا تسئ الفهم. لستُ يائسًا

151
00:10:56,060 --> 00:10:59,130
.أنا فقط أشعر أنّه الوقت المناسب

152
00:11:00,540 --> 00:11:02,760
لكن هل يمكن أن نُؤجّل الأمر
حتّى انتهاء المزاد؟

153
00:11:04,150 --> 00:11:05,370
.أكيد

154
00:11:07,520 --> 00:11:09,850
،إن كان ذلك الرّجل هنا

155
00:11:10,220 --> 00:11:14,170
فلا بد أنّ هنالك مشترٍ في أوروبا
.يريد هذا اليشم

156
00:11:14,760 --> 00:11:16,240
...ثلاثون مليونًا

157
00:11:16,240 --> 00:11:18,500
.أشكّ أنّ 30 مليونًا ستكون كافية

158
00:11:18,500 --> 00:11:19,320
ماذا؟

159
00:11:20,190 --> 00:11:22,780
.ستكون معركة شرسة

160
00:11:38,090 --> 00:11:42,010
.أنا آسف جدًّا لطلبي هذا

161
00:11:42,790 --> 00:11:46,010
هل ستكون 30 مليونًا كافية؟

162
00:11:46,010 --> 00:11:47,720
.لستُ واثقًا

163
00:11:47,720 --> 00:11:50,110
بعد أن أخبرني ريتشارد، ناقشنا الموضوع

164
00:12:01,900 --> 00:12:03,280
ما الأمر؟

165
00:12:03,820 --> 00:12:08,900
صحيحٌ أنّ رؤية شيءٍ جميل جدًّا
...يمكن أن تُصيبك بالذّهول

166
00:12:08,900 --> 00:12:12,050
.أصبحت تجيد الكلام المعسول حقًّا

167
00:12:12,050 --> 00:12:14,960
ريتشارد، أيجب أن أرتدي هكذا حقًّا؟

168
00:12:15,390 --> 00:12:18,060
أنت حامل حقيبتي، أليس كذلك؟

169
00:12:18,060 --> 00:12:19,390
.لا بأس

170
00:12:20,540 --> 00:12:22,910
هل سيكون "ذلك" بخير؟

171
00:12:22,910 --> 00:12:25,550
.لا تقلق. هيّا بنا

172
00:12:29,340 --> 00:12:30,960
ذلك"؟"

173
00:12:35,510 --> 00:12:37,110
.ثمّة الكثير من النّاس

174
00:12:37,460 --> 00:12:40,700
.الغرض الأكبر على وشك أن يُعرض

175
00:12:41,360 --> 00:12:44,780
.ترتدي ملابس رائعة يا سيّد كليرمونت

176
00:12:45,280 --> 00:12:46,670
...ذاك الوجه

177
00:12:46,670 --> 00:12:48,880
،أينما ذهبت

178
00:12:48,880 --> 00:12:52,120
.لن ينساه أيّ أحد سبق وتعامل معه

179
00:12:54,000 --> 00:12:57,100
.وجهك هو بطاقة عملك

180
00:12:57,100 --> 00:12:58,690
.متأسّف عليك

181
00:12:59,010 --> 00:13:00,650
.أشكر السّماء

182
00:13:01,300 --> 00:13:07,300
لأنّ حتّى شخصًا ينسى الأسماء كثيرًا
.مثلك، سيتذكّر وجهي

183
00:13:08,680 --> 00:13:12,640
.أنا ريتشارد راناشينها دو فولبيان

184
00:13:14,420 --> 00:13:18,940
بالمناسبة، من هو موكّلك؟
وما هي ميزانيّته؟

185
00:13:19,930 --> 00:13:22,730
.لم أنحدر بمستواي لدرجة أن أناقشك ذلك

186
00:13:22,730 --> 00:13:26,950
.أيًّا كان موكّلي، لا تملك فرصة

187
00:13:27,260 --> 00:13:32,200
.تنتهي القطع القيّمة بين أيدٍ جديرة

188
00:13:32,200 --> 00:13:36,790
.سأحصل على ما يريده موكّلي

189
00:13:44,170 --> 00:13:46,420
.إنّها بنكهة الشّاي الملكيّ بالحليب

190
00:13:46,420 --> 00:13:47,980
.لتغيير الجوّ

191
00:13:52,850 --> 00:13:54,050
.شكرًا لك

192
00:13:55,850 --> 00:13:59,480
.سوف نستكمل مزاد العصر الآن

193
00:13:59,900 --> 00:14:01,980
.القطعة رقم 800

194
00:14:01,980 --> 00:14:06,490
سنبدأ المزايدة على عقد الياقوت
.هذا بثلاثة ملايين

195
00:14:07,990 --> 00:14:12,870
.لدينا 3.1 مليون، 3.2 مليون، 3.3 مليون

196
00:14:13,290 --> 00:14:16,770
.أربعة ملايين، 4.1 مليون

197
00:14:17,580 --> 00:14:19,110
.خمسة ملايين

198
00:14:19,110 --> 00:14:20,630
...وحينما يبقى مزايد واحد

199
00:14:21,060 --> 00:14:23,410
.بيعت بخمسة ملايين

200
00:14:24,090 --> 00:14:26,030
.فهمت

201
00:14:28,130 --> 00:14:30,300
ماذا؟ أتريدني أن أزايد؟

202
00:14:31,000 --> 00:14:33,240
ألست حامل حقيبتي؟

203
00:14:36,340 --> 00:14:37,430
...نعم

204
00:14:39,400 --> 00:14:41,650
.القطعة رقم 865

205
00:14:42,030 --> 00:14:43,610
.أترج يد بوذا

206
00:14:47,860 --> 00:14:51,240
قطعة يشم تعود لفترة حكم الإمبراطور
.تشيان لونغ من عائلة تشينغ الحاكمة

207
00:14:53,700 --> 00:14:55,790
.سيبدأ المزاد بعشرة ملايين

208
00:14:58,810 --> 00:15:00,080
.‫11 مليون

209
00:15:00,760 --> 00:15:02,190
.‫12 مليونًا

210
00:15:02,630 --> 00:15:04,090
.‫13 مليونًا

211
00:15:04,600 --> 00:15:05,750
.‫20 مليونًا

212
00:15:06,360 --> 00:15:09,760
.‫21 مليونًا. 22 مليونًا

213
00:15:10,230 --> 00:15:11,260
!‫30 مليونًا

214
00:15:11,260 --> 00:15:12,760
...‫30 مليونًا

215
00:15:13,190 --> 00:15:16,390
.‫31 مليونًا. 32 مليونًا

216
00:15:17,160 --> 00:15:21,220
.‫33 مليونًا. 34 مليونًا

217
00:15:19,260 --> 00:15:20,140
.أكيد

218
00:15:22,270 --> 00:15:29,250
.‫35 مليونًا. 36 مليونًا. 37 مليونًا

219
00:15:29,250 --> 00:15:31,860
.هذا كلّ ما تستطيع تحمّله

220
00:15:35,180 --> 00:15:37,100
.‫38 مليونًا

221
00:15:37,650 --> 00:15:41,210
.‫39 مليونًا، ‫40 مليونًا

222
00:15:42,720 --> 00:15:44,420
.‫41 مليونًا

223
00:15:45,920 --> 00:15:47,460
كم تستطيع أن تدفع أكثر؟

224
00:15:47,790 --> 00:15:49,670
.‫41 ونصف مليونًا

225
00:15:50,200 --> 00:15:54,640
.‫42 مليونًا. 42 مليونًا ونصف

226
00:15:54,640 --> 00:15:55,650
.انظر بجديّة

227
00:15:55,650 --> 00:15:56,550
!نـ-نعم

228
00:15:56,550 --> 00:16:01,060
.‫43 مليونًا. 43 مليونًا ونصف

229
00:16:01,340 --> 00:16:08,350
.‫44 مليونًا. 44 مليونًا ونصف. 45 مليونًا

230
00:16:12,720 --> 00:16:15,600
.بيعت بخمسة وأربعين مليونًا

231
00:16:17,050 --> 00:16:19,320
.يمكنك أن تُنزلها الآن

232
00:16:19,650 --> 00:16:21,910
...ما... حسنًا

233
00:16:23,570 --> 00:16:24,960
.أحسنت

234
00:16:30,830 --> 00:16:34,370
كان يُفترض أن تكون ميزانيّتك
!ثلاثون مليونًا وبعض الفكّة

235
00:16:34,370 --> 00:16:38,300
.إذًا، كنتَ تتجسّس لتحديد ميزانيّتي

236
00:16:39,810 --> 00:16:44,770
!أنت رجلٌ ملعون
!ستجلب الحظّ السّيّئ مجدّدًا

237
00:16:44,770 --> 00:16:47,940
سواء جلب الحظّ السّيّئ
.أم لا، فذلك ليس من شأنك

238
00:16:48,690 --> 00:16:51,360
!كفّ عن التّدخّل في شؤونه

239
00:16:52,470 --> 00:16:55,950
أنت مجرّد أحمق أعماه شخص
.لا يُدرك سمّه حتّى

240
00:17:04,770 --> 00:17:06,110
!ريتشارد-سان

241
00:17:07,710 --> 00:17:12,300
!إيتو-سان، ريتشارد-سان! شكرًا جزيلاً

242
00:17:16,980 --> 00:17:18,550
.أنا أزوما هيدينوري

243
00:17:18,860 --> 00:17:22,490
أزوما؟ هل أنت فرد من عائلة أزوما؟

244
00:17:22,490 --> 00:17:23,310
!مهلاً

245
00:17:23,990 --> 00:17:26,030
!هل تعرفون أنتم الثّلاثة بعضكم؟

246
00:17:27,650 --> 00:17:32,070
.إذًا، كان أزوما-سان المستثمر الآخر

247
00:17:32,360 --> 00:17:36,800
نعم. لأنّ هيدينوري-سان قبِل
،باستثمار 10 ملايين

248
00:17:36,800 --> 00:17:39,780
.تمكّنّا من تجميع 40 مليونًا

249
00:17:39,780 --> 00:17:42,960
لكنّ السّعر الأخير كان 45 مليونًا، صحيح؟

250
00:17:42,960 --> 00:17:45,260
من سيغطّي الملايين الخمسة المتبقيّة؟

251
00:17:45,950 --> 00:17:48,220
أهو أنت يا ريتشارد؟

252
00:17:48,740 --> 00:17:51,040
.أنا مسرور لأنّني استطعتُ المساعدة

253
00:17:51,040 --> 00:17:54,970
المساعدة؟ من أين ستحصل
على خمسة ملايين؟

254
00:17:55,430 --> 00:17:58,080
.شكرًا جزيلاً

255
00:17:58,080 --> 00:18:01,300
،لولا استثمارك يا ريتشارد-سان

256
00:18:01,650 --> 00:18:05,670
لكنت لعنتُ عمّتي على وضعها
.أترج يد بوذا في المزاد

257
00:18:06,130 --> 00:18:08,310
لعنتها؟ هل ستكرهها بذلك القدر؟

258
00:18:08,670 --> 00:18:09,710
.نعم

259
00:18:09,710 --> 00:18:14,480
بالنّسبة لي، أترج يد بوذا ناضحة
.بذكرياتي عن جدّي

260
00:18:17,740 --> 00:18:20,380
مذ كنتُ طفلاً، واجهتُ صعوبات في الانسجام

261
00:18:20,380 --> 00:18:22,680
.مع أفراد عائلتنا الرّئيسيّة

262
00:18:22,990 --> 00:18:28,740
لكنّ جدّي كان يدعني أتعامل دائمًا
.مع ذلك اليشم ذو البريق اللّطيف

263
00:18:29,750 --> 00:18:31,650
...أترج يد بوذا

264
00:18:31,650 --> 00:18:32,750
.نعم

265
00:18:33,250 --> 00:18:37,650
،لهذا أردتُ الاحتفاظ بأترج يد بوذا مهما كان

266
00:18:38,210 --> 00:18:40,470
.حتّى إن ضاعت بقيّة ثروته

267
00:18:41,390 --> 00:18:45,720
،إن انتهى بها المطاف إلى الخارج
.لكان من الصّعب تعقّبها مجدّدًا

268
00:18:46,400 --> 00:18:48,510
،حينما ضعفت عائلة تشينغ الحاكمة

269
00:18:48,510 --> 00:18:51,180
تقدّمت الدّول القويّة الأخرى
،لشراء يشمها بأسعار رخيصة

270
00:18:51,180 --> 00:18:53,480
.ممّا جعلها تتناثر حول العالم

271
00:18:54,670 --> 00:18:57,470
.أردتُ تجنّب ذلك

272
00:18:57,470 --> 00:19:02,030
إن كان بإمكاني أن أضيف، كشخص
،يعمل في عالم الأحجار الكريمة

273
00:19:02,030 --> 00:19:06,870
.لم أرد أن يجول ذلك اليشم بعد الآن

274
00:19:07,610 --> 00:19:11,860
.كان دافعنا مختلف، لكنّ هدفنا واحد

275
00:19:16,240 --> 00:19:19,970
.يرمز هذا النتوء أسفلها إلى الخفاش

276
00:19:20,530 --> 00:19:24,970
منذ أقدم العصور، اعتُبرت الخفافيش
.جالبة للحظّ في الصّين

277
00:19:25,250 --> 00:19:27,420
.تميمة جالبة للحظّ

278
00:19:27,420 --> 00:19:31,810
يشم جالب للحظّ مليء بذكريات
.أزوما-سان مع جدّه

279
00:19:32,930 --> 00:19:35,110
.شكرًا لك

280
00:19:36,140 --> 00:19:39,270
.أراهن أنّ جدّي يبتسم الآن

281
00:19:39,270 --> 00:19:42,450
لا بدّ أنّه لم يكن يتوقّع أن يقوم
.حفيده بإعادة شراء إحدى مقتنياته

282
00:19:55,840 --> 00:19:59,510
على أيّ حال، أنا متفاجئ لأنّك
.كنت تملك خمسة ملايين

283
00:19:59,860 --> 00:20:03,410
.بطبيعة الحال، أتوقّع أن يعوّضونني

284
00:20:03,410 --> 00:20:07,320
لكن إن كان ذلك سيحافظ على
.إرث عائلة أزوما، فقد كانت صفقة

285
00:20:07,320 --> 00:20:09,850
.لـ-لا أظنّ أنّ أيّ أحد سيعتبر ذلك رخيصًا

286
00:20:09,850 --> 00:20:12,690
إن كان المال وحده كافيًا
.للحفاظ عليه، فهو رخيص

287
00:20:12,690 --> 00:20:17,650
.ما يعني أنّه يمكن تدميره بشيءٍ بهذه التّفاهة

288
00:20:19,450 --> 00:20:21,820
.دعنا نتابع نقاشنا من ذلك اليوم

289
00:20:24,090 --> 00:20:28,140
.إنّها قصّة مملّة حدثت في ضواحي لندن

290
00:20:30,490 --> 00:20:31,580
ميراثك؟

291
00:20:31,580 --> 00:20:35,590
نعم. ما زالوا يتجادلون عن الميراث الهائل

292
00:20:35,590 --> 00:20:37,750
.الّذي خلّفه جدّي

293
00:20:38,050 --> 00:20:40,390
.كان هناك خلاف بين العائلة

294
00:20:40,390 --> 00:20:43,340
وتعرّض النّاس للخيانة من قبل أولئك
.الّذين كانوا يعتبرونهم أصدقاء

295
00:20:43,340 --> 00:20:46,360
.وانفصلت الرّوابط الرّومانسيّة

296
00:20:46,360 --> 00:20:48,580
.حدث الكثير

297
00:20:48,940 --> 00:20:53,160
أيجب أن تدير متجر مجوهرات في اليابان؟

298
00:20:53,160 --> 00:20:55,930
وماذا يفترض بي أن أفعل غير ذلك؟

299
00:20:56,640 --> 00:20:58,130
...فهمت

300
00:20:58,130 --> 00:21:01,150
.على أيّ حال، شكرًا على إخباري

301
00:21:01,150 --> 00:21:03,030
.العفو

302
00:21:03,610 --> 00:21:07,160
هذا هو السّبب غالبًا
.من قول ذلك الرّجل ما قاله

303
00:21:07,840 --> 00:21:09,410
السّبب؟

304
00:21:09,870 --> 00:21:14,850
لِمَ حذّرك أنّك ستلاقي نهاية مأساويّة

305
00:21:14,850 --> 00:21:16,420
.إن بقيت معي طويلاً

306
00:21:16,880 --> 00:21:18,520
أكان ذلك تحذير؟

307
00:21:18,520 --> 00:21:22,690
.أكان جادًّا؟ ذلك ما حدث لك فحسب

308
00:21:22,690 --> 00:21:24,380
.إليك عنّي

309
00:21:33,140 --> 00:21:36,710
.حسنًا، سأذهب من هذه الطّريق
.أراك الأسبوع القادم

310
00:21:36,710 --> 00:21:39,290
.نعم، أراك الأسبوع القادم

311
00:21:42,660 --> 00:21:43,780
.سيغي

312
00:21:44,800 --> 00:21:47,050
.لا تلمني إن ندمت

313
00:21:47,420 --> 00:21:48,490
ندمتُ على ماذا؟

314
00:21:50,980 --> 00:21:53,750
.على إخباري أنك معجب بي

315
00:21:55,210 --> 00:21:56,240
.الوداع