1
00:00:00,000 --> 00:00:10,480
مائة مشهد
من أواجيما

2
00:01:31,820 --> 00:01:34,980
!انظري إليكِ

3
00:01:34,990 --> 00:01:37,990
ساوري ياماغاتا & ميكاكو تاكيوشي

4
00:01:35,240 --> 00:01:39,250
،تمكثين في غرفة مستشفى فاخرة
.ارتقيتِ في الحياة حقًا

5
00:01:39,530 --> 00:01:42,240
.لأنّني مصدر المال

6
00:01:42,240 --> 00:01:45,000
.حسنًا، أظنّ ذلك

7
00:01:45,260 --> 00:01:47,860
.هذه من المدير بالمناسبة

8
00:01:47,860 --> 00:01:49,200
.هذه لفتة جميلة

9
00:01:49,200 --> 00:01:51,250
.وصلتني بعض الزهور الجميلة بالفعل

10
00:01:51,250 --> 00:01:52,800
.أنا ممتنة لهذا

11
00:01:53,350 --> 00:01:56,140
.تقولين هذا بوجه كئيب جدًا

12
00:01:56,870 --> 00:01:58,140
حقًا؟

13
00:01:59,420 --> 00:02:02,650
حسنًا، لو فقدتِ عملك وأنتِ
.هنا، سيكون ذلك مفجعًا

14
00:02:02,650 --> 00:02:04,820
لحظة، ألن تغادري؟

15
00:02:05,530 --> 00:02:07,620
.تبدين وكأنّك تريدين من يتحدث معكِ

16
00:02:18,020 --> 00:02:22,880
حسبتُ أنّني نلتُ الدور أخيرًا
،عندما أُعلِن عن الطاقم

17
00:02:22,880 --> 00:02:27,590
.لكنّه قد يضيع منك هكذا بسهولة
.وهذا ما يخيف في هذا العالم

18
00:02:28,500 --> 00:02:32,000
يقول لكِ "هذا العالم" أن ترتاحي الآن

19
00:02:32,000 --> 00:02:35,080
.أظنّ أنّ علي الاقتناع بهذا

20
00:02:36,670 --> 00:02:38,910
هل سمعتِ شيئًا عن الممثلة الجديدة؟

21
00:02:39,680 --> 00:02:40,520
.نعم

22
00:02:40,930 --> 00:02:42,380
ميكاكو، صحيح؟

23
00:02:42,840 --> 00:02:44,760
.يبدو وكأنّه كان مُقدّرًا

24
00:02:46,640 --> 00:02:47,850
!ساوري

25
00:02:49,590 --> 00:02:52,110
.أُعلِن عن الدور المزدوج

26
00:02:52,110 --> 00:02:53,900
اختاروكِ له بالفعل، صحيح؟

27
00:02:53,900 --> 00:02:56,200
نعم. أنتِ أيضًا، صحيح؟

28
00:02:56,200 --> 00:02:57,060
.نعم

29
00:02:57,490 --> 00:02:58,860
.أتطلع لذلك

30
00:02:58,860 --> 00:03:00,160
.وأنا كذلك

31
00:03:11,320 --> 00:03:13,940
.يا إلهي! لديك حمى قوية

32
00:03:14,910 --> 00:03:16,430
هل أنت بخير؟

33
00:03:16,430 --> 00:03:19,330
.وجهك مُحمر وأنتِ تتعرقين بشدة

34
00:03:24,210 --> 00:03:25,520
وماذا في ذلك؟

35
00:03:27,470 --> 00:03:31,230
كان عليكِ أن تؤدّي البارحة
.لو علمنا أنّ هذا سيحدث

36
00:03:31,480 --> 00:03:33,600
ما فائدة التذمر الآن؟

37
00:03:34,590 --> 00:03:35,720
.آسفة

38
00:03:36,720 --> 00:03:38,650
.نحن نؤدّي ليومين فقط

39
00:03:38,650 --> 00:03:40,890
.أدّيتِ العرض الأول

40
00:03:40,890 --> 00:03:42,460
.وأتى دوري الآن

41
00:03:43,840 --> 00:03:46,500
هل حسبتِ أنّك ستحصلين على
فرصة أخرى على المسرح؟

42
00:03:46,500 --> 00:03:48,510
!لم أفكّر بهذا الشكل أبدًا

43
00:03:50,970 --> 00:03:52,000
.آسفة

44
00:03:52,480 --> 00:03:55,260
.آسفة، أثرت عليّ الحمى. قلتُ كلامًا جارحًا

45
00:03:55,670 --> 00:03:56,840
.انسيه

46
00:03:57,670 --> 00:03:59,070
.أفهم

47
00:04:00,280 --> 00:04:03,760
سيكون من المحرج أن
أنهار على المسرح

48
00:04:03,760 --> 00:04:05,730
.وأنا لم أتخرج بعد

49
00:04:06,640 --> 00:04:08,910
،أرجوكِ لا تضحكي عليّ
.حتّى لو فعل الآخرون

50
00:04:10,190 --> 00:04:11,660
.محال أن أضحك

51
00:04:14,640 --> 00:04:16,700
.لم تنهَر ميكاكو

52
00:04:17,330 --> 00:04:20,920
رغم أنّها لم تتذكر ما حدث
.أثناء التصفيق الصاخب

53
00:04:21,860 --> 00:04:24,860
أويدا

54
00:04:21,860 --> 00:04:24,860
تاكيوشي

55
00:04:23,980 --> 00:04:24,850
!تفضل

56
00:04:26,090 --> 00:04:27,900
هل ميكاكو بخير؟

57
00:04:27,900 --> 00:04:28,900
...إن كانت نائمة

58
00:04:30,240 --> 00:04:32,380
.أظنّ أنّها بخير

59
00:04:33,510 --> 00:04:37,280
.يوموغيدا-سينباي وياماغاتا-سينباي هنا يا سينباي

60
00:04:37,280 --> 00:04:38,080
.حسنًا

61
00:04:41,340 --> 00:04:43,550
.سأترككما معها

62
00:04:43,550 --> 00:04:44,720
.خذا راحتكما

63
00:04:44,720 --> 00:04:45,840
.شكرًا

64
00:04:50,890 --> 00:04:53,980
!لا داعي لتنهضي! ابقي في السرير

65
00:04:55,470 --> 00:04:57,970
.ارتبكتُ حين لم أركِ في غرفة الممرضة

66
00:04:58,280 --> 00:05:00,700
.ارتأيتُ أنّني سأرتاح أكثر في غرفتي

67
00:05:00,700 --> 00:05:03,940
.أنتِ مريضة. عليكِ أن تنامي

68
00:05:03,940 --> 00:05:04,790
.خذي

69
00:05:05,730 --> 00:05:07,620
.أتيتُ لأعطيك هذه

70
00:05:09,870 --> 00:05:11,250
.شكرًا

71
00:05:11,250 --> 00:05:12,860
.سأرتّبها لاحقًا

72
00:05:16,090 --> 00:05:17,970
التخرج بالفعل إذًا؟

73
00:05:18,420 --> 00:05:20,690
...مرّ الوقت بسرعة

74
00:05:20,690 --> 00:05:21,500
.نعم

75
00:05:23,150 --> 00:05:26,210
"لنقف جميعًا على المسرح معًا"

76
00:05:26,600 --> 00:05:28,960
"لا بدّ أن نكون موجودات جميعًا"

77
00:05:30,670 --> 00:05:34,530
.رغم ما قالت، كانت ميكاكو أول الغائبات

78
00:05:40,400 --> 00:05:42,690
هل سمعتِ عن ميكاكو؟

79
00:05:42,690 --> 00:05:43,760
.لا

80
00:05:43,760 --> 00:05:45,780
.سوى أنّها في المستشفى

81
00:05:47,320 --> 00:05:50,270
،وصلنا خبر أنّها تصارع المرض في النهاية

82
00:05:50,910 --> 00:05:56,390
.وتوقفنا عن ذِكرها مع مرور الوقت

83
00:06:00,390 --> 00:06:01,790
...أصلًا

84
00:06:02,550 --> 00:06:03,700
نعم؟

85
00:06:03,700 --> 00:06:05,780
...بخصوص عرض التخرّج

86
00:06:07,790 --> 00:06:10,800
أتظنّين أنّها كانت مُجرّد إنفلونزا؟

87
00:06:12,120 --> 00:06:14,550
أتظنين أنّها كانت أعراضًا
مبكّرة على الأرجح؟

88
00:06:15,230 --> 00:06:19,570
لا أعلم، ولستُ متأكدة حتّى
.ممّا عليّ أن أقوله لها

89
00:06:21,220 --> 00:06:23,070
.هذا كان حالنا

90
00:06:23,070 --> 00:06:27,320
.كنّا نقلق عليها بينما نتخلّى عنها

91
00:06:28,530 --> 00:06:31,930
!ضيفتنا اليوم هي ميكاكو تاكيوشي-سان

92
00:06:32,820 --> 00:06:34,830
!اسمعوا هذه الهتافات

93
00:06:34,830 --> 00:06:36,220
.أنتِ مشهورة حقًا

94
00:06:36,220 --> 00:06:37,330
.لا تُبالغي

95
00:06:37,330 --> 00:06:39,210
.هذا بسبب ذلك المسلسل الشهير فقط

96
00:06:39,490 --> 00:06:43,080
سمعتُ أنّ لديكِ تاريخًا
غير عادي يا تاكيوشي-سان، صحيح؟

97
00:06:43,330 --> 00:06:46,100
تخرجتِ من مدرسة أواجيما للعروض

98
00:06:46,100 --> 00:06:48,190
.قبل أن تنضمي إلى فرقة أواجيما للعروض

99
00:06:48,830 --> 00:06:51,850
.ظننتُ أنّ الجميع يعرف هذا بالفعل

100
00:06:51,850 --> 00:06:53,410
.بالطبع لا

101
00:06:53,410 --> 00:06:56,640
.لم أدرس هناك طويلًا

102
00:06:56,640 --> 00:07:02,480
صحيح. مرضتِ بعد انضمامك
.بفترة قصيرة وأخذتِ إجازة

103
00:07:02,480 --> 00:07:15,240
تاريخ ميكاكو تاكيوشي

104
00:07:02,480 --> 00:07:15,240
واحد. أواجيما للعروض

105
00:07:02,480 --> 00:07:15,240
اثنان. رحيل صادم

106
00:07:02,480 --> 00:07:15,240
ثلاثة. عودة لعالم الفن

107
00:07:02,820 --> 00:07:06,100
.لن أسمّيها إجازة بل تقاعدًا تقريبُا

108
00:07:06,100 --> 00:07:09,350
.نعم، لكنّك عدتِ الآن

109
00:07:09,350 --> 00:07:12,050
وسمعتُ أنّ لقاءكِ

110
00:07:12,050 --> 00:07:15,230
.بالمُخرج الأخير ألهم عودتك

111
00:07:15,540 --> 00:07:16,790
.هذا صحيح

112
00:07:16,790 --> 00:07:20,860
بدأ الأمر مع مُخرج مسرحي
،يدعى مياجيما-سان

113
00:07:21,120 --> 00:07:23,940
.لكنّني هنا كبديلة فقط هذه المرّة

114
00:07:24,590 --> 00:07:30,750
سأبذل قصارى جهدي لأُنصِف عمل
.يوكي كابوراغي-سان أثناء فترة تعافيها

115
00:07:30,760 --> 00:07:33,010
ميكاكو تاكيوشي & ساوري ياماغاتا

116
00:07:33,760 --> 00:07:36,370
.أنا قلقة

117
00:07:36,370 --> 00:07:38,510
.صحّتك واهنة

118
00:07:39,070 --> 00:07:40,690
.أنا آسفة

119
00:07:40,690 --> 00:07:44,520
.يحاول الجميع توديعك ببهجة

120
00:07:44,520 --> 00:07:48,660
.لكنّني لا أستطيع التخلّص من قلقي

121
00:07:49,070 --> 00:07:50,140
.لا بأس

122
00:07:53,810 --> 00:07:56,540
.لم أستطِع أن ألوم أمّي على قلقِها

123
00:07:57,950 --> 00:08:00,600
.أتت أمّكِ يا ميكاكو-تشان

124
00:08:03,700 --> 00:08:05,330
إلامَ كنتِ تُحدّقين؟

125
00:08:05,330 --> 00:08:06,310
.طائرة

126
00:08:06,310 --> 00:08:07,430
حقًا؟

127
00:08:07,430 --> 00:08:10,060
أردتِ أن تصبحي مضيفة طيران، صحيح؟

128
00:08:10,510 --> 00:08:12,040
أيّ كتاب أحضرتِ اليوم؟

129
00:08:12,040 --> 00:08:13,000
هل لديكِ مانغا؟

130
00:08:13,410 --> 00:08:15,050
!نعم، لديّ

131
00:08:15,050 --> 00:08:17,360
،لم أعرف ماذا أشتري لكِ

132
00:08:17,360 --> 00:08:20,000
.فسألتُ موظفة المكتبة عمّا يعجبها

133
00:08:22,680 --> 00:08:27,820
فتاة كانت تشاركني الغرفة
.توفيت قبل فترة قصيرة

134
00:08:29,520 --> 00:08:34,400
ساكوساكو مدينة

135
00:08:29,520 --> 00:08:34,400
عرض جديد لفرقة أواجيما للعروض

136
00:08:29,520 --> 00:08:34,400
وجبات
ربيعية
لا تفوت

137
00:08:29,520 --> 00:08:34,400
أفضل مواقع
!لمشاهدة زهور الكرز

138
00:08:31,180 --> 00:08:34,400
...ربّما لم يكن عليّ أن أريها ذلك العدد

139
00:08:34,830 --> 00:08:36,240
لِم لا؟

140
00:08:36,240 --> 00:08:39,710
.يمكنكِ القول أنّه جزء من سبب تحسّنها

141
00:08:39,710 --> 00:08:41,400
...أعلم ولكن

142
00:08:41,910 --> 00:08:43,880
!جميل

143
00:08:43,880 --> 00:08:46,790
سيقيمون عرضًا في قاعة غرين
.القريبة الشهر المقبل

144
00:08:47,420 --> 00:08:48,750
!أريد الذهاب

145
00:08:49,330 --> 00:08:51,290
هل تريدين ذلك حقًا؟

146
00:08:51,590 --> 00:08:53,800
!نعم! أريد أن أراه

147
00:08:54,390 --> 00:08:58,920
إذًا، لنعمل على تعافيك
.لتخرجي بحلولِ ذلك الوقت

148
00:08:59,620 --> 00:09:04,650
كانت أمّي تحضر لي
.كلّ أنواع الترفيه لتشغلني

149
00:09:05,420 --> 00:09:10,630
رغم مللي من العيش في
.المستشفى، جذب كلّ ذلك انتباهي

150
00:09:11,170 --> 00:09:15,010
.لكن فرقة أواجيما للعروض كانت أكثر ما أسرني

151
00:09:16,790 --> 00:09:18,560
هل معكِ كلّ أغراضك؟

152
00:09:18,560 --> 00:09:19,570
.نعم

153
00:09:19,570 --> 00:09:21,910
.أرسلتُ الأغراض المهمة مسبّقًا

154
00:09:24,190 --> 00:09:27,050
.أرجوك، لا تبكي

155
00:09:27,050 --> 00:09:29,610
.تبكي ساكيكو-سان بسهولة

156
00:09:30,170 --> 00:09:33,410
.سأحرص على إيصالها بسلام وأمان

157
00:09:35,880 --> 00:09:38,600
هل أنتِ متأكدة أنّك لم تنسي شيئًا؟

158
00:09:38,600 --> 00:09:40,340
.أكّدتُ لك الأمر بالفعل

159
00:09:42,820 --> 00:09:46,220
.ربّما كان من الأفضل أن ترافقنا أمّي

160
00:09:46,930 --> 00:09:48,320
.لا

161
00:09:48,320 --> 00:09:51,730
.كانت ستبكي بكاءً غامرًا لا يُحتمَل

162
00:09:51,990 --> 00:09:55,780
.قررت البقاء في البيت خوفًا من حدوث ذلك

163
00:09:55,780 --> 00:09:56,850
...لكن

164
00:09:57,090 --> 00:09:59,060
!لا بأس، لا بأس

165
00:09:59,060 --> 00:10:02,110
،علينا فقط أن نُريها أنّك تعملين بجد

166
00:10:02,110 --> 00:10:03,960
.وستطمئن بسرعة

167
00:10:04,940 --> 00:10:05,810
.حسنًا

168
00:10:06,620 --> 00:10:12,880
السلامة على الطريق

169
00:10:07,020 --> 00:10:09,300
.بدأتُ أبكي أيضًا الآن

170
00:10:09,300 --> 00:10:12,140
يبدو أنّ الأمر متوارث في العائلة إذًا؟

171
00:10:23,340 --> 00:10:24,980
إنّه دور مزدوج، صحيح؟

172
00:10:24,980 --> 00:10:26,940
!لا بدّ أنّ الاختيار وقع على تلك الاثنتين

173
00:10:28,520 --> 00:10:31,250
.عذرًا! أودّ استخدام الهاتف

174
00:10:29,100 --> 00:10:34,860
يرجى الاتصال بالمساعدة

175
00:10:31,250 --> 00:10:32,160
.تفضلي

176
00:10:52,900 --> 00:10:54,520
أمّي؟

177
00:10:55,010 --> 00:10:57,820
!نعم، حصلتُ على الدور المزدوج

178
00:10:59,540 --> 00:11:02,760
!هيّا، أرجوك كفى بكاءً

179
00:11:07,520 --> 00:11:09,870
أخبروكِ في مكتب الموظفين، صحيح؟

180
00:11:09,870 --> 00:11:12,280
.كان بوسعكِ استخدام الهاتف هناك

181
00:11:12,280 --> 00:11:15,780
لا! أعني أنّني شعرتُ بالخجل
.من الاتصال أمام المعلّمين

182
00:11:16,390 --> 00:11:18,940
.مبروك. بالتوفيق

183
00:11:18,940 --> 00:11:20,400
.شكرًا

184
00:11:26,060 --> 00:11:26,780
.خذي

185
00:11:27,430 --> 00:11:28,790
هل أنت بخير؟

186
00:11:30,450 --> 00:11:31,840
.شكرًا

187
00:11:35,110 --> 00:11:38,890
.آسفة، أظنني أصبتُ بجفاف خفيف

188
00:11:39,300 --> 00:11:41,120
.توخي الحذر

189
00:11:41,590 --> 00:11:44,650
،فريق الأداء الجماعي
.اجتمعن هنا رجاء

190
00:11:46,340 --> 00:11:48,510
.حسنًا، من البداية

191
00:11:56,480 --> 00:11:58,920
.يا إلهي! لديك حمى قوية

192
00:12:00,180 --> 00:12:01,560
هل أنت بخير؟

193
00:12:01,560 --> 00:12:04,560
.وجهك مُحمر وأنتِ تتعرقين بشدة

194
00:12:10,960 --> 00:12:12,340
وماذا في ذلك؟

195
00:12:21,860 --> 00:12:23,800
.لا يمكن أن أسمح لنفسي بالانهيار

196
00:12:24,700 --> 00:12:28,820
.والداي كلاهما هنا لمشاهدة أدائي

197
00:12:30,170 --> 00:12:33,860
لن تخيب آمالكما بي بعد الآن، صحيح؟

198
00:12:35,800 --> 00:12:39,120
"ميكاكو فتاة ناجحة الآن، صحيح؟"

199
00:12:42,630 --> 00:12:43,870
!تفضل

200
00:12:44,950 --> 00:12:46,900
هل ميكاكو بخير؟

201
00:12:46,900 --> 00:12:47,930
...إن كانت نائمة

202
00:12:47,930 --> 00:12:49,840
.أظنّ أنّها بخير

203
00:12:49,840 --> 00:12:50,950
حقًا؟

204
00:12:50,950 --> 00:12:54,680
.يوموغيدا-سينباي وياماغاتا-سينباي هنا يا سينباي

205
00:12:54,680 --> 00:12:55,830
.حسنًا

206
00:12:56,500 --> 00:12:57,540
.خذي

207
00:12:57,540 --> 00:12:59,400
.أتيتُ لأعطيك هذه

208
00:12:59,740 --> 00:13:02,480
.قابلتُ والديكِ

209
00:13:02,480 --> 00:13:04,040
.طلبا منّي أن أعطيك هذه

210
00:13:05,520 --> 00:13:07,020
.شكرًا

211
00:13:07,020 --> 00:13:08,520
.سأرتّبها لاحقًا

212
00:13:12,870 --> 00:13:15,740
.لنقف جميعًا على المسرح معًا

213
00:13:16,590 --> 00:13:19,100
.لا بدّ أن نكون موجودات جميعًا

214
00:13:21,920 --> 00:13:22,900
.حسنًا

215
00:13:28,300 --> 00:13:30,780
!تلقيتُ رسالتكِ والتذاكر

216
00:13:30,780 --> 00:13:33,740
أنت مذهلة! حصلتِ على دور مساعد، صحيح؟

217
00:13:33,740 --> 00:13:36,250
!نحن فخوران بك جدًا يا ميكاكو

218
00:13:36,250 --> 00:13:38,230
.أنت ثمل مجددًا

219
00:13:39,250 --> 00:13:40,710
.سأعود إلى البيت قريبًا

220
00:13:40,710 --> 00:13:43,000
.احرصا على الاعتناء بصحتكما

221
00:13:43,680 --> 00:13:44,540
.نعم

222
00:13:44,540 --> 00:13:45,510
.سأبذل ما بوسعي

223
00:13:46,010 --> 00:13:48,010
،ممثلة صاعدة تغادر أواجيما
مع توقع فترة تعافٍ طويلة

224
00:13:49,030 --> 00:13:51,180
هل ذكروا شيئًا عن ميكا-تشان؟

225
00:13:51,180 --> 00:13:52,220
.نعم

226
00:13:52,220 --> 00:13:55,340
.بشكل طفيف. بالكاد ذكروا اسمها

227
00:13:55,340 --> 00:13:58,210
ماذا يحدث للعروض
في مثل هذه الحالات؟

228
00:13:58,210 --> 00:14:01,080
.مكتوب هنا أنّهم وجدوا بديلة بالفعل

229
00:14:01,080 --> 00:14:02,560
...لنرَ

230
00:14:02,980 --> 00:14:05,980
.يوكي كابوراغي" على ما يبدو"

231
00:14:05,980 --> 00:14:08,100
.يا للأسف

232
00:14:12,660 --> 00:14:14,830
.أحسنتِ في العرض الأخير

233
00:14:14,830 --> 00:14:15,740
.شكرًا

234
00:14:16,030 --> 00:14:18,690
.نلتِ الكثير من المديح

235
00:14:18,690 --> 00:14:19,850
.نعم

236
00:14:19,850 --> 00:14:21,700
نعم"؟ هذا فقط؟"

237
00:14:21,700 --> 00:14:22,760
مشاعرك متضاربة إذًا؟

238
00:14:23,380 --> 00:14:25,110
.نعم، طبعًا

239
00:14:25,520 --> 00:14:29,260
...أعلم أنّ التفكير هكذا غير لائق

240
00:14:29,800 --> 00:14:32,840
.لكن يصعب ألّا أشعر بتضارب

241
00:14:35,090 --> 00:14:37,520
هل سمعتِ عن ميكاكو؟

242
00:14:37,520 --> 00:14:38,530
.لا

243
00:14:38,530 --> 00:14:40,530
.سوى أنّها في المستشفى

244
00:14:41,550 --> 00:14:46,110
زرناها قبل العرض
.لكنّها بدت متعبة جدًا

245
00:14:46,110 --> 00:14:49,050
.قرّرنا ألّا نكثر من الزيارة

246
00:14:52,400 --> 00:14:55,030
.سمعتُ أنّ ميكاكو قد تعتزل

247
00:14:56,100 --> 00:14:59,400
.لكن لا تُحمّلي نفسكِ المسؤولية بأيّ شكل

248
00:15:01,420 --> 00:15:02,800
.أنا بخير

249
00:15:04,290 --> 00:15:06,320
.القرار يعود لها

250
00:15:08,670 --> 00:15:10,130
مرحبًا، ميكاكو؟

251
00:15:10,130 --> 00:15:11,330
.إنّه والدكِ

252
00:15:11,330 --> 00:15:12,680
هل أنت بخير؟

253
00:15:13,310 --> 00:15:15,930
.عليك أن تعودي لفترة للبيت

254
00:15:15,930 --> 00:15:17,440
.ارتاحي قليلًا

255
00:15:18,650 --> 00:15:21,070
.لا داعي للبكاء

256
00:15:21,070 --> 00:15:24,360
.أنتِ كثيرة البكاء يا ميكاكو

257
00:15:27,150 --> 00:15:28,820
.إنّها جميلة

258
00:15:29,240 --> 00:15:31,790
.هذا المستشفى مشهور بحدائقه

259
00:15:32,360 --> 00:15:33,510
.تفضّلي

260
00:15:33,510 --> 00:15:34,830
.شكرًا

261
00:15:34,830 --> 00:15:38,830
أتيتِ لزيارتي من بعيد وتفعلين
.كلّ هذا من أجلي الآن

262
00:15:39,030 --> 00:15:40,280
.لا بأس

263
00:15:40,280 --> 00:15:42,090
.أردتكِ أن تأكليها وهي طازجة

264
00:15:42,450 --> 00:15:44,080
كيف حال العمل؟

265
00:15:44,080 --> 00:15:46,280
.بدأتُ أعتاد عليه

266
00:15:46,280 --> 00:15:47,490
.خذي

267
00:15:47,490 --> 00:15:48,710
.هذه من مياجيما-سان

268
00:15:49,420 --> 00:15:50,710
.شكرًا

269
00:15:56,190 --> 00:15:59,470
.لم أتوقع أنّ هذا سيكون شكل لقائنا مجددًا

270
00:16:00,520 --> 00:16:01,970
.ولا أنا

271
00:16:03,350 --> 00:16:05,610
.كان الأمر يثقل كاهلي

272
00:16:06,030 --> 00:16:10,650
أردتُ أن نكون جميعًا
.جزءًا من أواجيما حتّى النهاية

273
00:16:11,570 --> 00:16:18,030
أردتُ أن أقف على المسرح معكن جميعًا
.وأردتُ أن ترى عائلتي ذلك

274
00:16:19,830 --> 00:16:23,050
.لكن الأمر كان خارج إدارتي آنذاك

275
00:16:25,420 --> 00:16:27,290
...آسفة يا ميكاكو

276
00:16:27,900 --> 00:16:31,000
.لأنّني لم أنجبكِ بصحة أفصل

277
00:16:32,330 --> 00:16:35,750
شعرتُ بالضغط بمعرفتي أنّ أمّي
.علّقت آمالًا كبيرة عليّ

278
00:16:36,300 --> 00:16:39,000
.لكن ذلك كان أيضًا آخر حصن أمل لي

279
00:16:40,220 --> 00:16:41,810
.وذلك ما أبقاني مستمرة

280
00:16:43,450 --> 00:16:46,580
.لذا شعرتُ وكأنّ السُلم سُحِب من تحتي

281
00:16:47,050 --> 00:16:49,770
.حطّمني ذلك حقًا

282
00:16:51,160 --> 00:16:55,410
.لهذا انسحبتُ دون إخبار أحد. وكأنّني هربت

283
00:16:56,510 --> 00:16:59,780
.أنت تسعين للمثالية يا تاكيوشي-سان

284
00:17:00,140 --> 00:17:03,940
لديكِ توقعات كبيرة من نفسكِ
.ومن والدتكِ أيضًا

285
00:17:05,310 --> 00:17:07,090
!سيقول ذلك طبعًا

286
00:17:07,090 --> 00:17:07,960
صحيح؟

287
00:17:07,960 --> 00:17:10,410
.لكنّه محق تمامًا

288
00:17:10,410 --> 00:17:13,800
كنتُ مقتنعة أنّ عليّ
.أن أحقق آمال أمّي

289
00:17:14,930 --> 00:17:21,080
ومقتنعة أنّ عليها تشجيعي
.بالأسلوب الذي أريده

290
00:17:22,330 --> 00:17:27,420
.أظنني لم أستطع مسامحتها لأنّها اعتذرت لي

291
00:17:28,280 --> 00:17:31,060
.لأنّ أملها خاب فِيَّ

292
00:17:31,770 --> 00:17:33,810
.رغم أنّها لم تكُن كذلك أبدًا

293
00:17:35,860 --> 00:17:39,920
.هناك أفكار تحتاج وقتًا لتزول

294
00:17:41,260 --> 00:17:46,270
.ما يُقيّدنا غالبًا هو أنفسنا

295
00:17:47,780 --> 00:17:49,770
.لنُقم لقاء لمّ شمل يومًا ما

296
00:17:49,770 --> 00:17:50,830
.سأدعوها أيضًا

297
00:17:51,090 --> 00:17:53,110
أتقصدين كايو؟

298
00:17:52,710 --> 00:17:57,470
اعتزلت

299
00:17:53,110 --> 00:17:55,300
.كنتُما مقربتين

300
00:17:55,300 --> 00:17:57,190
.ليس دائمًا

301
00:17:58,690 --> 00:18:01,890
.شعرنا بالندم أيضًا

302
00:18:02,310 --> 00:18:06,720
.ربّما كان علينا أن نخاطر ونزوركِ

303
00:18:07,940 --> 00:18:11,910
.لكنّنا أقنعنا أنفسنا أنّنا سنضغطُ عليكِ

304
00:18:13,070 --> 00:18:18,390
.كان ذلك عذرنا لعدم مواجهتكِ

305
00:18:19,510 --> 00:18:21,680
لم نتواصل كلانا بشكل جيّد، صحيح؟

306
00:18:21,680 --> 00:18:23,030
.صدقتِ

307
00:18:24,390 --> 00:18:28,090
بصراحة، مشاعري متضاربة
.بشأن ما حدث

308
00:18:29,300 --> 00:18:32,380
.كنتُ آمل أن نؤدي جميعًا معًا على المسرح

309
00:18:32,380 --> 00:18:34,030
...ومع ذلك

310
00:18:34,860 --> 00:18:37,740
.كنّا دائمًا نفوّت الفرصة

311
00:18:38,990 --> 00:18:43,540
.هربتُ في مرحلة معينة وكايو يوموغيدا غادرت

312
00:18:41,050 --> 00:18:43,370
ميهيتو يوكي

313
00:18:44,710 --> 00:18:49,570
.أُزيحت ساوري ياماغاتا وأنا أخذتُ مكانها

314
00:18:50,950 --> 00:18:53,590
.لم أستطع أن أكفّ عن التفكير بهذه الطريقة

315
00:18:54,180 --> 00:18:56,870
.ها هو هوس المثالية مجددًا

316
00:18:56,870 --> 00:18:58,720
.أنا مترددة فقط

317
00:18:58,720 --> 00:19:00,700
هذا ما أخبركِ به مياجيما-سان، صحيح؟

318
00:19:01,090 --> 00:19:02,840
.يفاجئني أنّك أدركتِ ذلك

319
00:19:02,840 --> 00:19:03,780
.سأدرك طبعًا

320
00:19:05,370 --> 00:19:09,930
ما لم أتوقعه هو
.دعم أمّي القوي لي

321
00:19:11,190 --> 00:19:13,280
...تلك الفتاة

322
00:19:13,280 --> 00:19:16,340
.من اختاروها عندما اضطررتِ لترك الدور

323
00:19:18,360 --> 00:19:20,740
.أنا مندهشة أنّك تتذكرين هذا يا أمّي

324
00:19:20,740 --> 00:19:24,100
.بالطبع، فأنا والدتك
.شعرتُ بأحاسيس مختلفة حيال ذلك

325
00:19:30,130 --> 00:19:33,450
.لديكِ الآن فرصة لتردّي لها الجميل

326
00:19:34,430 --> 00:19:37,860
الأمر يشبه الحديث عن ارتداء
.القميص بأزرار مغلقة بشكل خاطئ

327
00:19:38,310 --> 00:19:40,360
.كان غريبًا كم شعرتُ بتحسن

328
00:19:41,820 --> 00:19:45,110
وذلك أيضًا السبب الوحيد الذي
.دفعني للقدوم إلى هنا

329
00:19:45,680 --> 00:19:48,860
...بالطبع، ليست مناسبة سعيدة ولكن

330
00:19:48,860 --> 00:19:50,190
...لا، هذا

331
00:19:55,150 --> 00:19:57,640
.نعم، هذا مؤلم

332
00:20:01,610 --> 00:20:03,830
.مؤلم ولديّ مشاعر متضاربة حياله

333
00:20:04,340 --> 00:20:06,480
.لطالما أردتُ أداء ذلك الدور

334
00:20:07,990 --> 00:20:11,800
.لكنّني سعيدة أيضًا لأنَّهُم اختاروكِ

335
00:20:12,680 --> 00:20:14,140
.هذه هي الحقيقة

336
00:20:15,720 --> 00:20:18,930
.كانت تلك الحقيقة، وقلتُها بصدق

337
00:20:19,410 --> 00:20:21,840
.لكنّنا نكذبُ قليلًا دائمًا

338
00:20:22,390 --> 00:20:27,410
هناك دائمًا جزء منّا يرفض
.أن يكون عاقلًا وراشدًا

339
00:20:28,590 --> 00:20:31,780
.نريد دائمًا أن نكون المُختارين

340
00:20:32,870 --> 00:20:35,350
.ونُخفي ذلك الغرور

341
00:20:35,710 --> 00:20:37,390
.نتظاهر أنّه غير موجود

342
00:20:38,300 --> 00:20:41,180
.لأنّ هذا ما يفترض أن يكون عليه الكبار

343
00:20:42,630 --> 00:20:44,540
.إلّا في ذلك اليوم

344
00:20:45,200 --> 00:20:48,670
أخرجتُ المشاعر القبيحة
.التي بداخلي

345
00:20:50,280 --> 00:20:51,930
...وميكاكو تلك

346
00:20:51,930 --> 00:20:56,310
"حدّقت بي وكأنّها تقول "نعم، أعلم

347
00:20:57,710 --> 00:20:59,910
.لا بدّ أنّني كنتُ أعلم أيضًا

348
00:21:00,810 --> 00:21:04,320
أنّه حتّى عندما رأت جانبي
الحقيقي، الطفولي، غير اللائق

349
00:21:04,890 --> 00:21:07,520
.لن تضحك حتّى لو ضحك الآخرون

350
00:21:13,070 --> 00:21:17,090
المرجو الامتناع عن طرح
.أسئلة لا تخصّ العرض

351
00:21:13,080 --> 00:21:17,080
الطابق الثاني، قاعة ماتسو

352
00:21:17,460 --> 00:21:21,140
ما كان أول ما خطر ببالكما حين
علِمتما أنّكما ستؤديان دورًا مزدوجًا؟

353
00:21:22,440 --> 00:21:27,720
كان حلمنا منذ أن كنّا
.طالبتين وقد تحقّق أخيرًا

354
00:21:28,280 --> 00:21:30,370
.شعوري مماثل

355
00:21:31,330 --> 00:21:37,600
أفهمُ أنَّكما درستُما معًا لكن
.تاكيوشي-سان تركت أواجيما مُبكّرًا

356
00:21:37,840 --> 00:21:38,890
.نعم

357
00:21:38,890 --> 00:21:41,460
،كنتُ عرضة للمرض آنذاك

358
00:21:41,460 --> 00:21:44,820
.وكنتُ أخشى أن أفوّت عرضًا

359
00:21:44,820 --> 00:21:48,100
فاتخذتُ القرار الصعب بأن
.أُركّز على صحّتي لبعض الوقت

360
00:21:48,110 --> 00:21:50,120
صديقتان قديمتان
تعتليان المسرح
مزدوج في دور

361
00:21:50,290 --> 00:21:52,980
.ربّما لم يكن عليّ أن أنسحب أيضًا

362
00:21:52,980 --> 00:21:54,040
جديًا؟

363
00:21:54,040 --> 00:21:55,830
.لا، أمزح

364
00:21:55,830 --> 00:21:59,630
.أعلم أنّ هذا العالم لا يرحم

365
00:22:00,000 --> 00:22:03,710
لكن تمنّت ميكاكو لو
.أنّك لم تنسحبي أيضًا

366
00:22:05,900 --> 00:22:09,680
.أظنّنا نعيش وفقًا لاختياراتنا