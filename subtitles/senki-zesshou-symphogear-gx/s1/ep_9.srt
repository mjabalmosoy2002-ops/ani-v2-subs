1
00:00:02,990 --> 00:00:04,850
الأوتوسكورر ينسحِبن

2
00:00:05,260 --> 00:00:06,520
أخرجوا هيبيكي-تشان من هناك

3
00:00:06,750 --> 00:00:07,700
أنا ذاهبٌ حالاً

4
00:00:08,590 --> 00:00:10,300
يمكنُنا تدبُّر الأمر

5
00:00:10,300 --> 00:00:13,040
لِذا امضي بمشروع إغنايت من فضلكِ

6
00:00:13,340 --> 00:00:15,520
إتمام السيمفوغير المُحسَّنة

7
00:02:09,230 --> 00:02:13,650
الحلقة 5 - حدّ السيف يفي بالغرض

8
00:02:09,860 --> 00:02:10,980
،افتحي عينيكِ

9
00:02:10,980 --> 00:02:11,960
يا هيبيكي

10
00:02:11,960 --> 00:02:13,480
أرجوكِ يا هيبيكي

11
00:02:19,980 --> 00:02:21,020
...هيبيكي

12
00:02:21,640 --> 00:02:22,670
لا تقلقي

13
00:02:23,070 --> 00:02:24,240
ستكونُ تاتشيبانا بخير

14
00:02:24,480 --> 00:02:25,750
!بالطبع

15
00:02:25,750 --> 00:02:29,750
لن تُقصى تِلك الغبيّة من اللّعبة لسببٍ كهذا

16
00:02:30,730 --> 00:02:32,000
هذا صحيح

17
00:02:32,590 --> 00:02:35,880
ولا يجوز أن نقفَ مكتوفي الأيدي وننتظر أيضاً

18
00:02:44,580 --> 00:02:46,890
...لقد مضى أسبوع

19
00:02:48,030 --> 00:02:50,520
وما زالَتْ هيبيكي لم تستيقظ

20
00:02:51,480 --> 00:02:52,910
عندما تستيقظ

21
00:02:52,910 --> 00:02:55,740
،وتُدرِك بأنَّ الأغنيةَ في قلبِها قد انكسرَتْ

22
00:02:57,290 --> 00:02:58,870
ماذا ستعتقد؟

23
00:03:09,540 --> 00:03:13,270
وكأنّكِ شاردة الذهن، أليس كذلك؟

24
00:03:14,280 --> 00:03:15,170
...أنا

25
00:03:16,520 --> 00:03:17,950
أنا آسفة

26
00:03:17,950 --> 00:03:19,250
،كوهيناتا-سان

27
00:03:19,250 --> 00:03:22,180
احرصي على حلّ المُشكلة التي تُقلقكِ قبل يوم الامتحان من فضلك

28
00:03:22,600 --> 00:03:23,440
حاضر

29
00:03:23,440 --> 00:03:24,730
حسناً، التّالي

30
00:03:31,750 --> 00:03:33,060
...مشروع إغنايت

31
00:03:33,460 --> 00:03:36,040
%بلغَتْ نسبة اكتماله حالياً 89

32
00:03:36,340 --> 00:03:38,650
بفضلِ بياناتِ القطاع 2 القديم

33
00:03:38,650 --> 00:03:40,820
،عن الأثرَين الأوَّل والثاني

34
00:03:41,250 --> 00:03:45,320
وبفضلِ جهود إيلفناين-تشان الحثيثة، أنجزنا ذلك قبل التاريخ المُحدَّد

35
00:03:45,750 --> 00:03:48,350
،بما أنّ ذلك قد تداخلَ مع صيانة المولِّدة

36
00:03:48,350 --> 00:03:50,450
قلِقتُ بشأنِ ما قد يحدث

37
00:03:51,060 --> 00:03:53,580
ولكن لحسن الحظّ، تمكنَّا من الحصولِ على الطاقةِ اللازمة

38
00:03:53,880 --> 00:03:56,260
لتشغيل القاعدة وإبقائها نشِطة، ظاهرياً

39
00:03:57,110 --> 00:04:00,160
ولكن تعديل السيمفوغير يعني

40
00:04:00,160 --> 00:04:02,590
الوصول إلى صميمِ أسرارها

41
00:04:02,870 --> 00:04:04,780
هكذا هي الأوضاع سيّئة

42
00:04:04,780 --> 00:04:07,350
وتدخّلَ ياتسوهيرو بالنيابةِ عنّا أيضاً

43
00:04:07,590 --> 00:04:10,320
من هو ياتسوهيرو؟

44
00:04:10,320 --> 00:04:13,630
أحد الشخصيات البارِزة جداً لدى الحكومة، يحافظُ على الضمانةِ الأمنيّة

45
00:04:13,630 --> 00:04:17,300
بوسائل ترسمُ الحدَّ بين ما هو قانوني وما هو غير قانوني

46
00:04:17,600 --> 00:04:21,990
إنَّ التدخُّل بهذا الشكل وبإجراءاتٍ غير قانونيّة مسألة بسيطة بالنسبةِ له

47
00:04:22,460 --> 00:04:24,640
من يكون أصلاً؟

48
00:04:25,130 --> 00:04:28,120
ضابط في المُخابراتِ الوزاريّة، كازاناري ياتسوهيرو

49
00:04:28,610 --> 00:04:32,120
أخُ القائد ووالدُ تسوباسا-سان

50
00:04:32,370 --> 00:04:34,880
!كان ينبغي أن تقولي ذلك إذاً

51
00:04:34,880 --> 00:04:36,900
لا داعي لتعقيدِ المسألة كثيراً

52
00:04:36,900 --> 00:04:40,020
أعتقدُ بأنه هو أيضاً من

53
00:04:40,020 --> 00:04:42,210
"دعمَ انضمامي لـ"س.و.ن.غ

54
00:04:42,210 --> 00:04:45,070
فهمت... كما توقّعت، إنه من أقربائكِ

55
00:04:46,680 --> 00:04:47,510
ما الأمر؟

56
00:04:51,360 --> 00:04:53,230
تفقدتُ هيبيكي للتو

57
00:04:53,730 --> 00:04:56,410
،ما زالَتْ موصولة بأجهزةِ حفظ الحياة

58
00:04:56,410 --> 00:04:59,110
ولكن لا وجود لجروح ظاهريّة غائرة، ستكونُ بخير

59
00:04:59,960 --> 00:05:01,540
شكراً لك

60
00:05:16,380 --> 00:05:17,370
أبي؟

61
00:05:18,490 --> 00:05:20,130
انفجرَتْ

62
00:05:37,380 --> 00:05:38,690
هل هو لذيذ؟

63
00:05:39,110 --> 00:05:41,930
إنه حامضٌ ورائحته نتِنة وليسَ لذيذاً على الإطلاق

64
00:05:41,930 --> 00:05:43,940
أعطيه صفراً من عشرة

65
00:05:45,690 --> 00:05:47,200
يُفترَض أن يكون الطبخ كالخيمياء

66
00:05:47,730 --> 00:05:51,200
اتبع الوصفة وستكونُ الأمور على ما يُرام

67
00:05:51,560 --> 00:05:54,120
لماذا لا أستطيع فعلها مثل أمّكِ؟

68
00:05:55,430 --> 00:05:57,290
أنا سأُعِدُّ العشاءَ غداً

69
00:05:57,720 --> 00:05:59,960
بهذا الشكل، سيغدو أطيب بالتأكيد

70
00:06:00,240 --> 00:06:01,740
هل هنالِك خدعة وراء ذلك؟

71
00:06:02,120 --> 00:06:03,100
هذا سرّ

72
00:06:03,450 --> 00:06:05,650
يمكنُك أن تكتشفَ السرَّ بنفسك

73
00:06:05,650 --> 00:06:07,470
أنت خيميائي، صحيح؟

74
00:06:09,510 --> 00:06:11,260
إنها مهمّةٌ صعبةٌ بالتأكيد

75
00:06:11,840 --> 00:06:13,390
،ريثما تجدُ الحلّ

76
00:06:13,390 --> 00:06:16,290
سأظلُّ أعِدُّ لك الطعام

77
00:06:26,870 --> 00:06:28,030
...حلم

78
00:06:28,810 --> 00:06:31,850
ذكريات كارول من مئاتِ السنين

79
00:06:34,240 --> 00:06:36,540
هل نمتُ لعشر دقائق أو ما قارب؟

80
00:06:37,580 --> 00:06:39,790
ولكن ينبغي لهذا أن يصفِّي ذهني أكثر

81
00:06:40,570 --> 00:06:42,790
يجبُ أن أسرِع وأعدِّل الدروع

82
00:06:43,780 --> 00:06:45,850
،كارول... عيشي

83
00:06:46,150 --> 00:06:47,760
وتعلَّمي أكثر عن العالم

84
00:06:48,130 --> 00:06:49,760
العالم؟

85
00:06:50,500 --> 00:06:52,140
...كارول، أهذا ما كان

86
00:06:53,510 --> 00:06:56,300
أبوكِ يحاول أن يقوله لها؟

87
00:06:56,990 --> 00:06:58,990
،أردتُ معرِفة الإجابة

88
00:06:58,990 --> 00:07:01,910
لهذا قرّرتُ حماية العالم من كارول

89
00:07:03,150 --> 00:07:04,770
ولكن لماذا منحَتْني

90
00:07:05,900 --> 00:07:07,890
،كارول ذكرياتها

91
00:07:07,890 --> 00:07:11,890
ولم تمنحني المعرفة الخيميائيّة فقط؟

92
00:07:16,010 --> 00:07:18,340
حان الوقت، لنُنهِ هذا الأمر

93
00:07:21,030 --> 00:07:22,580
تمَّ رصد إشارة آلكا-نويز

94
00:07:22,850 --> 00:07:24,410
جاري تحديد الإحداثيات

95
00:07:27,180 --> 00:07:28,920
...لا... العدو يستهدف

96
00:07:30,960 --> 00:07:34,800
مولِّدة القاعدة التي تغذِّينا بالطاقة

97
00:07:35,240 --> 00:07:36,810
ما الذي يجري؟

98
00:07:37,030 --> 00:07:40,100
الآلكا-نويز يهاجمون مولِّدة الحوض

99
00:07:40,100 --> 00:07:41,530
!ليسَ مولّدتنا فحسب

100
00:07:41,850 --> 00:07:44,800
هنالِك هجمات مُماثِلة تُشَنُّ في كل أنحاء المدينة

101
00:07:44,800 --> 00:07:47,730
ينخفضُ معدَّلُ التزويد بالطاقة الكهربائية في كلّ مكان

102
00:07:48,310 --> 00:07:50,980
،إذا انقطعتِ الطاقة الكهربائية الآن

103
00:07:50,980 --> 00:07:53,490
فسيؤثِّرُ ذلك على مُحاولتِنا لتعديلِ الدروع

104
00:07:53,790 --> 00:07:56,660
لن تصمدَ الطاقة الداخليّة تِلك المدّة

105
00:07:56,950 --> 00:07:58,790
...إذاً الغرفة الطبِّية

106
00:08:02,290 --> 00:08:04,620
ما الأمر يا شيرابي؟

107
00:08:05,070 --> 00:08:06,790
...صه

108
00:08:12,140 --> 00:08:14,810
ماذا ستفعلين

109
00:08:14,810 --> 00:08:16,930
بنظّارتكِ الجاسوسيّة الجميلة؟

110
00:08:16,930 --> 00:08:18,060
أَكسبُ الوقت

111
00:08:18,060 --> 00:08:19,010
ماذا؟

112
00:08:19,250 --> 00:08:22,020
الأمر المهمّ الآن هو كسب الوقت

113
00:08:22,020 --> 00:08:25,710
والطاقة اللّازمتَين لإكمالِ السيمفوغير المُحسَّنة

114
00:08:25,710 --> 00:08:29,070
هذا صحيح، ولكن لا نستطيعُ فعل شيء دون رسم خطّة

115
00:08:32,060 --> 00:08:34,320
أملكُ خطّةً يا كيري-تشان

116
00:08:36,690 --> 00:08:38,450
الغرفة الطبِّية؟

117
00:08:39,760 --> 00:08:43,030
هل سنكسبُ وقتاً لأجلِ تعديلِ الدرع في مكانٍ كهذا؟

118
00:08:43,030 --> 00:08:46,310
في هذه الحالة، لن نتمكّنَ من الحفاظِ على الطاقةِ الكهربائيّةِ في الغرفة الطبِّية أيضاً

119
00:08:52,910 --> 00:08:56,800
!قولي فقط إذاً أن هناك شخص تُريدين إنقاذه

120
00:08:56,800 --> 00:08:57,720
لا

121
00:08:58,080 --> 00:08:59,430
لِمَ لا؟

122
00:09:00,550 --> 00:09:01,630
هذا محرِج

123
00:09:02,450 --> 00:09:03,920
لا أريد أن أدعَ أحداً

124
00:09:03,920 --> 00:09:06,600
يراني أقولُ أو أفعلُ شيئاً محرِجاً سواكِ

125
00:09:09,480 --> 00:09:10,980
!شيرابي

126
00:09:16,230 --> 00:09:19,410
تباً، ماذا كان ذلك؟

127
00:09:21,100 --> 00:09:22,240
وجدتُه

128
00:09:27,670 --> 00:09:31,510
حواجِز إزاحة الطُّور الخاصّة بنويز الجديد ليسَتْ متينة كحواجِز النويز القديم

129
00:09:31,510 --> 00:09:33,960
كثِّفوا نيرانكم وتجنَّبوا أعضائهم التحليليّة

130
00:09:39,940 --> 00:09:41,130
!يمكننا أن ننجح

131
00:09:45,770 --> 00:09:46,600
!لنبدأ

132
00:09:46,600 --> 00:09:47,340
حسناً

133
00:09:47,890 --> 00:09:57,280
فاليان شول شاغانا ترون

134
00:10:32,400 --> 00:10:33,730
آلفا السامسارا المئة نوع

135
00:10:40,990 --> 00:10:42,570
اقتل جولييت

136
00:10:51,870 --> 00:10:53,280
لستِ بسيّئة

137
00:10:54,570 --> 00:10:57,050
شول شاغانا وإيغاليما قد دخلَتا القتال

138
00:10:57,530 --> 00:11:00,380
هل تعيان ما تقومان به؟

139
00:11:00,380 --> 00:11:01,820
!بالطبع

140
00:11:01,820 --> 00:11:05,440
أثناء تصدِّينا لهم، أكمِلوا العمل على السيمفوغير المُحسَّنة

141
00:11:21,420 --> 00:11:23,570
...ما دامَتْ لا تُصيب

142
00:11:30,960 --> 00:11:32,370
دلتا قفزة التزلُّج الدائرية الساحرة نوع

143
00:11:38,300 --> 00:11:40,440
رغمَ تعاونهما معاً، بالكاد تستطيعان الصمود

144
00:11:40,440 --> 00:11:42,640
إنّهما هالِكتان

145
00:11:57,400 --> 00:12:01,610
جاهدتُ في عِلاجي كي أستطيع العيش مع الجميع مُجدّداً

146
00:12:02,340 --> 00:12:04,260
...فلماذا إذاً

147
00:12:04,260 --> 00:12:05,540
!أبي

148
00:12:17,160 --> 00:12:20,260
كلّ ما أفعله هو سحقُ الأشياء التي تهمّني

149
00:12:21,670 --> 00:12:24,190
ولكن ميكو شجّعَتْني

150
00:12:24,190 --> 00:12:26,340
قالَتْ أنني أنقذتُها

151
00:12:29,130 --> 00:12:31,150
يجبُ أن أرتقي لمشاعرها

152
00:12:41,670 --> 00:12:44,990
الأعضاء الحيويّة لدى شول شاغانا وقابِضات-إيغاليما مستقرّة؟

153
00:12:45,560 --> 00:12:48,170
اشتعال الدروع الخلفيّ يتخفَّف

154
00:12:48,170 --> 00:12:49,990
ما الذي يجري؟

155
00:12:50,440 --> 00:12:53,320
أكان هذا هو سبب الصافِرة إذاً؟

156
00:12:53,320 --> 00:12:53,870
نعم

157
00:12:54,330 --> 00:12:57,250
سرقوا "الواصل" من الغرفةِ الطبِّية

158
00:12:57,630 --> 00:13:01,260
لا أظنُّك تعني النموذج ك... الواصِل الذي تركَتْه كانادي لنا

159
00:13:02,180 --> 00:13:06,140
أنتِ من النوع الذي لا يستطيع فعل أي شيء بالطريقةِ المُسالِمة، أليس كذلك يا شيرابي؟

160
00:13:06,820 --> 00:13:09,900
سيكونُ ذلك منطقياً لو أنَّ الغرفة الطبِّية

161
00:13:09,900 --> 00:13:12,590
احتوَتْ على عقاقير لمعالجةِ الاشتعال الخلفيّ للسيمفوغير

162
00:13:12,590 --> 00:13:16,150
هُنا تعافينا بعدَ التدريب

163
00:13:21,230 --> 00:13:23,030
...ريثما يتمّ تعديل الدروع

164
00:13:23,150 --> 00:13:25,650
سنحمي المولِّدة

165
00:13:37,080 --> 00:13:39,630
تمَّ تدمير الهدف، هذا مُبهرَج

166
00:13:43,650 --> 00:13:45,700
...كقلعةٍ من كتل خشبيّة

167
00:13:45,700 --> 00:13:48,720
لسنا بحاجةٍ حتّى لمساعدة من أخت ليور-تشان الصغيرة

168
00:14:18,800 --> 00:14:21,770
ينخفضُ تزويدُ المنطِقة الهدف بالطاقة

169
00:14:22,120 --> 00:14:24,640
سيصِلُ عمّا قريب إلى رقمِ الهدف

170
00:14:24,640 --> 00:14:26,980
سأتركُ تحرير خطّ لاي عليكِ

171
00:14:27,290 --> 00:14:30,300
سأبدأ بالتحضيراتِ الأخيرة

172
00:14:31,080 --> 00:14:32,810
هل ستبدأ أخيراً إذاً؟

173
00:14:33,190 --> 00:14:34,850
إنها النِّهاية أخيراً

174
00:14:35,150 --> 00:14:36,680
وسيُدوَّنُ كل شيء

175
00:14:38,670 --> 00:14:40,560
في نهايةِ العالم

176
00:14:40,560 --> 00:14:42,190
!حسناً

177
00:14:51,460 --> 00:14:52,830
شيرابي، كيريكا

178
00:14:53,060 --> 00:14:54,910
لن نقفَ مكتوفات الأيدي

179
00:14:56,790 --> 00:14:57,620
!انتظري

180
00:14:57,890 --> 00:14:59,460
ما الذي يمكنُنا فعله الآن؟

181
00:15:00,010 --> 00:15:02,130
هل تريديننا أن نصمتَ ونكتفي بالمُراقبة؟

182
00:15:10,490 --> 00:15:12,140
...تسوباسا-سان، كريس-سان

183
00:15:12,950 --> 00:15:15,510
أريدُ أن أطلبَ منكما شيئاً

184
00:15:20,270 --> 00:15:22,690
لن تدعنا نذهبُ بسهولة

185
00:15:26,150 --> 00:15:27,950
مرحباً يا صغيرتَين

186
00:15:28,660 --> 00:15:30,200
أنا قويةٌ جداً

187
00:15:30,430 --> 00:15:32,200
"إنها تهيننا بمُناداتِنا بـ"صغيرتين

188
00:15:32,720 --> 00:15:34,740
لنُلقّنها درساً

189
00:15:35,890 --> 00:15:37,120
يستخدمان مزيداً من الواصل؟

190
00:15:37,450 --> 00:15:38,810
أعيدوهما إلى هنا

191
00:15:38,810 --> 00:15:39,870
...إذا استُخدِم أكثر

192
00:15:39,200 --> 00:15:40,620
اتركوهما

193
00:15:41,420 --> 00:15:43,710
هذا تكفيرُهما

194
00:15:43,710 --> 00:15:45,880
عن جبنِهما في ذلك اليوم

195
00:15:46,280 --> 00:15:48,380
تكفيرهما عن جبنِهما؟

196
00:15:49,680 --> 00:15:52,500
ضلَلنا طريقنا وهربنا لأنَّنا افتقرنا

197
00:15:52,500 --> 00:15:54,820
لشجاعةِ الإيمانِ بشخص

198
00:15:55,440 --> 00:16:00,060
وسنُكفِّرُ بالقتالِ والإيمان بأنَّ إيلفناين

199
00:16:00,420 --> 00:16:02,520
ستُحيي السيمفوغير

200
00:16:14,010 --> 00:16:14,990
...إن كنَّا سويةً

201
00:16:14,990 --> 00:16:16,370
فلن نخاف...

202
00:16:27,280 --> 00:16:28,750
...جرعة زائدة

203
00:16:31,920 --> 00:16:34,190
من يأبه بنزيفٍ أنفي؟

204
00:16:34,950 --> 00:16:37,010
هيّا بنا يا كيري-تشان، سويةً

205
00:16:37,380 --> 00:16:38,680
لنقطعها إلى نصفين

206
00:16:42,940 --> 00:16:44,020
تيكن رابونزيل

207
00:16:49,450 --> 00:16:52,240
هل ستجعلانها معركة مُمتِعة لي؟

208
00:17:14,380 --> 00:17:15,760
غامّا عجلة نار الصليب المعقوف نوع

209
00:17:22,730 --> 00:17:24,100
سيغما عجلة القمر المحرَّمة نوع طارئ

210
00:17:40,580 --> 00:17:43,790
الألفةُ بينهما أقوى حتّى مما تشيرُ إليه الأرقام

211
00:17:44,130 --> 00:17:46,790
ولكن نورهما لن يصمدَ طويلاً

212
00:17:47,170 --> 00:17:49,080
وعلى الرغمِ من ذلك، شيرابي وكيريكا

213
00:17:49,080 --> 00:17:52,610
ستُقطِّعان الأشواك من أمامهما وتُمهِّدان طريقاً

214
00:18:01,990 --> 00:18:05,270
بالكفاح، حتّى الطفل قادِر على إخمادِ كميّة جيّدة من التضخيم الصوتيّ

215
00:18:34,650 --> 00:18:35,980
انفجار

216
00:18:46,290 --> 00:18:47,900
جاري التحويل إلى الطاقة الداخليّة

217
00:18:50,290 --> 00:18:51,410
لا تستسلما

218
00:18:52,130 --> 00:18:53,840
...أرجوكِ يا سيرينا

219
00:18:53,840 --> 00:18:55,320
امنحيهما معجزة

220
00:18:57,100 --> 00:18:57,920
!هيبيكي-كون

221
00:18:58,550 --> 00:18:59,610
!هيبيكي

222
00:19:01,950 --> 00:19:03,210
شكراً لكِ

223
00:19:03,210 --> 00:19:04,800
...بفضلكِ

224
00:19:04,800 --> 00:19:05,910
لا، شكراً لكِ أنتِ

225
00:19:06,370 --> 00:19:09,160
استطعتُ الغناء مجدداً بفضلكِ

226
00:19:11,290 --> 00:19:13,270
ولكن هل أنتِ بخير؟

227
00:19:13,270 --> 00:19:15,500
أنا بخير، كلّ الخير

228
00:19:18,620 --> 00:19:20,930
أخبريني عن ما يجري

229
00:19:26,550 --> 00:19:28,670
في هذه الحالة، لن يتغيّر شيء

230
00:19:28,670 --> 00:19:29,560
لا يمكننا تغيير شيء

231
00:19:29,870 --> 00:19:31,670
...لكننا نحاولُ جاهدتَين

232
00:19:31,670 --> 00:19:32,910
لماذا؟

233
00:19:33,210 --> 00:19:35,820
هذا ليسَ عدلاً، أريدُ التغيير

234
00:19:35,820 --> 00:19:37,320
لستُما سيّئتَين

235
00:19:37,770 --> 00:19:40,320
ولكن حانَ الوقتُ لإيقافِ اللّهو

236
00:19:46,960 --> 00:19:49,520
!وداعاً

237
00:19:59,090 --> 00:19:59,880
كيري-تشان

238
00:20:04,560 --> 00:20:07,850
انتبهي وإلّا ضربتكِ من الخلف

239
00:20:10,380 --> 00:20:11,600
!لا تعترضي طريقي

240
00:20:11,600 --> 00:20:13,260
سأسحقُ درعكِ أيضاً

241
00:20:13,260 --> 00:20:15,690
!كي تصبحي مثلها

242
00:20:16,550 --> 00:20:20,820
ميكا، قيمة توافقيّتها منخفِضة جداً لدرجة لا تستحقُّ الاهتمام

243
00:20:21,060 --> 00:20:22,700
افعلي بها ما تشائين

244
00:20:22,700 --> 00:20:24,410
!حسناً

245
00:20:24,410 --> 00:20:25,420
!هيّا

246
00:20:35,270 --> 00:20:36,090
هل ترين؟

247
00:20:36,530 --> 00:20:39,090
اهربي... يا شيرابي

248
00:20:39,390 --> 00:20:41,760
لا أستطيع الهرب وترككِ هنا

249
00:20:42,160 --> 00:20:45,390
أنقذتِ حياتي

250
00:20:45,770 --> 00:20:48,600
سأستخدمُ كلّ ما لديّ لإنقاذكِ

251
00:20:48,990 --> 00:20:52,100
حانَ وقتُ التحليل

252
00:21:06,700 --> 00:21:08,950
!ابتعدوا

253
00:21:09,830 --> 00:21:12,880
...فلينقذها... أحدٌ ما

254
00:21:13,800 --> 00:21:15,480
...صديقتي

255
00:21:15,910 --> 00:21:17,840
عزيزتي شيرابي

256
00:21:33,210 --> 00:21:34,600
فليُنقذ أحدُكم شيرابي

257
00:21:36,020 --> 00:21:39,500
!فليُنقذها أحد

258
00:21:58,300 --> 00:22:02,300
أتقولين "أحد"؟ هذا ليسَ لبِقاً جداً

259
00:22:04,350 --> 00:22:05,630
...سيف

260
00:22:06,510 --> 00:22:07,260
نعم

261
00:22:08,280 --> 00:22:10,560
سيف إذا أُشهِرَ أثارَ الرّياح