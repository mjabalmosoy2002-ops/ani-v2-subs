1
00:00:02,950 --> 00:00:05,510
أهذه سيرينا أيرغيتلام؟

2
00:00:05,960 --> 00:00:10,250
لا يجوز إدخال سيمفوغير متضرِّر في مهمّة أبداً

3
00:00:10,250 --> 00:00:11,280
خذي هذه

4
00:00:13,650 --> 00:00:14,810
ستُجبَرين على

5
00:00:14,810 --> 00:00:17,910
نقلِ الأكاذيب معكِ إلى المعركة

6
00:00:18,490 --> 00:00:20,260
إنه شيءٌ صغيرٌ يُبقيكِ في أمان

7
00:00:22,560 --> 00:00:23,750
شكراً لكِ يا أمِّي

8
00:00:24,070 --> 00:00:25,090
سأكونُ بخير

9
00:00:25,910 --> 00:00:29,500
هل سأتمكّنُ من التألُّقِ بشكلٍ مُبهِر مثل سيرينا؟

10
00:00:34,840 --> 00:00:35,870
...مُبهِر

11
00:00:40,800 --> 00:00:41,950
آلكا-نويز

12
00:02:34,000 --> 00:02:35,840
تمّ رصد إشارة آلكا-نويز

13
00:02:36,220 --> 00:02:37,840
جاري حصر الإشارة

14
00:02:38,090 --> 00:02:40,070
لقد جعلَتْ معلومات إيلفناين قدرةَ

15
00:02:40,070 --> 00:02:42,180
رصدِنا أكثر دقّة بكثير

16
00:02:43,630 --> 00:02:45,500
...سنُرسِلُ القابِضات

17
00:02:46,790 --> 00:02:50,100
جعل شيرابي-تشان وكيريكا-تشان تُقاتِلان بوضعِهما الرّاهن فيه تهوُّر

18
00:02:50,350 --> 00:02:52,350
،ومن دون دروع صالِحة للاستعمال

19
00:02:52,350 --> 00:02:55,300
لا يمكننا إرسال تسوباسا-سان وكريس-تشان أو حتَّى ماريا-سان

20
00:02:56,760 --> 00:03:00,340
فقط هيبيكي-تشان من تمتلِك درعاً نشِطاً

21
00:03:01,670 --> 00:03:05,340
سأدوسُ على حديقةِ الأزهارِ الصغيرةِ المثاليّة تِلك التي في ذهنكِ

22
00:03:16,390 --> 00:03:17,490
هيبيكي؟

23
00:03:20,720 --> 00:03:21,930
...لا أستطيعُ الغناء

24
00:03:22,460 --> 00:03:23,090
ماذا؟

25
00:03:24,090 --> 00:03:26,350
استسلمي فحسب

26
00:03:28,510 --> 00:03:31,850
...لا تستحضرني الكلمات المُقدَّسة

27
00:03:34,690 --> 00:03:37,020
غانغنير لا تُجيبني

28
00:03:38,780 --> 00:03:40,470
إنها لا ترفضُ الغناء

29
00:03:40,860 --> 00:03:41,990
لا تستطيع؟

30
00:03:42,830 --> 00:03:43,410
!أوغاوا

31
00:03:43,410 --> 00:03:44,670
سأفعل

32
00:03:46,990 --> 00:03:48,050
ما الذي يجري؟

33
00:03:48,050 --> 00:03:49,750
سأساعدُ هيبيكي-سان

34
00:03:55,000 --> 00:03:58,130
لماذا لا تستحضرني الكلِمات المُقدَّسة؟

35
00:04:01,050 --> 00:04:04,860
...من دون درعِها، لا جدوى من مُقاتلتها

36
00:04:04,860 --> 00:04:09,640
رُبَّما ينبغي أن أستهدفَ إحدى صديقاتها الصغيرات؟

37
00:04:10,800 --> 00:04:12,560
!يا للإزعاج

38
00:04:17,110 --> 00:04:19,690
لا أعرِف ما هي مُشكلتكِ مع تاتشيبانا

39
00:04:20,110 --> 00:04:23,350
ولكن إن كان هذا الأمرُ سيطول فهلَّا استبعدتِنا منه؟

40
00:04:23,620 --> 00:04:26,620
ألستنّ معها؟

41
00:04:26,620 --> 00:04:27,890
بالطبع لا

42
00:04:27,890 --> 00:04:29,940
فقد صدفَتْ عودتنا معاً إلى المنزل

43
00:04:29,940 --> 00:04:31,620
والآن أفسِحي الطريق

44
00:04:39,810 --> 00:04:40,710
هيّا بنا

45
00:04:48,260 --> 00:04:51,100
تتصرَّفين بشجاعة في أغرب الأوقات

46
00:04:51,100 --> 00:04:53,680
في المعرضِ المدرسيّ العام الماضي كنتِ مُختلِفة كلّياً

47
00:04:53,680 --> 00:04:55,450
هل كانَ ذلك ادِّعاء آنذاك؟

48
00:04:55,450 --> 00:04:58,520
يتوجّبُ علينا مُساعدة بيكي بين الفيّنة والأخرى، صحيح؟

49
00:04:58,960 --> 00:05:01,400
لا أقصدُ التبجُّح، ولكن أظنُّها كانَتْ خطّة رائعة

50
00:05:03,850 --> 00:05:08,320
والآن سأسحقُ كلّ آمالكن

51
00:05:20,880 --> 00:05:25,470
إذا قذفتُكِ وأسقطتُكِ أرضاً فقد تنتابكِ الرغبة بالقتال، أليس كذلك؟

52
00:05:25,470 --> 00:05:27,720
نحنُ لسنا في أنيمي

53
00:05:34,220 --> 00:05:34,930
!درعي

54
00:05:49,870 --> 00:05:50,820
ماريا-سان

55
00:06:28,780 --> 00:06:30,110
رمح الأفق

56
00:06:35,260 --> 00:06:37,870
ما دمتُ أمتلكُ هذه القوّة، أستطيعُ القتال

57
00:06:38,370 --> 00:06:40,870
...غانغنير الأسود

58
00:06:41,240 --> 00:06:43,110
لقد وصلَتْ أوغاوا-سان وماريا-سان

59
00:06:43,110 --> 00:06:44,800
اشتبكَتْ مع العدو بغانغنير

60
00:06:45,040 --> 00:06:45,820
ماريا-كون

61
00:06:45,820 --> 00:06:48,050
الجزء الذي يُضيء عندَ الهجوم هو عضو التشريح

62
00:06:48,500 --> 00:06:49,860
تنبَّهي له

63
00:07:04,150 --> 00:07:06,540
حدَث مُفاجئ تِلو الحدَث المُفاجئ

64
00:07:06,540 --> 00:07:08,250
الحُثالة التي تخلَّينا عنها

65
00:07:08,250 --> 00:07:10,650
تُثبِتُ بأنها تفوقُ توقُّعاتنا بكثير

66
00:07:18,380 --> 00:07:20,160
ماريا-سان تُقاتل

67
00:07:20,590 --> 00:07:22,790
بغانغنير خاصّتي

68
00:07:33,820 --> 00:07:34,890
...حتَّى بهذا

69
00:07:48,440 --> 00:07:52,110
ينبغي أن ترتجفي برداً

70
00:07:57,320 --> 00:08:00,370
لقد قرّرت... أنتِ خصمي

71
00:08:02,690 --> 00:08:04,590
وقت الطعام الخفيف

72
00:08:20,500 --> 00:08:22,520
أهذا كُل ما لديكِ على الرُّغم من ذلك؟

73
00:08:25,110 --> 00:08:26,600
ما هذا؟

74
00:08:27,190 --> 00:08:29,980
ألا تستطيع أيّ منكن الغِناء فعلاً؟

75
00:08:30,260 --> 00:08:32,180
لم يُخبرني أحدٌ بذلك

76
00:08:35,460 --> 00:08:37,090
هذا سيئ

77
00:08:41,690 --> 00:08:43,210
...انتقال فوري مكانيّ

78
00:08:43,520 --> 00:08:46,080
أتِلك خيمياء كذلك؟

79
00:08:48,280 --> 00:08:51,400
،بما أنَّها قادرة على إتمام النوع الجديد من نويز في العصرِ الحديث

80
00:08:51,730 --> 00:08:55,800
فهذا يعني أنها تمتلكُ التقنيّة للتأثيرِ على فضاءِ الطور

81
00:08:55,800 --> 00:08:58,220
انسي ذلك، هل الجميعُ بخير؟

82
00:08:58,520 --> 00:09:00,140
ذهبَتْ ماريا-سان إلى هناك

83
00:09:00,140 --> 00:09:02,810
واستخدمَتْ غانغنير للتصدِّي للعدو

84
00:09:02,810 --> 00:09:04,460
!ماذا قلتِ؟

85
00:09:04,460 --> 00:09:07,990
...هل هذا يعني أنّها مثلنا

86
00:09:09,050 --> 00:09:13,030
كانَتْ تُعاني من تنافُر السيمفوغير أثناء القِتال

87
00:09:13,380 --> 00:09:14,850
جنون

88
00:09:19,860 --> 00:09:21,340
لو لم أتخلَّ فقط

89
00:09:21,730 --> 00:09:23,970
...عن الغانغنير

90
00:09:25,080 --> 00:09:27,870
لا، لن يُفيد الندم

91
00:09:34,450 --> 00:09:35,520
هل تأذّيتن؟

92
00:09:36,050 --> 00:09:39,300
...نحنُ بخير، ولكن أنتِ في وضعٍ مُزرٍ

93
00:09:39,550 --> 00:09:41,930
قاتلتِ وغنِّيتِ وتأذّيتِ كثيراً

94
00:09:41,930 --> 00:09:43,320
هل أنتَ بخير؟

95
00:09:45,910 --> 00:09:46,890
...الغانغنير خاصّتكِ

96
00:09:46,890 --> 00:09:48,460
هذه الغانغنير لي

97
00:09:47,840 --> 00:09:48,810
هيبيكي

98
00:09:48,810 --> 00:09:51,920
يُفترَض أن تكون هذه القوّة لإنقاذِ الناس

99
00:09:51,920 --> 00:09:55,310
كنتُ أنا من حصلَ عليها، إنها الغانغنير خاصَّتي

100
00:10:01,290 --> 00:10:02,470
أنا آسفة

101
00:10:08,140 --> 00:10:09,370
هل تتهرَّبين؟

102
00:10:09,370 --> 00:10:11,590
لا أظنُّني أتهرَّب

103
00:10:12,150 --> 00:10:13,130
...ولكن

104
00:10:13,130 --> 00:10:17,930
،منذُ أن أدركتُ بأنَّ الغانغنير هي قوَّتي الخاصّة حقّاً

105
00:10:17,930 --> 00:10:21,600
كرِهتُ فكرةَ أذيّة الآخرين بقوّة

106
00:10:22,190 --> 00:10:24,010
ينبغي أن تُستخدَم لمُساعدتهم

107
00:10:26,230 --> 00:10:27,060
هذا صحيح

108
00:10:27,450 --> 00:10:29,490
الغانغنير هي قوّتكِ

109
00:10:29,490 --> 00:10:32,190
لِذا لا تصرفي أنظاركِ عنها

110
00:10:33,060 --> 00:10:35,590
لا أصرف أنظاري؟

111
00:10:47,340 --> 00:10:48,370
...غاري

112
00:10:48,730 --> 00:10:51,250
!لا تنظري إليّ بهذا الشكل رجاءً

113
00:10:51,710 --> 00:10:53,330
،إحداهن لم تستطع الغناء

114
00:10:53,330 --> 00:10:56,600
...والأخرى غنَّتْ ولكن عجِزَتْ عن فعل شيء

115
00:10:57,140 --> 00:11:01,010
لن يعودَ تمزيقُ تِلك الأغاني علينا بأي نفع إطلاقاً

116
00:11:01,270 --> 00:11:05,620
إن لم تنسي سببَ تكوينكِ فلا مُشكلة

117
00:11:08,570 --> 00:11:12,270
...لا أريد القتال باستخدامِ قوّة الغاية منها إنقاذ النّاس

118
00:11:12,270 --> 00:11:15,770
!هل ستُحاولين إذاً إنقاذ النّاس وتُقتَلين أيضاً؟

119
00:11:18,570 --> 00:11:22,280
ولكن في المرّةِ المُقبِلة، أوقفي ودمِّري أغانيها

120
00:11:22,280 --> 00:11:25,130
إنَّ مزيداً من التأخُّر سيؤثِّرُ على الخطّة

121
00:11:25,800 --> 00:11:27,640
...إطلاق عنان خطوط لاي

122
00:11:27,960 --> 00:11:29,120
هذا مفهومٌ بالطبع

123
00:11:29,730 --> 00:11:31,500
اتركي الأمر لي

124
00:11:33,510 --> 00:11:36,140
سأعطيكِ ميكا، إنها مُعدَّلة خصِّيصاً للقتال

125
00:11:36,140 --> 00:11:37,000
مفهوم؟

126
00:11:37,000 --> 00:11:38,260
أنا جاهِزة للانطلاق

127
00:11:38,260 --> 00:11:40,260
لا تخبريها بذلك

128
00:11:41,930 --> 00:11:46,190
...ليتَ ذلك الدرع الفاشِل للقابِضة لم يتعطَّل

129
00:11:52,280 --> 00:11:53,730
أتُعانين من الأرق؟

130
00:11:54,910 --> 00:11:57,770
آسفة... أنا أثيرُ قلقكِ

131
00:11:58,220 --> 00:12:00,780
أنتِ تفكِّرين باليوم، أليس كذلك؟

132
00:12:01,850 --> 00:12:03,330
لا أستطيعُ القتال

133
00:12:03,860 --> 00:12:05,280
أنا خائفةٌ جداً

134
00:12:05,580 --> 00:12:09,450
من الغناءِ وأذيّة شخص بيدَيّ الاثنتين

135
00:12:09,910 --> 00:12:12,730
ضعفي يُعرِّضكن جميعاً للخطر

136
00:12:13,740 --> 00:12:14,610
...لكن

137
00:12:21,380 --> 00:12:24,620
أعلمُ بأنّ أغانيكِ

138
00:12:24,620 --> 00:12:27,190
لم توجَد لأذيّة أحد

139
00:12:37,270 --> 00:12:40,030
أمِّي، آسِفة لتأخُّرنا

140
00:12:40,380 --> 00:12:42,870
هذا هو مذاقُ اليابان الذي تحبِّينه

141
00:12:42,870 --> 00:12:45,030
،كنتُ مُعترِضة على ذلك

142
00:12:45,290 --> 00:12:47,990
ولكن تتمتّعُ كيري-تشان بذوقٍ عام أكثر مما أتمتَّع، وكانَتْ مُصِرّة

143
00:12:48,330 --> 00:12:51,370
قطعة فرونتير التي عادَتْ معكِ

144
00:12:51,370 --> 00:12:53,380
وبيانات الأنقاض القمريّة

145
00:12:53,380 --> 00:12:56,120
جاري التَّحقيق فيها بواسطة مُنظَّمات في كل أنحاء العالم

146
00:12:56,120 --> 00:13:00,500
نحاولُ إجراء أبحاث عليها سويةً واستخدامها لمُساعدة الناس

147
00:13:00,760 --> 00:13:02,180
،يستغرقُ هذا وقتاً

148
00:13:02,180 --> 00:13:05,030
ولكن يبدو بأنَّ العالم يتغيّرُ رويداً رويداً

149
00:13:06,040 --> 00:13:08,650
ليسَ العالم وحده الذي يُحاولُ أن يتغيَّر

150
00:13:09,050 --> 00:13:11,140
...ولكن أنا الوحيدة التي

151
00:13:11,750 --> 00:13:14,250
الأيرغيتلام التي قاتلَتِ النيفيليم

152
00:13:14,250 --> 00:13:16,400
...والغانغنير التي ارتديتُها مُجدّداً

153
00:13:16,770 --> 00:13:18,900
إنَّ ما يجعلني أجتازُ المواقعَ الصَّعبة

154
00:13:19,200 --> 00:13:21,220
هو دائماً قوّة غير قوّتي

155
00:13:22,950 --> 00:13:24,510
أريدُ أن أتغيّر أيضاً

156
00:13:25,190 --> 00:13:27,360
أريدُ أن أكون قويّة بكل ما تحمله الكلِمة من معنى

157
00:13:27,890 --> 00:13:29,950
هذا ليسَ لأجلكِ فقط

158
00:13:29,950 --> 00:13:32,080
ينتابُنا نفس الإحساس

159
00:13:37,700 --> 00:13:40,360
لن توبّخيني كما كنتِ تفعلين، أليس كذلك؟

160
00:13:42,260 --> 00:13:43,480
لا تقلقي يا أمِّي

161
00:13:43,920 --> 00:13:45,800
سأجدُ الإجابة بنفسي

162
00:13:46,060 --> 00:13:48,700
هذا هو العالمُ الذي تركتِه لنا

163
00:13:48,700 --> 00:13:51,110
كلّ الإجابات متوفِّرة حتماً

164
00:14:01,090 --> 00:14:03,410
ألن تأكل تاتشيبانا-سان؟

165
00:14:03,410 --> 00:14:06,130
تقولُ أنّ عليها وظيفة مدرسيّة

166
00:14:06,130 --> 00:14:09,190
أتفضِّلُ الوظيفة المدرسيّة على الغداء؟

167
00:14:09,190 --> 00:14:11,410
إنها في وضع سيئ جدّاً إذاً

168
00:14:12,400 --> 00:14:14,500
بيكي لا تستطيع الغِناء؟

169
00:14:14,500 --> 00:14:17,640
إن حاولنا تشجّيعها فقد تهتمّ

170
00:14:17,640 --> 00:14:19,640
أكثر بتحسينِ شعورنا

171
00:14:19,640 --> 00:14:21,290
عادةً ما تكون غاية في البساطة

172
00:14:21,290 --> 00:14:23,630
لكنّها تُصبِح مُعقَّدة في أوقاتٍ كهذه

173
00:14:25,110 --> 00:14:27,470
أتعتقِدن بأنَّ سبب عدم قدرتها على الغِناء

174
00:14:27,470 --> 00:14:30,300
هو لأنها نسيَت السببَ الذي تغنِّي لأجله؟

175
00:14:31,330 --> 00:14:34,060
السّبب الذي تغنِّي لأجله؟

176
00:14:34,350 --> 00:14:35,180
أجل

177
00:14:35,770 --> 00:14:38,100
...إذا تذكّرَتْ ذلك فأنا واثِقة

178
00:14:38,930 --> 00:14:40,980
أن هيبيكي ستستطيعُ الغِناء ثانيةً

179
00:14:47,780 --> 00:14:50,480
غاري، الفتاة التي هاجمَتْ هيبيكي-سان قبلَ بضعة أيَّام

180
00:14:50,480 --> 00:14:52,620
وليور، التي قاتلَتْ كريس-سان

181
00:14:52,880 --> 00:14:56,000
ولدينا فارا أيضاً، والتي رأتْها تسوباسا-سان في لندن

182
00:14:56,300 --> 00:14:59,100
وميكا التي لم ترونها بعد

183
00:14:59,100 --> 00:15:01,750
هؤلاء هُنّ الأوتوسكورر اللَّاتي تستخدمهن كارول

184
00:15:01,750 --> 00:15:05,630
إذاً ألا يمكنُنا حتَّى تحمُّل اللّعب بدُماها؟

185
00:15:05,630 --> 00:15:07,380
إذاً هذه الدُمى الميكانيكيّة

186
00:15:07,380 --> 00:15:11,260
هي أشبه بفُرسانٍ يحمون أميرة؟

187
00:15:11,850 --> 00:15:14,730
تفاصيلهن بما في ذلك مُواصفاتهن

188
00:15:14,730 --> 00:15:16,490
غير مُسجَّلة لديّ

189
00:15:16,790 --> 00:15:17,570
...ولكن

190
00:15:18,250 --> 00:15:21,230
،نظراً لقدرتهن في التغلُّبِ على سيمفوغير في معركة

191
00:15:21,230 --> 00:15:22,650
لا مجال للشكِّ في ذلك

192
00:15:22,650 --> 00:15:26,280
عملُنا هو التَّعامُل مع المخاطر الخارِقة

193
00:15:26,930 --> 00:15:29,910
لقد اقترحَتْ إيلفناين خطّة

194
00:15:29,910 --> 00:15:31,610
لمعالجةِ هذا الوضع

195
00:15:38,510 --> 00:15:40,280
مشروع إغنايت

196
00:15:48,110 --> 00:15:51,260
أما زلتِ خائفة من الغناء؟

197
00:15:52,310 --> 00:15:53,190
نعم

198
00:15:53,590 --> 00:15:57,550
أخافُ كلّما فكّرتُ بأنني قد أتسبّب بأذيّة شخص

199
00:15:58,900 --> 00:16:01,290
هل تتذكّرين أوَّل مرة

200
00:16:01,290 --> 00:16:03,980
استخدمتِ فيها سيمفوغير يا هيبيكي؟

201
00:16:03,980 --> 00:16:05,750
...لا أعرف

202
00:16:05,750 --> 00:16:07,520
عندما فعَلت، لم أكن أفكِّرُ بشيء

203
00:16:07,830 --> 00:16:09,600
,آنذاك

204
00:16:09,600 --> 00:16:13,160
هل غنّيتِ لأنّكِ أردتِ أن تؤذي شخصاً؟

205
00:16:18,090 --> 00:16:19,410
...نموذج إغنايت

206
00:16:20,030 --> 00:16:22,670
هل هذا ممكنٌ حقاً؟

207
00:16:23,160 --> 00:16:25,370
نظرياً، مُمكِن

208
00:16:25,370 --> 00:16:27,420
عن طريق تطبيق الخيمياء

209
00:16:28,050 --> 00:16:30,920
جازِف مُجازفة خطيرة لتكسب مُكافأة عظيمة

210
00:16:31,450 --> 00:16:34,600
هذا ما وُجِدَ السيف السحريّ داينسليف لأجله

211
00:16:38,430 --> 00:16:40,180
تمَّ رصد إشارة آلكا-نويز

212
00:16:46,130 --> 00:16:48,440
لقد تمَّ تفعيل ميكا أخيراً كذلك

213
00:16:53,450 --> 00:16:55,950
أريدُكِ أن تتوقَّفي عن الهربِ وتغنِّي

214
00:16:56,450 --> 00:17:00,330
أم أنّكِ تستدرجينني إلى مكانٍ يسهلُ فيه الغناء؟

215
00:17:03,730 --> 00:17:05,830
أريدُكِ إذاً أن تقولي ذلك

216
00:17:06,360 --> 00:17:07,470
هيّا

217
00:17:15,340 --> 00:17:16,720
هجوم عدوّ؟

218
00:17:17,010 --> 00:17:18,630
...ولكن من مكاننا الحالي

219
00:17:18,630 --> 00:17:19,970
...لن نلحق به

220
00:17:27,250 --> 00:17:28,020
هيبيكي

221
00:17:32,870 --> 00:17:33,700
...ميكو

222
00:17:36,620 --> 00:17:38,940
،إن لم تستسلمي وتبدئي بالقتال

223
00:17:38,940 --> 00:17:41,540
سأشرِّحُ الأشياء التي تحبِّينها

224
00:17:42,030 --> 00:17:44,750
،إن لم تُقاتلي وصديقتكِ تتمزَّق

225
00:17:44,750 --> 00:17:46,210
سأشرّحُ سكَّان البلدة

226
00:17:46,210 --> 00:17:49,840
وحتّى كلابها وقططها

227
00:18:02,510 --> 00:18:04,920
...إن لم تصبحي جادّة

228
00:18:14,770 --> 00:18:16,240
اسمعي يا هيبيكي

229
00:18:16,240 --> 00:18:19,900
لم تتواجد أغانيكِ لأذيّة الناس

230
00:18:20,730 --> 00:18:22,190
وأعلمُ بأن اليد

231
00:18:22,190 --> 00:18:25,230
التي مددتِها لي لم تُخلَقْ لأذيّة أحد

232
00:18:25,530 --> 00:18:27,250
أعلمُ بحكمِ طبيعتي

233
00:18:27,560 --> 00:18:30,210
،لأنني قاتلتُكِ

234
00:18:30,510 --> 00:18:31,880
وأنقذتِني

235
00:18:33,430 --> 00:18:34,630
...لستُ أنا فحسب

236
00:18:35,120 --> 00:18:37,670
،هنالِك كثيرٌ من الناس الذين أُنقِذوا بواسطةِ أغانيكِ

237
00:18:37,670 --> 00:18:40,390
وما وُجِدوا هنا اليوم لولاها

238
00:18:40,740 --> 00:18:42,390
لِذا لا تخافي

239
00:18:42,390 --> 00:18:44,520
حسناً

240
00:19:09,540 --> 00:19:13,340
...أحبُّ أغانيكِ

241
00:19:14,370 --> 00:19:17,680
...غنِّيها لأجلِ الجميع

242
00:19:31,850 --> 00:19:32,630
أنا آسفة

243
00:19:32,990 --> 00:19:36,860
كنتُ أتهرّبُ من هذه القوّة ومسؤوليتها

244
00:19:37,670 --> 00:19:39,270
ولكن لن أتردّدَ بعد الآن

245
00:19:39,860 --> 00:19:42,360
لِذا استمِعوا إلى أغانيي

246
00:19:44,120 --> 00:19:46,370
إنها حقّاً حمقاء يائسة

247
00:19:49,350 --> 00:19:50,290
ها أنا ذي

248
00:19:50,290 --> 00:19:51,450
سأنتظرُكِ

249
00:19:55,510 --> 00:19:57,190
خذي

250
00:20:15,370 --> 00:20:18,360
سيكون هذا جديراً بالسّحق

251
00:20:19,360 --> 00:20:23,200
هذه هي مُواصفات أوتوسكورر مُخصَّص للقتال

252
00:20:23,460 --> 00:20:25,850
،حتّى لو كان مُخصّصاً للقتال

253
00:20:25,850 --> 00:20:29,200
من المُحال أن تخسر تاتشيبانا

254
00:20:57,300 --> 00:21:01,110
مع الأسف... كان ذلك وهماً مُنعكِساً في الماء

255
00:21:26,510 --> 00:21:27,720
!هيبيكي

256
00:21:36,980 --> 00:21:38,230
!هيبيكي

257
00:21:44,240 --> 00:21:46,730
!هيبيكي! هيبيكي

258
00:21:47,570 --> 00:21:50,120
!لا، هيبيكي

259
00:21:50,440 --> 00:21:54,120
أرجوكِ! استيقظي يا هيبيكي

260
00:21:54,440 --> 00:21:56,710
!هيبيكي

261
00:23:33,940 --> 00:23:35,890
الأوتوسكورر ينسحِبن

262
00:23:36,260 --> 00:23:37,560
أخرجوا هيبيكي-تشان من هناك

263
00:23:37,560 --> 00:23:38,740
أنا ذاهبٌ حالاً

264
00:23:39,700 --> 00:23:41,290
يمكنُنا تدبُّر الأمر

265
00:23:41,290 --> 00:23:44,010
لِذا امضي بمشروع إغنايت من فضلكِ

266
00:23:44,310 --> 00:23:46,510
إتمام السيمفوغير المُحسَّنة