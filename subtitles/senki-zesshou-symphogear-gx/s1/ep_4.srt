1
00:00:11,470 --> 00:00:14,440
هنالِك أغنية ستدمِّرُ العالم

2
00:00:31,770 --> 00:00:32,840
...أمِّي

3
00:00:33,310 --> 00:00:35,040
تذكّري بأنّ

4
00:00:35,400 --> 00:00:37,720
يديكِ مُلطّختان بالدماء

5
00:00:38,250 --> 00:00:42,250
فكيفَ تظنِّين أنّ مثل هاتين اليدين
قادِرتان على إنقاذِ العالم؟

6
00:00:42,850 --> 00:00:45,230
...رُغمَ ذلك، أنا

7
00:00:45,230 --> 00:00:46,280
أجل

8
00:00:46,580 --> 00:00:49,480
سبب أُمنيتكِ بإنقاذ العالم

9
00:00:49,780 --> 00:00:51,970
هو أنّكِ ترغبين أن تنقذي نفسكِ

10
00:00:52,960 --> 00:00:55,430
ماريا، هذه ليسَتْ أمّنا

11
00:00:55,430 --> 00:00:59,280
نعلمُ أين تنامُ أمّنا الآن

12
00:00:59,280 --> 00:01:00,740
...لا بدّ وأنّنا في القلعة

13
00:01:01,050 --> 00:01:02,680
أعلمُ ذلك

14
00:01:03,030 --> 00:01:04,610
،هذه فعلاً ليسَتْ بأمِّي

15
00:01:04,970 --> 00:01:07,750
ولكن ما قالَتْه صحيح

16
00:01:08,430 --> 00:01:10,560
تُريدين أن يتمّ إنقاذكِ، أليس كذلك؟

17
00:01:10,560 --> 00:01:13,760
من ذاك الوميض الفضِّي
المُبهِر جدّاً بالنسبةِ لكِ؟

18
00:01:19,510 --> 00:01:21,590
كيري-تشان، ماريا، لنتراجع

19
00:01:21,590 --> 00:01:23,160
ما الذي يجري؟

20
00:01:23,160 --> 00:01:24,210
لا أدري

21
00:01:24,570 --> 00:01:26,520
ولكن هذا كُل ما يمكننا فعله حالياً

22
00:01:26,820 --> 00:01:30,020
أشعرُ بأننا وقَعنا في فخّ

23
00:01:48,630 --> 00:01:51,300
ويستمرُّ تحليل العالم

24
00:01:51,300 --> 00:01:53,300
إنه على وشك أن يبلغ المدينة

25
00:01:55,030 --> 00:01:58,700
...هذه هي المرحلةُ الأخيرةُ من الخطّة

26
00:02:02,250 --> 00:02:04,160
أنتِ جريحة

27
00:02:05,220 --> 00:02:07,940
مهمّتي هي إيقافُ كارول

28
00:02:08,520 --> 00:02:10,620
يجبُ أن أراقبَ هذا حتّى النهاية

29
00:02:16,190 --> 00:02:19,450
لِماذا قِتال خيميائيّ؟

30
00:02:20,320 --> 00:02:23,380
سبعة كواكِب وسبعة سلالم موسيقيّة

31
00:02:23,380 --> 00:02:26,660
تناغُم الكون، سرّ الخيمياء الأعمق

32
00:02:26,660 --> 00:02:28,500
هو تناغُم الموسيقا

33
00:02:28,780 --> 00:02:31,500
والحقيقة المُطلَقة التي يخلقها

34
00:02:31,860 --> 00:02:33,000
ماذا تقصدين؟

35
00:02:33,000 --> 00:02:35,830
،بما أنّ مصدرها واحد

36
00:02:35,830 --> 00:02:38,170
فلا شيء غريب فيها على الإطلاق

37
00:02:39,940 --> 00:02:43,920
في عصرِ ما قبل التاريخ، بعد أن استأصلَتْ لعنة

38
00:02:43,920 --> 00:02:46,990
بالال التفاهُم المُتبادَل بين البشر

39
00:02:46,990 --> 00:02:50,190
لجؤوا إلى نهجٍ جديد

40
00:02:50,690 --> 00:02:53,090
،الخيمياء هي صِلة التواصل مع العالم

41
00:02:53,090 --> 00:02:56,280
والتّناغُم معه بمعرِفة كلّ شيء

42
00:02:56,520 --> 00:03:00,670
حاولوا استخدامها للاتِّصال بالعالم
عِوضاً عن استخدام الكلِمات

43
00:03:00,670 --> 00:03:01,780
...الأغاني

44
00:03:01,790 --> 00:03:03,990
الخيمياء والأغاني

45
00:03:03,990 --> 00:03:08,320
خُلِقَتا لاستعادة اللّغة الموحّدة الضائعة

46
00:03:08,790 --> 00:03:09,980
مستحيل

47
00:03:10,300 --> 00:03:13,070
،ضاعَ أصلُها في التّاريخ

48
00:03:13,070 --> 00:03:16,170
ولكن يجدرُ بكن أنتن الثلاثة
أن تخمِّنَ بسهولة

49
00:03:18,860 --> 00:03:22,860
إن كان فخّاً فالآن هو الوقت
...المُناسِب لتفعيله، لكن

50
00:03:24,280 --> 00:03:26,080
فخّ أسوأ من فخّ

51
00:03:26,420 --> 00:03:29,520
...هل يُعقَلُ أن يكون الشخص الذي استدرجنا إلى هنا

52
00:03:29,760 --> 00:03:31,620
هو الدكتور فير...

53
00:03:31,960 --> 00:03:34,170
ترون الحالة التي أنا فيها

54
00:03:34,570 --> 00:03:40,800
لم يعُد في داخلي ما يكفي من دِماء للتحكّم
بسهولة بتشاتو بفعاليّة كاملة

55
00:03:40,800 --> 00:03:44,530
لِذا قُمنَ بإجراء صفقة تبادُل معي على أرض المعركة

56
00:03:50,370 --> 00:03:52,610
نظام التحكُّم بتشاتو دي تيفوغيس

57
00:03:52,910 --> 00:03:54,920
...بعبارة أخرى، إن دمَّرنا هذا

58
00:03:55,200 --> 00:03:58,810
إلى أي جيل متخلِّف يعودُ
المُعالج الذي في رأسكِ؟

59
00:03:58,810 --> 00:04:02,090
كلّ ما يفعله هذا هو إخراجه عن السيطرة

60
00:04:02,090 --> 00:04:03,590
ماذا سنفعل إذاً؟

61
00:04:09,720 --> 00:04:12,510
،أثناء وقوفكن هُنا خائفات

62
00:04:12,510 --> 00:04:15,350
يتفسّخُ العالمُ من حولكن

63
00:04:15,350 --> 00:04:17,480
إيّاكن ونسيان ذلك

64
00:04:21,990 --> 00:04:22,740
...الأغاني

65
00:04:23,400 --> 00:04:25,490
الأغاني تدمّرُ العالم؟

66
00:04:25,830 --> 00:04:27,800
مركز طوكيو

67
00:04:27,800 --> 00:04:30,670
هو نقطة نهاية خطوط لاي

68
00:04:30,990 --> 00:04:34,000
مما يعني أيضاً بأنني أستطيع استخدام هذا المكان

69
00:04:34,000 --> 00:04:37,500
لنشرِ الأغاني في العالم كلّه

70
00:04:37,860 --> 00:04:41,380
لهذا دمّرتِ أحجارَ الزاوية
التي كانَتْ بمثابة صمّامات الأمان

71
00:04:41,730 --> 00:04:43,770
أما من شيء نستطيعُ فعله؟

72
00:04:45,210 --> 00:04:46,740
!بلى

73
00:04:48,180 --> 00:04:50,060
،حتّى لو فشِلَتْ عشرة آلاف خطّة

74
00:04:50,060 --> 00:04:52,310
لا بدّ من وجود عشرة آلاف خطّة وخطّة

75
00:04:53,120 --> 00:04:54,060
أنا متأكِّدة من ذلك

76
00:04:56,840 --> 00:04:58,000
...ماريا-سان

77
00:05:05,610 --> 00:05:07,780
لنقضِ عليهم

78
00:05:08,060 --> 00:05:09,660
أثناء التصدِّي لهم

79
00:05:09,660 --> 00:05:13,290
قلتُ لكُن أنني لا أستطيع مُعالجة
هذا الأمر لأنني لا أملك دماءً كافياً

80
00:05:13,290 --> 00:05:15,580
الأطفال أنانيّون دوماً

81
00:05:17,450 --> 00:05:19,570
أما زلتَ حيّاً يا دكتور فير؟

82
00:05:19,570 --> 00:05:21,000
ماذا تفعل؟

83
00:05:21,000 --> 00:05:24,730
أُعيد صياغة برنامج تشاتو

84
00:05:24,730 --> 00:05:28,140
وصميمه، الخيمياء يُفكِّكُ ويُحلِّل

85
00:05:28,360 --> 00:05:29,740
...و

86
00:05:30,720 --> 00:05:32,460
ستعملُ على عَكْس

87
00:05:32,460 --> 00:05:35,770
وظيفته وتستعيد العالم؟

88
00:05:36,070 --> 00:05:37,080
مستحيل

89
00:05:37,080 --> 00:05:40,620
لن يتمكّن تشاتو من تحمُّل ذلك

90
00:05:40,620 --> 00:05:42,610
سأمتصّكم جميعاً

91
00:05:42,890 --> 00:05:45,110
نعم، وستنفجرين

92
00:05:46,320 --> 00:05:49,690
في كلتا الحالتين، أستطيع إيقاف التفسُّخ

93
00:05:50,320 --> 00:05:54,040
العبَث بمخطّطاتِ الآخرين مُمتِع للغاية

94
00:05:58,010 --> 00:05:59,350
...دكتور فير

95
00:06:05,640 --> 00:06:06,550
أمِّي

96
00:06:10,830 --> 00:06:13,390
لن يتوقّفَ تحليل العالم

97
00:06:13,390 --> 00:06:15,970
لن أسمح بذلك

98
00:06:15,970 --> 00:06:17,480
...سنُوقفه نحن

99
00:06:17,480 --> 00:06:19,020
بمُساعدة إيلفناين-تشان

100
00:06:19,020 --> 00:06:19,940
لا تفعلي

101
00:06:20,270 --> 00:06:24,070
إنَّ استخدام نموذج إغنايت قد يُفيد كارول

102
00:06:32,340 --> 00:06:34,420
سأضربكن

103
00:06:35,200 --> 00:06:36,540
بهجمةٍ قاضية قويّة

104
00:06:39,470 --> 00:06:41,380
أنتِ لستِ بأمّي

105
00:06:56,730 --> 00:06:58,160
أنا فيني

106
00:06:58,470 --> 00:07:01,440
نعم، الفتاة التي تحمِلُ اسمَ النّهاية

107
00:07:02,940 --> 00:07:04,120
...فهمت

108
00:07:04,590 --> 00:07:06,090
أنتِ أنا

109
00:07:06,730 --> 00:07:10,450
أنتِ ما حلَّ بنا بعدما استمرَرنا في الخطأ

110
00:07:10,750 --> 00:07:14,450
ولكن وُجِدَ التاريخ الأسود لتُعاد صياغته

111
00:07:14,940 --> 00:07:17,130
،قبل أن ينفجر تشاتو

112
00:07:17,400 --> 00:07:19,960
لنتغلَّب على خطيئتنا ونحاول الهرب

113
00:07:38,860 --> 00:07:40,020
،ماريا-سان

114
00:07:40,020 --> 00:07:43,070
هل يمكنكِ أن تعطي جهاز الاتّصال للدكتور فير؟

115
00:07:43,070 --> 00:07:44,020
ماذا؟

116
00:07:44,430 --> 00:07:46,270
سأقاتلُ بطريقتي الخاصّة

117
00:07:46,780 --> 00:07:47,520
دكتور

118
00:07:49,270 --> 00:07:52,110
صِل هذا الجهاز الطرَفيّ بتشاتو

119
00:07:52,110 --> 00:07:53,300
سأساعدك

120
00:07:53,300 --> 00:07:54,660
!يا للإثارة

121
00:07:54,660 --> 00:07:56,530
ولكن هل يمكنُكِ فعلها؟

122
00:07:58,040 --> 00:08:00,160
هكذا إذاً... سنستخدمُ الفوتوسفير

123
00:08:00,500 --> 00:08:03,120
إن استخدَمنا البيانات النموذجيّة
،لخطوط لاي في المُعالجة

124
00:08:03,120 --> 00:08:04,040
بمقدورنا فعلها من هنا

125
00:08:04,360 --> 00:08:05,110
فوجيتاكا

126
00:08:05,410 --> 00:08:09,880
لا أريد أن تكون كارول هي الشخص الوحيد
الذي يستخدمُ ما خلّفَه الدكتور ناستاسجا

127
00:08:09,880 --> 00:08:11,840
سأعيدُها

128
00:08:11,840 --> 00:08:15,320
سنتولّى أمرَ المعالجة هنا لتخفيف الحِمل عنكن

129
00:08:15,320 --> 00:08:19,600
من فضلكن استخدِمن تشاتو بكامل
فعاليته لأجلِ إعادة البناء

130
00:08:36,180 --> 00:08:39,090
سأضعُ حدّاً للخطايا التي اقترفتُها

131
00:08:39,090 --> 00:08:40,550
شيرابي، كيريكا

132
00:08:40,550 --> 00:08:43,160
اتركا هذا الأمر لي وساعدا الآخرين

133
00:08:47,460 --> 00:08:49,460
...نحنُ الثلاثة

134
00:08:49,460 --> 00:08:51,960
علينا أن نتغلّب على خطايانا سويةً

135
00:08:53,830 --> 00:08:56,470
...شكراً لكما

136
00:08:57,080 --> 00:09:00,830
دكتور، سنحميك حتّى ولو
على حسابِ أرواحنا

137
00:09:00,830 --> 00:09:03,300
لِذا أنقذ العالم

138
00:09:10,380 --> 00:09:11,360
...توقّفوا

139
00:09:12,070 --> 00:09:14,360
توقّفوا عن اعتراضِ طريقي

140
00:09:14,740 --> 00:09:16,220
توقّفوا

141
00:09:22,600 --> 00:09:24,920
كان الوقوف معكِ على خشبةِ المسرح
...غاية في المتعة يا تسوباسا

142
00:09:25,470 --> 00:09:27,170
،إن تمكّنا من فعل ذلك ثانيةً

143
00:09:27,720 --> 00:09:30,310
أريد أن أغنِّي طوال الليل

144
00:09:30,310 --> 00:09:32,350
...ماريا، ما الذي

145
00:09:33,150 --> 00:09:37,800
لطالما اندهشتُ من قدرتكِ
على مُصادقةِ من تُقاتلينهم يا كريس-سان

146
00:09:38,060 --> 00:09:39,880
طمحتُ أن أكون مثلكِ

147
00:09:39,880 --> 00:09:42,470
بمقدوركِ فعلها أيضاً... بل فعلتِ ذلك

148
00:09:42,730 --> 00:09:43,910
أنا آسفة

149
00:09:43,910 --> 00:09:47,100
نعتُّكِ بالمُنافِقة رغم أنني لم أكن أعلم شيئاً

150
00:09:47,460 --> 00:09:50,230
...أعلمُ أنه كان ينبغي أن أعتذر شخصياً، لكن

151
00:09:50,230 --> 00:09:52,520
...لا يهمّني! فقط

152
00:09:56,030 --> 00:09:58,160
...أرجوكن، لا

153
00:09:58,160 --> 00:10:00,530
لا تعترضوا طريقَ أبي وطريقي

154
00:10:01,670 --> 00:10:05,400
سأحمي العالم بخيميائي

155
00:10:05,400 --> 00:10:07,540
لن أدع كارول تدمّره

156
00:10:23,100 --> 00:10:27,390
سيرينا

157
00:10:32,120 --> 00:10:34,910
توقّفن

158
00:11:17,160 --> 00:11:19,360
لقد تمّ استعادة المناطِق المتفسِّخة

159
00:11:21,220 --> 00:11:23,610
...ولكن ماريا-سان والأُخرَيَات

160
00:11:25,200 --> 00:11:29,470
ألا يمكننا أن نصنع مُستقبلاً
بِلا تسديد ثمن؟

161
00:11:44,320 --> 00:11:47,310
...تشاتو... المهمّة التي كُلِّفتُ بها

162
00:11:51,090 --> 00:11:52,310
...الجميع

163
00:11:52,310 --> 00:11:54,310
لماذا؟ تبّاً

164
00:11:59,280 --> 00:12:00,990
استسلمي

165
00:12:00,990 --> 00:12:02,930
المُستقبل الذي حلمتِ به

166
00:12:02,930 --> 00:12:05,370
قد تحوّلَ إلى أنقاض وانهار

167
00:12:06,970 --> 00:12:07,910
مُستقبل؟

168
00:12:08,470 --> 00:12:10,620
...توقّفي عن هذا

169
00:12:11,020 --> 00:12:12,910
أرجوكِ يا كارول

170
00:12:13,280 --> 00:12:17,420
هذا ليسَ ما أراده والدنا

171
00:12:21,200 --> 00:12:26,380
عندما طلبَ منّا أثناء احتراقه
،أن نتعلّمَ عن العالَم

172
00:12:26,760 --> 00:12:29,720
هذا ليسَ ما أراد منّا أن نفعل

173
00:12:29,720 --> 00:12:31,470
أعلمُ ذلك

174
00:12:31,730 --> 00:12:35,730
ولكن كيف يُفترَضُ بي أن أثأرَ لأبي؟

175
00:12:36,110 --> 00:12:40,410
!ماذا عن مدى حزنِنا بعد مقتلِه؟

176
00:12:41,320 --> 00:12:43,510
،لقد طرحَ علينا المُشكلة

177
00:12:43,510 --> 00:12:46,700
ولم يُخبرنا عن الحلِّ أبداً

178
00:12:48,170 --> 00:12:49,330
...هذا

179
00:12:50,800 --> 00:12:52,760
أرادَ والدكِ أن

180
00:12:53,060 --> 00:12:55,750
يقول لكما شيئاً مهمّاً، صحيح؟

181
00:12:57,740 --> 00:13:00,010
،أعتقدُ بأنّ المرء عندما يحتضِر للموت

182
00:13:00,570 --> 00:13:03,520
يقولُ أكثر ما يرغب بقوله

183
00:13:05,530 --> 00:13:08,140
ما أرادَ والدُنا كخيميائي

184
00:13:08,140 --> 00:13:11,010
...أن يقوله لنا أكثر من أي شيء آخر

185
00:13:13,640 --> 00:13:16,310
لا يمكن أن يكون سِوى الحقيقة إذاً

186
00:13:17,010 --> 00:13:19,690
الهدفُ الأخير للخيمياء هو

187
00:13:20,240 --> 00:13:22,880
الاتّصال والتناغُم

188
00:13:22,880 --> 00:13:25,990
...مع العالم من خِلال معرِفة كلّ شيء

189
00:13:27,450 --> 00:13:28,830
التناغُم؟

190
00:13:29,230 --> 00:13:32,600
أتريدينني أن أقبلَ العالم الذي رفضَ أبي؟

191
00:13:32,600 --> 00:13:33,870
لم يقل ذلك

192
00:13:33,870 --> 00:13:36,040
لم يقل ذلك أبداً

193
00:13:37,800 --> 00:13:40,290
سأجيبُ عنه إذاً

194
00:13:44,870 --> 00:13:47,800
الغفرانُ هو حلُّ المُشكلة

195
00:13:49,770 --> 00:13:52,410
قالَ لنا أن نغفرَ للعالم

196
00:13:53,110 --> 00:13:55,810
ما فعلَه به

197
00:14:02,070 --> 00:14:02,980
!أنتِ

198
00:14:06,720 --> 00:14:09,320
،دُمِّرَ تشاتو دي تيفوغيس

199
00:14:10,110 --> 00:14:13,970
والمُستقبل الذي يشهد نهاية
كلّ شيء قد زال

200
00:14:18,590 --> 00:14:22,540
إذاً سأهجرُ الماضي وأدمّر الحاضر

201
00:14:28,130 --> 00:14:29,210
لا

202
00:14:29,510 --> 00:14:33,390
إن فعلتِ ذلك فستحرقين كافّة
الذكريات التي عشتِها مع أبيكِ

203
00:14:33,850 --> 00:14:36,240
،تحاولُ أن تحرق كلّ ذكرياتها

204
00:14:36,240 --> 00:14:39,020
لتحوّلها إلى قوّة قتاليّة؟

205
00:14:42,540 --> 00:14:44,020
ماذا تفعلين يا كارول-تشان؟

206
00:14:44,380 --> 00:14:46,130
!انتقام

207
00:14:54,520 --> 00:14:57,010
...الانتقام هو كُل ما بقي لي

208
00:14:57,730 --> 00:14:59,530
نيران انتقامها

209
00:14:59,870 --> 00:15:02,960
لن تنطفئ حتّى تزول ذكرياتها؟

210
00:15:05,280 --> 00:15:09,090
...لا تريد إيلفناين أن تنتقم

211
00:15:09,670 --> 00:15:10,540
نعم

212
00:15:11,020 --> 00:15:13,720
...تريدُ إيلفناين-تشان

213
00:15:14,200 --> 00:15:16,430
إغنايت؟ هل أنتِ جادّة؟

214
00:15:19,040 --> 00:15:20,340
هيبيكي-سان

215
00:15:20,770 --> 00:15:23,650
الاحتمالات ضئيلة جدّاً أمام ذلك الرهان

216
00:15:23,650 --> 00:15:25,310
ولكن لا يهمّني

217
00:15:25,610 --> 00:15:27,920
...تحديداً الآن

218
00:15:29,610 --> 00:15:33,460
مدَّتْنا إيلفناين-تشان بهذه القوّة

219
00:15:33,880 --> 00:15:35,830
لذا لن أشكِّكَ بها

220
00:15:36,120 --> 00:15:37,800
نموذج إغنايت

221
00:15:37,800 --> 00:15:39,330
سحب السّيف المُزدوَج

222
00:15:41,810 --> 00:15:43,290
داين، داينسليف

223
00:16:22,420 --> 00:16:26,460
تمَّ تعطيل جهازين من أجهزة
الأمان الثلاثة لنموذج إغنايت على التوالي

224
00:16:26,950 --> 00:16:29,460
انتقل من مرحلة نيغريدو إلى آلبيدو

225
00:16:38,990 --> 00:16:40,570
...قوّة خامّة

226
00:16:41,010 --> 00:16:43,600
وظريفة جدّاً مثلك تماماً

227
00:16:43,940 --> 00:16:45,350
...لكن

228
00:16:48,340 --> 00:16:50,610
فعّلنا مرحلتَين من مراحل نموذج إغنايت

229
00:16:51,930 --> 00:16:54,280
حان دوري للغِناءِ الآن

230
00:17:07,000 --> 00:17:09,460
كم تملكُ من التضخيم الصوتيّ؟

231
00:17:09,460 --> 00:17:12,590
ولكن هذا ما كنتُ أنتظره

232
00:17:13,980 --> 00:17:15,170
السيف المسحوب

233
00:17:15,170 --> 00:17:18,330
كافّة أجهزة الأمان، تحرير

234
00:17:19,060 --> 00:17:20,580
داينسليف

235
00:17:25,480 --> 00:17:27,850
تحوّلَ إلى روبيدو، المرحلة الأخيرة

236
00:17:38,990 --> 00:17:42,740
ونستجمع عاصفة التضخيم الصوتي هذه
ومن ثمّ نحرّرها

237
00:17:42,990 --> 00:17:46,620
انفجار س.2.سي.أ الثلاثيّ

238
00:17:50,540 --> 00:17:52,500
إنه ينطلِقُ من تلقاء نفسه

239
00:17:56,440 --> 00:18:00,010
ألا تعلمن بأن ذلك هو سبب تخلّصي منه؟

240
00:18:02,010 --> 00:18:04,530
تتمتّع أغانيي بقوّة

241
00:18:04,530 --> 00:18:07,020
سبعة مليارات أغنية نهائيّة

242
00:18:07,020 --> 00:18:09,450
التضخيم الصوتي

243
00:18:14,640 --> 00:18:15,900
هذا سهل للغاية

244
00:18:25,990 --> 00:18:28,750
،حتّى لو فشِلَتْ عشرة آلاف خطّة

245
00:18:29,300 --> 00:18:32,420
...لا بدّ من وجود عشرة آلاف خطّة وخطّة

246
00:18:46,470 --> 00:18:47,640
...ماريا-سان

247
00:18:53,530 --> 00:18:54,640
دكتور فير

248
00:18:55,160 --> 00:18:58,440
...أنقذتُ كلّ شيء

249
00:18:58,740 --> 00:19:00,150
...لا يمكنك أن

250
00:19:00,560 --> 00:19:02,800
،أنقذتكِ

251
00:19:02,800 --> 00:19:07,580
...كي تخبري العالم عن عمَلي البطولي

252
00:19:09,910 --> 00:19:12,090
اذهبي الآن

253
00:19:12,390 --> 00:19:15,630
ودعي العالم يرى عارَكِ بنجاتكِ

254
00:19:16,320 --> 00:19:18,410
أم أنّكِ لا تزالين

255
00:19:18,410 --> 00:19:22,410
امرأة فاشِلة كما كنتِ من قبل؟

256
00:19:27,340 --> 00:19:28,930
إنه الحبّ

257
00:19:29,200 --> 00:19:30,940
لماذا تتحدثُ عن الحبّ الآن؟

258
00:19:31,520 --> 00:19:35,940
لا علاقة للمُعجزات بتوافقيّة السيمفوغير

259
00:19:36,370 --> 00:19:39,950
،إن أردتِ أن تجعلي تِلك القوّة ملككِ

260
00:19:39,950 --> 00:19:42,700
...فمدّي يدكِ

261
00:19:54,180 --> 00:19:55,510
،ماريا

262
00:19:56,250 --> 00:19:59,090
هل استطعتُ أن أكون بطلاً؟

263
00:19:59,570 --> 00:20:00,380
نعم

264
00:20:01,340 --> 00:20:02,840
أسوأ بطل

265
00:20:15,850 --> 00:20:19,800
لا تعتقدن أنّكن تستطِعن إيقافي

266
00:20:30,990 --> 00:20:34,000
تحويل س.2.سي.أ السّداسيّ

267
00:20:34,960 --> 00:20:37,970
سأستخدم غانغنير لاستجماع التضخيم الصوتي

268
00:20:37,970 --> 00:20:41,380
وأيرغيتلام للتحكُّم به وإعادة توزيعه

269
00:20:57,960 --> 00:21:00,270
...معجزة أخيرة

270
00:21:00,630 --> 00:21:01,610
مستحيل

271
00:21:01,970 --> 00:21:04,820
أيستخدِمن التضخيمَ الصوتي الذي أطلقتُ عنانه؟

272
00:21:10,430 --> 00:21:12,250
مولِّد

273
00:21:12,250 --> 00:21:17,220
المحرّك أكس

274
00:21:21,750 --> 00:21:24,010
لا... مستحيل

275
00:22:01,020 --> 00:22:02,190
هذا

276
00:22:03,210 --> 00:22:05,290
تجسيدٌ لمُعجزة