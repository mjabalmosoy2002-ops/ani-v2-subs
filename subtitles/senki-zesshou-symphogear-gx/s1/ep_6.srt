1
00:00:04,870 --> 00:00:05,920
العدوّ؟

2
00:00:07,250 --> 00:00:10,420
خيمياء كارول مالوس دينهايم

3
00:00:11,050 --> 00:00:12,610
سيدمِّرُ العالم

4
00:00:12,930 --> 00:00:15,610
ويُتمِم نِهاية كلّ شيء

5
00:00:15,870 --> 00:00:17,780
يدمِّر العالم؟

6
00:00:18,360 --> 00:00:21,040
سأقتلُ مُعجزة

7
00:00:41,560 --> 00:00:43,730
لِمَ لا تجهِّزين نفسكِ بسيمفوغير؟

8
00:00:44,030 --> 00:00:45,690
لِمَ لا تُقاتلين؟

9
00:00:45,690 --> 00:00:47,610
...بدلاً من القتال

10
00:00:48,830 --> 00:00:51,480
أخبريني لماذا تُريدين تدمير العالم؟

11
00:01:03,280 --> 00:01:05,500
إن قلتُ لكِ السبب فهل ستقبلينه؟

12
00:01:06,640 --> 00:01:07,770
...لا

13
00:01:08,930 --> 00:01:10,380
لا أريد القِتال

14
00:01:11,280 --> 00:01:15,030
أنا بخلافكِ، أبحثُ عن حقيقة

15
00:01:15,380 --> 00:01:16,760
حتّى لو كلّفَني ذلك القِتال

16
00:03:12,970 --> 00:03:15,960
ظننتُ بأنَّنا كنَّا سنحتفلُ جميعاً حتى وقت متأخر

17
00:03:16,180 --> 00:03:18,520
لا يجوز أن نلهوا

18
00:03:18,520 --> 00:03:21,180
بينما تعملُ تاتشيبانا-سان وهيبيكي-سان بجدّ

19
00:03:21,540 --> 00:03:23,750
يسرُّني فقط أنَّ هينا تملكُ مفتاحاً احتياطيّاً

20
00:03:23,750 --> 00:03:26,020
لبيتِ كينيكوري-سينباي

21
00:03:26,320 --> 00:03:27,850
ولكن من أينَ لكِ المفتاح؟

22
00:03:29,100 --> 00:03:30,500
...في الواقع

23
00:03:30,930 --> 00:03:32,280
بالفعل لماذا؟

24
00:03:32,280 --> 00:03:34,980
ربّما أعطَتْني إيِّاه هيبيكي

25
00:03:36,550 --> 00:03:38,480
...حسناً حسناً يا زميلاتي السينباي

26
00:03:38,760 --> 00:03:40,910
سنذهبُ إلى المنزل

27
00:03:40,910 --> 00:03:42,950
شكراً لدعوتنا

28
00:03:42,950 --> 00:03:46,860
وداعاً

29
00:03:44,280 --> 00:03:44,910
كيري-تشان

30
00:03:46,860 --> 00:03:48,330
!بالتوفيق

31
00:03:49,280 --> 00:03:53,000
حسناً، قد أذهب لشِراء كُرة أرزّ في المتجر

32
00:03:53,330 --> 00:03:54,070
!يا للهول

33
00:03:54,070 --> 00:03:55,160
!يا إلهي

34
00:03:55,160 --> 00:03:57,920
ظننتُ أنَّ القلق سينتابكِ

35
00:03:58,470 --> 00:04:01,450
هِواية هيبيكي هي إنقاذ الناس، ستكونُ بخير

36
00:04:01,450 --> 00:04:05,200
ما يُقلقني أكثر هو أنَّها ستعودُ إلى المنزلِ جائعة

37
00:04:11,500 --> 00:04:15,210
بفضلِ هيبيكي-تشان، تسيرُ مساعي الإنقاذ في الشقق التي تحترِق على خير ما يُرام

38
00:04:15,930 --> 00:04:18,610
لن أدعَها تحظى بكلّ المجد

39
00:04:35,640 --> 00:04:37,790
هل كنتِ أنتِ؟

40
00:04:45,750 --> 00:04:46,760
...أهذه

41
00:04:47,370 --> 00:04:48,760
وسيلة نقل قابِض السيمفوغير قد دُمِّرَتْ

42
00:04:49,230 --> 00:04:50,370
ما الذي يجري؟

43
00:04:50,370 --> 00:04:52,430
يبدو بأنّ أحداً ما قد هاجمها

44
00:04:52,810 --> 00:04:55,940
تلقّينا رسالةً أيضاً من لندن مفادها أنّ تسوباسا-سان تتعرضُ لهجوم

45
00:04:56,480 --> 00:04:57,830
هجمات آنيّة؟

46
00:04:58,130 --> 00:05:00,360
هل يُحاولون تشتيتنا؟

47
00:05:00,730 --> 00:05:01,710
...ولكن مع ذلك

48
00:05:03,410 --> 00:05:03,990
...أوغاوا

49
00:05:04,980 --> 00:05:05,610
نعم؟

50
00:05:06,080 --> 00:05:09,740
في هذه الحالة ستغمرُنا المعلومات ولن نعلم ما يخطِّطون له

51
00:05:10,230 --> 00:05:11,200
عُلِم

52
00:05:11,200 --> 00:05:13,770
سأطلبُ المساعدة من الشرطة البريطانيّة والمُخابرات الحربيّة 5

53
00:05:13,770 --> 00:05:15,430
وأحاول فهم ما يجري

54
00:05:26,050 --> 00:05:28,460
أنا جاهزة

55
00:05:29,350 --> 00:05:30,780
...بما أنّكِ تقولين ذلك

56
00:05:31,080 --> 00:05:33,810
فسنفعلُها إذاً بإنصافٍ وأمانة

57
00:05:34,110 --> 00:05:37,060
لا أريدُ أن أسمع أنينكِ لاحقاً

58
00:06:24,450 --> 00:06:25,810
...تِلك الحركات

59
00:06:25,810 --> 00:06:27,400
لا تفوقُ مقدِرات البشر فحسب

60
00:06:27,670 --> 00:06:28,900
بل هي وحش

61
00:06:31,820 --> 00:06:34,090
بعبارة أخرى، هذا يُسهِّلُ تدبُّر أمرها

62
00:06:34,650 --> 00:06:35,440
...سيّدي

63
00:06:35,660 --> 00:06:36,380
ما الأمر؟

64
00:06:36,970 --> 00:06:38,580
هل تعتقد بأن لهذا علاقة

65
00:06:38,580 --> 00:06:41,750
بتِلك الإشارة الغامضة التي رأيناها في الليلة الماضية؟

66
00:06:42,650 --> 00:06:45,800
...إشارة موجيّة غير معرَّفة وعدو جديد

67
00:06:54,000 --> 00:06:56,920
إنها إحدى أعلى مُستويات المكاسِب الصوتيّة والمقدِرات القتاليّة لقابِضيّ السيمفوغير

68
00:06:57,220 --> 00:06:59,390
"ومع ذلك ليسَتْ كافية للإضرارِ بـ"ليور

69
00:06:59,790 --> 00:07:03,110
عليّ تسليم تُراث دفيرغر داين في نهاية المطاف

70
00:07:23,190 --> 00:07:24,250
ضربة مُباشَرة؟

71
00:07:29,850 --> 00:07:32,380
سمعتُ بأنّ أغانيكِ كانَتْ أفضل من ذلك بكثير

72
00:07:32,900 --> 00:07:36,890
بالطبع، لن أدعَكِ تهزمينني بهذه حتماً

73
00:07:45,910 --> 00:07:46,810
هل نلتِ منها؟

74
00:07:46,810 --> 00:07:48,030
أبداً

75
00:07:48,030 --> 00:07:49,990
لقد أسقطتُها في الأسفل فقط

76
00:07:53,230 --> 00:07:54,880
هيّا بنا يا تسوباسا

77
00:08:02,200 --> 00:08:05,080
كفِّي عن إضاعةِ وقتي واخرجي حالاً

78
00:08:12,760 --> 00:08:14,010
ماذا حدثَ يا كريس-تشان؟

79
00:08:14,010 --> 00:08:16,510
هجوم، هجوم عدوّ

80
00:08:16,510 --> 00:08:17,930
ما الذي يجري هناك؟

81
00:08:18,930 --> 00:08:19,720
انتبهي

82
00:08:23,850 --> 00:08:26,230
!أي مُزاح هذا؟

83
00:08:37,830 --> 00:08:40,120
البساطة لا تُناسِبني

84
00:08:40,530 --> 00:08:43,500
...ولكن هذه لمسة مُبهرَجة جداً

85
00:08:44,670 --> 00:08:47,320
إن زدتُها فسأصبحُ بسيطة تماماً

86
00:08:53,690 --> 00:08:54,700
...حسناً إذاً

87
00:09:02,360 --> 00:09:04,100
!أنتنّ! ابقين هُنا

88
00:09:04,100 --> 00:09:06,810
"لا يمكننا أن ندعكن تخرجنَ من هنا من دون "الواصِل

89
00:09:07,530 --> 00:09:10,360
بالفعل، هذا أمرٌ طبيعي

90
00:09:10,360 --> 00:09:14,110
قد لا يبدو كذلك، لكنّهن لطيفات جدّاً

91
00:09:15,300 --> 00:09:16,990
،بعد حادِثة فرونتير

92
00:09:17,240 --> 00:09:20,590
اللَّاتي قمنَ بتبنّينا كُنَّ

93
00:09:20,870 --> 00:09:23,380
اللَّاتي قاتلناهُنّ كعدُوَّات

94
00:09:23,700 --> 00:09:27,040
،رُبَّما لأنّنا تحت التجربة

95
00:09:27,510 --> 00:09:29,880
لكنّهن يدعْنَنَ نذهبُ إلى المدرسة

96
00:09:29,880 --> 00:09:32,550
أنتُما؟ لِمَ الخوف الشديد؟

97
00:09:32,780 --> 00:09:33,810
!أنتُما

98
00:09:33,810 --> 00:09:35,050
صباح الخير

99
00:09:35,380 --> 00:09:37,970
إن لم تُسرِعا سنتأخَّر

100
00:09:44,590 --> 00:09:48,600
لم نكُن حتّى نحلمُ بكلّ المرح الذي قضيناه

101
00:09:48,600 --> 00:09:51,110
آنذاك عندما كنَّا في مركز ف.آي.س للأبحاث

102
00:09:57,480 --> 00:10:00,890
هل من طريقةٍ نحصلُ من خِلالها على القوّة الكافية لمُساعدتهن؟

103
00:10:01,330 --> 00:10:04,610
أريدُ مُساعدتهن بطريقةٍ ما

104
00:10:05,850 --> 00:10:09,470
القوّة اللّازِمة للقيامِ بذلك موجودةٌ هنا بالطبع

105
00:10:10,210 --> 00:10:13,940
ولكن حتّى هذا اليوم لم نتمكّن من تغيير

106
00:10:13,940 --> 00:10:16,810
أيّ شيء من خِلال ذلك وحده يا كيري-تشان

107
00:10:17,460 --> 00:10:19,410
وردَتْنا أنباء جديدة فيما يتعلّقُ بالحريق الذي اندلع

108
00:10:19,410 --> 00:10:21,430
في الشقق العالية ومناطِق مركز المدينة المُحيطة

109
00:10:22,300 --> 00:10:25,930
ما زالت الفوضى عارِمة في المكان، ولكن سُجِّلَتْ مُشاهدات متكرِّرة لشخصٍ مشبوه

110
00:10:26,320 --> 00:10:28,360
ويعتقد البعض بأنّه عمل إرهابي

111
00:10:29,730 --> 00:10:30,600
...كان ذلك

112
00:10:30,920 --> 00:10:32,770
انفجار في الجوّ

113
00:10:33,550 --> 00:10:36,940
رُبَّما يجري شيء آخر

114
00:10:41,950 --> 00:10:44,090
!يا لها من فوضى أحدثَتْها

115
00:10:44,670 --> 00:10:45,900
هل أنتِ بخير؟

116
00:10:45,900 --> 00:10:46,740
نعم

117
00:10:47,900 --> 00:10:50,100
...أنتِ... هذا الثياب

118
00:10:50,450 --> 00:10:51,500
...أنتِ

119
00:10:52,620 --> 00:10:55,310
أنا مُسانِدة صغيرة لا صِلة لها بأحد

120
00:10:55,310 --> 00:10:57,920
بطلة خارِقة لا صِلة لها بالأمم المتّحِدة أو الحكومة اليابانيّة

121
00:10:57,920 --> 00:10:59,380
...تُقاتُلُ ليلاً نهاراً لإنقاذ

122
00:10:59,380 --> 00:11:01,490
يوكيني كريس-سان، قابِضة

123
00:11:01,890 --> 00:11:03,680
إتيشفال سيمفوغير، صحيح؟

124
00:11:04,900 --> 00:11:06,170
...هذا الصوت

125
00:11:06,170 --> 00:11:07,990
أنتِ من أنقذني

126
00:11:10,550 --> 00:11:12,470
اسمي إيلفناين

127
00:11:12,470 --> 00:11:15,380
،لقد كنتُ أبحثُ عنكن جميعاً

128
00:11:15,380 --> 00:11:17,150
لإنقاذِ العالم من خيمياءِ كارول

129
00:11:19,160 --> 00:11:21,950
هل قلتِ "خيمياء"؟

130
00:11:26,340 --> 00:11:27,490
...خيمياء

131
00:11:28,190 --> 00:11:31,810
هل يعني هذا أنَّ التقنيّة العالية التي وُجِدَتْ قبل

132
00:11:31,810 --> 00:11:34,000
العلم والسّحر انقسمَتْ إلى مجالات مختلِفة؟

133
00:11:34,000 --> 00:11:36,900
هذا يعني أنَّ خطرنا الجديد هو نوع مختلِف

134
00:11:36,900 --> 00:11:39,340
من التكنولوجيا الهرطقيّة عن السيمفوغير

135
00:11:41,700 --> 00:11:43,070
عدو جديد

136
00:11:43,780 --> 00:11:45,420
خيميائيّ

137
00:11:48,190 --> 00:11:51,770
كيف أبيعُ مقطعاً كهذا لمحطّة التلفزيون؟

138
00:11:52,100 --> 00:11:54,520
لا ينبغي أن تصوِّرَ شخصاً دون إذنه

139
00:11:55,750 --> 00:11:58,550
هذا يُثبِتُ مدى سوء تربيتك

140
00:12:13,970 --> 00:12:16,460
أتُريدين حقيقة حتّى لو كلّفَكِ ذلك القِتال؟

141
00:12:16,760 --> 00:12:19,820
نعم، ألديكِ واحدة كذلك؟

142
00:12:20,120 --> 00:12:23,720
لهذا أوقفتِ دمارَ القمر بأغانيكِ

143
00:12:23,720 --> 00:12:26,490
بأغانيكِ، بالسيمفوغير الذي لديكِ

144
00:12:26,490 --> 00:12:27,850
قاتلتِ

145
00:12:28,110 --> 00:12:29,090
لا

146
00:12:29,410 --> 00:12:31,620
كلّ ما في الأمر أنني كنتُ مُضطرّة لذلك

147
00:12:31,970 --> 00:12:33,910
...لم أكُن أرغب

148
00:12:34,660 --> 00:12:37,310
لم أكُن أرغبُ بالقتال

149
00:12:38,060 --> 00:12:41,360
أردتُ حِماية الناس بالسيمفوغير خاصّتي

150
00:12:42,960 --> 00:12:44,800
قاتِلي على أي حال

151
00:12:47,380 --> 00:12:49,870
افعلي ما تقتضيه قوّتكِ أن تفعليه

152
00:12:50,270 --> 00:12:54,120
...لا أريد القِتال باستخدام قوّة الغاية منها إنقاذ النّاس

153
00:12:55,740 --> 00:12:59,050
!هل ستُحاولين إنقاذ النّاس وتُقتَلين أيضاً إذاً؟

154
00:12:59,840 --> 00:13:01,630
منفذ طاقة عالية المُستوى

155
00:13:02,360 --> 00:13:04,550
لماذا لا تُقاتِلُ في حَضرةِ العدوّ؟

156
00:13:05,140 --> 00:13:06,360
أرسِلوا تعزيزات

157
00:13:06,660 --> 00:13:09,920
لا، إن لم يكونوا "نويز" فسأذهبُ أنا

158
00:13:10,390 --> 00:13:11,680
أرسِلوا قِوى المقرّ إلى هناك حالاً

159
00:13:11,910 --> 00:13:15,480
لا، من دونِك سيتوقّفُ تسلسلُ قيادتنا

160
00:13:19,430 --> 00:13:20,420
...ولكن

161
00:13:21,080 --> 00:13:23,860
كنتِ تبكين منذُ بُرهة

162
00:13:24,620 --> 00:13:25,490
،بدلاً من القتال

163
00:13:25,830 --> 00:13:28,820
عليّ أن أكتشفَ السبب

164
00:13:29,870 --> 00:13:32,180
لقد راتْني، إنها تعلم

165
00:13:32,180 --> 00:13:33,460
اقتربَتْ منِّي كثيراً

166
00:13:35,590 --> 00:13:36,830
سأُدمِّرُك

167
00:13:41,100 --> 00:13:42,840
وأدمِّر العالم

168
00:13:44,590 --> 00:13:46,930
تمّ رصد تشوُّه مكاني

169
00:13:46,930 --> 00:13:48,340
إنه نوع غير معرَّف من الطاقة

170
00:13:48,630 --> 00:13:49,830
هيبيكي-تشان، هل أنتِ بخير؟

171
00:13:49,830 --> 00:13:51,850
هيبيكي-تشان، هيبيكي-تشان

172
00:14:09,620 --> 00:14:12,410
لماذا تُريدين تدمير العالم؟

173
00:14:12,890 --> 00:14:15,490
إنه التحدِّي الذي تركَه لي أبي

174
00:14:16,380 --> 00:14:18,420
ينبغي أن يكون لديكِ شيء كهذا أيضاً

175
00:14:19,800 --> 00:14:21,340
أبوكِ؟

176
00:14:21,920 --> 00:14:24,670
...كم أنتِ مُزعجة

177
00:14:26,290 --> 00:14:27,700
كنتِ تُشاهدين؟

178
00:14:28,220 --> 00:14:30,430
هذا هو طبعكِ يا غاري، متعفِّنة للغاية

179
00:14:32,980 --> 00:14:35,010
...لا تقولي ذلك

180
00:14:35,010 --> 00:14:38,190
أنتِ من جعلَني هكذا

181
00:14:38,650 --> 00:14:40,860
ما أخبار جمع الذاكرة؟

182
00:14:40,860 --> 00:14:42,370
على خير ما يُرام

183
00:14:42,370 --> 00:14:46,690
ولكن ميكا-تشان داخل الجرم، لِذا هذا ليسَ ممتعاً

184
00:14:47,000 --> 00:14:48,110
أسرعي إذاً

185
00:14:48,110 --> 00:14:49,750
سنغادر

186
00:14:49,750 --> 00:14:51,180
حاضر

187
00:14:51,180 --> 00:14:53,580
ستفعلُ غاري ما بوسعها

188
00:14:58,720 --> 00:15:00,850
وداعاً

189
00:15:03,400 --> 00:15:04,880
قاتلي في المرّة المُقبِلة

190
00:15:05,620 --> 00:15:09,620
وإلَّا فلن أستطيعَ تدمير كلّ ما لديكِ

191
00:15:23,200 --> 00:15:24,500
...مُؤتمنة

192
00:15:26,230 --> 00:15:27,550
...أبي

193
00:15:27,850 --> 00:15:30,570
...لم يُعطِني أي شيء

194
00:15:31,410 --> 00:15:32,610
...قَطّ

195
00:15:36,680 --> 00:15:38,700
استعيدي هيبيكي-تشان فوراً

196
00:15:39,520 --> 00:15:43,140
ما هذا الإحساس الغريب الذي ينتابُني بأنّ هُنالِك مُشكلة ما؟

197
00:15:45,920 --> 00:15:47,920
نحنُ نتثبّتُ ممّا يجري الآن

198
00:15:47,920 --> 00:15:50,750
أغلِقوا المخرجَين أ-3 و أ-6 حالاً

199
00:15:52,640 --> 00:15:54,220
...العميلة ماريا

200
00:15:54,850 --> 00:15:58,220
يُفترَض أن يحدَّ برنامجُ الحماية تحرّكاتكِ

201
00:15:58,610 --> 00:16:01,450
هذا أمر طارئ، سنستعيرُ هذه السيَّارة

202
00:16:02,780 --> 00:16:04,360
لا نسمح لكِ بالقيامِ بذلك

203
00:16:08,370 --> 00:16:09,190
ماذا؟

204
00:16:09,190 --> 00:16:10,860
...لا أستطيع الحركة

205
00:16:13,470 --> 00:16:14,370
أوغاوا-سان

206
00:16:14,370 --> 00:16:16,800
آسفة، لكنّني أفعلُ ما أشاء مع تسوباسا

207
00:16:22,310 --> 00:16:23,680
ما الذي يجري؟

208
00:16:24,240 --> 00:16:25,630
ماذا؟

209
00:16:25,940 --> 00:16:28,880
تِلك الغبيّة هُزِمَتْ بواسطة المُهاجم؟

210
00:16:29,290 --> 00:16:31,300
يبدو بأنَّ تسوباسا-سان وماريا-سان

211
00:16:31,300 --> 00:16:33,550
قد تراجعَتا وتُعيدان تنظيم نفسيهما أيضاً

212
00:16:35,110 --> 00:16:38,680
هل هذه الخيمياء أكثر قوّة من سيمفوغير؟

213
00:16:39,130 --> 00:16:41,330
لديّ 252 هنا كذلك

214
00:16:41,330 --> 00:16:42,430
أخبروني أين نقطة الالتقاء

215
00:16:51,240 --> 00:16:53,300
ما هذا؟

216
00:16:54,570 --> 00:16:57,570
تسوباسا-سان، ما الذي يجري؟

217
00:16:57,570 --> 00:16:58,850
أنا آسفة

218
00:16:59,380 --> 00:17:01,430
يبدو بأنَّ ماريا لديها فكرة

219
00:17:01,430 --> 00:17:03,070
سأتركُ صالة الحفل الموسيقيّ لك

220
00:17:04,550 --> 00:17:06,850
أريدُ تفسيراً

221
00:17:07,210 --> 00:17:08,970
ارجعي بذاكرتكِ

222
00:17:12,550 --> 00:17:14,790
لقد كنتُ أنتظركِ

223
00:17:15,520 --> 00:17:17,670
،بِلا شكّ

224
00:17:17,670 --> 00:17:19,810
أنتِ هي هدفُها

225
00:17:20,740 --> 00:17:23,060
إنَّ خير وسيلة لتقليصِ الأضرار هي

226
00:17:23,060 --> 00:17:25,930
إبعادكِ عن الحشودِ أطول مسافة مُمكِنة

227
00:17:25,930 --> 00:17:29,020
ومن ثمّ يجدرُ بنا التعاون مع الآخرين

228
00:17:30,140 --> 00:17:33,310
بالكاد أستطيعُ تحمُّل بعض من قيودي الكبيرة

229
00:17:36,230 --> 00:17:38,710
أتطلبُ منِّي أن أكذبَ أكثر مما كذبت؟

230
00:17:39,560 --> 00:17:41,850
نطلبُ منكِ الاستفادة من شهرتكِ

231
00:17:41,850 --> 00:17:48,040
لِلَعبِ دور في حلِّ هذه المسألة بسلامٍ قدر المُستطاع

232
00:17:48,360 --> 00:17:50,100
لعب دور؟

233
00:17:50,680 --> 00:17:53,010
الهويّة الحقيقيّة للمُطرِبة ماريا

234
00:17:53,010 --> 00:17:55,470
هي عميلة تعملُ لحسابِنا نحن، الأمم المتّحِدة

235
00:17:55,970 --> 00:17:58,630
كنتِ تندسِّين من بين الفوضويّين

236
00:17:58,630 --> 00:18:02,160
"لمنعِهم من إساءةِ استعمال "الآثار

237
00:18:04,140 --> 00:18:08,080
من المُستحسَن أن تُنقلَ قصّة بطوليّة مفهومة ولطيفة كهذه لعامّة الناس

238
00:18:08,380 --> 00:18:11,820
هل عليّ إذاً أن أعودَ إلى كوني نجمة مزيّفة؟

239
00:18:11,820 --> 00:18:13,260
نجمة مزيّفة؟

240
00:18:13,260 --> 00:18:15,800
أجل، نجمة

241
00:18:15,800 --> 00:18:18,700
إذا كانَتْ نجمة بطَلة تقيمُ حفلات موسيقيّة خيريّة

242
00:18:18,700 --> 00:18:21,900
في كلّ أنحاء العالم فستكونُ هذه دعاية جيّدة أيضاً

243
00:18:23,130 --> 00:18:25,450
يبدو بأنّ حكومة الولايات المتّحدة الأمريكيّة استخدمَتْ إيكيلون

244
00:18:23,130 --> 00:18:28,460
إيكيلون - هو نظام عالمي لرصد البيانات، واعتراضها ونقلها. يتم تشغيله من قبل مؤسسات استخبارية في خمس دول

245
00:18:25,450 --> 00:18:27,520
لتعقُّب كلّ البيانات ذات الصِّلة

246
00:18:27,520 --> 00:18:31,490
،ومسحها من كلّ شبكة

247
00:18:31,490 --> 00:18:33,540
بما في ذلك الحواسيب ذات الاستعمال الشخصي

248
00:18:35,460 --> 00:18:40,840
ولكن هي والقاصِرات اللّاتي عمِلنَ معكِ أمامهنّ مُستقبل يُخطِّطن له

249
00:18:42,380 --> 00:18:44,660
ما أعنيه هو أنّكِ حتّى من دون درعكِ

250
00:18:44,960 --> 00:18:49,270
ما زالَ بمقدوركِ القتال لأجلِ شخص آخر

251
00:18:51,060 --> 00:18:52,110
،على الرغمِ من ذلك

252
00:18:52,400 --> 00:18:55,040
لن أدعَ شيئاً كهذا أن يكونَ معركتي

253
00:18:58,110 --> 00:18:59,110
ماريا

254
00:20:08,500 --> 00:20:10,070
،رُبَّما كِلتانا نُشهِرُ سيفاً

255
00:20:10,070 --> 00:20:13,810
ولكن سيفي هو كسّارُ سيوف

256
00:20:22,660 --> 00:20:24,880
لا... نويز؟

257
00:20:24,880 --> 00:20:25,910
!لماذا؟

258
00:20:26,260 --> 00:20:27,030
كريس-تشان

259
00:20:27,030 --> 00:20:28,540
أعلمُ ذلك

260
00:20:28,940 --> 00:20:31,290
أرى بعضاً من الصديقات القديمات هنا أيضاً

261
00:20:31,660 --> 00:20:32,790
تطابُق شكل الإشارة

262
00:20:33,340 --> 00:20:35,290
...لقد عرَفت، شكل الإشارة غير المعرَّف في اللّيلةِ الماضية كان

263
00:20:36,430 --> 00:20:38,670
ظننتُ أنَّ عصا سُليمان وكنز بابل

264
00:20:39,160 --> 00:20:42,360
قد دُمِّرا بحرارةٍ درجتها مليار

265
00:20:45,340 --> 00:20:47,070
سيكونُ من المُفيد حقّاً

266
00:20:47,070 --> 00:20:50,140
لو سمحتِ لي أن أُدمِّرَ سيفكِ

267
00:20:50,140 --> 00:20:54,270
وهل تتوقّعين منِّي أنوثة كهذه؟

268
00:20:56,320 --> 00:20:58,770
ولكن قالَتْ لي صديقتي ذات مرّة

269
00:20:59,050 --> 00:21:00,900
بأنّ نصل حامِية ليسَ أنثويّاً

270
00:21:00,900 --> 00:21:03,030
وهل الوقت مناسِب لقولِ ذلك؟

271
00:21:14,040 --> 00:21:16,330
راكشاسا العكسيّ

272
00:21:17,420 --> 00:21:19,840
لا تهمّني أعدادكم، لقد فعلتُ هذا سابقاً

273
00:21:19,840 --> 00:21:21,420
لن أخسر

274
00:21:36,240 --> 00:21:36,900
...سيفي

275
00:21:46,850 --> 00:21:48,030
ماذا؟

276
00:21:50,840 --> 00:21:54,660
...هذا حَتفُكِ لاستهانتكِ بهم وظنّكِ أنّهم مجرّد نويز بُسطاء

277
00:21:56,540 --> 00:22:00,500
إيّاكما والظنّ بأنّكما ستفلتان بمجرَّد هزيمة

278
00:22:01,590 --> 00:22:02,890
ما الذي يجري؟

279
00:22:02,890 --> 00:22:04,970
درعاهما يتحلّلان

280
00:22:05,320 --> 00:22:07,940
ليسَتْ نويز؟

281
00:22:09,990 --> 00:22:11,430
...آلكا-نويز

282
00:22:12,270 --> 00:22:16,270
!ماذا ستفعلين يا سيمفوغير؟