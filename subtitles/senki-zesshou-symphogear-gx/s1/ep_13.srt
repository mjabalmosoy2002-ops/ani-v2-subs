1
00:00:11,160 --> 00:00:12,310
هل سمعتِ؟

2
00:00:12,310 --> 00:00:14,870
شيرابي-تشان وكيريكا-تشان قويّتان، صحيح؟

3
00:00:15,190 --> 00:00:17,120
أعتقدُ بأنهما ازدادتا قوّة حقّاً

4
00:00:17,510 --> 00:00:19,990
ألا تعتقدين ذلك يا إيلفناين-تشان؟

5
00:00:20,700 --> 00:00:23,600
بلى... أعتقد

6
00:00:24,750 --> 00:00:27,540
وسيُسرِّعُ هذا من نهايةِ العالم

7
00:02:26,920 --> 00:02:27,910
...سيّدتي

8
00:02:27,910 --> 00:02:30,640
ألا يعمل آخر أجسامكِ الاحتياطيّة بشكلٍ سليم؟

9
00:02:30,640 --> 00:02:34,090
أعدتُ تنصيب ذاكرتي دون اعتِبار للعبء الذي سيُشكِّلُه ذلك على جسدي

10
00:02:34,800 --> 00:02:37,130
وأيضاً ذكريات قَتلي لنفسي

11
00:02:37,130 --> 00:02:39,270
تسبِّبُ رفضاً

12
00:02:39,820 --> 00:02:41,220
ماذا ستفعلين؟

13
00:02:41,670 --> 00:02:43,850
سأتجاهلُها بالطبع

14
00:02:44,740 --> 00:02:46,850
كلّ شيء في مكانه

15
00:02:47,150 --> 00:02:50,230
لن أفوِّت هذه اللحظة

16
00:02:52,530 --> 00:02:54,400
...لا أستطيع رؤية شيء

17
00:02:54,400 --> 00:02:56,050
الظلامُ دامِس

18
00:02:56,050 --> 00:02:58,780
مُدِّي يديكِ للأعلى فحسب

19
00:03:00,610 --> 00:03:01,580
ما رأيكِ؟

20
00:03:01,580 --> 00:03:03,830
إنه مجرّد فحص

21
00:03:03,830 --> 00:03:05,780
...أنتِ تهوِّلين الأمرَ كثيراً

22
00:03:05,780 --> 00:03:08,580
هذه غلطتكِ كما تعلمين

23
00:03:16,900 --> 00:03:18,690
عليّ الذهاب إلى الفحص

24
00:03:19,020 --> 00:03:20,280
...هيبيكي

25
00:03:20,280 --> 00:03:20,920
أنا بخير

26
00:03:21,310 --> 00:03:22,550
لستِ بخير

27
00:03:27,280 --> 00:03:28,450
لديّ أنتِ

28
00:03:28,770 --> 00:03:29,960
ولديّ الجميع

29
00:03:30,260 --> 00:03:33,080
لِذا أنا بخير حتّى من دون أبي

30
00:03:39,350 --> 00:03:40,180
أهذا هو؟

31
00:03:40,480 --> 00:03:42,070
قصر كازاناري ياتسوهيرو

32
00:03:42,380 --> 00:03:44,200
هذا هو مسقطُ رأسكِ

33
00:03:45,210 --> 00:03:46,450
لقد مضَتْ عشر سنوات

34
00:03:47,100 --> 00:03:50,700
لم أتوقع أن أعودَ بهذا الشكل

35
00:03:51,400 --> 00:03:52,710
جاري عرض نتائج المراقبة

36
00:03:53,630 --> 00:03:55,990
تتلقَّى هذه المناطِق توصيلاً كهربائياً كأولوية

37
00:03:55,990 --> 00:03:57,820
هنالِك الكثير

38
00:03:57,820 --> 00:04:01,090
...والمكان الذي يتلقَّى أكثر من بقيّة الأماكن هو

39
00:04:01,480 --> 00:04:03,220
قصر تنِّين ما تحتَ البحر

40
00:04:04,060 --> 00:04:05,520
منطِقة محظورة كلّياً

41
00:04:05,520 --> 00:04:09,160
حيثُ تُبعَدُ أدوات غير مُحلَّلة ومواد خطيرة ذات علاقة بالآثار

42
00:04:09,930 --> 00:04:13,230
إنه سرِّيٌ للغاية لدرجة حتّى نحن لا نعرف

43
00:04:13,230 --> 00:04:15,850
تفاصيلَ ما يوجد هناك

44
00:04:19,000 --> 00:04:21,020
إنّهن يستهدِفن شيئاً خطيراً هناك

45
00:04:21,020 --> 00:04:24,990
المسألةُ بسيطة إذاً، جلّ ما علينا فعله هو أن نسبقهن إلى هناك وننتظرهن

46
00:04:25,320 --> 00:04:28,240
ولكن ثمّة نقطة واحدة أخرى نعتقدُ أنهن سيُشنّون هجوماً عليها

47
00:04:29,770 --> 00:04:30,870
...هذا

48
00:04:31,280 --> 00:04:35,280
أثارَ شيءٌ ما قلقي، لهذا عادَتْ إلينا بعض الاستخبارات بالنفع

49
00:04:35,790 --> 00:04:38,210
طبقاً للتقارير، كلّاً من الحوادث الطبيعيّة والمُصطنعة

50
00:04:38,210 --> 00:04:41,060
قد دمّرت المزارات

51
00:04:41,890 --> 00:04:47,260
كانَتْ كافّة هذه المزارات جزءاً من مشروع حماية العاصمة من الظواهر الخارقة الذي رسمَتْه حكومة ميجي

52
00:04:47,630 --> 00:04:50,890
والذي كان يهدفُ للسيطرة على خطوطِ لاي في المنطقة

53
00:04:51,260 --> 00:04:53,080
...الخيمياء وخطوط لاي

54
00:04:53,080 --> 00:04:56,020
يمكننا أن نفرضَ إذاً بأن هذا جزء من خطّة العدو

55
00:04:56,020 --> 00:04:58,650
هنالِك حجرُ أساس في قصرِ كازاناري

56
00:04:59,390 --> 00:05:01,670
هل من المُمكن أن يهاجموه أيضاً؟

57
00:05:02,400 --> 00:05:05,100
،هيبيكي ليسَتْ معنا لأنّها ستخضعُ لفحص في المشفى

58
00:05:05,100 --> 00:05:07,210
ولكن قد تكون هذه فُرصة مثاليّة للهجوم

59
00:05:09,940 --> 00:05:12,040
أوقفنَ غضبَ كارول أرجوكن

60
00:05:14,940 --> 00:05:17,220
حسناً، سأجمعُ الفرق

61
00:05:19,240 --> 00:05:20,310
عُلِم

62
00:05:21,090 --> 00:05:24,840
ستصلُ كريس-سان والأُخريات إلى قصرِ تنِّين ما تحت البحر عمّا قريب

63
00:05:25,080 --> 00:05:28,740
يجدرُ بنا أن نحرصَ على تجنُّب الوقوع في عشِّ شياطين كذلك

64
00:05:36,940 --> 00:05:38,060
...حجر الأساس

65
00:05:38,460 --> 00:05:39,480
...هذا

66
00:05:40,420 --> 00:05:41,380
تسوباسا-سان

67
00:05:42,350 --> 00:05:43,320
أبي

68
00:05:44,170 --> 00:05:45,990
أحسنت صنعاً يا شينجي

69
00:05:47,290 --> 00:05:50,880
"وقد سمعتُ بنشاطاتكِ منذُ انضمامكِ لـ"س.و.ن.غ

70
00:05:50,880 --> 00:05:51,990
نعم

71
00:05:52,330 --> 00:05:54,860
قسم الصوفيّة في آهنينيربي

72
00:05:54,860 --> 00:05:57,780
أصدرَ تقريراً عن الآلكا-نويز

73
00:05:57,780 --> 00:05:59,630
سأطلِعكِ عليه لاحقاً

74
00:05:59,630 --> 00:06:00,360
عُلِم

75
00:06:04,300 --> 00:06:05,450
...أبي

76
00:06:09,040 --> 00:06:11,910
آسف لعدمِ اتِّصالي بك

77
00:06:13,650 --> 00:06:17,140
تعملُ عائلةُ كازاناري بشكلٍ مثالي في غيابكِ

78
00:06:18,280 --> 00:06:21,620
عندما تُنهين واجبكِ هنا، عودي إلى ساحةِ المعركة

79
00:06:21,620 --> 00:06:22,720
!انتظر

80
00:06:23,070 --> 00:06:24,780
أنتَ والدها، صحيح؟

81
00:06:25,080 --> 00:06:26,490
...يعني أنّ هناك أشياء أخرى

82
00:06:26,490 --> 00:06:27,920
ماريا، لا مُشكلة

83
00:06:27,920 --> 00:06:28,820
...ولكن

84
00:06:29,290 --> 00:06:30,280
لا مُشكلة

85
00:06:41,500 --> 00:06:42,850
يا لك من همجيّ

86
00:06:43,650 --> 00:06:47,580
...لم أرد مُقاطعة ذلك اللِّقاء المؤثِّر

87
00:06:49,160 --> 00:06:50,820
!أنتِ تِلك الأوتو سكورر

88
00:06:51,120 --> 00:06:54,890
سأطلِقُ عنان خطّ لاي هذا

89
00:06:54,890 --> 00:06:56,810
هل هدفُكِ هو حجر الأساس إذاً؟

90
00:06:57,600 --> 00:06:58,810
دانسي ماكابري

91
00:06:57,600 --> 00:07:00,890
دانسي ماكابري - بالفرنسية تعني رقصة الموت

92
00:07:05,230 --> 00:07:07,570
حسناً، سأتماشى معكِ

93
00:08:04,830 --> 00:08:06,020
سأتولَّى هذا الأمر

94
00:08:06,020 --> 00:08:08,010
نعم، أدِّي واجبكِ

95
00:08:15,830 --> 00:08:18,430
والآن حاولي أن تُمسكي بي

96
00:08:26,860 --> 00:08:28,360
وميض آزوري

97
00:08:40,290 --> 00:08:41,620
غضب الجنّة الامبراطوري

98
00:08:42,720 --> 00:08:43,620
ما ذاك يا تُرى؟

99
00:08:50,210 --> 00:08:50,880
ماذا؟

100
00:08:54,580 --> 00:08:57,140
...سيفي يتكسَّر

101
00:09:02,610 --> 00:09:03,270
تسوباسا

102
00:09:04,750 --> 00:09:06,830
كسّار سيوفي هو

103
00:09:06,830 --> 00:09:09,380
سلاح فلسفيّ

104
00:09:09,380 --> 00:09:12,970
يستطيعُ تدمير أي شيء يُصنَّف تحت بند سيف مهما كانَتْ صلابته أو قوّته

105
00:09:13,270 --> 00:09:15,530
والآن ماذا ستفعلين؟

106
00:09:15,820 --> 00:09:18,280
حتّى السيمفوغير المُحسَّنة ليسَتْ قويّة بما يكفي؟

107
00:09:20,110 --> 00:09:20,870
لا جدوى

108
00:09:27,560 --> 00:09:31,090
هل كان الأيرغيتلام مُصنَّفاً كسيف كذلك؟

109
00:09:31,490 --> 00:09:32,950
...الأسلحة الفلسفيّة

110
00:09:33,500 --> 00:09:36,340
تؤثِّر على المفاهيم بحدِّ ذاتها وهي أقرب إلى لعنات أو غيشا

111
00:09:33,500 --> 00:09:36,340
غيشا - كلمة تدلُّ إلى شيء محرَّم على نحو ذاتي

112
00:09:37,570 --> 00:09:38,790
آسفة

113
00:09:38,790 --> 00:09:41,440
لستُ مهتمّة بأغانيكِ

114
00:09:43,530 --> 00:09:45,800
هلّا أخبرتِ فتاة السيف؟

115
00:09:45,800 --> 00:09:49,800
عندما تستيقظ، سأعودُ لأستمِع إلى أغانيها

116
00:09:58,670 --> 00:10:00,870
فشِلنا في الدفاعِ عن حجرِ الأساس

117
00:10:00,870 --> 00:10:02,120
أنا آسف

118
00:10:02,690 --> 00:10:05,180
لم أتوقَّع أن يهاجِموا كِلا النقطتَين في آن واحد

119
00:10:05,180 --> 00:10:06,620
...كلا النقطتَين؟ هل تعني

120
00:10:06,850 --> 00:10:09,880
أجل، فالدخلاء في قصرِ تنِّين ما تحت البحر

121
00:10:10,380 --> 00:10:12,500
تمَّ تصويرهن بكاميرات المُراقبة

122
00:10:14,840 --> 00:10:16,010
...كارول

123
00:10:17,210 --> 00:10:19,760
هل ركعَتْ أمام الشيطان وتوسّلَتْ ثمّ عادَتْ إلى الحياة؟

124
00:10:20,310 --> 00:10:22,670
،لا أريد أن أسقط في فخِّهن

125
00:10:22,960 --> 00:10:24,580
لكن لا نستطيعُ تجاهل هذا الأمر

126
00:10:25,050 --> 00:10:28,440
كريس-كون، خذي شيرابي-كون وكيريكا-كون واذهبن

127
00:10:28,440 --> 00:10:29,270
حاضر

128
00:10:35,580 --> 00:10:37,740
هذا هو قصرُ تنِّين ما تحت البحر إذاً

129
00:10:37,740 --> 00:10:39,030
إنه كبير

130
00:10:39,330 --> 00:10:41,590
هذه ليسَتْ نزهة... هيّا بنا

131
00:10:41,590 --> 00:10:42,710
!حسناً

132
00:10:44,580 --> 00:10:46,710
بحوزتي بيانات عن عُمرانِ المبنى

133
00:10:46,710 --> 00:10:48,290
جِدوا الدخيل بسُرعة

134
00:10:49,040 --> 00:10:51,800
هدفُ كارول هو تدمير العالم

135
00:10:52,200 --> 00:10:55,600
لا بدّ وأنها تحاولُ إيجاد إحدى الآثار التي هناك

136
00:10:55,600 --> 00:10:58,920
أو أداة خطيرة ما لها علاقة بالآثار

137
00:11:14,080 --> 00:11:15,050
...هكذا إذاً

138
00:11:15,730 --> 00:11:17,720
...كنتُ أقاتلُ فارا

139
00:11:18,590 --> 00:11:20,610
،حتَّى بعد التخلِّي عن تِلك الأحلام التي كانَتْ جميلة جدّاً بالنسبةِ لي

140
00:11:22,290 --> 00:11:24,140
ما زلتُ لستُ على ما يُرام؟

141
00:11:24,820 --> 00:11:26,600
هل أنتِ بخير يا تسوباسا؟

142
00:11:28,000 --> 00:11:30,280
أنا آسِفة، أخذَتْني على حين غرة

143
00:11:30,920 --> 00:11:32,750
إن كنتِ قادرة على التحرُّك، أودُّ منكِ أن تصطحبيني

144
00:11:32,750 --> 00:11:34,840
يريدُ أبوكِ التكلُّم معكِ

145
00:11:36,120 --> 00:11:37,020
حسناً

146
00:11:40,150 --> 00:11:41,220
ما هذا؟

147
00:11:41,220 --> 00:11:44,650
لقد طلبنا من آهنينيربي تحليل الجُزيئات الحمراء

148
00:11:44,650 --> 00:11:47,210
التي تظهرُ عندما يشنُّ الآلكا-نويز هجوماً

149
00:11:47,510 --> 00:11:49,220
هذا هو التقرير

150
00:11:49,580 --> 00:11:51,000
...آهنينيربي

151
00:11:51,300 --> 00:11:53,870
...مختبر الحكومة الألمانيّة ذو الارتباط الوثيق

152
00:11:53,870 --> 00:11:55,980
...ببحثِ السيمفوغير

153
00:11:56,220 --> 00:11:59,910
يصرِّحُ التقرير بأنّ المادة الحمراء هي بريما ماتيريا

154
00:11:56,220 --> 00:11:59,910
بريما ماتيريا - تعني المادّة الأولى

155
00:11:59,910 --> 00:12:01,360
،وهي المكوِّن الجوهري للمادّة

156
00:12:01,360 --> 00:12:04,240
نشأتْ عندما تفسّخَتِ المادّة

157
00:12:04,240 --> 00:12:06,240
بواسطة آلكاهيست، المُذيب العام

158
00:12:06,590 --> 00:12:08,370
المكوّن الجوهري للمادّة؟

159
00:12:08,370 --> 00:12:09,640
نشأ بالتفسُّخ؟

160
00:12:09,980 --> 00:12:12,750
قيلَ بأن الخيمياء هي بُنية النظريّة في التكنولوجيا الهرطَقيّة

161
00:12:13,080 --> 00:12:15,410
التي تتناولُ عمليةَ التفسُّخ

162
00:12:15,410 --> 00:12:18,290
والتحليل وإعادة البناء

163
00:12:18,290 --> 00:12:20,950
ما الذي تنوي كارول إعادة بِنائه

164
00:12:20,950 --> 00:12:23,380
بعد أن فسّخَت العالم؟

165
00:12:24,480 --> 00:12:25,440
...تسوباسا

166
00:12:25,440 --> 00:12:26,260
نعم؟

167
00:12:27,000 --> 00:12:28,140
كيف حالُ جراحكِ؟

168
00:12:29,680 --> 00:12:31,770
أستطيعُ تسكين الألم

169
00:12:32,050 --> 00:12:35,410
غادري هذا المكان إذاً وحلِّلي هذه المعلومات

170
00:12:35,410 --> 00:12:38,020
في المراكز المختصّة بذلك

171
00:12:39,120 --> 00:12:42,900
فحجر الأساس الذي كنتِ ستحمينه لم يعد موجوداً هنا

172
00:12:44,290 --> 00:12:45,390
عُلِم

173
00:12:45,390 --> 00:12:48,310
،قد يبدو ذلك منطقياً

174
00:12:48,310 --> 00:12:51,060
ولكن أليسَتْ هذه كلِمات

175
00:12:51,060 --> 00:12:52,910
بارِدة بحقِّ ابنتك الجريحة؟

176
00:12:52,910 --> 00:12:54,250
...لا مُشكلة يا ماريا

177
00:12:54,250 --> 00:12:55,170
!تسوباسا

178
00:12:58,140 --> 00:12:59,050
لا مُشكلة

179
00:13:00,770 --> 00:13:02,280
!ما خطبكِ؟

180
00:13:02,280 --> 00:13:04,680
قد يكون مختصّاً في الأمن القومي

181
00:13:04,960 --> 00:13:07,330
لكنه لا يهتمّ بعائلته

182
00:13:07,330 --> 00:13:08,420
...أنا آسفة

183
00:13:08,420 --> 00:13:11,100
ولكن هكذا هي علاقتنا

184
00:13:12,060 --> 00:13:14,650
كانَتْ هذه غرفتي وأنا صغيرة

185
00:13:14,950 --> 00:13:16,820
يمكننا أن نتحدّثَ في الداخل

186
00:13:17,190 --> 00:13:19,070
!هجوم من العدوّ، دُمية أخرى؟

187
00:13:19,940 --> 00:13:21,490
...لا، في الواقع

188
00:13:22,070 --> 00:13:23,570
...هذه غلطتي

189
00:13:24,830 --> 00:13:27,980
ولكن لا أصدِّق أنه لم ينظِّفها منذُ عشر سنوات

190
00:13:29,640 --> 00:13:31,760
،عندما كنتُ صغيرة

191
00:13:31,760 --> 00:13:34,980
أتذكّرُ نفسي وأنا أغنِّي هُنا أغانٍ قديمة لأبي

192
00:13:35,850 --> 00:13:38,460
...ولكن هذه الغرفة

193
00:13:41,100 --> 00:13:42,240
هل كانَتْ هكذا دوماً؟

194
00:13:42,540 --> 00:13:45,060
هل تقصدين بأنني فتاة لا تهتمّ بالتنظيف؟

195
00:13:45,060 --> 00:13:47,470
لا، أقصدُ أباكِ

196
00:13:49,230 --> 00:13:50,810
...حالما كَبُرَ

197
00:13:51,110 --> 00:13:53,100
عميد الأسرة الحالي، جدِّي

198
00:13:53,500 --> 00:13:55,580
كازاناري فودو، بدأ بالتفكير

199
00:13:55,580 --> 00:13:57,710
بمن سيكونُ وريثه

200
00:13:58,320 --> 00:14:01,290
كان هُناك مُرشَّحان

201
00:14:01,290 --> 00:14:03,680
ابنه الأكبر، ياتسوهيرو، والأصغر، عمِّي غينجورو

202
00:14:03,680 --> 00:14:05,360
القائد كازاناري؟

203
00:14:05,730 --> 00:14:08,670
،ولكن بدلاً من أبي أو عمِّي

204
00:14:08,670 --> 00:14:10,990
،اختارَني جدِّي

205
00:14:11,360 --> 00:14:13,210
رغمَ أنني كنتُ حديثة الوِلادة

206
00:14:13,210 --> 00:14:14,120
اختارَكِ؟

207
00:14:14,840 --> 00:14:16,440
...لم يُطلعني على السبب

208
00:14:16,770 --> 00:14:20,070
ولكن أستطيعُ التخمين في هذه اللحظة

209
00:14:20,960 --> 00:14:24,880
يبدو بأنَّ دماء أبي لا يسري في عروقي

210
00:14:25,140 --> 00:14:25,950
ماذا؟

211
00:14:26,620 --> 00:14:29,090
كي يبقى دمُ كازاناري قوياً

212
00:14:29,380 --> 00:14:32,150
جدِّي قد أخصبَ أمِّي

213
00:14:32,150 --> 00:14:33,000
وكانتِ النتيجة أنا

214
00:14:33,700 --> 00:14:37,390
كازاناري فودو... أين إنسانيّته؟

215
00:14:37,820 --> 00:14:39,900
أنتِ لستِ ابنتي

216
00:14:40,500 --> 00:14:43,150
أنتِ مجرَّد أداة قذرة لعائلةِ كازاناري

217
00:14:44,210 --> 00:14:47,000
منذُ ذلك الحين وأنا أتمنَّى

218
00:14:47,000 --> 00:14:50,240
أن يقبلَني أبي قدر المُستطاع

219
00:14:50,240 --> 00:14:53,780
وقد كرّستُ نفسي كأداة، كسيف، بدلاً من إنسانة

220
00:14:56,810 --> 00:14:59,560
ولكن هذا لن يزيدَه

221
00:14:59,560 --> 00:15:02,540
إلَّا كرهاً لي

222
00:15:03,770 --> 00:15:06,670
لقد اتّصلتُ بأنظمة التحكُّم في القصر

223
00:15:06,930 --> 00:15:08,940
،إذا عرفتُ غايةَ كارول

224
00:15:08,940 --> 00:15:10,810
فقد نتمكّن من رسم خطّة

225
00:15:11,610 --> 00:15:12,550
!توقّف هُنا

226
00:15:13,190 --> 00:15:14,680
يانترا سارفاسفا

227
00:15:14,910 --> 00:15:16,310
ما هي هذه؟

228
00:15:16,690 --> 00:15:20,690
مجموعة من المعلومات التي تُتيحُ إمكانيّة تفعيل أي آلة والتحكُّم بها

229
00:15:21,210 --> 00:15:23,690
،إذا حصلَتْ كارول على قطع الزناد

230
00:15:23,690 --> 00:15:27,690
ستستكملُ مُدمِّرَ العالم، تشاتو دي تيفوغيس

231
00:15:28,040 --> 00:15:30,700
لقد حددتُ المنطقةَ التي يتواجدُ فيها يانترا سارفاسفا

232
00:15:32,960 --> 00:15:35,080
أرسلوا فريقَ كريس-كون إلى هناك حالاً

233
00:15:39,240 --> 00:15:41,070
لقد دمّرتِ حجرَ الأساس

234
00:15:41,070 --> 00:15:43,000
ماذا تفعلين هنا الآن؟

235
00:15:44,180 --> 00:15:46,750
أردتُ سماع أغنية فقط

236
00:16:49,480 --> 00:16:50,560
!ماريا

237
00:16:51,330 --> 00:16:53,990
...جسَدي هو نصل، وحتَّى ينكسِر

238
00:16:55,030 --> 00:16:57,370
،إذا كان نصلُكِ سيفاً

239
00:16:57,370 --> 00:16:59,630
ستذلُّه فلسفتي

240
00:17:08,180 --> 00:17:09,450
...إنه يتكسَّر

241
00:17:09,750 --> 00:17:11,700
...جسدي الذي درّبتُه ليكون سيفاً

242
00:17:12,190 --> 00:17:13,210
وكبريائي

243
00:17:19,590 --> 00:17:20,700
أهذه هي؟

244
00:17:20,700 --> 00:17:22,490
اليانترا سارفاسفا

245
00:17:22,490 --> 00:17:24,270
لقد وصلَ فريقُ كريس-تشان

246
00:17:29,420 --> 00:17:30,840
لقد فشِلتُ في أحلامي

247
00:17:31,140 --> 00:17:34,300
...وقاتلتُ بالكبرياءِ الذي لا زلتُ أتشبّثُ به، لكن

248
00:17:36,370 --> 00:17:38,950
إلى أي حدٍّ أنا ضعيفة؟

249
00:17:38,950 --> 00:17:39,860
تسوباسا

250
00:17:39,860 --> 00:17:40,450
تسوباسا-سان

251
00:17:42,180 --> 00:17:42,830
تسوباسا

252
00:17:44,190 --> 00:17:45,330
...أبي

253
00:17:46,610 --> 00:17:47,830
غنِّي يا تسوباسا

254
00:17:49,520 --> 00:17:50,940
ولكن لا يمكنني أن أكون

255
00:17:51,270 --> 00:17:53,730
...أداة لكازاناري ولا سيفها

256
00:17:53,730 --> 00:17:54,720
لا حاجة لأن تكوني أيّ منهما

257
00:17:55,970 --> 00:17:57,070
...أبي

258
00:17:57,960 --> 00:18:00,350
لا تخافي من متابعةِ الحلم

259
00:18:01,840 --> 00:18:04,350
حلمي؟

260
00:18:04,350 --> 00:18:05,570
نعم

261
00:18:05,570 --> 00:18:08,850
لم تُترَك غرفتكِ مهجورة بهذا الشكل لعشر سنواتٍ بِلا سبب

262
00:18:10,500 --> 00:18:13,040
كانَتْ فوضويّة ولكن لم تكن هُناك بقعة غُبار

263
00:18:13,360 --> 00:18:15,540
،أبقاها بهذا الشكل

264
00:18:15,540 --> 00:18:18,260
كي لا يخسر الذكريات التي عاشَها معكِ

265
00:18:18,260 --> 00:18:20,950
لا يوجدُ أبٌ يفعلُ ذلك إن كان يكرهُ ابنته

266
00:18:21,560 --> 00:18:23,700
افهمي هذا فحسب أيتها الفتاة الغبيّة

267
00:18:24,810 --> 00:18:26,490
هل أبعدَني أبي

268
00:18:27,410 --> 00:18:30,090
عن عشيرةِ كازاناري ليُسهِّل عليّ

269
00:18:31,190 --> 00:18:33,590
مُواصلة أحلامي؟

270
00:18:35,280 --> 00:18:37,970
...إن كانَتْ تِلك أمنية أبي

271
00:18:38,940 --> 00:18:40,390
فهل أستطيع

272
00:18:41,270 --> 00:18:43,170
أن أحلم مجدداً؟

273
00:18:51,050 --> 00:18:52,730
اسمعي إذاً

274
00:18:53,170 --> 00:18:54,660
نموذج إغنايت

275
00:18:54,660 --> 00:18:55,730
!سيف مسحوب

276
00:18:57,150 --> 00:18:58,350
داينسليف

277
00:19:14,450 --> 00:19:16,260
دعيني أُذيقُكِ

278
00:19:27,520 --> 00:19:29,270
وميض آزوري

279
00:19:45,370 --> 00:19:47,040
سيغما عجلة القمر المحرَّمة نوع طارئ

280
00:19:54,840 --> 00:19:56,420
اليانترا سارفاسفا

281
00:19:58,050 --> 00:20:00,300
لن أفوِّتَ تِلك الثغرة

282
00:20:05,110 --> 00:20:06,560
هذه كارثةٌ حقيقيّة

283
00:20:13,440 --> 00:20:14,190
!سيّدتي

284
00:20:24,710 --> 00:20:27,160
،ما دمتِ سيفاً

285
00:20:27,160 --> 00:20:30,540
فلن تتمكّني من أذيّتي

286
00:20:33,870 --> 00:20:36,130
لا تخافي من متابعةِ الحلم

287
00:20:36,130 --> 00:20:37,680
أنا لستُ سيفاً

288
00:20:44,230 --> 00:20:45,370
...مستحيل

289
00:20:45,790 --> 00:20:47,350
لماذا لا تؤثِّر أنيابي الفلسفيّة؟

290
00:20:49,740 --> 00:20:52,100
هل تعتبرين هذا سيفاً؟

291
00:20:52,460 --> 00:20:53,100
!كلّا

292
00:20:53,390 --> 00:20:56,540
هذه أجنحةٌ تحلِّقُ نحو أحلامها

293
00:20:57,350 --> 00:21:00,990
اعلمي بأنّ فلسفتكِ عاجزة عن كسرِ أجنحتي

294
00:21:28,000 --> 00:21:29,760
ما الذي يجري؟

295
00:21:34,920 --> 00:21:37,520
...لقد مضَتْ فترة طويلة مُذ حصلتُ على أثر

296
00:21:41,730 --> 00:21:43,950
،المذاقُ حلوٌ جداً

297
00:21:43,950 --> 00:21:46,280
فاتن جداً، مُسبِّب للإدمان

298
00:21:46,640 --> 00:21:47,450
مستحيل

299
00:21:48,000 --> 00:21:49,280
...هذا لا يُعقَل

300
00:21:49,650 --> 00:21:51,330
إنه كذلك بالفعل

301
00:21:51,780 --> 00:21:54,600
،أنا رجلُ الحقيقة

302
00:21:54,900 --> 00:21:58,590
دكتور فير

303
00:23:43,590 --> 00:23:47,000
...لا يعود ما انكسرَ إلى ما كان عليه