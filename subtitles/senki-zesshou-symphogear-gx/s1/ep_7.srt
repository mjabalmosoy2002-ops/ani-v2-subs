1
00:00:02,630 --> 00:00:03,440
...سيفي

2
00:00:11,650 --> 00:00:12,780
ماذا؟

3
00:00:15,560 --> 00:00:19,410
...هذا حَتفُكِ لاستهانتكِ بهم وظنّكِ أنّهم مجرّد نويز بُسطاء

4
00:00:21,140 --> 00:00:24,920
إيّاكما والظنّ بأنّكما ستفلتان بمجرَّد هزيمة

5
00:00:26,130 --> 00:00:27,440
ما الذي يجري؟

6
00:00:27,440 --> 00:00:29,460
درعاهما يتحلّلان

7
00:00:30,000 --> 00:00:32,350
ليسَتْ نويز؟

8
00:00:34,430 --> 00:00:35,820
...آلكا-نويز

9
00:00:36,710 --> 00:00:40,690
!ماذا ستفعلين يا سيمفوغير؟

10
00:02:44,110 --> 00:02:45,100
تسوباسا

11
00:02:55,820 --> 00:02:56,840
كريس-سان

12
00:02:57,860 --> 00:02:59,650
كريس-سان، كريس-سان

13
00:03:04,370 --> 00:03:06,080
اختفَتْ إشارة إتشيفال

14
00:03:06,920 --> 00:03:09,320
أمام نويز؟ هذا مستحيل

15
00:03:09,320 --> 00:03:10,660
...ولكن السيمفوغير هُنّ

16
00:03:12,780 --> 00:03:16,380
ألم يكن سبب التفسُّخ التأثير الكربوني للنويز؟

17
00:03:16,950 --> 00:03:20,370
كانت الغاية من آلكا-نويز تحليل العالم

18
00:03:20,370 --> 00:03:21,630
...إذا استُخدِموا كسلاح

19
00:03:22,110 --> 00:03:25,240
إنَّ اختراق مُختلَف الحقول الدفاعيّة

20
00:03:25,240 --> 00:03:27,770
المحيطة بسيمفوغير أمر بسيط بالنسبةِ لهم

21
00:03:32,300 --> 00:03:34,580
تمَّ تأكيد تدمير النِّظام

22
00:03:35,070 --> 00:03:37,250
وبِهذا نكونُ قد أتممنا عملاً واحداً

23
00:03:54,950 --> 00:03:58,300
لننتقِل الآن إلى النِّهاية التالية، بفريقِ عملها التَّالي

24
00:04:03,930 --> 00:04:05,460
لن أدعَكِ

25
00:04:53,490 --> 00:04:55,270
الموت، الموت، الموت

26
00:05:18,440 --> 00:05:20,040
...أنتِ حقّاً مُبهرَجة

27
00:05:20,390 --> 00:05:22,120
دخلَتْ كيريكا-تشان منطقةَ المهمّة؟

28
00:05:22,120 --> 00:05:23,710
دون استخدام "الواصِل"؟

29
00:05:23,940 --> 00:05:25,420
...ولكن إذا نجحَ هذا

30
00:05:43,070 --> 00:05:45,240
...الإلاهة زابابا

31
00:05:45,960 --> 00:05:47,950
كان كلّ ذلك التلألؤ صرفاً للانتباه؟

32
00:05:51,180 --> 00:05:53,160
صرف انتباه فوقَ صرف انتباه؟

33
00:06:02,840 --> 00:06:06,000
عرفتُ ذلك... مُعاملات توافقيّتنا

34
00:06:06,000 --> 00:06:08,090
ليسَتْ عالية بما يكفي لاستخدامِ الدروع بشكلٍ صحيح

35
00:06:09,040 --> 00:06:09,840
شيرابي

36
00:06:10,640 --> 00:06:13,280
أنا بخير... هُنالِك أمور أهمّ من ذلك الآن

37
00:06:14,750 --> 00:06:16,020
أعلم

38
00:06:19,650 --> 00:06:22,980
لم تكونا جزءاً من الخطّة. أوامركِ من فضلك

39
00:06:22,980 --> 00:06:25,280
لا داعي لمُطاردتهما

40
00:06:26,510 --> 00:06:28,030
آمركِ بالعودة إلى الدِّيار

41
00:06:29,970 --> 00:06:31,530
وهذا ينطبقُ عليكِ كذلك يا فارا

42
00:06:31,840 --> 00:06:34,900
عُلِم، أمركِ

43
00:06:44,220 --> 00:06:47,140
ماذا قصدَتْ عندما قالَتْ بأنّنا لن ننجوا بمجرّد هزيمة؟

44
00:06:48,420 --> 00:06:50,340
شيرابي-تشان وكيريكا-تشان تخرجان من المنطِقة

45
00:06:51,360 --> 00:06:54,100
كريس-تشان والفتاة الأخرى في أمانٍ أيضاً

46
00:06:54,390 --> 00:06:57,080
أسرعوا والتقوا بالقابِضات وأعيدوهنّ إلى هنا

47
00:07:02,320 --> 00:07:05,960
...وجهها يُشبِه وجه الخيميائيّة كارول

48
00:07:13,200 --> 00:07:16,950
حتَّى من دون "الواصِل"، لن نخسرَ أمام شخص كهذه

49
00:07:18,510 --> 00:07:19,460
...كيري-تشان

50
00:07:20,200 --> 00:07:21,580
!أعرِف

51
00:07:23,190 --> 00:07:26,600
كم ينبغي أن نقطعَ من مسافة؟

52
00:07:27,700 --> 00:07:30,010
أطول مسافة مُمكِنة

53
00:07:30,610 --> 00:07:33,510
ولكن حينها لن يختلفَ شيء عمّا كان عليه

54
00:07:38,640 --> 00:07:41,400
كنَّا يتيمتَين، أُخِذنا إلى عالم حيثُ

55
00:07:41,400 --> 00:07:43,520
كانت كلّ الجدران والأسقُف بيضاء

56
00:07:44,060 --> 00:07:47,940
اعتقدنا بأنَّ السيمفوغير التي التقينا بها هُناك كانَتْ قوّة خاصّة

57
00:07:47,940 --> 00:07:49,820
دمّرَتْ كلّ الأشياء المروعة

58
00:07:49,820 --> 00:07:52,570
التي كانَتْ قد حدثَتْ قبل ذلك الحين

59
00:08:02,260 --> 00:08:06,260
"لحمايةِ البشريّة من الكوارث التي سبّبَتْها "الآثار

60
00:08:06,260 --> 00:08:08,960
احتَجنا لاستخدام قوّة الآثار

61
00:08:09,260 --> 00:08:11,170
،هذا ما ظنَّتْه أمِّي

62
00:08:11,170 --> 00:08:13,340
...وأردنا مُساعدتها، ولكن

63
00:08:14,120 --> 00:08:17,470
،استخدمنا قوّتنا لنفعل ما طُلِبَ منّا

64
00:08:17,780 --> 00:08:21,090
ولكن كلّ ما تعلَّمناهُ كان هو أنّنا لم نستطع تغيير أيّ شيء

65
00:08:22,080 --> 00:08:24,610
كانَ كلّ ما لدينا هو ما أرادَتْ أمِّي وماريا أن تفعلاه

66
00:08:24,960 --> 00:08:29,120
،لم نستطع إيجاد ما أردنا فعله

67
00:08:29,120 --> 00:08:30,990
ولهذا حدثَ ذلك

68
00:08:31,780 --> 00:08:35,170
إذا قطعتِ أطول مسافة مُمكِنة بِلا هدف فلا أضمنُ لكِ

69
00:08:35,170 --> 00:08:37,560
أن تجدي ذلك الهدف في النِّهاية

70
00:08:38,190 --> 00:08:40,490
الكِفاح بشكلٍ أعمى ليسَ جيّداً بشكلٍ كافٍ

71
00:08:40,870 --> 00:08:42,080
ألهذا السّبب

72
00:08:42,080 --> 00:08:45,460
لا يدعنَنا نُرافقهن؟

73
00:08:48,260 --> 00:08:49,210
...جيِّد

74
00:08:49,800 --> 00:08:51,050
هل أنتِ بخير؟

75
00:08:51,750 --> 00:08:53,670
لستُ كذلك بالطبع

76
00:08:58,000 --> 00:09:00,750
الفتيات اللّاتي كان من المُفترض أن أحميهنّ قُمنَ بحمايتي بدلاً من ذلك

77
00:09:01,170 --> 00:09:03,220
لستُ بخير بالطبع

78
00:09:06,860 --> 00:09:08,230
هزيمة نكراء

79
00:09:08,770 --> 00:09:12,150
لا بل قد تكون أسوأ من ذلك

80
00:09:12,650 --> 00:09:17,320
يمكنُنا الافتراض ببساطة أنه عندما اختفى الدرع، فالملابس التي كنتُ أرتديها

81
00:09:17,950 --> 00:09:22,580
لم تعُد لأنَّ المحوِّل قد تضرَّر

82
00:09:22,900 --> 00:09:25,300
...إذاً السيمفوغير خاصّتكِ قد

83
00:09:26,660 --> 00:09:30,700
النصلُ المُطلَق، آمي نو هاباكيري، قد انكسر

84
00:09:31,720 --> 00:09:35,920
إتشيفال كريس-تشان وآمي نو هاباكيري تسوباسا-سان قد تضرّرا بشكلٍ بليغ

85
00:09:36,330 --> 00:09:39,800
ماذا يُفترَضُ بنا أن نفعلَ من دون ريوكو-سان؟

86
00:09:40,390 --> 00:09:42,510
أين هيبيكي-كون؟

87
00:09:42,810 --> 00:09:44,310
...أنا بخير

88
00:09:44,950 --> 00:09:46,050
أنا آسفة

89
00:09:46,370 --> 00:09:49,900
...لو استطعتُ فقط أن أتكلّمَ مع كارول-تشان

90
00:09:51,000 --> 00:09:53,120
تتكلّمين معها؟

91
00:10:00,800 --> 00:10:02,930
لقد سمِعنا التقرير

92
00:10:02,930 --> 00:10:05,160
ولكن، ماريا كادنزفنا إيف

93
00:10:05,780 --> 00:10:08,670
القيود المفروضة على شخصكِ لم تُرفَع

94
00:10:12,930 --> 00:10:14,360
،القائد كازاناري

95
00:10:14,360 --> 00:10:16,550
أطلبُ انتقالاً إلى س.و.ن.غ

96
00:10:17,530 --> 00:10:18,550
...ماريا

97
00:10:18,790 --> 00:10:20,800
لا أمتلِك درعاً

98
00:10:21,030 --> 00:10:22,470
،ولكن في هذا الظرف

99
00:10:22,470 --> 00:10:24,500
لا أستطيع البقاء نجمة

100
00:11:40,050 --> 00:11:43,340
يُدعى لحم بقر ستروغانوف

101
00:11:43,340 --> 00:11:46,850
لِذا لم أتوقّع أبداً أنه يمكنُ إضافة أشياء أخرى غير اللّحم في الطبق

102
00:11:46,850 --> 00:11:50,110
الطبخُ الروسيّ عميق جدّاً

103
00:11:50,110 --> 00:11:54,110
إن ظللتِ تتكلَّمين فلن تحظي بوقتٍ كافٍ للأكل

104
00:11:54,240 --> 00:11:56,170
لا تقلقي

105
00:12:00,360 --> 00:12:03,950
...تستحقِّقين هذا كونكِ لم تعيري انتباهاً أثناء استخدام سكِّين

106
00:12:04,890 --> 00:12:06,240
معكِ حقّ

107
00:12:06,620 --> 00:12:09,190
من السيئ أن تجرحي نفسكِ

108
00:12:09,490 --> 00:12:11,040
بأداة مطبخ، أليس كذلك؟

109
00:12:12,900 --> 00:12:17,280
من المُفترَض أن تكون مهمّة السيمفوغير حِماية وإنقاذ الناس

110
00:12:17,840 --> 00:12:21,800
...لا أريدُ أذيّة أحد بواسطتها

111
00:12:22,210 --> 00:12:24,770
ماذا حدثَ في تِلك المهمّة الأخيرة؟

112
00:12:25,420 --> 00:12:28,850
شيرابي-تشان وكيريكا-تشان في المشفى للمُراقبة، صحيح؟

113
00:12:30,570 --> 00:12:32,340
لقد ملَلت

114
00:12:33,040 --> 00:12:36,270
طعام المشفى خالٍ من النكهة

115
00:12:42,620 --> 00:12:44,470
ولكن لا تقلقي

116
00:12:44,470 --> 00:12:47,160
إذا استطعنا أن نتكلّمَ معها فحسب، أنا متأكِّدة بأننا نستطيعُ أن نُفهمها

117
00:12:49,620 --> 00:12:51,020
أنتِ هكذا دوماً

118
00:12:57,500 --> 00:12:59,550
ستعودين إلى اليابان؟

119
00:13:00,000 --> 00:13:03,500
كانَ حلمي الغِناء في كلّ أنحاء العالم

120
00:13:04,370 --> 00:13:05,210
...ولكن

121
00:13:06,010 --> 00:13:08,790
إن كانَ هذا قرارُك، حبّذا أن أحترمه

122
00:13:09,810 --> 00:13:13,090
ولكن هل تعِدينني بأنّكِ يوماً ما

123
00:13:13,090 --> 00:13:15,060
ستسعين وراء تحقيق حلمكِ مجدداً؟

124
00:13:16,800 --> 00:13:18,020
...أنا

125
00:13:22,070 --> 00:13:24,490
ستهبطُ الطائرة قريباً

126
00:13:25,210 --> 00:13:27,440
شدُّوا أحزمتكم لو سمحتُم

127
00:13:33,530 --> 00:13:34,500
تسوباسا-سان

128
00:13:34,770 --> 00:13:36,500
ماريا-سان

129
00:13:45,860 --> 00:13:48,140
كلّ قابِضات السيمفوغير هنا

130
00:13:48,660 --> 00:13:51,230
أو رُبَّما لا يجوز أن نقول ذلك الآن

131
00:13:52,780 --> 00:13:53,750
ما هذا؟

132
00:13:54,510 --> 00:13:56,270
الإتشيفال والآمي نو هاباكيري

133
00:13:56,900 --> 00:13:58,900
اللّذان دُمِّرا بواسطة النّوع الجديد من نويز

134
00:13:59,500 --> 00:14:02,320
...شظايا الأثَر في صميمهما سليمة، ولكن

135
00:14:03,180 --> 00:14:08,030
الوظيفة التي تحوِّلُ الطاقة إلى حامي قد تعطّلَتْ

136
00:14:09,930 --> 00:14:12,080
كما حدثَ بدرع سيرينا تماماً

137
00:14:14,240 --> 00:14:16,210
يمكنُكم إصلاحه بالطبع، صحيح؟

138
00:14:16,750 --> 00:14:19,130
الكشف عن نظريّة ساكوراي

139
00:14:19,130 --> 00:14:22,800
قد سرَّعَ بتطويرِ أبحاث التكنولوجيا الهرطَقيّة حول العالم

140
00:14:23,100 --> 00:14:27,970
ولكن على الرغمِ من ذلك، لا نستطيعُ إصلاح نِظام السيمفوغير من دون ريوكو-سان

141
00:14:29,790 --> 00:14:33,350
حالياً، القابِضة الوحيدة التي لدينا الآن هي أنتِ يا هيبيكي-كون

142
00:14:33,910 --> 00:14:35,280
أنا فقط؟

143
00:14:35,580 --> 00:14:37,320
هذا غيرُ صحيح

144
00:14:37,620 --> 00:14:38,970
...نحنُ أيضاً

145
00:14:38,970 --> 00:14:39,950
لا

146
00:14:40,700 --> 00:14:42,080
لِمَ لا؟

147
00:14:43,400 --> 00:14:47,750
من يدري كم من الجهدِ يُشكِّلُه السيمفوغير على أجسامِكن

148
00:14:48,070 --> 00:14:50,280
دون استخدام "الواصل" لتعزيز التوافقيّة؟

149
00:14:52,030 --> 00:14:55,330
من دون "الواصِل" الذي ضُبِطَ خصِّيصاً لأجلكن

150
00:14:55,330 --> 00:14:57,290
لا يمكنُنا أن نضغطَ عليكن

151
00:14:58,240 --> 00:15:00,280
إذاً ما زلنا مجرّد

152
00:15:00,650 --> 00:15:02,960
أطفال عديمي الفائدة، صحيح؟

153
00:15:03,300 --> 00:15:05,710
أعلمُ بأنَّ نتائج الفحص الطبِّي

154
00:15:05,710 --> 00:15:07,700
أسوأ مما توقَّعنا

155
00:15:07,700 --> 00:15:08,800
...ولكن على الرغمِ من ذلك

156
00:15:09,350 --> 00:15:12,990
لا أريدُ أبداً أن أخسرَ شريكةً أخرى مُجدّداً لسببٍ كهذا

157
00:15:12,990 --> 00:15:15,360
مشاعركنّ أكثر من كافية

158
00:15:19,950 --> 00:15:21,410
!ها أنا ذا

159
00:15:40,520 --> 00:15:45,050
استغرقَ جمعُ الذاكِرة فترة أطول من المُتوقَّعة

160
00:15:45,050 --> 00:15:47,460
لاستخدامِ ميكا، أقوى ما نملك

161
00:15:47,750 --> 00:15:49,310
تبّاً

162
00:15:49,310 --> 00:15:51,340
عملتُ بجدٍّ حقاً

163
00:15:51,340 --> 00:15:56,470
كان القِيامُ بهذا صعباً جدّاً من دون أن يغدو الأمر مكشوفاً

164
00:15:59,750 --> 00:16:01,410
حسناً، لا أهمِّية لذلك

165
00:16:01,700 --> 00:16:04,520
هذا يعني أنَّ كافّة الأوتو سكورر قد تفعّلَتْ

166
00:16:04,860 --> 00:16:08,400
يمكنُنا الانتقال بالخطّة إلى المرحلة التالية

167
00:16:13,510 --> 00:16:14,990
ما الأمر يا ميكا؟

168
00:16:16,430 --> 00:16:19,750
أنا جائعة جدّاً لدرجةِ العجز عن الحركة

169
00:16:20,420 --> 00:16:21,330
...غاري

170
00:16:22,470 --> 00:16:23,960
حسناً، حسناً

171
00:16:23,960 --> 00:16:26,000
هذا عمَلي، صحيح؟

172
00:16:26,700 --> 00:16:30,130
ولديّ عملٌ آخرٌ لكِ

173
00:16:30,870 --> 00:16:32,530
بالمُناسبة يا سيّدتي

174
00:16:30,870 --> 00:16:34,550
مُلاحظة: تقولُ لها "مايستر" وهي كلمة ألمانيّة تعني سيّدتي

175
00:16:32,530 --> 00:16:35,640
يبدو بأنَّ إيلفناين قد تمَّ تبنِّيها بواسطتهم

176
00:16:36,400 --> 00:16:37,820
أُدرِكُ ذلك

177
00:16:40,360 --> 00:16:42,900
نفّذتُ أوامرَ كارول

178
00:16:42,900 --> 00:16:46,110
وعملتُ على بناءِ جزء من جهازٍ ضخم

179
00:16:46,660 --> 00:16:49,360
وذات يوم، وصلتُ لقاعدةِ البيانات وعلِمتُ أنَّ

180
00:16:49,360 --> 00:16:53,520
الغاية من هذا الجهاز هي تحليل العالم ليُصبِح أجزاء ضئيلة

181
00:16:53,820 --> 00:16:56,940
وهربتُ لإيقافِها

182
00:16:57,240 --> 00:17:00,240
تحليل العالم إلى أجزاءٍ ضئيلة؟

183
00:17:01,700 --> 00:17:04,750
هذا مُخيف جدّاً

184
00:17:05,820 --> 00:17:09,810
والخيمياء هي ما تُحقِّقُ ذلك

185
00:17:09,810 --> 00:17:11,730
،كما ترون عندَ النظرِ إلى آلكا-نويز

186
00:17:11,730 --> 00:17:14,530
"والتي تستندُ في طريقةِ عملها على "النويز

187
00:17:14,530 --> 00:17:17,550
تمتلِكُ بالتأكيد قوّة تحليل أي مادّة بما فيها السيمفوغير

188
00:17:17,550 --> 00:17:19,730
ما زالَ هذا الجهاز الضخم، تشاتو دي تيفوغيس، قيد الإنشاء

189
00:17:19,730 --> 00:17:21,930
والغاية منه هي تعزيز هذه القوّة على نِطاقٍ عالمي

190
00:17:22,160 --> 00:17:25,200
،بما أنّكِ كنتِ تُشاركين في بنائه

191
00:17:25,200 --> 00:17:27,690
فهل هذا يعني أنّكِ خيميائيّة أيضاً؟

192
00:17:28,110 --> 00:17:29,040
نعم

193
00:17:29,500 --> 00:17:34,500
ولكن بخلافِ كارول، لا أتحكّمُ بكلّ القدرات والمعارف

194
00:17:34,800 --> 00:17:37,950
صُمِّمتُ لهدفٍ مُحدَّد فقط

195
00:17:38,270 --> 00:17:39,570
صُمِّمتِ؟

196
00:17:40,050 --> 00:17:42,230
نُصِّبتُ فقط بأدنى درجة

197
00:17:42,230 --> 00:17:46,000
من المعرِفة الخيميائيّة المطلوبة لإنشاءِ الجهاز

198
00:17:46,000 --> 00:17:48,280
هل قلتِ "نُصِّبت"؟

199
00:17:48,280 --> 00:17:52,590
"أعني بذلك نقل المعلومات اللّازِمة إلى الدماغِ مُباشرةً كـ"معرفة

200
00:17:53,350 --> 00:17:56,590
ومع الأسف، المعرِفة التي نُصِّبَتْ في داخلي

201
00:17:56,590 --> 00:17:58,570
لا تحتوي على تفاصيل عن المشروع

202
00:17:59,300 --> 00:18:00,100
...ولكن

203
00:18:00,990 --> 00:18:03,700
يمكنُني القول بأنَّ جهاز تحليل العالم

204
00:18:03,700 --> 00:18:06,180
تشاتيو دي تيفوغيس، قد اكتملَ تقريباً

205
00:18:07,500 --> 00:18:10,330
أرجوكم، ساعدوني

206
00:18:10,330 --> 00:18:14,730
لهذا أحضرتُ تراثَ دفيرغر داين إلى هنا

207
00:18:15,610 --> 00:18:17,610
تُراث دفيرغر داين؟

208
00:18:18,290 --> 00:18:19,620
أثر يمكنُ أن يتصدَّى

209
00:18:21,480 --> 00:18:25,770
لقوّةِ الآلكا-نويز والخيميائيّة كارول

210
00:18:26,680 --> 00:18:29,880
شظيّة من السّيفِ السحريّ داينسليف

211
00:18:33,650 --> 00:18:35,850
هذه هي نتائجُ فحصنا لإيلفناين-تشان

212
00:18:36,470 --> 00:18:41,760
أجرينا فحصاً طبِّياً لها تحسُّباً... نعم، لها

213
00:18:42,220 --> 00:18:45,090
لا تُعاني من مشاكِل في الصحّة أو الوظائف الجسديّة

214
00:18:45,090 --> 00:18:50,520
...ولم نُلاحظ أيّ مؤشِّرات لعمليّة زرع أو اقتِراح ما بعدَ تنويمٍ مغناطيسيّ، ولكن

215
00:18:51,650 --> 00:18:52,720
ولكن؟

216
00:18:53,530 --> 00:18:56,780
إنها... إيلفناين-تشان بِلا جنس

217
00:18:57,030 --> 00:19:00,550
تقولُ بأنَّها بشريّة قزمة ببساطة

218
00:19:00,550 --> 00:19:02,530
وغير مشبوهة إطلاقاً

219
00:19:03,160 --> 00:19:05,460
بل هذا مُثيرٌ جداً للشُبهات

220
00:19:05,460 --> 00:19:06,500
...موت

221
00:19:11,210 --> 00:19:14,320
لا أظنُّ أنه من المهمّ كثيراً معرِفة

222
00:19:14,320 --> 00:19:16,650
ما الأجزاء التي قمتِ بإرفاقها

223
00:19:18,240 --> 00:19:20,590
لماذا ترتعدين يا بيكي؟

224
00:19:21,150 --> 00:19:25,010
...أعني...ما الأجزاء التي... معذِرةً

225
00:19:25,360 --> 00:19:29,890
كنَّا نتحدثُ عن الأجزاء التي قد نختارها للمسرحيّة المدرسيّة

226
00:19:29,890 --> 00:19:32,150
كنتِ تشردين مُجدّداً، صحيح؟

227
00:19:34,650 --> 00:19:36,030
معكِ حقّ

228
00:19:36,380 --> 00:19:38,650
تتصرّفين بهذا الشكل طِوال الوقت مؤخراً

229
00:19:39,860 --> 00:19:40,800
آسفة

230
00:19:41,420 --> 00:19:42,840
يجري كثيرٌ من الأحداث

231
00:19:44,180 --> 00:19:48,180
أهذا هو الآلكا-نويز الذي دمّر الآمي نو هاباكيري في لندن إذاً؟

232
00:19:48,560 --> 00:19:49,160
أجل

233
00:19:49,770 --> 00:19:51,860
أظنُّني نسختُه بشكلٍ مُمتاز

234
00:19:52,210 --> 00:19:54,720
هذا فنٌّ طليعي مُبالَغ به

235
00:19:54,720 --> 00:19:58,370
هل تنوين أن تُحقِّقي أوَّل ظهور رسمي لكِ عالمياً في عالم الفنِّ المعاصر أيضاً؟

236
00:19:58,370 --> 00:19:59,680
المُشكلة تكمنُ في حقيقة أنَّنا

237
00:19:59,680 --> 00:20:04,180
لا نمتلِك إلَّا قابِضة سيمفوغير واحدة تستطيعُ مُقاتلة الخيميائيّة

238
00:20:04,460 --> 00:20:06,580
التي تقودُ الآلكا-نويز

239
00:20:07,060 --> 00:20:09,260
ألا يمكننا أن نتفاهم

240
00:20:10,140 --> 00:20:11,770
دون قِتال؟

241
00:20:12,780 --> 00:20:14,040
أتتهرَّبين؟

242
00:20:14,040 --> 00:20:15,950
لا أظنُّني أتهرَّب

243
00:20:16,840 --> 00:20:18,030
...ولكن

244
00:20:18,030 --> 00:20:22,620
،منذُ أن أدركتُ بأنَّ الغانغنير هي قوَّتي الخاصّة حقّاً

245
00:20:22,620 --> 00:20:26,370
كرِهتُ فكرةَ أذيّة الآخرين بقوّة

246
00:20:26,880 --> 00:20:28,710
ينبغي أن تُستخدَم لمُساعدتهم

247
00:20:30,170 --> 00:20:31,220
هذه هي

248
00:20:32,230 --> 00:20:34,380
غطرَسة الأقوياء ببساطة

249
00:20:36,240 --> 00:20:39,840
...مع أنّ ليس هذا ما قصَدت

250
00:20:53,570 --> 00:20:56,360
امتلأ الكأسُ المُقدَّس بالذكريات

251
00:20:56,360 --> 00:20:58,860
فتظهر الفتاةُ التي سيُضحَّى بها

252
00:20:59,480 --> 00:21:02,070
أنتِ إحدى صديقات كارول-تشان، صحيح؟

253
00:21:02,960 --> 00:21:05,850
وكذلك العدوّ الذي يتوجَّبُ عليكنّ مُقاتلته

254
00:21:07,370 --> 00:21:10,520
لا، أريدُ مُساعدة الناس

255
00:21:10,520 --> 00:21:12,250
لا أريدُ أن أُقاتِل

256
00:21:27,540 --> 00:21:32,140
أعرفُ تماماً كيف أجعلُ فتياتٍ صغيراتٍ مُدلّعاتٍ أمثالكن تُقاتلن

257
00:21:32,400 --> 00:21:34,460
إنها شرِّيرة للغاية

258
00:21:34,460 --> 00:21:36,960
هذا وضعٌ غير مُناسِب لنا

259
00:21:36,960 --> 00:21:38,310
...في هذه الحالة

260
00:21:38,860 --> 00:21:42,480
سأدوسُ على حديقةِ الأزهارِ الصغيرةِ المثاليّة تِلك التي في ذهنكِ

261
00:21:53,590 --> 00:21:54,600
هيبيكي؟

262
00:21:57,890 --> 00:21:59,210
...لا أستطيعُ الغِناء

263
00:21:59,690 --> 00:22:00,340
ماذا؟

264
00:22:01,260 --> 00:22:03,590
استسلمي فحسب

265
00:22:05,760 --> 00:22:09,090
...لا تستحضرني الكلمات المُقدَّسة

266
00:22:14,100 --> 00:22:17,640
غانغنير لا تُجيبني