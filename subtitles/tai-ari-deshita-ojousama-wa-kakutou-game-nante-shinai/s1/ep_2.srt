1
00:00:10,020 --> 00:00:12,270
—ما-ماذا

2
00:00:18,210 --> 00:00:19,660
هل حاسوبكِ بخير؟

3
00:00:19,660 --> 00:00:21,210
أجل، على ما أعتقد

4
00:00:21,210 --> 00:00:21,700
ممتاز

5
00:00:22,900 --> 00:00:25,200
إذاً من الأفضل أن نفترق الآن

6
00:00:27,800 --> 00:00:29,120
ميتسكي-سان

7
00:00:34,690 --> 00:00:36,020
أراكِ غداً

8
00:00:54,890 --> 00:00:58,730
في اليوم التّالي، أُقفِلت الغرفة

9
00:02:33,240 --> 00:02:37,220
.انتباه إلى كافّة طلّاب السّنة الأولى
أُضيف اجتماع إلى جدول الأعمال

10
00:02:37,220 --> 00:02:41,690
الرّجاء التجمُّع في قاعة الاجتماعات التّابعة
للبناء أ فوراً بعد تفقُّد الحضور المسائيّ

11
00:02:58,190 --> 00:03:00,060
مساء الخير

12
00:03:00,060 --> 00:03:03,650
اسمي مورينو فوجيميا، رئيسة لجنة
مُراقبي الحرم الدّراسي

13
00:03:03,650 --> 00:03:08,240
لا بُدّ أنّكم تتساءلون عن سبب طلبنا
منكم الاجتماع هنا اليوم

14
00:03:08,240 --> 00:03:10,470
،هذا لأنّ البارحة، بعد الدّروس

15
00:03:10,470 --> 00:03:16,140
حطّمَ أحدٌ نافذةً في الطّابق الأوّل
في بناء الأغراض الخاصّة

16
00:03:18,170 --> 00:03:21,940
مسؤول في الحرَس كان قد شهِدَ
الحادثة قد أبلغ

17
00:03:21,940 --> 00:03:25,160
،بأنّه رغم عدم رؤيته لوجوه الجناة

18
00:03:31,900 --> 00:03:33,470
أراك غداًح

19
00:03:34,870 --> 00:03:38,390
!الزّنبقة البيضاء، أيّتها السّاقطة الغبيّة

20
00:03:38,390 --> 00:03:44,850
لذا أودّ أن أسأل ما إن كانت إحداكن تستطيع
تسليط بعض الضّوء على هذه الحادثة

21
00:03:49,250 --> 00:03:51,110
فهمت

22
00:03:51,420 --> 00:03:57,590
في هذه الحالة، كافّة طالبات السّنة الأولى
سوف تتحمّلن مسؤوليّة جماعيّة

23
00:03:57,590 --> 00:04:02,300
لمدّة شهر واحد، ستُنظّفن جميعاً الحرم
قبل التفقُّد الصّباحيّ

24
00:04:03,480 --> 00:04:05,530
ما هو ردّكن على ذلك؟

25
00:04:05,530 --> 00:04:06,800
عُلِم

26
00:04:07,070 --> 00:04:09,520
حسناً، انصراف. يمكنكن الذّهاب جميعاً

27
00:04:12,280 --> 00:04:16,950
تحطيم نافذة؟ هل تفعل فتاةُ كورومي
شيئاً همجيّاً كهذا حقّاً؟

28
00:04:16,950 --> 00:04:20,700
لا أُصدّق بأنّه يترتّب علينا الاستيقاظ
قبل ساعة كاملة

29
00:04:25,620 --> 00:04:32,240
أشعر أنّ شيئاً مُوازياً للإله طلب منّي
أن أتراجع خطوة وأهدأ

30
00:04:32,780 --> 00:04:35,720
أنا أجعل حياة طالبات السّنة
،الأُولى الأُخريات أصعب

31
00:04:35,720 --> 00:04:38,090
وهفوة واحدة سوف تؤدّي إلى طردي

32
00:04:38,090 --> 00:04:41,940
،الآن بعد أن توقّفتُ في التّفكير حول الأمر
المخاطر تفوق بكثير الجوائز

33
00:04:45,800 --> 00:04:50,300
حسناً، آسفة يا زنبقة بيضاء-ساما

34
00:04:50,640 --> 00:04:55,140
منطقيّاً، لعِب ألعاب القِتال الآن أمر مرفوض

35
00:04:55,710 --> 00:04:56,590
...رغم ذلك

36
00:04:56,800 --> 00:04:58,000
!مُذهل

37
00:04:58,620 --> 00:04:59,610
هيغي"؟"

38
00:04:59,610 --> 00:05:03,680
ناتسومي-سان، هل تمانعين عدم الاقتراب
من المدى المُباشر دون إنذار مُسبَق؟

39
00:05:03,680 --> 00:05:05,570
المدى المُباشر"؟"

40
00:05:05,570 --> 00:05:08,190
حسناً، ماذا تريدينني أن أعلّمكِ اليوم؟

41
00:05:08,190 --> 00:05:10,150
كان لديّ سؤال في الفيزياء

42
00:05:10,150 --> 00:05:13,380
إنّه هذا. أعتقد بأنّها مسألة تتعلّق بالتّسارُع؟

43
00:05:13,380 --> 00:05:16,780
إنّها عن السّرعة، وليس التّسارع

44
00:05:16,780 --> 00:05:18,630
للتّسارع اتّجاه مُعيّن

45
00:05:18,630 --> 00:05:24,780
رغم ذلك، هناك شيء يظلّ يُحيّرني

46
00:05:34,880 --> 00:05:36,740
التّالية، ميتسكي

47
00:05:36,740 --> 00:05:37,770
حاضرة

48
00:05:38,270 --> 00:05:42,030
هل رأيتِ دحرجة بطن الزّنبقة
البيضاء الرّشيقة؟

49
00:05:42,030 --> 00:05:44,160
أجل. يا لها من وثبة فوزبوري أنيقة

50
00:05:44,160 --> 00:05:45,870
دحرجة البطن خاصّتها كانت مُدهشة أكثر

51
00:05:45,870 --> 00:05:47,600
لا يا عزيزتي. كانت الوثبة

52
00:05:47,600 --> 00:05:49,200
لا شيء من... عفواً؟

53
00:05:49,200 --> 00:05:50,150
يا إلهي

54
00:05:49,200 --> 00:05:50,670
!ميتسكي

55
00:05:51,120 --> 00:05:51,670
!حاضرة

56
00:05:55,600 --> 00:05:58,030
شكراً جزيلاً ثانية يا آيا-سان

57
00:05:58,030 --> 00:06:00,920
طريقتكِ في شرح كلّ شيء
لي مُفيدة للغاية

58
00:06:00,920 --> 00:06:05,110
.أنتِ ماهرةٌ جدّاً في الواجبات المدرسيّة
لا بُدّ أنّكِ تستمتعين بالدّراسة

59
00:06:05,110 --> 00:06:09,230
ليس تماماً، لكن أعتقد بأنّني لا أمانع ذلك

60
00:06:09,460 --> 00:06:12,180
هذا أشبه بلغز. أستطيع تأمّله
والتّفكير فيه للأبد

61
00:06:12,180 --> 00:06:13,660
للأبد"؟"

62
00:06:16,390 --> 00:06:20,160
،لكن إذا كنتِ تستطيعين فعلها للأبد
فلا بُدّ أنّكِ تُحبّينها في نهاية المطاف

63
00:06:20,160 --> 00:06:22,610
أجل. قد تكونين على حقّ

64
00:06:23,750 --> 00:06:26,230
"ماذا؟ "حُبّ

65
00:06:26,230 --> 00:06:27,530
حُبّ"؟"

66
00:06:29,270 --> 00:06:31,490
كيف تتألّقين بهذا الشّكل؟

67
00:06:35,080 --> 00:06:37,370
...في الواقع، أعتقد

68
00:06:37,630 --> 00:06:39,820
لا أعرف ماذا أقول لكِ حقّاً

69
00:06:44,630 --> 00:06:47,630
أنا فقط أفعل ما أحبّ بأقصى طاقة لديّ

70
00:06:47,630 --> 00:06:51,300
رُبّما هذا يجعلني وبصورة طبيعيّة
أبدو وكأنّني مُتألِّقة

71
00:07:12,350 --> 00:07:17,180
.انتباه إلى كافّة مُقيمي الحرَم
انتهت فترة الهدوء

72
00:07:17,180 --> 00:07:19,000
ارتدوا ملابس النّوم واستعدّوا لإطفاء الإنارة

73
00:07:19,000 --> 00:07:20,510
...أُكرّر

74
00:07:19,000 --> 00:07:23,200
وقع تحطيم تلك النّافذة ساهمَ
في إعادة تلك المشاعر

75
00:07:23,200 --> 00:07:25,660
الّتي كنتُ أكتمها إلى الواجهة

76
00:07:25,660 --> 00:07:27,120
ماذا لو قضيتُ بقيّة حياتي

77
00:07:27,480 --> 00:07:31,370
دون إيجاد شيء أستطيع أن أنغمس
فيه كما كنتُ في السّابق؟

78
00:07:31,370 --> 00:07:33,440
القلق. الخوف

79
00:07:33,440 --> 00:07:39,020
أقلقتُ نفسي للغاية وقرّرتُ السّعي
خلف ما هو مُعاكس لألعاب القتال

80
00:07:40,550 --> 00:07:45,560
رغم ذلك، ما قالتْه كان سطحيّاً جدّاً
لدرجة أنّني أسخر منه في العادة

81
00:07:46,030 --> 00:07:54,900
لكن من فتاة ذات مظهر مثاليّ وهالة عظيمة
وقدرة الاستمتاع بألعاب الفيديو؟

82
00:07:55,690 --> 00:07:58,640
ليت تلك الجملة لم تخرج من الزّنبقة البيضاء

83
00:07:59,430 --> 00:08:02,750
سأعتزل. سئمتُ ألعابَ القتال

84
00:08:03,160 --> 00:08:04,690
سأعتزل، مفهوم؟

85
00:08:04,690 --> 00:08:08,090
...لكن قبل ذلك، سأحطّم روحها

86
00:08:08,090 --> 00:08:10,050
إلى غُبار

87
00:08:11,750 --> 00:08:13,630
ما الأمر يا آيا-سان؟

88
00:08:13,630 --> 00:08:16,460
،في لحظة، تخرجين كما لو أنّكِ شيطانة

89
00:08:16,460 --> 00:08:18,930
وفي التّالية، تعودين مع الزّنبقة البيضاء

90
00:08:18,930 --> 00:08:21,750
لم أكن أعلم بأنّكما مُقرّبتين إلى هذا الحدّ

91
00:08:21,750 --> 00:08:23,150
ناتسومي-سان

92
00:08:23,500 --> 00:08:25,850
...من فضلكِ لا تسألي عن السّبب

93
00:08:25,850 --> 00:08:30,750
لكن هل تُمانعين النّوم في غرفة
الزّنبقة البيضاء اللّيلة؟

94
00:08:31,220 --> 00:08:33,830
...في الواقع، لا أُمانع ذلك

95
00:08:35,550 --> 00:08:37,590
...لكن هل هذا يعني

96
00:08:38,350 --> 00:08:39,620
...المعذرة

97
00:08:44,400 --> 00:08:46,210
...أقصد

98
00:08:46,210 --> 00:08:50,880
...ما أقصد قوله هو، هل أنتما... المعذرة

99
00:08:51,930 --> 00:08:54,590
!يأتي الحُبّ بأشكال عدّة

100
00:08:55,720 --> 00:08:58,040
...آيا-سان، أنا

101
00:08:58,520 --> 00:08:59,970
!أُشجّعكِ

102
00:09:42,530 --> 00:09:43,680
ف.ت 5

103
00:09:44,260 --> 00:09:46,970
ما رأيكِ بنظام أوّل من يربح خمسة هذه المرّة؟

104
00:09:50,390 --> 00:09:52,330
حسناً. لا مانع لديّ

105
00:10:03,940 --> 00:10:09,160
...أعلم بأنّني أستعرض فحسب، لكن

106
00:10:11,870 --> 00:10:13,080
سوف أسحقها

107
00:10:14,020 --> 00:10:16,140
!سوف أسحقها على أيّ حال

108
00:10:21,780 --> 00:10:23,070
ها هي ذي

109
00:10:23,070 --> 00:10:25,990
،بينما تقذف كُرات ناريّة من باب الأمان
تجثم للحظة

110
00:10:25,990 --> 00:10:28,000
،لتُوهمني بأنّها ستستخدم هادوكين

111
00:10:28,000 --> 00:10:31,240
فتستخدم لكمة مُتوسّطة أثناء القرفصاء
،أو هاشوغيكي، والّذي يبدو مُشابهاً

112
00:10:31,240 --> 00:10:34,020
لتستدرجني إلى التصدّي وجعل تملُّصي
المُضادّ للكُرة النّارية يزول

113
00:10:34,020 --> 00:10:38,040
وحالما أركّز على كُراتها النّاريّة للحرص
...على ألّا أقع ضحيّة ذلك

114
00:10:41,940 --> 00:10:43,930
أكره ألّا أكون مُتيقّنة

115
00:10:44,250 --> 00:10:46,880
أعلم بأنّه لا يوجد ما يضمن بأنّ هذا
سوف يؤدّي

116
00:10:46,880 --> 00:10:49,790
إلى "شيء أستطيع غمس نفسي
"فيه كما كنتُ في السّابق

117
00:10:49,790 --> 00:10:55,270
كلّ ما أنا متأكّدة منه هو بأنّني
لن أكتشف إذا لم أُتابع

118
00:10:55,270 --> 00:11:00,990
لكن إذا كنتُ لا أزال أتساءل ما إن كنتُ
في الطّريق الصّحيح، فسأهدر كثيراً من الوقت

119
00:11:00,990 --> 00:11:01,760
...لذا

120
00:11:02,060 --> 00:11:03,130
سأنكركِ

121
00:11:03,130 --> 00:11:04,350
...وذلك كي أكون مُتيقّنة

122
00:11:04,760 --> 00:11:06,100
...لأجل مُستقبلي

123
00:11:06,100 --> 00:11:08,890
!الزّنبقة السّوداء، سوف أنكركِ

124
00:11:09,630 --> 00:11:11,400
:هذا أكثر ما تبرع فيه كامّي

125
00:11:11,400 --> 00:11:14,570
ذبح الخصوم العالقين في الزّاوية

126
00:11:14,570 --> 00:11:16,940
!إنّها في عداد الموتى

127
00:11:21,160 --> 00:11:24,330
خرجت من الزّاوية؟ استطاعت الإفلات منها

128
00:11:25,000 --> 00:11:25,710
ماذا؟

129
00:11:28,850 --> 00:11:32,980
أقصد... ماذا؟ ما الّذي كانت تُفكّر فيه
باستخدام حصانة كهذه؟

130
00:11:32,980 --> 00:11:34,340
الحركات الحصينة

131
00:11:34,340 --> 00:11:39,450
بعض الحركات الخاصّة لديها فترة قصيرة
من الحصانة عند البدء

132
00:11:39,450 --> 00:11:43,090
حتّى لو كانت هجمة أو رمية كانت
،لتسحق تلك الحركات عادة

133
00:11:43,090 --> 00:11:46,070
إلّا أنّها تستطيع أن تخترقها وتُصيب
!الخصم الّذي لا يستطيع ردّ الهجوم

134
00:11:46,070 --> 00:11:48,010
هذه هي الحركات الحصينة

135
00:11:48,010 --> 00:11:50,100
،لكن إذا تصدّى الخصمُ لواحدة

136
00:11:50,100 --> 00:11:55,020
،فإنّك ستكون مكشوفاً لأضرار كبيرة
ما يجعل هذه الحركات سيفاً ذا حدّين

137
00:11:55,780 --> 00:11:58,230
هـ-هذا كفيل بالأمر

138
00:11:58,560 --> 00:11:59,950
ما خطبها؟

139
00:11:59,950 --> 00:12:05,360
لم تؤدِّ تلك الحركة الحصينة الخامّ
للإفلات من ضغط الزّاوية

140
00:12:05,360 --> 00:12:08,660
،تصدّتْ وشقّتْ طريقها من الجحيم سليمة

141
00:12:08,660 --> 00:12:12,120
!ثمّ استخدمتْ أوكيزيمي شوريو. خامّ. بلا سبب

142
00:12:12,850 --> 00:12:13,890
إنّها في عداد الموتى

143
00:12:13,890 --> 00:12:16,170
لـ-لا. توقّفي. اهدئي

144
00:12:16,170 --> 00:12:19,400
أولئك الّذين يفقدون هدوءَهم يموتون
أوّلاً. هذه ألعاب قتال

145
00:12:19,400 --> 00:12:21,540
،لكن في النِّزال الثّاني

146
00:12:21,540 --> 00:12:26,090
ربحتْ آيا جولةً باستغلال خطأ لتحطيم
الزّنبقة البيضاء بأوكيزيمي

147
00:12:26,090 --> 00:12:31,060
ثمّ اقتربت آيا من المدى المُباشَر
وظنّتْ بأنّها ستنجح

148
00:12:31,060 --> 00:12:35,820
لتجتاز الزّنبقة البيضاء هجومها وتظفر بالنّزال

149
00:12:38,610 --> 00:12:41,980
إصرارها على الفوز جامح حقّاً

150
00:12:42,370 --> 00:12:45,070
هذا ما يجعل ريو الخاصّ بها مُخيفاً

151
00:12:45,070 --> 00:12:48,860
لكن ينعكس ذلك عليها سلباً كثيراً أيضاً

152
00:12:48,860 --> 00:12:51,320
لماذا أنتِ مُستميتة على الفوز؟

153
00:12:51,320 --> 00:12:56,030
بخلافي أنا، ليس لديكِ ما تضعينه
على المحكّ في هذا الإعداد

154
00:12:59,300 --> 00:13:02,040
الآن نحن مُتعادلتان. أربعة نِزالات
مُقابل أربعة

155
00:13:33,280 --> 00:13:34,990
تبّاً

156
00:13:35,750 --> 00:13:39,120
سوف تعبث برأسي للأبد

157
00:13:51,320 --> 00:13:55,050
في الوقت الّذي ظننتُ بأنّني سيطرتُ فيه
،على الأمور بهدوء شديد

158
00:13:55,050 --> 00:13:57,800
،نفّذتْ اندفاعة أماميّة بجنون

159
00:13:58,180 --> 00:14:00,730
فأصبحتُ مُتوتّرة جدّاً منذ ذلك الحين

160
00:14:02,200 --> 00:14:07,310
لا أفهمها ولا أفهم ريو خاصّتها

161
00:14:07,310 --> 00:14:11,380
...هوسُها الغريب بالفوز، وعدم توقُّع تحرّكاتها

162
00:14:11,380 --> 00:14:15,120
رسمتُ هذه الخطّة على أساس سحقها
بنتيجة 0-5 وتحطيم روحها

163
00:14:15,880 --> 00:14:19,510
.لكن لم يبقَ أمامنا سوى نِزال واحد
مُجرّد هزيمتها ليست كافية

164
00:14:19,510 --> 00:14:22,970
إذا صوّبتُ ضربةَ حظّ وربحتُ دون
،اكتشاف شخصيّتها

165
00:14:22,970 --> 00:14:25,580
فلن أتمكّن من إقناعها بأنّها خسرتْ فعليّاً

166
00:14:30,270 --> 00:14:32,180
—ولهذا السّبب أنا

167
00:14:32,180 --> 00:14:33,340
ميتسكي-سان

168
00:14:35,270 --> 00:14:37,700
...قلبكِ

169
00:14:38,880 --> 00:14:41,550
ينبض بسرعة جنونيّة

170
00:14:48,340 --> 00:14:50,030
هل تستسلمين؟

171
00:14:50,530 --> 00:14:51,510
ماذا؟

172
00:14:51,910 --> 00:14:56,630
أنتِ خائفة جدّاً من المُتابعة، صحيح؟
خُطوات الأقدام تلك أخافتكِ

173
00:14:57,240 --> 00:14:58,440
لا أُمانع

174
00:14:59,080 --> 00:15:01,540
يمكننا أن نفترض بأنّني ربحتُ فحسب

175
00:15:04,780 --> 00:15:06,870
لا، سأكمل اللّعب

176
00:15:08,090 --> 00:15:10,060
هـ-هل هي جادّة؟

177
00:15:19,480 --> 00:15:21,590
أظنّني فهمت

178
00:15:21,590 --> 00:15:24,240
إنّها أشبه بتلميذة مرحلة ابتدائيّة

179
00:15:24,240 --> 00:15:26,610
لهذا السّبب تبكي عندما لا تسير
الأمور وفق هواها

180
00:15:29,230 --> 00:15:31,250
إنّها لا تُفكِّر في يوم غد

181
00:15:31,250 --> 00:15:33,230
المسألة كُلّها تتعلّق بالفوز الآن

182
00:15:36,240 --> 00:15:40,200
...أجل. هذا صحيح، آنذاك

183
00:15:40,200 --> 00:15:43,620
لم أكن ألعب لأجل المُستقبل
،أو أيّ شيء آخر

184
00:15:43,940 --> 00:15:46,370
لكن مع ذلك أردتُ الفوز

185
00:16:21,260 --> 00:16:23,280
!مرحى

186
00:16:32,970 --> 00:16:34,290
...كانت تلك

187
00:16:35,130 --> 00:16:37,530
نِزالات رائعة

188
00:17:20,540 --> 00:17:22,150
...ا-المعذرة

189
00:17:22,150 --> 00:17:24,240
...بخصوص البارحة

190
00:18:02,630 --> 00:18:06,690
س.ف 5 صدرت! لنخُض بطولة
!أُخرى في منزل تاكيدا

191
00:18:06,690 --> 00:18:11,370
لا أدري. الجميع مشغولون بالأندية
وغير مُتفرّغين لهذا

192
00:18:11,370 --> 00:18:12,360
...وأيضاً

193
00:18:12,360 --> 00:18:13,640
أيضاً ماذا؟

194
00:18:13,640 --> 00:18:19,370
قال تاكيدا بأنّه باع كافّة مقابض الأركيد
وأجهزة الكونسول خاصّته لشراء عتاد كيندو

195
00:18:19,940 --> 00:18:24,660
ميتسكي، ألعاب الفيديو مُمتعة، لكن يجدر بكِ
أن تلعبي معنا كُرة القدم في وقتٍ ما

196
00:18:26,560 --> 00:18:28,790
لحظة. لماذا كُرة القدم؟

197
00:18:29,090 --> 00:18:32,170
سأجعلكِ تبكين اليوم، أمفهوم يا ميتسكي؟

198
00:18:33,210 --> 00:18:35,510
أيُّها الكاذبون

199
00:18:36,890 --> 00:18:40,010
لا أستطيع أن ألعب ضدّ أحد بمفردي

200
00:18:40,010 --> 00:18:41,970
هل ينبغي أن أعتذر؟

201
00:18:41,970 --> 00:18:45,360
لكن ماذا سأقول؟ "آسفة لأنّني ربحت"؟

202
00:18:45,360 --> 00:18:47,430
هذا سيُزيد الطّين بلّة أكثر

203
00:18:50,800 --> 00:18:52,520
!أنتِ هنا

204
00:18:52,520 --> 00:18:54,490
حذّريني قبل أن تصرخي هكذا

205
00:18:54,490 --> 00:18:57,450
.هذه غلطتكِ لاقترابكِ منّي خلسة
ماذا تفعلين هنا؟

206
00:18:57,450 --> 00:18:58,490
أليس هذا واضحاً؟

207
00:18:59,700 --> 00:19:01,290
أنا هنا للقتال

208
00:19:34,170 --> 00:19:35,520
بجدّية؟

209
00:19:35,780 --> 00:19:39,400
إنّها تتفادى طوال الوقت. بإجمالي 180 تفادٍ
من اللّيلة قبل الماضية

210
00:19:39,400 --> 00:19:42,990
لكن هذا ليس كلّ شيء. إنّها أفضل
بكثير في التّعامل مع هجومي

211
00:19:43,710 --> 00:19:45,370
متى قمتِ باختبار؟

212
00:19:46,070 --> 00:19:50,490
لا تستطيعين استخدام غرفة الصفّ تلك بعد
الآن، لِذا مُحال أن يكون قد أسعفكِ الوقت

213
00:19:50,490 --> 00:19:51,960
اختبرتُ في عقلي

214
00:19:52,570 --> 00:19:53,920
كلّه في عقلي

215
00:19:53,920 --> 00:19:57,520
،ليس لديّ شيء أفضل أفعله في الصّفّ
لذا قضيتُ طوال الوقت البارحة في المُختبر

216
00:19:58,920 --> 00:20:02,360
إذاً تدرّبتْ للأبد؟

217
00:20:12,400 --> 00:20:13,720
!نِزال جيّد

218
00:20:15,480 --> 00:20:18,700
سأدعكِ تبكين اليوم يا ميتسكي، مفهوم؟

219
00:20:30,040 --> 00:20:32,500
!في المرّة المُقبلة، ستكونين في عِداد الموتى

220
00:22:07,650 --> 00:22:11,230
...حسناً يا ليلي-ساما، بخصوص ذلك الإعداد

221
00:22:11,230 --> 00:22:13,950
بما أنّكِ تصدّيتِ لكلّ تلك الهجمات
،الهوائيّة القريبة من الأرض

222
00:22:13,950 --> 00:22:16,210
ظننتُ حقّاً بأنّني سأتخطّاكِ

223
00:22:16,210 --> 00:22:19,430
لا تقولي لي بأنّكِ لم تكوني تضغطين
—الأزرار بصورة انعكاسيّة، لكن

224
00:22:18,550 --> 00:22:20,180
انتظري لحظة

225
00:22:22,370 --> 00:22:26,980
هل تُمانعين التوقُّف عن ذكر لقب
الزّنبقة البيضاء" المُحرج هذا؟"

226
00:22:27,600 --> 00:22:28,280
ماذا؟

227
00:22:28,280 --> 00:22:31,370
كافّة الآنسات الصّغيرات في كورومي
ينادينَكِ بهذا اللّقب

228
00:22:31,370 --> 00:22:34,160
والزّنابق البيضاء هو ما يربطها النّاس بمريم العذراء

229
00:22:34,160 --> 00:22:35,710
لا، هذا غريب الأطوار فحسب

230
00:22:35,710 --> 00:22:38,620
تتقاذفين الإهانات دون ميكرون تردُّد

231
00:22:40,960 --> 00:22:46,050
يحقُّ للفتيات الثّريّات النّظر إلى العالم من خلال
،نظّارة يوري إذا أردنَ

232
00:22:46,050 --> 00:22:51,700
لكن حبّذا لو يتوقّفن عن منحي ألقاباً
وإقحامي في الأمر فحسب

233
00:22:52,050 --> 00:22:54,250
وماذا يعني "ميكرون"؟

234
00:22:54,250 --> 00:22:57,720
على أيّ حال، جميعهن يتكلّمن
بصوتٍ عالٍ لسبب ما

235
00:22:57,720 --> 00:23:01,900
يستطعنَ على الأقلّ التكلُّم بحيث
لا أسمعهن يتحدّثنَ عنّي

236
00:23:02,180 --> 00:23:03,720
هذا مُزعجٌ للغاية

237
00:23:03,720 --> 00:23:07,550
فشلتُ في تشكيل صداقات في الثّانويّة
وانتهى المطاف بي وحيدة بسببهن

238
00:23:08,340 --> 00:23:11,820
!لستُ جيّدة في الحياة الاجتماعيّة، تبّاً

239
00:23:12,690 --> 00:23:14,350
وأين المُشكلة في ذلك؟

240
00:23:15,640 --> 00:23:18,350
سأكون صديقتكِ، اتّفقنا؟

241
00:23:19,710 --> 00:23:21,320
لِمَ هذه النّظرة؟

242
00:23:22,070 --> 00:23:24,220
يمكنكِ رؤية المُحيط من هنا

243
00:23:24,220 --> 00:23:26,050
ليس وكأنّنا لم نكن نستطيع ذلك من قبل

244
00:23:26,620 --> 00:23:28,570
صديقتان؟

245
00:23:30,170 --> 00:23:31,190
ميو

246
00:23:33,660 --> 00:23:35,130
ميو يوروي

247
00:23:35,460 --> 00:23:37,090
هذا هو اسمي