1
00:00:20,430 --> 00:00:21,900
انظري يا آيا-سان

2
00:00:21,900 --> 00:00:23,870
إنّها "الزّنبقة البيضاء" من صفّ الأوركيد

3
00:00:24,520 --> 00:00:26,080
مَن؟

4
00:00:53,980 --> 00:00:55,830
أ-أستميحكِ عذراً

5
00:01:06,660 --> 00:01:07,800
هل رأيتُن ذلك؟

6
00:01:07,800 --> 00:01:11,360
أعادَتِ الزّنبقةُ البيضاء منديلَها
!دون أن تقول كلمة

7
00:01:11,360 --> 00:01:12,710
إنّها غاية في الرّوعة

8
00:01:12,710 --> 00:01:15,550
كيف يمكنها أن تجعل إيماءة بسيطة
كهذه تبدو أكثر رشاقة؟

9
00:01:15,550 --> 00:01:16,600
!الزّنبقة البيضاء-ساما

10
00:01:17,760 --> 00:01:19,470
لِمَ كلّ هذه الجلبة؟

11
00:01:19,470 --> 00:01:22,310
سيأتي بضعة تلاميذ إلى كورومي
للالتحاق بالمدرسة الثّانويّة

12
00:01:22,310 --> 00:01:26,780
كنّا مُتشوِّقات، فوصلَتْ كوافِدة جديدة مُبهرة

13
00:01:26,780 --> 00:01:28,780
من الطّبيعيّ ألّا نتوقّف عن الحديث حولها

14
00:01:29,470 --> 00:01:32,170
إنّها جديدةٌ هنا مثلي

15
00:01:32,170 --> 00:01:33,320
...لكن

16
00:01:34,130 --> 00:01:37,100
خطفَتْ أنفاسي بمُجرّد وقوفها هناك

17
00:01:37,100 --> 00:01:40,440
إنّها أكثر لباقة حتّى من الآنسات
...المُوقَّرات، وكأنّ

18
00:01:40,440 --> 00:01:43,290
هالةٌ تحوم حولها أو ما شابه

19
00:01:47,420 --> 00:01:48,550
آيا-سان؟

20
00:01:48,550 --> 00:01:50,280
كم هي محظوظة

21
00:01:50,280 --> 00:01:51,310
تبّاً

22
00:01:51,740 --> 00:01:53,430
أشعر بالغيرة

23
00:01:53,900 --> 00:01:55,210
...أريد

24
00:01:55,880 --> 00:02:00,430
أريد أن أبعث هالةً أُنثويّة
!من كافّة مسامات جسدي أيضاً

25
00:02:12,650 --> 00:02:16,030
هذا المكان مُزدحمٌ بالفعل

26
00:02:16,030 --> 00:02:17,300
!آيا-سان

27
00:02:19,310 --> 00:02:22,020
أتريدين الجلوس معنا؟

28
00:02:22,020 --> 00:02:25,170
!بعض الفتيات من صفّي. لحسن حظّي

29
00:02:27,670 --> 00:02:29,660
لا أُمانع ذلك

30
00:02:29,930 --> 00:02:32,740
لم نتغدَّ مع آيا-سان من قبل، أليس كذلك؟

31
00:02:32,740 --> 00:02:33,930
لا أعتقد ذلك

32
00:02:33,930 --> 00:02:37,280
كنّا نتمنّى أن نجري مُحادثة
طويلة ولطيفة معكِ

33
00:02:37,280 --> 00:02:38,640
وكذلك أنا

34
00:02:39,550 --> 00:02:42,440
ماذا؟ هل قائمة طعام اليوم
مُستلهَمة من المطبخ الفرنسيّ؟

35
00:02:42,440 --> 00:02:43,840
هذا ما أعتقده

36
00:02:42,690 --> 00:02:43,840
!حسناً

37
00:02:43,850 --> 00:02:46,420
أستمتع بوجبة منزليّة كهذه
بين الحين والآخر

38
00:02:44,550 --> 00:02:50,060
أعلم بأنّه ليس بالأمر الجديد، لكن ما هذا
الطّعام الإنستعراضيّ الجنونيّ؟

39
00:02:46,420 --> 00:02:48,940
أليس اتّساعها كُلّها في صحن
واحد جذّاباً جدّاً؟

40
00:02:48,940 --> 00:02:50,250
أجل، بالفعل

41
00:02:50,060 --> 00:02:52,230
مع أنّ معلوماتي عن إنستغرام مُتواضعة

42
00:02:50,250 --> 00:02:52,230
حتّى الطّريقة الّتي لُفَّ فيها
البودينغ تبدو منزليّة

43
00:02:52,670 --> 00:02:58,770
،أقصد، إن تحرّيتُ الصّدق، كان لِسان حالي يقول
وكأنّني في مقهى فاخر!" في البداية"

44
00:02:59,240 --> 00:03:01,630
ليس وكأنّني أعرف شيئاً
عن طعام المقاهي الفاخرة

45
00:03:02,510 --> 00:03:05,000
لكن مضى قرابة الشّهرين منذ بدئي هنا

46
00:03:05,000 --> 00:03:10,000
تقديم طعام مقهى لي يوماً تِلو
الآخر يُوتّرني بعض الشّيء

47
00:03:10,400 --> 00:03:12,450
لكن مذاقه مُذهل

48
00:03:12,450 --> 00:03:15,800
مذاق الكاسوليه هذه يُعيدني للذّكريات

49
00:03:15,800 --> 00:03:18,260
كانت ربّة منزلنا تُعدّه طوال الوقت

50
00:03:20,660 --> 00:03:23,890
هل تأقلمتِ مع الحياة هنا الآن يا آيا-سان؟

51
00:03:24,590 --> 00:03:26,850
هذا ما أعتقده، بفضلكن جميعاً

52
00:03:27,180 --> 00:03:28,660
باستثناء الطّعام على أيّ حال

53
00:03:28,660 --> 00:03:32,360
ماذا؟ ما نوع الوجبات الّتي كنتِ
مُعتادة عليها في المنزل؟

54
00:03:32,360 --> 00:03:34,160
أتقرئين أفكاري؟

55
00:03:34,160 --> 00:03:36,520
سمعتُكِ تتكلّمين يا آيا-سان

56
00:03:38,030 --> 00:03:40,020
تحديق

57
00:03:40,020 --> 00:03:43,170
مهلاً. لا تقُلْنَ لي بأنّكن تنتظرنَ إجابتي؟

58
00:03:44,450 --> 00:03:45,580
!هذه هي

59
00:03:45,580 --> 00:03:48,460
!ستُبنى تأويلات كثيرة على ما أقوله الآن

60
00:03:48,460 --> 00:03:53,930
حينها، استهلكتْ آيا مقداراً كبيراً
من السُّكّر لتسريع أفكارها

61
00:03:54,360 --> 00:03:58,220
سأجعل من نفسي مادّة ساخرة إذا
قلتُ كلاماً وضيعاً جدّاً

62
00:03:58,530 --> 00:04:03,360
لكن هذا سؤال من الآنسات الصّغيرات
في كورومي لي أنا، الغريبة

63
00:04:03,360 --> 00:04:06,090
ما يعني بأنّه لا جدوى من مُحاولة التّباهي

64
00:04:06,330 --> 00:04:08,700
ماذا يجدر بي أن أقول
الوقت يُداهمني

65
00:04:09,090 --> 00:04:10,050
!وجدتُها

66
00:04:10,050 --> 00:04:14,760
سأذكر فقط اسمَ أكثر طعام
!أشتهيه في هذه اللّحظة

67
00:04:15,730 --> 00:04:17,080
!أوماكاتشان

68
00:04:17,800 --> 00:04:18,820
رُبّما؟

69
00:04:24,310 --> 00:04:25,890
لماذا؟

70
00:04:25,890 --> 00:04:30,200
لماذا كنتُ أشتهي أوكاتشان بالتّحديد؟

71
00:04:30,600 --> 00:04:32,190
ما هو "أوماكاتشان"؟

72
00:04:32,190 --> 00:04:34,670
ذلك الرّامن الّذي يأتي في أكياس

73
00:04:34,670 --> 00:04:36,140
لم أتناوله من قبل

74
00:04:36,140 --> 00:04:39,700
تعرف آيا-سان أشياءَ كثيرة لا نعرفها

75
00:04:39,700 --> 00:04:42,330
أجل، وليس فقط عندما يتعلّق
الأمر بالواجبات المدرسيّة

76
00:04:43,160 --> 00:04:47,190
طريقة مُحاولتهن مُلاطفتي وحفظ
ماء وجهي زادت الطّين بلّة

77
00:04:53,560 --> 00:04:55,490
أُمّي العزيزة

78
00:04:55,980 --> 00:05:01,100
حلمتُ بأن أُصبح آنسة مُوقَّرة
والتحقتُ بكورومي بمنحة دراسيّة

79
00:05:05,580 --> 00:05:11,310
لكن تعلُّم التصرُّف كآنسة لبِقة هو أمر
أصعب بكثير ممّا توقّعت

80
00:05:33,270 --> 00:05:35,770
...انظري يا آيا-سان. إنّها

81
00:05:35,770 --> 00:05:39,820
...الزّنبقة البيضاء؟ وهي تُمسك

82
00:06:02,680 --> 00:06:05,680
!أجل

83
00:06:15,890 --> 00:06:19,790
مهلاً، مهلاً، مهلاً! ماذا كان ذلك
!بالضّبط أيُّها الضّعيف؟

84
00:06:19,790 --> 00:06:23,360
كيف هو شعورك عقب خسارتك 2-0
بعد كلّ هذا التبجّح؟

85
00:06:23,360 --> 00:06:28,770
أخبرني: كيف لفاشلين مثلك أن يخوضوا
!نِزالاً لا يستطيعون فوزه؟

86
00:06:28,770 --> 00:06:30,790
س.ف 6؟

87
00:06:44,230 --> 00:06:47,890
المعذرة، أنا آسفة جدّاً

88
00:06:47,890 --> 00:06:50,460
...لم أكن أحاول التجسُّس عليكِ أو

89
00:06:59,720 --> 00:07:02,560
...أرجوكِ

90
00:07:02,560 --> 00:07:06,130
أرجوكِ لا تُخبري المُعلّمين

91
00:07:06,600 --> 00:07:08,690
أرجوكِ. أتوسّل إليكِ

92
00:07:08,690 --> 00:07:10,200
أتوسّل إليكِ حرفيّاً

93
00:07:15,600 --> 00:07:20,560
لا تقلقي. لن أُخبر أحداً

94
00:07:23,600 --> 00:07:25,080
المعذرة، وداعاً

95
00:07:31,070 --> 00:07:37,400
انتباه إلى كافّة سُكّان المهجع. السّاعتان
المُقبلتان ستكونان عبارة عن فترة هدوء

96
00:07:37,760 --> 00:07:40,850
الرّجاء العودة فوراً إلى غرفكن والدّراسة

97
00:07:41,550 --> 00:07:42,710
أُكرِّر

98
00:07:43,210 --> 00:07:44,400
...السّاعتان المُقبلتان

99
00:07:47,400 --> 00:07:51,700
أعلم بأنّه فات الأوان قليلاً على السّؤال، لكن
لماذا يُصادرون هواتفَنا في كلّ ليلة؟

100
00:07:51,700 --> 00:07:53,680
يسمحون لنا بالاحتفاظ بحواسيبنا

101
00:07:53,680 --> 00:07:57,390
ماذأ؟ ألا تعلمين بأنّ لعِب ألعاب الفيديو
ممنوع في مهجع كورومي؟

102
00:07:59,650 --> 00:08:02,430
إذاً هذا لمنعنا من اللّعب على
هواتفنا في فترة الهدوء؟

103
00:08:02,430 --> 00:08:04,520
أجل، وليس على الهواتف فقط

104
00:08:04,520 --> 00:08:08,290
سمعتُ بأنّ فتيات طُرِدن لإحضارهن
أجهزة لعِب أيضاً

105
00:08:14,640 --> 00:08:17,930
فهمتُ إذاً. هذه منطقة يُحظَر فيها اللّعب

106
00:08:17,930 --> 00:08:20,530
،يسمحون لنا بإحضار حواسيبنا إلى غرفنا

107
00:08:20,530 --> 00:08:24,900
لكن طالبات السّنة الأُولى جميعهن لديهن زميلة
غرفة، لذا لا يمكننا اللّعب عليها سرّاً

108
00:08:29,240 --> 00:08:33,520
لا بُدّ وأنّ هذا هو سبب مُخاطرتها
بإحضار ألعاب فيديو إلى المدرسة

109
00:08:35,030 --> 00:08:38,910
..."هناك الشّهيرة والمُهذّبة "الزّنبقة البيضاء

110
00:08:38,910 --> 00:08:41,000
ثمّ هناك "الزّنبقة السّوداء"؟

111
00:08:41,590 --> 00:08:47,690
على أيّ حال، إنّها تضع قِناع "الزّنبقة
البيضاء" لتُخفي حقيقتَها

112
00:08:48,760 --> 00:08:54,330
بالطّبع، لا أستطيع أن أبعث هالةَ الأناقة
كهالتِها ولو حاولتُ ذلك

113
00:08:54,330 --> 00:08:55,230
هل هو وجهها؟

114
00:08:55,230 --> 00:08:57,140
هل الشّكل هو ما يهمّ؟

115
00:08:57,140 --> 00:08:57,940
آيا-سان

116
00:08:58,830 --> 00:09:01,530
هلّا ساعدتِني في واجب الرّياضيّات 1؟

117
00:09:01,530 --> 00:09:03,130
ماذا؟ حـ-حسناً

118
00:09:03,430 --> 00:09:07,690
لا أعرف كيف أُحلّل المُعادلات
الجبريّة من الدّرجة الثّانية

119
00:09:07,690 --> 00:09:11,640
قبل أن تُطبّقي الصّيغة، تفقّدي
...العوامل المُشتركة و

120
00:09:10,350 --> 00:09:14,570
حسناً، أيّاً يكن. أشكّ في أنّني
سأختلط معها ثانية

121
00:09:17,340 --> 00:09:18,600
يا فتيات

122
00:09:18,600 --> 00:09:21,710
لديّ رسالة من المُعلّمة

123
00:09:21,710 --> 00:09:25,540
سننضمّ لصفّ الأوركيد في حصّة
التّربية البدنيّة التّالية

124
00:09:27,490 --> 00:09:29,420
ماذا؟ لِمَ تصرخن؟

125
00:09:29,420 --> 00:09:30,500
!يا إلهي

126
00:09:30,500 --> 00:09:34,060
ألا تعرفين الآنسة زنبقة بيضاء
في صفّ الأوركيد؟

127
00:09:34,060 --> 00:09:36,220
هل هي بتلك الأهمّية حقّاً؟

128
00:09:40,680 --> 00:09:44,140
انظرا. تبدو الآنسة زنبقة بيضاء بلهاء
...دوماً. لكن الآن

129
00:09:44,140 --> 00:09:47,190
عيناها تُركّزان على نقطة واحدة اليوم

130
00:09:47,190 --> 00:09:49,610
بِمَن تُحدِّق يا تُرى؟

131
00:09:49,610 --> 00:09:51,350
تحديق

132
00:09:52,820 --> 00:09:55,150
إنّها تُحملق بي

133
00:09:55,150 --> 00:09:56,810
ما الخطب؟ لماذا أنا؟

134
00:09:56,810 --> 00:10:01,230
كأنّها تقول، "لا تشي بي إن كنتِ
"تعرفين مصلحتكِ جيّداً

135
00:10:03,460 --> 00:10:05,940
أعتقد سأخبرها فحسب بأنّ سرّكِ محفوظ

136
00:10:05,940 --> 00:10:11,420
من تلك الفتاة الّتي كانت الزّنبقة البيضاء
تُحدِّق بها بشغف؟

137
00:10:11,420 --> 00:10:13,510
آيا ميتسكي-سان من صفّ الأقحوان

138
00:10:13,510 --> 00:10:15,250
فتاة المنحة الدراسيّة؟

139
00:10:15,250 --> 00:10:17,980
يبدو وكأنّ نظرات الزّنبقة البيضاء
غير مُتبادَلة

140
00:10:17,980 --> 00:10:19,090
الزّنبقة البيضاء؟

141
00:10:19,090 --> 00:10:20,350
غير مُتبادَلة؟

142
00:10:24,760 --> 00:10:27,680
كيف يُفترض بي أن أتكلّم معها الآن؟

143
00:10:33,600 --> 00:10:35,710
ماذا كان ذلك؟

144
00:10:55,010 --> 00:10:57,390
هل لاحظتُن رمقات الزّنبقة البيضاء الحادّة؟

145
00:10:57,390 --> 00:10:58,800
كانت تُحدِّق طوال اليوم

146
00:10:58,800 --> 00:10:59,470
فاضح

147
00:10:59,470 --> 00:11:00,560
الغيرة تحرقني

148
00:11:00,560 --> 00:11:02,470
!الغيرة تحرقني

149
00:11:10,130 --> 00:11:11,560
ما المُشكلة؟

150
00:11:15,280 --> 00:11:18,960
اسمعي، لم أشي بكِ

151
00:11:18,960 --> 00:11:23,330
ولا أعرف إن كنتِ تُدركين، لكنّكِ
تُلفتين الكثير من الانتباه

152
00:11:23,330 --> 00:11:26,110
لا أتحمّل نظراتكِ لي طوال الوقت اليوم

153
00:11:26,110 --> 00:11:27,080
—فأساساً

154
00:11:30,030 --> 00:11:31,790
...أنا

155
00:11:46,340 --> 00:11:47,430
!خفقان

156
00:11:47,680 --> 00:11:48,560
ماذا؟

157
00:11:48,560 --> 00:11:50,040
مهلاً، مهلاً، مهلاً! ماذا؟

158
00:11:50,040 --> 00:11:51,370
خفقان!" حقّاً؟"

159
00:11:51,370 --> 00:11:53,170
خفقان!" هو كُلّ ما لديكِ؟"

160
00:11:53,170 --> 00:11:55,410
أنا أتكلّم معكِ. هل تسمعينني؟

161
00:11:58,780 --> 00:12:00,340
...لـ-لحظة

162
00:12:07,410 --> 00:12:08,980
آيا ميتسكي-سان

163
00:12:09,910 --> 00:12:13,590
هذه ثفَن عصا الأركيد، أليس كذلك؟

164
00:12:15,550 --> 00:12:20,910
وتمتمتِ قائلة في الأمس "س.ف 6"، صحيح؟

165
00:12:21,500 --> 00:12:23,350
قلتُ ذلك بصوتٍ مسموع؟

166
00:12:23,920 --> 00:12:28,110
ميتسكي-سان، لم تري الشّاشة
من مكان وقوفكِ

167
00:12:28,110 --> 00:12:31,300
من خلال الصّوت وحده، لم تعرفي فقط بأنّني
ألعاب ستريت فايتر، بل س.ف 6

168
00:12:31,300 --> 00:12:32,510
...إذاً لا بُدّ أنّكِ

169
00:12:32,510 --> 00:12:33,050
...المعذرة

170
00:12:34,060 --> 00:12:35,530
...مُهتمّة بـ

171
00:12:36,040 --> 00:12:39,440
...بـ-بـ... مُهتمّة

172
00:12:39,440 --> 00:12:42,680
...أ-أ-ألـ... ألـ

173
00:12:42,680 --> 00:12:44,810
!مُـ-مُهتمّة بألعاب القتال، صحيح؟

174
00:12:46,380 --> 00:12:49,530
أجل، رُبّما؟

175
00:12:50,770 --> 00:12:52,560
!أريد الخروج من هنا

176
00:12:52,560 --> 00:12:53,740
...إذاً... إذاً

177
00:12:53,740 --> 00:12:55,020
—العبي معي

178
00:12:55,020 --> 00:12:56,350
لن أفعل

179
00:12:56,770 --> 00:12:59,640
اعتزلتُ ألعاب القِتال

180
00:13:00,370 --> 00:13:02,300
اعتزلتِ؟

181
00:13:02,900 --> 00:13:05,920
لماذا؟ ما السّبب؟

182
00:13:05,920 --> 00:13:09,350
هل تستخدم الآنسات الصّغيرات
ف.ا.د.سي في آلترا 1 الخاصّة بريو؟

183
00:13:10,930 --> 00:13:12,530
ف.ا.د.سي في آلترا 1

184
00:13:12,530 --> 00:13:17,600
هجمة تركيز سابقة من الضّربة الأولى
لشوريوكين، إلغاء اندفاعة فوريّ

185
00:13:17,600 --> 00:13:21,310
والإمساك بخصمك بينما ه وفي الهواء
بـ الكومبو الهائلة ميتسو هادوكين

186
00:13:21,310 --> 00:13:25,300
هذه التقنيّة مُستمدّة من سلَف
س.ف 6، س.ف 4

187
00:13:26,940 --> 00:13:30,050
هل تستخدم الآنسات الصّغيرات
ركلة القرفصاء المُتوسّطة؟

188
00:13:30,050 --> 00:13:32,820
هل تستفيد الآنسات الصّغيرات
من الخيارات عند التملُّص؟

189
00:13:37,920 --> 00:13:40,750
لا. لا، لا يفعلنَ ذلك

190
00:13:40,750 --> 00:13:44,090
عالم الهمجيّة الأبعد عن مُتناول
...الآنسات الصّغيرات

191
00:13:44,090 --> 00:13:46,180
!هو ألعاب القتال

192
00:13:49,380 --> 00:13:52,490
اتّخذتُ قراري بأن أصبح آنسة مُوقَّرة

193
00:13:53,630 --> 00:13:56,290
لذا أنا آسفة، لكن لن ألعب ضدّكِ

194
00:13:56,930 --> 00:14:01,010
هل تتساءلين لماذا أريد أن أكون
أنسة مُوقَّرة باستماتة؟

195
00:14:05,160 --> 00:14:07,600
كان ذلك قبل سنوات

196
00:14:07,600 --> 00:14:11,700
بدا عالَمي برّاقاً وساطعاً

197
00:14:12,010 --> 00:14:14,190
كما ترين، عثرتُ على شيء أحببتُه

198
00:14:16,940 --> 00:14:18,550
!ميتسكي

199
00:14:18,550 --> 00:14:22,620
سنُقيم بطولة س.ف 4 في منزل
تاكيدا. شئتُ أم أبيتِ، ستأتين

200
00:14:22,620 --> 00:14:25,340
تقصد بأنّكم لم تتعلّموا درسَكم بعد؟

201
00:14:25,340 --> 00:14:26,840
أنا جاهزة متى أردتُم

202
00:14:26,840 --> 00:14:27,730
اصمتي

203
00:14:27,730 --> 00:14:30,550
سأدعكِ تبكين اليوم يا ميتسكي، مفهوم؟

204
00:14:30,800 --> 00:14:35,090
سلسلة ستريت فايتر 4، س.ف 5 كاختصار

205
00:14:35,090 --> 00:14:38,890
لعبة قتاليّة كانت تدفع اللّاعبين
آنذاك إلى الجنون

206
00:14:38,890 --> 00:14:41,650
في الوقت الّذي لا تحظى
،فيه باهتمام الفتيات

207
00:14:41,650 --> 00:14:45,100
لكن لعبتُها بإدمان مع الفتيان

208
00:14:45,440 --> 00:14:48,110
تسارعتْ نبضاتُ قلبي مع إثارة المُنافسة

209
00:14:49,210 --> 00:14:53,420
،لأنّني أردتُ الانغماس أكثر في هذا الإحساس
أغرقتُ نفسي في التّمرين

210
00:14:54,220 --> 00:14:57,020
لستُ مُتيقّنة متى بالضّبط، لكن
،في مرحلة ما

211
00:14:57,510 --> 00:15:01,000
المُنافسة الّتي ظننتُ بأنّني
اشتعلتُ شغفاً لأجلها

212
00:15:01,000 --> 00:15:05,970
انحدرتْ إلى تكرار مُملّ لجمع النّقاط
في النّزالات عبر الإنترنت

213
00:15:06,970 --> 00:15:11,530
هل سأجد يوماً شيئاً أستطيع
الانغماس فيه كما في السّابق؟

214
00:15:13,260 --> 00:15:14,520
لقد خفت

215
00:15:18,130 --> 00:15:22,300
اخترتُ كورومي لأغيّر بيئتي على الأقلّ

216
00:15:22,600 --> 00:15:26,260
ثمّة شيء أخبرني بأنّني مُحال
،أن أستمتع ما لم أنغمس بشكل كامل

217
00:15:26,570 --> 00:15:29,020
لذا قرّرتُ أن أصبح أفضل آنسة
مُوقَّرة قدر المُستطاع

218
00:15:30,020 --> 00:15:31,500
هذه هي قصّتي

219
00:15:35,400 --> 00:15:37,800
حسناً، أجد صعوبة في فهم ذلك

220
00:15:38,620 --> 00:15:40,080
لذا لنلعب

221
00:15:44,210 --> 00:15:45,250
لماذا؟

222
00:15:46,450 --> 00:15:47,950
لماذا"؟"

223
00:15:48,500 --> 00:15:50,420
أتسألين "لماذا"؟

224
00:15:51,090 --> 00:15:56,400
أريد أن ألعب ضدّكِ

225
00:15:56,730 --> 00:15:59,310
!هل أحتاج سبباً آخر؟

226
00:15:59,310 --> 00:16:01,920
،"بريق وسطوع"

227
00:16:01,920 --> 00:16:04,670
"اشتعال الشّغف"

228
00:16:04,670 --> 00:16:07,940
استمعتُ إلى حواركِ الأنانيّ عديم
،القيمة المُملّ

229
00:16:07,940 --> 00:16:09,660
!لذا أقلّ ما يمكنكِ فعله هو مُقاتلتي

230
00:16:09,660 --> 00:16:11,610
!قاتليني

231
00:16:21,070 --> 00:16:23,140
إنّهما تتلألآن

232
00:16:28,550 --> 00:16:33,270
لم يكن لديّ أيّ سبب منطقيّ
لانتهاك القواعد المدرسيّة

233
00:16:33,270 --> 00:16:35,720
،لم تستملْني العواطف

234
00:16:35,720 --> 00:16:39,530
...ولم تدفعني حوافز غامضة ما. أنا فقط

235
00:16:48,100 --> 00:16:51,010
هل سأفعلها بجدّية؟

236
00:16:51,660 --> 00:16:52,650
...هل أعود

237
00:16:57,620 --> 00:16:59,160
إلى مُفضّلتي القديمة؟

238
00:17:01,790 --> 00:17:02,750
إلى ألعاب القتال؟

239
00:18:02,900 --> 00:18:04,920
...هـ-هل

240
00:18:05,530 --> 00:18:06,900
هل هي ضعيفة؟

241
00:18:16,140 --> 00:18:17,700
...ميتسكي-سان، هذا الإعداد هو

242
00:18:17,700 --> 00:18:19,610
هو ف.ت 3، صحيح؟

243
00:18:19,610 --> 00:18:21,900
أ-أجل، على ما أعتقد

244
00:18:31,820 --> 00:18:34,340
حسناً، ما الّذي كنتُ أتوقّعه؟

245
00:18:34,340 --> 00:18:37,930
الفتيات اللّواتي يلعبنَ ألعاب
القتال نادِرات أصلاً

246
00:18:37,930 --> 00:18:42,010
ما احتمالات اللّقاء بلاعبة جيّدة
في مدرسة إناث نخبة؟

247
00:18:42,420 --> 00:18:45,860
هل أنا أتوهّم، أم أنّ تصدّيها
قد تحسّن بشكل كبير؟

248
00:18:51,650 --> 00:18:53,990
والآن تُطلق هادوكين بشكل مُتكرّر

249
00:18:56,040 --> 00:18:58,150
...حسناً. عندما يحين وقت التّالية، سوف

250
00:19:04,870 --> 00:19:06,290
هذا غير مُمكن

251
00:19:12,950 --> 00:19:16,570
في ذلك النِّزال، تصدّتْ بطريقة ما
،لكلّ شيء صوّبتُه نحوها

252
00:19:16,570 --> 00:19:20,900
ثمّ أطلقتْ كُرات ناريّة بشكل
هيستيريّ حالما اقتربت

253
00:19:20,900 --> 00:19:23,930
،حالما ركّزتُ على تجاوز كُرات النّار
قامتْ برميي

254
00:19:23,930 --> 00:19:27,300
أصبحتُ مُستميتة وهممتُ لقفزة
بالكاد استطاعت خِداعها

255
00:19:27,300 --> 00:19:30,710
لكنّها لم تُفوّت فُرصة ووجّهتْ
شوريو مُنشَّطة مُضادّة للجوّ

256
00:19:40,480 --> 00:19:41,810
،والآن، لسبب ما

257
00:19:41,810 --> 00:19:44,020
تبدو على وشك البُكاء

258
00:19:46,290 --> 00:19:48,330
...المعذرة يا ميتسكي-سان

259
00:19:48,330 --> 00:19:49,500
...المعذرة

260
00:19:51,470 --> 00:19:54,210
ارتأيتُ بأنّهما كانتا جميلتين

261
00:19:54,530 --> 00:19:57,410
"هذه المُباراة و"الزّنبقة البيضاء

262
00:19:57,900 --> 00:20:01,750
،لا يمكن أن تكون أكثر اختلافاً منّي

263
00:20:01,750 --> 00:20:05,450
،الفتاة المُستميتة لتصبح آنسة مُوقّرة
وحتّى أنّني تخلّيتُ عن ألعاب القتال

264
00:20:06,090 --> 00:20:08,100
كيف تتألّقين بهذا الشّكل؟

265
00:20:16,700 --> 00:20:18,980
...في الواقع، أعتقد

266
00:20:21,780 --> 00:20:22,990
—ما الّذي

267
00:20:23,560 --> 00:20:24,450
أحدهم قادم

268
00:20:26,890 --> 00:20:28,000
لنختبئ

269
00:20:28,000 --> 00:20:29,660
أ-أين نختبئ؟

270
00:20:30,040 --> 00:20:31,990
!أنتِ! ما مُشكلتكِ بالضّبط؟

271
00:20:31,990 --> 00:20:33,720
!لـ-لم تكن غلطتي

272
00:20:33,720 --> 00:20:36,670
هذه الكراسي محشورة بجانب بعضنا، لذا
—أيّ حركة ستؤدّي إلى خشخشة

273
00:20:36,670 --> 00:20:38,390
هل من أحد هناك؟

274
00:20:39,020 --> 00:20:41,660
سمعتُ بأنّ هناك فتيات قد طُرِدن

275
00:20:45,990 --> 00:20:47,840
هل كانت هذه الغرفة؟

276
00:20:52,130 --> 00:20:53,270
مرحباً؟

277
00:21:05,770 --> 00:21:07,950
—ما-ما الّذي

278
00:21:18,800 --> 00:21:20,230
هل حاسوبكِ بخير؟

279
00:21:20,230 --> 00:21:21,650
أجل. هذا ما أعتقده

280
00:21:21,650 --> 00:21:22,260
رائع

281
00:21:23,460 --> 00:21:25,790
إذاً، حريّ بنا أن نفترق هنا

282
00:21:29,260 --> 00:21:30,440
ميتسكي-سان

283
00:21:36,810 --> 00:21:38,030
أراكِ غداً

284
00:21:45,650 --> 00:21:50,180
لم يكن لديّ أيّ سبب منطقيّ
لانتهاك القواعد المدرسيّة

285
00:21:50,180 --> 00:21:52,660
،لم تستملْني العواطف

286
00:21:52,660 --> 00:21:55,780
...ولم تدفعني حوافز غامضة ما. أنا فقط

287
00:21:56,290 --> 00:21:59,710
،ارتأيتُ فقط بأنّني إذا قاتلتُها

288
00:21:59,710 --> 00:22:02,500
فقد أفهم ما يجعل عينيها تتلألآن هكذا

289
00:22:04,460 --> 00:22:06,160
هذا سخيف، أعلم

290
00:22:07,730 --> 00:22:09,540
لكن فكّرتُ فيه