1
00:00:03,460 --> 00:00:05,620
أحببتُ لعِب ألعاب الفيديو

2
00:00:05,940 --> 00:00:09,400
،في العالم في الجانب الآخر من الشّاشة
يمكنني أن أكون حُرّة

3
00:00:09,830 --> 00:00:12,360
أردتُ أن ألعب بشكل أفضل

4
00:00:12,660 --> 00:00:14,810
أردتُ أن أتوحّد مع شخصيّتي

5
00:00:16,960 --> 00:00:22,580
لكن بعد ذلك، مُجرّد التحكُّم
بشخصيّتي لم يكن كافياً

6
00:00:23,060 --> 00:00:25,560
كان هناك تلك الأشياء المُزعجة
"الّتي تُدعى "خصوم

7
00:00:56,120 --> 00:00:58,570
ثمّ أدركت

8
00:01:00,030 --> 00:01:01,880
"اللّاعب الآخر هو شخصٌ أيضاً"

9
00:01:04,840 --> 00:01:09,000
مثلي تماماً، يفكِّر ويحاول جاهداً
من أجل الفوز

10
00:01:12,710 --> 00:01:13,890
أريد الفوز

11
00:01:15,910 --> 00:01:17,810
!بلا أخطاء! نالَ منها ذلك

12
00:01:17,810 --> 00:01:20,180
!آليس تفرض مزيداً من الضّغط

13
00:01:20,180 --> 00:01:21,180
أريد الفوز

14
00:01:22,930 --> 00:01:25,400
!هجمة جثوم مثاليّة الإطار من الأسفل

15
00:01:25,400 --> 00:01:26,840
...هجمة

16
00:01:26,840 --> 00:01:28,300
علويّة عكسيّة...

17
00:01:30,060 --> 00:01:32,600
أطلقتْ هذه الفتاة عنانَ وحشها الدّاخليّ

18
00:01:32,600 --> 00:01:35,740
!إنّها تفعل أيّ شيء عكسيّاً

19
00:02:00,960 --> 00:02:01,800
لقد قفزتْ

20
00:02:01,800 --> 00:02:02,770
...تِلك القفزة

21
00:02:02,770 --> 00:02:06,700
إنّها مُهيّأة بشكل مثاليّ للالتفاف
!حول ركلة شقلبة مُضادّة للجوّ

22
00:02:10,640 --> 00:02:13,100
هل أنا أتوهّم، أم أنّها مشيتْ
للخلف لوهلة؟

23
00:02:13,100 --> 00:02:14,560
"شقلبة انسحابيّة"

24
00:02:15,780 --> 00:02:20,230
بعد الشّحن السّفليّ، تمشي للخلف
لبضعة إطارات قبل الحركة

25
00:02:20,230 --> 00:02:23,830
س.ف 6 تدعك تُحافظ
على شحنة لعشرة إطارات

26
00:02:23,830 --> 00:02:30,030
ما يعني بأنّه عليك المشي للخلف، ثمّ تُوجّه ضربات 8-ك
خلال نافذة العشرة إطارات تلك

27
00:02:30,030 --> 00:02:32,870
،أيّ تأخُّر، لن تُنفَّذ ركلة الشّقلبة

28
00:02:32,870 --> 00:02:35,500
لذا ينتهي المطاف بك بتلقّي هجمة قفزة

29
00:02:35,500 --> 00:02:36,470
...لكن

30
00:02:36,470 --> 00:02:40,800
،إن لم تدفع بالأمور لأقصى حدودها
لما كانت ركلة الشّقلبة قد مرّتْ

31
00:02:40,800 --> 00:02:42,670
هذا ما كان عليه الأمر؟

32
00:02:42,670 --> 00:02:44,230
!تحليل مُوفَّق

33
00:02:44,630 --> 00:02:46,940
الآنسة الشّقيّة الصّغيرة ماهرة

34
00:02:46,940 --> 00:02:49,150
أجل. وقويّة أيضاً

35
00:02:49,150 --> 00:02:52,110
أجل. مع أنّني لا أميّز الفرق

36
00:02:53,360 --> 00:02:55,310
إنّها قويّةٌ فعلاً

37
00:02:55,310 --> 00:02:58,020
أفضل بكثير ممّا كانت عندما لعبتْ معي

38
00:02:58,240 --> 00:03:00,980
هكذا يلعب شخصٌ كرّسَ حياته
لألعاب القتال

39
00:03:02,700 --> 00:03:05,020
إنّها مُنغمسة تماماً بها

40
00:03:07,790 --> 00:03:10,510
مهووسة للغاية لدرجة تجعلك تبكي

41
00:03:13,250 --> 00:03:15,700
حركة ممتازة. لديها أسلوب

42
00:03:16,200 --> 00:03:19,670
تلك الفتاة الصّغيرة تُحيط بها
:هالة كأنّها تصرخ

43
00:03:19,670 --> 00:03:23,430
،أنا أتّخذ النِّزالَ بجدّيةٍ أكبر"
"فكيف لي أن أخسر؟

44
00:03:23,680 --> 00:03:27,460
لكنّها الآن لا تُفكِّر في شيء سوى
الحركة على الشّاشة

45
00:03:27,460 --> 00:03:30,390
،أجل، إنّها لا تُفكِّر في أيّ شيء
نقطة انتهى

46
00:03:30,390 --> 00:03:32,690
جميل. أنا أميل إليها

47
00:03:34,030 --> 00:03:39,560
في نهاية المطاف، قواعد هذا النِّزال ليست
من يلعب بشكل أنظف" يربح"

48
00:03:37,290 --> 00:03:40,690
آليس تجعل الزّنبقة البيضاء تتصدّى للدويّ
!الصّوتيّ وتُجبرها إلى موقف 50\50

49
00:03:40,110 --> 00:03:42,320
"اجعل حياةَ خصمك تبلغ الصّفر"

50
00:03:42,320 --> 00:03:45,660
من يقتل أوّلاً، يربح. الأمر بهذه البساطة

51
00:03:46,370 --> 00:03:47,370
...مع ذلك

52
00:03:47,370 --> 00:03:51,030
يمكنني القول بأنّها لم تصل إلى تلك
الحالة الذّهنيّة من تلقاء نفسها

53
00:03:51,350 --> 00:03:54,850
هذا غير منطقيّ. مشيتُ للخلف نحو
ركلة شقلبة مُضادّة للجوّ

54
00:03:54,850 --> 00:03:56,510
لم أُجرّب ذلك من قبل حتّى

55
00:03:56,510 --> 00:03:59,040
،شعرتُ وكأنّني أستطيع فعلها فحسب
وفعلت

56
00:03:59,040 --> 00:04:01,260
كشيء ما كان يُوجّهني

57
00:04:01,530 --> 00:04:04,710
ثمّة أمر غريب. لا يكون هكذا عادةً

58
00:04:04,940 --> 00:04:08,500
،عقلي أهدأ من المعتاد

59
00:04:08,500 --> 00:04:10,460
ومن الصّعب التنفُّس قليلاً

60
00:04:10,460 --> 00:04:13,190
لكن عصايّ تبدو خفيفة بشكل غريب

61
00:04:14,400 --> 00:04:15,480
...و

62
00:04:16,980 --> 00:04:18,600
وقّتَتْها على الاندفاعة؟

63
00:04:18,600 --> 00:04:20,200
هل فعلَتْ ذلك نتيجة ردّة فعل؟

64
00:04:23,200 --> 00:04:24,060
...و

65
00:04:24,710 --> 00:04:27,070
!لا أستطيع رؤية شيء سواها

66
00:04:28,000 --> 00:04:30,240
هل هي على وشك الاقتراب؟

67
00:04:31,080 --> 00:04:35,170
لا! إنّها تتملّص من رمية الاقتراب الخاصّة
!بالزّنبقة البيضاء بهدوء بارد

68
00:04:36,740 --> 00:04:37,970
اندفاعة أماميّة؟

69
00:04:38,240 --> 00:04:41,050
!بُرجمة خلفيّة! لسبب ما، قرّرَتِ النّكز

70
00:04:47,470 --> 00:04:48,630
!استخدمتْ طعماً للشوريو

71
00:04:48,630 --> 00:04:50,090
كانت تلك الارتدادة جنونيّة

72
00:04:50,090 --> 00:04:51,440
تقرأ تحرّكاتها ككِتاب

73
00:05:22,500 --> 00:05:24,630
وصلت الأمور إلى الرّغبة في مُنافس

74
00:05:24,630 --> 00:05:26,820
فعلتُ، وكذلك هي فعلَتْ

75
00:05:27,220 --> 00:05:29,910
كنّا نبحث عن بعضنا الآخر

76
00:05:31,110 --> 00:05:35,980
حدّقنا لنفس الشّاشة وفكّرنا في بعضنا
الآخر لساعات كُلّ يوم

77
00:05:36,320 --> 00:05:41,940
"هزمتُها في الأمس. لِمَ لا أستطيع اليوم؟"
"و "كيف يمكنني هزيمتها غداً؟

78
00:05:42,470 --> 00:05:45,310
أنا مُنافستها الأولى

79
00:05:45,650 --> 00:05:46,930
أو كنتُ كذلك على أيّ حال

80
00:05:50,980 --> 00:05:54,280
حركة جثوم دائريّة! ها هو
!القَصاص السّريع

81
00:05:54,280 --> 00:05:55,500
لكمة مُتوسِّطة سريعة؟

82
00:05:55,500 --> 00:05:56,700
وثقيلة؟

83
00:05:56,700 --> 00:05:58,070
استجابتْ بسرعة فائقة

84
00:05:58,070 --> 00:05:59,030
هل ابتسمَ لها الحظّ؟

85
00:06:03,570 --> 00:06:05,190
هذا مُؤلم

86
00:06:05,190 --> 00:06:09,120
...لكن ثمّة شيء يُخبرني

87
00:06:09,920 --> 00:06:11,580
بأنّني أستطيع أن أتعمّق أكثر

88
00:06:26,620 --> 00:06:27,860
ما هذا؟ فعلَتْها؟

89
00:06:26,620 --> 00:06:30,830
تُثبت بأنّها تمتلك الشّجاعة! في هذا الوقت
!المتأخِّر من اللّعبة، وما زالت تستعرض قِواها

90
00:06:27,860 --> 00:06:28,720
هل هي جادّة؟

91
00:06:28,720 --> 00:06:30,830
فجّرَتْ عدّادها الآن؟

92
00:06:29,550 --> 00:06:30,830
هذه الفتاة قد شُويَتْ

93
00:06:31,600 --> 00:06:33,450
!يا لها من معركة

94
00:06:33,450 --> 00:06:38,010
مفتاح الفوز في أيّ نِزال هو
تحديد الوتيرة أوّلاً

95
00:06:38,530 --> 00:06:41,050
لا يتمنّى المرء أن يفعل الخصم
أسوأ ما لديه

96
00:06:41,620 --> 00:06:44,430
هاتان الطّفلتان لا تفعلان ذلك

97
00:06:44,430 --> 00:06:46,830
،إنّهما يستدرجان مهارات بعضهما الآخر

98
00:06:46,830 --> 00:06:50,010
للحرص على أن يستعرض الخصم
نِزالاً من الفئة أ قبل هزيمته

99
00:06:50,010 --> 00:06:51,590
هذا سيّئ

100
00:06:51,590 --> 00:06:53,960
هذا لن يوفّر لهما نسبة فوز دائمة

101
00:06:53,960 --> 00:06:55,890
أنت مُحقٌّ في ذلك

102
00:06:56,320 --> 00:06:58,680
لكن هذا مُمتع للغاية

103
00:06:59,140 --> 00:07:00,400
أصابَ في ذلك

104
00:07:01,730 --> 00:07:05,430
كان الجمهور يُركّز على الزّنبقة البيضاء
"ويتساءل، "ماذا ستفعل تالياً؟

105
00:07:05,770 --> 00:07:08,400
ولكن الآن كُلّ العيون تترقّب كلتا اللّاعبتين

106
00:07:08,400 --> 00:07:13,370
،واللّاعبتان هناك تقرآن، وتقرآن ما يُقرأ

107
00:07:13,370 --> 00:07:16,240
لا أحد يدري كم حركة تقرآنها سلفاً

108
00:07:16,520 --> 00:07:19,500
إنّهما تدخلان بُعداً لا يفهمه سواهما

109
00:07:19,500 --> 00:07:20,960
إنّهما تُقلعان

110
00:07:21,920 --> 00:07:24,180
إلى الجانب الآخر من الشّاشة

111
00:07:25,880 --> 00:07:28,500
لا، لا أستطيع التنفُّس

112
00:07:28,500 --> 00:07:30,350
أفقد التّركيز

113
00:07:30,350 --> 00:07:31,340
...لكن

114
00:07:32,630 --> 00:07:34,140
مُنشِّط ضدّ مُنشِّط

115
00:07:34,140 --> 00:07:35,790
لا رابح هناك

116
00:07:36,750 --> 00:07:40,320
أريد البقاء هنا في هذا النِّزال
!لفترة أطول قليلاً

117
00:07:42,570 --> 00:07:45,320
ضربة نظيفة واحدة قد تُجهز
،على أيّ منهما

118
00:07:45,320 --> 00:07:48,220
وهما مُصرّتان على الاقتراب لأقرب
!مسافة مُمكنة والتصدّي

119
00:07:50,520 --> 00:07:54,340
ها هي الذّروة. تحبسان أنفاسهما
"وتستمرّان في "الرّقص

120
00:07:56,020 --> 00:07:59,580
إنّهما تختنقان، تتوقان للتنفُّس بسهولة

121
00:08:00,130 --> 00:08:04,130
هل هي جادّة؟ من يُتقن تفادياً للدويّ
الصّوتيّ المُنشّط من هذا المدى؟

122
00:08:04,130 --> 00:08:07,830
ومَن يكسر سطح الماء برأسه
أوّلاً سيفعلها

123
00:08:07,830 --> 00:08:08,910
سوبات انسحابيّة؟

124
00:08:12,760 --> 00:08:15,470
توقّعتْ ركلةَ الجثوم المُتوسِّطة
وتوقّفتْ بفارق بسيط

125
00:08:24,430 --> 00:08:27,900
ما الّذي يجري لي الآن؟

126
00:08:28,760 --> 00:08:31,370
أنا أتجاوز حدودي بكثير

127
00:08:33,600 --> 00:08:39,400
ماذا لو استمررت؟ ماذا لو لم أستطع
العودة أبداً؟

128
00:08:46,260 --> 00:08:48,150
أعتقد بأنّني لا أُمانع

129
00:08:53,170 --> 00:08:55,220
ألا تعلمان بأنّ ضربة واحدة
كفيلة بإنهاء الأمر؟

130
00:08:54,880 --> 00:08:59,300
تلعبان بخشونة عالية. لدرجة أنّك تخال
!بأنّهما لا تعرفان الخوف

131
00:08:57,850 --> 00:09:01,810
لا يمكنك منع نفك من استخدام أسلوبك

132
00:09:02,310 --> 00:09:06,960
لا مجال للكذِب أو الخِداع في عالم
القرارات خلال جزء من الثّانية

133
00:09:06,960 --> 00:09:07,820
لا يمكنك إخفاء الأمر

134
00:09:08,970 --> 00:09:09,990
...لذا

135
00:09:10,890 --> 00:09:17,230
يمكن أن تعرفا بعضكما الآخر بشكل أفضل
من إعداد واحد بدلاً من حديث طويل

136
00:09:17,500 --> 00:09:19,610
بعض النِّزالات تُوصلك إلى هناك

137
00:09:20,410 --> 00:09:24,410
ما الّذي "تريانه" الآن في الجانب
الآخر من الشّاشة

138
00:09:24,410 --> 00:09:27,100
ما الّذي تُفكِّران فيه أثناء لعبهما؟

139
00:09:27,100 --> 00:09:31,110
لسحق الخصم، تتمكّنان من فهم
بعضهما بمُستوى أعمق

140
00:09:31,110 --> 00:09:35,170
عبر الشّاشة، نظراتهما تتلاقى وتتقاطع

141
00:09:35,960 --> 00:09:40,400
هذه "مُحادثة" أغنى ممّا تحصل عليه بكلمات

142
00:09:51,630 --> 00:09:52,480
آيا-تشين؟

143
00:10:01,060 --> 00:10:03,790
تُخاطر الزّنبقة البيضاء بكُلّ شيء
بهادوكين مُنشِّطة

144
00:10:03,790 --> 00:10:06,410
!كلتاهما مُشتعلتان الآن

145
00:10:06,860 --> 00:10:07,700
رمية؟

146
00:10:11,870 --> 00:10:13,080
لا، إيهام بالرّمي؟

147
00:10:20,890 --> 00:10:22,680
!لدينا رابحة

148
00:10:22,680 --> 00:10:28,140
!هذه المُباراة العنيفة من نصيب آليس

149
00:10:48,260 --> 00:10:49,920
كان ذلك مُمتعاً

150
00:10:52,310 --> 00:10:53,550
مُمتعاً حقّاً

151
00:10:56,910 --> 00:10:58,160
تبّاً

152
00:10:58,160 --> 00:10:59,630
تبّاً. تبّاً

153
00:11:00,360 --> 00:11:01,930
...أنا

154
00:11:02,760 --> 00:11:05,020
!لقد استمتعتُ أيضاً

155
00:11:06,240 --> 00:11:07,390
...لكن

156
00:11:39,170 --> 00:11:40,680
!الزّنبقة البيضاء

157
00:11:49,670 --> 00:11:50,680
طاب يومكِ

158
00:11:50,680 --> 00:11:51,640
ويومك

159
00:11:51,640 --> 00:11:53,860
تاماكي-سان، طاب يومكِ

160
00:11:53,860 --> 00:11:55,320
طاب يومكِ

161
00:11:57,260 --> 00:11:59,240
تاماتيا! ما الأخبار؟

162
00:11:59,240 --> 00:12:01,200
يو-سان. طاب يومكِ

163
00:12:01,200 --> 00:12:04,760
سماع تلك التّحيّة يُنبئني حقّاً
بأنّنا عدنا إلى الدِّيار، صحيح؟

164
00:12:04,760 --> 00:12:05,920
أوتظنّين ذلك؟

165
00:12:05,920 --> 00:12:09,870
تماماً. اعتدتُ كثيراً على طوكيو

166
00:12:13,080 --> 00:12:17,450
بعد ذلك، نِزالي التّالي أرسلني إلى
مجموعة الخاسرين، حيث خسرتُ ثانية

167
00:12:17,450 --> 00:12:19,970
آيا-سان ويو-سان خسرتا أيضاً

168
00:12:19,970 --> 00:12:22,810
وتِلك كانت نهاية إيفو اليابان خاصّتنا

169
00:12:23,610 --> 00:12:27,340
لم أرَ تلك الفتاة في بثوث اليوم الثّاني

170
00:12:29,890 --> 00:12:32,080
شاركتْ أُختي أيضاً

171
00:12:35,210 --> 00:12:37,220
يا إلهي! طاب يومكما

172
00:12:37,220 --> 00:12:38,750
طاب يومكِ

173
00:12:38,750 --> 00:12:42,450
لذا أجل، إنّها مُذهلة. أفضل أخت
صغرى على الإطلاق

174
00:12:42,450 --> 00:12:44,400
أختك؟

175
00:12:44,740 --> 00:12:46,960
ولم أرَ ماكارون الدّمويّ

176
00:12:53,940 --> 00:12:57,060
نزفتْ ميو-سان نزيفاً غير مُبرَّر
،من أنفها أثناء نِزالها

177
00:12:57,060 --> 00:13:01,560
لذا أجّلنا نِزالاتنا المحلّيّة في آخر اللّيل
لليومين التّاليّين، تحسُّباً فقط

178
00:13:02,120 --> 00:13:04,040
...أخبرَتْني آيا-سان

179
00:13:04,040 --> 00:13:09,670
أنّ البطولات هي فُرصة لأخذ شيء إلى المنزل
لا تمنحني إيّاه الحياة العاديّة

180
00:13:11,790 --> 00:13:15,180
أتساءل ما الّذي تمكّنتُ من أخذه
من هذا النِّزال

181
00:13:24,060 --> 00:13:26,210
آيا-سان، ألن تخرجي اللّيلة؟

182
00:13:26,210 --> 00:13:29,030
فـ-في الواقع... نحن نأخذ استراحة

183
00:13:29,030 --> 00:13:32,630
جيّد. هذا يُوفِّر لنا الكثير من الوقت للكلام

184
00:13:33,860 --> 00:13:35,200
وها أنا ذي

185
00:13:37,710 --> 00:13:40,160
كيف كانت إجازة طوكيو خاصّتكِ
مع الزّنبقة البيضاء

186
00:13:40,530 --> 00:13:44,120
ما كنتُ لأُسمّيها إجازة. ذهبنا
فقط إلى حدث لعبة قتاليّة

187
00:13:44,120 --> 00:13:46,140
ولم أكن أنا وميو فقط، تذكّري

188
00:13:46,140 --> 00:13:49,340
،لعبة قتاليّة"؟ لا أعرف الكثير عن ذلك"
لكن يبدو هذا مُمتعاً

189
00:13:49,340 --> 00:13:50,560
حقّاً؟

190
00:13:50,560 --> 00:13:55,170
أقصد بأنّها مُمتعة، لكن أشعر وكأنّها
مِحنة في مُعظم الوقت

191
00:13:55,170 --> 00:13:57,440
إذاً لعبة القتال هي مِحنة؟

192
00:13:57,440 --> 00:13:58,870
أجل، غالباً

193
00:13:58,870 --> 00:14:01,860
دائماً ما أتمنّى لو أستطيع إنهاء الأمور

194
00:14:01,860 --> 00:14:03,580
بما في ذلك التحسُّس الواقعيّ

195
00:14:03,580 --> 00:14:06,130
ماذا يعني "تحسُّس واقعيّ"؟

196
00:14:06,130 --> 00:14:08,880
هل تقصدين بأنّ هذا العالم
ليس الحياة الحقيقيّة؟

197
00:14:08,880 --> 00:14:11,780
لا أُحاول أن أكون فلسفيّة إلى هذا الحدّ

198
00:14:11,780 --> 00:14:13,950
جوهريّاً، أقصد الأشياء المُتعلِّقة
بالشّخصيّة الدّاخليّة

199
00:14:13,950 --> 00:14:16,640
أنا جيّدة مع النّاس. اسأليني أيّ شيء

200
00:14:16,640 --> 00:14:18,920
لا، لا أحتاج نصيحةً حقّاً

201
00:14:18,920 --> 00:14:21,120
بربّكِ. أنا موجودةٌ هنا

202
00:14:21,120 --> 00:14:24,350
حسناً إذاً. الأمر يتعلّق بصديقة لي

203
00:14:24,350 --> 00:14:27,050
أعتقد بأنّني سمعتُ تلك الافتتاحيّة من قبل

204
00:14:27,050 --> 00:14:32,520
.ارتأيتُ بأنّني مُميّزة في نظرها
وبأنّني الرّقم واحد بالنّسبة لها

205
00:14:32,920 --> 00:14:35,760
،لكن بالتّفكير في الأمر الآن
كنتُ مُخطئة بشأن ذلك

206
00:14:35,760 --> 00:14:37,550
هذا هو تفسير الأمر

207
00:14:37,550 --> 00:14:39,960
هل أخبرتِها بذلك؟

208
00:14:40,370 --> 00:14:45,820
كنتُ أتمرّن على كيفيّة إخبارها في ذهني
طويلاً، لكن لا أستطيع فعلها بشكل صحيح

209
00:14:46,190 --> 00:14:47,840
تتمرّنين"؟"

210
00:14:47,840 --> 00:14:53,230
.تستخدمين كلمات غير معتادة أحياناً
"مثل "المدى المُلاصق للخصم

211
00:14:53,230 --> 00:14:54,920
على ما أعتقد

212
00:14:54,920 --> 00:14:58,870
ومركز الكلام في الدِّماغ لا يبدو أنّ
لديه فلترة جيّدة

213
00:14:58,870 --> 00:15:00,580
تنتقين كلماتكِ بعناية

214
00:15:01,780 --> 00:15:06,550
لذلك أحياناً تُسبِّبين التِباساً أو تفشلين
في إيصال فكرتكِ

215
00:15:06,550 --> 00:15:08,050
أتعتقدين ذلك؟

216
00:15:08,050 --> 00:15:09,260
رُبّما تكونين على حقّ

217
00:15:09,260 --> 00:15:12,980
لذا في حالات كهذه، رُبّما يجدر
بكِ أن تتكلّمي بصراحة فحسب

218
00:15:27,780 --> 00:15:31,120
...كنتُ سأتكلّم معها، لكن، في الواقع

219
00:15:31,120 --> 00:15:35,420
أترينَ تلك الفتاة الّتي تُحدِّق
بالزّنبقة البيضاء بشغف؟

220
00:15:35,420 --> 00:15:37,840
آيا ميتسكي من صفّ الأقحوانة على ما أعتقد؟

221
00:15:37,840 --> 00:15:39,560
هل يُعقَل أن تكون واحدة منّا؟

222
00:15:39,560 --> 00:15:40,540
لا بُدّ أنّها كذلك

223
00:15:40,540 --> 00:15:41,500
يجب أن تكون كذلك ببساطة

224
00:15:41,500 --> 00:15:42,950
هل تنوي التصرُّف أمامنا؟

225
00:15:42,950 --> 00:15:43,570
يجب عليها ذلك

226
00:15:43,570 --> 00:15:44,890
يجب عليها ببساطة

227
00:15:45,210 --> 00:15:46,400
تحديق

228
00:15:48,210 --> 00:15:51,170
كيف يُفترض بي أن أتكلّم معها الآن؟

229
00:16:00,020 --> 00:16:01,600
تحديق

230
00:16:04,700 --> 00:16:05,530
تحديق

231
00:16:23,070 --> 00:16:26,500
ما المُشكلة؟ لِمَ أنا مُتوتّرة جدّاً؟

232
00:16:26,500 --> 00:16:28,550
أحاول التكلُّم معها فحسب

233
00:16:30,420 --> 00:16:32,750
أعتقد يمكن تأجيل ذلك حتّى اللّيلة

234
00:16:34,750 --> 00:16:36,230
مساء الخير

235
00:16:36,230 --> 00:16:37,420
الزّنبقة البيضاء

236
00:16:37,420 --> 00:16:39,420
هل تشعرين بتحسُّن؟

237
00:16:39,420 --> 00:16:42,270
بالطّبع أنا كذلك

238
00:16:42,270 --> 00:16:45,550
،كان مُجرّد نزيف أنف بسيط
وقد غبتُ عن الوعي لوقت قصير

239
00:16:45,550 --> 00:16:48,310
ويومان دون لعِب؟ هل تُحاولان قتلي؟

240
00:16:48,310 --> 00:16:50,050
تسرّني رؤيتكِ قد تحسّنتِ

241
00:16:50,050 --> 00:16:52,980
بربّكِ. لنلعب فحسب. ماذا ننتظر؟

242
00:17:01,570 --> 00:17:03,290
—آيا-تشين. يسرّني أن

243
00:17:03,290 --> 00:17:05,460
أ... أستميحك عذراً

244
00:17:06,800 --> 00:17:09,340
ما تغيير الصُّورة هذا؟ لماذا تتصرّفين بأنثويّة؟

245
00:17:09,340 --> 00:17:11,510
هل أكلتِ فطراً غريباً أو ما شابه

246
00:17:12,490 --> 00:17:16,060
.آ-آيا-سان، حان دوري للمُداورة
هل ترغبين في اللّعب؟

247
00:17:16,060 --> 00:17:17,780
سأراقب حاليّاً

248
00:17:20,470 --> 00:17:25,440
حسناً. أظنّني جاهزة. يمكنني الفوز في هذا
النِّزال بحشرها في الزّاوية

249
00:17:25,440 --> 00:17:27,510
لكن أنا قويّة في الزّاوية

250
00:17:27,510 --> 00:17:29,610
ها هي شحنة دينجين

251
00:17:29,610 --> 00:17:31,490
ركّزي قبل أن نتقاتل حتّى

252
00:17:31,490 --> 00:17:33,310
آمل أن تصمتي وتلعبي

253
00:17:38,280 --> 00:17:42,740
أشعر وكأنّه مضى وقتٌ طويل منذ
لعِبنا معاً هكذا

254
00:17:44,040 --> 00:17:45,220
آيا-سان؟

255
00:17:45,460 --> 00:17:48,140
ماذا؟ عـ-على ما أعتقد

256
00:17:58,470 --> 00:17:59,690
ممتاز

257
00:17:59,690 --> 00:18:04,400
.كنتُ على وشك الموت على أيّ حال
لا داعي لتجربة فنّ خارق 3 للقضاء عليّ

258
00:18:06,110 --> 00:18:08,090
تبّاً. الحرّ شديدٌ هنا

259
00:18:08,090 --> 00:18:10,070
أظنّني سأتنفّس بعض الهواء النّقيّ

260
00:18:10,070 --> 00:18:11,070
رمقة

261
00:18:21,860 --> 00:18:24,280
هل تعتقدين بأنّ آيا-سان بخير؟

262
00:18:24,280 --> 00:18:26,340
يبدو أنّ هناك ما يدور في ذهنها

263
00:18:26,340 --> 00:18:29,600
رُبّما القتال سيُساعدها. ليس وكأنّني أعرف

264
00:18:29,600 --> 00:18:31,290
أنا جادّة

265
00:18:31,290 --> 00:18:32,790
لا تقلقي

266
00:18:32,790 --> 00:18:37,000
نِزال مع الزّنبقة البيضاء سوف يُشعل
حماسها. هي أو أيّ أحد

267
00:18:37,890 --> 00:18:39,560
معكِ حقّ

268
00:18:39,560 --> 00:18:41,880
كان ذلك النِّزال رهيباً حقّاً

269
00:18:45,260 --> 00:18:47,870
أتمنّى خوض نِزال كهذا

270
00:18:47,870 --> 00:18:49,500
هذا ما جعلَني ذلك أشعر به

271
00:18:49,500 --> 00:18:50,270
أجل

272
00:18:53,630 --> 00:18:57,020
لعبتُ مُباراة عفويّة مع أختي في ذلك اليوم

273
00:18:58,480 --> 00:19:01,750
لم أستطع فعل أيّ شيء من الأشياء
الّتي تمرّنتُ عليها كثيراً

274
00:19:02,130 --> 00:19:04,870
سألتْني حول ما إن كنتُ أحاول الفوز حتّى

275
00:19:05,570 --> 00:19:09,080
بعد أن عملتُ جاهدة للفت انتباهها

276
00:19:09,080 --> 00:19:10,630
كان كُلّ ذلك عقيماً

277
00:19:13,090 --> 00:19:15,040
فكّرتُ في الاعتزال

278
00:19:15,930 --> 00:19:19,880
أظنّني كنتُ أبحث عن سبب
للاعتزال لفترة طويلة

279
00:19:19,880 --> 00:19:24,210
هل كان من المُفترض أن أخسر خسارة
،فادحة لدرجة تحطِّم معنويّاتي

280
00:19:24,210 --> 00:19:29,320
لكن الاستمرار في الخسارة في اليوم المُوالي
،والّذي يليه والّذي يليه وهكذا

281
00:19:29,320 --> 00:19:31,920
للتحسُّن "في شيء واحد في كُلّ مرّة"؟

282
00:19:32,600 --> 00:19:34,530
لكن لم أستطع الاعتزال

283
00:19:35,140 --> 00:19:38,060
ليس بعد أن رأيتُ ميو-سان في ذلك النِّزال

284
00:19:39,350 --> 00:19:42,020
أشعر بالغيرة قليلاً

285
00:19:42,020 --> 00:19:44,620
من الزّنبقة البيضاء ومنكِ ومن آيا-تشان

286
00:19:44,940 --> 00:19:50,540
.أريد أن أصبح شغوفة هكذا أيضاً
أريد أن أكون مهووسة بجدّية أيضاً

287
00:19:55,330 --> 00:19:58,970
أظنّني أريد بذل جهد حقيقيّ

288
00:20:05,310 --> 00:20:09,520
"أحاول قول "لنبذل ذلك الجهد معاً

289
00:20:10,730 --> 00:20:11,990
مُدمِّر الذّقن

290
00:20:15,770 --> 00:20:17,090
لنفعلها

291
00:20:17,090 --> 00:20:19,620
غداً، وبعد غد، وبعد بعد غد أيضاً

292
00:20:20,340 --> 00:20:21,640
سوية للأبد

293
00:20:21,640 --> 00:20:22,490
أجل

294
00:20:30,830 --> 00:20:33,280
غابتا لفترة طويلة، صحيح؟

295
00:20:33,280 --> 00:20:35,340
بـ-بالفعل

296
00:20:37,790 --> 00:20:39,470
...في الواقع

297
00:20:39,820 --> 00:20:42,500
أنا في قمّة أدائي الآن

298
00:20:42,500 --> 00:20:44,430
...ماذا؟ أوه

299
00:20:44,750 --> 00:20:48,720
أعتقد بأنّ خبرتي في ذلك المجال قد أثمرتْ

300
00:20:48,720 --> 00:20:50,590
الحماس لا يُغادرني أبداً

301
00:20:50,920 --> 00:20:54,890
ليس هذا ما أريد التكلُّم عنه

302
00:20:54,890 --> 00:20:58,280
...منذ نِزالي مع الآنسة الشّقيّة الصّغيرة

303
00:21:00,010 --> 00:21:02,840
لا تتكلّمي عن أيّ شخص آخر

304
00:21:02,840 --> 00:21:05,770
انظري إليّ. إليّ وحدي

305
00:21:05,770 --> 00:21:08,140
أنا مُنافستكِ، تبّاً

306
00:21:05,770 --> 00:21:08,740
أدركتُ معنى اللّعب ضدّ شخص حقّاً

307
00:21:09,090 --> 00:21:12,570
يريد خصمُكِ ذلك أيضاً، ويبذل
قصارى جهده أيضاً

308
00:21:12,570 --> 00:21:15,430
لذا يجب أن أُكرّس كُلَّ طاقتي للفوز أيضاً

309
00:21:14,410 --> 00:21:16,110
إنّها مُميّزة

310
00:21:16,110 --> 00:21:20,110
لهذا السّبب تمكّنتُ من تفجير
كُلَّ طاقتي لهزيمتكِ

311
00:21:20,110 --> 00:21:21,580
لا، الأمر ليس كذلك

312
00:21:22,040 --> 00:21:23,870
سأقتلكِ

313
00:21:23,870 --> 00:21:26,370
سأهزمكِ هزيمة نكراء لدرجة
أُحطّم فيها روحكِ

314
00:21:26,370 --> 00:21:29,180
هذا ما يجعلها برّاقة ومُسرِّعة لنبضات القلب

315
00:21:29,720 --> 00:21:31,280
اسمعي يا ميو

316
00:21:31,280 --> 00:21:32,260
نعم؟

317
00:21:32,260 --> 00:21:34,810
أخبريها. وبكُلّ صراحة

318
00:21:34,810 --> 00:21:36,720
افعليها بكلمات بسيطة

319
00:21:36,980 --> 00:21:38,180
...أنا

320
00:21:50,740 --> 00:21:52,660
قاتليني

321
00:21:55,120 --> 00:21:58,690
ستفهمها بهذه الطّريقة. ستنتقل
الأحاسيس بنجاح

322
00:21:58,690 --> 00:22:02,590
انسي مُناقشة الأمر. نحتاج
فقط لِلَعب إعداد واحد

323
00:22:03,330 --> 00:22:04,810
بالتّوفيق. استمتعي

324
00:22:04,810 --> 00:22:07,410
ماذا؟ اجلسي فحسب