1
00:00:03,940 --> 00:00:06,700
كيف حالكن يا طالبات الطّابق الرّابع؟

2
00:00:09,600 --> 00:00:11,980
سنبدأ الآن بتفقُّد الحضور

3
00:00:12,470 --> 00:00:14,220
تفضّلي

4
00:00:16,600 --> 00:00:18,780
لم أسمعكن جيّداً

5
00:00:18,780 --> 00:00:21,870
سنبدأ الآن بتفقُّد الحضور

6
00:00:21,870 --> 00:00:23,790
تفضّلي

7
00:00:23,790 --> 00:00:24,910
أجل، هذا مُناسب

8
00:00:24,910 --> 00:00:25,920
ريزي-سان

9
00:00:25,920 --> 00:00:26,500
حاضرة

10
00:00:28,550 --> 00:00:31,470
كم توتّرتُ أثناء تفقُّد الحضور لدرجة
نسيتُ أن أتنفّس

11
00:00:31,470 --> 00:00:34,790
لم يكن ذلك صارماً كما في الإعداديّة

12
00:00:35,090 --> 00:00:39,010
سمعتُ بأنّهم يجرون تفتيشاً مُفاجئاً
في حرم المدرسة الثّانويّة

13
00:00:39,310 --> 00:00:40,470
ماذا؟

14
00:00:45,470 --> 00:00:47,440
الزّنبقة البيضاء بثيابها غير الرّسميّ

15
00:00:46,180 --> 00:00:48,700
تبدو ظريفة بشعرها المربوط

16
00:00:47,970 --> 00:00:49,480
لماذا هي في الطّابق الرّابع؟

17
00:00:50,500 --> 00:00:52,190
!ميو

18
00:00:52,490 --> 00:00:54,250
تُناديها باسمها الأوّل؟

19
00:01:01,350 --> 00:01:04,170
أريد أن نلعب

20
00:01:04,430 --> 00:01:07,920
أظنّني قد أموت إذا لم أتمكّن
من لعِب نِزال قريباً

21
00:01:07,920 --> 00:01:09,820
تبدو كأعراض انسحاب

22
00:01:09,820 --> 00:01:15,180
قوانين ودوريّات.. ما خطب أولئك الشرّيرات
اللّواتي يُدعينَ مُراقبات حرم؟

23
00:01:15,180 --> 00:01:18,130
أليست مُراقِبات الحرم هُنّ الخيّرات هنا؟

24
00:01:18,910 --> 00:01:23,970
لا نتمكّن من اللّعب في الخارج في أيّام عطلة
الأسبوع، ولا مساحة كافية في الدّاخل

25
00:01:23,970 --> 00:01:26,680
—سنلزم أماكننا فحسب حتّى عطلة الأسبوع و

26
00:01:29,340 --> 00:01:31,020
إنّها تبكي فعلاً

27
00:01:31,020 --> 00:01:35,360
بجدّية؟ من الّتي تبكي فقط لأنّ
الأمور لا تسير على هواها؟

28
00:01:35,360 --> 00:01:37,450
،أعلم بأنّكِ فعلتِها قبل أيّام
...لكن مع ذلك

29
00:01:37,450 --> 00:01:41,250
أعتقد بأنّني أصبحتُ مُستميتة
في ذلك الوقت

30
00:01:41,250 --> 00:01:44,840
كانت فُرصتي الكُبرى لخوض أوّل
نِزال محلّي لي

31
00:01:47,450 --> 00:01:49,530
الأوّل لها"؟"

32
00:01:57,710 --> 00:02:00,820
على أيّ حال، ألا تعتقدين بأنّ هذا سخيف؟

33
00:02:00,820 --> 00:02:04,650
خِلاف التوقُّعات، التقيتُ بفتاة مجنونة
،مُهتمّة بألعاب القتال

34
00:02:04,650 --> 00:02:06,420
ومع ذلك لا أستطيع أن ألعب ضدّها؟

35
00:02:07,930 --> 00:02:09,910
هذا هدرٌ لحياتي

36
00:02:12,970 --> 00:02:15,040
...أتعلمين يا ميو

37
00:02:16,730 --> 00:02:18,560
...بصراحة

38
00:02:18,560 --> 00:02:19,990
وجدتُها

39
00:03:58,950 --> 00:04:04,630
هل من مكان في هذا الحرم حيث يمكننا
اللّعب دون أن نُرى؟

40
00:04:28,910 --> 00:04:31,870
كان أمام أنظاري طوال الوقت

41
00:04:32,710 --> 00:04:37,380
أقصد بأنّ غرفة فارغة بقفل مكسور
هنا في الطّابق الرّابع؟

42
00:04:40,910 --> 00:04:45,700
هذا الرُّواق خطير حقّاً. يُهدّدني بالطّرد

43
00:04:46,390 --> 00:04:51,290
كنتُ ذاهبة إلى دورة المياه" لن تفلح"
إلّا في هذه المنطقة

44
00:04:52,140 --> 00:04:54,860
إذا ابتعدنا أكثر، فسأقع في ورطة

45
00:05:01,640 --> 00:05:03,300
آسفة يا ميو

46
00:05:03,300 --> 00:05:04,780
—أنا فقط لا أستطيع

47
00:05:16,060 --> 00:05:20,630
البحث عن "شرارة" كالّتي
شعرتُ بها آنذاك

48
00:05:20,630 --> 00:05:23,500
قد أصبح هدفي الوحيد في الحياة

49
00:05:25,400 --> 00:05:29,090
وعندما التقيتُ بكِ، وجدتُها

50
00:05:34,310 --> 00:05:38,800
آنذاك، كنتُ أُفكّر بنفس الشّيء
الّذي كنتِ تُفكّرين فيه

51
00:05:39,320 --> 00:05:44,020
الالتزام بالقوانين في هذا الظّرف
سيهدر حياتي

52
00:05:49,270 --> 00:05:50,910
...أقصد

53
00:05:51,330 --> 00:05:53,050
...لا أطيق انتظار

54
00:05:53,860 --> 00:05:55,570
اللّعب معكِ أيضاً

55
00:05:56,040 --> 00:05:58,130
هيّا. لنتبارز

56
00:05:59,200 --> 00:06:00,980
هذا سيّئ

57
00:06:04,970 --> 00:06:07,550
لا ينبغي لطالبات السّنة الأولى
أن يمشينَ في اللّيل

58
00:06:13,050 --> 00:06:14,650
!مُراقِبة حرم

59
00:06:26,990 --> 00:06:28,200
...لذا

60
00:06:29,710 --> 00:06:32,160
هل تُحبّان ألعاب القتال؟

61
00:06:34,620 --> 00:06:39,200
أجل، نحن... نلعب قليلاً من س.ف 6

62
00:06:39,200 --> 00:06:41,250
مُذهل! حقّاً؟

63
00:06:41,250 --> 00:06:44,360
...ا-المعذرة، يو إينوي-سينباي

64
00:06:44,360 --> 00:06:45,250
نعم؟

65
00:06:45,250 --> 00:06:48,650
هل... تلعبين س.ف 6 أيضاً؟

66
00:06:48,650 --> 00:06:49,390
أجل

67
00:06:52,540 --> 00:06:54,180
!مُحال أن تكوني كذلك

68
00:06:54,180 --> 00:06:55,250
ماذا؟

69
00:06:55,250 --> 00:06:58,610
شابّة لائقة ترتاد كورومي لا تلعب
!العابَ القتال

70
00:06:58,610 --> 00:07:00,620
بئس الأمر. ما مُشكلة هذه الفتاة؟

71
00:07:00,620 --> 00:07:02,970
آيا-سان، لا ترتعدي. اهدئي. لا ترتعدي

72
00:07:02,970 --> 00:07:08,990
حسناً، قد تكونين على حقّ بالنّسبة لكثير
من الفتيات هنا، لكن لديّ أخوة

73
00:07:08,990 --> 00:07:12,660
،آنذاك عندما كانت س.ف 4 مشهورة
توسّلَ إليّ أخوتي الصّغر أن ألعب معهم يوميّاً

74
00:07:12,660 --> 00:07:15,350
فاهتممتُ بها أكثر ممّا اهتمّوا

75
00:07:15,350 --> 00:07:19,500
والآن تلعبين س.ف 6؟ في هذا الحرم؟

76
00:07:19,500 --> 00:07:21,170
هناك طُرُق للالتفاف حول ذلك

77
00:07:21,170 --> 00:07:24,760
أبسط طريقة هي أن أصبح مُراقِبة حرَم

78
00:07:25,680 --> 00:07:27,250
بالطّبع

79
00:07:27,250 --> 00:07:32,100
،تحظى مُراقبات الحرَم بغرف فرديّة
—وبما أنّهن يُطبِّقن القانون

80
00:07:32,100 --> 00:07:33,230
أنتن

81
00:07:34,690 --> 00:07:36,920
ماذا تفعلنَ هنا؟

82
00:07:36,920 --> 00:07:38,550
مُراقِبة حرَم أُخرى؟

83
00:07:38,550 --> 00:07:40,270
...قائدة الطّابق الرّابع

84
00:07:40,590 --> 00:07:42,970
تاماكي إتشينوسي-سينباي

85
00:07:43,850 --> 00:07:45,630
مرحباً يا تاماكي-سان

86
00:07:45,630 --> 00:07:46,930
إينوي-سان؟

87
00:07:46,930 --> 00:07:48,800
أنتِ معهما أيضاً؟

88
00:07:48,800 --> 00:07:50,390
ما الّذي تنوينَ فعله؟

89
00:07:50,390 --> 00:07:53,610
بالطّبع! تستطيع إينوي-سينباي
...تلطيف الأجواء لأجلنا

90
00:07:55,030 --> 00:07:59,780
،كشفتُ طالبتَي سنة أولى في غرفة فارغة

91
00:07:59,780 --> 00:08:03,250
،وارتأيتُ بأنّه من الأفضل أن أُبلغ عن ذلك
لذا كنتُ أستجوبهما فحسب

92
00:08:03,250 --> 00:08:07,710
أيّتها الحقيرة. عرفتِ بأنّكِ ستكونين
،في ورطة إذا حميتِنا

93
00:08:07,710 --> 00:08:09,540
!فرميتِنا للذّئاب

94
00:08:15,300 --> 00:08:16,880
هكذا إذاً

95
00:08:18,610 --> 00:08:24,290
إذاً تسلّلتُما إلى غرفة فارغة للعِب
ألعاب الفيديو بعد إطفاء الإنارة؟

96
00:08:24,290 --> 00:08:30,200
خرقتُما عدّة قوانين واستخففتُما من حرَم كورومي

97
00:08:30,940 --> 00:08:32,780
ينبغي أن تخجلا من نفسيكما

98
00:08:35,480 --> 00:08:38,380
إن كان لديكما ما تقولانه، فسأسمعكما

99
00:08:41,980 --> 00:08:44,410
لكن يبدو أنّ ذنبكما واضح

100
00:08:46,460 --> 00:08:49,160
سأبلغكما عن عقوبتكما في الوقت المُناسب

101
00:08:50,880 --> 00:08:53,220
فكِّرا فيما اقترفتْه يداكما بينما تنتظران

102
00:08:55,570 --> 00:08:58,430
...لا أستطيع الجزم، لكن ثمّة شيء

103
00:08:58,780 --> 00:09:00,890
ثمّة شيء غريب هنا

104
00:09:05,600 --> 00:09:09,680
سألتِنا ما إن كنّا نحاول لعِب ألعاب
الفيديو. أليس كذلك؟

105
00:09:11,400 --> 00:09:13,610
وبعد نظرة واحدة إلى هذا

106
00:09:14,910 --> 00:09:16,730
ما الّذي ترمين إليه؟

107
00:09:17,030 --> 00:09:19,660
لا يمكنكِ خداعي يا سينباي

108
00:09:19,660 --> 00:09:24,360
لا فتاة كورومي عاديّة ترى عصا أركيد
وصندوقاً ثقيلاً غريباً

109
00:09:24,360 --> 00:09:27,410
فتعرف فوراً بأنّه مِقبض تحكُّم ألعاب فيديو

110
00:09:27,410 --> 00:09:31,870
ما يعني بأنّكِ كنتِ تستخدمين امتيازاتكِ
كمُراقبة للّعب سرّاً

111
00:09:31,870 --> 00:09:35,080
!أنتِ لاعبة ألعاب قتال مثلنا فحسب

112
00:09:44,390 --> 00:09:46,270
...أهذا

113
00:09:46,270 --> 00:09:48,020
كُلّ ما لديكِ لقوله؟

114
00:09:49,650 --> 00:09:53,960
لكِ الحقّ في تلفيق أي قصّة تشائين

115
00:09:53,960 --> 00:10:00,070
لكن أتُشكّكين بي للإفلات من العقوبة
بينما يجدر بكِ أن تندمي؟

116
00:10:00,480 --> 00:10:02,320
حرمان

117
00:10:02,320 --> 00:10:06,130
على أقلّ تقدير، أقترح أن تستعدّا للأسوأ

118
00:10:07,620 --> 00:10:09,000
معها حقّ

119
00:10:09,740 --> 00:10:14,960
لا أملك أي دليل ملموس بأنّها
تلعب في الحرم

120
00:10:15,320 --> 00:10:17,300
أعتقد هذا يكفي للّيلة

121
00:10:20,890 --> 00:10:22,560
هل انتهى الأمر؟

122
00:10:25,300 --> 00:10:26,810
لنلعب

123
00:10:33,690 --> 00:10:36,610
هـ-هل كنتِ تستمعين؟

124
00:10:36,610 --> 00:10:37,870
أجل

125
00:10:37,870 --> 00:10:40,860
،زدتِ الضّغطَ ضغطاً للتعتيم على الأمر

126
00:10:40,860 --> 00:10:45,400
لكن قلتُ لنفسي، "صحيح. إنّها مُهتمّة
"بألعاب القتال أيضاً

127
00:10:45,400 --> 00:10:47,240
لنلعب إذاً

128
00:10:47,240 --> 00:10:49,280
هل هي آليّ يتوسّل خوض نِزالات؟

129
00:10:52,700 --> 00:10:56,200
هذا رائع. كلتاكما في حالة يُرثى لها

130
00:10:59,150 --> 00:11:00,920
آسفة يا تاماكي-سان

131
00:11:00,920 --> 00:11:03,930
أصبح الأمر مُمتعاً فحسب، لذا أنا
أقف في صفِّهما

132
00:11:03,930 --> 00:11:05,150
إينوي-سان؟

133
00:11:05,150 --> 00:11:09,370
على أيّ حال، أعرف سلفاً بأنّك
تلعبين ألعاب القتال

134
00:11:09,370 --> 00:11:12,110
غرفتي بجانب غرفتكِ، أتتذكّرين؟

135
00:11:12,110 --> 00:11:15,230
،إذا استرقتُ السّمعَ بعد إطفاء الإنارة

136
00:11:15,230 --> 00:11:18,060
فأستطيع سماعكِ تضغطين
الأزرار على عصا أركيد

137
00:11:21,840 --> 00:11:23,430
حسناً إذاً

138
00:11:24,040 --> 00:11:26,480
افعلي ما تشائين. ما رأيكِ بهذا؟

139
00:11:28,570 --> 00:11:33,150
.الفائز هو أوّل من يربح ثلاثة
إن ربحتُ، فلم تري شيئاً اللّيلة

140
00:11:33,150 --> 00:11:35,520
كيف لهذا أن يكون "ما أشاء"؟

141
00:11:35,520 --> 00:11:38,230
كفى كلاماً فارغاً

142
00:11:38,230 --> 00:11:39,840
سأُغادر

143
00:11:39,840 --> 00:11:41,080
أتهربين؟

144
00:11:50,760 --> 00:11:51,720
عفواً؟

145
00:11:54,330 --> 00:11:58,140
،في هذه الحالة، إن خسرتِ أنتِ
فكلتاكما ستُطردان

146
00:11:58,140 --> 00:12:00,110
هل تقبلين اللّعب بهذه الشّروط؟

147
00:12:00,110 --> 00:12:01,200
بالطّبع

148
00:12:13,320 --> 00:12:16,030
ا-الزّنبقة البيضاء تبتسم

149
00:12:16,030 --> 00:12:17,950
!يا للنّقاء. يا للبراءة

150
00:12:17,950 --> 00:12:19,700
!يا له من جمال واضح

151
00:12:36,560 --> 00:12:38,100
نِزال مُمتع

152
00:12:38,990 --> 00:12:39,860
إنّها سيّئة

153
00:12:39,860 --> 00:12:40,760
مهلاً

154
00:12:46,660 --> 00:12:48,330
أنتما

155
00:12:49,110 --> 00:12:50,720
...يجب عليكما

156
00:12:51,440 --> 00:12:53,500
!أن تُعلّماني س.ف 6

157
00:13:10,630 --> 00:13:13,610
!حلبتنا اللّيليّة جاهزة تماماً

158
00:13:13,610 --> 00:13:14,970
مُذهل

159
00:13:14,970 --> 00:13:16,430
إنّها أشبه بقاعدة سرّية

160
00:13:16,430 --> 00:13:20,510
تغطية الشّقوق حول الباب ستجعل
،الظّلام حالكاً بشكل مُريب

161
00:13:20,510 --> 00:13:22,390
لذا هذا هو رهاننا الأفضل

162
00:13:22,390 --> 00:13:24,170
سيكتم أيّ صوت أيضاً

163
00:13:24,170 --> 00:13:26,340
أعتقد بأنّكِ تتمتّعين بحكمة... وما شابه

164
00:13:26,340 --> 00:13:26,970
ماذا؟

165
00:13:26,970 --> 00:13:30,060
سينباي، إنّها لا تعلم حقّاً بأنّها
"حكمة العصر"

166
00:13:32,090 --> 00:13:33,630
رغم ذلك، الحرّ شديد هنا

167
00:13:33,630 --> 00:13:35,290
ناهيك عن أنّ المكان ضيّق

168
00:13:39,990 --> 00:13:41,420
لنُسرع ونلعب

169
00:13:41,420 --> 00:13:42,210
حسناً

170
00:13:43,210 --> 00:13:46,200
ألم تنسيا شيئاً؟

171
00:13:46,200 --> 00:13:48,090
صـ-صحيح

172
00:14:10,830 --> 00:14:14,530
فكّرتُ في نفس الشّيء عند رؤية
إعدادكِ مع ميو

173
00:14:14,530 --> 00:14:15,990
هل تحاولين الفوز حتّى؟

174
00:14:16,490 --> 00:14:20,180
لا أقصد بتلك الطّريقة. أو في الواقع، أقصد

175
00:14:20,180 --> 00:14:23,130
لكن لا أقول بأنّكِ سيّئة أو ما شابه

176
00:14:23,130 --> 00:14:25,080
دفاعكِ بالتّحديد ممتاز

177
00:14:25,080 --> 00:14:26,470
كُلّ ما في الأمر... كيف أعبِّر عن ذلك؟

178
00:14:26,470 --> 00:14:30,790
ألا تعتقدين بأنّها تلعب وكأنّ
معنويّاتها قد حُطمَتْ كثيراً

179
00:14:30,790 --> 00:14:33,670
بواسطة أشخاص يلعبون بإفراط
لكسب نقاط وتصنيف؟

180
00:14:34,470 --> 00:14:38,960
أجل. إنّها خائفة جدّاً من استيقاظ خارق
"لدرجة الالتزام بـ"أوكي

181
00:14:38,960 --> 00:14:41,920
،كما لو أنّها لا تريد أن تُعاقَب
لذا لا تؤدّي أي حركة

182
00:14:41,920 --> 00:14:43,740
أسلوب لعبها سلبيّ تماماً

183
00:14:43,740 --> 00:14:45,150
أجل، هذا ما أقصده

184
00:14:45,150 --> 00:14:48,470
على أيّ حال، من الواضح بأنّها
تنتظركِ حتّى ترتكبي خطأ

185
00:14:48,470 --> 00:14:51,440
لِمَ اللّعب بجوري وأنتِ
لن تُهاجمي حتّى؟

186
00:14:56,030 --> 00:15:01,680
لم تحاولي أبداً استخدام الفنّ الخارق 3، صحيح؟
رغم أنّ العدّاد كان مُتاحاً لكِ

187
00:15:01,680 --> 00:15:03,190
...في الواقع

188
00:15:03,190 --> 00:15:09,690
كلّما ارتفع تصنيفي، يُصَدّ المزيد والمزيد
من مُحاولات الكومبو خاصّتي وأتلقّى عِقاباً

189
00:15:10,910 --> 00:15:17,030
لذا أدّخر الفنّ الخارق 3 للوقت الّذي أتصدّى فيه
لامتصاص ضربات أو حركة قويّة أُخرى

190
00:15:19,090 --> 00:15:22,820
أقصد بأنّه يجب على جوري توخّي الحذر
في حالة حياد على أيّ حال، صحيح؟

191
00:15:22,820 --> 00:15:25,600
إنّها ضعيفة ضدّ التّنطيق، لذا لا يمكن
للمقذوفات أن تنفعها للأبد

192
00:15:25,600 --> 00:15:27,970
وآليّة مقذوفاتها غريبة، لذا لا يمكنها
الفوز في حرب كُرات ناريّة

193
00:15:27,970 --> 00:15:29,540
الكثير من التّفاصيل

194
00:15:27,970 --> 00:15:30,530
بالإضافة إلى أنّ هجماتها الخفيفة سيّئة
ومداها قصير بشكل جنونيّ

195
00:15:29,540 --> 00:15:30,530
سلبيّة للغاية

196
00:15:32,740 --> 00:15:36,950
في نهاية المطاف، مُشكلتها الكُبرى
هي عقليّتها، لا مهارتها

197
00:15:36,950 --> 00:15:38,810
حسناً، ما رأيكِ بهذا؟

198
00:15:39,660 --> 00:15:43,710
اضبطي دُمية وضع التّدريب
على الحِراسة عشوائيّاً

199
00:15:52,590 --> 00:15:55,430
وتحقّقي من إصابة الضّربة
ضمن الفنّ الخارق 3

200
00:15:56,720 --> 00:15:59,300
سايهاشو الخاصّة بجوري سلبيّة
قليلاً في الصدّ

201
00:15:59,300 --> 00:16:01,960
لكن ينبغي لهذا أن يجعلكِ بعيدة
جدّاً عن عِقاب سهل

202
00:16:01,960 --> 00:16:05,810
إن تمكّنتْ من تحقيق ضربة، فعليكِ
بأوساتسو وكومبو ضمن الفنّ الخارق 3

203
00:16:06,700 --> 00:16:08,270
هكذا إذاً

204
00:16:08,270 --> 00:16:12,050
والآن تمرّني على هذا لفترة طويلة، إلى أن تتمكّني
من فعلها على الأقلّ 90% من الوقت

205
00:16:12,050 --> 00:16:13,620
في تلك المحطّة المِخبريّة

206
00:16:13,620 --> 00:16:14,950
ماذا؟ الآن؟

207
00:16:14,950 --> 00:16:16,660
هل لديكِ اعتراض على ذلك؟

208
00:16:16,660 --> 00:16:17,860
لـ-لا

209
00:16:17,860 --> 00:16:19,910
،أعي بأنّكِ اللّاعبة الأفضل

210
00:16:19,910 --> 00:16:22,830
لكن ظننتُ بأنّني أستطيع دوماً
التمرُّن عندما أكون بمفردي

211
00:16:22,400 --> 00:16:23,390
حقّاً؟

212
00:16:22,830 --> 00:16:25,910
وعلى أيّ حال، هل هذه طريقة
للتكلُّم مع زميلتكِ السّينباي؟

213
00:16:25,910 --> 00:16:28,800
لا يحقّ للّاعبين السيّئين أن يتكلّموا

214
00:16:30,590 --> 00:16:34,880
اسمعي. يمكنكِ أن تخوضي نِزالات معنا
طوال اللّيل ولن نُبالي

215
00:16:34,880 --> 00:16:37,020
أحذّركِ فقط بأنّكِ لن تجني
إلّا صفراً من ذلك

216
00:16:37,020 --> 00:16:40,090
صفر؟ المفهوم الّذي يُزعَم بأنّه
اكتُشِف في الهند؟ "صِفر" تلك؟

217
00:16:40,090 --> 00:16:41,540
ما هذا؟ يبدو مُثيراً للاهتمام

218
00:16:41,540 --> 00:16:43,470
هل يمكنكِ أن تصمتي لبُرهة رجاء؟

219
00:16:44,020 --> 00:16:47,880
تحطيم معنويّاتكِ في التّصنيف جعلَكِ تنسين

220
00:16:49,210 --> 00:16:52,980
إذا هاجمتني بهذا، فسوف أردّ"
"بهذا وأحطّمها

221
00:16:52,980 --> 00:16:55,960
سأقتلهم جميعاً بهذه السّلسلة"
"الّتي تمرّنتُ عليها حتّى الممات

222
00:16:55,960 --> 00:16:58,190
اللّيلة، سوف أُجبر هذا الشّخص"
"على التّقاعد

223
00:16:58,190 --> 00:17:00,350
كلّ تلك المشاعر البرّاقة

224
00:17:01,550 --> 00:17:02,870
البرّاقة"؟"

225
00:17:02,870 --> 00:17:03,770
...لكن

226
00:17:03,770 --> 00:17:05,740
،إذا تمرّنتِ على التحقُّق من إصابة الضّربة

227
00:17:05,740 --> 00:17:08,340
فستبدئين بصورة فطريّة بتنفيذ
ركلات مُتوسِّطة في النِّزالات

228
00:17:08,340 --> 00:17:11,690
:سيخلق هذا مجالاً جديداً للتحسُّن
مهمّتكِ التّالية

229
00:17:12,420 --> 00:17:15,380
هذا ما يعنيه القتال. الآن تعرفين
!ذلك، اشرعي في الأمر

230
00:17:17,100 --> 00:17:19,900
لذا حاليّاً، ما رأيكِ أن نلعب نمط
الفائز هو أوّل من يربح ثلاثة؟

231
00:17:19,900 --> 00:17:21,810
الفائز يستمرّ"، هل هذا مُناسب؟"

232
00:17:21,810 --> 00:17:22,600
بالطّبع

233
00:17:27,230 --> 00:17:30,980
وهكذا بدأت بطولة مُنتصف اللّيل خاصّتنا

234
00:17:34,950 --> 00:17:37,160
!لم أفعل ذلك

235
00:17:38,450 --> 00:17:40,610
حسناً يا سينباي. دوري

236
00:17:40,610 --> 00:17:45,410
لعِبَتْ يو إينوي-سينباي حتّى س.ف 4
أو س.ف 5 في الأركيد

237
00:17:45,410 --> 00:17:48,080
ثمّ عادت للتأقلُم مع س.ف 6

238
00:17:51,750 --> 00:17:54,220
...وهذه الفتاة

239
00:18:05,010 --> 00:18:06,670
صمدتْ ثانية

240
00:18:06,670 --> 00:18:09,730
ظننتُ بأنّني قضمتُ جزءاً كبيراً من حياتها
،من بداية الجولة

241
00:18:09,730 --> 00:18:12,320
لكن لم أستطع إنهاء تلك
الجزئيّة الأخيرة المُتبقّية

242
00:18:16,330 --> 00:18:17,490
مشَتْ؟

243
00:18:17,490 --> 00:18:19,150
!مشتْ للأمام حينها؟

244
00:18:20,820 --> 00:18:23,400
تبّاً، إنّها تستمتع بهذا

245
00:18:24,070 --> 00:18:25,890
لنُعِد ذلك

246
00:18:24,990 --> 00:18:28,380
،المعذرة، أكره إفساد المتعة

247
00:18:28,380 --> 00:18:30,950
لكن لم يبقَ سوى ساعتين
على تفقُّد الحضور الصّباحيّ

248
00:18:30,950 --> 00:18:31,550
ماذا؟

249
00:18:32,060 --> 00:18:34,850
هذا غريب. بدأنا للتو فحسب

250
00:18:34,850 --> 00:18:36,850
بدتْ كـ 30 دقيقة فقط

251
00:18:36,850 --> 00:18:40,200
لدينا درس اليوم، لذا ما رأيكن
أن نكتفي بهذا القدر؟

252
00:18:40,200 --> 00:18:41,540
أتّفق

253
00:18:43,750 --> 00:18:47,740
إتشينوسي-سينباي، هل من المُناسب
أن نترك مقابضنا هنا؟

254
00:18:47,740 --> 00:18:49,340
يمكنكن فعل ما تشأن

255
00:18:49,340 --> 00:18:52,570
انتهى نِزالنا المحلِّي اللّيليّ الأوّل
دون مشاكل

256
00:18:54,440 --> 00:18:57,780
،نمتُ قرابة الـ 90 دقيقة لاحقاً
فشعرتُ بالانتعاش تماماً

257
00:18:57,780 --> 00:18:59,220
!سهر طوال اللّيل

258
00:18:59,750 --> 00:19:01,690
كيف حالكِ يا آيا-سان؟

259
00:19:01,690 --> 00:19:05,160
...هذا مُجرّد سؤال فارغ لتمضية الوقت

260
00:19:05,160 --> 00:19:08,270
لكن هل صحيح بأنّك كنتِ تُنادين
الزّنبقة البيضاء بـ"ميو" فقط مؤخّراً؟

261
00:19:05,160 --> 00:19:08,630
يجب عليّ أن أتوخّى الحذر بنكزاتي عندما
تقذف عليّ ذلك العدد من كُرات النّار

262
00:19:08,270 --> 00:19:10,720
—أخبرتْني العصفورة بأنّكما تـ-تـ-تتواعدان

263
00:19:08,630 --> 00:19:10,170
ما يعني بأنّها تمشي تجاهي فحسب

264
00:19:10,170 --> 00:19:11,930
لكن الأمر أعقد من ذلك

265
00:19:11,930 --> 00:19:13,890
،بما أنّ مُباراتي الأولى ضدّها

266
00:19:14,140 --> 00:19:17,380
لاحظتُ بأنّها تستطيع أن تعرف
بأنّني على وشك الانتقال للهجوم

267
00:19:17,380 --> 00:19:18,590
لديها حاسّة تجاه ذلك

268
00:19:19,830 --> 00:19:22,800
لكن إذا تراجعتُ إلى إطار الحصانة
من خلال كُراتها النّاريّة، فسأكون مكشوفة

269
00:19:22,800 --> 00:19:25,230
أكون في العادة في وضع هجوميّ
،في هذا النّزال

270
00:19:25,230 --> 00:19:27,890
لكن لم أنفكْ أتعرّض لضغط
في الزّاوية البارحة

271
00:19:27,890 --> 00:19:30,190
رغم ذلك، يجب عليّ تجاوز
—كُراتها النّاريّة بطريقة ما

272
00:19:36,480 --> 00:19:37,860
راقبي فحسب

273
00:19:41,640 --> 00:19:43,780
مضى أسبوع بهذا الشّكل

274
00:19:45,120 --> 00:19:49,780
لعِبنا حتّى الصّباح، وفكّرنا في اللّعِب
المُضادّ، ثمّ لعِبنا ثانية

275
00:19:49,780 --> 00:19:54,250
لقد استمتعت. غضبت. وشعرتُ برغبة
في قتل شخص. لكن كان ذلك مُمتعاً دوماً

276
00:19:54,250 --> 00:19:56,660
على أيّ حال، لم يكن الوقت
مُناسباً للنّوم الباكر

277
00:19:59,170 --> 00:20:00,830
اسمعا

278
00:20:00,830 --> 00:20:02,270
نعم يا سينباي؟

279
00:20:02,270 --> 00:20:04,670
الإعداد هو 2-1، لذا لم يحن دورك بعد

280
00:20:12,350 --> 00:20:15,970
كانت تاماكي-سان تختبر التحقُّق
من إصابة ضرباتها طوال هذا الوقت

281
00:20:15,970 --> 00:20:17,280
لم تنسِها، صحيح؟

282
00:20:20,430 --> 00:20:22,620
لـ-لم أنسَ بالطّبع

283
00:20:22,620 --> 00:20:27,400
طلبتْ منكِ أن تُعلّميها س.ف 6، لذا
لم أكن سأقول شيئاً

284
00:20:27,400 --> 00:20:31,120
لكن بعضنا ليسوا همجيّين مهووسين
بالقتال مثلكما

285
00:20:31,120 --> 00:20:35,320
.أردتُ قضاء ليلة لعِب مُمتعة مع تاماكي-سان
نحن لا نتكلّم كثيراً

286
00:20:31,780 --> 00:20:33,440
97

287
00:20:35,330 --> 00:20:38,520
لا أحبّ دفعها جانباً. أشعر بأنّه تنمُّر

288
00:20:38,520 --> 00:20:41,620
يجب أن تكون هذه المُباراة المحلّية
!مُمتعة لنا جميعاً

289
00:20:43,900 --> 00:20:45,420
99.

290
00:21:00,280 --> 00:21:01,670
فعلتُها

291
00:21:01,670 --> 00:21:04,800
تحقّقتُ من إصابة ضربة
...ثمّ ألغيتُ إلى فنّ خارق 3

292
00:21:06,350 --> 00:21:08,870
!مئة مرّة مُتتالية

293
00:21:08,870 --> 00:21:09,890
لحظة، مئة مرّة؟

294
00:21:09,890 --> 00:21:12,020
لم أقل لها أن تُبالغ إلى هذا
الحدّ، أليس كذلك؟

295
00:21:12,020 --> 00:21:12,620
بئساً

296
00:21:18,370 --> 00:21:21,830
ألعاب القتال هي عبارة عن جهد
شاقّ لا ينتهي

297
00:21:21,830 --> 00:21:24,080
أو هذا ما ظننتُه

298
00:21:24,500 --> 00:21:26,310
لكن هذا مُمتع

299
00:21:26,310 --> 00:21:29,030
أمارس اختباراً مُمتعاً الآن

300
00:21:30,810 --> 00:21:34,290
والآن كلّفيني بمهمّتي التّالية

301
00:21:34,770 --> 00:21:38,220
تحدّ صعب لدرجة يجعل عينَي
تخرجان من محجريهما

302
00:21:38,220 --> 00:21:40,700
تمرّ بصحوة غريبة الأطوار

303
00:21:41,830 --> 00:21:44,340
تريّثي يا سينباي

304
00:21:44,340 --> 00:21:47,380
أوّلاً، عملتِ بجدّ لتعلّم التحقُّق
من إصابة الضّربة

305
00:21:47,380 --> 00:21:49,900
ألا تريدين تجربتها في نِزال؟

306
00:21:49,900 --> 00:21:51,370
أجل، أريد

307
00:21:51,370 --> 00:21:52,970
في هذه الحالة، الفائز أوّل من يربح ثلاثة

308
00:21:52,970 --> 00:21:54,690
سينباي، ينبغي أن تلعبي معي أوّلاً

309
00:21:54,690 --> 00:21:57,250
لا، منطقيّاً، أنا من ينبغي أن ألعب أوّلاً

310
00:21:57,820 --> 00:22:01,050
!مُستحيل! سألعب ضدّ تاماكي-سان أوّلاً

311
00:22:01,050 --> 00:22:04,260
إذاً، لنلعب أوّل من يربح ثلاثة لنُقرّر
من سيلعب معها أوّل من يربح ثلاثة

312
00:22:04,260 --> 00:22:06,450
ونجري سحباً ونلعب لنُحدّد التّرتيب

313
00:22:06,450 --> 00:22:09,660
هل سأتمكّن من اللّعب اللّيلة؟