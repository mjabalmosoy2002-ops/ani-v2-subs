1
00:00:11,620 --> 00:00:13,120
هل تِلك الزّنبقة البيضاء؟

2
00:00:13,120 --> 00:00:14,620
الحسناء الغامضة

3
00:00:14,620 --> 00:00:15,570
فتاة

4
00:00:23,000 --> 00:00:24,700
إنّها محطّ الأنظار

5
00:00:24,940 --> 00:00:27,870
أليس من المُقلِق أن تتوتّر كثيراً
عند الإمساك بعصا اللّعب

6
00:00:27,870 --> 00:00:30,500
بينما يُراقبها كثيرٌ من النّاس في المسرح؟

7
00:00:30,500 --> 00:00:31,720
معكِ حقّ

8
00:00:50,450 --> 00:00:53,140
جيّد. أنا مسرورةٌ للغاية

9
00:00:53,140 --> 00:00:55,990
كنتُ بمزاجٍ لسحق شخص تماماً

10
00:00:56,810 --> 00:00:58,430
كائناً من يكون

11
00:01:01,250 --> 00:01:03,700
لكن أنا مسرورة لأنّها ستكون أنتِ

12
00:01:03,980 --> 00:01:06,170
الاعتزال ممتازٌ لكِ

13
00:01:06,170 --> 00:01:09,880
سأوفّر لكِ الخسارة الّتي تجعلكِ
ترغبين في قتل نفسكِ

14
00:01:12,500 --> 00:01:14,080
هل أنتِ متأكّدة من أنّكِ تريدين فعل هذا؟

15
00:01:14,080 --> 00:01:19,430
كلّما تكلّمتِ بتبجُّح أكبر، ازداد الإحراج
عندما تخسرين

16
00:01:26,340 --> 00:01:30,680
لحظة، مُباراتكِ مع تلك الطّفلة الشّقيّة؟
وستلعبان عبر البثّ؟

17
00:01:30,680 --> 00:01:32,230
هذا ما أخبروني به

18
00:01:32,230 --> 00:01:36,180
لذا هل تُمانعين مُراقبة أغراضي
لأجلي يا إينويو-سينباي؟

19
00:01:41,950 --> 00:01:44,410
ما رأيكِ؟

20
00:01:44,410 --> 00:01:46,150
بخصوص الآنسة الصّغيرة الشّقيّة

21
00:01:50,130 --> 00:01:51,470
هذا غريب

22
00:01:51,910 --> 00:01:56,630
اشتبكتُ معها عدّة مرّات، وهي
تُثير أعصابي دوماً

23
00:01:57,010 --> 00:01:57,910
...لكن

24
00:01:58,860 --> 00:02:00,270
أتطلّع قُدماً لهذا

25
00:03:46,490 --> 00:03:50,240
كان ذلك حِواراً غبيّاً جدّاً بثثناه
للتو للعالم كُلّه

26
00:03:50,240 --> 00:03:53,510
يبدو وكأنّهما لديهما تاريخ

27
00:03:53,510 --> 00:03:55,720
قد يكون هذا نِزالاً مشحوناً بالضّغينة

28
00:03:55,720 --> 00:04:01,830
رغم ذلك، نرى أحياناً مُحترفاً ضدّ شخص
يحاول تجربة حظّه عبر البثّ

29
00:04:01,830 --> 00:04:03,600
...لكن عندما يكون لدينا لاعبان مجهولان

30
00:04:03,600 --> 00:04:06,450
لا تنظري بهذه الطّريقة السّخيفة دون مُبالاة

31
00:04:06,450 --> 00:04:10,050
أنتِ تلعبين رياضةً إلكترونيّة للّهو
مع صديقاتكِ الفاشلات فحسب

32
00:04:10,050 --> 00:04:13,800
هذا كُلّ ما تعنيه ألعاب القتال
في نظركِ، أليس كذلك؟

33
00:04:14,260 --> 00:04:17,010
أنا قويّة لأنّني وحيدة

34
00:04:17,350 --> 00:04:20,140
هذا صحيح. أنا قويّة

35
00:04:20,500 --> 00:04:23,290
ولأنّني قويّة، أنا بخير

36
00:04:23,870 --> 00:04:26,040
وبما أنّني على حقّ، أستحقّ الفوز

37
00:04:28,040 --> 00:04:31,130
!يا للهول! اختارتا شخصيّتهما بسرعة

38
00:04:31,130 --> 00:04:32,000
حسناً، أنتما

39
00:04:32,000 --> 00:04:34,080
من الواضح أنّكما مُتعطّشتان للدّماء

40
00:04:34,080 --> 00:04:37,740
أمامنا الآن الزّنبقة البيضاء كـ ريو
ضدّ آليس كـ غيلي

41
00:04:37,740 --> 00:04:41,970
!فلنبدأ

42
00:04:40,200 --> 00:04:41,970
!فلتفعلاها

43
00:04:49,050 --> 00:04:52,870
كُرة ناريّة منذ البداية، ومُوقَّعة بدقّة
!لدرجة نشعر بأنّهما خطّطتا لها

44
00:04:52,870 --> 00:04:57,260
هل سيقتصر الأمر على من يحطّم النّمطيّة
ويقفز على الآخر أوّلاً؟

45
00:05:01,100 --> 00:05:04,320
كلتاهما لا تريدان القفز

46
00:05:04,320 --> 00:05:07,780
وكأنّ كُلّ واحدة منهما تطلب
من الأُخرى أن تُبادر

47
00:05:07,780 --> 00:05:09,460
لكن غيلي شخصيّة شحن

48
00:05:09,460 --> 00:05:12,240
يجب أن يشحن قذائفه قبل الإطلاق

49
00:05:12,240 --> 00:05:15,880
يُعوِّض عن ذلك بتعافٍ أقلّ ووقت
استراحة بين الطّلقات

50
00:05:15,880 --> 00:05:19,210
،إذا استمرّا في حرب الكُرات النّاريّة هذه
فالخاسر واضح

51
00:05:24,090 --> 00:05:27,310
!لا تتراجع أي منهما. إنّهما ترفضان التّراجُع

52
00:05:37,360 --> 00:05:39,190
!الدّويّ الصّوتيّ المُنشّط

53
00:05:40,360 --> 00:05:43,030
ألا تعرفين كيفيّة فعل شيء آخر؟

54
00:05:43,030 --> 00:05:47,150
ركلة دوّارة عكسيّة! تنقضّ آليس
!لشنّ الهجمة الأولى

55
00:05:47,150 --> 00:05:48,620
!آليس بادرتْ أوّلاً

56
00:05:48,620 --> 00:05:50,830
إنّها تنقل القِتالَ إلى مدى قريب

57
00:05:52,340 --> 00:05:56,430
تُحافظ آليس على الزّخم، لتحشر
الزّنبقة البيضاء في الزّاوية

58
00:06:05,960 --> 00:06:07,920
لقد دخلتْ للعمق

59
00:06:10,070 --> 00:06:12,420
!يا للهول! واحدة أُخرى

60
00:06:12,420 --> 00:06:13,360
بئساً

61
00:06:13,360 --> 00:06:16,260
أيّ مجنون يُنفّذ اثنتين على التّوالي
بينما هو مُلاصِق للخصم؟

62
00:06:18,630 --> 00:06:20,830
والآن بعد أن صارت في الزّاوية، إنّه
الجحيم على الأرض

63
00:06:20,830 --> 00:06:22,520
وها نحن نشهد كومبو

64
00:06:22,770 --> 00:06:25,200
إنّها أضرار هائلة

65
00:06:25,700 --> 00:06:28,210
ولم تخرج من تلك الزّاوية بعد

66
00:06:28,680 --> 00:06:30,110
اشتعال

67
00:06:31,740 --> 00:06:34,700
هذا يجعل عدّاد الدرايف الخاصّ بالزّنبقة
البيضاء شبه فارغ

68
00:06:34,700 --> 00:06:37,410
،إذا صُعِقَت الآن، فسوف تتلقّى كومبو مثاليّاً

69
00:06:37,410 --> 00:06:38,910
وسيعني ذلك موتاً فوريّاً

70
00:06:40,120 --> 00:06:41,820
!ها هو الأوكي الخاصّ بآليس

71
00:06:47,970 --> 00:06:50,470
!تـ-تقدّمت ورمتْها

72
00:06:51,240 --> 00:06:52,420
لِماذا تقدّمتْ؟

73
00:06:52,420 --> 00:06:53,880
ألا ترى الشّاشة؟

74
00:06:54,100 --> 00:06:55,720
يا لها من مجنونة

75
00:06:57,160 --> 00:07:01,180
الشّخص المُتعطِّش للدّماء لن يتوانى"
"عن الأوكيزيمي خاصّته

76
00:07:01,180 --> 00:07:04,640
كان قِراءة آليس حول الأمر، لذا تراجعتْ
لتجنُّب حركة حصينة

77
00:07:05,010 --> 00:07:07,600
وتحليلها الحريص ارتدّ عليها

78
00:07:08,270 --> 00:07:10,810
أتدفع للأمام في هذا الظّرف؟

79
00:07:10,810 --> 00:07:12,530
وماذا يعني؟

80
00:07:19,570 --> 00:07:21,040
رمية خلفيّة

81
00:07:24,010 --> 00:07:25,260
ورمية أُخرى

82
00:07:25,260 --> 00:07:27,960
هل انخرطت الزّنبقة البيضاء في الأجواء؟

83
00:07:32,500 --> 00:07:34,640
ما الّذي تستطيع الزّنبقة البيضاء
رؤيته ولا أراه أنا؟

84
00:07:34,640 --> 00:07:37,710
إنّها تُحقّق الكثير من الضّربات
لدرجة تجعل الأمر مُثيراً

85
00:07:39,560 --> 00:07:41,560
هل يمكنها الاستمرار في هذا حتّى تحقيق الفوز؟

86
00:07:41,820 --> 00:07:42,860
...إيّاكِ

87
00:07:42,860 --> 00:07:43,690
!أن تغترّي

88
00:07:44,110 --> 00:07:46,870
والآن تؤدّي آليس الرّميات المحفوفة بالمخاطر

89
00:07:46,870 --> 00:07:47,600
هذا سيّئ

90
00:07:46,870 --> 00:07:49,450
بوجود هاتين، أيّ شيء يمكن أن يحدث

91
00:07:48,130 --> 00:07:52,720
أدّى ذلك إلى إخراج آليس من الزّاوية
وجعلَ عدّادَ حياتها أفضل

92
00:07:57,040 --> 00:07:59,000
بقي 17 ثانية من الزّمن فقط

93
00:07:59,000 --> 00:08:02,200
على آليس أن تمنع ميو من إلحاق
الضّرر من أجل الفوز

94
00:08:02,480 --> 00:08:05,340
ماذا ستفعلين أيّتها الزّنبقة البيضاء؟

95
00:08:05,340 --> 00:08:06,880
تعالي واقتليني

96
00:08:06,880 --> 00:08:07,750
إن استطعتِ

97
00:08:10,170 --> 00:08:11,920
بقي عشر ثوانٍ

98
00:08:13,630 --> 00:08:16,140
آليس تتراجع. والزّنبقة البيضاء تُطاردها

99
00:08:18,350 --> 00:08:19,590
...والآن

100
00:08:19,590 --> 00:08:23,560
آليس تصمد وتتصدّى لإبقاء نفسها
!خارج الزّاوية

101
00:08:25,010 --> 00:08:26,290
!بقيت ستّ ثوانٍ

102
00:08:26,290 --> 00:08:27,280
!خمسة

103
00:08:36,610 --> 00:08:38,740
هل استسلمتْ؟

104
00:09:02,060 --> 00:09:03,640
!وقت مُستقطع

105
00:09:03,640 --> 00:09:07,310
نُفِّذَتْ تلك الهجمة السّابقة
!في وقت متأخِّر قليلاً

106
00:09:07,310 --> 00:09:10,340
الجولة الأولى من نصيب آليس

107
00:09:12,260 --> 00:09:14,530
!تبّاً! تبّاً

108
00:09:15,000 --> 00:09:17,140
!تبّاً، تبّاً، تبّاً، تبّاً

109
00:09:18,320 --> 00:09:20,460
غيلي الخاصّ بآليس لا يعرف التوقُّف

110
00:09:24,180 --> 00:09:27,290
وهي توصل الأمر كُلّه إلى ضربة قاضية

111
00:09:29,910 --> 00:09:33,420
المُباراة الأولى كانت من نصيب غيلي الخاصّ بآليس

112
00:09:33,420 --> 00:09:36,270
رغم ذلك، أتتذكّرون الجولة الأولى؟

113
00:09:36,270 --> 00:09:40,390
وثقَتِ الزّنبقةُ البيضاء بآليس لمنع
،فورة مع نكزة

114
00:09:40,390 --> 00:09:44,540
لذا استدرجت الخصمَ ليُنفّذ نكزة
مع فورة من مسافة خارج النِّطاق

115
00:09:44,540 --> 00:09:46,840
الانحناء لاستخدام كومبو ركلة نصل
ثمّ حركة خارقة

116
00:09:46,840 --> 00:09:49,070
كانت قِراءة عجيبة حقّاً

117
00:09:49,070 --> 00:09:52,700
كانت لتغدو مُختلفة لو أنّه كان
لديها ثانية أُخرى من الزّمن

118
00:10:04,690 --> 00:10:07,320
...تبّاً، ثانية إضافيّة

119
00:10:07,320 --> 00:10:09,940
وكانت هذه العجوز الشّمطاء لتقتلني

120
00:10:11,080 --> 00:10:14,920
كنتُ لأخسر أمام... أمام كتلة
السّخافة المُتنقِّلة هذه

121
00:10:14,920 --> 00:10:18,360
!تبّاً. تبّاً. تبّاً، تبّاً، تبّاً

122
00:10:21,560 --> 00:10:24,800
المزيد أريد أن أكون أكثر شروراً

123
00:10:45,670 --> 00:10:47,120
حرب كُرات ناريّة أُخرى؟

124
00:10:47,120 --> 00:10:48,120
إنّهما مُتزامنتان

125
00:10:48,120 --> 00:10:49,660
تعادُل آخر استمرّ لـ 30 ثانية؟

126
00:10:56,790 --> 00:10:57,960
ما-ماذا كان ذلك؟

127
00:10:57,960 --> 00:11:00,640
!شوريو قارئة للعقول فُجائيّة

128
00:11:00,640 --> 00:11:04,840
توقّفتْ آليس عن إطلاق قذائف لتنفيذ
رمية عقب هجمة محسوبة زمنيّاً بدقّة

129
00:11:04,840 --> 00:11:08,180
وردّت الزّنبقة البيضاء بشوريوكن
محسوبة زمنيّاً بدقّة

130
00:11:08,180 --> 00:11:09,490
كيف؟-
كيف؟-

131
00:11:11,860 --> 00:11:14,070
...البرجمة الخلفيّة لغيلي

132
00:11:14,310 --> 00:11:16,530
هي زرٌّ جيّد في المسافات البعيدة

133
00:11:17,730 --> 00:11:23,730
خلط ذلك مع القذائف يطال الأشخاصَ
الّذين يحاولون الاقتراب والتصدِّي

134
00:11:23,730 --> 00:11:26,590
كانت تلك الخدعة مُنتشرة منذ س.ف 2

135
00:11:26,940 --> 00:11:31,970
اقتربت الزّنبقة البيضاء وتصدّتْ لمُدوّية
صوتيّة لمرّة واحدة

136
00:11:32,260 --> 00:11:35,640
رأتْ آليس ذلك ونفّذتْ رمية ببرجمة خلفيّة

137
00:11:35,640 --> 00:11:38,630
ثمّ تلقّتْ شوريو

138
00:11:40,080 --> 00:11:44,070
لكن لم يكن عليها السّعي لشوريو
هناك، أليس كذلك؟

139
00:11:44,070 --> 00:11:45,220
إنّها مُخاطرة عقيمة

140
00:11:47,500 --> 00:11:52,470
هناك الكثير حول أسلوب لعب فتاة الزّنبقة
البيضاء لا أفهمه فحسب

141
00:11:52,930 --> 00:11:55,030
أنت "لا تفهمه فحسب"؟

142
00:11:55,030 --> 00:11:57,070
لا، لا أفهمه

143
00:11:57,990 --> 00:11:59,910
حقّاً؟

144
00:12:02,610 --> 00:12:04,490
!ها هي الاوكي الخاصّة بالزّنبقة البيضاء

145
00:12:08,150 --> 00:12:09,420
أوكيزيمي شوريو؟

146
00:12:09,420 --> 00:12:10,410
...ماذا

147
00:12:10,410 --> 00:12:12,870
هل تساءلتْ حتّى ما الّذي سيحدث
إذا ما تمّ صدّها؟

148
00:12:12,870 --> 00:12:14,300
والأوكي الخاصّة بها لم تنتهِ بعد

149
00:12:17,690 --> 00:12:20,510
ماذا كان ذلك؟ لا أملك فكرة عمّا رأيتُه للتو

150
00:12:20,510 --> 00:12:26,440
بدأت الزّنبقةُ البيضاء بأداء شوريوكين
!بشكل دقيق جدّاً ومُحايد

151
00:12:29,420 --> 00:12:30,730
كفى هُراء

152
00:12:30,730 --> 00:12:32,820
!فعلَتْها حقّاً

153
00:12:40,150 --> 00:12:42,980
يا لكِ من مُزعجة لعينة

154
00:12:46,830 --> 00:12:49,110
!أنتِ مُزعجة لعينة للغاية

155
00:12:52,370 --> 00:12:54,290
لا تغترّي

156
00:12:54,770 --> 00:12:57,030
...قلتُ لكِ بأنّني لن أخسر

157
00:12:57,030 --> 00:13:00,320
أمام شخصٍ هاوٍ يلعب مع أصدقائه

158
00:13:00,750 --> 00:13:01,970
أبداً

159
00:13:02,230 --> 00:13:03,760
!أبداً

160
00:13:04,670 --> 00:13:05,930
...أنا أبداً

161
00:13:06,380 --> 00:13:07,720
!لن أخسر أمامكِ

162
00:13:27,110 --> 00:13:29,000
كان بمقدورها استخدام قَصاص على ذلك

163
00:13:28,300 --> 00:13:30,050
شوريو عند الاقتراب؟

164
00:13:29,910 --> 00:13:31,200
إنّها تتباهى الآن

165
00:13:31,200 --> 00:13:32,660
وحشٌ حقيقيّ

166
00:13:33,860 --> 00:13:37,020
أطلقتْ عنانَ الوحش

167
00:13:39,300 --> 00:13:42,800
"الوحش الّذي يُدعى "غريزة المُقاتل

168
00:14:04,590 --> 00:14:06,700
!تجاوزتْها

169
00:14:07,150 --> 00:14:10,610
يا له من تغيُّر طرأ عن المُباراة الأولى
حيث نفد الوقت أمامهما

170
00:14:10,610 --> 00:14:16,790
هنا في المُباراة الثّانية، الوحش الدّاخليّ
!لدى هاتين الفتاتين استيقظ بجموح

171
00:14:26,010 --> 00:14:27,340
!صفعة منصّة

172
00:14:33,810 --> 00:14:34,640
...هل قامتْ

173
00:14:34,640 --> 00:14:36,900
بصفع قبضة التحكُّم خاصّتها بقوّة؟

174
00:14:39,110 --> 00:14:42,570
قد يتحوّل هذا إلى "الصّفعة الّتي
"سمعها العالمُ بأسره

175
00:14:44,290 --> 00:14:47,340
هذه هي نوعيّة الموسيقى الّتي أُحبّها

176
00:14:51,130 --> 00:14:52,290
لماذا؟

177
00:14:56,190 --> 00:14:57,380
...لماذا

178
00:14:59,830 --> 00:15:01,050
أنتِ؟...

179
00:15:16,510 --> 00:15:18,010
انسي الأمر

180
00:15:18,010 --> 00:15:23,700
افهمي بأنّه فتاةً تهدر وقتها مع صديقاتها
،لن تتمكّن من هزيمتكِ أبداً

181
00:15:23,700 --> 00:15:24,950
وأجّلي التّفكير في ذلك حاليّاً

182
00:15:28,360 --> 00:15:30,240
سأقبلكِ

183
00:15:31,380 --> 00:15:35,680
سأقبلكِ كي أتمكّن من هزيمتكِ

184
00:15:39,030 --> 00:15:43,120
عليّ فقط الصُّمود لفترة أطول قليلاً فقط

185
00:15:43,510 --> 00:15:46,840
!سأضربكِ بكُلّ ما أوتيت من قوّة

186
00:16:29,510 --> 00:16:30,660
...كيف

187
00:16:40,660 --> 00:16:43,400
كيف يمكنها اللّعب بهذه الطّريقة برأيك؟

188
00:16:44,570 --> 00:16:49,230
أنا واثقة لأنّها كانت مُستمتعة
بالمُباراة بمفردها

189
00:16:50,570 --> 00:16:55,620
إنّها لا تُشاهد اللّاعبين الجيّدين عبر الإنترنت
للمرجعيّة أو أيّ شيء من هذا القبيل

190
00:16:55,950 --> 00:16:59,940
إنّها تُفضِّل التّفكير في الأمر
وتجاوزه من تلقاء نفسها

191
00:17:00,520 --> 00:17:04,790
تُسخِّر ما تشعر بأنّه جيّد وما يُثير
اهتمامها أوّلاً عندما تلعب

192
00:17:04,790 --> 00:17:07,140
لكنّها ماهرة بشكل غريب رغم ذلك

193
00:17:07,140 --> 00:17:08,890
أو هذا ما ظننتُه

194
00:17:09,330 --> 00:17:13,600
لكن الحقيقة هي أنّها ليست
ماهرة بالرّغم من ذلك

195
00:17:14,050 --> 00:17:17,470
بل هي ماهرة بسبب ذلك

196
00:17:18,990 --> 00:17:22,140
يمكنك إيجاد كافّة الأجوبة عبر
الإنترنت في هذه الأيّام

197
00:17:22,140 --> 00:17:24,230
ولا تُستثنى من ذلك ألعاب القتال

198
00:17:24,450 --> 00:17:27,060
تختارين التملُّص الّذي يرى النّاس بأنّها جيّدة

199
00:17:27,060 --> 00:17:29,160
وتبنين أسلوبَ لعِب يصنع الفوز

200
00:17:31,180 --> 00:17:35,400
اللّعب بهذه الطّريقة أشبه بسلوك الطّريق
الأقصر. لكن لِمَ التوقُّف عند هذا الحدّ؟

201
00:17:35,400 --> 00:17:37,030
تقبُّل الأمر على علّته

202
00:17:37,350 --> 00:17:40,370
مُمارسة أشياء يعتقد النّاس بأنّها عقيمة

203
00:17:40,620 --> 00:17:43,450
كأن تسلك طريقاً التفافيّاً يخلو من الهموم

204
00:17:43,450 --> 00:17:46,160
كترك الطّرُق المُدمَّرة خلفك

205
00:17:46,160 --> 00:17:49,370
كالبحث عن كنز في كومة خردة

206
00:17:49,370 --> 00:17:52,830
عندما يخرج لاعبٌ من الجانب الآخر
:من ذلك، تقول

207
00:17:52,830 --> 00:17:55,230
"لستُ أفهم، لكن هذا مُمتع"

208
00:17:57,260 --> 00:18:00,210
هل تقصد بأنّها كانت تلعب ألعاب
القتال بهذه الطّريقة؟

209
00:18:00,590 --> 00:18:01,800
تلك الفتاة؟

210
00:18:03,010 --> 00:18:04,750
...هذا شيء

211
00:18:04,770 --> 00:18:06,470
لا أفهمه أيضاً

212
00:18:12,100 --> 00:18:18,570
أعتقد بأنّها حلمتْ بلعِب سماش في منزل
صديقة بعد دوام المدرسة

213
00:18:19,080 --> 00:18:21,290
...حسناً، في الواقع

214
00:18:23,230 --> 00:18:26,340
"لعلّه كان أقرب إلى "جوع" منه إلى "حلم

215
00:18:26,690 --> 00:18:28,420
...لهذا السّبب هي

216
00:18:31,460 --> 00:18:32,540
...هي

217
00:18:45,000 --> 00:18:49,140
قِوى شينكو هادوكين الخاصّة بالزّنبقة البيضاء
!تتجاوز الدّويّ الصّوتيّ الخاصّ بغيلي

218
00:18:49,140 --> 00:18:52,070
سيكون هذا النّزال الجولة الأخيرة
!من المُباراة الأخيرة

219
00:18:52,070 --> 00:18:54,110
لحظة الحقيقة قد اقتربت هنا

220
00:18:57,440 --> 00:18:58,870
لماذا؟

221
00:18:59,360 --> 00:19:01,070
لماذا أنتِ؟

222
00:19:02,340 --> 00:19:03,580
!هذا هو الأسلوب

223
00:19:03,580 --> 00:19:06,160
استدرجت الخصمَ لتنفيذ حركة خاطئة
!باندفاعة خلفيّة وقَصاص

224
00:19:07,320 --> 00:19:09,010
كان ينبغي أن تكون ميو-تشان

225
00:19:09,840 --> 00:19:11,580
أردتُ أن ألعب مع ميو-تشان بهذا الشّكل

226
00:19:11,840 --> 00:19:14,540
أن أضربها بكُل ما أوتيت من قوّة

227
00:19:14,800 --> 00:19:17,310
فلماذا إذاً؟ لماذا؟

228
00:19:17,790 --> 00:19:20,980
!لماذا لستِ ميو-تشان؟

229
00:19:20,980 --> 00:19:22,880
!إنّها تفعلها

230
00:19:22,880 --> 00:19:26,850
أردتُ الاستمتاع مع ميو-تشان هكذا

231
00:19:40,290 --> 00:19:42,080
تفادي، اندفاع، ثمّ رمي

232
00:19:47,290 --> 00:19:51,360
قد تستمرّ في تنفيذ شوريو حتّى أتصدّى لواحدة

233
00:19:51,360 --> 00:19:54,570
ربّما ستعتقد بأنّني سأخاف
،من الشّوريو وأتقوقع

234
00:19:54,570 --> 00:19:56,000
وبالتّالي تسعى لاستخدام رمية

235
00:19:56,000 --> 00:19:58,660
،التملُّص المُتأخِّر سيتفوّق على كليهما

236
00:19:58,660 --> 00:20:03,060
لكن لن أتفاجأ إذا أخّرَتِ الشّوريو
خاصّتها للردّ على ذلك

237
00:20:04,610 --> 00:20:05,980
هذه ليست شوريو

238
00:20:07,500 --> 00:20:10,470
!يا للهول! لا أُصدِّق ذلك

239
00:20:12,720 --> 00:20:18,210
،بدلاً من أوكيزيمي شوريو أو رمية
تقدّمتْ ونفّذتْ شوريو متأخِّرة؟

240
00:20:18,210 --> 00:20:20,850
لديها موهبة حقّاً في إزعاج خصمها

241
00:20:20,850 --> 00:20:23,950
ربّما تريد من الفتاة الأُخرى أن تنفجر
مرارتها وتموت؟

242
00:20:24,170 --> 00:20:26,660
...إنّها... إنّها

243
00:20:28,030 --> 00:20:30,830
حريّ بكِ أن تفهمي قريباً يا آليس

244
00:20:32,140 --> 00:20:35,130
إنّها حمقاء بكُل معنى الكلمة

245
00:20:35,130 --> 00:20:39,050
في الوقت المثاليّ. تاتسوماكي تلك اجتازت
!الدّويّ الصّوتيّ

246
00:20:39,050 --> 00:20:40,340
ردّة فعل؟

247
00:20:39,720 --> 00:20:40,590
مستحيل

248
00:20:40,340 --> 00:20:41,750
كانت قِراءة صعبة

249
00:20:41,970 --> 00:20:43,970
كانت تِلك ردّة فعل

250
00:20:43,970 --> 00:20:47,580
،وثقتْ بغريزتها، أو اليومي خاصّتها
بأنّ الدّويّ الصّوتيّ كان قادماً

251
00:20:47,580 --> 00:20:51,760
وغالباً ركّزتْ كُلّ انتباهها على الانتباه
من حركة الدّويّ الصّوتيّ فقط

252
00:20:51,760 --> 00:20:53,350
لتجتازها بإطار الحصانة نتيجة ردّة فعل

253
00:21:04,650 --> 00:21:05,760
!إنّها تتملّص

254
00:21:05,760 --> 00:21:07,900
انظر إلى وجه تلك الفتاة الصّغيرة

255
00:21:07,900 --> 00:21:08,610
أجل

256
00:21:11,040 --> 00:21:16,240
نادراً ما نرى آليس تلعب مُباراة
دون أن تبدو مُستشيطة غضباً

257
00:21:18,260 --> 00:21:19,260
!تجاوزتْ ذلك

258
00:21:19,260 --> 00:21:21,060
!انظروا إلى تلك الشّقلبة

259
00:21:21,500 --> 00:21:24,080
!إنّه دور آليس لاجتياز قذيفة بإطار الحصانة

260
00:21:31,520 --> 00:21:33,630
!مثاليّ نالَ ذلك منها

261
00:21:33,630 --> 00:21:38,320
توقّعَتْ بأنّ القفزة كانت قادمة وجهّزتْ
!ركلة جثوم ثقيلة مُضادّة للجوّ

262
00:21:53,790 --> 00:22:00,620
أستمرّ في سلوك نفق أسود دامس
لا ينتهي وحيدة تماماً

263
00:22:01,710 --> 00:22:06,320
إلى أيّ درجة عليّ أن أصل
لأدعها تُسامحني؟