1
00:00:19,630 --> 00:00:22,110
توقّفت الفتاة عن رمي كُرات النّار

2
00:00:22,110 --> 00:00:24,480
أو بالأحرى، كان عليها أن تتوقّف

3
00:00:24,870 --> 00:00:29,440
دخلَ كافيوري بقوّة لدرجة أنّها لم تستطع
الاستمرار في ترك مسافة

4
00:00:29,740 --> 00:00:33,040
استطاع تجاوز كُرة ناريّة طائشة مُباشرة

5
00:00:37,160 --> 00:00:39,420
وهي تعي ذلك

6
00:00:40,930 --> 00:00:44,340
،لكن حالما توقّفتْ عن قذفها

7
00:00:44,340 --> 00:00:46,770
بدأ دور خصمها

8
00:00:47,810 --> 00:00:52,740
في تلك اللّحظة، لم يكن أمام ميو
خطّة للإفلات من مأزقها

9
00:00:52,740 --> 00:00:57,700
،ظلّ عقلها شارداً، ويعمل على الفطرة
ودفعت بعصاها للأمام

10
00:01:01,060 --> 00:01:03,500
اقتربتْ ولم تفعل شيئاً؟

11
00:01:08,810 --> 00:01:13,690
،لمّحتْ إلى رمي كُرة ناريّة، واقتربتْ
ثمّ تصدّتْ بدلاً من الهجوم

12
00:01:13,690 --> 00:01:15,160
ما الّذي تحاول فعله؟

13
00:01:15,160 --> 00:01:17,010
رُبّما تستسلم للأمر الواقع

14
00:01:17,010 --> 00:01:19,310
رُبّما هي مُشوّشة

15
00:01:21,920 --> 00:01:26,650
لم تتوصّل إلى طريقة للفوز
،في هذا الظّرف بعد

16
00:01:26,650 --> 00:01:28,910
...لذا هي تضغط على نفسها

17
00:01:30,090 --> 00:01:31,520
وغارقة في التّفكير

18
00:03:29,030 --> 00:03:30,220
...لقد

19
00:03:30,220 --> 00:03:32,120
غيّرتْ إيقاعها

20
00:03:42,940 --> 00:03:48,830
بالاقتراب إنشاً واحداً، ميو استدرجتْ كافيوري
للنّكز بلكمة جثوم مُتوسِّطة

21
00:03:52,530 --> 00:03:53,510
قَصاص سريع

22
00:03:59,460 --> 00:04:00,710
ألغت الكومبو؟

23
00:04:03,920 --> 00:04:05,080
ها هو القَصاص

24
00:04:12,940 --> 00:04:14,920
لـ-لم يكن ذلك كفيلاً بإنهاء الأمر؟

25
00:04:18,940 --> 00:04:19,860
حركة ممتازة

26
00:04:19,860 --> 00:04:21,060
تبادلا الجهة

27
00:04:30,370 --> 00:04:32,750
جذبتِ اهتمامي يا صغيرة

28
00:04:32,750 --> 00:04:35,780
ما الّذي يمكنكِ فعله في هذا الوضع؟

29
00:04:35,780 --> 00:04:37,340
أريني ما لديكِ

30
00:04:40,570 --> 00:04:41,630
رمية؟

31
00:04:42,590 --> 00:04:43,960
!رمية أُخرى

32
00:04:56,800 --> 00:04:58,160
يحاول إلحاق ضرر بعدّاد الصحّة

33
00:04:58,160 --> 00:04:59,590
انظروا إلى عدّاد ريو

34
00:04:59,890 --> 00:05:01,890
،إذا لُمِسَتْ ثانية، فإنّ عدادها ينفد

35
00:05:02,300 --> 00:05:03,570
وينتهي النِّزال

36
00:05:09,040 --> 00:05:10,910
لمسة واحدة ينتهي الأمر

37
00:05:29,390 --> 00:05:31,280
...أتعتقدين بأنّني سأستمرّ

38
00:05:31,580 --> 00:05:33,300
!في الوقوع ضحيّة ذلك؟

39
00:05:38,970 --> 00:05:41,570
لم تؤدِّ كُرةً ناريّة؟

40
00:05:49,620 --> 00:05:52,440
هل كانت هذه خطّتها اللّعينة؟

41
00:05:52,440 --> 00:05:55,800
فقط كي لا تتلقّى ضرراً من الهيوكو-سين؟

42
00:06:29,930 --> 00:06:34,670
لم يكن لديّ سبب منطقيّ
لانتهاك القوانين المدرسيّة

43
00:06:34,770 --> 00:06:38,380
،ظننتُ فقط بأنّني إذا قاتلتُها

44
00:06:38,380 --> 00:06:41,750
فقد أرى أيّ شيء جعلَ عينيها
تلمعان بذلك الشّكل

45
00:06:43,450 --> 00:06:45,410
هذا سخيف

46
00:06:45,410 --> 00:06:47,150
لكن فكّرتُ فيه

47
00:06:52,760 --> 00:06:53,840
مهلاً

48
00:06:53,840 --> 00:06:55,850
مهلاً لحظة

49
00:06:55,850 --> 00:06:58,510
أظنّني سجّلتُ للتو فيديو رهيباً

50
00:07:04,980 --> 00:07:07,090
خسرتُ إذاً

51
00:07:07,880 --> 00:07:12,850
عند التصدّي لأيّ حركة مُميتة، كانت
تضغط عليّ بركلة جثوم مُتوسّطة

52
00:07:12,850 --> 00:07:15,240
وتضع طعماً لأسلوب لعِبي المُضادّ للكُرات النّاريّة

53
00:07:15,680 --> 00:07:18,790
بالاعتماد على حركة خارقة مُحال
أن تعلم بأنّني سأنفّذها

54
00:07:19,500 --> 00:07:23,500
لا بُدّ أنّكِ مجنونة لمُراهنتكِ بكُلّ
شيء على فُرصة كهذه

55
00:07:23,880 --> 00:07:30,220
ولا بُدّ أنّها تعتقد بأنّها مُدهشة لتنفيذها
تلك الضّربة الوحيدة ناجيةً من الموت

56
00:07:40,720 --> 00:07:42,310
...إنّها لا تدرك

57
00:07:42,310 --> 00:07:44,770
بأنّها ربحتْ...

58
00:07:46,600 --> 00:07:48,040
أهي جادّة؟

59
00:07:49,730 --> 00:07:50,770
ميو

60
00:07:54,080 --> 00:07:55,400
آيا-سان؟

61
00:07:55,810 --> 00:07:57,200
ربحتِ

62
00:08:11,630 --> 00:08:12,640
...المعذرة

63
00:08:14,580 --> 00:08:18,260
كانت... نِزالات رائعة

64
00:08:31,620 --> 00:08:34,820
...كم مضى من وقت

65
00:08:42,410 --> 00:08:46,080
منذ استفزّتني خسارةٌ إلى هذا الحدّ؟

66
00:09:04,770 --> 00:09:06,650
لا أستطيع شرح ذلك

67
00:09:06,650 --> 00:09:12,630
كان وكأنّ الزّمن قد تباطأ، واستطعتُ
رؤية حركاته تُؤدَّى بوضوح شديد

68
00:09:12,630 --> 00:09:14,110
هكذا إذاً

69
00:09:14,110 --> 00:09:17,180
،نفّذتُ قَصاصاً سريعاً لم أكن أسعى له حتّى

70
00:09:16,120 --> 00:09:20,570
أعلم بأنّ ميو تقول شيئاً، لكن
لا أستوعب أيّ كلمة

71
00:09:17,180 --> 00:09:20,570
،لكن بعدها كان الوقت يتحرّك ببطء
فألغيتُ كومبو سهلاً

72
00:09:20,900 --> 00:09:24,700
سعيتُ لرمية وشعرتُ وكأنّه كان
سيردّ الرّمية لي

73
00:09:21,090 --> 00:09:23,290
...يبدو... وكأنّني

74
00:09:23,680 --> 00:09:25,770
!مُتوتّرة للغاية

75
00:09:24,700 --> 00:09:25,990
عرفتُ بأنّها كانت لحظتي

76
00:09:25,990 --> 00:09:27,720
أقصد بأنّ ذلك خطر على ذهني فحسب

77
00:09:27,710 --> 00:09:29,590
ما-ماذا أفعل؟

78
00:09:27,720 --> 00:09:32,170
وحالما حدث ذلك، ماذا عسايّ أفعل سوى
ترك شرارات دينجين تلك تتطاير؟

79
00:09:29,590 --> 00:09:32,160
ما مستوى التّقارب الّذي حدث
بيننا قبل الآن؟

80
00:09:32,170 --> 00:09:34,880
بما أنّ ذلك يبدو مُذهلاً جدّاً وللغاية

81
00:09:33,700 --> 00:09:34,880
ما هو الطّبيعيّ بالنّسبة لنا؟

82
00:09:34,880 --> 00:09:37,520
،تطلّبَ ذلك حِسابات و"يومي" بأعلى مُستوى

83
00:09:37,520 --> 00:09:40,020
وأخيراً وليس آخراً، غريزتي الحادّة جدّاً

84
00:09:39,010 --> 00:09:42,290
لا وقت للتّحديق في شفتيها

85
00:09:42,290 --> 00:09:45,300
حسناً. سأتصرّف بصورة طبيعيّة فحسب

86
00:09:46,860 --> 00:09:48,260
...التصرُّف بصورة طبيعيّة

87
00:09:48,260 --> 00:09:49,230
ما رأيكِ؟

88
00:09:49,230 --> 00:09:51,700
إ-إيب! بخصوص ماذا؟

89
00:09:51,700 --> 00:09:53,390
قلتُ "إيب" للتو

90
00:09:53,390 --> 00:09:54,950
بربّكِ

91
00:09:54,950 --> 00:09:57,870
قلتِ بأنّني كنتُ أهدر وقتي باستخدام
دينجين بشكل كبير للأبد

92
00:09:57,870 --> 00:10:01,710
نعتِّني بالقردة الّتي لا عقل لها
وقلتِ كلاماً سيّئاً آخر بحقّي

93
00:10:01,710 --> 00:10:03,230
لم أنعتكِ بالقردة

94
00:10:04,450 --> 00:10:09,790
بتكرار نفس الأمر، استدرجتُ الخصم
نحو تنفيذ حركة خارقة

95
00:10:09,790 --> 00:10:12,670
وحقّقتُ عودة قويّة لهزيمة مُحترف فطريّاً

96
00:10:12,920 --> 00:10:14,010
بالغريزة المُطلَقة

97
00:10:14,010 --> 00:10:16,140
تبّاً! إنّها ظريفة حتّى عندما تكون
!مُعتدّة بنفسها

98
00:10:16,140 --> 00:10:18,080
لذا ما رأيكِ يا آيا-سان؟

99
00:10:21,050 --> 00:10:24,100
كنتِ رائعة

100
00:10:32,340 --> 00:10:34,480
...أقصد، المعذرة

101
00:10:39,080 --> 00:10:40,390
...ما أقوله

102
00:10:40,650 --> 00:10:43,160
!هو أنّكِ كنتِ رائعة للغاية

103
00:10:55,440 --> 00:10:57,170
هذا واضح الآن

104
00:10:57,520 --> 00:10:59,620
أنتِ الآيدول خاصّتي الآن

105
00:11:00,000 --> 00:11:02,620
انسي كره الخسارة والرّغبة في هزيمتكِ

106
00:11:02,620 --> 00:11:05,020
أريد أن أُشجِّع شغفكِ

107
00:11:05,940 --> 00:11:09,680
أريد أن أكون الرّقم واحد لديكِ

108
00:11:27,780 --> 00:11:30,540
ماذا؟ غرقَ كافيوري في المجموعات؟

109
00:11:30,540 --> 00:11:33,840
بجدّية؟ من هزمه بعد أن طرده
غيكيدو إلى مجموعة الخاسرين؟

110
00:11:33,840 --> 00:11:34,540
لا أدري

111
00:11:34,780 --> 00:11:36,250
انظروا إلى هذا

112
00:11:41,960 --> 00:11:44,380
ضدّ مَن يلعب كافيوري هنا؟

113
00:11:50,410 --> 00:11:51,980
هل فعلتْ ذلك عمداً؟

114
00:11:52,210 --> 00:11:56,220
أدركتْ بأنّ اللّحظة الّتي أراد كافي
القضاء عليها كانت فُرصتها المُثلى؟

115
00:11:56,460 --> 00:11:58,930
من تكون بالضّبط؟

116
00:12:06,380 --> 00:12:08,010
نـ-نعم؟

117
00:12:08,010 --> 00:12:08,900
تفضّل

118
00:12:19,370 --> 00:12:20,640
عفواً؟

119
00:12:23,220 --> 00:12:25,030
كيف تسير الأمور؟

120
00:12:25,030 --> 00:12:27,920
...حسناً، إنّها مُجرّد مجموعات

121
00:12:27,920 --> 00:12:31,640
،لذا أرغب في القول بأنّه كان إبحاراً سلِساً

122
00:12:31,640 --> 00:12:35,390
لكن كدتُ أخسر للتو. وأمام فتاة صغيرة

123
00:12:35,390 --> 00:12:38,100
ماذا؟ فتاة؟

124
00:12:38,100 --> 00:12:42,240
أجل. لعلّها حتّى لا تزال في المدرسة الابتدائيّة

125
00:12:42,240 --> 00:12:44,730
لحظة، مدرسة ابتدائيّة؟

126
00:12:45,020 --> 00:12:46,360
!تبّاً

127
00:12:48,630 --> 00:12:51,830
متُّ أمام أمر ثلاث رميات مُتتاليات

128
00:12:51,830 --> 00:12:54,780
من صمّم تلك الشّخصيّة اللّعينة؟

129
00:12:55,090 --> 00:12:59,710
حالما ينفّذ رميةً أمر واحد، فإنّها تتحوّل
إلى 50\50 بعد 50\50 بعد 50\50

130
00:13:00,010 --> 00:13:02,900
المسألة كُلّها تتعلّق فيما إذا
نفّذ رمية أمر فقط

131
00:13:02,900 --> 00:13:06,370
لا توجد أي مهارة مشمولة

132
00:13:07,260 --> 00:13:08,400
!لا

133
00:13:08,720 --> 00:13:12,760
هذه هي حيلته. هكذا يلعب المُصارعون

134
00:13:12,760 --> 00:13:15,390
لو كان ذلك كُلّ شيء، لتفهّمتُ الأمر

135
00:13:15,390 --> 00:13:19,360
،مُقابل المُعاناة بترك مسافة والتحسُّس

136
00:13:19,360 --> 00:13:21,630
يُهيمن على النِّزال إذا تمكّن من الاقتراب

137
00:13:21,630 --> 00:13:23,290
لا بأس في ذلك

138
00:13:23,290 --> 00:13:26,780
لا أقول "لا بأس"، لكن تحتوي س.ف 6
،على تصدِّيات

139
00:13:26,780 --> 00:13:30,140
لذا بالعدّاد، يستطيع استخدام الإطار المنيع لاختراق الكُرات
النّاريّة واستخدام فنّ خارق 2 لتحقيق عودة ضخمة

140
00:13:30,140 --> 00:13:32,110
،حظيَ بخيارات ممتازة عن كثب

141
00:13:32,110 --> 00:13:36,120
بلكمة خفيفة بالإضافة إلى أسرع
ركلة جثوم خفيفة

142
00:13:36,120 --> 00:13:39,320
من كان يتوقّع أنّ توجيه ضربات خفيفة
!نحو خصم ضخم هو فكرة جيّدة؟

143
00:13:39,320 --> 00:13:42,260
!!قاتل بلكمة ثقيلة كرجُل ضخم عنيف

144
00:13:50,210 --> 00:13:54,820
.خسرتُ بصورة عشوائيّة فحسب
لن أقف أمام ذلك مكتوفة اليدين

145
00:13:55,480 --> 00:13:59,110
يجب عليّ أن أتحسّن كثيراً

146
00:13:59,720 --> 00:14:05,130
يجب أن أستمرّ في التحسُّن أكثر
فأكثر فأكثر فأكثر

147
00:14:09,890 --> 00:14:11,020
ميو-تشان

148
00:14:12,730 --> 00:14:13,830
ميو-تشان

149
00:14:18,280 --> 00:14:19,990
أنا ميوكي ناكامورا

150
00:14:19,990 --> 00:14:22,260
آمل أن تصبحنَ صديقاتي جميعاً

151
00:14:24,000 --> 00:14:29,970
إنّها رائعة جدّاً بوقوفها فخورة بينما لا تملك
أي صديقة بعد في الصفّ

152
00:14:29,970 --> 00:14:33,750
يبدو أنّها تمتلك كُلّ الأشياء الّتي لا أملكها

153
00:14:46,030 --> 00:14:48,700
أنتِ، كنتِ تُحدّقين بي كثيراً مؤخّراً

154
00:14:48,700 --> 00:14:50,290
—إن كان لديكِ ما تقولينه، فأخبريني فحسب

155
00:14:50,290 --> 00:14:51,860
!أريد أن أكون صديقتكِ

156
00:15:00,990 --> 00:15:05,720
أ-أريد أن... أكون صديقتكِ

157
00:15:18,510 --> 00:15:19,770
!ناكامورا

158
00:15:21,130 --> 00:15:25,370
سنُقيم بطولة ملِك س.ف 5 مرّة أُخرى اليوم

159
00:15:25,370 --> 00:15:26,700
حريّ بكم ألّا تنسي ذلك

160
00:15:26,700 --> 00:15:27,440
حقّاً؟

161
00:15:27,690 --> 00:15:31,560
حسناً، لكن لن ألعب معكم بعد
أن أمسح الأرض بكم ثانية

162
00:15:31,560 --> 00:15:34,660
حمقاء. اليوم هو اليوم الّذي سأهزمكِ
فيه شرّ هزيمة لدرجة أنّكِ ستبكين

163
00:15:34,660 --> 00:15:37,320
لم يبقَ لكِ الكثير من الوقت

164
00:15:39,520 --> 00:15:41,840
أنتِ رائعة يا ميو-تشان

165
00:15:42,830 --> 00:15:45,650
أنتِ أفضل من أيّ فتى في ألعاب الفيديو

166
00:15:46,360 --> 00:15:47,790
هذا ما أعتقده

167
00:15:47,790 --> 00:15:51,750
ألعاب القتال هي الشّيء الوحيد الّذي
أفعله وأنا فخورة به

168
00:15:51,750 --> 00:15:56,810
،حتّى لو خسرتُ في كُلّ شيء آخر
لا أمانع ما دمتُ أربح في ألعاب القتال

169
00:15:57,220 --> 00:16:00,770
سمعتُ الفتيان يتكلّمون

170
00:16:00,770 --> 00:16:03,760
هل صحيح أنّكِ ربحتِ بطولةَ س.ف 5؟

171
00:16:03,760 --> 00:16:04,520
آه هذه

172
00:16:04,520 --> 00:16:06,690
لماذا لم تخبريني بذلك؟

173
00:16:06,690 --> 00:16:12,150
كانت بطولة بسيطة، ليست أكبر بكثير
من "ملِك س.ف 5" خاصّتهم

174
00:16:12,390 --> 00:16:18,660
وأقصد، أنتِ، في الواقع... جزءٌ من عالم مُختلف
عن الألعاب العنيفة

175
00:16:18,660 --> 00:16:21,310
أعتقد بأنّكِ لن تهتمّي

176
00:16:21,310 --> 00:16:23,110
خطأ. خمِّني ثانية

177
00:16:23,110 --> 00:16:25,320
لديّ س.ف 5 أيضاً

178
00:16:25,320 --> 00:16:27,340
لحظة، هل أنتِ جادّة؟

179
00:16:28,560 --> 00:16:30,560
لكن أنا سيّئة جدّاً فيها

180
00:16:30,560 --> 00:16:32,650
،لعبتُ ضدّ أبناء عمّي

181
00:16:32,650 --> 00:16:34,930
لكن ظلّوا يؤدّون تلك الحركة حيث
،ينزلق فيغا نحوك

182
00:16:34,930 --> 00:16:37,300
ولم أعرف ماذا أفعل، لذا بكيتُ في النّهاية

183
00:16:38,800 --> 00:16:42,680
،لذا في الواقع، ظننتُ بأنّها كانت لعبة صعبة حقّاً

184
00:16:42,680 --> 00:16:45,260
ما يجعلكِ تبدين أكثر روعة حتّى

185
00:16:48,960 --> 00:16:51,670
،لم أخبر أحداً بهذا من قبل

186
00:16:52,830 --> 00:16:57,610
لكن أريد أن أكون لاعبة قتال مُحترفة عندما أكبر

187
00:16:59,170 --> 00:17:00,530
مُحترفة؟

188
00:17:01,570 --> 00:17:04,770
أنا واثقة بأنّه يمكنكِ أن تصبحي مُحترفة

189
00:17:04,770 --> 00:17:07,040
لديكِ موهبة بكلّ تأكيد

190
00:17:11,460 --> 00:17:13,360
هذه ليست موهبة

191
00:17:14,430 --> 00:17:20,040
قد تعتقدين بأنّ المهارة في الألعاب قد تكون
،مُتعلِّقة بالحركات الانعكاسيّة فقط

192
00:17:20,410 --> 00:17:24,730
لكن هذا الفارق المادّي لا يُحدّد
نتيجة الكثير من المُباريات

193
00:17:24,730 --> 00:17:25,990
حقّاً؟

194
00:17:25,990 --> 00:17:30,600
إنّ التّفكير في كيفيّة الفوز هو المُهمّ
في مُعظم المُباريات

195
00:17:30,600 --> 00:17:31,950
التّفكير؟

196
00:17:31,950 --> 00:17:32,900
أجل

197
00:17:32,900 --> 00:17:35,610
هذا ما يجعل اللّعب مُمتعاً للغاية

198
00:17:43,070 --> 00:17:47,040
أنتِ الأروع حقّاً يا ميو-تشان

199
00:17:49,040 --> 00:17:50,280
لديّ فكرة يا ميو-تشان

200
00:17:50,280 --> 00:17:51,300
نعم؟

201
00:17:51,300 --> 00:17:54,980
أريدكِ أن تُعلّميني كيفيّة لعب س.ف 5
إن لم تُمانعي ذلك

202
00:17:59,080 --> 00:18:00,790
حسناً إذاً

203
00:18:00,790 --> 00:18:05,230
هلّا لعبتِ ضدّي إذا تحسّنتِ؟

204
00:18:06,380 --> 00:18:08,110
في منزلي؟

205
00:18:09,300 --> 00:18:10,060
أجل

206
00:18:11,780 --> 00:18:14,790
هناك كثير من اللّاعبين المُحترفين في هذه الأيّام

207
00:18:13,720 --> 00:18:19,240
.ألعاب القتال مُميّزة بالنّسبة لميو-تشان
إنّها حلمُها

208
00:18:14,790 --> 00:18:16,880
إنّهم أقوياء

209
00:18:16,880 --> 00:18:19,230
بالطّبع، هذا يجعل النّاس يقولون
كلاماً سطحيّاً

210
00:18:19,230 --> 00:18:23,430
،حول كيف أنّها "لم تعُد لعبة
"إنّها رياضة

211
00:18:19,440 --> 00:18:24,450
لذا حتّى لو استغرق ذلك وقتاً، حالما
،أصبح ماهرة فيها

212
00:18:23,430 --> 00:18:28,660
لكن هذا بعيد. من المُمتع اللّعب بجدّية
لأنّها لعبة بالفعل

213
00:18:25,480 --> 00:18:28,660
أستطيع أن أكون مُميّزة بالنّسبة لميو-تشان أيضاً

214
00:18:43,640 --> 00:18:45,270
آسفة يا أريسّا

215
00:18:45,270 --> 00:18:47,470
رُبّما حشرتُ الكثير من التّعليمات

216
00:18:49,800 --> 00:18:55,410
لا بُدّ أنّها التزمتْ بالأشياء السّهلة
وذلك كي لا أشعر بالإحباط

217
00:18:58,220 --> 00:18:59,980
،لكن في نفس الوقت

218
00:18:59,980 --> 00:19:04,320
أرغب في التمرّن على أشياء لم تُعلّمني
إيّاها وأفاجئها

219
00:19:07,250 --> 00:19:11,420
أشعر وكأنّني لستُ مُؤهَّلة لهذه
اللّعبة في نهاية المطاف

220
00:19:11,420 --> 00:19:13,010
أنا خائفة من الاقتراب

221
00:19:14,920 --> 00:19:20,460
ماذا لو لم أكن أنا وكان الاقتراب
مُخيفاً بالنّسبة للجميع؟

222
00:19:22,820 --> 00:19:26,400
لماذا اقترب منّي هذا الشّخص
فقط كي يتصدّى؟

223
00:19:26,880 --> 00:19:28,980
فهمت

224
00:19:28,210 --> 00:19:31,590
الاقتراب والتصدّي يخبرك كيف
يلعب اللّاعب الآخر

225
00:19:29,580 --> 00:19:33,550
اللّاعبون الجيّدون ماهرون في السّير للأمام

226
00:19:33,550 --> 00:19:36,980
لا يستطيع البشر التّركيز على أكثر
من ثلاثة أشياء في آن واحد؟

227
00:19:33,790 --> 00:19:36,480
لذا ربّما أستطيع إطلاق عنان الحركات السّلبيّة

228
00:19:36,480 --> 00:19:39,360
بينما أجعل خصمي يتنبّه لأمور كثيرة بالفعل

229
00:19:40,360 --> 00:19:44,270
فهمت! تدخلين المدى عندما يكون
الخصم على وشك المشي

230
00:19:44,270 --> 00:19:47,370
سأدع هذه اللّكمة الثّقيلة تمرّ بدلاً من لكمها

231
00:19:48,480 --> 00:19:52,490
ثمّ القَصاص من الخصم حيث لا يتوقّع
لمُحاصرته في الزّاوية

232
00:19:50,730 --> 00:19:52,490
!ربحتُ بانتهاء الوقت

233
00:19:54,000 --> 00:19:57,160
هذا الشّخص يجعل الأمر مكشوفاً تماماً
عندما يبذل كُلّ طاقته

234
00:19:57,990 --> 00:19:59,610
حسناً

235
00:19:59,610 --> 00:20:03,630
هذه لعبة تتمحور حول تخيُّل كيف
يشعر اللّاعبُ الآخر

236
00:20:26,440 --> 00:20:29,920
هل تمرّ ميو-تشان بيوم عصيب؟

237
00:20:29,920 --> 00:20:31,190
خدعتِني؟

238
00:20:31,900 --> 00:20:34,580
كنتِ ماهرة في ألعاب القتال منذ
البداية، أليس كذلك؟

239
00:20:34,580 --> 00:20:37,540
تظاهرتِ بأنّكِ مبتدئة فحسب

240
00:20:37,540 --> 00:20:40,470
هل كنتِ تُحاولين مُباغتتي؟

241
00:20:43,340 --> 00:20:46,540
هل كرهتِني طوال هذا الوقت؟

242
00:20:46,540 --> 00:20:47,600
—لـ

243
00:20:48,260 --> 00:20:51,470
ماذا سيحدث إذا قلتُ "لا"؟

244
00:20:51,800 --> 00:20:55,490
"!إذا قلتُ "لا، أنا مُبتدئة حقّاً

245
00:20:56,000 --> 00:20:57,430
...ميو-تشان سوف

246
00:20:58,130 --> 00:21:02,970
هل كنتِ تسخرين منّي في عقلكِ عندما
أخبرتُكِ بأنّني أردتُ الاحتراف؟

247
00:21:02,970 --> 00:21:07,150
هل ضحكتِ بينكِ وبين نفسكِ عندما قلتُ
بأنّ ألعاب القتال لا تتمحور حول الموهبة؟

248
00:21:07,150 --> 00:21:08,280
انتظري

249
00:21:10,820 --> 00:21:12,590
انتظر يا إلهي

250
00:21:12,590 --> 00:21:14,040
انتظر أرجوك

251
00:21:17,450 --> 00:21:18,410
أكرهكِ

252
00:21:18,900 --> 00:21:20,160
أكرهكِ يا آريسا

253
00:21:20,640 --> 00:21:23,490
لا أريد رؤيتكِ ثانية أبداً

254
00:21:31,250 --> 00:21:32,590
يجب عليّ الذّهاب

255
00:21:36,380 --> 00:21:38,620
حريّ بي أن أتحسّن

256
00:21:38,620 --> 00:21:39,960
أكثر فأكثر

257
00:21:40,770 --> 00:21:45,900
أظلّ أمشي في نفق حالك السّوداء
لا نهاية له، وحيدة تماماً

258
00:21:47,010 --> 00:21:51,200
إلى أيّ مدى يجب أن أصل لأدعها تُسامحني؟