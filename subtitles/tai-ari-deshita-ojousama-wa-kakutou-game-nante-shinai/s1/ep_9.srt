1
00:00:08,830 --> 00:00:10,310
لم أفعل ذلك

2
00:00:23,440 --> 00:00:28,670
أخذها بمحمل الجدّ"؟ "لا تغترّ"؟
انسَ هذا الهُراء

3
00:00:30,600 --> 00:00:32,540
أنا ضعيف

4
00:00:33,370 --> 00:00:35,700
أنا أقوى

5
00:00:39,750 --> 00:00:40,860
إيبوكي

6
00:00:41,990 --> 00:00:44,020
إنّها تقنيّة تنفُّس كاراتيه

7
00:00:44,020 --> 00:00:46,940
،بالزّفير بسرعة بشكل كامل قبل الشّهيق

8
00:00:46,940 --> 00:00:51,230
يُفترض أن يسمح لك بأخذ أنفاس
عميقة أثناء التنفُّس بصعوبة

9
00:00:51,230 --> 00:00:52,940
هكذا إذاً

10
00:00:52,940 --> 00:00:57,650
والتنفُّس مُرتبط بشكل متين بالحالة العقليّة

11
00:01:00,170 --> 00:01:03,670
"أنا ضعيف" و"أنا قويّ"

12
00:01:03,670 --> 00:01:08,190
ألعاب القتال تتطلّب منك أن تكون الاثنين

13
00:01:08,590 --> 00:01:15,300
يا فتاة، جعلتِني أتذكّر شيئاً هامّاً حقّاً

14
00:01:21,520 --> 00:01:22,980
هيّا بنا

15
00:03:02,320 --> 00:03:06,430
الآنسة الصّغيرة لا تنفك تتحرّك. أنا مُندهش

16
00:03:06,430 --> 00:03:08,710
قلّ من البالغين يستطيعون اللّعب
بالسّلحفاة غايل بهذه الجودة

17
00:03:09,110 --> 00:03:12,030
هذه هي القفزة الخامسة على التّوالي
الّتي تضربني من خلالها

18
00:03:12,030 --> 00:03:15,290
أيّ شخص عاقل كان ليستسلم عن القفز بعد ذلك

19
00:03:15,770 --> 00:03:17,220
...لهذا السّبب

20
00:03:17,510 --> 00:03:18,670
سأقفز

21
00:03:21,160 --> 00:03:22,880
توقّعتُ هذا

22
00:03:26,920 --> 00:03:29,510
أسلوب لعِب مُتململ مبنيّ حول القفز

23
00:03:29,510 --> 00:03:30,890
أنت لا تُبالين لما تفعلينه

24
00:03:30,890 --> 00:03:32,860
ليس بالضّرورة أن تكون ألعاب قتال

25
00:03:32,860 --> 00:03:37,070
تحتاجين فقط عذراً للاحتفال مع صديقاتكِ

26
00:03:37,460 --> 00:03:39,280
...مُحال لشخص مثلكِ

27
00:03:40,200 --> 00:03:42,190
أن يهزمني يوماً

28
00:03:44,080 --> 00:03:46,870
هناك شِدّة إضافيّة تنبعث من تلك القذائف

29
00:03:50,200 --> 00:03:52,160
إنّها خبيرة لعينة

30
00:03:52,400 --> 00:03:53,810
"السّلحفاة غايل"

31
00:03:54,570 --> 00:04:00,140
التصدّي مع الجثوم باستمرار يخلق
،فُرصة للاندفاع في كلا الاتّجاهين

32
00:04:00,140 --> 00:04:05,140
ليدع اللّاعبين ذوي هذا الأسلوب يعترضون
الخصم الّذي يقفز أثناء ترك مسافة

33
00:04:05,600 --> 00:04:08,150
بالطّريقة الّتي تؤدّي فيها الآنسة
،الصّغيرة دويّاً صوتيّاً

34
00:04:08,150 --> 00:04:12,810
يجب عليها تمرين ذاكرتها العضليّة على وقت
الاندفاع الأدنى بـ 45 إطار

35
00:04:12,810 --> 00:04:18,270
إنّها تُنفّذها بأسرع ما يُمكن لتحصد أكبر نتيجة

36
00:04:18,600 --> 00:04:20,990
وهي ليست مُجرّد سُلحفاة غايل

37
00:04:21,240 --> 00:04:25,450
إنّها عازمة باستماتة على عدم
تمكُّن أحد منها

38
00:04:25,450 --> 00:04:28,170
أيّ طفلة تلعب بهذا الشّكل؟

39
00:04:40,360 --> 00:04:42,050
رمية؟ أو هجمة؟

40
00:04:45,400 --> 00:04:47,350
تصدّيتُ لواحدة أخيراً

41
00:04:47,590 --> 00:04:48,790
...رغم ذلك

42
00:04:48,790 --> 00:04:53,660
،إنّها واثقة تماماً في تركِ مسافة
نظراً إلى أنّني استخدمتُ عليها إطار حصانة في البداية

43
00:04:53,660 --> 00:04:54,970
حصانة المقذوفات

44
00:04:54,970 --> 00:04:59,210
لمُنافسة المقذوفات مثل الهادوكين
،أو الدويّ الصّوتيّ

45
00:04:59,210 --> 00:05:03,240
لدى بعض الشّخصيّات الحصينة أمام تأثيراتها

46
00:05:03,240 --> 00:05:05,640
...وتلك الفورة قبل قليل

47
00:05:05,640 --> 00:05:09,310
وعندما خطّطتُ لاستخدام إطار حصانة
ثانية وإسكاتها، انقضّتْ نحوي

48
00:05:10,860 --> 00:05:15,490
هذه الشّقيّة الصّغيرة مُخضرمة
في ألعاب المقذوفات الذّهنيّة

49
00:05:15,490 --> 00:05:19,040
إنّها تلعب كامرأة مُتمرِّسة

50
00:05:19,040 --> 00:05:20,910
أيّ طفلة هي أنتِ؟

51
00:05:22,640 --> 00:05:26,870
أنا واثقة بأنّكِ لا تستطيعين تحمُّل لاعبات مثلي؟

52
00:05:26,870 --> 00:05:28,720
أعرف نوعيّتكِ

53
00:05:28,720 --> 00:05:33,350
سأكرّس حياتي لهذا!" تصبح "أيّ شخص"
"!ليس كذلك هو قمامة

54
00:05:33,590 --> 00:05:36,510
عند سماع لاعب يبدو ضعيفاً يلقي
،مُحاضرة فلسفيّة حول ألعاب القتال

55
00:05:36,510 --> 00:05:37,680
فلا يمكنني منع نفسي

56
00:05:37,680 --> 00:05:41,190
وجودنا في هذه البطولة يجعلنا أعداء

57
00:05:41,190 --> 00:05:44,140
يمكنني التّماشي مع ذلك

58
00:05:46,230 --> 00:05:47,570
تراجعتْ؟

59
00:05:47,570 --> 00:05:49,190
يمكنها تنفيذ إطار الحصانة من هناك

60
00:05:49,190 --> 00:05:53,150
الآنسة الصّغيرة تعرف ذلك. بدأت تمزج
بين الحركات المُضلّلة مع مقذوفاتها

61
00:05:53,150 --> 00:05:54,200
...ما الّذي

62
00:05:54,200 --> 00:05:56,460
إنّها تنخفض وخارج النِّطاق

63
00:05:56,460 --> 00:06:00,660
الاقتراب من غايل مع الحذر من حركة
حصانة قد يفلح

64
00:06:00,660 --> 00:06:05,380
لكن إذا اقترب كين، فإنّ مقذوفات غايل
الأسرع سوف تُهيمن

65
00:06:08,670 --> 00:06:11,660
هل ستقترب أم تُحاول المرور
من خلال إطار حصانة

66
00:06:11,660 --> 00:06:13,910
كلتاهما تحاولان قراءة تحرُّكات الأُخرى

67
00:06:13,910 --> 00:06:17,770
.اسمعي أيّتها الآنسة الصّغيرة الشّقيّة
أنتِ مجنونة للغاية، صحيح؟

68
00:06:18,290 --> 00:06:20,720
أحبُّ الجنون

69
00:06:23,730 --> 00:06:28,190
،أحبُّ الأشخاص الّذين ينغمسون فيما يُحبّون
ويُفجّرون كُلّ ما لديهم

70
00:06:28,440 --> 00:06:29,410
...لذا

71
00:06:31,160 --> 00:06:33,650
!أستطيع قراءتكِ ككتاب أيّتها الحمقاء

72
00:06:35,540 --> 00:06:36,710
استطاعت العبور؟

73
00:06:36,710 --> 00:06:38,870
!لا يستطيع أحدٌ فعل ذلك من تلك المسافة

74
00:06:40,160 --> 00:06:41,370
...لذا

75
00:06:41,370 --> 00:06:43,100
لنستمتع قليلاً

76
00:07:03,210 --> 00:07:05,480
إنّها ضعيفة للغاية

77
00:07:08,570 --> 00:07:10,210
أنفاس عميقة

78
00:07:10,210 --> 00:07:12,030
لا، أنا متأكّد بأنّها تعبس فحسب

79
00:07:12,030 --> 00:07:13,710
مهلاً، مهلاً

80
00:07:13,710 --> 00:07:19,990
قفزَ من فوق كافّة كُراتها النّاريّة وتصدّى
لأيّ حركة نفّذتْها في الجولة الثّانية

81
00:07:19,990 --> 00:07:22,490
ليس لدرجة أنّها ارتكبتْ أيّ خطأ

82
00:07:22,490 --> 00:07:24,890
كُلّ ما في الأمر أنّ ردود كافيوري
كانت استثنائيّة

83
00:07:24,890 --> 00:07:28,540
،كانت ردوده تستنزف عدّاد درايف الخاصّ بها
ثمّ فنّ خارق أثناء الحِراسة المُطلَقة

84
00:07:28,780 --> 00:07:31,000
لم يترك لها مجالاً لتنفيذ حركة خارقة

85
00:07:31,460 --> 00:07:34,220
كانت هذه استجابة لخسارته الجولة الأولى

86
00:07:34,220 --> 00:07:36,130
لم يتغيّر شيء بالنّسبة لي

87
00:07:36,130 --> 00:07:38,690
أعتقد بأنّ هذا ما يحدث عندما
يصبح كافيوري جادّاً

88
00:07:39,700 --> 00:07:44,890
،رغم ذلك، ركلة جثوم مُتوسّطة عند النّهوض
...ثمّ أداء حركات حصينة خامّة

89
00:07:44,890 --> 00:07:48,350
ثمّة شيء ما فيها يُذكّرني بغيكيدو

90
00:07:48,350 --> 00:07:53,440
نجح غيكيدو بحركاته الحصينة الخامّة
التأهّبيّة القديمة سابقاً

91
00:07:53,440 --> 00:07:56,330
لكن أقصد بأنّ الحركات الخامّة لفتاة ثريّة
كانت رديئة للغاية

92
00:08:14,000 --> 00:08:17,460
أترى ذلك؟ الآنسة الصّغيرة أدّتْ دويّاً
صوتيّاً أثناء السّير لإبقائها بعيدة

93
00:08:17,460 --> 00:08:19,200
دويّ صوتيّ أثناء السّير

94
00:08:19,200 --> 00:08:23,730
فنّ السّير لبضعة إطارات بين الاندفاع
وتحرير القذيفة

95
00:08:28,980 --> 00:08:30,450
مُستحيل

96
00:08:30,450 --> 00:08:32,150
كان ذلك يومي فحسب

97
00:08:32,150 --> 00:08:34,430
ليس وكأنّها قامتْ بذلك كردّة فعل

98
00:08:34,430 --> 00:08:37,740
كيف لها ألّا تقع ضحيّة أيّ خدعة
مُضلِّلة من الخدع إذاً؟

99
00:08:37,740 --> 00:08:41,190
تقصد بأنّها استجابت من ذلك المدى فحسب؟

100
00:08:42,570 --> 00:08:45,120
أثِق بأنّ حركاتي الانعكاسيّة ستحملني

101
00:08:45,490 --> 00:08:50,450
كنتُ لأتمنّى قول ذلك، لكنّني لا أستجيب
للأشياء تماماً فحسب

102
00:08:50,450 --> 00:08:53,650
حتّى أنا لا أجاري ما تلتقطه عينايّ

103
00:08:53,650 --> 00:08:56,560
لا أستطيع تفسير ذلك، لكن عندما
أُركِّز، فهذا ينجح تلقائيّاً

104
00:08:57,660 --> 00:09:01,580
لطالما امتلكتُ موهبة إنجاز الأمور
دون جهود تُذكَر

105
00:09:02,020 --> 00:09:03,510
في ألعاب الفيديو أيضاً

106
00:09:03,510 --> 00:09:06,570
أخسر بضع مرّات هنا وهناك وذلك
،كي لا أدخل في شِجار

107
00:09:06,570 --> 00:09:09,470
لكن لا أستطيع فعل ذلك عندما يلعب
أخوتي مع بعضهم الآخر

108
00:09:09,770 --> 00:09:12,770
!كُفّ عن اللّعب كجبان أيّها الأحمق

109
00:09:12,770 --> 00:09:16,210
الهرب بعدّاد حياة مُتقدِّم هو
!استراتيجيّة مشروعة يا غبيّ

110
00:09:15,160 --> 00:09:17,360
اهدآ

111
00:09:16,210 --> 00:09:19,560
!أنا أفضل، وأنت تعلم ذلك

112
00:09:17,360 --> 00:09:20,030
لا تنفعلا لدرجة البُكاء على ذلك

113
00:09:20,370 --> 00:09:26,260
،ما زلتُ أتذكّر بأنّني أوشكتُ أن أقول
تبقى مُجرّد لعبة" قبل أن أوقِف نفسي"

114
00:09:26,260 --> 00:09:29,450
اقتربَ وقت العشاء، لذا لنُكمل هذا غداً

115
00:09:29,830 --> 00:09:32,190
أريد الاستمرار في اللّعب

116
00:09:38,000 --> 00:09:43,520
أحبّ أن أنغمس في شيء لدرجة البُكاء عليه

117
00:09:53,390 --> 00:09:55,750
أكل شوريو يعني سقوط مُدوّياً

118
00:09:55,750 --> 00:09:58,320
ويجب عليها التّعامل مع أوكيزيمي تِلو الأُخرى

119
00:09:58,320 --> 00:10:01,630
حتّى تلك الآنسة الصّغيرة لا يمكنها
النّجاة من أكثر من هذا العدد

120
00:10:01,630 --> 00:10:03,940
على أيّ حال، ذات جديلتَي الشّعر رهيبة

121
00:10:03,940 --> 00:10:07,490
حركات كين غير مُخصّصة تماماً
لتجاوز المقذوفات

122
00:10:07,490 --> 00:10:12,760
لكنّها تستخدمها للاستفادة من إطار الحصانة
والاستمرار في التقدُّم كامرأة مسعورة

123
00:10:18,050 --> 00:10:19,710
مُملّ

124
00:10:26,760 --> 00:10:29,000
غيكيدو فاز في الجولة الثّانية؟

125
00:10:29,000 --> 00:10:30,220
هل أنت مُتفاجئ؟

126
00:10:34,300 --> 00:10:37,250
رمية واحدة في مُنتصف اللّعبة

127
00:10:37,250 --> 00:10:39,810
كان لدى الفتاة فُرصة أُخرى للأوكي

128
00:10:39,810 --> 00:10:41,790
اختارت التّراقُص

129
00:10:41,790 --> 00:10:45,660
التّراقُص" يعني استدراج الخصم
نحو تنفيذ رمية سريعة

130
00:10:45,660 --> 00:10:50,380
إنّ استخدام رمية بالتّزامن مع رمية
،خصمك يجعلك تتملّص منها

131
00:10:50,380 --> 00:10:54,610
لكن إذا أسأتَ قِراءتها، فإنّك ستُنفّذ
رمية من تلقاء نفسك

132
00:10:54,610 --> 00:10:58,010
تُوهم الآخر بأنّك سترمي، ثمّ تتراجع"
"لتدفعه لاستخدام رميته السّريعة

133
00:10:58,010 --> 00:11:00,550
"هذا ما يعنيه "التّراقُص

134
00:11:01,190 --> 00:11:08,620
وفائدة أُخرى وهي أنّ الثّبات وعدم الابتعاد
يتصدّى أيضاً لأيّ حركة خامّة وكبيرة

135
00:11:08,910 --> 00:11:11,890
...واستجابة لذلك، غيكيدو-سان

136
00:11:15,930 --> 00:11:17,150
...مشى للأمام عند النّهوض

137
00:11:18,350 --> 00:11:19,830
ورماها

138
00:11:20,730 --> 00:11:23,450
تلك الضّربة قد غيّرت مسار المُباراة

139
00:11:27,190 --> 00:11:28,790
ماذا كان ذلك؟

140
00:11:29,080 --> 00:11:32,090
المشي للأمام في تلك اللّحظة غير منطقيّ

141
00:11:32,090 --> 00:11:36,840
لِمَ يجازف تلك المُجازفة لتوجيه رمية
لا تُلحِق حتّى ضرراً كبيراً؟

142
00:11:38,650 --> 00:11:39,770
تبّاً

143
00:11:39,770 --> 00:11:42,830
سمحتُ لهدوئي أن يتصدّع، والآن
يتسرّب إليّ التوتُّر

144
00:11:44,130 --> 00:11:48,180
أشعر ببرد فجأة. هذه هي النّهاية

145
00:11:48,590 --> 00:11:51,730
لكن أعلم بأنّني أستطيع فعل
ما هو أكثر من ذلك

146
00:12:14,670 --> 00:12:16,440
مهلاً يا أنا

147
00:12:17,390 --> 00:12:19,380
لا تستبعدي نفسكِ بعد

148
00:12:24,070 --> 00:12:26,170
حسناً، أليس هذا رهيباً؟

149
00:12:26,910 --> 00:12:29,150
غيكيدو يبتسم

150
00:12:29,150 --> 00:12:31,090
بقيت جولة واحدة

151
00:12:31,590 --> 00:12:33,180
سأبذل قصارى جهدي

152
00:12:43,900 --> 00:12:48,870
تخلّت الآنسةُ الصّغيرة عن ترك مسافة
والآن تُقاتل عن كثب بعد تلك المرّة

153
00:12:48,870 --> 00:12:52,300
،أو هذا ما تعتقده. بدلاً من ذلك
توقّفتْ عن الهجوم، نقطة انتهى

154
00:12:52,300 --> 00:12:53,570
لا أرى سوى حركات تضليليّة

155
00:12:53,570 --> 00:12:55,660
هل هي خائفة جدّاً من المقذوفات رُبّما؟

156
00:12:55,660 --> 00:13:00,260
لكن أتعلم؟ يبدو هذا خمولاً أكثر من كونه استسلاماً

157
00:13:04,170 --> 00:13:06,820
وكأنّها تريد أن يمضي الوقت

158
00:13:06,820 --> 00:13:09,590
إنّها تنتظر حتّى يتقدّم عدّاد
الحياة لدى خصمها عن عدّادها؟

159
00:13:09,930 --> 00:13:11,100
لماذا؟

160
00:13:24,110 --> 00:13:25,650
أعتقد حان الوقت

161
00:13:28,840 --> 00:13:29,790
!تمّ التصدّي

162
00:13:30,760 --> 00:13:34,460
بصراحة، ظننتُها تُنفّذ حركات بشكل
عشوائيّ في البداية

163
00:13:34,460 --> 00:13:38,740
إن لم يكن كذلك، لماذا لم تكن تفعل
هذا طوال الوقت؟

164
00:13:38,740 --> 00:13:41,450
إنّها تتخطّى المقذوفات من مسافة قريبة جدّاً

165
00:13:41,730 --> 00:13:45,970
يتطلّب ذلك تركيزاً عالياً للغاية

166
00:13:45,970 --> 00:13:50,670
أتساءل إلى متى تستطيع الحِفاظ
على ذلك التّركيز

167
00:13:55,180 --> 00:13:57,140
انكسرتِ بشكل أسرع ممّا توقّعت

168
00:14:01,660 --> 00:14:03,740
قلبَتْ خطّتي في اللّعب ضدّي

169
00:14:03,740 --> 00:14:06,810
أجبرتْني حركاتُها التّضليليّة على التّركيز
بينما هي مُسترخية تماماً

170
00:14:06,810 --> 00:14:09,610
كانت تنتظر حتّى ينفد وضع التّركيز لديّ

171
00:14:09,610 --> 00:14:13,820
لكن ما زال بمقدوري مُراوغة مقذوف
إذا كنتُ أعلم بأنّه قادم

172
00:14:16,860 --> 00:14:21,080
رأيتِ؟ هذا ما يحدث عندما تكونين
مُركِّزة تماماً على المقذوفات

173
00:14:24,040 --> 00:14:25,160
مهلاً

174
00:14:26,350 --> 00:14:30,390
منعتْ قفزةَ ملاذ أخير للابتعاد عن الزّاوية
برمية هوائيّة فائقة السّرعة؟

175
00:14:34,050 --> 00:14:36,260
عرفتُ بأنّكِ ستعودين للقفز

176
00:14:41,070 --> 00:14:43,730
لن ألهو معكِ

177
00:14:44,070 --> 00:14:45,650
أنتِ مُملّة

178
00:15:14,590 --> 00:15:18,280
،أيّتها الآنسة الصّغيرة الشّقيّة
أنتِ رهيبة

179
00:15:18,280 --> 00:15:20,830
رغم ذلك، أتمنّى لو نُطيل المتعة
فترة أطول قليلاً

180
00:15:22,270 --> 00:15:23,560
هكذا إذاً

181
00:15:23,560 --> 00:15:27,740
أنتِ شخصٌ يستطيع العيش دون ألعاب
قِتال، تلعب من باب التّسلية

182
00:15:27,740 --> 00:15:30,640
،أنتِ لا تلعبين كشخص يريد الرّبح
مهما كلّف الأمر

183
00:15:31,070 --> 00:15:33,770
هذا ما يجعلكِ ضعيفة وسهلة الانكسار

184
00:15:47,440 --> 00:15:49,790
إنّها تتكلّم بصراحة زائدة عن اللّزوم

185
00:15:52,880 --> 00:15:55,330
حسناً، لا يحقّ لي أن أشتكي

186
00:15:55,330 --> 00:15:57,220
أقصد، بأنّ هذا صحيح

187
00:16:28,200 --> 00:16:31,430
اقتربَ كافيوري مع التصدّي بهيئة فنّ

188
00:16:31,430 --> 00:16:33,620
كيفيّة استقرائه لها بشكل مثاليّ بينما يتقدّم

189
00:16:33,620 --> 00:16:35,830
تجعلنا ننسى بأنّه عانى في الجولة الأولى

190
00:16:38,520 --> 00:16:39,980
إنّها تحاول قتل زخمه

191
00:16:51,810 --> 00:16:55,200
فتاة اللّعِب الثّريّة حقّقتْ بعض
الضّربات الجيّدة

192
00:16:55,200 --> 00:17:00,370
العزيمة الّتي أبدتْها وهي تقطع هذه المسافة
ضدّ مُحترف لا تقلّ دهشة أيضاً

193
00:17:30,120 --> 00:17:31,390
لا أستطيع العبور

194
00:17:31,390 --> 00:17:33,960
ولا ضربة من ضرباتي تتحقّق

195
00:17:36,030 --> 00:17:39,830
مهلاً، مهلاً. غيكيدو هو من يُدير العرض الآن

196
00:17:39,830 --> 00:17:43,740
في الواقع، ألم تخسر الفتاة في كلّ
استقراء في هذه الجولة؟

197
00:17:43,740 --> 00:17:46,830
هذا لأنّ غيكيدو-سان انتهى
من تحليلها

198
00:17:46,830 --> 00:17:50,030
حسناً، إنّها فدائيّة تلعب بطريقة التحسُّس

199
00:17:50,030 --> 00:17:56,040
تحقُّقاتها الاستغلاليّة العنيدة
وقصاصها لا نظير لهما

200
00:17:56,040 --> 00:17:56,810
...لكن

201
00:18:01,300 --> 00:18:03,530
عجباً. نال منها بالقفزة

202
00:18:03,530 --> 00:18:08,260
بشكل مُماثل، التحسُّس يستهلك
مُعظم تركيزها

203
00:18:08,260 --> 00:18:12,230
هذه نقطة عمياء سهلة بالنّسبة
لغيكيدو-سان ليستغلّها

204
00:18:12,820 --> 00:18:16,990
...الأهمّ، حتّى في التحسُّس، هي هي الأقوى

205
00:18:17,570 --> 00:18:21,020
إنّها تتلقّى ضربات ردّ دون مُقاومة تُذكَر الآن

206
00:18:22,660 --> 00:18:25,100
هيدي-سان! كنت هنا تُراقب؟

207
00:18:25,100 --> 00:18:27,210
منذ مُنتصف الجولة الأولى

208
00:18:28,710 --> 00:18:32,400
لكن انسَ أمري. انظر إلى حيث هي

209
00:18:36,180 --> 00:18:40,170
هل هي تُحافظ على مسافة، مُقارنة بما سبق؟

210
00:18:40,170 --> 00:18:43,150
هذه هي مسافتها العقليّة

211
00:18:43,150 --> 00:18:46,310
تقصد بأنّها مُتردِّدة، لذا هي
لا تقترب بمسافة كافية؟

212
00:18:46,310 --> 00:18:49,270
الشّاشة لا تكذب

213
00:18:49,650 --> 00:18:54,400
تمكّنتْ من تحميس نفسها بذلك
،الاستعراض الغريب

214
00:18:54,400 --> 00:18:58,270
لكن يبدو أنّ ذلك لم يخدمها في إيجاد جوابها التّالي

215
00:18:58,610 --> 00:19:01,780
أتتذكّر كيف تراقصَتْ كثيراً؟

216
00:19:01,780 --> 00:19:04,660
ذلك يتفوّق على التملُّص من الرّمية
والحركات الكبيرة

217
00:19:04,660 --> 00:19:05,580
صحيح

218
00:19:05,580 --> 00:19:10,040
تقريباً كُلّ مُعجب س.ف 6 قد رأى
أسلوب لعِب غيكي

219
00:19:10,040 --> 00:19:13,210
طريقته في استخدام حركات حصينة خامّة
،عند الشّدائد، بالطّبع

220
00:19:13,210 --> 00:19:16,880
،وبالإضافة إلى ميوله للهجمات المُضادّة للجوّ
وكثرة تملّصاته مُؤخّراً

221
00:19:16,880 --> 00:19:21,040
أسندتْ هجومها على تلك المعرفة
ودخلت المُباراة بثِقة

222
00:19:21,040 --> 00:19:25,520
إنّها من النّوع الّذي يتألّق حقّاً
عندما يكون لديها إجابة جاهزة

223
00:19:26,270 --> 00:19:28,520
هذه هي. من مكان قريب، لديّ الأفضليّة

224
00:19:28,520 --> 00:19:30,000
...والآن سأضاعف الجهود

225
00:19:30,510 --> 00:19:32,230
وأركل مؤخّرتك

226
00:19:32,230 --> 00:19:34,940
وغيكيدو-سان سحقَ ذلك

227
00:19:34,940 --> 00:19:35,990
أجل

228
00:19:41,050 --> 00:19:43,070
برمية الاستيقاظ والمشي

229
00:19:44,310 --> 00:19:46,780
ماذا كانت رمية المشي تلك؟

230
00:19:46,780 --> 00:19:51,820
المشي للأمام بعد النّهوض يعني
التِهام أيّ شيء أفعله

231
00:19:51,820 --> 00:19:54,040
هجمات، رميات، أيّاً يكن

232
00:19:54,040 --> 00:19:56,500
هل فقد صوابه؟

233
00:19:56,820 --> 00:19:58,720
تبّاً. تبّاً

234
00:19:58,720 --> 00:20:02,310
لعبة القتال هي مُحادثة

235
00:20:02,310 --> 00:20:05,400
تفقّد النّظرات في وجه غيكي

236
00:20:05,680 --> 00:20:07,850
إنّه مُستمتع

237
00:20:07,850 --> 00:20:11,810
.لا أقصد ذلك من ناحية سيّئة
إنّه يستمتع بالمُباراة

238
00:20:12,210 --> 00:20:19,270
.كانت المدارس تحظر زيارة الأركيد
في هذه الأيّام يسمّيها النّاس بالرّياضة الإلكترونيّة

239
00:20:19,270 --> 00:20:23,820
،لكن بالنّسبة لنا، في الماضي والحاضر
هذه خير وسيلة للاستمتاع

240
00:20:24,240 --> 00:20:25,920
يجب علينا الاستمتاع بذلك

241
00:20:28,900 --> 00:20:32,130
إنّها تستخدم هجمةً هوائيّة مُنخفضة لوضع
حجر أساس لقفزة عاديّة؟

242
00:20:33,960 --> 00:20:38,280
لم تُهاجم في أسرع وقت وأدنى
ارتفاع مُمكن للهبوط فوراً

243
00:20:38,280 --> 00:20:43,380
أخّرَتِ الهجمةَ لتجعل الامر يبدو كقفزة
وقَصاص للهجمات المُضادّة للجوّ؟

244
00:20:43,380 --> 00:20:46,840
،إذا أردت التِهام كومبو بهذا الإلحاح
فسوف أُطعمك واحداً

245
00:21:06,120 --> 00:21:09,420
ليسَ حيث توقّعتُ المُنشِّطة الخامّة
الأولى له في هذا اليوم

246
00:21:09,420 --> 00:21:10,830
هذا هو غيكي الّذي عهِدناه

247
00:21:10,830 --> 00:21:13,030
بجدّية؟ فعلَها بشكل مُباشر؟

248
00:21:13,030 --> 00:21:16,910
لا. هيّأ الأمور بحيث تتحقّق الإصابة

249
00:21:29,900 --> 00:21:31,060
أنتِ

250
00:21:33,770 --> 00:21:35,470
لنلعب ثانية في وقت لاحق

251
00:21:40,250 --> 00:21:42,120
أتمنّى ذلك

252
00:21:54,460 --> 00:21:55,600
ميو