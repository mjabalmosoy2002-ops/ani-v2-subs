1
00:00:00,310 --> 00:00:02,470
...أتعتقد بأنّني سأقع ضحيّة هذا

2
00:00:02,470 --> 00:00:03,820
!مرّة ثانية؟

3
00:00:11,030 --> 00:00:12,230
أوقفَ التحقُّق من الضّربة؟

4
00:00:12,230 --> 00:00:15,200
لا. لم يرتكب خطأ

5
00:00:15,200 --> 00:00:16,910
اقتيدَ إلى ذلك

6
00:00:22,140 --> 00:00:24,870
!قَصاص فنّ حاسِم

7
00:00:36,500 --> 00:00:39,640
!ينتهي ذلك بفشل. يا للإحباط

8
00:00:39,640 --> 00:00:43,140
ظننتُ بأنّ كافيوري كان مُتمكّناً في التحقُّق
بركلة جثوم مُتوسِّطة

9
00:00:43,140 --> 00:00:47,090
يمكنك أن تتمرّن كما تشاء، لكن لن
تتمكّن من التّنفيذ بشكل مثاليّ

10
00:00:47,090 --> 00:00:51,610
حتّى الأفضل يرتكب مزيداً من الأخطاء
عندما تشتدّ المُنافسة

11
00:00:51,610 --> 00:00:53,900
كان نِزالاً مليئاً بالضّغط

12
00:00:53,900 --> 00:00:56,520
ومن يتوقّع مفاجأة كهذه عندما كانت
ضربة واحدة كفيلة بإنهاء الأمر؟

13
00:00:56,520 --> 00:00:58,240
،وفي تلك اللّحظة

14
00:00:58,240 --> 00:01:02,790
لا بُدّ أنّ كافيوري تذكّر تلقّي إصابة برمية
مُفاجئة في النِّزال السّابق

15
00:01:03,190 --> 00:01:07,510
نقلَ غيكيدو المعركةَ إلى أرض خصمه
،باستعراض ركلة جثوم مُتوسِّطة

16
00:01:07,510 --> 00:01:09,180
ثمّ قرّرَ سحقه بشكل مُباشر

17
00:01:18,310 --> 00:01:21,970
مُحال أن أتمكّن من الظّفر بهذا النِّزال

18
00:01:23,300 --> 00:01:25,590
خسارتي مضمونة

19
00:02:59,370 --> 00:03:04,070
ما الّذي ينبغي أن أسعى له للخروج
من نِزال أعلم بأنّني سأخسر فيه؟

20
00:03:04,480 --> 00:03:08,830
أتساءل ماذا ينبغي أن يكون
هدفي في هذه البطولة

21
00:03:08,830 --> 00:03:11,850
إنّه نفس الأمر الّذي كانت تيا-سينباي
تتحدّث عنه

22
00:03:11,850 --> 00:03:14,290
تصرّفتُ وكأنّني العارِفة بكُلّ شيء

23
00:03:14,640 --> 00:03:16,540
...حتّى لو خسرتُ

24
00:03:16,540 --> 00:03:21,320
لا، لأنّني سأخسر، أريد الاستفادة من ذلك

25
00:03:21,320 --> 00:03:22,840
أنتفع بشيء يمكنني البناء عليه

26
00:03:23,600 --> 00:03:25,770
المعذرة، آيا-سان؟

27
00:03:27,760 --> 00:03:29,520
ماذا يجدر بي أن أفعل؟

28
00:03:29,520 --> 00:03:32,310
أشعر بالخوف الشّديد حقّاً هنا

29
00:03:32,310 --> 00:03:33,200
ماذا؟

30
00:03:33,200 --> 00:03:36,960
ألم تكوني تتبجّحين حرفيّاً بكونكِ
ماهرة في التّعامُل مع التوتُّر؟

31
00:03:36,960 --> 00:03:38,950
!ظننتُ نفسي كذلك

32
00:03:38,950 --> 00:03:41,200
أنتِ سيّئة جدّاً في التّعامل مع التوتُّر

33
00:03:41,910 --> 00:03:45,680
هل تعرفين أيّ شيء حتّى عن
كافيوري، خصمكِ التّالي؟

34
00:03:45,680 --> 00:03:48,530
لا يبدو أنّكِ مُهتمّة بالمُحترفين

35
00:03:48,530 --> 00:03:50,760
لم أسمع به إطلاقاً

36
00:03:50,760 --> 00:03:53,300
المُحترف الوحيد الّذي أعرفه هو غيكيدو

37
00:03:53,300 --> 00:03:55,000
ما الّذي يدفعكِ للتوتُّر إذاً؟

38
00:03:55,260 --> 00:03:57,470
،لا أفقه شيئاً عنه

39
00:03:57,470 --> 00:04:00,300
لكن لقب "لاعب مُحترف" يُخيفني حقّاً

40
00:04:00,300 --> 00:04:03,080
حسناً، أثني على صراحتكِ على الأقلّ

41
00:04:05,930 --> 00:04:10,230
قدّستُ غيكيدو فعلاً

42
00:04:10,230 --> 00:04:14,690
تركَ انطباعاً كبيراً على نفسي، لدرجة
ذكرتُ اسمه دون تشريف

43
00:04:14,690 --> 00:04:16,270
يبدو أنّه تأثير إتشيرو

44
00:04:16,270 --> 00:04:17,890
لا أحد يُطلِق عليه بذلك

45
00:04:20,780 --> 00:04:26,580
شاهدتُه كمُعجبة س.ف 4 في الابتدائيّة
على حساب أنشأه والدايّ لأجلي

46
00:04:26,580 --> 00:04:29,580
كان غيكيدو لاعباً أسطوريّاً بالفعل آنذاك

47
00:04:34,250 --> 00:04:35,920
أنا متأكّدةٌ بأنّكِ مُتحمِّسة إذاً

48
00:04:39,490 --> 00:04:42,580
ستتمكّنين من خوض نِزال
ضدّ الشّخص الّذي تُقدّسينه

49
00:04:42,970 --> 00:04:48,600
خلف هذا الوجه الجامد، لا بُدّ أنّكِ
كتلميذة ابتدائيّة قبل رحلة ميدانيّة

50
00:04:50,520 --> 00:04:52,680
كيف كنتُ لأشعر بطبيعتي القديمة

51
00:04:52,680 --> 00:04:57,730
لو حظيَتْ بفُرصة للّعب ضدّ غيكيدو؟

52
00:05:00,410 --> 00:05:01,880
هذا واضح

53
00:05:06,690 --> 00:05:07,860
وما أدراكِ؟

54
00:05:08,150 --> 00:05:10,370
أنتِ ترتجفين أيضاً

55
00:05:11,820 --> 00:05:13,780
معكِ حقّ

56
00:05:15,790 --> 00:05:16,880
ميو؟

57
00:05:24,650 --> 00:05:28,420
أعتقد لا أستطيع مُواجهة الرّجفة بالرّجفة

58
00:05:28,420 --> 00:05:29,510
بالطّبع لا

59
00:05:31,830 --> 00:05:36,610
رجفة الأعصاب ليست سيّئة إلى هذا
الحدّ في نهاية المطاف

60
00:05:36,610 --> 00:05:37,550
صحيح؟

61
00:05:38,220 --> 00:05:39,900
ستكونين بخير يا ميو

62
00:05:41,710 --> 00:05:44,810
أتتذكّرين عندما تقيّأتِ لأنّكِ كرهتِ
الدّراسة للامتحانات؟

63
00:05:45,070 --> 00:05:47,440
كنتِ ترتجفين أكثر بـ 50 ضعفاً حينها

64
00:05:48,700 --> 00:05:51,840
لا أعتقد بأنّ الأمر دراميّ كما
تُحاولين تصويره

65
00:05:51,840 --> 00:05:55,270
حاولتُ استغلال الأجواء وأستخدم كومبو

66
00:06:09,720 --> 00:06:12,660
هل أتوهّم أم أنّ الازدحام شديد هنا؟

67
00:06:12,370 --> 00:06:13,610
وكأنّنا في حمّام ساونا

68
00:06:13,610 --> 00:06:16,310
الجميع يريدون أن يُشاهدوا غيكيدو يلعب

69
00:06:16,310 --> 00:06:18,540
ماذا؟ إنّه يُواجه فتاة

70
00:06:18,540 --> 00:06:21,360
سأحصل على توقيعه بعد المُباراة

71
00:06:21,990 --> 00:06:25,200
إنّها الدّردشة. لقد بدأت

72
00:06:39,630 --> 00:06:41,630
بداية هادئة

73
00:06:44,390 --> 00:06:46,170
سؤال وجيه

74
00:06:46,170 --> 00:06:48,970
،كلتا الشّخصيّتين تتحرّكان بسرعة

75
00:06:48,970 --> 00:06:54,720
لكن هناك جدلٌ دائم حول مَن لديه أفضليّة
طفيفة بين شخصيّتَي تشون-لي وكامّي

76
00:06:56,190 --> 00:07:00,880
كانت لكمة تشون-لي ممتازة ضدّ
،هجمات كامّي العاديّة

77
00:07:01,210 --> 00:07:04,310
وكانت بمثابة عودة قويّة إذا
،ما نفّذت ضربة مُضادّة

78
00:07:04,310 --> 00:07:08,320
لكن منحت نسخةُ التّصحيح تلك اللّكمة
الخفيفة نطاقَ ضرر أكبر

79
00:07:08,600 --> 00:07:10,470
تريد كامّي أن تستهلّ بهجمة

80
00:07:10,470 --> 00:07:14,150
كيف ستتمكّن تشون-لي من التصدّي لها
بالكيكوشو والاندفاعات؟

81
00:07:14,150 --> 00:07:15,530
هنا يكمن السُّؤال

82
00:07:16,250 --> 00:07:19,490
ما الّذي ينبغي أن أجرّبه للخروج"
"من نِزال سأخسره؟

83
00:07:19,490 --> 00:07:22,510
لم أكن بحاجة حتّى للتّفكير في ذلك آنذاك

84
00:07:25,250 --> 00:07:29,970
اللّاعب الآخر ماهر" كان سبباً كافياً"
وأكثر للّعب ضدّه

85
00:07:31,770 --> 00:07:33,590
استدرجَتِ الخصمَ إلى هجمة مُضادّة للجوّ؟

86
00:07:35,000 --> 00:07:38,720
عند مُواجهة خصم قويّ، لا تتثبّطي

87
00:07:38,720 --> 00:07:40,690
بل اشتعلي حماساً

88
00:07:43,360 --> 00:07:45,020
تلقّت الفتاةُ الضّربةَ الأولى

89
00:07:45,410 --> 00:07:46,780
أنا مُتفاجئ

90
00:07:47,180 --> 00:07:51,390
قفزت من فوق القذيفة، ثمّ حطّتْ
أمام وجهه بهجمة

91
00:07:51,390 --> 00:07:55,740
،عندما مرّتْ هجمةُ تشون-لي المُضادّة للهواء سريعاً
ردّتْ عليها بهجمات إسقاط

92
00:07:56,120 --> 00:07:59,860
بالكاد تمكّنتْ من فعلها وخِداع حتّى غيكيدو-سان

93
00:08:00,270 --> 00:08:03,400
لو لم تكن مُحيطة علماً بهجمة
،تشون-لي المُضادّة للجوّ

94
00:08:03,400 --> 00:08:06,910
،ولم تكن تعلم بحدود نِطاق الضّرر الخاصّ بها
لما تمكّنتْ من فعل ذلك

95
00:08:07,750 --> 00:08:10,620
وهجمات الأوكي خاصّتها على الخصم
عبارة عن رمية. لا شيء مُميّز

96
00:08:10,620 --> 00:08:13,100
،هذا ليس خياراً يُلحق ضرراً كبيراً

97
00:08:13,100 --> 00:08:16,390
لكنّه جيّد لتحسُّس دِفاع خصمها

98
00:08:16,850 --> 00:08:20,020
،بصيغة أُخرى، إنّها تنتقل للوضع الهجوميّ

99
00:08:20,020 --> 00:08:24,140
لكنّها لا تيأس أو تتهوّر لأنّها
في مُواجهة مُحترف

100
00:08:25,360 --> 00:08:28,200
وفوق كُلّ ذلك، تلك النّظرة في وجهها

101
00:08:28,200 --> 00:08:30,810
هذه ليست نظرة شخص يعتقد بأنّه سيخسر

102
00:08:32,600 --> 00:08:35,670
،لا أعرف من تكون فتاة الثّانويّة هذه

103
00:08:35,670 --> 00:08:38,410
لكنّها تعتقد بجدّية بأنّها تستطيع
هزيمة غيكيدو

104
00:08:38,410 --> 00:08:39,700
ينبغي أن يكون هذا مُمتعاً

105
00:08:42,870 --> 00:08:46,500
أيّ أحمق يقلق من الخسارة
قبل أن يُحاول حتّى؟

106
00:08:50,300 --> 00:08:51,640
!فعلتُ ذلك كردّة فعل

107
00:08:51,640 --> 00:08:53,330
فعلتَ ذلك عن طريق الخطأ حتماً

108
00:08:53,570 --> 00:08:55,230
أنت ميّت يا رجل

109
00:08:56,440 --> 00:08:57,630
نِزال عفويّ؟

110
00:08:59,060 --> 00:09:00,390
بالطّبع

111
00:09:00,390 --> 00:09:04,730
انتهت المجموعات الأولى، وبدأت
تُتاح الإعدادات على مهل

112
00:09:06,180 --> 00:09:07,950
—المعذرة

113
00:09:11,410 --> 00:09:13,810
يا لها من صدفة. كيف كانت مُبارياتكِ؟

114
00:09:13,810 --> 00:09:17,750
تبدأ مجموعتي بعد حوالي 40 دقيقة

115
00:09:17,750 --> 00:09:21,780
لذا كنتُ أتجوّل حول القاعة. ماذا عنكِ؟

116
00:09:21,780 --> 00:09:23,390
يترتّب عليّ الانتظار فترة أطول قليلاً

117
00:09:23,820 --> 00:09:26,630
دخلتُ إلى فئة الفائزين من مجموعتي
الثّانية في مُباريتين فقط

118
00:09:28,370 --> 00:09:32,800
إنها تُصوّر الأمر وكأنّه سهل، لكنّها
خرجتْ من مجموعتين دون أي خسارة

119
00:09:33,930 --> 00:09:36,010
عرفتُ بأنّكِ مُذهلة

120
00:09:37,470 --> 00:09:39,630
لطالما الأمر كان هكذا، أليس كذلك؟

121
00:09:39,630 --> 00:09:43,530
مدرسة، بيانو، ألعاب فيديو... أنتِ
ماهرة في كُلّ شيء

122
00:09:44,220 --> 00:09:48,000
ودائماً ما تُساعدينني في الأجزاء
الّتي أُعاني منها

123
00:09:49,140 --> 00:09:55,610
رغم أنّنا في نفس المدرسة، لم أتمكّن
من التكلُّم معكِ كثيراً

124
00:09:56,450 --> 00:09:57,570
...أنا

125
00:10:01,550 --> 00:10:02,860
معكِ حقّ

126
00:10:02,860 --> 00:10:05,140
مضى وقت طويل. لنتكلّم

127
00:10:10,190 --> 00:10:11,970
على الشّاشة

128
00:10:12,920 --> 00:10:14,710
ما الأمر يا تاماكي؟

129
00:10:16,460 --> 00:10:17,840
اجلسي

130
00:10:21,860 --> 00:10:23,150
!أيّ كامي هي هذه؟

131
00:10:23,150 --> 00:10:24,850
قفزتْ عن كثب من جديد

132
00:10:33,820 --> 00:10:35,110
لعِب ممتاز

133
00:10:35,600 --> 00:10:39,000
استُدرِج غيكيدو-سان بهبوط مع هجمة
،أمامه من قبل

134
00:10:39,000 --> 00:10:41,080
لذا انتقلَ من الاستجابة بهجمات
مُضادّة للجوّ

135
00:10:41,080 --> 00:10:45,820
إلى اندفاع سريع مُتموضِع بشكل مثاليّ
والّذي لديه نِطاق ضرر مُرتفع

136
00:10:45,820 --> 00:10:49,390
لكنّها أفلتتْ بركلة جثوم مُتوسِّطة
كما لو أنّها كانت تنتظر ذلك

137
00:10:51,400 --> 00:10:54,120
أجل، سيُقتطَع هذا في فيديو

138
00:10:54,490 --> 00:10:57,080
"غيكيدو ضدّ فتاة ثانويّة غامضة"

139
00:10:57,420 --> 00:11:00,650
أردتُ بثّ نِزال كافيوري-سان أيضاً

140
00:11:00,650 --> 00:11:05,420
لكن إذا كنتُ سأحصل على مقطع بهذه
الجودة، فقد اتّخذتُ القرار الصّائب

141
00:11:12,050 --> 00:11:13,960
شكلان غير مُتوافقين

142
00:11:13,960 --> 00:11:15,320
وكأنّها صورة مُعدَّلة

143
00:11:15,710 --> 00:11:17,260
كم هذا مُزعج

144
00:11:17,730 --> 00:11:24,240
تتلقّى ألعاب القتال كثيراً من الضّجيج
،من صيحة الرّياضة الإلكترونيّة السّخيفة

145
00:11:24,890 --> 00:11:28,740
والآن وصلنا إلى ظهور فتيات مُلاحقات للموضة

146
00:11:29,130 --> 00:11:30,820
"أنا هنا "للقتال

147
00:11:52,630 --> 00:11:58,220
ها أنت ذا من جديد، على وشك
أن تفترض بأنّ هذه الطّفلة لا تُجيد اللّعب

148
00:11:58,220 --> 00:12:01,750
وبأنّها سائحة لعينة تُطارد أحدث الصّيحات

149
00:12:03,270 --> 00:12:04,900
!سأعلّمك كيف تغترّ بنفسك

150
00:12:10,390 --> 00:12:12,540
لا، أنا بخير

151
00:12:15,360 --> 00:12:17,870
لا يهمّ ضدّ مَن أكون

152
00:12:18,330 --> 00:12:21,040
،انتهى المطاف بي في خانات الخاسرين

153
00:12:21,040 --> 00:12:27,360
لكن عليّ شقّ طريقي للخروج من هذه المجموعة
لقضم لقمة أُخرى من ذلك الوغد

154
00:12:28,290 --> 00:12:30,270
...رجلاً كان أو امرأة

155
00:12:30,720 --> 00:12:33,240
سأحطّمكم جميعاً بالتّساوي

156
00:12:35,860 --> 00:12:38,110
توقّعتُ هذا

157
00:12:38,360 --> 00:12:42,500
أنتِ خصمي إذاً، آليس المُلقّبة بالطّفلة
الشّقيّة الصّغيرة؟

158
00:12:42,500 --> 00:12:44,070
مهلاً! ماذا ناديتِني للتو؟

159
00:12:48,090 --> 00:12:50,110
أتطلّع بشوق لنِزالنا

160
00:12:50,720 --> 00:12:52,970
إذاً أنتِ "إينويو"؟

161
00:12:54,050 --> 00:12:55,020
اندحري

162
00:13:11,550 --> 00:13:13,530
استغلَّتِ الإطارَ المنيع للعبور
!باندفاعة شوريو سريعة

163
00:13:13,530 --> 00:13:15,750
!تجاوزتْ تلك القذيفة الأولى

164
00:13:18,180 --> 00:13:19,640
...الفتيات الصّغيرات الشّقيّات

165
00:13:19,640 --> 00:13:21,700
يجب أن يلزمنَ حدودهن

166
00:13:32,070 --> 00:13:33,860
يا له من ضغط هائل

167
00:13:33,860 --> 00:13:35,710
سأتقدّم لتحقيق ضربة

168
00:13:35,930 --> 00:13:39,430
سأتقدّم خطوة واحدة وأنكزها
برأس ركلة الجثوم المُتوسّطة

169
00:13:39,790 --> 00:13:43,160
خطوة واحدة فقط. نكزة واحدة للعصا

170
00:13:43,490 --> 00:13:46,470
مع ذلك أنا خائفة من القيام بذلك

171
00:13:51,230 --> 00:13:52,220
اهدئي

172
00:13:52,930 --> 00:13:55,680
تذكّري ما تمرّنتِ عليه مع الجميع

173
00:13:56,210 --> 00:13:58,850
التحقُّق من سايهاشو بركلة جثوم مُتوسِّطة

174
00:13:59,380 --> 00:14:00,980
ومعرفة متى نُوجّه ضربة مُضادّة

175
00:14:00,980 --> 00:14:03,900
لنستمتع قدر المُستطاع غداً يا تاماتيا

176
00:14:04,290 --> 00:14:10,210
اضغطي الأزرار بإحساس

177
00:14:11,860 --> 00:14:13,820
تحقّقي من الضّربة بإحساس

178
00:14:14,740 --> 00:14:17,300
انتقلي للهجوم بإحساس

179
00:14:17,300 --> 00:14:19,570
نفّذي قَصاصاً سريعاً بإحساس

180
00:14:19,850 --> 00:14:22,010
بإحساس؟

181
00:14:23,540 --> 00:14:24,660
أنا في الزّاوية؟

182
00:14:25,170 --> 00:14:29,440
،كُلّ ذلك التّمرين، وكُلّ تلك النّزالات

183
00:14:29,440 --> 00:14:31,540
وكُلّ تلك الأشياء الجديدة
،الّتي تعلّمتُ فعلها

184
00:14:31,540 --> 00:14:33,760
...كُلّ ذلك التّمرين معهن، ومع ذلك ما زلتُ

185
00:14:37,310 --> 00:14:38,590
...هل يُعقَل أنّه

186
00:14:38,840 --> 00:14:41,060
لم تُحرزي أي تقدُّم إطلاقاً؟

187
00:14:43,450 --> 00:14:45,440
سأطرح عليكِ هذا السّؤال مرّة أُخرى فقط

188
00:14:48,000 --> 00:14:51,210
لماذا ما زلتِ تلعبين ألعابَ القتال؟

189
00:14:51,550 --> 00:14:52,690
...وذلك كي

190
00:14:52,690 --> 00:14:53,910
...أنتِ وأنا

191
00:14:54,310 --> 00:14:55,000
ماذا؟

192
00:14:58,660 --> 00:15:02,400
كنتُ أُحبّ اللّعب معكِ

193
00:15:02,400 --> 00:15:06,130
رأينا نفس الأشياء، وغضِبنا من نفس الأشياء

194
00:15:06,130 --> 00:15:08,360
ولطالما ضحكنا في نفس الوقت

195
00:15:09,170 --> 00:15:14,500
ما زلتُ ألعب ألعابَ القتال لألعب
!مع نفسكِ في ذلك الزّمان

196
00:15:22,280 --> 00:15:23,600
ماذا قلتِ؟

197
00:15:40,980 --> 00:15:42,320
هل كنتِ تحاولين الفوز أصلاً؟

198
00:15:42,960 --> 00:15:44,050
...أختي

199
00:15:44,300 --> 00:15:47,880
يمكنكِ أن تعتزلي. لستِ مُؤهَّلة لألعاب القتال

200
00:15:52,050 --> 00:15:53,420
...أختي

201
00:16:02,200 --> 00:16:03,390
!قَصاص سريع آخر

202
00:16:05,370 --> 00:16:08,040
أشعر بحرارة بيدَي وجسدي

203
00:16:12,840 --> 00:16:15,480
،أعلم بأنّها شخصيّة سريعة

204
00:16:15,480 --> 00:16:19,570
لكن قلّما نرى شخصيّة كامّي
تُهاجم بهذه الخشونة

205
00:16:20,360 --> 00:16:25,760
هذا النّوع من الضّغط يجبرك أيضاً على
الهجوم للخروج من الحصار

206
00:16:25,760 --> 00:16:27,970
ثمّ تستخدم قَصاصاً على تلك الهجمات

207
00:16:28,410 --> 00:16:32,360
لكن غيكيدو-سان لم يكن مكتوف اليدين أيضاً

208
00:16:32,360 --> 00:16:36,820
بينما كان قابعاً يُدافع، اكتسبَ
،كثيراً من المعلومات

209
00:16:36,820 --> 00:16:38,880
مثل كيف ومتى تُهاجم

210
00:16:40,490 --> 00:16:41,600
رقيق وقاسٍ

211
00:16:41,600 --> 00:16:45,490
يتكيّف مع خصمه ويسحقه أخيراً

212
00:16:47,660 --> 00:16:53,700
لهذا السّبب يفوز غيكيدو-سان حتّى في المُباريات
ذات الرّابح في أوّل نِزالين أو 3 نِزالات

213
00:17:11,200 --> 00:17:12,630
غيكيدو-سان؟

214
00:17:21,720 --> 00:17:23,400
...كافيوري

215
00:17:23,400 --> 00:17:27,570
خسر مُباراةً أمام مُثيرة عشوائيّة لا نعرف
!حتّى اسمها كلاعبة

216
00:17:30,710 --> 00:17:33,170
بكلّ تأكيد، أُصِبتُ بصدمة

217
00:17:33,170 --> 00:17:37,450
يُراودني انبطاع بأنّ عدد النّساء الّذين
يُمارسون ألعاب القِتال قد ازداد

218
00:17:37,450 --> 00:17:41,320
رغم هذا، هناك... ذلك النّوع؟

219
00:17:41,630 --> 00:17:47,190
.انسَ المُقاتِلات. بدتْ وكأنّها لا تلعب أبداً
مُهذّبة حسنة التّربية

220
00:17:47,190 --> 00:17:49,280
وتُحيط بها هالة راقية وأنيقة

221
00:17:49,660 --> 00:17:52,250
...كيف سارت المُباراة؟ في الواقع

222
00:17:52,880 --> 00:17:54,720
بدأت بكُرات ناريّة

223
00:17:54,720 --> 00:17:56,260
أجل، هادوكين

224
00:17:56,490 --> 00:17:57,830
...وفي الواقع

225
00:17:57,830 --> 00:17:59,510
ظلّتْ تقذفها باستمرار

226
00:17:59,800 --> 00:18:01,110
!على رسلِك

227
00:18:01,110 --> 00:18:02,970
كم كُرة ناريّة ستقذف؟

228
00:18:02,970 --> 00:18:07,920
،آنذاك، الجميع هناك ظنّوا كذلك
بمن فيهم أنا

229
00:18:07,920 --> 00:18:12,400
.دفعتْ هذه الفتاة بالحظّ لأبعد الحدود"
"رُبّما رَبِحَتْ بشكل تلقائيّ

230
00:18:12,920 --> 00:18:18,510
،استخدم كُرات ناريّة لإغراء الخصم للقفز والاقتراب
ثمّ نضربه بـ شوريوكين

231
00:18:18,510 --> 00:18:21,060
،إنّه أسلوبٌ قديم لتارِكي المسافة

232
00:18:21,060 --> 00:18:23,950
لكن إذا قفز الخصم مُباشرة عند
،إطلاق الكُرة النّاريّة

233
00:18:23,950 --> 00:18:26,690
فلا يمكنك حتّى التصدّي، ناهيك
عن هجمة مُضادّة للجوّ

234
00:18:27,490 --> 00:18:30,890
جوهريّاً، ينبغي أن تكون خائفاً
من قذف كُرات ناريّة

235
00:18:30,890 --> 00:18:33,470
لا أفهم كيف ترميهم هكذا دون قلق

236
00:18:34,270 --> 00:18:36,720
بدأتِ تستفزّينني الآن

237
00:18:38,040 --> 00:18:40,460
لقد قفز. أقصد كافيوري

238
00:18:40,460 --> 00:18:43,510
وكأنّه كان يقول، "بربّكِ. هذا ليس
"آمناً كما تعتقدين

239
00:18:44,010 --> 00:18:45,970
وقد توقّفتْ

240
00:18:45,970 --> 00:18:50,170
،كانت تستخدم هادوكين بإيقاع ثابت
باستثناء في ذلك الوقت

241
00:18:53,780 --> 00:18:56,900
انظر. كافيوري محصور في الزّاوية

242
00:18:56,900 --> 00:18:59,740
كان قد حاصرَها في الزّاوية، ثمّ
هاجمَها من الخلف؟

243
00:19:00,040 --> 00:19:01,370
هل قصدَ فعل ذلك؟

244
00:19:01,370 --> 00:19:02,950
كانت حيلة ما

245
00:19:03,190 --> 00:19:07,870
ما فعلَه كافيوري للتوّ كان قفزة عاديّة
بدتْ وكأنّها هجوم من الخلف

246
00:19:07,870 --> 00:19:12,410
حوّلَتْها هي إلى هجمة حقيقيّة من
الخلف بالمشي للأمام تحتها

247
00:19:12,660 --> 00:19:17,890
وبالتّبادُل مع كافيوري، تمكّنتْ
من حصاره في الزّاوية

248
00:19:18,280 --> 00:19:22,100
قرارها في ذلك الظّرف كان إبداعيّاً

249
00:19:25,900 --> 00:19:27,540
!انظر إليها

250
00:19:30,520 --> 00:19:32,050
هذا غير مُمكن

251
00:19:32,050 --> 00:19:34,480
عدّاد كافيوري يتناقص

252
00:19:34,890 --> 00:19:36,070
،هجماتها المُضادّة للجوّ ممتازة

253
00:19:36,070 --> 00:19:38,770
لكنّها مُذهلة في رمي القذائف أيضاً

254
00:19:39,730 --> 00:19:43,740
"لا يوجد ما يُدعى بـ"مُذهلة في رمي القذائف

255
00:19:43,740 --> 00:19:47,050
أقصد، يمكنك التعلُّم من التّجربة
،عندما يقفز النّاس

256
00:19:47,050 --> 00:19:51,450
أو مقدار أفضليّة الإطار الّذي تحتاجه
لجعل القذيفة آمنة

257
00:19:51,450 --> 00:19:55,770
لكن رمي كُرات ناريّة فقط عندما
لا يقفز خصمك؟

258
00:19:55,770 --> 00:19:58,890
...إذا وُجِدت قدرةٌ كهذه، فأتمنّى أن أمتلك

259
00:19:59,820 --> 00:20:03,380
حاسّةً سادسة أو مهارة غامضة

260
00:20:04,790 --> 00:20:07,750
طاقة الحياة الّتي كانت تبنيها ببطء
بواسطة هادوكين

261
00:20:07,750 --> 00:20:11,230
ستختفي إذا سمحتْ بعبور قفزة واحدة حتّى

262
00:20:12,380 --> 00:20:14,150
لم أستطع الوثوق بنفسي إطلاقاً

263
00:20:15,620 --> 00:20:18,140
لم تكن تشتكي لأحد بشكل خاصّ

264
00:20:18,140 --> 00:20:22,330
غريزتها، وحاسّتها السّادسة، أخبراها
،بأنّ قفزةً كانت قادمة

265
00:20:22,330 --> 00:20:25,780
.لكن سمحتْ للمنطق بالتغلُّب على ذلك
هذا ما بدا عليه الأمر

266
00:20:26,270 --> 00:20:31,540
أعتقد بأنّها تتعامل مع س.ف 6 بشكل
مُختلف تماماً عن مُعاملتي

267
00:20:31,540 --> 00:20:33,740
وحينئذ قد أدركتُ ذلك

268
00:20:35,000 --> 00:20:36,210
هجمة الأوكي قد نجحت

269
00:20:36,210 --> 00:20:37,960
...ركلات البرق المئة الهوائيّة المُنخفضة

270
00:20:37,960 --> 00:20:39,110
!إلى إسقاط آخر

271
00:20:40,280 --> 00:20:41,260
!يا للهول

272
00:20:41,550 --> 00:20:43,920
يستخدم أوكي تِلو الأوكي

273
00:20:43,920 --> 00:20:45,020
—التّالية ستكون قاتلة

274
00:20:48,510 --> 00:20:49,760
ماذا؟

275
00:20:50,370 --> 00:20:53,220
أجل، ركلة جثوم مُتوسِّطة عكسيّة

276
00:20:53,220 --> 00:20:59,120
أعتقد بأنّها استقرأت بأنّ كافيوري كان
سيصطنع أوكيزيمي ويتراجع

277
00:20:59,120 --> 00:21:01,030
،في المُباريات المُصنَّفة العاديّة

278
00:21:01,030 --> 00:21:06,590
دائماً اللّاعبون الّذين يبدون أغبياء
من يكشفون هذا الأمر

279
00:21:06,590 --> 00:21:12,200
لذا يُقال بأنّ كثيراً من النّاس يفقدون هدوءَهم
غريزيّاً حالما يرون ذلك

280
00:21:14,370 --> 00:21:16,460
كلاهما عزّزا العدّاد الخارق لديهما لأقصى حدّ

281
00:21:16,460 --> 00:21:19,290
يبدو أنّ حركة خارقة واحدة
كفيفة بقتل أحدهما

282
00:21:19,530 --> 00:21:23,370
،لكن لم يبقَ لدى الفتاة سوى جزء من السّحر
وعدّاد الدرايف لديها مُنخفض

283
00:21:23,370 --> 00:21:27,090
إنّ التصدِّي في س.ف 6 يُنقص
عدّاد درايف الخاص بك

284
00:21:27,090 --> 00:21:31,100
إذا بلغَ الصّفر، فإنّها ستتلقّى ضرراً
مُباشراً يؤثّر على الصحّة بدلاً من ذلك

285
00:21:31,400 --> 00:21:34,920
لذا إذا جعلَها كافيوري تتصدّى لركلة
،جثوم مُتوسِّطة أو ما شابه

286
00:21:34,920 --> 00:21:36,800
فيمكنه أن يلحق ضرراً بها حتّى الموت
بحركة خارقة ويربح

287
00:21:37,090 --> 00:21:42,480
سمِّيه ما شئتِ يا طفلة، يمكنني القول
بأنّني اتّخذتُ قراراً حكيماً

288
00:21:42,480 --> 00:21:45,030
عندما قرّرتُ اتّخاذك على محمل الجدّ

289
00:21:46,680 --> 00:21:47,650
انتهى الأمر

290
00:22:03,690 --> 00:22:04,800
لم أفعل ذلك