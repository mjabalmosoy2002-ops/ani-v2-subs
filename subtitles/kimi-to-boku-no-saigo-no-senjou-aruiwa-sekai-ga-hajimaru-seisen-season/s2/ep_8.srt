1
00:00:01,850 --> 00:00:03,690
كان ذلك ثقيلاً جدّاً

2
00:00:04,040 --> 00:00:09,370
هذا يحثّني دوماً على الرّغبة في التنمّر
على فتاة صغيرة محميّة كهذه

3
00:00:09,740 --> 00:00:12,740
وها أنا ذي، وُلِدتُ في ميدان مليء
،بدُخان البارود

4
00:00:12,740 --> 00:00:15,250
بالكاد أنجو من خلال شرب ماء وحليّ

5
00:00:15,250 --> 00:00:17,510
وأُخاطر بحياتي في ساحة المعركة

6
00:00:18,330 --> 00:00:20,760
لكن ليس هُم

7
00:00:21,350 --> 00:00:23,760
الإمبراطوريّة اضطهدت السّاحرات؟

8
00:00:24,020 --> 00:00:28,290
كلّا. السّاحرات هُنّ مَن يستخففن بالنّاس

9
00:00:29,630 --> 00:00:32,270
!هذا مُغيظ للغاية

10
00:00:45,340 --> 00:00:50,370
هذا مُطمئن! كان من المُفترض
أن أتبنّاكِ حيّة

11
00:00:50,780 --> 00:00:54,120
يسرّني أنّكِ على قيد الحياة يا صغيرة

12
00:00:54,120 --> 00:00:59,950
هذا... مؤلم... لماذا... أنا... دماء؟

13
00:01:02,570 --> 00:01:09,460
،كنتُ أتساءل أين كانت شارتكِ النّجميّة
لكنّها داخل عينيك

14
00:01:11,270 --> 00:01:15,100
العمّ أون، فهمتُ الآن

15
00:01:16,100 --> 00:01:19,000
لا شيء حميد يأتي من الحروب

16
00:01:19,500 --> 00:01:22,170
أيُعقَل هذا؟ هذا مُؤلم للغاية

17
00:01:22,170 --> 00:01:24,910
ماذا؟ هل تُغيّرين مفهومكِ؟

18
00:01:25,900 --> 00:01:29,130
،أجل، لنُوقف هذه الحرب

19
00:01:29,500 --> 00:01:32,620
!بإبادة الجيش الإمبراطوريّ بأكمله

20
00:01:32,620 --> 00:01:35,160
لن أُبدي رحمة بعد الآن

21
00:01:35,160 --> 00:01:36,900
رحمة؟

22
00:01:37,260 --> 00:01:43,110
ألستِ مغرورة بعض الشّيء؟
نجوتِ من ضربة واحدة فقط

23
00:01:43,110 --> 00:01:46,590
في المرّة المُقبلة الّتي تسمعين فيها طلقاً
ناريّاً، سينتهي الأمر

24
00:01:46,590 --> 00:01:50,180
أجل، سينتهي الأمر بالنّسبة لكم جميعاً

25
00:01:58,830 --> 00:01:59,620
!ماذا؟

26
00:02:04,110 --> 00:02:11,420
،هذا مؤسف جدّاً. لو ضغطتُ الزناد في وقت أسبق
لقضيتُ عليك تماماً

27
00:02:11,870 --> 00:02:15,540
هذا لأنّني لستُ معتادة على هذا

28
00:02:15,980 --> 00:02:19,330
أنتم الإمبراطوريّون عجيبون

29
00:02:19,750 --> 00:02:22,700
لا تنفكّون تُعاملوننا بازدراء، بنعتنا
بالسّاحرات والشّياطين

30
00:02:22,700 --> 00:02:25,340
مع ذلك، أنتِ بحدّ ذاتكِ تستخدمين
الأرواح النّجميّة خلف الكواليس

31
00:02:25,650 --> 00:02:29,320
مهلاً، تصبّ غضبك على الشّخص الخطأ

32
00:02:29,320 --> 00:02:30,380
ماذا؟

33
00:02:30,380 --> 00:02:32,300
...فأساساً، تجاربنا الرّوحيّة النّجميّة

34
00:02:32,300 --> 00:02:36,700
ما كانت لتنجح لولا مُساعدة عائلتكم الملكيّة

35
00:02:37,200 --> 00:02:40,420
،كنّا نعلم بوجود خائن بين أفراد العائلة الملكيّة

36
00:02:40,800 --> 00:02:43,080
لكن أُرحّب بأي معلومة تُريدين مُشاركتها

37
00:02:43,610 --> 00:02:45,770
بئساً، كم أنت بليد

38
00:02:45,770 --> 00:02:48,110
سأخبرك إذا استطعت هزيمتي

39
00:02:48,110 --> 00:02:52,530
من المُؤكّد أنّك تعي هذا من دون أن تدفعني
لقول عبارة تافهة كهذه؟

40
00:02:52,530 --> 00:02:56,620
المعذرة. لم يكن ذلك طبعي

41
00:02:57,070 --> 00:02:59,580
الجيل الرّابع من خيوط الكوكب

42
00:03:00,020 --> 00:03:02,150
هذا غير موجود في السّلطنة

43
00:03:02,150 --> 00:03:05,080
إنّه نوع جديد وُلِد داخل دوّامة الإمبراطوريّة

44
00:03:06,830 --> 00:03:10,070
أنا واثقة بأنّك تريد كلّ الأسرار
الّتي بداخل رأسي

45
00:03:10,070 --> 00:03:14,470
لهذا لن تتمكّن من مُغادرة هذه المنطقة

46
00:03:14,470 --> 00:03:16,890
،عندما تطلب منّي حسناء شيئاً

47
00:03:17,480 --> 00:03:20,060
فلن يكون من المُهذّب رفض طلبها

48
00:03:20,050 --> 00:03:23,570
لا أكره تصرّفاتك المُصطنعة

49
00:03:23,570 --> 00:03:27,960
لكن أُفضّل أكثر رؤية وجهك

50
00:03:27,960 --> 00:03:31,900
فأنا أرى بوضوح طبيعتك القاسية القبيحة
تُشعّ من خلف قناعك

51
00:03:31,900 --> 00:03:34,140
شيطانيّ الهالة

52
00:03:34,140 --> 00:03:36,330
لا أعرف ما الّذي تتحدّثين عنه

53
00:03:36,330 --> 00:03:39,560
!سوف أخلعه بالقوّة

54
00:03:41,710 --> 00:03:43,820
أتطلّع قُدماً لذلك

55
00:03:49,380 --> 00:03:50,560
ماذا؟

56
00:03:50,560 --> 00:03:53,750
،لن يأخذ أي ضرر جسديّ منك

57
00:03:53,750 --> 00:03:56,550
لكن يُمكن أن يُعرقل الأمور جسديّاً

58
00:03:56,550 --> 00:03:59,470
يبدو أنّك تتبجّح بحصانتك

59
00:03:59,470 --> 00:04:02,110
هذا ما أفعله بالضّبط

60
00:04:02,110 --> 00:04:04,560
هذه هي روح الخطيئة النّجميّة

61
00:04:11,380 --> 00:04:15,360
إذا قضيتُ عليك، ألن تزول خطيئتي أيضاً؟

62
00:04:15,960 --> 00:04:20,290
ستتكاثر خطيئتك بلا نهاية

63
00:04:21,940 --> 00:04:22,910
خذها

64
00:04:23,580 --> 00:04:25,250
تخلّيتَ عن ذراعك

65
00:04:26,080 --> 00:04:27,960
إنّها اصطناعيّة على أي حال

66
00:04:29,740 --> 00:04:30,880
ماذا؟

67
00:04:30,880 --> 00:04:35,480
إنّ "هجومك الثّاني" هو أكثر بؤساً حتّى

68
00:04:35,480 --> 00:04:37,590
خطيئتك ستبتلعك بالكامل

69
00:04:45,730 --> 00:04:48,480
قنبلة ضدّ نجميّة؟

70
00:04:48,710 --> 00:04:51,260
،قد لا تأخذ ضرراً جسديّاً

71
00:04:51,260 --> 00:04:54,650
لكنّها تُحدِث ضرراً للرّوح النّجميّة الفعليّة، أليس كذلك؟

72
00:04:55,390 --> 00:04:59,770
رأيتُ روحك النّجميّة. سأستهدفها تالياً

73
00:05:00,930 --> 00:05:03,290
هل تعتقد بأنّني سأدعك تفلت؟

74
00:05:13,960 --> 00:05:17,720
!اللّعنة عليك أيّها الجنديّ الإمبراطوريّ

75
00:05:22,720 --> 00:05:24,820
...لكن لن تفلت

76
00:05:24,820 --> 00:05:33,690
روح الخطيئة النّجميّة سوف تتبعك
حتّى آخر هذه الدّولة

77
00:05:38,360 --> 00:05:41,470
!لا تدوسي على هذا الثّلج

78
00:05:41,470 --> 00:05:43,920
جين، ما-ما الأمر؟

79
00:05:44,330 --> 00:05:46,210
هل أنتِ بخير؟

80
00:05:46,210 --> 00:05:48,370
—أجل. ما الّذي

81
00:05:49,220 --> 00:05:51,910
قرصَني هذا الثّلج

82
00:05:52,850 --> 00:05:56,650
!سيكون هذا أشبه بالسّير على كومة إبر

83
00:05:56,960 --> 00:05:59,900
كيف لي أن أكون الوحيد الّذي
تعرّض للعضّ؟

84
00:05:59,900 --> 00:06:03,260
...ماذا؟ في الواقع

85
00:06:04,410 --> 00:06:07,000
بعض الأشياء الّتي تمّ إنشاؤها
بواسطة الفنّ النّجميّ

86
00:06:07,000 --> 00:06:10,410
يمكن أن تستجيب بطريقة مُعيّنة اعتماداً على
فيما إذا كان يمتلك المرء طاقة نجميّة أم لا

87
00:06:10,410 --> 00:06:13,610
على سبيل المثال، الأبواب والمصاعد
...في القصر الملكيّ

88
00:06:13,610 --> 00:06:16,060
بئساً، انسَ ما قلتُه من فضلك

89
00:06:16,060 --> 00:06:17,680
استمرّي

90
00:06:17,680 --> 00:06:22,220
هذا الثّلج سيعضّ أيّ شخص
لا يمتلك شارة نجميّة

91
00:06:22,220 --> 00:06:24,000
زعيمة، أنتِ التّالية

92
00:06:24,000 --> 00:06:30,360
!توقّعت! أنت تُجهِد قائدتك كثيراً

93
00:06:30,360 --> 00:06:33,880
أنتِ تبلين حسناً يا زعيمة. استمرّي
في ركل الثّلج جانباً

94
00:06:33,880 --> 00:06:35,960
والآن يترتّب علينا التّعامل معهم فحسب

95
00:06:43,980 --> 00:06:45,910
!جين

96
00:06:45,910 --> 00:06:50,020
جين، من هنا! الغرفة الأخيرة
!في الخلف فارغة

97
00:06:50,330 --> 00:06:53,200
نيني، اتبعي خُطوات الزّعيمة

98
00:06:53,200 --> 00:06:54,760
لا تلمسي الثّلج

99
00:06:54,760 --> 00:06:55,590
!حسناً

100
00:07:01,190 --> 00:07:03,660
أنتِ عجوز عنيدة

101
00:07:03,660 --> 00:07:07,230
هذا هو عالم الثّلج

102
00:07:07,230 --> 00:07:14,040
يا للعجب! يمكنني رؤية المسارات الّتي
خلّفتموها أثناء الهرب منّي بوضوح

103
00:07:14,690 --> 00:07:16,090
لا تُصدري صوتاً

104
00:07:18,090 --> 00:07:19,590
افعلوها

105
00:07:22,380 --> 00:07:24,840
اسحقوا الجنود الإمبراطوريّين

106
00:07:24,840 --> 00:07:29,930
وحدها الآنسة سيسبيل سوف... سوف... ماذا؟

107
00:07:33,100 --> 00:07:34,700
أين هي؟

108
00:07:35,460 --> 00:07:37,870
خلفك يا عجوز

109
00:07:38,180 --> 00:07:40,970
لم نكن نختبئ في الغرفة الأخيرة

110
00:07:40,970 --> 00:07:43,110
كنّا في الغرفة الّتي قبلها

111
00:07:43,110 --> 00:07:45,510
!الغرفة الأخيرة في الخلف فارغة

112
00:07:46,560 --> 00:07:49,250
!لكن كانت هناك آثار أقدام

113
00:07:49,890 --> 00:07:51,570
تراجعنا أدراجنا

114
00:07:51,990 --> 00:07:55,310
،تركنا آثار أقدام كلّ المسافة إلى الغرفة الخلفيّة

115
00:07:55,310 --> 00:07:59,370
ثمّ عدنا ومشينا فوق نفس آثار
أقدامنا للعودة إلى الغرفة قبلها

116
00:08:00,040 --> 00:08:03,130
!جنود إمبراطوريّون أوغاد

117
00:08:03,470 --> 00:08:06,100
استهنتِ بقائد الجيش الإمبراطوريّ

118
00:08:08,800 --> 00:08:13,140
هـ-هل نحن بأمان الآن؟

119
00:08:15,160 --> 00:08:18,870
.هذا ليس وقت الشّعور بالأمان
!يجب أن ننزل للطّابق السّفليّ بسرعة

120
00:08:19,510 --> 00:08:20,570
!أجل-
!أجل-

121
00:08:20,800 --> 00:08:23,780
حسناً، أستأذن الآن

122
00:08:24,130 --> 00:08:25,240
ماذا؟

123
00:08:25,240 --> 00:08:28,680
يُهاجَم القصر بواسطة الجيش الإمبراطوريّ

124
00:08:28,680 --> 00:08:31,810
سيبدو مشبوهاً إذا غاب كبير
العائلة لفترة طويلة

125
00:08:31,810 --> 00:08:33,650
أبليت حسناً

126
00:08:35,570 --> 00:08:39,250
لكن، أنجزنا مهمّتنا

127
00:08:39,660 --> 00:08:43,690
ماذا يعني بذلك؟ وصل إلى سيسبيل بالفعل؟

128
00:08:44,070 --> 00:08:46,380
أم أنّه يمزح؟

129
00:08:46,380 --> 00:08:47,940
أتعتقد بأنّني سأدعك تفلت؟

130
00:08:50,560 --> 00:08:51,680
ماذا؟

131
00:08:51,680 --> 00:08:53,070
غريزة قويّة

132
00:08:58,460 --> 00:09:02,400
معك حقّ، هذا ليس فنّي النّجميّ

133
00:09:02,400 --> 00:09:06,700
...ما هذه الظّاهرة؟ رأيتُها في مكان ما

134
00:09:07,910 --> 00:09:14,010
قبل لحظات قليلة، تكلّمتُ مع ساحرة
هربتْ من السّجن

135
00:09:14,010 --> 00:09:15,240
ساحرة؟

136
00:09:15,240 --> 00:09:17,590
فتاة تعرفها أيضاً

137
00:09:17,590 --> 00:09:18,820
ماذا؟

138
00:09:19,670 --> 00:09:22,180
،نلت منّا مرّة من قبل

139
00:09:22,180 --> 00:09:27,430
لكن من الخطأ أن تعتقد بأنّ غرفة حَجر
بهدف التّحقيق يمكن أن تحتويها

140
00:09:27,430 --> 00:09:33,660
فهي لم تعُد بشريّة. إنّها ساحرة حقيقيّة

141
00:09:34,270 --> 00:09:38,170
قوّة جذب؟ ساحرة؟ جاذبيّة؟

142
00:09:38,170 --> 00:09:39,210
!أيُعقَل ذلك؟

143
00:09:39,210 --> 00:09:42,820
وداعاً يا تلميذ القدّيس الرّومانسيّ

144
00:09:44,530 --> 00:09:45,090
—ما

145
00:09:46,100 --> 00:09:47,530
فيشيسواز

146
00:09:48,520 --> 00:09:52,280
المدفع الخارق: رصاصة سحر الجثّة

147
00:09:58,520 --> 00:09:59,380
ماذا؟

148
00:10:03,940 --> 00:10:08,520
ما... ماذا حدث؟

149
00:10:08,840 --> 00:10:12,740
زعيمة. عندما قلتُ بأنّ علينا التوجُّه
،إلى الطّابق السّفليّ

150
00:10:12,740 --> 00:10:15,240
لم أقصد تفجير القصر بأكمله

151
00:10:15,240 --> 00:10:16,900
!لم أكن أنا

152
00:10:16,900 --> 00:10:18,890
أعلم ذلك

153
00:10:18,890 --> 00:10:20,650
كانوا الهيدرا غالباً

154
00:10:21,680 --> 00:10:23,300
أين هي؟

155
00:10:26,320 --> 00:10:27,320
ماذا؟

156
00:10:34,190 --> 00:10:37,040
أمسكتُ بسيسبيل

157
00:10:37,280 --> 00:10:38,900
!سيسبيل

158
00:10:38,900 --> 00:10:42,880
ماذا؟ ما زال هناك جنوداً إمبراطوريّين؟

159
00:10:43,200 --> 00:10:44,210
!سيسبيل-ساما

160
00:10:47,600 --> 00:10:49,010
!أعيديها

161
00:10:49,380 --> 00:10:52,800
!حمقاء! إنّها كنز دولتنا الأعظم

162
00:10:53,410 --> 00:10:59,260
لديّ أنباء سيّئة لكم. سيّدتكم لن تعود أبداً

163
00:10:59,260 --> 00:11:03,810
!اصمتي! أفلتي سيسبيل-ساما أيّتها الوحش

164
00:11:03,810 --> 00:11:06,100
!حمقاء، لا تفعلي

165
00:11:06,100 --> 00:11:09,070
!أعيدي سيسبيل-ساما إلينا

166
00:11:15,780 --> 00:11:18,340
!مؤلم

167
00:11:18,340 --> 00:11:20,330
!أمزح فحسب

168
00:11:25,490 --> 00:11:27,700
لديك وجه ظريف كهذا

169
00:11:27,700 --> 00:11:31,840
الأفضل لعائلة لو. يعرفون كيف يختارون بعناية

170
00:11:31,840 --> 00:11:34,890
هذا يحثّني على سحق وجهكِ

171
00:11:35,950 --> 00:11:37,100
...تـ-توقّفي

172
00:11:37,340 --> 00:11:40,650
!لا، لن أتوقّف

173
00:11:41,800 --> 00:11:42,970
!فيشيسواز

174
00:11:45,650 --> 00:11:47,980
!إيسكا

175
00:11:47,980 --> 00:11:50,190
!أنت! كيف نجوت؟

176
00:11:50,190 --> 00:11:53,870
!في لحظة الانفجار، حرّرتُ موجة تاليسمان

177
00:11:54,800 --> 00:11:59,810
!تأخّرت سبع ثوانٍ أيّها الفارس الشُّجاع

178
00:12:01,580 --> 00:12:03,720
إلى اللّقاء يا تلميذ القدّيس

179
00:12:06,290 --> 00:12:06,920
!سيسبيل-ساما

180
00:12:07,260 --> 00:12:09,460
!توقّفي! فات الأوان

181
00:12:09,460 --> 00:12:11,510
!أفلتني أيّها الجنديّ الإمبراطوريّ

182
00:12:11,510 --> 00:12:15,540
ما فائدتنا كخادمات إذا لم نستطع
حماية سيسبيل-ساما؟

183
00:12:16,170 --> 00:12:17,970
سنذهب لإنقاذها

184
00:12:17,970 --> 00:12:18,860
ماذا؟

185
00:12:18,860 --> 00:12:21,830
عكيم جميعاً أن تهربوا من هذا القصر
وتذهبوا للاختباء

186
00:12:22,540 --> 00:12:24,810
ولِمَ علينا أن نثق بك؟

187
00:12:24,810 --> 00:12:27,980
!اختُطِفت سيسبيل-ساما أمام أعيننا

188
00:12:29,190 --> 00:12:31,660
أنتِ من تمّ أسره كرهينة

189
00:12:32,380 --> 00:12:37,170
لماذا برأيكِ نادى إيسكا باسمها
لصرف انتباهها؟

190
00:12:37,170 --> 00:12:41,150
كان وجهكِ ليُسحَق لولاه

191
00:12:44,680 --> 00:12:48,720
سنسترجع سيسبيل. أعدك

192
00:12:51,960 --> 00:12:55,220
يمكنكِ أن تقتليني إذا لم أفِ بوعدي

193
00:12:55,220 --> 00:12:56,050
!ماذا؟

194
00:12:56,050 --> 00:12:59,780
لا أستطيع التطرُّق للتّفاصيل، لكن
أتينا إلى السّلطنة

195
00:12:59,780 --> 00:13:02,930
بنيّة حماية سيسبيل، حتّى لو
كلّفنا ذلك أرواحنا

196
00:13:03,460 --> 00:13:07,460
إذا أردتم حمايتها، فافعلوا ما أقوله رجاء

197
00:13:12,020 --> 00:13:14,300
يجب أن نذهب. القصر ينهار

198
00:13:14,300 --> 00:13:15,210
!بسرعة

199
00:13:15,210 --> 00:13:17,320
!حـ-حسناً

200
00:13:17,730 --> 00:13:21,740
سأُفلت يدكِ إذا وعدتِني أن تفعلي
ما أُمليه عليكِ

201
00:13:23,790 --> 00:13:26,820
سأفعل، في هذه اللّيلة فقط

202
00:13:28,760 --> 00:13:32,840
إذا كان هذا يعني أن نسترجع سيسبيل-ساما

203
00:13:42,730 --> 00:13:45,240
!رين، ما الّذي يؤخّرك؟

204
00:13:45,730 --> 00:13:47,880
مضى وقت طويل

205
00:13:49,150 --> 00:13:50,280
!آليس-ساما

206
00:13:51,060 --> 00:13:53,370
رين؟! يسرّني أنّكِ بخير

207
00:13:53,680 --> 00:13:55,610
هل الجرحى بأمان؟

208
00:13:55,610 --> 00:13:59,370
أجل! يتلقّون علاجاً في ملجأ لو

209
00:14:02,720 --> 00:14:05,660
!آليس-ساما، هناك تلميذ قدّيس في قاعة الملكة

210
00:14:05,660 --> 00:14:06,630
!ماذا؟

211
00:14:10,430 --> 00:14:17,320
آليس، أنا واثقة بأنّكِ تعتقدين أنّكِ تستطيعين
حماية كلّ شيء ما دمتِ هناك

212
00:14:18,010 --> 00:14:21,410
وبأنّكِ تستطيعين طرد الجيش الإمبراطوريّ
وحماية الملكة

213
00:14:21,820 --> 00:14:24,410
لديكِ روح قويّة تمدّكِ بتلك الثّقة

214
00:14:25,060 --> 00:14:28,100
لديكِ روح لطيفة لشعبنا

215
00:14:28,100 --> 00:14:31,940
،إذا كان هذا يعني حماية السّلطنة

216
00:14:31,940 --> 00:14:37,120
فلديكِ قوّة قمع عواطفكِ والقتال بلا رحمة

217
00:14:37,940 --> 00:14:40,730
كلّ هذه سِمات جيّدة بالفعل

218
00:14:41,410 --> 00:14:42,560
لكن هذا لن ينفع

219
00:14:43,500 --> 00:14:46,800
طريقتكِ تُنشئ جنّة للأقوياء فقط

220
00:14:48,710 --> 00:14:53,320
مبادئكِ لا يدعمها إلّا قوّتك

221
00:14:54,010 --> 00:14:57,120
لا يمكنكِ إنقاذ كلّ السّحرة النّجمييّن هكذا

222
00:14:58,290 --> 00:15:02,140
دعيني أتكلّم باسم الجميع الّذين
...لم يُنعَموا بروح نجميّة قويّة

223
00:15:03,010 --> 00:15:06,110
سأحرق هذه الجنّة المُزيّفة بالكامل

224
00:15:07,850 --> 00:15:12,020
احفري هذا في ذاكرتكِ واغرقي
في اليأس يا آليس

225
00:15:12,770 --> 00:15:16,670
حالما أُقتَل بواسطة الجيش الإمبراطوريّ

226
00:15:22,780 --> 00:15:24,120
!ماذا؟

227
00:15:30,980 --> 00:15:34,700
انتظر يا جدّي. سأتعامل مع هؤلاء
!الجنود الإمبراطوريّين بنفسي

228
00:15:35,710 --> 00:15:38,760
إذا كانت شوكة الفتاة الصّغيرة
،لا تنجح على ذلك الشّيء

229
00:15:38,760 --> 00:15:45,390
فلا بُدّ أنّها طاقة نجميّة صرفة
لا تتلقّى ضرراً جسديّاً

230
00:15:45,840 --> 00:15:48,150
أليس كذلك يا نيمليس-تشان؟

231
00:15:49,290 --> 00:15:53,020
إنّه تجسيد صُنِع بواسطة روح الخطيئة النّجميّة

232
00:15:53,020 --> 00:15:55,270
باختصار، يبدو أنّه لا يُقهَر

233
00:15:55,270 --> 00:15:57,920
ماذا؟ فقدت ذِراعك اليسرى؟

234
00:15:58,240 --> 00:15:59,990
سأنال منه في المرّة المُقبلة

235
00:16:03,300 --> 00:16:08,310
إذاً تدخّل الجدّ لإنقاذ حفيدته الصّغيرة الظّريفة؟

236
00:16:09,050 --> 00:16:11,460
سوف أبكي

237
00:16:14,800 --> 00:16:17,640
أكرهك حقّاً

238
00:16:19,840 --> 00:16:22,490
كيسينغ، يجب أن تعودي فوراً

239
00:16:23,150 --> 00:16:24,340
العمّ أون؟

240
00:16:25,200 --> 00:16:27,370
حدث شيء غير مُتوقَّع

241
00:16:27,370 --> 00:16:30,410
سأتوقّف وأعود كذلك

242
00:16:30,410 --> 00:16:31,690
...ماذا

243
00:16:31,690 --> 00:16:35,050
إيليتيار مُتوجّهة إلى قاعة الملكة

244
00:16:35,700 --> 00:16:38,560
ماذا؟ هذا مستحيل

245
00:16:38,560 --> 00:16:41,690
إنّها عديمة الجدوى. لا تستطيع القتال حتّى

246
00:16:41,690 --> 00:16:44,030
لماذا تُغادر تحت هذا الظّرف؟

247
00:16:44,270 --> 00:16:49,620
معكِ حقّ. أنا أيضاً ظننتُ بأنّها
سوف تخلي إلى الملجأ

248
00:16:52,580 --> 00:16:57,630
كان مِنجلاً هوائيّاً يستطيع تقطيع طائرات
الجيش الإمبراطوريّ إلى نصفين

249
00:16:58,220 --> 00:17:00,500
كيف لا تزال على قيد الحياة؟

250
00:17:01,930 --> 00:17:04,840
هكذا إذاً، يا لها من روح مُفيدة

251
00:17:05,540 --> 00:17:08,260
،هجوم شنيع مُناسب لسُلالة المُؤسّس

252
00:17:08,260 --> 00:17:10,400
وتردّ الهجمات مُستهدفة نقاط ضعفك

253
00:17:10,400 --> 00:17:12,140
ولديها تشكيلة من الوظائف

254
00:17:13,330 --> 00:17:15,980
سألتُك كيف لا تزال حيّاً

255
00:17:17,140 --> 00:17:18,230
لأنّ هذا هو أنا

256
00:17:18,820 --> 00:17:20,230
في المرّة المُقبلة، سأقطعكِ

257
00:17:20,500 --> 00:17:23,260
لا تروقني طريقتك في النّظر إليّ

258
00:17:23,260 --> 00:17:26,220
بحسب خبرتي، هذه ليست نظرة جيّدة

259
00:17:26,590 --> 00:17:30,160
لذا أريدك أن ترحل، وتتوه داخل
شواهد قبور الرّياح

260
00:17:30,520 --> 00:17:33,790
الأثر: إله عالم الرّياح، ماندالا

261
00:17:35,910 --> 00:17:38,370
أسأتِ الحكم عليّ، كما توقّعت

262
00:17:39,580 --> 00:17:43,130
تتفادى رياحكِ أيّ شيء له طاقة نجميّة

263
00:17:43,130 --> 00:17:45,010
هذا لتجنٌّب أذيّة شعبكِ

264
00:17:45,310 --> 00:17:46,930
يمثّل هذا سقوطكِ

265
00:17:46,930 --> 00:17:50,970
!هل تعني بأنّك الخائن؟

266
00:17:50,970 --> 00:17:56,940
هذا صحيح. خنتُكِ من أجل تغيير هذا البلد

267
00:17:57,320 --> 00:17:59,310
كنتُ أعرفكِ

268
00:17:59,310 --> 00:18:03,690
لكن لم تعتبريني سوى جنديّ عدوّ

269
00:18:03,690 --> 00:18:05,110
!هذا هو الفرق

270
00:18:07,180 --> 00:18:10,120
هذه نقطة تحوُّل تاريخيّة

271
00:18:24,300 --> 00:18:28,980
...أ-أ-أ-أمّي... اهربي

272
00:18:34,980 --> 00:18:37,320
...إ-إيليتيار

273
00:18:43,000 --> 00:18:47,600
إيليتيار؟ أمّي؟

274
00:18:51,490 --> 00:18:53,330
سقطت هذه الدّولة

275
00:18:54,950 --> 00:18:55,950
...هذا مستحيل

276
00:18:58,700 --> 00:19:02,770
تلميذ القدّيس؟ لا، إنّه غير مُهمّ

277
00:19:03,590 --> 00:19:04,870
كنتُ رقيقة جدّاً

278
00:19:05,720 --> 00:19:09,050
لهذا لم أستطع حماية أمّي أو إيليتيار

279
00:19:09,880 --> 00:19:13,970
كان ينبغي أن أعلم. الإمبراطوريّون
يجب أن يُدمَّروا

280
00:19:14,270 --> 00:19:16,010
هل أنتِ التّالية؟

281
00:19:16,760 --> 00:19:19,610
!أنتم الإمبراطوريّون

282
00:19:20,260 --> 00:19:23,640
هذا الهواء المُجمِّد... لا بُدّ أنّكِ
ساحرة كارثة الجليد

283
00:19:23,640 --> 00:19:26,990
أجل، هذا صحيح. ساحرة

284
00:19:27,400 --> 00:19:30,950
سوف أُجمّد كلّ مدينة في الإمبراطوريّة

285
00:19:31,260 --> 00:19:32,780
!بما في ذلك أنت

286
00:19:32,780 --> 00:19:34,920
!آليس-ساما، توقّفي

287
00:19:35,910 --> 00:19:38,000
أنتِ لا تستوعبين الوضع جيّداً

288
00:19:38,330 --> 00:19:41,630
أسرتُ نقيّة دم. سوف أعود

289
00:19:41,630 --> 00:19:48,000
!اصمت أيّها الإمبراطوريّ! لن تعود سليماً

290
00:19:48,810 --> 00:19:49,800
حقّاً؟

291
00:19:51,090 --> 00:19:54,990
،إنّه يهرب؟ هناك معبر خفيّ في الخلف

292
00:19:54,990 --> 00:19:58,770
لكن لا يُفتَح ما لم يلمسه أحدٌ
من سُلالة المُؤسّس

293
00:19:58,770 --> 00:20:00,080
لدي مفتاح

294
00:20:08,060 --> 00:20:11,900
أنت! كيف تجرؤ على استخدام
!أختي كمُجرّد أداة

295
00:20:12,430 --> 00:20:14,020
سوف أستفيد منها

296
00:20:16,350 --> 00:20:17,470
!أمّي

297
00:20:18,140 --> 00:20:20,410
!رين، كيف حال أُمّي؟

298
00:20:20,910 --> 00:20:23,750
الجرح في ذراعها اليسرى قد وصل عظمها

299
00:20:24,850 --> 00:20:27,320
تحتاج عمليّة خياطة جراحيّة فوراً

300
00:20:29,340 --> 00:20:34,350
رين، تولّي هذا الأمر. افعلي
ما ترين بأنّه الأفضل

301
00:20:36,480 --> 00:20:37,530
...آليس-ساما

302
00:20:39,570 --> 00:20:40,700
لن أدعه يفلت

303
00:20:43,790 --> 00:20:46,020
!لن أدعه يأخذ أختي

304
00:20:50,590 --> 00:20:53,150
!آليس-ساما، اصعدي من فضلكِ

305
00:20:53,150 --> 00:20:54,400
!وارفيك

306
00:20:54,800 --> 00:20:58,480
أرسلتْ رين لي قائلة بأنّ المركبة
ستكون ضروريّة للمُطاردة

307
00:20:58,480 --> 00:21:01,910
!قرار حكيم! قُد بأقصى سرعة

308
00:21:01,910 --> 00:21:02,990
!حسناً

309
00:21:10,060 --> 00:21:14,130
!أسرع من فضلك! جرح إيليتيار خطير

310
00:21:14,590 --> 00:21:17,550
...أعي ذلك، لكن

311
00:21:20,990 --> 00:21:22,490
سأستغلّ الوقت وأشرح

312
00:21:22,950 --> 00:21:26,520
سنوقف تلك السيّارة، ثمّ نتوجّه
إلى المشفى مباشرة

313
00:21:26,520 --> 00:21:27,760
حسناً

314
00:21:28,120 --> 00:21:31,420
...لكن إذا فات الأوان كثيراً بالنّسبة لإيليتيار

315
00:21:31,800 --> 00:21:33,860
فيجب علينا العودة إلى القصر فوراً

316
00:21:34,900 --> 00:21:37,190
تريدين العودة إلى الملكة

317
00:21:40,030 --> 00:21:44,690
لا، سأسحق أي جنديّ إمبراطوريّ مُتبقٍّ

318
00:21:47,870 --> 00:21:49,160
عُلِم

319
00:22:00,920 --> 00:22:03,020
!آليس-ساما، تمسّكي جيّداً

320
00:22:09,380 --> 00:22:10,310
!بسرعة

321
00:22:10,310 --> 00:22:11,010
!حسناً

322
00:22:14,770 --> 00:22:15,940
!لا

323
00:22:20,940 --> 00:22:22,840
هل كان هذا فخّاً أيضاً؟

324
00:22:24,130 --> 00:22:27,210
...أوهمنا وكأنّه كان يحمل إيليتيار، لكن

325
00:22:33,000 --> 00:22:38,380
آليس-ساما، استيقظي أرجوكِ

326
00:22:39,170 --> 00:22:40,810
...آليس-ساما

327
00:22:44,980 --> 00:22:46,070
وارفيك...؟

328
00:22:46,590 --> 00:22:49,350
يسرّني... أنّكِ بخير

329
00:22:56,200 --> 00:22:58,970
هل حميتني؟

330
00:23:02,090 --> 00:23:03,960
!سأحضر المُساعدة حالاً

331
00:23:04,770 --> 00:23:08,950
رين، أرسلي فريقاً طبّياً إلى
!هنا في أسرع وقت

332
00:23:09,210 --> 00:23:12,200
آليس-ساما؟ سأُرسلهم نحوكِ فوراً

333
00:23:12,610 --> 00:23:13,790
أعتمد عليكِ

334
00:23:26,120 --> 00:23:27,260
!لماذا يحدث هذا؟

335
00:23:28,140 --> 00:23:30,440
كان من المُفترَض أن أنقذ الجميع

336
00:23:32,430 --> 00:23:37,830
...أمّي، إيليتيار، حتّى وارفيك

337
00:23:39,360 --> 00:23:40,260
...لكن

338
00:23:43,850 --> 00:23:44,790
لا شيء

339
00:23:47,190 --> 00:23:50,170
!يسير لصالحي

340
00:23:52,350 --> 00:23:54,930
،أخمدتُ النّيران في القصر

341
00:23:54,930 --> 00:23:58,330
،وسارعتُ إلى قاعة الملكة لحماية أمّي

342
00:23:59,250 --> 00:24:04,500
ثمّ طاردتُ السيّارة إلى هنا لإعادة إيليتيار

343
00:24:07,900 --> 00:24:10,670
لكن ينتهي كلّ شيء بالفشل

344
00:24:17,760 --> 00:24:19,730
،في هذه اللّحظة الحاسمة جدّاً

345
00:24:20,300 --> 00:24:25,420
لماذا لا أستطيع إنقاذ حتّى شخص واحد؟

346
00:24:27,220 --> 00:24:32,180
الجيش الإمبراطوريّ... لا، الإمبراطوريّون
!وكلّ شيء آخر

347
00:24:33,310 --> 00:24:39,920
!إن كانت هذه نيّتكم، فلن أُسامحكم أبداً

348
00:24:41,490 --> 00:24:42,840
حضّروا أنفسكم

349
00:24:43,370 --> 00:24:47,530
!فسوف أنتقم بشكل قاطع وأكيد

350
00:24:48,320 --> 00:24:49,190
!آليس؟

351
00:24:53,950 --> 00:24:54,890
...آليس

352
00:24:57,120 --> 00:24:58,590
إيسكا...؟