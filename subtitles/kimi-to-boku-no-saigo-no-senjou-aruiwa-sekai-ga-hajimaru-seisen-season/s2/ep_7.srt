1
00:00:26,440 --> 00:00:31,670
لقد انتابني هذا الحدس. شيء
بسيط كان يؤرقني

2
00:00:31,950 --> 00:00:34,850
كانت فيشيسواز إحدى أوراقنا الرّابحة

3
00:00:35,180 --> 00:00:39,760
قليل من النّاس، حتّى من عائلتَي
لو وزوا، يستطيعون إيقافها

4
00:00:40,150 --> 00:00:42,600
لم أتوقّع أبداً أن تفشل

5
00:00:42,990 --> 00:00:46,350
هل يجدر بك أن تقول هذا
الكلام لي أنا؟

6
00:00:46,350 --> 00:00:49,650
هل كنت أنت من هزمها؟

7
00:00:49,650 --> 00:00:52,570
يا أحد تلاميذ القدّيس الحادي عشر السّابق؟

8
00:00:52,960 --> 00:00:55,240
لن أُجيب عن هذا

9
00:00:55,670 --> 00:00:58,820
لهذا راودني شعور سيّئ حيال هذا

10
00:00:59,060 --> 00:01:04,460
لهذا أرسلتُ مغتالاً آخر، لكن
يبدو أنّه لم يصل إلى هنا بعد

11
00:01:05,000 --> 00:01:06,000
مغتال؟

12
00:01:06,000 --> 00:01:12,630
لكن كلّ شيء على ما يُرام. يجب أن أعود
إلى القصر الملكيّ قريباً على أيّ حال

13
00:01:12,630 --> 00:01:14,260
—فاليوم هو يوم هائل

14
00:01:16,290 --> 00:01:19,850
كنتُ لا أزال أتكلّم

15
00:01:19,850 --> 00:01:21,120
لا أُبالي

16
00:01:30,760 --> 00:01:34,430
سيكون من الخطير السّماح لك بالاقتراب أكثر

17
00:01:36,480 --> 00:01:37,990
النّسر العظيم

18
00:01:43,990 --> 00:01:45,500
!ستُسحَق ذراعي

19
00:01:48,300 --> 00:01:50,920
تفاديتَ قبل أن أتمكّن من الإمساك بك

20
00:01:50,920 --> 00:01:54,300
تمتلك خبرة كبيرة بالنّسبة لشابّ صغير

21
00:01:54,730 --> 00:01:58,930
مُدمِّر قضى وقتاً طويلاً في ساحة المعركة

22
00:02:10,790 --> 00:02:14,280
إذا تحرّكتُ في نفس الوقت، يمكنني
!القفز أسرع من الأمواج

23
00:02:14,620 --> 00:02:19,450
نادراً ما أرى جنديّاً إمبراطوريّاً لا يستعمل
—سلاحاً ناريّاً، لكن هناك

24
00:02:19,450 --> 00:02:21,120
ثمّة حاجز هناك، أليس كذلك؟

25
00:02:23,950 --> 00:02:27,000
ماذا رأيت؟

26
00:02:27,270 --> 00:02:28,250
الحدس

27
00:02:29,540 --> 00:02:32,160
تلاميذ القدّيس جديرون بالإعجاب حقّاً

28
00:02:32,160 --> 00:02:37,760
فرد يستطيع التفوُّق على مجموعة
في عصرنا هذا هو مصدر إزعاج

29
00:02:39,440 --> 00:02:42,140
كنتُ أنتظر شخصاً مثلك

30
00:02:45,950 --> 00:02:50,840
الموجة هي طول موجيّ لطاقة حركيّة
قد اكتسبَتْ قيمة اتّجاهيّة

31
00:02:50,840 --> 00:02:55,090
إنّها الصّفة المادّية الّتي تُنشئ الكتلة والتّسارع

32
00:02:55,090 --> 00:02:57,570
هذا شيء يجب عليك معرفته

33
00:02:57,790 --> 00:02:58,490
!ماذا؟

34
00:02:58,490 --> 00:03:04,330
لا ينبغي لك أن تُصنّف كافّة السّحَرة
النّجميّين في نفس التّصنيف

35
00:03:08,920 --> 00:03:13,890
يستطيع إلحاق كلّ هذا الضّرر عن طريق
التِحام بسيط بقبضته؟

36
00:03:15,040 --> 00:03:17,330
المُستبدّ الشّرس، تاليسمان

37
00:03:17,800 --> 00:03:22,320
رغم أنّ هذا الّقب بعيد
عن نواياي الحقيقيّة

38
00:03:23,270 --> 00:03:26,280
يبدو أنّ هذا يُلائمك

39
00:03:28,970 --> 00:03:31,980
كمُكافأة على إيصالها إلى
،إلى القصر بسام

40
00:03:31,980 --> 00:03:34,620
حصلنا على مُلصَق يستطيع إخفاء
الشّارة النّجميّة للزّعيمة

41
00:03:35,070 --> 00:03:37,410
تغدو هذه مهمّة مُميتة

42
00:03:37,410 --> 00:03:39,640
!هـ-هل قلت شيئاً؟

43
00:03:39,640 --> 00:03:40,900
إطلاقاً

44
00:03:40,900 --> 00:03:44,540
ألا يمكنكِ فعل شيء بقوّتكِ
النّجميّة يا سيسبيل؟

45
00:03:44,910 --> 00:03:47,120
كقذفَ الجميع بعيداً؟

46
00:03:47,120 --> 00:03:50,580
ما كنتُ لأستأجر حارساً شخصيّاً
لو كنتُ أستطيع فعل ذلك؟

47
00:03:50,950 --> 00:03:54,790
لكن ربّما يمكنني كسب بعض
الوقت لأنفسنا للهرب

48
00:03:54,790 --> 00:03:59,120
أيّتها النُّجوم، اكشفي لي ماضيكِ

49
00:03:59,650 --> 00:04:00,580
!ماذا؟

50
00:04:03,890 --> 00:04:07,340
ما-ما رأيكم؟ تمكّنتُ من خداعهم

51
00:04:07,340 --> 00:04:10,680
أجل، ستنجح في المرّة الأولى

52
00:04:10,930 --> 00:04:14,860
على أيّ حال، يجب أن نُغادر القصر
وإلّا سنُحاصَر

53
00:04:15,310 --> 00:04:18,170
هل هناك غرفة في الطّابق الثّاني
يمكننا القفز منها؟

54
00:04:19,260 --> 00:04:23,000
أجل، ربّما غرفة الضّيوف في
زاوية الطّابق الثّاني

55
00:04:23,480 --> 00:04:25,170
أليس البرد قارساً هنا يا نيني؟

56
00:04:25,170 --> 00:04:27,170
أنا بردانة يا قائدة

57
00:04:28,090 --> 00:04:29,030
ماذا؟

58
00:04:29,030 --> 00:04:33,790
وجدتُكم أيّها الجنود الإمبراطوريّون
والآنسة سيسبيل

59
00:04:37,920 --> 00:04:44,300
هربتُم قبل قليل، لكن لا يمكنكم الهرب
لمدّة طويلة ومعكم الآنسة سيسبيل

60
00:04:44,540 --> 00:04:48,250
يا جدّة. أنتِ مُلِحّة حقّاً، أليس كذلك؟

61
00:04:48,740 --> 00:04:51,440
ينبغي للعجائز أن يغطّوا في النّوم
في مثل هذا الوقت

62
00:04:52,100 --> 00:04:55,420
أتمنّى لو أفعل ذلك

63
00:04:55,420 --> 00:04:59,030
سئمتُ من مُطاردتكم

64
00:04:59,030 --> 00:05:01,820
سلِّموني الآنسة سيسبيل

65
00:05:01,820 --> 00:05:03,320
أرفُض

66
00:05:04,030 --> 00:05:04,880
!هيّا بنا

67
00:05:04,880 --> 00:05:05,740
!حسناً-
حسناً-

68
00:05:07,620 --> 00:05:09,830
!أيّها الصّعاليك

69
00:05:09,830 --> 00:05:11,800
!أ-أعدادها كثيرة

70
00:05:12,150 --> 00:05:13,490
!تجاهلي ذلك يا زعيمة

71
00:05:16,490 --> 00:05:21,960
أشعر وكأنّه يتمّ اصطيادنا. لا يجدر بها
أن تستهين بنا كثيراً

72
00:05:21,960 --> 00:05:27,880
حوّلتُ طاقة الموجة إلى تسارُع مادّي

73
00:05:28,350 --> 00:05:32,700
أي ساحر نجميّ بهذا النّوع من الرّوح
النّجميّة يستطيع فعل ذلك

74
00:05:34,080 --> 00:05:36,440
أيّ ساحر؟ أنت تكذب

75
00:05:36,780 --> 00:05:38,340
يتطلّب هذا تدريباً

76
00:05:47,240 --> 00:05:51,030
كما توقّعتُ تماماً، ليست السّرعة
الأوّليّة هي ما يجعله سريعاً

77
00:05:51,300 --> 00:05:53,510
تسارعه غير عاديّ

78
00:05:53,510 --> 00:05:56,080
!إنّها تُعزَّز بواسطة الرُّوح النّجميّة للأمواج

79
00:06:02,110 --> 00:06:04,550
تحويل الأمواج المادّي

80
00:06:04,860 --> 00:06:10,260
.استغرقتُ ستّ سنوات لإنشاء هذه التّقنيّة
وثمان سنوات أُخَر لإتقانها

81
00:06:10,260 --> 00:06:13,040
ثلاثة عشر سنة للوصول إلى هذا القصر

82
00:06:13,040 --> 00:06:17,980
.استغرقتُ قرابة الثّلاثين عاماً
لستُ بتلك المهارة

83
00:06:20,350 --> 00:06:24,400
لكن لا يمكنك الوصول إلى هذا
المستوى بعقليّة عاديّة

84
00:06:25,160 --> 00:06:31,030
هل تفهم ما أحاول قوله يا تلميذ
القدّيس الصّغير؟

85
00:06:31,030 --> 00:06:32,870
!لا أستطيع حتّى تفاديها؟

86
00:06:32,870 --> 00:06:38,870
نحن مُتشابهان. نسلك طريقَ إراقة
الدّمء ونطمح لإتقان القوّة العُظمى

87
00:06:42,060 --> 00:06:48,340
.مع الأسف، أنا أكبر سنّاً وأكثر خبرة
يمكنك أن تُلاحظ الفرق

88
00:06:48,340 --> 00:06:49,840
انتظر

89
00:06:49,840 --> 00:06:51,090
ماذا؟

90
00:06:54,300 --> 00:06:56,750
ظننتُك تلقّيت ضربة مُباشرة

91
00:06:56,750 --> 00:06:58,770
أجل

92
00:06:58,770 --> 00:07:00,990
إذاً كيف لا تزال تستطيع النُّهوض؟

93
00:07:01,420 --> 00:07:06,320
لو لم أحرّر الفنَّ النّجميّ، لكنتُ هالكاً

94
00:07:08,310 --> 00:07:12,390
جميل! مُجرّد مُواجهتك تجعل
بدني يقشعرّ

95
00:07:12,390 --> 00:07:14,880
خصم مُرعب بالفعل

96
00:07:14,880 --> 00:07:17,120
هذه عبارتي أنا أيّها المحتال

97
00:07:17,560 --> 00:07:22,380
كم هذا مُحبِط. لم أتوقّع أبداً
أن أخسر من حيث السّرعة

98
00:07:22,690 --> 00:07:25,630
لم أشعر باستفزاز كهذا في حياتي من قبل

99
00:07:25,940 --> 00:07:27,950
يا له من مسرح عظيم

100
00:07:27,950 --> 00:07:33,880
بُني هذا القصر على تلّة، لذا
لا بُدّ أنّ شروق الشّمس جميل

101
00:07:33,880 --> 00:07:38,310
أنت عجول قليلاً، أليس كذلك؟
ما زلنا في مُنتصف اللّيل

102
00:07:38,680 --> 00:07:41,520
لهذا يجب أن أشهد ذلك

103
00:07:41,520 --> 00:07:46,600
ستكون اللّيلة آخر مرّة يسطع
فيها النّجم، لو

104
00:07:46,600 --> 00:07:49,320
اللّيلة الطّويلة ستمضي أخيراً

105
00:07:49,750 --> 00:07:52,150
هل تقصد بأنّ الملكة ستسقط؟

106
00:07:53,550 --> 00:07:58,700
لا أستطيع قول كلام كهذا، لكنّك ذكيّ
لأنّك فهمت ما قلتُه بتلك الطّريقة

107
00:07:58,700 --> 00:08:00,450
ثمّ ماذا؟

108
00:08:00,710 --> 00:08:06,130
أليس هذا واضحاً؟ عندما تنتهي اللّيلة المُرصّعة
بالنّجوم، يطلع الصّباح

109
00:08:06,130 --> 00:08:10,630
ستكون بداية عالم جديد

110
00:08:11,430 --> 00:08:15,330
سوف أقضي عليك. اغربي عن وجهي

111
00:08:16,260 --> 00:08:17,470
مُخيف

112
00:08:19,900 --> 00:08:24,230
فهمت. هذه روح نجميّة على هيئة نجم
تُشوّش المادّة

113
00:08:24,230 --> 00:08:26,020
أليس كذلك يا آنسة؟

114
00:08:26,520 --> 00:08:29,780
هل تعتقدين بأنّ هذا سيُنقذ حياتكِ؟

115
00:08:30,330 --> 00:08:34,120
سمعتُ بأنّ الأرواح النّجميّة ذات الجيل
الثّاني المولودة من أعماق الكوكب

116
00:08:34,120 --> 00:08:36,790
تمنح مالكيها عادةً شارة أرجوانيّة اللّون

117
00:08:36,790 --> 00:08:38,120
دعيني أرى ذلك

118
00:08:38,390 --> 00:08:40,220
مع الأسف، أنا فتاة

119
00:08:40,870 --> 00:08:43,250
لا أنوي أن أُريكِ جسدي

120
00:08:44,320 --> 00:08:51,590
فاة؟ كلام غير مُلائم يصدر عن ساحرة
دمويّة كما لو أنّكِ بشريّة

121
00:08:52,920 --> 00:08:55,820
لطالما أردُ عيّنة من نقيّ دماء

122
00:08:55,820 --> 00:08:58,640
،سأكتشف مكان شارتكِ النّجمية

123
00:08:58,640 --> 00:09:02,800
بتمزيق فستانكِ الجميل هذا

124
00:09:05,360 --> 00:09:09,360
مُبهر. كما أخبرني العمّ أون

125
00:09:09,360 --> 00:09:12,370
الجنود الإمبراطوريّون مُتوحّشون

126
00:09:13,200 --> 00:09:14,860
هذا جيّد

127
00:09:14,860 --> 00:09:19,430
يمكنني فعل أشياء فظيعة
دون مُبالاة للعالم

128
00:09:21,530 --> 00:09:23,790
اختفوا أيُّها الجنود الإمبراطوريّون

129
00:09:30,850 --> 00:09:34,510
ما رأيكِ أن أعلّمكِ درساً قاسياً
بنثرات زُجاج يا آنسة؟

130
00:09:41,190 --> 00:09:44,410
استخدمَتْ دفاعي التّلقائيّ الخاصّ
...بروحها النّجميّة لصالحها

131
00:09:44,890 --> 00:09:50,600
،كم هذا سخيف. تبدو روحكِ النّجميّة قويّة
لكنّكِ فتاة صغيرة معزولة

132
00:09:50,600 --> 00:09:54,240
جهلكِ بألعاب العقل يجعلكِ أدنى من ساحرة

133
00:09:54,240 --> 00:09:56,070
أنتِ مُجرّد دُمية

134
00:09:56,070 --> 00:09:57,030
اقتلوها

135
00:09:58,520 --> 00:10:01,780
لا تستهيني بسليلة المُؤسّس

136
00:10:01,780 --> 00:10:02,770
!مستحيل

137
00:10:02,770 --> 00:10:05,430
!هل تصدّتْ لكافّة الرّصاص؟

138
00:10:05,430 --> 00:10:09,880
حتّى عائلتي لو وهيدرا لا يملكون
سيطرة زو على القوّة النّجميّة

139
00:10:09,880 --> 00:10:12,080
كانت زلّة لسان

140
00:10:12,080 --> 00:10:16,270
حذّرني العمُّ أون أّخبر أحداً بهذا

141
00:10:18,530 --> 00:10:21,780
إعصار الملك المُدمَّر"، تفعيل"

142
00:10:23,060 --> 00:10:25,560
—أيّتها الأشواك! مزّقي تلك المرأة إلى

143
00:10:24,800 --> 00:10:30,180
ألم أخبركِ؟ سأريكِ سبب تلقيبهم لي
"بـ"العاصفة المُستديمة

144
00:10:30,770 --> 00:10:33,730
يبدو أنّها لحظة الوداع يا ساحرتي الصّغيرة الظّريفة

145
00:10:40,900 --> 00:10:42,920
أوّلاً، اسمحي لي بالتّعبير عن امتناني

146
00:10:42,920 --> 00:10:48,110
قدرُ هذا الكوكب جلبَ لنا ضيفاً رائعاً

147
00:10:50,930 --> 00:10:51,780
ماذا؟

148
00:10:52,210 --> 00:10:54,090
بئساً، كان ذلك وشيكاً

149
00:10:54,090 --> 00:10:56,820
هكذا ستسير الأمور إذاً؟

150
00:10:57,240 --> 00:11:00,550
هل تتذكّر جنديّة إمبراطوريّة تُدعى ميسميس؟

151
00:11:00,550 --> 00:11:01,980
ميسميس؟

152
00:11:01,980 --> 00:11:06,830
.إنّها قائدة من الجيش الإمبراطوريّ
التقيتَها في وادي ميدور

153
00:11:06,830 --> 00:11:09,170
تلك الّتي ركلتَها إلى داخل الدوّامة

154
00:11:09,770 --> 00:11:15,410
انضممنا في نفس الوقت، لذا
سمعتُ عنك الكثير

155
00:11:15,410 --> 00:11:20,280
أتذكّر الآن. تلك الآنسة الصّغيرة

156
00:11:20,620 --> 00:11:24,910
،فهمت. إن كنتُما مُتّصلتين هكذا
يصبح كلّ شيء منطقيّاً

157
00:11:25,170 --> 00:11:30,050
لكن يا لها من مُفاجأة. صديقتكِ
،بمستوى قائد

158
00:11:30,050 --> 00:11:32,690
لكن ترقّيتِ إلى تلميذة قدّيس؟

159
00:11:32,690 --> 00:11:34,630
في الواقع، أجل

160
00:11:34,630 --> 00:11:39,930
سمعتُ أنّ الجيش الإمبراطوريّ يتمتّع بروح
التّنافُس عندما يتعلّق الأمر بالتّصنيف

161
00:11:40,740 --> 00:11:43,080
لا بُدّ أنّ كثيراً من النّاس يغارون منكِ

162
00:11:43,470 --> 00:11:48,410
أنا معتادة على ذلك. فأساساً، هذه هي المرّة
الرّابعة الّتي أكون فيها في 22 من العمر

163
00:11:48,810 --> 00:11:55,980
،حقّاً؟ عوضاً عن آنسة صغيرة موهوبة
أنتِ مُخضرمة قديمة إذاً

164
00:11:56,510 --> 00:11:59,150
!لا، لا! أنا آنسة صغيرة

165
00:11:59,150 --> 00:12:03,350
سياستي هي البدء من جديد
قبل بلوغي الثّلاثين

166
00:12:03,350 --> 00:12:06,590
أنا الآن، آنسة مُتفتّحة بالكامل

167
00:12:08,990 --> 00:12:18,000
حسناً إذاً، الحَواريّون العُظماء الثّمانيّة
منحوني حصّة من أنقياء الدّم للقبض عليهم

168
00:12:18,000 --> 00:12:20,510
جنديّ إمبراطوريّ يستخدم فنّاً نجميّاً؟

169
00:12:22,200 --> 00:12:26,640
اسمح لي أن أقيس عمق خطيئتك

170
00:12:29,840 --> 00:12:32,500
هل هذا تجسيد للطّاقة النّجميّة؟

171
00:12:32,500 --> 00:12:38,000
هذا مُجسِّد. ارتكبتَ خطيئة

172
00:12:38,000 --> 00:12:41,320
أمستْ تلك الخطيئة عقوبتك

173
00:12:41,320 --> 00:12:45,920
الهجوم الطّائش قد أصبح يُمثّل سقوطك

174
00:12:47,120 --> 00:12:52,650
هل يمكنك الإفلات من عقوبتك؟

175
00:12:52,650 --> 00:12:53,830
عقوبة؟

176
00:12:55,080 --> 00:12:57,170
مع الأسف، لا أنوي طلب الغفران

177
00:12:58,640 --> 00:12:59,840
مُزعج

178
00:13:03,280 --> 00:13:05,090
مصدر للإزعاج

179
00:13:09,260 --> 00:13:14,990
لا جدوى. هذا المُجسِّد حصين
أمام الهجمات اجسديّة

180
00:13:15,740 --> 00:13:18,050
روح نجميّة مُضادّة للهجمات؟

181
00:13:18,590 --> 00:13:22,040
تنمو الطّاقة النّجميّة استجابةً للعدوّ

182
00:13:23,010 --> 00:13:27,990
عندما تبلغ نقطة مُعيّنة، فإنّها تتّخذ
هيئة وحش وتُهاجم

183
00:13:28,420 --> 00:13:34,920
...شرط نموّها هو أن ألحِق ضرراً بك
وأمر آخر

184
00:13:35,390 --> 00:13:40,710
هناك شروط عديدة. شيء يمكنك
"أن تُشير إليه كـ"خطيئة

185
00:13:41,950 --> 00:13:45,610
أثني عليك. أنت قريب جدّاً

186
00:13:45,610 --> 00:13:48,110
سأخبرك بأمر

187
00:13:48,110 --> 00:13:52,470
هذا المُجسّد سوف ينمو بلا نهاية

188
00:13:52,470 --> 00:13:54,790
...روح نجميّة قبيحة

189
00:13:54,790 --> 00:13:58,850
قدرتها على المرور من خلال الأشياء
المادّية ستُمثّل موتك

190
00:14:09,300 --> 00:14:13,500
مُت مع روحك النّجميّة أيّها الشّيطان

191
00:14:18,250 --> 00:14:21,540
كما توقّعتُ تماماً. يختبئون
!في الظّلام لمُهاجمتنا

192
00:14:25,590 --> 00:14:27,070
أيُعقَل هذا؟

193
00:14:27,070 --> 00:14:31,060
آليس-ساما! لا نعلم أين يختبئ
الجنود الإمبراطوريّين

194
00:14:31,560 --> 00:14:32,470
كوني حذرة رجاء

195
00:14:33,330 --> 00:14:35,560
!أنتِ بأمان يا آليس-ساما

196
00:14:35,920 --> 00:14:38,810
أخبراني بما تعرفانه عن الوضع

197
00:14:38,810 --> 00:14:42,670
حاضر! الدّفاع عن قصر مملكتنا
هو أولويّتنا الأُولى

198
00:14:43,150 --> 00:14:47,250
!آليس-ساما، أسرعي رجاء
!توجّهي إلى الملكة

199
00:14:47,760 --> 00:14:49,620
سنتعامل مع النّيران

200
00:14:50,480 --> 00:14:52,410
!لا، توقّفا

201
00:14:56,700 --> 00:14:59,910
!أنتما! رين، أين الأدوات الإسعافيّة؟

202
00:14:59,910 --> 00:15:01,020
!بسرعة

203
00:15:01,020 --> 00:15:01,680
!حاضرة

204
00:15:07,780 --> 00:15:10,830
رين، خذي الجميع إلى الملجأ

205
00:15:11,160 --> 00:15:13,300
ينبغي أن يتواجد أطبّاء هناك

206
00:15:13,720 --> 00:15:15,600
سأنتظر هنا

207
00:15:16,210 --> 00:15:18,630
...لكن يا آليس-ساما

208
00:15:19,600 --> 00:15:21,120
أنا هادئة

209
00:15:21,850 --> 00:15:23,530
أظنّني هادئة

210
00:15:24,590 --> 00:15:31,200
.ينبغي أن تُحمَى القلعة جيّداً
هذه المنطقة هي أكثر ما تضرّر

211
00:15:35,240 --> 00:15:40,000
سأخمد النّيران، لذا عودي
!بعد 15 دقيقة

212
00:15:40,260 --> 00:15:42,620
!أمرك

213
00:15:47,670 --> 00:15:49,740
،حتّى لو تأخّرتُ دقيقة

214
00:15:49,740 --> 00:15:52,910
توجّهي إلى قصر الملكة بمفردكِ
!رجاء يا آليس-ساما

215
00:15:54,440 --> 00:15:58,260
لا عليكِ. لم أتّخذ القرار الخاطئ

216
00:15:59,270 --> 00:16:04,260
حتّى تلميذ قدّيس لا يستطيع الوصول
قصر الملكة خلال فترة قصيرة كهذه

217
00:16:04,980 --> 00:16:07,270
!اسمعوا جميعاً

218
00:16:07,270 --> 00:16:08,910
!سوف أخمد الحريق دُفعة واحدة

219
00:16:08,910 --> 00:16:12,560
!هذا خطير، لذا قِفوا خلفي فوراً

220
00:16:15,010 --> 00:16:19,580
أوّلاً، ضربوا خزّانات الوقود
في مخزن الحجر الصّحّي

221
00:16:19,580 --> 00:16:22,110
،إذا نشبَ حريقٌ ضخمٌ باستخدام ذلك الوقود

222
00:16:22,110 --> 00:16:26,350
فحتّى نخبة القصر سيُواجهون
صعوبة في إخماده

223
00:16:27,060 --> 00:16:30,570
يسرّني أنّ الهجوم قد نجح

224
00:16:33,030 --> 00:16:36,090
!إيليتيار-ساما! إيليتيار-ساما

225
00:16:36,090 --> 00:16:41,700
.الشّيء الوحيد المُتبقّي هو دور السيّد تاليسمان
آمل أن يكون قد قبض على سيسبيل

226
00:16:36,350 --> 00:16:39,700
تعرّضنا لكمين بواسطة الجيش
!الإمبراطوريّ! أخلي فوراً

227
00:16:39,700 --> 00:16:43,230
!إيليتيار-ساما، يجب أن تُسرعي

228
00:16:43,540 --> 00:16:44,600
...حضرة الوزير

229
00:16:44,600 --> 00:16:47,550
!أ-أمرك يا إيليتيار-ساما؟ تعالي بسرعة

230
00:16:47,550 --> 00:16:49,640
لا داعي للقلق

231
00:16:49,640 --> 00:16:50,760
ماذا؟

232
00:16:51,270 --> 00:16:54,170
أخلِ المكان وتوجّه إلى الملجأ أوّلاً

233
00:16:54,670 --> 00:16:58,640
،لا بُدّ أنّ العدوّ يستهدف قصرَ الملِكة
لذا ابقَ بعيداً

234
00:16:59,230 --> 00:17:02,470
لا حاجة لإصابة غير القتاليّين

235
00:17:02,470 --> 00:17:04,830
لـ-لكن ماذا ستفعلين أنتِ يا إيليتيار-ساما؟

236
00:17:04,830 --> 00:17:07,760
سأذهب إلى هناك لاحقاً

237
00:17:11,000 --> 00:17:15,190
أرجوكِ، أرجوكِ كوني بخير يا إيليتيار-ساما

238
00:17:18,030 --> 00:17:22,890
والآن... أتساءل ما إن تمكّن تلاميذ القدّيس
من الوصول إلى قصر الملكة

239
00:17:22,890 --> 00:17:25,910
لا أُفضّل أن يتأذّى كثير من النّاس

240
00:17:25,910 --> 00:17:29,740
سأكون سعيدة إذا استطاعوا
القضاء على الملِكة بسرعة

241
00:17:30,230 --> 00:17:33,850
ينبغي أيضاً أن أحضّر نفسي

242
00:17:35,130 --> 00:17:38,460
...آليس، سيسبيل، أمّي

243
00:17:38,930 --> 00:17:42,380
لن تفهمنَني غالباً

244
00:17:43,260 --> 00:17:47,960
هذه هي طريقتي في تطهير السّلطنة

245
00:17:47,960 --> 00:17:52,170
الملِكة نيبوليس. لا أنوي استغراق وقتي

246
00:17:52,560 --> 00:17:53,840
،لذلك

247
00:17:54,800 --> 00:17:56,550
موتي هنا والآن

248
00:17:56,550 --> 00:17:57,690
!اسقط في حفرة الجحيم

249
00:18:04,250 --> 00:18:09,700
،الرّياح الهادئة، ميلّا. على نقيض الاسم
فنّكِ النّجميّ عدوانيّ

250
00:18:10,290 --> 00:18:13,530
كان ذلك قبل عقد من الزّمن

251
00:18:14,370 --> 00:18:16,690
ميلّافير لو نيبوليس الثّامنة

252
00:18:16,970 --> 00:18:21,530
،ساحرة نجميّة بروح نجميّة تُدعى الهواء
فرع عن الرّياح

253
00:18:22,080 --> 00:18:27,000
،تتحكّمين بالهواء عينه على نِطاق أوسع
عوضاً عن الرّياح فحسب

254
00:18:27,550 --> 00:18:29,950
كان عمركِ 11 سنة عندما دخلتِ ساحة المعركة

255
00:18:29,950 --> 00:18:34,310
في السّنوات العشر منذ ذلك الحين، خضتِ
معاركَ أكثر من أي نقيّ دماء آخر

256
00:18:34,310 --> 00:18:37,760
مُسيطرة على 3% من منطقة العدوّ

257
00:18:38,330 --> 00:18:39,780
،رغم كونكِ ساحرة

258
00:18:39,780 --> 00:18:43,930
كنتِ مُمارِسة الفنون القتاليّة والمغتالة
الأمهر في السّلطنة

259
00:18:43,930 --> 00:18:47,890
كنتِ المُرشَّحة الأقوى للملِكة في التّاريخ

260
00:18:48,130 --> 00:18:50,810
لكن أصبحتِ أضعف

261
00:18:51,210 --> 00:18:56,530
تتكلّمين عن الخيال وكأنّه شيء رأيتِه بعينكِ

262
00:18:56,530 --> 00:19:00,490
شوهِدَ ذلك في الواقع بواسطة
الأشخاص في هذا القصر

263
00:19:00,490 --> 00:19:02,020
هكذا إذاً

264
00:19:02,450 --> 00:19:04,360
لم يصل الحُرّاس بعد؟

265
00:19:04,360 --> 00:19:09,080
بضجيج كهذا، كان الحُرّاس القريبون ليُلاحظوا

266
00:19:09,080 --> 00:19:15,800
.يجب على المرء أن يصنع خياره
لا يهم إذا انحسرتْ قوّتي وحدها

267
00:19:15,800 --> 00:19:20,010
هل اخترقَ تلاميذ القدّيس الآخرون
القصر وبدؤوا بالقتال؟

268
00:19:20,010 --> 00:19:25,120
،إذا استطعتُ حماية الدّولة كملِكة
فهذا هو الخيار الصّحيح

269
00:19:25,530 --> 00:19:28,320
ينبغي أن تكون هنا بالفعل

270
00:19:28,720 --> 00:19:30,850
هل خطّتكِ هي انتظار ساحرة كارثة الجليد؟

271
00:19:35,270 --> 00:19:36,980
!إعصار القنبلة

272
00:19:38,400 --> 00:19:40,110
كان هناك مُتآمرون إذاً

273
00:19:40,370 --> 00:19:45,610
إنّها حرب معلومات. لا أنوي
قتلكِ بمُهاجمتكِ بشكل مُباشر

274
00:19:45,610 --> 00:19:47,330
لا بُدّ أنّها إيليتيار

275
00:19:49,570 --> 00:19:50,470
استعدّي للموت

276
00:19:50,470 --> 00:19:53,210
أعتقد بأنّك تستهين بي

277
00:19:54,900 --> 00:20:00,650
لا أملك خياراً، بما أنّه لا الحُرّاس
ولا آليس سيأتون قريباً

278
00:20:00,650 --> 00:20:06,470
،لا تروقني فكرة تدمير قاعة الملِكة بنفسي

279
00:20:07,250 --> 00:20:11,430
لكن انتهى العرض

280
00:20:12,450 --> 00:20:16,340
هذه دولة قديمة جدّاً

281
00:20:16,900 --> 00:20:22,110
عائلة لو والملِكة الحاليّة يُحقّقان التّوازن
في الحرب ضدّ الإمبراطوريّة

282
00:20:22,450 --> 00:20:26,170
وتستمرّ عائلة زوا في صرخة
الانتقام ضدّ الإمبراطوريّة

283
00:20:26,480 --> 00:20:30,750
سئمتْ عائلة هيدرا من وضع هذه الدّولة

284
00:20:31,530 --> 00:20:34,640
ما رأيك أيُّها الجنديّ الإمبراطوريّ؟

285
00:20:35,780 --> 00:20:38,770
!هل هذا فنٌّ نجميّ موجيّ حقّاً؟

286
00:20:39,250 --> 00:20:42,130
لديك عينان ثاقبتان بالفعل

287
00:20:43,850 --> 00:20:48,720
حتّى أنّك توقّعتَ حدوث هذا. هل كانت
حاسّة سمعك؟ لا، هل شعرت بذلك؟

288
00:20:49,380 --> 00:20:50,970
!كلاهما

289
00:20:58,520 --> 00:21:03,230
!كم موجة كبيرة ضُغِطَتْ في قبضته؟

290
00:21:03,570 --> 00:21:08,910
مُذهل. كأنّ لديك سونار من
الرّأس حتّى أخمص القدمين

291
00:21:10,030 --> 00:21:15,080
لماذا تخاطر بحياتك لحماية الآنسة سيسبيل؟

292
00:21:15,520 --> 00:21:18,840
كم حجم المُكافأة الّتي وعدَتْك بها؟

293
00:21:18,840 --> 00:21:21,780
أنتم من هاجمونا أوّلاً

294
00:21:21,780 --> 00:21:24,220
فلماذا لا أطرد شخصاً عنيفاً؟

295
00:21:24,220 --> 00:21:26,630
لعلّ الأوان قد فات، لكنّك أخطأت

296
00:21:27,240 --> 00:21:30,220
هذا قصر مملوك بواسطة العائلة
الملكيّة للسّلطنة

297
00:21:30,220 --> 00:21:34,980
في العادة، لا يتوقّع المرء وجود
جنود إمبراطوريّين هنا

298
00:21:34,980 --> 00:21:38,440
لكن لا بُدّ أنّ إيليتيار قد أخبرتْك

299
00:21:39,800 --> 00:21:42,580
لماذا خانتْ إيليتيار أُمّها؟

300
00:21:43,180 --> 00:21:45,430
ما رأيك بجمالها؟

301
00:21:45,840 --> 00:21:46,990
ماذا؟

302
00:21:47,320 --> 00:21:53,260
،إن كان هناك ما يُدعى بسحر فاتن
فهو جمال إيليتيار

303
00:21:53,700 --> 00:21:58,000
أمام جمالها، حتّى الإلَهة بحدّ
ذاتها سترغب في خدمتها

304
00:21:58,000 --> 00:22:01,710
لا بُدّ أنّ جمالها هِبة من الآلهة

305
00:22:02,070 --> 00:22:03,090
،لكن

306
00:22:05,260 --> 00:22:08,050
لم يُحبّها الكوكب

307
00:22:08,870 --> 00:22:11,240
أنت تسيء فهم أمر واحد

308
00:22:11,240 --> 00:22:14,590
أهداف الهيدرا وإيليتيار ليست نفسها

309
00:22:15,180 --> 00:22:20,480
نحن ببساطة نتشارك نفس الخطوة
الأُولى لتحقيق مُثُلنا

310
00:22:20,880 --> 00:22:23,260
وكلّ هذا لإسقاط الملِكة؟

311
00:22:23,260 --> 00:22:28,860
،إذا استطعنا القضاء على ملكتنا الحاليّة
فسوف تضعف السّلطنة مُؤقّتاً

312
00:22:28,860 --> 00:22:32,700
سيمنحنا هذا أفضليّة في المعارك المُستقبليّة

313
00:22:32,920 --> 00:22:36,080
هل هذا ما قلتَه للإمبراطوريّة؟

314
00:22:36,080 --> 00:22:38,830
سأدع ذلك لمُخيّلتك

315
00:22:39,110 --> 00:22:41,630
!دعني أُجيب عن أمر واحد لأجلك

316
00:22:43,710 --> 00:22:47,720
هذه ليست معركة أريد خوضها مع السّلطنة

317
00:22:47,720 --> 00:22:49,770
ماذا تقصد؟

318
00:22:49,770 --> 00:22:53,050
لن يتغيّر شيء إذا كنتَ
!تتصرّف على هواك

319
00:22:53,050 --> 00:22:58,850
،كلتا الدّولتين ستتأذّيان باستمرار
وستتدهور علاقتهما ثمّ انتهى

320
00:22:58,850 --> 00:23:03,560
"ليست هذه. ليست هذه هي "النّهاية
!الّتي أطمح لها

321
00:23:04,270 --> 00:23:09,900
لا أريد أن تسقط الإمبراطوريّة، ولا السّلطنة

322
00:23:11,840 --> 00:23:16,660
يا لها من رومانسيّة! أنت تحلم
بخيال جميل جدّاً

323
00:23:16,660 --> 00:23:19,750
أنت ذاخر بالرّومانسيّة، وغير مُلائم
كمُدمِّر بحدّ ذاتك

324
00:23:19,750 --> 00:23:25,440
لكن تلاميذ القدّيس الآخرين
والملكيّين عدا عائلة لو

325
00:23:25,440 --> 00:23:28,710
كانوا مُتلهّفين لهذا اليوم، على ما أعتقد

326
00:23:28,710 --> 00:23:30,510
ما معنى هذا؟

327
00:23:31,040 --> 00:23:39,600
أرادوا المُقارنة. السّؤال الّذي دام
عقداً حول مَن الأقوى؟

328
00:23:41,190 --> 00:23:43,940
،تلاميذ القدّيس التّابعون للإمبراطوريّة

329
00:23:43,940 --> 00:23:47,360
أم أنقياء الدّماء، سليلو المُؤسّس؟

330
00:23:47,630 --> 00:23:51,840
يريدون أن يعلموا وبشكل نهائيّ
مَن هو الأفضل

331
00:23:53,710 --> 00:23:59,130
هذا ما تتمحور حوله... هذه اللّيلة