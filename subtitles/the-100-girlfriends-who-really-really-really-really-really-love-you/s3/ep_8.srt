1
00:00:10,430 --> 00:00:14,130
ماذا كان ذلك؟ تعويذة دُوار؟

2
00:00:14,130 --> 00:00:19,620
يا إلهي، يحدث خطأ ما في كلّ
يوم عن عمر 89

3
00:00:19,900 --> 00:00:21,750
عمرها 89؟

4
00:00:21,750 --> 00:00:25,250
سررتُ بلقائك يا حبيب كوسوري

5
00:00:25,250 --> 00:00:29,260
...هذه... خليلة روحي الجديدة

6
00:00:29,730 --> 00:00:31,890
جدّة كوسوري-سينباي؟

7
00:00:33,280 --> 00:00:35,510
أنا ياكوزين ياكو، صحيح

8
00:00:35,510 --> 00:00:38,570
!من جديد، العائلة الكوسورويفانيّة

9
00:00:35,810 --> 00:00:39,020
من جديد

10
00:00:35,810 --> 00:00:39,020
!!!!العائلة الكوسوريفانيّة

11
00:00:52,910 --> 00:00:58,920
المئة خليلة
اللّواتي يحبننك حقّاً حقّاً حقّاً حقّاً حقّاً

12
00:02:09,500 --> 00:02:10,700
كوسوري-هي

13
00:02:10,700 --> 00:02:15,080
اسم جدّتي جميل. إنّه رائع للغاية

14
00:02:13,470 --> 00:02:15,080
كوسوري-هي

15
00:02:15,080 --> 00:02:16,990
،كما أقول باستمرار

16
00:02:16,990 --> 00:02:21,950
سُمِّيتُ تيمُّناً بشجر الأرزّ ياكوسوغي
الّتي كانت والدة جدّتكِ مُولعة بها

17
00:02:21,950 --> 00:02:24,430
إنّهم مُدمِنون على شجر الأرزّ

18
00:02:22,530 --> 00:02:25,040
تبدوان كتوأمتين فحسب

19
00:02:25,400 --> 00:02:28,540
هل تناولتِ عقّار الخلود أيضاً؟

20
00:02:28,840 --> 00:02:31,750
بالفعل. لهذا أبدو في الثّامنة من عمري

21
00:02:31,750 --> 00:02:35,840
،والّذي تناولتُه كان شبه مُكتمل

22
00:02:35,840 --> 00:02:38,680
ليس حتّى الدّواء العاكس لا يستطيع إلغاءه

23
00:02:39,000 --> 00:02:40,930
ليس وكأنّني أُبالي

24
00:02:40,930 --> 00:02:44,580
السّبب الرّئيسيّ وراء صنع كوسوري
...لعقّار الخلود

25
00:02:44,350 --> 00:02:49,320
عِناق

26
00:02:44,580 --> 00:02:47,790
هو لأنّني لا أريد رؤية جدّتي الحبيبت تموت

27
00:02:47,480 --> 00:02:49,320
حفيدة

28
00:02:47,790 --> 00:02:49,320
!الحفيدة النّموذجيّة

29
00:02:49,320 --> 00:02:51,400
!جدّتي

30
00:02:49,570 --> 00:02:50,900
♥عِناق

31
00:02:52,000 --> 00:02:54,610
أقرّ بأنّه عملٌ ممتاز يا كوسوري

32
00:02:54,610 --> 00:02:56,370
ماذا تقصدين؟

33
00:02:56,370 --> 00:02:59,950
كيف تمكّنتِ من الحصول على رجل
لطيف كهذا؟

34
00:02:59,950 --> 00:03:04,270
أي نعم، رينتارو هو الأفضل في العالم

35
00:03:00,330 --> 00:03:02,450
أي نعم

36
00:03:04,270 --> 00:03:05,460
كوسوري-هي

37
00:03:04,330 --> 00:03:05,460
كوسوري-هي

38
00:03:05,740 --> 00:03:10,590
كم يُعيدني هذا إلى أيّام شبابي

39
00:03:10,590 --> 00:03:14,140
أيُّهما أفضل؟ رينتارو أم جدّي في الجنّة؟

40
00:03:14,140 --> 00:03:18,220
لا أدري. مضى وقت طويل على ذلك

41
00:03:18,700 --> 00:03:22,790
،كان زوجي فحلاً

42
00:03:22,790 --> 00:03:25,080
...لكن رُبّما إذا تمكّنتُ من معرفتك بشكل أفضل

43
00:03:25,080 --> 00:03:25,980
...ماذا؟ المعذرة

44
00:03:25,980 --> 00:03:29,660
ما رأيكِ بالانضمام لعائلة رينتارو يا جدّتي؟

45
00:03:29,660 --> 00:03:31,090
مات جدِّي على أيّ حال

46
00:03:31,090 --> 00:03:32,080
!ماذا؟

47
00:03:32,080 --> 00:03:33,940
عائلة رينتارو؟

48
00:03:33,940 --> 00:03:39,410
هل هذه المجموعة الّتي تشمل آيجو-كن
والحبيبات الّتي ذكرتِها؟

49
00:03:39,410 --> 00:03:40,580
!تماماً، أي نعم

50
00:03:40,580 --> 00:03:41,620
ماذا؟

51
00:03:41,620 --> 00:03:45,270
لا أُمانع ذلك إذاً

52
00:03:45,270 --> 00:03:46,120
ماذا؟

53
00:03:46,120 --> 00:03:49,680
!مرحى! مرحى

54
00:03:47,040 --> 00:03:48,930
بهذه البساطة؟

55
00:03:48,930 --> 00:03:52,110
لِمَ لا نذهب ونتمشّى كأوّل لِقاء رومانسيّ لنا؟

56
00:03:52,110 --> 00:03:54,140
ماذا؟ حـ-حسناً

57
00:03:54,140 --> 00:03:57,260
!كوسوري أيضاً! كوسوري أيضاً

58
00:03:56,150 --> 00:03:57,760
أحقّاً يا كوسوري؟

59
00:03:57,760 --> 00:03:59,010
اقترب الوقت

60
00:03:59,010 --> 00:04:02,510
!لا يهمّ! بينتارو على وشك أن يبدأ

61
00:04:21,280 --> 00:04:23,990
إذاً هل أنتِ كيميائيّة أيضاً؟

62
00:04:23,990 --> 00:04:28,290
بالطّبع، رغم أنّني لا أمتلك معرفة
كوسوري ولا موهبتها

63
00:04:29,230 --> 00:04:30,290
...عندما كنتُ صغيرة

64
00:04:38,550 --> 00:04:41,550
صنعتُ أدويةً طارئة في ساحة المعركة

65
00:04:41,550 --> 00:04:42,870
!في ساحة المعركة؟

66
00:04:45,180 --> 00:04:47,930
حينئذ التقيتُ بجدّ كوسوري

67
00:04:48,360 --> 00:04:53,190
صادفَ وجود وحدته في المنطقة
لإنقاذي عندما كنتُ في مأزق

68
00:04:53,560 --> 00:04:55,630
!كان فحلاً

69
00:04:56,630 --> 00:04:58,400
لـ-لكن لماذا كنتِ هنا؟

70
00:04:59,170 --> 00:05:02,410
يمكن الاحتفاظ ببعض التّفاصيل سرّاً

71
00:05:03,500 --> 00:05:07,910
وجود بعض الأسرار يُضيف جاذبيّة
للمرأة، أليس كذلك؟

72
00:05:09,590 --> 00:05:10,910
ماذا؟

73
00:05:11,180 --> 00:05:13,400
هل تلك الّتي هناك هي أوراق
حبَق الرّاعي؟

74
00:05:13,400 --> 00:05:15,590
لنقطف قليلاً

75
00:05:18,350 --> 00:05:21,180
أنتم الصّغار لا تفعلون هذا كثيراً، صحيح؟

76
00:05:21,180 --> 00:05:24,390
لا. هل هذه لأجل لُفافات كوساموتشي؟

77
00:05:24,390 --> 00:05:29,930
ويمكن استخدامها أيضاً لإعداد
تيمبورا وسلطة وحساء

78
00:05:30,700 --> 00:05:34,110
لم أكن أعلم بأنّ أوراق حبَق الرّاعي
طعام عمليّ هكذا

79
00:05:34,740 --> 00:05:38,650
انظري. هذه كبيرة حقّاً

80
00:05:38,650 --> 00:05:40,940
أجل، نوع مُدهش

81
00:05:41,550 --> 00:05:45,060
لكنّها تتيبّس عندما تصبح كبيرة الحجم

82
00:05:45,060 --> 00:05:49,200
الطّازجة، أو الّتي لها خمسة إلى ستّة
شموس، هي الأشهى

83
00:05:49,200 --> 00:05:53,130
أحقّاً ذلك؟ معلوماتكِ غزيرة

84
00:05:53,130 --> 00:05:57,090
كوسوري-هي. نكتسب المعلومات
مع تقدُّم العمر

85
00:05:57,390 --> 00:06:00,240
كان يجب علينا أكل ما يترتّب
...علينا أكله آنذاك

86
00:06:00,650 --> 00:06:07,920
تسرّني رؤيتك أنت وعزيزتي كوسوري
تنموان في زمن مُزدهر كهذا

87
00:06:08,610 --> 00:06:14,910
لكن يعزو الفضل كُلّه لكِ ولنظرائكِ بجعل
العالم مكاناً أفضل

88
00:06:16,760 --> 00:06:18,860
أجرحت نفسك بورقة؟

89
00:06:19,660 --> 00:06:21,290
أرِني

90
00:06:21,290 --> 00:06:22,000
ماذا؟

91
00:06:23,580 --> 00:06:27,870
أوراق حبَق الرّاعي تُمثّل مرهماً ممتازاً
عندما تُسحَق أيضاً

92
00:06:34,160 --> 00:06:36,000
لحظة، ماذا؟

93
00:06:36,000 --> 00:06:37,380
ما الأمر؟

94
00:06:38,510 --> 00:06:40,380
لا شيء

95
00:06:40,870 --> 00:06:45,630
رُبّما كان لأنّني اعتدتُ رؤية
كوسوري-سينباي يتغيّر حجمها

96
00:06:46,040 --> 00:06:50,390
،والآن تحتاج لمسة أخيرة فحسب
تعويذة تجعلك تشعر بتحسُّن

97
00:06:59,400 --> 00:07:01,940
ما رأيك؟ هل تشعر بأي تحسُّن؟

98
00:07:03,780 --> 00:07:05,570
أجل. شُفيتُ تماماً

99
00:07:06,230 --> 00:07:08,900
كان ذلك سريعاً جدّاً

100
00:07:10,790 --> 00:07:13,580
شكراً لك على وقتك يا آيجو-كن

101
00:07:14,010 --> 00:07:19,640
استمتعتُ كثيراً اليوم. احرص على
مُعاملة كوسوري مُعاملة حسنة

102
00:07:20,340 --> 00:07:24,750
ا-المعذرة، لا شكّ في ذلك

103
00:07:25,210 --> 00:07:29,950
لكن هل أستطيع الحصول على
رقم هاتفكِ أيضاً؟

104
00:07:29,950 --> 00:07:31,210
ماذا؟

105
00:07:31,730 --> 00:07:35,100
المعذرة، أو أي تطبيق مُراسلة على هاتفكِ؟

106
00:07:35,100 --> 00:07:37,410
الحمام الزّاجل؟ بالدُّخان والنّار؟

107
00:07:37,410 --> 00:07:39,980
ما-ماذا؟ هل كنتِ تستخدمين هذه التّطبيقات؟

108
00:07:40,550 --> 00:07:42,230
أتحدّث عن هذا الشّيء

109
00:07:43,050 --> 00:07:48,240
هذا الشّيء الّذي تلعب كوسوري به
دوماً أو تتكلّم معه

110
00:07:44,150 --> 00:07:48,240
!أي نعم. حسناً. أراك غداً

111
00:07:48,610 --> 00:07:51,240
شيء غامض ما

112
00:07:48,950 --> 00:07:49,810
تلك البلاطة؟

113
00:07:49,810 --> 00:07:50,790
!بلاطة؟

114
00:07:49,870 --> 00:07:51,240
بلاطة

115
00:07:51,240 --> 00:07:57,070
أعتذر على تخلُّفي. أنا بائسة
في الأجهزة أو الكلمات الدّخيلة

116
00:07:57,070 --> 00:08:01,500
لا بأس. في هذه الحالة، يمكنني الاتّصال
بهاتفكِ الأرضيّ بدلاً من ذلك

117
00:08:01,500 --> 00:08:05,870
هاتف... أعرف كيفيّة استخدام
...العلبة القصديريّة

118
00:08:05,870 --> 00:08:08,010
انسي الهاتف الأرضيّ، دستُ
!على لغم أرضيّ

119
00:08:08,310 --> 00:08:12,140
إ-إذاً أستطيع إرسال رسائل أو زيارة
منزلكِ من جديد

120
00:08:12,140 --> 00:08:14,520
...انتظر

121
00:08:14,520 --> 00:08:19,770
هل اتّخذتَ ما قلتُه بشأن الانضمام
لعائلة رينتارو بجدّية؟

122
00:08:22,020 --> 00:08:26,630
أعتذر. لم أقصد أن أكون مُضلِّلة

123
00:08:26,630 --> 00:08:29,150
كنتُ أحاول تسلية كوسوري فحسب

124
00:08:29,640 --> 00:08:31,340
سامحني من فضلك

125
00:08:32,920 --> 00:08:35,910
هـ-هل يمكنكِ التّفكير في ذلك الآن؟

126
00:08:36,220 --> 00:08:40,850
من فضلك. عمري 89 وكبيرة جدّاً
على العلاقات الرّومانسيّة

127
00:08:40,850 --> 00:08:46,450
وكبيرة جدّاً بالنّسبة لشابّ مثلك

128
00:08:46,950 --> 00:08:53,560
يجب عليك إيجاد سعادتك مع كوسوري
وفتيات أُخريات في سنّك

129
00:08:53,560 --> 00:08:55,430
فهمتُ الآن

130
00:08:55,940 --> 00:09:01,440
طوال اليوم، كانت تُعاملني كطفل

131
00:09:02,150 --> 00:09:06,600
قد تبدو أصغر بالنّسبة لي، لكنّها
لا ترى نفسها كذلك

132
00:09:06,600 --> 00:09:09,880
لديها عقليّة ونضج شخص بسنّ 89

133
00:09:10,250 --> 00:09:12,950
...بالنّسبة لها، طالب ثانويّة مثلي

134
00:09:13,470 --> 00:09:14,950
هو مُجرّد طفل

135
00:09:15,820 --> 00:09:17,200
كيف؟

136
00:09:17,590 --> 00:09:20,650
ما الّذي يمكنني فعله لجعلها تراني رجلاً؟

137
00:09:24,190 --> 00:09:26,640
هلّا خصّصتِ لي مزيداً من وقتكِ؟

138
00:09:27,590 --> 00:09:36,100
المتجر الكبير

139
00:09:27,590 --> 00:09:33,720
قالت بأنّ زوجها الرّاحل رجلاً حقيقيّاً وفحلاً

140
00:09:34,200 --> 00:09:37,100
...لعلّ ذلك يعني بأنّها مُهتمّة

141
00:09:37,420 --> 00:09:38,560
...بالفتيان الأشقياء

142
00:09:43,380 --> 00:09:44,600
!النّموذجيّين

143
00:09:48,300 --> 00:09:49,760
ماذا أصابك؟

144
00:09:50,110 --> 00:09:52,270
...الجدّ—لا

145
00:09:52,270 --> 00:09:56,560
ياكو...سان، رجاء هل—لنُحدِث جلبة
!في الحديقة بعد ساعات

146
00:09:56,560 --> 00:09:57,620
!ما الّذي يجري؟

147
00:09:57,620 --> 00:10:00,620
حديقة المُتمرِّدين

148
00:09:57,940 --> 00:10:00,620
ما الّذي يجعل الفتى الشّقيّ شقيّاً؟

149
00:10:00,870 --> 00:10:02,120
!!!الثِّقة بالنّفس

150
00:10:00,870 --> 00:10:02,120
!الثِّقة بالنّفس

151
00:10:02,420 --> 00:10:04,630
!اصعدي النوّاسةَ معي

152
00:10:04,970 --> 00:10:09,250
أعتقد بأنّه يريد شخصاً أن يجلس
على الجانب الآخر لأجله

153
00:10:09,610 --> 00:10:11,940
!دعي ساقَي القويّتين تتولّيان هذا الأمر

154
00:10:11,880 --> 00:10:14,260
!!!قوّة

155
00:10:11,940 --> 00:10:12,880
!قوّة

156
00:10:12,880 --> 00:10:14,260
يسرّني بأنّه مُستمتع

157
00:10:14,510 --> 00:10:15,760
!!!الحزم

158
00:10:14,510 --> 00:10:15,760
!الحزم

159
00:10:16,320 --> 00:10:18,510
!أختار الأرجوحة الّتي في أقصى اليمين

160
00:10:18,970 --> 00:10:21,520
بكلّ تأكيد. اختر ما تشاء

161
00:10:22,120 --> 00:10:23,020
!سلوك العطاء

162
00:10:22,270 --> 00:10:23,020
!!!سلوك العطاء

163
00:10:23,020 --> 00:10:26,630
،لكن يا ياكو... سان. إذا أردتِها
!فيمكنكِ الحصول عليها

164
00:10:26,630 --> 00:10:29,650
لا أُمانع على أيّ حال

165
00:10:29,900 --> 00:10:31,900
!!!أسلوب حياة البحث عن التّشويق

166
00:10:29,900 --> 00:10:31,900
!أسلوب حياة البحث عن التّشويق

167
00:10:32,270 --> 00:10:34,660
!إن سقطتِ، فستُؤكَلين بواسطة القروش

168
00:10:34,660 --> 00:10:37,280
!لكنّني لستُ خائفاً، لذا ها أنا ذا

169
00:10:38,160 --> 00:10:39,530
!!!شجاعة

170
00:10:38,160 --> 00:10:39,530
!شجاعة

171
00:10:40,660 --> 00:10:42,540
ماذا تحاول أن تفعل؟

172
00:10:43,470 --> 00:10:46,920
هل أفعلها بشكل صحيح؟ هكذا هُم
الفتيان الأشقياء، صحيح؟

173
00:10:47,210 --> 00:10:49,170
لا، أعرف ما يكون هذا

174
00:10:49,610 --> 00:10:54,420
أنا مُجرّد فتى يستمتع في الحديقة
!بينما تُراقب جدّتُه

175
00:10:54,800 --> 00:10:59,580
!لا، هذا الجموح المُزيَّف لن يُؤثِّر بها أبداً

176
00:10:59,580 --> 00:11:01,810
...إذا أردتُها تشعر بذرّة حُبّ

177
00:11:05,230 --> 00:11:05,940
!ياكو

178
00:11:06,480 --> 00:11:08,190
!كوني فتاتي

179
00:11:20,500 --> 00:11:23,040
!لا... لا أستطيع فعلها

180
00:11:23,550 --> 00:11:28,790
