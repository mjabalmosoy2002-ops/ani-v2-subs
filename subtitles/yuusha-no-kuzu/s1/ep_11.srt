1
00:00:09,650 --> 00:00:12,250
،قد يكون هذا درساً ارتجاليّاً

2
00:00:12,720 --> 00:00:14,490
لكنّه جيّد وموتور، أليس كذلك؟

3
00:00:15,600 --> 00:00:17,990
ولا تُعِرنَني أي انتباه

4
00:00:18,950 --> 00:00:20,490
سأكون غاضباً للغاية

5
00:00:20,740 --> 00:00:22,840
...لكن يا مُعلّم

6
00:00:23,500 --> 00:00:25,670
!هذا تمرين حيّ

7
00:00:25,670 --> 00:00:26,630
!ابدأنَ العمل

8
00:02:10,690 --> 00:02:12,620
!أيّها البغيض القذر

9
00:02:12,620 --> 00:02:15,670
!لن أدعك تمسّ مُعلّمي بمِخلبك

10
00:02:15,670 --> 00:02:16,740
!واجه الحُكم

11
00:02:18,350 --> 00:02:20,530
جوغامين، الطّليعة

12
00:02:21,160 --> 00:02:24,750
إنّها سيّئة، وتُقاتل وكأنّها لا تُقاتل

13
00:02:24,750 --> 00:02:26,910
لكن ثمّة أمر واحد تستحقّ إطرائي لأجله

14
00:02:28,330 --> 00:02:31,200
"عندما لا يكون "قتل كائن بشريّ
،مُدرَجاً في الأمر

15
00:02:31,200 --> 00:02:34,250
فهي لا تُبدي أي رحمة

16
00:02:35,450 --> 00:02:39,470
لعلّ ميزتها الكبرى هي طريقتها
،في الانقضاض فوراً على الخصم

17
00:02:39,470 --> 00:02:40,760
كما لو أنّها لا تعرف الخوف

18
00:02:45,380 --> 00:02:46,940
إيندو، المُسانِدة

19
00:02:47,460 --> 00:02:51,520
قوّة الانتقال الآنيّ تلك كبيرة جدّاً
لدرجة تكاد تُعدّ غشّاً

20
00:02:52,880 --> 00:02:56,440
،توجيه ضربات قاتلة بتلك السّكاكين ليس سهلاً

21
00:02:56,440 --> 00:02:58,700
،لكنّها تمنحها مرونة في مُناوراتها

22
00:02:58,700 --> 00:03:02,780
وإيندو هي الوحيدة القادرة على استهداف
أطراف أذرعتهم بدقّة

23
00:03:07,960 --> 00:03:10,410
سارة يُلائمها أن تكون القاضية

24
00:03:10,850 --> 00:03:13,970
أعتقد لا ينبغي أن أتفاجأ من أنّ
ابنة الملك آرثر

25
00:03:13,970 --> 00:03:17,120
لديها قوّة تقطيع الأشياء إلى نصفين
دون مُعاناة كبيرة

26
00:03:21,550 --> 00:03:25,470
لكن لا يمكن أن تكون الشّخص الّذي
يُقرّر متى يتصرّف من تلقاء نفسه

27
00:03:26,420 --> 00:03:29,300
إلّا إن تعاونت مع جوغامين

28
00:03:31,120 --> 00:03:33,480
يجب عليّ وضعهم في نفس الموقف

29
00:03:34,200 --> 00:03:35,990
،وتعزيز نقاط قوّتهم

30
00:03:37,920 --> 00:03:38,980
والتخلُّص من عاداتهم السّيّئة

31
00:03:43,700 --> 00:03:44,870
حسناً

32
00:03:45,460 --> 00:03:47,010
لم يكن ذلك سيّئاً

33
00:03:47,010 --> 00:03:49,280
على هذا المُعدّل، إذا أسقطنا اثنين
،مُقابل كلّ شخص منّا

34
00:03:49,280 --> 00:03:50,870
فينبغي أن نتمكّن من التّعامل مع هذا

35
00:03:52,680 --> 00:03:53,870
...المُشكلة الحقيقيّة هي

36
00:03:55,360 --> 00:03:56,380
أنا

37
00:04:02,610 --> 00:04:04,440
قد أُضحّي بذراعي اليسرى كذلك

38
00:04:05,010 --> 00:04:07,250
،لا أستطيع تحريكها من المِرفق وما دون

39
00:04:09,950 --> 00:04:12,920
سأستخدمها لإبعاد مخالب هذا الشّيء

40
00:04:14,430 --> 00:04:17,020
،ذِراعي ستتمزّق

41
00:04:17,020 --> 00:04:18,960
لكن أمتلك الوقت الكافي

42
00:04:20,130 --> 00:04:24,780
وقت يكفي وأكثر لتحمُّل الألم
والهجوم المُضادّ

43
00:04:26,270 --> 00:04:28,690
ما أحتاجه فعلاً هو الأمل

44
00:04:28,690 --> 00:04:30,620
الأمل بأنّني أستطيع القيام بهذا فعلاً

45
00:04:31,250 --> 00:04:34,120
عليّ تركيز عقلي على الأشياء
الجميلة في الحياة فقط

46
00:04:34,820 --> 00:04:38,630
بيرة، بيتزا، وألعاب الورق

47
00:05:17,270 --> 00:05:20,010
!جوغامين

48
00:05:20,980 --> 00:05:23,340
!أخبرتُكِ ألّا تتدخّلي في الأمر

49
00:05:28,570 --> 00:05:29,960
!هذا مُطمئن

50
00:05:32,730 --> 00:05:35,200
،لو كان قد أصابك مكروه

51
00:05:36,080 --> 00:05:38,850
لفقدتُ كلّ صوابي

52
00:05:42,050 --> 00:05:44,810
بعد اللّقاء أخيراً بالشّخص الّذي
!أطمح أن أكون مثله

53
00:05:48,750 --> 00:05:51,210
،هناك أشياء كثيرة تدور في ذهني

54
00:05:51,210 --> 00:05:53,240
لكن ثمّة أمر واحد واضح بالنّسبة لي

55
00:05:54,760 --> 00:06:00,570
سبب شعوري بالجنون والغضب الشّديد
هو عندما تفعل شيئاً كهذا

56
00:06:03,410 --> 00:06:05,650
...الشّيء الّذي تطمح له

57
00:06:07,480 --> 00:06:08,830
هو مُثُلي الأعلى

58
00:06:11,420 --> 00:06:13,640
،رحيم وصبور

59
00:06:13,640 --> 00:06:16,640
شخص لا يقتل أحداً أو يدع أحداً يموت

60
00:06:17,440 --> 00:06:20,150
اليوشا الّذي ينال احترام الجميع

61
00:06:20,750 --> 00:06:22,650
...اليوشا

62
00:06:23,990 --> 00:06:25,100
الّذي أتمنّى أن أكون

63
00:06:28,720 --> 00:06:30,160
الّذي تمنّيتُ أن أكون مثله

64
00:06:33,210 --> 00:06:34,640
لكن لم أستطع فعلها

65
00:06:39,770 --> 00:06:42,500
،لم أكن قويّاً بما يكفي لتحقيق ذلك

66
00:06:43,600 --> 00:06:46,510
أو مجنوناً بما يكفي للمُراهنة
بحياتي سعياً وراء ذلك

67
00:06:47,670 --> 00:06:52,390
كنتُ أتصرّف بنفس الطّريقة الّتي يتصرّفها
الأشخاص الّذين يسخرون من شخص

68
00:06:52,390 --> 00:06:54,730
يريد أن يكون رائد فضاء أو لاعب كُرة قدم

69
00:06:58,670 --> 00:07:00,310
...أنظر إلى جوغامين

70
00:07:01,230 --> 00:07:02,380
وأشعر بالغيرة

71
00:07:08,910 --> 00:07:12,200
حسناً، إنّهم يفعلونها حقّاً

72
00:07:12,620 --> 00:07:15,440
هل أنت من نظّم هذا أيُّها
الحديقة المُشوّهة؟

73
00:07:15,440 --> 00:07:16,980
!أبداً

74
00:07:16,980 --> 00:07:19,350
أعتقد بأنّه استعراض نادر بواسطة

75
00:07:19,350 --> 00:07:21,830
!كونت العواصف تابوت لترفيه ضيوفها

76
00:07:22,160 --> 00:07:23,830
!أنا مُندهش

77
00:07:25,140 --> 00:07:27,760
،إن كنت تشعر بالتّسلية

78
00:07:27,760 --> 00:07:30,220
فلا بُدّ أنّ الأمور سيّئة حقّاً

79
00:07:30,630 --> 00:07:34,010
يا إلهي، هل أنت خائف يا سيّد وتر فضّي؟

80
00:07:34,010 --> 00:07:36,430
لا تسخري من السيّد وتر فضّي يا أختي

81
00:07:36,430 --> 00:07:38,710
ستجعلينه يعبس

82
00:07:41,650 --> 00:07:43,060
يبدو أنّ الحفلة انتهت

83
00:07:43,560 --> 00:07:44,380
سأغادر

84
00:07:46,900 --> 00:07:48,500
ها هو قد عبس

85
00:07:48,500 --> 00:07:49,480
أجل

86
00:07:54,860 --> 00:07:57,200
!ما هذا التصرُّف الغبيّ؟

87
00:07:57,200 --> 00:07:58,540
!كان من المُمكن أن نموت

88
00:07:58,910 --> 00:08:01,810
!لا، لنعُد جميعاً إلى المنزل أحياء

89
00:08:05,140 --> 00:08:08,420
!عُلِّمتُ بأنّ اليوشا يجب أن يُجسّدوا الأمل

90
00:08:12,170 --> 00:08:15,430
يمكنني التّفكير بوسيلة للخروج من هذا

91
00:08:16,200 --> 00:08:17,910
...إمّا كلّ شيء أو لا شيء

92
00:08:17,910 --> 00:08:20,620
هذا هو أملنا الوحيد فعلاً

93
00:08:22,870 --> 00:08:25,240
المزيد من جرعات إي-3

94
00:08:25,240 --> 00:08:30,830
جرعتان أُخرتان، وستُشفى ساقي
وذِراعي بشكل فوريّ

95
00:08:32,310 --> 00:08:34,310
لكن ستكون الآثار الجانبيّة فظيعة

96
00:08:35,630 --> 00:08:39,650
عدوى الأثير الفائضة يمكن
أن تُدمّر شخصاً بسهولة

97
00:08:40,420 --> 00:08:43,760
فرط حساسيّة واستجابة عدائيّة مسعورة

98
00:08:43,760 --> 00:08:47,210
كثير من النّاس ينتهي المطاف بهم
بعدم استعادة السّيطرة

99
00:08:47,980 --> 00:08:49,960
حوالي 60% من النّاس الّذين يتناولون
جرعة زائدة ينتهون هكذا

100
00:08:50,720 --> 00:08:52,460
لذا، في أيّ نسبة أندرج أنا؟

101
00:09:17,100 --> 00:09:20,660
كنتُ أتساءل لماذا بدت العمالقة تُعاني

102
00:09:20,660 --> 00:09:21,770
هذا أنت

103
00:09:22,330 --> 00:09:25,210
أنت مصدر إزعاج فعلاً

104
00:09:25,630 --> 00:09:26,710
...هذا الصّوت

105
00:09:32,320 --> 00:09:35,800
هذه النّماذج النّاقصة ليست جيّدة إذاً

106
00:09:35,800 --> 00:09:39,300
لا نملك وقتاً لنهدره في مكان كهذا حقّاً

107
00:09:39,880 --> 00:09:43,010
تبيّن بأنّ هذا العمل أصعب ممّا تمنّيت

108
00:09:43,010 --> 00:09:45,310
والآن، ماذا نفعل؟

109
00:09:45,670 --> 00:09:47,720
آسف على كلّ المتاعب

110
00:09:47,720 --> 00:09:49,810
لكن كنتُ أبحث عنك في الواقع

111
00:09:50,650 --> 00:09:52,690
،بقدر ما أنا مُمزَّق

112
00:09:53,310 --> 00:09:56,190
لديّ ما يكفي من إي-3 بمتناول يدي

113
00:09:56,190 --> 00:09:58,810
وتنوي استخدامها؟

114
00:09:58,810 --> 00:10:00,520
ممتاز

115
00:10:00,520 --> 00:10:04,880
إن حالفك الحظّ، فسوف تتمكّن
من العودة منه، مثلما فعلتُ أنا

116
00:10:07,420 --> 00:10:11,960
ليفي، دعيه لي. اذهبي أنتِ

117
00:10:12,870 --> 00:10:15,960
ما زال هناك ثلاثة، ينبغي أن
أن أتمكّن من تدبُّر أمري

118
00:10:16,710 --> 00:10:18,970
أين ينبغي أن نلتقي حالما ينتهي هذا؟

119
00:10:20,390 --> 00:10:21,980
سأترك اِثنين

120
00:10:39,690 --> 00:10:42,700
!مُعلّم، ارتح من فضلك

121
00:10:44,220 --> 00:10:46,170
!سأتصدّى لهم

122
00:10:46,170 --> 00:10:48,330
!تلميذتك الأولى! أنا

123
00:10:48,640 --> 00:10:50,580
كنتُ لأتراجع لو كنتُ مكانكم

124
00:10:51,200 --> 00:10:54,590
أنتن الفتيات لا تستطعن هزيمتي
بمُستواكن الحاليّ

125
00:10:55,450 --> 00:10:57,420
!وأنتما

126
00:10:57,420 --> 00:11:00,930
إن لم تتدخّلا، يمكنكما الذّهاب

127
00:11:06,080 --> 00:11:06,930
!تبّاً لك

128
00:11:14,100 --> 00:11:16,070
إنّه لا يُهاجمني مُباشرة

129
00:11:16,590 --> 00:11:17,840
لا عجب

130
00:11:17,840 --> 00:11:22,060
إذا شننتُ هجمة انتحاريّة، فسيكون
ذلك سيّئاً بالنّسبة له

131
00:11:23,030 --> 00:11:25,890
أقصى أمل له هو سقوط سارة وإيندو

132
00:11:26,740 --> 00:11:29,080
ثمّ مُحاصرتنا

133
00:11:29,730 --> 00:11:31,080
هل أستخدمها الآن؟

134
00:11:31,340 --> 00:11:34,840
لا. ينبغي لذراعي أن تعمل من
جديد بعد دقيقة أُخرى

135
00:11:38,980 --> 00:11:41,600
إذا كان يستقصي الوضع، فهذا
يصبّ في صالحي

136
00:11:42,250 --> 00:11:44,700
حان وقت كسب مزيد من الوقت

137
00:11:45,940 --> 00:11:49,350
يا صاح، هل سمعت برجل
يُدعى إيشينو من قبل؟

138
00:11:49,890 --> 00:11:52,730
كان وغداً مُريباً حقّاً يرتدي نظّارة

139
00:11:54,370 --> 00:11:55,390
أتتذكّره؟

140
00:11:55,390 --> 00:11:59,360
أنا متأكّد بأنّه هو من بترَ يدك
اليسرى عديمة القيمة هذه

141
00:11:59,360 --> 00:12:03,400
كان لقبه الموسيقار، صحيح؟

142
00:12:03,400 --> 00:12:06,200
إذاً كنت تعرفه فعلاً؟

143
00:12:06,200 --> 00:12:08,870
أعتقد بأنّ حدس ليفي حادّ حقّاً

144
00:12:09,680 --> 00:12:12,320
بئس الأمر! كان مُتعِباً حقّاً

145
00:12:12,320 --> 00:12:15,030
...مات ثلاثة من جماعتنا

146
00:12:16,420 --> 00:12:19,130
وترى ما حدث لذراعي

147
00:12:19,130 --> 00:12:20,570
أليس هذا فظيعاً؟

148
00:12:20,570 --> 00:12:23,060
كنتُ غاضباً جدّاً لدرجة أنّني
طعنتُه عشر مرّات

149
00:12:23,060 --> 00:12:25,310
لكن لم يكن يصرخ حتّى

150
00:12:25,310 --> 00:12:28,320
يا له من شخص مغرور

151
00:12:31,260 --> 00:12:32,020
هكذا إذاً

152
00:12:32,600 --> 00:12:33,980
...هذا ما حدث إذاً

153
00:12:39,670 --> 00:12:42,050
يبدو أنّك تستمتع يا إيدو

154
00:12:42,050 --> 00:12:44,110
تستمتع بمجال العمل هذا؟

155
00:12:46,000 --> 00:12:51,340
سيفوتك الكثير إذا لم تستمتع
بحياتك لأقصى حدّ، صحيح؟

156
00:12:53,140 --> 00:12:54,630
لا أخالفك بشأن ذلك

157
00:12:54,630 --> 00:12:57,380
أعتقد هذا أحد أنواع اليوشا الأقوياء

158
00:12:58,320 --> 00:13:00,880
،دون كبرياء أو فكرة عن الفخر

159
00:13:01,690 --> 00:13:04,690
ولا شيء تخسره بمعزل عن حياتك

160
00:13:06,470 --> 00:13:09,910
أنا واثق بأنّ أمثالكم يعيشون
حياة مديدة في النّهاية

161
00:13:11,060 --> 00:13:12,450
...فيما عدا ذلك

162
00:13:15,900 --> 00:13:17,900
!أنت على وشك الموت

163
00:13:21,450 --> 00:13:22,840
هل أنت متأكّد من ذلك؟

164
00:13:34,960 --> 00:13:38,030
الميّت لا يأبه للانتقام

165
00:13:39,560 --> 00:13:41,090
أو هذا ما يُقال

166
00:13:41,920 --> 00:13:44,010
،وبين مُتصنّعي الكمال الاعتياديّين

167
00:13:44,010 --> 00:13:46,130
هذا هو الحال غالباً

168
00:13:51,630 --> 00:13:55,140
لكنّني أعرفه. أعرف ما كان ليقوله

169
00:13:58,170 --> 00:14:00,260
"كان من الأفضل لك أن تثأر لي"

170
00:14:06,070 --> 00:14:09,020
"...أنزِل أفظع الأشياء الّتي يمكن تخيُّلها عليهم"

171
00:14:11,510 --> 00:14:14,340
"وسجّل مُعاناتهم"

172
00:14:56,630 --> 00:14:57,660
!يوكيني

173
00:15:02,400 --> 00:15:05,350
...ما زال... بمقدوري القتال

174
00:15:06,590 --> 00:15:08,060
...هذه المرّة، أنا سوف

175
00:15:25,280 --> 00:15:26,400
!تنحّي جانباً

176
00:15:26,400 --> 00:15:27,730
!لن أفعل

177
00:15:27,730 --> 00:15:30,000
!أعتبر هذا اختباراً آخر

178
00:15:51,770 --> 00:15:53,430
تبّاً للاختبارات

179
00:15:55,660 --> 00:15:56,590
...هناك احتمال

180
00:15:57,060 --> 00:15:59,450
...لو أنّ ساقي قد شُفيَتْ أكثر

181
00:16:06,610 --> 00:16:09,210
لاخترقتُ جوغامين للوصول إليه

182
00:16:22,080 --> 00:16:24,660
إنّها عقبة مُزعجة

183
00:16:28,850 --> 00:16:31,850
هذا مُستفزّ. وسخيف جدّاً

184
00:16:47,520 --> 00:16:48,940
...وبسبب ذلك

185
00:16:50,170 --> 00:16:51,820
هدأتُ قليلاً

186
00:16:55,820 --> 00:16:57,400
أقول لكِ بأنّه لا جدوى

187
00:17:07,000 --> 00:17:08,000
حمقاء

188
00:17:08,500 --> 00:17:10,530
أتعتقدين حقّاً بأنّ الوقت مُناسب
للقتال بنزاهة؟

189
00:17:12,720 --> 00:17:14,220
اقرئي عقلي

190
00:17:18,750 --> 00:17:19,700
!حسناً

191
00:17:47,170 --> 00:17:48,330
تلويحة تجاه الأسفل

192
00:17:48,790 --> 00:17:51,520
ليست بشدّة الأولى

193
00:17:53,490 --> 00:17:55,700
يمكنني التّمييز من خلال تبديله لوزنه

194
00:17:55,700 --> 00:17:58,340
كان ينوي التّراجع، بعد الهجوم

195
00:18:00,250 --> 00:18:02,860
تحتاجين للدّفاع أثناء الانزياح نحو الدّرج

196
00:18:10,770 --> 00:18:11,780
ممتاز

197
00:18:12,960 --> 00:18:15,280
التّالي، صوّبي نحو اليد اليسرى

198
00:18:18,400 --> 00:18:22,710
سيُراوغ، لكن الغاية هي جعله يتراجع

199
00:18:24,780 --> 00:18:27,920
اصعدي الدّرج، لا تدعيه يحظى بأرضيّة أعلى

200
00:18:29,690 --> 00:18:31,570
سيُهاجم جذعكِ من جديد

201
00:18:32,220 --> 00:18:34,460
...توجّهي نحوه، استخدمي التّرس للصدّ

202
00:18:37,640 --> 00:18:39,630
وصوّبي نحو ذراعه

203
00:18:41,850 --> 00:18:46,180
ما زال إيدو لم يُتقن تلك الذّراع
اليسرى الضّخمة

204
00:18:46,980 --> 00:18:50,550
ابقي قريبة وذلك كي تصبح قوّة
ذلك السّيف الّذي يُحمَل باليدين كليلاً

205
00:18:52,680 --> 00:18:54,150
اقهريه بهجمات مُتعدّدة

206
00:18:54,830 --> 00:18:57,280
لا هجمات قاطِعة. عليكِ بالهجمات الاندفاعيّة

207
00:18:57,840 --> 00:18:59,360
حاضرة يا مُعلّم

208
00:19:01,020 --> 00:19:02,620
ما مُشكلتها؟

209
00:19:02,960 --> 00:19:04,600
!تطوّر مُستواها فجأة

210
00:19:06,320 --> 00:19:09,510
بتحرُّك جوغامين بالطّريقة الّتي
،ينبغي لها أن تتحرّكها

211
00:19:09,510 --> 00:19:11,910
يمكنها تقديم أداء جيّد في القتال

212
00:19:14,660 --> 00:19:15,550
...عشرة أُخَر

213
00:19:17,200 --> 00:19:18,110
...خمسة ثوانٍ

214
00:19:19,800 --> 00:19:21,090
ثمّ ثغرة

215
00:19:22,500 --> 00:19:23,510
...هذا كلّ ما أحتاجه

216
00:19:24,360 --> 00:19:26,100
!تبّاً

217
00:19:38,990 --> 00:19:40,110
لإنهاء هذا

218
00:20:06,210 --> 00:20:09,020
!تبّاً، هذا مُؤلم

219
00:20:09,790 --> 00:20:13,520
ما... هذا...؟

220
00:20:47,160 --> 00:20:49,360
كانت صيحة موت غريبة جدّاً

221
00:20:50,830 --> 00:20:56,980
لا بُدّ أنّ إيشينو كان أغبى ممّا ظننتُ
إذا خسرَ أمام هذا الفاشل

222
00:20:58,800 --> 00:21:01,590
عندما أراه في الجحيم، سأؤنّبه تأنيباً شديداً

223
00:22:35,460 --> 00:22:36,830
جوغامين آكي

224
00:22:37,330 --> 00:22:39,060
ابنة مُعلّمي

225
00:22:39,060 --> 00:22:40,300
...إنّها

226
00:22:40,300 --> 00:22:41,920
أنا يوشا

227
00:22:42,330 --> 00:22:45,800
إن لم أكن كذلك، فماذا أكون غير ذلك؟

228
00:22:46,020 --> 00:22:47,550
،الحلقة القادمة، الحلقة 12

229
00:22:47,950 --> 00:22:49,360
"سرّ يوشا"