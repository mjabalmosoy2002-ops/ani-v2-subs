1
00:01:36,080 --> 00:01:38,030
يبدو أنّني ربحت

2
00:01:38,510 --> 00:01:42,990
وبهذا لدى إمبراطوريّتي الجنوبيّة قرن
من الهيمَنة للتطلُّع له

3
00:01:42,990 --> 00:01:44,790
أتريد لعبة أُخرى؟

4
00:01:45,280 --> 00:01:47,590
!ليس لديك شيء

5
00:01:47,590 --> 00:01:48,790
!سنلعب ثانية

6
00:01:49,090 --> 00:01:52,550
وهذه اللّعبة السّابقة ساعدتني في
!اكتشاف نقطة الضّعف لدى قوايّ

7
00:01:53,070 --> 00:01:56,300
هذا ما تقوله في كلّ مرّة يا ياشيرو

8
00:01:56,570 --> 00:02:00,560
على أيّ حال، ماذا حدث مع كونت
الأشواك الكهرمانيّة؟

9
00:02:06,460 --> 00:02:07,560
سؤال وجيه

10
00:02:08,090 --> 00:02:10,960
لا يبدو أنّ تلك الذّراع الغريبة
،ستنمو من جديد

11
00:02:10,960 --> 00:02:12,710
لذا سلّمناه للأكاديميّة

12
00:02:12,710 --> 00:02:14,570
سيُزجّ في السّجن غالباً

13
00:02:14,570 --> 00:02:16,950
لكن كان ذلك مُبهراً

14
00:02:18,000 --> 00:02:21,070
القدرة التجدُّديّة الّتي أظهرها

15
00:02:21,480 --> 00:02:23,830
هل هي نتيجة عمليّة جراحيّة تحسينيّة
جديدة ما، يا ترى؟

16
00:02:24,790 --> 00:02:26,830
!آمل ألّا يكون كذلك

17
00:02:27,810 --> 00:02:29,740
...اليوشا وملوك الظّلام

18
00:02:29,740 --> 00:02:31,790
الأشخاص أصحاب التّعزيز الأثيريّ

19
00:02:31,790 --> 00:02:35,310
يستطيعون شفاء عِظام مكسورة
،وجروح طلقات ناريّة بسرعة

20
00:02:35,310 --> 00:02:39,340
لكن، نظراً لبطء الدّورة الدّمويّة، لا يستطيعون
تجديد طرف مبتور

21
00:02:40,250 --> 00:02:45,260
لهذا نقاتل بأسلحة قديمة مثل السّيوف

22
00:02:46,800 --> 00:02:53,480
ظنّ أشواك بأنّ جماعة أُخرى ما
قد أرسلَتْني لاستهدافه

23
00:02:54,390 --> 00:02:58,130
...وأوهم الآخرين بأنّه استخدم عقّاراً ما

24
00:02:58,900 --> 00:03:02,320
حسناً، إذا كانت عقاقير السّحر تجعل
،النّاس يُنمّون أطرافَ مسعورة

25
00:03:02,320 --> 00:03:03,910
فهذه مُشكلة على ما يبدو

26
00:03:04,670 --> 00:03:07,410
أتريد التحرّي حول ذلك؟

27
00:03:07,690 --> 00:03:11,790
مُحال! ليس وكأنّ هناك فائدة ماليّة

28
00:03:11,790 --> 00:03:14,050
لستُ متأكّداً من ذلك

29
00:03:22,740 --> 00:03:26,460
فضلاً عن هذا، كان ذلك
!العمل لوحده صعباً

30
00:03:26,460 --> 00:03:28,300
،كانت ذراعي مُحطّمة

31
00:03:28,300 --> 00:03:31,190
حتّى اضطررتُ لاستخدام جرعة
أُخرى من إي-3 لمُعالجتها

32
00:03:31,680 --> 00:03:33,870
ثلاثة في ليلة واحدة

33
00:03:33,870 --> 00:03:36,190
ما يُساوي شهرين من الإيجار

34
00:03:37,200 --> 00:03:39,320
،تظلّ تحقن نفسك هكذا

35
00:03:39,320 --> 00:03:41,700
سينتهي المطاف بك مُدمناً

36
00:03:42,890 --> 00:03:43,950
!اصمت

37
00:03:44,540 --> 00:03:48,300
ارتأيتُ بأنّك ستكون مسروراً بامتلاك
دليل حول عمل ثابت

38
00:03:49,200 --> 00:03:51,600
أليس لديك تلميذات الآن؟

39
00:03:51,600 --> 00:03:53,910
وظريفات فوق ذلك أيضاً

40
00:03:53,910 --> 00:03:55,210
!على العكس تماماً

41
00:03:55,580 --> 00:03:57,740
صدّقني، ثمّة شيء يجري مع أولئك الثّلاثة

42
00:03:57,740 --> 00:04:01,100
إنّهن تلميذات، ألا ينبغي أن يتعلّمن
من أساتذتهن؟

43
00:04:01,720 --> 00:04:05,700
أرغب في اتّخاذ واحدة مُقابل 100،000
في الشّهر الواحد

44
00:04:05,700 --> 00:04:07,220
يبدو هذا مُسلّياً

45
00:04:07,220 --> 00:04:08,720
هذا لأنّك مُنحرف لعين

46
00:04:09,680 --> 00:04:13,730
إذاً رفضت العمل يا ياشيرو؟

47
00:04:14,020 --> 00:04:16,580
حاولتُ ذلك على الأقلّ

48
00:04:17,850 --> 00:04:20,730
ما رأيك أن تُبرّر موقفهن هذا إذاً؟

49
00:04:30,640 --> 00:04:32,540
!صحيح! سنغادر بعد قليل

50
00:04:32,540 --> 00:04:35,370
أتينا لنُقدّم شكرنا ونلقي التّحيّة

51
00:04:35,370 --> 00:04:38,130
لا أحتاج شكراً دون إرفاقه برقم

52
00:04:38,670 --> 00:04:41,130
ألم توفّري الـ 20 ميل خاصّتي بعد؟

53
00:04:41,130 --> 00:04:42,810
!لا، ليس بعد

54
00:04:42,810 --> 00:04:45,990
!لكن لديّ أجور التّدريس لهذا الشّهر

55
00:04:50,180 --> 00:04:51,230
!عليّ الخروج من هنا

56
00:04:51,230 --> 00:04:52,100
!لا عليك يا سيّدي

57
00:04:52,100 --> 00:04:55,940
نحن مُستعدّات لدروس أكثر صرامة
!حتّى، ابتداء من الغد

58
00:04:57,580 --> 00:04:58,900
المُعلّم ياشيرو

59
00:05:00,690 --> 00:05:01,910
أعتذر

60
00:05:02,450 --> 00:05:04,450
أنت قويّ جدّاً حقّاً

61
00:05:06,450 --> 00:05:08,900
أجل، أنا كذلك

62
00:05:09,390 --> 00:05:11,700
لذا لنخرج من هنا، قبل أن أطردكن

63
00:05:12,230 --> 00:05:15,330
هل هذا يعني أن أقاتلك؟

64
00:05:15,660 --> 00:05:18,960
أهكذا أصبح أقوى؟

65
00:05:22,150 --> 00:05:23,450
تمهّلي لحظة

66
00:05:23,450 --> 00:05:26,700
أوّلاً، عليّ أن أشكرك

67
00:05:27,990 --> 00:05:29,810
فقد أنقذتني، صحيح؟

68
00:05:29,810 --> 00:05:32,720
وأنقذت آكي ويوكيني أيضاً

69
00:05:33,720 --> 00:05:35,050
...أنتِ

70
00:05:36,480 --> 00:05:38,850
تبدين منطقيّة بعض الشّيء

71
00:05:38,850 --> 00:05:40,220
هذا مُفاجئ، نظراً للمظاهر

72
00:05:41,120 --> 00:05:44,010
أقصد بأنّني لستُ مُقتنعاً حتّى
بأنّ الأُخرَتَين تتكلّمان اليابانيّة

73
00:05:45,830 --> 00:05:49,280
،مقصدي هو أنّني آسفة لمُفاجأتك بهذا

74
00:05:49,280 --> 00:05:52,990
لكن نحن الثّلاثة على وشك الطّرد
من الأكاديميّة

75
00:05:52,990 --> 00:05:54,930
!أنتِ أيضاً؟

76
00:05:54,930 --> 00:05:56,230
!هذا ليس من شأني

77
00:05:56,230 --> 00:05:58,750
!استمتعن بالطّرد أو الرّسوب أو أيّاً يكن

78
00:05:59,110 --> 00:06:00,580
...هذا

79
00:06:06,850 --> 00:06:09,370
إنّه أبي

80
00:06:10,490 --> 00:06:14,820
آسفة، إنّه عازم على شكرك

81
00:06:18,870 --> 00:06:20,020
مرحباً؟

82
00:06:21,600 --> 00:06:25,670
سامحني على الاتّصال متأخّراً
يا حصّاد الموتى ياشيرو

83
00:06:25,670 --> 00:06:28,980
يبدو أنّك ساعدت ابنتي وصديقتيها

84
00:06:29,870 --> 00:06:35,740
أوّلاً، أريد التّعبير عن امتناني
على إنقاذ سارة

85
00:06:36,900 --> 00:06:40,380
مهلاً، ماذا عن "شكراً جزيلاً لك"؟

86
00:06:40,380 --> 00:06:43,040
أعتقد بأنّ ابنتك استمدّتْ سوء
آداب السّلوك منك

87
00:06:43,390 --> 00:06:46,780
لكن بالنّظر إلى أنّك أرسلتها
،إلى الأكاديميّة أساساً

88
00:06:44,750 --> 00:06:47,980
هل أخبرتِه بأيّ شيء؟

89
00:06:46,780 --> 00:06:48,570
!فغالباً لست أباً جيّداً على أيّ حال

90
00:06:47,980 --> 00:06:50,800
لا. لم يسأل أبداً

91
00:06:48,570 --> 00:06:50,800
أم ماذا؟ هل أنت يوشا أيضاً؟

92
00:06:51,430 --> 00:06:54,180
ألم تخبرك ابنتي؟

93
00:06:54,940 --> 00:06:56,810
أعتذر على ذلك

94
00:06:57,140 --> 00:07:00,820
اسمي آرثر بيندراغون

95
00:07:00,820 --> 00:07:04,690
الرّئيس 507 لمُؤسّسة الطّاولة المُستديرة

96
00:07:04,690 --> 00:07:09,700
وكذلك رئيس الفرع اليابانيّ من الأكاديميّة

97
00:07:12,470 --> 00:07:13,760
أيُعقَل هذا؟

98
00:07:13,760 --> 00:07:19,560
إذاً مُسبّبة المشاكل الصّغيرة هذه هي
!ابنة ذلك السُّمّ الشّيطانيّ آرثر؟

99
00:07:20,960 --> 00:07:25,170
سمعتُ بإنجازاتك منذ مدّة

100
00:07:25,650 --> 00:07:28,370
أثبتّ بأنّك يوشا موهوب

101
00:07:28,370 --> 00:07:32,340
أثناء الصّراع مع كونت الثّعبان السّاطع

102
00:07:32,880 --> 00:07:35,010
حسناً، شكراً على الإطراء

103
00:07:35,010 --> 00:07:39,440
أعتقد لم تكن هناك ضرورة لي
في ذلك اليوم إذاً

104
00:07:39,440 --> 00:07:41,500
،فلو تدخّلتَ أنت

105
00:07:41,500 --> 00:07:45,120
لاستطعتَ غالباً إنقاذ الآنسة
الصّغيرة بأمان أكبر

106
00:07:46,220 --> 00:07:49,600
،لا. نظراً لمنصبي

107
00:07:49,600 --> 00:07:53,610
لا أستطيع مُعاملة ابنتي بشكل
مُختلف عن الآخرين

108
00:07:54,020 --> 00:07:56,870
لهذا السّبب أنا مُمتنّ حقّاً

109
00:07:56,870 --> 00:07:58,580
حقّاً؟

110
00:07:58,580 --> 00:08:03,250
إذاً ألن نكون بحال أفضل إذا استقالت الفتاة
من العمل كيوشا في أسرع وقت؟

111
00:08:03,670 --> 00:08:06,330
إنّها غالباً على وشك الطّرد حسبما سمعت؟

112
00:08:06,330 --> 00:08:09,000
لا أعتقد بأنّ ابنتك مُؤهّلة لذلك

113
00:08:10,680 --> 00:08:12,050
أتّفق

114
00:08:13,070 --> 00:08:15,220
هي وصديقتاها لديهن سِمات شخصيّة

115
00:08:15,220 --> 00:08:19,220
تُسبّب مُشكلة كيوشا

116
00:08:20,520 --> 00:08:23,660
وكنتُ أقول لنفسي بأنّ المنهاج
المدرسيّ في الأكاديميّة وحده

117
00:08:23,660 --> 00:08:25,800
لن يكون كافياً لمُساعدتهن في ذلك

118
00:08:26,770 --> 00:08:31,080
ولحسن الحظّ، يبدو أنّك اكتسبت ثقتهن

119
00:08:31,080 --> 00:08:34,600
—مهلاً لحظة! فعلتُ فقط ما تمّ استئجاري لـ
...التّعليم ليس

120
00:08:34,600 --> 00:08:37,410
،أتصوّر أنّه سيكون مصدر دخل أكثر ثباتاً

121
00:08:38,070 --> 00:08:40,580
مُقارنة بمحاولة الحصول
على 20 مليون من قاصر

122
00:08:43,840 --> 00:08:45,990
شكراً لك ثانية على تقديمك التّوجيهات

123
00:08:46,760 --> 00:08:47,520
وداعاً

124
00:08:47,520 --> 00:08:48,620
—انتظر

125
00:08:57,950 --> 00:09:01,810
بربّكن يا فتيات، أتُردنَ حقّاً أن
يُعلّمكن شخصٌ كهذا؟

126
00:09:02,160 --> 00:09:05,790
ألم يكن على وشك الموت
إلى أن أنقذتِه يا آنسة؟

127
00:09:05,790 --> 00:09:08,580
!أعتقد بأنّ هذا يجعله نحساً كاذباً

128
00:09:09,420 --> 00:09:10,070
!أجل

129
00:09:11,840 --> 00:09:15,400
،لكن في نفس الوقت، إنّه فخور ولطيف

130
00:09:15,400 --> 00:09:18,030
!ولا يتخلّى عن المحتاجين

131
00:09:19,020 --> 00:09:22,080
!إنّه يوشا جدير بإعجابنا

132
00:09:25,940 --> 00:09:28,110
!إيد، إليّ بواحد آخر

133
00:09:38,610 --> 00:09:39,600
...إذاً

134
00:09:39,920 --> 00:09:43,350
ولهذا، أرغب في تقديم تحيّاتي
!رسميّاً لأصدقاء المُعلّم

135
00:09:43,350 --> 00:09:46,100
!لا ضرورة لذلك! عودي إلى المنزل

136
00:09:46,560 --> 00:09:49,760
...لكن إذا كنّا سنرى بعضنا الآخر ثانية

137
00:09:48,720 --> 00:09:50,610
!لن تفعلي! اذهبنَ هيّا

138
00:09:50,880 --> 00:09:52,820
أتريدين تجربة هذه؟

139
00:09:52,820 --> 00:09:54,610
!تبّاً، كُفّ عن إطعامها

140
00:09:54,910 --> 00:09:58,050
أنا، جوغامين، سأكون فخورة
!بالتغنّي بإنجازات المُعلّم

141
00:09:58,050 --> 00:10:00,060
!إيّاكِ فحسب! انقلعي

142
00:10:01,910 --> 00:10:04,660
يمكنك إيجادي هنا في العادة
في أيّام الإثنين

143
00:10:04,660 --> 00:10:06,500
...إذا احتجتِ أي مُساعدة إضافيّة

144
00:10:10,060 --> 00:10:13,220
!كُفّ عن إعطاء رقمك لهُن

145
00:10:17,700 --> 00:10:20,260
!حسناً يا مُعلّم، إلى اللّقاء

146
00:10:20,260 --> 00:10:21,390
!إيّاكن والعودة

147
00:10:23,410 --> 00:10:24,390
!اللّعنة

148
00:10:25,390 --> 00:10:28,460
!أقسم بأنّني لن أتّخذ أي تلميذ لعين

149
00:11:04,420 --> 00:11:06,930
أظنّني سآكل في الخارج

150
00:11:16,930 --> 00:11:17,990
!إيندو

151
00:11:22,910 --> 00:11:25,440
كـ-كيف وجدت عنواني؟

152
00:11:26,360 --> 00:11:28,590
أخبرني ذو النّظّارة

153
00:11:30,530 --> 00:11:33,170
...اللّعين

154
00:11:34,340 --> 00:11:35,770
حسناً، ماذا تريدين؟

155
00:11:36,330 --> 00:11:38,900
هل الأمر يتعلّق بتعليمي لكُن؟
"ما زالت الإجابة "لا

156
00:11:39,560 --> 00:11:41,120
يتعلّق بذلك

157
00:11:41,120 --> 00:11:44,080
،إن كنت لا تقبل أن يتتلمذ أحدٌ على يدك
فلا أُمانع التعلُّم من خلال دروس

158
00:11:44,080 --> 00:11:46,800
دروس فرديّة، ستّون دقيقة في الجلسة

159
00:11:46,800 --> 00:11:49,180
عشرون ألف للدّرس. ما قولك يا مُعلّم؟

160
00:11:50,770 --> 00:11:52,190
!المُشكلة ليست المال

161
00:11:53,510 --> 00:11:54,690
ثلاثون ألف

162
00:11:56,260 --> 00:11:57,900
!لا أحتاجها

163
00:12:01,430 --> 00:12:02,250
هكذا إذاً

164
00:12:10,200 --> 00:12:11,710
التّاكوياكي الاعتياديّ

165
00:12:12,260 --> 00:12:14,710
القطعة بثمانية. سآكل هنا

166
00:12:15,100 --> 00:12:17,180
كان بوسعي أن أدعوك على حسابي

167
00:12:17,960 --> 00:12:19,960
لا، شكراً. ارحلي

168
00:12:24,790 --> 00:12:26,720
أنتِ ثريّة جدّاً كتلميذة في الثّانويّة

169
00:12:28,480 --> 00:12:30,970
الأكاديميّة تدفع لنا

170
00:12:31,520 --> 00:12:32,540
أتريد بعضاً؟

171
00:12:33,940 --> 00:12:35,840
!لن أقع ضحيّة ذلك

172
00:12:37,590 --> 00:12:39,730
تبدو الأكاديميّة رائعة

173
00:12:40,030 --> 00:12:42,940
،تدفعين 100 أو 200 ألف في الشّهر

174
00:12:43,740 --> 00:12:47,110
ويعلّمونكِ كيف تقتلين النّاس
ويفسدون مُستقبلكِ

175
00:12:48,490 --> 00:12:50,870
أعيش في الحرم الدّراسي مجّاناً أيضاً

176
00:12:50,870 --> 00:12:52,170
لهذا أنا ثريّة

177
00:12:53,500 --> 00:12:56,880
حضرة المُدرّس، هل أنت مُشرّد الآن؟

178
00:12:56,880 --> 00:12:59,010
لا. لديّ بضعة أماكن في الواقع

179
00:12:59,010 --> 00:13:00,750
كلّ ذلك الإيجار مهدور

180
00:13:01,200 --> 00:13:02,330
إذاً لا عنوان ثابت؟

181
00:13:02,330 --> 00:13:03,830
!الأمر ليس كذلك

182
00:13:03,830 --> 00:13:06,760
إنّها فقط ليست الأماكن الّتي أستطيع
الاسترخاء فيها والتّركيز على العمل

183
00:13:08,970 --> 00:13:09,890
إذاً أنت عاطل عن العمل؟

184
00:13:09,890 --> 00:13:11,140
!ليس بهذه الصّيغة

185
00:13:12,170 --> 00:13:16,090
،عندما تكونين يوشا درجة أولى مثلي
فإنّ ذلك يُصاحبه مجموعة من المشاكل

186
00:13:16,090 --> 00:13:21,650
فملوك الظّلام يرسلون عصابات إمّا
...لقتلي أو مُحاولة تجنيدي

187
00:13:21,650 --> 00:13:23,260
سمعتُ بذلك

188
00:13:24,960 --> 00:13:28,200
،قال بأنّك تتعرّض لهجوم طوال الوقت

189
00:13:28,200 --> 00:13:30,080
وبأنّني ينبغي أن أُساعدك

190
00:13:31,200 --> 00:13:34,020
...لا يعلم إيشينو اللّعين متى يصمت

191
00:13:44,550 --> 00:13:46,850
عليكِ حقّاً التخلّي عن هُراء يوشا هذا

192
00:13:47,800 --> 00:13:50,030
،أجل، قد تصبحين قويّة

193
00:13:50,980 --> 00:13:54,810
لكن إذا ضربكِ أحدٌ في الرّأس من
دون تجرُّع إي.3؟ فانتهى الأمر

194
00:13:55,040 --> 00:13:58,440
لكن... أريد أن أصبح أقوى

195
00:14:10,550 --> 00:14:11,660
ها أنا ذاك

196
00:14:20,880 --> 00:14:23,980
،أعلم بأنّكِ لستِ غير مُتمرّسة بالمرّة

197
00:14:23,980 --> 00:14:27,050
لكن لن أتمكّن من رعاية أحد آخر اليوم

198
00:14:29,050 --> 00:14:31,140
لذا لا تلوميني إذا مُتِّ

199
00:14:31,140 --> 00:14:33,870
حسناً. سأبلي بلاء حسناً هذه المرّة

200
00:14:54,380 --> 00:14:55,990
...مضى بعض الوقت

201
00:14:57,250 --> 00:14:59,330
يا حصّاد الموتى ياشيرو

202
00:14:59,680 --> 00:15:01,990
بقدر ما أتمنّى قتلك على

203
00:15:01,990 --> 00:15:05,750
خطاياك المُتراكمة وإهاناتك
،بحقّ مُعلّمي

204
00:15:06,210 --> 00:15:08,620
،إلّا إنّه شخص كريم

205
00:15:08,620 --> 00:15:12,470
ويُفضّل أن أقبض عليك سليماً، إن أمكن

206
00:15:13,080 --> 00:15:15,980
!سيّدي، سلّم نفسك لرايتنا

207
00:15:18,050 --> 00:15:19,100
مُحال

208
00:15:20,350 --> 00:15:22,980
حضرة المُدرّس، هل تعرفهم؟

209
00:15:22,980 --> 00:15:25,260
أجل، أعرفهم منذ فترة

210
00:15:26,400 --> 00:15:28,630
فذلك هو كوت الكمّاشتين التوأمتين

211
00:15:29,190 --> 00:15:31,990
تابع لملك ملوك الظّلام الّذي
يدير الأعمال هنا

212
00:15:32,660 --> 00:15:36,250
وملك ملوك الظّلام ذاك مُزعج للغاية

213
00:15:36,250 --> 00:15:40,000
يبدو أنّه يريدني في صفّه
لدرجة الاستعداد لخطفي

214
00:15:40,000 --> 00:15:41,160
خطف؟

215
00:15:41,710 --> 00:15:45,130
لا أصدّق بأنّ المرء يمكن أن يعمل لحساب
شخص فقط لأنّه خطفَه

216
00:15:45,130 --> 00:15:49,540
،إلّا إذا كانت هناك سُبُلاً لفرض الأمر
حالما يصبح الشّخص في قبضتك

217
00:15:51,230 --> 00:15:54,640
رغم ذلك، إنّه بمثابة مسرح
للحصول على إضافي

218
00:15:55,470 --> 00:15:58,390
كانت مُكافأتك 10 مليون؟

219
00:15:58,390 --> 00:16:00,390
خمسة عشر مليون

220
00:16:00,810 --> 00:16:03,600
...يبدو أنّك لا تفهم سخاء سيّدي

221
00:16:03,600 --> 00:16:05,110
فليكُن إذاً

222
00:16:05,110 --> 00:16:07,860
،عندما أضربك وأُصيبك في قتال مُشرّف

223
00:16:08,210 --> 00:16:10,690
!فسوف أغتنمك كجائزة لي

224
00:16:21,250 --> 00:16:24,560
كم شخصاً تنوي إقحامه في معركة
!الشّرف هذه بيننا؟

225
00:16:24,560 --> 00:16:26,270
إنّه إجراء احترازيّ طبيعيّ

226
00:16:26,270 --> 00:16:28,500
أنت تسافر مع أحد أتباعك، أليس كذلك؟

227
00:16:28,810 --> 00:16:32,260
إنّها ليست من أتباعي وليس لديّ
!أي ارتباط بيني وبينها

228
00:16:33,290 --> 00:16:35,090
!كم هذا مُثير للاشمئزاز

229
00:16:35,090 --> 00:16:38,260
ما الّذي لديك حتّى انجذب سيّدي إليك؟

230
00:16:39,970 --> 00:16:43,140
!أنت أكبر بكثير من مُواعدة فتاة صغيرة

231
00:16:43,140 --> 00:16:45,520
!أيّها اللّوليكون اللّعين

232
00:16:46,650 --> 00:16:48,400
!من تنعته باللّوليكون؟

233
00:16:49,280 --> 00:16:50,400
!لولي؟

234
00:17:01,040 --> 00:17:02,300
حضرة المُدرّس

235
00:17:03,200 --> 00:17:05,790
هل يمكنني قتله؟

236
00:17:07,510 --> 00:17:08,350
بالتّأكيد

237
00:17:08,870 --> 00:17:10,780
لكن اسمحي لي بأن أسدي إليكِ بنصيحة

238
00:17:11,350 --> 00:17:14,840
عندما تبدئين بالتحرُّك، انتظري إشارتي

239
00:17:15,630 --> 00:17:17,460
إنّه قويٌّ جدّاً في الواقع

240
00:17:18,130 --> 00:17:19,430
عُلِم

241
00:17:19,430 --> 00:17:21,100
اقتلوه إذا اضطرّ الأمر

242
00:17:21,310 --> 00:17:22,260
!هيّا

243
00:17:24,960 --> 00:17:26,900
كونت الكمّاشتين التّوأمتين

244
00:17:26,900 --> 00:17:29,480
يتصرّف كأحمق، لكنّه يقاتل بحذر شديد

245
00:17:30,000 --> 00:17:32,980
...أفضّل ألّا أكشف عمّا في جعبتي

246
00:17:34,810 --> 00:17:37,380
!لكن لا أملك خياراً بالضّرورة

247
00:18:44,690 --> 00:18:46,060
!هيّا يا رجل

248
00:18:46,060 --> 00:18:47,760
أهذا كلّ ما لديك؟

249
00:18:47,760 --> 00:18:49,060
هل أنت تحاول أصلاً؟

250
00:19:13,710 --> 00:19:15,710
!إيندو! اذهبي

251
00:19:25,240 --> 00:19:27,720
!إدراك أثيريّ للانتقال الآنيّ؟

252
00:19:27,720 --> 00:19:29,600
!لا بُدّ أنّها كانت توفّر هذا لهذه اللّحظة

253
00:19:38,820 --> 00:19:40,700
!تفرّقوا! سوف ننسحب

254
00:20:06,720 --> 00:20:09,210
إيندو، لديكِ بعض القيود، صحيح؟

255
00:20:09,210 --> 00:20:10,260
قيّديهم

256
00:20:21,210 --> 00:20:22,570
لن تقتلهم؟

257
00:20:23,220 --> 00:20:25,630
سيأتي المسؤولون قريباً

258
00:20:25,630 --> 00:20:27,740
إنّ قتلهم الآن سيزيد الأمور تعقيداً لاحقاً

259
00:20:31,700 --> 00:20:32,960
ماذا تفعل؟

260
00:20:33,470 --> 00:20:34,830
غنائم حرب

261
00:20:34,830 --> 00:20:38,930
!لدى هذا الشّخص أشياء كثيرة
!حتّى بعض الإي-3! حصاد وفير

262
00:20:41,120 --> 00:20:42,260
حصّتي

263
00:20:42,260 --> 00:20:43,970
!توقّفي! كلّها لي

264
00:20:45,600 --> 00:20:47,600
هل كنتُ مُفيدة؟

265
00:20:49,040 --> 00:20:51,220
أجل، هذا ما أعتقده

266
00:20:51,220 --> 00:20:53,170
جيّد. يسرّني ذلك

267
00:20:54,060 --> 00:20:55,230
كان ذلك درساً مُفيداً

268
00:20:58,700 --> 00:21:01,770
"ما زلتُ لا أريد أن أصبح "مُدرّسكِ
أو ما شابه، مفهوم؟

269
00:22:35,470 --> 00:22:38,410
"!الحلقة القادمة في "مهام يوشا خدميّة

270
00:22:38,410 --> 00:22:40,170
سوف نتحرّى حول

271
00:22:40,170 --> 00:22:43,080
القدرة التجدُّديّة لكونت الأشواك
!الكهرمانيّة يا مُعلّم

272
00:22:43,080 --> 00:22:43,980
!لحظة، سأذهب أيضاً؟

273
00:22:43,980 --> 00:22:47,390
!لنغادر يا مُعلّم! حان وقت بذل الجهود

274
00:22:47,390 --> 00:22:49,390
!لكن لا أريد العمل