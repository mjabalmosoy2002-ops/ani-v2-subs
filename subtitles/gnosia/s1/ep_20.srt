1
00:00:01,040 --> 00:00:02,880
...إن أخذتُ هذا المفتاح الفضّيّ

2
00:00:03,610 --> 00:00:04,600
.أيّها اللّصّ

3
00:00:05,140 --> 00:00:06,550
...راكيو

4
00:00:06,550 --> 00:00:10,400
.يا إلهي. إنّ حماقتك لا تكفّ عن إذهالي أبدًا

5
00:00:10,400 --> 00:00:13,780
.باختصار، لم تعني تحذيراتي أيّ شيء لك

6
00:00:13,780 --> 00:00:15,660
...أعلم ذلك، ولكن

7
00:00:15,660 --> 00:00:18,710
ما الّذي ستفعله حيال مشكلة
الوجود المزدوج؟

8
00:00:18,710 --> 00:00:24,620
إن ذهبت إلى هناك، سيصير
.وجودك المزدوج ممكنًا مرّة أخرى

9
00:00:28,590 --> 00:00:32,520
إذًا كنتَ تخطّط للقفز قبل
حتّى أن تنظر، صحيح؟

10
00:00:32,840 --> 00:00:35,300
،ناهيك عن ذكر أنّك إن صرت مضيفه

11
00:00:35,300 --> 00:00:39,970
فستُحاصر ثانية في حلقات زمنيّة
.قد لا تهرب منها أبدًا

12
00:00:40,550 --> 00:00:44,480
إنّها لمعجزة أنّك استطعت إنهاء
.حلقاتك والوقوف هنا الآن

13
00:00:44,880 --> 00:00:48,500
هل تعتقد فعلاً أنّ بإمكانك
صنع تلك المعجزة ثانية؟

14
00:00:50,230 --> 00:00:53,910
.لا أدري... لكن سيكون لديّ وقت

15
00:00:54,520 --> 00:00:55,800
وقت؟

16
00:00:55,800 --> 00:00:56,650
.نعم

17
00:00:57,300 --> 00:01:02,470
،كلّما واصلتُ دخول حلقات
.سيكون لديّ وقت أكثر لاكتشاف الأمر

18
00:01:04,030 --> 00:01:05,160
...وأيضًا

19
00:01:06,250 --> 00:01:07,610
.لن أكون وحدي

20
00:01:07,610 --> 00:01:10,430
،حتّى إن كنتُ في تلك الحلقات
.ستكونون جميعًا معي

21
00:01:11,260 --> 00:01:14,600
ستساعدونني على الوصول إلى أفكار
...وقرارات ما كنت لأصل إليها وحدي

22
00:01:16,050 --> 00:01:17,890
.والأهمّ من ذلك، ستمنحونني الشّجاعة

23
00:01:20,130 --> 00:01:22,800
.لا أعرف كم سيتطلّب ذلك من وقت

24
00:01:23,340 --> 00:01:27,960
ولكن... إن كنتم جميعًا معي
.فأنا واثق أنّي سأنجح

25
00:01:29,240 --> 00:01:33,680
سأصل إلى نهاية لن يكون
.فيها أيّ أحد تعيسًا

26
00:01:38,630 --> 00:01:42,440
بلغتَ مستوى من الحماقة
.صار منعشًا بطريقة ما

27
00:01:42,440 --> 00:01:44,880
.خذه أيّها اللّصّ

28
00:01:49,280 --> 00:01:53,460
هذه ثاني مرّة أحصل فيها على
.المفتاح الفضّيّ منك في الحقيقة

29
00:01:53,830 --> 00:01:58,560
.هذا لا يُصدّق
.أعتقد إذًا أنّك لصّ مزدوج

30
00:02:00,550 --> 00:02:05,470
"الحلقة 20: عالم نجوم"

31
00:02:05,320 --> 00:02:06,800
حلقة زمنيّة؟

32
00:02:07,090 --> 00:02:09,820
ستذهب في رحلة
عبر الزّمن بذلك الشّيء؟

33
00:02:10,250 --> 00:02:11,240
.نعم

34
00:02:11,240 --> 00:02:14,410
سأملأ هذا المفتاح الفضّيّ
بالمعلومات مرّة أخرى

35
00:02:14,410 --> 00:02:16,260
.وأفتح بوّابة الأبعاد

36
00:02:16,820 --> 00:02:20,830
ثمّ سأعثر على سِتسو وسأربط
.أخيرًا بين السّبب والنّتيجة

37
00:02:21,110 --> 00:02:25,990
.إنّ سماعك تتحدّث يصيبني بالدّوار يا يوري

38
00:02:25,990 --> 00:02:29,380
عـ-عفوًا، ماذا تعني بالسّبب والنّتيجة؟

39
00:02:29,600 --> 00:02:31,800
ما الّذي يحدث؟

40
00:02:32,210 --> 00:02:36,300
.يبدو أنّنا بحاجة لتفسير

41
00:02:36,840 --> 00:02:39,850
أنت هو الرّاوي، أليس كذلك؟

42
00:02:40,160 --> 00:02:42,480
.اشرح حتّى يفهم الجميع

43
00:02:43,430 --> 00:02:44,580
.حاضر

44
00:02:45,400 --> 00:02:50,100
لا يملك أيّ أحد منكم أيّ ذكريات
.عن حلقاتي السّابقة أو سِتسو

45
00:02:50,770 --> 00:02:51,930
.حسنًا

46
00:02:53,390 --> 00:02:55,600
استعمل سِتسو الّذي كان في هذا العالم

47
00:02:55,600 --> 00:02:59,290
،مفتاحي الفضّيّ الممتلئ لفتح بوّابة بُعديّة

48
00:02:59,290 --> 00:03:02,980
وعبَر إلى بُعد آخر له سببه
.ونتيجته المنفصلين الخاصّين به

49
00:03:03,650 --> 00:03:10,130
،لكنّ مفتاحه الفضّيّ الخاصّ لم يمتلئ بعد
.ما يعني أنّه لا يستطيع الهروب من الحلقات

50
00:03:10,480 --> 00:03:14,090
لذلك السّبب سأملأ هذا المفتاح
،الفضّيّ مرّة أخرى

51
00:03:14,090 --> 00:03:16,440
.وأفتح البوّابة وأذهب إلى الجانب الآخر

52
00:03:17,140 --> 00:03:19,720
.ليستطيع سِتسو الخروج من حلقاته

53
00:03:21,060 --> 00:03:25,600
هل سيكون الذّهاب إلى هناك
كافيًا لإنهاء حلقات سِتسو يا يوري؟

54
00:03:25,960 --> 00:03:29,100
،ذلك ما يجب أن يحدث
.إن منحني مفتاحه الفضّيّ

55
00:03:29,690 --> 00:03:36,110
لكنّ ملء المفتاح الفضّيّ
صعب جدًّا، أليس كذلك؟

56
00:03:36,610 --> 00:03:39,370
هل أنت واثق أنّك ستستطيع
من إيجاده ثانية؟

57
00:03:39,670 --> 00:03:41,150
.لا فكرة لديّ

58
00:03:41,150 --> 00:03:42,770
.لكن عليّ أن أجرّب

59
00:03:42,770 --> 00:03:45,410
...أفترض أنّه لا مكسب بلا مخاطرة

60
00:03:45,410 --> 00:03:48,090
،تستمرّ في قول كلّ هذه الأعذار

61
00:03:48,090 --> 00:03:51,660
لكنّك في الحقيقة تطارد فتاة
أنت معجب بها فحسب، صحيح؟

62
00:03:51,660 --> 00:03:53,830
!ماذا؟! أذلك صحيح؟

63
00:03:53,830 --> 00:03:57,680
.فـ-في الحقيقة، سِتسو لا-ثنائيّ الجنس

64
00:03:57,680 --> 00:04:01,550
لكنّه يثير رغباتك، أليس كذلك؟
.أنا أفهمك تمامًا

65
00:04:01,810 --> 00:04:05,380
.نعم، راودني شعور أنّ ذلك سيعجبك

66
00:04:05,380 --> 00:04:07,630
!لا بأس بذلك في نظري

67
00:04:07,880 --> 00:04:09,880
!أيّها الخائن

68
00:04:09,880 --> 00:04:10,520
ماذا؟

69
00:04:10,520 --> 00:04:13,890
لا أصدّق أنّك خدعت إس كيو
.الظّريفة طوال هذا الوقت

70
00:04:13,890 --> 00:04:15,270
خا-خائن؟

71
00:04:16,340 --> 00:04:18,280
!من الأفضل أن تتحمّل مسؤوليّة هذا

72
00:04:18,280 --> 00:04:23,630
تذكّر تلك اللّيلة الّتي تشاركنا
!فيها السّرير أثناء القيادة الفائقة

73
00:04:23,630 --> 00:04:26,160
يوري... كيف أمكنك؟

74
00:04:25,180 --> 00:04:28,300
...يوري، أنت... إنّك سوى

75
00:04:26,480 --> 00:04:29,390
!مـ-مهلاً! ذلك ليس صحيحًا

76
00:04:29,390 --> 00:04:32,420
.هيّا. كفّي عن مزاحك هذا

77
00:04:33,260 --> 00:04:35,210
.لستُ أمزح

78
00:04:35,210 --> 00:04:40,310
لطالما ظننتُ... أنّ إس كيو الظّريفة
.شخص مميّز بالنّسبة لك

79
00:04:40,700 --> 00:04:43,870
!ذلك ما قالته عيناك على الأقلّ

80
00:04:43,870 --> 00:04:45,500
...إس كيو

81
00:04:46,590 --> 00:04:49,370
.إنّك عزيزة عليّ بشكل كبير

82
00:04:50,150 --> 00:04:51,410
.وكذلك الجميع

83
00:04:52,040 --> 00:04:57,570
لكنّ السّبب في أنّني قادر على
.التّواجد هنا الآن هو سِتسو

84
00:04:58,140 --> 00:05:01,040
لذلك لا أستطيع تحمّل فكرة
.معاناته وحده بسببي

85
00:05:02,440 --> 00:05:03,670
...نعم

86
00:05:04,920 --> 00:05:06,300
.لا يمكنني السّماح بحدوث ذلك فحسب

87
00:05:09,960 --> 00:05:12,400
حسنًا... ربّما علينا الشّرب في صحّتك الآن؟

88
00:05:12,400 --> 00:05:15,170
!نعم. لنودّعه بطريقة مذهلة

89
00:05:15,410 --> 00:05:18,920
.استمتعوا بالتّحضيرات لذلك
.أنا سأعود إلى غرفتي

90
00:05:19,320 --> 00:05:20,360
.كلاّ

91
00:05:20,360 --> 00:05:21,930
!اتركني

92
00:05:22,210 --> 00:05:26,690
.سأبدأ التّحضيرات
هلاّ ساعدتني يا جينا؟

93
00:05:27,040 --> 00:05:28,200
.أكيد

94
00:05:31,320 --> 00:05:34,610
!أنا جدّ آسف

95
00:05:34,610 --> 00:05:36,060
.كلاّ

96
00:05:36,320 --> 00:05:39,060
!على جبهتك أن تلتصق بالأرض

97
00:05:39,440 --> 00:05:41,060
!هكذا

98
00:05:43,940 --> 00:05:47,020
!أنا جدّ آسف

99
00:05:47,450 --> 00:05:48,770
ما الّذي يفعلانه؟

100
00:05:48,770 --> 00:05:51,320
.أراد يوري أن يتعلّم كيف يتوسّل ساجدًا

101
00:05:51,320 --> 00:05:53,090
.حسنًا... ذلك مختلف

102
00:05:53,090 --> 00:05:56,610
.يقول أنّها ستكون مهارة ضروريّة لمستقبله

103
00:05:58,160 --> 00:06:00,800
!قلتُ أنّ ذلك مؤلم

104
00:06:00,800 --> 00:06:05,220
.لكنّها كانت فكرتك أنت يا شيغيميتشي

105
00:06:06,350 --> 00:06:10,330
!قلت أنّك ستريني مدى صلابة جلدك

106
00:06:12,570 --> 00:06:13,790
...عجبًا

107
00:06:15,590 --> 00:06:17,230
...يوريكو

108
00:06:17,230 --> 00:06:18,930
ما قصّة هذه الملابس؟

109
00:06:19,390 --> 00:06:22,440
أليست هذه حفلة تنكّريّة؟

110
00:06:24,330 --> 00:06:27,000
!أنت ظريفة جدًّا يا يوريكوتشي

111
00:06:27,450 --> 00:06:29,840
.أيّتها الحثالة. لقد خدعتني

112
00:06:30,250 --> 00:06:31,070
.عذرًا

113
00:06:32,010 --> 00:06:34,090
.يا لها من فوضى

114
00:06:34,560 --> 00:06:37,950
لكن أفترض أنّ المراقبة من عين
.العاصفة هو من أشكال التّرفيه أيضًا

115
00:06:38,360 --> 00:06:41,750
.إليكم بعض الوجبات الخفيفة من جينا

116
00:06:47,040 --> 00:06:48,240
.مقرف

117
00:06:49,740 --> 00:06:50,960
.ذلك صريح بشكل قاسٍ

118
00:06:51,790 --> 00:06:54,720
حادثة الغنوشيا الّتي وقعت
...على كوكب لو-آن

119
00:06:55,670 --> 00:07:00,190
والأشخاص الخمسة عشر الّذي استجاروا
...منها على متن هذه السّفينة

120
00:07:01,230 --> 00:07:02,970
!يا لها من حفلة

121
00:07:02,970 --> 00:07:05,730
!يستمتع الجميع بوقتهم

122
00:07:06,290 --> 00:07:12,580
بدأت أفكّر أنّ ما جمع بيننا
.لم يكن مجرّد مصادفة

123
00:07:12,950 --> 00:07:16,990
،من أجلي، من أجلي الجميع هنا... لا

124
00:07:17,300 --> 00:07:20,410
كان هذا جزءًا حيويًّا
.من مصير العالم بأسره

125
00:07:20,410 --> 00:07:22,120
لم يكن من الممكن أن يحدث
.الأمر بأيّ طريقة أخرى

126
00:07:22,830 --> 00:07:26,310
.وكلّ واحد منهم كان جزءًا لا يُعوَّض منه

127
00:07:27,030 --> 00:07:29,630
.جميعهم أصدقاء أعزّاء على قلبي

128
00:07:35,290 --> 00:07:38,670
.أنا فعلاً عاجز عن إيجاد أيّ كلمات

129
00:07:40,530 --> 00:07:41,870
راكيو؟

130
00:07:42,220 --> 00:07:46,270
أعتقد أنّ البقاء في غرفتي
.كان الخيار الأفضل

131
00:07:50,710 --> 00:07:51,850
ما هذا؟

132
00:07:52,470 --> 00:07:54,400
.شعرتُ بالملل، فجمعتُ كلّ هذا

133
00:07:55,060 --> 00:07:59,320
،كلّ ما سيحدث من الآن فصاعدًا
.وكلّ ما ستحتاج فعله

134
00:08:01,470 --> 00:08:05,380
.إنّك أحمق بالفعل

135
00:08:05,670 --> 00:08:08,750
بصراحة، لا أستطيع أن أرى
.أنّ هذا سينتهي على خير

136
00:08:09,860 --> 00:08:11,440
.بالطّبع

137
00:08:11,440 --> 00:08:15,950
،إن دخلتُ في الحلقات ثانية
...ستحدث هذه الأمور

138
00:08:15,950 --> 00:08:19,110
!هذا رائع! أنت مذهل يا راكيو

139
00:08:19,440 --> 00:08:23,770
،سأشرح كلّ شيء تحتاج معرفته
.لذلك انقش كلّ شيء في دماغك

140
00:08:24,210 --> 00:08:28,280
لأنّ ذلك هو الشّيء الوحيد
.الّذي يمكنك أخذه في هذه الحلقات

141
00:08:28,550 --> 00:08:30,520
...حـ-حسنًا

142
00:08:31,050 --> 00:08:32,310
.أنت محقّ تمامًا

143
00:08:34,750 --> 00:08:36,540
.وهذا كلّ شيء

144
00:08:36,790 --> 00:08:39,540
!مذهل! إنّها خطّة مثاليّة

145
00:08:39,910 --> 00:08:43,830
بأيّ معنى؟ أعترف أنّ منطقي
،بحدّ ذاته كان مثاليًّا

146
00:08:43,830 --> 00:08:47,630
لكن من النّاحية العمليّة، أقول أنّ تنفيذ
.ذلك يكاد يكون مستحيلاً بالنّسبة لك

147
00:08:48,120 --> 00:08:51,870
.هذا صحيح. لكنّي سأبذل جهدي

148
00:08:52,260 --> 00:08:54,680
.لن أسمح لجهودك بأن تضيع

149
00:08:56,060 --> 00:08:59,340
.أنا حقًّا لا أفهمك

150
00:08:59,650 --> 00:09:03,140
إنّ بذل كلّ هذا الجهد وتعريض
نفسك لكلّ هذا الخطر

151
00:09:03,140 --> 00:09:05,500
.من أجل شخص آخر... أمر يفوق فهمي

152
00:09:10,520 --> 00:09:12,010
أأنت واثق؟

153
00:09:13,590 --> 00:09:16,400
ما-ما الّذي تحاول قوله؟

154
00:09:16,400 --> 00:09:19,090
.اعلم هذا جيّدًا، لم أفعل هذا لأجلك

155
00:09:19,090 --> 00:09:20,230
.شكرًا لك

156
00:09:21,450 --> 00:09:26,750
،في أوّل مرّة استيقظتُ فيها هنا
.لم أشعر بأيّ شيء سوى اليأس

157
00:09:27,190 --> 00:09:32,120
،لم تكن لديّ أيّ ذكريات
،وكان هنالك غنوشيا في السّفينة

158
00:09:32,120 --> 00:09:34,540
.وكان الجميع يشتبهون ببعضهم

159
00:09:36,070 --> 00:09:38,170
.وكنتَ الأكثر قسوة بين الجميع يا راكيو

160
00:09:38,830 --> 00:09:43,790
عاملتَني كغنوشيا باستمرار
.وحاولتَ وضعي في النّوم البارد

161
00:09:44,780 --> 00:09:47,400
وبصراحة، لم يسعني إلاّ التّفكير
...مرّة تلو الأخرى والقول لنفسي

162
00:09:47,400 --> 00:09:49,520
."ليته لم يكون موجودًا هنا"

163
00:09:52,020 --> 00:09:56,740
وكم أودّ أنّ أخبر نفسي وقتها
.كم أنّني كنت مخطئًا

164
00:09:57,510 --> 00:10:03,160
ذلك الشّخص الوقح حادّ
اللّسان الواقف أمامه

165
00:10:03,160 --> 00:10:07,200
،هو في الحقيقة شخص طيّب القلب
،رغم أنّه لا يُظهر ذلك أبدًا

166
00:10:07,200 --> 00:10:09,130
.وسيساعده حين لا يستطيع أحد آخر مساعدته

167
00:10:11,130 --> 00:10:13,050
.لا تسئ فهم الأمر

168
00:10:13,790 --> 00:10:17,380
جئت فقط للضّحك في وجه
فأر تجارب مثير للشّفقة

169
00:10:17,800 --> 00:10:21,010
.سيجعل منه المفتاح الفضّيّ مضيفه الجديد

170
00:10:23,740 --> 00:10:24,930
.بالطّبع

171
00:10:27,870 --> 00:10:30,390
...يورينتشي

172
00:10:32,290 --> 00:10:33,520
.وداعًا

173
00:10:35,300 --> 00:10:44,030
.وداعًا

174
00:10:47,260 --> 00:10:48,470
...جينا

175
00:10:48,970 --> 00:10:53,340
أشعر أنّي... ودّعتك عدّ مرّات
.من قبل يا يوري

176
00:10:54,360 --> 00:10:55,550
.وأنا أيضًا

177
00:10:59,740 --> 00:11:03,560
.وداعًا

178
00:11:08,820 --> 00:11:12,210
.ليس لديّ أيّ تردّد أو ندم بعد الآن

179
00:11:13,720 --> 00:11:16,720
...سأذهب إلى سِتسو

180
00:11:17,360 --> 00:11:20,480
وسأصل إلى خاتمةٍ يمكن لكلّ
.حلقاتنا أن تنتهي فيها

181
00:11:22,370 --> 00:11:26,290
.لا تشكّ، ولا تخف، واعرف

182
00:11:26,290 --> 00:11:28,820
.ستنقذ المعرفة الجميع

183
00:12:54,560 --> 00:13:00,670
.لنبدأ. سيحدّد هذا النّقاش إن كنّا سننجو

184
00:13:06,930 --> 00:13:09,930
.أتساءل كم مرّ من وقت مذّاك الحين

185
00:13:13,440 --> 00:13:15,440
،وبينما أواصل دخول الحلقات مرارًا وتكرارًا

186
00:13:15,440 --> 00:13:18,830
لاحظتُ أنّ الكثير من الأشياء
.قد اختلفت عن ذي قبل

187
00:13:20,770 --> 00:13:23,780
استيقظت. كيف تشعر؟

188
00:13:24,850 --> 00:13:25,930
.بخير

189
00:13:27,050 --> 00:13:32,230
،أوّلاً، مهما دخلتُ من حلقات
.لم يكن سِتسو حاضرًا في أيّ منها

190
00:13:32,590 --> 00:13:34,740
.لكنّي توقّعتُ هذا

191
00:13:34,740 --> 00:13:38,610
فقبل كلّ شيء، عندما
،عبر سِتسو البوّابة البُعديّة

192
00:13:38,610 --> 00:13:41,950
.لم يعد له وجود في هذا العالم

193
00:13:42,570 --> 00:13:43,700
...وأيضًا

194
00:13:44,230 --> 00:13:48,310
كوميت... هل يوجد أحد على متن
السّفينة يُدعى كوكروشكا؟

195
00:13:48,750 --> 00:13:50,670
كوكروشكا؟

196
00:13:51,090 --> 00:13:52,540
.لا أظنّ ذلك

197
00:13:52,540 --> 00:13:53,800
.فهمت

198
00:13:54,780 --> 00:13:59,160
،إضافة إلى سِتسو
.يبدو أنّ كوكروشكا اختفت أيضًا

199
00:14:00,330 --> 00:14:03,600
لن تظهر مهما دخلتُ
.في حلقات جديدة أيضًا

200
00:14:04,590 --> 00:14:08,210
.أو بالأحرى، لم تختفي بالكامل

201
00:14:09,630 --> 00:14:12,430
.إنّها نائمة في المخزن كدُمية

202
00:14:13,010 --> 00:14:16,320
،لكنّها لم تستيقظ أو تتحرّك ولو لمرّة

203
00:14:16,910 --> 00:14:20,090
.ولم تدخل في أيّ نوبات قتل أيضًا

204
00:14:22,520 --> 00:14:27,920
ما الّذي يحدث؟ هل يمكن أن يكون
هذا بسبب غياب سِتسو بطريقة ما؟

205
00:14:29,010 --> 00:14:30,350
.يوري

206
00:14:30,730 --> 00:14:31,640
!ماذا؟

207
00:14:31,640 --> 00:14:34,320
.لنبدأ الاجتماع في أسرع وقت ممكن

208
00:14:34,890 --> 00:14:37,570
.نعم، حسنًا. معك حقّ

209
00:14:38,260 --> 00:14:41,410
لا فائدة. لا يجب أن أسمح
.بأن يتشتّت انتباهي الآن

210
00:14:42,130 --> 00:14:46,540
عليّ القيام بكلّ ما أستطيعه لملء المفتاح
.الفضّيّ لأستطيع رؤية سِتسو ثانية

211
00:14:47,260 --> 00:14:50,140
ليفي، هلاّ أخبرتنا كم عدد
الغنوشيا على متن السّفينة؟

212
00:14:50,570 --> 00:14:54,680
.بالتّأكيد. أنا أشعر بوجود اثنين

213
00:14:55,480 --> 00:14:57,430
.وهكذا، استمرّ دخولي في حلقات من جديد

214
00:15:17,960 --> 00:15:22,690
،استبعدتُ كلّ الغنوشيا
.ونجونا أنا وأنت

215
00:15:22,690 --> 00:15:26,730
،قلتِ أنّي إن حقّقتُ شرطيك
.فستخبرينني بالحقيقة

216
00:15:27,310 --> 00:15:30,590
.لا أصدّق أنّك فزت بالفعل

217
00:15:30,590 --> 00:15:33,820
تبدو شخصًا ذكيًّا بالنّسبة
.لدورك الصّغير الّذي تلعبه

218
00:15:34,170 --> 00:15:36,960
حسنًا، مررتُ بهذا عدّة
...مرّات في حلقاتي

219
00:15:36,960 --> 00:15:39,580
.بهدف الوصول إلى خطّ العالم هذا

220
00:15:42,400 --> 00:15:44,110
...مفتاح فضّيّ

221
00:15:44,110 --> 00:15:46,790
...نعم. ولهذا السّبب أنا أعرف بالضّبط

222
00:15:47,160 --> 00:15:50,520
.ما أنت على وشك إخباري به

223
00:15:51,390 --> 00:15:54,060
.عجبًا. يا لها من كلمات مثيرة للاهتمام

224
00:15:54,790 --> 00:15:57,060
.حسنًا إذًا، نوّرني بما لديك

225
00:15:57,530 --> 00:15:59,870
.ستخبرينني بحقيقتي

226
00:16:01,050 --> 00:16:03,350
—أنا عطب

227
00:16:03,350 --> 00:16:07,270
وهو شيء أنشأه غنوس لا يجب
.أن يوجد في هذا العالم على الإطلاق

228
00:16:11,810 --> 00:16:16,580
فهمت. يبدو أنّي كنت مخطئة
.عندما قلتُ أنّك تلعب دورًا صغيرًا

229
00:16:16,910 --> 00:16:21,070
،إن كنت تعرف كلّ ذلك مسبقًا
لماذا أصررت على الفوز بهذه اللّعبة؟

230
00:16:22,210 --> 00:16:23,800
.لديّ طلب

231
00:16:27,940 --> 00:16:29,500
الهوشيبوني؟

232
00:16:29,830 --> 00:16:33,550
،نعم. إن استطعنا دخول مدى تواصلهم

233
00:16:33,550 --> 00:16:36,380
.فسيكون من الممكن اختراق نظامهم

234
00:16:36,380 --> 00:16:41,050
.يا لها من خطّة حمقاء
.لن ننجو بسهولة إذا فشلت

235
00:16:41,410 --> 00:16:42,900
...كلاّ

236
00:16:43,350 --> 00:16:46,900
.إن حدث ذلك، يمكنكم لومي بالكامل

237
00:16:46,900 --> 00:16:49,260
.يمكنكم القول أنّي اختطفتُ السّفينة ببساطة

238
00:16:49,800 --> 00:16:51,100
وماذا عن أجري؟

239
00:16:52,990 --> 00:16:57,920
أنا، جوناس، لستُ كريمًا إلى درجة
.أن أعمل بلا مقابل

240
00:16:59,600 --> 00:17:02,250
.لقد نال منك بهذا

241
00:17:04,740 --> 00:17:09,500
بالطّبع لا أملك مالاً
.أو أيّ طريقة أخرى للدّفع

242
00:17:11,390 --> 00:17:12,340
...لكن

243
00:17:14,300 --> 00:17:18,340
بهذا، سيكون لك وللسّفينة حكاية
.بطوليّة أخرى تضيفها إلى أسطورتكما

244
00:17:18,770 --> 00:17:24,140
يمكنك أن تروي كيف واجهت
،هوشيبوني المشهورة بالتّحول السّيبرانيّ

245
00:17:24,140 --> 00:17:26,540
.حين تردَّد الجيش نفسه عن مواجهتها

246
00:17:27,730 --> 00:17:29,620
.ستدخل التّاريخ بذلك

247
00:17:31,890 --> 00:17:33,190
.ستيلا

248
00:17:33,190 --> 00:17:34,210
.حاضرة

249
00:17:36,260 --> 00:17:38,640
.حدّدي مسارنا نحو هوشيبوني

250
00:17:40,530 --> 00:17:42,720
قد يبدو وكأنّه شخص
،متشائم وقاسي القلب

251
00:17:42,720 --> 00:17:45,470
لكنّه في أعماقه لا يزال يحبّ
.المغامرة والمنافسة

252
00:17:46,240 --> 00:17:47,920
...راقبته بما فيه الكفاية لأعلم

253
00:17:48,870 --> 00:17:51,670
.أنّ جوناس ما زال طفلاً في قلبه

254
00:17:53,530 --> 00:17:54,760
.لنصل إلى هناك سالمين وبأمان

255
00:17:55,780 --> 00:17:59,250
.لكنّ الطّريق إلى هوشيبوني مجهول

256
00:18:00,540 --> 00:18:01,610
.أرشدينا رجاءً

257
00:18:02,600 --> 00:18:05,380
من تكون لتملي عليّ الأوامر؟

258
00:18:05,380 --> 00:18:09,360
.لكن أظنّ أنّ هذا سيُعدّ تشتيتًا كافيًا

259
00:18:32,340 --> 00:18:34,610
.هذه هي الهوشيبوني إذًا

260
00:18:37,850 --> 00:18:39,350
التّحوّل السّيبرانيّ؟

261
00:18:39,350 --> 00:18:40,430
.بالفعل

262
00:18:40,430 --> 00:18:45,200
يكمن مفتاح حلّ مشكلة الوجود
.المزدوج في التّحوّل السّيبرانيّ

263
00:18:45,510 --> 00:18:49,640
إن استطعت السّفر بين الأبعاد عن
...طريق تحويل وعيك بشكل سيبرانيّ

264
00:18:49,640 --> 00:18:52,160
!فإنّ الوجود المزدوج بالكامل لن يحدث

265
00:18:52,160 --> 00:18:53,410
.صحيح

266
00:18:53,410 --> 00:18:58,000
لكنّ ذلك يعني أنّه سيكون
.عليك إيجادهم واستغلالهم

267
00:19:01,330 --> 00:19:02,940
هل أنت واثق من هذا؟

268
00:19:02,940 --> 00:19:05,920
حتّى إن نجحت في تحويل
،وعيك بشكل سيبرانيّ

269
00:19:05,920 --> 00:19:10,300
.هنالك احتمال بأن يبتلعك غنوس بالكامل

270
00:19:10,300 --> 00:19:12,320
.إن حدث ذلك، فلا يوجد ما يمكنني فعله

271
00:19:12,650 --> 00:19:18,820
لكن أريد أن أؤمن
.أنّ غنوس لن يقوم بذلك

272
00:19:21,160 --> 00:19:23,760
.أرسل إشارة اتّصال إلى هوشيبوني

273
00:19:23,760 --> 00:19:26,400
.أرسلي إشارة الاتّصال

274
00:19:26,400 --> 00:19:27,760
.بكلّ سرور

275
00:19:28,260 --> 00:19:31,040
.والآن، اذهب إلى الكبسولة الّتي جهّزناها

276
00:19:31,040 --> 00:19:32,100
.شكرًا لك

277
00:19:37,010 --> 00:19:40,240
.رجاءً... ليسر هذا كما خطّطنا

278
00:19:40,760 --> 00:19:45,660
.إن ابتلعني غنوس، سينتهي كلّ شيء

279
00:19:47,560 --> 00:19:51,680
حتّى يوريكو وراكيو لا يعرفان
.إن كان سيحدث ذلك

280
00:19:52,990 --> 00:19:54,620
.كلّ ما يمكنني فعله هو الدّعاء

281
00:20:03,130 --> 00:20:04,010
.لنبدأ

282
00:20:05,170 --> 00:20:11,400
...رجاءً... رجاءً... رجاءً... رجاءً

283
00:20:14,360 --> 00:20:15,610
.شا-مينغ

284
00:20:16,200 --> 00:20:17,340
.رِمنان

285
00:20:17,950 --> 00:20:18,960
.أوتومي

286
00:20:19,520 --> 00:20:20,830
.كوكروشكا

287
00:20:21,410 --> 00:20:22,570
.جوناس

288
00:20:23,130 --> 00:20:24,150
.شيبي

289
00:20:24,750 --> 00:20:25,870
.كوميت

290
00:20:26,390 --> 00:20:27,500
.يوريكو

291
00:20:28,040 --> 00:20:29,080
.ستيلا

292
00:20:29,580 --> 00:20:30,830
.شيغيميتشي

293
00:20:31,370 --> 00:20:32,360
.جينا

294
00:20:32,870 --> 00:20:34,030
.راكيو

295
00:20:34,530 --> 00:20:35,820
.إس كيو

296
00:20:37,750 --> 00:20:39,080
!سِتسو

297
00:20:59,140 --> 00:21:00,610
غنوس...؟

298
00:21:12,260 --> 00:21:13,630
.لقد امتلأ

299
00:21:30,430 --> 00:21:33,100
.نعم، أعلم

300
00:21:35,440 --> 00:21:36,560
.شكرًا

301
00:22:27,210 --> 00:22:28,540
هل فهمت؟