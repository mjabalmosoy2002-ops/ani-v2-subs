1
00:00:03,710 --> 00:00:06,040
...ماما... ماما

2
00:00:09,530 --> 00:00:10,850
!ماما

3
00:00:19,440 --> 00:00:21,900
...ماما... ماما

4
00:00:22,690 --> 00:00:24,670
!ماما

5
00:00:26,550 --> 00:00:27,490
!جينا

6
00:00:28,030 --> 00:00:29,590
...ماما

7
00:00:29,590 --> 00:00:31,500
!أنا آسفة! أنا جدّ آسفة

8
00:00:32,980 --> 00:00:35,980
...ماما... لا تتركيني

9
00:00:35,980 --> 00:00:38,460
.ما كنتُ لأتركك أبدًا

10
00:00:38,460 --> 00:00:40,760
.سنظلّ معًا للأبد

11
00:00:42,060 --> 00:00:43,360
...ماما

12
00:00:52,850 --> 00:00:53,980
.جينا

13
00:00:54,500 --> 00:00:59,990
،قال سِتسو أنّه مشغول الآن
فهلاّ تحقّقت من الكبسولة الطّبّيّة؟

14
00:00:59,990 --> 00:01:01,080
ماذا؟

15
00:01:01,080 --> 00:01:04,250
.يبدو أنّه يفترض أن يستيقظ بعد قليل

16
00:01:04,730 --> 00:01:09,000
.عفوًا... إنّه ذلك الرّاكب الّذي تعرّض للأذى

17
00:01:09,000 --> 00:01:10,730
يوري... على ما أظنّ؟

18
00:01:11,160 --> 00:01:13,630
.ربّما عليك الذّهاب بدلاً منّي يا كوميت

19
00:01:14,080 --> 00:01:16,700
على من يذهب إليه أن يشرح
،له كلّ شيء عن السّفينة

20
00:01:16,700 --> 00:01:19,550
لذلك فإنّ مراقِبةَ مرورٍ فضائيّة
.مثلك ستكون الخيار الأفضل

21
00:01:20,010 --> 00:01:21,070
.هذا ما قاله سِتسو

22
00:01:21,810 --> 00:01:23,090
.مفهوم

23
00:02:54,540 --> 00:02:57,110
يبدو أنّ التّعليم
.الفوريّ قد انتهى

24
00:03:11,800 --> 00:03:14,120
هل تشعر بحال أفضل؟

25
00:03:15,860 --> 00:03:17,690
...نـ-نعم

26
00:03:18,150 --> 00:03:20,910
هل تفهم ما هو التّعليم الفوريّ؟

27
00:03:21,530 --> 00:03:24,370
.فهمت... عدتُ ثانية

28
00:03:24,930 --> 00:03:26,420
عدتَ ثانية؟

29
00:03:26,940 --> 00:03:28,720
.لا تهتمّي

30
00:03:29,450 --> 00:03:32,980
نحن حاليًّا على متن المركبة
.البين-نجميّة دي كيو أو

31
00:03:32,980 --> 00:03:36,610
.لكنّنا نواجه مشكلة كبيرة في الوقت الحاليّ

32
00:03:36,610 --> 00:03:39,830
نعم. ثمّة مصابين بالغنوشيا
على متن السّفينة، صحيح؟

33
00:03:40,240 --> 00:03:41,050
ماذا؟

34
00:03:41,050 --> 00:03:43,780
ولذلك السّبب نوشك على
عقد اجتماع، صحيح؟

35
00:03:43,780 --> 00:03:44,500
...نعم

36
00:03:45,670 --> 00:03:46,820
.لنسرع إذًا

37
00:03:52,420 --> 00:03:56,270
هل عرفت بشأن الاجتماع
من التّعليم الفوريّ أيضًا؟

38
00:03:56,270 --> 00:03:58,290
...ماذا؟ نـ-نعم

39
00:04:00,390 --> 00:04:03,420
كيف سيكون الأمر في رأيك؟

40
00:04:05,380 --> 00:04:09,590
هدف الاجتماعات هو تحديد
من هم المصابين بالغنوشيا، صحيح؟

41
00:04:09,590 --> 00:04:10,560
.نعم

42
00:04:10,930 --> 00:04:14,360
سمعتُ أنّ المصابين بالغنوشيا
،لا يمانعون الكذب على الإطلاق

43
00:04:14,360 --> 00:04:18,130
لذلك علينا استعمال الاجتماعات
.لاكتشاف من منّا لا يقول الحقيقة

44
00:04:19,040 --> 00:04:20,760
.أو هذا ما أظنّ

45
00:04:22,140 --> 00:04:23,100
...فهمت

46
00:04:23,900 --> 00:04:24,820
ألا تريدين ذلك؟

47
00:04:25,450 --> 00:04:29,800
.أنا... لا أبلي حسنًا في الاجتماعات أو ما شابه

48
00:04:29,800 --> 00:04:32,380
.مثل تبادل الآراء مع الآخرين

49
00:04:33,110 --> 00:04:34,700
ماذا عليّ أن أفعل في رأيك؟

50
00:04:38,150 --> 00:04:39,310
.آسف

51
00:04:39,310 --> 00:04:41,470
،الأمر ليس وكأنّي لا أصدّقك

52
00:04:41,470 --> 00:04:45,970
لكن هنالك احتمال في الوقت
.الحاليّ أن يكون أحدنا من الغنوشيا

53
00:04:46,250 --> 00:04:49,960
لذلك ليس علينا نصح بعضنا
.خارج الاجتماعات

54
00:04:51,940 --> 00:04:53,240
.مفهوم

55
00:05:01,450 --> 00:05:02,730
.نحن عشرة

56
00:05:02,730 --> 00:05:05,210
.والمصابين بالغنوشيا من بين هؤلاء العشرة

57
00:05:05,580 --> 00:05:08,450
.نعم. ثمّة مصابان

58
00:05:08,700 --> 00:05:12,450
حسنًا، كيف حال فقدانك للذّاكرة؟

59
00:05:12,790 --> 00:05:17,660
يبدو أنّي أبلي حسنًا الآن
.بفضل التّعليم الفوريّ يا راكيو

60
00:05:19,020 --> 00:05:22,160
.حسنًا، يبدو أنّنا جميعًا هنا

61
00:05:22,160 --> 00:05:24,970
.لنبدأ الاجتماع يا ليفي

62
00:05:25,220 --> 00:05:26,880
.في الحال

63
00:05:29,120 --> 00:05:32,770
.يبدو أنّ هنالك مهندسًا على متن السّفينة

64
00:05:33,340 --> 00:05:36,100
أعتقد أنّ هذا سيكون الوقت
.المناسب للإعلان عن نفسك

65
00:05:39,310 --> 00:05:41,220
.لا شيء غير الصّمت

66
00:05:41,620 --> 00:05:44,600
لا فائدة من الإعلان عن نفسه
.في اليوم الأوّل

67
00:05:45,520 --> 00:05:50,900
لكن أعتقد أنّه سيكون من الصّعب جدًّا
.المواصلة إن كنّا نجهل من يكون المهندس

68
00:05:50,900 --> 00:05:54,790
في البداية، بإمكاننا أيضًا الضّغط
.على أيّ أحد نراه مثيرًا للشّبهات

69
00:05:55,130 --> 00:05:59,800
على سبيل المثال، شخص بيننا
.يتظاهر بفقدان الذّاكرة

70
00:06:00,690 --> 00:06:05,210
كما أنّ أيّ أحد يحاول قيادة الاجتماع
.هو مثير للشّبهات أيضًا

71
00:06:05,210 --> 00:06:07,880
.فهمت. هذا يثبت الأمر

72
00:06:07,880 --> 00:06:11,630
.واضح أنّ يوري وشيبي يتعاونان معًا

73
00:06:12,220 --> 00:06:13,710
أهذا صحيح؟

74
00:06:14,010 --> 00:06:17,340
.لا. قلتُ ما يدور في بالي فحسب

75
00:06:17,690 --> 00:06:20,720
.مع أنّي أعتقد أنّ لا طريقة لإثبات العكس

76
00:06:21,080 --> 00:06:22,930
ماذا نفعل؟

77
00:06:22,930 --> 00:06:26,430
.هذه حماقة. إنّنا نضيّع الوقت فحسب

78
00:06:26,740 --> 00:06:27,960
.معك حقّ

79
00:06:27,960 --> 00:06:32,360
على هذا المعدّل، سينتهي بنا المطاف
.باختيار أحد بلا أيّ أساس

80
00:06:32,750 --> 00:06:35,600
.قد يكون ذلك شيئًا خارج إرادتنا

81
00:06:36,310 --> 00:06:38,520
،وبدل الكلمات

82
00:06:38,520 --> 00:06:41,090
سيكون الانتباه لتصرّفات الآخرين ونبراتهم

83
00:06:41,090 --> 00:06:43,580
.طريقة فعّالة أكثر لاكتشاف الأكاذيب

84
00:06:43,580 --> 00:06:46,610
.نعم، أعتقد أنّي أفضل من تلك النّاحية

85
00:06:46,610 --> 00:06:48,720
ما رأيك يا جينا؟

86
00:06:48,720 --> 00:06:49,460
ماذا؟

87
00:06:49,870 --> 00:06:51,640
.بخصوص ما قلتُه للتّوّ

88
00:06:52,750 --> 00:06:55,730
.أعتقد أنّك على حقّ يا يوري

89
00:06:56,140 --> 00:06:59,310
.أحيانًا، من المهمّ جدًّا الاعتماد على حدسنا

90
00:07:00,380 --> 00:07:03,230
!أنا أوافق جينا

91
00:07:03,230 --> 00:07:05,730
.اقترب الوقت

92
00:07:06,190 --> 00:07:07,770
من هو الغنوشيا؟

93
00:07:22,070 --> 00:07:23,260
.هيّا بنا

94
00:07:25,120 --> 00:07:28,540
من الطّبيعيّ أن يراك النّاس مثيرة
...للشّبهات إن تحدّثت كثيرًا

95
00:07:29,310 --> 00:07:31,520
.لكنّ التزام الصّمت أيضًا ليس فكرة جيّدة

96
00:07:32,180 --> 00:07:33,180
ماذا؟

97
00:07:41,510 --> 00:07:43,340
ماذا أفعل؟

98
00:07:44,920 --> 00:07:49,440
،كلّما فكّرتُ وفكّرتُ في الأمر
.لا أستطيع إنشاء استراتيجيّة جيّدة

99
00:07:51,950 --> 00:07:55,230
.لا أتخيّل أنّي سأنجو من هذا

100
00:07:56,040 --> 00:07:57,280
...ربّما عليّ فقط أن

101
00:07:57,720 --> 00:07:59,990
!جينا. جينا

102
00:08:01,500 --> 00:08:04,490
.أنا أوتومي. أريد الحديث معك

103
00:08:04,800 --> 00:08:07,210
.حسنًا. انتظري لحظة

104
00:08:11,400 --> 00:08:12,540
ماذا؟

105
00:08:13,400 --> 00:08:14,280
—يو

106
00:08:15,510 --> 00:08:16,590
...يوري

107
00:08:19,110 --> 00:08:21,140
.مهلاً يا يوري

108
00:08:21,660 --> 00:08:24,150
!أ-أنا آسفة

109
00:08:25,550 --> 00:08:26,980
لا تمانعين بالفعل؟

110
00:08:27,370 --> 00:08:32,400
نعم! بإمكاني إخبارها بما أريد
!لاحقًا، لذلك تفضّل أنت

111
00:08:33,660 --> 00:08:34,930
.شكرًا

112
00:08:35,650 --> 00:08:36,600
.شكرًا لك أيضًا

113
00:08:36,600 --> 00:08:37,450
ماذا؟

114
00:08:37,970 --> 00:08:42,140
.خلال الاجتماع... قرّرت إدراجي في المحادثة

115
00:08:43,440 --> 00:08:46,210
.صـ-صحيح... لا مشكلة

116
00:08:46,210 --> 00:08:51,430
لا بدّ أنّي بدوت غير مكترث
...في المصعد، لذلك

117
00:08:52,310 --> 00:08:53,290
.أنا آسف

118
00:08:53,930 --> 00:08:57,220
.لا بأس. إنّها ليست غلطتك يا يوري

119
00:08:57,740 --> 00:08:58,760
...لكن

120
00:08:58,760 --> 00:09:01,210
.كان كلامك صحيحًا

121
00:09:02,080 --> 00:09:03,300
.شكرًا

122
00:09:04,280 --> 00:09:06,180
."لا تردّ إلاّ بـ"شكرًا لك

123
00:09:08,190 --> 00:09:09,270
.معك حقّ

124
00:09:09,670 --> 00:09:13,650
وحتّى الآن... أما زلنا غير قادرين
على أن نثق ببعضنا؟

125
00:09:14,980 --> 00:09:16,260
...ذلك

126
00:09:16,960 --> 00:09:21,070
.ما زالت هنالك فرصة أن يكون أحدنا غنوشيا

127
00:09:21,070 --> 00:09:23,000
.لا أعتقد ذلك

128
00:09:24,980 --> 00:09:25,880
.تعال معي

129
00:09:27,160 --> 00:09:28,980
هل ستخرجين للفضاء الآن؟

130
00:09:29,810 --> 00:09:30,750
ماذا؟

131
00:09:31,500 --> 00:09:33,210
...عـ-عفوًا

132
00:09:33,690 --> 00:09:35,060
كيف عرفت ذلك؟

133
00:09:39,880 --> 00:09:40,720
ما هذا؟

134
00:09:41,310 --> 00:09:43,480
.إنّه كائن حيّ يُدعى المفتاح الفضّيّ

135
00:09:43,940 --> 00:09:48,210
وبفضل قوّته، استطعتُ أن أعيش نفس
.الفترة من الزّمن مرارًا في حلقة متكرّرة

136
00:09:51,140 --> 00:09:53,230
لهذا السّبب تعرف الكثير؟

137
00:09:53,610 --> 00:09:54,860
.نعم

138
00:09:54,860 --> 00:09:59,220
حضرتُ عددًا لا يُحصى من الاجتماعات
.وصوّتُّ لعدد لا يُحصى من المرّات

139
00:09:59,220 --> 00:10:01,860
هل انتهى بي الأمر... في النّوم البارد؟

140
00:10:03,370 --> 00:10:06,220
نعم. كانت هنالك خطوطُ
.عوالمَ حدث فيها ذلك

141
00:10:06,220 --> 00:10:09,370
لكن كانت هنالك عدّة مرّات
.نجوتِ فيها حتّى النّهاية

142
00:10:09,370 --> 00:10:10,600
.هكذا إذًا

143
00:10:10,600 --> 00:10:15,010
آسف. لا يمكنني أن أجزم أبدًا
.إن كان عليّ إبقاء هذا سرًّا أم لا

144
00:10:15,860 --> 00:10:17,750
ماذا عن الغنوشيا؟

145
00:10:17,750 --> 00:10:18,550
ماذا؟

146
00:10:19,140 --> 00:10:22,890
هل أصبتُ بالغنوشيا في أيّ منها؟

147
00:10:24,010 --> 00:10:24,990
.نعم

148
00:10:25,570 --> 00:10:26,640
.هكذا إذًا

149
00:10:27,030 --> 00:10:28,600
.وليس أنت فقط

150
00:10:28,600 --> 00:10:32,160
كانت هنالك خطوط عوالم أخرى حيث
.حتّى سِتسو وراكيو أصيبوا بالغنوشيا

151
00:10:32,950 --> 00:10:35,460
.حتّى أنا أصبت

152
00:10:36,630 --> 00:10:38,530
هل كذبت؟

153
00:10:39,490 --> 00:10:43,070
هل كذبتُ... عندما كنتُ غنوشيا؟

154
00:10:43,890 --> 00:10:44,910
.نعم

155
00:10:45,430 --> 00:10:47,740
قلتِ أنّ علينا الخروج للفضاء

156
00:10:47,740 --> 00:10:50,650
.لتحديد إن كنّا نستطيع أن نثق ببعضنا حقًّا

157
00:10:51,040 --> 00:10:53,040
.ذلك ما قلتِه لخداعي من قبل

158
00:10:55,280 --> 00:10:58,370
.لكنّي أتحدّث عن جينا من خطِّ عالمٍ مختلف

159
00:10:58,370 --> 00:11:03,910
ناهيك عن ذكر أنّك كنت مصابة
.بالغنوشيا، وذلك يؤثّر على ذهنك أيضًا

160
00:11:04,660 --> 00:11:07,450
.إذًا فذلك حدث بالفعل

161
00:11:08,120 --> 00:11:08,920
ماذا؟

162
00:11:09,810 --> 00:11:13,520
،عندما يصاب الفرد بالغنوشيا
.فإنّه يتقبّل ذلك بشكل تدريجيّ

163
00:11:13,900 --> 00:11:17,410
.ويتقبّل الكذب وخداع الآخرين

164
00:11:18,070 --> 00:11:23,240
.لا أريد أن يحدث ذلك
.لا يمكنني حتّى تحمّل تلك الفكرة

165
00:11:24,060 --> 00:11:25,250
...جينا

166
00:11:26,030 --> 00:11:29,790
.يوري... ضعني في النّوم البارد

167
00:11:30,260 --> 00:11:31,710
.الآن

168
00:11:31,710 --> 00:11:34,460
...جينا... هل يعني ذلك

169
00:11:40,400 --> 00:11:41,990
...أخبر الجميع

170
00:11:43,460 --> 00:11:46,100
.أنّك عثرت على أحد المصابين بالغنوشيا

171
00:11:48,380 --> 00:11:49,390
!مهلاً

172
00:11:53,060 --> 00:11:54,280
.انتظري

173
00:11:59,370 --> 00:12:01,200
هذا هو كوكبك الأمّ؟

174
00:12:01,670 --> 00:12:02,520
.نعم

175
00:12:02,990 --> 00:12:06,980
.لكنّه بعيد كلّ البعد عن المكان الّذي عشت فيه

176
00:12:07,600 --> 00:12:08,880
.هكذا إذًا

177
00:12:10,630 --> 00:12:12,090
.أنا أكره الكذب

178
00:12:12,530 --> 00:12:13,340
ماذا؟

179
00:12:13,870 --> 00:12:16,430
.لا أريد الكذب

180
00:12:17,930 --> 00:12:18,820
.نعم

181
00:12:19,350 --> 00:12:23,480
،لكن... قبل أن أدرك الأمر
.أجد نفسي أكذب كأنّها فطرة ثانية لي

182
00:12:23,840 --> 00:12:25,470
،وفي نهاية المطاف

183
00:12:25,470 --> 00:12:30,170
،أتظاهر أنّي بشريّة مثل الجميع
.وأخدعهم بلا أيّ تردّد

184
00:12:30,730 --> 00:12:33,520
.مع أنّي... أكره ذلك أكثر من أيّ شيء آخر

185
00:12:34,730 --> 00:12:35,820
.فهمت

186
00:12:36,610 --> 00:12:39,110
.لأنّي كنتُ غنوشيا من قبل

187
00:12:39,690 --> 00:12:41,730
هل كذبت أيضًا؟

188
00:12:42,150 --> 00:12:45,460
.نعم. كذبتُ وكأنّ الأمر طبيعيّ

189
00:12:45,750 --> 00:12:48,910
كنتُ أحاول إقناع الجميع
.ليصدّق أنّي كنتُ بشريًّا

190
00:12:49,850 --> 00:12:52,330
شعرتُ وكأنّ ذلك ما يفترض
.بي فعله فحسب

191
00:12:52,830 --> 00:12:55,210
لماذا... إذًا؟

192
00:12:56,240 --> 00:12:58,310
،إن كنت تفهم كلّ ذلك

193
00:12:59,620 --> 00:13:02,270
.جمّدني فحسب

194
00:13:02,870 --> 00:13:04,190
...لكن

195
00:13:04,190 --> 00:13:07,540
.لا أريد هذا. أكره خداع الآخرين

196
00:13:08,790 --> 00:13:12,400
لا أريد أن يختفي أيّ أحد
.وكأنّهم يخضعون لتحوّل سيبرانيّ

197
00:13:12,880 --> 00:13:14,060
تحوّل سيبرانيّ؟

198
00:13:14,990 --> 00:13:18,060
.سمعتُ أنّ الأمر يشبه ذلك

199
00:13:18,850 --> 00:13:21,060
الأشخاص الّذين يقضي الغنوشيا عليهم

200
00:13:22,530 --> 00:13:24,060
.لا يموتون

201
00:13:24,730 --> 00:13:26,750
.ولا تظلّ إلاّ أرواحهم

202
00:13:29,320 --> 00:13:30,560
...التّحوّل السّيبرانيّ

203
00:13:31,190 --> 00:13:32,580
هل سمعت بذلك من قبل؟

204
00:13:33,000 --> 00:13:34,440
.مرّة واحدة فقط

205
00:13:35,090 --> 00:13:37,450
.إنّها تكنولوجيا تطوّرت قبل مدّة

206
00:13:37,840 --> 00:13:41,440
الوحيدون المعروف أنّهم يمارسونها
.هم معبد العذارى من هوشيبوني

207
00:13:41,930 --> 00:13:44,840
...هوشيبوني... مهلاً، إنّ يوريكو من

208
00:13:45,690 --> 00:13:46,910
.صحيح

209
00:13:46,910 --> 00:13:49,670
،تهيم مركبة هوشيبوني في الفضاء
وعذارى المعبد اللاّئي على متنها

210
00:13:49,670 --> 00:13:51,860
يطبّقن التّحوّل السّيبرانيّ
.على أيّ مؤمن يرغب في ذلك

211
00:13:52,400 --> 00:13:56,230
.إنّهنّ يدنّسنهم، ويحوّلنهم إلى شيء آخر

212
00:13:58,420 --> 00:14:02,100
،إنّهنّ يحرّرن الفرد من جسده
.ويتحرّر بالتّالي من كلّ المعاناة الدُّنيويّة

213
00:14:02,420 --> 00:14:05,160
.لن تعودي مضطرّة للخوف من الموت

214
00:14:05,490 --> 00:14:07,530
.لكنّك قلت أنّك ستظلّين معي دائمًا

215
00:14:07,530 --> 00:14:11,160
.بالطّبع! سأكون إلى جانبك دائمًا

216
00:14:11,160 --> 00:14:12,660
.لأنّي لن أموت أبدًا

217
00:14:12,660 --> 00:14:15,620
.سأكون إلى جانبك... للأبد

218
00:14:17,300 --> 00:14:19,380
...إذًا فأمّك

219
00:14:19,970 --> 00:14:21,550
.لم أرها بعد ذلك ثانية

220
00:14:21,920 --> 00:14:25,920
"استمارة موافقة"

221
00:14:22,250 --> 00:14:25,390
.لا أعرف ما الّذي حدث لها بعد ذلك

222
00:14:28,220 --> 00:14:31,430
.روح أمّك في السّماء الآن

223
00:14:31,930 --> 00:14:35,030
.يمكنك الانضمام لها... إن أردت

224
00:14:36,540 --> 00:14:40,480
لا أريد أن أكون سببًا في اختفاء
.أيّ شخص آخر هكذا

225
00:14:41,570 --> 00:14:44,600
.لا أريد أن أسلب أحبّاء أيّ أحد

226
00:14:45,000 --> 00:14:47,470
،إن وصل الأمر لذلك
...فالأَولى بي أن

227
00:14:47,470 --> 00:14:50,170
ما رأي الغنوشيا الآخر بشأن هذا؟

228
00:14:53,250 --> 00:14:54,250
.آسف

229
00:14:54,250 --> 00:14:57,580
واثق أنّك لا تريدين قول أيّ شيء
.قد يفضح زميلك

230
00:14:57,980 --> 00:15:01,330
لماذا تحاول مساعدة الغنوشيا؟

231
00:15:01,330 --> 00:15:02,590
.أنت بشريّ

232
00:15:03,920 --> 00:15:08,840
يوري، يفترض بك الفضاء
.على الغنوشيا وحماية البشر

233
00:15:10,160 --> 00:15:12,770
.الأمر ليس وكأنّي أريد مساعدة الغنوشيا

234
00:15:14,180 --> 00:15:17,810
.أنا أريد مساعدتك أنت يا جينا

235
00:15:20,430 --> 00:15:25,430
.سأبذل كلّ جهدي لاكتشاف ما عليك فعله

236
00:15:26,010 --> 00:15:27,200
...يوري

237
00:15:29,630 --> 00:15:31,450
.يا له من ارتفاع شاهق

238
00:15:33,490 --> 00:15:34,740
...القفز

239
00:15:34,740 --> 00:15:35,540
ماذا؟

240
00:15:36,440 --> 00:15:38,970
يُقال أنّه حين يكون المرء مستعدًّا
،لحسم قرار ما

241
00:15:38,970 --> 00:15:41,610
عليه أن يتعامل معه بالجدّيّة نفسها
.كما لو كان سيقفز من مكان مرتفع

242
00:15:42,350 --> 00:15:44,030
.هكذا إذًا

243
00:15:46,380 --> 00:15:47,220
ماذا؟

244
00:15:58,400 --> 00:15:59,770
.شكرًا لك

245
00:16:02,580 --> 00:16:08,560
...ستبدأ القيادة الفائقة بعد، 4، 3، 2، 1

246
00:16:15,920 --> 00:16:19,370
.لقد تحدّثتما لوقت طويل جدًّا

247
00:16:19,890 --> 00:16:20,750
.نعم

248
00:16:21,620 --> 00:16:25,340
جينا، على من يجب أن نقضي أوّلاً؟

249
00:16:25,960 --> 00:16:27,010
ما رأيك؟

250
00:16:27,710 --> 00:16:33,390
.أعتقد أنّ... يوري هو أكثر من يشتبه بنا

251
00:16:43,090 --> 00:16:44,460
...إذًا راكيو قد

252
00:16:45,180 --> 00:16:48,410
.نعم. لا أشعر بوجود راكيو

253
00:16:48,900 --> 00:16:53,160
أثق أنّكم جميعًا تدركون أنّ هذا الوضع
.سيستمرّ ما دام هناك غنوشيا على السّفينة

254
00:16:53,550 --> 00:16:56,650
ولا شكّ أنّ الوقت قد حان
.ليكشف المهندس عن نفسه

255
00:16:56,990 --> 00:16:57,900
...حسنًا

256
00:16:59,360 --> 00:17:01,180
.أنا المهندس

257
00:17:01,180 --> 00:17:05,920
أعلم أنّ جدالي مع راكيو البارحة
...قد يجعلني أبدو مثل غنوشيا، لكن

258
00:17:06,300 --> 00:17:08,650
أهنالك أيّ أحد آخر؟

259
00:17:10,210 --> 00:17:15,600
.هذا غريب جدًّا
.يفترض أن يكون هناك مهندس واحد

260
00:17:15,970 --> 00:17:17,270
...إذًا أنت أيضًا

261
00:17:17,910 --> 00:17:20,810
هل يعني ذلك أنّ أحدهما غنوشيا؟

262
00:17:20,810 --> 00:17:22,730
.نعم، أعتقد أنّ هذا ما يعنيه الأمر

263
00:17:25,770 --> 00:17:26,690
ماذا؟

264
00:17:27,210 --> 00:17:28,660
جينا...؟

265
00:17:29,910 --> 00:17:32,910
.أنا... المهندس الحقيقيّ

266
00:17:32,910 --> 00:17:35,780
مـ-مهلاً. ثمّة ثلاثة؟

267
00:17:35,780 --> 00:17:38,290
.أصبحت الأمور ممتعة أكثر الآن

268
00:17:38,290 --> 00:17:45,280
لكن... ألا يعني ذلك أنّ اثنين من هؤلاء
الثّلاثة لا بدّ أن يكونا غنوشيا؟

269
00:17:45,630 --> 00:17:47,910
.سيكون ذلك هو الاستنتاج الطّبيعيّ

270
00:17:48,320 --> 00:17:51,710
.أحدهم حقيقيّ، والاثنان الآخران مزيّفين

271
00:17:51,710 --> 00:17:53,290
...جينا

272
00:17:54,390 --> 00:17:57,500
.حسنًا، لنسمع تقرير الجميع الآن

273
00:17:57,500 --> 00:17:59,300
من الّذين تحقّقتم من أمرهم؟

274
00:17:59,760 --> 00:18:01,770
.تحقّقتُ من أمر أوتومي

275
00:18:01,770 --> 00:18:04,270
.إنّها غنوشيا

276
00:18:04,770 --> 00:18:07,260
...أنا أيضًا قمت بتحقيقي

277
00:18:07,670 --> 00:18:10,400
.وشيبي غنوشيا

278
00:18:10,900 --> 00:18:12,270
ماذا عنك يا جينا؟

279
00:18:12,900 --> 00:18:14,940
...تحقّقتُ من أمر شيبي

280
00:18:15,820 --> 00:18:17,600
.إنّه غنوشيا

281
00:18:18,180 --> 00:18:22,490
اثنان ضدّ واحد... حسنًا، كانا ليفوزا
.لو كان الأمر راجعًا للأغلبيّة

282
00:18:22,490 --> 00:18:23,860
.لكنّ الأمر ليس كذلك

283
00:18:24,540 --> 00:18:27,310
.اثنان من الثّلاثة غنوشيا

284
00:18:28,410 --> 00:18:32,860
من المستحيل أن يبلّغ أحد
.الغنوشيا عن الآخر

285
00:18:33,960 --> 00:18:36,130
...الجواب الوحيد غير المتناقض هو

286
00:18:36,470 --> 00:18:39,600
أنّ شيبي بشريّ؟

287
00:18:45,930 --> 00:18:48,340
لماذا فعلت ذلك؟

288
00:18:48,340 --> 00:18:49,340
ماذا؟

289
00:18:49,700 --> 00:18:54,590
كان واضحًا لك أنّ هذا سيحدث
.إن قلت أنّك المهندس

290
00:18:55,250 --> 00:18:56,390
...ومع ذلك

291
00:18:56,940 --> 00:18:58,110
.أنا آسفة

292
00:18:58,590 --> 00:19:00,760
.أنا... لا أستطيع تحمّل الأمر فحسب

293
00:19:01,240 --> 00:19:03,600
.لا أتحمّل أن أصير شيئًا ليس بشريًّا

294
00:19:04,460 --> 00:19:05,680
.جينا

295
00:19:08,840 --> 00:19:10,060
...وأيضًا

296
00:19:11,800 --> 00:19:13,630
.تحذير

297
00:19:13,630 --> 00:19:16,130
الدّروع معطّلة بسبب شذوذ
.في الحقل المغناطيسيّ

298
00:19:16,130 --> 00:19:17,600
!مهلاً، ماذا؟

299
00:19:17,600 --> 00:19:21,390
.يُرجى ارتداء بدلات الفضاء من باب الحيطة

300
00:19:22,210 --> 00:19:23,570
!الدّروع

301
00:19:25,410 --> 00:19:26,260
!جينا

302
00:19:32,130 --> 00:19:34,150
ليفي، هلاّ أخبرتنا عن مدى الضّرر؟

303
00:19:35,380 --> 00:19:40,070
كانت هذه السّفينة رفيقتي المخلصة
.لآلاف من السّنوات الضّوئيّة

304
00:19:40,440 --> 00:19:43,050
.لن تسقط بسهولة

305
00:19:43,480 --> 00:19:45,860
.جارٍ تلقّي إشارات من خارج السّفينة

306
00:19:48,280 --> 00:19:49,520
...جينا

307
00:19:51,070 --> 00:19:54,550
تحدث شذوذاتُ المجال المغناطيسيّ
.كثيرًا في هذه المنطقة

308
00:19:54,900 --> 00:19:59,160
،إن خُفِّضت دروع السّفينة
.قد تُدمَّر جرّاء الاصطدام بالحطام

309
00:20:00,050 --> 00:20:03,550
قمتُ بإصلاحات طارئة. بإمكان طائرات
.الصّيانة الآليّة التّعامل مع الباقي

310
00:20:04,040 --> 00:20:08,480
لكنّ طائرات الصّيانة الآليّة لن تعمل
.ما دام هنالك غنوشيا بيننا

311
00:20:08,480 --> 00:20:09,280
.لا يوجد

312
00:20:09,280 --> 00:20:10,180
ماذا؟

313
00:20:10,600 --> 00:20:13,390
.لم يعد هنالك أيّ غنوشيا على السّفينة

314
00:20:14,510 --> 00:20:16,640
.لذلك يا ليفي، أنا أرجوك

315
00:20:17,170 --> 00:20:19,220
...جينا... أنت

316
00:20:44,460 --> 00:20:45,570
...يوري

317
00:20:45,570 --> 00:20:46,630
!لا تذهبي

318
00:20:50,010 --> 00:20:51,900
!لن أدعك تذهبين وحدك

319
00:20:53,400 --> 00:20:54,620
.شكرًا لك

320
00:20:57,020 --> 00:21:00,200
.لطالما كرهتُ الكذب

321
00:21:02,190 --> 00:21:03,640
...سواء الكذب على نفسي

322
00:21:04,750 --> 00:21:06,000
.أو كذب الآخرين عليّ

323
00:21:07,380 --> 00:21:09,320
.لكنّ هذه أوّل مرّة يُسعدني ذلك فيها

324
00:21:09,870 --> 00:21:12,160
.أنا سعيدة لأنّك قلت ذلك، وإن كان كذبة

325
00:21:12,540 --> 00:21:13,790
!إنّها ليست كذبة

326
00:21:15,020 --> 00:21:15,990
.بل كذبة

327
00:21:16,750 --> 00:21:18,840
.ستغادر يا ليفي

328
00:21:20,550 --> 00:21:23,000
.لا يمكنك البقاء معي

329
00:21:24,700 --> 00:21:27,030
أليس ذلك صحيحًا؟

330
00:21:27,030 --> 00:21:28,360
...ذلك

331
00:21:30,290 --> 00:21:33,470
.ذلك ما أدركتُه في النّهاية

332
00:21:34,750 --> 00:21:37,310
...ورغم ذلك، أنا

333
00:21:38,310 --> 00:21:40,260
.أنا أحبّك يا يوري

334
00:21:40,830 --> 00:21:42,860
.حتّى إن كنت ستتركني

335
00:21:42,860 --> 00:21:43,860
...لذلك

336
00:21:51,090 --> 00:21:55,560
.شكرًا لك... يا حبيبي يوري

337
00:22:04,860 --> 00:22:10,400
.خطر. نقص في مستويات الأوكسجين
.خطر. نقص في مستويات الأوكسجين

338
00:22:15,330 --> 00:22:19,720
.آمل أن نستطيع رؤية بعضنا ثانية