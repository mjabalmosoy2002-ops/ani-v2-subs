1
00:00:16,420 --> 00:00:18,120
...هذه

2
00:00:21,920 --> 00:00:24,530
!يوري. صباح الخير

3
00:00:24,530 --> 00:00:25,740
...كوميت

4
00:00:26,180 --> 00:00:27,410
كيف تسير الحفلة؟

5
00:00:27,410 --> 00:00:28,720
الحفلة؟

6
00:00:29,120 --> 00:00:31,080
.انتهت البارحة

7
00:00:31,420 --> 00:00:33,680
.تمالك نفسك

8
00:00:34,380 --> 00:00:37,640
.لا مجال للشّكّ
.لم أعد أدخل حلقات جديدة

9
00:00:37,980 --> 00:00:43,850
استعمل سِتسو المفتاح الفضّيّ الّذي
...كان معي واختفى في البُعد الآخر

10
00:00:45,110 --> 00:00:46,780
.من أجل إنقاذي

11
00:00:49,380 --> 00:00:51,270
.لم يعد لديّ مفتاح فضّيّ

12
00:00:51,800 --> 00:00:54,140
.لن أدخل حلقات ثانية

13
00:00:54,880 --> 00:00:56,860
!مرحبًا يا يورينتشي

14
00:00:56,860 --> 00:00:59,230
أتريد الذّهاب لتناول شيء ما معًا؟

15
00:00:59,230 --> 00:01:00,700
...إس كيو

16
00:01:01,580 --> 00:01:03,060
...هل سِتسو

17
00:01:03,060 --> 00:01:04,120
سِتسو"؟"

18
00:01:06,920 --> 00:01:08,410
أأنت بخير؟

19
00:01:09,790 --> 00:01:12,750
.أعتقد أنّ ذكرياتك ما زالت مشوّشة

20
00:01:15,860 --> 00:01:18,360
.حسنًا، ستكون بخير في النّهاية

21
00:01:18,910 --> 00:01:21,950
!لا وجود لذلك الشّخص في الواقع

22
00:02:57,500 --> 00:02:59,710
،بعد عبور سِتسو لتلك البوّابة

23
00:02:59,710 --> 00:03:02,580
.اختفى من ذكريات الجميع

24
00:03:03,990 --> 00:03:07,900
الكون المختلف على الجانب
الآخر لهذا الباب

25
00:03:07,900 --> 00:03:12,270
هو عالم منفصل تمامًا
.لا يؤثّر على هذا الكون

26
00:03:13,920 --> 00:03:19,540
بمجرّد ذهابه إلى هناك، فإنّ كلّ أثر
.عن سِتسو مُسح من هذا الكون

27
00:03:20,320 --> 00:03:22,480
.كأنّه لم يوجد من الأساس

28
00:03:26,750 --> 00:03:27,980
ما الخطب؟

29
00:03:28,300 --> 00:03:31,340
.قدّم الجيش طلبًا لنا بأن نرسو في الميناء

30
00:03:33,170 --> 00:03:36,570
.لا بدّ أنّ السّبب هو أنّنا هربنا من لو-آن

31
00:03:37,100 --> 00:03:42,310
لكنّ ليفي أكّد سلفًا أنّه لا يوجد
.غنوشيا على متن السّفينة

32
00:03:42,310 --> 00:03:44,460
.على الأرجح أنّهم يريدون التّحقّق فحسب

33
00:03:44,460 --> 00:03:47,920
.إنّهم قلقون جدًّا حيال تلك المسألة

34
00:03:47,920 --> 00:03:51,310
.من الأفضل الامتثال لأوامرهم
.لا نريد أن نعاديهم

35
00:03:51,830 --> 00:03:57,100
إن تجاهلنا الطّلب، فسيلقون علينا
.القبض حسب القانون الفضائيّ

36
00:03:57,730 --> 00:04:00,500
.إذًا فهو ليس طلبًا، بل أمر

37
00:04:00,990 --> 00:04:05,690
ميناء عسكريّ... سيتحقّقون
من هويّاتنا، أليس كذلك؟

38
00:04:05,690 --> 00:04:08,400
.إنّهم يحاولون إخافتنا فقط
.أشكّ في أنّهم سينفّذون ما قالوه

39
00:04:08,400 --> 00:04:10,940
.بإمكاننا تجاهلهم فحسب

40
00:04:10,940 --> 00:04:15,190
أوافقك الرّأي. ليس لدينا وقت
.لنلعب لعبتهم السّخيفة

41
00:04:15,190 --> 00:04:19,030
،ولكن إن نفّذوا ما قالوه بالفعل
.فسنكون في مشكلة حقيقيّة

42
00:04:19,030 --> 00:04:21,670
!بالكاد هربنا للتّوّ من لو-آن

43
00:04:21,670 --> 00:04:23,490
.لا أريد أن ينتهي بي المطاف في السّجن

44
00:04:23,940 --> 00:04:27,400
حسنًا... ما رأيك أنت؟

45
00:04:27,400 --> 00:04:28,120
ماذا؟

46
00:04:29,540 --> 00:04:31,570
أنت جنديّ، صحيح؟

47
00:04:32,080 --> 00:04:35,330
.نعم. أتيت من القاعدة 52

48
00:04:39,100 --> 00:04:40,110
...الجيش

49
00:04:41,500 --> 00:04:44,340
.أعتقد أنّ علينا التّوقّف

50
00:04:45,570 --> 00:04:47,350
ماذا نفعل؟

51
00:04:48,350 --> 00:04:50,670
،أشجار الصّفصاف تنحني ولا تنكسر
.تحت ثقل الثّلوج

52
00:04:50,670 --> 00:04:52,540
.لنتّبع أوامرهم

53
00:04:53,230 --> 00:04:55,010
!سنغيّر المسار

54
00:04:55,010 --> 00:04:57,040
!تمّ إرسال إشارة النّداء

55
00:04:57,040 --> 00:04:59,260
!لندعهم يتحكّمون في الدّفّة

56
00:04:59,260 --> 00:05:00,890
.تحت أمرك

57
00:05:10,800 --> 00:05:12,510
.تمّ تأكيد الاقتراب

58
00:05:13,720 --> 00:05:18,120
يطلب الجيش إلغاء
.كلّ أنظمة السّفينة الدّفاعيّة

59
00:05:18,120 --> 00:05:19,560
هل نقبل؟

60
00:05:19,970 --> 00:05:21,800
.نعم

61
00:05:21,800 --> 00:05:23,410
.تمّ قبول الطّلب

62
00:05:23,410 --> 00:05:27,160
.تمّ إلغاء كلّ الأنظمة الدّفاعيّة

63
00:05:28,930 --> 00:05:31,880
حسنًا، هل سنستطيع النّزول
من السّفينة في الميناء؟

64
00:05:32,270 --> 00:05:36,020
يبدو أنّ بإمكاننا النّزول
.إن ملأنا الأوراق اللاّزمة

65
00:05:36,330 --> 00:05:41,820
.لا ضرر من قتل بعض الوقت
.أشكّ في أنّ الأمر سيمرّ بسرعة

66
00:05:41,820 --> 00:05:46,240
لكن أعتقد أنّه ينبغي على كلّ من
.لديه سبب للقلق أن يبقى هنا

67
00:05:46,700 --> 00:05:48,750
.مـ-مفهوم

68
00:05:55,640 --> 00:05:58,550
.يكفي! قلتُ أنّي لن أذهب

69
00:05:59,160 --> 00:06:02,520
.هيّا. لا تكن مملاًّ هكذا

70
00:06:02,520 --> 00:06:04,050
!مرحبًا يا يوري

71
00:06:04,050 --> 00:06:05,220
.عليك المجيء أيضًا

72
00:06:05,690 --> 00:06:08,330
إنّه وقت الاحتفال! ما رأيك؟

73
00:06:08,810 --> 00:06:11,290
.تبدو لي متحمّسًا كثيرًا

74
00:06:11,290 --> 00:06:14,080
بالطّبع! هذه قاعدة عسكريّة، أليس كذلك؟

75
00:06:14,080 --> 00:06:15,710
أيوجد شيء ما هنا؟

76
00:06:15,710 --> 00:06:17,200
.حيّ البغاء

77
00:06:17,200 --> 00:06:17,980
ماذا؟

78
00:06:18,320 --> 00:06:21,210
،بعض الأشياء لا تتغيّر أبدًا
.حتّى بعد مرور ألف سنة

79
00:06:21,210 --> 00:06:26,480
يا إلهي... لا توجد حماقة أكبر
.من السّماح لرغباتكم بالتّحكّم بكم

80
00:06:27,970 --> 00:06:30,690
.تبًّا، جميعكم مملّون

81
00:06:31,110 --> 00:06:32,430
.هيّا، لنذهب

82
00:06:35,650 --> 00:06:37,330
!مهلاً

83
00:07:03,820 --> 00:07:05,580
القاعدة 52؟

84
00:07:05,580 --> 00:07:08,490
،نعم. أنا أبحث عن شخص معيّن هناك

85
00:07:08,490 --> 00:07:10,970
.لذلك كنتُ آمل أن يعرفها شخص ما هنا

86
00:07:10,970 --> 00:07:12,220
أتعرفها؟

87
00:07:12,670 --> 00:07:15,500
...القاعدة 52... 52

88
00:07:15,930 --> 00:07:17,200
...أعتقد

89
00:07:18,120 --> 00:07:19,810
.أنّه من هناك

90
00:07:19,810 --> 00:07:21,370
.شكرًا جزيلاً لك

91
00:07:22,420 --> 00:07:23,430
...عفوًا

92
00:07:24,510 --> 00:07:26,760
هل يمكنني طرح بعض الأسئلة عليك؟

93
00:07:27,710 --> 00:07:31,230
.أكيد. ولكن ليس بدون مقابل

94
00:07:31,230 --> 00:07:32,080
ماذا؟

95
00:07:33,150 --> 00:07:35,300
.أنا أمزح فحسب

96
00:07:35,730 --> 00:07:38,050
ما الّذي أردت أن تسألني عنه؟

97
00:07:43,230 --> 00:07:45,930
.لا يوجد أيّ أحد هناك باسم سِتسو

98
00:07:45,930 --> 00:07:49,560
بحثتُ في السّجلاّت الشّخصيّة
.في السّنوات المائة الأخيرة أيضًا

99
00:07:50,070 --> 00:07:52,850
.هكذا إذًا... حدث ذلك بالفعل

100
00:07:52,850 --> 00:07:54,510
ماذا؟ ما الّذي حدث؟

101
00:07:54,990 --> 00:07:57,600
.لا شيء. شكرًا جزيلاً لك

102
00:07:58,440 --> 00:08:00,120
.آمل أن تستطيع إيجاده

103
00:08:00,470 --> 00:08:02,070
.لا بدّ أنّه شخص مهمّ بالنّسبة لك

104
00:08:08,690 --> 00:08:11,740
.كما توقّعت، اختفى من الوجود بالكامل

105
00:08:12,240 --> 00:08:17,150
الشّخص المعروف باسم سِتسو
.لم يولد في هذا الكون ببساطة

106
00:08:19,360 --> 00:08:20,890
.أنا سِتسو

107
00:08:20,890 --> 00:08:22,680
.لم يحدث ذلك أبدًا

108
00:08:22,680 --> 00:08:23,950
.ولا ذلك

109
00:08:24,240 --> 00:08:25,430
.أو هذا

110
00:08:25,710 --> 00:08:26,740
.وهذا

111
00:08:27,570 --> 00:08:29,050
...كلاّ

112
00:08:29,050 --> 00:08:30,110
!اتركني

113
00:08:30,380 --> 00:08:32,770
.ما بالك؟ نحن لن نعضّك

114
00:08:32,770 --> 00:08:35,740
.إنّنا نقوم بدعوتك فحسب

115
00:08:35,740 --> 00:08:36,760
!جينا

116
00:08:37,450 --> 00:08:38,530
!يوري

117
00:08:38,530 --> 00:08:40,920
ماذا؟ ومن تكون أنت؟

118
00:08:40,920 --> 00:08:43,750
نحن تحت حجر صحّيّ بعد
...وصولنا من لو-آن

119
00:08:44,280 --> 00:08:46,710
.بسبب احتمال وجود عدوى غنوشيا

120
00:08:47,860 --> 00:08:48,920
!غنوشيا؟

121
00:08:48,920 --> 00:08:50,500
.لـ-لنذهب من هنا

122
00:08:57,120 --> 00:09:00,930
أعتقد أنّ الجميع خائفون
.من التّعرّض لعدوى الغنوشيا

123
00:09:01,530 --> 00:09:02,930
.ذلك صحيح

124
00:09:04,110 --> 00:09:06,210
،إن فكّروا بشكل منطقيّ فحسب

125
00:09:06,210 --> 00:09:09,770
فواضح أنّ الجيش ما كان ليدعنا
نذهب إلى المدينة

126
00:09:09,770 --> 00:09:12,350
.إن كانت هنالك أيّ فرصة بأنّنا مصابون

127
00:09:13,450 --> 00:09:15,940
.يوري، كان تمثيلك مقنعًا جدًّا

128
00:09:17,010 --> 00:09:20,800
.أعتقد أنّي صرت بارعًا في الكذب الآن

129
00:09:23,020 --> 00:09:24,290
...هذا

130
00:09:26,540 --> 00:09:30,330
.يبدو مثل سجلّ ملاحة لرحلات فضائيّة تاريخيّة

131
00:09:30,330 --> 00:09:31,620
.فهمت

132
00:09:32,040 --> 00:09:36,320
إنّه يحتوي على سجلاّت تقارب
.ألف سنة لنظام ألاكوسيا النّجميّ

133
00:09:36,320 --> 00:09:38,120
.لم أكن أعرف بوجود شيء كهذا

134
00:09:38,570 --> 00:09:39,640
أتريد إلقاء نظرة؟

135
00:09:50,560 --> 00:09:51,820
...مذهل

136
00:09:52,170 --> 00:09:55,970
بإمكانك رؤية كيف مرّت السّفن
.من مناطق معيّنة

137
00:09:58,650 --> 00:10:01,280
يحتاج مراقِبو المرور الفضائيّين
.لمعرفة مثل هذه الأشياء

138
00:10:01,960 --> 00:10:05,290
هنالك الكثير من الكويكبات
في ألاكوسيا، صحيح؟

139
00:10:05,710 --> 00:10:07,650
.أنا متفاجئة من معرفتك بذلك

140
00:10:07,650 --> 00:10:09,080
.أخبرني سِتسو بذلك

141
00:10:09,480 --> 00:10:10,750
سِتسو؟

142
00:10:11,920 --> 00:10:13,730
.لا تهتمّي

143
00:10:14,300 --> 00:10:17,090
أهذا هو الشّخص الّذي ذكرتَه البارحة؟

144
00:10:17,950 --> 00:10:18,820
.نعم

145
00:10:19,230 --> 00:10:22,030
لكن يقول الجميع أنّ هذا
.بسبب ذاكرتي المشوّشة

146
00:10:23,010 --> 00:10:25,880
.كم أودّ أن تخبرني عنه

147
00:10:26,550 --> 00:10:27,390
ماذا؟

148
00:10:27,940 --> 00:10:32,320
.إن تحدّثتَ عنه، فقد تشعر ببعض التّحسّن

149
00:10:36,390 --> 00:10:38,170
...ذهب إلى الجانب الآخر إذًا

150
00:10:39,210 --> 00:10:40,140
.نعم

151
00:10:40,620 --> 00:10:44,950
،أعتقد أنّه بسبب عبوره للباب البُعديّ

152
00:10:44,950 --> 00:10:48,540
،وانتقاله إلى كون آخر
.صار وكأنّه لم يوجد هنا من الأساس

153
00:10:48,540 --> 00:10:49,460
.فهمت

154
00:10:50,050 --> 00:10:52,280
.واثق أنّه من الصّعب تصديق هذا

155
00:10:53,250 --> 00:10:55,100
.لا يمكنني حتّى تصوّر الأمر

156
00:10:55,100 --> 00:10:56,270
.هكذا إذًا

157
00:10:56,760 --> 00:11:01,050
لكنّي أيضًا لا أستطيع تصوّر
.أنّك تكذب حيال كلّ هذا

158
00:11:01,600 --> 00:11:02,700
...جينا

159
00:11:03,170 --> 00:11:07,350
إذًا فهذا المدعوّ سِتسو حيّ
.في ذلك العالم الآخر

160
00:11:07,760 --> 00:11:08,610
.نعم

161
00:11:09,180 --> 00:11:12,720
،انتهت الآن مسألة دخولي في حلقات
.لذلك لا يمكنني التّأكّد من الأمر

162
00:11:13,130 --> 00:11:14,440
انتهت؟

163
00:11:14,810 --> 00:11:18,810
.نعم. ذلك ما قاله لي عندما عبر الباب

164
00:11:18,810 --> 00:11:23,630
عليّ مواصلة دخول الحلقات في الجانب
—الآخر لهذا الباب حتّى أنتهي

165
00:11:24,210 --> 00:11:28,320
حتّى أقدّم لك المفتاح
.الفضّيّ في الكون الآخر

166
00:11:29,080 --> 00:11:34,080
لذلك أعتقد أنّه سيقدّم
.المفتاح لي في الكون الآخر

167
00:11:34,080 --> 00:11:35,310
فعلاً؟

168
00:11:35,310 --> 00:11:36,060
ماذا؟

169
00:11:36,770 --> 00:11:39,470
...لستُ واثقة تمامًا، لكن

170
00:11:39,990 --> 00:11:42,150
،رحل سِتسو سلفًا

171
00:11:42,160 --> 00:11:45,640
لكن ألا يزال عليه تسليم المفتاح
لنسختك من هذا الكون؟

172
00:11:48,800 --> 00:11:51,180
.آسفة. أتكلّم بلا تفكير

173
00:11:51,710 --> 00:11:53,590
.ربّما لا يسير الأمر بتلك الطّريقة

174
00:11:58,710 --> 00:11:59,980
!راكيو

175
00:12:01,380 --> 00:12:03,990
.أنا آسف! تذكّرتُ أنّ عليّ القيام بأمر ما

176
00:12:31,660 --> 00:12:33,030
...المفتاح الفضّيّ

177
00:12:34,020 --> 00:12:35,760
هل أنت مهتمّ به؟

178
00:12:36,680 --> 00:12:39,680
يستعمله البضع لأنّهم يرغبون
،في العودة للماضي

179
00:12:39,680 --> 00:12:41,370
لكنّ الأمر المرعب فيه

180
00:12:41,370 --> 00:12:43,870
هو أنّه لا يمكنك حتّى اختيار
.إنهاء الأمور بنفسك

181
00:12:44,240 --> 00:12:45,540
إنهاء الأمور؟

182
00:12:45,540 --> 00:12:46,610
.نعم

183
00:12:46,610 --> 00:12:51,890
لن يترك هذا الشّيء مضيفه حتّى
.يمتلئ بالمعلومات الّتي يرغبها

184
00:12:51,890 --> 00:12:54,960
.ستستمرّ الحلقات حتّى يرضى

185
00:12:54,960 --> 00:12:57,610
.قد ينتهي بك المطاف تدخل حلقات للأبد

186
00:13:04,550 --> 00:13:05,810
!راكيو

187
00:13:08,020 --> 00:13:10,240
.ثمّة أمر أحتاج لأسألك عنه

188
00:13:13,990 --> 00:13:15,260
.فهمت

189
00:13:16,290 --> 00:13:18,040
ما رأيك؟

190
00:13:18,040 --> 00:13:21,010
هل سيستطيع سِتسو إغلاق الحلقة هناك؟

191
00:13:21,570 --> 00:13:24,140
.هذا هو ما يسمّى التّفكير المتفائل

192
00:13:24,970 --> 00:13:29,030
.سأكون صريحًا. ما قالته جينا صحيح

193
00:13:29,470 --> 00:13:31,470
،بهدف الرّبط بين السّبب والنّتيجة

194
00:13:31,470 --> 00:13:37,510
سِتسو بحاجة لإعطائك المفتاح
.الفضّيّ في هذا الكون

195
00:13:37,860 --> 00:13:39,400
...مستحيل

196
00:13:39,400 --> 00:13:44,620
،أنا أفترض أنّ سِتسو إلى الكون الآخر
،وهو يعرف تمامًا أنّ هذا سيحدث

197
00:13:45,050 --> 00:13:47,300
.بهدف إنقاذك

198
00:13:54,930 --> 00:13:58,910
على سِتسو مواصلة دخول
حلقات في الكون الآخر؟

199
00:13:59,440 --> 00:14:01,650
وعرف أنّ هذا سيحدث؟

200
00:14:03,510 --> 00:14:04,770
.اهرب

201
00:14:04,770 --> 00:14:05,800
شيبي؟

202
00:14:06,240 --> 00:14:07,860
!اهرب فحسب

203
00:14:11,020 --> 00:14:13,160
.عجبًا، إنّه يوري

204
00:14:13,480 --> 00:14:14,850
شا-مينغ؟

205
00:14:14,850 --> 00:14:16,600
.ظهرتَ في وقتك

206
00:14:16,600 --> 00:14:20,280
كنت في الخارج أشرب مع شيبي
.حتّى قرّر ذلك الوغد التّخلّي عنّي

207
00:14:20,280 --> 00:14:21,970
.لكنّك ستفي بالغرض

208
00:14:21,970 --> 00:14:24,840
ماذا؟ إلى أين سنذهب؟

209
00:14:25,450 --> 00:14:26,530
!السّماء

210
00:14:29,670 --> 00:14:33,140
!لقد وصل مصدر تمويلنا الجديد
!لتستمرّ القناني بالمجيء

211
00:14:33,140 --> 00:14:34,630
.هيّا، اشرب

212
00:14:34,630 --> 00:14:36,100
...مهلاً، ولكن

213
00:14:42,410 --> 00:14:44,980
.بالمناسبة، هذا هو الحساب الحاليّ

214
00:14:44,980 --> 00:14:47,430
.لذلك ادفع لو سمحت. شكرًا لك

215
00:14:47,430 --> 00:14:50,640
.ماذا؟! لا يمكنني دفع كلّ هذا

216
00:14:50,640 --> 00:14:52,950
!هيّا! أنا أتوسّل إليك

217
00:15:00,960 --> 00:15:02,960
.حسنًا، افتح فمك

218
00:15:06,040 --> 00:15:09,280
...لهذا السّبب أخبرني شيبي بأن أهرب

219
00:15:09,280 --> 00:15:13,370
أخبرني ذلك الوغد أنّه مهتمّ
.بالقطط فحسب

220
00:15:13,370 --> 00:15:14,690
.كم هو مزعج

221
00:15:14,690 --> 00:15:16,850
...ذلك ليس رأيي فيه

222
00:15:17,440 --> 00:15:19,860
هل ستقول نفس الشّيء؟

223
00:15:19,860 --> 00:15:22,010
.لا فائدة من التّظاهر بالهيبة

224
00:15:22,010 --> 00:15:26,820
واثق أنّ هنالك فتاة أو فتاتين على
.الأقلّ تودّ اصطحابهما إلى فراشك

225
00:15:27,530 --> 00:15:28,740
.بل لا يوجد

226
00:15:28,950 --> 00:15:34,040
ماذا؟! أكره الأشخاص الّذين يحاولون
.التّصرّف وكأنّهم أعلى قدرًا من هذا

227
00:15:34,040 --> 00:15:35,390
...ناهيك عن ذكر

228
00:15:35,390 --> 00:15:36,290
...ولكن

229
00:15:36,290 --> 00:15:37,160
ماذا؟

230
00:15:37,890 --> 00:15:40,920
.هنالك شخص عزيز عليّ بالفعل

231
00:15:41,560 --> 00:15:42,970
إذًا صارت بينكما علاقة؟

232
00:15:42,970 --> 00:15:44,390
.الأمر ليس كذلك

233
00:15:45,210 --> 00:15:47,680
إذًا أستحدّق فيه وإصبعك
في مؤخّرتك فحسب؟

234
00:15:47,680 --> 00:15:50,620
!لكنّي خائف كثيرًا فحسب"
ماذا لو تألّمت؟" أليس كذلك؟

235
00:15:51,990 --> 00:15:54,340
ماذا؟ ليس لديك أيّ شيء آخر لتقوله؟

236
00:15:54,780 --> 00:15:56,770
.أعتقد أنّي أصبت بكلامي

237
00:15:57,240 --> 00:15:58,460
...ذلك ليس صحيحًا

238
00:15:59,350 --> 00:16:02,540
!لو استطعتُ الذّهاب خلفه، لفعلت

239
00:16:02,540 --> 00:16:05,010
.لكن لا يوجد ما يمكنني فعله

240
00:16:05,870 --> 00:16:07,360
...لا شيء

241
00:16:09,060 --> 00:16:11,990
...لا يوجد أيّ شيء

242
00:16:14,490 --> 00:16:15,890
هل يبكي؟

243
00:16:15,890 --> 00:16:17,390
.كم هذا ظريف

244
00:16:17,390 --> 00:16:18,280
!يكفي

245
00:16:20,850 --> 00:16:23,380
ألا يوجد ما يمكنك فعله بالفعل؟

246
00:16:24,450 --> 00:16:27,650
أواثق أنّك لا تبحث عن عذر
للاستسلام فحسب؟

247
00:17:24,770 --> 00:17:25,850
ماذا؟

248
00:17:32,160 --> 00:17:34,480
كـ-كيف سار التّفتيش العسكريّ؟

249
00:17:34,480 --> 00:17:36,520
.انتهى للتّوّ

250
00:17:36,520 --> 00:17:40,230
،لم يكتشفوا أيّ أثر للغنوشيا
.لذلك يمكننا المغادرة بلا مشاكل

251
00:17:40,890 --> 00:17:42,400
.حمدًا على هذا

252
00:17:43,490 --> 00:17:44,870
أين راكيو؟

253
00:17:45,250 --> 00:17:49,890
...تسأل عن راكيو؟ أعتقد أنّه عاد للتّوّ

254
00:17:51,640 --> 00:17:52,750
!راكيو

255
00:17:55,520 --> 00:17:57,470
.عرفتُ أنّك ستأتي

256
00:18:00,470 --> 00:18:02,470
من أين حصلت على ذلك المفتاح الفضّيّ؟

257
00:18:02,470 --> 00:18:05,270
.هذا موضوع تجاربي الثّمين

258
00:18:05,270 --> 00:18:06,690
.كان عليّ شراؤه

259
00:18:07,640 --> 00:18:10,070
.اهدأ قليلاً فحسب

260
00:18:10,070 --> 00:18:10,890
ماذا؟

261
00:18:11,220 --> 00:18:16,590
تريد السّماح للمفتاح بجعلك مضيفه
لتستطيع فتح الباب بعد أن تملأه

262
00:18:16,590 --> 00:18:19,200
وتذهب خلف سِتسو، صحيح؟

263
00:18:20,010 --> 00:18:21,930
.تلك هي الطّريقة الوحيدة

264
00:18:22,420 --> 00:18:24,290
أتعتقد أنّ بإمكانك النّجاح في ذلك؟

265
00:18:24,290 --> 00:18:25,710
!لا خيار آخر لديّ

266
00:18:25,710 --> 00:18:29,600
.سِتسو عالق هناك، عاجز عن إغلاق حلقاته

267
00:18:29,600 --> 00:18:33,610
!إن لم أذهب، فسيدخل الحلقات للأبد

268
00:18:37,140 --> 00:18:37,970
ماذا؟

269
00:18:38,450 --> 00:18:41,800
.سأذكّرك ثانية، اهدأ

270
00:18:41,800 --> 00:18:45,260
لماذا فعل كلّ هذا من الأساس في رأيك؟

271
00:18:45,260 --> 00:18:46,520
...لأنّ

272
00:18:46,990 --> 00:18:49,020
.لتستطيع أن تعيش

273
00:18:49,340 --> 00:18:53,960
لأنّك أنت ونسختك الحقيقيّة
.لا تستطيعان التّواجد في نفس الكون

274
00:18:54,530 --> 00:18:57,700
كان ذلك هو السّبب في أنّ الحلّ الوحيد
.هو عبور سِتسو لذلك الباب

275
00:18:57,700 --> 00:19:00,360
لذلك ما الّذي سيحدث إن ذهبت خلفه؟

276
00:19:00,730 --> 00:19:03,100
.ستتسبّب بنفس المشكلة ثانية لا غير

277
00:19:03,100 --> 00:19:04,570
وكلّ العناء الّذي تكبّده سِتسو

278
00:19:04,570 --> 00:19:08,440
وجهودك أثناء ملك المفتاح
الفضّيّ الّذي فتح الباب

279
00:19:08,440 --> 00:19:10,490
.ستضيع هباءً

280
00:19:12,050 --> 00:19:15,780
.الأمر واضح، إن فكّرت فيه بشكل منطقيّ

281
00:19:19,920 --> 00:19:22,000
ما الّذي عليّ فعله إذًا؟

282
00:19:22,000 --> 00:19:26,360
!ما زال سِتسو هناك، عاجزًا عن إغلاق حلقاته

283
00:19:26,740 --> 00:19:28,310
.عليك أن تنساه

284
00:19:28,920 --> 00:19:33,600
هذا المدعوّ سِتسو لا يوجد
.في هذا الكون من الأساس

285
00:19:34,580 --> 00:19:38,120
لا فائدة من التّفكير في أمر
.شخص لا يوجد من الأساس

286
00:19:38,120 --> 00:19:40,630
.هذه حقيقة معروفة

287
00:19:40,630 --> 00:19:42,120
...ولكنّ ذلك

288
00:19:42,120 --> 00:19:45,200
لكن إن كانت تلك الإجابة
.لا تعجبك، لديّ أخرى

289
00:19:46,390 --> 00:19:48,720
.هذا ما أراده سِتسو

290
00:19:51,480 --> 00:19:53,520
.لا يمكنني مجادلة ذلك

291
00:19:53,520 --> 00:19:57,240
.إنّ كلّ شيء قاله راكيو كان صحيحًا

292
00:20:13,030 --> 00:20:14,920
...ما أراده سِتسو

293
00:20:15,620 --> 00:20:18,470
أراد سِتسو... أن أواصل العيش
.في هذا الكون

294
00:20:19,860 --> 00:20:24,220
.وأيضًا... أراد أن يختفي منه

295
00:20:31,750 --> 00:20:33,940
...عفوًا يا يوري

296
00:20:35,100 --> 00:20:36,220
...أوتومي

297
00:20:36,700 --> 00:20:38,680
.هذا مقهى لطيف

298
00:20:38,680 --> 00:20:39,580
.نعم

299
00:20:39,580 --> 00:20:41,730
هل أحبّ سِتسو التّواجد هنا؟

300
00:20:41,730 --> 00:20:42,400
ماذا؟

301
00:20:42,400 --> 00:20:44,330
هل أخطأت؟

302
00:20:44,330 --> 00:20:48,070
.لا، معك حقّ. تفاجأت لأنّك اكتشفت ذلك

303
00:20:48,070 --> 00:20:53,530
،لم يبدُ كمكان قد تحبّه أنت
.لذلك توقّعتُ أنّه كذلك

304
00:20:54,610 --> 00:20:58,730
لكنّك لا تذكرين أيّ شيء
عن سِتسو، صحيح؟

305
00:20:58,730 --> 00:21:01,100
.صحيح. أنا آسفة

306
00:21:01,100 --> 00:21:04,920
.لا بأس. هذا ما يفترض أن يحدث

307
00:21:04,920 --> 00:21:07,520
...لأنّه في هذا الكون

308
00:21:07,520 --> 00:21:08,540
...ولكن

309
00:21:09,110 --> 00:21:14,960
لا يمكنني تذكّر وجهه أو صوته
...أو مظهره، ولكن

310
00:21:15,340 --> 00:21:19,650
.أشعر بوخزةٍ صغيرة كلّما سمعتُ ذلك الاسم

311
00:21:20,720 --> 00:21:22,110
وخزة؟

312
00:21:23,560 --> 00:21:25,300
.هنا تمامًا

313
00:21:35,690 --> 00:21:36,980
!يوري؟

314
00:21:40,090 --> 00:21:44,380
عرفتُ هذا! ما كان ليختفي
.بالكامل بتلك السّهولة

315
00:21:44,910 --> 00:21:47,310
.ما كان ليُمحى من الوجود

316
00:21:48,930 --> 00:21:53,060
...حتّى إن ذهب إلى بعد آخر
...إلى كون آخر بالكامل

317
00:21:53,060 --> 00:21:54,120
...فإنّ قلبه

318
00:21:55,000 --> 00:21:59,000
!ومشاعره... أقوى من ذلك

319
00:22:00,600 --> 00:22:01,750
راكيو؟

320
00:22:03,580 --> 00:22:04,760
راكيو؟