146
00:12:38,290 --> 00:12:40,670
! أيتهـا الناقلــةُ أجيــبي .. هُـنا غـرفـةُ التحكــم

147
00:12:42,040 --> 00:12:43,520
! ليـسَ لــديكـم تصــريحٌ للإقــلاع

148
00:12:44,030 --> 00:12:45,480
! عــودوا إلى المقــرِ بســرعــة

149
00:13:28,930 --> 00:13:30,270
! يـالهـا مــن فوضــى

150
00:13:37,880 --> 00:13:40,370
قـد يكـونُ هــذا هــوُ المُتحـفَ الحضـاريَ للفــنون

151
00:13:40,450 --> 00:13:41,090
.. لــذا

152
00:13:41,750 --> 00:13:43,540
قـد تكـونُ هـنا قلعـةُ الأعــداءِ في المنتـزهِ المـركـزي

153
00:13:44,420 --> 00:13:45,260
! إنهــم مُحقــون

154
00:13:45,430 --> 00:13:46,710
! إنـهُ عُــشُ  للدبـابيــرِ بالفعــل

155
00:13:47,670 --> 00:13:49,800
! في هــذه الحـالـة ... فهــذه هـارليـم بالتأكيــد

156
00:14:00,010 --> 00:14:01,240
.. أيهـا الرجــال

157
00:14:01,400 --> 00:14:03,600
مرحبًــا يا ولــد .. تبـدوا مثـل الجنــود

158
00:14:03,820 --> 00:14:06,570
مـن المستحيــلِ أن تكــونَ  أنـتَ هـوَ مـن سيقــومُ بـإنقـاذنـا

159
00:14:06,700 --> 00:14:08,180
مــرحبًـا بكَ في هارليــم

160
00:14:08,360 --> 00:14:09,460
التي يتحـاشــاها الجميــع

161
00:14:09,460 --> 00:14:11,310
حيــثُ هـيَ الآنَ ســاحةُ واشنطــن الجـديــدة

162
00:14:12,610 --> 00:14:13,730
! ت ... تــوقفــوا

163
00:14:13,910 --> 00:14:16,140
! إن بقيــتم هكـذا فســوفَ يـرونــكم بــدونِ شــك

164
00:14:16,470 --> 00:14:17,610
لا تقلــق يا فــتى

165
00:14:17,880 --> 00:14:20,500
! لا يُمكــنُ لأحـدٍ أن يــوقـفَ موسيقــانــا

166
00:14:22,180 --> 00:14:23,700
إذا قُــتلـتُـم فســوفَ تنتهــي

167
00:14:24,400 --> 00:14:27,000
! إنـنــي ... أقــاتُــلَ هنـا مـن أجــلِ الحيــاة

168
00:14:36,310 --> 00:14:36,990
أرجــوكـم

169
00:14:37,760 --> 00:14:40,560
هـل يُمكـنكمُ أن تجمعـوا الناجيــنَ مـن هارليــم ؟

170
00:15:08,550 --> 00:15:09,850
! تبـًـــا

171
00:15:21,490 --> 00:15:22,640
ذلكَ الطــريـقُ شــديدُ الخطــورة

172
00:15:33,170 --> 00:15:35,110
هـل إستمتعــتِ بـأضــواءِ بــرود واي .. ســارة ؟

173
00:15:36,110 --> 00:15:38,180
يبــدوا بأنـكَ استمتعــتَ بالأنفــاقِ أنـتَ أيـضًــا

174
00:15:41,880 --> 00:15:42,780
! يــا إلهــي

175
00:15:43,720 --> 00:15:47,270
قــد لا نتفِــقُ مـع بعضــنا ... لكـن يبــدوا بـأن قــدرنـا أن نبـقى ســويًـا

176
00:15:50,600 --> 00:15:52,000
! إنتبهــا ! إحتميــا

177
00:15:55,520 --> 00:15:58,390
مـا الأمــر ؟ إعتقــدتُ أنـكَ ستكــونُ في هـارليـم الآن

178
00:15:58,650 --> 00:16:00,060
لقـــد  فــاتني القطــار

179
00:16:02,820 --> 00:16:03,940
! أُنظــرا إلى هـذا

180
00:16:08,200 --> 00:16:09,010
! ت ... تـبًـــا

181
00:16:17,650 --> 00:16:18,250
! جيـــرال

182
00:16:18,580 --> 00:16:19,500
! إنــهُ جيــرالُ العجــوز

183
00:16:33,040 --> 00:16:33,590
! حســنًا

184
00:16:33,830 --> 00:16:34,580
... إلى الجميــع

185
00:16:34,780 --> 00:16:36,150
عليكُــمُ الإنتظــارُ هنــا

186
00:16:37,950 --> 00:16:39,080
إلى أيــنَ ستــذهــبُ .. مــاســاتـو ؟

187
00:16:41,080 --> 00:16:44,170
! لا يستطيــعُ أيُ شخــصٍ أن يُـرشـدكم عبــرَ النفــقِ ســوى وحــش

188
00:17:00,350 --> 00:17:01,100
! اللعنــة

189
00:17:01,430 --> 00:17:04,470
حـتى نستطيــعَ إنقــاذَ سكــانَ هارليـم ... لا يُمكـنـنا مُهـاجمـةُ القـاعــدة

190
00:17:04,670 --> 00:17:06,650
! لا أريــدُ القيــامَ بشـئٍ كهــذا ثـانيـةً

191
00:17:06,800 --> 00:17:09,800
جميعكــم ... الوضــعُ بالنسبــةٍ  لسكــانِ هارليـم ... تحـتَ السيطــرة

192
00:17:10,180 --> 00:17:10,860
مـاذا ؟

193
00:17:15,590 --> 00:17:18,250
سـأقـودهم للهــربِ عبـر المجـاريـر ... دعــوا ذلكَ الأمــرَ لي

194
00:17:27,100 --> 00:17:28,010
ذلكَ الفــتى ؟

195
00:17:28,600 --> 00:17:31,180
بمسـاعـدتكـما أيهـا الرجـلانِ الشجـاعــان

196
00:17:31,660 --> 00:17:32,890
ســوفَ أُنهـي هــذا الأمـر

197
00:19:34,550 --> 00:19:36,580
حســنًـا شينــوبـو .... لننسحـــب

198
00:19:36,920 --> 00:19:37,450
مفهــوم

199
00:20:40,820 --> 00:20:41,800
! تمهــل ... تمهـــل

200
00:20:41,980 --> 00:20:43,820
! لقــد قُمـنا بإكمــالِ المهمــة .. جنــرال

201
00:20:43,990 --> 00:20:46,830
صحيــح ... لمــاذا إذن تقــومُ بسجـنـنــا ؟

202
00:20:46,920 --> 00:20:49,370
لـقـد أمــرتُكـم بألا تستعمــلوا وحوشـكمُ القتـاليــة

203
00:20:49,920 --> 00:20:53,630
وبالإضـافــةِ إلى هـذا ..فالتقـاريـرُ أثبـتت بـأنكـمُ إتخـذتـم طُــرقًـا مختلفــة

204
00:20:53,630 --> 00:20:54,750
.. لكــن جنــرال إيجــور

205
00:20:55,150 --> 00:20:57,210
.. إنَ عملهُـم الجمـاعـيَ بإستعمـالِ الوحـوشِ القـتاليـة

206
00:20:57,210 --> 00:20:57,710
! كـــلا

207
00:20:58,210 --> 00:21:02,530
! على الجنــديِ .. أن يُطيــعَ الأوامــرَ مهمــا كــان

208
00:21:02,570 --> 00:21:03,470
..ول.. ولكــن

209
00:21:03,470 --> 00:21:04,460
! خــذوهـم مـن هنــا بســرعة

210
00:21:04,690 --> 00:21:06,300
! أتركــوني ... أتــركــوني أيهـا الأوغــاد

211
00:21:08,500 --> 00:21:09,410
... جنـــرال إيجــور

212
00:21:10,030 --> 00:21:10,820
.. أعلــم

213
00:21:11,230 --> 00:21:13,500
أعلــمُ تمـامًــا بأنـي أقـسـوا عليهــم

214
00:21:14,140 --> 00:21:15,400
لكــن ... دكتــور هـازوكـي

215
00:21:15,650 --> 00:21:19,000
هــؤلاءِ الأغبيــاء ... ســوفَ أُجبـرهـم مهمـا كلـفَ الأمــر

216
00:21:19,870 --> 00:21:21,350
مهما كلف الامر

217
00:21:28,650 --> 00:21:29,250
أيهــا الوغــد

218
00:21:29,470 --> 00:21:30,710
عليــكَ أن تحــذرَ عنــدمـا أخــرُج

219
00:21:30,840 --> 00:21:33,130
ألا يُمكــنُكَ أن تُخفــضَ صــوتكَ .. شينــوبــو ؟

220
00:21:36,170 --> 00:21:37,310
! جيـــرال

221
00:21:38,380 --> 00:21:39,540
توقعــتُ حــدوثَ هــذا

222
00:21:39,910 --> 00:21:40,330
! تشيــه

223
00:21:40,800 --> 00:21:43,610
لــم يكُـن هنـالكَ داعٍ لسجنِـكَ هنــا

224
00:21:43,610 --> 00:21:44,000
! كـلا

225
00:21:44,340 --> 00:21:45,030
... لكـني أظــنُ

226
00:21:45,380 --> 00:21:47,960
أظــنُ بـأنَ الجنــرالَ يـواجـهُ قــرارًا كبيــرًا للغايــة

227
00:21:48,520 --> 00:21:49,440
هــل فهمــتم ؟

228
00:21:49,670 --> 00:21:50,410
قــرارٌ كبيــر ؟

229
00:21:50,940 --> 00:21:52,480
لكــنـني لا أعلــمُ مــاهــو

230
00:23:24,690 --> 00:23:26,600
الحلقة القادمة من دانكوجار

231
00:23:26,990 --> 00:23:30,040
تخطـى الوحـش تخطـى المقـاتل

232
00:23:29,020 --> 00:23:30,040
تحــول إلى المحــاربِ الخــارق

233
00:23:30,390 --> 00:23:31,200
الجــزء الأول

234
00:23:31,760 --> 00:23:32,840
Yatte yaru ze