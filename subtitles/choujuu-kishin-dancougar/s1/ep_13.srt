"إذن فـأنتَ أحـدُ أفــرادِ " ق.و.م  ؟

159
00:09:32,280 --> 00:09:33,270
مـن أنــت ؟

160
00:09:33,740 --> 00:09:36,250
" ضـابـطُ إمبـراطـوريـةِ زوربـادوس  "بيســتوري

161
00:09:36,410 --> 00:09:41,260
يالِشكلـكَ هـذا ! لـم أتـوقـع أنـنـا نتقـاتـلُ مـع غربـاءَ غيـرِ آدميـيــن

162
00:09:42,150 --> 00:09:43,940
إمــرح كمـا تحــب

163
00:09:47,100 --> 00:09:50,080
لقــد سبـبـتم لنـا الكثيــرَ مـن المتـاعـب

164
00:09:50,220 --> 00:09:52,710
والآن حـانَ الـوقـتُ لكـي تـدفـعَ أنـتَ الثمــن

165
00:10:12,500 --> 00:10:14,770
!والآن .. أخبــرنا بمـا نـريــدُ أن نعـرفــه

166
00:10:15,850 --> 00:10:17,760
لـن أخبــركم بـأيِ شــئ

167
00:10:18,270 --> 00:10:19,640
! أيهـا اللعيــن

168
00:10:22,490 --> 00:10:23,770
إنـكَ قـويٌ فعــلاً

169
00:10:24,020 --> 00:10:25,920
لكـنكَ ســوفَ تتحـدثُ عمـا قــريب

170
00:10:26,110 --> 00:10:29,390
أنـت .. ما اسمـكَ ووحـدتكَ ؟ وأيــنَ هـي قـاعـدتكـم ؟

171
00:10:30,040 --> 00:10:31,480
! أنظــر جيــدًا إلى هــذا

172
00:10:38,150 --> 00:10:39,060
! دانيـيــلا

173
00:10:50,330 --> 00:10:51,490
مـا الـذي تفعـله ؟

174
00:10:51,620 --> 00:10:53,290
لا عـلاقـةَ لـدانيـيـلا بهــذا

175
00:10:53,420 --> 00:10:54,630
! أتركهـا تـذهــب

176
00:10:54,720 --> 00:10:56,710
إذن عليـكَ التعـاونُ لكـي تنقـذها

177
00:10:57,000 --> 00:10:59,890
إذا أردتَ أن تنقـذهـا ، عليـكَ أن تخبـرنا مـا نـريـد

178
00:11:00,060 --> 00:11:03,790
! وإلا ، فـإنكَ سـوفَ تراهـا تصبـحُ طعـامًـا للنســور

179
00:11:03,790 --> 00:11:05,810
الأمــرُ كلـهُ يعــودُ لك

180
00:11:06,210 --> 00:11:09,360
لـديـكَ الكثيــرُ مـن الوقـت ... فكــرِ جيــدًا في هــذا

181
00:11:15,440 --> 00:11:16,850
! دانيـيــلا

182
00:11:17,020 --> 00:11:20,220
! أرجـوكم ! دعـوني أذهـبُ لإنقـاذهـا أرجـوكـم

183
00:11:22,950 --> 00:11:25,300
! دانيـيــــلا

184
00:11:27,290 --> 00:11:28,170
! ضــابـط بيستــوري

185
00:11:29,480 --> 00:11:32,350
لقـد نفـذنـا مـا وعـدنـا ، وهـاهـو الرجـلُ بيـنَ يـديـك

186
00:11:32,920 --> 00:11:36,130
لـذا .. فهـل تـوفـي بـوعـدكَ وتنسحـبَ مـن هنـا ؟

187
00:11:36,310 --> 00:11:37,450
وعــدنـا ؟

188
00:11:40,950 --> 00:11:43,550
وهـل تتـوقـعُ مـنا أن نحـافـظَ على وعـودنـا ؟

189
00:11:44,430 --> 00:11:46,150
! اللعنــة ! لقـد خـدعتنـا

190
00:11:51,010 --> 00:11:54,260
هــذهِ المـدينـةُ الآنَ تخضـعُ لجيـشِ إمبـراطـوريـةِ زوربـادوس

191
00:11:54,440 --> 00:11:56,520
! ولـن نتسـامحَ مـع المقـاومــة

192
00:12:19,550 --> 00:12:20,630
أميجـو بالأسبـانيـة تعنـي : صـديقي

193
00:12:19,550 --> 00:12:20,630
هيي ، أميجــو

194
00:12:25,280 --> 00:12:27,940
! خلفهــم ! عليكـمُ الذهـابُ لإحضـارهـم

195
00:12:30,010 --> 00:12:32,880
شكــرًا على الإنقــاذِ سينـوريتـا .. بالمنـاسبـة رداءٌ جميــل

196
00:12:30,600 --> 00:12:31,530
سينيـوريتـا : آنســة

197
00:12:33,590 --> 00:12:36,010
لقـد إحتجـتُ إليـه للتسـلـلِ عبــرَ الحـراسـات

198
00:12:40,260 --> 00:12:44,510
يا إلهـي ! عليَ العـودةُ للقـاعـدةِ وتقبـلِ عقــابِ الجنـرال ديـث جـايـا

199
00:12:44,990 --> 00:12:46,460
هـاذانِ اللعيــنان

200
00:12:46,810 --> 00:12:50,100
بالتـأكيـدِ أنهـما سيتجهـانِ نحـوَ زمـلائهـما .. وإلى وحـوشهـما أيضًـا

201
00:12:55,810 --> 00:12:57,730
أنـتَ بخيــر ... جـونزاليـس ؟

202
00:12:58,410 --> 00:12:59,970
إنـنـي بخيـــر

203
00:13:00,100 --> 00:13:02,460
! لكـن ... عليـنا إنـزالُ دانيـيــلا بسـرعـة

204
00:13:18,130 --> 00:13:19,210
! أيهــا الغــبي

205
00:13:19,210 --> 00:13:20,760
! فشلــتَ ثـانيــة

206
00:13:22,190 --> 00:13:23,270
لا يُهــم

207
00:13:24,660 --> 00:13:28,230
إنـنـي مستعـدٌ تمـامًـا لقتـالنـا الأخيــر

208
00:13:28,440 --> 00:13:29,740
إنهـا فرصـةٌ رائعـة

209
00:13:30,520 --> 00:13:32,610
! هــذهِ المـرةَ سـأحطهـم تمـامًـا

210
00:13:36,220 --> 00:13:39,080
أيتهـا الوحـوشُ اللعيــنة ... إنتظـريـني

211
00:13:45,080 --> 00:13:49,210
! لأنكِ سـوفَ تشهــديـنَ على قــوةِ ديــث جـروم الجــديــدِ هــذا

212
00:14:04,130 --> 00:14:06,330
! اللعنــة ! لحقــوا بنـا

213
00:14:14,130 --> 00:14:15,720
كــانَ هـذا رائعًـا ، ريــو

214
00:14:15,720 --> 00:14:16,460
بالطبــع

215
00:14:16,670 --> 00:14:17,380
! هيــا

216
00:14:23,030 --> 00:14:23,850
ثـانـيـةً ؟

217
00:14:39,800 --> 00:14:41,700
إنــهُ يبـالـغُ كعـادتـه

218
00:14:52,400 --> 00:14:54,980
! إنهمـا هنـاك ! أسـرعا ! أسـرعـا

219
00:15:05,370 --> 00:15:06,510
! أنـتَ ثـانيــةً

220
00:15:07,680 --> 00:15:08,620
أنتـم مستعــدون ؟

221
00:15:51,800 --> 00:15:54,260
! أيهـا الأغبيـاءُ لسـتم نـدًا لي

222
00:15:54,910 --> 00:15:57,020
! تراجعــوا ! سـأتـولي أمـرهـم لوحـدي

223
00:16:02,750 --> 00:16:03,910
شــئٌ مشــوق

224
00:16:04,490 --> 00:16:06,970
تريــدونَ أن أنـالَ منكـم واحـدًا تلـوَ الآخـر ؟

225
00:16:13,250 --> 00:16:14,090
سـأنـالُ مـنه

226
00:16:14,800 --> 00:16:16,330
! علـيَ أن أنــالَ منــه

227
00:16:16,810 --> 00:16:18,690
لـمَ أنـتَ ثـائـرٌ هكـذا ، ريـو ؟

228
00:16:18,790 --> 00:16:21,590
إنـهُ لا يثــورُ أبــدًا ، دعـه يقـم بهــذا

229
00:16:21,790 --> 00:16:23,930
! أريـدُ رويـةَ زميـلي الكبيــرِ في المعـركــة

230
00:16:36,180 --> 00:16:38,020
هيــومانويــد  تشــاينـج

231
00:16:38,870 --> 00:16:39,760
! إنطــلاق

232
00:16:41,500 --> 00:16:42,030
! كـلا

233
00:16:42,350 --> 00:16:42,980
بروفيســور ؟

234
00:16:43,730 --> 00:16:46,230
إنـه ليـس معتـادًا على القتـالِ بالوضـعِ الآدمـي

235
00:16:46,440 --> 00:16:47,170
هـذا خطِــر

236
00:16:47,330 --> 00:16:48,820
لا .. هـذا هـو طبعـه

237
00:16:49,310 --> 00:16:50,870
بالتـأكيـدِ بـأن لـديهِ خطـةً مـا

238
00:17:41,290 --> 00:17:44,450
تحـوُلـكَ المفـاجئُ هـذا ... لـن يســاعــدك

239
00:18:25,950 --> 00:18:27,200
! مستحيــل ! هـذا غيـرُ ممكـن

240
00:18:37,810 --> 00:18:41,680
! إنـه يستعمـلُ تقنيـاتـهِ القـتاليـة مستعمـلاً الوضـعَ الآدمـي

241
00:19:06,370 --> 00:19:07,180
! مــذهـــل

242
00:19:21,060 --> 00:19:22,010
! نـالَ مـني

243
00:19:36,550 --> 00:19:39,240
! أيهـا المزعـج ! سـأنتهـي منـكَ بضـربـةٍ واحـدة

244
00:20:08,580 --> 00:20:10,290
! لا أستطيــعُ تحـريكَ اليـدِ اليمنـى

245
00:20:14,850 --> 00:20:17,020
! والآن ... حـانت لحظـةُ نهايتــك

246
00:20:20,170 --> 00:20:21,110
! ريو .. ريـــــو

247
00:20:21,220 --> 00:20:23,640
! لا تتـدخـل شينـوبــو ! إنــهُ لـي

248
00:20:37,560 --> 00:20:38,390
! الآن

249
00:21:20,240 --> 00:21:21,450
لقــد إنتهـيت

250
00:21:30,500 --> 00:21:33,910
أخـي .. لقـد عادت بلـدتنا سالمـةً ثـانيـةً

251
00:21:40,440 --> 00:21:41,260
أشكــرك

252
00:21:41,900 --> 00:21:42,670
ريــو

253
00:21:52,940 --> 00:21:57,970
يـومًـا مـا عنـدما ينتهـي قتـالنـا هـذا .. سـآتي لأنضـمَ لأحـدِ مهـرجـاناتكـم

254
00:21:58,460 --> 00:21:59,570
وحـتى ذلكَ الوقـت

255
00:21:59,890 --> 00:22:01,520
أديـوس : الـوداع

256
00:21:59,890 --> 00:22:01,520
أديــوس ، دانيـيــلا

257
00:23:27,750 --> 00:23:29,950
الحلقة القادمة من دانكوجار

258
00:23:30,180 --> 00:23:31,760
قتـالٌ قي مــدينـةِ نيــوريــوك

259
00:23:31,920 --> 00:23:33,040
Yatte yaru ze