137
00:09:55,780 --> 00:10:00,620
لكـن .. أريـدُ أن أعـرفَ  منـكِ  من الرجـلُ الذي علمـكِ  تلكَ  الأغنيـة

138
00:10:00,620 --> 00:10:02,840
!  فهــذا  الأمــرُ  مهـمٌ  جــداً  !  أخبــريني  رجــاءاً

139
00:10:04,510 --> 00:10:07,010
أخبــريني ...  هــل  كــانَ  يبــدو  هكـذا ؟

140
00:10:27,900 --> 00:10:29,090
.... ذلكَ

141
00:10:29,090 --> 00:10:30,580
!  القــائــدُ  شــابيــرو

142
00:10:33,690 --> 00:10:36,020
تلكَ  المـرأةُ  لـونـا  مميــزةٌ  حقــاً

143
00:10:36,270 --> 00:10:39,260
ســوفَ  يكشــفُ  هــذا   الكثيــرَ  بشــأنِ  القائــد  شـابيــرو

144
00:10:39,690 --> 00:10:43,420
أخبــريني  يا لــورا ....  في أيِ  مكــانٍ  تقـابلـتي  مــع  ذلكَ  الرجـل ؟

145
00:10:43,530 --> 00:10:45,320
الكهــفُ  الإلهــي

146
00:10:45,460 --> 00:10:47,440
الكهــفُ  الإلهــي ؟

147
00:10:54,380 --> 00:10:56,790
تأخــرتي  كثيــراً  في رصــدنـا

148
00:10:56,790 --> 00:10:59,540
ذلكَ  الكهــفُ  ســوفَ  يكــونُ قبـــراً  لكِ

149
00:11:01,960 --> 00:11:04,760
جنـــرال ...  تمكنــتُ  من العثـورِ  على بيــاناتِ  موقــعه

150
00:11:04,760 --> 00:11:06,490
سنتمكــنُ  من القيـامِ بشيـئينِ  معــاً

151
00:11:06,490 --> 00:11:09,520
تدميـــرُ  " ق.و.م " ومعـرفــةُ  ســرِ تلكَ  الأغنيــة

152
00:11:12,770 --> 00:11:14,520
أصبــحَ  الموضــوعُ  مشــوقاً

153
00:11:14,520 --> 00:11:17,920
بيســتوري .. هــل  محضــرةُ  الأوهــامِ  تعمــلُ  بشــكلٍ  جيــد ؟

154
00:11:17,920 --> 00:11:19,370
نعــم ...  بأكمــلِ  وجــه

155
00:11:58,240 --> 00:12:00,420
كــانَ  والــدي  يعمــلُ   هنــا

156
00:12:00,420 --> 00:12:02,920
هكــذا  ...  في  ذلكَ  المرصــد ؟

157
00:12:03,420 --> 00:12:05,290
قابلــتُ  ذلكَ  الرجــلَ  هــناك

158
00:12:05,780 --> 00:12:07,880
نطلـقُ  عليــه  الكهــفَ  الإلهــي

159
00:12:08,270 --> 00:12:10,150
مرصــدٌ  وبجـانبــهِ  كهــف

160
00:12:10,700 --> 00:12:12,240
بالتأكيــدِ  تلك تشبــهُ  أفعــالَ  شــابيـرو

161
00:12:13,250 --> 00:12:14,660
!  أختـــي

162
00:12:15,980 --> 00:12:16,840
!  لـــورا

163
00:12:35,970 --> 00:12:38,540
هـل  كنـتي  تأتيــنَ  للعــبِ  هنــا ... يا لــورا ؟

164
00:12:39,240 --> 00:12:40,980
بإمكـــانكِ  رؤيــةِ  الإلـه  هنــا

165
00:12:41,110 --> 00:12:42,330
الإلــه ؟

166
00:12:48,790 --> 00:12:53,150
إذا  صلــيتي  بشكــلٍ  كــافٍ  ... فسيظهــرُ  الإلـهُ  في تلكَ  البحيــرة

167
00:12:58,850 --> 00:13:02,210
شــابيــرو ...  تُــرى  مـا  الذي  قمــت  بالصلاةِ  من أجلــه ؟

168
00:13:02,320 --> 00:13:04,250
أهــو  من أجــلِ إنجــازاتٍ  دنيــوية ؟

169
00:13:04,410 --> 00:13:05,590
أم يــا  تــرى

170
00:13:05,590 --> 00:13:09,050
الهــروبَ  من  طمــوحكَ  وأن  تحصــلَ  على  راحــةِ  البــال ؟

171
00:13:16,580 --> 00:13:18,670
لــورا  ؟  مــا  الأمـرُ  يا لــورا ؟

172
00:13:18,790 --> 00:13:20,790
!  لــــورا  !  تمــاسكـي

173
00:13:24,320 --> 00:13:26,640
ســـارة  ...  مرحبــاً  بكِ

174
00:13:26,970 --> 00:13:28,820
!شــا ...  شـابيــرو ؟

175
00:13:29,080 --> 00:13:32,380
إتبعــي  خطــواتـي ....  نحــو  أرضِ  الآلــهة

176
00:13:32,380 --> 00:13:33,510
شابيـــرو

177
00:13:33,510 --> 00:13:36,320
بإمكــاني  أن  أسمــعَ  صــوتك ... لكـن أيــنَ  أنــت ؟

178
00:13:38,340 --> 00:13:39,560
! شابيـــرو

179
00:13:57,740 --> 00:14:01,080
! ســارة ...  إنضمــي  إليَ  في  أرضِ  الآلهـــة

180
00:14:03,750 --> 00:14:04,970
.... بيكـــي

181
00:14:32,740 --> 00:14:34,770
جهــازُ  الإستقبــالِ  الحيــوي  رصــد  موجــاتٍ  لســارة

182
00:14:35,290 --> 00:14:37,240
إنــهُ  يظهــرُ  إنخفـاضــاً  في موجــاتها  الدمـاغيــة

183
00:14:37,240 --> 00:14:38,180
مــاذا  حــدثَ  لهــا ؟

184
00:14:38,180 --> 00:14:39,140
حســناً

185
00:14:39,140 --> 00:14:41,470
شينــوبـو ...  أيمكــنكَ  التعامــلُ   لوحــدك  ؟

186
00:14:41,470 --> 00:14:42,270
بروفيســـور

187
00:14:42,270 --> 00:14:45,330
أيمكــنُ  أن يكــونَ  ذلكَ  الكهــفُ  مسئـولاً  عن هــذا ؟

188
00:14:45,330 --> 00:14:47,100
كهـــفٌ  يظهــرُ  فيــه  الإلــه ؟

189
00:14:47,730 --> 00:14:50,400
أعتقــدُ  أن  هــذا  ليـسَ  سـوى  خــرافـة

190
00:14:50,680 --> 00:14:53,430
أيمكـــنُ  أن  يكــونَ  ذلكَ  هجــوماً  من ديــث  جـايـا ؟

191
00:14:53,430 --> 00:14:55,650
لا  توجــدُ  قــراءاتٌ  في  موشــرِ  القــتال

192
00:14:55,650 --> 00:14:56,760
مــاذا  تعـني ؟

193
00:14:57,040 --> 00:14:58,870
شـــئٌ  مــا  حصــلَ  لســارة

194
00:14:58,870 --> 00:15:00,960
ســواءاً  كــانَ  أمــراً  جســدياً  أو  نفســياً

195
00:15:01,450 --> 00:15:03,540
لكــن لا  يوجــدُ  أيُ  أثــرٍ  للعــدو

196
00:15:04,290 --> 00:15:05,940
! إذن  فنحــنُ  لا نعلــمُ  أيَ  شــئ

197
00:15:12,780 --> 00:15:15,430
شينــوبـو ...  لــورا  في خطــرٍ  أيضــاً ..  نعتمـدُ  عليـك

198
00:15:15,430 --> 00:15:16,560
لا  تقلـــق

199
00:15:16,560 --> 00:15:20,450
تلكَ  المـزاجيـــة ... ربمـا  تكــونُ  قــد  ابتعــدت  كثيــراً  عن الكهــف

200
00:15:20,450 --> 00:15:22,190
أراهــنُ  أنهــا تستنشـقُ  بعـضَ  الهــواءِ  المنعـش

201
00:15:25,280 --> 00:15:27,990
" جنــرال  !  رصــدنـا  مقاتلــةً  مـن " ق.و.م

202
00:15:28,380 --> 00:15:31,300
دعــوه  يــذهـب ..  إن  إهتمــامي  بالمــرأةِ  فقــط

203
00:15:31,300 --> 00:15:32,300
! جيــــل  دروم

204
00:15:32,540 --> 00:15:34,600
لمــاذا  تقــومُ باستنـسـاخِ  صــوتي  ؟

205
00:15:35,020 --> 00:15:37,570
!  إنـنــي  لـم  آمــر  بإستعمــاله  في خطــةٍ  كهــذه

206
00:15:37,570 --> 00:15:38,420
... لكـــن

207
00:15:38,420 --> 00:15:41,660
لــونــا  قـد  أعطــتني الأوامـــر الصـادرةَ  من الإمبـراطــورِ  ميــوج

208
00:15:42,390 --> 00:15:45,000
هــل أزعجـتُـكَ  بهــذا  الأمــرِ .. أيهـا القائــد ؟

209
00:15:45,630 --> 00:15:47,260
سأتحـــرى  بشــأنِ  هـذا  الأمــر

210
00:15:47,260 --> 00:15:49,070
إقبضـــوا  على  ذلكَ  الرجــلِ  في تلكَ  المقـاتلــة

211
00:15:49,630 --> 00:15:52,500
بالطبـــع .... كمــا  ترغـــب

212
00:15:57,260 --> 00:16:00,690
! ســـارة

213
00:16:01,570 --> 00:16:02,890
!  شابيـــرو

214
00:16:03,800 --> 00:16:05,000
! بيكـــي

215
00:16:05,070 --> 00:16:06,440
!  ســـارة

216
00:16:07,210 --> 00:16:12,180
هـذه فرصـتُكِ  الأخيـرة ...  لكـي تأتـي وتنضمـي لي  في أرضِ الآلهـة

217
00:16:12,180 --> 00:16:15,280
"عليــكي  أن  تختــاري  بيــني   وبيـن  " ق.و.م

218
00:16:15,280 --> 00:16:16,850
ولابــدَ  من إختيــارٍ واحـدٍ  فقــط

219
00:16:16,850 --> 00:16:19,120
فمـا هــو  إختيـــارُكِ  ؟

220
00:16:19,600 --> 00:16:20,940
أيـــنَ  أنــت ؟

221
00:16:21,150 --> 00:16:24,060
إذا  أردتَ  التحــدثَ  معـي ...  فأظهــر  نفســـك

222
00:16:25,550 --> 00:16:28,090
... أريــدُ  أن  أســألكَ  شيـئاً

223
00:16:28,090 --> 00:16:30,970
! عــــودي  إلى  داخــلِ  الكهــف  !  عــودي  إليــه

224
00:16:31,850 --> 00:16:33,390
إلى  الكهــف ؟

225
00:16:48,220 --> 00:16:49,060
.... هــذه

226
00:16:49,630 --> 00:16:51,840
موجــاتٌ  فــوقَ  صوتيــةٍ  بتــرددِ  35  ألفَ  هــرتز

227
00:16:52,840 --> 00:16:54,550
إنهـا تتخطــى  قــدرةَ  السمــعِ  البشــري

228
00:16:54,830 --> 00:17:00,210
لكـن  أيمكنـهم إرسـالٌ  إشـاراتٍ  للدمـاغِ البشـري بشكـلٍ  مباشـر ؟

229
00:17:13,510 --> 00:17:15,210
هــل  ســارة  موجـودةٌ  داخـلَ  هـذا  الكهـف ؟

230
00:17:36,520 --> 00:17:38,540
شابيــرو  ...  تحــدث  إلي

231
00:17:38,770 --> 00:17:41,060
أخبــرني  أيــنَ  تقــعُ  أرضُ  الآلهــةِ  تلك ؟

232
00:17:41,370 --> 00:17:42,320
! ســارة

233
00:17:45,480 --> 00:17:47,760
! ســارة !  هــذا  أنــا ...  شينـوبــو

234
00:17:52,020 --> 00:17:53,240
ليــس  هــذا  جيــداً

235
00:18:01,000 --> 00:18:01,750
! ســارة

236
00:18:02,180 --> 00:18:04,160
! أســرعي  بالعـودةِ  إلى  النمــرِ  الأرضــي

237
00:18:08,320 --> 00:18:09,920
! شينــوبــو

238
00:18:09,920 --> 00:18:12,530
!  إستيقظــي  هيــا !  عــودي  إلى مركبــتِك

239
00:18:12,530 --> 00:18:14,820
إنـنــي  محاطــةٌ  بمجمـوعةٍ  من الشـياطيـن

240
00:18:14,960 --> 00:18:15,690
... ســـارة

241
00:18:15,690 --> 00:18:19,200
! إن  مـا تريــنهُ  هـو  خيــالاتٌ  سبـبــها  موجــاتٌ  فــوقَ  صــوتيــة

242
00:18:19,200 --> 00:18:19,910
!  ســـارة

243
00:18:19,910 --> 00:18:21,010
!  شــابيـــرو

244
00:18:21,190 --> 00:18:22,870
!  ســارة  !  عــودي  لمركبــتكِ  بسـرعــة

245
00:18:22,870 --> 00:18:25,980
!  إن  الوضــعَ  بغايــةِ  الخطــورة  !  إنـه  ليـسَ  عــدواً  عاديـاً

246
00:18:36,050 --> 00:18:37,760
!  ذلكَ  هـو مصــدرُ  تلكَ  الموجــاتِ  إذن

247
00:18:43,810 --> 00:18:45,570
شابيـــرو !  هــل أنتَ  هنــاك ؟

248
00:18:45,570 --> 00:18:47,170
!  أخـــرج  إلى  هنــا  وقــاتلـني

249
00:18:48,160 --> 00:18:49,080
شابيـــرو

250
00:19:02,130 --> 00:19:03,290
!  الل... اللعنــة

251
00:19:33,460 --> 00:19:35,010
! ســـارة  !  إستيقظـــي

252
00:19:39,590 --> 00:19:41,030
! دعـــي  أمــرهم  لي

253
00:19:45,870 --> 00:19:47,170
!  أيهــا  الأوغـــاد

254
00:20:25,310 --> 00:20:26,940
!  تبـــــاً

255
00:20:27,380 --> 00:20:28,640
Yatte yaru ze

256
00:20:27,380 --> 00:20:28,640
لأقـــم بهـــا

257
00:20:56,610 --> 00:21:00,510
يبــدو  بأن  تلكَ  المـرأةَ  كـانت  تهتـمُ  لأمــرِ  القائــد  شابيــرو

258
00:21:01,280 --> 00:21:04,470
مجـــردُ  معـرفــةِ  هــذا  يجعــلُ  تلكَ  المهمــةَ  ناجحـــة

259
00:21:04,590 --> 00:21:07,770
والآن ...  لننطلـــق  نحــوَ   جبهــةِ  أوروبــا  يا  جيـــل

260
00:21:08,060 --> 00:21:08,970
حـا ... حاضـــر

261
00:21:18,360 --> 00:21:20,400
تـــرى  ما  الذي  صــلى  شـابيــرو  من أجلـه ؟

262
00:21:20,400 --> 00:21:22,280
مــا  الذي  قــررهُ  وهــو  بالـداخـل ؟

263
00:21:22,820 --> 00:21:25,640
حســناً  أيتهــا  المزاجيــة ....  هــل  توصــلتي  لأيِ  شــئ ؟

264
00:21:37,230 --> 00:21:39,140
هــل  هــذا  الكهــفُ  مهــمٌ  لكِ  ؟

265
00:21:39,390 --> 00:21:40,840
هــلا  سكـــتتَ  قليــلاً  ؟

266
00:21:44,380 --> 00:21:46,040
يالــهُ  من صــوتٍ  غامـــض

267
00:21:47,650 --> 00:21:49,010
... إنــها  الريــاحُ  فحســـب

268
00:21:49,010 --> 00:21:52,680
مضـافاً  إليهـا  أصــداءُ  الصــوتِ  الغريبــةِ  هـا هـنا

269
00:21:52,680 --> 00:21:54,540
إنـنــا  نسمــعُ  هـذا  في  أرضِ  الآلــه

270
00:21:55,050 --> 00:21:56,790
حــاول  أن  تتخيـــلَ  قليـــلاً

271
00:23:28,590 --> 00:23:30,780
في الحلقة القادمة من دانكوجار

