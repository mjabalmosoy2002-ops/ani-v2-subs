1
00:00:02,000 --> 00:00:08,340
دانكوجار

2
00:00:03,000 --> 00:00:08,340
الوحش الآلي الخارق

3
00:01:14,650 --> 00:01:20,650
مراجعـة وإنتـاج
Karimostyle

4
00:01:24,840 --> 00:01:29,480
قـامَ الأعــداءُ ببنــاءِ رادارٍ ضخــمٍ في أحـدِ المـواقـعِ بالصيــن

5
00:01:29,610 --> 00:01:34,840
" وهـو بالتحـديـدِ يضـاهـي تصميـمًـا أرضيـًــا يُــدعى " الرادارُ الخــارق

6
00:01:35,290 --> 00:01:38,170
ومـا إن ينتهـيَ بــناؤه .. فستكــونُ قـاعـدةُ " ق.و.م " في خطــر

7
00:01:38,300 --> 00:01:40,880
ولـذلكَ تــم إرســالُ فــريقِ "  ق.و.م " لتحطيــمِ ذلكَ الرادار

8
00:01:41,700 --> 00:01:42,490
.. لكـــن

9
00:01:42,490 --> 00:01:45,800
" وقعــوا فـي فــخٍ يُـدعــى  " دائــرةَ المــوت

10
00:01:46,180 --> 00:01:49,260
وتلكَ الدائــرة ... هــي من بــناتِ أفكــارِ شـابيــرو كيتــس

11
00:01:49,870 --> 00:01:52,580
واستطــاعت ســارةَ تعُــرفَ تلكَ الخطــة

12
00:01:53,420 --> 00:01:55,430
في تلكَ الأثــناء .. كــانَ البروفيســور هازوكــي

13
00:01:55,800 --> 00:01:58,560
" يبحــثُ عـن طــريقــةٍ لإنقــاذِ فــريقِ " ق.و.م

14
00:01:58,620 --> 00:02:00,500
وقــامَ بفتــحِ ملــفٍ ســريٍ في الحاســوب

15
00:02:01,050 --> 00:02:02,970
وبـذلكَ ... يقـــومُ  بالبـدءِ في تقنيــةٍ

16
00:02:03,050 --> 00:02:07,420
تسـمـحُ للتحــولِ الأقــوى .. الـوحــشِ الآلي الخارق دانكـوجــار بالتكــون

17
00:02:10,550 --> 00:02:15,440
الحلقة
16

18
00:02:10,600 --> 00:02:15,440
تخطـى الوحـش تخطـى المقـاتل

19
00:02:10,600 --> 00:02:15,440
تحــول إلى المحــاربِ الإلهـي

20
00:02:10,600 --> 00:02:15,440
الجــزء الثـاني

21
00:02:15,750 --> 00:02:17,030
هيــا الآن

22
00:02:17,160 --> 00:02:18,770
تحــرك مــا بعــدَ الغضــبِ الوحشــي

23
00:02:18,770 --> 00:02:19,940
أيهــا المُحـاربُ الإلهــي

24
00:02:19,940 --> 00:02:24,990
عليــكَ أن تنبعــثَ وتتحــولَ إلى "الوحـشِ الآليِ الإلهـي الخارق " دانكــوجــار

25
00:02:45,310 --> 00:02:47,230
تــرى أهــو بدايــةُ تحــولٍ جـديد ؟

26
00:02:48,190 --> 00:02:49,580
إنهـا فــرصــةٌ مناسبــةٌ يا لـونــا

27
00:02:49,690 --> 00:02:52,780
أُنظــري ... إنهــمُ الآنَ في وضعيــةٍ لا تسـاعُـدهم في حمـايــةِ أنفُســهم

28
00:02:53,200 --> 00:02:55,070
هاجمــوا .... هاجمـوهــم بضــراوة

29
00:03:01,320 --> 00:03:03,270
! إنهــم ... يحاولــونَ نسفــنا

30
00:03:04,290 --> 00:03:07,240
ســنفعلُـها ... ســنُـولـدُ ونصبـحُ الآلـةَ الخارقــة

31
00:03:07,420 --> 00:03:08,690
! شينــوبــو ... تــوقــف

32
00:03:08,870 --> 00:03:10,150
! عليــنا الهــربُ أولاً

33
00:03:10,370 --> 00:03:11,120
! شينــوبـــو

34
00:03:11,380 --> 00:03:13,080
! لا تجُـرنــا معــكَ إلى ذلكَ الجُــنون

35
00:03:14,930 --> 00:03:15,950
المُحــاربُ الإلهــي

36
00:03:16,210 --> 00:03:18,170
الوحـشُ الآلــيُ الخــارق   دانكـــوجـــــار

37
00:03:20,330 --> 00:03:21,210
! لا فائــدة

38
00:03:21,570 --> 00:03:23,660
إن شيــنوبــو يقــومُ بالسيطــرةِ على مركبــتي

39
00:03:29,260 --> 00:03:31,990
.... حيــثُ توجــدُ الإدارةُ والرغبــة

40
00:03:35,540 --> 00:03:40,080
إذا قطعـتُ تلكَ الدائــرة ...  ربمـا أستطيــعُ أن أُلغــيَ سيطــرةِ النســرِ علـي

41
00:03:40,700 --> 00:03:41,490
! لأقــم بالمحاولــة

42
00:04:08,930 --> 00:04:10,450
ريــو ... ومــاذا الآن ؟

43
00:04:10,960 --> 00:04:12,920
! لـو بقيــنا ســاكنين ومـع بعضــنا فلــن ننجــو

44
00:04:13,890 --> 00:04:15,080
لننفصــل إلى مجمـوعتيــن إذن

45
00:04:15,170 --> 00:04:16,300
سـأهتــمُ بالنســـر

46
00:04:16,410 --> 00:04:16,980
! حســنًــا

47
00:04:16,980 --> 00:04:18,680
! ماسـاتــو ... إلحــق بي

48
00:04:31,480 --> 00:04:32,340
! شــئٌ مخــزيٍ

49
00:04:32,830 --> 00:04:34,190
! كِــدنا أن نقضــيَ عليــهم

50
00:04:34,310 --> 00:04:37,100
! لســتَ سيــئًـا بمــا أنهـا معــركـتُـكَ الأولـى

51
00:04:37,500 --> 00:04:39,110
هــل أنـتَ تقــومُ بالسخــريــةِ يـا جنــرال ؟

52
00:04:39,480 --> 00:04:41,730
لقــد كـانت تلكَ الجــولـةَ الأولـى من المعـركـة

53
00:04:42,060 --> 00:04:42,640
... لا

54
00:04:42,790 --> 00:04:44,490
! لــم تنتــهي الجــولــةُ الأولـى بعــد

55
00:04:47,590 --> 00:04:50,570
إن دائــرتـي ... لــن تُكســرَ بتلكَ السُهــولة

56
00:04:54,210 --> 00:04:55,550
... أُركضــوا أركضــوا

57
00:04:55,680 --> 00:04:57,760
! قــومــوا باستنــزافِ  طــاقتِكُــم

58
00:04:58,170 --> 00:05:01,610
وعنـدمــا تبــدأون بالإنهيــار ... ســأدفِــنُكــم إلى الأبــد

59
00:05:04,630 --> 00:05:05,820
ما خطــبُ الشـاشــة ؟

60
00:05:05,950 --> 00:05:07,560
! ليـست هُــنالكَ أيــةُ إشــاراتٍ من النســر

61
00:05:08,250 --> 00:05:10,100
هـل قــامــوا بالإلتحـامِ وتكــويـنِ  دانكــوجار ؟

62
00:05:10,730 --> 00:05:13,340
! أجهــزةُ إستقبــالِ الطاقــة ... لا تستقبــلُ شيــئًــا

63
00:05:14,580 --> 00:05:16,430
إن هــذا هــو أحـدُ أســوأِ أوقـاتـنا

64
00:05:17,280 --> 00:05:19,440
! لا أريــدُ الإفــتراضَ بأن الوحــوشَ المحـاربــةَ قــد دُمــرت

65
00:05:19,760 --> 00:05:22,090
ربمــا ســوفَ يقــومــونَ بالإلتحــامِ في وقـتٍ آخــر

66
00:05:22,540 --> 00:05:24,270
لا ... إن ذلكَ مستحيـــل

67
00:05:24,870 --> 00:05:28,460
وذلكَ .. لأن طــاقتهـم ليســت كافيــةً للقيــامِ بالإلتحــام

68
00:05:28,790 --> 00:05:29,580
مــاذا؟

69
00:05:30,200 --> 00:05:32,910
... وإن لـم يتــمَ تزويــدُهـم بالطـاقــة

70
00:05:32,910 --> 00:05:34,260
فليــسَ بإمكـانهم أن يقــومــوا بالإلتحـام

71
00:05:34,400 --> 00:05:35,890
ومــا الذي يُمكـنـنا فعلــهُ يا بروفيســور ؟

72
00:05:36,200 --> 00:05:38,200
الطـائــرةُ الناقلــة ... لديهــا مخـزونٌ من الطاقــة

73
00:05:38,490 --> 00:05:40,850
لكــن ... هــل تستطيــعُ أن تكسِــرَ تلكَ الدائــرة ؟

74
00:05:49,910 --> 00:05:51,780
لقــد تأخــرَ الأطفـالُ كثيــرًا هــذه المــرة

75
00:05:51,980 --> 00:05:52,990
تُــرى ما خطبُهــم ؟

76
00:05:53,470 --> 00:05:55,620
هُــنالكَ سكــوتٌ تــام

77
00:05:55,790 --> 00:05:56,590
! أيهــا الأبلــه

78
00:05:56,760 --> 00:05:58,260
! عليــكَ أن تقــومَ باستعمــالِ أُذُنيــك

79
00:05:58,700 --> 00:06:01,630
! مــن دونِ مسـاعـدتنا ... فهــم سيكـونــونَ عاجـزينَ تمــامًــا

80
00:06:01,880 --> 00:06:03,900
... حاضــر ... لقــد حاولـتُ ولكــن

81
00:06:05,010 --> 00:06:08,840
إن أكثــرَ ما يُثيــرُ قلقــي ... هـو مســتوى طاقتهـم الكافي للقــتال

82
00:06:27,730 --> 00:06:29,270
أعتقـــدُ بـأنـهـم فقــدوا آثــارنــا

83
00:06:32,470 --> 00:06:32,980
! تشيــه

84
00:06:33,280 --> 00:06:35,000
! إنهــم مُصــرونَ على البحـثِ عــنا

85
00:06:35,160 --> 00:06:35,970
.... فــريــقُ النقــل

86
00:06:36,150 --> 00:06:37,890
أيهــا القائــد ... أجــبني رجــاءًا

87
00:06:38,180 --> 00:06:38,970
! أيهــا القائــد

88
00:06:40,180 --> 00:06:40,890
! لا فــائــدة

89
00:06:41,110 --> 00:06:42,260
! هنــالكَ موجــاتُ تشــويــشٍ قــوية

90
00:06:42,260 --> 00:06:44,020
! لـم أستطــع الإتصــالَ بفــريقِ النقــل

91
00:06:44,170 --> 00:06:45,190
! وكــذلكَ حــالي أيـضًــا

92
00:06:45,390 --> 00:06:46,910
إنهــم قادمــونَ بهــذا الإتجــاه

93
00:06:47,110 --> 00:06:48,430
يبــدو بأن حظـنا بـدأ ينفــذ

94
00:06:48,780 --> 00:06:51,230
في هــذه الحالـة ... لنهاجـهم بمـا تبقــى لديـنا من طـاقــة

95
00:06:51,320 --> 00:06:52,880
! ســآخــذُهـم معــي إلى نهايــتهم

96
00:06:53,670 --> 00:06:55,560
هــاهــيَ عقليــةٌ مشـلولــةٌ أُخــرى

97
00:06:55,560 --> 00:06:56,280
.. ولكن

98
00:06:56,280 --> 00:06:58,900
من السهل أن تستسلـمَ وتقبــلَ بالموت

99
00:06:59,030 --> 00:07:00,240
ومــاذا  نفعــلُ إذن ؟

100
00:07:00,560 --> 00:07:03,860
لا أعتقــدُ أن المسـافــةَ ســوفَ تزيــدُ عــن  100 كيلــومــتر

101
00:07:04,140 --> 00:07:06,080
وبإمكــاني الإســراعُ والوصـولُ إلى فــريقِ النقــل

102
00:07:06,250 --> 00:07:08,220
لكــن ... مــاذا بشــأنِ حصــارِ العــدو ؟

103
00:07:09,170 --> 00:07:13,110
إن أســلافي ينحــدرونَ من الصيـن ... وهنــالكَ حلفــاءٌ لي هــنا

104
00:07:31,180 --> 00:07:34,910
أتمــنى بأن يستطيــعــوا  الصمــودَ إلى أن أُعــودَ إليهــم بالوقـــود

105
00:07:38,150 --> 00:07:40,250
ريــو ... أتمـنى أن تكــونَ حـذرًا

106
00:07:48,910 --> 00:07:51,180
حـاولـتَ أن تلعــبَ دور َ البطــلِ يا شيــنوبــو

107
00:07:52,910 --> 00:07:55,010
لكــنكَ للأســفِ لــم تكُــن نــدًا لهــم

108
00:07:55,610 --> 00:07:58,340
إن خصمــكَ أفضــلُ على صعيــدِ التكتيــكِ والمهـارات

109
00:07:58,480 --> 00:07:59,860
صحيــح ... بالتأكيــد

110
00:08:00,220 --> 00:08:01,870
إنــهُ بالتأكيــدِ رجــلٌ كشـابيــرو

111
00:08:03,080 --> 00:08:06,650
إذا تبقــت أيـةُ آثــارٍ لشـابيــرو الذي كــنتُ أعـرفــه

112
00:08:07,010 --> 00:08:10,440
فإذا ظهــرتُ إليــه ... فربمـا قــد يستجيــبُ إلي

113
00:08:19,440 --> 00:08:20,160
.... شابيــرو

114
00:08:20,450 --> 00:08:22,740
أعــلمُ بـأنــك هنـاكَ في الخــارج

115
00:08:23,210 --> 00:08:25,540
.. دعـني أرى بـأنــكَ لازلـتَ تهتــم بي

116
00:08:50,310 --> 00:08:53,380
تنــاغم ، وحــب

117
00:08:53,570 --> 00:08:58,010
أريــدُك أن تنـظر في عيـنيَ

118
00:08:58,010 --> 00:09:01,270
تنــاغم ، وحــب

119
00:09:01,270 --> 00:09:05,550
لـو أن أمـانيَ حقيـقـية

120
00:09:05,550 --> 00:09:09,160
فسـتصـرح بحبـكَ لي

121
00:09:15,270 --> 00:09:16,190
! أُصمُـــت

122
00:09:16,350 --> 00:09:18,330
! ذلكَ اللحــنُ الأرضــيُ يثيــرُ الإكتئــاب

123
00:09:20,230 --> 00:09:21,200
! أنظُـــروا

124
00:09:21,590 --> 00:09:23,490
! إنهـا واحــدةٌ من جنــودِ القتــال الأرضيـيــن

125
00:09:23,930 --> 00:09:25,960
مــاذا ؟ تُــرى هــل تـنوي بأن تسـتسـلم ؟

126
00:09:26,380 --> 00:09:27,630
! كبـــروا الصــورة

127
00:09:35,410 --> 00:09:36,270
! ســـارة

128
00:09:41,720 --> 00:09:42,450
... شــابيــرو

129
00:09:42,890 --> 00:09:44,320
إنـنــي أثــقُ بــك

130
00:09:44,720 --> 00:09:46,630
! لا ... بل أريــدُ أن أومــنَ بهـذا

131
00:09:49,790 --> 00:09:52,010
إذن فقــدِ انضمـمــتي إلى قــوةِ الوحـوشِ المُحـاربـة ؟

132
00:09:52,500 --> 00:09:55,140
قُــمتي بخيـانتــي ... مــن أجــلِ أن تقـومي بحمـايـةِ الأرض ؟

133
00:09:55,760 --> 00:09:57,050
لا يمكــنُ أن أســامحَ الخـونــة

134
00:09:57,260 --> 00:09:57,880
... لكــن

135
00:09:58,120 --> 00:10:00,500
أخبــرنا مـا الذي سنفعــلُهُ ... بتلـكَ المــرأة ؟

136
00:10:00,940 --> 00:10:02,150
! إقبضــوا عليــها

137
00:10:02,500 --> 00:10:05,390
! عليــنا أن نقبــضَ عليهـا كأيِ جُــنديٍ مُسـتسـلم

138
00:10:05,390 --> 00:10:06,010
! حاضــر

139
00:10:07,890 --> 00:10:10,460
هــذهِ المهمــةُ يقــومُ بقيــادتها السيــد شــابيــرو

140
00:10:14,540 --> 00:10:15,510
... سيــد شــابيــرو

141
00:10:15,730 --> 00:10:18,000
قــد تكـونُ إمـرأةً لكنهــا هــي عــدُوكَ الأخطــر

142
00:10:18,130 --> 00:10:22,780
وإن كــان حُكــمُكَ سيــئًـا ... فبالتأكيــدِ  ســوفَ يســتاءُ الإمبـراطـور ميــوج كثيــرًا

143
00:10:23,360 --> 00:10:26,020
... كــلُ مـن يكســرُ دائــرتي يحصــلُ على

144
00:10:26,310 --> 00:10:27,430
حكُــمٍ بالمــوت

145
00:10:29,310 --> 00:10:31,660
لقــد سمعــتُم قــرارَ السيــدِ شــابيـرو

146
00:10:34,860 --> 00:10:35,830
ماذا يجري؟

147
00:10:40,170 --> 00:10:40,920
... شابيــرو

148
00:10:40,970 --> 00:10:41,940
تُــرى أيــنَ أنـت ؟

149
00:10:42,820 --> 00:10:44,030
تُــرى هل تُــراقبُــني ؟

150
00:10:52,780 --> 00:10:53,660
... شابيـــرو

151
00:10:53,660 --> 00:10:55,230
هــل كـانت هــذهِ  إجـابتــك ؟

152
00:11:24,620 --> 00:11:27,700
أدخلــتني في تلكَ اللعُبــة ... ومـن ثُــم ذهــبتي لكي تلعبــي ؟

153
00:11:28,540 --> 00:11:29,440
شيــنوبــو

154
00:11:30,570 --> 00:11:31,250
... ســارة

155
00:11:31,650 --> 00:11:32,950
! توقفــي عن مُطــاردةِ الأشبــاح

156
00:11:33,640 --> 00:11:34,870
أشبــاح ؟

157
00:11:35,400 --> 00:11:37,200
! إن عــدونـا ليــسَ هــو شــابيــرو

158
00:11:37,530 --> 00:11:39,050
! إنــه ليــسَ أكثــرَ من خائــنٍ للأرض

159
00:11:39,580 --> 00:11:41,960
لكــن العـدوَ  وشـابيــرو لهُـما نفــسُ المطـامح

160
00:11:47,690 --> 00:11:48,910
! وهــذا هــو كُــلُ شــئ

161
00:11:49,680 --> 00:11:50,600
... لكــن

162
00:11:53,710 --> 00:11:56,290
أرى بـأنَ العــدوَ لازالَ يمتلــكُ بعــضَ القُــوة

163
00:11:56,970 --> 00:11:59,770
أخبــرني مـا الـذي حــدثَ لخُــطتكَ العظيمــة ؟

164
00:11:59,970 --> 00:12:01,010
أنــتَ محُــق

165
00:12:01,740 --> 00:12:04,290
إنـهُ يستعمــلُ آخـرَ طـاقتــهِ لحمـايةِ الفــتاة والتبـاهي أمـامـها

166
00:12:04,500 --> 00:12:07,030
ولكــنهُ لا يمتـلكُ الطـاقــةَ الكافيــةَ لكـي يطيـــر

167
00:12:07,360 --> 00:12:08,040
مــاذا ؟

168
00:12:13,940 --> 00:12:16,970
والآنَ كمــا وعــدتُكـم ... هــا قــد وصلــنا إلى الــذُروة

169
00:12:17,140 --> 00:12:18,200
إلى جميــع الوحــدات

170
00:12:19,040 --> 00:12:22,150
أغلقــوا الدائــرةَ عليهــم ... وهاجمـوهـم بالقــوةِ الكاملــة

171
00:12:27,430 --> 00:12:28,190
... ســارة

172
00:12:28,190 --> 00:12:29,240
... إنــني آســف

173
00:12:29,240 --> 00:12:31,870
لكــن ليــست لـدينا الطـاقــةُ الكافيــةُ لكـي نوقفــهم

174
00:12:31,870 --> 00:12:33,650
أخبــرني ألا تُشــاهـدُ أيــةَ أفــلام ؟

175
00:12:33,960 --> 00:12:34,870
مـا الذي تعنيــنه ؟

176
00:12:34,870 --> 00:12:35,940
أفــلامُ  الغـــرب

177
00:12:36,440 --> 00:12:38,590
... عنـدمـا يُحــاطُ الأبطــالُ بالمخـاطــر

178
00:12:38,950 --> 00:12:39,890
ومــا الذي يحــدُث ؟

179
00:12:40,120 --> 00:12:41,140
... في الوقــتِ المُـحدد

180
00:12:41,140 --> 00:12:43,860
يصــلُ ســلاحُ الفـرســان إليهـم ... وتكـونُ نهايــةً سعيــدة

181
00:12:44,190 --> 00:12:45,510
دعيــنا نــبذُل أقصــى ما لــدينا

182
00:12:45,990 --> 00:12:47,580
لــن أطلُــبَ أكثــرَ مـن هــذا

183
00:12:48,000 --> 00:12:49,610
نحــنُ بإنتظــارك .. يـا ســلاحَ الفـرسـان

184
00:12:52,860 --> 00:12:56,210
مـن المُفــترضِ بأن يكـونــوا بانتظـارنـا في هـذا المكــان

185
00:12:56,450 --> 00:12:58,700
! أووه ! أحـدُهـم هنــاك يمتطــي حصــانًــا

186
00:13:00,710 --> 00:13:01,800
! أُنظــر جيــدًا

187
00:13:02,130 --> 00:13:03,820
! إنــه ريــو ! إنــه ريــو بدونِ شــك

188
00:13:06,100 --> 00:13:07,100
! لقــد تأخـــر

189
00:13:07,520 --> 00:13:10,800
! كــانَ من الجنــونِ أن يــذهبَ إلى هنــاكَ على ظهــرِ حصـانٍ بــري

190
00:13:13,320 --> 00:13:14,710
هــل أتخيـــل ؟

191
00:13:14,710 --> 00:13:17,020
! لا .. هـذا  خــطأ .. إنهــم قادمــونَ إلى هنــا

192
00:13:17,600 --> 00:13:19,830
! يــا إلهــي .. لا فائـدة ... لا أريــدُ أن أمــوت

193
00:13:20,860 --> 00:13:23,700
لكـن .. صحيـح ..إنهـا تلكَ العقليــةُ المشـلولــةٌ

194
00:13:24,240 --> 00:13:26,440
! أرجــوكَ ان تُســرعَ يا ريــو

195
00:13:28,440 --> 00:13:30,200
لــن تكــونَ العــودةُ سهــلةً إلى هنــاك

196
00:13:30,490 --> 00:13:32,650
ســوف يلحظــونكَ لأنـكَ تحمــلُ مــتاعًــا هـذه المــرة

197
00:13:32,960 --> 00:13:36,710
رُبمــا ... لكنهــم هنــاكَ يعتمــدونَ علي

198
00:13:39,840 --> 00:13:41,500
توقــعتُ بــأن تقــولَ هــذا

199
00:13:43,740 --> 00:13:45,230
لنكــن صــادقيــن

200
00:13:45,780 --> 00:13:49,700
الأبطـالُ التـاريخيـونَ كـانـوا غالـبًـا ... مجـردَ متبـاهيــنَ أو مُخفقيــن

201
00:13:50,250 --> 00:13:53,850
لكــنَ الرجــالَ الشُجعــانَ هــم الذيــنَ كـانــوا وراءَ هــؤلاءِ المخفقيــن

202
00:13:54,290 --> 00:13:58,910
إن فــريــقَ النقــلِ شـاهــدَ بمـا فيــه الكفـايــةَ ليحكُـمَ بهــذا

203
00:13:59,070 --> 00:13:59,980
! جيــرال

204
00:14:00,500 --> 00:14:03,140
إنـنــي أُخبــركَ بهـذا .. لأنـنـي أحتــرمُـــك

205
00:14:04,090 --> 00:14:05,510
لا تُهــدر حيــاتك

206
00:14:05,750 --> 00:14:08,180
فبقيــةُ فــريقــكَ يعتمــدُ عليــك

207
00:14:08,180 --> 00:14:09,270
ســأفعــلُ مـا عليَ فعلـه

208
00:14:09,450 --> 00:14:11,790
كــلُ مـاعلـيَ هـو إيصــالُ الوقــودِ إليــهم

209
00:14:15,670 --> 00:14:18,010
كـانَ ذلكَ فـظًــا جــدًا .. كــابتن جيــرال

210
00:14:18,630 --> 00:14:20,430
أخبــرني هــل قــدمـاكَ قــويتــان ؟

211
00:14:20,720 --> 00:14:23,420
! لا تسخــر مـني رجــاءًا ! لازلــتُ في مقتبــلِ العُمــر

212
00:14:23,420 --> 00:14:25,380
حســنًـا ... هــذا شــئٌ جيــد

213
00:14:25,640 --> 00:14:29,260
فأقـربُ بلــدةٍ تبعُــدُ عـن هنــا 150 كيلـومتــرٍ بإتجـاه الغــرب إن لـم أكـن مُخطـأً

214
00:14:29,760 --> 00:14:31,060
عــمَ تتحــدث ؟

215
00:14:31,830 --> 00:14:34,290
مـا إن تصــلَ إلى هنـاك فستصبــحُ القـائــدَ الجـديدَ لفـريــقِ النقــل

216
00:14:35,880 --> 00:14:37,630
... مــاذا ؟؟ أنــا

217
00:14:42,700 --> 00:14:44,800
! أيهــا القائــد ! ســوفَ آتـي معــك

218
00:14:44,950 --> 00:14:45,860
! أيهــا الغــبي

219
00:14:46,430 --> 00:14:48,480
! إن المقـاومـةَ ليســت لديهـا ميــزانيــةٌ كبيــرة

220
00:14:48,480 --> 00:14:51,310
! ولا يستطيـعونَ تحمُــلَ مـيـداليـتانِ شــرفيـتان

221
00:14:51,480 --> 00:14:52,920
! كــابتــن جيــرال

222
00:14:59,720 --> 00:15:00,960
كُــن حــذرًا

223
00:15:01,140 --> 00:15:03,390
عـليَ أن أُخــرجَ الأولادَ مــن أيـةِ مشــاكـل

224
00:15:25,620 --> 00:15:27,550
! حــانَ وقــتُ إختبـارِ مــدى حظــي

225
00:15:32,480 --> 00:15:35,300
! كــابــتن ! أنــتَ الـذي يُلقــي بحيــاتهِ هبــاءًا

226
00:15:40,430 --> 00:15:42,610
! حســنًـا .. تعـالـوا وحـاولـوا أن تنـالــوا مـني

227
00:15:42,730 --> 00:15:44,780
! إنهــا فُـرصــتي الوحيـدةُ للتبـاهــي

228
00:15:45,460 --> 00:15:47,000
شــاهـدوا مــا ســأفعــله أيهــا الأولاد

229
00:15:47,260 --> 00:15:50,900
لـم تســنح لي الفرصــةُ للـذهـابِ إلى أيـةِ أكـاديميــة

230
00:15:51,260 --> 00:15:55,880
ونحــنُ كُــنا من النـوعِ الـذي ... تـم حصــرهُ في القيـامِ بالأعمـالِ المسـانــدةِ فـقــط

231
00:15:57,070 --> 00:16:01,740
! وهـا قـد حـانت فرصــتي ... لطـالمـا أردتُ القيــامَ بالعمــلِ البطــولي

232
00:16:56,150 --> 00:16:58,190
! كــابـــتن جيــــرال

233
00:17:08,050 --> 00:17:11,030
ألــم يــأتـي ســلاحُ الفرســانِ بعــد ؟

234
00:17:13,660 --> 00:17:15,540
! هــذا كثيــرٌ مقارنــةً بالأفــلام

235
00:17:26,630 --> 00:17:28,480
! شينــوبــو .. ســـارة .. أمسكـــا

236
00:17:29,600 --> 00:17:31,620
! إيــاكُـمـا أن تُهــدرا أيــةَ قطــرةٍ منهــا

237
00:17:32,300 --> 00:17:33,870
! لا تخبـــرني بمــا أعــرفــه

238
00:17:33,900 --> 00:17:34,730
! أُصمـــت

239
00:17:35,320 --> 00:17:39,800
! الكـابــتن  جيــرال مـاتَ مـن أجلــها ! لقـد ضحـى بحيـاتهِ لـيُـنقــذنا

240
00:17:42,830 --> 00:17:45,980
! لقــد زادو مـن غضــبي ! حــانَ وقــتُهـم لكي يمـوتــوا

241
00:17:46,450 --> 00:17:48,490
! إنسحبــوا ! شكلــوا دائــرتكـم

242
00:18:14,070 --> 00:18:17,330
! هـاجمــوهـم ... إنــهم يحاولــونَ إستعمـالَ نفــسِ التكتيــك

243
00:18:20,640 --> 00:18:23,080
! تلكَ الخـدعــة ! لـن تنطـليَ عليــنا ثانيــةً

244
00:18:23,080 --> 00:18:27,810
! إمنحـــني القــوة .... إمنحــها لي مــرةً أُخــرى

245
00:18:31,740 --> 00:18:33,340
! لا تقــم بهـذا ثانيــةً شيــنوبـو

246
00:18:37,140 --> 00:18:39,000
! إنهــا هــي !  لقــد جــاءت

247
00:18:39,480 --> 00:18:40,830
! فقــدتُ سيطــرتي ثانيـــة

248
00:18:41,420 --> 00:18:42,820
! شينــوبـــو .... تــوقـــف

249
00:18:43,150 --> 00:18:45,860
يا رفــاق ... دعــوهُ يحــاول مــرة أخــرى

250
00:18:46,150 --> 00:18:49,680
ربُمــا هــنالكَ تكتيــكٌ جــديــدٌ قــد عثــرَ عليــه

251
00:18:50,570 --> 00:18:51,310
... ولكــن

252
00:18:51,520 --> 00:18:53,240
! دعــونـا نُعطيــهِ تلـكَ الفُــرصــة

253
00:18:53,620 --> 00:18:55,780
لقــد كــانت أمنيــةَ الكـابـتن جيــرال قبــلَ وفـاتــه

254
00:18:55,940 --> 00:18:56,880
فهِمـــت

255
00:19:02,470 --> 00:19:04,930
تخطـــى مــا بعــدَ غضـــبِ الوحـــش وتخطـى البشـــر

256
00:19:05,020 --> 00:19:06,910
وإنبعــث الآنَ كمُحــاربٍ إلهـــي

257
00:19:07,030 --> 00:19:08,900
تحــول إلى الآلــةِ القُصــوى

258
00:19:09,010 --> 00:19:11,410
الوحــشُ الآليُ الخــارق ... دانكــوجـــار

259
00:19:12,810 --> 00:19:13,990
! دانكوجــار ؟

260
00:19:39,200 --> 00:19:41,280
! الآن ... هاجمــوهــم

261
00:19:47,440 --> 00:19:50,880
! يالـتلكَ الطـاقــةِ العظيمــة ! تستطيــعُ عكـسَ الأشعــة

262
00:19:57,710 --> 00:19:59,160
أوووه ! مــا هــذا ؟

263
00:20:31,140 --> 00:20:32,740
! إبتعــد عــنه ديــث جــايــا

264
00:20:33,030 --> 00:20:34,930
! لــم ينتهــي هجــومـي عليــهِ بعــد

265
00:20:34,990 --> 00:20:36,410
! أُصمـــت أيهــا الأرضــي

266
00:20:36,410 --> 00:20:39,070
! لقــد تعبـتُ مـن ألاعيــبِـكَ وتكتيكـاتِـكَ السخيــفة

267
00:20:39,480 --> 00:20:41,910
! والآنَ جــاءَ دوري لأريــكَ كيــفَ يكــونُ القــتال

268
00:20:58,050 --> 00:20:58,960
... وأخيــرًا

269
