25
00:03:12,660 --> 00:03:16,010
وقــواتُ دفــاعِ الأرض ... تلقــت خســائـرَ هائلـــة

26
00:03:27,070 --> 00:03:28,160
جنـــرال ديــث جــايــا

27
00:03:28,430 --> 00:03:31,020
الكوكــبُ الثـالــثُ لازالَ يقــومُ بالإرســالِ إليــنا

28
00:03:31,020 --> 00:03:34,220
تجــاهلـهُــم ... ســوفَ نُسقطُــهُـم عمـا قــريب

29
00:03:41,270 --> 00:03:42,940
! إيـاكُــم وأن تعبــروا مــدارَ القمـــر

30
00:03:43,390 --> 00:03:47,670
! أوقِفــوا تقــدُمكــم ... وإلا سـوفَ تُبـاشــرُ المـركبــاتُ بالهُجــوم

31
00:05:14,940 --> 00:05:18,440
كــانَ الغُــزاةُ  يُعـرفــونَ بإمبــراطـوريــةِ ميــوجِ زوربـادوس

32
00:05:18,440 --> 00:05:20,920
وكــانَ مطلبُهـم هــو إستسـلامُ الأرضِ بـدونِ شُــروط

33
00:05:25,770 --> 00:05:27,680
... إن لـم تكُـن ظهــرت تلكَ الوحــوشُ اللعينــة

34
00:05:28,250 --> 00:05:30,410
! لمـا كـانت هُـنالكَ مشـاكـلٌ في أن أنتصـــر

35
00:05:32,210 --> 00:05:36,280
مـن بيــنِ الآخـريـن . كـانَ ديــث جــايا يُشيــرُ إلى فـوجيــوارا شيــنوبــو

36
00:05:36,610 --> 00:05:40,790
غـريــزتـهُ القتـاليــةُ المُـذهلــة .. أدهــشتِ الجنــرالَ إيجـــور

37
00:05:40,790 --> 00:05:43,640
لــذلكَ قــامَ بتعيـيــنهِ ضمــن فــريــقِ قــوةِ الوحــوشِ المُحـاربــة

38
00:05:44,190 --> 00:05:45,260
مـا ... مــاذا ؟

39
00:05:47,630 --> 00:05:49,560
! تشيــه ! لــن تتحمــلَ أكثَــر مــن هــذا

40
00:06:38,470 --> 00:06:40,530
! اللعنــــة

41
00:06:41,210 --> 00:06:42,530
! لــن أُسـامحَـــك

42
00:06:42,950 --> 00:06:47,250
قــامَ البروفيسـور هازوكـي من " ق.و.م " بإعطـاءِ النسـر .. قُـدرةً ســريـة

43
00:06:47,250 --> 00:06:48,690
في حــالـةِ الأزمــات

44
00:06:49,400 --> 00:06:53,050
... يقــومُ غضــبُ شينـوبــو ... بتحفيــزِ نـوعٍ مــن التحــولِ

45
00:06:53,220 --> 00:07:00,700
وتلكَ الطـاقـة الصـادرة .. تقـومُ بتشغيــلِ وإيقـاظِ مـركـزِ الغـريـزةِ الوحشـي الإلكتـروني داخـلَ الوحـشِ النســر

46
00:07:00,920 --> 00:07:02,230
Yatte yaru ze

47
00:07:00,920 --> 00:07:02,230
! لأقـــم بهـــا

48
00:07:43,600 --> 00:07:48,970
ذلكَ التحــول ... يستنـزفُ الطـاقــةَ مـن الطيــار

49
00:08:10,790 --> 00:08:14,040
مُـديــرُ " ق.و.م " ... الجنــرال روس إيجــور

50
00:08:14,310 --> 00:08:18,370
ونـائبــهُ ... خبيــرُ التكنـولـوجيـا الحيـويـة ... البروفيســور هـازوكـي

51
00:08:18,690 --> 00:08:21,160
هُمـا الإثنــانِ ... مـن إختــرعـا الوحــوشَ المُحـاربــة

52
00:08:21,160 --> 00:08:26,070
أمــلُ الأرضِ الأخيــر للقـتال ... ضــدَ الغُــزاةِ الأعـداءِ عـديمي الرحمــة

53
00:08:27,050 --> 00:08:29,690
... إنهـا المـرةُ الأولى التي تقــودُ فيهـا مـركبــةَ الفهـد

54
00:08:29,890 --> 00:08:31,440
ومـع ذلكَ تـتصـرفـانِ كشخـصٍ واحـد

55
00:08:31,440 --> 00:08:34,850
! لا .. بـل يبــدو بـأنَ المـركبـةَ يتِــمُ قيـادتُهـا من قبــلِ أنثـى الفهــد

56
00:08:58,680 --> 00:09:02,440
تستطيـعُ ســارة أن تُحــولَ مركبتهــا إلى الفهــدِ الأرضــي

57
00:09:02,440 --> 00:09:06,800
وذلك عـن طــريقِ تحفيــزِ مـركـزِ الغـريـزةِ الآلـي للوحــشِ المُحــارب

58
00:10:03,930 --> 00:10:06,350
مـابيــنَ حُبهــا للخـائــنِ شــابيــرو

59
00:10:06,640 --> 00:10:09,840
ومـابيــنَ كُـرهِهـا للعــدو .. كــانت مُمـزقــةً بيــنَ الشعــوريـن

60
00:10:10,420 --> 00:10:14,080
إنهـا العضــوةُ الأُنثـى الوحيـدة في فـريــقِ " ق.و.م " .. ســارة يــوكـي

61
00:10:41,450 --> 00:10:44,040
العضــوُ الثـالــثُ في الفـريــق هـو .. شيكيبــو  مـاسـاتـو

62
00:10:44,410 --> 00:10:49,050
قـد يظهـرُ بـأنهُ بــدونِ همـوم ... لكـنه يمتلـكُ الشجـاعـةَ والوحشيــةَ عنــدَ القـتال

63
00:10:50,690 --> 00:10:53,660
لنــرى ... سيكــونُ من السـئِ لـو أصبـتُ الكـاميــرا

64
00:10:54,290 --> 00:10:55,710
حســنًـا رُبمـا هـا هــنا

65
00:11:07,100 --> 00:11:08,180
! هــذا أنــت

66
00:11:20,120 --> 00:11:23,730
عنـدمـا يحفــزُ ماسـاتـو عمليـةَ التغيـيـر في القتـالِ العنيــف

67
00:11:23,730 --> 00:11:27,500
يقــومُ ذلكَ  بتحفيـزِ وإيقـاظِ المـركـزِ الغـريـزيِ الآلـيِ للوحـشِ المُحـارب

68
00:11:27,700 --> 00:11:29,870
محــولاً دبابتـهُ إلى الوحـشِ المُحـارب .. الأســدُ الأرضـي

69
00:11:59,290 --> 00:12:01,590
... وأيــضًـا ... وأخيــرًا الرجــلُ الأخيــر

70
00:12:03,010 --> 00:12:03,990
! ..... أنــتَ

71
00:12:03,990 --> 00:12:08,700
شيبــا ريـو ... الرجــلُ الخبيــرُ في فنــونِ القتــال

72
00:12:08,840 --> 00:12:10,600
مضــى وقــتٌ طـويــل ... يا رِفــاق

73
00:12:10,600 --> 00:12:11,340
ريــو ؟

74
00:12:11,490 --> 00:12:12,690
! إنـــهُ ريـــو

75
00:12:13,830 --> 00:12:14,800
! ريـــو

76
00:12:15,150 --> 00:12:16,460
مـنذُ مــتى وأنـت َ.... ؟

77
00:12:16,460 --> 00:12:18,630
لقــد ركبــتُ الطـائــرةَ معكُــم

78
00:12:18,890 --> 00:12:21,170
هيــه !!!  أأنــتَ شبــحٌ أم مــاذا ؟

79
00:12:21,170 --> 00:12:24,830
إعتقدت أنك كنـتَ لـتتـنزهَ فـي هـذه الأيـام

80
00:12:24,960 --> 00:12:28,200
هـاه ! لم تتعلم فن الترحيب المهذب حتى الآن

81
00:12:28,550 --> 00:12:29,170
! تشيــه

82
00:12:30,030 --> 00:12:32,890
وأنـتَ لازلـتَ تتحـدثُ بقلـةِ إحتـرامٍ حتى الآن

83
00:12:33,700 --> 00:12:38,030
ألـم تـذهـب في رحلـةِ سفـرٍ تـدريبيـةٍ مـن بعــدِ تخُــرجــك ؟

84
00:12:38,310 --> 00:12:42,260
نعــم .... كان ذلك إلى أن تحـدثَ معـي الجنرال إيجور

85
00:12:42,610 --> 00:12:44,520
! إذن ! فـأنــتَ العضـوُ الرابــعُ مـعنا

86
00:12:44,520 --> 00:12:47,330
.. لـهـذا عندما علمـتُ بـذهابِــكُـم إلى مديــنةِ كـنساس

87
00:12:47,550 --> 00:12:50,540
ذهبـتُ إلى هناك حتـى أنـتظِـركُــم

88
00:13:43,360 --> 00:13:44,710
! إبتعـــدوا عـن طــريقـــي

89
00:14:36,830 --> 00:14:38,750
... بعــد هــزيمـتي المُــذلــة

90
00:14:39,300 --> 00:14:41,590
فـأنـا مستعــدٌ لتقبــلِ عقــوبتي

91
00:14:41,660 --> 00:14:43,660
لــن يكــونَ هــذا ضــروريًــا

92
00:14:45,230 --> 00:14:48,220
إذا خســرتَ فليكـن مـا كـــان

93
00:14:48,220 --> 00:14:55,340
فـأنت الجنــرال ديــث جـايـا .. الـذي لـهُ إحتـرامُـهُ ورهبتــهُ عبــرَ الإمبـراطـوريـةِ كُلهــا

94
00:14:55,340 --> 00:14:57,080
! نعــم ... فخــورٌ بهــذا الكـلام

95
00:14:57,080 --> 00:15:01,570
في بـدايتنـا معًــا نحـنُ الإثنـان ... قاتلـنا معًـا جنبـًـا إلى جنــب

96
00:15:01,940 --> 00:15:03,960
أتـذكُــرُ معـركـةَ قطــاعِ ميلـدو ؟

97
00:15:04,190 --> 00:15:08,070
هـزمـتَ أعـداءَك في دوديــوم ... يا ديــث جــايــا

98
00:15:08,070 --> 00:15:10,890
! لـقـد كُـنتَ وقتَهـا لا تُهــزم

99
00:15:11,390 --> 00:15:15,980
وكـانت إنتصـاراتُـكَ ســببًـا في إنشــاءِ الإمبـراطــوريـة

100
00:15:15,980 --> 00:15:19,500
ولـهـذا لـن ننسـى تلكَ الإنتصــارات

101
00:15:19,570 --> 00:15:20,340
... لكــن

102
00:15:20,590 --> 00:15:25,470
أيُ عــدوٍ وحشــيٍ تمكــنَ مـن إسـقـاطِــكَ بضـربــةٍ واحــدة ؟

103
00:15:28,910 --> 00:15:31,470
تخطـــى مــا بعــدَ غضـــبِ الوحـــش وتخطـى البشـــر

104
00:15:31,470 --> 00:15:33,440
وإنبعــث الآنَ كمُحــاربٍ إلهـــي

105
00:15:33,440 --> 00:15:35,560
تحــول إلى الآلــةِ القُصــوى

106
00:15:35,560 --> 00:15:38,000
الوحــشُ الآليُ الخــارق ... دانكــوجـــار

107
00:15:38,320 --> 00:15:39,170
دانكــوجــار ؟

108
00:16:04,680 --> 00:16:06,600
! الآن ... هاجمــوهــم

109
00:16:13,080 --> 00:16:16,450
! يالـتلكَ الطـاقــةِ العظيمــة ! تستطيــعُ عكـسَ الأشعــة

110
00:16:23,460 --> 00:16:24,810
أوووه ! مــا هــذا ؟

111
00:16:46,180 --> 00:16:47,670
! إبتعــد عــنه ديــث جــايــا

112
00:16:47,950 --> 00:16:49,860
! لــم ينتهــي هجــومـي عليــهِ بعــد

113
00:16:49,860 --> 00:16:51,240
! أُصمـــت أيهــا الأرضــي

114
00:16:51,390 --> 00:16:53,780
! لقــد تعبـتُ مـن ألاعيــبِـكَ وتكتيكـاتِـكَ السخيــفة

115
00:16:54,020 --> 00:16:56,730
! والآنَ جــاءَ دوري لأريــكَ كيــفَ يكــونُ القــتال

116
00:17:12,840 --> 00:17:13,730
... وأخيــرًا

117
00:17:14,010 --> 00:17:18,020
! وجــدتُ خصــمًــا هنـا يستحــقُ أن أُريــهُ مـا لــدي مـن إمكـانيـات

118
00:17:27,100 --> 00:17:28,500
! أيهـــا اللعيــــن

119
00:17:44,510 --> 00:17:45,750
! م ... مسـتحيــل

120
00:17:45,900 --> 00:17:48,770
! لا يُمكــنُ أن أُهــزم مـن هــذا الكوكــبِ المـائي

121
00:17:58,850 --> 00:18:00,540
لقـد خَــدمتَـنا جيــدًا

122
00:18:00,740 --> 00:18:03,820
ويـومًـا مـا ســوفَ تخـدِمُـنا قــوتُـكَ ثانيــةً

123
00:18:03,820 --> 00:18:05,950
وحـتى ذلكَ الحيـنِ عليــكَ أن تستــريحَ قليــلاً

124
00:18:06,800 --> 00:18:07,550
! مفهـــوم

125
00:18:09,050 --> 00:18:13,230
أقسِــمُ يـومًـا مـا .. ســوفَ أعــودُ إلى كـوكــبِ الأرضِ ذاك

126
00:18:13,410 --> 00:18:17,820
ومـن ثُــمَ ..ســوفَ  أقـاتــلُ و أسحــقُ تلكَ الوحـوشَ اللعينــة

127
00:18:18,120 --> 00:18:19,050
ومـن بعِـد ذلك

128
00:18:19,340 --> 00:18:22,490
سـأسحــقُ كُــلاً مـن شابيــرو ... ولــونــا

129
00:18:22,490 --> 00:18:24,580
! إنتظــروا ... ذلـكَ اليـــوم

130
00:18:30,490 --> 00:18:32,040
وفي تلكَ الأثنـاءِ .. على كـوكــبِ الأرض

131
00:18:32,260 --> 00:18:34,140
كـانت تُعقــدُ جنــازةٌ بالقــربِ مـن شــتوتجـارد

132
00:18:34,230 --> 00:18:39,990
للقائـدِ جيــرال الـذي تُـــوفـيَ في  القتــالِ ضــد ديــث جــايــا

133
00:18:51,280 --> 00:18:52,640
كُــن حــذرًا

134
00:18:52,830 --> 00:18:55,370
عـليَ أن أُخــرجَ الأولادَ مــن أيـةِ مشــاكـل

135
00:19:03,070 --> 00:19:06,630
! كــابــتن ! أنــتَ الـذي يُلقــي بحيــاتهِ هبــاءًا

136
00:19:11,560 --> 00:19:13,610
! حســنًـا .. تعـالـوا وحـاولـوا أن تنـالــوا مـني

137
00:19:13,880 --> 00:19:15,950
! إنهــا فُـرصــتي الوحيـدةُ للتبـاهــي

138
00:19:16,320 --> 00:19:18,120
شــاهـدوا مــا ســأفعــله أيهــا الأولاد

139
00:19:18,270 --> 00:19:22,140
لـم تســنح لي الفرصــةُ للـذهـابِ إلى أيـةِ أكـاديميــة

140
00:19:22,590 --> 00:19:26,900
ونحــنُ كُــنا من النـوعِ الـذي ... تـم حصــرهُ في القيـامِ بالأعمـالِ المسـانــدةِ فـقــط

141
00:19:27,440 --> 00:19:31,960
! وهـا قـد حـانت فرصــتي ... لطـالمـا أردتُ القيــامَ بالعمــلِ البطــولي

142
00:20:39,040 --> 00:20:41,790
ومـن ثُـم ... لفتــرةٍ كـانت  هُـنالكَ راحــةٌ من القــتال

143
00:20:42,870 --> 00:20:46,750
و" ق.و.م " حصـلت على بعــضِ الأيــامِ من السـلامِ لتعيـشَ فيهـا

144
00:20:49,220 --> 00:20:54,630
فجـــاة إلتقـــت عيــونُـنــا

145
00:20:55,650 --> 00:21:00,820
وكُـــنتَ غــريبًـــا

146
00:21:03,180 --> 00:21:09,940
سمعــتُ صــوتَـك مختلفًــا عــن ذلكَ اليـــوم

147
00:21:10,880 --> 00:21:16,530
ولـم أستطــعِ الإستجـابــةَ لكَ مــرةً  أُخــرى

148
00:21:18,550 --> 00:21:23,860
وكـأنني مجـروحــةٌ بـذكريــاتٍ سيــئة

149
00:21:26,250 --> 00:21:31,870
وبــدونِ تفكيــر .. قــررتُ أن أستــرخـي

150
00:21:32,860 --> 00:21:36,280
تنــاغم ، وحــب

151
00:21:36,280 --> 00:21:39,640
محبـوســةٌ داخـلَ وحــدتي

152
00:21:46,120 --> 00:21:49,840
أنـا لســتُ مغفــلاً مثلمــا كــانَ ديــث جــايــا

153
00:21:49,840 --> 00:21:52,080
... قلــبُ الإنســانِ شــئٌ ضعيـف

154
00:21:52,290 --> 00:21:54,980
! وبإمكــانيَ التحكُــمَ في ذلكَ القلـــب

155
00:21:55,430 --> 00:21:58,770
حـتى تلكَ الـوحــوشُ تحمــلُ قلــبًـا مُحــبًـا بـداخِلِهــا

156
00:21:59,420 --> 00:22:00,660
... لـكنني ســوفَ

157
00:22:00,660 --> 00:22:03,750
أُعلِمُهــا ... كيــفَ يكــونُ الخــوفُ واليــأس

158
00:22:04,340 --> 00:22:06,480
! إنتظــروا  وستـــرون

159
00:23:29,320 --> 00:23:31,280
الحلقة القادمة من دانكوجار

160
00:23:31,760 --> 00:23:33,250
مملكــةُ الإغــواءِ الإلهـي

161
00:23:33,720 --> 00:23:34,840
Yatte yaru ze