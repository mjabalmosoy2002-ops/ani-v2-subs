1
00:00:00,580 --> 00:00:04,190
هل أخبرتِ جدّتكِ بالحقيقة عنّا؟

2
00:00:04,980 --> 00:00:06,400
.لم أستطع

3
00:00:06,400 --> 00:00:09,320
حاولت، لكنّها قالت أنّها
.لا تمانع أيًّا كان الجواب

4
00:00:09,320 --> 00:00:14,120
.حين قالت ذلك... لم أستطع أن أُصارحها

5
00:00:14,890 --> 00:00:16,620
.لكنّي لست نادمة

6
00:00:17,250 --> 00:00:18,290
.حقًّا

7
00:00:19,610 --> 00:00:24,050
ساعدتني تلك الحيرة على التّمييز بين
،ما أفعله لأجلها، وما أفعله من أجلي

8
00:00:24,560 --> 00:00:26,450
.حتّى اللّحظة الأخيرة

9
00:00:26,450 --> 00:00:29,200
.وأنا ممتنّة لأنّك طرحت الأمر لي

10
00:00:31,960 --> 00:00:34,920
...لكن هذا أيضًا ما جعل المصارحة أصعب

11
00:00:36,390 --> 00:00:39,700
،لو أخبرنا الجدّة ناغومي بالحقيقة الآن

12
00:00:39,700 --> 00:00:45,370
فستكرهنا لأنّنا كذبنا على جدّتي
.حتّى أنفاسها الأخيرة

13
00:00:46,570 --> 00:00:49,220
.لن أسمح بحدوث ذلك

14
00:00:50,720 --> 00:00:53,950
!أقسم أنّي سأحميك من اللّوم

15
00:00:58,420 --> 00:00:59,760
كيف؟

16
00:02:34,770 --> 00:02:38,260
.كانت سايوري-سان تؤمن بك بشدّة

17
00:02:38,870 --> 00:02:43,440
آمنت بأنّ حفيدتها العزيزة
.قد عرّفتها لأوّل مرّة على حبيبها

18
00:02:43,440 --> 00:02:47,760
وبلا شكّ أيضًا أنّها آمنت بذلك
.حتّى آخر أنفاسها

19
00:02:49,530 --> 00:02:52,070
،إن كان ما قالته مامي-دونو صحيحًا

20
00:02:52,070 --> 00:02:56,200
فسأتغاضى عن كلّ شيء إلاّ حقيقة
.أنّكما كذبتما على صديقتي الرّاحلة

21
00:03:03,120 --> 00:03:06,080
.أتمنّى حقًّا أن يكون الأمر مجرّد سوء فهم

22
00:03:06,420 --> 00:03:08,950
هل لديك أيّ تفسير مقنع؟

23
00:03:09,930 --> 00:03:16,280
!لا يوجد ما يمكننا قوله
!لقد كذبنا بالفعل

24
00:03:17,150 --> 00:03:21,470
!كلاّ! كانت ميزوهارا متردّدة وتتألّم

25
00:03:21,470 --> 00:03:24,850
!لقد فاتتها الفرصة لقول الحقيقة فحسب

26
00:03:25,750 --> 00:03:30,740
لكنّ هذا لا يغيّر شيئًا
،بعد أن واصلنا الكذب لسنة ونصف

27
00:03:30,740 --> 00:03:32,130
.ستبدو أعذارًا لا غير

28
00:03:33,310 --> 00:03:35,180
!هذا غير عادل

29
00:03:35,180 --> 00:03:40,030
فسايوري-سان لم تعد موجودة
.لتدافع عنها

30
00:03:40,830 --> 00:03:43,920
.لم يعد بإمكاننا فعل أيّ شيء الآن

31
00:04:09,750 --> 00:04:10,940
.هكذا إذًا

32
00:04:12,190 --> 00:04:13,680
.هذا يكفي

33
00:04:15,470 --> 00:04:16,350
.يكفي

34
00:04:20,170 --> 00:04:22,210
.أنا متعبة الآن

35
00:04:35,480 --> 00:04:37,570
...لا

36
00:04:37,880 --> 00:04:39,920
...أنتم جميعًا مخطئون

37
00:04:46,750 --> 00:04:51,510
إن كان على أحد اختيار أسوأ
،اعتراف بالحبّ في تاريخ البشريّة

38
00:04:51,510 --> 00:04:53,230
.فلا شكّ أنّها ستكون هذه اللّحظة

39
00:04:54,470 --> 00:05:00,280
وقبل أن أدرك، هرب تدفّق
.المشاعر ذاك من بين شفتينّ

40
00:05:01,080 --> 00:05:06,800
كان الأمر أشبه بالاندفاع لقتال
.مدافع بعصا خشبيّة لا غير

41
00:05:07,780 --> 00:05:10,800
.ميزوهارا ليست من هذا النّوع من الفتيات

42
00:05:12,140 --> 00:05:14,930
...مخطئون، أنتم مخطئون

43
00:05:15,920 --> 00:05:18,500
...جدّتي... وأنتم جميعًا

44
00:05:19,800 --> 00:05:24,050
،كانت مقاومةً يائسة لا غير
.مجرّدة من أيّ قدر من الرّوعة

45
00:05:24,800 --> 00:05:28,080
وهكذا بدأت كذبة هذا الفارس الأبيض
.المثير للشّفقة بالانكشاف

46
00:05:28,660 --> 00:05:32,520
.لأنّنا... على علاقة ببعضنا بالفعل

47
00:05:33,800 --> 00:05:35,980
،لا تعرف مامي-تشان بالأمر

48
00:05:36,320 --> 00:05:39,690
لكن قبل أسبوع تقريبًا
،من وفاة الجدّة سايوري

49
00:05:40,230 --> 00:05:41,960
.بدأنا نتواعد حقًّا

50
00:05:43,530 --> 00:05:47,020
.وهكذا لم يكن لتشيزورو أيّ سبب لإخبارها

51
00:05:47,480 --> 00:05:52,840
لذلك كان من الغريب أن نقول لها فجأة أنّ ما
.كان بيننا حتّى وقت قريب كان مجرّد كذبة

52
00:05:53,830 --> 00:05:58,300
لذلك إن نظرنا للصّورة الأكبر، فإنّ
.تشيزورو لم تكذب على سايوري-سان

53
00:05:58,660 --> 00:05:59,520
أليس كذلك؟

54
00:06:09,470 --> 00:06:11,980
هل فكّرت في الأمر مليًّا؟

55
00:06:13,190 --> 00:06:16,010
.آمل أنّك تدرك ما الّذي تحاول فعله

56
00:06:18,260 --> 00:06:21,170
.اكذب الآن، وسيكون أمرك قد انتهى

57
00:06:21,830 --> 00:06:22,880
!للأبد

58
00:06:24,730 --> 00:06:27,660
!أنا آسف... آسف يا كيبي

59
00:06:28,400 --> 00:06:29,620
.أتفهّم كلّ هذا

60
00:06:30,160 --> 00:06:33,120
!رأيتُ كم تهتمّ لأمري

61
00:06:33,550 --> 00:06:35,320
!أوضحتَ ذلك وضوح الشّمس

62
00:06:36,940 --> 00:06:41,550
.سبق وقلت أنّ ميزوهارا ليست من هذا النّوع

63
00:06:42,070 --> 00:06:44,950
!لكنّي لا أستطيع! لا أستطيع فحسب

64
00:06:42,760 --> 00:06:45,180
قامت بخداعكم جميعًا؟

65
00:06:45,750 --> 00:06:47,430
.هذا غير معقول بتاتًا

66
00:06:48,990 --> 00:06:53,230
!تعلم أنّه لم يكن باستطاعتي فعل أيّ شيء آخر

67
00:06:49,240 --> 00:06:52,620
.إنّها فتاة طيّبة جدًّا

68
00:06:54,180 --> 00:06:58,070
إنّها صادقة دائمًا
.وتعيش حياتها مرفوعة الرّأس

69
00:06:58,070 --> 00:07:00,360
،لا أهتمّ إن بدوتُ مثيرًا للشّفقة

70
00:07:00,360 --> 00:07:03,070
.أو إن ظننتم جميعًا أنّي مجرّد حثالة

71
00:07:01,030 --> 00:07:05,250
.وأحبّت سايوري-سان من أعماق قلبها

72
00:07:06,030 --> 00:07:10,820
لا أستطيع أن أتحمّل أن يفكّر
!فيها أيّ أحد بشكل سيّئ

73
00:07:06,550 --> 00:07:10,480
.من الواضح أنّي كنت المخطئ في كلّ شيء

74
00:07:10,820 --> 00:07:12,490
!إنّه الشّيء الوحيد الّذي لا أستطيع تحمّله

75
00:07:15,890 --> 00:07:17,920
.إنّها فتاة طيّبة

76
00:07:19,040 --> 00:07:22,120
.احتفظتْ بكلّ هذا سرًّا من أجلي

77
00:07:23,030 --> 00:07:25,950
بإمكاني القول أنّنا انفصلنا
!عندما نعود إلى طوكيو

78
00:07:26,950 --> 00:07:28,780
إن كان على أيّ أحد
!أن يكذب، فسيكون أنا

79
00:07:28,780 --> 00:07:33,600
حتّى وبينما يحدث كلّ هذا، أشعر بأسف
.شديد لأنّي وضعتها في هذا الموقف

80
00:07:34,100 --> 00:07:35,790
...ستكرهنا

81
00:07:35,790 --> 00:07:38,200
!لقد أقسمتُ أنّي سأحميها من أيّ لوم

82
00:07:38,200 --> 00:07:41,000
!وسأقوم بما أقسمت به حتّى النّهاية

83
00:07:41,880 --> 00:07:44,540
...إنّها الأجمل

84
00:07:45,430 --> 00:07:48,600
.والألطف والأروع على الإطلاق دائمًا

85
00:07:50,430 --> 00:07:55,530
هذه هي ميزوهارا تشيزورو
!الّتي وقعتُ في حبّها

86
00:08:12,540 --> 00:08:13,850
.قبّلها إذًا

87
00:08:16,840 --> 00:08:18,980
.أثبت ذلك بتقبيلها

88
00:08:24,960 --> 00:08:25,960
ماذا؟

89
00:08:30,170 --> 00:08:31,570
.مرحبًا يا روكا

90
00:08:34,910 --> 00:08:38,750
كنتِ قد خرجتِ سلفًا؟
ألم يكن ذلك حماسيًّا؟

91
00:08:40,650 --> 00:08:44,210
!نعم، كان قلبي ينبض بسرعة
!كان ذلك رائعًا

92
00:08:44,210 --> 00:08:47,670
صحيح؟ حتّى أنّ يومي تسمّرت
.في مكانها في منتصف الجولة

93
00:08:47,670 --> 00:08:51,450
.وهل يمكن لومي؟ كنتُ مرعوبة

94
00:08:50,230 --> 00:08:54,510
قد تكون مبالغة إن قلتُ في كلّ
...يوم من أيّام السّنة الـ365

95
00:08:51,450 --> 00:08:53,410
.كان ذلك مخيفًا

96
00:08:55,140 --> 00:09:00,480
.لكنّي سأقول أنّي قضيت 364 يومًا بحثًا عنه

97
00:09:02,150 --> 00:09:03,270
،لا يهمّ متى أو أين

98
00:09:03,580 --> 00:09:05,980
.كان الأمر يحتلّ حيّزًا من تفكيري دائمًا

99
00:09:06,640 --> 00:09:11,800
لأنّي شعرتُ كأنّ الكون يخبرني
.أنّ فيّ خللاً ما

100
00:09:12,600 --> 00:09:16,620
وضعتُ أمنية واحدة فقط
...في مهرجان تاناباتا

101
00:09:17,110 --> 00:09:24,140
لذلك عندما وجدتك، بدوتَ كأنّك
.فارسٌ بطل جاء لإنقاذي بالفعل

102
00:09:21,790 --> 00:09:24,710
...قد تكون حبيبة مستأجرة، لكنّ ميزوهارا

103
00:09:25,100 --> 00:09:27,210
!هي أفضل حبيبة قد يتمنّاها أيّ أحد

104
00:09:33,100 --> 00:09:37,930
كنت أعتقد حقًّا أنّك ستكون الأمير
.الّذي سيضفي البهجة على حياتي

105
00:09:44,960 --> 00:09:47,770
.لكنّك كنت تحبّ فتاة أخرى

106
00:09:48,220 --> 00:09:51,400
،فتاة في غاية الجمال

107
00:09:51,870 --> 00:09:53,060
.وفي غاية النُّضج

108
00:09:54,050 --> 00:09:57,500
لم تكن هنالك ولو لحظة واحدة
.ظننتُ فيها أنّي متفوّقة عليها

109
00:09:58,120 --> 00:10:01,160
.لذلك السّبب أشعر بالقلق من وقت لآخر

110
00:10:01,520 --> 00:10:05,710
تهانينا على مرور 8 أشهر
!و10 أيّام على بداية علاقتنا

111
00:10:05,980 --> 00:10:07,750
أليست هذه دقّة مبالغ فيها؟

112
00:10:07,750 --> 00:10:10,280
اليوم أيضًا ذكرى مرور 250 يومًا
!على كوننا ثُنائيًّا

113
00:10:12,810 --> 00:10:16,430
مذاق الماريتوتزو لذيذ جدًّا
!عند أكله مع شخص عزيز

114
00:10:16,880 --> 00:10:18,110
.انظر لتلك الفتاة

115
00:10:18,110 --> 00:10:19,080
!إنّها ظريفة جدًّا

116
00:10:19,080 --> 00:10:20,850
!إنّها رشيقة وجميلة

117
00:10:20,850 --> 00:10:22,740
.بدأنا للتّوّ فحسب

118
00:10:22,740 --> 00:10:24,840
سنذهب اليوم إلى السّينما
،وحديقة الملاهي

119
00:10:24,840 --> 00:10:28,020
إضافة لأشياء أخرى عديدة
!كنتُ أتطلّع لها قُدمًا

120
00:10:28,440 --> 00:10:32,140
ولكن ما الّذي تنوي فعله؟

121
00:10:32,140 --> 00:10:32,860
ماذا؟

122
00:10:33,620 --> 00:10:39,160
لا يمكنك إخبار عائلتك أنّ حبيبةً
.مستأجرة هي شريكة حياتك للأبد

123
00:10:39,640 --> 00:10:43,330
تريد جدّتك أحفادًا، أليس كذلك؟

124
00:10:44,190 --> 00:10:49,960
،أفهم أنّك لا تريد أن تُحزنها
.لكن على الأمر أن ينتهي يومًا ما

125
00:10:50,220 --> 00:10:54,340
.لكنّي لا أقول هذا لأنّي شخص تنافسيّ

126
00:10:54,340 --> 00:10:56,340
.أنا قلقة عليكما فحسب

127
00:10:56,900 --> 00:10:58,740
.أعد أنّي سأقوم بالصّواب

128
00:10:58,740 --> 00:10:59,810
ماذا؟

129
00:10:59,810 --> 00:11:02,780
.من أجلك ومن أجل ميزوهارا

130
00:11:04,050 --> 00:11:07,440
سأجد طريقة لإنهاء الأمر
.بطريقة لا تُحزن أيّ أحد

131
00:11:11,470 --> 00:11:13,780
.من الأفضل أن تتّصل بجدّتك الآن إذًا

132
00:11:13,780 --> 00:11:15,580
ماذا؟ لماذا تقولين هذا فجأة؟

133
00:11:15,580 --> 00:11:17,030
ما الّذي تقوله؟

134
00:11:17,430 --> 00:11:20,570
لديك أظرف حبيبة في العالم
!إلى جانبك الآن

135
00:11:20,570 --> 00:11:23,470
.صحيح، لكنّ هذه مسألة مختلفة تمامًا

136
00:11:23,470 --> 00:11:26,600
كنت قلقة من أن تبقى الأمور
.على هذا الحال إلى الأبد

137
00:11:27,270 --> 00:11:30,880
.لأنّني فعلاً، فعلاً أحبّه

138
00:11:33,450 --> 00:11:35,470
.أثبت ذلك بتقبيلها

139
00:11:44,410 --> 00:11:46,820
ما-ماذا تقولين يا مامي-تشان؟

140
00:11:46,820 --> 00:11:48,810
نقبّل بعضنا؟ أمام الجميع؟

141
00:11:49,440 --> 00:11:53,780
.نحن في مكان عام أيضًا
.لا يمكننا تقبيل بعضنا بأيّ حال

142
00:11:50,390 --> 00:11:53,230
ما كلّ هذا؟ ماذا يحدث؟

143
00:11:54,050 --> 00:11:55,270
انكشف السّرّ؟

144
00:11:55,270 --> 00:12:00,220
جدّته وكلّ الآخرين يعلمون
.أنّ تشيزورو-سان حبيبة مستأجرة

145
00:12:00,220 --> 00:12:01,740
!وهي تطلب منهما التّقيبل؟

146
00:12:01,740 --> 00:12:04,240
.تعلم أنّهما لا يستطيعان فعل ذلك

147
00:12:04,690 --> 00:12:06,780
هل أوقعت هاتفها عن قصد؟

148
00:12:07,230 --> 00:12:10,210
.تحاول الجدّة ناغومي حسم الأمر أيضًا

149
00:12:10,900 --> 00:12:12,420
.هنا والآن

150
00:12:12,760 --> 00:12:15,960
.لكن، إن افترضنا أنّني وشيت
ماذا ستفعلين حينها؟

151
00:12:17,690 --> 00:12:21,200
ماذا أفعل الآن؟

152
00:12:24,180 --> 00:12:28,250
،الأمر واضح
!ليس عليّ القيام بأيّ شيء

153
00:12:28,250 --> 00:12:32,020
،ما دمتُ سأظلّ صامتة وأشاهد فقط
.فستنتهي علاقتهما المزيّفة

154
00:12:32,020 --> 00:12:35,360
ليس لديّ أيّ سبب يدعوني
!لمساعدة كازويا-كُن وتشيزورو-سان

155
00:12:35,970 --> 00:12:40,200
إنّه الشّخص الّذي كنتُ أبحث
!عنه طوال حياتي

156
00:12:41,030 --> 00:12:43,700
!أنا بحاجة إليه أكثر من تشيزورو-سان

157
00:12:44,200 --> 00:12:46,440
.إنّه خطؤهما من الأساس

158
00:12:46,440 --> 00:12:50,550
!لقد ظلاّ يماطلان ويؤجّلان الأمر طويلاً

159
00:12:50,550 --> 00:12:54,290
سأجد طريقة لإنهاء الأمر
.بطريقة لا تُحزن أيّ أحد

160
00:12:55,070 --> 00:12:57,520
.اسمع يا كازويا-كُن

161
00:12:57,520 --> 00:13:00,600
.يفترض بنا أن نكون معًا

162
00:13:00,600 --> 00:13:04,680
نحن توأمُ روحِ بعضنا البعض
.في هذا العالم بأسره

163
00:13:05,710 --> 00:13:10,420
هل ستكون قسوة منّي أن أرغب
في أن "تنفصل" عن تشيزورو-سان؟

164
00:13:10,420 --> 00:13:16,530
هل يُعدّ التّمنّي بأن يصير
كازويا-كُن لي وأكون له أمرًا سيّئًا؟

165
00:13:16,840 --> 00:13:18,660
!سأبذل كلّ ما في وسعي

166
00:13:18,660 --> 00:13:22,990
،سأحاول أكثر وأكثر حتّى يحبّني
!وسأجتهد في ذلك أكثر وأكثر

167
00:13:23,970 --> 00:13:26,620
.سامحني يا كازويا-كُن

168
00:13:26,620 --> 00:13:28,030
.أنا آسفة

169
00:13:39,510 --> 00:13:41,840
.اسمحي لي بسؤال آخر

170
00:13:42,480 --> 00:13:47,190
لماذا دعوتني لمرافقتكم في هذه الرّحلة؟

171
00:13:49,300 --> 00:13:52,200
.أعتقد أنّي سأكون عبئًا لا غير

172
00:13:52,200 --> 00:13:57,970
،فأنا لديّ عادة الكذب
.وأظلّ دائمًا أتبعهما أينما ذهبا

173
00:13:59,820 --> 00:14:02,830
واثقة أنّك تفضّلين الحديث
.مع تشيزورو-سان بدلاً منّي

174
00:14:02,830 --> 00:14:07,910
،حتّى إن كنتُ صديقتها
.لم تكن هنالك حاجة لدعوتي

175
00:14:08,200 --> 00:14:11,250
.لو كنت مكانك، لما فعلت ذلك

176
00:14:15,640 --> 00:14:19,550
.أهذا كلّ شيء؟ الجواب بسيط جدًّا

177
00:14:20,620 --> 00:14:23,620
.هذا لأنّي أحبّك يا روكا-دونو

178
00:14:23,620 --> 00:14:26,960
أحبّ صوتك المليء بالحيويّة
.وابتسامتك المشعّة

179
00:14:26,960 --> 00:14:30,490
أشعر أنّي شابّة ثانية بمجرّد
.قضاء الوقت معك

180
00:14:30,890 --> 00:14:35,120
.وقد بدأت أتعلّق بك بشكل كبير أيضًا

181
00:14:35,730 --> 00:14:39,690
كما يبدو أنّ عادة الكذب لديك
.بدأت تتلاشى قليلاً مؤخّرًا

182
00:14:39,690 --> 00:14:41,510
...إ-إنّ ذلك

183
00:14:51,220 --> 00:14:53,360
.نحن نعتذر لكم بشدّة

184
00:14:54,030 --> 00:14:56,790
.لكن امنحنا بعض الوقت رجاءً

185
00:14:57,100 --> 00:14:58,450
.سينتهي هذا الأمير قريبًا

186
00:15:01,000 --> 00:15:02,210
.كازويا

187
00:15:12,140 --> 00:15:16,390
.تـ-تمهّلوا جميعًا. تبدون مخيفين

188
00:15:16,710 --> 00:15:21,570
قالا أنّهما يتواعدان، فما المشكلة؟

189
00:15:25,740 --> 00:15:30,450
،قالا أنّه تجمعهما علاقة حقيقيّة
فما المشكلة الكبيرة في ذلك؟

190
00:15:31,550 --> 00:15:32,540
!روكا-تشان

191
00:15:32,900 --> 00:15:34,500
.صحيح، بالضّبط

192
00:15:34,780 --> 00:15:37,620
.بدأنا نشعر بالبرد ثانية

193
00:15:38,130 --> 00:15:41,640
ما رأيكم أن نغيّر ملابسنا ونهدأ قليلاً أوّلاً؟

194
00:15:41,640 --> 00:15:42,590
!كوري

195
00:15:43,070 --> 00:15:44,980
ما الّذي تقوله يا شون-كُن؟

196
00:15:45,760 --> 00:15:47,870
.هذا ليس وقتًا مناسبًا لذلك

197
00:15:49,080 --> 00:15:51,570
.أ-أنا أفهم. أنا أفهم بالفعل

198
00:15:51,570 --> 00:15:54,430
.لـ-لكنّ أفكار الجميع مشوّشة الآن

199
00:15:54,800 --> 00:15:57,210
ومن قد يُقدم على التّقبيل هنا؟

200
00:15:57,210 --> 00:15:59,270
.سيجد الجميع ذلك غير مقبول

201
00:15:59,550 --> 00:16:02,990
!لننس كلّ هذا ونذهب إلى صالة الألعاب

202
00:16:02,990 --> 00:16:05,090
!أريد تجربة بعض ألعاب العملات

203
00:16:05,090 --> 00:16:08,990
فكرة جيّدة! مثل تلك اللّعبة الّتي يُخرج
!فيها الدّيناصور العملات من فمه

204
00:16:08,990 --> 00:16:11,660
!مهلاً، هنالك شيء كهذا؟

205
00:16:09,330 --> 00:16:11,430
...روكا-تشان... كوري

206
00:16:11,430 --> 00:16:13,950
!...أنتما... أنتما

207
00:16:11,660 --> 00:16:13,950
!لنفز بالجائزة الكبرى فيها

208
00:16:14,370 --> 00:16:16,780
!أنا بارع في ألعاب الرّافعات أيضًا

209
00:16:16,780 --> 00:16:19,670
!مذهل، فز بشيء ما من أجلي

210
00:16:21,640 --> 00:16:22,630
.يا إلهي

211
00:16:22,960 --> 00:16:24,780
أليس هذا ثالث رفض تتعرّض إليه؟

212
00:16:26,370 --> 00:16:28,590
كيف لا تزال تبكي هكذا؟

213
00:16:28,590 --> 00:16:33,640
ولكن، كنتَ تقول دائمًا أنّه لأمر
!رائع أنّني لا أستسلم

214
00:16:33,640 --> 00:16:35,560
.لكلّ شيء حدود يا رجل

215
00:16:35,910 --> 00:16:38,430
.عليك قطعًا الاستسلام هنا

216
00:16:38,430 --> 00:16:39,590
فعلاً؟

217
00:16:40,340 --> 00:16:44,990
يقول الجميع أشياء عشوائيّة بين
.لحظة قراءة الرّسائل والرّدّ عليها

218
00:16:46,480 --> 00:16:47,920
.تعلم أنّ الأمور تسير هكذا

219
00:16:47,920 --> 00:16:50,770
،نحاول جميعًا ألاّ نُكره
،ولا أن نُصدّق كلّ شيء ساذج

220
00:16:50,770 --> 00:16:53,950
،ولا أن نكون متواضعين كثيرًا
.ولا أن نترك فترات صمت غريبة

221
00:16:53,950 --> 00:16:58,830
إنّها دائرة مفرغة لا تنتهي من الأكاذيب
.التّافهة. هذا أساس العلاقات البشريّة

222
00:17:02,110 --> 00:17:05,780
لـ-لن أدعها تخدعني أو ما إلا ذلك، مفهوم؟

223
00:17:07,040 --> 00:17:09,330
.أردتُ أن أثق بها لأنّي معجب بها

224
00:17:11,970 --> 00:17:17,120
ما أقوله هو أنّ هنالك حدًّا واقعيًّا لمدى
.ما يمكنك أن تثق به في شخص ما

225
00:17:25,410 --> 00:17:29,110
ولكن ابتهج. سأدعوك لتناول
.وجبة زبديّة لحم بقريّ

226
00:17:29,110 --> 00:17:30,330
.ماذا؟ أنت إله

227
00:17:31,100 --> 00:17:37,160
إنّ مشاهدتك تجعلني أشعر بأنّني أودّ
.أن أصبح صديقًا لشخص يؤمن بذلك

228
00:17:38,270 --> 00:17:39,520
...كيبي

229
00:17:40,540 --> 00:17:42,860
.اطلب سلطة، وستنتهي صداقتنا

230
00:17:42,860 --> 00:17:44,560
أي أنّي على الحافّة، صحيح؟

231
00:17:45,750 --> 00:17:49,740
.أ-أتشو. كلاّ، ربّما سأصاب بالزّكام

232
00:17:49,740 --> 00:17:52,510
هذا سيّئ! لنذهب لغرف
!تغيير الملابس في الحال

233
00:17:53,030 --> 00:17:55,110
.كوري، ساراشينا-سان

234
00:17:58,030 --> 00:17:59,560
.اخرسا رجاءً

235
00:18:11,130 --> 00:18:15,820
،قد تكون هذه فظاظة منّي
.لكنّي لا أريد أن أُخدع أكثر

236
00:18:16,550 --> 00:18:19,600
هنالك حدود لمدى ثقة
.شخص ما في الآخر

237
00:18:20,040 --> 00:18:21,830
،بعد أن كذبتما عليّ لسنة ونصف

238
00:18:22,100 --> 00:18:25,700
إن كنتما لا تزالان تحاولان
...مواصلة الكذب هنا

239
00:18:25,700 --> 00:18:29,310
فلن تكون كينوشيتا كازويا
.الّذي أعتبره أعزّ أصدقائي بعد الآن

240
00:18:30,530 --> 00:18:32,900
،لا أقول أنّي أحبّ الاشتباه بتشيزورو-سان

241
00:18:32,900 --> 00:18:36,430
لكنّ ناغومي-سان تريدك أن تكون
،سعيدًا أكثر من أيّ أحد آخر

242
00:18:36,430 --> 00:18:39,400
وأعتقد أنّه يجب أن تكون مهمّة
.بنفس القدر عندك

243
00:18:40,750 --> 00:18:43,830
،اسمع يا كازويا. طوال 15 سنة

244
00:18:43,830 --> 00:18:47,120
،وأنا أظنّ أنّك مغفّل مرّات عديدة

245
00:18:48,410 --> 00:18:51,820
لكنّي لم أظنّ ولو لمرّة
.واحدة فيها أنّك كاذب

246
00:18:53,390 --> 00:18:54,530
لستَ كذلك، صحيح؟

247
00:19:16,650 --> 00:19:18,930
.أتمنّى أن تنشقّ الأرض وتبتلعني

248
00:19:20,210 --> 00:19:23,230
!أنا آسف! أنا جدّ آسف

249
00:19:24,300 --> 00:19:27,690
.كلّ هذا خطئي أنا

250
00:19:28,760 --> 00:19:31,270
ليتني لم أحاول أن أبدو
...بمظهر رائع وقتها

251
00:19:31,900 --> 00:19:34,420
...ليتني لم أقل أنّها حبيبتي وقتها

252
00:19:35,040 --> 00:19:38,200
...ليتني لم أقم باستئجار ميزوهارا وقتها

253
00:19:38,990 --> 00:19:43,490
ليتني لم أسمح لروكا-تشان
...بإقناعي بمواعدتها

254
00:19:43,950 --> 00:19:47,960
ليتني لم أتحمّس وحجزت موعدًا
...مزدوجًا مع كوري

255
00:19:48,890 --> 00:19:51,500
...ليتني أخبرتُ أبي بالحقيقة

256
00:19:51,500 --> 00:19:53,920
...ليتني أخبرت أمّي أنّ كلّ هذا كذب

257
00:19:54,770 --> 00:19:57,440
.أنا حقًّا آسف

258
00:19:57,440 --> 00:20:01,230
!أنا حقًّا، حقًّا آسف على كلّ شيء

259
00:22:13,790 --> 00:22:15,270
،في تلك اللّحظة

260
00:22:15,870 --> 00:22:17,740
!عبرت أفكار عديدة في ذهني

261
00:22:19,000 --> 00:22:21,200
".أنا آسف جدًّا يا ميزوهارا"

262
00:22:24,530 --> 00:22:27,820
"كيف كانت ردّة فعل مامي-تشان؟"

263
00:22:28,950 --> 00:22:32,460
".كذبتُ على جدّتي كذبة كبيرة ثانية"

264
00:22:35,420 --> 00:22:41,210
ستكون أعزّ أصدقائي دائمًا"
".يا كيبي مهما حدث

265
00:22:43,390 --> 00:22:47,100
"كوري، أيمكنك تصديق هذا؟"

266
00:22:50,450 --> 00:22:53,810
".لا بدّ أنّ روكا-تشان تشتعل غضبًا"

267
00:22:57,270 --> 00:22:58,280
...لكن

268
00:23:04,750 --> 00:23:09,000
:لكنّ الفكرة الأساسيّة كانت
...في الماضي والحاضر وللأبد"

269
00:23:31,490 --> 00:23:34,190
."ستكونين محور عالمي دائمًا

270
00:23:35,090 --> 00:23:36,490
.هكذا أدركت

271
00:23:57,730 --> 00:23:59,920
!مهلاً، أنا أحمرّ خجلاً

272
00:23:59,920 --> 00:24:03,850
!ماذا؟ أقبّلنا بعضنا للتّوّ؟

273
00:24:04,170 --> 00:24:05,550
هل كنتُ أحلم؟

274
00:24:05,550 --> 00:24:08,430
.هذا صحيح يا كازو-تشان. كنت تحلم

275
00:24:08,430 --> 00:24:09,510
...كيبي

276
00:24:09,510 --> 00:24:11,390
.مهلاً، هذا مستحيل

277
00:24:11,390 --> 00:24:13,580
.فكّر في الأمر فحسب. أنت مجرّد مغفّل

278
00:24:13,580 --> 00:24:16,770
كيف قد تحصل على حبيبة جميلة
.مثل تشيزورو-سان؟ ذلك مستحيل

279
00:24:17,260 --> 00:24:18,950
...كـ-كلاّ

280
00:24:18,950 --> 00:24:21,670
إذًا فكلّ شيء حتّى الآن كان حلمًا؟

281
00:24:21,670 --> 00:24:23,440
:"في الحلقة القادمة من "استأجر حبيبة

282
00:24:23,830 --> 00:24:25,210
...حبيبة"

283
00:24:25,210 --> 00:24:26,300
."حقيقيّة