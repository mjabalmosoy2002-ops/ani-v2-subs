1
00:00:02,300 --> 00:00:04,620
أنتِ مقاومةٌ للشراب حقّاً يا تشيزورو

2
00:00:04,620 --> 00:00:05,980
هاكِ المزيد

3
00:00:06,580 --> 00:00:07,980
شكراً لكِ

4
00:00:38,280 --> 00:00:39,620
ما الذي تفعلينه؟

5
00:00:40,460 --> 00:00:41,380
يا روكا-تشان؟

6
00:01:13,850 --> 00:01:15,160
!لا يمكننا

7
00:01:15,160 --> 00:01:17,620
...جدّياً، جدّياً

8
00:01:17,620 --> 00:01:19,420
سأذهب للحمّام قليلاً

9
00:01:20,410 --> 00:01:22,240
لكنّ كازويا-سان هناك حاليّاً

10
00:01:22,240 --> 00:01:24,520
صحيح، نسيت

11
00:01:34,370 --> 00:01:35,570
آسفة

12
00:01:35,850 --> 00:01:38,440
أعرف أنّي تجاوزتُ حدّي

13
00:01:38,440 --> 00:01:40,920
لكنّي لا أريد الخسارة

14
00:01:48,360 --> 00:01:51,220
لا ندم لديّ

15
00:01:53,810 --> 00:01:57,370
ما قِيل عن كون مذاق القُبلة الأولى
مثل الليمون أو الفراولة كان كذبة، صحيح؟

16
00:01:58,860 --> 00:02:01,620
كان أقرب لمذاق الساكي بالنسبة لي

17
00:02:06,480 --> 00:02:09,100
روكا-تشان، أين كازويا-سان؟

18
00:02:09,100 --> 00:02:10,760
في الحمّام الآن

19
00:03:46,420 --> 00:03:48,460
مرحباً بعودتك يا كازويا-سان

20
00:03:48,460 --> 00:03:50,250
تأخّرت يا كازويا

21
00:03:52,710 --> 00:03:54,670
حـ-حقّاً؟

22
00:03:54,670 --> 00:03:56,510
ألم تعودي بحاجةٍ للذهاب يا جدّة؟

23
00:03:56,510 --> 00:03:59,380
للغرابة، لم أعد أشعر برغبة

24
00:04:12,480 --> 00:04:15,720
أأنتما بخير؟ تبدوان شاحبين

25
00:04:20,110 --> 00:04:25,570
صحيح، أين ذهبت كلّ طاقتكما؟
أحصل شيءٌ ما؟

26
00:04:25,920 --> 00:04:29,040
!لـ-لا، نحن... بخير

27
00:04:29,040 --> 00:04:31,540
!لا خير في هذا قطعاً

28
00:04:32,360 --> 00:04:35,130
!ما كان ذلك؟ قُبلة؟ يا للهول

29
00:04:35,130 --> 00:04:38,500
بيني وبين روكا-تشان؟ لمَ تبادلنا القُبل؟ لمَ الآن؟

30
00:04:35,860 --> 00:04:38,080
أنتما تتصرّفان بغرابة

31
00:04:39,100 --> 00:04:40,630
لكنّي لا أريد الخسارة

32
00:04:41,100 --> 00:04:44,590
كنتُ أضعها تحت ضغطٍ
أكبر مما تصوّرت

33
00:04:45,020 --> 00:04:46,840
...بمجرّد التفكير بالأمر

34
00:04:46,840 --> 00:04:52,240
بدأت هذه العلاقة الزائفة لأنّي
وميزوهارا لم نرد أن نُفضح

35
00:04:52,240 --> 00:04:53,870
كانت هناك علامات بقدوم هذا

36
00:04:53,870 --> 00:04:56,250
،مبيتها الإجباريّ في شقّتي

37
00:04:56,250 --> 00:04:57,980
،ما قالته عند مغادرتها

38
00:04:57,980 --> 00:04:59,980
وانفعالها مع مامي-تشان

39
00:05:00,460 --> 00:05:01,960
!حاصرتُها

40
00:05:01,960 --> 00:05:03,190
...والآن

41
00:05:03,770 --> 00:05:05,530
ماذا؟ قُبلة؟

42
00:05:06,360 --> 00:05:08,520
لمَ هذا فجأةً؟

43
00:05:08,520 --> 00:05:10,240
مضت ستّة أشهر على علاقتنا

44
00:05:10,240 --> 00:05:14,370
كان الثنائيّ الطبيعيّ ليتبادلان
القُبل الآن، لكنّي لن أفرض عليك

45
00:05:15,380 --> 00:05:16,460
...لكن

46
00:05:16,460 --> 00:05:21,930
كنتُ أفكّر بسعادة لحظة تبادل قُبلتي
الأولى مع شخصٍ أحبّه

47
00:05:22,340 --> 00:05:24,940
كانت قُبلتكِ الأولى يا روكا-تشان؟

48
00:05:24,940 --> 00:05:28,600
أأنتِ واثقةٌ أنّكِ أردتها أن
!تكون معي؟ لا، لا يصحّ بالتأكيد

49
00:05:28,600 --> 00:05:31,810
...إهدار قبلتكِ الأولى على هذه العلاقة البائسة

50
00:05:32,640 --> 00:05:33,810
آسف

51
00:05:33,810 --> 00:05:35,020
!آسفٌ يا روكا-تشان

52
00:05:35,830 --> 00:05:38,920
!اللوم عليّ! إنّها غلطتي

53
00:05:39,840 --> 00:05:42,540
كدتُ أنسى

54
00:05:43,360 --> 00:05:46,200
لديّ هديّةٌ لكِ يا تشيزورو-سان

55
00:05:51,120 --> 00:05:56,080
إنّه الخاتم الذي أعطاني إيّاه
زوجي عندما تقدّم لخطبتي

56
00:05:56,080 --> 00:05:57,920
خاتم الخطبة؟

57
00:06:01,840 --> 00:06:04,720
،انتقل إلى هارومي-سان بعدي

58
00:06:04,720 --> 00:06:10,300
لكنّنا تناقشنا في إهدائكِ إيّاه بمناسبة
عيد ميلادكِ العشرين

59
00:06:10,670 --> 00:06:12,220
صحيح يا هارومي-سان؟

60
00:06:12,220 --> 00:06:13,400
بلى، اقبليه رجاءً

61
00:06:17,290 --> 00:06:19,480
!مُحال! كلّا، كلّا

62
00:06:19,800 --> 00:06:21,480
!لا يمكنها قبوله

63
00:06:22,900 --> 00:06:27,190
!من قد تُهدي خاتم خطبة لحبيبةٍ بلغت العشرين لتوّها؟

64
00:06:27,520 --> 00:06:32,910
من تُعطي حُلية عائلة متوارثة
!لحبيبة مُستأجرة؟

65
00:06:27,860 --> 00:06:31,780
!آمل أن يلائمكِ

66
00:06:33,420 --> 00:06:36,700
لا نملك شيئاً آخراً لتقديمه لكِ

67
00:06:36,700 --> 00:06:42,120
ولم تستطع هذه العجوز الهرمة التفكير
بهديّة ملائمة لأميرةٍ مثلكِ

68
00:06:39,170 --> 00:06:40,500
...لا

69
00:06:42,120 --> 00:06:42,880
!مهلاً

70
00:06:43,200 --> 00:06:46,560
!لا يمكنني قبول شيءٍ قيّم كهذا

71
00:06:46,560 --> 00:06:50,570
لا مشكلة، نريد منكِ أن تأخذيه

72
00:06:50,570 --> 00:06:51,840
...لـ-لكن

73
00:06:52,170 --> 00:06:55,560
لا يمكن لـ ميزوهارا التعامل
!مع الوضع أبداً، لا عجب

74
00:06:56,000 --> 00:06:59,440
لعلّها لم تواجه موقفاً كهذا
من قبل أبداً

75
00:07:00,010 --> 00:07:03,150
!عليّ التفكير... التفكير بشيء

76
00:07:07,200 --> 00:07:08,810
ما هذه اليد؟

77
00:07:08,810 --> 00:07:11,820
ما معنى هذا؟ ما الذي
تلمحين له يا روكا-تشان؟

78
00:07:15,160 --> 00:07:20,680
فهمت، لا بدّ أنّ مشاهدة الأمر
عسيرةٌ عليها أيضاً

79
00:07:21,480 --> 00:07:24,510
!ما عساي أفعل؟! ما أفعل؟

80
00:07:24,840 --> 00:07:27,980
أفكّر بترك عمل الحبيبة المُستأجرة

81
00:07:28,760 --> 00:07:31,940
أظنّ وقت الانتقال قد حان

82
00:07:38,270 --> 00:07:40,700
هلّا جرّبتِ ارتداءه؟

83
00:07:40,700 --> 00:07:42,160
...لا يمكنني حقّاً

84
00:07:42,160 --> 00:07:43,350
لا يمكننا قبوله

85
00:07:44,500 --> 00:07:47,770
أتفهّم شعورك، لكن لا داعي لتضخيم الأمر

86
00:07:47,770 --> 00:07:49,230
ليست تلك المشكلة

87
00:07:51,180 --> 00:07:53,870
!لا يمكن أن أرضى بقبول تشيزورو لذاك الخاتم

88
00:07:53,870 --> 00:07:55,820
لا مفرّ

89
00:07:55,820 --> 00:07:58,080
ما قصدك يا كازويا؟

90
00:07:58,080 --> 00:07:59,870
لا طريقة أخرى

91
00:08:01,010 --> 00:08:02,520
أنا آسفٌ حقّاً

92
00:08:03,000 --> 00:08:05,760
أعرف أنّكِ تحبّين ميزوهارا يا جدّتي

93
00:08:05,760 --> 00:08:09,880
أعرف أنّكِ ستكرهينني لإقدامي
على هذا في حفلة عيد الميلاد

94
00:08:10,220 --> 00:08:12,520
...ستنهار جدّتي بالبكاء

95
00:08:14,230 --> 00:08:15,370
!لا أريد رؤية ذلك

96
00:08:15,370 --> 00:08:17,260
أم ستتبرّأ منّي؟

97
00:08:17,260 --> 00:08:19,220
أيّاً يكن، النتيجة فظيعة

98
00:08:19,610 --> 00:08:22,810
لكن لا مهرب بعد الآن

99
00:08:23,240 --> 00:08:27,740
أعرف أنّي سأعكّر الجوّ، لكن لا يمكن أن يستمرّ هذا

100
00:08:28,560 --> 00:08:33,070
خروجي وميزوهارا في مواعيد
يسبّب الضغط لـ روكا-تشان

101
00:08:33,390 --> 00:08:36,700
عليّ فعل هذا لأجلها أيضاً

102
00:08:37,370 --> 00:08:39,960
...كما عليّ إنهاء الأمر

103
00:08:40,710 --> 00:08:43,290
عاجلاً لا آجلاً

104
00:08:43,750 --> 00:08:47,260
!الآن الفرصة، هنا الليلة

105
00:08:47,910 --> 00:08:52,250
لا يمكن أن يستمرّ الوضع

106
00:08:52,710 --> 00:08:55,400
شكراً لكِ على كلّ شيءٍ يا ميزوهارا

107
00:08:55,800 --> 00:08:57,680
ابقي هادئة واسمعيني

108
00:08:58,060 --> 00:08:59,520
...أنا وتشيزورو

109
00:08:59,520 --> 00:09:01,390
!سامحيني يا روكا-تشان

110
00:09:01,390 --> 00:09:06,410
لا يمكنني المواصلة بهذه المسرحيّة
!إن كانت ستواصل إلحاق الأذيّة بأحدهم

111
00:09:06,410 --> 00:09:07,850
...ا-انفصـ

112
00:09:13,160 --> 00:09:15,530
آ-آسفة

113
00:09:19,950 --> 00:09:22,090
ا-اعذروني قليلاً

114
00:09:24,660 --> 00:09:26,810
أجل، معك إيتشينوسي

115
00:09:27,760 --> 00:09:29,190
!ماذا؟ حسناً

116
00:09:29,770 --> 00:09:31,640
!حسناً، سآتي فوراً

117
00:09:31,640 --> 00:09:33,000
!تولّوا الأمر رجاءً

118
00:09:46,690 --> 00:09:51,720
كانت تلك اللحظة انطلاقة كلّ شيء

119
00:09:52,830 --> 00:09:55,930
فقدت جدّتي وعيها

120
00:10:01,830 --> 00:10:04,450
سأدفع الأجرة، اسبقاني

121
00:10:05,040 --> 00:10:06,160
...لكنّ المال

122
00:10:08,000 --> 00:10:08,970
لنذهب

123
00:10:13,400 --> 00:10:17,880
أتوسّل إليك، كن ذاك السند لتشيزورو

124
00:10:22,390 --> 00:10:23,850
!جدّة سايوري

125
00:10:27,620 --> 00:10:30,310
!كازويا-كن! وتشيزورو أيضاً

126
00:10:34,050 --> 00:10:35,980
!كما أتوقّع من سايوتاسو

127
00:10:36,250 --> 00:10:40,700
!رجعتِ من عالم الأموات، إرادتكِ في العيش مُبهرة

128
00:10:40,700 --> 00:10:45,290
أجل، استدرتُ عندما وصلت نهر ستيكس

129
00:10:46,310 --> 00:10:50,190
!قمتِ بتقويم سلوك الشيطان نفسه

130
00:10:50,190 --> 00:10:52,170
!كلاكما مُستنكر

131
00:10:52,490 --> 00:10:58,130
لكنّي أعتذر على إفساد حفلة
عيد الميلاد التي أقمتِها

132
00:10:58,130 --> 00:11:00,510
لا بأس

133
00:11:00,510 --> 00:11:04,440
أنا من عليها الاعتذار لدعوة تشيزورو-سان
بينما تعانين توعّكاً في صحّتكِ

134
00:11:04,440 --> 00:11:05,850
أشعر بالندم

135
00:11:06,200 --> 00:11:09,560
لا شيء لتندمي عليه

136
00:11:09,560 --> 00:11:12,520
فقد بدا على تشيزورو
أنّها توّاقةٌ للذهاب

137
00:11:12,520 --> 00:11:14,520
كنتُ لأجعلها تتغيّب
عن جنازتي لتذهب

138
00:11:14,800 --> 00:11:16,760
ماذا؟ ميزوهارا كانت؟

139
00:11:16,760 --> 00:11:19,240
مـ-مهلاً يا جدّتي! ما الذي تقولينه؟

140
00:11:19,240 --> 00:11:21,690
أحقّاً ذلك يا تشيزورو-سان؟

141
00:11:19,750 --> 00:11:23,060
أرادت القدوم لمنزلنا؟

142
00:11:21,690 --> 00:11:23,450
...حسناً، أجل

143
00:11:27,660 --> 00:11:29,830
آ-آسف

144
00:11:33,170 --> 00:11:35,880
انتابنا الفزع للحظة

145
00:11:35,880 --> 00:11:38,570
لكن يسرّني أنّ الجدّة سايوري بخير

146
00:11:40,750 --> 00:11:42,440
لا بدّ أنّ ميزوهارا تشعر بارتياحٍ أيضاً

147
00:11:42,940 --> 00:11:45,380
مهلاً يا جدّتي، عليكِ الاستراحة

148
00:11:45,920 --> 00:11:46,780
تفضّل

149
00:11:48,760 --> 00:11:50,920
إيتشينوسي-سان، أيمكننا الكلام؟

150
00:11:50,920 --> 00:11:53,820
أجل، راقبهما من فضلك يا كازويا-سان

151
00:11:54,440 --> 00:11:55,930
حـ-حسناً

152
00:11:58,370 --> 00:12:01,020
كان كموقف حبيبين كلّياً

153
00:12:05,620 --> 00:12:08,110
أخبرنا، كيف الوضع مع تشيزورو؟

154
00:12:08,110 --> 00:12:09,940
ما قصدك؟

155
00:12:08,430 --> 00:12:12,060
يمنعهما الخجل من إخباري

156
00:12:12,060 --> 00:12:13,450
هل علاقتكما غراميّة؟

157
00:12:13,450 --> 00:12:15,220
ر-ربما

158
00:12:16,420 --> 00:12:18,480
تحدّثنا عن انتقالهما للعيش معاً اليوم

159
00:12:18,480 --> 00:12:20,300
!ماذا؟ العيش معاً؟

160
00:12:20,300 --> 00:12:22,230
ألن يكون ذلك جميلاً؟

161
00:12:21,510 --> 00:12:23,260
!يا إلهي، قلبي يخفق

162
00:12:32,640 --> 00:12:36,400
يسرّني أنّ الجدّة سايوري بخير

163
00:12:36,400 --> 00:12:38,700
لكنّي فقدت فرصتي في الاعتراف

164
00:12:38,700 --> 00:12:42,090
،هنالك موضوع روكا-تشان أيضاً
لا يمكنني السماح باستمرار الوضع

165
00:12:45,760 --> 00:12:46,700
ميزوهارا

166
00:12:47,330 --> 00:12:50,040
أرسلتاني لشراء شيء، إنّهما مُتأمّرتان حقّاً

167
00:12:50,520 --> 00:12:52,020
ما الذي قاله الطبيب؟

168
00:12:56,200 --> 00:12:57,520
أنباء سيّئة

169
00:12:59,330 --> 00:13:02,630
حالة جدّتي متدهورة

170
00:13:03,960 --> 00:13:05,880
أخبرني الطبيب بذلك

171
00:13:04,200 --> 00:13:08,430
انظري، هذه الباثّة الجديدة
المفضّلة لي، عمرها في السبعين

172
00:13:06,390 --> 00:13:08,440
،يبدو عليها أنّها بخير

173
00:13:08,430 --> 00:13:11,210
مذهل، قريبةٌ منّا

174
00:13:08,440 --> 00:13:11,210
لكنّها لم تعد تملك وقتاً طويلاً أمامها

175
00:13:18,490 --> 00:13:19,400
أسيكون الوضع بخير؟

176
00:13:20,550 --> 00:13:22,360
أخبرتك أنّها ليست بخير

177
00:13:22,360 --> 00:13:24,920
أقصدكِ أنتِ، أستكونين على ما يرام؟

178
00:13:28,900 --> 00:13:31,330
ماذا؟ أأنت قلقٌ عليّ الآن؟

179
00:13:31,680 --> 00:13:32,920
أنا على ما يرام

180
00:13:32,920 --> 00:13:36,040
كنتُ أعرف بقدوم هذا
مُذ سمعت بتشخيصها

181
00:13:36,040 --> 00:13:38,940
فبذلتُ قصارى ما أستطيع فعله لها

182
00:13:41,350 --> 00:13:42,500
مهلاً، أين تذهب؟

183
00:13:43,900 --> 00:13:45,160
أليس ذلك واضحاً؟

184
00:13:45,160 --> 00:13:49,800
سأخبر جدّتكِ أنّ علاقتنا كانت كذبة

185
00:13:49,800 --> 00:13:52,410
...ماذا؟ لكن

186
00:13:52,410 --> 00:13:54,520
كنتُ متحضّراً بأيّ حال

187
00:13:55,020 --> 00:13:57,880
لا يمكنني التسبّب بمتاعب أكثر لكِ

188
00:13:58,850 --> 00:14:01,000
،لن أتكلّم عن موضوع الاستئجار

189
00:14:01,000 --> 00:14:04,570
،لكن إن كان وقتنا محدوداً
فذلك مسوغٌ أكبر لإنهاء الكذب

190
00:14:07,240 --> 00:14:11,200
هذا كلّ ما أستطيع فعله للتصحيح

191
00:14:16,370 --> 00:14:18,740
انتظر، مهلك

192
00:14:19,570 --> 00:14:22,000
لا أريدها أن تعرف

193
00:14:22,000 --> 00:14:25,460
لا أريد إخبارها أنّنا سننفصل

194
00:14:26,320 --> 00:14:27,780
ميزوهارا؟

195
00:14:30,100 --> 00:14:32,970
لا تريدين إخبارها؟ لمَ؟

196
00:14:34,000 --> 00:14:37,180
لأنّها أُعجبت بك

197
00:14:39,140 --> 00:14:46,360
وهي قلقةٌ من وحدتي بعدما تفارقني

198
00:14:48,640 --> 00:14:53,290
أعرف أنّي أناقض نفسي
بعدما أخبرتك بتصحيح الأمور

199
00:14:53,810 --> 00:14:56,280
لكن ليس باليد حيلةٌ الآن

200
00:14:57,070 --> 00:15:02,140
إخبار امرأةٍ على فراش الموت أنّ
حفيدتها انفصلت عن حبيبها للتوّ

201
00:15:02,140 --> 00:15:03,750
لن يجلب لها أيّ خير

202
00:15:07,590 --> 00:15:09,210
...لـ-لكن

203
00:15:10,990 --> 00:15:13,640
نحن لا نتواعد في الواقع، أليس كذلك؟

204
00:15:16,320 --> 00:15:17,100
بلى

205
00:15:17,420 --> 00:15:18,720
أصبت

206
00:15:18,720 --> 00:15:22,920
إ-إذاً، ما الفائدة من الاستمرار بالكذب؟

207
00:15:27,010 --> 00:15:29,720
أصبحت أكثر من محض كذبة

208
00:15:30,220 --> 00:15:33,740
لا أستطيع إحزان جدّتي في هذه المرحلة

209
00:15:33,740 --> 00:15:34,730
...لـ-لكن

210
00:15:34,730 --> 00:15:35,750
ألا يكفي؟

211
00:15:37,040 --> 00:15:41,880
إن كانت جدّتي تعتقد في داخلها
أنّي وجدت شاباً رائعاً

212
00:15:43,350 --> 00:15:45,170
فألا يكفي ذلك؟

213
00:15:47,920 --> 00:15:49,640
سأسبقك

214
00:15:55,300 --> 00:15:57,900
ما عساي أفعل؟

215
00:15:59,370 --> 00:16:01,190
،أفهم ما تقوله ميزوهارا

216
00:16:01,770 --> 00:16:05,020
لكن أهذا مقبولٌ حقّاً؟
أهذا ما علينا فعله؟

217
00:16:05,940 --> 00:16:10,730
لا أريد في الواقع إحزان
الجدّة سايوري أيضاً

218
00:16:18,160 --> 00:16:23,200
وسم "كدتُ أُصاب بنوبة قلبيّة!" هذا
مزحة منتشرة، نالت إعجابي

219
00:16:23,200 --> 00:16:26,380
يبدو مُسليّاً، أريد تجربة الأمر

220
00:16:36,420 --> 00:16:40,460
حسناً، سنرجع الآن، انقضت ساعات الزيارة

221
00:16:40,460 --> 00:16:43,070
أجل، زوريني من جديد يا ناغومين

222
00:16:43,070 --> 00:16:44,330
أجل، بالطبع

223
00:16:47,830 --> 00:16:50,150
سأذهب لإيقاف سيّارة أجرة

224
00:16:50,480 --> 00:16:53,100
احرص على أن تكون سيّارةً جميلة

225
00:16:52,880 --> 00:16:54,840
لا يوجد ذلك

226
00:16:53,100 --> 00:16:56,610
مثل عربة يقطين لأجل الأميرة

227
00:17:01,900 --> 00:17:03,140
تشيزورو-سان

228
00:17:05,000 --> 00:17:06,460
...بخصوص هذا

229
00:17:06,840 --> 00:17:08,990
آسفة، لا يمكنني قبوله

230
00:17:08,990 --> 00:17:11,190
وضع سايوري-سان سيّئ، صحيح؟

231
00:17:12,090 --> 00:17:15,240
إنّها امرأةٌ قويّة بحقّ

232
00:17:15,240 --> 00:17:17,300
،تُبدي البهجة

233
00:17:17,610 --> 00:17:20,380
لكن الأمر جليٌّ بالنظر لوجهها

234
00:17:20,760 --> 00:17:26,230
سمعتُ أنّكِ لن تمتلكي عائلةً
إن حصل مكروه

235
00:17:26,490 --> 00:17:29,930
قومي برهنه إن احتجتِ لمال

236
00:17:29,930 --> 00:17:32,540
ولا داعي لارتدائه إن لم تريدي

237
00:17:32,540 --> 00:17:36,200
أردتكِ أن تحظي به فحسب

238
00:17:36,200 --> 00:17:38,550
ذلك كلّ ما بالأمر حقّاً

239
00:17:46,380 --> 00:17:48,780
!هيّا، أتيتُ بالسيّارة

240
00:17:48,780 --> 00:17:52,300
جيّد، هل إيقاف سيّارات الأجرة
هو كلّ ما تبرع به؟

241
00:17:57,080 --> 00:17:59,530
...كانت ميزوهارا تبدي التماسك

242
00:17:59,530 --> 00:18:01,220
ما عنوانكِ يا تشيزورو-سان؟

243
00:18:01,220 --> 00:18:03,690
لا داعي، ستبيت معي الليلة

244
00:18:03,690 --> 00:18:06,180
لكنّها بدت أصغر لي
نوعاً ما يومها

245
00:18:03,840 --> 00:18:06,180
حسناً، فكرةٌ ممتازة

246
00:18:07,170 --> 00:18:12,150
لعلّ الألم والخوف والحزن أثقلوا عليها

247
00:18:12,150 --> 00:18:13,500
مع الكثير من المشاعر

248
00:18:17,670 --> 00:18:19,390
إ-إلى اللقاء

249
00:18:19,390 --> 00:18:20,150
أجل

250
00:18:21,520 --> 00:18:22,970
،بينما أنا

251
00:18:23,540 --> 00:18:26,590
لا أستطيع فعل شيءٍ لها

252
00:18:31,620 --> 00:18:33,420
فألا يكفي ذلك؟

253
00:18:34,900 --> 00:18:35,700
تبّاً

254
00:20:27,030 --> 00:20:29,560
!القشدة تذوب في الفم

255
00:20:30,740 --> 00:20:32,160
!قوس المطر رائعٌ أيضاً

256
00:20:34,370 --> 00:20:37,080
ما الذي يجري؟

257
00:20:37,080 --> 00:20:40,060
هذا ليس وقت أكل
فطائر محلاة منفوشة

258
00:20:40,910 --> 00:20:43,680
ألا تجد روكا-تشان الوضع مُحرجاً؟

259
00:20:43,680 --> 00:20:45,090
لا أستطيع إطاقته

260
00:20:45,480 --> 00:20:48,050
ولا النظر في عينيها حتّى

261
00:20:50,660 --> 00:20:55,340
أهي بخير؟ جدّة تشيزورو-سان

262
00:20:56,340 --> 00:21:00,530
أجل، استقرّت حالتها البارحة

263
00:21:00,830 --> 00:21:02,030
فهمت

264
00:21:02,030 --> 00:21:03,840
أعتذر على جعلكِ ترجعين للبيت بمفردكِ

265
00:21:03,840 --> 00:21:06,490
لا مشكلة، كانت حالةً طارئة

266
00:21:06,900 --> 00:21:09,480
لا جدوى من جعلها تقلق

267
00:21:10,000 --> 00:21:11,380
وتشيزورو-سان؟

268
00:21:12,480 --> 00:21:14,870
أكانت تمرّ بوقتٍ عصيب؟

269
00:21:15,920 --> 00:21:20,460
أجل، كانت تحاول عدم إظهار الأمر، لكنّي متأكّد

270
00:21:20,980 --> 00:21:24,420
فهمت، لا عجب

271
00:21:24,800 --> 00:21:27,390
لكن... روكا-تشان فتاةٌ لطيفةٌ بحقّ

272
00:21:28,260 --> 00:21:33,050
،تقلق على الغير حتّى في هذا الوضع
لا أدري لو أستطيع فعل ذلك

273
00:21:38,070 --> 00:21:41,020
سأعقد هدنةً معك ومع تشيزورو-سان

274
00:21:42,100 --> 00:21:45,490
من الصحيح أنّي أريد
أن أصبح حبيبتك الحقيقيّة

275
00:21:46,020 --> 00:21:50,450
لكن حتّى أنا أعرف أنّ هذا
ليس وقتاً مناسباً للهجوميّة

276
00:21:50,450 --> 00:21:51,840
...روكا-تشان

277
00:21:51,840 --> 00:21:52,910
شعرتُ بسعادة

278
00:21:53,400 --> 00:21:57,060
لرؤيتك على وشك إنهاء الأمر معها

279
00:21:57,490 --> 00:21:59,380
لكنّ الآن وقتٌ سيّئ

280
00:21:59,760 --> 00:22:01,840
!ماذا؟ اكتشفت؟

281
00:22:01,840 --> 00:22:03,210
!بالطبع

282
00:22:04,020 --> 00:22:07,580
كما أنّك أخطأت فهم أمرٍ يا كازويا-كن

283
00:22:07,580 --> 00:22:10,200
،قلتُ أنّي لا أريد الخسارة

284
00:22:10,200 --> 00:22:12,470
لكنّي قلت أنّ لا ندم لديّ أيضاً

285
00:22:13,380 --> 00:22:18,020
شعرتُ بإحباطٍ عندما رأيت
مثاليّة تشيزورو-سان

286
00:22:18,350 --> 00:22:24,980
لكنّ ذلك جعلني أدرك مُجدّداً
مدى حبّي لك... لذا القُبلة

287
00:22:25,310 --> 00:22:30,440
تسنّى لي تقبيل الشخص الذي أحبّه
وتقديم علاقتنا خطوةً

288
00:22:30,440 --> 00:22:32,540
!فذلك تحسّن

289
00:22:34,000 --> 00:22:35,180
...روكا-تشان

290
00:22:39,750 --> 00:22:43,590
بالمناسبة، متى أردت فعلها، فأخبرني وحسب

291
00:22:45,990 --> 00:22:49,060
التقبيل مقبولٌ الآن، صحيح؟

292
00:22:51,960 --> 00:22:54,440
!لا! ليس مقبولاً أبداً

293
00:22:54,440 --> 00:22:56,190
ماذا؟

294
00:22:56,190 --> 00:22:59,350
صحيح، إليك هديّة عيد ميلادك

295
00:23:04,360 --> 00:23:05,910
ما الذي يجري بالضبط؟

296
00:23:07,020 --> 00:23:09,500
عقدتُ عزيمتي أخيراً

297
00:23:09,500 --> 00:23:12,840
لكنّ ميزوهارا وروكا-تشان
تعارضان الأمر معاً الآن؟

298
00:23:14,260 --> 00:23:15,700
سأعقد هدنة

299
00:23:17,190 --> 00:23:19,300
كلتاهما أكثر نضجاً منّي

300
00:23:19,960 --> 00:23:23,130
!يا إلهي! لا يُعقل هذا

301
00:23:23,130 --> 00:23:28,010
لم يعد هناك شيءٌ أستطيع
!فعله في هذا الوضع

302
00:23:37,680 --> 00:23:38,980
أنا هالك

303
00:23:39,450 --> 00:23:42,490
!ما عساي أفعل؟

304
00:23:54,760 --> 00:23:55,830
!حسناً

305
00:23:57,620 --> 00:24:00,090
فتحتُ صفحةً جديدة

306
00:24:00,090 --> 00:24:02,620
لنعقد هدنةً لفترة يا تشيزورو-سان

307
00:24:02,620 --> 00:24:05,050
لكن عديني بشيءٍ واحد

308
00:24:05,050 --> 00:24:07,000
لا تقبّلي كازويا-كن، اتّفقنا؟

309
00:24:07,000 --> 00:24:09,310
لا تقلقي، لن أفعل شيئاً

310
00:24:09,310 --> 00:24:10,170
!ماذا؟

311
00:24:10,170 --> 00:24:10,620
ماذا؟

312
00:24:10,620 --> 00:24:11,640
...لا

313
00:24:11,640 --> 00:24:15,040
!صحيح، هو من عليّ الانتباه له

314
00:24:15,040 --> 00:24:16,940
!سألغي الهدنة

315
00:24:16,940 --> 00:24:19,200
!ماذا حلّ بفتح صفحة جديدة؟

316
00:24:19,200 --> 00:24:21,420
ذلك جانباً، في الحلقة القادمة
:"من "استأجر حبيبة

317
00:24:21,420 --> 00:24:22,380
...مُرشدة"

318
00:24:22,380 --> 00:24:23,080
"وحبيبة

319
00:24:23,080 --> 00:24:25,290
...إن توجّب عليّ، فسأقيّده

320
00:24:25,290 --> 00:24:26,560
!روكا-تشان؟