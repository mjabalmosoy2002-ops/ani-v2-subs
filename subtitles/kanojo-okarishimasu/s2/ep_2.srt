1
00:00:00,980 --> 00:00:01,780
حلّ الربيع

2
00:00:02,680 --> 00:00:04,440
درجات الحرارة في ارتفاع

3
00:00:04,440 --> 00:00:06,740
وخفّت طبقات الثياب
التي يرتديها الناس

4
00:00:07,550 --> 00:00:09,560
بالنسبة للجامعة، فقد انتهت عطلة الربيع

5
00:00:09,560 --> 00:00:13,940
وبدأ همّ البحث عن عمل
يتسلّل لنا نحن التلامذة

6
00:00:14,530 --> 00:00:16,860
ما الذي تنوي عليه يا كوري؟

7
00:00:16,860 --> 00:00:18,740
تمتلك عائلتي بستاناً

8
00:00:19,260 --> 00:00:23,550
لذا يمكنني جني أرباحٍ بالترويج وقت الاختبارات
لتفّاحاتٍ تضمن الالتحاق بالمدارس الثانويّة

9
00:00:23,550 --> 00:00:25,710
أيّ استخفافٍ بالواقع هذا؟

10
00:00:25,980 --> 00:00:27,950
كازو-تشين، أنت في طائفة الـ "فانزو"، صحيح؟

11
00:00:27,950 --> 00:00:28,920
لمَ تظنّ ذلك؟

12
00:00:28,920 --> 00:00:30,170
مُستكشف عارضات؟

13
00:00:30,170 --> 00:00:31,080
!لمّ تظنّ ذلك؟

14
00:00:31,080 --> 00:00:32,550
دون فعل شيء

15
00:00:33,650 --> 00:00:36,440
وهكذا بدأنا عامنا الثاني

16
00:02:10,000 --> 00:02:12,150
كيف تجذب فتاةً فوق مستواك؟

17
00:02:12,150 --> 00:02:13,480
نعم

18
00:02:13,480 --> 00:02:16,070
ألم تقل أنّ زوجتك كانت
مُضيفةً جويّة؟

19
00:02:18,700 --> 00:02:21,580
!صعدتُ معها رحلةً رحلةً

20
00:02:21,580 --> 00:02:22,510
ماذا؟

21
00:02:22,510 --> 00:02:25,870
طرتُ لأماكن عشوائيّة
!لم تكن لي رغبةٌ بها حتّى

22
00:02:25,870 --> 00:02:27,330
مررتَ بصعاب

23
00:02:27,720 --> 00:02:30,090
،لحظة وقوعك في حبّ أحدهم
فأنت في سفح الجبل

24
00:02:30,090 --> 00:02:32,170
عليك الصعود بالشغف

25
00:02:32,170 --> 00:02:33,200
حاضر

26
00:02:33,200 --> 00:02:35,050
ولمَ لا تغسل الأطباق؟

27
00:02:39,480 --> 00:02:42,180
...لكنّ هذه الفتاة حبيبةٌ مُستأجرة

28
00:02:43,600 --> 00:02:44,830
!إلى اللقاء

29
00:02:44,830 --> 00:02:45,890
مع السلامة

30
00:02:49,240 --> 00:02:52,350
لأنّي لا أتحلّى بالموهبة

31
00:02:52,350 --> 00:02:55,360
!لذا لا تخبريني أنّكِ ستستسلمين

32
00:02:57,280 --> 00:02:59,740
...أحبّ ميزوهارا

33
00:03:00,220 --> 00:03:02,780
!أحبّكِ يا ميزوهارا

34
00:03:07,160 --> 00:03:08,750
مرحباً

35
00:03:11,440 --> 00:03:13,670
أيمكنني تسجيل طلبكما؟

36
00:03:14,060 --> 00:03:15,720
سآخذ نفس طلبه

37
00:03:16,390 --> 00:03:17,590
لا تمانع؟

38
00:03:17,590 --> 00:03:21,110
!إنّها مُشرقة... مثل الشمس

39
00:03:23,370 --> 00:03:25,500
صحيح، المال

40
00:03:25,500 --> 00:03:27,370
أيمكننا الكلام قبلها؟

41
00:03:28,940 --> 00:03:32,850
أرى أنّك تبالغ في استئجاري كلّ أسبوع

42
00:03:34,100 --> 00:03:36,890
من الصحيح أنّي أتقاضى أجراً
سخيّاً عندما تختارني

43
00:03:36,890 --> 00:03:40,300
ويُسعدني أنّك ترغب بمساندتي ماليّاً

44
00:03:41,030 --> 00:03:45,020
لكنّك لست مُلزماً
بفعل كلّ ذلك لي

45
00:03:45,020 --> 00:03:47,420
...وعندما أضع بقيّة العملاء في الاعتبار

46
00:03:48,320 --> 00:03:53,830
لا أرى أنّ من الصائب استئجاري لأيّ
غاية عدا كوني حبيبة

47
00:03:54,260 --> 00:03:56,620
ولا تجني شيئاً مما تبذله

48
00:03:56,620 --> 00:03:58,300
ر-ربما

49
00:03:58,640 --> 00:04:02,260
حسناً، لستُ حبيبكِ
أو ما يُقارب ذلك

50
00:04:03,510 --> 00:04:07,350
كما أنّ مامي-سان
أخبرتني بألّا أقابلك مُجدّداً

51
00:04:08,880 --> 00:04:13,600
إذا رأتنا هكذا الآن، فما الذي
قد يجول ببالها؟

52
00:04:14,050 --> 00:04:17,210
كلّها تغيظني قليلاً

53
00:04:17,850 --> 00:04:22,220
صحيح، ذكرت مامي-تشان ذلك

54
00:04:22,650 --> 00:04:27,150
لم أبالِ كثيراً آنذاك بما أنّ
ميزوهارا نوت التوقّف بالأصل

55
00:04:27,150 --> 00:04:29,290
لكن لا يمكن أن يستمرّ
هذا الوضع بالفعل

56
00:04:29,290 --> 00:04:32,120
وختاماً، لدينا موضوع روكا-تشان

57
00:04:32,120 --> 00:04:33,250
روكا-تشان؟

58
00:04:33,880 --> 00:04:36,200
أعطتنا موافقتها

59
00:04:36,200 --> 00:04:40,090
لكنّنا سنخاطر بإثارة استيائها
إن كثرت لقاءتنا

60
00:04:40,090 --> 00:04:44,340
،وبما أنّي توسّطتُ بينكما
أودّ تفادي ذلك

61
00:04:44,800 --> 00:04:48,100
آسفٌ يا روكا-تشان، لكن هلّا
سمحتِ لي بمواعدة ميزوهارا؟

62
00:04:49,830 --> 00:04:50,760
ماذا؟

63
00:04:51,130 --> 00:04:53,850
أتدرك ما الذي تقوله؟

64
00:04:53,850 --> 00:04:54,840
أدرك

65
00:04:54,840 --> 00:04:56,600
!لكن أرجوك

66
00:04:57,020 --> 00:05:00,350
أتخبرني في وجهي
!أنّك تريد خيانتي؟

67
00:05:00,350 --> 00:05:03,740
!ألا تشعر بالأسى لي؟

68
00:05:03,740 --> 00:05:05,070
!ليست خيانة

69
00:05:05,070 --> 00:05:10,240
كما ألم تخبرني أنّك
تريد جعل الأمر رسميّاً؟

70
00:05:11,590 --> 00:05:16,540
لم نكمل المحادثة، لكنّني فهمت
ما الذي ستتضمّنه تالياً

71
00:05:16,540 --> 00:05:20,380
ألم يكن تصريحاً بأنّك

72
00:05:21,090 --> 00:05:24,880
ستأخذ علاقتنا بجدّية أخيراً؟

73
00:05:28,220 --> 00:05:31,720
لكنّي كنت أحاول
تجاوز ميزوهارا آنذاك

74
00:05:32,200 --> 00:05:35,560
!أريد جعلها رسمية

75
00:05:36,360 --> 00:05:39,110
لكن تغيّر الوضع الآن

76
00:05:42,520 --> 00:05:44,470
!رأيتُ بأمّ عيني

77
00:05:45,090 --> 00:05:49,640
،إنّها تطمح لتصبح مُمثلة
!وتتحلّى بموهبةٍ كبيرة

78
00:05:49,640 --> 00:05:52,870
عملها كحبيبةٍ مُستأجرة يعينها
في جني قوتها والسعي لحلمها

79
00:05:53,200 --> 00:05:58,080
،وسبق أن ساعدتني عدّة مرّات
فأريد مدّ يد العون لها

80
00:05:58,080 --> 00:06:00,540
!لكن لا داعي ليكون أنت

81
00:06:00,540 --> 00:06:03,240
!يمكن أن يتولّى بقيّة عملائها ذلك

82
00:06:03,240 --> 00:06:05,050
إنّها محقّة

83
00:06:06,720 --> 00:06:07,590
...لكن

84
00:06:08,130 --> 00:06:10,520
ذلك ليس المعنى

85
00:06:10,520 --> 00:06:12,100
...ليس

86
00:06:15,530 --> 00:06:18,330
فلتعدني إذاً

87
00:06:19,550 --> 00:06:23,860
أنّك ستأخذني معك لمشاهدة مسرحيّة
تشيزورو-سان في وقتٍ ما

88
00:06:25,760 --> 00:06:27,530
!أ-أجل

89
00:06:27,530 --> 00:06:32,140
حسناً، من الجليّ أنّ علاقتنا
كثنائيّ في تقدّم

90
00:06:32,140 --> 00:06:33,370
لستُ متأكّداً من ذلك

91
00:06:33,370 --> 00:06:36,620
ولا أدري ما إن كنتَ
مُقيّماً جيّداً للتمثيل

92
00:06:36,970 --> 00:06:39,990
لن أصدّق ما لم أرَ بنفسي

93
00:06:41,380 --> 00:06:43,420
!حسناً، لنذهب

94
00:06:43,750 --> 00:06:46,460
!أنا متأكّدٌ أنّها ستعجبكِ

95
00:06:46,960 --> 00:06:49,090
!هدّئ من حماسك! هذا مُزعج

96
00:06:51,560 --> 00:06:54,010
كانت القهوة لذيذة

97
00:06:54,930 --> 00:06:56,970
أين سنتوجّه تالياً؟

98
00:06:57,280 --> 00:06:58,990
يمكن أن نذهب حيث تريد

99
00:06:58,990 --> 00:06:59,940
اسمعي

100
00:07:01,910 --> 00:07:03,980
هلّا تصرّفتِ بطبيعتك؟

101
00:07:05,360 --> 00:07:09,380
كوني على سجيّتكِ المعتادة
عندما تكونين برفقتي

102
00:07:10,480 --> 00:07:16,910
أعرفكِ على طبيعتك، لذا لعب الدور
يُشعرني بمسافةٍ بيننا

103
00:07:16,910 --> 00:07:18,280
كما أشعر بالسوء

104
00:07:18,280 --> 00:07:19,280
لا يمكنني

105
00:07:20,240 --> 00:07:24,120
أخبرتك، هذا تمرين تمثيلٍ لي

106
00:07:24,120 --> 00:07:26,650
لا جدوى ما لم أكن أمثل
دور فتاتك المثاليّة

107
00:07:29,360 --> 00:07:30,800
لكنّكِ كذلك

108
00:07:32,700 --> 00:07:35,270
أنتِ على عادتكِ
!فتاتي المثاليّة

109
00:07:41,240 --> 00:07:44,900
مـ-من أين هذا؟
لا تتكلّم بكلامٍ مُحرج

110
00:07:47,200 --> 00:07:50,860
لكن، إن كان ذلك كلامك

111
00:07:51,670 --> 00:07:56,450
سأكون على طبيعتي، فطلب العميل أمر

112
00:08:04,680 --> 00:08:06,550
سنفترق هنا إذاً

113
00:08:08,000 --> 00:08:09,750
حـ-حسناً

114
00:08:10,460 --> 00:08:11,930
إ-إلى اللقاء

115
00:08:11,930 --> 00:08:13,800
أجل، أراك لاحقاً

116
00:08:14,380 --> 00:08:17,600
!لذا لا تخبريني أنّكِ ستستسلمين

117
00:08:18,240 --> 00:08:20,300
ما خطبي؟

118
00:08:20,300 --> 00:08:22,410
أستأجرها كلّ أسبوع؟

119
00:08:22,410 --> 00:08:24,380
،إن وضعتُ نفسي مكانها

120
00:08:24,380 --> 00:08:26,040
،فلعلّي قد أساعدها

121
00:08:26,870 --> 00:08:30,140
لكنّي مُتعلّق

122
00:08:30,800 --> 00:08:32,150
أنا عميل

123
00:08:32,780 --> 00:08:34,620
الوضع الراهن لا يتغيّر

124
00:08:35,030 --> 00:08:39,120
لن تتقلّص الفجوة بيننا
في أيّ وقتٍ قريب

125
00:08:45,120 --> 00:08:46,910
!تجاوزت الخامسة مساءً بدقيقة

126
00:08:46,910 --> 00:08:48,710
!انتهى عملي الآن

127
00:08:51,370 --> 00:08:53,340
أأنت مُتفرّغ؟

128
00:08:53,340 --> 00:08:55,680
هنالك مكانٌ أودّ المرور به

129
00:08:56,110 --> 00:08:56,950
ماذا؟

130
00:08:57,930 --> 00:08:59,520
!ماذا؟

131
00:09:00,800 --> 00:09:03,450
!يا للهول... يا للهول

132
00:09:03,450 --> 00:09:04,850
!ما هذا؟

133
00:09:05,320 --> 00:09:05,980
لمَ؟

134
00:09:07,130 --> 00:09:10,120
لمَ أنا هنا مع ميزوهارا؟

135
00:09:17,210 --> 00:09:18,320
!مهلاً، إنّها بارعة

136
00:09:21,970 --> 00:09:25,370
كلا، لا يمكنني منع نفسي
!من التمادي في التفكير

137
00:09:25,370 --> 00:09:27,580
!فهذا مجّاني

138
00:09:27,580 --> 00:09:29,840
!انقضى وقت حجزي

139
00:09:30,580 --> 00:09:31,420
أهذا مقبول؟

140
00:09:32,240 --> 00:09:34,130
أأنتِ مُتأكّدةٌ يا ميزوهارا؟

141
00:09:34,640 --> 00:09:37,900
بعدما أدركتُ أنّ هذا خارج وقت
عملها الآن، لا أدري أين أوقف نظري

142
00:09:37,900 --> 00:09:40,860
لم يتغيّر مظهرها، لكنّ نبضاتي تتسارع الآن

143
00:09:41,810 --> 00:09:44,760
أليس بمثابة... موعدٍ في جوهره الآن؟

144
00:09:45,270 --> 00:09:46,580
أنتِ بارعة

145
00:09:47,570 --> 00:09:48,820
أتتردّدين على المكان؟

146
00:09:49,730 --> 00:09:52,220
أجل، عندما يسوء مزاجي

147
00:09:53,040 --> 00:09:55,780
لكنّي ألفتُ الأنظار عندما آتي بمفردي

148
00:09:56,270 --> 00:09:58,820
ليكن في علمك، هذا ليس موعداً

149
00:09:59,600 --> 00:10:02,060
صادف أن توافقت ميولنا

150
00:10:02,060 --> 00:10:03,240
!أعرف ذلك

151
00:10:03,770 --> 00:10:05,200
وضعت الحدود

152
00:10:07,270 --> 00:10:09,420
!ضربتان مُتتاليتان في محاولتين

153
00:10:09,800 --> 00:10:12,330
انظر لتلك الفتاة، إنّها ظريفةٌ جدّاً

154
00:10:12,330 --> 00:10:14,500
أتظنّها بمفردها؟ أتودّ الكلام معها؟

155
00:10:15,120 --> 00:10:16,810
لا، إنّها رفقة فتى

156
00:10:16,810 --> 00:10:20,000
ماذا؟ أذاك حبيبها؟ لم ألحظه حتّى

157
00:10:20,000 --> 00:10:21,470
!ارحلا

158
00:10:22,740 --> 00:10:23,930
ذلك جانباً

159
00:10:24,630 --> 00:10:27,310
إنّها تبرز حيث تذهب بالفعل

160
00:10:27,310 --> 00:10:32,400
حتّى هذه الأمور الرياضيّة تلائمها

161
00:10:33,060 --> 00:10:34,400
...لحظة

162
00:10:34,910 --> 00:10:38,360
إنّها في مزاجٍ سيّئ لأنّها لا تزال
مُتضايقةً من نتيجة المسرحيّة؟

163
00:10:35,270 --> 00:10:38,360
لأنّي لا أتحلّى بالموهبة

164
00:10:39,170 --> 00:10:40,920
لا عجب

165
00:10:40,920 --> 00:10:42,830
،فمهما أبدت صلابةً

166
00:10:42,830 --> 00:10:45,330
لا بدّ أنّها جُرحت بعد الجدّية التي التزمت بها

167
00:10:49,090 --> 00:10:51,910
تقاتل ميزوهارا جاهدة

168
00:10:53,080 --> 00:10:55,120
!لا تواصل معي

169
00:10:55,120 --> 00:10:57,260
!لا تطفّل أو تجسّس أيضاً

170
00:10:57,260 --> 00:10:59,550
!نحن غريبان حتّى التخرّج

171
00:11:00,520 --> 00:11:01,700
أأنتِ مُتأكّدة؟

172
00:11:03,760 --> 00:11:07,530
من لقائي بشكل طبيعيّ

173
00:11:12,140 --> 00:11:15,290
لستَ غريب أطوار، فلا ضير

174
00:11:18,270 --> 00:11:20,460
ماذا؟ أأنا مُخطئة؟

175
00:11:20,460 --> 00:11:22,240
!ما-ما الذي تتكلّمين عنه؟

176
00:11:23,120 --> 00:11:26,510
خطر لي أنّ لا معنى الآن
للمبالاة بالأمر

177
00:11:26,510 --> 00:11:30,810
فلم تختر الانتقال للعيش بجواري

178
00:11:30,810 --> 00:11:33,640
ومن اللآمة أن أعاملك بتحجّر

179
00:11:34,520 --> 00:11:36,200
لنكن مُتساويين

180
00:11:36,570 --> 00:11:38,670
جارين بعدل

181
00:11:41,760 --> 00:11:43,520
لحظة

182
00:11:43,520 --> 00:11:45,890
كيف "جارين بعدل"؟

183
00:11:53,500 --> 00:11:55,370
!مرحى! دورة كاملة

184
00:11:55,370 --> 00:11:56,730
!مُـ-مُذهل

185
00:11:56,730 --> 00:11:58,190
!أرأيت؟

186
00:11:58,190 --> 00:12:00,330
!أصبتِها في المُنتصف تماماً

187
00:12:00,330 --> 00:12:01,440
يا لحظّه

188
00:12:01,440 --> 00:12:03,860
أريد مواعدة فتاة مثلها أيضاً

189
00:12:05,040 --> 00:12:06,240
!مهلاً، مهلاً

190
00:12:06,240 --> 00:12:07,720
اقتربتُ كثيراً

191
00:12:25,690 --> 00:12:27,060
...أنا

192
00:12:47,280 --> 00:12:50,870
!يا للألم الجميل

193
00:12:51,410 --> 00:12:54,670
مُصافحة علويّة مع ميزوهارا
خارج وقت عملها

194
00:12:54,670 --> 00:12:57,430
!كأنّه حُلم

195
00:13:00,760 --> 00:13:03,800
اسمع، هنالك مكانٌ آخر
أودّ الذهاب له

196
00:13:12,360 --> 00:13:14,190
...أ-أيمكن

197
00:13:14,190 --> 00:13:16,730
!عشاء معاً؟

198
00:13:19,000 --> 00:13:19,690
...مـ

199
00:13:19,690 --> 00:13:21,370
مستشفى؟

200
00:13:21,370 --> 00:13:25,490
أصرّت جدّتي على لقائك
دون أن تسمع بكلامي

201
00:13:25,820 --> 00:13:27,930
لم أرد أن نطل الزيارة

202
00:13:27,930 --> 00:13:32,450
لذا أضعتُ وقتاً حتّى بقاء 15 دقيقة
قبل انتهاء مواعيد الزيارة

203
00:13:29,360 --> 00:13:32,450
رجعت جدّها للمستشفى؟

204
00:13:33,060 --> 00:13:35,290
تريد لقائي؟ لمَ؟

205
00:13:35,880 --> 00:13:37,540
لكن كان عليّ أن أعرف

206
00:13:38,110 --> 00:13:41,100
كانت تضيع وقتاً لا أكثر
!في مركز ضرب الكرة

207
00:13:42,750 --> 00:13:45,920
!مرحباً يا كازويا-كن

208
00:13:45,920 --> 00:13:47,680
مـ-مرحباً

209
00:13:47,680 --> 00:13:49,420
فلتجلس

210
00:13:49,420 --> 00:13:51,610
هل تناولت العشاء؟

211
00:13:51,610 --> 00:13:52,640
كلا

212
00:13:52,640 --> 00:13:57,100
أعتذر، لا لديّ سوى خبز
وكرات أرزٍّ لأقدّمها لك

213
00:13:57,100 --> 00:13:59,420
تعطيني معاملةٌ مميّزة كالمُعتاد

214
00:13:59,420 --> 00:14:02,140
أتودّ شرب شيء؟ لا بدّ أنّك تشعر بالعطش

215
00:14:02,140 --> 00:14:03,440
لا-لا داعي

216
00:14:03,930 --> 00:14:06,760
صحيح، كانت هكذا

217
00:14:06,760 --> 00:14:08,660
لكن يسرّني أنّها تبدو بخير

218
00:14:08,660 --> 00:14:12,490
جدّتي، لم تستبدلي الماء في المزهريّة

219
00:14:12,490 --> 00:14:14,030
رغم أنّي ذكّرتكِ

220
00:14:14,030 --> 00:14:15,030
يا إلهي

221
00:14:16,160 --> 00:14:17,580
أخبرني يا كازويا-كن؟

222
00:14:17,880 --> 00:14:19,950
كيف حال الجامعة معك؟

223
00:14:19,950 --> 00:14:22,790
حسناً، كالمُعتاد

224
00:14:23,120 --> 00:14:26,670
أنت تأخذها بجدّية، أحسنت الصنيع

225
00:14:26,670 --> 00:14:27,670
...حـ

226
00:14:27,670 --> 00:14:29,070
حقّاً؟

227
00:14:29,070 --> 00:14:30,330
!أجل

228
00:14:29,380 --> 00:14:30,930
مهلاً يا جدّتي

229
00:14:32,180 --> 00:14:35,100
لا تتلصّقي بحبيبي

230
00:14:36,240 --> 00:14:37,960
ما المشكلة؟

231
00:14:37,960 --> 00:14:40,440
أنا أحب الفتيان

232
00:14:40,810 --> 00:14:41,900
يا إلهي

233
00:14:42,360 --> 00:14:46,280
ذلك طبيعيّ بما أنّنا
نتظاهر أنّنا حبيبين

234
00:14:46,280 --> 00:14:49,360
لكن سماعها تنطق بها
يجعل قلبي يخفق

235
00:14:49,360 --> 00:14:50,650
أيّاً يكن

236
00:14:51,880 --> 00:14:53,470
ماذا؟ أين تذهبين؟

237
00:14:53,470 --> 00:14:55,040
سأستبدل الماء

238
00:14:57,790 --> 00:15:00,320
كلّا، أصبحنا بمفردنا

239
00:15:00,320 --> 00:15:01,740
ها قد غادرت

240
00:15:02,880 --> 00:15:04,380
كازويا-كن

241
00:15:07,480 --> 00:15:10,010
أودّ طلب معروفٍ منك

242
00:15:13,400 --> 00:15:14,580
معروف؟

243
00:15:16,060 --> 00:15:17,940
ما هو؟

244
00:15:25,520 --> 00:15:27,230
ما هذا؟

245
00:15:27,230 --> 00:15:29,550
هل اكتشفت سرّنا؟

246
00:15:29,550 --> 00:15:33,540
مستحيل، لم نرتكب زلّةً... كما أظنّ

247
00:15:34,600 --> 00:15:37,040
لحظة، إنّها جدّة ميزوهارا

248
00:15:37,040 --> 00:15:40,340
قد تكون حادة البصيرة لحدٍّ مُخيف

249
00:15:42,370 --> 00:15:46,710
سمعتُ أنّك ذهبت لمشاهدة مسرحيّة تشيزورو

250
00:15:48,590 --> 00:15:50,090
أجل، صحيح

251
00:15:50,090 --> 00:15:53,390
كيف كانت؟ لم أستطع الذهاب ورؤيتها

252
00:16:00,000 --> 00:16:01,480
!كانت مُذهلة

253
00:16:01,480 --> 00:16:04,010
كانت تلمع

254
00:16:04,010 --> 00:16:06,890
ليست مثل تشيزورو-سان المُعتادة

255
00:16:06,890 --> 00:16:09,060
!كانت رائعةً بحقّ

256
00:16:09,800 --> 00:16:11,610
وأخبرتها بذلك؟

257
00:16:11,610 --> 00:16:14,570
ماذا؟ أجل، أخبرتُها

258
00:16:15,530 --> 00:16:18,660
بالأحرى، صرختُ وأخبرتها

259
00:16:19,290 --> 00:16:21,670
لا بدّ أنّ ذلك أسعدها

260
00:16:22,450 --> 00:16:27,280
فقد كانت تهوى التمثيل وتلقّي
الإطراء مُذ صغرها

261
00:16:27,760 --> 00:16:29,460
أحقّاً ذلك؟

262
00:16:31,140 --> 00:16:34,050
تشيزورو-سان مذهلةٌ بمعنى الكلمة

263
00:16:34,380 --> 00:16:36,740
إنّها قويّةٌ ومُتماسكة

264
00:16:37,470 --> 00:16:40,340
وتتحمّل عناء حاجتي لمساعدتها دوماً

265
00:16:45,150 --> 00:16:48,110
قويّة؟ تشيزورو؟

266
00:16:51,520 --> 00:16:55,080
لطالما كانت فتاةً كثيرة الاحتياج

267
00:16:55,080 --> 00:16:56,910
ماذا؟ تشيزورو-سان؟

268
00:16:59,060 --> 00:17:02,920
كان دائماً ما يُبكيها الأطفال
الأكبر سنّاً في الحيّ

269
00:17:02,920 --> 00:17:06,890
وتأتي لفراشي شاكيةً أنّها تشعر بالوحدة

270
00:17:06,890 --> 00:17:08,730
كانت طفلةً هكذا

271
00:17:10,820 --> 00:17:12,620
...كثيرة الاحتياج

272
00:17:12,620 --> 00:17:14,010
ميزوهارا؟

273
00:17:14,870 --> 00:17:16,650
كثيرة الاحتياج؟

274
00:17:18,170 --> 00:17:21,040
كازويا-سان، أشعر بفراغٍ داخلي

275
00:17:21,040 --> 00:17:25,100
تعالي، سأملؤكِ قدرما تحتاجين

276
00:17:25,620 --> 00:17:26,800
!كلا، كلا

277
00:17:26,800 --> 00:17:29,290
!ليس وقت هذه الخيالات

278
00:17:29,290 --> 00:17:31,240
وأنا مُسنّةٌ طاعنة في السنّ

279
00:17:31,240 --> 00:17:33,950
قد تحين مُنيتي غداً

280
00:17:34,880 --> 00:17:37,740
!أجل... سأموت غداً

281
00:17:37,740 --> 00:17:39,030
!مهلاً، أرجوك

282
00:17:39,370 --> 00:17:40,740
...ما الذي تقولينه فجأ

283
00:17:41,910 --> 00:17:44,030
!أمزح فقط

284
00:17:45,940 --> 00:17:48,900
!كانت تعابيرك مُضحكة

285
00:17:50,500 --> 00:17:52,590
!لا شيء يُضحك أبداً

286
00:17:52,990 --> 00:17:56,920
أرى أنّك تملك مؤهّلات
تحقيق نجاحٍ كبير

287
00:17:57,840 --> 00:18:01,260
حسناً... لا أدري لو أستطيع
الإيفاء بتوقّعاتك

288
00:18:01,850 --> 00:18:05,450
لا تقل ذلك، أنت قادر

289
00:18:05,450 --> 00:18:07,550
تظنّين ذلك؟

290
00:18:07,550 --> 00:18:10,880
أجل. أنا متأكّدةٌ أنّك
ستحقّق نجاحا كبيراً

291
00:18:10,880 --> 00:18:13,400
...نبرة كلامكِ مُقنعة

292
00:18:13,400 --> 00:18:19,430
كما من وجهة نظري، فأنت الأكثر قوّة

293
00:18:21,570 --> 00:18:25,400
لا أحد مثاليّ

294
00:18:25,400 --> 00:18:28,920
نضلّ طريقنا، ونرتكب أخطاءً

295
00:18:30,140 --> 00:18:33,870
،نتعلّم يقين ضعفنا وقلّة حيلتنا
،ونُخضع على ركبنا

296
00:18:33,870 --> 00:18:38,120
لكنّنا ننهض من جديد سعياً
للسعادة، مراراً وتكراراً

297
00:18:38,120 --> 00:18:41,180
هذه هي الحياة

298
00:18:41,610 --> 00:18:46,240
الخصلة التي يُزهر بها البشر
،هي أنّ رغم تأذّيهم بضعفهم

299
00:18:46,240 --> 00:18:51,520
يمكنهم أن يعترفوا بروعة
الآخرين ويقابلونهم بالتقدير

300
00:18:51,950 --> 00:18:55,260
تمكّنك من ذلك يُظهر
أنّ بستانك زاهر

301
00:18:55,260 --> 00:18:56,860
نجحتَ سلفاً

302
00:19:02,090 --> 00:19:07,290
تعاني تشيزورو في تقبّل نقاط ضعفها قليلاً

303
00:19:07,290 --> 00:19:13,920
تغطّي ذاتها الضعيفة بدرعٍ جليديّ
مُتظاهرةٌ بالقوّة فحسب

304
00:19:13,920 --> 00:19:17,300
من تلك الناحية، في مُمثلةٌ استثنائيّة

305
00:19:17,990 --> 00:19:20,430
لا شخص في العالم لا يشعر بالوحدة

306
00:19:20,870 --> 00:19:22,970
يجيد الكثيرون إخفاء الأمر فقط

307
00:19:23,590 --> 00:19:25,110
...ميزوهارا

308
00:19:26,330 --> 00:19:32,220
لكن يوماً ما، ستحتاج شخصاً يراها
ويتقبّلها على حقيقتها

309
00:19:34,080 --> 00:19:35,650
...لذا

310
00:19:39,080 --> 00:19:40,330
أتوسّل إليك

311
00:19:41,400 --> 00:19:47,910
أتوسّل إليك، كن ذاك السند لتشيزورو

312
00:19:53,410 --> 00:19:55,790
فهمت... بالطبع

313
00:19:56,530 --> 00:20:01,020
ميزوهارا هي الحفيدة العزيزة للجدّة سايوري

314
00:20:01,020 --> 00:20:03,760
لا تريد أن يواعدها شابٌ غير مُبالٍ

315
00:20:05,720 --> 00:20:10,360
لا يمكن أن أكون عديم المسؤولية
وأقول أنّي سأدعمها مدى الحياة

316
00:20:10,840 --> 00:20:13,300
...ما يسعني قوله

317
00:20:14,820 --> 00:20:15,940
أنا أحبّها

318
00:20:18,680 --> 00:20:21,490
!أنا أحبّ تشيزورو-سان من أعماقي

319
00:20:35,350 --> 00:20:37,900
سماع ذلك يكفيني

320
00:20:38,720 --> 00:20:40,910
!يمكنني أن أموت بسلامٍ غداً

321
00:20:40,910 --> 00:20:43,760
!كلا

322
00:20:44,950 --> 00:20:46,590
ما الذي تكلّمتما عنه؟

323
00:20:46,590 --> 00:20:48,570
لا-لا شيء

324
00:20:51,150 --> 00:20:53,270
حسناً، لا يهمّ

325
00:20:54,340 --> 00:20:57,670
ميزوهارا فتاةٌ وحيدة كثيرة الاحتياج

326
00:20:57,670 --> 00:20:59,360
لا يسعني تصديق هذا للآن

327
00:21:00,820 --> 00:21:04,090
ميزوهارا التي أعرفها
قويّةٌ بلا حدود

328
00:21:04,090 --> 00:21:08,280
،وهي من تقدّم العون للآخرين
لا أستطيع تصوّر تلقّيها له

329
00:21:12,040 --> 00:21:13,030
إلى اللقاء

330
00:21:13,960 --> 00:21:19,040
...لكن إن كان ذلك صحيحاً

331
00:21:15,360 --> 00:21:16,220
طابت ليلتك

332
00:21:17,040 --> 00:21:19,040
طابت ليلتكِ

333
00:21:19,780 --> 00:21:21,220
أريد مساندتها

334
00:21:22,680 --> 00:21:26,300
أريد مساعدتها، ولو لم أكن حبيبها

335
00:21:30,570 --> 00:21:34,410
...وثقت الجدّة سايوري بي، فلأجلها أيضاً

336
00:21:41,310 --> 00:21:46,330
لكن أيمكنني أن أصبح
ذاك الشاب لأجلها حقّاً؟

337
00:23:17,740 --> 00:23:21,530
كانت ميزوهارا ظريفةً جدّاً اليوم

338
00:23:25,680 --> 00:23:26,880
أجل؟

339
00:23:33,680 --> 00:23:36,460
ميزوهارا؟ ما الذي تريده؟

340
00:23:51,950 --> 00:23:55,340
فقدتُ مفتاحي

341
00:23:57,480 --> 00:24:01,020
لحظة يا تشيزورو-سان
!ما قصدكِ أنّكِ فقدتِ مفتاحك؟

342
00:24:01,020 --> 00:24:03,180
كما قلتُه

343
00:24:03,180 --> 00:24:06,840
أتتظاهرين بأنّكِ فقدتِه كي تدخلي
شقّة كازويا-كن

344
00:24:06,840 --> 00:24:09,640
وتطارحيه بأشكالٍ لا يمكن بثّها
حّتى في أنمي متأخّر العرض؟

345
00:24:09,640 --> 00:24:13,600
!أسيكون عزف آلة ساكسفون لا ينتهي؟

346
00:24:13,600 --> 00:24:15,200
روكا-تشان، هدّئي روغكِ

347
00:24:15,200 --> 00:24:19,520
إن حصل ذلك، فسأحجب بنفسي
!كلّ شيءٍ بأنوار بيضاء

348
00:24:19,520 --> 00:24:21,310
لكِ الحرّية

349
00:24:21,310 --> 00:24:22,460
:في الحلقة القادمة من استأجر حبيبة

350
00:24:22,460 --> 00:24:23,480
...عودة"

351
00:24:23,480 --> 00:24:24,350
"الحبيبة

352
00:24:24,350 --> 00:24:26,660
!لن أسمح بأيّ تعثرّات محظوظة أيضاً