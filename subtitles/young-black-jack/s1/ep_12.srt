1
00:00:01,270 --> 00:00:05,940
ساهمت حادثة جامعة طوكيو في ظهور
.نشاط سياسيّ طلاّبي في كلّ أنحاء البلاد

2
00:00:06,190 --> 00:00:10,940
،بعد أن داهمت شرطة مكافحة الشّغب قاعة ياسودا
.تضاءل النّشاط السّياسيّ الطّلابي بسرعة

3
00:00:12,030 --> 00:00:17,700
ومع ذلك، تبنّت مجموعة صغيرة من الطّلبة
.مذهبًا متطرّفًا وسعت لإحداث التّغيير عن طريق العنف

4
00:00:18,580 --> 00:00:21,280
،ولأنّهم ينظرون للنّشاط السّياسيّ كأنّه حرب

5
00:00:21,580 --> 00:00:26,830
فهؤلاء الطّلبة مستعدّون للقيام بعدّة حوادث عنيفة
.قادرة على هزّ كيان اليابان من جذوره خلال عهد شووا

6
00:02:05,980 --> 00:02:09,100
.يبدو أنّك جنيتَ الكثير هذا الشّهر

7
00:02:10,060 --> 00:02:12,980
هل تُجري عمليّات جراحيّة لجرّاحين أو ما شابه؟

8
00:02:13,360 --> 00:02:14,320
.بالطّبع لا

9
00:02:14,320 --> 00:02:17,990
فذلك يعني أنّي لن أتمكّن من الحصول
.على رخصة ممارسة الطّبّ

10
00:02:21,950 --> 00:02:27,000
لا يوجد هدف حقيقيّ
.وراء المعارك الدّائرة في فيتنام

11
00:02:27,580 --> 00:02:31,500
...ومع ذلك، قرّرت حكومتنا دخول هذه المواجهة

12
00:02:29,920 --> 00:02:31,500
.الشّرطة قادمة. اهربوا

13
00:02:31,500 --> 00:02:33,130
.مهلاً

14
00:02:39,970 --> 00:02:40,760
.إيري

15
00:02:42,090 --> 00:02:43,260
هازاما-سان؟

16
00:02:50,440 --> 00:02:52,270
.أنا سعيد لأنّه مجرّد التواء طفيف

17
00:02:54,440 --> 00:02:56,150
أرى أنّك لم تتوقّفي عن هذا، صحيح؟

18
00:02:56,150 --> 00:02:58,280
.يبدو أنّك أمسكت بي بالجرم المشهود

19
00:02:58,860 --> 00:03:02,280
.ستبلغين مرحلة في يوم ما لن تستطيعي العودة منها

20
00:03:03,030 --> 00:03:05,240
،لكن إن لم أقم بأيّ عمل فعليّ

21
00:03:05,240 --> 00:03:07,040
فذلك يعني أنّي لا أقوم بأيّ شيء، صحيح؟

22
00:03:08,370 --> 00:03:10,830
.سيختفي الانتفاخ مع الوقت

23
00:03:10,830 --> 00:03:11,540
.حسنًا

24
00:03:11,870 --> 00:03:13,960
هلّي أن أطلب منك معروفًا؟

25
00:03:18,920 --> 00:03:20,840
سأقوم بإسعافات أوّليّة فحسب، موافقة؟

26
00:03:20,840 --> 00:03:21,550
.نعم

27
00:03:25,390 --> 00:03:27,560
أصحيح أنّه يوجد طبيب هنا؟

28
00:03:30,810 --> 00:03:32,060
...أنت

29
00:03:33,400 --> 00:03:35,060
.سبق وتقابلنا من قبل

30
00:03:35,770 --> 00:03:36,940
أتعرفينه؟

31
00:03:36,940 --> 00:03:40,820
إنّه الرّجل الّذي أجرى عملية
.على دماغ ذلك الفارّ يا فوجي-سان

32
00:03:41,490 --> 00:03:42,360
.هذا سيّئ

33
00:03:42,360 --> 00:03:43,070
.سُحقًا

34
00:03:45,120 --> 00:03:46,490
.هذا يفوق إمكاناتي

35
00:03:46,490 --> 00:03:48,040
.خذوه إلى المستشفى

36
00:03:48,540 --> 00:03:50,540
.لم يُصب في فخده فحسب

37
00:03:50,540 --> 00:03:53,830
.بالنّظر إلى هذا الانتفاخ، فإنّ قصبة السّاق مكسورة أيضًا

38
00:03:54,330 --> 00:03:55,710
.سيحتاج لجراحة

39
00:03:55,710 --> 00:03:56,670
ماذا؟

40
00:03:57,090 --> 00:04:00,090
.لا أستطيع إجراء العمليّة. أنا لا أزال طالبًا

41
00:04:00,300 --> 00:04:01,840
.لا يمكنك التّحجّج بهذا الآن

42
00:04:01,840 --> 00:04:03,590
ألم تُجري جراحة دماغ؟

43
00:04:05,800 --> 00:04:08,350
.كن واثقًا أنّ ذلك لم يعد عليّ بأيّ نفع

44
00:04:10,270 --> 00:04:12,180
،إصابته ليست حرجة

45
00:04:12,180 --> 00:04:14,020
.وليس بحاجة لأن أقوم أنا بمعالجته

46
00:04:14,560 --> 00:04:16,860
.إيري، لا تتصرّفي بتهوّر

47
00:04:18,770 --> 00:04:20,860
.أنت لا تستحقّ أن تكون طبيبًا

48
00:04:22,110 --> 00:04:26,200
،إنّنا نقاتل لبناء أمّة مثاليّة

49
00:04:26,200 --> 00:04:28,870
.نقوم بذلك بينما تتسكّع أنت في الأرجاء

50
00:04:28,870 --> 00:04:33,000
لماذا قد يستحقّ شخص تخلّى عن مقاتلين من أمثالنا
أن يصبح طبيبًا؟

51
00:04:33,620 --> 00:04:35,960
من هذا الّذي يتسكّع في الأرجاء؟

52
00:04:36,460 --> 00:04:40,130
.لا تفرض رؤيتك للعالم عليّ وأنت تستعمل منطقًا مشوّهًا

53
00:04:47,640 --> 00:04:48,760
...إماغامي

54
00:04:48,760 --> 00:04:50,010
...أَوُياما-سان

55
00:04:54,180 --> 00:04:56,690
هل تعرفين ذلك المسمّى هازاما؟

56
00:04:56,690 --> 00:04:58,860
.لقد عالج لي هذه

57
00:04:58,860 --> 00:04:59,520
ماذا؟

58
00:04:59,940 --> 00:05:01,440
لا يمكنك ملاحظة شيء، صحيح؟

59
00:05:01,440 --> 00:05:05,070
.لقد قطّب جرحي بحرص شديد لكي يتجنّب ترك أيّ ندبة

60
00:05:05,860 --> 00:05:06,860
.فهمت

61
00:05:07,360 --> 00:05:08,820
،صحيح أنّه ليس شخصًا مثاليًّا

62
00:05:08,820 --> 00:05:11,290
.لكنّه شخص يملك قلبًا طيّبًا

63
00:05:11,740 --> 00:05:13,410
.لا تسمحي لنفسك بأن تنساق إليه

64
00:05:13,410 --> 00:05:16,290
.إنّنا نعيش في عالم مختلف تمامًا عن الّذي يعيش هو فيه

65
00:05:17,330 --> 00:05:18,630
...معك حقّ

66
00:05:18,960 --> 00:05:21,750
.كما أنّ لدينا مهمّة

67
00:05:22,210 --> 00:05:23,550
تفهمين، صحيح؟

68
00:05:40,230 --> 00:05:42,320
.لا تتصرّفي بتهوّر

69
00:05:58,870 --> 00:05:59,630
..هازاما-سا

70
00:06:00,670 --> 00:06:02,000
.أنا آسفة

71
00:06:02,000 --> 00:06:03,380
.لقد حسبتُك شخصًا آخر

72
00:06:03,960 --> 00:06:05,380
هل أنت صديقة لهازاما-كُن؟

73
00:06:05,880 --> 00:06:07,380
...كلاّ، أنا

74
00:06:07,840 --> 00:06:10,300
.إنّه يتواجد هنا أحيانًا

75
00:06:10,300 --> 00:06:12,390
.ربّما لديه فصل تطبيقي الآن

76
00:06:12,390 --> 00:06:15,060
.لا بدّ أنّه مشغول لأنّه على وشك أن يتخرّج

77
00:06:15,060 --> 00:06:16,640
.فهمت

78
00:06:16,640 --> 00:06:18,890
.أظنّ أنّه سيكون متفرّغًا عند غروب الشّمس

79
00:06:19,270 --> 00:06:20,560
.حسنًا، لا بأس

80
00:06:20,560 --> 00:06:22,560
.كنتُ مارّة من هنا فحسب

81
00:06:24,570 --> 00:06:28,740
.يسير هازاما-سان في طريقه الخاصّ

82
00:06:40,920 --> 00:06:42,460
.ستكون العمليّة التّالية بعد ثلاثة أيّام

83
00:06:43,090 --> 00:06:45,250
.أريدك أن تقوم بعملية استبدال صمّامٍ اصطناعيّ

84
00:06:50,220 --> 00:06:51,470
.تفضّل القهوة

85
00:06:51,760 --> 00:06:53,680
.شكرًا يا سينباي

86
00:06:53,680 --> 00:06:56,270
.يبدو أنّك تتواجد كثيرًا في المستشفى مؤخّرًا

87
00:06:56,270 --> 00:06:57,680
ما الّذي تفعله هناك؟

88
00:06:58,060 --> 00:07:01,480
.طُلب منّي أن أقدّم المساعدة في أبحاث أطبّاء آخرين

89
00:07:01,810 --> 00:07:04,400
.يمكنكِ أن تقولي أنّه عملٌ بدوام جزئيّ

90
00:07:05,520 --> 00:07:08,030
.كم هي الأمور سهلة بالنّسبة لطلبة لائحة الشّرف

91
00:07:09,700 --> 00:07:14,990
.بالمناسبة، تحدّثتُ إلى فتاة تعرفك في الممرّ

92
00:07:15,490 --> 00:07:16,370
فتاة؟

93
00:07:16,370 --> 00:07:19,710
.نعم، كان لديها شعر قصير وعينان كبيرتان

94
00:07:19,710 --> 00:07:20,500
.أجل

95
00:07:21,040 --> 00:07:23,880
.هذا غريب. أنت لا تعرف الكثير من الفتيات

96
00:07:24,840 --> 00:07:28,010
.التقينا في حادثة هانيدا الأولى على ما أظنّ

97
00:07:28,960 --> 00:07:32,180
كانت هنالك مواجهة عنيفة بين المتظاهرين
.وشرطة مكافحة الشّغب

98
00:07:32,180 --> 00:07:35,760
.كان المكان بأكمله ممتلئًا بكلوريد الفيناسايل

99
00:07:36,600 --> 00:07:38,310
.يا للرّائحة الكريهة

100
00:07:47,690 --> 00:07:51,030
.سيترك هذا الجرح ندبة إن لم أفعل شيئًا حياله

101
00:08:03,460 --> 00:08:07,130
.أصبحت تأتي لزيارتي من حين لآخر مذّاك الوقت

102
00:08:07,590 --> 00:08:09,380
.تأتي أحيانًا وبرفقتها شخص آخر مصاب

103
00:08:09,380 --> 00:08:11,970
.وفي أوقات أخرى تكون هي المصابة

104
00:08:13,180 --> 00:08:15,090
.أنا متفاجئة لأنّك تعرفها كلّ هذا الوقت

105
00:08:16,050 --> 00:08:17,850
.إنّها مريضة تستحقّ أن أتذكّرها

106
00:08:17,850 --> 00:08:18,890
ما...؟

107
00:08:18,890 --> 00:08:19,770
.لا شيء

108
00:08:24,560 --> 00:08:26,360
.انظري، لقد أزلتُ جميع القطب

109
00:08:26,560 --> 00:08:28,020
!هذا مذهل

110
00:08:28,020 --> 00:08:29,860
.لا أكاد أرى أيّة ندوب

111
00:08:30,320 --> 00:08:34,150
.ظننتُ أنّي سأحصل على ندوب طوال حياتي

112
00:08:34,150 --> 00:08:36,110
.أنت عبقريّ يا هازاما-سان

113
00:08:36,530 --> 00:08:38,870
.ستصبح النّدوب غير واضحة أكثر بعد شهر آخر

114
00:08:39,160 --> 00:08:40,830
.صحيح، أحتاج لأدفع لك أجرك

115
00:08:42,870 --> 00:08:44,160
.أنا مجرّد طالب

116
00:08:44,160 --> 00:08:45,040
...لم أكن أتوقّع أيّ

117
00:08:45,040 --> 00:08:45,750
.تفضّل

118
00:08:45,750 --> 00:08:47,380
.أنا إماغامي إيري

119
00:08:47,380 --> 00:08:49,000
.سررتُ بمعرفتك

120
00:09:06,100 --> 00:09:09,230
.سنخوض تدريبًا عسكريًّا هنا

121
00:09:09,230 --> 00:09:10,690
.وذلك لنصبح أقوى محاربي اليابان

122
00:09:11,110 --> 00:09:14,700
.ونبدأ ثورة ستغيّر مجتمع اليابان الجامد

123
00:09:17,030 --> 00:09:19,700
.أريد تحقيق شيء ما أنا أيضًا

124
00:09:42,510 --> 00:09:43,220
.شكرًا لك

125
00:09:46,690 --> 00:09:47,600
إيري؟

126
00:09:48,940 --> 00:09:51,230
هازاما-سان، كيف حالك؟

127
00:09:51,690 --> 00:09:55,240
آسفة لأنّي فرضتُ نفسي عليك
.عندما التقينا في المظاهرة

128
00:09:55,650 --> 00:09:58,740
.لطالما قدّمت لي يد العون

129
00:10:08,250 --> 00:10:10,460
.شكرًا لك على كلّ شيء فعلته من أجلي

130
00:10:10,460 --> 00:10:12,380
.أتمنّى أن تصبح طبيبًا ماهرًا

131
00:10:12,380 --> 00:10:16,010
تقوم الشّرطة بتحرّكات للقيام بعملية مسح
.لكلّ قواعد المتطرّفين المختبئين في المناطق الجبليّة

132
00:10:16,420 --> 00:10:22,010
...يُعتقد أنّ أولئك الطّلبة المختبئون لديهم أسلحة بحوزتهم

133
00:10:25,720 --> 00:10:26,730
...غونما

134
00:10:33,980 --> 00:10:39,030
.مكتب بريد نيهارو، مكتب بريد نيهارو

135
00:11:14,560 --> 00:11:15,480
من هناك؟

136
00:11:16,020 --> 00:11:17,860
لماذا أنت هنا؟

137
00:11:24,660 --> 00:11:25,490
.توقّف

138
00:11:25,490 --> 00:11:26,580
.لا تتحرّك

139
00:11:28,620 --> 00:11:29,790
من ذاك؟

140
00:11:34,960 --> 00:11:36,130
...أنت

141
00:12:11,750 --> 00:12:13,000
ما الّذي فعلتموه؟

142
00:12:13,580 --> 00:12:14,830
ما الّذي فعلتموه بها؟

143
00:12:15,540 --> 00:12:18,340
ما الّذي تفعلونه هنا؟

144
00:12:20,960 --> 00:12:21,550
...إ

145
00:12:21,550 --> 00:12:23,090
...إماغامي

146
00:12:24,930 --> 00:12:25,470
...إماغامي قد

147
00:12:25,470 --> 00:12:26,600
.أَوُياما

148
00:12:27,390 --> 00:12:31,220
،قامت إماغامي بما لا يُمكن وصفه
،لقد رفضت أن "تُربّي" أَوُياما

149
00:12:31,220 --> 00:12:35,480
.ومعارضتها للأفعال الّتي علينا الالتزام بها في ثورتنا

150
00:12:36,310 --> 00:12:37,940
...لقد دافعت عنّي

151
00:12:38,610 --> 00:12:40,690
.لهذا السّبب عانت أسوء منّي

152
00:12:44,320 --> 00:12:47,660
.لم تكن جاهزة لتكون أحد جنود الثّورة

153
00:12:47,660 --> 00:12:49,700
."لهذا السّبب كان علينا أن "نربّيها

154
00:12:53,160 --> 00:12:54,660
.ستكون حياتها في خطر إن لم نسرع

155
00:12:55,420 --> 00:12:56,960
ما الّذي تظنّ نفسك فاعلاً؟

156
00:12:57,420 --> 00:12:58,960
.سآخذها للمستشفى

157
00:12:58,960 --> 00:13:00,210
.ليساعدني أحدكم

158
00:13:00,590 --> 00:13:05,550
تعتقد أنّنا سنسمح لك بالذّهاب
بعد أن عرفتَ أين توجد قاعدة عمليّاتنا؟

159
00:13:09,350 --> 00:13:12,140
....خذوها للمستشفى وإلاّ

160
00:13:14,730 --> 00:13:16,060
.هذا يكفي

161
00:13:22,440 --> 00:13:24,990
أهذه فعلاً الثّورة الّتي كنتم تسعون إليها؟

162
00:13:25,400 --> 00:13:28,700
.كلّ ثانية تمرّ تجعلها أقرب للموت

163
00:13:29,700 --> 00:13:32,490
ألا تهتمّون لِما قد يحدث لرفاقكم؟

164
00:13:34,200 --> 00:13:35,790
،إذا ما ماتت إماغامي بسبب هذا

165
00:13:35,790 --> 00:13:40,500
فكلّ ما سيعنيه ذلك هو أنّها لم تكن
.أهلاً لتصبح جنديّة للثّورة

166
00:13:40,880 --> 00:13:42,000
ما الّذي قلتَه؟

167
00:13:42,500 --> 00:13:44,260
.لكنّ موتها لن يكون هباءً

168
00:13:44,670 --> 00:13:48,180
،موت أصدقائنا سيشكّل أساس صراعنا

169
00:13:48,180 --> 00:13:50,010
.وسيُمسي رمزًا لثورتنا بحدّ ذاتها

170
00:13:51,010 --> 00:13:52,260
.كفاك هراءً

171
00:13:52,640 --> 00:13:54,770
ألا تعني لكم الحياة شيئًا؟

172
00:13:55,100 --> 00:14:00,560
تعتقدون أنّ كلّ شيء مسموح ما دمتم تمتلكون مُثُلاً
وتصرخون مصرّحين بأنّكم تقودون ثورة؟

173
00:14:02,070 --> 00:14:04,990
...أنا فقط لم أكن أريد أن أضيّع تضحيةَ إماغامي

174
00:14:04,990 --> 00:14:06,490
.إنّها لا تزال حيّة تُرزق

175
00:14:07,240 --> 00:14:08,240
...لكن

176
00:14:09,280 --> 00:14:10,740
.لن أسمح بموتها

177
00:14:11,160 --> 00:14:12,990
.سأجري لها جراحة الآن وفي هذا المكان

178
00:14:15,500 --> 00:14:17,500
لا يمكن أن تكون جادًّا. هاهنا؟

179
00:14:17,500 --> 00:14:18,580
.هذا صحيح

180
00:14:18,580 --> 00:14:22,250
.لن أسمح لها بأن تُمسيَ "أساسًا" لصراعكم

181
00:14:23,960 --> 00:14:26,010
...فوجي-سان، إنّ إماغامي

182
00:14:28,590 --> 00:14:30,140
.إنّها تدخل حالة صدمة

183
00:14:30,140 --> 00:14:31,390
.فُكّ وثاقي

184
00:14:31,930 --> 00:14:33,390
.افعل ما يُمليه عليك رجاءً

185
00:14:33,390 --> 00:14:36,430
.قد يكون قادرًا على إنقاذ إماغامي

186
00:14:36,430 --> 00:14:38,390
،إن تركتموها تموت

187
00:14:38,390 --> 00:14:40,650
.ستصبحون جميعكم قتلة

188
00:14:40,650 --> 00:14:41,940
قتلة؟

189
00:14:44,440 --> 00:14:46,150
.ا-افعلوا ما يحلوا لكم

190
00:14:46,690 --> 00:14:49,450
.أحضروا لي كلّ الملاءات والمناشف الّتي لديكم

191
00:14:49,450 --> 00:14:52,780
.المطهّرات والضّمادات والشّاش وكلّ شيء

192
00:14:52,780 --> 00:14:54,910
.وجهّزوا لي أكبر قدر من الإضاءة تستطيعون توفيره

193
00:14:56,370 --> 00:14:57,750
ما هي فصيلة دم إيري؟

194
00:14:57,750 --> 00:14:59,250
.مثلي تمامًا ،B+ إنّها

195
00:14:59,250 --> 00:15:00,330
هل ستفي دمائي بالغرض؟

196
00:15:00,330 --> 00:15:01,790
.نعم، ستفي

197
00:15:06,590 --> 00:15:07,760
...إماغامي

198
00:15:08,130 --> 00:15:09,170
ما الّذي يحدث؟

199
00:15:09,720 --> 00:15:13,390
واضح أنّها أصيبت بحالة الصّدر المدمّى
.جرّاء الأضلاع المكسورة

200
00:15:13,760 --> 00:15:15,180
،إن لم نتعامل مع الأمر الآن

201
00:15:15,470 --> 00:15:18,180
ستتطوّر الحالة إلى فشل في التّنفّس
،وتدخل صدمة ناجمة عن النّزيف

202
00:15:18,180 --> 00:15:19,560
.ممّا قد يؤدّي بها للموت

203
00:15:19,560 --> 00:15:20,190
،إضافة لذلك

204
00:15:20,560 --> 00:15:23,690
فهي تعاني من إصابات على مستوى
،الأنف وعظام الوجنتين

205
00:15:23,690 --> 00:15:25,150
،وكسرٍ مداريّ

206
00:15:25,150 --> 00:15:27,940
.وضرر في كبدها وأعضاء أخرى

207
00:15:30,360 --> 00:15:33,450
،هذه هي النّتيجة النّهائيّة للعنف الّذي طبّقتموه عليها

208
00:15:33,450 --> 00:15:35,200
."تحت اسم "التّربية

209
00:15:40,210 --> 00:15:42,210
.سوف أنقذك حتمًا

210
00:16:33,630 --> 00:16:34,760
.انتهت العملية

211
00:16:47,770 --> 00:16:49,270
هازاما-سان؟

212
00:16:49,610 --> 00:16:50,650
.لا تتكلّمي

213
00:16:50,650 --> 00:16:52,280
.أجريتُ عملية لك للتّوّ

214
00:16:52,280 --> 00:16:53,950
عمليّة؟

215
00:16:54,700 --> 00:16:56,070
.أبليتِ حسنًا

216
00:16:56,530 --> 00:16:58,910
.سأذهب لإحضار بعض المسكّنات والمضادّات الحيويّة

217
00:17:00,120 --> 00:17:01,410
.لا بدّ وأنّك تمزح

218
00:17:01,830 --> 00:17:03,870
تعتقد أنّ بإمكانك الخروج من هنا بكلّ بساطة؟

219
00:17:04,620 --> 00:17:05,670
.هنالك عملية مسح

220
00:17:05,830 --> 00:17:07,080
.الشّرطة قادمة

221
00:17:07,080 --> 00:17:08,210
ماذا؟

222
00:17:13,130 --> 00:17:14,220
.لا فائدة

223
00:17:14,220 --> 00:17:14,920
.فات الأوان

224
00:17:18,390 --> 00:17:19,180
.سُحقًا

225
00:17:19,800 --> 00:17:22,180
.ضعوا أسلحتكم أرضًا واستسلموا

226
00:17:27,190 --> 00:17:29,060
.سنُشكّل حاجزًا هنا نحن أيضًا

227
00:17:42,870 --> 00:17:43,830
.لا تُطلقوا النّار

228
00:17:44,080 --> 00:17:44,950
.توقّفوا

229
00:17:44,950 --> 00:17:47,080
.لا تطلقوا، هنالك مصابون هنا

230
00:17:47,080 --> 00:17:47,830
.أيّها الوغد

231
00:17:47,830 --> 00:17:49,080
.ابتعد عن طريقي

232
00:17:50,790 --> 00:17:52,090
.أبقياه أرضًا

233
00:17:52,800 --> 00:17:53,840
.الآن

234
00:17:55,010 --> 00:17:56,010
.أفلتاني

235
00:17:56,010 --> 00:17:57,090
.أنا آسف

236
00:18:03,810 --> 00:18:05,350
...عليّ لإيقافهم

237
00:18:07,350 --> 00:18:08,480
.إماغامي

238
00:18:09,060 --> 00:18:09,900
إيري؟

239
00:18:09,900 --> 00:18:11,230
.كلاّ. عليك أن تبقي مستلقية

240
00:18:14,940 --> 00:18:16,110
...عليّ إيقافهم

241
00:18:16,110 --> 00:18:17,740
.كلاّ يا إماغامي

242
00:18:24,790 --> 00:18:25,370
.غبيّة

243
00:18:25,370 --> 00:18:26,250
.لا تقتربي من هنا

244
00:18:27,330 --> 00:18:29,830
...لنوقف هذا

245
00:18:29,830 --> 00:18:31,250
...لنوقف هذا في الحال

246
00:18:34,050 --> 00:18:34,800
.كلاّ

247
00:18:34,800 --> 00:18:35,760
.لا تخرجي

248
00:18:35,760 --> 00:18:37,720
.ابتعدي

249
00:19:09,370 --> 00:19:10,790
لِمَ؟

250
00:19:11,370 --> 00:19:12,960
.إماغامي

251
00:19:17,760 --> 00:19:18,840
...آسفة

252
00:19:19,170 --> 00:19:21,510
...بعد كلّ ما تكبّدتَه لمعالجتي

253
00:19:22,050 --> 00:19:23,800
...أُصبتُ ثانية

254
00:19:24,850 --> 00:19:26,060
.لا بأس

255
00:19:26,470 --> 00:19:27,560
...سأعالجك في الحال

256
00:19:30,890 --> 00:19:34,560
لا بدّ وأنّي في حالة يرثى لها، صحيح؟

257
00:19:35,360 --> 00:19:36,650
.لا تقلقي

258
00:19:37,230 --> 00:19:39,280
.سأعالجك مرّة تلو الأخرى

259
00:19:40,740 --> 00:19:44,160
...في المرّة القادمة، عليّ أن أعطيك أجرًا محترمًا

260
00:19:44,740 --> 00:19:48,580
...وليس قلادة... مستعملة

261
00:19:49,250 --> 00:19:53,330
.كلاّ، لا زلتُ أحتفظ بتلك القلادة

262
00:19:54,170 --> 00:19:56,090
...إنّها أوّل تذكار لي

263
00:19:57,210 --> 00:19:58,590
أوّل تذكار؟

264
00:19:59,840 --> 00:20:01,090
،بصراحة

265
00:20:01,420 --> 00:20:06,600
.كنتِ أوّل شخص أقطّب له جروحه

266
00:20:07,970 --> 00:20:10,180
كانت تلك أوّل مرّة لك؟

267
00:20:11,310 --> 00:20:17,360
...عرفتُ أنّك... عبقريّ حقيقيّ

268
00:20:38,130 --> 00:20:43,630
،إنّه طالب طبّ في جامعة هونغوشي
.وقد كان يعرف إماغامي إيري الرّاحلة معرفة شخصيّة

269
00:20:43,630 --> 00:20:46,010
.لا يملك أيّة علاقة بالمتطرّفين

270
00:20:46,430 --> 00:20:47,430
.هكذا إذًا

271
00:20:48,600 --> 00:20:49,930
.أطلقوا سراحه

272
00:20:55,900 --> 00:20:58,730
.أصبحتَ طبيبًا متدرّبًا أخيرًا

273
00:20:58,730 --> 00:21:00,940
يمكنك الآن أن تبدأ بجمع الأموال
.الحقيقيّة دون الحاجة لهذه السّرّيّة

274
00:21:01,900 --> 00:21:04,070
أتريدني أن أقترح عليك بعض الصّفقات المربحة؟

275
00:21:04,530 --> 00:21:06,950
.ستكون أشياء تابعة للسّوق السّوداء بالطّبع

276
00:21:07,450 --> 00:21:08,990
.لا داعي لذلك

277
00:21:09,370 --> 00:21:11,950
ستأتيني هذه الحالات حتّى
.دون أن أطلب مساعدة أيّ أحد

278
00:21:12,660 --> 00:21:14,660
.يبدو أنّ هذا هو قدري

279
00:21:15,670 --> 00:21:18,290
...هازاما، أنت

280
00:21:25,010 --> 00:21:28,260
.العبء الّذي تحملهُ ظُلمةٌ حالكة

281
00:21:29,390 --> 00:21:32,600
...فساد المجال الطّبّيّ الّذي كافحه لوقت طويل

282
00:21:32,600 --> 00:21:35,850
قسوة الحكومة الّتي من المفترض
...أن يكون هدفها حماية النّاس

283
00:21:35,850 --> 00:21:38,350
...التّخلّي عن قيمة حياة الإنسان

284
00:21:38,350 --> 00:21:43,480
قد يكون هازاما قد عرف أعمق ما في اليأس
.خلال سنوات حياته كطالب

285
00:21:49,950 --> 00:21:52,240
.ومع ذلك، سأستمرّ في معالجة النّاس

286
00:21:53,870 --> 00:21:55,750
.سيساعدني ذلك على الاستمرار في المضيّ قدُمًا

287
00:22:01,790 --> 00:22:05,590
،مع الوقت، تخلّيتُ عن اسم هازاما كوروو

288
00:22:06,050 --> 00:22:07,930
.وأصبحتُ جاك الأسود

289
00:23:40,000 --> 00:23:49,880
إلى اللقاء في أعمال أخرى مع تحيات أرض الأنمي