.بالنّظر إلى الضّرر الّذي لحِق الأعضاء

203
00:14:26,510 --> 00:14:28,590
،خلال دخولها للجسد

204
00:14:28,590 --> 00:14:31,140
.لا تأخذ الرّصاصات مسارًا مستقيمًا بالضّرورة

205
00:14:31,720 --> 00:14:36,680
مرجّح أكثر أن تأخذ مسارًا ملتويًا
.لأنّها تصيب العظام والأعضاء

206
00:14:40,560 --> 00:14:42,440
.سأذهب لإخبار الأطبّاء

207
00:14:42,940 --> 00:14:44,440
.جِدي بوب

208
00:14:44,440 --> 00:14:45,190
.حاضرة

209
00:14:50,070 --> 00:14:52,320
.حسنًا يا ستيف

210
00:14:52,320 --> 00:14:54,450
.لنعد لديارنا في أمريكا

211
00:14:59,120 --> 00:15:01,540
.الوضع أسوأ ممّا ظننت

212
00:15:02,330 --> 00:15:03,170
.لدينا حالة طارئة

213
00:15:03,460 --> 00:15:04,420
!ما الّذي تظنّ نفسك فاعلاً؟

214
00:15:04,420 --> 00:15:06,170
.سوف تلوّث هذه الغرفة

215
00:15:06,170 --> 00:15:07,460
.اخرج في الحال

216
00:15:07,800 --> 00:15:09,880
.ما سأقوله أكثر أهمّيّة

217
00:15:09,880 --> 00:15:13,970
.أمر بوب بتنفيذ هجوم جوّيّ على هذه القرية

218
00:15:13,970 --> 00:15:17,470
.ستتعرّض هذه القرية لهجوم قنابل بعد نصف ساعة

219
00:15:17,470 --> 00:15:18,520
إذًا؟

220
00:15:19,770 --> 00:15:21,100
ما الّذي لا تفهمونه؟

221
00:15:21,100 --> 00:15:23,360
.سيصبح هذا المكان بأكمله بحرًا من ألسنة اللّهب

222
00:15:23,360 --> 00:15:25,230
.هذا مفروغ منه

223
00:15:25,980 --> 00:15:29,240
.اذهب إلى بقيّة القرويّين وأخبرهم بالفرار

224
00:15:29,440 --> 00:15:31,740
ولكن، ماذا عنكم يا رفاق؟

225
00:15:32,200 --> 00:15:33,620
نحن؟

226
00:15:33,620 --> 00:15:36,450
.صحيح، لنتحقّق من الأمر الآن

227
00:15:37,370 --> 00:15:39,700
هل علينا الهرب؟

228
00:15:40,040 --> 00:15:43,040
.إن هربنا بالطبع، فسيموت هذا المريض

229
00:15:43,540 --> 00:15:47,800
.بالطّبع لا يمكننا

230
00:15:52,130 --> 00:15:53,760
.هذا صحيح

231
00:15:53,760 --> 00:15:55,300
.سنُنهي هذه العمليّة حتّى النّهاية

232
00:15:56,430 --> 00:15:58,310
.أنتم أشخاصٌ رائعون

233
00:15:58,470 --> 00:15:59,680
.نحن لسنا أيّ أشخاص

234
00:16:00,060 --> 00:16:00,810
.نحن أطبّاء

235
00:16:03,400 --> 00:16:07,480
.حسنًا، سأذهب لإخبار القرويّين

236
00:16:08,650 --> 00:16:12,070
،إذًا، لم تعد هذه العمليّة حرجة فحسب

237
00:16:12,700 --> 00:16:15,820
.بل أصبح لدينا وقت محدّد لإنهائها

238
00:16:16,780 --> 00:16:19,660
.سأهتم بأمر النّزيف من الشّريان المَساريقيّ العلويّ

239
00:16:19,660 --> 00:16:22,330
لكنّك لم تحصل على ترخيصك بعد، صحيح؟

240
00:16:23,710 --> 00:16:25,080
!وماذا في ذلك؟

241
00:16:28,840 --> 00:16:30,840
.حسنًا، سأدع الأمر لك

242
00:16:34,300 --> 00:16:39,850
.ستيف، لنأكل شريحة لحم دسمة عندما نعود لأمريكا

243
00:16:40,600 --> 00:16:43,850
...سأتركك تأكل أيّ عدد من الشّرائح تريده

244
00:16:44,190 --> 00:16:46,690
.بوب

245
00:16:46,690 --> 00:16:47,610
.اهربوا

246
00:16:48,310 --> 00:16:50,860
.ستكون القوّات الجوّيّة هنا قريبًا
.أسرعوا

247
00:16:51,150 --> 00:16:53,860
.اهربوا بعيدًا من القرية نحو الغابة، الآن

248
00:16:54,280 --> 00:16:55,160
.سحقًا

249
00:16:55,160 --> 00:16:57,120
.القولون النّازل متضرّر أيضًا

250
00:16:57,660 --> 00:17:00,490
هل انحرفت الرّصاصة بسبب العمود الفقريّ؟

251
00:17:01,490 --> 00:17:03,580
.علينا إعادة ترميم الأمعاء

252
00:17:03,580 --> 00:17:05,040
.إبرة وخيط بقياس 3-0

253
00:17:05,040 --> 00:17:05,870
.حسنًا

254
00:17:06,250 --> 00:17:09,880
.سأهتمّ بضرر الكبد والنّزيف الوريديّ

255
00:17:10,210 --> 00:17:11,630
.لك ذلك

256
00:17:11,630 --> 00:17:15,130
.لكن لا مجال للخطأ هنا

257
00:17:16,300 --> 00:17:18,890
.لإنّه مريضي

258
00:17:19,100 --> 00:17:20,930
.وكأنّي قد أقترف خطئًا هنا

259
00:17:20,930 --> 00:17:23,390
.إنّه مريضي قبل كلّ شيء

260
00:17:23,730 --> 00:17:25,140
.مستحيل

261
00:17:25,140 --> 00:17:26,140
.إنّه مريضي

262
00:17:26,520 --> 00:17:28,900
.كلاّ، مريضي

263
00:17:29,310 --> 00:17:32,530
.صحيح، إنّه مريضنا

264
00:17:32,530 --> 00:17:34,190
.ولسوفَ ننقذه حتمًا

265
00:17:40,370 --> 00:17:41,830
...هذا الاثنان

266
00:17:41,830 --> 00:17:43,910
.يا لها من تقنيات وسرعة

267
00:17:44,540 --> 00:17:48,170
،ربّما أنا أتشارك جراحة مع جرّاحَيْن

268
00:17:48,170 --> 00:17:51,630
.سيصبحان قائدين مشهورين في المجال الطّبّيّ

269
00:17:55,260 --> 00:17:56,340
.أسرعوا

270
00:17:56,340 --> 00:17:57,340
.بوب ليس هنا

271
00:17:58,090 --> 00:17:59,180
!كيف حال آين؟

272
00:17:59,180 --> 00:18:00,720
.إنّهم مستمرّون بالجراحة

273
00:18:00,720 --> 00:18:01,930
.وعلينا أن نثق بهم

274
00:18:18,400 --> 00:18:20,620
.أمعاء مستأصلة

275
00:18:20,620 --> 00:18:21,700
.ملاقط

276
00:18:22,120 --> 00:18:23,950
.اسمعا، ليس لدينا شاشٌ كافٍ

277
00:18:24,540 --> 00:18:25,870
.لديّ القليل منه هنا، استعملها

278
00:18:26,410 --> 00:18:28,040
.نسبة الغلوكوز في دمه مرتفعة للغاية

279
00:18:28,460 --> 00:18:30,130
.لنحقنه بالمزيد من محلول رينغر

280
00:18:31,080 --> 00:18:32,340
.ثلاثون

281
00:18:33,090 --> 00:18:34,800
.انتهت عملية التّرميم

282
00:18:35,090 --> 00:18:37,880
.حسنًا، سأبدأ بترميم الصّفاق

283
00:18:38,380 --> 00:18:39,720
.نكاد ننتهي هنا

284
00:18:39,970 --> 00:18:40,970
ماذا عنك يا هازاما؟

285
00:18:40,970 --> 00:18:42,220
.موضع واحد أخير

286
00:18:51,480 --> 00:18:52,560
...عشرون

287
00:18:55,940 --> 00:18:57,490
!ألم ينتهوا بعد؟

288
00:18:58,650 --> 00:18:59,740
...عشرة

289
00:19:01,240 --> 00:19:02,740
.قُطبة واحدة أخيرة

290
00:19:03,120 --> 00:19:04,240
...أربعة

291
00:19:04,240 --> 00:19:04,990
...ثلاثة

292
00:19:05,330 --> 00:19:06,410
...اثنان

293
00:19:06,410 --> 00:19:07,250
.واحد

294
00:19:07,450 --> 00:19:09,000
.حسنًا، انتهيت

295
00:19:22,590 --> 00:19:24,100
.لم ينتهوا في الوقت المناسب

296
00:19:24,430 --> 00:19:25,930
...لا يعقل

297
00:19:38,190 --> 00:19:39,190
.هناك

298
00:19:47,490 --> 00:19:48,910
...إنّهم

299
00:19:48,910 --> 00:19:50,000
...مستحيل

300
00:20:09,720 --> 00:20:11,060
.إنّهم أحياء

301
00:20:13,100 --> 00:20:14,810
!مرحى

302
00:20:28,580 --> 00:20:29,910
.شكرًا على مساعدتك

303
00:20:29,910 --> 00:20:32,370
.يا لك من محبّ لفعل الخير

304
00:20:32,750 --> 00:20:36,580
.هازاما، أسرع واحصل على رخصتك

305
00:20:36,580 --> 00:20:40,000
.وبعدها أنقذ المزيد من الأرواح

306
00:20:40,960 --> 00:20:41,840
.حسنًا

307
00:20:42,170 --> 00:20:45,510
،بتُ أفهم سبب بقائك في فيتنام يا يابو-سان

308
00:20:45,510 --> 00:20:47,390
.ولكن، كن حذرًا

309
00:20:47,390 --> 00:20:49,720
.انظروا من يتكلّم

310
00:20:49,720 --> 00:20:54,810
عليك أن تقول هذا الكلام لذلك
...الطبيب الّذي نزل بالمظلّة

311
00:20:54,810 --> 00:20:55,730
ماذا؟

312
00:20:55,730 --> 00:20:56,600
ما الخطب؟

313
00:20:56,940 --> 00:21:01,150
.أدركتُ للتّوّ أنّي لا أعرف اسم ذلك الطبيب

314
00:21:01,730 --> 00:21:03,150
،بالحديث عن الأمر

315
00:21:03,150 --> 00:21:05,410
.كلّ ما أعرفه هو أنّه طبيب

316
00:21:16,500 --> 00:21:17,040
.أيّها الطبيب

317
00:21:18,330 --> 00:21:20,670
.ها أنت هنا

318
00:21:21,460 --> 00:21:22,590
ألديّ مريض؟

319
00:21:22,590 --> 00:21:23,170
.نعم

320
00:21:23,720 --> 00:21:24,920
ما هو وضعه؟

321
00:21:24,920 --> 00:21:25,930
وكيف أُصيب؟

322
00:21:26,380 --> 00:21:28,090
.أُصيب بطلق ناريّ في فخذه

323
00:21:28,930 --> 00:21:30,850
.ولديه جرح بليغ في كتفه أيضًا

324
00:21:31,390 --> 00:21:35,180
...أنت الوحيد الّذي يمكنه إجراء هذه العمليّة أيّها الطبيب

325
00:21:35,850 --> 00:21:37,270
.أيها الطبيب كيريكو

326
00:21:52,450 --> 00:21:58,370
،في هذا الوقت، كان العبقريّان ينظران إلى نفس الاتّجاه

327
00:21:59,330 --> 00:22:06,880
لكنّهما لم يعرفا أنّ طريقيهما يقودانهما
.إلى مستقبل لن يلتقيا فيه

328
00:23:39,920 --> 00:23:48,850
[        ]

329
00:23:39,920 --> 00:23:48,850
_____

330
00:23:39,920 --> 00:23:48,850
في الحلقة القادمة

331
00:23:41,230 --> 00:23:42,940
.العنصريّة

332
00:23:43,150 --> 00:23:46,230
حتّى بعد قرن وعدّة عقود من صدور
،بيان لينكولن لتحرير العبيد

333
00:23:46,230 --> 00:23:50,900
.إلاَ أنَ البشريّة لا زالتْ غير قادرة على إعلان أنّ القضيّة قد حُلّت

334
00:23:51,200 --> 00:23:55,530
،إنّ الجسد البشريّ قادر على الإحساس بالألم
.ويستعمل ذلك لحماية نفسه

335
00:23:55,530 --> 00:23:58,120
.كما أنَّ الرّوح البشريّة أيضًا قادرة على إدراك الألم

336
00:23:58,540 --> 00:24:01,120
.والقلب كذلك يبكي من الألم

337
00:24:01,410 --> 00:24:03,670
.ثورة بلا ألم، الجزء الأول

338
00:24:04,670 --> 00:24:05,920
.اشعر بالألم

339
00:24:06,210 --> 00:24:08,550
،بجسدك، بقلبك

340
00:24:08,550 --> 00:24:09,760
.وبكلّ كيانك