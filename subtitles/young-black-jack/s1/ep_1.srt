269
00:18:53,570 --> 00:18:55,690
.عودي رجاءً

270
00:19:09,250 --> 00:19:11,210
.عادت الدّورة الدّمويّة

271
00:19:11,210 --> 00:19:12,210
.مرحى

272
00:19:12,210 --> 00:19:13,710
.جيّد، جيّد

273
