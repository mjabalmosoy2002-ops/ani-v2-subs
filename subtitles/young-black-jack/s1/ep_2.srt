1
00:00:00,850 --> 00:00:01,640
.مهلاً

2
00:00:01,980 --> 00:00:03,770
!لا تفعل هذا يا هازاما

3
00:00:05,560 --> 00:00:10,150
في سنة 1967، صُعق العالم بأخبارِ إنجازٍ مذهل؛

4
00:00:10,530 --> 00:00:14,700
.وكان نجاحَ أوّل عملية زرع قلب في العالم

5
00:00:15,030 --> 00:00:17,870
.يابو-سان، لا تعبث معي

6
00:00:17,870 --> 00:00:19,660
أتسعى لتكون عقبة في طريقي؟

7
00:00:20,120 --> 00:00:22,790
.لكنّ المريض تُوفيّ بعد ذلك بقليل

8
00:00:22,790 --> 00:00:25,960
،ورُغم إجراء العديد من عمليات زرع القلب بعد ذلك

9
00:00:25,960 --> 00:00:28,880
،إلاَ أنَ رفض العضو المزروع كانَ ردّ فعلٍ حادّ

10
00:00:28,880 --> 00:00:32,300
.ممّا أدّى إلى ظهور تحدٍّ جديد في مجال الطّب

11
00:00:32,800 --> 00:00:36,640
...لكنّك تُدركُ ذلك، تُدركهُ الآن

12
00:00:37,640 --> 00:00:40,390
.تعرف أنّ هذه ستكون جريمة قتل

13
00:02:22,480 --> 00:02:23,660
...هذا

14
00:02:28,500 --> 00:02:31,790
.لا بدّ أنّه مخدّرُ إيزوفلوران

15
00:02:32,210 --> 00:02:34,340
.أرى أنّك قد استيقظتَ أخيرًا

16
00:02:37,800 --> 00:02:38,970
تاتشيري؟

17
00:02:40,050 --> 00:02:42,760
ألا تظنّ أنّ الاختطاف عمل مبالغ فيه؟

18
00:02:43,180 --> 00:02:45,390
.لا يحقّ لك أن تشتكي

19
00:02:45,640 --> 00:02:48,100
.فأنت تدين لي بثلاثمائة مليون

20
00:02:48,100 --> 00:02:50,480
!أقُلتَ ثلاثمائة مليون؟

21
00:02:49,520 --> 00:02:50,480
!ماذا؟

22
00:02:50,480 --> 00:02:53,560
.لَم تخبرني أبدًا بأنّ لديك ديْنًا كبيرًا كهذا يا هازاما

23
00:02:53,560 --> 00:02:54,570
!يابو-سان؟

24
00:02:54,570 --> 00:02:55,820
لِمَ أنت هنا؟

25
00:02:58,440 --> 00:03:01,030
تعرف أنّ لديّ ديونًا أنا أيضًا، صحيح؟

26
00:03:01,570 --> 00:03:03,490
،تمّ استدعائي لأدفع

27
00:03:03,490 --> 00:03:07,830
لذلك أتيتُ بالخمسين ألفًا الّتي
.أعطيتنيها، وانتهى بي المطاف هنا

28
00:03:12,290 --> 00:03:12,880
.أنت

29
00:03:13,170 --> 00:03:15,380
!ما الّذي تنوي فعله بنا؟

30
00:03:15,380 --> 00:03:16,340
.صحيح

31
00:03:16,340 --> 00:03:18,670
.هذا أمر مبالغ فيه مقابل القليل من المال

32
00:03:18,670 --> 00:03:20,970
.أخرجونا من هنا الآن

33
00:03:21,300 --> 00:03:22,470
.اهدؤوا رجاءً

34
00:03:22,680 --> 00:03:25,640
،لقد جمعتُكم هنا اليوم جميعًا

35
00:03:25,640 --> 00:03:29,560
.وذلكَ لأقترح عليكم خطّة مذهلة لتُسدّدوا ديونكم

36
00:03:30,560 --> 00:03:32,730
نُـ-نُسدّد ديوننا؟ أأنت جادّ؟

37
00:03:32,730 --> 00:03:35,520
ليس هنالك خدعة ما، صحيح؟

38
00:03:35,730 --> 00:03:39,990
.ماذا؟ أريدكم فقط أن تقدّموا لي عضوًا

39
00:03:40,490 --> 00:03:41,450
!عضو؟

40
00:03:41,740 --> 00:03:45,620
سمعتُ أنّ بإمكان المرء أن يعيش حياة
.طبيعيّة حتّى لو فقد بعض الأعضاء

41
00:03:45,620 --> 00:03:49,750
،سأكون سعيدًا بمنحك إحداها
.طالما أنَّ ذلك سيدّد كلَّ ديوني

42
00:03:49,750 --> 00:03:50,830
.حسنًا، سأفعل ذلك

43
00:03:50,830 --> 00:03:52,250
.كلاّ، بل أنا

44
00:03:53,170 --> 00:03:55,380
وما هو العضو الّذي نتحدّث عنه الآن؟

45
00:03:58,250 --> 00:03:59,840
.إنّه القلب

46
00:04:05,180 --> 00:04:07,180
.توقّعتُ شيئًا كهذا

47
00:04:07,180 --> 00:04:08,180
.أيّها الوغد

48
00:04:08,180 --> 00:04:09,850
!أتريد قتلنا؟

49
00:04:09,850 --> 00:04:11,980
.هذا قاسٍ

50
00:04:11,980 --> 00:04:15,520
،بأي حال، سيكون من غير المناسب عدم امتلاك قلب

51
00:04:15,520 --> 00:04:18,570
.لذلك سأبادله بقلب رجل فاحش الثّراء

52
00:04:18,570 --> 00:04:20,150
.بعبارات أخرى، ستكون عملية مقايضة

53
00:04:20,530 --> 00:04:22,490
.لا-لا تعاملنا كأغبياء

54
00:04:22,490 --> 00:04:24,530
لماذا قد نرغب بقلبٍ عليل؟

55
00:04:28,530 --> 00:04:32,250
.على أي حال، تأهبوا لنتائج فحوصكم الطّبّيّة

56
00:04:40,460 --> 00:04:42,760
.أبديتُم روحًا رياضية متدنّية بشأن هذا

57
00:04:42,760 --> 00:04:44,970
.إنّ المرء يحصد ما يزرعه

58
00:04:44,970 --> 00:04:46,640
.أراك هادئًا ورزينًا

59
00:04:46,640 --> 00:04:48,220
هل أنت تحت تأثير المخدّرات؟

60
00:04:48,640 --> 00:04:52,140
.كلا، أفكّر فقط  بأنّه قد حان وقتي لأدفع ما عليّ

61
00:04:52,560 --> 00:04:55,310
،لقد نجوتُ من الحرب بلا أيّ سبب يُذكر

62
00:04:55,310 --> 00:04:57,480
.وما أنا الآن إلاّ مدمن مخدّرات

63
00:04:57,860 --> 00:05:00,940
.حتّى أنني أستعمل المستشفى الّذي تركه لي أبي كتأمين

64
00:05:01,320 --> 00:05:03,860
ما الغاية في أن يظلّ شخص مثلي على قيد الحياة؟

65
00:05:06,450 --> 00:05:07,910
،والأهم من ذلك

66
00:05:08,370 --> 00:05:11,450
.لم أكن أعلم أن عليكَ ديْنًا بثلاثمائة مليون

67
00:05:11,700 --> 00:05:13,580
كيف انتهى بك المطاف بديْن كهذا؟

68
00:05:16,960 --> 00:05:18,920
.كان ذلك بغرض إنقاذ حياة أحدهم

69
00:05:19,380 --> 00:05:20,750
.لكنّ الأمر لم ينجح في النّهاية

70
00:05:21,630 --> 00:05:23,010
.فهمت

71
00:05:23,960 --> 00:05:27,300
.أنت مختلفٌ عني كما توقعت

72
00:05:29,180 --> 00:05:30,100
.سُحقًا

73
00:05:30,100 --> 00:05:31,850
!إلى متى سيجعلوننا ننتظر هكذا؟

74
00:05:31,850 --> 00:05:34,560
وما الّذي قصده عندما قال "فحوص"؟

75
00:05:34,560 --> 00:05:36,850
.كان يتحدّث عن فحص المتبرّع المناسب

76
00:05:38,850 --> 00:05:42,780
.فلا يمكن استعمال عضو أيٍّ كان في عملية زرع

77
00:05:42,780 --> 00:05:45,490
إذًا إن لم أجتز الفحص، فسأعيش؟

78
00:05:45,490 --> 00:05:47,860
.أتمنّى ألاّ تكون نتائجي متطابقة

79
00:05:47,860 --> 00:05:49,570
.أنا لا أريد أن أموت

80
00:05:51,990 --> 00:05:54,750
.إنّه يوم سعدكم

81
00:05:54,750 --> 00:05:58,620
،كان من الصّعب العثور حتى على متبرّعٍ مناسب واحد

82
00:05:58,620 --> 00:06:00,580
.لكنّنا وجدنا متبرّعَيْن بينكم

83
00:06:02,590 --> 00:06:04,760
.يا لها من معجزة

84
00:06:04,760 --> 00:06:07,720
...إذًا، أحد الفائزَيْن المحظوظَيْن هو

85
00:06:08,260 --> 00:06:09,640
.هازاما-كُن

86
00:06:10,300 --> 00:06:11,510
!هازاما

87
00:06:11,850 --> 00:06:16,230
.والمحظوظ الآخر هو... رايموند-كُن

88
00:06:21,560 --> 00:06:25,900
.إذًا ... ليذهب البقيّة في حال سبيلهم

89
00:06:26,400 --> 00:06:28,490
،إذا أردتُم ألاّ يحصل هذا ثانية

90
00:06:28,490 --> 00:06:31,370
.استيقظوا من غفلتكم وادفعوا ما عليكم

91
00:06:41,330 --> 00:06:46,550
حسنٌ، سنُقرّر من الجدير الّذي سيمنح قلبه
.في الوقت المناسب

92
00:06:47,300 --> 00:06:50,260
من سيقوم بعلمية زرع القلب هذه مِن متبرّع حيّ؟

93
00:06:52,050 --> 00:06:59,140
في ديسمبر الماضي، أجرى الطبيب بارنارد من جنوب إفريقيا
،أوّل عملية زرع قلب ناجحة في العالم

94
00:06:59,140 --> 00:07:02,480
.لكنّ المريض عاش لثمانية عشر يومًا فقط

95
00:07:03,270 --> 00:07:08,940
،كانت هنالك حالات أخرى عديدة خلال هذه السّنة ولكن
.قيل أنّ المرضى لا يعيشون إلاّ بضعة أشهر كأكثر تقدير

96
00:07:09,450 --> 00:07:14,410
إلى جانب ذلك، لا توجد أيّة مستشفيات أو أطبّاء في اليابان
.قادرين على إجراء هكذا عمليّة

97
00:07:14,660 --> 00:07:16,910
،ليس علنًا على أيّ حال

98
00:07:16,910 --> 00:07:19,870
.لكن هنالك دائمًا سوقًا سوداء في أيّ مجال

99
00:07:20,080 --> 00:07:24,170
،مادام هنالك أناس قادرون على دفع مبالغ طائلة
.فسيوجد أطبّاء قادرون على إجراء أيّ جراحة زرع أعضاء

100
00:07:24,590 --> 00:07:31,010
في الحقيقة، هنالك طبيب استمرّ في تحسين المدّة
.الّتي يستطيع فيها مريض البقاء حيًّا بعد عملية زرع قلب

101
00:07:31,220 --> 00:07:32,300
.هذا مستحيل

102
00:07:32,300 --> 00:07:34,300
.لم أسمع بشيء كهذا مُطلقًا

103
00:07:36,890 --> 00:07:39,100
.لهذا السّبب قلتُ أنّها السّوق السّوداء

104
00:07:39,640 --> 00:07:44,060
.الطبيب جوكر... هكذا يناديه الأشخاص من ذوي حرفتي

105
00:07:44,440 --> 00:07:46,190
...الطبيب جوكر

106
00:07:49,230 --> 00:07:50,280
.إنّه هنا

107
00:07:50,280 --> 00:07:51,820
.حسنٌ، حسنٌ

108
00:07:51,820 --> 00:07:54,200
.لقد شرّفني وجودك هنا

109
00:07:58,040 --> 00:08:02,210
،هذا هو الرّجل الّذي سنجري له عملية زرع القلب
.وهو مؤسّس طائفة الكيوكوكو

110
00:08:02,710 --> 00:08:05,080
.كانياما تاميزو-ساما

111
00:08:06,790 --> 00:08:12,630
.لقد أراد مقابلة الرّجل الّذي سيمنحه قلبًا

112
00:08:16,140 --> 00:08:17,390
...هذا هو إذًا

113
00:08:18,060 --> 00:08:21,640
العجوز الجشع المحبّ للمال الّذي يظنّ
.أنّ بإمكانه الحصول على أيّ شيء بالمال

114
00:08:22,100 --> 00:08:24,060
كيف تجرؤ على التّحدّث معه بتلك الطّريقة؟

115
00:08:24,060 --> 00:08:25,520
...هذا الرّجل هو

116
00:08:31,240 --> 00:08:36,700
.ظننتُ أنّه من المستحيل شراء حياةٍ بالمال

117
00:08:37,120 --> 00:08:41,870
لم أصدّق أنّه قد يكون هنالك أحد قد
،يتخلّى عن حياته من أجل المال

118
00:08:42,450 --> 00:08:46,580
.لكنّ هكذا أشخاص موجودون بالفعل

119
00:08:46,580 --> 00:08:48,710
.هنالك من قد يبيع حياته من أجل المال

120
00:08:54,760 --> 00:08:57,260
.سأعطيك قدر ما تشاء من المال

121
00:08:57,260 --> 00:08:58,890
.خذه

122
00:08:58,890 --> 00:09:00,640
.خذه ومُتْ

123
00:09:05,310 --> 00:09:07,270
.لقد اخترتُك أنت

124
00:09:08,270 --> 00:09:12,610
.عيناك تعلوهما نظرة ثائرة، لكنّهما مليئتان بالحياة

125
00:09:12,610 --> 00:09:13,990
.أحببتُ هذا

126
00:09:13,990 --> 00:09:16,990
.سآخذُ قلبك

127
00:09:17,280 --> 00:09:18,950
.هذا يكفي

128
00:09:21,290 --> 00:09:23,620
.لقد زاد الأمر عن حدّه

129
00:09:24,830 --> 00:09:25,580
...يابو-سان

130
00:09:25,580 --> 00:09:27,460
،مهما كان السّبب

131
00:09:27,460 --> 00:09:30,650
.فلا يحقّ لك أن تسلب رجلًا يافعًا واعدًا مستقبله المشرق

132
00:09:30,770 --> 00:09:31,800
.اخرس

133
00:09:31,800 --> 00:09:34,510
من هذا الرّجل؟

134
00:09:34,510 --> 00:09:36,380
.إنّه على معرفة بهذا الشخص

135
00:09:39,930 --> 00:09:46,350
.دعوه يرى إذًا نهاية رجل باع حياته من أجل المال

136
00:09:49,650 --> 00:09:50,900
.سيّدي

137
00:09:55,400 --> 00:09:57,110
.لنأخذه لسريره

138
00:10:01,780 --> 00:10:05,000
يابو-سان، لماذا عُدت؟

139
00:10:05,000 --> 00:10:07,250
.لم أستطع تركك هنا والرّحيل بالطّبع

140
00:10:10,380 --> 00:10:12,960
.لقد تفاقمت حالة مؤسّسنا للأسوأ

141
00:10:12,960 --> 00:10:15,010
ألم يصل الطبيب جوكر بعد؟

142
00:10:15,010 --> 00:10:16,170
.لا داعيَ للعجلة

143
00:10:16,380 --> 00:10:18,800
.لا وقت أمامنا لنهدره

144
00:10:18,800 --> 00:10:20,010
.ابتعدا عن طريقي

145
00:10:21,260 --> 00:10:22,100
ماذا هنالك؟

146
00:10:22,100 --> 00:10:23,220
...إنّه

147
00:10:26,020 --> 00:10:27,310
!ماذا؟

148
00:10:27,310 --> 00:10:28,890
أتقول أنّه متوارٍ عن الأنظار؟

149
00:10:29,190 --> 00:10:31,440
،يـ-يبدو أنّ هنالك من بلّغ عنه

150
00:10:31,440 --> 00:10:36,610
،لذلك قرّر الاختباء من الشّرطة الدّوليّة في الوقت الراهن
.وفقدنا جرّاء ذلك الإتصال به

151
00:10:37,190 --> 00:10:39,660
.لا يستطيع الطبيب جوكر المجيء

152
00:10:40,780 --> 00:10:41,990
.سُحقًا لهذا

153
00:10:42,200 --> 00:10:45,950
.لقد خسرتُ ثلاثمائة مليون

154
00:10:46,450 --> 00:10:48,160
.سُحقًا

155
00:10:48,160 --> 00:10:50,580
.أظنّ أنّ الأمر قد انتهى هنا يا تاتشيري-سان

156
00:10:51,170 --> 00:10:53,590
.لا فائدة من بقائنا هنا أكثر من هذا

157
00:10:53,590 --> 00:10:55,960
.حان الوقت لتركنا نرحل

158
00:10:57,800 --> 00:11:00,180
.أظنّ أنّك ستُبقي على حياتك يا هازاما

159
00:11:00,510 --> 00:11:01,510
.حان وقت الذّهاب

160
00:11:04,260 --> 00:11:06,430
أتظنّ أنّ بإمكانك إنهاء هذا هنا وببساطة؟

161
00:11:06,680 --> 00:11:07,970
ماذا؟

162
00:11:07,970 --> 00:11:10,100
.لقد وثقنا بك

163
00:11:10,100 --> 00:11:12,770
.نحن في انتظار عودة عافية مؤسّسنا

164
00:11:12,770 --> 00:11:16,400
إن لم يخضع حتّى للجراحة
...وفارق الحياة

165
00:11:16,730 --> 00:11:21,150
.فلن يغفر لك أيّ أحد من أعضاء هذه الطّائفة

166
00:11:23,030 --> 00:11:26,240
.لـ-لكن لا يوجد طبيب لهذا الغرض

167
00:11:26,240 --> 00:11:28,700
.جِد واحدًا آخر الآن

168
00:11:29,160 --> 00:11:31,200
.جِد طبيبًا قادرًا على القيام بعملية الزّرع

169
00:11:31,570 --> 00:11:35,000
.عليك أن تنقذ مؤسّسنا مهما كلّفك ذلك

170
00:11:41,130 --> 00:11:42,220
.هازاما

171
00:11:44,140 --> 00:11:45,640
.أنت من ستُجريها

172
00:11:45,890 --> 00:11:47,100
!ماذا قُلت؟

173
00:11:47,390 --> 00:11:52,600
.أنت من ستُجري عملية زرع القلب هذه

174
00:11:54,650 --> 00:11:56,440
،رغم أنّه طالب

175
00:11:56,440 --> 00:12:00,530
إلاّ أنّه استطاع وصل ذراع وساق صبي صغير
.لم يكن حتى الأستاذ هونغوشي الشهير يرى أملا بنجاحها

176
00:12:01,030 --> 00:12:02,530
!إنّه عبقريّ

177
00:12:03,660 --> 00:12:05,660
هل ما قاله للتو صحيح؟

178
00:12:05,720 --> 00:12:07,200
..كلا ... هذا

179
00:12:07,200 --> 00:12:10,750
هل أنقذ هذا الرّجل ذلك الصّبيّ حقًا؟

180
00:12:10,750 --> 00:12:11,830
.أجبنا حالاً

181
00:12:11,830 --> 00:12:14,040
...أ-أجل

182
00:12:14,460 --> 00:12:16,960
.إنّه لمن حسن حظّنا وجود متبرّعَيْن مؤهّلَيْن

183
00:12:16,960 --> 00:12:18,420
.ستجري أنت العمليّة

184
00:12:20,960 --> 00:12:23,220
.هازاما، هذه فرصتُك

185
00:12:23,220 --> 00:12:26,930
.بإمكانك إجراء أوّل عملية زرع قلب في اليابان

186
00:12:26,930 --> 00:12:29,510
مـ-من منحك الحقّ في اتّخاذ قرار كهذا؟

187
00:12:29,510 --> 00:12:31,220
عملية زرع قلب من متبرّع حيّ؟

188
00:12:31,520 --> 00:12:32,730
.هذا ليس بالأمر الهيّن

189
00:12:32,730 --> 00:12:34,480
ما هو ظنّكم بهازاما يا قوم؟

190
00:12:34,480 --> 00:12:35,520
.أجرِها رجاءً

191
00:12:36,190 --> 00:12:39,320
.استعمل قلبي للقيام بعلمية الزّرع

192
00:12:39,320 --> 00:12:41,150
.لهذا السّبب أنا هنا من الأساس

193
00:12:41,740 --> 00:12:43,990
.أنا بحاجة شديدة للمال

194
00:12:44,450 --> 00:12:45,160
.أرجوك

195
00:12:45,160 --> 00:12:46,620
.أجرِ الجراحة

196
00:12:47,410 --> 00:12:48,870
،في موطني الأمّ

197
00:12:48,870 --> 00:12:51,580
.فقد النّاس وظائفهم بسبب سياسة التّصنيع السّريع

198
00:12:51,580 --> 00:12:54,370
.وقضوا أيّامهم بالنّبش في النفايات

199
00:12:54,370 --> 00:12:58,340
.بعدها تمّ تشخيص ابنتي بمرض اللّوكيميا

200
00:12:58,340 --> 00:13:01,510
،دخلتُ اليابان بطريقة غير قانونيّة للحصول على المال لعلاجها

201
00:13:01,510 --> 00:13:03,840
.لكنّني لم أستطع العثور على أيّ عمل محترم

202
00:13:04,260 --> 00:13:08,890
وبعدها سمعتُ أنّ بإمكاني الحصول
.على مائة مليون مقابل عضو من أعضائي

203
00:13:09,930 --> 00:13:12,020
.ظننتُ أنّ إلهي قد قام بمساعدتي

204
00:13:12,020 --> 00:13:14,430
.يمكنني إنقاذ ابنتي بذلك المبلغ

205
00:13:14,810 --> 00:13:18,060
.ولا يهمّني إن كلّفني ذلك حياتي

206
00:13:18,310 --> 00:13:19,060
.أرجوك

207
00:13:19,060 --> 00:13:20,570
.أجرِ الجراحة رجاءً

208
00:13:20,860 --> 00:13:23,030
.أنقذ ابنتي رجاءً

209
00:13:23,940 --> 00:13:27,030
...عملية زراعة قلب، أجريها أنا

210
00:13:33,950 --> 00:13:37,790
،هذا يُمثلُ نقل الحياة بحد ذاتها
.يشبه هذا عملاً من صنيع إله

211
00:13:37,790 --> 00:13:39,710
.وبيديَ هاتين ...

212
00:13:39,880 --> 00:13:42,340
ما ردّك إذًا يا هازاما؟

213
00:13:42,800 --> 00:13:48,800
هل ستراهن على تحقيق أمنية هذا
.الرّجل وإنقاذ كلّ الموجودين هنا

214
00:13:49,180 --> 00:13:52,310
أو أنّك لن تفعل شيئًا وتُقتل كالحيوان؟

215
00:13:56,520 --> 00:13:59,520
أُقتل كالحيوان؟
.هذا ينطبقُ عليكَ أيضًا

216
00:14:00,020 --> 00:14:00,730
ماذا؟

217
00:14:01,900 --> 00:14:04,230
.سأتحقّق من حالة المريض

218
00:14:09,160 --> 00:14:12,200
...ملفّ المريض وتعليمات الطبيب جوكر

219
00:14:12,660 --> 00:14:15,160
.كلّ ما تحتاج إليه موجود هنا

220
00:14:15,500 --> 00:14:17,620
.أرياني صورة الأشعّة بالتّباين لشريانه التّاجي

221
00:14:17,620 --> 00:14:20,040
.هازاما، لا تفعل هذا

222
00:14:20,040 --> 00:14:21,840
.لا تُجرِ هذه الجراحة

223
00:14:21,840 --> 00:14:23,170
.هازاما

224
00:14:23,800 --> 00:14:26,130
...داء قلبي إفقاري حادّ

225
00:14:26,510 --> 00:14:31,340
منعَ تصلُبٌ في الشّريان التّاجي الأيمن
.تدفُّقَ الدّماء لعضلة القلب

226
00:14:31,340 --> 00:14:33,600
.القلب بحدّ ذاته يكاد يتعرّض للنَّخَر

227
00:14:33,760 --> 00:14:34,850
ماذا؟

228
00:14:34,850 --> 00:14:36,180
تُريدني أن أوقفه؟

229
00:14:36,180 --> 00:14:37,230
.أرجوك

230
00:14:37,230 --> 00:14:39,140
.اجعله يوقف العمليّة

231
00:14:39,140 --> 00:14:40,310
.مستحيل

232
00:14:40,310 --> 00:14:42,400
.فحياتي على المحكّ أيضًا

233
00:14:42,730 --> 00:14:46,740
.زرع القلب ليست عملية مستحيلة بحدّ ذاتها

234
00:14:46,740 --> 00:14:48,360
.المشكلة الحقيقيّة هي رفض الزّرع

235
00:14:48,530 --> 00:14:50,160
.سيُجريها

236
00:14:50,160 --> 00:14:54,410
فقبل كلّ شيء، هو توّاق للحصول
.على فرصة لإجراء عملية

237
00:14:54,780 --> 00:14:56,240
.لا تقم بهذا

238
00:14:56,240 --> 00:14:57,950
،إن أجريتَ العمليّة

239
00:14:58,160 --> 00:15:03,590
فلن تستطيع أبدًا العودة وممارسة
.الطّب بشكل شرعي ثانية يا هازاما

240
00:15:05,500 --> 00:15:08,090
،التّحقّق من تطابق مُسْتَضِدَّات الكُرَيَّات البيضاء البَشَرِيَّة

241
00:15:08,090 --> 00:15:10,220
،تقييم الدّنف

242
00:15:10,220 --> 00:15:12,590
،فحوصٌ دقيقة لِما قبل الزّرع

243
00:15:13,140 --> 00:15:16,220
إضافة إلى جرعة كبيرة من هرمون
...الستيرويد وكوابح المناعة

244
00:15:17,140 --> 00:15:19,770
.إذًا هذه هي وصفة الطبيب جوكر

245
00:15:22,730 --> 00:15:23,690
ماذا هنالك؟

246
00:15:24,110 --> 00:15:25,110
أيمكنك أن تُجريها؟

247
00:15:26,320 --> 00:15:28,860
.كان تقييم الطبيب جوكر مثاليًّا

248
00:15:28,860 --> 00:15:32,780
.مقاربته العلاجية الموصوفة تمنعُ أيّ بادرة للرفض

249
00:15:32,990 --> 00:15:34,160
!هازاما

250
00:15:35,330 --> 00:15:39,750
.حسنٌ، عرفتُ أنّك ستقول ذلك

251
00:15:40,620 --> 00:15:42,250
.سأحتاج إلى خمسين مليونًا للقيام بهذه العمليّة

252
00:15:42,250 --> 00:15:43,040
!ماذا؟

253
00:15:43,290 --> 00:15:45,540
تكبّدتَ الخسائر في كلّ الأحوال، صحيح؟

254
00:15:45,540 --> 00:15:46,590
.وغد

255
00:15:46,590 --> 00:15:48,210
.لا تغترّ بتفسك

256
00:15:51,130 --> 00:15:52,720
ألا تحتاجني إذًا؟

257
00:15:52,720 --> 00:15:56,010
.قد تموت هنا إن لم أُجرِ الجراحة

258
00:15:57,560 --> 00:15:58,470
.سُحقًا

259
00:15:58,470 --> 00:15:59,810
.حسنٌ، سأدفع المبلغ

260
00:15:59,810 --> 00:16:00,640
.وغد

261
00:16:00,640 --> 00:16:01,180
.مؤلم

262
00:16:01,180 --> 00:16:02,480
...هذا مؤلم

263
00:16:06,150 --> 00:16:07,440
.شكرًا لك

264
00:16:07,820 --> 00:16:10,360
.بإمكاني إنقاذ ابنتي الآن

265
00:16:11,240 --> 00:16:12,950
.سأقوم بتخديرك الآن

266
00:16:13,410 --> 00:16:14,820
ألديكَ كلمات أخيرة؟

267
00:16:15,200 --> 00:16:20,540
هلا حرصتَ على أن يصل المال لعائلتي... لابنتي؟

268
00:16:20,870 --> 00:16:21,710
.أرجوك

269
00:16:25,580 --> 00:16:26,750
.لك ذلك

270
00:16:49,070 --> 00:16:51,030
.تمّ تخديره

271
00:16:54,900 --> 00:16:57,530
.سأبدأ الآن بالعمليّة

272
00:17:10,170 --> 00:17:11,250
!هازاما

273
00:17:11,500 --> 00:17:13,340
.لا تفعل هذا يا هازاما

274
00:17:17,430 --> 00:17:21,180
.يابو-سان، لا تعبث معي

275
00:17:21,180 --> 00:17:23,180
أتسعى لتكون عقبة في طريقي؟

276
00:17:23,890 --> 00:17:25,980
.أنا أعرفك

277
00:17:25,980 --> 00:17:28,230
.سيحين وقتٌ ستُجري فيه عمليّاتٍ كهذه

278
00:17:28,770 --> 00:17:32,530
...لكنّك تُدركُ ذلك، تُدركهُ الآن

279
00:17:33,150 --> 00:17:35,860
.تعرفُ أنّ هذه ستكون جريمة قتل

280
00:17:37,360 --> 00:17:38,320
.كلاّ

281
00:17:38,320 --> 00:17:42,290
.اختار هذا الرّجل أن يضحّيَ بحياته لإنقاذ ابنته المريضة

282
00:17:42,290 --> 00:17:44,790
.كان مستعدًّا ليتخلّى عن قلبه منذ مدّة

283
00:17:45,660 --> 00:17:47,210
.أنا واثق من ذلك

284
00:17:47,210 --> 00:17:50,670
هنالك أشخاص عازمون على التّخلّي
.حتّى عن حياتهم مقابل ما يريدونه

285
00:17:51,340 --> 00:17:56,470
.لهذا السّبب عليّ إجراء هذه الجراحة، إنّها من أجله أيضًا

286
00:17:56,970 --> 00:17:57,880
.هذه كذبة

287
00:17:59,260 --> 00:18:01,760
.ليس هذا ما تظنّه حقًّا

288
00:18:02,180 --> 00:18:03,390
.انظر إليه وحسب

289
00:18:04,270 --> 00:18:08,690
أتعتقد بالفعل أنّه يريد التّخلّي عن حياته؟

290
00:18:09,270 --> 00:18:11,060
.من المستحيل أن يرغَب في شيء كهذا

291
00:18:11,060 --> 00:18:12,650
.نفذت منه الخيارات فحسب

292
00:18:13,190 --> 00:18:16,400
.إنّه يتخلّى عن حياته فقط لأنّه لا يملك خيارًا آخر

293
00:18:19,450 --> 00:18:22,620
،في الجبهات الأمامية في غينيا الجديدة قبل 24 سنة

294
00:18:22,990 --> 00:18:24,660
،بينما كنتُ لا أزال مُسعفًا مبتدئًا

295
00:18:24,660 --> 00:18:29,870
رأيتُ الكثير من رفاقي في الحرب يتخلّون
."عن حياتهم "من أجل بلادهم

296
00:18:30,920 --> 00:18:33,290
.يابو، ساعدني

297
00:18:33,880 --> 00:18:34,840
...ساعدني

298
00:18:35,300 --> 00:18:36,420
.أنا آسف

299
00:18:36,420 --> 00:18:38,760
.لَم يبقَ لديَّ أدوية أو مسكّنات ألم

300
00:18:38,760 --> 00:18:40,800
.إذًا... اقتلني رجاءً

301
00:18:40,800 --> 00:18:42,890
.اقتلني الآن من فضلك

302
00:18:42,890 --> 00:18:44,760
.اقتلني

303
00:18:44,760 --> 00:18:45,520
.كلاّ

304
00:18:45,520 --> 00:18:46,600
...اقتلني

305
00:18:52,310 --> 00:18:54,820
.لمْ يرغب أحدٌ فعلاً بالموت

306
00:18:55,610 --> 00:18:58,780
.تمنّوا الموت فقط لأنّه ما من ملاذٍ آخر لهم

307
00:18:59,700 --> 00:19:04,080
،أنت تسعى لتصير طبيبًا ينقذ الأرواح

308
00:19:04,080 --> 00:19:07,660
لأنّك نجوتَ وحصلتَ على فرصة ثانية
أنت الآخر، أليس كذلك؟

309
00:19:08,410 --> 00:19:12,000
هل ستقوم بالفعل بقتل رجل من أجل
خسيسٍ مثله يا هازاما؟

310
00:19:13,290 --> 00:19:16,710
.لا تسمح لحالك بأن تصبح كحالي

311
00:19:17,010 --> 00:19:20,590
.لديك موهبة رائعة ما كنتُ لأحلم بها حتّى

312
00:19:20,590 --> 00:19:22,890
.فلا تسمح لموهبتكَ بأنْ تُستعمل من أجل الشّر

313
00:19:28,270 --> 00:19:29,020
.سُحقًا

314
00:19:29,020 --> 00:19:30,390
!إنّه يمرّ بسكتة قلبيّة؟

315
00:19:30,390 --> 00:19:31,310
.أعطني قُطبَيْ مزيل الرّجفان

316
00:19:33,610 --> 00:19:34,560
.لم ينجح الأمر

317
00:19:34,560 --> 00:19:35,690
.اشحنه مرّة أخرى

318
00:19:35,690 --> 00:19:36,940
...حاضر

319
00:19:39,190 --> 00:19:42,530
...ثلاثة، إثنان، واحد

320
00:19:43,110 --> 00:19:44,280
.جاهز

321
00:19:49,040 --> 00:19:50,000
.مرّة أخرى

322
00:19:51,960 --> 00:19:53,250
.جاهز

323
00:20:03,050 --> 00:20:04,930
.سأبدأ العمليّة

324
00:20:17,730 --> 00:20:21,190
.لا أعرف بالفعل كيف أستطيع ردّ الجميل لك

325
00:20:21,190 --> 00:20:23,780
.لا أجد الكلمات الكافية لأشكرك

326
00:20:23,780 --> 00:20:25,160
.شكرًا جزيلاً لك

327
00:20:30,500 --> 00:20:33,750
.كما أنّي كنتُ متردِّدًا بالفعل وقتها

328
00:20:34,170 --> 00:20:36,630
،لقد أغرتني عملية لم أجرها من قبل

329
00:20:36,630 --> 00:20:39,460
.لكنّ هذا الرّجل أوقفني

330
00:20:41,590 --> 00:20:45,590
.توقّف قلب كانياما بعد ذلك مباشرة

331
00:20:45,590 --> 00:20:46,840
.هذا يكفي

332
00:20:46,840 --> 00:20:47,850
.لقد مات

333
00:20:48,390 --> 00:20:53,810
،لم ننقذ كانياما من الموت
.ولم نستطع أيضًا إنقاذ ابنة رايموند

334
00:20:54,100 --> 00:20:58,310
.أظنّ أنّ أعضاء طائفة كانياما سيقتلوننا

335
00:20:59,480 --> 00:21:02,030
.خطرت ببالي فكرة حينها

336
00:21:03,570 --> 00:21:06,530
...لديهما نفس البنية الجسديّة... ربّما

337
00:21:09,990 --> 00:21:12,370
هازاما، ما الّذي تنوي فعله؟

338
00:21:13,160 --> 00:21:16,120
.تغيير وجهك وجسدك ليُصبحا شبيهين بكانياما

339
00:21:16,870 --> 00:21:22,300
.كان خيارنا الوحيد لإنقاذ ابنتك وحياتك أيضًا

340
00:21:22,920 --> 00:21:24,760
.سأبدأ العمليّة

341
00:21:27,800 --> 00:21:33,140
.يرجع الفضل لكما في إنقاذ حياتي وحياة ابنتي

342
00:21:33,390 --> 00:21:35,480
.كلا، أنا لم أقم بشيء

343
00:21:35,480 --> 00:21:38,060
.كلاّ، كنتُ أنا من تمّ إنقاذه في الواقع

344
00:21:38,060 --> 00:21:39,610
ها-هازاما؟

345
00:21:39,610 --> 00:21:41,650
،لو لَم تكن إلى جانبي هناك

346
00:21:41,650 --> 00:21:45,320
.ما كنتُ لأتمكّن من مقاومة إغراء عملية زرع قلب

347
00:21:45,780 --> 00:21:48,360
.كنتُ لأصبح قاتلاً

348
00:21:48,360 --> 00:21:50,530
.يابو-سان، لقد أنقذتني من ذلك المصير

349
00:21:51,240 --> 00:21:52,080
.شكرًا لك

350
00:21:55,870 --> 00:21:59,330
،بعد أن وقع ضحيّة إغراء احتمال إجراء جراحة زرع قلب

351
00:21:59,330 --> 00:22:02,380
.كاد هازاما يحيد عن طريقه كطبيب صالح

352
00:22:03,050 --> 00:22:09,390
ومَن أنقذه مِن ذلك كان طبيبًا آخر
.يُخفي بداخله جرحًا عميقًا

353
00:23:39,930 --> 00:23:49,380
[        ]

354
00:23:39,930 --> 00:23:49,380
_____

355
00:23:39,930 --> 00:23:49,380
في الحلقة القادمة

356
00:23:41,230 --> 00:23:42,980
.حرب الفيتنام

357
00:23:42,980 --> 00:23:46,690
،مأساة تلو المأساة تتدقّف من الأنابيب الكاثودية الشّعاعية

358
00:23:46,690 --> 00:23:48,650
.وتهزّ العالم من أساسه

359
00:23:48,650 --> 00:23:50,950
،ومِن بين أصوات المناهضين للحرب

360
00:23:50,950 --> 00:23:53,200
،حتّى الجنود الّذين في خضمّ خدمتهم بدأوا بالتّحرّك

361
00:23:53,200 --> 00:23:56,830
.كما لو أنّ هذه الأصوات قد دفعتهم لذلك

362
00:23:57,330 --> 00:24:00,410
...هربوا من أرض ساحة القتال ومن بلادهم

363
00:24:00,960 --> 00:24:02,370
.ليصبحوا فارّين من القتال

364
00:24:03,120 --> 00:24:05,080
،العالم مليء بالخداع

365
00:24:05,080 --> 00:24:09,710
ومع ذلك على المرء أن يكمل طريقه
.لكي يواجه كلّ حياة