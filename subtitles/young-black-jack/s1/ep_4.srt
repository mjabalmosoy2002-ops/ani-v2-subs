1
00:00:29,170 --> 00:00:33,170
،على هذه الحال، إن لم أفعل شيئًا
.فسينزف حتّى الموت

2
00:00:33,670 --> 00:00:37,930
.في الثّلاثين من يناير سنة 1968

3
00:00:37,930 --> 00:00:40,680
كانت بداية السّنة القمريّة الفيتناميّة
."الجديدة المسّماة "تيت

4
00:00:41,600 --> 00:00:48,440
شنّت "الفيت كونغ"، الّتي كانت قد ركّزت
،على عمليّات حرب عصابات محدودة

5
00:00:48,440 --> 00:00:52,280
.هجماتٍ شاملةٍ مفاجِئةٍ عبر أرجاء فيتنام

6
00:00:52,940 --> 00:00:56,700
.وكانت النّتيجة هي تصاعد الحرب في الفيتنام

7
00:00:57,530 --> 00:01:01,410
،ألقت الفوضى بظلالها
...ولم يعد هنالك خلاص من الحرب

8
00:01:03,000 --> 00:01:05,960
...هذا صحيح، أعلمُ أنّني قادرٌ

9
00:01:10,750 --> 00:01:12,050
.على انقاذه ...

10
00:03:20,510 --> 00:03:21,630
...يابو-سان

11
00:03:24,720 --> 00:03:27,140
.إنّني أفكّر بالذّهاب إلى الفيتنام

12
00:03:27,720 --> 00:03:28,680
!أنت؟

13
00:03:28,930 --> 00:03:29,980
...بلى

14
00:03:30,680 --> 00:03:33,940
،ولكن، هل تظنّ أنّك قادر على العمل في ساحة المعركة

15
00:03:34,400 --> 00:03:37,070
وأنت طبيب من النّوع الّذي يفقد
وعيه إذا ما رأى دماءً؟

16
00:03:37,480 --> 00:03:38,980
هذا ما تظنّه، صحيح؟

17
00:03:38,980 --> 00:03:41,200
.وهذا هو السّبب بالتحديد

18
00:03:43,160 --> 00:03:45,410
،إنّ مشاهدتك وأنت تعمل

19
00:03:45,410 --> 00:03:48,540
.دفعتني لأدرك أنّي بلا فائدة إن لم أتحرّك الآن

20
00:03:51,910 --> 00:03:56,210
.لم أستطع فعل شيء في ذلك الوقت أيضًا

21
00:03:59,670 --> 00:04:02,300
.أمّا أنتَ فبلى

22
00:04:05,840 --> 00:04:09,390
.لهذا السّبب أريد أن أبدأ من الصّفر

23
00:04:25,110 --> 00:04:27,200
إلى أين ذهب يا تُرى؟

24
00:04:34,330 --> 00:04:35,750
طلبتَ "الباين شيو" إذًا؟

25
00:04:35,750 --> 00:04:37,250
.لديك ذوق مميز للغاية

26
00:04:38,630 --> 00:04:40,460
لا بدّ أنّك هازاما-كُن، أليس كذلك؟

27
00:04:40,840 --> 00:04:43,470
.أنا من قدّم يابو إلى المستشفى هنا

28
00:04:43,470 --> 00:04:45,260
.اسمي تاكاناياغي وأعمل مصوّرًا مستقلاًّ

29
00:04:50,100 --> 00:04:52,770
.لقد كان شخصًا مميّزًا بالفعل

30
00:04:53,180 --> 00:04:56,400
.لقد فقد وعيه عندما رأى الدّم

31
00:04:57,480 --> 00:04:59,980
،كان جادًّا كثيرًا بشأن عمله

32
00:05:00,570 --> 00:05:06,530
،ولكن، بعد أقلّ من أسبوعين من وصوله
.دُمّر المستشفى بسبب هجوم إرهابيّ

33
00:05:06,950 --> 00:05:09,120
.أجل، سمعتُ بشأن هذا في اليابان

34
00:05:10,330 --> 00:05:15,540
،"هنا في الفيتنام، تسبب هجوم شامل مفاجئ شنّته "الفيت كونغ

35
00:05:15,830 --> 00:05:20,210
بأضرار جسيمة تكبّدتها سايغون ومدنُ أخرى
،في جنوب الفيتنام

36
00:05:20,210 --> 00:05:21,590
...والفوضى عمّت الـ

37
00:05:22,050 --> 00:05:23,130
.فهمت

38
00:05:23,800 --> 00:05:27,090
.وقد فقدتُ الاتّصال به بعد ذلك

39
00:05:27,680 --> 00:05:31,260
.حسنٌ، لقد كان مُصرًّا على البحث عن مستشفى آخر

40
00:05:34,640 --> 00:05:41,110
أظنّ أنّه لم يمرّ حتّى أسبوع
،منذ أن غادر للالتحاق بمصحّة في قرية قريبة من دالات ولكن

41
00:05:41,360 --> 00:05:45,740
،بمجرّد أن ذهب إلى هناك
.نشبت معركة كبيرة أخرى في تلك القرية

42
00:05:45,740 --> 00:05:49,370
.وحينها فقدتُ الاتّصال به

43
00:05:49,820 --> 00:05:51,950
هل تعتقد أنّه انتقل لمكان آخر ثانية؟

44
00:05:52,330 --> 00:05:53,620
من يدري؟

45
00:05:53,620 --> 00:05:59,710
،"على أي حال، النّزاع مستمرٌ بين الولايات المتّحدة و"الفيت كونغ
،وهو يثير الرّعب في أرجاء دالات حتى الآن

46
00:05:59,710 --> 00:06:03,210
.وبالكاد يعرف النّاس كيف تسري الأمور هناك

47
00:06:05,920 --> 00:06:08,220
كيف يمكنني الذّهاب لتلك القرية؟

48
00:06:08,630 --> 00:06:10,390
ما الّذي تتفوّه به؟

49
00:06:10,390 --> 00:06:12,930
!اسمع، هذه ليست اليابان

50
00:06:12,930 --> 00:06:16,730
...هذه فيتنام، حيث الحرب تحيط بنا من كلّ

51
00:06:19,600 --> 00:06:20,730
!تاكاياناغي-سان

52
00:06:24,860 --> 00:06:26,940
تاكاياناغي-سان، ما الّذي يحدث؟

53
00:06:26,940 --> 00:06:28,740
.هذا هو واقع هذه البلاد

54
00:06:34,790 --> 00:06:35,620
.إيّاك

55
00:06:35,620 --> 00:06:37,040
.هنالك شخص مصاب

56
00:06:37,040 --> 00:06:38,500
.ستُقتل إن ذهبْت

57
00:06:41,670 --> 00:06:42,500
.سيقتلونها

58
00:07:01,150 --> 00:07:03,730
!هذا هو الواقع الّذي تحدّثتَ عنه

59
00:07:05,650 --> 00:07:08,690
،قد يكون تقبُّله صعبًا عليك بصفتك طبيبًا

60
00:07:08,690 --> 00:07:09,990
،ولكن، في هذه البلاد

61
00:07:09,990 --> 00:07:13,700
.لا تزيد قيمة حياة المرء عن الحصى

62
00:07:13,700 --> 00:07:14,780
.شكرًا لك

63
00:07:15,280 --> 00:07:18,540
إذًا، لماذا لا تزال هنا؟

64
00:07:19,040 --> 00:07:23,040
.لأخبر العالم بحقيقة هذه الحرب الهوجاء

65
00:07:23,040 --> 00:07:26,630
.ربّما قد يساعد ذلك على إيقاف هذه المأساة

66
00:07:27,960 --> 00:07:32,130
.حسنًا، قد تكون هذه مجرّد غرائزي كصحفي فحسب

67
00:07:32,970 --> 00:07:35,970
...تاكاياناغي-سان، بشأن الذّهاب إلى دالات

68
00:07:35,970 --> 00:07:38,560
أنت، ألم تستسلم بعد؟

69
00:07:39,060 --> 00:07:40,640
لماذا لا تدرك الأمر؟

70
00:07:40,640 --> 00:07:44,060
ألم ترَ مدى خطورة هذا المكان؟

71
00:07:44,560 --> 00:07:46,020
.أعرف ذلك

72
00:07:48,070 --> 00:07:51,820
.ولكن، عليّ العثور على يابو-سان

73
00:07:52,240 --> 00:07:53,990
ولماذا؟

74
00:07:53,990 --> 00:07:55,320
...لماذا أنت

75
00:07:55,620 --> 00:08:01,330
حسنٌ، لقد تعرّضنا معًا لعملية اختطاف
.وكدنا نخسر أعضاءنا جرّاء ذلك

76
00:08:01,830 --> 00:08:03,830
...ما هذا المزاح

77
00:08:10,260 --> 00:08:13,590
.إنّه ليس سيّئًا في الحقيقة

78
00:08:15,300 --> 00:08:17,350
،في الواقع، نحن ذاهبون بعدَ غدٍ

79
00:08:17,350 --> 00:08:22,680
،وهنالك وحدة نقل ذاهبة إلى دالات
.ومن المفترض أن أذهب معهم لتغطية مقال ما

80
00:08:23,060 --> 00:08:26,810
.أستطيع أن أطلب منهم أن يسمحوا لك بمرافقتنا لو أحببت

81
00:08:27,150 --> 00:08:29,070
...حسنًا، إن كان ذلك ممكنًا

82
00:08:29,690 --> 00:08:31,110
.لا يوجد أيّ مانع

83
00:08:50,170 --> 00:08:52,380
.ساحة المعركة إذًا

84
00:09:10,610 --> 00:09:12,110
.هذا بوب

85
00:09:12,110 --> 00:09:14,900
.إنّه قائد وحدة النّقل الّذي أخبرتُك عنها البارحة

86
00:09:15,820 --> 00:09:17,160
.أهلاً يا فتى

87
00:09:18,120 --> 00:09:22,660
.وهاته مرشدتهم ومترجمتهم فان

88
00:09:23,330 --> 00:09:24,370
.سررتُ بلقائك

89
00:09:24,370 --> 00:09:25,160
.وأنا كذلك

90
00:09:25,750 --> 00:09:28,710
.حصلتُ على موافقة بمرافقتك لنا

91
00:09:29,080 --> 00:09:31,170
.ظهر مكان شاغر للتّوّ

92
00:09:31,630 --> 00:09:33,090
حقًا؟

93
00:09:33,090 --> 00:09:34,590
.لا مشكلة

94
00:09:34,590 --> 00:09:35,670
.أنا ممتنٌ لك

95
00:09:36,010 --> 00:09:38,010
.لستَ بحاجة لتشكرني

96
00:09:38,430 --> 00:09:42,140
،كما أنّني قرّرتُ إحضارك معنا

97
00:09:42,140 --> 00:09:44,680
.لأنّي شممتُ رائحة مقال لم يرَ النّور بعد

98
00:10:08,120 --> 00:10:09,710
هل أنت واثق من هذا؟

99
00:10:09,710 --> 00:10:13,210
،فبمجرّد أن نُقلع
.فلن يعود هنالك مجال للعودة

100
00:10:13,630 --> 00:10:14,880
.سأكون على ما يرام

101
00:10:18,220 --> 00:10:19,220
ما الخطب؟

102
00:10:19,470 --> 00:10:25,220
.لا شيء، كلّ ما هنالك أنّ النّظر إليك يذكّرني بيابو

103
00:10:25,640 --> 00:10:26,890
يابو-سان؟

104
00:10:27,930 --> 00:10:32,480
صحيح، لقد أخبرتُك أنّي ذهبتُ
لأطمئنّ عليه مرّة، أليس كذلك؟

105
00:10:32,480 --> 00:10:36,740
.سألتُه حينها عن سبب مجيئه لمكان خطير كهذا

106
00:10:37,780 --> 00:10:38,900
...فردّ عليّ قائلاً

107
00:10:40,200 --> 00:10:43,450
.توجد مأساة كلّ يوم هنا

108
00:10:43,780 --> 00:10:46,750
.كنتُ قادرًا على الهرب في اليابان

109
00:10:47,120 --> 00:10:50,120
.ولكن، لا يمكن للمرء أن يهرب هنا

110
00:10:50,120 --> 00:10:52,710
.بالأحرى، أنا لا أريد أن أهرب بعد الآن

111
00:10:54,750 --> 00:10:56,800
يابو-سان قال ذلك؟

112
00:11:18,740 --> 00:11:19,780
.شكرًا لك

113
00:11:20,150 --> 00:11:22,280
.أنتما أيضًا، إصعدا بسرعة

114
00:11:30,710 --> 00:11:33,670
.أتمنّى لو تخفّ شدّة حرارة الشّمس

115
00:11:35,090 --> 00:11:37,340
،تحمّل هذا الحرّ على الأقل

116
00:11:38,000 --> 00:11:39,800
.إذا كنتَ لا تريد الموت

117
00:11:40,590 --> 00:11:42,930
لماذا نحن فوق المركبة؟

118
00:11:43,760 --> 00:11:49,220
يجب أن نقلق من الألغام تحت الأرض
.أكثر من العدوّ الّذي فوقها

119
00:11:57,070 --> 00:11:59,940
.لا تبدو لي خائفًا على الإطلاق

120
00:12:02,070 --> 00:12:04,450
،بالطّبع أنا خائف

121
00:12:04,700 --> 00:12:08,700
.لكنّ إظهار توتّري لن يحل أيّ شيء

122
00:12:09,040 --> 00:12:12,160
،على ذكر هذا، لم أرغب بالسؤال عن ذلك ولكن

123
00:12:12,580 --> 00:12:15,710
ما هي الطريقة الّتي أتيتَ بها إلى الفيتنام؟

124
00:12:16,040 --> 00:12:18,210
كيف أتيتُ إلى هنا؟

125
00:12:18,710 --> 00:12:20,380
حسنًا،ألستُ محقًا في سؤالي؟

126
00:12:20,380 --> 00:12:24,890
فمن المستحيل في العادة لشخص عاديّ
،أن يأتي إلى ساحة معركة حامية كهذه

127
00:12:24,890 --> 00:12:26,970
.ناهيك عن مجيء طالب طبّ

128
00:12:27,800 --> 00:12:29,260
.هذا ما قصدتَه

129
00:12:29,720 --> 00:12:33,350
.لقد طلبتُ هذا من صديق بالطّبع

130
00:12:40,730 --> 00:12:42,070
.أنت على ما يرام

131
00:12:42,070 --> 00:12:43,610
.يعمل القلب على أحسن وجه

132
00:12:43,860 --> 00:12:45,860
...إذًا فالجراحة قد

133
00:12:45,860 --> 00:12:48,240
.كانت ناجحة بالكامل

134
00:12:48,410 --> 00:12:49,790
...أنت بالفعل

135
00:12:49,790 --> 00:12:51,620
.منقذنا

136
00:12:51,620 --> 00:12:55,580
.لقد أنقذتنا

137
00:12:56,420 --> 00:12:59,500
.اتركوني مع الطّبيب للحظة

138
00:13:00,050 --> 00:13:01,090
.حسنًا

139
00:13:07,930 --> 00:13:09,510
.لم يعد  هناكَ ما يبعث على القلق بعد الآن

140
00:13:10,350 --> 00:13:13,390
.التحم وجه كانياما مع أدَمتِك

141
00:13:14,520 --> 00:13:17,100
،بشأن ما تحدّثنا عنه سابقًا

142
00:13:17,100 --> 00:13:19,860
أتنوي بالفعل الذّهاب لفيتنام؟

143
00:13:20,690 --> 00:13:24,030
.عليّ أن أعثر على يابو-سان مهما كان الثّمن

144
00:13:26,150 --> 00:13:30,370
.أنا مدين بشكل كبير ليابو أيضًا

145
00:13:31,370 --> 00:13:32,790
،حسنًا

146
00:13:32,790 --> 00:13:35,710
.سأطلب من الطّائفة أن تحلّ مشكلة التأشيرة

147
00:13:50,390 --> 00:13:52,810
.أهلاً يا يوشي-كُن

148
00:13:54,980 --> 00:13:56,810
.إليك طعامك

149
00:13:57,390 --> 00:13:59,060
.هيّا كُل

150
00:14:06,570 --> 00:14:07,820
!يا لي من غبيّة

151
00:14:08,280 --> 00:14:11,240
لماذا عليّ أن أكون سعيدة بشأن هذا؟

152
00:14:12,870 --> 00:14:20,250
،من يظنّ نفسه على كلّ حال
بطلبه منّي أن أرعى أسماكه لأنّه اضطرّ لمغادرة البلاد؟

153
00:14:48,190 --> 00:14:49,610
.أنت شديد البأس

154
00:14:50,360 --> 00:14:51,820
.بالطّبع

155
00:14:51,820 --> 00:14:56,120
تقع مسؤولية إعادة كلّ فرد من وحدتي
.إلى ديارهم سالمين على عاتقي

156
00:14:57,200 --> 00:14:58,120
مسؤوليّة؟

157
00:14:58,540 --> 00:15:02,630
لقد تمّ إرسالهم إلى هنا جميعًا
.تاركين عائلاتهم خلفهم

158
00:15:04,590 --> 00:15:09,130
.لهذا السّبب عليّ أن أحميهم مهما كان الثّمن

159
00:15:09,550 --> 00:15:13,260
،"حسنًا، رُغم أنَ حربكم هي مع "الفيت كونغ

160
00:15:13,260 --> 00:15:18,100
.إلا أنّكم لازلتم تصوّبون أسلحتكم نحو أُناس آخرين في فيتنام

161
00:15:19,390 --> 00:15:21,690
.أنت، لا تفهم الأمر بشكل خاطئ

162
00:15:22,150 --> 00:15:25,360
.نحن لسنا هنا لقتل الفيتناميّين

163
00:15:25,360 --> 00:15:26,520
.بل لحمايتهم

164
00:15:28,530 --> 00:15:33,530
.لكنّهم لا يدركون حتّى ذلك

165
00:15:34,490 --> 00:15:36,530
.دعني أخبرك ما الّذي حدث قبل أسبوع

166
00:15:36,870 --> 00:15:42,420
وصلتنا رسالة طارئة عن هجوم ما
.فعجّلنا إلى هناك لنجد أنّه كان لغمًا

167
00:15:42,830 --> 00:15:45,960
،تعرّض اثنان من جنودنا للانفجار وماتا

168
00:15:45,960 --> 00:15:50,720
لكنّ القرويّين كانوا يعملون في حقولهم
.وكأنّ شيئًا لم يحدث

169
00:15:52,590 --> 00:15:56,050
.كانوا يحاولون عيشَ حياتهم ببساطة ليس إلا

170
00:15:56,550 --> 00:15:59,310
أتعرف حتّى كيف هي حياتهم؟

171
00:15:59,930 --> 00:16:02,060
ما رأيكِ أنتِ؟

172
00:16:02,480 --> 00:16:07,770
صحيح أنّ الكثير من النّاس في هذه البلاد
.قد وقعوا ضحيّة للهجمات بين الطّرفين ولقوا حتفهم

173
00:16:08,190 --> 00:16:12,900
ولكن، ما باليد حيلة، لأنه علينا أن نحمي
.هذه البلاد من الشّمال

174
00:16:13,860 --> 00:16:14,860
...إن لم نفعل

175
00:16:15,570 --> 00:16:16,620
.اسمعوا

176
00:16:16,620 --> 00:16:18,330
،أراهن أنّكم لا تعرفون هذا

177
00:16:18,330 --> 00:16:24,250
لكنّ هذه الحكومة لا تستطيع حتّى
.صدّ الهجمات عن سايغون من دوننا نحن الجنود الأمريكيّون

178
00:16:24,250 --> 00:16:25,330
...فبدوننا

179
00:16:29,670 --> 00:16:31,380
.لقد أصيبتْ مركبة غوردون

180
00:16:31,380 --> 00:16:32,300
.أسرِع بنا

181
00:16:37,430 --> 00:16:38,640
.نحن نتعرّض لهجوم العدوّ

182
00:16:39,180 --> 00:16:40,270
.واصل التقدُم

183
00:16:40,270 --> 00:16:41,930
.تشبّثوا جيدًا

184
00:16:45,980 --> 00:16:47,310
.لا تتوقّف

185
00:16:47,310 --> 00:16:48,400
.استمرّ في التّقدّم

186
00:17:07,710 --> 00:17:08,630
.سُحقًا

187
00:17:19,970 --> 00:17:21,180
...هذه هي

188
00:17:27,190 --> 00:17:28,310
...هذه

189
00:17:29,480 --> 00:17:30,770
.هي الحرب ...

190
00:17:45,540 --> 00:17:46,870
.لا تبرحا جانبي

191
00:17:48,370 --> 00:17:49,380
.لا تتحرّك

192
00:17:49,710 --> 00:17:51,340
.ابقَ منبطحًا

193
00:18:30,880 --> 00:18:31,920
.ستيف

194
00:18:37,090 --> 00:18:37,920
!جيم

195
00:18:44,680 --> 00:18:45,930
.لا يزال يتنفّس

196
00:18:48,180 --> 00:18:49,440
!روبيرت

197
00:18:52,520 --> 00:18:53,440
.سُحقًا

198
00:18:53,820 --> 00:18:55,440
...ذلك النّزيف

199
00:18:55,690 --> 00:18:58,440
.أنا واثق أنّه أُصيب في شريان ما

200
00:19:00,660 --> 00:19:04,450
،على هذه الحال، إن لم أفعل شيئًا
.فسينزف حتّى الموت

201
00:19:06,790 --> 00:19:08,200
،في هذه البلاد

202
00:19:08,200 --> 00:19:12,040
.لا تزيد قيمة حياة المرء عن الحصى

203
00:19:14,380 --> 00:19:16,210
هل الخيار الوحيد هو تقبُّل الهزيمة؟

204
00:19:16,840 --> 00:19:19,260
هل هذا هو الواقع؟

205
00:19:19,880 --> 00:19:23,930
.أنا لا أريد أن أهرب بعد الآن

206
00:19:27,680 --> 00:19:30,520
...هذا صحيح، أعلمُ أنّني قادرٌ

207
00:19:36,320 --> 00:19:37,650
.على إنقاذه ...

208
00:19:40,610 --> 00:19:43,110
.أيّها الغبيّ، لا تذهب إلى هناك

209
00:19:45,370 --> 00:19:47,370
...إ-إنّه

210
00:19:47,790 --> 00:19:48,910
!مذهل

211
00:19:48,910 --> 00:19:50,370
!هذا عظيم

212
00:19:51,120 --> 00:19:53,370
!عظيم للغاية، لا أستطيع كبح حماسي

213
00:19:55,960 --> 00:19:57,710
.لا أستطيع إيقاف النّزيف

214
00:19:57,710 --> 00:20:00,670
.شريانُه السُّباتيّ الأيسر قد قُطع كما توقعت

215
00:20:01,050 --> 00:20:03,890
.لكنّني لا أستطيع إصلاح الشّريان الآن

216
00:20:07,220 --> 00:20:08,430
.سينجح هذا

217
00:20:08,430 --> 00:20:10,680
.شريانُه السُّباتيّ الباطنيّ الأيمن بخير

218
00:20:10,680 --> 00:20:14,020
أستطيع أن أصل الشّريان السُّباتيّ
.الباطنيّ الأيسر بكلا الطّرفين

219
00:20:14,020 --> 00:20:15,900
،حتّى وإن توقّفت الدّورة الدّموية في الجهة اليسرى

220
00:20:16,150 --> 00:20:18,940
.فستُأمّن الجهة اليمنى أدنى المتطلّبات للنّجاة

221
00:20:21,820 --> 00:20:22,860
!ما...؟

222
00:20:22,860 --> 00:20:25,410
!هل ستُجري عمليّة في وسط ساحة معركة؟

223
00:20:33,000 --> 00:20:37,170
!إنّه جاد في محاولة إنقاذه لستيف

224
00:20:37,840 --> 00:20:42,170
!لقد أقصى القتال الجاري حوله بالكامل

225
00:20:49,470 --> 00:20:55,810
!إنّه مُنْقاد فقط بغرائزه كطبيب في الوقت الحاليّ

226
00:21:00,690 --> 00:21:02,400
.لا تقفوا في طريقي

227
00:21:34,930 --> 00:21:36,060
.انتهيت

228
00:21:46,360 --> 00:21:47,530
...يابو-سان

229
00:21:47,950 --> 00:21:51,830
.أعتقد أنّي لا أستطيع البحث عنك بعد الآن

230
00:21:55,250 --> 00:21:57,080
،تلك كانت ساحة معركة

231
00:21:57,580 --> 00:22:02,590
.ولكن، لم يكن هنالك أيّ خوف في جوف هازاما من أن يكون أسيرًا

232
00:22:02,960 --> 00:22:07,090
.بل كان ممتلئًا بالرّضا فحسب لأنّه أنقذ حياةً ثمينة

233
00:23:39,930 --> 00:23:49,600
[        ]

234
00:23:39,930 --> 00:23:49,600
_____

235
00:23:39,930 --> 00:23:49,600
في الحلقة القادمة

236
00:23:41,310 --> 00:23:43,060
،سيذهب لأيّ مكان

237
00:23:43,060 --> 00:23:45,480
.مادام هنالك مريض في انتظاره هناك

238
00:23:46,110 --> 00:23:47,820
.سيدخل معركة حامية الوطيس مباشرة ودون تردّد

239
00:23:48,070 --> 00:23:50,570
.إصراره كطبيب يسير على قدم المساواة مع الجنون

240
00:23:50,570 --> 00:23:52,320
،أسطورة في ساحة المعركة

241
00:23:52,320 --> 00:23:53,660
.طبيب أصبح حديث الجميع

242
00:23:54,160 --> 00:23:55,530
وماذا في ذلك؟

243
00:23:55,700 --> 00:23:57,580
.هذا متوقّع تمامًا من طبيب

244
00:23:57,580 --> 00:24:01,790
،من يأبه للشّمال أو الجنوب
ما دام المريض بحاجة إليه؟

245
00:24:02,170 --> 00:24:04,380
".في الفيتنام، الجزء الثاني"

246
00:24:05,080 --> 00:24:06,500
".إنّ الطّيور على أشكالِها تَقع"

247
00:24:07,090 --> 00:24:09,800
.يمكنهما معرفة بعضهم بعضًا عن طريق حمل المبضع