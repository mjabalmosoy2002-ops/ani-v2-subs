1
00:00:00,000 --> 00:00:25,250
: تفضَّلوا بزيارتنا على

2
00:00:07,340 --> 00:00:10,100
نفس القوَّة ، ونفس الصَّوت

3
00:00:10,100 --> 00:00:12,350
فهمت . إنَّهُ أمرٌ عجيب

4
00:00:12,730 --> 00:00:15,320
قواكِ أثارت إعجابي

5
00:00:15,940 --> 00:00:17,150
وجودكِ يُثير إشمئزازي

6
00:00:17,610 --> 00:00:19,200
حان الوقت لإنهاء هذا

7
00:01:57,550 --> 00:02:01,050
! الأُستاذ هابي في محاضرةٍ عن فيري تيل

8
00:02:01,390 --> 00:02:05,850
هذه المرَّة ، سأقوم بالتحدُّث عن موطني وموطن شاريل ، إيدولاس

9
00:02:05,850 --> 00:02:11,270
العالم الذي نعيش فيه يسمَّى
الأرض ، وهو عالمٌ آخر ومُختلف عن إيدولاس

10
00:02:11,270 --> 00:02:15,610
في إيدولاس ، القوى السحريَّة محدودة
وسيأتي يومٌ ينفذ فيه بشكلٍ نهائي

11
00:02:15,610 --> 00:02:22,870
وبسبب هذا ، قام الملك فاوست بإستخدام
سحر الأنيما وإمتصَّ بذلك قوىً سحريَّةً من الأرض

12
00:02:22,870 --> 00:02:26,240
المجموعة وسكَّان ماجنوليا قد تحوَّلوا جميعًا إلى لاكريما

13
00:02:26,240 --> 00:02:29,710
ونحنُ نُقاتل الآن من أجل إعادتهم لطبيعتهم

14
00:02:30,160 --> 00:02:34,630
بالمناسبة ، نستثني المجموعة التي
بها شبيه ناتسو والبقيَّة من إيدولاس

15
00:02:34,630 --> 00:02:36,720
لكن إيرزا الإيدولاس عدوَّةٌ لنا

16
00:02:36,720 --> 00:02:39,010
هذا مخيف ، ولا تشعرون بالراحة ، صحيح ؟

17
00:02:39,020 --> 00:02:42,520
هذا كلُّ شيء . لنعد إلى القصَّة الآن

18
00:02:42,860 --> 00:02:44,590
قِفوا ، وقدِّموا إحترامكم

19
00:02:44,590 --> 00:02:45,720
حاضر يا سيِّدي

20
00:03:04,450 --> 00:03:06,160
إنَّها هي

21
00:03:06,660 --> 00:03:08,580
أليست تلك هي الخاسرة ؟

22
00:03:08,580 --> 00:03:10,210
يوجد معها إنسانٌ أيضًا

23
00:03:10,210 --> 00:03:12,080
لم أرى واحدًا من قبل

24
00:03:12,080 --> 00:03:13,620
! إنَّها إنسانة ، إنَّها إنسانة

25
00:03:14,120 --> 00:03:16,170
مالذي تفعله هنا ؟

26
00:03:16,170 --> 00:03:17,910
مالذي يجري ؟

27
00:03:17,910 --> 00:03:19,430
... الخاسرة

28
00:03:19,430 --> 00:03:22,260
قامت بجلب إنسانةٍ معها

29
00:03:24,760 --> 00:03:26,720
دعوني أقابل المَلِكَة

30
00:03:27,310 --> 00:03:29,970
إكستاليا في خطرٍ عظيم

31
00:03:45,240 --> 00:03:46,680
إبتعدوا ، إبتعدوا

32
00:03:46,680 --> 00:03:48,380
دعوني أمُرّ

33
00:03:47,120 --> 00:03:48,380
إنَّه سيِّدي نادي

34
00:03:48,380 --> 00:03:49,950
ظهر في الوقت المناسب

35
00:03:50,790 --> 00:03:52,290
لقد خالفتما القوانين

36
00:03:52,290 --> 00:03:55,980
الخاسرون والبشر ممنوعين من دخول إكستاليا

37
00:03:55,980 --> 00:03:58,090
الوقت غير مناسبٌ لهذا

38
00:03:58,460 --> 00:04:01,840
إن كنتم تخشون على أرواحكم فإستمعوا لنا

39
00:04:01,840 --> 00:04:05,510
أين نيتشيا وبقيَّة الحرَّاس اللذين لاحقوكما ؟

40
00:04:05,840 --> 00:04:08,260
لقد تحوَّلوا إلى لاكريما عن طريق الجيش الملكيّ

41
00:04:24,490 --> 00:04:28,820
الحرَّاس الملكيِّين لإكستاليا هُزموا من قِبل البشر ؟

42
00:04:28,820 --> 00:04:31,050
أتعتقدين بأنَّنا سنُصدِّقُ شيئًا سخيفًا كهذا ؟

43
00:04:31,050 --> 00:04:34,620
! إنَّها الحقيقة ! الجيش الملكيُّ سيُهاجمكم قريبًا

44
00:04:34,910 --> 00:04:36,460
وإن يكن

45
00:04:36,460 --> 00:04:39,420
ملِكَتُنا ستُمحيهم بسحرها

46
00:04:39,420 --> 00:04:40,420
هذا صحيح

47
00:04:42,380 --> 00:04:45,840
أيُّها الرفاق ، إن لم تهربوا فستكونون في خطرٍ كبير

48
00:04:45,840 --> 00:04:47,590
أصمتِ أيَّتها الآدميَّة

49
00:04:48,720 --> 00:04:49,550
وندي

50
00:04:49,800 --> 00:04:52,350
أنتِ لا تعلمين شيئًا عن قوَّة ملِكَتنا

51
00:04:51,640 --> 00:04:54,260
نحن الإكسيد

52
00:04:54,260 --> 00:04:56,140
لسنا مثل البشر

53
00:04:57,060 --> 00:04:58,770
! توقَّفوا عن هذا

54
00:05:08,070 --> 00:05:09,910
أخرجي أيَّتها الآدميَّة ، وأنتِ أيضًا أيَّتها الخاسرة

55
00:05:09,910 --> 00:05:13,490
هذه الأرض المباركة من مَلِكَة إكستاليا

56
00:05:13,490 --> 00:05:15,010
لن نخسر من البشر أبدًا

57
00:05:15,010 --> 00:05:16,830
طالما أنَّ المَلِكَة في صفِّنا

58
00:05:21,680 --> 00:05:22,750
... إن كُنتم

59
00:05:22,750 --> 00:05:26,010
إن كُنتم تكرهون البشر لهذا الحد ، فإفعلوا ما تشاؤون بي

60
00:05:26,010 --> 00:05:27,720
! لكن اتركوا شاريل

61
00:05:28,130 --> 00:05:30,180
فهي واحدةٌ منكم

62
00:05:30,180 --> 00:05:33,660
أرجوكم ، إستمعوا إلى ما ستقوله

63
00:05:35,100 --> 00:05:36,430
وندي

64
00:05:36,890 --> 00:05:46,530
اخرجوا ! اخرجوا ! اخرجوا ! اخرجوا

65
00:05:54,950 --> 00:05:57,580
!لماذا ؟ لماذا ؟

66
00:06:08,470 --> 00:06:09,880
جاجيل

67
00:06:15,280 --> 00:06:19,170
غير مسلَّح ، وتستطيع إيقاف سيفي الحديديّ ؟

68
00:06:19,170 --> 00:06:22,230
سحر الأرضيِّين مليءٌ بالمفاجآت

69
00:06:22,940 --> 00:06:26,590
دعني أخبرك أمرًا ، التنِّين الحديديَّ يختلف عن الحديد العاديّ

70
00:06:26,590 --> 00:06:29,610
على كلٍّ ، ألست أحد القِطَط ؟

71
00:06:29,950 --> 00:06:31,990
لمَ تعمل لصالح الجيش الملكي ؟

72
00:06:34,160 --> 00:06:36,120
لو سمحت

73
00:06:36,410 --> 00:06:39,870
أنت مثلي من الإكسيد ، صحيح ؟

74
00:06:41,460 --> 00:06:43,790
أتُريد ... سمكة ؟

75
00:06:45,960 --> 00:06:47,420
كان ذلك في الماضي

76
00:06:49,550 --> 00:06:51,260
لقد تخلَّيت عنهم

77
00:06:51,590 --> 00:06:53,220
! لأنَّه موطنٌ زائف

78
00:07:00,390 --> 00:07:02,140
موطنٌ زائف ؟

79
00:07:04,400 --> 00:07:06,150
منبوذٌ إذًا ؟

80
00:07:06,860 --> 00:07:09,570
هذا جيِّد ، إنَّك مثلي تمامًا

81
00:07:18,410 --> 00:07:19,870
لقد قرَّرت

82
00:07:27,720 --> 00:07:30,210
سأجعل هذا الشَّخص قطًّا خاصًّا بي

83
00:07:31,720 --> 00:07:33,880
... الزَّعيم مام قد

84
00:07:37,810 --> 00:07:41,060
لكن أولاً ، سأريك من الأقوى بيننا

85
00:07:41,810 --> 00:07:45,230
إنَّها المرَّة الأولى التي أراهُ يتصرَّف هكذا

86
00:07:46,770 --> 00:07:51,190
لن أسمح بتفوُّق سَلامندر أو تلك الفتاة عليّ

87
00:07:51,780 --> 00:07:52,780
... إنَّه

88
00:07:52,780 --> 00:07:55,070
زئير التنِّين الحديديّ

89
00:08:07,120 --> 00:08:10,210
جاجيل مُخيفٌ جدًا

90
00:08:14,800 --> 00:08:16,890
هكذا يجب أن يكون الوضع

91
00:08:19,310 --> 00:08:20,310
إنَّك قوي

92
00:08:35,460 --> 00:08:39,370
جاجيل ، أنسيت سبب وجودنا هنا ؟

93
00:08:47,920 --> 00:08:50,500
أنا ساحر الجليد

94
00:08:50,500 --> 00:08:52,170
أستطيع صناعة المفتاح بالعدد الذي أشاؤه

95
00:08:54,800 --> 00:08:56,220
! جراي

96
00:08:56,220 --> 00:08:56,970
ناتسو

97
00:08:58,260 --> 00:09:00,160
وأخيرًا لحقتُ بك أيُّها اللقيط

98
00:09:00,160 --> 00:09:02,060
أخبرتك بأن تدع الأمر لي ، ألا تذكر ؟

99
00:09:02,060 --> 00:09:04,020
أين المفتاح ؟

100
00:09:04,020 --> 00:09:05,210
سلِّمني إيَّاه يا هذا

101
00:09:05,210 --> 00:09:06,610
يا صاحب الذقن اللقيط

102
00:09:06,610 --> 00:09:09,860
ألم تلاحظ ما بيدي ؟

103
00:09:10,360 --> 00:09:12,150
على أيَّة حال ، نحن بخيرٍ الآن

104
00:09:12,150 --> 00:09:14,190
فالوضع تغيَّر قليلاً

105
00:09:14,490 --> 00:09:15,440
أين لوسي ؟

106
00:09:17,360 --> 00:09:18,610
... هذا صحيح

107
00:09:18,610 --> 00:09:19,840
إنَّها عالقة

108
00:09:19,840 --> 00:09:21,240
مالذي تقصده ؟

109
00:09:21,240 --> 00:09:22,990
قليلاً فقط

110
00:09:22,990 --> 00:09:25,790
صدركِ كبيرٌ جدًا

111
00:09:26,460 --> 00:09:29,210
على كلِّ حال ، بإمكاننا إستخدام هذا المفتاح يا ناتسو

112
00:09:29,210 --> 00:09:31,920
من أجل إنقاذ أصدقاؤنا

113
00:09:31,920 --> 00:09:32,710
ماذا ؟

114
00:09:33,050 --> 00:09:34,920
خطَّتهم كانت عن طريق إستخدام مدفع سلسلة التنِّين

115
00:09:34,920 --> 00:09:38,880
من أجل سحب الجزيرة التي بها
اللاكريما وجعلها تصطدم بإكستاليا

116
00:09:40,470 --> 00:09:41,220
لكن

117
00:09:44,120 --> 00:09:46,930
لو جعلنا مدفع سلسلة التنِّين المدموج بسحر قاتل التنَّانين

118
00:09:46,930 --> 00:09:49,060
يصطدم مباشرةً باللاكريما

119
00:09:50,850 --> 00:09:52,730
فيُمكننا حينها إرجاع الرفاق إلى طبيعتهم

120
00:09:54,020 --> 00:09:56,110
هكذا إذًا ! مع أنَّني لم أفهم شيء

121
00:09:56,650 --> 00:09:58,390
يبدو أنَّ مدفع سلسلة التنِّين أمامنا

122
00:09:59,240 --> 00:10:00,530
حسنًا ، لننطلق

123
00:10:00,990 --> 00:10:02,700
لكن هنالك عقبةٌ ما

124
00:10:04,120 --> 00:10:06,620
لا يُمكننا الدخول لتلك الغُرفة

125
00:10:06,620 --> 00:10:09,040
إذًا لندخلها بالقوَّة

126
00:10:09,040 --> 00:10:11,330
أنسيت بأنَّني أستطيع إستخدام السِّحر الآن ؟

127
00:10:12,090 --> 00:10:13,790
لن ينجح هذا

128
00:10:13,790 --> 00:10:21,090
يوجد جهازٌ يقوم بتعطيل السِّحر ، وتُصبح القوى بلا فائدة

129
00:10:21,510 --> 00:10:23,720
لن نعلم ذلك دون أن نحاول ، صحيح ؟

130
00:10:23,720 --> 00:10:25,350
علينا أولاً أن نضع خطة

131
00:10:33,810 --> 00:10:35,570
ها أنتُما

132
00:10:36,280 --> 00:10:37,230
إيرزا

133
00:10:37,230 --> 00:10:41,280
كلاَّ ... تمهَّل ، إنَّها شبيهتها الإيدولاس

134
00:10:43,250 --> 00:10:44,500
تبًّا

135
00:10:45,910 --> 00:10:47,910
... إيرزا التي نعرفها

136
00:10:49,060 --> 00:10:50,460
!خسِرت ؟

137
00:11:02,510 --> 00:11:04,800
هل أنتِ بخير أيَّتها القائدة نايتووكر ؟

138
00:11:04,800 --> 00:11:06,610
! ما هذا ؟ أنظر إليها

139
00:11:06,610 --> 00:11:09,360
من أين حصلتِ على هذه الإصابات ؟

140
00:11:09,360 --> 00:11:11,020
إنَّها مجرَّد خدوش

141
00:11:11,020 --> 00:11:12,990
وهذين ... ؟

142
00:11:12,990 --> 00:11:14,860
إنَّهما مفتاح تشغيل مدفع سلسلة التنِّين

143
00:11:15,150 --> 00:11:16,480
الـ ... المفتاح ؟

144
00:11:17,320 --> 00:11:18,610
هل جلالته بالدَّاخل ؟

145
00:11:20,150 --> 00:11:20,780
تفضَّلي

146
00:11:26,740 --> 00:11:29,170
إنتهت جميع الإستعدادات

147
00:11:30,000 --> 00:11:32,830
السِّحر الأبديّ ، أمام ناظرينا

148
00:11:47,580 --> 00:11:49,910
يا إلهي ، لقد تأخَّر كثيرًا

149
00:11:49,910 --> 00:11:52,380
قُم أنت بمناداتها

150
00:11:55,010 --> 00:11:57,760
مالذي تفعلينه هنا ؟

151
00:11:57,760 --> 00:11:59,170
الرفاق ينتظرونكِ

152
00:11:59,630 --> 00:12:01,050
أنتظر معلوماتي

153
00:12:01,760 --> 00:12:02,760
ماذا ؟

154
00:12:02,760 --> 00:12:04,920
أتخطِّطين لأمرٍ جديد ؟

155
00:12:04,920 --> 00:12:10,210
أريد آخر الأخبار إن كُنت أرغب في إقناع الجميع بما سأقول

156
00:12:10,210 --> 00:12:11,400
تقنعيننا ؟

157
00:12:11,400 --> 00:12:13,610
يـ ... ينتابني شعورٌ سيِّءٌ حيال هذا

158
00:12:14,060 --> 00:12:16,000
كيف هي أحوال الرفاق ؟

159
00:12:16,000 --> 00:12:19,880
علموا بأنَّكِ ستتحدَّثين معهم عن أمرٍ
ما ، ولذا لا يشعرون بالراحة يا لوسي

160
00:12:19,880 --> 00:12:21,070
هذا واضح

161
00:12:21,070 --> 00:12:25,410
فبعد أن إلتقت لوسي بأولئك الأشخاص من
العالم الآخر أصبحت حادَّة المزاج أكثر من قبل

162
00:12:25,410 --> 00:12:28,290
صدقت ، فهذا سيُخيف أيَّ شخص

163
00:12:28,290 --> 00:12:30,910
! يا لكم من جبانين يا هذين

164
00:12:31,210 --> 00:12:32,540
نحن آسفان

165
00:12:32,960 --> 00:12:33,920
! لا تختبئَ

166
00:12:52,350 --> 00:12:56,010
إيرزا ، أحقًّا أحضرتِ المفتاح معكِ ؟

167
00:12:56,010 --> 00:12:58,460
لقد حُطِّم ، لكن لا داعيَ للقلق

168
00:12:58,460 --> 00:12:59,400
ماذا ؟

169
00:13:01,740 --> 00:13:03,640
بإمكانه صنعُ المفتاح

170
00:13:03,640 --> 00:13:04,660
تبًّا

171
00:13:04,660 --> 00:13:05,870
ومن يكون ؟

172
00:13:05,870 --> 00:13:07,870
ساحرٌ من الأرض

173
00:13:07,870 --> 00:13:09,910
وصديقٌ لقاتل التَّنانين

174
00:13:11,950 --> 00:13:13,000
... أيُمكن أن يكونا

175
00:13:13,350 --> 00:13:16,120
لهم علاقةٌ بحادثة إختفاء اللاكريما في الساحة العامَّة ؟

176
00:13:16,120 --> 00:13:17,380
بالضبط

177
00:13:18,860 --> 00:13:20,380
لا بأس إذًا

178
00:13:20,380 --> 00:13:22,630
قوموا بتفعيل مدفعُ سلسلة التنِّين حالاً

179
00:13:24,470 --> 00:13:26,270
قِف يا ساحر الجليد

180
00:13:26,270 --> 00:13:27,970
ولا ترتكب أيَّ حماقة

181
00:13:32,770 --> 00:13:34,940
قُم بتفعيل مدفع سلسلة التنِّين

182
00:13:41,510 --> 00:13:43,820
أهذا هو مدفع سلسلة التنِّين ؟

183
00:13:44,490 --> 00:13:47,450
إنَّه مختلفٌ عمَّا تصوَّرته

184
00:13:48,190 --> 00:13:50,950
وبكلِّ تأكيد ضخمٌ جدًا

185
00:13:53,160 --> 00:13:54,370
هيَّا بسُرعة

186
00:13:56,180 --> 00:13:57,540
لا خيار أمامي

187
00:14:04,110 --> 00:14:05,940
هـ ... هذا مُدهش

188
00:14:05,940 --> 00:14:07,470
أهذا هو سحر الأرضيِّين ؟

189
00:14:07,470 --> 00:14:09,450
لكن ، لمَ هو مُتعرٍّ ؟

190
00:14:09,450 --> 00:14:12,470
