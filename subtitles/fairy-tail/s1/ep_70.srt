1
00:00:00,000 --> 00:00:19,120
: تفضَّلوا بزيارتنا على

2
00:00:01,710 --> 00:00:03,500
... سابقًا في فيري تيل

3
00:00:03,500 --> 00:00:06,720
، من أجل لقاء دافني التي زعمت بمقابلتها تنِّينًا

4
00:00:06,720 --> 00:00:09,300
" وجبَ علينا الذهاب إلى فندق الرحَّالة ويُدعى " رايز

5
00:00:09,300 --> 00:00:11,260
كان لديَّ شعورٌ سيءٌ حيال ذلك

6
00:00:11,260 --> 00:00:14,300
وبالطبع ، سقطنا في فخِّ العدو ، واحتُجزنا بشكلٍ كامل

7
00:00:14,300 --> 00:00:15,560
أجل ، أجل ، أجل

8
00:00:15,560 --> 00:00:17,640
كنتُ أنتظرك يا قاتل التنانين

9
00:00:17,640 --> 00:00:20,270
مالذي تفعله هنا يا جراي ؟

10
00:02:00,300 --> 00:02:01,510
جراي

11
00:02:01,510 --> 00:02:03,120
ما خطبُك يا جراي ؟

12
00:02:03,120 --> 00:02:05,200
تراجعي يا وندي

13
00:02:06,370 --> 00:02:07,880
إنَّه جاد

14
00:02:07,880 --> 00:02:09,670
جراي ، مالأمر ؟

15
00:02:09,670 --> 00:02:10,970
هل معدتك تؤلمك ؟

16
00:02:10,970 --> 00:02:12,550
! من المؤكَّد بأنَّ هذه ليست المشكلة

17
00:02:12,550 --> 00:02:13,380
جراي

18
00:02:13,380 --> 00:02:15,510
صُنعُ الجليد ... الرُمح

19
00:02:18,790 --> 00:02:20,460
ناتسو ، جراي

20
00:02:20,460 --> 00:02:22,060
مالذي يجري هنا ؟

21
00:02:22,800 --> 00:02:25,690
جراي ! لمَ تُهاجم ناتسو ؟

22
00:02:27,700 --> 00:02:28,940
أجل ، أجل ، أجل

23
00:02:28,940 --> 00:02:30,630
إنَّكم متفاجئون ، صحيح ؟

24
00:02:30,630 --> 00:02:33,640
لكن لا وقت لديكم للتراجع

25
00:02:34,010 --> 00:02:37,320
إقضي عليه يا جراي فولوباستر

26
00:02:37,320 --> 00:02:38,750
! كنتُ أنتظر هذا

27
00:02:38,750 --> 00:02:41,940
جراي ، أيها اللعين ! مالذي تفعله ؟

28
00:02:41,940 --> 00:02:43,930
لا شيء

29
00:02:43,930 --> 00:02:46,960
مجرَّد إزالتك لا أكثر

30
00:02:48,790 --> 00:02:50,840
توقَّف يا جراي

31
00:02:50,840 --> 00:02:54,090
مهلاً ، أمن الممكن أن يكون مزيَّفًا ؟

32
00:02:54,090 --> 00:02:55,510
فقد حدث الشيء نفسه من قبل

33
00:02:55,510 --> 00:02:56,970
! أنتِ محقَّة

34
00:02:56,970 --> 00:02:59,510
هناك أمرٌ مريبٌ في جراي الذي أمامنا

35
00:02:59,510 --> 00:03:00,780
أمرٌ مريب ؟

36
00:03:00,780 --> 00:03:01,950
مثل ماذا ؟

37
00:03:06,410 --> 00:03:09,260
حان الوقت لنكون جادَّين يا ناتسو

38
00:03:09,550 --> 00:03:10,500
لقد تعرَّى

39
00:03:10,500 --> 00:03:12,410
! إنَّهُ جراي الحقيقي

40
00:03:12,410 --> 00:03:13,610
أهذا ما كنت تقصده ؟

41
00:03:20,280 --> 00:03:23,140
أيها اللقيط . أأنت جادٌّ في هذا ؟

42
00:03:23,140 --> 00:03:24,490
ها أنا قادمٌ يا ناتسو

43
00:03:24,490 --> 00:03:27,160
صُنعُ الجليد ... فأس المعارك

44
00:03:27,160 --> 00:03:28,790
زئير تنِّين النار

45
00:03:35,850 --> 00:03:37,880
أجل ، أجل . هكذا هي الروح

46
00:03:37,890 --> 00:03:40,050
وبالتأكيد هو ليس بمزيَّف

47
00:03:40,050 --> 00:03:44,350
إنَّه الصادق الطيِّبُ جراي فولوباستر ، بشحمه ولحمه

48
00:03:46,610 --> 00:03:50,020
ومن أجل إزالة الريبة عن الأمر ، فأنا
لا أتحكَّمُ به عن طريق السحر

49
00:03:50,360 --> 00:03:52,900
إنَّه يفعل هذا من تلقاء نفسه

50
00:03:54,650 --> 00:03:56,480
لا داعيَ لإخباريَ بهذا

51
00:03:57,190 --> 00:04:01,610
فلا أحد يلكُمني ويجعلني أغضب سوى الحقيقيُّ جراي

52
00:04:01,860 --> 00:04:06,080
أتودُّ القول بأنَّ لكمتي الماضية كانت إختبارًا منك ؟

53
00:04:08,040 --> 00:04:10,170
مخلب تنِّين النار

54
00:04:12,080 --> 00:04:13,500
توقَّف يا هذا

55
00:04:13,960 --> 00:04:15,340
ناتسو

56
00:04:15,340 --> 00:04:16,960
يُبالغ كعادته

57
00:04:20,800 --> 00:04:22,440
هل إكتفيت ؟

58
00:04:22,440 --> 00:04:24,600
هيَّا إبدأ بشرح ما يجري هُنا

59
00:04:24,600 --> 00:04:26,600
مالذي تفكِّر فيه يا جراي ؟

60
00:04:26,600 --> 00:04:28,330
مدينةٌ بلا صوت

61
00:04:28,600 --> 00:04:31,590
مدينةٌ بلا صوت ؟

62
00:04:31,590 --> 00:04:32,850
مالذي تتحدَّث عنه ؟

63
00:04:32,850 --> 00:04:34,860
لن تفهم

64
00:04:34,860 --> 00:04:37,350
لكن هذا لا يهم

65
00:04:37,350 --> 00:04:39,110
! سأُمحيك عن الوجود

66
00:04:41,910 --> 00:04:44,780
مُدهش . قواهما متساويتان

67
00:04:44,780 --> 00:04:47,000
! هذا ليس وقت إبداء الإعجاب

68
00:04:47,730 --> 00:04:49,570
ما هذا الذي يجدث ؟

69
00:04:49,570 --> 00:04:51,390
لمَ جراي يفعل ذلك ؟

70
00:04:51,740 --> 00:04:56,230
جراي فولوباستر تطوَّع بنفسه ليساعدني

71
00:04:56,230 --> 00:04:57,700
تطوَّع ؟

72
00:04:57,700 --> 00:05:00,970
لقد أتيت لماجنوليا قبل عشرةِ أيَّام

73
00:05:00,970 --> 00:05:04,550
، عندما بدأت التحقيق عن منشأ ناتسو دراجنيل

74
00:05:05,920 --> 00:05:13,120
قابلت جراي فولوباستر صُدفةً وقد
أبدى إهتمامًا بما أفعل ، وتطوَّع لمساعدتي

75
00:05:13,770 --> 00:05:15,690
والآن هو شريكي

76
00:05:16,270 --> 00:05:18,880
! هذه خيانةٌ عُظمى

77
00:05:18,880 --> 00:05:21,370
غير معقول . لا استطيع تصديق ذلك

78
00:05:21,370 --> 00:05:24,950
... إذًا هذا يعني بأنَّ جراي ودافني

79
00:05:25,490 --> 00:05:27,680
! مُعجبان ببعض ...

80
00:05:27,970 --> 00:05:28,870
شيءٌ من هذا القبيل

81
00:05:28,870 --> 00:05:30,080
! لم تُنكر ذلك

82
00:05:30,080 --> 00:05:33,960
! لن تسمح جوفيا بهذا ! ستكون هنالك إراقةٌ للدماء

83
00:05:33,960 --> 00:05:35,670
إخرس أيها المزعج

84
00:05:35,670 --> 00:05:38,420
كُفَّ عن التدخُّل في كلِّ محادثة

85
00:05:38,420 --> 00:05:40,480
آسف

86
00:05:40,810 --> 00:05:44,630
مالذي يقصده جراي بـ " مدينةٌ بلا صوت " ؟

87
00:05:44,630 --> 00:05:47,150
لمَ تُحقِّقين بشأن ناتسو ؟

88
00:05:47,150 --> 00:05:48,240
أجل ، أجل

89
00:05:48,240 --> 00:05:51,180
دعي الأسئلة لوقتٍ لاحق . لمَ لا تأكلان وجبةً خفيفة ؟

90
00:05:51,200 --> 00:05:52,850
لا تكوني سخيفة

91
00:05:52,850 --> 00:05:54,100
! الوقتُ غير مناسبٍ لذلك

92
00:05:54,100 --> 00:05:56,230
لا بأس بواحدة

93
00:05:56,840 --> 00:05:58,950
! لا تأكلها

94
00:06:02,360 --> 00:06:04,070
هذه بنكهة التوابل الحارَّة

95
00:06:04,070 --> 00:06:05,410
أتريدين واحدة ؟

96
00:06:08,610 --> 00:06:10,880
ما خطبها ؟

97
00:06:12,790 --> 00:06:14,340
إنَّني أشتعل حماسًا

98
00:06:14,340 --> 00:06:17,080
إن كُنت جادًّا ، فسأكون كذلك معك

99
00:06:17,450 --> 00:06:20,840
سأبرحك ضربًا لن تنساه

100
00:06:27,260 --> 00:06:28,220
لقد تأخَّر

101
00:06:28,510 --> 00:06:30,480
مالذي يفعله ناتسو ؟

102
00:06:30,760 --> 00:06:33,180
من المُفترض أن يعود الآن

103
00:06:33,180 --> 00:06:35,810
لقد ذهب لكي يتحقَّق من إشاعة التَّنين

104
00:06:35,810 --> 00:06:37,520
من المتوقَّع أن يتأخر لهذا السبب

105
00:06:37,520 --> 00:06:40,140
أرى بأن تهدأي يا إيرزا

106
00:06:40,140 --> 00:06:43,230
ربَّما يتريَّثُ في أمره على أيَّة حال

107
00:06:43,260 --> 00:06:47,670
الأمر ليس كذلك . لأنَّ وندي قد ذهبت
معه ، ومن الغرابة أن يتأخَّر إلى هذا الحدْ

108
00:06:47,670 --> 00:06:49,700
ليس من عادة ناتسو

109
00:06:49,700 --> 00:06:53,620
أن يتجوَّل وبرفقته فتاةٌ صغيرة في وقتٍ متأخِّر ليس عملاً رجوليًّا

110
00:06:53,820 --> 00:06:57,480
إنَّني قلقةٌ أيضًا من الذي هاجمني اليوم فجأةً

111
00:06:57,790 --> 00:06:59,510
فماذا لو قام بمهاجمة ناتسو ، ووندي ؟

112
00:06:59,510 --> 00:07:01,920
جوفيا قلقةٌ على سيِّدي جراي أيضًا

113
00:07:02,410 --> 00:07:07,780
جوفيا غيرُ مرتاحة ، وأتسائل إن حدث له أمرٌ ما

114
00:07:08,020 --> 00:07:10,600
وأنا أعتقد بأنَّكِ تبالغين في قلقك

115
00:07:10,600 --> 00:07:13,310
ربَّما عاد لمنزله

116
00:07:13,560 --> 00:07:17,000
حدسٌ المرأة لا يُمكن أن يكون خاطئًا

117
00:07:17,000 --> 00:07:19,390
حسنًا ، حسنًا ! لا تنظري إليَّ هكذا

118
00:07:19,390 --> 00:07:21,480
لا تأخذي الأمر بهذه الجديَّة

119
00:07:21,480 --> 00:07:22,650
سأذهب للبحث عنه

120
00:07:22,650 --> 00:07:23,890
لوسي ، تعاليّ معي

121
00:07:23,890 --> 00:07:24,800
حسنًا

122
00:07:24,800 --> 00:07:26,600
جوفيا ستأتي معكما

123
00:07:26,600 --> 00:07:27,910
خوذوني معكم

124
00:07:27,910 --> 00:07:30,780
كلاَّ ، أريد منكما أن تبقيا هُنا

125
00:07:30,780 --> 00:07:32,910
لا أريد أن نترك المقرَّ وهو شبهُ خالٍ

126
00:07:33,300 --> 00:07:36,030
كونا حذرتيّن يا إيرزا ولوسي

127
00:07:46,670 --> 00:07:48,920
صُنعُ الجليد ... الدرع

128
00:07:48,920 --> 00:07:51,330
مخلبُ تنِّين النَّار

129
00:07:53,540 --> 00:07:55,890
صُنعُ الجليد ... الأرضية

130
00:08:03,290 --> 00:08:04,820
مثيرٌ للشفقة

131
00:08:04,820 --> 00:08:07,150
! اصمت ، أيها اللعين

132
00:08:08,640 --> 00:08:10,150
المدفع الجليدي

133
00:08:11,860 --> 00:08:16,160
هجوم جناح تنِّين النَّار

134
00:08:20,800 --> 00:08:21,900
هذا مُدهش

135
00:08:21,900 --> 00:08:23,920
لم تحسم هجمتيهُما الأمر

136
00:08:23,920 --> 00:08:27,480
على هذه الحال ، ستنفذ قواهما السحريَّة وسينهاران

137
00:08:27,480 --> 00:08:29,590
أبذل جهدك يا ناتسو

138
00:08:29,860 --> 00:08:32,220
مرفق تنِّين النَّار المُشتعل

139
00:08:38,390 --> 00:08:39,800
!حوض سباحة ؟

140
00:08:39,800 --> 00:08:41,800
مهلاً ، هذا ليس جيِّدًا

141
00:08:42,710 --> 00:08:44,280
هذا مناسب

142
00:08:45,020 --> 00:08:46,670
... صُنعُ الجليد

143
00:08:47,190 --> 00:08:48,440
! القفص ...

144
00:08:50,200 --> 00:08:51,700
أيها اللعين

145
00:08:51,700 --> 00:08:54,450
! هذا ليس عدلاً ! أخرجني حالاً

146
00:08:55,370 --> 00:09:00,190
أجل ، أجل . لقد إستخدم ماء بركة السباحة لصُنع القفص ؟

147
00:09:00,190 --> 00:09:02,330
تملك مهارةً لا بأس بها

148
00:09:02,330 --> 00:09:04,380
حالتك يُرثى لها

149
00:09:04,380 --> 00:09:06,390
! لستُ حيوانًا

150
00:09:06,390 --> 00:09:08,630
زئير تنِّين النَّار

151
00:09:11,650 --> 00:09:13,380
تبًّا ! لا أستطيع رؤية شيء

152
00:09:13,680 --> 00:09:15,590
لقد وقعت في الفخ يا ناتسو

153
00:09:15,590 --> 00:09:16,140
! هذا سيِّء

154
00:09:16,140 --> 00:09:18,100
صُنعُ الجليد ... الرُمح

155
00:09:21,970 --> 00:09:25,020
كنتُ أفكِّر في أن نصفِّيَ الحسابات فيما بيننا يومًا ما

156
00:09:26,050 --> 00:09:27,730
واليوم هو المُناسب

157
00:09:28,520 --> 00:09:30,410
أيها اللقيط

158
00:09:30,410 --> 00:09:32,200
لا بأس إذًا

159
00:09:32,200 --> 00:09:33,490
كُفَّ عن ثرثرتك

160
00:09:34,010 --> 00:09:37,270
! أنت من يُثرثر

161
00:09:41,080 --> 00:09:41,870
إنَّهما في الطابق الأول

162
00:09:41,870 --> 00:09:42,730
لنذهب

163
00:09:44,570 --> 00:09:46,130
ناتسو

164
00:09:46,130 --> 00:09:47,750
أين أنت ؟

165
00:09:47,750 --> 00:09:52,100
على هذه الحال ، سوف أوقفهما بإسخدام زئير تنِّين السماء

166
00:09:52,100 --> 00:09:56,930
تمهَّلي ! إن استخدمتها في مكانٍ كهذا ، فقد تؤذين الجميع

167
00:09:56,930 --> 00:09:59,900
حسنًا ، سأذهب لطلب النجدة

168
00:09:59,900 --> 00:10:01,390
مهلاً يا هابي

169
00:10:03,560 --> 00:10:05,530
لا تتعلَّم أبدًا

170
00:10:05,770 --> 00:10:08,170
أجل ، أجل . المقاومة غير مجدية

171
00:10:08,170 --> 00:10:10,980
لا يُمكنكم الهروب من هذا المبنى

172
00:10:10,980 --> 00:10:13,530
... هذا صحيح . إن استطعتُ هزيمتها

173
00:10:13,530 --> 00:10:16,280
هذه بنكهة الخُضروات

174
00:10:17,990 --> 00:10:20,450
!! إنَّه سيِّء

175
00:10:20,450 --> 00:10:22,770
لا جدوى من محاولة الهرب

176
00:10:22,770 --> 00:10:25,750
فهذا الفندقُ مُجرَّد وهمٍ قمتُ بصُنعه

177
00:10:26,040 --> 00:10:27,840
فندقٌ وهميّ ؟

178
00:10:27,840 --> 00:10:32,670
هذا صحيح . قواي السحريَّة ، سحرُ الإخفاء ، تُخفي البشر والأشياء

179
00:10:32,670 --> 00:10:36,840
" هذا الفندق قد صُنع عن طريق سحر الإخفاء " القفص المخفي

180
00:10:36,840 --> 00:10:39,360
بمعنى أوضح ، هي بنايةٌ غير موجودةٍ على الإطلاق

181
00:10:41,400 --> 00:10:44,050
يبدو أن أصدقاؤكِ قد أتوا ليأخذوكم

182
00:10:47,600 --> 00:10:50,180
إيرزا ، لوسي

183
00:10:50,180 --> 00:10:52,320
نحنُ هُنا في الأعلى

184
00:10:54,830 --> 00:10:58,540
الفندقُ الذي تحدَّث عنه جراي موجودٌ في مكانٍ ما هنا

185
00:10:58,810 --> 00:11:00,740
كوني حذرةً يا لوسي

186
00:11:02,320 --> 00:11:03,800
فأنا أشتمُّ رائحة وحشٍ ما

187
00:11:10,980 --> 00:11:13,160
ما هذا الشيء ؟

188
00:11:13,800 --> 00:11:15,380
الذي هاجمني اليوم

189
00:11:15,750 --> 00:11:17,350
صدقت في توقُّع ظهوره مجدَّدًا

190
00:11:26,850 --> 00:11:28,690
تراجعي يا لوسي

191
00:11:29,140 --> 00:11:30,450
كوني حذرة

192
00:11:36,760 --> 00:11:38,470
ما هو هدفك ؟

193
00:11:38,830 --> 00:11:41,360
هل قُمت أيضًا بمهاجمة ناتسو و وندي ؟

194
00:11:41,360 --> 00:11:42,490
! أجب

195
00:11:51,080 --> 00:11:52,190
إيرزا

196
00:11:52,190 --> 00:11:53,170
حسنًا

197
00:11:54,290 --> 00:11:56,630
بوَّابة الخادمة ، إنِّي أفتحكِ

198
00:11:57,170 --> 00:11:58,120
فارجو

199
00:12:00,880 --> 00:12:03,190
ردَّةُ فعلٍ كوميديَّةٍ رائعة أيتها الأميرة

200
00:12:03,190 --> 00:12:05,050
! لم أقل شيئًا

201
00:12:05,300 --> 00:12:06,720
شكرًا لكِ

202
00:12:06,720 --> 00:12:09,340
على أيَّة حال ، أنقذي إيرزا

203
00:12:09,340 --> 00:12:10,650
كما ترغبين

204
00:12:12,680 --> 00:12:14,650
إحترسي أيتها الأميرة

205
00:12:20,500 --> 00:12:22,110
هناك واحدٌ آخر ؟

206
00:12:23,020 --> 00:12:25,280
دعي أمره لي أيتها الأميرة

207
00:12:26,160 --> 00:12:28,260
يُخطِّطان للنيل منها غدرًا ؟

208
00:12:28,260 --> 00:12:29,860
أعتمد عليكِ يا فارجو

209
00:12:31,160 --> 00:12:33,320
!أيملك مثل قدرة فارجو ؟

210
00:12:35,520 --> 00:12:36,490
أين العدو ؟

211
00:12:44,950 --> 00:12:47,680
لا يُتقن الحفرَ بشكلٍ جيِّد

212
00:12:49,220 --> 00:12:50,850
أظهر نفسك

213
00:12:50,850 --> 00:12:52,810
سأريك الطريقة الصحيحة لصُنع حُفرة

214
00:12:56,390 --> 00:12:58,610
يبدو أنَّ قواك السحريَّة قد ازدادت

215
00:12:59,320 --> 00:13:00,870
السجنُ الصخريّ

216
00:13:09,750 --> 00:13:11,350
إنَّه خصمٌ قوي أيتها الأميرة

217
00:13:11,350 --> 00:13:13,800
لا تضغطي على نفسك . إرتاحي الآن

218
00:13:13,800 --> 00:13:15,260
أرجو أن تعذُريني

219
00:13:17,730 --> 00:13:19,240
في هذه الحال

220
00:13:21,320 --> 00:13:23,550
لم أركِ منذُ مدَّة ، يا لوسي

221
00:13:23,550 --> 00:13:26,180
إنَّني أعتمد عليك ثانيةً . فهل أنت أهلٌ لهذا يا لوكي ؟

222
00:13:26,180 --> 00:13:28,590
لا داعي للسؤال

223
00:13:28,590 --> 00:13:31,200
فأنا قائد الزودياك الإثنا عشر

224
00:13:31,200 --> 00:13:35,730
سأردُّ لكِ دينكِ في أخذ أرياس والبقية

225
00:13:41,650 --> 00:13:43,370
شخصٌ جديد ؟

226
00:13:43,370 --> 00:13:48,040
بل جسدٌ جديد كما أعتقد ، لكن ليس هذا هو المهم

227
00:13:51,550 --> 00:13:52,880
مُدهش

228
00:13:52,880 --> 00:13:56,250
تودُّ مواجهة روح متخصِّصةٍ في قتال المدى القريب ؟

229
00:13:58,080 --> 00:14:00,090
... في لحظةٍ واحدة فقط

230
00:14:02,700 --> 00:14:05,890
أهذه الأشياء تُقلِّدنا ؟

231
00:14:13,560 --> 00:14:16,320
لوسي ، إيرزا

232
00:14:16,320 --> 00:14:19,430
لا يبدو أنَّهما قادرتيّن على رؤيتنا

233
00:14:20,920 --> 00:14:23,650
ألكِ علاقةٌ بتلك الكائنات الغريبة ؟

234
00:14:23,650 --> 00:14:25,810
أجل أجل . أنت مُحق

235
00:14:25,810 --> 00:14:30,770
لديَّ العديد من أشكال الحياة المختلفة ومخزنةٌ في هذا المكان

236
00:14:30,770 --> 00:14:32,760
أشكال حياة ؟

237
00:14:32,760 --> 00:14:34,470
وأحدها هو جولوم ، صحيح ؟

238
00:14:34,470 --> 00:14:38,690
ثمَّ قمتُ بإضافة نظام التكيُّف بداخلهم

239
00:14:38,690 --> 00:14:41,010
من أجل أن يحصلوا على جميع صفات خصمهم

240
00:14:41,360 --> 00:14:43,540
، كنتُ أفكِّر أنَّ بالإضافة إلى ناتسو دراجونيل

241
00:14:43,540 --> 00:14:47,260
سأتمكَّن من جمع المعلومات عن جميع السحرة

242
00:14:47,260 --> 00:14:49,600
ومالذي تخططين له ؟

243
00:14:50,000 --> 00:14:52,690
عليكم أن تنتظروا

244
00:14:52,690 --> 00:14:58,020
كثرةٌ المعلومات التي أحصل عليها ، تعني المزيد من الإثارة

245
00:15:02,300 --> 00:15:03,940
يبدو أنَّ القتال على وشك أن ينتهي

246
00:15:08,860 --> 00:15:12,790
يا إلهي . إنَّك قويٌّ أيها اللعين

247
00:15:12,790 --> 00:15:15,670
هذا ما كنتُ سأقولهُ عنك

248
00:15:15,670 --> 00:15:17,620
ناتسو ، أبذل جهدك

249
00:15:17,890 --> 00:15:21,080
أجل ، أجل ، أجل . كفى كلامًا

250
00:15:21,080 --> 00:15:24,340
لقد حان الوقت . أنهي الأمر يا جراي فولوباستر

251
00:15:24,340 --> 00:15:26,510
لا داعي لقول هذا

252
00:15:28,050 --> 00:15:29,430
هات ما لديك

253
00:15:29,430 --> 00:15:31,800
!! ناتسو

254
00:15:35,810 --> 00:15:38,360
!! جراي

255
00:15:44,370 --> 00:15:45,930
إنتصر ناتسو

256
00:15:45,930 --> 00:15:48,030
كما هو متوقَّعٌ من سَلامندر

257
00:15:50,110 --> 00:15:51,880
أجل . كما هو متوقع

258
00:15:54,800 --> 00:15:58,000
ما رأيك ؟ لقد انتصرت عليك يا جراي

259
00:15:59,750 --> 00:16:00,510
جراي ؟

260
00:16:01,380 --> 00:16:05,030
المعذرة ، المعذرة ! أضربتك في مكان حسَّاس ؟

261
00:16:05,030 --> 00:16:06,520
أمزح معك

262
00:16:07,150 --> 00:16:09,880
إلى متى ستظلُّ مستلقيًا

263
00:16:10,500 --> 00:16:12,390
لقد تجمَّدت قدماي

264
00:16:12,390 --> 00:16:13,590
لهذا السبب

265
00:16:14,270 --> 00:16:16,220
يا لك من ساذج

266
00:16:16,890 --> 00:16:19,480
أجل ، أجل ، أجل . أحسنت عملاً

267
00:16:20,190 --> 00:16:21,730
الظلام الخفيّ

268
00:16:22,500 --> 00:16:25,380
! ما هذا الشيء

269
00:16:30,160 --> 00:16:32,730
أحسنت يا جراي فولوباستر

270
00:16:33,250 --> 00:16:35,280
تستحقُّ علاماتٍ عالية كمساعدٍ لي

271
00:16:36,660 --> 00:16:38,680
لقد تطلَّب الأمر الكثير من الجهد

272
00:16:40,160 --> 00:16:41,570
ناتسو

273
00:16:41,570 --> 00:16:42,460
! ناتسو

274
00:16:42,960 --> 00:16:46,920
كنتُ تخطِّط منذُ البداية على استدراجنا إلى هنا ، صحيح ؟

275
00:16:47,220 --> 00:16:50,170
أجل . وقد نجاح الأمر بإمتياز

276
00:16:50,170 --> 00:16:53,180
! لا تغترَّ بنفسك بعد خسارة القتال الحقيقي

277
00:16:54,140 --> 00:16:56,220
سأرميك في الداخل معه

278
00:16:59,140 --> 00:17:01,850
أجل ، أجل . لا تقم بفعل ذلك

279
00:17:02,100 --> 00:17:06,060
لا تقم بوضع أيِّ شيء بعد إمساكنا أخيرًا بسَلامندر

280
00:17:06,980 --> 00:17:09,190
يبدو لي بأنَّها لا تحترمني

281
00:17:09,450 --> 00:17:11,860
أكان هذا هدفكِ ؟

282
00:17:12,410 --> 00:17:13,290
هو كذلك

283
00:17:13,540 --> 00:17:17,180
بالقبض عليه ، فقد اكتمل بحثي

284
00:17:18,790 --> 00:17:20,920
جراي ، هابي

285
00:17:21,240 --> 00:17:23,770
وندي ، شاريل

286
00:17:34,780 --> 00:17:36,410
!بيضُ تنِّين ؟

287
00:17:40,240 --> 00:17:41,600
... ذلك الصوت

288
00:17:43,120 --> 00:17:44,640
إجنيل ، أكان أنت ؟

289
00:17:44,640 --> 00:17:46,980
! إنتظر ! أجب ندائي

290
00:17:47,820 --> 00:17:49,530
إجنيل

291
00:17:52,450 --> 00:17:53,970
... إجنيل

292
00:18:02,410 --> 00:18:03,500
إجنيل

293
00:18:04,500 --> 00:18:06,040
بيضُ تنِّين

294
00:18:06,390 --> 00:18:07,840
مدينةٌ بلا صوت

295
00:18:08,810 --> 00:18:11,050
هذا صحيح ! لقد تذكَّرت

296
00:18:16,880 --> 00:18:18,340
ناتسو

297
00:18:20,960 --> 00:18:22,060
... مالذي

298
00:18:22,060 --> 00:18:24,090
لقد بدأت المتعة الحقيقية

299
00:18:29,730 --> 00:18:34,780
يبدو أنَّك تملك ميزة استنساخ قُدُراتنا

300
00:18:35,470 --> 00:18:36,920
في هذه الحال

301
00:18:36,920 --> 00:18:38,080
إستبدال وإستخدام

302
00:18:38,480 --> 00:18:40,150
الدرعُ الصلب

303
00:18:44,050 --> 00:18:45,750
إستبدال وإستخدام مرَّةً أخرى

304
00:18:55,010 --> 00:18:59,760
قد تملك نفس الخصائص ، لكنَّك لست أسرع منِّي

305
00:19:00,100 --> 00:19:03,180
الإختيار بين الأسلحة والدروع بسرعة تحتاج إلى الخبرة

306
00:19:04,850 --> 00:19:07,140
المزيَّفُ سيبقى مُزيَّف

307
00:19:12,470 --> 00:19:14,680
لا فائدة إن إستمرَّيت

308
00:19:14,680 --> 00:19:16,950
... إن كان يستنسخني ، فإذًا

309
00:19:17,280 --> 00:19:18,270
! فهمت

310
00:19:18,270 --> 00:19:19,600
لقد فعلتُ هذا من قبل

311
00:19:19,600 --> 00:19:21,140
سأدع الباقيَ لكِ

312
00:19:21,140 --> 00:19:22,710
أمنياتيِ بإنتصارك

313
00:19:25,010 --> 00:19:27,330
بوَّابة الجرو الصغير ، إنِّي أفتحكِ

314
00:19:27,620 --> 00:19:28,540
نيكولا

315
00:19:58,990 --> 00:20:01,240
حسنًا ! إنَّ هذا يعمل بشكلٍ جيِّد

316
00:20:01,420 --> 00:20:02,430
أو كما أظن

317
00:20:16,650 --> 00:20:17,860
أحسنت

318
00:20:17,860 --> 00:20:19,680
لقد فعلت ما بوسعك

319
00:20:32,150 --> 00:20:33,850
أجل ، أجل ، أجل ، أجل

320
00:20:33,850 --> 00:20:35,770
إزالة سحر الإخفاء

321
00:20:36,110 --> 00:20:38,440
الإستعداد لتشغيل اللاكريما الأساسية

322
00:20:38,690 --> 00:20:40,780
تشغيلُ جميع الأجزاء

323
00:20:40,780 --> 00:20:43,930
! معدَّل حساسية اللاكريما ، تمَّ التشغيل

324
00:20:44,820 --> 00:20:49,430
إلى جميع الشوائب ما عدا سَلامندر ، أخرجوا حالاً

325
00:20:51,080 --> 00:20:52,670
أجل ، أجل ، أجل ، أجل

326
00:20:52,670 --> 00:20:56,880
والآن ، البدءُ في إمتصاص قوى سَلامندر السحريَّة

327
00:21:04,340 --> 00:21:08,500
دراجونويد ... تمَّ التفعيل

328
00:21:11,150 --> 00:21:12,330
دراجونويد ؟

329
00:21:12,850 --> 00:21:15,560
إمتصاص قوى سَلامندر السحريَّة ؟

330
00:21:16,250 --> 00:21:17,660
ناتسو

331
00:21:23,490 --> 00:21:25,430
! أغلق فمك

332
00:21:25,950 --> 00:21:27,210
أجل ، أجل ، أجل

333
00:21:27,210 --> 00:21:29,160
الأمور تسير بشكلٍ جيِّد

334
00:21:29,620 --> 00:21:31,000
أنظروا رجاءً

335
00:21:31,000 --> 00:21:33,800
هذا هو التنِّين الإصطناعيُّ الذي اخترعتُه

336
00:21:33,800 --> 00:21:35,600
وأطلقت عليه اسم دراجونويد

337
00:21:35,600 --> 00:21:40,090
إنَّني أمتصُّ قوَّة ناتسو السحريَّة لأريها الجميع

338
00:21:40,090 --> 00:21:41,760
قوى ناتسو السحريَّة ؟

339
00:21:42,470 --> 00:21:44,050
لوسي

340
00:21:44,050 --> 00:21:45,390
إيرزا

341
00:21:45,760 --> 00:21:47,120
! إنَّه أنتم

342
00:21:47,120 --> 00:21:48,310
هل أنتم بخير ؟

343
00:21:48,310 --> 00:21:50,220
! إنها مُصيبة

344
00:21:50,220 --> 00:21:52,130
مالذي حدث لكم ؟

345
00:21:52,130 --> 00:21:53,060
أين ناتسو

346
00:21:53,390 --> 00:21:55,350
لقد قُبض عليه

347
00:21:55,350 --> 00:21:59,370
لقد إنضمَّ جراي إلى تلك المدعوة
دافني ، من أجل الإيقاع بناتسو

348
00:21:59,370 --> 00:22:00,570
جراي ؟

349
00:22:00,930 --> 00:22:02,920
لم يتمَّ السيطرةُ عليه

350
00:22:02,920 --> 00:22:04,500
بل يفعل ذلك من تلقاء نفسه

351
00:22:04,920 --> 00:22:07,410
ولم نكن نعلم ما يتوجَّب علينا فِعلُه

352
00:22:08,170 --> 00:22:09,100
جراي

353
00:23:56,300 --> 00:23:59,900
حان وقت الإعلان الأضخم في التاريخ

354
00:23:59,900 --> 00:24:04,070
سنقوم بتوزيع الخمسةُ وعشرون فصلاً الأولى من المانجا بالإضافة إلى قرصيّ شارة البداية والنهاية

355
00:24:04,070 --> 00:24:09,900
! وأيضًا ، سنقوم بتوزيع عشرون نُسخةً من لُعبة فيري تيل كهديَّة

356
00:24:09,900 --> 00:24:12,550
لا تدعوا الفرصة تفوتكم

357
00:24:12,550 --> 00:24:15,750
لا تتردَّوا ، اكتبوا المعلومات الكاملة عنكم وأرسلوها إلينا عن طريق البريد

358
00:24:16,300 --> 00:24:18,100
ناتسو ، إنَّه تنِّين

359
00:24:18,100 --> 00:24:19,870
كلاَّ ، إنَّه مُزيَّف

360
00:24:19,870 --> 00:24:22,110
هذا لا شيء أمام تنِّينٍ حقيقيّ

361
00:24:22,110 --> 00:24:24,320
ومع ذلك ، فقد قُبض عليك