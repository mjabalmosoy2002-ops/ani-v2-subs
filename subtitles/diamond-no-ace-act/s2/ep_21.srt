1
00:00:02,100 --> 00:00:04,310
!راكِض القاعدة الثّالثة يتوجّه للرئيسية

2
00:00:05,390 --> 00:00:08,060
!استعاد طلّاب السنة الأولى نقطة

3
00:00:09,060 --> 00:00:11,310
!كلاهما أحرزا نقطة

4
00:00:11,900 --> 00:00:14,610
!أرِنا مهاراتك

5
00:00:14,610 --> 00:00:15,830
!نعم

6
00:00:15,830 --> 00:00:17,190
!أجل، أجل، أجل

7
00:00:17,570 --> 00:00:19,660
!المُباراة لم تبدأ بعد

8
00:00:19,660 --> 00:00:24,110
!لنهزمهم حتّى لا يبقى منهم أحد

9
00:00:24,580 --> 00:00:25,450
...ساوامورا

10
00:00:25,450 --> 00:00:26,870
!يمكننا إحراز عشرين نقطة أخرى

11
00:00:26,870 --> 00:00:27,870
...ساوامورا-سينباي

12
00:00:27,870 --> 00:00:32,130
!لننزل ذلك الرّامي من التلّة

13
00:00:33,630 --> 00:00:35,800
!يريدهم أن يسحقوني

14
00:00:35,800 --> 00:00:37,630
!ولديه نظرة مخيفة في عينيه

15
00:00:37,630 --> 00:00:39,630
!عصي متفجِّرة

16
00:00:39,630 --> 00:00:43,260
كان في صفِّنا قبل قليل

17
00:00:44,100 --> 00:00:48,520
كان يراقبك من خلف ذلك العمود بقلق

18
00:00:48,890 --> 00:00:53,020
في البداية كان قلقاً عليه والآن يهينه

19
00:00:54,440 --> 00:00:56,900
ما الذي يفكّر فيه يا ترى؟

20
00:00:56,900 --> 00:01:00,150
!استعدّ يا أسادا

21
00:01:04,620 --> 00:01:07,910
والآن المُنظِّف هو من يضرب

22
00:01:10,410 --> 00:01:14,290
!لنحرز خروجاً تلو الآخر

23
00:03:53,410 --> 00:03:56,710
هل ينبغي للاعبين أن يذهبوا ويحضروا
بطولة كانتو الشهر المقبل؟

24
00:03:56,710 --> 00:04:01,130
فريقا النّهائي من بطولة طوكيو، ثانويّتا
،إيناشيرو وإتشيداي سان

25
00:04:01,130 --> 00:04:05,460
وكذلك ياكوشي، الذي تأهّل للنصف نهائي
في بطولة المدعوّين، سيلعبون

26
00:04:06,720 --> 00:04:09,340
ثلاثة فِرق من المجموعة الغربيّة؟

27
00:04:09,340 --> 00:04:12,170
يا لها من مجموعة مُرعِبة

28
00:04:12,170 --> 00:04:15,140
سنتمكّن من دراستهم بالتفصيل

29
00:04:15,640 --> 00:04:17,890
متفائلة دوماً

30
00:04:18,600 --> 00:04:21,650
حسناً، ما أخبار المُباراة الداخليّة؟

31
00:04:22,230 --> 00:04:25,190
هل بدا أي لاعب مستعدّاً للنسق الأوّل؟

32
00:04:33,990 --> 00:04:36,290
انتهى المطاف بخسارة ثلاث نقاط

33
00:04:36,750 --> 00:04:40,080
لا أظنّ أنّني ارتقيت لتوقّعات أوكومورا-كن

34
00:04:45,550 --> 00:04:47,550
ثلاث ضربات وأربع نقاط مُحرَزة بالضرب

35
00:04:47,840 --> 00:04:51,590
هكذا يُفترض للمنظِّف أن يضرب يا تاكاتسو

36
00:05:02,560 --> 00:05:05,530
سينضمّ للنسق الأوّل؟ متى؟

37
00:05:05,830 --> 00:05:09,490
ميمورا وكاواشيما في النسق الأوّل‏ اعتباراً من اليوم

38
00:05:09,900 --> 00:05:11,950
طالب السنة الثانية تاكاتسو ذاك أيضاً

39
00:05:12,570 --> 00:05:16,080
استعاد ذلكما الاثنان مقعدهما في التشكيلة

40
00:05:16,080 --> 00:05:18,370
كان تاكاتسو قد قدّم أداء مدهشاً أيضاً

41
00:05:19,960 --> 00:05:22,580
تتكلّم وكأنّ هذا لا يؤثّر بك

42
00:05:23,830 --> 00:05:28,670
إذا حظيَ ثلاثة أشخاص بمقاعد، فهذا يعني
أنّ ثلاثة آخرين سيخسرون مقاعدهم

43
00:05:29,670 --> 00:05:33,260
نحن لسنا في ظرف يسمح لنا بالضحك

44
00:05:38,810 --> 00:05:40,010
!مدهش

45
00:05:40,350 --> 00:05:42,560
تشعر بالرّاحة بمجرّد رؤيته يلوّح

46
00:05:42,560 --> 00:05:45,060
لكن يجب عليه ضرب الكرة

47
00:05:50,190 --> 00:05:51,400
ضربها

48
00:06:08,050 --> 00:06:11,630
كنتُ أسمع عن مدى جودة لاعبي
،السّنة الأولى

49
00:06:11,630 --> 00:06:14,180
لكن ذلكما الاثنان رهيبان حقّاً

50
00:06:14,800 --> 00:06:17,560
لستُ مستغرباً من حصولهما على مقعد
في التشكيلة في الرّبيع

51
00:06:26,230 --> 00:06:30,530
!لكن مع ذلك، لن نسمح لهما بهزيمتنا

52
00:06:31,900 --> 00:06:33,700
!لن نسمح

53
00:06:37,700 --> 00:06:40,790
تبّاً، هذا سيّئ

54
00:06:41,580 --> 00:06:43,750
كبرياء السينباي

55
00:06:43,750 --> 00:06:47,710
لا يوجد ما هو أسخف من ذلك

56
00:06:52,380 --> 00:06:53,300
اللّعنة

57
00:06:53,840 --> 00:06:56,470
،سواء أكانوا يتباهون أو يدّعون ذلك

58
00:06:56,930 --> 00:07:01,180
!لا أن يأخذ رقمي لاعبون أصغر منّي

59
00:07:01,180 --> 00:07:03,060
!لا أريد التخلّي عنه

60
00:07:06,230 --> 00:07:09,980
يجب أن أتماسك

61
00:07:10,650 --> 00:07:16,530
ليتني أقوى من ذلك لدرجة لا يُثير هذا الأمر قلقي

62
00:07:17,620 --> 00:07:19,950
آسو، أنت تقف في طريقنا

63
00:07:19,950 --> 00:07:21,540
هذا باب غرفة الصفّ

64
00:07:21,540 --> 00:07:23,080
!آسف

65
00:07:27,670 --> 00:07:30,960
هل هذا جدول مباريات مايو؟

66
00:07:31,460 --> 00:07:32,960
أجل

67
00:07:33,380 --> 00:07:35,300
،باحتسابِ المُباريات التي دُعينا إليها

68
00:07:35,300 --> 00:07:38,010
جدولنا في الأسبوع الذهبيّ مزدحم

69
00:07:38,510 --> 00:07:41,760
بصراحة، من المطمئن أن ينضمّ لنا كاواشيما

70
00:07:42,470 --> 00:07:48,400
ستكون عمليّة تخطيط المناوبات وتنظيم
الرّماة لشهر مُقدّماً صعبة

71
00:07:49,020 --> 00:07:53,730
ناهيك عن أنّك ستذهب للعب في بطولة
طوكيو للمدعوّين بمعزل عن الفريق، صحيح؟

72
00:07:54,150 --> 00:07:57,780
هل سيزعزع هذا إيقاعكما كثنائي رامٍ وماسك؟

73
00:07:57,780 --> 00:08:00,370
لا مشكلة. سأغادر لثلاثة أيّام فقط

74
00:08:00,370 --> 00:08:01,450
هل أنت متأكّد من ذلك؟

75
00:08:01,990 --> 00:08:07,870
بطولة طوكيو للمدعوّين بحدّ ذاتها جديدة، وسوف
يجرّبون بعض الأمور في هذا العام

76
00:08:08,830 --> 00:08:12,920
سيقيمونها في مايو لأنّهم استدعوا بعضاً
من الفِرق الأمريكيّة

77
00:08:12,920 --> 00:08:15,800
ستكون في الخريف العام المقبل

78
00:08:16,590 --> 00:08:19,840
مع ذلك، ما زال هناك الكثير من الأمور
يجب فعلها

79
00:08:19,840 --> 00:08:23,850
فورويا وساوامورا بدآ يفكّران بأمور
أخرى يفعلانها

80
00:08:24,180 --> 00:08:28,560
هذا يمنحني فرصة لتعليمهما بعض
الأشياء، لكن بحدود

81
00:08:28,560 --> 00:08:32,270
إذا حشوتُهما بمعلومات غزيرة، فإنّ عقلهما
سيتوقّف عن العمل

82
00:08:32,270 --> 00:08:34,980
هذه هي الجزئية الأصعب

83
00:08:35,780 --> 00:08:38,530
أنت ثرثار

84
00:08:38,530 --> 00:08:39,490
حقّاً؟

85
00:08:40,360 --> 00:08:43,740
حسناً، أعلم أنّ المبالغة في التّفكير لا تجدي نفعاً

86
00:08:44,540 --> 00:08:48,160
هذا ما يجري مع فورويا، صحيح؟

87
00:08:49,120 --> 00:08:50,790
أجل

88
00:08:50,790 --> 00:08:54,590
المدرّبون قلقون جدّاً بشأن ذلك

89
00:08:55,380 --> 00:08:59,550
أريد الانتهاء من تطوير الإحصائيّات مع ساوامورا
في ظلِّ وجودي

90
00:08:59,550 --> 00:09:01,840
هناك أمور كثيرة توضع بعين الاعتبار

91
00:09:02,850 --> 00:09:06,810
بصراحة، الوقت يداهمنا

92
00:09:10,100 --> 00:09:12,860
تبدو مستمتعاً بهذا

93
00:09:12,860 --> 00:09:14,150
!لستُ كذلك

94
00:09:14,150 --> 00:09:17,150
أنت تتكلّم كثيراً لدرجة أنّني أجد
!صعوبة في تصديق ذلك

95
00:09:21,360 --> 00:09:22,820
هل انتهيت؟

96
00:09:22,820 --> 00:09:23,980
انتظر

97
00:09:23,980 --> 00:09:27,370
!لا تقلب الصفحة! ما زلتُ أقرأ

98
00:09:27,370 --> 00:09:28,700
أنت تستغرق وقتاً طويلاً

99
00:09:28,700 --> 00:09:32,040
خسرتَ في حجر ورقة مقصّ، لذا انتظر
فحسب حتّى أنتهي

100
00:09:32,040 --> 00:09:33,210
!كلّا

101
00:09:33,500 --> 00:09:37,090
إنّهما منافسان، صحيح؟

102
00:09:37,090 --> 00:09:38,510
أينسجمان معاً؟

103
00:09:38,510 --> 00:09:42,050
بات ماسكيهم ورماتهم منسجمين
معاً في الآونة الأخيرة

104
00:09:42,050 --> 00:09:44,970
ذاك الكتاب أعارهما إيّاه ميوكي-سينباي

105
00:09:45,390 --> 00:09:49,100
حسناً، لقد فهمت! أعطِني كلّ صفحة
!بعد أن تنتهي من قرائتها

106
00:09:49,100 --> 00:09:50,480
هل ينبغي أن نمزّق هذا الكتاب؟

107
00:09:50,480 --> 00:09:53,020
بالتأكيد، يمكننا إلصاقه وإعادته لاحقاً

108
00:09:53,020 --> 00:09:54,650
حسناً، سنسحب معاً

109
00:09:54,650 --> 00:09:56,020
...استعداد

110
00:09:54,770 --> 00:09:56,520
!لا، لا تفعلا

111
00:09:56,520 --> 00:09:58,400
!يجب أن تعتنيا بالكتب

112
00:09:57,480 --> 00:09:59,690
!لكن هذه أفضل طريقة

113
00:10:03,990 --> 00:10:05,700
...ذاك الوغد

114
00:10:06,410 --> 00:10:09,200
عليك أن تُظهِر للمدرّب ما يمكنك فعله

115
00:10:09,200 --> 00:10:11,540
قد تبلغ النسق الأوّل

116
00:10:13,210 --> 00:10:14,630
اصمت

117
00:10:16,500 --> 00:10:20,050
من أنت لتتكلّم معي بهذه الطريقة؟

118
00:10:21,630 --> 00:10:25,050
تتكلّم وكأنّك أفضل منّي فقط لمجرّد
بلوغك للنسق الأوّل

119
00:10:25,050 --> 00:10:26,510
!ماذا يعني هذا؟

120
00:10:26,510 --> 00:10:28,380
!انتظر! تاكاتسو

121
00:10:33,230 --> 00:10:35,230
ما زال لا يحبّك

122
00:10:35,230 --> 00:10:37,150
!لكن لم أفعل شيئاً

123
00:10:37,150 --> 00:10:39,230
ربّما لم ترقه طريقة كلامك

124
00:10:39,230 --> 00:10:42,320
شينجي، أنت تستفزّ الناس دون شعور

125
00:10:42,320 --> 00:10:44,450
!لحظة، لحظة، لحظة، ماذا يعني هذا؟

126
00:10:45,450 --> 00:10:46,160
اللّعنة

127
00:10:45,700 --> 00:11:00,420
قلق

128
00:10:46,910 --> 00:10:53,750
أعلم كم سعى تاكاتسو جاهداً وأردتُ
!فقط أن أهنّئه

129
00:10:54,420 --> 00:10:56,170
...استفزاز الناس دون شعور

130
00:10:56,580 --> 00:10:59,670
هل أفعل ذلك يا توجو؟

131
00:11:07,010 --> 00:11:10,390
الشّخص الذي بلغ النسق الأوّل للتو جذّاب

132
00:11:10,390 --> 00:11:12,930
!من المُلهِم رؤيته يتأمّل البعيد

133
00:11:12,930 --> 00:11:16,060
—ماذا تريد؟ ماذا

134
00:11:21,150 --> 00:11:22,410
حظّاً سعيداً

135
00:11:30,200 --> 00:11:34,080
أجل، سأذهب وأثير الأمور

136
00:11:40,090 --> 00:11:43,050
ما نوع الكتب التي يقرأها أوكومورا-كن؟

137
00:11:43,050 --> 00:11:45,130
هل أوكومورا-كن نصف ياباني؟

138
00:11:45,130 --> 00:11:47,840
يبدو أوكومورا كشخصيّة في لعبة

139
00:11:47,840 --> 00:11:51,310
ما الطعام الذي يحبّه أوكومورا-كن؟

140
00:11:55,560 --> 00:11:59,060
العديد منكم غير جاهزين بدنيّاً بعد

141
00:11:59,440 --> 00:12:03,070
أريدكم أن تستغرقوا وقتكم وتركّزوا
على بناء أساس متين

142
00:12:03,070 --> 00:12:07,490
لهذا السّبب، سأعيّن أربعة منكم في النسق الثّاني

143
00:12:08,570 --> 00:12:09,570
كوكّي

144
00:12:10,660 --> 00:12:11,620
كاغامي

145
00:12:12,490 --> 00:12:13,410
سيتو

146
00:12:14,160 --> 00:12:15,200
أوكومورا

147
00:12:15,870 --> 00:12:21,960
ستتمرّنون في النسق الثّاني وتكتسبون
خبرة في المباريات التمرينيّة

148
00:12:24,460 --> 00:12:25,720
هذا غير منصف. هذا غير منصف

149
00:12:25,720 --> 00:12:28,050
لا بدّ وأنّها مؤامرة. كيف له ألّا يختارني؟

150
00:12:28,050 --> 00:12:29,470
هذا غير منصف. هذا غير منصف

151
00:12:32,890 --> 00:12:34,640
!هذا كل ما في الأمر. انصراف

152
00:12:34,640 --> 00:12:35,770
!حاضر

153
00:12:37,940 --> 00:12:39,310
نسق ثان؟

154
00:12:40,230 --> 00:12:42,740
سوف أبلغ النسق الأوّل

155
00:12:43,270 --> 00:12:44,860
!النسق الثاني

156
00:12:51,950 --> 00:12:53,280
الوقت يداهمني

157
00:12:54,240 --> 00:12:56,950
سمعتُ أنّك أبليت حسناً في المباراة الداخليّة

158
00:12:56,950 --> 00:12:59,790
مبروك وصول النسق الثّاني

159
00:12:59,790 --> 00:13:01,380
!ستكون المباريات مسلّية

160
00:13:03,670 --> 00:13:07,920
إن لم أسرع فسوف يتقاعد

161
00:13:18,730 --> 00:13:25,270
هجوم نفسي
على كي

162
00:13:21,100 --> 00:13:25,270
إنّ فهم كيفيّة تفاعل الشخصيّة الرئيسيّة
في هذه المسرحية

163
00:13:25,270 --> 00:13:28,030
مع الشخصيّة المدعوّة كي

164
00:13:28,030 --> 00:13:33,370
أهمّ من فهم المسرحيّة بحدّ ذاتها

165
00:13:33,370 --> 00:13:38,790
أولاً، الصّدمة التي توجّهها الشخصيّة الرئيسيّة
للشخصية كي يمكن اعتبارها كهجمة نفسيّة

166
00:13:34,280 --> 00:13:38,450
بما أنّني سنة ثانية، أمسى المدرّب أيضاً
أحد أساتذتي

167
00:13:38,790 --> 00:13:42,630
ثمّ أعلن كي أنّه أحمق

168
00:13:39,750 --> 00:13:42,120
إذا نمتُ فسوف أكون هالكاً

169
00:13:49,970 --> 00:13:51,630
أتريد عمل صندوق آخر؟

170
00:13:51,630 --> 00:13:52,430
!حسناً

171
00:13:56,850 --> 00:13:58,890
أحضرتُ يوي

172
00:13:58,890 --> 00:14:00,600
شكراً على استضافتي

173
00:14:01,350 --> 00:14:02,440
أهلاً

174
00:14:03,230 --> 00:14:04,940
الرّامي الشهير كورودا ألّف الكتاب؟

175
00:14:04,940 --> 00:14:08,280
أجل. سأنتهي من قرائته قريباً. أتريد قراءته أيضاً؟

176
00:14:08,280 --> 00:14:09,820
أجل، أريد

177
00:14:10,110 --> 00:14:14,160
يزداد عدد الأشخاص في مدرسة ميوكي للدروس
المكثّفة كلّ يوم

178
00:14:16,030 --> 00:14:18,830
لم أكن أعلم أنّكم تلتقون بهذا الشّكل

179
00:14:19,410 --> 00:14:22,540
أشعر بالغيرة لكونك هنا منذ البداية

180
00:14:24,880 --> 00:14:26,670
!أوكومورا

181
00:14:26,670 --> 00:14:29,340
!كفّ عن الوقوف مكانك وتعال إلى هنا

182
00:14:29,340 --> 00:14:31,760
المكان ضيّق، لكن ستستطيع سماعنا بوضوح

183
00:14:31,760 --> 00:14:33,860
أنت متمدِّد وكأنّك في منزلك

184
00:14:36,100 --> 00:14:39,640
أنا بخير. يمكنني أن أستمع من هنا

185
00:14:39,640 --> 00:14:42,800
!حاسّة سمع مُعزَّزة! أنت حقّاً ذئب

186
00:14:43,140 --> 00:14:44,600
عمّاذا تتكلّم؟

187
00:14:45,560 --> 00:14:47,900
هل يستمع دوماً من هناك؟

188
00:14:47,900 --> 00:14:50,030
أجل، في العادة

189
00:14:50,030 --> 00:14:51,940
يا له من إسراف

190
00:14:53,530 --> 00:14:55,280
حسناً، فلنبدأ

191
00:14:55,820 --> 00:14:59,160
اليوم، سأتحدّث عن الرّمي مع راكض
في القاعدة الأولى

192
00:14:59,160 --> 00:15:03,290
،متى تحتاج دكّة الفريق الآخر لتقديم الرّاكض

193
00:15:03,290 --> 00:15:05,880
وكيف نعرف ما الذي يفكّرون فيه اعتماداً
على التّعداد

194
00:15:07,710 --> 00:15:09,420
!موضوع صعب آخر

195
00:15:09,730 --> 00:15:12,280
،بالطبع، إذا كانت الرّمية الأولى كُرة

196
00:15:12,280 --> 00:15:14,330
فهذا يمنحهم خيارات أكثر للعب

197
00:15:14,330 --> 00:15:18,020
إذا كان التّعداد يميل لصالحهم، يجب
أن تنتبهوا من استراتيجيّة ضرب وجري

198
00:15:18,660 --> 00:15:20,630
سنبدأ بكرة واحدة

199
00:15:29,360 --> 00:15:33,700
...عليّ أن أستحمّ... وأغسل الملابس

200
00:15:35,160 --> 00:15:38,810
أما زال ساوامورا في غرفة ميوكي؟

201
00:15:38,810 --> 00:15:41,700
أ-أجل سيّدي، أعتقد ذلك

202
00:15:42,090 --> 00:15:45,660
كان ذلك وشيكاً... كأنّني نمت

203
00:15:46,790 --> 00:15:48,290
هل كنت تتمرّن بمفردك؟

204
00:15:48,290 --> 00:15:50,760
أجل. زونو والآخرون ما زالوا يتمرّنون

205
00:15:50,760 --> 00:15:53,380
لم أستطع التّركيز ولذلك عدت

206
00:15:53,870 --> 00:15:56,080
دائماً ما تسهر في الخارج

207
00:16:00,260 --> 00:16:03,640
!يـ-يا لها من عضلات معدة

208
00:16:05,650 --> 00:16:08,460
كم يتدرّب حتّى يظهر بهذا الشكل؟

209
00:16:14,150 --> 00:16:17,440
رميت بعضاً من الكُرات المقوّسة الجيّدة
في المباراة الداخليّة

210
00:16:18,160 --> 00:16:21,250
حالما ترمي كرة سريعة جيّدة، لا يمكن إيقافك

211
00:16:22,630 --> 00:16:24,660
أكنت تشاهدني؟

212
00:16:24,660 --> 00:16:29,150
أعلم أنّك تمنّيت الوصول للنسق الثّاني
لكن لا تستعجل ذلك

213
00:16:29,630 --> 00:16:32,430
استمرّ في الأكل وذلك كي تتمكّن
من تكوين بعض العضلات

214
00:16:36,650 --> 00:16:40,730
سيصبح التّمرين أصعب كي نكون
مستعدّين للصيف

215
00:16:44,800 --> 00:16:48,210
لماذا تمّ اختياري للنسق الثاني؟

216
00:16:48,210 --> 00:16:49,950
ألست سعيداً؟

217
00:16:50,720 --> 00:16:54,260
لكن خسرتُ ثمان نقاط في الشوط الثّاني فقط

218
00:16:57,380 --> 00:17:01,860
ربّما لأنّك كنت تتحلّى بالعقلية المناسبة كرامٍ

219
00:17:02,730 --> 00:17:06,490
صدّقني، كثير من تلك النقاط أتت من أخطاء

220
00:17:06,490 --> 00:17:08,850
كافّة اللّاعبين الميدانيّين كانوا متوتّرين جدّاً

221
00:17:10,100 --> 00:17:13,610
لم أصمد حتّى في شوطين العام الماضي

222
00:17:13,610 --> 00:17:14,430
ماذا؟

223
00:17:14,730 --> 00:17:16,980
لم أستطع إحراز خروج

224
00:17:16,980 --> 00:17:19,730
شعرتُ وكأنّ الشوط لن ينتهي أبداً

225
00:17:19,730 --> 00:17:22,440
!حقّاً؟! حتّى بالنسبة لك يا توجو-سينباي؟

226
00:17:23,630 --> 00:17:26,820
كان فريق ماتسوكاتا سينيور من فِرق
النصف نهائي في البطولة الوطنية

227
00:17:27,140 --> 00:17:29,480
بفضلِ قوّة اللّاعبين الأكبر سنّاً

228
00:17:29,940 --> 00:17:32,700
أنا أفهم افتقاري للقدرات تماماً ولا أشكّ في ذلك

229
00:17:32,700 --> 00:17:36,440
شعرتُ وكأنّني أُجبِرتُ على الوقوف في التلّة

230
00:17:36,440 --> 00:17:41,100
لكن النّاس من حولي لم يروا سوى النتائج

231
00:17:41,750 --> 00:17:45,950
يريدونني أن أرمي كلاعب نصف نهائي
وطني في كلّ مرّة

232
00:17:46,620 --> 00:17:47,990
...توجو-سينباي

233
00:17:51,520 --> 00:17:57,870
بتذكّر الماضي، أشعر وكأنّني وقعتُ
في فخّ ذلك النجاح

234
00:18:01,380 --> 00:18:05,060
ضغطتُ على نفسي لأرمي بشكل
أفضل ممّا أستطيع

235
00:18:06,920 --> 00:18:08,470
ونتيجة ذلك، فشلت

236
00:18:09,120 --> 00:18:11,920
فقدتُ رؤيتي لنفسي

237
00:18:15,100 --> 00:18:19,680
مقارنة بي، كنتَ رامياً أفضل بكثير اليوم يا يوهي

238
00:18:20,140 --> 00:18:24,980
ربّما تلك القوّة الذهنيّة هي ما كان المدرّب
يبحث عنه

239
00:18:28,020 --> 00:18:32,010
،سواء أعملت جاهداً أم لا

240
00:18:32,800 --> 00:18:36,600
سيتمكّن شخصٌ آخر من اللّعب في المُباراة
بدلاً منك

241
00:18:38,000 --> 00:18:41,500
هكذا هي طبيعة هذا الفريق

242
00:18:49,550 --> 00:18:55,770
سنرى من منّا سيقف على التلّة أوّلاً يا يوهي

243
00:18:58,910 --> 00:19:02,380
ما زلتُ أريد أن أكون رامياً

244
00:19:09,430 --> 00:19:10,700
طابت ليلتك

245
00:19:14,360 --> 00:19:16,640
شكراً على دعوتي

246
00:19:17,330 --> 00:19:21,060
ميوكي-سينباي، تمرّن معي غداً من فضلك

247
00:19:21,060 --> 00:19:22,450
!أنت، انتظر

248
00:19:22,450 --> 00:19:25,610
!سيلعب ماسكاً لي في منطقة الإحماء غداً

249
00:19:25,610 --> 00:19:26,660
لم أسمع بذلك

250
00:19:26,660 --> 00:19:28,030
لأنّني لم أقل ذلك

251
00:19:28,360 --> 00:19:30,170
!يجب أن تلتزم بالترتيب

252
00:19:38,960 --> 00:19:43,420
أشعر برغبة في التّلويح قليلاً. أتريد المجيء؟

253
00:19:45,020 --> 00:19:47,180
أحتاج لمساعدة في التّمرين أيضاً

254
00:19:52,820 --> 00:19:55,460
هل فهمتما ما شرحتُه اليوم؟

255
00:19:56,270 --> 00:19:57,500
فهمتُ النقاط الرئيسيّة

256
00:19:57,500 --> 00:20:00,410
!فهمتُ كلّ التفاصيل

257
00:20:00,410 --> 00:20:01,580
...هكذا إذاً

258
00:20:02,490 --> 00:20:06,800
حسناً، لا بديل للتعلّم من خلال الخبرة

259
00:20:06,800 --> 00:20:09,900
!علينا أن نتعلّم من خلال الفعل

260
00:20:12,920 --> 00:20:17,410
عليكما أن تتمرنّا مع ماسكين غيري

261
00:20:17,980 --> 00:20:19,690
ويُفضَّل سنة أولى

262
00:20:23,520 --> 00:20:27,810
إن لم تفهما شيئاً، لا يمكنكما شرح شيء لشخص آخر

263
00:20:28,290 --> 00:20:30,980
ستكون طريقة جيّدة لمراجعة اجتماعاتنا

264
00:20:30,980 --> 00:20:34,300
وستتمكّنان من معرفة ما تحتاجانه

265
00:20:35,130 --> 00:20:38,400
...حسناً، أتفهّم مقصدك، لكن

266
00:20:38,400 --> 00:20:39,400
صحيح؟

267
00:20:40,090 --> 00:20:42,230
هل هذا يعني أنّك ستتخلّى عن مسؤولياتك؟

268
00:20:42,230 --> 00:20:43,170
!تماماً

269
00:20:43,520 --> 00:20:47,620
إن كنتما تريان أنّكما لستما أهلاً لتعليم
طالب سنة أولى، فلن أجبركما

270
00:20:48,820 --> 00:20:53,970
هناك لاعبون أقوياء مثل يوي وأوكومورا هذا العام

271
00:20:54,710 --> 00:20:55,970
!نستطيع بالطبع

272
00:20:55,970 --> 00:20:59,570
كنّا لاعبي سيدو نموذجيّين لعام كامل حتّى الآن

273
00:20:59,570 --> 00:21:01,780
!أنت تستخفّ بنا

274
00:21:02,380 --> 00:21:03,650
إذاً افعلا ذلك

275
00:21:04,740 --> 00:21:07,370
تعمّقا أكثر في معرفة كلّ فرصة لعِب

276
00:21:07,370 --> 00:21:09,540
وتعلّما سبب رميكما لكلّ رمية

277
00:21:09,900 --> 00:21:13,030
هذا ما أحتاجه منكما

278
00:21:15,540 --> 00:21:17,820
...بالتأكيد، لكن

279
00:21:19,310 --> 00:21:20,890
...أريدك

280
00:21:21,530 --> 00:21:23,160
...بالإضافة إلى ذلك

281
00:21:24,230 --> 00:21:26,570
إذا أردتما أن ترميا، فتعالا لرؤيتي

282
00:21:27,120 --> 00:21:29,800
سأفعل ما بوسعي لأساعدكما

283
00:21:39,350 --> 00:21:41,400
أنتما قرّرا الترتيب

284
00:21:41,850 --> 00:21:45,080
عليّ أن أمنعكما من الرّمي زيادة عن اللّزوم

285
00:22:13,270 --> 00:22:14,640
".نفاد الوقت"

286
00:23:45,190 --> 00:23:47,530
لا أستطيع هزيمته بمجرّد الرّمي للخارج

287
00:23:47,530 --> 00:23:51,190
بخروجين، عليك أن تركّز أكثر على الضارب

288
00:23:51,190 --> 00:23:53,720
!والآن، سأركض! سوف أركض

289
00:23:53,720 --> 00:23:59,040
اللّاعب الأوّل هو من يرمي ليربح مهما
كان شعوره

290
00:23:59,040 --> 00:24:03,170
كنتُ أخطِّط للتوقيع أثناء مباريات التّمرين
في الأسبوع الذهبيّ

291
00:24:03,170 --> 00:24:06,000
!شكّل فجوة في صدر الضارب الأيمن

292
00:24:06,000 --> 00:24:09,520
ستكون بادئاً في المُباراة التمرينيّة ضدّ
هاكوريو بعد ثلاثة أيّام

293
00:24:09,520 --> 00:24:11,970
في الحلقة القادمة من اللّاعب الماسيّ الأوّل
:الفصل الثّاني

294
00:24:11,970 --> 00:24:13,040
".مُكلَّف"

295
00:24:13,040 --> 00:24:15,140
!لننل لقب البطولة الوطنيّة