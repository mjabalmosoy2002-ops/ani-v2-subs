1
00:00:04,270 --> 00:00:11,150
كان رمي ساوامورا هو الّذي قاد
.الفريق للأمام بينما كان فورويا يتعافى

2
00:00:12,230 --> 00:00:15,780
أعتقد أنّ جميع اللاّعبين متّفقون

3
00:00:17,280 --> 00:00:22,740
على أنّنا ما كنّا لنصل إلى حيث نحن
.الآن بجهود ساوامورا وفورويا فقط

4
00:00:24,040 --> 00:00:25,870
!سنبدأ الرّقم 1

5
00:00:26,870 --> 00:00:30,000
.لكنّنا لم نبلغ هدفنا

6
00:00:31,250 --> 00:00:37,090
أعتقد أنّ تغيير أرقام القمصان
!سيحفّزهم لإظهار تقدّم أكثر

7
00:00:37,720 --> 00:00:40,300
ماذا؟ أتريده أم لا؟

8
00:00:42,640 --> 00:00:43,760
...سُحقًا

9
00:00:46,020 --> 00:00:47,520
.كفاك ارتعاشًا

10
00:00:57,650 --> 00:01:00,280
.سبق لفورويا أن سار على هذه الطّريق

11
00:01:04,830 --> 00:01:08,040
.ما هذه إلاّ البداية يا ساوامورا

12
00:01:17,760 --> 00:01:20,760
.سنواجه هذا الصّيف مع ساوامورا

13
00:03:00,230 --> 00:03:03,190
.كانت يابانيّته جيّدة للغاية

14
00:03:03,190 --> 00:03:06,410
.لا يستطيع التّواجد بين قائمة اللاّعبين
.هذا مؤسف بالفعل

15
00:03:07,120 --> 00:03:11,410
شكّلنا ثنائيّ رامِ وماسك معًا لشوط واحد في
.المباراة الثّانية لمنافسات طوكيو للمدعوّين

16
00:03:11,990 --> 00:03:14,250
،رأيتُ طريقة لعبه لكرة القاعدة

17
00:03:14,250 --> 00:03:16,210
،ومهاراته التّقنيّة المذهلة

18
00:03:16,210 --> 00:03:18,290
.وعزمه على خوض التّجارب

19
00:03:19,630 --> 00:03:22,800
.أنا فخور لأنّني لعبت معه

20
00:03:31,060 --> 00:03:33,720
!الرّقم 1! حصل ساوامورا على الرّقم 1

21
00:03:33,720 --> 00:03:35,440
هل أصبحت أفضل الآن أو ما شابه؟

22
00:03:35,440 --> 00:03:37,480
!حصلتُ على التّهديد الثّلاثيّ، الرّقم 3

23
00:03:37,480 --> 00:03:39,310
!لا أطيق الانتظار

24
00:03:39,310 --> 00:03:41,020
لستَ مصابًا، صحيح؟

25
00:03:42,820 --> 00:03:44,110
.فهمت

26
00:03:44,740 --> 00:03:47,240
.يمكننا خوض مباراة جادّة إذًا

27
00:03:47,910 --> 00:03:50,950
!يا ساوامورا

28
00:03:51,620 --> 00:03:54,370
!أنت ترتدي الرّقم 1

29
00:03:54,370 --> 00:03:57,040
لماذا لم تخبرني؟

30
00:03:57,040 --> 00:03:59,790
!ليس عليّ إخبارك بكلّ شيء

31
00:03:59,790 --> 00:04:01,880
نحن أصدقاء على "لاين"، صحيح؟

32
00:04:01,880 --> 00:04:03,960
!ذلك فقط لأنّك أجبرتني

33
00:04:03,960 --> 00:04:06,510
!إضافة لذلك، نحن في فريقين متنافسين

34
00:04:06,880 --> 00:04:09,550
!لكنّك ترسل لي ملصقات أحيانًا

35
00:04:06,970 --> 00:04:09,260
هل هما صديقان؟

36
00:04:09,260 --> 00:04:11,260
.هذه أوّل مرّة أسمع بهذا

37
00:04:09,550 --> 00:04:10,890
!فقط لأنّك لا تريد تركي وشأني

38
00:04:11,550 --> 00:04:14,600
تودوروكي، لماذا لا تنضمّ
إلى مجموعتنا على "لاين"؟

39
00:04:14,600 --> 00:04:15,810
.ما كنتُ لأمانع وجودك

40
00:04:15,810 --> 00:04:17,100
!لا تبدأ بإضافة الآخرين

41
00:04:17,100 --> 00:04:18,520
أيّ نوع من المجموعات هذه؟

42
00:04:18,520 --> 00:04:19,940
مجموعة؟

43
00:04:19,940 --> 00:04:21,980
.ليس لديّه هاتف محمول

44
00:04:21,980 --> 00:04:24,530
!ربّما سأنضمّ أنا بما أنّك طلبت

45
00:04:26,440 --> 00:04:27,780
.الجولة الخامسة

46
00:04:29,200 --> 00:04:30,740
.نصف النّهائيّ

47
00:04:34,450 --> 00:04:36,500
!وإيناشيرو في النّهائيّ

48
00:04:40,040 --> 00:04:43,340
!أريد الإطاحة بكلّ هذه الفِرق

49
00:04:42,000 --> 00:04:45,670
!مهلاً، عليك هزيمتنا أوّلاً يا تودوروكي

50
00:04:45,670 --> 00:04:49,090
نعم، لا تتحدّث وكأنّك تأهّلت
!للنّهائي بالفعل

51
00:04:49,090 --> 00:04:50,970
.أصواتكم مرتفعة جدًّا

52
00:04:57,890 --> 00:04:59,940
مي-سان، هل سمعت بالأمر؟

53
00:04:59,940 --> 00:05:02,270
.لدى سيدو حامل رقم 1 جديد

54
00:05:03,900 --> 00:05:05,230
من يكون؟

55
00:05:05,230 --> 00:05:06,900
.ساوامورا من السّنة الثّانية

56
00:05:11,450 --> 00:05:15,160
فهل ستتجاوزهم، أم سيحقونك؟

57
00:05:16,790 --> 00:05:23,170
واضح لي أنّ تختبر كلّ ذلك
.الآن يا فورويا ساتورو

58
00:05:25,000 --> 00:05:26,460
.هكذا إذًا

59
00:05:26,460 --> 00:05:29,550
.لم يستطع تجاوزهم إذًا

60
00:05:32,010 --> 00:05:36,260
.لا يهمّ ضدّ من سأقف بالطّبع

61
00:05:38,100 --> 00:05:40,940
.سأسحق كلّ من يقف في طريقنا

62
00:05:41,520 --> 00:05:43,230
.هذا هو الأمر ببساطة

63
00:05:50,650 --> 00:05:54,410
،راميهم الأوّل هو الرّقم 12
.أوسو من السّنة الثّانية

64
00:05:54,820 --> 00:05:58,620
إنّه رامٍ أيمن تقليديّ يعتمد أساسًا
.على كراته السّريعة

65
00:05:58,620 --> 00:06:04,330
حامل الرّقم 1 لديهم هو هيغاشياما من
.السّنة الثّالثة ولم يلعب هذه المباراة

66
00:06:05,210 --> 00:06:08,090
،سيندا ضاربهم الرّابع
.لديه معدّل 3 ضربات مسجّلة

67
00:06:08,090 --> 00:06:12,090
،يستعملون مناورات اللّعب المضغوط
.والضّرب والرّكض لإحراز النّقاط

68
00:06:12,590 --> 00:06:17,510
سجّلوا 11-2 ضدّ ساكانوي عندما
.تمّ إنهاء المباراة في الشّوط السّابع

69
00:06:18,810 --> 00:06:24,560
سأشاهد مباراة جولتهم الثّانية الأسبوع
.القادم لأراقب ضاربيهم أكثر

70
00:06:25,440 --> 00:06:28,020
.اطلب من شخص آخر أن يشاهد الفرق الأخرى أيضًا

71
00:06:28,020 --> 00:06:28,480
.حاضر

72
00:06:34,990 --> 00:06:38,660
.مدرّب سيدو المشهور، ساكاكي إيجيرو

73
00:06:39,200 --> 00:06:40,830
.لقد كان معلّم المدرّب كاتاوكا

74
00:06:41,120 --> 00:06:43,160
هل سيكون من الصّعب عليه مواجهته؟

75
00:06:44,790 --> 00:06:49,500
.مباراتنا الأولى في الخامس عشر
.ما زال أمامنا وقت كثير

76
00:06:50,250 --> 00:06:53,090
.أريد  العمل على الأرقام أكثر لإتقانها

77
00:06:53,090 --> 00:06:56,090
أريد أن يكون لديّ رميات أكثر
.أستطيع رميها في المنافسة

78
00:06:56,970 --> 00:06:59,560
.هنالك الكثير أحتاج لتحسينه

79
00:07:00,350 --> 00:07:02,560
!ليست لديّ لحظة لأضيّعها

80
00:07:04,230 --> 00:07:05,810
.تعلو وجهك ملامح مخيفة

81
00:07:07,480 --> 00:07:10,150
هنالك أكثر من أسبوع
.بين اليوم ويوم مباراتنا

82
00:07:10,150 --> 00:07:13,360
،إن تحمّستَ كثيرًا من الآن
.فستتعب نفسك

83
00:07:14,200 --> 00:07:15,450
مخيفة؟

84
00:07:15,450 --> 00:07:17,070
.نعم، أنت على حقّ

85
00:07:17,410 --> 00:07:18,450
!ساوامورا

86
00:07:18,950 --> 00:07:21,450
.رميتَ فقط خلال التّمارين الميدانيّة اليوم

87
00:07:21,450 --> 00:07:22,750
هل تريد التّدرّب في منطقة التّسخين غدًا؟

88
00:07:22,750 --> 00:07:23,750
!بكلّ تأكيد

89
00:07:23,750 --> 00:07:26,580
.أريد إتقان الأرقام أكثر

90
00:07:26,580 --> 00:07:27,630
.مفهوم

91
00:07:28,290 --> 00:07:32,630
.لنتقنها بقدر ما نستطيع هذا الصّيف

92
00:07:32,630 --> 00:07:34,590
!شكرًا لك أيّها القائد

93
00:07:35,090 --> 00:07:36,590
...إتقانها

94
00:07:36,880 --> 00:07:39,140
.سأتدرّب معك اليوم التّالي يا فورويا

95
00:07:39,510 --> 00:07:40,970
.شكرًا لك

96
00:07:40,970 --> 00:07:43,640
ميوكي، ماذا عنّي؟

97
00:07:45,850 --> 00:07:47,520
هل ستمسك رمياتي؟

98
00:07:48,850 --> 00:07:50,110
ما اليوم الّذي يناسبك؟

99
00:07:51,770 --> 00:07:52,900
...نوري

100
00:07:53,690 --> 00:07:55,610
!أحسنت يا نوري! لا تتردّد

101
00:07:55,610 --> 00:07:57,070
!ميوكي مصدوم

102
00:07:57,070 --> 00:07:59,820
!سُحقًا، ليتني أمتلك روح المبادرة تلك

103
00:07:59,820 --> 00:08:01,780
!لم يفت الأوان بعد

104
00:08:02,490 --> 00:08:04,370
ما رأيك في الآن؟

105
00:08:04,370 --> 00:08:06,210
!نعم، لنقم بذلك

106
00:08:06,210 --> 00:08:08,000
!هذا هو المطلوب

107
00:08:08,000 --> 00:08:09,420
!حقّق نوري مراده

108
00:08:09,420 --> 00:08:11,130
!إنّهما ثنائيّ الآن

109
00:08:11,920 --> 00:08:13,050
ما هذا؟

110
00:08:13,050 --> 00:08:14,760
!حسنًا، سأكون الضّارب الاحتياطيّ

111
00:08:14,760 --> 00:08:15,630
!سأكون الحكم

112
00:08:15,920 --> 00:08:18,010
آسو، أتريد التّدرّب مع الآلة؟

113
00:08:18,010 --> 00:08:19,510
!كنتُ سأفعل ذلك في كلّ الأحوال

114
00:08:19,510 --> 00:08:21,800
!ماذا؟ كنتُ أحاول دعوتك

115
00:08:21,800 --> 00:08:24,010
!القفص ليس حكرًا لك وحدك

116
00:08:25,060 --> 00:08:26,770
!كفاكما عبثًا

117
00:08:25,520 --> 00:08:29,060
تشعر بثقة أكبر بالنّفس بما أنّك
تحمل رقمًا من رقم واحد، صحيح؟

118
00:08:29,690 --> 00:08:32,610
إنّ لاعبي السّنة الثّالثة على
وفاق دائم مؤخّرًا؟

119
00:08:32,610 --> 00:08:34,730
.صحيح، لاحظتُ ذلك أيضًا

120
00:08:34,730 --> 00:08:38,990
ميوكي-سينباي وكوراموتشي-سينباي
كانا معًا في المدرسة

121
00:08:38,990 --> 00:08:40,780
.وضحكا كثيرًا معًا أيضًا

122
00:08:41,490 --> 00:08:44,120
وكأنّهما مرتاحان أكثر مع بعضهما

123
00:08:44,120 --> 00:08:45,490
.وبلغا مستوى الثّقة المطلوب

124
00:08:54,090 --> 00:08:55,300
...سأواصل

125
00:08:56,550 --> 00:08:58,380
...ولو ليوم آخر أضافيّ

126
00:09:00,720 --> 00:09:04,640
!أنا اللاّعب الأوّل لفريقنا

127
00:09:07,520 --> 00:09:11,810
!أن أسمح بانتهاء صيف لاعبي السّنة الثّالثة بعد

128
00:09:14,690 --> 00:09:16,190
.مرحبًا يا تيشّين

129
00:09:16,190 --> 00:09:18,530
.تمكّنّا من الفوز في بمباراتنا الأولى

130
00:09:18,530 --> 00:09:21,990
بقيت مباراة واحدة ويتسنّى
.لنا اللّعب ضدّ فريقك

131
00:09:21,990 --> 00:09:26,620
لديّ تقدير جديد لرفاهيّة
.أن يكون الفريق مصنّفًا سلفًا

132
00:09:27,160 --> 00:09:30,710
.سننتظرك في الجولة الثّالثة أيّها المدرّب

133
00:09:30,710 --> 00:09:35,710
أرى أنّك تعلّمتَ كيف تتحدّث
.بشكل لائق أيّها الشّقيّ الفظّ

134
00:09:36,340 --> 00:09:38,630
،بدأتُ هذا العمل في الخريف

135
00:09:38,630 --> 00:09:41,590
لكنّني كنتُ أجنّد اللاّعبين
.وأجهّز المرافق قبل ذلك

136
00:09:41,880 --> 00:09:45,050
.أنا على أهبة الاستعداد

137
00:09:45,720 --> 00:09:47,970
!من الأفضل أنّ تستعدوّا لنهايتكم

138
00:09:48,890 --> 00:09:51,600
!حاضر! أتطلّق قُدمًا لذلك

139
00:10:04,030 --> 00:10:05,740
.صباح الخير

140
00:10:06,240 --> 00:10:07,490
...وصباحك

141
00:10:08,990 --> 00:10:10,580
.يا أسادا

142
00:10:11,370 --> 00:10:13,460
.انظر إلى هذا الغبيّ

143
00:10:15,380 --> 00:10:18,210
.خلد للنّوم مرتديًا زيّه

144
00:10:22,300 --> 00:10:24,550
!أسادا، أحضر لي قلمًا لبديًّا

145
00:10:24,550 --> 00:10:26,100
...لماذا تريده

146
00:10:26,100 --> 00:10:27,680
!لا أحضره فحسب

147
00:10:29,680 --> 00:10:31,560
ماذا؟ هُتاف؟

148
00:10:31,560 --> 00:10:33,810
!نعم، لنقوم بتشجيعكم

149
00:10:33,810 --> 00:10:36,480
!سنؤدّي هُتافًا من المدرّجات لدعمكم

150
00:10:36,480 --> 00:10:38,270
فعلاً؟

151
00:10:38,270 --> 00:10:40,190
هل أنت واثقة من ذلك؟

152
00:10:40,190 --> 00:10:42,900
تُسلّط الشّمس أشعتها
!على المدرّجات طول الوقت

153
00:10:43,530 --> 00:10:47,160
،لا يوجد سقف كما في دكّة الفريق
!لذلك قد يصبح الجوّ حارًّا

154
00:10:47,160 --> 00:10:48,580
!كوني حذرة على المدرّجات

155
00:10:48,580 --> 00:10:50,040
فعلاً؟

156
00:10:50,040 --> 00:10:53,080
...لكنّني سأطلب ذلك من التّلاميذ الأكبر

157
00:10:53,080 --> 00:10:55,460
!وسنجد حلاًّ ما

158
00:10:53,750 --> 00:10:57,380
،ما كنتُ لأريد التّواجد هناك
.لكنّها دعتني في كلّ الأحوال

159
00:10:55,460 --> 00:10:56,750
!ستفقدون وعيكم جميعًا

160
00:10:58,630 --> 00:11:00,750
.لكن شكرًا لكم

161
00:11:01,170 --> 00:11:05,090
سنعمل بجدّ ليكون هنالك ما
!تشجّعون من أجله

162
00:11:07,680 --> 00:11:10,060
!نعم، من الأفضل أن تتأهّلوا لملعب كوشيين

163
00:11:10,060 --> 00:11:12,020
!أكيد، لك ذلك

164
00:11:10,560 --> 00:11:13,310
.يبدو ساوامورا مختلفًا ثانية

165
00:11:12,020 --> 00:11:13,430
!لا أطيق الانتظار

166
00:11:13,310 --> 00:11:15,100
هل حدث أمر ما في فريق كرة القاعدة؟

167
00:11:13,430 --> 00:11:15,850
!يصبح الجوّ حارًّا جدًّا في منافسة الصّيف

168
00:11:15,100 --> 00:11:18,360
...حسنًا... إنّ

169
00:11:15,850 --> 00:11:18,230
،لم يكن فورويا في المدرّجات

170
00:11:18,230 --> 00:11:20,570
!لكنّه كان يموت خلال المراسم الافتتاحيّة

171
00:11:18,770 --> 00:11:19,940
...نوعًا ما

172
00:11:23,400 --> 00:11:25,280
.لديّ قميص برقم واحد أيضًا

173
00:11:25,280 --> 00:11:26,610
...رقم واحد

174
00:11:26,910 --> 00:11:28,700
فعلاً؟

175
00:11:27,530 --> 00:11:29,200
...أريد إخبار شخص ما

176
00:11:28,700 --> 00:11:31,490
ولم يكن أوكومورا في حالة
!جيّدة هذا العام أيضًا

177
00:11:30,530 --> 00:11:32,490
!أريد من الجميع أن يسأل

178
00:11:34,080 --> 00:11:34,830
...ولذلك

179
00:11:34,830 --> 00:11:37,630
!رسم واحدًا على ظهره

180
00:11:37,630 --> 00:11:39,500
!لا أطيق الانتظار حتّى يذهب للاستحمام

181
00:11:40,920 --> 00:11:42,420
.دعه وشأنه

182
00:11:42,840 --> 00:11:44,380
أهذا معقول؟

183
00:11:44,380 --> 00:11:45,090
!ممتاز

184
00:11:45,090 --> 00:11:46,840
!نعم، أخبرتك

185
00:11:54,390 --> 00:11:56,480
!أيّها الرّامي، الكرة للقاعدة الثّالثة

186
00:11:56,480 --> 00:11:57,230
!حاضر

187
00:11:57,230 --> 00:11:58,480
!أنا جاهز

188
00:12:15,410 --> 00:12:18,080
.يتحرّكون جميعًا جيّدًا

189
00:12:18,080 --> 00:12:21,750
كنتُ قلقًا كيف سيتقبّل فورويا
.الأمر، لكنّه يبدو بخير

190
00:12:22,960 --> 00:12:25,550
.يبدو أنّه يستمتع بوقته

191
00:12:26,630 --> 00:12:29,090
!حسنًا، لنقم بهذا يا كاني-يان

192
00:12:29,340 --> 00:12:31,850
وما زال ساوامورا يحدّث الفريق
!بصوت عالٍ كالعادة

193
00:12:33,470 --> 00:12:34,430
!يو-سان

194
00:12:39,480 --> 00:12:42,520
!كانت تلك رمية خلفيّة سريعة

195
00:12:42,520 --> 00:12:47,110
على الرّامي والماسك أن يثقا
!في بعضهما بالكامل لإنجاح ذلك

196
00:12:52,320 --> 00:12:54,700
!أنا الرّقم 5

197
00:12:55,080 --> 00:12:57,120
!جيّد، لعب ممتاز

198
00:12:57,710 --> 00:12:59,790
!لكن ربّما تكون بمحض الصّدفة

199
00:13:00,120 --> 00:13:02,670
سيكون ذلك جيّدًا فقط
!إن نجحت في كلّ مرّة

200
00:13:03,790 --> 00:13:05,130
!معك حقّ

201
00:13:07,510 --> 00:13:08,800
!إنّها متّجهة للخلف

202
00:13:08,800 --> 00:13:11,140
!اذهب تحتها

203
00:13:14,100 --> 00:13:17,350
اجعل خطوتك أسرع وسيكون
!من السّهل إمساكها

204
00:13:18,270 --> 00:13:22,310
شاهد يا يوكي. هكذا تبدو
!خطوتي الأولى

205
00:13:41,830 --> 00:13:45,250
!حسنًا! يبدو الرّقم 2 جيّدًا اليوم

206
00:13:45,960 --> 00:13:51,050
لن يستطيع الضّارب ضربها عندما تنزل
!إلى قدميه سواء كان أيمنًا أم أعسرًا

207
00:13:51,760 --> 00:13:53,970
!لنقم بالرّقم 11 تاليًا

208
00:13:53,970 --> 00:13:55,850
!سأرمي عشر رميات متتالية

209
00:13:56,970 --> 00:13:57,850
.كلاّ

210
00:13:58,970 --> 00:14:01,890
رميتَ البارحة، لذلك دعنا
.ننتهي باكرًا اليوم

211
00:14:05,520 --> 00:14:07,070
!لكن ما زال بإمكاني الرّمي

212
00:14:07,070 --> 00:14:08,440
.رميتَ 120 رمية

213
00:14:08,440 --> 00:14:09,940
.هذا يكفي لليوم

214
00:14:10,360 --> 00:14:12,950
.اذهب لترتاح وسيكون الغد تدريبًا بلا رمي

215
00:14:13,240 --> 00:14:15,370
!بلا رمي؟

216
00:14:16,240 --> 00:14:18,490
!دعني أرمي اليوم أكثر إذًا

217
00:14:18,490 --> 00:14:19,540
!أيّها القائد

218
00:14:23,620 --> 00:14:24,540
!أوكومورا

219
00:14:24,540 --> 00:14:25,750
.أنا أرفض

220
00:14:26,380 --> 00:14:28,170
!أنت بلا قلب

221
00:14:28,500 --> 00:14:30,920
.أظنّ أنّك رميت كثيرًا أيضًا

222
00:14:35,640 --> 00:14:37,010
.لا تكبح إحباطك

223
00:14:38,350 --> 00:14:40,470
!لا بأس! سأكتفي لليوم

224
00:14:40,470 --> 00:14:45,230
،أحتاج لحرق بعض الطّاقة
!لذا سأركض عشر دورات بالعجلة

225
00:14:45,230 --> 00:14:47,060
لماذا أنت غاضب؟

226
00:14:47,650 --> 00:14:49,440
!ها أنا ذاهب

227
00:14:51,740 --> 00:14:53,150
...يا إلهي

228
00:14:53,610 --> 00:14:55,860
،بحسّه القويّ بالمسؤوليّة

229
00:14:55,860 --> 00:14:59,080
ظننتُ أنّ حصوله على الرّقم
.الأوّل سيُحمّسه

230
00:15:00,370 --> 00:15:04,160
.لكنّه يتوتّر كثيرًا بالفعل

231
00:15:05,000 --> 00:15:07,380
لستُ واثقًا كيف سيُترجم
.هذا في المباراة

232
00:15:15,470 --> 00:15:20,220
الأحد 13 يوليوز

233
00:15:20,260 --> 00:15:23,730
الجولة الثّانية من المراحل التّمهيديّة لغرب طوكيو
تشوو سوغيوتشي - يورا سوغو

234
00:15:32,900 --> 00:15:33,900
!أجل

235
00:15:33,900 --> 00:15:35,150
!ضربة جيّدة يا سين-سان

236
00:15:35,150 --> 00:15:37,360
!هكذا يكون الضّارب في المحن

237
00:15:37,910 --> 00:15:40,160
حقّق الضّارب الرّابع ضربة مسجّلة أخرى؟

238
00:15:40,660 --> 00:15:43,040
.كان ينتظر تلط الكرة المنحنية

239
00:15:43,040 --> 00:15:46,250
نعم. انتظر حتّى آخر لحظة
.ممكنة ليلوّح بمضربه

240
00:15:47,290 --> 00:15:50,670
من المدهش كيف يستطيع
.دائمًا النّجاح عندما نحتاجه

241
00:15:51,050 --> 00:15:53,710
.كلاّ، إنّه هو الأكثر إدهاشًا

242
00:15:53,710 --> 00:15:57,050
كيف علِم أنّ الكرة الثّالثة ستكون منحنية؟

243
00:15:57,330 --> 00:16:02,680
ويتوقّع دائمًا محاولات السّرقة
.والضّغط بدقّة

244
00:16:03,560 --> 00:16:07,310
،أنت مخيف أكثر من كونك تثير الدّهشة

245
00:16:07,310 --> 00:16:09,610
!يا وحش كرة القاعدة

246
00:16:09,610 --> 00:16:13,400
حسنًا. أعتقد أنّ بإمكاننا
.تحقيق نقطتين أخريتين

247
00:16:15,320 --> 00:16:17,820
دخل هيغاشياما المباراة كبديل
،في الشّوط السّادس

248
00:16:17,820 --> 00:16:20,600
.ومرّ على كلّ ضاربي سوغيوتشي السّتّة

249
00:16:20,600 --> 00:16:23,710
،تمّ إنهاء المباراة بعد الشّوط السّابع
.وكانت النّتيجة 13-2

250
00:16:25,330 --> 00:16:28,080
...وهكذا، فإنّ أوّل خصومنا

251
00:16:28,080 --> 00:16:30,900
.ستكون ثانويّة يورا سوغو التّقنيّة

252
00:16:35,370 --> 00:16:38,000
.لقد فازوا بالمباراتين المذكورتين

253
00:16:38,000 --> 00:16:40,810
.وتشكيلة تسلسل ضاربيهم جيّدة جدًّا

254
00:16:40,800 --> 00:16:49,810
يورا

255
00:16:40,800 --> 00:16:49,810
تشوو سغيوتشي

256
00:16:41,220 --> 00:16:43,880
اللّعب المضغوط والسّرقات
...والضّرب والرّكض

257
00:16:43,880 --> 00:16:47,720
،حقّقوا كلّ شيء تقريبًا في رمية واحدة
.وسجّلوا بكلّ براعة

258
00:16:47,720 --> 00:16:49,010
.ذلك أكثر ما ميّز المباراة

259
00:16:50,420 --> 00:16:52,500
.يسجّلون نقطة بعد نقطة لكن بثبات

260
00:16:52,500 --> 00:16:56,640
على الأرجح أنّ لاعب الفريق الخصم
.الأوّل لم يدرك ما حدث معه

261
00:16:57,950 --> 00:17:00,400
،لاعبهم الأوّل وراميهم البارع هيغاشياما

262
00:17:00,400 --> 00:17:03,820
وضارهم الرّابع سيندا الّذي حقّق ثلاثة
...ضربات مسجّلة في هذه المباراة

263
00:17:03,820 --> 00:17:07,810
.علينا فعلاً أن نلزم حذرنا منهما

264
00:17:08,210 --> 00:17:12,720
وبذلك، حصلنا على فرصة
،لمراقبة لعبهم في جولتين

265
00:17:12,720 --> 00:17:16,070
ممّا يجعل من السّهل علينا
.تدارك أسلوب ضاربيهم بإتقان

266
00:17:16,970 --> 00:17:18,730
.سنحتاج للتّحقّق من بيانات كلّ ضارب لاحقًا

267
00:17:19,300 --> 00:17:20,050
.نعم

268
00:17:21,740 --> 00:17:23,980
،إنّ لعبهم متقن مُدار من الدّكّة

269
00:17:23,980 --> 00:17:26,370
وتضع استراتيجيّة الرّمي
.لاعبهم الأوّل كاحتياطيّ

270
00:17:27,000 --> 00:17:30,850
والأهمّ من ذلك، لقد فازوا بمباراتين
.ولديهم الزّخم المطلوب إلى جانبهم

271
00:17:31,720 --> 00:17:34,650
.لا يمكننا الاستخفاف بهم على الإطلاق

272
00:17:36,680 --> 00:17:40,320
إضافة إلى أنّ المدرّبان الرّئيسيّان
.عبارة عن تلميذ ومعلّمه

273
00:17:40,320 --> 00:17:43,130
.يعلم كلاهما كيف يعمل الآخر

274
00:17:43,760 --> 00:17:46,730
،بأخذ هذا في حسباننا
.سأعلن عن الرّامي الأوّل

275
00:17:48,670 --> 00:17:51,530
.ساوامورا، أنا أعتمد عليك

276
00:17:55,840 --> 00:17:56,880
!حاضر

277
00:17:58,630 --> 00:18:01,850
وفي الجولة الرّابعة بعد يومين
!من ذلك، ستكون أنت يا فورويا

278
00:18:02,470 --> 00:18:03,730
.أنت الرّامي الأوّل

279
00:18:06,330 --> 00:18:08,480
،وبالنّسبة لكاواكامي وكانيدا

280
00:18:08,960 --> 00:18:12,710
كونا في منطقة التّسخين من بداية
.المباراة مهمًا كان خصمنا

281
00:18:12,710 --> 00:18:13,730
!حاضر

282
00:18:14,900 --> 00:18:17,280
!هذه منافسة الخسارة فيها تعني الاستبعاد

283
00:18:17,610 --> 00:18:20,070
.الأمر لا يهمّ اللاّعبين في الميدان فحسب

284
00:18:20,070 --> 00:18:23,950
علينا نحن من يجلسون في الدّكّة أن نكون
.مستعدّين لتقديم الأفضل في كلّ وقت أيضًا

285
00:18:23,960 --> 00:18:25,320
!حاضر

286
00:18:31,360 --> 00:18:34,910
البدء كرامٍ هو أمر مختلف تمامًا
.عم الرّمي كبديل

287
00:18:35,800 --> 00:18:40,200
طريقة تغييرنا للاّعبين ستعتمد
،على كيفية سير المباراة بالطّبع

288
00:18:40,580 --> 00:18:43,480
لكنّ حقيقة أنّ المدرّب
قد جعل دور كلّ رامٍ واضحًا

289
00:18:43,480 --> 00:18:46,280
.سيساعدهم على التّركيز جيّدًا

290
00:18:54,930 --> 00:19:00,060
لا أحتاج لأذكّرك، لكن منحك رقم اللاّعب
.الأوّل يعني أنّي أتوقّع الكثير منك

291
00:19:01,030 --> 00:19:05,160
لكنّ ذلك يكون مهمًّا فقط
.إن أمكنك الرّمي كما كنت تفعل

292
00:19:06,250 --> 00:19:10,210
أريدك أن تظهر على تلّة الرّمي نتائج
.كلّ ما فعلته حتّى الآن

293
00:19:18,920 --> 00:19:23,630
،مباراتنا الأولى هذا الصّيف
،الخطوة الأولى نحو البطولة الوطنيّة

294
00:19:23,630 --> 00:19:27,780
،بداية ساوامورا الأولى الرّسميّة
.وأوّل مرّة يرتدي فيها رقم اللاّعب الأوّل

295
00:19:29,200 --> 00:19:32,110
بداية ساوامورا هذه ستكون
...مليئة بأشياء تحدث لأوّل مرّة

296
00:19:34,950 --> 00:19:38,020
.أتمنّى فقط ألاّ يخفق

297
00:19:41,320 --> 00:19:42,570
إنّه أخي؟

298
00:19:43,260 --> 00:19:45,350
ستلعبون مباراتكم الأولى بعد يومين، صحيح؟

299
00:19:49,390 --> 00:19:52,050
.تطلّعا لتكونا أفضل لاعبي منتصف ميدان في اليابان

300
00:19:53,410 --> 00:19:56,180
!نعم! سنلعب ضدّ يورا سوغو

301
00:19:58,100 --> 00:19:59,830
!بالطّبع سأكون بخير

302
00:19:59,830 --> 00:20:02,410
!تجاوزت فترة ركودي بالكامل

303
00:20:02,410 --> 00:20:04,270
!إنّنا نهدف للقمّة

304
00:20:04,270 --> 00:20:06,980
!انتظرنا في ملعب كوشيين يا جون-سان

305
00:20:09,800 --> 00:20:11,020
أتمانع إن انضممت لك؟

306
00:20:12,240 --> 00:20:13,540
...فورويا-سان

307
00:20:14,750 --> 00:20:17,040
أواثق أنّك تريد الضّرب؟

308
00:20:17,520 --> 00:20:19,150
.سأمسك بكراتك إن أردتَ الرّمي

309
00:20:19,150 --> 00:20:22,370
.لا بأس، بإمكاننا فعل ذلك غدًا

310
00:20:53,390 --> 00:20:55,890
.ما زال متوتّرًا

311
00:20:55,890 --> 00:20:58,190
.أعتقد أنّ وجهد يبدو أغبى في العادة

312
00:20:58,190 --> 00:20:59,100
صحيح؟

313
00:20:59,100 --> 00:21:00,570
.أوافقك

314
00:21:00,570 --> 00:21:01,400
...ما

315
00:21:00,950 --> 00:21:04,070
.أعتاد أن يبدو أكثر استرخاءً وإثارة للشّفقة

316
00:21:04,990 --> 00:21:06,330
استرخاءً؟

317
00:21:06,330 --> 00:21:10,400
مهلاً، ما الّذي نتدرّب عليها هنا من الأساس؟
!لماذا لا تسمحا لي بالرّمي؟

318
00:21:10,400 --> 00:21:13,330
!أريد التّدرّب على الأرقام

319
00:21:13,330 --> 00:21:14,900
تسأل ماذا؟

320
00:21:14,900 --> 00:21:17,500
.إنّنا نقوم بهذا لأنّك متوتّر جدًّا

321
00:21:17,500 --> 00:21:21,320
من الواضح عليك تمامًا أنّ كونك
.اللاّعب الأوّل يُلقي بثقله عليك

322
00:21:23,240 --> 00:21:25,580
رغم أنّني أفضّل هذا على
...كونك راضٍ على نفسك

323
00:21:25,580 --> 00:21:29,630
لكن عليّ أن أصلح هذا، بصفتنا
.ماسكك وقائد الفريق

324
00:21:29,630 --> 00:21:31,300
!لا تطعنّي في القلب مباشرة

325
00:21:31,300 --> 00:21:33,970
!ألم يكن بمقدورك اختيار كلمات أكثر رقّة؟

326
00:21:33,970 --> 00:21:39,230
تعلّموا اليوم

327
00:21:33,970 --> 00:21:39,230
كرّسوا كلّ لحظة في حياتكم

328
00:21:34,300 --> 00:21:36,850
.أنت من يحتاج لكلّ شيء بالتّفصيل

329
00:21:36,850 --> 00:21:38,570
!ماذا تعتقدني في رأيك؟

330
00:21:41,730 --> 00:21:43,920
،بما أنّني بصدد ذلك
.طعني أخبرك بأمر آخر

331
00:21:43,920 --> 00:21:44,730
ماذا؟

332
00:21:44,730 --> 00:21:46,730
،قبل بعضة أشهر مضت

333
00:21:46,730 --> 00:21:51,820
ما كنتُ أبدًا لأتخيّلك ترتدي رقم
.اللاّعب الأوّل هذا الصّيف

334
00:21:54,840 --> 00:21:58,760
.إنّكم تتجاوزون توقّعاتي دائمًا

335
00:22:03,250 --> 00:22:08,260
‪‫13 يوليوز

336
00:22:03,250 --> 00:22:08,260
تاكيغاوا كريس
بدايتك كلاعب أوّل، صحيح؟ إنّها مسؤوليّة كبيرة

337
00:22:12,840 --> 00:22:14,080
".تشجيع"

338
00:23:45,420 --> 00:23:47,140
.سأقوم بالإحماء من باب الحيطة

339
00:23:47,140 --> 00:23:49,390
!لن تقوم بالرّمي اليوم

340
00:23:49,390 --> 00:23:51,690
!إيّاك أن تجرؤ على تجاوز ذلك الخطّ ثانية

341
00:23:51,690 --> 00:23:56,570
على الأرجح أنّ ثنائيّ الرّامي والماسك هذا
.قد تخطّى الكثير من العقبات حتّى الآن

342
00:23:56,570 --> 00:23:58,600
،كلّما زادت المشاكل الّتي واجهاها

343
00:23:58,600 --> 00:24:03,120
.لجؤوا أكثر إلى الرّمية الّتي يثقون بها أكثر

344
00:24:03,120 --> 00:24:06,380
الجميع يدعمونني. عليّ فقط
...أن أركّز على القفّاز

345
00:24:06,380 --> 00:24:09,400
!كلّ ما عليّ هو التّركيز على قفّاز الماسك

346
00:24:09,400 --> 00:24:11,870
في الحلقة القادمة من
:اللاّعب الماسيّ الأوّل"، الفصل الثّاني"

347
00:24:11,870 --> 00:24:13,120
".تحت القدمين"

348
00:24:13,120 --> 00:24:15,210
!لنفز باللّقب الوطنيّ

349
00:24:15,220 --> 00:24:20,210
رسم ملوّن / تيراجيما يوجي

350
00:24:15,220 --> 00:24:20,210
...يُتبع