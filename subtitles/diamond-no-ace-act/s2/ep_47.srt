1
00:00:05,480 --> 00:00:09,650
هذه مباراتهم ضدّ ثانويّة إيتشيداي
.الثّالثة في منافسات الرّبيع

2
00:00:09,650 --> 00:00:11,650
كيف حصلت عليها؟

3
00:00:11,650 --> 00:00:14,190
.أعرف شخصًا ما

4
00:00:14,190 --> 00:00:17,280
.لديّ تسجيل لمباراتهم ضدّ هاكوريو أيضًا

5
00:00:17,820 --> 00:00:21,660
لعبنا مباراة للتّوّ، لكنّه يفكّر
.سلفًا في المباراة التّالية

6
00:00:21,660 --> 00:00:24,790
وكم من المعارف الّذين يملكهم؟

7
00:00:24,790 --> 00:00:26,580
،شاهدتُ مباراة الجولة الرّابعة

8
00:00:26,580 --> 00:00:29,920
لكنّ فورويا لا يرمي كما
.هو متوقّع منه إطلاقًا

9
00:00:29,920 --> 00:00:34,920
،لستُ واثقًا إن كان مصابًا
.لكنّ من المؤكّد أنّه لا يرمي جيّدًا

10
00:00:35,170 --> 00:00:41,220
قاموا بتغييره كلاعب أوّل
.بالمدعوّ ساوامورا إيجون

11
00:00:41,220 --> 00:00:46,100
كانت موهبته بارزة  عندما رأيته
،يلعب الخريف الماضي

12
00:00:46,100 --> 00:00:49,100
.لكن يبدو أنّه قد بلغ مستوى جديدًا بالكامل

13
00:00:50,310 --> 00:00:51,850
إلى ذلك الحدّ؟

14
00:00:51,850 --> 00:00:53,770
.لديه نظرة مميّزة في عينيه

15
00:00:53,770 --> 00:00:55,690
.كان توّاقًا ليُمنح فرصة

16
00:00:56,690 --> 00:01:01,280
لم تمرّ سوى ثلاثة أشهر مذ قام
.فورويا بالرّمي في منافسات المدعوّين

17
00:01:01,610 --> 00:01:04,780
يوضّح التّغيير الجذريّ في تشكيلة الفريق

18
00:01:04,780 --> 00:01:07,620
.أنّ هنالك عدّة نقاط ضعف لنستغلّها

19
00:01:13,710 --> 00:01:18,880
.إنّ هذا يحمّس دماء المقامر في عروقي

20
00:02:51,220 --> 00:02:54,640
...واضح أنّ هذا الفريق ليس ندًّا لإيناشيرو

21
00:02:54,640 --> 00:02:56,480
.لكنّهم ما زالوا سيبدؤون بلاعبهم الأوّل

22
00:02:56,480 --> 00:02:58,610
.إنّهم يرفضون إظهار أيّ علامة ضعف

23
00:02:58,610 --> 00:03:01,070
.هكذا يقاتل الأبطال

24
00:03:01,070 --> 00:03:03,570
إنّهم يأخذون مباراتهم الأولى
.على محمل الجدّ

25
00:03:04,780 --> 00:03:07,120
.حان الوقت يا مي-سان

26
00:03:07,120 --> 00:03:09,490
.لا مجال للتّراجع الآن

27
00:03:09,490 --> 00:03:10,740
.اقض عليهم

28
00:03:10,740 --> 00:03:12,370
!نل منهم يا ناروميا

29
00:03:12,370 --> 00:03:13,120
!مي-سان

30
00:03:13,120 --> 00:03:14,750
!ناروميا-سان

31
00:03:15,120 --> 00:03:20,380
إن رسم ملامح توحي بأنّك لن
.تُهزم بسهولة لن يساعدك

32
00:03:21,500 --> 00:03:25,840
!هذا الصّيف لنا نحن

33
00:03:28,090 --> 00:03:30,930
تُقام تصفيات البطولة الوطنيّة
لكرة القاعدة للثّانويّات

34
00:03:30,930 --> 00:03:33,310
.في شرق وغرب طوكيو منذ الخامس من يوليوز

35
00:03:33,310 --> 00:03:36,770
،ثانويّة إيناشيرو الصّناعيّة
،المصنّفة أن تبدأ في الجولة الثّالثة

36
00:03:36,770 --> 00:03:38,770
.قد سحقت ثانويّة ساواداي الثّانية

37
00:03:39,270 --> 00:03:41,650
بعد احتلالهم المركز الثّاني في ملعب
،كوشيين الصّيف الماضي

38
00:03:41,650 --> 00:03:43,990
ثمّ الاستبعاد غير المتوقّع
،في منافسات الخريف

39
00:03:43,990 --> 00:03:47,280
فازوا بكلّ من منافسات الرّبيع
.ومنافسات كانتو

40
00:03:47,280 --> 00:03:52,290
ما الّذي سيجلبه الصّيف لي ناروميا مي
الّذي قيل أنّه أفضل لاعب في جيله؟

41
00:03:52,660 --> 00:03:57,170
،غدًا، ستقوم ثانويّة سيدو، غريمة إيناشيرو
،والّتي لعبت أيضًا في منافسات المدعوّين

42
00:03:57,170 --> 00:03:58,880
.بالمشاركة في مباراتهم في الجولة الثّالثة

43
00:03:58,880 --> 00:04:01,040
.إنّهم فريق يستحقّ المشاهدة أيضًا

44
00:04:01,040 --> 00:04:02,420
!نحن فريق يستحقّ المشاهدة

45
00:04:02,420 --> 00:04:04,550
.من الجيّد سماع هذا

46
00:04:04,800 --> 00:04:06,420
.هذه هي مباريات اليوم الأخرى

47
00:04:06,420 --> 00:04:09,050
.ثانويّة إتشيداي الثّالثة في ملعب هاتشيوجي

48
00:04:09,390 --> 00:04:11,800
.سيكو في ملعب أكيشيما

49
00:04:11,800 --> 00:04:14,180
.ياكوشي في ملعب تاتشيكاوا

50
00:04:14,810 --> 00:04:17,310
.تأهّلوا جميعًا للجولة التّالية

51
00:04:20,190 --> 00:04:23,070
!أجل، حان دورنا الآن

52
00:04:23,070 --> 00:04:24,940
!لنبدأ العمل

53
00:04:25,570 --> 00:04:30,110
سنكون في الملعب عند السّابعة
.وسنبدأ بالتّسخينات

54
00:04:30,110 --> 00:04:32,700
.ارتاحوا لتكونوا جاهزين

55
00:04:32,700 --> 00:04:33,950
!حاضر

56
00:04:34,990 --> 00:04:35,910
!أجل

57
00:04:36,450 --> 00:04:37,620
.ساوامورا

58
00:04:38,160 --> 00:04:41,210
.خذ وقتك في الحمّام لتسترخي

59
00:04:41,420 --> 00:04:43,840
سيساعدك بعض الحليب السّاخن
.قبل النّوم أيضًا

60
00:04:43,840 --> 00:04:46,050
.لا تشرب الكثير من المشروبات الباردة

61
00:04:46,050 --> 00:04:47,720
هل تحتاج لتدليك؟

62
00:04:47,720 --> 00:04:49,720
.جرّب تمديد عضلاتك أيضًا

63
00:04:50,550 --> 00:04:53,010
أتريد استعارة قناع العينين خاصّتي؟

64
00:04:53,010 --> 00:04:55,180
!كم تملك منها؟

65
00:04:55,180 --> 00:04:56,970
!وهذا مضحك أيضًا

66
00:04:58,480 --> 00:05:02,360
.سُحقًا، الجميع قلقون بشأني

67
00:05:02,360 --> 00:05:04,440
ألا يُعتمد عليّ لتلك الدّرجة؟

68
00:05:05,360 --> 00:05:07,990
أخبرني يا أسادا، أهو في المكان الصّحيح؟

69
00:05:07,990 --> 00:05:09,240
.يبدو مثاليًّا

70
00:05:09,240 --> 00:05:11,740
هل ستنام مرتديًا إيّاه ثانية؟

71
00:05:11,740 --> 00:05:13,740
!لا مفرّ من ذلك

72
00:05:13,740 --> 00:05:17,250
.ما زلت أرتدي الرّقم فحسب

73
00:05:17,250 --> 00:05:21,040
.عليّ أن أعوّد جسدي عليه بأسرع وقت

74
00:05:21,500 --> 00:05:23,710
!لم ترمي في مباراة واحدة بعد

75
00:05:23,710 --> 00:05:26,250
!وكيف يبدو ليس مهمًّا أيّها الغبيّ

76
00:05:26,250 --> 00:05:29,260
!أعتقد أنّه سيتسرّب من جسدي مع الوقت

77
00:05:29,550 --> 00:05:31,590
...لهذا السّبب

78
00:05:31,590 --> 00:05:34,510
.لم يكن يرتديه لأنّه سعيد فقط

79
00:05:34,510 --> 00:05:36,810
لا شيء يتسرّب من جسدك
.سوى الغباء الآن

80
00:05:36,810 --> 00:05:39,270
!حسنًا، سأخلد للنّوم الآن

81
00:05:43,480 --> 00:05:45,690
أيمكنك فعلاً النّوم به؟

82
00:05:45,690 --> 00:05:47,860
.أسادا، سأطفئ الأنوار

83
00:05:47,860 --> 00:05:50,400
.صحيح. بالطّبع يمكنك

84
00:05:56,950 --> 00:05:59,160
،بما أنّني بصدد ذلك
.دعني أخبرك بأمر آخر

85
00:05:59,790 --> 00:06:01,830
،قبل بعضة أشهر مضت

86
00:06:01,830 --> 00:06:07,420
ما كنتُ أبدًا لأتخيّلك ترتدي رقم
.اللاّعب الأوّل هذا الصّيف

87
00:06:07,920 --> 00:06:11,170
يا للقائد. أذلك شيء تقوله ببساطة هكذا؟

88
00:06:11,170 --> 00:06:12,050
...لكن

89
00:06:12,930 --> 00:06:16,800
.إنّكم تتجاوزون توقّعاتي دائمًا

90
00:06:17,100 --> 00:06:21,600
لم تستطيع التّحكّم في رمياتك
،بسرعة كبيرة خلال منافسات المدعوّين

91
00:06:21,600 --> 00:06:25,900
لكنّ رمياتك بدأت تبدو أكثر
.فأكثر كما تبدو في التّدريبات

92
00:06:25,900 --> 00:06:29,320
.إضافة لذلك، أنت تتحكّم بالأرقام بشكل أفضل

93
00:06:29,900 --> 00:06:33,700
إن أمكنك الرّمي كما فعلت

94
00:06:33,700 --> 00:06:36,450
...ضدّ إيتشيداي الثّالثة وياكوشي وإيناشيرو

95
00:06:37,200 --> 00:06:39,870
.أشعر بالحماس بمجرّد التّفكير في ذلك

96
00:06:48,170 --> 00:06:50,800
!قال القائد أنّه متحمّس

97
00:06:56,390 --> 00:07:00,260
!نعم! سأرمي بطريقة تحقّق النّصر لفريقنا

98
00:07:01,100 --> 00:07:02,680
.لا تتحمّس كثيرًا

99
00:07:03,100 --> 00:07:07,560
أعتقد أنّ بإمكاني المجيء للملعب
.في نهاية يوليوز أثناء ربع النّهاية

100
00:07:08,690 --> 00:07:13,610
أتطلّع قُدمًا لرؤيتك ترتدي رقم اللاّعب الأوّل؟

101
00:07:20,530 --> 00:07:23,830
...ربع النّهاية

102
00:07:24,540 --> 00:07:27,710
!ربع النّهاية

103
00:07:49,360 --> 00:07:51,860
سُحقًا، ما خطبي؟

104
00:07:51,860 --> 00:07:53,320
.لا يمكنني النّوم

105
00:07:57,360 --> 00:08:00,280
هل يفرز جسدي أدرينالين قبل أوانه؟

106
00:08:02,620 --> 00:08:07,000
بدت منافسات العام الماضي
.قد انتهت قبل حتّى أن تبدأ

107
00:08:09,040 --> 00:08:14,460
كنتُ مركّزًا جدًّا على الفوز
...لدرجة أنّني لم أفكّر

108
00:08:15,840 --> 00:08:17,630
.بما قد يأتي تاليًا

109
00:08:38,200 --> 00:08:41,740
.ساوامورا، من الأفضل تنام جيّدًا

110
00:08:46,620 --> 00:08:48,500
...سنعتمد عليك غدًا

111
00:08:48,790 --> 00:08:50,710
.أيّها اللاّعب الأوّل الجديد

112
00:09:13,020 --> 00:09:16,610
هذا اللاّعب الّذي سيبدؤون به
.هو الّذي تحدّث عنه نابي-سان

113
00:09:16,610 --> 00:09:18,780
.سيكون التّعامل معه صعبًا

114
00:09:21,780 --> 00:09:23,410
!لننطلق

115
00:09:23,410 --> 00:09:24,780
!أجل

116
00:09:29,830 --> 00:09:33,750
هذه تصفيات البطولة الوطنيّة لكرة
.القاعدة للثّانويّات لشرق وغرب طوكيو

117
00:09:33,750 --> 00:09:38,800
سنبدأ اليوم بمباراة ثانويّة سيدو
.ضدّ ثانويّة يورا سوغو للهندسة

118
00:09:39,800 --> 00:09:40,800
!انحناء

119
00:09:40,800 --> 00:09:42,300
!لنلعب

120
00:09:45,850 --> 00:09:49,180
.بدأ صيف سيدو أخيرًا

121
00:09:50,600 --> 00:09:55,560
وسيبدؤون اللّعب بساوامورا-كُن
.مرتديًا رقم لاعبهم الأوّل لأوّل مرّة

122
00:09:56,190 --> 00:10:00,820
أخذ مكان فورويا-كُن كلاعب أوّل
.وحامل الرّقم 1 في الفريق

123
00:10:01,280 --> 00:10:06,740
ستمنحنا هذه المباراة الأولى فكرة
.عن كيفية لعبهم هذا الصّيف

124
00:10:07,950 --> 00:10:11,410
...إنّهم يواجهون المعلّم السّابق لمدرّبهم

125
00:10:17,340 --> 00:10:20,590
.إنّهم مدرّبون جيّدًا

126
00:10:20,880 --> 00:10:25,340
،حسنًا، لا نملك نفس المستوى في الموهبة

127
00:10:25,340 --> 00:10:28,600
.لكن لديّ بعض الخدع في جعبتي

128
00:10:28,930 --> 00:10:30,390
كيف حالك في رأيك؟

129
00:10:30,390 --> 00:10:31,770
.تنجرف رمياتي للأعلى قليلاً

130
00:10:31,770 --> 00:10:32,730
.نعم

131
00:10:33,270 --> 00:10:35,270
،قاموا ببعض التّغييرات في ترتيب ضاربيهم

132
00:10:35,270 --> 00:10:37,690
.لكنّك تعرف كيف يضرب كلّ واحد منهم

133
00:10:38,150 --> 00:10:41,860
لنواصل استعمال الكرات السّريعة
.لزيادة العدّ كما العادة

134
00:10:41,860 --> 00:10:45,110
!حاضر! ذلك ما أجيد فعله

135
00:10:45,450 --> 00:10:48,660
بصراحة، يجعلني ذلك أشعر
.بالأمل والحزن معًا

136
00:10:48,660 --> 00:10:50,620
وهذا يعني أنّك متحمّس، صحيح؟

137
00:10:56,830 --> 00:10:58,960
.كان بإمكاني أن أبدأ في الجانب الأيسر

138
00:11:00,420 --> 00:11:03,800
.اجلس وشاهد فحسب يا فورويا

139
00:11:04,430 --> 00:11:07,550
سأحرص على أن تتمكّن من الرّمي
.في الجولة الرّابع بعد يومين

140
00:11:07,930 --> 00:11:11,390
!قيل لي أنّ الحرارة ستزداد خلال اليوم

141
00:11:11,390 --> 00:11:12,140
!ها قد بدأ

142
00:11:12,140 --> 00:11:15,690
ولكن، لكنّها لن تكون بنفس
!مستوى حرارة فريقنا لآن

143
00:11:15,690 --> 00:11:18,650
!نكرّس أنفسنا بالكامل لكرة القاعدة كلّ يوم

144
00:11:19,060 --> 00:11:21,940
!نحن سيدو، وسيبدأ كلّ شيء اليوم

145
00:11:21,940 --> 00:11:24,110
،ستحلّق الكرات ناحيتكم

146
00:11:24,110 --> 00:11:27,200
!لذلك ادعموني رجاءً

147
00:11:27,200 --> 00:11:29,700
!أجل، يبدو ذلك جيّدًا

148
00:11:29,950 --> 00:11:31,580
!لك ذلك

149
00:11:31,830 --> 00:11:34,080
!إنّك متحمّس أكثر من المعتاد

150
00:11:34,080 --> 00:11:36,960
أراهن أنّك كنتَ تفكّر في ذلك
!الخطاب منذ البارحة

151
00:11:36,960 --> 00:11:38,750
!"أعجبني قوله أنّنا "كرّسنا أنفسنا بالكامل

152
00:11:39,210 --> 00:11:40,750
!لنبدأ اللّعب

153
00:11:41,210 --> 00:11:43,340
.دائمًا ما يفكّر في خطاب

154
00:11:43,710 --> 00:11:46,970
.قال كلّ ذلك رغم كونه متوتّرًا جدًّا

155
00:11:48,470 --> 00:11:49,390
!العبوا

156
00:11:51,010 --> 00:11:55,100
أعتقد أنّه يتسنّى لأفضل الرّامين
.التّحدّث بكلام كبير أيضًا

157
00:11:55,100 --> 00:11:57,600
.كانيمارو، قد يجرّب ضربة مخفّفة

158
00:12:07,360 --> 00:12:09,570
.كرة سريعة خارجيّة

159
00:12:09,570 --> 00:12:12,200
أيمكنك الرّمي كما ترمي عادة؟

160
00:12:20,790 --> 00:12:22,040
.أنا بخير

161
00:12:23,420 --> 00:12:25,670
.أستطيع رؤية قفّاز القائد بوضوح

162
00:12:27,010 --> 00:12:29,390
.بإمكاني سماع المتفرّجين

163
00:12:31,300 --> 00:12:34,220
...سأقدّم كلّ ما لديّ

164
00:12:35,140 --> 00:12:37,100
!لدفع فريقنا نحو النّصر

165
00:12:39,600 --> 00:12:41,020
!هذه هي

166
00:12:43,860 --> 00:12:45,070
!ساوامورا

167
00:12:45,570 --> 00:12:47,740
!ذلك الرّامي سريع

168
00:12:50,160 --> 00:12:52,410
!بالغ في رميها

169
00:12:54,080 --> 00:12:55,910
يستغلّ الضّارب الفرصة للتّقدّم
!للقاعدة الثّانية

170
00:12:59,420 --> 00:13:01,080
!يشعر بالحرج من هذا سلفًا

171
00:13:01,080 --> 00:13:03,290
!ما حدث قد حدث! ركّز في اللّعب

172
00:13:03,710 --> 00:13:06,840
.إنّه يوم مشمس مع الكثير من المتفرّجين

173
00:13:07,510 --> 00:13:11,640
.بالطّبع سيجعله ذلك متحمّسًا أكثر من المعتاد

174
00:13:17,930 --> 00:13:20,690
.إنّه يركض بسرعة

175
00:13:20,940 --> 00:13:24,980
بما أنّه معلّم المدرّب كاتاوكا
،ومؤسّس فريق كرة القاعدة في سيدو

176
00:13:24,980 --> 00:13:27,190
.أتوقّع منه أن يقود بثبات

177
00:13:27,530 --> 00:13:30,700
طلب القيام بضربات مخفّفة مرّات
،عدّة في الجولتين الأولى والثّانية

178
00:13:31,570 --> 00:13:34,700
لكنّ الضّارب لا ينوي القيام
.بضربة مخفّفة الآن

179
00:13:35,030 --> 00:13:37,910
واضح أنّهم سيحاولون الضّرب
.وجعل الرّاكض يتقدّم أكثر

180
00:13:39,710 --> 00:13:44,880
،أودّ أن أخبرك أن تتجاهل الرّاكض
.لكن دعنا نراقبه

181
00:13:49,510 --> 00:13:54,600
.كان هذا متوقّعًا
.أجسامهم في حالة تأهّب بالكامل

182
00:14:01,480 --> 00:14:02,810
!الكرة الثّانية

183
00:14:03,270 --> 00:14:07,480
.حان الوقت لإضعاف تأهّبهم ذاك

184
00:14:08,190 --> 00:14:13,740
،ينوي الضّارب القيام بضربة مخفّفة
.لكنّني لم أرَ المدرّب يشير لذلك

185
00:14:13,740 --> 00:14:15,320
.لستُ واثقًا

186
00:14:15,320 --> 00:14:17,240
.هذه بداية مباراتهم الأولى فحسب

187
00:14:17,240 --> 00:14:20,370
على ثنائيّ الرّامي والماسك
.تسجيل أوّل خروج لهما

188
00:14:21,040 --> 00:14:23,580
.لا تتفاعل مع وضعيّاته

189
00:14:23,580 --> 00:14:25,880
.إن كان يريد القيام بضربة مخفّفة، فدعه

190
00:14:26,500 --> 00:14:27,840
.صحيح

191
00:14:29,170 --> 00:14:30,510
!الكرة الرّابعة

192
00:14:30,880 --> 00:14:31,840
!أجل

193
00:14:31,840 --> 00:14:33,840
!إنّه سير

194
00:14:33,840 --> 00:14:35,640
!لم يقم الضّارب بأيّ شيء

195
00:14:37,810 --> 00:14:38,810
.وقت مستقطع

196
00:14:39,350 --> 00:14:42,730
لا يسمح ساوامورا-كُن بحدوث سير
.بهذه السّهولة في العادة

197
00:14:42,730 --> 00:14:44,810
.نعم، هذا غير عاديّ

198
00:14:44,810 --> 00:14:47,730
لا بدّ أنّ السّبب هو الرّمية المبالغ
.فيها في أوّل لعبة

199
00:14:47,730 --> 00:14:49,900
.ما زالت تشغل باله

200
00:14:52,530 --> 00:14:54,660
ماذا أفعل؟

201
00:14:54,990 --> 00:14:57,950
.لكنّ نتيجة تلك اللّعبة لم تكن مؤكّدة

202
00:14:57,950 --> 00:15:02,120
،إن نجح في الحصول على خروج
.لكان الزّخم في صالحهم

203
00:15:02,500 --> 00:15:06,500
!بدأت المباراة للتّوّ
!حافظ على هدوئك يا ساوامورا

204
00:15:06,500 --> 00:15:09,210
.لا تملك رمياته السّرعة المطلوبة

205
00:15:12,300 --> 00:15:14,420
.اسمع، أمعن النّظر لكوراموتشي

206
00:15:16,550 --> 00:15:18,220
أتريد السماح له بلكمك؟

207
00:15:18,220 --> 00:15:19,260
!لا، لا أريد

208
00:15:19,260 --> 00:15:22,430
كما لم يكن عليك استعمال واحدة
!من فرصنا الثّلاثة للوقت المستقطع

209
00:15:22,810 --> 00:15:25,140
.إذًا لوّح بذراعك بالكامل

210
00:15:25,140 --> 00:15:27,060
.أنت لا ترمي كما ترمي في العادة

211
00:15:27,060 --> 00:15:29,570
!أنا مدرك لذلك

212
00:15:30,940 --> 00:15:33,570
،إن كانت رمياتك كما العادة
،وإن كانت أعلى قليلاً

213
00:15:33,570 --> 00:15:35,780
.فسيصعب عليهم ضربها حينها

214
00:15:35,780 --> 00:15:39,200
.لنتجاوز هذا ونبني زخمًا لصالحنا

215
00:15:39,580 --> 00:15:40,240
!حاضر

216
00:15:40,240 --> 00:15:41,370
.أعتمد عليك

217
00:15:42,410 --> 00:15:44,250
!نحن جاهزون

218
00:15:45,870 --> 00:15:48,250
سُحقًا. ما الّذي يحدث؟

219
00:15:48,790 --> 00:15:53,050
.أشعر بأنّ جسدي أخفّ
.لا أستطيع استجماع أيّ قوّة من ساقيّ

220
00:15:56,470 --> 00:15:59,090
هل أنا في ورطة؟

221
00:16:08,520 --> 00:16:10,020
.هذا هراء

222
00:16:11,570 --> 00:16:13,400
.أنا اللاّعب الأوّل

223
00:16:13,400 --> 00:16:15,900
!عليّ قيادة الفريق

224
00:16:16,450 --> 00:16:19,910
!لا أستطيع أن أتعثّر الآن

225
00:16:22,990 --> 00:16:25,200
ينوي القيام بضربة مخفّفة؟

226
00:16:25,200 --> 00:16:26,620
الضّارب الثّالث؟

227
00:16:27,830 --> 00:16:29,710
أهو جادّ؟

228
00:16:31,080 --> 00:16:32,130
!ميوكي

229
00:16:33,750 --> 00:16:36,050
.إن كان سيقوم بضربة مخفّفة، فدعه

230
00:16:36,510 --> 00:16:39,220
.ابق مركّزًا على الضّارب

231
00:16:40,640 --> 00:16:43,260
.صحيح، ما زلنا في الأشواط الأولى

232
00:16:43,260 --> 00:16:45,390
.بإمكاننا اللّهب بالطّريقة الّتي نريد

233
00:16:45,770 --> 00:16:47,770
.إنّهم يستعدّون للهجوم

234
00:16:47,770 --> 00:16:50,060
.سأهتمّ بالرّاكضين

235
00:16:50,480 --> 00:16:52,520
.فلتكن رمية سريعة، مباشرة هنا

236
00:16:52,940 --> 00:16:55,480
.قويّة بما يكفي لإسقاط المضرب من يديه

237
00:17:00,110 --> 00:17:02,200
عندما نوى ضاربو سيهو القيام
،بضربات مخفّفة

238
00:17:02,200 --> 00:17:05,120
لم يواجه أيّ مشكلة في الرّمي
.خلالها للحصول على إصابة

239
00:17:05,830 --> 00:17:09,330
لكن نجح الضّارب الأوّل اليوم
.في ضرب رميته بسهولة

240
00:17:10,210 --> 00:17:12,670
.ساوامورا-سينباي ليس على طبيعته المعتادة

241
00:17:14,420 --> 00:17:16,590
،إن كنتَ ستقوم بضربة مخفّفة
!فقم بذلك

242
00:17:19,420 --> 00:17:21,510
!سنحصل على الخروج في القاعدة الثّالثة

243
00:17:26,310 --> 00:17:27,850
!ضربة ناجحة

244
00:17:30,310 --> 00:17:32,270
،كانت الضّربة محشورة
!لكنّها ذهبت لخطّ الملعب الأيسر

245
00:17:32,270 --> 00:17:34,270
!يصل لاعب القاعدة الثّانية للثّالثة

246
00:17:34,820 --> 00:17:36,110
!ويسجّل نقطة

247
00:17:36,110 --> 00:17:37,780
!يورا سوغو في الطّليعة

248
00:17:37,780 --> 00:17:40,530
يحرز الضّارب الثّالث جوجو نقطة
!في الوقت المناسب

249
00:17:40,950 --> 00:17:44,530
قدّم الرّامي الأوّل ساوامورا
!إيجون نقطة لخصمه

250
00:17:50,540 --> 00:17:52,330
.يبعثون رسولاً من الدّكّة

251
00:17:52,330 --> 00:17:54,920
.لم يسجّل خروجًا وحدًا بعد

252
00:17:54,920 --> 00:17:56,960
.والرّسول هو فورويا

253
00:17:56,960 --> 00:17:58,300
.يا له من شرف

254
00:17:58,300 --> 00:18:00,800
...أوقاتنا المستقطعة النّفيسة

255
00:18:01,380 --> 00:18:02,510
أتريد أن نتبادل؟

256
00:18:03,800 --> 00:18:05,470
!مـ-مـ-مستحيل

257
00:18:05,470 --> 00:18:07,680
!لم حتّى تقم بالإحماء

258
00:18:07,680 --> 00:18:08,680
.سأذهب لأفعل ذلك الآن

259
00:18:08,680 --> 00:18:09,930
!اخرس

260
00:18:10,230 --> 00:18:11,980
هل أخبرك المدرّب بقول ذلك؟

261
00:18:12,600 --> 00:18:15,060
.أخبرني أن أذهب لتلّة الرّمي وأشعلها

262
00:18:15,060 --> 00:18:16,570
!يا زعيم

263
00:18:17,650 --> 00:18:18,900
.فهمت

264
00:18:19,400 --> 00:18:25,070
سيقلّل إرسال فورويا إلى هنا
.من توتّره أكثر من أيّ كلمات

265
00:18:25,570 --> 00:18:28,120
وأيضًا، على اللاّعبين الميدانيّين
،الدّاخليّين حماية الفجوات

266
00:18:28,120 --> 00:18:29,950
وعلى اللاّعبين الخارجيّين التّجهّز
.لضربات طويلة

267
00:18:31,000 --> 00:18:33,960
يريدكم أن تركّزوا على إخراج
.الضّارب الرّابع

268
00:18:38,670 --> 00:18:43,220
أي إن سجّل الرّاكض الّذي في القاعدة
.الثّالثة، فليس بوسعنا شيء

269
00:18:43,510 --> 00:18:45,970
.حسنًا، لدينا كاواكامي في منطقة الإحماء

270
00:18:45,970 --> 00:18:47,300
.بإمكانه أن يتبادل معك

271
00:18:49,600 --> 00:18:51,180
.لا تقلق

272
00:18:51,180 --> 00:18:54,900
لا يهمّ كم عدد النّقاط الّتي
.سيحرزونها، فسنحرز أكثر

273
00:18:54,900 --> 00:18:56,520
هل الأمر بذلك السّوء؟

274
00:18:56,520 --> 00:18:57,690
!هذا صحيح

275
00:18:57,690 --> 00:18:59,020
!لنقم بما في وسعنا

276
00:18:59,020 --> 00:19:00,780
!فليضربوا بعض الكرات ناحيتي

277
00:19:01,400 --> 00:19:02,360
.إيجون

278
00:19:03,400 --> 00:19:05,240
.سأقوم بالإحماء من باب الاحتياط

279
00:19:05,910 --> 00:19:08,280
!غادر! ابتعد عن تلّتي

280
00:19:08,280 --> 00:19:09,660
!اذهب للنّوم على الدّكّة

281
00:19:09,660 --> 00:19:12,200
!لن ترمي اليوم

282
00:19:12,200 --> 00:19:13,080
إيجون؟

283
00:19:13,080 --> 00:19:14,330
هل ناداه بإيجون؟

284
00:19:14,330 --> 00:19:15,920
.استعمل فورويا الاسم الشّخصيّ لأحد ما

285
00:19:16,630 --> 00:19:18,880
!لا تعبر ذلك الخطّ ثانية أبدًا

286
00:19:18,880 --> 00:19:20,000
.أنا جاهز في أيّ وقت

287
00:19:20,000 --> 00:19:20,800
!اخرس

288
00:19:20,380 --> 00:19:21,880
...يا لهما من

289
00:19:20,800 --> 00:19:21,880
!أخبرتك أن تغادر

290
00:19:22,340 --> 00:19:25,930
حسنًا، على الأقلّ يتصرّف
.ساوامورا على طبيعته قليلاً

291
00:19:28,180 --> 00:19:31,680
لدى ضاربهم الرّابع الكثير
،من الضّربات المسجّلة

292
00:19:32,060 --> 00:19:37,650
لكن قد يحاولون مناورة اللّعب المضغوط
.أو السّرقة المزدوجة أو الرّكض والضّرب

293
00:19:39,150 --> 00:19:41,150
أعتقد أنّ علينا الاستعداد
.للأمر والتّعامل معه

294
00:19:47,320 --> 00:19:50,370
.في الخارج، في منطقة خطيرة

295
00:19:50,370 --> 00:19:53,500
.لا أهتمّ إن لم تصب المنطقة
!لوّح بذراعك بالكامل فحسب

296
00:19:55,750 --> 00:19:57,330
.هذا صحيح

297
00:19:58,580 --> 00:20:00,090
.الجميع يدعمونني

298
00:20:01,710 --> 00:20:04,130
...عليّ أنّ أركّز على القفّاز فحسب

299
00:20:07,340 --> 00:20:09,090
!إصابة

300
00:20:09,680 --> 00:20:12,510
كلّ ما عليّ فعله هو التّركيز
!على قفّاز الماسك

301
00:20:13,100 --> 00:20:14,220
!جيّد

302
00:20:14,720 --> 00:20:16,600
!هذه إصابتنا الأولى

303
00:20:16,600 --> 00:20:19,190
!كان إرسال فورويا القرار الصّائب أيّها المدرّب

304
00:20:19,730 --> 00:20:22,230
!نعم، نعم، نعم! نعم

305
00:20:22,980 --> 00:20:25,280
،في هذا الوضع، لا يهمّ كيف

306
00:20:25,740 --> 00:20:28,780
.نريد خروجًا بشدّة

307
00:20:31,030 --> 00:20:32,080
!كرة

308
00:20:32,450 --> 00:20:36,830
بإمكان تجاهل الكرات المتبدّلة
.والمتغيّرة والقاطعة

309
00:20:36,830 --> 00:20:39,040
.انتظر تلك الرّمية

310
00:20:39,790 --> 00:20:45,050
على الأرجح أنّ ثنائيّ الرّامي والماسك
.قد خاض أزمات عدّة

311
00:20:45,550 --> 00:20:47,590
،كلّما زادت المشاكل الّتي واجهاها

312
00:20:47,590 --> 00:20:52,050
زاد احتمال لجوئهما للرّمية
.الّتي يرتاحان لها أكثر

313
00:20:53,470 --> 00:20:55,850
.الكرات السّريعة الدّاخليّة

314
00:20:55,850 --> 00:21:02,150
،إن أمكنك ضرب تلك الرّمية
.فبإمكانك سحقهم ها هنا والآن

315
00:21:15,240 --> 00:21:15,990
!هارويتشي

316
00:21:17,370 --> 00:21:19,370
!خروج قصريّ ف القاعدة الثّانية

317
00:21:19,370 --> 00:21:22,130
لاعب القاعدة الثّانية كوميناتو
!قام بلعبة ممتازة

318
00:21:23,040 --> 00:21:27,590
لكنّ راكض القاعدة الثّالثة وصل للقاعدة
.الرّئيسيّة، مانحًا نقطة ثانية لسورا سوغو

319
00:21:27,590 --> 00:21:30,590
!إيجون-كُن، حصلنا على خروجنا الأوّل

320
00:21:30,590 --> 00:21:34,100
!هارويتشي-سينباي، أنت مدهش بالفعل

321
00:21:34,100 --> 00:21:36,640
ما هذه السّخافة؟ أما زلت
ستصاب بانهيار عصبيّ؟

322
00:21:36,930 --> 00:21:40,640
أحسنوا عملاً بالحصول على خروج
.رغم إحراز خصمهم لنقطة ثانية

323
00:21:40,640 --> 00:21:44,400
نعم، ساعدهم كثيرًا أنّ الخروج
.كان من القاعدة الثّانية

324
00:21:44,770 --> 00:21:47,650
أصبح ليدهم خروج واحد
.وراكض في القاعدة الأولى

325
00:21:47,650 --> 00:21:50,030
ربّما سيساعد ذلك على تهدئة ساوامورا-كُن؟

326
00:21:50,610 --> 00:21:52,160
.لست سيّئًا

327
00:21:52,160 --> 00:21:53,910
!لكنّه نجح في ضربها

328
00:21:55,200 --> 00:21:57,040
،بالتّفكير في الأمر

329
00:21:57,490 --> 00:22:00,250
.يبدو أنّ الضّارب كان ينتظر تلك الرّمية

330
00:22:01,790 --> 00:22:06,460
.لا يجب الاستخفاف بيورا سوغو بالفعل

331
00:22:13,010 --> 00:22:14,260
".تحت القدمين"

332
00:23:45,140 --> 00:23:47,440
.أنت ترمي عن قرب بكلّ قوّتك

333
00:23:47,440 --> 00:23:49,020
!لننهِ أمرهم

334
00:23:49,020 --> 00:23:50,520
.اسمع يا تيشّين

335
00:23:50,520 --> 00:23:55,400
.أنا أستمتع فعلاً بهذه المباراة ضدّ فريقك

336
00:23:55,400 --> 00:23:57,160
رمية لا يمكنهم ضربها حتّى
.إن عرفوا أنّها قادمة

337
00:23:57,160 --> 00:24:01,830
،إن حصلنا على زخم من جهتنا
.بإمكاننا قلب الموازين لصالحنا

338
00:24:01,830 --> 00:24:03,830
،لمعلوماتك يا تيشّين

339
00:24:03,830 --> 00:24:08,080
،إن كنتَ تنظر لفوق فحسب
.فستتعثّر لا محالة

340
00:24:08,080 --> 00:24:10,880
في الحلقة القادمة من
:اللاّعب الماسيّ الأوّل"، الفصل الثّاني"

341
00:24:10,880 --> 00:24:12,090
".رجوع"

342
00:24:12,090 --> 00:24:14,630
!لنفز باللّقب الوطنيّ