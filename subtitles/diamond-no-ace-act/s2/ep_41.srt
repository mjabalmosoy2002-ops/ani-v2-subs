1
00:00:00,800 --> 00:00:02,180
!خروج

2
00:00:02,350 --> 00:00:05,390
!أسو-سينباي، رمية إعادة كرة ممتازة

3
00:00:06,020 --> 00:00:09,440
.يعرف الجميع مدى جدّيّة ساوامورا حيال هذا

4
00:00:09,440 --> 00:00:10,690
...لهذا السّبب

5
00:00:10,690 --> 00:00:12,150
...نحن لاعبو السّنة الثّالثة

6
00:00:12,150 --> 00:00:14,280
!علينا أن ندعمه

7
00:00:15,400 --> 00:00:16,650
.مذهل

8
00:00:16,650 --> 00:00:20,700
هؤلاء هم الأشخاص الّذين
.لدى هذا الفريق كاحتياطيّ

9
00:02:02,380 --> 00:02:04,840
!أصابت أعلى السّياج

10
00:02:04,840 --> 00:02:08,390
!كسرت تلك الضّربة القويّة حالة الرّكود

11
00:02:08,390 --> 00:02:10,350
!وقد ضربها من أكاشي

12
00:02:19,780 --> 00:02:22,450
...نعم، فهمت

13
00:02:23,110 --> 00:02:25,740
!مهلاً، مهلاً، مهلاً
!لماذا أنتم جالسون جميعًا؟

14
00:02:25,740 --> 00:02:27,120
!كانت تلك دورة كاملة

15
00:02:27,120 --> 00:02:28,120
!احتللنا الصّدارة للتّوّ

16
00:02:28,120 --> 00:02:30,580
!سجّل لاعب سنة أولى نقطة للفريق

17
00:02:30,580 --> 00:02:32,500
!أقلّ ما يمكنكم فعله هو الابتسام

18
00:02:32,500 --> 00:02:35,000
!هيّا قفا يا هارويتشي ويا كانيمارو

19
00:02:35,000 --> 00:02:36,880
!ما خطبكم جميعًا؟

20
00:02:36,880 --> 00:02:39,550
!منذ متى أصبح الفريق بهذه القسوة؟

21
00:02:40,000 --> 00:02:42,340
.إيجو-كُن، إلى هناك

22
00:02:42,340 --> 00:02:44,760
!ألم تكن منتبهًا؟

23
00:02:44,760 --> 00:02:48,010
!سُحقًا، أفسد ساوامورا الأمر

24
00:02:48,010 --> 00:02:49,260
!ضربة رائعة

25
00:02:49,260 --> 00:02:50,930
!دورة كلمة ممتازة يا يوكي

26
00:02:50,930 --> 00:02:52,520
!أتظنّ أنّك رميتها بعيدة بما يكفي؟

27
00:02:53,730 --> 00:02:58,230
التّعامل بالصّمت؟ لماذا؟

28
00:02:58,230 --> 00:03:02,190
من كان يفترض أن يُعلم ساوامورا؟
!لم يصله الخبر على الإطلاق

29
00:03:02,190 --> 00:03:04,990
!لننهِ الأمر الآن بكلّ ما لدينا

30
00:03:04,990 --> 00:03:06,280
!أجل

31
00:03:07,030 --> 00:03:08,740
!أرنا ما لديك يا ياماغوتشي

32
00:03:08,740 --> 00:03:10,620
!فخر لاعبي السّنة الثّالثة

33
00:03:10,620 --> 00:03:14,040
.ذلك الشّخص مميّز بالفعل

34
00:03:15,290 --> 00:03:16,210
.بلا مزاح

35
00:03:17,580 --> 00:03:20,210
لكن لا أستطيع السّماح له
!بأخذ كلّ المجد وحده

36
00:03:26,430 --> 00:03:29,510
.آسف، كان عليّ إيقاف تلك النّقطة الأخيرة

37
00:03:30,050 --> 00:03:33,850
السّماح للاعب سنة أولى ليقوم
.بضربة ناجحة له عواقب كثيرة

38
00:03:33,850 --> 00:03:37,440
.أشعر وكأنّني ضُربت بخذوف مرتدّ

39
00:03:37,940 --> 00:03:40,860
.لن أشعر بتحسّن إلى أن نسجّل تلك النّقاط

40
00:03:41,730 --> 00:03:43,190
!أجل

41
00:03:46,360 --> 00:03:47,820
!ساوامورا-سينباي

42
00:03:54,660 --> 00:03:57,830
.لننتقل لرميات الأرقام في هذا الشّوط

43
00:04:04,460 --> 00:04:07,930
أضعتُ فرضتي ولم أحقّق
.ضربة ناجحة في هذه اللّعبة

44
00:04:07,930 --> 00:04:10,300
.لم أقدّم أيّة مساعدة للفريق كضارب

45
00:04:10,850 --> 00:04:12,560
...فعلى الأقلّ في الدّفاع

46
00:04:13,260 --> 00:04:15,980
.سأمسك بأيّ رمية ترميها

47
00:04:19,150 --> 00:04:24,070
أنت واثق كعادتك وبما يكفي
.لتقول لزميل أكبر أن يغادر

48
00:04:26,690 --> 00:04:29,240
تريد مناقشة ذلك الآن فعلاً؟

49
00:04:30,490 --> 00:04:32,580
!هذا إطراء في الحقيقة

50
00:04:33,080 --> 00:04:37,710
،فاجأني ذلك وحمّسني كثيرًا
.وجعلني متأهّبًا

51
00:04:40,210 --> 00:04:42,130
.بقيت ثلاثة أشواط

52
00:04:43,460 --> 00:04:46,210
.نحن معًا في هذا يا شريك

53
00:04:51,510 --> 00:04:53,510
شريك؟

54
00:04:53,890 --> 00:04:54,640
.نعم

55
00:04:57,890 --> 00:05:00,020
من هذا الشّخص؟

56
00:05:01,850 --> 00:05:05,320
حسنًا، أمسك بالفوندوشي
!خاصّتك كي لا يقع

57
00:05:06,230 --> 00:05:07,650
ما هذا؟

58
00:05:09,650 --> 00:05:11,610
.أنا لا أرتدي الفوندوشي

59
00:05:12,620 --> 00:05:14,330
!ولا أنا في الحقيقة

60
00:05:14,620 --> 00:05:16,700
!فلتكن إذًا سراويل الانزلاق القصيرة

61
00:05:16,700 --> 00:05:18,580
.لا داعي لتغيّر جملتك

62
00:05:18,580 --> 00:05:20,830
!هكذا إذًا، لا تردّ عليّ إذًا

63
00:05:21,790 --> 00:05:24,710
...إنّني أنجذب إلى وتيرته

64
00:05:26,170 --> 00:05:27,460
.سُحقًا

65
00:05:28,010 --> 00:05:30,130
!سأساعده بطريقة ما

66
00:05:47,150 --> 00:05:49,320
.قُد الفريق

67
00:05:50,860 --> 00:05:55,160
حتّى إن كان ذلك لتحفيظ
،عقلي البسيط فحسب

68
00:05:56,620 --> 00:05:57,910
.فقد أسعدني كثيرًا

69
00:06:00,580 --> 00:06:04,210
.أريد النّجاح، من أجل هذا الفريق

70
00:06:07,630 --> 00:06:11,840
!أريد أن أنجح اليوم

71
00:06:22,480 --> 00:06:23,770
!أجل

72
00:06:23,770 --> 00:06:25,560
!أخرجتَ الضّارب الأوّل

73
00:06:25,560 --> 00:06:27,320
!رمية ممتازة يا ساوامورا

74
00:06:27,320 --> 00:06:28,570
!خروج واحد

75
00:06:35,360 --> 00:06:36,660
!الكرة الثّانية

76
00:06:37,070 --> 00:06:38,870
.إنّه يرمي كرات قليلة

77
00:06:38,870 --> 00:06:41,870
كان يواجه مشاكل في السّيطرة
،على الكرة في آخر شوط

78
00:06:41,870 --> 00:06:44,290
.لكنّ الوضع يبدو أسوأ في هذا الشّوط

79
00:06:45,210 --> 00:06:49,960
رمية مرتدّة أخرى. لم يحدث
...ذلك في آخر شوط

80
00:06:49,960 --> 00:06:52,590
.يغيّر ثنائيّ الرّامي والماسك رمياتهما

81
00:06:54,470 --> 00:06:55,970
.تلك إشارة الانتظار

82
00:06:59,850 --> 00:07:00,970
.الكرة الرّابعة

83
00:07:02,220 --> 00:07:03,230
!أجل

84
00:07:03,230 --> 00:07:05,230
!قليلاً بعد

85
00:07:07,440 --> 00:07:12,740
رمياته ليست سيّئة، لكنّ الأرقام
.لا تصيب منطقة الإصابة

86
00:07:12,740 --> 00:07:16,990
إن واصل الرّمي كما فعل في
...النّصف الأوّل، لكنتُ استسلمت

87
00:07:16,990 --> 00:07:20,030
لكنّ الرّامي لم يبدُ في أحسن
.حال منذ الشّوط الأخير

88
00:07:22,160 --> 00:07:25,370
.لنجعل هجومنا بطيئًا وثابتًا

89
00:07:25,830 --> 00:07:29,670
.ينتظر هذا الفريق كرة في منطقة الإصابة

90
00:07:29,670 --> 00:07:32,760
،نحن في نهاية التّرتيب
.لكن علينا أن نبقى متأهّبين

91
00:07:39,890 --> 00:07:41,100
!كرة

92
00:07:41,100 --> 00:07:43,890
.رمى واحدًا وتسعين رمية فقط

93
00:07:43,890 --> 00:07:46,600
.لا يجب أن يكون متعبًا بهذه الدّرجة

94
00:07:50,730 --> 00:07:52,690
.سُحقًا، أنا أواصل الإخفاق

95
00:07:52,690 --> 00:07:54,320
.لا أستطيع التّحكّم بنفسي

96
00:07:54,610 --> 00:07:57,280
هل يضغط على نفسه؟ أم هو متعب؟

97
00:07:57,780 --> 00:08:00,990
لم أعتقد أنّ تحكّمه بالكرة
...قد تداعى لهذه الدّرجة

98
00:08:01,530 --> 00:08:05,960
يبدأ ساوامورا-سينباي بالإصابات
.في العادة ليخلق إيقاعه

99
00:08:06,500 --> 00:08:09,420
.لا يمكننا أن نواصل هكذا

100
00:08:10,040 --> 00:08:13,130
.لنستعمل كرة سريعة لنعود للّعب

101
00:08:14,760 --> 00:08:17,260
.يسعون لتحقيق أصابة الآن

102
00:08:17,260 --> 00:08:19,760
،أعطاني الإشارة لأنتظر

103
00:08:20,970 --> 00:08:22,600
لكن ما زال بإمكاني التّلويح، صحيح؟

104
00:08:23,350 --> 00:08:25,020
!ذهب إلى خطّ يمين الملعب

105
00:08:26,020 --> 00:08:28,270
!أجل! وصل الرّاكض للقاعدة الثّالثة

106
00:08:28,270 --> 00:08:30,190
هنالك راكضان على القاعدتين الأولى
!والثّالثة، وواحد قد خرج

107
00:08:30,190 --> 00:08:31,860
!سيهو تهاجم

108
00:08:31,860 --> 00:08:33,270
!أجل

109
00:08:33,270 --> 00:08:37,490
.قرار حكيم. فكّر في ذلك وحده

110
00:08:39,360 --> 00:08:42,320
لاعب القاعدة الثّانية ولاعب الارتكاز
!يتحرّكان لتحقيق لعبة مزدوجة

111
00:08:43,330 --> 00:08:45,080
.إنّه الضّارب التّاسع

112
00:08:45,080 --> 00:08:46,870
.إنّه يخنق المضرب

113
00:08:48,750 --> 00:08:50,790
.قد يحاول القيام بمناورة عصر

114
00:08:57,970 --> 00:08:59,180
!كرة

115
00:08:59,380 --> 00:09:01,510
.إنّهم يغيّرون طريقة اللّعب

116
00:09:01,510 --> 00:09:04,890
يحاولون تغيير الوضع
.لصالحهم إن أمكنهم ذلك

117
00:09:04,890 --> 00:09:07,770
.علينا أن نكون حذرين

118
00:09:09,520 --> 00:09:10,690
!سرقة

119
00:09:12,520 --> 00:09:14,150
!إنّه يتحرّك سلفًا؟

120
00:09:16,030 --> 00:09:17,900
!ضربة ناجحة

121
00:09:18,610 --> 00:09:21,160
فوق لاعب القاعدة الثّانية وبين
!لاعبَيْ اليمين والوسط الدّاخليّين

122
00:09:21,160 --> 00:09:23,160
!ويسجّل راكض القاعدة الثّالثة

123
00:09:23,160 --> 00:09:25,660
!يتقدّم راكض القاعدة الأولى إلى الثّالثة

124
00:09:26,080 --> 00:09:27,080
!أجل

125
00:09:27,080 --> 00:09:28,160
!هذه نقطة واحدة

126
00:09:28,580 --> 00:09:30,580
نجح جميع الضّاربين الثّلاثة في أسفل
.التّرتيب في ضرباتهم

127
00:09:30,580 --> 00:09:33,380
.أرادوا تخفيف الضّغط عن أكاشي

128
00:09:33,380 --> 00:09:35,540
.أحداث هذا الشّوط جنونيّة

129
00:09:35,920 --> 00:09:38,380
.عدنا لبداية ترتيب الضّرب الآن

130
00:09:38,380 --> 00:09:42,090
سيسجّل كلا الفريقين نقاطًا
.مع استمرار المباراة

131
00:09:42,090 --> 00:09:44,850
إنّه وقت حاسم لثنائيّ الرّامي
.والماسك لسيدو

132
00:09:51,230 --> 00:09:53,270
.إنّنا نخسر الزّخم

133
00:09:53,270 --> 00:09:55,770
إنّهما غير قادران على مجاراة
،العدّ مع الأرقام

134
00:09:55,770 --> 00:09:58,730
.ممّا يجعل الكرات السّريعة أسهل للضّرب

135
00:09:59,860 --> 00:10:02,360
.هنا تصبح قراءة الأرقام صعبة

136
00:10:02,910 --> 00:10:07,540
،إن لم يستطع التّحكّم بالكرات السّريعة
.يصعب التّحكّم بالأرقام أيضًا

137
00:10:08,120 --> 00:10:11,000
بوجود القرار بين يديِ
،الماسك من السّنة الأولى

138
00:10:11,000 --> 00:10:13,460
قدّم كلّ ما لديه من البداية
.وواصل بكلّ قوّته حتّى هذا الشّوط

139
00:10:13,460 --> 00:10:16,090
غدت نجاحاته في النّصف
.الأوّل إخفاقات الآن

140
00:10:16,500 --> 00:10:17,590
!أجل

141
00:10:20,340 --> 00:10:23,880
.سيكون من الصّعب اتّخاذ القرارات الآن

142
00:10:26,640 --> 00:10:27,850
!يوي

143
00:10:29,060 --> 00:10:30,390
!لننطلق

144
00:10:42,900 --> 00:10:45,910
.آسف. أسحب ملاحظاتي السّابقة

145
00:10:46,450 --> 00:10:52,750
لنتوقّف عن رمي الأرقام العشوائيّة
.ونركّز باقي قوّتك على الكرات السّريعة

146
00:10:54,500 --> 00:10:56,540
.إن متّ أنت، نموت جميعًا

147
00:10:59,960 --> 00:11:01,210
.لا بأس

148
00:11:02,550 --> 00:11:04,550
.لن أدعك تموت وحدك

149
00:11:06,930 --> 00:11:08,970
.إن متّ أنت، نموت جميعًا

150
00:11:11,970 --> 00:11:13,310
.لا بأس

151
00:11:14,350 --> 00:11:16,350
.لن أدعك تموت وحدك

152
00:11:17,520 --> 00:11:19,480
كم هنالك من أرقام؟

153
00:11:19,480 --> 00:11:23,070
.حسنًا، ثمّة الكثير منها لا يستطيع أن يرمها

154
00:11:23,570 --> 00:11:26,860
ثمّة أرقام تغيّر دوران الكرة
.أو زاوية المعصم

155
00:11:27,530 --> 00:11:29,830
،وبعضها رميات قذرة ببساطة

156
00:11:29,830 --> 00:11:33,040
لكنّ ساوامورا لا يستطيع
.التّحكّم بها فحسب

157
00:11:33,040 --> 00:11:38,130
لهذا أجعله يستعمل الرّميات حيث يكون
.معصمه عموديًّا فقط كالكرات السّريعة

158
00:11:38,420 --> 00:11:41,880
لقد عمل على الرّميات السّريعة
.والحادّة في موسم التّوقّف

159
00:11:41,880 --> 00:11:46,630
أعتقد أنّ كرات ساوامورا السّريعة
.هي أفضل ميزاته الآن

160
00:11:56,600 --> 00:11:58,940
.كرة سريعة داخليّة

161
00:12:02,520 --> 00:12:08,450
حسنًا، بما أنّني لا أستطيع التّسديد لمنطقة
.الإصابات، لا يمكنك تقرير أيّ رقم

162
00:12:09,450 --> 00:12:12,450
،لكن حتّى في هذه الورطة
.تتصرّف بجرأة

163
00:12:13,950 --> 00:12:16,830
!أنا معتاد على قرارات كهذه

164
00:12:20,460 --> 00:12:22,290
.سيرمي كرة سريعة

165
00:12:22,290 --> 00:12:24,340
!إن ارتفعت، اضربها

166
00:12:24,550 --> 00:12:28,680
إمّا كرة أرضيّة داخليّة أو كرة
.طائرة خارجيّة ستحقّق لنا نقطة

167
00:12:29,260 --> 00:12:31,600
.سنحقّق التّعادل بأيّ ضربة

168
00:12:32,050 --> 00:12:33,850
.بقيت ثلاثة أشواط

169
00:12:34,930 --> 00:12:36,770
.لا تكن خجولاً

170
00:12:37,810 --> 00:12:39,600
!العب بعدائيّة

171
00:12:41,900 --> 00:12:46,320
،حتّى إن تمكّنوا من مجاراتنا
!فسنتعادل في كلّ الأحوال

172
00:12:49,360 --> 00:12:51,160
.أجل، إنّها قادمة مباشرة

173
00:13:01,170 --> 00:13:02,330
!لقد خرج

174
00:13:02,330 --> 00:13:04,340
!لم يستطع لاعب القاعدة الثّالثة التّحرّك

175
00:13:04,840 --> 00:13:08,090
قفزت الكرة عندما كانت قريبة
.من مضربي، رغم طريقة رميه

176
00:13:08,090 --> 00:13:09,970
!أصبحا خروجان الآن

177
00:13:09,970 --> 00:13:11,300
!رمية ممتازة يا ساوامورا

178
00:13:11,300 --> 00:13:12,470
!أحسنت

179
00:13:12,470 --> 00:13:14,100
!واصل التّقدّم

180
00:13:17,930 --> 00:13:19,640
.إنّهما خروجان فقط

181
00:13:19,640 --> 00:13:22,480
.افقد تركيزك وسينتهي أمرنا
.لا تنس ذلك

182
00:13:23,520 --> 00:13:26,440
!نعم، أعلم ذلك

183
00:13:27,280 --> 00:13:31,700
.مذهل، طلبتَ رمية داخليّة يا كوشو

184
00:13:31,700 --> 00:13:33,660
!كانت تلك رمية جريئة

185
00:13:33,660 --> 00:13:35,280
.وجرأة من الماسك أيضًا

186
00:13:36,080 --> 00:13:38,660
!ليعد اللاّعبون الدّاخليّون لمواقعهم
!حقّقوا أقرب خروج

187
00:13:38,660 --> 00:13:40,160
!لننهِ هذا الشّوط

188
00:13:40,160 --> 00:13:43,210
،إن كانوا سيواجهوننا مباشرة
.فذلك يناسبنا أيضًا

189
00:13:44,130 --> 00:13:46,210
.كانت معظم رمياته واهنة

190
00:13:46,210 --> 00:13:48,170
.أضربوا واحدة وحرّروه من معاناته

191
00:13:48,420 --> 00:13:49,670
!هيّا

192
00:13:51,840 --> 00:13:52,970
...رايمو

193
00:13:54,430 --> 00:13:55,430
...سيا

194
00:13:56,430 --> 00:13:59,390
!سأوصل الكرة لكما بكلّ تأكيد

195
00:14:02,020 --> 00:14:03,440
!كان ذلك وشيكًا

196
00:14:05,440 --> 00:14:07,480
.إنّه منتبه لمحيطه

197
00:14:07,480 --> 00:14:11,490
.نعم، لذلك كان ذلك الخروج مهمًّا جدًّا

198
00:14:12,030 --> 00:14:15,160
.بالنّسبة للرّامي وللماسك أيضًا

199
00:14:16,870 --> 00:14:22,580
.كانت مرتفعة قليلاً، لكن أسرع ممّا توقّعوا

200
00:14:23,960 --> 00:14:28,460
.هكذا يقاتل ساوامورا-سينباي

201
00:14:32,130 --> 00:14:33,550
!وقوّته الحقيقيّة

202
00:14:37,810 --> 00:14:39,560
!منخفضة وخارجيّة

203
00:14:39,810 --> 00:14:41,390
.لقد عاد

204
00:14:41,770 --> 00:14:44,520
.ها قد تعافى

205
00:14:45,480 --> 00:14:47,820
،عندما نتمكّن من رؤية الأشواط الباقية

206
00:14:47,820 --> 00:14:53,200
،نكون ما زلنا قادرين على التّركيز
.مهما بلغ التّعب منّا

207
00:14:54,860 --> 00:14:58,330
هل ستكون قادرًا على تجاوز ذلك الجدار؟

208
00:15:04,790 --> 00:15:05,750
!خطأ

209
00:15:06,080 --> 00:15:07,670
كرة متبدّلة؟

210
00:15:08,340 --> 00:15:10,210
!أجل، إصابتان

211
00:15:10,210 --> 00:15:11,800
!رمية ممتازة يا ساوامورا

212
00:15:11,800 --> 00:15:14,260
!هذا رائع! لقد عدت

213
00:15:14,590 --> 00:15:15,720
.سُحقًا

214
00:15:16,680 --> 00:15:21,470
لماذا لستُ هناك في الملعب خلفه؟

215
00:15:24,270 --> 00:15:25,480
خطأ؟

216
00:15:25,480 --> 00:15:26,940
!واصل الضّغط عليه

217
00:15:26,940 --> 00:15:29,020
!رمياتك جيّدة جدًّا يا ساوامورا

218
00:15:29,400 --> 00:15:33,360
لم أشعر بهكذا إحباط من قبل
!بسبب تواجدي على دكّة الاحتياط

219
00:15:36,450 --> 00:15:37,610
...ساوامورا

220
00:15:38,530 --> 00:15:41,080
!دعه يضربها ناحيتي! سأمسكها

221
00:15:41,080 --> 00:15:42,580
!واصل إرباكهم

222
00:15:42,580 --> 00:15:44,830
!لديه إصابتان! لا تستعجل

223
00:15:44,830 --> 00:15:46,580
!حان وقت اللّعب

224
00:15:46,580 --> 00:15:48,500
!نل منهم يا ساوامورا

225
00:15:48,500 --> 00:15:50,340
!انطلق يا ساوامورا

226
00:15:50,340 --> 00:15:52,340
!أنهِ أمرهم يا ساوامورا

227
00:15:54,010 --> 00:15:56,340
...مهما تعثّرتُ وسقطتُ

228
00:15:56,340 --> 00:15:58,050
!كرة ميتة

229
00:16:03,470 --> 00:16:06,100
...مهما خذلتُ ظنّهم فيّ

230
00:16:08,020 --> 00:16:09,480
...لا أزال

231
00:16:12,320 --> 00:16:13,860
!قادرة على العودة

232
00:16:23,410 --> 00:16:25,330
!يمكنني العودة

233
00:16:27,750 --> 00:16:29,630
!تلك الإصابة الثّالثة

234
00:16:29,630 --> 00:16:31,460
!أنهى بكرة سريعة مرتفعة

235
00:16:31,460 --> 00:16:33,090
!ثلاثة خروجات، تغيير

236
00:16:33,090 --> 00:16:34,840
!رمية ممتازة

237
00:16:35,170 --> 00:16:36,840
!عدنا على قيد الحياة

238
00:16:37,090 --> 00:16:40,090
جعل الأمر مسألة حياة أو موت
!مبالغ فيه كثيرًا في الحقيقة

239
00:16:40,090 --> 00:16:41,090
!ممتاز

240
00:16:41,090 --> 00:16:42,100
!أجل

241
00:16:42,470 --> 00:16:44,850
إنّها لا تملك السّرعة الوحشيّة
،كرميات فورويا

242
00:16:45,180 --> 00:16:50,100
لكنّ تلك الكرة السّرعة بدأت
.تصبح سلاحًا لا مثيل له

243
00:16:51,100 --> 00:16:54,860
.بإمكانه الرّمي هكذا حتّى بدون ميوكي-كُن

244
00:16:56,320 --> 00:17:00,990
الرّمي الّذي ألهم فريقه، كما رأيتُ
!في أوّل يوم قابلتُه فيه! كلاعب أوّل

245
00:17:05,910 --> 00:17:07,370
.أبليت حسنًا

246
00:17:07,370 --> 00:17:08,330
!نعم

247
00:17:08,330 --> 00:17:10,170
.اكتفيتَ لهذا اليوم

248
00:17:10,170 --> 00:17:11,630
.اذهب لتستريح

249
00:17:11,630 --> 00:17:14,460
.إنّ كاواكامي يقوم بالإحماء الآن

250
00:17:15,210 --> 00:17:17,010
—دع بقيّة الفريق ينهون المباراة

251
00:17:17,010 --> 00:17:18,010
.مهلاً لحظة

252
00:17:19,680 --> 00:17:22,510
!بإمكاني إنهاء هذه المباراة بنفسي

253
00:17:31,440 --> 00:17:34,060
كان تحكّم بالكرة عير مستقرّ
،وأنا أشاهدك من الدّكّة

254
00:17:34,060 --> 00:17:35,940
.ورمياتك الخاطئة في تزايد

255
00:17:36,610 --> 00:17:38,190
وما زلت تقول أنّ بإمكانك المواصلة؟

256
00:17:38,190 --> 00:17:40,240
!كانت تلك نيّتي منذ البداية

257
00:17:41,450 --> 00:17:44,450
!مذهل، قال ذلك للمدرّب مباشرة

258
00:17:48,910 --> 00:17:51,750
أوكومورا، ما رأيك؟

259
00:17:52,420 --> 00:17:55,000
ما زال قادرة على رمي
.كرات سريعة أقوى

260
00:17:55,000 --> 00:17:59,460
.إن رمينا أرقامًا أقلّ، فأظنّ أنّه سينجح

261
00:18:03,390 --> 00:18:05,760
.لم يصل إلى مائة رمية بعد

262
00:18:08,600 --> 00:18:09,600
.واحد

263
00:18:09,980 --> 00:18:13,810
إن وصل راكض واحد فقط
.للقاعدة، فسأخرجك من الملعب

264
00:18:16,820 --> 00:18:18,110
.مفهوم

265
00:18:18,530 --> 00:18:21,110
.حسنًا، اشرب شيئًا واستعدّ للضّرب

266
00:18:24,360 --> 00:18:25,740
هذا الّذي أردته، صحيح؟

267
00:18:25,740 --> 00:18:27,620
.نعم، شكرًا لك

268
00:18:29,080 --> 00:18:34,210
،لا أريد قول هذا بصوت مرتفع
.لكنّه رأيي كماسك

269
00:18:34,210 --> 00:18:37,000
.تريّث رجاءً في مربّع الضّارب

270
00:18:37,000 --> 00:18:38,460
ما... لماذا؟

271
00:18:38,460 --> 00:18:40,380
!إن فعلتُ ذلك، فسأخرج

272
00:18:40,380 --> 00:18:42,510
!إن لم ألوّح بمضربي، فلن أضرب الكرة

273
00:18:42,880 --> 00:18:44,300
!حسنًا، أنا ذاهب

274
00:18:46,260 --> 00:18:49,600
كوراموتشي، كوميناتو، هل أنتما جاهزان؟

275
00:18:49,600 --> 00:18:50,470
!نعم

276
00:18:50,470 --> 00:18:52,350
!مايزونو، شيراسو

277
00:18:52,350 --> 00:18:53,850
!نحن جاهزان

278
00:18:54,810 --> 00:18:55,900
!لنلعب

279
00:18:56,150 --> 00:18:59,020
...انظروا كيف يتصرّف وهو في ورطة

280
00:18:59,020 --> 00:19:01,860
.يراودني شعور جيّد حين مشاهدة رامٍ مثله

281
00:19:01,860 --> 00:19:02,990
!حسنًا

282
00:19:03,400 --> 00:19:06,530
.بادٍ على وجهه أنّه يلعب

283
00:19:06,910 --> 00:19:10,040
.حسنًا، لنرَ ما في جعبتك

284
00:19:15,330 --> 00:19:16,960
!أجل

285
00:19:17,250 --> 00:19:18,540
!إصابة

286
00:19:18,540 --> 00:19:20,250
.تلويحة كاملة

287
00:19:20,880 --> 00:19:23,170
.لم يستمع لي أبدًا

288
00:19:23,510 --> 00:19:26,010
!كان وشيكًا! قد يستطيع تحقيق ضربة

289
00:19:26,010 --> 00:19:27,180
!أيّها الزّعيم

290
00:19:27,180 --> 00:19:29,350
!ما زلت أمتلئ طاقة

291
00:19:29,350 --> 00:19:30,890
!وفي أفضل حال أيضًا

292
00:19:31,310 --> 00:19:35,230
.دعني أرمي في الشّوط الأخير رجاءً

293
00:19:35,600 --> 00:19:38,440
!بإمكاني إنهاء هذه المباراة بنفسي

294
00:19:43,490 --> 00:19:44,490
!مهلاً

295
00:19:48,620 --> 00:19:51,700
!سُحقًا، كان وشيكًا ثانية

296
00:19:51,700 --> 00:19:54,370
.إنّه قادر على ضرب الكرة

297
00:19:55,040 --> 00:19:56,750
.ضربة جيّدة

298
00:19:56,750 --> 00:19:59,880
.ذلك لا يهمّ إن لم أصل للقاعدة

299
00:19:59,880 --> 00:20:03,210
.غبيّ، اذهب واجلس في الدّكّة واسترح

300
00:20:03,460 --> 00:20:05,090
!كوراموتشي كضارب احتياطيّ

301
00:20:05,300 --> 00:20:10,600
سنحرز نقاطًا لتتمكّن
.من الرّمي وأنت مرتاح

302
00:20:10,930 --> 00:20:13,470
!حسنًا، أتى فهدنا متأخّرًا

303
00:20:13,470 --> 00:20:16,350
!لا تعبثوا معه وهو جائع

304
00:20:18,440 --> 00:20:20,310
.لن نخسر

305
00:20:21,900 --> 00:20:23,980
!سنفوز بكلّ تأكيد

306
00:20:34,080 --> 00:20:36,750
.مرّت هذه الأيّام الثّلاثة بسرعة

307
00:20:36,750 --> 00:20:40,420
.نعم، وأنا سعيد لأنّ إينوي-كُن سيكون بخير

308
00:20:41,000 --> 00:20:44,090
.انتهت المباراة الأولى بتعادل 5-5

309
00:20:44,380 --> 00:20:47,220
.وفاز الأمريكيّون بالمباراة الثّانية بنتيجة 3-2

310
00:20:47,220 --> 00:20:50,300
.كانت اللُّعب في الشّوط الأخير قويّة جدًّا

311
00:20:50,300 --> 00:20:53,100
.تمكّنّا من رؤية مدى عناد الأمريكيّين

312
00:20:53,760 --> 00:20:58,100
،كان أوميميا-كُن الرّامي الأوّل
.وتبعه أوغورو-كُن من نيوغاكوشا

313
00:20:59,020 --> 00:21:02,730
.قام ميوكي-كُن بقرارات قويّة لكِلا الرّاميين

314
00:21:03,190 --> 00:21:05,730
.هل هو مناسب أكثر ليكون ماسكًا

315
00:21:12,320 --> 00:21:18,660
،لم نبلِ كما يجب، لكن في هاتين المباريتين
.أظهرنا كيف تلعب اليابان كرة القاعدة

316
00:21:19,160 --> 00:21:23,920
ومرّة أخرى، أنا ممتنّ لكم
.جميعًا لتواجدكم هنا

317
00:21:24,460 --> 00:21:25,500
.شكرًا لكم

318
00:21:26,170 --> 00:21:29,420
في لقائنا التّالي، قد نتواجه كفرق متعارضة

319
00:21:29,630 --> 00:21:33,180
.أو فرق متنافسة أو فرق صديقة

320
00:21:33,390 --> 00:21:39,980
وبالنّسبة للاعبي السّنة الثّالثة الّذين
،سيكون هذا صيفهم الأخير

321
00:21:39,980 --> 00:21:42,060
.قدّموا أفضل ما لديكم ولا تندموا على شيء

322
00:21:43,100 --> 00:21:44,360
!حاضر

323
00:21:44,360 --> 00:21:46,320
!شكرًا جزيلاً لك

324
00:21:49,490 --> 00:21:51,150
.حان الوقت

325
00:21:51,820 --> 00:21:53,070
.نعم

326
00:21:53,070 --> 00:21:54,370
.إنّه على الأبواب

327
00:21:56,740 --> 00:21:59,790
.صيفهم الأخير

328
00:22:12,970 --> 00:22:14,890
".مصير مشترك"

329
00:23:45,600 --> 00:23:49,940
،تركناكم على هواك مفي هذه المباريات
!لكنّ منافسات الصّيف ستكون لنا

330
00:23:49,940 --> 00:23:52,290
.لن نستسلم أيضًا

331
00:23:52,290 --> 00:23:53,820
.إنّه قتال حتّى الموت

332
00:23:53,820 --> 00:23:55,080
.هذا صحيح

333
00:23:55,080 --> 00:23:58,580
.بدأ الصّيف سلفًا

334
00:23:58,580 --> 00:24:03,000
سأعلم اللاّعبين بنفسي غدًا
.قبل التّدريبات الصّباحيّة

335
00:24:03,410 --> 00:24:07,880
تمّ تحديد قائمة المنافسات
...في 16 من يونيو، وقد ضمّت

336
00:24:08,300 --> 00:24:12,520
في الحلقة القادمة من
:اللاّعب الماسيّ الأوّل"، الفصل الثّاني"

337
00:24:12,520 --> 00:24:15,220
‪‫"20 شخصًا."

338
00:24:15,220 --> 00:24:20,210
رسم ملوّن / تيراجيما يوجي