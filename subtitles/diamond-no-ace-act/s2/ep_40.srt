1
00:00:00,620 --> 00:00:05,430
،سنواجه الوحش من أيتشي
.ثانويةّ سيهو تحت تدريب نيشيديرا

2
00:00:06,070 --> 00:00:09,570
ليس لديهم ضاربون متباطئون
،كبار مثل سانو من السّنة الماضية

3
00:00:09,570 --> 00:00:14,430
لكن دليهم رميات سريعة
.ترسل الكرات لمسافات بعيدة

4
00:00:14,740 --> 00:00:18,440
،إن استفادوا من الزّخم
.فلا يوجد ما يوقفهم

5
00:00:18,970 --> 00:00:21,410
.إنّهم بنفس قوّة ياماموري على الأقلّ

6
00:00:24,670 --> 00:00:28,960
يملك أوكومورا المهارة ليكون
،جزءًا من الفريق الأوّل

7
00:00:28,960 --> 00:00:34,100
لكنّ الأمور مختلفة عندما نواجه
.فريقًا في قمّة التّرتيب الوطنيّ

8
00:00:36,160 --> 00:00:38,520
.اعتمد عليك يا ساوامورا

9
00:00:42,710 --> 00:00:44,890
.قُد الفريق

10
00:01:02,660 --> 00:01:03,540
!حاضر

11
00:01:14,500 --> 00:01:15,840
!خطأ

12
00:01:15,840 --> 00:01:17,040
إنّها تدور؟

13
00:01:20,080 --> 00:01:22,920
!لا، لا، لا، ذلك غريب تمامًا

14
00:01:22,920 --> 00:01:26,910
.لستُ واثقًا، لكن يبدو الضّارب حائرًا

15
00:01:26,910 --> 00:01:29,930
.أتطلّع قُدمًا لأخطو على مربّع الضّارب

16
00:01:30,440 --> 00:01:33,630
.الرّقم 2 والرّقم 1 تتحرّكان جيّدًا

17
00:01:33,630 --> 00:01:37,510
يغيّرون كيف يضربون عندما
...يكونون في ورطة، لكن

18
00:01:41,800 --> 00:01:44,860
لا تريد إضاعة أيّ رمية، صحيح؟

19
00:01:47,320 --> 00:01:51,550
.أنت تدرك الأمر إذًا أيّها الفتى الذّئب

20
00:01:52,500 --> 00:01:54,890
.الرّقم 4 في الدّاخل

21
00:01:56,520 --> 00:02:02,820
عليك أن تفهم، الرّمي فنّ
!يؤدّيه لرّامي والماسك

22
00:02:03,170 --> 00:02:05,630
هل أنت واثق من رغبتك في هذا؟

23
00:02:06,930 --> 00:02:11,310
هل ستخلق ذلك الفنّ معي؟

24
00:02:22,830 --> 00:02:25,030
!إصابة! خروج الضّارب

25
00:02:25,030 --> 00:02:27,840
!أجل

26
00:04:00,540 --> 00:04:02,210
!خرج لاعبان على التّوالي

27
00:04:02,210 --> 00:04:04,290
!يُبلي ساوامورا حسنًا بالفعل

28
00:04:04,290 --> 00:04:05,920
!سيُقدّم لنا مباراة جيّدة أخرى اليوم

29
00:04:05,920 --> 00:04:07,960
.رمياته سريعة بالفعل

30
00:04:13,630 --> 00:04:14,600
...حسنًا

31
00:04:19,360 --> 00:04:20,940
.ثلاث رميات خارجيّة

32
00:04:22,480 --> 00:04:23,310
!خروج

33
00:04:24,810 --> 00:04:25,960
!أجل

34
00:04:25,960 --> 00:04:28,310
!أحسنت يا ساوامورا! رميّة جيّدة

35
00:04:28,310 --> 00:04:30,250
!أجل! مثاليّة

36
00:04:30,520 --> 00:04:32,570
.خرجت جميعها

37
00:04:32,910 --> 00:04:36,490
.صدّ الضّارب الثّالث رمية داخليّة أخرى

38
00:04:37,300 --> 00:04:40,070
،يبدو أنّه يحبّ تلك الرّميات
.لذلك علينا أن نحذر

39
00:04:40,070 --> 00:04:41,580
.هذا متوقّع من ماسك

40
00:04:41,580 --> 00:04:43,840
.أنت تلاحظ حتّى التّفاصيل الصّغيرة

41
00:04:44,080 --> 00:04:46,470
.كانت الرّمية الأخيرة جيّدة

42
00:04:46,470 --> 00:04:48,320
.لكنّها كانت ضربة ناجحة

43
00:04:48,840 --> 00:04:54,460
نعم، علينا أن نحذر من الضّاربين
.الثّالث والرّابع يا أكاشي-سان

44
00:04:54,730 --> 00:04:55,730
.نعم

45
00:04:56,460 --> 00:04:59,310
!قلب ساوامورا الأمور لصالحنا

46
00:04:59,310 --> 00:05:00,280
!لننطلق إذًا

47
00:05:00,280 --> 00:05:01,320
!أجل

48
00:05:01,320 --> 00:05:04,610
.كانت لديهم بداية جيّدة

49
00:05:04,610 --> 00:05:07,460
.إنّه خطؤنا لأنّنا سمحنا له بالرّمي كما يشاء

50
00:05:07,460 --> 00:05:10,390
.نحتاج لطريقة لصدّ تلك الكرة السّريعة

51
00:05:10,760 --> 00:05:12,390
.أنا أحسده

52
00:05:13,620 --> 00:05:17,450
.ليتني أستطيع الرّمي بلا تردّد مثله

53
00:05:19,850 --> 00:05:21,290
...سيا

54
00:05:21,660 --> 00:05:26,010
تأخّر الوقت للحديث عن
.تعديلات أو خلق أعذار

55
00:05:26,010 --> 00:05:29,300
.كلّ ما يهمّ هو اللّعب وتحقيق النّتائج

56
00:05:30,370 --> 00:05:31,910
.فهذا هو اللاّعب الأوّل

57
00:05:38,260 --> 00:05:39,750
!لننطلق

58
00:05:43,000 --> 00:05:44,820
...أكاشي سيا

59
00:05:44,820 --> 00:05:47,040
عندما لعب في ملعب كوشيين
،كتلميذ سنة أولى

60
00:05:47,040 --> 00:05:49,780
.حصل على اهتمام أكثر من ناروميا

61
00:05:49,780 --> 00:05:51,940
.لقد وصفوه بالمبتدئ الخارق

62
00:05:51,940 --> 00:05:53,570
فعلاً؟

63
00:05:54,220 --> 00:05:56,460
،رمى في ثلاث مباريات وحده

64
00:05:56,460 --> 00:05:58,890
.وقام بدورتين كاملتين أيضًا كما أذكر

65
00:05:59,290 --> 00:06:01,710
.أذكر ذلك أيضًا

66
00:06:01,710 --> 00:06:03,500
...خارق

67
00:06:03,800 --> 00:06:08,460
وبعدها، حاز ناروميا على كلّ الاهتمام
.في ملعب كوشيين السّنة الماضية

68
00:06:08,460 --> 00:06:11,000
...أبلى حسنًا كضارب، لكن

69
00:06:11,290 --> 00:06:13,110
أصاب مرفقه، صحيح؟

70
00:06:13,110 --> 00:06:15,910
.لم يرمي كثيرًا كتلميذ سنة ثانية

71
00:06:16,910 --> 00:06:18,160
أصيب؟

72
00:06:30,250 --> 00:06:31,700
أصيب؟

73
00:06:39,770 --> 00:06:42,160
!إصابة! خروج الضّارب

74
00:06:42,930 --> 00:06:44,150
!كان ذلك سريعًا

75
00:06:44,150 --> 00:06:45,900
!غيّر أكاشي هيأته

76
00:06:45,900 --> 00:06:48,150
!أسفل ظهره! وكذلك خطّ فخده

77
00:06:48,150 --> 00:06:50,850
،إن رمى الكرات بشكل منخفض هكذا
!فلن يستطيع أحد ضربها

78
00:06:51,130 --> 00:06:52,270
!أجل

79
00:06:51,450 --> 00:06:52,970
!رمية ممتازة يا سيا

80
00:06:54,770 --> 00:06:58,170
اعتمد على أعضاء الفريق
،الأكبر في ملعب كوشيين

81
00:06:58,170 --> 00:07:01,130
.لكنّه عمل على نفسه كرامٍ

82
00:07:01,480 --> 00:07:03,850
،وكتلميذ سنة ثانية، شعر بعبء مسؤوليّاته

83
00:07:03,850 --> 00:07:07,140
.وتكبّد الكثير لكي يحسّن من نفسه

84
00:07:07,800 --> 00:07:12,640
تراجعت هيأته بعد الإصابة ومرّ
.وقت طويل دون أن يحرز فوزًا

85
00:07:18,290 --> 00:07:20,120
!أجل! رمية ممتازة

86
00:07:20,120 --> 00:07:20,950
!تبدو رائعًا

87
00:07:20,950 --> 00:07:22,490
!سيا، أنت ضخم

88
00:07:22,770 --> 00:07:26,250
.إنّه محقّ. وقت اختلاق الأعذار قد ولّى

89
00:07:27,400 --> 00:07:29,490
.هذه آخر سنة لكه في الثّانويّة

90
00:07:29,490 --> 00:07:32,590
.عليه تجاوز الأمور بنفسه

91
00:07:41,330 --> 00:07:43,210
!أجل

92
00:07:42,140 --> 00:07:43,810
!إصابة خروج

93
00:07:43,810 --> 00:07:45,520
!هذه ثلاث خروجات

94
00:07:45,520 --> 00:07:46,910
!أجل

95
00:07:46,190 --> 00:07:47,780
!رمية رائعة يا سيا

96
00:07:47,780 --> 00:07:48,760
!عضلات مؤخّرتك رائعة

97
00:07:48,760 --> 00:07:49,460
!إنّها ضخمة

98
00:07:49,460 --> 00:07:50,740
!يُنهي سيا الأمور الآن

99
00:07:50,740 --> 00:07:52,020
!فخذاك ممتازان

100
00:07:52,400 --> 00:07:57,290
،مذهل، إنّهما راميان مختلفان تمامًا
!لكن حقّق كلاهما إصابتا خروج

101
00:07:57,500 --> 00:08:00,770
لا أطيق الانتظار لأعرف كيف
!ستنتهي المباراة

102
00:08:00,770 --> 00:08:02,430
.يبدو أنّك في أفضل حال

103
00:08:02,430 --> 00:08:05,220
.نعم، كانت بداية جيّدة

104
00:08:05,220 --> 00:08:08,760
.يعود الفضل لتحمّسي إلى راميهم

105
00:08:19,100 --> 00:08:22,510
كانت رؤية حدّة لاعب رامي
.السّنة الثّالثة لا تصدّق

106
00:08:23,060 --> 00:08:24,730
.ملامح وجهه مختلفة بطريقة ما

107
00:08:29,010 --> 00:08:33,350
يبدأ بالإصابات ليتمكّن
.من دخول إيقاع لعب جيّد

108
00:08:33,940 --> 00:08:36,110
...لن أسمح له بهزيمة

109
00:08:39,300 --> 00:08:40,560
!شغفي

110
00:08:40,560 --> 00:08:42,120
!لن يحدث ذلك

111
00:08:42,120 --> 00:08:44,200
―سألوّح لضرب كرتك السّريعة

112
00:08:47,000 --> 00:08:48,790
!إصابة

113
00:08:48,790 --> 00:08:51,010
.بدأ برمي كرة متبّدلة

114
00:08:51,370 --> 00:08:53,460
.كرة أولى ماكرة

115
00:08:53,870 --> 00:08:56,940
هل ذلك الماسك في السّنة الأولى فعلاً؟

116
00:08:58,810 --> 00:09:02,940
ستكون هذه معركةَ
.من يستطيع كبح نفسه

117
00:09:07,640 --> 00:09:09,800
.يعرف لاعب ارتكازهم أين يقف بالضّبط

118
00:09:09,800 --> 00:09:10,930
.هذا متوقّع

119
00:09:10,930 --> 00:09:14,390
،لم يتخلّى عن أيّ ضربة
.لكنّه جعل ضاربين يسيران

120
00:09:14,390 --> 00:09:17,650
كن من الخسارة فعلاً
.أنّه جعل ساوامورا يسير

121
00:09:17,650 --> 00:09:21,020
عندما يصبح هكذا، فقد يكون
.قد أوشك على الانهيار

122
00:09:21,670 --> 00:09:24,790
.من جهة أخرى، سمح ساوامورا بضربة واحدة

123
00:09:24,790 --> 00:09:28,030
.لا يستطيع ضاربو سيهو الضّرب بشكل فعّال

124
00:09:28,330 --> 00:09:32,890
ربّما سيتجاوز فريق ما هذا الرّكود
.في محاولتهم الثّانية عبر ترتيب الضّرب

125
00:09:40,780 --> 00:09:42,020
!خروج

126
00:09:44,720 --> 00:09:48,040
هل خطا دون أن يحرّك قدمه للأمام؟

127
00:10:05,650 --> 00:10:06,640
!كرة

128
00:10:07,040 --> 00:10:09,130
.أنا أرتعد

129
00:10:09,790 --> 00:10:10,960
.كنتُ على حقّ

130
00:10:11,640 --> 00:10:15,550
ينتقل هذا الفريق إلى طريقة الضّرب
...بلا خطْوٍ عندما يكونون متأخّرين

131
00:10:15,550 --> 00:10:22,280
لكنّهم بدؤوا بطريقة اللاّ خطو لمهاجمة
.رميات ساوامورا-سينباي المتحرّكة

132
00:10:23,040 --> 00:10:27,210
يحافظ أسلوب الضّرب هذا على ثبات
.خطّ الرّؤية للتّركيز إحداث تماسّ

133
00:10:27,210 --> 00:10:30,550
،حتّى إن كانت رمية غير عاديّة
،إن استطاع النّجاح في ضربها

134
00:10:30,550 --> 00:10:33,570
فستحلّق فوق رؤوسا اللاّعبين
.الميدانيّين الدّاخليّين

135
00:10:34,310 --> 00:10:37,210
،إن كان سينتظر حتّى النّهاية ليضرب

136
00:10:37,210 --> 00:10:39,110
.فسنقحم الكرة في مضربه

137
00:10:41,790 --> 00:10:44,360
!ها هي ذي كرة ساوامورا-سينباي السّريعة

138
00:10:46,010 --> 00:10:47,130
!أجل

139
00:10:48,010 --> 00:10:50,900
!أجل! نجح سيا-سان بضربها

140
00:10:51,170 --> 00:10:53,490
رغم إقحام الكرة في مضربه إلاّ
أنّها وصلت إلى خارج الملعب؟

141
00:10:53,800 --> 00:10:55,500
!حسنًا، لنتابع

142
00:10:55,500 --> 00:10:56,880
!لنحافظ على سلسلتنا هذه

143
00:10:56,880 --> 00:10:58,100
.طارت بعيدًا

144
00:10:58,100 --> 00:11:00,190
تطير الكرة لمسافة بعيدة
.عند الضّرب باستعمال الوركين

145
00:11:00,890 --> 00:11:02,540
،من القاعدة الأولى حتّى التّاسعة

146
00:11:02,540 --> 00:11:05,690
.لدى كلّ ضاربيهم تلويحات قويّة وسريعة

147
00:11:05,690 --> 00:11:07,580
،إن بنوا على زخمهم هذا
.فلن نتمكّن من إيقافهم

148
00:11:07,580 --> 00:11:09,020
.ضاربوهم أشبه بمدفع رشّاش

149
00:11:10,620 --> 00:11:11,810
.أوكومورا

150
00:11:11,810 --> 00:11:15,030
لن نستعمل الرّميتين
.رقم 7 و11 لبعض الوقت

151
00:11:18,540 --> 00:11:20,720
هل تقول أنّني لا أستطيع الإمساك بهما؟

152
00:11:20,720 --> 00:11:21,810
.لا، الأمر ليس كذلك

153
00:11:22,470 --> 00:11:26,060
يمكن أن يكون التّعامل مع فريق
.كهذا صعبًا في النّصف الثّاني

154
00:11:26,060 --> 00:11:29,600
.علينا توفيرهما حتّى وقت حاجتنا لهما

155
00:11:32,080 --> 00:11:33,610
.فهمت

156
00:11:33,900 --> 00:11:36,410
،كنتَ ترمي بكلّ قوّتك منذ البداية

157
00:11:36,410 --> 00:11:38,710
لذلك اعتقدتُ أنّك لم تكن
.تفكّر في أيّ شيء كهذا

158
00:11:38,710 --> 00:11:39,740
.أنا آسف

159
00:11:41,290 --> 00:11:44,380
!لن أسمح لك باتّخاذ كلّ القرارات

160
00:11:44,710 --> 00:11:47,250
.أُفكّر في هذه الأمور أيضًا

161
00:11:57,350 --> 00:11:58,690
.ما زال الوقت باكرًا

162
00:11:58,690 --> 00:12:00,900
.ليس علينا أن نتسرّع هكذا

163
00:12:03,330 --> 00:12:06,830
.الرّمية رقم 2 إلى الدّاخل إذًا

164
00:12:14,140 --> 00:12:15,280
!آمن

165
00:12:18,890 --> 00:12:22,610
هذه كرة القاعدة، لذا سينجحون
.طبعًا في ضرب بعض الكرات

166
00:12:23,000 --> 00:12:26,790
،إن كنتُ أخشى أن يقوموا بضربها
.فما كنتُ لأستطيع الوقوف هنا

167
00:12:27,550 --> 00:12:29,380
...نحن لسنا

168
00:12:31,410 --> 00:12:33,270
!في ورطة على الإطلاق

169
00:12:34,250 --> 00:12:35,190
―إنّها قادمة مباشـ

170
00:12:41,340 --> 00:12:42,480
!خروج

171
00:12:42,480 --> 00:12:43,240
!أجل

172
00:12:43,240 --> 00:12:44,790
!هذا ما كنّا نحتاجه

173
00:12:44,790 --> 00:12:46,190
!لعبة 5-4-3 مزدوجة

174
00:12:46,190 --> 00:12:46,950
!ساوامورا

175
00:12:46,950 --> 00:12:48,700
!أيّها الوغد ساوامورا

176
00:12:48,700 --> 00:12:49,980
!ساوامورا-سينباي

177
00:12:52,950 --> 00:12:56,420
لا تنظر إليّ رجاءً بذلك
.التّعبير المعتدّ بنفسه

178
00:12:56,420 --> 00:12:57,880
!تنتقد تعابير وجهي؟

179
00:12:58,190 --> 00:13:00,910
.على الرّامين أن يتحكّموا بعواطفهم

180
00:13:00,910 --> 00:13:02,310
!يا لك من طفل صعب المراس

181
00:13:03,250 --> 00:13:04,840
.رمية ممتازة يا ساوامورا

182
00:13:04,840 --> 00:13:06,150
.أنت تسير على إيقاع جيّد

183
00:13:06,150 --> 00:13:07,250
!شكرًا لك

184
00:13:07,730 --> 00:13:10,290
.لديهم الكثير من الضّاربين الأقوياء

185
00:13:10,290 --> 00:13:12,470
.لا يجب أن أرمي كرات ضعيفة

186
00:13:17,460 --> 00:13:20,490
.إنّه يتعرّق بشدّة

187
00:13:25,450 --> 00:13:26,530
.ساوامورا

188
00:13:27,320 --> 00:13:31,660
قلتَ أنّك لن تستعمل الرّميتان
...رقم 7 و11 لبعض الوقت

189
00:13:31,660 --> 00:13:34,080
.نعم، إلى أن نحتاجهما

190
00:13:34,440 --> 00:13:40,180
لا بأس بذلك، بكن ما رأيك برميهما
بمجرّد امتلاك ضارب لإصابتين؟

191
00:13:41,080 --> 00:13:44,680
.الأرقام مختلفة قليلاً كلّ يوم

192
00:13:45,360 --> 00:13:48,840
يصعب التّعامل معها بالنّسبة
.لنا نحن الماسكون

193
00:13:48,840 --> 00:13:51,800
حسنًا، أهكذا الأمر إذًا؟

194
00:13:51,800 --> 00:13:53,610
.شكرًا لشرحك للأمر

195
00:13:53,990 --> 00:13:57,000
،قال أنّه سيدعني أتّخذ القرارات
.ثمّ قام بهزّ رأسه

196
00:13:57,660 --> 00:14:00,560
!لكنّني نظرت إليك

197
00:14:00,900 --> 00:14:02,670
أوتظنّ أنّ ذلك كافٍ؟

198
00:14:03,500 --> 00:14:06,390
!حسنًا إذًا! سنناقش الأمر حتّى النّهاية

199
00:14:06,390 --> 00:14:07,570
!حتّى النّهاية

200
00:14:07,570 --> 00:14:09,250
.بكلّ سرور

201
00:14:09,250 --> 00:14:10,500
!لا تقل ذلك

202
00:14:10,500 --> 00:14:12,020
!أنت جامح للغاية

203
00:14:15,000 --> 00:14:19,530
أرقام الرّميات هي أرقام اتّفق عليها
.ساوامورا-سينباي وميوكي-سينباي معًا

204
00:14:20,470 --> 00:14:23,830
.وبصراحة، ما زلت غير معتاد عليها جميعها

205
00:14:24,890 --> 00:14:28,230
،ونحن الآن في مواجهة ثانويّة سيهو
.فريق قويّ بالفعل

206
00:14:29,550 --> 00:14:33,250
.سيصبح من الصّعب اتّخاذ القرارات

207
00:14:37,900 --> 00:14:39,290
!حسنًا يا سيا

208
00:14:39,290 --> 00:14:40,790
!أنت لها يا سيا-سان

209
00:14:40,790 --> 00:14:41,880
!أنت ضخم جدًّا

210
00:14:53,030 --> 00:14:56,530
.يلوّح لاعب السّنة الأولى ذاك بقوّة

211
00:14:56,530 --> 00:14:57,740
...لكن

212
00:14:57,740 --> 00:15:00,590
!سيا أكبر

213
00:15:03,170 --> 00:15:04,370
!أقوى

214
00:15:07,250 --> 00:15:09,450
!ورمياته مستعدّة للانفجار

215
00:15:12,290 --> 00:15:13,760
!إصابة

216
00:15:13,760 --> 00:15:15,170
!خروج الضّارب

217
00:15:15,760 --> 00:15:18,090
!أجل! أحسنت يا سيا-سان

218
00:15:18,090 --> 00:15:19,520
!إنّه ضخم للغاية

219
00:15:21,000 --> 00:15:23,540
.يلوّح بطريقة جيّدة

220
00:15:24,260 --> 00:15:25,400
.سُحقًا

221
00:15:26,970 --> 00:15:28,810
!الكرة الرّابعة

222
00:15:28,810 --> 00:15:31,950
واجهت سيدو عقبة لاعب
.سيهو الأوّل أكاشي

223
00:15:32,510 --> 00:15:37,500
سار ياماغوتشي للقاعدة الأولى في النّصف
،الثّاني من الشّوط الرّابع بخروجان

224
00:15:37,500 --> 00:15:41,540
ثمّ ضرب ميمورا إلى منتصف
.الملعب وسار هيغاسا أيضًا

225
00:15:42,410 --> 00:15:45,720
بوجود ثلاثة لاعبين من السّنة
،الثّالثة على القواعد

226
00:15:45,720 --> 00:15:48,820
خطا لاعب السّنة الأولى
.أوكومورا كوشو لمربّع الضّارب

227
00:15:49,480 --> 00:15:53,980
!أوكومورا، لوّح للرّمية الأولى بعد سير

228
00:15:53,980 --> 00:15:56,380
!سيريد الرّامي تحقيق إصابة

229
00:15:59,330 --> 00:16:01,380
!هذا تواصل

230
00:16:01,630 --> 00:16:05,280
لا أحتاجك للصّراخ عاليًا بشأن
!التّلويح للرّمية الأولى

231
00:16:05,280 --> 00:16:07,430
!هذا أكثر ما يثير غضبي

232
00:16:12,440 --> 00:16:14,170
!حسنًا، لنلعب

233
00:16:14,170 --> 00:16:15,660
!لنهاجم

234
00:16:18,050 --> 00:16:22,180
،إن جعلت الرّاكض يقوم بدورة كاملة
.فسيدعم ذلك ساوامورا-سينباي

235
00:16:22,680 --> 00:16:27,300
.لن أضيّع الفرصة الّتي خلقها اللاّعبون الأكبر

236
00:16:28,000 --> 00:16:31,710
.أحبّ ذلك التّعبير الخالي من الخوف على وجهك

237
00:16:33,240 --> 00:16:35,920
!نل منّي إن استطعت يا فتى السّنة الأولى

238
00:16:41,300 --> 00:16:42,750
!الكرّة الثّانية

239
00:16:42,750 --> 00:16:44,410
!أحسنت في رؤيتها

240
00:16:44,410 --> 00:16:46,510
!انتظر رميتك الآن يا أوكومورا

241
00:16:47,980 --> 00:16:49,880
!أجل، إصابتان

242
00:16:49,880 --> 00:16:51,150
!اضغط عليه يا سيا

243
00:16:51,150 --> 00:16:52,240
!اقض عليه

244
00:16:52,830 --> 00:16:54,860
.سأبقى معك حتّى إن متُّ

245
00:16:55,470 --> 00:16:58,180
،بدل السّماح للأشياء الأخرى بتشتيت انتباهه

246
00:16:58,180 --> 00:17:00,820
.فإنّك تركّز على اللّعبة التّالية

247
00:17:01,990 --> 00:17:06,540
،بدون وجود أيّ عبء لتحمله
.يمكنك التّركيز على الملعب بالكامل

248
00:17:07,010 --> 00:17:11,480
.علت وجهي تلك النّظرة أنا أيضًا فيما مضى

249
00:17:13,920 --> 00:17:15,420
...أنا لن

250
00:17:23,350 --> 00:17:25,980
!أخسر أمامك

251
00:17:30,750 --> 00:17:33,300
!إصابة! خروج الضّارب

252
00:17:33,640 --> 00:17:36,650
!خروجان

253
00:17:37,680 --> 00:17:38,750
.كاواشيما

254
00:17:40,140 --> 00:17:41,340
.سآتي معك

255
00:17:42,100 --> 00:17:45,200
.أأنت واثق؟ رميت كثيرًا البارحة

256
00:17:46,190 --> 00:17:50,870
بتلك الرّميات الكثيرة، فلا بدّ أنّه
.حتّى ساوامورا قد تعب

257
00:17:58,960 --> 00:18:03,960
يقومون جميعًا بالإحماء دون
.أن يخبرهم أيّ أحد بذلك

258
00:18:04,260 --> 00:18:07,040
إنّهم يقولون أنّهم متأهّبون
.للدّخول في أيّ لحظة

259
00:18:14,540 --> 00:18:17,220
!إصابة! خروج الضّارب

260
00:18:17,220 --> 00:18:18,510
!أجل

261
00:18:18,510 --> 00:18:20,240
!ثلاث خروجات! تغيير

262
00:18:27,670 --> 00:18:28,830
!خروج

263
00:18:28,830 --> 00:18:30,630
!أجل

264
00:18:36,690 --> 00:18:38,020
!خروج

265
00:18:38,020 --> 00:18:41,070
!تمّ إخراج الضّارب الأوّل برمية واحدة

266
00:18:41,430 --> 00:18:43,010
.هذه منافسة رمي ممتازة

267
00:18:43,460 --> 00:18:46,000
.إنّهم يجارون سيهو دون ميوكي

268
00:18:46,000 --> 00:18:47,620
.جميع لاعبيهم الأساسيّين على دكّة الاحتياط أيضًا

269
00:18:47,620 --> 00:18:49,940
.ظننتُ أنّهم قد تخلّوا عن هذه المباراة

270
00:18:50,320 --> 00:18:54,570
لا يمكن نكران أنّ ساوامورا يحافظ
.على بقاء فريقه في المباراة

271
00:18:59,420 --> 00:19:03,890
.تمكّن هذا الشّخص من ضرب رمية خارجيّة

272
00:19:03,890 --> 00:19:06,970
.لا يمكننا رمي رميات خارجيّة ببساطة

273
00:19:08,170 --> 00:19:11,080
.لنقم برمي رميات داخليّة أيضًا

274
00:19:13,450 --> 00:19:15,000
.لنبدأ بالجانب الخارجيّ

275
00:19:18,040 --> 00:19:19,210
!في الجانب الآخر؟

276
00:19:21,710 --> 00:19:23,130
!أجل

277
00:19:23,800 --> 00:19:26,030
!وقوف مزدوج سهل

278
00:19:26,030 --> 00:19:28,190
!ضربة ممتازة يا إيتشينوسي-سينباي

279
00:19:28,560 --> 00:19:30,190
!نال منّي

280
00:19:30,190 --> 00:19:33,390
.رمى رمية ضعيفة أخيرًا

281
00:19:33,710 --> 00:19:36,570
!جلبتَ النّحس إليها بثنائك عليه

282
00:19:36,570 --> 00:19:38,340
!هذه ليست غلطتي

283
00:19:38,650 --> 00:19:42,520
،أعتقد أنّ الوقت قد حان لهزيمتكم
.بما أنّني الضّارب الرّابع

284
00:19:53,620 --> 00:19:54,780
.هذا سيّئ

285
00:19:54,780 --> 00:19:57,550
.المزيد من كراته ترتفع للأعلى

286
00:19:59,520 --> 00:20:00,500
!كرة

287
00:20:01,510 --> 00:20:06,290
أعرف شعور التّعب في منتصف
.الشّوط كهذا حقّ المعرفة

288
00:20:09,920 --> 00:20:11,860
.فقد السّيطرة فجأة

289
00:20:14,950 --> 00:20:16,310
!كلاّ، سوف يسير

290
00:20:16,310 --> 00:20:18,150
!كما أنّ الماسك أسقطها

291
00:20:18,500 --> 00:20:20,370
!تقدّم راكض القاعدة الثّانية إلى الثّالثة

292
00:20:20,370 --> 00:20:22,250
!هنالك الآن راكضان في الأولى والثّالثة

293
00:20:27,160 --> 00:20:31,040
،سُحقًا. لو أنّني أمسكت بها
.ما كنّا لنكون في الثّالثة

294
00:20:31,650 --> 00:20:33,380
.إنّه دور ضاربهم الخامس

295
00:20:33,380 --> 00:20:36,350
كيف نرمي؟ وإلى أين؟

296
00:20:37,290 --> 00:20:39,820
.عليهم أخذ وقت مستقطع

297
00:20:40,770 --> 00:20:42,070
!ساوامورا

298
00:20:42,070 --> 00:20:43,830
!يمكنك تركه يضرب الكرة

299
00:20:44,540 --> 00:20:46,090
!نل منه

300
00:20:46,090 --> 00:20:47,050
!حاضر

301
00:20:48,170 --> 00:20:49,480
!نحن خلفك تمامًا

302
00:20:49,480 --> 00:20:50,310
!ابق قويًّا

303
00:20:50,310 --> 00:20:52,060
!لا تتهاون يا ساوامورا

304
00:20:52,060 --> 00:20:53,430
!تقدّم اللاّعبون الميدانيّون الدّاخليّون

305
00:20:53,430 --> 00:20:55,300
!لا يريدون التّخلّي عن نقطة واحدة

306
00:20:55,690 --> 00:20:57,980
!إنّهم يدعمون ساوامورا

307
00:20:58,560 --> 00:21:02,210
هنا تتجلّى خبرة لاعبي السّنة
.الثّالثة لدعم الرّامي

308
00:21:06,580 --> 00:21:07,800
!كرة طائرة

309
00:21:07,800 --> 00:21:09,410
!ذهبت مباشرة للاعب وسط الميدان

310
00:21:09,640 --> 00:21:10,900
هل هي سطحيّة؟

311
00:21:11,900 --> 00:21:12,610
!انطلق

312
00:21:12,610 --> 00:21:14,500
!لا تذهب لأيّ مكان

313
00:21:14,500 --> 00:21:16,710
!يا مدرّب القاعدة الأعمى

314
00:21:21,570 --> 00:21:23,070
!خروج

315
00:21:23,070 --> 00:21:24,720
!أحسنتم

316
00:21:24,720 --> 00:21:25,920
!أسو-سينباي

317
00:21:25,920 --> 00:21:27,680
!كانت تلك رمية ممتازة

318
00:21:27,680 --> 00:21:31,180
.لا تصرخوا هكذا. هذا ما أفعله دائمًا

319
00:21:31,180 --> 00:21:34,390
!أسو-سينباي، رمية إعادة كرة ممتازة

320
00:21:35,900 --> 00:21:37,530
!كان ذلك مثاليًّا

321
00:21:37,530 --> 00:21:39,880
!أجل، أظهروا بعض الاحترام

322
00:21:40,590 --> 00:21:44,030
.يعرف الجميع مدى جدّيّة ساوامورا حيال هذا

323
00:21:44,030 --> 00:21:45,210
...لهذا السّبب

324
00:21:45,210 --> 00:21:46,760
...نحن لاعبو السّنة الثّالثة

325
00:21:46,760 --> 00:21:48,810
!علينا أن ندعمه

326
00:21:49,160 --> 00:21:50,900
!أجل، حان دورنا للضّرب

327
00:21:50,900 --> 00:21:53,160
!لنحافظ على هذا الزّخم

328
00:21:56,270 --> 00:21:57,400
.مذهل

329
00:21:57,750 --> 00:22:01,720
هؤلاء هم الأشخاص الّذين
.لدى هذا الفريق كاحتياطيّ

330
00:22:04,150 --> 00:22:06,100
!أحسنت يا أسو-سينباي

331
00:22:13,570 --> 00:22:14,870
".تعبير"

332
00:23:45,260 --> 00:23:47,770
.آسف. أسحب ملاحظاتي السّابقة

333
00:23:47,770 --> 00:23:53,120
لنتوقّع عن رمي الأرقام غير المنظّمة
.ونركّز باقي قوّتك على الكرات السّريعة

334
00:23:53,120 --> 00:23:56,820
أنت واثق كعادتك وبما يكفي
.لتقول لزميل أكبر أن يغادر

335
00:23:56,820 --> 00:23:58,970
تريد مناقشة ذلك الآن فعلاً؟

336
00:23:59,790 --> 00:24:01,700
!هذا إطراء في الحقيقة

337
00:24:01,700 --> 00:24:05,170
.بقيت ثلاثة أشواط
!أعتمد عليك يا شريك

338
00:24:05,170 --> 00:24:06,490
.إن مات، نموت جميعًا

339
00:24:06,490 --> 00:24:08,610
.لا بأس. لن أسمح بموت أحد

340
00:24:09,070 --> 00:24:11,370
في الحلقة القادمة من
:اللاّعب الماسيّ الأوّل"، الفصل الثّاني"

341
00:24:11,370 --> 00:24:13,230
".مصير مشترك"

342
00:24:13,230 --> 00:24:15,290
!لنفز باللّقب الوطنيّ