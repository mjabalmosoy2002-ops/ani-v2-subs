1
00:00:06,680 --> 00:00:07,980
!الكرة الرّابعة

2
00:00:08,600 --> 00:00:13,270
بعد خروج واحد، يدفع ساوامورا
!الضّارب الثّامن هيغاشياما للسّير

3
00:00:14,730 --> 00:00:18,240
!هذا سيره الرّابع في المباراة

4
00:00:19,030 --> 00:00:23,700
لا يسمح ساوامورا في العادة
.بسير الكثير من الضّاربين

5
00:00:24,290 --> 00:00:26,120
،إنّه متوتّر

6
00:00:26,120 --> 00:00:29,460
وعلى الأرجح أنّ السّبب تفكيره
.في هيغاشياما-كُن بما أنّه لاعبهم الأوّل

7
00:00:30,670 --> 00:00:32,540
ما الّذي أفعله؟

8
00:00:32,960 --> 00:00:35,050
.لا يستطيع ركوب إيقاع ثابت

9
00:00:35,050 --> 00:00:38,010
،إن كان الدّفاع يتداعى
.فسيضغط ذلك على الضّاربين

10
00:00:38,010 --> 00:00:40,220
.إنّه متوتّر ولا يستطيع الرّمي كما يجب

11
00:00:40,220 --> 00:00:42,720
!هكذا تخسر فرق المدارس القويّة

12
00:00:43,140 --> 00:00:47,520
لكن ما زال لديكم كاواكامي
.وحده في منطقة التّسخين

13
00:00:48,430 --> 00:00:51,440
لا يقوم فورويا بتسخين كتفه
.على الإطلاق

14
00:00:52,480 --> 00:00:54,690
أواثق أنّها فكرة جيّدة يا تيشّين؟

15
00:00:54,690 --> 00:00:58,990
،إن كنتَ تنظر لفوق فحسب
.فستتعثّر لا محالة

16
00:01:02,620 --> 00:01:04,490
ماذا؟ معقول؟

17
00:01:06,490 --> 00:01:08,120
سيغيّرون الرّامي؟

18
00:01:08,370 --> 00:01:09,750
!الآن؟

19
00:01:10,290 --> 00:01:11,750
!أيّها المدرّب كاتاوكا

20
00:01:11,750 --> 00:01:14,380
تـ-تخلّى عن ساوامورا؟

21
00:01:17,880 --> 00:01:19,130
!ما زلنا في الشّوط الرّابع

22
00:01:19,130 --> 00:01:20,510
!إنّه اللاّعب الأوّل

23
00:03:07,070 --> 00:03:08,240
.ساوامورا

24
00:03:15,920 --> 00:03:18,420
.ندرك ما تشعر به جميعنا

25
00:03:19,380 --> 00:03:21,630
هلاّ سمحتَ لنا بإنهاء هذا من أجلك؟

26
00:03:48,530 --> 00:03:49,910
.وضعتُ فيها كلّ شيء

27
00:03:56,040 --> 00:03:57,460
...ساوامورا

28
00:03:58,080 --> 00:03:59,880
...ساوامورا-سينباي

29
00:04:04,130 --> 00:04:08,010
.لم أرد منحهم المزيد من الثّغرات

30
00:04:11,220 --> 00:04:13,600
.لندعهم ينهون هذه المباراة

31
00:04:26,240 --> 00:04:29,820
ماذا؟ لم تقم بالإحماء حتّى؟

32
00:04:29,820 --> 00:04:32,410
.نعم، عدتَ أبكر ممّا توقّعت

33
00:04:32,990 --> 00:04:34,200
.سأقوم بالإحماء قريبًا

34
00:04:36,410 --> 00:04:39,170
.ساوامورا-سينباي، سأساعدك لتبرد

35
00:04:43,040 --> 00:04:44,920
.حسنًا، شكرًا لك

36
00:04:45,920 --> 00:04:48,090
.لكن بمجرّد أن ينتهي هذا الشّوط

37
00:04:54,720 --> 00:04:58,180
!بدأت المباراة الحقيقيّة للتّوّ

38
00:04:58,480 --> 00:05:02,860
!سيدو فريق كرة قاعدة أفضل من هذا

39
00:05:03,360 --> 00:05:06,320
!لا يوجد من يُبطئكم الآن

40
00:05:06,320 --> 00:05:08,740
!لا مزيد من التّهاون

41
00:05:09,070 --> 00:05:12,070
!تقدّموا وقدّموا ما لديكم

42
00:05:13,240 --> 00:05:15,620
،كانت رمياته تفتقر للسّرعة

43
00:05:15,620 --> 00:05:18,580
.لكنّه حمل كلّ شيء على عاتقه

44
00:05:22,290 --> 00:05:23,040
.نعم

45
00:05:24,340 --> 00:05:26,920
.أردتُ القيام بالمزيد من أجله

46
00:05:28,380 --> 00:05:29,300
.نعم

47
00:05:31,630 --> 00:05:34,600
.ظننتُ أنّك ستبقيه لوقت أطول قليلاً

48
00:05:35,050 --> 00:05:38,100
.ها قد قمتَ بحركتك يا تيشّين

49
00:05:38,850 --> 00:05:41,690
هل غيّرت الرّاميين لأنّك خفت؟

50
00:05:42,310 --> 00:05:44,610
أم أنّه كان قرارًا حازمًا؟

51
00:05:46,320 --> 00:05:49,860
!في كلتا الحالتين، فهذه فرصتنا للهجوم

52
00:05:53,990 --> 00:05:59,790
إن استطعنا تحطيمه، فسيكون
.ذلك ضربة قاضية لفريقك

53
00:06:01,540 --> 00:06:04,670
.إنّه راميهم، لذلك لا أعتقد أنّه سيركض

54
00:06:05,670 --> 00:06:07,630
.سأهتمّ بالرّاكض

55
00:06:08,130 --> 00:06:10,630
.ركّز أنت على الضّارب يا نوري

56
00:06:12,630 --> 00:06:16,800
!كن منتبهًا يا نوري-سينباي
!إنّهم يلوّحون في أوّل رمية

57
00:06:17,970 --> 00:06:19,180
...ساوامورا

58
00:06:25,150 --> 00:06:26,360
.وضعتُ فيها كلّ شيء

59
00:06:27,270 --> 00:06:29,400
.حظًّا موفّقًا يا ساوامورا

60
00:06:30,860 --> 00:06:32,110
.شكرًا لك

61
00:06:32,780 --> 00:06:35,410
...نحن لاعبو السّنة الثّالثة

62
00:06:39,660 --> 00:06:41,160
!إصابة

63
00:06:43,580 --> 00:06:46,290
!لذلك ليس لدينا ما نخسره

64
00:06:47,670 --> 00:06:48,710
!أجل

65
00:06:48,710 --> 00:06:50,920
!رمية جيّدة

66
00:06:50,920 --> 00:06:52,670
!نل منهم يا نوري

67
00:06:52,670 --> 00:06:53,670
!نوري-سينباي

68
00:06:53,670 --> 00:06:57,970
.لم أكن أتوقّع ذلك في رميته الأولى

69
00:06:58,930 --> 00:07:04,440
جعل ضارب أيمن يراقب رمية منزلقة
.خارجيّة تمرّ أمامه أمر قاسٍ فحسب

70
00:07:04,440 --> 00:07:08,810
أراهن أنّ ذلك الماسك الذّكيّ
سيطلب رمية داخليّة تاليًا

71
00:07:08,810 --> 00:07:11,940
.لإظهار أنّ بإمكانهم استعمال كلّ الزّوايا

72
00:07:12,570 --> 00:07:15,450
!اضرب تلك الرّمية

73
00:07:19,080 --> 00:07:21,740
!كـ-كرة منزلقة داخليّة

74
00:07:21,740 --> 00:07:24,500
!ر-رمية أماميّة؟

75
00:07:25,500 --> 00:07:26,580
!خروج

76
00:07:26,580 --> 00:07:28,000
!أجل

77
00:07:36,260 --> 00:07:38,300
!إصابة! خروج ضارب

78
00:07:38,300 --> 00:07:40,300
!تلويه وإخفاق، إصابة ثالثة

79
00:07:40,680 --> 00:07:43,310
بعد أن حلّقت ضربة الضّارب التّاسع
،أوكويوشي-كُن بسرعة للسّادسة

80
00:07:43,520 --> 00:07:46,810
!يخرج الضّارب الأوّل موموسي برمية هاوية

81
00:07:47,020 --> 00:07:50,310
عرقل الرّامي الاحتياطيّ فريق
!يورا سوغو بالكامل

82
00:07:50,310 --> 00:07:53,780
إنّه ثنائيّ الضّارب والماسك لكاواكامي
!وميوكي من السّنة الثّالثة

83
00:07:56,950 --> 00:07:59,320
.هيّا بنا يا يوي الصّغير

84
00:07:59,320 --> 00:08:00,320
!حاضر

85
00:08:02,410 --> 00:08:06,040
.انتظر ليرى كيف يرمي اللاّعب الأكبر

86
00:08:07,960 --> 00:08:08,670
!نوري

87
00:08:08,670 --> 00:08:09,540
!رمية جيّدة

88
00:08:09,540 --> 00:08:10,710
!نوري-سينباي

89
00:08:11,130 --> 00:08:15,590
تلك الرّمية الأماميّة الّتي تنحرف من
...منطقة الكرة إلى منطقة الإصابة

90
00:08:15,590 --> 00:08:18,430
إنّ كاواكامي-كُن كان يرميها ضدّ
ضاربين أيامن منذ الخريف، صحيح؟

91
00:08:18,430 --> 00:08:23,720
نعم، ويستعمل كرات سريعة خارجيّة
.وهاوية ضدّ الضّاربين العُسر

92
00:08:24,270 --> 00:08:28,480
.تريد سيدو الاستحواذ على الزّخم من يورا

93
00:08:29,020 --> 00:08:32,150
.أدّى دوره على أحسن وجه

94
00:08:32,730 --> 00:08:36,820
واضح أنّ ميوكي-كُن كان يقوم
.بقرارات جريئة احترازًا منهم

95
00:08:39,110 --> 00:08:43,740
ومع ذلك، اضطرّت الدّكّة
.للقيام بقرار التّغيير

96
00:08:45,080 --> 00:08:47,660
كيف سيكون الوضع في بقيّة المباراة؟

97
00:08:48,910 --> 00:08:52,210
.إنّهم يخفون أكثر ممّا يعلنون
أكان ذلك الرّامي الاحتياطيّ؟

98
00:08:52,210 --> 00:08:53,500
.هيغاشياما

99
00:08:54,250 --> 00:08:59,510
رميت جيّدًا في آخر شوط، لكن حافظ
.على رمياتك المنزلقة خارج منطقة الإصابة

100
00:09:00,220 --> 00:09:05,260
دعهم يتذكّرون أنّه ما زال
.بإمكانك الرّمي فحسب

101
00:09:05,680 --> 00:09:06,600
!حاضر

102
00:09:07,890 --> 00:09:09,100
.النّصف الثّاني من الشّوط الرّابع

103
00:09:09,100 --> 00:09:11,310
.ستقون ثانويّة سيدو بالضّرب

104
00:09:12,860 --> 00:09:16,440
.الضّارب الرّابع، الماسك ميوكي-كُن

105
00:09:34,000 --> 00:09:36,130
.لديه حضور مميّز

106
00:09:42,180 --> 00:09:43,090
!كرة

107
00:09:45,680 --> 00:09:47,430
.كان أوّل رمياته منزلقة

108
00:09:47,430 --> 00:09:49,480
.لكنّهم جعلوه يسير آخر مرّة

109
00:09:49,480 --> 00:09:52,310
لا يوجد راكضون. فكيف سيهاجمون؟

110
00:09:52,310 --> 00:09:55,230
.لا أحبّ كيف شاهد تلك تمرّ أمامه

111
00:09:55,980 --> 00:09:59,820
.لا تضغط على نفسك. تأهّب

112
00:09:59,820 --> 00:10:02,610
.أعطه رمية سهلة وسيلتهم الطُّعم

113
00:10:03,320 --> 00:10:05,620
.خارجًا حيث لا يمكنه الوصول

114
00:10:10,660 --> 00:10:13,790
.قبل سنتين، لم أتخيّل أبدًا أن أتواجد هنا

115
00:10:16,090 --> 00:10:19,170
.هنالك الكثير لتعلّمه والتّفكير فيه

116
00:10:19,670 --> 00:10:22,130
علينا قراءة كلّ هذا؟

117
00:10:22,130 --> 00:10:24,840
!سنقوم بالتّدريب على بعض الاحتمالات

118
00:10:24,840 --> 00:10:28,140
.تركتنا التّدريبات اليوميّة الشّديدة متعبين

119
00:10:28,810 --> 00:10:31,640
.لكن انظروا إلى أين وصلنا

120
00:10:31,980 --> 00:10:37,020
!تعتبرنا سيدو تهديدًا لها بالفعل

121
00:10:37,980 --> 00:10:39,400
!أعشق هذا

122
00:10:51,580 --> 00:10:53,910
!خارج الملعب

123
00:10:53,910 --> 00:10:57,920
أصبح هنالك تعادل ثانية
!بعد ضربة واحدة من المدفع

124
00:11:04,130 --> 00:11:05,590
!اركض

125
00:11:15,020 --> 00:11:17,520
.كرات السّريعة جيّدة

126
00:11:17,520 --> 00:11:20,400
.لكنّ كراته المنزلقة ليست بنفس المستوى

127
00:11:20,400 --> 00:11:23,070
سنعتاد عليها حتّى
.إن كانت لدينا إصابتان

128
00:11:23,320 --> 00:11:27,280
يريدنا أن نتفاعل مع مناوراته
.ونبالغ في التّفكير حيال أنفسنا

129
00:11:27,280 --> 00:11:32,200
تجاهلوا الرّميات المخادعة
.ولوّحوا للتّي يمكنكم ضربها

130
00:11:32,450 --> 00:11:34,710
.العبوا كما تلعبون عادة فحسب

131
00:11:34,710 --> 00:11:35,660
!حاضر

132
00:11:36,460 --> 00:11:39,460
.ضرب آخر ضاربين كراته السّريعة

133
00:11:42,670 --> 00:11:44,590
!سيجعله ذلك متوتّرًا

134
00:11:45,930 --> 00:11:48,340
!ضُربت الكرة المنزلقة إلى خطّ الحدّ الأيمن

135
00:11:48,640 --> 00:11:51,680
يصل راكض القاعدة الثّانية
!مايزونو إلى الثّالثة

136
00:11:51,680 --> 00:11:53,680
ثانويّة سيدو في الصّدارة بعد نجاح

137
00:11:53,680 --> 00:11:56,690
الضّارب السّادس توجو
!في القيام بضربة مزدوجة

138
00:11:56,690 --> 00:11:58,980
!أجل يا توجو-سينباي

139
00:11:58,980 --> 00:11:59,770
!أجل

140
00:11:59,770 --> 00:12:00,400
!زونو

141
00:12:00,400 --> 00:12:01,520
!ضربة ممتازة يا زونو

142
00:12:01,520 --> 00:12:02,610
!أحسنت الضّرب

143
00:12:02,610 --> 00:12:04,530
!أجل، واصل

144
00:12:05,400 --> 00:12:06,990
.هذا هو مدفع القائد

145
00:12:07,280 --> 00:12:09,910
.تلويحة واحدة وقلبت المباراة لصالحنا

146
00:12:09,910 --> 00:12:11,490
.دورة كاملة ممتازة

147
00:12:14,750 --> 00:12:19,000
.لا يحمل اللاّعب الأوّل الفريق وحده

148
00:12:43,270 --> 00:12:46,690
يلتقط لاعب الارتكاز إيتشيكورا
!الكرة لكن لا يستطيع رميها

149
00:12:48,950 --> 00:12:51,200
.إنّه دور الضّارب التّاسع كاواكامي

150
00:12:51,200 --> 00:12:52,570
هل سيجرّبون مناورة ضغط؟

151
00:12:52,570 --> 00:12:53,950
.هذا واضح

152
00:12:53,950 --> 00:12:56,000
.سيكونون متأهّبين لها

153
00:12:56,000 --> 00:12:58,830
.سيكون الوضع سيّئًا حقًا إن فشلت

154
00:12:58,830 --> 00:13:01,210
.سيوقف ذلك زخمهم

155
00:13:01,210 --> 00:13:07,840
سيمنحهم التّصرّف بحذر شديد
.ورمي الكرات خيارات أكثر

156
00:13:08,220 --> 00:13:10,720
.تجاهل راكض القاعدة الأولى

157
00:13:10,720 --> 00:13:13,800
.ركّز نظرك على راكض القاعدة الثّالثة

158
00:13:14,470 --> 00:13:17,810
خروج واحد وراكضان على الأولى والثّالثة
.في النّصف الثّاني من الشّوط الأوّل

159
00:13:17,810 --> 00:13:20,270
!إنّه دور الضّارب التّاسع كاواكامي

160
00:13:20,560 --> 00:13:22,770
...كيف ستهاجم سيدو

161
00:13:22,770 --> 00:13:25,020
وكيف ستوقفها يورا سوغو؟

162
00:13:26,190 --> 00:13:28,240
!ينطلق راكض القاعدة الأولى

163
00:13:30,150 --> 00:13:32,780
كانت الرّمية الأولى رمية
!سريعة داخليّة. خطأ

164
00:13:33,320 --> 00:13:36,450
.ركض وضرب؟ لقد لوّح لها

165
00:13:36,450 --> 00:13:41,040
نعم. يرمي هيغاشياما-كُن كراته
.السّريعة المُعتمد عليها

166
00:13:42,580 --> 00:13:45,960
انطلق راكض القاعدة الأولى
،لمنع حدوث لعبة مزدوجة

167
00:13:45,960 --> 00:13:48,420
وانطلق راكض القاعدة الثّالثة
.بعد رمية أرضيّة

168
00:13:48,420 --> 00:13:49,510
!هذه الرّمية الثّانية

169
00:13:53,430 --> 00:13:54,550
!كرة

170
00:13:54,550 --> 00:13:55,930
.ضربة مخفّفة مزيّفة

171
00:13:55,930 --> 00:13:57,970
.تدري سيدو كيف تخدعه في الفعل

172
00:13:58,430 --> 00:14:00,730
.يا لها من استراتيجيّة واضحة

173
00:14:00,730 --> 00:14:02,520
هل علينا الرّمي؟

174
00:14:03,440 --> 00:14:07,230
لا، ستكون مناورة الضّغط
.لصالحنا أكثر

175
00:14:08,730 --> 00:14:11,450
.كلاّ، لا تفقد تركيزك

176
00:14:11,740 --> 00:14:15,320
.لا نريدهم أن يحصلوا على كرات عدّة

177
00:14:18,290 --> 00:14:23,210
!ضغط أو ضرب، سنرمي لمنطقة الإصابة

178
00:14:23,500 --> 00:14:26,210
.نحتاج فقط لكرة خاطئة أو إصابة

179
00:14:26,210 --> 00:14:27,960
!انطلق راكض القاعدة الأولى

180
00:14:27,960 --> 00:14:30,210
!اركض كما تشاء

181
00:14:32,340 --> 00:14:34,510
!لقد ارتدّت

182
00:14:34,970 --> 00:14:37,810
!يسجّل راكض القاعدة الثّالثة في الحال

183
00:14:37,810 --> 00:14:41,810
نجحت استراتيجيّة سيدو العدائيّة
!وسجّلوا نقطتهم الثّالثة في الشّوط

184
00:14:43,020 --> 00:14:44,560
أتصدّقون ذلك؟

185
00:14:44,560 --> 00:14:49,190
جعل ضاربهم التّاسع تلك الرّمية
.الدّاخليّة ترتدّ لليمين

186
00:14:49,190 --> 00:14:51,650
.كانت بداية راكض القاعدة الثّالثة جيّدة

187
00:14:51,650 --> 00:14:54,070
ما نوع التّداريب الّتي خاضوها؟

188
00:14:57,620 --> 00:14:59,160
.لنستعدّ

189
00:14:59,160 --> 00:15:03,210
.قد تنتهي هذه المباراة أبكر ممّا ظننّا

190
00:15:30,980 --> 00:15:33,320
!أجل

191
00:15:33,740 --> 00:15:36,410
،وضعت يورا سوغو راكضًا على القاعدة

192
00:15:36,410 --> 00:15:38,660
لكن لم يتمكّنوا من المتابعة
!ولم يسجّلوا

193
00:15:38,660 --> 00:15:42,240
لا يمنحهم الرّامي الاحتياطيّ كاواكامي
!من السّنة الثّالثة أيّ ثغرات

194
00:15:42,490 --> 00:15:45,620
!رمية ممتازة يا نوري! أنت لا تُقهر

195
00:15:45,620 --> 00:15:47,500
!أحسنت يا نوري-سينباي

196
00:15:47,790 --> 00:15:50,000
!لنعد إلى الدّكّة

197
00:15:50,000 --> 00:15:51,250
.نعم

198
00:15:51,250 --> 00:15:53,090
.فورويا-سان، علينا الذّهاب أيضًا

199
00:15:53,090 --> 00:15:54,670
.قمتُ بالإحماء

200
00:15:54,670 --> 00:15:56,380
!أنت الرّامي الأوّل غدًا

201
00:15:56,760 --> 00:15:58,760
!رمية جيّدة يا نوري-سينباي

202
00:15:58,760 --> 00:16:00,010
.شكرًا لك

203
00:16:00,010 --> 00:16:03,100
.إنّ لدى ضاربيهم الأساسيّين تلويحات قويّة

204
00:16:03,100 --> 00:16:06,980
نعم، لا نريد فعلاً أن يوجد لاعبون في
.القواعد عندما يحين دور ضاربهم الرّابع

205
00:16:07,480 --> 00:16:11,060
.لا ندري ما قد يحاولون فعله

206
00:16:15,030 --> 00:16:16,070
!حسنًا

207
00:16:16,780 --> 00:16:19,490
.نوري، لقد غيّروا الرّامين

208
00:16:20,740 --> 00:16:21,950
.أنت محقّ

209
00:16:21,950 --> 00:16:25,750
.إنّه الرّقم 12، أوسو من السّنة الثّانية

210
00:16:25,750 --> 00:16:27,620
.أظهروا كلّ راميهم

211
00:16:27,620 --> 00:16:29,580
،يرمي كرات سريعة في الأساس
.إضافة لكرات شوكيّة

212
00:16:29,580 --> 00:16:32,790
لكنّ كراته السّريعة ليست بجودة
.كرات لاعبهم الأوّل

213
00:16:32,790 --> 00:16:36,260
،إن استطعنا ضرب بضع رمياته
!فلن تعود لديهم خيارات

214
00:16:36,590 --> 00:16:38,220
!بقيت أربعة أشواط فقط

215
00:16:38,220 --> 00:16:39,590
!لننهِ الأمر

216
00:16:39,590 --> 00:16:40,640
!نوري-سينباي

217
00:16:40,640 --> 00:16:42,640
!اخرج إلى هناك ولوّح يا نوري

218
00:16:48,140 --> 00:16:52,270
.لا يحمل اللاّعب الأوّل الفريق وحده

219
00:16:57,070 --> 00:16:58,400
.سُحقًا

220
00:17:00,200 --> 00:17:03,330
.ليتني أستطيع إعادة هذه المباراة

221
00:17:18,550 --> 00:17:21,800
،بعد ضربة وقاعدة مسروقة
.وصل كوراموتشي للقاعدة الثّانية

222
00:17:22,390 --> 00:17:25,060
ثمّ قام كوميناتو بضربة ناجحة
.أمام لاعب الميدان الأوسط

223
00:17:26,560 --> 00:17:28,810
،في الرّمية الثّالثة في عدّ 1-1

224
00:17:28,810 --> 00:17:31,400
جهّز راكضا القاعدتين الأولى
.والثّالثة لركض وضرب

225
00:17:32,900 --> 00:17:37,400
ضحّى الضّارب الرّابع ميوكي بكرة طائرة
.عزّزت مكان سيدو في الطّليعة بستّ نقاط

226
00:17:38,320 --> 00:17:40,200
!أجل، رمية ممتازة

227
00:17:40,200 --> 00:17:42,320
!لنحرز نقاطنا الواحدة تلو الأخرى

228
00:17:42,320 --> 00:17:47,830
لماذا جميعكم سعداء؟
.إنّهم الفارق بيننا يتزايد

229
00:17:47,830 --> 00:17:51,790
حسنًا، إنّ ضاربيهم ولاعبيهم الميدانيّين
.لا يمنحوننا أيّ ثغرات

230
00:17:52,290 --> 00:17:54,580
.إنّهم مذهلون بالفعل

231
00:17:54,580 --> 00:17:57,920
بإمكاني أن أرى ما كنتَ تحاول
.فعله أيّها المدرّب

232
00:17:57,920 --> 00:18:01,090
.ذلك واضح من لعب سيدو

233
00:18:01,090 --> 00:18:04,050
.أشعر أنّ مشاهدتنا لهم ستحسّن من لعبنا

234
00:18:04,050 --> 00:18:05,600
.رغم كرهي لقول ذلك

235
00:18:08,100 --> 00:18:09,270
!آسفون

236
00:18:09,270 --> 00:18:12,100
.تأخّر الوقت على أن ينفعنا ذلك

237
00:18:12,100 --> 00:18:14,560
أريد العودة لقراءة دفتر ملاحظات
.ساكاكي ثانية

238
00:18:14,560 --> 00:18:15,360
!وأنا أيضًا

239
00:18:15,360 --> 00:18:17,610
!ما زلنا نلعب! بالإمكان فعل ذلك لا حقًا

240
00:18:17,610 --> 00:18:19,030
!أحضرت دفتري

241
00:18:19,030 --> 00:18:20,320
!أحضرته معك؟

242
00:18:20,320 --> 00:18:22,030
نعم، ألم يحضره الجميع؟

243
00:18:23,110 --> 00:18:24,570
.اسمعوا

244
00:18:25,660 --> 00:18:27,620
.لم يفت الأوان بعد

245
00:18:28,040 --> 00:18:31,000
.بإمكانك أن تبدؤوا الآن

246
00:18:34,620 --> 00:18:38,210
!إنّ لعبة واحدة أو رمية واحدة تكفي

247
00:18:38,210 --> 00:18:41,420
!أروهم ما لديكم

248
00:18:41,420 --> 00:18:45,510
!هنا تصبح كرة القاعدة ممتعة

249
00:18:45,930 --> 00:18:47,100
!حاضر

250
00:18:50,140 --> 00:18:51,930
،وفي النّصف الثّاني من الشّوط السّابع

251
00:18:53,850 --> 00:18:57,810
كانت ضربة هذا اللاّعب
!هي ما حدّدت مصير المباراة

252
00:19:04,910 --> 00:19:08,910
سجّل الضّارب السّابع يوكي نقطته
!العاشرة بالدّورة الكاملة ذات النّقطتين

253
00:19:11,240 --> 00:19:12,660
!تمّ تحديد المباراة في شوطها السّابع

254
00:19:13,080 --> 00:19:17,170
!تقدّمت ثانويّة سيدو للجولة الرّابعة

255
00:19:25,180 --> 00:19:26,680
!شكرًا لكم

256
00:19:31,720 --> 00:19:32,930
.شكرًا لك

257
00:19:32,930 --> 00:19:38,020
أنا مسرور للعبي آخر مباراة كرة
.قاعدة لي  ضدّ فريق كسيدو

258
00:19:38,940 --> 00:19:40,690
عمّ تتحدّث؟

259
00:19:40,690 --> 00:19:42,730
!كنّا في وضع حرج في الأشواط الأولى

260
00:19:42,730 --> 00:19:44,570
.قاتلتم ببسالة

261
00:19:44,860 --> 00:19:47,910
بالمناسبة، هل عرفتم ما القرارات
الّتي كنتُ سأتّخذها؟

262
00:19:48,620 --> 00:19:50,330
ذلك رائع، صحيح؟

263
00:19:50,330 --> 00:19:52,700
.إنّ مدرّبنا وحشُ كرة قاعدة

264
00:19:52,700 --> 00:19:53,910
فعلاً؟

265
00:19:53,910 --> 00:19:56,750
لكن لم نستطع الضّرب حتّى وإن عرفنا
.ما ينتظرنا في النّصف الثّاني من المباراة

266
00:19:57,420 --> 00:19:59,710
!اهزموا إيناشيرو والعبوا في ملعب كوشيين

267
00:19:59,710 --> 00:20:00,840
!نعم

268
00:20:00,840 --> 00:20:03,710
!شكرًا لكم على سنواتكم الثّالثة من كرة القاعدة

269
00:20:03,710 --> 00:20:05,340
ما الّذي تفعله؟

270
00:20:05,670 --> 00:20:08,590
كانت يورا تتحكّم في المباراة
،في الأشواط الأولى

271
00:20:08,590 --> 00:20:11,350
.لكنّ سيدو لم تتردّد

272
00:20:11,350 --> 00:20:15,060
.كانت مباراتهم الأولى وبداية لاعبهم الأوّل

273
00:20:15,600 --> 00:20:19,230
سنرى كيف سيتعلّم ساوامورا-كُن
.من هذه التّجربة

274
00:20:19,600 --> 00:20:23,110
.نعم، كما أنّ فورويا-كُن لم يرمِ به

275
00:20:23,440 --> 00:20:25,360
.إنّها أولى الخطوات فحسب

276
00:20:25,360 --> 00:20:31,120
بدأ كلّ من ياكوشي وإيناشيرو وثانويّة
.إيتشيداي الثّالثة وسيدو بداية قويّة

277
00:20:38,460 --> 00:20:41,080
.نلت منّا

278
00:20:41,080 --> 00:20:44,130
أظهر فريقك الكثير من الإمكانيّات
.في النّهاية بالفعل

279
00:20:44,130 --> 00:20:48,090
نعم، حافظ الفريق على رباطة
.جأشه وقاتل جيّدًا

280
00:20:48,090 --> 00:20:54,720
ظننتُ أنّك ستترك الرّامي الأوّل لمدّة أطول
.بما أنّ فورويا لم يكن في منطقة التّسخين

281
00:20:54,720 --> 00:20:56,890
.كان قرارك في محلّه

282
00:20:56,890 --> 00:21:02,270
،ساوامورا هو لاعبنا الأوّل
.لذلك أردت تغييره في وقت جيّد

283
00:21:02,270 --> 00:21:05,900
كان لدينا رامٍ آخر يقوم بالتّسخين
.منذ الشّوط الأوّل

284
00:21:05,900 --> 00:21:09,400
.قاد لاعبو السّنة الثّالثة الفريق اليوم

285
00:21:10,490 --> 00:21:13,450
،إذًا بدل القيام بمناورات مبنيّة على إشارات

286
00:21:13,450 --> 00:21:16,910
.استطاعوا التّفكير بها بمفردهم

287
00:21:17,250 --> 00:21:22,580
إنّ فريقًا بلاعبين مثلهم
.هو فريق قويّ بحقّ

288
00:21:24,040 --> 00:21:27,920
.شكّلتَ فريقًا جيّدًا يا تيشّين

289
00:21:34,680 --> 00:21:35,970
.إلى اللّقاء

290
00:21:35,970 --> 00:21:39,100
.سيبدأ هذا الجنديّ القديم من جديد

291
00:21:50,240 --> 00:21:51,910
.كدتُ أنسى

292
00:21:52,950 --> 00:21:55,740
...ذلك الرّامي الأوّل

293
00:22:13,130 --> 00:22:14,840
".سيدو تبذل كلّ ما لديها"

294
00:23:49,230 --> 00:23:51,230
.حتّى عطساتك صاخبة للغاية

295
00:23:52,860 --> 00:23:56,700
،ربّما لن تحظى بفرصة غدًا
.لذلك ارمِ بقدر ما تشاء اليوم

296
00:23:56,700 --> 00:23:58,030
ماذا؟ ماذا قلت؟

297
00:23:58,030 --> 00:24:00,660
سأكون في أحسن حال
!لأكون جاهزًا للّعب

298
00:24:00,660 --> 00:24:01,620
.ستحصل على فرصتك

299
00:24:01,620 --> 00:24:03,750
.سأحرص على أن تحصل على فرصة أخرى

300
00:24:03,750 --> 00:24:07,580
أعلمني بأيّ شيء أستطيع فعله
.للمساعدة في أيّ وقت

301
00:24:07,580 --> 00:24:10,420
في الحلقة القادمة من
:اللاّعب الماسيّ الأوّل"، الفصل الثّاني"

302
00:24:10,420 --> 00:24:11,500
".عصر النّار"

303
00:24:11,880 --> 00:24:14,130
!لنفز باللّقب الوطنيّ