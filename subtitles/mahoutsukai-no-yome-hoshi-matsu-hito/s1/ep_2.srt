147
00:15:19,810 --> 00:15:20,810
كتابٌ مصوّر؟

148
00:15:21,180 --> 00:15:27,080
.أشعر أنّك تحتاجين هذا الكتاب بشدّة

149
00:15:28,580 --> 00:15:32,040
والآن، هلّا نظفتِ هذه الكتب لي؟

150
00:15:40,390 --> 00:15:41,410
.إنّها جميلة جدًّا

151
00:17:04,330 --> 00:17:18,050
النجمة الصغيرة الوحيدة، طفلة نجمٍ صغيرة"
".تلألأت في السماء الفارغة لوحدها

152
00:17:39,910 --> 00:17:42,660
.سأعيدها إلى المنزل قبل شروق الشمس

153
00:17:43,370 --> 00:17:44,370
حسنًا؟

154
00:17:45,420 --> 00:17:46,730
.الوداع

155
00:17:46,730 --> 00:17:50,010
.لن تعودي إلى هنا ثانيةً

156
00:19:12,260 --> 00:19:13,500
ميورا-سان؟

157
00:19:30,300 --> 00:19:31,220
ما هذا؟

158
00:19:37,290 --> 00:19:38,060
.لا

159
00:19:39,440 --> 00:19:40,440
كيف؟

160
00:19:43,790 --> 00:19:44,540
—ميورا-سا

161
00:19:44,540 --> 00:19:45,250
كيف؟

162
00:19:45,250 --> 00:19:46,830
!كيف دخلتِ؟

163
00:19:46,830 --> 00:19:47,440
لماذا؟

164
00:19:50,010 --> 00:19:51,430
.أنا آسفة

165
00:19:55,160 --> 00:19:56,420
أنتِ، الباب

166
00:19:57,250 --> 00:19:58,350
.أنا آسفة

167
00:20:18,460 --> 00:20:19,590
!لا

168
00:20:20,520 --> 00:20:21,940
!ليس هذا الكتاب

169
00:20:33,910 --> 00:20:35,720
!بسرعة، تعالي إلى هنا

170
00:20:36,210 --> 00:20:37,210
...ميورا-سان

171
00:20:44,600 --> 00:20:45,590
...أنتِ

172
00:20:46,620 --> 00:20:47,570
!بسرعة

173
00:20:47,570 --> 00:20:49,880
!بسرعة، اركضي

174
00:20:49,880 --> 00:20:51,500
...ميورا-سان

175
00:20:53,100 --> 00:20:54,700
!بسرعة

176
00:21:06,200 --> 00:21:07,710
.صباح الخير

177
00:21:10,920 --> 00:21:11,730
.صباح الخير

178
00:21:12,210 --> 00:21:13,850
.سأعيرك هذا

179
00:21:16,860 --> 00:21:18,250
...مـ-مايومي-سان

180
00:21:18,250 --> 00:21:19,870
