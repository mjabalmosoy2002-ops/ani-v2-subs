1
00:00:08,460 --> 00:00:10,990
كيف وجدته هذه المرّة؟

2
00:00:10,990 --> 00:00:12,700
...ربّما

3
00:00:12,700 --> 00:00:15,030
.يحتاج للمزيد من التّوابل

4
00:00:16,460 --> 00:00:17,830
...فهمت

5
00:00:19,140 --> 00:00:20,960
!كلاّ، لا يمكننا الاستسلام

6
00:00:32,420 --> 00:00:33,470
والآن؟

7
00:00:47,050 --> 00:00:48,960
.لا أريدها أن تبكي ثانية

8
00:00:49,650 --> 00:00:53,370
.أريد أن تبتسم شيروها-تشان دائمًا

9
00:01:13,920 --> 00:01:18,430
جيوب صيف

10
00:02:32,610 --> 00:02:34,540
...إنّه يشبه مذاق طبق أبي

11
00:02:35,700 --> 00:02:38,250
!هذا هو نفس مذاق طبق أبي

12
00:02:42,640 --> 00:02:44,220
!أجل

13
00:02:44,220 --> 00:02:46,300
.شكرًا يا نانامي

14
00:02:46,300 --> 00:02:50,230
.لا داعي للشّكر
!إنّه نِتاج عملنا الجادّ يا شيروها-تشان

15
00:02:52,070 --> 00:02:55,900
.سأتذوّقه الآن لأرى كيف هو طبق والدك

16
00:03:02,300 --> 00:03:03,620
نانامي؟

17
00:03:05,520 --> 00:03:07,030
...أشعرني بالحنين

18
00:03:08,700 --> 00:03:09,830
...أشعر وكأنّني

19
00:03:10,880 --> 00:03:13,130
.أكلته من قبل في مكان ما

20
00:03:16,920 --> 00:03:18,200
...لكن ما الّذي

21
00:03:20,870 --> 00:03:22,570
.اهدئي

22
00:03:22,570 --> 00:03:25,770
.أنا هنا إلى جانبك يا نانامي

23
00:03:29,680 --> 00:03:30,930
.شكرًا لك

24
00:03:32,270 --> 00:03:33,900
وما هذا؟

25
00:03:33,900 --> 00:03:35,300
.أرزّ مقلاة

26
00:03:35,300 --> 00:03:37,570
أرزّ مقلاة"؟"

27
00:03:37,570 --> 00:03:39,280
.أعدّته شيروها-تشان

28
00:03:39,500 --> 00:03:40,290
أليس كذلك؟

29
00:03:41,650 --> 00:03:43,310
...لـ-لكن

30
00:03:43,310 --> 00:03:45,450
.أعددته بمساعدة من نانامي

31
00:03:45,730 --> 00:03:47,940
أعدّته شيروها بالفعل؟

32
00:03:48,490 --> 00:03:50,080
أرزّ مقلاة؟

33
00:03:57,790 --> 00:03:59,970
...هذا المذاق

34
00:04:00,360 --> 00:04:01,460
ما معنى هذا؟

35
00:04:02,820 --> 00:04:04,930
.شيروها. لقد حذّرتك

36
00:04:04,930 --> 00:04:07,120
.لا يجب عليك الاقتراب من ذلك المطعم

37
00:04:07,120 --> 00:04:08,570
...لـ-لكن

38
00:04:08,570 --> 00:04:12,050
—أردنا فقط إعادة طبخ طبق أرزّ

39
00:04:12,050 --> 00:04:13,770
!طبق أرزّ والدها

40
00:04:13,770 --> 00:04:15,140
!هذا هراء

41
00:04:16,430 --> 00:04:18,580
...أ-أنا

42
00:04:20,790 --> 00:04:22,020
!آسفة

43
00:04:22,020 --> 00:04:23,330
!شيروها-تشان

44
00:04:26,160 --> 00:04:28,070
لماذا تكلّمها بهذه الطّريقة؟

45
00:04:28,440 --> 00:04:32,330
عملت شيروها-تشان بجدّ
!لأنّها أرادتك أن تتذوّقه

46
00:04:32,330 --> 00:04:33,250
ماذا؟

47
00:04:33,250 --> 00:04:35,900
.قالت أنّك تبدو وحيدًا دائمًا

48
00:04:35,900 --> 00:04:37,430
...ومع ذلك

49
00:04:37,430 --> 00:04:39,890
لماذا حدّثتها بتلك الكلمات الجارحة؟

50
00:04:42,370 --> 00:04:45,380
،لأنّه إن استمرّت شيروها هكذا

51
00:04:45,380 --> 00:04:47,560
.فستظلّ سجينة الماضي

52
00:04:47,560 --> 00:04:49,900
!لا يبدو ذلك كسبب وجيه في نظري

53
00:04:50,570 --> 00:04:52,780
.إنّك تُخفي شيئًا ما

54
00:04:54,850 --> 00:04:57,750
أين هي والدة شيروها-تشان؟

55
00:04:58,620 --> 00:05:02,070
قالت شيروها-تشان أنّها ذهبت
...إلى مكان بعيد ولن تعود

56
00:05:02,240 --> 00:05:05,490
،لكن عندما كانت تطبخ في ذلك المطعم

57
00:05:05,490 --> 00:05:08,630
...بدت سعيدة للغاية

58
00:05:08,630 --> 00:05:11,500
.ومع ذلك أخبرتها ألاّ تذهب إليه

59
00:05:14,050 --> 00:05:15,620
لأيّ سبب؟

60
00:05:15,620 --> 00:05:17,650
...ذلك المكان بالنّسبة لشيروها-تشان

61
00:05:17,650 --> 00:05:21,090
يحمل الكثير من الذّكريات السّعيدة
عن والديها، صحيح؟

62
00:05:24,750 --> 00:05:28,590
.لا تكون الذّكريات جميلة دائمًا

63
00:05:29,270 --> 00:05:32,160
...أخبرتني زوجتي مرّة

64
00:05:32,500 --> 00:05:35,690
.تحمل سلالتنا قوّة غامضة"

65
00:05:35,690 --> 00:05:38,570
".ولتلك القوّة ثمن معيّن يجب دفعه

66
00:05:39,210 --> 00:05:40,950
قوّة؟

67
00:05:40,950 --> 00:05:42,150
ثمن؟

68
00:05:42,950 --> 00:05:47,020
لذلك علينا تجنّب الاعتماد"
."عليها قدر الإمكان

69
00:05:47,510 --> 00:05:49,940
.سألتها ما الّذي تقصده

70
00:05:50,400 --> 00:05:52,280
...لكنّها ضحكت وردّت عليّ قائلة

71
00:05:53,220 --> 00:05:55,960
".لنستمتع بالصّيف فحسب"

72
00:06:00,110 --> 00:06:03,100
.قالت ابنتي نفس الشّيء

73
00:06:03,450 --> 00:06:07,220
".دع شيروها تعيش فصول صيف رائعة"

74
00:06:09,260 --> 00:06:11,590
.ثمّ اختفت كأنّها لم تكن

75
00:06:17,260 --> 00:06:19,820
...فقدت والدين طيّبين

76
00:06:20,140 --> 00:06:22,730
ما الّذي بوسع عجوز عنيد مثلي فعله؟

77
00:06:22,990 --> 00:06:27,740
لا يسعني إلاّ منع شيروها من البقاء
.محاصرة بوالدين ما عادا موجودين

78
00:06:27,740 --> 00:06:29,880
.لهذا السّبب أبعدتها عن ذلك المكان

79
00:06:31,890 --> 00:06:34,740
.اقترفتُ أمرًا شنيعًا بحقّها

80
00:06:35,190 --> 00:06:36,390
...لم أكن

81
00:06:36,980 --> 00:06:39,460
.أنا ممتنّ لك يا نانامي

82
00:06:39,460 --> 00:06:41,450
،فمنذ مجيئك إلى هنا

83
00:06:41,450 --> 00:06:42,950
.بدأت شيروها تستمتع بوقتها كثيرًا

84
00:06:44,590 --> 00:06:48,970
...والد شيروها، زوج ابنتي

85
00:06:49,730 --> 00:06:52,970
.كان ضعيف البنية، لكنّه كان رجلاً طيّبًا

86
00:06:53,470 --> 00:06:57,350
.أحبّ تلك الفتاة المتمرّدة من أعماق قلبه

87
00:06:59,250 --> 00:07:00,850
...لا أدري ما السّبب

88
00:07:01,470 --> 00:07:04,170
لِمَ أنا الوحيد المتبقّي؟

89
00:07:04,580 --> 00:07:06,340
...مجرّد رجل عجوز متهالك

90
00:07:17,490 --> 00:07:18,960
...هذا الصّيف

91
00:07:19,280 --> 00:07:21,740
هل يملؤه الحزن؟

92
00:07:23,190 --> 00:07:26,140
...أتمنّى أن يسعد الجميع في حياتهم، لكن

93
00:07:26,920 --> 00:07:29,750
...كلٌّ من كوباتو-سان وشيروها-تشان

94
00:07:30,940 --> 00:07:32,640
.يجب أن تنتهي هذه القصّة

95
00:07:33,180 --> 00:07:34,530
...ويراودني شعور

96
00:07:36,050 --> 00:07:38,510
.أنّي من ستكون عليها القيام بذلك

97
00:07:39,540 --> 00:07:42,450
لكن... لماذا يراودني هذا الشّعور؟

98
00:07:55,630 --> 00:07:57,700
.أعلم ذلك على الأقلّ

99
00:07:58,090 --> 00:08:00,330
.أعلم ما الّذي تحاولين فعله

100
00:08:00,680 --> 00:08:02,190
...لأنّني

101
00:08:02,190 --> 00:08:02,910
...أنا

102
00:08:05,500 --> 00:08:06,790
...هذه

103
00:08:07,670 --> 00:08:08,980
...إنّ هذه

104
00:08:09,330 --> 00:08:10,920
!ذكرياتي؟

105
00:08:10,920 --> 00:08:15,680
أريد أن نرمي الطّائرات
.الورقيّة من دون شجار

106
00:08:15,680 --> 00:08:17,180
...استعداد

107
00:08:17,450 --> 00:08:19,700
!إطلاق

108
00:08:22,910 --> 00:08:24,270
!اسمعي يا أومي

109
00:08:24,270 --> 00:08:26,980
!قالت شيروها أنّها ستكون أمّك

110
00:08:26,980 --> 00:08:28,940
.مـ-مرحبًا

111
00:08:34,360 --> 00:08:36,380
.حسنًا

112
00:08:36,380 --> 00:08:38,190
.هيّا، ابتسما

113
00:08:39,070 --> 00:08:41,350
.إنّها جميلة جدًّا

114
00:08:41,910 --> 00:08:46,540
.أنا سعيدة جدًّا لرؤية الألعاب النّاريّة
.لقد وفينا بوعدنا

115
00:08:46,800 --> 00:08:50,550
.أتيتُ لرؤية أمّي

116
00:08:50,940 --> 00:08:53,840
.لأنّ أمّي رحلت الآن

117
00:08:54,170 --> 00:08:56,550
.لأنّي لم أعرفها أبدًا

118
00:08:57,510 --> 00:08:58,930
...لذلك

119
00:08:59,900 --> 00:09:02,640
لذلك أتيت لهذه الجزيرة؟

120
00:09:03,790 --> 00:09:06,150
من المستقبل؟

121
00:09:11,580 --> 00:09:13,290
...بالطّبع

122
00:09:13,290 --> 00:09:14,590
...أنا

123
00:09:14,890 --> 00:09:17,530
.أتيتُ إلى هنا من مكان بعيد جدًّا

124
00:09:18,730 --> 00:09:20,380
...في هذا الصّيف

125
00:09:22,660 --> 00:09:24,360
...لإنقاذ شخص

126
00:09:24,880 --> 00:09:26,380
.يعني لي الكثير

127
00:09:38,110 --> 00:09:40,010
.شكرًا جزيلاً

128
00:09:40,010 --> 00:09:42,350
أنت ملاكي الحامي، صحيح؟

129
00:09:43,310 --> 00:09:44,510
...لكن

130
00:09:45,220 --> 00:09:46,850
.لا أمانع هذا

131
00:09:52,830 --> 00:09:54,180
...أنا الآن

132
00:09:55,170 --> 00:09:56,740
.اتّخذتُ قراري

133
00:10:15,100 --> 00:10:16,680
أبي؟

134
00:10:16,680 --> 00:10:18,320
أمّي؟

135
00:10:40,910 --> 00:10:42,210
لماذا؟

136
00:10:42,820 --> 00:10:46,620
لماذا تركتماني وحدي؟

137
00:10:47,980 --> 00:10:49,500
...أبي

138
00:10:49,500 --> 00:10:51,080
...أمّي

139
00:11:01,670 --> 00:11:03,150
فراشة؟

140
00:11:36,260 --> 00:11:38,340
...ذلك الحلم ثانية

141
00:11:41,610 --> 00:11:43,710
ما الّذي كانا ليقولاه؟

142
00:11:51,700 --> 00:11:54,980
يوم الآباء بالنّسبة لشيروها-تشان؟

143
00:11:55,220 --> 00:11:56,200
.نعم

144
00:11:56,200 --> 00:11:57,570
.إنّه غدًا بعد الظّهر

145
00:11:57,920 --> 00:11:58,770
.خذي

146
00:11:59,660 --> 00:12:01,380
.شكرًا جزيلاً لك

147
00:12:02,180 --> 00:12:02,770
ماذا؟

148
00:12:03,070 --> 00:12:05,900
لكن ألسنا في منتصف العطلة الصّيفيّة؟

149
00:12:05,900 --> 00:12:09,730
نحتاج للقناديل من أجل
.مراسم ناتسودوري القادمة

150
00:12:09,730 --> 00:12:11,980
،إنّهم يقيمون دروسًا خاصّة لصناعتها

151
00:12:11,980 --> 00:12:16,040
.ويشارك الآباء أيضًا في العادة

152
00:12:16,360 --> 00:12:17,620
...فهمت، فهمت

153
00:12:17,900 --> 00:12:22,670
قد تكون هذه فرصة ممتازة
!ليقضيا اليوم معًا

154
00:12:22,670 --> 00:12:25,800
.أودّ منك المشاركة يا نانامي

155
00:12:25,800 --> 00:12:27,480
ما...؟ أنا؟

156
00:12:27,480 --> 00:12:29,400
!لا-لا يمكنني

157
00:12:29,400 --> 00:12:31,620
!عليك أنت الذّهاب يا كوباتو-سان

158
00:12:31,620 --> 00:12:35,480
!واثقة أنّ شيروها-تشان ستسعد بذلك أيضًا

159
00:12:35,480 --> 00:12:38,320
رغم أنّها لم تغادر غرفتها منذ تلك اللّيلة؟

160
00:12:41,630 --> 00:12:43,180
...ذلك

161
00:12:44,440 --> 00:12:47,250
...و-ولكن يا كوباتو-سان

162
00:12:47,250 --> 00:12:49,740
...إنّك تعمل بجدّ في المطبخ سلفًا

163
00:12:53,800 --> 00:12:58,490
،كما أنّي إن ذهبت
.فسأخيف بقيّة الأطفال على الأرجح

164
00:13:06,840 --> 00:13:08,800
.في النّهاية، لم أستطع الرّفض

165
00:13:10,110 --> 00:13:12,430
ناتسودوري الصّيف؟

166
00:13:13,180 --> 00:13:15,610
...صنع القناديل معًا

167
00:13:16,480 --> 00:13:18,850
...استمتعتُ بوقتي كثيرًا حينها

168
00:13:20,000 --> 00:13:22,790
...وكانت تلك الرّقصة جميلة

169
00:13:25,550 --> 00:13:26,360
.وجدتُها

170
00:13:27,330 --> 00:13:29,200
...سأخبر شيروها-تشان

171
00:13:29,200 --> 00:13:31,490
.عن ذكريات لذلك الصّيف فحسب

172
00:13:33,090 --> 00:13:36,040
،سأجعل هذه العطلة ممتعة

173
00:13:36,040 --> 00:13:39,010
.مثل الّتي قضيناها معًا نحن الثّلاثة

174
00:13:45,330 --> 00:13:47,330
.حسنًا إذًا، سأغادر الآن

175
00:13:47,330 --> 00:13:48,840
اعتني بالمنزل، مفهوم؟

176
00:13:48,840 --> 00:13:51,220
.نعم، نعم. لا تقلقي

177
00:13:51,220 --> 00:13:53,180
!رافقتك السّلامة

178
00:13:56,060 --> 00:13:59,340
...يا إلهي، تبدو تلك المرأة مشغولة دائمًا

179
00:14:03,570 --> 00:14:05,390
!كلاّ

180
00:14:05,930 --> 00:14:07,280
ثانية؟

181
00:14:10,210 --> 00:14:11,920
.تأخّرت شيروها-تشان

182
00:14:11,920 --> 00:14:13,940
.نوشك أن نبدأ

183
00:14:13,940 --> 00:14:15,250
!ها هي

184
00:14:19,400 --> 00:14:21,630
إنّها ليست مع جدّها؟

185
00:14:21,970 --> 00:14:23,660
...شيروها-تشان

186
00:14:25,670 --> 00:14:28,570
لم أكن أعتقد أنّ هنالك كلّ
...هؤلاء الأطفال في الجزيرة

187
00:14:29,920 --> 00:14:34,010
شيروها-تشان، سنصنع اليوم قناديل
مذهلة، فما قولك؟

188
00:14:34,010 --> 00:14:34,810
.موافقة

189
00:14:36,410 --> 00:14:37,690
،حسنًا يا أطفال

190
00:14:37,690 --> 00:14:40,900
.سأبدأ الآن شرح كيفية صناعة هذه القناديل

191
00:14:40,900 --> 00:14:42,980
!حسنًا

192
00:14:43,280 --> 00:14:47,280
توجد داخل هذه القناديل
.أرواح الأعزّاء علينا

193
00:14:47,550 --> 00:14:50,670
...مثل جدّاتكم أو حتّى قطًّا ربّيتموه يومًا

194
00:14:51,150 --> 00:14:52,440
...شيروها-تشان

195
00:14:52,740 --> 00:14:56,070
.إنّها تحتوي على أرواح الكثيرين

196
00:14:56,070 --> 00:14:57,870
،وفي فصل الصّيف هذا

197
00:14:57,870 --> 00:15:00,580
.سيعودون لفترة وجيزة

198
00:15:00,940 --> 00:15:03,890
،للحرص على أنّكم جميعًا تُبلون حسنًا

199
00:15:03,890 --> 00:15:06,090
.قبل أن يغادروا ثانية في يوم المهرجان

200
00:15:06,280 --> 00:15:09,560
،ولذلك السّبب، وكي لا يضيعون في الظّلام

201
00:15:09,560 --> 00:15:13,800
نشغل هذه القناديل
.ليستطيعوا العودة إلى منازلهم

202
00:15:14,930 --> 00:15:18,060
!حسنًا يا أطفال، لنبدأ العمل

203
00:15:18,060 --> 00:15:20,010
!حسنًا

204
00:15:20,660 --> 00:15:22,100
شيروها-تشان؟

205
00:15:22,780 --> 00:15:24,030
...بالنّسبة لي

206
00:15:24,900 --> 00:15:26,350
.أنا لا أحتاج لهذا

207
00:15:28,190 --> 00:15:31,400
إن صنعتُه، فسيكون الوداع الأخير، صحيح؟

208
00:15:31,400 --> 00:15:33,450
سيغادران، أليس كذلك؟

209
00:15:33,890 --> 00:15:35,780
.أقصد أبي وأمّي

210
00:15:36,430 --> 00:15:37,780
...ذلك

211
00:15:38,080 --> 00:15:39,970
...إذًا فهذا الشّيء

212
00:15:39,970 --> 00:15:41,620
!لا أريده على الإطلاق

213
00:15:51,020 --> 00:15:52,560
...شيروها-تشان

214
00:15:52,560 --> 00:15:53,710
...عفوًا

215
00:15:59,050 --> 00:16:00,670
!شيروها-تشان

216
00:16:04,950 --> 00:16:06,240
.مهلاً رجاءً

217
00:16:06,240 --> 00:16:08,280
ما الّذي فعلته لشيروها-تشان؟

218
00:16:09,260 --> 00:16:10,220
!أنا؟

219
00:16:10,220 --> 00:16:11,220
.لقد رأيتك

220
00:16:11,220 --> 00:16:13,870
.قلتِ شيئًا ما لشيروها-تشان

221
00:16:13,870 --> 00:16:15,460
!أراهن أنّك أخبرتها بشيء فظيع

222
00:16:17,830 --> 00:16:19,880
!كا-كان مجرّد سوء فهم

223
00:16:19,880 --> 00:16:21,100
...أنا أستأذن

224
00:16:21,100 --> 00:16:22,540
!لن ندعك تهربين

225
00:16:22,540 --> 00:16:23,950
ما-ما الّذي تريدونه؟

226
00:16:23,950 --> 00:16:26,410
!كفّي عن تعذيب شيروها-تشان المسكينة

227
00:16:26,580 --> 00:16:28,020
!مهلاً! كلاّ

228
00:16:28,020 --> 00:16:30,290
!هذا مؤلم، أنتم تؤلمونني

229
00:16:50,990 --> 00:16:52,490
...أبي

230
00:16:53,260 --> 00:16:54,800
...أمّي

231
00:16:56,510 --> 00:16:58,780
أين ذهبتما؟

232
00:16:59,060 --> 00:17:00,580
...أمّي

233
00:17:00,580 --> 00:17:02,910
.أريد رؤيتك

234
00:17:02,910 --> 00:17:04,700
...أريد رؤيتك بشدّة

235
00:17:04,970 --> 00:17:06,740
...أمّي

236
00:17:24,340 --> 00:17:25,710
.لقد عدت

237
00:17:30,250 --> 00:17:31,900
هل لدينا ضيوف؟

238
00:17:38,870 --> 00:17:41,080
.تمكّنتُ أخيرًا من المرور لإلقاء التّحيّة

239
00:17:41,420 --> 00:17:43,310
.أنا جدّ آسفة يا كوباتو-تشان

240
00:17:43,310 --> 00:17:44,820
.لم أقصد أن أتطفّل

241
00:17:44,820 --> 00:17:46,320
.على الإطلاق

242
00:17:46,320 --> 00:17:48,140
.ستكون سعيدة

243
00:17:48,140 --> 00:17:52,290
لم تكفّ عن الحديث عن الجدّة
.كاتو مذ كانت صغيرة

244
00:17:52,290 --> 00:17:53,940
.كانت متعلّقة بك كثيرًا

245
00:17:53,940 --> 00:17:56,840
.سرّني سماع ذلك

246
00:17:57,260 --> 00:17:58,870
...ولكن مع ذلك

247
00:17:58,870 --> 00:18:01,350
...لم أتوقّع أن تختفي هيتومي-تشان أيضًا

248
00:18:03,480 --> 00:18:07,360
أفترض أنّ ذلك أيضًا جزء
.من قوّة عائلة ناروسي

249
00:18:11,960 --> 00:18:13,600
.لن ينفع هذا

250
00:18:13,600 --> 00:18:16,820
.صرتُ أقلق أكثر كلّما تقدّمتُ في السّنّ

251
00:18:19,210 --> 00:18:20,320
...كلاّ

252
00:18:22,320 --> 00:18:24,330
.سأغادر الآن

253
00:18:24,920 --> 00:18:27,670
.ينتظرني زوجي عند الميناء

254
00:18:27,670 --> 00:18:30,330
.تعاليا لزيارتنا معًا في المرّة القادمة

255
00:18:30,560 --> 00:18:32,490
.بكلّ سرور

256
00:18:32,490 --> 00:18:34,290
.أبلغ سلامي لشيروها-تشان

257
00:18:46,290 --> 00:18:47,980
....ا-المعذرة

258
00:18:49,180 --> 00:18:51,210
...أيّتها الجدّة كاتو

259
00:18:51,210 --> 00:18:52,220
...أنت

260
00:18:52,690 --> 00:18:54,170
شيروها-تشان، صحيح؟

261
00:18:55,370 --> 00:18:58,230
...لقد كبرتِ كثيرًا

262
00:18:58,880 --> 00:19:03,100
.كم هذا رائع، سرّني لقاؤك بالفعل

263
00:19:03,100 --> 00:19:05,910
.ربّما كان ذلك بفضل هيتومي-تشان

264
00:19:07,500 --> 00:19:08,670
هل من خطب ما؟

265
00:19:09,380 --> 00:19:12,000
هل تعرفين أمّي؟

266
00:19:13,160 --> 00:19:15,130
إلى أين ذهبت أمّي؟

267
00:19:15,330 --> 00:19:18,340
إلى أين ذهبت وتخلّت عنّي؟

268
00:19:23,380 --> 00:19:24,840
.شيروها-تشان

269
00:19:24,840 --> 00:19:26,900
.لا يجدر بك قول ذلك

270
00:19:33,920 --> 00:19:36,270
...لقد كبرتِ بالفعل

271
00:19:36,860 --> 00:19:39,390
.أذكر ما حدث جيّدًا

272
00:19:39,390 --> 00:19:41,780
.أذكر لحظة مجيئك لهذا العالم

273
00:19:41,780 --> 00:19:43,440
أنا؟

274
00:19:43,440 --> 00:19:44,310
.نعم

275
00:19:45,280 --> 00:19:50,470
.لطالما اهتمّت هيتومي-تشان لأمرك بشدّة

276
00:19:50,920 --> 00:19:54,620
.نملك أنا وشيروها نفس القوّة

277
00:19:55,220 --> 00:19:57,940
،لكنّي لا أريد لذلك أن يستهلكها

278
00:19:58,310 --> 00:20:03,240
لذلك سأحرص أن تحظى
.بفصول صيف كثيرة ممتعة

279
00:20:05,200 --> 00:20:08,930
.كنتِ الأولى دائمًا في أفكارها

280
00:20:10,690 --> 00:20:12,910
...لذلك ثقي بهيتومي-تشان

281
00:20:12,910 --> 00:20:14,460
.ثقي بأمّك

282
00:20:14,460 --> 00:20:16,250
.ثقي بها بكلّ ما لديك

283
00:20:23,370 --> 00:20:26,910
.نملك أنا وشيروها نفس القوّة

284
00:20:26,910 --> 00:20:28,910
ما الّذي قصدت بذلك؟

285
00:20:29,330 --> 00:20:31,310
...نفس القوّة

286
00:20:31,730 --> 00:20:32,910
مثل أمّي؟

287
00:20:32,910 --> 00:20:35,870
أيعقل أنّ لديّ قوّة؟

288
00:20:35,870 --> 00:20:37,210
أنا قويّة؟

289
00:20:37,210 --> 00:20:39,330
...لا أعتقد أنّ ذلك ما قصدته

290
00:20:39,900 --> 00:20:41,040
،بعد التّفكير في الأمر الآن

291
00:20:41,320 --> 00:20:43,590
...في أوّل مرّة رأيتُ ذلك الحلم

292
00:20:50,830 --> 00:20:52,210
هل أيقظتك؟

293
00:20:52,210 --> 00:20:53,230
.أنا آسفة

294
00:20:53,510 --> 00:20:54,890
...أمّي

295
00:20:54,890 --> 00:20:56,990
.رأيتُ حلمًا غريبًا

296
00:20:57,740 --> 00:20:59,160
بماذا حلمت؟

297
00:21:00,240 --> 00:21:01,650
...حسنًا

298
00:21:03,690 --> 00:21:07,240
.أخبرتني فراشة غريبة بأمر ما

299
00:21:07,600 --> 00:21:09,160
".يمكنك الذّهاب لرؤيتها"

300
00:21:09,160 --> 00:21:11,240
".لديك القوّة للقيام بذلك"

301
00:21:13,120 --> 00:21:15,700
كان حلمًا غريبًا، أليس كذلك؟

302
00:21:17,700 --> 00:21:19,110
أمّي؟

303
00:21:19,110 --> 00:21:21,870
.نعم... حلم غريب جدًّا

304
00:21:22,140 --> 00:21:26,200
.اختفت أمّي بعد ذلك مباشرة

305
00:21:26,500 --> 00:21:30,510
...إن كنّا نملك نفس القوّة

306
00:21:30,780 --> 00:21:33,700
.ربّما ذهبت أمّي لرؤيته

307
00:21:34,170 --> 00:21:36,060
.ذهبت إلى أبي قبلي

308
00:21:36,450 --> 00:21:37,660
...في تلك الحالة

309
00:21:38,240 --> 00:21:39,610
!شيروها-تشان

310
00:21:42,340 --> 00:21:43,690
...نانامي

311
00:21:44,140 --> 00:21:45,740
.إذًا فقد كنت هنا

312
00:21:45,740 --> 00:21:48,390
...حمدًا على هذا، كنتُ قلقة

313
00:21:48,670 --> 00:21:51,770
.وكذلك كان أصدقاؤك أيضًا

314
00:21:54,660 --> 00:21:57,550
شيروها-تشان... هل أنت بخير؟

315
00:21:57,550 --> 00:21:58,360
.نعم

316
00:21:58,770 --> 00:22:00,090
.كلّ شيء بخير