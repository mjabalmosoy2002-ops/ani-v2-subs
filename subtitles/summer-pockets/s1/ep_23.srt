1
00:00:03,810 --> 00:00:05,790
.أطير بلا أيّ راحة

2
00:00:06,180 --> 00:00:09,000
،مع كلّ اندفاع، مع كلّ ضربة بأجنحتي

3
00:00:09,380 --> 00:00:11,410
.أستهلك نفسي أكثر فأكثر

4
00:00:12,170 --> 00:00:15,500
ذلك الصّيف الّذي لم أستطع
التّوقّف عن عيشه مرّة أخرى

5
00:00:15,840 --> 00:00:17,670
...ملأني بالفرح

6
00:00:17,800 --> 00:00:19,970
وتركني مع عدد لا يحصى من الذّكريات

7
00:00:20,430 --> 00:00:23,540
.الّتي تتلاشى تدريجيًّا من ذاكرتي

8
00:00:24,090 --> 00:00:27,910
،ومع ذلك أشعر بشيء يدفعني للأمام

9
00:00:28,450 --> 00:00:30,130
.يجرّني من يدي

10
00:00:30,800 --> 00:00:32,960
...ذكريات لا تُحصى

11
00:00:33,090 --> 00:00:36,510
.تملأ جسدًا ظننتُه قد اختفى

12
00:00:37,140 --> 00:00:40,110
...كلّ واحدة من هذه اللّحظات العزيزة

13
00:00:40,520 --> 00:00:42,590
.تبدو مثل صلاة

14
00:00:49,930 --> 00:00:51,450
...هذا يدغدغ

15
00:00:51,720 --> 00:00:54,480
...هذا مؤلم! هذا يؤلم بالفعل

16
00:01:00,290 --> 00:01:01,930
قنّ دجاج؟

17
00:01:03,070 --> 00:01:04,760
هل أنت من أيقظتني؟

18
00:01:05,020 --> 00:01:06,370
...عفوًا

19
00:01:06,670 --> 00:01:08,480
.شكرًا لك يا كاثرين

20
00:01:10,510 --> 00:01:11,850
...أنا

21
00:01:20,410 --> 00:01:23,970
عفوًا، هل لديك فكرة أين أنا

22
00:01:25,140 --> 00:01:27,410
أو حتّى ما هو اسمي لو سمحت؟

23
00:01:29,640 --> 00:01:32,990
،إن فهمت الأمر بشكل صحيح
فأنت لا تتذكّرين أيّ شيء

24
00:01:33,450 --> 00:01:35,490
عمّن تكونين أو من أين أتيت؟

25
00:01:35,660 --> 00:01:36,840
.هذا صحيح

26
00:01:40,680 --> 00:01:42,080
.هيّا، عرّفي عن نفسك

27
00:01:45,630 --> 00:01:46,630
.مرحبًا

28
00:01:47,710 --> 00:01:49,530
!مهلاً يا شيروها

29
00:01:50,310 --> 00:01:52,090
اسمها شيروها-تشان؟

30
00:01:52,270 --> 00:01:55,470
.نعم. وأنا ناروسي

31
00:01:56,040 --> 00:01:57,100
.ناديني كوباتو

32
00:01:57,430 --> 00:01:59,210
كوباتو-سان؟

33
00:01:59,530 --> 00:02:01,510
.يبدو أنّك تعانين من فقدان الذّاكرة

34
00:02:01,670 --> 00:02:04,720
.عليك الذّهاب لرؤية طبيب مختصّ في المدينة

35
00:02:05,180 --> 00:02:08,380
.كُلي شيئًا ما، وبعدها سنغادر

36
00:02:08,630 --> 00:02:10,090
.أنا أعتذر

37
00:02:27,100 --> 00:02:30,070
شكرًا لك... يا شيروها-تشان؟

38
00:02:31,670 --> 00:02:34,000
كيف تعرفين اسمي؟

39
00:02:34,140 --> 00:02:36,920
.لا تقلقي. أخبرني به والدك

40
00:02:39,060 --> 00:02:41,720
.ليس لديّ والد

41
00:02:44,120 --> 00:02:45,390
!لقد مات

42
00:02:49,210 --> 00:02:51,770
ما هذا؟ هل جعلتها تبكي؟

43
00:02:52,000 --> 00:02:53,400
.أعتذر بشدّة

44
00:02:54,250 --> 00:02:57,280
!والدها؟ يفترض أنّك ميّت

45
00:02:57,450 --> 00:02:59,690
.بل أنا جدّها

46
00:02:59,830 --> 00:03:01,760
أليس ذلك واضحًا عليّ؟

47
00:03:02,130 --> 00:03:05,120
.كُلي. لا تنتظري حتّى يبرد الطّعام

48
00:03:06,200 --> 00:03:07,270
.حاضرة

49
00:03:09,250 --> 00:03:10,550
.شكرًا على الطّعام

50
00:03:15,670 --> 00:03:18,510
.هذا الدّجاج المقليّ لذيذ للغاية

51
00:03:18,640 --> 00:03:19,540
.ذلك صحيح

52
00:03:19,790 --> 00:03:22,350
.بما أنّي ذبحتُ الدّجاجة هذا الصّباح فقط

53
00:03:24,040 --> 00:03:25,780
.إذًا فاللّحم كان طازجًا

54
00:03:28,890 --> 00:03:32,030
!كاثرين

55
00:03:35,860 --> 00:03:37,450
لم تنسي أيّ شيء، صحيح؟

56
00:03:37,720 --> 00:03:39,390
...عفوًا

57
00:03:42,490 --> 00:03:43,690
!شيروها-تشان

58
00:03:46,610 --> 00:03:47,910
!أنا آسفة على ما سبق

59
00:03:49,150 --> 00:03:50,130
لماذا؟

60
00:03:50,260 --> 00:03:53,390
.لم أكن مراعية في حديثي معك

61
00:03:54,260 --> 00:03:55,620
مراعية؟

62
00:03:55,980 --> 00:03:57,480
لا تفهمين معنى ذلك؟

63
00:03:57,740 --> 00:04:00,010
.صحيح، لم أكن لبقة

64
00:04:00,290 --> 00:04:01,770
لبقة؟

65
00:04:01,930 --> 00:04:03,320
.اقترفتُ خطأ معك

66
00:04:03,890 --> 00:04:04,910
اقترفت؟

67
00:04:05,050 --> 00:04:07,650
...على أيّ حال، ما أعنيه

68
00:04:07,930 --> 00:04:10,200
هل انتهيت من درس المفردات الآن؟

69
00:04:10,840 --> 00:04:12,880
.نعم! إلى اللّقاء

70
00:04:16,280 --> 00:04:18,360
.إلى... اللّقاء

71
00:04:27,560 --> 00:04:28,930
لماذا أنت هنا؟

72
00:04:29,150 --> 00:04:31,640
.لن تصدّقي الأمر أبدًا

73
00:04:31,860 --> 00:04:33,550
.لقد خافت من السّفينة

74
00:04:34,000 --> 00:04:36,790
،عندما رأيتُ البحر قبل أن أصعد إليها

75
00:04:36,990 --> 00:04:39,670
.تسمّرتُ في مكاني بالكامل

76
00:04:39,810 --> 00:04:42,500
.كان وضعًا محرجًا للغاية

77
00:04:42,650 --> 00:04:43,720
.بكلّ تأكيد

78
00:04:43,870 --> 00:04:45,270
أكان خطأ اقترفتِه؟

79
00:04:45,410 --> 00:04:47,880
.ما كنتُ لأصف الأمر بذلك

80
00:04:48,110 --> 00:04:51,360
.فعلاً؟ إنّها كلمة معقّدة

81
00:04:53,330 --> 00:04:54,690
...آسفة، أنا لا أستخفّ بك

82
00:04:55,690 --> 00:04:58,240
.واضح أنّك تفتقرين للّباقة

83
00:04:59,220 --> 00:05:00,340
.ذلك صحيح

84
00:05:00,670 --> 00:05:04,860
.وبالتّالي، ستظلّ معنا لبعض الوقت

85
00:05:07,110 --> 00:05:10,330
عفوًا، أواثق أنّ هذا لا يزعجك؟

86
00:05:10,470 --> 00:05:13,400
،لا يوجد في هذا المنزل سوانا أنا وشيروها

87
00:05:13,730 --> 00:05:16,560
.وأنا أغيب عنه غالبًا بسبب العمل

88
00:05:16,930 --> 00:05:20,330
.سيكون هذا مطمئنًا لي إن بقيتِ برفقتها

89
00:05:20,480 --> 00:05:22,270
.لكن لديّ طلب واحد فقط

90
00:05:23,040 --> 00:05:25,410
.لا تذكري والديها أمامها

91
00:05:25,850 --> 00:05:29,530
.وخاصّة والدتها. إنّه موضوع حسّاس

92
00:05:29,770 --> 00:05:30,770
هل فهمتِ كلامي؟

93
00:05:31,590 --> 00:05:33,570
ما الّذي حدث لوالدتها؟

94
00:05:33,970 --> 00:05:35,350
،قبل شهر

95
00:05:35,520 --> 00:05:38,240
.مات والد تلك الفتاة في حادث

96
00:05:39,030 --> 00:05:41,650
،وبعدها بقليل، اختفت والدة شيروها

97
00:05:41,960 --> 00:05:45,180
.والّتي هي ابنتي أيضًا

98
00:05:46,480 --> 00:05:49,930
.لقد مرّ شهر فقط على فقدانها لوالديها

99
00:05:50,800 --> 00:05:53,930
،قد تبدو صعبة المراس لك كطفلة

100
00:05:54,290 --> 00:05:55,680
.لكنّي معجب بصمودها

101
00:05:56,560 --> 00:05:59,350
.إنّها لا تبكي إلاّ نادرًا أمامي

102
00:05:59,750 --> 00:06:03,810
أو ربّما ما عادت لديها دموع لتذرفها

103
00:06:04,050 --> 00:06:07,000
.بعد تجربتها لكلّ ذلك القدر من الحزن

104
00:06:09,320 --> 00:06:12,800
.دعينا نغيّر الموضوع الآن
.أنت تحتاجين لاسم

105
00:06:13,620 --> 00:06:16,770
.ستحتاجين اسمًا إن كنت ستعيشين هنا

106
00:06:17,150 --> 00:06:19,620
ما الّذي تذكرينه عن نفسك؟

107
00:06:21,880 --> 00:06:22,950
...البحر

108
00:06:23,770 --> 00:06:25,400
...البحار السّبعة

109
00:06:27,470 --> 00:06:28,490
ماذا تقصدين؟

110
00:06:29,060 --> 00:06:30,800
...إنّ تلك العبارة

111
00:06:31,120 --> 00:06:32,950
.لا تبارح تفكيري

112
00:06:33,260 --> 00:06:35,370
مع أنّك تخافين من البحر؟

113
00:06:36,740 --> 00:06:38,240
...البحار السّبعة

114
00:06:38,610 --> 00:06:39,880
.أو "نانامي" باختصار

115
00:06:40,100 --> 00:06:42,900
.نانامي؟ نانامي

116
00:06:43,310 --> 00:06:45,730
.لنختر ذلك كاسم في الوقت الحاليّ

117
00:06:45,990 --> 00:06:46,930
.حاضرة

118
00:06:52,950 --> 00:06:56,610
نانامي... أهذا هو اسمي الآن؟

119
00:07:01,450 --> 00:07:04,900
ما هذه؟ أهي أجنحة؟

120
00:07:12,460 --> 00:07:13,500
فراشة؟

121
00:07:14,510 --> 00:07:15,840
.نانامي

122
00:07:17,700 --> 00:07:18,830
.عفوًا

123
00:07:19,110 --> 00:07:21,650
.أخبرني جدّي أن أناديك بذلك

124
00:07:22,660 --> 00:07:24,420
.العشاء جاهز

125
00:07:33,560 --> 00:07:36,460
مرّت بعضة أيّام مذ بدأت
.أعيش مع عائلة ناروسي

126
00:07:36,600 --> 00:07:40,120
أخرج لاكتشاف الجزيرة سعيًا
.لاستعادة ذاكرتي

127
00:07:40,360 --> 00:07:43,440
ولكن للأسف، يبدو أنّي لا أستطع
.استعادة أيّ من ذكرياتي

128
00:07:44,240 --> 00:07:46,360
.يعمل كوباتو-سان كصيّاد للسّمك

129
00:07:46,740 --> 00:07:49,490
،تغادر شيروها-تشان المنزل في وقت مبكّر

130
00:07:49,720 --> 00:07:53,890
.وتخرج ثانية في المساء بعد تناول غدائها

131
00:07:54,590 --> 00:07:56,910
.هذا هو روتيننا اليوميّ

132
00:07:57,520 --> 00:07:59,320
.لنبدأ بالأكل

133
00:08:00,920 --> 00:08:03,450
.يبدو أنّ صيد اليوم كان جيّدًا يا كوباتو-سان

134
00:08:03,800 --> 00:08:06,310
...تتناولان وجبات طازجة وممتازة كلّ يوم

135
00:08:06,460 --> 00:08:08,360
.أنت محظوظة جدًّا يا شيروها-تشان

136
00:08:12,420 --> 00:08:14,590
،لكن مع أنّ المكوّنات من أعلى جودة

137
00:08:14,950 --> 00:08:17,000
ليس من الممتع أن تتناول طفلة

138
00:08:17,150 --> 00:08:19,780
.أطباق ساشيمي كلّ يوم

139
00:08:20,010 --> 00:08:23,670
.كما أنّ هذا أسلوب صارم جدًّا
.أنا لا أحبّه

140
00:08:24,390 --> 00:08:27,770
.عليها قضاء وقت أكثر متعة على المائدة

141
00:08:28,660 --> 00:08:30,500
!حسنًا، صار جاهزًا

142
00:08:32,620 --> 00:08:35,160
.لا يبدو سيّئًا بالنّسبة لشيء مرتجل

143
00:08:35,530 --> 00:08:40,140
ومع ذلك، كيف استطعتُ طبخ
هذا وأنا لا أملك أيّ ذكريات؟

144
00:08:40,710 --> 00:08:41,910
...أرزّ في المقلاة

145
00:08:42,480 --> 00:08:43,870
ما الّذي تطبخينه؟

146
00:08:44,210 --> 00:08:45,480
!شيروها-تشان

147
00:08:46,170 --> 00:08:47,430
.إنّه أرزّ في المقلاة

148
00:08:47,710 --> 00:08:49,270
ألا يسمّى أرزًّا مقليًّا؟

149
00:08:49,400 --> 00:08:51,330
.لا، بل يسمّى أرزّ في المقلاة

150
00:08:51,790 --> 00:08:53,180
ليس أرزًّا مقليًّا؟

151
00:08:55,260 --> 00:08:57,470
.إذًا لنسمّيه أرزّ المقلاة فحسب

152
00:08:57,790 --> 00:08:58,870
!أرزّ المقلاة

153
00:08:59,020 --> 00:09:00,870
!أجل! أرزّ المقلاة

154
00:09:01,010 --> 00:09:03,600
!أرزّ المقلاة

155
00:09:03,780 --> 00:09:08,440
!أرزّ المقلاة! أرزّ المقلاة! أرزّ المقلاة! أرزّ المقلاة

156
00:09:18,930 --> 00:09:20,050
.إنّه لذيذ

157
00:09:20,270 --> 00:09:21,520
!سرّني سماع هذا

158
00:09:22,610 --> 00:09:24,630
،يصير تناول السّاشيمي دائمًا مملاًّ

159
00:09:24,870 --> 00:09:26,980
.حتّى إن كان طازجًا ومعدًّا جيّدًا

160
00:09:27,130 --> 00:09:28,630
.آسف لتخييب ظنّك

161
00:09:31,880 --> 00:09:33,600
هل أنت من طبخ هذا؟

162
00:09:33,940 --> 00:09:34,980
.نعم

163
00:09:36,040 --> 00:09:38,220
.ما زال منه الكثير إن أردتَ تجربته

164
00:09:43,960 --> 00:09:45,050
.إنّه لذيذ

165
00:09:45,640 --> 00:09:47,370
...لكنّه

166
00:09:48,290 --> 00:09:49,930
هل من مشكلة ما؟

167
00:09:50,170 --> 00:09:53,760
.على الإطلاق. شكرًا على طبخك إيّاه

168
00:09:54,120 --> 00:09:57,450
إذًا فأنت تجيدين الطّبخ يا نانامي؟

169
00:09:57,820 --> 00:10:00,250
...إن أعجب شيروها، فربّما

170
00:10:00,380 --> 00:10:02,930
.لا، أنت ضيفتنا يا نانامي

171
00:10:03,060 --> 00:10:05,550
.لا تضغطي على نفسك للطّبخ لنا ثانية

172
00:10:06,120 --> 00:10:08,020
.أنا لا أمانع ذلك إطلاقًا

173
00:10:09,450 --> 00:10:10,680
.سأترككما الآن

174
00:10:11,080 --> 00:10:12,760
.أحتاج لأخذ قيلولة

175
00:10:12,900 --> 00:10:14,340
.شكرًا على الطّعام

176
00:10:15,240 --> 00:10:17,470
.جيّد. سرّني أنّه أعجبك

177
00:10:17,890 --> 00:10:20,980
.كان مذاقه مثل الأرزّ الّذي كان يعدّه أبي

178
00:10:22,370 --> 00:10:23,330
،عفوًا

179
00:10:23,900 --> 00:10:26,760
هلاّ علّمتني كيف أطبخه؟

180
00:10:27,560 --> 00:10:28,960
،يمكنني ذلك

181
00:10:29,220 --> 00:10:32,290
.مع أنّي طبخته بشكل غريزيّ

182
00:10:32,840 --> 00:10:34,450
لكنّي لا أعتقد

183
00:10:34,590 --> 00:10:37,620
.أنّ جدّك سيُسرّ كثيرًا بشأن قيامي بالطّبخ

184
00:10:39,020 --> 00:10:41,140
...حسنًا، في تلك الحالة

185
00:10:41,790 --> 00:10:44,590
.لنطبخ في مكاني السّرّيّ

186
00:10:45,080 --> 00:10:46,830
مكانك السّرّيّ؟

187
00:10:50,730 --> 00:10:52,470
المطعم مغلق؟

188
00:10:52,670 --> 00:10:56,180
.نعم. كان أبي هو الطّبّاخ

189
00:10:56,460 --> 00:10:59,600
،لم تكن أمّي طبّاخة جيّدة

190
00:10:59,800 --> 00:11:02,270
.لذلك كانت تساعد في الأمور الأخرى

191
00:11:02,540 --> 00:11:05,950
،لكنّ ذلك انتهى بعد موت أبي في حادث

192
00:11:06,200 --> 00:11:08,380
.واختفاء أمّي إلى مكان ما

193
00:11:08,670 --> 00:11:10,890
إلى مكان ما...؟

194
00:11:11,320 --> 00:11:12,440
.لا أعرف

195
00:11:12,860 --> 00:11:16,450
.أعتقد أنّها رحلت للعثور على أبي

196
00:11:16,650 --> 00:11:18,820
.كانا لا ينفصلان

197
00:11:19,420 --> 00:11:20,870
...شيروها-تشان

198
00:11:25,640 --> 00:11:29,930
فهمت الآن. لهذا السّبب تأتين
.لتنظيف المكان كلّ صباح

199
00:11:30,540 --> 00:11:32,460
.كان ذلك من واجبات أمّي

200
00:11:36,520 --> 00:11:38,100
