.ستستقل أمّي قاربًا

202
00:13:29,150 --> 00:13:30,260
شيروها؟

203
00:13:30,260 --> 00:13:31,420
...أومي-تشان

204
00:13:32,600 --> 00:13:34,870
هل تتحدّثين عن طقس ناتسودوري؟

205
00:13:35,900 --> 00:13:38,540
طقس ناتسودوري...؟

206
00:13:38,540 --> 00:13:40,610
هل قلت طقس ناتسودوري؟

207
00:13:40,610 --> 00:13:41,640
.نعم

208
00:13:41,640 --> 00:13:44,990
.إنّها مراسم متوارثة عبر الأجيال

209
00:13:44,990 --> 00:13:47,410
.إنّها مهرجان بشكل بسيط

210
00:13:47,410 --> 00:13:48,380
وأنتِ جزء منه؟

211
00:13:49,170 --> 00:13:49,860
.نعم

212
00:13:50,380 --> 00:13:53,660
.لكن لا يجب أن يعلم أحد بذلك سوى جدّي

213
00:13:54,200 --> 00:13:58,490
أومي-تشان، هل كنتِ تعلمين
أنّني سأركب قاربًا؟

214
00:13:58,490 --> 00:13:59,310
.نعم

215
00:14:01,730 --> 00:14:04,470
وهل كنتِ تعلمين عن المطر بالأمس؟

216
00:14:04,470 --> 00:14:05,230
.نعم

217
00:14:08,430 --> 00:14:11,780
هل تعرفين عن الغد أيضًا؟

218
00:14:12,350 --> 00:14:13,410
الغد؟

219
00:14:13,410 --> 00:14:14,740
!نعم

220
00:14:16,600 --> 00:14:17,740
شيروها؟

221
00:14:20,440 --> 00:14:21,850
أمّي؟

222
00:14:22,360 --> 00:14:23,750
.اكتفيت

223
00:14:24,690 --> 00:14:27,820
.لن ألعب دور الأمّ بعد الآن

224
00:14:28,250 --> 00:14:29,380
.كلاّ

225
00:14:29,380 --> 00:14:30,570
!كلاّ، كلاّ

226
00:14:30,570 --> 00:14:31,260
!أمّي

227
00:14:31,260 --> 00:14:32,220
.ابتعدي عني

228
00:14:42,760 --> 00:14:44,010
.أنا آسفة

229
00:14:46,130 --> 00:14:46,900
!مـ-مهلاً

230
00:14:50,040 --> 00:14:50,910
أومي؟

231
00:14:51,880 --> 00:14:53,080
...أبي

232
00:14:53,760 --> 00:14:54,660
.ستعود

233
00:14:56,450 --> 00:14:59,720
ستعود أمّي غدًا، أليس كذلك؟

234
00:15:03,720 --> 00:15:05,250
.نعم، لا تقلقي

235
00:15:05,560 --> 00:15:06,750
.أنا متأكّد من عودتها

236
00:15:10,540 --> 00:15:12,760
!مهلاً! انتظري يا شيروها

237
00:15:12,760 --> 00:15:13,720
!شيروها

238
00:15:19,190 --> 00:15:22,560
.أنا ملعونة

239
00:15:25,400 --> 00:15:26,770
.أنا آسفة

240
00:15:38,000 --> 00:15:39,350
...آسف يا أومي

241
00:15:39,350 --> 00:15:40,390
...إنّ شيروها

242
00:15:40,390 --> 00:15:42,370
...نستمرّ في تفويت بعضنا البعض

243
00:15:42,870 --> 00:15:45,450
.لكنّني لن أهرب

244
00:15:45,950 --> 00:15:48,800
.لأنّ هذا الصّيف هو الأخير بالتّأكيد

245
00:15:52,230 --> 00:15:53,890
ما هذا يا أومي؟

246
00:15:54,340 --> 00:15:55,790
.أمّي

247
00:15:55,790 --> 00:15:57,170
أمّك؟

248
00:15:58,790 --> 00:16:00,640
متى التقطنا هذه الصّورة؟

249
00:16:01,560 --> 00:16:03,140
الواحد والثّلاثون؟

250
00:16:03,140 --> 00:16:04,560
ما معنى هذا؟

251
00:16:04,560 --> 00:16:05,810
...ما زلنا اليوم في

252
00:16:12,900 --> 00:16:16,200
يوم عاصف بعد أن كان مشمسًا

253
00:16:23,620 --> 00:16:24,910
.خذوا مظلّة

254
00:16:24,910 --> 00:16:25,790
.ستُمطر

255
00:16:25,790 --> 00:16:28,050
.ستستقل أمّي قاربًا

256
00:16:28,050 --> 00:16:30,550
هل تعرفين عن الغد أيضًا؟

257
00:16:30,550 --> 00:16:31,500
!نعم

258
00:16:33,940 --> 00:16:36,060
...أخبريني يا أومي

259
00:16:36,820 --> 00:16:38,140
...أيعقل أنّك

260
00:16:41,960 --> 00:16:45,640
.أتيتُ لرؤية أمّي

261
00:16:46,100 --> 00:16:49,280
.لأنّ أمّي رحلت الآن

262
00:16:49,280 --> 00:16:51,600
.لأنّي لم أعرفها أبدًا

263
00:16:52,620 --> 00:16:54,030
...لذلك

264
00:16:55,040 --> 00:16:57,740
لذلك أتيت لهذه الجزيرة؟

265
00:16:58,920 --> 00:17:01,250
من المستقبل؟

266
00:17:01,980 --> 00:17:02,610
.نعم

267
00:17:09,040 --> 00:17:10,250
...إنّني

268
00:17:10,250 --> 00:17:16,530
مذ كنت صغيرة، كنت أستطيع
.أن أبعث بروحي قليلاً إلى الماضي

269
00:17:17,500 --> 00:17:23,080
،في كلّ مرّة كان يُزعجني شيء ما
.كنت أعود إلى الوراء وكأنّني أهرب

270
00:17:23,730 --> 00:17:26,390
لكنّني كنت أجد طريقي دائمًا
.إلى المستقبل نفسه

271
00:17:26,990 --> 00:17:31,900
أخبرني أبي أنّنا كنّا نعيش
.على هذه الجزيرة حين وُلدت

272
00:17:32,420 --> 00:17:36,900
.لكنه أخذني بعيدًا عنها

273
00:17:36,900 --> 00:17:39,810
.قال أنّنا لن نقترب منها أبدًا

274
00:17:39,810 --> 00:17:41,240
.وطلب منّي أن أنساها

275
00:17:41,240 --> 00:17:45,410
.لم يتحدّث قطّ عن أمّي أيضًا

276
00:17:48,400 --> 00:17:51,930
.أظنّ أنّ أبي يكرهني

277
00:17:52,670 --> 00:17:55,900
.كان السّبب هو أنّي وُلدت

278
00:17:55,900 --> 00:17:59,050
.كان موت أمّي بسببي

279
00:18:00,390 --> 00:18:04,560
...لكنّ أبي أخبرني مرّة

280
00:18:05,600 --> 00:18:08,230
.عن عطلة صيفيّة قضاها معها

281
00:18:09,000 --> 00:18:11,400
.لقد قابلها بالصّدفة على هذه الجزيرة

282
00:18:11,400 --> 00:18:18,150
،ذهبا للصّيد، وأطلقا الطّائرات الورقيّة
...وغنّيا، ولعبا في المسبح

283
00:18:18,780 --> 00:18:20,630
.كنت أغار منه

284
00:18:20,630 --> 00:18:24,330
.لم أعش صيفًا كهذا من قبل

285
00:18:24,600 --> 00:18:29,650
.تمنّيتُ لو قضيت صيفًا كهذا مع أمّي

286
00:18:30,170 --> 00:18:34,170
.لكنّه عاد إلى الجزيرة وحده

287
00:18:34,820 --> 00:18:36,310
.تركني

288
00:18:37,280 --> 00:18:39,390
.لهذا جئت أنا بمفردي

289
00:18:39,390 --> 00:18:40,370
بمفردك؟

290
00:18:40,370 --> 00:18:41,160
.نعم

291
00:18:41,160 --> 00:18:43,720
.طالما عندي تطبيقات هاتفي الذّكيّ، فأنا بخير

292
00:18:43,720 --> 00:18:45,680
تطبيقات هاتف ذكيّ؟

293
00:18:45,680 --> 00:18:50,830
،حتّى في أوّل مرّة جئت فيها إلى الجزيرة
.شعرتُ بالحنين

294
00:18:50,830 --> 00:18:55,670
ذهبت إلى منزل جدّي
.وحصلت على صورة لأمّي

295
00:18:55,670 --> 00:18:59,880
.تخلّص أبي من كلّ صوره القديمة

296
00:18:59,880 --> 00:19:01,860
.كانت تلك أوّل مرّة أراها فيها

297
00:19:01,860 --> 00:19:03,320
.إنّها جميلة جدًّا

298
00:19:03,910 --> 00:19:07,490
.لكن كاد أبي أن يمسكني

299
00:19:08,130 --> 00:19:11,950
.لم أرد أن يأخذ الصّورة، فهربت

300
00:19:11,950 --> 00:19:14,710
...هربت وهربت وهربت

301
00:19:19,540 --> 00:19:20,840
...أمّي

302
00:19:33,180 --> 00:19:36,040
.وحين عدت إلى وعيي، وجدتُ نفسي هنا

303
00:19:36,040 --> 00:19:38,780
.لم تكن روحي فقط، بل جسدي أيضًا

304
00:19:39,320 --> 00:19:43,780
ومنذ ذلك الحين، وأنا أكرّر
.هذا الصّيف مرارًا وتكرارًا

305
00:19:43,780 --> 00:19:48,160
.فقط لأقضيه مع أمّي

306
00:19:48,160 --> 00:19:51,790
.لكنّني أشعر أنّ شيئًا ما بدأ يتلاشى

307
00:19:56,410 --> 00:20:00,050
.أظنّ أنّ هذا الصّيف هو الأخير لي

308
00:20:05,960 --> 00:20:07,890
...تقصدين أنّ أمّك

309
00:20:08,360 --> 00:20:09,090
.نعم

310
00:20:10,460 --> 00:20:12,890
.عرفتُ أنّها هي فورًا

311
00:20:13,270 --> 00:20:15,560
.لأنّها كانت معك يا أبي

312
00:20:17,260 --> 00:20:18,830
...أنا؟ أنا هو

313
00:20:24,410 --> 00:20:25,910
.لم أكن أعلم

314
00:20:28,240 --> 00:20:30,370
هل تصدّقني؟

315
00:20:33,030 --> 00:20:35,370
.بصراحة، لست متأكّدًا أنّني أستوعب الأمر

316
00:20:36,190 --> 00:20:38,090
.كلّ شيء مفاجئ

317
00:20:38,090 --> 00:20:41,730
،يحدث هذا بسرعة كبيرة
.لا يمكنني استيعابه بالكامل

318
00:20:41,730 --> 00:20:42,990
.لكنّني أصدّقك

319
00:20:42,990 --> 00:20:44,220
.أنا أثق بكِ يا أومي

320
00:20:46,040 --> 00:20:47,970
...مع ذلك

321
00:20:50,020 --> 00:20:53,310
.يبدو أنّني شخص سيّئ في المستقبل

322
00:20:53,310 --> 00:20:54,370
.لا

323
00:20:55,190 --> 00:20:57,810
.عشتُ صيفًا بعد صيف

324
00:20:58,350 --> 00:21:03,840
...رأيتك في كلّ مرّة، وتعلّمتُ شيئًا

325
00:21:04,400 --> 00:21:06,950
.أعلم أنّك شخص طيّب

326
00:21:07,480 --> 00:21:11,450
.أنا سعيدة لأنّك أبي

327
00:21:12,000 --> 00:21:13,140
...أومي

328
00:21:24,210 --> 00:21:25,440
...أومي-تشان

329
00:21:30,510 --> 00:21:31,600
...أومي

330
00:21:31,600 --> 00:21:36,610
خضتِ رحلة طويلة ووحيدة، أليس كذلك؟

331
00:22:01,970 --> 00:22:04,460
.سأجعل الأمر يحدث يا أومي

332
00:22:05,240 --> 00:22:08,870
سأجعل عطلة الصّيف هذه
.ممتعة بالنّسبة لك