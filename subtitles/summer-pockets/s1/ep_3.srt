.أردتُ أن أعتذر لما حدث في الخزّان

208
00:15:18,350 --> 00:15:19,890
...عفوًا

209
00:15:21,120 --> 00:15:23,640
هل أتيتِ إلى هنا للحصول على شيء؟

210
00:15:24,800 --> 00:15:26,100
...إنّه

211
00:15:26,670 --> 00:15:28,150
أتريدين منّي الذّهاب لشرائه؟

212
00:15:31,550 --> 00:15:32,540
فعلاً؟

213
00:15:32,540 --> 00:15:34,330
.أنا مدين لك

214
00:15:34,330 --> 00:15:35,910
ماذا تريدين؟

215
00:15:37,410 --> 00:15:40,410
.مثلّجات بطّيخ

216
00:15:41,030 --> 00:15:42,830
.مفهوم. انتظري لحظة

217
00:15:49,340 --> 00:15:50,420
.تفضّلي

218
00:15:49,530 --> 00:15:50,420
مثلّجات شمّام

219
00:15:51,360 --> 00:15:52,570
ما هذا؟

220
00:15:52,570 --> 00:15:53,760
.مثلّجات شمّام

221
00:15:53,760 --> 00:15:55,700
.نفدت منهم مثلّجات البطّيخ

222
00:15:57,600 --> 00:15:58,540
.يمكنك أكلها

223
00:15:58,540 --> 00:16:00,450
...ماذا؟ لكنّك دفعتِ ثمنها

224
00:16:00,450 --> 00:16:01,540
.إنّها على حسابي

225
00:16:01,540 --> 00:16:03,020
.هـ-هكذا إذًا

226
00:16:04,960 --> 00:16:07,400
هل تعرف تلك الظّريفة؟

227
00:16:07,400 --> 00:16:09,890
.لم أعتقد أنّك قادر على ذلك

228
00:16:11,250 --> 00:16:11,960
أتريدينها؟

229
00:16:11,960 --> 00:16:13,450
ماذا؟ فعلاً؟

230
00:16:13,800 --> 00:16:15,450
.جعلتك تنتظرين

231
00:16:16,520 --> 00:16:18,220
.لا بأس. سآخذها إذًا

232
00:16:19,640 --> 00:16:20,950
.شكرًا لك

233
00:16:23,960 --> 00:16:25,460
.وصلنا

234
00:16:25,460 --> 00:16:27,180
...أليست هذه

235
00:16:27,180 --> 00:16:27,750
.نعم

236
00:16:28,300 --> 00:16:29,770
.المدرسة الابتدائيّة

237
00:16:31,260 --> 00:16:33,070
!مهلاً! هذا ليس آمنًا

238
00:16:33,070 --> 00:16:34,680
.أنا بخير، أنا بخير

239
00:16:39,580 --> 00:16:40,630
.هايري

240
00:16:42,650 --> 00:16:44,280
.عليك الانضمام لي

241
00:16:50,570 --> 00:16:52,790
.هذا عيب في التّصميم

242
00:16:52,790 --> 00:16:54,860
.كان من المؤكّد أنّ الأطفال سيتسلّقون إلى هنا

243
00:16:54,860 --> 00:16:56,320
.ملاحظة ذكيّة

244
00:16:56,890 --> 00:16:59,070
.حسنًا، من هنا الآن

245
00:16:59,070 --> 00:17:00,200
إلى أين سنذهب؟

246
00:17:02,210 --> 00:17:03,220
.إلى هناك

247
00:17:04,740 --> 00:17:07,820
.حيث تبدأ مغامرتنا

248
00:17:16,180 --> 00:17:18,090
!مهلاً، انتبهي

249
00:17:18,440 --> 00:17:19,660
!أنا بخير

250
00:17:19,660 --> 00:17:21,310
.إنّه أمامنا مباشرة

251
00:17:22,300 --> 00:17:26,450
...إن أسعفتني الذّاكرة
.قفل هذه النّافذة مكسور

252
00:17:27,680 --> 00:17:29,530
هل يجدر بنا الدّخول؟

253
00:17:29,530 --> 00:17:31,130
!لا بأس، لا بأس

254
00:17:35,050 --> 00:17:36,400
!تعال بسرعة

255
00:17:38,990 --> 00:17:41,310
ماذا يوجد في الدّاخل هنا؟

256
00:17:43,650 --> 00:17:45,290
!وجدتها

257
00:17:45,290 --> 00:17:47,140
.حمدًا على هذا

258
00:17:47,140 --> 00:17:48,710
.ما زالت هنا

259
00:17:49,660 --> 00:17:50,710
ما هذه؟

260
00:17:50,710 --> 00:17:51,770
.صحيح

261
00:17:51,770 --> 00:17:53,210
.بداية مغامرة

262
00:17:53,210 --> 00:17:58,470
كنتُ أتسلّق إلى هنا مع صديق
.في نهاية الصّيف

263
00:18:00,900 --> 00:18:03,750
ذلك كان استعدادًا لليوم
.الّذي سنجتمع فيه من جديد

264
00:18:03,750 --> 00:18:04,970
...تلك الرّسمة

265
00:18:04,970 --> 00:18:06,110
!هيغينيكو

266
00:18:06,110 --> 00:18:08,420
!كان هذا علم فريقنا

267
00:18:08,420 --> 00:18:11,650
من المخيّم الصّيفيّ الّذي سبق وذكرتِه؟

268
00:18:12,050 --> 00:18:12,810
.نعم

269
00:18:12,810 --> 00:18:19,140
في ذلك الصّيف، أخذنا أنا وذلك
.الصّديق علمنا وخرجنا في مغامرة

270
00:18:20,320 --> 00:18:24,000
.ثمّ أخفينا سرّنا مع هذا العلم

271
00:18:24,000 --> 00:18:25,150
سرّك؟

272
00:18:27,320 --> 00:18:28,740
أواثقة؟

273
00:18:28,740 --> 00:18:29,710
.نعم

274
00:18:36,540 --> 00:18:40,630
...من أجل لقائنا بعد عشر سنوات من الآن"

275
00:18:40,630 --> 00:18:46,520
نُودِع كنز الجزيرة الّذي عثرنا عليه
".اليوم داخل هذا الصّندوق

276
00:18:48,430 --> 00:18:51,210
إذًا فهذا ما في الصّندوق؟

277
00:18:51,210 --> 00:18:51,980
.نعم

278
00:18:53,370 --> 00:18:55,420
.إنّه مغلق بإحكام

279
00:18:55,420 --> 00:18:56,110
هل أفتحه؟

280
00:18:57,430 --> 00:18:58,940
.مهلاً، مهلاً

281
00:18:58,940 --> 00:19:01,140
حسنًا، ما الّذي وجدتماه؟

282
00:19:01,140 --> 00:19:02,110
ما السّرّ؟

283
00:19:13,800 --> 00:19:17,500
.هايري، المنظر من هنا مذهل

284
00:19:27,510 --> 00:19:30,960
.أتيتُ من وراء ذلك البحر

285
00:19:56,200 --> 00:19:58,920
.شكرًا على مرافقتي اليوم

286
00:19:58,920 --> 00:19:59,960
.العفو

287
00:19:59,960 --> 00:20:01,170
هل استمتعت؟

288
00:20:02,410 --> 00:20:03,590
.نوعًا ما

289
00:20:04,030 --> 00:20:07,840
سآخذك في مغامرةٍ أكثر تميّزًا
!في المرّة القادمة

290
00:20:07,840 --> 00:20:09,100
أكثر تميّزًا؟

291
00:20:09,780 --> 00:20:10,600
.نعم

292
00:20:13,610 --> 00:20:14,600
!إلى اللّقاء

293
00:20:15,390 --> 00:20:16,610
.مع السّلامة

294
00:20:21,050 --> 00:20:22,660
مغامرة؟

295
00:20:23,750 --> 00:20:27,030
،ما حدث اليوم لا يرقى لأن يُسمّى مغامرة

296
00:20:27,800 --> 00:20:32,250
لكن في علّيّة المدرسة الابتدائيّة
،خلف سياج المسبح

297
00:20:32,640 --> 00:20:36,170
كان هناك كنز خبّأته كامومي
.عندما كانت طفلة على ما يبدو

298
00:20:36,700 --> 00:20:39,630
.ذلك النّوع من الأشياء يثير الحماسة

299
00:20:39,630 --> 00:20:41,790
.كانت مغامرة بالفعل

300
00:20:44,860 --> 00:20:46,240
ما الأمر؟

301
00:20:46,240 --> 00:20:47,470
.أنا مرهقة

302
00:20:49,160 --> 00:20:53,010
ستكون العودة للبيت أثناء سحب
.هذا الشّيء مزعجة

303
00:20:53,010 --> 00:20:55,190
لِمَ لا تتخلّصين منها في مكانٍ ما؟

304
00:20:55,190 --> 00:20:56,980
.لا يمكنني فعل ذلك

305
00:20:56,980 --> 00:20:58,580
.وأنت تعرف ماذا يعني ذلك

306
00:21:01,870 --> 00:21:03,150
.ستدفعني

307
00:21:07,960 --> 00:21:09,870
.أقدّر لك خدمتك

308
00:21:09,870 --> 00:21:11,330
.وذلك ما يفترض أن تفعلي

309
00:21:11,600 --> 00:21:14,520
كيف نصل إلى منزلك؟

310
00:21:14,520 --> 00:21:16,170
.من هذا الطّريق مباشرة

311
00:21:16,640 --> 00:21:19,010
.مباشرة؟ هذا هو الميناء

312
00:21:19,010 --> 00:21:19,770
.نعم

313
00:21:19,770 --> 00:21:21,340
.خذني إلى الميناء

314
00:21:21,340 --> 00:21:23,450
هل ستستقلّين قاربًا أو شيئًا من هذا القبيل؟

315
00:21:23,450 --> 00:21:24,840
.شيء من هذا القبيل

316
00:21:26,560 --> 00:21:28,340
.كنت أظنّك ذاهبة إلى منزلك

317
00:21:28,660 --> 00:21:32,890
.نوعًا ما نعم، ونوعًا ما لا

318
00:21:32,890 --> 00:21:34,640
لِمَ هذا اللّغز؟

319
00:21:35,720 --> 00:21:37,120
ولِمَ لا؟

320
00:21:37,120 --> 00:21:39,320
أين تعيش يا هايري؟

321
00:21:39,320 --> 00:21:40,040
أنا؟

322
00:21:40,610 --> 00:21:42,500
.في ذلك الاتّجاه على ما أظنّ

323
00:21:43,330 --> 00:21:45,580
.كاتو-سان تعتني بي

324
00:21:45,580 --> 00:21:47,620
.ذاك في الاتّجاه المعاكس

325
00:21:47,620 --> 00:21:49,350
.ربّما ما كان عليّ أن أزعجك بشؤوني

326
00:21:49,350 --> 00:21:51,490
.لا بأس، كنتُ أشعر بالملل على أيّ حال

327
00:21:52,600 --> 00:21:53,990
.يا للطفك

328
00:21:56,880 --> 00:21:59,360
.أنت شخص جيّد

329
00:21:59,360 --> 00:22:00,630
ما الّذي تحاولين قوله؟

330
00:22:00,630 --> 00:22:02,500
.ما قلته بالضّبط

331
00:22:02,760 --> 00:22:04,320
.حسنًا، على الرّحب والسّعة