1
00:00:08,000 --> 00:00:08,810
...لحظة

2
00:00:09,360 --> 00:00:11,740
.لا تبدو هذه السّفينة قديمة جدًّا

3
00:00:14,230 --> 00:00:18,110
.تذكّرتُ أخيرًا كلّ شيء للتّوّ

4
00:00:18,820 --> 00:00:20,790
...عثرتُ على الحقيبة و

5
00:00:20,790 --> 00:00:22,860
الحقيبة؟

6
00:00:22,860 --> 00:00:25,950
.أنا الحقيقيّة هناك

7
00:00:25,950 --> 00:00:26,750
ماذا؟

8
00:00:26,750 --> 00:00:27,710
ما معنى ذلك؟

9
00:00:28,200 --> 00:00:29,490
...هايري

10
00:00:29,490 --> 00:00:30,580
.شكرًا لك

11
00:00:31,030 --> 00:00:33,240
.لأنّك أتيت معي

12
00:00:33,240 --> 00:00:35,720
.ولتحقيق حلمي

13
00:00:37,860 --> 00:00:40,360
...فكما ترى، أنا

14
00:00:40,360 --> 00:00:42,900
...أعتقد أنّك

15
00:00:50,490 --> 00:00:51,820
.مع السّلامة

16
00:01:04,210 --> 00:01:05,040
—كامومي

17
00:01:05,910 --> 00:01:06,930
كامومي؟

18
00:01:07,660 --> 00:01:08,920
!كامومي

19
00:01:15,860 --> 00:01:18,430
تاكاهارا، كيف تُبلي النّظّارات؟

20
00:01:18,730 --> 00:01:21,550
.إنّها تعمل بشكل جيّد

21
00:01:21,550 --> 00:01:24,180
لكن لماذا تملك نظّارات رؤية ليليّة؟

22
00:01:24,610 --> 00:01:26,310
.من باب الحيطة

23
00:01:26,310 --> 00:01:29,900
أين فقدت الحقيبة إذًا؟

24
00:01:30,300 --> 00:01:32,560
.أعتقد أنّها كانت هنا

25
00:01:33,380 --> 00:01:34,940
.أنا واثق أنّها كانت هنا

26
00:01:34,940 --> 00:01:37,430
.جرفني الماء وكدت أغرق

27
00:01:37,430 --> 00:01:39,620
مهلاً، أتلك هي هناك؟

28
00:01:43,240 --> 00:01:46,050
.يا له من كهف بالفعل

29
00:01:46,050 --> 00:01:49,360
.أراهن أنّ بإمكاننا استعماله كنقطة سياحيّة

30
00:01:49,360 --> 00:01:51,710
.كانت هناك خطط في البلديّة للقيام بذلك

31
00:01:52,060 --> 00:01:56,090
ولكن، من الصّعب الحرص
.على أنّه مكان آمن لذلك

32
00:01:56,670 --> 00:01:59,580
.استشاروا مع بعض الشّركات وقاموا بالدّراسات

33
00:01:59,580 --> 00:02:00,820
.مهلاً لحظة

34
00:02:01,920 --> 00:02:04,000
ما الغرض من هذه المفاتيح في رأيكم؟

35
00:02:04,000 --> 00:02:05,600
.ربّما هي مفاتيح ضوء

36
00:02:06,120 --> 00:02:08,570
.اخلعوا نظّاراتكم يا رفاق

37
00:02:12,020 --> 00:02:14,610
قلتَ أنّك كدت تغرق هنا؟

38
00:02:14,610 --> 00:02:16,480
...أعتقد ذلك

39
00:02:17,470 --> 00:02:20,160
.لكنّ المياه لم تكن سطحيّة هكذا

40
00:02:20,670 --> 00:02:23,740
.من المستحيل أن أغرق في جدول كهذا

41
00:02:26,920 --> 00:02:29,620
إذًا... ما الّذي حدث؟

42
00:02:38,520 --> 00:02:39,730
...هذه

43
00:02:40,140 --> 00:02:41,880
هي "حقيقتها"؟

44
00:02:41,880 --> 00:02:44,140
أهذه ملابس داخليّة نسائيّة؟

45
00:02:46,470 --> 00:02:49,600
!ماذا؟ مهلاً، إنّك محقّة

46
00:02:49,600 --> 00:02:51,320
كيف وصلت إلى هنا؟

47
00:02:51,320 --> 00:02:52,600
!هذا غريب

48
00:02:52,600 --> 00:02:53,880
.فهمت

49
00:02:53,880 --> 00:02:55,110
.فهمت بالفعل

50
00:02:57,020 --> 00:03:00,580
!أنا آسف! لا تطرحي أسئلة أكثر رجاءً

51
00:03:02,330 --> 00:03:03,450
.لن أفعل

52
00:03:03,450 --> 00:03:06,160
.لا أريد أيّ علاقة بهذا

53
00:03:16,780 --> 00:03:17,800
ما هذا؟

54
00:03:17,800 --> 00:03:20,720
مغامرات الهيغينيكو

55
00:03:17,800 --> 00:03:20,720
!مغامرات الهيغينيكو؟

56
00:03:29,750 --> 00:03:31,600
!أنا أعرف هذا

57
00:03:32,040 --> 00:03:34,600
.قرأت هذا الكتاب قبل مدّة

58
00:03:35,780 --> 00:03:38,650
.أتت فتاة تُدعى كامومي إلى المخيّم الصّيفيّ

59
00:03:39,400 --> 00:03:43,400
كانت وحدها دائمًا، عاجزة
.عن الانسجام مع بقيّة الأطفال

60
00:03:43,830 --> 00:03:49,910
وذات يوم، تسلّلت إلى مكتب والدها
.عالم الآثار وعثرت على خريطة

61
00:03:50,920 --> 00:03:54,040
استجمعت شجاعتها وتحدّثت
.مع بقيّة الأطفال

62
00:03:54,690 --> 00:03:59,050
.شكّلوا الهيغينيكو وانطلقوا في مغامرة

63
00:04:02,760 --> 00:04:03,740
...غير معقول

64
00:04:06,280 --> 00:04:07,560
،في هذا الكتاب

65
00:04:07,560 --> 00:04:11,970
تعيش كامومي في منزل مستأجر على
.جزيرة صغيرة بعيدة عن اليابسة الرّئيسيّة

66
00:04:12,560 --> 00:04:14,940
مدّة الاتّصال

67
00:04:12,820 --> 00:04:14,940
جزيرة صغيرة غير مأهولة؟

68
00:04:15,380 --> 00:04:16,130
.حسنًا

69
00:04:16,130 --> 00:04:17,620
.سأبحث في الأمر

70
00:04:17,620 --> 00:04:18,640
.شكرًا لك

71
00:04:20,290 --> 00:04:24,590
ثمّة جزيرة صغيرة قرب الخليج
.الّذي قلت إنّك وصلت إليه

72
00:04:25,240 --> 00:04:27,450
.لكنّها جزيرة خاصّة

73
00:04:53,330 --> 00:04:54,430
.المعذرة

74
00:04:58,070 --> 00:04:59,140
من أنت؟

75
00:04:59,140 --> 00:05:01,570
...أ-أنا

76
00:05:01,570 --> 00:05:03,570
...آسف، أنا

77
00:05:05,070 --> 00:05:06,160
...تلك

78
00:05:07,000 --> 00:05:10,420
هل أتيت لتوصل تلك الحقيبة؟

79
00:05:11,600 --> 00:05:12,450
...عفوًا

80
00:05:12,840 --> 00:05:15,620
.إنّها حقيبتي

81
00:05:19,130 --> 00:05:21,710
...هل يعني هذا أنّ كامومي

82
00:05:22,380 --> 00:05:24,010
!تعرف بأمر كامومي؟

83
00:05:25,660 --> 00:05:26,660
...عفوًا

84
00:05:27,600 --> 00:05:29,440
.أنا تاكاهارا هايري

85
00:05:30,760 --> 00:05:33,860
.اسمي كوشيما ساغي

86
00:05:35,760 --> 00:05:38,350
.كامومي ابنتي

87
00:05:40,860 --> 00:05:42,190
فنلندا؟

88
00:05:42,190 --> 00:05:43,240
.نعم

89
00:05:43,240 --> 00:05:46,190
.كامومي هناك منذ سنتين الآن

90
00:05:46,750 --> 00:05:51,450
.لا أعلم كم أخبرتك كامومي عندما التقيتَ بها

91
00:05:52,280 --> 00:05:57,960
،لكنّك أتيت كلّ هذه المسافة إلى هنا لرؤيتها

92
00:05:58,370 --> 00:06:02,340
.لذلك أعتقد أنّه لا بأس أن أخبرك

93
00:06:03,360 --> 00:06:04,500
.بصفتي أمّها

94
00:06:06,470 --> 00:06:07,760
،قبل عشر سنوات

95
00:06:07,760 --> 00:06:13,260
،عمل والدها في الجامعة
.كان يدرس النّباتات والحيوانات

96
00:06:13,260 --> 00:06:16,160
بقينا هنا على هذه الجزيرة لبعض الوقت

97
00:06:16,160 --> 00:06:19,270
عندما تمّت دعوتنا للقيام بعمل
.ميدانيّ لشركة ما

98
00:06:19,270 --> 00:06:24,360
،ابنتي مريضة مذ كانت صغيرة
.لذلك لم يكن لديها أصدقاء كُثر

99
00:06:24,360 --> 00:06:27,900
.قضت معظم وقتها في القراءة

100
00:06:28,320 --> 00:06:31,700
ما كانت تريد القيام به بالفعل
.هو الخروج والاستكشاف

101
00:06:31,700 --> 00:06:34,030
.لكنّها لم تستطع الذّهاب لأيّ مكان

102
00:06:34,030 --> 00:06:38,510
كانت دائمًا ما تحمل كتابًا معها
.بينما تجلس على هذه الحقيبة

103
00:06:38,510 --> 00:06:44,700
.كانت حقيبة والدها
.لقد سافرت إلى أماكن مختلفة

104
00:06:44,700 --> 00:06:47,300
.واثقة أنّ ذلك هو سبب حبّها لها كثيرًا

105
00:06:48,280 --> 00:06:55,560
وبصفتي كاتبة، ألّفتُ رواية
.كانت هي الشّخصيّة الرّئيسة فيها

106
00:06:55,560 --> 00:06:58,540
.إنّها مغامرات الهيغينيكو

107
00:06:59,580 --> 00:07:03,230
.ذكرتْ أمرًا ما ألهمني بتلك الفكرة

108
00:07:03,330 --> 00:07:15,870
توريشيروجيما

109
00:07:03,870 --> 00:07:08,560
ثمّة سفينة قراصنة على هذه
!الجزيرة وجبل من الكنوز

110
00:07:08,560 --> 00:07:11,220
،كانت مجرّد مخيّلة طفلة بالطّبع

111
00:07:11,220 --> 00:07:15,870
،لكنّ ذلك بدأ يزيد من حماستي
.لذلك قرّرت تأليف كتاب

112
00:07:16,310 --> 00:07:20,700
وقد اِستُوحيَ مكان وقوع
.الأحداث من توريشيروجيما

113
00:07:20,700 --> 00:07:21,620
.نعم

114
00:07:22,530 --> 00:07:27,170
...ثمّ في الصّيف الّذي تلا نشر الكتاب

115
00:07:27,170 --> 00:07:30,800
!أمّي، أريد سفينة

116
00:07:30,800 --> 00:07:33,470
...أتقولين أنّ تلك السّفينة

117
00:07:33,470 --> 00:07:36,770
.أحضرتُها بناءً على طلب كامومي

118
00:07:36,770 --> 00:07:39,300
.أرادت تحويلها إلى سفينة قراصنة

119
00:07:41,350 --> 00:07:45,480
.كانت لديها خطّة كبيرة في ذهنها

120
00:07:45,760 --> 00:07:51,270
.شيء تجاوز حتّى قدراتي أنا ككاتبة

121
00:07:51,270 --> 00:07:55,630
حسنًا يا أمّي، سنعيد إنشاء المغامرة
.الّتي في ذلك الكتاب

122
00:07:55,630 --> 00:07:57,120
نعيد إنشاء المغامرة؟

123
00:07:57,120 --> 00:07:58,160
!نعم

124
00:07:58,160 --> 00:07:59,580
!لم يعد مجرّد كتاب الآن

125
00:07:59,580 --> 00:08:03,230
سنُحضر خريطة معنا وسنعثر
!على سفينة قراصنة حقيقيّة

126
00:08:07,940 --> 00:08:09,260
...تاكاهارا-سان

127
00:08:09,260 --> 00:08:09,880
نعم؟

128
00:08:10,400 --> 00:08:13,450
هل ألقيت نظرة داخل قمرة القبطان؟

129
00:08:13,450 --> 00:08:14,320
.لا

130
00:08:14,320 --> 00:08:15,890
.كانت مغلقة

131
00:08:16,720 --> 00:08:21,330
.خُبّئ هناك أعزّ الكنوز على قلبها

132
00:08:32,590 --> 00:08:40,530
اشترينا الجزيرة والخليج الّذين
.ألهما كتابي قبل عشر سنوات

133
00:08:41,160 --> 00:08:43,910
وفي هذه السّنة، اكتمل كلّ شيء

134
00:08:44,500 --> 00:08:48,420
،وكانت بصحّة جيّدة بما يكفي
.لذلك كنّا سندعو الجميع

135
00:08:51,020 --> 00:08:52,290
ما هذه؟

136
00:08:52,290 --> 00:08:53,670
!كان ذلك ممتعًا كثيرًا

137
00:08:53,670 --> 00:08:56,130
.كنتُ متحمّسة طوال الوقت الّذي قرأته فيه

138
00:08:56,130 --> 00:08:58,230
!لن أنسى ذلك أبدًا

139
00:08:58,230 --> 00:09:00,100
!أتمنّى لو كان لديّ أصدقاء مثلها

140
00:09:00,100 --> 00:09:05,640
أين تحدث هذه القصّة؟

141
00:09:02,700 --> 00:09:05,640
أريد الذّهاب في مغامرة
!مع فريق كامومي-تشان

142
00:09:05,640 --> 00:09:07,990
.أريد معرفة ما حدث تاليًا

143
00:09:07,990 --> 00:09:09,680
!سأنتظر مهما تطلّب الأمر

144
00:09:09,680 --> 00:09:11,160
!أحبّ تاكا-كُن

145
00:09:11,160 --> 00:09:12,750
!أريد الزّواج منه

146
00:09:12,750 --> 00:09:15,900
كامومي-تشان، اسمحي لي
!بالانضمام للهيغينيكو

147
00:09:18,160 --> 00:09:21,030
تاكاهارا
هايري

148
00:09:21,030 --> 00:09:24,330
ظننتُ أنّ كامومي-تشان كانت
!رائعة وشجاعة

149
00:09:24,330 --> 00:09:26,550
.لا يوجد أيّ أحد يشبهها في فصلي

150
00:09:26,550 --> 00:09:31,040
.كم أودّ أن أصير صديقًا لفتاة مثلها

151
00:09:38,710 --> 00:09:39,660
.نعم

152
00:09:39,660 --> 00:09:41,640
هلاّ أرسلته في البريد العاجل؟

153
00:09:43,240 --> 00:09:44,190
أمّي؟

154
00:09:44,910 --> 00:09:45,880
.شكرًا لك

155
00:09:49,640 --> 00:09:52,860
تاكاهارا-سان، هل كنت تتّصل بعائلتك؟

156
00:09:54,590 --> 00:09:55,860
هل ستعود للمنزل؟

157
00:10:00,330 --> 00:10:01,810
.لن أعود

158
00:10:01,810 --> 00:10:03,420
.هكذا إذًا

159
00:10:03,420 --> 00:10:06,010
.اتّصلتُ لأطلب إرسال بعض الأغراض لي

160
00:10:06,010 --> 00:10:07,710
بعض الأغراض؟

161
00:10:12,590 --> 00:10:13,840
.ها هو ذا

162
00:10:12,590 --> 00:10:15,710
مغامرات الهيغينيكو

163
00:10:17,130 --> 00:10:19,880
كوشيما
كامومي

164
00:10:19,880 --> 00:10:22,450
.شكرًا على رسالتك

165
00:10:22,450 --> 00:10:28,770
في النّهاية، تواعدت كامومي والفريق على
.اللّقاء والبحث عن سفينة القراصنة ثانية

166
00:10:28,770 --> 00:10:32,180
!تواعدوا أن يجعلوها مغامرة أكبر

167
00:10:32,180 --> 00:10:40,070
إن تمسّكتَ بهذه الذّكرى، فسأدعوك
.إلى مغامرة مذهلة بعد عشر سنوات

168
00:10:40,460 --> 00:10:43,780
.أودّ أن أراك وقتها

169
00:10:46,050 --> 00:10:50,450
ستدعوني في مغامرة مذهلة
بعد عشر سنوات؟

170
00:10:50,450 --> 00:10:53,790
.كانت كامومي تحاول فعلاً الوفاء بذلك الوعد

171
00:10:54,490 --> 00:10:55,170
...لكن

172
00:10:55,960 --> 00:10:58,340
انهارت كامومي؟

173
00:10:59,100 --> 00:11:02,090
.لطالما كانت صحّتها ضعيفة

174
00:11:02,880 --> 00:11:06,510
.مات والدها شابًّا

175
00:11:06,510 --> 00:11:07,850
.بنفس المرض

176
00:11:08,720 --> 00:11:13,240
هل قلت أنّك عثرت على الحقيبة في كهف؟

177
00:11:13,240 --> 00:11:14,110
.نعم

178
00:11:14,670 --> 00:11:16,730
كيف انتهى بها المطاف هناك؟

179
00:11:17,100 --> 00:11:20,670
،أحضرتُ هذه الحقيبة معي للجزيرة

180
00:11:20,670 --> 00:11:24,910
.لكنّي فقدتها عندما نزلنا عليها

181
00:11:24,910 --> 00:11:26,650
فعلاً؟

182
00:11:26,650 --> 00:11:27,550
.نعم

183
00:11:27,550 --> 00:11:31,520
.مررتُ بتجربة غريبة عندما وصلنا إلى هنا

184
00:11:32,310 --> 00:11:38,240
،غفلتُ عن الحقيبة للحظة فحسب
.لكنّها كانت قد اختفت

185
00:11:38,240 --> 00:11:40,020
ماذا حدث يا ترى؟

186
00:11:40,020 --> 00:11:44,720
.رأيتُ تلك الفراشات من قبل

187
00:11:45,070 --> 00:11:52,030
بالتّفكير في الأمر، ربّما كانت
.لها علاقة بكامومي

188
00:11:54,070 --> 00:11:57,110
...لو حصلت كامومي على أمنيتها

189
00:11:57,110 --> 00:12:01,340
لو أنّنا عبرنا الكهف ووجدنا
...سفينة القراصنة بالفعل

190
00:12:01,880 --> 00:12:05,690
...إن نجحت خطّتها كما تصوّرت

191
00:12:06,410 --> 00:12:08,440
.لكنتُ قد غمرتها بالمديح

192
00:12:08,440 --> 00:12:10,620
.إنّها مبدعة بشكل مذهل

193
00:12:11,350 --> 00:12:13,410
.لكنّ الوقت نفد منها

194
00:12:13,700 --> 00:12:16,400
،لو أنّها قضت صيفًا واحدًا آخر هنا

195
00:12:16,400 --> 00:12:18,420
.لكانت خطّتها لتُؤتي أُكلها في النّهاية

196
00:12:18,940 --> 00:12:22,170
إنّها أقرب إلى سفينة أشباح منها
.إلى سفينة قراصنة

197
00:12:22,170 --> 00:12:24,680
.علينا البدء بإعادة طلائها

198
00:12:24,680 --> 00:12:26,840
.ستحتاج لأجزاء جديدة

199
00:12:26,840 --> 00:12:29,430
لنرَ إن كان بإمكاننا الحصول
.على أدوات بثمن رخيص

200
00:12:29,430 --> 00:12:31,640
.أكيد. شكرًا لك

201
00:12:52,880 --> 00:12:54,450
كامومي...؟

202
00:12:56,620 --> 00:12:58,210
مرحبًا. هل أنت مستيقظ؟

203
00:12:58,600 --> 00:13:00,530
.أعتقد ذلك

204
00:13:01,210 --> 00:13:03,510
.من الأفضل ألاّ أكون نائمًا الآن

205
00:13:03,510 --> 00:13:06,060
.ربّما كلّ هذا حلم

206
00:13:06,060 --> 00:13:08,360
أين كنت؟

207
00:13:08,360 --> 00:13:09,530
.لا مكان

208
00:13:10,120 --> 00:13:11,810
.كنت هنا أراقب

209
00:13:12,280 --> 00:13:13,890
.طوال الوقت

210
00:13:15,310 --> 00:13:17,010
.فهمت

211
00:13:17,010 --> 00:13:19,220
.يا إلهي

212
00:13:19,220 --> 00:13:22,920
إذًا كنتِ أنت من جهّزت المفاتيح
والسّفينة وكلّ شيء؟

213
00:13:22,920 --> 00:13:24,260
.آسفة

214
00:13:24,260 --> 00:13:26,820
.لكنّي لم أكن أذكر أيّ شيء من ذلك أيضًا

215
00:13:27,620 --> 00:13:30,080
.نسيت كلّ شيء

216
00:13:30,080 --> 00:13:34,660
قضيتُ معظم أيّامي طريحة الفراش
.في مستشفى خارج البلاد

217
00:13:35,820 --> 00:13:40,910
وفي النّهاية، ما عدت أعرف
.إن كنتُ مستيقظة أم نائمة

218
00:13:41,390 --> 00:13:46,320
ثمّ لم يعد واضحًا أيضًا
.ما هو حقيقيّ وما هو ليس كذلك

219
00:13:47,480 --> 00:13:48,980
.الأمر غريب

220
00:13:48,980 --> 00:13:50,720
،كنتُ في فراشي

221
00:13:50,720 --> 00:13:56,770
والذّكريات الّتي كانت في الكتاب
.فقط صارت واقعًا فجأة

222
00:13:57,910 --> 00:14:00,150
.أتساءل كيف يبلي الجميع

223
00:14:00,150 --> 00:14:04,680
أتعتقدين أنّهم ما زالوا يتذكّرونني؟

224
00:14:05,380 --> 00:14:09,660
...سأتحسّن وأقابل الجميع ثانية

225
00:14:10,320 --> 00:14:15,670
على سفينة القراصنة
.الّتي وجدناها قبل عشر سنوات

226
00:14:16,700 --> 00:14:20,700
في هذا الصّيف، أتيتُ للجزيرة

227
00:14:20,700 --> 00:14:25,730
.لمطاردة حلمي، وأنا أجرّ حقيبة أمّي

228
00:14:26,220 --> 00:14:29,630
.صرتُ جزءًا من الحلم

229
00:14:29,960 --> 00:14:34,890
.صرتُ بالفعل بطلة الرّواية كامومي

230
00:14:35,250 --> 00:14:40,010
لكنّي تذكّرتُ عندما وصلت
...إلى السّفينة معك يا هايري

231
00:14:41,130 --> 00:14:44,650
.أنّ كلّ هذا كان قصّةً من كتاب

232
00:14:46,010 --> 00:14:51,660
.هايري، حقّقتَ حلمي

233
00:14:54,850 --> 00:14:56,650
.هكذا إذًا

234
00:14:57,330 --> 00:15:04,280
.أنا هنا أمامك لأنّي أردتُ أن أراك مرّة أخيرة

235
00:15:04,280 --> 00:15:05,390
مرّة أخيرة؟

236
00:15:07,580 --> 00:15:10,630
.أنا هنا لتوديعك

237
00:15:11,640 --> 00:15:13,550
.عليّ الذّهاب

238
00:15:13,550 --> 00:15:14,430
إلى أين؟

239
00:15:14,930 --> 00:15:17,800
أنت خارج البلاد الآن، صحيح؟

240
00:15:17,800 --> 00:15:19,570
هل ستعودين إلى هناك؟

241
00:15:19,570 --> 00:15:20,510
.لا

242
00:15:23,510 --> 00:15:26,270
.سأذهب لمكان أبعد

243
00:15:26,810 --> 00:15:28,360
أبعد؟

244
00:15:32,180 --> 00:15:34,800
.هايري، شكرًا لك

245
00:15:35,330 --> 00:15:38,120
.على تحقيق حلمي

246
00:15:38,120 --> 00:15:41,580
.ولأنّك صرت صديقي

247
00:16:12,870 --> 00:16:15,280
.عرفتُ أخيرًا معنى سعالك المفاجئ ذاك

248
00:16:16,910 --> 00:16:20,660
سعلتَ وكأنّك كنت توشك
."أن تقول "أنت ظريفة جدًّا

249
00:16:28,380 --> 00:16:29,210
!كامومي

250
00:16:37,060 --> 00:16:40,580
حتّى إن كان ما حدث على هذه
،الجزيرة حلمًا أو هلوسة

251
00:16:41,140 --> 00:16:46,560
سأقضي بقيّة حياتي في فعل
.الأشياء الّتي أؤمن بها

252
00:16:49,530 --> 00:16:52,230
.تاكاهارا-سان، الغداء جاهز

253
00:16:52,680 --> 00:16:53,860
.حسنًا، نعم

254
00:16:53,860 --> 00:16:56,150
ما الّذي تكتبه؟

255
00:16:56,150 --> 00:16:56,990
.رسائل

256
00:16:56,990 --> 00:16:59,490
.إنّها رسائل كثيرة

257
00:16:59,490 --> 00:17:00,480
.نعم

258
00:17:00,480 --> 00:17:04,590
.سأقابل الهيغينيكو في سفينة القراصنة ثانية

259
00:17:04,590 --> 00:17:06,820
.سأجعل حلمها حقيقة

260
00:17:12,610 --> 00:17:14,850
لماذا انتظرت عشر سنوات؟

261
00:17:19,040 --> 00:17:21,880
.اقترحتُ ذلك أيضًا

262
00:17:21,880 --> 00:17:23,850
.لكنّ كامومي رفضت

263
00:17:24,610 --> 00:17:27,690
،كانت تخشى أن يُصابوا بخيبة أمل عندما يروْنها

264
00:17:27,690 --> 00:17:31,730
لأنّها كانت النّموذج الّذي استُلهمت
.منه شخصيّة كامومي في القصّة

265
00:17:31,730 --> 00:17:34,860
،إن... عندما يتحسّن حالي يومًا ما

266
00:17:34,860 --> 00:17:38,570
.سأكون قائدة جيّدة مثل كامومي

267
00:17:38,920 --> 00:17:41,480
.أريد لقاءهم وقتها

268
00:17:41,480 --> 00:17:43,800
.كانت فتاة خجولة

269
00:17:43,800 --> 00:17:46,220
.بذلت كلّ جهدها

270
00:17:46,710 --> 00:17:49,320
.كان حالها يتحسّن ولو كان ببطء

271
00:17:50,430 --> 00:17:56,300
.كانت تستطيع التّحرّك كفتاة عاديّة تقريبًا

272
00:18:01,330 --> 00:18:02,620
.أنا آسفة

273
00:18:06,030 --> 00:18:09,440
.بصراحة، ثمّة أمر لم أخبرك به

274
00:18:10,740 --> 00:18:12,710
،قبل هذا الصّيف

275
00:18:14,000 --> 00:18:17,110
.دخلت كامومي في نوم أبديّ

276
00:18:19,130 --> 00:18:21,990
.شكرًا لك يا تاكاهارا-سان

277
00:18:22,660 --> 00:18:26,620
.جعل لقاؤك عودتي إلى الجزيرة يستحقّ كلّ هذا

278
00:18:36,360 --> 00:18:38,550
.ثمّة أمر لم أخبرك به أيضًا

279
00:18:41,600 --> 00:18:42,640
...فهمت

280
00:18:43,110 --> 00:18:45,550
.ذهبتَ في تلك المغامرة بالفعل

281
00:18:46,300 --> 00:18:51,780
.في الحقيقة، أردتُ شكرها

282
00:18:53,760 --> 00:18:55,870
.أردت إنهاء السّفينة

283
00:18:56,460 --> 00:18:58,520
.أردتُ رؤيتها

284
00:18:59,690 --> 00:19:00,710
...أنا

285
00:19:01,670 --> 00:19:03,060
...أنا واثق

286
00:19:07,160 --> 00:19:10,340
.أنّي أحببتها

287
00:19:14,840 --> 00:19:16,130
قماش كبير؟

288
00:19:16,130 --> 00:19:17,220
.نعم

289
00:19:17,770 --> 00:19:21,260
،تظنّ أنّه لو وُجد عند أحد، لكان عندها
.لكن يبدو أنّ الأمر ليس كذلك

290
00:19:21,640 --> 00:19:22,900
.هكذا إذًا

291
00:19:23,960 --> 00:19:26,510
.بالمناسبة، لم أرَ أومي-تشان

292
00:19:26,510 --> 00:19:27,890
.ذهبت للمنزل البارحة

293
00:19:27,890 --> 00:19:28,620
ماذا؟

294
00:19:29,800 --> 00:19:31,930
.لم تخبرني بأيّ شيء

295
00:19:31,930 --> 00:19:33,420
.هذا مخيّب للآمال

296
00:19:33,420 --> 00:19:36,930
.مع ذلك، كانت تشعر بالفضول تجاهك

297
00:19:36,930 --> 00:19:38,360
ماذا تقصدين بذلك؟

298
00:19:42,250 --> 00:19:44,990
...جهّزتُ كلّ شيء، لكن

299
00:19:45,320 --> 00:19:47,530
هل سيأتون بالفعل؟

300
00:19:47,530 --> 00:19:49,730
ماذا لو لم يحضر أيّ أحد؟

301
00:19:50,220 --> 00:19:52,090
.لا، عليّ أن أؤمن

302
00:19:52,090 --> 00:19:53,570
.كانت هذه أمنية كامومي

303
00:19:54,770 --> 00:19:55,840
!شيروها

304
00:19:56,720 --> 00:19:58,270
ما-ماذا؟

305
00:19:58,270 --> 00:19:59,990
هل لديك قماش كبير؟

306
00:20:01,050 --> 00:20:02,380
لماذا تحتاجه؟

307
00:20:02,380 --> 00:20:03,380
.علم

308
00:20:04,050 --> 00:20:05,010
!وجدتُها

309
00:20:05,010 --> 00:20:06,600
شيروها، أيمكنك الرّسم؟

310
00:20:06,600 --> 00:20:07,510
ماذا؟

311
00:20:18,900 --> 00:20:21,320
.ثمّة الكثير من النّاس

312
00:20:21,320 --> 00:20:22,610
أنت من دعاهم؟

313
00:20:22,610 --> 00:20:23,780
.لا

314
00:20:24,380 --> 00:20:26,360
.لم أكن أنا من دعاهم

315
00:20:26,360 --> 00:20:27,450
من دعاهم إذًا؟

316
00:20:28,330 --> 00:20:29,450
.كامومي

317
00:20:29,450 --> 00:20:31,700
من كلّ هؤلاء النّاس؟

318
00:20:32,070 --> 00:20:33,210
!شيروها

319
00:20:33,560 --> 00:20:34,980
هل أنهيتِه؟

320
00:20:34,980 --> 00:20:37,230
...نعم، لكن

321
00:20:38,840 --> 00:20:40,120
أيمكنني إلقاء نظرة؟

322
00:20:40,120 --> 00:20:41,110
.أكيد

323
00:20:44,510 --> 00:20:47,760
.لا-لا تكن قاسيًا بانتقاداتك رجاءً

324
00:20:48,090 --> 00:20:49,370
...هذا

325
00:20:49,850 --> 00:20:51,240
!مذهل

326
00:20:49,850 --> 00:20:51,240
!آسفة

327
00:20:52,850 --> 00:20:55,820
!إنّه مذهل! رائع

328
00:20:55,820 --> 00:20:58,230
.شكرًا جزيلاً لك

329
00:20:58,500 --> 00:21:01,310
.لا، بل شكرًا لك أنت

330
00:21:10,870 --> 00:21:12,260
.يا كامومي

331
00:21:12,870 --> 00:21:18,040
إن كنت لا تزالين نائمة في مكان
...بعيد ورأيتِ هذا

332
00:21:18,680 --> 00:21:19,880
.فستعرفين أنّه ليس حلمًا

333
00:21:20,570 --> 00:21:23,010
.صار واقعًا الآن، والفضل لك في ذلك

334
00:21:23,010 --> 00:21:24,630
.ذكرياتك حقيقيّة

335
00:21:25,810 --> 00:21:26,840
.أنا أراك

336
00:21:29,330 --> 00:21:30,360
...أنت

337
00:21:30,360 --> 00:21:31,370
.مرحبًا

338
00:21:31,370 --> 00:21:34,810
.يا إلهي. كنتِ هنا طوال الوقت إذًا

339
00:21:35,110 --> 00:21:39,260
كان عليّ رؤية السّفينة وهي ومنتهية، صحيح؟

340
00:21:39,260 --> 00:21:40,850
.بالطّبع

341
00:21:40,850 --> 00:21:46,820
لكن في الحقيقة، لم يعد من
.المفترض أن أكون هنا

342
00:21:47,850 --> 00:21:49,070
.هكذا إذًا

343
00:21:49,410 --> 00:21:54,720
اسمع، أردتُ بشدّة الذّهاب
في الكثير من المغامرات

344
00:21:54,720 --> 00:21:58,530
.كما فعلتُ معك هذا الصّيف

345
00:21:58,530 --> 00:22:01,330
...أردتُ... أردتُ

346
00:22:01,880 --> 00:22:04,130
.لنذهب في مغامرة إذًا

347
00:22:05,240 --> 00:22:06,990
كان ذلك هو الوعد، صحيح؟

348
00:22:06,990 --> 00:22:12,220
سنتقابل هنا بعد عشر سنوات
.ونخرج في مغامرة على هذه السّفينة

349
00:22:13,220 --> 00:22:14,370
.نعم

350
00:22:14,370 --> 00:22:16,730
.سأذهب في رحلة

351
00:22:16,730 --> 00:22:21,360
...سآخذ هذه السّفينة عبر البحر

352
00:22:21,360 --> 00:22:23,360
.وسنتقابل ثانية

353
00:22:23,690 --> 00:22:24,440
!نعم

354
00:22:28,540 --> 00:22:31,320
.حسنًا، تهبّ الرّياح في الاتّجاه الصّحيح

355
00:22:31,320 --> 00:22:32,440
.أعطنا أوامرك

356
00:22:32,440 --> 00:22:33,490
أنا؟

357
00:22:33,490 --> 00:22:34,750
.بالطّبع

358
00:22:34,750 --> 00:22:35,990
.أنت قائدتنا

359
00:22:37,430 --> 00:22:38,860
.معك حقّ

360
00:22:38,860 --> 00:22:39,500
.حسنًا

361
00:22:39,500 --> 00:22:43,170
!أيّها الهيغيميكو، لنبحر

362
00:23:03,250 --> 00:23:05,870
.انتهى الصّيف ثانية

363
00:23:18,950 --> 00:23:22,960
تاكاهارا هايري
توريشيروجيما

364
00:23:19,370 --> 00:23:22,960
.سأبحر في البحار السّبعة للقائك

365
00:23:23,510 --> 00:23:25,040
،مع حبّي

366
00:23:25,040 --> 00:23:28,110
.كوشيما كامومي، قبطانة الهيغينيكو