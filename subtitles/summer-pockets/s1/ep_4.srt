208
00:11:43,480 --> 00:11:45,360
.سيظنّ أنّنا أصدقاء من المدرسة

209
00:11:45,360 --> 00:11:48,060
.نعم، قد يرخي ذلك من دفاعاته

210
00:11:49,060 --> 00:11:50,230
ماذا؟

211
00:11:50,230 --> 00:11:53,060
هل تعتقد أنّ بإمكاننا إيجاد زيّ مدرسيّ؟

212
00:11:55,800 --> 00:11:58,690
.أوُ، أعيريني زيّك المدرسيّ

213
00:11:59,550 --> 00:12:00,150
ماذا؟

214
00:12:00,150 --> 00:12:01,900
.أعيريني زيّك المدرسيّ

215
00:12:01,900 --> 00:12:04,860
!ما-ماذا؟ ذلك من رابع المستحيلات

216
00:12:04,860 --> 00:12:06,310
!أتوسّل إليك

217
00:12:06,310 --> 00:12:08,350
.صديقتي غارقة في الحبّ

218
00:12:08,350 --> 00:12:09,490
.إنّها مفتونة

219
00:12:10,180 --> 00:12:16,630
و-وأنا لستُ معبودة جماهير أو ما شابه
...ولا أعرف التّعامل مع مثل هذا الاهتمام

220
00:12:17,220 --> 00:12:18,580
.قصدتُ أنّها تحبّ الزّيّ المدرسيّ

221
00:12:19,590 --> 00:12:21,630
!عرفتُ ما عنيته

222
00:12:23,260 --> 00:12:26,540
!وأخيرًا، أنا تلميذة

223
00:12:27,640 --> 00:12:29,430
.يبدو ضيّقًا قليلاً

224
00:12:29,970 --> 00:12:31,430
—وخاصّة حول الصّـ

225
00:12:31,430 --> 00:12:32,550
!كلاّ

226
00:12:32,550 --> 00:12:34,660
كلاّ" على ماذا؟"

227
00:12:34,660 --> 00:12:36,050
.لا. لا تهتمّي

228
00:12:36,050 --> 00:12:37,940
.كانت مجرّد حركة لا إراديّة

229
00:12:38,410 --> 00:12:39,300
...حسنًا

230
00:12:39,800 --> 00:12:41,320
!مساء الخير

231
00:12:44,040 --> 00:12:46,200
ماذا؟ أنتما ثانية؟

232
00:12:46,200 --> 00:12:47,450
.مرحبًا

233
00:12:55,250 --> 00:12:56,600
!شيروها

234
00:12:56,600 --> 00:12:57,670
!صديقاك هنا

235
00:13:01,390 --> 00:13:02,170
.مقرف

236
00:13:02,440 --> 00:13:04,110
!لا تقولي ذلك

237
00:13:04,110 --> 00:13:05,200
.مرحبًا

238
00:13:06,130 --> 00:13:07,300
من أنت؟

239
00:13:07,300 --> 00:13:08,680
.أنا كوشيما كامومي

240
00:13:09,340 --> 00:13:10,360
.مرحبًا

241
00:13:11,000 --> 00:13:12,140
ماذا تريدان؟

242
00:13:14,100 --> 00:13:16,480
.المعذرة

243
00:13:16,480 --> 00:13:19,360
حسنًا، أين يعقل أنّهم خبّؤوه؟

244
00:13:25,180 --> 00:13:25,950
!وجدته

245
00:13:25,950 --> 00:13:27,000
.فهمت

246
00:13:25,950 --> 00:13:29,490
مجلّة الفتى الشّابّ الأسبوعيّة

247
00:13:27,000 --> 00:13:28,810
.ثمّة امرأة على الغلاف

248
00:13:28,810 --> 00:13:29,490
.عارية

249
00:13:31,320 --> 00:13:33,000
ذلك ما كنت تبحث عنه؟

250
00:13:33,000 --> 00:13:34,620
!كـ-كـ-كلاّ

251
00:13:39,630 --> 00:13:41,440
.هذا هو الثّالث

252
00:13:41,440 --> 00:13:42,750
!مرحى

253
00:13:42,750 --> 00:13:44,670
ما هذا؟

254
00:13:47,300 --> 00:13:51,490
إنّه مفتاح لفتح قفل صندوق
.يحتوي على كنز الجزيرة

255
00:13:53,240 --> 00:13:54,470
.يبدو ذلك ممتعًا

256
00:13:54,470 --> 00:13:55,700
!فعلاً؟

257
00:13:55,700 --> 00:13:57,020
.نـ-نعم

258
00:13:57,370 --> 00:13:59,770
أتريدين مساعدتنا في إيجاد المفتاح؟

259
00:14:01,440 --> 00:14:02,110
.لا

260
00:14:07,740 --> 00:14:10,410
.فاجأتها بطلبي. لا يمكنني لومها

261
00:14:10,410 --> 00:14:12,560
.تلك هي طبيعتها

262
00:14:12,560 --> 00:14:13,980
.لا داعي للقلق

263
00:14:14,810 --> 00:14:16,330
...ولكن

264
00:14:16,330 --> 00:14:18,510
اسمكم الهيغينيكو، صحيح؟

265
00:14:18,510 --> 00:14:21,540
.يمكنني رؤية لماذا كنتِ القائدة

266
00:14:21,540 --> 00:14:23,540
.هـ-هكذا إذًا

267
00:14:23,540 --> 00:14:25,750
.أنت غريبة في تأكيدك على الأشياء

268
00:14:25,750 --> 00:14:27,020
.إطلاقًا

269
00:14:27,020 --> 00:14:29,150
.إنّك تعطيني فضلاً أكثر ممّا أستحقّ

270
00:14:29,690 --> 00:14:33,350
.أردتُ أصدقاء فحسب. ذلك كلّ شيء

271
00:14:33,850 --> 00:14:37,560
.كنت خجولة وقلقة قرب الغرباء دائمًا

272
00:14:37,960 --> 00:14:43,940
منذ عشر سنوات، دفعني أصدقائي للذّهاب
.إلى معسكر صيفيّ في محاولة لتجاوز ذلك

273
00:14:43,940 --> 00:14:46,320
.لم أستطيع أن أطيق الأمر في البداية

274
00:14:46,790 --> 00:14:51,820
كنت دائمًا وحيدة بينما كان
.الجميع يشكّلون مجموعات

275
00:14:52,380 --> 00:14:56,620
.ثمّ عثرتُ على خريطة في مكتب أبي

276
00:14:57,000 --> 00:14:59,050
.إنّ أبي باحِث

277
00:14:59,050 --> 00:15:02,500
.يبدو أنّه كان يدرس تاريخ هذه الجزيرة

278
00:15:02,820 --> 00:15:06,840
وكان يحتفظ بتلك الخريطة مخبّأة
.بأمان في الجزء الخلفيّ من مكتبه

279
00:15:07,140 --> 00:15:12,740
...كان عليها علامة تقاطع وملاحظة قصيرة

280
00:15:12,740 --> 00:15:15,480
.كلمة "كنز" فقط

281
00:15:16,380 --> 00:15:21,100
.لكن يجب عبور الجبال للوصول إليها

282
00:15:21,100 --> 00:15:25,310
.عرفتُ أنّ الكبار لن يسمحوا لي بالذّهاب

283
00:15:25,880 --> 00:15:31,340
لذلك حاولت إقناع أكثر فتى
.واعد للذّهاب معي

284
00:15:31,340 --> 00:15:32,820
.يا للواقعيّة

285
00:15:32,820 --> 00:15:34,800
.كان اسمه تاكا

286
00:15:34,800 --> 00:15:38,330
.كان مخيفًا قليلاً، لكنّه كان رياضيًّا

287
00:15:38,330 --> 00:15:39,880
.ثمّ التحقت بنا تسوبامي

288
00:15:39,880 --> 00:15:40,970
.وهاياتو أيضًا

289
00:15:40,970 --> 00:15:44,580
.ثمّا صرنا خمسة بعد انضمام سوزومي

290
00:15:46,900 --> 00:15:48,180
ما الخطب؟

291
00:15:48,180 --> 00:15:49,590
أهنالك ما يزعجك؟

292
00:15:49,590 --> 00:15:54,130
.لا. إنّ ذلك يبدو مألوفًا لي لا غير

293
00:15:54,130 --> 00:15:55,590
فعلاً؟

294
00:15:55,590 --> 00:15:57,970
.إذًا فقد خرجتَ في مغامرة أيضًا من قبل

295
00:15:58,370 --> 00:15:59,660
.ذلك ممكن

296
00:16:08,980 --> 00:16:12,650
قلعة السّماء حيث تعيش نسور البحر"؟"

297
00:16:20,290 --> 00:16:22,410
.صرنا بارعين في هذا

298
00:16:22,410 --> 00:16:23,910
.ذلك هو الرّابع

299
00:16:23,910 --> 00:16:24,890
.نعم

300
00:16:24,890 --> 00:16:26,790
.وجدناها جميعها الآن

301
00:16:27,540 --> 00:16:28,380
!هايري

302
00:16:37,350 --> 00:16:38,830
.انهض يا هايري

303
00:16:38,830 --> 00:16:40,210
.طلع الصّباح

304
00:16:44,800 --> 00:16:46,400
.صباح الخير يا هايري

305
00:16:46,820 --> 00:16:49,160
.صـ-صباح الخير

306
00:16:49,160 --> 00:16:50,560
...لماذا أنت

307
00:16:50,560 --> 00:16:54,780
...أنا هو سبب تعرّضك للأذى

308
00:16:55,090 --> 00:16:59,160
.لذلك فكّرتُ في الاعتناء بك للحظة

309
00:16:59,450 --> 00:17:01,240
...أقدّر لك ذلك، ولكن

310
00:17:01,690 --> 00:17:03,630
لماذا ترتدين تلك الملابس؟

311
00:17:03,630 --> 00:17:08,170
أخبرتُ كيوكو-سان أنّي سأساعد
...لبعض الوقت، لذلك

312
00:17:08,170 --> 00:17:10,340
!عرضت عليّ هذه

313
00:17:14,170 --> 00:17:15,230
ما رأيك؟

314
00:17:15,230 --> 00:17:16,430
تبدو جيّدة عليها، صحيح؟

315
00:17:18,610 --> 00:17:22,220
.نعم... أظنّ ذلك

316
00:17:22,220 --> 00:17:24,080
!مرحى

317
00:17:24,080 --> 00:17:26,190
.حسنًا، سأبذل جهدي

318
00:17:45,450 --> 00:17:48,040
إنّها تعمل بجدّ، صحيح؟

319
00:17:48,550 --> 00:17:49,430
.نعم

320
00:17:54,340 --> 00:17:56,510
.هايري، أنا هنا لأغسل ظهرك

321
00:17:57,400 --> 00:17:58,630
!لـ-لماذا؟

322
00:17:58,630 --> 00:18:01,310
.لِمَ لا؟ أتيتُ للمساعدة

323
00:18:01,950 --> 00:18:03,390
...لـ-لكنّك

324
00:18:03,390 --> 00:18:05,890
.لا داعي للخجل

325
00:18:05,890 --> 00:18:07,880
إنّك ترتدي منشفة، صحيح؟

326
00:18:07,880 --> 00:18:08,980
.لا

327
00:18:10,070 --> 00:18:14,540
.حـ-حسنًا، أنا هنا الآن، لذلك سأغسل ظهرك

328
00:18:14,540 --> 00:18:16,150
.لكن ارتدِ منشفة

329
00:18:19,960 --> 00:18:21,270
!ماذا يحدث؟

330
00:18:21,270 --> 00:18:23,780
هل أنت بحاجة لتتحمّس لتلك الدّرجة؟

331
00:18:27,290 --> 00:18:28,540
!آسفة، لا تهتمّ

332
00:18:28,540 --> 00:18:29,980
!لا أستطيع

333
00:18:37,010 --> 00:18:39,510
.حسنًا، لنفتح الصّندوق الآن

334
00:18:39,510 --> 00:18:40,760
.نعم

335
00:18:43,580 --> 00:18:46,560
هذه هي الكنز الّذي كنت تتحدّثين عنه؟

336
00:18:48,350 --> 00:18:49,800
.هذا صحيح

337
00:18:50,270 --> 00:18:51,540
.حمدًا لهذا

338
00:18:51,540 --> 00:18:53,060
.ما زالت هنا

339
00:18:53,610 --> 00:18:54,820
...كامومي

340
00:18:55,240 --> 00:19:00,100
.بصراحة، لم أكن واثقة أنّي سأستطيع استعادتها

341
00:19:01,190 --> 00:19:05,830
.ولكن بمساعدتك، وجدناها

342
00:19:07,520 --> 00:19:09,580
.شكرًا يا هايري

343
00:19:11,710 --> 00:19:12,950
.أنا مسرور لأجلك

344
00:19:13,540 --> 00:19:15,750
ولكن ماذا تكون على أيّ حال؟

345
00:19:16,990 --> 00:19:19,230
.أقصد هذا الشّيء الّذي استعدته

346
00:19:19,230 --> 00:19:20,990
.سرّ الجزيرة

347
00:19:20,990 --> 00:19:25,250
.كنتُ أعتقد أنّه ما كان بداخل الصّندوق

348
00:19:26,140 --> 00:19:30,890
.ما وجدناه ما كان ليتّسع في هذا الصّندوق

349
00:19:30,890 --> 00:19:32,750
أهو كبير لتلك الدّرجة؟

350
00:19:32,750 --> 00:19:34,680
.ضخم للغاية

351
00:19:34,680 --> 00:19:36,230
.لا بدّ أنّه كنز مميّز

352
00:19:36,520 --> 00:19:37,180
.نعم

353
00:19:37,180 --> 00:19:38,430
.هذا مذهل

354
00:19:38,430 --> 00:19:39,890
وما هو؟

355
00:19:39,890 --> 00:19:42,610
.انظر. إنّها تريك ذلك هنا

356
00:19:44,280 --> 00:19:45,260
سفينة؟

357
00:19:45,260 --> 00:19:46,070
.نعم

358
00:19:47,040 --> 00:19:48,660
.إنّنا في جزيرة قبل كلّ شيء

359
00:19:48,660 --> 00:19:49,990
.لا عجب أن نجد سفينة أو سفينتين

360
00:19:49,990 --> 00:19:51,500
.لا، لا، لا

361
00:19:51,850 --> 00:19:53,730
.إنّها ليست سفينة عاديّة

362
00:19:53,730 --> 00:19:55,010
ماذا تقصدين؟

363
00:19:55,010 --> 00:19:56,040
...اسمع

364
00:19:57,240 --> 00:19:59,020
.لن تنالي منّي هذه المرّة

365
00:20:00,110 --> 00:20:03,800
ستقومين بتشويقي ثمّ
سترفضين إخباري، صحيح؟

366
00:20:03,800 --> 00:20:05,390
.كشفتك

367
00:20:05,390 --> 00:20:06,550
.لا

368
00:20:07,020 --> 00:20:09,560
.كنتُ سأخبرك بالفعل هذه المرّة

369
00:20:09,560 --> 00:20:11,520
ماذا؟ فعلاً؟

370
00:20:11,520 --> 00:20:12,810
.فعلاً

371
00:20:12,810 --> 00:20:14,430
!أريد أن أعرف إذًا

372
00:20:14,430 --> 00:20:16,120
فعلاً؟

373
00:20:16,120 --> 00:20:18,810
.أظنّني سأخبرك

374
00:20:18,810 --> 00:20:19,570
.حسنًا

375
00:20:20,250 --> 00:20:21,900
.استمع جيّدًا

376
00:20:22,620 --> 00:20:27,070
.تبعنا الخريطة حتّى نهاية الجزيرة

377
00:20:27,390 --> 00:20:30,950
.خلف الجبال وعبر الكهوف

378
00:20:30,950 --> 00:20:33,210
.كانت رحلة طويلة

379
00:20:34,520 --> 00:20:36,470
...ثمّ عثرنا على

380
00:20:45,410 --> 00:20:46,640
!سفينة قراصنة

381
00:20:46,640 --> 00:20:48,010
ماذا؟

382
00:20:48,010 --> 00:20:49,960
...سفينة قراصنة

383
00:20:49,960 --> 00:20:52,460
مثل الّتي على علمها جمجمة وعظام؟

384
00:20:52,460 --> 00:20:53,230
.نعم

385
00:20:53,230 --> 00:20:54,640
.إحدى سفن القراصنة تلك

386
00:20:54,640 --> 00:20:56,470
،كان عليها جمجمة وعظام متقاطعة

387
00:20:56,470 --> 00:20:58,810
مثل تلك الّتي تراها تنجرف
.قرب أوروبّا أو ما شابه

388
00:21:01,460 --> 00:21:02,440
.تكذبين

389
00:21:02,440 --> 00:21:03,650
.أنا لا أكذب

390
00:21:05,320 --> 00:21:13,000
.بعد أن عثرنا على السّفينة، كان علينا العودة

391
00:21:13,540 --> 00:21:17,080
لكن كان المعسكر الصّيفيّ
.قد انتهى في اليوم التّالي

392
00:21:17,340 --> 00:21:19,880
.ثمّ ذهب كلّ منّا في طريقه

393
00:21:19,880 --> 00:21:23,930
.إذًا فقد وجدتموها وتركتموها هناك

394
00:21:25,140 --> 00:21:29,870
إن افترضنا أنّ ذلك صحيح، أما زالت هناك؟

395
00:21:29,870 --> 00:21:31,220
.يجدر أن تكون كذلك

396
00:21:31,220 --> 00:21:34,740
،في ذلك اليوم، عندما وجدنا سفينة القراصنة

397
00:21:34,740 --> 00:21:38,440
تواعدنا أن نأتي لإيجاد السّفينة
.ثانية بعد عشر سنوات

398
00:21:38,440 --> 00:21:40,110
.ثمّ ودّعنا بعضنا

399
00:21:42,670 --> 00:21:46,200
.لذلك السّبب عدتِ لإيجادها

400
00:21:46,200 --> 00:21:48,270
.في هذا الصّيف، بعد عشر سنوات

401
00:21:48,270 --> 00:21:49,110
.نعم

402
00:21:50,840 --> 00:21:53,620
.كانت الخريطة والمفاتيح لا تزال هنا

403
00:21:56,920 --> 00:21:58,210
.لذلك سأذهب

404
00:21:59,820 --> 00:22:01,220
...مرّة أخرى

405
00:22:01,220 --> 00:22:02,960
.إلى حيث توجد سفينة القراصنة