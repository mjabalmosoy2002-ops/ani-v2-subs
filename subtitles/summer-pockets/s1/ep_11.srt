1
00:00:29,710 --> 00:00:33,010
!أرجوك أن تبدأ ببطء

2
00:00:48,310 --> 00:00:53,360
جيوب صيف

3
00:02:08,390 --> 00:02:11,110
.أستفيق فجأة

4
00:02:11,980 --> 00:02:14,340
.يمتدّ أمامي حقل واسع على مدّ البصر

5
00:02:15,130 --> 00:02:21,050
.إلى جانب ظلّي، يهتزّ خيال ليس بظلّي

6
00:02:22,110 --> 00:02:23,430
...هذا صحيح

7
00:02:23,430 --> 00:02:25,240
.جئت إلى هنا لألعب

8
00:02:26,350 --> 00:02:29,750
.يمسك ظلّي بيد ذلك الخيال

9
00:02:31,040 --> 00:02:34,820
.نخطو معًا إلى قلب الحقل الفسيح

10
00:02:41,360 --> 00:02:42,700
...مرّة أخرى

11
00:03:06,010 --> 00:03:07,660
مرحبًا؟

12
00:03:08,590 --> 00:03:10,660
!استيقظ

13
00:03:10,660 --> 00:03:12,050
!هيّا

14
00:03:12,520 --> 00:03:14,370
!مرحبًا

15
00:03:19,130 --> 00:03:20,630
.استيقظت أخيرًا

16
00:03:20,890 --> 00:03:24,390
عليك أن تبدأ بالاستيقاظ
.وحدك يا هايري-سان

17
00:03:24,390 --> 00:03:26,180
.صباح الخير أومي-تشان

18
00:03:26,180 --> 00:03:28,990
.أسرع. سيبرد الطّعام

19
00:03:31,520 --> 00:03:34,440
هل كانت أومي-تشان تتكلّم هكذا دائمًا؟

20
00:03:34,440 --> 00:03:38,940
.لحظة... قابلتها البارحة فقط
ما الّذي أقوله؟

21
00:03:42,830 --> 00:03:45,810
مرّت ثلاثة أيّام منذ وصولي
إلى الجزيرة إذًا؟

22
00:03:45,810 --> 00:03:48,260
.المكان مملّ جدًّا هنا بالفعل

23
00:03:52,510 --> 00:03:53,930
.لنأكل

24
00:03:59,720 --> 00:04:01,210
...ليس لذيذًا

25
00:04:05,240 --> 00:04:07,260
.لا أتعرّف عليه

26
00:04:09,140 --> 00:04:13,520
،"إذًا فلا بدّ أنّه "تاكا الصّادم
!المضيف الّذي فقد سحره

27
00:04:13,520 --> 00:04:14,390
!ماذا؟

28
00:04:14,390 --> 00:04:16,820
.سمعت أنّ هذا اسمك المهنيّ

29
00:04:16,820 --> 00:04:17,520
!ممّن سمعتِ؟

30
00:04:17,880 --> 00:04:19,400
!من الجدّة كيدو

31
00:04:21,720 --> 00:04:24,780
من المضيف الّذي فقد سحره؟

32
00:04:25,240 --> 00:04:26,380
!العجوز من العبّارة

33
00:04:28,310 --> 00:04:30,200
.تاكاهارا هايري-كُن

34
00:04:30,690 --> 00:04:34,900
تاكاهارا هايري-كُن الّذي وصل
،إلى الجزيرة منذ أوّل البارحة

35
00:04:34,900 --> 00:04:36,540
.تفضّل بالحضور إلى المكتب

36
00:04:36,540 --> 00:04:38,170
ماذا؟ أنا؟

37
00:04:38,170 --> 00:04:40,740
.إنّها تناديك يا تاكا الصّادم

38
00:04:40,740 --> 00:04:42,880
ما الّذي تورّطت فيه يا تاكا الصّادم؟

39
00:04:42,880 --> 00:04:45,510
.لا ينبغي أن تُبقيها تنتظر يا تاكا الصّادم

40
00:04:45,510 --> 00:04:47,890
هلاّ توقّفتنّ عن مناداتي بهذا الاسم؟

41
00:04:49,940 --> 00:04:52,410
حفلة ترحيب؟

42
00:04:52,410 --> 00:04:53,100
من أجلي؟

43
00:04:53,100 --> 00:04:58,360
نطلق على الزّائرين الدّائمين
.للجزيرة اسم المهاجرين

44
00:04:58,360 --> 00:05:00,310
.من عاداتنا التّرحيب بأشخاص مثلك

45
00:05:00,310 --> 00:05:02,680
.لذلك دعنا نقوم بهذا من أجلك فحسب

46
00:05:02,680 --> 00:05:05,240
.تُكرم جزيرتنا توريشيروجيما ضيوفها

47
00:05:05,590 --> 00:05:07,950
.اخرس وارتدِ ملابسك

48
00:05:11,820 --> 00:05:16,540
عفوًا، هل يمكنني أن أحضر شخصًا
آخر معي إلى هذه الحفلة؟

49
00:05:16,930 --> 00:05:18,200
.لا بأس في ذلك

50
00:05:18,200 --> 00:05:22,050
.يُعدّ كلّ من في الجزيرة عائلة

51
00:05:22,050 --> 00:05:23,460
عذرًا؟

52
00:05:23,460 --> 00:05:27,280
.ولماذا قد أذهب؟ اذهب وحدك

53
00:05:27,280 --> 00:05:28,730
.لا تقولي هذا

54
00:05:28,730 --> 00:05:31,300
.هيّا لنتعرّف أكثر على أهل الجزيرة

55
00:05:37,980 --> 00:05:41,690
محجوز

56
00:05:39,480 --> 00:05:41,690
.مرحبًا بكما في جزيرة توريشيروجيما

57
00:05:41,690 --> 00:05:44,850
!مرحبًا بكما في جزيرة توريشيروجيما

58
00:05:44,850 --> 00:05:45,860
.أهلاً بكما

59
00:05:49,110 --> 00:05:50,470
.سررت بلقائكما

60
00:05:50,470 --> 00:05:52,170
.أنا سوراكادو أوُ

61
00:05:52,170 --> 00:05:53,530
!مهلاً، هذا أنت

62
00:05:53,530 --> 00:05:55,980
ماذا؟ هل تعرفان بعضكما؟

63
00:05:55,980 --> 00:05:58,440
!كان يحاول التّقرّب منّي وأنا نائمة

64
00:05:58,440 --> 00:05:59,120
فعلاً؟

65
00:05:59,120 --> 00:05:59,960
.رائع

66
00:06:01,240 --> 00:06:02,750
.لا، لم أفعل

67
00:06:02,750 --> 00:06:05,250
!لكنّك أمسكت بي

68
00:06:05,250 --> 00:06:06,330
فعلاً؟

69
00:06:06,330 --> 00:06:07,340
!رائع

70
00:06:08,210 --> 00:06:11,250
...ربّما تصرّفت بخشونة في النّهاية

71
00:06:11,250 --> 00:06:13,100
!كان عليك أن تكون أكثر لطفًا

72
00:06:13,100 --> 00:06:14,040
فعلاً؟

73
00:06:14,040 --> 00:06:15,180
.رائع

74
00:06:17,980 --> 00:06:20,350
!لم يكن رائعًا

75
00:06:20,350 --> 00:06:22,170
.أنتما منسجمان تمامًا

76
00:06:22,170 --> 00:06:26,190
كما لو كنتما ثنائيًّا في مباراة زوجٍ
.مختلطٍ تلعبان سويًّا منذ سنوات

77
00:06:26,190 --> 00:06:27,300
ومن هذه؟

78
00:06:27,300 --> 00:06:28,930
.إنّها قريبتي

79
00:06:28,930 --> 00:06:30,660
.نقيم في نفس المنزل

80
00:06:35,680 --> 00:06:36,970
.أنا كاتو أومي

81
00:06:36,970 --> 00:06:38,350
.أتيتُ بهذا للجميع

82
00:06:38,350 --> 00:06:39,890
أرزّ مقليّ؟

83
00:06:39,890 --> 00:06:41,070
.كم أنت مهذّبة

84
00:06:41,070 --> 00:06:42,840
لا يسعني الانتظار لرؤية
.ما ستغدين عليه حين تكبرين

85
00:06:44,300 --> 00:06:45,170
ما الأمر؟

86
00:06:45,800 --> 00:06:46,850
.لا شيء

87
00:06:46,850 --> 00:06:48,270
.لا شيء إطلاقًا

88
00:07:10,670 --> 00:07:12,080
.شبعتُ تمامًا

89
00:07:12,080 --> 00:07:14,000
.هاك، بعض الماء

90
00:07:14,000 --> 00:07:15,690
.شكرًا يا سوراكادو

91
00:07:16,170 --> 00:07:17,540
.نادني أوُ

92
00:07:18,620 --> 00:07:20,660
.إنّهم جماعة مليئة بالحيويّة والمرح

93
00:07:21,280 --> 00:07:23,790
.نعرف بعضنا منذ الطّفولة

94
00:07:23,790 --> 00:07:26,100
ونحن أيضًا نكوّن ما يُشبه
.رابطة شباب في الجزيرة

95
00:07:26,100 --> 00:07:28,470
.لم يكن هناك شيء كهذا في مدينتي

96
00:07:28,470 --> 00:07:29,990
.أشعر بشيء من الغيرة

97
00:07:29,990 --> 00:07:33,470
يمكنك الانضمام إلى رابطة
.الشّباب ما دمت هنا

98
00:07:33,470 --> 00:07:36,910
.يكفي أنّك من أقرباء الجدّة كاتو لتكون مؤهّلاً

99
00:07:38,600 --> 00:07:39,970
فعلاً؟

100
00:07:39,970 --> 00:07:41,480
.يبدو ذلك لطيفًا

101
00:07:43,560 --> 00:07:44,670
أين شيروها؟

102
00:07:44,670 --> 00:07:45,230
ماذا؟

103
00:07:45,230 --> 00:07:48,040
كيف تعرف شيروها؟

104
00:07:48,040 --> 00:07:48,770
...حسنًا

105
00:07:49,230 --> 00:07:50,410
.حدثت أمور كثيرة

106
00:07:52,270 --> 00:07:54,320
...سبق ودعوناها بالفعل، لكن

107
00:07:55,340 --> 00:07:56,910
.سآتي إن كان بمقدوري ذلك

108
00:07:56,910 --> 00:07:59,500
.واضح أنّها لن تأتي

109
00:07:59,500 --> 00:08:01,380
.إنّها خجولة جدًّا

110
00:08:02,080 --> 00:08:04,000
.لا تعبث معها

111
00:08:06,010 --> 00:08:07,420
.انظر إليّ

112
00:08:16,070 --> 00:08:18,660
.لم تكوني بحاجة لمرافقتنا للمنزل

113
00:08:18,660 --> 00:08:22,980
ما الّذي تقوله؟ ماذا إن ضعتما؟

114
00:08:22,980 --> 00:08:24,560
.ما أحنّك

115
00:08:24,560 --> 00:08:26,990
.لا أريد أن يحدث هذا لأومي-تشان

116
00:08:26,990 --> 00:08:29,520
.نعم... معك حقّ

117
00:08:29,520 --> 00:08:33,030
،حين أضع أومي-تشان في سريرها
.سأرافقك أنا إلى بيتك

118
00:08:33,030 --> 00:08:35,000
.لا حاجة لذلك إطلاقًا

119
00:08:35,000 --> 00:08:38,780
.نشأتُ في هذه الجزيرة
.لا يمكن أن أضيع

120
00:08:38,780 --> 00:08:42,200
أعني أنّك فتاة، ولا يصحّ
.أن تتجوّلي ليلاً وحدك

121
00:08:43,240 --> 00:08:45,090
.شكرًا لك

122
00:08:45,090 --> 00:08:47,920
.لكن لا مكان أكثر أمانًا من هذه الجزيرة

123
00:08:48,310 --> 00:08:49,460
إنّها آمنة إذًا؟

124
00:08:50,050 --> 00:08:51,630
.بكلّ تأكيد

125
00:09:10,730 --> 00:09:11,880
...طعمه حلو

126
00:09:11,880 --> 00:09:14,560
.لا شكّ أنّها أخطأت بين السّكّر والملح

127
00:09:14,560 --> 00:09:17,160
.مهلاً لحظة، لعلّه أعظم ما صنعت

128
00:09:17,160 --> 00:09:20,580
.قد يكون ثورة في عالم الأرزّ المقليّ

129
00:09:22,410 --> 00:09:23,720
!أو لا

130
00:09:24,510 --> 00:09:26,810
هلاّ ناولتني صلصة الصّويا يا أبي؟

131
00:09:26,810 --> 00:09:27,590
ماذا؟

132
00:09:29,040 --> 00:09:30,920
.لم أقصد أن أناديك بذلك

133
00:09:31,200 --> 00:09:32,250
.لا بأس

134
00:09:32,570 --> 00:09:35,150
الأمر أشبه بمناداة المعلّمة
.بـ"أمّي" عن طريق الخطأ

135
00:09:35,150 --> 00:09:37,430
صـ-صحيح. يحدث ذلك كثيرًا، صحيح؟

136
00:09:48,810 --> 00:09:50,440
.لا تقلق بشأن ذلك الآن

137
00:09:50,710 --> 00:09:53,590
...مرّ يوم آخر وما زلتُ لم أنظّف الكوخ

138
00:09:59,220 --> 00:10:00,570
كلّ هذا بمائة ينّ فقط؟

139
00:10:00,570 --> 00:10:04,220
نكهات الفراولة والبطّيخ واللّيمون
...وهاواي الأزرق

140
00:10:04,220 --> 00:10:06,360
.كلّها بنفس الطّعم في النّهاية

141
00:10:06,360 --> 00:10:07,170
!حقًّا؟

142
00:10:07,170 --> 00:10:09,940
.تعال وتناوله في غرفة الجلوس هناك

143
00:10:09,940 --> 00:10:13,040
.لديّ مروحة. المكان بارد في الدّاخل

144
00:10:13,300 --> 00:10:15,800
.حسنًا، شكرًا. أقدّر لك ذلك

145
00:10:35,030 --> 00:10:38,440
.اسمعي... أنا أرتاد مدرسة للأولاد فقط

146
00:10:38,440 --> 00:10:42,120
لستُ معتادًا على رؤية فتيات
.يرتدين ملابس قليلة

147
00:10:42,120 --> 00:10:44,220
.لكن قد يكون هذا إشارة

148
00:10:44,220 --> 00:10:48,030
ربّما يمكن أن تساعديني لأتأقلم؟

149
00:10:48,810 --> 00:10:50,260
!ما-ما الّذي تعنيه بذلك؟

150
00:10:50,260 --> 00:10:51,900
هل تطلب منّي أن أخلع ملابسي؟

151
00:10:51,900 --> 00:10:56,800
!تريدني شبه عارية فقط لتثير رغباتك؟

152
00:10:58,670 --> 00:11:02,040
،تبلّل ملابسي عن قصد، ثم تلعقه بشهوة

153
00:11:02,040 --> 00:11:04,510
...وتسقطني أرضًا ثمّ تعتلي جسدي

154
00:11:04,510 --> 00:11:08,270
صحيح أنّني لستُ غير مهتمّة
...بالأولاد تمامًا، لكن

155
00:11:08,270 --> 00:11:10,550
.يا إلهي، لدينا مشكلة

156
00:11:10,550 --> 00:11:13,300
.يبدو أنهّا ليست معارضة تمامًا للفكرة

157
00:11:13,840 --> 00:11:14,680
...بالمناسبة

158
00:11:14,680 --> 00:11:15,150
!ماذا؟

159
00:11:15,430 --> 00:11:17,400
هل يمكنني الحصول على بعض الثّلج المبشور؟

160
00:11:17,400 --> 00:11:20,150
.سكبتُ خاصّتي وما زلت عطشانًا

161
00:11:29,700 --> 00:11:31,430
!لماذا رميتَه عليّ هناك؟

162
00:11:31,430 --> 00:11:32,580
!لا، لا تصوّبي هناك

163
00:11:32,580 --> 00:11:34,160
...أيّها الـ

164
00:11:34,160 --> 00:11:35,210
!مهلاً

165
00:11:36,480 --> 00:11:37,620
...هذا مخيف

166
00:11:48,260 --> 00:11:50,870
.لم أتناول أيّ ثلج مبشور

167
00:11:51,480 --> 00:11:53,380
.لكن كان ذلك ممتعًا نوعًا ما

168
00:11:53,380 --> 00:11:56,160
.أشعر وكأنّني تخلّيت عن وقاري قليلاً وانطلقت

169
00:11:59,860 --> 00:12:02,920
.يبدو هذا مثل الحبّ الأوّل

170
00:12:08,530 --> 00:12:10,330
.الثّلج المبشور هنا لذيذ جدًّا

171
00:12:10,330 --> 00:12:11,470
!بون

172
00:12:14,730 --> 00:12:16,800
ألا تملك ما هو أفضل لتفعله؟

173
00:12:16,800 --> 00:12:20,340
.لا تسمح لي كيوكو-سان بالمساعدة في الكوخ

174
00:12:20,340 --> 00:12:22,970
.كما أنّه ليس لديّ مكان آخر أذهب إليه

175
00:12:22,970 --> 00:12:24,470
!يا معلّمة

176
00:12:24,470 --> 00:12:26,400
!أعطينا تقييمًا

177
00:12:27,550 --> 00:12:30,680
جعلتِ الأطفال ينادونك "معلّمة"؟

178
00:12:30,680 --> 00:12:31,220
ماذا؟

179
00:12:31,540 --> 00:12:34,430
.حسنًا، ذلك لأنّ لديّ معرفة واسعة

180
00:12:34,430 --> 00:12:37,310
بدؤوا ينادونني هكذا
.لأنّني أعلّمهم بعض الأشياء

181
00:12:37,310 --> 00:12:41,590
!مهلاً... لماذا تنظر إليّ بهذه النّظرة الحزينة؟

182
00:12:41,590 --> 00:12:43,240
.لا بأس

183
00:12:43,240 --> 00:12:47,730
يحتاج الجميع لأن يشعروا
.بالتّفوّق بين الحين والآخر

184
00:12:47,730 --> 00:12:49,490
!تاكا الصّادم

185
00:12:49,490 --> 00:12:51,670
هل استعدت سحرك؟

186
00:12:51,670 --> 00:12:54,790
ليس عليك أن تظلّ مضيفًا طوال
.حياتك يا تاكا الصّادم

187
00:12:54,790 --> 00:12:56,920
.أنت لها يا تاكا الصّادم

188
00:12:56,920 --> 00:13:00,140
!إلى أيّ حدّ انتشر هذا اللّقب؟

189
00:13:00,140 --> 00:13:01,210
.لا بأس

190
00:13:01,930 --> 00:13:06,050
يتمنّى الجميع لو كانوا شخصًا آخر
.بين الحين والآخر

191
00:13:06,050 --> 00:13:07,630
!الأمر ليس كذلك

192
00:13:07,630 --> 00:13:10,710
!يا تاكا الصّادم! أتحدّاك في مباراة تقييم

193
00:13:10,710 --> 00:13:12,870
هل يمكنكم على الأقلّ
أن تتوقّفوا عن مناداتي بذلك؟

194
00:13:12,870 --> 00:13:14,980
!ستضطرّ لهزيمتنا أوّلاً

195
00:13:16,040 --> 00:13:20,610
بما أنّني الأكبر سنًّا، فيقع عليّ
.عبء تعليمكم قسوة هذا العالم

196
00:13:20,610 --> 00:13:23,650
!سأتأكّد من أن تكون التّقييمات عادلة

197
00:13:23,650 --> 00:13:26,050
لكن لا أريد أن يبدأ أيّ منكم بالبكاء، مفهوم؟

198
00:13:27,430 --> 00:13:30,320
تاكا الصّادم

199
00:13:27,430 --> 00:13:30,320
روميو

200
00:13:27,430 --> 00:13:30,320
شيغيو

201
00:13:27,430 --> 00:13:30,320
تاكومي

202
00:13:31,270 --> 00:13:34,040
!إلى اللّقاء يا معلّمة

203
00:13:34,040 --> 00:13:37,460
!عليك أن تستعيد سحرك يا تاكا الصّادم

204
00:13:37,460 --> 00:13:40,070
!عُدوا إلى منازلكم سالمين

205
00:13:40,070 --> 00:13:41,340
!حاضر

206
00:13:54,020 --> 00:13:55,530
ماذا؟

207
00:13:55,530 --> 00:13:58,290
.أدركتُ للتّوّ أنّك شخص لطيف

208
00:13:58,290 --> 00:14:01,840
...جلبتَ لي أشياءً غريبة عن قصد لتخسر

209
00:14:01,840 --> 00:14:04,730
.كان ذلك تصرّفًا رائعًا منك

210
00:14:06,340 --> 00:14:07,340
...ربّما معك حقّ

211
00:14:07,340 --> 00:14:10,070
انتظر، هل كنتَ تحاول بجدّ؟

212
00:14:10,520 --> 00:14:13,690
!سـ-سحقًا

213
00:14:33,480 --> 00:14:35,060
هل يمكنني الحصول على واحدة؟

214
00:14:35,060 --> 00:14:36,600
.نعم، تفضّل بذلك

215
00:14:36,600 --> 00:14:38,110
.مهلاً، إنّه هايري

216
00:14:38,110 --> 00:14:38,720
.هذه

217
00:14:38,720 --> 00:14:40,140
.ثمنها 200 ألف ينّ

218
00:14:41,700 --> 00:14:42,280
.تفضّلي

219
00:14:42,720 --> 00:14:46,030
.ما زال ينقصك 199,980 ينّ

220
00:14:46,030 --> 00:14:47,320
.أضيفيها إلى حسابي

221
00:14:50,400 --> 00:14:52,550
لماذا الجميع هنا؟ هل تخطّطون لشيء؟

222
00:14:52,550 --> 00:14:57,200
.نعم، كنّا نتحدّث عن المهرجان القادم

223
00:14:57,200 --> 00:14:59,620
يوجد مهرجان إذًا؟

224
00:14:59,620 --> 00:15:03,630
،لهذه الجزيرة مهرجانان
.مهرجان البحر ومهرجان الجبل

225
00:15:03,910 --> 00:15:06,290
.يجذب مهرجان البحر السّيّاح

226
00:15:06,290 --> 00:15:10,110
.ينبغي أن تحضره ما دمتَ ستبقى للصّيف

227
00:15:10,590 --> 00:15:11,880
وماذا عن مهرجان الجبل؟

228
00:15:11,880 --> 00:15:15,260
.هو أقرب إلى طقس تقليديّ منه إلى مهرجان

229
00:15:15,560 --> 00:15:19,270
،على أيّ حال يا هايري
هل سبق لك زيارة "ستارباكس"؟

230
00:15:19,270 --> 00:15:20,710
.نعم، مرّات قليلة

231
00:15:20,710 --> 00:15:23,850
.يبيعون الآن مزيج فرابوتشينو بمذاق المانغو

232
00:15:25,280 --> 00:15:27,380
!نـ-نحن نعمل هنا

233
00:15:27,380 --> 00:15:29,360
!خذ أحاديثك المثيرة إلى مكان آخر

234
00:15:29,650 --> 00:15:32,190
...كان لديّ شعور منذ البداية، لكن

235
00:15:32,190 --> 00:15:33,820
هل أوُ منحرفة؟

236
00:15:33,820 --> 00:15:36,030
.نعم، إنّها منحرفة

237
00:15:36,880 --> 00:15:39,500
!أ... أ... أنا لستُ منحرفة

238
00:15:39,900 --> 00:15:41,220
.إنّها فقط منحرفة في الخفاء

239
00:15:41,220 --> 00:15:42,910
!لست كذلك

240
00:15:47,650 --> 00:15:49,190
!بون

241
00:15:52,340 --> 00:15:54,630
!تبًّا! لماذا لا أستطيع الفوز؟

242
00:15:54,630 --> 00:15:57,720
!أهذا أقصى ما تقدر عليه يا تنزن؟

243
00:15:59,430 --> 00:16:01,710
.يبدو أن اللّعبة انتهت

244
00:16:01,710 --> 00:16:03,100
.أعتقد أنّني سأعود إلى المنزل

245
00:16:03,580 --> 00:16:04,920
.وأنا أيضًا

246
00:16:04,920 --> 00:16:06,730
.يجب أن أخرج في جولة تفقّديّة على الجزيرة

247
00:16:07,030 --> 00:16:10,280
.يبدو أنّك بدأت تشعر وكأنّك في بيتك مؤخّرًا

248
00:16:10,280 --> 00:16:13,840
.ماذا؟ نعم... المكان مريح نوعًا ما

249
00:16:13,840 --> 00:16:14,740
.فهمت

250
00:16:16,290 --> 00:16:18,660
.إذًا، نعتمد عليك للاعتناء بأوُ

251
00:16:20,760 --> 00:16:22,960
الاعتناء بها؟ كيف؟

252
00:16:30,240 --> 00:16:32,330
.انتهى عملي

253
00:16:32,330 --> 00:16:34,680
.إناري، لنعد إلى المنزل

254
00:16:34,680 --> 00:16:37,380
تبدين مرهقة تمامًا. هل أنت بخير؟

255
00:16:38,360 --> 00:16:39,350
.هايري

256
00:16:42,110 --> 00:16:43,820
.أنا بخير

257
00:16:43,820 --> 00:16:45,700
.إلى اللّقاء

258
00:16:50,640 --> 00:16:53,110
."إذًا هذا ما كانت تعنيه بـ"الاعتناء بها

259
00:16:57,660 --> 00:16:59,800
أوُ، هل أنتِ مستيقظة؟

260
00:16:59,800 --> 00:17:02,300
...اخرس

261
00:17:02,300 --> 00:17:03,790
.كلامك غير واضح تمامًا

262
00:17:05,260 --> 00:17:06,170
!احذري

263
00:17:08,630 --> 00:17:11,300
!ليس هناك أيّ شيء مريب هنا، مفهوم؟

264
00:17:15,660 --> 00:17:16,680
.كم هي جميلة

265
00:17:18,900 --> 00:17:19,760
ماذا؟

266
00:17:20,560 --> 00:17:21,970
."قلتُ "كم هي جميلة

267
00:17:23,390 --> 00:17:25,070
أتمانعين إن لمستها؟

268
00:17:25,070 --> 00:17:27,060
...لـ-لم أفعل هذا من قبل

269
00:17:27,530 --> 00:17:30,180
.كن لطيفًا فحسب

270
00:17:32,210 --> 00:17:33,980
.حسنًا، سأبدأ

271
00:17:37,570 --> 00:17:39,030
.مذهل

272
00:17:39,030 --> 00:17:40,760
.إنّها جميلة بالفعل

273
00:17:40,760 --> 00:17:42,090
.هذه الخرزة الزّجاجيّة

274
00:17:42,680 --> 00:17:44,360
!ليست خرزة زجاجيّة عاديّة

275
00:17:44,360 --> 00:17:46,660
.تُسمّى تونبوداما

276
00:17:46,660 --> 00:17:49,390
!مهلاً، هذا ما كنت تتحدّث عنه؟

277
00:17:49,920 --> 00:17:51,720
!أبعد يديك

278
00:17:51,720 --> 00:17:53,460
.لكنّك قلتِ إنّ بإمكاني لمسها

279
00:17:54,890 --> 00:17:56,180
!ا-اخرس

280
00:17:56,180 --> 00:17:58,260
!فقط لا تلمسها مرّة أخرى

281
00:17:58,940 --> 00:18:00,090
.مفهوم

282
00:18:00,520 --> 00:18:02,390
.على أيّ حال، سأوصلك للمنزل. هيّا بنا

283
00:18:11,200 --> 00:18:13,240
.تبدين مرهقة فعلاً

284
00:18:13,240 --> 00:18:14,810
هل تسهرين ليلاً؟

285
00:18:16,190 --> 00:18:18,490
.بدأت واجباتي

286
00:18:20,410 --> 00:18:22,070
!واجباتك؟

287
00:18:22,070 --> 00:18:23,480
!هل يمكنك إخباري عنها؟

288
00:18:23,480 --> 00:18:26,240
.ليست سرًّا أو ما إلى ذلك

289
00:18:26,240 --> 00:18:30,900
عائلتي مسؤولة عن الطّقوس الجبليّة
.الّتي حدّثتك عنها سابقًا

290
00:18:30,900 --> 00:18:35,670
أيعني ذلك أنّكِ من عائلة كاهنات
!تحمي الجزيرة؟

291
00:18:36,230 --> 00:18:37,670
!ما الّذي تفعلينه تحديدًا؟

292
00:18:37,670 --> 00:18:40,430
،لست أدري ما الّذي تتوقّعه

293
00:18:40,430 --> 00:18:45,050
لكنّي لا أملك قوى خارقة كما
.في المانغا أو شيء من هذا القبيل

294
00:18:45,740 --> 00:18:49,020
كلّ ما في الأمر أنّي أتجوّل في الجبل
.ليلاً وأحمل فانوسًا

295
00:18:50,210 --> 00:18:51,900
.هذا مخيّب للآمال

296
00:18:51,900 --> 00:18:53,830
.يا له من أمر مخيّب

297
00:18:53,830 --> 00:18:56,840
!أنت من أسرف في التّوقّعات
!لا يحقّ لك أن تشعر بخيبة أمل

298
00:18:59,360 --> 00:19:02,570
هل تقوم عائلتك كلّها بهذه الأمور؟

299
00:19:02,570 --> 00:19:04,110
.أنا فقط

300
00:19:04,110 --> 00:19:08,750
لا يُسمح لأحدٍ غيري بالصّعود
.إلى الجبل أثناء الطّقوس

301
00:19:08,750 --> 00:19:10,280
وهل هذا آمن؟

302
00:19:10,280 --> 00:19:12,960
.لن يعلم أحد إن حدث لك شيء

303
00:19:13,260 --> 00:19:14,680
.لا بأس

304
00:19:14,680 --> 00:19:18,460
كما قلتُ لك، لا يوجد مكان
.أكثر أمانًا من هذه الجزيرة

305
00:19:18,760 --> 00:19:23,220
.حسنًا، أظنّ أنّ لا بأس بذلك إن كان هذا رأيك

306
00:19:23,220 --> 00:19:24,600
...هايري

307
00:19:26,530 --> 00:19:29,220
هل وقعتَ في حبّي أو شيء من هذا القبيل؟

308
00:19:29,540 --> 00:19:30,430
.لا، ولا بذرّة واحدة

309
00:19:30,430 --> 00:19:33,080
!قل أنّك أحببتني، حتّى وإن لم تكن تقصد

310
00:19:33,080 --> 00:19:34,340
.حسنًا، أحببتك

311
00:19:35,490 --> 00:19:37,180
فـ-فعلاً؟

312
00:19:37,180 --> 00:19:40,740
لا. أنت من طلبت منّي أن أقولها
.حتّى إن لم أقصدها، فقُلتُها

313
00:19:43,240 --> 00:19:46,860
!أنت تسخر منّي تمامًا

314
00:19:47,990 --> 00:19:50,000
هل يمكنني الحصول على واحدة؟

315
00:19:50,480 --> 00:19:51,610
.تفضّل

316
00:19:51,610 --> 00:19:53,630
.طاب يومك

317
00:19:53,630 --> 00:19:55,540
ألا تعمل أوُ اليوم؟

318
00:19:56,770 --> 00:20:01,340
.لا بدّ أنّها مع أي-تشان اليوم من أجل الفحص

319
00:20:01,700 --> 00:20:02,920
أي-تشان؟

320
00:20:07,830 --> 00:20:09,880
.لم تعد أوُ بعد

321
00:20:18,330 --> 00:20:19,400
!أمسكتك

322
00:20:26,600 --> 00:20:28,060
.هربت منّي

323
00:20:33,190 --> 00:20:34,320
ما هذا؟

324
00:20:37,000 --> 00:20:38,250
...أيُعقل

325
00:20:38,750 --> 00:20:40,800
.بدأت واجباتي

326
00:20:42,570 --> 00:20:45,140
هل تلك أوُ؟

327
00:20:59,600 --> 00:21:02,230
.أظنّني رأيتُها هنا في مكانٍ ما

328
00:21:08,510 --> 00:21:09,350
!ها هي

329
00:21:31,260 --> 00:21:32,410
فراشة؟

330
00:21:33,100 --> 00:21:34,410
.إنّها تتوهّج

331
00:21:36,420 --> 00:21:37,310
.تعالي

332
00:21:52,000 --> 00:21:52,660
!من هناك؟

333
00:21:54,960 --> 00:21:55,770
.أنا

334
00:21:56,600 --> 00:21:57,870
هايري؟

335
00:21:57,870 --> 00:21:59,830
لماذا أنت هنا؟

336
00:22:00,760 --> 00:22:03,800
ما قصّة تلك الفراشة؟

337
00:22:06,250 --> 00:22:09,420
يمكنك رؤية الشّيتشييتشو؟