1
00:00:07,410 --> 00:00:08,620
.لا يُعقل

2
00:00:15,000 --> 00:00:18,160
...أومي؟ متى

3
00:00:19,130 --> 00:00:20,410
...أمّي

4
00:00:22,840 --> 00:00:27,540
.سنجعل الصّيف ممتعًا من أجلك ثانية

5
00:00:28,530 --> 00:00:30,170
...سيقوم أبوك وأمّك بذلك

6
00:00:30,720 --> 00:00:33,420
.سأعيد شيروها. أعد بذلك

7
00:00:34,100 --> 00:00:37,550
.أنا ملعونة

8
00:00:38,610 --> 00:00:42,100
.عليّ اكتشاف ما يحدث معها

9
00:01:01,910 --> 00:01:06,410
جيوب صيف

10
00:02:14,570 --> 00:02:16,990
ثلج

11
00:02:17,640 --> 00:02:20,430
قالت أنّها ملعونة؟

12
00:02:20,430 --> 00:02:22,530
هل تدرين أيّ شيء عن ذلك؟

13
00:02:25,640 --> 00:02:27,510
لماذا تريد أن تعرف؟

14
00:02:28,100 --> 00:02:29,750
من أجل أومي-تشان؟

15
00:02:29,750 --> 00:02:31,660
أم من أجل شيروها؟

16
00:02:33,430 --> 00:02:36,420
.من أجلي... على ما أظنّ

17
00:02:36,720 --> 00:02:37,670
ماذا؟

18
00:02:38,060 --> 00:02:42,530
إنّ رؤية أومي وشيروها معًا
.أسعدني بطريقة ما

19
00:02:43,430 --> 00:02:47,120
.كنتُ أهرب بمجيئي إلى الجزيرة

20
00:02:47,600 --> 00:02:52,510
لكنّ رؤيتهما معًا تجعلني أشعر
.أنّ بإمكاني استعادة ما أضعته

21
00:02:53,480 --> 00:02:59,140
أريد جهل هذا صيفًا جيّدًا
.من أجل أومي وشيروها

22
00:03:02,070 --> 00:03:05,490
.كم أنت جشع. أو ربّما مجرّد محبّ للخير

23
00:03:07,480 --> 00:03:13,420
أعرف بالفعل ما قصدته شيروها
...بكلامها ذاك، لكن

24
00:03:13,420 --> 00:03:17,140
.هايري، عليك سماعه بنفسك

25
00:03:29,570 --> 00:03:30,600
.أمسكت بشيء ما

26
00:03:32,140 --> 00:03:33,560
!صـ-صحيح

27
00:03:36,370 --> 00:03:38,860
.يشبه مذاق نجم البحر الأوني

28
00:03:38,860 --> 00:03:40,700
إذًا فهو طعام فاخر؟

29
00:03:43,240 --> 00:03:46,360
.إنّ أومي بانتظارك يا شيروها

30
00:03:49,180 --> 00:03:51,830
.سبق وأخبرتك أنّي لن ألعب دور الأمّ بعد الآن

31
00:03:52,110 --> 00:03:54,980
هل لذلك علاقة بكونك "ملعونة"؟

32
00:03:55,640 --> 00:03:58,240
.اعتذرتِ لي البارحة

33
00:03:58,240 --> 00:04:00,860
ما كنتِ لتفعلي ذلك لو لم يكن
.هذا الأمر يقلقني بطريقة ما

34
00:04:00,860 --> 00:04:04,810
.أريدك أن تظلّ بعيدًا عنّي عندما أخبرك

35
00:04:04,810 --> 00:04:06,720
.لا يمكنني أن أعدك بذلك

36
00:04:07,050 --> 00:04:08,390
.لن أخبرك إذًا

37
00:04:08,390 --> 00:04:10,810
.سأواصل ملاحقتك إذًا حتّى تخبريني

38
00:04:13,310 --> 00:04:14,480
"!دوسكوي"

39
00:04:16,360 --> 00:04:18,830
.مـ-مرّ وقت طويل

40
00:04:18,830 --> 00:04:21,690
.لكنّ وقعها كان صعبًا لسبب ما أيضًا

41
00:04:21,690 --> 00:04:24,280
.لا يهمّ، ما زلتُ أريدك أن تخبريني

42
00:04:28,500 --> 00:04:31,450
...بإمكاني رؤيته

43
00:04:32,840 --> 00:04:33,910
.المستقبل

44
00:04:37,360 --> 00:04:42,100
،وفي المستقبل الّذي رأيته
.آخذ النّاس معي

45
00:04:42,890 --> 00:04:47,010
لذلك السّبب كنتُ أحاول
.عدم التّقرّب من أيّ أحد

46
00:04:47,320 --> 00:04:49,720
قد يكون كلّ ذلك مصادفة، صحيح؟

47
00:04:49,720 --> 00:04:50,580
.نعم

48
00:04:51,450 --> 00:04:53,930
.حاولتُ التّفكير كذلك أيضًا

49
00:04:54,640 --> 00:04:56,200
.فكّرتُ في تغييره

50
00:04:56,200 --> 00:04:57,490
.فكّرتُ في الهرب

51
00:04:57,490 --> 00:04:59,330
.فكّرتُ في كلّ شيء

52
00:04:59,930 --> 00:05:05,820
لكنّ كلّ شيء يأخذني
.إلى نفس المستقبل الّذي أراه

53
00:05:07,730 --> 00:05:09,700
.لا تبدو متفاجئًا

54
00:05:10,210 --> 00:05:12,680
أعتقد أنّك ما كنت لتتفاجأ بعد
ما حدث مع أومي-تشان، صحيح؟

55
00:05:12,680 --> 00:05:13,910
.نعم

56
00:05:14,170 --> 00:05:15,480
.وأنا كذلك

57
00:05:16,280 --> 00:05:18,990
.تقبّلتُ أنّه من الممكن رؤية المستقبل

58
00:05:19,710 --> 00:05:22,870
.وأنّه لا يمكن تغيير المستقبل الّذي أراه

59
00:05:23,360 --> 00:05:26,160
.ساعدَتْني على إدراك ذلك

60
00:05:27,170 --> 00:05:28,720
...لذلك في هذا الصّيف، سوف

61
00:05:29,890 --> 00:05:31,140
...شيروها

62
00:05:31,680 --> 00:05:33,100
ما الّذي رأيته بالضّبط؟

63
00:05:35,080 --> 00:05:36,400
.بحر مظلم

64
00:05:37,750 --> 00:05:39,320
.والأمطار تتهاطل

65
00:05:41,320 --> 00:05:44,330
.أشاهد وأنا تحت الماء

66
00:05:45,110 --> 00:05:47,720
،وفي السّطح فوقي

67
00:05:48,270 --> 00:05:50,260
.ثمّة أضواء لا تُحصى

68
00:05:51,720 --> 00:05:53,460
لماذا قد تكونين في البحر؟

69
00:05:53,460 --> 00:05:54,870
.طقوس ناتسودوري

70
00:05:55,880 --> 00:05:57,510
.إنّها مهرجان جزيرة

71
00:05:57,510 --> 00:06:02,620
سألعب الدّور الرّئيسيّ على متن قارب

72
00:06:02,620 --> 00:06:05,380
.لإرشاد أرواد أسلافنا إلى الحياة الآخرة

73
00:06:05,790 --> 00:06:11,390
.لا بدّ أنّ شيئًا ما سيحدث وسأقع في الماء

74
00:06:12,130 --> 00:06:13,320
.إنّه مؤلم

75
00:06:13,880 --> 00:06:15,540
.لا يمكنني التّنفّس

76
00:06:16,320 --> 00:06:17,810
.وصدري يؤلمني

77
00:06:20,920 --> 00:06:23,880
.إذًا فهذا ما كنت تحاولين مجابهته

78
00:06:25,660 --> 00:06:31,370
كنتِ تتدرّبين في المسبح ليلاً
.لتستطيعي تفادي الغرق

79
00:06:32,220 --> 00:06:35,190
.لكنّي لم أحقّق أيّ شيء

80
00:06:36,000 --> 00:06:39,900
ساعدتني أومي-تشان على إدراك
.أنّ المستقبل لن يتغيّر

81
00:06:39,900 --> 00:06:41,170
.إنّه ثابت

82
00:06:41,170 --> 00:06:42,080
—ذلك ليس

83
00:06:42,080 --> 00:06:43,040
...رجاءً

84
00:06:44,560 --> 00:06:46,170
.لا تقترب منّي بعد الآن

85
00:06:48,710 --> 00:06:53,680
.كان يفترض بي أن أكون وحدي

86
00:06:54,660 --> 00:06:58,070
.لكي لا يؤثّر مصيري بأيّ أحد آخر

87
00:06:59,370 --> 00:07:01,560
.لكنّي ما زلتُ آسفة

88
00:07:02,600 --> 00:07:09,460
.كان الوقت الّذي قضيتُ معكما ممتعًا جدًّا، جدًّا

89
00:07:11,320 --> 00:07:12,660
!شيروها

90
00:07:20,080 --> 00:07:21,180
.سُحقًا

91
00:07:30,400 --> 00:07:31,670
!أبي

92
00:07:32,180 --> 00:07:33,550
أين أمّي؟

93
00:07:34,570 --> 00:07:35,620
.آسف

94
00:07:36,870 --> 00:07:39,630
لن تعود أمّي؟

95
00:07:49,850 --> 00:07:52,860
.رأيتك تقرئينها من قبل

96
00:07:52,860 --> 00:07:55,070
.إنّها رسالة من أمّي

97
00:07:57,590 --> 00:07:59,450
...هذه الكلمات صعبة جدًّا

98
00:08:00,110 --> 00:08:01,450
لا يمكنك قراءتها؟

99
00:08:03,210 --> 00:08:05,820
.لكنّي ظننتُ أنّها كانت تقرؤها في ذلك اليوم

100
00:08:06,690 --> 00:08:07,920
أتريدين منّي قراءتها لك؟

101
00:08:08,210 --> 00:08:09,170
.نعم

102
00:08:13,060 --> 00:08:14,680
".اقرئيها حين تكونين حزينة"

103
00:08:16,680 --> 00:08:18,240
.حسنًا، سأبدأ

104
00:08:18,910 --> 00:08:22,810
".حين تكونين حزينة، لا داعي لكبح نفسك"

105
00:08:23,240 --> 00:08:25,250
.عبّري عن أفكارك الصّادقة بالكلمات

106
00:08:25,800 --> 00:08:28,020
.أخبري شخصًا مقرّبًا منك

107
00:08:28,770 --> 00:08:31,310
،حتّى إن لم تتمكّني من تحمّل الأمر وحدك

108
00:08:31,880 --> 00:08:35,360
.ستتجاوزينه حين تشاركينه مع غيرك

109
00:08:35,360 --> 00:08:37,340
".مدّي يدك"

110
00:08:37,960 --> 00:08:42,250
".إن شعرتِ بالدّفء، فستكونين بخير"

111
00:08:44,870 --> 00:08:46,200
...أمّي

112
00:08:46,870 --> 00:08:48,170
...شيروها

113
00:08:48,930 --> 00:08:52,120
ما الّذي كنتِ تمرّين به
عندما كتبتِ هذه الرّسالة؟

114
00:08:53,260 --> 00:08:54,370
...وأنتِ يا أومي

115
00:08:55,090 --> 00:08:58,760
ما الّذي كنتِ تمرّين به
عندما قرأتِ هذه الرّسالة؟

116
00:09:00,520 --> 00:09:02,580
ماذا تريدين أن تفعلي يا أومي؟

117
00:09:03,290 --> 00:09:05,770
ما أكثر ما تتمنّينه الآن؟

118
00:09:06,670 --> 00:09:09,060
.أريد أن أرى أمّي

119
00:09:10,180 --> 00:09:11,070
.حسنًا

120
00:09:11,530 --> 00:09:13,270
.يمكنك الاعتماد على أبيك

121
00:09:14,780 --> 00:09:15,640
!حسنًا

122
00:09:18,450 --> 00:09:20,190
!منزل جدّي

123
00:09:20,670 --> 00:09:22,520
كيف هو الجدّ؟

124
00:09:22,520 --> 00:09:24,250
.إنّه طيّب جدًّا

125
00:09:24,520 --> 00:09:25,690
فعلاً؟

126
00:09:26,180 --> 00:09:29,250
.لن يمانع أن نزوره من دون موعد إذًا

127
00:09:51,050 --> 00:09:52,110
!هايري

128
00:09:52,110 --> 00:09:53,380
.شيروها

129
00:09:53,860 --> 00:09:55,110
.هيّا يا أومي

130
00:09:55,110 --> 00:09:56,400
...أمّي

131
00:09:57,640 --> 00:09:58,820
...أومي-تشان

132
00:09:59,490 --> 00:10:01,160
.جئنا لنتحدّث

133
00:10:01,740 --> 00:10:03,320
.أومي قلقة عليك أيضًا

134
00:10:04,780 --> 00:10:08,550
.قلتُ لكما ألاّ تقتربا منّي

135
00:10:08,550 --> 00:10:09,960
.لا أريد أن تتورّطا في الأمر

136
00:10:09,960 --> 00:10:11,860
وأنا قلتُ لك أنّي لا أستطيع
.نسيان الأمر ببساطة

137
00:10:11,860 --> 00:10:13,440
أنتِ من في خطر، أليس كذلك؟

138
00:10:13,440 --> 00:10:15,670
لا أعرف عن هذه الطّقوس
...أو ما شابه، ولكن

139
00:10:15,670 --> 00:10:17,010
!اخرس أيّها الفتى

140
00:10:17,920 --> 00:10:20,220
لا أدري من أين سمعتَ تلك
،الشّائعة السّخيفة

141
00:10:20,220 --> 00:10:23,070
!لكن يبدو أنّك صدّقتها

142
00:10:23,070 --> 00:10:24,810
.هذه جزيرة صغيرة

143
00:10:24,810 --> 00:10:28,490
تنتشر الأقاويل الباطلة كالنّار وتزعج النّاس

144
00:10:28,490 --> 00:10:31,690
.وجعلت شيروها منعزلة

145
00:10:31,690 --> 00:10:32,560
—منعـ

146
00:10:32,880 --> 00:10:37,950
.سيغيّر أداؤها لدورها في طقوس ناتسودوري ذلك

147
00:10:38,440 --> 00:10:40,860
!عندها لن تبقى حفيدتي وحيدة بعد الآن

148
00:10:40,860 --> 00:10:43,070
!كَوْنُ شيروها منعزلة هو خطؤها هي

149
00:10:43,070 --> 00:10:43,950
—منعـ

150
00:10:44,280 --> 00:10:47,750
،إنّها خائفة من أنّه إن كانت الشّائعات صحيحة

151
00:10:47,750 --> 00:10:50,410
.فستؤذي من حولها

152
00:10:50,410 --> 00:10:53,080
!لقد عزلت نفسها لأنّها تفكّر في الآخرين فقط

153
00:10:55,020 --> 00:10:58,120
.كفّا عن الحديث عنّي هكذا رجاءً

154
00:10:58,120 --> 00:10:59,010
.أعتذر

155
00:10:58,120 --> 00:10:59,010
.آسف

156
00:11:00,270 --> 00:11:02,550
.لكنّك لست وحيدة بعد الآن

157
00:11:03,960 --> 00:11:07,190
.كنتِ معنا نحن الاثنين هذا الصّيف

158
00:11:09,760 --> 00:11:11,810
.نحن نقضي وقتنا معًا

159
00:11:12,520 --> 00:11:13,980
...أمّي

160
00:11:14,300 --> 00:11:15,730
...أومي-تشان

161
00:11:16,120 --> 00:11:17,820
.لنواصل البقاء معًا من الآن فصاعدًا

162
00:11:18,480 --> 00:11:22,150
.سأحميك من المستقبل الخطير الّذي رأيتِه

163
00:11:22,690 --> 00:11:23,750
...هايري

164
00:11:24,160 --> 00:11:25,140
.يا فتى

165
00:11:26,030 --> 00:11:29,610
،فقدت حفيدتي والديها وهي صغيرة

166
00:11:29,610 --> 00:11:32,490
...وقرّرتُ أن أحميها بنفسي

167
00:11:33,420 --> 00:11:37,460
!من فتيان المدينة الثّرثارين مثلك

168
00:11:37,460 --> 00:11:41,170
أرني معدنك الحقيقيّ قبل
!أن تبدأ الثّرثرة أيّها الوقح

169
00:11:41,170 --> 00:11:43,970
!حسنًا، هيّا بنا! جاهز لمواجهتك

170
00:11:45,670 --> 00:11:46,880
.تمهّل

171
00:11:47,390 --> 00:11:49,220
.لستُ مهتمًّا بأن أتسبّب في إيذائك

172
00:11:49,990 --> 00:11:54,480
...سنحسم هذا بالرّياضة التّقليديّة للجزيرة

173
00:11:54,480 --> 00:11:56,600
!القتال تحت الماء

174
00:11:57,480 --> 00:12:02,320
.تتدلّى من تلك العوّامات حبال لتشكيل حلبة

175
00:12:02,320 --> 00:12:05,320
أوّل من يرمي خصمه خارجها
.في الماء هو الفائز

176
00:12:05,610 --> 00:12:07,580
في الماء؟

177
00:12:16,090 --> 00:12:17,130
...هايري

178
00:12:17,130 --> 00:12:19,690
.هل أنت متردّد؟ تبدو شاحبًا

179
00:12:19,690 --> 00:12:21,130
.توقّف يا جدّي

180
00:12:23,630 --> 00:12:25,290
.أنا بخير يا شيروها

181
00:12:25,290 --> 00:12:26,230
...لكن

182
00:12:29,000 --> 00:12:29,970
.سيكون بخير

183
00:12:31,470 --> 00:12:32,600
...أومي

184
00:12:32,600 --> 00:12:33,850
...أومي-تشان

185
00:12:35,000 --> 00:12:36,560
.سأكون بانتظارك

186
00:12:36,560 --> 00:12:38,560
.تعال عندما تكون مستعدًّا

187
00:12:39,760 --> 00:12:41,340
!نحن هنا يا هايري

188
00:12:41,340 --> 00:12:43,230
!وصلت فرقة التّشجيع الخاصّة بك

189
00:12:43,230 --> 00:12:43,820
—يا رفاق

190
00:12:45,790 --> 00:12:47,200
من أين أبدأ حتّى؟

191
00:12:47,510 --> 00:12:49,660
—تفتقر هذه الجزيرة إلى التّرفيـ

192
00:12:50,480 --> 00:12:52,410
.ذلك العجوز ليس سهلاً

193
00:12:52,410 --> 00:12:55,000
—كلّنا هنا لنستمتع بـ

194
00:12:55,800 --> 00:12:57,670
.التّعاون هو مفتاح النّصر

195
00:12:57,670 --> 00:13:00,670
.سأعطيك إرشادات من مقاعد المشاهدين

196
00:13:00,670 --> 00:13:02,340
.لنهزمه معًا

197
00:13:02,340 --> 00:13:04,880
!أريد أن أساعد أبي أيضًا

198
00:13:04,880 --> 00:13:07,700
.لكنّني سأكون تحت الماء

199
00:13:08,680 --> 00:13:10,120
.شكرًا على أيّ حال

200
00:13:10,120 --> 00:13:12,010
.لم أعد متوتّرًا الآن

201
00:13:12,010 --> 00:13:14,450
.أومي، أنا ذاهب

202
00:13:14,450 --> 00:13:15,340
!حسنًا

203
00:13:28,300 --> 00:13:29,810
.أنا بخير

204
00:13:29,810 --> 00:13:31,280
.ما زال بإمكاني السّباحة

205
00:13:31,680 --> 00:13:33,750
.منحتني أومي الشّجاعة

206
00:13:36,810 --> 00:13:38,000
!أنت هنا سلفًا

207
00:13:38,190 --> 00:13:39,940
!وقح متعجرف

208
00:13:41,140 --> 00:13:41,920
!إنّه سريع

209
00:13:43,980 --> 00:13:45,780
!شاهد قبضة غنبو خاصّتي

210
00:13:46,070 --> 00:13:46,550
!كلاّ

211
00:13:46,550 --> 00:13:48,010
!...تبًّا، إنّه دوري الآن

212
00:13:50,110 --> 00:13:51,760
.أنت لا تحاول حتّى

213
00:13:52,780 --> 00:13:54,470
—بوهاهاهاها

214
00:13:56,120 --> 00:13:57,880
!هذا سيّئ! لم أعد أستطيع التّنفّس

215
00:14:02,880 --> 00:14:03,860
لا تستطيع التّنفّس، أليس كذلك؟

216
00:14:03,860 --> 00:14:05,570
!يمكنك الاستسلام متى شئت

217
00:14:05,570 --> 00:14:08,070
...بإمكانه رميي خارج الحلبة بسهولة

218
00:14:08,070 --> 00:14:10,850
.لكنّه يحاول فقط أن يجعلني أستسلم

219
00:14:12,450 --> 00:14:13,460
...هذا سيّئ

220
00:14:13,990 --> 00:14:15,820
.أنا بحاجة للتّنفّس بشدّة

221
00:14:17,300 --> 00:14:18,330
!كلاّ

222
00:14:18,330 --> 00:14:22,980
!خسرتُ الكثير قبل أن آتي إلى هذه الجزيرة

223
00:14:22,980 --> 00:14:23,880
...ومع ذلك

224
00:14:24,110 --> 00:14:25,400
!اعرف متى تستسلم

225
00:14:25,590 --> 00:14:27,130
!سأنهي هذا هنا والآن

226
00:14:27,360 --> 00:14:29,550
!اخرج من هنا

227
00:14:30,420 --> 00:14:32,880
!لا أريد أن أهرب بعد الآن

228
00:14:33,390 --> 00:14:37,140
!أبي! تشجّع

229
00:14:37,140 --> 00:14:37,980
!أومي

230
00:14:38,330 --> 00:14:40,440
!انتهى الأمررررر

231
00:14:42,130 --> 00:14:42,650
!ماذا؟

232
00:14:44,590 --> 00:14:45,360
!ليس بهذه السّرعة

233
00:14:48,150 --> 00:14:49,700
!ماذااا؟

234
00:14:56,250 --> 00:15:01,620
!أبي

235
00:15:01,990 --> 00:15:02,870
ماذا؟

236
00:15:03,410 --> 00:15:04,160
.أومي

237
00:15:04,560 --> 00:15:05,700
.رفاق

238
00:15:05,700 --> 00:15:06,530
...عفوًا

239
00:15:06,530 --> 00:15:08,670
هـ-هل فزت؟

240
00:15:08,670 --> 00:15:10,420
!نعم. لقد كان ذلك مذهلاً

241
00:15:10,420 --> 00:15:13,090
لا أصدّق أنّك أسقطت واحدًا
.من الملوك الأربعة

242
00:15:13,090 --> 00:15:14,410
.نعم، نعم

243
00:15:14,410 --> 00:15:17,430
!هزمتَ جدّ شيروها بالفعل

244
00:15:17,430 --> 00:15:23,260
لكنّك كدت أن تغرق، وكذلك
.شيروها حين حاولت إنقاذك

245
00:15:23,260 --> 00:15:24,690
.كان ذلك محبطًا قليلاً

246
00:15:24,690 --> 00:15:25,870
.هكذا إذًا

247
00:15:25,870 --> 00:15:27,390
.لقد فزتُ إذًا

248
00:15:27,390 --> 00:15:28,760
مهلاً، كدتُ أغرق؟

249
00:15:28,760 --> 00:15:30,110
!وشيروها أيضًا؟

250
00:15:34,000 --> 00:15:35,450
.لا تُعرّض نفسك للخطر

251
00:15:35,450 --> 00:15:38,080
انسي أمري. لماذا عرّضت أنت نفسك للخطر؟

252
00:15:38,080 --> 00:15:39,270
...ذلك

253
00:15:39,270 --> 00:15:41,290
.تحرّك جسدي من تلقاء نفسه

254
00:15:41,290 --> 00:15:47,000
وفي النّهاية، اضطررتُ
.لإنقاذكما معًا. لم تُحقّقا شيئًا

255
00:15:47,000 --> 00:15:47,800
...عفوًا

256
00:15:48,520 --> 00:15:49,940
.شكرًا لك

257
00:15:50,440 --> 00:15:53,820
.يبدو الخاسر أحمقًا عندما يكون الفائز بائسًا

258
00:15:53,820 --> 00:15:56,720
لذلك، ماذا تريد منّي؟

259
00:15:57,680 --> 00:15:59,390
.أريد حماية شيروها

260
00:15:59,390 --> 00:16:02,480
.دعني أبقى بجانبها أثناء الطّقوس

261
00:16:03,710 --> 00:16:04,980
.لا أستطيع السّماح بذلك

262
00:16:05,310 --> 00:16:06,520
!لِمَ لا؟

263
00:16:06,520 --> 00:16:10,190
وحدهم المشاركون في الطّقوس
.يمكنهم الحضور

264
00:16:10,190 --> 00:16:12,150
.والاستثناء الوحيد هو للعائلة

265
00:16:12,150 --> 00:16:14,470
.هذه الطّقوس مهمّة للجزيرة

266
00:16:14,470 --> 00:16:15,860
.يجب الحفاظ على تقاليدها

267
00:16:15,860 --> 00:16:17,290
...مستحيل

268
00:16:17,290 --> 00:16:20,240
لكن كيف أساعد شيروها إذًا؟

269
00:16:20,630 --> 00:16:22,850
.لستُ سعيدًا بهذا أيضًا

270
00:16:22,850 --> 00:16:26,630
.لقد أثبتَّ نفسك كما وعدت

271
00:16:29,590 --> 00:16:30,820
.سيكون الأمر بخير

272
00:16:30,820 --> 00:16:31,740
.ستنجحين

273
00:16:34,140 --> 00:16:36,470
.فأنتِ أمّي، في النّهاية

274
00:16:36,470 --> 00:16:39,390
!شيروها، متى أنجبت طفلة؟

275
00:16:39,390 --> 00:16:40,880
!لـ-لم أفعل

276
00:16:40,880 --> 00:16:42,850
."كنّا نلعب لعبة "بيت بيوت

277
00:16:43,990 --> 00:16:45,350
.أمّك هنا

278
00:16:52,680 --> 00:16:55,080
.وأبوك هنا أيضًا

279
00:16:55,080 --> 00:16:56,120
.نحن عائلة

280
00:16:56,120 --> 00:16:59,360
...وهذا يعني أنّك وأمّي

281
00:16:59,360 --> 00:17:00,240
!متزوّجان

282
00:17:00,240 --> 00:17:01,700
!مهلاً! تـ-تمهّلي يا أومي

283
00:17:03,790 --> 00:17:06,290
...يا فتى، متى أنت وشيروها

284
00:17:06,290 --> 00:17:07,880
!لم نفعل

285
00:17:07,880 --> 00:17:10,710
!إنّها تتحدّث عن لعبتنا فحسب

286
00:17:11,830 --> 00:17:13,210
.أبوك هنا

287
00:17:13,210 --> 00:17:15,080
!أيّها الشّقيّ

288
00:17:15,080 --> 00:17:16,470
!عُد إلى الماء

289
00:17:16,470 --> 00:17:19,320
!سوف... سوف أجعلك حطامًا يطفو فوق الماء

290
00:17:19,320 --> 00:17:22,140
!وهذا يجعلك جدّي

291
00:17:23,270 --> 00:17:26,890
.أنت جدّ أمّي، أي أنّك جدّي أيضًا

292
00:17:27,210 --> 00:17:28,440
جدّك؟

293
00:17:28,440 --> 00:17:30,270
أنا؟ أنا جدّك؟

294
00:17:30,600 --> 00:17:31,770
!جدّي

295
00:17:32,060 --> 00:17:33,400
فعلاً؟

296
00:17:33,400 --> 00:17:35,280
هلاّ سامحتِ جدّك إذًا؟

297
00:17:35,280 --> 00:17:37,280
.لن أغضب بعد الآن

298
00:17:37,280 --> 00:17:38,810
حفيدة صغيرة؟

299
00:17:38,810 --> 00:17:41,540
نعم، لا شيء أعظم من الأحفاد، صحيح؟

300
00:17:41,540 --> 00:17:43,200
.أنا حفيدتك بالفعل

301
00:17:43,490 --> 00:17:44,870
إذًا أنت جدّي الأكبر؟

302
00:17:44,870 --> 00:17:46,330
...وأنت حفيدتي الكبرى

303
00:17:47,620 --> 00:17:49,000
!لكما بركتي

304
00:17:49,000 --> 00:17:51,250
!سأعتبر أنّكما متزوّجان

305
00:17:51,850 --> 00:17:52,710
!شكرًا لك يا سيّدي

306
00:17:52,710 --> 00:17:55,580
.لـ-لن يجلب لك هذا إلاّ المتاعب

307
00:17:55,580 --> 00:17:57,020
.لا تقلقي عليّ

308
00:17:57,020 --> 00:18:01,640
في الحقيقة، أنا سعيد أن تكون
.علاقتنا على هذا النّحو

309
00:18:01,640 --> 00:18:06,560
.لـ-لكنّنا لا نزال تلميذين
.لا أعرف كيف أتصرّف لكوننا متزوّجين

310
00:18:06,560 --> 00:18:09,480
...فـ-في تلك الحالة، ما رأيك أن نكون

311
00:18:09,880 --> 00:18:11,840
حـ-حبيبين فحسب؟

312
00:18:12,350 --> 00:18:14,170
.تغيّر صوته وهو يقولها

313
00:18:14,170 --> 00:18:16,090
.أراهن أنّه لا يقول ذلك كثيرًا

314
00:18:16,090 --> 00:18:18,360
حـ-حبيبين؟

315
00:18:18,360 --> 00:18:20,280
.تغيّر صوتها هي الأخرى

316
00:18:20,280 --> 00:18:21,990
.ربّما لأنّها لا تستعمل تلك الكلمة كثيرًا

317
00:18:23,390 --> 00:18:25,410
.أنا جادّ في مشاعري نحوك

318
00:18:26,660 --> 00:18:30,180
.نحن متزوّجان، لكن أريدك أن تكوني حبيبتي

319
00:18:31,320 --> 00:18:32,980
...لـ-لكن، أنا

320
00:18:33,680 --> 00:18:34,540
...عفوًا

321
00:18:35,720 --> 00:18:36,670
.حسنًا

322
00:18:36,670 --> 00:18:39,880
!حسنًا، لنحتفل بالعروسين

323
00:18:40,880 --> 00:18:42,500
!تهانينا

324
00:18:43,600 --> 00:18:46,600
.السّادس عشر من أغسطس. يوم مشمس

325
00:18:46,600 --> 00:18:50,600
.تزوّج أبي وأمّي اليوم

326
00:18:50,600 --> 00:18:52,520
.كان الجميع يبتسمون

327
00:18:52,520 --> 00:18:53,790
!أنا سعيدة جدًّا

328
00:18:55,150 --> 00:18:57,990
.سارت الأمور بسرعة بعد ذلك

329
00:18:57,990 --> 00:19:00,920
،ومع اقتراب التّحضير لطقوس ناتسودوري

330
00:19:01,740 --> 00:19:07,450
.حان اليوم المقدّر الّذي رأته شيروها سريعًا

331
00:19:10,430 --> 00:19:14,090
.لا احتمال لهطول المطر حتّى اللّيل

332
00:19:14,090 --> 00:19:14,750
.حسنًا

333
00:19:15,170 --> 00:19:17,640
.أراك لاحقًا يا هايري-كُن

334
00:19:17,640 --> 00:19:19,720
.اعتني بأومي من أجلي لو سمحت

335
00:19:20,510 --> 00:19:23,010
عليك أن تطيعي كيوكو-سان، مفهوم؟

336
00:19:24,330 --> 00:19:28,010
.كنت أريد رؤية أمّي بنفسي

337
00:19:28,010 --> 00:19:31,020
.لا يمكننا أن نسمح لك بالصّعود إلى القارب

338
00:19:31,020 --> 00:19:32,660
.لا تقلقي

339
00:19:32,660 --> 00:19:34,350
.أعدك أنّني سأحمي شيروها

340
00:19:36,110 --> 00:19:40,900
من كان يظنّ أن ابن أختي الّذي جاء
.لقضاء الصّيف سينتهي به المطاف متزوّجًا

341
00:19:51,210 --> 00:19:53,640
...فراشة قوس قزح

342
00:19:54,790 --> 00:19:58,170
.أشعر أنّني رأيت مثلها هنا من قبل

343
00:20:00,750 --> 00:20:02,420
.شيروها بانتظاري

344
00:20:20,920 --> 00:20:24,320
.نحن هنا للبدء بعهد الفراشة

345
00:21:23,440 --> 00:21:25,710
.كانت رؤياكِ بعيدة عن الواقع

346
00:21:26,140 --> 00:21:28,550
...أتساءل

347
00:21:28,550 --> 00:21:30,960
.لقد أتممتِ واجباتك

348
00:21:31,410 --> 00:21:33,770
.أنا متأكّد أنّنا غيّرنا المستقبل

349
00:21:34,040 --> 00:21:38,310
.ومع ذلك، ما زال هناك شيء يثقل قلبي

350
00:21:39,580 --> 00:21:40,510
.إنّها تمطر

351
00:21:41,010 --> 00:21:43,150
.من حسن الحظّ أنّنا انتهينا بالفعل

352
00:21:44,070 --> 00:21:45,400
أين أومي-تشان؟

353
00:21:46,150 --> 00:21:49,200
.تركتها مع كيوكو-سان

354
00:21:52,220 --> 00:21:53,290
ما الأمر؟

355
00:21:53,290 --> 00:21:54,750
لماذا...؟

356
00:21:55,240 --> 00:21:57,750
لماذا رأيت ذلك للتّوّ؟

357
00:21:58,220 --> 00:21:59,750
شيروها؟

358
00:22:00,120 --> 00:22:01,000
!هايري

359
00:22:01,490 --> 00:22:04,460
!أومي-تشان على القارب