1
00:00:08,280 --> 00:00:09,860
...أحرقه

2
00:00:10,160 --> 00:00:13,700
أحرق ذاك الكتاب الّذي غُيّر
...غلافه ليبدو كمرجع دراسيّ

3
00:00:14,040 --> 00:00:17,070
مجمّع الزّوجات والأخوات الصّغيرات"
".المقيّدات بحبال خشنة وزلقة

4
00:00:19,920 --> 00:00:21,750
...يا للنّدم الشّديد

5
00:00:21,750 --> 00:00:25,070
،لو عثر عليه والداك
.لكان ذلك أشبه بموت مضاعف

6
00:00:26,290 --> 00:00:28,000
!لم تكن تلك من ذكريات أي

7
00:00:28,000 --> 00:00:30,550
.هكذا إذًا صرتِ متعالمة بهذا القدر في النّهاية

8
00:00:30,550 --> 00:00:32,710
!لا-لا تصفني بالمتعالمة

9
00:00:33,040 --> 00:00:35,650
!هيّا نبحث عن الشّيتشييتشو التّالية يا إيناري

10
00:00:35,650 --> 00:00:36,220
!بون

11
00:00:38,220 --> 00:00:39,050
بون؟

12
00:00:40,220 --> 00:00:42,810
.حسنًا، هذا يعفينا من عناء البحث

13
00:00:44,830 --> 00:00:45,560
أوُ؟

14
00:00:45,560 --> 00:00:46,170
!بون

15
00:00:46,930 --> 00:00:48,060
...كلاّ

16
00:00:48,060 --> 00:00:49,560
...هذه الذّكرى

17
00:00:49,890 --> 00:00:51,320
!إنّها ذكرى موت

18
00:01:10,290 --> 00:01:15,720
جيوب صيف

19
00:02:29,530 --> 00:02:32,580
،أعلم أنّها تريد العثور على ذكريات أي

20
00:02:32,580 --> 00:02:34,100
.لكنّها تبالغ كثيرًا في الأمر

21
00:02:34,100 --> 00:02:34,900
!بون

22
00:02:39,180 --> 00:02:43,740
ما زلت أظنّ أنّنا سنجد أي بشكل
.أسرع إن بحثنا معًا

23
00:02:43,740 --> 00:02:45,090
...بون

24
00:02:48,120 --> 00:02:49,570
...هذه الذّكرى

25
00:02:49,570 --> 00:02:51,990
...أشعر بضيق في صدري

26
00:02:52,440 --> 00:02:53,670
أهو الحزن؟

27
00:02:54,330 --> 00:02:56,980
كنت أعلم أنّ لا حقّ لي
،في أن أشعر كما شعرت

28
00:02:56,980 --> 00:02:59,870
.لكنّني لم أستطع كبح مشاعري

29
00:02:59,870 --> 00:03:03,780
.لذلك اتّخذنا قرارًا بالهرب معًا

30
00:03:04,770 --> 00:03:07,830
...لكنّها لم تأتِ

31
00:03:08,910 --> 00:03:10,560
.لم يكن الأمر أنّها لم تأتِ فحسب

32
00:03:10,560 --> 00:03:11,870
.بل لم تستطع أن تأتي

33
00:03:12,430 --> 00:03:13,880
.كنتُ واثقًا من ذلك

34
00:03:14,530 --> 00:03:19,380
.فرحلتُ إلى الحرب وأنا ما زلت أؤمن بذلك

35
00:03:20,040 --> 00:03:20,840
.أنا آسف

36
00:03:20,840 --> 00:03:23,380
.لم أستطع مواصلة الانتظار

37
00:03:23,380 --> 00:03:25,530
.كان لا بدّ لي أن أموت قبلك

38
00:03:26,340 --> 00:03:27,640
.أفتقدك

39
00:03:28,090 --> 00:03:31,060
.كنت أود رؤيتك لمرّةٍ أخيرة

40
00:03:33,240 --> 00:03:34,530
...أفتقدك

41
00:03:38,840 --> 00:03:40,690
هايري؟

42
00:03:41,720 --> 00:03:42,740
...آسف

43
00:03:44,040 --> 00:03:44,930
...الفراشة

44
00:03:44,930 --> 00:03:46,080
.غبيّ

45
00:03:46,080 --> 00:03:48,370
.أخبرتك ألاّ تلمسها

46
00:03:51,440 --> 00:03:52,760
.شكرًا لك

47
00:03:53,910 --> 00:03:56,380
...لنُعدها

48
00:03:56,760 --> 00:03:58,350
.إلى حيث تنتمي

49
00:03:58,880 --> 00:04:00,880
.بأيدينا

50
00:04:02,280 --> 00:04:02,880
!بون

51
00:04:12,370 --> 00:04:13,430
ما الأمر؟

52
00:04:13,430 --> 00:04:14,640
.لا شيء

53
00:04:14,640 --> 00:04:19,830
أتمنّى فقط أن يلتقي صاحب
.تلك الذّكرى بمن كان ينتظره

54
00:04:19,830 --> 00:04:20,980
.نعم

55
00:04:22,210 --> 00:04:23,160
...الزّهور

56
00:04:24,160 --> 00:04:25,740
.بدأت الزّهور تتساقط

57
00:04:29,160 --> 00:04:31,520
.وهذا يعني أنّ الوقت بدأ ينفد منّا

58
00:04:31,520 --> 00:04:36,960
سأضطرّ إلى الانتظار سنةً أخرى حتّى أتمكّن
...من جمع المزيد من الشّيتشييتشو ثانية

59
00:04:37,520 --> 00:04:41,060
!سأجدها هذا الصّيف، سترى ذلك

60
00:04:42,960 --> 00:04:44,500
...لا تقلقي

61
00:04:44,500 --> 00:04:46,050
.أنا معك هذا السّنة

62
00:04:47,490 --> 00:04:48,190
.نعم

63
00:04:51,200 --> 00:04:52,020
!بون

64
00:04:58,750 --> 00:05:01,110
.لقد تأخّر الوقت. بدأتُ أشعر بالنّعاس حقًّا

65
00:05:02,510 --> 00:05:04,940
.ذلك النّعاس سببه الشّيتشييتشو

66
00:05:06,600 --> 00:05:10,520
حين تلمس شيتشييتشو
،وتشهد ذكريات شخص آخر

67
00:05:10,520 --> 00:05:14,440
.تصبح تلك الذّكريات جزءًا منك بالفعل

68
00:05:14,440 --> 00:05:17,430
،إنّنا ننظّم ذكرياتنا أثناء النّوم

69
00:05:17,430 --> 00:05:19,330
.ولذلك نحتاج إلى الكثير منه

70
00:05:19,760 --> 00:05:23,860
أهذا هو سبب نومك طوال الوقت؟

71
00:05:24,800 --> 00:05:26,000
.أظنّ ذلك

72
00:05:26,000 --> 00:05:28,410
.إذًا لا بدّ أنّك في حالٍ سيّئة أيضًا

73
00:05:28,410 --> 00:05:30,300
!لقد اعتدتُ على هذا

74
00:05:30,300 --> 00:05:32,280
.أقوم بهذا منذ وقت طويل

75
00:05:32,910 --> 00:05:36,140
.صرتُ ماهرة في ترتيب الذّكريات

76
00:05:36,140 --> 00:05:40,150
،أعلم أنّك تفعلين هذا من أجل أي
لكن ألا تظنّين أنّك تفرطين في الأمر قليلاً؟

77
00:05:40,730 --> 00:05:42,160
...حسنًا

78
00:05:42,160 --> 00:05:46,190
.ما آلت إليه أي من حال هو بسببي أنا

79
00:05:47,900 --> 00:05:49,490
.كانت أي ذكيّة

80
00:05:50,050 --> 00:05:52,260
.وكانت رياضيّة أيضًا

81
00:05:52,260 --> 00:05:55,770
.كلّما تنافسنا، كنت أتخلّف عنها

82
00:05:56,320 --> 00:05:58,400
.وكانت ماهرةً بيديها كذلك

83
00:05:58,400 --> 00:06:00,520
.علّمتنا أمّنا كيف نصنع هذه التّمائم

84
00:06:00,520 --> 00:06:03,250
!قالت أنّها تطرد الأرواح الشّرّيرة

85
00:06:04,010 --> 00:06:08,230
كانت ترغب أن نرتديها عندما نكبر
.ونتولّى واجبات سوراكادو

86
00:06:08,940 --> 00:06:11,010
،صنعناها معًا

87
00:06:11,010 --> 00:06:13,980
.لكنّ ما كنت أصنعه لم يكن جميلاً أبدًا

88
00:06:13,980 --> 00:06:15,980
.وذلك كان يزعجني كثيرًا

89
00:06:15,980 --> 00:06:18,410
.غِرتُ منها وبكيت

90
00:06:19,730 --> 00:06:21,820
،وحين أعطتني أي هذه

91
00:06:22,520 --> 00:06:25,580
.طلبتْ أن تأخذ التّميمة الّتي صنعتُها أنا

92
00:06:25,580 --> 00:06:28,110
...إذًا تلك الّتي في معصمها

93
00:06:28,110 --> 00:06:29,280
.نعم

94
00:06:29,280 --> 00:06:31,030
شكلها غير منتظم قليلاً، صحيح؟

95
00:06:31,030 --> 00:06:33,350
،قالت أنّها تقدّرها على أيّ حال

96
00:06:33,350 --> 00:06:35,830
.لأنّني أنا من صنعتها

97
00:06:35,830 --> 00:06:38,630
.كانت أي مذهلة فعلاً

98
00:06:38,630 --> 00:06:42,780
.وأردتُ منها أن تقول أنّني كذلك

99
00:06:42,780 --> 00:06:46,250
.ذات يوم، رأيت فراشة غريبة

100
00:06:46,250 --> 00:06:48,690
.جميلة... وكانت تشعّ ضوءًا خافتًا

101
00:06:48,690 --> 00:06:51,010
.كان ذلك أوّل لقاء لي مع شيتشييتشو

102
00:06:52,030 --> 00:06:53,890
...مذهلة

103
00:06:58,390 --> 00:07:00,940
!إنّها الحقيقة
!رأيتُ واحدة! أقسم بذلك

104
00:07:00,940 --> 00:07:03,190
فراشة متوهّجة؟

105
00:07:03,190 --> 00:07:05,150
أمتأكّدة أنّها لم تكن مجرّد
أشعة الشّمس عليها؟

106
00:07:05,150 --> 00:07:07,820
!أنا لا أكذب! رأيت واحدة بالفعل

107
00:07:09,430 --> 00:07:11,150
أنت تصدّقني، أليس كذلك يا أي؟

108
00:07:13,280 --> 00:07:16,330
.لم يصدّقني أحد

109
00:07:16,330 --> 00:07:22,000
لذا كنتُ مستميتة للعثور على
.فراشة متوهّجة وإبهار الجميع

110
00:07:22,540 --> 00:07:26,540
.ظننتُ أنّني سأراها بشكل أسهل في اللّيل

111
00:07:43,880 --> 00:07:45,060
أوُ-تشان؟

112
00:07:45,360 --> 00:07:46,310
أي؟

113
00:07:46,310 --> 00:07:47,500
!أوُ-تشان

114
00:07:48,600 --> 00:07:49,610
.لنعد إلى المنزل

115
00:07:50,910 --> 00:07:53,600
.لكنّني لم أعثر على الفراشة المتوهّجة بعد

116
00:07:53,600 --> 00:07:55,360
.لكنّ الجبل خطير في اللّيل

117
00:07:55,720 --> 00:07:57,310
!لا، ليس خطيرًا

118
00:07:57,310 --> 00:08:00,010
.صعدتِ إلى هنا وحدك أيضًا

119
00:08:00,010 --> 00:08:01,480
.سأكون بخير

120
00:08:01,480 --> 00:08:02,250
—إذًا فلنذهب معًا

121
00:08:02,250 --> 00:08:02,990
!لا

122
00:08:02,990 --> 00:08:04,670
!لن يكون للأمر أيّ معنى إن كنتِ معي

123
00:08:05,060 --> 00:08:09,300
!لا تصدّقين حتّى بوجود الفراشة
!تظنّين أنّني أكذب

124
00:08:09,840 --> 00:08:10,840
...أوُ-تشان

125
00:08:15,010 --> 00:08:16,110
!أوُ-تشان

126
00:08:20,340 --> 00:08:21,990
.ما كان ينبغي أن أقول ذلك

127
00:08:21,990 --> 00:08:24,730
.لم أرَ تلك الملامح على وجه أي من قبل

128
00:08:49,150 --> 00:08:50,180
...أي

129
00:08:53,890 --> 00:08:55,980
.آسفة يا أي

130
00:08:56,420 --> 00:08:57,220
.سامحيني

131
00:08:58,480 --> 00:08:59,970
.أنا آسفة

132
00:09:07,520 --> 00:09:10,880
!أوُ

133
00:09:10,880 --> 00:09:12,730
!حمدًا على هذا

134
00:09:14,160 --> 00:09:15,590
أبي؟

135
00:09:15,590 --> 00:09:17,240
أمّي؟

136
00:09:18,680 --> 00:09:21,080
لكن ماذا عن أي؟

137
00:09:21,080 --> 00:09:22,470
أين هي؟

138
00:09:24,620 --> 00:09:29,420
.وجدوها في أسفل الجرف في تلك اللّيلة

139
00:09:30,320 --> 00:09:34,390
،نُقلت مباشرةً إلى العيادة للعلاج

140
00:09:34,390 --> 00:09:37,960
،لكنّ إصاباتها كانت خطيرة جدًّا
.ولم تستفق أبدًا

141
00:09:40,050 --> 00:09:44,340
.يبدو أنّها كانت تقبض على هذه في يدها

142
00:09:46,350 --> 00:09:49,770
.قلت لها كلامًا فظيعًا تلك اللّيلة

143
00:09:49,770 --> 00:09:51,340
.جرحتُ مشاعرها

144
00:09:52,640 --> 00:09:55,980
.ولم تُتح لي الفرصة لأعتذر لها

145
00:09:59,340 --> 00:10:03,000
.يجب أن أوقظ أي مهما كان الثّمن

146
00:10:03,000 --> 00:10:06,880
.أوُ، ما زلت أريد أن أكون عونًا لك

147
00:10:08,820 --> 00:10:09,830
أوقعت في غرامي؟

148
00:10:09,830 --> 00:10:12,670
.نعم، أنا أحبّك. أنت تعرفين ذلك

149
00:10:18,710 --> 00:10:22,890
.لم أعد أخاف من النّوم هذه الأيّام

150
00:10:22,890 --> 00:10:28,480
.يمكنني أن أكون على طبيعتي بوجودك قربي

151
00:10:29,060 --> 00:10:34,110
.وما أشعر به نحوك هو ما يبقيني على طبيعتي

152
00:10:34,420 --> 00:10:35,350
...أوُ

153
00:10:50,620 --> 00:10:53,310
حسنًا... هل ستكونين بخير؟

154
00:10:53,840 --> 00:10:56,130
.نـ... نعم، أنا بخير

155
00:10:56,520 --> 00:10:59,630
.خصوصًا لأنّك كنت لطيفًا جدًّا

156
00:11:00,090 --> 00:11:02,130
.لا، أعني مع عائلتك

157
00:11:02,130 --> 00:11:03,990
.قضيتِ اللّيلة كلّها بالخارج

158
00:11:05,880 --> 00:11:09,290
!لا-لا تهتمّ! كلّ شيء على ما يرام
!هذا واجبي

159
00:11:09,290 --> 00:11:11,610
!نعم، نعم! لا بأس

160
00:11:11,610 --> 00:11:14,150
.أنت منحرفة فعلاً يا أوُ

161
00:11:14,460 --> 00:11:16,710
!أ-أ-أنا فتاة سليمة تمامًا

162
00:11:16,710 --> 00:11:19,150
!ولكن لديّ أفكار منحرفة أحيانًا

163
00:11:19,150 --> 00:11:23,120
...لـ-لكنّ تلك القبلة كانت قويّة بالفعل

164
00:11:23,120 --> 00:11:25,970
...أ-أعني، كانت رو

165
00:11:25,970 --> 00:11:28,770
.كنتُ بحاجة لأن تكون تجربتي الأولى

166
00:11:28,770 --> 00:11:32,180
..."إذًا، حين قلتِ "الرّو
.كنت تقصدين قبلة مليئة بالرّومانسيّة

167
00:11:33,990 --> 00:11:35,170
.شيروها

168
00:11:40,070 --> 00:11:42,280
.أفترض أن ليلتكما كانت ممتعة

169
00:11:42,280 --> 00:11:44,670
!لـ-لـ-ليست كما تظنّين

170
00:11:44,670 --> 00:11:45,300
.أوُ

171
00:11:45,300 --> 00:11:46,800
نـ-نعم؟

172
00:11:47,970 --> 00:11:48,970
.أنا سعيدة لأجلك

173
00:11:52,020 --> 00:11:54,100
.أعتذر على هذا الإعلان المبكّر

174
00:11:54,100 --> 00:11:57,860
،سوراكادو أوُ-سان
.يُرجى التّواصل مع العيادة فورًا

175
00:11:57,860 --> 00:12:01,610
!أكرّر، تواصلي مع العيادة يا أوُ

176
00:12:19,760 --> 00:12:21,460
كيف هي أي أيّها الطّبيب؟

177
00:12:21,460 --> 00:12:23,470
.تجاوزت مرحلة الخطر الآن

178
00:12:24,010 --> 00:12:27,160
أودّ التّحدّث بشأن ما حدث
.وخياراتنا المستقبليّة

179
00:12:27,160 --> 00:12:29,340
.مع العائلة، إن لم تمانعوا

180
00:12:32,060 --> 00:12:35,560
الموظّفين فقط

181
00:12:34,420 --> 00:12:35,560
!هايري

182
00:12:35,560 --> 00:12:37,080
!تاكاهارا

183
00:12:37,080 --> 00:12:38,000
...هل أي

184
00:12:38,000 --> 00:12:41,030
هل هي بخير؟

185
00:12:41,030 --> 00:12:43,550
.قال الطّبيب أنّها تجاوزت مرحلة الخطر

186
00:12:43,550 --> 00:12:44,790
.هكذا إذًا

187
00:12:44,790 --> 00:12:46,160
.هذا مطمئن

188
00:12:46,160 --> 00:12:48,740
نشأتم مع أي أيضًا، أليس كذلك؟

189
00:12:48,740 --> 00:12:50,070
.نعم

190
00:12:50,070 --> 00:12:52,620
.كنّا نلعب سويًّا ونحن صغار

191
00:12:52,620 --> 00:12:55,870
.كانت أي تقلق دائمًا بشأن أوُ

192
00:12:55,870 --> 00:12:59,080
،كانت ترى نفسها الأخت الكبرى
.رغم أنّهما توأمان

193
00:12:59,560 --> 00:13:02,050
.كانت تهتمّ لأمر أوُ كثيرًا

194
00:13:02,700 --> 00:13:05,620
،تاكاهارا، أعلم أنّ طلبي أنانيّ

195
00:13:05,620 --> 00:13:07,430
.لكن أرجوك، اعتنِ بأوُ

196
00:13:07,430 --> 00:13:08,920
...مـ-مهلاً

197
00:13:08,920 --> 00:13:11,310
.لا نعلم ما الّذي قد يحدث من الآن فصاعدًا

198
00:13:11,310 --> 00:13:13,810
.أوُ تعتمد عليك

199
00:13:16,720 --> 00:13:18,830
.لا حاجة لأن تترجّيني لأجل ذلك

200
00:13:18,830 --> 00:13:19,860
...لكن

201
00:13:20,330 --> 00:13:23,360
.سأظلّ إلى جانب أوُ لأنّي أريد ذلك

202
00:13:27,170 --> 00:13:28,260
.شكرًا لك

203
00:13:30,520 --> 00:13:31,950
.لقد عدت

204
00:13:33,220 --> 00:13:35,230
.يبدو أنّك قضيتَ يومًا صعبًا

205
00:13:35,230 --> 00:13:36,160
.لا

206
00:13:36,160 --> 00:13:38,330
.لا شيء مقارنة بما تمرّ به أوُ

207
00:13:39,280 --> 00:13:41,340
هايري-سان، هل أنت بخير؟

208
00:13:41,340 --> 00:13:42,180
ماذا؟

209
00:13:44,340 --> 00:13:45,200
ما الّذي...؟

210
00:13:45,200 --> 00:13:46,170
...يا إلهي

211
00:13:46,480 --> 00:13:49,270
...أشعر بالنّعاس فجأة

212
00:13:54,080 --> 00:13:56,430
أين أنا؟

213
00:13:58,600 --> 00:14:01,860
!تاكاهارا-سان، أنت فاشل

214
00:14:02,680 --> 00:14:05,730
.أريحيني من هذا العذاب

215
00:14:06,610 --> 00:14:07,880
.أنا آسف

216
00:14:07,880 --> 00:14:10,680
.لم أستطع الاستمرار في انتظارك

217
00:14:12,220 --> 00:14:13,740
.صباح الخير

218
00:14:13,740 --> 00:14:16,330
!أعيدوا لي زوجتي! ابنتي

219
00:14:16,330 --> 00:14:17,620
.فقدت حياتي

220
00:14:17,620 --> 00:14:19,730
!لا أريد أن أكبر

221
00:14:19,730 --> 00:14:21,670
.يمكنني أن أكون حرًّا أخيرًا

222
00:14:21,670 --> 00:14:24,300
.كنت أودّ رؤيتك لمرّة أخيرة

223
00:14:29,080 --> 00:14:30,830
ما كان هذا الحلم الغريب؟

224
00:14:31,640 --> 00:14:32,730
مهلاً... الوقت ليل؟

225
00:14:34,520 --> 00:14:36,620
كم من الوقت كنتُ نائمًا؟

226
00:14:36,620 --> 00:14:37,180
ماذا؟

227
00:14:38,680 --> 00:14:39,940
...إنّها ليست

228
00:14:42,390 --> 00:14:43,630
!أوُ

229
00:14:44,460 --> 00:14:46,480
!أين أنت؟! أوُ

230
00:14:46,690 --> 00:14:48,230
!بون

231
00:14:48,690 --> 00:14:49,240
!إيناري

232
00:14:54,850 --> 00:14:55,530
!بون

233
00:14:58,510 --> 00:14:59,250
!أوُ

234
00:14:59,530 --> 00:15:00,270
!مهلاً

235
00:15:01,140 --> 00:15:02,220
هل أنت بخير؟

236
00:15:06,880 --> 00:15:09,380
كم رأيتِ من ذكرى يا ترى؟

237
00:15:11,630 --> 00:15:13,370
أوُ، هل أنت بخير؟

238
00:15:15,590 --> 00:15:17,130
...أمّي

239
00:15:17,130 --> 00:15:18,570
...أنا أفتقدك

240
00:15:18,830 --> 00:15:22,310
...أفتقدك

241
00:15:20,470 --> 00:15:21,500
أوُ؟

242
00:15:22,310 --> 00:15:23,630
...المكان مظلم

243
00:15:23,630 --> 00:15:25,360
...المكان مظلم هنا

244
00:15:25,360 --> 00:15:26,380
.أنا خائفة

245
00:15:26,380 --> 00:15:28,840
...برد... أشعر بالبرد

246
00:15:28,840 --> 00:15:33,590
...أفضّل أن أقتلك بدل أن تكوني لأحد آخر

247
00:15:33,590 --> 00:15:35,940
.أتمنى أن تصلها رسالتي

248
00:15:37,000 --> 00:15:39,330
.أنا متشوّق لردّها

249
00:15:40,160 --> 00:15:41,030
!أوُ

250
00:15:42,050 --> 00:15:44,150
...خدّي

251
00:15:44,150 --> 00:15:45,460
.آلمني ذلك

252
00:15:45,890 --> 00:15:47,450
...عفوًا

253
00:15:47,450 --> 00:15:48,880
...كيف

254
00:15:48,880 --> 00:15:50,130
...صحيح

255
00:15:50,130 --> 00:15:53,320
.يجب أن أسرع وأجد ذكرى أي

256
00:15:53,320 --> 00:15:54,340
!مهلاً

257
00:15:54,810 --> 00:15:57,010
اجلسي! لا يمكنك حتّى الوقوف
!بشكل مستقيم

258
00:15:57,430 --> 00:15:59,010
!لا وقت لديّ

259
00:15:59,450 --> 00:16:01,520
!سأفقد أي

260
00:16:02,550 --> 00:16:06,020
.قال الطّبيب أنّ علينا الاستعداد للأسوأ

261
00:16:06,380 --> 00:16:09,960
!لا أملك سنة أخرى

262
00:16:09,960 --> 00:16:11,530
!في هذا مخاطرة كبيرة

263
00:16:12,050 --> 00:16:14,330
!إن لم أخاطر الآن، فمتى؟

264
00:16:14,330 --> 00:16:18,410
لن يتبقّى لي شيء أخاطر به
!إن فقدت أي

265
00:16:18,410 --> 00:16:20,940
...أنا أفهم، لكن

266
00:16:22,250 --> 00:16:24,290
.على الأقلّ خذي قسطًا من الرّاحة. أرجوك

267
00:16:24,890 --> 00:16:26,420
.سأوقظك بنفسي

268
00:16:28,700 --> 00:16:31,900
تعدني بأنّك ستوقظني؟

269
00:16:31,900 --> 00:16:33,690
.نعم. أعدك

270
00:16:34,690 --> 00:16:35,680
.حسنًا

271
00:16:35,680 --> 00:16:37,870
...لبعض الوقت فحسب

272
00:16:38,550 --> 00:16:40,370
...شكرًا

273
00:16:54,400 --> 00:16:55,930
...يا أي

274
00:16:55,930 --> 00:16:58,100
.انظري كم تبذل أوُ من جهد

275
00:16:58,700 --> 00:17:01,100
تهتمّين لأمرها، أليس كذلك؟

276
00:17:01,100 --> 00:17:02,580
.اظهري رجاءً

277
00:17:05,050 --> 00:17:06,750
إيناري؟ ما الخطب؟

278
00:17:11,370 --> 00:17:12,250
.مستحيل

279
00:17:12,930 --> 00:17:15,090
.لا يمكنها لمس الشّيتشييتشو الآن

280
00:17:15,090 --> 00:17:16,110
!بون

281
00:17:17,590 --> 00:17:19,800
!سُحقًا! ابتعدي

282
00:17:22,700 --> 00:17:23,390
!بون

283
00:17:34,170 --> 00:17:35,090
!بون

284
00:17:39,660 --> 00:17:40,530
ما هذا؟

285
00:17:44,570 --> 00:17:46,910
هل... قمت بحمايتها؟

286
00:18:04,390 --> 00:18:05,770
أحلّ الصّباح؟

287
00:18:07,160 --> 00:18:08,440
!لـ-لماذا؟

288
00:18:08,440 --> 00:18:10,570
!قلتَ أنّك ستوقظني

289
00:18:10,570 --> 00:18:11,580
.لا بأس

290
00:18:11,580 --> 00:18:13,090
!بل هناك بأس كبير

291
00:18:13,090 --> 00:18:15,150
!ماذا لو حدث شيء لأي؟

292
00:18:15,630 --> 00:18:17,650
.أي هنا

293
00:18:19,000 --> 00:18:20,660
.انظري. هنا

294
00:18:21,150 --> 00:18:22,410
أين؟

295
00:18:23,970 --> 00:18:25,470
.لا أراها

296
00:18:27,300 --> 00:18:28,870
...هكذا إذًا

297
00:18:29,450 --> 00:18:31,420
.أعتقد أنّني لا أستطيع رؤيتها

298
00:18:32,080 --> 00:18:34,230
.لا عجب أنّني لم أجدها

299
00:18:34,230 --> 00:18:37,290
.كنت مغمضة العينين عنها

300
00:18:37,290 --> 00:18:39,760
،رغم أنّني أخبر نفسي أنّني أريد مساعدتها

301
00:18:39,760 --> 00:18:42,610
.لكنّني خائفة ممّا قد تفكّر فيه حقًّا

302
00:18:42,610 --> 00:18:45,800
.كلّ ما كنتُ أفكّر فيه هو نفسي

303
00:18:46,320 --> 00:18:47,980
.كم أنا دنيئة

304
00:18:47,980 --> 00:18:49,570
!هذا غير صحيح

305
00:18:50,920 --> 00:18:55,190
،لقد أرهقت نفسك دون تفكير
.وضحّيت بالكثير في سبيلها

306
00:18:55,190 --> 00:18:56,510
!لقد فعلتِ الكثير

307
00:18:56,510 --> 00:18:59,570
.لا تقولي أنّك دنيئة. بل أبليتِ بلاءً حسنًا

308
00:18:59,890 --> 00:19:01,150
...هايري

309
00:19:01,910 --> 00:19:04,740
!لكنّي لا أستطيع رؤية أي

310
00:19:05,640 --> 00:19:08,190
.سأساعدك على رؤيتها إذًا

311
00:19:08,660 --> 00:19:12,050
ستساعدني؟ كيف؟

312
00:19:24,330 --> 00:19:27,060
!تظنّين أنّني أكذب

313
00:19:27,870 --> 00:19:29,160
!أوُ-تشان

314
00:19:29,160 --> 00:19:30,810
.إنّها غلطتي

315
00:19:31,330 --> 00:19:35,440
كان عليّ تصديق أمر الفراشة المتوهّجة
.الّتي قالت أوُ-تشان أنّها رأتها

316
00:19:35,440 --> 00:19:38,000
.ما كانت أوُ-تشان لتكذب

317
00:19:38,630 --> 00:19:41,540
.إنّها تكره الكذب من الأساس

318
00:19:42,880 --> 00:19:45,640
.يجب أن أجد فراشة متوهّجة

319
00:19:45,640 --> 00:19:47,770
.أستطيع أن أجد واحدة لأجلها

320
00:19:47,770 --> 00:19:51,220
.وهكذا، لن يظنّ أحد أنّها تكذب بعد الآن

321
00:19:52,040 --> 00:19:56,340
لا أستطيع أن أكون سعيدة
.إن لم تكن أوُ-تشان سعيدة

322
00:19:56,860 --> 00:20:00,820
لا يمكنني أن أبتسم إن لم
.تستطع هي الابتسام

323
00:20:01,290 --> 00:20:04,670
.أنا أخت أوُ-تشان الكبرى

324
00:20:05,350 --> 00:20:09,970
وأواصل المضيّ قدمًا لأنّ
.أوُ-تشان تقول أنّني مدهشة

325
00:20:19,610 --> 00:20:22,790
.ما زال عليّ أن أجد فراشة

326
00:20:22,790 --> 00:20:25,160
.وما زال عليّ أن أتصالح مع أوُ-تشان

327
00:20:25,780 --> 00:20:29,060
...أوُ-تشان

328
00:20:31,400 --> 00:20:32,500
...أي

329
00:20:33,010 --> 00:20:38,500
...كانت أي تفكّر بي دائمًا

330
00:20:38,500 --> 00:20:41,840
.كانت أختك مذهلة حقًّا

331
00:20:42,840 --> 00:20:43,760
.نعم

332
00:20:44,320 --> 00:20:47,440
.أنا فخورة بها كثيرًا

333
00:20:50,640 --> 00:20:51,540
ما الأمر؟

334
00:20:52,950 --> 00:20:54,340
.يمكنني رؤيتها

335
00:20:56,350 --> 00:20:57,440
...أي

336
00:20:57,440 --> 00:20:58,740
أهذه أنت؟

337
00:21:02,020 --> 00:21:04,560
.لنعد إلى المنزل يا أي

338
00:21:12,810 --> 00:21:13,750
...والآن

339
00:21:14,470 --> 00:21:15,530
هل ستفعلينها؟

340
00:21:15,530 --> 00:21:17,330
.بطبيعة الحالة

341
00:21:20,790 --> 00:21:23,800
.استيقظي يا أي

342
00:21:38,140 --> 00:21:40,230
هل ستستيقظ أي الآن؟

343
00:21:40,810 --> 00:21:43,900
.أظنّ أنّ ذكرياتها قد عادت على الأقلّ

344
00:21:44,610 --> 00:21:45,860
...والآن

345
00:21:48,590 --> 00:21:50,390
.سأراقب أي

346
00:21:50,390 --> 00:21:51,240
.خذي قسطًا من الرّاحة

347
00:21:52,120 --> 00:21:53,700
.حسنًا

348
00:21:54,490 --> 00:21:56,560
.وأعدك أنّني سأوقظك هذه المرّة

349
00:21:59,960 --> 00:22:01,230
...أي

350
00:22:02,520 --> 00:22:04,290
.تصبحين على خير