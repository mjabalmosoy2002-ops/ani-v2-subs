1
00:00:05,270 --> 00:00:07,620
...هذا يُدغدغ

2
00:00:08,860 --> 00:00:10,010
.أوُ-تشان

3
00:00:16,720 --> 00:00:17,370
!أي؟

4
00:01:56,040 --> 00:01:57,480
...أوُ-تشان

5
00:01:57,480 --> 00:01:59,540
.إنّك تؤلمينني بشدّة

6
00:01:59,540 --> 00:02:00,550
!أي

7
00:02:02,110 --> 00:02:04,170
.لا يمكنني التّنفّس يا أوُ-تشان

8
00:02:04,170 --> 00:02:05,930
!أي! أي

9
00:02:06,490 --> 00:02:09,110
.هناك الكثير ممّا أريد إخبارك به

10
00:02:09,110 --> 00:02:11,860
.أردتُ أن أعتذر لك طوال هذا الوقت

11
00:02:11,860 --> 00:02:12,560
...لكن

12
00:02:12,860 --> 00:02:16,840
.شكرًا لك... لأنّك صدّقتني

13
00:02:16,840 --> 00:02:20,210
.صدّقتني طوال هذا الوقت

14
00:02:20,210 --> 00:02:21,360
.شكرًا لك

15
00:02:21,360 --> 00:02:22,480
.لا

16
00:02:23,080 --> 00:02:27,120
.أنت من قمت بالكثير من أجلي

17
00:02:27,120 --> 00:02:29,410
.كنتُ أسمع صوتك طوال هذا الوقت

18
00:02:29,830 --> 00:02:32,700
.كنتِ سندًا لي

19
00:02:33,210 --> 00:02:37,210
.لقد عدتُ بفضلك

20
00:02:37,650 --> 00:02:40,480
.شكرًا لك يا أوُ-تشان

21
00:02:43,820 --> 00:02:47,080
أنت تاكاهارا هايري-سان، أليس كذلك؟

22
00:02:47,080 --> 00:02:48,100
أتعرفينني؟

23
00:02:48,490 --> 00:02:51,590
.كانت تحدّثني أوُ-تشان عنك باستمرار

24
00:02:51,590 --> 00:02:54,890
.شكرًا لدعمك لها

25
00:02:54,890 --> 00:02:56,360
.لم أفعل سوى ما كان ينبغي فعله

26
00:02:56,360 --> 00:02:58,070
.لكنّني لا أوافق على علاقتكما

27
00:02:58,990 --> 00:03:02,760
.أوُ-تشان أختي الحبيبة العزيزة على قلبي

28
00:03:02,760 --> 00:03:05,140
لا بدّ أن يكون من يرتبط بها
.شخصًا يليق بها فعلاً

29
00:03:05,140 --> 00:03:07,950
.يبدو أنّه لا يمكنني مخالفة ما تقوله أي

30
00:03:09,640 --> 00:03:13,040
.لكن يا أي... هايري شخص طيّب حقًّا

31
00:03:13,370 --> 00:03:15,750
.حتّى أنا وقعت في حبّه

32
00:03:15,750 --> 00:03:19,260
.نعم، أعلم. ولذلك لن أمنعك

33
00:03:20,860 --> 00:03:24,040
.الآن وقد ارتحت، بدأت أشعر بالنّعاس

34
00:03:24,510 --> 00:03:29,270
...آسفة يا هايري، سأغفو قليلاً بعد

35
00:03:29,270 --> 00:03:31,080
.حسنًا، لا بأس

36
00:03:31,080 --> 00:03:33,240
.وأنا كذلك

37
00:03:34,790 --> 00:03:39,610
.أي، لنتحدّث كثيرًا حين نستيقظ

38
00:03:40,110 --> 00:03:43,030
.نعم... كثيرًا

39
00:03:43,470 --> 00:03:45,950
.تصبحين على خير يا أي

40
00:03:46,300 --> 00:03:48,950
.تصبحين على خير يا أوُ-تشان

41
00:03:49,300 --> 00:03:53,310
.هايري، أيقظني ثانية

42
00:03:54,480 --> 00:03:58,540
.كان استيقاظ أي خبرًا كبيرًا في الجزيرة

43
00:03:59,370 --> 00:04:01,940
.ذُهل الأطبّاء بما حدث، ووصفوا الأمر بالمعجزة

44
00:04:01,940 --> 00:04:05,160
.لكنّني كنت أعلم أنّه أكثر من ذلك

45
00:04:07,060 --> 00:04:10,890
.أي... لقد استيقظتِ فعلاً

46
00:04:10,890 --> 00:04:12,180
هل تتعرّفين إليّ؟

47
00:04:12,180 --> 00:04:13,060
.نعم

48
00:04:13,730 --> 00:04:15,480
ميكي-تشان، صحيح؟

49
00:04:15,480 --> 00:04:17,980
وماذا عنّي يا أي؟

50
00:04:17,980 --> 00:04:20,610
.أكيد. لم أرك منذ مدّة يا تنزن-تشان

51
00:04:20,610 --> 00:04:23,230
!تخمين غير موفّق

52
00:04:23,230 --> 00:04:26,320
.تركتُ أثرًا أقوى لديها فحسب

53
00:04:26,320 --> 00:04:30,830
بصراحة، كلّ ما أتذكّره
.هو أنّه كان هنالك صبيَّين

54
00:04:30,830 --> 00:04:32,620
.ولم أهتمّ أبدًا للتّمييز بينكما

55
00:04:34,100 --> 00:04:37,020
كنا أصدقاء في الطّفولة، أليس كذلك؟

56
00:04:37,020 --> 00:04:37,750
أليس كذلك؟

57
00:04:37,750 --> 00:04:39,830
.أنتما فقط تابعا أوُ-تشان المضحكين

58
00:04:39,830 --> 00:04:41,130
!لسنا حتّى صديقيها؟

59
00:04:42,680 --> 00:04:43,970
.إنّها مستيقظة فعلاً

60
00:04:43,970 --> 00:04:45,800
...شيروها-تشان

61
00:04:45,800 --> 00:04:47,430
.مرّ وقت طويل

62
00:04:47,740 --> 00:04:49,060
.بالفعل

63
00:04:49,520 --> 00:04:50,450
.أراكِ لاحقًا

64
00:04:50,450 --> 00:04:51,960
أهذا كلّ شيء؟

65
00:04:51,960 --> 00:04:55,350
.كما ترى... يوجد الكثير من النّاس هنا

66
00:04:55,350 --> 00:04:58,930
تظاهري بأنّ الرّجال مجرّد
.تماثيل ضفادع للزّينة

67
00:04:58,930 --> 00:04:59,980
!هذا فظيع

68
00:05:01,610 --> 00:05:03,230
.يبدو أنّ أوُ نائمة

69
00:05:03,230 --> 00:05:04,360
.نعم

70
00:05:04,360 --> 00:05:07,240
.لا أصدّق أنّها نائمة في وقت كهذا

71
00:05:07,510 --> 00:05:08,530
.نعم

72
00:05:08,530 --> 00:05:10,490
.لا يسعني الانتظار حتّى تستيقظ

73
00:05:11,080 --> 00:05:16,830
وهكذا، واصلنا نتبادل الحديث في غرفة
.المستشفى الّتي جمعت الأختين

74
00:05:17,790 --> 00:05:20,080
...كنّا ننتظر أن تستيقظ أوُ

75
00:05:21,490 --> 00:05:26,090
.لكنّها لم تستيقظ ذلك اليوم

76
00:05:35,180 --> 00:05:36,930
ثمّة واحدة في مكان كهذا؟

77
00:05:37,500 --> 00:05:38,770
.هذا غريب فعلاً

78
00:05:54,700 --> 00:05:57,210
.كان عليك الانتظار أكثر بعد أن طرقت الباب

79
00:05:57,210 --> 00:05:58,210
.هذا تصرّف غير لائق

80
00:05:58,210 --> 00:05:59,820
.عفوًا، أنا آسف

81
00:05:59,820 --> 00:06:02,090
هل كنت تأمل أن تختلس
نظرة أو شيئًا كهذا؟

82
00:06:06,380 --> 00:06:10,700
لست متأكّدة من السّبب، لكنّني لا أستطيع
.إلاّ أن أشعر ببعض الضّيق تجاهك

83
00:06:10,700 --> 00:06:12,250
.واثق أنّ ذلك مجرّد شعور

84
00:06:12,250 --> 00:06:13,760
على أيّ حال، كيف حال أوُ؟

85
00:06:13,760 --> 00:06:15,470
.ما زالت ظريفة كعادتها

86
00:06:15,770 --> 00:06:17,250
.أعرف ذلك

87
00:06:17,250 --> 00:06:18,270
...أعني

88
00:06:20,770 --> 00:06:22,190
.فهمت

89
00:06:22,190 --> 00:06:23,920
.مرّ يومان كاملان

90
00:06:23,920 --> 00:06:26,570
لا أصدّق أنّها ما زالت نائمة
...كلّ هذا الوقت

91
00:06:26,570 --> 00:06:29,530
.لم يحدث هذا أبدًا منذ أن التقيتُها على الأقلّ

92
00:06:29,880 --> 00:06:34,320
قال الطّبيب أنّ السّبب غير
.معروف، كما كان الحال معي

93
00:06:34,780 --> 00:06:38,540
لكن لا بدّ أنّها الشّيتشييتشو، أليس كذلك؟

94
00:06:38,540 --> 00:06:40,040
هل أخبرتك أوُ؟

95
00:06:40,360 --> 00:06:43,250
.نعم. بينما أنا نائمة

96
00:06:43,250 --> 00:06:46,760
.يبدو أنّ النّوم ضروريّ لترتيب الذّكريات

97
00:06:46,760 --> 00:06:51,260
.ربّما لم تتمكّن بعد من تنظيم كلّ الذّكريات

98
00:06:53,400 --> 00:06:54,850
.إنّه خطئي

99
00:06:55,140 --> 00:06:56,900
.لا تقولي ذلك

100
00:06:56,900 --> 00:06:59,140
.هذا يعني إنكار كلّ ما بذلتْه من جهد

101
00:06:59,640 --> 00:07:01,100
.آسفة

102
00:07:01,100 --> 00:07:03,370
.ستستيقظ أوُ

103
00:07:03,370 --> 00:07:06,380
.وما عليك سوى شكرها عندما تستيقظ

104
00:07:06,380 --> 00:07:08,520
.سيكون ذلك كافيًا لتعويضها

105
00:07:08,520 --> 00:07:09,860
...هايري-سان

106
00:07:10,220 --> 00:07:12,160
.عودي إلينا قريبًا، من فضلك

107
00:07:12,160 --> 00:07:16,410
قطعنا وعدًا بأن نواعد بعضنا حقًّا
حين نجد ذكريات أي، أليس كذلك؟

108
00:07:16,410 --> 00:07:17,060
ماذا؟

109
00:07:17,060 --> 00:07:19,480
.إنّنا نعيش لحظة مؤثّرة هنا، اصمتي قليلاً

110
00:07:19,480 --> 00:07:20,820
.أعتذر

111
00:07:20,820 --> 00:07:23,370
.لكنّني سمعت للتّوّ شيئًا يصعب عليّ تقبّله

112
00:07:23,660 --> 00:07:26,900
بما أنّ أوُ-تشان هي نوعك المفضّل
،من الفتيات وأنا أختها التّوأم

113
00:07:26,900 --> 00:07:29,290
فهل هذا يعني أنّك واقع في حبّي أيضًا؟

114
00:07:29,290 --> 00:07:30,540
ما الّذي يجعلك تظنّين ذلك؟

115
00:07:30,540 --> 00:07:32,100
...معك حقّ

116
00:07:32,100 --> 00:07:34,890
.لن أمانع، طالما أنّ أوُ-تشان معنا

117
00:07:34,890 --> 00:07:36,510
.سيتسنّى لك أن تكون مع فتاتين جميلتين

118
00:07:36,510 --> 00:07:38,060
.هذه ليست مزحة جيّدة

119
00:07:38,060 --> 00:07:39,060
.لا أمزح إطلاقًا

120
00:07:41,720 --> 00:07:44,520
،أفضّل أن أبقى وفيًّا لأوُ-تشان
.على الأقلّ في الوقت الحاليّ

121
00:07:44,520 --> 00:07:47,650
.وأنا كذلك، أرغب أن أكون وفيّة لها أيضًا

122
00:07:48,990 --> 00:07:53,230
،على كلّ حال
.نحتاج لأن تستيقظ قبل أيّ شيء

123
00:07:53,230 --> 00:07:54,660
.معك حقّ

124
00:07:58,410 --> 00:07:59,100
!بون

125
00:08:00,390 --> 00:08:01,330
تانوكي؟

126
00:08:01,680 --> 00:08:02,920
.لا، بل ثعلب

127
00:08:02,920 --> 00:08:06,190
كان يساعدنا في البحث عن
.الشّيتشييتشو طوال هذا الوقت

128
00:08:06,190 --> 00:08:07,300
.اسمه إيناري

129
00:08:07,300 --> 00:08:09,560
.سمعت بهذا الاسم من قبل

130
00:08:09,560 --> 00:08:11,980
.ظننتُ أنّه قد يكون مشتاقًا لأوُ

131
00:08:11,980 --> 00:08:14,430
.لكن لا تخبري الأطبّاء

132
00:08:16,820 --> 00:08:18,560
لا يمكنك إيقاظها أيضًا، صحيح؟

133
00:08:22,710 --> 00:08:26,400
لكن بدأت أوُ-تشان تتحدّث
.في نومها كثيرًا مؤخّرًا

134
00:08:26,730 --> 00:08:28,070
فعلاً؟

135
00:08:28,070 --> 00:08:30,700
.كانت تتمتم باسمك

136
00:08:31,270 --> 00:08:32,150
اسمي؟

137
00:08:32,150 --> 00:08:36,110
يا إلهي، تراني حتّى في أحلامها؟

138
00:08:37,200 --> 00:08:39,700
لكن ما الّذي كانت تعنيه
بقولها "لا يمكننا في الخارج"؟

139
00:08:40,250 --> 00:08:41,440
.إنّها تحلم فقط

140
00:08:41,440 --> 00:08:44,250
وما الشّيء الّذي هي "متحمّسة" لأجله؟

141
00:08:44,250 --> 00:08:45,480
.إنّه حلم

142
00:08:45,480 --> 00:08:47,870
وما الّذي تريد "فعله مجدّدًا"؟

143
00:08:47,870 --> 00:08:49,710
!إنّها تحلم

144
00:08:51,000 --> 00:08:52,590
!أصبحت أوُ-تشان ملوّثة

145
00:08:52,590 --> 00:08:55,590
تمهّلي! إن كان هنالك من
...بادر بأيّ شيء

146
00:08:56,340 --> 00:08:57,300
.يا ويحي

147
00:09:00,780 --> 00:09:06,150
،هايري-سان، إن لم يكن لديك مانع
هل يمكنك التّحدّث إليها قليلاً؟

148
00:09:06,150 --> 00:09:09,310
التّحدّث إليها؟ لا أدري... عمّاذا مثلاً؟

149
00:09:09,310 --> 00:09:14,190
عن أيّ شيء يقنعها بأنّ العالم
.أكثر متعة من أحلامها

150
00:09:14,630 --> 00:09:15,850
.مفهوم

151
00:09:15,850 --> 00:09:18,570
...لا أدري بشأن كونه أكثر متعة

152
00:09:19,500 --> 00:09:22,330
.لكنّي اعتدتُ ممارسة السّباحة

153
00:09:22,330 --> 00:09:27,850
بمجرّد أن دخلتُ الثّانويّة، اختاروني
.للمشاركة في سباق التّتابع

154
00:09:28,600 --> 00:09:30,070
هذا ليس سيئًا، صحيح؟

155
00:09:30,070 --> 00:09:33,390
...لكن في إحدى المنافسات الصّيفيّة

156
00:09:34,670 --> 00:09:38,660
.شكرًا لأنّك تحدّثت مع أوُ

157
00:09:38,660 --> 00:09:42,030
.لا بأس، كانت فرصة جميلة بالنّسبة لي أيضًا

158
00:09:42,030 --> 00:09:44,100
.لكن لا أعلم إن كان لذلك أيّ أثر حقيقيّ

159
00:09:44,380 --> 00:09:48,730
.أنا متأكّدة من أنّها سعيدة بمعرفة المزيد عنك

160
00:09:49,090 --> 00:09:53,960
.لطالما تأثّرت بإصرار أوُ الصّادق

161
00:09:53,960 --> 00:09:56,150
.لديها قوّة لا أملكها أنا

162
00:09:56,590 --> 00:09:59,000
.وأعتقد أنّ تلك القوّة هي ما شدّني إليها

163
00:09:59,000 --> 00:09:59,870
.نعم

164
00:09:59,870 --> 00:10:01,590
.أنا فخورة بها

165
00:10:05,970 --> 00:10:07,540
...هايري

166
00:10:08,110 --> 00:10:09,200
أوُ؟

167
00:10:09,200 --> 00:10:13,240
...معًا إلى الأبد

168
00:10:13,240 --> 00:10:14,800
إنّها تحلم، أليس كذلك؟

169
00:10:15,080 --> 00:10:19,380
...قهوة عند الشّروق

170
00:10:20,760 --> 00:10:22,260
.نعم، فلنجرّب ذلك

171
00:10:22,260 --> 00:10:23,180
المعذرة؟

172
00:10:23,550 --> 00:10:26,680
.لذلك تجاوزي كلّ الأمور الجيّدة

173
00:10:27,620 --> 00:10:29,190
.لقد جرّبت المراسم بنفسي

174
00:10:29,830 --> 00:10:32,440
.أظنّ أنّه حتّى أنا أستطيع القيام بها

175
00:10:32,440 --> 00:10:33,520
.بون

176
00:10:36,210 --> 00:10:38,690
.واحدة أخرى

177
00:10:39,030 --> 00:10:42,580
.لا أحتاج حتّى للمسها مثل أوُ

178
00:10:42,580 --> 00:10:43,700
!بون

179
00:10:52,860 --> 00:10:56,670
.أوشكت الزّهور أن تتساقط كلّها

180
00:10:57,320 --> 00:11:01,180
أظنّ أنّ هذا يعني أنّ طقوس
.الجبل اقتربت من نهايتها

181
00:11:01,180 --> 00:11:02,460
...لا

182
00:11:02,460 --> 00:11:04,420
.إنّها ليست نهاية المهرجان فحسب

183
00:11:05,310 --> 00:11:08,140
.توشك العطلة الصّيفيّة أن تنتهي أيضًا

184
00:11:09,240 --> 00:11:13,310
.وبانتهائها، سأضطرّ إلى العودة إلى منزلي

185
00:11:14,610 --> 00:11:17,730
ستستيقظين قبل ذلك، أليس كذلك يا أوُ؟

186
00:11:29,240 --> 00:11:30,000
.تفضّل

187
00:11:31,560 --> 00:11:32,290
!أوُ

188
00:11:34,970 --> 00:11:36,380
هل أفرطتُ في النّوم؟

189
00:11:38,000 --> 00:11:39,170
أوُ-تشان؟

190
00:11:39,640 --> 00:11:41,320
.آسفة يا أي

191
00:11:41,320 --> 00:11:45,510
استيقظتِ أخيرًا، ولكنّي خلدتُ
.في نوم طويل بعدها مباشرة

192
00:11:45,800 --> 00:11:46,890
.لا بأس

193
00:11:47,720 --> 00:11:50,860
.تسنّى لي سماع صوتك

194
00:11:51,530 --> 00:11:52,810
.أنا بخير الآن

195
00:11:53,820 --> 00:11:55,270
.سأذهب لأُحضر الطّبيب

196
00:11:55,270 --> 00:11:56,420
.انتظر

197
00:11:57,240 --> 00:12:00,880
.أريد أن أتنفّس هواءً نقيًّا أوّلاً

198
00:12:00,880 --> 00:12:01,880
...حسنًا

199
00:12:01,880 --> 00:12:03,240
هل أفتح النّافذة؟

200
00:12:03,500 --> 00:12:06,990
.لا، أقصد أنّني أريد الخروج في نزهة قصيرة

201
00:12:08,680 --> 00:12:09,860
...لذلك

202
00:12:11,530 --> 00:12:12,960
.احملني

203
00:12:15,460 --> 00:12:19,600
.أتذكّر كلّ ما فعلته من أجلي

204
00:12:19,600 --> 00:12:21,210
لم تقولين ذلك الآن؟

205
00:12:22,010 --> 00:12:25,220
،لا أستطيع الحركة بسهولة بعد
.لكنّني سأبذل جهدي

206
00:12:27,080 --> 00:12:29,180
.سأفعل ما تفعلينه أنت تمامًا

207
00:12:30,340 --> 00:12:31,590
.حسنًا

208
00:12:33,080 --> 00:12:34,740
.هذا أمر يستحقّ التّرقّب

209
00:12:35,840 --> 00:12:38,990
،لا أمانع الخروج قليلاً
.لكن ليس لوقت طويل

210
00:12:38,990 --> 00:12:40,490
.كنت نائمة لفترة طويلة

211
00:12:40,490 --> 00:12:41,570
.فلا ترهقي نفسك

212
00:12:41,570 --> 00:12:44,700
.أرجوك، افعل هذا من أجلها، ولو للحظات

213
00:12:45,080 --> 00:12:48,120
.ما دامت لا تزال قادرة على البقاء مستيقظة

214
00:12:48,120 --> 00:12:51,140
ماذا؟ عمّ تتحدّثان؟

215
00:12:52,880 --> 00:12:54,580
ما الّذي تفعله هنا؟

216
00:12:54,580 --> 00:12:56,630
...مهلاً، أوُ

217
00:12:56,630 --> 00:12:57,750
...أهذه

218
00:12:58,330 --> 00:13:01,050
.لمستُ الكثير من الذّكريات

219
00:13:01,050 --> 00:13:03,510
.يعجّ رأسي بالفوضى

220
00:13:03,930 --> 00:13:06,760
.أسمع أصوات النّاس باستمرار

221
00:13:06,760 --> 00:13:09,010
.من الصّعب أن أتمسّك بذاتي

222
00:13:09,310 --> 00:13:10,330
...أوُ

223
00:13:10,330 --> 00:13:11,390
...لا

224
00:13:11,860 --> 00:13:17,390
يجب أن أعيد هذه إلى ملاذها
.بينما لا أزال مستيقظة

225
00:13:18,280 --> 00:13:20,150
.أنت الوحيد الّذي يمكنني الاعتماد عليه

226
00:13:20,150 --> 00:13:21,480
...لا

227
00:13:21,480 --> 00:13:23,190
.انسي ذلك الآن

228
00:13:23,190 --> 00:13:24,530
!علينا أن نفعل شيئًا لأجلك أنتِ

229
00:13:24,530 --> 00:13:25,440
.هايري-سان

230
00:13:26,730 --> 00:13:28,390
.أرجوك

231
00:13:28,390 --> 00:13:31,660
.حقّق لها هذه الأمنيّة لو سمحت

232
00:13:34,050 --> 00:13:36,490
علينا الذّهاب إلى مايوي تاتشيبانا فحسب، صحيح؟

233
00:13:38,000 --> 00:13:41,080
ربّما يمكننا أن نسلك بعض الطرق
.الجانبيّة ونحن بصدد هذا

234
00:13:41,080 --> 00:13:42,460
طرق جانبيّة؟

235
00:14:33,970 --> 00:14:35,380
...حسنًا

236
00:14:35,930 --> 00:14:36,470
أوُ؟

237
00:14:40,770 --> 00:14:42,480
.أ-أنا بخير

238
00:14:43,720 --> 00:14:47,570
.لكن قد أحتاجك أن تُسرع قليلاً

239
00:14:53,240 --> 00:14:54,410
!بون

240
00:14:54,410 --> 00:14:56,690
.أوُ، إنّه إيناري

241
00:14:57,700 --> 00:14:58,690
!بون

242
00:15:00,010 --> 00:15:01,460
.إيناري

243
00:15:03,550 --> 00:15:07,000
أقلقتك عليّ أيضًا، صحيح؟

244
00:15:08,640 --> 00:15:11,960
.شكرًا لأنّك ساعدتني كثيرًا

245
00:15:13,590 --> 00:15:16,650
إيناري، هل يمكنك أن تأخذنا
إلى مايوي تاتشيبانا؟

246
00:15:17,430 --> 00:15:18,650
!بون

247
00:15:30,990 --> 00:15:36,660
أعتقد أنّ هذا هو المكان الّذي
.رأيتك فيه تؤدّين الطّقس لأوّل مرّة

248
00:15:36,660 --> 00:15:41,750
...قلت لك ألاّ تأتي إلى هنا، لكنّك

249
00:15:43,320 --> 00:15:47,450
.لا تستمع إليّ إطلاقًا

250
00:15:47,450 --> 00:15:50,630
.لكنّني قضيت صيفًا جميلاً

251
00:15:50,630 --> 00:15:57,540
قضينا الوقت معًا كلّ يوم
...وفعلنا أشياء غبيّة ومتهوّرة

252
00:15:57,540 --> 00:16:01,770
.وكنتَ دائمًا بجانبي حين أغفو

253
00:16:02,440 --> 00:16:03,640
.شكرًا لك

254
00:16:03,930 --> 00:16:08,010
كما تعلمين، عليّ العودة إلى منزلي
.بعد العطلة الصّيفيّة

255
00:16:09,910 --> 00:16:13,290
،لكنّي سأسعى للحصول على عمل
.وسأعود في نهايات الأسبوع

256
00:16:14,700 --> 00:16:19,690
...في الخريف، في الشّتاء، في الرّبيع
.سأقضيها معك كلّها في الجزيرة

257
00:16:19,690 --> 00:16:23,160
.وسنقضي صيفًا آخر معًا، كما فعلنا هذا العام

258
00:16:24,590 --> 00:16:26,850
.هذا يُسعدني كثيرًا

259
00:16:26,850 --> 00:16:29,040
...لكنّني سأكون

260
00:16:29,040 --> 00:16:34,930
حتّى وإن بقيت نائمة، فسأكون
.هنا على هذه الجزيرة

261
00:16:34,930 --> 00:16:36,180
.هايري

262
00:16:36,670 --> 00:16:39,850
.سيكون من واجبي أن أوقظك

263
00:16:40,120 --> 00:16:43,060
.ابدأ بلُطف

264
00:16:43,310 --> 00:16:45,160
.سأكون دائمًا لطيفًا

265
00:16:45,160 --> 00:16:48,860
.لكنّ ذلك قد يصبح مملاًّ مع الوقت

266
00:17:05,260 --> 00:17:06,840
.ها قد وصلنا يا أوُ

267
00:17:07,540 --> 00:17:09,040
.مايوي تاتشيبانا

268
00:17:12,640 --> 00:17:13,300
أوُ؟

269
00:17:16,380 --> 00:17:17,880
...عددها كثير

270
00:17:17,880 --> 00:17:18,970
منذ متى كانت هكذا؟

271
00:17:20,970 --> 00:17:22,120
!هـ-هيّا

272
00:17:22,120 --> 00:17:23,370
—ما الّذي تـ

273
00:17:27,800 --> 00:17:29,020
...ما الّذي

274
00:17:30,930 --> 00:17:35,530
أهذه كلّ الذّكريات الّتي لم تستطع
تجاوزها في نومها، تتدفّق الآن خارجها؟

275
00:17:35,530 --> 00:17:40,770
في هذه الحالة، ربّما إن غادرت كلّ
.الشّيتشييتشو جسد أوُ، فستستفيق

276
00:17:44,530 --> 00:17:45,250
إيناري؟

277
00:17:48,720 --> 00:17:49,650
!أوُ

278
00:17:49,650 --> 00:17:50,610
!استيقظي

279
00:17:50,610 --> 00:17:53,340
لا تزال ذكرياتك بداخلك، أليس كذلك؟

280
00:17:53,850 --> 00:17:54,720
!أوُ

281
00:17:57,940 --> 00:17:59,060
...كلاّ

282
00:17:59,060 --> 00:18:00,330
أهي بينها؟

283
00:18:01,260 --> 00:18:02,260
!هذا لا يمكن

284
00:18:02,570 --> 00:18:03,640
!انتظري

285
00:18:03,640 --> 00:18:05,810
!أوُ

286
00:18:08,600 --> 00:18:11,410
.هاجمني وأنا نائمة

287
00:18:11,410 --> 00:18:14,860
لكنّه أيضًا كان قلقًا عليّ؟

288
00:18:15,140 --> 00:18:16,780
.يا له من غريب

289
00:18:16,780 --> 00:18:20,500
،رآني أخلع ملابسي
.ثمّ رشقني بالثّلج المبشور

290
00:18:20,500 --> 00:18:21,670
!ماذا؟

291
00:18:22,650 --> 00:18:24,990
...مع ذلك، استمتعت بوقتي نوعًا ما

292
00:18:24,990 --> 00:18:27,870
ها هو ذا يتحمّس كثيرًا من أجل
.مجموعة أطفال. يا له من طفل

293
00:18:27,870 --> 00:18:31,750
لكنّك كنت تنوي الخسارة بالفعل، أليس كذلك؟

294
00:18:31,750 --> 00:18:34,330
.على الأقلّ، أعلم الآن أنّك لستَ شخصًا سيّئًا

295
00:18:34,920 --> 00:18:37,090
!قـ-قال أنّني جميلة

296
00:18:37,090 --> 00:18:39,380
...وسأل إن كان يستطيع لمسي

297
00:18:39,380 --> 00:18:41,090
!كان يقصد التّونبوداما؟

298
00:18:41,090 --> 00:18:42,930
!خفق قلبي بقوّة

299
00:18:42,930 --> 00:18:45,600
!لا أصدّق أنّني سمعت ذلك

300
00:18:45,600 --> 00:18:47,070
ماذا عليّ أن أفعل؟

301
00:18:47,070 --> 00:18:48,900
!قال أنّه يحبّني

302
00:18:48,900 --> 00:18:50,430
كيف أشعر أنا؟

303
00:18:50,430 --> 00:18:52,130
...أنا

304
00:18:52,130 --> 00:18:54,480
.لا أعلم بعد

305
00:18:54,480 --> 00:18:56,130
!نحن نعانق بعضنا

306
00:18:56,130 --> 00:18:56,980
!إنّه دافئ جدًّا

307
00:18:56,980 --> 00:18:58,030
!وقويّ

308
00:18:58,290 --> 00:19:00,200
!يخفق قلبي بشدّة

309
00:19:00,200 --> 00:19:01,640
!حمدًا على هذا

310
00:19:01,640 --> 00:19:02,950
.هايري بخير

311
00:19:02,950 --> 00:19:05,490
...أشعر براحة تامّة

312
00:19:05,490 --> 00:19:06,580
.هذا ليس عدلاً

313
00:19:06,580 --> 00:19:09,410
كيف لي أن أقول "لا" لذلك؟

314
00:19:10,520 --> 00:19:12,580
.كلاّ، هذا سيّئ

315
00:19:12,580 --> 00:19:14,820
.أنا أرتعش بسبب هذا

316
00:19:15,460 --> 00:19:17,170
.أنا سعيدة للغاية

317
00:19:17,580 --> 00:19:19,390
.هذه نعمة حقيقيّة

318
00:19:19,390 --> 00:19:22,530
.أشعر بالأمان ما دام هايري بجانبي

319
00:19:22,930 --> 00:19:24,430
.أنا أحبّه

320
00:19:25,080 --> 00:19:27,010
.تبادلنا قبلة للتّوّ

321
00:19:27,730 --> 00:19:29,890
.أريد أن أكون مع هايري

322
00:19:30,440 --> 00:19:31,600
.حتّى بعد انتهاء الصّيف

323
00:19:31,600 --> 00:19:33,400
.أريد أن أكون معه إلى الأبد

324
00:19:33,400 --> 00:19:36,450
...هايري... هايري

325
00:19:37,480 --> 00:19:39,110
.أنا آسفة

326
00:19:39,110 --> 00:19:41,950
.سأحبّك دائمًا

327
00:19:48,280 --> 00:19:49,510
...أوُ

328
00:19:49,510 --> 00:19:51,890
أكانت تلك ذكرياتك؟

329
00:19:52,630 --> 00:19:54,460
هل كنت تفكرين بي إلى هذا الحدّ؟

330
00:19:59,110 --> 00:20:01,250
.هذا ليس وداعًا

331
00:20:01,250 --> 00:20:02,340
.لا تعتذري

332
00:20:03,800 --> 00:20:05,860
ستخلدين للنّوم فحسب، صحيح؟

333
00:20:07,970 --> 00:20:10,190
.هيّا نعد إلى المنزل يا أوُ

334
00:20:16,440 --> 00:20:17,560
...أوُ-تشان

335
00:20:18,390 --> 00:20:20,110
.امنحيني عامًا واحدًا

336
00:20:20,110 --> 00:20:22,950
.ستُزهر مايوي تاتشيبانا ثانية

337
00:20:22,950 --> 00:20:26,110
.وعندها، سأجد أوُ خلال طقس الجبل

338
00:20:27,470 --> 00:20:30,080
تفكرين في الشّيء نفسه، أليس كذلك؟

339
00:20:30,080 --> 00:20:32,920
.سأقوم بما فعلته أوُ-تشان من أجلي فحسب

340
00:20:32,920 --> 00:20:35,000
.سأردّ المعروف فحسب

341
00:20:35,290 --> 00:20:38,000
حسنًا، سيتعيّن عليك الاجتهاد
.في علاجك الطّبيعيّ

342
00:20:40,990 --> 00:20:43,760
.هايري-سان، أودّ أن أطلب منك معروفًا

343
00:20:45,060 --> 00:20:48,550
.واصل زيارة أوُ-تشان من فضلك

344
00:20:48,990 --> 00:20:53,320
.أخبرها بما تراه وتسمعه وتعيشه

345
00:20:53,320 --> 00:20:57,690
.املأ الفراغات من أجلها بينما هي نائمة

346
00:20:58,410 --> 00:21:04,210
أُفضّل لو استطعتُ أن أُعيد
.لها الوقت الّذي منحَتني إيّاه

347
00:21:04,840 --> 00:21:07,570
.لكنّني لا أستطيع المشي جيّدًا بعد

348
00:21:08,280 --> 00:21:09,690
.لا داعي للقلق

349
00:21:09,690 --> 00:21:11,290
.كنت أتحدّث معها عن هذا الأمر

350
00:21:11,970 --> 00:21:14,940
،سأعود إلى منزلي بعد انتهاء عطلة الصّيف

351
00:21:14,940 --> 00:21:18,710
لكنّني سأبحث عن عمل بدوام جزئي لتوفير
.المال لقضاء عطلات نهاية الأسبوع هنا

352
00:21:18,710 --> 00:21:23,090
سأقضي الخريف والشّتاء والرّبيع
.على هذه الجزيرة معها

353
00:21:23,090 --> 00:21:26,720
.ثمّ سنقضي الصّيف القادم معًا مرّة أخرى

354
00:21:26,720 --> 00:21:28,340
...هايري-سان

355
00:21:28,720 --> 00:21:32,350
.كما أنّ هنالك أمرًا وعدتُها به قبل ذلك

356
00:21:32,840 --> 00:21:36,340
.إنّ إيقاظها هو واجبي دائمًا

357
00:21:41,730 --> 00:21:43,180
.لا داعي للقلق

358
00:21:43,180 --> 00:21:45,240
.واثقة أنّه سيجدك

359
00:21:49,630 --> 00:21:50,930
...سأكون

360
00:21:51,470 --> 00:21:52,180
.نعم

361
00:21:52,690 --> 00:21:54,180
.ما زلتُ بخير

362
00:22:54,460 --> 00:22:56,600
حسنًا، أتريدين أن نبدأ؟

363
00:23:06,150 --> 00:23:08,560
.كنتُ أسمع صوتًا طوال الوقت

364
00:23:09,720 --> 00:23:12,430
.صوتًا يبعث في نفسي الطّمأنينة

365
00:23:12,430 --> 00:23:14,390
.صوتًا أحببته

366
00:23:14,390 --> 00:23:17,140
.صوتًا كان يرسم الابتسامة على وجهي

367
00:23:17,140 --> 00:23:20,570
.نورًا لطيفًا يهزّ قلبي برفق

368
00:23:21,080 --> 00:23:23,830
...كان يخنقني بقدر قليل جدًّا

369
00:23:25,400 --> 00:23:28,350
.لكنّ الدّفء كان يسري في جسدي

370
00:23:28,960 --> 00:23:32,040
.أعلم تمامًا ما سأقوله أوّلاً

371
00:23:32,040 --> 00:23:34,370
.ما كنتُ أقوله طوال هذا الوقت

372
00:23:34,370 --> 00:23:37,070
.ما كنتُ أرغب في قوله طوال الوقت

373
00:23:37,070 --> 00:23:38,330
.صباح الخير