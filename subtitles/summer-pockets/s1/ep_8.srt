1
00:00:03,730 --> 00:00:05,900
ستقدّم عطلتك الصّيفيّة لتسوموغي؟

2
00:00:06,230 --> 00:00:09,160
،اتّخذتُ ذلك القرار من تلقاء نفسي

3
00:00:09,160 --> 00:00:11,250
لكن سيكون من اللّطيف
.إن انضممتِ لنا يا شيزوكو

4
00:00:12,610 --> 00:00:14,050
ألا... تريدين؟

5
00:00:14,050 --> 00:00:15,310
شيزوكو؟

6
00:00:15,910 --> 00:00:16,870
...لماذا

7
00:00:18,640 --> 00:00:21,470
بالطّبع. لماذا قد أرفض؟

8
00:00:21,470 --> 00:00:25,370
يمكنك الحصول على كلّ ما تبقّى
.من هذا الصّيف

9
00:00:25,700 --> 00:00:28,110
!أحبّك يا شيزوكو

10
00:00:28,110 --> 00:00:29,810
!أحبّك أيضًا يا تسوموغي

11
00:00:31,210 --> 00:00:32,600
.شكرًا يا شيزوكو

12
00:00:32,600 --> 00:00:36,680
.بل الشّكر لك أنت على هذا العرض الرّائع

13
00:00:36,680 --> 00:00:38,980
.لنستغلّ عطلة الصّيف إلى أقصى حدّ

14
00:00:38,980 --> 00:00:40,190
صحيح يا تسوموغي؟

15
00:00:41,150 --> 00:00:42,100
تسوموغي؟

16
00:00:46,000 --> 00:00:50,270
.وهكذا، بدأت عطلتنا الصّيفيّة الحقيقيّة

17
00:01:06,330 --> 00:01:11,800
جيوب صيف

18
00:02:21,800 --> 00:02:23,320
...بارينغلز

19
00:02:23,640 --> 00:02:25,700
!وشرفة أيضًا

20
00:02:25,700 --> 00:02:28,210
.لا أفهم مقصدك من هذا

21
00:02:28,210 --> 00:02:30,050
بارينغلز؟

22
00:02:30,050 --> 00:02:32,610
تقصدين العلب الّتي وجدتها
أثناء جمع القمامة؟

23
00:02:32,610 --> 00:02:33,170
.نعم

24
00:02:33,170 --> 00:02:36,550
احتفظت بها لأنّني لم أستطع
.أن أقرّر أيّ نوع من القمامة هي

25
00:02:36,550 --> 00:02:38,550
.لذلك فكّرتُ في هذا ليلة الأمس

26
00:02:39,800 --> 00:02:41,840
!سنبني شرفة

27
00:02:42,190 --> 00:02:43,490
!من خلال إعادة التّدوير

28
00:02:43,490 --> 00:02:47,350
.ستتحوّل عُلب بارينغلز الفارغة إلى شرفة

29
00:02:49,230 --> 00:02:50,840
لماذا شرفة بالتّحديد؟

30
00:02:50,840 --> 00:02:52,560
.لأنّي أريد شرفة

31
00:02:53,200 --> 00:02:57,190
.لكنّها قد تنكسر وتسقط إن صعدت عليها

32
00:02:57,190 --> 00:02:58,930
!سيكون كلّ شيء بخير

33
00:02:58,930 --> 00:03:00,970
.بارينغلز منيعة

34
00:03:00,970 --> 00:03:05,670
.لكنّني لا أدري إن كنّا نملك ما يكفي لبناء شرفة

35
00:03:08,280 --> 00:03:10,370
.حسنًا، سأذهب لجمعها

36
00:03:10,370 --> 00:03:12,430
.لنُقم اجتماعًا استراتيجيًّا

37
00:03:12,430 --> 00:03:14,880
!سأعود في الحال

38
00:03:16,370 --> 00:03:18,930
شرفة من عُلب بارينغلز؟

39
00:03:18,930 --> 00:03:21,110
.دائمًا ما تخطر عليها أكثر الأفكار جنونًا

40
00:03:21,110 --> 00:03:23,130
.ذلك بالتّأكيد ما يمكن توقّعه منها

41
00:03:24,180 --> 00:03:27,330
...لكنّي ما زلت لا أصدّق الأمر

42
00:03:27,330 --> 00:03:31,250
لن نستطيع رؤية تسوموغي
.ثانية بعد انتهاء الصّيف

43
00:03:31,250 --> 00:03:35,020
أريد فقط تكريس وقتي لها بينما
.ما زلنا قادرين على ذلك

44
00:03:35,720 --> 00:03:39,400
.صار ذلك هو هدفي في هذا الصّيف

45
00:03:39,700 --> 00:03:41,860
هل وقعت في حبّها؟

46
00:03:41,860 --> 00:03:42,740
ماذا؟

47
00:03:42,740 --> 00:03:44,690
.أنت غارق في حبّها حتّى أذنيك

48
00:03:44,690 --> 00:03:48,830
حتّى أنّها بدأت تناديك هايري-سان
.بدلاً من تاكاهارا-سان

49
00:03:48,830 --> 00:03:51,150
عـ-عمّ تتحدّثين؟

50
00:03:51,150 --> 00:03:55,780
.أريد أن تكون تسوموغي سعيدة فحسب

51
00:03:55,780 --> 00:03:58,840
.أتعلم؟ هذا ما يسمّى بالحبّ

52
00:03:59,880 --> 00:04:01,320
...لـ-لكن

53
00:04:01,320 --> 00:04:03,170
.لا أعرف كيف أستوعب هذا

54
00:04:03,860 --> 00:04:06,930
لا يمنح الحبُّ صاحبه أيّ وقت
.لاستيعابه يا هايري-كُن

55
00:04:08,090 --> 00:04:11,030
هل الأمر هكذا بالفعل؟

56
00:04:11,030 --> 00:04:13,810
هل أنا واقع في حبّ تسوموغي؟

57
00:04:15,690 --> 00:04:16,940
!تـ-تسوموغي؟

58
00:04:17,790 --> 00:04:22,190
هايري-سان... أنت واقع في حبّي؟

59
00:04:22,190 --> 00:04:25,000
...ذ-ذلك

60
00:04:25,000 --> 00:04:25,990
هل أنت بخير؟

61
00:04:26,490 --> 00:04:28,080
.لا تبدين على طبيعتك

62
00:04:28,080 --> 00:04:30,510
!بالطّبع لستُ على طبيعتي

63
00:04:30,510 --> 00:04:33,260
أخبرني رجل للتّوّ أنّه واقع
!في حبّي للمرّة الأولى

64
00:04:33,260 --> 00:04:34,160
.أما محرجة بالكامل

65
00:04:42,300 --> 00:04:44,670
!موغيو

66
00:04:47,280 --> 00:04:50,160
.سأعيرك صدري إن تمّ رفضك

67
00:04:50,160 --> 00:04:51,930
.ابكِ على راحتك

68
00:04:52,600 --> 00:04:54,180
.لا أريد

69
00:05:14,130 --> 00:05:15,380
.سيكون كلّ شيء بخير

70
00:05:16,820 --> 00:05:18,910
.ما زال لديّ وقت

71
00:05:21,370 --> 00:05:23,250
!سنتناول أرزًّا مقليًّا بقنفذ البحر اليوم

72
00:05:25,950 --> 00:05:28,100
هل تستمع لي يا هايري-سان؟

73
00:05:28,610 --> 00:05:29,320
...لا

74
00:05:29,320 --> 00:05:31,020
.لا يجب أن أغرق في الاكتئاب الآن

75
00:05:31,020 --> 00:05:34,470
.سأزيد الأمور تعقيدًا على تسوموغي فحسب

76
00:05:34,470 --> 00:05:37,190
!تشجّع يا تاكاهارا هايري

77
00:05:38,810 --> 00:05:41,020
.صباح الخير يا هايري-سان

78
00:05:41,020 --> 00:05:41,810
ماذا؟

79
00:05:42,830 --> 00:05:44,150
!موغيو

80
00:05:44,150 --> 00:05:46,990
!يوم آخر بطقس جميل

81
00:05:47,470 --> 00:05:51,780
.أظنّها تتظاهر وكأنّ ما حدث بالأمس لم يحدث

82
00:05:51,780 --> 00:05:53,840
هل أعيرك صدري؟

83
00:05:56,950 --> 00:05:58,040
.لا

84
00:05:58,040 --> 00:06:02,120
!موغيو

85
00:06:03,540 --> 00:06:05,050
جليد

86
00:06:05,510 --> 00:06:06,740
.مرحبًا

87
00:06:06,740 --> 00:06:07,300
ماذا؟

88
00:06:07,830 --> 00:06:09,000
.طاب يومك

89
00:06:09,000 --> 00:06:10,080
.أهلاً

90
00:06:10,080 --> 00:06:11,800
!مـ-ميزوري-سينباي

91
00:06:11,800 --> 00:06:13,760
.طاب يومك يا كانو-كُن

92
00:06:13,760 --> 00:06:14,600
!حاضر

93
00:06:14,600 --> 00:06:16,680
!طاب يومك أيضًا يا سينباي

94
00:06:16,950 --> 00:06:18,790
سينباي؟ شيزوكو؟

95
00:06:18,790 --> 00:06:19,440
.هذا مؤلم

96
00:06:19,440 --> 00:06:21,480
!كيف تتجرّأ على مناداتها باسمها الشّخصيّ؟

97
00:06:21,480 --> 00:06:23,980
!من تظنّ نفسك؟

98
00:06:22,640 --> 00:06:23,980
.اهدأ يا تنزن

99
00:06:23,980 --> 00:06:26,700
ألم تعلم بالفعل يا تاكاهارا؟

100
00:06:26,700 --> 00:06:31,630
ميزوري-سينباي هي رئيسة تلاميذ
.مدرستنا واسعة الشّعبيّة

101
00:06:31,630 --> 00:06:33,220
!مهلاً، أهذا حقيقيّ؟

102
00:06:33,220 --> 00:06:34,440
.مستحيل

103
00:06:34,440 --> 00:06:37,480
.أنا مجرّد صدر لا غير

104
00:06:37,480 --> 00:06:39,790
.ألا ترون؟ وصفت نفسها بـ"صدر" للتّوّ

105
00:06:39,790 --> 00:06:40,820
ماذا؟

106
00:06:40,820 --> 00:06:42,470
عمّ تتحدّثن؟

107
00:06:42,470 --> 00:06:46,150
لماذا قد تقول ميزوري-سينباي
شيئًا بتلك السّخافة؟

108
00:06:47,790 --> 00:06:49,790
هل أنت يائس من أجل صدر لهذه الدّرجة؟

109
00:06:49,790 --> 00:06:50,840
!ما باليد حيلة إذًا

110
00:06:53,460 --> 00:06:55,800
كيف تجرؤ على كشف نفسك
!أمام ميزوري-سينباي؟

111
00:06:55,800 --> 00:06:56,970
!لا تخلع ملابسك

112
00:07:02,670 --> 00:07:05,670
.على أيّ حال، إنّكم مجموعة غريبة بالفعل

113
00:07:05,670 --> 00:07:10,460
لم أرَ تسوموغي مع أحد آخر غير
.ميزوري-سينباي على الإطلاق

114
00:07:10,460 --> 00:07:11,530
فعلاً؟

115
00:07:11,530 --> 00:07:16,110
.مع ذلك، من النّادر رؤية تسوموغي أيضًا

116
00:07:16,110 --> 00:07:18,240
.لا أراها في الجزيرة كثيرًا

117
00:07:18,240 --> 00:07:20,840
.تكون تسوموغي شاردة التّفكير دائمًا

118
00:07:20,840 --> 00:07:22,880
.لا يسعني سوى القلق عليها

119
00:07:22,880 --> 00:07:26,650
لا أصدّق أنّها تقضي الوقت
...معك أنت بالتّحديد

120
00:07:26,650 --> 00:07:28,920
ما الّذي حدث بالضّبط؟

121
00:07:28,920 --> 00:07:30,200
...لا شيء

122
00:07:30,200 --> 00:07:32,340
.لا شيء على الإطلاق

123
00:07:32,990 --> 00:07:34,930
لما صرت محبطًا هكذا فجأة؟

124
00:07:35,390 --> 00:07:36,760
حسنًا، ما الّذي أتى بك اليوم؟

125
00:07:37,160 --> 00:07:38,260
.صحيح

126
00:07:38,840 --> 00:07:39,810
...في الحقيقة

127
00:07:41,010 --> 00:07:45,640
هذا لحسن حظّنا. إنّهم يساعدوننا
.على إيجاد علب بارينغلز

128
00:07:45,640 --> 00:07:46,500
.نعم

129
00:07:46,500 --> 00:07:49,680
!كما أنّ مذاق غزل البنات لذيذ جدًّا

130
00:07:54,370 --> 00:07:56,490
.تفضّل بعضه يا هايري-سان

131
00:07:56,490 --> 00:07:57,780
!"قل "آه

132
00:07:57,780 --> 00:07:59,450
...عـ-عفوًا

133
00:07:59,750 --> 00:08:00,410
.هيّا

134
00:08:00,410 --> 00:08:01,450
"!آه"

135
00:08:03,290 --> 00:08:04,580
...آه

136
00:08:05,760 --> 00:08:06,960
.وأنت أيضًا يا شيزوكو

137
00:08:06,960 --> 00:08:08,530
!آه

138
00:08:09,670 --> 00:08:10,980
.لذيذ

139
00:08:10,980 --> 00:08:11,820
.صحيح

140
00:08:11,820 --> 00:08:14,180
!خدّاي يؤلمانني من الابتسام

141
00:08:24,760 --> 00:08:27,330
،العطلة الصّيفيّة الّتي كرّستُها لتسوموغي

142
00:08:27,330 --> 00:08:30,880
...صيفنا الّذي قضيناه بحثًا عن هدف

143
00:08:30,880 --> 00:08:32,570
.مضى بتلك السّرعة

144
00:08:36,680 --> 00:08:40,970
جمعنا علب بارينغلز فارغة لبناء الشّرفة

145
00:08:45,160 --> 00:08:49,790
.وبحثنا عن أيّ أحد قد يعرف أغنية تسوموغي

146
00:08:51,880 --> 00:08:53,590
...موغيو

147
00:08:57,760 --> 00:09:00,260
!شكرًا يا كانو-كُن

148
00:09:00,930 --> 00:09:02,000
!أجل

149
00:09:02,000 --> 00:09:03,930
!امتنانك مكافأة بحدّ ذاته

150
00:09:03,930 --> 00:09:05,430
جليد

151
00:09:04,990 --> 00:09:07,390
.لم يكن ذلك كلّ ما فعلناه أيضًا

152
00:09:10,160 --> 00:09:12,560
...تلك الأيّام السّعيدة

153
00:09:17,950 --> 00:09:19,400
...عطلة صيفنا

154
00:09:21,150 --> 00:09:23,220
...المميّزة بالنّسبة لنا

155
00:09:23,840 --> 00:09:25,190
.مرّت بسرعة

156
00:09:30,320 --> 00:09:32,460
.مرحبًا يا مثلّجات البطّيخ-سان

157
00:09:32,460 --> 00:09:34,440
.ماذا؟ غزل البنات-سان

158
00:09:34,440 --> 00:09:36,340
.مرحبًا يا ناروسي-سان

159
00:09:36,770 --> 00:09:37,930
.مرحبًا

160
00:09:37,930 --> 00:09:38,710
.تفضّلي

161
00:09:38,710 --> 00:09:40,390
.الهديّة المعتادة

162
00:09:40,390 --> 00:09:44,310
مثلّجات بطّيخ

163
00:09:42,000 --> 00:09:43,160
.شكرًا لك

164
00:09:43,670 --> 00:09:44,310
ماذا؟

165
00:09:44,310 --> 00:09:48,290
.لم أعتقد أنّكما تعرفان بعضكما

166
00:09:48,290 --> 00:09:51,650
.تعرّفنا أنا ومثلّجات البطّيخ-سان على بعضنا هنا

167
00:09:52,000 --> 00:09:54,860
.لنُعد تمثيل أحداث يوم لقائنا

168
00:09:59,400 --> 00:10:02,330
هل صدتِ أيّ شيء؟

169
00:10:00,600 --> 00:10:00,950
ماذا؟

170
00:10:02,330 --> 00:10:04,490
...أ-أنا

171
00:10:04,840 --> 00:10:06,250
.أُبلي نُصّ-نُصّ

172
00:10:06,550 --> 00:10:09,040
هل "نُصّ-نُصّ" اسم سمكة ما؟

173
00:10:09,040 --> 00:10:12,150
.لا، يعني أنّي أبلي بشكل لا بأس به

174
00:10:12,150 --> 00:10:13,250
.فهمت

175
00:10:16,160 --> 00:10:18,070
هل ستأكلين ما أمسكت به؟

176
00:10:18,070 --> 00:10:19,110
.نعم

177
00:10:19,110 --> 00:10:20,480
!هكذا إذًا

178
00:10:20,480 --> 00:10:23,840
ما أكثر ما تحبّين أكله؟

179
00:10:23,840 --> 00:10:25,300
.مثلّجات البطّيخ

180
00:10:25,300 --> 00:10:26,980
!ماذا؟! بإمكانك صيد ذلك؟

181
00:10:26,980 --> 00:10:28,060
.لا، لا يمكنني

182
00:10:28,060 --> 00:10:29,980
.تباع في محلّ الوجبات الخفيفة

183
00:10:29,980 --> 00:10:31,180
.ذلك منطقيّ

184
00:10:31,180 --> 00:10:33,570
.أنا أحبّ غزل البنات

185
00:10:33,570 --> 00:10:35,200
فعلاً؟

186
00:10:40,780 --> 00:10:44,200
...أريد تناول مثلّجات بطّيخ الآن

187
00:10:44,200 --> 00:10:47,310
.وأنا أريد أكل غزل بنات الآن

188
00:10:49,260 --> 00:10:51,780
.وهكذا صرنا صديقتين

189
00:10:51,780 --> 00:10:54,290
.أُحضر لها مثلّجات البطّيخ أحيانًا

190
00:10:55,840 --> 00:10:58,190
.أنا أقدّر إحضارك لها

191
00:10:58,840 --> 00:11:02,170
.عجبًا، إنّهما تتواصلان بالفعل

192
00:11:02,170 --> 00:11:03,260
.ذلك ما يبدو

193
00:11:03,260 --> 00:11:05,850
.نعم. نحن أفضل الأصدقاء الآن

194
00:11:05,850 --> 00:11:07,870
.لـ-لسنا أفضل الأصدقاء

195
00:11:07,870 --> 00:11:09,020
موغيو؟

196
00:11:09,570 --> 00:11:11,110
بارينغلز؟

197
00:11:11,110 --> 00:11:13,060
.لا أملك أيًّا من علبها في المنزل

198
00:11:13,060 --> 00:11:14,740
...هكذا إذًا

199
00:11:15,340 --> 00:11:20,100
لكنّي سأحضر لك العلب
.إن حصلنا على أيّ منها

200
00:11:20,640 --> 00:11:23,110
!موغيو! شكرًا لك

201
00:11:25,120 --> 00:11:26,520
.شكرًا يا شيروها

202
00:11:27,810 --> 00:11:29,990
.لا أقوم بذلك من أجلك أنت

203
00:11:32,300 --> 00:11:33,930
.حسنًا، أنا أفهم ذلك

204
00:11:41,540 --> 00:11:43,260
!المعذرة

205
00:11:43,260 --> 00:11:46,380
.آسفة، ليس لدينا بارينغلز اليوم

206
00:11:46,380 --> 00:11:48,570
.لا، لم نحضر لذلك السّبب هذه المرّة

207
00:11:48,570 --> 00:11:51,890
...أريد بعض غزل البنات يا

208
00:11:51,890 --> 00:11:53,700
!سوراكادو أوُ

209
00:11:53,700 --> 00:11:56,150
!سو! را! كا! دو! أوُ

210
00:11:56,150 --> 00:11:58,440
تتذكّرين اسمي، صحيح؟

211
00:11:58,720 --> 00:11:59,640
...عفوًا

212
00:12:00,090 --> 00:12:02,520
!أنت الشّخص الّذي يخلع ملابسه

213
00:12:02,520 --> 00:12:04,160
!ذلك ليس اسمي

214
00:12:04,160 --> 00:12:06,820
!سوراكادو أوُ

215
00:12:06,820 --> 00:12:07,990
!صرتُ جزءًا من هذا الآن؟

216
00:12:07,990 --> 00:12:09,210
!مفهوم

217
00:12:09,210 --> 00:12:10,370
!أوُ-سان

218
00:12:10,370 --> 00:12:11,660
!ساعدك ذلك على تذكّره؟

219
00:12:17,620 --> 00:12:19,490
.بايري-كُن، لحظة لو سحمت

220
00:12:20,950 --> 00:12:23,050
هديّة من أجل تسوموغي؟

221
00:12:23,460 --> 00:12:25,850
.لا، لا. سبق ورفضتني

222
00:12:25,850 --> 00:12:27,320
.لن تنظر إليّ حتّى

223
00:12:27,320 --> 00:12:30,560
من الأفضل أن يكون المرء صريحًا
.مع نفسه في مثل هذه الحالات

224
00:12:30,560 --> 00:12:33,910
.ضع يديك على صدرك واسأله

225
00:12:33,910 --> 00:12:38,810
إضافة لذلك، لن نستطيع رؤيتها
.بعد العطلة الصّيفيّة

226
00:12:43,020 --> 00:12:48,700
لذا أظنّ أنّه ينبغي أن يكون لديها
.على الأقلّ شيء تتذكّر به هذا الصّيف

227
00:12:49,230 --> 00:12:51,620
لكن أن أُهديها شيئًا من هنا؟

228
00:12:51,620 --> 00:12:53,700
.لدينا هنا كلّ ما يمكنك التّفكير فيه

229
00:12:54,690 --> 00:12:56,340
.مرحبًا يا جدّتي

230
00:12:57,670 --> 00:12:59,290
أوريغامي

231
00:12:57,670 --> 00:12:59,290
أختام

232
00:13:13,130 --> 00:13:17,540
ما الّذي كنتما تتحدّثان عنه من قبل
يا هايري-سان وشيزوكو؟

233
00:13:18,020 --> 00:13:19,840
.لا-لا شيء

234
00:13:19,840 --> 00:13:21,060
...موغيو

235
00:13:21,060 --> 00:13:22,270
.هذا مثير للشّبهات

236
00:13:22,270 --> 00:13:25,670
،اسمعي يا تسوموغي
ما الّذي تريدين فعله تاليًا؟

237
00:13:25,670 --> 00:13:26,530
!صحيح

238
00:13:26,530 --> 00:13:28,890
.أريد الذّهاب إلى منزل هايري-سان

239
00:13:28,890 --> 00:13:29,970
منزلي؟

240
00:13:29,970 --> 00:13:32,080
...قالت أوُ-سان قبل قليل

241
00:13:32,480 --> 00:13:38,710
إنّ أسرع طريقة للتّقرّب من شخص
.تهتمّين به هي أن تري غرفته

242
00:13:39,240 --> 00:13:41,840
.يمكنك إيجاد كتبه المنحرفة وما شابه هناك أيضًا

243
00:13:42,100 --> 00:13:42,840
صحيح؟

244
00:13:45,820 --> 00:13:50,090
حـ-حسنًا، لا أدري ما قد تقوله كيوكو-سان
...إن اقتحمنا جميعنا منزلها فجأة

245
00:13:50,090 --> 00:13:51,190
!يا إلهي

246
00:13:51,190 --> 00:13:52,920
.تفضّلا بالدّخول

247
00:13:52,920 --> 00:13:55,350
.شكرًا على اعتنائكما بهايري-سان

248
00:13:55,650 --> 00:13:57,640
.شكرًا على استضافتنا

249
00:13:57,640 --> 00:13:59,480
.فعل الكثير من أجلنا أيضًا

250
00:14:00,760 --> 00:14:01,800
...لحظة، لحظة

251
00:14:02,920 --> 00:14:06,700
من منهما الّتي دعتك لحفل المبيت قبل أيّام؟

252
00:14:07,230 --> 00:14:08,930
.الفتاة الشّقراء

253
00:14:08,930 --> 00:14:11,030
.لكنّنا كنّا معًا نحن الثّلاثة وقتها

254
00:14:12,250 --> 00:14:13,620
!تخرج مع كلتيهما؟

255
00:14:13,620 --> 00:14:14,520
...كلاّ

256
00:14:14,520 --> 00:14:16,600
.عليّ إخبار أختي

257
00:14:16,600 --> 00:14:18,540
!لا! لا تفعلي رجاءً

258
00:14:21,480 --> 00:14:24,320
هذه هي غرفتك إذًا؟

259
00:14:24,320 --> 00:14:25,760
...موغيو

260
00:14:25,760 --> 00:14:27,630
.أشعر بالقليل من التّوتّر

261
00:14:27,630 --> 00:14:32,010
،إنّها ليست غرفتي بالتّحديد
.لنقل أنّي أستعيرها لهذا الصّيف

262
00:14:32,010 --> 00:14:32,980
!يا إلهي

263
00:14:32,010 --> 00:14:35,100
نويتشيغو

264
00:14:32,980 --> 00:14:35,100
أنت تفهم الأمر إذًا يا بايري-كُن؟

265
00:14:39,060 --> 00:14:40,310
موغيو؟

266
00:14:40,760 --> 00:14:43,520
!لا، أجبرني صديق على قراءتها

267
00:14:44,710 --> 00:14:47,400
بايري-كُن، هلاّ خرجت من هنا لبعض الوقت؟

268
00:14:52,720 --> 00:14:54,140
!نحن جاهزتان

269
00:14:56,360 --> 00:14:56,870
ماذا؟

270
00:14:59,000 --> 00:15:00,660
...موغيو

271
00:15:00,660 --> 00:15:02,340
.هذا غير مريح على الإطلاق

272
00:15:02,340 --> 00:15:04,170
ما رأيك يا هايري-سان؟

273
00:15:04,170 --> 00:15:05,750
ما-ما الّذي تقصدينه؟

274
00:15:06,970 --> 00:15:08,130
حشوتِ ملابسك بشيء ما؟

275
00:15:08,800 --> 00:15:11,920
!موغيو

276
00:15:14,020 --> 00:15:15,470
...موغيو

277
00:15:17,520 --> 00:15:18,390
.يا إلهي

278
00:15:18,390 --> 00:15:20,060
هل لديكم وقت؟

279
00:15:23,010 --> 00:15:25,060
.عليّ الاتّصال بأختي بالفعل

280
00:15:25,060 --> 00:15:26,980
!لا تفعلي رجاءً

281
00:15:30,710 --> 00:15:32,120
.ها هي

282
00:15:32,120 --> 00:15:32,940
.خذ

283
00:15:35,070 --> 00:15:37,830
كلاين إرمخن

284
00:15:36,990 --> 00:15:38,380
.إنّها مجموعة تهويدات

285
00:15:38,380 --> 00:15:41,720
سمعتُ أنّ تسوموغي-تشان
.كانت تحاول إيجاد أغنية قديمة

286
00:15:41,720 --> 00:15:44,250
.فكّرتُ في أنّ ذلك قد يساعد

287
00:15:44,250 --> 00:15:46,460
!شكرًا لك يا كيوكو-سان

288
00:15:46,990 --> 00:15:49,170
!قد تكون أغنيتك هنا

289
00:15:49,170 --> 00:15:50,630
أتعتقد ذلك؟

290
00:15:53,120 --> 00:15:54,340
...لا يمكنني قراءتها

291
00:15:54,340 --> 00:15:56,260
.يبدو أنّها بالألمانيّة

292
00:15:56,260 --> 00:15:58,820
...لا يمكنني تمييزها حتّى

293
00:15:58,820 --> 00:16:00,430
هلّي بإلقاء نظرة؟

294
00:16:10,930 --> 00:16:11,820
...أليست هذه

295
00:16:11,820 --> 00:16:14,860
!نعم، إنّها الأغنية الّتي أحبّ

296
00:16:14,860 --> 00:16:17,200
!وجدناها أخيرًا يا تسوموغي

297
00:16:20,230 --> 00:16:21,560
...موغيو

298
00:16:21,560 --> 00:16:24,600
.لا فكرة لديّ ما كلماتها

299
00:16:25,460 --> 00:16:28,480
لماذا إذًا لا تفكّرين في كلماتك الخاصّة لها؟

300
00:16:28,480 --> 00:16:29,470
أنا؟

301
00:16:29,470 --> 00:16:30,740
!يبدو ذلك ممتعًا

302
00:16:30,740 --> 00:16:31,700
!لنجرّب ذلك

303
00:16:31,700 --> 00:16:32,460
!حسنًا

304
00:16:32,460 --> 00:16:35,220
.لكنّ ذلك لن يكون سهلاً

305
00:16:35,220 --> 00:16:38,540
ما رأيك بوضع قائمة للأشياء الّتي تحبّينها؟

306
00:16:38,540 --> 00:16:40,670
.ستكون أغنية خاصّة بك هكذا

307
00:16:40,670 --> 00:16:43,060
الأشياء الّتي أحبّها؟

308
00:16:46,500 --> 00:16:48,060
...موغيو-غيو

309
00:16:51,560 --> 00:16:53,990
.شكرًا، شكرًا جزيلاً

310
00:16:53,990 --> 00:16:55,020
.لا شكر على واجب

311
00:16:55,020 --> 00:16:56,850
.أنا مسرورة لأنّي تمكّنت من المساعدة

312
00:16:56,850 --> 00:16:58,260
.زورانا ثانية رجاءً

313
00:16:58,260 --> 00:16:58,910
.أكيد

314
00:16:58,910 --> 00:17:00,570
.في طريق السّلامة

315
00:17:00,570 --> 00:17:02,130
.شكرًا لك

316
00:17:02,130 --> 00:17:06,020
بايري-كُن، آسفة إن كنت
.ستواجه مشاكل في النّوم اللّيلة

317
00:17:06,020 --> 00:17:07,550
ماذا؟ لماذا تقولين ذلك؟

318
00:17:07,550 --> 00:17:13,560
لم نستطع إيجاد أيّ شيء مناسب لحشو
.ملابس تسوموغي، لذا استعملنا وسادتك

319
00:17:14,500 --> 00:17:16,670
...وسادتي

320
00:17:16,670 --> 00:17:19,710
لمست صدر تسوموغي؟

321
00:17:22,860 --> 00:17:24,770
!تمالك نفسك يا تاكاهارا هايري

322
00:17:28,340 --> 00:17:31,650
!تشجّعي يا تسوموغي فيندرز

323
00:17:31,650 --> 00:17:32,420
ماذا؟

324
00:17:33,880 --> 00:17:35,280
!صدر

325
00:17:35,280 --> 00:17:37,300
!ميزوري شيزوكو

326
00:17:43,420 --> 00:17:45,730
!تاكاهارا هايري

327
00:17:45,730 --> 00:17:48,120
!تسوموغي فيندرز

328
00:17:48,120 --> 00:17:50,670
!ميزوري شيزوكو

329
00:17:50,670 --> 00:17:53,080
!تاكاهارا هايري

330
00:17:53,080 --> 00:17:55,990
!تسوموغي فيندرز

331
00:17:55,990 --> 00:17:59,880
!ميزوري شيزوكو

332
00:18:08,780 --> 00:18:09,770
...هذا مخيف

333
00:18:11,110 --> 00:18:13,650
!انظرا، إنّها فتاة الأغنية

334
00:18:15,440 --> 00:18:16,570
...يا أولاد

335
00:18:18,360 --> 00:18:19,280
!تفضّلي

336
00:18:23,530 --> 00:18:26,700
.أتمنّى لو استطاعت شيزوكو المجيء أيضًا

337
00:18:26,700 --> 00:18:28,240
.صـ-صحيح

338
00:18:28,240 --> 00:18:30,630
.عليّ العودة للمنزل باكرًا اليوم

339
00:18:30,630 --> 00:18:32,210
.استمتعا بوقتكما معًا

340
00:18:32,630 --> 00:18:35,090
لماذا ظنّت أنّ عليها منحنا وقتًا وحدنا؟

341
00:18:36,870 --> 00:18:37,550
...عفوًا

342
00:18:40,240 --> 00:18:42,500
أتريد الدّخول؟

343
00:18:43,810 --> 00:18:45,240
.هذا مذهل

344
00:18:45,240 --> 00:18:48,180
هذا هو المشهد الّذي تتحدّثين عنه دائمًا؟

345
00:18:48,620 --> 00:18:49,740
.نعم

346
00:18:49,740 --> 00:18:52,190
.إنّه مشهدي المفضّل

347
00:19:04,520 --> 00:19:05,830
...عفوًا

348
00:19:06,320 --> 00:19:08,600
.أنا جاهزة أخيرًا

349
00:19:08,600 --> 00:19:10,180
.عاطفيًّا

350
00:19:10,840 --> 00:19:12,660
جاهزة عاطفيًّا؟

351
00:19:12,660 --> 00:19:18,300
.إنّني في الحقيقة أحبّك أيضًا يا هايري-سان

352
00:19:19,040 --> 00:19:21,230
.ظننتُ أنّي أخبرتك أنّي أحبّك

353
00:19:21,230 --> 00:19:23,260
.وأنّه ليس من الصّعب ألاّ تُحبَّ أيضًا

354
00:19:23,260 --> 00:19:25,430
.ظننتُ أنّك قصدت كصديقين

355
00:19:25,820 --> 00:19:28,080
.ذلك ما قصدتُ وقتها

356
00:19:28,670 --> 00:19:29,510
...لكن

357
00:19:31,180 --> 00:19:33,400
.أنا أيضًا قصدتُ شيئًا آخر

358
00:19:34,210 --> 00:19:38,120
.منذ أن أخبرتني أنّك ستمنحني صيفك

359
00:19:38,120 --> 00:19:42,320
كيف يمكنني مقاومة حبّك بعد ذلك؟

360
00:19:42,320 --> 00:19:45,690
.لذلك كنتُ أحاول ألاّ أتحمّس كثيرًا

361
00:19:45,690 --> 00:19:49,900
.أردتُ التّصرّف بشكل طبيعيّ أمامك

362
00:19:50,380 --> 00:19:52,850
.لكنّي لم أستطع

363
00:19:52,850 --> 00:19:55,330
.ما زال قلبي يخفق حتّى الآن

364
00:19:55,570 --> 00:19:56,780
...تسوموغي

365
00:19:57,320 --> 00:20:00,920
.لكنّي سأغادر قريبًا

366
00:20:01,620 --> 00:20:06,090
.لذلك فلا معنى أبدًا من قول أنّي أحبّك

367
00:20:11,350 --> 00:20:15,800
.سأبكي كثيرًا عندما سنودّع بعضنا

368
00:20:16,550 --> 00:20:20,200
.لا أريد أن يكون وداعنا هكذا

369
00:20:20,200 --> 00:20:21,940
لماذا تفعل هذا؟

370
00:20:21,940 --> 00:20:22,920
لماذا؟

371
00:20:23,680 --> 00:20:26,870
لماذا تقول ذلك؟

372
00:20:32,560 --> 00:20:37,600
أسيكون وداعنا بلا معنى بالفعل؟

373
00:20:37,600 --> 00:20:38,710
موغيو؟

374
00:20:39,080 --> 00:20:40,690
...حتّى إن انفصلنا

375
00:20:41,420 --> 00:20:43,830
...حتّى إن لم نرَ بعضنا بعد الآن

376
00:20:44,390 --> 00:20:48,970
لا أعتقد أنّ ذلك يعني
.أنّ مشاعرنا فقدت معناها

377
00:20:49,660 --> 00:20:51,760
،لا يهمّ كم سيكون ذلك مؤلمًا

378
00:20:51,760 --> 00:20:53,940
.فلن يغيّر ذلك حقيقة أنّي أحبّك

379
00:20:54,710 --> 00:20:57,480
.أنت من ذكّرني بذلك

380
00:20:58,130 --> 00:20:59,650
أنا؟

381
00:21:00,030 --> 00:21:00,800
.نعم

382
00:21:01,620 --> 00:21:04,740
.لذلك سأقولها بشكل لائق

383
00:21:05,330 --> 00:21:07,820
.أنا أحبّك يا تسوموغي

384
00:21:09,190 --> 00:21:10,950
...هايري-سان

385
00:21:10,950 --> 00:21:12,580
.أنا أيضًا

386
00:21:16,520 --> 00:21:19,790
.أحبّك يا هايري-سان

387
00:21:28,410 --> 00:21:29,640
.لقد عدت يا كيوكو-سان

388
00:21:30,000 --> 00:21:31,400
.مرحبًا بعودتك

389
00:21:33,560 --> 00:21:35,670
.تبدو سعيدًا يا هايري-كُن

390
00:21:35,670 --> 00:21:37,770
فـ-فعلاً؟

391
00:21:44,400 --> 00:21:45,860
.دعيني أساعدك

392
00:21:46,500 --> 00:21:47,700
.أنا آسف

393
00:21:53,560 --> 00:21:54,750
تسوموغي؟

394
00:22:02,630 --> 00:22:09,150
.يومها، اختفت تسوموغي عن أنظارنا