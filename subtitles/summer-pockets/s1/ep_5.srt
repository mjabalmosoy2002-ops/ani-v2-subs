8
00:00:18,990 --> 00:00:21,650
كنت تغنّينها دون معرفة معناها حتّى؟

9
00:00:22,760 --> 00:00:25,670
.العنوان يعني "مع"؟ كم هذا غريب

10
00:00:25,670 --> 00:00:29,540
،بالحديث عن العناوين
هل علينا اختيار اسم لفريقنا؟

11
00:00:29,950 --> 00:00:31,050
اسم لفريقنا؟

12
00:00:31,050 --> 00:00:34,820
!أجل، لديّ واحد سلفًا

13
00:00:35,460 --> 00:00:36,550
!انظروا

14
00:00:36,820 --> 00:00:38,200
ما هذا؟

15
00:00:38,200 --> 00:00:40,390
.إنّه هيغينيكو بالطّبع

16
00:00:40,390 --> 00:00:43,070
!اتُّخذ القرار إذًا

17
00:00:43,070 --> 00:00:46,920
!اسم فريقنا هو هيغينيكو كامومي

18
00:00:46,920 --> 00:00:48,400
!"لا داعي لإضافة "كامومي

19
00:00:48,770 --> 00:00:50,950
!حسنًا، إنّه هيغينيكو فقط

20
00:00:50,950 --> 00:00:53,720
!مرحى

21
00:00:54,760 --> 00:00:56,490
.مـ-مرحى

22
00:00:57,920 --> 00:00:58,620
!كامومي

23
00:01:03,620 --> 00:01:05,000
...هذا ثقيل

24
00:01:10,540 --> 00:01:13,250
.هيّا، انهضي يا كامومي

25
00:01:18,280 --> 00:01:19,760
!كنتَ ستفعل أمورًا بذيئة بي

26
00:01:19,760 --> 00:01:21,330
!بالطّبع لا

27
00:01:37,320 --> 00:01:42,530
جيوب صيف

28
00:02:53,950 --> 00:02:55,590
!الطّعام... موجود

29
00:02:56,360 --> 00:03:00,010
عدّة التّخييم الّتي استعرناها
!من ريويتشي-كُن... موجودة

30
00:03:00,010 --> 00:03:02,450
!انتباه يا تاكاهارا هايري

31
00:03:02,450 --> 00:03:03,450
!حاضر

32
00:03:04,100 --> 00:03:06,030
هل ذراعك أفضل الآن؟

33
00:03:06,400 --> 00:03:07,270
.نعم

34
00:03:07,700 --> 00:03:08,870
.انظري بنفسك

35
00:03:08,870 --> 00:03:09,860
.جيّد

36
00:03:09,860 --> 00:03:13,860
حسنًا، لننطلق إذًا في مغامرتنا
!للعثور على سفينة القراصنة

37
00:03:13,860 --> 00:03:14,710
!أجل

38
00:03:19,000 --> 00:03:21,550
حسنًا، إلى أين نذهب من هنا؟

39
00:03:22,010 --> 00:03:23,620
...دعني أرى

40
00:03:24,590 --> 00:03:25,850
.من هناك

41
00:03:38,560 --> 00:03:39,440
.انظري

42
00:03:46,870 --> 00:03:50,450
.هذه هي نقطة بدايتنا إذًا

43
00:03:50,450 --> 00:03:51,690
.ذلك ما يبدو

44
00:03:58,440 --> 00:04:00,220
أهذه "ويذ"؟

45
00:04:00,220 --> 00:04:02,750
.أذكر سماعها قبل وقت طويل

46
00:04:02,750 --> 00:04:03,760
فعلاً؟

47
00:04:15,920 --> 00:04:18,230
.آسفة لأنّي أسير ببطء

48
00:04:18,230 --> 00:04:21,570
ليس من السّهل جرّ تلك الحقيبة
.على هذه الأرضيّة

49
00:04:21,570 --> 00:04:23,400
.ذلك ليس سيّئًا

50
00:04:23,400 --> 00:04:26,780
وضعتُ لها عجلات مناسبة
.للجبال قبل المغادرة

51
00:04:27,240 --> 00:04:29,110
فـ-فعلاً؟

52
00:04:29,580 --> 00:04:30,580
أتريدين منّي جرّها؟

53
00:04:30,580 --> 00:04:33,080
.لا. لا بأس

54
00:04:33,080 --> 00:04:34,120
.هكذا إذًا

55
00:04:34,990 --> 00:04:35,880
.لنواصل

56
00:04:39,800 --> 00:04:41,050
...في الماضي

57
00:04:42,440 --> 00:04:45,590
.كنتُ أبطئ تقدّم الجميع أيضًا

58
00:04:45,590 --> 00:04:48,050
.لطالما كنت بطيئة في السّير

59
00:04:48,050 --> 00:04:50,670
.هكذا إذًا. لا داعي للقلق حيال ذلك

60
00:04:51,470 --> 00:04:55,160
.بإمكاننا الاسترخاء وتذكّر الماضي أثناء سيرنا

61
00:04:56,180 --> 00:04:57,640
...هايري

62
00:04:57,640 --> 00:04:59,620
.إنّك شخص لطيف بالفعل

63
00:04:59,620 --> 00:05:02,020
.كفّي عن ذلك رجاءً

64
00:05:15,250 --> 00:05:17,330
...إنّها هنا بالفعل

65
00:05:21,460 --> 00:05:28,340
ذُكر في الملاحظة أن نذهب نحو وقت
.الوجبة الخفيفة وهو اتّجاه السّاعة الثّالثة

66
00:05:28,340 --> 00:05:30,430
!أنت بارع فعلاً يا هايري

67
00:05:31,210 --> 00:05:34,520
هل تعتقد أنّ الكهف على هذه السّكّة؟

68
00:05:34,520 --> 00:05:36,560
.آمل ذلك

69
00:05:45,140 --> 00:05:46,670
...الجوّ حارّ

70
00:05:47,360 --> 00:05:48,900
هل أنت بخير؟

71
00:05:49,780 --> 00:05:52,500
أتريدين أن نرتاح في الظّلّ؟

72
00:05:55,970 --> 00:05:57,000
كامومي؟

73
00:05:58,210 --> 00:05:59,330
!كامومي؟

74
00:06:02,200 --> 00:06:03,330
!أتسمعيني؟

75
00:06:04,150 --> 00:06:05,690
!كامومي

76
00:06:08,020 --> 00:06:09,840
...الجوّ حارّ

77
00:06:16,810 --> 00:06:18,600
...إنّه حارّ بالفعل

78
00:06:20,650 --> 00:06:23,590
أخبرني، هل ما زال الطّريق أمامنا طويل؟

79
00:06:23,590 --> 00:06:27,690
كامومي-كُن! هلاّ أسرعتِ قليلاً؟

80
00:06:32,010 --> 00:06:33,580
.أنا آسفة

81
00:06:33,580 --> 00:06:36,380
.أنا أحاول الاستمتاع بالمشاهد

82
00:06:36,380 --> 00:06:38,030
.بإمكانكم أن تسبقوني

83
00:06:39,640 --> 00:06:41,560
أواثقة أنّ تلك لا تبطئ مسيرك؟

84
00:06:41,560 --> 00:06:42,600
.سأجرّها عنك

85
00:06:42,600 --> 00:06:44,440
.لا، سأتولّى أمرها بنفسي

86
00:06:44,440 --> 00:06:47,430
.كفاك جدالاً وأعطني إيّاها

87
00:06:46,420 --> 00:06:47,430
!كلاّ

88
00:06:47,430 --> 00:06:50,010
!أعطني إيّاها بسرعة

89
00:06:48,250 --> 00:06:50,010
!توقّف

90
00:06:53,290 --> 00:06:54,970
...أنت

91
00:06:54,970 --> 00:06:57,100
.سألحق بكم لاحقًا

92
00:06:57,420 --> 00:06:59,960
.لا أريد تأخير الجميع بسببي

93
00:06:59,960 --> 00:07:01,780
.واصلوا بدوني

94
00:07:02,280 --> 00:07:03,100
هايري؟

95
00:07:03,880 --> 00:07:05,980
أتسمعني يا هايري؟

96
00:07:05,980 --> 00:07:07,160
!مرحبًا

97
00:07:07,160 --> 00:07:09,580
!تاكاهارا هايري-كُن

98
00:07:10,460 --> 00:07:11,110
ماذا؟

99
00:07:11,500 --> 00:07:13,080
هل أنت بخير؟

100
00:07:13,080 --> 00:07:15,300
.كنتَ شاردًا بعض الشّيء

101
00:07:16,010 --> 00:07:18,540
مهلاً، أين كنتِ؟

102
00:07:18,540 --> 00:07:22,120
.ماذا؟ كنتُ خلفك مباشرة

103
00:07:24,620 --> 00:07:26,060
.هكذا إذًا

104
00:07:31,870 --> 00:07:34,490
.سرنا لمسافة طويلة

105
00:07:36,280 --> 00:07:38,390
أتظنّ أنّ وجهتنا ما زالت بعيدة؟

106
00:07:38,390 --> 00:07:41,340
...أتظنّين أنّنا قد

107
00:07:43,050 --> 00:07:44,260
!الكهف

108
00:07:46,400 --> 00:07:48,230
!الكهف

109
00:07:48,840 --> 00:07:50,330
!وجدناه

110
00:07:50,330 --> 00:07:51,280
!نعم

111
00:08:03,180 --> 00:08:04,920
...يا للضّجيج

112
00:08:10,010 --> 00:08:11,560
...هذا مؤلم

113
00:08:13,190 --> 00:08:14,930
مهلاً، هل أنت بخير؟

114
00:08:15,350 --> 00:08:17,240
هل تؤلمك ساقك؟

115
00:08:17,240 --> 00:08:19,800
.نعم. لكنّي بخير

116
00:08:19,800 --> 00:08:21,060
.سأتحسّن

117
00:08:21,060 --> 00:08:22,460
.تكذبين

118
00:08:23,540 --> 00:08:26,690
كنت تتألّمين طوال اليوم، صحيح؟

119
00:08:28,150 --> 00:08:30,760
لم تسمحي لي بجرّ الحقيبة

120
00:08:30,760 --> 00:08:33,310
لأنّك كنت تستعملينها للاتّكاء
عليها، صحيح؟

121
00:08:34,830 --> 00:08:35,700
.نعم

122
00:08:36,320 --> 00:08:38,840
لماذا لم تخبريني...؟

123
00:08:39,720 --> 00:08:41,300
.صباح الخير

124
00:08:47,720 --> 00:08:49,090
!ستقوم بأمور بذيئة لي

125
00:08:49,910 --> 00:08:51,380
.طبعًا لا

126
00:08:51,380 --> 00:08:53,380
على أيّ حال، هل ارتحت؟

127
00:08:55,410 --> 00:08:56,720
.نعم، شكرًا لك

128
00:08:57,000 --> 00:08:59,960
عفوًا، أيمكنني طرح سؤال عليك؟

129
00:09:00,650 --> 00:09:03,930
.استطعتُ النّوم، لكنّي تعرّقتُ كثيرًا

130
00:09:03,930 --> 00:09:06,190
.صحيح. وأنا كذلك

131
00:09:06,190 --> 00:09:11,430
.ثمّة ينبوع صغير قريب من هنا

132
00:09:11,430 --> 00:09:12,480
.هكذا إذًا

133
00:09:12,480 --> 00:09:18,480
.لذلك كنت أفكّر في السّباحة فيه قليلاً

134
00:09:32,450 --> 00:09:34,580
!صوت رشّ ماء

135
00:09:34,580 --> 00:09:36,110
.أتساءل ماذا يكون ذلك

136
00:09:36,110 --> 00:09:37,430
...أمزح فحسب

137
00:09:40,910 --> 00:09:41,760
!هل أنت بخير؟

138
00:09:44,030 --> 00:09:46,930
!ثمّة شيء ما هناك! شيء ضخم

139
00:09:48,940 --> 00:09:50,810
.إنّها على حقّ

140
00:09:50,810 --> 00:09:52,440
.إنّهما ضخمين بالفعل

141
00:09:53,390 --> 00:09:55,490
ما الّذي رأيته هناك؟

142
00:09:55,490 --> 00:09:57,280
.كا-كان عند تلك الصّخور

143
00:10:00,400 --> 00:10:04,480
.ربّما يكون هذا هو المكان الّذي يشرب منه

144
00:10:05,160 --> 00:10:08,790
.لا بدّ أنّه تحمّس عندما رآك في مكان شربه

145
00:10:09,040 --> 00:10:10,180
.هكذا إذًا

146
00:10:10,180 --> 00:10:13,000
...تحمّس لأنّه رآني

147
00:10:13,000 --> 00:10:14,480
ماذا؟

148
00:10:14,950 --> 00:10:17,170
!كلاّ، لا أتكلّم عنّي

149
00:10:26,480 --> 00:10:28,520
لم ترَ شيئًا، صحيح؟

150
00:10:29,020 --> 00:10:30,780
أ-أرى ماذا؟

151
00:10:30,780 --> 00:10:32,330
...أعني

152
00:10:32,810 --> 00:10:33,850
.بعض الأشياء

153
00:10:33,850 --> 00:10:35,510
.صـ-صحيح

154
00:10:36,120 --> 00:10:37,230
.لم أر شيئًا

155
00:10:37,230 --> 00:10:38,820
.تـ-تكذب

156
00:10:40,450 --> 00:10:43,450
لقد رأيت! لم يسعني سوى
اختلاس نظرة سريعة، مفهوم؟

157
00:10:45,650 --> 00:10:46,830
ما الّذي رأيت بالضّبط؟

158
00:10:47,390 --> 00:10:48,830
ماذا؟

159
00:10:48,830 --> 00:10:49,350
—صد

160
00:10:49,350 --> 00:10:50,020
!كلاّ

161
00:10:51,160 --> 00:10:54,170
!ها أنت تفعل ذلك ثانية
!تسعل بغرابة من العدم

162
00:10:59,020 --> 00:11:01,010
...أعلم أنّ الوقت تأخّر الآن

163
00:11:01,320 --> 00:11:04,380
لكن أليس دخول كهف محظور أمر خطير؟

164
00:11:04,380 --> 00:11:05,260
.نعم

165
00:11:05,260 --> 00:11:09,120
.لكن ليس من المنطقيّ القلق حيال ذلك الآن

166
00:11:09,120 --> 00:11:10,980
.بل من المنطقيّ جدًّا الشّعور بالقلق

167
00:11:10,980 --> 00:11:13,370
.سأدخل حتّى لو كان عليّ الدّخول وحدي

168
00:11:13,370 --> 00:11:15,880
.يا إلهي. عرفتُ أنّك ستقولين ذلك

169
00:11:17,960 --> 00:11:20,350
...الأمر تمامًا كالسّابق

170
00:11:20,350 --> 00:11:22,660
ماذا؟ ما الّذي تعنيه بـ"كالسّابق"؟

171
00:11:22,660 --> 00:11:24,740
.لا، لا تهتمّي

172
00:11:28,280 --> 00:11:30,120
علينا الذّهاب مباشرة فحسب، صحيح؟

173
00:11:30,520 --> 00:11:31,840
.إن أسعفتني الذّاكرة

174
00:11:31,840 --> 00:11:37,000
ثمّة جزء ضيّق من الكهف
.بعد 300 متر من المدخل

175
00:11:41,220 --> 00:11:42,090
هنا؟

176
00:11:42,090 --> 00:11:43,880
.نعم، هنا

177
00:11:45,160 --> 00:11:48,180
.يصير أوسع بعد هذا

178
00:11:51,370 --> 00:11:52,280
!هنا

179
00:11:52,750 --> 00:11:54,480
!بإمكاننا العبور من هنا

180
00:11:55,680 --> 00:11:57,650
.سأذهب أوّلاً

181
00:11:58,070 --> 00:11:59,650
.حـ-حسنًا

182
00:12:05,390 --> 00:12:07,000
...أيُعقل

183
00:12:07,000 --> 00:12:08,980
أنّي كنتُ هنا من قبل؟

184
00:12:19,380 --> 00:12:20,840
ما الّطريق الّذي سنسلكه؟

185
00:12:21,180 --> 00:12:25,030
.من هنا. ثمّة جدول قريب أمامنا هنا

186
00:12:25,030 --> 00:12:26,100
.مفهوم

187
00:12:31,560 --> 00:12:33,770
هل ساقك بخير؟

188
00:12:33,770 --> 00:12:35,310
ماذا؟ لماذا؟

189
00:12:35,310 --> 00:12:38,190
.كنتُ... أتساءل فحسب

190
00:12:38,710 --> 00:12:43,440
ألا تستعملين تلك الحقيبة
لأنّ ساقك مصابة أو ما شابه؟

191
00:12:44,390 --> 00:12:45,830
لـ-لم تسأل؟

192
00:12:45,830 --> 00:12:48,600
...أنا بأفضل حال

193
00:12:48,600 --> 00:12:53,090
.ما كنتُ لآتي إلى هنا إن كانت ساقي مصابة

194
00:12:53,090 --> 00:12:54,700
.هكذا إذًا

195
00:12:54,700 --> 00:12:57,080
لماذا إذًا تجرّينها معك؟

196
00:12:57,080 --> 00:12:58,330
هذه؟

197
00:12:59,310 --> 00:13:01,630
!لن أخبرك

198
00:13:01,630 --> 00:13:03,620
.لا، أريد أن أعرف

199
00:13:04,260 --> 00:13:06,680
.نحن في مغامرة معًا

200
00:13:06,680 --> 00:13:08,680
.والمغامرات قد تكون خطيرة

201
00:13:09,170 --> 00:13:12,540
ستضعين حياة الجميع في خطر
.بإبقائك للأسرار هكذا

202
00:13:13,430 --> 00:13:18,200
مع أنّه لا يوجد أيّ أحد آخر
.سوانا أنا وأنت

203
00:13:18,200 --> 00:13:19,940
...عـ-عفوًا

204
00:13:20,190 --> 00:13:21,720
...في الحقيقة

205
00:13:21,720 --> 00:13:27,880
،تؤلمني ساقي أحيانًا
.خاصّة في اللّيالي والصّباحات الباردة

206
00:13:27,880 --> 00:13:29,320
.فهمت

207
00:13:29,320 --> 00:13:31,780
.آسفة لأنّي لم أخبرك من قبل

208
00:13:34,200 --> 00:13:36,330
.آسفة لأنّي لم أخبرك من قبل

209
00:13:36,790 --> 00:13:38,400
.قلتِ أنّك دخلت المستشفى

210
00:13:38,400 --> 00:13:39,790
أكنت مريضة؟

211
00:13:39,790 --> 00:13:40,580
.نعم

212
00:13:40,990 --> 00:13:44,510
،في معظم الأحيان
.يكون السّير صعبًا فحسب

213
00:13:44,510 --> 00:13:50,590
،لكن في أحيان أخرى
.يصير التّنفّس صعبًا وحتّى الحركة

214
00:13:51,050 --> 00:13:52,750
!لا بدّ أنّك تمازحينني

215
00:13:52,750 --> 00:13:53,600
...لماذا

216
00:13:53,970 --> 00:13:56,140
...لماذا لم تقولي

217
00:13:56,900 --> 00:13:58,590
.أنا آسفة

218
00:13:58,590 --> 00:14:02,930
،كنتُ في حالة جيّدة
.لذلك ظننتُني سأكون بخير

219
00:14:02,930 --> 00:14:04,760
.سنعود للمنزل في الصّباح

220
00:14:04,760 --> 00:14:05,730
!كـ-كلاّ

221
00:14:05,730 --> 00:14:07,470
!لا تتغابي

222
00:14:07,470 --> 00:14:09,780
أتنوين الذّهاب إلى الكهف هكذا بالفعل؟

223
00:14:10,180 --> 00:14:11,310
...رجاءً

224
00:14:12,810 --> 00:14:16,990
.رجاءً، لا تقل لي أنّنا سنعود أدراجنا

225
00:14:18,090 --> 00:14:19,790
.عرفتُ أنّك ستقولين ذلك

226
00:14:20,920 --> 00:14:23,480
.لكنّنا قطعنا شوطًا كبيرًا سلفًا

227
00:14:23,480 --> 00:14:25,340
.لا فائدة من العودة الآن

228
00:14:27,190 --> 00:14:28,420
.شكرًا لك

229
00:14:29,090 --> 00:14:30,770
.لنأخذ استراحة سريعة

230
00:14:30,770 --> 00:14:31,590
.حسنًا

231
00:14:32,730 --> 00:14:33,710
...أخبرني

232
00:14:34,860 --> 00:14:37,840
لماذا أتيت إلى هذه الجزيرة يا هايري؟

233
00:14:37,840 --> 00:14:39,440
ما سبب سؤالك عن ذلك؟

234
00:14:39,440 --> 00:14:43,150
.لأنّي أشعر أنّك كنت تستجوبني طوال الوقت

235
00:14:43,150 --> 00:14:44,350
.لم يكن ذلك عادلاً

236
00:14:44,350 --> 00:14:45,520
.يا إلهي

237
00:14:45,960 --> 00:14:48,220
.أخبرتك أنّي أتيت لأُشفى

238
00:14:48,220 --> 00:14:50,520
إذًا فأنت مصاب؟

239
00:14:50,520 --> 00:14:51,690
.أظنّ ذلك

240
00:14:51,690 --> 00:14:52,490
ما الّذي حدث؟

241
00:14:52,490 --> 00:14:56,800
مهلاً، لماذا عليّ الحديث
في مسائل شخصيّة؟

242
00:14:56,800 --> 00:14:58,280
.الفضول يساورني

243
00:14:58,280 --> 00:14:59,740
!ممنوع الاحتفاظ بالأسرار

244
00:14:59,740 --> 00:15:01,430
...سُحقًا لهذا

245
00:15:03,890 --> 00:15:05,790
.أفسدتُ أمرًا متعلّقًا بالفريق

246
00:15:21,600 --> 00:15:23,380
أفسدت ماذا؟

247
00:15:23,380 --> 00:15:25,770
.باختصار، خذلت بعض النّاس

248
00:15:26,040 --> 00:15:28,000
لذلك هربت؟

249
00:15:28,000 --> 00:15:30,210
هربت؟

250
00:15:30,710 --> 00:15:32,660
.نعم، بإمكانك قول ذلك

251
00:15:33,160 --> 00:15:35,000
.فهمت

252
00:15:35,000 --> 00:15:37,880
...إذًا فقد خذلتَ بعض النّاس

253
00:15:37,880 --> 00:15:41,800
رغم ذلك، من الرّائع أنّهم كانوا
.يعتمدون عليك في المقام الأوّل

254
00:15:41,800 --> 00:15:43,040
.أعتقد ذلك

255
00:15:45,240 --> 00:15:48,510
من المؤلم حقًّا أن تخذل النّاس
.حين يعلّقون آمالاً كثيرة عليك

256
00:15:48,510 --> 00:15:49,840
.معك حقّ

257
00:15:49,840 --> 00:15:53,700
الشّعور بالخذلان يؤلم أيضًا، صحيح؟

258
00:15:53,700 --> 00:15:55,050
!لا تقولي هذا

259
00:15:55,050 --> 00:15:57,050
أما كان بإمكانك أن تكون أكثر تعاطفًا قليلاً؟

260
00:15:57,400 --> 00:15:59,840
.حسنًا، أنا آسفة. لا تعرني اهتمامًا

261
00:15:59,840 --> 00:16:03,760
.كنتُ أتحدّث عن أمر آخر، وليس عنك أنت

262
00:16:04,610 --> 00:16:07,610
.ثمّة أمر أتطلّع إليه بشدّة

263
00:16:07,610 --> 00:16:16,280
لم أكن أظنّني كذلك، لكن كلما اقتربت
.من الهدف، أدركت كم أنا متحمّسة

264
00:16:16,280 --> 00:16:17,260
متحمّسة لماذا؟

265
00:16:17,260 --> 00:16:18,950
.للقاء أصدقائي

266
00:16:19,930 --> 00:16:23,580
يُفترض أن تكون سفينة القراصنة
،وراء هذا الكهف

267
00:16:23,580 --> 00:16:27,130
ويُفترض أن يكون أحدهم
.قد وصل إليها بالفعل

268
00:16:27,130 --> 00:16:30,840
.يُفترض أن يكونوا بانتظاري

269
00:16:31,300 --> 00:16:35,640
.ولكن بصراحة، لا أظنّ أنّ هنالك أيّ أحد

270
00:16:36,430 --> 00:16:39,900
.لطالما كنت ضعيفة البنية

271
00:16:39,900 --> 00:16:42,490
.قضيتُ الكثير من الوقت في المستشفى

272
00:16:42,490 --> 00:16:46,100
ليس لديّ الكثير من الذّكريات
.عن اللّعب في العطلة الصّيفيّة

273
00:16:46,100 --> 00:16:49,920
.لذلك السّبب هذا مهمّ جدًّا بالنّسبة لي

274
00:16:50,680 --> 00:16:54,020
لكنّي أعرف أنّ الأمر لم يكن كذلك
.بالنّسبة لأيّ أحد آخر

275
00:16:54,550 --> 00:16:58,930
كانت مجرّد واحدة من عدّة
.ذكريات من ذلك الصّيف

276
00:16:58,930 --> 00:17:01,510
...لقد دُفنتْ ونُسيتْ

277
00:17:02,060 --> 00:17:06,120
.لكن بالنّسبة لي، إنّها كنزي الوحيد

278
00:17:06,810 --> 00:17:09,380
.لذلك السّبب أنا مهوسة بهذا

279
00:17:10,950 --> 00:17:12,220
...والآن

280
00:17:13,000 --> 00:17:14,970
أتريد المواصلة؟

281
00:17:21,950 --> 00:17:23,050
.مهلاً لحظة

282
00:17:23,810 --> 00:17:24,890
.مصباحك

283
00:17:26,120 --> 00:17:28,010
.لا-لا بأس

284
00:17:28,010 --> 00:17:30,120
.لديّ بطّاريّات إضافيّة

285
00:17:31,920 --> 00:17:32,690
!كامومي

286
00:17:35,150 --> 00:17:36,420
!كامومي

287
00:17:48,720 --> 00:17:49,500
!هايري

288
00:17:52,270 --> 00:17:53,250
!هايري

289
00:17:57,550 --> 00:17:58,900
!هايري

290
00:17:58,900 --> 00:18:00,330
!رجاءً يا هايري

291
00:18:00,960 --> 00:18:02,040
.لا بأس

292
00:18:02,040 --> 00:18:04,790
.أنا واثقة أنّنا نوشك على الوصول لهدفنا

293
00:18:14,530 --> 00:18:18,530
،عندما أكون معكم

294
00:18:18,530 --> 00:18:22,030
!بإمكاني الذّهاب إلى أيّ مكان

295
00:18:22,760 --> 00:18:29,320
!أو لا بأس أيضًا بعدم الذّهاب إلى أيّ مكان

296
00:18:30,920 --> 00:18:34,380
،عندما أكون معكم

297
00:18:34,380 --> 00:18:38,720
!بإمكاني الذّهاب إلى أيّ مكان

298
00:18:38,720 --> 00:18:45,580
!أو لا بأس أيضًا بعدم الذّهاب

299
00:18:46,310 --> 00:18:49,940
—بإمكاني الذّهاب لأيّ مكان

300
00:18:49,940 --> 00:18:50,890
!إنّه ضوء

301
00:18:50,890 --> 00:18:52,120
!إنّه المخرج

302
00:18:52,120 --> 00:18:53,160
!لقد خرجنا

303
00:18:53,160 --> 00:18:54,650
.بإمكاني شمّ البحر

304
00:18:55,320 --> 00:18:56,430
.هيّا بنا

305
00:18:56,430 --> 00:18:57,050
.نعم

306
00:19:08,690 --> 00:19:10,660
!هايري! هل أنت بخير؟

307
00:19:11,540 --> 00:19:12,410
.نعم

308
00:19:12,850 --> 00:19:13,830
.أنا بخير

309
00:19:13,830 --> 00:19:15,940
.حمدًا على هذا

310
00:19:15,940 --> 00:19:17,710
.من المستحيل أن أموت غرقًا

311
00:19:18,200 --> 00:19:20,070
.أنا في فريق السّباحة

312
00:19:21,720 --> 00:19:23,030
.لم تخبرني بذلك من قبل

313
00:19:23,030 --> 00:19:24,550
.هذا صحيح

314
00:19:24,550 --> 00:19:28,970
.ما يعني أنّك خذلت فريق السّباحة

315
00:19:28,970 --> 00:19:30,890
.لم تكوني بحاجة لذكر ذلك الآن

316
00:19:30,890 --> 00:19:32,470
.آ-آسفة

317
00:19:32,470 --> 00:19:33,560
...وأيضًا

318
00:19:33,560 --> 00:19:35,320
...آسف إن فهمت الأمر بشكل خاطئ

319
00:19:36,280 --> 00:19:40,590
لكن أشعر وكأنّي حصلتُ على قبلة
.قبل أن أستيقظ

320
00:19:42,780 --> 00:19:46,200
أكنتِ تقدّمين لي تنفّسًا اصطناعيًّا؟

321
00:19:46,820 --> 00:19:49,560
!كا-كان ذلك من الإسعافات الأوّليّة

322
00:19:49,560 --> 00:19:51,500
!لا حاجة لتكوني خجلة بشأن ذلك

323
00:19:51,500 --> 00:19:52,600
!صحيح

324
00:19:52,600 --> 00:19:54,740
!كانت إسعافات أوّليّة

325
00:19:57,210 --> 00:19:58,500
!هايري، انظر

326
00:19:58,970 --> 00:20:00,900
!ثمّة ضوء هناك

327
00:20:03,720 --> 00:20:05,390
هل تؤلمك ساقك؟

328
00:20:05,390 --> 00:20:06,470
.آسفة

329
00:20:06,470 --> 00:20:07,850
أين الحقيبة؟

330
00:20:08,400 --> 00:20:11,220
...وقعت في الماء و

331
00:20:11,640 --> 00:20:13,140
.هكذا إذًا

332
00:20:14,440 --> 00:20:15,720
أتحتاجين الاتّكاء على كتفي؟

333
00:20:16,210 --> 00:20:17,400
.سأكون بخير

334
00:20:17,760 --> 00:20:20,400
.نكاد نصل. أريد الذّهاب بدون مساعدة

335
00:20:22,130 --> 00:20:23,240
.حسنًا

336
00:20:23,640 --> 00:20:26,070
.لكن لا داعي للعجلة

337
00:20:26,070 --> 00:20:26,990
.حسنًا

338
00:20:28,910 --> 00:20:30,760
...بشأن ما كنت تقولينه

339
00:20:32,290 --> 00:20:34,820
.بشأن نسيان الجميع لتلك الذّكريات

340
00:20:35,450 --> 00:20:38,440
.أظنّك تمليكن فكرة فاخرة عن عطلة الصّيف

341
00:20:39,610 --> 00:20:44,190
ليس من السّهل إنشاء ذكريات
.جيّدة في الصّيف كما تعتقدين

342
00:20:44,190 --> 00:20:48,810
أشياء مثل مغامرة عبر الجزيرة
...للعثور على سفينة قراصنة

343
00:20:50,020 --> 00:20:54,890
.لم أعد طفلاً، لكن حتّى أنا متحمّس الآن

344
00:20:55,320 --> 00:20:56,500
.هكذا إذًا

345
00:20:57,340 --> 00:20:59,900
هل ستتذكّر كلّ شيء حدث اليوم يا هايري؟

346
00:21:00,920 --> 00:21:02,440
.أظنّني سأتذكّر

347
00:21:02,990 --> 00:21:04,900
.سأتذكّر للأبد