1
00:00:06,400 --> 00:00:08,230
...أومي-تشان

2
00:00:12,390 --> 00:00:13,770
.حان الوقت

3
00:00:14,860 --> 00:00:19,900
.لا أعتقد أنّه قد ظلّ لي أيّ شيء لأقوم به

4
00:00:21,330 --> 00:00:25,250
.استطعتُ مساعدتك يا أمّي

5
00:00:25,700 --> 00:00:30,230
وتسنّت لي فرصة رؤيتك ثانية
.وقول ما احتجتُ لقوله

6
00:00:30,930 --> 00:00:34,670
.تسنّت لي فرصة سماعك تناديني باسمي

7
00:00:36,680 --> 00:00:42,520
.أنا فعلاً... في غاية السّعادة

8
00:00:47,920 --> 00:00:48,870
ماذا؟

9
00:00:49,330 --> 00:00:52,650
...أعتقد أنّ التّعب ينال منّي

10
00:00:52,650 --> 00:00:54,080
!أومي-تشان

11
00:01:00,700 --> 00:01:02,900
.أنا أرتاح على حضن أمّي

12
00:01:03,670 --> 00:01:05,460
...لم أفعل ذلك منذ مدّة

13
00:01:05,760 --> 00:01:12,760
أومي-تشان، أردتك أن تعثري
.على السّعادة فحسب

14
00:01:13,570 --> 00:01:15,880
.هذا كلّ شيء

15
00:01:16,620 --> 00:01:20,220
.لأنّني... أمّك يا أومي-تشان

16
00:01:20,660 --> 00:01:21,460
.نعم

17
00:01:21,930 --> 00:01:23,790
.أنت أمّي

18
00:01:24,360 --> 00:01:27,960
.وأنا ابنتك

19
00:01:28,520 --> 00:01:32,480
.لهذا السّبب وصلتُ لهذه المرحلة

20
00:01:32,790 --> 00:01:34,030
.معك حقّ

21
00:01:34,640 --> 00:01:38,550
.أبليتِ حسنًا يا أومي-تشان

22
00:01:40,330 --> 00:01:43,310
.أبليت حسنًا بالفعل

23
00:01:44,440 --> 00:01:49,500
،فعلتِ الكثير من أجلي
.لكنّي ما زلت عاجزة عن شكرك

24
00:01:50,070 --> 00:01:52,820
.أريد أن أظلّ أمّك

25
00:01:53,660 --> 00:01:56,390
.وأريدك أن تكوني ابنتي الصّغيرة

26
00:01:57,960 --> 00:01:59,510
...أمّي

27
00:01:59,510 --> 00:02:01,050
!لا أريد هذا

28
00:02:01,050 --> 00:02:02,960
.لا تذهبي لأيّ مكان

29
00:02:02,960 --> 00:02:05,270
!أريدك أن تظلّي معي

30
00:02:05,270 --> 00:02:10,510
!ما زال هنالك الكثير أريد القيام به معك

31
00:02:10,510 --> 00:02:14,520
،الطّبخ معًا، والتّسوّق معًا

32
00:02:14,520 --> 00:02:18,030
،والسّفر والتقاط الصّور

33
00:02:18,030 --> 00:02:20,990
،وصنع الكثير من الذّكريات

34
00:02:20,990 --> 00:02:23,530
،وتذكّرها والانغماس فيها

35
00:02:24,160 --> 00:02:27,300
...وقضاء فصول الصّيف معًا

36
00:02:27,910 --> 00:02:32,930
.لا أريد قضاء صيف بدونك

37
00:02:33,380 --> 00:02:35,080
.وليس الصّيف فحسب

38
00:02:35,080 --> 00:02:39,610
.أريد أن أكون معك طوال السّنة

39
00:02:41,800 --> 00:02:45,950
.تبدين كطفلة أكثر منّي

40
00:02:47,010 --> 00:02:48,410
...هذا مؤلم

41
00:02:49,460 --> 00:02:52,160
.كنتُ سأتحمّل فحسب

42
00:02:53,000 --> 00:02:57,070
.لكنّي أريد البقاء معك أيضًا

43
00:02:57,380 --> 00:02:59,910
.أريد مناداتك بـ"أمّي" أكثر وأكثر

44
00:03:00,570 --> 00:03:04,270
.أريد أن تعلّميني الطّبخ أكثر

45
00:03:05,010 --> 00:03:06,950
.أريد اللّعب معك أكثر

46
00:03:07,460 --> 00:03:13,210
.ما زلتُ أريد قضاء وقت أكثر معك

47
00:03:13,600 --> 00:03:18,040
...أمّي... أمّي... أمّي

48
00:03:18,040 --> 00:03:19,710
.أنا أحبّك

49
00:03:22,160 --> 00:03:23,720
!أومي-تشان

50
00:03:24,150 --> 00:03:25,550
...أومي-تشان

51
00:03:28,700 --> 00:03:34,230
أمّي، هل يمكنك القيام بأمر ما لأجلي؟

52
00:03:34,230 --> 00:03:35,640
ما هو؟

53
00:03:35,640 --> 00:03:37,270
.يمكنك أن تطلبي أيّ شيء منّي

54
00:03:37,720 --> 00:03:41,240
.أريدك أن تغنّين لي

55
00:03:41,950 --> 00:03:45,740
.ما زلتُ أذكر صوتك

56
00:03:46,060 --> 00:03:50,060
.سمعتُه قبل ذلك الصّيف بكثير

57
00:03:50,610 --> 00:03:53,750
.كنتُ أستمع طوال الوقت

58
00:03:53,750 --> 00:03:57,500
...كنتُ محبوبة جدًّا

59
00:03:58,400 --> 00:04:02,010
.كان ذلك دافئًا وسعيدًا

60
00:04:02,980 --> 00:04:06,680
.أريد العودة إلى هناك مرّة أخرى

61
00:04:07,240 --> 00:04:11,820
.أريد أن أغطّ في النّوم بين ذراعيك

62
00:04:16,730 --> 00:04:17,820
...لا

63
00:04:18,260 --> 00:04:19,410
.أرجوك

64
00:04:20,780 --> 00:04:23,140
.لا تقولي ذلك رجاءً

65
00:04:23,140 --> 00:04:27,520
!سترحلين إن نمتِ

66
00:04:30,350 --> 00:04:33,790
.لا أعتقد أنّ بإمكاني البقاء

67
00:04:33,790 --> 00:04:35,100
...أومي-تشان

68
00:04:36,360 --> 00:04:37,940
.أمّي

69
00:04:39,270 --> 00:04:42,590
...أمّي

70
00:04:45,720 --> 00:04:47,870
.لا بأس

71
00:04:47,870 --> 00:04:50,560
.أنا هنا معك

72
00:05:23,590 --> 00:05:27,720
.أريد أن أنام بين ذراعيها هكذا

73
00:05:30,170 --> 00:05:35,810
،سابقًا عندما كنت لا أعرف أمّي
...في اللّيالي الّتي كان يعمل فيها أبي

74
00:05:36,600 --> 00:05:41,980
.كنتُ أخلد للنّوم وحدي وأتذكّر

75
00:05:43,000 --> 00:05:51,600
،وحتّى قبل حصولي على أوّل ذكرياتي
.حملني أحد ما بلطف بين ذراعيه

76
00:05:54,860 --> 00:06:03,940
رأيتُ بعينيّ اللّتان لم أكن أستطيع حتّى
.فتحهما بالكامل، خيال شخص ما

77
00:06:04,840 --> 00:06:11,130
.أذكر ذلك الشّعور، ذلك الدّفء

78
00:06:12,130 --> 00:06:18,140
...نائمة بارتياح تحت سماء مشرقة

79
00:06:18,630 --> 00:06:20,660
.ما زلتُ أتذكّر الأمر بشكل مبهم

80
00:06:21,330 --> 00:06:28,360
.في ذلك الضّوء الباهر، حملتني بابتسامة

81
00:06:29,240 --> 00:06:32,650
.وكانت تغنّي لي

82
00:06:33,760 --> 00:06:41,700
سافرتُ خلال العديد من فصول
...الصّيف وأدركتُ أخيرًا

83
00:06:50,280 --> 00:06:52,060
.فهمتُ أخيرًا

84
00:06:53,320 --> 00:06:56,800
.هذا هو معنى الفقدان

85
00:06:57,870 --> 00:07:00,060
.أوشك على فقدان الماضي

86
00:07:00,820 --> 00:07:03,660
.أنا أفقد وجودي

87
00:07:04,710 --> 00:07:07,880
.سيكون كلّ شيء كما لو أنّه لم يحدث أبدًا

88
00:07:08,550 --> 00:07:10,580
.لن أولد أبدًا

89
00:07:11,850 --> 00:07:13,710
.لن أراهما ثانية

90
00:07:14,470 --> 00:07:18,200
.لا أبي ولا أمّي

91
00:07:20,910 --> 00:07:23,190
.لكن لا بأس

92
00:07:23,960 --> 00:07:28,800
استطعتُ القيام بما أردتُ القيام به
.في كلّ الأحوال

93
00:07:29,370 --> 00:07:35,800
استطعتُ رؤية أمّي وقضاء الكثير
.من فصول الصّيف الممتعة معها

94
00:07:36,400 --> 00:07:40,900
.وفي النّهاية، كنّا معًا

95
00:07:44,540 --> 00:07:46,020
...أمّي

96
00:07:46,760 --> 00:07:47,860
.مع السّلامة

97
00:07:53,660 --> 00:07:55,620
...أومي-تشان

98
00:08:10,030 --> 00:08:14,980
.عشتِ الكثيرَ الكثير من فصول الصّيف الممتعة

99
00:08:16,040 --> 00:08:19,070
.عشتِ عطلاً صيفيّة للعمر بأكمله

100
00:08:19,840 --> 00:08:24,660
.وأخبرتني عنها كلّها

101
00:08:25,670 --> 00:08:31,820
.أخبرتني كم أنّ ذكريات الصّيف جميلة

102
00:08:33,260 --> 00:08:39,150
لن أستعيد ذلك الصّيف أبدًا، صحيح؟

103
00:08:39,760 --> 00:08:43,930
لكن لا يفترض بي أن أرغب في ذلك، صحيح؟

104
00:08:45,130 --> 00:08:46,340
.فهمت

105
00:08:46,990 --> 00:08:52,270
لا يجدر بي البقاء عالقة في الماضي، صحيح؟

106
00:08:54,200 --> 00:09:02,180
.ومع ذلك... ومع ذلك... أنا أتذكّرها

107
00:09:02,760 --> 00:09:10,700
.كانت تلك أفضل عطلة صيف أعيشها

108
00:09:12,190 --> 00:09:17,200
.جعلتني أمًّا يا أومي-تشان

109
00:09:22,840 --> 00:09:26,260
.أتذكّر كلّ شيء

110
00:09:27,700 --> 00:09:29,480
.لا أريد نسيان أيّ من ذلك

111
00:09:31,710 --> 00:09:35,380
!أومي-تشان

112
00:09:43,260 --> 00:09:47,940
.منذ زمن بعيد، كان العالم بلا ألوان

113
00:09:47,940 --> 00:09:51,990
.وُجدت فيه فراشة بأجنحة جميلة

114
00:09:52,590 --> 00:09:56,490
.كانت أجنحتها تحتوي على كلّ الألوان

115
00:09:56,760 --> 00:10:00,330
،سافرت الفراشة في العالم بأسره

116
00:10:00,880 --> 00:10:05,300
تتشارك ألوان أجنحتها الجميلة

117
00:10:05,300 --> 00:10:08,120
.مع كلّ من تلتقي به في طريقها

118
00:10:08,490 --> 00:10:14,100
.ومع الوقت، صارت الفراشة الجميلة بيضاء

119
00:10:15,050 --> 00:10:18,380
.ومع ذلك، واصلت الفراشة رحلتها

120
00:10:18,720 --> 00:10:22,620
.واصلت الطّيران حتّى بعد أن تمزّقت أجنحتها

121
00:10:23,190 --> 00:10:27,770
ما عاد أحد يتعرّف عليها
،على أنّها الفراشة الجميلة

122
00:10:29,110 --> 00:10:31,850
.لكنّ العالم كان مليئًا بالألوان

123
00:10:31,850 --> 00:10:35,020
.صار العالم الآن جميلاً

124
00:10:35,400 --> 00:10:41,470
،عندما عادت إلى موطنها
.ارتاحت الفراشة فوق زهرة

125
00:10:41,470 --> 00:10:47,200
.كانت الفراشة سعيدة بلقائها للكثيرين

126
00:10:48,120 --> 00:10:51,940
.وهكذا غطّت في نوم صامت

127
00:10:51,940 --> 00:10:56,020
.وصار الحزن الّذي شعر به الجميع مطرًا

128
00:11:00,400 --> 00:11:02,680
.ماذا؟ ثمّة المزيد

129
00:11:02,680 --> 00:11:07,810
هذه هي نهاية القصّة بناءً
.على ما أخبرتنا به أومي

130
00:11:08,470 --> 00:11:13,560
،لكنّ نهايتها كان حزينة نوعًا ما
.لذلك حاولت إضافة المزيد لها

131
00:11:13,560 --> 00:11:14,950
.فهمت

132
00:11:15,570 --> 00:11:17,840
.نعم، أعجبني هذا

133
00:11:23,790 --> 00:11:28,410
بعد انقضاء المطر، اتّجهت الفراشة
.إلى قوس قزح الكبير

134
00:11:28,960 --> 00:11:33,560
كان جسرًا كبيرًا جميلاً يمتدّ
.على العالم بأكمله

135
00:11:34,200 --> 00:11:38,260
."نظر الجميع للأعلى وقالوا، "شكرًا لك

136
00:11:52,640 --> 00:11:57,320
سنصل الآن إلى ميناء الصّيد
.توريشيروجيما، جزيرة توريشيروجيما

137
00:11:57,320 --> 00:12:01,900
.قد نختبر اصطدامًا قويًّا عند الرّسو

138
00:12:03,310 --> 00:12:05,350
"أتريد المجيء إلى جزيرة توريشيروجيما؟"

139
00:12:06,120 --> 00:12:09,530
اقرأ إذًا الرّسالة الّتي تلقّيتُها
.قُبيل العطلة الصّيفيّة

140
00:12:10,200 --> 00:12:14,890
.كانت من أخت أمّي الّتي لم ألتقها من قبل

141
00:12:15,700 --> 00:12:19,010
.كانت هنالك صورة في الظّرف

142
00:12:19,010 --> 00:12:20,500
.كانت تبعث على الحنين بشكل غريب

143
00:12:21,650 --> 00:12:24,480
ولذلك السّبب انتهى بي
.المطاف بزيارة الجزيرة

144
00:12:26,240 --> 00:12:28,300
تنظّمين أغراض جدّتي؟

145
00:12:28,300 --> 00:12:29,460
.هذا صحيح

146
00:12:29,460 --> 00:12:32,980
كانت كلّ هذه أغراض تحتفظ
.بها من أجل أشخاص آخرين

147
00:12:32,980 --> 00:12:34,760
كانت تخزّن كلّ هذا؟

148
00:12:35,640 --> 00:12:37,320
ولسنا بحاجة لإعادتها؟

149
00:12:37,320 --> 00:12:41,400
معظم أصحاب هذه الأغراض
.ماتوا سلفًا أو لم يردّوا

150
00:12:41,400 --> 00:12:45,650
أتساءل لماذا تركوا أغراضهم
.معها من الأساس

151
00:12:47,010 --> 00:12:49,830
...هل سبق لك أن مررت بتجربة

152
00:12:50,830 --> 00:12:55,860
بحيث عندما كنتَ طفلاً، كنتَ
،تلعب في الخارج ووجدتَ شيئًا ما

153
00:12:56,520 --> 00:13:00,370
.ثمّ وضعته في جيبك
هل سبق وفعلت ذلك؟

154
00:13:02,500 --> 00:13:04,840
.نعم. قبل مدّة طويلة

155
00:13:05,190 --> 00:13:06,240
أولم نفعل جميعًا؟

156
00:13:09,090 --> 00:13:12,670
،تغلق السّحّاب، وتحرص على ألاّ يقع

157
00:13:12,670 --> 00:13:15,100
.وتخبّؤه بعيدًا بحذر

158
00:13:15,580 --> 00:13:17,900
.ومع ذلك، يختفي قبل أن تدرك حتّى

159
00:13:19,900 --> 00:13:23,290
،ولكن ذات يوم، يخطر الأمر على البال

160
00:13:23,290 --> 00:13:25,370
وتبحث داخل جيبك

161
00:13:25,370 --> 00:13:28,030
.وتجد أنّه ما زالت هناك قطعة منه

162
00:13:28,030 --> 00:13:29,520
قطعة منه؟

163
00:13:29,520 --> 00:13:30,360
.نعم

164
00:13:30,870 --> 00:13:32,740
.قطعة صغيرة جدًّا فحسب

165
00:13:33,410 --> 00:13:36,660
.ولكن وقتها، لا يمكنك تذكّر ما هو

166
00:13:37,900 --> 00:13:40,920
.أعتقد أنّ هذا المكان يشبه ذلك

167
00:13:41,900 --> 00:13:45,840
مكان لتخزين أشياء كانت
...مهمّة لشخص ما

168
00:13:45,840 --> 00:13:48,450
.والّتي تمّ نسيانها بعد ذلك

169
00:13:49,120 --> 00:13:52,050
إذًا فهذا المكان أشبه بجيب، صحيح؟

170
00:13:53,070 --> 00:13:53,820
.نعم

171
00:13:55,460 --> 00:13:59,770
.ثمّة مطعم على مسافة 10 دقائق من الميناء

172
00:13:59,770 --> 00:14:02,530
إنّه المكان الوحيد الّذي يظلّ
.مفتوحًا في هذا الوقت

173
00:14:06,650 --> 00:14:07,930
!ماذا؟

174
00:14:13,850 --> 00:14:15,250
.ما باليد حيلة

175
00:14:15,250 --> 00:14:17,910
أعتقد أنّي سأتجوّل قليلاً
.في الجزيرة قبل العودة للمنزل

176
00:14:21,590 --> 00:14:22,330
ماذا؟

177
00:14:23,610 --> 00:14:24,960
.هذا غير معقول

178
00:14:30,490 --> 00:14:32,680
...الجوّ حارّ جدًّا

179
00:15:05,310 --> 00:15:06,680
ما الخطب؟

180
00:15:08,590 --> 00:15:09,950
.لا شيء

181
00:15:09,950 --> 00:15:10,840
...ذلك الفتى

182
00:15:11,740 --> 00:15:14,220
.صحيح، لم أره هنا من قبل

183
00:15:14,630 --> 00:15:16,280
.لا بدّ أنّه سائح

184
00:15:16,750 --> 00:15:17,890
.فهمت

185
00:15:19,790 --> 00:15:22,170
ما الخطب؟ هل تعرفينه؟

186
00:15:22,730 --> 00:15:24,000
.لا

187
00:15:24,000 --> 00:15:25,480
.لا أعرفه

188
00:15:25,800 --> 00:15:28,920
.على أيّ حال، علينا الذّهاب لرؤية أي

189
00:15:28,920 --> 00:15:30,840
.ستغضب إن تأخّرنا

190
00:15:30,840 --> 00:15:33,850
.صحيح، معك حقّ. هيّا بنا

191
00:15:46,270 --> 00:15:47,880
.دعيني أساعدك ابتداءً من اليوم

192
00:15:49,190 --> 00:15:51,130
.أنا هنا لهذا السّبب قبل كلّ شيء

193
00:15:51,130 --> 00:15:52,920
.كما أنّه ليس لديّ ما أقوم به أيضًا

194
00:15:52,920 --> 00:15:54,260
.أخبريني بأيّ عمل يمكنني القيام به

195
00:15:56,920 --> 00:15:58,510
.شكرًا لك

196
00:15:59,320 --> 00:16:01,270
بماذا أبدأ؟

197
00:16:02,270 --> 00:16:07,170
إنّنا نضع ملصقات على أشياء
.ونضعها حيث تنتمي

198
00:16:07,170 --> 00:16:08,920
حيث تنتمي؟

199
00:16:08,920 --> 00:16:11,140
.يمكنك أنّ تتّبع حدسك فحسب

200
00:16:14,800 --> 00:16:16,440
.سأجرّب ذلك

201
00:16:17,450 --> 00:16:20,910
كانت معرفة من ترك كلّ هذه
.الأغراض مستحيلة

202
00:16:20,910 --> 00:16:25,750
.أو حتّى من أين أتوا أو ما هي آمال أصحابها

203
00:16:22,790 --> 00:16:23,910
قصائد
شيراتوري
عن المواسم

204
00:16:26,250 --> 00:16:29,290
.لكنّي بذلتُ جهدي لترتيب الأغراض

205
00:16:29,990 --> 00:16:35,770
وفي النّهاية، كان لديّ حسّ مبهم
.لقصّة لكلّ غرض منها

206
00:16:36,260 --> 00:16:40,430
.بالإمكان تسميتها خريطة عبر الزّمن

207
00:16:46,200 --> 00:16:48,110
خريطة عبر الزّمن؟

208
00:16:52,640 --> 00:16:54,360
.خريطة زمن

209
00:16:58,210 --> 00:17:00,620
.أعتقد أنّ هذا يكفي لليوم

210
00:17:00,620 --> 00:17:03,500
مطعم ناروسي

211
00:17:06,930 --> 00:17:07,750
.المعذرة

212
00:17:08,300 --> 00:17:09,100
.مرحبًا

213
00:17:10,670 --> 00:17:12,390
ماذا أقدّم لك؟

214
00:17:13,040 --> 00:17:14,590
هل توصين بأيّ شيء؟

215
00:17:18,380 --> 00:17:20,500
...ربّما الأزرّ المقليّ

216
00:17:20,500 --> 00:17:21,600
الأرزّ المقليّ؟

217
00:17:22,770 --> 00:17:23,850
.إنّه ليس في القائمة

218
00:17:24,140 --> 00:17:27,640
.آسفة، لم تكن تلك توصية من المطعم

219
00:17:29,060 --> 00:17:30,150
ماذا كانت إذًا؟

220
00:17:32,150 --> 00:17:34,980
.توصية منّي

221
00:17:39,320 --> 00:17:40,910
.تفضّل

222
00:17:41,500 --> 00:17:42,910
.استمتع بوجبتك

223
00:17:43,250 --> 00:17:44,430
.شكرًا لك

224
00:17:49,510 --> 00:17:50,880
!هذا لذيذ

225
00:17:55,160 --> 00:17:57,100
!إنّه لذيذ بالفعل

226
00:17:57,100 --> 00:18:00,510
عفوًا، ماذا استعملت لتتبيله؟

227
00:18:04,660 --> 00:18:05,950
.إنّه سرّ

228
00:18:06,950 --> 00:18:08,610
.شكرًا على الطّعام

229
00:18:08,610 --> 00:18:09,830
.شكرًا لك

230
00:18:18,020 --> 00:18:19,730
.إنّها غريبة

231
00:18:23,730 --> 00:18:26,650
.عجبًا، رُتّبت كلّها

232
00:18:26,650 --> 00:18:27,630
.سرّتني المساعدة

233
00:18:28,640 --> 00:18:33,750
لكنّي أتساءل كيف استطعتُ
.تنظيم كلّ شيء

234
00:18:33,750 --> 00:18:35,620
.إنّه لغز حتّى بالنّسبة لي

235
00:18:39,210 --> 00:18:40,510
كيوكو-سان؟

236
00:19:09,110 --> 00:19:11,130
.أنا أعرف تلك الفتاة

237
00:19:12,630 --> 00:19:14,580
.أنا أذكرها

238
00:19:15,460 --> 00:19:18,260
.لن أنساها

239
00:19:19,080 --> 00:19:21,780
...لذلك

240
00:19:23,520 --> 00:19:25,460
!أومي

241
00:19:30,220 --> 00:19:36,270
ذكرى من صيف مضى
...احتفظتُ بها في جيبي

242
00:19:36,910 --> 00:19:39,520
،حتّى لو فقدتها بطريقة ما

243
00:19:40,030 --> 00:19:44,810
.لن أنسى رحلتك الطّويلة

244
00:20:08,510 --> 00:20:09,760
هايري-كُن؟

245
00:20:11,680 --> 00:20:13,500
هل أنت بخير؟

246
00:20:13,500 --> 00:20:15,240
.لقد شردتَ للحظة

247
00:20:15,240 --> 00:20:16,800
.صـ-صحيح

248
00:20:17,940 --> 00:20:18,990
.لكنّي بخير

249
00:20:41,160 --> 00:20:43,550
.شكرًا جزيلاً لك يا هايري-كُن

250
00:20:43,550 --> 00:20:45,380
.لقد ساعدتني كثيرًا

251
00:20:46,740 --> 00:20:48,930
.سرّني أنّي استطعتُ المساعدة أخيرًا

252
00:20:49,910 --> 00:20:51,060
أخيرًا"؟"

253
00:20:51,970 --> 00:20:54,760
هل كنت تريد المساعدة
طوال هذا الوقت؟

254
