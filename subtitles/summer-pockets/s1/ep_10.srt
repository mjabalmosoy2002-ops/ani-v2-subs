1
00:00:18,200 --> 00:00:20,120
...موغيو-غيو

2
00:00:33,770 --> 00:00:36,830
.ظننت أنّكما اختفيتما مجدّدًا

3
00:00:40,600 --> 00:00:45,850
.قرأت يوميّات تسوموغي-سان

4
00:00:47,070 --> 00:00:49,160
.أعتقد أنني فهمت الأمر

5
00:00:49,160 --> 00:00:50,690
.فهمت ما هو هدف تسوموغي

6
00:00:51,210 --> 00:00:55,370
."وما تعنيه هذه الفتاة بقولها إنّها "ستعود

7
00:00:55,370 --> 00:00:56,650
.فهمت

8
00:00:56,920 --> 00:01:00,700
على أيّة حال، بالنّسبة لنا، تظلّ
.تسوموغي هي تسوموغي

9
00:01:01,080 --> 00:01:04,700
.ومهما حدث، سنبقى معها حتّى النّهاية

10
00:01:05,240 --> 00:01:06,350
.هذا هو كلّ ما يهم

11
00:01:08,890 --> 00:01:10,290
.معك حقّ

12
00:01:12,540 --> 00:01:15,550
.شيزوكو، خطرت لي فكرة غبية

13
00:01:21,200 --> 00:01:24,070
.صباح الخير يا هايري-سان

14
00:01:25,330 --> 00:01:26,180
موغيو؟

15
00:01:26,740 --> 00:01:28,650
أنتِ هنا أيضًا يا شيزوكو؟

16
00:01:30,370 --> 00:01:32,450
.صباح الخير يا تسوموغي

17
00:01:37,090 --> 00:01:38,840
.صباح الخير

18
00:01:55,260 --> 00:02:00,550
جيوب صيف

19
00:03:11,050 --> 00:03:13,000
.رأس سنة سعيد يا تسوموغي

20
00:03:16,820 --> 00:03:19,670
.اليوم هو الأوّل من يناير

21
00:03:20,410 --> 00:03:21,220
موغيو؟

22
00:03:21,640 --> 00:03:23,630
.خطرت ببالي فكرة قبل قليل

23
00:03:24,220 --> 00:03:27,220
،ماذا لو ضغطنا أحداث عام كامل

24
00:03:27,220 --> 00:03:29,400
مثل رأس السّنة ومشاهدة براعم
،الكرز وما إلى ذلك

25
00:03:29,400 --> 00:03:33,080
في الأسبوع الّذي يسبق 31 أغسطس؟

26
00:03:33,080 --> 00:03:34,400
عام كامل؟

27
00:03:34,400 --> 00:03:37,940
!لا، بل حياة كاملة

28
00:03:38,680 --> 00:03:40,210
!يا لها من فكرة رائعة

29
00:03:40,210 --> 00:03:43,490
يمكننا الاحتفال بالهالوين والميلاد
.المجيد وكلّ شيء دفعة واحدة

30
00:03:43,490 --> 00:03:45,690
!هذا سخيف جدًّا

31
00:03:45,690 --> 00:03:49,720
.لكلّ مناسبة تقاليدها الخاصّة وموسمها المحدّد

32
00:03:49,720 --> 00:03:53,220
،صحيح أنّه من غير اللاّئق تأخير الأمور كثيرًا

33
00:03:53,220 --> 00:03:55,590
.لكن لا ضرر في تقديمها

34
00:03:57,990 --> 00:04:00,500
...لست متأكّدة

35
00:04:00,500 --> 00:04:01,510
.تسوموغي

36
00:04:02,590 --> 00:04:06,840
.أنا لا أقترح هذا من أجلك فقط

37
00:04:06,840 --> 00:04:07,940
موغيو؟

38
00:04:07,940 --> 00:04:09,070
.معه حقّ

39
00:04:10,790 --> 00:04:13,560
.أريد أن نمرح قدر ما نستطيع

40
00:04:13,560 --> 00:04:15,840
.عقودًا من المرح

41
00:04:15,840 --> 00:04:16,850
...شيزوكو

42
00:04:17,370 --> 00:04:18,730
وماذا عنك؟

43
00:04:19,040 --> 00:04:21,600
ما الّذي تريدين فعله؟

44
00:04:25,230 --> 00:04:26,600
...أنا

45
00:04:28,230 --> 00:04:34,200
!أريد أن ألعب كثيرًا وكثيرًا معك ومع شيزوكو

46
00:04:34,200 --> 00:04:36,000
!إلى الأبد

47
00:04:41,290 --> 00:04:43,100
!أريد أن أبقى معكما إلى الأبد

48
00:04:44,010 --> 00:04:46,260
ثلج مبشور

49
00:04:46,520 --> 00:04:48,260
حياة كاملة من المناسبات؟

50
00:04:48,260 --> 00:04:51,140
تسألني أنا؟ لماذا عليّ ذلك؟

51
00:04:50,720 --> 00:04:52,270
مثلّجات بطّيخ

52
00:04:52,640 --> 00:04:54,060
!يمكنكما الاعتماد علينا

53
00:04:54,060 --> 00:04:55,690
!سـ-سنسعد بذلك

54
00:04:55,990 --> 00:04:58,980
.سيسرّني ذلك كثيرًا في هذه الحالة

55
00:04:59,250 --> 00:05:00,220
.شكرًا

56
00:05:00,730 --> 00:05:02,110
.نحن مدينان لكم

57
00:05:03,320 --> 00:05:05,320
.سيكون هذا ممتعًا

58
00:05:05,320 --> 00:05:06,320
.نعم

59
00:05:06,320 --> 00:05:10,220
،وفي اليوم الأخير في 31 من أغسطس

60
00:05:10,220 --> 00:05:12,740
.أفكّر في إقامة حفلة عيد ميلاد

61
00:05:12,740 --> 00:05:14,120
.يبدو ذلك جيّدًا

62
00:05:14,120 --> 00:05:15,870
.ليكن احتفالاً كبيرًا

63
00:05:15,870 --> 00:05:19,580
حسنًا... كنتُ أفكّر في إقامة
.مفاجأة من نوع ما

64
00:05:19,960 --> 00:05:22,100
مفاجأة؟

65
00:05:23,470 --> 00:05:25,420
.أنا من لديها فكرة لذلك هذه المرّة

66
00:05:28,300 --> 00:05:33,310
.وهكذا بدأ الأسبوع الأخير من صيفنا

67
00:06:21,540 --> 00:06:26,110
.عشنا صيفًا غنيًّا بالأحداث

68
00:06:26,110 --> 00:06:29,110
شعرنا وكأنّ التّنفّس بحدّ ذاته كان
.ترفًا لا يجوز إضاعة وقته

69
00:06:29,110 --> 00:06:31,610
تسوموغي فيندرز - تاكاهارا هايري

70
00:06:32,520 --> 00:06:36,620
حرصنا على أن تكون عطلة الصّيف
.تلك من أجمل الذّكريات الّتي لا تُنسى

71
00:06:40,330 --> 00:06:42,130
!عيد ميلاد مجيد

72
00:06:43,630 --> 00:06:44,940
...حسنًا

73
00:06:44,940 --> 00:06:48,630
.لديّ هديّة ميلاد مجيد لكليكما

74
00:06:50,300 --> 00:06:51,880
.مفتاحان احتياطيّان لهذا المكان

75
00:06:53,140 --> 00:06:59,600
يمكنكما الآن الدّخول حتّى إن جئتما
.لزيارتي ولم أكن في المنزل

76
00:06:59,980 --> 00:07:01,210
.شكرًا لك

77
00:07:01,210 --> 00:07:04,710
.لكنّك جريئة نوعًا ما يا تسوموغي

78
00:07:04,710 --> 00:07:06,900
كيف تُعطين مفتاحًا احتياطيًّا
لحبيبك بهذه البساطة؟

79
00:07:06,900 --> 00:07:08,000
!موغيو

80
00:07:08,990 --> 00:07:11,570
...أ-أنا لم أكن

81
00:07:11,960 --> 00:07:13,700
.بل ذلك بالضّبط كان قصدي في الحقيقة

82
00:07:14,340 --> 00:07:16,950
.لديّ هديّة لك أيضًا يا تسوموغي

83
00:07:17,290 --> 00:07:18,290
.تفضّلي

84
00:07:20,440 --> 00:07:22,080
!شكرًا جزيلاً لك

85
00:07:28,060 --> 00:07:28,920
.إنّه زيّ سباحة

86
00:07:28,920 --> 00:07:31,360
.لا يمكن أن تكوني جادّة

87
00:07:31,360 --> 00:07:32,680
!مـ-مهلاً

88
00:07:32,680 --> 00:07:35,350
اعتقدتُ أنّ صدرها قد يتفاعل بطريقة ما

89
00:07:35,350 --> 00:07:39,170
.بعدما أصبحت على علاقتك بك يا بايري-كُن

90
00:07:42,740 --> 00:07:46,670
من المستحيل أن يصير أكبر
.من صدرك يا شيزوكو

91
00:07:49,350 --> 00:07:50,770
.هذا صحيح

92
00:07:50,770 --> 00:07:53,130
.أنا واثق من ذلك على الأقلّ

93
00:07:55,830 --> 00:07:57,160
ماذا يجري؟

94
00:07:57,160 --> 00:08:00,430
.قدّمتها على أمل أن يكبر صدرها

95
00:08:14,340 --> 00:08:15,430
...تسوموغي

96
00:08:18,210 --> 00:08:19,470
!لا أريد الذّهاب

97
00:08:19,470 --> 00:08:21,870
!لا أريد العودة

98
00:08:21,870 --> 00:08:23,200
...ما زلت

99
00:08:23,200 --> 00:08:27,170
.ما زلت أريد الذّهاب للبحر ثانية

100
00:08:27,690 --> 00:08:29,910
.أريد ارتداء اليوكاتا في المهرجانات

101
00:08:30,500 --> 00:08:32,310
.أريد خوض قتال بالثّلج

102
00:08:33,140 --> 00:08:35,600
.هنالك أشياء كثيرة أريد القيام بها

103
00:08:36,490 --> 00:08:43,290
!أريد البقاء معكما أكثر وأكثر للأبد

104
00:08:47,330 --> 00:08:49,080
.لا بأس يا تسوموغي

105
00:08:49,840 --> 00:08:51,300
.لا بأس

106
00:08:52,310 --> 00:08:54,050
...لـ-لكن

107
00:08:54,600 --> 00:08:57,550
...عندما يحين الغد، أنا

108
00:08:57,550 --> 00:09:00,860
سنستمتع بوقتنا معًا حتّى النّهاية، صحيح؟

109
00:09:01,440 --> 00:09:03,680
.لذلك علينا البقاء مبتسمين

110
00:09:03,680 --> 00:09:05,650
صحيح يا بايري-كُن؟

111
00:09:05,650 --> 00:09:06,230
ماذا؟

112
00:09:06,640 --> 00:09:08,560
.نعم. بالطّبع

113
00:09:09,380 --> 00:09:12,710
.سنظلّ إلى جانبك

114
00:09:15,050 --> 00:09:16,400
...هايري-سان

115
00:09:16,950 --> 00:09:19,710
لذلك لا مزيد من البكاء، مفهوم؟

116
00:09:20,660 --> 00:09:22,080
لماذا إذًا؟

117
00:09:22,630 --> 00:09:26,620
لماذا أنتما لطيفين جدًّا هكذا؟

118
00:09:26,620 --> 00:09:28,850
وما السّبب في رأيك؟

119
00:09:29,280 --> 00:09:31,960
.لأنّني أحبّك

120
00:09:31,960 --> 00:09:33,000
.وأنا كذلك

121
00:09:33,000 --> 00:09:34,460
.أحبّك أيضًا

122
00:09:36,110 --> 00:09:38,300
.و-وأنا أيضًا

123
00:09:39,300 --> 00:09:43,960
.وأنا أيضًا يا شيزوكو وهايري-سان... أحبّكما

124
00:09:44,850 --> 00:09:49,090
،هكذا وصلنا إلى الحادي والثّلاثين من أغسطس

125
00:09:49,740 --> 00:09:52,260
.آخر يوم في عطلة الصّيف

126
00:10:01,080 --> 00:10:02,370
.حسنًا، سأغادر الآن

127
00:10:02,770 --> 00:10:04,510
.لديّ الكثير للاستعداد له

128
00:10:04,510 --> 00:10:06,790
.اقضي وقتًا ممتعًا برفقة بايري-كُن

129
00:10:06,790 --> 00:10:08,700
...موغيو

130
00:10:08,700 --> 00:10:11,500
.أريد قضاء وقت أكثر معك يا شيزوكو

131
00:10:11,500 --> 00:10:13,450
.لا داعي لأن تحزني

132
00:10:13,450 --> 00:10:15,380
.استمتعنا كثيرًا معًا

133
00:10:15,380 --> 00:10:18,440
.استمتعتُ بوقتي كثيرًا بالفعل يا هايري-كُن

134
00:10:18,440 --> 00:10:20,680
.شيزوكو... شكرًا لك

135
00:10:21,780 --> 00:10:23,850
.أحبّك يا تسوموغي

136
00:10:24,330 --> 00:10:27,250
.أحبّك أيضًا يا شيزوكو

137
00:10:27,250 --> 00:10:30,100
أتعدينني أنّك لن تبكين؟

138
00:10:32,760 --> 00:10:33,730
.نعم

139
00:10:52,280 --> 00:10:53,290
تسوموغي؟

140
00:10:53,840 --> 00:10:55,000
!تسوموغي

141
00:10:56,780 --> 00:10:58,300
هايري-سان؟

142
00:11:00,300 --> 00:11:02,010
هل من خطب ما؟

143
00:11:05,700 --> 00:11:06,800
...تسوموغي

144
00:11:07,750 --> 00:11:09,570
هلاّ أخبرتني أنّك تحبّينني؟

145
00:11:09,570 --> 00:11:10,520
!موغيو

146
00:11:10,770 --> 00:11:13,520
.أريد تذكّر صوتك

147
00:11:14,340 --> 00:11:17,400
.أريد تذكّر صوتك أيضًا

148
00:11:19,160 --> 00:11:21,280
.أحبّك يا تسوموغي

149
00:11:21,600 --> 00:11:24,160
.أحبّك كثيرًا يا هايري-سان

150
00:11:41,330 --> 00:11:43,080
.يبدو أنّ الوقت قد حان

151
00:11:43,080 --> 00:11:45,340
هل سيحدث أمر ما؟

152
00:11:45,340 --> 00:11:46,840
من يدري؟

153
00:11:46,840 --> 00:11:47,850
.لا أطيق الانتظار

154
00:11:48,200 --> 00:11:49,550
.موغيو

155
00:11:49,550 --> 00:11:52,100
.إنّك تتصرّف بلؤم يا هايري-سان

156
00:12:18,270 --> 00:12:20,310
.هذا مذهل

157
00:12:20,310 --> 00:12:22,450
.اليوم هو عيد ميلادك

158
00:12:23,580 --> 00:12:25,230
.لذلك علينا الاحتفال

159
00:12:25,720 --> 00:12:29,260
بكعكة عيد ميلاد تحمل شموعًا
.بعدد سنوات العمر كلّها

160
00:12:29,260 --> 00:12:32,310
عيد ميلادي؟

161
00:12:33,190 --> 00:12:36,770
كيف عثرت على كلّ هذه الشّموع من الأساس؟

162
00:12:36,770 --> 00:12:38,700
.بمساعدة رابطة الشّباب

163
00:12:38,700 --> 00:12:40,150
ساعدوك على ذلك؟

164
00:12:40,150 --> 00:12:44,650
كانوا موافقين جميعًا على فكرة
.شيزوكو لإسعادك

165
00:12:45,450 --> 00:12:47,990
.لقد صنعوا هذه باستعمال علب بارينغلز الفارغة

166
00:12:49,440 --> 00:12:52,700
!بارينغلز الأفضل بالفعل

167
00:13:17,080 --> 00:13:20,580
.جميعهم أشخاص طيّبون

168
00:13:20,580 --> 00:13:21,300
.نعم

169
00:13:22,020 --> 00:13:23,840
.لا يوجد أصدقاء أفضل منهم

170
00:13:26,350 --> 00:13:31,560
هايري-سان، هل يمكنني الحديث عن الماضي؟

171
00:13:31,560 --> 00:13:32,200
.أكيد

172
00:13:32,980 --> 00:13:35,700
.تسوموغي-تشان صديقتي

173
00:13:36,430 --> 00:13:37,830
تلك الأغنية الّتي كنتُ أدندنها

174
00:13:38,520 --> 00:13:43,840
هي أغنية اعتادت أن تغنّيها
.عندما كانت في منزلها وراء البحر

175
00:13:44,460 --> 00:13:49,840
،لم يكن لديها أصدقاء كُثر هنا
.لذلك لم تغنّيها كثيرًا

176
00:13:50,810 --> 00:13:53,850
.لم يكن لها من الأصدقاء سوى دُماها المحشوّة

177
00:13:54,360 --> 00:13:59,060
.ولكن ذات يوم، صادقت فتاة تُدعى كاتو-سان

178
00:13:59,060 --> 00:14:01,360
.كانت سعيدة جدًّا بإخباري عنها

179
00:14:02,290 --> 00:14:07,360
،ثمّ وقعت في حبّ رجل
.وقرّرت مغادرة الجزيرة معه

180
00:14:08,060 --> 00:14:08,900
...لكن

181
00:14:10,520 --> 00:14:14,040
.اختفت تسوموغي-تشان

182
00:14:17,830 --> 00:14:20,710
.أنا آسفة يا أبي وأمّي
.وشكرًا للجميع في الجزيرة
.أحبّكم جميعًا

183
00:14:21,320 --> 00:14:24,710
.ومع ذلك، أنا واثقة أنّها ستعود

184
00:14:25,370 --> 00:14:31,050
.لذلك قرّرتُ أخذ مكانها حتّى ذلك الحين

185
00:14:32,430 --> 00:14:35,140
.آملة ألاّ ينساها أحد

186
00:14:42,560 --> 00:14:45,190
،حاولتُ البحث عن تسوموغي-تشان

187
00:14:45,510 --> 00:14:48,190
.وأسأل إن كان أيّ أحد يعرفني

188
00:14:49,960 --> 00:14:55,690
لكنّ عدد الّذين يتذكّرونها
.أخذ يتناقص شيئًا فشيئًا

189
00:14:56,960 --> 00:15:00,580
.وذات يوم، أتت كاتو-سان

190
00:15:04,510 --> 00:15:05,570
.تسوموغي

191
00:15:07,590 --> 00:15:12,810
.أخبرتني أن أقوم بما أريد القيام به

192
00:15:13,220 --> 00:15:14,900
ما تريدين القيام به؟

193
00:15:16,420 --> 00:15:21,260
.في الحقيقة، لم أعلم ما الّذي أريد القيام به

194
00:15:22,000 --> 00:15:31,320
ولهذا قرّرت أن أصنع أصدقاء ليكونوا
.في انتظار تسوموغي-تشان عندما تعود

195
00:15:32,090 --> 00:15:34,620
.قبل أن أغادر هذا المكان

196
00:15:35,230 --> 00:15:37,530
.وذات يوم، التقيتُ أحدًا

197
00:15:38,210 --> 00:15:41,180
.لقد أثنت على الدّمى المحشوّة

198
00:15:41,960 --> 00:15:44,290
قادني ذلك الحدث البسيط

199
00:15:45,240 --> 00:15:48,180
.إلى صديقة جديدة تُدعى شيزوكو

200
00:15:49,400 --> 00:15:52,760
.ثمّ قابلتُك أنت

201
00:15:52,760 --> 00:15:54,840
.ووقعتُ في الحبّ

202
00:15:54,840 --> 00:15:57,000
.ليس من أجل تسوموغي-تشان

203
00:15:57,510 --> 00:16:01,020
.وقعتُ في الحبّ من أجلي أنا

204
00:16:01,850 --> 00:16:04,210
.كوّنتُ الكثير من الصّداقات

205
00:16:04,700 --> 00:16:07,050
.عرفتُ ما معنى السّعادة

206
00:16:08,070 --> 00:16:11,030
!والآن هناك أشياء كثيرة أودّ فعلها

207
00:16:13,400 --> 00:16:16,850
.لا أستطيع الانتظار لرؤية ما سيحدث لاحقًا

208
00:16:17,720 --> 00:16:20,780
.ربما ستتساقط الثّلوج حين يحلّ الشّتاء

209
00:16:20,780 --> 00:16:22,790
!وسيكون الأمر شاقًّا بحقّ

210
00:16:23,580 --> 00:16:25,750
،ستغلق الثّلوج الباب

211
00:16:26,270 --> 00:16:29,770
وسأستطيع الخروج بمعجزة
.بفضلك أنت وشيزوكو

212
00:16:29,770 --> 00:16:31,880
!ستنقذان حياتي

213
00:16:31,880 --> 00:16:33,470
.كلّ هذا افتراضيّ

214
00:16:33,880 --> 00:16:36,340
.في الصّيف، سنسبح في البحر

215
00:16:36,340 --> 00:16:38,980
.سنرتدي اليوكاتا ونذهب إلى المهرجان

216
00:16:39,470 --> 00:16:41,780
،سنتشاجر أحيانًا

217
00:16:41,780 --> 00:16:44,520
.لكنّنا سنتصالح على الفور

218
00:16:44,520 --> 00:16:49,020
.سأخبرك كم أنا سعيدة لأنّنا معًا نحن الثّلاثة

219
00:16:49,020 --> 00:16:49,730
.نعم

220
00:16:50,250 --> 00:16:51,810
.لا أستطيع الانتظار

221
00:16:52,240 --> 00:16:52,930
.نعم

222
00:16:53,970 --> 00:16:55,710
.كان اليوم ممتعًا أيضًا

223
00:16:56,210 --> 00:16:56,800
.نعم

224
00:16:57,680 --> 00:17:02,560
.وغدًا وبعده وكلّ يوم بعد ذلك سيكون كذلك

225
00:17:03,130 --> 00:17:03,850
.نعم

226
00:17:06,190 --> 00:17:09,630
.لديّ شيزوكو وشيروها-سان أيضًا

227
00:17:09,630 --> 00:17:14,600
ثمّ هناك أوُ-سان ونومورا-سان
.وميتاني-سان وكانو-سان

228
00:17:14,600 --> 00:17:17,010
.سيكون كلّ يوم مليئًا بالمرح

229
00:17:19,190 --> 00:17:20,260
...لذا

230
00:17:23,250 --> 00:17:24,460
.لا تبكِ رجاءً

231
00:17:25,060 --> 00:17:26,070
.آسف

232
00:17:26,590 --> 00:17:27,410
...أنا فقط

233
00:17:27,890 --> 00:17:29,770
.لن تكوني هناك

234
00:17:35,990 --> 00:17:40,220
.هايري-سان، أنا سعيدة

235
00:17:40,220 --> 00:17:41,910
.تعرّفتُ على الجميع

236
00:17:42,390 --> 00:17:43,830
.تعرّفتُ على شيزوكو

237
00:17:44,700 --> 00:17:46,530
.وتعرّفتُ عليك

238
00:17:48,010 --> 00:17:48,700
.نعم

239
00:17:50,220 --> 00:17:51,840
.أنا سعيد أيضًا

240
00:17:51,840 --> 00:17:55,340
لذا يجب أن نستمتع بوقتنا، صحيح؟

241
00:17:58,430 --> 00:17:59,160
.نعم

242
00:18:05,800 --> 00:18:09,300
.كانت إجازة صيفيّة جميلة جدًّا

243
00:18:11,320 --> 00:18:17,860
أغنّي بحثًا عنّي

244
00:18:23,990 --> 00:18:30,710
أغنّي عند المنارة ليُعثر عليّ

245
00:18:36,850 --> 00:18:43,520
أبحث عن الموادّ، كما يفعل الطّائر القويّ

246
00:18:49,690 --> 00:18:56,110
ألعب مع الطّائر والبقرة في الماء

247
00:19:02,450 --> 00:19:08,950
الطّائر والبقرة وأنا معًا هذا الصّيف

248
00:19:15,340 --> 00:19:21,960
الطّائر وأنا نمسك بأيدي بعضنا؛ نحن عاشقان

249
00:19:34,650 --> 00:19:41,030
يا طائري الحبيب، ويا بقرَتي الحبيبة

250
00:19:47,200 --> 00:19:53,830
الشّريط الأزرق السّماويّ هو كنزي

251
00:19:59,840 --> 00:20:06,680
لن أنسى هذا الصّيف وهذه المنارة وهذا الطّائر

252
00:20:44,760 --> 00:20:45,760
.تسوموغي

253
00:20:53,130 --> 00:20:55,990
.عيد ميلاد سعيد

254
00:21:05,280 --> 00:21:06,910
.لقد كانت عطلة صيفيّة رائعة

255
00:21:10,690 --> 00:21:12,180
...كنت أفكرّ

256
00:21:12,920 --> 00:21:16,460
.كانت تسوموغي هي العطلة الصّيفيّة نفسها

257
00:21:17,000 --> 00:21:17,670
.نعم

258
00:21:18,020 --> 00:21:21,170
عندما تلتقي بشخص للمرّة الأولى
في مكان غريب

259
00:21:21,170 --> 00:21:22,610
،وتصبحان أصدقاء

260
00:21:23,400 --> 00:21:26,400
.تشعر وكأنّ لديك كلّ وقت العالم

261
00:21:27,280 --> 00:21:30,150
،لكن في النّهاية
،تحزن لأنّ وقتك قد انتهى

262
00:21:30,150 --> 00:21:32,680
.وتندم على الاضطرار لقول الوداع

263
00:21:33,040 --> 00:21:35,720
.كانت هي صيفي

264
00:21:35,720 --> 00:21:36,500
.نعم

265
00:21:37,080 --> 00:21:38,420
.صيفي أيضًا

266
00:21:38,850 --> 00:21:40,250
...على أيّ حال

267
00:21:44,450 --> 00:21:45,690
!تلك الأغنية

268
00:21:46,370 --> 00:21:47,980
ماذا تغنّين؟

269
00:21:48,820 --> 00:21:53,560
كانت السّيّدة القطّة الّتي تقدّم
.تمارين الرّاديو تغنّيها أحيانًا

270
00:21:53,560 --> 00:21:56,030
!أصبحنا أصدقاء

271
00:21:56,030 --> 00:21:56,960
فعلاً؟

272
00:21:57,210 --> 00:21:59,580
.نأمل أن تلتقين بها العام القادم أيضًا

273
00:21:59,580 --> 00:22:00,290
!نعم

274
00:22:00,900 --> 00:22:02,860
العام القادم؟

275
00:22:04,790 --> 00:22:06,190
.نعم

276
00:22:06,730 --> 00:22:08,340
.هذا صحيح

277
00:22:08,340 --> 00:22:09,220
.نعم

278
00:22:09,770 --> 00:22:12,990
.ستعود العطلة الصّيفيّة مرّة أخرى

279
00:22:26,390 --> 00:22:27,860
.الحلوى القطنيّة-سان

280
00:22:29,180 --> 00:22:31,580
.إلى اللّقاء يا تسوموغي

281
00:22:57,410 --> 00:22:58,740
.الوداع

282
00:22:59,200 --> 00:23:00,780
.أراك في المرّة القادمة

283
00:23:29,720 --> 00:23:30,920
.لقد عدنا

284
00:23:34,070 --> 00:23:35,550
.مرحبًا بعودتكم