1
00:01:47,960 --> 00:01:49,650
.انكسر

2
00:01:49,650 --> 00:01:51,140
.لنعد الكرّة

3
00:01:54,720 --> 00:01:57,260
أ-أما زلنا نُواصل هذا؟

4
00:01:59,460 --> 00:02:00,740
لماذا؟

5
00:02:08,680 --> 00:02:11,190
ألا تشعرُ ميكو بشيء حيال هذا؟

6
00:02:12,280 --> 00:02:17,700
،عندما أفكّر في الأمر
.أظنّ أنَّ ميكو حاولت كسره

7
00:02:18,350 --> 00:02:23,960
لا، لقد بدت متفاجئة جدًا
.بعد ذلك أيضًا

8
00:02:24,550 --> 00:02:27,050
.لا بدّ أنّها لم تكُن تنوي تقبيلي

9
00:02:28,130 --> 00:02:29,740
صحيح؟

10
00:02:30,080 --> 00:02:32,050
لِم ما زلنا نواصل إذًا؟

11
00:02:32,480 --> 00:02:34,730
لأنّها لا تستطيع تحمّل الخسارة؟

12
00:02:34,730 --> 00:02:37,000
لأنّها لا تستطيع الانسحاب الآن؟

13
00:02:39,210 --> 00:02:43,430
.تتصرّف ميكو بغرابة اليوم بلا شك

14
00:02:45,000 --> 00:02:46,810
.لا أفهم

15
00:03:29,480 --> 00:03:33,230
الحلقة 10
صديقة طفولتي لا تقهر

16
00:06:09,550 --> 00:06:11,140
هل أثّر ذلك فيك؟

17
00:06:38,580 --> 00:06:40,200
.شيء ما يتغيّر

18
00:06:41,810 --> 00:06:42,970
.لا شك في ذلك

19
00:06:44,080 --> 00:06:47,480
.أنا متأكد

20
00:06:57,940 --> 00:07:00,710
.فعلتُها، حدث الأمر

21
00:07:01,170 --> 00:07:04,500
.تبادلتُ قبلة مع ميكو

22
00:07:06,030 --> 00:07:11,580
لا بدّ أنّ ذلك يعني
أنّها تُحبّني، صحيح؟

23
00:07:14,500 --> 00:07:15,540
...لكن

24
00:07:16,800 --> 00:07:20,330
.كان هناك شيء غير طبيعي بكلّ وضوح

25
00:07:21,090 --> 00:07:26,960
،محال أن تفعل شيئًا كذلك
.سواء كانت لعبة حبّ أم لا

26
00:07:37,520 --> 00:07:38,910
...جدّتي

27
00:07:39,610 --> 00:07:44,030
.قبّلتُ يوكيا لأول مرّة

28
00:07:45,100 --> 00:07:49,780
في البداية، فوجئتُ حين
.تلامست شفاهنا

29
00:07:49,780 --> 00:07:52,740
.لكنّني جمعتُ شجاعتي وأعدتُ الأمر

30
00:07:53,190 --> 00:07:57,410
.ثمّ ردّ يوكيا القبلة

31
00:07:58,680 --> 00:08:00,030
...وجهه

32
00:08:00,030 --> 00:08:02,360
.كان قلبه يخفق بسرعة بكلّ تأكيد

33
00:08:02,360 --> 00:08:04,550
كان مركزًا عليّ حقًا، صحيح؟

34
00:08:04,950 --> 00:08:08,470
إنّه يفكّر بي الآن، صحيح؟

35
00:08:20,110 --> 00:08:23,530
.لم يبادر يوكيا أبدًا

36
00:08:25,180 --> 00:08:29,530
.ومع ذلك أنا قبّلته

37
00:08:30,640 --> 00:08:33,170
.كنتُ أعرف بالفعل

38
00:08:33,870 --> 00:08:39,750
.إنّه ظريف

39
00:08:35,250 --> 00:08:38,190
.كنتُ أعلم أنّه لم يقصد أكاني

40
00:08:38,990 --> 00:08:41,960
...لكن

41
00:08:42,620 --> 00:08:45,250
لماذا لم يقُلها لي؟

42
00:08:47,180 --> 00:08:48,120
.أريدها

43
00:08:48,120 --> 00:08:49,260
!لا

44
00:08:50,360 --> 00:08:51,430
.أريدها

45
00:08:51,430 --> 00:08:53,010
!لا تفعلي

46
00:08:53,010 --> 00:08:54,460
.أريدها الآن

47
00:08:57,230 --> 00:08:58,730
.أنا فظيعة

48
00:08:59,700 --> 00:09:03,990
لِم لستُ ظريفة؟

49
00:09:09,990 --> 00:09:16,740
"محققو أوهارو"

50
00:09:12,160 --> 00:09:14,310
!لنلعب كرة المراوغة جميعًا

51
00:09:14,310 --> 00:09:15,330
!أنا معكن

52
00:09:15,330 --> 00:09:16,740
!وأنا أيضًا

53
00:09:16,740 --> 00:09:18,290
ماذا عنكِ يا ساكورا-سان؟

54
00:09:22,000 --> 00:09:24,980
تسرّني دعوتهن لي
.لكنّني سيئة في كرة المراوغة

55
00:09:24,980 --> 00:09:28,510
.سأجعل اللّعبة مملة للجميع

56
00:09:28,510 --> 00:09:31,420
.سـ-سأمتنع

57
00:09:34,220 --> 00:09:36,310
.حسنًا. آسفة

58
00:09:36,310 --> 00:09:37,710
.لنذهب

59
00:09:37,710 --> 00:09:41,340
.لا تشارك ساكورا-سان دائمًا. لا بأس

60
00:09:45,700 --> 00:09:46,900
.ساكورا

61
00:09:47,770 --> 00:09:49,440
.أساغي-كن

62
00:09:52,640 --> 00:09:54,910
.آسفة. شكرًا

63
00:09:55,580 --> 00:09:56,880
.ها نحن ذا

64
00:09:58,200 --> 00:09:59,680
.ساكورا-سان

65
00:10:00,660 --> 00:10:03,450
.عليكِ حمل الدلو بنفسك على الأقل

66
00:10:03,450 --> 00:10:05,680
.يفعل الجميع ذلك بأنفسهم

67
00:10:06,210 --> 00:10:08,090
.آ-آسفة

68
00:10:18,970 --> 00:10:23,390
"ميكو"

69
00:10:20,680 --> 00:10:23,390
.لا تبكي يا ميكو-تشان

70
00:10:25,920 --> 00:10:30,690
.أستطيع الرحيل مطمئنة ما دمتِ مبتسمة

71
00:10:30,690 --> 00:10:33,230
!سأظلّ أبكي إذًا

72
00:10:33,230 --> 00:10:35,090
!سأظل أقلق

73
00:10:35,090 --> 00:10:36,870
!ابقي هنا رجاء

74
00:10:37,410 --> 00:10:41,370
...لا ترحلي يا جدّتي وإلّا

75
00:10:50,570 --> 00:10:53,810
.سأزعج جدّتي مجددًا

76
00:10:55,990 --> 00:10:57,980
!أحضر أساغي فتاة معه

77
00:10:57,980 --> 00:11:00,390
.وماذا في ذلك؟ إنّها صديقتي

78
00:11:00,390 --> 00:11:02,440
.معك ميهاشي والبقية أيضًا

79
00:11:02,440 --> 00:11:06,040
.كنّا نلعب حين أتين إلى هنا

80
00:11:07,690 --> 00:11:09,150
.لا بأس يا أساغي-كن

81
00:11:09,150 --> 00:11:11,140
.لا أملك ألعابًا

82
00:11:11,140 --> 00:11:12,230
.لا بأس

83
00:11:16,110 --> 00:11:19,200
،حسنًا، بما أنَّ عددنا كبير
لنلعب لعبة المطاردة؟

84
00:11:19,200 --> 00:11:20,490
.فكرة جيّدة

85
00:11:20,490 --> 00:11:23,910
.أنتِ المطاردة لأنّك انضممتِ أخيرًا

86
00:11:23,910 --> 00:11:27,020
.أنا مُطارِد أيضًا بما أنّني أتيتُ آخرًا

87
00:11:27,020 --> 00:11:28,170
ماذا؟

88
00:11:28,170 --> 00:11:30,050
.من غير العادل وجود مطاردين

89
00:11:30,050 --> 00:11:31,750
.اصمت

90
00:11:31,750 --> 00:11:32,930
.ها نحن ذا

91
00:11:32,930 --> 00:11:37,340
...واحد، اثنان، ثلاثة، أربعة

92
00:11:33,810 --> 00:11:35,830
!جديًا؟

93
00:11:37,340 --> 00:11:39,140
!سيئ، اهربوا

94
00:11:39,140 --> 00:11:41,220
!لنطوّقهم من جانبين يا ساكورا

95
00:11:41,220 --> 00:11:42,830
!حـ-حسنًا

96
00:11:44,060 --> 00:11:45,260
!حاصريهم

97
00:11:45,260 --> 00:11:46,060
!حسنًا

98
00:11:48,560 --> 00:11:50,060
هل أنت بخير؟

99
00:11:50,060 --> 00:11:51,870
.نعم بخير

100
00:11:51,870 --> 00:11:53,360
!أسرعا

101
00:11:53,360 --> 00:11:54,490
!مهلًا

102
00:11:56,070 --> 00:11:58,900
.إ-إنّهم يهربون باستمرار

103
00:11:58,900 --> 00:12:01,960
.أنتما بطيئان جدًا

104
00:12:01,960 --> 00:12:04,870
.بدأت أشعر بالأسف عليكما

105
00:12:09,480 --> 00:12:12,500
.أنتم سريعون جدًا

106
00:12:13,990 --> 00:12:16,280
لِم تضحكين؟

107
00:12:16,280 --> 00:12:17,340
.أنت غريبة

108
00:12:19,060 --> 00:12:24,140
.لأنّني أستمتع كثيرًا باللّعب معكم

109
00:12:30,200 --> 00:12:32,980
هل نلتقي غدًا أيضًا يا ساكورا-سان؟

110
00:12:33,690 --> 00:12:34,960
...لكن

111
00:12:34,960 --> 00:12:36,320
ألن أسبّب إزعاجًا؟

112
00:12:37,540 --> 00:12:38,680
لماذا؟

113
00:12:38,680 --> 00:12:39,990
.لا تقلقي حيال ذلك

114
00:12:39,990 --> 00:12:41,350
.لنلعب

115
00:12:43,360 --> 00:12:44,530
!حسنًا

116
00:12:44,530 --> 00:12:45,720
!وداعًا

117
00:12:45,720 --> 00:12:47,130
!إلى اللقاء

118
00:12:47,540 --> 00:12:50,100
.طوبى لك. كوّنت صداقات

119
00:12:50,100 --> 00:12:52,420
.نـ-نعم. شكرًا

120
00:12:53,310 --> 00:12:55,490
...كنتُ أفكّر

121
00:12:56,210 --> 00:12:59,870
.أنّك تبدين جميلة حين تبتسمين

122
00:13:04,220 --> 00:13:06,770
.أردته أن يقول المزيد

123
00:13:07,540 --> 00:13:08,970
.عليّ أن أتغيّر

124
00:13:10,060 --> 00:13:13,280
.لكي أظل بجانب أساغي-كن إلى الأبد

125
00:13:10,060 --> 00:13:14,900
"ما معنى الفتاة الظريفة؟"

126
00:13:18,020 --> 00:13:19,240
...ومع ذلك

127
00:13:20,130 --> 00:13:23,450
.أنا الآن لستُ ظريفة بتاتًا

128
00:13:24,280 --> 00:13:26,500
غلبتني رغبتي بأن أحظى بقُبول

129
00:13:26,500 --> 00:13:28,410
.وحاولت جذبه بقبلة

130
00:13:28,830 --> 00:13:30,500
.أنا منحطّة

131
00:13:31,160 --> 00:13:33,120
...أنا منحطّة جدًا ومع ذلك

132
00:13:35,560 --> 00:13:37,230
.أسعدني ذلك

133
00:13:39,550 --> 00:13:41,730
.لم أتمالك نفسي من الفرح

134
00:13:45,760 --> 00:13:47,350
.لستُ ظريفة

135
00:13:49,810 --> 00:13:52,140
.لستُ ظريفة. لستُ ظريفة

136
00:13:55,060 --> 00:13:57,690
.لستُ ظريفة حقًا

137
00:14:02,220 --> 00:14:09,220
.لن ينعتني بالظريفة طبعًا

138
00:14:14,750 --> 00:14:18,570
.أريد يوكيا أن يبقى معي

139
00:14:18,570 --> 00:14:21,970
.عليّ أن أصبح ظريفة

140
00:14:33,270 --> 00:14:35,050
.أنتِ جميلة حين تبتسمين

141
00:14:47,550 --> 00:14:49,160
!إنّه يوكي

142
00:14:49,930 --> 00:14:51,080
.نعم

143
00:14:54,460 --> 00:14:57,850
تجاوزتم وقت الإغلاق، صحيح؟

144
00:14:57,850 --> 00:14:59,290
.عليّ أن أغادر

145
00:14:59,290 --> 00:15:00,340
.لا بأس

146
00:15:00,340 --> 00:15:02,670
.تحتاج هيناكو لتفريغ همومها
.دعها تتحدث

147
00:15:02,670 --> 00:15:03,880
.بالضبط

148
00:15:03,880 --> 00:15:06,190
.هذه الكعكة على حسابي

149
00:15:06,190 --> 00:15:07,990
.شكرًا

150
00:15:11,770 --> 00:15:13,930
.اسمعني يا يوكي

151
00:15:13,930 --> 00:15:16,350
.فشلتُ في اختبار الأداء مجددًا البارحة

152
00:15:16,730 --> 00:15:19,440
من أجل دور الصوت
في أنمي الويب ذاك؟

153
00:15:19,440 --> 00:15:20,370
.نعم

154
00:15:20,370 --> 00:15:23,400
.كانت فرصة كبيرة لذا تدربتُ كثيرًا

155
00:15:24,080 --> 00:15:26,020
إنّه عالم صعب فعلًا

156
00:15:26,020 --> 00:15:29,420
.أنا أحبّ صوتك أيضًا ولا أجامل

157
00:15:30,240 --> 00:15:32,220
!شكرًا يا يوكّي

158
00:15:32,220 --> 00:15:34,130
.أعطني بعض التعاطف

159
00:15:34,540 --> 00:15:36,800
هل تريدين لونين مختلفين
من بوتشيمون إذًا؟

160
00:15:36,800 --> 00:15:37,710
.إنّها نادرة جدًا

161
00:15:38,890 --> 00:15:40,380
.لا داعي

162
00:15:53,140 --> 00:15:54,270
...عفوًا

163
00:15:54,270 --> 00:15:57,140
.هناك أمر يشغلني أيضًا في الواقع

164
00:15:58,950 --> 00:16:00,500
ما هو؟

165
00:16:01,280 --> 00:16:05,400
.لا أستطيع فهم ما تفكّر فيه ميكو

166
00:16:05,400 --> 00:16:10,730
.فعلَت شيئًا خارجًا عن طبيعتها

167
00:16:11,540 --> 00:16:14,950
.وكانت ملامحها جادّة جدًا

168
00:16:15,440 --> 00:16:18,050
.أخطأتُ أيضًا

169
00:16:18,050 --> 00:16:22,750
...لكن ما تفعله متناقض جدًا

170
00:16:23,710 --> 00:16:28,090
.لا بدّ أنَّ تلك القبلة كانت بلا قصد

171
00:16:28,930 --> 00:16:32,250
لا بدّ أنّها لم ترغب بذلك، صحيح؟

172
00:16:32,630 --> 00:16:34,220
.لا بدّ أنّها أرادت أن أوقفها

173
00:16:34,850 --> 00:16:39,060
لكن لم يكن ممكنًا أن أتوقف
.بعد ما فعلته لي

174
00:16:40,880 --> 00:16:42,370
...لا

175
00:16:42,370 --> 00:16:44,400
.كنتُ أعلم أنّ هناك خطبًا في ميكو

176
00:16:45,030 --> 00:16:46,990
.كانت غلطتي أنّني سايرتُها

177
00:16:47,950 --> 00:16:49,770
.أواصل اختلاق الأعذار

178
00:16:50,190 --> 00:16:51,810
.أنا تافه

179
00:16:53,990 --> 00:16:56,660
ما الذي كان عليّ فعله؟

180
00:16:56,660 --> 00:17:00,270
ما الذي تريده ميكو الآن؟

181
00:17:00,600 --> 00:17:02,420
ما هو الصواب؟

182
00:17:03,050 --> 00:17:05,550
.هناك الكثير يشغلني

183
00:17:10,750 --> 00:17:16,560
،بعيدًا عن موضوع ما الصواب
ما الذي تريده أنت حقًا؟

184
00:17:16,560 --> 00:17:21,020
.أريد أن أسمع ما لدى ميكو لتقوله

185
00:17:23,150 --> 00:17:29,240
،المراهقة فترة مشاعر متضاربة
.خصوصًا للفتيات

186
00:17:29,650 --> 00:17:31,850
.مثل كعكة الميل-فوي تلك

187
00:17:32,820 --> 00:17:37,320
يصعب عليك التعبير عن
.كلّ تلك المشاعر الجيّاشة

188
00:17:37,320 --> 00:17:40,040
.تصبح عبئًا ثقيلًا أحيانًا فتسحقك

189
00:17:40,040 --> 00:17:43,760
لذا امنحها وقتًا وابقَ بجانبها

190
00:17:43,760 --> 00:17:46,130
.حتّى تنظم مشاعرها

191
00:17:56,510 --> 00:17:59,300
.هيّا، ستذوب المثلجات

192
00:17:59,300 --> 00:18:00,520
.صحيح

193
00:18:00,520 --> 00:18:02,320
.شكرًا

194
00:18:08,320 --> 00:18:09,860
!أخي

195
00:18:09,860 --> 00:18:12,610
أين لباسي الرياضي؟

196
00:18:12,610 --> 00:18:14,920
!لم تُخرجي الغسيل

197
00:18:14,920 --> 00:18:16,380
!وضعتُه في المجفف

198
00:18:16,380 --> 00:18:17,740
.سأغادر الآن

199
00:18:18,620 --> 00:18:20,380
ماذا؟ ستغادر بالفعل؟

200
00:18:26,680 --> 00:18:28,010
.حسنًا

201
00:18:40,140 --> 00:18:42,910
ربّما غادرت بالفعل؟

202
00:18:46,100 --> 00:18:51,610
"ميكو"

203
00:19:12,760 --> 00:19:14,100
...ميكو

204
00:19:21,680 --> 00:19:24,180
"ملغى - ملغى"
ما الخطب يا ميكو؟ -هل أنت في المنزل؟-

205
00:19:47,410 --> 00:19:49,830
...عـ-عفوًا

206
00:19:52,940 --> 00:19:54,000
!أساغي-كن؟

207
00:19:54,000 --> 00:19:56,850
!ما الخطب؟ أنت لا تتحدث معي عادة

208
00:19:56,850 --> 00:19:59,290
...نعم، لا، نعم، أعني

209
00:20:01,290 --> 00:20:05,270
هل تعرفين حال ميكو اليوم؟

210
00:20:06,350 --> 00:20:10,940
قالت هذا الصباح أنّها ستبقى
.في البيت بسبب حمى

211
00:20:11,480 --> 00:20:14,470
حـ-حقًا؟

212
00:20:14,470 --> 00:20:16,990
ألم تخبرك؟

213
00:20:16,990 --> 00:20:18,340
.لم تفعل

214
00:20:18,780 --> 00:20:22,780
.إنّها لا تردّ على مكالماتي  أيضًا

215
00:20:24,550 --> 00:20:28,000
لِم قد تتجاهل مكالماتك؟

216
00:20:28,000 --> 00:20:37,630
"أوهاغي"

217
00:20:29,590 --> 00:20:31,910
.انتهى... أمري

218
00:20:31,910 --> 00:20:34,680
!هل حدث شيء لميكو؟

219
00:20:34,680 --> 00:20:37,630
.لا، لا أظن أنّ الأمر كذلك

220
00:20:39,220 --> 00:20:45,640
"ميكو"

221
00:20:43,110 --> 00:20:45,320
ناتشان؟ ما الأمر؟

222
00:20:45,320 --> 00:20:46,630
!مـ-مـ-ميكو

223
00:20:46,630 --> 00:20:47,700
هل أنت بخير؟ هل أنت حيّة؟

224
00:20:47,700 --> 00:20:48,690
هل أستدعي الإسعاف؟

225
00:20:48,690 --> 00:20:50,150
!عليّ فعل ذلك! سأفعل

226
00:20:50,150 --> 00:20:52,000
.مهلًا، مهلًا

227
00:20:52,000 --> 00:20:53,850
ما الخطب؟ ماذا يحدث؟

228
00:20:53,850 --> 00:20:55,690
.أنا بخير، أنا بخير

229
00:20:55,690 --> 00:20:58,200
.مجرّد حمى بسيطة

230
00:20:58,200 --> 00:21:00,780
.سأعود إلى المدرسة غدًا

231
00:21:00,780 --> 00:21:05,330
.مطمئن، أرحتني

232
00:21:05,330 --> 00:21:11,370
كان أساغي-كن قلقًا جدًا عليك
!لدرجة أنّه تحدث إليّ

233
00:21:11,370 --> 00:21:13,150
!وهو لا يفعل ذلك عادة

234
00:21:13,150 --> 00:21:15,550
.نعم، حسنًا

235
00:21:15,550 --> 00:21:16,850
.آسفة

236
00:21:16,850 --> 00:21:18,630
.أخبريه أنّني بخير

237
00:21:19,260 --> 00:21:21,420
.حسنًا. اعتني بنفسك

238
00:21:21,960 --> 00:21:24,900
.أساغي-كن، ميكو بخير

239
00:21:28,550 --> 00:21:30,560
!أساغي-كن؟

240
00:21:37,660 --> 00:21:40,770
ماذا تقصد أنّها بخير؟

241
00:21:42,490 --> 00:21:43,590
...صوتها

242
00:21:45,410 --> 00:21:48,180
!ذلك صوتها بعد أن كانت تبكي

243
00:21:49,830 --> 00:21:52,030
...أنا

244
00:21:54,710 --> 00:21:56,470
!أبكيتُها

245
00:21:57,710 --> 00:21:59,960
يتبع

246
00:23:29,970 --> 00:23:44,990
الحلقة القادمة
يعانقني صديق طفولتي

247
00:23:34,240 --> 00:23:35,930
!أخي يركض

248
00:23:35,930 --> 00:23:40,400
الحلقة القادمة من "أريد إنهاء لعبة
.الحبّ": يعانقني صديق طفولتي

249
00:23:40,400 --> 00:23:42,780
!اركض! اركض يا أخي