1
00:00:01,660 --> 00:00:03,370
ما الأمر هذه المرّة؟

2
00:00:03,680 --> 00:00:06,450
لا تقولي لي بأنّكِ تحاولين تجنيدنا من جديد

3
00:00:09,580 --> 00:00:10,710
سررتُ بلقائكِ

4
00:00:12,460 --> 00:00:14,710
ماذا؟

5
00:00:14,960 --> 00:00:18,840
"إن كنت في بلد، فافعل ما يفعل أهلها"
لديكم مقولة مشابهة في اليابان، صحيح؟

6
00:00:19,240 --> 00:00:20,890
من المهمّ التحلّي بآداب السُّلوك

7
00:00:21,480 --> 00:00:24,580
"أجل، لكن لا أحد يقول "سررتُ بلقائك

8
00:00:24,640 --> 00:00:26,140
ماذا؟ حقّاً؟

9
00:00:26,460 --> 00:00:29,690
لكن أخبرني ذلك الرّاهب بأنّها
!كانت تحيّة عاديّة

10
00:00:30,040 --> 00:00:32,150
ولماذا أنتِ هنا فعليّاً؟

11
00:00:32,600 --> 00:00:36,690
-بالطبع، لتجنيدك كمُوحِّدة

12
00:00:38,740 --> 00:00:40,780
بالأحرى، لا أستطيع

13
00:00:41,620 --> 00:00:43,030
ماذا؟

14
00:00:44,960 --> 00:00:47,160
آسف بشأن كلّ شيء يا جدّتي

15
00:00:47,620 --> 00:00:50,520
لكن لا يسعني سوى أن أحبّ فانغارد

16
00:00:51,980 --> 00:00:55,250
تمكّنتُ من اللّقاء بأشخاص كُثُر
رائعين بفضلكِ يا جدّتي

17
00:00:56,120 --> 00:00:57,630
أنا مَدين لكِ بالكثير

18
00:00:59,800 --> 00:01:03,430
...أتتنصّت عليّ؟ لطالما اتّصفت بالذّوق السيّئ

19
00:01:04,660 --> 00:01:05,680
يا ماسانوري

20
00:02:45,340 --> 00:02:47,410
ما هذه الرّسالة؟

21
00:02:50,940 --> 00:02:51,790
!هنا

22
00:02:53,540 --> 00:02:55,750
!يا للهول! إنّه رابط غريب ما

23
00:02:55,900 --> 00:02:56,980
!ماذا؟

24
00:02:59,140 --> 00:03:02,090
!هذه مُصيبة! لا أستطيع حذفه

25
00:03:02,180 --> 00:03:03,140
مرحباً

26
00:03:05,240 --> 00:03:07,890
كيف حالكِ يا هالونا ولكر؟

27
00:03:13,200 --> 00:03:14,360
!ما هذا؟

28
00:03:15,280 --> 00:03:18,150
سررتُ بلقائكِ. اسمي غي

29
00:03:18,700 --> 00:03:19,780
أنا ذكاء اصطناعي

30
00:03:20,400 --> 00:03:21,490
ذكاء اصطناعي؟

31
00:03:22,100 --> 00:03:25,620
أجل، وأنا هنا لأنّني أردتُ التكلُّم معكِ

32
00:03:26,360 --> 00:03:29,910
لماذا؟ لماذا تريدين التكلّم معي؟

33
00:03:30,240 --> 00:03:33,080
هذا لأنّني أريد مُنازلتكِ بالبِطاقات

34
00:03:33,360 --> 00:03:35,590
نِزال بالبِطاقات؟ -
أجل -

35
00:03:36,280 --> 00:03:39,300
هل تريدين أن تلعبي فانغارد معي؟

36
00:03:45,280 --> 00:03:46,430
!سأبدأ بالأكل

37
00:03:50,800 --> 00:03:52,190
!هذا لذيذ جدّاً

38
00:03:52,480 --> 00:03:56,730
.كفّي عن الخروج مع بالغين سيّئين
يؤثّرون عليكِ بشكل سلبيّ ليس إلّا

39
00:03:57,000 --> 00:04:00,740
ظننتُ أنَّ الرُّهبان يُعَدُّون رجال دين في اليابان

40
00:04:01,040 --> 00:04:04,950
لا أعلم حتّى ما إن كان كائناً بشريّاً
ناهيكِ عن رجُل دين

41
00:04:05,860 --> 00:04:07,830
حسناً، لماذا أتيتِ؟

42
00:04:08,080 --> 00:04:11,460
!كي أجنّدكِ في المُوحّدين بالطبع

43
00:04:11,960 --> 00:04:13,250
لكن لماذا أنا؟

44
00:04:13,300 --> 00:04:15,080
!لأنّكِ موهوبة

45
00:04:15,170 --> 00:04:17,960
...مُجاملة لطيفة، لكن

46
00:04:18,120 --> 00:04:20,800
لا أنوي أن أصبح مُوحِّدة

47
00:04:20,900 --> 00:04:23,680
حقّاً؟ حسناً، سأغيّر الموضوع

48
00:04:23,740 --> 00:04:24,590
بهذه السّرعة؟

49
00:04:24,900 --> 00:04:27,760
المعذرة، كيف حال أورارا؟

50
00:04:27,820 --> 00:04:29,060
ماذا تقصدين؟

51
00:04:30,380 --> 00:04:34,770
هل ذكرَتْ شيئاً عن الرّغبة في
العودة إلى المُوحّدين؟

52
00:04:34,960 --> 00:04:37,820
أم ذكرَتْ شيئاً عن الرّغبة في رؤية أحد؟

53
00:04:37,900 --> 00:04:39,690
هذا هو السّبب الحقيقيّ إذاً؟

54
00:04:40,500 --> 00:04:41,860
!لـ-لا، ليس كذلك

55
00:04:41,920 --> 00:04:44,740
!بجدّية! فكّرتُ فقط في السّؤال بصورة عفويّة

56
00:04:45,120 --> 00:04:49,080
،كنتُ أتساءل لماذا أردتِ المجيء معي
لكن الآن عرفتُ السّبب

57
00:04:49,120 --> 00:04:51,620
!أقول لكِ أنَّ الأمر ليس كذلك

58
00:04:51,680 --> 00:04:53,410
!قطعتُ علاقتي مع أورارا بالفعل

59
00:04:53,480 --> 00:04:56,000
!أنا هنا فقط بطلب من جينكي لتوظيفك

60
00:04:57,400 --> 00:04:59,130
أظنّني سأتوقّف عند هذا الحدّ

61
00:04:59,280 --> 00:05:01,000
!ما هذه النّبرة؟

62
00:05:02,200 --> 00:05:04,760
أنا متفاجئة... إنّها امرأة عاديّة

63
00:05:06,020 --> 00:05:08,350
تغيّرت كثيراً يا تويا

64
00:05:08,840 --> 00:05:12,390
كنتَ مُدمِّراً مثلي

65
00:05:12,780 --> 00:05:15,390
أجل، أبكيتُهم

66
00:05:15,660 --> 00:05:17,900
رغم ذلك، قَبِلَني أولئك الأشخاص

67
00:05:18,740 --> 00:05:22,070
قالوا لي بأنّني حليف، صديق

68
00:05:22,720 --> 00:05:24,820
!أنت تُبكيني

69
00:05:24,880 --> 00:05:27,870
تعلم بأنّني أعتبرك حتّى أنت صديقاً

70
00:05:29,280 --> 00:05:32,830
كنتَ هناك لأجلي عندما كنتُ
في أسوأ حالاتي

71
00:05:34,240 --> 00:05:38,420
تلك الأيّام الّتي قضيتُها معك... أنقذتني حقّاً

72
00:05:39,640 --> 00:05:41,670
ارتكبتُ أخطاء كثيرة معك

73
00:05:42,120 --> 00:05:43,050
...لهذا السّبب

74
00:05:45,000 --> 00:05:46,680
لنُقاتل يا ماسانوري

75
00:05:48,620 --> 00:05:52,010
آسف، لكن لا أحمل مجموعة أوراقي معي

76
00:05:53,740 --> 00:05:57,100
لا تحمل مجموعة أوراقك؟
لا يمكننا القتال إذاً؟

77
00:05:57,180 --> 00:05:58,480
!لا، لا يمكننا

78
00:05:59,440 --> 00:06:00,440
!أنت تكذب

79
00:06:00,580 --> 00:06:04,100
مهلاً، لا حاجة للهلع فقط لكوننا
لا نستطيع القتال الآن

80
00:06:04,180 --> 00:06:06,570
فضلاً عن ذلك، نحن في وسط المعمعة

81
00:06:07,300 --> 00:06:11,870
في مهبِّ عاصفة شديدة سوف تبتلع
كلَّ المُقاتلين في العالم

82
00:06:14,600 --> 00:06:17,410
أنوي حسم النّتيجة معك عاجلاً أم آجلاً

83
00:06:17,800 --> 00:06:18,830
أطمئنك

84
00:06:19,020 --> 00:06:21,080
!أنت قلتَها! هذا وعد

85
00:06:21,720 --> 00:06:22,590
!إيِّاك أن تنسى

86
00:06:24,080 --> 00:06:28,840
أتعلم؟ لطالما عرفتُ ذلك، لكنّك
فريد من نوعك حقّاً

87
00:06:31,080 --> 00:06:32,600
قصص كراي؟

88
00:06:32,880 --> 00:06:34,100
!هذا صحيح

89
00:06:34,180 --> 00:06:38,100
أفضل شيء في فانغارد هو أنّ كلّ
الوحدات نابضة بالحياة في كراي

90
00:06:38,740 --> 00:06:42,110
الدراما بين الوحدات هو ما يجعل
!المعارك حماسيّة جدّاً

91
00:06:42,360 --> 00:06:46,150
أتّفق. أحبُّ قصص الوحدات أيضاً

92
00:06:46,220 --> 00:06:46,990
!أليس كذلك؟

93
00:06:47,220 --> 00:06:50,800
فمثلاً، تعتقدين بأنّ الدُّول الظلاميّة
،ظلاميّة فعلاً

94
00:06:50,900 --> 00:06:53,120
!لكنّها في حقيقة الأمر ظريفة

95
00:06:53,260 --> 00:06:56,870
أعشق رؤية كلّ تلك الوحوش والشّياطين
،في دولة سحريّة

96
00:06:56,960 --> 00:06:59,670
!وذلك الانطباع القوطيّ رائع للغاية

97
00:06:59,840 --> 00:07:04,420
إنّه وقت اللّيل دوماً، وكلّما اقتربتِ من
-منطقة المركز، ازدادت الظُّلمة

98
00:07:04,520 --> 00:07:05,960
!توقّفي

99
00:07:07,360 --> 00:07:09,340
سأسمع هذه القصّة في وقت لاحق

100
00:07:09,620 --> 00:07:12,390
هيّا، الشّمس غربت هنا بالفعل في الأرض

101
00:07:14,560 --> 00:07:15,760
هذا مُؤسف جدّاً

102
00:07:16,320 --> 00:07:18,770
حسناً، لنُنهِ هذا سريعاً

103
00:07:19,380 --> 00:07:20,440
سريعاً؟

104
00:07:20,540 --> 00:07:23,150
بالطبع، أقصد معركتنا

105
00:07:24,660 --> 00:07:28,280
سأريكِ مدى قوّة مجموعة ورق المُقنَّعات

106
00:07:32,340 --> 00:07:35,780
إذاً كنتِ جادّة بالفعل عندما قلتِ
بأنّكِ أردتِ تجنيدي

107
00:07:35,840 --> 00:07:37,540
!كنتُ كذلك بالطبع

108
00:07:37,660 --> 00:07:41,420
قد لا أبدو كذلك، لكنّني إحدى أجود المُوحِّدين

109
00:07:41,760 --> 00:07:45,790
أجل، أخبرَتْني أورارا. أنتِ عبقريّة، صحيح؟

110
00:07:46,160 --> 00:07:49,240
!أبداً! لستُ كذلك إطلاقاً

111
00:07:49,340 --> 00:07:51,200
هذا واضح من جبينكِ

112
00:07:51,720 --> 00:07:52,920
،رغم ذلك

113
00:07:53,040 --> 00:07:56,720
إنّها غالباً الشّخص المثاليّ لي
كي أتعوّد على مجموعة ورق المُقنَّعات

114
00:07:57,780 --> 00:08:00,280
هل المُوحِّدون يُشكِّلون تهديداً حقّاً؟

115
00:08:00,680 --> 00:08:03,100
يجب أن أحدِّد جوهر المسألة

116
00:08:04,380 --> 00:08:05,360
بالتأكيد

117
00:08:05,800 --> 00:08:06,570
لنُقاتل

118
00:08:07,180 --> 00:08:08,780
!لا فضّ فوكِ

119
00:08:10,780 --> 00:08:12,070
جذبت اهتمامك؟

120
00:08:13,320 --> 00:08:14,490
ميغومي تلك

121
00:08:15,140 --> 00:08:18,080
أنا مُهتمّة بالأخرى

122
00:08:18,160 --> 00:08:19,580
هالونا

123
00:08:20,240 --> 00:08:24,250
إنّها الفتاة الوحيدة الّتي أدهشَتْ موهبتُها
غي بما يكفي لجعلها ترغب في توظيفها

124
00:08:24,640 --> 00:08:29,000
عبقريّة أتممَت البرنامجَ كُلّه
في غضون ثلاثة أسابيع

125
00:08:29,800 --> 00:08:33,340
،إنّها الطفلة المُدلّلة للمُوحِّدين
فريق أُسِّسَ من الصّفر

126
00:08:34,600 --> 00:08:36,350
حسناً، فلنبدأ

127
00:08:41,280 --> 00:08:43,480
!انهض، فانغارد

128
00:08:48,440 --> 00:08:49,780
وحش القرون الحرجيّ، لوتّي

129
00:08:50,020 --> 00:08:51,910
وحش عين الشرّ، أوميناكيتي

130
00:08:52,060 --> 00:08:55,200
دوري. أركب وحش القرون الحرجيّ، كاريس

131
00:08:55,580 --> 00:08:56,620
دوري

132
00:08:57,240 --> 00:08:59,460
أركب وحش عين الشرّ، أوميناكروغ

133
00:08:59,680 --> 00:09:01,210
بمهارته، أسحب بطاقة

134
00:09:01,980 --> 00:09:05,050
مهارة أوميناكروغ. من البِطاقات الخمس
،العليا في مجموعة أوراقي

135
00:09:05,740 --> 00:09:08,720
أضيف تنّين عين الشرّ، أوميناغروزيو، إلى يدي

136
00:09:09,420 --> 00:09:11,390
تبدو هذه وحدة شقيّة جدّاً

137
00:09:11,440 --> 00:09:12,800
أليست ظريفة؟

138
00:09:13,200 --> 00:09:15,640
ظـ-ظريفة؟ حقّاً؟

139
00:09:15,820 --> 00:09:17,310
لستِ تفهمين

140
00:09:17,700 --> 00:09:20,650
كان هذا في الأصل هرّاً صغيراً جريحاً

141
00:09:21,060 --> 00:09:24,320
شكّلَتْ هذه الهررة الضّعيفة قطيعاً
وعاشتْ في الظِّلال

142
00:09:24,680 --> 00:09:26,380
-لكن قُتِلَ أصدقاؤها

143
00:09:26,480 --> 00:09:28,450
!فهمت! فهمت، حسناً؟

144
00:09:30,180 --> 00:09:31,870
لنتكلّم في وقت لاحق

145
00:09:33,860 --> 00:09:35,450
أهاجم بواسطة أوميناكروغ

146
00:09:36,000 --> 00:09:36,830
لا حِراسة

147
00:09:37,520 --> 00:09:38,660
انتهى دوري

148
00:09:38,960 --> 00:09:39,960
إنّه دوري

149
00:09:40,680 --> 00:09:42,330
أركب وحش القرون الحرجيّ، لاتيس

150
00:09:42,860 --> 00:09:45,170
بمهارته، أستدعي آلبين من مجموعة أوراقي

151
00:09:45,600 --> 00:09:46,710
أهاجم بواسطة لاتيس

152
00:09:47,220 --> 00:09:47,960
سوف أحرس

153
00:09:48,440 --> 00:09:49,590
أهاجم بواسطة آلبين

154
00:09:50,140 --> 00:09:51,090
لا حِراسة

155
00:09:51,540 --> 00:09:52,720
انتهى دوري

156
00:09:53,540 --> 00:09:56,560
انظري كيف تشتبك وحداتنا المُفضَّلة بشراسة

157
00:09:56,860 --> 00:09:59,350
!معارك البِطاقات تُثيرني دوماً

158
00:10:00,840 --> 00:10:05,110
هالونا، لستِ من نوع المُقاتلين الّذين
توقّعتُهم من المُوحّدين

159
00:10:05,420 --> 00:10:07,730
حقّاً؟ -
أجل -

160
00:10:08,300 --> 00:10:11,910
أخبريني، لماذا انضممتِ للمُوحّدين؟

161
00:10:12,460 --> 00:10:14,280
!لأنّ غي اختارتني

162
00:10:14,700 --> 00:10:15,700
غي؟

163
00:10:16,640 --> 00:10:21,160
في الحقيقة، لم تسنح لي فُرصة للّعب
مع أطفال في مثل سنّي

164
00:10:21,900 --> 00:10:26,290
لطالما تمنّيتُ مقاتلاً يبتسم مثلما أبتسم

165
00:10:26,900 --> 00:10:30,940
!آنذاك... أمستْ غي صديقتي

166
00:10:32,520 --> 00:10:33,550
دوري

167
00:10:34,620 --> 00:10:37,060
أركب وحش عين الشرّ، أوميناولز

168
00:10:37,300 --> 00:10:40,540
بمهارته، أنقل زِناداً حاسماً من مجموعة
،أوراقي إلى الصّول

169
00:10:40,660 --> 00:10:41,760
!وأسحب بطاقة

170
00:10:42,520 --> 00:10:44,690
!أهاجم بواسطة أوميناولز

171
00:10:45,160 --> 00:10:46,110
لا حِراسة

172
00:10:46,340 --> 00:10:47,360
تفقُّد الحافز

173
00:10:48,100 --> 00:10:50,320
إنّه زِناد سحب. أسحب بطاقة

174
00:10:51,280 --> 00:10:52,070
انتهى دوري

175
00:10:53,140 --> 00:10:55,580
هل يمكنكِ الوثوق بغي هذه حقّاً؟

176
00:10:55,660 --> 00:10:56,450
ماذا؟

177
00:10:57,000 --> 00:10:59,160
،أعرف بأنّها تريد المُباراة المُطلَقة

178
00:10:59,340 --> 00:11:02,830
لكن ماذا لو كانت تستخدمكِ فقط
من أجل تحقيق هدفها؟

179
00:11:03,480 --> 00:11:05,290
أنتِ لا تفهمين فحسب، أليس كذلك؟

180
00:11:05,800 --> 00:11:08,300
أرشدَتْني غي عبر طريق الصّواب

181
