1
00:00:21,600 --> 00:00:24,310
والآن، اللّحظة الّتي كنتم تنتظرونها

2
00:00:24,360 --> 00:00:27,980
إنّها جلسة سؤال وجواب مع ضيفنا
الخاصّ ميتشيرو هازاما

3
00:00:28,240 --> 00:00:30,980
من يريد أن يطرح عليه سؤالاً؟ -
!أنا -

4
00:00:31,420 --> 00:00:32,230
رائع

5
00:00:32,840 --> 00:00:35,190
حسناً، أنت يا من في المقدّمة

6
00:00:35,380 --> 00:00:39,030
في الواقع، يقول النّاس بأنّني ضعيف

7
00:00:39,340 --> 00:00:41,360
كيف يمكنني أن أصبح قويّاً؟

8
00:00:43,580 --> 00:00:45,640
التقِ بشخص تريد هزيمته

9
00:00:49,120 --> 00:00:53,540
ذلك سيُحفّزك على البحث ويمنحك
القوّة عند الشّدائد

10
00:00:57,180 --> 00:00:58,380
...لا أملك أحداً

11
00:00:58,500 --> 00:00:59,540
ماذا عنّي؟

12
00:01:07,180 --> 00:01:08,350
هل تحفّزت الآن؟

13
00:01:08,580 --> 00:01:09,680
!لكن لا أستطيع

14
00:01:09,900 --> 00:01:11,820
لا تقلق، يمكنك فعل هذا

15
00:01:18,020 --> 00:01:20,860
المستقبل... هنا

16
00:01:26,380 --> 00:01:27,860
!كم ميتشيرو لطيف

17
00:01:27,920 --> 00:01:30,660
!منحَ هذا الفتى حلماً

18
00:01:31,420 --> 00:01:32,830
!تصفيق حارّ

19
00:01:35,000 --> 00:01:36,360
انتظرني من فضلك

20
00:03:21,040 --> 00:03:23,370
سأستعدّ هناك

21
00:03:26,280 --> 00:03:27,040
يو-يو

22
00:03:28,400 --> 00:03:29,660
لنستعدّ معاً

23
00:03:30,600 --> 00:03:32,880
تستطيع البطاقات تهدئة أعصابك، صحيح؟

24
00:03:33,800 --> 00:03:34,580
!أجل

25
00:03:42,500 --> 00:03:44,800
هدأت الأمور هنا حقّاً

26
00:03:44,920 --> 00:03:46,220
معك حقّ

27
00:03:48,620 --> 00:03:50,350
...هذا مؤلم

28
00:03:50,420 --> 00:03:51,440
ما الأمر؟

29
00:03:52,040 --> 00:03:55,480
ما زال جسدي يؤلمني من الحافلة
اللّيليّة الّتي استقللتُها

30
00:03:55,520 --> 00:03:57,230
إلى أين ذهبت؟

31
00:03:57,440 --> 00:03:58,600
إلى هاكاتا فقط

32
00:03:58,640 --> 00:03:59,570
!هاكاتا؟

33
00:04:00,040 --> 00:04:02,450
ذهبتُ لخوض معركة بِطاقات مع موندو

34
00:04:04,280 --> 00:04:06,450
لا يسعنى سوى البحث عن مُحاربين أقوياء

35
00:04:07,460 --> 00:04:09,200
هكذا كنتُ دوماً

36
00:04:12,740 --> 00:04:16,380
بعد معركتي مع فريق دايبريك، خضتُ رحلة طويلة

37
00:04:24,560 --> 00:04:28,760
كنتُ أينما أذهب، إذا سمعتُ إشاعات
عن مُحارب قويّ، أهرع لرؤيته

38
00:04:28,940 --> 00:04:33,060
بعد المعركة، كنتُ أتوجّه إلى البلدة
التّالية بحثاً عن مُحارب آخر

39
00:04:33,920 --> 00:04:35,560
ظللتُ أكرّر ذلك فحسب

40
00:04:40,760 --> 00:04:42,190
،ثمّ ذات يوم

41
00:04:42,860 --> 00:04:46,100
سمعتُ عن شخص كان يبحث عن مُحاربين أقوياء

42
00:04:48,580 --> 00:04:53,210
كان يجمع أفضل المُحاربين في الدّولة
لإقامة بطولة يختار فيها الأفضل

43
00:04:53,560 --> 00:04:56,500
من بين أولئك المُقاتلين ميتشيرو هازاما العظيم

44
00:04:56,640 --> 00:04:59,340
ومُحاربون أقوياء آخرون كنتُ قد سمعتُ عنهم

45
00:04:59,820 --> 00:05:03,760
لا أعلم كيف وجدَني، لكن ظهرَ
ذات يوم حاملاً دعوة معه

46
00:05:06,160 --> 00:05:09,390
،كنتُ قد شككتُ به، لكن إن صحّت الإشاعات

47
00:05:09,440 --> 00:05:12,880
ستكون فُرصة ذهبيّة لمواجهة مُقاتلين أقوياء

48
00:05:13,980 --> 00:05:15,690
هكذا وصلتَ إلى هنا إذاً

49
00:05:15,900 --> 00:05:18,020
بالطبع، أردتُ رؤيتكم أيضاً

50
00:05:18,780 --> 00:05:21,980
لحسن الحظّ، كلّ الّذين واجهتُهم
في ديلوكس كانوا أقوياء

51
00:05:22,560 --> 00:05:25,280
ربحتُ كلّ المعارك، لكن كان من
الممكن أن يكون العكس

52
00:05:25,420 --> 00:05:27,450
كانت كلّها معارك مُتّقدة

53
00:05:28,100 --> 00:05:29,160
يسرّني أنّني أتيت

54
00:05:30,820 --> 00:05:34,370
كانت ميغومي قويّة أيضاً. قد تهزمني
!في المرّة المُقبلة

55
00:05:41,080 --> 00:05:42,090
،حسناً إذاً

56
00:05:42,780 --> 00:05:44,920
سوف أذهب لهزيمة رايكا كوشيبا

57
00:05:45,440 --> 00:05:49,050
يذكّرني بنفسي قليلاً، لذا سوف
أتطلّع قُدماً لذلك

58
00:05:49,700 --> 00:05:51,890
آسف لأنّك لن تأخذ بثأرك

59
00:05:54,460 --> 00:05:56,310
!إطلاقاً، حظّاً سعيداً

60
00:05:56,460 --> 00:06:00,660
رغم ذلك، أردتُ أن أكون أوّل
من يهزم ميتشيرو هازاما

61
00:06:02,580 --> 00:06:04,230
سوف تهزمه،حيح؟

62
00:06:07,180 --> 00:06:08,320
...تويا

63
00:06:10,400 --> 00:06:12,330
سأراك في النّهائي

64
00:06:12,350 --> 00:06:13,080
!أكيد

65
00:06:26,040 --> 00:06:26,970
...ميتشيرو

66
00:06:28,260 --> 00:06:29,720
قطعتُ كلّ هذه المسافة

67
00:06:31,220 --> 00:06:33,720
!يحصل ميتشيرو هازاما على الجائزة الأولى

68
00:06:34,060 --> 00:06:37,270
!من يستطيع في العالم إيقافه؟

69
00:06:38,680 --> 00:06:41,230
شكراً... على القتال

70
00:06:41,960 --> 00:06:44,400
ربحَ ذاك الشّخص من جديد

71
00:06:45,380 --> 00:06:47,980
لم يصل مايدا للفريق الأوّل، صحيح؟

72
00:06:48,680 --> 00:06:50,570
...كانت بطولته الأخيرة

73
00:06:50,660 --> 00:06:52,820
ليس باليد حيلة. فقد خسِر

74
00:06:53,000 --> 00:06:55,800
حريّ بنا أن نواظب على مستوانا
وإلّا سوف نسقط أيضاً

75
00:06:58,420 --> 00:06:59,620
مايدا سينباي

76
00:07:00,420 --> 00:07:01,250
!مرحباً

77
00:07:01,680 --> 00:07:04,840
!بالتّوفيق لك يا رايكا. أشجّعك

78
00:07:05,120 --> 00:07:06,590
شكراً جزيلاً لك

79
00:07:07,020 --> 00:07:07,520
!إلى اللّقاء

80
00:07:17,880 --> 00:07:19,890
شكراً لك... على المعركة

81
00:07:20,080 --> 00:07:21,120
مُبهر

82
00:07:21,140 --> 00:07:23,230
لديه عقليّة فولاذيّة

83
00:07:23,760 --> 00:07:25,270
لا تريد أن تسقط؟

84
00:07:26,620 --> 00:07:27,990
!إذاً فُز ببساطة

85
00:07:30,380 --> 00:07:32,450
...فُز... فُز

86
00:07:32,940 --> 00:07:35,530
!فُز... فُز... فُز

87
00:07:38,560 --> 00:07:42,040
!عليّ أن... أستمرّ في الفوز

88
00:07:44,660 --> 00:07:48,420
هكذا انتهزتُ هذه الفُرصة

89
00:07:49,820 --> 00:07:53,840
تذكّرني معاركك بطريقتي في
القتال في تلك الأيّام

90
00:07:58,400 --> 00:08:00,230
لستُ مهتمّاً بذلك

91
00:08:00,860 --> 00:08:01,850
...أنا

92
00:08:02,980 --> 00:08:04,810
كلّ ما يهمّني هو النّتائج

93
00:08:06,120 --> 00:08:07,150
!يو-يو

94
00:08:07,320 --> 00:08:08,360
!رِفاق

95
00:08:09,020 --> 00:08:10,400
اقترب الوقت

96
00:08:10,460 --> 00:08:11,900
!أجل

97
00:08:13,380 --> 00:08:15,410
لست مع أورارا؟

98
00:08:15,580 --> 00:08:16,330
ماذا؟

99
00:08:19,540 --> 00:08:21,250
لا أحد هنا؟

100
00:08:22,100 --> 00:08:25,560
سيبدأ نصف النّهائي الأوّل
بعد 15 دقيقة

101
00:08:25,600 --> 00:08:28,090
!يا للهول! عليّ الذّهاب إلى هناك بسرعة

102
00:08:31,900 --> 00:08:32,590
ماذا؟

103
00:08:33,100 --> 00:08:35,600
...هذا مختلف قليلاً عن المعتاد

104
00:08:37,020 --> 00:08:37,970
!أورارا

105
00:08:38,460 --> 00:08:41,560
ميتشيرو وتايزو... لماذا أنتما هنا؟

106
00:08:42,440 --> 00:08:45,230
هل هذا خاطئ؟ نحن هنا لمشاهدة المعارك

107
00:08:45,400 --> 00:08:47,310
رأيناكِ تُقاتلين أيضاً يا أورارا

108
00:08:47,380 --> 00:08:49,150
شكراً لك

109
00:08:49,360 --> 00:08:53,800
أذكر بأنّكِ قلتِ أنّكِ أخذتِ إجازة بضعة
أيّام لأنّكِ خطّطتِ بلوغ النّهائي

110
00:08:54,400 --> 00:08:55,740
!صه

111
00:08:56,940 --> 00:09:00,200
المعذرة... أين يو-يو والآخرون؟

112
00:09:06,160 --> 00:09:07,540
...أنا في الجانب الخاطئ

113
00:09:07,620 --> 00:09:08,710
ستبدأ

114
00:09:09,180 --> 00:09:10,590
لماذا هي...؟

115
00:09:12,940 --> 00:09:16,740
التّالي، رايكا كوشيبا وتويا إيباتا

116
00:09:16,860 --> 00:09:19,760
!سيتنافسان في نصف النّهائي الأوّل

117
00:09:24,500 --> 00:09:25,810
بالتّوفيق

118
00:09:26,200 --> 00:09:28,310
أجل، بالتّوفيق لك أيضاً

119
00:09:47,020 --> 00:09:49,010
انهض، فانغارد

120
00:09:49,440 --> 00:09:50,760
فارس القوس السّماوي، قاعدة

121
00:09:51,220 --> 00:09:52,760
شباب يحذون حذوّ الآخرين، يوث

122
00:09:53,420 --> 00:09:54,220
أسحب

123
00:09:54,800 --> 00:09:56,770
أركب حصن وينتهي دوري

124
00:09:57,080 --> 00:09:58,020
دوري

125
00:09:58,900 --> 00:09:59,640
أسحب

126
00:10:00,020 --> 00:10:03,900
"أركب "عازم على التحرُّر، يوث
بمهارته، أسحب بطاقة

127
00:10:05,500 --> 00:10:06,820
أهاجم بواسطة يوث

128
00:10:07,020 --> 00:10:07,900
لا حِراسة

129
00:10:09,880 --> 00:10:10,900
انتهى دوري

130
00:10:11,260 --> 00:10:12,280
إنّه دوري

131
00:10:12,640 --> 00:10:13,780
أركب روكس

132
00:10:14,500 --> 00:10:19,330
،بمهارته، أكشف عن اثنتين من غريد 3
وأستدعي دارك سترين من مجموعة بطاقاتي

133
00:10:19,700 --> 00:10:20,960
أهاجم بواسطة روكس

134
00:10:21,520 --> 00:10:22,290
حِراسة

135
00:10:22,720 --> 00:10:24,170
أهاجم بواسطة دارك سترين

136
00:10:24,820 --> 00:10:25,670
لا حِراسة

137
00:10:27,620 --> 00:10:28,840
انتهى دوري

138
00:10:29,120 --> 00:10:30,170
إنّه دوري

139
00:10:30,980 --> 00:10:32,800
أركب فارس النّور العارم، يوث

140
00:10:33,300 --> 00:10:35,550
بمهارته، أستدعي فريدي من مجموعة بطاقاتي

141
00:10:35,980 --> 00:10:38,800
أستدعي شنايزل. بمهارته، يكتسب قوّة +5000

142
00:10:39,260 --> 00:10:41,350
أنظر إلى البطاقات الخمسة الأعلىئ
،في مجموعة أوراقي

143
00:10:42,160 --> 00:10:44,310
وأضيف يوثبيرك "ريفولفورم: غاست" إلى يدي

144
00:10:44,940 --> 00:10:46,610
أستدعي اثنتين من المُسكِّن

145
00:10:47,140 --> 00:10:48,320
أهاجم بواسطة يوث

146
00:10:48,800 --> 00:10:49,570
حِراسة

147
00:10:50,000 --> 00:10:51,240
أهاجم بواسطة فريدي

148
00:10:51,660 --> 00:10:52,740
لا حِراسة

149
00:10:53,560 --> 00:10:55,820
أهاجم بواسطة... شنايزل

150
00:10:56,280 --> 00:10:57,450
لا حِراسة

151
00:11:00,840 --> 00:11:02,120
إنّه يقوم بتحرّكاته

152
00:11:02,840 --> 00:11:05,380
مجموعة أوراقك مُكدّسة بغريد 3

153
00:11:05,900 --> 00:11:07,840
أعلم أنّه من الصّعب عليك أن تحرس

154
00:11:08,500 --> 00:11:12,300
أعتقد نحن مُتشابهان من حيث أنّك
تعرف كيف أحبُّ أن ألعب، صحيح؟

155
00:11:12,780 --> 00:11:13,800
نحن لسنا مُتشابهين

156
00:11:16,460 --> 00:11:18,220
كلانا فارسان، صحيح؟

157
00:11:19,380 --> 00:11:20,350
آسف

158
00:11:20,980 --> 00:11:25,310
كلّ ما في الأمر أنّك تذكّرني بنفسي
عندما كنتُ مهووساً بالفوز

159
00:11:25,800 --> 00:11:30,360
في تلك الأيّام، كنتُ أتوق لإثبات
قوّتي من خلال هزيمة الجميع

160
00:11:31,300 --> 00:11:35,320
لكن بعدها أدركتُ بأنّني لم أرد
أن أصبح أقوى من أجل الفوز

161
00:11:37,640 --> 00:11:40,280
أردتُ أن أكون قويّاً من أجل أن أكون قويّاً

162
00:11:41,740 --> 00:11:43,920
--لستُ أفهم -
ليس عليك ذلك -

163
00:11:45,340 --> 00:11:49,500
الشّيء الوحيد الّذي أنا مُتيقّن منه
الآن هو أنّني أتوق لأصبح أقوى

164
00:11:50,040 --> 00:11:51,000
!إنّه دوري

165
00:11:51,600 --> 00:11:53,720
!أركب حاكم الذّروة، باستيون

166
00:11:54,960 --> 00:11:57,760
،بمهارته، أكشف عن ثلاثة من غريد 3 في يدي

167
00:11:58,140 --> 00:12:00,600
!وأسحب بطاقة وأستدعي ألدين

168
00:12:00,780 --> 00:12:03,520
بمهارته، أستدعي رافلوك وأسحب بطاقتين

169
00:12:04,060 --> 00:12:08,270
بمهارة رافلوك، أضعه في الصّول وتكتسب
دارك سترين قوّة +10000

170
00:12:08,940 --> 00:12:12,030
أهاجم بواسطة ألدين! بمهارته، يكتسب
!قوّة +5000

171
00:12:12,400 --> 00:12:13,150
!حِراسة

172
00:12:13,620 --> 00:12:14,900
!أُهاجم بواسطة باستيون

173
00:12:15,460 --> 00:12:16,150
!حِراسة

174
00:12:16,540 --> 00:12:17,740
التفقُّد الأوّل

175
00:12:18,200 --> 00:12:19,360
!غريد 3

176
00:12:19,740 --> 00:12:20,950
التفقُّد الثّاني

177
00:12:22,160 --> 00:12:23,410
!زِناد حاسم

178
00:12:24,020 --> 00:12:27,920
!يكتسب دارك سترين قوّة +10000 وحاسمة إضافيّة

179
00:12:28,480 --> 00:12:31,920
بمهارة باستيون، بما أنّني تلقّيتُ غريد 3
،في تفقُّد الحافز

180
00:12:32,100 --> 00:12:35,420
أضع ألدين في وضع الوقوف ويكتسب
!قوّة +10000

181
00:12:36,620 --> 00:12:39,300
!أُهاجم بواسطة... ألدين

182
00:12:39,840 --> 00:12:40,800
لا حِراسة

183
00:12:42,480 --> 00:12:45,180
!أُهاجم بواسطة... دارك سترين

184
00:12:46,600 --> 00:12:47,440
!لا حِراسة

185
00:12:48,740 --> 00:12:49,690
انتهى دوري

186
00:12:50,960 --> 00:12:52,400
ألحقتُ ضرراً بقيمة 4

187
00:12:53,580 --> 00:12:56,030
!هيّا، حان دورك

188
00:12:56,180 --> 00:12:58,110
!أرِني ما لديك

189
00:12:58,360 --> 00:13:01,840
!أرضِ... شوقي للقوّة

190
00:13:03,040 --> 00:13:05,080
أُرضيك؟

191
00:13:06,280 --> 00:13:07,120
!أبداً

192
00:13:08,120 --> 00:13:09,290
!دوري

193
00:13:10,920 --> 00:13:12,790
حان وقت تدمير السّماوات

194
00:13:13,180 --> 00:13:17,260
!"أركب... يوثبيرك "سكايفول آرمس

