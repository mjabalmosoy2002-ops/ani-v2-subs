1
00:00:01,890 --> 00:00:04,680
أنتِ مُحقة,تبدوان مُتماثلتيّن

2
00:00:04,680 --> 00:00:07,730
إذا قارنا بيّن عُمريّهما,أظنُ أنها مُجرد صِدفة

3
00:00:08,280 --> 00:00:10,280
هذا ما سوف يُفكّر به عادةً

4
00:00:10,280 --> 00:00:13,320
هل كان لديّها أي تعليقٍ على يوشينو؟

5
00:00:13,320 --> 00:00:15,740
كلا,قالت أنها لا تعلم شيئاً

6
00:00:16,520 --> 00:00:20,700
لكن,أستطيعُ معرفة شُعورك الآن,كيوتاكا

7
00:00:29,320 --> 00:00:31,060
ما الأمر؟

8
00:00:33,430 --> 00:00:38,640
ما الذي تفعله بي في مكانٍ كـ هذا؟,كيوتاكا سان,أنت تُبالغُ قليلاً

9
00:00:40,130 --> 00:00:43,020
كما توقعت,لديّكِ حُمى

10
00:00:44,300 --> 00:00:46,730
كشفتني,كيوتاكا سان

11
00:00:46,730 --> 00:00:48,000
لا يجبُ أن تُجهدِ نفسكِ

12
00:00:48,000 --> 00:00:49,020
كيوتاكا

13
00:00:50,980 --> 00:00:54,610
من الجيِدِ أنك لاحظت حُماها

14
00:00:54,610 --> 00:00:57,620
..لكن أن تضع جبينك على فتاةٍ بـ هذه الطريقة

15
00:00:57,620 --> 00:00:59,080
هذه قذارة

16
00:00:59,900 --> 00:01:05,250
آنو,لستُ أهتم لـ هذا,لكنني مسرورة

17
00:02:38,900 --> 00:02:42,200
المكان الذي أستطيعُ الأعتماد عليّك فيه

18
00:02:51,120 --> 00:02:53,560
آسفةٌ على هذا,كيوتاكا سان

19
00:02:53,560 --> 00:02:57,440
لا عليّكِ,ريّكا سان سمحت بـ مُغادرتنا

20
00:02:58,100 --> 00:03:01,700
سببتُ الكثير من المشاكل لـ مُديري في العمل الجُزئي

21
00:03:01,700 --> 00:03:04,770
أنتِ تبذّلين الكثير من الجُهد في عملكِ,آويّ تشان

22
00:03:04,770 --> 00:03:08,940
حسناً,لديّك الكثير من الفواتير التى يجبُ أن أدفعها بما أنني أعيشُ وحدي

23
00:03:08,940 --> 00:03:11,830
أيضاً,أنا أحبّ العمل

24
00:03:11,830 --> 00:03:14,750
لكن,ما زال يجبُ أن تعتني بـ جسدكِ جيّدا

25
00:03:16,490 --> 00:03:18,670
حسناً,سوف أكون حذّرة

26
00:03:20,540 --> 00:03:24,970
لكن,كيف إكتشفت أنني مُصابةٌ بـ الحُمى؟

27
00:03:24,970 --> 00:03:28,230
هذا لـ أنكِ تبدين مُختلفةً عن ما مضى

28
00:03:28,230 --> 00:03:35,250
مختلفةٌ عن ما مضى؟

29
00:03:35,250 --> 00:03:39,530
أيضاً,لم يُلاحظ أحدٌ هذا طوال اليوم

30
00:03:41,570 --> 00:03:43,500
...لـ هذا أُخبرتكِ أن لا تتحملِ

31
00:03:43,500 --> 00:03:45,540
فهمت

32
00:03:45,540 --> 00:03:48,680
لن أُحاول إخفاء شئٍ عندك أبدا

33
00:03:48,680 --> 00:03:54,790
أيضاً,هُناك سرٌ آخر عني قد كُشف أيضاً

34
00:03:54,790 --> 00:03:56,480
آه,سرّ؟

35
00:03:56,480 --> 00:03:58,120
..أنا

36
00:03:59,090 --> 00:04:01,590
في الحقيقة,صدري ليس كبيراً هكذا

37
00:04:01,880 --> 00:04:03,300
آويّ تشان

38
00:04:04,010 --> 00:04:11,100
ليس لديّ ما آكافئك به,على الأقل,تمتع بـ ملامسة منطقة الفتياتِ الناعمة

39
00:04:11,100 --> 00:04:12,390
...كلا,كما قُلت

40
00:04:12,390 --> 00:04:14,100
ما الذي تفعله؟

41
00:04:15,520 --> 00:04:18,360
ساكورا؟,كلا,أنتِ على خطأ

42
00:04:19,780 --> 00:04:21,530
..هذا

43
00:04:23,450 --> 00:04:27,970
إنها مُصابةٌ بـ الحُمى,وأنا أحملها إلى منزلّها,هذا كّل شئ

44
00:04:29,330 --> 00:04:32,050
لـ هذا وجهك أحمرٌ بـ الكامل؟

45
00:04:32,050 --> 00:04:35,150
حسناً,لستُ مُصاباً بـ الحُمى

46
00:04:36,360 --> 00:04:38,210
مساء الخير,ساكورا تشان

47
00:04:44,710 --> 00:04:48,310
اسمي هيناموتو آويّ,سعدتُ بـ لقائكِ

48
00:04:48,310 --> 00:04:52,140
آنو,أنا..ساكورا

49
00:04:56,700 --> 00:04:59,590
آه,وهذا أوتامارو

50
00:05:03,610 --> 00:05:08,160
أهيّ صديقتكِ,أوني تشان؟,هل سوف تعلبُ معنا اليوم؟

51
00:05:08,160 --> 00:05:11,830
آسف,ساكورا,ليس اليوم

52
00:05:11,830 --> 00:05:15,750
فهمت,لـ أنها مُصابةٌ بـ الحُمى

53
00:05:16,190 --> 00:05:18,080
آسفة,ساكورا تشان

54
00:05:18,080 --> 00:05:20,820
عندما تتحسّنين,هل سوف تلعبين معي؟

55
00:05:20,820 --> 00:05:21,590
أجل

56
00:05:21,590 --> 00:05:24,560
رائع,هذا وعد

57
00:05:28,470 --> 00:05:33,310
إلى اللقاء,أويّ,أوني تشان

58
00:05:38,400 --> 00:05:40,890
أوني تشان إذن

59
00:05:43,670 --> 00:05:44,820
هل أنتِ بخير؟

60
00:05:45,900 --> 00:05:48,200
أشعرُ أنني بالغتُ قليلاً

61
00:05:48,700 --> 00:05:52,830
حسناً,لـ نذهب,حاولِ أن ترتاحِ جيّداً هذه المرة

62
00:05:53,800 --> 00:05:55,080
حاضر

63
00:06:06,260 --> 00:06:07,550
هل لديّكِ دواء؟

64
00:06:07,550 --> 00:06:11,800
أجل,لديّ بعضٌ منه في أعلى خزانتي

65
00:06:11,800 --> 00:06:16,040
لكن,قبل ذلك,يجبُ أن تأكلِ شيئاً ما

66
00:06:17,310 --> 00:06:19,650
لا أُريد آكل شئ الآن

67
00:06:20,180 --> 00:06:23,690
يجبُ أن تأكلِ حتى يبدأ الدواء مفعوله,ما رأيكِ بـ بعضِ العصيدة؟

68
00:06:25,000 --> 00:06:30,950
هل يُمكن أن تبرده ثم تُطعمني إياه؟

69
00:06:31,510 --> 00:06:33,950
إذا كان هذا سوف يجعلكِ تأكلينه

70
00:06:34,810 --> 00:06:36,600
سوف أستعملُ مطبخكِ قليلاً

71
00:06:39,460 --> 00:06:44,170
أنت شخصٌ رحيم,كما لو كُنت أخاً أكبر

72
00:06:44,170 --> 00:06:46,590
آه؟,هل قُلتِ شيئاً؟

73
00:06:48,300 --> 00:06:55,440
آنو...قبل أن تذهب لـ إعداد العصيدة,هُناك طلبٌ أود منك أن تلبيّه

74
00:06:56,600 --> 00:07:01,440
تستطيعين أن تنامِ,دعيني أقم بـ كل شئ هُنا

75
00:07:01,440 --> 00:07:04,730
في هذه الحالة,هل تستطيعُ أن تساعدني في تغيير ملابسي؟

76
00:07:04,730 --> 00:07:06,400
مـ..ماذا؟

77
00:07:06,840 --> 00:07:10,230
كما قُلت,هل تستطيعُ أن تُساعدني في تغيير ملابسي؟

78
00:07:10,880 --> 00:07:13,250
ملابس النوم داخل السلة

79
00:07:13,250 --> 00:07:16,870
وملابسي الداخليّة الخزانة السُفليّة الثانيّة

80
00:07:16,870 --> 00:07:22,300
كلا..كلا..كلا,أساعدكِ في التغيير؟,وهل قُلتِ ملابسكِ الداخليّة أيضاً؟

81
00:07:22,300 --> 00:07:25,800
لا أستطيعُ الحركة,لا خِيار آخر لي

82
00:07:26,360 --> 00:07:31,130
ليس من الجيّد أن أنام وجسدي مُتعرقٌ هكذا

83
00:07:31,130 --> 00:07:37,930
أنتِ مُحقة,لكنكِ فتاة,آوي تشان,لـ هذا يجبُ أن تغيير ملابسكِ بـ نفسكِ

84
00:07:38,830 --> 00:07:43,330
ألم تقل أن أطلب منك أي شئٍ قبل قليل؟

85
00:07:43,330 --> 00:07:46,720
يجبُ أن تُوفيّ بـ وعدك حتى النهايّة

86
00:07:46,720 --> 00:07:51,070
لن تكون فاتراً عندما تُقدم الإحسان لـ غيّرك

87
00:07:51,860 --> 00:07:56,850
إضافةً إلى ذلك,كيوتاكا سان,أنا أثقُ بك

88
00:07:58,280 --> 00:08:00,790
هل سوف تكون آويّ تشان بخير؟

89
00:08:00,790 --> 00:08:02,960
ني سان معها

90
00:08:04,880 --> 00:08:08,840
هذا صحيح,لكن ليس الأمرُ أنني لا أريد أن تتحسّن آويّ تشان

91
00:08:08,840 --> 00:08:11,590
أتفهمُ شعوركِ

92
00:08:11,590 --> 00:08:13,760
أجل..أجل

93
00:08:18,410 --> 00:08:20,930
كما توقعت,هذا مُحرجٌ قليلاً

94
00:08:20,930 --> 00:08:24,170
إذن,ما حالة جسدكِ؟

95
00:08:26,550 --> 00:08:32,960
يبدو أنني لن أستطيع فعلها وحدي,جسدي لا يستجيب,هل يُمكن أن تُساعدني؟

96
00:08:32,960 --> 00:08:34,240
أ..أجل

97
00:08:45,850 --> 00:08:48,030
أعتذر عن هذا

98
00:09:01,930 --> 00:09:04,810
ساعدني في ملابسي الداخليّة أيضاً

99
00:09:04,810 --> 00:09:07,400
هـ..هل أنتِ متأكدةٌ حقاً؟

100
00:09:10,220 --> 00:09:11,680
أجل

101
00:09:18,700 --> 00:09:21,080
أنا مُغلقٌ عينايّ

102
00:09:22,980 --> 00:09:25,200
أنا مُستعدة

103
00:09:31,220 --> 00:09:33,430
هل يُمكن أن تفتحِ ساقيّكِ قليلاً؟

104
00:09:33,430 --> 00:09:35,000
حـ..حاضر

105
00:09:42,160 --> 00:09:43,640
إنتهيّت

106
00:09:44,240 --> 00:09:47,270
...آتو..بعد هذا

107
00:09:53,050 --> 00:09:59,280
آ..آنو,أتعلم..هل يّمكن أن تستدير فقط بدلاً عن هذا

108
00:09:59,280 --> 00:10:02,910
من هُنا..سوف أُحاول إرتداء ملابسي

109
00:10:02,910 --> 00:10:06,330
أ..أ..أنتِ مُحقة,أفعلِ ذلك

110
00:10:09,340 --> 00:10:11,670
آسفةٌ على ما حدث قبل قليل

111
00:10:11,670 --> 00:10:17,590
فجأةً,بدأت الكثير من الأفكار تظهر في رأسي,لم أكّن مدركةً لما أقوم به

112
00:10:17,590 --> 00:10:22,970
كلا,إنهُ خطأي أيضاً لـ أنني سايّرتُ هذا الجو الغريب

113
00:10:22,970 --> 00:10:25,220
هذا مخيفٌ بعض الشئ

114
00:10:25,220 --> 00:10:29,430
إعتمدتُ عليّك كثيراً بـ حُمايّ

115
00:10:29,430 --> 00:10:33,400
أشعر أن حرارتي إرتفعت لـ عشر درجاتٍ فجأةً

116
00:10:33,800 --> 00:10:35,730
إذا حدث ذلك سوف تموتين

117
00:10:37,200 --> 00:10:42,410
فكّرتُ أن أكون أنانيّة وأن أعتمد عليّك هذه المرة

118
00:10:42,410 --> 00:10:44,290
أشعر أنني فشلتُ في هذا

119
00:10:47,120 --> 00:10:50,770
إذن,يجبُ أن تبقيّ في المنزل وترتاحِ هذه الليلة

120
00:10:50,770 --> 00:10:52,710
حاضر,سوف أفعل ذلك

121
00:10:52,710 --> 00:10:56,840
يجبُ أن أذهب إلى البيت أنا أيضاً,رورو ني قلقةٌ عليّ بـ التأكيد

122
00:10:57,720 --> 00:10:58,550
..آ..آنو

123
00:11:01,710 --> 00:11:05,310
كلا,اليوم..شكراً جزيلاً

124
00:11:05,310 --> 00:11:06,770
إعتنِ بـ نفسكِ

125
00:11:07,560 --> 00:11:08,430
حاضر

126
00:11:18,530 --> 00:11:21,590
أشعرُ أنني توترت

127
00:11:24,020 --> 00:11:27,540
الطريق إلى سنِ الرشد عالٍ وضيّق

128
00:11:36,630 --> 00:11:39,260
آه,آويّ تشان لم تأتي اليوم؟

129
00:11:39,260 --> 00:11:42,430
أجل,يبدو أنها آخذت إجازةً اليوم

130
00:11:43,840 --> 00:11:47,840
سارة,أنقلِ هذا إلى ريّكا سان والآخريّات

131
00:11:48,770 --> 00:11:50,560
فهمت

132
00:11:50,560 --> 00:11:52,650
سوف أخبرها,تستطيعُ أن تذهب الآن

133
00:11:52,650 --> 00:11:54,520
آتو,لم أقل شيئاً بعد

134
00:11:54,520 --> 00:11:56,450
لا تقلق على هذا

135
00:11:56,450 --> 00:11:59,940
لستُ حمقاء مثلك

136
00:12:01,280 --> 00:12:03,990
آنو,هل يّمكن أن أسالك؟

137
00:12:04,800 --> 00:12:09,870
إذا كُنت في مشكلةٍ كما هيّ الآن,هل سوف تأتي إليّ؟

138
00:12:09,870 --> 00:12:12,290
بـ الطبع,هذا مؤكد

139
00:12:13,180 --> 00:12:14,710
فهمت

140
00:12:15,920 --> 00:12:17,980
أسرع وأذهب

141
00:12:17,980 --> 00:12:20,630
أ..أجل,شُكراً,سارة

142
00:12:24,830 --> 00:12:27,430
شقق هيناتا

143
00:12:29,960 --> 00:12:32,220
آه,كيوتاكا سان

144
00:12:32,220 --> 00:12:34,060
ما الذي آتى بك إلى هُنا فجأةً؟

145
00:12:34,060 --> 00:12:36,730
من أجل زيارتكِ,إنظرِ

146
00:12:38,400 --> 00:12:41,990
آسفة,يبدو أنني جعلتك تقلق

147
00:12:42,680 --> 00:12:46,660
لكن هذا جيّد,يبدو أن صحتكِ أصبحت أفضّل من الأمس

148
00:12:47,690 --> 00:12:51,030
جعلت ترى جانبي السلبي بـ الأمس

149
00:12:51,030 --> 00:12:52,960
كلا,ليس هذا

150
00:12:54,370 --> 00:12:58,790
لـ..لكن,لم أتوقع أن تُعد لي أنت العشاء

151
00:12:58,790 --> 00:13:01,960
لم تُتح لديّ الفرصة لـ طبخ شئٍ لكِ بـ الأمس

152
00:13:01,960 --> 00:13:03,090
هل إستعدتِ شهيّتكِ؟

153
00:13:03,090 --> 00:13:04,860
بـ الطبع

154
00:13:04,860 --> 00:13:08,550
صحيح,دعني أُساعدك في إعداد العشاء

155
00:13:08,550 --> 00:13:11,870
جِئتُ هُنا من أجلِ مُساعدتكِ,إرتاحِ فقط

156
00:13:11,870 --> 00:13:13,930
كلا..كلا,لا أستطيعُ تركك تفعل هذا وحدك

157
00:13:13,930 --> 00:13:17,480
"سوف أذهب لـ تغيير ملابسي إلى"لباس المعركة

158
00:13:18,260 --> 00:13:21,190
الحمدُ لله,آويّ تشان أصبحت أكثر نشاطاً

159
00:13:25,570 --> 00:13:27,550
لباس المعركة"؟"

160
00:13:28,180 --> 00:13:29,240
آسفةٌ على إنتظارك

161
00:13:30,100 --> 00:13:31,860
ما رأيك؟,ما رأيك؟

162
00:13:31,860 --> 00:13:37,170
بما أنك آتيت هُنا من أجل زيارتي,أرغبُ بـ الطبع بـ تعريّة جسدي كاملاً لك

163
00:13:38,580 --> 00:13:40,250
هل سوف تتجاهلني؟

164
00:13:40,250 --> 00:13:44,800
حتى أنا لا أعلمُ أن كُنت سوف تنظر إليّ فقط

165
00:13:44,800 --> 00:13:49,010
حسناً,كلا,أظنُ أنه يجبُ أن ترتدي شيئاً تحته

166
00:13:49,010 --> 00:13:50,740
ردّة الفعل هذه؟

167
00:13:50,740 --> 00:13:53,730
هذا ما يحلمُ به كل فتىً

168
00:13:53,730 --> 00:13:55,480
...ليس حُلمي

169
00:13:55,480 --> 00:14:01,940
أنت تتحدث عن هذا وتُحدق بي وأنا لا أرتدي سوى مِريّلة

170
00:14:01,940 --> 00:14:04,280
هل تعني أنني لا أُثيرك؟

171
00:14:04,280 --> 00:14:06,110
هيا,كيوتاكا سان؟

172
00:14:06,820 --> 00:14:10,280
صـ..صحيح,يجبُ أن أُجهز النابي الآن

173
00:14:10,280 --> 00:14:12,200
إخترت الطعام عن الشهوّة؟

174
00:14:12,200 --> 00:14:15,290
هل تعني أن النابي أفضّل من إغرائي؟

175
00:14:15,290 --> 00:14:17,550
...لم أتحدث عن هذا

176
00:14:17,550 --> 00:14:23,780
حسناً,كيّ أصرف إنتباهي عن ما ترتدينه,بدأت بـ إعداد العشاء

177
00:14:23,780 --> 00:14:25,380
شددتُ إنتباهك؟

178
00:14:25,380 --> 00:14:28,930
لـ هذا,هل يُمكن أن ترتدي بعض الملابس  الآن؟

179
00:14:28,930 --> 00:14:32,560
لا خيار آخر إذن,فهمت

180
00:14:32,560 --> 00:14:35,850
هيناموتو آويّ,سوف تُغيّر الآن

181
00:14:44,400 --> 00:14:47,200
صحيح,إنتظر لحظة

182
00:14:50,700 --> 00:14:52,830
تفضلِ,آويّ تشان

183
00:14:52,830 --> 00:14:55,250
ألن تُطعمني؟

184
00:14:55,250 --> 00:14:58,140
قُلت أنك لن تترد في فعل شئٍ من أجل بـ الأمس

185
00:14:58,140 --> 00:15:03,250
حسناً,هذا مُحرجٌ قليلاً بـ النسبة لي

186
00:15:03,250 --> 00:15:06,460
..هذا صحيح,إذن,بـ المُقابل

187
00:15:06,460 --> 00:15:11,090
هل يُمكن أن أُناديك بـ"أوني تشان"؟

188
00:15:12,140 --> 00:15:14,050
ليست أهتم حقاً

189
00:15:14,050 --> 00:15:15,930
حقاً؟

190
00:15:15,930 --> 00:15:18,460
أجل,مع هذا لا مشكلة لديّ مُطلقاً

191
00:15:18,460 --> 00:15:22,480
رائع,حُلم طفولتي تحقق أخيراً

192
00:15:22,480 --> 00:15:26,600
أنا عِشتُ وحيدةً في طفولتي,وأردتُ أخاً أكبر دائماً

193
00:15:26,600 --> 00:15:28,160
لكن,ألا مشكلة لديّكِ معي؟

194
00:15:28,160 --> 00:15:33,280
أجل,أنت من كُنت أتخليّه أخاً كبيراً لي دائماً

195
00:15:33,280 --> 00:15:35,740
آه,الحمدُ لله

196
00:15:35,740 --> 00:15:39,450
لو كُنت أعلم أنك سوف تُوافق,لـ طلبتُ منك هذا منذُ وقتٍ طويل

197
00:15:39,450 --> 00:15:44,170
أيضاً,كُنت أفكّر بما جرى بـ الأمس طوال الوقت

198
00:15:43,930 --> 00:15:44,330
إيقاف

199
00:15:43,930 --> 00:15:45,360
تشغيل

200
00:15:44,170 --> 00:15:46,820
...بدلاً من وصف هذا هكذا

201
00:15:48,200 --> 00:15:50,670
أظنُ أنني بالغتُ قليلاً

202
00:15:50,670 --> 00:15:54,010
لستُ أُمانعُ حقاً

203
00:15:54,720 --> 00:15:57,340
عندما أصبح وحدي,قلبي يُقلقني

204
00:15:57,340 --> 00:16:00,930
أردتُ أن أكون أنانيّةً قليلاً

205
00:16:00,930 --> 00:16:06,110
على هذه الحالة,سوف نبدو كـ أشقاء في الحقيقة

206
00:16:07,050 --> 00:16:08,480
..آويّ تشان

207
00:16:08,480 --> 00:16:12,700
هل يُمكن أن أطلب طلباً أنانيّاً آخر؟

208
00:16:13,320 --> 00:16:15,910
عندما أنامُ لاحقاً

209
00:16:15,910 --> 00:16:18,120
هل يُمكن أن تنام بـ جانبي؟

210
00:16:18,120 --> 00:16:20,500
كلا,لا أظنُ أن هذه فكّرةٌ حسّنة

211
00:16:20,500 --> 00:16:25,500
حتى أنام فقط,لـ هذا أعتمدُ عليّك,أوني تشان

212
00:16:27,420 --> 00:16:30,340
شقق هيناتا

213
00:16:33,170 --> 00:16:38,450
أشعرُ أن قلبي مُضطربٌ عندما كُنت مريضّة

214
00:16:38,450 --> 00:16:43,890
أتمنى أن يكون هُناك شخصٌ ما إلى جانبي دائماً,أريد الشعور بـ دفئه

215
00:16:43,890 --> 00:16:49,110
لـ هذا,شكراً جزيلاً,على منحي أمنيّتي

216
00:16:49,110 --> 00:16:51,570
...حسناً

217
00:16:51,570 --> 00:16:56,030
هل من المُمكن,كيوتاكا سان,هل كُنت تفكّر بـ الجنّس؟

218
00:16:56,030 --> 00:16:57,850
لم أكّن أفكّر به

219
00:16:57,850 --> 00:17:02,790
أنتِ من سوف تُكون فيه مشكلةٍ إذا كُنت أفكّر بـ الجنسّ حقاً

220
00:17:02,790 --> 00:17:06,060
صحيح,أظنُ أنك مُحقٌ بـ هذا الشأن

221
00:17:06,060 --> 00:17:10,590
هذا لن يُغيّر الحقيقة,أنا فتاةٌ بـ كلّ الأحوال

222
00:17:10,590 --> 00:17:14,010
فوق ذلك,مظهر صدري يبدو خادعاً

223
00:17:14,010 --> 00:17:18,430
رغم كل هذا,كيوتاكا سان,ألا زلت راضٍ عني بـ هذه الحالة؟

224
00:17:18,430 --> 00:17:20,520
...هذا..حسناً

225
00:17:20,520 --> 00:17:23,350
آويّ تشان,لا أستطيعُ تخييب ظنكِ فيّ

226
00:17:23,350 --> 00:17:25,060
..في هذه الحالة

227
00:17:26,950 --> 00:17:29,240
قد لا يكون هذا كافٍ لـ رد جميلك

228
00:17:29,240 --> 00:17:34,610
لكنك تستطيعُ فعل أي شئٍ بي بعد أن أنام

229
00:17:35,550 --> 00:17:37,530
إنتظرِ,آويّ تشان

230
00:17:40,390 --> 00:17:43,120
سوف أشعرُ بـ الراحة هكذا

231
00:17:43,120 --> 00:17:46,380
هل يُمكن أن تبقى هكذا لـ فتّرة؟

232
00:17:46,380 --> 00:17:48,540
حـ..حسناً

233
00:17:51,660 --> 00:17:54,880
ليلةً سعيدة,أوني تشان

234
00:18:12,560 --> 00:18:14,280
هل نامت الآن؟

235
00:18:23,550 --> 00:18:24,870
..إن لم أعد حالاً

236
00:18:31,250 --> 00:18:33,210
..أوني تشان

237
00:18:37,510 --> 00:18:39,220
حسناً,لا يُهم

238
00:18:50,540 --> 00:18:52,270
لقد عُدت

239
00:18:54,570 --> 00:18:57,360
فهمت,في مجلسِ الطُلاب إذن

240
00:18:57,360 --> 00:18:59,610
أين كُنت في الأمس؟

241
00:18:59,610 --> 00:19:00,820
هيمينو

242
00:19:01,820 --> 00:19:03,800
سألتك أين كُنت بـ الأمس؟

243
00:19:03,800 --> 00:19:08,000
عُدت في الصباح فقط,ولم تهتم بـ إخبارنا ليلة أمس

244
00:19:08,500 --> 00:19:10,670
هل من المُمكن..أنكِ كُنتِ قلقةً عليّ؟

245
00:19:10,670 --> 00:19:12,440
بـ الطبع

246
00:19:12,440 --> 00:19:15,940
أليس من الطبيعي أن أقلق إن لم تعد؟

247
00:19:15,940 --> 00:19:20,680
حسناً,بعد أن زُرت آويّ تشان,تجولتُ لـ بعض الوقت

248
00:19:21,980 --> 00:19:23,090
آسف

249
00:19:25,990 --> 00:19:28,100
آخذت الكثير من الوقت من أجل زيارة مريضة

250
00:19:28,100 --> 00:19:32,940
أنا أثقُ بك,لـ هذا سوف أُسامحك

251
00:19:32,940 --> 00:19:34,360
شكراً لكِ

252
00:19:34,360 --> 00:19:38,000
لكن,شارولو سان كانت قلقةً جداً عليّك

253
00:19:38,000 --> 00:19:41,950
بحثت عنك في الليل,كانت متوترةً جداً

254
00:19:43,110 --> 00:19:46,370
سوف أعتذر إليّها لاحقاً

255
00:19:46,370 --> 00:19:48,060
حتى تسامحني

256
00:19:48,060 --> 00:19:50,960
إذن,غيّر ملابسك بـ سرعة,سوف نتأخر عن الحافلة

257
00:19:52,780 --> 00:19:56,710
آره,بـ الكاد ترتدي شيئاً

258
00:19:56,710 --> 00:20:01,380
آه,كما تريّن,أصبح الجو أكثر دفئً مؤخراً

259
00:20:01,790 --> 00:20:03,300
هل هذا ما تظنه؟

260
00:20:04,160 --> 00:20:07,220
لا أظنُ أنه كذلك

261
00:21:50,160 --> 00:21:56,460
تاكا كُن,جعلتني قلقةً عليّك عمداً

262
00:21:56,460 --> 00:21:58,740
كلا,هذا غيرُ صحيح

263
00:21:58,740 --> 00:22:00,800
هذه مرحلة المُراهقة إذن

264
00:22:00,800 --> 00:22:02,580
ليس هذا

265
00:22:02,580 --> 00:22:05,090
لم يكّن الأمر بـ يدي

266
00:22:05,090 --> 00:22:07,800
شارولو,حان الوقتُ لـ تسامحيه

267
00:22:10,720 --> 00:22:13,640
تاكا كُن,سوف نُكمل هذا عندما نعود إلى البيت

268
00:22:15,490 --> 00:22:17,560
نكمل؟

269
00:22:17,560 --> 00:22:21,250
الجميع,آسفةٌ على إقلاقكم

270
00:22:21,250 --> 00:22:24,070
هيناموتو آويّ جاهزةٌ للـ عمل

271
00:22:24,070 --> 00:22:25,490
آويّ تشان

272
00:22:29,040 --> 00:22:30,060
الحمدُ لله

273
00:22:30,060 --> 00:22:31,910
تبدين بخيرٍ هكذا

274
00:22:31,910 --> 00:22:34,040
هل يمر جسدكِ بـ تحسن؟

275
00:22:34,040 --> 00:22:35,990
أجل,أيضاً

276
00:22:35,990 --> 00:22:39,560
كيوتاكا سان أعطاني الكثير من الطاقة

277
00:22:40,120 --> 00:22:41,500
أليس كذلك,أوني تشان؟

278
00:22:42,710 --> 00:22:44,090
أوني تشان؟

279
00:22:44,090 --> 00:22:47,510
أعطيّتها الكثير من الطاقة إذن

280
00:22:50,840 --> 00:22:53,040
تاكا كُن,قُل أن هذا كذب

281
00:22:53,040 --> 00:22:54,930
ربما يكون قد فعل شيئاً فاسد

282
00:22:54,930 --> 00:22:59,230
يبدو أنك تفاهمت كثيراً مع أختك الصغيرة الجديدة جيّداً

283
00:22:59,230 --> 00:23:00,810
ني..سان

284
00:23:00,810 --> 00:23:03,230
إذن,ماذا حدث بيّنكما؟

285
00:23:03,230 --> 00:23:05,460
لم يحدث شئ

286
00:23:05,460 --> 00:23:07,570
...فقط,نمنا في نفس السريـ

287
00:23:08,340 --> 00:23:09,360
قذر

288
00:23:09,360 --> 00:23:10,150
كلا

289
00:23:11,700 --> 00:23:16,750
يبدو أن لديّنا مسألةً أخرى نُعالجها مُختلفةٌ كُليّاً عن الإجتماع

290
00:23:24,870 --> 00:23:39,800
الحلقة القادمة

291
00:23:24,870 --> 00:23:39,800
المكان الملئ بالحبّ والأحلام والأمل

292
00:23:25,540 --> 00:23:26,710
هيناموتو آويّ تشان

293
00:23:26,710 --> 00:23:28,380
لقد ذُهلتُ عندما رأيتِ لا ترتدين شيئاً سوى المِريلة

294
00:23:28,380 --> 00:23:29,340
شُكراً جزيلاً

295
00:23:29,340 --> 00:23:31,640
أي مكانٍ تتواجد به الفتيات,الحبّ..كلا,الأحلام

296
00:23:31,640 --> 00:23:32,560
رومانسية الرجل

297
00:23:32,560 --> 00:23:34,180
أين ذلك المكان؟

298
00:23:34,180 --> 00:23:36,290
في الحلقة القادمة,المكان الملئ بـ الحبّ والأحلام والأمل

299
00:23:36,430 --> 00:23:38,140
أمامنا,الجنّة,توجينكيو

300
00:23:38,140 --> 00:23:40,310
خِدمة..خِدمة