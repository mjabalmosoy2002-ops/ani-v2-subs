1
00:00:03,320 --> 00:00:07,230
يا مُعجبي كويل، شكراً لكم على الانتظار

2
00:00:07,850 --> 00:00:12,240
برنامج التفاعُل مع المُعجبين هذا برعايتنا
نحن، كويل، ورعايتكم، حضرة المُستمعين

3
00:00:12,620 --> 00:00:16,240
...هذا بثٌّ مُباشَر خاصّ لإذاعة كوبي

4
00:00:16,720 --> 00:00:19,410
!تبدأ الآن

5
00:00:21,490 --> 00:00:24,530
وها قد بدأ البرنامج

6
00:00:24,530 --> 00:00:27,920
،حلقة إذاعة كويل، والمعروفة بإذاعة كوبي أيضاً

7
00:00:28,300 --> 00:00:31,920
تبثُّ على الهواءِ مباشرة اليوم
من راعينا الرّسمي

8
00:00:31,920 --> 00:00:37,430
ساحة نافورة شاي إشراقة
الشّمس إيكيبوكورو

9
00:00:38,220 --> 00:00:42,000
مرحباً جميعاً، أنا إيتشي هوريميا من كويل

10
00:00:45,320 --> 00:00:47,180
وأنا إتشيرو كوغا

11
00:00:51,640 --> 00:00:53,050
وأنا إيسّي كوغا

12
00:00:56,400 --> 00:00:58,160
أنا أخُ إتشيرو الأكبر

13
00:00:58,160 --> 00:01:00,840
إتشي وإيسّي هما توأمان

14
00:01:00,840 --> 00:01:03,700
أعتقد أنّ الناس سيميّزون ذلك بمجرّد رؤيتنا

15
00:01:04,140 --> 00:01:08,380
،إذاعة كوبي هو برنامج إذاعي يقدِّم لنا

16
00:01:08,380 --> 00:01:10,170
أعضاءَ كويل

17
00:01:10,170 --> 00:01:13,310
،بالتفاعل مع مُستمعينا

18
00:01:13,310 --> 00:01:16,720
نأمل أن تتعرّفوا علينا أكثر

19
00:01:16,990 --> 00:01:20,190
،قائدنا شو إيزومي

20
00:01:20,190 --> 00:01:22,970
،سيلعب دورَ بطولة تمثيليّة تبدأ الأسبوع المقبل

21
00:01:22,970 --> 00:01:25,670
وأخذَ يتجوّل من مكانٍ لآخر مروّجاً
عنه يوميّاً

22
00:01:25,670 --> 00:01:30,730
لذا مع الأسف، لن يشاركنا اليوم

23
00:01:30,730 --> 00:01:34,280
،تُبَثُّ التمثيليّة التي يلعب شو إيزومي بطولتها

24
00:01:34,280 --> 00:01:37,240
"إنَّ الهرب مُعيب، لكن يبقى أفضل من الموت"

25
00:01:37,240 --> 00:01:39,730
اعتباراً من الأسبوع المقبل

26
00:01:43,480 --> 00:01:46,150
آمل أن تتابعوها

27
00:01:46,150 --> 00:01:49,380
سنُروِّج للعرضِ لأجل شو اليوم

28
00:01:49,660 --> 00:01:52,750
هذا ما وُجِدَتْ إذاعة كوبي لأجله

29
00:01:52,750 --> 00:01:56,320
شو مشغولٌ في تصويرِ تمثيليّته

30
00:01:56,320 --> 00:01:58,180
ويؤلّف الأغاني لحفلِ تسوكيبرو نهاية العام

31
00:01:58,180 --> 00:02:01,070
لكنّنا نعملُ بجدٍّ كلّ يوم أيضاً

32
00:02:01,070 --> 00:02:03,230
على دروسِ الرّقص والغناء

33
00:02:03,230 --> 00:02:05,190
لقد سجّلنا مُعظم حركات الرّقص

34
00:02:05,190 --> 00:02:08,770
تخدّرت عضلاتي من الرّقصِ طوال اليوم
لكن الأمر جدير بذلك

35
00:02:09,000 --> 00:02:11,710
لدينا أغنيةٌ لكم الآن

36
00:02:11,710 --> 00:02:14,280
...نحن كويل، وهذه

37
00:02:14,870 --> 00:02:16,120
"مُؤمِن"

38
00:02:17,070 --> 00:02:24,540
الأمنيات التي تركناها تصعدُ للسماء

39
00:02:24,540 --> 00:02:32,080
لا أحد يعلم ما هو مصيرها

40
00:04:24,480 --> 00:04:25,980
ما أظرفهما

41
00:04:25,980 --> 00:04:26,990
هل هما توأمان؟

42
00:04:32,330 --> 00:04:34,190
شو في كلّ مكان

43
00:04:36,460 --> 00:04:39,050
إيسّي، إتشي، هل أنتما بخير؟

44
00:04:39,050 --> 00:04:42,350
نعم، آسف. شردتُ بينما كنتُ أنظر إلى هذه

45
00:04:42,350 --> 00:04:43,260
هذه؟

46
00:04:43,260 --> 00:04:45,650
مذهلة، أليس كذلك؟

47
00:04:46,380 --> 00:04:50,050
نحن في نفسِ الفرقة مع هذا الفتى

48
00:04:55,190 --> 00:04:57,620
حسناً، حسناً، هيّا بنا نذهب

49
00:04:58,820 --> 00:05:00,480
لنعمل بجدٍّ على درسِ الرّقص

50
00:05:01,220 --> 00:05:02,080
نعم

51
00:05:09,330 --> 00:05:11,580
يوجد كثيرٌ من الناس في طوكيو

52
00:05:11,580 --> 00:05:12,360
أجل

53
00:05:12,860 --> 00:05:15,150
،كان بمقدورِنا أن نستقلّ سيّارة أجرة

54
00:05:15,150 --> 00:05:17,960
لكن ارتأيتُ أنّنا نستطيع توقُّع
وقت وصولنا إذا مشينا

55
00:05:17,960 --> 00:05:20,920
وجدتُ شيئاً جيّداً

56
00:05:23,750 --> 00:05:26,270
ينبغي أن نأكل قبل درسنا

57
00:05:28,330 --> 00:05:30,600
إنّها لذيذة ومنفوشة

58
00:05:31,040 --> 00:05:33,740
لم أتناول مثيلاً لها منذ مدّة. إنّها شهيّة

59
00:05:33,740 --> 00:05:36,650
خاصّتي بنكهة الكستناء. ما نكهة خاصّتك؟

60
00:05:37,750 --> 00:05:38,880
بطاطا؟

61
00:05:38,880 --> 00:05:41,320
هذه النّكهة لا تُباع إلّا في الخريف

62
00:05:41,700 --> 00:05:44,820
بالمناسبة، خاصّتي بنكهةِ يقطين يقطين

63
00:05:45,140 --> 00:05:46,280
يقطين؟

64
00:05:46,280 --> 00:05:47,820
يقطين يقطين؟

65
00:05:47,990 --> 00:05:50,060
أجل، يقطين يقطين

66
00:05:50,480 --> 00:05:51,340
أريد تجربتها

67
00:05:51,340 --> 00:05:52,270
أنا أيضاً

68
00:05:52,780 --> 00:05:53,700
حسناً، حسناً

69
00:05:59,040 --> 00:06:00,750
أشعر وكأنّني عصفورة أمّ

70
00:06:07,130 --> 00:06:09,100
إنّه تسوباسا-كن. صباح الخير

71
00:06:09,100 --> 00:06:10,390
صباح الخير

72
00:06:11,530 --> 00:06:12,810
صباح النّور

73
00:06:15,350 --> 00:06:18,550
ماذا كان ذلك يا إتشيرو؟

74
00:06:17,110 --> 00:06:19,690
!لا تفعل هذا

75
00:06:20,200 --> 00:06:21,800
!اتركني

76
00:06:20,200 --> 00:06:21,800
هل أتيتم إلى هنا لدرسِكم أيضاً؟

77
00:06:21,800 --> 00:06:24,190
راقب وتعلّم

78
00:06:25,400 --> 00:06:27,320
!لن تهزمني

79
00:06:28,160 --> 00:06:29,530
صباح الخير جميعاً

80
00:06:29,530 --> 00:06:31,320
صباح النّور

81
00:06:31,320 --> 00:06:32,720
قوموا بالإحماء

82
00:06:32,720 --> 00:06:33,580
حاضر

83
00:06:45,090 --> 00:06:47,590
واحد، اثنان، ثلاثة، أربعة

84
00:06:47,590 --> 00:06:50,020
خمسة، ستّة، سبعة، ثمانية

85
00:06:50,020 --> 00:06:52,560
واحد، اثنان، ثلاثة، أربعة

86
00:06:52,560 --> 00:06:55,100
خمسة، ستّة، سبعة، ثمانية

87
00:06:56,900 --> 00:06:58,780
أبقوا رؤوسكم ثابتة عندما تستديرون

88
00:06:58,780 --> 00:06:59,600
حاضر

89
00:06:59,860 --> 00:07:01,360
انخفِضوا وكأنّكم تمرّون من تحت قضيب

90
00:07:01,360 --> 00:07:02,230
حاضر

91
00:07:14,700 --> 00:07:16,990
كان ذلك شاقّاً

92
00:07:17,670 --> 00:07:21,970
أنا متأكّدٌ أنّ شو كان ليستطيع تخطّي هذا بسهولة

93
00:07:21,970 --> 00:07:25,000
بالطبع. فقد عاشَ مسيرة مهنيّة مختلفة

94
00:07:25,420 --> 00:07:28,630
لكن أريد أن أصبح بمستواه قريباً

95
00:07:30,620 --> 00:07:32,060
...إيسّي

96
00:07:33,160 --> 00:07:36,640
أريد أن أصبح بمثل مُستواه تماماً

97
00:07:38,780 --> 00:07:41,320
،أشكّ بسهولة الأمر

98
00:07:41,320 --> 00:07:44,150
لكن لا يجوز أن نعتمد على شو للأبد

99
00:07:44,480 --> 00:07:48,580
إذا كان ما نفتقر إليه هو الخبرة، فكلّ
ما علينا فعله هو المزيد من التّمرين

100
00:07:48,580 --> 00:07:50,030
سنبلغ مُستواه خلال وقتٍ قصير

101
00:07:51,330 --> 00:07:52,820
إتشي على حقّ

102
00:07:52,820 --> 00:07:55,460
كلّ ما يمكننا فعله الآن هو التمرُّن
بأكبر قدر مُمكن

103
00:07:55,460 --> 00:07:56,030
أجل

104
00:07:57,460 --> 00:07:59,930
ما هذا يا إتشيرو؟ تبدو متحمّساً اليوم

105
00:07:59,930 --> 00:08:02,000
اخرس

106
00:08:03,250 --> 00:08:06,730
سمعت ذلك؟ كم هذا مُحرِج

107
00:08:06,730 --> 00:08:09,550
لا شيء يدعو للإحراج في ذلك

108
00:08:10,280 --> 00:08:14,730
لا يجوز أن تتحدّث أنّك ستصبح بمُستوى شو
ما لم تكن جادّاً

109
00:08:15,160 --> 00:08:18,110
لكن لن تهزموا سوليدس

110
00:08:19,260 --> 00:08:20,350
حظّاً سعيداً

111
00:08:26,320 --> 00:08:28,720
هل يدعمنا؟

112
00:08:28,720 --> 00:08:31,110
لماذا يتصرّف وكأنّه أفضل منّا؟

113
00:08:31,110 --> 00:08:34,620
أنت وتسوباسا-سان متشابهان قليلاً

114
00:08:34,620 --> 00:08:36,020
من أي ناحية؟

115
00:08:36,020 --> 00:08:37,590
لا تُفصِحان عن مشاعركما

116
00:08:37,590 --> 00:08:38,850
تماماً

117
00:08:38,850 --> 00:08:41,600
ماذا؟ لسنا متشابهين

118
00:08:42,320 --> 00:08:45,750
لكن علينا أن نبلغ مستواه قريباً

119
00:08:45,750 --> 00:08:48,970
لأجلِنا ولأجل شو

120
00:08:52,950 --> 00:08:54,340
!مرحباً جميعاً

121
00:08:54,900 --> 00:08:56,840
هل يمكنني الدخول؟

122
00:08:57,250 --> 00:08:59,910
،ضيف اليوم هو شخصٌ يعرفه الجميع

123
00:09:00,390 --> 00:09:03,600
شو إيزومي-كن

124
00:09:04,160 --> 00:09:05,770
أنا شو إيزومي

125
00:09:05,770 --> 00:09:07,400
هل يمكنني الدخول؟

126
00:09:09,650 --> 00:09:11,340
ظهر شو من جديد

127
00:09:12,670 --> 00:09:15,240
،رغم أنّه غنيّ عن التعريف

128
00:09:15,240 --> 00:09:18,990
دعونا نراجع معاً المعلومات الخلفيّة حول إيزومي-كن

129
00:09:19,610 --> 00:09:21,370
،كما يعلم الجميع يا إيزومي-كن

130
00:09:21,370 --> 00:09:24,960
كنتَ جزءاً من فرقةٍ مغنّين مشاهير

131
00:09:24,960 --> 00:09:27,080
،وعندما تفكّكت تلك الفرقة

132
00:09:27,080 --> 00:09:30,420
أسّست فرقةً جديدةً تُدعى كويل

133
00:09:30,860 --> 00:09:34,790
إيزومي-كن، هلّا حدّثتنا قليلاً عن كويل؟

134
00:09:34,790 --> 00:09:35,670
بالتأكيد

135
00:09:36,160 --> 00:09:39,510
كويل هي مجموعةٌ مؤلّفة من أربعة أشخاص

136
00:09:39,510 --> 00:09:41,950
تركّز بشكلٍ جوهريّ على الموسيقا

137
00:09:41,950 --> 00:09:46,940
من بين أعضائنا مُساعد مُخرج تلفزيوني سابِق
إيتشي هوريميا

138
00:09:47,470 --> 00:09:49,810
كم هذا محرج

139
00:09:50,010 --> 00:09:54,510
وشاءَ القدر أيضاً بانضمام التوأمين

140
00:09:54,510 --> 00:09:57,460
إتشيرو كوغا وإيسّي كوغا إلينا

141
00:09:58,260 --> 00:09:59,670
...يا للهول

142
00:10:00,960 --> 00:10:02,460
ثمّ هناك أنا

143
00:10:04,110 --> 00:10:07,830
إذاً تشكّلت المجموعة حولك

144
00:10:09,120 --> 00:10:13,840
أنوي أن أمضي قدماً وأفعل ما يمكنني
فعله مع كويل

145
00:10:14,350 --> 00:10:18,000
لنكتفِ بهذا القدر حول كويل

146
00:10:18,000 --> 00:10:21,310
إيزومي-كن، تعمل أيضاً بشكلٍ انفرادي كممثّل

147
00:10:21,310 --> 00:10:24,980
ستلعب دور تمثيليّة تبدأ في السّاعة 9:00
من مساء الأسبوع المقبل

148
00:10:24,980 --> 00:10:27,350
إنّ الهرب مُعيب، لكن يبقى أفضل من الموت

149
00:10:27,640 --> 00:10:30,170
،بما أنّه برنامجك الأوّل منذ مدّة

150
00:10:30,170 --> 00:10:32,860
باتَ حديث الجميع

151
00:10:33,500 --> 00:10:35,200
شكراً لك

152
00:10:36,090 --> 00:10:37,990
شو مذهل

153
00:10:39,600 --> 00:10:41,130
لنعد إلى درسنا

154
00:10:42,180 --> 00:10:42,740
أجل

155
00:10:42,740 --> 00:10:48,370
حتّى لو كنت لا تستطيع رؤية الشّمس
افتح مظلّة إلى أن تتوقّف المطر

156
00:10:59,170 --> 00:11:04,810
لنزرع زهوراً تلوّن حياتنا في باحتنا

157
00:11:04,810 --> 00:11:11,220
وحوّل الألم في قلبِك إلى مياه زرقاء

158
00:11:04,820 --> 00:11:06,910
هذا عرض مُسبَق خاصّ للحلقة
الأولى من

159
00:11:06,910 --> 00:11:08,640
إنَّ الهرب مُعيب، لكن يبقى أفضل من الموت

160
00:11:08,900 --> 00:11:11,350
وها هو نجم العرض، شو إيزومي

161
00:11:22,300 --> 00:11:32,100
تذكّر الحلم الذي يتألّق في عينيك

162
00:11:28,890 --> 00:11:29,660
شو

163
00:11:30,010 --> 00:11:30,940
شيكي

164
00:11:32,950 --> 00:11:34,610
تبدو مشغولاً

165
00:11:34,610 --> 00:11:37,610
كذلك أنت. أعائد إلى المنزل؟

166
00:11:37,610 --> 00:11:38,420
أجل

167
00:11:38,780 --> 00:11:43,580
حان وقتُ البدء بالتركيزِ على تأليف
أغاني حفل نهاية العام

168
00:11:44,080 --> 00:11:45,930
ألم تنهِ أغانيك بعد؟

169
00:11:45,930 --> 00:11:50,390
لم تسنح لي الفُرصة بعد، باعتباري
كنتُ أروّج لعرضي

170
00:11:50,750 --> 00:11:53,190
لكن أنوي البدء قريباً

171
00:11:53,540 --> 00:11:54,420
هكذا إذاً

172
00:11:55,750 --> 00:11:57,190
كيف حالُ كويل؟

173
00:11:57,620 --> 00:12:01,220
إيتشي وإتشيرو وإيسّي يعملون بجدٍّ كلّ يوم

174
00:12:07,330 --> 00:12:12,100
إنّ كويل الآن هي المجموعة الوحيدة
التي ينتمي إليها شو إيزومي

175
00:12:14,580 --> 00:12:16,330
هذا واضحٌ من عينيك

176
00:12:17,800 --> 00:12:19,030
إلى هذه الدرجة؟

177
00:12:21,820 --> 00:12:24,340
نعرف بعضنا منذ زمنٍ بعيد

178
00:12:24,600 --> 00:12:28,820
ما زال ظلّ مجموعتي السّابقة كبيراً جدّاً

179
00:12:30,000 --> 00:12:31,220
لكن سأدع النّاس

180
00:12:31,470 --> 00:12:35,230
ينادونني شو من كويل عمّا قريب

181
00:12:35,620 --> 00:12:38,390
أنت رجلٌ يلتزِم بكلمته

182
00:12:39,320 --> 00:12:40,560
أتطلّع قدماً لذلك

183
00:12:41,410 --> 00:12:42,190
شكراً

184
00:12:48,750 --> 00:12:50,680
لقد تمّ اختيار فنّان أجنبي

185
00:12:50,680 --> 00:12:54,000
لتأديةِ أغنية اللّحن الرئيسي
لتمثيليّتك هذه المرّة

186
00:12:54,190 --> 00:12:55,130
أجل

187
00:12:55,130 --> 00:12:59,630
إنّها أغنيةٌ غامضةٌ خياليّةٌ تُلائم
مُحتوى البرنامج بشكلٍ ممتاز

188
00:13:00,060 --> 00:13:02,600
جميعنا متحمِّسون لتمثيليّتك وموسيقاك

189
