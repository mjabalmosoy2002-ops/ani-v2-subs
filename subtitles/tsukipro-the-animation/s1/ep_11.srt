1
00:00:07,900 --> 00:00:11,990
مذهل، إذاً أعضاء كويل الأربعة جميعهم
ساهموا في تأليف أغنيتكم

2
00:00:12,400 --> 00:00:13,740
هذا مذهل

3
00:00:14,040 --> 00:00:18,490
أجل، لكن بالطبع، شو هو من ألّف مقطع الباس

4
00:00:18,490 --> 00:00:23,250
إلّا أنّ إيسّي وإتشيرو وأيتشي قد استكملوا
الأغنية من حيث الجوهر

5
00:00:23,710 --> 00:00:25,710
كانت أوّل محاولة لنا في تأليفِ أغنية

6
00:00:25,710 --> 00:00:27,200
كان ذلك ممتعاً، صحيح؟

7
00:00:27,200 --> 00:00:28,250
أجل

8
00:00:28,740 --> 00:00:31,070
تنسجم كويل مع الآخرين جيّداً

9
00:00:31,070 --> 00:00:34,380
وسوليدس تنسجم بالطبع أيضاً

10
00:00:34,940 --> 00:00:37,000
لكن شيكي يؤلّف كلّ أغانينا

11
00:00:37,000 --> 00:00:37,650
أعلم

12
00:00:37,650 --> 00:00:40,890
إنّه دقيقٌ جدّاً حيال ما يريده

13
00:00:41,140 --> 00:00:44,390
يشدّد شيكي على ما يفضّله دوماً

14
00:00:44,640 --> 00:00:48,980
ولا يتخلّى عنها أبداً

15
00:00:52,100 --> 00:00:54,150
انظروا من يتكلّم

16
00:02:39,100 --> 00:02:40,940
شكراً لكم

17
00:02:43,420 --> 00:02:48,020
ألم يبدُ شيكي وشو غريبين في تسجيل البارحة؟

18
00:02:48,250 --> 00:02:49,060
ماذا؟

19
00:02:49,710 --> 00:02:51,520
هل اعتقدتَ ذلك أيضاً؟

20
00:02:51,730 --> 00:02:53,380
...معك حقّ

21
00:02:53,380 --> 00:02:55,520
بدت الأمور غريبة الأطوار بينهما

22
00:02:55,820 --> 00:02:58,640
يعرفان بعضهما منذ مدّة طويلة، صحيح؟

23
00:02:59,140 --> 00:03:01,530
عملا في نفس الفرقة

24
00:03:01,820 --> 00:03:03,930
يعرفان بعضهما الآخر لحوالي عشر سنوات

25
00:03:04,480 --> 00:03:06,410
إنّهما لا يتخلّيان عن بعضهما

26
00:03:06,980 --> 00:03:10,040
ربّما حدث شيء ما بينهما منذ زمن بعيد

27
00:03:10,040 --> 00:03:11,540
ربّما

28
00:03:11,540 --> 00:03:15,470
في النهاية، غادر شيكي تلك الفرقة

29
00:03:15,470 --> 00:03:17,980
هل أشتمّ رائحة... مشكلة؟

30
00:03:18,470 --> 00:03:19,680
الأمر ليس مزاحاً

31
00:03:19,680 --> 00:03:22,200
ربّما لم يتجاوزا المشكلة التي حدثت معهما

32
00:03:22,200 --> 00:03:23,460
هذا مُمكن

33
00:03:23,460 --> 00:03:27,560
آمل ألّا ينعكس هذا سلباً على حفل
تسوكيبرو الغنائي الذي اقترب

34
00:03:27,960 --> 00:03:31,650
أجل، لكن حدث هذا منذ زمنٍ بعيد

35
00:03:31,650 --> 00:03:34,200
شو وشيكي-سان بالغان

36
00:03:34,200 --> 00:03:37,570
أشكّ ببقاء أي مشاعر ضغينة بينهما

37
00:03:40,000 --> 00:03:42,190
أليس كذلك يا سو؟

38
00:03:50,780 --> 00:03:52,020
المعذرة

39
00:03:52,020 --> 00:03:54,330
أنا صحفيّ للمجلّةِ الأسبوعيّة، قمر

40
00:03:55,160 --> 00:03:56,350
ماذا؟

41
00:03:56,350 --> 00:03:57,840
هل هناك فضيحة؟

42
00:03:57,840 --> 00:04:00,660
لم آتِ إلى هنا لأجلكم

43
00:04:00,660 --> 00:04:05,950
لديّ بعض الأسئلة المتعلِّقة بشو إيزومي-سان
وشيكي تاكامورا-سان

44
00:04:05,950 --> 00:04:07,350
ما بهما؟

45
00:04:07,770 --> 00:04:10,320
أخبرتني العصفورة أنّ المزاج سيّئ

46
00:04:10,320 --> 00:04:14,540
بينهما منذ كانا في فرقتهما السّابقة

47
00:04:14,540 --> 00:04:16,020
قبل أيّام سمعتُ من الوكالة

48
00:04:16,020 --> 00:04:20,090
أنّهما لا يستطيعان العمل معاً

49
00:04:20,760 --> 00:04:21,950
سمعت بماذا؟

50
00:04:21,950 --> 00:04:25,610
ما هو شعوركم تجاه علاقتهما؟

51
00:04:26,020 --> 00:04:29,620
هل صحيح أنّهما لا يستطيعان العمل معاً؟

52
00:04:29,820 --> 00:04:32,620
الأمر ليس كذلك

53
00:04:32,620 --> 00:04:33,370
نستأذن

54
00:04:33,720 --> 00:04:35,080
هيّا بنا يا شباب

55
00:04:35,080 --> 00:04:36,210
...حسناً

56
00:04:40,480 --> 00:04:42,610
هل صحيحٌ أنّهما لا يستطيعان العمل معاً؟

57
00:04:42,610 --> 00:04:44,380
لا أدري

58
00:04:44,590 --> 00:04:48,390
لكن بدا ذلك الصحفي واثقاً

59
00:04:48,700 --> 00:04:53,390
ربّما يمكنهما العمل معاً ضمن
مجموعة، لكن ليس كثنائي

60
00:04:53,730 --> 00:04:55,690
هذا ليس مزاحاً مع ذلك

61
00:05:02,220 --> 00:05:06,640
...شو إيزومي، شيكي تاكامورا، خلاف

62
00:05:10,340 --> 00:05:13,230
يبدو أنّه لا أحد يتكلّم عن ذلك

63
00:05:16,660 --> 00:05:19,090
ربّما تكون مجرّد إشاعة

64
00:05:20,360 --> 00:05:21,420
نـ-نعم؟

65
00:05:22,340 --> 00:05:24,170
أيتشي، الشاي جاهز

66
00:05:24,650 --> 00:05:26,930
أنا قادمٌ في الحال

67
00:05:29,550 --> 00:05:34,080
!حفل تسوكيبرو: يومان في بودوكان

68
00:05:35,920 --> 00:05:39,530
!تذاكر العرض الحيّ تُباع في الأسواق الآن

69
00:05:44,080 --> 00:05:46,130
اقترب الوقت

70
00:05:46,130 --> 00:05:48,100
نعم، اقترب ذلك

71
00:05:48,100 --> 00:05:49,950
أنا متوتّرٌ منذ الآن

72
00:05:51,620 --> 00:05:55,450
ضيف الأسبوع المقبل في حوار الموسيقى

73
00:05:55,450 --> 00:05:57,210
—وبرنامج المنوّعات، مو توك، هو شيكي تاكامورا من سوليدس

74
00:05:57,210 --> 00:05:58,800
والآن أضف السلمون

75
00:05:59,500 --> 00:06:01,170
لماذا غيّرت القناة؟

76
00:05:59,670 --> 00:06:02,320
ثمّ أضف القريدس والتوفو والشيراتاكي

77
00:06:01,600 --> 00:06:02,960
بلا سبب

78
00:06:02,320 --> 00:06:05,300
،والملفوف الصّيني

79
00:06:04,910 --> 00:06:07,040
إناء السلمون السّاخن

80
00:06:05,300 --> 00:06:08,400
،والبصل ونبات الهليون

81
00:06:08,070 --> 00:06:09,840
كم أشعر بالحنين

82
00:06:08,400 --> 00:06:11,190
،وفطور شيتاكي وفطور شيميجي

83
00:06:11,190 --> 00:06:13,970
وغطِّ الإناء، ودعه يُغلى ببطء

84
00:06:16,970 --> 00:06:18,980
أتى صحفيّ غريب لرؤيتنا اليوم

85
00:06:20,190 --> 00:06:20,980
صحفيّ؟

86
00:06:21,240 --> 00:06:24,510
قال أنّك وشيكي-سان لن تتعاونا معاً

87
00:06:24,980 --> 00:06:26,490
هذا غير صحيح، أليس كذلك؟

88
00:06:28,020 --> 00:06:31,520
ينبغي أن تخبروا مثل هؤلاء الأشخاص
أن يراجعوا الوكالة

89
00:06:31,520 --> 00:06:34,740
معك حقّ. سأفعل ذلك في المرّة المقبلة

90
00:06:35,050 --> 00:06:35,780
جيّد

91
00:06:39,070 --> 00:06:41,560
لكن قال الصحفيّ

92
00:06:41,560 --> 00:06:45,750
أنّكما لم تنسجما منذ تواجدكما
في فرقتكما السّابقة

93
00:06:46,030 --> 00:06:47,850
أتصدّق ذلك؟

94
00:06:47,850 --> 00:06:49,430
يا لها من دعابة، صحيح؟

95
00:06:55,820 --> 00:06:57,520
شو؟

96
00:06:59,250 --> 00:07:02,190
فرقتنا السّابقة؟

97
00:07:03,620 --> 00:07:08,030
كنتُ في الثّالثة عشر من عمري
عندما التقيتُ بشيكي أوّل مرّة

98
00:07:15,070 --> 00:07:17,670
هذا هو شو إيزومي-كن، أحدث عضوّ لدينا

99
00:07:19,660 --> 00:07:21,400
سُرِرتُ بلقائكم

100
00:07:30,840 --> 00:07:33,860
،بصِفتي الأصغر في المجموعة، رأيتُ شيكي

101
00:07:33,860 --> 00:07:37,270
الذي كان يكبرني بثلاث سنوات، كشخص
ناضج جدّاً

102
00:07:38,020 --> 00:07:42,160
لم يكن يتصنّع الابتسامات وكان قليل الكلام

103
00:07:42,160 --> 00:07:45,420
لكنّه كان شخصاً صادقاً وواضحاً

104
00:07:46,040 --> 00:07:50,960
ربّما لهذا انسجمنا منذ لحظة لقائنا وبشكل غامض

105
00:07:51,450 --> 00:07:55,580
آنذاك، كنّا نقضي كلّ يوم معاً

106
00:07:56,460 --> 00:07:57,340
...لكن

107
00:08:01,860 --> 00:08:05,230
أريدك أن تعمل على تشكيلةٍ أوسع
من الأساليب الموسيقيّة

108
00:08:05,930 --> 00:08:08,590
لا تعتقد أنّني أرى موسيقى هذه المجموعة سيّئة

109
00:08:09,720 --> 00:08:11,520
كلّ ما في الأمر أنّها مُقيّدة جدّاً لي الآن

110
00:08:14,280 --> 00:08:15,950
سأخرج من المجموعة

111
00:08:17,240 --> 00:08:20,730
أريد العمل على الموسيقى التي أؤمن بها

112
00:08:21,450 --> 00:08:23,600
!لا داعي لتخرج كي تفعل ذلك

113
00:08:26,300 --> 00:08:30,660
سأكون مصدر إزعاج لبقيّتكم بتفضيلاتي

114
00:08:31,390 --> 00:08:32,290
...لكن

115
00:08:33,350 --> 00:08:35,560
لا أستطيع تقديم تنازلات في هذا الأمر

116
00:08:36,780 --> 00:08:38,060
خاصّة الموسيقى

117
00:08:42,480 --> 00:08:45,340
شو، أنا آسف

118
00:08:51,320 --> 00:08:52,380
آسف

119
00:09:04,660 --> 00:09:05,690
...شيكي

120
00:09:14,020 --> 00:09:17,160
تركني شيكي ورحل

121
00:09:21,680 --> 00:09:23,390
إنّه ماضٍ قديم

122
00:09:24,020 --> 00:09:25,800
لديّ جلسة تصوير في صباحِ الغدّ

123
00:09:25,800 --> 00:09:26,670
سأخلد إلى النّوم

124
00:09:26,980 --> 00:09:30,410
تصبح على خير

125
00:09:30,410 --> 00:09:32,170
نراك غداً

126
00:09:32,510 --> 00:09:33,260
نعم

127
00:09:38,140 --> 00:09:40,630
ربّما لا يمكنهما العمل معاً حقّاً

128
00:09:40,630 --> 00:09:41,360
ماذا؟

129
00:09:42,090 --> 00:09:43,960
الأمور معقّدة

130
00:09:43,960 --> 00:09:48,100
،إن قلتَ أنت أو شو أنّكما ستتركان كويل

131
00:09:48,100 --> 00:09:50,420
فلن أسامحكما

132
00:09:50,420 --> 00:09:51,440
نعم

133
00:09:51,740 --> 00:09:54,100
لن أغادر

134
00:09:54,100 --> 00:09:56,190
لا شو ولا أنا سنغادر

135
00:09:56,430 --> 00:09:57,940
بالطبع لن تغادرا

136
00:09:57,940 --> 00:09:58,810
أجل

137
00:09:59,720 --> 00:10:04,950
لكن لا أصدّق أنّ شو لن يتمكّن
من العمل مع شيكي

138
00:10:04,950 --> 00:10:06,710
لسببٍ شخصيّ كهذا

139
00:10:07,000 --> 00:10:10,330
ربّما هنالك بعض الأشياء التي لا يستطيع
أن يسامحه عليها

140
00:10:10,330 --> 00:10:11,930
شو إنسان أيضاً

141
00:10:11,930 --> 00:10:13,040
أجل

142
00:10:14,160 --> 00:10:15,960
أتعتقد ذلك؟

143
00:10:17,260 --> 00:10:20,070
بدأنا نتقرّب من سوليدس أخيراً أيضاً

144
00:10:20,520 --> 00:10:21,300
أجل

145
00:10:22,130 --> 00:10:25,380
هل سنفقد المكان الذي ننتمي إليه ثانية؟

146
00:10:25,880 --> 00:10:27,020
...أيتشي

147
00:10:28,340 --> 00:10:29,280
أيتشي؟

148
00:10:32,320 --> 00:10:34,860
لا تقلق. سأتولّى الأمر

149
00:10:34,860 --> 00:10:37,640
سأدع شو وشيكي-سان يتصالحان

150
00:10:44,890 --> 00:10:48,040
طلبتُ منكم جميعاً المجيء إلى هنا
لسببٍ واحد

151
00:10:48,520 --> 00:10:53,360
:عمليّة الصّداقة
شو وشيكي-سان تبدأ الآن

152
00:10:54,600 --> 00:10:56,360
عمليّة الصّداقة؟

153
00:10:56,360 --> 00:10:58,140
ما هذه؟ سأشارك فيها

154
00:10:58,140 --> 00:11:00,120
لنستمع إلى ما لديه ليقوله أولاً

155
00:11:00,120 --> 00:11:01,620
حسناً

156
00:11:01,620 --> 00:11:03,050
تابع

157
00:11:04,030 --> 00:11:04,980
حسناً

158
00:11:04,980 --> 00:11:10,420
ذات يوم، شو وشيكي-سان أنهيا صداقتهما

159
00:11:10,420 --> 00:11:11,310
حسناً

160
00:11:11,540 --> 00:11:15,100
لكنّهما كانا يعرفان بعضهما فترة أطول
من فتراتنا نحن

161
00:11:15,100 --> 00:11:17,820
إن تعاملا مع بعضهما بصدق، أعتقد أنّهما
يستطيعان التفاهم

162
00:11:18,000 --> 00:11:20,320
هكذا إذاً

163
00:11:20,520 --> 00:11:23,310
تعتقد أنّ ذلك سيفلح إذاً؟

164
00:11:24,330 --> 00:11:26,810
التقيتُ بسورا منذ فترة وجيزة

165
00:11:27,680 --> 00:11:31,890
هل شو-سان وشيكي-سان على خلاف؟

166
00:11:31,890 --> 00:11:34,840
شعرتُ أنّهما باردين في اجتماع القادة

167
00:11:34,840 --> 00:11:35,710
باردان؟

168
00:11:36,210 --> 00:11:38,300
أتكلّم وكأنّنا في القطب الجنوبي

169
00:11:38,300 --> 00:11:41,200
هل سيكون حفل تسوكيبرو بخير؟

170
00:11:43,130 --> 00:11:44,520
القطب الجنوبي؟

171
00:11:44,520 --> 00:11:45,600
...قطب جنوبي

172
00:11:47,640 --> 00:11:50,760
قد لا يكون الأمر بتلك البساطة

173
00:11:51,250 --> 00:11:54,620
عشر سنوات من الكراهيّة المتراكمة

174
00:11:54,620 --> 00:11:56,960
قد تجمّدَتْ فأمست جبلاً جليديّاً

175
00:11:57,680 --> 00:11:58,940
أفهم ما تعنيه

176
00:11:58,940 --> 00:12:02,150
قطعة الجبل الجليدي الذي تراه فوق
الماء هو قطعة صغيرة من الأصل فحسب

177
00:12:02,150 --> 00:12:06,050
تحت السّطح يوجد الجبل الجليدي العملاق
بحدِّ ذاته

178
00:12:11,420 --> 00:12:19,270
!لنعمل! لنعمل

179
00:12:19,270 --> 00:12:22,380
بصيغةٍ أخرى، لن يكون ذوبانه سهلاً

180
00:12:22,580 --> 00:12:26,480
هل سنخسر مكاننا الذي ننتمي إليه؟

181
00:12:26,890 --> 00:12:28,000
...أيتشي

182
00:12:28,000 --> 00:12:29,470
لـ-لا تقلقوا

183
00:12:29,470 --> 00:12:31,890
هذا ما خُلِقَتْ عمليّة الصداقة لأجله

184
00:12:32,330 --> 00:12:34,390
ماذا ستفعل بالضبط؟

185
00:12:36,600 --> 00:12:39,900
حفلة إناء ساخن

186
00:12:41,880 --> 00:12:42,900
حفلة إناء ساخن؟

187
00:12:42,900 --> 00:12:43,890
نعم

188
00:12:43,890 --> 00:12:47,050
مشاركة كويل وسوليدس لإناء ساخن دافئ

189
00:12:47,050 --> 00:12:49,390
سيذيب أي خلافات

190
00:12:50,480 --> 00:12:54,160
!مرحى! مرحى! مرحى! مرحى

191
00:12:55,860 --> 00:12:57,470
قد يفلح هذا

192
00:12:57,470 --> 00:13:00,420
يُقال أنّ الأكل من نفس الإناء
السّاخن يجمع الناس معاً

193
00:13:00,420 --> 00:13:01,420
"إنّه مجرّد "إناء

194
00:13:01,620 --> 00:13:02,940
فكرة سديدة يا أيتشي

195
00:13:02,940 --> 00:13:03,920
فكرة سديدة

196
00:13:04,300 --> 00:13:08,120
لدى شو وشيكي-سان عطلة غداً

197
00:13:08,120 --> 00:13:10,900
أريد أن أقيم حفلة الإناء السّاخن غداً

198
00:13:10,900 --> 00:13:12,180
حاضر

199
00:13:12,360 --> 00:13:17,140
لكن لا أضمن مجيئهما إن دعوناهما فحسب

200
00:13:17,140 --> 00:13:18,690
هذا احتمالٌ وارد

201
00:13:19,110 --> 00:13:23,690
لذا أعتقد أننا ينبغي أن نحتفظ بذلك سرّاً
عنهما ونحضرهما فجأة إلى الحفل

202
00:13:23,960 --> 00:13:26,200
إنّها حفلة مفاجئة إذاً

203
00:13:26,370 --> 00:13:29,340
تبدو فكرة حفلة إناء ساخن مفاجئة جميلة

204
00:13:29,340 --> 00:13:31,450
سنتكفّل بشيكي

205
00:13:31,740 --> 00:13:34,610
شكراً. ونحن سنتكفّل بشو

206
00:13:34,610 --> 00:13:38,460
إيتشي، إيسّي. سأحضّر الإناء السّاخن غداً

207
00:13:38,860 --> 00:13:41,930
هلّا أخذتما شو إلى مكانٍ ما حتّى المساء

208
00:13:41,930 --> 00:13:44,300
وذلك كي لا يكتشف أمر الحفلة؟

209
00:13:44,680 --> 00:13:45,490
عُلِم

210
00:13:45,490 --> 00:13:46,470
يمكنك الاعتماد علينا

211
00:14:00,010 --> 00:14:02,480
شو، لنخرج معاً

212
00:14:02,480 --> 00:14:04,710
بالتأكيد. إلى أين نحن ذاهبون؟

213
00:14:04,710 --> 00:14:06,120
إلى أين؟

214
00:14:06,120 --> 00:14:07,120
إلى أين ينبغي أن نذهب؟

215
00:14:07,540 --> 00:14:09,990
شو، لا بدَّ أن لديك مكان ترغب
في الذهابِ إليه

216
00:14:10,280 --> 00:14:14,490
في الواقع، كنتُ سأقضي اليوم
مسترخياً في غرفتي

217
00:14:14,650 --> 00:14:17,230
لا، عليك أن تذهب إلى مكانٍ ما

218
00:14:17,230 --> 00:14:18,500
لماذا؟

219
00:14:18,690 --> 00:14:21,500
—افعل فحسب، بوجودك، فإنّ الحـ

220
00:14:22,900 --> 00:14:25,630
شو، هلّا أتيت معي؟

221
00:14:25,630 --> 00:14:28,030
...لكن إتشيرو وإيسّي

222
00:14:28,030 --> 00:14:30,840
سأتولّى ذلك الأمر

223
00:14:30,840 --> 00:14:31,510
حسناً؟

224
00:14:32,470 --> 00:14:33,830
ما باليدِ حيلة الآن

225
00:14:33,830 --> 00:14:35,630
أنتما ستتكفّلان بالتحضير

226
00:14:35,630 --> 00:14:36,540
عُلِم

227
00:14:36,540 --> 00:14:37,660
اعتمد علينا

228
00:14:41,260 --> 00:14:44,580
أيتشي، ليس من عادتِك أن تدعوني
للذهابِ إلى مكانٍ ما

229
00:14:44,580 --> 00:14:45,510
إلى أين نحن ذاهبان؟

230
00:14:45,510 --> 00:14:48,150
...ماذا؟ في الواقع

231
00:15:04,040 --> 00:15:05,360
إنّه بودوكان

232
00:15:06,300 --> 00:15:07,390
نعم

233
00:15:08,620 --> 00:15:11,130
ما الذي أصابك يا أيتشي؟

234
00:15:11,130 --> 00:15:13,940
أردتُ تجديد عزيمتي قبل الحفل

235
00:15:14,360 --> 00:15:16,060
أردتُ أن آتي إلى هنا معك

236
00:15:18,020 --> 00:15:20,160
كنتُ أعمل وراء الكواليس كمعاون مدير

237
00:15:20,160 --> 00:15:23,810
لذا قريباً سأؤدّي على المسرح في بودوكان

238
00:15:23,810 --> 00:15:26,070
لم أتوقّع مستقبلاً كهذا أبداً

239
00:15:26,780 --> 00:15:29,010
أنا متأكّدٌ أنّ إيتشي وإيسّي ينتابهما نفس الشّعور

240
00:15:29,010 --> 00:15:32,070
...حياتنا قد تغيّرت

241
00:15:33,560 --> 00:15:35,080
منذ التقينا بك

242
00:15:49,990 --> 00:15:54,170
شو، شكراً لإيصالنا إلى هنا

243
00:15:54,550 --> 00:15:57,850
أردتُ أن أخبرك بذلك هنا

244
00:15:58,380 --> 00:15:59,460
...أيتشي

245
00:16:01,110 --> 00:16:04,800
آمل أن يستمع كثير من الناس
إلى الأغنية التي ألّفناها معاً

246
00:16:04,800 --> 00:16:05,930
أجل

247
00:16:05,930 --> 00:16:09,610
أنا متأكّدٌ أنّ سوليدس وسوارا وغروث
ينتابهم نفس الشّعور

248
00:16:11,280 --> 00:16:13,060
...لذا يا شو

249
00:16:14,920 --> 00:16:16,370
أيتشي، أنت لطيفٌ جدّاً

250
00:16:17,660 --> 00:16:21,090
دائماً ما تراعي مشاعر من حولك

251
00:16:21,510 --> 00:16:24,870
يعزو الفضلُ إليك بوصول كويل
إلى ما وصلت إليه

252
00:16:25,580 --> 00:16:28,160
ماذا؟ ما الذي تقوله فجأة؟

253
00:16:28,160 --> 00:16:30,870
أنا مشغولٌ بنفسي تماماً

254
00:16:31,530 --> 00:16:36,390
آمل أن يرى مزيدٌ من الناس جانبك هذا

255
00:16:50,330 --> 00:16:51,400
هل نذهب؟

256
00:16:52,030 --> 00:16:53,090
نعم

257
00:16:55,100 --> 00:16:58,890
سنأتي إلى هنا في المرّةِ المقبلة
لأجل الحفل

258
00:17:05,340 --> 00:17:06,920
!مفاجأة

259
00:17:07,250 --> 00:17:08,080
ماذا؟

260
00:17:10,000 --> 00:17:13,550
!عيد ميلاد سعيد يا أيتشي

261
00:17:14,680 --> 00:17:16,930
!تهانينا

262
00:17:16,930 --> 00:17:17,900
!يا له من نجاح

263
00:17:17,900 --> 00:17:18,580
ماذا؟

264
00:17:18,580 --> 00:17:19,680
آسف يا أيتشي

265
00:17:20,140 --> 00:17:21,810
!يا صديقنا العزيز

266
00:17:22,060 --> 00:17:23,810
كان مقلباً ضدّك

267
00:17:24,280 --> 00:17:26,690
عدم قدرتي أنا وشو على العملِ
معاً كان كذبة

268
00:17:30,710 --> 00:17:32,320
ماذا؟

269
00:17:32,680 --> 00:17:36,360
"نصوّر حلقة خاصّة "ما قبل حفل تسوكيبرو

270
00:17:36,360 --> 00:17:39,070
جزء منها يتضمّن مقلباً

271
00:17:39,420 --> 00:17:41,670
وتمّ اختيارك كهدف

272
00:17:41,670 --> 00:17:43,080
ولماذا أنا؟

273
00:17:43,280 --> 00:17:45,200
لأنّه كان عيد ميلادك

274
00:17:45,200 --> 00:17:49,820
ولأنّنا أردنا من الناس أن يروا

275
00:17:49,820 --> 00:17:53,090
كلّ العمل الذي تقوم به بلا مقابل

276
00:17:53,310 --> 00:17:56,420
إذاً البرنامج الحواري الذي ظهرنا فيه معاً؟

277
00:17:56,420 --> 00:17:57,840
كان مزيّفاً

278
00:17:57,840 --> 00:18:02,070
والأجواء الجليديّة في اجتماع القادة؟

279
00:18:02,070 --> 00:18:04,550
مزيّفة أيضاً

280
00:18:04,350 --> 00:18:05,710
!أجل

281
00:18:07,120 --> 00:18:11,650
في البدايةِ لم نكن ننوي خداعك

282
00:18:11,650 --> 00:18:13,830
،لكن كما قال ريكّا

283
00:18:13,830 --> 00:18:17,360
ارتأينا أنها ستكون فرصة جيّدة
لإظهار جانبك الطيّب للناس

284
00:18:17,840 --> 00:18:22,370
أنا متأكّدٌ أنّنا التقطنا لقطات كثيرة
من جانبك الطيّب الخفيّ الطبيعي

285
00:18:22,920 --> 00:18:24,120
صوّرتُها كلّها

286
00:18:24,310 --> 00:18:26,680
!ماذا؟ أنت ذلك الصحفيّ

287
00:18:26,680 --> 00:18:28,370
طاب يومك

288
00:18:30,060 --> 00:18:32,130
كلّ ذلك كان مخطّطاً إذاً

289
00:18:34,580 --> 00:18:37,550
إيتشي، إيسّي، تحسّن أداؤكما في التمثيل

290
00:18:37,550 --> 00:18:39,500
أيتشي، كان خِداعك سهلاً

291
00:18:39,500 --> 00:18:42,890
لكن بدا السيناريو معقولاً على نحوٍ غريب

292
00:18:43,340 --> 00:18:47,490
شعرتُ أن شيئاً قد حدث فعلاً بين شو
وشيكي-سان

293
00:18:47,490 --> 00:18:51,230
بدا شو حزيناً بينما كان يتأمَّل الماضي

294
00:18:51,630 --> 00:18:53,320
كانت تلك الجزئيّة حقيقيّة

295
00:18:54,650 --> 00:18:59,320
إنّ تذكُّر تلك اللحظة ما زالت تجعل
صدري يضيق

296
00:18:59,320 --> 00:19:01,930
قلتُ أنني آسف

297
00:19:02,450 --> 00:19:04,160
هل سأقولها إلى يوم مماتي؟

298
00:19:04,340 --> 00:19:06,840
وحتّى بعد مماتك على الأرجح

299
00:19:12,000 --> 00:19:14,440
!عيد ميلاد سعيد يا أيتشي

300
00:19:14,440 --> 00:19:15,630
شكراً لكم

301
00:19:17,120 --> 00:19:19,330
كم هذا مُترف

302
00:19:19,330 --> 00:19:21,360
لدينا إناء سلمون ساخن، وإناء كيمتشي ساخن

303
00:19:21,360 --> 00:19:24,430
وإناء كاري الخضار السّاخن المفضّل لديك

304
00:19:24,620 --> 00:19:27,450
أنا وإيسّي أعددنا إناء السلمون السّاخن

305
00:19:27,450 --> 00:19:29,620
السّلمون من هوكّايدو

306
00:19:29,620 --> 00:19:30,940
حقّاً؟

307
00:19:31,200 --> 00:19:34,230
منذ رحيلك والمطبخ في حالةِ فوضى

308
00:19:34,230 --> 00:19:34,940
ماذا؟

309
00:19:40,140 --> 00:19:44,750
احتجنا لأيتشي ليعلّمنا ماذا نفعل

310
00:19:44,750 --> 00:19:46,390
كنتَ سبب الفوضى

311
00:19:54,260 --> 00:19:59,630
أعدّوا هذا لك سرّاً في اللّيلة الماضية

312
00:20:03,190 --> 00:20:06,840
...شو، إيتشي، إيسّي

313
00:20:08,310 --> 00:20:10,230
أيتشي، تمنَّ أمنية

314
00:20:18,780 --> 00:20:21,740
أتمنّى أن ينجح حفل تسوكيبرو الغنائي

315
00:20:21,740 --> 00:20:24,730
يجب أن تتمنّى الأمنية بينك وبين نفسك

316
00:20:25,560 --> 00:20:27,410
!أسحب كلامي

317
00:20:27,410 --> 00:20:29,940
...لا، لا أسحبه، لكن

318
00:20:30,620 --> 00:20:32,250
انفخ الشّموع فحسب

319
00:20:33,440 --> 00:20:34,250
حسناً

320
00:21:03,390 --> 00:21:04,280
...أيتشي

321
00:21:04,900 --> 00:21:09,520
أتذكر كيف شكرتني في بودوكان
منذ فترة؟

322
00:21:09,520 --> 00:21:10,160
أجل

323
00:21:10,700 --> 00:21:13,160
ينبغي أن أشكرك

324
00:21:15,240 --> 00:21:18,050
،عندما توقّفت فرقتي السّابقة عن العمل

325
00:21:18,050 --> 00:21:20,640
لم أكن أدري ماذا أفعل

326
00:21:20,640 --> 00:21:22,800
تمكّنتُ من البدءِ بالعمل ثانية

327
00:21:23,520 --> 00:21:26,680
بفضلكما يا إتشيرو وإيسّي

328
00:21:27,340 --> 00:21:28,450
...شو

329
00:21:32,470 --> 00:21:34,460
أنا سعيدٌ حقاً

330
00:21:35,360 --> 00:21:39,190
لوجودي معكم

331
00:21:41,300 --> 00:21:43,820
عيد ميلاد سعيد يا أيتشي