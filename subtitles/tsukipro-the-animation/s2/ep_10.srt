1
00:00:11,320 --> 00:00:13,410
ألست تستعجل قليلاً؟

2
00:00:14,300 --> 00:00:15,950
أنت لا تتغيّر أبداً

3
00:00:15,950 --> 00:00:19,650
أيضاً أنت مستيقظ باكراً جداً أيها الكسول

4
00:00:54,480 --> 00:00:55,530
ماذا؟

5
00:01:01,710 --> 00:01:03,830
يورو، ستبدأ الألعاب النارية

6
00:01:03,830 --> 00:01:05,210
لنسرع

7
00:01:05,210 --> 00:01:06,290
حسناً

8
00:02:50,720 --> 00:02:53,420
كم بقي لي؟

9
00:02:53,420 --> 00:02:54,860
ثلاثة أشهر

10
00:02:55,360 --> 00:02:56,780
أنا آسف

11
00:03:03,310 --> 00:03:05,370
لا تقلق من أي شيء

12
00:03:05,910 --> 00:03:11,370
أعِدُك... سأثأر لها

13
00:03:13,390 --> 00:03:14,210
!إيقاف

14
00:03:14,210 --> 00:03:16,940
يورو-كن، أبليتَ بلاء ممتازاً. مذهل

15
00:03:16,940 --> 00:03:18,740
اقشعرّ بدني وأنا أشاهدك

16
00:03:18,740 --> 00:03:20,130
شكراً لك

17
00:03:26,260 --> 00:03:28,060
حظيت بإطراء كبير حقاً

18
00:03:28,060 --> 00:03:31,260
أنا فخور بك أيضاً. أنت ممثّل عظيم

19
00:03:31,260 --> 00:03:32,390
كفّ عن ذلك

20
00:03:34,290 --> 00:03:35,900
هل أنتما جاهزان للذهاب؟

21
00:03:35,900 --> 00:03:38,450
آسف يا داي-تشان. نحتاج لبضع دقائق إضافيّة

22
00:03:38,450 --> 00:03:41,150
حسناً. سأنتظر في السيّارة

23
00:03:41,150 --> 00:03:42,600
حسناً

24
00:03:43,970 --> 00:03:46,660
...تمرين رقص بعد تصوير دراما

25
00:03:46,660 --> 00:03:49,170
حياة النجوم مزدحمة بالأعمال حقّاً

26
00:03:49,170 --> 00:03:51,260
من يطلق على نفسه نجماً؟

27
00:03:51,260 --> 00:03:56,180
وُلِد يو هازوكي-كن ليرسم البسمة في شفاه
كلّ الفتيات في العالم

28
00:03:56,180 --> 00:03:58,800
—مظهر وسيم و

29
00:03:58,800 --> 00:04:00,170
حسناً، هذا يكفي

30
00:04:00,170 --> 00:04:03,240
ما هي الأغنية التي سنتدرّب عليها اليوم؟

31
00:04:03,240 --> 00:04:04,810
داكاي" على ما أعتقد"

32
00:04:04,810 --> 00:04:07,070
!جميل

33
00:04:07,070 --> 00:04:09,640
يورو، هل تتذكّر الرقصة الخاصّة بها؟

34
00:04:09,640 --> 00:04:10,640
أظنّ ذلك

35
00:04:10,640 --> 00:04:12,880
مضى وقت منذ أدّيناها

36
00:04:12,880 --> 00:04:15,230
حسناً، أنا متأكّد أنّك ستتذكّرها
تلقائياً عندما نرقص

37
00:04:15,230 --> 00:04:16,190
أجل

38
00:04:26,150 --> 00:04:27,470
جميل جداً يا يورو

39
00:04:27,470 --> 00:04:30,080
قمت بكلّ الحركات المفصّلة بإتقان
أثناء الالتفاف

40
00:04:30,080 --> 00:04:31,680
والتي كنت تفوّتها من قبل

41
00:04:31,680 --> 00:04:32,880
أحسنت صنعاً

42
00:04:32,880 --> 00:04:34,710
شكراً لك

43
00:04:35,060 --> 00:04:36,590
ماذا عنّي؟

44
00:04:36,590 --> 00:04:37,760
كنتَ جيّداً أيضاً

45
00:04:37,760 --> 00:04:39,860
!فقط؟ يا له من تمييز

46
00:04:41,050 --> 00:04:43,450
أحسنت صنعاً. تمرّنتَ بمفردك، أليس كذلك؟

47
00:04:43,800 --> 00:04:45,600
قليلاً

48
00:04:45,600 --> 00:04:49,580
على هذا المنوال، قد لا يمضي وقت طويل
قبل أن يتفوّق عليك يورو يا يو

49
00:04:49,580 --> 00:04:50,690
!مُحال

50
00:04:50,690 --> 00:04:53,640
!لا يمكن لأحد أن يهزمني في الرّقص

51
00:04:53,640 --> 00:04:56,190
،بما أنّ رقص يورو قد تحسّن

52
00:04:56,190 --> 00:05:00,020
ما رأيكما أن نستعرض بعضاً من حركات الرّقص
الجديدة والمُحسّنة في مهرجان البدر؟

53
00:05:00,020 --> 00:05:02,070
جديدة ومُحسّنة؟

54
00:05:06,040 --> 00:05:08,680
كنتُ أفكّر في تغيير جزء من الرقصة

55
00:05:08,680 --> 00:05:13,200
للمُطابقة وذلك بإضافة بعض الحركات البهلوانيّة المدهشة

56
00:05:13,200 --> 00:05:15,240
حركات بهلوانيّة؟

57
00:05:15,240 --> 00:05:16,660
أتستطيع فعلها يا يورو؟

58
00:05:16,660 --> 00:05:17,580
سأفعل ما بوسعي

59
00:05:17,870 --> 00:05:21,090
حسناً. لنُرِ الجمهور كم تطوّرتما

60
00:05:21,470 --> 00:05:22,280
!أجل

61
00:05:31,120 --> 00:05:32,460
يورو، هل أنت بخير؟

62
00:05:32,460 --> 00:05:35,020
...آسف... أحتاج لدقيقة

63
00:05:35,930 --> 00:05:37,350
آسف، هل يمكننا التوقّف؟

64
00:05:37,350 --> 00:05:40,070
أثقلنا عليكما منذ البداية

65
00:05:40,780 --> 00:05:42,400
أنا بخير

66
00:05:42,740 --> 00:05:44,780
لا ينبغي أن تضغط على نفسك

67
00:05:44,780 --> 00:05:47,470
سمعتُ أنّك خضعت لجلسة تصوير مبكّرة هذا الصّباح

68
00:05:47,470 --> 00:05:49,070
آسف لإثقالي كثيراً عليك

69
00:05:49,070 --> 00:05:52,030
لا تقلق بشأن ذلك. صدّقني، أنا بخير

70
00:05:52,030 --> 00:05:54,200
إيشيهارا-سان

71
00:05:54,200 --> 00:05:59,380
كنتُ أقول لنفسي... ماذا لو أضفنا حركة
صغيرة مسلّية أثناء الفترة الفاصلة؟

72
00:05:59,380 --> 00:06:01,290
شيء من هذا القبيل

73
00:06:02,060 --> 00:06:04,550
ألا يبدو هذا مسلّياً؟

74
00:06:04,550 --> 00:06:06,590
قد يتمكّن المُعجبون من تقليدها أيضاً

75
00:06:06,590 --> 00:06:10,140
لكن يا يو، الحركات بحدّ ذاتها ليست مختلفة كثيراً

76
00:06:10,140 --> 00:06:12,430
عن الرّقصة التي قبلها مباشرة

77
00:06:12,430 --> 00:06:14,940
سأجد حلّاً لذلك

78
00:06:14,940 --> 00:06:17,220
خذ الأمور برويّة يا يورو

79
00:06:17,220 --> 00:06:17,950
خذ

80
00:06:17,950 --> 00:06:18,730
شكراً

81
00:06:24,710 --> 00:06:26,070
التخفيف سيكون أنسب هنا

82
00:06:26,070 --> 00:06:27,880
إنّه خيار مُتاح

83
00:06:27,880 --> 00:06:28,700
يو

84
00:06:29,090 --> 00:06:32,740
تعِبَ إيشيهارا-سان كثيراً لينظّم
الرقصة الجديدة لنا

85
00:06:32,740 --> 00:06:33,560
—ألا ينبغي لنا أن

86
00:06:33,560 --> 00:06:34,940
لا تقلق بشأن ذلك

87
00:06:34,940 --> 00:06:38,080
استرِح فحسب. دعني أتولّى مسألة الرّقص

88
00:06:40,040 --> 00:06:41,790
أنا بخير الآن

89
00:06:41,790 --> 00:06:43,510
لنعاود المحاولة

90
00:06:44,490 --> 00:06:45,920
لا تُتعِب نفسك

91
00:06:45,920 --> 00:06:49,340
لديك تصوير في صباح الغد أيضاً. يمكنني
...استغلال الوقت للتفكير بـ

92
00:06:49,340 --> 00:06:51,470
هل تحاول أن تبسّط الأمور لتجعلها مناسبة لي؟

93
00:06:52,890 --> 00:06:54,730
لم أقل ذلك

94
00:06:54,730 --> 00:06:56,560
لكن في نهاية المطاف، نفس الشيء، صحيح؟

95
00:06:57,100 --> 00:06:59,080
،أقدّر الفكرة

96
00:06:59,080 --> 00:07:02,790
لكن لا أعتبر نفسي شريكاً إذا كان
كلّ ما أفعله هو اتّباعك

97
00:07:04,660 --> 00:07:06,630
لا تنفعل كثيراً

98
00:07:06,630 --> 00:07:08,570
أنا جادّ

99
00:07:09,250 --> 00:07:10,270
...يورو

100
00:07:13,340 --> 00:07:15,620
آسف. أنا ذاهب لغسل وجهي

101
00:07:23,190 --> 00:07:24,190
!يورو

102
00:07:25,420 --> 00:07:28,760
هل تدرّبت على الرقص؟
—نستعدّ أيضاً لمهرجان الرقص

103
00:07:28,760 --> 00:07:30,260
المعذرة

104
00:07:39,530 --> 00:07:41,180
هل يمكننا التكلّم؟

105
00:07:41,180 --> 00:07:42,050
بالتأكيد

106
00:07:44,230 --> 00:07:45,060
أتريد الجلوس؟

107
00:07:45,060 --> 00:07:46,720
لا، هنا مناسب

108
00:07:46,720 --> 00:07:48,070
حسناً

109
00:07:49,190 --> 00:07:50,950
آسف بشأن ما سبق

110
00:07:51,790 --> 00:07:57,310
لكن لم أكن أحاول تبسيط شيء ليتناسب معك

111
00:07:57,310 --> 00:08:01,640
أجل. انفعلتُ قليلاً

112
00:08:02,350 --> 00:08:05,210
ربّما لأنّك ضربت على وتر حسّاس

113
00:08:05,550 --> 00:08:07,040
ضربتُ على وتر حسّاس؟

114
00:08:07,810 --> 00:08:12,800
بتُّ أثق قليلاً بعملي مؤخراً

115
00:08:13,730 --> 00:08:16,500
ربّما اغتررتُ دون أن أشعر بذلك

116
00:08:17,660 --> 00:08:23,760
لكن حالما بدأنا بالرقص، أدركتُ أنّ
الطريق ما زال أمامي طويلاً

117
00:08:24,180 --> 00:08:25,730
جعلني ذلك أستيقظ

118
00:08:25,730 --> 00:08:29,500
هذا غير صحيح. تطوّرتَ كثيراً

119
00:08:29,500 --> 00:08:32,490
أتقول هذا بعد أن بسّطتَ الرّقص لأجلي؟

120
00:08:33,050 --> 00:08:36,260
تباً، حسناً. أعترف بذلك

121
00:08:36,260 --> 00:08:40,200
فكّرتُ في أننا ينبغي أن نخفّف مستوى
الصعوبة ونصعد شيئاً فشيئاً

122
00:08:40,200 --> 00:08:42,120
أنت تبسّط الأمر فعلاً إذاً

123
00:08:43,030 --> 00:08:45,040
!دعني أكمل

124
00:08:45,040 --> 00:08:47,340
قلتُ لنفسي بمقدورنا أن نخطو
خطوة بخطوة فحسب

125
00:08:53,050 --> 00:08:55,050
هكذا إذاً

126
00:08:56,600 --> 00:08:59,390
بربّك، ثِق بي

127
00:08:59,390 --> 00:09:00,660
آسف

128
00:09:01,290 --> 00:09:04,020
لكن يمكنني قول نفس الكلام لك

129
00:09:05,830 --> 00:09:10,150
أجل... أظنّك على حقّ

130
00:09:12,110 --> 00:09:14,900
...آسف. عليّ الاستيقاظ في الصباح الباكر، لذا

131
00:09:14,900 --> 00:09:17,710
ستكمل التصوير غداً؟

132
00:09:17,710 --> 00:09:20,370
أجل. وستنتهي بعد غد، صحيح؟

133
00:09:20,370 --> 00:09:24,060
أجل. لذا أعتقد سنعمل بشكل منفصل غداً

134
00:09:24,060 --> 00:09:24,860
أجل

135
00:09:25,800 --> 00:09:28,540
آسف لإزعاجك بالتوفيق لك غداً

136
00:09:28,540 --> 00:09:29,330
تصبح على خير

137
00:09:29,330 --> 00:09:30,880
أجل، تصبح على خير

138
00:09:50,760 --> 00:09:52,740
—يو، أنا آسف. كنتُ

139
00:09:53,900 --> 00:09:54,930
...المعذرة

140
00:09:54,930 --> 00:09:57,490
أتيتُ لدعوتك إلى حفل في آخر اللّيل

141
00:09:58,160 --> 00:09:58,960
ماذا؟

142
00:10:07,250 --> 00:10:09,850
آسف للمجيء بلا موعد

143
00:10:09,850 --> 00:10:12,840
لا عليك. تفاجأتُ فحسب، لكن أنا مسرور بمجيئك

144
00:10:12,840 --> 00:10:14,770
حدثت أمور كثيرة

145
00:10:15,120 --> 00:10:16,760
...كانت كثيرة

146
00:10:16,760 --> 00:10:18,600
هل حدث شيء مع يو؟

147
00:10:19,650 --> 00:10:21,560
إذا أردت أن تتكلّم، فكلّنا آذان صاغية

148
00:10:27,370 --> 00:10:28,760
...في الحقيقة

149
00:10:32,110 --> 00:10:35,360
هكذا إذاً. هذا ما حدث

150
00:10:35,360 --> 00:10:39,420
لستُ غاضباً من يو. أنا غاضب من نفسي

151
00:10:39,420 --> 00:10:42,050
مهما مضى من وقت، يبقى متفوّقاً عليّ

152
00:10:42,050 --> 00:10:44,830
.ليس ذلك فقط، لكنّه يغطّي عنّي أيضاً
هذا مثير للشفقة

153
00:10:44,830 --> 00:10:45,820
...لكن

154
00:10:46,290 --> 00:10:47,620
...يورو

155
00:10:47,620 --> 00:10:50,320
حسناً، لنشرب اللّيلة

156
00:10:50,320 --> 00:10:53,380
عندما تكتئب، لا شيء أفضل من شاي دافئ وحلويّات

157
00:10:53,380 --> 00:10:54,620
معك حقّ

158
00:10:55,310 --> 00:10:57,420
هارو-سان، هل تكتئب أيضاً؟

159
00:10:57,420 --> 00:10:59,770
أجل، طوال الوقت

160
00:10:59,770 --> 00:11:02,590
منذ مدّة قصيرة، تلقّى هاجيمي عرضاً

161
00:11:02,590 --> 00:11:05,390
للعمل في جزء جديد لمسرحية
مثّل بطولتها في العام الماضي

162
00:11:05,390 --> 00:11:09,890
لكن لم يلائم ذلك جدوله، لذا وافقتُ
على فعل ذلك بدلاً عنه

163
00:11:10,890 --> 00:11:13,300
كانت تلك المسرحيّة رائعة

164
00:11:13,300 --> 00:11:15,270
أثّر أداؤك بي كثيراً

165
00:11:15,270 --> 00:11:16,570
شكراً

166
00:11:16,570 --> 00:11:19,780
لكن جعلني أشعر برغبة في تحسين نفسي أكثر

167
00:11:19,780 --> 00:11:22,140
ماذا؟ لماذا؟

168
00:11:22,140 --> 00:11:25,800
كان مشهد المبارزة بالسّيف من المشاهد
المميّزة في العرض

169
00:11:25,800 --> 00:11:30,250
لم يكن أدائي قريباً من أداء هاجيمي البتّة

170
00:11:30,760 --> 00:11:33,880
أدركتُ أنّي ما زلتُ بحاجة لتحسين مستوايّ

171
00:11:33,880 --> 00:11:37,210
لستَ مخطئاً بشأن مشهد المُبارزة

172
00:11:37,210 --> 00:11:40,390
هاجيمي-سان رهيب حقّاً

173
00:11:40,390 --> 00:11:44,000
يتدرّب على فنون القتال القديمة. هذا ليس هيّناً

174
00:11:44,350 --> 00:11:47,350
لكن أظنّك جيّداً أيضاً

175
00:11:48,790 --> 00:11:51,960
،ليتني أقبل إطراءك

176
00:11:51,960 --> 00:11:55,750
لكن عندما يكون هناك شخص بجانبك
،أفضل منك بكثير

177
00:11:55,750 --> 00:11:57,690
فلا يسعك سوى أن تقارن نفسك

178
00:11:57,690 --> 00:11:59,030
أفهمك

179
00:11:59,030 --> 00:12:01,680
نقاط قوّة شريكك تبرز أكثر

180
00:12:01,680 --> 00:12:03,780
لأنّك تقف بجانبه

181
00:12:03,780 --> 00:12:06,380
ماذا؟ أنت أيضاً يا أوي؟

182
00:12:06,380 --> 00:12:11,530
مؤخراً، ظهرتُ أنا وأراتا في دراما خاصّة ذات فصل واحد

183
00:12:11,530 --> 00:12:14,210
رأيتُها. سجّلتُها وشاهدتُها عدّة مرّات

184
00:12:14,210 --> 00:12:16,500
كنتما رائعين

185
00:12:16,500 --> 00:12:18,100
شكراً

186
00:12:18,100 --> 00:12:20,180
كان دوراً صعباً حقاً

187
00:12:20,180 --> 00:12:23,320
استغرقني عدّة أيّام لأفهمه

188
00:12:23,320 --> 00:12:26,940
،لكن بعد قراءة النصّ مرّة واحدة فقط

189
00:12:26,940 --> 00:12:29,850
"قال أراتا، "فهمتُ تقريباً شعور هذا الرجل

190
00:12:29,850 --> 00:12:31,310
ذلك هو طبعه

191
00:12:31,310 --> 00:12:33,350
إنّه مرن ويعيش على الفطرة

192
00:12:33,350 --> 00:12:35,150
هذا صحيح

193
00:12:35,850 --> 00:12:39,710
عندما تعمل مع شخص كثنائي، فغالباً
ما تُقارنَان ببعضكما الآخر

194
00:12:39,710 --> 00:12:42,030
تصبح الاختلافات بينكما واضحة

195
00:12:42,030 --> 00:12:47,000
...لهذا نسعى لسدّ تلك الفجوة، لكن

196
00:12:47,740 --> 00:12:54,040
من الناحية الأخرى، مشاهدة شريكي
يتطوّر تُسعدني حقاً

197
00:12:54,040 --> 00:12:55,990
أنا أيضاً

198
00:12:55,990 --> 00:13:00,440
أحياناً يُسعدني أكثر أن أرى أراتا يتلقّى
إطراء أكثر من أن أتلقّاه أنا

199
00:13:00,440 --> 00:13:01,280
مثلي

200
00:13:01,280 --> 00:13:07,460
يو هو منافسي الأعظم، لكن أحياناً أعتقد
أنّني المُعجب الأوّل به

201
00:13:10,220 --> 00:13:12,290
أشعر بالراحة بعض الشيء

202
00:13:12,290 --> 00:13:19,000
مثلي، تشعرون بإحباط أحياناً عندما
تُقارَنون بشركائكم

203
00:13:22,390 --> 00:13:24,070
شكراً لك

204
00:13:24,070 --> 00:13:26,480
كم أنا محظوظ بأكل طعام لذيذ كهذا

205
00:13:28,180 --> 00:13:31,740
وبما أنّنا نتحدّث عن سرّنا الصغير، فهذا حماسيّ

206
00:13:34,210 --> 00:13:39,080
ماذا كان هاجيمي-سان وأراتا ويو سيقولون
برأيكم إذا علموا بهذا الأمر؟

207
00:13:39,080 --> 00:13:42,130
أنا واثق أنّ أراتا كان ليصرّ على أنّنا
كان ينبغي أن ندعوه

208
00:13:42,740 --> 00:13:44,120
،لو علِمَ يو

209
00:13:44,120 --> 00:13:47,680
فمن المؤكّد أنّه سيتناول شيئاً مُشبِعاً
بدلاً من حلويّات

210
00:13:49,910 --> 00:13:52,310
كيف ستكون ردّة فعل هاجيمي-سان؟

211
00:13:54,250 --> 00:13:56,140
سوف ينضمّ لنا فحسب

212
00:13:57,390 --> 00:14:01,460
هذا صحيح. الغريب أنّ هاجيمي-سان
ميّال للحلويّات

213
00:14:02,140 --> 00:14:04,820
حفلة شاي في آخر اللّيل مع هاجيمي-سان؟

214
00:14:05,360 --> 00:14:08,650
أظنّني سأجرّب ذلك أيضاً

215
00:14:09,150 --> 00:14:13,030
لكن أعتقد أنّ بعض الناس سيشعرون بالغيرة

216
00:14:14,770 --> 00:14:19,750
إذاً لنجعل حفلة الشّاي الليليّة هذه سرّاً

217
00:14:21,320 --> 00:14:23,690
الشّراكة غريبة

218
00:14:23,690 --> 00:14:29,630
بصراحة، عندما أرى أراتا يتألّق، يجعلني
هذا أرغب في مضاعفة جهودي أكثر

219
00:14:30,000 --> 00:14:34,640
لكن في ذات الوقت، أريده أن يبلي أفضل أيضاً

220
00:14:34,640 --> 00:14:36,880
أفهمك. أفهمك تماماً

221
00:14:36,880 --> 00:14:42,160
بسبب اختلاف الشريكين، يُقارَنان من كافّة النواحي

222
00:14:42,160 --> 00:14:44,150
هذا يجعل الآخرين يُعجبون بهما

223
00:14:47,290 --> 00:14:49,170
شكراً على هذه اللّيلة

224
00:14:49,170 --> 00:14:51,410
أشعر براحة الآن

225
00:14:53,350 --> 00:14:54,410
تصبحان على خير

226
00:14:54,410 --> 00:14:55,990
تصبح على خير يا يورو

227
00:14:55,990 --> 00:14:58,580
تصبحان على خير يا هارو-سان وأوي

228
00:15:06,690 --> 00:15:08,900
يو، أيمكنني الدخول؟

229
00:15:11,180 --> 00:15:12,760
هل هو نائم؟

230
00:16:14,550 --> 00:16:15,520
تفضّل

231
00:16:16,330 --> 00:16:18,680
ناغاتسكي-سان، تأهّب من فضلك

232
00:16:18,680 --> 00:16:19,790
حسناً

233
00:16:21,790 --> 00:16:24,600
لمَ لا أقتلك الآن؟

234
00:16:24,600 --> 00:16:27,450
لأنني لا أستطيع أن أدع هذا ينتهي
بمجرّد لحظة معاناة

235
00:16:27,450 --> 00:16:31,720
...سأفعل بك ما فعلتَه بها تماماً

236
00:16:31,720 --> 00:16:34,970
العذاب والخوف واليأس

237
00:16:35,350 --> 00:16:39,840
لن أقتلك أبداً. هذه هي عقوبتك

238
00:16:41,020 --> 00:16:42,080
!إيقاف

239
00:16:42,480 --> 00:16:45,280
وهنا الخِتام يا يورو ناغاتسكي-سان

240
00:16:47,160 --> 00:16:48,810
أحسنت صنعاً

241
00:16:50,460 --> 00:16:51,890
!شكراً جزيلاً

242
00:17:04,170 --> 00:17:05,300
بورِك عملُك

243
00:17:05,300 --> 00:17:07,440
نل بعضاً من الرّاحة اللّيلة يا يورو

244
00:17:07,440 --> 00:17:08,840
!شكراً على كلّ شيء

245
00:17:21,170 --> 00:17:22,540
مع الأسف

246
00:17:23,100 --> 00:17:25,160
انتهت الألعاب الناريّة للتو

247
00:17:25,160 --> 00:17:26,280
...يو

248
00:17:26,280 --> 00:17:28,270
مُبارك الانتهاء من التصوير

249
00:17:28,270 --> 00:17:30,080
أنا مندهش من معرفتك بأنّني سأكون هنا

250
00:17:30,080 --> 00:17:32,470
أقصد، توقعتُ أن تعرف ذلك

251
00:17:32,470 --> 00:17:35,480
يو، أنا آسف حقاً

252
00:17:35,480 --> 00:17:36,840
—مهلاً، كنتُ سأقول

253
00:17:36,840 --> 00:17:38,420
هذه غلطتي أنا

254
00:17:38,420 --> 00:17:43,460
أردتُ في الواقع الاعتذار مسبقاً، لكن
بصِفتي شريكك، كنتُ فخوراً جداً

255
00:17:44,170 --> 00:17:45,160
أنا آسف

256
00:17:45,580 --> 00:17:47,920
،حالياً، ما زلتُ أعرقلك

257
00:17:48,510 --> 00:17:50,710
لكن لا أريد أن أدعك تنزل إلى مستوايّ

258
00:17:50,710 --> 00:17:55,300
أريد أن أعمل بجدّ وأتحسّن كي أصل إلى مستواك

259
00:17:55,300 --> 00:17:58,120
ماذا؟ متى عرقلتني بالضبط؟

260
00:17:58,120 --> 00:18:00,640
انتظر. دعني أكمل

261
00:18:00,640 --> 00:18:01,810
حسناً

262
00:18:02,230 --> 00:18:04,910
،بصراحة، مهما عملتُ جاهداً

263
00:18:04,910 --> 00:18:08,570
أشكّ في أنّني سأكون راقصاً مثالياً مثلك

264
00:18:08,570 --> 00:18:09,850
أعلم ذلك

265
00:18:10,580 --> 00:18:14,950
لكن بدلاً من البدء في منطقة الرّاحة
،خاصّتي وفعل ما يمكنني فعله

266
00:18:14,950 --> 00:18:16,360
أريد تحدّي نفسي

267
00:18:16,360 --> 00:18:21,580
أريد أن أتطوّر أيضاً... بجانبك. أريد
أن أبذل مجهوداً

268
00:18:21,580 --> 00:18:23,160
!أريد تلك الفرصة

269
00:18:25,730 --> 00:18:26,750
هذا طبيعي

270
00:18:28,120 --> 00:18:31,400
ما أقوله أنّنا سنعمل بجدّ معاً يا شريكي

271
00:18:32,670 --> 00:18:33,800
...يو

272
00:18:35,220 --> 00:18:36,670
يورو، هل أنت بخير؟

273
00:18:36,670 --> 00:18:38,870
...شعرتُ فجأة بضعف نتيجة الاطمئنان

274
00:18:38,870 --> 00:18:40,640
ضعف نتيجة الاطمئنان؟

275
00:18:42,970 --> 00:18:45,260
الأمر ليس مضحكاً

276
00:18:55,730 --> 00:18:58,760
كنّا نتمرّن كثيراً معاً في هذا المكان

277
00:18:58,760 --> 00:18:59,570
أجل

278
00:19:00,180 --> 00:19:02,770
كنّا نعمل بشكل مكثّف آنذاك

279
00:19:02,770 --> 00:19:05,030
لم نكن نعرف شيئاً عن الحفلات الغنائيّة

280
00:19:05,030 --> 00:19:07,830
لم نكن قد غنّينا أو رقصنا قبلها

281
00:19:07,830 --> 00:19:09,410
كنّا مسعورين

282
00:19:09,410 --> 00:19:12,070
لكن كان كلّ يوم مُرضياً ومسلّياً

283
00:19:12,070 --> 00:19:13,930
كان ذلك مسلّياً؟

284
00:19:13,930 --> 00:19:15,460
ألا تتسلّى الآن؟

285
00:19:15,460 --> 00:19:16,970
بلى

286
00:19:16,970 --> 00:19:21,390
لكن هناك حسّ مسؤوليّة أيضاً الآن

287
00:19:21,390 --> 00:19:24,800
أريد أن أقدّم عرضاً احترافياً مُصقَلاً لمعجبينا

288
00:19:24,800 --> 00:19:26,480
نضجتَ يا يورو

289
00:19:26,480 --> 00:19:28,120
لا تسخر منّي

290
00:19:28,680 --> 00:19:31,990
بالمناسبة، لماذا تأخّرتَ في الردّ على رسالتي؟

291
00:19:31,990 --> 00:19:35,110
كنتُ أعمل حتّى وقت متأخّر من اللّيلة الماضية

292
00:19:35,420 --> 00:19:37,780
فطلع الصّباح دون أن أشعر

293
00:19:38,420 --> 00:19:41,320
،كان لديّ جلسة تصوير لبرنامج منوّعات

294
00:19:41,320 --> 00:19:43,970
لكن استغرقتُ في النّوم

295
00:19:44,370 --> 00:19:46,660
اضطرّ كاي لجرّي إلى هناك

296
00:19:46,660 --> 00:19:50,740
يبدو أنّ هاتفي سقط هنا حينها

297
00:19:51,410 --> 00:19:53,030
آسف

298
00:19:53,030 --> 00:19:56,620
بعد ما حدث في الأمس، ظننتَ غالباً
أنّ الأمر أكبر من ذلك

299
00:19:57,310 --> 00:19:59,030
هل سبّبتُ لك القلق؟

300
00:20:00,240 --> 00:20:01,380
توقّعت

301
00:20:01,380 --> 00:20:05,350
ا-المهمّ، ما العمل الذي كنتَ تقوم
به هنا في اللّيلة الماضية؟

302
00:20:06,230 --> 00:20:08,250
أتمرّن على التمثيل

303
00:20:09,000 --> 00:20:10,780
بسببك

304
00:20:11,140 --> 00:20:14,950
رؤية أدائك قبل أيّام ألهمني

305
00:20:14,950 --> 00:20:16,850
ارتأيتُ أنّه يجب أن أرتقي له

306
00:20:17,320 --> 00:20:19,980
كنتَ تتمرّن بمفردك؟

307
00:20:19,980 --> 00:20:21,440
هل هذا خارج عن المألوف؟

308
00:20:21,440 --> 00:20:23,860
لا، تفاجأتُ فحسب

309
00:20:23,860 --> 00:20:25,450
ليس خارجاً عن المألوف

310
00:20:25,450 --> 00:20:30,180
دائماً ما تخفي بذْلك جهوداً كبيرة
في العمل عن الجميع

311
00:20:30,720 --> 00:20:32,110
فهمتُ ذلك الآن

312
00:20:32,110 --> 00:20:34,930
تعمل بجدّ أكبر الآن ممّا كنتَ تفعل

313
00:20:34,930 --> 00:20:36,830
لا عجب في أنّني ما زلتُ لم أبلغ مستواك

314
00:20:39,580 --> 00:20:43,800
حتّى لو شعرتُ أنّني اقتربت، ما زلتُ
لا أستطيع سدّ الفجوة

315
00:20:43,800 --> 00:20:44,650
ماذا؟

316
00:20:45,010 --> 00:20:48,480
لعلّ ذلك مُحبِط، لكن أنا سعيد

317
00:20:48,480 --> 00:20:52,170
أنا فخور بمناداتك صديق طفولتي وشريكي

318
00:20:52,170 --> 00:20:55,270
أنا فخور بوقوفي بجانبك

319
00:20:55,270 --> 00:20:57,970
نفس الكلام أوجّهه لك

320
00:20:59,040 --> 00:21:02,050
دائماً ما تلاحظ نقاط قوّة الآخرين

321
00:21:02,050 --> 00:21:04,280
لكنّك لا تدرك كم أنت مذهل

322
00:21:04,280 --> 00:21:06,530
أتظنّني مذهلاً؟

323
00:21:07,350 --> 00:21:09,250
على سبيل المثال، تمثيلك

324
00:21:09,250 --> 00:21:11,550
...تركيزك حالما تبدأ

325
00:21:11,550 --> 00:21:13,730
...عندما تجسّد الدور بشكل طبيعي

326
00:21:13,730 --> 00:21:15,440
مهما تكلّمت لا أنتهي

327
00:21:16,920 --> 00:21:21,190
صراحتك عندما يتعلّق الأمر بالأشياء
التي تحبّها واهتماماتك

328
00:21:21,530 --> 00:21:26,090
وتلك الصّراحة هي نقطة قوّتك الفريدة

329
00:21:26,560 --> 00:21:28,880
كنتَ كذلك منذ طفولتنا

330
00:21:29,340 --> 00:21:33,380
هذا مذهل. يعجبني ذلك فيك

331
00:21:33,790 --> 00:21:34,880
...يو

332
00:21:38,090 --> 00:21:39,310
هذا محرج

333
00:21:40,680 --> 00:21:42,440
!كان ذلك محرجاً

334
00:21:42,440 --> 00:21:44,420
!كفى حديث عن المشاعر

335
00:21:44,420 --> 00:21:46,070
!لنتمرّن على الرقص

336
00:21:46,070 --> 00:21:49,370
لن أدعك تغادر حتّى نتقنه. حضّر نفسك

337
00:21:49,370 --> 00:21:51,700
أجل. أنا جاهز

338
00:23:35,010 --> 00:23:40,650
الرّسم بواسطة ناتسكي