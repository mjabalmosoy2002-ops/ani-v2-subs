1
00:00:05,060 --> 00:00:08,870
حان الوقت الآن لجلسة تصوير
"روي-كن يفعل ما يُطلب منه"

2
00:00:08,870 --> 00:00:09,740
حسناً

3
00:00:10,390 --> 00:00:13,700
!ثلاثة، اثنان، واحد... هيّا

4
00:00:14,460 --> 00:00:15,760
روي غاضب

5
00:00:16,390 --> 00:00:17,580
روي حزين

6
00:00:18,330 --> 00:00:19,580
روي هرّ

7
00:00:19,580 --> 00:00:20,660
مياو

8
00:00:20,660 --> 00:00:23,710
جميل. وجّه قبلة لنا يا روي

9
00:00:24,980 --> 00:00:26,780
وأخيراً، روي باسم

10
00:00:29,590 --> 00:00:31,220
أحسنت صنعاً يا روي

11
00:00:31,220 --> 00:00:33,640
حسناً، حان دوري

12
00:00:38,050 --> 00:00:39,560
ما كان رأيك يا روي؟

13
00:00:39,560 --> 00:00:43,410
لا أدري ما كان بالضبط، لكن كان مسلّياً

14
00:02:25,740 --> 00:02:28,820
...أريد العزف معك يا أوني-تشان

15
00:02:28,820 --> 00:02:31,790
إن لم يعجبك ذلك فسأتوقف عن عزفِ البيانو

16
00:02:31,790 --> 00:02:33,210
لا تسخر منّي

17
00:02:33,210 --> 00:02:34,420
!كفاك هراء

18
00:02:36,710 --> 00:02:37,720
!روي

19
00:02:43,600 --> 00:02:45,970
ارتكبتُ فعلاً شنيعاً

20
00:02:45,970 --> 00:02:47,640
سأحضر مكنسة

21
00:02:59,570 --> 00:03:03,220
عزفك على البيانو بديع دوماً يا روي

22
00:03:03,540 --> 00:03:05,920
إنّه يثير مشاعر قلبي

23
00:03:06,380 --> 00:03:09,500
ليتني أستطيع العزف معك

24
00:03:10,980 --> 00:03:14,420
يمكنك ذلك بالتأكيد إذا تمرّنت جيّداً

25
00:03:14,420 --> 00:03:20,170
أجل... ربّما إذا تمرّنتُ جيّداً حقاً

26
00:03:20,840 --> 00:03:24,930
لكن قد أتعلّم أكثر إذا علّمتني أنت يا روي

27
00:03:24,930 --> 00:03:28,680
البيانو ليس شيئاً تتعلّمه. بل شيئاً تحسّ به

28
00:03:28,680 --> 00:03:30,120
...هذا عميق

29
00:03:32,820 --> 00:03:33,800
هل أنت بخير؟

30
00:03:33,800 --> 00:03:34,510
أجل

31
00:03:34,510 --> 00:03:35,520
دعني أساعدك

32
00:03:36,730 --> 00:03:37,760
ماذا؟

33
00:03:38,600 --> 00:03:39,820
...هذه النوتة الموسيقية

34
00:03:40,510 --> 00:03:42,380
لحظة ماطرة"؟"

35
00:03:42,380 --> 00:03:44,260
أليست هذه أوّل أغنية لك؟

36
00:03:44,260 --> 00:03:49,060
أجل، إنها نوتة موسيقية لنسخة الأيادي
"الأربعة من "لحظة ماطرة

37
00:03:49,060 --> 00:03:51,330
ما زلتُ أعمل عليها

38
00:03:51,330 --> 00:03:55,300
إنّ الأيادي الأربعة تعني عندما يعزف
شخصان البيانو معاً، صحيح؟

39
00:03:55,300 --> 00:03:56,290
يبدو هذا ممتعاً

40
00:03:56,290 --> 00:03:57,090
إنه ممتع

41
00:03:57,780 --> 00:04:00,080
كنتُ أعزف مع أخي طوال الوقت

42
00:04:01,660 --> 00:04:04,050
عندما كنّا طفلين

43
00:04:05,380 --> 00:04:06,740
...المعذرة

44
00:04:07,350 --> 00:04:10,850
تصالحتُ أنا وأخي. لا تقلق بشأن ذلك

45
00:04:11,200 --> 00:04:15,230
لكنّنا نميل لتجنّب مناقشة المسائل المتعلِّقة بالبيانو

46
00:04:15,230 --> 00:04:16,510
هكذا إذاً

47
00:04:17,980 --> 00:04:19,310
ادخل

48
00:04:19,820 --> 00:04:21,370
رأيت؟ ها هم

49
00:04:21,370 --> 00:04:23,080
أخبرتُك بذلك

50
00:04:23,080 --> 00:04:24,030
أجل، أجل

51
00:04:24,030 --> 00:04:27,930
شون-سان، كورو-ني... ما الأمر؟

52
00:04:27,930 --> 00:04:30,400
روي، لدينا عمل لك

53
00:04:30,400 --> 00:04:31,390
أنا؟

54
00:04:31,390 --> 00:04:32,450
خذ

55
00:04:32,790 --> 00:04:34,830
معزوفة بيانو في الهواء الطلق؟

56
00:04:36,580 --> 00:04:40,380
أجل، إنّها جزء من حملة دعائيّة
،لجذب أشخاص أكثر

57
00:04:40,380 --> 00:04:43,140
لا سيّما الذين لا يستمعون عادة
،لأغاني المغنّيين النجوم

58
00:04:43,140 --> 00:04:45,250
لمهرجانِ البدر

59
00:04:45,250 --> 00:04:48,390
ستُبثّ على الهواء في كلّ أرجاء البلد
على الشبكاتِ الكُبرى

60
00:04:48,390 --> 00:04:50,280
في كلّ البلد على الشبكاتِ الكُبرى؟

61
00:04:50,280 --> 00:04:52,250
!هذا مُذهل يا روي

62
00:04:52,250 --> 00:04:53,730
حظّاً سعيداً

63
00:04:53,730 --> 00:04:56,550
أنا النجم؟

64
00:04:56,550 --> 00:05:01,520
أجل، لذا نريد احترام رغبتك فيما يتعلّق
بالمعزوفة التي تريد عزفها

65
00:05:01,520 --> 00:05:03,400
الخيار كلّه لك

66
00:05:09,770 --> 00:05:11,490
،حسناً إذاً

67
00:05:11,490 --> 00:05:13,620
لنطرح أفكارنا جميعاً

68
00:05:13,620 --> 00:05:16,250
دعنا ألّا نفعل ذلك

69
00:05:16,250 --> 00:05:18,710
هل يحتاج سماع رأي كلّ واحد منّا؟

70
00:05:18,710 --> 00:05:20,850
ما هذا يا يو؟

71
00:05:20,850 --> 00:05:24,090
عمل روي هو من عمل بروسيلاروم

72
00:05:24,090 --> 00:05:28,090
ألا تريد أن تساعد روي في أداء
أفضل عمل ممكن؟

73
00:05:28,370 --> 00:05:30,260
...بالتأكيد، لكن

74
00:05:30,260 --> 00:05:33,270
!نعتمد عليكم جميعاً إذاً

75
00:05:33,840 --> 00:05:35,120
شكراً لكم

76
00:05:38,740 --> 00:05:41,860
أي نوعية من المعزوفات يجب أن تكون؟

77
00:05:42,390 --> 00:05:44,320
هذا سؤال صعب

78
00:05:45,090 --> 00:05:50,670
هل ينبغي أن تكون بجودة مغنّيين نجوم؟

79
00:05:50,670 --> 00:05:52,450
لستُ أدري

80
00:05:52,450 --> 00:05:55,360
إنّ اعتماد شيء سائد خارج إطار شخصية روي

81
00:05:55,360 --> 00:05:57,130
سيخلط أولويّاتنا

82
00:05:57,510 --> 00:05:59,000
،لو كنتُ أنا

83
00:05:59,790 --> 00:06:02,500
لتمنّيتُ جمهوراً لا يتكوّن إلّا من فتيات

84
00:06:02,500 --> 00:06:06,900
ولقدّمتُ لَهُنّ الكاري المُعدّ منزلياً بينما أعزف

85
00:06:07,670 --> 00:06:10,530
!لكن من المهمّ أن يكون الجمهور فتيات فقط

86
00:06:10,530 --> 00:06:12,980
ممنوع دخول الشّباب

87
00:06:12,980 --> 00:06:15,170
يسرُّني أنّك لا تعرف كيف تعزف على البيانو

88
00:06:15,170 --> 00:06:16,390
!اصمت

89
00:06:16,390 --> 00:06:18,450
لكن أعتقد أنَّ هذا لا يلائم روي

90
00:06:18,450 --> 00:06:19,440
قد يفلح ذلك

91
00:06:19,440 --> 00:06:20,650
!حقّاً؟

92
00:06:20,650 --> 00:06:23,980
لا أميِّز ما إن كنتَ تمزح أم لا

93
00:06:24,450 --> 00:06:26,320
ماذا تفعلون جميعاً؟

94
00:06:26,320 --> 00:06:29,450
نبحث عن أفكار لهذه

95
00:06:29,450 --> 00:06:32,830
معزوفة بيانو في الهواء الطلق؟

96
00:06:32,830 --> 00:06:35,950
هلّا شاركتُمانا أفكاركما كذلك؟

97
00:06:35,950 --> 00:06:38,950
فأساساً عمل روي هو من عمل الجذّابون الستّة أيضاً

98
00:06:38,950 --> 00:06:42,340
فأنت دائماً ما تتخطّى كلّ الحدود
...في ذلك يا شون-سان

99
00:06:42,340 --> 00:06:43,460
!وجدتُها

100
00:06:43,460 --> 00:06:48,590
ما رأيكم أن ينقذ روي العالمَ بحفل غنائي 24 ساعة؟

101
00:06:48,590 --> 00:06:52,430
ألن يغمى على روي قبل أن ينقذ العالم؟

102
00:06:56,100 --> 00:06:58,890
...خلتُها فكرة جيّدة

103
00:06:58,890 --> 00:07:00,060
قد يفلح ذلك

104
00:07:00,060 --> 00:07:01,440
!حقّاً؟

105
00:07:01,440 --> 00:07:06,440
أعني هل أنت متأكّد؟ هل لديك اللّياقة لذلك؟

106
00:07:06,440 --> 00:07:09,400
سأعمل على إنجاح ذلك

107
00:07:09,400 --> 00:07:11,950
!تبدو كشخصٍ رياضيّ

108
00:07:11,950 --> 00:07:16,280
لكن لا. هناك حدود لما يمكنك إنجازه
بالاعتمادِ على العزيمة فقط

109
00:07:16,280 --> 00:07:19,170
شون-سان، هل لديك أي أفكار؟

110
00:07:19,170 --> 00:07:21,860
أنا؟ لديّ بالطبع

111
00:07:21,860 --> 00:07:24,840
لديّ أفكار نيّرة

112
00:07:25,210 --> 00:07:31,090
كحفلٍ غنائيّ يقدّم بيانو روي
!وكمان هاجيمي

113
00:07:31,500 --> 00:07:34,480
!التناغم المطلق بين روي وهاجيمي

114
00:07:35,250 --> 00:07:39,550
!مجرّد تخيُّل ذلك مبهر جدّاً! بديع للغاية

115
00:07:39,550 --> 00:07:42,480
!وكأنّها ولادة عالم جديد

116
00:07:42,480 --> 00:07:45,110
أجل، أجل. عالم جديد يولد

117
00:07:47,400 --> 00:07:48,950
...تناغم

118
00:07:50,280 --> 00:07:51,830
ما الأمر؟

119
00:07:51,830 --> 00:07:54,060
لا شيء

120
00:07:55,410 --> 00:07:56,440
روي؟

121
00:07:57,950 --> 00:07:59,240
،بما أننا قطعنا هذه المسافة

122
00:07:59,240 --> 00:08:02,920
ينبغي أن نسأل آخر أعضاء بروسيلاروم عن رأيه أيضاً

123
00:08:02,920 --> 00:08:07,210
ألا يقوم كاي-سان بتغطية موضوع في مشفى الجامعة؟

124
00:08:07,210 --> 00:08:10,760
أربعة وعشرون ساعة عن عالم الطبّ
المجهول" أو شيء من هذا القبيل

125
00:08:10,760 --> 00:08:14,110
تماماً. إنه ليس بعيداً من هنا

126
00:08:14,110 --> 00:08:15,800
ماذا نفعل يا روي؟

127
00:08:16,710 --> 00:08:19,490
أظنّنا نستطيع الذهاب

128
00:08:25,590 --> 00:08:27,560
...ماذا؟ هذا المكان

129
00:08:33,700 --> 00:08:35,090
ها هو ذا

130
00:08:35,090 --> 00:08:36,050
كاي

131
00:08:36,530 --> 00:08:38,550
ماذا تفعلون هنا يا شباب؟

132
00:08:38,550 --> 00:08:39,940
...في الواقع

133
00:08:41,450 --> 00:08:46,560
نسأل كلّ أعضاء بروسيلاروم ما نوع
المعزوفة التي ينبغي أن يعزفها روي

134
00:08:46,560 --> 00:08:48,630
أتينا لنأخذ رأيك

135
00:08:48,630 --> 00:08:50,080
!الآن؟

136
00:08:50,080 --> 00:08:52,240
...أعني، لا أمانع

137
00:08:52,240 --> 00:08:55,470
لكن نادراً ما تغادر السّكَن يا شون

138
00:08:55,470 --> 00:08:57,490
أنت لئيم جدّاً يا كاي

139
00:08:57,490 --> 00:09:01,530
قد أكون من النوع الذي يفضّل النوم طيلة حياته

140
00:09:01,530 --> 00:09:04,140
لكن أنا سعيد بمساعدة الأعضاء الآخرين في العمل

141
00:09:05,150 --> 00:09:06,510
حسناً، آسف

142
00:09:06,510 --> 00:09:09,570
لكنّنا على وشك أن نبدأ التصوير صدّقني

143
00:09:09,570 --> 00:09:11,150
هل يمكنك الانتظار قليلاً؟

144
00:09:11,150 --> 00:09:13,780
سيكون ذلك من دواعي سروري

145
00:09:13,780 --> 00:09:15,760
هل يمكنني المجيء أيضاً؟

146
00:09:15,760 --> 00:09:18,280
ينتابني فضول حيال ما يحدث خلف كواليس الطبّ

147
00:09:18,280 --> 00:09:19,400
ماذا عنك يا روي؟

148
00:09:19,400 --> 00:09:21,030
إن كان الجميع يريدون ذلك، فلا مانع لديّ أيضاً

149
00:09:21,030 --> 00:09:22,290
حسناً

150
00:09:22,290 --> 00:09:24,540
سأحصل على إذن من الكادر

151
00:09:32,200 --> 00:09:33,220
روي

152
00:09:36,720 --> 00:09:38,140
...ني-سان

153
00:09:40,890 --> 00:09:42,540
إنّه ري

154
00:09:42,540 --> 00:09:44,450
سمعتُ أنّ شخصاً كان قادماً لتغطية موضوع

155
00:09:44,450 --> 00:09:45,880
لم أتوقّع أن تكونوا أنتم

156
00:09:45,880 --> 00:09:47,520
أتيتُ للتفرّج فقط

157
00:09:47,520 --> 00:09:50,330
نسيتُ أنّك طالب طبّ

158
00:09:50,330 --> 00:09:51,870
تعمل في هذا المشفى إذاً؟

159
00:09:51,870 --> 00:09:54,450
مذهل، يا لها من صدفة عجيبة

160
00:09:54,450 --> 00:09:56,080
صدفة؟

161
00:09:57,250 --> 00:10:00,930
لنمنح الأخوين وقتاً بمفردهما

162
00:10:00,930 --> 00:10:01,850
هيّا بنا

163
00:10:08,170 --> 00:10:09,360
تسرُّني رؤيتك

164
00:10:09,360 --> 00:10:11,530
تسرُّني رؤيتك أيضاً يا روي

165
00:10:11,530 --> 00:10:13,020
كيف حالك؟

166
00:10:13,020 --> 00:10:15,820
سمعتُ أنّك ستؤدّي في مهرجانِ البدر ثانية

167
00:10:15,820 --> 00:10:17,850
يسرُّني أنّك تبلي حسناً

168
00:10:17,850 --> 00:10:20,010
أجل. ماذا عنك يا ني-سان؟

169
00:10:20,010 --> 00:10:22,450
أبلي حسناً أيضاً

170
00:10:22,450 --> 00:10:27,730
أنا مشغولٌ جدّاً، لكن أتصوّر أنّك مشغول
أكثر منّي في التّحضيرِ للمهرجان

171
00:10:27,730 --> 00:10:29,450
أجل، أعتقد

172
00:10:29,450 --> 00:10:30,540
هكذا إذاً

173
00:10:31,990 --> 00:10:36,820
اسمع، سوف أقدّم أداء قبل مهرجان البدر

174
00:10:37,430 --> 00:10:38,700
معزوفة بيانو

175
00:10:41,170 --> 00:10:44,160
هكذا إذاً. معزوفة بيانو

176
00:10:46,860 --> 00:10:49,660
أنا متأكّدٌ أنّك ستقدّم أداء ممتازاً

177
00:10:49,660 --> 00:10:50,580
ماذا عنك؟

178
00:10:51,600 --> 00:10:55,470
ألم تعد تعزف على البيانو؟

179
00:10:55,470 --> 00:10:59,570
أنا؟ لا... إطلاقاً

180
00:10:59,570 --> 00:11:01,800
...إطلاقاً؟ هكذا إذاً

181
00:11:04,810 --> 00:11:07,950
إذا أحببت، ما رأيك أن تأتي؟

182
00:11:07,950 --> 00:11:09,600
هذا إن كان لديك وقت

183
00:11:10,910 --> 00:11:12,480
لا، سآتي

184
00:11:12,480 --> 00:11:16,580
لا أعدك أنّني سأحضر، لكن سأفعل ما بوسعي

185
00:11:16,580 --> 00:11:17,450
حسناً

186
00:11:17,450 --> 00:11:18,760
آسف يا روي

187
00:11:18,760 --> 00:11:21,770
لديّ مقابلة، لذا عليّ الذهاب

188
00:11:21,770 --> 00:11:22,860
حسناً

189
00:11:23,170 --> 00:11:25,210
بالتوفيقِ لك في معزوفتك

190
00:11:25,210 --> 00:11:26,870
سأشجِّعك من أعماق قلبي

191
00:11:27,230 --> 00:11:28,620
شكراً

192
00:11:28,620 --> 00:11:30,220
إلى اللِّقاء إذاً

193
00:11:30,220 --> 00:11:32,290
حسناً. إلى اللّقاء

194
00:11:39,260 --> 00:11:42,090
عُلِم. لنعتمد على ذلك إذاً

195
00:11:49,760 --> 00:11:52,520
آسف، لكن عليّ أن أركض. المعذرة

196
00:11:53,770 --> 00:11:54,940
ما الأمر؟

197
00:11:54,940 --> 00:11:57,690
إنّه الحبّ

198
00:11:57,690 --> 00:11:58,690
ماذا؟

199
00:12:01,690 --> 00:12:02,910
ما الخطب؟

200
00:12:02,910 --> 00:12:06,230
قال أخي أنّه لم يعد يعزف البيانو

201
00:12:07,250 --> 00:12:09,380
إطلاقاً

202
00:12:09,970 --> 00:12:11,150
هكذا إذاً

203
00:12:18,880 --> 00:12:20,720
سوف أعتزل عزف البيانو

204
00:12:20,720 --> 00:12:21,470
ماذا؟

205
00:12:21,470 --> 00:12:24,370
إنّه ليس ممتعاً إطلاقاً

206
00:12:24,370 --> 00:12:25,760
لم أعد أحبّه

207
00:12:26,260 --> 00:12:30,320
...أنا أكبر منك وبدأتُ العزف قبلك

208
00:12:30,320 --> 00:12:33,330
أتمرّن كثيراً كلّ يوم

209
00:12:33,800 --> 00:12:36,270
لكن ما زلتُ غير بارع فيه

210
00:12:36,710 --> 00:12:39,620
بدأتَ بعدي ومع ذلك أنت أفضل منّي بكثير

211
00:12:40,230 --> 00:12:44,400
دائماً ما تتنهّد أمّي أثناء دروسي

212
00:12:44,400 --> 00:12:45,230
...أوني-تشان

213
00:12:45,230 --> 00:12:46,030
!لا تلمسني

214
00:12:48,410 --> 00:12:50,250
...لا تغضب

215
00:12:50,250 --> 00:12:53,510
أريد أن أعزف معك يا أوني-تشان

216
00:12:53,510 --> 00:12:56,880
إن لم يعجبك ذلك فسأتوقف عن عزفِ البيانو

217
00:12:56,880 --> 00:12:58,380
لا تسخر منّي

218
00:12:58,380 --> 00:12:59,590
!كفاك هراء

219
00:13:02,090 --> 00:13:02,960
!روي

220
00:13:06,720 --> 00:13:11,640
أتساءل ما إن كنتُ السّبب في توقّف
أخي عن حبِّ البيانو

221
00:13:12,520 --> 00:13:16,600
...كنتُ أحبُّ الاستماع إلى عزفه

222
00:13:29,540 --> 00:13:30,740
عُدت

223
00:13:30,740 --> 00:13:32,890
كاي. أهلاً بعودتك

224
00:13:32,890 --> 00:13:34,690
آسف يا روي

225
00:13:34,690 --> 00:13:38,020
لم أتوصّل لأي فكرة لمعزوفتك بعد

226
00:13:38,020 --> 00:13:39,080
لا عليك

227
00:13:39,080 --> 00:13:40,590
أعِدُك أن أتوصّل لفكرة جيّدة

228
00:13:41,130 --> 00:13:44,580
قبل أن أنسى، سأعود إلى مشفى الجامعة غداً

229
00:13:44,580 --> 00:13:46,710
هل من رسالة تريدني إيصالها إلى ري؟

230
00:13:46,710 --> 00:13:49,140
لا، لا شيء

231
00:13:49,140 --> 00:13:50,420
متأكّد؟

232
00:13:51,730 --> 00:13:54,820
لعلّي أزعجتُ أخي

233
00:13:55,670 --> 00:13:58,400
تحدّثتُ عن عزف البيانو

234
00:13:58,400 --> 00:14:02,270
رغم أنّه اعتزل العزف

235
00:14:02,270 --> 00:14:04,480
أنتما متشابهان تماماً

236
00:14:05,360 --> 00:14:09,110
بعد المقابلة، كانت تعابير وجهه
نفس تعابير وجهك الآن

237
00:14:09,610 --> 00:14:10,650
!كاي

238
00:14:13,620 --> 00:14:18,690
كان ري قلقاً من أن يكون تصرّفه
أثناء محادثتكما

239
00:14:18,690 --> 00:14:21,000
قد جعلك تأخذ فكرة سيّئة

240
00:14:21,470 --> 00:14:24,800
قال أنّه لا يكره البيانو

241
00:14:24,800 --> 00:14:27,190
...ماذا؟ لكن

242
00:14:27,190 --> 00:14:30,900
ربّما لا يعزف لأنّه مشغول بالدراسة فحسب

243
00:14:31,580 --> 00:14:33,940
هل قال أخي ذلك حقّاً؟

244
00:14:33,940 --> 00:14:37,350
أجل. يتطلّع قُدماً للمعزوفة

245
00:14:37,350 --> 00:14:40,230
هكذا إذاً

246
00:14:40,230 --> 00:14:42,760
حريّ بك أن تتمرّن جيِّداً

247
00:14:43,130 --> 00:14:44,060
حسناً

248
00:14:53,620 --> 00:14:55,710
كيف يسير الأمر يا روي؟

249
00:14:55,710 --> 00:14:58,660
.بخير. أريد أن يسير الأداء على ما يُرام
لذا سأبذل قصارى جهدي

250
00:14:58,660 --> 00:14:59,710
هذا جيّد

251
00:14:59,710 --> 00:15:01,390
سمعتُ أنَّ ري-سان قادم

252
00:15:01,390 --> 00:15:02,520
أجل

253
00:15:02,520 --> 00:15:03,460
...هذا

254
00:15:03,460 --> 00:15:05,300
شارف على الانتهاء

255
00:15:05,300 --> 00:15:09,990
آمل أن أتمكَّن من العزفِ مع أخي ثانية يوماً ما

256
00:15:09,990 --> 00:15:11,230
يوماً ما؟

257
00:15:11,230 --> 00:15:14,010
أجل، يوماً ما

258
00:15:14,010 --> 00:15:15,980
يوماً ما يكفي

259
00:15:15,980 --> 00:15:20,930
أفتقِد لموسيقاه، لكنّه مشغول بالدراسة

260
00:15:20,930 --> 00:15:24,820
يكفيني حضوره لمعزوفتي

261
00:15:24,820 --> 00:15:25,570
هكذا إذاً

262
00:15:26,310 --> 00:15:28,020
سأتمرَّن بجدّ

263
00:16:18,790 --> 00:16:20,950
روي. أتعمل بجدّ؟

264
00:16:20,950 --> 00:16:22,050
مساء الخير

265
00:16:22,050 --> 00:16:24,580
يو، يورو... ما الأمر؟

266
00:16:24,580 --> 00:16:25,640
أتينا وبحوزتنا هدية

267
00:16:25,640 --> 00:16:27,670
الحلويّات لذيذة بعد الإرهاق، صحيح؟

268
00:16:27,670 --> 00:16:28,460
تفضّل

269
00:16:28,460 --> 00:16:30,090
...بودينغ

270
00:16:30,090 --> 00:16:31,980
...إنّه من إعداد أمّي

271
00:16:31,980 --> 00:16:33,470
من تناديه بـ"أمّي"؟

272
00:16:34,420 --> 00:16:36,450
شكراً يا أمّي

273
00:16:36,450 --> 00:16:38,710
من المحرج أن تقول ذلك أمامي مباشرة

274
00:16:38,710 --> 00:16:39,680
!أنت

275
00:16:42,560 --> 00:16:43,600
إنّه لذيذ

276
00:16:43,600 --> 00:16:46,500
أنا متأكّدٌ أنّك ستضغط على نفسِك كثيراً
،حتّى لو قلتُ لك خلاف ذلك

277
00:16:46,500 --> 00:16:48,530
لكن انتبه على نفسك أيضاً

278
00:16:48,530 --> 00:16:50,530
تكلّم إن كان هناك أي طعام تشتهيه

279
00:16:50,530 --> 00:16:54,830
حسناً. شكراً لكما يا يو ويورو

280
00:17:47,120 --> 00:17:49,800
،ربّما لأنّ ري قد حضر

281
00:17:49,800 --> 00:17:52,050
لكن يبدو روي سعيداً حقّاً

282
00:17:52,050 --> 00:17:56,680
بالفعل. كلّ نوطة يعزفها تبدو مفعمة بالحيويّة

283
00:17:56,680 --> 00:18:00,400
اختار مقطوعات كلاسيكيّة يحبّها الجميع، صحيح؟

284
00:18:00,400 --> 00:18:03,430
أشعر وكأنّني سمعتُ كلّ هذه الأغاني من قبل

285
00:18:03,430 --> 00:18:10,310
والآن أنا متحمّس لرؤية كيف ستنتهي هذه المعزوفة

286
00:18:25,870 --> 00:18:32,570
هذه معزوفة البيانو الأولى لي بصِفتي
مينازكي روي من بروسيلاروم

287
00:18:32,570 --> 00:18:34,380
شكراً على حضوركم

288
00:18:42,320 --> 00:18:49,070
هذه الأغنية السّابقة هي إعداد بيانو
من أغنية إطلالتي الأولى كمغنٍّ نجم

289
00:18:49,070 --> 00:18:50,100
!روي

290
00:18:50,600 --> 00:18:51,710
هذا كانّازكي-كن

291
00:18:51,710 --> 00:18:53,020
ماذا؟ ما الذي يجري؟

292
00:18:53,020 --> 00:18:54,440
...إيكّون

293
00:18:55,990 --> 00:18:58,690
إليك النوتة الموسيقيّة لمقطوعتك السّابقة

294
00:19:01,770 --> 00:19:04,830
هذا... إصدار الأيادي الأربعة

295
00:19:08,230 --> 00:19:09,540
من هذا؟

296
00:19:09,540 --> 00:19:10,460
ماذا؟

297
00:19:12,330 --> 00:19:14,880
ني-سان... لماذا؟

298
00:19:14,880 --> 00:19:20,730
سلّمَ إيكو-كن هذه النوطة الموسيقيّة ومشاعرك لي

299
00:19:21,430 --> 00:19:25,410
ما زلتَ تخبر النّاس بأنّك تحبّ طريقة عزفي

300
00:19:26,480 --> 00:19:28,470
آسف على كتمِ هذا السرّ

301
00:19:28,470 --> 00:19:30,680
لا، لا عليك

302
00:19:31,140 --> 00:19:33,610
...إيكّون، أنا

303
00:19:33,990 --> 00:19:37,250
،أنا بعيد كلّ البعد عن مستواك الآن

304
00:19:37,650 --> 00:19:43,110
لكن هل يمكنني مع ذلك العزف معك
كما كنّا نعزف ونحن صغار؟

305
00:19:44,560 --> 00:19:45,730
...أ-أجل

306
00:19:45,730 --> 00:19:51,950
ني-سان، ما زلتُ أريد العزف معك

307
00:20:12,750 --> 00:20:14,350
كنتُ خائفاً

308
00:20:14,840 --> 00:20:19,680
كنتُ خائفاً من العزفِ معك ومُقارنتي بك

309
00:20:20,520 --> 00:20:21,650
...ني-سان

310
00:20:23,120 --> 00:20:27,910
لكن كانت رغبتي في العزفِ معك أقوى

311
00:20:29,500 --> 00:20:34,940
أحبّ... أحبّ طريقة عزفك أيضاً

312
00:20:35,740 --> 00:20:38,880
أحبُّ موسيقاك يا روي

313
00:20:41,260 --> 00:20:46,600
ني-سان... لطالما أحببتُ طريقة عزفك

314
00:20:47,820 --> 00:20:51,230
لا يهمّني إن أدّيتَ جيّداً أم لا

315
00:20:52,280 --> 00:20:55,140
لديك صوت جميل ونقيّ

316
00:20:56,470 --> 00:21:01,640
هذا هو الصّوت الذي علّمني مدى روعة البيانو

317
00:21:02,690 --> 00:21:06,140
يتردّد نغمُه داخلي دوماً

318
00:21:07,460 --> 00:21:10,290
روي، أنا آسف

319
00:21:11,940 --> 00:21:13,060
...ني-سان

320
00:21:14,120 --> 00:21:15,370
شكراً لك

321
00:21:40,790 --> 00:21:45,950
أتعتقد أنّه ما زال بإمكاننا العزف
معاً مجدّداً يوماً ما؟

322
00:21:45,950 --> 00:21:50,050
في المرّة المقبلة، سأعزف بشكلٍ أفضل قليلاً

323
00:21:51,700 --> 00:21:53,030
هكذا إذاً

324
00:21:53,030 --> 00:21:55,160
كانت معزوفة مذهلة

325
00:21:55,160 --> 00:21:58,040
يعزو الفضل لأصدقائك العظماء

326
00:21:58,040 --> 00:21:59,600
معك حقّ

327
00:21:59,600 --> 00:22:01,920
يعزو الفضل في كلِّ شيء لبروسيلاروم

328
00:23:35,010 --> 00:23:40,650
الرّسم بواسطة شيجيما توهيرو