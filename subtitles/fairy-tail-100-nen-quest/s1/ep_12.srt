1
00:00:05,560 --> 00:00:10,030
.على الرّغم من أنني قمتُ بجعلها تدور، إلّا أنّها لا زالت تتحرّك

2
00:00:10,350 --> 00:00:11,620
.ويندي

3
00:00:11,990 --> 00:00:14,410
أيّ التنانين أنتِ؟

4
00:00:14,410 --> 00:00:18,860
!أنا تنّينة السماء... قاتلة تنّين السماء

5
00:00:18,860 --> 00:00:21,510
."كلا... أنتِ تنّينة "الشرنقة

6
00:00:22,130 --> 00:00:23,630
...شرنقتي

7
00:00:23,630 --> 00:00:25,020
!أنا ويندي

8
00:00:25,020 --> 00:00:27,460
!سأجعلكِ تدورين مجددًا

9
00:00:27,460 --> 00:00:30,860
!لن تنجح ذات الحركة عليّ مجددًا

10
00:00:32,130 --> 00:00:33,800
.إنّ شرنقتي تدور وتدور

11
00:00:37,910 --> 00:00:40,600
!مخلب تنّينة السماء

12
00:00:44,480 --> 00:00:45,440
!والآن الضربة القاضية

13
00:00:52,510 --> 00:00:54,590
،أنتِ مُثيرة للاهتمام يا شرنقتي

14
00:00:54,590 --> 00:00:56,450
.لذا لن أقوم بأكلكِ الآن

15
00:00:56,450 --> 00:00:59,410
.سأنفّذ ما أتيت لأجله من الأساس

16
00:01:00,420 --> 00:01:01,410
!تبًا

17
00:01:01,410 --> 00:01:03,230
.دوران، دوران

18
00:01:03,230 --> 00:01:03,960
!الجرم

19
00:01:03,960 --> 00:01:05,420
!بووم

20
00:01:15,060 --> 00:01:17,970
.الجرم الثاني قد تمّ تدميره

21
00:01:18,580 --> 00:01:20,430
.تبقّى ثلاثة أجرام

22
00:01:20,430 --> 00:01:26,290
.تبقّى ثلاثة حتّى يفقد تنّين إله الخشب ألدورون قوّته

23
00:03:05,630 --> 00:03:07,660
ما كانت تلك الهزّة التي حدثت للتو؟

24
00:03:07,660 --> 00:03:10,020
.تمّ تدمير أحد الأجرام

25
00:03:10,020 --> 00:03:13,050
.هذا يعني أنّه تبقّى ثلاثة أجرام لتدميرها

26
00:03:13,050 --> 00:03:15,380
.وأحدها موجودٌ هنا

27
00:03:16,840 --> 00:03:21,270
ما الّذي تنوون فعله بعد إضعاف ألدورون؟

28
00:03:21,270 --> 00:03:25,810
.نقوم بصبغه بالأبيض لكي نُقاتل المتبقّين من التنانين الآلهة الخمسة

29
00:03:26,490 --> 00:03:30,440
.الساحرة البيضاء تُخطط لسلب قوّة تنّين إله الخشب

30
00:03:30,440 --> 00:03:31,940
.فهمت

31
00:03:31,940 --> 00:03:35,400
.هدفنا هو إضعافه لكي نأكله

32
00:03:35,400 --> 00:03:41,560
.أهدافنا قد تكون مُختلفة، ولكننا نتشارك في الحاجة لتدمير الأجرام

33
00:03:41,560 --> 00:03:42,870
.يبدو الأمر كذلك

34
00:03:42,870 --> 00:03:47,620
إذًا لِمَ نتقاتل هنا أمام الجرم؟

35
00:03:47,940 --> 00:03:50,580
أنتِ من بدأ في ذلك، أتذكرين؟

36
00:03:50,580 --> 00:03:55,050
.هذا صحيح... فعلتُ ذلك لأنّك بدوت لذيذًا

37
00:03:56,760 --> 00:03:59,470
.إنّكَ مُقبلاتٌ مثاليّة

38
00:04:01,680 --> 00:04:06,810
...إنّها فرصتي لأخذ الجرم بينما كيريا ولاكسس يتقاتلان

39
00:04:07,090 --> 00:04:08,200
...ولكن

40
00:04:10,000 --> 00:04:11,730
!أنا عالقة هنا

41
00:04:13,690 --> 00:04:17,900
.إيرزا، سأقوم بصبغكِ بالأبيض الآن

42
00:04:17,900 --> 00:04:18,930
!قريبٌ جدًا

43
00:04:18,930 --> 00:04:20,280
.لا حاجة للخوف

44
00:04:20,280 --> 00:04:21,660
.كلا، توقّف

45
00:04:22,560 --> 00:04:26,400
...سلّمي نفسكِ إليّ واسترخي، دعي الأمر لي

46
00:04:26,400 --> 00:04:30,020
.جيلال، فكّ هذه القيود

47
00:04:30,660 --> 00:04:32,580
.إنّها تذكّرني بأمورٍ لا أُريد تذكّرها

48
00:04:34,710 --> 00:04:37,630
.أُريد أن ألف ذراعيَّ حول كتفيك

49
00:04:38,380 --> 00:04:40,510
.أُريد أن ألمس خديك

50
00:04:41,160 --> 00:04:42,470
.إيرزا

51
00:04:44,590 --> 00:04:46,720
.أ-أنا آسف

52
00:04:46,720 --> 00:04:48,430
.لن أفعل لكِ ذلك مُجددًا

53
00:04:53,620 --> 00:04:55,900
!مـ...ما الّذي تفعلينه يا إيرزا؟

54
00:04:57,860 --> 00:05:00,540
!إنّهُ دورك لكي يتم تقييدك

55
00:05:01,320 --> 00:05:02,710
.حسنٌ

56
00:05:02,710 --> 00:05:05,140
.سأقبل بكل ما تفعلينه

57
00:05:05,140 --> 00:05:07,340
.هيّا تعالي، أنا جاهز عندما تكونين جاهزة

58
00:05:07,340 --> 00:05:08,790
!كلا، هذا ليس ما سنفعله

59
00:05:08,790 --> 00:05:10,740
!ابقى حيث أنت

60
00:05:10,740 --> 00:05:13,750
فهمت، أنتِ تبقيني متشوقًا، أليس كذلك؟

61
00:05:14,540 --> 00:05:16,500
.عليّ الإسراع إلى الكنيسة

62
00:05:19,670 --> 00:05:23,430
.بالتفكير في الأمر، لم يسبق لي أن قاتلت الجد بجديّة

63
00:05:23,430 --> 00:05:26,650
.لا ينبغي أن تُفكّر به كشخصٍ تعرفه

64
00:05:27,590 --> 00:05:30,890
،إنّ قوّة العجوز السحريّة مجتمعة مع قوّتي

65
00:05:30,890 --> 00:05:33,310
.وينتج منها قوّة لا تقهر

66
00:05:39,290 --> 00:05:40,920
!هذا مؤلم

67
00:05:40,920 --> 00:05:44,160
...على الرّغم من أنني كنتُ أعبر من خلال الجدران قبل قليل

68
00:05:45,350 --> 00:05:49,230
!مهلًا، كيف يُمكنك أن تضربني على الرغم من أنني شبح؟

69
00:05:49,230 --> 00:05:52,160
!لم أتمكّن من مهاجمتك عندما كنتُ في جسدي قبل قليل

70
00:05:52,160 --> 00:05:56,110
.نحن لسنا متشابهين من الأساس

71
00:05:56,770 --> 00:05:58,360
.أنا شبح

72
00:05:58,360 --> 00:06:00,750
.بينما أنتَ عبارة عن إسقاطٍ فكري

73
00:06:00,750 --> 00:06:04,550
.أنا من أُقرر أيّ هجوم يُصيب أم لا

74
00:06:04,890 --> 00:06:08,180
.لا أفهم ذلك حقًا ولكنّ ذلك ليس عدلًا

75
00:06:08,490 --> 00:06:13,640
.كلا، أنت قادرٌ على فعل ذلك أيضًا بلا أن تعي ذلك

76
00:06:14,290 --> 00:06:17,950
.أساسًا، لا يُمكن للأشباح أن تلمس شيئًا

77
00:06:17,950 --> 00:06:21,520
.ولكنّكَ لكمتَ القطّ الّذي تلبّستُه

78
00:06:21,520 --> 00:06:24,860
.وإن أردت يُمكنك أن تضرب هذا العجوز أيضًا

79
00:06:25,140 --> 00:06:29,080
.لستُ أعلم ما إن كان كوني شبحًا مفيدًا أم لا

80
00:06:29,400 --> 00:06:32,830
على كلٍ، من يكون هذا العجوز؟

81
00:06:33,550 --> 00:06:35,830
.إن معدّل التزامن معه غير مسبوق

82
00:06:36,200 --> 00:06:39,290
.إنّهُ زعيم نقابتنا

83
00:06:39,700 --> 00:06:41,250
زعيم نقابة؟

84
00:06:41,250 --> 00:06:43,460
.هذا يفسّر امتلاكه لهذه القوّة السحريّة الكبيرة

85
00:06:43,850 --> 00:06:48,180
،وبالنّظر إلى عمره

86
00:06:48,970 --> 00:06:52,140
.لعلّه مرّ بتجربة الاقتراب من حافّة الموت

87
00:06:52,140 --> 00:06:56,230
...ولكنَّ ذلك لوحده لا يفسّر هذا المستوى من التزامن

88
00:06:57,900 --> 00:07:01,400
!هل من المُمكن أن يكون مطابقًا للحالة الثالثة؟

89
00:07:01,400 --> 00:07:02,930
قريبٌ بالدم؟

90
00:07:03,300 --> 00:07:06,520
هل يُعقل أنّ هذا العجوز أحد أقربائي؟

91
00:07:07,990 --> 00:07:11,200
...تلبسّت هابّي أولًا والآن الجد

92
00:07:11,570 --> 00:07:14,560
.لا أمتلك أيّ ذكريات تسبق وفاتي

93
00:07:14,910 --> 00:07:23,380
.لهذا السبب، قد يساعدني العثور على قاتلي ومعاقبته في استعادة ذكرياتي

94
00:07:23,460 --> 00:07:26,720
!أصدقائي ليسو أوعية لك، أتفهم؟

95
00:07:27,370 --> 00:07:31,180
هل كان لديّ من أدعوه صديقًا؟

96
00:07:31,620 --> 00:07:34,300
...كلا، أكثر ما يهم الآن

97
00:07:43,240 --> 00:07:45,100
.يالها من قوّة

98
00:07:45,440 --> 00:07:48,480
!هذه هي قوّته السحريّة

99
00:07:53,370 --> 00:07:55,480
.كما هو متوقّع من الجدّ

100
00:07:55,830 --> 00:07:57,220
...ولكن لمعلوماتك

101
00:07:58,820 --> 00:08:01,880
!الجد الحقيقيّ أقوى من ذلك بكثير

102
00:08:03,770 --> 00:08:05,410
.آسف أيّها الجد

103
00:08:05,410 --> 00:08:06,770
!لقد حان وقت الجديّة

104
00:08:07,810 --> 00:08:12,180
!الهجوم المدمّر لملك تنّين النار

105
00:08:17,350 --> 00:08:21,630
قـ-قوته السحريّة تتجاوز قوّتي؟

106
00:08:22,360 --> 00:08:28,900
.على الرغم من كميّة الطاقة السحريّة التي يمتلكها، إلّا أن الشيخوخة قد أخذت أثرها

107
00:08:29,940 --> 00:08:32,370
!كُفَّ عن التحدث كالعجائز

108
00:08:33,590 --> 00:08:34,620
!ما هذا؟

109
00:08:34,620 --> 00:08:38,300
.لقد اكتفيت من القتال

110
00:08:38,300 --> 00:08:41,190
.أجل، هذا لأنّكَ ضعيف

111
00:08:41,190 --> 00:08:43,460
.لا تقل ذلك يا غولدماين

112
00:08:44,040 --> 00:08:46,920
هل هذه ذكريات العجوز؟

113
00:08:46,920 --> 00:08:50,220
ياجيما
(حاليًا: مالك متجر)

114
00:08:47,230 --> 00:08:51,680
.رُبّما سأخرج من النقابة وأُصبح عضوًا في مجلس السحر أو ما شابه

115
00:08:51,680 --> 00:08:54,680
غولدماين
(حاليًا: زعيم نقابة كواترو كيربيروس)

116
00:08:51,930 --> 00:08:55,930
ولِمَ تختار أن تصبح أحد أعداءنا اللدودين؟

117
00:08:55,930 --> 00:08:59,930
بوب
(حاليًا: زعيم نقابة بلو بيغاسوس)

118
00:08:55,930 --> 00:08:59,930
روب

119
00:08:56,240 --> 00:08:59,780
.حسنٌ، أنا أيضًا أُفكر في الإستقلال بنفسي أيضًا

120
00:09:00,140 --> 00:09:01,310
.عجبًا عجبًا

121
00:09:01,310 --> 00:09:04,770
ماكاروف
(حاليًا: زعيم نقابة فيري تيل)

122
00:09:01,310 --> 00:09:04,890
!بوب، هل تُفكّر في مغادرة فيري تيل؟

123
00:09:05,270 --> 00:09:08,440
.وما الخطأ في ذلك؟! لدينا الكثير من الأعضاء

124
00:09:05,770 --> 00:09:08,440
بوريشكا
(حاليًا: المستشارة الطبيّة لفيري تيل)

125
00:09:08,760 --> 00:09:12,780
لِمَ ما تزالين في النقابة وأنتِ غير قادرة على استخدام السحر؟

126
00:09:13,210 --> 00:09:16,640
!هل تعي كم مرّة أنقذت جرعاتي حياتك؟

127
00:09:17,170 --> 00:09:19,050
.توقّفا عن الشجار كالأزواج

128
00:09:19,050 --> 00:09:20,660
.أنتُما مقرّبان كثيرًا

129
00:09:21,340 --> 00:09:22,600
!نحن لسنا متزوجان

130
00:09:22,600 --> 00:09:24,630
!من قد يتزوج شخصًا مثله؟

131
00:09:24,630 --> 00:09:26,280
.لقد احمرّ وجهيكما

132
00:09:26,280 --> 00:09:27,790
.استعجلا بالزواج وحسب

133
00:09:27,790 --> 00:09:28,720
!كفاك مزاحًا

134
00:09:28,720 --> 00:09:30,840
!لهذا أكره البشر

135
00:09:30,840 --> 00:09:31,860
!بسرعة

136
00:09:31,860 --> 00:09:33,220
!افتحوا الطريق

137
00:09:33,220 --> 00:09:34,050
!ما الخطب؟

138
00:09:34,050 --> 00:09:37,100
بريشت
(الزعيم السابق لفيري تيل)

139
00:09:34,720 --> 00:09:36,030
!شخصٌ مُصاب

140
00:09:36,030 --> 00:09:39,020
!لقد هاجمه سربٌ من الوحوش خلال أدائنا لمهمّة

141
00:09:39,460 --> 00:09:41,230
!بوريشكا، أرجوكِ

142
00:09:41,230 --> 00:09:42,900
!أنقذي حياته رجاءً

143
00:09:42,900 --> 00:09:43,890
.تنحّى جانبًا

144
00:09:43,890 --> 00:09:46,000
!يا لها من إصابة خطيرة

145
00:09:46,000 --> 00:09:47,730
!يا فتى، تماسك

146
00:09:50,690 --> 00:09:52,320
...هذا

147
00:09:52,930 --> 00:09:54,270
...هل

148
00:09:56,600 --> 00:10:01,080
فات الأوان... بالنسبة لي؟

149
00:10:01,560 --> 00:10:02,630
هاه؟

150
00:10:03,040 --> 00:10:06,030
!لا تكن أحمقًا! ستكون على ما يرام

151
00:10:06,030 --> 00:10:08,040
!أليس كذلك يا بوريشكا؟

152
00:10:09,470 --> 00:10:11,510
!أرجوكِ، أنقذيه

153
00:10:12,140 --> 00:10:16,150
ماكاروف، لِمَ أنت يائس... لهذه الدرجة؟

154
00:10:16,150 --> 00:10:21,890
.لا أتذكّر أننا... كنّا مقرّبين لهذه الدرجة

155
00:10:22,590 --> 00:10:25,420
!هذا لا يهمّ

156
00:10:25,420 --> 00:10:26,690
!نحن أصدقاء، ألسنا كذلك؟

157
00:10:27,090 --> 00:10:29,360
.أنتَ... مُحق

158
00:10:29,360 --> 00:10:31,680
!لا تمت يا ريس

159
00:10:31,680 --> 00:10:35,280
أنت تعرف اسمي؟

160
00:10:36,240 --> 00:10:38,240
.لم أتوقّع ذلك

161
00:10:38,730 --> 00:10:40,660
!ما الّذي تتحدّث عنه؟

162
00:10:41,200 --> 00:10:44,460
!كلانا أعضاء في فيري تيل

163
00:10:44,460 --> 00:10:47,630
!نحن عائلة! جميعنا

164
00:10:55,010 --> 00:10:56,880
!سُحقًا

165
00:11:01,910 --> 00:11:06,480
.إذًا فقد كنتُ ساحرًا في فيري تيل

166
00:11:07,050 --> 00:11:12,260
.رابطة النقابة التي هي أقوى من رابطة الدم أدت إلى هذا المستوى من التزامن

167
00:11:21,360 --> 00:11:22,830
.لقد خسرت

168
00:11:22,830 --> 00:11:24,330
ماذا؟

169
00:11:24,330 --> 00:11:26,710
.لقد تذكّرتُ كُل شيء

170
00:11:26,710 --> 00:11:30,540
.لم أعد قادرًا على مقاتلتك

171
00:11:31,250 --> 00:11:33,210
.فأنا وأنت عائلة بعد كُل شيء

172
00:11:33,760 --> 00:11:35,580
...أنت، جسدك

173
00:11:36,770 --> 00:11:39,780
.أجل. يُمكنني أخيرًا أن أعود

174
00:11:40,470 --> 00:11:43,430
.أشكرك على إيجادي

175
00:11:44,380 --> 00:11:45,780
.ريس

176
00:11:47,740 --> 00:11:50,350
.لقد افتقدتُك

177
00:11:50,350 --> 00:11:53,220
.لقد افتقدتُكَ أنا أيضًا يا ماكاروف

178
00:11:58,890 --> 00:12:00,820
ما الّذي حدث للتو؟

179
00:12:01,200 --> 00:12:03,070
.حسنٌ، على كُلٍ

180
00:12:03,070 --> 00:12:04,790
.لقد هزمتُ الجد على الأقل

181
00:12:07,250 --> 00:12:10,700
.وهكذا، لقد عدتُ إلى جسدي الآن

182
00:12:10,700 --> 00:12:12,490
!ناتسو

183
00:12:17,290 --> 00:12:19,620
ما كانت تلك الهزة للتو؟

184
00:12:19,620 --> 00:12:23,010
.رُبّما أحد الأجرام قد دُمر

185
00:12:23,010 --> 00:12:25,740
.أعتقد أنّهُ ليس لدينا الكثير من الوقت للعبث

186
00:12:25,740 --> 00:12:27,480
.كلا، كلا، كلا

187
00:12:27,820 --> 00:12:31,400
لِمَ أنتَ في عجلةٍ من أمرك؟

188
00:12:32,570 --> 00:12:34,100
!كانا-سان

189
00:12:34,100 --> 00:12:38,240
بجديّة؟ إنّها ثملة حتّى وهي تحت السيطرة؟

190
00:12:40,790 --> 00:12:44,670
.مقارنة بفيلق الرعد، لن يستغرق تولّي أمرها منّي الكثير

191
00:12:44,670 --> 00:12:47,160
!غراي-ساما، توخّى الحذر

192
00:12:47,590 --> 00:12:49,900
.آسف ولكن سأطيحُ بكِ بضربة واحدة

193
00:12:54,790 --> 00:12:58,050
.هاه؟ إن غراي مقلوب رأسًا على عقب

194
00:12:58,560 --> 00:13:00,050
!أنتِ ثملة

195
00:13:01,700 --> 00:13:05,860
!تجمّع، يا نهر النور المقاد من الجنيات

196
00:13:05,860 --> 00:13:09,270
!المع الآن، لكي تكسر أنياب الشرّ

197
00:13:09,710 --> 00:13:11,390
!فيري غليتر؟

198
00:13:11,720 --> 00:13:13,810
!في وسط البلدة؟

199
00:13:13,810 --> 00:13:14,860
!هل فقدتِ عقلكِ؟

200
00:13:15,200 --> 00:13:16,860
...فيري

201
00:13:20,630 --> 00:13:22,280
!لقد وصلتُ في الوقت المناسب

202
00:13:22,280 --> 00:13:24,730
.إنّ ذلك هو هجوم آريس المنفوش الخاص

203
00:13:24,730 --> 00:13:27,740
.بإمكانه إيقاف التعويذات الّتي تحتاج إلى ترتيل

204
00:13:28,080 --> 00:13:29,240
!لوسي

205
00:13:29,240 --> 00:13:31,210
ما هذا الهجوم المنفوش؟

206
00:13:31,210 --> 00:13:35,440
.غراي، جوفيا. لقد كنتُ أبحث عن كانا

207
00:13:35,440 --> 00:13:37,170
.أنا متفاجئٌ أنكِ عثرتِ عليها

208
00:13:37,170 --> 00:13:39,640
،هذا بفضل قدرة بلو الوحيدة

209
00:13:40,050 --> 00:13:42,150
!أنفٌ بمستوى مطابق لحاسة الشم لدى ناتسو

210
00:13:43,490 --> 00:13:47,220
أتعني بالأنف، ذلك الشيء الأشبه بالمثقاب؟

211
00:13:47,220 --> 00:13:49,480
.أجل، يبدو الأمر كذلك

212
00:13:54,100 --> 00:13:57,480
.أعلم أنّ كانا تحملهم معها دائمًا

213
00:13:58,810 --> 00:14:02,880
.إنّها على الأرجح تستغل الفرصة لمداعبة صدر كانا

214
00:14:03,960 --> 00:14:06,600
هل تريد فعل ذلك أيضًا يا غراي-ساما؟

215
00:14:06,600 --> 00:14:07,530
!كلا

216
00:14:07,530 --> 00:14:09,660
!عثرتُ عليها

217
00:14:09,660 --> 00:14:11,000
!البطاقات السحريّة

218
00:14:11,450 --> 00:14:14,220
.البطاقات الآتي تستخدمهم كانا دائمًا

219
00:14:14,220 --> 00:14:18,990
.هذا صحيح، هذه البطاقات لديها القوّة لاحتجاز الناس بداخلها

220
00:14:18,990 --> 00:14:20,570
...أنتِ مُحقة

221
00:14:20,570 --> 00:14:25,430
.يُمكننا استخدام هذه البطاقات لكي نجمع أصدقائنا ونحميهم في نفس الوقت

222
00:14:25,430 --> 00:14:28,330
ولكنّ ذلك السحر خاص بكانا، أليس كذلك؟

223
00:14:28,330 --> 00:14:30,810
،كلانا ساحرتان من النوع الحامل

224
00:14:28,330 --> 00:14:30,810
(النوع الحامل: الّذي يحتاج إلى أداة خارجيّة لاستخدام السحر (كالمفتاح أو البطاقة أو ما شابه

225
00:14:30,810 --> 00:14:34,540
.قد لا أكون بمستواها ولكن يُمكنني استخدامهم

226
00:14:34,540 --> 00:14:39,060
.وعلى عكس الأرواح السماويّة، هذه البطاقات لا تتطلّب عقدًا

227
00:14:39,540 --> 00:14:42,940
إذًا سنتمكّن من إعادة الجميع إلى طبيعتهم من خلال هذه البطاقات، أليس كذلك؟

228
00:14:43,210 --> 00:14:46,190
،إعادتهم إلى طبيعتهم هو أمرٌ آخر

229
00:14:46,190 --> 00:14:48,770
.ولكن أعتقد أننا نستطيع حمايتهم في الوقت الراهن

230
00:14:48,770 --> 00:14:51,410
.أوه، إنّكِ ذكيّة

231
00:14:51,410 --> 00:14:54,870
!لنبدأ باحتجاز كانا بداخل هذه البطاقة

232
00:14:59,360 --> 00:15:01,140
!لماذا؟

233
00:15:01,140 --> 00:15:02,420
!وما أدراني؟

234
00:15:02,420 --> 00:15:04,670
.لوسي احتجزت بداخل البطاقة

235
00:15:05,090 --> 00:15:06,890
.إنّهُ إجراءٌ مُضادّ

236
00:15:06,890 --> 00:15:11,430
.كانا وضعت فخًا لكي لا يُساء استخدامها

237
00:15:11,430 --> 00:15:13,480
.الأمر ليس كذلك

238
00:15:14,590 --> 00:15:19,690
.صحيحٌ أنّ هذه البطاقات متوفّرة في الأسواق ويُمكن استخدامها من قبل الجميع

239
00:15:19,690 --> 00:15:23,610
.ولكن هنالك حيلة لاحتجاز أحدٍ بداخلها

240
00:15:24,110 --> 00:15:25,280
.كانا

241
00:15:25,280 --> 00:15:26,740
.هكذا

242
00:15:29,200 --> 00:15:30,660
.وثمّ هكذا

243
00:15:33,430 --> 00:15:34,510
فهمتم؟

244
00:15:35,170 --> 00:15:37,520
كانا-سان، لماذا؟

245
00:15:37,520 --> 00:15:39,770
هل تحررتِ من السيطرة على العقل؟

246
00:15:39,770 --> 00:15:42,000
.كلا، ليست كذلك

247
00:15:42,000 --> 00:15:45,800
.حتّى إذا تحررت من السيطرة، فلا ينبغي أن تكون قادرة على استخدام السحر

248
00:15:45,800 --> 00:15:47,340
.كجوفيا

249
00:15:47,670 --> 00:15:49,140
سيطرة؟

250
00:15:49,850 --> 00:15:52,600
لِمَ أنا مرتدية هذه الملابس؟

251
00:15:53,030 --> 00:15:54,390
!هذا بشع

252
00:15:55,060 --> 00:15:58,590
.ماذا؟! أنا عارية أسفل هذه الملابس

253
00:15:59,060 --> 00:16:04,530
أيعقل أنّها لم تكن تحت السيطرة أصلًا لأنها كانت ثملة؟

254
00:16:06,780 --> 00:16:10,200
إذًا ما خطب فيري غليتر قبل قليل؟

255
00:16:10,200 --> 00:16:12,100
!ربّما فعلت ذلك لأنها كانت ثملة

256
00:16:12,100 --> 00:16:12,990
!مُخيف

257
00:16:16,290 --> 00:16:18,710
!لكن يسرّني هذا يا كانا

258
00:16:18,710 --> 00:16:21,540
مهلًا، مهلًا، هلّا أخبرتني بما يحدث؟

259
00:16:22,150 --> 00:16:24,970
.والآن، قد نتمكّن من إنقاذ الجميع

260
00:16:24,970 --> 00:16:26,600
!لنعثر عليهم

261
00:16:28,130 --> 00:16:29,470
.حسنٌ إّذًا

262
00:16:29,470 --> 00:16:33,470
أيُمكنني أن آكلك الآن يا تنّين البرق؟

263
00:16:33,470 --> 00:16:38,370
.لا أعلم من تكونين ولكنّني فهمتُ ماهيّة قوّتكِ

264
00:16:38,370 --> 00:16:39,980
.لا يُمكنكِ هزيمتي

265
00:16:39,980 --> 00:16:42,840
!أتساءل عن ذلك

266
00:16:45,690 --> 00:16:47,860
.لقد قطعتُ قوّتك

267
00:16:48,220 --> 00:16:50,820
!والآن، ستكون دميتي

268
00:16:54,070 --> 00:16:55,490
قوّتي؟

269
00:16:55,920 --> 00:16:58,530
.أنا آسفٌ يا آنسة، فأنا لا أمتلك شيئًا كهذا

270
00:17:00,040 --> 00:17:02,460
.أنا عضوٌ في النقابة لأنني ضعيف

271
00:17:02,460 --> 00:17:05,500
.ولكن لا أظنّ أنّ ذلك أمرًا سيئًا

272
00:17:05,500 --> 00:17:06,770
!مُستحيل

273
00:17:08,230 --> 00:17:10,000
!هدير الرعد

274
00:17:13,930 --> 00:17:16,390
.لا بأس أن تكون ضعيفًا أمام أصدقائك

275
00:17:17,430 --> 00:17:19,350
.لا داعي لأن تُحمّل نفسك فوق طاقتها

276
00:17:19,710 --> 00:17:23,310
.أعلم أنّ ذلك سيكون صعبًا على إيرزا

277
00:17:24,420 --> 00:17:29,780
.هذا الرجل لديه هذا القدر من القوّة إلّا أنّهُ يحمل ضعفًا في قلبه

278
00:17:30,840 --> 00:17:33,240
.أعتقد أنّني وقعتُ في حُبّه

279
00:17:34,080 --> 00:17:35,950
ما خطب هذه الشرنقة؟

280
00:17:35,950 --> 00:17:37,940
!إنّها لا تتزحزح

281
00:17:37,940 --> 00:17:40,910
!لا تقلقي بشأني والحقي بذلك الرجل

282
00:17:40,910 --> 00:17:42,360
...ولكن

283
00:17:42,850 --> 00:17:46,570
!أنا واثقة أنّهُ ذاهبٌ خلف الأجرام في المدن الأخرى

284
00:17:46,570 --> 00:17:48,250
!يجب أن توقفيه

285
00:17:48,770 --> 00:17:52,220
.إن هزمتيه، فستزول هذه الشرنقة أيضًا

286
00:17:53,500 --> 00:17:54,510
.حسنٌ

287
00:17:55,680 --> 00:17:58,140
!أعدكِ أن أعود لأجلكِ

288
00:18:03,280 --> 00:18:04,390
.عثرتُ عليك

289
00:18:04,390 --> 00:18:05,560
!لن أسمح لك بالهروب

290
00:18:10,510 --> 00:18:11,840
!شرنقتي

291
00:18:22,010 --> 00:18:23,340
...أنتِ

292
00:18:23,340 --> 00:18:26,110
.تركتُكِ تعيشين لأنّكِ مُثيرة للاهتمام

293
00:18:26,110 --> 00:18:29,050
.ولكن الآن، أتيتِ إليّ برغبتكِ

294
00:18:29,050 --> 00:18:30,590
.إنّكِ غبيّة يا شرنقتي

295
00:18:30,590 --> 00:18:33,980
.أتيتُ إلى هنا لإيقافك

296
00:18:34,440 --> 00:18:35,930
!من الأفضل أن تكون مُستعدًا

297
00:18:35,930 --> 00:18:38,760
.هذا مُستحيل يا شرنقتي

298
00:18:42,090 --> 00:18:43,250
علكة؟

299
00:18:44,500 --> 00:18:46,100
!ابتلعها؟

300
00:18:46,400 --> 00:18:48,700
.أنا آكل العلكة

301
00:18:48,700 --> 00:18:50,480
.زيادة القوةّ، اكتملت

302
00:18:57,450 --> 00:18:59,580
.والآن، سوف آكلكِ

303
00:19:02,150 --> 00:19:05,520
!احتجزنا ماكاو وواكابا وروميو

304
00:19:05,520 --> 00:19:07,480
من تمكّن من هزيمتهم يا ترى؟

305
00:19:07,480 --> 00:19:09,810
.بالنظر إلى اصاباتهم، قد يكون ناتسو

306
00:19:09,810 --> 00:19:11,960
...إلم تخنّي الذاكرة، في الأمام

307
00:19:13,000 --> 00:19:14,420
!ها هي ذا

308
00:19:14,730 --> 00:19:16,040
!ليسانا

309
00:19:16,040 --> 00:19:17,890
!ليسانا، احتجاز

310
00:19:19,570 --> 00:19:20,850
...هذه القوّة السحريّة

311
00:19:21,310 --> 00:19:23,610
.ميرا-سان وإيلفمان قريبان

312
00:19:23,610 --> 00:19:26,530
.وكذلك أعضاء ديابلوس

313
00:19:26,530 --> 00:19:27,810
.إنّهم مُثيرون للمتاعب

314
00:19:28,390 --> 00:19:31,770
.هذا يعني أننا سنواجه ميرا-تشان ورجل الرماد ذاك أيضًا

315
00:19:32,170 --> 00:19:35,530
ماذا لو قمنا باحتجازهم جميعًا في بطاقات كانا-سان؟

316
00:19:35,880 --> 00:19:38,700
.لن تجدي نفعًا أمام أهدافٍ عدائيين جدًا

317
00:19:38,700 --> 00:19:41,370
.لذا سيكون علينا إفقادهم وعيهم أولًا

318
00:19:41,850 --> 00:19:45,460
.لنفكر، أنا واثقة أنّ هنالك طريقة أخرى

319
00:19:50,110 --> 00:19:54,060
إن كنت أتذكّر بشكلٍ صحيح، الأوامر تنصّ على تدمير هذا الشيء، صحيح؟

320
00:19:55,360 --> 00:19:56,360
!انتظر

321
00:19:58,440 --> 00:19:59,590
.إيرزا

322
00:20:00,340 --> 00:20:02,550
.لن أدعك تلمسه

323
00:20:07,940 --> 00:20:12,100
هل تمكّن لاكسس من هزيمة عدوٍ قويّ مثلها؟

324
00:20:12,670 --> 00:20:14,270
.إنّهُ قويٌ كما توقّعت

325
00:20:14,660 --> 00:20:20,950
،لا أعلم كيف سأتمكّن من هزيمة لاكسس
.حتى وهو تحت تأثير السيطرة العقليّة للساحرة البيضاء

326
00:20:21,870 --> 00:20:25,410
...تمنّيتُ لو أن ناتسو أو غراي هنا

327
00:20:26,300 --> 00:20:28,160
.لا تقفي في طريقي

328
00:20:32,100 --> 00:20:34,590
.عليّ إيقافه

329
00:20:36,220 --> 00:20:40,380
ناتسو، لِمَ نحن ذاهبان إلى مدينة الظهر؟

330
00:20:40,380 --> 00:20:42,620
أليس ذلك واضحًا؟

331
00:20:42,620 --> 00:20:46,590
.يوجد خمسة مدن ومدينة الظهر متواجدة في المنتصف

332
00:20:46,590 --> 00:20:47,600
لذا؟

333
00:20:47,600 --> 00:20:51,080
في العادة، العدو الأقوى يكون متواجدًا في المنتصف، صحيح؟

334
00:20:51,080 --> 00:20:52,350
ماذا؟ أهذا صحيح؟

335
00:20:52,690 --> 00:20:54,770
.لا بدَّ أن لاكسس أو ميرا هناك أيضًا

336
00:20:54,770 --> 00:20:56,820
.إنني متفاجئ من استنتاجك

337
00:20:56,820 --> 00:20:58,790
!لا بأس بجيلال أيضًا

338
00:20:59,320 --> 00:21:03,420
إيرزا... إلى متى تخططين لإبقائي متشوقًا هكذا؟

339
00:21:06,800 --> 00:21:09,150
.أرى شعاعًا من النور هناك

340
00:21:09,150 --> 00:21:10,870
.لا بدَّ وأنّ شيئًا هناك

341
00:21:10,870 --> 00:21:12,950
ربّما أحد الأجرام؟

342
00:21:13,350 --> 00:21:14,840
!لنذهب يا هابّي

343
00:21:14,840 --> 00:21:16,710
!آي سار

344
00:21:23,650 --> 00:21:24,880
.أحدهم هنا

345
00:21:27,480 --> 00:21:28,690
...إنّها

346
00:21:29,550 --> 00:21:31,140
!الساحرة البيضاء؟

347
00:21:31,460 --> 00:21:34,010
لِمَ هي فاقدة للوعي هنا؟

348
00:21:34,010 --> 00:21:35,610
هابّي، أين الجرم؟

349
00:21:36,320 --> 00:21:38,570
.يبدو أنّهُ على ما يرام

350
00:21:39,360 --> 00:21:41,250
ما الّذي يجري؟

351
00:21:41,250 --> 00:21:43,820
أينبغي أن نقضي عليها بينما لدينا فرصة لذلك؟

352
00:21:43,820 --> 00:21:47,030
!أتريد أن تضرب امرأةً فاقدة للوعي؟

353
00:21:47,350 --> 00:21:49,450
...حسنٌ، عندما تصيغ الأمر بتلك الطريقة

354
00:21:49,780 --> 00:21:51,880
!حسنٌ! هيّئي نفسكِ

355
00:21:51,880 --> 00:21:53,420
لِمَ أنت مُتحمّس هكذا؟

356
00:21:53,820 --> 00:21:57,380
.نائمة أم لا، فتاةٌ أم لا، هذا لا يهمّ

357
00:21:57,380 --> 00:21:59,580
.إنّها عدوّة لنقابتنا

358
00:22:00,170 --> 00:22:03,840
.سأفعل أيّ شيءٍ لأجل النقابة

359
00:22:06,450 --> 00:22:07,800
...ناتسو-ساما

360
00:22:11,820 --> 00:22:13,310
!أنقذني