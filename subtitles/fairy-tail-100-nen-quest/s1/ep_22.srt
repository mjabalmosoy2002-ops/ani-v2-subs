1
00:00:03,190 --> 00:00:05,080
!تراجع يا ناتسو

2
00:00:05,080 --> 00:00:07,670
.أعرف كيف أتصرّف معها

3
00:00:07,670 --> 00:00:11,490
.تتصرّفين؟ ياله من قولٌ جريء يا أكورياس

4
00:00:11,490 --> 00:00:14,250
الأهم من ذلك، ما خطب منظركِ هذا؟

5
00:00:14,250 --> 00:00:17,000
أتعتقدين أنّ بإمكانكِ إغراء الرجال بذلك؟

6
00:00:17,000 --> 00:00:18,810
هلّا صمتِّ وحسب؟

7
00:00:18,810 --> 00:00:20,600
.كل شيءٍ تقولينه يُزعجني

8
00:00:21,020 --> 00:00:25,210
!من عليها أن تخرس هي أنتِ، أيّتها الشقيّة

9
00:00:29,570 --> 00:00:32,430
!لقد قالت أنّها "ستتعامل معها"ولكن في النهاية استخدمت القوّة الغاشمة

10
00:00:32,790 --> 00:00:35,140
!رائع! أعجبني ذلك

11
00:00:36,320 --> 00:00:41,270
.للأسف، إنّ سحر الماء لا يعمل ضدّ شخصيّتي الحاليّة

12
00:00:41,270 --> 00:00:44,190
.إنّكِ عديمة الحيلة أمامي في الوقت الراهن

13
00:00:44,190 --> 00:00:45,990
!أنتِ مُحقة

14
00:00:45,990 --> 00:00:50,280
.يبدو أنّه لم يعد لديكِ المؤخّرة الّتي اعتدتُ على صفعها عندما تتصرّفين بشغب

15
00:00:51,220 --> 00:00:53,700
!لذا سأصفعكِ على خدكِ بدلًا من ذلك

16
00:00:54,100 --> 00:00:55,730
!ما الّذي تظنّين نفسك فاعلة؟

17
00:00:56,460 --> 00:00:57,540
!خُذي

18
00:00:58,310 --> 00:01:02,830
!تحتاجين إلى مائة سنة لكي تحاولين هزيمتي

19
00:01:05,960 --> 00:01:07,330
...أنتِ

20
00:02:46,740 --> 00:02:47,990
!اتركيني

21
00:02:47,990 --> 00:02:49,940
.تذكّري يا لوسي

22
00:02:50,460 --> 00:02:53,420
.أنتِ ساحرة من فيري تيل

23
00:02:53,900 --> 00:02:56,500
هل نسيتِ أمر ناتسو أيضًا؟

24
00:02:58,580 --> 00:03:01,830
.علمتُ أنّ الأمر سيؤول لهذا

25
00:03:01,830 --> 00:03:04,520
.لا تقلقي يا سيلين-ساما

26
00:03:04,520 --> 00:03:08,420
.فنّ الروح خاصّتي لا يُمكن كسره بمثل هذه الطريقة

27
00:03:09,740 --> 00:03:12,380
...أشعر أنني أعرف هذا التيار المائي من مكانٍ ما

28
00:03:12,850 --> 00:03:15,820
.مياهي هي عبارة عن تيارٍ من الذكريات

29
00:03:15,820 --> 00:03:19,590
لقد شعرتِ بهذه المياه من قبل، صحيح؟

30
00:03:20,130 --> 00:03:21,550
...هذه الذكريات

31
00:03:30,600 --> 00:03:33,690
هل نسيتِ علاقتنا أيضًا؟

32
00:03:40,900 --> 00:03:41,820
!لوسي

33
00:03:42,160 --> 00:03:43,280
!مُستحيل

34
00:03:45,830 --> 00:03:48,390
!أكورياس

35
00:03:49,510 --> 00:03:51,410
.أنتِ لوسي

36
00:03:52,150 --> 00:03:52,980
.أجل

37
00:03:55,110 --> 00:03:57,310
نحن أصدقاء، أليس كذلك؟

38
00:03:57,310 --> 00:03:59,640
.أجل، أنا آسفة

39
00:03:59,640 --> 00:04:01,580
.هذا صحيح. أحسنتِ

40
00:04:01,580 --> 00:04:05,060
.ولكن... لا تزالين تستحقين عقابًا

41
00:04:05,530 --> 00:04:08,110
!عودي إلى طبيعتكِ، أيّتها الحمقاء

42
00:04:11,390 --> 00:04:12,900
!هذا عُنف

43
00:04:14,860 --> 00:04:18,280
...أووه! إن ساقي لوسي قد

44
00:04:18,280 --> 00:04:22,780
.أعتقد... أنّ خدّاي ومؤخّرتي قد تورّمتا

45
00:04:23,840 --> 00:04:25,770
!ماذا؟! أكورياس؟

46
00:04:25,770 --> 00:04:27,450
!لقد عادت لطبيعتها

47
00:04:27,450 --> 00:04:30,720
...مُحال! هذا غير ممكن

48
00:04:30,720 --> 00:04:33,650
!ناتسو؟ ما الّذي يحدث هنا؟

49
00:04:33,650 --> 00:04:35,310
.لا يهم

50
00:04:35,310 --> 00:04:38,440
،بما أنّكِ لستِ بحاجة لعقد أو مفتاحٍ هنا

51
00:04:39,000 --> 00:04:43,280
لقد مرّ وقتُ طويل لذا ما رأيكِ أن نُخرج كل ما لدينا يا لوسي؟

52
00:04:44,410 --> 00:04:45,740
!أجل

53
00:04:45,740 --> 00:04:50,440
.مرحى! لا أعلم كيف ولكنني تمكّنتُ من ملاقاتكِ مُجددًا

54
00:04:50,440 --> 00:04:52,190
!كُفّي عن معانقتي أيّتها الشقيّة

55
00:04:52,190 --> 00:04:54,740
.ولكنكِ كُنتِ تعانقينها قبل قليل

56
00:04:54,740 --> 00:04:56,550
.إنّكِ مثيرة للحيرة

57
00:04:56,550 --> 00:04:58,150
!اخرس

58
00:04:58,580 --> 00:05:00,000
لماذا؟

59
00:05:00,000 --> 00:05:02,420
...كيف كُسرت تعويذتي

60
00:05:02,420 --> 00:05:04,790
.كما توقّعت، إنّ الهجمات الجسديّة هي الأفضل

61
00:05:04,790 --> 00:05:05,870
!هذا غير صحيح إطلاقًا

62
00:05:06,560 --> 00:05:10,200
...الذكريات، المشاعر، العلاقات

63
00:05:10,200 --> 00:05:15,180
.أجل، أحيانًا المشاعر يُمكنها أن تتفوّق على السحر وفنون الروح

64
00:05:15,180 --> 00:05:17,100
.مثيرٌ للاهتمام

65
00:05:23,620 --> 00:05:26,490
!سأبذل ما بوسعي لهزيمة غراي-ساما، نيان

66
00:05:26,490 --> 00:05:28,930
.أنا آسف يا هابّي وشارولو

67
00:05:28,930 --> 00:05:31,770
.لقد أصبحتما تُشبهان النمور الآن

68
00:05:32,780 --> 00:05:34,210
!تجمّدا

69
00:05:37,540 --> 00:05:38,950
!لا أستطيع تجميدهما؟

70
00:05:38,950 --> 00:05:39,990
.يا لسوء حظّك

71
00:05:39,990 --> 00:05:40,900
.آي

72
00:05:40,900 --> 00:05:45,150
.إنّ جليدك لا فائدة له أمام الطاقة الروحيّة

73
00:05:45,150 --> 00:05:46,870
.أنا آسفة-نيان

74
00:05:47,270 --> 00:05:49,010
!ماذا ينبغي عليّ أن أفعل؟

75
00:05:49,010 --> 00:05:50,800
.هابّي، شارولو

76
00:05:50,800 --> 00:05:52,440
.أسقطاه-نيان

77
00:05:56,560 --> 00:05:57,750
.ليس لديّ خيارٌ آخر

78
00:05:57,750 --> 00:06:00,880
،ليس من عادتي أن أضرب الحيوانات الصغيرة

79
00:06:01,360 --> 00:06:03,150
!ولكن الآن أنتُما عملاقين

80
00:06:03,900 --> 00:06:04,840
!لذا سأبرحكم ضربًا

81
00:06:04,840 --> 00:06:07,710
!لقد لجأ إلى القوّة الغاشمة في نهاية المطاف

82
00:06:07,710 --> 00:06:08,810
.هذا رائع

83
00:06:09,120 --> 00:06:12,780
.من المُستحيل أن يُبطل فنّي مُجددًا بنفس الطريقة

84
00:06:15,970 --> 00:06:17,650
!غراي

85
00:06:21,100 --> 00:06:22,490
!لا أستطيع فعل هذا

86
00:06:22,490 --> 00:06:25,740
!لا تكن قاسيًا مع هابّي وشارولو-نيا

87
00:06:25,740 --> 00:06:27,790
هل أنتَ بخير يا غراي؟

88
00:06:27,790 --> 00:06:28,880
ماذا؟

89
00:06:28,880 --> 00:06:31,620
!إنّ هاذان هما هابّي وشارولو

90
00:06:33,330 --> 00:06:34,630
!ماذا؟

91
00:06:35,040 --> 00:06:37,040
!هابّي وشارولو؟

92
00:06:37,040 --> 00:06:38,500
.إنهما نمران، بغض النظر عن نظرتك إليهم

93
00:06:38,500 --> 00:06:39,610
!لوسي

94
00:06:39,610 --> 00:06:41,250
!وأكورياس؟

95
00:06:41,250 --> 00:06:43,300
.لنؤجّل الحديث لوقتٍ لاحق

96
00:06:43,300 --> 00:06:46,380
.أولًا علينا أن نُعيد القطان والفتاة الصغيرة إلى طبيعتهم

97
00:06:46,380 --> 00:06:48,340
ولكن كيف؟

98
00:06:49,350 --> 00:06:50,810
.هكذا

99
00:06:54,020 --> 00:06:55,620
!ما الّذي تفعلينه بويندي؟

100
00:06:55,620 --> 00:06:56,520
!أنتِ

101
00:06:56,520 --> 00:06:58,650
!اخرسوا وراقبوا فحسب

102
00:06:59,730 --> 00:07:04,110
.فهمت! لا بدَّ وأنّ مياه أكورياس تحوي على نوعٍ من التأثير العلاجي

103
00:07:06,540 --> 00:07:09,380
ما هذه المياه-نيا؟

104
00:07:11,290 --> 00:07:12,490
.إنّها سُمّ

105
00:07:12,490 --> 00:07:13,700
!ماذا؟

106
00:07:13,700 --> 00:07:15,290
!أووووووووووي

107
00:07:15,630 --> 00:07:21,000
.هذه المياه ستُدمّر كُل خليّةٍ في جسدكِ وستقودكِ إلى الموت

108
00:07:21,000 --> 00:07:22,570
!ماذا تظنّين نفسكِ فاعلة؟

109
00:07:22,570 --> 00:07:24,190
!اخرسي وحسب

110
00:07:25,340 --> 00:07:27,270
.لسوء حظّكِ-نيان

111
00:07:27,270 --> 00:07:31,300
.يُمكنني استخدام تعويذة للتخلّص من كل تغييرات الحالة-نيا

112
00:07:33,470 --> 00:07:35,060
!أسرعي واستخدميها يا ويندي

113
00:07:35,060 --> 00:07:36,340
!رايز

114
00:07:44,440 --> 00:07:46,940
!التحوّل إلى يوكاي كان تغييرًا في الحالة

115
00:07:46,940 --> 00:07:50,850
...لذا إن قامت ويندي بإلقاء تلك التعويذة على نفسها

116
00:07:51,870 --> 00:07:53,870
.يبدو أنّكِ عدتِ لطبيعتكِ

117
00:07:53,870 --> 00:07:57,620
.حسنٌ، لقد كانت مُجرّد مياه عاديّة وليست سُمًّا

118
00:08:03,630 --> 00:08:05,780
!ويندي

119
00:08:05,780 --> 00:08:08,010
!أسرعي وأعيدي القطان لطبيعتهما أيضًا

120
00:08:08,010 --> 00:08:09,500
!حـ-حسنًا

121
00:08:10,850 --> 00:08:12,300
...مُستحيل

122
00:08:15,640 --> 00:08:19,330
إذًا لقد كُنّا تحت سيطرة أحدهم؟

123
00:08:19,330 --> 00:08:21,150
لقد كنتُ نمرًا عملاقًا؟

124
00:08:21,430 --> 00:08:25,180
.أشعر وكأنني قمتُ بأمرٍ مُثير للإحراج

125
00:08:25,180 --> 00:08:26,110
.لا تقلقي

126
00:08:26,110 --> 00:08:29,150
.لقد كانت هذه تتجوّل بصدرٍ مكشوف

127
00:08:29,150 --> 00:08:30,560
!ماذا؟! حقًا؟

128
00:08:30,560 --> 00:08:32,720
.أجل، وقمتِ بحشرهما في وجهي

129
00:08:33,490 --> 00:08:35,970
.يا يوكو

130
00:08:35,970 --> 00:08:37,610
.لقد بدأتُ أسأم

131
00:08:37,610 --> 00:08:40,500
.لا تقلقي يا سيلين-ساما

132
00:08:40,500 --> 00:08:42,450
!العرض الحقيقي سيبدأ الآن

133
00:08:42,450 --> 00:08:46,860
.إليكِ السيافة القرمزيّة، الّتي قمتُ بتقويتها بفنون الروح خاصّتي

134
00:08:46,860 --> 00:08:48,050
...والمعروفة الآن بـ

135
00:08:49,760 --> 00:08:50,740
...ما

136
00:08:50,740 --> 00:08:52,220
...هـ-هذا

137
00:08:56,660 --> 00:08:59,210
!اليوكاي... المرأة العنكبوت

138
00:08:59,810 --> 00:09:01,330
!إيرزا

139
00:09:02,210 --> 00:09:03,500
!هذا سيّئ

140
00:09:03,500 --> 00:09:05,690
...إن كانت قوّة إيرزا قد تدعيمها أيضًا

141
00:09:06,440 --> 00:09:07,690
!دعوها لي

142
00:09:07,990 --> 00:09:09,030
!رايز

143
00:09:14,880 --> 00:09:17,370
مـ-ما الّذي حدث للتو؟

144
00:09:17,370 --> 00:09:18,840
!لقد عادت

145
00:09:18,840 --> 00:09:20,160
!مرحى

146
00:09:20,160 --> 00:09:22,210
.كم هذا مخيبٌ للآمال

147
00:09:22,210 --> 00:09:25,560
.حسنٌ، ينبغي لهذا أن يبيّن مدى قوّة ويندي

148
00:09:26,630 --> 00:09:27,590
.يوكو

149
00:09:28,420 --> 00:09:29,810
.لقد سئمت

150
00:09:30,230 --> 00:09:31,980
.أُريد أن أراهم مشوهين أكثر

151
00:09:32,530 --> 00:09:35,740
.بالكاد يُمكنني أن أشرب شرابي هكذا

152
00:09:35,740 --> 00:09:40,470
.اذهبي ومتّعيني بنفسكِ

153
00:09:41,370 --> 00:09:42,940
!لن أخذلك

154
00:09:43,680 --> 00:09:47,780
.سأقوم بإرسالهم إلى قعر الجحيم المشوّه

155
00:09:51,190 --> 00:09:54,090
هذه هي قرية التبييض؟

156
00:09:54,090 --> 00:09:55,160
.هذا غريب

157
00:09:55,160 --> 00:09:57,580
.لا أشعر بوجود أحد

158
00:10:04,180 --> 00:10:06,640
!مُستحيل... قريتي

159
00:10:15,590 --> 00:10:16,980
!هنالك شخص هناك

160
00:10:23,120 --> 00:10:24,890
!هل أنتَ من فعل هذا؟

161
00:10:24,890 --> 00:10:25,900
...هذا فظيع

162
00:10:25,900 --> 00:10:27,060
.كلا

163
00:10:27,060 --> 00:10:30,360
.لقد كنتُ مارًا من هنا فحسب

164
00:10:32,130 --> 00:10:33,480
!مُحال

165
00:10:33,480 --> 00:10:37,400
!لا أحد "يمر" من مكانٍ في أعماق الجبال وحسب

166
00:10:37,400 --> 00:10:38,450
.هذا مُقنع

167
00:10:38,450 --> 00:10:41,800
.أشعر بطاقة آرث لاند السحريّة تصدر من هذا الرجل

168
00:10:41,800 --> 00:10:43,790
.إنّهُ ليس من إيلينتير

169
00:10:43,790 --> 00:10:45,010
.هذا صحيح

170
00:10:45,010 --> 00:10:47,750
.ولكن أخشى أنني ضائع

171
00:10:48,510 --> 00:10:51,960
.ليس من شيمي قتل النساء والأطفال

172
00:10:51,960 --> 00:10:56,460
.أنا الّتي قمتُ باستدعاء سوزاكو-ساما إلى هنا

173
00:10:57,560 --> 00:10:59,330
!رئيسة عذراوات الضريح

174
00:11:00,650 --> 00:11:01,930
!يسرّني أنّكِ بخير

175
00:11:01,930 --> 00:11:04,090
.يسعدني عودتكِ يا فاريس

176
00:11:04,090 --> 00:11:05,600
هل تأذيتِ؟

177
00:11:05,600 --> 00:11:07,770
.انظري بنفسكِ

178
00:11:07,770 --> 00:11:11,650
."كل اللواتي سقطن هنا هن "تسومياكا

179
00:11:11,650 --> 00:11:15,710
.سُكّان القرية بخير

180
00:11:15,710 --> 00:11:17,390
تسومياكا؟

181
00:11:17,390 --> 00:11:18,300
ما هذا؟

182
00:11:18,300 --> 00:11:21,060
."وحوشُ مولودون من "اليد

183
00:11:21,060 --> 00:11:24,060
.إنّ هؤلاء يتقمّصون هيئاتٍ بشريّة

184
00:11:24,060 --> 00:11:25,500
.لا يزال هذا غير واضح

185
00:11:30,460 --> 00:11:34,990
.هذا يدل على مدى عدم استقرار الطاقة السحريّة في إيلينتير

186
00:11:34,990 --> 00:11:37,800
.أنتِ مُحقّة. إنّ جميعهم تسومياكا

187
00:11:37,800 --> 00:11:39,220
.قذارة

188
00:11:39,220 --> 00:11:44,390
.كل هذا بسبب قدوم تلك التنّينة المسمّاة سيلين إلى هذا العالم

189
00:11:44,670 --> 00:11:45,810
سيلين؟

190
00:11:46,230 --> 00:11:52,190
.لهذا السبب استدعيتُ خبير في صيد التنانين من آرث لاند

191
00:11:52,520 --> 00:11:54,440
.وقد اخترتُ الأوسم منهم

192
00:11:54,440 --> 00:11:55,900
.هذا مُحيّر

193
00:11:55,900 --> 00:12:03,160
إذن فقد تمّ استدعائي إلى هنا بلا موافقتي من أجل قتل سيلين؟

194
00:12:03,160 --> 00:12:06,410
...استُدعيت، أو بالأحرى اختُطفت

195
00:12:06,790 --> 00:12:11,420
أيُمكننا أن نعتمد على مهاراتك في صيد التنانين يا سوزاكو-ساما؟

196
00:12:11,940 --> 00:12:13,210
.طبعًا

197
00:12:14,640 --> 00:12:15,520
.للتأكّد

198
00:12:16,280 --> 00:12:20,900
بسبب سيلين، طاقة هذا العالم السحريّة غير مستقرّة؟

199
00:12:20,900 --> 00:12:21,890
.هذا صحيح

200
00:12:21,890 --> 00:12:25,660
،ما لم نقم بالإطاحة بها، فإن طاقة إيلينتير السحريّة ستخرج عن السيطرة

201
00:12:25,660 --> 00:12:28,640
.وعندها سيختفي هذا العالم

202
00:12:28,980 --> 00:12:30,170
.مفهوم

203
00:12:30,170 --> 00:12:33,110
.ليس لدي اعتراضٌ فيما يخص الإطاحة بسيلين

204
00:12:33,700 --> 00:12:36,350
...ولكن فيما يخص فيري تيل الذين تحدّثتِ عنهم

205
00:12:37,000 --> 00:12:38,420
.إنّهم أعدائي

206
00:12:38,420 --> 00:12:41,360
.حسب فهمي، إنّهم أعداءٌ لنقابتي

207
00:12:41,360 --> 00:12:43,320
!إنّهم ليسو أشرارًا

208
00:12:43,320 --> 00:12:45,250
!إنّهم أخيار حقًا

209
00:12:45,250 --> 00:12:47,240
ألا يُمكنك أن تتعاون معهم؟

210
00:12:47,240 --> 00:12:48,470
.هذا مُحيّر

211
00:12:48,470 --> 00:12:50,160
!بالطّبع، لا مشكلة

212
00:12:50,160 --> 00:12:52,070
.إن وقفوا في طريقك، قم بقطعهم وحسب

213
00:12:52,070 --> 00:12:53,170
!لا تفعل ذلك

214
00:12:54,170 --> 00:12:55,420
!أيتها الرئيسة

215
00:12:55,420 --> 00:12:56,570
!لدينا مُشكلة

216
00:12:56,570 --> 00:12:58,210
!هنالك موجة ثانية من التسومياكا

217
00:12:58,210 --> 00:13:00,340
!كما أنّهم كبارٌ جدًا هذه المرّة

218
00:13:00,340 --> 00:13:01,800
!ماذا؟

219
00:13:04,650 --> 00:13:06,610
!جميعكم احملوا أسلحتكم

220
00:13:06,610 --> 00:13:08,100
!علينا أن نحمي القرية

221
00:13:08,100 --> 00:13:10,180
!سـ-سوزاكو-ساما

222
00:13:10,180 --> 00:13:12,330
!نحتاج إلى مساعدتك

223
00:13:12,330 --> 00:13:13,230
.مرفوض

224
00:13:15,150 --> 00:13:16,770
!ما الّذي تعنيه بذلك؟

225
00:13:23,550 --> 00:13:25,000
...التسومياكا الضخمة

226
00:13:25,000 --> 00:13:25,780
...في طرفة عين

227
00:13:26,680 --> 00:13:28,040
!ما الّذي حدث للتو؟

228
00:13:28,870 --> 00:13:31,250
.هذا لأنني تولّيتُ أمرهم بالفعل

229
00:13:31,250 --> 00:13:32,330
هاه؟

230
00:13:32,330 --> 00:13:34,350
مـ... ما الّذي فعله للتو؟

231
00:13:34,350 --> 00:13:36,460
!لم يتحرّك قيد أنملة حتّى

232
00:13:36,460 --> 00:13:38,530
!كما هو متوقّع من سوزاكو-ساما

233
00:13:38,530 --> 00:13:40,260
!أنت وسيمٌ جدًا

234
00:13:40,750 --> 00:13:43,510
والآن، أين هي سيلين؟

235
00:13:43,870 --> 00:13:47,920
.سمعتُ أنّها تقطن في جبل القمر الأسود

236
00:13:47,920 --> 00:13:48,850
.فهمت

237
00:13:49,860 --> 00:13:51,920
.سأقوم بقتلها من أجلكم

238
00:13:53,750 --> 00:13:56,600
.وكذلك فيري تيل، إن وقفوا في طريقي

239
00:14:00,440 --> 00:14:03,420
تحوّلتُ إلى... عنكبوت؟

240
00:14:03,420 --> 00:14:05,760
.لقد كنتُ قطّة

241
00:14:05,760 --> 00:14:08,010
!أنا وشارولو كنّا نمورًا

242
00:14:08,010 --> 00:14:09,800
لِمَ تبدو سعيدًا بذلك؟

243
00:14:09,800 --> 00:14:12,240
...وهذه كانت تتجوّل بصدرها المكشـ

244
00:14:12,240 --> 00:14:14,010
!هلّا توقّفتي عن الحديث عن ذلك

245
00:14:14,890 --> 00:14:16,930
.أتساءل كيف سيبدو ناتسو وغراي إن تحوّلا إلى وحوش

246
00:14:16,930 --> 00:14:19,930
.كنتُ سأُصبح تنّين شمعة

247
00:14:19,930 --> 00:14:20,850
!هذا سخيف

248
00:14:20,850 --> 00:14:24,140
.على كُل حال، هذا مكان هو حيث تسكن سيلين

249
00:14:24,140 --> 00:14:26,360
.ويبدو أننا في سفح الجبل

250
00:14:26,360 --> 00:14:27,300
ماذا نفعل؟

251
00:14:27,300 --> 00:14:30,320
!بالطّبع، سنتسلّق لأعلى الجبل ونبرحها ضربًا

252
00:14:30,320 --> 00:14:32,060
.لا يُمكنني السماح بذلك

253
00:14:32,520 --> 00:14:34,750
.أنا يوكو، أحد آلهة ضوء القمر

254
00:14:34,750 --> 00:14:37,990
.سأقوم بتحويلكم إلى يوكاي أكثر بشاعة

255
00:14:39,400 --> 00:14:41,250
!لن تنطلي علينا حيلتكِ مُجددًا

256
00:14:41,250 --> 00:14:44,110
.إذًا هي من قامت بتحويلكم إلى يوكاي

257
00:14:44,110 --> 00:14:46,360
!حوليني إلى يوكاي ترتدي ملابسًا على الأقل

258
00:14:46,360 --> 00:14:48,090
...طاقتها السحريّة

259
00:14:48,090 --> 00:14:50,510
.إنّها غير طبيعيّة، مثل امرأة الثلج تلك

260
00:14:50,510 --> 00:14:54,000
.إنّها طاقة روحيّة. إنّها مُختلفة عن الطاقة السحريّة

261
00:14:54,350 --> 00:14:57,580
!سأقوم بسحر طاقة الجميع السحريّة بسبيريا

262
00:14:58,860 --> 00:15:00,840
!ينبغي أن تكونوا قادرين على مقاتلتها الآن

263
00:15:01,210 --> 00:15:03,690
...يبدو أنّكم ما زِلتُم لا تعون

264
00:15:05,300 --> 00:15:08,820
...الرعب الحقيقي لموكب الشياطين

265
00:15:10,100 --> 00:15:13,210
!والآن، بإمكانكم إلتهامهم

266
00:15:14,180 --> 00:15:15,670
!هنالك الكثير منهم

267
00:15:15,670 --> 00:15:17,560
!ويستمرون بالقدوم

268
00:15:17,560 --> 00:15:19,710
!سيتم محاصرتنا على هذا المُعدل

269
00:15:19,710 --> 00:15:21,200
ماذا نفعل يا ناتسو؟

270
00:15:21,200 --> 00:15:23,030
أليس هذا واضحًا؟

271
00:15:23,940 --> 00:15:25,750
!نقضي عليهم جميعًا

272
00:15:25,750 --> 00:15:26,860
!لا فائدة

273
00:15:28,000 --> 00:15:30,530
!هاتوا ما لديكم

274
00:15:30,890 --> 00:15:35,570
ألا تعلمين أنّ لدينا فارسة قتلت مائة وحش؟

275
00:15:36,340 --> 00:15:40,460
.كلا... من حيث القوّة الفرديّة، فإنّ هؤلاء أقوى بكثير من الذين واجهتهم من قبل

276
00:15:40,830 --> 00:15:41,960
!لا تُقللوا من حذركم

277
00:15:41,960 --> 00:15:45,340
!هجوم جناح تنّينة السماء

278
00:15:47,220 --> 00:15:49,090
!أكوا ميتوريا

279
00:15:51,420 --> 00:15:53,070
!هل هم مقاومون للماء؟

280
00:15:55,030 --> 00:15:56,140
!لوسي

281
00:15:59,720 --> 00:16:01,320
!هنالك الكثير منهم

282
00:16:02,160 --> 00:16:03,140
...في هذه الحالة

283
00:16:03,140 --> 00:16:04,110
!أجل

284
00:16:04,440 --> 00:16:07,570
!عجلة السماء: بلومينبلاتُ

285
00:16:10,180 --> 00:16:13,960
!قبضة ملك تنّين النار المدمّرة

286
00:16:23,210 --> 00:16:26,600
!إنّهم يظهرون أسرع بكثير من قدرتنا على هزيمتهم

287
00:16:26,600 --> 00:16:28,560
!ماذا نفعل؟ ماذا نفعل؟

288
00:16:28,560 --> 00:16:32,270
.هذا هو موكب الشياطين، فن روحي غير نهائي

289
00:16:32,750 --> 00:16:39,980
!ويُمكنني استدعاء أكثر من مائة وحش، لا يوجد حدّ

290
00:16:39,980 --> 00:16:42,130
!لن ينتهي الأمر على هذا المُعدّل

291
00:16:42,130 --> 00:16:44,870
.سنحتاج إلى مزيدٍ من الأشخاص إلى جانبنا

292
00:16:45,200 --> 00:16:48,510
!لوسي، قومي باستدعاء جميع الأرواح السماويّة المتعاقدين معكِ

293
00:16:48,970 --> 00:16:50,710
!هذا مُستحيل

294
00:16:50,710 --> 00:16:55,700
.في هذه الأرض، بإمكانكِ استدعاء الأرواح السماويّة بلا حاجة لمفاتيح أو طاقة سحريّة

295
00:16:55,700 --> 00:16:57,090
.هذا صحيح

296
00:16:57,090 --> 00:16:59,220
!إذًا فسوف نحظى بحفلةٍ اليوم

297
00:16:59,660 --> 00:17:03,640
!أفتحي أيتها البوابات الذهبيّة الإثني عشر

298
00:17:04,120 --> 00:17:05,900
!أيّها الجميع، أرجوكم

299
00:17:08,570 --> 00:17:09,590
!وي آر

300
00:17:09,590 --> 00:17:11,920
.إنّها حربٌ شاملة، موشي-موشي

301
00:17:11,920 --> 00:17:13,720
.إننا في خدمتكِ يا أميرة

302
00:17:13,720 --> 00:17:16,280
من الطفل المشاغب هنا؟

303
00:17:16,280 --> 00:17:17,490
!هيّا بنا، إيبي

304
00:17:17,490 --> 00:17:19,140
.اسمحي لي بتقديم الدعم لكِ

305
00:17:19,140 --> 00:17:21,300
.سوف نقوم بهزيمتهم، أنا آسفة

306
00:17:21,300 --> 00:17:23,950
!مووو! اعتمدي عليّ

307
00:17:24,660 --> 00:17:26,160
!هذا رائع

308
00:17:26,160 --> 00:17:27,970
.ياله من منظر

309
00:17:27,970 --> 00:17:29,040
.كم هذا مُشجّع

310
00:17:29,490 --> 00:17:30,670
!ها نحن قادمون

311
00:17:41,170 --> 00:17:45,410
!ستار دريس ميكس: هيئة ليو فارغو

312
00:17:46,020 --> 00:17:47,820
...يا ضوء ريغولوس

313
00:17:48,560 --> 00:17:50,640
!يا بريق سبيكا

314
00:17:51,060 --> 00:17:52,810
!ليون مايدن

315
00:17:51,060 --> 00:17:52,810
!عذراء الأسد

316
00:17:54,520 --> 00:17:57,020
!مهما كان عدد ما تُطيحون بهم، فلا فائدة

317
00:17:57,020 --> 00:17:59,440
.لا يملك البشر فرصةً أمام اليوكاي الغير منتهي

318
00:18:00,400 --> 00:18:03,940
ولكن ماذا إن قُمنا بهزيمة مصدر تلك اليوكاي الا نهائيّة؟

319
00:18:16,560 --> 00:18:17,380
...ليس مُجددًا

320
00:18:17,380 --> 00:18:20,760
والآن، أين أنا؟

321
00:18:31,310 --> 00:18:32,350
!هناك

322
00:18:32,960 --> 00:18:34,310
!ماذا؟

323
00:18:34,740 --> 00:18:38,780
.صوتكِ الصادر من جسدكِ يختلف عن الصوت الصادر من الدمى الورقيّة

324
00:18:38,780 --> 00:18:40,390
!أنتِ

325
00:18:42,700 --> 00:18:45,390
.سأضع حدًا لهذا

326
00:18:52,730 --> 00:18:54,540
!أيّها اليوكاي

327
00:18:55,090 --> 00:18:56,990
!احموني

328
00:19:08,400 --> 00:19:11,060
.فهمت... مُثيرٌ للاهتمام

329
00:19:13,550 --> 00:19:18,650
.لقد مرّ وقتٌ طويل على استخدامي "لذلك"، أعتقد أنني سأستخدمه عليكم

330
00:19:26,010 --> 00:19:27,570
!إنّ ذلك وشاحي

331
00:19:28,160 --> 00:19:29,820
...ذلك الوغد

332
00:19:30,610 --> 00:19:31,620
!انتظر

333
00:19:31,620 --> 00:19:34,580
!سأقوم بحرقك! أعده

334
00:19:35,770 --> 00:19:38,020
ما هذه القوّة؟

335
00:19:40,400 --> 00:19:44,260
.إنّه فنٌ روحي لتحويل نفسي إلى يوكاي

336
00:19:44,600 --> 00:19:47,210
!الطريق الغير إنساني: أوماغاتوكي

337
00:19:47,500 --> 00:19:48,910
!لديها أربعة أذرع؟

338
00:20:01,280 --> 00:20:03,780
.لا يُمكنكِ هزيمتي بذراعين فقط

339
00:20:03,780 --> 00:20:05,640
.أنتِ مُحقّة

340
00:20:06,060 --> 00:20:08,390
...في هذه الحالة، تبديل

341
00:20:11,050 --> 00:20:12,600
!درع المائة ذراع

342
00:20:13,960 --> 00:20:14,910
هاه؟

343
00:20:14,910 --> 00:20:21,130
.‫تحتوي كل ذراع على "SE-plug" مدمج ويمكن تحريكها بشكل فردي

344
00:20:14,910 --> 00:20:21,130
قابس طاقة ذاتية

345
00:20:21,550 --> 00:20:24,590
.ولكن عيبها الوحيد هو أنّها ثقيلة جدًا

346
00:20:25,270 --> 00:20:29,300
.لقد كنت أُخطط لاستخدامها في موكب مهرجان حصاد ماغنوليا

347
00:20:29,530 --> 00:20:30,450
...ما

348
00:20:35,210 --> 00:20:37,380
.أربعة أذرع لن تكفي لمجاراة هؤلاء

349
00:20:41,890 --> 00:20:44,390
سينجو: أكوريو تايسان

350
00:20:41,890 --> 00:20:44,390
!ألف ذراع: طرد الأرواح الشريرة

351
00:20:48,850 --> 00:20:50,320
!يوكو-دونو

352
00:20:50,320 --> 00:20:51,440
.عجبًا عجبًا

353
00:21:00,290 --> 00:21:01,740
...اليوكاي

354
00:21:01,740 --> 00:21:03,120
.إنّهم يختفون

355
00:21:06,850 --> 00:21:08,500
!لقد نجونا

356
00:21:08,500 --> 00:21:10,550
.ظننتُ أننا هالكون

357
00:21:10,550 --> 00:21:11,720
!لقد نجحنا

358
00:21:12,210 --> 00:21:13,720
.شُكرًا لكم جميعًا

359
00:21:13,720 --> 00:21:15,720
.لقد كان ذلك صعبًا

360
00:21:15,720 --> 00:21:16,980
.بالمناسبة يا أميرة

361
00:21:17,350 --> 00:21:20,480
.لم أعد أرى ناتسو-سان بالجوار

362
00:21:20,480 --> 00:21:21,190
هاه؟

363
00:21:21,560 --> 00:21:23,210
!هل نالوا منه-إيبي؟

364
00:21:23,210 --> 00:21:26,070
.لا يُمكن أن يُهزم بتلك السهولة

365
00:21:26,070 --> 00:21:29,520
.قد يكون ذلك خطأي، أنا آسفة

366
00:21:30,910 --> 00:21:35,290
.ناتسو-ساما ذهب من هذا الأتجاه، كان يطارد إبريقًا يرتدي وشاحًا

367
00:21:35,290 --> 00:21:36,370
!إبريق؟

368
00:21:36,370 --> 00:21:39,480
.مووو... لقد كان يبدو أشبه براكون بالنسبة لي

369
00:21:41,710 --> 00:21:43,410
!عُد إلى هنا

370
00:21:43,410 --> 00:21:45,660
!أعد إليّ وشاحي

371
00:21:47,660 --> 00:21:48,720
!لقد اختفى؟

372
00:21:52,960 --> 00:21:55,640
.هذا مُطمئن! لقد استعدتُ وشاحي

373
00:21:55,990 --> 00:21:56,810
هاه؟

374
00:21:56,810 --> 00:21:58,790
!مهلًا، أين أنا؟

375
00:21:58,790 --> 00:22:00,300
!لقد انفصلت عن الجميع

376
00:22:04,980 --> 00:22:06,180
.للتأكّد

377
00:22:06,610 --> 00:22:08,950
هل هذا هو جبل القمر الأسود؟

378
00:22:11,850 --> 00:22:13,290
من هذا الشخص؟