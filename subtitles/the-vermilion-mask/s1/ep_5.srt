1
00:00:01,320 --> 00:00:03,500
!اللّعنة عليك أيّتها المرأة الورديّة

2
00:00:07,270 --> 00:00:10,370
هربوا بسرعة، أليس كذلك؟

3
00:00:10,650 --> 00:00:12,850
.سأقتل تلك المرأة الورديّة

4
00:00:13,120 --> 00:00:18,610
.سيعود أولئك الدّخلاء
.كلّ ما علينا هو الانتظار

5
00:00:19,320 --> 00:00:21,790
ما الّذي يجعلك واثقًا لهذه الدّرجة؟

6
00:00:21,790 --> 00:00:25,210
.كان أحد أولئك الدّخلاء فتى يُدعى بيرو

7
00:00:25,830 --> 00:00:32,300
إنّه يستعمل قناع الاختفاء للانتقال
.من مكان لمكان وتدمير أقنعة غاستون

8
00:00:32,610 --> 00:00:35,780
.يسعى خلف قناع تينا إذًا

9
00:00:35,780 --> 00:00:39,390
لن يكون التّعامل معه سهلاً
.إن جعل نفسه خفيًّا ثانية

10
00:00:39,390 --> 00:00:42,110
.أشكّ في أنّه سيستعمل نفس الطّريقة

11
00:00:42,110 --> 00:00:46,970
.قناع الاختفاء ليس ندًّا مناسبًا لقناع التّخاطر

12
00:00:46,970 --> 00:00:49,380
.سأقتل تلك المرأة الورديّة

13
00:00:50,190 --> 00:00:52,330
.يا لها من فتاة مريبة

14
00:00:52,330 --> 00:00:54,400
.لكنّها أداة مفيدة

15
00:00:54,400 --> 00:00:56,830
.اخرس، اخرس

16
00:02:36,510 --> 00:02:40,010
"الحلقة 5: قناع التّخاطر"

17
00:02:46,070 --> 00:02:48,770
.أتت المافيا إلى نُزلنا أيضًا

18
00:02:49,060 --> 00:02:51,700
أرأيت؟ ألست سعيدًا لأنّنا انتقلنا؟

19
00:02:51,700 --> 00:02:54,180
!لماذا أتيتم إلى منزلي أنا إذًا؟

20
00:02:54,180 --> 00:02:55,940
.إنّها بيتزا –
\h\h\h\h\h!مهلاً –

21
00:02:55,940 --> 00:02:57,400
!أجل

22
00:02:57,400 --> 00:02:58,980
!تبدو لذيذة جدًّا

23
00:02:59,260 --> 00:03:02,110
…عـ-عشائي

24
00:03:02,950 --> 00:03:05,650
.حسنًا، هناك الكثير منهم

25
00:03:05,650 --> 00:03:07,330
هل يمكننا إخراج تينا من هناك؟

26
00:03:07,720 --> 00:03:10,030
،بإمكاننا تولّي أمر رجال مارلون

27
00:03:10,620 --> 00:03:13,910
لكنّ ذلك المهرّج والمرأة المقنّعة
.أمرهما مختلف

28
00:03:14,250 --> 00:03:16,390
.علينا إبعادهما عن تينا

29
00:03:17,660 --> 00:03:19,090
كيف نقوم بذلك؟

30
00:03:19,350 --> 00:03:20,940
.سنستعمل هذا القناع

31
00:03:24,610 --> 00:03:27,070
!تحوّلتَ إلى رجل عجوز يا بيرو

32
00:03:27,470 --> 00:03:29,640
.إنّه قناع التّنكّر

33
00:03:29,640 --> 00:03:34,190
يسمح لمُرتديه أو ما يلمسه
.بالتّنكّر بمظاهر جديدة

34
00:03:34,190 --> 00:03:36,960
يمكنك صنع أشياء كهذه أيضًا؟

35
00:03:37,790 --> 00:03:39,020
ماذا؟

36
00:03:39,020 --> 00:03:41,190
.إنّ لمس التّنكّر يُبطله

37
00:03:41,190 --> 00:03:43,420
.يا لها من نقطة ضعف كبيرة

38
00:03:43,800 --> 00:03:46,940
لكن في المقابل، يمكن ارتداء
.هذا القناع لفترات طويلة

39
00:03:47,240 --> 00:03:50,240
.قال ذلك المهرّج أنّه يجمع الأقنعة

40
00:03:50,240 --> 00:03:54,380
قد يساوره الشّكّ تجاه صانعِ
.أقنعةٍ زائر، لكنّه لن يتجاهله

41
00:03:54,380 --> 00:03:58,330
إذًا، تخطّط للفت انتباهه بالتّنكّر
في هيئة صانع أقنعة؟

42
00:03:58,330 --> 00:04:02,450
نعم. وسيكون عليك إخراج تينا من
.هناك بينما هو مشغول يا موك

43
00:04:02,450 --> 00:04:04,170
ماذا؟ أنا؟

44
00:04:04,170 --> 00:04:07,550
.سأقدّمك لمُزيل أقنعة
.هذا أقلّ ما يمكنك فعله من أجلي

45
00:04:07,550 --> 00:04:08,630
.لا أريد

46
00:04:08,630 --> 00:04:10,680
.أقسم أنّي سأكافئكم

47
00:04:11,010 --> 00:04:14,040
.حسنًا، هذا يغيّر كلّ شيء
.أريد أجرًا مقدّمًا

48
00:04:14,040 --> 00:04:16,260
!ليس عليك دفع أيّ شيء لنا يا سيّدة مورينو

49
00:04:16,260 --> 00:04:17,220
!بل عليها

50
00:04:17,220 --> 00:04:18,120
!ليس عليها

51
00:04:18,120 --> 00:04:18,810
!بل عليها

52
00:04:18,810 --> 00:04:19,600
!ليس عليها

53
00:04:19,600 --> 00:04:21,720
!لم أكمل كلامي بعد

54
00:04:21,720 --> 00:04:23,350
…ولكنّ موك

55
00:04:21,720 --> 00:04:23,350
…ولكنّ سونا

56
00:04:24,980 --> 00:04:26,680
.أنا آسفة

57
00:04:26,680 --> 00:04:29,860
.إنّكم تذكّرونني بالماضي

58
00:04:30,640 --> 00:04:33,620
.كانت تستمتع كثيرًا مع أصدقائها

59
00:04:34,430 --> 00:04:37,910
هل ستصير تينا صديقتكم أيضًا؟

60
00:04:38,200 --> 00:04:42,330
بالطّبع. لم يكن لديّ
.أصدقاء فتيات منذ مدّة

61
00:04:42,330 --> 00:04:44,210
.يا لك من مسكينة

62
00:04:44,830 --> 00:04:47,280
ماذا تقصد بذلك؟

63
00:04:46,570 --> 00:04:48,190
أصدقاء؟

64
00:04:47,280 --> 00:04:48,570
.أقصد ما قلتُ للتّوّ

65
00:04:48,570 --> 00:04:49,620
!ماذا؟

66
00:04:56,980 --> 00:04:58,390
ما الأمر؟

67
00:04:59,230 --> 00:05:01,900
.ابقي في فراشك واستريحي

68
00:05:03,430 --> 00:05:04,870
.حسنًا

69
00:05:12,880 --> 00:05:15,280
هل تؤلمك ذراعه؟

70
00:05:15,630 --> 00:05:17,300
.أشعر بالأسف عليك

71
00:05:17,300 --> 00:05:18,740
.ليس تمامًا

72
00:05:18,740 --> 00:05:23,390
.ليس عليك إخفاء الأمر
.أقصد عن سونا، وليس عنّي

73
00:05:24,700 --> 00:05:28,690
ظننتُ أنّ علاقتكما وثيقة لدرجة أنّكما
.لا تخفيان سوء حالكما عن بعضكما

74
00:05:29,170 --> 00:05:33,920
.طلبتَ منّا الانتقال من مكاننا يا موك
.يبدو أنّه لديك خبرة بهذا

75
00:05:33,920 --> 00:05:35,940
ما الحياة الّتي كنتَ تعيشها من قبل؟

76
00:05:40,210 --> 00:05:44,900
.أنا مجرّد نادل عاديّ فحسب
.ليس لديّ أيّ ماضٍ مثقل بالأعباء

77
00:05:45,410 --> 00:05:49,620
يبدو أنّ ماضيك كان أكثر تعقيدًا
.وإثارة من ماضيّ بكثير

78
00:05:51,870 --> 00:05:54,820
سمعتَ بالأمر، صحيح؟

79
00:05:56,360 --> 00:06:01,800
سمعتَ كيف تمّ قتل غاستون
.وتلاميذه واحدًا تلو الآخر

80
00:06:02,790 --> 00:06:05,340
.نعم، سمعتُ تلك الإشاعة

81
00:06:05,930 --> 00:06:07,140
.أنا الفاعل

82
00:06:07,140 --> 00:06:08,130
!أأنت جادّ؟

83
00:06:08,500 --> 00:06:10,140
كنتَ تعرف، صحيح؟

84
00:06:12,480 --> 00:06:13,680
هل كان الأمر واضحًا؟

85
00:06:14,340 --> 00:06:18,320
.أحيانًا، أرخي دفاعاتي أثناء ترحالي

86
00:06:18,570 --> 00:06:21,980
كلّما فعلت ذلك، يبدأ الجميع
بتوجيه أصابع الاتّهام إليّ

87
00:06:22,690 --> 00:06:25,160
.ويذكّرونني بألاّ أنسى جريمتي

88
00:06:26,710 --> 00:06:28,060
.إنّهم يكرهونني

89
00:06:28,560 --> 00:06:30,230
.غبيّ

90
00:06:31,060 --> 00:06:33,700
.الموتى لا يكرهون أحدًا

91
00:06:34,170 --> 00:06:36,800
.لا يمكنك مسامحة نفسك فحسب

92
00:06:37,620 --> 00:06:40,060
.سأبدأ بمسامحتك نيابة عنهم

93
00:06:40,540 --> 00:06:42,420
.والآن، كن فتًى مطيعًا واذهب إلى النّوم

94
00:06:42,810 --> 00:06:47,220
لكن أحيانًا، حتّى لو كنت تعلم
.أنّ ذلك صحيح، تعجز عن تقبّله

95
00:06:51,940 --> 00:06:54,930
.يودّ هذا الرّجل تقييم القناع

96
00:06:55,340 --> 00:06:59,080
.سمعت أنّ لديكم هنا تحفة فنّيّة رائعة

97
00:07:01,140 --> 00:07:03,450
.من هنا لو سحمت

98
00:07:09,030 --> 00:07:10,480
مـ-من أنتما؟

99
00:07:10,480 --> 00:07:12,040
أنت تينا، صحيح؟

100
00:07:12,040 --> 00:07:15,350
.تستغلّك المافيا بسبب قناع التّخاطر خاصّتك

101
00:07:15,350 --> 00:07:16,710
من تكونان؟

102
00:07:17,300 --> 00:07:19,500
.ليس لدينا وقت لكسب ثقتك

103
00:07:19,500 --> 00:07:20,780
.لنغادر المكان

104
00:07:27,000 --> 00:07:30,210
إلى أين تحاولان أخذ تلك الفتاة؟

105
00:07:30,530 --> 00:07:33,120
.كلاّ. كُشف أمرنا

106
00:07:34,580 --> 00:07:39,060
ماذا؟ أين وضعتُ مفتاح حقيبتي؟

107
00:07:40,980 --> 00:07:45,280
يبدو أنّك لستَ صانع أقنعة
.بارع فحسب، بل وممثّل أيضًا

108
00:07:46,050 --> 00:07:52,340
أساير محاولتك لكسب الوقت
.لأنّني أردت التّحدّث إليك

109
00:07:53,570 --> 00:07:59,410
قناع إله الحرب الّذي يخصّ السّيّد
غاستون في تلك الحقيبة، صحيح؟

110
00:08:01,370 --> 00:08:05,830
لنتكاتف ونستخدم قوى الأقنعة
.لتغيير هذا العالم الصّغير التّافه

111
00:08:10,330 --> 00:08:12,650
—يا آنسة، علينا منح الأولويّة لـ

112
00:08:12,650 --> 00:08:14,230
!أيّتها المرأة الورديّة

113
00:08:14,600 --> 00:08:17,340
.عليك الإصغاء لي وأنا أتكلّم

114
00:08:17,340 --> 00:08:19,020
!انطلقوا أيّها الفتية

115
00:08:28,480 --> 00:08:30,010
!سونا، اهربي

116
00:08:31,480 --> 00:08:32,450
!سونا

117
00:08:36,020 --> 00:08:37,500
.أمزح فحسب

118
00:08:41,450 --> 00:08:44,760
!مزيّفة ورديّة؟

119
00:08:45,160 --> 00:08:47,670
.أشكرك على حماستك الشّديدة للقتال

120
00:08:53,850 --> 00:08:56,350
.لن أنضمّ إليكم

121
00:08:58,630 --> 00:09:00,060
ما هذا؟

122
00:09:01,520 --> 00:09:03,430
!هـ-هل غاص في الأرض؟

123
00:09:03,430 --> 00:09:04,650
!قناع الخُلد

124
00:09:06,570 --> 00:09:08,390
!مـ-مهلاً

125
00:09:14,030 --> 00:09:17,530
!ما هذا؟ ساعديني يا أمّي

126
00:09:19,010 --> 00:09:20,350
.كان ذلك مخيفًا

127
00:09:20,350 --> 00:09:22,100
.أحسنتِ يا سونا

128
00:09:23,500 --> 00:09:26,930
.عرفتُ أنّه سيتمكّن من استشعار قناع إله الحرب

129
00:09:26,930 --> 00:09:30,510
وبسبب ذلك، لم يشكّ في أنّني
.العجوز، ممّا أتاح لي فرصة مباغتته

130
00:09:30,770 --> 00:09:33,350
.جيّد. لنلتقِ بموك

131
00:09:38,480 --> 00:09:40,390
كيف عدت؟

132
00:09:40,390 --> 00:09:44,340
.لديّ عدّة خدع في جعبتي بالطّبع

133
00:09:45,020 --> 00:09:47,480
.خدع لا يمكنني الإفصاح عنها لك

134
00:09:48,040 --> 00:09:50,010
.قناع الجنود

135
00:09:53,370 --> 00:09:55,650
بإمكانه تحويل البطاقات إلى جنود؟

136
00:09:55,650 --> 00:09:57,100
!قناع العنكبوت

137
00:09:59,330 --> 00:10:01,840
!سونا، اذهبي إلى موك في الحال

138
00:10:01,840 --> 00:10:02,660
!حاضرة

139
00:10:04,520 --> 00:10:05,950
.اتبعاها

140
00:10:11,090 --> 00:10:13,380
!سأوقفك ها هنا

141
00:10:20,450 --> 00:10:23,790
.كلاّ. تلك القدرة مزعجة جدًّا

142
00:10:23,790 --> 00:10:25,140
.اتركني واهرب

143
00:10:25,410 --> 00:10:28,140
.لم أطلب أن يتمّ أخذي من هنا

144
00:10:28,140 --> 00:10:31,910
.لا يمكنني ذلك. أمّك بانتظارك

145
00:10:35,270 --> 00:10:37,240
!سُحقًا

146
00:10:37,530 --> 00:10:38,770
.سمعتُ أصواتًا

147
00:10:39,220 --> 00:10:40,670
!لنهرب

148
00:10:44,660 --> 00:10:47,040
"قناع الخلد"

149
00:10:47,040 --> 00:10:48,200
"القناع الزّنجفريّ"

150
00:10:49,660 --> 00:10:52,040
"قناع الجنود"

151
00:10:52,040 --> 00:10:53,590
ما الّذي يحدث؟

152
00:10:53,590 --> 00:10:54,550
أهذا معقول؟

153
00:10:54,550 --> 00:10:56,440
.يا لهم من ضيوف مزعجين

154
00:10:56,440 --> 00:10:58,260
كلاّ! هل زلّ لساني بذلك؟

155
00:10:58,260 --> 00:11:00,570
.ماذا يحدث؟ هذا مريب جدًّا

156
00:11:00,570 --> 00:11:01,830
.فهمت

157
00:11:02,230 --> 00:11:04,470
ليس شعورًا لطيفًا، أليس كذلك؟

158
00:11:07,430 --> 00:11:11,400
يصغر نطاق قوّتها عندما تهدأ، صحيح؟

159
00:11:11,400 --> 00:11:13,720
هل أنتظر في الدّرج حتّى تهدأ؟

160
00:11:13,720 --> 00:11:15,290
!سمعتُهما! إنّهما في الدّرج

161
00:11:15,290 --> 00:11:16,750
!التفّوا حولهما من الجانبين

162
00:11:15,920 --> 00:11:18,840
.صحيح. بإمكانهم سماعي

163
00:11:19,180 --> 00:11:20,940
!مهلاً، لا تهربي وحدك

164
00:11:22,250 --> 00:11:23,500
!انتبهي

165
00:11:25,610 --> 00:11:26,570
ماذا؟

166
00:11:26,960 --> 00:11:30,240
.مذهل، إنّ قدرتها تكشف أفكاري بالفعل

167
00:11:30,700 --> 00:11:32,410
.لا بدّ أنّ هذه هي تينا

168
00:11:33,530 --> 00:11:34,630
هل أنت بخير؟

169
00:11:34,990 --> 00:11:37,840
.أنا سونا. سررت بلقائك

170
00:11:37,840 --> 00:11:39,960
.أتمنّى أن نصير صديقتين

171
00:11:41,540 --> 00:11:43,140
!كان ذلك محرجًا

172
00:11:44,330 --> 00:11:45,330
أين بيرو؟

173
00:11:45,330 --> 00:11:47,090
.إنّه يُماطِل ذلك المهرّج

174
00:11:47,090 --> 00:11:50,800
.لكنّه خطير جدًّا. أنا قلقة

175
00:11:50,800 --> 00:11:53,020
.علينا الذّهاب لمساعدته

176
00:11:53,020 --> 00:11:54,610
.أنت طيّب

177
00:11:54,610 --> 00:11:55,610
.اخرسي

178
00:11:57,630 --> 00:11:59,920
!أيّتها المرأة الورديّة

179
00:12:01,850 --> 00:12:02,890
!انبطحا

180
00:12:05,520 --> 00:12:06,660
!تينا

181
00:12:06,660 --> 00:12:09,130
!مهلاً، إلى أين تذهبين؟

182
00:12:11,050 --> 00:12:13,480
!لن أسمح لك بالوصول إلى تينا

183
00:12:13,480 --> 00:12:16,080
.بل عليّ ذلك لسوء حظّك

184
00:12:16,080 --> 00:12:20,260
.ما زالت لديّ خطط كثيرة لقناع التّخاطر

185
00:12:23,800 --> 00:12:25,960
.قناع البالونات

186
00:12:25,960 --> 00:12:27,540
قناع آخر؟

187
00:12:47,900 --> 00:12:50,880
ما-ما الّذي حدث هنا؟

188
00:12:51,820 --> 00:12:53,800
ما زلت تريد القتال؟

189
00:13:00,710 --> 00:13:01,920
!ما الّذي تفعله؟

190
00:13:02,550 --> 00:13:03,750
!النّجدة

191
00:13:03,750 --> 00:13:05,770
!لا-لا تفعل هذا

192
00:13:05,770 --> 00:13:07,130
أهذا معقول؟

193
00:13:07,130 --> 00:13:09,060
!قناع المَدافع

194
00:13:14,670 --> 00:13:16,400
!أليسوا رفاقك؟

195
00:13:16,710 --> 00:13:19,350
.قيمة الأقنعة أعلى من قيمة الأرواح

196
00:13:19,610 --> 00:13:23,310
.أنا من معجبيك

197
00:13:23,310 --> 00:13:24,550
ماذا؟

198
00:13:24,550 --> 00:13:28,590
قتلت الكثير من الأشخاص
بقناع إله الحرب، صحيح؟

199
00:13:28,590 --> 00:13:29,840
ماذا؟

200
00:13:38,210 --> 00:13:42,040
من كان يظنّ أن أحدًا قد يتقن استخدام
كلّ هذه الأقنعة إلى هذا الحدّ؟

201
00:13:47,630 --> 00:13:52,000
.معك حقّ. فعلتُ شيئًا لا يمكنني الرّجوع عنه

202
00:13:52,770 --> 00:13:57,590
لهذا السّبب لا أريد رؤية أيّ
.أحد آخر يتأذّى بهذه الأقنعة

203
00:13:57,930 --> 00:14:01,050
!لن أسمح بأن تصير ضحيّة لذلك القناع

204
00:14:02,360 --> 00:14:03,320
!قناع الخلد

205
00:14:41,220 --> 00:14:43,190
.أعلم تمامًا ما الّذي ترمي إليه

206
00:14:57,170 --> 00:14:59,890
.لا يمكن تغيير الماضي

207
00:15:05,580 --> 00:15:07,080
!من هنا بسرعة

208
00:15:07,080 --> 00:15:09,560
!أيّتها المرأة الورديّة، سأقتلك

209
00:15:15,020 --> 00:15:17,440
.كا-كان ذلك وشيكًا

210
00:15:17,440 --> 00:15:20,260
.كدتُ أُقتَل فقط لأنّي سكبتُ طِلاءً عليها

211
00:15:20,260 --> 00:15:22,210
!أجل، ستموتين

212
00:15:22,210 --> 00:15:23,810
!اذهبا فحسب

213
00:15:23,810 --> 00:15:24,810
!حسنًا

214
00:15:25,770 --> 00:15:27,150
!لن تهربي

215
00:15:32,820 --> 00:15:33,900
!ماذا؟

216
00:15:35,670 --> 00:15:38,750
.انظري. اختاري امرأتك الورديّة المفضّلة

217
00:15:43,760 --> 00:15:46,800
!نكاد نخرج! انتظرينا يا سيّدة مورينو

218
00:15:46,800 --> 00:15:48,120
!كلاّ

219
00:15:48,420 --> 00:15:50,720
!لا فائدة، لا فائدة من هذا

220
00:15:50,720 --> 00:15:52,850
!حتّى لو غادرت، لا مكان ألجأ إليه

221
00:15:52,850 --> 00:15:56,170
!هذا هو المكان الوحيد الّذي سيقبل بي

222
00:15:56,510 --> 00:15:59,190
.لا تكذبي على نفسك

223
00:16:02,230 --> 00:16:07,570
.تعلّمتُ مؤخّرًا أنّ العالم أكبر ممّا توقّعت

224
00:16:07,570 --> 00:16:08,740
ماذا؟

225
00:16:08,740 --> 00:16:13,220
.لا بدّ من وجود عالم يمكنه تقبّلك أيضًا

226
00:16:13,220 --> 00:16:15,530
.أريد أن أكون جزءًا من ذلك العالم

227
00:16:15,530 --> 00:16:16,910
.تكذبين

228
00:16:17,240 --> 00:16:20,410
.أكذب بأفكاري؟ سيكون ذلك غريبًا

229
00:16:22,070 --> 00:16:23,240
!تينا

230
00:16:26,380 --> 00:16:29,940
.أنت بخير. اشتقتُ لك كثيرًا

231
00:16:34,130 --> 00:16:35,380
!لا تقتربي

232
00:16:37,220 --> 00:16:39,430
.عودي يا تينا

233
00:16:39,820 --> 00:16:40,860
!مارلون

234
00:16:40,860 --> 00:16:45,760
ألم تتمنّى تلك المرأة لو أنّك غير موجودة؟

235
00:16:46,040 --> 00:16:47,220
!يـ-يكفي

236
00:16:47,220 --> 00:16:50,710
.حتّى والدتك تتصرّف بقسوة تجاهك

237
00:16:50,710 --> 00:16:55,600
.لكنّنا مختلفون. عودي معنا

238
00:16:55,600 --> 00:16:59,060
.لا يمكنك أن تعيشي حياة طبيعيّة

239
00:17:00,520 --> 00:17:02,560
!يا له من قناع مزعج

240
00:17:06,190 --> 00:17:07,480
!اتركني

241
00:17:07,880 --> 00:17:09,380
!لا تقتربي منها

242
00:17:09,380 --> 00:17:10,920
.تولّ أمرها

243
00:17:14,750 --> 00:17:16,470
!كفاك مقاومة

244
00:17:16,470 --> 00:17:18,170
!ابتعدي عن طريقي

245
00:17:19,080 --> 00:17:21,070
!ا-اهربي

246
00:17:21,070 --> 00:17:22,890
!اهربي، بسرعة

247
00:17:23,630 --> 00:17:25,060
!أمّي

248
00:17:26,400 --> 00:17:31,160
،إذا انتزعتُ منها أغلى شخص لديها
،فستفقد آخر بصيص من الأمل

249
00:17:31,160 --> 00:17:34,610
وستؤمن حقًّا بأنّ القناع هو المكان
.الوحيد الّذي تنتمي إليه

250
00:17:41,850 --> 00:17:42,940
!سيّد بيرو

251
00:17:42,940 --> 00:17:43,820
!بيرو

252
00:17:43,820 --> 00:17:45,180
.هذا مؤلم

253
00:17:45,540 --> 00:17:46,930
.هذا مؤلم

254
00:17:47,730 --> 00:17:49,200
!هذا مؤلم

255
00:17:49,440 --> 00:17:50,660
!هذا مؤلم

256
00:17:51,730 --> 00:17:55,790
.تينا، أنا أفهم ألمك

257
00:17:56,640 --> 00:17:59,190
.لكن إيّاك أن تنسي

258
00:17:59,670 --> 00:18:02,730
.اخترتِ ارتداء ذلك القناع

259
00:18:03,150 --> 00:18:05,880
.عليك تحمّل مسؤوليّة ذلك

260
00:18:06,630 --> 00:18:11,380
.عليك أن تؤمني بالغد وتواصلي التّقدّم للأمام

261
00:18:15,600 --> 00:18:19,890
أمّي، هل يمكنني حقًّا العودة
إلى المنزل معك؟

262
00:18:19,890 --> 00:18:21,350
.بالطّبع

263
00:18:20,610 --> 00:18:21,780
.أنا أحبّك

264
00:18:22,130 --> 00:18:23,250
.أنا أحبّك

265
00:18:22,510 --> 00:18:25,290
.أنت أغلى ما أملك

266
00:18:26,000 --> 00:18:27,610
.لنعد إلى المنزل معًا

267
00:18:28,250 --> 00:18:30,870
.أنا أحبّك يا تينا

268
00:18:28,250 --> 00:18:30,870
.أنا أحبّك يا تينا

269
00:18:41,180 --> 00:18:43,160
.لن يفيدك قتلي بأيّ شيء

270
00:18:43,160 --> 00:18:46,970
،ما دمتِ تملكين ذلك القناع
!فسيتمّ استغلالك باستمرار

271
00:18:46,970 --> 00:18:48,260
أمعقول؟

272
00:18:55,690 --> 00:18:57,690
كـ-كيف أمكنك ذلك؟

273
00:18:56,650 --> 00:18:57,690
!تينا

274
00:19:00,160 --> 00:19:01,290
…تينا

275
00:19:01,990 --> 00:19:04,040
!اجمعوا ما يمكنكم منه

276
00:19:04,040 --> 00:19:05,320
!حاضر يا أمّي

277
00:19:05,320 --> 00:19:08,670
!تعال إلى هنا يا مهرّج
بإمكانك إصلاحه، صحيح؟

278
00:19:08,670 --> 00:19:11,620
.كُسر قناع شخص مقنّع

279
00:19:12,140 --> 00:19:13,250
!أيّها المهرّج

280
00:19:13,710 --> 00:19:17,680
.ما عاد لنا أيّ شأن هنا. لنذهب

281
00:19:17,680 --> 00:19:20,300
.دعني أقتل المرأة الورديّة على الأقلّ

282
00:19:21,820 --> 00:19:23,550
.من الأفضل أن تشتري لي كتابًا لاحقًا

283
00:19:28,340 --> 00:19:32,380
مهرّج، لاسغارل! أين ذهبتما؟

284
00:19:29,150 --> 00:19:31,670
هل نجحت الأمور؟

285
00:19:31,670 --> 00:19:34,580
!كم هذا مؤلم
هل أترك السّكّين في مكانه؟

286
00:19:34,580 --> 00:19:35,810
.لا أدري

287
00:19:48,140 --> 00:19:49,700
.لا تفعل

288
00:19:49,980 --> 00:19:51,910
.لكن قد أنتزع القناع

289
00:19:51,910 --> 00:19:53,780
،إن كان عالقًا بوجهك لشهور فقط

290
00:19:53,780 --> 00:19:57,300
فربّما يمكنك انتزاعه لو كنت
.محظوظًا، لكن ليس في حالتك

291
00:19:57,300 --> 00:20:00,050
حتّى مزيل أقنعة لن يستطيع
.فعل شيء إن تهوّرتَ هكذا

292
00:20:06,070 --> 00:20:07,640
.أنا مسرور لأنّك بخير

293
00:20:13,350 --> 00:20:15,730
عقد رئيس الشّرطة صفقات سرّيّة"
"مع عائلة ستريغا واختلس التّبرّعات

294
00:20:15,730 --> 00:20:18,860
"تواجه عائلة ستريغا مصيرًا محتومًا بالدّمار"

295
00:20:19,090 --> 00:20:22,270
.شكرًا لكم جميعًا على كلّ شيء

296
00:20:22,270 --> 00:20:24,370
.آسفة لأنّكما تأذّيتما لهذه الدّرجة

297
00:20:24,580 --> 00:20:27,200
.إنّها طبيبة سيّئة فحسب

298
00:20:27,200 --> 00:20:28,680
!ماذا؟

299
00:20:28,680 --> 00:20:30,570
.هيّا يا تينا. اشكريهم

300
00:20:30,870 --> 00:20:35,090
لا-لا أتذكّر كيف اعتدت
.أن أتحدّث مع أصدقائي

301
00:20:35,090 --> 00:20:39,260
.كوني صريحة فحسب. هذا ما أفضّله

302
00:20:40,520 --> 00:20:43,330
.شكرًا على إنقاذي

303
00:20:44,450 --> 00:20:48,170
هذا مؤلم. لماذا حدث كلّ هذا لي؟

304
00:20:48,170 --> 00:20:51,570
.إنّك طيّب بشكل مفاجئ يا موك

305
00:20:51,570 --> 00:20:55,330
.عرضَ عليّ أن يعرّفني بمزيل أقنعة لا غير

306
00:20:55,330 --> 00:20:56,400
ما الغاية من كلّ هذا؟

307
00:20:56,400 --> 00:21:00,170
.كان موك قلقًا عليك يا بيرو

308
00:21:00,170 --> 00:21:02,020
.لا تقولي ذلك

309
00:21:12,010 --> 00:21:13,460
ماذا؟

310
00:21:14,380 --> 00:21:15,690
.لا شيء

311
00:21:16,060 --> 00:21:19,910
.سونا، موك. شكرًا لكما

312
00:21:22,570 --> 00:21:24,380
.هناك شيء بين الصّفحات

313
00:21:27,850 --> 00:21:30,480
تركتَ شيئًا معهم، صحيح؟

314
00:21:30,480 --> 00:21:34,350
.ولادة جديدة، وغفران، وتصالح مع الماضي

315
00:21:34,930 --> 00:21:40,560
،إن كان ترسًا مهمًّا في عالمنا

316
00:21:40,560 --> 00:21:43,570
.فأنا واثق أنّنا سنشهد أمرًا مثيرًا للاهتمام

317
00:21:43,570 --> 00:21:46,070
"[قدرك ينتظرك في [أيريس"

318
00:23:20,900 --> 00:23:24,640
العبارة "أيريس" في رسالة المهرّج
هي اسم مدينة

319
00:23:24,640 --> 00:23:30,420
حيث عثر عليّ معلّمي وربّاني
.مع بقيّة التّلاميذ

320
00:23:31,170 --> 00:23:34,350
.إنّها أيضًا المكان الّذي ارتكبتُ فيه جريمتي

321
00:23:35,410 --> 00:23:40,520
بينما كان القطار يتمايل، تذكّرت
.تلميذًا أكبر يُدعى زينت

322
00:23:41,330 --> 00:23:45,830
:في الحلقة السّادسة القادمة
."ظلال زهرة ثلج"

323
00:23:46,210 --> 00:23:48,580
!وتبدأ رحلة الأقنعة

324
00:23:46,650 --> 00:23:49,990
"الحلقة 6: ظلال زهرة ثلج"