1
00:01:33,750 --> 00:01:36,540
...يوكي كاغورازاكا، رئيس الاتّحاد الحُرّ

2
00:01:37,330 --> 00:01:41,330
!إنّه تحت سيطرة ماريبيل بالكامل

3
00:01:41,770 --> 00:01:43,950
ماريبيل على حقّ

4
00:01:43,950 --> 00:01:46,540
التّحالف مع سيّد شياطين أمرٌ
لا يمكن تصوُّره

5
00:01:47,100 --> 00:01:49,200
لكن ماذا نفعل حينها؟

6
00:01:49,200 --> 00:01:53,530
تأثير ريمورو-سان على المُجتمع
البشريّ يزداد يوماً بعد يوم

7
00:01:54,490 --> 00:01:56,970
يوهان-ساما. لديّ تقرير طارئ

8
00:01:58,330 --> 00:02:00,470
تلقّيتُ للتوّ اتّصالاً سحريّاً

9
00:02:02,430 --> 00:02:06,140
!مُستحيل! تلك المُشاكسة الماكرة؟

10
00:02:06,630 --> 00:02:09,630
غليندا قد أُسِرَتْ بواسطة
سيّد الشّياطين ريمورو

11
00:02:09,630 --> 00:02:11,940
هل يمكنك التحرّي حول ذلك بـ"جشع"؟

12
00:02:13,100 --> 00:02:15,600
إذاً لهذا السّبب لا أستطيع التقاط مشاعرها

13
00:02:15,600 --> 00:02:16,570
ماذا؟

14
00:02:17,210 --> 00:02:21,370
غليندا قُتِلَتْ غالباً بواسطة
سيّد الشّياطين ريمورو

15
00:02:24,420 --> 00:02:29,250
يوكي، أليست لديك أي فُرصة للتّواصل
مع سيّد الشّياطين ريمورو؟

16
00:02:29,650 --> 00:02:31,100
مع ريمورو-سان؟

17
00:02:31,690 --> 00:02:33,280
...في الواقع

18
00:02:33,280 --> 00:02:35,800
أحد أتباعي، كاغالي، يُفترض أن تذهب معه

19
00:02:35,800 --> 00:02:39,110
للتّحقيق حول أطلال قديمة تُدعى أمريتا

20
00:02:40,110 --> 00:02:43,680
أمريتا... سمعتُ بها

21
00:02:44,440 --> 00:02:47,410
إنّها أطلالٌ قديمة كائنة تحت جيستاف

22
00:02:47,410 --> 00:02:52,400
كانت مدينة بُنيَتْ تيمُّناً بدولة
الشّعوذة العظيمة سوما

23
00:02:52,400 --> 00:02:57,650
وفقاً لكاغالي، لديها حتّى مفاعل
طاقة يتمّ التحكُّم به سحريّاً

24
00:02:57,650 --> 00:03:00,460
مفاعل طاقة يتمُّ التحكُّم به سحريّاً؟

25
00:03:00,460 --> 00:03:03,780
إنّه مفاعل طاقة كان يُستخدَم
لإدارة مدينة سوما

26
00:03:04,400 --> 00:03:07,640
إنّه ذروةٌ التّكنولوجيا السّحريّة في العالم القديم

27
00:03:07,640 --> 00:03:11,790
إذا خرجَ عن السّيطرة، فقد يُبيد
المنطقةَ المُحيطة بكاملها

28
00:03:15,620 --> 00:03:20,580
يوكي، قلتَ بأنّ سيّدَ الشّياطين ريمورو
يمكن هزيمته إذا كان لوحده، صحيح؟

29
00:03:20,580 --> 00:03:23,440
!تريدين استهدافه هناك؟

30
00:03:23,960 --> 00:03:25,710
ما كنتُ لأفعل ذلك

31
00:03:25,710 --> 00:03:28,800
سمعتُ بأنّ سيّدة الشّياطين ميليم
ستكون معه في التّحقيق

32
00:03:28,800 --> 00:03:31,640
!سيّدا شيطان؟! سيكون هذا جنوناً

33
00:03:32,160 --> 00:03:35,840
لا. سنشنّ هجومنا هناك بالضّبط

34
00:03:35,840 --> 00:03:38,440
سنقضي على سيّدة الشّياطين ميليم معه

35
00:03:38,440 --> 00:03:42,360
جنون! أين تتوقّعين أن تجدي
!شخصاً بهذه القوّة؟

36
00:03:45,990 --> 00:03:48,480
سنبذل كلّ طاقتنا في الأمر

37
00:03:48,480 --> 00:03:49,800
كلّها حرفيّاً

38
00:03:52,830 --> 00:03:55,480
تفهمان الوضع الّذي نحن فيه، أليس كذلك؟

39
00:03:56,010 --> 00:03:59,630
هذا يعني أنّ الآن هو وقت استخدامه

40
00:04:00,350 --> 00:04:05,090
الشّيء الّذي أحضرتَه من عرين التنّين يا يوكي

41
00:04:05,090 --> 00:04:07,090
!لحظة، هذه فكرة سيّئة

42
00:04:07,090 --> 00:04:09,060
!حتّى أنا لا أستطيع التحكُّم به

43
00:04:09,300 --> 00:04:10,750
لا يهمّ

44
00:04:11,280 --> 00:04:14,420
إنّه في الأساس ينتمي لسيّدة
الشّياطين ميليم على أيّ حال

45
00:04:14,420 --> 00:04:16,230
سنُعيده إليها فحسب

46
00:04:16,230 --> 00:04:19,440
لكن هفوة واحدة قد تؤدّي إلى ضرر
!للبشريّة جمعاء كذلك

47
00:04:19,440 --> 00:04:20,690
وإن يكن؟

48
00:04:22,850 --> 00:04:24,670
في الواقع، معكِ حقّ

49
00:04:24,670 --> 00:04:28,940
ستحاول سيّدة الشّيطان ميليم غالباً
مُواجهة ذلك بمُفردها

50
00:04:30,030 --> 00:04:32,870
قد يكون الشّيء المُناسب الّذي يُفرّق
سيّدَي الشّياطين عن بعضهما

51
00:04:33,400 --> 00:04:36,310
يسرّني أنّك سريع الفهم

52
00:04:36,310 --> 00:04:39,630
...وبينما تلعب سيّدة الشّياطين ميليم بذلك

53
00:04:40,200 --> 00:04:43,130
نتحكّم بريمورو-سان

54
00:04:45,930 --> 00:04:48,640
لكن هذا هو الشّيء الّذي يُقلقني

55
00:04:48,640 --> 00:04:50,660
تقصد تنّين العاصفة؟

56
00:04:50,660 --> 00:04:55,770
أجل. إذا فشلنا في التحكُّم بريمورو-سان
...وأُجبِرنا على قتله

57
00:04:56,520 --> 00:05:00,940
في أسوأ الحالات، تنّين الشّرّ
هذا قد يُبيد البشريّة

58
00:05:04,700 --> 00:05:07,670
لا حاجة للقلق بشأن ذلك

59
00:05:07,670 --> 00:05:13,270
يمكنك التّركيز على هزيمة سيّد
الشّياطين ريمورو ولا شيء آخر

60
00:05:16,450 --> 00:05:19,700
إن كان هذا ما تُريدينه، فسأثق بكِ

61
00:05:22,100 --> 00:05:23,840
يوكي تحت سيطرتها؟

62
00:05:23,840 --> 00:05:25,320
هل أنتِ متأكّدة؟

63
00:05:26,320 --> 00:05:27,340
أجل

64
00:05:28,300 --> 00:05:31,600
قالتها ماريبيل بنفسها، وأمامه مُباشرة

65
00:05:32,330 --> 00:05:37,640
أولئك الّذين يقعون تحت سيطرتها لا يُدركون
ذلك أبداً، مهما قيل لهم

66
00:05:38,220 --> 00:05:42,090
لا أعتقد بأنّ يوكي حظي بأي مهارات فريدة
،عندما عبرَ إلى هذا العالم

67
00:05:42,090 --> 00:05:44,800
لذا أعتقد بأنّه لم يستطع الدّفاع عن نفسه

68
00:05:44,800 --> 00:05:48,920
...لكن يعني هذا حينها أنّ يوكي بريء

69
00:05:48,920 --> 00:05:50,820
!هيّا يا سيّد الشّياطين العظيم! من فضلك

70
00:05:50,820 --> 00:05:52,420
!يمكنني إخبارك بمزيد من الأشياء

71
00:05:52,420 --> 00:05:54,120
!دعني أعمل لصالحك فحسب

72
00:05:57,790 --> 00:05:59,440
!أرجوك

73
00:06:02,370 --> 00:06:05,150
حسناً، مبدئيّاً، لنذهب ونأكل شيئاً ما

74
00:06:08,710 --> 00:06:09,970
...إذاً هذه

75
00:06:09,970 --> 00:06:14,350
أجل. إنّها قاعة الاستقبال الجديدة لتيمبيست

76
00:06:17,980 --> 00:06:21,110
يا لك من بناء مُبهر شيّدتَه

77
00:06:21,640 --> 00:06:25,530
هذا لأنّ تيمبيست قد ازدهرتْ أكثر
بعد مهرجاننا

78
00:06:25,530 --> 00:06:27,110
بذلنا كلَّ طاقتنا

79
00:06:28,910 --> 00:06:33,450
قرّرتُ استئجار غليندا كعضو في الخدمات
السّرّيّة التّابعة لسوي

80
00:06:33,850 --> 00:06:35,390
،سواء كانت طفلة مُشاكسة أو لا

81
00:06:35,390 --> 00:06:37,820
،إذا كانت تعمل تحت جناح سوي
فليس عليّ القلق

82
00:06:38,640 --> 00:06:39,350
أنت

83
00:06:41,060 --> 00:06:42,960
هل أنت من طلبَ بناء هذه؟

84
00:06:44,010 --> 00:06:45,710
...هـ-هذه

85
00:06:46,090 --> 00:06:50,380
ستدع المزيد من النّاس حتّى يعلمون
كم أنّ ريمورو-ساما عظيم

86
00:06:50,770 --> 00:06:51,610
هكذا إذاً

87
00:07:09,100 --> 00:07:10,990
!يا لها من حشود

88
00:07:12,070 --> 00:07:13,450
!رائحة زكيّة

89
00:07:13,920 --> 00:07:15,800
،حالما تُقرّرين ما تُريدين

90
00:07:15,800 --> 00:07:20,080
خذي العملة المُوازية إلى المنضدة
لتقديم طلبكِ

91
00:07:20,480 --> 00:07:24,590
،لدينا ثلاثة أطباق خاصّة يوميّة
بالإضافة إلى وجبة خاصّة

92
00:07:24,590 --> 00:07:26,800
ماذا؟ حقّاً؟

93
00:07:26,800 --> 00:07:29,590
كانوا دائماً ما يُقدّمون لي ذلك فوراً

94
00:07:30,080 --> 00:07:34,260
دائماً ما نُحضِّر الوجبة الخاصّة لك
يا ريمورو-ساما

95
00:07:34,800 --> 00:07:37,040
إنّها الأشهر في القائمة

96
00:07:37,040 --> 00:07:41,770
لا يمكن طلبها إلّا بإنفاق نقاط
استحقاق أو الاصطفاف باكراً

97
00:07:43,880 --> 00:07:47,470
حسناً إذاً، لِمَ لا تحصلين على الوجبة
الخاصّة لتخليد المُناسبة؟

98
00:07:47,470 --> 00:07:49,440
ماذا؟ أيمكنني ذلك؟

99
00:07:49,440 --> 00:07:51,820
اعتبريها خدمة لأوّل مرّة

100
00:07:51,820 --> 00:07:54,620
يمكنني تغطية تكاليف غليندا، صحيح؟

101
00:07:54,620 --> 00:07:55,450
بالتّأكيد

102
00:07:55,840 --> 00:07:57,740
...حسنٌ إن كان هذا ما تقوله

103
00:07:57,740 --> 00:08:00,000
سأطلب الوجبة الخاصّة إذاً أيضاً

104
00:08:00,000 --> 00:08:02,110
المعذرة، هيناتا-سان؟

105
00:08:04,460 --> 00:08:05,580
!لذيذ

106
00:08:11,220 --> 00:08:14,590
على أيّ حال، فكّرتَ مليّاً حقّاً
في نِظام النّقاط هذا

107
00:08:14,590 --> 00:08:17,380
في الواقع، نحن مُتخلِّفون عن ضبط
،نِظام الأجور قليلاً

108
00:08:17,380 --> 00:08:19,810
لذا لا يمكننا أن ندفع للنّاس بعد

109
00:08:20,080 --> 00:08:22,480
ماذا؟ كما في لوبيليوس

110
00:08:22,780 --> 00:08:26,100
حقّاً؟ بلد ذات تاريخ طويل؟

111
00:08:26,100 --> 00:08:28,690
إنّه أيضاً بلد يُشجّع المُساواة

112
00:08:28,950 --> 00:08:31,820
،يُدفَع للنّاس عموماً بالعينيّات
كما هنا تماماً

113
00:08:31,820 --> 00:08:33,650
حتّى أنتِ؟

114
00:08:34,000 --> 00:08:35,260
هذا صحيح

115
00:08:35,260 --> 00:08:36,570
،لكن نظراً لمركزي

116
00:08:36,570 --> 00:08:39,240
يمكنني التصرُّف بالميزانيّة
القوميّة إلى حدٍّ ما

117
00:08:39,240 --> 00:08:43,520
ماذا؟ لكن بدا وكأنّكِ كنتِ تُسرفين
كثيراً في المهرجان

118
00:08:43,520 --> 00:08:44,210
هل تختلسين؟

119
00:08:44,510 --> 00:08:45,970
بالطّبع لا

120
00:08:45,970 --> 00:08:49,210
كان ذلك مالي الّذي كسبتُه بإبادة الوحوش

121
00:08:51,070 --> 00:08:54,880
لحظة، إذاً طلبت منّي أن أدفع لكِ
!رغم أنّ لديكِ مالكِ الخاصّ؟

122
00:08:54,880 --> 00:08:57,050
لا تفتعل جلبة على أمر تافه

123
00:08:57,050 --> 00:08:59,070
"يُدعى هذا "ادّخار

124
00:09:01,200 --> 00:09:02,640
لم أقتنع

125
00:09:04,340 --> 00:09:07,730
...دائماً ما أفضّل المالَ على كلّ شيء

126
00:09:08,100 --> 00:09:10,550
لكن اليوم تغيّرتْ طريقةُ تفكيري

127
00:09:11,190 --> 00:09:13,900
!ابتداء من اليوم، سأعيش لأجل النّقاط

128
00:09:14,490 --> 00:09:17,520
حقاً؟ حسناً، بالتّوفيق

129
00:09:20,280 --> 00:09:24,160
حسناً. هل يمكنكِ إعطائي أي معلومات
أُخرى تمتلكينها الآن؟

130
00:09:25,840 --> 00:09:29,160
...أجل، حسناً... لنبدأ بالمجلس

131
00:09:29,160 --> 00:09:32,750
بعض كبار الشّخصيّات البارزة تُدعى
الشّيوخ الخمسة يتحكّمون به

132
00:09:33,390 --> 00:09:35,830
وقائدهم هو بالطّبع غرانفيلي

133
00:09:35,830 --> 00:09:40,760
والشّخص الّذي سبّبَ تخطيطه كلّ تلك
الفوضى كانت ماريبيل

134
00:09:41,320 --> 00:09:45,520
،إذاً حتّى المُعتدي الرّئيسيّ، غابان
كان يتمّ التحكُّم به؟

135
00:09:45,910 --> 00:09:48,230
إنّه أحد الشّيوخ الخمسة

136
00:09:48,230 --> 00:09:50,020
ويوهان أيضاً

137
00:09:50,320 --> 00:09:55,120
ماذأ؟ ألم يكن يوهان الرّجل المُتواضع
الّذي انتقدَ غابان؟

138
00:09:55,120 --> 00:09:59,110
أجل. بدا أنّهما برأيين مُختلفين

139
00:09:59,730 --> 00:10:03,910
الانقسام داخل الصّفوف هو بالضّبط
ما تريده ماريبيل

140
00:10:04,480 --> 00:10:08,080
،فلو استطاع غابان السّيطرة عليك
سيكون ذلك كافياً

141
00:10:08,080 --> 00:10:11,680
وإن فشِل، سيكسب يوهان ثِقتك

142
00:10:11,680 --> 00:10:13,670
ويحصل على موطئ قدم معك

143
00:10:14,830 --> 00:10:18,440
وبالنّسبة لهما، كانت معركة بقاء

144
00:10:18,440 --> 00:10:23,600
لكن بالنّسبة لماريبيل، ستُحقّق هدفها
مهما بقي من بيادق في اللّعبة

145
00:10:23,600 --> 00:10:26,490
ولن تكشف الفتاة الشّيطانيّة عن وجهها حتّى

146
00:10:26,490 --> 00:10:28,850
يُشعرني ذلك بحرق كلّ شيء

147
00:10:28,850 --> 00:10:31,360
!أتفهّم شعورك، لكن لا تفعل

148
00:10:31,980 --> 00:10:33,360
...وثمّة أمر آخر

149
00:10:33,760 --> 00:10:38,860
هناك مجموعة تُدعى الظلّ الأسود تُمارس
أعمال عائلة روتزو القذرة

150
00:10:39,780 --> 00:10:43,200
.سيترتّب عليكم توخّي الحذر
إنّهم في الظّلال في كلّ مكان

151
00:10:45,720 --> 00:10:48,370
وهذا كلّ شيء أعرفه

152
00:10:48,830 --> 00:10:49,980
...هكذا إذاً

153
00:10:50,540 --> 00:10:53,920
لكن بجدّيّة، لماذا يعتبرونني عدوّاً؟

154
00:10:53,920 --> 00:10:56,250
!أنا هُلام تافه غير مُضرّ

155
00:10:56,250 --> 00:10:59,610
ماذا؟

156
00:10:59,610 --> 00:11:00,180
!ماذا؟

157
00:11:00,540 --> 00:11:03,950
،يا رجل، عندما تسعى للقتال بهذا الشّكل

158
00:11:03,950 --> 00:11:05,840
أيّ شخص سيعتبرك عدوّاً

159
00:11:05,840 --> 00:11:06,390
!ماذا؟

160
00:11:06,390 --> 00:11:08,960
ظننتُك كنتَ تسعى لقتالٍ أيضاً

161
00:11:08,960 --> 00:11:09,640
!ماذا؟

162
00:11:09,640 --> 00:11:12,560
وذلك المجلس كان الخُطوة الأولى
لبناء ميدانك الاقتصاديّ

163
00:11:12,560 --> 00:11:13,360
!ماذا؟

164
00:11:13,360 --> 00:11:16,070
واعتقدتُ بأنّ جمعي للمعلومات
كان جزءاً من ذلك

165
00:11:16,070 --> 00:11:16,650
!ماذا؟

166
00:11:16,650 --> 00:11:19,150
فعلتَ كلّ ذلك حقّاً دون إدراك
لما بدا عليه ذلك؟

167
00:11:19,530 --> 00:11:22,980
فـ-في الواقع، لا أقول بأنّني
،لم تكن لديّ نيّة بذلك

168
00:11:22,980 --> 00:11:26,370
لكن ارتأيتُ بأنّ المُفاوضات السّلميّة
...ستكون كافية لبعض الوقت

169
00:11:26,370 --> 00:11:30,070
التّرحيب بالوافد الجديد الّذي
سيسلب سوقك المحلّيّ؟

170
00:11:30,070 --> 00:11:32,780
قلّما تجد من القادة أهداف سهلة هكذا

171
00:11:33,880 --> 00:11:35,350
...معها حقّ

172
00:11:36,780 --> 00:11:39,170
إ-إذاً سأبذل قصارى جهدي

173
00:11:39,170 --> 00:11:42,100
!لتولّي مسؤوليّة اقتصاد الدُّول الغربيّة بمُفردي

174
00:11:42,100 --> 00:11:42,760
!حسناً

175
00:11:43,520 --> 00:11:45,550
يبدو أنّهم مُستمتعون هناك

176
00:11:46,090 --> 00:11:50,390
على أيّ حال، حصلتُ على الصّورة الإجماليّة
للعدوّ من معلومات غليندا

177
00:11:50,780 --> 00:11:54,640
سوي، تحرَّ حول عائلة روتزو والشّيوخ الخمسة

178
00:11:54,640 --> 00:11:55,920
عُلِم

179
00:11:55,920 --> 00:11:58,400
ينبغي أن نحذر أيضاً ممّا قد يفعله يوكي

180
00:11:58,750 --> 00:11:59,840
أجل

181
00:11:59,840 --> 00:12:03,080
لعلّه يحاول استغلال النّقابة لنصب فخّ

182
00:12:03,080 --> 00:12:04,910
سنتجنّب التّفاعل معه حاليّاً

183
00:12:06,130 --> 00:12:07,910
ماذا عن التّحرّي حول تلك الأطلال؟

184
00:12:08,260 --> 00:12:09,100
ماذا؟

185
00:12:09,100 --> 00:12:11,000
هل نسيت ذلك؟

186
00:12:11,000 --> 00:12:14,420
كنتَ تتبجّح أمامي قائلاً بأنّك
سوف تتحرّى حول بعض الأطلال

187
00:12:14,420 --> 00:12:15,750
مع نائبة رئيس النّقابة

188
00:12:16,020 --> 00:12:18,720
!تذكّرت

189
00:12:19,180 --> 00:12:21,260
هل فات الأوان على رفضه؟

190
00:12:21,560 --> 00:12:24,750
الأطلال في ديستاف

191
00:12:25,290 --> 00:12:29,510
تِلك منطقة ميليم الآن، لذا دعيتُها أيضاً

192
00:12:29,510 --> 00:12:31,050
!التحرّي حول الأطلال؟

193
00:12:31,050 --> 00:12:33,020
!مُوافقة! أنا مُوافقة بشدّة

194
00:12:34,190 --> 00:12:36,770
!لا يمكنك حتماً رفض ذلك الآن

195
00:12:37,190 --> 00:12:38,810
لكن ألن يكون ذلك خطيراً؟

196
00:12:38,810 --> 00:12:42,280
هذا أشبه بدخولك إلى فخّ العدوّ

197
00:12:43,900 --> 00:12:44,950
اقتراح

198
00:12:44,950 --> 00:12:48,590
هناك خيار استغلال الفُرصة
لاستدراج العدوّ إليك

199
00:12:48,590 --> 00:12:49,450
!هذه هي

200
00:12:50,070 --> 00:12:52,860
!سنستخدم فخَّهم ضدّهم

201
00:12:52,860 --> 00:12:54,920
،سأذهب إلى هناك لاستدراج العدوّ

202
00:12:54,920 --> 00:12:57,210
!وسنكون جاهزين لمُقاتلتهم

203
00:12:57,620 --> 00:12:59,380
هل أنت متأكّد من أنّ ذلك سينجح؟

204
00:12:59,720 --> 00:13:03,590
سيكون لديّ ميليم، وأنوي أخذ
شيون كمُرافِقة لي أيضاً

205
00:13:03,590 --> 00:13:04,340
...و

206
00:13:05,000 --> 00:13:08,470
هناك شخص تجاوزَ تدريب ميليم
!وأصبح أقوى بكثير

207
00:13:09,880 --> 00:13:13,430
تعال معنا يا غوبتا-كن

208
00:13:13,430 --> 00:13:17,480
مُستحيل! لا أريد الذّهاب إلى حيث
!يوجد فِخاخ وأعداء

209
00:13:17,920 --> 00:13:20,420
يمكنك الاعتماد عليّ في حِراسة المدينة

210
00:13:20,420 --> 00:13:22,540
وسأُعزّز قوّةَ الحاجز

211
00:13:22,540 --> 00:13:24,860
وأنا سأستمرّ في مُراقبة الدُّول المُجاورة لنا

212
00:13:26,510 --> 00:13:30,580
مثل هذه القرارات الهامّة تُتّخَذ
بسهولة في تيمبيست

213
00:13:30,580 --> 00:13:33,100
من الأفضل أن تعتادي على ذلك
إذا نويتِ البقاء هنا

214
00:13:33,830 --> 00:13:35,290
!أنا جاهزة

215
00:13:37,160 --> 00:13:39,420
حسناً إذاً، سأذهب

216
00:13:39,420 --> 00:13:41,710
!حسناً! بلّغي تحياتي إلى لوميناس

217
00:13:44,210 --> 00:13:46,900
تكون مُستهتراً أحياناً

218
00:13:46,900 --> 00:13:49,850
كُن حذراً. إلى اللّقاء

219
00:13:50,980 --> 00:13:52,890
!لا تتدخّلي في شؤون غيركِ

220
00:13:53,320 --> 00:13:55,920
بئس الأمر. يا لها من تسونديري

221
00:13:55,920 --> 00:13:57,850
غير صحيح. إنّها ليست كذلك

222
00:13:59,020 --> 00:14:01,960
على أيّ حال، رسمنا خطّتنا

223
00:14:01,960 --> 00:14:04,320
والآن يترتّب علينا الاستعداد
!لليوم الكبير فحسب

224
00:14:13,120 --> 00:14:15,060
!جميل

225
00:14:16,320 --> 00:14:17,370
إنّه مفتوح

226
00:14:18,790 --> 00:14:20,880
هل أردت مُقابلتي يا ريمورو-ساما؟

227
00:14:21,330 --> 00:14:22,590
أجل

228
00:14:23,040 --> 00:14:24,460
تفضّلي

229
00:14:24,780 --> 00:14:27,840
اشتريتُه لكِ في إنغراشيا ما بين
اجتماعات المجلس

230
00:14:28,960 --> 00:14:32,300
!أنا سعيدةٌ للغاية! سأُعلّقها وأُقدّرها للأبد

231
00:14:32,560 --> 00:14:35,380
في الواقع، حبّذا لو تفتحينها

232
00:14:35,380 --> 00:14:36,320
!حسناً

233
00:14:40,450 --> 00:14:42,200
هل يمكنني تجربتها؟

234
00:14:42,200 --> 00:14:43,730
أجل، بالطّبع

235
00:14:51,610 --> 00:14:54,330
ريمورو-ساما، ما رأيك؟

236
00:14:54,630 --> 00:14:56,830
!يليق بكِ كثيراً

237
00:14:57,200 --> 00:14:58,820
!شكراً جزيلاً لك

238
00:15:01,760 --> 00:15:05,090
بعد ذلك، عرّفتُ غليندا على الجميع

239
00:15:05,520 --> 00:15:07,800
،ستكون تحت المُراقبة لبعض الوقت

240
00:15:07,800 --> 00:15:10,240
لكن آمل أن تكسب ثِقتهم

241
00:15:10,970 --> 00:15:12,890
،في الأيّام الّتي تسبق التحرّيات

242
00:15:13,280 --> 00:15:16,060
طلبتُ من دورد صنع بعض المُسدّسات لنا

243
00:15:16,060 --> 00:15:18,350
،وراجعتُ خطّتنا مراراً

244
00:15:18,810 --> 00:15:21,100
وجهّزتُ ملابسَ مُستكشفين لأنفسنا

245
00:15:21,100 --> 00:15:23,270
مضى الوقتُ بسرعة حقّاً

246
00:15:32,800 --> 00:15:34,870
أعتقد بأنّنا جاهزون تماماً

247
00:15:34,870 --> 00:15:35,970
!أجل

248
00:15:35,970 --> 00:15:38,620
!إذا كنّا سنفعل هذا، فلنستمتع أيضاً

249
00:15:38,620 --> 00:15:42,880
أليس كذلك؟ لستُ متأكّداً بشأن
...الأكمام القصيرة والبنطال القصير، لكن

250
00:15:42,880 --> 00:15:44,570
!نبدو رائعين، لذا سأقبله

251
00:15:45,940 --> 00:15:47,600
!أعتذر على التأخُّر

252
00:15:47,600 --> 00:15:49,590
!لننطلق إلى الأطلال

253
00:15:49,590 --> 00:15:53,280
مرفوض! اذهبي وبدّلي ملابسكِ
!بملابس استكشاف الأطلال

254
00:15:53,280 --> 00:15:54,520
ماذا؟

255
00:15:55,840 --> 00:15:57,390
...حسناً

256
00:16:00,560 --> 00:16:02,060
...عجباً

257
00:16:02,560 --> 00:16:04,380
على أيّ حال يا غوبتا-كن

258
00:16:04,380 --> 00:16:06,310
أحضرته، صحيح؟

259
00:16:07,320 --> 00:16:08,820
!فعلتُ ذلك بالطّبع

260
00:16:12,480 --> 00:16:14,560
!إنّه رائعٌ للغاية

261
00:16:14,560 --> 00:16:18,010
!وذلك الصّوت عندما يُطلِق هو الأفضل

262
00:16:18,010 --> 00:16:20,320
كنتُ مُحقّاً في إعطائك إيّاه

263
00:16:20,320 --> 00:16:23,210
راودني شعور بأنّك ستفهم

264
00:16:25,400 --> 00:16:29,300
انصدمتُ عندما أراني النّموذج الأوّليّ
في غضون أيّام قليلة

265
00:16:29,720 --> 00:16:33,050
بصراحة، بما أنّنا نستطيع جميعنا
،استخدام سحر قويّ

266
00:16:33,050 --> 00:16:34,550
...فهو لا ضرورة له إطلاقاً

267
00:16:36,660 --> 00:16:38,970
لكن ليس هذا هو الجزء المُهمّ

268
00:16:38,970 --> 00:16:42,700
المُهمّ هو حجم الحلم، أليس كذلك؟

269
00:16:45,020 --> 00:16:46,790
بدّلتُه

270
00:16:46,790 --> 00:16:49,730
ماذا؟ ليس لديكِ زيّ مُستكشف؟

271
00:16:50,350 --> 00:16:54,050
قالت الأميرة شونا بأنّها لم تستطع
صنع واحد في الوقت

272
00:16:54,050 --> 00:16:55,510
أجل، بالتّأكيد

273
00:17:02,160 --> 00:17:05,270
سأخرج لمُقابلة سيّد الشّياطين
ريمورو عقب هذا

274
00:17:05,270 --> 00:17:07,940
سنشدّ الرّحال حالما تنتهي فقرة التّعريف

275
00:17:09,170 --> 00:17:11,360
،لا يمكنني التّواجد هناك

276
00:17:11,360 --> 00:17:14,010
لكن بلّغي تحيّاتي للجميع في الفريق

277
00:17:14,540 --> 00:17:16,300
عُلِم يا حضرة الرّئيس

278
00:17:16,970 --> 00:17:18,630
رغم ذلك، هل أنتِ متأكّدة من هذا؟

279
00:17:19,730 --> 00:17:23,120
يُفترض أن تتواجد سيّدة الشّياطين
ميليم هناك أيضاً

280
00:17:23,120 --> 00:17:25,850
إنّها هي من دمّرّتْ موطنكِ الأصليّ، صحيح؟

281
00:17:27,600 --> 00:17:29,120
سأكون بخير

282
00:17:29,120 --> 00:17:32,630
تجاوزتُ تلك الصّدمة عندما أصبحتُ سيّدة شياطين

283
00:17:32,630 --> 00:17:35,990
سأفعّل ميكانيكيّة الدّفاع الخاصّة
بأمريتا كما هو مُخطّط

284
00:17:36,390 --> 00:17:39,670
مُجرّد تشغيله لا ينبغي أن يُثير أي شكوك

285
00:17:40,340 --> 00:17:42,990
فهمت. أعتمد عليكِ إذاً

286
00:17:43,520 --> 00:17:47,890
هذه أيضاً فُرصتنا لاكتشاف قُدرات
سيّد الشّياطين ريمورو

287
00:17:47,890 --> 00:17:51,090
من طِباعك فحسب أن تحتسب لكلّ
هذا سلفاً يا حضرة الرّئيس

288
00:17:51,760 --> 00:17:54,190
أريد فعل ما يمكنني فعله فحسب

289
00:17:55,430 --> 00:17:58,260
إذ أنّ لديّ طموحات كبيرة

290
00:18:00,400 --> 00:18:02,510
...يوكي كاغورازاكا

291
00:18:03,810 --> 00:18:06,890
هل يمكننا الوثوق به؟

292
00:18:07,450 --> 00:18:10,180
ليس عليك القلق يا جدّي

293
00:18:11,250 --> 00:18:15,810
لا يمكن أن يفشل "الجشع" خاصّتي
مع رجل جشِع مثله

294
00:18:19,450 --> 00:18:22,660
سيّد الشّياطين ريمورو؟

295
00:18:25,020 --> 00:18:26,940
برحيل رجال دين الأيّام السّبعة

296
00:18:26,940 --> 00:18:30,630
،واكتساب القدّيسة هيناتا نفوذاً أكبر حتّى

297
00:18:30,630 --> 00:18:35,660
سيزداد نِظام سيّد الشّياطين ريمورو
قوّة أكثر فأكثر

298
00:18:36,350 --> 00:18:40,860
يجب أن نمنع ذلك بأيّ ثمن، صحيح؟

299
00:18:40,860 --> 00:18:42,930
هل يمكنكِ التحكُّم به؟

300
00:18:43,920 --> 00:18:45,370
سأفعل. سوف ترى

301
00:18:46,100 --> 00:18:48,690
عند الشّدائد، سأحرص على موته

302
00:18:50,880 --> 00:18:54,120
،حتّى لو هاجَ تنّينُ العاصفة بسبب ذلك

303
00:18:54,120 --> 00:18:56,690
سيّدة الشّياطين لوميناس لن تقف مكتوفة اليدين

304
00:18:57,360 --> 00:19:00,620
وستُحمى الدُّول الغربيّة

305
00:19:02,670 --> 00:19:04,870
افعلي ما تشائين

306
00:19:07,900 --> 00:19:10,780
سأذهب الآن يا جدّي

307
00:19:11,830 --> 00:19:14,460
اذهبي يا ماريبيل

308
00:19:15,350 --> 00:19:19,660
لأجل مُستقبل البشريّة

309
00:19:25,730 --> 00:19:27,520
كنتُ أنتظركم

310
00:19:27,840 --> 00:19:29,280
تسرّني رؤيتكِ من جديد

311
00:19:29,280 --> 00:19:31,870
نتطلّع قُدماً للعمل معكِ

312
00:19:31,870 --> 00:19:34,270
!مرحباً! أنا ميليم

313
00:19:35,720 --> 00:19:37,290
!سررتُ بلقائكِ

314
00:19:39,310 --> 00:19:43,160
السّرور كلّه لي يا ميليم-ساما

315
00:19:43,630 --> 00:19:46,300
حسناً إذاً، لنُتابع التقدُّم إلى السّاحة

316
00:19:49,230 --> 00:19:50,550
ما رأيكِ؟

317
00:19:50,550 --> 00:19:53,190
...لم ألحظ أي مُشكلة... لكن

318
00:19:53,720 --> 00:19:57,010
...إنّها... بعض الشّيء

319
00:20:06,110 --> 00:20:07,870
سأُعرّفكم

320
00:20:07,870 --> 00:20:10,060
هذا هو فريق التحرّيات الّذي سيُرافقنا

321
00:20:10,480 --> 00:20:14,670
إنّهم أكثر الموهوبين من بين جميع الّذين درّبتُهم

322
00:20:14,670 --> 00:20:16,520
تسرّني مُقابلتكم

323
00:20:18,000 --> 00:20:20,450
يسرّنا اللّقاء بكم أيضاً

324
00:20:21,640 --> 00:20:24,610
حسناً، الباقي يُنقَل إلى تلك العربة هناك

325
00:20:25,340 --> 00:20:27,510
هل هذا هو طريقنا إذاً؟

326
00:20:27,510 --> 00:20:28,370
أجل

327
00:20:29,040 --> 00:20:31,930
ريمورو-ساما، أين تريد وضع أغراضك؟

328
00:20:31,930 --> 00:20:33,370
يمكننا تحميلها معكم

329
00:20:33,770 --> 00:20:37,420
لم نُحضر الكثير، لذا نحن بخير

330
00:20:37,680 --> 00:20:38,380
ماذا؟

331
00:20:38,840 --> 00:20:41,320
لا بُدّ أنّكم تمزحون

332
00:20:41,320 --> 00:20:43,420
لا يمكنكم استكشاف أطلال بثياب خفيف

333
00:20:43,750 --> 00:20:46,030
!هل سمعتِ؟! إنّها تتحدّث عن كمّيكِ القصيرين

334
00:20:46,030 --> 00:20:47,350
!حـ-حقّاً؟

335
00:20:47,350 --> 00:20:49,050
!كان ينبغي أن ترتدي كمّاً طويلاً مثلي

336
00:20:49,050 --> 00:20:50,180
!نفس الشّيء

337
00:20:50,540 --> 00:20:54,690
!يبدو لي أنّكم تستخفّون بالاستكشاف

338
00:20:54,980 --> 00:20:57,250
سنكون بخير

339
00:20:57,250 --> 00:21:00,820
رغم مظهرنا، لدينا خبرة كبيرة في المُغامرة

340
00:21:01,140 --> 00:21:05,220
،إن كنتُما مُصرّين، فلا مانع لديّ

341
00:21:05,220 --> 00:21:08,620
،لكن إن وقعتُما في أيّ مُشكلة
فالجآ إليّ فوراً

342
00:21:08,620 --> 00:21:10,350
سأدلّكما إلى عربتكما

343
00:21:10,350 --> 00:21:11,700
لسنا بحاجة عربة أيضاً

344
00:21:33,150 --> 00:21:35,180
ادخلوا

345
00:21:35,620 --> 00:21:37,610
ستخرجون في ديستاف

346
00:21:48,240 --> 00:21:49,740
...هذا غير مُمكن

347
00:21:50,080 --> 00:21:52,420
كان هذا ليستغرق شهرين بالعربة

348
00:21:57,540 --> 00:22:00,440
...أسياد الشّياطين مُذهلون

349
00:22:08,980 --> 00:22:11,550
هل هم هنا للتّرحيب بنا؟

350
00:22:13,740 --> 00:22:15,860
،انتظرنا وصولكم

351
00:22:15,860 --> 00:22:18,190
،ريمورو-ساما، ميليم-ساما

352
00:22:18,190 --> 00:22:20,060
وأعضاء النّقابة

353
00:22:20,750 --> 00:22:23,000
أهلاً بكم في ديستاف

354
00:23:55,360 --> 00:23:57,860
"الحلقة القادمة، "التحرّي حول الأطلال