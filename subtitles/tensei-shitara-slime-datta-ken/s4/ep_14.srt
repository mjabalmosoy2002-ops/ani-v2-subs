1
00:00:02,190 --> 00:00:03,580
:عالم الشّياطين

2
00:00:03,580 --> 00:00:07,240
العالم الرّوحيّ الّذي تعيش فيه الكائنات
الرّوحيّة الّتي تُعرَف بالشّياطين

3
00:00:07,240 --> 00:00:12,040
ويُعرَف أيضاً بالعالم السُّفليّ أو حتّى الجحيم

4
00:00:12,390 --> 00:00:13,340
ماذا؟

5
00:00:14,360 --> 00:00:15,880
!مهلاً، مهلاً، مهلاً

6
00:00:15,880 --> 00:00:18,340
لم أرك في هذه الأرجاء من قبل

7
00:00:18,960 --> 00:00:20,280
أنت تعترض طريقي

8
00:00:20,880 --> 00:00:22,600
ماذا؟

9
00:00:26,820 --> 00:00:29,410
،الشّياطين، والّتي هي كائنات روحيّة

10
00:00:29,410 --> 00:00:32,640
تحيا مع الوقت حتّى لو دُمِّرَتْ أجسادها

11
00:00:33,140 --> 00:00:36,820
هذه ميزة خاصّة للكائنات الّتي
،لا تملك جسداً مادّياً

12
00:00:36,820 --> 00:00:38,650
وقيد في نفس الوقت

13
00:00:39,610 --> 00:00:44,690
لا تستطيع الشّياطين التجسُّد في العالم
المادّي دون مُضيف

14
00:00:45,610 --> 00:00:50,740
التجسُّد هو أسمى أُمنية وأكبر
لهفة لكلّ شيطان

15
00:00:52,910 --> 00:00:55,500
لم أرك منذ وقت طويل يا جون

16
00:00:57,000 --> 00:01:01,170
نوار... تجسّدت؟

17
00:01:02,940 --> 00:01:07,000
لديّ اسم الآن، وهو ديابلو

18
00:01:07,000 --> 00:01:11,390
إنّها هِبة مُقدّسة تلقّيتُها من مولايّ، ريمورو-ساما

19
00:01:11,690 --> 00:01:13,390
حصلت على اسم؟

20
00:01:13,710 --> 00:01:14,930
أجل

21
00:01:14,930 --> 00:01:20,650
وسأمنحكِ شرف العمل لصالح
ريمورو-ساما كذلك يا جون

22
00:01:30,590 --> 00:01:34,230
أجّل الكلام أثناء النّوم إلى ما بعد
!موتك يا نوار

23
00:03:06,270 --> 00:03:07,400
!خذ هذه

24
00:03:17,720 --> 00:03:20,740
أتجرؤ على التكلُّم باستخفاف معي
!بهذه الطّريقة؟

25
00:03:28,820 --> 00:03:33,760
يا لها من ردّة فعل حمقاء على تلقّي العرض
السّخيّ للعمل لحساب ريمورو-ساما

26
00:03:35,000 --> 00:03:36,270
!سوف أقتلك

27
00:03:44,770 --> 00:03:47,810
لا يمكنكِ هزيمتي بوضعي الحاليّ

28
00:03:49,410 --> 00:03:52,320
إذاً تقول بأنّ الشّخص الّذي سمّاك
يُدعى ريمورو؟

29
00:03:52,320 --> 00:03:54,830
...لا أتحمّل سماع اسمه من دون تشريف

30
00:03:54,830 --> 00:03:56,570
لكن يبدو أنّكِ بدأتِ تهتمّين الآن

31
00:03:57,030 --> 00:03:59,500
،ريمورو-ساما هو شخصٌ عظيم

32
00:03:59,500 --> 00:04:02,120
ليس روحيّاً، فقط، لكن بشكله الجسديّ كذلك

33
00:04:02,120 --> 00:04:05,000
،يتمتّع بشفافيّة إلَهيّة ببريقها

34
00:04:05,000 --> 00:04:07,270
...ناهيك عن روعته المُنعشة وظرافته واهتزازه

35
00:04:07,270 --> 00:04:09,880
شفافيّة؟ اهتزاز؟

36
00:04:09,880 --> 00:04:11,070
!أجل

37
00:04:12,650 --> 00:04:15,250
!لأنّه هُلام

38
00:04:14,240 --> 00:04:15,880
!اهتزاز، اهتزاز

39
00:04:15,880 --> 00:04:18,890
حقّاً؟ إذاً هذا الهُلام هو سيّد شياطين؟

40
00:04:19,360 --> 00:04:23,600
!جميل! سأهزمك أوّلاً ثمّ أهزمه

41
00:04:23,600 --> 00:04:25,640
أتعتقدين حقّاً بأنّ لديكِ فُرصة؟

42
00:04:44,960 --> 00:04:46,660
،إن أتيتِ معي

43
00:04:46,660 --> 00:04:48,960
فسأمنحك جسداً

44
00:04:49,660 --> 00:04:53,260
أنتِ وفيوليت وبلانك

45
00:04:53,260 --> 00:04:56,640
أنتن الثّلاثة كنتُن تُعرقلنَ تجسيد
بعضكن الآخر

46
00:04:56,640 --> 00:05:00,970
وتتصدّين لبعضكن الآخر لعشرات آلاف السّنين

47
00:05:01,280 --> 00:05:02,970
هذا غير منطقيّ

48
00:05:03,950 --> 00:05:05,850
تُرِدنَ بعض الحماس، أليس كذلك؟

49
00:05:23,890 --> 00:05:26,410
هل تعين مكانتكِ الآن؟

50
00:05:27,110 --> 00:05:29,180
سآتي إليكِ ثانية

51
00:05:29,180 --> 00:05:32,080
أتأمّل منكِ أن تكوني جاهزة حينها

52
00:05:32,530 --> 00:05:36,250
أقترح أن تُصحّحي سلوككِ الوقح هذا كذلك

53
00:05:39,030 --> 00:05:41,530
سيّد شياطين هُلام؟

54
00:05:43,130 --> 00:05:45,780
قد يكون اللّعب معه أكثر  تسلية
من اللّعب مع ليون

55
00:05:52,140 --> 00:05:53,410
خسرتِ حسبما أرى

56
00:05:53,410 --> 00:05:54,440
!لم أخسر

57
00:05:54,870 --> 00:05:56,320
هناك مرّة مُقبلة دوماً

58
00:05:56,320 --> 00:05:58,570
!أخبرتُك بأنّني لم أخسر

59
00:06:00,940 --> 00:06:05,130
يبدو أنّ الأوقات المُملّة قد ولّتْ

60
00:06:07,240 --> 00:06:09,910
...لكن بغضّ النّظر عن ذلك

61
00:06:09,910 --> 00:06:12,000
!سأردّ الاعتبار منه عندما يعود ثانية

62
00:06:16,510 --> 00:06:19,550
!تبّاً! ما مُشكلته بالضّبط؟

63
00:06:19,550 --> 00:06:22,730
!كان ذلك ليقتلني لو لم أكن شيطاناً

64
00:06:22,730 --> 00:06:25,390
!سأجده وأردّ الضّربة له

65
00:06:26,350 --> 00:06:27,810
!ها أنت ذا

66
00:06:31,430 --> 00:06:34,780
بئس الأمر. جون لا تتعلّم فحسب

67
00:06:35,400 --> 00:06:37,210
!انتظر أيُّها الوغد

68
00:06:37,210 --> 00:06:40,280
!ستدفع ثمنَ ما فعلتَه لي

69
00:06:49,200 --> 00:06:51,550
...والآن، سأتابع

70
00:06:55,940 --> 00:07:00,340
هل فكّرتُم فيما فعلتموه؟

71
00:07:00,670 --> 00:07:02,340
لم تُفكِّروا، صحيح؟

72
00:07:02,340 --> 00:07:04,090
لا، لم تُفكِّروا

73
00:07:04,490 --> 00:07:05,660
مولاتي

74
00:07:06,620 --> 00:07:08,940
...حسناً. في هذه الحالة

75
00:07:08,940 --> 00:07:10,590
سوف نبدأ

76
00:07:11,930 --> 00:07:14,120
أنا مشغولةٌ الآن

77
00:07:14,120 --> 00:07:17,370
هلّا ابتعدت عن طريقي يا نوار؟

78
00:07:17,370 --> 00:07:21,110
أخبرتُكِ أن تُناديني ديابلو يا فيوليت

79
00:07:25,570 --> 00:07:27,820
لا تبدو مشغولة بالنّسبة لي

80
00:07:28,150 --> 00:07:33,080
هؤلاء أفسدوا خطّتي للتجسُّد

81
00:07:33,080 --> 00:07:35,080
أنا أُعاقبهم

82
00:07:35,460 --> 00:07:39,000
أتقولين تجسُّد؟ هذا مثاليّ

83
00:07:39,000 --> 00:07:40,910
،إذا أتيتِ وعملتِ لصالح ريمورو-ساما

84
00:07:40,910 --> 00:07:42,550
فأُمنيتكِ ستتحقّق

85
00:07:44,000 --> 00:07:46,180
هل سبقَ وسمعت بعبارة "لا تتدخّل
في شؤون غيرك"؟

86
00:07:46,550 --> 00:07:49,330
لا يحقّ لكِ الرّفض

87
00:07:49,330 --> 00:07:53,180
أثبتُّ بالفعل بأنّكِ لا تستطيعين
هزيمتي في معركة، أليس كذلك؟

88
00:07:55,000 --> 00:07:55,980
!سوف أقتلكِ

89
00:07:55,980 --> 00:07:57,230
جون وبلانك

90
00:07:58,760 --> 00:08:01,400
سأطرح نفس العرض عليهما

91
00:08:01,400 --> 00:08:03,080
كلاهما فتاتان ذكيّتان

92
00:08:03,080 --> 00:08:07,290
رُبّما ستتجسّدان قبل أن تفعلي، صحيح؟

93
00:08:12,280 --> 00:08:15,930
هل هذا الكلام عن التجسُّد حقيقيّ؟

94
00:08:15,930 --> 00:08:20,290
أعرفه جيّداً، أشكّ في أنّه يمكن
...الوثوق به

95
00:08:20,850 --> 00:08:25,780
لكن أستطيع قتلهم جميعاً إذا لم أحصل
على جسد يروقني

96
00:08:28,260 --> 00:08:30,300
،كانتا سهلتين للغاية

97
00:08:30,300 --> 00:08:34,930
لكن الأخيرة، بلانك، قد لا تسير
الأمور معها بسلاسة

98
00:08:35,310 --> 00:08:39,220
!هذا مُؤلم... تبّاً له

99
00:08:39,220 --> 00:08:41,360
!ها هو ذا

100
00:08:41,360 --> 00:08:43,900
!هذه المرّة، سأُريه كم أنا مُخيف

101
00:08:49,880 --> 00:08:51,240
...رغم ذلك

102
00:08:53,330 --> 00:08:55,830
!هذا مُؤلم! هذا مُؤلم

103
00:08:55,830 --> 00:09:00,440
من المُؤكّد أنّها لن تكون حمقاء حتّى
لا ترى جاذبيّة ريمورو-ساما

104
00:09:06,710 --> 00:09:08,060
...هذا

105
00:09:09,970 --> 00:09:14,310
أخيراً، شخص قد يفهم

106
00:09:14,310 --> 00:09:17,320
خذني إلى حيث توجد بلانك

107
00:09:18,240 --> 00:09:20,640
...ا-الملك الأسود

108
00:09:20,640 --> 00:09:24,120
إذا رفضت، فسينتهي المطاف
مثل تلك الجثث

109
00:09:24,120 --> 00:09:28,780
،لكن إذا وافقتُ دون برَكة مولاتي
فسوف أُعاقَب

110
00:09:29,400 --> 00:09:32,780
أنا محتار

111
00:09:36,680 --> 00:09:39,330
تسرّني رؤيتك ثانية أيُّها الملك الأسود

112
00:09:39,330 --> 00:09:43,500
قالت مولاتنا بأنّها سوف تلتقي
بك كحالة استثنائيّة

113
00:09:46,970 --> 00:09:48,010
ماذا؟

114
00:09:48,520 --> 00:09:52,460
كنتِ تختبئين هنا إذاً يا بلانك

115
00:10:02,680 --> 00:10:05,440
أرى بأنّك تجسّدت يا نوار

116
00:10:05,750 --> 00:10:08,440
—أجل. أنا الآن

117
00:10:08,440 --> 00:10:11,450
ديابلو، صحيح؟

118
00:10:14,590 --> 00:10:16,950
هكذا إذاً. هذا سيُوفّر علينا الوقت

119
00:10:17,450 --> 00:10:23,170
أعمل الآن لصالح ريمورو-ساما، الّذي
،أصبح سيّد شياطين

120
00:10:23,170 --> 00:10:26,410
وأنا قويّ في مجالات عديدة

121
00:10:26,410 --> 00:10:29,450
أطرى عليّ كثيراً

122
00:10:29,980 --> 00:10:31,340
...ويا بلانك

123
00:10:31,790 --> 00:10:38,470
أتيتُ إلى هنا لأخبركِ ببهجة العمل
لصالح ريمورو-ساما كذلك

124
00:10:38,470 --> 00:10:41,140
يا للهول! سيُعكّر هذا مزاجها

125
00:10:41,140 --> 00:10:42,770
...ا-الملك الأسود

126
00:10:47,730 --> 00:10:50,070
اصمتا

127
00:11:06,000 --> 00:11:07,420
سوف ألتقي به

128
00:11:08,920 --> 00:11:13,550
قرّرتُ أن ألتقي به لمرّة واحدة

129
00:11:18,300 --> 00:11:20,330
...مؤلم

130
00:11:22,670 --> 00:11:23,890
!انتظر

131
00:11:25,170 --> 00:11:28,900
!أرجوك، دعني أعمل لصالحك
!سأفعل أيّ شيء

132
00:11:28,900 --> 00:11:29,980
!لذا أرجوك

133
00:11:32,990 --> 00:11:35,620
!من فضلك! أخبرني باسمك على الأقلّ

134
00:11:38,290 --> 00:11:39,580
حسنٌ إذاً

135
00:11:40,310 --> 00:11:42,220
اسمي هو ديابلو

136
00:11:42,910 --> 00:11:46,960
أنا أحد النّخبة الأربعة الّذين يخدمون بإخلاص
سيّد الشّياطين العظيم ريمورو-ساما

137
00:11:47,380 --> 00:11:51,710
سـ-سيّد الشّياطين... ريمورو؟

138
00:11:52,150 --> 00:11:53,530
ماذا؟

139
00:12:02,230 --> 00:12:04,070
...سيّد الشّياطين ريمورو

140
00:12:07,840 --> 00:12:11,950
أمين السّرّ الثّاني ديابلو قد عاد

141
00:12:11,950 --> 00:12:14,040
أهلاً بعودتك

142
00:12:14,040 --> 00:12:16,950
ليس وكأنّني قلق، لكن يسرّني أنّك بخير

143
00:12:18,890 --> 00:12:20,720
!أنا لا أستحقّ مديحاً كهذا

144
00:12:20,720 --> 00:12:23,330
!سأحفر كلماتك في روحي بحدِّ ذاتها

145
00:12:25,040 --> 00:12:27,180
حسناً، هل وجدتَ بعض الأصدقاء؟

146
00:12:27,180 --> 00:12:28,460
أجل

147
00:12:28,460 --> 00:12:31,620
أحضرتُ ثلاثة إلى هنا في الوقت الرّاهن

148
00:12:31,620 --> 00:12:37,970
ثلاثة ارتأيتُ بأنّهم قيّمون بما يكفي
لإجراء لقاء معك

149
00:12:43,940 --> 00:12:46,650
جميعهن نساء

150
00:12:46,650 --> 00:12:48,650
وحسناوات فوق ذلك

151
00:12:48,650 --> 00:12:51,240
وهُنّ معارف قديمة له؟

152
00:12:51,240 --> 00:12:53,660
...لكن لا يبدونّ بتلك القوّة

153
00:12:55,410 --> 00:12:56,660
غير صحيح

154
00:12:56,660 --> 00:13:00,630
،هؤلاء الثّلاثة من بين أعلى الشّياطين رتبة
شياطين رئيسيّون

155
00:13:00,630 --> 00:13:02,210
!شياطين رئيسيّون؟

156
00:13:02,590 --> 00:13:06,460
يبدو أنّهن يتحكّمن بشكل كامل بجُزئياتهن
السّحريّة للظّهور كبشر

157
00:13:07,320 --> 00:13:09,460
هذا هو السّبب إذاً

158
00:13:09,460 --> 00:13:10,690
أحم

159
00:13:10,690 --> 00:13:12,380
هذه تنكُّرات مُدهشة

160
00:13:12,380 --> 00:13:14,520
كأنّكن بشريّات عاديّات

161
00:13:14,520 --> 00:13:18,890
أنا واثق بأنّه حتّى فارس مُقدّس لن يتمكّن
من التّمييز بأنّكن شياطين رئيسيّة

162
00:13:20,430 --> 00:13:22,190
هل قلتُ كلاماً خاطئاً؟

163
00:13:23,360 --> 00:13:25,310
هذا هو ريمورو-ساما الّذي أعرفه

164
00:13:25,730 --> 00:13:28,820
والآن، اسمح لي أن أعرّف عنهن

165
00:13:32,760 --> 00:13:34,020
سررتُ بلقائك

166
00:13:34,020 --> 00:13:35,450
أنا سيّد الشّياطين ريمورو

167
00:13:35,450 --> 00:13:39,440
أنا مُندهشة من أنّك اكتشفتَ حقيقتنا
بنظرة واحدة

168
00:13:39,440 --> 00:13:40,450
...في هذه الحالة

169
00:13:46,990 --> 00:13:49,420
فهمت. هذا واعد

170
00:14:07,130 --> 00:14:09,880
!أنت مُدهش يا مولايّ

171
00:14:09,880 --> 00:14:14,650
سأحضر 200 عضو من جيشي لخدمتك

172
00:14:14,650 --> 00:14:16,810
!رائع! أتطلّع قُدماً لذلك

173
00:14:17,520 --> 00:14:20,240
...المعذرة. التّالية

174
00:14:20,240 --> 00:14:23,170
سررتُ بلقائك يا ريمورو-ساما

175
00:14:23,170 --> 00:14:29,130
اسمح لي من فضلك أنا والـ 200
من أتباعي بأن نعمل لصالحك

176
00:14:29,410 --> 00:14:32,420
كذلك أنا... يا مولايّ

177
00:14:32,420 --> 00:14:36,550
أودّ خدمتك مع 200 من أتباعي

178
00:14:36,550 --> 00:14:39,040
!بكلّ تأكيد! يسرّني انضمامكما

179
00:14:39,550 --> 00:14:41,420
،بالإضافة إلى هؤلاء الثّلاثة

180
00:14:41,420 --> 00:14:44,490
هناك شخص آخر وجدتُه مُثيراً للاهتمام

181
00:14:44,490 --> 00:14:47,090
،لديه أيضاً 100 تابع

182
00:14:47,090 --> 00:14:49,230
ليُصبح الإجمالي 700

183
00:14:49,230 --> 00:14:51,640
...كنتُ آمل إيجاد ألف كاملة

184
00:14:51,640 --> 00:14:54,040
!عجزي يُسبّب لي العار

185
00:14:54,040 --> 00:14:56,540
لا، هذا كافٍ

186
00:14:58,680 --> 00:15:01,240
أسمح لكم بالكشف عن أنفسكم

187
00:15:01,240 --> 00:15:02,490
!فلتظهروا

188
00:15:16,090 --> 00:15:17,590
!انتظر لحظة

189
00:15:17,590 --> 00:15:19,900
!هل جميعهم شياطين رئيسيّون أيضاً؟

190
00:15:20,340 --> 00:15:23,640
هؤلاء الستّة هم الخدَم الموثوقون
،للثّلاثة السّابقات

191
00:15:23,640 --> 00:15:26,220
والأشخاص الّذين أعتبرهم على الأقلّ واعدين

192
00:15:26,220 --> 00:15:27,680
...على ذكر الأمر

193
00:15:27,680 --> 00:15:30,930
اخترتُ هذا الشّيطان الأعلى في طريقي

194
00:15:30,930 --> 00:15:34,070
حسناً، لن أسأل عن سبب إبراحه ضرباً

195
00:15:34,070 --> 00:15:37,320
والآن، عرّفوا عن أنفسكم لريمورو-ساما

196
00:15:39,820 --> 00:15:44,830
اعتباراً من هذه اللّحظة، نحن خدم
مُخلصون لسيّد الشّياطين ريمورو-ساما

197
00:15:44,830 --> 00:15:46,700
ننتظر أوامرك

198
00:15:47,380 --> 00:15:49,540
إذاً لن نهدر الوقت

199
00:15:59,550 --> 00:16:01,940
مهلاً... ماذا الآن؟

200
00:16:01,940 --> 00:16:03,800
ماذا؟ ما الّذي يجري؟

201
00:16:04,410 --> 00:16:06,310
آسف لو تأخّرتُ عليكن

202
00:16:06,680 --> 00:16:09,850
هل تُردنَني أن أجري أي تغيير لمظهركن؟

203
00:16:09,850 --> 00:16:11,560
هل ستفعل ذلك شخصيّاً؟

204
00:16:11,820 --> 00:16:14,310
حسناً، أنتن حالات خاصّة

205
00:16:14,310 --> 00:16:15,510
...وأيضاً

206
00:16:16,630 --> 00:16:19,570
أُفكِّر في استخدام هذا كبُنية عظميّة لكُن

207
00:16:20,120 --> 00:16:21,040
...هذا

208
00:16:21,040 --> 00:16:22,400
!أوريكالكوم

209
00:16:23,770 --> 00:16:25,600
هذا جميل

210
00:16:30,880 --> 00:16:33,790
...إذاً... بخصوص هؤلاء الثّلاثة

211
00:16:33,790 --> 00:16:36,000
ألم يكُنّ حيّات لفترة طويلة جدّاً

212
00:16:36,000 --> 00:16:37,550
توقّعتُ هذا أيضاً

213
00:16:38,020 --> 00:16:39,860
إنّهن كذلك إذاً؟ توقّعتُ هذا

214
00:16:39,860 --> 00:16:44,430
كُلّ واحدة منهن لديهن خادمان من الشّياطين
الرّئيسيّة، بنفس رتبتهن

215
00:16:44,860 --> 00:16:45,860
هل هذا يعني

216
00:16:45,860 --> 00:16:49,850
لديهن شيء لا يمكن قياسه بواسطة
مُستويات الطّاقة وحدها؟

217
00:16:49,850 --> 00:16:50,830
إجابة

218
00:16:50,830 --> 00:16:54,690
رتبة الشّياطين بحدِّ ذاتها تعتمد
على مدّة بقائهم

219
00:16:55,150 --> 00:16:57,730
القُدماء، الّذين وُجِدوا لأكثر
،من 1000 عام

220
00:16:57,730 --> 00:16:59,660
ينتمون للفئة السّائدة

221
00:16:59,660 --> 00:17:03,450
يمتلكون سلطة عزل أنفسهم عن الآخرين

222
00:17:03,450 --> 00:17:05,090
أستنتج بأنّ الفرد المدعو ديابلو

223
00:17:05,090 --> 00:17:09,200
والثّلاثة الّذين أحضرهن هُنّ
من الفئة السّائدة

224
00:17:09,200 --> 00:17:10,690
هكذا إذاً

225
00:17:10,690 --> 00:17:15,080
لذا بعبارة أُخرى، الفتيات الثّلاثة
قويّات جدّاً مثل ديابلو

226
00:17:15,600 --> 00:17:18,900
على أيّ حال، بغضّ النّظر
،عن الفترة الّتي عشنَها

227
00:17:18,900 --> 00:17:22,840
أعتقد من الآمن القول بأنّ لدينا شياطين
مُدهشون جدّاً في صفّنا الآن

228
00:17:23,170 --> 00:17:27,020
،ما يهمّ الآن ليس المدّة الّتي عشتنّها
إنّما كيف عشتنّها

229
00:17:27,020 --> 00:17:28,650
أهذا ما تقصده؟

230
00:17:28,650 --> 00:17:30,100
!بعيد كُلّ البُعد

231
00:17:30,420 --> 00:17:32,630
بالمُناسبة، ما هي أسماؤهن؟

232
00:17:32,630 --> 00:17:34,000
لا أسماء لديهن

233
00:17:34,000 --> 00:17:35,520
...حسناً. إذاً

234
00:17:35,520 --> 00:17:36,940
...لحظة، أنت لن

235
00:17:36,940 --> 00:17:39,900
أرغب في تسميتكن

236
00:17:40,960 --> 00:17:42,570
هل أنت متأكّد؟

237
00:17:42,570 --> 00:17:45,000
أنا متأكّد بأنّ ذلك سيفلح

238
00:17:45,000 --> 00:17:47,640
تسميتكن سيمنحكن قوّةً أعظم

239
00:17:47,640 --> 00:17:49,760
ويُسهّل عليّ عمليّة مُناداتكن

240
00:17:49,760 --> 00:17:51,700
فما رأيكن؟

241
00:17:51,700 --> 00:17:53,790
افعل ذلك من فضلك

242
00:17:53,790 --> 00:17:55,580
!أجل! أنا مُتشوِّقة

243
00:17:55,580 --> 00:17:57,330
لا اعتراض

244
00:17:57,330 --> 00:17:59,580
!حسناً، حُسِمَ الأمر

245
00:17:59,580 --> 00:18:03,550
سأختار أسماء السّيّارات الخارقة
مثلما فعلتُ مع ديابلو

246
00:18:03,550 --> 00:18:04,980
تيستاروسا

247
00:18:05,550 --> 00:18:06,670
كاريرا

248
00:18:07,550 --> 00:18:08,760
أولتيما

249
00:18:09,790 --> 00:18:12,520
يمكنكن استخدام هذه الأسماء اعتباراً من الآن

250
00:18:16,270 --> 00:18:20,610
!مهلاً، مهلاً! أتمنحن أسماء بهذه البساطة؟

251
00:18:43,360 --> 00:18:44,590
...هذا

252
00:18:45,100 --> 00:18:46,260
إجابة

253
00:18:46,260 --> 00:18:48,110
،بعد منحهن أسماء

254
00:18:48,110 --> 00:18:50,600
تطوّرنَ إلى نبلاء شياطين

255
00:19:02,980 --> 00:19:04,430
أيُعقل هذا؟

256
00:19:04,430 --> 00:19:06,810
...مقدار الطّاقة المُنبعثة منهن جنونيّة

257
00:19:06,810 --> 00:19:08,740
كيف تبدو أجسادكن؟

258
00:19:08,740 --> 00:19:10,130
!ممتازة

259
00:19:10,130 --> 00:19:13,330
!أجل! هذا الجسد رائع

260
00:19:13,330 --> 00:19:19,320
ريمورو-ساما، اسمح لي من فضلك بأن أعلن
عن ولائي لك من الآن فصاعداً

261
00:19:20,230 --> 00:19:24,880
في الحقيقة، لم يتوقّف قلبي عن النّبض
بسرعة منذ رأتك عينايّ

262
00:19:24,880 --> 00:19:28,720
أجل! كنتُ مُتحمِّسة جدّاً طوال
!هذا الوقت أيضاً

263
00:19:28,720 --> 00:19:31,040
سأبذل قصارى جهدي في خدمتك
!يا ريمورو-ساما

264
00:19:31,040 --> 00:19:34,970
!كذلك أنا. مُرني ما تشاء يا مولايّ

265
00:19:34,970 --> 00:19:37,370
أجل. يمكنكن فعل ما تجدنَه مُناسباً

266
00:19:40,830 --> 00:19:46,110
بعد ذلك، جسّدتُ كافّة الشّياطين الآخرين
ومنحتُهم أسماءً أيضاً

267
00:19:41,560 --> 00:19:42,570
إسبيريت

268
00:19:42,570 --> 00:19:43,400
آغيرا

269
00:19:43,400 --> 00:19:44,090
زوندا

270
00:19:44,090 --> 00:19:44,800
فيرون

271
00:19:44,800 --> 00:19:46,110
موس

272
00:19:46,690 --> 00:19:48,050
،من بين الخدَم

273
00:19:48,050 --> 00:19:51,700
الوحيدان اللّذان تطوّرا إلى نبيلين
شيطانيّين كانا موس وفيرون

274
00:19:52,370 --> 00:19:55,180
تطوّر فينوم إلى شيطان رئيسيّ

275
00:19:56,160 --> 00:19:58,680
،بفضل الجُزيئات السّحريّة في كبسولات الاستنبات

276
00:19:58,680 --> 00:20:00,680
انتهيتُ من تسميتهم جميعهم في غضون يومين

277
00:20:01,810 --> 00:20:06,320
كافّة الأتباع الآخرين ترقّوا إلى أعلى
من رتبة أ بمُجرّد تسميتهم

278
00:20:07,340 --> 00:20:13,180
،وهكذا تأسّسَ جيشُنا الشّيطانيّ الجديد
الأرقام السّوداء

279
00:20:16,000 --> 00:20:17,170
ديابلو

280
00:20:18,140 --> 00:20:21,900
فهمتُ الآن سبب إخلاصك لريمورو-ساما

281
00:20:21,900 --> 00:20:25,180
أجل. إنّه مُذهلٌ جدّاً

282
00:20:25,180 --> 00:20:28,780
قمعنا طاقتَنا جميعاً، ومع ذلك
كشفَ حقيقتنا فوراً

283
00:20:28,780 --> 00:20:33,530
أخفيتُ وجودي لدرجة أنّني أستطيع
تجاوز قطّة دون أن تشعر

284
00:20:33,870 --> 00:20:37,840
كنتُ قد فكّرتُ في قتلك لو تبيّن
بأنّ الأمر غير مُثير للاهتمام

285
00:20:37,840 --> 00:20:38,910
كذلك أنا

286
00:20:39,440 --> 00:20:44,250
أشكركن على عدم إجباري على تلطيخ
سمعتي أمام ريمورو-ساما

287
00:20:44,250 --> 00:20:46,420
...لكن لو نويتُن حقّاً القيام بذلك

288
00:20:46,420 --> 00:20:48,920
لا تقلق يا ديابلو

289
00:20:49,740 --> 00:20:52,740
التجسُّد هو أجمل أُمنية لنا جميعاً نحن الشّياطين

290
00:20:52,740 --> 00:20:57,920
قضينا وقتاً طويلاً جدّاً نبحث عن الأجساد
المثاليّة للقيام بذلك

291
00:20:58,830 --> 00:21:03,990
ومنحَني ريمورو-ساما جسداً أعتبره جديراً بي

292
00:21:05,210 --> 00:21:09,440
،وبنفس الطّريقة الّتي تعتزّ فيها باسمك

293
00:21:09,820 --> 00:21:15,250
أنا مُولعة باسم "تيستاروسا" الّذي منحَني إيّاه

294
00:21:18,950 --> 00:21:21,410
على ذلك الاسم، أُقسم بولائي له

295
00:21:22,290 --> 00:21:25,040
أقسم به على اسم "أولتيما" أيضاً

296
00:21:25,040 --> 00:21:30,710
العمل تحت جناح ريمورو-ساما ينبغي أن يكون
أكثر تسلية من تعذيب الشّياطين

297
00:21:31,020 --> 00:21:34,590
أقسم على الاسم الّذي منحَني إيّاه أيضاً

298
00:21:36,570 --> 00:21:41,030
حاولنَ قدر المُستطاع عدم التسبُّب
بالمتاعب لي

299
00:21:42,560 --> 00:21:47,610
،لن تُطِعن أوامر ريمورو-ساما فحسب
بل أوامري أيضاً

300
00:21:52,260 --> 00:21:54,860
هذا ما ناقشناه

301
00:21:55,340 --> 00:21:58,400
،إنّهن الآن تحت أُمرتي

302
00:21:58,400 --> 00:22:00,820
لكن لا أحد يعلم ما سيفعلنه

303
00:22:00,820 --> 00:22:05,120
،أنا متأكّد بأنّه ليس لديك ما تخشاه
لكن شعرتُ بأنّني يجب أن أُحذّرك

304
00:22:05,420 --> 00:22:06,880
...حـ-حسناً

305
00:22:06,880 --> 00:22:10,630
يا رجل، أنت من أحضر أولئك
!الثّلاثة إلى هنا

306
00:22:11,740 --> 00:22:13,300
استمتع من فضلك

307
00:22:14,390 --> 00:22:17,640
،حسناً، إنّهن تحت قيادة ديابلو الآن

308
00:22:17,640 --> 00:22:20,860
لذا سنقول فقط بأنّ كامل المسؤوليّة
تقع على عاتقه

309
00:22:21,760 --> 00:22:23,640
!أجل! لذيذ

310
00:23:55,400 --> 00:23:57,870
"الحلقة القادمة، "شعور مُقلِق